import GaloisForLFunctions.SelbergClass.DirichletSeries.PrimeRestriction
import GaloisForLFunctions.TransHorizonIncidenceMechanics.SparsePrimeFlipsPreserveTheReceiver

/-!
# Prime support of a multiplicative flip kernel

The convolution transporting one unimodular multiplicative sign to another is supported on
integers generated by primes where the signs differ. Its transport identity survives every
prime restriction. These coefficient identities require no summability condition on the flip set.
-/

noncomputable section

namespace GaloisForLFunctions.TransHorizonIncidenceMechanics

open ArithmeticFunction SelbergClass.DirichletSeries
open scoped Classical

/-- The Möbius-weighted inverse of a completely multiplicative sign is multiplicative. -/
theorem UnimodularSign.moebiusAF_isMultiplicative (f : UnimodularSign) :
    f.moebiusAF.IsMultiplicative := by
  change ((moebius : ArithmeticFunction ℝ).pmul f.af).IsMultiplicative
  exact isMultiplicative_moebius.intCast.pmul f.isMultiplicative

/-- Prime separation of a unimodular sign is exact, without a density assumption. -/
theorem unimodularSign_prime_partition (S : Set ℕ) (f : UnimodularSign) :
    primeRestrict S f.af * primeRestrict Sᶜ f.af = f.af :=
  primeRestrict_mul_compl S _ f.isMultiplicative

/-- The flip kernel uses only primes where the two signs differ. -/
theorem flipKernel_prime_support (f f' : UnimodularSign) :
    primeRestrict {p | f'.toFun p ≠ f.toFun p} (f'.af * f.moebiusAF) =
      f'.af * f.moebiusAF := by
  have hg := f'.isMultiplicative.mul f.moebiusAF_isMultiplicative
  apply ((isMultiplicative_primeRestrict _ _ hg).eq_iff_eq_on_prime_powers _ _ hg).mpr
  intro p k hp
  cases k with
  | zero => simp
  | succ k =>
    rw [primeRestrict_prime_pow _ _ hp]
    by_cases h : f'.toFun p = f.toFun p
    · simp [h, flipKernel_apply_prime_pow f f' hp k]
    · simp [h]

/-- The exact flip transport identity holds inside each prime-supported convolution algebra. -/
theorem restricted_flipKernel_transport (S : Set ℕ) (f f' : UnimodularSign) :
    primeRestrict S (f'.af * f.moebiusAF) * primeRestrict S f.af =
      primeRestrict S f'.af := by
  rw [← primeRestrict_mul, mul_assoc, f.moebiusAF_mul_af, mul_one]

/-- The partial Möbius-weighted inverse inverts the corresponding partial sign. -/
theorem restricted_sign_inverse (S : Set ℕ) (f : UnimodularSign) :
    primeRestrict S f.moebiusAF * primeRestrict S f.af = 1 :=
  primeRestrict_inverse_pair S _ _ f.moebiusAF_mul_af

end GaloisForLFunctions.TransHorizonIncidenceMechanics
