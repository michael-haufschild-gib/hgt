/-! ## §1. The Multiplicative Monoid of Trans-Horizon Rough Integers -/

/-- An integer `r : ℕ` is **trans-horizon rough** above sieve cutoff `N` if every divisor `d ∣ r`
satisfying `d ≤ N` is equal to `1`. -/
def IsTransHorizonRough (N r : ℕ) : Prop :=
  ∀ d : ℕ, d ∣ r → d ≤ N → d = 1

theorem isTransHorizonRough_one (N : ℕ) : IsTransHorizonRough N 1 := by
  intro d hd _
  exact Nat.eq_one_of_dvd_one hd

/-- **Every Prime Exceeding `N` Is Trans-Horizon Rough (`isTransHorizonRough_of_prime_gt`):**
If `p` is prime and `N < p`, then `IsTransHorizonRough N p`. -/
theorem isTransHorizonRough_of_prime_gt {N p : ℕ} (hp : p.Prime) (hpN : N < p) :
    IsTransHorizonRough N p := by
  intro d hdp hdN
  rcases (Nat.dvd_prime hp).mp hdp with rfl | rfl
  · rfl
  · omega

/-- **Coprimality With All Sub-Horizon Divisors (`IsTransHorizonRough.coprime_of_le`):**
If `IsTransHorizonRough N r`, then every `d` with `1 ≤ d ≤ N` is coprime to `r`. -/
theorem IsTransHorizonRough.coprime_of_le {N r d : ℕ} (hr : IsTransHorizonRough N r)
    (hd1 : 1 ≤ d) (hdN : d ≤ N) : Nat.Coprime d r := by
  rw [Nat.coprime_iff_gcd_eq_one]
  exact hr (Nat.gcd d r) (Nat.gcd_dvd_right d r)
    ((Nat.gcd_le_left r (by omega : 0 < d)).trans hdN)

/-- **Multiplicative Closure of `IsTransHorizonRough` (`IsTransHorizonRough.mul`):**
If `r₁` and `r₂` are trans-horizon rough above `N`, then so is `r₁ * r₂`. -/
theorem IsTransHorizonRough.mul {N r₁ r₂ : ℕ}
    (hr₁ : IsTransHorizonRough N r₁) (hr₂ : IsTransHorizonRough N r₂) :
    IsTransHorizonRough N (r₁ * r₂) := by
  intro d hd hdN
  by_cases hd0 : d = 0
  · subst hd0
    have h0 : r₁ * r₂ = 0 := zero_dvd_iff.mp hd
    rcases mul_eq_zero.mp h0 with rfl | rfl
    · exact hr₁ 0 (dvd_refl 0) (Nat.zero_le N)
    · exact hr₂ 0 (dvd_refl 0) (Nat.zero_le N)
  · have hcop1 : Nat.Coprime d r₁ := hr₁.coprime_of_le (Nat.pos_of_ne_zero hd0) hdN
    have hd2 : d ∣ r₂ := hcop1.dvd_of_dvd_mul_left hd
    exact hr₂ d hd2 hdN

/-- **Power Closure of `IsTransHorizonRough` (`IsTransHorizonRough.pow`):**
If `IsTransHorizonRough N r`, then `IsTransHorizonRough N (r ^ k)` for every `k : ℕ`. -/
theorem IsTransHorizonRough.pow {N r : ℕ} (hr : IsTransHorizonRough N r) (k : ℕ) :
    IsTransHorizonRough N (r ^ k) := by
  induction k with
  | zero => simpa using isTransHorizonRough_one N
  | succ k ih =>
    rw [pow_succ]
    exact ih.mul hr

/-! ## §2. Exact Multiplicative Absorption Law for `sieveSeq` and `activeCenteredSawtoothSum` -/

/-- Sub-horizon divisibility filter invariance under multiplication by a trans-horizon rough factor. -/
theorem filter_dvd_mul_eq_of_isTransHorizonRough {N r : ℕ} (hr : IsTransHorizonRough N r)
    (q : ℕ) :
    (Finset.Icc 1 N).filter (fun d => d ∣ q * r) =
      (Finset.Icc 1 N).filter (fun d => d ∣ q) := by
  ext d
  simp only [Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd1, hdN⟩, hdvd⟩
    exact ⟨⟨hd1, hdN⟩, (hr.coprime_of_le hd1 hdN).dvd_of_dvd_mul_right hdvd⟩
  · rintro ⟨⟨hd1, hdN⟩, hdvd⟩
    exact ⟨⟨hd1, hdN⟩, dvd_mul_of_dvd_left hdvd r⟩

/-- **Exact Trans-Horizon Rough Absorption for `sieveSeq` (`sieveSeq_mul_of_isTransHorizonRough`):**
For every sieve cutoff `N : ℕ`, weight `c : ℕ → ℝ`, integer `q : ℕ`, and trans-horizon rough factor
`r` (`IsTransHorizonRough N r`), multiplying `q` by `r` leaves the sieve response invariant:
`sieveSeq N c (q * r) = sieveSeq N c q`. -/
theorem sieveSeq_mul_of_isTransHorizonRough {N r : ℕ} (hr : IsTransHorizonRough N r)
    (c : ℕ → ℝ) (q : ℕ) :
    sieveSeq N c (q * r) = sieveSeq N c q := by
  unfold sieveSeq
  rw [filter_dvd_mul_eq_of_isTransHorizonRough hr q]

/-- **Exact Reset of `sieveSeq` at Any Trans-Horizon Rough Integer (`sieveSeq_of_isTransHorizonRough`):**
For every `N : ℕ`, weight `c : ℕ → ℝ`, and `IsTransHorizonRough N r`,
`sieveSeq N c r = sieveSeq N c 1`. -/
theorem sieveSeq_of_isTransHorizonRough {N r : ℕ} (hr : IsTransHorizonRough N r)
    (c : ℕ → ℝ) :
    sieveSeq N c r = sieveSeq N c 1 := by
  simpa only [one_mul] using sieveSeq_mul_of_isTransHorizonRough hr c 1

/-- **Trans-Horizon Prime Response Identity (`sieveSeq_prime_of_gt`):**
Complementing `sieveSeq_prime_of_le` (`p ≤ N`), for every prime `p > N`,
`sieveSeq N c p = sieveSeq N c 1` (which equals `c 1` whenever `1 ≤ N`). -/
theorem sieveSeq_prime_of_gt {N p : ℕ} (hp : p.Prime) (hpN : N < p) (c : ℕ → ℝ) :
    sieveSeq N c p = sieveSeq N c 1 :=
  sieveSeq_of_isTransHorizonRough (isTransHorizonRough_of_prime_gt hp hpN) c

/-- **Exact Active Sawtooth Absorption under Trans-Horizon Rough Multiplication
(`activeCenteredSawtoothSum_mul_of_isTransHorizonRough`):**
For every `N : ℕ`, weight `c : ℕ → ℝ`, `q ≥ 1`, and `r ≥ 1` with `IsTransHorizonRough N r`:
`activeCenteredSawtoothSum N c (q * r) (q * r - 1) = activeCenteredSawtoothSum N c q (q - 1)` and
`activeCenteredSawtoothSum N c (q * r) (q * r) = activeCenteredSawtoothSum N c q q`. -/
theorem activeCenteredSawtoothSum_mul_of_isTransHorizonRough {N q r : ℕ}
    (hq : 1 ≤ q) (hr1 : 1 ≤ r) (hr : IsTransHorizonRough N r) (c : ℕ → ℝ) :
    activeCenteredSawtoothSum N c (q * r) (q * r - 1) =
        activeCenteredSawtoothSum N c q (q - 1) ∧
      activeCenteredSawtoothSum N c (q * r) (q * r) =
        activeCenteredSawtoothSum N c q q := by
  have hqr_pos : 1 ≤ q * r := Nat.mul_pos hq hr1
  have hqr_eq : q * r - 1 + 1 = q * r := Nat.sub_add_cancel hqr_pos
  have hq_eq : q - 1 + 1 = q := Nat.sub_add_cancel hq
  have hpred : activeCenteredSawtoothSum N c (q * r) (q * r - 1) =
      activeCenteredSawtoothSum N c q (q - 1) := by
    have h1 := activeCenteredSawtoothSum_at_pred_eq_half_sieveSeq_sub N c (q * r - 1)
    have h2 := activeCenteredSawtoothSum_at_pred_eq_half_sieveSeq_sub N c (q - 1)
    rw [hqr_eq, sieveSeq_mul_of_isTransHorizonRough hr c q,
      sieveSeq_mul_of_isTransHorizonRough hr (fun d => c d / (d : ℝ)) q] at h1
    rw [hq_eq] at h2
    exact h1.trans h2.symm
  have hself : activeCenteredSawtoothSum N c (q * r) (q * r) =
      activeCenteredSawtoothSum N c q q := by
    have h1 := activeCenteredSawtoothSum_at_self_eq_half_sieveSeq_sub N c (q * r - 1)
    have h2 := activeCenteredSawtoothSum_at_self_eq_half_sieveSeq_sub N c (q - 1)
    rw [hqr_eq, sieveSeq_mul_of_isTransHorizonRough hr c q,
      sieveSeq_mul_of_isTransHorizonRough hr (fun d => c d / (d : ℝ)) q] at h1
    rw [hq_eq] at h2
    exact h1.trans h2.symm
  exact ⟨hpred, hself⟩

/-- **Exact Active Sawtooth Reset at Every Trans-Horizon Rough Integer
(`activeCenteredSawtoothSum_eq_zero_of_isTransHorizonRough`):**
For every `N : ℕ`, weight `c : ℕ → ℝ`, and `r ≥ 1` with `IsTransHorizonRough N r` (in particular
every prime `p > N`), the active sawtooth sum vanishes identically at `r - 1` and `r`. -/
theorem activeCenteredSawtoothSum_eq_zero_of_isTransHorizonRough {N r : ℕ}
    (hr1 : 1 ≤ r) (hr : IsTransHorizonRough N r) (c : ℕ → ℝ) :
    activeCenteredSawtoothSum N c r (r - 1) = 0 ∧
      activeCenteredSawtoothSum N c r r = 0 := by
  have h1 : activeCenteredSawtoothSum N c 1 0 = 0 ∧ activeCenteredSawtoothSum N c 1 1 = 0 := by
    have hsub : sieveSeq N c 1 - sieveSeq N (fun d => c d / (d : ℝ)) 1 = 0 := by
      unfold sieveSeq
      have hterm : ∀ d ∈ (Finset.Icc 1 N).filter (fun d => d ∣ 1),
          c d / (d : ℝ) = c d := by
        intro d hd
        have hd1 : d = 1 := Nat.eq_one_of_dvd_one (Finset.mem_filter.mp hd).2
        subst hd1
        simp
      rw [Finset.sum_congr rfl hterm, sub_self]
    have hp := activeCenteredSawtoothSum_at_pred_eq_half_sieveSeq_sub N c 0
    have hs := activeCenteredSawtoothSum_at_self_eq_half_sieveSeq_sub N c 0
    simp only [ zero_add, hsub, mul_zero] at hp hs
    exact ⟨hp, hs⟩
  have hm := activeCenteredSawtoothSum_mul_of_isTransHorizonRough le_rfl hr1 hr c
  simpa only [one_mul, h1.1, h1.2] using hm

/-! ## §3. Trans-Horizon Möbius Cone Annihilation & Power-Damped Totient Invariance -/

/-- **Infinite Trans-Horizon Möbius Zero Cone
(`sieveSeq_moebiusReal_mul_eq_zero_of_isTransHorizonRough`):**
For every `2 ≤ q ≤ N` and `IsTransHorizonRough N r`, `sieveSeq N moebiusReal (q * r) = 0`. -/
theorem sieveSeq_moebiusReal_mul_eq_zero_of_isTransHorizonRough {N q r : ℕ}
    (hq2 : 2 ≤ q) (hqN : q ≤ N) (hr : IsTransHorizonRough N r) :
    sieveSeq N moebiusReal (q * r) = 0 := by
  rw [sieveSeq_mul_of_isTransHorizonRough hr moebiusReal q,
    sieveSeq_moebiusReal_eq_neg_sum_gt N hq2]
  have hempty : q.divisors.filter (fun d => N < d) = ∅ := by
    rw [Finset.filter_eq_empty_iff]
    intro d hd
    have hle : d ≤ q := Nat.le_of_dvd (by omega) (Nat.mem_divisors.mp hd).1
    omega
  simp [hempty]

/-- **Trans-Horizon Power-Damped Totient Invariance
(`sieveSeq_pmPowerDampedRealWeight_mul_eq_of_isTransHorizonRough`):**
For every `ε : ℝ`, `1 ≤ q ≤ N`, and `IsTransHorizonRough N r`:
`sieveSeq N (pmPowerDampedRealWeight ε) (q * r) = pmPowerDampedDivisorCoeff ε q`. -/
theorem sieveSeq_pmPowerDampedRealWeight_mul_eq_of_isTransHorizonRough (ε : ℝ)
    {N q r : ℕ} (hq1 : 1 ≤ q) (hqN : q ≤ N) (hr : IsTransHorizonRough N r) :
    sieveSeq N (pmPowerDampedRealWeight ε) (q * r) = pmPowerDampedDivisorCoeff ε q := by
  rw [sieveSeq_mul_of_isTransHorizonRough hr,
    sieveSeq_pmPowerDampedRealWeight_eq_pmPowerDampedDivisorCoeff hq1 hqN]

/-! ## §4. Unconditional Cofinal Trans-Horizon Non-Positivity of `sieveRenormalizedPrefixDefect` -/

/-- **Exact Pure-Dirichlet Evaluation of `sieveRenormalizedPrefixDefect` at Rough Checkpoints
(`sieveRenormalizedPrefixDefect_eq_neg_half_dirichlet_of_isTransHorizonRough`):**
For every cutoff `N : ℕ`, weight `c : ℕ → ℝ`, and `r ≥ 2` satisfying `IsTransHorizonRough N r`
(in particular every prime `p > max N 1`), the boundary term `s_{N,c}(r)² - s_{N,c}(1)²` vanishes
identically, so:
`2 * sieveRenormalizedPrefixDefect N (r - 1) c = -∑_{k=1}^{r-1} (s_{N,c}(k+1) - s_{N,c}(k))²`. -/
theorem sieveRenormalizedPrefixDefect_eq_neg_half_dirichlet_of_isTransHorizonRough
    (N : ℕ) (c : ℕ → ℝ) {r : ℕ} (hr2 : 2 ≤ r) (hr : IsTransHorizonRough N r) :
    2 * sieveRenormalizedPrefixDefect N (r - 1) c =
      -(∑ k ∈ Finset.Icc 1 (r - 1),
          (sieveSeq N c (k + 1) - sieveSeq N c k) ^ (2 : ℕ)) := by
  have hr1 : 1 ≤ r - 1 := by omega
  have hadd : r - 1 + 1 = r := Nat.sub_add_cancel (by omega)
  rw [two_mul_sieveRenormalizedPrefixDefect_eq_neg_dirichlet_add_boundary N hr1 c,
    hadd, sieveSeq_of_isTransHorizonRough hr c]
  ring

/-- **Unconditional Non-Positivity of `sieveRenormalizedPrefixDefect` at Rough Checkpoints
(`sieveRenormalizedPrefixDefect_nonpos_of_isTransHorizonRough`):**
For every `N : ℕ`, weight `c : ℕ → ℝ`, and `r ≥ 2` with `IsTransHorizonRough N r`:
`sieveRenormalizedPrefixDefect N (r - 1) c ≤ 0` and
`sieveCombinedPrefixDefect N (r - 1) c ≤ (r - 1) * sieveSuccessorReserve N c`. -/
theorem sieveRenormalizedPrefixDefect_nonpos_of_isTransHorizonRough
    (N : ℕ) (c : ℕ → ℝ) {r : ℕ} (hr2 : 2 ≤ r) (hr : IsTransHorizonRough N r) :
    sieveRenormalizedPrefixDefect N (r - 1) c ≤ 0 ∧
      sieveCombinedPrefixDefect N (r - 1) c ≤
        ((r - 1 : ℕ) : ℝ) * sieveSuccessorReserve N c := by
  have heq := sieveRenormalizedPrefixDefect_eq_neg_half_dirichlet_of_isTransHorizonRough N c hr2 hr
  have hsum : 0 ≤ ∑ k ∈ Finset.Icc 1 (r - 1),
      (sieveSeq N c (k + 1) - sieveSeq N c k) ^ (2 : ℕ) :=
    Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hnonpos : sieveRenormalizedPrefixDefect N (r - 1) c ≤ 0 := by linarith
  refine ⟨hnonpos, ?_⟩
  unfold sieveRenormalizedPrefixDefect at hnonpos
  linarith

/-- **Unconditional Trans-Horizon Non-Positivity for `pmPowerDampedRealWeight ε` on `q * r - 1`
(`sieveRenormalizedPrefixDefect_pmPowerDampedRealWeight_mul_nonpos_of_isTransHorizonRough`):**
For every `ε ≥ 0`, `1 ≤ q ≤ N`, and `IsTransHorizonRough N r` with `2 ≤ q * r`:
`sieveRenormalizedPrefixDefect N (q * r - 1) (pmPowerDampedRealWeight ε) ≤ -(1 - pmPowerDampedDivisorCoeff ε q ^ 2) / 2 ≤ 0`. -/
theorem sieveRenormalizedPrefixDefect_pmPowerDampedRealWeight_mul_nonpos_of_isTransHorizonRough
    {ε : ℝ} (hε : 0 ≤ ε) {N q r : ℕ} (hq1 : 1 ≤ q) (hqN : q ≤ N)
    (hqr2 : 2 ≤ q * r) (hr : IsTransHorizonRough N r) :
    sieveRenormalizedPrefixDefect N (q * r - 1) (pmPowerDampedRealWeight ε) ≤
        -(1 - pmPowerDampedDivisorCoeff ε q ^ (2 : ℕ)) / 2 ∧
      sieveRenormalizedPrefixDefect N (q * r - 1) (pmPowerDampedRealWeight ε) ≤ 0 := by
  have hM1 : 1 ≤ q * r - 1 := by omega
  have hadd : q * r - 1 + 1 = q * r := Nat.sub_add_cancel (by omega)
  have hpol := two_mul_sieveRenormalizedPrefixDefect_eq_neg_dirichlet_add_boundary
    N hM1 (pmPowerDampedRealWeight ε)
  rw [hadd, sieveSeq_pmPowerDampedRealWeight_mul_eq_of_isTransHorizonRough ε hq1 hqN hr,
    sieveSeq_pmPowerDampedRealWeight_eq_pmPowerDampedDivisorCoeff le_rfl (hq1.trans hqN),
    pmPowerDampedDivisorCoeff_one] at hpol
  have hdir : 0 ≤ ∑ k ∈ Finset.Icc 1 (q * r - 1),
      (sieveSeq N (pmPowerDampedRealWeight ε) (k + 1) -
        sieveSeq N (pmPowerDampedRealWeight ε) k) ^ (2 : ℕ) :=
    Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hg0 : 0 ≤ pmPowerDampedDivisorCoeff ε q := pmPowerDampedDivisorCoeff_nonneg hε q
  have hg1 : pmPowerDampedDivisorCoeff ε q ≤ 1 := pmPowerDampedDivisorCoeff_le_one hε q
  have hsq : pmPowerDampedDivisorCoeff ε q ^ (2 : ℕ) ≤ 1 := by nlinarith
  constructor <;> linarith

/-- **Cofinal Unconditional Trans-Horizon Non-Positivity (`exists_gt_sieveRenormalizedPrefixDefect_nonpos`):**
For every sieve horizon `N : ℕ`, weight `c : ℕ → ℝ`, and arbitrarily large target scale `B : ℕ`,
there exists a trans-horizon prefix `M > B` (`M > N`) at which `sieveRenormalizedPrefixDefect N M c ≤ 0`
and `sieveCombinedPrefixDefect N M c ≤ M * sieveSuccessorReserve N c`. -/
theorem exists_gt_sieveRenormalizedPrefixDefect_nonpos (N B : ℕ) (c : ℕ → ℝ) :
    ∃ M : ℕ, B < M ∧ N < M ∧
      sieveRenormalizedPrefixDefect N M c ≤ 0 ∧
      sieveCombinedPrefixDefect N M c ≤ (M : ℝ) * sieveSuccessorReserve N c := by
  obtain ⟨p, hp_ge, hp_prime⟩ := Nat.exists_infinite_primes (max N B + 2)
  have hpN : N < p := by omega
  have hrough : IsTransHorizonRough N p := isTransHorizonRough_of_prime_gt hp_prime hpN
  have hdef := sieveRenormalizedPrefixDefect_nonpos_of_isTransHorizonRough N c hp_prime.two_le hrough
  exact ⟨p - 1, by omega, by omega, hdef.1, hdef.2⟩

end

end GaloisForLFunctions.TransHorizonIncidenceMechanics
