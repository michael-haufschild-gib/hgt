import GaloisForLFunctions.SelbergClass.DirichletSeries.PrimeFiniteColors

/-!
# Polynomial algebras of finite-colored prime series

A finite-colored prime series is, modulo the coefficient field, a linear combination of the
indicators of frequent colors. Those indicators are algebraically independent. Thus the entire
algebra generated by finite-colored prime series is a polynomial algebra with one variable for
each frequent color; colors removed by the prime filter contribute only scalar coefficients.
-/

namespace GaloisForLFunctions.SelbergClass.DirichletSeries

open ArithmeticFunction HTGeometry Filter
open scoped Classical

noncomputable section

variable {C : Type*}

/-- Prime-supported arithmetic columns depend linearly on their coefficient vectors. -/
def arithmeticPrimeColumnLinearMap : (Nat.Primes → ℂ) →ₗ[ℂ] ArithmeticFunction ℂ where
  toFun := arithmeticOfPrimeColumn
  map_add' a b := by
    ext n
    by_cases hn : n.Prime <;> simp [arithmeticOfPrimeColumn, hn]
  map_smul' r a := by
    ext n
    by_cases hn : n.Prime <;>
      simp [arithmeticOfPrimeColumn, hn, ArithmeticFunction.smul_map]

/-- The same linear realization inside the fraction field. -/
def fractionPrimeColumnLinearMap : (Nat.Primes → ℂ) →ₗ[ℂ] arithmeticFunctionFractionField :=
  (IsScalarTower.toAlgHom ℂ (ArithmeticFunction ℂ) arithmeticFunctionFractionField).toLinearMap.comp
    arithmeticPrimeColumnLinearMap

/-- The prime-supported series taking a prescribed value on each color fiber. -/
def primeColorValue (color : Nat.Primes → C) (b : C → ℂ) : arithmeticFunctionFractionField :=
  algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
    (arithmeticOfPrimeColumn (fun p => b (color p)))

/-- Evaluation of finite color values followed by the linear prime-column realization. -/
def primeColorValueLinearMap (color : Nat.Primes → C) :
    (C → ℂ) →ₗ[ℂ] arithmeticFunctionFractionField where
  toFun := primeColorValue color
  map_add' b d := by
    change fractionPrimeColumnLinearMap ((fun p => b (color p)) + (fun p => d (color p))) = _
    exact map_add fractionPrimeColumnLinearMap _ _
  map_smul' r b := by
    change fractionPrimeColumnLinearMap (r • (fun p => b (color p))) = _
    exact LinearMap.map_smul fractionPrimeColumnLinearMap _ _

@[simp] theorem primeColorValueLinearMap_apply
    (color : Nat.Primes → C) (b : C → ℂ) :
    primeColorValueLinearMap color b = primeColorValue color b := rfl

/-- Any basis of color functions gives the corresponding exact linear expansion of prime series. -/
theorem primeColorValue_basisExpansion
    {I : Type*} [Fintype I] (color : Nat.Primes → C)
    (B : Module.Basis I ℂ (C → ℂ)) (b : C → ℂ) :
    primeColorValue color b =
      ∑ i, algebraMap ℂ arithmeticFunctionFractionField ((B.repr b) i) *
        primeColorValue color (B i) := by
  have h := congrArg (primeColorValueLinearMap color) (B.sum_repr b)
  simpa only [map_sum, LinearMap.map_smul, primeColorValueLinearMap_apply,
    Algebra.smul_def] using h.symm

variable [DecidableEq C]

/-- The prime-supported indicator of one color fiber. -/
def primeColorGenerator (color : Nat.Primes → C) (c : C) : arithmeticFunctionFractionField :=
  primeColorValue color (fun d => if d = c then 1 else 0)

omit [DecidableEq C] in
theorem primeFractionDerivation_primeColorValue
    (color : Nat.Primes → C) (b : C → ℂ) (p : Nat.Primes) :
    primeFractionDerivation p (primeColorValue color b) =
      algebraMap ℂ arithmeticFunctionFractionField (b (color p)) :=
  primeFractionDerivation_arithmeticOfPrimeColumn p _

theorem primeFractionDerivation_primeColorGenerator
    (color : Nat.Primes → C) (c : C) (p : Nat.Primes) :
    primeFractionDerivation p (primeColorGenerator color c) =
      if color p = c then 1 else 0 := by
  rw [primeColorGenerator, primeFractionDerivation_primeColorValue]
  by_cases h : color p = c <;> simp [h]

/-- A color indicator is already a coefficient exactly when its fiber is negligible. -/
theorem primeColorGenerator_mem_filterField_iff
    (F : Filter Nat.Primes) (color : Nat.Primes → C) (c : C) :
    primeColorGenerator color c ∈ primeFilterCoefficientField F ↔
      ¬ (∃ᶠ p in F, color p = c) := by
  rw [mem_primeFilterCoefficientField_iff, not_frequently]
  constructor
  · intro h
    filter_upwards [h] with p hp hpc
    rw [primeFractionDerivation_primeColorGenerator, if_pos hpc] at hp
    exact one_ne_zero hp
  · intro h
    filter_upwards [h] with p hp
    rw [primeFractionDerivation_primeColorGenerator, if_neg hp]

variable [Fintype C]

/-- The indicator decomposition keeps every frequent color; the remaining part is an element of
the coefficient field. This is an exact identity in the fraction field. -/
theorem primeColorValue_decomposition
    (F : Filter Nat.Primes) (color : Nat.Primes → C) (b : C → ℂ) :
    ∃ r : primeFilterCoefficientField F,
      primeColorValue color b = (r : arithmeticFunctionFractionField) +
        ∑ c : frequentPrimeColors F color,
          algebraMap ℂ arithmeticFunctionFractionField (b c.1) * primeColorGenerator color c.1 := by
  let s : arithmeticFunctionFractionField :=
    ∑ c : frequentPrimeColors F color,
      algebraMap ℂ arithmeticFunctionFractionField (b c.1) * primeColorGenerator color c.1
  have hcolor : ∀ᶠ p in F, color p ∈ frequentPrimeColors F color :=
    (eventually_prime_color_property_iff F color
      (fun c => c ∈ frequentPrimeColors F color)).mpr fun _ hc => hc
  have hr : primeColorValue color b - s ∈ primeFilterCoefficientField F := by
    filter_upwards [hcolor] with p hp
    let q : frequentPrimeColors F color := ⟨color p, hp⟩
    have hcoe : ∀ c : frequentPrimeColors F color, color p = c.1 ↔ q = c :=
      fun c => ⟨fun h => Subtype.ext (show q.1 = c.1 from h), congrArg Subtype.val⟩
    have hsum : (∑ c : frequentPrimeColors F color,
        b c.1 * (if color p = c.1 then 1 else 0)) = b (color p) := by
      simp [hcoe, q]
    change primeFractionDerivation p
      (primeColorValue color b - ∑ c : frequentPrimeColors F color,
        algebraMap ℂ arithmeticFunctionFractionField (b c.1) *
          algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
            (arithmeticOfPrimeColumn (fun p => if color p = c.1 then 1 else 0))) = 0
    rw [map_sub, primeFractionDerivation_primeColorValue,
      primeFractionDerivation_sum_primeColumns, hsum, sub_self]
  exact ⟨⟨primeColorValue color b - s, hr⟩, (sub_add_cancel _ s).symm⟩

/-- The algebra generated over the filter coefficient field by all finite-colored prime series. -/
def finiteColorPrimeAlgebra (F : Filter Nat.Primes) (color : Nat.Primes → C) :
    Subalgebra (primeFilterCoefficientField F) arithmeticFunctionFractionField :=
  Algebra.adjoin (primeFilterCoefficientField F) (Set.range (primeColorValue color))

/-- The frequent color indicators generate exactly the full finite-color prime algebra. -/
theorem finiteColorPrimeAlgebra_eq_adjoin_frequent
    (F : Filter Nat.Primes) (color : Nat.Primes → C) :
    finiteColorPrimeAlgebra F color =
      Algebra.adjoin (primeFilterCoefficientField F)
        (Set.range fun c : frequentPrimeColors F color => primeColorGenerator color c.1) := by
  let K := primeFilterCoefficientField F
  let A := Algebra.adjoin K
    (Set.range fun c : frequentPrimeColors F color => primeColorGenerator color c.1)
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨b, rfl⟩
    change primeColorValue color b ∈ A
    obtain ⟨r, hr⟩ := primeColorValue_decomposition F color b
    rw [hr]
    apply A.add_mem (A.algebraMap_mem r)
    apply A.sum_mem
    intro c _
    apply A.mul_mem
    · rw [IsScalarTower.algebraMap_apply ℂ K arithmeticFunctionFractionField]
      exact A.algebraMap_mem _
    · exact Algebra.subset_adjoin ⟨c, rfl⟩
  · apply Algebra.adjoin_le
    rintro _ ⟨c, rfl⟩
    exact Algebra.subset_adjoin ⟨(fun d => if d = c.1 then 1 else 0), rfl⟩

/-- The finite-color prime algebra is a polynomial algebra, with exactly one variable for each
color that survives the exceptional-prime filter. -/
def finiteColorPrimePolynomialEquiv
    (F : Filter Nat.Primes) (color : Nat.Primes → C) :
    MvPolynomial (frequentPrimeColors F color) (primeFilterCoefficientField F)
      ≃ₐ[primeFilterCoefficientField F] finiteColorPrimeAlgebra F color := by
  have hAI : AlgebraicIndependent (primeFilterCoefficientField F)
      (fun c : frequentPrimeColors F color => primeColorGenerator color c.1) :=
    algebraicIndependent_frequentPrimeColorIndicators F color
  exact hAI.aevalEquiv.trans
    (Subalgebra.equivOfEq _ _ (finiteColorPrimeAlgebra_eq_adjoin_frequent F color).symm)

#print axioms primeColorGenerator_mem_filterField_iff
#print axioms primeColorValue_decomposition
#print axioms finiteColorPrimePolynomialEquiv

end
end GaloisForLFunctions.SelbergClass.DirichletSeries
