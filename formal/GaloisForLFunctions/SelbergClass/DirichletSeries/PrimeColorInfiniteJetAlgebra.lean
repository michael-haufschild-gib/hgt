import GaloisForLFunctions.SelbergClass.DirichletSeries.PrimeColorInfiniteJets
import GaloisForLFunctions.SelbergClass.DirichletSeries.PrimeWeightedColorAlgebra

/-!
# Polynomial classification of complete finite-color shift–jet algebras

All natural shifts and logarithmic orders of all finite-color observations generate a polynomial
algebra over the density-zero prime coefficient field. Its variables are exactly the surviving
colors, natural shifts, and logarithmic orders. This classification also applies when a chosen
full color basis becomes dependent after passing to the density coefficient field.
-/

namespace GaloisForLFunctions.SelbergClass.DirichletSeries

open ArithmeticFunction HTGeometry Filter
open scoped Classical

noncomputable section

/-- The prime weight for a natural shift and a logarithmic order. -/
def primeNaturalShiftLogWeight (t : ℕ × ℕ) (p : Nat.Primes) : ℂ :=
  primeShiftFactor t.1 p * primeLogClock p ^ t.2

theorem primeColorNaturalShiftLogJet_eq_weighted {J C : Type*}
    (color : Nat.Primes → C) (b : J → C → ℂ) :
    primeColorNaturalShiftLogJet color b =
      fun q => primeWeightedColorValue color (primeNaturalShiftLogWeight q.2) (b q.1) := by
  funext q
  apply congrArg (fun a : Nat.Primes → ℂ =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (arithmeticOfPrimeColumn a))
  funext p
  exact mul_assoc _ _ _

variable {C : Type*} [Fintype C] [DecidableEq C]

/-- The algebra generated by every natural shift and logarithmic order of every color observable. -/
def primeColorInfiniteJetAlgebra (color : Nat.Primes → C) :
    Subalgebra (primeDensityCoefficientField primeCountingWindow) arithmeticFunctionFractionField :=
  weightedColorPrimeAlgebra (primeWindowDensityFilter primeCountingWindow) color
    primeNaturalShiftLogWeight

/-- The complete color shift–jet algebra is polynomial, with one variable for every triple of a
surviving color, natural shift, and logarithmic order. -/
def primeColorInfiniteJetPolynomialEquiv (color : Nat.Primes → C) :
    MvPolynomial
        (frequentPrimeColors (primeWindowDensityFilter primeCountingWindow) color × (ℕ × ℕ))
        (primeDensityCoefficientField primeCountingWindow)
      ≃ₐ[primeDensityCoefficientField primeCountingWindow] primeColorInfiniteJetAlgebra color := by
  let F := primeWindowDensityFilter primeCountingWindow
  have hAI : AlgebraicIndependent (primeFilterCoefficientField F)
      (fun q : frequentPrimeColors F color × (ℕ × ℕ) =>
        primeWeightedColorValue color (primeNaturalShiftLogWeight q.2)
          (fun d => if d = q.1.1 then 1 else 0)) := by
    simpa only [primeColorNaturalShiftLogJet_eq_weighted] using
      algebraicIndependent_frequentPrimeColorInfiniteJets_over_densityField color
  exact hAI.aevalEquiv.trans
    (Subalgebra.equivOfEq _ _
      (weightedColorPrimeAlgebra_eq_adjoin_frequent F color primeNaturalShiftLogWeight).symm)

/-- Every full color basis, including a dependent image over the density coefficient field,
generates the same polynomial algebra through all natural shifts and logarithmic orders. -/
def primeColorBasisInfiniteJetPolynomialEquiv
    {J : Type*} [Fintype J] (color : Nat.Primes → C) (B : Module.Basis J ℂ (C → ℂ)) :
    MvPolynomial
        (frequentPrimeColors (primeWindowDensityFilter primeCountingWindow) color × (ℕ × ℕ))
        (primeDensityCoefficientField primeCountingWindow)
      ≃ₐ[primeDensityCoefficientField primeCountingWindow]
        Algebra.adjoin (primeDensityCoefficientField primeCountingWindow)
          (Set.range (primeColorNaturalShiftLogJet color (fun j c => B j c))) := by
  have heq : Algebra.adjoin (primeDensityCoefficientField primeCountingWindow)
      (Set.range (primeColorNaturalShiftLogJet color (fun j c => B j c))) =
        primeColorInfiniteJetAlgebra color := by
    simpa only [primeColorNaturalShiftLogJet_eq_weighted] using
      weightedColorBasis_adjoin_eq (primeWindowDensityFilter primeCountingWindow)
        color primeNaturalShiftLogWeight B
  exact (primeColorInfiniteJetPolynomialEquiv color).trans
    (Subalgebra.equivOfEq _ _ heq.symm)

#print axioms primeColorInfiniteJetPolynomialEquiv
#print axioms primeColorBasisInfiniteJetPolynomialEquiv

end
end GaloisForLFunctions.SelbergClass.DirichletSeries
