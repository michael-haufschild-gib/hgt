import GaloisForLFunctions.SelbergClass.PositiveFiniteEulerCoefficients
import Mathlib.Analysis.SpecialFunctions.Log.Basic

/-!
# The critical-circle transition of a positive finite Euler factor

The reciprocal quadratic `t² + At + p` has its roots on `|t| = √p`
exactly for `0 ≤ A ≤ 2√p`. With `t=pˢ`, this is the exact threshold
for the added zeros to leave the critical line.
-/

noncomputable section
open Complex
namespace GaloisForLFunctions.SelbergClass.PositiveFiniteEuler

/-- Multiplying the local factor by `p²ˢ` exposes its reciprocal quadratic. -/
theorem localFactor_zero_iff {p : ℕ} (hp : p ≠ 0) (A : ℝ) (s : ℂ) :
    localFactor p A s = 0 ↔
      ((p : ℂ) ^ s) ^ 2 + (A : ℂ) * (p : ℂ) ^ s + p = 0 := by
  have ht : (p : ℂ) ^ s ≠ 0 := cpow_ne_zero_iff.mpr (.inl (by exact_mod_cast hp))
  have hid : localFactor p A s * ((p : ℂ) ^ s) ^ 2 =
      ((p : ℂ) ^ s) ^ 2 + (A : ℂ) * (p : ℂ) ^ s + p := by
    rw [localFactor, cpow_neg]
    field_simp [ht]
  rw [← hid, mul_eq_zero]
  simp only [pow_ne_zero 2 ht, or_false]

/-- A root of the reciprocal quadratic lies on its critical circle exactly
when its real middle coefficient is at most the repeated-root threshold. -/
theorem normSq_quadratic_root {q A : ℝ} (hq : 0 < q) (hA : 0 ≤ A)
    {z : ℂ} (hz : z ^ 2 + (A : ℂ) * z + q = 0) :
    Complex.normSq z = q ↔ A ≤ 2 * Real.sqrt q := by
  have hre := congrArg Complex.re hz
  have him := congrArg Complex.im hz
  simp only [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.zero_re, Complex.zero_im,
    pow_two, zero_mul, sub_zero, add_zero] at hre him
  have hsq := Real.sq_sqrt hq.le
  have hsqrt := Real.sqrt_nonneg q
  rw [Complex.normSq_apply]
  constructor
  · intro hn
    have hx : z.re * (2 * z.re + A) = 0 := by nlinarith only [hre, hn]
    rcases mul_eq_zero.mp hx with hx | hx
    · have hy : A * z.im = 0 := by simpa only [hx, zero_mul, mul_zero, zero_add] using him
      rcases mul_eq_zero.mp hy with hA0 | hy0
      · rw [hA0]; positivity
      · nlinarith only [hn, hx, hy0, hq]
    · have hdisc : A ^ 2 ≤ 4 * q := by
        have hxA : A = -2 * z.re := by linarith only [hx]
        rw [hxA]
        nlinarith only [hn, sq_nonneg z.im]
      nlinarith only [hdisc, hsq, hsqrt, hA]
  · intro hbound
    have hdisc : A ^ 2 ≤ 4 * q := by nlinarith only [hbound, hsq, hsqrt, hA]
    have hi : z.im * (2 * z.re + A) = 0 := by nlinarith only [him]
    rcases mul_eq_zero.mp hi with hy | hx
    · have hx : 2 * z.re + A = 0 := by
        have hs : (2 * z.re + A) ^ 2 ≤ 0 := by nlinarith only [hre, hy, hdisc]
        exact (sq_eq_zero_iff).mp (le_antisymm hs (sq_nonneg _))
      have hxA : A = -2 * z.re := by linarith only [hx]
      rw [hxA] at hre
      nlinarith only [hre]
    · have hxA : A = -2 * z.re := by linarith only [hx]
      rw [hxA] at hre
      nlinarith only [hre]

/-- The reciprocal quadratic has roots on the critical circle exactly below its
repeated-root threshold. -/
theorem localFactor_zero_critical_iff {p : ℕ} (hp : 1 < p) {A : ℝ} (hA : 0 ≤ A)
    {s : ℂ} (hs : localFactor p A s = 0) :
    s.re = 1 / 2 ↔ A ≤ 2 * Real.sqrt p := by
  have hp0 : p ≠ 0 := by omega
  have hpR : 1 < (p : ℝ) := by exact_mod_cast hp
  have hl : 0 < Real.log p := Real.log_pos hpR
  have hz := (localFactor_zero_iff hp0 A s).mp hs
  have hroot := normSq_quadratic_root (q := p) (by positivity) hA hz
  have hnorm : Complex.normSq ((p : ℂ) ^ s) =
      Real.exp (2 * Real.log p * s.re) := by
    rw [Complex.normSq_eq_norm_sq, cpow_def_of_ne_zero (by exact_mod_cast hp0),
      ← Complex.natCast_log, Complex.norm_exp, Complex.mul_re]
    simp only [Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, pow_two]
    rw [← Real.exp_add]
    congr 1
    ring
  have hnorm_iff : Complex.normSq ((p : ℂ) ^ s) = (p : ℝ) ↔
      2 * Real.log p * s.re = Real.log p := by
    rw [hnorm]
    conv_lhs => rhs; rw [← Real.exp_log (by positivity : (0 : ℝ) < p)]
    exact Real.exp_eq_exp
  rw [hnorm_iff] at hroot
  constructor
  · intro h
    apply hroot.mp
    rw [h]
    ring
  · intro h
    have heq := hroot.mpr h
    nlinarith only [heq, hl]

/-- A positive local factor whose two reciprocal roots have magnitudes `r` and `p/r`. -/
def reciprocalParameter (p : ℕ) (r : ℝ) : ℝ := r + p / r

/-- The first zero on the vertical progression generated by the root `-r`. -/
def factorZero (p : ℕ) (r : ℝ) : ℂ :=
  ((Real.log r : ℂ) + (Real.pi : ℂ) * I) / (Real.log p : ℂ)

theorem cpow_factorZero {p : ℕ} (hp : 1 < p) {r : ℝ} (hr : 0 < r) :
    (p : ℂ) ^ factorZero p r = -(r : ℂ) := by
  have hp0 : p ≠ 0 := by omega
  have hl : (Real.log p : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr
    (Real.log_pos (by exact_mod_cast hp)).ne'
  rw [cpow_def_of_ne_zero (by exact_mod_cast hp0), ← Complex.natCast_log,
    factorZero, mul_div_cancel₀ _ hl, Complex.exp_add, Complex.exp_pi_mul_I,
    ← Complex.ofReal_exp, Real.exp_log hr]
  ring

theorem localFactor_factorZero {p : ℕ} (hp : 1 < p) {r : ℝ} (hr : 0 < r) :
    localFactor p (reciprocalParameter p r) (factorZero p r) = 0 := by
  apply (localFactor_zero_iff (by omega) _ _).mpr
  rw [cpow_factorZero hp hr, reciprocalParameter]
  push_cast
  field_simp [hr.ne']
  ring

@[simp] theorem factorZero_re (p : ℕ) (r : ℝ) :
    (factorZero p r).re = Real.log r / Real.log p := by
  simp only [factorZero, Complex.div_ofReal_re, Complex.add_re, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    mul_zero, zero_mul, sub_zero, add_zero]

/-- At and below the repeated-root threshold, the square-root exponential
bound holds for the logarithmic prime-power coefficients. -/
theorem quadratic_logCoeff_bound {p : ℕ} (hp : 1 < p) {A : ℝ}
    (hA : 0 ≤ A) (hbound : A ≤ 2 * Real.sqrt p) {α β : ℂ}
    (hadd : α + β = -(A : ℂ)) (hmul : α * β = p) {k : ℕ} (hk : k ≠ 0) :
    ‖(1 - α ^ k - β ^ k) / (k : ℂ)‖ ≤ 3 * (Real.sqrt p) ^ k := by
  have hpR : (1 : ℝ) < p := by exact_mod_cast hp
  have hsqrt : 0 ≤ Real.sqrt p := Real.sqrt_nonneg _
  have hsq : (Real.sqrt p) ^ 2 = (p : ℝ) := Real.sq_sqrt (by positivity)
  have hR1 : 1 ≤ Real.sqrt p := by nlinarith only [hsqrt, hsq, hpR]
  have hn (z w : ℂ) (ha : z + w = -(A : ℂ)) (hm : z * w = p) :
      ‖z‖ = Real.sqrt p := by
    have hz : z ^ 2 + (A : ℂ) * z + p = 0 := by
      calc _ = z * (z + w + A) := by rw [← hm]; ring
        _ = 0 := by rw [ha]; ring
    have hnorm := (normSq_quadratic_root (q := p) (by positivity) hA hz).mpr hbound
    rw [Complex.normSq_eq_norm_sq] at hnorm
    nlinarith only [hnorm, hsq, hsqrt, norm_nonneg z]
  have hα := hn α β hadd hmul
  have hβ := hn β α (by rw [add_comm]; exact hadd) (by rw [mul_comm]; exact hmul)
  have hnum : ‖1 - α ^ k - β ^ k‖ ≤ 1 + ‖α‖ ^ k + ‖β‖ ^ k := by
    calc _ ≤ ‖1 - α ^ k‖ + ‖β ^ k‖ := norm_sub_le _ _
      _ ≤ (‖(1 : ℂ)‖ + ‖α ^ k‖) + ‖β ^ k‖ :=
        add_le_add (norm_sub_le _ _) le_rfl
      _ = _ := by rw [norm_one, norm_pow, norm_pow]
  rw [hα, hβ] at hnum
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hk
  have hRk : (1 : ℝ) ≤ (Real.sqrt p) ^ k := one_le_pow₀ hR1
  rw [norm_div, Complex.norm_natCast]
  calc ‖1 - α ^ k - β ^ k‖ / (k : ℝ) ≤ ‖1 - α ^ k - β ^ k‖ :=
      div_le_self (norm_nonneg _) hk1
    _ ≤ 3 * (Real.sqrt p) ^ k := by linarith only [hnum, hRk]

end GaloisForLFunctions.SelbergClass.PositiveFiniteEuler
