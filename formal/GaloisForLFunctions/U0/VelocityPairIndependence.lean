/-
# Algebraic independence of the first two Böttcher parameter velocities

The second velocity's triangular Mahler equation recovers the Euler derivative of the
first velocity from the second velocity and its dyadic transform.  If the second velocity
were algebraic over the field generated by the first, applying the graded Mahler
automorphism would make its transform algebraic as well, hence the Euler derivative —
a finite differential handle on a hypertranscendental function.  This module carries out
that collapse inside the graded Mahler carrier: the pair `(A, B)` admits no nonzero
two-variable polynomial relation over `ℂ(t)`.
-/
import Mathlib
import GaloisForLFunctions.U0.MahlerSaturatedField
import GaloisForLFunctions.U0.SecondVelocityJet

namespace GaloisForLFunctions

open Polynomial HahnSeries

noncomputable section

/-! ## One- and two-variable polynomial bridges -/

/-- A one-variable polynomial as a multivariate polynomial in the first variable. -/
def toMvOne : Polynomial MahlerBase →+* MvPolynomial (Fin 1) MahlerBase :=
  Polynomial.eval₂RingHom (MvPolynomial.C : MahlerBase →+* MvPolynomial (Fin 1) MahlerBase)
    (MvPolynomial.X 0)

theorem toMvOne_retract :
    (MvPolynomial.eval₂Hom
        (Polynomial.C : MahlerBase →+* Polynomial MahlerBase) (fun _ => Polynomial.X)).comp
      toMvOne = RingHom.id (Polynomial MahlerBase) := by
  apply Polynomial.ringHom_ext
  · intro a
    rw [RingHom.comp_apply, RingHom.id_apply]
    rw [show toMvOne (Polynomial.C a) = MvPolynomial.C a from Polynomial.eval₂_C _ _]
    rw [MvPolynomial.eval₂Hom_C]
  · rw [RingHom.comp_apply, RingHom.id_apply]
    rw [show toMvOne Polynomial.X = MvPolynomial.X 0 from Polynomial.eval₂_X _ _]
    rw [MvPolynomial.eval₂Hom_X']

theorem toMvOne_injective : Function.Injective toMvOne := by
  intro a b hab
  have h := congrArg (MvPolynomial.eval₂Hom
    (Polynomial.C : MahlerBase →+* Polynomial MahlerBase) (fun _ => Polynomial.X)) hab
  rw [← RingHom.comp_apply, ← RingHom.comp_apply, toMvOne_retract, RingHom.id_apply,
    RingHom.id_apply] at h
  exact h

/-- A polynomial in two nested variables as a multivariate polynomial. -/
def toMvTwo : Polynomial (Polynomial MahlerBase) →+* MvPolynomial (Fin 2) MahlerBase :=
  Polynomial.eval₂RingHom
    (Polynomial.eval₂RingHom
      (MvPolynomial.C : MahlerBase →+* MvPolynomial (Fin 2) MahlerBase)
      (MvPolynomial.X 0))
    (MvPolynomial.X 1)

theorem toMvTwo_retract :
    (MvPolynomial.eval₂Hom
        ((Polynomial.C.comp Polynomial.C :
          MahlerBase →+* Polynomial (Polynomial MahlerBase)))
        (fun i => if i = 0 then Polynomial.C Polynomial.X else Polynomial.X)).comp
      toMvTwo = RingHom.id (Polynomial (Polynomial MahlerBase)) := by
  apply Polynomial.ringHom_ext
  · intro a
    rw [RingHom.comp_apply, RingHom.id_apply]
    rw [show toMvTwo (Polynomial.C a) =
      Polynomial.eval₂ (MvPolynomial.C : MahlerBase →+* MvPolynomial (Fin 2) MahlerBase)
        (MvPolynomial.X 0) a from Polynomial.eval₂_C _ _]
    induction a using Polynomial.induction_on' with
    | add p q hp hq => rw [Polynomial.eval₂_add, map_add, hp, hq, ← map_add]
    | monomial n e =>
      rw [show (Polynomial.monomial n e : Polynomial MahlerBase) =
        Polynomial.C e * Polynomial.X ^ n from by rw [Polynomial.C_mul_X_pow_eq_monomial]]
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_X, map_mul, map_pow, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_X']
      rw [if_pos rfl, RingHom.comp_apply, map_mul, map_pow]
  · rw [RingHom.comp_apply, RingHom.id_apply]
    rw [show toMvTwo Polynomial.X = MvPolynomial.X 1 from Polynomial.eval₂_X _ _]
    rw [MvPolynomial.eval₂Hom_X']
    rw [if_neg (by norm_num)]

theorem toMvTwo_injective : Function.Injective toMvTwo := by
  intro a b hab
  have h := congrArg (MvPolynomial.eval₂Hom
    ((Polynomial.C.comp Polynomial.C : MahlerBase →+* Polynomial (Polynomial MahlerBase)))
    (fun i => if i = 0 then Polynomial.C Polynomial.X else Polynomial.X)) hab
  rw [← RingHom.comp_apply, ← RingHom.comp_apply, toMvTwo_retract, RingHom.id_apply,
    RingHom.id_apply] at h
  exact h

/-! ## Evaluation of polynomials at the velocity -/

/-- Evaluation of one-variable polynomials over `ℂ(t)` at the velocity `A`. -/
def velocityPolyEval : Polynomial MahlerBase →+* HahnSeries ℚ (RatFunc ℂ) :=
  Polynomial.eval₂RingHom (monoRatEval 1 one_pos) (toMahlerCarrier velocityJet)

theorem velocityPolyEval_C (e : MahlerBase) :
    velocityPolyEval (Polynomial.C e) = monoRatEval 1 one_pos e :=
  Polynomial.eval₂_C _ _

theorem velocityPolyEval_X :
    velocityPolyEval Polynomial.X = toMahlerCarrier velocityJet :=
  Polynomial.eval₂_X _ _

/-- Evaluation at the velocity kills no nonzero polynomial: the velocity is
transcendental over `ℂ(t)`. -/
theorem velocityPolyEval_ne_zero {W : Polynomial MahlerBase} (hW : W ≠ 0) :
    velocityPolyEval W ≠ 0 := by
  have hmv : toMvOne W ≠ 0 := fun h0 => hW (toMvOne_injective (by rw [h0, map_zero]))
  have hyp := velocity_theta_hypertranscendental 0 (toMvOne W) hmv
  intro h0
  apply hyp
  have hbridge : MvPolynomial.eval₂ (monoRatEval 1 one_pos)
      (fun i : Fin 1 => eulerDeriv^[(i : ℕ)] (toMahlerCarrier velocityJet)) (toMvOne W) =
      velocityPolyEval W := by
    have hhom : (MvPolynomial.eval₂Hom (monoRatEval 1 one_pos)
        (fun i : Fin 1 => eulerDeriv^[(i : ℕ)] (toMahlerCarrier velocityJet))).comp
        toMvOne = velocityPolyEval := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply,
          show toMvOne (Polynomial.C a) = MvPolynomial.C a from Polynomial.eval₂_C _ _,
          MvPolynomial.eval₂Hom_C, velocityPolyEval_C]
      · rw [RingHom.comp_apply,
          show toMvOne Polynomial.X = MvPolynomial.X 0 from Polynomial.eval₂_X _ _,
          MvPolynomial.eval₂Hom_X', velocityPolyEval_X]
        rw [show ((0 : Fin 1) : ℕ) = 0 from rfl, Function.iterate_zero_apply]
    exact congrFun (congrArg (fun (g : Polynomial MahlerBase →+*
      HahnSeries ℚ (RatFunc ℂ)) => (g : Polynomial MahlerBase →
      HahnSeries ℚ (RatFunc ℂ))) hhom) W
  rw [hbridge, h0]

/-- No nonzero nested polynomial vanishes at the pair (velocity, Euler derivative of the
velocity): the base case of hypertranscendence in two variables. -/
theorem velocity_theta_pair_ne_zero {W : Polynomial (Polynomial MahlerBase)} (hW : W ≠ 0) :
    Polynomial.eval₂ velocityPolyEval
      (eulerDeriv (toMahlerCarrier velocityJet)) W ≠ 0 := by
  have hmv : toMvTwo W ≠ 0 := fun h0 => hW (toMvTwo_injective (by rw [h0, map_zero]))
  have hyp := velocity_theta_hypertranscendental 1 (toMvTwo W) hmv
  intro h0
  apply hyp
  have hhom : (MvPolynomial.eval₂Hom (monoRatEval 1 one_pos)
      (fun i : Fin 2 => eulerDeriv^[(i : ℕ)] (toMahlerCarrier velocityJet))).comp
      toMvTwo =
      Polynomial.eval₂RingHom velocityPolyEval
        (eulerDeriv (toMahlerCarrier velocityJet)) := by
    apply Polynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply,
        show toMvTwo (Polynomial.C a) =
          Polynomial.eval₂ (MvPolynomial.C :
            MahlerBase →+* MvPolynomial (Fin 2) MahlerBase) (MvPolynomial.X 0) a from
          Polynomial.eval₂_C _ _]
      rw [show (Polynomial.eval₂RingHom velocityPolyEval
        (eulerDeriv (toMahlerCarrier velocityJet))) (Polynomial.C a) =
        velocityPolyEval a from Polynomial.eval₂_C _ _]
      induction a using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.eval₂_add, map_add, hp, hq, map_add]
      | monomial n e =>
        rw [show (Polynomial.monomial n e : Polynomial MahlerBase) =
          Polynomial.C e * Polynomial.X ^ n from by
          rw [Polynomial.C_mul_X_pow_eq_monomial]]
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
          Polynomial.eval₂_X, map_mul, map_pow, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', map_mul, map_pow, velocityPolyEval_C,
          velocityPolyEval_X]
        rw [show ((0 : Fin 2) : ℕ) = 0 from rfl, Function.iterate_zero_apply]
    · rw [RingHom.comp_apply,
        show toMvTwo Polynomial.X = MvPolynomial.X 1 from Polynomial.eval₂_X _ _,
        MvPolynomial.eval₂Hom_X']
      rw [show (Polynomial.eval₂RingHom velocityPolyEval
        (eulerDeriv (toMahlerCarrier velocityJet))) Polynomial.X =
        eulerDeriv (toMahlerCarrier velocityJet) from Polynomial.eval₂_X _ _]
      rw [show ((1 : Fin 2) : ℕ) = 1 from rfl, Function.iterate_one]
  show ((MvPolynomial.eval₂Hom (monoRatEval 1 one_pos)
    (fun i : Fin 2 => eulerDeriv^[(i : ℕ)] (toMahlerCarrier velocityJet))).comp
      toMvTwo) W = 0
  rw [hhom]
  exact h0

/-! ## The velocity field `ℂ(t)(A)` inside the carrier -/

theorem velocityPolyEval_le_comap :
    nonZeroDivisors (Polynomial MahlerBase) ≤
      Submonoid.comap velocityPolyEval
        (nonZeroDivisors (HahnSeries ℚ (RatFunc ℂ))) :=
  fun {_} hx => Submonoid.mem_comap.mpr (mem_nonZeroDivisors_of_ne_zero
    (velocityPolyEval_ne_zero (nonZeroDivisors.ne_zero hx)))

/-- The field `ℂ(t)(A)` generated by the velocity over the base field, as an embedding of
the rational function field in the velocity variable. -/
def velocityEmbed :=
  RatFunc.liftRingHom (L := HahnSeries ℚ (RatFunc ℂ)) velocityPolyEval
    velocityPolyEval_le_comap

theorem velocityEmbed_apply_div (p q : Polynomial MahlerBase) :
    velocityEmbed (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) p /
      algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) q) =
      velocityPolyEval p / velocityPolyEval q := by
  unfold velocityEmbed
  exact RatFunc.liftRingHom_apply_div _ _ p q

theorem velocityEmbed_algebraMap (W : Polynomial MahlerBase) :
    velocityEmbed (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) W) =
      velocityPolyEval W := by
  rw [← RatFunc.ofFractionRing_algebraMap]
  unfold velocityEmbed
  exact RatFunc.liftRingHom_ofFractionRing_algebraMap _ _ _

theorem velocityEmbed_ne_zero {f : RatFunc MahlerBase} (hf : f ≠ 0) :
    velocityEmbed f ≠ 0 := by
  intro h0
  have hone : velocityEmbed (f * f⁻¹) = 1 := by
    rw [mul_inv_cancel₀ (G₀ := RatFunc MahlerBase) hf, map_one]
  rw [map_mul, h0, zero_mul] at hone
  exact zero_ne_one hone

/-- The subfield `ℂ(t)(A)` of the carrier. -/
def velocityField : Subfield (HahnSeries ℚ (RatFunc ℂ)) :=
  RingHom.fieldRange (K := RatFunc MahlerBase) (L := HahnSeries ℚ (RatFunc ℂ))
    velocityEmbed

theorem mem_velocityField_iff {z : HahnSeries ℚ (RatFunc ℂ)} :
    z ∈ velocityField ↔ ∃ f, velocityEmbed f = z :=
  RingHom.mem_fieldRange (K := RatFunc MahlerBase) (L := HahnSeries ℚ (RatFunc ℂ))

theorem velocityPolyEval_mem_velocityField (W : Polynomial MahlerBase) :
    velocityPolyEval W ∈ velocityField :=
  mem_velocityField_iff.mpr ⟨_, velocityEmbed_algebraMap W⟩

/-! ## Stability of the velocity field under the graded Mahler automorphism -/

/-- The base monomial squared as an evaluated constant. -/
theorem monoRatEval_one_X_sq :
    monoRatEval 1 one_pos ((RatFunc.X : RatFunc ℂ) ^ 2) = mahlerT * mahlerT := by
  rw [map_pow, monoRatEval_X, sq, mahlerT, HahnSeries.single_mul_single, mul_one]

/-- The affine Mahler substitution on the velocity variable, `Y ↦ 2·Y − t²`, combined
with the dyadic substitution on the base coefficients. -/
def velocityTwoVarPolyHom : Polynomial MahlerBase →+* Polynomial MahlerBase :=
  letI : Invertible (2 : MahlerBase) := invertibleOfNonzero two_ne_zero
  ((algEquivCMulXAddC (2 : MahlerBase) (-(RatFunc.X ^ 2))).toAlgHom.toRingHom).comp
    (Polynomial.mapRingHom (MahlerPolynomial.mahlerHom 0).toRingHom)

theorem velocityTwoVarPolyHom_C (e : MahlerBase) :
    velocityTwoVarPolyHom (Polynomial.C e) =
      Polynomial.C (MahlerPolynomial.mahlerHom 0 e) := by
  letI : Invertible (2 : MahlerBase) := invertibleOfNonzero two_ne_zero
  show (algEquivCMulXAddC (2 : MahlerBase) (-(RatFunc.X ^ 2)))
    (Polynomial.map (MahlerPolynomial.mahlerHom 0).toRingHom (Polynomial.C e)) = _
  rw [Polynomial.map_C, algEquivCMulXAddC_apply, Polynomial.aeval_C,
    Polynomial.algebraMap_eq]
  rfl

theorem velocityTwoVarPolyHom_X :
    velocityTwoVarPolyHom Polynomial.X =
      Polynomial.C 2 * Polynomial.X + Polynomial.C (-(RatFunc.X ^ 2)) := by
  letI : Invertible (2 : MahlerBase) := invertibleOfNonzero two_ne_zero
  show (algEquivCMulXAddC (2 : MahlerBase) (-(RatFunc.X ^ 2)))
    (Polynomial.map (MahlerPolynomial.mahlerHom 0).toRingHom Polynomial.X) = _
  rw [Polynomial.map_X, algEquivCMulXAddC_apply, Polynomial.aeval_X]

/-- Evaluation of the substituted velocity variable: `σ` of the velocity itself. -/
theorem velocityPolyEval_velocityTwoVarPolyHom_X :
    velocityPolyEval (velocityTwoVarPolyHom Polynomial.X) =
      mahlerSigma (toMahlerCarrier velocityJet) := by
  rw [velocityTwoVarPolyHom_X, map_add, map_mul, velocityPolyEval_C, velocityPolyEval_C,
    velocityPolyEval_X, mahlerSigma_velocity, map_neg, monoRatEval_one_X_sq, map_ofNat]
  rw [sub_eq_add_neg]

/-- The graded Mahler automorphism intertwines evaluation at the velocity with the
two-variable affine Mahler substitution. -/
theorem mahlerSigma_velocityPolyEval (W : Polynomial MahlerBase) :
    mahlerSigma (velocityPolyEval W) = velocityPolyEval (velocityTwoVarPolyHom W) := by
  induction W using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add, map_add, hp, hq, map_add]
    exact (map_add velocityPolyEval _ _).symm.trans (by rw [map_add])
  | monomial n e =>
    rw [show (Polynomial.monomial n e : Polynomial MahlerBase) =
      Polynomial.C e * Polynomial.X ^ n from by rw [Polynomial.C_mul_X_pow_eq_monomial]]
    have hL : mahlerSigma (velocityPolyEval (Polynomial.C e * Polynomial.X ^ n)) =
        monoRatEval 1 one_pos (MahlerPolynomial.mahlerHom 0 e) *
          (mahlerSigma (toMahlerCarrier velocityJet)) ^ n := by
      rw [map_mul, map_pow, velocityPolyEval_C, velocityPolyEval_X, map_mul, map_pow,
        mahlerSigma_monoRatEval]
    have hR : velocityPolyEval
        (velocityTwoVarPolyHom (Polynomial.C e * Polynomial.X ^ n)) =
        monoRatEval 1 one_pos (MahlerPolynomial.mahlerHom 0 e) *
          (mahlerSigma (toMahlerCarrier velocityJet)) ^ n := by
      rw [map_mul, map_pow, velocityTwoVarPolyHom_C, map_mul, map_pow,
        velocityPolyEval_C, velocityPolyEval_velocityTwoVarPolyHom_X]
    rw [hL, hR]

theorem mahlerSigma_velocityField_mem {z : HahnSeries ℚ (RatFunc ℂ)}
    (hz : z ∈ velocityField) : mahlerSigma z ∈ velocityField := by
  obtain ⟨f, rfl⟩ := mem_velocityField_iff.mp hz
  induction f using RatFunc.induction_on with
  | _ p s hs =>
    rw [velocityEmbed_apply_div]
    have hdiv : mahlerSigma (velocityPolyEval p / velocityPolyEval s) =
        mahlerSigma (velocityPolyEval p) / mahlerSigma (velocityPolyEval s) :=
      map_div₀ (f := mahlerSigma) (a := velocityPolyEval p) (b := velocityPolyEval s)
    rw [hdiv, mahlerSigma_velocityPolyEval, mahlerSigma_velocityPolyEval]
    exact Subfield.div_mem _ (velocityPolyEval_mem_velocityField _)
      (velocityPolyEval_mem_velocityField _)

/-- The graded Mahler automorphism restricted to the velocity field, as a ring
endomorphism. -/
def velocityFieldSigma : ↥velocityField →+* ↥velocityField where
  toFun z := ⟨mahlerSigma z.val, mahlerSigma_velocityField_mem z.prop⟩
  map_one' := Subtype.ext (map_one mahlerSigma)
  map_mul' a b := Subtype.ext (map_mul mahlerSigma a.val b.val)
  map_zero' := Subtype.ext (map_zero mahlerSigma)
  map_add' a b := Subtype.ext (map_add mahlerSigma a.val b.val)

theorem velocityFieldSigma_injective : Function.Injective velocityFieldSigma :=
  fun _ _ h => Subtype.ext (mahlerSigma.injective (congrArg Subtype.val h))

/-! ## Collapse: algebraicity of the second velocity forces a differential handle -/

theorem mahlerT_ne_zero : mahlerT ≠ 0 := by
  rw [mahlerT]
  intro h
  have hc : ((HahnSeries.single (1 : ℚ)) (1 : RatFunc ℂ)).coeff 1 =
      (0 : HahnSeries ℚ (RatFunc ℂ)).coeff 1 := by rw [h]
  rw [HahnSeries.coeff_single_same] at hc
  simp at hc

theorem two_mahlerT_sq_ne_zero :
    (2 * (mahlerT * mahlerT) : HahnSeries ℚ (RatFunc ℂ)) ≠ 0 :=
  mul_ne_zero hahn_two_ne_zero (mul_ne_zero mahlerT_ne_zero mahlerT_ne_zero)

/-- The recovery formula: the Euler derivative of the velocity is expressed from the
second velocity and its `σ`-transform. -/
theorem eulerDeriv_velocity_eq :
    eulerDeriv (toMahlerCarrier velocityJet) =
      (mahlerSigma (toMahlerCarrier secondJet) - 2 * toMahlerCarrier secondJet +
        (mahlerT * mahlerT) * (mahlerT * mahlerT)) *
      (2 * (mahlerT * mahlerT))⁻¹ := by
  have hsolve : mahlerSigma (toMahlerCarrier secondJet) - 2 * toMahlerCarrier secondJet +
      (mahlerT * mahlerT) * (mahlerT * mahlerT) =
      (2 * (mahlerT * mahlerT)) * eulerDeriv (toMahlerCarrier velocityJet) := by
    rw [mahlerSigma_secondJet]
    ring
  rw [hsolve, mul_comm (2 * (mahlerT * mahlerT)), mul_assoc,
    mul_inv_cancel₀ (G₀ := HahnSeries ℚ (RatFunc ℂ)) two_mahlerT_sq_ne_zero, mul_one]

/-- The coefficient restriction of evaluation at the velocity into the velocity field. -/
def velocityPolyEvalK : Polynomial MahlerBase →+* ↥velocityField where
  toFun W := ⟨velocityPolyEval W, velocityPolyEval_mem_velocityField W⟩
  map_one' := Subtype.ext (map_one velocityPolyEval)
  map_mul' a b := Subtype.ext (map_mul velocityPolyEval a b)
  map_zero' := Subtype.ext (map_zero velocityPolyEval)
  map_add' a b := Subtype.ext (map_add velocityPolyEval a b)

theorem velocityPolyEvalK_injective : Function.Injective velocityPolyEvalK := by
  intro a b hab
  by_contra hne
  have hval : velocityPolyEval a = velocityPolyEval b := congrArg Subtype.val hab
  exact velocityPolyEval_ne_zero (sub_ne_zero.mpr hne)
    (by rw [map_sub, hval, sub_self])

theorem two_mem_velocityField : (2 : HahnSeries ℚ (RatFunc ℂ)) ∈ velocityField := by
  rw [show (2 : HahnSeries ℚ (RatFunc ℂ)) = 1 + 1 from by norm_num]
  exact Subfield.add_mem _ (Subfield.one_mem _) (Subfield.one_mem _)

theorem mahlerT_sq_mem_velocityField :
    (mahlerT * mahlerT : HahnSeries ℚ (RatFunc ℂ)) ∈ velocityField := by
  rw [← monoRatEval_one_X_sq, ← velocityPolyEval_C]
  exact velocityPolyEval_mem_velocityField _

/-- **Transcendence of the second velocity over the velocity field.**  A polynomial
relation for `B` over `ℂ(t)[A]` would make `B` and — through the graded Mahler
automorphism and the recovery formula — the Euler derivative `θA` algebraic over
`ℂ(t)(A)`, contradicting the hypertranscendence of the velocity. -/
theorem secondJet_transcendental_over_velocity
    {W : Polynomial (Polynomial MahlerBase)} (hW : W ≠ 0) :
    Polynomial.eval₂ velocityPolyEval (toMahlerCarrier secondJet) W ≠ 0 := by
  intro heq
  classical
  have hBalg : IsAlgebraic ↥velocityField (toMahlerCarrier secondJet) := by
    refine ⟨W.map velocityPolyEvalK,
      (Polynomial.map_ne_zero_iff velocityPolyEvalK_injective).mpr hW, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    rw [show (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ))).comp
      velocityPolyEvalK = velocityPolyEval from RingHom.ext fun _ => rfl]
    exact heq
  have hBint : IsIntegral ↥velocityField (toMahlerCarrier secondJet) :=
    isAlgebraic_iff_isIntegral.mp hBalg
  have hσBalg : IsAlgebraic ↥velocityField (mahlerSigma (toMahlerCarrier secondJet)) := by
    obtain ⟨p, hp0, hpe⟩ := hBalg
    refine ⟨p.map velocityFieldSigma,
      (Polynomial.map_ne_zero_iff velocityFieldSigma_injective).mpr hp0, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    rw [show (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ))).comp
      velocityFieldSigma = mahlerSigma.toRingHom.comp
        (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ))) from
      RingHom.ext fun _ => rfl]
    rw [show Polynomial.eval₂ (mahlerSigma.toRingHom.comp
        (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ))))
        (mahlerSigma (toMahlerCarrier secondJet)) p =
      mahlerSigma (Polynomial.eval₂
        (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ)))
        (toMahlerCarrier secondJet) p) from (Polynomial.hom_eval₂ p _ _ _).symm]
    rw [show Polynomial.eval₂ (algebraMap ↥velocityField (HahnSeries ℚ (RatFunc ℂ)))
        (toMahlerCarrier secondJet) p =
      Polynomial.aeval (toMahlerCarrier secondJet) p from
      (Polynomial.aeval_def _ _).symm]
    rw [hpe, map_zero]
  have hσBint : IsIntegral ↥velocityField (mahlerSigma (toMahlerCarrier secondJet)) :=
    isAlgebraic_iff_isIntegral.mp hσBalg
  have hθAint : IsIntegral ↥velocityField (eulerDeriv (toMahlerCarrier velocityJet)) := by
    rw [eulerDeriv_velocity_eq]
    apply (mem_integralClosure_iff ↥velocityField (HahnSeries ℚ (RatFunc ℂ))).mp
    apply Subalgebra.mul_mem
    · apply Subalgebra.add_mem
      · apply Subalgebra.sub_mem
        · exact (mem_integralClosure_iff _ _).mpr hσBint
        · apply Subalgebra.mul_mem
          · rw [show (2 : HahnSeries ℚ (RatFunc ℂ)) = 1 + 1 from by norm_num]
            exact Subalgebra.add_mem _ (Subalgebra.one_mem _) (Subalgebra.one_mem _)
          · exact (mem_integralClosure_iff _ _).mpr hBint
      · exact (mem_integralClosure_iff _ _).mpr
          (isIntegral_algebraMap (x := (⟨_, Subfield.mul_mem _ mahlerT_sq_mem_velocityField
            mahlerT_sq_mem_velocityField⟩ : ↥velocityField)))
    · exact (mem_integralClosure_iff _ _).mpr
        (isIntegral_algebraMap (x := (⟨_, Subfield.inv_mem _ (Subfield.mul_mem _
          two_mem_velocityField mahlerT_sq_mem_velocityField)⟩ : ↥velocityField)))
  obtain ⟨q, hq0, hqe⟩ := isAlgebraic_iff_isIntegral.mpr hθAint
  have hcoeffmem : ∀ i : ℕ, ∃ f : RatFunc MahlerBase,
      velocityEmbed f = (q.coeff i).val :=
    fun i => mem_velocityField_iff.mp (q.coeff i).prop
  choose f hf using hcoeffmem
  obtain ⟨D, hD⟩ := IsLocalization.exist_integer_multiples
    (nonZeroDivisors (Polynomial MahlerBase)) q.support f
  set N : ℕ → Polynomial MahlerBase := fun i =>
    if hi : i ∈ q.support then (hD i hi).choose else 0 with hN
  have hNspec : ∀ i ∈ q.support,
      algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) (N i) = (D : Polynomial MahlerBase) • f i := by
    intro i hi
    rw [hN]
    simp only [dif_pos hi]
    exact (hD i hi).choose_spec
  set W' : Polynomial (Polynomial MahlerBase) :=
    q.support.sum (fun i => Polynomial.C (N i) * Polynomial.X ^ i) with hW'
  have hqsum : ∑ i ∈ q.support, (q.coeff i).val *
      eulerDeriv (toMahlerCarrier velocityJet) ^ i = 0 := by
    have := hqe
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum, Polynomial.sum_def] at this
    exact this
  have heval' : Polynomial.eval₂ velocityPolyEval
      (eulerDeriv (toMahlerCarrier velocityJet)) W' = 0 := by
    rw [hW', Polynomial.eval₂_finsetSum]
    have hterm : ∀ i ∈ q.support,
        Polynomial.eval₂ velocityPolyEval (eulerDeriv (toMahlerCarrier velocityJet))
          (Polynomial.C (N i) * Polynomial.X ^ i) =
        velocityEmbed (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
          (D : Polynomial MahlerBase)) *
          ((q.coeff i).val * eulerDeriv (toMahlerCarrier velocityJet) ^ i) := by
      intro i hi
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_X]
      rw [show velocityPolyEval (N i) = velocityEmbed
        (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) (N i)) from
        (velocityEmbed_algebraMap (N i)).symm]
      have hcombined : algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) (N i) =
          algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
            (D : Polynomial MahlerBase) * f i :=
        (hNspec i hi).trans (Algebra.smul_def (R := Polynomial MahlerBase)
          (A := RatFunc MahlerBase) _ _)
      rw [hcombined, map_mul, hf i]
      ring
    rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, hqsum, mul_zero]
  have hW'0 : W' ≠ 0 := by
    obtain ⟨i₀, hi₀⟩ := Polynomial.support_nonempty.mpr hq0
    have hqi₀ : q.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    have hfi₀ : f i₀ ≠ 0 := by
      intro h0
      apply hqi₀
      apply Subtype.ext
      rw [← hf i₀, h0, map_zero]
      rfl
    have hNi₀ : N i₀ ≠ 0 := by
      intro h0
      have hcombined : algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase) (N i₀) =
          algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
            (D : Polynomial MahlerBase) * f i₀ :=
        (hNspec i₀ hi₀).trans (Algebra.smul_def (R := Polynomial MahlerBase)
          (A := RatFunc MahlerBase) _ _)
      rw [h0, map_zero] at hcombined
      have hD0 : (D : Polynomial MahlerBase) ≠ 0 := nonZeroDivisors.ne_zero D.prop
      have halgD : algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
          (D : Polynomial MahlerBase) ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial MahlerBase)
          (RatFunc MahlerBase))).mpr hD0
      apply hfi₀
      calc f i₀ = (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
            (D : Polynomial MahlerBase))⁻¹ *
            (algebraMap (Polynomial MahlerBase) (RatFunc MahlerBase)
              (D : Polynomial MahlerBase) * f i₀) := by
            rw [← mul_assoc, inv_mul_cancel₀ (G₀ := RatFunc MahlerBase) halgD, one_mul]
        _ = 0 := by rw [← hcombined, mul_zero]
    intro h0
    apply hNi₀
    have hcoe : W'.coeff i₀ = N i₀ := by
      rw [hW', Polynomial.finsetSum_coeff]
      rw [Finset.sum_eq_single i₀ (fun j _ hj => by
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
          if_neg (fun hc => hj (by omega)), mul_zero])
        (fun hnotin => absurd hi₀ hnotin)]
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    rw [← hcoe, h0, Polynomial.coeff_zero]
  exact velocity_theta_pair_ne_zero hW'0 heval'

/-! ## The packaged pair statement -/

theorem toMvTwo_section :
    toMvTwo.comp (MvPolynomial.eval₂Hom
        ((Polynomial.C.comp Polynomial.C :
          MahlerBase →+* Polynomial (Polynomial MahlerBase)))
        (fun i : Fin 2 => if i = 0 then Polynomial.C Polynomial.X else Polynomial.X)) =
      RingHom.id (MvPolynomial (Fin 2) MahlerBase) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    rw [RingHom.comp_apply, RingHom.id_apply, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    rw [show toMvTwo (Polynomial.C (Polynomial.C r)) =
      Polynomial.eval₂ (MvPolynomial.C : MahlerBase →+* MvPolynomial (Fin 2) MahlerBase)
        (MvPolynomial.X 0) (Polynomial.C r) from Polynomial.eval₂_C _ _]
    rw [Polynomial.eval₂_C]
  · intro i
    rw [RingHom.comp_apply, RingHom.id_apply, MvPolynomial.eval₂Hom_X']
    fin_cases i
    · beta_reduce
      simp only [Fin.mk_zero]
      rw [if_true]
      rw [show toMvTwo (Polynomial.C Polynomial.X) =
        Polynomial.eval₂ (MvPolynomial.C :
          MahlerBase →+* MvPolynomial (Fin 2) MahlerBase)
          (MvPolynomial.X 0) Polynomial.X from Polynomial.eval₂_C _ _]
      rw [Polynomial.eval₂_X]
    · beta_reduce
      simp only [Fin.mk_one]
      rw [if_neg (by norm_num)]
      exact Polynomial.eval₂_X _ _

/-- Evaluation through the two-variable correspondence, with the first variable pinned at
the velocity. -/
theorem toMvTwo_eval (y : HahnSeries ℚ (RatFunc ℂ)) :
    (MvPolynomial.eval₂Hom (monoRatEval 1 one_pos)
        ![toMahlerCarrier velocityJet, y]).comp toMvTwo =
      Polynomial.eval₂RingHom velocityPolyEval y := by
  apply Polynomial.ringHom_ext
  · intro a
    rw [RingHom.comp_apply,
      show toMvTwo (Polynomial.C a) =
        Polynomial.eval₂ (MvPolynomial.C :
          MahlerBase →+* MvPolynomial (Fin 2) MahlerBase) (MvPolynomial.X 0) a from
        Polynomial.eval₂_C _ _]
    rw [show (Polynomial.eval₂RingHom velocityPolyEval y) (Polynomial.C a) =
      velocityPolyEval a from Polynomial.eval₂_C _ _]
    induction a using Polynomial.induction_on' with
    | add p q hp hq => rw [Polynomial.eval₂_add, map_add, hp, hq, map_add]
    | monomial n e =>
      rw [show (Polynomial.monomial n e : Polynomial MahlerBase) =
        Polynomial.C e * Polynomial.X ^ n from by
        rw [Polynomial.C_mul_X_pow_eq_monomial]]
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_X, map_mul, map_pow, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_X', map_mul, map_pow, velocityPolyEval_C,
        velocityPolyEval_X]
      rw [show (![toMahlerCarrier velocityJet, y] : Fin 2 →
        HahnSeries ℚ (RatFunc ℂ)) 0 = toMahlerCarrier velocityJet from rfl]
  · rw [RingHom.comp_apply,
      show toMvTwo Polynomial.X = MvPolynomial.X 1 from Polynomial.eval₂_X _ _,
      MvPolynomial.eval₂Hom_X']
    rw [show (Polynomial.eval₂RingHom velocityPolyEval y) Polynomial.X = y from
      Polynomial.eval₂_X _ _]
    rfl

/-- **Algebraic independence of the first two Böttcher parameter velocities over the base
field, in the graded carrier**: no nonzero two-variable polynomial over `ℂ(t)` vanishes at
the pair `(A, B)`. -/
theorem velocity_pair_algebraicIndependent
    {P : MvPolynomial (Fin 2) MahlerBase} (hP : P ≠ 0) :
    MvPolynomial.eval₂ (monoRatEval 1 one_pos)
      ![toMahlerCarrier velocityJet, toMahlerCarrier secondJet] P ≠ 0 := by
  intro heq
  set W : Polynomial (Polynomial MahlerBase) := MvPolynomial.eval₂Hom
    ((Polynomial.C.comp Polynomial.C :
      MahlerBase →+* Polynomial (Polynomial MahlerBase)))
    (fun i : Fin 2 => if i = 0 then Polynomial.C Polynomial.X else Polynomial.X) P
    with hWdef
  have hWP : toMvTwo W = P := by
    rw [hWdef, ← RingHom.comp_apply, toMvTwo_section, RingHom.id_apply]
  have hW0 : W ≠ 0 := fun h0 => hP (by rw [← hWP, h0, map_zero])
  apply secondJet_transcendental_over_velocity hW0
  have hbr : ((MvPolynomial.eval₂Hom (monoRatEval 1 one_pos)
      ![toMahlerCarrier velocityJet, toMahlerCarrier secondJet]).comp toMvTwo) W =
      Polynomial.eval₂ velocityPolyEval (toMahlerCarrier secondJet) W := by
    rw [toMvTwo_eval]
    rfl
  rw [← hbr]
  show MvPolynomial.eval₂ (monoRatEval 1 one_pos)
    ![toMahlerCarrier velocityJet, toMahlerCarrier secondJet] (toMvTwo W) = 0
  rw [hWP]
  exact heq

end

