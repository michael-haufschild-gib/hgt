import GaloisForLFunctions.ArithmeticCorrespondencePositivity.HorizonAveragesSelectTheZeros
import Mathlib.Analysis.Normed.Group.Tannery
import Mathlib.MeasureTheory.Integral.ExpDecay

/-!
# Infinite dominant configurations are complete

`TheEscapeRankCountsTheDominantZeros` classifies the escape states of a finite dominant
configuration. This file removes the finiteness: a configuration
`F(u) = Σ_k c_k e^{(x + i y_k) u}` with infinitely many distinct frequencies `y_k` and absolutely
summable coefficients (an almost periodic profile on the dominant line) has the same theory.

* **Bohr uniqueness** (`eq_zero_of_expSeries_eq_zero`). If `S(t) = Σ_k v_k e^{−i y_k t}`, `v ∈ ℓ¹`,
  vanishes for `t > 0`, then `v = 0`: the mean of `S(t) e^{i y_m t}` over `[0, T]` is
  `Σ_k v_k · mean(e^{i(y_m − y_k)t})`, which tends to `v_m` by dominated convergence of the series,
  and it is `0`.
* **The Cauchy form** (`cauchyFormSeries_eq_integral`, `integral_cauchyDensitySeries_pos`).
  `Σ_{k,l} v_k v̄_l / (2x + i(y_k − y_l)) = ∫_0^∞ e^{−2xt} |S(t)|² dt`, positive for `v ≠ 0`.
* **The horizon law** (`exp_mul_hermGram_series_eq`). For `L ≥ 0`,
  `e^{−2xL} ∫_0^L F(u − a) F̄(u − b) du = K_{θ(L)}(a, b) − e^{−2xL} K_1(a, b)`, with the phase
  kernels `K_θ = Σ_{k,l} (c_kθ_kψ_k(a)) conj(c_lθ_lψ_l(b))/(2x + i(y_k − y_l))`.
* **Every escape state is a phase kernel** (`exists_tendsto_escapeKernelSeries`): along any horizons
  a subsequence of the scaled Grams converges, for all `a, b`, to `K_θ` with `|θ_k| = 1` (the
  torus `(S¹)^ℕ` is compact and metrizable).
* **The null space** (`escapeFormSeries_eq_zero_iff`). For finitely many weights `w_i` at points
  `a_i`, the escape form vanishes iff `Σ_i w_i ψ_k(a_i) = 0` for every `k`.

So escape completeness holds for every absolutely summable configuration of dominant zeros: the
escape states are phase kernels generated by the translated-zero characters, now of infinite rank.
What can still fail for `ζ` is the summability of the residues and the split of the profile into
such a configuration and a subdominant remainder.
-/

open Complex MeasureTheory Set Filter Topology
open scoped ComplexConjugate

noncomputable section

namespace GaloisForLFunctions.ArithmeticCorrespondencePositivity

/-! ### Exponential series -/

theorem norm_expTerm (a : ℂ) (p t : ℝ) : ‖a * Complex.exp (-((p * t : ℝ) * I))‖ = ‖a‖ := by
  rw [norm_mul, show -((p * t : ℝ) * I) = ((-(p * t) : ℝ) : ℂ) * I by push_cast; ring,
    Complex.norm_exp_ofReal_mul_I, mul_one]

/-- The exponential series `S(t) = Σ_k v_k e^{−i y_k t}`. -/
def expSeries (y : ℕ → ℝ) (v : ℕ → ℂ) (t : ℝ) : ℂ :=
  ∑' k, v k * Complex.exp (-((y k * t : ℝ) * I))

theorem summable_expTerm {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖) (y : ℕ → ℝ) (t : ℝ) :
    Summable fun k => ‖v k * Complex.exp (-((y k * t : ℝ) * I))‖ :=
  hv.congr fun k => (norm_expTerm (v k) (y k) t).symm

theorem continuous_expSeries {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖) (y : ℕ → ℝ) :
    Continuous (expSeries y v) :=
  continuous_tsum (fun _ => by fun_prop) hv fun k t => (norm_expTerm (v k) (y k) t).le

theorem norm_expSeries_le {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖) (y : ℕ → ℝ) (t : ℝ) :
    ‖expSeries y v t‖ ≤ ∑' k, ‖v k‖ :=
  (norm_tsum_le_tsum_norm (summable_expTerm hv y t)).trans
    (le_of_eq (tsum_congr fun _ => norm_expTerm _ _ _))

/-! ### Bohr uniqueness -/

/-- The mean of `e^{iωt}` over `[0, T]` tends to `1` at `ω = 0` and to `0` otherwise. -/
theorem tendsto_mean_phaseExp (ω : ℝ) :
    Tendsto (fun T : ℝ => (T : ℂ)⁻¹ * ∫ t in (0 : ℝ)..T, Complex.exp ((ω : ℂ) * I * t)) atTop
      (𝓝 (if ω = 0 then 1 else 0)) := by
  split_ifs with hω
  · subst hω
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with T hT
    rw [integral_phaseExp_zero, inv_mul_cancel₀ (Complex.ofReal_ne_zero.mpr hT.ne')]
  · rw [tendsto_zero_iff_norm_tendsto_zero]
    have hlim : Tendsto (fun T : ℝ => T⁻¹ * (2 / |ω|)) atTop (𝓝 0) := by
      simpa using tendsto_inv_atTop_zero.mul_const (2 / |ω|)
    refine squeeze_zero' (Eventually.of_forall fun T => norm_nonneg _) ?_ hlim
    filter_upwards [eventually_gt_atTop 0] with T hT
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hT]
    exact mul_le_mul_of_nonneg_left (norm_integral_phaseExp_le hω T) (inv_nonneg.mpr hT.le)

theorem norm_mean_phaseExp_le_one (ω : ℝ) {T : ℝ} (hT : 0 < T) :
    ‖(T : ℂ)⁻¹ * ∫ t in (0 : ℝ)..T, Complex.exp ((ω : ℂ) * I * t)‖ ≤ 1 := by
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hT]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := T) (C := 1)
    (f := fun t : ℝ => Complex.exp ((ω : ℂ) * I * t)) fun t _ => by
      rw [show (ω : ℂ) * I * t = ((ω * t : ℝ) : ℂ) * I by push_cast; ring]
      exact (Complex.norm_exp_ofReal_mul_I _).le
  rw [sub_zero, abs_of_pos hT, one_mul] at h
  calc T⁻¹ * ‖∫ t in (0 : ℝ)..T, Complex.exp ((ω : ℂ) * I * t)‖ ≤ T⁻¹ * T :=
        mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hT.le)
    _ = 1 := inv_mul_cancel₀ hT.ne'

/-- **Bohr uniqueness**: an absolutely convergent exponential series vanishing on `t > 0` has
zero coefficients. -/
theorem eq_zero_of_expSeries_eq_zero {y : ℕ → ℝ} (hy : Function.Injective y) {v : ℕ → ℂ}
    (hv : Summable fun k => ‖v k‖) (h : ∀ t : ℝ, 0 < t → expSeries y v t = 0) : v = 0 := by
  funext m
  have hF : ∀ t : ℝ, expSeries y v t * Complex.exp (((y m : ℝ) : ℂ) * I * t) =
      ∑' k, v k * Complex.exp (((y m - y k : ℝ) : ℂ) * I * t) := by
    intro t
    rw [expSeries, ← tsum_mul_right]
    refine tsum_congr fun k => ?_
    rw [mul_assoc, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  have hnorm : ∀ k (t : ℝ), ‖v k * Complex.exp (((y m - y k : ℝ) : ℂ) * I * t)‖ = ‖v k‖ := by
    intro k t
    rw [norm_mul, show ((y m - y k : ℝ) : ℂ) * I * t = (((y m - y k) * t : ℝ) : ℂ) * I by
      push_cast; ring, Complex.norm_exp_ofReal_mul_I, mul_one]
  -- the means of `S(t) e^{i y_m t}` as a series of means
  have hmean : ∀ T : ℝ, 0 < T → (T : ℂ)⁻¹ * ∫ t in (0 : ℝ)..T,
      expSeries y v t * Complex.exp (((y m : ℝ) : ℂ) * I * t) =
        ∑' k, v k * ((T : ℂ)⁻¹ * ∫ t in (0 : ℝ)..T, Complex.exp (((y m - y k : ℝ) : ℂ) * I * t)) := by
    intro T hT
    simp_rw [hF]
    rw [intervalIntegral.integral_of_le hT.le, ← integral_tsum_of_summable_integral_norm]
    · rw [← tsum_mul_left]
      refine tsum_congr fun k => ?_
      rw [intervalIntegral.integral_of_le hT.le, integral_const_mul]
      ring
    · intro k
      exact (Continuous.integrableOn_Icc (by fun_prop)).mono_set Ioc_subset_Icc_self
    · refine (hv.mul_right T).congr fun k => ?_
      simp_rw [hnorm]
      rw [← intervalIntegral.integral_of_le hT.le, intervalIntegral.integral_const, smul_eq_mul,
        sub_zero, mul_comm]
  have hzero : ∀ T : ℝ, 0 < T → ∫ t in (0 : ℝ)..T,
      expSeries y v t * Complex.exp (((y m : ℝ) : ℂ) * I * t) = 0 := by
    intro T hT
    rw [intervalIntegral.integral_of_le hT.le]
    exact setIntegral_eq_zero_of_forall_eq_zero fun t ht => by rw [h t ht.1, zero_mul]
  -- dominated convergence of the series of means
  have hlim : Tendsto (fun T : ℝ => ∑' k, v k * ((T : ℂ)⁻¹ *
      ∫ t in (0 : ℝ)..T, Complex.exp (((y m - y k : ℝ) : ℂ) * I * t))) atTop
        (𝓝 (∑' k, v k * (if y m - y k = 0 then 1 else 0))) := by
    refine tendsto_tsum_of_dominated_convergence hv
      (fun k => (tendsto_mean_phaseExp (y m - y k)).const_mul (v k)) ?_
    filter_upwards [eventually_gt_atTop 0] with T hT k
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_mean_phaseExp_le_one _ hT)
  have hval : ∑' k, v k * (if y m - y k = 0 then (1 : ℂ) else 0) = v m := by
    rw [tsum_eq_single m]
    · simp
    · intro k hk
      rw [if_neg (sub_ne_zero.mpr fun h => hk (hy h).symm), mul_zero]
  rw [hval] at hlim
  have h0 : Tendsto (fun T : ℝ => ∑' k, v k * ((T : ℂ)⁻¹ *
      ∫ t in (0 : ℝ)..T, Complex.exp (((y m - y k : ℝ) : ℂ) * I * t))) atTop (𝓝 0) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with T hT
    rw [← hmean T hT, hzero T hT, mul_zero]
  exact tendsto_nhds_unique hlim h0

/-! ### The Cauchy form of a summable configuration -/

theorem norm_conj_expTerm (a : ℂ) (p t : ℝ) :
    ‖conj (a * Complex.exp (-((p * t : ℝ) * I)))‖ = ‖a‖ := by
  rw [Complex.norm_conj, norm_expTerm]

theorem summable_mul_norm {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖) :
    Summable fun p : ℕ × ℕ => ‖v p.1‖ * ‖v p.2‖ :=
  summable_mul_of_summable_norm (f := fun k => ‖v k‖) (g := fun k => ‖v k‖)
    (by simpa using hv) (by simpa using hv)

theorem summable_cauchyTerm {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {v : ℕ → ℂ}
    (hv : Summable fun k => ‖v k‖) :
    Summable fun p : ℕ × ℕ => v p.1 * conj (v p.2) / (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) := by
  refine Summable.of_norm_bounded ((summable_mul_norm hv).mul_right (1 / (2 * x))) fun p => ?_
  rw [norm_div, norm_mul, Complex.norm_conj]
  have hden : 2 * x ≤ ‖2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I‖ := by
    refine le_trans (le_of_eq ?_) (Complex.abs_re_le_norm _)
    simp only [Complex.add_re, Complex.mul_re, Complex.I_re, Complex.I_im, Complex.sub_re,
      Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im]
    norm_num
    exact (abs_of_pos hx).symm
  rw [div_eq_mul_one_div]
  exact mul_le_mul_of_nonneg_left (one_div_le_one_div_of_le (by linarith) hden)
    (by positivity)

/-- The density `e^{−2xt}|S(t)|²`. -/
def cauchyDensitySeries (x : ℝ) (y : ℕ → ℝ) (v : ℕ → ℂ) (t : ℝ) : ℝ :=
  Real.exp (-(2 * x * t)) * ‖expSeries y v t‖ ^ 2

theorem cauchyDensitySeries_eq (x : ℝ) (y : ℕ → ℝ) {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖)
    (t : ℝ) :
    (cauchyDensitySeries x y v t : ℂ) = ∑' p : ℕ × ℕ, v p.1 * conj (v p.2) *
      Complex.exp (-(2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) * t) := by
  rw [cauchyDensitySeries, Complex.ofReal_mul, Complex.ofReal_pow, ← Complex.mul_conj', expSeries,
    Complex.conj_tsum, tsum_mul_tsum_of_summable_norm (summable_expTerm hv y t)
      (hv.congr fun k => (norm_conj_expTerm (v k) (y k) t).symm), ← tsum_mul_left]
  refine tsum_congr fun p => ?_
  have h : (Real.exp (-(2 * x * t)) : ℂ) * (Complex.exp (-((y p.1 * t : ℝ) * I)) *
      conj (Complex.exp (-((y p.2 * t : ℝ) * I)))) =
        Complex.exp (-(2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) * t) := by
    rw [Complex.ofReal_exp, ← Complex.exp_conj, ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    simp only [map_neg, map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  rw [map_mul]
  linear_combination (v p.1 * conj (v p.2)) * h

/-- **The Cauchy form of a summable configuration as an integral.** -/
theorem cauchyFormSeries_eq_integral {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {v : ℕ → ℂ}
    (hv : Summable fun k => ‖v k‖) :
    ∑' p : ℕ × ℕ, v p.1 * conj (v p.2) / (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) =
      ((∫ t in Ioi (0 : ℝ), cauchyDensitySeries x y v t : ℝ) : ℂ) := by
  rw [← integral_complex_ofReal]
  simp_rw [cauchyDensitySeries_eq x y hv]
  have hint : ∀ p : ℕ × ℕ, Integrable (fun t : ℝ => v p.1 * conj (v p.2) *
      Complex.exp (-(2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) * t)) (volume.restrict (Ioi 0)) :=
    fun p => (integrableOn_exp_mul_complex_Ioi (re_neg_den_neg hx (y p.1) (y p.2)) 0).const_mul _
  have hnorm : ∀ (p : ℕ × ℕ) (t : ℝ), ‖v p.1 * conj (v p.2) *
      Complex.exp (-(2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) * t)‖ =
        ‖v p.1‖ * ‖v p.2‖ * Real.exp (-(2 * x) * t) := by
    intro p t
    rw [norm_mul, norm_mul, Complex.norm_conj, Complex.norm_exp]
    congr 2
    simp
  rw [← integral_tsum_of_summable_integral_norm hint]
  · refine tsum_congr fun p => ?_
    rw [integral_const_mul, integral_exp_mul_complex_Ioi (re_neg_den_neg hx (y p.1) (y p.2)) 0,
      Complex.ofReal_zero, mul_zero, Complex.exp_zero, neg_div_neg_eq]
    ring
  · simp_rw [hnorm, integral_const_mul]
    exact (summable_mul_norm hv).mul_right _

theorem integrable_cauchyDensitySeries {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {v : ℕ → ℂ}
    (hv : Summable fun k => ‖v k‖) :
    Integrable (cauchyDensitySeries x y v) (volume.restrict (Ioi 0)) := by
  refine Integrable.mono' (((exp_neg_integrableOn_Ioi 0 (by linarith : 0 < 2 * x))).const_mul
    ((∑' k, ‖v k‖) ^ 2)) ?_ (Eventually.of_forall fun t => ?_)
  · exact (by unfold cauchyDensitySeries; have := continuous_expSeries hv y; fun_prop :
      Continuous (cauchyDensitySeries x y v)).aestronglyMeasurable
  · rw [cauchyDensitySeries, Real.norm_eq_abs, abs_of_nonneg (by positivity),
      show -(2 * x) * t = -(2 * x * t) by ring, mul_comm]
    exact mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ (norm_nonneg _) (norm_expSeries_le hv y t) 2) (Real.exp_pos _).le

/-- **The Cauchy form of a summable configuration is positive.** -/
theorem integral_cauchyDensitySeries_pos {x : ℝ} (hx : 0 < x) {y : ℕ → ℝ}
    (hy : Function.Injective y) {v : ℕ → ℂ} (hv : Summable fun k => ‖v k‖) (hv0 : v ≠ 0) :
    0 < ∫ t in Ioi (0 : ℝ), cauchyDensitySeries x y v t := by
  obtain ⟨t₀, ht₀, hS⟩ : ∃ t₀ : ℝ, 0 < t₀ ∧ expSeries y v t₀ ≠ 0 := by
    by_contra hcon
    exact hv0 (eq_zero_of_expSeries_eq_zero hy hv fun t ht => by_contra fun hne => hcon ⟨t, ht, hne⟩)
  have hcont : Continuous (cauchyDensitySeries x y v) := by
    have := continuous_expSeries hv y
    unfold cauchyDensitySeries
    fun_prop
  have hnn : 0 ≤ cauchyDensitySeries x y v := fun t => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  rw [integral_pos_iff_support_of_nonneg hnn (integrable_cauchyDensitySeries hx y hv),
    Measure.restrict_apply' measurableSet_Ioi]
  refine IsOpen.measure_pos volume ((isOpen_ne_fun hcont continuous_const).inter isOpen_Ioi)
    ⟨t₀, ?_, ht₀⟩
  exact (mul_pos (Real.exp_pos _) (pow_pos (norm_pos_iff.mpr hS) 2)).ne'

theorem integral_cauchyDensitySeries_zero (x : ℝ) (y : ℕ → ℝ) :
    ∫ t in Ioi (0 : ℝ), cauchyDensitySeries x y 0 t = 0 := by
  simp [cauchyDensitySeries, expSeries]

/-! ### Summable configurations and their phase kernels -/

theorem norm_transChar (x y a : ℝ) : ‖transChar x y a‖ = Real.exp (-(x * a)) := by
  rw [transChar, Complex.norm_exp]
  congr 1
  simp

/-- A summable dominant configuration `F(u) = Σ_k c_k e^{(x + i y_k) u}`. -/
def domSeries (x : ℝ) (y : ℕ → ℝ) (c : ℕ → ℂ) (u : ℝ) : ℂ :=
  ∑' k, c k * Complex.exp (((x : ℂ) + y k * I) * u)

/-- The phase kernel `K_θ(a, b)` of a summable configuration. -/
def escapeKernelSeries (x : ℝ) (y : ℕ → ℝ) (c θ : ℕ → ℂ) (a b : ℝ) : ℂ :=
  ∑' p : ℕ × ℕ, c p.1 * θ p.1 * transChar x (y p.1) a *
    conj (c p.2 * θ p.2 * transChar x (y p.2) b) / (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I)

/-- The phases `e^{i y_k L}`. -/
def phaseSeries (y : ℕ → ℝ) (L : ℝ) (k : ℕ) : ℂ := Complex.exp ((y k * L : ℝ) * I)

theorem norm_phaseSeries (y : ℕ → ℝ) (L : ℝ) (k : ℕ) : ‖phaseSeries y L k‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

/-- One entry of a phase kernel is at most `|c_k||c_l| e^{−xa}e^{−xb}/(2x)` for `|θ| ≤ 1`. -/
theorem norm_kernelEntry_le {x : ℝ} (hx : 0 < x) (ck cl θk θl : ℂ) (yk yl a b : ℝ)
    (hθk : ‖θk‖ ≤ 1) (hθl : ‖θl‖ ≤ 1) :
    ‖ck * θk * transChar x yk a * conj (cl * θl * transChar x yl b) /
        (2 * (x : ℂ) + ((yk : ℂ) - yl) * I)‖ ≤
      ‖ck‖ * ‖cl‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b)) / (2 * x)) := by
  have hden : 2 * x ≤ ‖2 * (x : ℂ) + ((yk : ℂ) - yl) * I‖ := by
    refine le_trans (le_of_eq ?_) (Complex.abs_re_le_norm _)
    simp only [Complex.add_re, Complex.mul_re, Complex.I_re, Complex.I_im, Complex.sub_re,
      Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im]
    norm_num
    exact (abs_of_pos hx).symm
  rw [norm_div, norm_mul, norm_mul, norm_mul, Complex.norm_conj, norm_mul, norm_mul,
    norm_transChar, norm_transChar]
  have hc1 := norm_nonneg ck
  have hc2 := norm_nonneg cl
  have hθ2 := norm_nonneg θl
  have he1 := (Real.exp_pos (-(x * a))).le
  have he2 := (Real.exp_pos (-(x * b))).le
  have hnum : ‖ck‖ * ‖θk‖ * Real.exp (-(x * a)) * (‖cl‖ * ‖θl‖ * Real.exp (-(x * b))) ≤
      ‖ck‖ * ‖cl‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b))) := by
    have := mul_le_mul hθk hθl hθ2 zero_le_one
    nlinarith [mul_nonneg (mul_nonneg hc1 hc2) (mul_nonneg he1 he2)]
  calc ‖ck‖ * ‖θk‖ * Real.exp (-(x * a)) * (‖cl‖ * ‖θl‖ * Real.exp (-(x * b))) /
        ‖2 * (x : ℂ) + ((yk : ℂ) - yl) * I‖
      ≤ ‖ck‖ * ‖cl‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b))) / (2 * x) :=
        div_le_div₀ (by positivity) hnum (by linarith) hden
    _ = _ := by ring

theorem norm_kernelTerm_le {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) (c θ : ℕ → ℂ)
    (hθ : ∀ k, ‖θ k‖ ≤ 1) (a b : ℝ) (p : ℕ × ℕ) :
    ‖c p.1 * θ p.1 * transChar x (y p.1) a * conj (c p.2 * θ p.2 * transChar x (y p.2) b) /
        (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I)‖ ≤
      ‖c p.1‖ * ‖c p.2‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b)) / (2 * x)) :=
  norm_kernelEntry_le hx _ _ _ _ _ _ a b (hθ p.1) (hθ p.2)

theorem summable_kernelTerm {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {c : ℕ → ℂ}
    (hc : Summable fun k => ‖c k‖) (θ : ℕ → ℂ) (hθ : ∀ k, ‖θ k‖ ≤ 1) (a b : ℝ) :
    Summable fun p : ℕ × ℕ => c p.1 * θ p.1 * transChar x (y p.1) a *
      conj (c p.2 * θ p.2 * transChar x (y p.2) b) / (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) :=
  Summable.of_norm_bounded ((summable_mul_norm hc).mul_right _)
    (norm_kernelTerm_le hx y c θ hθ a b)

/-- **The horizon law for summable configurations.** -/
theorem exp_mul_hermGram_series_eq {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {c : ℕ → ℂ}
    (hc : Summable fun k => ‖c k‖) {L : ℝ} (hL : 0 ≤ L) (a b : ℝ) :
    (Real.exp (-(2 * x * L)) : ℂ) * hermGram (domSeries x y c) L a b =
      escapeKernelSeries x y c (phaseSeries y L) a b -
        (Real.exp (-(2 * x * L)) : ℂ) * escapeKernelSeries x y c 1 a b := by
  set β : ℕ × ℕ → ℂ := fun p => 2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I
  set C : ℕ × ℕ → ℂ := fun p => c p.1 * transChar x (y p.1) a * conj (c p.2 * transChar x (y p.2) b)
  have hnormterm : ∀ (k : ℕ) (u : ℝ),
      ‖c k * Complex.exp (((x : ℂ) + y k * I) * u)‖ = ‖c k‖ * Real.exp (x * u) := by
    intro k u; rw [norm_mul, Complex.norm_exp]; congr 2; simp
  have hsumterm : ∀ u : ℝ, Summable fun k => ‖c k * Complex.exp (((x : ℂ) + y k * I) * u)‖ :=
    fun u => (hc.mul_right (Real.exp (x * u))).congr fun k => (hnormterm k u).symm
  -- the integrand as a double series of exponentials
  have hprod : ∀ u : ℝ, domSeries x y c (u - a) * conj (domSeries x y c (u - b)) =
      ∑' p : ℕ × ℕ, C p * Complex.exp (β p * u) := by
    intro u
    rw [domSeries, domSeries, Complex.conj_tsum, tsum_mul_tsum_of_summable_norm (hsumterm (u - a))
      ((hsumterm (u - b)).congr fun k => (Complex.norm_conj _).symm)]
    refine tsum_congr fun p => ?_
    have h := exp_mul_conj_exp x (y p.1) (y p.2) u a b
    simp only [C, β, map_mul]
    linear_combination (c p.1 * conj (c p.2)) * h
  have hnormC : ∀ p : ℕ × ℕ, ‖C p‖ = ‖c p.1‖ * ‖c p.2‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b))) := by
    intro p
    simp only [C]
    rw [norm_mul, norm_mul, Complex.norm_conj, norm_mul, norm_transChar, norm_transChar]
    ring
  have hβre : ∀ p : ℕ × ℕ, (β p).re = 2 * x := by intro p; simp [β]
  have hint : ∀ p : ℕ × ℕ, Integrable (fun u : ℝ => C p * Complex.exp (β p * u))
      (volume.restrict (Ioc 0 L)) := fun p =>
    (Continuous.integrableOn_Icc (continuous_gramTerm (C p) (β p))).mono_set Ioc_subset_Icc_self
  have hsumint : Summable fun p : ℕ × ℕ => ∫ u in Ioc 0 L, ‖C p * Complex.exp (β p * u)‖ := by
    have : ∀ p : ℕ × ℕ, ∫ u in Ioc 0 L, ‖C p * Complex.exp (β p * u)‖ =
        ‖c p.1‖ * ‖c p.2‖ * ((Real.exp (-(x * a)) * Real.exp (-(x * b))) *
          ∫ u in Ioc 0 L, Real.exp (2 * x * u)) := by
      intro p
      have hn : ∀ u : ℝ, ‖C p * Complex.exp (β p * u)‖ =
          ‖C p‖ * Real.exp (2 * x * u) := by
        intro u; rw [norm_mul, Complex.norm_exp]; congr 2; simp [hβre p]
      simp_rw [hn, integral_const_mul, hnormC]
      ring
    simp_rw [this]
    exact (summable_mul_norm hc).mul_right _
  rw [hermGram, intervalIntegral.integral_of_le hL]
  simp_rw [hprod]
  rw [← integral_tsum_of_summable_integral_norm hint hsumint, ← tsum_mul_left]
  unfold escapeKernelSeries
  rw [← tsum_mul_left, ← Summable.tsum_sub (summable_kernelTerm hx y hc (phaseSeries y L)
    (fun k => (norm_phaseSeries y L k).le) a b)
    ((summable_kernelTerm hx y hc 1 (fun k => by simp) a b).mul_left _)]
  refine tsum_congr fun p => ?_
  rw [integral_const_mul, ← intervalIntegral.integral_of_le hL,
    integral_exp_mul_complex (den_ne_zero hx (y p.1) (y p.2))]
  have hE : (Real.exp (-(2 * x * L)) : ℂ) * Complex.exp (β p * L) =
      phaseSeries y L p.1 * conj (phaseSeries y L p.2) := by
    simp only [β, phaseSeries, Complex.ofReal_exp, ← Complex.exp_conj, ← Complex.exp_add]
    congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  simp only [C, Pi.one_apply, mul_one, map_mul, Complex.ofReal_zero, mul_zero, Complex.exp_zero]
  simp only [β] at hE
  linear_combination (c p.1 * transChar x (y p.1) a * (conj (c p.2) * conj (transChar x (y p.2) b)) /
    (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I)) * hE

theorem tendsto_escapeKernelSeries {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {c : ℕ → ℂ}
    (hc : Summable fun k => ‖c k‖) {θs : ℕ → ℕ → ℂ} {θ : ℕ → ℂ} (hθs : ∀ m k, ‖θs m k‖ ≤ 1)
    (h : Tendsto θs atTop (𝓝 θ)) (a b : ℝ) :
    Tendsto (fun m => escapeKernelSeries x y c (θs m) a b) atTop
      (𝓝 (escapeKernelSeries x y c θ a b)) := by
  have hk : ∀ k, Tendsto (fun m => θs m k) atTop (𝓝 (θ k)) :=
    fun k => ((continuous_apply k).tendsto θ).comp h
  unfold escapeKernelSeries
  refine tendsto_tsum_of_dominated_convergence ((summable_mul_norm hc).mul_right _)
    (fun p => ?_) (Eventually.of_forall fun m p => norm_kernelTerm_le hx y c (θs m) (hθs m) a b p)
  refine Filter.Tendsto.div_const ?_ _
  refine ((tendsto_const_nhds.mul (hk p.1)).mul tendsto_const_nhds).mul ?_
  exact (Complex.continuous_conj.tendsto _).comp
    ((tendsto_const_nhds.mul (hk p.2)).mul tendsto_const_nhds)

/-- **Every escape state of a summable configuration is a phase kernel.** -/
theorem exists_tendsto_escapeKernelSeries {x : ℝ} (hx : 0 < x) (y : ℕ → ℝ) {c : ℕ → ℂ}
    (hc : Summable fun k => ‖c k‖) {L : ℕ → ℝ} (hL0 : ∀ m, 0 ≤ L m)
    (hL : Tendsto L atTop atTop) :
    ∃ θ : ℕ → ℂ, (∀ k, ‖θ k‖ = 1) ∧ ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ a b : ℝ,
      Tendsto (fun m => (Real.exp (-(2 * x * L (φ m))) : ℂ) *
        hermGram (domSeries x y c) (L (φ m)) a b) atTop
          (𝓝 (escapeKernelSeries x y c θ a b)) := by
  have hS : IsCompact (Set.pi Set.univ fun _ : ℕ => Metric.sphere (0 : ℂ) 1) :=
    isCompact_univ_pi fun _ => isCompact_sphere 0 1
  have hmem : ∀ m, phaseSeries y (L m) ∈ Set.pi Set.univ fun _ : ℕ => Metric.sphere (0 : ℂ) 1 :=
    fun m k _ => by rw [mem_sphere_zero_iff_norm]; exact norm_phaseSeries y (L m) k
  obtain ⟨θ, hθ, φ, hφ, hlim⟩ := hS.tendsto_subseq hmem
  refine ⟨θ, fun k => by simpa using hθ k (Set.mem_univ k), φ, hφ, fun a b => ?_⟩
  have he : Tendsto (fun m => (Real.exp (-(2 * x * L (φ m))) : ℂ)) atTop (𝓝 0) := by
    have h1 : Tendsto (fun m => -(2 * x * L (φ m))) atTop atBot :=
      tendsto_neg_atTop_atBot.comp ((hL.comp hφ.tendsto_atTop).const_mul_atTop (by linarith))
    have h2 := (Complex.continuous_ofReal.tendsto 0).comp (Real.tendsto_exp_atBot.comp h1)
    rw [Complex.ofReal_zero] at h2
    exact h2
  have hK := tendsto_escapeKernelSeries hx y hc (θs := fun m => phaseSeries y (L (φ m)))
    (fun m k => (norm_phaseSeries y (L (φ m)) k).le) hlim a b
  have hsum := hK.sub (he.mul_const (escapeKernelSeries x y c 1 a b))
  rw [zero_mul, sub_zero] at hsum
  refine hsum.congr fun m => ?_
  exact (exp_mul_hermGram_series_eq hx y hc (hL0 (φ m)) a b).symm

/-! ### The null space -/

/-- **The null space of an escape state of a summable configuration** is the annihilator of the
dominant characters, whatever the phase. -/
theorem escapeFormSeries_eq_zero_iff {x : ℝ} (hx : 0 < x) {y : ℕ → ℝ} (hy : Function.Injective y)
    {c θ : ℕ → ℂ} (hc : Summable fun k => ‖c k‖) (hθ : ∀ k, ‖θ k‖ = 1) {ι : Type*}
    (s : Finset ι) (w : ι → ℂ) (pts : ι → ℝ) (hc0 : ∀ k, c k ≠ 0) :
    ∑ i ∈ s, ∑ i' ∈ s, w i * conj (w i') * escapeKernelSeries x y c θ (pts i) (pts i') = 0 ↔
      ∀ k, ∑ i ∈ s, w i * transChar x (y k) (pts i) = 0 := by
  set V : ℕ → ℂ := fun k => c k * θ k * ∑ i ∈ s, w i * transChar x (y k) (pts i)
  have hθ1 : ∀ k, ‖θ k‖ ≤ 1 := fun k => (hθ k).le
  have hV : Summable fun k => ‖V k‖ := by
    refine Summable.of_nonneg_of_le (fun k => norm_nonneg _) (fun k => ?_)
      (hc.mul_right (∑ i ∈ s, ‖w i‖ * Real.exp (-(x * pts i))))
    simp only [V]
    rw [norm_mul, norm_mul, hθ k, mul_one]
    refine mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans (le_of_eq ?_)) (norm_nonneg _)
    exact Finset.sum_congr rfl fun i _ => by rw [norm_mul, norm_transChar]
  -- the form is the Cauchy form of `V`
  have hform : ∑ i ∈ s, ∑ i' ∈ s, w i * conj (w i') * escapeKernelSeries x y c θ (pts i) (pts i') =
      ∑' p : ℕ × ℕ, V p.1 * conj (V p.2) / (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I) := by
    have hterm : ∀ i i', Summable fun p : ℕ × ℕ => w i * conj (w i') *
        (c p.1 * θ p.1 * transChar x (y p.1) (pts i) *
          conj (c p.2 * θ p.2 * transChar x (y p.2) (pts i')) /
            (2 * (x : ℂ) + ((y p.1 : ℂ) - y p.2) * I)) :=
      fun i i' => (summable_kernelTerm hx y hc θ hθ1 (pts i) (pts i')).mul_left _
    simp only [escapeKernelSeries, ← tsum_mul_left]
    rw [Finset.sum_congr rfl fun i _ => (Summable.tsum_finsetSum fun i' _ => hterm i i').symm,
      (Summable.tsum_finsetSum fun i _ => summable_sum fun i' _ => hterm i i').symm]
    refine tsum_congr fun p => ?_
    simp only [V, map_mul, map_sum, Finset.mul_sum, Finset.sum_mul, Finset.sum_div]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun i' _ => ?_
    ring
  rw [hform, cauchyFormSeries_eq_integral hx y hV, Complex.ofReal_eq_zero]
  constructor
  · intro h0 k
    by_cases hv : V = 0
    · have := congrFun hv k
      simp only [V, Pi.zero_apply, mul_eq_zero] at this
      rcases this with (h1 | h2) | h3
      · exact absurd h1 (hc0 k)
      · exact absurd (hθ k) (by rw [h2, norm_zero]; norm_num)
      · exact h3
    · exact absurd h0 (integral_cauchyDensitySeries_pos hx hy hV hv).ne'
  · intro h
    have hv : V = 0 := funext fun k => by simp [V, h k]
    rw [hv, integral_cauchyDensitySeries_zero]

end GaloisForLFunctions.ArithmeticCorrespondencePositivity
