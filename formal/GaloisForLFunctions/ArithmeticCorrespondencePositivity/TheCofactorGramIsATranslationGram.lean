import GaloisForLFunctions.ArithmeticDefectRigidity.TwoEulerFactorsDetermineThePoleTrace
import GaloisForLFunctions.ArithmeticDefectRigidity.WienerCovariancesFollowTheCommonCofactorLimit
import GaloisForLFunctions.ArithmeticContinuationAndCriticalEnergy.TheDilationSelfSimilarityOfThePronicMeasure

/-!
# The cofactor Gram is a translation Gram

The cofactor Grams of the damped Möbius receiver are the pronic pairings `⟨D_j v, D_k v⟩_T` of the
dilated rows `D_j v(n) = v(⌊n/j⌋)`; their normalized limits are the escape states of escape
completeness (Q1 of the report). This file reads them as correspondences on the log scale.

* **The Gram is a truncated translation Gram** (`pronicPairing_rowDilate_eq_translationGram`).
  With the log profile `g(u) = e^{−u/2} v(⌊e^u⌋)`,
  `⟨D_j v, D_k v⟩_T = (√j √k)⁻¹ ∫_0^{log(T+1)} g(u − log j) g(u − log k) du`:
  dilation by `j` is translation by `log j`, the pronic measure is Lebesgue measure on the log
  scale, and the horizon is the truncation. On the cell `[log n, log(n+1))` both dilates are constant
  and `∫ e^{−u} = 1/(n(n+1))`.
* **Exponential profiles give power characters** (`translationGram_exp`). For `g(u) = e^{λu}` and
  `h(u) = e^{μu}`, the translation Gram is `e^{−λa} e^{−μb} ∫ e^{(λ+μ)u}`: a translated-zero row
  `n^{ρ − ε}` has log profile `≈ e^{(ρ − ε − ½)u}`, and with the prefactor `(√j √k)⁻¹` its Gram is
  the power character `j^{−(ρ−ε)} k^{−(ρ'−ε)}`.
* **Escape states are determined modulo subdominant remainders**
  (`abs_pairing_rowDilate_sub_le`, `tendsto_normGram_sub_of_subdominant`). If `v = h + r` and the
  remainder is energetically subdominant along a sequence of horizons,
  `‖r‖_{T_m}/‖v‖_{T_m} → 0`, then the normalized Grams of `v` and the Grams of `h` normalized by
  `‖v‖²` have the same limits.
* **Finite combinations generate their Grams** (`pronicPairing_rowDilate_sum`). The Gram of
  `Σ c_i w_i` is `Σ c_i c_{i'} ⟨D_j w_i, D_k w_{i'}⟩`.

So escape completeness reduces to an energy statement: every escape state of the actual row is
generated by the translated-zero rows exactly when the row splits as a finite (or summable)
combination of those rows plus a remainder whose pronic energy is negligible against the row's.
Without such a split nothing forces completeness: a white-noise remainder of comparable energy
survives every constraint proved on the kernels (ADR).
-/

open MeasureTheory Set Finset Filter Topology
open GaloisForLFunctions.BezoutValuationIncidence (pronicNorm pronicNorm_nonneg pronicNorm_sq
  pronicNorm_add_le)
open GaloisForLFunctions.ArithmeticContinuationAndCriticalEnergy (pronicPairing rowDilate
  pronicNorm_rowDilate_le_sharp)
open GaloisForLFunctions.ArithmeticDefectRigidity (logProfile mem_Ico_log_iff abs_pronicPairing_le)

noncomputable section

namespace GaloisForLFunctions.ArithmeticCorrespondencePositivity

/-! ### The translation Gram identity -/

/-- `e^{−(u − log j)/2} = √j e^{−u/2}`. -/
theorem exp_neg_half_sub_log {j : ℝ} (hj : 0 < j) (u : ℝ) :
    Real.exp (-((u - Real.log j) / 2)) = Real.sqrt j * Real.exp (-(u / 2)) := by
  rw [show -((u - Real.log j) / 2) = Real.log j / 2 + -(u / 2) by ring, Real.exp_add,
    Real.sqrt_eq_rpow, Real.rpow_def_of_pos hj]
  ring_nf

/-- **Dilation is translation.** The log profile at `u − log j` reads the dilated row at `⌊e^u⌋`. -/
theorem logProfile_sub_log (v : ℕ → ℝ) {j : ℕ} (hj : 1 ≤ j) (u : ℝ) :
    logProfile v (u - Real.log j) =
      Real.sqrt j * Real.exp (-(u / 2)) * v (⌊Real.exp u⌋₊ / j) := by
  have hj0 : (0 : ℝ) < j := by exact_mod_cast hj
  rw [logProfile, exp_neg_half_sub_log hj0, Real.exp_sub, Real.exp_log hj0,
    Nat.floor_div_natCast (Real.exp u) j]

/-- The integrand of the translation Gram on the cell where `⌊e^u⌋ = m`. -/
theorem translationGram_integrand (v : ℕ → ℝ) {j k : ℕ} (hj : 1 ≤ j) (hk : 1 ≤ k) {u : ℝ} {m : ℕ}
    (hm : ⌊Real.exp u⌋₊ = m) :
    logProfile v (u - Real.log j) * logProfile v (u - Real.log k) =
      (Real.sqrt j * Real.sqrt k * (v (m / j) * v (m / k))) * Real.exp (-u) := by
  rw [logProfile_sub_log v hj, logProfile_sub_log v hk, hm]
  have he : Real.exp (-(u / 2)) * Real.exp (-(u / 2)) = Real.exp (-u) := by
    rw [← Real.exp_add]; ring_nf
  linear_combination (Real.sqrt j * Real.sqrt k * (v (m / j) * v (m / k))) * he

/-- `∫_{log(n+1)}^{log(n+2)} e^{−u} du = 1/((n+1)(n+2))`. -/
theorem integral_cell_exp_neg (n : ℕ) :
    ∫ u in Real.log ((n : ℝ) + 1)..Real.log ((n : ℝ) + 2), Real.exp (-u) =
      1 / (((n : ℝ) + 1) * ((n : ℝ) + 2)) := by
  rw [intervalIntegral.integral_comp_neg (fun u => Real.exp u), integral_exp, Real.exp_neg,
    Real.exp_neg, Real.exp_log (by positivity), Real.exp_log (by positivity)]
  field_simp
  ring

/-- On the open cell `(log(n+1), log(n+2))` the Gram integrand is `c e^{−u}`. -/
theorem cell_eqOn (v : ℕ → ℝ) {j k : ℕ} (hj : 1 ≤ j) (hk : 1 ≤ k) (n : ℕ) :
    EqOn (fun u => logProfile v (u - Real.log j) * logProfile v (u - Real.log k))
      (fun u => Real.sqrt j * Real.sqrt k * (v ((n + 1) / j) * v ((n + 1) / k)) * Real.exp (-u))
      (uIoo (Real.log ((n : ℝ) + 1)) (Real.log ((n : ℝ) + 2))) := by
  intro u hu
  rw [uIoo_of_le (Real.log_le_log (by positivity) (by linarith))] at hu
  exact translationGram_integrand v hj hk ((mem_Ico_log_iff n).mp ⟨hu.1.le, hu.2⟩)

/-- The integral of the Gram integrand over one cell. -/
theorem integral_cell_translationGram (v : ℕ → ℝ) {j k : ℕ} (hj : 1 ≤ j) (hk : 1 ≤ k) (n : ℕ) :
    ∫ u in Real.log ((n : ℝ) + 1)..Real.log ((n : ℝ) + 2),
        logProfile v (u - Real.log j) * logProfile v (u - Real.log k) =
      Real.sqrt j * Real.sqrt k * (v ((n + 1) / j) * v ((n + 1) / k)) /
        (((n : ℝ) + 1) * ((n : ℝ) + 2)) := by
  rw [intervalIntegral.integral_congr_uIoo (cell_eqOn v hj hk n),
    intervalIntegral.integral_const_mul, integral_cell_exp_neg, mul_one_div]

theorem intervalIntegrable_cell_translationGram (v : ℕ → ℝ) {j k : ℕ} (hj : 1 ≤ j) (hk : 1 ≤ k)
    (n : ℕ) :
    IntervalIntegrable (fun u => logProfile v (u - Real.log j) * logProfile v (u - Real.log k))
      volume (Real.log ((n : ℝ) + 1)) (Real.log ((n : ℝ) + 2)) := by
  exact (((Real.continuous_exp.comp continuous_neg).intervalIntegrable _ _).const_mul _
    ).congr_uIoo fun u hu => (cell_eqOn v hj hk n hu).symm

/-- **The cofactor Gram is a truncated translation Gram of the log profile.** -/
theorem pronicPairing_rowDilate_eq_translationGram (v : ℕ → ℝ) {j k : ℕ} (hj : 1 ≤ j)
    (hk : 1 ≤ k) (T : ℕ) :
    pronicPairing T (rowDilate j v) (rowDilate k v) =
      (Real.sqrt j * Real.sqrt k)⁻¹ *
        ∫ u in (0 : ℝ)..Real.log ((T : ℝ) + 1),
          logProfile v (u - Real.log j) * logProfile v (u - Real.log k) := by
  have hjk : Real.sqrt j * Real.sqrt k ≠ 0 :=
    mul_ne_zero (Real.sqrt_ne_zero'.mpr (by exact_mod_cast hj))
      (Real.sqrt_ne_zero'.mpr (by exact_mod_cast hk))
  -- split `[0, log(T+1)]` into the cells `[log(n+1), log(n+2)]`, `n < T`
  have hsplit := intervalIntegral.sum_integral_adjacent_intervals
    (f := fun u => logProfile v (u - Real.log j) * logProfile v (u - Real.log k))
    (a := fun n : ℕ => Real.log ((n : ℝ) + 1)) (n := T) fun n _ => by
      simpa [add_assoc, show (1 : ℝ) + 1 = 2 by norm_num] using
        intervalIntegrable_cell_translationGram v hj hk n
  simp only [Nat.cast_zero, zero_add, Real.log_one] at hsplit
  rw [← hsplit]
  have hcell : ∀ n : ℕ, ∫ u in Real.log ((n : ℝ) + 1)..Real.log (((n + 1 : ℕ) : ℝ) + 1),
      logProfile v (u - Real.log j) * logProfile v (u - Real.log k) =
      Real.sqrt j * Real.sqrt k * (v ((n + 1) / j) * v ((n + 1) / k)) /
        (((n : ℝ) + 1) * ((n : ℝ) + 2)) := by
    intro n
    rw [show (((n + 1 : ℕ) : ℝ) + 1) = (n : ℝ) + 2 by push_cast; ring]
    exact integral_cell_translationGram v hj hk n
  simp_rw [hcell]
  rw [mul_sum, pronicPairing]
  rw [show Finset.Icc 1 T = Finset.Ico 1 (T + 1) from rfl, sum_Ico_eq_sum_range,
    Nat.add_sub_cancel]
  refine sum_congr rfl fun n _ => ?_
  simp only [rowDilate]
  rw [add_comm 1 n]
  push_cast
  field_simp
  ring

/-! ### Exponential profiles give power characters -/

/-- **The translation Gram of two exponentials is a power character.** -/
theorem translationGram_exp (lam mu a b L₀ L : ℝ) :
    ∫ u in L₀..L, Real.exp (lam * (u - a)) * Real.exp (mu * (u - b)) =
      Real.exp (-(lam * a)) * Real.exp (-(mu * b)) * ∫ u in L₀..L, Real.exp ((lam + mu) * u) := by
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun u _ => ?_
  rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
  congr 1
  ring

/-! ### Escape states modulo subdominant remainders -/

/-- Dilation contracts the pronic norm. -/
theorem pronicNorm_rowDilate_le {j : ℕ} (hj : 1 ≤ j) (T : ℕ) {v : ℕ → ℝ} (hv0 : v 0 = 0) :
    pronicNorm T (rowDilate j v) ≤ pronicNorm T v := by
  refine (pronicNorm_rowDilate_le_sharp hj T v hv0).trans ?_
  have h1 : 1 / Real.sqrt (j : ℝ) ≤ 1 := by
    rw [div_le_one (Real.sqrt_pos.mpr (by exact_mod_cast hj))]
    exact Real.one_le_sqrt.mpr (by exact_mod_cast hj)
  exact mul_le_of_le_one_left (pronicNorm_nonneg _ _) h1

/-- **Perturbation of a Gram.** For `v = h + r`,
`|⟨D_j v, D_k v⟩ − ⟨D_j h, D_k h⟩| ≤ ‖r‖ (‖v‖ + ‖h‖)`. -/
theorem abs_pairing_rowDilate_sub_le {h r : ℕ → ℝ} (hh0 : h 0 = 0) (hr0 : r 0 = 0) {j k : ℕ}
    (hj : 1 ≤ j) (hk : 1 ≤ k) (T : ℕ) :
    |pronicPairing T (rowDilate j (fun n => h n + r n)) (rowDilate k (fun n => h n + r n)) -
        pronicPairing T (rowDilate j h) (rowDilate k h)| ≤
      pronicNorm T r * (pronicNorm T (fun n => h n + r n) + pronicNorm T h) := by
  have hv0 : (fun n => h n + r n) 0 = 0 := by simp [hh0, hr0]
  have hsplit : pronicPairing T (rowDilate j (fun n => h n + r n))
        (rowDilate k (fun n => h n + r n)) - pronicPairing T (rowDilate j h) (rowDilate k h) =
      pronicPairing T (rowDilate j r) (rowDilate k (fun n => h n + r n)) +
        pronicPairing T (rowDilate j h) (rowDilate k r) := by
    simp only [pronicPairing, rowDilate, ← sum_sub_distrib, ← sum_add_distrib]
    exact sum_congr rfl fun n _ => by ring
  rw [hsplit]
  refine (abs_add_le _ _).trans ?_
  have e1 := abs_pronicPairing_le T (rowDilate j r) (rowDilate k (fun n => h n + r n))
  have e2 := abs_pronicPairing_le T (rowDilate j h) (rowDilate k r)
  have n1 := pronicNorm_rowDilate_le hj T hr0
  have n2 := pronicNorm_rowDilate_le (v := fun n => h n + r n) hk T hv0
  have n3 := pronicNorm_rowDilate_le hj T hh0
  have n4 := pronicNorm_rowDilate_le hk T hr0
  have p1 := pronicNorm_nonneg T (rowDilate j r)
  have p3 := pronicNorm_nonneg T (rowDilate j h)
  have p4 := pronicNorm_nonneg T (rowDilate k r)
  have q1 := pronicNorm_nonneg T r
  have q2 := pronicNorm_nonneg T (fun n => h n + r n)
  have q3 := pronicNorm_nonneg T h
  nlinarith [mul_le_mul n1 n2 (pronicNorm_nonneg _ _) q1, mul_le_mul n3 n4 p4 q3]

/-- The normalized Gram `⟨D_j v, D_k v⟩_T / ‖v‖_T²`: the escape-state kernel at horizon `T`. -/
def normGram (v : ℕ → ℝ) (T j k : ℕ) : ℝ :=
  pronicPairing T (rowDilate j v) (rowDilate k v) / pronicNorm T v ^ 2

/-- **Escape states are determined modulo subdominant remainders.** If `v = h + r` and
`‖r‖/‖v‖ → 0` along horizons `T_m`, the normalized Grams of `v` and the Grams of `h` normalized by
`‖v‖²` have the same limits. -/
theorem tendsto_normGram_sub_of_subdominant {h r : ℕ → ℝ} (hh0 : h 0 = 0) (hr0 : r 0 = 0)
    (Ts : ℕ → ℕ) (hpos : ∀ m, 0 < pronicNorm (Ts m) (fun n => h n + r n))
    (hsub : Tendsto (fun m => pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n))
      atTop (𝓝 0))
    {j k : ℕ} (hj : 1 ≤ j) (hk : 1 ≤ k) :
    Tendsto (fun m => normGram (fun n => h n + r n) (Ts m) j k -
        pronicPairing (Ts m) (rowDilate j h) (rowDilate k h) /
          pronicNorm (Ts m) (fun n => h n + r n) ^ 2) atTop (𝓝 0) := by
  -- the difference is at most `x (2 + x)`, `x = ‖r‖/‖v‖`
  have hbound : ∀ m, |normGram (fun n => h n + r n) (Ts m) j k -
      pronicPairing (Ts m) (rowDilate j h) (rowDilate k h) /
        pronicNorm (Ts m) (fun n => h n + r n) ^ 2| ≤
      pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n) *
        (2 + pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n)) := by
    intro m
    set N := pronicNorm (Ts m) (fun n => h n + r n)
    set R := pronicNorm (Ts m) r
    set H := pronicNorm (Ts m) h
    have hN := hpos m
    have hN' : N ≠ 0 := (hpos m).ne'
    have hR := pronicNorm_nonneg (Ts m) r
    have hH : H ≤ N + R := by
      have := pronicNorm_add_le (Ts m) (fun n => h n + r n) (fun n => -r n)
      have hneg : pronicNorm (Ts m) (fun n => -r n) = R := by
        simp only [R, pronicNorm, neg_sq]
      simpa [hneg] using this
    have hd := abs_pairing_rowDilate_sub_le hh0 hr0 hj hk (Ts m)
    rw [normGram, ← sub_div, abs_div, abs_of_pos (pow_pos hN 2)]
    rw [div_le_iff₀ (pow_pos hN 2)]
    have : R * (N + H) ≤ R / N * (2 + R / N) * N ^ 2 := by
      have e : R / N * (2 + R / N) * N ^ 2 = R * (2 * N + R) := by field_simp
      rw [e]
      nlinarith
    linarith
  have hlim : Tendsto (fun m => pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n) *
      (2 + pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n))) atTop (𝓝 0) := by
    have := hsub.mul ((tendsto_const_nhds (x := (2 : ℝ))).add hsub)
    simpa using this
  exact squeeze_zero_norm (fun m => hbound m) hlim

/-- **Finite combinations generate their Grams.** -/
theorem pronicPairing_rowDilate_sum {ι : Type*} (s : Finset ι) (c : ι → ℝ) (w : ι → ℕ → ℝ)
    (j k T : ℕ) :
    pronicPairing T (rowDilate j (fun n => ∑ i ∈ s, c i * w i n))
        (rowDilate k (fun n => ∑ i ∈ s, c i * w i n)) =
      ∑ i ∈ s, ∑ i' ∈ s, c i * c i' * pronicPairing T (rowDilate j (w i)) (rowDilate k (w i')) := by
  simp only [pronicPairing, rowDilate]
  simp_rw [sum_mul_sum, sum_div, mul_sum]
  exact sum_comm.trans (sum_congr rfl fun i _ => sum_comm.trans
    (sum_congr rfl fun i' _ => sum_congr rfl fun n _ => by ring))

end GaloisForLFunctions.ArithmeticCorrespondencePositivity
