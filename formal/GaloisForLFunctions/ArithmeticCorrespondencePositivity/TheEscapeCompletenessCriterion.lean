import GaloisForLFunctions.ArithmeticCorrespondencePositivity.ThePowerRowsOfTheZerosAreDominantConfigurations
import GaloisForLFunctions.ArithmeticCorrespondencePositivity.OnEscapeStatesDilationIsTheArchimedeanFlow
import GaloisForLFunctions.ArithmeticCorrespondencePositivity.InfiniteDominantConfigurationsAreComplete

/-!
# The escape completeness criterion

The escape states of the damped Möbius receiver are the limits of the normalized cofactor Grams
`K_T(j, k) = ⟨D_j v, D_k v⟩_T / ‖v‖_T²` (ADR). This file states escape completeness for a row that
splits into the power row of finitely many dominant translated zeros and a remainder of
subdominant energy, in the normalization of ADR, and reads the result on the gauge torus.

* **The criterion** (`exists_tendsto_normGram_of_dominant_split`). Let
  `v = Σ_k Re(c_k n^{z_k}) + r` with `Re z_k = ½ + x`, `x > 0`, distinct frequencies `±Im z_k`,
  `c ≠ 0`, and `‖r‖_T/‖v‖_T → 0` along horizons `T_m → ∞`. Then a subsequence of the normalized
  Grams converges, for all dilations at once, to
  `K(j, k) = K_θ(log j, log k) / (√j √k K_θ(0, 0))`,
  a phase kernel of the configuration with frequencies `±Im z_k`. By
  `escapeForm_log_eq_zero_iff` it has rank `2r`, generated by the characters `j^{−z_k}` and
  `j^{−z̄_k}`.
* **The gauge-torus reading** (`tendsto_escapeKernel_shift_zero`). In the critical normalization
  `K̃(dj, dk) = √(dj) √(dk) K(dj, dk) ∝ K_θ(log d + log j, log d + log k)`, which tends to `0` as
  `d → ∞`: dilation scales a phase kernel by `d^{−2x}` (P22). The asymptotic kernel of ACG vanishes,
  so these escape states carry no gauge spectrum — the ACP side of `gaugeMass_eq_zero_of_powerGrowth`.

Together with the translation-Gram identity and the Laplace symbol
(`pronicPairing_rowDilate_eq_translationGram`, `tendsto_laplace_cofactorProfile`) this is the
escape-completeness criterion: the escape states of the cofactor at `ε` are generated by translated
zeros exactly when its profile, whose Laplace transform is `G`, splits into a dominant
configuration and a subdominant remainder.
-/

open MeasureTheory Set Filter Topology Complex
open scoped ComplexConjugate
open GaloisForLFunctions.BezoutValuationIncidence (pronicNorm pronicNorm_nonneg pronicNorm_sq
  pronicNorm_add_le)
open GaloisForLFunctions.ArithmeticContinuationAndCriticalEnergy (pronicPairing rowDilate)

noncomputable section

namespace GaloisForLFunctions.ArithmeticCorrespondencePositivity

/-! ### The gauge-torus reading -/

/-- A phase kernel is bounded uniformly in unimodular phases. -/
theorem norm_escapeKernel_le {r : ℕ} {x : ℝ} (hx : 0 < x) (y : Fin r → ℝ) (c θ : Fin r → ℂ)
    (hθ : ∀ k, ‖θ k‖ ≤ 1) (a b : ℝ) :
    ‖escapeKernel x y c θ a b‖ ≤
      ∑ k, ∑ l, ‖c k‖ * ‖c l‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b)) / (2 * x)) := by
  unfold escapeKernel
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun l _ => ?_)
  exact norm_kernelEntry_le hx _ _ _ _ _ _ a b (hθ k) (hθ l)

/-- **The critical kernel of a phase kernel vanishes**: `K_θ(a + t, b + t) → 0` as `t → ∞`. -/
theorem tendsto_escapeKernel_shift_zero {r : ℕ} {x : ℝ} (hx : 0 < x) (y : Fin r → ℝ)
    (c θ : Fin r → ℂ) (hθ : ∀ k, ‖θ k‖ = 1) (a b : ℝ) :
    Tendsto (fun t : ℝ => escapeKernel x y c θ (a + t) (b + t)) atTop (𝓝 0) := by
  set M := ∑ k, ∑ l, ‖c k‖ * ‖c l‖ * (Real.exp (-(x * a)) * Real.exp (-(x * b)) / (2 * x))
  have hθ' : ∀ (t : ℝ) (k : Fin r), ‖θ k * Complex.exp (-((y k * t : ℝ) * I))‖ ≤ 1 := by
    intro t k
    rw [norm_mul, hθ k, one_mul, show -((y k * t : ℝ) * I) = ((-(y k * t) : ℝ) : ℂ) * I by
      push_cast; ring, Complex.norm_exp_ofReal_mul_I]
  have hlim : Tendsto (fun t : ℝ => Real.exp (-(2 * x * t)) * M) atTop (𝓝 0) := by
    have h1 : Tendsto (fun t : ℝ => -(2 * x * t)) atTop atBot :=
      tendsto_neg_atTop_atBot.comp (tendsto_id.const_mul_atTop (by linarith))
    simpa using (Real.tendsto_exp_atBot.comp h1).mul_const M
  refine squeeze_zero_norm (fun t => ?_) hlim
  rw [escapeKernel_shift, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  exact mul_le_mul_of_nonneg_left (norm_escapeKernel_le hx y c _ (hθ' t) a b) (Real.exp_pos _).le

/-! ### The criterion -/

theorem pronicNorm_sq_eq_pronicPairing (T : ℕ) (v : ℕ → ℝ) :
    pronicNorm T v ^ 2 = pronicPairing T v v := by
  rw [pronicNorm_sq]
  simp only [pronicPairing, pow_two]

theorem rowDilate_one (v : ℕ → ℝ) : rowDilate 1 v = v := by
  funext n
  simp [rowDilate]

theorem powerRow_zero (c : ℂ) {z : ℂ} (hz : z ≠ 0) : powerRow c z 0 = 0 := by
  simp [powerRow, Complex.zero_cpow hz]

/-- If `‖r‖/‖h + r‖ → 0` then `‖h‖/‖h + r‖ → 1`. -/
theorem tendsto_norm_ratio_of_subdominant {h r : ℕ → ℝ} {Ts : ℕ → ℕ}
    (hpos : ∀ m, 0 < pronicNorm (Ts m) (fun n => h n + r n))
    (hsub : Tendsto (fun m => pronicNorm (Ts m) r / pronicNorm (Ts m) (fun n => h n + r n))
      atTop (𝓝 0)) :
    Tendsto (fun m => pronicNorm (Ts m) h / pronicNorm (Ts m) (fun n => h n + r n)) atTop
      (𝓝 1) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun m => norm_nonneg _) (fun m => ?_) hsub
  set N := pronicNorm (Ts m) (fun n => h n + r n)
  have hN := hpos m
  have hle1 : pronicNorm (Ts m) h ≤ N + pronicNorm (Ts m) r := by
    have := pronicNorm_add_le (Ts m) (fun n => h n + r n) (fun n => -r n)
    have hneg : pronicNorm (Ts m) (fun n => -r n) = pronicNorm (Ts m) r := by
      simp only [pronicNorm, neg_sq]
    simpa [hneg] using this
  have hle2 : N ≤ pronicNorm (Ts m) h + pronicNorm (Ts m) r := pronicNorm_add_le (Ts m) h r
  rw [Real.norm_eq_abs, div_sub_one hN.ne', abs_div, abs_of_pos hN]
  exact div_le_div_of_nonneg_right (abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩) hN.le

/-- **The escape completeness criterion.** A row that is the power row of finitely many dominant
translated zeros plus a remainder of subdominant energy has, along a subsequence of any horizons,
normalized cofactor Grams converging to `K_θ(log j, log k)/(√j √k K_θ(0, 0))`, a phase kernel of
the configuration with frequencies `±Im z_k`. -/
theorem exists_tendsto_normGram_of_dominant_split {r : ℕ} {x : ℝ} (hx : 0 < x) (c z : Fin r → ℂ)
    (hz : ∀ k, (z k).re = 1 / 2 + x) (hc : c ≠ 0)
    (hy : Function.Injective (Fin.append (fun k => (z k).im) fun k => -(z k).im))
    (rem : ℕ → ℝ) (hrem0 : rem 0 = 0) {Ts : ℕ → ℕ} (hT : Tendsto Ts atTop atTop)
    (hpos : ∀ m, 0 < pronicNorm (Ts m) (fun n => (∑ i, powerRow (c i) (z i) n) + rem n))
    (hsub : Tendsto (fun m => pronicNorm (Ts m) rem /
      pronicNorm (Ts m) (fun n => (∑ i, powerRow (c i) (z i) n) + rem n)) atTop (𝓝 0)) :
    ∃ θ : Fin (r + r) → ℂ, (∀ i, ‖θ i‖ = 1) ∧ ∃ φ : ℕ → ℕ, StrictMono φ ∧
      ∀ j k : ℕ, 1 ≤ j → 1 ≤ k →
        Tendsto (fun m => (normGram (fun n => (∑ i, powerRow (c i) (z i) n) + rem n)
          (Ts (φ m)) j k : ℂ)) atTop
          (𝓝 (escapeKernel x (Fin.append (fun k => (z k).im) fun k => -(z k).im)
              (Fin.append (fun k => c k / 2) fun k => conj (c k) / 2) θ (Real.log j) (Real.log k) /
            (((Real.sqrt j * Real.sqrt k : ℝ) : ℂ) *
              escapeKernel x (Fin.append (fun k => (z k).im) fun k => -(z k).im)
                (Fin.append (fun k => c k / 2) fun k => conj (c k) / 2) θ 0 0))) := by
  have hz0 : ∀ i, z i ≠ 0 := fun i h0 => by
    have := hz i; rw [h0, Complex.zero_re] at this; linarith
  obtain ⟨θ, hθ, φ, hφ, hlim⟩ := exists_tendsto_powerSum_escapeKernel hx c z hz hT
  refine ⟨θ, hθ, φ, hφ, fun j k hj hk => ?_⟩
  -- name the power row
  obtain ⟨h, hh⟩ : ∃ h : ℕ → ℝ, h = fun n => ∑ i, powerRow (c i) (z i) n := ⟨_, rfl⟩
  have hrow : (fun n => (∑ i, powerRow (c i) (z i) n) + rem n) = fun n => h n + rem n := by
    rw [hh]
  rw [hrow] at hpos hsub ⊢
  simp only [← hh] at hlim
  have hh0 : h 0 = 0 := by
    rw [hh]; exact Finset.sum_eq_zero fun i _ => powerRow_zero _ (hz0 i)
  -- the diagonal `e_m ⟨h, h⟩` tends to `K_θ(0, 0) = e₀ > 0`
  have hc' : (Fin.append (fun k => c k / 2) fun k => conj (c k) / 2 : Fin (r + r) → ℂ) ≠ 0 := by
    intro h0
    apply hc
    funext i
    have := congrFun h0 (Fin.castAdd r i)
    simp only [Fin.append_left, Pi.zero_apply, div_eq_zero_iff, OfNat.ofNat_ne_zero,
      or_false] at this
    exact this
  obtain ⟨e₀, he₀, hK0⟩ := escapeKernel_self_pos hx hy (θ := θ) hc'
    (fun i h0 => by have := hθ i; rw [h0, norm_zero] at this; exact zero_ne_one this) 0
  have hdiag : Tendsto (fun m => Real.exp (-(2 * x * Real.log ((Ts (φ m) : ℝ) + 1))) *
      pronicPairing (Ts (φ m)) h h) atTop (𝓝 e₀) := by
    have h11 := hlim 1 1 le_rfl le_rfl
    simp only [Nat.cast_one, Real.sqrt_one, one_mul, Real.log_one, rowDilate_one] at h11
    rw [hK0] at h11
    have := (Complex.continuous_re.tendsto _).comp h11
    simpa only [Function.comp_def, Complex.ofReal_re] using this
  have hpos_h : ∀ᶠ m in atTop, 0 < pronicNorm (Ts (φ m)) h := by
    filter_upwards [hdiag.eventually (lt_mem_nhds he₀)] with m hm
    rw [← pronicNorm_sq_eq_pronicPairing] at hm
    have : 0 < pronicNorm (Ts (φ m)) h ^ 2 := pos_of_mul_pos_right hm (Real.exp_pos _).le
    exact lt_of_le_of_ne (pronicNorm_nonneg _ _) (fun h0 => by rw [← h0] at this; simp at this)
  -- the subdominance law and the norm ratio along the subsequence
  have hP18 := (tendsto_normGram_sub_of_subdominant hh0 hrem0 Ts hpos hsub hj hk).comp
    hφ.tendsto_atTop
  have hratio := (tendsto_norm_ratio_of_subdominant hpos hsub).comp hφ.tendsto_atTop
  have hjk : (0 : ℝ) < Real.sqrt j * Real.sqrt k :=
    mul_pos (Real.sqrt_pos.mpr (by exact_mod_cast hj)) (Real.sqrt_pos.mpr (by exact_mod_cast hk))
  -- assemble in `ℂ`
  have hA := hlim j k hj hk
  have hD : Tendsto (fun m => ((Real.sqrt j * Real.sqrt k *
      (Real.exp (-(2 * x * Real.log ((Ts (φ m) : ℝ) + 1))) * pronicPairing (Ts (φ m)) h h) :
        ℝ) : ℂ)) atTop (𝓝 (((Real.sqrt j * Real.sqrt k : ℝ) : ℂ) * (e₀ : ℂ))) := by
    have := (Complex.continuous_ofReal.tendsto _).comp (hdiag.const_mul (Real.sqrt j * Real.sqrt k))
    simpa only [Function.comp_def, Complex.ofReal_mul] using this
  have hR : Tendsto (fun m => (((pronicNorm (Ts (φ m)) h /
      pronicNorm (Ts (φ m)) (fun n => h n + rem n)) ^ 2 : ℝ) : ℂ)) atTop (𝓝 1) := by
    have := (Complex.continuous_ofReal.tendsto _).comp (hratio.pow 2)
    simpa only [Function.comp_def, one_pow, Complex.ofReal_one] using this
  have hE := (Complex.continuous_ofReal.tendsto _).comp hP18
  rw [Complex.ofReal_zero] at hE
  have hne : ((Real.sqrt j * Real.sqrt k : ℝ) : ℂ) * (e₀ : ℂ) ≠ 0 :=
    mul_ne_zero (Complex.ofReal_ne_zero.mpr hjk.ne') (Complex.ofReal_ne_zero.mpr he₀.ne')
  have htot := hE.add ((hA.div hD hne).mul hR)
  rw [zero_add, mul_one] at htot
  rw [hK0]
  refine htot.congr' ?_
  filter_upwards [hpos_h] with m hm
  have hN := (hpos (φ m)).ne'
  have hH := hm.ne'
  have hexp := (Real.exp_pos (-(2 * x * Real.log ((Ts (φ m) : ℝ) + 1)))).ne'
  have hjk' := hjk.ne'
  have hsj : ((Real.sqrt j : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (by exact_mod_cast hj)).ne'
  have hsk : ((Real.sqrt k : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (by exact_mod_cast hk)).ne'
  have hHc : ((pronicNorm (Ts (φ m)) h : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hH
  have hNc : ((pronicNorm (Ts (φ m)) (fun n => h n + rem n) : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr hN
  simp only [Function.comp_apply, Pi.div_apply, normGram, ← pronicNorm_sq_eq_pronicPairing]
  push_cast
  field_simp
  ring

end GaloisForLFunctions.ArithmeticCorrespondencePositivity
