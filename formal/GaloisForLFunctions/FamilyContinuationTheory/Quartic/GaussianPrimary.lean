import GaloisForLFunctions.RHTower.GaussianTwoSquaresCount
import Mathlib.Tactic

/-!
# Primary Gaussian integers

The primary congruence modulo `(1+i)^3` is an explicit lattice condition of
index eight. Among the four quarter turns of an odd Gaussian integer exactly
one is primary. This fixes the unit ambiguity in sums over odd principal ideals.
-/

namespace GaloisForLFunctions.FamilyContinuationTheory.Quartic

open RHTower.GaussianTwoSquares

/-- The primary congruence at the ramified Gaussian prime. -/
def IsPrimary (z : GaussianInt) : Prop := onePlusI ^ 3 ∣ z - 1

/-- Multiplication by this unit rotates the Gaussian lattice by a quarter turn. -/
def gaussianI : GaussianInt := ⟨0, 1⟩

private theorem lambda_cube : onePlusI ^ 3 = (⟨-2, 2⟩ : GaussianInt) := by
  ext <;> norm_num [onePlusI, pow_succ, Zsqrtd.re_mul, Zsqrtd.im_mul]

/-- Divisibility by the ramified prime detects equality of coordinate parities. -/
theorem lambda_dvd_iff (z : GaussianInt) :
    onePlusI ∣ z ↔ (2 : ℤ) ∣ z.re - z.im := by
  constructor
  · rintro ⟨w, hw⟩
    have hr := congrArg Zsqrtd.re hw
    have hi := congrArg Zsqrtd.im hw
    simp only [onePlusI, Zsqrtd.re_mul, Zsqrtd.im_mul] at hr hi
    refine ⟨-w.im, ?_⟩
    linarith only [hr, hi]
  · rintro ⟨t, ht⟩
    refine ⟨⟨z.im + t, -t⟩, ?_⟩
    apply Zsqrtd.ext <;> simp only [onePlusI, Zsqrtd.re_mul, Zsqrtd.im_mul] <;>
      linarith only [ht]

/-- The primary lattice has coordinate congruences of moduli four and two. -/
theorem isPrimary_iff (z : GaussianInt) :
    IsPrimary z ↔ (4 : ℤ) ∣ z.re - z.im - 1 ∧ (2 : ℤ) ∣ z.im := by
  rw [IsPrimary, lambda_cube]
  constructor
  · rintro ⟨w, hw⟩
    have hr := congrArg Zsqrtd.re hw
    have hi := congrArg Zsqrtd.im hw
    simp only [Zsqrtd.re_sub, Zsqrtd.im_sub, Zsqrtd.re_one, Zsqrtd.im_one,
      Zsqrtd.re_mul, Zsqrtd.im_mul] at hr hi
    exact ⟨⟨-w.re, by linarith only [hr, hi]⟩,
      ⟨w.re - w.im, by linarith only [hi]⟩⟩
  · rintro ⟨⟨t, ht⟩, ⟨s, hs⟩⟩
    refine ⟨⟨-t, -t - s⟩, ?_⟩
    apply Zsqrtd.ext <;>
      simp only [Zsqrtd.re_sub, Zsqrtd.im_sub, Zsqrtd.re_one, Zsqrtd.im_one,
        Zsqrtd.re_mul, Zsqrtd.im_mul] <;> linarith only [ht, hs]

/-- The lattice generated by `(1+i)^3` has coordinate moduli four and two. -/
theorem lambda_cube_dvd_iff (z : GaussianInt) :
    onePlusI ^ 3 ∣ z ↔ (4 : ℤ) ∣ z.re - z.im ∧ (2 : ℤ) ∣ z.im := by
  have h := isPrimary_iff (z + 1)
  simp only [IsPrimary, add_sub_cancel_right, Zsqrtd.re_add, Zsqrtd.im_add,
    Zsqrtd.re_one, Zsqrtd.im_one, add_zero] at h
  rwa [show z.re + 1 - z.im - 1 = z.re - z.im by ring] at h

/-- Exactly eight residue classes occur modulo `(1+i)^3`. -/
theorem lambda_cube_residue_classes (z : GaussianInt) :
    ∃! rs : Fin 4 × Fin 2,
      onePlusI ^ 3 ∣ z - (⟨(rs.1.val : ℤ) + rs.2.val, rs.2.val⟩ : GaussianInt) := by
  let r : Fin 4 := ⟨((z.re - z.im) % 4).toNat, by omega⟩
  let s : Fin 2 := ⟨(z.im % 2).toNat, by omega⟩
  have hr : (r.val : ℤ) = (z.re - z.im) % 4 := by dsimp [r]; omega
  have hs : (s.val : ℤ) = z.im % 2 := by dsimp [s]; omega
  refine ⟨(r, s), ?_, ?_⟩
  · change onePlusI ^ 3 ∣ z - (⟨(r.val : ℤ) + s.val, s.val⟩ : GaussianInt)
    rw [lambda_cube_dvd_iff]
    simp only [Zsqrtd.re_sub, Zsqrtd.im_sub, Int.dvd_iff_emod_eq_zero]
    omega
  · rintro ⟨r', s'⟩ h
    rw [lambda_cube_dvd_iff] at h
    simp only [Zsqrtd.re_sub, Zsqrtd.im_sub, Int.dvd_iff_emod_eq_zero] at h
    change (z.re - ((r'.val : ℤ) + s'.val) - (z.im - s'.val)) % 4 = 0 ∧
      (z.im - s'.val) % 2 = 0 at h
    apply Prod.ext
    · apply Fin.ext
      change r'.val = r.val
      omega
    · apply Fin.ext
      change s'.val = s.val
      omega

/-- Primary elements form a multiplicatively closed congruence class. -/
def primarySubmonoid : Submonoid GaussianInt where
  carrier := IsPrimary
  one_mem' := by change IsPrimary 1; simp [IsPrimary]
  mul_mem' := by
    rintro z w ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a + b + onePlusI ^ 3 * a * b, ?_⟩
    linear_combination w * ha + hb + (onePlusI ^ 3 * a) * hb

/-- Primary elements are automatically coprime to the ramified prime. -/
theorem primary_is_odd (z : primarySubmonoid) : ¬onePlusI ∣ z.val := by
  have h := (isPrimary_iff z.val).mp z.property
  rw [lambda_dvd_iff]
  simp only [Int.dvd_iff_emod_eq_zero] at h ⊢
  omega

private theorem gaussianI_sq : gaussianI ^ 2 = (⟨-1, 0⟩ : GaussianInt) := by
  ext <;> norm_num [gaussianI, pow_two, Zsqrtd.re_mul, Zsqrtd.im_mul]

private theorem gaussianI_cube : gaussianI ^ 3 = (⟨0, -1⟩ : GaussianInt) := by
  rw [pow_succ, gaussianI_sq]
  ext <;> norm_num [gaussianI, Zsqrtd.re_mul, Zsqrtd.im_mul]

/-- Four quarter turns return every Gaussian integer to itself. -/
theorem gaussianI_fourth : gaussianI ^ 4 = 1 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, gaussianI_sq]
  ext <;> norm_num [pow_two, Zsqrtd.re_mul, Zsqrtd.im_mul]

/-- Quarter turns preserve the Gaussian norm. -/
theorem norm_gaussianI_pow_mul (j : ℕ) (z : GaussianInt) :
    (gaussianI ^ j * z).norm = z.norm := by
  have hi : gaussianI.norm = 1 := by norm_num [norm_eq, gaussianI]
  induction j with
  | zero => simp
  | succ j ih => rw [pow_succ', mul_assoc, Zsqrtd.norm_mul, hi, one_mul, ih]

private theorem primary_rotation_iff (z : GaussianInt) (j : Fin 4) :
    IsPrimary (gaussianI ^ j.val * z) ↔
      match j.val with
      | 0 => (z.re - z.im - 1) % 4 = 0 ∧ z.im % 2 = 0
      | 1 => (-z.im - z.re - 1) % 4 = 0 ∧ z.re % 2 = 0
      | 2 => (-z.re + z.im - 1) % 4 = 0 ∧ (-z.im) % 2 = 0
      | _ => (z.im + z.re - 1) % 4 = 0 ∧ (-z.re) % 2 = 0 := by
  fin_cases j <;> rw [isPrimary_iff] <;>
    simp only [pow_zero, pow_one, gaussianI_sq, gaussianI_cube, one_mul] <;>
    simp only [gaussianI, Zsqrtd.re_mul, Zsqrtd.im_mul, Int.dvd_iff_emod_eq_zero,
      zero_mul, mul_zero, zero_add, add_zero, one_mul,
      mul_one, neg_mul, neg_neg, sub_neg_eq_add]

/-- An odd Gaussian integer has exactly one primary quarter turn. -/
theorem odd_iff_unique_primary_rotation (z : GaussianInt) :
    (¬onePlusI ∣ z) ↔ ∃! j : Fin 4, IsPrimary (gaussianI ^ j.val * z) := by
  rw [lambda_dvd_iff, Int.dvd_iff_emod_eq_zero]
  simp only [primary_rotation_iff]
  constructor
  · intro h
    by_cases h₀ : (z.re - z.im - 1) % 4 = 0 ∧ z.im % 2 = 0
    · refine ⟨0, h₀, ?_⟩
      intro j hj
      apply Fin.ext
      change j.val = 0
      have hjlt := j.isLt
      interval_cases hval : j.val <;> simp only at hj <;> omega
    · by_cases h₁ : (-z.im - z.re - 1) % 4 = 0 ∧ z.re % 2 = 0
      · refine ⟨1, h₁, ?_⟩
        intro j hj
        apply Fin.ext
        change j.val = 1
        have hjlt := j.isLt
        interval_cases hval : j.val <;> simp only at hj <;> omega
      · by_cases h₂ : (-z.re + z.im - 1) % 4 = 0 ∧ (-z.im) % 2 = 0
        · refine ⟨2, h₂, ?_⟩
          intro j hj
          apply Fin.ext
          change j.val = 2
          have hjlt := j.isLt
          interval_cases hval : j.val <;> simp only at hj <;> omega
        · refine ⟨3, ?_, ?_⟩
          · change (z.im + z.re - 1) % 4 = 0 ∧ (-z.re) % 2 = 0
            omega
          · intro j hj
            apply Fin.ext
            change j.val = 3
            have hjlt := j.isLt
            interval_cases hval : j.val <;> simp only at hj <;> omega
  · rintro ⟨j, hj, _⟩
    have hjlt := j.isLt
    interval_cases hval : j.val <;> simp only at hj <;> omega

/-- Fourth powers are primary exactly when their bases are odd. -/
theorem fourth_power_primary_iff (z : GaussianInt) :
    IsPrimary (z ^ 4) ↔ ¬onePlusI ∣ z := by
  constructor
  · intro hz hdiv
    exact primary_is_odd ⟨z ^ 4, hz⟩ (dvd_pow hdiv (by norm_num))
  · intro hz
    obtain ⟨j, hj, _⟩ := (odd_iff_unique_primary_rotation z).mp hz
    have hp := primarySubmonoid.pow_mem hj 4
    change IsPrimary ((gaussianI ^ j.val * z) ^ 4) at hp
    have hi : (gaussianI ^ j.val) ^ 4 = 1 := by
      rw [← pow_mul, Nat.mul_comm j.val 4, pow_mul, gaussianI_fourth, one_pow]
    simpa only [mul_pow, hi, one_mul] using hp

end GaloisForLFunctions.FamilyContinuationTheory.Quartic
