/-! ### 1. Pullback scaling data, `ℚ_{>0}^×`, and two-prime scale subrings -/

/-- Pullback of a scaling datum `D` over `G` along an additive homomorphism `φ : H →+ G`. -/
def pullbackScalingDatum {G H E : Type*} [AddCommGroup G] [AddCommGroup H]
    [AddCommGroup E] [Module ℝ E] (D : ScalingDatum G E) (φ : H →+ G) :
    ScalingDatum H E where
  toPolarSurface := D.toPolarSurface
  scale := D.scale.comp φ
  act h := D.act (φ h)
  act_zero x := by rw [map_zero, D.act_zero]
  act_add g h x := by rw [map_add, D.act_add]
  pair_act g x y := D.pair_act (φ g) x y
  pair_act_H g x := D.pair_act_H (φ g) x
  pair_act_V g x := D.pair_act_V (φ g) x

@[simp]
theorem pullbackScalingDatum_orbitCorr {G H E : Type*} [AddCommGroup G] [AddCommGroup H]
    [AddCommGroup E] [Module ℝ E] (D : ScalingDatum G E) (φ : H →+ G) (x : E) (h : H) :
    (pullbackScalingDatum D φ).orbitCorr x h = D.orbitCorr x (φ h) := rfl

/-- Orbit Hodge index transfers unconditionally along any group homomorphism `φ : H →+ G` by
grouping fibers of `φ` on each finite support. -/
theorem orbitHodgeIndex_pullback_of_orbitHodgeIndex {G H E : Type*} [AddCommGroup G]
    [AddCommGroup H] [AddCommGroup E] [Module ℝ E] (D : ScalingDatum G E) (φ : H →+ G) {x : E}
    (hx : D.OrbitHodgeIndex x) : (pullbackScalingDatum D φ).OrbitHodgeIndex x := by
  classical
  rw [ScalingDatum.orbitHodgeIndex_iff_defect_nonneg] at hx ⊢
  intro S c
  have hcomb : (pullbackScalingDatum D φ).orbitComb x S c =
      D.orbitComb x (S.image φ) (fun g => ∑ h ∈ S with φ h = g, c h) := by
    unfold ScalingDatum.orbitComb pullbackScalingDatum
    dsimp only
    rw [← Finset.sum_fiberwise_of_maps_to (g := φ) (fun h hh => Finset.mem_image_of_mem φ hh)]
    refine Finset.sum_congr rfl fun g _ => ?_
    rw [Finset.sum_smul]
    refine Finset.sum_congr rfl fun h hh => ?_
    rw [(Finset.mem_filter.mp hh).2]
  change 0 ≤ D.defect ((pullbackScalingDatum D φ).orbitComb x S c)
    ((pullbackScalingDatum D φ).orbitComb x S c)
  rw [hcomb]
  exact hx (S.image φ) _

/-- The Rosati involution `ξ ↦ ξ′` (`g ↦ −g`) on `ℤ[G] = (G →₀ ℤ)`. -/
def scaleInvolution {G : Type*} [AddCommGroup G] (ξ : G →₀ ℤ) : G →₀ ℤ :=
  ξ.mapDomain Neg.neg

/-- Invariance of `intRosatiForm` under the Rosati involution `g ↦ −g`. -/
theorem intRosatiForm_scaleInvolution {G E : Type*} [AddCommGroup G] [AddCommGroup E]
    [Module ℝ E] (D : ScalingDatum G E) (x : E) (ξ : G →₀ ℤ) :
    intRosatiForm D x (scaleInvolution ξ) = intRosatiForm D x ξ := by
  classical
  let emb : G ↪ G := ⟨Neg.neg, neg_injective⟩
  have hmap : scaleInvolution ξ = ξ.embDomain emb :=
    (Finsupp.embDomain_eq_mapDomain emb ξ).symm
  rw [hmap, intRosatiForm, Finsupp.support_embDomain]
  rw [Finset.sum_map]
  refine Finset.sum_congr rfl fun g _ => ?_
  rw [Finset.sum_map]
  refine Finset.sum_congr rfl fun h _ => ?_
  simp only [Finsupp.embDomain_apply_self]
  have hsub : emb g - emb h = -(g - h) := by
    change -g - -h = -(g - h)
    abel
  rw [hsub, D.orbitCorr_neg]

/-- Positive rational numbers `ℚ_{>0}^×` written additively as the group of rational Hecke scales. -/
@[ext]
structure PosRatScale where
  val : ℚ
  pos : 0 < val
  deriving DecidableEq

instance : Zero PosRatScale := ⟨⟨1, one_pos⟩⟩
instance : Add PosRatScale := ⟨fun a b => ⟨a.val * b.val, mul_pos a.pos b.pos⟩⟩
instance : Neg PosRatScale := ⟨fun a => ⟨a.val⁻¹, inv_pos.mpr a.pos⟩⟩

instance : AddCommGroup PosRatScale where
  zero := 0
  add := (· + ·)
  neg := Neg.neg
  add_assoc a b c := by ext; exact mul_assoc a.val b.val c.val
  zero_add a := by ext; exact one_mul a.val
  add_zero a := by ext; exact mul_one a.val
  nsmul := nsmulRec
  zsmul := zsmulRec
  neg_add_cancel a := by ext; exact inv_mul_cancel₀ a.pos.ne'
  add_comm a b := by ext; exact mul_comm a.val b.val

@[simp] theorem posRatScale_zero_val : (0 : PosRatScale).val = 1 := rfl
@[simp] theorem posRatScale_add_val (a b : PosRatScale) : (a + b).val = a.val * b.val := rfl
@[simp] theorem posRatScale_neg_val (a : PosRatScale) : (-a).val = a.val⁻¹ := rfl

/-- Logarithmic scale homomorphism `posRatLog : ℚ_{>0}^× →+ ℝ`, `q ↦ log q`. -/
def posRatLog : PosRatScale →+ ℝ where
  toFun a := Real.log (a.val : ℝ)
  map_zero' := by simp
  map_add' a b := by
    change Real.log ((a.val * b.val : ℚ) : ℝ) = _
    push_cast
    exact Real.log_mul (by exact_mod_cast a.pos.ne') (by exact_mod_cast b.pos.ne')

theorem posRatLog_injective : Function.Injective posRatLog := by
  intro a b hab
  ext
  have ha : (0 : ℝ) < a.val := by exact_mod_cast a.pos
  have hb : (0 : ℝ) < b.val := by exact_mod_cast b.pos
  have hexp := congrArg Real.exp hab
  dsimp only [posRatLog, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hexp
  rw [Real.exp_log ha, Real.exp_log hb] at hexp
  exact_mod_cast hexp

/-- The rational logarithmic scales `{log q : q ∈ ℚ_{>0}}` are dense in `ℝ`. -/
theorem denseRange_posRatLog : DenseRange posRatLog := by
  rw [Metric.denseRange_iff]
  intro v ε hε
  obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (Real.exp_lt_exp.mpr (lt_add_of_pos_right v hε))
  have hr0 : (0 : ℝ) < r := (Real.exp_pos v).trans hr1
  refine ⟨⟨r, by exact_mod_cast hr0⟩, ?_⟩
  rw [dist_comm, Real.dist_eq]
  change |Real.log (r : ℝ) - v| < ε
  have h1 : v < Real.log (r : ℝ) := (Real.lt_log_iff_exp_lt hr0).mpr hr1
  have h2 : Real.log (r : ℝ) < v + ε := (Real.log_lt_iff_lt_exp hr0).mpr hr2
  rw [abs_lt]
  exact ⟨by linarith, by linarith⟩

/-- Rank-two logarithmic homomorphism `(m, n) ↦ m log p + n log q`. -/
def twoPrimeLog (p q : ℕ) : (ℤ × ℤ) →+ ℝ where
  toFun mn := (mn.1 : ℝ) * Real.log p + (mn.2 : ℝ) * Real.log q
  map_zero' := by simp
  map_add' a b := by push_cast; ring

/-- For any two distinct primes `p ≠ q`, `{m log p + n log q : m, n ∈ ℤ}` is dense in `ℝ`. -/
theorem denseRange_twoPrimeLog {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    DenseRange (twoPrimeLog p q) := by
  have hclosure : (AddSubgroup.closure {Real.log q, Real.log p} : Set ℝ) ⊆
      Set.range (twoPrimeLog p q) := by
    change (AddSubgroup.closure {Real.log q, Real.log p} : Set ℝ) ⊆ ((twoPrimeLog p q).range : Set ℝ)
    rw [SetLike.coe_subset_coe, AddSubgroup.closure_le]
    exact Set.insert_subset_iff.mpr
      ⟨⟨(0, 1), by simp [twoPrimeLog]⟩,
        Set.singleton_subset_iff.mpr ⟨(1, 0), by simp [twoPrimeLog]⟩⟩
  have hdense : Dense (AddSubgroup.closure {Real.log q, Real.log p} : Set ℝ) :=
    dense_addSubgroupClosure_pair_iff.mpr
      (GaloisForLFunctions.RHTower.irrational_log_ratio hp hq hpq)
  exact hdense.mono hclosure

/-- The scaling datum of `ℤ` over the multiplicative group of positive rationals `ℚ_{>0}^×`. -/
def zetaPosRatScalingDatum : ScalingDatum PosRatScale ScalingCycle :=
  pullbackScalingDatum zetaScalingDatum posRatLog

/-- The scaling datum of `ℤ` restricted to the rank-two group `p^ℤ · q^ℤ`. -/
def zetaTwoPrimeScalingDatum (p q : ℕ) : ScalingDatum (ℤ × ℤ) ScalingCycle :=
  pullbackScalingDatum zetaScalingDatum (twoPrimeLog p q)

/-- The integral Rosati form `τ_x(ξ ⋆ ξ′)` on `ℤ[ℚ_{>0}^×]`. -/
def posRatRosatiForm (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ) : ℝ :=
  intRosatiForm zetaPosRatScalingDatum x ξ

/-- The integral Rosati form on the two-prime subring `ℤ[p^ℤ · q^ℤ]`. -/
def twoPrimeRosatiForm (p q : ℕ) (x : ScalingCycle) (ξ : (ℤ × ℤ) →₀ ℤ) : ℝ :=
  intRosatiForm (zetaTwoPrimeScalingDatum p q) x ξ

/-! ### 2. Genuine `ℕ`-valued floor counts and unconditional window regimes -/

/-- Any nonnegative real number decomposes into its natural floor count `⌊r⌋₊ : ℕ` plus one
manifest square `(√(r − ⌊r⌋₊))²`, with distance at most `1` from `⌊r⌋₊`. -/
theorem eq_natFloor_add_sq_of_nonneg {r : ℝ} (hr : 0 ≤ r) :
    r = ((⌊r⌋₊ : ℕ) : ℝ) + Real.sqrt (r - (⌊r⌋₊ : ℝ)) ^ 2 := by
  have hle : (⌊r⌋₊ : ℝ) ≤ r := Nat.floor_le hr
  rw [Real.sq_sqrt (by linarith)]
  ring

theorem abs_natFloor_sub_le_one_of_nonneg {r : ℝ} (hr : 0 ≤ r) :
    |((⌊r⌋₊ : ℕ) : ℝ) - r| ≤ 1 := by
  have hle : (⌊r⌋₊ : ℝ) ≤ r := Nat.floor_le hr
  have hlt : r < (⌊r⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one r
  rw [abs_le]
  exact ⟨by linarith, by linarith⟩

/-- A homogeneous degree-two form `q` on an additive group `M` is nonnegative everywhere if and
only if it admits an `ℕ`-valued count `c : M → ℕ` at bounded distance. -/
theorem exists_natCount_iff_nonneg {M : Type*} [AddCommGroup M] {q : M → ℝ}
    (hq : ∀ (m : ℕ) x, q (m • x) = (m : ℝ) ^ 2 * q x) :
    (∃ c : M → ℕ, ∃ B : ℝ, ∀ x, |(c x : ℝ) - q x| ≤ B) ↔ ∀ x, 0 ≤ q x := by
  constructor
  · rintro ⟨c, B, hB⟩
    exact (exists_naiveHeight_iff_nonneg hq).mp
      ⟨fun x => (c x : ℝ), 0, B, fun x => by simpa using Nat.cast_nonneg (c x), hB⟩
  · intro hnn
    exact ⟨fun x => ⌊q x⌋₊, 1, fun x => abs_natFloor_sub_le_one_of_nonneg (hnn x)⟩

/-- Genuine `ℕ`-valued floor count `⌊½ W(f, f)⌋₊` of a window test `f`, and its square-root
remainder `√(½ W(f, f) − ⌊½ W(f, f)⌋₊)`. -/
def windowNatCount (f : ℝ → ℝ) : ℕ := ⌊(1 / 2) * weilPair f f⌋₊

def windowRemRoot (f : ℝ → ℝ) : ℝ :=
  Real.sqrt ((1 / 2) * weilPair f f - (windowNatCount f : ℝ))

/-- **Unconditional window count + square decomposition up to `a ≤ 3/10` (all parities).** -/
theorem windowNatCount_decomp_of_le_threeTenths {f : ℝ → ℝ} (hf : f ∈ realTests) {a : ℝ}
    (hs : tsupport f ⊆ Icc (-a) a) (ha : a ≤ 3 / 10) :
    (1 / 2) * weilPair f f = (windowNatCount f : ℝ) + windowRemRoot f ^ 2 ∧
      |(windowNatCount f : ℝ) - (1 / 2) * weilPair f f| ≤ 1 := by
  have hW : 0 ≤ (1 / 2) * weilPair f f := by
    have hge := weilPair_ge_of_le_threeTenths hf hs ha
    have hsq : 0 ≤ ∫ u, f u ^ 2 := integral_nonneg fun _ => sq_nonneg _
    linarith
  exact ⟨eq_natFloor_add_sq_of_nonneg hW, abs_natFloor_sub_le_one_of_nonneg hW⟩

/-- **Unconditional odd window count + square decomposition past `p = 2` (`a ≤ 181/500`).** -/
theorem windowNatCount_decomp_of_odd_le_oneHundredEightyOneFiveHundredths {f : ℝ → ℝ}
    (hf : f ∈ realTests) (hodd : ∀ u, f (-u) = -f u) {a : ℝ}
    (hs : tsupport f ⊆ Icc (-a) a) (ha : a ≤ 181 / 500) :
    (1 / 2) * weilPair f f = (windowNatCount f : ℝ) + windowRemRoot f ^ 2 ∧
      |(windowNatCount f : ℝ) - (1 / 2) * weilPair f f| ≤ 1 := by
  have hW : 0 ≤ (1 / 2) * weilPair f f := by
    have hge := weilPair_ge_of_odd_le_oneHundredEightyOneFiveHundredths hf hodd hs ha
    have hsq : 0 ≤ ∫ u, f u ^ 2 := integral_nonneg fun _ => sq_nonneg _
    linarith
  exact ⟨eq_natFloor_add_sq_of_nonneg hW, abs_natFloor_sub_le_one_of_nonneg hW⟩

/-- **Unconditional `cosh`-orthogonal smooth window count + square decomposition across `A ≤ log 2`
and past `p = 2` (`2a ≤ log 2 + 1/50`).** -/
theorem windowNatCount_decomp_of_evenPoleMoment_zero_past_primeTwo {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hfc : HasCompactSupport f) {a : ℝ} (ha0 : 0 < a)
    (hs : tsupport f ⊆ Ioo (-a) a) (ha : 2 * a ≤ Real.log 2 + 1 / 50)
    (hC : evenPoleMoment f = 0) :
    (1 / 2) * weilPair f f = (windowNatCount f : ℝ) + windowRemRoot f ^ 2 ∧
      |(windowNatCount f : ℝ) - (1 / 2) * weilPair f f| ≤ 1 := by
  have hW : 0 ≤ (1 / 2) * weilPair f f := by
    have hge := weilPair_ge_of_evenPoleMoment_zero_past_primeTwo hf hfc ha0 hs ha hC
    have hsq : 0 ≤ ∫ u, f u ^ 2 := integral_nonneg fun _ => sq_nonneg _
    linarith
  exact ⟨eq_natFloor_add_sq_of_nonneg hW, abs_natFloor_sub_le_one_of_nonneg hW⟩

/-- The real test `∑_{q ∈ supp ξ} ξ_q f(· − log q)` generated by a cycle `x` and `ξ ∈ ℤ[ℚ_{>0}^×]`. -/
def posRatOrbitTest (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ) : ℝ → ℝ :=
  ∑ q ∈ ξ.support, (ξ q : ℝ) • scaleShift (posRatLog q) x.2.2

theorem posRatOrbitTest_mem_realTests (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ) :
    posRatOrbitTest x ξ ∈ realTests :=
  Submodule.sum_mem _ fun q _ => Submodule.smul_mem _ _ (scaleShift_mem (posRatLog q) x.2.2.2)

/-- Identification of `posRatRosatiForm x ξ` with `weilPair (posRatOrbitTest x ξ) (posRatOrbitTest x ξ)`. -/
theorem posRatRosatiForm_eq_weilPair (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ) :
    posRatRosatiForm x ξ = weilPair (posRatOrbitTest x ξ) (posRatOrbitTest x ξ) := by
  unfold posRatRosatiForm intRosatiForm
  rw [← zetaPosRatScalingDatum.defect_orbitComb_self x ξ.support (fun q => (ξ q : ℝ))]
  change scalingSurface.defect _ _ = _
  rw [scalingSurface_defect_self]
  have htest : (((zetaPosRatScalingDatum.orbitComb x ξ.support fun q => (ξ q : ℝ)).2.2 :
      realTests) : ℝ → ℝ) = posRatOrbitTest x ξ := by
    simp only [ScalingDatum.orbitComb, zetaPosRatScalingDatum, pullbackScalingDatum,
      zetaScalingDatum, Prod.snd_sum, Submodule.coe_sum, Prod.smul_snd, Submodule.coe_smul]
    rfl
  rw [htest]

/-- Genuine `ℕ`-valued floor count `⌊posRatRosatiForm x ξ⌋₊` on `ℤ[ℚ_{>0}^×]`. -/
def posRatNatCount (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ) : ℕ :=
  ⌊posRatRosatiForm x ξ⌋₊

/-- **Unconditional `ℕ`-count height on `ℤ[ℚ_{>0}^×]` for window-supported orbit tests (`a ≤ 3/10`).** -/
theorem posRatNatCount_decomp_of_support_le_threeTenths (x : ScalingCycle) (ξ : PosRatScale →₀ ℤ)
    {a : ℝ} (hs : tsupport (posRatOrbitTest x ξ) ⊆ Icc (-a) a) (ha : a ≤ 3 / 10) :
    posRatRosatiForm x ξ =
        (posRatNatCount x ξ : ℝ) +
          Real.sqrt (posRatRosatiForm x ξ - (posRatNatCount x ξ : ℝ)) ^ 2 ∧
      |(posRatNatCount x ξ : ℝ) - posRatRosatiForm x ξ| ≤ 1 := by
  have hnn : 0 ≤ posRatRosatiForm x ξ := by
    rw [posRatRosatiForm_eq_weilPair]
    have hge := weilPair_ge_of_le_threeTenths (posRatOrbitTest_mem_realTests x ξ) hs ha
    have hsq : 0 ≤ ∫ u, posRatOrbitTest x ξ u ^ 2 := integral_nonneg fun _ => sq_nonneg _
    linarith
  exact ⟨eq_natFloor_add_sq_of_nonneg hnn, abs_natFloor_sub_le_one_of_nonneg hnn⟩

/-! ### 3. Per-cycle dense subgroup transfer and `RiemannHypothesis` equivalences -/

/-- Continuity of the orbit correlation `t ↦ zetaScalingDatum.orbitCorr x t` for every cycle `x`. -/
theorem continuous_zetaOrbitCorr (x : ScalingCycle) :
    Continuous (zetaScalingDatum.orbitCorr x) := by
  have hf : (x.2.2 : ℝ → ℝ) ∈ realTests := x.2.2.2
  obtain ⟨w, -, hw⟩ := exists_radius_of_hasCompactSupport (cx_hasCompactSupport hf.2)
  have hbs : ∀ u, cx x.2.2 u ≠ 0 → |u| ≤ w := fun u hu => by
    by_contra h
    exact hu (hw u (not_le.mp h))
  have hlag := continuous_lagStructure zetaZeroConfig temperedConfig_zetaZeroConfig
    (cx_contDiff hf.1) hbs
  have heq : zetaScalingDatum.orbitCorr x = fun v => (lagStructure zetaZeroConfig (cx x.2.2) v).re := by
    funext v
    rw [← configScalingDatum_zeta_orbitCorr, configScalingDatum_orbitCorr_eq,
      lagStructure_eq zetaZeroConfig hf]
  rw [heq]
  exact Complex.continuous_re.comp hlag

/-- **Individual-cycle dense subgroup transfer.** For every cycle `x : ScalingCycle` and every
additive homomorphism `φ : H →+ ℝ` with dense range in `ℝ`, the orbit Hodge index of `x` on `ℤ[H]`
is equivalent to the full real orbit Hodge index of `x` on `ℝ`. -/
theorem zetaOrbitHodgeIndex_pullback_iff_of_denseRange {H : Type*} [AddCommGroup H]
    {φ : H →+ ℝ} (hφ : DenseRange φ) (x : ScalingCycle) :
    (pullbackScalingDatum zetaScalingDatum φ).OrbitHodgeIndex x ↔
      zetaScalingDatum.OrbitHodgeIndex x := by
  constructor
  · intro hpull
    have hrange : ∀ h : H,
        |zetaScalingDatum.orbitCorr x (φ h)| ≤ zetaScalingDatum.orbitCorr x 0 := by
      intro h
      have hhw := (pullbackScalingDatum zetaScalingDatum φ).hasseWeilAt_of_orbitHodgeIndex hpull h
      simpa [ScalingDatum.HasseWeilAt] using hhw
    have hclosed : IsClosed {t : ℝ | |zetaScalingDatum.orbitCorr x t| ≤
        zetaScalingDatum.orbitCorr x 0} :=
      isClosed_le (continuous_abs.comp (continuous_zetaOrbitCorr x)) continuous_const
    have hsub : Set.range φ ⊆ {t : ℝ | |zetaScalingDatum.orbitCorr x t| ≤
        zetaScalingDatum.orbitCorr x 0} := by
      rintro _ ⟨h, rfl⟩
      exact hrange h
    have huniv : ∀ t : ℝ, zetaScalingDatum.HasseWeilAt x t := by
      intro t
      have ht : t ∈ closure (Set.range φ) := by rw [hφ.closure_range]; trivial
      exact hclosed.closure_subset_iff.mpr hsub ht
    have hblind : BlindOffLine zetaZeroConfig x.2.2 := (zeta_orientation_iff x).mp huniv
    have hcfg := orbitHodgeIndex_of_blindOffLine zetaZeroConfig temperedConfig_zetaZeroConfig
      x hblind
    rw [ScalingDatum.orbitHodgeIndex_iff_defect_nonneg] at hcfg ⊢
    intro S c
    have h := hcfg S c
    change 0 ≤ (configSurface zetaZeroConfig temperedConfig_zetaZeroConfig).defect
      (zetaScalingDatum.orbitComb x S c) (zetaScalingDatum.orbitComb x S c) at h
    rwa [configSurface_zeta_eq] at h
  · exact orbitHodgeIndex_pullback_of_orbitHodgeIndex zetaScalingDatum φ

/-- **All-cycle `ℕ`-count height equivalence on `ℤ[ℚ_{>0}^×]` (B20, B32).**
`RiemannHypothesis` holds if and only if every cycle of `scalingSurface` admits an `ℕ`-valued
count height at bounded distance from `posRatRosatiForm x` on `ℤ[ℚ_{>0}^×]`. -/
theorem riemannHypothesis_iff_forall_posRatNatCount :
    RiemannHypothesis ↔ ∀ x : ScalingCycle,
      ∃ c : (PosRatScale →₀ ℤ) → ℕ, ∃ B : ℝ, ∀ ξ, |(c ξ : ℝ) - posRatRosatiForm x ξ| ≤ B := by
  rw [← zetaScalingDatum_hodgeIndex_iff, (ScalingDatum.hodgeIndex_tfae zetaScalingDatum).out 0 1]
  refine forall_congr' fun x => ?_
  rw [← zetaOrbitHodgeIndex_pullback_iff_of_denseRange denseRange_posRatLog x,
    ← show zetaPosRatScalingDatum = pullbackScalingDatum zetaScalingDatum posRatLog from rfl,
    orbitHodgeIndex_iff_int, IntOrbitHodgeIndex,
    ← exists_natCount_iff_nonneg (intRosatiForm_nsmul zetaPosRatScalingDatum x)]
  rfl

/-- **All-cycle nonnegative naive height equivalence on `ℤ[ℚ_{>0}^×]` (B20, B32).** -/
theorem riemannHypothesis_iff_forall_posRatNaiveHeight :
    RiemannHypothesis ↔ ∀ x : ScalingCycle,
      ∃ h : (PosRatScale →₀ ℤ) → ℝ, ∃ B : ℝ, (∀ ξ, 0 ≤ h ξ) ∧
        ∀ ξ, |h ξ - posRatRosatiForm x ξ| ≤ B := by
  rw [riemannHypothesis_iff_forall_posRatNatCount]
  refine forall_congr' fun x => ⟨?_, ?_⟩
  · rintro ⟨c, B, hB⟩
    exact ⟨fun ξ => (c ξ : ℝ), B, fun ξ => by positivity, hB⟩
  · rintro ⟨h, B, hnn, hB⟩
    have hpos : ∀ ξ, 0 ≤ posRatRosatiForm x ξ :=
      (exists_naiveHeight_iff_nonneg (intRosatiForm_nsmul zetaPosRatScalingDatum x)).mp
        ⟨h, 0, B, fun ξ => by linarith [hnn ξ], hB⟩
    exact (exists_natCount_iff_nonneg (intRosatiForm_nsmul zetaPosRatScalingDatum x)).mpr hpos

/-- **Single-orbit `ℕ`-count height equivalence on `ℤ[ℚ_{>0}^×]`.**
For a single spectrally generic cycle `x : ScalingCycle`, `RiemannHypothesis` holds if and only if
`posRatRosatiForm x` on `ℤ[ℚ_{>0}^×]` admits an `ℕ`-valued count height within bounded error. -/
theorem riemannHypothesis_iff_singleOrbit_posRatNatCount (x : ScalingCycle)
    (hgen : RealSpectrallyGeneric zetaZeroConfig x.2.2) :
    RiemannHypothesis ↔
      ∃ c : (PosRatScale →₀ ℤ) → ℕ, ∃ B : ℝ, ∀ ξ, |(c ξ : ℝ) - posRatRosatiForm x ξ| ≤ B := by
  rw [riemannHypothesis_iff_hasseWeil_of_generic x hgen, zeta_orientation_iff]
  have htfae := (orientation_tfae zetaZeroConfig temperedConfig_zetaZeroConfig
    fesSymmetric_zetaZeroConfig x).out 1 2
  have hcfg_eq : (configScalingDatum zetaZeroConfig temperedConfig_zetaZeroConfig).OrbitHodgeIndex x ↔
      zetaScalingDatum.OrbitHodgeIndex x := by
    simp only [ScalingDatum.OrbitHodgeIndex, configScalingDatum_zeta_orbitCorr]
  rw [← htfae, hcfg_eq,
    ← zetaOrbitHodgeIndex_pullback_iff_of_denseRange denseRange_posRatLog x,
    ← show zetaPosRatScalingDatum = pullbackScalingDatum zetaScalingDatum posRatLog from rfl,
    orbitHodgeIndex_iff_int, IntOrbitHodgeIndex,
    ← exists_natCount_iff_nonneg (intRosatiForm_nsmul zetaPosRatScalingDatum x)]
  rfl

/-- Unconditional existence of a single cycle on `ℤ[ℚ_{>0}^×]` whose `ℕ`-count height decides
`RiemannHypothesis`. -/
theorem exists_cycle_riemannHypothesis_iff_posRatNatCount :
    ∃ x : ScalingCycle, RiemannHypothesis ↔
      ∃ c : (PosRatScale →₀ ℤ) → ℕ, ∃ B : ℝ, ∀ ξ, |(c ξ : ℝ) - posRatRosatiForm x ξ| ≤ B := by
  obtain ⟨f, hf, hgen⟩ := exists_realSpectrallyGeneric zetaZeroConfig
  exact ⟨(0, 0, ⟨f, hf⟩), riemannHypothesis_iff_singleOrbit_posRatNatCount _ hgen⟩

/-- **Single-orbit `ℕ`-count height equivalence on two primes `ℤ[p^ℤ · q^ℤ]`.**
For any two distinct primes `p ≠ q` and any spectrally generic cycle `x`, `RiemannHypothesis`
holds iff `twoPrimeRosatiForm p q x` on `(ℤ × ℤ) →₀ ℤ` admits an `ℕ`-valued count height. -/
theorem riemannHypothesis_iff_singleOrbit_twoPrimeNatCount {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p ≠ q) (x : ScalingCycle) (hgen : RealSpectrallyGeneric zetaZeroConfig x.2.2) :
    RiemannHypothesis ↔
      ∃ c : ((ℤ × ℤ) →₀ ℤ) → ℕ, ∃ B : ℝ, ∀ ξ, |(c ξ : ℝ) - twoPrimeRosatiForm p q x ξ| ≤ B := by
  rw [riemannHypothesis_iff_hasseWeil_of_generic x hgen, zeta_orientation_iff]
  have htfae := (orientation_tfae zetaZeroConfig temperedConfig_zetaZeroConfig
    fesSymmetric_zetaZeroConfig x).out 1 2
  have hcfg_eq : (configScalingDatum zetaZeroConfig temperedConfig_zetaZeroConfig).OrbitHodgeIndex x ↔
      zetaScalingDatum.OrbitHodgeIndex x := by
    simp only [ScalingDatum.OrbitHodgeIndex, configScalingDatum_zeta_orbitCorr]
  rw [← htfae, hcfg_eq,
    ← zetaOrbitHodgeIndex_pullback_iff_of_denseRange (denseRange_twoPrimeLog hp hq hpq) x,
    ← show zetaTwoPrimeScalingDatum p q = pullbackScalingDatum zetaScalingDatum (twoPrimeLog p q) from rfl,
    orbitHodgeIndex_iff_int, IntOrbitHodgeIndex,
    ← exists_natCount_iff_nonneg (intRosatiForm_nsmul (zetaTwoPrimeScalingDatum p q) x)]
  rfl

/-- **All-window count-plus-nonnegative-remainder equivalence (B20, B28).**
Existence for every window half-width `a > 0` of an `ℕ`-valued count `c_a` and a nonnegative
remainder `S_a ≥ 0` (such as a sum of squares) with `½ W(f, f) = c_a(f) + S_a(f)` on all real
tests supported in `[−a, a]` is unconditionally equivalent to `RiemannHypothesis`. -/
theorem riemannHypothesis_iff_forall_windowCountPlusNonneg :
    RiemannHypothesis ↔ ∀ a : ℝ, 0 < a →
      ∃ (c_a : (ℝ → ℝ) → ℕ) (S_a : (ℝ → ℝ) → ℝ), (∀ f, 0 ≤ S_a f) ∧
        ∀ f ∈ realTests, tsupport f ⊆ Icc (-a) a →
          (1 / 2) * weilPair f f = (c_a f : ℝ) + S_a f := by
  rw [← scalingSurface_hodgeIndex_iff, scalingSurface.hodgeIndex_iff_castelnuovoSeveri,
    scalingSurface.castelnuovoSeveri_iff_defect_nonneg]
  constructor
  · intro hpos a _
    refine ⟨windowNatCount, fun f => windowRemRoot f ^ 2, fun f => sq_nonneg _, fun f hf _ => ?_⟩
    have hW : 0 ≤ (1 / 2) * weilPair f f := by
      have h := hpos (0, 0, ⟨f, hf⟩)
      rw [scalingSurface_defect_self] at h
      linarith
    exact eq_natFloor_add_sq_of_nonneg hW
  · intro hwin x
    rw [scalingSurface_defect_self]
    set f : ℝ → ℝ := x.2.2.1
    have hf : f ∈ realTests := x.2.2.2
    obtain ⟨B, hB⟩ := hf.2.isBounded.subset_closedBall (0 : ℝ)
    set a := max B 0 + 1
    have ha0 : 0 < a := by positivity
    have hs : tsupport f ⊆ Icc (-a) a := by
      intro u hu
      have huB : |u| ≤ B := by simpa [Metric.mem_closedBall, Real.dist_eq] using hB hu
      have hBa : B ≤ a := (le_max_left B 0).trans (by linarith)
      exact abs_le.mp (huB.trans hBa)
    obtain ⟨c_a, S_a, hSnn, heq⟩ := hwin a ha0
    have h := heq f hf hs
    have hc : 0 ≤ (c_a f : ℝ) := by positivity
    have hS : 0 ≤ S_a f := hSnn f
    linarith

/-! ### 4. Selectivity obstructions for `ℕ`-valued count heights -/

/-- The golden curve datum admits no `ℕ`-valued count height on `ℤ × ℤ`. -/
theorem goldenDatum_no_natCount :
    ¬ ∃ c : ℤ × ℤ → ℕ, ∃ B : ℝ, ∀ v, |(c v : ℝ) - intEndDeg goldenDatum v| ≤ B := by
  rintro ⟨c, B, hB⟩
  exact goldenDatum_no_naiveHeight
    ⟨fun v => (c v : ℝ), 0, B, fun v => by simpa using Nat.cast_nonneg (c v), hB⟩

/-- On the complex-quartet fake (`q = 16`, roots `±8i, ±2i`), every kernel count `deg P(F)` is
nonnegative, yet no `ℕ`-valued count height exists at bounded distance from `intRosatiDeg`. -/
theorem complexFake_no_natCount :
    (∀ P : ℝ[X], ∃ r : ℝ, 0 ≤ r ∧ detDeg complexFake P = r) ∧
      ¬ ∃ c : ℤ[X] → ℕ, ∃ B : ℝ, ∀ P, |(c P : ℝ) - intRosatiDeg complexFake P| ≤ B := by
  obtain ⟨hdet, -, hno⟩ := complexFake_kernelCounts_nonneg_no_naiveHeight
  refine ⟨hdet, ?_⟩
  rintro ⟨c, B, hB⟩
  exact hno ⟨fun P => (c P : ℝ), 0, B, fun P => by simpa using Nat.cast_nonneg (c P), hB⟩

end GaloisForLFunctions.ArithmeticEffectivityTheory.WindowNaiveHeights

