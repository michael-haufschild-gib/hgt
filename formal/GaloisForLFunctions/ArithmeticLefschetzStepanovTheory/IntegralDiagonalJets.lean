import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.MvPolynomial.Ideal
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Integral polynomial jets and diagonal ideals

Over a characteristic-zero domain, ordinary polynomial jets detect powers
of a point ideal without dividing by factorials. The coefficient recursion
for a partial derivative cancels a positive integer at each step. This
applies when the coefficients themselves are integer polynomials, allowing
the evaluation point to be a tuple of indeterminates.
-/

open MvPolynomial
noncomputable section
namespace GaloisForLFunctions.ArithmeticLefschetzStepanovTheory

variable {σ R : Type*} [CommRing R]

/-- Ordered partial derivatives over an arbitrary coefficient ring. -/
def polynomialJetWord (L : List σ) : Module.End R (MvPolynomial σ R) :=
  L.foldr (fun j D => (pderiv j).toLinearMap * D) 1

theorem polynomialJetWord_nil (F : MvPolynomial σ R) : polynomialJetWord [] F = F := rfl

theorem polynomialJetWord_cons (j : σ) (L : List σ) (F : MvPolynomial σ R) :
    polynomialJetWord (j :: L) F = pderiv j (polynomialJetWord L F) := rfl

theorem polynomialJetWord_append (L K : List σ) (F : MvPolynomial σ R) :
    polynomialJetWord (L ++ K) F = polynomialJetWord L (polynomialJetWord K F) := by
  induction L with
  | nil => rfl
  | cons j L ih => exact congrArg (pderiv j) ih

/-- Vanishing of all polynomial derivatives below an order, with values in the coefficient ring. -/
def PolynomialVanishesToOrder (F : MvPolynomial σ R) (u : σ → R) (r : ℕ) : Prop :=
  ∀ L : List σ, L.length < r → eval u (polynomialJetWord L F) = 0

theorem polynomialVanishesToOrder_succ_iff (F : MvPolynomial σ R) (u : σ → R) (r : ℕ) :
    PolynomialVanishesToOrder F u (r + 1) ↔
      eval u F = 0 ∧ ∀ j, PolynomialVanishesToOrder (pderiv j F) u r := by
  constructor
  · intro h
    refine ⟨h [] (by simp), ?_⟩
    intro j L hL
    have hv := h (L ++ [j]) (by simp only [List.length_append, List.length_singleton]; omega)
    simpa only [polynomialJetWord_append, polynomialJetWord_cons, polynomialJetWord_nil] using hv
  · rintro ⟨h0, hd⟩ L hL
    induction L using List.reverseRecOn with
    | nil => exact h0
    | append_singleton L j _ =>
      rw [polynomialJetWord_append, polynomialJetWord_cons, polynomialJetWord_nil]
      exact hd j L (by simp only [List.length_append, List.length_singleton] at hL; omega)

theorem mvPolynomialBaseTranslation_C (u : σ → R) (c : R) :
    mvPolynomialBaseTranslation u (C c) = C c := by
  simpa only [MvPolynomial.algebraMap_eq] using (mvPolynomialBaseTranslation u).commutes c

theorem eval_baseTranslation (u v : σ → R) (F : MvPolynomial σ R) :
    eval v (mvPolynomialBaseTranslation u F) = eval (fun j => v j + u j) F := by
  induction F using MvPolynomial.induction_on with
  | C c => simp only [mvPolynomialBaseTranslation_C, eval_C]
  | add F G hF hG => simp only [map_add, hF, hG]
  | mul_X F j hF =>
    simp only [map_mul, mvPolynomialBaseTranslation_X, map_add, eval_X, eval_C, hF]

/-- Translation by coefficient constants commutes with every partial derivative. -/
theorem pderiv_baseTranslation (u : σ → R) (j : σ) (F : MvPolynomial σ R) :
    pderiv j (mvPolynomialBaseTranslation u F) =
      mvPolynomialBaseTranslation u (pderiv j F) := by
  induction F using MvPolynomial.induction_on with
  | C c => simp only [mvPolynomialBaseTranslation_C, pderiv_C, map_zero]
  | add F G hF hG => simp only [map_add, hF, hG]
  | mul_X F i hF =>
    by_cases hi : i = j
    · subst i
      simp only [map_mul, mvPolynomialBaseTranslation_X, pderiv_mul, map_add,
        pderiv_X_self, pderiv_C, add_zero, mul_one, hF]
    · simp only [map_mul, mvPolynomialBaseTranslation_X, pderiv_mul, map_add,
        pderiv_X_of_ne hi, pderiv_C, add_zero, mul_zero, hF]

theorem polynomialJetWord_baseTranslation (u : σ → R) (L : List σ)
    (F : MvPolynomial σ R) :
    polynomialJetWord L (mvPolynomialBaseTranslation u F) =
      mvPolynomialBaseTranslation u (polynomialJetWord L F) := by
  induction L with
  | nil => rfl
  | cons j L ih =>
    rw [polynomialJetWord_cons, ih, pderiv_baseTranslation, polynomialJetWord_cons]

theorem polynomialVanishesToOrder_baseTranslation_zero (u : σ → R)
    (F : MvPolynomial σ R) (r : ℕ) :
    PolynomialVanishesToOrder (mvPolynomialBaseTranslation u F) (fun _ => 0) r ↔
      PolynomialVanishesToOrder F u r := by
  simp only [PolynomialVanishesToOrder, polynomialJetWord_baseTranslation,
    eval_baseTranslation, zero_add]

/-- The ideal generated by the coordinate differences from a coefficient-valued point. -/
def polynomialPointIdeal (u : σ → R) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun j => X j - C (u j))

/-- Centering carries the point ideal to the origin ideal over the same coefficient ring. -/
theorem map_polynomialPointIdeal_baseTranslation (u : σ → R) :
    Ideal.map (mvPolynomialBaseTranslation u).toRingHom (polynomialPointIdeal u) =
      idealOfVars σ R := by
  rw [polynomialPointIdeal, Ideal.map_span]
  have he : (mvPolynomialBaseTranslation u).toRingHom '' (Set.range fun j => X j - C (u j)) =
      Set.range (X : σ → MvPolynomial σ R) := by
    ext F
    constructor
    · rintro ⟨G, ⟨j, rfl⟩, rfl⟩
      refine ⟨j, ?_⟩
      change X j = mvPolynomialBaseTranslation u (X j - C (u j))
      rw [map_sub,
        mvPolynomialBaseTranslation_X, mvPolynomialBaseTranslation_C, add_sub_cancel_right]
    · rintro ⟨j, rfl⟩
      refine ⟨X j - C (u j), ⟨j, rfl⟩, ?_⟩
      change mvPolynomialBaseTranslation u (X j - C (u j)) = X j
      rw [map_sub, mvPolynomialBaseTranslation_X, mvPolynomialBaseTranslation_C,
        add_sub_cancel_right]
  rw [he]

theorem baseTranslation_mem_originIdeal_pow_iff (u : σ → R) (F : MvPolynomial σ R) (r : ℕ) :
    mvPolynomialBaseTranslation u F ∈ idealOfVars σ R ^ r ↔ F ∈ polynomialPointIdeal u ^ r := by
  rw [← map_polynomialPointIdeal_baseTranslation u, ← Ideal.map_pow,
    Ideal.mem_map_iff_of_surjective (mvPolynomialBaseTranslation u).toRingHom
      (mvPolynomialBaseTranslation u).surjective]
  constructor
  · rintro ⟨G, hG, he⟩
    have hGF : G = F := (mvPolynomialBaseTranslation u).injective he
    exact hGF ▸ hG
  · intro hF
    exact ⟨F, hF, rfl⟩

section Domain

variable [NoZeroDivisors R] [CharZero R]

/-- The origin filtration is detected recursively by evaluation and partial derivatives. -/
theorem mem_originIdeal_pow_succ_iff (F : MvPolynomial σ R) (r : ℕ) :
    F ∈ idealOfVars σ R ^ (r + 1) ↔
      eval (fun _ => 0) F = 0 ∧ ∀ j, pderiv j F ∈ idealOfVars σ R ^ r := by
  rw [mem_pow_idealOfVars_iff']
  constructor
  · intro h
    constructor
    · simpa only [eval_zero', constantCoeff_eq] using h 0 (by simp)
    · intro j
      rw [mem_pow_idealOfVars_iff']
      intro a ha
      rw [coeff_pderiv, h (a + Finsupp.single j 1) (by
        simp only [map_add, Finsupp.degree_single]; omega), zero_mul]
  · rintro ⟨h0, hd⟩ a ha
    by_cases ha0 : a = 0
    · subst a
      simpa only [eval_zero', constantCoeff_eq] using h0
    · obtain ⟨j, hj⟩ : ∃ j, a j ≠ 0 := by
        by_contra h
        push Not at h
        exact ha0 (Finsupp.ext h)
      have hsplit := Finsupp.sub_add_single_one_cancel hj
      have hdeg : Finsupp.degree (a - Finsupp.single j 1) < r := by
        have he := congrArg Finsupp.degree hsplit
        simp only [map_add, Finsupp.degree_single] at he
        omega
      have hc := (mem_pow_idealOfVars_iff' r (pderiv j F)).mp (hd j)
        (a - Finsupp.single j 1) hdeg
      rw [coeff_pderiv, hsplit] at hc
      have hnat : (((a - Finsupp.single j 1 : σ →₀ ℕ) j : ℕ) : R) + 1 ≠ 0 := by
        have hk : (a - Finsupp.single j 1 : σ →₀ ℕ) j + 1 ≠ 0 := by omega
        exact_mod_cast hk
      exact (mul_eq_zero.mp hc).resolve_right hnat

/-- Integral ordinary jets detect the origin-ideal power exactly, with no denominator inversion. -/
theorem polynomialVanishesToOrder_zero_iff (F : MvPolynomial σ R) (r : ℕ) :
    PolynomialVanishesToOrder F (fun _ => 0) r ↔ F ∈ idealOfVars σ R ^ r := by
  induction r generalizing F with
  | zero =>
    constructor
    · intro _; simp only [pow_zero, Ideal.one_eq_top, Submodule.mem_top]
    · intro _ L hL; omega
  | succ r ih =>
    rw [polynomialVanishesToOrder_succ_iff, mem_originIdeal_pow_succ_iff]
    exact and_congr Iff.rfl (forall_congr' fun j => ih (pderiv j F))

/-- Ordinary jets over a characteristic-zero domain detect the point-ideal power integrally. -/
theorem polynomialVanishesToOrder_iff_mem_pointIdeal_pow (u : σ → R)
    (F : MvPolynomial σ R) (r : ℕ) :
    PolynomialVanishesToOrder F u r ↔ F ∈ polynomialPointIdeal u ^ r := by
  rw [← polynomialVanishesToOrder_baseTranslation_zero u F r,
    polynomialVanishesToOrder_zero_iff, baseTranslation_mem_originIdeal_pow_iff]

/-- A coordinate plus a nonzero constant is regular on every truncated origin algebra. -/
theorem mem_originIdeal_pow_of_X_add_C_mul (j : σ) (c : R) (hc : c ≠ 0)
    (F : MvPolynomial σ R) (r : ℕ)
    (h : (X j + C c) * F ∈ idealOfVars σ R ^ r) : F ∈ idealOfVars σ R ^ r := by
  classical
  rw [mem_pow_idealOfVars_iff'] at h ⊢
  suffices hh : ∀ n, ∀ a : σ →₀ ℕ, Finsupp.degree a = n → n < r → F.coeff a = 0 by
    exact fun a ha => hh _ a rfl ha
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro a han hnr
    have hp := h a (han ▸ hnr)
    have hx : (X j * F).coeff a = 0 := by
      by_cases haj : a j = 0
      · apply MvPolynomial.notMem_support_iff.mp
        intro ha
        rw [mul_comm, MvPolynomial.support_mul_X] at ha
        obtain ⟨b, _, hba⟩ := Finset.mem_map.mp ha
        change b + Finsupp.single j 1 = a at hba
        have he := congrArg (fun d : σ →₀ ℕ => d j) hba
        simp only [Finsupp.add_apply, Finsupp.single_eq_same, haj] at he
        omega
      · have hs := Finsupp.sub_add_single_one_cancel haj
        have hd : Finsupp.degree (a - Finsupp.single j 1) < n := by
          have he := congrArg Finsupp.degree hs
          rw [map_add, Finsupp.degree_single, han] at he
          omega
        have hs' : Finsupp.single j 1 + (a - Finsupp.single j 1) = a := by
          rw [add_comm, hs]
        rw [← hs', MvPolynomial.coeff_X_mul]
        exact ih _ hd _ rfl (lt_trans hd hnr)
    rw [add_mul, MvPolynomial.coeff_add, MvPolynomial.coeff_C_mul, hx, zero_add] at hp
    exact (mul_eq_zero.mp hp).resolve_left hc

/-- A coordinate nonzero at the coefficient-valued point is regular modulo every point-ideal power. -/
theorem X_mul_mem_pointIdeal_pow_iff (u : σ → R) (j : σ) (hj : u j ≠ 0)
    (F : MvPolynomial σ R) (r : ℕ) :
    X j * F ∈ polynomialPointIdeal u ^ r ↔ F ∈ polynomialPointIdeal u ^ r := by
  constructor
  · intro h
    have ht := (baseTranslation_mem_originIdeal_pow_iff u (X j * F) r).mpr h
    rw [map_mul, mvPolynomialBaseTranslation_X] at ht
    exact (baseTranslation_mem_originIdeal_pow_iff u F r).mp
      (mem_originIdeal_pow_of_X_add_C_mul j (u j) hj _ r ht)
  · exact fun h => Ideal.mul_mem_left _ _ h

end Domain

#print axioms polynomialVanishesToOrder_iff_mem_pointIdeal_pow
#print axioms X_mul_mem_pointIdeal_pow_iff

end GaloisForLFunctions.ArithmeticLefschetzStepanovTheory
