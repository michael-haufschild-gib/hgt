import GaloisForLFunctions.AdelicKreinGeometry.Haar.PositiveAffineObstruction
import GaloisForLFunctions.BiarithmeticGeometry.Affine.PositiveAffineAction
import GaloisForLFunctions.AdelicKreinGeometry.Haar.FiniteAdelicReading

/-!
# The critical Haar obstruction on the actual rational adeles

Finite-only diagonal translations embed the positive rational affine group. Integrality
at every finite place pulls the adelic Haar reading back to the integer successor.
-/

open Filter Topology IsDedekindDomain
open scoped Classical
open GaloisForLFunctions.ArithmeticPositiveDuality
open GaloisForLFunctions.BiarithmeticGeometry
open GaloisForLFunctions.HeckeKreinToeplitz
open GaloisForLFunctions.RHTower
noncomputable section
namespace GaloisForLFunctions.AdelicKreinGeometry

/-- The actual rational adele ring, with its real and finite components. -/
abbrev RationalAdeleRing := ℝ × CCMRationalFiniteAdele

/-- Positive rational dilations acting on all rational adeles by scalar multiplication. -/
abbrev RationalAdelicAffineGroup := PositiveRationalAffineGroup RationalAdeleRing

/-- Rational translations supported on the finite component of the adele ring. -/
def rationalFiniteTranslation : ℚ →ₗ[ℚ] RationalAdeleRing where
  toFun q := (0, algebraMap ℚ CCMRationalFiniteAdele q)
  map_add' a b := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      rw [add_zero]
    · exact map_add (algebraMap ℚ CCMRationalFiniteAdele) a b
  map_smul' a b := by
    apply Prod.ext
    · simp
    · change algebraMap ℚ CCMRationalFiniteAdele (a * b) =
        a • algebraMap ℚ CCMRationalFiniteAdele b
      rw [map_mul, Algebra.smul_def]

theorem rationalFiniteTranslation_injective : Function.Injective rationalFiniteTranslation := by
  intro a b h
  let v : HeightOneSpectrum ℤ :=
    (Rat.HeightOneSpectrum.primesEquiv (R := ℤ)).symm ⟨2, Nat.prime_two⟩
  -- One finite completion already detects equality of rational diagonal elements.
  exact (algebraMap ℚ (v.adicCompletion ℚ)).injective
    (congrArg (fun x : RationalAdeleRing => x.2 v) h)

/-- The rational positive affine subgroup generated by finite-only diagonal translations. -/
def rationalFiniteAffineMap : posAffine →* RationalAdelicAffineGroup :=
  positiveRationalAffineMap RationalAdeleRing rationalFiniteTranslation

theorem rationalFiniteAffineMap_injective : Function.Injective rationalFiniteAffineMap :=
  positiveRationalAffineMap_injective RationalAdeleRing rationalFiniteTranslation
    rationalFiniteTranslation_injective

/-- A diagonal rational is integral at every finite place exactly when its denominator is one. -/
theorem rationalFiniteAdele_mem_integral_iff (q : ℚ) :
    algebraMap ℚ CCMRationalFiniteAdele q ∈ ccmRationalIntegralFiniteAdeles ↔ q.den = 1 := by
  constructor
  · intro h
    apply (den_eq_one_iff_exists q).mpr
    apply HeightOneSpectrum.mem_integers_of_valuation_le_one ℚ
    intro v
    have hv := h v
    change algebraMap ℚ (v.adicCompletion ℚ) q ∈ v.adicCompletionIntegers ℚ at hv
    rw [HeightOneSpectrum.mem_adicCompletionIntegers] at hv
    change Valued.v (algebraMap ℚ (v.adicCompletion ℚ) q) ≤ 1 at hv
    rw [HeightOneSpectrum.algebraMap_adicCompletion ℤ ℚ v,
      Function.comp_apply, HeightOneSpectrum.valuedAdicCompletion_eq_valuation'] at hv
    exact hv
  · intro h
    obtain ⟨m, rfl⟩ := (den_eq_one_iff_exists q).mp h
    intro v
    change algebraMap ℚ (v.adicCompletion ℚ) (m : ℚ) ∈ v.adicCompletionIntegers ℚ
    rw [map_intCast]
    exact intCast_mem (v.adicCompletionIntegers ℚ) m

/-- A nonzero scaled Haar finite-adelic reading and continuous dilations force infinite index. -/
theorem negIndex_adelic_eq_top_of_nonzero_haar_continuous_dilation
    {k : RationalAdelicAffineGroup → ℂ} {z : ℂ} (hk : IsHermKernel k) (hz : z ≠ 0)
    (hs : ∀ b : CCMRationalFiniteAdele,
      k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
        if b ∈ ccmRationalIntegralFiniteAdeles then z else 0)
    {f : ℝ → ℂ} (hf : ContinuousAt f 1)
    (hdil : ∀ u : posUnits, k (SemidirectProduct.inr u) = f ((u : ℚˣ) : ℚ)) :
    negIndex k = ⊤ := by
  let φ := rationalFiniteAffineMap
  have hpull : IsHermKernel (k ∘ φ) := by
    intro g
    change k (φ g⁻¹) = starRingEnd ℂ (k (φ g))
    rw [map_inv]
    exact hk _
  have hS (b : ℚ) : (k ∘ φ) (posAffineTranslation b) = if b.den = 1 then z else 0 := by
    change k (positiveRationalAffineMap RationalAdeleRing rationalFiniteTranslation
      (posAffineTranslation b)) = _
    rw [positiveRationalAffineMap_translation]
    change k (SemidirectProduct.inl (Multiplicative.ofAdd
      ((0 : ℝ), algebraMap ℚ CCMRationalFiniteAdele b))) = _
    rw [hs, rationalFiniteAdele_mem_integral_iff]
    by_cases hb : b.den = 1 <;> simp only [hb, if_true, if_false]
  have hD (u : posUnits) : (k ∘ φ) (posAffineDilation u) = f ((u : ℚˣ) : ℚ) := by
    change k (positiveRationalAffineMap RationalAdeleRing rationalFiniteTranslation
      (posAffineDilation u)) = _
    rw [positiveRationalAffineMap_dilation, hdil]
  have htop := negIndex_posAffine_eq_top_of_nonzero_haar_continuous_dilation hpull hz hS hf hD
  apply le_antisymm le_top
  rw [← htop]
  exact negIndex_comp_le k φ

/-- A normalized Haar finite-adelic reading and continuous dilations force infinite index. -/
theorem negIndex_adelic_eq_top_of_haar_continuous_dilation
    {k : RationalAdelicAffineGroup → ℂ} (hk : IsHermKernel k)
    (hs : ∀ b : CCMRationalFiniteAdele,
      k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
        if b ∈ ccmRationalIntegralFiniteAdeles then 1 else 0)
    {f : ℝ → ℂ} (hf : ContinuousAt f 1)
    (hdil : ∀ u : posUnits, k (SemidirectProduct.inr u) = f ((u : ℚˣ) : ℚ)) :
    negIndex k = ⊤ :=
  negIndex_adelic_eq_top_of_nonzero_haar_continuous_dilation hk one_ne_zero hs hf hdil

/-- No nonzero Haar finite-adelic reading can share a finite-index carrier with Weil's correlation. -/
theorem negIndex_adelic_eq_top_of_nonzero_haar_weil_dilation
    {k : RationalAdelicAffineGroup → ℂ} {z : ℂ} (hk : IsHermKernel k) (hz : z ≠ 0)
    (hs : ∀ b : CCMRationalFiniteAdele,
      k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
        if b ∈ ccmRationalIntegralFiniteAdeles then z else 0)
    (hdil : ∀ u : posUnits, k (SemidirectProduct.inr u) = ratCorr u) :
    negIndex k = ⊤ := by
  have hf : ContinuousAt (fun x : ℝ => splineCorr (-Real.log x)) 1 :=
    continuous_splineCorr.continuousAt.comp (Real.continuousAt_log one_ne_zero).neg
  exact negIndex_adelic_eq_top_of_nonzero_haar_continuous_dilation hk hz hs hf hdil

/-- The critical Haar finite-adelic state cannot share a finite-index carrier with Weil's correlation. -/
theorem negIndex_adelic_eq_top_of_haar_weil_dilation
    {k : RationalAdelicAffineGroup → ℂ} (hk : IsHermKernel k)
    (hs : ∀ b : CCMRationalFiniteAdele,
      k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
        if b ∈ ccmRationalIntegralFiniteAdeles then 1 else 0)
    (hdil : ∀ u : posUnits, k (SemidirectProduct.inr u) = ratCorr u) :
    negIndex k = ⊤ := by
  have hf : ContinuousAt (fun x : ℝ => splineCorr (-Real.log x)) 1 :=
    continuous_splineCorr.continuousAt.comp (Real.continuousAt_log one_ne_zero).neg
  exact negIndex_adelic_eq_top_of_haar_continuous_dilation hk hs hf hdil

/-- No finite-index adelic state combines a nonzero critical Haar reading with Weil's correlation. -/
theorem not_exists_finite_index_adelic_haar_weil_state :
    ¬ ∃ (k : RationalAdelicAffineGroup → ℂ) (z : ℂ), z ≠ 0 ∧ IsHermKernel k ∧
      (∀ b : CCMRationalFiniteAdele,
        k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
          if b ∈ ccmRationalIntegralFiniteAdeles then z else 0) ∧
      (∀ u : posUnits, k (SemidirectProduct.inr u) = ratCorr u) ∧ negIndex k < ⊤ := by
  rintro ⟨k, z, hz, hk, hs, hdil, hfin⟩
  rw [negIndex_adelic_eq_top_of_nonzero_haar_weil_dilation hk hz hs hdil] at hfin
  exact lt_irrefl _ hfin

/-- The actual finite-adelic Haar integral cannot share a finite-index carrier with Weil's reading. -/
theorem not_exists_finite_index_adelic_haar_coefficient_weil_state :
    ¬ ∃ (k : RationalAdelicAffineGroup → ℂ) (z : ℂ), z ≠ 0 ∧ IsHermKernel k ∧
      (∀ b : CCMRationalFiniteAdele,
        k (SemidirectProduct.inl (Multiplicative.ofAdd ((0 : ℝ), b))) =
          z * finiteAdelicHaarTranslation b) ∧
      (∀ u : posUnits, k (SemidirectProduct.inr u) = ratCorr u) ∧ negIndex k < ⊤ := by
  rintro ⟨k, z, hz, hk, hs, hdil, hfin⟩
  apply not_exists_finite_index_adelic_haar_weil_state
  refine ⟨k, z, hz, hk, ?_, hdil, hfin⟩
  intro b
  simpa only [finiteAdelicHaarTranslation_eq, mul_ite, mul_one, mul_zero] using hs b

#print axioms rationalFiniteAdele_mem_integral_iff
