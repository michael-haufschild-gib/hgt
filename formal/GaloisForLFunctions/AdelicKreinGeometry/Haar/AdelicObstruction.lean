#print axioms negIndex_adelic_eq_top_of_nonzero_haar_continuous_dilation
#print axioms negIndex_adelic_eq_top_of_haar_continuous_dilation
#print axioms negIndex_adelic_eq_top_of_nonzero_haar_weil_dilation
#print axioms negIndex_adelic_eq_top_of_haar_weil_dilation
#print axioms not_exists_finite_index_adelic_haar_weil_state
#print axioms not_exists_finite_index_adelic_haar_coefficient_weil_state
end GaloisForLFunctions.AdelicKreinGeometry
