import GaloisForLFunctions.Hurwitz.IntegerTranslationDifferentialMatroid
import GaloisForLFunctions.HTGeometry.DifferentialPolynomialOver
import GaloisForLFunctions.HTGeometry.DifferentialShiftPivotRelationIdeal

/-!
# Complete mixed relation ideal for integer-translated Hurwitz families

For one nonintegral representative from each integer-translation class, the representative
Hurwitz elements are differentially independent over `ℂ(a)`.  Every nonnegative integer translate
is a scalar multiple of a higher pivot jet.  Shifted-pivot elimination therefore computes the
entire mixed relation ideal, including all nonlinear relations.
-/

open Complex Polynomial
open scoped Differential

namespace HurwitzJointLadder

open HurwitzLadder HurwitzJointOrbit HurwitzZetaContinuation GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- The constant rational-function coefficient relating an integer translate to a pivot jet. -/
def continuedHurwitzIntegerTranslationCoefficient (s : ℂ) (d : ℕ) : RatFunc ℂ :=
  algebraMap ℂ (RatFunc ℂ)
    ((-1 : ℂ) ^ d / (ascPochhammer ℂ d).eval s)

/-- The scalar identity behind the integer-translation jet law. -/
theorem continuedHurwitzIntegerTranslationCoefficient_mul
    (s : ℂ) (d n : ℕ) (hs : ∀ m : ℤ, s ≠ (m : ℂ)) :
    ((-1 : ℂ) ^ d / (ascPochhammer ℂ d).eval s) *
        ((-1 : ℂ) ^ (n + d) * (ascPochhammer ℂ (n + d)).eval s) =
      (-1 : ℂ) ^ n * (ascPochhammer ℂ n).eval (s + d) := by
  have hd := ascPochhammer_eval_ne_zero_of_nonintegral hs d
  have hp := congrArg (Polynomial.eval s) (ascPochhammer_mul (S := ℂ) d n)
  simp only [eval_mul, eval_comp, eval_add, eval_X, eval_natCast] at hp
  field_simp [hd]
  rw [pow_add, show n + d = d + n by omega, ← hp]
  ring

/-- A complex constant embedded into `RatFunc ℂ` becomes the same constant upper-end germ. -/
theorem upperEndRatfuncToMero_algebraMap_complex (q : ℂ) :
    letI := isDomain_upperEndAnalyticSubring
    upperEndRatfuncToMero (algebraMap ℂ (RatFunc ℂ) q) =
      upperEndPolyToMero (Polynomial.C q) := by
  letI := isDomain_upperEndAnalyticSubring
  rw [show algebraMap ℂ (RatFunc ℂ) q =
    algebraMap (Polynomial ℂ) (RatFunc ℂ) (Polynomial.C q) by rfl]
  exact upperEndRatfuncToMero_algebraMap_polynomial (Polynomial.C q)

/-- **Typed integer-translation jet law.**  The identity holds directly in the upper-end
meromorphic field over `RatFunc ℂ`; no passage from pointwise functions to germs is implicit. -/
theorem differentialJet_continuedHzetaUpperEndMero_add_nat_eq
    (s : ℂ) (d n : ℕ) (hs : ∀ m : ℤ, s ≠ (m : ℂ)) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    differentialJet n (continuedHzetaUpperEndMero (s + d)) =
      algebraMap (RatFunc ℂ) upperEndMeroField
          (continuedHurwitzIntegerTranslationCoefficient s d) *
        differentialJet (n + d) (continuedHzetaUpperEndMero s) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℤ upperEndAnalyticSubring := Ring.toIntAlgebra _
  letI : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  rw [differentialJet_continuedHzetaUpperEndMero_eq,
    differentialJet_continuedHzetaUpperEndMero_eq]
  change
    upperEndPolyToMero
        (Polynomial.C ((-1 : ℂ) ^ n * (ascPochhammer ℂ n).eval (s + d))) *
          continuedHzetaUpperEndMero (s + d + n) =
      upperEndRatfuncToMero
          (algebraMap ℂ (RatFunc ℂ)
            ((-1 : ℂ) ^ d / (ascPochhammer ℂ d).eval s)) *
        (upperEndPolyToMero
            (Polynomial.C
              ((-1 : ℂ) ^ (n + d) * (ascPochhammer ℂ (n + d)).eval s)) *
          continuedHzetaUpperEndMero (s + (n + d)))
  rw [upperEndRatfuncToMero_algebraMap_complex, ← mul_assoc, ← map_mul]
  simp only [Polynomial.C_mul]
  rw [continuedHurwitzIntegerTranslationCoefficient_mul s d n hs]
  congr 2
  push_cast
  ring

/-- **Complete mixed integer-translation relation ideal.**

For pairwise integer-incongruent nonintegral representatives `t`, the full relation ideal over
the differential coefficient field `RatFunc ℂ` of the representatives and arbitrary nonnegative
integer translates is generated by the displayed shifted linear jet relations. -/
theorem continued_hurwitz_integerTranslation_complete_relationIdeal
    {κ R : Type*} [Fintype κ] [DecidableEq κ]
    (t : κ → ℂ) (base : R → κ) (offset : R → ℕ)
    (hnonintegral : ∀ k, ∀ m : ℤ, t k ≠ (m : ℂ))
    (hseparated : ∀ i j, i ≠ j → ∀ m : ℤ, t i - t j ≠ (m : ℂ)) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    differentialRelationIdealOver (K := RatFunc ℂ)
        (Sum.elim
          (fun k => continuedHzetaUpperEndMero (t k))
          (fun r => continuedHzetaUpperEndMero (t (base r) + offset r))) =
      differentialShiftPivotRelationIdeal base offset
        (fun r _ => continuedHurwitzIntegerTranslationCoefficient (t (base r)) (offset r)) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℤ upperEndAnalyticSubring := Ring.toIntAlgebra _
  letI : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  have hx :=
    continued_joint_hzeta_upperEnd_differentialIndependent_finite_of_integerResidueSeparated
      (s := t) hnonintegral hseparated
  change differentialRelationIdeal (C := RatFunc ℂ)
      (Sum.elim
        (fun k => continuedHzetaUpperEndMero (t k))
        (fun r => continuedHzetaUpperEndMero (t (base r) + offset r))) = _
  apply differentialRelationIdeal_sumElim_eq_shiftPivot _ _ base offset _ hx
  intro r n
  exact differentialJet_continuedHzetaUpperEndMero_add_nat_eq
    (t (base r)) (offset r) n (hnonintegral (base r))

end

end HurwitzJointLadder
