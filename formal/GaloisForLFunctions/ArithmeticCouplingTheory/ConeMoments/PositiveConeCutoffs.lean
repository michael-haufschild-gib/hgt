import Mathlib.Data.Finset.Lattice.Union
import Mathlib.Tactic
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Topology.Algebra.InfiniteSum.Real

/-!
# Nested exponential-tail cutoffs for a positive two-generator cone

Every positive exponential damping is summable over a cone generated by two
positive real numbers. Colliding frequencies can be discarded by choosing one
pair of indices for each distinct frequency. Finite tail cutoffs can therefore
be made nested and exhaustive while meeting arbitrary positive error thresholds
at an independently prescribed sequence of positive damping rates.
-/

open Finset Complex
noncomputable section
namespace GaloisForLFunctions.ArithmeticCouplingTheory.ConeMoments

def coneFrequency (a b : ℝ) (k : ℕ × ℕ) : ℝ := (k.1 : ℝ) * a + (k.2 : ℝ) * b

lemma summable_cone_exp {a b ε : ℝ} (ha : 0 < a) (hb : 0 < b) (hε : 0 < ε) :
    Summable fun k : ℕ × ℕ => Real.exp (-ε * coneFrequency a b k) := by
  have ha' : Summable fun n : ℕ => Real.exp (n * (-ε * a)) :=
    Real.summable_exp_nat_mul_iff.mpr (by nlinarith)
  have hb' : Summable fun n : ℕ => Real.exp (n * (-ε * b)) :=
    Real.summable_exp_nat_mul_iff.mpr (by nlinarith)
  have hp : Summable fun k : ℕ × ℕ =>
      Real.exp (k.1 * (-ε * a)) * Real.exp (k.2 * (-ε * b)) := by
    refine (summable_prod_of_nonneg
      (f := fun k : ℕ × ℕ => Real.exp (k.1 * (-ε * a)) * Real.exp (k.2 * (-ε * b)))
      (fun k => mul_nonneg (Real.exp_pos _).le (Real.exp_pos _).le)).mpr ⟨?_, ?_⟩
    · intro k
      exact hb'.mul_left (Real.exp (k * (-ε * a)))
    · simp_rw [tsum_mul_left]
      exact ha'.mul_right (∑' n : ℕ, Real.exp (n * (-ε * b)))
  refine hp.congr fun k => ?_
  rw [← Real.exp_add]
  congr 1
  unfold coneFrequency
  ring

/-- Distinct positive frequencies in the natural two-generator cone. -/
abbrev PositiveCone (a b : ℝ) := {t : ℝ // 0 < t ∧ ∃ k : ℕ × ℕ, coneFrequency a b k = t}

lemma summable_positiveCone_exp {a b ε : ℝ} (ha : 0 < a) (hb : 0 < b) (hε : 0 < ε) :
    Summable fun t : PositiveCone a b => Real.exp (-ε * t.val) := by
  classical
  choose k hk using fun t : PositiveCone a b => t.property.2
  have hinj : Function.Injective k := by
    intro s t he
    apply Subtype.ext
    exact (hk s).symm.trans (he ▸ hk t)
  exact ((summable_cone_exp ha hb hε).comp_injective hinj).congr fun t => by simp only [Function.comp_apply, hk t]

instance positiveCone_countable (a b : ℝ) : Countable (PositiveCone a b) := by
  classical
  choose k hk using fun t : PositiveCone a b => t.property.2
  have hinj : Function.Injective k := by
    intro s t he
    apply Subtype.ext
    exact (hk s).symm.trans (he ▸ hk t)
  exact hinj.countable

/-- Every exponential tail of the distinct cone frequencies admits a finite cutoff. -/
lemma exists_positiveCone_cutoff {a b ε η : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hε : 0 < ε) (hη : 0 < η) :
    ∃ F : Finset (PositiveCone a b), ∀ G : Finset (PositiveCone a b),
      Disjoint G F → ∑ t ∈ G, Real.exp (-ε * t.val) < η := by
  obtain ⟨F, hF⟩ := summable_iff_vanishing_norm.mp (summable_positiveCone_exp ha hb hε) η hη
  refine ⟨F, fun G hG => ?_⟩
  have h := hF G hG
  rwa [Real.norm_eq_abs, abs_of_nonneg (sum_nonneg (fun t _ => (Real.exp_pos _).le))] at h

/-- Increasing finite frequency sets exhaust the cone and satisfy any prescribed exponential tails. -/
theorem exists_nested_cone_cutoffs {a b : ℝ} (ha : 0 < a) (hb : 0 < b)
    (ε η : ℕ → ℝ) (hε : ∀ k, 0 < ε k) (hη : ∀ k, 0 < η k) :
    ∃ S : ℕ → Finset ℝ, Monotone S ∧
      (∀ k u, u ∈ S k → 0 < u) ∧
      (∀ t : PositiveCone a b, ∃ k, t.val ∈ S k) ∧
      (∀ k, ∑ u ∈ S (k + 1) \ S k, Real.exp (-ε k * u) < η k) := by
  classical
  letI : Nonempty (PositiveCone a b) := ⟨⟨a, ha, ⟨(1, 0), by simp [coneFrequency]⟩⟩⟩
  obtain ⟨e, he⟩ := exists_surjective_nat (PositiveCone a b)
  choose T hT using fun k => exists_positiveCone_cutoff ha hb (hε k) (hη k)
  let F : ℕ → Finset (PositiveCone a b) := fun k =>
    (range (k + 1)).biUnion fun j => T j ∪ {e j}
  have hTF : ∀ k, T k ⊆ F k := by
    intro k t ht
    exact mem_biUnion.mpr ⟨k, mem_range.mpr (Nat.lt_succ_self k), mem_union_left _ ht⟩
  have hFmono : Monotone F := by
    intro k l hkl t ht
    obtain ⟨j, hj, hjt⟩ := mem_biUnion.mp ht
    exact mem_biUnion.mpr ⟨j, mem_range.mpr
      ((mem_range.mp hj).trans_le (Nat.add_le_add_right hkl 1)), hjt⟩
  have hFcover : ∀ t, ∃ k, t ∈ F k := by
    intro t
    obtain ⟨k, rfl⟩ := he t
    exact ⟨k, mem_biUnion.mpr ⟨k, mem_range.mpr (Nat.lt_succ_self k),
      mem_union_right _ (mem_singleton_self _)⟩⟩
  let v : PositiveCone a b ↪ ℝ := ⟨Subtype.val, Subtype.coe_injective⟩
  refine ⟨fun k => (F k).map v, ?_, ?_, ?_, ?_⟩
  · intro k l hkl t ht
    obtain ⟨u, hu, rfl⟩ := mem_map.mp ht
    exact mem_map.mpr ⟨u, hFmono hkl hu, rfl⟩
  · intro k t ht
    obtain ⟨u, hu, rfl⟩ := mem_map.mp ht
    exact u.property.1
  · intro t
    obtain ⟨k, hk⟩ := hFcover t
    exact ⟨k, mem_map.mpr ⟨t, hk, rfl⟩⟩
  · intro k
    have hd : Disjoint (F (k + 1) \ F k) (T k) := by
      refine Finset.disjoint_left.mpr fun t ht htT => ?_
      exact (mem_sdiff.mp ht).2 (hTF k htT)
    have hh := hT k (F (k + 1) \ F k) hd
    rw [← Finset.map_sdiff, Finset.sum_map]
    exact hh

#print axioms exists_nested_cone_cutoffs

#print axioms summable_positiveCone_exp
#print axioms exists_positiveCone_cutoff
end GaloisForLFunctions.ArithmeticCouplingTheory.ConeMoments
