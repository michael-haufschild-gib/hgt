import GaloisForLFunctions.WindowTowerOfSpecZ.TheJetsOfTheTateFamily

/-!
# The Tate family solves a flow equation

The derivative of the Tate family in the dimension is expressed through the degree derivation
`D f = f·log` and Weil's arithmetic weight `Λ`:

* **The Tate flow equation** (`hasDerivAt_jordanTotient`): `∂_kJ_k = D J_k + J_k * Λ` in the Dirichlet
  ring, for every real `k` (`tateVelocity_eq`). At `k = 0` it is `∂_kJ_k|₀ = Λ`.
* **On a window** (`windowRep_tateVelocity`): the velocity of the Tate operator `U(k) = ρ_A(J_k)` is
  `[M, U(k)] + U(k)ρ_A(Λ)`, `M` the position: `U′ = [M, U] + Uρ_A(Λ)`, `U(0) = 1`. The whole Tate family
  is the solution of a linear flow driven by Weil's arithmetic operator.
* **The jet tower** (`windowRep_genVonMangoldt_succ`): `ρ_A(Λ_{j+1}) = [M, ρ_A(Λ_j)] + ρ_A(Λ)ρ_A(Λ_j)`
  (Bombieri's recursion `Λ_{j+1} = DΛ_j + Λ * Λ_j` on a window); in particular
  `ρ_A(Λ₂) = [M, ρ_A(Λ)] + ρ_A(Λ)²`.
* **Weil's operator generates the tower** (`windowRep_genVonMangoldt_mem`): every jet operator
  `ρ_A(Λ_j)` lies in the algebra generated by the position `M` and Weil's arithmetic operator `ρ_A(Λ)`.

This answers how the higher Taylor coefficients of the Tate family relate to the first (obstacles
§2.7, criterion 3): they are generated by it, as noncommutative polynomials in `M` and `ρ_A(Λ)`, and
carry no arithmetic information beyond it. Sieve-accessible positivity of `Λ_j` (`j ≥ 2`, WTZ) is
positivity of these polynomials; transporting it to `ρ_A(Λ)` requires inverting the commutator with
the position, which preserves no sign.
-/

noncomputable section

namespace GaloisForLFunctions.DimensionZeroGeometryOfSpecZ

open WindowTowerOfSpecZ ArithmeticDegenerationTheory

/-- The velocity identity `D(twist_{−k}ζ) * μ = D J_k + J_k * Λ`. -/
theorem tateVelocity_eq (k : ℝ) :
    degD (tateTwist (-k) (ArithmeticFunction.zeta : ArithmeticFunction ℝ)) *
        (ArithmeticFunction.moebius : ArithmeticFunction ℝ) =
      degD (jordanFun k) + jordanFun k * ArithmeticFunction.vonMangoldt := by
  rw [jordanFun_eq, degD_mul, degD_moebius]
  ring

/-- The first jet function of the Tate family is the velocity `D J_k + J_k * Λ`. -/
theorem tateJet_one_eq (k : ℝ) (n : ℕ) :
    tateJet 1 n k = (degD (jordanFun k) + jordanFun k * ArithmeticFunction.vonMangoldt) n := by
  rw [← tateVelocity_eq, ArithmeticFunction.mul_apply, tateJet]
  refine Finset.sum_congr rfl fun x hx => ?_
  have hx1 : x.1 ≠ 0 :=
    Nat.ne_of_gt (Nat.pos_of_mem_divisors (Nat.fst_mem_divisors_of_mem_antidiagonal hx))
  rw [degD_apply, tateTwist_apply, ArithmeticFunction.natCoe_apply,
    ArithmeticFunction.zeta_apply_ne hx1, ArithmeticFunction.intCoe_apply, neg_neg]
  push_cast
  ring

/-- **The Tate flow equation**: `∂_kJ_k(n) = (D J_k + J_k * Λ)(n)`. -/
theorem hasDerivAt_jordanTotient (k : ℝ) (n : ℕ) :
    HasDerivAt (fun k => jordanTotient k n)
      ((degD (jordanFun k) + jordanFun k * ArithmeticFunction.vonMangoldt) n) k := by
  have h := hasDerivAt_tateJet 0 n k
  have e : tateJet 0 n = fun k => jordanTotient k n := funext (tateJet_zero n)
  rw [e, tateJet_one_eq] at h
  exact h

/-- **The Tate flow equation on a window**: the velocity of `ρ_A(J_k)` is
`[M, ρ_A(J_k)] + ρ_A(J_k)ρ_A(Λ)`. -/
theorem windowRep_tateVelocity (A k : ℝ) :
    windowRep A (degD (jordanFun k) + jordanFun k * ArithmeticFunction.vonMangoldt) =
      positionOp A * windowRep A (jordanFun k) - windowRep A (jordanFun k) * positionOp A +
        windowRep A (jordanFun k) * windowRep A ArithmeticFunction.vonMangoldt := by
  rw [map_add, map_mul, position_comm_windowRep]
  rfl

/-- **The jet tower on a window**: `ρ_A(Λ_{j+1}) = [M, ρ_A(Λ_j)] + ρ_A(Λ)ρ_A(Λ_j)`. -/
theorem windowRep_genVonMangoldt_succ (A : ℝ) (j : ℕ) :
    windowRep A (genVonMangoldt (j + 1)) =
      positionOp A * windowRep A (genVonMangoldt j) - windowRep A (genVonMangoldt j) * positionOp A +
        windowRep A ArithmeticFunction.vonMangoldt * windowRep A (genVonMangoldt j) := by
  rw [genVonMangoldt_succ, map_add, map_mul, position_comm_windowRep]
  rfl

/-- Selberg's operator: `ρ_A(Λ₂) = [M, ρ_A(Λ)] + ρ_A(Λ)²`. -/
theorem windowRep_genVonMangoldt_two (A : ℝ) :
    windowRep A (genVonMangoldt 2) =
      positionOp A * windowRep A ArithmeticFunction.vonMangoldt -
        windowRep A ArithmeticFunction.vonMangoldt * positionOp A +
          windowRep A ArithmeticFunction.vonMangoldt ^ 2 := by
  rw [windowRep_genVonMangoldt_succ, genVonMangoldt_one, sq]

/-- **Weil's arithmetic operator generates the jet tower**: every subalgebra of window operators
containing the position and `ρ_A(Λ)` contains every jet operator `ρ_A(Λ_j)`. -/
theorem windowRep_genVonMangoldt_mem {A : ℝ} (S : Subalgebra ℝ (Module.End ℝ (windowSupported A)))
    (hM : positionOp A ∈ S) (hΛ : windowRep A ArithmeticFunction.vonMangoldt ∈ S) (j : ℕ) :
    windowRep A (genVonMangoldt j) ∈ S := by
  induction j with
  | zero => rw [genVonMangoldt_zero, map_one]; exact S.one_mem
  | succ j ih =>
    have hsub : ∀ x y : Module.End ℝ (windowSupported A), x ∈ S → y ∈ S → x - y ∈ S :=
      fun x y hx hy => by
        have e : x - y = x + (-1 : ℝ) • y :=
          LinearMap.ext fun v => by simp [sub_eq_add_neg]
        rw [e]
        exact S.add_mem hx (S.smul_mem hy (-1))
    rw [windowRep_genVonMangoldt_succ]
    exact S.add_mem (hsub _ _ (S.mul_mem hM ih) (S.mul_mem ih hM)) (S.mul_mem hΛ ih)

end GaloisForLFunctions.DimensionZeroGeometryOfSpecZ
