import GaloisForLFunctions.BiScaleUncertainty.KreinIncrementAndChordCascade

/-!
# Pillar VI: Non-Commutative Hyperbolic Shift-Commutator & Parity-Intertwining Calculus

This module establishes the first part of **Layer III (Non-Commutative Hyperbolic & Arithmetic-Shear
Calculus)** of **Bi-Scale / Logarithmic-Grid Uncertainty Theory**
(`GaloisForLFunctions.BiScaleUncertainty`).

To overcome **Trap 6 (The Commutative Bochner Trap)** and **Trap 7 (The Odd-Sector / Nodal Blind
Spot)**, we introduce the non-commutative algebra generated by translation shifts `T_x f(u) = f(u + x)`
and the **hyperbolic multipliers**
`(coshMultiplier α f)(u) = cosh(α u) f(u)` and `(sinhMultiplier α f)(u) = sinh(α u) f(u)`.

## Main Results

1. **Hyperbolic Parity Intertwining (`sinhMultiplier_even_of_odd`, `coshMultiplier_odd_of_odd`):**
   If `f` is odd (`f(-u) = -f(u)`), then `sinhMultiplier α f` is **even** (`g(-u) = g(u)`) with
   nonnegative origin energy `autocorr (sinhMultiplier α f) 0 = ∫ (sinh(α u) f(u))^2 du ≥ 0`,
   lifting odd prime-blind states (`OWU` / `HF`) directly into the even sector.
2. **Exact Hyperbolic Shift-Addition & Commutator Laws (`cosh_mul_cosh_shift_sub_sinh_mul_sinh_shift`,
   `sinh_shift_mul_cosh_sub_cosh_shift_mul_sinh`):**
   At every point `u` and shift `x`,
   `cosh(α u) cosh(α(u + x)) - sinh(α u) sinh(α(u + x)) = cosh(α x)` and
   `sinh(α(u + x)) cosh(α u) - cosh(α(u + x)) sinh(α u) = sinh(α x)`.
3. **The Fundamental Hyperbolic Autocorrelation Intertwining Law
   (`autocorr_coshMultiplier_sub_sinhMultiplier`):**
   For every continuous compactly supported `f : ℝ → ℝ` and every `α, x ∈ ℝ`,
   `autocorr (coshMultiplier α f) x - autocorr (sinhMultiplier α f) x = cosh(α x) * autocorr f x`.
4. **Zero-Grid Coincidence & Unconditional `cosh`-Increment Coercivity
   (`autocorr_coshMultiplier_eq_sinhMultiplier_of_zero`, `autocorr_coshMultiplier_sub_ge_of_zero`,
   `autocorr_coshMultiplier_harmonic_subgrid_ge_of_zero`):**
   At every zero node `x₀` where `autocorr f x₀ = 0`, the `cosh`- and `sinh`-autocorrelations
   coincide (`h_{C_α f}(x₀) = h_{S_α f}(x₀)`), while at the origin
   `h_{C_α f}(0) = h_f(0) + h_{S_α f}(0)`. Since `h_{S_α f}(x₀) ≤ h_{S_α f}(0)` by Cauchy–Schwarz,
   every zero node of `f` forces an unconditional lower bound on the `cosh`-weighted increment:
   `autocorr f 0 ≤ autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x₀`,
   and along all harmonic subdivisions `x₀ / m` (`m ≥ 1`):
   `autocorr f 0 / m^2 ≤ autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) (x₀ / m)`.
-/

open MeasureTheory Set Filter Topology
open RHTower.ArchimedeanAnomaly RHTower.ArchimedeanExactForm RHTower.WeilMarkovPole

namespace GaloisForLFunctions.BiScaleUncertainty

noncomputable section

/-! ## §1. Hyperbolic Multiplier Operators & Parity Intertwining -/

/-- The hyperbolic cosine multiplier `(coshMultiplier α f)(u) = cosh(α u) f(u)`. -/
def coshMultiplier (α : ℝ) (f : ℝ → ℝ) (u : ℝ) : ℝ :=
  Real.cosh (α * u) * f u

/-- The hyperbolic sine multiplier `(sinhMultiplier α f)(u) = sinh(α u) f(u)`. -/
def sinhMultiplier (α : ℝ) (f : ℝ → ℝ) (u : ℝ) : ℝ :=
  Real.sinh (α * u) * f u

theorem continuous_coshMultiplier {f : ℝ → ℝ} (α : ℝ) (hf : Continuous f) :
    Continuous (coshMultiplier α f) :=
  (Real.continuous_cosh.comp (continuous_const.mul continuous_id)).mul hf

theorem continuous_sinhMultiplier {f : ℝ → ℝ} (α : ℝ) (hf : Continuous f) :
    Continuous (sinhMultiplier α f) :=
  (Real.continuous_sinh.comp (continuous_const.mul continuous_id)).mul hf

theorem hasCompactSupport_coshMultiplier {f : ℝ → ℝ} (α : ℝ) (hfc : HasCompactSupport f) :
    HasCompactSupport (coshMultiplier α f) :=
  hfc.mul_left

theorem hasCompactSupport_sinhMultiplier {f : ℝ → ℝ} (α : ℝ) (hfc : HasCompactSupport f) :
    HasCompactSupport (sinhMultiplier α f) :=
  hfc.mul_left

/-- **Odd-to-Even Parity Intertwining (`sinhMultiplier`):**
If `f` is an odd function (`f(-u) = -f(u)`), then `sinhMultiplier α f` is an **even** function. -/
theorem sinhMultiplier_even_of_odd {f : ℝ → ℝ} (α : ℝ) (hodd : ∀ u : ℝ, f (-u) = -f u) (u : ℝ) :
    sinhMultiplier α f (-u) = sinhMultiplier α f u := by
  unfold sinhMultiplier
  rw [mul_neg, Real.sinh_neg, hodd u, neg_mul_neg]

/-- **Odd-to-Odd Parity Preservation (`coshMultiplier`):**
If `f` is an odd function (`f(-u) = -f(u)`), then `coshMultiplier α f` is an **odd** function. -/
theorem coshMultiplier_odd_of_odd {f : ℝ → ℝ} (α : ℝ) (hodd : ∀ u : ℝ, f (-u) = -f u) (u : ℝ) :
    coshMultiplier α f (-u) = -coshMultiplier α f u := by
  unfold coshMultiplier
  rw [mul_neg, Real.cosh_neg, hodd u, mul_neg]

/-- **Even-to-Odd Parity Intertwining (`sinhMultiplier`):**
If `f` is an even function (`f(-u) = f(u)`), then `sinhMultiplier α f` is an **odd** function. -/
theorem sinhMultiplier_odd_of_even {f : ℝ → ℝ} (α : ℝ) (heven : ∀ u : ℝ, f (-u) = f u) (u : ℝ) :
    sinhMultiplier α f (-u) = -sinhMultiplier α f u := by
  unfold sinhMultiplier
  rw [mul_neg, Real.sinh_neg, heven u, neg_mul]

/-- **Even-to-Even Parity Preservation (`coshMultiplier`):**
If `f` is an even function (`f(-u) = f(u)`), then `coshMultiplier α f` is an **even** function. -/
theorem coshMultiplier_even_of_even {f : ℝ → ℝ} (α : ℝ) (heven : ∀ u : ℝ, f (-u) = f u) (u : ℝ) :
    coshMultiplier α f (-u) = coshMultiplier α f u := by
  unfold coshMultiplier
  rw [mul_neg, Real.cosh_neg, heven u]

/-! ## §2. Pointwise Hyperbolic Shift-Addition & Commutator Identities -/

/-- **Pointwise Hyperbolic Shift-Difference Identity:**
`cosh(α u) cosh(α(u + x)) - sinh(α u) sinh(α(u + x)) = cosh(α x)`, independent of `u`. -/
theorem cosh_mul_cosh_shift_sub_sinh_mul_sinh_shift (α u x : ℝ) :
    Real.cosh (α * u) * Real.cosh (α * (u + x)) -
        Real.sinh (α * u) * Real.sinh (α * (u + x)) =
      Real.cosh (α * x) := by
  rw [Real.cosh_eq, Real.cosh_eq, Real.sinh_eq, Real.sinh_eq, Real.cosh_eq]
  have h1 : α * (u + x) = α * u + α * x := by ring
  have h2 : -(α * (u + x)) = -(α * u) + -(α * x) := by ring
  rw [h2, h1, Real.exp_add, Real.exp_add]
  have hexp : Real.exp (α * u) * Real.exp (-(α * u)) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  linear_combination (Real.exp (α * x) + Real.exp (-(α * x))) / 2 * hexp

/-- **Pointwise Hyperbolic Shift-Commutator Identity:**
`sinh(α(u + x)) cosh(α u) - cosh(α(u + x)) sinh(α u) = sinh(α x)`, independent of `u`. -/
theorem sinh_shift_mul_cosh_sub_cosh_shift_mul_sinh (α u x : ℝ) :
    Real.sinh (α * (u + x)) * Real.cosh (α * u) -
        Real.cosh (α * (u + x)) * Real.sinh (α * u) =
      Real.sinh (α * x) := by
  rw [Real.sinh_eq, Real.cosh_eq, Real.cosh_eq, Real.sinh_eq, Real.sinh_eq]
  have h1 : α * (u + x) = α * u + α * x := by ring
  have h2 : -(α * (u + x)) = -(α * u) + -(α * x) := by ring
  rw [h2, h1, Real.exp_add, Real.exp_add]
  have hexp : Real.exp (α * u) * Real.exp (-(α * u)) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  linear_combination (Real.exp (α * x) - Real.exp (-(α * x))) / 2 * hexp

/-- **Hyperbolic Half-Angle Increment Identity:**
`cosh(α x) - 1 = 2 * sinh(α x / 2)^2`. -/
theorem cosh_sub_one_eq_two_mul_sinh_half_sq (α x : ℝ) :
    Real.cosh (α * x) - 1 = 2 * Real.sinh (α * x / 2) ^ 2 := by
  set t := α * x / 2
  have ht2 : -(α * x) = -t + -t := by dsimp [t]; ring
  have ht1 : α * x = t + t := by dsimp [t]; ring
  rw [Real.cosh_eq, Real.sinh_eq, ht2, ht1, Real.exp_add, Real.exp_add]
  have hexp : Real.exp t * Real.exp (-t) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  linear_combination -hexp

/-- **Pointwise Pythagorean Relation Between `coshMultiplier` and `sinhMultiplier`:**
At every point `u ∈ ℝ`, `(coshMultiplier α f u)^2 - (sinhMultiplier α f u)^2 = f(u)^2`. -/
theorem coshMultiplier_sq_sub_sinhMultiplier_sq (α : ℝ) (f : ℝ → ℝ) (u : ℝ) :
    coshMultiplier α f u ^ 2 - sinhMultiplier α f u ^ 2 = f u ^ 2 := by
  unfold coshMultiplier sinhMultiplier
  have h := cosh_mul_cosh_shift_sub_sinh_mul_sinh_shift α u 0
  simp only [add_zero, mul_zero, Real.cosh_zero] at h
  calc
    (Real.cosh (α * u) * f u) ^ 2 - (Real.sinh (α * u) * f u) ^ 2
        = (Real.cosh (α * u) * Real.cosh (α * u) -
            Real.sinh (α * u) * Real.sinh (α * u)) * f u ^ 2 := by ring
    _ = 1 * f u ^ 2 := by rw [h]
    _ = f u ^ 2 := one_mul _

/-! ## §3. The Fundamental Hyperbolic Autocorrelation Intertwining Law -/

/-- **The Fundamental Hyperbolic Autocorrelation Intertwining Law:**
For any continuous compactly supported function `f : ℝ → ℝ`, scale parameter `α ∈ ℝ`, and shift
`x ∈ ℝ`,
`autocorr (coshMultiplier α f) x - autocorr (sinhMultiplier α f) x = cosh(α x) * autocorr f x`. -/
theorem autocorr_coshMultiplier_sub_sinhMultiplier {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α x : ℝ) :
    autocorr (coshMultiplier α f) x - autocorr (sinhMultiplier α f) x =
      Real.cosh (α * x) * autocorr f x := by
  have hcont_c := continuous_coshMultiplier α hf
  have hsupp_c := hasCompactSupport_coshMultiplier α hfc
  have hcont_s := continuous_sinhMultiplier α hf
  have hsupp_s := hasCompactSupport_sinhMultiplier α hfc
  have hint_c : Integrable (fun u => coshMultiplier α f u * coshMultiplier α f (u + x)) :=
    integrable_mul_shift hcont_c hsupp_c x
  have hint_s : Integrable (fun u => sinhMultiplier α f u * sinhMultiplier α f (u + x)) :=
    integrable_mul_shift hcont_s hsupp_s x
  unfold autocorr
  rw [← integral_sub hint_c hint_s, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  unfold coshMultiplier sinhMultiplier
  have hpt := cosh_mul_cosh_shift_sub_sinh_mul_sinh_shift α u x
  calc
    Real.cosh (α * u) * f u * (Real.cosh (α * (u + x)) * f (u + x)) -
        Real.sinh (α * u) * f u * (Real.sinh (α * (u + x)) * f (u + x))
        = (Real.cosh (α * u) * Real.cosh (α * (u + x)) -
            Real.sinh (α * u) * Real.sinh (α * (u + x))) * (f u * f (u + x)) := by ring
    _ = Real.cosh (α * x) * (f u * f (u + x)) := by rw [hpt]

/-- **Origin Energy Decomposition Under Hyperbolic Multipliers:**
At `x = 0`, `autocorr (coshMultiplier α f) 0 = autocorr f 0 + autocorr (sinhMultiplier α f) 0`. -/
theorem autocorr_coshMultiplier_zero_eq {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α : ℝ) :
    autocorr (coshMultiplier α f) 0 =
      autocorr f 0 + autocorr (sinhMultiplier α f) 0 := by
  have h := autocorr_coshMultiplier_sub_sinhMultiplier hf hfc α 0
  simp only [mul_zero, Real.cosh_zero, one_mul] at h
  linarith

/-- **Zero-Grid Coincidence of `coshMultiplier` and `sinhMultiplier` Autocorrelations:**
At every zero node `x₀` where `autocorr f x₀ = 0`, the autocorrelations of `coshMultiplier α f`
and `sinhMultiplier α f` coincide exactly:
`autocorr (coshMultiplier α f) x₀ = autocorr (sinhMultiplier α f) x₀`. -/
theorem autocorr_coshMultiplier_eq_sinhMultiplier_of_zero {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α : ℝ) {x₀ : ℝ}
    (hz : autocorr f x₀ = 0) :
    autocorr (coshMultiplier α f) x₀ = autocorr (sinhMultiplier α f) x₀ := by
  have h := autocorr_coshMultiplier_sub_sinhMultiplier hf hfc α x₀
  rw [hz, mul_zero] at h
  linarith

/-- **Exact Hyperbolic Increment Decomposition:**
For every `α, x ∈ ℝ`, the difference between the `cosh`-weighted and `sinh`-weighted
autocorrelation increments from `0` to `x` equals
`(autocorr f 0 - autocorr f x) - 2 * sinh(α x / 2)^2 * autocorr f x`. -/
theorem autocorr_coshMultiplier_sub_decomp {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α x : ℝ) :
    (autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x) -
        (autocorr (sinhMultiplier α f) 0 - autocorr (sinhMultiplier α f) x) =
      (autocorr f 0 - autocorr f x) - 2 * Real.sinh (α * x / 2) ^ 2 * autocorr f x := by
  have h0 := autocorr_coshMultiplier_zero_eq hf hfc α
  have hx := autocorr_coshMultiplier_sub_sinhMultiplier hf hfc α x
  have hcosh := cosh_sub_one_eq_two_mul_sinh_half_sq α x
  linear_combination h0 - hx - autocorr f x * hcosh

/-! ## §4. Unconditional `cosh`-Increment Coercivity at Zero Nodes & Harmonic Sub-Grids -/

/-- **Unconditional `cosh`-Increment Coercivity at Any Zero or Nonpositive Node:**
Whenever `autocorr f x₀ ≤ 0` (in particular, at any grid zero `autocorr f x₀ = 0`), the
`cosh`-weighted autocorrelation increment from `0` to `x₀` is bounded below by the full unweighted
origin energy `autocorr f 0`:
`autocorr f 0 ≤ autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x₀`. -/
theorem autocorr_coshMultiplier_sub_ge_of_nonpos {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α : ℝ) {x₀ : ℝ}
    (hx₀ : autocorr f x₀ ≤ 0) :
    autocorr f 0 ≤
      autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x₀ := by
  have h0 := autocorr_coshMultiplier_zero_eq hf hfc α
  have hx := autocorr_coshMultiplier_sub_sinhMultiplier hf hfc α x₀
  have hsinh_nonneg :
      0 ≤ autocorr (sinhMultiplier α f) 0 - autocorr (sinhMultiplier α f) x₀ :=
    autocorr_sub_nonneg (hasCompactSupport_sinhMultiplier α hfc)
      (continuous_sinhMultiplier α hf) x₀
  have hcosh_nonpos : Real.cosh (α * x₀) * autocorr f x₀ ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (Real.cosh_pos _).le hx₀
  linarith

/-- Specialization of `autocorr_coshMultiplier_sub_ge_of_nonpos` to a zero node
`autocorr f x₀ = 0`. -/
theorem autocorr_coshMultiplier_sub_ge_of_zero {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α : ℝ) {x₀ : ℝ}
    (hz : autocorr f x₀ = 0) :
    autocorr f 0 ≤
      autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x₀ :=
  autocorr_coshMultiplier_sub_ge_of_nonpos hf hfc α (le_of_eq hz)

/-- **Harmonic Sub-Grid Lower Bound for the `cosh`-Weighted State:**
Whenever `autocorr f x₀ ≤ 0` and `m ≥ 1`, every harmonic subdivision `x₀ / m` satisfies:
`autocorr f 0 / (m : ℝ)^2 ≤ autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) (x₀ / m)`. -/
theorem autocorr_coshMultiplier_harmonic_subgrid_ge_of_nonpos {f : ℝ → ℝ}
    (hf : Continuous f) (hfc : HasCompactSupport f) (α : ℝ) {x₀ : ℝ}
    (hx₀ : autocorr f x₀ ≤ 0) {m : ℕ} (hm : 1 ≤ m) :
    autocorr f 0 / (m : ℝ) ^ 2 ≤
      autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) (x₀ / (m : ℝ)) := by
  have hcont_c := continuous_coshMultiplier α hf
  have hsupp_c := hasCompactSupport_coshMultiplier α hfc
  have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero (by omega))
  have hm_sq_pos : (0 : ℝ) < (m : ℝ) ^ 2 := sq_pos_of_pos hm_pos
  have hcasc :
      autocorr (coshMultiplier α f) 0 - autocorr (coshMultiplier α f) x₀ ≤
        (m : ℝ) ^ 2 *
          (autocorr (coshMultiplier α f) 0 -
            autocorr (coshMultiplier α f) (x₀ / (m : ℝ))) := by
    have hmul := autocorr_sub_nat_mul_le hsupp_c hcont_c m (x₀ / (m : ℝ))
    have hdiv : (m : ℝ) * (x₀ / (m : ℝ)) = x₀ := mul_div_cancel₀ x₀ (ne_of_gt hm_pos)
    rwa [hdiv] at hmul
  have hbase := autocorr_coshMultiplier_sub_ge_of_nonpos hf hfc α hx₀
  rw [div_le_iff₀ hm_sq_pos, mul_comm]
  linarith

end

end GaloisForLFunctions.BiScaleUncertainty
