import GaloisForLFunctions.BiScaleUncertainty.PrimePowerDeletionPairThreshold

/-!
# The Euler price is attained exactly past the length `log Π m_p`

Delete one prime power `m_p = p^{e(p)}` for every prime of a finite set `P` from the prime-power blind
cone. The Euler price `Σ_{p∈P} w(m_p)` is attained on windows longer than `log Π_p m_p` by the
iterated pairs (`PrimeTwoThreeDecouplingLength`).

**Theorem** (`eulerPrice_mem_eulerWindowDeviations_iff_of_primes`). For every finite set of
primes and exponents `≥ 1`, the Euler price is a window deviation of length `L` iff
`L > log Π_{p∈P} p^{e(p)}`. Every extremal is an iterated pair `g ∗ Π_p (δ₀ + δ_{log m_p})`: it
needs room for every deleted node at once, and its lags contain every composite `m_A`, `|A| ≥ 2`.

**Mechanism.** At the price every node is extreme (`all_nodes_extreme`), so the alternating
periodization of every test vanishes along every `log m_p` (`PrimePowerDeletionPeriodizationDefect`).
Peel one prime: `f = g + g(· − ℓ₁)` with `g` shorter by `ℓ₁`. Along any other `ℓ` the periodization
`ψ` of `g` is antiperiodic under both `ℓ` and `ℓ₁`, hence invariant under the index-two subgroup
generated by `ℓ₁ − ℓ` and `2ℓ₁`, which is dense; so `ψ` is constant, and antiperiodicity makes it
zero (`eq_zero_of_two_antiperiods`). Thus `g` is again extremal for the remaining primes, and induction
on `P` (`eq_zero_of_periodizations`) shows that a test shorter than `Σ_p log m_p` vanishes.
-/

open MeasureTheory Set Complex Finsupp Filter Topology
open Zeta23
open RHTower RHTower.WeilOneSided
open scoped ComplexConjugate

namespace GaloisForLFunctions.BiScaleUncertainty

noncomputable section

/-! ### 1. Two antiperiods force zero -/

/-- **A continuous function antiperiodic under two incommensurable periods vanishes.** -/
theorem eq_zero_of_two_antiperiods {ψ : ℝ → ℂ} (hψ : Continuous ψ) {ℓ₁ ℓ₂ : ℝ} (hℓ₁ : ℓ₁ ≠ 0)
    (hirr : Irrational (ℓ₁ / ℓ₂)) (h₁ : ∀ x, ψ (x + ℓ₁) = -ψ x) (h₂ : ∀ x, ψ (x + ℓ₂) = -ψ x)
    (x : ℝ) : ψ x = 0 := by
  set H := AddSubgroup.closure ({ℓ₁ - ℓ₂, 2 * ℓ₁} : Set ℝ)
  have hinv : ∀ h ∈ H, ∀ y, ψ (y + h) = ψ y := by
    intro h hh
    induction hh using AddSubgroup.closure_induction with
    | mem z hz =>
      intro y
      rcases hz with rfl | hz
      · have := h₂ (y + (ℓ₁ - ℓ₂))
        rw [show y + (ℓ₁ - ℓ₂) + ℓ₂ = y + ℓ₁ by ring, h₁] at this
        linear_combination this
      · rw [Set.mem_singleton_iff] at hz; subst hz
        rw [show y + 2 * ℓ₁ = y + ℓ₁ + ℓ₁ by ring, h₁, h₁, neg_neg]
    | zero => intro y; rw [add_zero]
    | add z w _ _ hz hw => intro y; rw [← add_assoc, hw, hz]
    | neg z _ hz => intro y; rw [← hz (y + -z), neg_add_cancel_right]
  have hirr' : Irrational ((ℓ₁ - ℓ₂) / (2 * ℓ₁)) := by
    have hrw : (ℓ₁ - ℓ₂) / (2 * ℓ₁) = 1 / 2 - (ℓ₁ / ℓ₂)⁻¹ / 2 := by
      by_cases hℓ₂ : ℓ₂ = 0
      · exfalso; rw [hℓ₂, div_zero] at hirr; exact hirr.ne_zero rfl
      · field_simp
    rw [hrw]
    have h := (hirr.inv.div_natCast (by norm_num : (2 : ℕ) ≠ 0)).ratCast_sub (1 / 2)
    push_cast at h
    exact h
  have hdense : Dense (H : Set ℝ) := dense_addSubgroupClosure_pair_iff.mpr hirr'
  -- `ψ` is constant
  have hconst : ∀ y, ψ y = ψ 0 := by
    have hext : (fun h : ℝ => ψ (0 + h)) = fun _ => ψ 0 :=
      Continuous.ext_on hdense (hψ.comp (continuous_const.add continuous_id)) continuous_const
        fun h hh => by rw [hinv h hh]
    intro y
    have := congrFun hext y
    simpa using this
  have h0 : ψ 0 = 0 := by
    have := h₁ 0
    rw [zero_add, hconst ℓ₁] at this
    have h2 : (2 : ℂ) * ψ 0 = 0 := by linear_combination this
    simpa using h2
  rw [hconst x, h0]

/-! ### 2. Peeling one prime -/

/-- The `(−1)`-periodization of a pair `g + g(· − ℓ₁)` along `ℓ`, when it vanishes, forces the
periodization of `g` along `ℓ` to vanish. -/
theorem altPer_eq_zero_of_pair {g : ℝ → ℂ} (hg : Continuous g) {a b ℓ ℓ₁ : ℝ} (hℓ : 0 < ℓ)
    (hℓ₁ : ℓ₁ ≠ 0) (hsupp : ∀ u, g u ≠ 0 → u ∈ Ioo a b) (hirr : Irrational (ℓ₁ / ℓ))
    (hrel : ∀ x, altPer ℓ (-1) (fun y => g y + g (y - ℓ₁)) x = 0) (x : ℝ) :
    altPer ℓ (-1) g x = 0 := by
  have hsupp' : ∀ u, g (u - ℓ₁) ≠ 0 → u ∈ Ioo (a + ℓ₁) (b + ℓ₁) := fun u hu => by
    have := hsupp _ hu; exact ⟨by linarith [this.1], by linarith [this.2]⟩
  set ψ := altPer ℓ (-1) g
  have hψc : Continuous ψ := continuous_altPer hℓ hsupp hg
  have hsplit : ∀ x, altPer ℓ (-1) (fun y => g y + g (y - ℓ₁)) x = ψ x + ψ (x - ℓ₁) := by
    intro x
    have := altPer_sub (σ := -1) hℓ hsupp hsupp' (-1 : ℂ) x
    simp only [neg_one_mul, sub_neg_eq_add] at this
    rw [this, altPer_shift]
  have h₁ : ∀ x, ψ (x + ℓ₁) = -ψ x := fun x => by
    have := hrel (x + ℓ₁)
    rw [hsplit, add_sub_cancel_right] at this
    linear_combination this
  have h₂ : ∀ x, ψ (x + ℓ) = -ψ x := fun x => by
    have := altPer_add_int_mul (g := g) (ℓ := ℓ) (σ := -1) (by norm_num) x 1
    simp only [Int.cast_one, one_mul] at this
    change altPer ℓ (-1) g (x + ℓ) = -altPer ℓ (-1) g x
    rw [this]
    norm_num
  exact eq_zero_of_two_antiperiods hψc hℓ₁ hirr h₁ h₂ x

/-! ### 3. The induction over the deleted primes -/

/-- **Vanishing periodizations along many incommensurable lags force a long support.** Let
`ℓ : ℕ → ℝ` be positive on `P`, with irrational pairwise ratios. If `f` is continuous, supported in
`(a, a + L)` with `L ≤ Σ_{p∈P} ℓ_p`, and its `(−1)`-periodization along every `ℓ_p` vanishes, then
`f = 0`. -/
theorem eq_zero_of_periodizations (P : Finset ℕ) (ℓ : ℕ → ℝ) (hℓ : ∀ p ∈ P, 0 < ℓ p)
    (hirr : ∀ p ∈ P, ∀ q ∈ P, p ≠ q → Irrational (ℓ p / ℓ q)) :
    ∀ (f : ℝ → ℂ), Continuous f → ∀ (a L : ℝ), (∀ u, f u ≠ 0 → u ∈ Ioo a (a + L)) →
      L ≤ ∑ p ∈ P, ℓ p → (∀ p ∈ P, ∀ x, altPer (ℓ p) (-1) f x = 0) → ∀ u, f u = 0 := by
  classical
  induction P using Finset.induction_on with
  | empty =>
    intro f _ a L hsupp hL _ u
    by_contra h
    have := hsupp u h
    simp only [Finset.sum_empty] at hL
    linarith [this.1, this.2]
  | insert p₁ P hp₁ ih =>
    intro f hf a L hsupp hL hper u
    have hℓ₁ : 0 < ℓ p₁ := hℓ p₁ (Finset.mem_insert_self _ _)
    rw [Finset.sum_insert hp₁] at hL
    -- the periodization along `ℓ₁` vanishes on one period: `f` is a pair
    obtain ⟨K, hK, hLK⟩ := exists_period_count (L := L) hℓ₁
    have hS : ∀ v ∈ Icc a (a + ℓ p₁), stepSum (ℓ p₁) (-1) K f v = 0 := fun v hv => by
      rw [stepSum_eq_altPer hℓ₁ hsupp hLK hv]
      exact hper p₁ (Finset.mem_insert_self _ _) v
    obtain ⟨g, hg, hgs, hgf⟩ := pair_structure_of_stepSum_eq_zero hf (σ := -1) (by norm_num) hℓ₁ hsupp
      hLK hS
    have hgf' : ∀ y, f y = g y + g (y - ℓ p₁) := fun y => by rw [hgf y]; push_cast; ring
    have hgs' : ∀ v, g v ≠ 0 → v ∈ Ioo a (a + (L - ℓ p₁)) := fun v hv => by
      have := hgs v hv; rwa [← add_sub_assoc]
    -- every other periodization of `g` vanishes
    have hperg : ∀ q ∈ P, ∀ x, altPer (ℓ q) (-1) g x = 0 := by
      intro q hq x
      have hqne : q ≠ p₁ := fun h => hp₁ (h ▸ hq)
      have hrel : ∀ x, altPer (ℓ q) (-1) (fun y => g y + g (y - ℓ p₁)) x = 0 := fun x => by
        rw [show (fun y => g y + g (y - ℓ p₁)) = f from funext fun y => (hgf' y).symm]
        exact hper q (Finset.mem_insert_of_mem hq) x
      exact altPer_eq_zero_of_pair hg (hℓ q (Finset.mem_insert_of_mem hq)) hℓ₁.ne' hgs'
        (hirr p₁ (Finset.mem_insert_self _ _) q (Finset.mem_insert_of_mem hq) (Ne.symm hqne)) hrel x
    have hgz := ih (fun p hp => hℓ p (Finset.mem_insert_of_mem hp))
      (fun p hp q hq hpq => hirr p (Finset.mem_insert_of_mem hp) q (Finset.mem_insert_of_mem hq) hpq)
      g hg a (L - ℓ p₁) hgs' (by linarith) hperg
    rw [hgf' u, hgz u, hgz (u - ℓ p₁), add_zero]

/-! ### 4. The threshold -/

/-- **At the Euler price every node is extreme.** -/
theorem all_nodes_extreme {c : WeilTestFn →₀ ℝ} (hc : ∀ f, 0 ≤ c f) {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {e : ℕ → ℕ} (he : ∀ p ∈ P, 1 ≤ e p)
    (hb : BlindOn (primePowerNodes \ ↑(eulerNodes P e)) c)
    (hext : nodeArchEnergy c - weilEnergy c = eulerPrice P e * massOf c) :
    ∀ p ∈ P, ∀ (h2 : 2 ≤ p ^ e p),
      massOf c + (-1) * (Real.sqrt ((p ^ e p : ℕ) : ℝ) * nodeVector c ⟨p ^ e p, h2⟩) = 0 := by
  classical
  set M := massOf c
  have hbound : ∀ p ∈ P, ∀ (h2 : 2 ≤ p ^ e p),
      Real.sqrt ((p ^ e p : ℕ) : ℝ) * nodeVector c ⟨p ^ e p, h2⟩ ≤ M := by
    intro p hp h2
    have h := abs_nodeVector_le_massOf_div_sqrt hc h2 fun j ⟨k, hk, hj⟩ =>
      hb j (hj ▸ pow_mem_primePowerNodes_diff_eulerNodes hP he hp hk)
    have hs : 0 < Real.sqrt ((p ^ e p : ℕ) : ℝ) := Real.sqrt_pos.mpr (by positivity)
    rw [le_div_iff₀ hs] at h
    nlinarith [le_abs_self (nodeVector c ⟨p ^ e p, h2⟩)]
  -- the deviation identity
  have hid : nodeArchEnergy c - weilEnergy c =
      ∑ p ∈ P, (ArithmeticFunction.vonMangoldt (p ^ e p) : ℝ) * nodeAt c (p ^ e p) := by
    rw [nodeArchEnergy_eq_weilEnergy_add_finset _ hb, add_sub_cancel_left, eulerNodes,
      Finset.sum_image (injOn_eulerNodes hP he)]
  rw [hid, eulerPrice, Finset.sum_mul] at hext
  -- each term `w_p (M − √m_p N_p)` is nonnegative and they sum to zero
  set D : ℕ → ℝ := fun p => ArithmeticFunction.vonMangoldt (p ^ e p) / Real.sqrt ((p ^ e p : ℕ) : ℝ) *
    (M - Real.sqrt ((p ^ e p : ℕ) : ℝ) * nodeAt c (p ^ e p)) with hD
  have hDnn : ∀ p ∈ P, 0 ≤ D p := by
    intro p hp
    have h2 := two_le_pow hP he hp
    have := hbound p hp h2
    rw [hD]; simp only
    rw [nodeAt, dif_pos h2]
    exact mul_nonneg (div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _))
      (by linarith)
  have hDsum : ∑ p ∈ P, D p = 0 := by
    have hrw : ∑ p ∈ P, D p = ∑ p ∈ P, ArithmeticFunction.vonMangoldt (p ^ e p) /
        Real.sqrt ((p ^ e p : ℕ) : ℝ) * M -
        ∑ p ∈ P, (ArithmeticFunction.vonMangoldt (p ^ e p) : ℝ) * nodeAt c (p ^ e p) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun p hp => ?_
      have hs : 0 < Real.sqrt ((p ^ e p : ℕ) : ℝ) :=
        Real.sqrt_pos.mpr (by exact_mod_cast (show 0 < p ^ e p by have := two_le_pow hP he hp; omega))
      rw [hD]; field_simp
    rw [hrw, hext]; ring
  intro p hp h2
  have hzero := (Finset.sum_eq_zero_iff_of_nonneg hDnn).mp hDsum p hp
  have hΛ : 0 < (ArithmeticFunction.vonMangoldt (p ^ e p) : ℝ) := by
    rw [ArithmeticFunction.vonMangoldt_apply_pow (by have := he p hp; omega),
      ArithmeticFunction.vonMangoldt_apply_prime (hP p hp)]
    exact Real.log_pos (by exact_mod_cast (hP p hp).one_lt)
  have hs : 0 < Real.sqrt ((p ^ e p : ℕ) : ℝ) := Real.sqrt_pos.mpr (by positivity)
  rw [hD] at hzero; simp only at hzero
  rw [nodeAt, dif_pos h2] at hzero
  rcases mul_eq_zero.mp hzero with h | h
  · exact absurd h (div_pos hΛ hs).ne'
  · linarith

/-- **The Euler price is a window deviation of length `L` iff `L > log Π_{p∈P} p^{e(p)}`.** -/
theorem eulerPrice_mem_eulerWindowDeviations_iff_of_primes {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    {e : ℕ → ℕ} (he : ∀ p ∈ P, 1 ≤ e p) (L : ℝ) :
    eulerPrice P e ∈ eulerWindowDeviations P e L ↔ Real.log (subProd e P : ℝ) < L := by
  classical
  constructor
  · rintro ⟨c, hc, hb, hw, hpos, hx⟩
    by_contra hL
    push Not at hL
    have hext : nodeArchEnergy c - weilEnergy c = eulerPrice P e * massOf c := by
      rw [hx, div_mul_cancel₀ _ hpos.ne']
    have hnodes := all_nodes_extreme hc hP he hb hext
    choose! a ha using hw
    set ℓ : ℕ → ℝ := fun p => Real.log ((p ^ e p : ℕ) : ℝ) with hℓdef
    have hℓ : ∀ p ∈ P, 0 < ℓ p := fun p hp =>
      Real.log_pos (by exact_mod_cast (two_le_pow hP he hp).trans_lt' (by norm_num))
    have hirr : ∀ p ∈ P, ∀ q ∈ P, p ≠ q → Irrational (ℓ p / ℓ q) := fun p hp q hq hpq =>
      irrational_log_div_log (hP p hp) (hP q hq) hpq (he p hp) (he q hq)
    have hlog : Real.log (subProd e P : ℝ) = ∑ p ∈ P, ℓ p := by
      rw [subProd]; push_cast
      rw [Real.log_prod (fun p hp => by
        exact_mod_cast (pow_pos (hP p hp).pos (e p)).ne')]
      exact Finset.sum_congr rfl fun p _ => by simp [hℓdef]
    -- every test vanishes
    have hzero : ∀ f ∈ c.support, ∀ u, f.1 u = 0 := by
      intro f hf
      refine eq_zero_of_periodizations P ℓ hℓ hirr f.1 f.2.1.continuous (a f) L (ha f hf)
        (by rw [← hlog]; exact hL) fun p hp x => ?_
      have h2 := two_le_pow hP he hp
      have hℓp := hℓ p hp
      obtain ⟨K, hK, hLK⟩ := exists_period_count (L := L) hℓp
      have hbp : ∀ j : LogIndex, (∃ k : ℕ, 2 ≤ k ∧ (j : ℕ) = (p ^ e p) ^ k) → nodeVector c j = 0 :=
        fun j ⟨k, hk, hj⟩ => hb j (hj ▸ pow_mem_primePowerNodes_diff_eulerNodes hP he hp hk)
      have hz := stepSum_eq_zero_of_extremal hc h2 hbp ha hK hLK (σ := -1) (by norm_num)
        (hnodes p hp h2) f hf
      exact altPer_eq_zero_of_period hℓp (by norm_num) (fun v hv => by
        rw [← stepSum_eq_altPer hℓp (ha f hf) hLK hv]; exact hz v hv) x
    have hmass : massOf c = 0 := by
      rw [show massOf c = c.sum fun f t => t * ∫ x, ‖f.1 x‖ ^ 2 from rfl, Finsupp.sum]
      refine Finset.sum_eq_zero fun f hf => ?_
      simp [hzero f hf]
    exact absurd hmass hpos.ne'
  · intro hL
    simpa using deviation_mem_eulerWindowDeviations hP he hL (s := 1) (by norm_num)

end

end GaloisForLFunctions.BiScaleUncertainty
