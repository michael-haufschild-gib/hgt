import Mathlib.Analysis.Complex.CauchyIntegral
import Mathlib.Analysis.Complex.LocallyUniformLimit
import Mathlib.Analysis.Normed.Group.Tannery
import Mathlib.Analysis.SpecialFunctions.Integrals.Basic
import Mathlib.Analysis.SpecificLimits.Normed
import Mathlib.MeasureTheory.Integral.DominatedConvergence

/-!
# The inverse of an exponential polynomial expands where it is bounded below

Let `P(w) = 1 + Σ_k c_k e^{−ℓ_k w}` with finitely many real frequencies `ℓ_k > 0`. Far to the right
`1/P = Σ_J β_J e^{−x_J w}` over the words `J` in the frequencies, with `x_J` the sum of the letters.
If `P` is bounded below on the closed half-planes right of `θ`, then after merging equal exponents
the series converges absolutely on every line `Re w = σ > θ`.

* `hasSum_inv_expPoly_words`: the expansion over words where `Σ ‖c_k‖ e^{−ℓ_k Re w} < 1`.
* `norm_wordCoeff_le`: the total coefficient `μ(x)` at an exponent `x` is the mean of
  `e^{x(c₀ + it)}/P(c₀ + it)` over `t`; by Cauchy's theorem on a rectangle the line `c₀` may be
  replaced by any line `σ` on which `‖P‖ ≥ δ`: `‖μ(x)‖ ≤ e^{σx}/δ`.
* `summable_exp_neg_monoid`: the exponents lie in the additive monoid generated by the
  frequencies, which is sparse: `Σ_x e^{−εx} < ∞` over its elements.
* `hasSum_inv_expPoly`: `1/P(w) = Σ_x μ(x) e^{−xw}` on `Re w > θ`, with
  `Σ_x ‖μ(x)‖ e^{−σx} < ∞` for every `σ > θ`.
-/

open Complex Filter Topology Set Metric MeasureTheory

noncomputable section

namespace GaloisForLFunctions.InfiniteRankPurityTheory

variable {τ : Type*} [Fintype τ]

/-! ### Exponential polynomials and their twists -/

/-- `P(w) = 1 + Σ_k c_k e^{−ℓ_k w}`. -/
def expPoly (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) : ℂ := 1 + ∑ k, c k * cexp (-(ℓ k : ℂ) * w)

/-- The derivative `P'(w) = −Σ_k c_k ℓ_k e^{−ℓ_k w}`. -/
def expPolyDeriv (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) : ℂ :=
  ∑ k, c k * (-(ℓ k : ℂ)) * cexp (-(ℓ k : ℂ) * w)

theorem re_neg_ofReal_mul (x : ℝ) (w : ℂ) : (-(x : ℂ) * w).re = -(x * w.re) := by
  rw [neg_mul, Complex.neg_re, Complex.re_ofReal_mul]

theorem norm_cexp_neg_ofReal_mul (x : ℝ) (w : ℂ) :
    ‖cexp (-(x : ℂ) * w)‖ = Real.exp (-(x * w.re)) := by
  rw [Complex.norm_exp, re_neg_ofReal_mul]

theorem hasDerivAt_expPoly (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    HasDerivAt (expPoly c ℓ) (expPolyDeriv c ℓ w) w := by
  unfold expPoly expPolyDeriv
  refine (HasDerivAt.fun_sum fun k _ => ?_).const_add 1
  have h : HasDerivAt (fun w : ℂ => cexp (-(ℓ k : ℂ) * w))
      (cexp (-(ℓ k : ℂ) * w) * (-(ℓ k : ℂ))) w := by
    simpa using ((hasDerivAt_id w).const_mul (-(ℓ k : ℂ))).cexp
  exact (h.const_mul (c k)).congr_deriv (by ring)

theorem differentiable_expPoly (c : τ → ℂ) (ℓ : τ → ℝ) : Differentiable ℂ (expPoly c ℓ) :=
  fun w => (hasDerivAt_expPoly c ℓ w).differentiableAt

theorem differentiable_expPolyDeriv (c : τ → ℂ) (ℓ : τ → ℝ) :
    Differentiable ℂ (expPolyDeriv c ℓ) := by
  intro w
  refine DifferentiableAt.fun_sum fun k _ => ?_
  exact ((differentiableAt_id.const_mul (-(ℓ k : ℂ))).cexp).const_mul _

/-- A vertical translate is a twist by unimodular numbers. -/
theorem expPoly_add_mul_I (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) (t : ℝ) :
    expPoly c ℓ (w + t * I) = expPoly (fun k => c k * cexp (-(ℓ k : ℂ) * (t * I))) ℓ w := by
  unfold expPoly
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [mul_add, Complex.exp_add]
  ring

theorem norm_twist_eq_one (x t : ℝ) : ‖cexp (-(x : ℂ) * (t * I))‖ = 1 := by
  rw [Complex.norm_exp]
  simp

theorem norm_expPoly_sub_one_le (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    ‖expPoly c ℓ w - 1‖ ≤ ∑ k, ‖c k‖ * Real.exp (-(ℓ k * w.re)) := by
  unfold expPoly
  rw [add_sub_cancel_left]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  rw [norm_mul, norm_cexp_neg_ofReal_mul]

theorem norm_expPolyDeriv_le (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    ‖expPolyDeriv c ℓ w‖ ≤ ∑ k, ‖c k‖ * |ℓ k| * Real.exp (-(ℓ k * w.re)) := by
  unfold expPolyDeriv
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  rw [norm_mul, norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, norm_cexp_neg_ofReal_mul]

/-- The tails `Σ ‖c_k‖ e^{−ℓ_k C}` tend to zero. -/
theorem tendsto_sum_norm_mul_exp (c : τ → ℂ) {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) :
    Tendsto (fun C : ℝ => ∑ k, ‖c k‖ * Real.exp (-(ℓ k * C))) atTop (𝓝 0) := by
  have h : ∀ k ∈ (Finset.univ : Finset τ),
      Tendsto (fun C : ℝ => ‖c k‖ * Real.exp (-(ℓ k * C))) atTop (𝓝 (‖c k‖ * 0)) := fun k _ =>
    ((Real.tendsto_exp_atBot.comp (tendsto_neg_atTop_atBot.comp
      (tendsto_id.const_mul_atTop (hℓ k)))).const_mul _)
  have hs := tendsto_finsetSum Finset.univ h
  simpa using hs

/-! ### Words in the frequencies -/

/-- Words in the frequencies. -/
abbrev Word (τ : Type*) := Σ n : ℕ, Fin n → τ

/-- The coefficient of a word: the product of the `−c_k` over its letters. -/
def wordCoeff (c : τ → ℂ) (J : Word τ) : ℂ := ∏ i, -c (J.2 i)

/-- The exponent of a word: the sum of the frequencies of its letters. -/
def wordExp (ℓ : τ → ℝ) (J : Word τ) : ℝ := ∑ i, ℓ (J.2 i)

omit [Fintype τ] in
theorem wordExp_nonneg {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) (J : Word τ) : 0 ≤ wordExp ℓ J :=
  Finset.sum_nonneg fun _ _ => (hℓ _).le

omit [Fintype τ] in
theorem norm_wordTerm (c : τ → ℂ) (ℓ : τ → ℝ) (J : Word τ) (σ : ℝ) :
    ‖wordCoeff c J‖ * Real.exp (-(wordExp ℓ J * σ)) =
      ∏ i, (‖c (J.2 i)‖ * Real.exp (-(ℓ (J.2 i) * σ))) := by
  have h1 : -(wordExp ℓ J * σ) = ∑ i, -(ℓ (J.2 i) * σ) := by
    rw [wordExp, Finset.sum_mul, Finset.sum_neg_distrib]
  rw [h1, Real.exp_sum, wordCoeff, norm_prod, ← Finset.prod_mul_distrib]
  simp only [norm_neg]

/-- The word series converges absolutely where `Σ ‖c_k‖ e^{−ℓ_k σ} < 1`. -/
theorem summable_norm_wordTerm (c : τ → ℂ) (ℓ : τ → ℝ) {σ : ℝ}
    (hq : ∑ k, ‖c k‖ * Real.exp (-(ℓ k * σ)) < 1) :
    Summable fun J : Word τ => ‖wordCoeff c J‖ * Real.exp (-(wordExp ℓ J * σ)) := by
  have hq0 : 0 ≤ ∑ k, ‖c k‖ * Real.exp (-(ℓ k * σ)) :=
    Finset.sum_nonneg fun k _ => by positivity
  rw [summable_sigma_of_nonneg (fun J => by positivity)]
  refine ⟨fun n => (hasSum_fintype _).summable, ?_⟩
  have hfib : ∀ n : ℕ, (∑' f : Fin n → τ,
      ‖wordCoeff c ⟨n, f⟩‖ * Real.exp (-(wordExp ℓ ⟨n, f⟩ * σ))) =
      (∑ k, ‖c k‖ * Real.exp (-(ℓ k * σ))) ^ n := by
    intro n
    rw [tsum_fintype, Fintype.sum_pow]
    exact Finset.sum_congr rfl fun f _ => norm_wordTerm c ℓ ⟨n, f⟩ σ
  simp only [hfib]
  exact summable_geometric_of_lt_one hq0 hq

/-- **The expansion over words.** Where `Σ ‖c_k‖ e^{−ℓ_k Re w} < 1`,
`1/P(w) = Σ_J β_J e^{−x_J w}`. -/
theorem hasSum_inv_expPoly_words (c : τ → ℂ) (ℓ : τ → ℝ) {w : ℂ}
    (hq : ∑ k, ‖c k‖ * Real.exp (-(ℓ k * w.re)) < 1) :
    HasSum (fun J : Word τ => wordCoeff c J * cexp (-(wordExp ℓ J : ℂ) * w))
      (expPoly c ℓ w)⁻¹ := by
  set U : ℂ := ∑ k, c k * cexp (-(ℓ k : ℂ) * w) with hU
  have hUn : ‖-U‖ < 1 := by
    rw [norm_neg]
    refine lt_of_le_of_lt ((norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)) hq
    rw [norm_mul, norm_cexp_neg_ofReal_mul]
  have hgeo := hasSum_geometric_of_norm_lt_one hUn
  have hval : (1 - -U)⁻¹ = (expPoly c ℓ w)⁻¹ := by rw [expPoly, sub_neg_eq_add]
  rw [← hval]
  refine HasSum.sigma_of_hasSum hgeo (fun n => ?_) ?_
  · have hpow : (-U) ^ n = ∑ f : Fin n → τ,
        wordCoeff c ⟨n, f⟩ * cexp (-(wordExp ℓ ⟨n, f⟩ : ℂ) * w) := by
      rw [hU, ← Finset.sum_neg_distrib, Fintype.sum_pow]
      refine Finset.sum_congr rfl fun f _ => ?_
      have hexp : -((wordExp ℓ ⟨n, f⟩ : ℝ) : ℂ) * w = ∑ i, -(ℓ (f i) : ℂ) * w := by
        show -((∑ i, ℓ (f i) : ℝ) : ℂ) * w = ∑ i, -(ℓ (f i) : ℂ) * w
        rw [Complex.ofReal_sum, ← Finset.sum_neg_distrib, Finset.sum_mul]
      rw [hexp, Complex.exp_sum]
      show ∏ i, -(c (f i) * cexp (-(ℓ (f i) : ℂ) * w)) =
        (∏ i, -c (f i)) * ∏ i, cexp (-(ℓ (f i) : ℂ) * w)
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ => by ring
    rw [hpow]
    exact hasSum_fintype _
  · refine Summable.of_norm ((summable_norm_wordTerm c ℓ hq).congr fun J => ?_)
    rw [norm_mul, norm_cexp_neg_ofReal_mul]

/-- The additive monoid generated by the frequencies, as a set of reals. -/
def freqMonoid (ℓ : τ → ℝ) : Set ℝ := Set.range fun e : τ → ℕ => ∑ k, (e k : ℝ) * ℓ k

theorem wordExp_mem_freqMonoid (ℓ : τ → ℝ) (J : Word τ) : wordExp ℓ J ∈ freqMonoid ℓ := by
  classical
  refine ⟨fun k => (Finset.univ.filter fun i => J.2 i = k).card, ?_⟩
  show ∑ k, ((Finset.univ.filter fun i => J.2 i = k).card : ℝ) * ℓ k = ∑ i, ℓ (J.2 i)
  rw [← Finset.sum_fiberwise (Finset.univ : Finset (Fin J.1)) (fun i => J.2 i)
    (fun i => ℓ (J.2 i))]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Finset.sum_congr rfl (fun i hi => by rw [(Finset.mem_filter.mp hi).2] :
    ∀ i ∈ Finset.univ.filter (fun i => J.2 i = k), ℓ (J.2 i) = ℓ k), Finset.sum_const,
    nsmul_eq_mul]

theorem nonneg_of_mem_freqMonoid {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) {x : ℝ}
    (hx : x ∈ freqMonoid ℓ) : 0 ≤ x := by
  obtain ⟨e, rfl⟩ := hx
  exact Finset.sum_nonneg fun k _ => mul_nonneg (Nat.cast_nonneg _) (hℓ k).le

/-- The total coefficient of the word series at the exponent `x`. -/
def wordMass (c : τ → ℂ) (ℓ : τ → ℝ) (x : ℝ) : ℂ :=
  ∑' J : Word τ, if wordExp ℓ J = x then wordCoeff c J else 0

/-! ### Means of exponentials -/

theorem norm_integral_cexp_le {θ : ℝ} (hθ : θ ≠ 0) (T : ℝ) :
    ‖∫ y in (-T)..T, cexp ((θ : ℂ) * I * (y : ℂ))‖ ≤ 2 / |θ| := by
  have hc : (θ : ℂ) * I ≠ 0 := mul_ne_zero (Complex.ofReal_ne_zero.mpr hθ) I_ne_zero
  have hn : ∀ y : ℝ, ‖cexp ((θ : ℂ) * I * (y : ℂ))‖ = 1 := fun y => by
    rw [show (θ : ℂ) * I * (y : ℂ) = ((θ * y : ℝ) : ℂ) * I by push_cast; ring,
      Complex.norm_exp_ofReal_mul_I]
  rw [integral_exp_mul_complex hc, norm_div, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
    Real.norm_eq_abs]
  refine div_le_div_of_nonneg_right ?_ (abs_nonneg θ)
  have h := norm_sub_le (cexp ((θ : ℂ) * I * ((T : ℝ) : ℂ))) (cexp ((θ : ℂ) * I * ((-T : ℝ) : ℂ)))
  rw [hn, hn] at h
  linarith

theorem norm_mean_cexp_le (θ : ℝ) {T : ℝ} (hT : 0 < T) :
    ‖(1 / (2 * (T : ℂ))) * ∫ y in (-T)..T, cexp ((θ : ℂ) * I * (y : ℂ))‖ ≤ 1 := by
  have hn : ∀ y : ℝ, ‖cexp ((θ : ℂ) * I * (y : ℂ))‖ = 1 := fun y => by
    rw [show (θ : ℂ) * I * (y : ℂ) = ((θ * y : ℝ) : ℂ) * I by push_cast; ring,
      Complex.norm_exp_ofReal_mul_I]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := -T) (b := T) (C := 1)
    (f := fun y : ℝ => cexp ((θ : ℂ) * I * (y : ℂ))) (fun y _ => (hn y).le)
  rw [show |T - -T| = 2 * T by rw [sub_neg_eq_add, ← two_mul, abs_of_pos (by linarith)],
    one_mul] at h
  rw [norm_mul, norm_div, norm_one, norm_mul, Complex.norm_real, Real.norm_of_nonneg hT.le,
    Complex.norm_ofNat]
  rw [div_mul_eq_mul_div, one_mul, div_le_one (by positivity)]
  exact h

/-- The mean of `e^{iθy}` over `|y| ≤ T` tends to the indicator of `θ = 0`. -/
theorem tendsto_mean_cexp (θ : ℝ) :
    Tendsto (fun n : ℕ => (1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
      ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ : ℂ) * I * (y : ℂ))) atTop
      (𝓝 (if θ = 0 then 1 else 0)) := by
  by_cases hθ : θ = 0
  · rw [if_pos hθ]
    refine tendsto_const_nhds.congr fun n => ?_
    have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    subst hθ
    simp only [Complex.ofReal_zero, zero_mul, Complex.exp_zero]
    rw [intervalIntegral.integral_const, sub_neg_eq_add, ← two_mul]
    have hne : (2 * (((n : ℝ) + 1 : ℝ) : ℂ)) ≠ 0 :=
      mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr hn.ne')
    rw [Complex.real_smul, mul_one]
    push_cast
    field_simp
  · rw [if_neg hθ]
    rw [tendsto_zero_iff_norm_tendsto_zero]
    have hbound : ∀ n : ℕ, ‖(1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
        ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ : ℂ) * I * (y : ℂ))‖ ≤
        (1 / |θ|) * (1 / ((n : ℝ) + 1)) := by
      intro n
      have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      rw [norm_mul, norm_div, norm_one, norm_mul, Complex.norm_real, Real.norm_of_nonneg hn.le,
        Complex.norm_ofNat]
      have h := norm_integral_cexp_le hθ ((n : ℝ) + 1)
      have hθpos : 0 < |θ| := abs_pos.mpr hθ
      calc 1 / (2 * ((n : ℝ) + 1)) *
            ‖∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ : ℂ) * I * (y : ℂ))‖
          ≤ 1 / (2 * ((n : ℝ) + 1)) * (2 / |θ|) :=
            mul_le_mul_of_nonneg_left h (by positivity)
        _ = (1 / |θ|) * (1 / ((n : ℝ) + 1)) := by
            field_simp
    refine squeeze_zero (fun _ => norm_nonneg _) hbound ?_
    simpa using (tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (1 / |θ|))

theorem norm_cexp_ofReal_mul_I_mul (θ y : ℝ) : ‖cexp ((θ : ℂ) * I * (y : ℂ))‖ = 1 := by
  rw [show (θ : ℂ) * I * (y : ℂ) = ((θ * y : ℝ) : ℂ) * I by push_cast; ring,
    Complex.norm_exp_ofReal_mul_I]

/-! ### The coefficient bound -/

/-- **The merged coefficients are bounded on every line where `P` is bounded below.** If
`‖P(w)‖ ≥ δ` on `Re w ≥ σ`, the total coefficient of the word series at the exponent `x₀` is at
most `e^{σ x₀}/δ`: it is the mean of `e^{x₀ w}/P(w)` on a far vertical line, and Cauchy's theorem on
the rectangle between that line and `Re w = σ` moves the mean to the line `σ`. -/
theorem norm_wordMass_le (c : τ → ℂ) {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) {σ δ : ℝ} (hδ : 0 < δ)
    (hlow : ∀ w : ℂ, σ ≤ w.re → δ ≤ ‖expPoly c ℓ w‖) (x₀ : ℝ) :
    ‖wordMass c ℓ x₀‖ ≤ Real.exp (σ * x₀) / δ := by
  obtain ⟨c₀, hc₀q, hc₀σ⟩ := (((tendsto_sum_norm_mul_exp c hℓ).eventually
    (gt_mem_nhds (zero_lt_one' ℝ))).and (eventually_ge_atTop σ)).exists
  set f : ℂ → ℂ := fun w => (expPoly c ℓ w)⁻¹ * cexp ((x₀ : ℂ) * w) with hf
  have hne : ∀ w : ℂ, σ ≤ w.re → expPoly c ℓ w ≠ 0 := fun w hw =>
    norm_pos_iff.mp (lt_of_lt_of_le hδ (hlow w hw))
  have hfd : ∀ w : ℂ, σ ≤ w.re → DifferentiableAt ℂ f w := fun w hw =>
    ((differentiable_expPoly c ℓ w).inv (hne w hw)).mul
      ((differentiableAt_id.const_mul (x₀ : ℂ)).cexp)
  have hfb : ∀ w : ℂ, σ ≤ w.re → ‖f w‖ ≤ Real.exp (x₀ * w.re) / δ := by
    intro w hw
    show ‖(expPoly c ℓ w)⁻¹ * cexp ((x₀ : ℂ) * w)‖ ≤ Real.exp (x₀ * w.re) / δ
    rw [norm_mul, norm_inv, Complex.norm_exp, Complex.re_ofReal_mul, div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_right (inv_anti₀ hδ (hlow w hw)) (Real.exp_pos _).le
  set E : ℝ := Real.exp (|x₀| * (|σ| + |c₀|)) with hE
  -- Cauchy's theorem on the rectangle `[σ, c₀] × [−T, T]`
  have hrect : ∀ T : ℝ, 0 < T → ‖∫ y in (-T)..T, f ((c₀ : ℂ) + y * I)‖ ≤
      Real.exp (x₀ * σ) / δ * (2 * T) + 2 * (E / δ * (c₀ - σ)) := by
    intro T hT
    set z : ℂ := (σ : ℂ) + ((-T : ℝ) : ℂ) * I with hz
    set w : ℂ := (c₀ : ℂ) + ((T : ℝ) : ℂ) * I with hw
    have hzre : z.re = σ := by simp [hz]
    have hzim : z.im = -T := by simp [hz]
    have hwre : w.re = c₀ := by simp [hw]
    have hwim : w.im = T := by simp [hw]
    have hdiff : DifferentiableOn ℂ f (Set.uIcc z.re w.re ×ℂ Set.uIcc z.im w.im) := by
      intro u hu
      rw [hzre, hwre, Set.uIcc_of_le hc₀σ] at hu
      exact (hfd u hu.1.1).differentiableWithinAt
    have hid := Complex.integral_boundary_rect_eq_zero_of_differentiableOn f z w hdiff
    rw [hzre, hwre, hzim, hwim] at hid
    simp only [smul_eq_mul] at hid
    have hV : ‖∫ y in (-T)..T, f ((σ : ℂ) + y * I)‖ ≤ Real.exp (x₀ * σ) / δ * (2 * T) := by
      have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := -T) (b := T)
        (C := Real.exp (x₀ * σ) / δ) (f := fun y : ℝ => f ((σ : ℂ) + y * I)) (fun y _ => by
          have hre : ((σ : ℂ) + y * I).re = σ := by simp
          have := hfb _ (le_of_eq hre.symm)
          rwa [hre] at this)
      rwa [show |T - -T| = 2 * T by rw [sub_neg_eq_add, ← two_mul, abs_of_pos (by linarith)]] at h
    have hH : ∀ t : ℝ, ‖∫ x in σ..c₀, f ((x : ℂ) + (t : ℂ) * I)‖ ≤ E / δ * (c₀ - σ) := by
      intro t
      have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := σ) (b := c₀)
        (C := E / δ) (f := fun x : ℝ => f ((x : ℂ) + (t : ℂ) * I)) (fun x hx => by
          rw [Set.uIoc_of_le hc₀σ] at hx
          have hre : ((x : ℂ) + (t : ℂ) * I).re = x := by simp
          have h1 := hfb _ (by rw [hre]; exact hx.1.le)
          rw [hre] at h1
          refine h1.trans (div_le_div_of_nonneg_right (Real.exp_le_exp.mpr ?_) hδ.le)
          have hx' : |x| ≤ |σ| + |c₀| := by
            rw [abs_le]
            constructor <;>
              linarith [neg_abs_le σ, abs_nonneg c₀, le_abs_self c₀, abs_nonneg σ, hx.1, hx.2]
          calc x₀ * x ≤ |x₀ * x| := le_abs_self _
            _ = |x₀| * |x| := abs_mul _ _
            _ ≤ |x₀| * (|σ| + |c₀|) := mul_le_mul_of_nonneg_left hx' (abs_nonneg _))
      rwa [abs_of_nonneg (sub_nonneg.mpr hc₀σ)] at h
    have hI : I * (∫ y in (-T)..T, f ((c₀ : ℂ) + y * I)) =
        I * (∫ y in (-T)..T, f ((σ : ℂ) + y * I))
          - (∫ x in σ..c₀, f ((x : ℂ) + ((-T : ℝ) : ℂ) * I))
          + ∫ x in σ..c₀, f ((x : ℂ) + ((T : ℝ) : ℂ) * I) := by
      linear_combination hid
    have h1 := hH (-T)
    have h2 := hH T
    calc ‖∫ y in (-T)..T, f ((c₀ : ℂ) + y * I)‖
        = ‖I * ∫ y in (-T)..T, f ((c₀ : ℂ) + y * I)‖ := by
          rw [norm_mul, Complex.norm_I, one_mul]
      _ ≤ ‖I * ∫ y in (-T)..T, f ((σ : ℂ) + y * I)‖
          + ‖∫ x in σ..c₀, f ((x : ℂ) + ((-T : ℝ) : ℂ) * I)‖
          + ‖∫ x in σ..c₀, f ((x : ℂ) + ((T : ℝ) : ℂ) * I)‖ := by
          rw [hI]
          exact (norm_add_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
      _ ≤ Real.exp (x₀ * σ) / δ * (2 * T) + 2 * (E / δ * (c₀ - σ)) := by
          rw [norm_mul, Complex.norm_I, one_mul]
          linarith
  -- the expansion on the line `Re w = c₀`
  set θ : Word τ → ℝ := fun J => x₀ - wordExp ℓ J with hθ
  have hterm : ∀ y : ℝ, HasSum (fun J : Word τ =>
      wordCoeff c J * cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ)))
      (f ((c₀ : ℂ) + y * I)) := by
    intro y
    have hre : ((c₀ : ℂ) + y * I).re = c₀ := by simp
    have h := (hasSum_inv_expPoly_words c ℓ (w := (c₀ : ℂ) + y * I)
      (by rw [hre]; exact hc₀q)).mul_right (cexp ((x₀ : ℂ) * ((c₀ : ℂ) + y * I)))
    have heq : (fun J : Word τ =>
        wordCoeff c J * cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ))) =
        fun J : Word τ => wordCoeff c J * cexp (-(wordExp ℓ J : ℂ) * ((c₀ : ℂ) + y * I)) *
          cexp ((x₀ : ℂ) * ((c₀ : ℂ) + y * I)) := by
      funext J
      have h1 : cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ)) =
          cexp ((θ J : ℂ) * ((c₀ : ℂ) + y * I)) := by
        rw [← Complex.exp_add]
        congr 1
        ring
      have h2 : cexp (-(wordExp ℓ J : ℂ) * ((c₀ : ℂ) + y * I)) *
          cexp ((x₀ : ℂ) * ((c₀ : ℂ) + y * I)) = cexp ((θ J : ℂ) * ((c₀ : ℂ) + y * I)) := by
        rw [← Complex.exp_add]
        congr 1
        simp only [hθ]
        push_cast
        ring
      rw [mul_assoc (wordCoeff c J), h1, mul_assoc (wordCoeff c J), h2]
    rw [heq]
    exact h
  have hnormterm : ∀ (J : Word τ) (y : ℝ),
      ‖wordCoeff c J * cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ))‖ =
        ‖wordCoeff c J‖ * Real.exp (θ J * c₀) := by
    intro J y
    rw [norm_mul, norm_mul, norm_cexp_ofReal_mul_I_mul, mul_one, Complex.norm_exp,
      Complex.re_ofReal_mul, Complex.ofReal_re]
  have hsumθ : Summable fun J : Word τ => ‖wordCoeff c J‖ * Real.exp (θ J * c₀) := by
    refine ((summable_norm_wordTerm c ℓ hc₀q).mul_left (Real.exp (x₀ * c₀))).congr fun J => ?_
    simp only [hθ]
    rw [sub_mul, sub_eq_add_neg, Real.exp_add]
    ring
  have hVc : ∀ T : ℝ, 0 < T → (∫ y in (-T)..T, f ((c₀ : ℂ) + y * I)) =
      ∑' J : Word τ, wordCoeff c J * cexp ((θ J : ℂ) * c₀) *
        ∫ y in (-T)..T, cexp ((θ J : ℂ) * I * (y : ℂ)) := by
    intro T hT
    have hle : -T ≤ T := by linarith
    have hint : ∀ J : Word τ, Integrable (fun y : ℝ =>
        wordCoeff c J * cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ)))
        (volume.restrict (Set.Ioc (-T) T)) := fun J =>
      Continuous.integrableOn_Ioc (by fun_prop)
    have hsum' : Summable fun J : Word τ => ∫ y in Set.Ioc (-T) T,
        ‖wordCoeff c J * cexp ((θ J : ℂ) * c₀) * cexp ((θ J : ℂ) * I * (y : ℂ))‖ := by
      simp only [hnormterm, ← intervalIntegral.integral_of_le hle, intervalIntegral.integral_const,
        smul_eq_mul]
      exact hsumθ.mul_left _
    have h := (MeasureTheory.hasSum_integral_of_summable_integral_norm hint hsum').tsum_eq
    rw [intervalIntegral.integral_of_le hle,
      ← MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (fun y _ => (hterm y).tsum_eq), ← h]
    refine tsum_congr fun J => ?_
    rw [intervalIntegral.integral_of_le hle, ← MeasureTheory.integral_const_mul]
  -- the means over `|y| ≤ n + 1`
  have hlim : Tendsto (fun n : ℕ => ∑' J : Word τ, wordCoeff c J * cexp ((θ J : ℂ) * c₀) *
      ((1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
        ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ J : ℂ) * I * (y : ℂ)))) atTop
      (𝓝 (wordMass c ℓ x₀)) := by
    show Tendsto _ atTop
      (𝓝 (∑' J : Word τ, if wordExp ℓ J = x₀ then wordCoeff c J else 0))
    refine tendsto_tsum_of_dominated_convergence hsumθ (fun J => ?_)
      (Eventually.of_forall fun n J => ?_)
    · have h := (tendsto_mean_cexp (θ J)).const_mul (wordCoeff c J * cexp ((θ J : ℂ) * c₀))
      have htarget : wordCoeff c J * cexp ((θ J : ℂ) * c₀) * (if θ J = 0 then 1 else 0) =
          if wordExp ℓ J = x₀ then wordCoeff c J else 0 := by
        by_cases h0 : wordExp ℓ J = x₀
        · have hθ0 : θ J = 0 := by simp only [hθ]; rw [h0, sub_self]
          rw [if_pos h0, if_pos hθ0, hθ0, Complex.ofReal_zero, zero_mul, Complex.exp_zero, mul_one,
            mul_one]
        · have hθ0 : θ J ≠ 0 := by
            simp only [hθ]
            exact fun h => h0 (sub_eq_zero.mp h).symm
          rw [if_neg h0, if_neg hθ0, mul_zero]
      rw [← htarget]
      exact h
    · have hT : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      rw [norm_mul, norm_mul, Complex.norm_exp, Complex.re_ofReal_mul, Complex.ofReal_re]
      exact mul_le_of_le_one_right (by positivity) (norm_mean_cexp_le (θ J) hT)
  have hbound : ∀ n : ℕ, ‖∑' J : Word τ, wordCoeff c J * cexp ((θ J : ℂ) * c₀) *
      ((1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
        ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ J : ℂ) * I * (y : ℂ)))‖ ≤
      Real.exp (x₀ * σ) / δ + E / δ * (c₀ - σ) * (1 / ((n : ℝ) + 1)) := by
    intro n
    have hT : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have hfact : (∑' J : Word τ, wordCoeff c J * cexp ((θ J : ℂ) * c₀) *
        ((1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
          ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), cexp ((θ J : ℂ) * I * (y : ℂ)))) =
        (1 / (2 * (((n : ℝ) + 1 : ℝ) : ℂ))) *
          ∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), f ((c₀ : ℂ) + y * I) := by
      rw [hVc _ hT, ← tsum_mul_left]
      exact tsum_congr fun J => by ring
    rw [hfact, norm_mul, norm_div, norm_one, norm_mul, Complex.norm_ofNat, Complex.norm_real,
      Real.norm_of_nonneg hT.le]
    have h := hrect _ hT
    calc 1 / (2 * ((n : ℝ) + 1)) *
          ‖∫ y in (-((n : ℝ) + 1))..((n : ℝ) + 1), f ((c₀ : ℂ) + y * I)‖
        ≤ 1 / (2 * ((n : ℝ) + 1)) *
          (Real.exp (x₀ * σ) / δ * (2 * ((n : ℝ) + 1)) + 2 * (E / δ * (c₀ - σ))) :=
          mul_le_mul_of_nonneg_left h (by positivity)
      _ = Real.exp (x₀ * σ) / δ + E / δ * (c₀ - σ) * (1 / ((n : ℝ) + 1)) := by
          field_simp
  have hRlim : Tendsto (fun n : ℕ => Real.exp (x₀ * σ) / δ +
      E / δ * (c₀ - σ) * (1 / ((n : ℝ) + 1))) atTop (𝓝 (Real.exp (x₀ * σ) / δ)) := by
    simpa using
      (tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (E / δ * (c₀ - σ))).const_add
        (Real.exp (x₀ * σ) / δ)
  have hfin := le_of_tendsto_of_tendsto' hlim.norm hRlim hbound
  rwa [mul_comm x₀ σ] at hfin

end GaloisForLFunctions.InfiniteRankPurityTheory
