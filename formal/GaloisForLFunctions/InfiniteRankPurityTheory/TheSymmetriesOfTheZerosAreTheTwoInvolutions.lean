import GaloisForLFunctions.RHTower.XiCensusVonMangoldtBridge
import GaloisForLFunctions.RHTower.FrobeniusTorsionLaw
import GaloisForLFunctions.RHTower.XiOrdinateBandCopies
import GaloisForLFunctions.RHTower.WeilLagFunctionCriterion
import GaloisForLFunctions.BlackHoleRingdown.TheInverseXiContour

/-!
# The symmetries of the zeros are the two involutions

In finite rank the eigenvalues of a Frobenius are permuted by a Galois group, and conjugate
eigenvalues share their absolute values. The zero divisor of `ξ` has two involutions, the reflection
`ι : s ↦ 1 − s` and the conjugation `c : s ↦ s̄`.

**Theorem** (`preservesXiDivisor_affine_iff`, `preservesXiDivisor_antiaffine_iff`). An affine map
`s ↦ a s + b` preserves the zero divisor of `ξ` (the order of vanishing at every point) exactly when
it is the identity or `ι`; an anti-affine map `s ↦ a s̄ + b` exactly when it is `c` or `ιc`.

So the group of rigid symmetries of the zero motive is the four-group generated by `ι` and `c`. The
only zeros forced to share a depth by an exact symmetry are `ρ` and `ρ̄`; `ρ` and `1 − ρ` have
opposite depths. Conjugacy at infinite rank cannot come from a rigid symmetry.

**Proof.**
- *Direction.* A zero of large height is mapped into the strip, so `Im a = 0`.
- *No contraction.* If `‖a‖ < 1` the iterates of a zero under the map are zeros converging to its
  fixed point, against the isolation of zeros; if `‖a‖ > 1` use the inverse. Hence `a = ±1`.
- *No translation.* A translation `s ↦ s + b` preserving the divisor has `Re b = 0` (the strip), and
  a vertical period `τ > 0` gives `N(kτ) = k N(τ)`, against `N(T) ≥ (1/4π) T log T`.
- `a = −1` reduces to a translation by composing with `ι`, the anti-affine case by composing with
  `c`.

For a curve over `𝔽_q` the vertical translation by `2π/log q` is a third symmetry: there conjugate
zeros recur at every height.
-/

open Complex Filter Topology Set

namespace GaloisForLFunctions.InfiniteRankPurityTheory

open _root_.RHTower GaloisForLFunctions.BlackHoleRingdown

/-- A map of the plane preserves the zero divisor of `ξ`: the order of vanishing at the image of
every point is the order at the point. -/
def PreservesXiDivisor (A : ℂ → ℂ) : Prop :=
  ∀ s, analyticOrderAt xi (A s) = analyticOrderAt xi s

/-! ### Zeros of `ξ` -/

theorem xi_eq_zero_iff_order_ne_zero (s : ℂ) : xi s = 0 ↔ analyticOrderAt xi s ≠ 0 := by
  rw [Ne, (xi_analyticAt s).analyticOrderAt_eq_zero]
  exact not_not.symm

theorem PreservesXiDivisor.zero_iff {A : ℂ → ℂ} (hA : PreservesXiDivisor A) (s : ℂ) :
    xi (A s) = 0 ↔ xi s = 0 := by
  rw [xi_eq_zero_iff_order_ne_zero, xi_eq_zero_iff_order_ne_zero, hA s]

/-- Zeros of `ξ` are isolated. -/
theorem eventually_xi_ne_zero (p : ℂ) : ∀ᶠ w in 𝓝[≠] p, xi w ≠ 0 :=
  ((xi_analyticAt p).eventually_eq_zero_or_eventually_ne_zero).resolve_left
    (xi_not_eventually_zero p)

/-- There are zeros of arbitrarily large height. -/
theorem exists_xi_zero_im_gt (T : ℝ) : ∃ ρ : ℂ, xi ρ = 0 ∧ T < ρ.im := by
  obtain ⟨ρ, hρ, hnot⟩ := (xiZeros_infinite.sdiff (xiZerosUpTo_finite |T|)).nonempty
  have hρ0 : xi ρ = 0 := hρ
  have hgt : |T| < |ρ.im| := by
    by_contra h
    exact hnot ⟨hρ0, not_lt.mp h⟩
  rcases le_or_gt 0 ρ.im with h | h
  · refine ⟨ρ, hρ0, ?_⟩
    rw [abs_of_nonneg h] at hgt
    exact lt_of_le_of_lt (le_abs_self T) hgt
  · refine ⟨(starRingEnd ℂ) ρ, by rw [xi_conj, hρ0, map_zero], ?_⟩
    rw [abs_of_neg h] at hgt
    rw [Complex.conj_im]
    exact lt_of_le_of_lt (le_abs_self T) hgt

/-! ### The four symmetries -/

theorem preservesXiDivisor_id : PreservesXiDivisor fun s => s := fun _ => rfl

theorem preservesXiDivisor_reflect : PreservesXiDivisor fun s => 1 - s := xi_orderAt_one_sub

theorem preservesXiDivisor_conj : PreservesXiDivisor fun s => (starRingEnd ℂ) s :=
  xi_orderAt_conj

theorem preservesXiDivisor_reflect_conj :
    PreservesXiDivisor fun s => 1 - (starRingEnd ℂ) s := fun s => by
  rw [xi_orderAt_one_sub, xi_orderAt_conj]

/-! ### Direction: the linear part is real -/

theorem im_eq_zero_of_preserves {a b : ℂ} (hA : PreservesXiDivisor fun s => a * s + b) :
    a.im = 0 := by
  by_contra him
  have hpos : 0 < |a.im| := abs_pos.mpr him
  obtain ⟨ρ, hρ, hgt⟩ := exists_xi_zero_im_gt ((|a.re| + |b.re| + 1) / |a.im|)
  have hz : xi (a * ρ + b) = 0 := (hA.zero_iff ρ).mpr hρ
  have h0 := re_pos_of_xi_eq_zero hz
  have h1 := re_lt_one_of_xi_eq_zero hz
  have hρ0 := re_pos_of_xi_eq_zero hρ
  have hρ1 := re_lt_one_of_xi_eq_zero hρ
  simp only [add_re, mul_re] at h0 h1
  have hlt : |a.re| + |b.re| + 1 < |a.im| * ρ.im := by
    rw [div_lt_iff₀ hpos] at hgt
    linarith
  have hρim : 0 < ρ.im :=
    lt_of_le_of_lt (div_nonneg (by positivity) hpos.le) hgt
  have habs : |a.im * ρ.im| = |a.im| * ρ.im := by rw [abs_mul, abs_of_pos hρim]
  have h3 : |a.re * ρ.re| ≤ |a.re| := by
    rw [abs_mul, abs_of_pos hρ0]
    exact mul_le_of_le_one_right (abs_nonneg _) hρ1.le
  have h3' := abs_le.mp h3
  have hb' := abs_le.mp (le_refl |b.re|)
  have hbound : |a.im * ρ.im| < |a.re| + |b.re| + 1 := by
    rw [abs_lt]
    constructor <;> linarith [h3'.1, h3'.2, hb'.1, hb'.2]
  linarith

/-! ### No contraction -/

theorem not_preserves_of_norm_lt_one {a b : ℂ} (ha0 : a ≠ 0) (ha : ‖a‖ < 1) :
    ¬ PreservesXiDivisor fun s => a * s + b := by
  intro hA
  have ha1 : (1 : ℂ) - a ≠ 0 := by
    intro h
    have : a = 1 := by linear_combination -h
    rw [this, norm_one] at ha
    exact lt_irrefl _ ha
  -- the fixed point
  set p : ℂ := b / (1 - a) with hp
  have hfix : a * p + b = p := by
    rw [hp]
    field_simp
    ring
  obtain ⟨ρ, hρ, hgt⟩ := exists_xi_zero_im_gt p.im
  have hne : ρ ≠ p := fun h => by
    rw [h] at hgt
    exact lt_irrefl _ hgt
  -- the iterates of `ρ` are zeros
  have hiter : ∀ n : ℕ, xi (p + a ^ n * (ρ - p)) = 0 := by
    intro n
    induction n with
    | zero => simpa using hρ
    | succ n ih =>
      have h := (hA.zero_iff _).mpr ih
      have e : a * (p + a ^ n * (ρ - p)) + b = p + a ^ (n + 1) * (ρ - p) := by
        rw [pow_succ]
        linear_combination hfix
      rwa [e] at h
  -- they converge to the fixed point without reaching it
  have htend : Tendsto (fun n : ℕ => p + a ^ n * (ρ - p)) atTop (𝓝[≠] p) := by
    rw [tendsto_nhdsWithin_iff]
    refine ⟨?_, Eventually.of_forall fun n => ?_⟩
    · have h := ((tendsto_pow_atTop_nhds_zero_of_norm_lt_one ha).mul_const (ρ - p)).const_add p
      simpa using h
    · simp [pow_ne_zero n ha0, sub_ne_zero.mpr hne]
  obtain ⟨n, hn⟩ := (htend.eventually (eventually_xi_ne_zero p)).exists
  exact hn (hiter n)

/-- The inverse of a divisor-preserving affine map preserves the divisor. -/
theorem PreservesXiDivisor.inv {a b : ℂ} (ha0 : a ≠ 0)
    (hA : PreservesXiDivisor fun s => a * s + b) :
    PreservesXiDivisor fun s => a⁻¹ * s + -(a⁻¹ * b) := by
  intro s
  have h := hA (a⁻¹ * s + -(a⁻¹ * b))
  have e : a * (a⁻¹ * s + -(a⁻¹ * b)) + b = s := by
    field_simp
    ring
  simp only at h
  rw [e] at h
  exact h.symm

theorem ne_zero_of_preserves {a b : ℂ} (hA : PreservesXiDivisor fun s => a * s + b) :
    a ≠ 0 := by
  intro ha
  obtain ⟨ρ, hρ, -⟩ := exists_xi_zero_im_gt 0
  have h1 := (hA.zero_iff ρ).mpr hρ
  have h2 := (hA.zero_iff 0).mp (by
    simp only [ha, zero_mul, zero_add] at h1 ⊢
    exact h1)
  rw [xi_zero] at h2
  norm_num at h2

/-- The linear part of a divisor-preserving affine map is `±1`. -/
theorem eq_one_or_eq_neg_one_of_preserves {a b : ℂ}
    (hA : PreservesXiDivisor fun s => a * s + b) : a = 1 ∨ a = -1 := by
  have ha0 := ne_zero_of_preserves hA
  have him := im_eq_zero_of_preserves hA
  have hnorm : ‖a‖ = 1 := by
    rcases lt_trichotomy ‖a‖ 1 with h | h | h
    · exact absurd hA (not_preserves_of_norm_lt_one ha0 h)
    · exact h
    · have hinv : ‖a⁻¹‖ < 1 := by
        rw [norm_inv]
        exact inv_lt_one_of_one_lt₀ h
      exact absurd (hA.inv ha0) (not_preserves_of_norm_lt_one (inv_ne_zero ha0) hinv)
  have hre : a = (a.re : ℂ) := Complex.ext (by simp) (by simp [him])
  have habs : |a.re| = 1 := by
    rw [hre, Complex.norm_real, Real.norm_eq_abs] at hnorm
    exact hnorm
  rcases abs_eq (by norm_num : (0 : ℝ) ≤ 1) |>.mp habs with h | h
  · left
    rw [hre, h]
    simp
  · right
    rw [hre, h]
    simp

/-! ### No translation -/

theorem PreservesXiDivisor.translate_iterate {b : ℂ} (hA : PreservesXiDivisor fun s => s + b)
    (n : ℕ) (s : ℂ) : analyticOrderAt xi (s + n * b) = analyticOrderAt xi s := by
  induction n with
  | zero => simp
  | succ n ih =>
    have h := hA (s + n * b)
    simp only at h
    rw [← ih, ← h]
    congr 1
    push_cast
    ring

/-- A divisor-preserving translation is vertical. -/
theorem re_eq_zero_of_translation {b : ℂ} (hA : PreservesXiDivisor fun s => s + b) :
    b.re = 0 := by
  by_contra hb
  obtain ⟨ρ, hρ, -⟩ := exists_xi_zero_im_gt 0
  have hρ0 := re_pos_of_xi_eq_zero hρ
  have hρ1 := re_lt_one_of_xi_eq_zero hρ
  obtain ⟨n, hn⟩ := exists_nat_gt (1 / |b.re|)
  have hpos : 0 < |b.re| := abs_pos.mpr hb
  have hn' : 1 < (n : ℝ) * |b.re| := by
    rw [div_lt_iff₀ hpos] at hn
    exact hn
  have hz : xi (ρ + n * b) = 0 := by
    rw [xi_eq_zero_iff_order_ne_zero, hA.translate_iterate n ρ, ← xi_eq_zero_iff_order_ne_zero]
    exact hρ
  have h0 := re_pos_of_xi_eq_zero hz
  have h1 := re_lt_one_of_xi_eq_zero hz
  simp only [add_re, mul_re, natCast_re, natCast_im, zero_mul, sub_zero] at h0 h1
  rcases abs_cases b.re with ⟨habs, -⟩ | ⟨habs, -⟩
  · rw [habs] at hn'
    linarith
  · rw [habs] at hn'
    linarith

/-- Translating a window of heights by a period of the divisor adds the counts. -/
theorem xiPosZeroCount_add {T τ : ℝ} (hT : 0 ≤ T) (hτ : 0 ≤ τ)
    (hshift : ∀ s, analyticOrderAt xi (s + (T : ℂ) * I) = analyticOrderAt xi s) :
    xiPosZeroCount (T + τ) = xiPosZeroCount T + xiPosZeroCount τ := by
  classical
  have hzero : ∀ s, xi (s + (T : ℂ) * I) = 0 ↔ xi s = 0 := fun s => by
    rw [xi_eq_zero_iff_order_ne_zero, xi_eq_zero_iff_order_ne_zero, hshift s]
  have hinj : Function.Injective fun w : ℂ => w + (T : ℂ) * I := fun x y h =>
    add_right_cancel h
  have hunion : stripFinsetPos (T + τ) =
      stripFinsetPos T ∪ (stripFinsetPos τ).image (fun w : ℂ => w + (T : ℂ) * I) := by
    ext z
    rw [Finset.mem_union, Finset.mem_image, mem_stripFinsetPos, mem_stripFinsetPos]
    constructor
    · rintro ⟨h1, h2, h3, h4, hz⟩
      rcases le_or_gt z.im T with hle | hgt
      · exact Or.inl ⟨h1, h2, h3, hle, hz⟩
      · refine Or.inr ⟨z - (T : ℂ) * I, ?_, by ring⟩
        rw [mem_stripFinsetPos]
        refine ⟨by simpa using h1, by simpa using h2, by simpa using hgt, by
          simp only [sub_im, mul_im, ofReal_re, I_im, mul_one, ofReal_im, I_re, mul_zero,
            add_zero]
          linarith, ?_⟩
        rw [← hzero, sub_add_cancel]
        exact hz
    · rintro (⟨h1, h2, h3, h4, hz⟩ | ⟨w, hw, rfl⟩)
      · exact ⟨h1, h2, h3, by linarith, hz⟩
      · rw [mem_stripFinsetPos] at hw
        obtain ⟨h1, h2, h3, h4, hz⟩ := hw
        refine ⟨by simpa using h1, by simpa using h2, ?_, ?_, (hzero w).mpr hz⟩
        · simp only [add_im, mul_im, ofReal_re, I_im, mul_one, ofReal_im, I_re, mul_zero,
            add_zero]
          linarith
        · simp only [add_im, mul_im, ofReal_re, I_im, mul_one, ofReal_im, I_re, mul_zero,
            add_zero]
          linarith
  have hdisj : Disjoint (stripFinsetPos T)
      ((stripFinsetPos τ).image (fun w : ℂ => w + (T : ℂ) * I)) := by
    rw [Finset.disjoint_left]
    intro z hz hz'
    rw [Finset.mem_image] at hz'
    obtain ⟨w, hw, rfl⟩ := hz'
    have h1 := (mem_stripFinsetPos.mp hz).2.2.2.1
    have h2 := (mem_stripFinsetPos.mp hw).2.2.1
    simp only [add_im, mul_im, ofReal_re, I_im, mul_one, ofReal_im, I_re, mul_zero,
      add_zero] at h1
    linarith
  rw [xiPosZeroCount, hunion, Finset.sum_union hdisj, Finset.sum_image (fun x _ y _ h => hinj h)]
  simp only [hshift]
  rfl

/-- A vertical period `τ > 0` of the divisor makes the count linear along its multiples. -/
theorem xiPosZeroCount_mul_period {τ : ℝ} (hτ : 0 < τ)
    (hA : PreservesXiDivisor fun s => s + (τ : ℂ) * I) (k : ℕ) :
    xiPosZeroCount (k * τ) = k * xiPosZeroCount τ := by
  induction k with
  | zero =>
    have hempty : stripFinsetPos 0 = ∅ := by
      ext z
      rw [mem_stripFinsetPos]
      constructor
      · rintro ⟨-, -, h3, h4, -⟩
        linarith
      · intro h
        simp at h
    simp [xiPosZeroCount, hempty]
  | succ k ih =>
    have hshift : ∀ s, analyticOrderAt xi (s + ((k * τ : ℝ) : ℂ) * I) = analyticOrderAt xi s := by
      intro s
      have h := hA.translate_iterate k s
      rw [← h]
      congr 1
      push_cast
      ring
    have hsum := xiPosZeroCount_add (τ := τ) (mul_nonneg (Nat.cast_nonneg k) hτ.le) hτ.le hshift
    have hcast : ((k + 1 : ℕ) : ℝ) * τ = k * τ + τ := by
      push_cast
      ring
    rw [hcast, hsum, ih]
    ring

/-- **No vertical period.** The zero divisor of `ξ` is not invariant under a vertical translation
by `τ > 0`: the count would be linear along the multiples of `τ`. -/
theorem not_preserves_vertical_period {τ : ℝ} (hτ : 0 < τ) :
    ¬ PreservesXiDivisor fun s => s + (τ : ℂ) * I := by
  intro hA
  have hπ : (0 : ℝ) < Real.pi := Real.pi_pos
  have hk : Tendsto (fun k : ℕ => (k : ℝ) * τ) atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_mul_const hτ
  have hgrow := hk.eventually eventually_inv_four_pi_mul_le_xiPosZeroCount
  have hlog : ∀ᶠ k : ℕ in atTop,
      4 * Real.pi * (xiPosZeroCount τ : ℝ) / τ < Real.log ((k : ℝ) * τ) :=
    (Real.tendsto_log_atTop.comp hk).eventually_gt_atTop _
  obtain ⟨k, hk1, hk2, hk3⟩ := (hgrow.and (hlog.and (eventually_ge_atTop 1))).exists
  rw [xiPosZeroCount_mul_period hτ hA k] at hk1
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk3
  push_cast at hk1
  -- `(1/4π) kτ log(kτ) ≤ k N(τ)` against `log(kτ) > 4π N(τ)/τ`
  rw [div_lt_iff₀ hτ] at hk2
  have h4 : (0 : ℝ) < 4 * Real.pi := by positivity
  have h5 : (k : ℝ) * τ * Real.log ((k : ℝ) * τ) ≤ 4 * Real.pi * ((k : ℝ) * xiPosZeroCount τ) := by
    have := mul_le_mul_of_nonneg_left hk1 h4.le
    rw [← mul_assoc, mul_one_div_cancel h4.ne', one_mul] at this
    exact this
  nlinarith

/-- **A divisor-preserving translation is trivial.** -/
theorem eq_zero_of_translation {b : ℂ} (hA : PreservesXiDivisor fun s => s + b) : b = 0 := by
  have hre := re_eq_zero_of_translation hA
  have hb : b = (b.im : ℂ) * I := Complex.ext (by simp [hre]) (by simp)
  by_contra hne
  have him : b.im ≠ 0 := by
    intro h
    apply hne
    rw [hb, h]
    simp
  rcases lt_or_gt_of_ne him with hneg | hpos
  · -- use the inverse translation
    have hinv : PreservesXiDivisor fun s => s + ((-b.im : ℝ) : ℂ) * I := by
      intro s
      have h := hA (s + ((-b.im : ℝ) : ℂ) * I)
      simp only at h
      have e : s + ((-b.im : ℝ) : ℂ) * I + b = s := by
        apply Complex.ext
        · simp [hre]
        · simp
      rw [e] at h
      exact h.symm
    exact not_preserves_vertical_period (by linarith : (0 : ℝ) < -b.im) hinv
  · have hfun : (fun s : ℂ => s + b) = fun s => s + (b.im : ℂ) * I := by
      funext s
      rw [← hb]
    rw [hfun] at hA
    exact not_preserves_vertical_period hpos hA

/-! ### The classification -/

/-- **Affine symmetries.** An affine map preserves the zero divisor of `ξ` exactly when it is the
identity or the reflection `s ↦ 1 − s`. -/
theorem preservesXiDivisor_affine_iff {a b : ℂ} :
    PreservesXiDivisor (fun s => a * s + b) ↔ (a = 1 ∧ b = 0) ∨ (a = -1 ∧ b = 1) := by
  constructor
  · intro hA
    rcases eq_one_or_eq_neg_one_of_preserves hA with ha | ha
    · left
      refine ⟨ha, eq_zero_of_translation ?_⟩
      have hfun : (fun s : ℂ => a * s + b) = fun s => s + b := by
        funext s
        rw [ha, one_mul]
      rwa [hfun] at hA
    · right
      refine ⟨ha, ?_⟩
      -- compose with the reflection
      have hB : PreservesXiDivisor fun s => s + (b - 1) := by
        intro s
        have h := hA (1 - s)
        simp only at h
        rw [xi_orderAt_one_sub] at h
        have e : a * (1 - s) + b = s + (b - 1) := by
          rw [ha]
          ring
        rwa [e] at h
      have := eq_zero_of_translation hB
      linear_combination this
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · intro s
      simp
    · intro s
      have e : (-1 : ℂ) * s + 1 = 1 - s := by ring
      simp only [e]
      exact xi_orderAt_one_sub s

/-- **Anti-affine symmetries.** An anti-affine map preserves the zero divisor of `ξ` exactly when
it is the conjugation `s ↦ s̄` or `s ↦ 1 − s̄`. -/
theorem preservesXiDivisor_antiaffine_iff {a b : ℂ} :
    PreservesXiDivisor (fun s => a * (starRingEnd ℂ) s + b) ↔
      (a = 1 ∧ b = 0) ∨ (a = -1 ∧ b = 1) := by
  rw [← preservesXiDivisor_affine_iff]
  constructor
  · intro hA s
    have h := hA ((starRingEnd ℂ) s)
    simp only [Complex.conj_conj] at h
    rw [xi_orderAt_conj] at h
    exact h
  · intro hA s
    have h := hA ((starRingEnd ℂ) s)
    simp only at h
    rw [xi_orderAt_conj] at h
    exact h

end GaloisForLFunctions.InfiniteRankPurityTheory
