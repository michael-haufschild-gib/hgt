import GaloisForLFunctions.FiniteFreeProbability.HurwitzDeflation
import Mathlib.Analysis.Complex.CauchyIntegral
import Mathlib.Analysis.Normed.Group.Tannery
import Mathlib.Analysis.SpecialFunctions.Integrals.Basic

/-!
# The logarithmic derivative of an exponential polynomial expands up to its zeros

Let `P(w) = 1 + Σ_k c_k e^{−ℓ_k w}` with finitely many real frequencies `ℓ_k > 0`, and suppose `P`
has no zeros in `Re w > θ`. Far to the right `P'/P` is a series `Σ_j B_j e^{−x_j w}` over the words
in the frequencies. This module shows that after merging equal exponents the series converges
absolutely on every line `Re w = σ > θ`, up to the zeros.

* `exists_le_norm_expPoly_of_zeroFree`: `P` is bounded below on `Re w ≥ σ`. The vertical translates
  of `P` are its twists by unimodular numbers, a compact family; a sequence along which `P` tends
  to zero gives a twist with a zero right of `θ`, and by Hurwitz a zero of `P` there.
* `hasSum_logDeriv_words`: the expansion over words, on `Re w ≥ c₀`.
* `norm_mergedCoeff_le`: the total coefficient at an exponent `x` is the mean of
  `(P'/P)(c₀ + it) e^{x(c₀ + it)}` over `t`; by Cauchy's theorem on a rectangle the line `c₀` may be
  replaced by any line `σ > θ`, where `P'/P` is bounded: `‖m(x)‖ ≤ B_σ e^{σx}`.
* `summable_exp_neg_range`: the exponents lie in the additive monoid generated by the
  frequencies, which is sparse: `Σ_x e^{−εx} < ∞` over its elements.
* `exists_expansion_logDeriv`: `P'/P = Σ_x m(x) e^{−xw}` on `Re w > θ`, with
  `Σ_x ‖m(x)‖ e^{−σx} < ∞` for every `σ > θ`.
-/

open Complex Filter Topology Set Metric

noncomputable section

namespace GaloisForLFunctions.InfiniteRankPurityTheory

variable {τ : Type*} [Fintype τ]

/-! ### Exponential polynomials and their twists -/

/-- `P(w) = 1 + Σ_k c_k e^{−ℓ_k w}`. -/
def expPoly (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) : ℂ := 1 + ∑ k, c k * cexp (-(ℓ k : ℂ) * w)

/-- The derivative `P'(w) = −Σ_k c_k ℓ_k e^{−ℓ_k w}`. -/
def expPolyDeriv (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) : ℂ :=
  ∑ k, c k * (-(ℓ k : ℂ)) * cexp (-(ℓ k : ℂ) * w)

theorem re_neg_ofReal_mul (x : ℝ) (w : ℂ) : (-(x : ℂ) * w).re = -(x * w.re) := by
  rw [neg_mul, Complex.neg_re, Complex.re_ofReal_mul]

theorem norm_cexp_neg_ofReal_mul (x : ℝ) (w : ℂ) :
    ‖cexp (-(x : ℂ) * w)‖ = Real.exp (-(x * w.re)) := by
  rw [Complex.norm_exp, re_neg_ofReal_mul]

theorem hasDerivAt_expPoly (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    HasDerivAt (expPoly c ℓ) (expPolyDeriv c ℓ w) w := by
  unfold expPoly expPolyDeriv
  refine (HasDerivAt.fun_sum fun k _ => ?_).const_add 1
  have h : HasDerivAt (fun w : ℂ => cexp (-(ℓ k : ℂ) * w))
      (cexp (-(ℓ k : ℂ) * w) * (-(ℓ k : ℂ))) w := by
    simpa using ((hasDerivAt_id w).const_mul (-(ℓ k : ℂ))).cexp
  exact (h.const_mul (c k)).congr_deriv (by ring)

theorem differentiable_expPoly (c : τ → ℂ) (ℓ : τ → ℝ) : Differentiable ℂ (expPoly c ℓ) :=
  fun w => (hasDerivAt_expPoly c ℓ w).differentiableAt

theorem differentiable_expPolyDeriv (c : τ → ℂ) (ℓ : τ → ℝ) :
    Differentiable ℂ (expPolyDeriv c ℓ) := by
  intro w
  refine DifferentiableAt.fun_sum fun k _ => ?_
  exact ((differentiableAt_id.const_mul (-(ℓ k : ℂ))).cexp).const_mul _

/-- A vertical translate is a twist by unimodular numbers. -/
theorem expPoly_add_mul_I (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) (t : ℝ) :
    expPoly c ℓ (w + t * I) = expPoly (fun k => c k * cexp (-(ℓ k : ℂ) * (t * I))) ℓ w := by
  unfold expPoly
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [mul_add, Complex.exp_add]
  ring

theorem norm_twist_eq_one (x t : ℝ) : ‖cexp (-(x : ℂ) * (t * I))‖ = 1 := by
  rw [Complex.norm_exp]
  simp

theorem norm_expPoly_sub_one_le (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    ‖expPoly c ℓ w - 1‖ ≤ ∑ k, ‖c k‖ * Real.exp (-(ℓ k * w.re)) := by
  unfold expPoly
  rw [add_sub_cancel_left]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  rw [norm_mul, norm_cexp_neg_ofReal_mul]

theorem norm_expPolyDeriv_le (c : τ → ℂ) (ℓ : τ → ℝ) (w : ℂ) :
    ‖expPolyDeriv c ℓ w‖ ≤ ∑ k, ‖c k‖ * |ℓ k| * Real.exp (-(ℓ k * w.re)) := by
  unfold expPolyDeriv
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  rw [norm_mul, norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, norm_cexp_neg_ofReal_mul]

/-- The tails `Σ ‖c_k‖ e^{−ℓ_k C}` tend to zero. -/
theorem tendsto_sum_norm_mul_exp (c : τ → ℂ) {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) :
    Tendsto (fun C : ℝ => ∑ k, ‖c k‖ * Real.exp (-(ℓ k * C))) atTop (𝓝 0) := by
  have h : ∀ k ∈ (Finset.univ : Finset τ),
      Tendsto (fun C : ℝ => ‖c k‖ * Real.exp (-(ℓ k * C))) atTop (𝓝 (‖c k‖ * 0)) := fun k _ =>
    ((Real.tendsto_exp_atBot.comp (tendsto_neg_atTop_atBot.comp
      (tendsto_id.const_mul_atTop (hℓ k)))).const_mul _)
  have hs := tendsto_finsetSum Finset.univ h
  simpa using hs

/-- **The constant term dominates far to the right, uniformly in the twist.** -/
theorem exists_far_bound_expPoly (c : τ → ℂ) {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k) :
    ∃ C₀ : ℝ, 0 ≤ C₀ ∧ (∑ k, ‖c k‖ * Real.exp (-(ℓ k * C₀))) < 1 / 2 ∧
      ∀ u : τ → ℂ, (∀ k, ‖u k‖ ≤ 1) → ∀ w : ℂ, C₀ ≤ w.re →
        1 / 2 ≤ ‖expPoly (fun k => c k * u k) ℓ w‖ := by
  obtain ⟨C₀, hC₀, hC₀pos⟩ := (((tendsto_sum_norm_mul_exp c hℓ).eventually
    (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))).and (eventually_ge_atTop 0)).exists
  refine ⟨C₀, hC₀pos, hC₀, fun u hu w hw => ?_⟩
  have h1 : ‖expPoly (fun k => c k * u k) ℓ w - 1‖ ≤ ∑ k, ‖c k‖ * Real.exp (-(ℓ k * C₀)) := by
    refine (norm_expPoly_sub_one_le _ ℓ w).trans (Finset.sum_le_sum fun k _ => ?_)
    rw [norm_mul]
    refine mul_le_mul (mul_le_of_le_one_right (norm_nonneg _) (hu k)) ?_ (Real.exp_pos _).le
      (norm_nonneg _)
    exact Real.exp_le_exp.mpr (neg_le_neg (mul_le_mul_of_nonneg_left hw (hℓ k).le))
  have h2 := norm_sub_norm_le (1 : ℂ) (1 - expPoly (fun k => c k * u k) ℓ w)
  rw [sub_sub_cancel, norm_one, norm_sub_rev] at h2
  linarith

/-- **Twists converge locally uniformly when their coefficients converge.** -/
theorem tendstoLocallyUniformly_expPoly (c : τ → ℂ) (ℓ : τ → ℝ) {u : ℕ → τ → ℂ} {v : τ → ℂ}
    (huv : ∀ k, Tendsto (fun j => u j k) atTop (𝓝 (v k))) :
    TendstoLocallyUniformly (fun j => expPoly (fun k => c k * u j k) ℓ)
      (expPoly (fun k => c k * v k) ℓ) atTop := by
  rw [Metric.tendstoLocallyUniformly_iff]
  intro ε hε z₀
  refine ⟨ball z₀ 1, ball_mem_nhds z₀ one_pos, ?_⟩
  have hlim : Tendsto (fun j => ∑ k, ‖c k‖ * ‖v k - u j k‖ * Real.exp (|ℓ k| * (|z₀.re| + 1)))
      atTop (𝓝 0) := by
    have h : ∀ k ∈ (Finset.univ : Finset τ),
        Tendsto (fun j => ‖c k‖ * ‖v k - u j k‖ * Real.exp (|ℓ k| * (|z₀.re| + 1))) atTop
          (𝓝 (‖c k‖ * 0 * Real.exp (|ℓ k| * (|z₀.re| + 1)))) := fun k _ => by
      have h0 : Tendsto (fun j => ‖v k - u j k‖) atTop (𝓝 0) := by
        have := (tendsto_const_nhds (x := v k)).sub (huv k)
        rw [sub_self] at this
        exact tendsto_norm_zero.comp this
      exact (h0.const_mul _).mul_const _
    have hs := tendsto_finsetSum Finset.univ h
    simpa using hs
  filter_upwards [hlim.eventually (gt_mem_nhds hε)] with j hj z hz
  rw [dist_eq_norm]
  refine lt_of_le_of_lt ?_ hj
  have hre : |z.re - z₀.re| < 1 := by
    have h := (abs_re_le_norm (z - z₀)).trans_lt (mem_ball_iff_norm.mp hz)
    rwa [sub_re] at h
  unfold expPoly
  rw [add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
  have hpt : c k * v k * cexp (-(ℓ k : ℂ) * z) - c k * u j k * cexp (-(ℓ k : ℂ) * z)
      = c k * (v k - u j k) * cexp (-(ℓ k : ℂ) * z) := by ring
  rw [hpt, norm_mul, norm_mul, norm_cexp_neg_ofReal_mul]
  refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
  have h1 := abs_lt.mp hre
  have h2 : |z.re| ≤ |z₀.re| + 1 := by
    rw [abs_le]
    constructor <;> linarith [neg_abs_le z₀.re, le_abs_self z₀.re]
  calc -(ℓ k * z.re) ≤ |ℓ k * z.re| := neg_le_abs _
    _ = |ℓ k| * |z.re| := abs_mul _ _
    _ ≤ |ℓ k| * (|z₀.re| + 1) := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)

/-- **A zero-free exponential polynomial is bounded below.** With no zeros in `Re w > θ`, it is
bounded away from zero on `Re w ≥ σ` for every `σ > θ`. -/
theorem exists_le_norm_expPoly_of_zeroFree {c : τ → ℂ} {ℓ : τ → ℝ} (hℓ : ∀ k, 0 < ℓ k)
    {θ σ : ℝ} (hσ : θ < σ) (hzero : ∀ w : ℂ, θ < w.re → expPoly c ℓ w ≠ 0) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ w : ℂ, σ ≤ w.re → δ ≤ ‖expPoly c ℓ w‖ := by
  obtain ⟨C₀, -, -, hfar⟩ := exists_far_bound_expPoly c hℓ
  have hone : ∀ w : ℂ, expPoly (fun k => c k * (1 : ℂ)) ℓ w = expPoly c ℓ w := fun w => by
    simp only [mul_one]
  by_contra hcon
  have hseq : ∀ j : ℕ, ∃ s : ℂ, σ ≤ s.re ∧
      ‖expPoly c ℓ s‖ < min (1 / 2) (1 / ((j : ℝ) + 1)) := by
    intro j
    by_contra hj
    refine hcon ⟨min (1 / 2) (1 / ((j : ℝ) + 1)), lt_min (by norm_num) (by positivity),
      fun s hs => ?_⟩
    by_contra hlt
    exact hj ⟨s, hs, not_le.mp hlt⟩
  choose s hsσ hsD using hseq
  have hsC : ∀ j, (s j).re ≤ C₀ := by
    intro j
    by_contra h
    have h1 := hfar (fun _ => 1) (fun _ => by simp) (s j) (not_le.mp h).le
    rw [hone] at h1
    exact absurd ((hsD j).trans_le (min_le_left _ _)) (not_lt.mpr h1)
  set U : ℕ → τ → ℂ := fun j k => cexp (-(ℓ k : ℂ) * ((s j).im * I)) with hU
  have hK : IsCompact (Icc σ C₀ ×ˢ (Set.pi univ fun _ : τ => closedBall (0 : ℂ) 1)) :=
    isCompact_Icc.prod (isCompact_univ_pi fun _ => isCompact_closedBall 0 1)
  have hxK : ∀ j, ((s j).re, U j) ∈
      Icc σ C₀ ×ˢ (Set.pi univ fun _ : τ => closedBall (0 : ℂ) 1) := fun j =>
    ⟨⟨hsσ j, hsC j⟩, fun k _ => mem_closedBall_zero_iff.mpr (norm_twist_eq_one _ _).le⟩
  obtain ⟨⟨x, v⟩, hmem, φ, hφ, hlim⟩ := hK.tendsto_subseq hxK
  have hx : Tendsto (fun j => (s (φ j)).re) atTop (𝓝 x) :=
    (continuous_fst.tendsto _).comp hlim
  have hv : ∀ k, Tendsto (fun j => U (φ j) k) atTop (𝓝 (v k)) :=
    tendsto_pi_nhds.mp ((continuous_snd.tendsto _).comp hlim)
  have hvle : ∀ k, ‖v k‖ ≤ 1 := fun k => mem_closedBall_zero_iff.mp (hmem.2 k (mem_univ k))
  have hxσ : σ ≤ x := hmem.1.1
  have hconv := tendstoLocallyUniformly_expPoly c ℓ hv
  have hgd := differentiable_expPoly (fun k => c k * v k) ℓ
  have hgx : expPoly (fun k => c k * v k) ℓ (x : ℂ) = 0 := by
    have h1 : Tendsto (fun j => expPoly (fun k => c k * U (φ j) k) ℓ (((s (φ j)).re : ℝ) : ℂ)) atTop
        (𝓝 (expPoly (fun k => c k * v k) ℓ (x : ℂ))) :=
      hconv.tendsto_comp hgd.continuous.continuousAt
        ((Complex.continuous_ofReal.tendsto x).comp hx)
    have h2 : Tendsto (fun j => expPoly (fun k => c k * U (φ j) k) ℓ (((s (φ j)).re : ℝ) : ℂ)) atTop
        (𝓝 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      have hbound : ∀ j, ‖expPoly (fun k => c k * U (φ j) k) ℓ (((s (φ j)).re : ℝ) : ℂ)‖
          ≤ 1 / ((j : ℝ) + 1) := by
        intro j
        rw [hU, ← expPoly_add_mul_I, Complex.re_add_im]
        refine ((hsD (φ j)).trans_le (min_le_right _ _)).le.trans ?_
        have hj : (j : ℝ) ≤ φ j := by exact_mod_cast hφ.id_le j
        exact one_div_le_one_div_of_le (by positivity) (by linarith)
      exact squeeze_zero (fun _ => norm_nonneg _) hbound tendsto_one_div_add_atTop_nhds_zero_nat
    exact tendsto_nhds_unique h1 h2
  have hgC : expPoly (fun k => c k * v k) ℓ (C₀ : ℂ) ≠ 0 := by
    have h := hfar v hvle (C₀ : ℂ) (by simp)
    exact norm_pos_iff.mp (lt_of_lt_of_le (by norm_num) h)
  obtain ⟨j, w, hw, hwz⟩ := (FiniteFreeProbability.eventually_exists_zero_of_tendstoLocallyUniformly
    hconv (fun j => differentiable_expPoly _ ℓ) hgd hgC hgx (sub_pos.mpr hσ)).exists
  rw [hU, ← expPoly_add_mul_I] at hwz
  refine hzero _ ?_ hwz
  have h := abs_lt.mp ((abs_re_le_norm (w - (x : ℂ))).trans_lt (mem_ball_iff_norm.mp hw))
  rw [sub_re, Complex.ofReal_re] at h
  simp only [add_re, mul_re, Complex.ofReal_re, Complex.I_re, mul_zero, Complex.ofReal_im,
    Complex.I_im, mul_one, sub_self, add_zero]
  linarith [h.1]

end GaloisForLFunctions.InfiniteRankPurityTheory
