import GaloisForLFunctions.HeckeKreinToeplitz.TheArchimedeanCompletionCarriesTheSameIndex
import GaloisForLFunctions.HeckeKreinToeplitz.TheFiniteIndexStratumOfZetaIsLindelofDeep

/-!
# Fine towers decide every orbit kernel

The cyclic Hasse principle (`CyclicSubgroupsDecideTheKreinLangerClass`) needs finitely many pairs. For
the kernels of arithmetic, with possibly infinitely many pairs, the archimedean place supplies a
different mechanism: the kernel is a continuous function of the logarithmic scale, and cyclic
subgroups with generators close to `1` are fine grids of `ℝ`.

**Fine grids decide continuous kernels** (`hermQuad_nonneg_of_fine_zpowers`). On `ℝ_{>0}`, if a kernel
continuous in `log` has nonnegative Toeplitz forms on the cyclic subgroups generated by `e^{s_n}`,
`s_n → 0`, `s_n ≠ 0`, then all its Toeplitz forms are nonnegative: round each point `t_a` to the grid,
`N_a s_n → t_a`, and pass to the limit in the Gram entries.

**Orbit kernels are continuous** (`continuous_realOrbitKernel`). On a tempered configuration the
orbit kernel `t ↦ Σ_ρ e^{−t(ρ−½)} W_ρ` converges uniformly on compact sets, since zeros lie in the
strip and the Weil summands are absolutely summable.

**Consecutive-integer towers decide** (`isPosDefKernel_orbitKernel_of_consecutive`,
`riemannHypothesis_iff_zetaKernel_consecutive`). For every tempered configuration and real test, the
orbit kernel on `ℚ_{>0}` is positive definite iff it is positive definite on each cyclic subgroup
`⟨(n+2)/(n+1)⟩`; for `ζ` this is RH. Prime towers are coarse grids (spacing `log p ≥ log 2`) and
alias; the towers of consecutive-integer ratios are fine and do not. Cyclic locality holds for the
arithmetic kernels with any number of pairs, through the archimedean place.
-/

open Complex Finset Filter Topology Zeta23
open GaloisForLFunctions.HTGeometry GaloisForLFunctions.HeckeKreinToeplitz
open GaloisForLFunctions.ArithmeticCastelnuovoSeveri (cx realTests cx_contDiff cx_hasCompactSupport
  summable_norm_Wsummand abs_im_gammaOf_le)
open GaloisForLFunctions.SquareRootThreshold (TemperedConfig temperedConfig_zetaZeroConfig)

noncomputable section

namespace GaloisForLFunctions.ArithmeticKreinLangerTheory

/-! ### Fine grids decide continuous kernels -/

/-- **Fine grids decide continuous kernels.** If `t ↦ k(e^t)` is continuous and `k` has nonnegative
Toeplitz forms on the cyclic subgroups `⟨e^{s_n}⟩`, `s_n → 0`, `s_n ≠ 0`, then every Toeplitz form of
`k` is nonnegative. -/
theorem hermQuad_nonneg_of_fine_zpowers {k : Multiplicative ℝ → ℂ}
    (hc : Continuous fun t : ℝ => k (Multiplicative.ofAdd t)) {s : ℕ → ℝ}
    (hs : Tendsto s atTop (𝓝 0)) (hs0 : ∀ n, s n ≠ 0)
    (h : ∀ n (m : ℕ) (y : Fin m → Multiplicative ℤ) (c : Fin m → ℂ),
      0 ≤ hermQuad (gram (k ∘ zpowersHom _ (Multiplicative.ofAdd (s n))) y) c)
    {m : ℕ} (x : Fin m → Multiplicative ℝ) (c : Fin m → ℂ) : 0 ≤ hermQuad (gram k x) c := by
  set t : Fin m → ℝ := fun a => Multiplicative.toAdd (x a)
  set N : ℕ → Fin m → ℤ := fun n a => round (t a / s n)
  -- the rounded grid points converge to the original points
  have hgrid : ∀ a, Tendsto (fun n => (N n a : ℝ) * s n) atTop (𝓝 (t a)) := fun a => by
    have hb : ∀ n, |(N n a : ℝ) * s n - t a| ≤ |s n| / 2 := fun n => by
      have h1 := abs_sub_round (t a / s n)
      have : (N n a : ℝ) * s n - t a = -((t a / s n - round (t a / s n)) * s n) := by
        field_simp [hs0 n]; ring
      rw [this, abs_neg, abs_mul]
      nlinarith [abs_nonneg (s n)]
    have h0 : Tendsto (fun n => |s n| / 2) atTop (𝓝 0) := by
      have := ((continuous_abs.tendsto (0 : ℝ)).comp hs).div_const 2
      simpa [Function.comp_def] using this
    exact tendsto_sub_nhds_zero_iff.mp (squeeze_zero_norm (fun n => by
      rw [Real.norm_eq_abs]; exact hb n) h0)
  -- the forms on the grids are nonnegative
  have hpos : ∀ n, 0 ≤ hermQuad (gram k fun a => Multiplicative.ofAdd ((N n a : ℝ) * s n)) c :=
    fun n => by
      have := h n m (fun a => Multiplicative.ofAdd (N n a)) c
      convert this using 2
      ext a b
      simp only [gram, Function.comp_apply, zpowersHom_apply]
      congr 1
      apply Multiplicative.toAdd.injective
      simp only [toAdd_mul, toAdd_inv, toAdd_ofAdd, toAdd_zpow]
      ring
  -- the Gram entries converge
  have hentry : ∀ a b, Tendsto (fun n => k ((Multiplicative.ofAdd ((N n a : ℝ) * s n))⁻¹ *
      Multiplicative.ofAdd ((N n b : ℝ) * s n))) atTop (𝓝 (k ((x a)⁻¹ * x b))) := fun a b => by
    have hlim := ((hgrid b).sub (hgrid a))
    have := (hc.tendsto _).comp hlim
    convert this using 2 with n
    · simp only [Function.comp_apply]
      congr 1
      apply Multiplicative.toAdd.injective
      simp [toAdd_mul, toAdd_inv]; ring
    · congr 1
      apply Multiplicative.toAdd.injective
      simp [toAdd_mul, toAdd_inv, t]; ring
  refine ge_of_tendsto (x := (atTop : Filter ℕ)) ?_ (Eventually.of_forall hpos)
  simp only [hermQuad_gram]
  exact (Complex.continuous_re.tendsto _).comp (tendsto_finsetSum _ fun a _ =>
    tendsto_finsetSum _ fun b _ => (tendsto_const_nhds.mul (hentry a b)).mul tendsto_const_nhds)

/-! ### Orbit kernels are continuous -/

/-- **The orbit kernel is continuous in the logarithmic scale.** -/
theorem continuous_realOrbitKernel (Z : ZeroConfig) (hZ : TemperedConfig Z) {f : ℝ → ℝ}
    (hf : f ∈ realTests) : Continuous fun t : ℝ => realOrbitKernel Z f (Multiplicative.ofAdd t) := by
  have heq : (fun t : ℝ => realOrbitKernel Z f (Multiplicative.ofAdd t)) = fun t : ℝ =>
      ∑' ρ : Z.carrier, cexp (-(t : ℂ) * ((ρ : ℂ) - 1 / 2)) * Z.Wsummand (cx f) (cx f) ρ := by
    funext t
    rw [realOrbitKernel_eq, W_shiftTest_shiftTest]
    refine tsum_congr fun ρ => ?_
    simp
  rw [heq]
  have hsum := summable_norm_Wsummand Z hZ (cx_contDiff hf.1) (cx_hasCompactSupport hf.2)
    (cx_contDiff hf.1) (cx_hasCompactSupport hf.2)
  refine continuous_iff_continuousAt.mpr fun t₀ => ?_
  set T := |t₀| + 1 with hT
  have hon : ContinuousOn (fun t : ℝ => ∑' ρ : Z.carrier,
      cexp (-(t : ℂ) * ((ρ : ℂ) - 1 / 2)) * Z.Wsummand (cx f) (cx f) ρ) (Set.Ioo (-T) T) := by
    refine continuousOn_tsum (fun ρ => Continuous.continuousOn (by fun_prop))
      (hsum.mul_left (Real.exp (T / 2))) fun ρ t ht => ?_
    rw [norm_mul, Complex.norm_exp]
    refine mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) (norm_nonneg _)
    have hρ := abs_im_gammaOf_le Z ρ
    have hγ : (gammaOf ρ).im = 1 / 2 - (ρ : ℂ).re := by
      simp [gammaOf]
    rw [hγ] at hρ
    have ht' := abs_lt.mpr ⟨ht.1, ht.2⟩
    have hre : (-(t : ℂ) * ((ρ : ℂ) - 1 / 2)).re = -(t * ((ρ : ℂ).re - 1 / 2)) := by
      simp [Complex.mul_re]
    rw [hre]
    calc -(t * ((ρ : ℂ).re - 1 / 2)) ≤ |t * ((ρ : ℂ).re - 1 / 2)| := neg_le_abs _
      _ = |t| * |1 / 2 - (ρ : ℂ).re| := by rw [abs_mul, abs_sub_comm]
      _ ≤ T * (1 / 2) := mul_le_mul ht'.le hρ (abs_nonneg _) (by positivity)
      _ = T / 2 := by ring
  exact hon.continuousAt (Ioo_mem_nhds (by rw [hT]; linarith [neg_abs_le t₀])
    (by rw [hT]; linarith [le_abs_self t₀]))

/-! ### Consecutive-integer towers -/

/-- The consecutive-integer ratio `(n+2)/(n+1)` as an element of `ℚ_{>0}`. -/
def consecutiveRatio (n : ℕ) : HeckeLattice := ⟨((n : ℚ) + 2) / ((n : ℚ) + 1), by positivity⟩

theorem scale_consecutiveRatio (n : ℕ) :
    scale heckeLogScale (consecutiveRatio n) = Real.log (((n : ℝ) + 2) / ((n : ℝ) + 1)) := by
  rw [scale_heckeLogScale]; simp [consecutiveRatio]

theorem scale_consecutiveRatio_pos (n : ℕ) : 0 < scale heckeLogScale (consecutiveRatio n) := by
  rw [scale_consecutiveRatio]
  exact Real.log_pos ((one_lt_div (by positivity)).mpr (by linarith))

theorem tendsto_scale_consecutiveRatio :
    Tendsto (fun n => scale heckeLogScale (consecutiveRatio n)) atTop (𝓝 0) := by
  have h : Tendsto (fun n : ℕ => ((n : ℝ) + 2) / ((n : ℝ) + 1)) atTop (𝓝 1) := by
    have : (fun n : ℕ => ((n : ℝ) + 2) / ((n : ℝ) + 1)) = fun n : ℕ => 1 + 1 / ((n : ℝ) + 1) := by
      funext n; field_simp; ring
    rw [this]
    simpa using (tendsto_const_nhds (x := (1 : ℝ))).add
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  simp only [scale_consecutiveRatio]
  simpa [Function.comp_def] using (Real.continuousAt_log one_ne_zero).tendsto.comp h

/-- **Consecutive-integer towers decide every orbit kernel.** On a tempered configuration, an orbit
kernel positive definite on every cyclic subgroup `⟨(n+2)/(n+1)⟩` is positive definite. -/
theorem isPosDefKernel_orbitKernel_of_consecutive (Z : ZeroConfig) (hZ : TemperedConfig Z)
    {f : ℝ → ℝ} (hf : f ∈ realTests)
    (h : ∀ n, IsPosDefKernel (orbitKernel Z f ∘ zpowersHom _ (consecutiveRatio n))) :
    IsPosDefKernel (orbitKernel Z f) := by
  refine ⟨isHermKernel_orbitKernel Z f, fun m x c => ?_⟩
  have hreal : ∀ (n m : ℕ) (y : Fin m → Multiplicative ℤ) (c : Fin m → ℂ),
      0 ≤ hermQuad (gram (realOrbitKernel Z f ∘ zpowersHom _
        (Multiplicative.ofAdd (scale heckeLogScale (consecutiveRatio n)))) y) c := by
    intro n m y c
    have := (h n).hermQuad_nonneg y c
    convert this using 3
    funext v
    simp only [Function.comp_apply, zpowersHom_apply, ← realOrbitKernel_comp_heckeLogScale,
      map_zpow]
    rfl
  have := hermQuad_nonneg_of_fine_zpowers (continuous_realOrbitKernel Z hZ hf)
    tendsto_scale_consecutiveRatio (fun n => (scale_consecutiveRatio_pos n).ne') hreal
    (fun a => heckeLogScale (x a)) c
  convert this using 2
  ext a b
  simp only [gram, ← realOrbitKernel_comp_heckeLogScale, Function.comp_apply, map_mul, map_inv]

/-- **RH is positivity of the Weil kernel on the consecutive-integer towers.** -/
theorem riemannHypothesis_iff_zetaKernel_consecutive :
    RiemannHypothesis ↔ ∀ n, IsPosDefKernel (zetaKernel ∘ zpowersHom _ (consecutiveRatio n)) := by
  rw [riemannHypothesis_iff_negIndex_zetaKernel_eq_zero]
  constructor
  · intro h0 n
    exact ((isPosDefKernel_iff (isHermKernel_orbitKernel _ _)).mpr h0).comp _
  · intro h
    exact (isPosDefKernel_orbitKernel_of_consecutive _ temperedConfig_zetaZeroConfig
      cubicSpline_mem_realTests h).negIndex_eq_zero

end GaloisForLFunctions.ArithmeticKreinLangerTheory
