import GaloisForLFunctions.ArithmeticPositiveDuality.TheLiouvilleLawForTwoCommutingTranslations
import GaloisForLFunctions.RHTower.TwoDilationDivisorMetric
import GaloisForLFunctions.RHTower.WeilLagFunctionDense
import Mathlib.NumberTheory.Chebyshev

/-!
# The harmonic nullspace of the prime midpoint

Division by scale turns the homogeneous midpoint equation into a two-point
walk of weights 1/3 and 2/3. Its two translations generate the same subgroup
as log 2 and log 3. The only bounded continuous normalized profiles invisible
at every scale are constants.
-/

noncomputable section
open GaloisForLFunctions.ArithmeticPositiveDuality.TranslationLaw
namespace GaloisForLFunctions.ExceptionalLayerTheory.FactorialInterval

private def lowStep : ℝ := Real.log 2 - Real.log 3
private def highStep : ℝ := 2*Real.log 2 - Real.log 3

/-- Without any continuity, the nullspace consists exactly of functions
constant on the cosets of the subgroup generated by log 2 and log 3. -/
theorem midpoint_harmonic_iff_log_periods (f : ℝ → ℝ) (hbd : ∃ M : ℝ, ∀ x, f x^2 ≤ M) :
    (∀ x, f x = f (x+(Real.log 2-Real.log 3))/3 +
      2*f (x+(2*Real.log 2-Real.log 3))/3) ↔
      ∀ x, f (x+Real.log 2)=f x ∧ f (x+Real.log 3)=f x := by
  let F := fun t => (f t : ℂ)
  let P := _root_.RHTower.periodAddSubgroup F
  have hlow : Real.log 2-lowStep=Real.log 3 := by unfold lowStep; ring
  have hhigh : highStep-lowStep=Real.log 2 := by unfold highStep lowStep; ring
  have hw := bounded_harmonic_iff (1/3) (by constructor <;> norm_num) lowStep highStep f hbd
  constructor
  · intro h
    have hmean : mean (1/3) lowStep highStep f = f := by
      funext x
      unfold mean lowStep highStep
      linarith only [h x]
    have he := hw.mp hmean
    have ha : lowStep ∈ P := fun x => congrArg Complex.ofReal (he x).1
    have hb : highStep ∈ P := fun x => congrArg Complex.ofReal (he x).2
    have h₂ : Real.log 2 ∈ P := hhigh ▸ P.sub_mem hb ha
    have h₃ : Real.log 3 ∈ P := hlow ▸ P.sub_mem h₂ ha
    exact fun x => ⟨Complex.ofReal_injective (h₂ x),Complex.ofReal_injective (h₃ x)⟩
  · intro h
    have h₂ : Real.log 2 ∈ P := fun x => congrArg Complex.ofReal (h x).1
    have h₃ : Real.log 3 ∈ P := fun x => congrArg Complex.ofReal (h x).2
    have ha : lowStep ∈ P := P.sub_mem h₂ h₃
    have hb : highStep ∈ P := by
      rw [show highStep=Real.log 2+lowStep by unfold highStep lowStep; ring]
      exact P.add_mem h₂ ha
    have he := hw.mpr fun x => ⟨Complex.ofReal_injective (ha x),Complex.ofReal_injective (hb x)⟩
    intro x
    have hx := congrFun he x
    unfold mean lowStep highStep at hx
    linarith only [hx]

/-- Complete bounded continuous harmonic nullspace on the logarithmic scale. -/
theorem midpoint_harmonic_iff_constant (f : ℝ → ℝ) (hc : Continuous f)
    (hbd : ∃ M : ℝ, ∀ x, f x^2 ≤ M) :
    (∀ x, f x = f (x + (Real.log 2-Real.log 3))/3 +
      2*f (x + (2*Real.log 2-Real.log 3))/3) ↔ ∀ x, f x = f 0 := by
  rw [midpoint_harmonic_iff_log_periods f hbd]
  constructor
  · intro h
    let F := fun t => (f t : ℂ)
    let P := _root_.RHTower.periodAddSubgroup F
    have hle : AddSubgroup.closure {Real.log (2:ℝ), Real.log 3} ≤ P := by
      rw [AddSubgroup.closure_le]
      intro t ht
      rcases Set.mem_insert_iff.mp ht with rfl | ht
      · exact fun x => congrArg Complex.ofReal (h x).1
      · rw [Set.mem_singleton_iff.mp ht]
        exact fun x => congrArg Complex.ofReal (h x).2
    have hd := _root_.RHTower.dense_addSubgroup_log_primes Nat.prime_two Nat.prime_three (by norm_num)
    exact fun x => Complex.ofReal_injective (_root_.RHTower.eq_of_continuous_of_dense_periods
      (Complex.continuous_ofReal.comp hc) (hd.mono hle) x 0)
  · exact fun h x => ⟨(h _).trans (h x).symm,(h _).trans (h x).symm⟩

/-- A continuous price bounded by a linear function on the entire positive axis
has zero midpoint at every dilation precisely when it is linear. -/
theorem linear_growth_midpoint_kernel (F : ℝ → ℝ) (hc : ContinuousOn F (Set.Ioi 0))
    (hbd : ∃ M : ℝ, ∀ y : ℝ, 0 < y → (F y/y)^2 ≤ M) :
    (∀ y : ℝ, 0 < y → 2*F (3*y) = F (2*y) + F (4*y)) ↔
      ∀ y : ℝ, 0 < y → F y = y*F 1 := by
  let f := fun x => F (Real.exp x)/Real.exp x
  have hf : Continuous f :=
    (hc.comp_continuous Real.continuous_exp (fun t => Real.exp_pos t)).div
      Real.continuous_exp (fun x => (Real.exp_pos x).ne')
  obtain ⟨M,hM⟩ := hbd
  have hscale (x : ℝ) :
      Real.exp (x+(Real.log 2-Real.log 3)) = 2*Real.exp x/3 ∧
      Real.exp (x+(2*Real.log 2-Real.log 3)) = 4*Real.exp x/3 := by
    rw [show 2*Real.log 2=Real.log 2+Real.log 2 by ring]
    simp only [Real.exp_add, Real.exp_sub, Real.exp_log (by norm_num : (0:ℝ)<2),
      Real.exp_log (by norm_num : (0:ℝ)<3)]
    constructor <;> ring
  constructor
  · intro h
    have hh (x : ℝ) := h (Real.exp x/3) (by positivity)
    have harm (x : ℝ) : f x = f (x + (Real.log 2-Real.log 3))/3 +
        2*f (x + (2*Real.log 2-Real.log 3))/3 := by
      dsimp only [f]
      rw [(hscale x).1,(hscale x).2]
      have he := hh x
      rw [show 3*(Real.exp x/3)=Real.exp x by ring,
        show 2*(Real.exp x/3)=2*Real.exp x/3 by ring,
        show 4*(Real.exp x/3)=4*Real.exp x/3 by ring] at he
      calc _ = (F (2*Real.exp x/3)+F (4*Real.exp x/3))/(2*Real.exp x) := by
                  rw [← he]
                  field_simp
           _ = _ := by field_simp [(Real.exp_pos x).ne']; ring
    have hz := (midpoint_harmonic_iff_constant f hf ⟨M,fun x => hM _ (Real.exp_pos x)⟩).mp harm
    intro y hy
    have he := hz (Real.log y)
    simp only [f, Real.exp_log hy, Real.exp_zero, div_one] at he
    simpa only [mul_comm] using (div_eq_iff hy.ne').mp he
  · intro h y hy
    rw [h _ (by positivity : 0<3*y), h _ (by positivity : 0<2*y), h _ (by positivity : 0<4*y)]
    ring

/-- Adding the same continuous perturbation to the prime counting price at
every positive scale leaves all real midpoint prices invariant exactly for
linear perturbations. -/
theorem prime_midpoint_invisible_perturbation (F : ℝ → ℝ) (hc : ContinuousOn F (Set.Ioi 0))
    (hbd : ∃ M : ℝ, ∀ y : ℝ, 0 < y → (F y/y)^2 ≤ M) :
    (∀ y : ℝ, 0 < y →
      2*(Chebyshev.theta (3*y)+F (3*y))-(Chebyshev.theta (2*y)+F (2*y))-
        (Chebyshev.theta (4*y)+F (4*y)) =
      2*Chebyshev.theta (3*y)-Chebyshev.theta (2*y)-Chebyshev.theta (4*y)) ↔
      ∀ y : ℝ, 0 < y → F y = y*F 1 := by
  rw [← linear_growth_midpoint_kernel F hc hbd]
  constructor <;> intro h y hy <;> linarith only [h y hy]

/-- Unit tent on a single gap of the integer sampling grid. -/
private def gapTent (j : ℕ) (y : ℝ) : ℝ :=
  2*max 0 (min (y-j) ((j:ℝ)+1-y))

private lemma gapTent_at_integer (j m : ℕ) : gapTent j m = 0 := by
  unfold gapTent
  rw [max_eq_left, mul_zero]
  rcases le_or_gt m j with h | h
  · exact (min_le_left _ _).trans (sub_nonpos.mpr (Nat.cast_le.mpr h))
  · exact (min_le_right _ _).trans (sub_nonpos.mpr (by exact_mod_cast h))

private lemma gapTent_cardinal (j m : ℕ) :
    gapTent j ((m:ℝ)+1/2) = if j=m then 1 else 0 := by
  by_cases h : j=m
  · subst m
    rw [if_pos rfl,gapTent,show (j:ℝ)+1/2-j=1/2 by ring,
      show (j:ℝ)+1-(j+1/2)=1/2 by ring,min_self]
    norm_num
  · rw [if_neg h, gapTent, max_eq_left, mul_zero]
    rcases lt_or_gt_of_ne h with hl | hl
    · have hd : (j:ℝ)+1 ≤ m := by exact_mod_cast hl
      exact (min_le_right _ _).trans (by linarith only [hd])
    · have hd : (m:ℝ)+1 ≤ j := by exact_mod_cast hl
      exact (min_le_left _ _).trans (by linarith only [hd])

/-- Integer midpoint observations allow arbitrary, independently chosen values
at any finite collection of half-integers, even for a continuous perturbation
vanishing at every integer. -/
theorem integer_midpoint_hidden_interpolation (S : Finset ℕ) (v : ℕ → ℝ) :
    ∃ F : ℝ → ℝ, Continuous F ∧ (∀ m : ℕ, F m=0) ∧
      (∃ M : ℝ, ∀ y : ℝ, 0 < y → (F y/y)^2 ≤ M) ∧
      (∀ j ∈ S, F ((j:ℝ)+1/2)=v j) ∧
      ∀ n : ℕ, 2*F (3*n:ℕ)-F (2*n:ℕ)-F (4*n:ℕ)=0 := by
  let F := fun y : ℝ => ∑ j ∈ S, v j * gapTent j y
  have hgrid (m : ℕ) : F m = 0 := by simp only [F, gapTent_at_integer, mul_zero, Finset.sum_const_zero]
  refine ⟨F, ?_, hgrid, ?_, ?_, fun n => by rw [hgrid,hgrid,hgrid]; ring⟩
  · unfold F gapTent
    fun_prop
  · refine ⟨(2*∑ j ∈ S, |v j|)^2, fun y hy => ?_⟩
    have htent (j : ℕ) : |gapTent j y| ≤ 2*y := by
      unfold gapTent
      rw [abs_of_nonneg (mul_nonneg (by norm_num) (le_max_left _ _))]
      exact mul_le_mul_of_nonneg_left (max_le hy.le
        ((min_le_left _ _).trans (sub_le_self _ (Nat.cast_nonneg j)))) (by norm_num)
    have hF : |F y| ≤ (2*∑ j ∈ S, |v j|)*y := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc _ ≤ ∑ j ∈ S, |v j| * (2*y) := Finset.sum_le_sum fun j _ => by
             rw [abs_mul]; exact mul_le_mul_of_nonneg_left (htent j) (abs_nonneg _)
           _ = _ := by rw [← Finset.sum_mul]; ring
    rw [sq_le_sq,abs_div,abs_of_pos hy,abs_of_nonneg (by positivity : 0 ≤ 2*∑ j ∈ S, |v j|)]
    exact (div_le_iff₀ hy).mpr hF
  · intro j hj
    simp only [F, gapTent_cardinal, mul_ite, mul_one, mul_zero]
    simp [hj]

#print axioms integer_midpoint_hidden_interpolation
#print axioms midpoint_harmonic_iff_constant
#print axioms linear_growth_midpoint_kernel

/-- The origin and the outer band [B,4B/3] control a subharmonic price
throughout [0,B]. A positive interior maximum would propagate to a
strictly smaller maximizer under the lower dilation. -/
theorem dilation_band_maximum {f : ℝ → ℝ} {B : ℝ} (hB : 0<B)
    (hc : ContinuousOn f (Set.Icc 0 (4*B/3))) (h₀ : f 0 ≤ 0)
    (hm : ∀ y : ℝ, 0<y → y<B → 2*f y ≤ f (2*y/3)+f (4*y/3))
    (hband : ∀ y ∈ Set.Icc B (4*B/3), f y ≤ 0) :
    ∀ y ∈ Set.Icc 0 B, f y ≤ 0 := by
  let D := Set.Icc 0 (4*B/3)
  have hD : IsCompact D := isCompact_Icc
  obtain ⟨z,hz,hmax⟩ := hD.exists_isMaxOn ⟨0,le_rfl,by positivity⟩ hc
  let K := {x ∈ D | f x=f z}
  have hK : IsCompact K := hD.of_isClosed_subset
    (isClosed_Icc.isClosed_eq hc continuousOn_const) (fun _ hx => hx.1)
  obtain ⟨x,hx,hmin⟩ := hK.exists_isLeast ⟨z,hz,rfl⟩
  intro y hy
  by_contra! hpos
  have htop := (isMaxOn_iff.mp hmax) y ⟨hy.1,by linarith only [hy.2,hB]⟩
  have hpx : 0 < f x := hx.2.symm ▸ hpos.trans_le htop
  have hx₀ : 0<x := lt_of_le_of_ne hx.1.1 (fun he => hpx.not_ge (he ▸ h₀))
  have hxB : x<B := lt_of_not_ge fun h => hpx.not_ge (hband x ⟨h,hx.1.2⟩)
  have hlow : 2*x/3 ∈ D := ⟨by positivity,by linarith only [hxB,hB]⟩
  have hhigh : 4*x/3 ∈ D := ⟨by positivity,by linarith only [hxB]⟩
  have he : f (2*x/3)=f z := le_antisymm ((isMaxOn_iff.mp hmax) _ hlow)
    (by linarith only [hm x hx₀ hxB,hx.2,(isMaxOn_iff.mp hmax) _ hhigh])
  have hle : x ≤ 2*x/3 := hmin ⟨hlow,he⟩
  linarith only [hx₀,hle]

/-- Comparison with an affine function needs only the origin and one outer band. -/
theorem midpoint_affine_barrier {F : ℝ → ℝ} (hc : ContinuousOn F (Set.Ici 0))
    (hh : ∀ y : ℝ, 0<y → 2*F (3*y)=F (2*y)+F (4*y)) {B x : ℝ}
    (hB : 0<B) (hx : x ∈ Set.Icc 0 B) (c d e : ℝ) (h₀ : c*F 0+e≤0)
    (hband : ∀ y ∈ Set.Icc B (4*B/3), c*F y+d*y+e≤0) : c*F x+d*x+e≤0 := by
  apply dilation_band_maximum (f:=fun t => c*F t+d*t+e) hB
    (((continuousOn_const.mul (hc.mono (fun _ ht => ht.1))).add
      (continuousOn_const.mul continuousOn_id)).add continuousOn_const)
    (by simpa only [mul_zero,add_zero] using h₀) _ hband x hx
  intro y hy _
  have hmean : 2*F y=F (2*y/3)+F (4*y/3) := by
    simpa only [show 3*(y/3)=y by ring,show 2*(y/3)=2*y/3 by ring,
      show 4*(y/3)=4*y/3 by ring] using hh (y/3) (by positivity)
  linarith only [congrArg (c*·) hmean]

/-- A monotone harmonic price vanishing at zero lies between the two
linear barriers determined by its outer band. -/
theorem midpoint_slope_enclosure {F : ℝ → ℝ} (hc : ContinuousOn F (Set.Ici 0))
    (hmono : MonotoneOn F (Set.Ici 0)) (h₀ : F 0=0)
    (hh : ∀ y : ℝ, 0<y → 2*F (3*y)=F (2*y)+F (4*y)) {B x : ℝ}
    (hB : 0<B) (hx : x ∈ Set.Icc 0 B) :
    3*F B*x ≤ 4*B*F x ∧ B*F x ≤ F (4*B/3)*x := by
  have hF (y : ℝ) (hy : 0≤y) : 0 ≤ F y := by
    rw [← h₀]
    exact hmono (show (0:ℝ)≤0 from le_rfl) hy hy
  have barrier (c d : ℝ) (hband : ∀ y ∈ Set.Icc B (4*B/3), c*F y+d*y ≤ 0) :
      c*F x+d*x ≤ 0 := by
    simpa only [add_zero] using midpoint_affine_barrier hc hh hB hx c d 0
      (by simp [h₀]) (by simpa only [add_zero] using hband)
  constructor
  · have he := barrier (-(4*B)) (3*F B) (fun y hy => by
      have h₁ := mul_le_mul_of_nonneg_left (show 3*y≤4*B by linarith only [hy.2]) (hF B hB.le)
      have h₂ := mul_le_mul_of_nonneg_left (hmono hB.le (hB.le.trans hy.1) hy.1)
        (by positivity : 0≤4*B)
      linarith only [h₁,h₂])
    linarith only [he]
  · have he := barrier B (-F (4*B/3)) (fun y hy => by
      have ht : (0:ℝ) ≤ 4*B/3 := by positivity
      have h₁ := mul_le_mul_of_nonneg_left (hmono (hB.le.trans hy.1) ht hy.2) hB.le
      have h₂ := mul_le_mul_of_nonneg_right hy.1 (hF (4*B/3) ht)
      linarith only [h₁,h₂])
    linarith only [he]

/-- Continuity at zero and monotonicity suffice for full affine rigidity.
The two outer-band barriers give the required linear growth at both ends. -/
theorem monotone_midpoint_kernel {F : ℝ → ℝ} (hc : ContinuousOn F (Set.Ici 0))
    (hm : MonotoneOn F (Set.Ici 0)) :
    (∀ y : ℝ, 0<y → 2*F (3*y)=F (2*y)+F (4*y)) ↔
      ∀ y : ℝ, 0≤y → F y=F 0+y*(F 1-F 0) := by
  let G := fun y => F y-F 0
  have hG : ContinuousOn G (Set.Ici 0) := hc.sub continuousOn_const
  have hmono : MonotoneOn G (Set.Ici 0) := fun _ hi _ hj h => sub_le_sub_right (hm hi hj h) _
  have hzero : G 0=0 := sub_self _
  constructor
  · intro h
    have hh (y : ℝ) (hy : 0<y) : 2*G (3*y)=G (2*y)+G (4*y) := by
      dsimp only [G]
      linarith only [h y hy]
    let C := max (G (4/3)) (4*G 1/3)
    have hbd (y : ℝ) (hy : 0<y) : (G y/y)^2 ≤ C^2 := by
      have hpos : 0≤G y := by
        rw [← hzero]
        exact hmono (show (0:ℝ)≤0 from le_rfl) hy.le hy.le
      have hupper : G y/y ≤ C := by
        apply (div_le_iff₀ hy).mpr
        rcases le_total y 1 with hle | hle
        · have hs := (midpoint_slope_enclosure hG hmono hzero hh zero_lt_one ⟨hy.le,hle⟩).2
          simp only [mul_one,one_mul] at hs
          exact hs.trans (mul_le_mul_of_nonneg_right (le_max_left _ (4*G 1/3)) hy.le)
        · have hs := (midpoint_slope_enclosure hG hmono hzero hh hy ⟨zero_le_one,hle⟩).1
          exact (show G y ≤ (4*G 1/3)*y by linarith only [hs]).trans
            (mul_le_mul_of_nonneg_right (le_max_right (G (4/3)) _) hy.le)
      exact pow_le_pow_left₀ (div_nonneg hpos hy.le) hupper 2
    have hg := (linear_growth_midpoint_kernel G (hG.mono Set.Ioi_subset_Ici_self) ⟨C^2,hbd⟩).mp hh
    intro y hy
    rcases hy.eq_or_lt with he | hp
    · simp [← he]
    · have he := hg y hp
      dsimp only [G] at he
      linarith only [he]
  · intro h y hy
    rw [h _ (by positivity : 0≤3*y),h _ (by positivity : 0≤2*y),h _ (by positivity : 0≤4*y)]
    ring

#print axioms dilation_band_maximum
#print axioms monotone_midpoint_kernel

end GaloisForLFunctions.ExceptionalLayerTheory.FactorialInterval
