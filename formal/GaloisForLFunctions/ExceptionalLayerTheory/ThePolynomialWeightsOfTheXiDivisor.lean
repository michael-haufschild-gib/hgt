import GaloisForLFunctions.ExceptionalLayerTheory.TheHighDerivativeAreasOfAWholeObservationDisk
import Mathlib.Topology.Algebra.Polynomial
import Mathlib.Algebra.Polynomial.RingDivision
import Mathlib.RingTheory.Coprime.Lemmas

/-!
# The zero polynomial of a disk from spatially weighted derivative areas

Weighting the first derivative by the squared modulus of a polynomial
q measures the positive quadratic form Σ m(ρ)|q(ρ)|². Its kernel is
exactly the ideal generated by the squarefree polynomial of the zeros
inside the disk. The spatial weights therefore recover the locations
that disappear in an unweighted measurement.
-/
noncomputable section
open Complex Filter MeasureTheory Metric Set Topology RHTower Polynomial
namespace GaloisForLFunctions.ExceptionalLayerTheory

/-- Planar area of the first derivative reading, weighted before thresholding. -/
def polynomialXiArea (q : ℂ[X]) (c : ℂ) (R u : ℝ) : ℝ :=
  u^2*volume.real {z | z∈ball c R ∧ u < ‖q.eval z‖ * Real.sqrt ‖iteratedDeriv 1 (logDeriv xi) z‖}

/-- The area limit weights the squared polynomial values by the actual
multiplicities, simultaneously for every polynomial on the same disk. -/
theorem xi_polynomial_area_form (c : ℂ) {R : ℝ} (hR : 0<R)
    (hb : ∀ z, ‖z-c‖=R → xi z≠0) :
    ∃ S : Finset ℂ, (∀ z, z∈S ↔ ‖z-c‖<R ∧ xi z=0) ∧
      ∀ q : ℂ[X], Tendsto (polynomialXiArea q c R) atTop
        (𝓝 (Real.pi*∑ z ∈ S, ‖q.eval z‖^2*(hadamardOrder z:ℝ))) := by
  classical
  obtain ⟨S,hS,_⟩ := windingNumber_xi_circle c hR hb
  refine ⟨S,hS,fun q => ?_⟩
  let F (z : ℂ) := ‖q.eval z‖ * Real.sqrt ‖iteratedDeriv 1 (logDeriv xi) z‖
  let B (z : ℂ) := ‖q.eval z‖*Real.sqrt (hadamardOrder z:ℝ)
  have hl (z : ℂ) : Tendsto (fun w => dist w z*F w) (𝓝[≠] z) (𝓝 (B z)) := by
    have h := analytic_log_derivative_radial_residue (xi_differentiable.analyticAt z) (xi_order_ne_top z) 1
    have hroot : Tendsto (fun w => dist w z*Real.sqrt ‖iteratedDeriv 1 (logDeriv xi) w‖)
        (𝓝[≠] z) (𝓝 (Real.sqrt (hadamardOrder z:ℝ))) := by
      simpa only [Real.sqrt_eq_rpow,one_div,Nat.reduceAdd,Nat.cast_ofNat,Nat.factorial_one,
        Nat.cast_one,mul_one,hadamardOrder] using h
    have hq : Tendsto (fun w => ‖q.eval w‖) (𝓝[≠] z) (𝓝 ‖q.eval z‖) :=
      q.continuousAt.norm.continuousWithinAt
    exact (hq.mul hroot).congr fun w => mul_left_comm _ _ _
  have hreg (z : ℂ) (hz : z∈closedBall c R) (hn : z∉S) : ContinuousAt F z := by
    have hle : ‖z-c‖≤R := by simpa only [dist_eq_norm] using mem_closedBall.mp hz
    have hne : xi z≠0 := fun h => hn ((hS z).mpr ⟨hle.lt_of_ne (fun e => hb z e h),h⟩)
    exact q.continuousAt.norm.mul (Real.continuous_sqrt.continuousAt.comp
      (analyticAt_hadamard_derivative hne 1).continuousAt.norm)
  have h := sum_local_superlevel_areas F (fun z => Real.pi*(B z)^2) (fun u => u^2) c R S
    (fun z hz => by simpa only [mem_ball,dist_eq_norm] using ((hS z).mp hz).1) hreg
    (fun z => fixed_disk_radial_level_area (mul_nonneg (norm_nonneg _) (Real.sqrt_nonneg _)) (hl z))
  simpa only [polynomialXiArea,F,B,mul_pow,Real.sq_sqrt (Nat.cast_nonneg _),Finset.mul_sum] using h

/-- The polynomial weights whose area tends to zero form the principal
ideal of the squarefree divisor. Each zero is counted once in its generator. -/
theorem kernel_of_polynomial_xi_areas (c : ℂ) {R : ℝ} (hR : 0<R)
    (hb : ∀ z, ‖z-c‖=R → xi z≠0) :
    ∃ S : Finset ℂ, (∀ z, z∈S ↔ ‖z-c‖<R ∧ xi z=0) ∧ ∀ q : ℂ[X],
      Tendsto (polynomialXiArea q c R) atTop (𝓝 0) ↔ (∏ z ∈ S, (X-C z)) ∣ q := by
  classical
  obtain ⟨S,hS,ha⟩ := xi_polynomial_area_form c hR hb
  refine ⟨S,hS,fun q => ⟨fun h => ?_,fun h => ?_⟩⟩
  · have he := (mul_eq_zero.mp (tendsto_nhds_unique (ha q) h)).resolve_left Real.pi_ne_zero
    apply Finset.prod_dvd_of_coprime ((pairwise_coprime_X_sub_C (K:=ℂ) Function.injective_id).set_pairwise _)
    intro z hz
    apply dvd_iff_isRoot.mpr
    change q.eval z=0
    by_contra hne
    have hm : 0 < hadamardOrder z := Nat.pos_of_ne_zero (fun h0 =>
      (hadamardOrder_zero_iff z).mp h0 ((hS z).mp hz).2)
    have hp := mul_pos (sq_pos_of_pos (norm_pos_iff.mpr hne)) (Nat.cast_pos.mpr hm : 0<(hadamardOrder z:ℝ))
    have hle := Finset.single_le_sum (f:=fun w => ‖q.eval w‖^2*(hadamardOrder w:ℝ))
      (fun w _ => mul_nonneg (sq_nonneg _) (Nat.cast_nonneg _)) hz
    exact (hp.trans_le hle).ne' he
  · have he (z : ℂ) (hz : z∈S) : q.eval z=0 :=
      dvd_iff_isRoot.mp ((Finset.dvd_prod_of_mem (fun w => (X-C w:ℂ[X])) hz).trans h)
    have hsum : ∑ z ∈ S, ‖q.eval z‖^2*(hadamardOrder z:ℝ)=0 :=
      Finset.sum_eq_zero fun z hz => by simp only [he z hz,norm_zero,zero_pow (by decide : 2≠0),zero_mul]
    simpa only [hsum,mul_zero] using ha q

/-- The cardinal interpolation polynomial which equals one at z and
zero at all other members of the observed divisor. -/
def divisorSelector (S : Finset ℂ) (z : ℂ) : ℂ[X] :=
  C ((∏ w ∈ S.erase z, z-w)⁻¹) * ∏ w ∈ S.erase z, (X-C w)

private theorem selector_at_self (S : Finset ℂ) (z : ℂ) :
    (divisorSelector S z).eval z = 1 := by
  have hn : (∏ w ∈ S.erase z, z-w) ≠ 0 := Finset.prod_ne_zero_iff.mpr
    (fun w hw => sub_ne_zero.mpr (Finset.ne_of_mem_erase hw).symm)
  simp only [divisorSelector,eval_mul,eval_C,eval_prod,eval_sub,eval_X,inv_mul_cancel₀ hn]

private theorem selector_at_ne (S : Finset ℂ) (z w : ℂ) (hw : w∈S) (hne : w≠z) :
    (divisorSelector S z).eval w = 0 := by
  have he := Finset.prod_eq_zero (f:=fun v => w-v) (Finset.mem_erase.mpr ⟨hne,hw⟩)
    (show w-w=(0:ℂ) from sub_self w)
  simp only [divisorSelector,eval_mul,eval_C,eval_prod,eval_sub,eval_X,he,mul_zero]

/-- Once the kernel specifies the support, a single explicit polynomial
probe at each support point reads its multiplicity, even if other zeros
in the same disk have unequal multiplicities. -/
theorem xi_multiplicity_from_polynomial_selection (c : ℂ) {R : ℝ} (hR : 0<R)
    (hb : ∀ z, ‖z-c‖=R → xi z≠0) :
    ∃ S : Finset ℂ, (∀ z, z∈S ↔ ‖z-c‖<R ∧ xi z=0) ∧ ∀ z ∈ S,
      Tendsto (polynomialXiArea (divisorSelector S z) c R) atTop (𝓝 (Real.pi*(hadamardOrder z:ℝ))) := by
  classical
  obtain ⟨S,hS,h⟩ := xi_polynomial_area_form c hR hb
  refine ⟨S,hS,fun z hz => ?_⟩
  have hs : ∑ w ∈ S, ‖(divisorSelector S z).eval w‖^2*(hadamardOrder w:ℝ) =
      (hadamardOrder z:ℝ) := by
    rw [Finset.sum_eq_single_of_mem z hz (fun w hw hne => by
      simp [selector_at_ne S z w hw hne]),selector_at_self,norm_one,one_pow,one_mul]
  simpa only [hs] using h (divisorSelector S z)

#print axioms xi_multiplicity_from_polynomial_selection
#print axioms xi_polynomial_area_form
#print axioms kernel_of_polynomial_xi_areas
end GaloisForLFunctions.ExceptionalLayerTheory
