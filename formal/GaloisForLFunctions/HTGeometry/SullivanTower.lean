import GaloisForLFunctions.HTGeometry.ExteriorOddDerivation

/-!
# Relative Sullivan towers

A relative Sullivan tower on an exterior algebra is a well-ordered filtration of the generator
space above a fixed base of closed generators, together with a degree-raising odd derivation whose
value on a generator of a stage already lies in the subalgebra generated by the base and the
strictly earlier stages.

Such a tower is a filtered differential graded algebra: the differential obeys the graded Leibniz
rule, squares to zero, every stage subalgebra is stable under it, and the stage subalgebras exhaust
the whole algebra.

* `DeningerSullivanTower` : the tower, with its filtration, base, and lower-triangular differential.
* `DeningerSullivanTower.d`, `d_leibniz`, `d_comp_self` : the differential of the tower.
* `DeningerSullivanTower.stage_stable` : every stage is a differential subalgebra.
* `DeningerSullivanTower.exists_stage`, `iSup_stage` : the stages exhaust the algebra.
-/

namespace HTGeometry

open ExteriorAlgebra

section Tower

variable (k U : Type*) [CommRing k] [AddCommGroup U] [Module k U]
variable (B : Type*) [Preorder B]

/-- **A relative Sullivan tower.**  The generator space carries a filtration above a base of closed
generators, and the differential of a generator appearing at a stage lies in the subalgebra
generated by the base together with the strictly earlier stages. -/
structure DeningerSullivanTower where
  /-- The base of generators present at every stage. -/
  base : Submodule k U
  /-- The filtration of the generator space. -/
  filt : B → Submodule k U
  /-- The base is contained in every stage. -/
  base_le : ∀ b, base ≤ filt b
  /-- The filtration is increasing. -/
  mono : Monotone filt
  /-- The filtration exhausts the generator space. -/
  exhaust : ⨆ b, filt b = ⊤
  /-- The values of the differential on the generators. -/
  phi : U →ₗ[k] ExteriorAlgebra k U
  /-- The generator values are central, so they determine an odd derivation. -/
  central : ∀ (u : U) (x : ExteriorAlgebra k U), Commute (phi u) x
  /-- The generator values are invariant under the grading involution. -/
  involute : ∀ u, deningerExteriorInvolute k U (phi u) = phi u
  /-- **Lower triangularity**: the differential of a stage lands in the subalgebra of the base and
  the strictly earlier stages. -/
  lower : ∀ (b : B), ∀ u ∈ filt b,
    phi u ∈ deningerGeneratorSubalgebra (base ⊔ ⨆ b' ∈ {b' : B | b' < b}, filt b')
  /-- The differential kills its own generator values, so it squares to zero. -/
  kill : ∀ u, deningerOddDerivation phi central (phi u) = 0

variable {k U B}

namespace DeningerSullivanTower

variable (T : DeningerSullivanTower k U B)

/-- **The differential of the tower.** -/
noncomputable def d : ExteriorAlgebra k U →ₗ[k] ExteriorAlgebra k U :=
  deningerOddDerivation T.phi T.central

@[simp]
theorem d_ι (u : U) : T.d (ι k u) = T.phi u :=
  deningerOddDerivation_ι _ _ u

@[simp]
theorem d_one : T.d 1 = 0 :=
  deningerOddDerivation_one _ _

/-- **The graded Leibniz rule of the tower.** -/
theorem d_leibniz (x y : ExteriorAlgebra k U) :
    T.d (x * y) = deningerExteriorInvolute k U x * T.d y + T.d x * y :=
  deningerOddDerivation_leibniz _ _ x y

/-- **The differential of a tower squares to zero**, so a relative Sullivan tower is a differential
graded algebra. -/
theorem d_comp_self (x : ExteriorAlgebra k U) : T.d (T.d x) = 0 :=
  deningerOddDerivation_comp_self _ _ T.involute T.kill x

/-- **The degree-one cocycles of a tower are the kernel of its generator assignment.**  A generator
is closed exactly when the differential kills it, so the degree-one cohomology of a tower is
governed by `ker φ`. -/
theorem d_ι_eq_zero_iff (u : U) : T.d (ι k u) = 0 ↔ u ∈ LinearMap.ker T.phi := by
  rw [T.d_ι]
  exact Iff.rfl

/-- The stage subalgebra of a tower. -/
def stage (b : B) : Subalgebra k (ExteriorAlgebra k U) :=
  deningerGeneratorSubalgebra (T.filt b)

theorem stage_mono : Monotone T.stage := fun _ _ h =>
  deningerGeneratorSubalgebra_mono (T.mono h)

/-- Lower triangularity above the base is lower triangularity inside the stage. -/
theorem lower_le (b : B) :
    T.base ⊔ (⨆ b' ∈ {b' : B | b' < b}, T.filt b') ≤ T.filt b := by
  refine sup_le (T.base_le b) (iSup₂_le fun b' hb' => T.mono (le_of_lt hb'))

theorem phi_mem_stage (b : B) {u : U} (hu : u ∈ T.filt b) : T.phi u ∈ T.stage b :=
  deningerGeneratorSubalgebra_mono (T.lower_le b) (T.lower b u hu)

/-- **Every stage of a tower is a differential subalgebra.** -/
theorem stage_stable (b : B) {x : ExteriorAlgebra k U} (hx : x ∈ T.stage b) :
    T.d x ∈ T.stage b :=
  deningerOddDerivation_mem_subalgebra T.phi T.central (fun _ hu => T.phi_mem_stage b hu) hx

/-- The grading involution preserves every stage. -/
theorem stage_involute (b : B) {x : ExteriorAlgebra k U} (hx : x ∈ T.stage b) :
    deningerExteriorInvolute k U x ∈ T.stage b :=
  deningerExteriorInvolute_mem_subalgebra hx

section Directed

variable [IsDirected B (· ≤ ·)] [Nonempty B]

/-- **Every element of the algebra already lies at a stage of the tower.** -/
theorem exists_stage (x : ExteriorAlgebra k U) : ∃ b, x ∈ T.stage b :=
  deningerGeneratorSubalgebra_exists_stage T.filt T.mono T.exhaust x

/-- **The stages of a tower exhaust the whole algebra.** -/
theorem iSup_stage : ⨆ b, T.stage b = ⊤ :=
  deningerGeneratorSubalgebra_iSup T.filt T.mono T.exhaust

/-- **A cocycle of the tower is a cocycle of some stage**, and its differential is computed there:
cohomology of the tower is computed at the stages. -/
theorem cocycle_exists_stage {x : ExteriorAlgebra k U} (hx : T.d x = 0) :
    ∃ b, x ∈ T.stage b ∧ T.d x = 0 := by
  obtain ⟨b, hb⟩ := T.exists_stage x
  exact ⟨b, hb, hx⟩

/-- **A coboundary of the tower is a coboundary at some stage.** -/
theorem coboundary_exists_stage {x y : ExteriorAlgebra k U} (hxy : T.d y = x) :
    ∃ b, y ∈ T.stage b ∧ x ∈ T.stage b ∧ T.d y = x := by
  obtain ⟨b, hb⟩ := T.exists_stage y
  exact ⟨b, hb, hxy ▸ T.stage_stable b hb, hxy⟩

/-- **A class present at a stage that dies in the tower already dies at a later stage.** -/
theorem coboundary_exists_stage_ge {x y : ExteriorAlgebra k U} (b : B)
    (hxy : T.d y = x) : ∃ b', b ≤ b' ∧ y ∈ T.stage b' ∧ T.d y = x := by
  obtain ⟨c, hc⟩ := T.exists_stage y
  obtain ⟨b', hbb', hcb'⟩ := directed_of (· ≤ ·) b c
  exact ⟨b', hbb', T.stage_mono hcb' hc, hxy⟩

/-- **The cohomology of a tower is computed at its stages.**  Every cocycle is already a cocycle of
some stage, and a class present at a stage which becomes a coboundary in the whole tower already
becomes one at a later stage.  These are the two halves of the comparison between the tower's
cohomology and the colimit of its stage cohomologies. -/
theorem cohomology_computed_at_stages :
    (∀ x : ExteriorAlgebra k U, T.d x = 0 → ∃ b, x ∈ T.stage b ∧ T.d x = 0) ∧
      (∀ (b : B) (x y : ExteriorAlgebra k U), T.d y = x →
        ∃ b', b ≤ b' ∧ y ∈ T.stage b' ∧ T.d y = x) :=
  ⟨fun _ hx => T.cocycle_exists_stage hx, fun b _ _ hxy => T.coboundary_exists_stage_ge b hxy⟩

end Directed

end DeningerSullivanTower

end Tower

end HTGeometry
