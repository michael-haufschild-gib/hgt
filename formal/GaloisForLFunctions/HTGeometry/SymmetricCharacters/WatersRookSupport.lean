import GaloisForLFunctions.HTGeometry.SymmetricCharacters.StaircasePacking

/-!
# Support of the rook expansion of the KMK moments

In Waters' formula (16), the coefficient at inverse Poissonization degree g
counts diagrams inside a staircase together with g nonattacking rooks.
The contributing diagrams form one interval in Young's lattice. One step
above the first possible moment this interval is a Boolean lattice.
-/

namespace GaloisForLFunctions.StaircasePacking

open Finset
noncomputable section
open scoped Classical

private def triangle (k : ℕ) : Finset (ℕ × ℕ) :=
  ((range k) ×ˢ (range k)).filter fun p => p.1 + p.2 < k

private theorem mem_triangle {p : ℕ × ℕ} {k : ℕ} : p ∈ triangle k ↔ p.1 + p.2 < k := by
  simp only [triangle, mem_filter, mem_product, mem_range]
  omega

/-- The k-step staircase has row lengths k, k−1, …, 1. -/
def rookStaircase (k : ℕ) : YoungDiagram where
  cells := triangle k
  isLowerSet := by
    intro p q h hp
    have h₁ := h.1
    have h₂ := h.2
    exact mem_triangle.mpr ((Nat.add_le_add h₁ h₂).trans_lt (mem_triangle.mp hp))

theorem mem_rookStaircase {k : ℕ} {p : ℕ × ℕ} :
    p ∈ rookStaircase k ↔ p.1 + p.2 < k := mem_triangle

/-- The diagrams contributing to a given rook degree form the principal
upper set generated by its staircase. -/
theorem holdsRooks_iff_contains (Y : YoungDiagram) (k : ℕ) :
    HoldsRooks Y.cells k ↔ rookStaircase k ≤ Y := by
  rw [holdsRooks_iff_staircase]
  constructor
  · intro h p hp
    have hi := mem_rookStaircase.mp hp
    have hlen := h p.1 (by omega)
    exact YoungDiagram.mem_iff_lt_rowLen.mpr (by omega)
  · intro h i hi
    have hp : (i,k-1-i) ∈ rookStaircase k := mem_rookStaircase.mpr (by dsimp; omega)
    have hm := YoungDiagram.mem_iff_lt_rowLen.mp (h hp)
    omega

/-- Indexing by k means the even moment of order 2(k+1).
The powerset runs over distinct cell sets, each counted exactly once. -/
def watersBoards (k g : ℕ) : Finset (Finset (ℕ × ℕ)) :=
  ((rookStaircase k).cells.powerset).filter fun B =>
    IsLowerSet (B : Set (ℕ × ℕ)) ∧ HoldsRooks B g

/-- Exact shape support inside the ambient moment staircase. -/
theorem mem_watersBoards {B : Finset (ℕ × ℕ)} {k g : ℕ} :
    B ∈ watersBoards k g ↔ IsLowerSet (B : Set (ℕ × ℕ)) ∧
      (rookStaircase g).cells ⊆ B ∧ B ⊆ (rookStaircase k).cells := by
  simp only [watersBoards, mem_filter, mem_powerset]
  constructor
  · rintro ⟨hB, hL, hr⟩
    exact ⟨hL,(holdsRooks_iff_contains ⟨B,hL⟩ g).mp hr,hB⟩
  · rintro ⟨hL,hg,hB⟩
    exact ⟨hB,hL,(holdsRooks_iff_contains ⟨B,hL⟩ g).mpr hg⟩

private theorem stair_mono_iff (g k : ℕ) :
    (rookStaircase g).cells ⊆ (rookStaircase k).cells ↔ g ≤ k := by
  constructor
  · intro h
    by_contra! hk
    have hg : (k,0) ∈ (rookStaircase g).cells := mem_triangle.mpr (by simpa using hk)
    have := mem_triangle.mp (h hg)
    simpa using this
  · intro h p hp
    exact mem_triangle.mpr ((mem_triangle.mp hp).trans_le h)

/-- Exact onset of a nonzero rook coefficient. -/
theorem watersBoards_nonempty_iff (k g : ℕ) : (watersBoards k g).Nonempty ↔ g ≤ k := by
  constructor
  · rintro ⟨B,hB⟩
    obtain ⟨_,hg,hk⟩ := mem_watersBoards.mp hB
    exact (stair_mono_iff _ _).mp (hg.trans hk)
  · intro h
    exact ⟨_,mem_watersBoards.mpr ⟨(rookStaircase g).isLowerSet, Subset.rfl,
      (stair_mono_iff _ _).mpr h⟩⟩

/-- Only the staircase diagram contributes at the first possible moment. -/
theorem watersBoards_first (g : ℕ) : watersBoards g g = {(rookStaircase g).cells} := by
  ext B
  rw [mem_watersBoards, mem_singleton]
  exact ⟨fun h => Subset.antisymm h.2.2 h.2.1, fun e => e ▸
    ⟨(rookStaircase g).isLowerSet, Subset.rfl, Subset.rfl⟩⟩

/-- Each cell on the new antidiagonal may be included independently. -/
theorem watersBoards_next (g : ℕ) :
    watersBoards (g+1) g =
      (((rookStaircase (g+1)).cells \ (rookStaircase g).cells).powerset).image
        (fun T => (rookStaircase g).cells ∪ T) := by
  let L := (rookStaircase g).cells
  let U := (rookStaircase (g+1)).cells
  have hlu : L ⊆ U := (stair_mono_iff _ _).mpr (Nat.le_succ _)
  ext B
  rw [mem_watersBoards, mem_image]
  constructor
  · rintro ⟨_, hl, hu⟩
    exact ⟨B \ L, mem_powerset.mpr (sdiff_subset_sdiff_left hu),
      union_sdiff_of_subset hl⟩
  · rintro ⟨T,hT,rfl⟩
    have ht : T ⊆ U \ L := mem_powerset.mp hT
    have hu : L ∪ T ⊆ U := union_subset hlu (ht.trans sdiff_subset)
    refine ⟨?_, subset_union_left, hu⟩
    intro p q hpq hp
    change p ∈ L ∪ T at hp
    change q ∈ L ∪ T
    by_cases he : q=p
    · exact he ▸ hp
    · apply mem_union_left
      apply mem_triangle.mpr
      have hup := mem_triangle.mp (hu hp)
      have h₁ := hpq.1
      have h₂ := hpq.2
      have hn : q.1 ≠ p.1 ∨ q.2 ≠ p.2 := by
        by_contra! h
        exact he (Prod.ext h.1 h.2)
      omega

private theorem step_card (g : ℕ) :
    ((rookStaircase (g+1)).cells \ (rookStaircase g).cells).card = g+1 := by
  let f (i : ℕ) := (i,g-i)
  have he : (rookStaircase (g+1)).cells \ (rookStaircase g).cells =
      (range (g+1)).image f := by
    ext p
    rw [mem_sdiff, mem_image]
    constructor
    · rintro ⟨hu,hl⟩
      have h := mem_triangle.mp hu
      have hn : ¬ p.1+p.2 < g := fun h => hl (mem_triangle.mpr h)
      exact ⟨p.1, mem_range.mpr (by omega), Prod.ext rfl (by dsimp [f]; omega)⟩
    · rintro ⟨i,hi,rfl⟩
      have := mem_range.mp hi
      exact ⟨mem_triangle.mpr (by dsimp [f]; omega),fun h => by
        have := mem_triangle.mp h
        dsimp [f] at this
        omega⟩
  rw [he, card_image_of_injective _ (fun i j h => congrArg Prod.fst h), card_range]

/-- There are exactly 2^(g+1) contributing shapes one moment above onset. -/
theorem watersBoards_next_card (g : ℕ) : (watersBoards (g+1) g).card = 2^(g+1) := by
  rw [watersBoards_next, card_image_of_injOn, card_powerset, step_card]
  intro A hA B hB he
  have h₁ := mem_powerset.mp hA
  have h₂ := mem_powerset.mp hB
  ext x
  have h := Iff.of_eq (congrArg (fun C : Finset (ℕ × ℕ) => x ∈ C) he)
  simp only [mem_union] at h
  exact ⟨fun hx => (h.mp (Or.inr hx)).resolve_left (mem_sdiff.mp (h₁ hx)).2,
    fun hx => (h.mpr (Or.inr hx)).resolve_left (mem_sdiff.mp (h₂ hx)).2⟩

#print axioms holdsRooks_iff_contains
#print axioms watersBoards_nonempty_iff
#print axioms watersBoards_next_card

end
end GaloisForLFunctions.StaircasePacking
