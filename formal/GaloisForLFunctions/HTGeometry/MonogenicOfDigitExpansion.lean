import GaloisForLFunctions.HTGeometry.UniformizerDigitExpansion
import Mathlib.RingTheory.Nakayama

/-!
# The powers of a uniformizer generate the extension

The digit expansion writes every element as a polynomial in a uniformizer of degree below the
ramification index, plus a remainder divisible by the corresponding power of the base uniformizer.
So the powers below that index generate the extension modulo the maximal ideal of the base, and
Nakayama upgrades that to generation outright.

This is the monogenicity a presentation needs: the extension is generated by a single uniformizer,
with no completeness hypothesis anywhere.
-/

namespace GaloisForLFunctions.HTGeometry

open IsDiscreteValuationRing

variable {A B : Type*}
variable [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B]

/-- **The powers of a uniformizer below the ramification index generate the extension.** -/
theorem span_pow_eq_top [Module.Finite A B] {πA : A} (hπA : Irreducible πA)
    {x : B} (hx : addVal B x = 1) (e : ℕ)
    (hres : ∀ b : B, ∃ a : A, addVal B (b - algebraMap A B a) ≠ 0)
    (hdvd : algebraMap A B πA ∣ x ^ e) :
    Submodule.span A (Set.range fun i : Fin e => x ^ (i : ℕ)) = ⊤ := by
  refine le_antisymm le_top ?_
  refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal A)
    Module.Finite.fg_top ?_ ?_
  · exact le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).symm
  · intro b _
    obtain ⟨c, b', hb⟩ := exists_digit_expansion (algebraMap A B) hx hres e b
    obtain ⟨k, hk⟩ := hdvd
    rw [hb]
    refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
    · refine Submodule.sum_mem _ fun i hi => ?_
      rw [show algebraMap A B (c i) * x ^ i = c i • x ^ i from (Algebra.smul_def _ _).symm]
      exact Submodule.smul_mem _ _
        (Submodule.subset_span ⟨⟨i, Finset.mem_range.mp hi⟩, rfl⟩)
    · rw [hk, mul_assoc,
        show algebraMap A B πA * (k * b') = πA • (k * b') from (Algebra.smul_def _ _).symm]
      exact Submodule.smul_mem_smul
        ((IsLocalRing.mem_maximalIdeal πA).mpr hπA.1) Submodule.mem_top

/-- **The extension is generated by a single uniformizer.**  A finite extension of discrete
valuation rings with trivial residue extension is monogenic, generated by any uniformizer of the
upper ring. -/
theorem adjoin_singleton_eq_top [Module.Finite A B] {πA : A} (hπA : Irreducible πA)
    {x : B} (hx : addVal B x = 1) (e : ℕ)
    (hres : ∀ b : B, ∃ a : A, addVal B (b - algebraMap A B a) ≠ 0)
    (hdvd : algebraMap A B πA ∣ x ^ e) :
    Algebra.adjoin A ({x} : Set B) = ⊤ := by
  refine Algebra.eq_top_iff.mpr fun b => ?_
  have hle : Submodule.span A (Set.range fun i : Fin e => x ^ (i : ℕ)) ≤
      Subalgebra.toSubmodule (Algebra.adjoin A ({x} : Set B)) := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    have hxmem : x ∈ Algebra.adjoin A ({x} : Set B) :=
      Algebra.subset_adjoin (Set.mem_singleton x)
    exact pow_mem hxmem _
  have hb : b ∈ Submodule.span A (Set.range fun i : Fin e => x ^ (i : ℕ)) := by
    rw [span_pow_eq_top hπA hx e hres hdvd]
    trivial
  exact hle hb

end GaloisForLFunctions.HTGeometry
