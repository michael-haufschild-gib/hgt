/-!
# A translation-rigid locus is reconstructed from its first derivatives

For a differential field generated over its constants by a family of elements, the differential
field generated by the first derivatives alone is the whole field as soon as the affine locus of the
family has no nonzero constant translation symmetry.

Three ingredients combine.  If some coordinate were transcendental over the horizon, the
transcendence crux would produce a nonzero derivation commuting with the derivation and killing the
horizon; the horizon gauge theorem turns such a derivation into a nonzero translation symmetry, so
there is none, and every coordinate is algebraic over the horizon.  An algebraic element whose
derivative lies in the horizon lies in the horizon, so the coordinates themselves are horizon
elements and the horizon is everything.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C F : Type*} [Field C] [CharZero C] [Field F] [CharZero F] [Algebra C F]
  [Differential F]

omit [CharZero C] in
/-- The field generated over a derivation-closed intermediate field by elements whose derivatives
lie in it is derivation closed. -/
theorem derivationClosed_restrictScalars_adjoin
    (K : IntermediateField C F) (hKclosed : DerivationClosed K)
    {κ : Type*} (z : κ → F) (hδ : ∀ i, (z i)′ ∈ K) :
    DerivationClosed ((IntermediateField.adjoin (↥K) (Set.range z)).restrictScalars C) := by
  classical
  set M : IntermediateField C F :=
    (IntermediateField.adjoin (↥K) (Set.range z)).restrictScalars C with hM
  have hKM : ∀ x ∈ K, x ∈ M := by
    intro x hx
    exact IntermediateField.algebraMap_mem
      (IntermediateField.adjoin (↥K) (Set.range z)) (⟨x, hx⟩ : ↥K)
  intro x hx
  have hx' : x ∈ IntermediateField.adjoin (↥K) (Set.range z) := hx
  refine IntermediateField.adjoin_induction (↥K) (p := fun y _ => y′ ∈ M) ?_ ?_ ?_ ?_ ?_ hx'
  · rintro y ⟨i, rfl⟩
    exact hKM _ (hδ i)
  · intro c
    exact hKM _ (hKclosed c.2)
  · intro a b _ _ ha hb
    rw [map_add]
    exact M.add_mem ha hb
  · intro a hamem ha
    have haM : a ∈ M := hamem
    rcases eq_or_ne a 0 with rfl | ha0
    · simp
    · have hprod : a * (a⁻¹)′ + a⁻¹ * a′ = 0 := by
        have h1 : (a * a⁻¹)′ = 0 := by
          rw [mul_inv_cancel₀ ha0]
          exact Derivation.map_one_eq_zero _
        rw [Derivation.leibniz] at h1
        simpa using h1
      have h3 : a * (a⁻¹)′ = -(a⁻¹ * a′) := by linear_combination hprod
      have hval : (a⁻¹)′ = -(a⁻¹ * (a⁻¹ * a′)) := by
        calc (a⁻¹)′ = a⁻¹ * (a * (a⁻¹)′) := by
              rw [← mul_assoc, inv_mul_cancel₀ ha0, one_mul]
          _ = a⁻¹ * (-(a⁻¹ * a′)) := by rw [h3]
          _ = -(a⁻¹ * (a⁻¹ * a′)) := by ring
      rw [hval]
      exact M.neg_mem (M.mul_mem (M.inv_mem haM) (M.mul_mem (M.inv_mem haM) ha))
  · intro a b _ _ ha hb
    rw [Derivation.leibniz]
    simp only [smul_eq_mul]
    exact M.add_mem (M.mul_mem (by assumption) hb) (M.mul_mem (by assumption) ha)

omit [CharZero C] [CharZero F] [Differential F] in
/-- A derivation killing a subfield and a generating family kills the whole field. -/
theorem derivation_eq_zero_of_adjoin_eq_top
    (K : IntermediateField C F) {κ : Type*} (z : κ → F)
    (htop : IntermediateField.adjoin (↥K) (Set.range z) = ⊤)
    (D : Derivation C F F) (hDK : ∀ x ∈ K, D x = 0) (hDz : ∀ i, D (z i) = 0) :
    D = 0 := by
  classical
  refine Derivation.ext fun x => ?_
  have hx : x ∈ IntermediateField.adjoin (↥K) (Set.range z) := by rw [htop]; trivial
  refine IntermediateField.adjoin_induction (↥K) (p := fun y _ => D y = 0) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨i, rfl⟩
    exact hDz i
  · intro c
    exact hDK _ c.2
  · intro a b _ _ ha hb
    rw [map_add, ha, hb, add_zero]
  · intro a _ ha
    rcases eq_or_ne a 0 with rfl | ha0
    · simp
    · have hprod : D (a * a⁻¹) = 0 := by
        rw [mul_inv_cancel₀ ha0]
        exact Derivation.map_one_eq_zero _
      rw [Derivation.leibniz] at hprod
      simp only [smul_eq_mul, ha, mul_zero, add_zero] at hprod
      exact (mul_eq_zero.1 hprod).resolve_left ha0
  · intro a b _ _ ha hb
    rw [Derivation.leibniz]
    simp [ha, hb]

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 400000 in
/-- **Reconstruction from a trivial gauge.**  A differential field generated over its constants by
a family is generated by the first derivatives alone as soon as every derivation commuting with the
derivation and killing those first derivatives kills the family. -/
theorem differentialAdjoin_deriv_eq_top_of_gaugeTrivial
    {κ : Type*}
    (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    (hconst : ∀ x : F, x′ = 0 → ∃ c : C, algebraMap C F c = x)
    (z : κ → F)
    (hgen : differentialAdjoin C (Set.range z) = ⊤)
    (hgauge : ∀ D : Derivation C F F, (∀ x : F, D (x′) = (D x)′) →
      (∀ i, D ((z i)′) = 0) → ∀ i, D (z i) = 0) :
    differentialAdjoin C (Set.range fun i => (z i)′) = ⊤ := by
  classical
  obtain ⟨K, hKdef⟩ : ∃ K : IntermediateField C F,
      K = differentialAdjoin C (Set.range fun i => (z i)′) := ⟨_, rfl⟩
  have hKclosed : DerivationClosed K := by
    rw [hKdef]
    exact derivationClosed_differentialAdjoin_of_constants C hC _
  have hδ : ∀ i, (z i)′ ∈ K := by
    intro i
    rw [hKdef]
    exact subset_differentialAdjoin C _ ⟨i, rfl⟩
  have htop : IntermediateField.adjoin (↥K) (Set.range z) = ⊤ := by
    have hle : (⊤ : IntermediateField C F) ≤
        (IntermediateField.adjoin (↥K) (Set.range z)).restrictScalars C := by
      rw [← hgen]
      refine differentialAdjoin_le C (fun x hx => ?_)
        (derivationClosed_restrictScalars_adjoin K hKclosed z hδ)
      obtain ⟨i, rfl⟩ := hx
      exact IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
    refine eq_top_iff.2 fun x _ => ?_
    exact hle (by trivial)
  have halg : ∀ i, IsAlgebraic (↥K) (z i) := by
    intro i
    by_contra hnot
    obtain ⟨D, hDcomm, hDK, hDne⟩ :=
      exists_derivation_commuting_of_not_isAlgebraic K hKclosed htop hδ hnot
    have hzero : ∀ j, D (z j) = 0 := hgauge D hDcomm (fun j => hDK _ (hδ j))
    exact hDne (derivation_eq_zero_of_adjoin_eq_top K z htop D hDK hzero)
  have hconstK : ∀ x : F, x′ = 0 → x ∈ K := by
    intro x hx
    obtain ⟨c, hc⟩ := hconst x hx
    rw [← hc]
    exact K.algebraMap_mem c
  have hmem : ∀ i, z i ∈ K := fun i =>
    mem_of_isAlgebraic_of_deriv_mem K hKclosed hconstK (halg i) (hδ i)
  rw [← hKdef]
  refine eq_top_iff.2 ?_
  rw [← hgen]
  exact differentialAdjoin_le C (fun x hx => by obtain ⟨i, rfl⟩ := hx; exact hmem i) hKclosed

/-- **Depth-one reconstruction.**  A translation-rigid locus is recovered from the first
derivatives of its differentially generating family. -/
theorem differentialAdjoin_deriv_eq_top_of_translationRigid
    {κ : Type*} [Finite κ]
    (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    (hconst : ∀ x : F, x′ = 0 → ∃ c : C, algebraMap C F c = x)
    (z : κ → F)
    (hgen : differentialAdjoin C (Set.range z) = ⊤)
    (hA : ∀ a : κ → C, IsTranslationSymmetry z a → a = 0) :
    differentialAdjoin C (Set.range fun i => (z i)′) = ⊤ :=
  differentialAdjoin_deriv_eq_top_of_gaugeTrivial hC hconst z hgen
    (fun D hDcomm hDz i =>
      derivation_apply_eq_zero_of_translationRigid hconst z hA D
        (fun j => by rw [← hDcomm]; exact hDz j) i)

/-- **Depth-`n` reconstruction.**  In a differential field with no primitive of one, a
translation-rigid locus is recovered from the `n`-th derivatives of its differentially generating
family, for every `n`. -/
theorem differentialAdjoin_differentialJet_eq_top_of_translationRigid
    {κ : Type*} [Finite κ]
    (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    (hconst : ∀ x : F, x′ = 0 → ∃ c : C, algebraMap C F c = x)
    (hprim : ∀ x : F, x′ ≠ 1)
    (z : κ → F)
    (hgen : differentialAdjoin C (Set.range z) = ⊤)
    (hA : ∀ a : κ → C, IsTranslationSymmetry z a → a = 0) (n : ℕ) :
    differentialAdjoin C (Set.range fun i => differentialJet n (z i)) = ⊤ := by
  induction n with
  | zero => simpa using hgen
  | succ n ih =>
      refine Eq.trans ?_ (differentialAdjoin_deriv_eq_top_of_gaugeTrivial hC hconst
        (fun i => differentialJet n (z i)) ih ?_)
      · congr 1
        congr 1
        funext i
        exact differentialJet_succ n (z i)
      · intro D hDcomm hDz i
        have hjet : ∀ (m : ℕ) (x : F), D (differentialJet m x) = differentialJet m (D x) :=
          fun m x => derivation_differentialJet D hDcomm m x
        have hker : ∀ j, differentialJet (n + 1) (D (z j)) = 0 := by
          intro j
          rw [← hjet]
          have : (differentialJet n (z j))′ = differentialJet (n + 1) (z j) :=
            (differentialJet_succ n (z j)).symm
          rw [← this]
          exact hDz j
        have hcst : ∀ j, (D (z j))′ = 0 := fun j =>
          deriv_eq_zero_of_differentialJet_succ_eq_zero hprim (hker j)
        have hzero : ∀ j, D (z j) = 0 :=
          fun j => derivation_apply_eq_zero_of_translationRigid hconst z hA D hcst j
        rw [hjet, hzero i]
        exact differentialJet_zero_elt n

end

end GaloisForLFunctions.HTGeometry