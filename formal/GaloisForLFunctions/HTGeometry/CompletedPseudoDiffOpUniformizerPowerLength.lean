import GaloisForLFunctions.HTGeometry.CompletedPseudoDiffOpUniformizerResidue

/-!
# Exact lengths of completed uniformizer-power quotients

Multiplication by the canonical inverse derivative identifies every principal power lattice with
the completed valuation ring.  Each adjacent quotient is therefore the residue module and has
length one.  The resulting exact quotient sequence gives length `n` for the quotient by `∂⁻ⁿ`.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry.DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K]

/-- Principal completed lattice generated by the `n`-th power of the canonical uniformizer. -/
def completedPseudoDiffOpUniformizerPower (n : ℕ) : Submodule (CompletedPseudoDiffOpInteger (K := K)) (CompletedPseudoDiffOpInteger (K := K)) :=
  (CompletedPseudoDiffOpInteger (K := K)) ∙ (completedPseudoDiffOpUniformizerInteger (K := K) ^ n)

/-- The zeroth uniformizer-power lattice is the whole completed valuation ring. -/
@[simp] theorem completedPseudoDiffOpUniformizerPower_zero :
    completedPseudoDiffOpUniformizerPower (K := K) 0 = ⊤ := by
  apply top_unique
  intro x _
  rw [completedPseudoDiffOpUniformizerPower, pow_zero, Submodule.mem_span_singleton]
  exact ⟨x, by simp⟩

/-- The first uniformizer-power lattice is the strict valuation ideal. -/
theorem completedPseudoDiffOpUniformizerPower_one :
    completedPseudoDiffOpUniformizerPower (K := K) 1 =
      (completedPseudoDiffOpMaximalIdeal (K := K) : Submodule (CompletedPseudoDiffOpInteger (K := K)) (CompletedPseudoDiffOpInteger (K := K))) := by
  rw [completedPseudoDiffOpUniformizerPower, pow_one,
    completedPseudoDiffOpMaximalIdeal_eq_span_uniformizer]

/-- Consecutive uniformizer-power lattices form a descending chain. -/
theorem completedPseudoDiffOpUniformizerPower_succ_le (n : ℕ) :
    completedPseudoDiffOpUniformizerPower (K := K) (n + 1) ≤
      completedPseudoDiffOpUniformizerPower (K := K) n := by
  intro x hx
  rw [completedPseudoDiffOpUniformizerPower, Submodule.mem_span_singleton] at hx ⊢
  obtain ⟨c, rfl⟩ := hx
  refine ⟨c * completedPseudoDiffOpUniformizerInteger (K := K), ?_⟩
  change (c * completedPseudoDiffOpUniformizerInteger (K := K)) *
      completedPseudoDiffOpUniformizerInteger (K := K) ^ n =
    c * completedPseudoDiffOpUniformizerInteger (K := K) ^ (n + 1)
  simpa [pow_succ'] using
    (mul_assoc c (completedPseudoDiffOpUniformizerInteger (K := K))
      (completedPseudoDiffOpUniformizerInteger (K := K) ^ n))

/-- Right multiplication by `∂⁻ⁿ` identifies the integer ring with its `n`-th power lattice. -/
def completedPseudoDiffOpRightMulUniformizerPowerLinearEquiv (n : ℕ) :
    CompletedPseudoDiffOpInteger (K := K) ≃ₗ[CompletedPseudoDiffOpInteger (K := K)] completedPseudoDiffOpUniformizerPower (K := K) n := by
  let f : CompletedPseudoDiffOpInteger (K := K) →ₗ[CompletedPseudoDiffOpInteger (K := K)] completedPseudoDiffOpUniformizerPower (K := K) n :=
    { toFun := fun c => ⟨c * completedPseudoDiffOpUniformizerInteger (K := K) ^ n,
        (Submodule.mem_span_singleton).2 ⟨c, rfl⟩⟩
      map_add' := fun a b => by
        apply Subtype.ext
        exact add_mul a b _
      map_smul' := fun a b => by
        apply Subtype.ext
        exact mul_assoc a b _ }
  apply LinearEquiv.ofBijective f
  constructor
  · intro a b hab
    have hab' : (a : CompletedPseudoDiffOpInteger (K := K)) * completedPseudoDiffOpUniformizerInteger (K := K) ^ n =
        b * completedPseudoDiffOpUniformizerInteger (K := K) ^ n :=
      congrArg Subtype.val hab
    have hp : completedPseudoDiffOpUniformizerInteger (K := K) ^ n ≠ 0 := by
      intro hzero
      have hzero' : ((completedPseudoDiffOpUniformizerInteger (K := K) ^ n : CompletedPseudoDiffOpInteger (K := K)) :
          CompletedPseudoDiffOp K) = 0 := congrArg Subtype.val hzero
      change ((completedPseudoDiffOpUniformizerUnit (K := K) :
        CompletedPseudoDiffOp K) ^ n) = 0 at hzero'
      exact pow_ne_zero n (Units.ne_zero _) hzero'
    have hzero : (a - b) * completedPseudoDiffOpUniformizerInteger (K := K) ^ n = 0 := by
      rw [sub_mul, hab', sub_self]
    exact sub_eq_zero.mp ((mul_eq_zero.mp hzero).resolve_right hp)
  · intro y
    obtain ⟨c, hc⟩ := (Submodule.mem_span_singleton.mp y.property)
    refine ⟨c, Subtype.ext hc⟩

/-- The `(n+1)`-st power lattice viewed inside the `n`-th power lattice. -/
def completedPseudoDiffOpUniformizerPowerStep (n : ℕ) :
    Submodule (CompletedPseudoDiffOpInteger (K := K)) (completedPseudoDiffOpUniformizerPower (K := K) n) :=
  Submodule.comap (completedPseudoDiffOpUniformizerPower (K := K) n).subtype
    (completedPseudoDiffOpUniformizerPower (K := K) (n + 1))

/-- Uniformizer multiplication carries the first power lattice onto the adjacent step. -/
theorem completedPseudoDiffOpMap_uniformizerPower_one_eq_step (n : ℕ) :
    Submodule.map (completedPseudoDiffOpRightMulUniformizerPowerLinearEquiv (K := K) n).toLinearMap
        (completedPseudoDiffOpUniformizerPower (K := K) 1) =
      completedPseudoDiffOpUniformizerPowerStep (K := K) n := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    change (x * completedPseudoDiffOpUniformizerInteger (K := K) ^ n : CompletedPseudoDiffOpInteger (K := K)) ∈
      completedPseudoDiffOpUniformizerPower (K := K) (n + 1)
    change x ∈ completedPseudoDiffOpUniformizerPower (K := K) 1 at hx
    rw [completedPseudoDiffOpUniformizerPower, Submodule.mem_span_singleton] at hx ⊢
    obtain ⟨c, hc⟩ := hx
    subst x
    refine ⟨c, ?_⟩
    simp only [pow_one, smul_eq_mul]
    change c * completedPseudoDiffOpUniformizerInteger (K := K) ^ (n + 1) =
      (c * completedPseudoDiffOpUniformizerInteger (K := K)) *
        completedPseudoDiffOpUniformizerInteger (K := K) ^ n
    simpa [pow_succ'] using
      (mul_assoc c (completedPseudoDiffOpUniformizerInteger (K := K))
        (completedPseudoDiffOpUniformizerInteger (K := K) ^ n)).symm
  · intro hy
    change (y : CompletedPseudoDiffOpInteger (K := K)) ∈ completedPseudoDiffOpUniformizerPower (K := K) (n + 1) at hy
    rw [completedPseudoDiffOpUniformizerPower, Submodule.mem_span_singleton] at hy
    obtain ⟨c, hc⟩ := hy
    change c * completedPseudoDiffOpUniformizerInteger (K := K) ^ (n + 1) = y at hc
    let x : CompletedPseudoDiffOpInteger (K := K) := c * completedPseudoDiffOpUniformizerInteger (K := K)
    refine ⟨x, ?_, ?_⟩
    · change x ∈ completedPseudoDiffOpUniformizerPower (K := K) 1
      rw [completedPseudoDiffOpUniformizerPower, Submodule.mem_span_singleton]
      exact ⟨c, by simp [x]⟩
    · apply Subtype.ext
      change x * completedPseudoDiffOpUniformizerInteger (K := K) ^ n = y
      rw [← hc]
      dsimp [x]
      change (c * completedPseudoDiffOpUniformizerInteger (K := K)) *
          completedPseudoDiffOpUniformizerInteger (K := K) ^ n =
        c * completedPseudoDiffOpUniformizerInteger (K := K) ^ (n + 1)
      simpa [pow_succ'] using
        (mul_assoc c (completedPseudoDiffOpUniformizerInteger (K := K))
          (completedPseudoDiffOpUniformizerInteger (K := K) ^ n))

/-- Every adjacent uniformizer-power layer is linearly equivalent to the residue quotient. -/
def completedPseudoDiffOpUniformizerPowerLayerEquiv (n : ℕ) :
    (CompletedPseudoDiffOpInteger (K := K) ⧸ completedPseudoDiffOpUniformizerPower (K := K) 1) ≃ₗ[CompletedPseudoDiffOpInteger (K := K)]
      completedPseudoDiffOpUniformizerPower (K := K) n ⧸
        completedPseudoDiffOpUniformizerPowerStep (K := K) n :=
  Submodule.Quotient.equiv _ _
    (completedPseudoDiffOpRightMulUniformizerPowerLinearEquiv (K := K) n)
    (completedPseudoDiffOpMap_uniformizerPower_one_eq_step (K := K) n)

/-- Every adjacent uniformizer-power layer has module length one. -/
theorem completedPseudoDiffOpUniformizerPowerLayer_length_one (n : ℕ) :
    Module.length (CompletedPseudoDiffOpInteger (K := K))
      (completedPseudoDiffOpUniformizerPower (K := K) n ⧸
        completedPseudoDiffOpUniformizerPowerStep (K := K) n) = 1 := by
  rw [← (completedPseudoDiffOpUniformizerPowerLayerEquiv (K := K) n).length_eq]
  rw [completedPseudoDiffOpUniformizerPower_one]
  exact completedPseudoDiffOpResidue_length_one (K := K)

/-- Canonical inclusion of an adjacent layer into the finer power quotient. -/
def completedPseudoDiffOpUniformizerLayerInclusion (n : ℕ) :
    (completedPseudoDiffOpUniformizerPower (K := K) n ⧸
      completedPseudoDiffOpUniformizerPowerStep (K := K) n) →ₗ[CompletedPseudoDiffOpInteger (K := K)]
        CompletedPseudoDiffOpInteger (K := K) ⧸ completedPseudoDiffOpUniformizerPower (K := K) (n + 1) :=
  Submodule.mapQ (completedPseudoDiffOpUniformizerPowerStep (K := K) n)
    (completedPseudoDiffOpUniformizerPower (K := K) (n + 1))
    (completedPseudoDiffOpUniformizerPower (K := K) n).subtype (by
      intro x hx
      exact hx)

/-- The canonical adjacent-layer inclusion is injective. -/
theorem completedPseudoDiffOpUniformizerLayerInclusion_injective (n : ℕ) :
    Function.Injective (completedPseudoDiffOpUniformizerLayerInclusion (K := K) n) := by
  intro q q'
  refine Submodule.Quotient.induction_on
    (completedPseudoDiffOpUniformizerPowerStep (K := K) n) q ?_
  intro x
  refine Submodule.Quotient.induction_on
    (completedPseudoDiffOpUniformizerPowerStep (K := K) n) q' ?_
  intro y hxy
  rw [Submodule.Quotient.eq]
  change (x : CompletedPseudoDiffOpInteger (K := K)) - (y : CompletedPseudoDiffOpInteger (K := K)) ∈
    completedPseudoDiffOpUniformizerPower (K := K) (n + 1)
  change Submodule.Quotient.mk (p :=
    completedPseudoDiffOpUniformizerPower (K := K) (n + 1)) (x : CompletedPseudoDiffOpInteger (K := K)) =
      Submodule.Quotient.mk (p :=
        completedPseudoDiffOpUniformizerPower (K := K) (n + 1)) (y : CompletedPseudoDiffOpInteger (K := K)) at hxy
  exact (Submodule.Quotient.eq _).1 hxy

/-- Canonical transition from the `(n+1)`-st power quotient to the `n`-th. -/
def completedPseudoDiffOpUniformizerPowerQuotientSucc (n : ℕ) :
    (CompletedPseudoDiffOpInteger (K := K) ⧸ completedPseudoDiffOpUniformizerPower (K := K) (n + 1)) →ₗ[CompletedPseudoDiffOpInteger (K := K)]
      CompletedPseudoDiffOpInteger (K := K) ⧸ completedPseudoDiffOpUniformizerPower (K := K) n :=
  Submodule.mapQ (completedPseudoDiffOpUniformizerPower (K := K) (n + 1))
    (completedPseudoDiffOpUniformizerPower (K := K) n) LinearMap.id
    (by simpa using completedPseudoDiffOpUniformizerPower_succ_le (K := K) n)

/-- The transition between consecutive uniformizer-power quotients is surjective. -/
theorem completedPseudoDiffOpUniformizerPowerQuotientSucc_surjective (n : ℕ) :
    Function.Surjective (completedPseudoDiffOpUniformizerPowerQuotientSucc (K := K) n) := by
  intro y
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective
    (completedPseudoDiffOpUniformizerPower (K := K) n) y
  exact ⟨Submodule.Quotient.mk z, rfl⟩

/-- The adjacent layer, finer quotient, and coarser quotient form an exact sequence. -/
theorem completedPseudoDiffOpUniformizerPower_exact (n : ℕ) :
    Function.Exact (completedPseudoDiffOpUniformizerLayerInclusion (K := K) n)
      (completedPseudoDiffOpUniformizerPowerQuotientSucc (K := K) n) := by
  rw [LinearMap.exact_iff]
  rw [completedPseudoDiffOpUniformizerPowerQuotientSucc, Submodule.ker_mapQ]
  ext q
  constructor
  · rintro ⟨z, hz, rfl⟩
    let x : completedPseudoDiffOpUniformizerPower (K := K) n := ⟨z, hz⟩
    refine ⟨Submodule.Quotient.mk x, ?_⟩
    rw [completedPseudoDiffOpUniformizerLayerInclusion, Submodule.mapQ_apply]
    rfl
  · rintro ⟨q', hq'⟩
    revert hq'
    refine Submodule.Quotient.induction_on
      (completedPseudoDiffOpUniformizerPowerStep (K := K) n) q' ?_
    intro x hq'
    refine ⟨x, x.property, ?_⟩
    rw [completedPseudoDiffOpUniformizerLayerInclusion, Submodule.mapQ_apply] at hq'
    exact hq'

/-- The quotient by the `n`-th uniformizer-power lattice has module length exactly `n`. -/
theorem completedPseudoDiffOpUniformizerPowerQuotient_length (n : ℕ) :
    Module.length (CompletedPseudoDiffOpInteger (K := K)) (CompletedPseudoDiffOpInteger (K := K) ⧸ completedPseudoDiffOpUniformizerPower (K := K) n) = n := by
  induction n with
  | zero =>
      rw [completedPseudoDiffOpUniformizerPower_zero]
      exact Module.length_eq_zero
  | succ n ih =>
      have hlen := Module.length_eq_add_of_exact
        (completedPseudoDiffOpUniformizerLayerInclusion (K := K) n)
        (completedPseudoDiffOpUniformizerPowerQuotientSucc (K := K) n)
        (completedPseudoDiffOpUniformizerLayerInclusion_injective (K := K) n)
        (completedPseudoDiffOpUniformizerPowerQuotientSucc_surjective (K := K) n)
        (completedPseudoDiffOpUniformizerPower_exact (K := K) n)
      rw [completedPseudoDiffOpUniformizerPowerLayer_length_one, ih] at hlen
      simpa [add_comm] using hlen

end

end GaloisForLFunctions.HTGeometry.DiffOp
