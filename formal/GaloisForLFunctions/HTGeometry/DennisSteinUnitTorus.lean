import GaloisForLFunctions.HTGeometry.TriangleTorusDefect
import GaloisForLFunctions.HTGeometry.SteinbergSymbolCoboundary

/-!
# The one-variable symbol is a product of torus elements

The function `f(v) = ⟨1, v-1⟩` that carries the whole Steinberg symbol through the coboundary
formula normalises, when `v - 1` is a unit, to a symbol with second argument `1`:

```text
⟨1, t⟩ = ⟨t, 1⟩ · [ h_ij(v), h_ik(t) ] ,        t = v - 1 ,  v = 1 + t ,
```

and the symbol with second argument `1` is itself pure torus by the three-index relation.  So `f`
lands entirely in the subgroup generated by the tori, and with it — through
`steinbergSymbol_eq_dennisSteinUnit_coboundary` — every Steinberg symbol of the pair.

This is the direction of Matsumoto's theorem: the Dennis–Stein symbols disappear and what is left is
a presentation of `K₂` by the torus alone.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n] [Fintype n]

/-- **`f(v) = ⟨1, v-1⟩` is a product of torus elements**, whenever `v - 1` is a unit. -/
theorem dennisSteinUnit_eq_torus {i j k : n} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k)
    (v t : Rˣ) (ht : (t : R) = (v : R) - 1) :
    dennisSteinUnit hij v
      = (steinbergSymbol (Ne.symm hik) (-1) v * steinbergSymbol (Ne.symm hjk) (-1) v
          * steinbergSymbol hjk (-1) v
          * torusTriangleDefect hik (Ne.symm hjk) hij v)⁻¹
        * (steinbergTorus hij v * steinbergTorus hik t * (steinbergTorus hij v)⁻¹
            * (steinbergTorus hik t)⁻¹) := by
  have hw : (v : R) = 1 + 1 * (t : R) := by rw [ht]; ring
  have hv1 : (v : R) = 1 + (t : R) * 1 := by rw [ht]; ring
  have hnorm := dennisStein_normalize_right hij hik hjk 1 t v hw
  have hone := dennisStein_right_one_eq_symbols hik (Ne.symm hjk) hij (t : R) 1 v hv1
  rw [dennisSteinUnit, show ((v : R) - 1) = (t : R) from ht.symm, hnorm, hone]

end GaloisForLFunctions.HTGeometry

end
