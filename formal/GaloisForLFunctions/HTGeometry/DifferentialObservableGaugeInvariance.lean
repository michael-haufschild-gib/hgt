import GaloisForLFunctions.HTGeometry.DifferentialIndependentObservableNet

/-!
# Finite differential observables are invariant under base-valued gauges

The differential field generated by a family is unchanged after adding a coordinatewise family
whose every jet lies in the coefficient field.  The same statement holds at every finite
observable resolution, without any independence hypothesis.

This is the exact algebraic content of gauge-invariant relational observability used below.  It
concerns which values are observable at a fixed resolution; no parameter is interpreted as time.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A labelled jet below the assigned resolution belongs to the corresponding family-observable
field.  No differential-independence assumption is needed for this direction. -/
theorem differentialJet_mem_differentialFamilyObservableField_of_lt
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : ι → E) (N : ι → ℕ) (i : ι) (n : ℕ) (hn : n < N i) :
    differentialJet n (x i) ∈ differentialFamilyObservableField F x N := by
  apply IntermediateField.subset_adjoin F
  exact ⟨(i, n), hn, rfl⟩

/-- **Finite observable gauge invariance.**  Adding a family whose complete jets lie in the
coefficient field leaves every finite multi-clock observable field exactly unchanged. -/
theorem differentialFamilyObservableField_addOfJetsInBase_eq
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x c : ι → E)
    (hc : ∀ i n, ∃ b : F, differentialJet n (c i) = algebraMap F E b)
    (N : ι → ℕ) :
    differentialFamilyObservableField F (fun i => x i + c i) N =
      differentialFamilyObservableField F x N := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro y ⟨⟨i, n⟩, hn, rfl⟩
    change n < N i at hn
    change differentialJet n (x i + c i) ∈ differentialFamilyObservableField F x N
    obtain ⟨b, hb⟩ := hc i n
    rw [differentialJet_add_apply, hb]
    exact IntermediateField.add_mem _
      (differentialJet_mem_differentialFamilyObservableField_of_lt x N i n hn)
      (IntermediateField.algebraMap_mem _ b)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro y ⟨⟨i, n⟩, hn, rfl⟩
    change n < N i at hn
    change differentialJet n (x i) ∈
      differentialFamilyObservableField F (fun i => x i + c i) N
    obtain ⟨b, hb⟩ := hc i n
    have hy := differentialJet_mem_differentialFamilyObservableField_of_lt
      (F := F) (E := E) (fun i => x i + c i) N i n hn
    rw [differentialJet_add_apply, hb] at hy
    simpa using IntermediateField.sub_mem _ hy (IntermediateField.algebraMap_mem _ b)

/-- Every order-theoretic relation between finite observable fields is invariant under the same
base-valued gauge. -/
theorem differentialFamilyObservableField_addOfJetsInBase_le_iff
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x c : ι → E)
    (hc : ∀ i n, ∃ b : F, differentialJet n (c i) = algebraMap F E b)
    (M N : ι → ℕ) :
    differentialFamilyObservableField F (fun i => x i + c i) M ≤
        differentialFamilyObservableField F (fun i => x i + c i) N ↔
      differentialFamilyObservableField F x M ≤
        differentialFamilyObservableField F x N := by
  rw [differentialFamilyObservableField_addOfJetsInBase_eq x c hc M,
    differentialFamilyObservableField_addOfJetsInBase_eq x c hc N]

/-- Equality of two finite observable fields is invariant under the same base-valued gauge. -/
theorem differentialFamilyObservableField_addOfJetsInBase_eq_iff
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x c : ι → E)
    (hc : ∀ i n, ∃ b : F, differentialJet n (c i) = algebraMap F E b)
    (M N : ι → ℕ) :
    differentialFamilyObservableField F (fun i => x i + c i) M =
        differentialFamilyObservableField F (fun i => x i + c i) N ↔
      differentialFamilyObservableField F x M =
        differentialFamilyObservableField F x N := by
  rw [differentialFamilyObservableField_addOfJetsInBase_eq x c hc M,
    differentialFamilyObservableField_addOfJetsInBase_eq x c hc N]

end

end GaloisForLFunctions.HTGeometry
