import Mathlib.RingTheory.LocalRing.Etale
import Mathlib.FieldTheory.PrimitiveElement

/-!
# A local algebra with principal nilpotent maximal ideal is generated by one element

Let `A` be a local `k`-algebra whose maximal ideal is principal and nilpotent and whose residue
field is finite and separable over `k`.  Then `A = k[γ]` for a single `γ`.

The generator is built from a primitive element `θ` of the residue extension.  Lift `θ` to `γ₀`; the
value `h(γ₀)` of its minimal polynomial lies in the maximal ideal.  If it lies in the square, replace
`γ₀` by `γ₀ + t`: the binomial expansion moves the value by `h'(γ₀)·t`, and `h'(γ₀)` is a unit by
separability, so the new value lies in the maximal ideal but not in its square — hence it *generates*
the maximal ideal.  Since the residues of `k[γ]` already fill the residue field, `A = k[γ] + 𝔪`, and
because `𝔪` is generated by an element of `k[γ]` this improves to `A = k[γ] + 𝔪^j` for every `j`.
Nilpotence finishes it.

No completeness, coefficient field or Nakayama argument is used; the maximal ideal being nilpotent
replaces all of them.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsLocalRing

variable {k A : Type*} [Field k] [CommRing A] [IsLocalRing A] [Algebra k A]

theorem residue_aeval (q : k[X]) (a : A) :
    residue A (Polynomial.aeval a q) = Polynomial.aeval (residue A a) q :=
  (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom k A (ResidueField A)) a q).symm

theorem mem_maximalIdeal_iff_residue_eq_zero {a : A} :
    a ∈ maximalIdeal A ↔ residue A a = 0 :=
  (Ideal.Quotient.eq_zero_iff_mem).symm

/-- The derivative of the minimal polynomial of a separable element does not vanish there. -/
theorem aeval_derivative_minpoly_ne_zero {E : Type*} [Field E] [Algebra k E] (θ : E)
    (hsep : IsSeparable k θ) : Polynomial.aeval θ (derivative (minpoly k θ)) ≠ 0 := by
  intro h
  obtain ⟨a, b, hab⟩ := hsep
  have hone := congrArg (Polynomial.aeval θ) hab
  rw [map_add, map_mul, map_mul, minpoly.aeval, h, map_one] at hone
  simp only [mul_zero, add_zero] at hone
  exact zero_ne_one hone

/-- **A local algebra with principal nilpotent maximal ideal and separable residue field is
generated by a single element.** -/
theorem exists_adjoin_eq_top_of_principal_nilpotent
    [FiniteDimensional k (ResidueField A)] [Algebra.IsSeparable k (ResidueField A)]
    {t : A} (ht : maximalIdeal A = Ideal.span {t})
    {N : ℕ} (hnil : (maximalIdeal A) ^ N = ⊥) :
    ∃ γ : A, Algebra.adjoin k ({γ} : Set A) = ⊤ := by
  classical
  obtain ⟨θ, hθ⟩ := Field.exists_primitive_element k (ResidueField A)
  obtain ⟨γ₀, hγ₀⟩ := residue_surjective (R := A) θ
  set h : k[X] := minpoly k θ with hhdef
  have hsep : IsSeparable k θ := Algebra.IsSeparable.isSeparable k θ
  have hder0 : Polynomial.aeval θ (derivative h) ≠ 0 :=
    aeval_derivative_minpoly_ne_zero θ hsep
  have hderU : IsUnit (Polynomial.aeval γ₀ (derivative h)) := by
    rw [← notMem_maximalIdeal]
    intro hmem
    refine hder0 ?_
    have hres := residue_aeval (derivative h) γ₀
    rw [hγ₀] at hres
    rw [← hres]
    exact mem_maximalIdeal_iff_residue_eq_zero.mp hmem
  have hmemt : t ∈ maximalIdeal A := by
    rw [ht]
    exact Ideal.mem_span_singleton_self t
  have hrt : residue A t = 0 := mem_maximalIdeal_iff_residue_eq_zero.mp hmemt
  have hgmem : ∀ γ : A, residue A γ = θ → Polynomial.aeval γ h ∈ maximalIdeal A := by
    intro γ hγ
    refine mem_maximalIdeal_iff_residue_eq_zero.mpr ?_
    rw [residue_aeval, hγ, hhdef, minpoly.aeval]
  -- the polynomial over `A`
  set H : A[X] := h.map (algebraMap k A) with hHdef
  have hHeval : ∀ a : A, Polynomial.aeval a h = Polynomial.eval a H := fun a => by
    rw [hHdef, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
  have hHder : ∀ a : A, Polynomial.aeval a (derivative h) = Polynomial.eval a (derivative H) :=
    fun a => by
      rw [hHdef, Polynomial.derivative_map, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
  -- an element of the maximal ideal outside its square generates
  have hkey : ∀ γ : A, residue A γ = θ → Polynomial.aeval γ h ∉ (maximalIdeal A) ^ 2 →
      maximalIdeal A = Ideal.span {Polynomial.aeval γ h} := by
    intro γ hγ hnot
    have hmem := hgmem γ hγ
    rw [ht, Ideal.mem_span_singleton'] at hmem
    obtain ⟨w, hw⟩ := hmem
    have hwu : IsUnit w := by
      rw [← notMem_maximalIdeal]
      intro hc
      refine hnot ?_
      rw [ht] at hc
      rw [Ideal.mem_span_singleton'] at hc
      obtain ⟨c, hc'⟩ := hc
      rw [← hw, ht, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      exact ⟨c, by rw [← hc']; ring⟩
    obtain ⟨u, hu⟩ := hwu
    refine le_antisymm ?_ ?_
    · rw [ht, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        Ideal.mem_span_singleton']
      refine ⟨((u⁻¹ : Aˣ) : A), ?_⟩
      rw [← hw, ← hu, ← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, ← hw, ht]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self t)
  -- choose the generator
  have hchoice : ∃ γ : A, residue A γ = θ ∧ maximalIdeal A = Ideal.span {Polynomial.aeval γ h} := by
    rcases eq_or_ne t 0 with ht0 | ht0
    · refine ⟨γ₀, hγ₀, ?_⟩
      have hbot : maximalIdeal A = ⊥ := by
        rw [ht, Ideal.span_singleton_eq_bot.mpr ht0]
      have hz : Polynomial.aeval γ₀ h = 0 := by
        have := hgmem γ₀ hγ₀
        rw [hbot, Ideal.mem_bot] at this
        exact this
      rw [hbot, hz, Ideal.span_singleton_eq_bot.mpr rfl]
    · have htsq : t ∉ (maximalIdeal A) ^ 2 := by
        intro hmem
        rw [ht, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem
        obtain ⟨s, hs⟩ := hmem
        have hu : IsUnit (1 - s * t) := by
          rw [← notMem_maximalIdeal]
          intro hc
          have hst : s * t ∈ maximalIdeal A := Ideal.mul_mem_left _ _ hmemt
          have hone : (1 : A) ∈ maximalIdeal A := by
            have := Ideal.add_mem _ hc hst
            simpa using this
          exact absurd hone ((Ideal.ne_top_iff_one _).mp (maximalIdeal.isMaximal A).ne_top)
        obtain ⟨v, hv⟩ := hu
        refine ht0 ?_
        have hfac : t * (1 - s * t) = 0 := by linear_combination -hs
        rw [← hv] at hfac
        have := congrArg (fun x : A => x * ((v⁻¹ : Aˣ) : A)) hfac
        simp only [zero_mul] at this
        rw [mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one] at this
        exact this
      by_cases hcase : Polynomial.aeval γ₀ h ∈ (maximalIdeal A) ^ 2
      · have hres : residue A (γ₀ + t) = θ := by rw [map_add, hγ₀, hrt, add_zero]
        refine ⟨γ₀ + t, hres, hkey _ hres ?_⟩
        obtain ⟨c, hc⟩ := H.binomExpansion γ₀ t
        rw [hHeval (γ₀ + t), hc, ← hHder γ₀, ← hHeval γ₀]
        intro hmem
        refine htsq ?_
        have ht2 : t ^ 2 ∈ (maximalIdeal A) ^ 2 := by
          rw [ht, Ideal.span_singleton_pow]
          exact Ideal.mem_span_singleton_self _
        have hrest : Polynomial.aeval γ₀ h + c * t ^ 2 ∈ (maximalIdeal A) ^ 2 :=
          Ideal.add_mem _ hcase (Ideal.mul_mem_left _ _ ht2)
        have hmid : Polynomial.aeval γ₀ (derivative h) * t ∈ (maximalIdeal A) ^ 2 := by
          have hsub := Ideal.sub_mem _ hmem hrest
          convert hsub using 1
          ring
        obtain ⟨v, hv⟩ := hderU
        have hts : t = ((v⁻¹ : Aˣ) : A) * (Polynomial.aeval γ₀ (derivative h) * t) := by
          rw [← hv, ← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
        rw [hts]
        exact Ideal.mul_mem_left _ _ hmid
      · exact ⟨γ₀, hγ₀, hkey _ hγ₀ hcase⟩
  obtain ⟨γ, hγ, hspan⟩ := hchoice
  set g : A := Polynomial.aeval γ h with hgdef
  set R : Subalgebra k A := Algebra.adjoin k ({γ} : Set A) with hRdef
  have hgR : g ∈ R := by
    rw [hgdef, hRdef, Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨h, rfl⟩
  have hRm : ∀ x : A, ∃ r ∈ R, x - r ∈ maximalIdeal A := by
    intro x
    have hsurj : Algebra.adjoin k ({θ} : Set (ResidueField A)) = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (IsAlgebraic.of_finite k θ), hθ, IntermediateField.top_toSubalgebra]
    have hx : residue A x ∈ Algebra.adjoin k ({θ} : Set (ResidueField A)) := by
      rw [hsurj]
      exact Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨q, hq⟩ := hx
    have hq' : Polynomial.aeval θ q = residue A x := hq
    refine ⟨Polynomial.aeval γ q, ?_, ?_⟩
    · rw [hRdef, Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨q, rfl⟩
    · refine mem_maximalIdeal_iff_residue_eq_zero.mpr ?_
      rw [map_sub, residue_aeval, hγ, hq', sub_self]
  have hgj : ∀ j : ℕ, g ^ j ∈ (maximalIdeal A) ^ j := by
    intro j
    rw [hspan, Ideal.span_singleton_pow]
    exact Ideal.mem_span_singleton_self _
  have hstep : ∀ (j : ℕ) (y : A), y ∈ (maximalIdeal A) ^ j →
      ∃ r ∈ R, y - r ∈ (maximalIdeal A) ^ (j + 1) := by
    intro j y hy
    rw [hspan, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hy
    obtain ⟨a, ha⟩ := hy
    obtain ⟨r', hr', hz⟩ := hRm a
    refine ⟨r' * g ^ j, Subalgebra.mul_mem _ hr' (Subalgebra.pow_mem _ hgR j), ?_⟩
    have hyr : y - r' * g ^ j = g ^ j * (a - r') := by
      rw [← ha]
      ring
    rw [hyr, pow_succ]
    exact Ideal.mul_mem_mul (hgj j) hz
  have hind : ∀ (j : ℕ) (x : A), ∃ r ∈ R, x - r ∈ (maximalIdeal A) ^ j := by
    intro j
    induction j with
    | zero =>
        intro x
        refine ⟨0, Subalgebra.zero_mem _, ?_⟩
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
    | succ j ih =>
        intro x
        obtain ⟨r, hr, hxr⟩ := ih x
        obtain ⟨r', hr', hy⟩ := hstep j (x - r) hxr
        refine ⟨r + r', Subalgebra.add_mem _ hr hr', ?_⟩
        have hxx : x - (r + r') = x - r - r' := by ring
        rw [hxx]
        exact hy
  refine ⟨γ, ?_⟩
  rw [← hRdef]
  refine eq_top_iff.mpr fun x _ => ?_
  obtain ⟨r, hr, hx⟩ := hind N x
  rw [hnil, Ideal.mem_bot, sub_eq_zero] at hx
  rw [hx]
  exact hr

end GaloisForLFunctions.HTGeometry
