import GaloisForLFunctions.HTGeometry.JacobianKaehlerAnnihilator
import GaloisForLFunctions.HTGeometry.CorankOneCokernelDeterminant

/-!
# The relative differentials of a square presentation, and the Jacobian ideal

`JacobianKaehlerAnnihilator.jacobian_smul_kaehler_eq_zero` shows the Jacobian of a square
presentation annihilates the relative differentials.  This file proves the converse containment at
a place of corank one, so the annihilator is *exactly* the Jacobian ideal.

The relations of a presentation generate its conormal module
(`Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker`), so `relationCotangent` is surjective and

```text
range (cotangentComplex) = range (cotangentComplex ∘ relationCotangent)
```

which the cotangent-space basis carries to `range (aevalDifferential)`.  Exactness of
`I/I² → ⨁ᵢ S dxᵢ → Ω[S⁄R]` together with surjectivity of `toKaehler` then identifies

```text
kaehlerEquivCoker :  Ω[S⁄R] ≃ₗ (ι → S) ⧸ range (aevalDifferential)
```

and `CorankOneCokernelDeterminant.annihilator_coker_eq_span_det_of_corank_one` computes that
annihilator:

```text
annihilator_kaehler_eq_span_jacobian
    ** over a discrete valuation ring, with the reduced Jacobian of corank one,
       Ann (Ω[S⁄R]) = (P.jacobian) **
```

Read at a place of a finite extension this is "the different is generated by the Jacobian", so the
divisorial order of the different is the order of the Jacobian.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Algebra

set_option maxHeartbeats 2000000

universe u v w

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
variable {ι : Type w} [Fintype ι] [DecidableEq ι]

namespace Algebra.PreSubmersivePresentation

variable (P : Algebra.PreSubmersivePresentation R S ι ι)

omit [DecidableEq ι] in
/-- **The distinguished relations generate the conormal module.** -/
theorem relationCotangent_surjective : Function.Surjective (relationCotangent P) := by
  rw [← LinearMap.range_eq_top, relationCotangent, Module.Basis.constr_range]
  exact Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker (P := P.toExtension) P.relation
    P.span_range_relation_eq_ker

/-- The coordinate isomorphism of the cotangent space. -/
def cotangentSpaceEquiv :
    P.toExtension.CotangentSpace ≃ₗ[S] (ι → S) :=
  P.cotangentSpaceBasis.repr.trans (Finsupp.linearEquivFunOnFinite S S ι)

theorem cotangentSpaceEquiv_cotangentComplex (hmap : P.map = _root_.id) (x : ι → S) :
    cotangentSpaceEquiv P (P.toExtension.cotangentComplex (relationCotangent P x))
      = P.aevalDifferential x := by
  have h := repr_cotangentComplex_relationCotangent P hmap x
  simp only [cotangentSpaceEquiv, LinearEquiv.trans_apply, h]
  simp

/-- The range of the cotangent complex is the range of the presentation differential. -/
theorem map_range_cotangentComplex (hmap : P.map = _root_.id) :
    (LinearMap.range P.toExtension.cotangentComplex).map
        (cotangentSpaceEquiv P).toLinearMap
      = LinearMap.range P.aevalDifferential := by
  have hrange : LinearMap.range P.toExtension.cotangentComplex
      = LinearMap.range (P.toExtension.cotangentComplex ∘ₗ relationCotangent P) := by
    rw [LinearMap.range_comp, LinearMap.range_eq_top.mpr (relationCotangent_surjective P),
      Submodule.map_top]
  have hfun : (cotangentSpaceEquiv P).toLinearMap ∘ₗ
      (P.toExtension.cotangentComplex ∘ₗ relationCotangent P) = P.aevalDifferential := by
    refine LinearMap.ext fun x => ?_
    exact cotangentSpaceEquiv_cotangentComplex P hmap x
  rw [hrange, ← LinearMap.range_comp, hfun]


/-- Isomorphic modules have the same annihilator. -/
theorem annihilator_eq_of_linearEquiv {M N : Type*} [AddCommGroup M] [Module S M]
    [AddCommGroup N] [Module S N] (e : M ≃ₗ[S] N) :
    Module.annihilator S M = Module.annihilator S N := by
  apply le_antisymm
  · intro x hx
    refine Module.mem_annihilator.mpr fun y => ?_
    have h := Module.mem_annihilator.mp hx (e.symm y)
    have h2 : e (x • e.symm y) = e 0 := by rw [h]
    rwa [map_smul, e.apply_symm_apply, map_zero] at h2
  · intro x hx
    refine Module.mem_annihilator.mpr fun y => ?_
    have h := Module.mem_annihilator.mp hx (e y)
    have h2 : e.symm (x • e y) = e.symm 0 := by rw [h]
    rwa [map_smul, e.symm_apply_apply, map_zero] at h2

/-- The relative differentials are the cokernel of the presentation differential. -/
def kaehlerEquivCoker (hmap : P.map = _root_.id) :
    Ω[S⁄R] ≃ₗ[S] (ι → S) ⧸ LinearMap.range P.aevalDifferential :=
  (LinearMap.quotKerEquivOfSurjective P.toExtension.toKaehler
      P.toExtension.toKaehler_surjective).symm.trans
    (Submodule.Quotient.equiv (LinearMap.ker P.toExtension.toKaehler)
      (LinearMap.range P.aevalDifferential) (cotangentSpaceEquiv P) (by
        rw [LinearMap.exact_iff.mp P.toExtension.exact_cotangentComplex_toKaehler]
        exact map_range_cotangentComplex P hmap))

end Algebra.PreSubmersivePresentation

section DVRPresentation

variable {S : Type v} [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
variable {R : Type u} [CommRing R] [Algebra R S] {n : ℕ}

/-- **The different of a square presentation is the Jacobian ideal, at corank one.**  Combined with
`JacobianKaehlerAnnihilator.jacobian_smul_kaehler_eq_zero`, which gives the reverse containment for
free, this pins the annihilator of the relative differentials exactly. -/
theorem annihilator_kaehler_eq_span_jacobian
    (P : Algebra.PreSubmersivePresentation R S (Fin n) (Fin n)) (hmap : P.map = _root_.id)
    (hcorank : ((LinearMap.toMatrix' P.aevalDifferential).map
      (IsLocalRing.residue S)).rank + 1 = n) :
    Module.annihilator S Ω[S⁄R] = Ideal.span {P.jacobian} := by
  classical
  have hEq := Algebra.PreSubmersivePresentation.annihilator_eq_of_linearEquiv
    (Algebra.PreSubmersivePresentation.kaehlerEquivCoker P hmap)
  have hrange : LinearMap.range P.aevalDifferential
      = LinearMap.range (LinearMap.toMatrix' P.aevalDifferential).mulVecLin := by
    rw [show (LinearMap.toMatrix' P.aevalDifferential).mulVecLin
      = P.aevalDifferential from Matrix.toLin'_toMatrix' _]
  rw [hEq, hrange, annihilator_coker_eq_span_det_of_corank_one _ hcorank,
    LinearMap.det_toMatrix', P.jacobian_eq_det_aevalDifferential]

end DVRPresentation

end

end GaloisForLFunctions.HTGeometry
