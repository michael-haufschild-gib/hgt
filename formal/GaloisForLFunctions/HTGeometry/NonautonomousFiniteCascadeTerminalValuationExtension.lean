noncomputable section

set_option maxHeartbeats 1000000

attribute [local instance] cascadeUnitCostDomain cascadeUnitCostRatFuncAlgebra
  cascadeUnitCostComplexAlgebra cascadeUnitCostScalarTower cascadeUnitCostDifferential
  cascadeUnitCostCharZero

/-- The adjacent terminal state pair, in the actual successor branch field. -/
noncomputable def nonautonomousFiniteCascadeTerminalStatePair
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : Fin 2 → NonautonomousFiniteCascadeBranchField hfan (N + 1) :=
  fun i => nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)
    ⟨N + i, by omega⟩

/-- State coordinates strictly below the adjacent terminal pair. -/
noncomputable def nonautonomousFiniteCascadeTerminalStateTail
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : Fin N → NonautonomousFiniteCascadeBranchField hfan (N + 1) :=
  fun i => nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)
    ⟨i, by omega⟩

/-- The terminal-pair/tail split is a faithful reindexing of all successor states. -/
def nonautonomousFiniteCascadeTerminalSplitIndex (N : ℕ) :
    Sum (Fin N) (Fin 2) → Fin (N + 2)
  | Sum.inl i => ⟨i, by omega⟩
  | Sum.inr i => ⟨N + i, by omega⟩

theorem nonautonomousFiniteCascadeTerminalSplitIndex_injective (N : ℕ) :
    Function.Injective (nonautonomousFiniteCascadeTerminalSplitIndex N) := by
  intro i j hij
  cases i with
  | inl i =>
      cases j with
      | inl j =>
          apply congrArg Sum.inl
          apply Fin.ext
          have hv := congrArg Fin.val hij
          simp [nonautonomousFiniteCascadeTerminalSplitIndex] at hv
          omega
      | inr j =>
          have hv := congrArg Fin.val hij
          simp [nonautonomousFiniteCascadeTerminalSplitIndex] at hv
          omega
  | inr i =>
      cases j with
      | inl j =>
          have hv := congrArg Fin.val hij
          simp [nonautonomousFiniteCascadeTerminalSplitIndex] at hv
          omega
      | inr j =>
          apply congrArg Sum.inr
          apply Fin.ext
          have hv := congrArg Fin.val hij
          simpa [nonautonomousFiniteCascadeTerminalSplitIndex] using hv

/-- Full state independence factors into terminal-pair independence and independence of the
remaining states over the terminal-pair rational field. -/
theorem algebraicIndependent_nonautonomousFiniteCascadeTerminalStateTail_over_pair
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    AlgebraicIndependent
      (IntermediateField.adjoin ℂ
        (Set.range (nonautonomousFiniteCascadeTerminalStatePair hfan N)))
      (nonautonomousFiniteCascadeTerminalStateTail hfan N) := by
  let z := nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)
  let p := nonautonomousFiniteCascadeTerminalStatePair hfan N
  let t := nonautonomousFiniteCascadeTerminalStateTail hfan N
  have hfull : AlgebraicIndependent ℂ z :=
    algebraicIndependent_nonautonomousFiniteCascadeStateInBranchField
      hfan hall (N + 1)
  have hsplit : AlgebraicIndependent ℂ (Sum.elim t p) := by
    have hcomp := hfull.comp
      (nonautonomousFiniteCascadeTerminalSplitIndex N)
      (nonautonomousFiniteCascadeTerminalSplitIndex_injective N)
    convert hcomp using 1
    funext i
    cases i <;> rfl
  exact
    (GaloisForLFunctions.algebraicIndependent_sumElim_intermediateField_iff
      p t).mp hsplit |>.2

/-- Rational field generated by the adjacent terminal state pair. -/
abbrev NonautonomousFiniteCascadeTerminalPairField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : Type :=
  IntermediateField.adjoin ℂ
    (Set.range (nonautonomousFiniteCascadeTerminalStatePair hfan N))

private theorem firstOrderStatePolynomialEval_mem_terminalPairField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (_hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (p : FirstOrderStatePolynomialRing) :
    firstOrderStatePolynomialEval
        (nonautonomousFiniteCascadeLocalJet hfan (Fin.last N)) p ∈
      (IntermediateField.adjoin ℂ
        (Set.range (nonautonomousFiniteCascadeTerminalStatePair hfan N)) :
          IntermediateField ℂ
            (NonautonomousFiniteCascadeBranchField hfan (N + 1))) := by
  let L : IntermediateField ℂ
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)) :=
    IntermediateField.adjoin ℂ
      (Set.range (nonautonomousFiniteCascadeTerminalStatePair hfan N))
  let c := firstOrderStatePolynomialEquiv.symm p
  have hp : firstOrderStatePolynomialEquiv c = p := by simp [c]
  rw [← hp, firstOrderStatePolynomialEval_equiv]
  induction c using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.aeval_C]
      exact L.algebraMap_mem a
  | add p q hp hq =>
      rw [map_add]
      exact L.add_mem hp hq
  | mul_X p i hp =>
      rw [map_mul, MvPolynomial.aeval_X]
      apply L.mul_mem hp
      rcases i with ⟨⟨i, hilt⟩, hi⟩
      interval_cases i
      · change nonautonomousFiniteCascadeTerminalStatePair hfan N 0 ∈ L
        exact IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 0)
      · change nonautonomousFiniteCascadeTerminalStatePair hfan N 1 ∈ L
        exact IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 1)
      · exact (hi rfl).elim

/-- The abstract adjacent rational state field embeds into its literal generated pair field. -/
noncomputable def nonautonomousFiniteCascadeTerminalRationalStateEval
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    FirstOrderRationalStateField →ₐ[ℂ]
      NonautonomousFiniteCascadeTerminalPairField hfan N := by
  let e := nonautonomousFiniteCascadeLocalRationalStateEval
    hfan hall (Fin.last N)
  let L : IntermediateField ℂ
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)) :=
    IntermediateField.adjoin ℂ
      (Set.range (nonautonomousFiniteCascadeTerminalStatePair hfan N))
  refine
    { toRingHom := e.toRingHom.codRestrict L.toSubring ?_
      commutes' := fun c => by
        apply Subtype.ext
        exact e.commutes c }
  intro a
  obtain ⟨p, q, hq, hpq⟩ :=
    IsFractionRing.div_surjective FirstOrderStatePolynomialRing a
  change e a ∈ L
  rw [← hpq, map_div₀ e]
  have hep : e (algebraMap FirstOrderStatePolynomialRing
      FirstOrderRationalStateField p) =
      firstOrderStatePolynomialEval
        (nonautonomousFiniteCascadeLocalJet hfan (Fin.last N)) p := by
    change nonautonomousFiniteCascadeLocalRationalStateEval
      hfan hall (Fin.last N)
        (algebraMap FirstOrderStatePolynomialRing
          FirstOrderRationalStateField p) = _
    exact firstOrderRationalStateEval_algebraMap
      (nonautonomousFiniteCascadeLocalJet hfan (Fin.last N))
      (nonautonomousFiniteCascadeLocalStatePolynomialEval_injective
        hfan hall (Fin.last N)) p
  have heq : e (algebraMap FirstOrderStatePolynomialRing
      FirstOrderRationalStateField q) =
      firstOrderStatePolynomialEval
        (nonautonomousFiniteCascadeLocalJet hfan (Fin.last N)) q := by
    change nonautonomousFiniteCascadeLocalRationalStateEval
      hfan hall (Fin.last N)
        (algebraMap FirstOrderStatePolynomialRing
          FirstOrderRationalStateField q) = _
    exact firstOrderRationalStateEval_algebraMap
      (nonautonomousFiniteCascadeLocalJet hfan (Fin.last N))
      (nonautonomousFiniteCascadeLocalStatePolynomialEval_injective
        hfan hall (Fin.last N)) q
  rw [hep, heq]
  exact L.div_mem
    (firstOrderStatePolynomialEval_mem_terminalPairField hfan hall N p)
    (firstOrderStatePolynomialEval_mem_terminalPairField hfan hall N q)

@[simp]
theorem nonautonomousFiniteCascadeTerminalRationalStateEval_coe
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (a : FirstOrderRationalStateField) :
    ((nonautonomousFiniteCascadeTerminalRationalStateEval hfan hall N a :
      NonautonomousFiniteCascadeTerminalPairField hfan N) :
        NonautonomousFiniteCascadeBranchField hfan (N + 1)) =
      nonautonomousFiniteCascadeLocalRationalStateEval
        hfan hall (Fin.last N) a := by
  unfold nonautonomousFiniteCascadeTerminalRationalStateEval
  rfl

/-- Actual terminal derivative component over its adjacent state-pair field. -/
abbrev NonautonomousFiniteCascadeTerminalComponentField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : Type :=
  IntermediateField.adjoin
    (NonautonomousFiniteCascadeTerminalPairField hfan N)
    {nonautonomousFiniteCascadeTerminalVelocitySucc hfan N}

/-- The actual terminal constituent velocity is algebraic over the literal terminal-pair field. -/
theorem nonautonomousFiniteCascadeTerminalVelocity_isAlgebraic_pairField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    IsAlgebraic
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (nonautonomousFiniteCascadeTerminalVelocitySucc hfan N) := by
  let k : Fin (N + 1) := Fin.last N
  let data := nonautonomousFiniteCascadeWimanData hall h1 k
  let p := firstOrderDerivativePolynomial data.P
  let e := nonautonomousFiniteCascadeLocalRationalStateEval hfan hall k
  let eL := nonautonomousFiniteCascadeTerminalRationalStateEval hfan hall N
  let v := nonautonomousFiniteCascadeTerminalVelocitySucc hfan N
  have hp : p ≠ 0 :=
    (firstOrderDerivativePolynomial_irreducible data).ne_zero
  have hmap : p.map eL.toRingHom ≠ 0 := by
    intro hzero
    apply hp
    apply Polynomial.map_injective eL.toRingHom eL.injective
    simpa using hzero
  refine ⟨p.map eL.toRingHom, hmap, ?_⟩
  rw [Polynomial.aeval_def, Polynomial.eval₂_map]
  have hroot :=
    nonautonomousFiniteCascadeVelocity_chosen_component_root
      hfan hall h1 k
  have hcomp :
      (algebraMap
        (NonautonomousFiniteCascadeTerminalPairField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1))).comp
          eL.toRingHom = e.toRingHom := by
    apply DFunLike.ext _ _
    intro a
    exact nonautonomousFiniteCascadeTerminalRationalStateEval_coe
      hfan hall N a
  rw [hcomp]
  rw [← Polynomial.eval_map]
  change (p.map e.toRingHom).IsRoot
    (nonautonomousFiniteCascadeLocalJet hfan k 2) at hroot
  have hv :
      nonautonomousFiniteCascadeLocalJet hfan k 2 = v := by
    change Fin.cases
        (nonautonomousFiniteCascadeStateInBranchField hfan (N + 1) k.castSucc)
        (fun i : Fin 2 => Fin.cases
          (nonautonomousFiniteCascadeStateInBranchField hfan (N + 1) k.succ)
          (fun _ : Fin 1 =>
            nonautonomousFiniteCascadeVelocityInBranchField hfan k.rev) i)
        (2 : Fin 3) =
      nonautonomousFiniteCascadeVelocityInBranchField hfan 0
    rw [show (2 : Fin 3) = Fin.succ (1 : Fin 2) by rfl, Fin.cases_succ]
    rw [show (1 : Fin 2) = Fin.succ (0 : Fin 1) by rfl, Fin.cases_succ]
    congr 1
    exact Fin.ext (by simp [k])
  rw [hv] at hroot
  exact hroot

/-- The actual terminal derivative component is algebraic over the adjacent pair field. -/
theorem nonautonomousFiniteCascadeTerminalComponent_isAlgebraic
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    Algebra.IsAlgebraic
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) := by
  apply IntermediateField.isAlgebraic_adjoin
  intro x hx
  simp only [Set.mem_singleton_iff] at hx
  subst x
  exact isAlgebraic_iff_isIntegral.mp
    (nonautonomousFiniteCascadeTerminalVelocity_isAlgebraic_pairField
      hfan hall N h1)

/-- Earlier actual cascade states stay algebraically independent after the complete terminal
derivative component is adjoined. -/
theorem algebraicIndependent_nonautonomousFiniteCascadeTerminalStateTail_over_component
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    AlgebraicIndependent
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (nonautonomousFiniteCascadeTerminalStateTail hfan N) := by
  letI : IsScalarTower
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  letI : Algebra.IsAlgebraic
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) :=
    nonautonomousFiniteCascadeTerminalComponent_isAlgebraic hfan hall N h1
  exact AlgebraicIndependent.extendScalars
    (NonautonomousFiniteCascadeTerminalComponentField hfan N)
    (algebraicIndependent_nonautonomousFiniteCascadeTerminalStateTail_over_pair
      hfan hall N)

/-- Any prescribed valuation on the actual terminal derivative component prolongs to the full
successor branch field, contracts exactly, and is trivial on every strictly earlier state. -/
theorem exists_nonautonomousFiniteCascadeTerminalComponentValuation_extension
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1)
    (A : ValuationSubring
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)) :
    ∃ B : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)),
      B.comap (algebraMap
        (NonautonomousFiniteCascadeTerminalComponentField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1))) = A ∧
      ∀ i, nonautonomousFiniteCascadeTerminalStateTail hfan N i ∈ B ∧
        (nonautonomousFiniteCascadeTerminalStateTail hfan N i)⁻¹ ∈ B := by
  exact exists_valuationSubring_extension_fin_algebraicIndependent_units A
    (nonautonomousFiniteCascadeTerminalStateTail hfan N)
    (algebraicIndependent_nonautonomousFiniteCascadeTerminalStateTail_over_component
      hfan hall N h1)

end

