import GaloisForLFunctions.HTGeometry.DigammaOverDirichletBase
import Mathlib

/-!
# Rational shift defects are inert under the Dirichlet tower

Let `B` be the field generated over `C` by the Dirichlet variable `s` and **every** Dirichlet series
with finite abscissa of absolute convergence, and let `sigma` be translation by one.  A *shift
defect* of a field is an element of `(sigma - 1) B`.

The leading-term functor sends a quotient of Dirichlet polynomials to the quotient of their leading
coefficients, and it intertwines the two shifts.  Consequently a rational function that is a shift
defect of `B` is already a shift defect of `C(s)`:

`(sigma - 1) B ∩ C(s) = (sigma - 1) C(s)`.

Adjoining every convergent Dirichlet series creates **no new rational shift defects**.  The
Hölder obstruction is therefore invisible to the whole Dirichlet tower, and the jet-tower descent
runs over `B` under a hypothesis stated purely in `C(s)`.
-/

open Polynomial Filter
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance dirInertDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance dirInertDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance dirInertComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-- The genuine rational function field in the Dirichlet variable. -/
abbrev dirRatBase : IntermediateField ℂ upperEndMeroField :=
  _root_.HTGeometry.coordBase dirCoordMero

theorem dirRatBase_le_dirZetaBase : dirRatBase ≤ dirZetaBase := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact dirCoordMero_mem_dirZetaBase

theorem aeval_dirCoordMero_ne_zero {p : ℂ[X]} (hp : p ≠ 0) :
    Polynomial.aeval dirCoordMero p ≠ 0 := by
  intro h
  exact hp (_root_.HTGeometry.aeval_coord_injective transcendental_dirCoordMero
    (by simpa using h))

theorem aeval_mem_dirRatBase (p : ℂ[X]) : Polynomial.aeval dirCoordMero p ∈ dirRatBase := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | monomial n a =>
      rw [Polynomial.aeval_monomial]
      exact mul_mem (dirRatBase.algebraMap_mem a)
        (pow_mem _root_.HTGeometry.coord_mem_coordBase n)

theorem sigma_aeval_dirCoordMero (p : ℂ[X]) :
    upperEndTranslationMeroEquiv Complex.I (Polynomial.aeval dirCoordMero p)
      = Polynomial.aeval dirCoordMero (p.comp (X + Polynomial.C 1)) :=
  _root_.HTGeometry.sigma_aeval_coord dirTranslationAlgEquiv upperEndTranslate_dirCoordMero p

/-- **Rational shift defects descend from the Dirichlet tower to the rational function field.**
If a rational function is the translation defect of some element of the field generated by all
convergent Dirichlet series, it is already the translation defect of a rational function. -/
theorem rational_defect_inert {u v : upperEndMeroField} (hu : u ∈ dirZetaBase)
    (hv : v ∈ dirRatBase)
    (hdef : upperEndTranslationMeroEquiv Complex.I u - u = v) :
    ∃ R ∈ dirRatBase, upperEndTranslationMeroEquiv Complex.I R - R = v := by
  classical
  obtain ⟨rn, rd, hrv⟩ := (IntermediateField.mem_adjoin_simple_iff ℂ v).mp hv
  rcases eq_or_ne rd 0 with rfl | hrd
  · refine ⟨0, zero_mem _, ?_⟩
    rw [hrv]
    simp
  obtain ⟨P, Q, hQ, rfl⟩ := exists_dirRealize_ratio hu
  rcases eq_or_ne P 0 with rfl | hP
  · refine ⟨0, zero_mem _, ?_⟩
    rw [map_zero, zero_div, map_zero, sub_zero] at hdef
    rw [← hdef]
    simp
  have hRQ : dirRealize Q ≠ 0 := dirRealize_ne_zero hQ
  have hsQ : faSigmaPoly Q ≠ 0 := faSigmaPoly_ne_zero hQ
  have hRsQ : dirRealize (faSigmaPoly Q) ≠ 0 := dirRealize_ne_zero hsQ
  have hrdK : Polynomial.aeval dirCoordMero rd ≠ 0 := aeval_dirCoordMero_ne_zero hrd
  rw [dirRealize_sigma_div, hrv] at hdef
  -- clear denominators on the analytic side
  have hclear : dirRealize (faEmb rd * (faSigmaPoly P * Q - P * faSigmaPoly Q))
      = dirRealize (faEmb rn * (faSigmaPoly Q * Q)) := by
    simp only [map_mul, map_sub]
    rw [dirRealize_faEmb, dirRealize_faEmb]
    field_simp at hdef
    linear_combination hdef
  have hpoly : faEmb rd * (faSigmaPoly P * Q - P * faSigmaPoly Q)
      = faEmb rn * (faSigmaPoly Q * Q) := dirRealize_injective hclear
  have hP' : faToDirPoly P ≠ 0 := fun h => hP (faToDirPoly_injective (by rw [h, map_zero]))
  have hQ' : faToDirPoly Q ≠ 0 := fun h => hQ (faToDirPoly_injective (by rw [h, map_zero]))
  have hrel : _root_.HTGeometry.DirPoly.dirichletLeadPoly.emb rd
        * (_root_.HTGeometry.DirPoly.dirichletLeadPoly.sigma (faToDirPoly P) * faToDirPoly Q
          - faToDirPoly P * _root_.HTGeometry.DirPoly.dirichletLeadPoly.sigma (faToDirPoly Q))
      = _root_.HTGeometry.DirPoly.dirichletLeadPoly.emb rn
        * (_root_.HTGeometry.DirPoly.dirichletLeadPoly.sigma (faToDirPoly Q) * faToDirPoly Q) := by
    have himg := congrArg faToDirPoly hpoly
    simp only [map_mul, map_sub, faToDirPoly_emb, faToDirPoly_sigma] at himg
    simp only [dirichletLeadPoly_sigma, dirichletLeadPoly_emb]
    exact himg
  -- the leading coefficients inherit the same rational defect
  have hlead := _root_.HTGeometry.DirichletLead.lead_shift_identity
    _root_.HTGeometry.DirPoly.dirichletLeadPoly hP' hQ' hrd hrel
  set A : ℂ[X] := _root_.HTGeometry.DirPoly.dirichletLeadPoly.lead (faToDirPoly P) with hA
  set Bq : ℂ[X] := _root_.HTGeometry.DirPoly.dirichletLeadPoly.lead (faToDirPoly Q) with hB
  have hBne : Bq ≠ 0 := _root_.HTGeometry.DirPoly.dirichletLeadPoly.lead_ne_zero hQ'
  have hBK : Polynomial.aeval dirCoordMero Bq ≠ 0 := aeval_dirCoordMero_ne_zero hBne
  have hBsne : Bq.comp (X + Polynomial.C 1) ≠ 0 := by
    intro h0
    refine hBne ?_
    have := congrArg (fun p : ℂ[X] => p.comp (X - Polynomial.C 1)) h0
    simpa [Polynomial.comp_assoc, Polynomial.add_comp, Polynomial.sub_comp] using this
  have hBsK : Polynomial.aeval dirCoordMero (Bq.comp (X + Polynomial.C 1)) ≠ 0 :=
    aeval_dirCoordMero_ne_zero hBsne
  refine ⟨Polynomial.aeval dirCoordMero A / Polynomial.aeval dirCoordMero Bq, ?_, ?_⟩
  · exact div_mem (aeval_mem_dirRatBase _) (aeval_mem_dirRatBase _)
  · rw [hrv, map_div₀, sigma_aeval_dirCoordMero, sigma_aeval_dirCoordMero]
    have hK := congrArg (fun p : ℂ[X] => Polynomial.aeval dirCoordMero p) hlead
    simp only [map_mul, map_sub] at hK
    simp only [Polynomial.C_1] at hBsK ⊢
    rw [div_sub_div _ _ hBsK hBK, div_eq_div_iff (mul_ne_zero hBsK hBK) hrdK]
    linear_combination hK

/-- **The defect hypothesis descends to the rational function field.**  If no nonzero element of the
defect span is a translation defect of `C(s)`, then none is a translation defect of the whole
Dirichlet tower. -/
theorem dirZetaBase_defect_eq_zero_of_ratBase {c : ℕ → upperEndMeroField}
    (hcrat : ∀ v ∈ _root_.HTGeometry.defectSpanAll c, v ∈ dirRatBase)
    (hnodef : ∀ u ∈ dirRatBase, ∀ v ∈ _root_.HTGeometry.defectSpanAll c,
      upperEndTranslationMeroEquiv Complex.I u - u = v → v = 0)
    (u : upperEndMeroField) (hu : u ∈ dirZetaBase)
    (v : upperEndMeroField) (hv : v ∈ _root_.HTGeometry.defectSpanAll c)
    (hduv : upperEndTranslationMeroEquiv Complex.I u - u = v) : v = 0 := by
  obtain ⟨R, hR, hRdef⟩ := rational_defect_inert hu (hcrat v hv) hduv
  exact hnodef R hR v hv hRdef

/-- **The universal law.**  Over the field generated by `C(s)` and every convergent Dirichlet
series, the jets of a shift primitive are algebraically independent as soon as the defect family
satisfies a condition *in the rational function field alone*: its members lie in `C(s)`, no member
lies in the span of its predecessors, and no nonzero element of its span is a translation defect of
`C(s)`.  The entire Dirichlet tower is invisible to the obstruction. -/
theorem dirichletTower_jetTower_transcendental {c y : ℕ → upperEndMeroField}
    (hcF : ∀ n, c n ∈ dirRatBase)
    (hcspan : ∀ v ∈ _root_.HTGeometry.defectSpanAll c, v ∈ dirRatBase)
    (hindep : ∀ n, c n ∉ _root_.HTGeometry.defectSpan c n)
    (hnodef : ∀ u ∈ dirRatBase, ∀ v ∈ _root_.HTGeometry.defectSpanAll c,
      upperEndTranslationMeroEquiv Complex.I u - u = v → v = 0)
    (hy : ∀ n, upperEndTranslationMeroEquiv Complex.I (y n) = y n + c n) (n : ℕ) :
    Transcendental (_root_.HTGeometry.jetTower dirZetaBase y n) (y n) :=
  _root_.HTGeometry.jetTower_transcendental dirTranslationAlgEquiv dirZetaBase y c
    dirZetaBase_stable (fun k => dirRatBase_le_dirZetaBase (hcF k)) hy
    dirZetaBase_fixed_const
    (dirZetaBase_defect_eq_zero_of_ratBase hcspan hnodef)
    hindep n


/-! ## The full rational-pole family -/

/-- Translation by `I * a` shifts the Dirichlet variable by `a`. -/
theorem upperEndTranslate_dirCoordMero_gen (a : ℂ) :
    upperEndTranslationMeroEquiv (Complex.I * a) dirCoordMero
      = dirCoordMero + algebraMap ℂ upperEndMeroField a := by
  have hA : upperEndTranslationAnalyticEquiv (Complex.I * a) dirCoordAnalytic
      = dirCoordAnalytic + upperEndPolyToAnalytic (Polynomial.C a) := by
    apply Subtype.ext
    change upperEndTranslateGerm (Complex.I * a) (Germ.coeRingHom upperEndFilter dirCoordFun)
      = (Germ.coeRingHom upperEndFilter dirCoordFun)
        + ((upperEndPolyToAnalytic (Polynomial.C a) : upperEndAnalyticSubring) :
            Germ upperEndFilter ℂ)
    have hconst : ((upperEndPolyToAnalytic (Polynomial.C a) : upperEndAnalyticSubring) :
        Germ upperEndFilter ℂ) = Germ.coeRingHom upperEndFilter (fun _ : ℂ => a) := by
      refine Germ.coe_eq.mpr (Filter.Eventually.of_forall fun z => ?_)
      simp
    rw [hconst, ← map_add]
    refine Germ.coe_eq.mpr (Filter.Eventually.of_forall fun z => ?_)
    show -Complex.I * (z + Complex.I * a) = -Complex.I * z + a
    have hI : Complex.I ^ (2 : ℕ) = -1 := Complex.I_sq
    linear_combination (-a) * hI
  rw [dirCoordMero, upperEndTranslationMeroEquiv_algebraMap, hA, map_add]
  rfl

/-- Translation carrying the Dirichlet variable to `s - alpha`. -/
def dirTranslateAt (a : ℂ) : upperEndMeroField ≃ₐ[ℂ] upperEndMeroField :=
  AlgEquiv.ofRingEquiv (f := upperEndTranslationMeroEquiv (Complex.I * (-a)))
    (fun b => upperEndTranslate_algebraMap_complex_gen (Complex.I * (-a)) b)

/-- The Dirichlet variable translated to have its pole at `alpha`. -/
def dirCoordAt (a : ℂ) : upperEndMeroField :=
  dirCoordMero - algebraMap ℂ upperEndMeroField a

theorem dirTranslateAt_dirCoordMero (a : ℂ) : dirTranslateAt a dirCoordMero = dirCoordAt a := by
  show upperEndTranslationMeroEquiv (Complex.I * (-a)) dirCoordMero = _
  rw [upperEndTranslate_dirCoordMero_gen, dirCoordAt, map_neg]
  ring

theorem transcendental_dirCoordAt (a : ℂ) : Transcendental ℂ (dirCoordAt a) := by
  rw [← dirTranslateAt_dirCoordMero a]
  exact _root_.HTGeometry.transcendental_algEquiv (dirTranslateAt a) transcendental_dirCoordMero

theorem coordBase_dirCoordAt (a : ℂ) : _root_.HTGeometry.coordBase (dirCoordAt a) = dirRatBase := by
  apply le_antisymm
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact sub_mem _root_.HTGeometry.coord_mem_coordBase (dirRatBase.algebraMap_mem a)
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    have h : dirCoordMero = dirCoordAt a + algebraMap ℂ upperEndMeroField a := by
      rw [dirCoordAt]; ring
    rw [h]
    exact add_mem _root_.HTGeometry.coord_mem_coordBase
      ((_root_.HTGeometry.coordBase (dirCoordAt a)).algebraMap_mem a)

theorem upperEndTranslate_dirCoordAt (a : ℂ) :
    upperEndTranslationMeroEquiv Complex.I (dirCoordAt a) = dirCoordAt a + 1 := by
  rw [dirCoordAt, map_sub, upperEndTranslate_dirCoordMero,
    upperEndTranslate_algebraMap_complex_gen]
  ring

/-- `I / z` is the inverse of the Dirichlet variable. -/
theorem rotDefectMero_eq_inv : rotDefectMero = dirCoordMero⁻¹ := by
  refine eq_inv_of_mul_eq_one_left ?_
  rw [rotDefectMero, dirCoordMero, ← map_mul]
  have hmul : rotDefectAnalytic * dirCoordAnalytic = 1 := by
    apply Subtype.ext
    change (Germ.coeRingHom upperEndFilter rotDefectFun)
        * (Germ.coeRingHom upperEndFilter dirCoordFun) = 1
    rw [← map_mul]
    have hev : ∀ᶠ z : ℂ in upperEndFilter, rotDefectFun z * dirCoordFun z = 1 := by
      rw [upperEndFilter_basis.eventually_iff]
      refine ⟨0, trivial, fun z hz => ?_⟩
      have hz0 : z ≠ 0 := ne_zero_of_mem_upperTail hz
      show Complex.I / z * (-Complex.I * z) = 1
      have hI : Complex.I * Complex.I = -1 := Complex.I_mul_I
      field_simp
      linear_combination -hI
    exact Germ.coe_eq.mpr hev
  rw [hmul, map_one]

/-- The defect jets of the shift primitive with a single pole at `alpha`. -/
def dirDefectAt (a : ℂ) (n : ℕ) : upperEndMeroField :=
  dirTranslateAt a (rotDefectJetMero n)

theorem dirDefectAt_zero (a : ℂ) : dirDefectAt a 0 = (dirCoordAt a)⁻¹ := by
  show dirTranslateAt a (differentialJet 0 rotDefectMero) = _
  rw [differentialJet_zero, rotDefectMero_eq_inv]
  show upperEndTranslationMeroEquiv (Complex.I * (-a)) dirCoordMero⁻¹ = _
  rw [map_inv₀]
  congr 1
  exact dirTranslateAt_dirCoordMero a

theorem dirDefectAt_succ (a : ℂ) (n : ℕ) :
    dirDefectAt a (n + 1) = (dirDefectAt a n)′ := by
  show dirTranslateAt a (differentialJet (n + 1) rotDefectMero) = _
  rw [differentialJet_succ]
  show upperEndTranslationMeroEquiv (Complex.I * (-a))
      ((differentialJet n rotDefectMero)′) = _
  rw [upperEndTranslationMeroEquiv_deriv]
  rfl

theorem dirDefectAt_eq_jet (a : ℂ) (n : ℕ) :
    dirDefectAt a n = differentialJet n ((dirCoordAt a)⁻¹) := by
  induction n with
  | zero => rw [differentialJet_zero, dirDefectAt_zero]
  | succ n ih => rw [dirDefectAt_succ, ih, differentialJet_succ]

theorem dirDefectAt_mul_pow (a : ℂ) (n : ℕ) :
    dirDefectAt a n * (dirCoordAt a) ^ (n + 1)
      = algebraMap ℂ upperEndMeroField (rotDefectConst n) := by
  have h := congrArg (dirTranslateAt a) (rotDefectJetMero_mul_dirCoordMero_pow n)
  rw [map_mul, map_pow, dirTranslateAt_dirCoordMero, (dirTranslateAt a).commutes] at h
  exact h

/-- **The universal rational-pole law.**  For every `alpha` in `C` and every solution of the
difference equation `y(s + 1) - y(s) = 1 / (s - alpha)`, the jets of `y` are algebraically
independent over the field generated by `C(s)` and **every** convergent Dirichlet series. -/
theorem dirichletTower_shiftPrimitive_jets_transcendental (a : ℂ)
    {y : ℕ → upperEndMeroField}
    (hy : ∀ n, upperEndTranslationMeroEquiv Complex.I (y n) = y n + dirDefectAt a n) (n : ℕ) :
    Transcendental (_root_.HTGeometry.jetTower dirZetaBase y n) (y n) := by
  have hx := transcendental_dirCoordAt a
  have hc := dirDefectAt_mul_pow a
  have hcF : ∀ m, dirDefectAt a m ∈ dirRatBase := by
    intro m
    rw [← coordBase_dirCoordAt a]
    exact _root_.HTGeometry.defect_mem_coordBase hx hc m
  have hcspan : ∀ v ∈ _root_.HTGeometry.defectSpanAll (dirDefectAt a), v ∈ dirRatBase :=
    _root_.HTGeometry.defectSpanAll_le_of_mem hcF
  have hnodef : ∀ u ∈ dirRatBase, ∀ v ∈ _root_.HTGeometry.defectSpanAll (dirDefectAt a),
      upperEndTranslationMeroEquiv Complex.I u - u = v → v = 0 := by
    intro u hu v hv hduv
    refine _root_.HTGeometry.coordBase_defect_eq_zero hx hc dirTranslationAlgEquiv
      (upperEndTranslate_dirCoordAt a) u ?_ v hv hduv
    rw [coordBase_dirCoordAt a]
    exact hu
  exact dirichletTower_jetTower_transcendental hcF hcspan
    (_root_.HTGeometry.defect_not_mem_span hx rotDefectConst_ne_zero hc) hnodef hy n

/-- **Hypertranscendence over the whole Dirichlet tower.**  Every solution of
`y(s + 1) - y(s) = 1 / (s - alpha)` satisfies no algebraic differential equation whose coefficients
are rational in `s` and differential-rational in any finite family of convergent Dirichlet series. -/
theorem dirichletTower_shiftPrimitive_hypertranscendental (a : ℂ) {y : upperEndMeroField}
    (hy : upperEndTranslationMeroEquiv Complex.I y = y + (dirCoordAt a)⁻¹) :
    GaloisForLFunctions.HypertranscendentalOver (dirZetaBase : Type _) y := by
  have hjet : ∀ n, upperEndTranslationMeroEquiv Complex.I (differentialJet n y)
      = differentialJet n y + dirDefectAt a n := by
    intro n
    induction n with
    | zero => simpa [dirDefectAt_zero] using hy
    | succ n ih =>
        rw [differentialJet_succ, upperEndTranslationMeroEquiv_deriv, ih, map_add,
          dirDefectAt_succ, ← differentialJet_succ]
  have hfree := dirichletTower_shiftPrimitive_jets_transcendental a
    (y := fun n => differentialJet n y) hjet
  have hind := _root_.HTGeometry.algebraicIndependent_of_jetTower_transcendental dirZetaBase
    (fun n => differentialJet n y) hfree
  rw [GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton]
  have hinj : Function.Injective (fun p : Unit × ℕ => p.2) := by
    rintro ⟨u1, m⟩ ⟨u2, k⟩ h
    simp only at h
    subst h
    rfl
  exact hind.comp (fun p : Unit × ℕ => p.2) hinj

end

end GaloisForLFunctions.HTGeometry
