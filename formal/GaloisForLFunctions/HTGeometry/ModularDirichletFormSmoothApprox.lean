import GaloisForLFunctions.HTGeometry.ModularDirichletFormPeriodization

/-!
# Smooth cutoffs and smooth uniform approximation inside the fundamental domain

Two pieces of real analysis on `ℂ` used to show that the interior `C¹` functions are dense in
`L²(𝒟)`:

* a `C¹` cutoff `χ : ℂ → [0, 1]` with compact support inside the image of `𝒟°` and `χ = 1` on a
  given compact subset (the smooth Urysohn lemma on a thickening);
* for a continuous function on a compact `s ⊆ ℂ`, a `C¹` (indeed polynomial in `z, z̄`) function
  on `ℂ` uniformly close to it on `s` (Stone–Weierstrass for the star-algebra of polynomials,
  whose elements are restrictions of real-smooth functions).
-/

open UpperHalfPlane MeasureTheory ModularGroup Set Topology Metric
open scoped Manifold ContDiff

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## A smooth cutoff inside `𝒟°` -/

/-- **Smooth cutoff.**  For a compact `C ⊆ 𝒟° ⊆ ℂ` there is a `C¹` function `χ : ℂ → [0, 1]` with
compact support inside `𝒟°` and `χ = 1` on `C`. -/
theorem exists_smooth_cutoff {C : Set ℂ} (hC : IsCompact C) (hCU : C ⊆ fdoImage) :
    ∃ χ : ℂ → ℝ, ContDiff ℝ 1 χ ∧ HasCompactSupport χ ∧ tsupport χ ⊆ fdoImage ∧
      EqOn χ 1 C ∧ ∀ x, χ x ∈ Icc (0 : ℝ) 1 := by
  obtain ⟨δ, hδ, hδU⟩ := hC.exists_cthickening_subset_open isOpen_fdoImage hCU
  have hdisj : Disjoint (thickening δ C)ᶜ C := by
    rw [Set.disjoint_left]
    intro x hx hxC
    exact hx (self_subset_thickening hδ C hxC)
  obtain ⟨f, h0, h1, h01⟩ := exists_contMDiffMap_zero_one_of_isClosed 𝓘(ℝ, ℂ) (n := 1)
    isOpen_thickening.isClosed_compl hC.isClosed hdisj
  have hsupp : Function.support f ⊆ thickening δ C := by
    intro x hx
    by_contra hcon
    exact hx (h0 hcon)
  have hts : tsupport f ⊆ cthickening δ C :=
    (closure_mono hsupp).trans (closure_thickening_subset_cthickening δ C)
  refine ⟨f, contMDiff_iff_contDiff.mp f.contMDiff, ?_, hts.trans hδU, h1, h01⟩
  exact (hC.cthickening).of_isClosed_subset (isClosed_tsupport _) hts

/-! ## Smooth uniform approximation on compacts -/

/-- Every element of the star-algebra generated by the polynomial functions on `s ⊆ ℂ` is the
restriction of a real-smooth function on `ℂ`. -/
theorem exists_contDiff_of_mem_starClosure (s : Set ℂ) {f : C(s, ℂ)}
    (hf : f ∈ (polynomialFunctions s).starClosure) :
    ∃ P : ℂ → ℂ, ContDiff ℝ 1 P ∧ ∀ x : s, f x = P x := by
  rw [polynomialFunctions.starClosure_eq_adjoin_X] at hf
  induction hf using StarAlgebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    subst hx
    refine ⟨id, contDiff_id, fun x => ?_⟩
    simp [Polynomial.toContinuousMapOnAlgHom_apply, Polynomial.toContinuousMapOn_apply,
      Polynomial.toContinuousMap_apply]
  | algebraMap r =>
    refine ⟨fun _ => r, contDiff_const, fun x => ?_⟩
    simp [Algebra.algebraMap_eq_smul_one]
  | add x y _ _ hx hy =>
    obtain ⟨P, hP, hPx⟩ := hx
    obtain ⟨Q, hQ, hQy⟩ := hy
    exact ⟨P + Q, hP.add hQ, fun z => by simp [hPx z, hQy z]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨P, hP, hPx⟩ := hx
    obtain ⟨Q, hQ, hQy⟩ := hy
    exact ⟨P * Q, hP.mul hQ, fun z => by simp [hPx z, hQy z]⟩
  | star x _ hx =>
    obtain ⟨P, hP, hPx⟩ := hx
    refine ⟨fun w => starRingEnd ℂ (P w), ?_, fun z => by simp [hPx z]⟩
    exact (Complex.conjCLE : ℂ →L[ℝ] ℂ).contDiff.comp hP

/-- **Smooth uniform approximation.**  A function continuous on a compact `s ⊆ ℂ` is uniformly
approximated on `s` by real-smooth functions on `ℂ`. -/
theorem exists_contDiff_uniform_approx {s : Set ℂ} (hs : IsCompact s) {G : ℂ → ℂ}
    (hG : ContinuousOn G s) {η : ℝ} (hη : 0 < η) :
    ∃ P : ℂ → ℂ, ContDiff ℝ 1 P ∧ ∀ x ∈ s, ‖G x - P x‖ < η := by
  haveI : CompactSpace s := isCompact_iff_compactSpace.mp hs
  let Gs : C(s, ℂ) := ⟨s.restrict G, hG.restrict⟩
  have hmem : Gs ∈ (polynomialFunctions s).starClosure.topologicalClosure := by
    rw [polynomialFunctions.starClosure_topologicalClosure]
    exact StarSubalgebra.mem_top
  have hcl : Gs ∈ closure ((polynomialFunctions s).starClosure : Set C(s, ℂ)) := hmem
  obtain ⟨f, hf, hdist⟩ := Metric.mem_closure_iff.mp hcl η hη
  obtain ⟨P, hP, hPf⟩ := exists_contDiff_of_mem_starClosure s hf
  refine ⟨P, hP, fun x hx => ?_⟩
  have h := (ContinuousMap.dist_lt_iff hη).mp hdist ⟨x, hx⟩
  rw [dist_eq_norm] at h
  simpa [Gs, hPf ⟨x, hx⟩] using h

end

end GaloisForLFunctions.HTGeometry
