import GaloisForLFunctions.HTGeometry.PaperHomogeneousGeneratorIdeal
import GaloisForLFunctions.HTGeometry.Nieto1810GrassmannPlucker

/-!
# Native bivector relations in actual normal coordinates

The OpenAI StableCoordinate Rees coefficient kernel, with the quadratic ideal
order bound proved here, preserves the complete relation ideal of the native
decomposable-bivector family. This includes its Grassmann--Plücker identities.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

variable (K ι : Type*) [CommRing K]

/-- The native bivector of the two universal rows. -/
def paperPluckerGenerator (ij : ι × ι) : MvPolynomial (ι ⊕ ι) K :=
  Nieto1810.decomposableBivector (fun i => X (Sum.inl i)) (fun i => X (Sum.inr i)) ij.1 ij.2

/-- Ideal generated by the native universal bivector coordinates. -/
def paperPluckerIdeal : Ideal (MvPolynomial (ι ⊕ ι) K) :=
  paperHomogeneousGeneratorIdeal (paperPluckerGenerator K ι)

/-- The native universal bivector coordinates are homogeneous quadratics. -/
theorem paperPluckerGenerator_homogeneous (ij : ι × ι) :
    (paperPluckerGenerator K ι ij).IsHomogeneous 2 :=
  ((isHomogeneous_X K (Sum.inl ij.1)).mul (isHomogeneous_X K (Sum.inr ij.2))).sub
    ((isHomogeneous_X K (Sum.inr ij.1)).mul (isHomogeneous_X K (Sum.inl ij.2)))

/-- All hypotheses of the source normal-relation mechanism are supplied by the native family. -/
def paperPluckerNormalPresentation :
    PaperHomogeneousNormalPresentationData K (ι ⊕ ι) (ι × ι) (paperPluckerIdeal K ι) :=
  paperHomogeneousGeneratorNormalPresentation (paperPluckerGenerator K ι) 2
    (Nat.succ_pos 1) (paperPluckerGenerator_homogeneous K ι)

/-- Simultaneous substitution into the actual bivector initial classes. -/
def paperPluckerNormalMap : MvPolynomial (ι × ι) K →+*
    PaperIdealAssociatedGraded (paperPluckerIdeal K ι) :=
  (paperPluckerNormalPresentation K ι).polynomialMap

/-- All scalar polynomial relations, not only the displayed quadrics, are preserved exactly. -/
theorem paperPluckerNormalMap_relations_iff (p : MvPolynomial (ι × ι) K) :
    paperPluckerNormalMap K ι p = 0 ↔ aeval (paperPluckerGenerator K ι) p = 0 :=
  (paperPluckerNormalPresentation K ι).polynomialMap_eq_zero_iff p

/-- The actual initial bivector coordinate in the native associated graded ring. -/
def paperPluckerNormalCoordinate (i j : ι) : PaperIdealAssociatedGraded (paperPluckerIdeal K ι) :=
  paperPluckerNormalMap K ι (X (i, j))

/-- Normal coordinates are the specialization of the actual native bivector generators. -/
theorem paperPluckerNormalCoordinate_eq_initial (i j : ι) :
    paperPluckerNormalCoordinate K ι i j =
      paperNativeReesSpecialization (paperPluckerIdeal K ι)
        (ReesGrading.mono (paperPluckerIdeal K ι) 1 (paperPluckerGenerator K ι (i, j)) (by
          simpa only [pow_one, paperPluckerIdeal] using
            paperHomogeneousGeneratorIdeal_mem (paperPluckerGenerator K ι) (i, j))) :=
  (paperPluckerNormalPresentation K ι).polynomialMap_X (i, j)

/-- Repeated-index normal bivector coordinates vanish. -/
theorem paperPluckerNormalCoordinate_self (i : ι) : paperPluckerNormalCoordinate K ι i i = 0 := by
  apply (paperPluckerNormalMap_relations_iff K ι (X (i, i))).mpr
  simp [paperPluckerGenerator]

/-- Antisymmetry survives in the actual normal ring, in every characteristic. -/
theorem paperPluckerNormalCoordinate_swap (i j : ι) :
    paperPluckerNormalCoordinate K ι j i = -paperPluckerNormalCoordinate K ι i j := by
  have hg : paperPluckerGenerator K ι (j, i) = -paperPluckerGenerator K ι (i, j) :=
    Nieto1810.decomposableBivector_swap
      (fun a => (X (Sum.inl a) : MvPolynomial (ι ⊕ ι) K)) (fun a => X (Sum.inr a)) i j
  have h : aeval (R := K) (paperPluckerGenerator K ι) (X (j, i) + X (i, j)) = 0 := by
    rw [map_add, aeval_X, aeval_X]
    exact (congrArg (fun a => a + paperPluckerGenerator K ι (i, j)) hg).trans
      (neg_add_cancel (paperPluckerGenerator K ι (i, j)))
  have hh := (paperPluckerNormalMap_relations_iff K ι _).mpr h
  exact eq_neg_of_add_eq_zero_left ((map_add (paperPluckerNormalMap K ι) _ _).symm.trans hh)

/-- The native Grassmann--Plücker identity holds for the actual initial classes. -/
theorem paperPluckerNormalCoordinate_plucker (i j k l : ι) :
    paperPluckerNormalCoordinate K ι i j * paperPluckerNormalCoordinate K ι k l -
      paperPluckerNormalCoordinate K ι i k * paperPluckerNormalCoordinate K ι j l +
      paperPluckerNormalCoordinate K ι i l * paperPluckerNormalCoordinate K ι j k = 0 := by
  change paperPluckerNormalMap K ι (X (i, j)) * paperPluckerNormalMap K ι (X (k, l)) -
    paperPluckerNormalMap K ι (X (i, k)) * paperPluckerNormalMap K ι (X (j, l)) +
    paperPluckerNormalMap K ι (X (i, l)) * paperPluckerNormalMap K ι (X (j, k)) = 0
  rw [← map_mul, ← map_mul, ← map_mul, ← map_sub, ← map_add]
  apply (paperPluckerNormalMap_relations_iff K ι _).mpr
  simp only [map_add, map_sub, map_mul, aeval_X, paperPluckerGenerator]
  exact Nieto1810.decomposableBivector_plucker _ _ i j k l

/-- The original bivector-coordinate ring embeds into the actual normal ring. -/
def paperPluckerGeneratorRingEmbedding :
    (aeval (R := K) (paperPluckerGenerator K ι)).toRingHom.range →+*
      PaperIdealAssociatedGraded (paperPluckerIdeal K ι) :=
  (paperPluckerNormalPresentation K ι).generatorRingEmbedding

/-- The embedding preserves every element of the original bivector-coordinate ring. -/
theorem paperPluckerGeneratorRingEmbedding_injective :
    Function.Injective (paperPluckerGeneratorRingEmbedding K ι) :=
  (paperPluckerNormalPresentation K ι).generatorRingEmbedding_injective

end

end GaloisForLFunctions.HTGeometry
