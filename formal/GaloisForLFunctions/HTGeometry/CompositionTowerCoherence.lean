import GaloisForLFunctions.HTGeometry.CompositionJetPolynomials
import GaloisForLFunctions.HTGeometry.UltraproductRank

/-!
# One autonomous equation for a whole tower of composites

A family of composites `Φ_n ∘ g_n` is described by two jet families obeying the chain-rule
recursion.  The universal composition-jet polynomials express every derivative of the composite as
a fixed polynomial in those jets, so if in every ultraproduct along the family index the two jet
families generate a field of transcendence degree at most `d`, then `d + 1` derivatives of the
composite are algebraically dependent **over the constants** — uniformly in the family index.

This replaces the Boshernitzan–Rubel closure theorem for the purpose of exhibiting one autonomous
algebraic differential equation shared by all members of a compositional family: the transcendence
count is performed once, in the ultraproduct, where the family parameter has become a single
element of the coefficient field.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter MvPolynomial

/-- **One autonomous equation for a compositional family.**  Two jet families obeying the chain-rule
recursion, whose germs in every ultraproduct are algebraic over a field generated by `d` germs,
give a single nonzero polynomial in `d + 1` variables annihilating the jets of every composite. -/
theorem exists_uniform_annihilator_of_composition_rank
    {ι K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] (D : Derivation ℤ Ω Ω)
    (hK : ∀ x : K, D (algebraMap K Ω x) = 0) {d : ℕ}
    (a c : ι → ℕ → Ω) (basis : ι → Fin d → Ω)
    (ha : ∀ (n : ι) (j : ℕ), D (a n j) = a n (j + 1) * c n 0)
    (hc : ∀ (n : ι) (i : ℕ), D (c n i) = c n (i + 1))
    (hrankA : ∀ (u : Ultrafilter ι) (j : ℕ),
      IsAlgebraic ↥(IntermediateField.adjoin K (Set.range fun k : Fin d =>
          ((fun n => basis n k : ι → Ω) : Filter.Germ (u : Filter ι) Ω)))
        ((fun n => a n j : ι → Ω) : Filter.Germ (u : Filter ι) Ω))
    (hrankC : ∀ (u : Ultrafilter ι) (i : ℕ),
      IsAlgebraic ↥(IntermediateField.adjoin K (Set.range fun k : Fin d =>
          ((fun n => basis n k : ι → Ω) : Filter.Germ (u : Filter ι) Ω)))
        ((fun n => c n i : ι → Ω) : Filter.Germ (u : Filter ι) Ω)) :
    ∃ Q : MvPolynomial (Fin (d + 1)) K, Q ≠ 0 ∧
      ∀ n : ι, MvPolynomial.aeval (fun k : Fin (d + 1) => (⇑D)^[(k : ℕ)] (a n 0)) Q = 0 := by
  classical
  set ξ : ι → Fin (d + 1) → Ω := fun n k => (⇑D)^[(k : ℕ)] (a n 0) with hξ
  refine exists_uniform_annihilator_of_ultraproduct_rank ξ basis ?_
  intro u k
  have hrep : ∀ n : ι,
      ξ n k = MvPolynomial.aeval (Sum.elim (a n) (c n)) (compJetPoly K (k : ℕ)) := fun n =>
    iterate_deriv_eq_aeval_compJetPoly D hK (a n) (c n) (ha n) (hc n) (k : ℕ)
  have hgerm : ((fun n => ξ n k : ι → Ω) : Filter.Germ (u : Filter ι) Ω)
      = MvPolynomial.aeval (fun w : CompJetVar =>
          ((fun n => Sum.elim (a n) (c n) w : ι → Ω) : Filter.Germ (u : Filter ι) Ω))
          (compJetPoly K (k : ℕ)) := by
    rw [aeval_germ]
    congr 1
    funext n
    exact hrep n
  rw [hgerm]
  refine isAlgebraic_aeval _ _ ?_ _
  intro w
  cases w with
  | inl j => exact hrankA u j
  | inr i => exact hrankC u i

end GaloisForLFunctions.HTGeometry
