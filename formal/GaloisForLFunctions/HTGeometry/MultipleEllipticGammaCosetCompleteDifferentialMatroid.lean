import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaCosetAllFaceIndependence
import GaloisForLFunctions.HTGeometry.DifferentialOperatorMatroid

/-!
# The complete arbitrary-translation differential matroid

The arbitrary-complex-translation form of the multiple elliptic-gamma matroid law.  Translations
are taken from `A + ∑_{j ∈ J} ℤ τ_j` for an arbitrary label set `A` that is separated modulo the
full period lattice, so the operators are arbitrary finite elements of the complex translation
group algebra rather than of the Laurent subalgebra generated by the hierarchy parameters.

* **`cosetSelectedFaces_differentialIndependent`** — every injectively selected finite family of
  labelled non-boundary face coordinates is differentially independent;
* **`cosetFacePacket_differentialAlgebraic_iff`** — the exact two-survivor phase boundary;
* **`cosetCompleteDifferentialMatroid`** — the complete matroid law;
* **`cosetCompleteDifferentialRank`** — its numerical rank form.
-/

open Filter Set Topology Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions

open Bottcher HTGeometry
open MatroidGluing MatroidGluing.Rank MatroidGluing.Meromorphic

noncomputable section

attribute [local instance] facePacketMeroDecidableEq

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Every injectively selected finite family of labelled translated non-boundary face coordinates
is differentially independent. -/
theorem cosetSelectedFaces_differentialIndependent
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ : Type} (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x) :
    DifferentialIndependent ℂ x := by
  have hall := cosetProperFacePackets_diffIndepOn τ hτ hQ hι hA
  unfold DiffIndepOn at hall
  exact hall.comp
    (fun k => ⟨x k, hxmem k⟩)
    (fun a b hab => hxinj (congrArg Subtype.val hab))

/-- The same over the natural rational coordinate field `ℂ(z)`. -/
theorem cosetSelectedFaces_differentialIndependent_rationalBase
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ : Type} (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x) :
    DifferentialIndependent meromorphicRationalCoordinateField x := by
  have hC := cosetSelectedFaces_differentialIndependent τ hτ hQ hι hA x hxmem hxinj
  have hCoordinate :=
    HTGeometry.DifferentialIndependent.extendScalarsDifferentialAdjoinSingleton
      hC differentialAlgebraicOver_meromorphicRationalCoordinate
  rw [differentialAdjoin_meromorphicRationalCoordinate_eq] at hCoordinate
  exact hCoordinate

/-- **Exact two-survivor phase boundary, arbitrary translations.**  A labelled translated face
coordinate is differentially algebraic over `ℂ(z)` exactly when its face retains fewer than two
periods. -/
theorem cosetFacePacket_differentialAlgebraic_iff
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    (J : Finset ι) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ cosetFacePacket τ hτ A J) :
    DifferentialAlgebraicOver meromorphicRationalCoordinateField y ↔
      (Jᶜ).card < 2 := by
  constructor
  · intro hda
    by_contra hnot
    have htwo : 2 ≤ (Jᶜ).card := by omega
    have hxmem : ∀ _ : Unit, y ∈
        cosetFacePacketUnion τ hτ A {L : Finset ι | 2 ≤ (Lᶜ).card} := by
      intro _
      exact Set.mem_iUnion₂.mpr ⟨J, htwo, hy⟩
    have hsingle :=
      cosetSelectedFaces_differentialIndependent_rationalBase
        τ hτ hQ hι hA (fun _ : Unit => y) hxmem (by intro a b _; exact Subsingleton.elim a b)
    have hht : HypertranscendentalOver meromorphicRationalCoordinateField y := by
      rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
      simpa using hsingle
    exact hht hda
  · intro hlt
    rw [differentialAlgebraicOver_meromorphicRationalCoordinateField_iff]
    exact differentialAlgebraicOver_cosetFacePacket_of_compl_lt_two
      τ hτ hQ hι A J hlt hy

/-- **Complete arbitrary-translation differential-matroid law.**  For any finite selection of
distinct labelled translated non-boundary face coordinates and every finite family of
constant-coefficient differential-operator rows, the nonlinear differential matroid of the
resulting functions is exactly the ordinary row matroid over the fraction field of `ℂ[∂]`. -/
theorem cosetCompleteDifferentialMatroid
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ ρ : Type} [Fintype κ] [Fintype ρ]
    [DecidableEq κ] [DecidableEq ρ]
    (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x)
    (L : ρ → κ → Polynomial ℂ) :
    differentialFamilyMatroid (F := ℂ) (differentialOperatorRowApply L x) =
      differentialOperatorRowMatroid L :=
  differentialFamilyMatroid_differentialOperatorRows_eq
    meroField_deriv_algebraMap_complex_rationalBase L x
    (cosetSelectedFaces_differentialIndependent τ hτ hQ hι hA x hxmem hxinj)

/-- Natural-base form of the complete arbitrary-translation law. -/
theorem cosetCompleteDifferentialMatroid_rationalBase
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ ρ : Type} [Fintype κ] [Fintype ρ]
    [DecidableEq κ] [DecidableEq ρ]
    (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x)
    (L : ρ → κ → Polynomial ℂ) :
    differentialFamilyMatroid (F := meromorphicRationalCoordinateField)
        (differentialOperatorRowApply L x) =
      differentialOperatorRowMatroid L := by
  rw [differentialFamilyMatroid]
  rw [differentialMatroid_meromorphicRationalCoordinateField_eq]
  exact cosetCompleteDifferentialMatroid τ hτ hQ hι hA x hxmem hxinj L

/-- **Numerical form of the complete arbitrary-translation law.** -/
theorem cosetCompleteDifferentialRank
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ ρ : Type} [Fintype κ] [Fintype ρ]
    [DecidableEq κ] [DecidableEq ρ]
    (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x)
    (L : ρ → κ → Polynomial ℂ) (I : Finset ρ) :
    (differentialFamilyMatroid (F := ℂ)
        (differentialOperatorRowApply L x)).eRk (↑I : Set ρ) =
      (Module.finrank (FractionRing (Polynomial ℂ))
        (Submodule.span (FractionRing (Polynomial ℂ))
          ((fun i => localizeOperatorRow (L i)) '' (↑I : Set ρ))) : ℕ∞) :=
  differentialOperatorRows_eRk_eq_finrank_span
    meroField_deriv_algebraMap_complex_rationalBase L x
    (cosetSelectedFaces_differentialIndependent τ hτ hQ hι hA x hxmem hxinj) I

/-- Natural-base numerical rank law over `ℂ(z)`. -/
theorem cosetCompleteDifferentialRank_rationalBase
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (hQ : PeriodsIntegrallyIndependent τ) (hι : 2 ≤ Fintype.card ι)
    {A : Set ℂ} (hA : CosetSeparated τ A)
    {κ ρ : Type} [Fintype κ] [Fintype ρ]
    [DecidableEq κ] [DecidableEq ρ]
    (x : κ → meroField (Set.univ : Set ℂ))
    (hxmem : ∀ k, x k ∈
      cosetFacePacketUnion τ hτ A {J : Finset ι | 2 ≤ (Jᶜ).card})
    (hxinj : Function.Injective x)
    (L : ρ → κ → Polynomial ℂ) (I : Finset ρ) :
    (differentialFamilyMatroid (F := meromorphicRationalCoordinateField)
        (differentialOperatorRowApply L x)).eRk (↑I : Set ρ) =
      (Module.finrank (FractionRing (Polynomial ℂ))
        (Submodule.span (FractionRing (Polynomial ℂ))
          ((fun i => localizeOperatorRow (L i)) '' (↑I : Set ρ))) : ℕ∞) := by
  rw [differentialFamilyMatroid]
  rw [differentialMatroid_meromorphicRationalCoordinateField_eq]
  exact cosetCompleteDifferentialRank τ hτ hQ hι hA x hxmem hxinj L I

end

end GaloisForLFunctions
