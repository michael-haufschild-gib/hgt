import GaloisForLFunctions.HTGeometry.SymmetricGaugeProbe
import GaloisForLFunctions.HTGeometry.GaugeRowPacketAtlas

/-!
# Row-packet atlases with free symmetry orbits

For a symmetry-constrained gauge the evaluation nodes must have free orbits under the group
generated by the functional equation and Schwarz reality: the equivariant interpolation data is
prescribed once per orbit, so distinct orbit points must not collide.

Translating a collision-free row packet along the diagonal `t ↦ t(1+i)` achieves this, because each
orbit point is an affine function of `t` with a nonzero coefficient, and the four coefficients are
pairwise distinct.  The bad parameters therefore form a countable set.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Topology

noncomputable section

/-! ### The diagonal translation -/

/-- The coefficient of the diagonal parameter in each symmetry-orbit point. -/
def orbitCoef (j : Fin 4) : ℂ :=
  if j = 0 then 1 + Complex.I
  else if j = 1 then -(1 + Complex.I)
  else if j = 2 then 1 - Complex.I
  else -(1 - Complex.I)

/-- The constant part of each symmetry-orbit point. -/
def orbitBase {X : Type*} (a : X → ℂ) (q : X × Fin 4) : ℂ :=
  if q.2 = 0 then a q.1
  else if q.2 = 1 then 1 - a q.1
  else if q.2 = 2 then (starRingEnd ℂ) (a q.1)
  else 1 - (starRingEnd ℂ) (a q.1)

theorem orbitCoef_ne_zero (j : Fin 4) : orbitCoef j ≠ 0 := by
  fin_cases j <;> simp [orbitCoef, Complex.ext_iff]

theorem orbitCoef_injective : Function.Injective orbitCoef := by
  intro j k hjk
  fin_cases j <;> fin_cases k <;>
    simp_all [orbitCoef, Complex.ext_iff] <;> norm_num at hjk

theorem gaugeProbeOrbitNode_diag {X : Type*} (a : X → ℂ) (t : ℝ) (q : X × Fin 4) :
    gaugeProbeOrbitNode (fun x => (t : ℂ) * (1 + Complex.I) + a x) q
      = orbitCoef q.2 * (t : ℂ) + orbitBase a q := by
  have hconj : (starRingEnd ℂ) ((t : ℂ) * (1 + Complex.I))
      = (t : ℂ) * (1 - Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, map_add, map_one, Complex.conj_I]
    ring
  unfold gaugeProbeOrbitNode orbitBase orbitCoef
  by_cases h0 : q.2 = 0
  · rw [if_pos h0, if_pos h0, if_pos h0]; ring
  · rw [if_neg h0, if_neg h0, if_neg h0]
    by_cases h1 : q.2 = 1
    · rw [if_pos h1, if_pos h1, if_pos h1]; ring
    · rw [if_neg h1, if_neg h1, if_neg h1]
      by_cases h2 : q.2 = 2
      · rw [if_pos h2, if_pos h2, if_pos h2, map_add, hconj]; ring
      · rw [if_neg h2, if_neg h2, if_neg h2, map_add, hconj]; ring

theorem orbitBase_injective_of_same {X : Type*} {a : X → ℂ} (ha : Function.Injective a)
    {p q : X × Fin 4} (hsnd : p.2 = q.2) (hfst : p.1 ≠ q.1) :
    orbitBase a p ≠ orbitBase a q := by
  unfold orbitBase
  rw [hsnd]
  intro hcon
  refine hfst ?_
  by_cases h0 : q.2 = 0
  · rw [if_pos h0, if_pos h0] at hcon
    exact ha hcon
  · rw [if_neg h0, if_neg h0] at hcon
    by_cases h1 : q.2 = 1
    · rw [if_pos h1, if_pos h1] at hcon
      exact ha (by linear_combination -hcon)
    · rw [if_neg h1, if_neg h1] at hcon
      by_cases h2 : q.2 = 2
      · rw [if_pos h2, if_pos h2] at hcon
        exact ha ((starRingEnd ℂ).injective hcon)
      · rw [if_neg h2, if_neg h2] at hcon
        refine ha ((starRingEnd ℂ).injective ?_)
        linear_combination -hcon

theorem subsingleton_setOf_affine {α : ℂ} (hα : α ≠ 0) (w : ℂ) :
    {t : ℝ | α * (t : ℂ) = w}.Subsingleton := by
  intro s hs u hu
  have hs' : α * (s : ℂ) = w := hs
  have hu' : α * (u : ℂ) = w := hu
  have hcast : ((s : ℝ) : ℂ) = ((u : ℝ) : ℂ) :=
    mul_left_cancel₀ hα (hs'.trans hu'.symm)
  exact_mod_cast hcast

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open Set Topology

noncomputable section

variable {row ι : Type*} [Fintype row] [Fintype ι]

/-- Ambient shifts for which one row packet has a free symmetry orbit, avoids the origin, the
divisor of the source, and the passport set. -/
def symGoodCombinedRowPacketAmbientSet (W : ℂ → ℂ) (A : Finset ℂ)
    (packet : InjectiveProjectiveRowPacket row) : Set (ι → ℂ) :=
  (⋂ p : ((row × ι) × Fin 4) × ((row × ι) × Fin 4), ⋂ _ : p.1 ≠ p.2,
      {shift : ι → ℂ | gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2) p.1
        ≠ gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2) p.2}) ∩
    ((⋂ q : (row × ι) × Fin 4,
        {shift : ι → ℂ | gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2) q ≠ 0}) ∩
      ((⋂ x : row × ι, {shift : ι → ℂ | W (packet.1 x.1 + shift x.2) ≠ 0}) ∩
        (⋂ x : row × ι, ⋂ a ∈ A, {shift : ι → ℂ | packet.1 x.1 + shift x.2 ≠ a})))

/-- Corresponding chart in the collision-free shift configuration space. -/
def symGoodCombinedRowPacketSet (W : ℂ → ℂ) (A : Finset ℂ)
    (packet : InjectiveProjectiveRowPacket row) : Set (InjectiveShiftConfiguration ι) :=
  Subtype.val ⁻¹' symGoodCombinedRowPacketAmbientSet (ι := ι) W A packet

omit [Fintype row] [Fintype ι] in
theorem continuous_gaugeProbeOrbitNode_shift (packet : InjectiveProjectiveRowPacket row)
    (q : (row × ι) × Fin 4) :
    Continuous
      (fun shift : ι → ℂ => gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2) q) := by
  have hbase : Continuous (fun shift : ι → ℂ => packet.1 q.1.1 + shift q.1.2) :=
    continuous_const.add (continuous_apply q.1.2)
  unfold gaugeProbeOrbitNode
  split_ifs
  · exact hbase
  · exact continuous_const.sub hbase
  · exact Complex.continuous_conj.comp hbase
  · exact continuous_const.sub (Complex.continuous_conj.comp hbase)

theorem symGoodCombinedRowPacketAmbientSet_isOpen {W : ℂ → ℂ} (hW : Continuous W)
    (A : Finset ℂ) (packet : InjectiveProjectiveRowPacket row) :
    IsOpen (symGoodCombinedRowPacketAmbientSet (ι := ι) W A packet) := by
  classical
  refine IsOpen.inter (isOpen_iInter_of_finite fun p => isOpen_iInter_of_finite fun _ => ?_)
    (IsOpen.inter (isOpen_iInter_of_finite fun q => ?_)
      (IsOpen.inter (isOpen_iInter_of_finite fun x => ?_)
        (isOpen_iInter_of_finite fun x => isOpen_biInter_finset fun a _ => ?_)))
  · exact isOpen_ne_fun (continuous_gaugeProbeOrbitNode_shift packet p.1)
      (continuous_gaugeProbeOrbitNode_shift packet p.2)
  · exact isOpen_ne_fun (continuous_gaugeProbeOrbitNode_shift packet q) continuous_const
  · exact isOpen_ne_fun (hW.comp (continuous_const.add (continuous_apply x.2))) continuous_const
  · exact isOpen_ne_fun (continuous_const.add (continuous_apply x.2)) continuous_const

theorem symGoodCombinedRowPacketSet_isOpen {W : ℂ → ℂ} (hW : Continuous W)
    (A : Finset ℂ) (packet : InjectiveProjectiveRowPacket row) :
    IsOpen (symGoodCombinedRowPacketSet (ι := ι) W A packet) :=
  (symGoodCombinedRowPacketAmbientSet_isOpen (ι := ι) hW A packet).preimage
    continuous_subtype_val

omit [Fintype row] [Fintype ι] in
theorem orbitInjective_of_mem_symGood {W : ℂ → ℂ} {A : Finset ℂ}
    {packet : InjectiveProjectiveRowPacket row} {shift : ι → ℂ}
    (h : shift ∈ symGoodCombinedRowPacketAmbientSet W A packet) :
    Function.Injective (gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2)) := by
  intro p q hpq
  by_contra hne
  exact (Set.mem_iInter.mp (Set.mem_iInter.mp h.1 (p, q)) hne) hpq

omit [Fintype row] [Fintype ι] in
theorem orbitNe_zero_of_mem_symGood {W : ℂ → ℂ} {A : Finset ℂ}
    {packet : InjectiveProjectiveRowPacket row} {shift : ι → ℂ}
    (h : shift ∈ symGoodCombinedRowPacketAmbientSet W A packet)
    (q : (row × ι) × Fin 4) :
    gaugeProbeOrbitNode (fun x : row × ι => packet.1 x.1 + shift x.2) q ≠ 0 :=
  Set.mem_iInter.mp h.2.1 q

omit [Fintype row] [Fintype ι] in
theorem sourceNe_zero_of_mem_symGood {W : ℂ → ℂ} {A : Finset ℂ}
    {packet : InjectiveProjectiveRowPacket row} {shift : ι → ℂ}
    (h : shift ∈ symGoodCombinedRowPacketAmbientSet W A packet) (x : row × ι) :
    W (packet.1 x.1 + shift x.2) ≠ 0 :=
  Set.mem_iInter.mp h.2.2.1 x

omit [Fintype row] [Fintype ι] in
theorem notMem_passport_of_mem_symGood {W : ℂ → ℂ} {A : Finset ℂ}
    {packet : InjectiveProjectiveRowPacket row} {shift : ι → ℂ}
    (h : shift ∈ symGoodCombinedRowPacketAmbientSet W A packet) (x : row × ι) :
    packet.1 x.1 + shift x.2 ∉ A := by
  intro hmem
  have hx := Set.mem_iInter.mp h.2.2.2 x
  have hy := Set.mem_iInter.mp hx (packet.1 x.1 + shift x.2)
  exact (Set.mem_iInter.mp hy hmem) rfl

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open Set Topology

noncomputable section

variable {row ι : Type*} [Fintype row] [Fintype ι]

theorem injective_diagShift (a : ℂ) : Function.Injective
    (fun t : ℝ => (t : ℂ) * (1 + Complex.I) + a) := by
  intro s u hsu
  have h : ((s : ℝ) : ℂ) * (1 + Complex.I) = ((u : ℝ) : ℂ) * (1 + Complex.I) := by
    linear_combination hsu
  have hne : (1 + Complex.I : ℂ) ≠ 0 := by simp [Complex.ext_iff]
  exact_mod_cast mul_right_cancel₀ hne h

/-- **Every collision-free shift tuple has a symmetry-free admissible row packet.** -/
theorem injectiveShiftConfigurations_covered_by_symGoodCombinedRowPackets
    {W : ℂ → ℂ} (hWa : AnalyticOnNhd ℂ W Set.univ) (h0 : ∃ w, W w ≠ 0) (A : Finset ℂ) :
    Set.univ ⊆ ⋃ packet : InjectiveProjectiveRowPacket row,
      symGoodCombinedRowPacketSet (ι := ι) W A packet := by
  classical
  intro shift _
  obtain ⟨offset, hoffset, hcombined⟩ :=
    exists_rowOffsets_combined_injective (row := row) (ι := ι) shift.1 shift.2
  set a : row × ι → ℂ := fun x => offset x.1 + shift.1 x.2 with hadef
  have hazero : {w : ℂ | W w = 0}.Countable :=
    _root_.HTGeometry.countable_setOf_eq_zero_of_analyticOnNhd hWa h0
  set bad : Set ℝ :=
    (⋃ p : ((row × ι) × Fin 4) × ((row × ι) × Fin 4), ⋃ _ : p.1 ≠ p.2,
        {t : ℝ | orbitCoef p.1.2 * (t : ℂ) + orbitBase a p.1
          = orbitCoef p.2.2 * (t : ℂ) + orbitBase a p.2}) ∪
      ((⋃ q : (row × ι) × Fin 4, {t : ℝ | orbitCoef q.2 * (t : ℂ) + orbitBase a q = 0}) ∪
        ((⋃ x : row × ι, {t : ℝ | W ((t : ℂ) * (1 + Complex.I) + a x) = 0}) ∪
          (⋃ x : row × ι, ⋃ a' ∈ A,
            {t : ℝ | (t : ℂ) * (1 + Complex.I) + a x = a'}))) with hbaddef
  have hcount : bad.Countable := by
    refine Set.Countable.union (Set.countable_iUnion fun p => ?_)
      (Set.Countable.union (Set.countable_iUnion fun q => ?_)
        (Set.Countable.union (Set.countable_iUnion fun x => ?_)
          (Set.countable_iUnion fun x => ?_)))
    · refine Set.countable_iUnion fun hne => ?_
      · by_cases hsnd : p.1.2 = p.2.2
        · refine Set.Subsingleton.countable ?_
          intro s hs u _
          exfalso
          have hbase : orbitBase a p.1 = orbitBase a p.2 := by
            have : orbitCoef p.1.2 * (s : ℂ) + orbitBase a p.1
                = orbitCoef p.2.2 * (s : ℂ) + orbitBase a p.2 := hs
            rw [hsnd] at this
            linear_combination this
          have hfst : p.1.1 ≠ p.2.1 := by
            intro hcon
            exact hne (Prod.ext hcon hsnd)
          exact orbitBase_injective_of_same hcombined hsnd hfst hbase
        · refine Set.Subsingleton.countable ?_
          have hcoefne : orbitCoef p.1.2 - orbitCoef p.2.2 ≠ 0 := by
            intro hcon
            exact hsnd (orbitCoef_injective (by linear_combination hcon))
          have hsub : {t : ℝ | orbitCoef p.1.2 * (t : ℂ) + orbitBase a p.1
              = orbitCoef p.2.2 * (t : ℂ) + orbitBase a p.2}
              ⊆ {t : ℝ | (orbitCoef p.1.2 - orbitCoef p.2.2) * (t : ℂ)
                = orbitBase a p.2 - orbitBase a p.1} := by
            intro t ht
            have : orbitCoef p.1.2 * (t : ℂ) + orbitBase a p.1
                = orbitCoef p.2.2 * (t : ℂ) + orbitBase a p.2 := ht
            show _ = _
            linear_combination this
          exact Set.Subsingleton.anti (subsingleton_setOf_affine hcoefne _) hsub
    · refine Set.Subsingleton.countable ?_
      have hsub : {t : ℝ | orbitCoef q.2 * (t : ℂ) + orbitBase a q = 0}
          ⊆ {t : ℝ | orbitCoef q.2 * (t : ℂ) = -orbitBase a q} := by
        intro t ht
        have : orbitCoef q.2 * (t : ℂ) + orbitBase a q = 0 := ht
        show _ = _
        linear_combination this
      exact Set.Subsingleton.anti (subsingleton_setOf_affine (orbitCoef_ne_zero q.2) _) hsub
    · exact hazero.preimage (injective_diagShift (a x))
    · refine Set.Countable.biUnion (A.finite_toSet.countable) fun a' _ => ?_
      refine Set.Subsingleton.countable ?_
      have hsub : {t : ℝ | (t : ℂ) * (1 + Complex.I) + a x = a'}
          ⊆ {t : ℝ | (1 + Complex.I) * (t : ℂ) = a' - a x} := by
        intro t ht
        have : (t : ℂ) * (1 + Complex.I) + a x = a' := ht
        show _ = _
        linear_combination this
      have hne : (1 + Complex.I : ℂ) ≠ 0 := by simp [Complex.ext_iff]
      exact Set.Subsingleton.anti (subsingleton_setOf_affine hne _) hsub
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t ∉ bad := by
    by_contra hcon
    have huniv : bad = Set.univ :=
      Set.eq_univ_of_forall fun t => not_not.mp fun hz => hcon ⟨t, hz⟩
    exact Cardinal.not_countable_real (huniv ▸ hcount)
  set z : ℂ := (t : ℂ) * (1 + Complex.I) with hzdef
  have hrowinj : Function.Injective (fun r : row => z + offset r) := by
    intro r s hrs
    exact hoffset (add_left_cancel hrs)
  refine Set.mem_iUnion.mpr ⟨⟨fun r => z + offset r, hrowinj⟩, ?_⟩
  have hnodes : (fun x : row × ι => (fun r : row => z + offset r) x.1 + shift.1 x.2)
      = fun x : row × ι => z + a x := by
    funext x
    show z + offset x.1 + shift.1 x.2 = z + (offset x.1 + shift.1 x.2)
    ring
  have horb : ∀ q : (row × ι) × Fin 4,
      gaugeProbeOrbitNode (fun x : row × ι => (fun r : row => z + offset r) x.1 + shift.1 x.2) q
        = orbitCoef q.2 * (t : ℂ) + orbitBase a q := by
    intro q
    rw [hnodes, hzdef]
    exact gaugeProbeOrbitNode_diag a t q
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine Set.mem_iInter.mpr fun p => Set.mem_iInter.mpr fun hp hcon => ?_
    refine ht (Or.inl (Set.mem_iUnion.mpr ⟨p, Set.mem_iUnion.mpr ⟨hp, ?_⟩⟩))
    rw [horb p.1, horb p.2] at hcon
    exact hcon
  · refine Set.mem_iInter.mpr fun q hcon => ?_
    refine ht (Or.inr (Or.inl (Set.mem_iUnion.mpr ⟨q, ?_⟩)))
    rw [horb q] at hcon
    exact hcon
  · refine Set.mem_iInter.mpr fun x hcon => ?_
    refine ht (Or.inr (Or.inr (Or.inl (Set.mem_iUnion.mpr ⟨x, ?_⟩))))
    show W ((t : ℂ) * (1 + Complex.I) + a x) = 0
    rw [← hzdef]
    have := congrFun hnodes x
    rw [← this]
    exact hcon
  · refine Set.mem_iInter.mpr fun x => Set.mem_iInter.mpr fun a' =>
      Set.mem_iInter.mpr fun ha' hcon => ?_
    refine ht (Or.inr (Or.inr (Or.inr (Set.mem_iUnion.mpr ⟨x,
      Set.mem_iUnion.mpr ⟨a', Set.mem_iUnion.mpr ⟨ha', ?_⟩⟩⟩))))
    show (t : ℂ) * (1 + Complex.I) + a x = a'
    rw [← hzdef, ← congrFun hnodes x]
    exact hcon

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open Set Topology

noncomputable section

variable {row ι : Type*} [Fintype row] [Fintype ι]

/-- Every compact collision-free shift patch has a finite compact refinement subordinate to
symmetry-free admissible row charts. -/
theorem compact_injectiveShiftPatch_finite_symGoodCombinedRowPacket_refinement
    {W : ℂ → ℂ} (hWa : AnalyticOnNhd ℂ W Set.univ) (hWc : Continuous W) (h0 : ∃ w, W w ≠ 0)
    (A : Finset ℂ) {K : Set (InjectiveShiftConfiguration ι)} (hK : IsCompact K) :
    ∃ n : ℕ, ∃ packets : Fin n → InjectiveProjectiveRowPacket row,
      ∃ pieces : Fin n → Set (InjectiveShiftConfiguration ι),
        K ⊆ ⋃ j, pieces j ∧ (∀ j, IsCompact (pieces j)) ∧
          ∀ j, pieces j ⊆ symGoodCombinedRowPacketSet (ι := ι) W A (packets j) := by
  classical
  obtain ⟨packetFinset, hpacketFinset⟩ := hK.elim_finite_subcover
    (fun packet : InjectiveProjectiveRowPacket row =>
      symGoodCombinedRowPacketSet (ι := ι) W A packet)
    (fun packet => symGoodCombinedRowPacketSet_isOpen (ι := ι) hWc A packet)
    (Set.Subset.trans (Set.subset_univ K)
      (injectiveShiftConfigurations_covered_by_symGoodCombinedRowPackets
        (row := row) (ι := ι) hWa h0 A))
  let n := packetFinset.card
  let e : Fin n ≃ {packet // packet ∈ packetFinset} := by
    simpa [n] using (Fintype.equivFin {packet // packet ∈ packetFinset}).symm
  let packets : Fin n → InjectiveProjectiveRowPacket row := fun j => (e j).1
  let cover : Fin n → Set (InjectiveShiftConfiguration ι) := fun j =>
    symGoodCombinedRowPacketSet (ι := ι) W A (packets j)
  have hcover : K ⊆ ⋃ j, cover j := by
    intro shift hshift
    have hs := hpacketFinset hshift
    simp only [Set.mem_iUnion] at hs
    obtain ⟨packet, hpacketMem, hgood⟩ := hs
    refine Set.mem_iUnion.mpr ⟨e.symm ⟨packet, hpacketMem⟩, ?_⟩
    change shift ∈ symGoodCombinedRowPacketSet (ι := ι) W A
      (packets (e.symm ⟨packet, hpacketMem⟩))
    simpa [packets] using hgood
  obtain ⟨v, hKv, hvclosed, hvsub⟩ :=
    exists_subset_iUnion_closed_subset hK.isClosed
      (fun j => symGoodCombinedRowPacketSet_isOpen (ι := ι) hWc A (packets j))
      (fun _ _ => Set.toFinite _) hcover
  refine ⟨n, packets, fun j => K ∩ v j, ?_, ?_, ?_⟩
  · intro shift hshift
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (hKv hshift)
    exact Set.mem_iUnion.mpr ⟨j, hshift, hj⟩
  · intro j
    exact hK.inter_right (hvclosed j)
  · intro j
    exact inter_subset_right.trans (hvsub j)

end

end GaloisForLFunctions.HTGeometry
