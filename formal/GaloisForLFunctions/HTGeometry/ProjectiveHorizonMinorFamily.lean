import GaloisForLFunctions.HTGeometry.ProjectiveHorizonActionFaithful

/-!
# Minor observables and chart generation

The jet determinant of any superset of a covector span is an observable of that span: enlarging the
span only enlarges the observer group of the determinant, and the observer group of the smaller span
is contained in it.  Taking one extra direction gives the rank-`(r+1)` minors, the second family of
horizon observables after the rank-`r` ones.

Dually, one affine chart already generates everything: the homogeneous jet field is generated by the
tower of the chart denominator together with the chart jets, because the chart data is closed under
the jet shift and reproduces every homogeneous jet.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

noncomputable section

variable {n : Type*} [Fintype n] [DecidableEq n] {K : Type*} [Field K]

/-! ## Minor observables -/

/-- The jet determinant of any superset of `t` is invariant under the observer group of `t`. -/
theorem jetDet_invariant_of_subset {t u : Finset n} (htu : t ⊆ u)
    {g : SpecialLinearGroup n K} (hg : g ∈ chartSubsetStabilizer (K := K) (↑t : Set n)) :
    g • jetDet (K := K) u = jetDet u :=
  jetDet_invariant (chartSubsetStabilizer_mono (Finset.coe_subset.2 htu) hg)

/-- The rank-`r` jet determinant is a horizon observable of its own span. -/
theorem jetDet_mem_horizonField (t : Finset n) :
    jetDet (K := K) t ∈ horizonField (K := K) (↑t : Set n) := by
  rw [mem_horizonField_iff']
  intro g hg
  exact jetDet_invariant hg

/-- **Augmented minor observables.**  Adjoining one direction outside `t` to the jet array gives a
rank-`(r+1)` determinant which is still a horizon observable of `t`. -/
theorem jetDet_insert_mem_horizonField {t : Finset n} (k : n) :
    jetDet (K := K) (insert k t) ∈ horizonField (K := K) (↑t : Set n) := by
  rw [mem_horizonField_iff']
  intro g hg
  exact jetDet_invariant_of_subset (Finset.subset_insert k t) hg

omit [Fintype n] in
/-- Every minor observable is nonzero. -/
theorem jetDet_insert_ne_zero {t : Finset n} (k : n) :
    jetDet (K := K) (insert k t) ≠ 0 :=
  jetDet_ne_zero _

/-! ## One chart generates the jet field -/

/-- Generators of the homogeneous jet field adapted to the chart at `i`: the tower of the chart
denominator together with all chart jets. -/
def chartAdaptedGenerators (i : n) (K : Type*) [Field K] : Set (HomogeneousJetField n K) :=
  (Set.range fun l : ℕ => freeCoordinate K (n × ℕ) (i, l)) ∪ affineJetGenerators i K

omit [Fintype n] [DecidableEq n] in
theorem homogeneousJetShift_mem_chartAdaptedAdjoin (i : n)
    {f : HomogeneousJetField n K}
    (hf : f ∈ IntermediateField.adjoin K (chartAdaptedGenerators i K)) :
    homogeneousJetShift n K f ∈ IntermediateField.adjoin K (chartAdaptedGenerators i K) := by
  refine derivation_mem_adjoin (homogeneousJetShift n K) (chartAdaptedGenerators i K) ?_ f hf
  rintro _ (⟨l, rfl⟩ | ⟨k, l, rfl⟩)
  · rw [homogeneousJetShift_freeCoordinate]
    exact IntermediateField.subset_adjoin K _ (Or.inl ⟨l + 1, rfl⟩)
  · exact IntermediateField.subset_adjoin K _ (Or.inr ⟨k, l + 1, rfl⟩)

omit [Fintype n] [DecidableEq n] in
theorem freeCoordinate_mem_chartAdaptedAdjoin (i : n) (k : n) (l : ℕ) :
    freeCoordinate K (n × ℕ) (k, l) ∈
      IntermediateField.adjoin K (chartAdaptedGenerators i K) := by
  induction l with
  | zero =>
      have hden : freeCoordinate K (n × ℕ) (i, 0) ≠ (0 : HomogeneousJetField n K) :=
        freeCoordinate_ne_zero i 0
      have hsplit : freeCoordinate K (n × ℕ) (k, 0) =
          affineCoord (K := K) i k * freeCoordinate K (n × ℕ) (i, 0) := by
        rw [affineCoord, div_mul_cancel₀ _ hden]
      rw [hsplit]
      exact mul_mem
        (IntermediateField.subset_adjoin K _ (Or.inr ⟨k, 0, rfl⟩))
        (IntermediateField.subset_adjoin K _ (Or.inl ⟨0, rfl⟩))
  | succ l ih =>
      have hshift : freeCoordinate K (n × ℕ) (k, l + 1) =
          homogeneousJetShift n K (freeCoordinate K (n × ℕ) (k, l)) :=
        (homogeneousJetShift_freeCoordinate k l).symm
      rw [hshift]
      exact homogeneousJetShift_mem_chartAdaptedAdjoin i ih

omit [Fintype n] [DecidableEq n] in
/-- **Chart generation.**  One affine chart, together with the tower of its denominator, generates
the whole homogeneous jet field. -/
theorem chartAdaptedGenerators_adjoin_eq_top (i : n) :
    IntermediateField.adjoin K (chartAdaptedGenerators i K) = ⊤ := by
  refine le_antisymm le_top ?_
  intro f _
  have hpoly : ∀ p : MvPolynomial (n × ℕ) K,
      algebraMap (MvPolynomial (n × ℕ) K) (HomogeneousJetField n K) p ∈
        IntermediateField.adjoin K (chartAdaptedGenerators i K) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C c =>
        rw [← MvPolynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply K (MvPolynomial (n × ℕ) K)
            (HomogeneousJetField n K)]
        exact (IntermediateField.adjoin K _).algebraMap_mem c
    | add p q hp hq =>
        rw [map_add]
        exact add_mem hp hq
    | mul_X p j hp =>
        obtain ⟨k, l⟩ := j
        rw [map_mul]
        exact mul_mem hp (freeCoordinate_mem_chartAdaptedAdjoin i k l)
  obtain ⟨a, b, -, rfl⟩ :=
    IsFractionRing.div_surjective (A := MvPolynomial (n × ℕ) K) f
  exact div_mem (hpoly a) (hpoly b)

end

end GaloisForLFunctions.HTGeometry
