import GaloisForLFunctions.HTGeometry.EntireCascadeStateFieldOrder
import GaloisForLFunctions.HTGeometry.UnivMeroFieldInstances

/-!
# The order bound for elements algebraic over a state field

`differentiallyAlgebraicOfOrder_of_state_generators` bounds the differential order of an entire
function whose meromorphic realization *lies in* the field generated by `n` states.  Being
*algebraic over* that field is enough: the relative algebraic closure has the same transcendence
degree and already absorbs the derivation, so nothing in the proof changes.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

/-- **The jet relation for an algebraic element.**  If the derivative of every element of the field
generated by `s` is algebraic over that field, then every element *algebraic over* it satisfies a
nonzero polynomial relation among its first `n+1` jets. -/
theorem exists_jet_relation_of_algebraic_over_state_generators
    {K L : Type} [Field K] [Field L] [Algebra K L] [Differential L] [CharZero L]
    {n : ℕ} (s : Fin n → L)
    (hs : ∀ y : L, y ∈ IntermediateField.adjoin K (Set.range s) →
      y′ ∈ algebraicClosure ((IntermediateField.adjoin K (Set.range s) : Type)) L)
    {x : L}
    (hx : x ∈ algebraicClosure ((IntermediateField.adjoin K (Set.range s) : Type)) L) :
    ∃ Q : MvPolynomial (Fin (n + 1)) K, Q ≠ 0 ∧
      MvPolynomial.aeval (fun i : Fin (n + 1) => differentialJet (i : ℕ) x) Q = 0 := by
  set E : IntermediateField K L := IntermediateField.adjoin K (Set.range s) with hEdef
  refine exists_jet_relation_of_trdeg_le
    ((algebraicClosure (E : Type) L).restrictScalars K) ?_ ?_
  · calc Algebra.trdeg K ((algebraicClosure (E : Type) L).restrictScalars K)
        ≤ Cardinal.mk (Fin n) := trdeg_algebraicClosure_adjoin_range_le s
      _ = (n : Cardinal) := by simp
  · intro i
    refine differentialJet_mem_algebraicClosure_restrictScalars E hs ?_ i
    rwa [IntermediateField.mem_restrictScalars]

/-! ## The entire-function form -/

open scoped UnivMeroFieldInstances

/-- **The order bound for an algebraic element.**  An entire function whose meromorphic realization
is algebraic over the field generated over `ℂ(z)` by `n` states, each of whose derivatives is
algebraic over that field, satisfies an algebraic differential equation of order at most `n`. -/
theorem differentiallyAlgebraicOfOrder_of_algebraic_over_states {f : ℂ → ℂ}
    (hf : AnalyticOnNhd ℂ f (Set.univ : Set ℂ)) {n : ℕ}
    (s : Fin n → meroField (Set.univ : Set ℂ))
    (hgen : ∀ y ∈ Set.range s, y′ ∈
      algebraicClosure
        ((IntermediateField.adjoin (RatFunc ℂ) (Set.range s) :
          IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ))) : Type)
        (meroField (Set.univ : Set ℂ)))
    (hx : analyticMeroElement f hf ∈
      algebraicClosure
        ((IntermediateField.adjoin (RatFunc ℂ) (Set.range s) :
          IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ))) : Type)
        (meroField (Set.univ : Set ℂ))) :
    DifferentiallyAlgebraicOfOrder f n := by
  obtain ⟨Q, hQ0, hQ⟩ := exists_jet_relation_of_algebraic_over_state_generators s
    (deriv_mem_algebraicClosure_adjoin_of_gen hgen) hx
  exact differentiallyAlgebraicOfOrder_of_jet_relation hf hQ0 hQ

end

end GaloisForLFunctions.HTGeometry
