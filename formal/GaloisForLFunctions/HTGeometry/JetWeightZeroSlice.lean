import GaloisForLFunctions.HTGeometry.JetWeightScaleSlicing

/-!
# Slicing in a weight-zero coordinate

The ratio `z_k = y_k/y₁^k` generates the same extension of the prefix field as `y_k` itself, is
transcendental over it, and is fixed by the weighted torus.  Slicing a torus-invariant element as a
coprime fraction in `z_k` therefore has torus-invariant coefficients: the numerator and denominator
are carried to scalar multiples of themselves, and normalizing the denominator makes the scalar one.

This is what makes the weight-zero tower a tower over the rational functions of the free generator:
every slicing step keeps the coefficients torus-invariant, and at jet order one torus invariance
forces jet order zero.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- The first jet coordinate, as an element of a prefix field of level at least two. -/
def jetOnePrefix (C : Type*) [Field C] [CharZero C] {k : ℕ} (hk : 1 < k) :
    ↥(jetPrefixField C k) :=
  ⟨(JetField.jet ((), 1) : JetField C Unit), jet_mem_jetPrefixField hk⟩

theorem jetOnePrefix_ne_zero {k : ℕ} (hk : 1 < k) : jetOnePrefix C hk ≠ 0 := by
  intro hh
  exact jet_ne_zero ((), 1) (congrArg Subtype.val hh)

theorem jetRatio_eq_mul {k : ℕ} (hk : 1 < k) :
    (jetRatio k : JetField C Unit)
      = algebraMap ↥(jetPrefixField C k) (JetField C Unit) ((jetOnePrefix C hk ^ k)⁻¹)
        * (JetField.jet ((), k) : JetField C Unit) := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hcoe : algebraMap ↥(jetPrefixField C k) (JetField C Unit) ((jetOnePrefix C hk ^ k)⁻¹)
      = ((JetField.jet ((), 1) : JetField C Unit) ^ k)⁻¹ := by
    rw [map_inv₀, map_pow]
    rfl
  rw [jetRatio, hcoe]
  field_simp

/-- **The weight-zero coordinate is transcendental over the prefix field.** -/
theorem transcendental_jetRatio_over_jetPrefixField {k : ℕ} (hk : 1 < k) :
    Transcendental (jetPrefixField C k) (jetRatio k : JetField C Unit) := by
  have hyk : Transcendental (jetPrefixField C k) (JetField.jet ((), k) : JetField C Unit) :=
    transcendental_jet_over_jetPrefixField k
  have hinj : Function.Injective
      (Polynomial.aeval (R := ↥(jetPrefixField C k)) (JetField.jet ((), k) : JetField C Unit)) :=
    transcendental_iff_injective.mp hyk
  refine transcendental_iff_injective.mpr ?_
  set c : ↥(jetPrefixField C k) := (jetOnePrefix C hk ^ k)⁻¹ with hcdef
  have hc0 : c ≠ 0 := by
    rw [hcdef]
    exact inv_ne_zero (pow_ne_zero k (jetOnePrefix_ne_zero hk))
  have heval : ∀ P : Polynomial ↥(jetPrefixField C k),
      Polynomial.aeval (jetRatio k : JetField C Unit) P
        = Polynomial.aeval (JetField.jet ((), k) : JetField C Unit)
          (P.comp (Polynomial.C c * Polynomial.X)) := by
    intro P
    rw [Polynomial.aeval_comp, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
      jetRatio_eq_mul hk]
  intro P Q hPQ
  have hcomp : (P - Q).comp (Polynomial.C c * Polynomial.X) = 0 := by
    refine hinj ?_
    rw [map_zero, ← heval]
    rw [map_sub, hPQ, sub_self]
  refine sub_eq_zero.mp ?_
  refine Polynomial.ext (fun n => ?_)
  have hcf := congrArg (fun p : Polynomial ↥(jetPrefixField C k) => p.coeff n) hcomp
  simp only [coeff_comp_C_mul_X, Polynomial.coeff_zero] at hcf
  rw [Polynomial.coeff_zero]
  exact (mul_eq_zero.mp hcf).resolve_left (pow_ne_zero n hc0)

/-- **An element of jet order at most `k` lies in the extension generated by the weight-zero
coordinate.** -/
theorem mem_adjoin_jetRatio_of_order {k : ℕ} (hk : 1 < k) {v : JetField C Unit}
    (hv : ∀ j : ℕ, k < j → JetField.pd ((), j) v = 0) :
    v ∈ IntermediateField.adjoin (jetPrefixField C k)
      ({(jetRatio k : JetField C Unit)} : Set (JetField C Unit)) := by
  have hmem : v ∈ IntermediateField.adjoin (jetPrefixField C k)
      ({(JetField.jet ((), k) : JetField C Unit)} : Set (JetField C Unit)) :=
    mem_adjoin_jet_of_order hv
  have hle : IntermediateField.adjoin (jetPrefixField C k)
      ({(JetField.jet ((), k) : JetField C Unit)} : Set (JetField C Unit))
      ≤ IntermediateField.adjoin (jetPrefixField C k)
        ({(jetRatio k : JetField C Unit)} : Set (JetField C Unit)) := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    have hgen : (jetRatio k : JetField C Unit) ∈ IntermediateField.adjoin (jetPrefixField C k)
        ({(jetRatio k : JetField C Unit)} : Set (JetField C Unit)) :=
      IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
    have hcoe : algebraMap ↥(jetPrefixField C k) (JetField C Unit) (jetOnePrefix C hk ^ k)
        ∈ IntermediateField.adjoin (jetPrefixField C k)
          ({(jetRatio k : JetField C Unit)} : Set (JetField C Unit)) :=
      IntermediateField.algebraMap_mem _ _
    have hprod := mul_mem hcoe hgen
    have hval : algebraMap ↥(jetPrefixField C k) (JetField C Unit) (jetOnePrefix C hk ^ k)
        * (jetRatio k : JetField C Unit) = (JetField.jet ((), k) : JetField C Unit) := by
      have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
      have hcoe' : algebraMap ↥(jetPrefixField C k) (JetField C Unit) (jetOnePrefix C hk ^ k)
          = (JetField.jet ((), 1) : JetField C Unit) ^ k := by
        rw [map_pow]
        rfl
      rw [hcoe', jetRatio]
      field_simp
    rw [hval] at hprod
    exact hprod
  exact hle hmem

/-! ## Torus invariance of the slice coefficients -/

/-- **The coefficients of a weight-zero slice are weight-zero.** -/
theorem map_weightScalePrefix_eq_of_isWeightZero {k : ℕ} (hk : 1 < k) {v : JetField C Unit}
    (hv : IsWeightZero v) {P Q : Polynomial ↥(jetPrefixField C k)} (hQ0 : Q ≠ 0)
    (hQm : Q.Monic) (hcop : IsCoprime P Q)
    (hvdiv : v = Polynomial.aeval (jetRatio k : JetField C Unit) P
      / Polynomial.aeval (jetRatio k : JetField C Unit) Q)
    {lam : C} (h : lam ≠ 0) :
    P.map (weightScalePrefixHom h k).toRingHom = P
      ∧ Q.map (weightScalePrefixHom h k).toRingHom = Q := by
  classical
  set z : JetField C Unit := (jetRatio k : JetField C Unit) with hzdef
  have hztr : Transcendental (jetPrefixField C k) z :=
    transcendental_jetRatio_over_jetPrefixField hk
  have hinj : Function.Injective (Polynomial.aeval (R := ↥(jetPrefixField C k)) z) :=
    transcendental_iff_injective.mp hztr
  have hwz : weightScale h z = z := weightScale_jetRatio h k
  have hw : ∀ Pp : Polynomial ↥(jetPrefixField C k),
      weightScale h (Polynomial.aeval z Pp)
        = Polynomial.aeval z (Pp.map (weightScalePrefixHom h k).toRingHom) := by
    intro Pp
    rw [weightScale_aeval h k z Pp, hwz]
  have hmapinj : Function.Injective
      (Polynomial.map (weightScalePrefixHom h k).toRingHom) :=
    Polynomial.map_injective _ (weightScalePrefixHom h k).toRingHom.injective
  have hQ0w : Q.map (weightScalePrefixHom h k).toRingHom ≠ 0 := by
    intro hh
    exact hQ0 (hmapinj (by rw [hh, Polynomial.map_zero]))
  have hQy : Polynomial.aeval z Q ≠ 0 := fun hh => hQ0 (hinj (by simpa using hh))
  have hQyw : Polynomial.aeval z (Q.map (weightScalePrefixHom h k).toRingHom) ≠ 0 :=
    fun hh => hQ0w (hinj (by simpa using hh))
  have hveq : weightScale h v = v := hv lam h
  rw [hvdiv, map_div₀, hw, hw] at hveq
  have hcross : P.map (weightScalePrefixHom h k).toRingHom * Q
      = Q.map (weightScalePrefixHom h k).toRingHom * P := by
    refine hinj ?_
    rw [map_mul, map_mul]
    field_simp at hveq
    linear_combination hveq
  have hcopw : IsCoprime (P.map (weightScalePrefixHom h k).toRingHom)
      (Q.map (weightScalePrefixHom h k).toRingHom) := by
    obtain ⟨a, b, hab⟩ := hcop
    refine ⟨a.map (weightScalePrefixHom h k).toRingHom,
      b.map (weightScalePrefixHom h k).toRingHom, ?_⟩
    rw [← Polynomial.map_mul, ← Polynomial.map_mul, ← Polynomial.map_add, hab,
      Polynomial.map_one]
  have hdvd : Q.map (weightScalePrefixHom h k).toRingHom ∣ Q :=
    hcopw.symm.dvd_of_dvd_mul_left ⟨P, by linear_combination hcross⟩
  have hdegw : Q.natDegree = (Q.map (weightScalePrefixHom h k).toRingHom).natDegree :=
    (Polynomial.natDegree_map_eq_of_injective
      (weightScalePrefixHom h k).toRingHom.injective Q).symm
  obtain ⟨c, hc0, hc⟩ := eq_C_mul_of_dvd_of_natDegree_eq hQ0 hdvd hdegw
  have hQlead : Q.coeff Q.natDegree = 1 := hQm.leadingCoeff
  have hc1 : c = 1 := by
    have hcf := congrArg (fun p : Polynomial ↥(jetPrefixField C k) => p.coeff Q.natDegree) hc
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, hQlead, map_one, mul_one] at hcf
    exact hcf.symm
  have hQfix : Q.map (weightScalePrefixHom h k).toRingHom = Q := by
    conv_rhs => rw [hc]
    rw [hc1, map_one, one_mul]
  refine ⟨?_, hQfix⟩
  refine mul_right_cancel₀ hQ0 ?_
  rw [hcross, hQfix]
  ring

/-- **Torus invariance passes to the slice coefficients.** -/
theorem isWeightZero_coeff_of_slice {k : ℕ} (hk : 1 < k) {v : JetField C Unit}
    (hv : IsWeightZero v) {P Q : Polynomial ↥(jetPrefixField C k)} (hQ0 : Q ≠ 0)
    (hQm : Q.Monic) (hcop : IsCoprime P Q)
    (hvdiv : v = Polynomial.aeval (jetRatio k : JetField C Unit) P
      / Polynomial.aeval (jetRatio k : JetField C Unit) Q) (i : ℕ) :
    IsWeightZero ((P.coeff i : ↥(jetPrefixField C k)) : JetField C Unit)
      ∧ IsWeightZero ((Q.coeff i : ↥(jetPrefixField C k)) : JetField C Unit) := by
  constructor
  · intro lam h
    obtain ⟨hP, -⟩ := map_weightScalePrefix_eq_of_isWeightZero hk hv hQ0 hQm hcop hvdiv h
    have hcf := congrArg (fun p : Polynomial ↥(jetPrefixField C k) => p.coeff i) hP
    rw [Polynomial.coeff_map] at hcf
    exact congrArg Subtype.val hcf
  · intro lam h
    obtain ⟨-, hQ⟩ := map_weightScalePrefix_eq_of_isWeightZero hk hv hQ0 hQm hcop hvdiv h
    have hcf := congrArg (fun p : Polynomial ↥(jetPrefixField C k) => p.coeff i) hQ
    rw [Polynomial.coeff_map] at hcf
    exact congrArg Subtype.val hcf


end

end GaloisForLFunctions.HTGeometry
