import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetIdeal
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Canonical representatives modulo a coordinate-facet ideal

Modulo the coordinate ideal of a facet `T` -- the ideal generated by the variables outside `T` --
every polynomial has a canonical representative: the part of it supported on monomials whose own
support lies in `T`.  Truncation to that part is a `k`-linear idempotent whose kernel is exactly the
facet ideal, so it computes the quotient without any choice.

Truncation is defined for an arbitrary condition on multidegrees, since coordinate-facet descent
needs the truncation belonging to a whole family of facets at once, and conditions compose by
conjunction just as coordinate-facet ideals compose by intersection.  This is what makes the facet
complex of coordinate descent explicit: its terms are truncated polynomials and its differential is
the alternating sum of truncations.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

variable {α k : Type*} [CommRing k]

/-- The part of a polynomial carried by the multidegrees satisfying a condition. -/
def suppRestrict (k : Type*) [CommRing k] (P : (α →₀ ℕ) → Prop) [DecidablePred P]
    (p : MvPolynomial α k) : MvPolynomial α k :=
  ∑ a ∈ p.support.filter P, monomial a (coeff a p)

variable {P Q : (α →₀ ℕ) → Prop} [DecidablePred P] [DecidablePred Q]

@[simp]
theorem coeff_suppRestrict (p : MvPolynomial α k) (b : α →₀ ℕ) :
    coeff b (suppRestrict k P p) = if P b then coeff b p else 0 := by
  classical
  rw [suppRestrict, coeff_sum]
  rw [Finset.sum_congr rfl (fun a _ => coeff_monomial b a (coeff a p))]
  by_cases hb : P b
  · rw [if_pos hb]
    by_cases hmem : b ∈ p.support
    · rw [Finset.sum_eq_single b]
      · rw [if_pos rfl]
      · intro a _ hab
        exact if_neg hab
      · intro hcon
        exact absurd (Finset.mem_filter.mpr ⟨hmem, hb⟩) hcon
    · rw [Finset.sum_eq_zero, (mem_support_iff.not_left.mp hmem)]
      intro a ha
      refine if_neg (fun hab => ?_)
      exact hmem (hab ▸ (Finset.mem_filter.mp ha).1)
  · rw [if_neg hb]
    refine Finset.sum_eq_zero (fun a ha => if_neg (fun hab => ?_))
    exact hb (hab ▸ (Finset.mem_filter.mp ha).2)

theorem suppRestrict_eq_zero_iff (p : MvPolynomial α k) :
    suppRestrict k P p = 0 ↔ ∀ b : α →₀ ℕ, P b → coeff b p = 0 := by
  constructor
  · intro h b hb
    have := congrArg (coeff b) h
    rwa [coeff_suppRestrict, if_pos hb, coeff_zero] at this
  · intro h
    ext b
    rw [coeff_suppRestrict]
    by_cases hb : P b
    · rw [if_pos hb, h b hb, coeff_zero]
    · rw [if_neg hb, coeff_zero]

theorem suppRestrict_eq_self_iff (p : MvPolynomial α k) :
    suppRestrict k P p = p ↔ ∀ b : α →₀ ℕ, coeff b p ≠ 0 → P b := by
  constructor
  · intro h b hb
    by_contra hcon
    have := congrArg (coeff b) h
    rw [coeff_suppRestrict, if_neg hcon] at this
    exact hb this.symm
  · intro h
    ext b
    rw [coeff_suppRestrict]
    by_cases hb : P b
    · rw [if_pos hb]
    · rw [if_neg hb]
      by_contra hne
      exact hb (h b (fun hc => hne hc.symm))

theorem suppRestrict_add (p q : MvPolynomial α k) :
    suppRestrict k P (p + q) = suppRestrict k P p + suppRestrict k P q := by
  ext b
  rw [coeff_add, coeff_suppRestrict, coeff_suppRestrict, coeff_suppRestrict, coeff_add]
  by_cases hb : P b
  · rw [if_pos hb, if_pos hb, if_pos hb]
  · rw [if_neg hb, if_neg hb, if_neg hb, add_zero]

theorem suppRestrict_smul (c : k) (p : MvPolynomial α k) :
    suppRestrict k P (c • p) = c • suppRestrict k P p := by
  ext b
  rw [coeff_smul, coeff_suppRestrict, coeff_suppRestrict, coeff_smul]
  by_cases hb : P b
  · rw [if_pos hb, if_pos hb]
  · rw [if_neg hb, if_neg hb, smul_zero]

@[simp]
theorem suppRestrict_zero : suppRestrict k P (0 : MvPolynomial α k) = 0 := by
  ext b
  rw [coeff_suppRestrict]
  by_cases hb : P b
  · rw [if_pos hb, coeff_zero]
  · rw [if_neg hb, coeff_zero]

theorem suppRestrict_sum {ι : Type*} (s : Finset ι) (f : ι → MvPolynomial α k) :
    suppRestrict k P (∑ i ∈ s, f i) = ∑ i ∈ s, suppRestrict k P (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, suppRestrict_add, ih]

/-- **Truncations compose by conjunction of their conditions.** -/
theorem suppRestrict_suppRestrict (p : MvPolynomial α k) :
    suppRestrict k P (suppRestrict k Q p) = suppRestrict k (fun a => P a ∧ Q a) p := by
  ext b
  rw [coeff_suppRestrict, coeff_suppRestrict, coeff_suppRestrict]
  by_cases hP : P b
  · by_cases hQ : Q b
    · rw [if_pos hP, if_pos hQ, if_pos ⟨hP, hQ⟩]
    · rw [if_pos hP, if_neg hQ, if_neg (fun hc => hQ hc.2)]
  · rw [if_neg hP, if_neg (fun hc => hP hc.1)]

/-- Truncation as a `k`-linear map. -/
def suppRestrictₗ (k : Type*) [CommRing k] (P : (α →₀ ℕ) → Prop) [DecidablePred P] :
    MvPolynomial α k →ₗ[k] MvPolynomial α k where
  toFun := suppRestrict k P
  map_add' := suppRestrict_add
  map_smul' c p := suppRestrict_smul c p

@[simp]
theorem suppRestrictₗ_apply (p : MvPolynomial α k) :
    suppRestrictₗ k P p = suppRestrict k P p := rfl

/-! ### The truncation of a single coordinate facet -/

variable [DecidableEq α]

/-- The canonical representative modulo the coordinate ideal of a facet: the part of a polynomial
supported on monomials whose variables all lie in the facet. -/
def facetRestrict (k : Type*) [CommRing k] (T : Finset α) (p : MvPolynomial α k) :
    MvPolynomial α k :=
  suppRestrict k (fun a => a.support ⊆ T) p

theorem coeff_facetRestrict (T : Finset α) (p : MvPolynomial α k) (b : α →₀ ℕ) :
    coeff b (facetRestrict k T p) = if b.support ⊆ T then coeff b p else 0 :=
  coeff_suppRestrict p b

theorem facetRestrict_eq_zero_iff (T : Finset α) (p : MvPolynomial α k) :
    facetRestrict k T p = 0 ↔ ∀ b : α →₀ ℕ, b.support ⊆ T → coeff b p = 0 :=
  suppRestrict_eq_zero_iff p

omit [DecidableEq α] in
/-- **Membership in a coordinate-facet ideal is a coefficient condition.** -/
theorem mem_facetIdeal_iff_coeff (T : Finset α) (p : MvPolynomial α k) :
    p ∈ facetIdeal k T ↔ ∀ b : α →₀ ℕ, b.support ⊆ T → coeff b p = 0 := by
  rw [mem_facetIdeal_iff]
  constructor
  · intro h b hb
    by_contra hne
    exact h b (mem_support_iff.mpr hne) hb
  · intro h d hd hsub
    exact mem_support_iff.mp hd (h d hsub)

/-- **Truncation computes the quotient by the facet ideal.** -/
theorem facetRestrict_eq_zero_iff_mem (T : Finset α) (p : MvPolynomial α k) :
    facetRestrict k T p = 0 ↔ p ∈ facetIdeal k T := by
  rw [facetRestrict_eq_zero_iff, mem_facetIdeal_iff_coeff]

/-- The truncation of a polynomial differs from it by an element of the facet ideal. -/
theorem sub_facetRestrict_mem_facetIdeal (T : Finset α) (p : MvPolynomial α k) :
    p - facetRestrict k T p ∈ facetIdeal k T := by
  rw [mem_facetIdeal_iff_coeff]
  intro b hb
  rw [coeff_sub, coeff_facetRestrict, if_pos hb, sub_self]

/-- **Facet truncations compose by intersecting facets.**  This is the coefficient-level mirror of
the sum law `J F + J G = J (F ∩ G)` for coordinate-facet ideals. -/
theorem facetRestrict_facetRestrict (T S : Finset α) (p : MvPolynomial α k) :
    facetRestrict k T (facetRestrict k S p) = facetRestrict k (T ∩ S) p := by
  ext b
  rw [coeff_facetRestrict, coeff_facetRestrict, coeff_facetRestrict]
  by_cases hT : b.support ⊆ T
  · by_cases hS : b.support ⊆ S
    · rw [if_pos hT, if_pos hS, if_pos (Finset.subset_inter hT hS)]
    · rw [if_pos hT, if_neg hS, if_neg (fun hc => hS (hc.trans Finset.inter_subset_right))]
  · rw [if_neg hT, if_neg (fun hc => hT (hc.trans Finset.inter_subset_left))]

theorem facetRestrict_idem (T : Finset α) (p : MvPolynomial α k) :
    facetRestrict k T (facetRestrict k T p) = facetRestrict k T p := by
  rw [facetRestrict_facetRestrict, Finset.inter_self]

/-- A polynomial is its own truncation exactly when every monomial it carries is supported in the
facet. -/
theorem facetRestrict_eq_self_iff (T : Finset α) (p : MvPolynomial α k) :
    facetRestrict k T p = p ↔ ∀ b : α →₀ ℕ, coeff b p ≠ 0 → b.support ⊆ T :=
  suppRestrict_eq_self_iff p

end

end GaloisForLFunctions.HTGeometry
