import GaloisForLFunctions.HTGeometry.PrimeWalshDifferentialRank
import GaloisForLFunctions.HTGeometry.PrimeDirichletDifferentialField
import GaloisForLFunctions.HTGeometry.PrimeOrientationTailCluster
import GaloisForLFunctions.HTGeometry.PrimeOrientationConstraintOpacity
import GaloisForLFunctions.HTGeometry.PrimeWalshClosedConstraint

/-!
# The linear corona shadow of a prime-orientation constraint

A finite prime-orientation family is generated, as a differential field over the finite-prime
base, by any subfamily whose sign functions are a basis of the coordinate functions on the compact
tail-cluster constraint.  Together with the corona-span law this computes the differential
transcendence rank of every finite shift rectangle.
-/

universe u

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions ArithmeticFunction
open scoped BigOperators Differential

noncomputable section

set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000

local instance complexFinitePrimeRationalAmbientScalarTowerCorona :
    IsScalarTower ℂ finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  .of_algebraMap_eq fun c => by
    change algebraMap ℂ arithmeticFunctionRationalCoordinateField c =
      finitePrimeRationalCoefficientFieldToFormalRatFunc
        (algebraMap ℂ finitePrimeRationalCoefficientField c)
    rw [IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      finitePrimeRationalCoefficientField]
    rw [finitePrimeRationalCoefficientFieldToFormalRatFunc_algebraMap]
    rw [← IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      arithmeticFunctionFractionField]
    rw [IsScalarTower.algebraMap_apply ℂ arithmeticFunctionFractionField
      arithmeticFunctionRationalCoordinateField]

/-- The `±1` coefficient column of a Boolean prime orientation. -/
def orientationSignColumn {P : Type*} (ε : P → Bool) : P → ℂ :=
  fun p => primeDirichletSign (ε p)

theorem norm_primeDirichletSign (b : Bool) : ‖primeDirichletSign b‖ = 1 := by
  cases b <;> simp [primeDirichletSign]

theorem orientationSignColumn_norm_le_one {P : Type*} (ε : P → Bool) :
    ∀ p, ‖orientationSignColumn ε p‖ ≤ 1 := by
  intro p
  rw [orientationSignColumn, norm_primeDirichletSign]

theorem signedPrimeShiftCarrier_eq_bounded (ε : Nat.Primes → Bool) (a : ℂ) :
    signedPrimeShiftCarrier ε a =
      boundedPrimeShiftCarrier (orientationSignColumn ε)
        (orientationSignColumn_norm_le_one ε) a := rfl

theorem differentialJet_signedPrimeShiftCarrier_eq_bounded
    (ε : Nat.Primes → Bool) (a : ℂ) (k : ℕ) :
    differentialJet k (signedPrimeShiftCarrier ε a) =
      differentialJet k (boundedPrimeShiftCarrier (orientationSignColumn ε)
        (orientationSignColumn_norm_le_one ε) a) := by
  rw [signedPrimeShiftCarrier_eq_bounded]

theorem complexConstant_mem_differentialAdjoin'
    (S : Set arithmeticFunctionRationalCoordinateField) (z : ℂ) :
    algebraMap ℂ arithmeticFunctionRationalCoordinateField z ∈
      differentialAdjoin finitePrimeRationalCoefficientField S := by
  rw [IsScalarTower.algebraMap_apply ℂ finitePrimeRationalCoefficientField
    arithmeticFunctionRationalCoordinateField]
  exact IntermediateField.algebraMap_mem _
    (algebraMap ℂ finitePrimeRationalCoefficientField z)

theorem differentialJet_boundedPrimeShiftCarrier_linearCombination
    {κ : Type*} [Fintype κ] (c : κ → Nat.Primes → ℂ) (hc : ∀ j p, ‖c j p‖ ≤ 1)
    (u : κ → ℂ) (d : Nat.Primes → ℂ) (hd : ∀ p, ‖d p‖ ≤ 1)
    (hcoeff : ∀ p, d p = ∑ j, u j * c j p) (a : ℂ) (k : ℕ) :
    differentialJet k (boundedPrimeShiftCarrier d hd a) =
      ∑ j, algebraMap ℂ arithmeticFunctionRationalCoordinateField (u j) *
        differentialJet k (boundedPrimeShiftCarrier (c j) (hc j) a) := by
  simp only [differentialJet_boundedPrimeShiftCarrier]
  exact boundedPrimeShiftedRotatedJet_linearCombination c hc u d hd hcoeff a k

/-- **Corona reduction.**  If the sign column of one orientation agrees, off a finite set of
primes, with a fixed complex linear combination of the sign columns of a finite subfamily, then
every jet of its shifted carrier lies in the differential field generated by the subfamily at the
same shift. -/
theorem differentialJet_signedPrimeShiftCarrier_mem_adjoin_of_tailCombination
    {κ : Type*} [Fintype κ] (ε : κ → Nat.Primes → Bool) (δ : Nat.Primes → Bool)
    (u : κ → ℂ) (α : ℂ)
    (hfin : {p | orientationSignColumn δ p ≠
        ∑ k, u k * orientationSignColumn (ε k) p}.Finite)
    (S : Set arithmeticFunctionRationalCoordinateField)
    (hS : ∀ k, signedPrimeShiftCarrier (ε k) α ∈ S) (m : ℕ) :
    differentialJet m (signedPrimeShiftCarrier δ α) ∈
      differentialAdjoin finitePrimeRationalCoefficientField S := by
  classical
  set M : ℝ := 1 + ∑ k, ‖u k‖ with hM
  have hsum_nonneg : (0 : ℝ) ≤ ∑ k, ‖u k‖ :=
    Finset.sum_nonneg fun k _ => norm_nonneg _
  have hMpos : 0 < M := by rw [hM]; linarith
  have hMne : (M : ℂ) ≠ 0 := by
    exact_mod_cast hMpos.ne'
  set d : Nat.Primes → ℂ := fun p => ∑ k, (u k / (M : ℂ)) * orientationSignColumn (ε k) p with hdd
  set e : Nat.Primes → ℂ := fun p => ((1 : ℂ) / (M : ℂ)) * orientationSignColumn δ p with hee
  have hnormM : ‖(M : ℂ)‖ = M := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hMpos]
  have hd : ∀ p, ‖d p‖ ≤ 1 := by
    intro p
    calc ‖d p‖ ≤ ∑ k, ‖(u k / (M : ℂ)) * orientationSignColumn (ε k) p‖ :=
          norm_sum_le _ _
      _ ≤ ∑ k, ‖u k‖ / M := by
          refine Finset.sum_le_sum fun k _ => ?_
          rw [norm_mul, norm_div, hnormM]
          calc ‖u k‖ / M * ‖orientationSignColumn (ε k) p‖
              ≤ ‖u k‖ / M * 1 :=
                mul_le_mul_of_nonneg_left (orientationSignColumn_norm_le_one _ p)
                  (div_nonneg (norm_nonneg _) hMpos.le)
            _ = ‖u k‖ / M := mul_one _
      _ = (∑ k, ‖u k‖) / M := by rw [Finset.sum_div]
      _ ≤ 1 := by
          rw [div_le_one hMpos, hM]
          linarith
  have he : ∀ p, ‖e p‖ ≤ 1 := by
    intro p
    rw [hee]
    simp only
    rw [norm_mul, norm_div, hnormM, norm_one]
    calc 1 / M * ‖orientationSignColumn δ p‖ ≤ 1 / M * 1 :=
          mul_le_mul_of_nonneg_left (orientationSignColumn_norm_le_one _ p)
            (by positivity)
      _ = 1 / M := mul_one _
      _ ≤ 1 := by
          rw [div_le_one hMpos, hM]
          linarith
  have hsupport : {p | e p - d p ≠ 0}.Finite := by
    refine hfin.subset fun p hp => ?_
    simp only [Set.mem_setOf_eq] at hp ⊢
    intro hzero
    apply hp
    rw [hee, hdd]
    simp only
    rw [hzero, Finset.mul_sum, sub_eq_zero]
    apply Finset.sum_congr rfl
    intro k _
    ring
  obtain ⟨b, hbase⟩ :=
    boundedPrimeShiftCarrier_sub_jet_mem_base_of_finiteSupport e d he hd hsupport α m
  have hdcomb : differentialJet m (boundedPrimeShiftCarrier d hd α) =
      ∑ k, algebraMap ℂ arithmeticFunctionRationalCoordinateField (u k / (M : ℂ)) *
        differentialJet m (boundedPrimeShiftCarrier (orientationSignColumn (ε k))
          (orientationSignColumn_norm_le_one (ε k)) α) :=
    differentialJet_boundedPrimeShiftCarrier_linearCombination
      (fun k => orientationSignColumn (ε k))
      (fun k => orientationSignColumn_norm_le_one (ε k))
      (fun k => u k / (M : ℂ)) d hd (fun p => rfl) α m
  have hecomb : differentialJet m (boundedPrimeShiftCarrier e he α) =
      algebraMap ℂ arithmeticFunctionRationalCoordinateField ((1 : ℂ) / (M : ℂ)) *
        differentialJet m (boundedPrimeShiftCarrier (orientationSignColumn δ)
          (orientationSignColumn_norm_le_one δ) α) := by
    have := differentialJet_boundedPrimeShiftCarrier_linearCombination
      (fun _ : Fin 1 => orientationSignColumn δ)
      (fun _ => orientationSignColumn_norm_le_one δ)
      (fun _ : Fin 1 => (1 : ℂ) / (M : ℂ)) e he (fun p => by simp [hee]) α m
    simpa using this
  have hjet : differentialJet m (signedPrimeShiftCarrier δ α) =
      algebraMap ℂ arithmeticFunctionRationalCoordinateField (M : ℂ) *
        (algebraMap finitePrimeRationalCoefficientField
            arithmeticFunctionRationalCoordinateField b +
          ∑ k, algebraMap ℂ arithmeticFunctionRationalCoordinateField (u k / (M : ℂ)) *
            differentialJet m (signedPrimeShiftCarrier (ε k) α)) := by
    have hsplit : differentialJet m (boundedPrimeShiftCarrier e he α) =
        algebraMap finitePrimeRationalCoefficientField
            arithmeticFunctionRationalCoordinateField b +
          differentialJet m (boundedPrimeShiftCarrier d hd α) := by
      rw [← hbase]; ring
    rw [differentialJet_signedPrimeShiftCarrier_eq_bounded]
    simp only [differentialJet_signedPrimeShiftCarrier_eq_bounded]
    rw [← hdcomb, ← hsplit, hecomb, ← mul_assoc, ← map_mul]
    rw [mul_one_div, div_self hMne, map_one, one_mul]
  rw [hjet]
  apply IntermediateField.mul_mem
  · exact complexConstant_mem_differentialAdjoin' S _
  · apply IntermediateField.add_mem
    · exact IntermediateField.algebraMap_mem _ b
    · apply IntermediateField.sum_mem
      intro k _
      apply IntermediateField.mul_mem
      · exact complexConstant_mem_differentialAdjoin' S _
      · exact differentialJet_mem_differentialAdjoin _ (hS k) m

/-! ## The corona differential basis -/

/-- The complete signed shift rectangle of an orientation family. -/
def signedOrientationShiftPalette {I A : Type*}
    (ε : I → Nat.Primes → Bool) (alpha : A → ℂ) :
    I × A → arithmeticFunctionRationalCoordinateField :=
  fun ja => signedPrimeShiftCarrier (ε ja.1) (alpha ja.2)

/-- **Corona generation law.**  If every orientation of a finite family agrees, off a finite set of
primes, with a complex linear combination of a distinguished subfamily, then the subfamily
generates the whole shift rectangle as a differential field over the finite-prime base. -/
theorem signedOrientationShiftPalette_differentialAdjoin_eq_subfamily
    {I A κ : Type*} [Fintype κ]
    (ε : I → Nat.Primes → Bool) (alpha : A → ℂ) (a : κ → I)
    (hcomb : ∀ j : I, ∃ u : κ → ℂ,
      {p | orientationSignColumn (ε j) p ≠
        ∑ k, u k * orientationSignColumn (ε (a k)) p}.Finite) :
    differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (signedOrientationShiftPalette (fun k => ε (a k)) alpha)) =
      differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (signedOrientationShiftPalette ε alpha)) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨_, ⟨⟨k, b⟩, rfl⟩, m, rfl⟩
    exact differentialJet_mem_differentialAdjoin _ (Set.mem_range_self (a k, b)) m
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨_, ⟨⟨j, b⟩, rfl⟩, m, rfl⟩
    obtain ⟨u, hu⟩ := hcomb j
    exact differentialJet_signedPrimeShiftCarrier_mem_adjoin_of_tailCombination
      (fun k => ε (a k)) (ε j) u (alpha b) hu _
      (fun k => Set.mem_range_self (k, b)) m

/-- **Corona differential basis.**  A tail-independent subfamily which spans every orientation of
the family modulo finite prime support is an explicit labelled differential transcendence basis of
the whole finite shift rectangle. -/
theorem signedOrientationShiftPalette_differentialBasis
    {I A κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    [Fintype A] [DecidableEq A] [Nonempty A]
    (ε : I → Nat.Primes → Bool) (alpha : A → ℂ)
    (hdistinct : Function.Injective fun a : A => (alpha a).re)
    (a : κ → I)
    (hindep : PrimeOrientationTailIndependent (fun k => ε (a k)))
    (hcomb : ∀ j : I, ∃ u : κ → ℂ,
      {p | orientationSignColumn (ε j) p ≠
        ∑ k, u k * orientationSignColumn (ε (a k)) p}.Finite) :
    DifferentialIndependent finitePrimeRationalCoefficientField
        (signedOrientationShiftPalette (fun k => ε (a k)) alpha) ∧
      differentialAdjoin finitePrimeRationalCoefficientField
          (Set.range (signedOrientationShiftPalette (fun k => ε (a k)) alpha)) =
        differentialAdjoin finitePrimeRationalCoefficientField
          (Set.range (signedOrientationShiftPalette ε alpha)) := by
  refine ⟨?_, signedOrientationShiftPalette_differentialAdjoin_eq_subfamily ε alpha a hcomb⟩
  exact (signedPrimeShiftPalette_differentialIndependent_iff
    (fun k => ε (a k)) alpha hdistinct).mpr hindep

/-- The number of labelled basis generators is the number of shifts times the corona rank. -/
theorem signedOrientationShiftPalette_basis_card {A κ : Type*} [Fintype κ] [Fintype A] :
    Nat.card (κ × A) = Nat.card A * Nat.card κ := by
  rw [Nat.card_prod, Nat.mul_comm]

/-! ## The corona rank of a finite orientation family -/

/-- The Boolean patterns a prime-orientation family displays at infinitely many primes. -/
def recurringOrientationPatternSet {I P : Type*} (ε : I → P → Bool) : Set (I → Bool) :=
  {b | {p | primeOrientationPattern ε p = b}.Infinite}

/-- The `±1` sign vector of a Boolean pattern. -/
def orientationSignVector {I : Type*} (b : I → Bool) : I → ℂ :=
  fun j => primeDirichletSign (b j)

theorem orientationSignColumn_eq_signVector {I P : Type*}
    (ε : I → P → Bool) (j : I) (p : P) :
    orientationSignColumn (ε j) p = orientationSignVector (primeOrientationPattern ε p) j := rfl

/-- **Annihilator law, pattern form.**  A cylinder-linear form that vanishes on every recurring
pattern is nonzero at only finitely many primes. -/
theorem support_finite_of_vanishes_on_recurringPatterns
    {I P : Type*} [Fintype I] [Infinite P] (ε : I → P → Bool) (c : I → ℂ)
    (hvanish : ∀ b ∈ recurringOrientationPatternSet ε,
      ∑ j, c j * orientationSignVector b j = 0) :
    {p | ∑ j, c j * orientationSignColumn (ε j) p ≠ 0}.Finite := by
  classical
  have hbad : {b : I → Bool | ∑ j, c j * orientationSignVector b j ≠ 0}.Finite :=
    Set.toFinite _
  have hfibre : ∀ b ∈ {b : I → Bool | ∑ j, c j * orientationSignVector b j ≠ 0},
      {p : P | primeOrientationPattern ε p = b}.Finite := by
    intro b hb
    by_contra hinf
    exact hb (hvanish b hinf)
  refine (hbad.biUnion hfibre).subset fun p hp => ?_
  simp only [Set.mem_setOf_eq] at hp
  refine Set.mem_iUnion₂.mpr ⟨primeOrientationPattern ε p, ?_, rfl⟩
  simpa only [Set.mem_setOf_eq, orientationSignColumn_eq_signVector] using hp

/-- The recurring-pattern sign matrix of a finite orientation family. -/
def recurringPatternSignMatrix {I P : Type*} [Fintype I] (ε : I → P → Bool)
    [Fintype (recurringOrientationPatternSet ε)] :
    Matrix (recurringOrientationPatternSet ε) I ℂ :=
  Matrix.of fun b j => orientationSignVector (b : I → Bool) j

/-- The corona rank: the dimension of the span of the recurring sign vectors. -/
def coronaRank {I P : Type*} [Fintype I] (ε : I → P → Bool) : ℕ :=
  Module.finrank ℂ
    (Submodule.span ℂ (orientationSignVector '' recurringOrientationPatternSet ε))

theorem coronaRank_eq_rank_transpose {I P : Type*} [Fintype I] [DecidableEq I]
    (ε : I → P → Bool) [Fintype (recurringOrientationPatternSet ε)] :
    coronaRank ε = (recurringPatternSignMatrix ε).transpose.rank := by
  classical
  have hset : orientationSignVector '' recurringOrientationPatternSet ε =
      Set.range (recurringPatternSignMatrix ε).transpose.col := by
    rw [Set.image_eq_range]
    rfl
  rw [Matrix.rank_eq_finrank_span_cols, coronaRank, hset]

theorem sum_deltaCombination {I κ : Type*} [Fintype I] [DecidableEq I] [Fintype κ]
    (a : κ → I) (u : κ → ℂ) (j : I) (s : I → ℂ) :
    ∑ i, ((if i = j then (1 : ℂ) else 0) - ∑ k, (if a k = i then u k else 0)) * s i
      = s j - ∑ k, u k * s (a k) := by
  classical
  simp only [sub_mul, Finset.sum_sub_distrib]
  congr 1
  · simp
  · simp only [Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp

theorem support_finite_sub_combination {I P : Type*} [Fintype I] [DecidableEq I] [Infinite P]
    {κ : Type*} [Fintype κ] (ε : I → P → Bool) (a : κ → I) (u : κ → ℂ) (j : I)
    (hvanish : ∀ b ∈ recurringOrientationPatternSet ε,
      orientationSignVector b j = ∑ k, u k * orientationSignVector b (a k)) :
    {p | orientationSignColumn (ε j) p ≠
      ∑ k, u k * orientationSignColumn (ε (a k)) p}.Finite := by
  classical
  have h := support_finite_of_vanishes_on_recurringPatterns ε
    (fun i => (if i = j then (1 : ℂ) else 0) - ∑ k, (if a k = i then u k else 0)) ?_
  · refine h.subset fun p hp => ?_
    simp only [Set.mem_setOf_eq] at hp ⊢
    have hsum := sum_deltaCombination a u j (fun i => orientationSignColumn (ε i) p)
    rw [hsum]
    intro hzero
    exact hp (sub_eq_zero.mp hzero)
  · intro b hb
    have hsum := sum_deltaCombination a u j (orientationSignVector b)
    rw [hsum, hvanish b hb, sub_self]

/-- **Corona basis extraction.**  Every finite prime-orientation family has a subfamily which is
independent modulo finite prime support and which spans every member of the family modulo finite
prime support.  Its cardinality is the corona rank. -/
theorem exists_coronaBasis_index
    {I : Type u} {P : Type*} [Fintype I] [DecidableEq I] [Infinite P] (ε : I → P → Bool) :
    ∃ (κ : Type u) (_ : Fintype κ) (a : κ → I),
      Function.Injective a ∧
      Nat.card κ = coronaRank ε ∧
      PrimeOrientationTailIndependent (fun k => ε (a k)) ∧
      ∀ j : I, ∃ u : κ → ℂ,
        {p | orientationSignColumn (ε j) p ≠
          ∑ k, u k * orientationSignColumn (ε (a k)) p}.Finite := by
  classical
  haveI : Fintype (recurringOrientationPatternSet ε) := Fintype.ofFinite _
  obtain ⟨κ, a, hainj, hspan, hli⟩ :=
    exists_linearIndependent' ℂ (recurringPatternSignMatrix ε).col
  haveI : Finite κ := Finite.of_injective a hainj
  haveI : Fintype κ := Fintype.ofFinite κ
  have hcard : Nat.card κ = coronaRank ε := by
    rw [Nat.card_eq_fintype_card, ← finrank_span_eq_card hli, hspan,
      ← Matrix.rank_eq_finrank_span_cols, coronaRank_eq_rank_transpose,
      Matrix.rank_transpose]
  have hvalue : ∀ (c : κ → ℂ) (b : recurringOrientationPatternSet ε),
      (∑ k, c k • ((recurringPatternSignMatrix ε).col ∘ a) k) b =
        ∑ k, c k * orientationSignVector (b : I → Bool) (a k) := by
    intro c b
    rw [Finset.sum_apply]
    exact Finset.sum_congr rfl fun k _ => rfl
  refine ⟨κ, inferInstance, a, hainj, hcard, ?_, ?_⟩
  · intro c hfinite
    funext k
    refine Fintype.linearIndependent_iff.mp hli c ?_ k
    funext b
    have hb : ((b : I → Bool)) ∈ recurringOrientationPatternSet ε := b.2
    by_contra hne
    have hsub : {p : P | primeOrientationPattern ε p = (b : I → Bool)} ⊆
        {p | ∑ k, c k * orientationSignColumn (ε (a k)) p ≠ 0} := by
      intro p hp
      simp only [Set.mem_setOf_eq] at hp ⊢
      have hrew : ∑ k, c k * orientationSignColumn (ε (a k)) p =
          ∑ k, c k * orientationSignVector (b : I → Bool) (a k) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [orientationSignColumn_eq_signVector, hp]
      rw [hrew]
      intro hzero
      exact hne (by rw [hvalue c b, hzero]; rfl)
    exact (hb.mono hsub) hfinite
  · intro j
    have hmem : (recurringPatternSignMatrix ε).col j ∈
        Submodule.span ℂ (Set.range ((recurringPatternSignMatrix ε).col ∘ a)) := by
      rw [hspan]
      exact Submodule.subset_span (Set.mem_range_self j)
    obtain ⟨u, hu⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hmem
    refine ⟨u, support_finite_sub_combination ε a u j ?_⟩
    intro b hb
    have heval := congrFun hu ⟨b, hb⟩
    rw [hvalue u ⟨b, hb⟩] at heval
    exact heval.symm

theorem coronaRank_ne_zero {I P : Type*} [Fintype I] [Nonempty I] [Infinite P]
    (ε : I → P → Bool) : coronaRank ε ≠ 0 := by
  classical
  obtain ⟨b, hb⟩ := Finite.exists_infinite_fiber (primeOrientationPattern ε)
  have hbmem : b ∈ recurringOrientationPatternSet ε := Set.infinite_coe_iff.mp hb
  have hvne : orientationSignVector b ≠ (0 : I → ℂ) := by
    intro h
    have hj := congrFun h (Classical.arbitrary I)
    simp only [orientationSignVector, Pi.zero_apply] at hj
    cases hbj : b (Classical.arbitrary I) <;>
      rw [hbj] at hj <;> simp [primeDirichletSign] at hj
  intro hzero
  rw [coronaRank, Submodule.finrank_eq_zero] at hzero
  have hmem : orientationSignVector b ∈
      Submodule.span ℂ (orientationSignVector '' recurringOrientationPatternSet ε) :=
    Submodule.subset_span ⟨b, hbmem, rfl⟩
  rw [hzero] at hmem
  exact hvne (Submodule.mem_bot ℂ |>.mp hmem)

/-- **Corona-span rank law.**  Every finite shift rectangle of a finite prime-orientation family
has an explicit labelled differential transcendence basis over the finite-prime base, indexed by a
subfamily of the orientations themselves, and the number of its generators is the number of shifts
times the corona rank of the family. -/
theorem exists_corona_differentialBasis
    {I : Type u} {A : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
    [Fintype A] [DecidableEq A] [Nonempty A]
    (ε : I → Nat.Primes → Bool) (alpha : A → ℂ)
    (hdistinct : Function.Injective fun a : A => (alpha a).re) :
    ∃ (κ : Type u) (_ : Fintype κ) (a : κ → I),
      Function.Injective a ∧
      DifferentialIndependent finitePrimeRationalCoefficientField
        (signedOrientationShiftPalette (fun k => ε (a k)) alpha) ∧
      differentialAdjoin finitePrimeRationalCoefficientField
          (Set.range (signedOrientationShiftPalette (fun k => ε (a k)) alpha)) =
        differentialAdjoin finitePrimeRationalCoefficientField
          (Set.range (signedOrientationShiftPalette ε alpha)) ∧
      Nat.card (κ × A) = Nat.card A * coronaRank ε := by
  classical
  obtain ⟨κ, hκ, a, hainj, hcard, hindep, hcomb⟩ := exists_coronaBasis_index ε
  letI : Fintype κ := hκ
  haveI : Nonempty κ := by
    have hne : Nat.card κ ≠ 0 := by
      rw [hcard]
      exact coronaRank_ne_zero ε
    exact Nat.card_ne_zero.mp hne |>.1
  refine ⟨κ, hκ, a, hainj, ?_, ?_, ?_⟩
  · exact (signedOrientationShiftPalette_differentialBasis ε alpha hdistinct a hindep hcomb).1
  · exact (signedOrientationShiftPalette_differentialBasis ε alpha hdistinct a hindep hcomb).2
  · rw [Nat.card_prod, Nat.mul_comm, hcard]

/-! ## The anchored opacity interval -/

/-- The anchored pattern skeleton: the all-positive pattern together with every pattern having a
single negative coordinate away from the anchor. -/
def anchoredSkeleton {J : Type*} [DecidableEq J] (anchor : J) : Set (J → Bool) :=
  insert allPositiveOrientationPattern
    {x | ∃ j, j ≠ anchor ∧ x = singleNegativeOrientationPattern j}

/-- The anchor half-space: every pattern which is positive at the distinguished coordinate. -/
def anchorHalfSpace {J : Type*} (anchor : J) : Set (J → Bool) :=
  {x | x anchor = false}

theorem anchoredSkeleton_subset_anchorHalfSpace {J : Type*} [DecidableEq J] (anchor : J) :
    anchoredSkeleton anchor ⊆ anchorHalfSpace anchor := by
  rintro x (rfl | ⟨j, hj, rfl⟩)
  · rfl
  · simp [anchorHalfSpace, singleNegativeOrientationPattern, Ne.symm hj]

theorem mem_anchoredSkeleton_iff {J : Type*} [DecidableEq J] (anchor : J) (x : J → Bool) :
    x ∈ anchoredSkeleton anchor ↔
      x anchor = false ∧ ∀ j k, x j = true → x k = true → j = k := by
  constructor
  · rintro (rfl | ⟨j, hj, rfl⟩)
    · exact ⟨rfl, by simp [allPositiveOrientationPattern]⟩
    · refine ⟨by simp [singleNegativeOrientationPattern, Ne.symm hj], ?_⟩
      intro a b ha hb
      simp only [singleNegativeOrientationPattern, decide_eq_true_eq] at ha hb
      rw [ha, hb]
  · rintro ⟨hanchor, hone⟩
    by_cases hex : ∃ j, x j = true
    · obtain ⟨j, hj⟩ := hex
      refine Or.inr ⟨j, ?_, ?_⟩
      · intro hja
        rw [hja, hanchor] at hj
        exact Bool.noConfusion hj
      · funext k
        by_cases hk : x k = true
        · rw [hk, hone k j hk hj]
          simp [singleNegativeOrientationPattern]
        · have hkj : k ≠ j := by
            intro h
            exact hk (h ▸ hj)
          simp only [singleNegativeOrientationPattern, hkj]
          simpa using Bool.not_eq_true _ |>.mp hk
    · refine Or.inl ?_
      funext k
      have : x k ≠ true := fun h => hex ⟨k, h⟩
      simpa [allPositiveOrientationPattern] using Bool.not_eq_true _ |>.mp this

/-- **The anchored skeleton is compact.**  Outside it a pattern is either negative at the anchor
or negative at two distinct coordinates, and each of those is decided by a finite cylinder. -/
theorem isClosed_anchoredSkeleton {J : Type*} [DecidableEq J] (anchor : J) :
    IsClosed (anchoredSkeleton anchor) := by
  have hset : anchoredSkeleton anchor =
      {x : J → Bool | x anchor = false} ∩
        ⋂ j : J, ⋂ k : J, {x : J → Bool | x j = true → x k = true → j = k} := by
    ext x
    rw [mem_anchoredSkeleton_iff]
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_iInter]
  rw [hset]
  refine IsClosed.inter (isClosed_eq (continuous_apply anchor) continuous_const) ?_
  refine isClosed_iInter fun j => isClosed_iInter fun k => ?_
  by_cases hjk : j = k
  · subst hjk
    simp
  · have hcompl : {x : J → Bool | x j = true → x k = true → j = k} =
        ({x : J → Bool | x j = true} ∩ {x : J → Bool | x k = true})ᶜ := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_inter_iff, not_and]
      constructor
      · intro h h1 h2
        exact hjk (h h1 h2)
      · intro h h1 h2
        exact absurd h2 (h h1)
    rw [hcompl]
    refine IsOpen.isClosed_compl (IsOpen.inter ?_ ?_)
    · show IsOpen ((fun x : J → Bool => x j) ⁻¹' ({true} : Set Bool))
      exact (continuous_apply j).isOpen_preimage _ (isOpen_discrete _)
    · show IsOpen ((fun x : J → Bool => x k) ⁻¹' ({true} : Set Bool))
      exact (continuous_apply k).isOpen_preimage _ (isOpen_discrete _)

theorem isCompact_anchoredSkeleton {J : Type*} [DecidableEq J] (anchor : J) :
    IsCompact (anchoredSkeleton anchor) :=
  (isClosed_anchoredSkeleton anchor).isCompact

/-- **Anchored maximal rank.**  Any pattern set containing the anchored skeleton has sign vectors
spanning the whole finite coefficient space. -/
theorem span_orientationSignVector_eq_top_of_anchoredSkeleton_subset
    {I : Type*} [Fintype I] [DecidableEq I] (anchor : I) (R : Set (I → Bool))
    (hSR : anchoredSkeleton anchor ⊆ R) :
    Submodule.span ℂ (orientationSignVector '' R) = ⊤ := by
  classical
  set W := Submodule.span ℂ (orientationSignVector '' R) with hW
  have hmemR : ∀ b ∈ R, orientationSignVector b ∈ W :=
    fun b hb => Submodule.subset_span ⟨b, hb, rfl⟩
  have hv0 : orientationSignVector (allPositiveOrientationPattern : I → Bool) ∈ W :=
    hmemR _ (hSR (Set.mem_insert _ _))
  have hvj : ∀ j : I, j ≠ anchor →
      orientationSignVector (singleNegativeOrientationPattern j) ∈ W :=
    fun j hj => hmemR _ (hSR (Set.mem_insert_of_mem _ ⟨j, hj, rfl⟩))
  have hsingle : ∀ j : I, j ≠ anchor → Pi.single j (1 : ℂ) ∈ W := by
    intro j hj
    have hcalc : Pi.single j (1 : ℂ) =
        (2 : ℂ)⁻¹ • (orientationSignVector (allPositiveOrientationPattern : I → Bool) -
          orientationSignVector (singleNegativeOrientationPattern j)) := by
      funext i
      by_cases hij : i = j
      · subst hij
        simp [orientationSignVector, allPositiveOrientationPattern,
          singleNegativeOrientationPattern, primeDirichletSign]
        norm_num
      · simp [orientationSignVector, allPositiveOrientationPattern,
          singleNegativeOrientationPattern, primeDirichletSign, hij]
    rw [hcalc]
    exact Submodule.smul_mem _ _ (Submodule.sub_mem _ hv0 (hvj j hj))
  have hanchorMem : Pi.single anchor (1 : ℂ) ∈ W := by
    have hcalc : Pi.single anchor (1 : ℂ) =
        orientationSignVector (allPositiveOrientationPattern : I → Bool) -
          ∑ j ∈ Finset.univ.erase anchor, Pi.single j (1 : ℂ) := by
      funext i
      have hsum : (∑ j ∈ Finset.univ.erase anchor, Pi.single j (1 : ℂ)) i =
          if i ∈ Finset.univ.erase anchor then 1 else 0 := by
        rw [Finset.sum_apply]
        simp [Pi.single_apply, Finset.sum_ite_eq]
      by_cases hia : i = anchor
      · subst hia
        simp [orientationSignVector, allPositiveOrientationPattern, primeDirichletSign,
          Pi.single_apply]
      · simp [orientationSignVector, allPositiveOrientationPattern, primeDirichletSign,
          Pi.single_apply, hia]
    rw [hcalc]
    refine Submodule.sub_mem _ hv0 (Submodule.sum_mem _ fun j hj => ?_)
    exact hsingle j (Finset.mem_erase.mp hj).1
  have hall : ∀ j : I, Pi.single j (1 : ℂ) ∈ W := by
    intro j
    by_cases hj : j = anchor
    · subst hj; exact hanchorMem
    · exact hsingle j hj
  refine top_le_iff.mp ?_
  rw [← (Pi.basisFun ℂ I).span_eq]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  simpa [Pi.basisFun_apply] using hall i

theorem coronaRank_eq_card_of_anchoredSkeleton_subset
    {I P : Type*} [Fintype I] [DecidableEq I] (ε : I → P → Bool) (anchor : I)
    (hSR : anchoredSkeleton anchor ⊆ recurringOrientationPatternSet ε) :
    coronaRank ε = Fintype.card I := by
  rw [coronaRank, span_orientationSignVector_eq_top_of_anchoredSkeleton_subset anchor _ hSR,
    finrank_top, Module.finrank_pi]

theorem recurringOrientationPatternSet_eq_chamber {I : Type*} [Fintype I]
    (e : ℕ ≃ Nat.Primes) (ε : I → Nat.Primes → Bool) :
    recurringOrientationPatternSet ε = primeRecurringPatternChamber e ε := by
  ext b
  constructor
  · intro hb
    rw [primeRecurringPatternChamber,
      mem_primeOrientationTailClusterSet_iff_all_finite_patterns_recur]
    intro I'
    have hn : {n | (fun i => ε i (e n)) = b}.Infinite := by
      have himg : (e.symm '' {p | primeOrientationPattern ε p = b}).Infinite :=
        hb.image e.symm.injective.injOn
      refine himg.mono ?_
      rintro n ⟨p, hp, rfl⟩
      simp only [Set.mem_setOf_eq, Equiv.apply_symm_apply]
      exact hp
    refine hn.mono ?_
    intro n hn'
    simp only [Set.mem_setOf_eq] at hn' ⊢
    simp [hn']
  · intro hb
    exact primeRecurringPatternChamber_fiber_infinite e ε ⟨b, hb⟩

theorem orientationRestriction_allPositive {J : Type*} (I : Finset J) :
    orientationRestriction I (allPositiveOrientationPattern : J → Bool) =
      (allPositiveOrientationPattern : I → Bool) := rfl

theorem orientationRestriction_singleNegative {J : Type*} [DecidableEq J]
    (I : Finset J) {j : J} (hj : j ∈ I) :
    orientationRestriction I (singleNegativeOrientationPattern j) =
      singleNegativeOrientationPattern (⟨j, hj⟩ : I) := by
  funext i
  simp only [orientationRestriction, singleNegativeOrientationPattern, Subtype.ext_iff]

theorem anchoredSkeleton_restriction_subset {J : Type*} [DecidableEq J]
    (anchor : J) (K : Set (J → Bool)) (hSK : anchoredSkeleton anchor ⊆ K)
    (I : Finset J) (hanchorI : anchor ∈ I) :
    anchoredSkeleton (⟨anchor, hanchorI⟩ : I) ⊆ orientationRestriction I '' K := by
  rintro y (rfl | ⟨⟨j, hj⟩, hjne, rfl⟩)
  · exact ⟨allPositiveOrientationPattern, hSK (Set.mem_insert _ _),
      orientationRestriction_allPositive I⟩
  · have hjanchor : j ≠ anchor := fun h => hjne (Subtype.ext h)
    exact ⟨singleNegativeOrientationPattern j,
      hSK (Set.mem_insert_of_mem _ ⟨j, hjanchor, rfl⟩),
      orientationRestriction_singleNegative I hj⟩

/-- **Anchored constraint opacity.**  For a nonempty closed Boolean constraint between the anchored
skeleton and the anchor half-space, the canonical prime realization has tail cluster exactly the
constraint, an identically all-positive anchor source, maximal corona rank on every finite
coordinate chamber containing the anchor, and a differentially independent complete shift
rectangle.  None of these data sees the constraint. -/
theorem anchored_closedConstraint_opacity
    {J : Type*} [Countable J] [DecidableEq J] (anchor : J)
    (K : Set (J → Bool)) [Nonempty K] (hK : IsClosed K)
    (hSK : anchoredSkeleton anchor ⊆ K) (hKH : K ⊆ anchorHalfSpace anchor)
    (e : ℕ ≃ Nat.Primes) (I : Finset J) (hanchorI : anchor ∈ I)
    {A : Type*} [Fintype A] [DecidableEq A] [Nonempty A] (alpha : A → ℂ)
    (hdistinct : Function.Injective fun a : A => (alpha a).re) :
    primeOrientationTailClusterSet (closedConstraintOrientation K) = K ∧
      (∀ p : Nat.Primes,
        enumeratedClosedConstraintPrimeOrientation e K anchor p = false) ∧
      recurringOrientationPatternSet
          (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1)
        = orientationRestriction I '' K ∧
      coronaRank (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1)
        = I.card ∧
      DifferentialIndependent finitePrimeRationalCoefficientField
        (signedOrientationShiftPalette
          (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1) alpha) := by
  classical
  haveI : Nonempty I := ⟨⟨anchor, hanchorI⟩⟩
  have hchamber : recurringOrientationPatternSet
      (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1)
      = orientationRestriction I '' K := by
    rw [recurringOrientationPatternSet_eq_chamber e]
    exact primeRecurringPatternChamber_enumeratedClosedConstraint e K hK I
  have hskel : anchoredSkeleton (⟨anchor, hanchorI⟩ : I) ⊆
      recurringOrientationPatternSet
        (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1) := by
    rw [hchamber]
    exact anchoredSkeleton_restriction_subset anchor K hSK I hanchorI
  have htail : PrimeOrientationTailIndependent
      (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1) := by
    refine primeOrientationTailIndependent_of_anchoredSkeleton _ (⟨anchor, hanchorI⟩ : I)
      (hskel (Set.mem_insert _ _)) ?_
    intro j hj
    exact hskel (Set.mem_insert_of_mem _ ⟨j, hj, rfl⟩)
  refine ⟨tailCluster_infinitelyRepeatedDenseBooleanConstraint K hK, ?_, hchamber, ?_, ?_⟩
  · intro p
    exact closedConstraintOrientation_eq_of_coordinate_eq K anchor false
      (fun x hx => hKH hx) (e.symm p)
  · rw [coronaRank_eq_card_of_anchoredSkeleton_subset _ (⟨anchor, hanchorI⟩ : I) hskel,
      Fintype.card_coe]
  · exact (signedPrimeShiftPalette_differentialIndependent_iff
      (fun i : I => enumeratedClosedConstraintPrimeOrientation e K i.1) alpha hdistinct).mpr htail

/-- **Opacity of the whole interval.**  Any two nonempty closed constraints between the anchored
skeleton and the anchor half-space give realizations with the same corona rank on every finite
coordinate chamber containing the anchor: the finitary differential matroid does not see which
constraint was imposed. -/
theorem anchored_opacity_interval_constant
    {J : Type*} [Countable J] [DecidableEq J] (anchor : J)
    (K₁ K₂ : Set (J → Bool)) [Nonempty K₁] [Nonempty K₂]
    (hK₁ : IsClosed K₁) (hK₂ : IsClosed K₂)
    (hS₁ : anchoredSkeleton anchor ⊆ K₁) (hH₁ : K₁ ⊆ anchorHalfSpace anchor)
    (hS₂ : anchoredSkeleton anchor ⊆ K₂) (hH₂ : K₂ ⊆ anchorHalfSpace anchor)
    (e : ℕ ≃ Nat.Primes) (I : Finset J) (hanchorI : anchor ∈ I) :
    coronaRank (fun i : I => enumeratedClosedConstraintPrimeOrientation e K₁ i.1) =
      coronaRank (fun i : I => enumeratedClosedConstraintPrimeOrientation e K₂ i.1) := by
  classical
  haveI : Nonempty I := ⟨⟨anchor, hanchorI⟩⟩
  have h1 := anchored_closedConstraint_opacity anchor K₁ hK₁ hS₁ hH₁ e I hanchorI
    (A := Fin 1) (fun _ => 0) (fun a b _ => Subsingleton.elim a b)
  have h2 := anchored_closedConstraint_opacity anchor K₂ hK₂ hS₂ hH₂ e I hanchorI
    (A := Fin 1) (fun _ => 0) (fun a b _ => Subsingleton.elim a b)
  rw [h1.2.2.2.1, h2.2.2.2.1]

end

