import GaloisForLFunctions.HTGeometry.CoRankOneCenteredObservationCoordinates
import GaloisForLFunctions.HTGeometry.RankOneCriticalCenteredPolynomial
import GaloisForLFunctions.HTGeometry.CriticalReciprocalNumerator

/-!
# The actual co-rank-one critical extension as a centered generic polynomial

For `m > 0`, reciprocal inversion identifies the actual critical source extension of
`criticalObservationField K m 1` with the simple extension generated by the hidden reciprocal
constant coefficient.  Its explicit centered degree-`m + 1` polynomial becomes the centered
generic polynomial under the co-rank-one observation-coordinate equivalence.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] {m : ℕ}

theorem coRankOneCriticalSourceRaw_mul_recip_pow_eq_tailCoeff_sum
    (hm : 0 < m) :
    criticalSourceRaw K m 1 (⟨m, by omega⟩ : Fin (m + 1)) *
        criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1)) ^ (m + 1) =
      ∑ j : Fin m,
        (-1 : criticalSourceField K m 1) ^ (m - (j : ℕ)) *
          algebraMap (criticalObservationField K m 1) (criticalSourceField K m 1)
            (MvPolynomial.aeval (criticalObservationRecip K m 1) (tailCoeff K m j)) *
          criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1)) ^ (j : ℕ) := by
  let Z := criticalSourceReciprocalPolynomial K m 1
  let W := criticalSourceRawPolynomial K m 1
  have hZW : (X : (criticalSourceField K m 1)[X]) ^ (m + 1) ∣ Z * W - 1 := by
    simpa [Z, W, mul_comm] using
      X_pow_dvd_criticalSourceRaw_mul_reciprocal_sub_one K m 1
  have hunit : IsUnit (Z.coeff 0) := by
    dsimp only [Z]
    rw [criticalSourceReciprocalPolynomial_coeff K m 1 0 (by omega)]
    apply isUnit_iff_ne_zero.2
    rw [criticalSourceRecip_zero_eq_inv K (m := m) (n := 1) (by omega)]
    exact inv_ne_zero (by
      simpa [criticalSourceScale] using
        criticalSourceScale_ne_zero K hm (by omega : 0 < 1))
  have h := coeff_mul_pow_eq_aeval_tailCoeff_of_dvd
    (K := K) (M := criticalSourceField K m 1) m hm hZW hunit
  have hZ0 : Z.coeff 0 = criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1)) := by
    dsimp only [Z]
    rw [criticalSourceReciprocalPolynomial_coeff K m 1 0 (by omega)]
  have hWm : W.coeff m = criticalSourceRaw K m 1 (⟨m, by omega⟩ : Fin (m + 1)) := by
    dsimp only [W]
    rw [criticalSourceRawPolynomial_coeff K m 1 m (by omega)]
  have hZi (i : Fin m) :
      Z.coeff ((i : ℕ) + 1) =
        algebraMap (criticalObservationField K m 1) (criticalSourceField K m 1)
          (criticalObservationRecip K m 1 i) := by
    dsimp only [Z]
    rw [criticalSourceReciprocalPolynomial_coeff K m 1 ((i : ℕ) + 1) (by omega)]
    apply Subtype.ext
    change criticalAmbientRecip K m 1 ((i : ℕ) + 1) =
      criticalAmbientRecip K m 1 (1 + (i : ℕ))
    congr 1
    omega
  have hhom :
      MvPolynomial.aeval (fun i : Fin m => Z.coeff ((i : ℕ) + 1)) =
        (IsScalarTower.toAlgHom K (criticalObservationField K m 1)
          (criticalSourceField K m 1)).comp
          (MvPolynomial.aeval (criticalObservationRecip K m 1)) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, MvPolynomial.aeval_X, hZi]
    rfl
  have hscalar (x : criticalObservationField K m 1) :
      IsScalarTower.toAlgHom K (criticalObservationField K m 1)
          (criticalSourceField K m 1) x =
        algebraMap (criticalObservationField K m 1) (criticalSourceField K m 1) x := rfl
  rw [hWm, hZ0] at h
  simpa only [DFunLike.congr_fun hhom, AlgHom.comp_apply, hscalar] using h

/-- Monic centered polynomial cut out by actual co-rank-one observation coordinates. -/
noncomputable def coRankOneCriticalCenteredPolynomial (hm : 0 < m) :
    (criticalObservationField K m 1)[X] :=
  X ^ (m + 1) +
    ∑ j : Fin m,
      C (coRankOneCriticalCenteredCoeff (K := K) hm j) * X ^ (j : ℕ)

set_option maxHeartbeats 800000 in
theorem eval₂_coRankOneCriticalCenteredPolynomial_neg_recip_zero
    (hm : 0 < m) :
    Polynomial.eval₂
        (algebraMap (criticalObservationField K m 1) (criticalSourceField K m 1))
        (-criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1)))
        (coRankOneCriticalCenteredPolynomial (K := K) hm) = 0 := by
  let O := criticalObservationField K m 1
  let S := criticalSourceField K m 1
  let y : S := criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1))
  let pO : O := criticalObservationRaw K m 1 (0 : Fin 1)
  let p : S := algebraMap O S pO
  let t : Fin m → S := fun j =>
    algebraMap O S
      (MvPolynomial.aeval (criticalObservationRecip K m 1) (tailCoeff K m j))
  have hp_eq :
      p = criticalSourceRaw K m 1 (⟨m, by omega⟩ : Fin (m + 1)) := by
    apply Subtype.ext
    change criticalAmbientRaw K m 1 (m + (0 : Fin 1)) =
      criticalAmbientRaw K m 1 m
    simp
  have hpO_ne : pO ≠ 0 := by
    intro hzero
    have hmap := congrArg (coRankOneCriticalObservationFieldEquiv (K := K) hm) hzero
    rw [map_zero, coRankOneCriticalObservationFieldEquiv_raw,
      iteratedRationalFamily_inr] at hmap
    exact fracX_tailRat_ne_zero hmap
  have hp_ne : p ≠ 0 := (algebraMap O S).injective.ne hpO_ne
  have heq :
      p * y ^ (m + 1) =
        ∑ j : Fin m, (-1 : S) ^ (m - (j : ℕ)) * t j * y ^ (j : ℕ) := by
    rw [hp_eq]
    exact coRankOneCriticalSourceRaw_mul_recip_pow_eq_tailCoeff_sum (K := K) hm
  have hcenter (j : Fin m) :
      algebraMap O S (coRankOneCriticalCenteredCoeff (K := K) hm j) = t j / p := by
    rw [coRankOneCriticalCenteredCoeff, map_div₀]
  rw [← mul_eq_zero_iff_left hp_ne]
  rw [coRankOneCriticalCenteredPolynomial, Polynomial.eval₂_add,
    Polynomial.eval₂_pow, Polynomial.eval₂_X]
  have hevalsum :
      Polynomial.eval₂ (algebraMap O S) (-y)
          (∑ j : Fin m,
            Polynomial.C (coRankOneCriticalCenteredCoeff (K := K) hm j) *
              Polynomial.X ^ (j : ℕ)) =
        ∑ j : Fin m,
          Polynomial.eval₂ (algebraMap O S) (-y)
            (Polynomial.C (coRankOneCriticalCenteredCoeff (K := K) hm j) *
              Polynomial.X ^ (j : ℕ)) := by
    change (Polynomial.eval₂RingHom (algebraMap O S) (-y)) (∑ j : Fin m,
        Polynomial.C (coRankOneCriticalCenteredCoeff (K := K) hm j) *
          Polynomial.X ^ (j : ℕ)) =
      ∑ j : Fin m,
        (Polynomial.eval₂RingHom (algebraMap O S) (-y))
          (Polynomial.C (coRankOneCriticalCenteredCoeff (K := K) hm j) *
            Polynomial.X ^ (j : ℕ))
    rw [map_sum]
  rw [hevalsum]
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, hcenter,
    Polynomial.eval₂_pow, Polynomial.eval₂_X]
  rw [mul_add, Finset.mul_sum]
  have hterm (j : Fin m) :
      p * (t j / p * (-y) ^ (j : ℕ)) = t j * (-y) ^ (j : ℕ) := by
    have hcancel : p * (t j / p) = t j := by
      calc
        p * (t j / p) = (t j / p) * p := mul_comm _ _
        _ = t j := div_mul_cancel₀ _ hp_ne
    rw [← mul_assoc, hcancel]
  rw [Finset.sum_congr rfl (fun j _ => hterm j)]
  rw [neg_pow y (m + 1)]
  have hneg (j : Fin m) :
      (-y) ^ (j : ℕ) = (-1 : S) ^ (j : ℕ) * y ^ (j : ℕ) :=
    neg_pow y (j : ℕ)
  rw [Finset.sum_congr rfl (fun j _ => by rw [hneg j])]
  calc
    p * ((-1 : S) ^ (m + 1) * y ^ (m + 1)) +
        ∑ j : Fin m, t j * ((-1 : S) ^ (j : ℕ) * y ^ (j : ℕ)) =
      (-1 : S) ^ (m + 1) * (p * y ^ (m + 1)) +
        ∑ j : Fin m, t j * ((-1 : S) ^ (j : ℕ) * y ^ (j : ℕ)) := by ac_rfl
    _ = (-1 : S) ^ (m + 1) *
          (∑ j : Fin m, (-1 : S) ^ (m - (j : ℕ)) * t j * y ^ (j : ℕ)) +
        ∑ j : Fin m, t j * ((-1 : S) ^ (j : ℕ) * y ^ (j : ℕ)) := by rw [heq]
    _ = ∑ j : Fin m,
        (((-1 : S) ^ (m + 1) * (-1 : S) ^ (m - (j : ℕ))) +
          (-1 : S) ^ (j : ℕ)) * t j * y ^ (j : ℕ) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro j _
      rw [neg_one_pow_succ_mul_neg_one_pow_sub (Nat.le_of_lt j.isLt)]
      ring

theorem coeff_coRankOneCriticalCenteredPolynomial
    (hm : 0 < m) (k : ℕ) :
    (coRankOneCriticalCenteredPolynomial (K := K) hm).coeff k =
      (if k = m + 1 then 1 else 0) +
        if h : k < m then coRankOneCriticalCenteredCoeff (K := K) hm ⟨k, h⟩ else 0 := by
  rw [coRankOneCriticalCenteredPolynomial, Polynomial.coeff_add,
    Polynomial.coeff_X_pow, coeff_fin_sum_C_mul_X_pow]

