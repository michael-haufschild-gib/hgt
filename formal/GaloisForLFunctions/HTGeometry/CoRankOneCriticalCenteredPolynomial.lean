set_option maxHeartbeats 800000 in
theorem map_coRankOneCriticalCenteredPolynomial_eq_centeredMonicE
    (hm : 0 < m) :
    Polynomial.map
        (coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm).toRingHom
        (coRankOneCriticalCenteredPolynomial (K := K) hm) =
      Polynomial.map
        (algebraMap (centeredCoeffField K m.succ)
          (FractionRing (Polynomial (centeredCoeffField K m.succ))))
        (centeredMonicE K m.succ) := by
  let e := coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm
  let F := centeredCoeffField K m.succ
  let B := FractionRing (Polynomial F)
  let ι : F →+* B := algebraMap F B
  have hcenter (j : Fin m) :
      e (coRankOneCriticalCenteredCoeff (K := K) hm j) =
        ι (centeredCoeffIn K m.succ (rankOneCenteredIndex j)) := by
    rw [coRankOneCriticalObservationToCenteredCoeffFreeEquiv_centered]
    change algebraMap (Polynomial F) B
        (Polynomial.C (centeredCoeffIn K m.succ (rankOneCenteredIndex j))) = _
    change algebraMap (Polynomial F) B
        (algebraMap F (Polynomial F)
          (centeredCoeffIn K m.succ (rankOneCenteredIndex j))) = _
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) B]
  have htop :
      centeredCoeffIn K m.succ (⟨m, by omega⟩ : Fin m.succ) = 0 :=
    Subtype.ext (centeredCoeff_top_eq_zero (K := K) (d := m.succ) (by omega))
  apply Polynomial.ext
  intro k
  rw [Polynomial.coeff_map, Polynomial.coeff_map,
    coeff_coRankOneCriticalCenteredPolynomial (K := K) hm,
    coeff_centeredMonicE (K := K) (n := m)]
  by_cases hlead : k = m + 1
  · subst k
    simp
  by_cases hlow : k < m
  · have hsucc : k < m.succ := by omega
    simp only [if_neg hlead, dif_pos hlow, if_neg (by omega), dif_pos hsucc,
      zero_add]
    have hidx :
        rankOneCenteredIndex (⟨k, hlow⟩ : Fin m) =
          (⟨k, hsucc⟩ : Fin m.succ) := Fin.ext rfl
    change e (coRankOneCriticalCenteredCoeff (K := K) hm ⟨k, hlow⟩) =
      ι (centeredCoeffIn K m.succ ⟨k, hsucc⟩)
    rw [hcenter, hidx]
  · have hmle : m ≤ k := Nat.le_of_not_gt hlow
    by_cases heq : k = m
    · subst k
      simp [htop]
    · have hsucc : ¬ k < m.succ := by omega
      simp only [if_neg hlead, dif_neg hlow, dif_neg hsucc,
        map_zero, add_zero]

theorem coRankOneCriticalSourceField_adjoin_neg_recip_zero_eq_top
    (hm : 0 < m) :
    IntermediateField.adjoin (criticalObservationField K m 1)
      { -criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1)) } = ⊤ := by
  let O := criticalObservationField K m 1
  let S := criticalSourceField K m 1
  let y : S := criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1))
  let C : IntermediateField O S := IntermediateField.adjoin O { -y }
  have hneg : -y ∈ C :=
    IntermediateField.subset_adjoin O { -y } (Set.mem_singleton (-y))
  have hy : y ∈ C := by
    have := C.neg_mem hneg
    simpa using this
  have hrecip (i : Fin (m + 1)) : criticalSourceRecip K m 1 i ∈ C := by
    by_cases hi : (i : ℕ) = 0
    · have hi0 : i = (0 : Fin (m + 1)) := Fin.ext hi
      subst i
      exact hy
    · have hi1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi
      let j : Fin m := ⟨(i : ℕ) - 1, by omega⟩
      have hcoord :
          criticalSourceRecip K m 1 i =
            algebraMap O S (criticalObservationRecip K m 1 j) := by
        apply Subtype.ext
        change criticalAmbientRecip K m 1 (i : ℕ) =
          criticalAmbientRecip K m 1 (1 + (j : ℕ))
        congr 1
        dsimp only [j]
        omega
      rw [hcoord]
      exact C.algebraMap_mem _
  have hle :
      IntermediateField.adjoin K
          (Set.range (criticalSourceRecipReindexed K hm (by omega : 0 < 1))) ≤
        C.restrictScalars K := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    change criticalSourceRecipReindexed K hm (by omega : 0 < 1) i ∈ C
    exact hrecip (Fin.cast (by omega) i)
  rw [criticalSourceRecip_adjoin_ground_eq_top K hm (by omega : 0 < 1)] at hle
  have hrestrict : C.restrictScalars K = ⊤ := top_unique hle
  apply top_unique
  intro x _
  change x ∈ C
  have hx : x ∈ C.restrictScalars K := by rw [hrestrict]; trivial
  exact hx

set_option synthInstance.maxHeartbeats 100000 in
theorem natDegree_coRankOneCriticalCenteredPolynomial
    (hm : 0 < m) :
    (coRankOneCriticalCenteredPolynomial (K := K) hm).natDegree = m + 1 := by
  have hmap := congrArg Polynomial.natDegree
    (map_coRankOneCriticalCenteredPolynomial_eq_centeredMonicE (K := K) hm)
  rw [Polynomial.natDegree_map_eq_of_injective
      (coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm).injective,
    Polynomial.natDegree_map_eq_of_injective
      (algebraMap (centeredCoeffField K m.succ)
        (FractionRing (Polynomial (centeredCoeffField K m.succ)))).injective,
    natDegree_centeredMonicE] at hmap
  exact hmap

theorem monic_coRankOneCriticalCenteredPolynomial
    (hm : 0 < m) :
    (coRankOneCriticalCenteredPolynomial (K := K) hm).Monic := by
  show (coRankOneCriticalCenteredPolynomial (K := K) hm).leadingCoeff = 1
  rw [Polynomial.leadingCoeff, natDegree_coRankOneCriticalCenteredPolynomial (K := K) hm,
    coeff_coRankOneCriticalCenteredPolynomial (K := K) hm]
  simp

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 800000 in
theorem minpoly_neg_criticalSourceRecip_zero_eq_coRankOneCriticalCenteredPolynomial
    (hm : 0 < m) :
    minpoly (criticalObservationField K m 1)
        (-criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1))) =
      coRankOneCriticalCenteredPolynomial (K := K) hm := by
  let O := criticalObservationField K m 1
  let S := criticalSourceField K m 1
  let y : S := -criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1))
  letI : FiniteDimensional O S :=
    criticalSourceField_finiteDimensional_criticalObservationField K hm (by omega)
  have hy : IsIntegral O y := IsIntegral.of_finite O y
  have hroot : Polynomial.aeval y (coRankOneCriticalCenteredPolynomial (K := K) hm) = 0 := by
    simpa [Polynomial.aeval_def, y] using
      eval₂_coRankOneCriticalCenteredPolynomial_neg_recip_zero (K := K) hm
  have hdvd : minpoly O y ∣ coRankOneCriticalCenteredPolynomial (K := K) hm :=
    minpoly.dvd O y hroot
  have hadjoin : IntermediateField.adjoin O {y} = ⊤ := by
    exact coRankOneCriticalSourceField_adjoin_neg_recip_zero_eq_top (K := K) hm
  have hminDegree : (minpoly O y).natDegree = m + 1 := by
    calc
      (minpoly O y).natDegree = Module.finrank O ↥(IntermediateField.adjoin O {y}) :=
        (IntermediateField.adjoin.finrank hy).symm
      _ = Module.finrank O ↥(⊤ : IntermediateField O S) := by rw [hadjoin]
      _ = Module.finrank O S :=
        (IntermediateField.topEquiv (F := O) (E := S)).toLinearEquiv.finrank_eq
      _ = criticalHorizonMultiplicity m 1 :=
        finrank_criticalSourceField_eq_criticalHorizonMultiplicity K hm (by omega)
      _ = m + 1 := by simp [criticalHorizonMultiplicity, Nat.add_comm]
  apply Eq.symm
  apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le
    (minpoly.monic hy)
    (monic_coRankOneCriticalCenteredPolynomial (K := K) hm)
    hdvd
  rw [natDegree_coRankOneCriticalCenteredPolynomial (K := K) hm, hminDegree]

end

