import GaloisForLFunctions.HTGeometry.PolynomialBaseChange
import Mathlib.FieldTheory.SplittingField.IsSplittingField

/-!
# The Galois group of a polynomial does not depend on the ambient field

The field generated by the roots of a polynomial inside any field where it splits is a splitting
field of that polynomial, and any two splitting fields are isomorphic over the base.  So an
identification of the automorphism group of one of them with a permutation group transports to the
other.

This is what lets a Galois group computed in a convenient model be used in whatever ambient field a
later construction produces.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F : Type*} [Field F] {p : Polynomial F}

/-- The root field inside an ambient where the polynomial splits is a splitting field. -/
theorem isSplittingField_rootField {L : Type*} [Field L] [Algebra F L]
    (hp : (p.map (algebraMap F L)).Splits) :
    Polynomial.IsSplittingField F (rootField F (L := L) p) p :=
  IntermediateField.adjoin_rootSet_isSplittingField hp

/-- **Two splitting fields have the same automorphism group.** -/
noncomputable def splittingFieldAutEquiv {L L' : Type*} [Field L] [Field L']
    [Algebra F L] [Algebra F L'] [Polynomial.IsSplittingField F L p]
    [Polynomial.IsSplittingField F L' p] :
    (L ≃ₐ[F] L) ≃* (L' ≃ₐ[F] L') :=
  AlgEquiv.autCongr
    ((Polynomial.IsSplittingField.algEquiv L p).trans
      (Polynomial.IsSplittingField.algEquiv L' p).symm)

/-- **The permutation identification transports to the root field of any ambient.** -/
noncomputable def rootFieldPermEquiv {L L' : Type*} [Field L] [Field L']
    [Algebra F L] [Algebra F L'] [Polynomial.IsSplittingField F L p]
    (hp : (p.map (algebraMap F L')).Splits)
    {γ : Type*} (ψ : (L ≃ₐ[F] L) ≃* Equiv.Perm γ) :
    (rootField F (L := L') p ≃ₐ[F] rootField F (L := L') p) ≃* Equiv.Perm γ := by
  haveI := isSplittingField_rootField (F := F) (p := p) (L := L') hp
  exact (splittingFieldAutEquiv (F := F) (p := p) (L := rootField F (L := L') p) (L' := L)).trans ψ

end GaloisForLFunctions.HTGeometry
