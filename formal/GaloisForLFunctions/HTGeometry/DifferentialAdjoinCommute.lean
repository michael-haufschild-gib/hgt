import GaloisForLFunctions.HTGeometry.AlgebraicIndependentRangeTransfer

/-!
# Iterated differential adjunction is adjunction of the union

Adjoining a second set of differential generators to a differential adjunction produces the same
subfield of the ambient field as adjoining the union of the two generating sets in one step.  The
statement is an equality of carriers rather than of types, which is exactly the form the coefficient
transfer of `AlgebraicIndependentRangeTransfer` consumes; in particular it makes the two adjunction
orders interchangeable.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

theorem differentialJetSet_union {K : Type*} [CommRing K] [Differential K] (A B : Set K) :
    differentialJetSet (A ∪ B) = differentialJetSet A ∪ differentialJetSet B := by
  ext y
  constructor
  · rintro ⟨x, hx | hx, n, rfl⟩
    · exact Or.inl ⟨x, hx, n, rfl⟩
    · exact Or.inr ⟨x, hx, n, rfl⟩
  · rintro (⟨x, hx, n, rfl⟩ | ⟨x, hx, n, rfl⟩)
    · exact ⟨x, Or.inl hx, n, rfl⟩
    · exact ⟨x, Or.inr hx, n, rfl⟩

/-- **Iterated differential adjunction.**  Adjoining `B` over the differential field generated by
`A` fills out the differential field generated by `A ∪ B`. -/
theorem coe_differentialAdjoin_differentialAdjoin {k K : Type*} [Field k] [Field K] [Algebra k K]
    [Differential K] (A B : Set K) :
    (differentialAdjoin (↥(differentialAdjoin k A)) B : Set K)
      = (differentialAdjoin k (A ∪ B) : Set K) := by
  have hjet : differentialJetSet (A ∪ B) = differentialJetSet A ∪ differentialJetSet B :=
    differentialJetSet_union A B
  have hAsub : differentialJetSet A ⊆ (differentialAdjoin k (A ∪ B) : Set K) := by
    intro y hy
    exact IntermediateField.subset_adjoin k _ (by rw [hjet]; exact Or.inl hy)
  have hBsub : differentialJetSet B ⊆ (differentialAdjoin k (A ∪ B) : Set K) := by
    intro y hy
    exact IntermediateField.subset_adjoin k _ (by rw [hjet]; exact Or.inr hy)
  have hDE : differentialAdjoin k A ≤ differentialAdjoin k (A ∪ B) :=
    IntermediateField.adjoin_le_iff.mpr hAsub
  refine Set.Subset.antisymm ?_ ?_
  · have h1 : differentialAdjoin (↥(differentialAdjoin k A)) B
        ≤ IntermediateField.extendScalars hDE := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [IntermediateField.coe_extendScalars]
      exact hBsub hy
    have h2 := SetLike.coe_subset_coe.mpr h1
    rwa [IntermediateField.coe_extendScalars] at h2
  · have h1 : differentialAdjoin k (A ∪ B)
        ≤ IntermediateField.restrictScalars k
            (differentialAdjoin (↥(differentialAdjoin k A)) B) := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [IntermediateField.coe_restrictScalars]
      rw [hjet] at hy
      rcases hy with hy | hy
      · have hyD : y ∈ differentialAdjoin k A := IntermediateField.subset_adjoin k _ hy
        have hmem := (differentialAdjoin (↥(differentialAdjoin k A)) B).algebraMap_mem
          (⟨y, hyD⟩ : ↥(differentialAdjoin k A))
        exact hmem
      · exact IntermediateField.subset_adjoin (↥(differentialAdjoin k A)) _ hy
    have h2 := SetLike.coe_subset_coe.mpr h1
    rwa [IntermediateField.coe_restrictScalars] at h2

/-- The two orders of a double differential adjunction fill out the same subfield. -/
theorem coe_differentialAdjoin_comm {k K : Type*} [Field k] [Field K] [Algebra k K]
    [Differential K] (A B : Set K) :
    (differentialAdjoin (↥(differentialAdjoin k A)) B : Set K)
      = (differentialAdjoin (↥(differentialAdjoin k B)) A : Set K) := by
  rw [coe_differentialAdjoin_differentialAdjoin, coe_differentialAdjoin_differentialAdjoin,
    Set.union_comm]

end

end GaloisForLFunctions.HTGeometry
