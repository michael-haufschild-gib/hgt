import GaloisForLFunctions.HTGeometry.ProjectiveCoefficientChartCover
import GaloisForLFunctions.HTGeometry.EvaluationIncidenceFiberIndependence

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

noncomputable section

abbrev projectiveChartCoefficientRing
    {I : Type} (j : I) := MvPolynomial (projectiveChartVar j) ℂ

/-- One universal row equation over an affine projective coefficient chart. -/
def projectiveChartRowPolynomial
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ)) (b : row) :
    MvPolynomial (Fin n) (projectiveChartCoefficientRing j) :=
  ∑ a, MvPolynomial.monomial (exponent a)
    (rowCoefficientPolynomialOf q z (projectiveChartCoefficient j) b a)

@[simp] theorem projectiveChartRowPolynomial_coeff
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ)) (hexponent : Function.Injective exponent)
    (b : row) (a : κ) :
    (projectiveChartRowPolynomial q n z j exponent b).coeff (exponent a) =
      rowCoefficientPolynomialOf q z (projectiveChartCoefficient j) b a := by
  classical
  rw [projectiveChartRowPolynomial, MvPolynomial.coeff_sum]
  simp only [MvPolynomial.coeff_monomial]
  simp [hexponent.eq_iff]

/-- Put each universal row equation in its own packet-variable block. -/
def projectiveChartGlobalRowPolynomial
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ)) (b : row) :
    MvPolynomial (row × Fin n) (projectiveChartCoefficientRing j) :=
  MvPolynomial.rename (Prod.mk b)
    (projectiveChartRowPolynomial q n z j exponent b)

/-- The ideal generated by every row equation in one global affine projective chart. -/
def projectiveChartGlobalIncidenceIdeal
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ)) :
    Ideal (MvPolynomial (row × Fin n) (projectiveChartCoefficientRing j)) :=
  Ideal.span (Set.range
    (projectiveChartGlobalRowPolynomial q n z j exponent))

/-- The genuine global coordinate ring of the evaluation incidence scheme on one affine
projective coefficient chart. -/
abbrev projectiveChartGlobalIncidenceRing
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ)) :=
  MvPolynomial (row × Fin n) (projectiveChartCoefficientRing j) ⧸
    projectiveChartGlobalIncidenceIdeal q n z j exponent

/-- Coefficient evaluation turns the universal chart row polynomial into the literal fixed
coefficient row polynomial. -/
theorem projectiveChartRowPolynomial_map_eval
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ))
    (x : projectiveChartVar j → ℂ) (b : row) :
    MvPolynomial.map (MvPolynomial.eval x)
        (projectiveChartRowPolynomial q n z j exponent b) =
      coefficientRowPolynomial q exponent (projectiveChartHomogenize j x) (z b) := by
  classical
  unfold projectiveChartRowPolynomial coefficientRowPolynomial
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro a ha
  rw [MvPolynomial.map_monomial]
  congr 1
  rw [rowCoefficientPolynomialOf_projectiveChart_eval]
  apply Finset.sum_congr rfl
  intro d hd
  ring

/-- Point evaluation of a global chart equation is exactly the manuscript's row equation on the
corresponding packet block. -/
theorem projectiveChartGlobalRowPolynomial_eval
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ))
    (x : projectiveChartVar j → ℂ) (y : row × Fin n → ℂ) (b : row) :
    MvPolynomial.eval₂ (MvPolynomial.eval x) y
        (projectiveChartGlobalRowPolynomial q n z j exponent b) =
      MvPolynomial.eval (fun k => y (b, k))
        (coefficientRowPolynomial q exponent (projectiveChartHomogenize j x) (z b)) := by
  rw [projectiveChartGlobalRowPolynomial, MvPolynomial.eval₂_rename]
  rw [MvPolynomial.eval₂_eq_eval_map, projectiveChartRowPolynomial_map_eval]
  congr 1

theorem coefficientRowPolynomial_eval_expansion
    {κ σ : Type} [Fintype κ]
    (q : ℕ) (exponent : κ → (σ →₀ ℕ))
    (c : κ × Fin (q + 1) → ℂ) (z : ℂ) (u : σ → ℂ) :
    MvPolynomial.eval u (coefficientRowPolynomial q exponent c z) =
      ∑ a, (∑ d, c (a, d) * z ^ (d : ℕ)) *
        (exponent a).prod (fun k e => u k ^ e) := by
  classical
  unfold coefficientRowPolynomial
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro a ha
  rw [MvPolynomial.eval_monomial]

def IsProjectiveChartIncidencePoint
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ))
    (x : projectiveChartVar j → ℂ) (y : row × Fin n → ℂ) : Prop :=
  ∀ b, MvPolynomial.eval₂ (MvPolynomial.eval x) y
    (projectiveChartGlobalRowPolynomial q n z j exponent b) = 0

/-- The zero locus of the global chart ideal is exactly the projectivized null-vector incidence
system from the evaluation-codimension lemma. -/
theorem isProjectiveChartIncidencePoint_iff
    {row κ : Type} [Fintype κ] [DecidableEq κ]
    (q n : ℕ) (z : row → ℂ) (j : κ × Fin (q + 1))
    (exponent : κ → (Fin n →₀ ℕ))
    (x : projectiveChartVar j → ℂ) (y : row × Fin n → ℂ) :
    IsProjectiveChartIncidencePoint q n z j exponent x y ↔
      ∀ b, ∑ a, (∑ d, projectiveChartHomogenize j x (a, d) * z b ^ (d : ℕ)) *
          (exponent a).prod (fun k e => y (b, k) ^ e) = 0 := by
  unfold IsProjectiveChartIncidencePoint
  apply forall_congr'
  intro b
  rw [projectiveChartGlobalRowPolynomial_eval,
    coefficientRowPolynomial_eval_expansion]

end
end GaloisForLFunctions.HTGeometry
