import GaloisForLFunctions.HTGeometry.ClunieDerivativeField
import GaloisForLFunctions.HTGeometry.MultivariateEvalCharacteristic
import GaloisForLFunctions.HTGeometry.ZeroFreeRadius

/-!
# A composition is transcendental over the jet field of its inner factor

An algebraic relation for `f ∘ g` over the field generated by `z` and finitely many derivatives of
`g` would bound the characteristic of `f ∘ g` by a fixed multiple of the characteristics of those
derivatives, plus a logarithm.  That contradicts the composition growth theorem.

The top coefficient of the relation is only assumed not to vanish identically; the finitely many
radii whose circle carries one of its zeros form a null set, which the good radii avoid.
-/

namespace GaloisForLFunctions.HTGeometry

open Complex Metric Real Set Filter ValueDistribution MeromorphicOn

/-- **The composition is transcendental over the jet field of the inner function.** -/
theorem not_algebraic_comp_over_jet {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g)
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    {n N : ℕ} (hN : 1 ≤ N) (A : ℕ → MvPolynomial (Fin (n + 2)) ℂ)
    (htop : ∃ w : ℂ, MvPolynomial.eval
      (Fin.cons w (fun j : Fin (n + 1) => iteratedDeriv (j : ℕ) g w)) (A N) ≠ 0)
    (hrel : ∀ z : ℂ, ∑ i ∈ Finset.range (N + 1),
      MvPolynomial.eval (Fin.cons z (fun j : Fin (n + 1) => iteratedDeriv (j : ℕ) g z)) (A i)
        * (f (g z)) ^ i = 0) :
    False := by
  classical
  set G : Fin (n + 1) → ℂ → ℂ := fun j => iteratedDeriv (j : ℕ) g with hG
  have hGan : ∀ j, AnalyticOnNhd ℂ (G j) (Set.univ : Set ℂ) := by
    intro j x _
    exact (differentiable_iteratedDeriv_entire hg (j : ℕ)).analyticAt x
  set a : ℕ → ℂ → ℂ :=
    fun i z => MvPolynomial.eval (Fin.cons z (fun j : Fin (n + 1) => G j z)) (A i) with ha
  have haan : ∀ i, AnalyticOnNhd ℂ (a i) (Set.univ : Set ℂ) :=
    fun i => analyticOnNhd_eval_cons (A i) hGan
  have ham : ∀ i, Meromorphic (a i) :=
    fun i z => (haan i z (Set.mem_univ z)).meromorphicAt
  have hcomp : Differentiable ℂ fun w => f (g w) := fun x => (hf (g x)).comp x (hg x)
  have hcompan : AnalyticOnNhd ℂ (fun w => f (g w)) (Set.univ : Set ℂ) :=
    fun x _ => (hcomp x).analyticAt
  have hcompm : Meromorphic (fun w => f (g w)) := fun z => (hcomp z).meromorphicAt
  -- the top coefficient is not identically zero, so its zero set is countable
  have hadiff : Differentiable ℂ (a N) := fun x => (haan N x (Set.mem_univ x)).differentiableAt
  have haorder : ∀ z, meromorphicOrderAt (a N) z ≠ ⊤ := by
    intro z hcon
    obtain ⟨w, hw⟩ := htop
    refine hw ?_
    have hfan : AnalyticOnNhd ℂ (a N) Set.univ := haan N
    rw [meromorphicOrderAt_eq_top_iff] at hcon
    have hall := hfan.eqOn_zero_of_preconnected_of_frequently_eq_zero isPreconnected_univ
      (Set.mem_univ z) hcon.frequently
    have h := hall (Set.mem_univ w)
    simpa [ha, hG] using h
  have hcount : {z : ℂ | a N z = 0}.Countable := countable_zeroSet hadiff haorder
  set Z : Set ℝ := (fun z : ℂ => ‖z‖) '' {z : ℂ | a N z = 0} with hZdef
  have hZ : MeasureTheory.volume Z = 0 := (hcount.image _).measure_zero _
  -- the algebraic bound
  obtain ⟨K, hK0, hKb⟩ : ∃ K : ℝ, 0 ≤ K ∧ ∀ i, i ≤ N → ∀ r : ℝ, 1 ≤ r →
      characteristic (a i) ⊤ r
        ≤ K * (Real.log r + ∑ j, characteristic (G j) ⊤ r) + K := by
    have hex : ∀ i : Fin (N + 1), ∃ K : ℝ, 0 ≤ K ∧ ∀ r : ℝ, 1 ≤ r →
        characteristic (a (i : ℕ)) ⊤ r
          ≤ K * (Real.log r + ∑ j, characteristic (G j) ⊤ r) + K :=
      fun i => exists_characteristic_eval_le (A (i : ℕ)) hGan
    choose Ki hKi0 hKib using hex
    refine ⟨∑ i : Fin (N + 1), Ki i, Finset.sum_nonneg fun i _ => hKi0 i, ?_⟩
    intro i hi r hr
    have hmem : (⟨i, by omega⟩ : Fin (N + 1)) ∈ (Finset.univ : Finset (Fin (N + 1))) :=
      Finset.mem_univ _
    have hle : Ki ⟨i, by omega⟩ ≤ ∑ ii : Fin (N + 1), Ki ii :=
      Finset.single_le_sum (fun ii _ => hKi0 ii) hmem
    have hb := hKib ⟨i, by omega⟩ r hr
    have hX : 0 ≤ Real.log r + ∑ j, characteristic (G j) ⊤ r := by
      have h1 : 0 ≤ Real.log r := Real.log_nonneg hr
      have h2 : 0 ≤ ∑ j, characteristic (G j) ⊤ r :=
        Finset.sum_nonneg fun j _ => ValueDistribution.characteristic_nonneg hr
      linarith
    simp only at hb
    nlinarith [hb, hle, hX]
  -- the resulting bound on the characteristic of the composition
  set Cn : ℝ := max |Real.log ‖a N 0‖|
    |Real.log ‖meromorphicTrailingCoeffAt (a N) 0‖| with hCn
  refine not_eventually_characteristic_comp_le_jet hf hg hfnp hgnp n
    (2 * (N : ℝ) * K) (Real.log N + 2 * (N : ℝ) * K + (N : ℝ) * Cn) hZ ?_
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with r hr hrZ
  have hcirc : ∀ z ∈ Metric.sphere (0 : ℂ) |r|, a N z ≠ 0 := by
    intro z hz hcon
    refine hrZ ?_
    have hzn : ‖z‖ = |r| := by simpa using mem_sphere_zero_iff_norm.mp hz
    have habs : |r| = r := abs_of_nonneg (by linarith)
    rw [habs] at hzn
    exact ⟨z, hcon, hzn⟩
  have hroot := proximity_le_of_root_characteristic_top hN hr hcompm ham hcirc hrel
  have hTeq : characteristic (fun w => f (g w)) ⊤ r
      = proximity (fun w => f (g w)) ⊤ r := by
    rw [GaloisForLFunctions.Nevanlinna.characteristic_top_eq_proximity_of_analyticOnNhd hcompan]
  have hsum : ∑ i ∈ Finset.range N,
      (characteristic (a i) ⊤ r + characteristic (a N) ⊤ r + Cn)
      ≤ (N : ℝ) * (2 * (K * (Real.log r + ∑ j, characteristic (G j) ⊤ r) + K) + Cn) := by
    have hb : ∀ i ∈ Finset.range N,
        characteristic (a i) ⊤ r + characteristic (a N) ⊤ r + Cn
          ≤ 2 * (K * (Real.log r + ∑ j, characteristic (G j) ⊤ r) + K) + Cn := by
      intro i hi
      have hiN : i ≤ N := le_of_lt (Finset.mem_range.mp hi)
      have h1 := hKb i hiN r hr
      have h2 := hKb N (le_refl N) r hr
      linarith
    have h := Finset.sum_le_sum hb
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul] at h
    exact h
  have hjetsum : ∑ j : Fin (n + 1), characteristic (G j) ⊤ r
      = ∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ r := by
    rw [Fin.sum_univ_eq_sum_range (fun j => characteristic (iteratedDeriv j g) ⊤ r) (n + 1)]
  rw [hTeq]
  rw [hjetsum] at hsum
  have hlog0 : 0 ≤ Real.log r := Real.log_nonneg hr
  have hKlog : 0 ≤ (N : ℝ) := Nat.cast_nonneg _
  nlinarith [hroot, hsum, hlog0, hK0, hKlog]

end GaloisForLFunctions.HTGeometry
