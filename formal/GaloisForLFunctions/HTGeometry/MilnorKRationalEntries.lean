import GaloisForLFunctions.HTGeometry.MilnorKStageCriterion
import GaloisForLFunctions.HTGeometry.MilnorKTateEuclid

/-!
# Symbols with rational entries are torsion in every field of characteristic zero

Tate's theorem — formalized in this corpus — says `K₂^M(ℚ)` is torsion.  Functoriality of Milnor
`K`-theory is an additive map, so it carries torsion to torsion.  Consequently, in **any** field of
characteristic zero the symbols whose entries come from the prime field are torsion, and more
generally the symbols coming from any field whose degree-two Milnor group is torsion.

For a number field this disposes of an infinite family of symbols unconditionally: `{a, b}` is
torsion whenever `a` and `b` are nonzero rationals, whatever the field they are viewed in.  Combined
with `milnorSym2_mem_torsion_of_dependent` and the cyclotomic engine, this is the largest supply of
provably torsion symbols the corpus currently owns.

* `milnorKDegMap_mem_torsion` : functoriality preserves torsion.
* `milnorKDegMap_milnorSym2` : the induced map on symbols.
* `symbolSubgroup_range_le_torsion_of_torsion` : **the symbols coming from a field with torsion
  `K₂^M` are torsion.**
* `milnorSym2_rat_mem_torsion` : **symbols with rational entries are torsion in characteristic
  zero.**
-/

namespace GaloisForLFunctions.HTGeometry

section Transport

variable {F E : Type*} [Field F] [Field E]

/-- Functoriality of Milnor `K`-theory preserves torsion. -/
theorem milnorKDegMap_mem_torsion (f : F →+* E) (n : ℕ)
    {x : MilnorKDeg F n} (hx : x ∈ torsionAddSubgroup (MilnorKDeg F n)) :
    milnorKDegMap f n x ∈ torsionAddSubgroup (MilnorKDeg E n) := by
  obtain ⟨m, hm, hmx⟩ := hx
  refine ⟨m, hm, ?_⟩
  rw [← map_zsmul, hmx, map_zero]

/-- The induced map sends the degree-two symbol to the symbol of the images. -/
theorem milnorKDegMap_milnorSym2 (f : F →+* E) (a b : Fˣ) :
    milnorKDegMap f 2 (milnorSym2 F a b)
      = milnorSym2 E (milnorUnitMap f a) (milnorUnitMap f b) := by
  rw [milnorSym2, milnorKDegMap_class]
  rfl

/-- **If `K₂^M(F)` is torsion then so is everything in `K₂^M(E)` generated by symbols whose entries
come from `F`.** -/
theorem symbolSubgroup_range_le_torsion_of_torsion (f : F →+* E)
    (hF : ∀ x : MilnorKDeg F 2, x ∈ torsionAddSubgroup (MilnorKDeg F 2)) :
    symbolSubgroup E (MonoidHom.range (milnorUnitMap f))
      ≤ torsionAddSubgroup (MilnorKDeg E 2) := by
  refine AddSubgroup.closure_le _ |>.2 ?_
  rintro y ⟨a, ⟨a', rfl⟩, b, ⟨b', rfl⟩, rfl⟩
  rw [← milnorKDegMap_milnorSym2]
  exact milnorKDegMap_mem_torsion f 2 (hF _)

end Transport

section Rational

variable {E : Type*} [Field E]

/-- **Symbols with rational entries are torsion in every field of characteristic zero.**  This is
Tate's theorem transported along the structure map of the prime field. -/
theorem milnorSym2_rat_mem_torsion (f : ℚ →+* E) (a b : ℚˣ) :
    milnorSym2 E (milnorUnitMap f a) (milnorUnitMap f b)
      ∈ torsionAddSubgroup (MilnorKDeg E 2) := by
  rw [← milnorKDegMap_milnorSym2]
  exact milnorKDegMap_mem_torsion f 2 (milnorKDegTwo_rat_torsion _)

/-- **The rational symbols span a torsion subgroup.** -/
theorem symbolSubgroup_rat_le_torsion (f : ℚ →+* E) :
    symbolSubgroup E (MonoidHom.range (milnorUnitMap f))
      ≤ torsionAddSubgroup (MilnorKDeg E 2) :=
  symbolSubgroup_range_le_torsion_of_torsion f milnorKDegTwo_rat_torsion

/-- **Every rational unit is a torsion partner of every rational unit.** -/
theorem rat_mem_torsionPartners (f : ℚ →+* E) (a b : ℚˣ) :
    milnorUnitMap f b ∈ torsionPartners E (milnorUnitMap f a) :=
  milnorSym2_rat_mem_torsion f a b

end Rational

end GaloisForLFunctions.HTGeometry
