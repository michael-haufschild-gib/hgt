import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.RingTheory.Algebraic.Integral
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The field generated by a set is algebraic over the ring generated by it

Inside a field, every element of `IntermediateField.adjoin F S` is a quotient of two elements of
`Algebra.adjoin F S`, hence satisfies a linear polynomial over that ring: the field generated by `S`
is algebraic over the ring generated by `S`.

This is the bridge between the two adjunctions.  Transcendence statements produced by mathlib's
algebraic-independence API are over the *ring* `Algebra.adjoin`, while a differential-field argument
naturally works over the *field* `IntermediateField.adjoin`; with this lemma the two are
interchangeable, by transitivity of algebraicity.
-/

namespace GaloisForLFunctions

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

/-- **Every element of the generated field is algebraic over the generated ring.** -/
theorem isAlgebraic_algebraAdjoin_of_mem_intermediateField_adjoin (S : Set K) {x : K}
    (hx : x ∈ IntermediateField.adjoin F S) : IsAlgebraic (Algebra.adjoin F S) x := by
  classical
  obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hx
  by_cases hs0 : s = 0
  · subst hs0
    have hzero : r / (0 : K) = 0 := by simp
    rw [hzero]
    exact isAlgebraic_zero
  · refine ⟨Polynomial.C (⟨s, hs⟩ : Algebra.adjoin F S) * Polynomial.X
      - Polynomial.C (⟨r, hr⟩ : Algebra.adjoin F S), ?_, ?_⟩
    · intro h
      have hcoeff := congrArg (fun p : Polynomial (Algebra.adjoin F S) => p.coeff 1) h
      simp at hcoeff
      exact hs0 (congrArg Subtype.val hcoeff)
    · have hsK : (algebraMap (Algebra.adjoin F S) K ⟨s, hs⟩) = s := rfl
      have hrK : (algebraMap (Algebra.adjoin F S) K ⟨r, hr⟩) = r := rfl
      simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, hsK, hrK]
      have hcancel : s * (r / s) = r := by
        rw [mul_comm, div_mul_cancel₀ _ hs0]
      rw [hcancel, sub_self]

end GaloisForLFunctions

namespace GaloisForLFunctions

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

/-- **Algebraicity over the generated ring and over the generated field agree.** -/
theorem isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateField (S : Set K) {a : K}
    (h : IsAlgebraic (IntermediateField.adjoin F S) a) :
    IsAlgebraic (Algebra.adjoin F S) a := by
  classical
  letI : Algebra ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S) :=
    ((Subalgebra.inclusion
      (IntermediateField.algebra_adjoin_le_adjoin F S)).toRingHom).toAlgebra
  haveI : IsScalarTower ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S) K :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : Algebra.IsAlgebraic ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S) := by
    refine ⟨fun x => ?_⟩
    have hx : IsAlgebraic (Algebra.adjoin F S) ((x : K)) :=
      isAlgebraic_algebraAdjoin_of_mem_intermediateField_adjoin S x.2
    have hinj : Function.Injective
        (algebraMap ↥(IntermediateField.adjoin F S) K) := Subtype.val_injective
    obtain ⟨p, hp0, hp⟩ := hx
    refine ⟨p, hp0, hinj ?_⟩
    rw [map_zero, ← hp]
    exact (Polynomial.aeval_algebraMap_apply K x p).symm
  exact h.restrictScalars _

end GaloisForLFunctions

namespace GaloisForLFunctions

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

/-- Algebraicity over the generated ring implies algebraicity over the generated field. -/
theorem isAlgebraic_intermediateField_of_isAlgebraic_algebraAdjoin (S : Set K) {a : K}
    (h : IsAlgebraic (Algebra.adjoin F S) a) :
    IsAlgebraic (IntermediateField.adjoin F S) a := by
  classical
  letI : Algebra ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S) :=
    ((Subalgebra.inclusion
      (IntermediateField.algebra_adjoin_le_adjoin F S)).toRingHom).toAlgebra
  haveI : IsScalarTower ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S) K :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  obtain ⟨p, hp0, hp⟩ := h
  refine ⟨p.map (algebraMap ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S)), ?_, ?_⟩
  · have hinj : Function.Injective
        (algebraMap ↥(Algebra.adjoin F S) ↥(IntermediateField.adjoin F S)) := by
      intro y z hyz
      have h : (y : K) = (z : K) :=
        congrArg (fun t : ↥(IntermediateField.adjoin F S) => (t : K)) hyz
      exact Subtype.ext h
    intro hmap
    exact hp0 (Polynomial.map_injective _ hinj (by rw [hmap, Polynomial.map_zero]))
  · rw [Polynomial.aeval_map_algebraMap]
    exact hp

/-- **Transcendence over the generated ring and over the generated field agree.** -/
theorem transcendental_algebraAdjoin_iff (S : Set K) (a : K) :
    Transcendental (Algebra.adjoin F S) a ↔ Transcendental (IntermediateField.adjoin F S) a := by
  constructor
  · intro h halg
    exact h (isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateField S halg)
  · intro h halg
    exact h (isAlgebraic_intermediateField_of_isAlgebraic_algebraAdjoin S halg)

end GaloisForLFunctions
