import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape
import GaloisForLFunctions.HTGeometry.KummerDegreeBound

/-!
# The differential field of an element over the differential field of its power

Adjoining an element to the differential field generated by its `N`-th power gives a field that is
already closed under the derivation: the derivative of the power exhibits the derivative of the
element as a quotient inside the adjunction.  Hence the differential field generated by the element
is contained in a single algebraic adjunction, radical of exponent `N`.

This is the field-theoretic content of a multiplication-by-`N` isogeny protocol: the prefix pullback
is the differential field of the `N`-th power, and the extension degree is at most `N`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open IntermediateField

noncomputable section

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

/-- **Adjoining an element to the differential field of its power is derivation closed.** -/
theorem derivationClosed_adjoin_of_pow (g : E) (hg : g ≠ 0) {N : ℕ} (hN : 0 < N) :
    DerivationClosed (IntermediateField.adjoin
      (↥(differentialAdjoin C ({g ^ N} : Set E))) ({g} : Set E)) := by
  classical
  letI : Differential ↥(differentialAdjoin C ({g ^ N} : Set E)) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C _)
  letI : DifferentialAlgebra ↥(differentialAdjoin C ({g ^ N} : Set E)) E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C ({g ^ N} : Set E)) c⟩
  have hrange : ({g} : Set E) = Set.range (fun _ : Unit => g) := by
    simp
  rw [hrange]
  refine derivationClosed_adjoin_range_of_deriv_mem (fun _ : Unit => g) ?_
  intro _
  -- the derivative of the power lies in the base, and it is `N * g^(N-1) * g'`
  have hpow : (g ^ N)′ = (N : E) * g ^ (N - 1) * g′ := by
    have h := Differential.deriv.leibniz_pow (a := g) N
    simp only [nsmul_eq_mul, smul_eq_mul] at h
    rw [h]
    ring
  have hbase : (g ^ N)′ ∈ differentialAdjoin C ({g ^ N} : Set E) :=
    derivationClosed_differentialAdjoin C _ (subset_differentialAdjoin C _ rfl)
  have hNne : (N : E) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hgpow : g ^ (N - 1) ≠ 0 := pow_ne_zero _ hg
  have hsolve : g′ = (g ^ N)′ * ((N : E) * g ^ (N - 1))⁻¹ := by
    rw [hpow]
    field_simp
  rw [hsolve]
  refine mul_mem ?_ ?_
  · exact IntermediateField.algebraMap_mem
      (IntermediateField.adjoin (↥(differentialAdjoin C ({g ^ N} : Set E)))
        (Set.range fun _ : Unit => g))
      (⟨(g ^ N)′, hbase⟩ : ↥(differentialAdjoin C ({g ^ N} : Set E)))
  · refine inv_mem (mul_mem ?_ ?_)
    · exact IntermediateField.algebraMap_mem
        (IntermediateField.adjoin (↥(differentialAdjoin C ({g ^ N} : Set E)))
          (Set.range fun _ : Unit => g))
        ((N : ↥(differentialAdjoin C ({g ^ N} : Set E))))
    · have hmem : g ∈ Set.range (fun _ : Unit => g) := ⟨(), rfl⟩
      exact pow_mem (IntermediateField.subset_adjoin _ _ hmem) _

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
/-- **The radical degree bound.**  Adjoining an element to the differential field of its `N`-th power
has degree at most `N`. -/
theorem finrank_adjoin_pow_le (g : E) {N : ℕ} (hN : 0 < N) :
    Module.finrank (↥(differentialAdjoin C ({g ^ N} : Set E)))
      (↥((↥(differentialAdjoin C ({g ^ N} : Set E)))⟮g⟯)) ≤ N := by
  have hmem : g ^ N ∈ differentialAdjoin C ({g ^ N} : Set E) :=
    subset_differentialAdjoin C _ rfl
  exact finrank_adjoin_le_of_pow_mem (α := g)
    (c := (⟨g ^ N, hmem⟩ : ↥(differentialAdjoin C ({g ^ N} : Set E)))) hN rfl


/-- **The differential field of an element sits in a radical extension of the differential field of
its power.**  Every jet of the element lies in the adjunction, by induction from derivation
closedness; no minimality principle for the differential adjunction is needed. -/
theorem differentialAdjoin_le_adjoin_pow (g : E) (hg : g ≠ 0) {N : ℕ} (hN : 0 < N) :
    differentialAdjoin C ({g} : Set E) ≤
      ((↥(differentialAdjoin C ({g ^ N} : Set E)))⟮g⟯).restrictScalars C := by
  rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
  rintro y ⟨x, hx, n, rfl⟩
  have hxg : x = g := hx
  rw [hxg]
  show differentialJet n g ∈ (↥(differentialAdjoin C ({g ^ N} : Set E)))⟮g⟯
  induction n with
  | zero => simpa using IntermediateField.mem_adjoin_simple_self _ g
  | succ n ih =>
      rw [differentialJet_succ]
      exact derivationClosed_adjoin_of_pow g hg hN ih

end

end GaloisForLFunctions.HTGeometry
