import GaloisForLFunctions.HTGeometry.ProjectiveHorizonGeneralMinor

/-!
# The horizon field of a covector span, explicitly

The horizon field of a span is the intersection of the horizon fields of its elementary summands,
and each of those is now known exactly.  Combining the two gives a description of `mathcal I_S` with
no reference to the observer group:

`mathcal I_S = intersection_(i in S) C(X_(i,l) : l)(x_k^(m) : k ≠ i, m ≥ 1)`.

For the empty span this reads `mathcal I_0 = F`, the whole jet field, since the observer group is
then generated by no transvections at all.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

noncomputable section

variable {n : Type*} [Fintype n] [DecidableEq n] {K : Type*} [Field K]

/-- With no covector imposed there is no observer, so every jet observable survives. -/
theorem horizonField_empty : horizonField (K := K) (∅ : Set n) = ⊤ := by
  refine le_antisymm le_top ?_
  intro f _
  rw [mem_horizonField_iff]
  rintro g ⟨k, hk, -⟩
  exact absurd hk (Set.notMem_empty k)

/-- Adjoining a direction to a span intersects the horizon fields. -/
theorem horizonField_insert (i : n) (s : Set n) :
    horizonField (K := K) (insert i s) =
      horizonField (K := K) {i} ⊓ horizonField (K := K) s := by
  rw [Set.insert_eq, horizonField_union]

/-- **The horizon field of a span, explicitly.**  It is the intersection over the directions of the
span of the elementary chart fields: the tower of each chart denominator together with the
positive-order jets of that chart. -/
theorem horizonField_finset_eq [CharZero K] (s : Finset n) :
    horizonField (K := K) (↑s : Set n) =
      s.inf fun i => IntermediateField.adjoin K (chartHorizonGenerators i K) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      rw [Finset.coe_empty, horizonField_empty, Finset.inf_empty]
  | insert i s _ ih =>
      rw [Finset.coe_insert, horizonField_insert, horizonField_singleton_eq, ih,
        Finset.inf_insert]

/-- The horizon field of a nonempty span is a proper subfield. -/
theorem horizonField_finset_ne_top [CharZero K] [Nontrivial n] {s : Finset n}
    (hs : s.Nonempty) : horizonField (K := K) (↑s : Set n) ≠ ⊤ := by
  obtain ⟨i, hi⟩ := hs
  intro hcon
  refine horizonField_singleton_ne_top (K := K) i ?_
  refine le_antisymm le_top ?_
  rw [← hcon]
  exact horizonField_antitone (Set.singleton_subset_iff.2 (Finset.mem_coe.2 hi))

end

end GaloisForLFunctions.HTGeometry
