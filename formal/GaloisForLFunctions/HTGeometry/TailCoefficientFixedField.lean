import GaloisForLFunctions.HTGeometry.TailFixedField
import GaloisForLFunctions.HTGeometry.TailParameterField

/-!
# The coefficient field inside the fixed field

The deck transformations are algebra maps over the constants and fix every tail coefficient, so the
field generated by the tail coefficients lies inside the fixed field of the deck group.

Artin's theorem computes the degree of the function field over the fixed field, so the coefficient
field has at least that degree beneath it.  That is the lower bound on the degree of the parameter
field over the coefficient field.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] {n : ℕ}

/-- **The action on the fraction field extends the action on the polynomial ring.** -/
theorem deck_smul_algebraMap (g : deckGroup K n) (p : MvPolynomial (Fin n) K) :
    g • (algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)) p) =
      algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)) (g • p) := by
  have h := smul_distrib_smul g p (1 : FractionRing (MvPolynomial (Fin n) K))
  rwa [smul_one, Algebra.smul_def, Algebra.smul_def, mul_one, mul_one] at h

theorem deck_smul_C (g : deckGroup K n) (a : K) :
    g • (MvPolynomial.C a : MvPolynomial (Fin n) K) = MvPolynomial.C a := by
  obtain ⟨u, hu⟩ := g.2
  rw [deckGroup_smul, ← hu]
  exact varScaleHom_C _ a

/-- The fixed field of the deck group, as an intermediate field over the constants. -/
noncomputable def deckFixedField (K : Type*) [Field K] (n : ℕ) :
    IntermediateField K (FractionRing (MvPolynomial (Fin n) K)) :=
  Subfield.toIntermediateField
    (FixedPoints.subfield (deckGroup K n) (FractionRing (MvPolynomial (Fin n) K)))
    (by
      intro a g
      have hscalar : algebraMap K (FractionRing (MvPolynomial (Fin n) K)) a =
          algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (MvPolynomial.C a) := by
        rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin n) K)
          (FractionRing (MvPolynomial (Fin n) K)), MvPolynomial.algebraMap_eq]
      rw [hscalar, deck_smul_algebraMap, deck_smul_C])

/-- The field generated over the constants by the tail coefficients alone. -/
noncomputable def tailCoeffField (K : Type*) [Field K] (n : ℕ) :
    IntermediateField K (FractionRing (MvPolynomial (Fin n) K)) :=
  IntermediateField.adjoin K
    (Set.range (fun j : Fin n =>
      algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (tailCoeff K n j)))

/-- **The coefficient field lies inside the fixed field.** -/
theorem tailCoeffField_le_deckFixedField :
    tailCoeffField K n ≤ deckFixedField K n := by
  rw [tailCoeffField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨j, rfl⟩
  exact algebraMap_tailCoeff_mem_fixedField j

/-- **The degree of the function field over the fixed field.** -/
theorem finrank_deckFixedField [Fintype (deckGroup K n)] :
    Module.finrank (deckFixedField K n) (FractionRing (MvPolynomial (Fin n) K)) =
      Fintype.card (deckGroup K n) :=
  finrank_fixedField_deckGroup

end GaloisForLFunctions.HTGeometry
