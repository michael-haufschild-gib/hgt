import GaloisForLFunctions.HTGeometry.TorusInvariantMonomials
import GaloisForLFunctions.HTGeometry.RationalRankFromIntegralRank
import GaloisForLFunctions.HTGeometry.CharacterLatticeFrequencyRank
import GaloisForLFunctions.HTGeometry.KummerDegreeBound
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg

/-!
# Algebraicity and rank of fields generated by Laurent monomials

An integer relation among exponent vectors becomes a multiplicative relation
among their Laurent monomials.  A rational exponent-span relation clears to a
positive integral power relation, hence makes the corresponding monomial
integral over the field generated by a rational basis of exponent vectors.

For a finite exponent family, all monomials therefore lie in a relative
algebraic closure whose transcendence degree is bounded exactly by the rational
rank of the exponent span.  This is the toric upper-bound engine for
active-character differential-aperture arguments.
-/

open Set

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F E ι : Type} {r : ℕ} [Field F] [Field E] [Algebra F E]

/-- Integer scaling of an exponent becomes an integer power of its Laurent monomial. -/
theorem laurentMonomial_zsmul (x : Fin r → E)
    (a : ℤ) (m : Fin r → ℤ) :
    laurentMonomial x (a • m) = (laurentMonomial x m) ^ a := by
  simp only [laurentMonomial, Pi.smul_apply, smul_eq_mul]
  rw [← Finset.prod_zpow]
  apply Finset.prod_congr rfl
  intro i _
  rw [mul_comm, zpow_mul]

/-- A Laurent monomial whose exponent belongs to an integer span lies in the
field generated by the spanning monomials. -/
theorem laurentMonomial_mem_adjoin_of_mem_span
    (x : Fin r → E) (hx0 : ∀ i, x i ≠ 0)
    (b : ι → (Fin r → ℤ)) {m : Fin r → ℤ}
    (hm : m ∈ Submodule.span ℤ (Set.range b)) :
    laurentMonomial x m ∈
      IntermediateField.adjoin F (Set.range fun i => laurentMonomial x (b i)) := by
  let K := IntermediateField.adjoin F (Set.range fun i => laurentMonomial x (b i))
  refine Submodule.span_induction (p := fun v _ => laurentMonomial x v ∈ K)
    ?_ ?_ ?_ ?_ hm
  · rintro v ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin F (Set.range fun i => laurentMonomial x (b i))
      ⟨i, rfl⟩
  · simp [laurentMonomial, K]
  · intro u v _ _ hu hv
    rw [laurentMonomial_add hx0]
    exact K.mul_mem hu hv
  · intro a v _ hv
    rw [laurentMonomial_zsmul x]
    exact K.pow_mem hv a

/-- Clearing denominators: a rational exponent-span relation becomes an
integer-span relation after multiplying by one positive natural number. -/
theorem exists_nat_smul_mem_span_int
    {B : Set (Fin r → ℤ)} {m : Fin r → ℤ}
    (hm : intCharacterToRat m ∈
      Submodule.span ℚ (intCharacterToRat '' B)) :
    ∃ N : ℕ, 0 < N ∧ (N : ℤ) • m ∈ Submodule.span ℤ B := by
  classical
  obtain ⟨n, q, g, hsum⟩ := Submodule.mem_span_set'.mp hm
  set N : ℕ := ∏ i : Fin n, (q i).den with hN
  have hNpos : 0 < N := Finset.prod_pos fun i _ => (q i).pos
  choose c hc using fun i : Fin n =>
    GaloisForLFunctions.exists_int_nat_mul (q i)
      (Finset.dvd_prod_of_mem (fun i => (q i).den) (Finset.mem_univ i))
  rw [← hN] at hc
  have hg : ∀ i, ∃ b : Fin r → ℤ, b ∈ B ∧ intCharacterToRat b = g i := by
    intro i
    exact g i |>.2
  choose b hbB hb using hg
  refine ⟨N, hNpos, ?_⟩
  have hrat : intCharacterToRat ((N : ℤ) • m) =
      intCharacterToRat (∑ i : Fin n, (c i : ℤ) • b i) := by
    funext j
    have hsumj := congrFun hsum j
    simp only [intCharacterToRat_apply, Pi.smul_apply, smul_eq_mul,
      Finset.sum_apply] at hsumj ⊢
    push_cast
    rw [← hsumj, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    have hci : (c i : ℚ) = (N : ℚ) * q i := (hc i).symm
    rw [← hb i]
    simp only [intCharacterToRat_apply]
    rw [hci]
    ring
  have heq : (N : ℤ) • m = ∑ i : Fin n, (c i : ℤ) • b i :=
    injective_intCharacterToRat hrat
  rw [heq]
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span (hbB i))

/-- A positive integral multiple in the exponent span makes the monomial
integral over the spanning-monomial field. -/
theorem isIntegral_laurentMonomial_of_nat_smul_mem_span
    (x : Fin r → E) (hx0 : ∀ i, x i ≠ 0) (b : ι → (Fin r → ℤ))
    (m : Fin r → ℤ) {N : ℕ} (hN : 0 < N)
    (hm : (N : ℤ) • m ∈ Submodule.span ℤ (Set.range b)) :
    IsIntegral
      (IntermediateField.adjoin F (Set.range fun i => laurentMonomial x (b i)))
      (laurentMonomial x m) := by
  let K := IntermediateField.adjoin F (Set.range fun i => laurentMonomial x (b i))
  have hmem : laurentMonomial x ((N : ℤ) • m) ∈ K :=
    laurentMonomial_mem_adjoin_of_mem_span x hx0 b hm
  let c : K := ⟨laurentMonomial x ((N : ℤ) • m), hmem⟩
  apply isIntegral_of_pow_mem (F := K) (L := E) (c := c) hN
  change laurentMonomial x m ^ N = laurentMonomial x ((N : ℤ) • m)
  rw [laurentMonomial_zsmul x, zpow_natCast]

/-- Rational exponent-span membership makes a Laurent monomial integral over
the field generated by the spanning monomials. -/
theorem isIntegral_laurentMonomial_of_mem_span_rat
    (x : Fin r → E) (hx0 : ∀ i, x i ≠ 0) (b : ι → (Fin r → ℤ))
    (m : Fin r → ℤ)
    (hm : intCharacterToRat m ∈ Submodule.span ℚ
      (intCharacterToRat '' (Set.range b))) :
    IsIntegral
      (IntermediateField.adjoin F (Set.range fun i => laurentMonomial x (b i)))
      (laurentMonomial x m) := by
  obtain ⟨N, hN, hmN⟩ := exists_nat_smul_mem_span_int hm
  exact isIntegral_laurentMonomial_of_nat_smul_mem_span x hx0 b m hN hmN

/-- A finite Laurent-monomial family lies in an algebraically closed state
field whose transcendence degree is bounded by the rational rank of its
exponent span. -/
theorem exists_laurentMonomial_algebraicClosure_rank_le
    [Fintype ι] (x : Fin r → E) (hx0 : ∀ i, x i ≠ 0)
    (m : ι → (Fin r → ℤ)) :
    ∃ K : IntermediateField F E,
      Algebra.trdeg F K ≤ Module.rank ℚ
        (Submodule.span ℚ (intCharacterToRat '' Set.range m)) ∧
      ∀ i, laurentMonomial x (m i) ∈ K := by
  classical
  let S : Set (Fin r → ℚ) := intCharacterToRat '' Set.range m
  obtain ⟨B, hBS, hspan, hind⟩ := exists_linearIndependent ℚ S
  have hBfin : B.Finite := by
    apply (Set.finite_range m).image intCharacterToRat |>.subset
    exact hBS
  letI : Fintype B := hBfin.fintype
  have hchoice : ∀ q : B, ∃ z : Fin r → ℤ,
      z ∈ Set.range m ∧ intCharacterToRat z = (q : Fin r → ℚ) := by
    intro q
    obtain ⟨z, hz, heq⟩ := hBS q.2
    exact ⟨z, hz, heq⟩
  choose b hbRange hbEq using hchoice
  let K0 : IntermediateField F E :=
    IntermediateField.adjoin F (Set.range fun q : B => laurentMonomial x (b q))
  let K : IntermediateField F E := (algebraicClosure K0 E).restrictScalars F
  refine ⟨K, ?_, ?_⟩
  · have htr := trdeg_algebraicClosure_adjoin_range_le
      (K := F) (L := E) (fun q : B => laurentMonomial x (b q))
    change Algebra.trdeg F K ≤ _
    calc
      Algebra.trdeg F K ≤ Cardinal.mk B := htr
      _ = Module.rank ℚ (Submodule.span ℚ S) := by
        rw [← hspan, rank_span_set hind]
      _ = Module.rank ℚ
          (Submodule.span ℚ (intCharacterToRat '' Set.range m)) := rfl
  · intro i
    have himage : intCharacterToRat '' Set.range b = B := by
      ext q
      constructor
      · rintro ⟨z, ⟨j, rfl⟩, rfl⟩
        rw [hbEq]
        exact j.2
      · intro hq
        exact ⟨b ⟨q, hq⟩, ⟨⟨q, hq⟩, rfl⟩, hbEq ⟨q, hq⟩⟩
    have hmSpan : intCharacterToRat (m i) ∈ Submodule.span ℚ B := by
      rw [hspan]
      exact Submodule.subset_span ⟨m i, ⟨i, rfl⟩, rfl⟩
    have hint : IsIntegral K0 (laurentMonomial x (m i)) := by
      apply isIntegral_laurentMonomial_of_mem_span_rat x hx0 b (m i)
      rw [himage]
      exact hmSpan
    change laurentMonomial x (m i) ∈
      (algebraicClosure K0 E).restrictScalars F
    rw [IntermediateField.mem_restrictScalars, mem_algebraicClosure_iff]
    exact hint.isAlgebraic

end

end GaloisForLFunctions.HTGeometry
