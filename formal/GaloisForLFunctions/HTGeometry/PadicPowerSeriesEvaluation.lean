import Mathlib.RingTheory.PowerSeries.Evaluation
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.Analysis.SpecificLimits.Basic

/-!
# Evaluating an integral power series at a small `p`-adic number

A power series with integer coefficients can be evaluated at any `a ∈ ℤ_p` of norm below one, and
the evaluation is a ring homomorphism.  mathlib supplies the evaluation
(`PowerSeries.eval₂Hom`) for a complete separated linearly topologized target; the one missing
ingredient is that `ℤ_p` *is* linearly topologized, which is proved here from the fact that the
closed balls around zero are exactly the ideals generated by powers of `p`.

The consequence is the bridge from formal to arithmetic: an identity between power series with
integer coefficients — in particular `g(t, z(t)) = 0` for a polynomial `g` and a power-series root
`z` — specialises to an identity in `ℤ_p` at every `a` of norm below one.  That is how a formal
Puiseux branch produces genuine `p`-adic roots of the specialised polynomial.
-/

namespace GaloisForLFunctions.HTGeometry

open PowerSeries

variable (p : ℕ) [Fact p.Prime]

/-- The ideals generated by powers of `p` are a neighbourhood basis of zero in `ℤ_p`. -/
theorem hasBasis_nhds_zero_span_pow :
    (nhds (0 : ℤ_[p])).HasBasis (fun _ : ℕ => True)
      (fun n => ((Ideal.span {(p : ℤ_[p]) ^ n} : Ideal ℤ_[p]) : Set ℤ_[p])) := by
  have hp1 : (1 : ℝ) < (p : ℝ) := by
    exact_mod_cast (Fact.out : p.Prime).one_lt
  refine Metric.nhds_basis_closedBall.to_hasBasis ?_ ?_
  · intro ε hε
    obtain ⟨n, hn⟩ : ∃ n : ℕ, ((p : ℝ)⁻¹) ^ n < ε :=
      exists_pow_lt_of_lt_one hε (by
        rw [inv_lt_one_iff₀]
        exact Or.inr hp1)
    refine ⟨n, trivial, fun x hx => ?_⟩
    rw [SetLike.mem_coe, ← PadicInt.norm_le_pow_iff_mem_span_pow] at hx
    simp only [Metric.mem_closedBall, dist_zero_right]
    refine le_trans hx (le_of_lt ?_)
    rwa [zpow_neg, zpow_natCast, ← inv_pow]
  · intro n _
    refine ⟨(p : ℝ) ^ (-(n : ℤ)), zpow_pos (by linarith) _, fun x hx => ?_⟩
    simp only [Metric.mem_closedBall, dist_zero_right] at hx
    rw [SetLike.mem_coe, ← PadicInt.norm_le_pow_iff_mem_span_pow]
    exact hx

instance isLinearTopology_padicInt : IsLinearTopology ℤ_[p] ℤ_[p] :=
  IsLinearTopology.mk_of_hasBasis' _ (hasBasis_nhds_zero_span_pow p)
    (fun I r _ hm => I.mul_mem_left r hm)

/-- An element of norm below one is topologically nilpotent, so power series can be evaluated
at it. -/
theorem hasEval_of_norm_lt_one {a : ℤ_[p]} (ha : ‖a‖ < 1) : PowerSeries.HasEval a := by
  rw [PowerSeries.hasEval_def, IsTopologicallyNilpotent]
  rw [tendsto_zero_iff_norm_tendsto_zero]
  simp only [norm_pow]
  exact tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg a) ha

/-- **Evaluation of an integral power series at a small `p`-adic number**, as a ring
homomorphism. -/
noncomputable def padicEval {a : ℤ_[p]} (ha : ‖a‖ < 1) : PowerSeries ℤ →+* ℤ_[p] :=
  PowerSeries.eval₂Hom (φ := Int.castRingHom ℤ_[p]) continuous_of_discreteTopology
    (hasEval_of_norm_lt_one p ha)

/-- A ring homomorphism commutes with polynomial evaluation. -/
theorem eval_map_of_eval {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (f : Polynomial R) (r : R) :
    φ (f.eval r) = (f.map φ).eval (φ r) := by
  simp [Polynomial.eval_map, Polynomial.eval₂_at_apply]

/-- **A formal root specialises to a `p`-adic root.**  If a polynomial with power-series
coefficients over `ℤ` has a power-series root, then its `p`-adic specialisation has the
specialised root. -/
theorem isRoot_padicEval {a : ℤ_[p]} (ha : ‖a‖ < 1)
    {g : Polynomial (PowerSeries ℤ)} {z : PowerSeries ℤ} (hroot : g.eval z = 0) :
    (g.map (padicEval p ha)).eval (padicEval p ha z) = 0 := by
  rw [← eval_map_of_eval, hroot, map_zero]

end GaloisForLFunctions.HTGeometry
