import GaloisForLFunctions.HTGeometry.RelativeFieldBaseComparison
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg
import GaloisForLFunctions.HTGeometry.CompositionJetTranscendence
import GaloisForLFunctions.HTGeometry.AnalyticMeroPolynomialEval
import GaloisForLFunctions.HTGeometry.AlgebraAdjoinAlgebraic

/-!
# Jet fields of entire functions inside the meromorphic field

The jets of an entire function are elements of the meromorphic function field of the plane, and the
field they generate over the rational coordinate field is the *state field* whose transcendence
degree is the finite-jet rank of the function.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic

/-- The `k`-th jet of an entire function, as an element of the meromorphic field of the plane. -/
def jetElem {f : ℂ → ℂ} (hf : Differentiable ℂ f) (k : ℕ) : meroField (Set.univ : Set ℂ) :=
  analyticMeroElement (iteratedDeriv k f)
    ((differentiable_iteratedDeriv_entire hf k).differentiableOn.analyticOnNhd isOpen_univ)

/-- The state field of the first `n+1` jets. -/
def jetField {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) :
    IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  IntermediateField.adjoin (RatFunc ℂ) (Set.range (fun k : Fin (n + 1) => jetElem hf (k : ℕ)))

/-- The finite jet rank: the transcendence degree of the state field. -/
def jetRank {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) : Cardinal :=
  Algebra.trdeg (RatFunc ℂ) (jetField hf n)

/-- The shadow field of the derivatives of order `1` through `n`. -/
def shadowField {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) :
    IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  IntermediateField.adjoin (RatFunc ℂ) (Set.range (fun k : Fin n => jetElem hf ((k : ℕ) + 1)))

/-- The shadow rank. -/
def shadowRank {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) : Cardinal :=
  Algebra.trdeg (RatFunc ℂ) (shadowField hf n)

/-- The jet rank is at most `n + 1`. -/
theorem jetRank_le {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) :
    jetRank hf n ≤ Cardinal.mk (Fin (n + 1)) :=
  trdeg_intermediateFieldAdjoin_range_le (fun k : Fin (n + 1) => jetElem hf (k : ℕ))

/-- The shadow rank is at most `n`. -/
theorem shadowRank_le {f : ℂ → ℂ} (hf : Differentiable ℂ f) (n : ℕ) :
    shadowRank hf n ≤ Cardinal.mk (Fin n) :=
  trdeg_intermediateFieldAdjoin_range_le (fun k : Fin n => jetElem hf ((k : ℕ) + 1))

/-- The generating family of the jet field over `ℂ`: the coordinate followed by the jets. -/
def jetGenFun {g : ℂ → ℂ} (hg : Differentiable ℂ g) (n : ℕ) : Fin (n + 2) → ℂ → ℂ :=
  Fin.cons (fun z : ℂ => z) (fun k : Fin (n + 1) => iteratedDeriv (k : ℕ) g)

theorem analyticOnNhd_jetGenFun {g : ℂ → ℂ} (hg : Differentiable ℂ g) (n : ℕ) (i : Fin (n + 2)) :
    AnalyticOnNhd ℂ (jetGenFun hg n i) (Set.univ : Set ℂ) := by
  rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
  · simpa [jetGenFun] using (analyticOnNhd_id : AnalyticOnNhd ℂ (fun z : ℂ => z) Set.univ)
  · have heq : jetGenFun hg n j.succ = iteratedDeriv (j : ℕ) g := by
      simp [jetGenFun]
    rw [heq]
    exact (differentiable_iteratedDeriv_entire hg (j : ℕ)).differentiableOn.analyticOnNhd
      isOpen_univ

/-- The generating family inside the meromorphic field. -/
def jetGen {g : ℂ → ℂ} (hg : Differentiable ℂ g) (n : ℕ) (i : Fin (n + 2)) :
    meroField (Set.univ : Set ℂ) :=
  analyticMeroElement (jetGenFun hg n i) (analyticOnNhd_jetGenFun hg n i)

/-- **A composition is transcendental over the field generated by the coordinate and the jets of
its inner factor.** -/
theorem not_isAlgebraic_comp_over_jetGen {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g)
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z) (n : ℕ)
    (hcompan : AnalyticOnNhd ℂ (fun w => f (g w)) (Set.univ : Set ℂ)) :
    ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ (Set.range (jetGen hg n)))
        (analyticMeroElement (fun w => f (g w)) hcompan) := by
  classical
  intro halg
  obtain ⟨p, hp0, hp⟩ :=
    isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateField (Set.range (jetGen hg n)) halg
  -- every coefficient is a polynomial in the generators
  have hcoeff : ∀ i : ℕ, ∃ Q : MvPolynomial (Fin (n + 2)) ℂ,
      ((p.coeff i : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n)))) : meroField (Set.univ : Set ℂ))
        = MvPolynomial.aeval (R := ℂ) (jetGen hg n) Q := by
    intro i
    have hmem : ((p.coeff i : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n))))
        : meroField (Set.univ : Set ℂ)) ∈ Algebra.adjoin ℂ (Set.range (jetGen hg n)) :=
      (p.coeff i).2
    have hmem' : ((p.coeff i : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n))))
        : meroField (Set.univ : Set ℂ)) ∈ (MvPolynomial.aeval (R := ℂ) (jetGen hg n)).range := by
      rw [← Algebra.adjoin_range_eq_range_aeval]
      exact hmem
    obtain ⟨Q, hQ⟩ := hmem'
    exact ⟨Q, hQ.symm⟩
  choose Q hQ using hcoeff
  set N : ℕ := p.natDegree with hNdef
  -- the pointwise family
  have hfamily : ∀ z : ℂ, (fun j => jetGenFun hg n j z)
      = Fin.cons z (fun k : Fin (n + 1) => iteratedDeriv (k : ℕ) g z) := by
    intro z
    funext j
    rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨k, rfl⟩
    · simp [jetGenFun]
    · simp [jetGenFun]
  -- the coefficient functions
  have hQfun : ∀ i : ℕ,
      ((p.coeff i : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n))))
          : meroField (Set.univ : Set ℂ))
        = analyticMeroElement
            (fun z => MvPolynomial.eval (fun j => jetGenFun hg n j z) (Q i))
            (analyticOnNhd_eval_mvPolynomial (jetGenFun hg n) (analyticOnNhd_jetGenFun hg n)
              (Q i)) := by
    intro i
    rw [hQ i, analyticMeroElement_eval_mvPolynomial (jetGenFun hg n)
      (analyticOnNhd_jetGenFun hg n) (Q i)]
    rfl
  -- the relation, as an identity of entire functions
  have hrelfun : ∀ z : ℂ, ∑ i ∈ Finset.range (N + 1),
      MvPolynomial.eval (Fin.cons z (fun k : Fin (n + 1) => iteratedDeriv (k : ℕ) g z)) (Q i)
        * (f (g z)) ^ i = 0 := by
    have hsum := Polynomial.aeval_eq_sum_range (p := p)
      (analyticMeroElement (fun w => f (g w)) hcompan)
    rw [hp] at hsum
    simp only [Algebra.smul_def] at hsum
    set G : ℕ → ℂ → ℂ := fun i z =>
      MvPolynomial.eval (fun j => jetGenFun hg n j z) (Q i) * (f (g z)) ^ i with hGdef
    have hGan : ∀ i, AnalyticOnNhd ℂ (G i) (Set.univ : Set ℂ) := by
      intro i
      rw [hGdef]
      exact (analyticOnNhd_eval_mvPolynomial (jetGenFun hg n) (analyticOnNhd_jetGenFun hg n)
        (Q i)).mul (hcompan.pow i)
    have hSan : AnalyticOnNhd ℂ (fun z => ∑ i ∈ Finset.range (N + 1), G i z)
        (Set.univ : Set ℂ) := by
      have hpi : (fun z => ∑ i ∈ Finset.range (N + 1), G i z)
          = ∑ i ∈ Finset.range (N + 1), G i := by
        funext z
        rw [Finset.sum_apply]
      rw [hpi]
      exact Finset.sum_induction G (fun h => AnalyticOnNhd ℂ h (Set.univ : Set ℂ))
        (fun a b ha hb => ha.add hb) analyticOnNhd_const (fun i _ => hGan i)
    have hterm : ∀ i ∈ Finset.range (N + 1), analyticMeroElement (G i) (hGan i)
        = ((p.coeff i : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n))))
            : meroField (Set.univ : Set ℂ))
          * (analyticMeroElement (fun w => f (g w)) hcompan) ^ i := by
      intro i _
      have hmul : analyticMeroElement (G i) (hGan i)
          = analyticMeroElement
              (fun z => MvPolynomial.eval (fun j => jetGenFun hg n j z) (Q i))
              (analyticOnNhd_eval_mvPolynomial (jetGenFun hg n) (analyticOnNhd_jetGenFun hg n)
                (Q i))
            * analyticMeroElement (fun z => (f (g z)) ^ i) (hcompan.pow i) :=
        analyticMeroElement_mul _ _
      rw [hmul, ← hQfun i, analyticMeroElement_pow]
    have hSzero : analyticMeroElement (fun z => ∑ i ∈ Finset.range (N + 1), G i z) hSan = 0 := by
      rw [analyticMeroElement_finsetSum _ G hGan hSan, Finset.sum_congr rfl hterm]
      exact hsum.symm
    have hzero := (analyticMeroElement_eq_zero_iff hSan).mp hSzero
    intro z
    have h := hzero z (Set.mem_univ z)
    rw [← hfamily z]
    simpa [hGdef] using h
  -- the top coefficient does not vanish identically
  have hleadne : ((p.coeff N : ↥(Algebra.adjoin ℂ (Set.range (jetGen hg n))))
      : meroField (Set.univ : Set ℂ)) ≠ 0 := by
    have hlc : p.coeff N ≠ 0 := by
      rw [hNdef]
      exact Polynomial.leadingCoeff_ne_zero.mpr hp0
    intro hcon
    exact hlc (Subtype.ext hcon)
  have htop : ∃ w : ℂ, MvPolynomial.eval
      (Fin.cons w (fun k : Fin (n + 1) => iteratedDeriv (k : ℕ) g w)) (Q N) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    refine hleadne ?_
    rw [hQfun N]
    refine (analyticMeroElement_eq_zero_iff _).mpr ?_
    intro z _
    rw [hfamily z]
    exact hcon z
  rcases Nat.eq_zero_or_pos N with hN0 | hN1
  · obtain ⟨w, hw⟩ := htop
    refine hw ?_
    have h := hrelfun w
    rw [hN0] at h ⊢
    simpa using h
  · exact not_algebraic_comp_over_jet hf hg hfnp hgnp hN1 Q htop hrelfun

end

end GaloisForLFunctions.HTGeometry
