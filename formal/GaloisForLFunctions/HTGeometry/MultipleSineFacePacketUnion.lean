import GaloisForLFunctions.HTGeometry.MultipleSineAllFaceIndependence
import GaloisForLFunctions.HTGeometry.FaceLayerDescendingUnion

/-!
# The face-packet union of the multiple-sine hierarchy, and its layers

The face packets of the multiple-sine hierarchy are indexed by the deleted directions.  A family of
faces has a packet union, the star of the empty face over a finite family is that union, and the
union of two families splits.  Adjoining one layer at a time to the field generated by the deeper
layers is the descending step of the all-face induction.

The layers themselves are indexed by the number of surviving periods: the boundary faces retain at
most one, and layer `k` retains exactly `k + 2`.
-/

open Filter Set Topology Complex
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open GaloisForLFunctions.MatroidGluing GaloisForLFunctions.MatroidGluing.Rank
open GaloisForLFunctions.MatroidGluing.Meromorphic

noncomputable section

noncomputable local instance mspuDecidableEq :
    DecidableEq (meroField (Set.univ : Set ℂ)) := Classical.decEq _

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The union of the multiple-sine packets of a family of deleted faces. -/
def sineFacePacketUnion (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) (S : Set (Finset ι)) :
    Set (meroField (Set.univ : Set ℂ)) :=
  ⋃ J ∈ S, facePacket ω hω J

theorem faceStar_empty_eq_sineFacePacketUnion (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    (faces : Finset (Finset ι)) :
    faceStar faces (facePacket ω hω) ∅ = sineFacePacketUnion ω hω (↑faces : Set (Finset ι)) := by
  ext y
  simp [faceStar, sineFacePacketUnion]

theorem sineFacePacketUnion_union (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) (S T : Set (Finset ι)) :
    sineFacePacketUnion ω hω (S ∪ T)
      = sineFacePacketUnion ω hω S ∪ sineFacePacketUnion ω hω T := by
  ext y
  simp only [sineFacePacketUnion, Set.mem_iUnion, Set.mem_union, exists_prop]
  constructor
  · rintro ⟨L, hL | hL, hy⟩
    · exact Or.inl ⟨L, hL, hy⟩
    · exact Or.inr ⟨L, hL, hy⟩
  · rintro (⟨L, hL, hy⟩ | ⟨L, hL, hy⟩)
    · exact ⟨L, Or.inl hL, hy⟩
    · exact ⟨L, Or.inr hL, hy⟩

@[simp] theorem sineFacePacketUnion_empty (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) :
    sineFacePacketUnion ω hω (∅ : Set (Finset ι)) = ∅ := by
  simp [sineFacePacketUnion]

/-- **The descending step.**  A layer independent over the field generated by the deeper faces may
be adjoined to them. -/
theorem sineFacePacketUnion_diffIndepOn_union (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    (S T : Set (Finset ι))
    (hdeep : DiffIndepOn ℂ (sineFacePacketUnion ω hω S))
    (hlayer : DiffIndepOn ↥(differentialAdjoin ℂ (sineFacePacketUnion ω hω S))
      (sineFacePacketUnion ω hω T)) :
    DiffIndepOn ℂ (sineFacePacketUnion ω hω (S ∪ T)) := by
  rw [sineFacePacketUnion_union, Set.union_comm]
  exact diffIndepOn_union_of_base hdeep hlayer

/-! ### The face layers -/

/-- Faces below the hypertranscendental range: at most one surviving period. -/
def sineBoundaryFaces (ι : Type) [Fintype ι] [DecidableEq ι] : Set (Finset ι) :=
  {J | (Jᶜ).card < 2}

/-- Faces already installed before layer `k`: their survivor count lies in `[2, k + 1]`. -/
def sineDeeperFaces (ι : Type) [Fintype ι] [DecidableEq ι] (k : ℕ) : Set (Finset ι) :=
  {J | 2 ≤ (Jᶜ).card ∧ (Jᶜ).card < k + 2}

/-- Layer `k` has exactly `k + 2` surviving periods. -/
def sineFaceLayer (ι : Type) [Fintype ι] [DecidableEq ι] (k : ℕ) : Finset (Finset ι) :=
  Finset.univ.filter (fun J => (Jᶜ).card = k + 2)

theorem mem_sineFaceLayer_iff {k : ℕ} (J : Finset ι) :
    J ∈ sineFaceLayer ι k ↔ (Jᶜ).card = k + 2 := by
  rw [sineFaceLayer, Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ J, h⟩⟩

theorem sineFaceLayer_zero_eq_maximalFaces : sineFaceLayer ι 0 = maximalFaces ι := by
  ext J
  rw [mem_sineFaceLayer_iff, mem_maximalFaces_iff]

@[simp] theorem sineDeeperFaces_zero : sineDeeperFaces ι 0 = ∅ := by
  ext J
  simp only [sineDeeperFaces, Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
  omega

theorem sineDeeperFaces_succ (k : ℕ) :
    sineDeeperFaces ι (k + 1)
      = sineDeeperFaces ι k ∪ (↑(sineFaceLayer ι k) : Set (Finset ι)) := by
  ext J
  simp only [sineDeeperFaces, sineFaceLayer, Set.mem_setOf_eq, Set.mem_union, Finset.mem_coe,
    Finset.mem_filter, Finset.mem_univ, true_and]
  omega

theorem sineDeeperFaces_top :
    sineDeeperFaces ι (Fintype.card ι - 1) = {J : Finset ι | 2 ≤ (Jᶜ).card} := by
  ext J
  simp only [sineDeeperFaces, Set.mem_setOf_eq]
  have hcardle : (Jᶜ).card ≤ Fintype.card ι := Finset.card_le_univ _
  exact ⟨fun h => h.1, fun h => ⟨h, by omega⟩⟩

/-- Each face of layer `k` has the same cardinality. -/
theorem card_of_mem_sineFaceLayer {k : ℕ} {J : Finset ι} (hJ : J ∈ sineFaceLayer ι k) :
    J.card = Fintype.card ι - (k + 2) := by
  have hcomp := (mem_sineFaceLayer_iff J).mp hJ
  have htotal := Finset.card_add_card_compl J
  omega

end

end GaloisForLFunctions.HTGeometry
