variable {C T : Type*} [Field C] [Field T] [Algebra C T]

/-- A rational coordinate change preserves the differential field generated by a source. -/
theorem differentialAdjoin_ratFuncAlgEquiv_coordinate
    [Differential C] [Differential T] [DifferentialAlgebra C T]
    (u : T) (htu : Transcendental C u)
    (h : RatFunc C ≃ₐ[C] RatFunc C) :
    let q : T := ((RatFunc.algEquivOfTranscendental u htu (h RatFunc.X) :
      IntermediateField.adjoin C {u}) : T)
    differentialAdjoin C ({q} : Set T) = differentialAdjoin C ({u} : Set T) := by
  let e := RatFunc.algEquivOfTranscendental u htu
  let qL : IntermediateField.adjoin C {u} := e (h RatFunc.X)
  let q : T := qL
  have hXtop : IntermediateField.adjoin C ({h RatFunc.X} : Set (RatFunc C)) = ⊤ := by
    exact RatFunc.algEquiv_adjoin_image_X_eq_top h
  have hqLtop : IntermediateField.adjoin C ({qL} : Set (IntermediateField.adjoin C {u})) = ⊤ := by
    have hmap :
        (IntermediateField.adjoin C ({h RatFunc.X} : Set (RatFunc C))).map e.toAlgHom =
          IntermediateField.adjoin C ({qL} : Set (IntermediateField.adjoin C {u})) := by
      rw [IntermediateField.adjoin_map, Set.image_singleton]
      rfl
    have hetop :
        (⊤ : IntermediateField C (RatFunc C)).map e.toAlgHom = ⊤ := by
      rw [← AlgHom.fieldRange_eq_map]
      exact e.fieldRange_eq_top
    rw [hXtop, hetop] at hmap
    simpa [qL] using hmap.symm
  have hadjoin : IntermediateField.adjoin C ({q} : Set T) =
      IntermediateField.adjoin C ({u} : Set T) := by
    let L := IntermediateField.adjoin C ({u} : Set T)
    have hmap :
        (IntermediateField.adjoin C ({qL} : Set L)).map L.val =
          IntermediateField.adjoin C ({q} : Set T) := by
      rw [IntermediateField.adjoin_map, Set.image_singleton]
      rfl
    have hvaltop : (⊤ : IntermediateField C L).map L.val = L := by
      rw [← AlgHom.fieldRange_eq_map]
      exact IntermediateField.fieldRange_val L
    rw [hqLtop, hvaltop] at hmap
    simpa [L, q, qL] using hmap.symm
  have hadjoin_le_diff (s : Set T) :
      IntermediateField.adjoin C s ≤ differentialAdjoin C s :=
    IntermediateField.adjoin_le_iff.mpr (subset_differentialAdjoin C s)
  have hqmem : q ∈ differentialAdjoin C ({u} : Set T) :=
    hadjoin_le_diff ({u} : Set T)
      (hadjoin.le (IntermediateField.subset_adjoin C ({q} : Set T) rfl))
  have humem : u ∈ differentialAdjoin C ({q} : Set T) :=
    hadjoin_le_diff ({q} : Set T)
      (hadjoin.ge (IntermediateField.subset_adjoin C ({u} : Set T) rfl))
  exact differentialAdjoin_singleton_eq_of_mem_mem hqmem humem

/-- Evaluation intertwines the transported rational-coordinate automorphism with the ambient
automorphism. -/
theorem coe_ratFuncAlgEquivOfAdjoinInvariant
    (sigma : T ≃ₐ[C] T) (u : T) (htu : Transcendental C u)
    (hu : sigma u ∈ IntermediateField.adjoin C {u})
    (huinv : sigma.symm u ∈ IntermediateField.adjoin C {u})
    (r : RatFunc C) :
    ((RatFunc.algEquivOfTranscendental u htu
        (ratFuncAlgEquivOfAdjoinInvariant sigma u htu hu huinv r) :
          IntermediateField.adjoin C {u}) : T) =
      sigma ((RatFunc.algEquivOfTranscendental u htu r :
        IntermediateField.adjoin C {u}) : T) := by
  change ((RatFunc.algEquivOfTranscendental u htu
    ((RatFunc.algEquivOfTranscendental u htu).symm
      (restrictAlgEquivToAdjoinSingleton sigma u hu huinv
        (RatFunc.algEquivOfTranscendental u htu r))) :
          IntermediateField.adjoin C {u}) : T) = _
  rw [AlgEquiv.apply_symm_apply]
  exact restrictAlgEquivToAdjoinSingleton_apply sigma u hu huinv _

variable [Differential C] [Differential T] [DifferentialAlgebra C T]
  [CharZero C] [CharZero T]

/-- Erased branch: the automorphism is trivial and fixes the full field. -/
structure TrivialPersistentGaugeBranch (sigma : DifferentialAlgEquiv C T) : Prop where
  action : sigma.toAlgEquiv = AlgEquiv.refl
  automorphism_order : orderOf sigma.toAlgEquiv = 1
  fixedField : IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) = ⊤
  galoisGroup : ∀ tau : derivationPreservingAut T T, tau = 1

/-- Finite multiplicative branch, including exact fixed field, radical reconstruction, boundary
hypertranscendence, and full differential Galois group. -/
structure FiniteMultiplicativePersistentGaugeBranch
    (sigma : DifferentialAlgEquiv C T) : Type _ where
  q : T
  hypertranscendental : HypertranscendentalOver C q
  generates : differentialAdjoin C ({q} : Set T) = ⊤
  nonzero : q ≠ 0
  multiplier : Cˣ
  order : ℕ
  order_ge_two : 2 ≤ order
  multiplier_order : orderOf multiplier = order
  action : sigma.toAlgEquiv q = q * algebraMap C T (multiplier : C)
  automorphism_order : orderOf sigma.toAlgEquiv = order
  fixedField : IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
    differentialAdjoin C ({q ^ order} : Set T)
  boundary_hypertranscendental : HypertranscendentalOver C (q ^ order)
  reconstructs :
    IntermediateField.adjoin (differentialAdjoin C ({q ^ order} : Set T)) ({q} : Set T) = ⊤
  equation : q′ = algebraMap (differentialAdjoin C ({q ^ order} : Set T)) T
    (scalarRadicalCoefficient q order) * q
  galoisGroup : rootsOfUnity order C ≃*
    derivationPreservingAut (differentialAdjoin C ({q ^ order} : Set T)) T

/-- Infinite multiplicative branch, with logarithmic-current fixed field and exact `G_m` torsor. -/
structure InfiniteMultiplicativePersistentGaugeBranch
    (sigma : DifferentialAlgEquiv C T) : Type _ where
  q : T
  hypertranscendental : HypertranscendentalOver C q
  generates : differentialAdjoin C ({q} : Set T) = ⊤
  nonzero : q ≠ 0
  multiplier : Cˣ
  multiplier_order : orderOf multiplier = 0
  action : sigma.toAlgEquiv q = q * algebraMap C T (multiplier : C)
  automorphism_order : orderOf sigma.toAlgEquiv = 0
  fixedField : IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
    scalarLogCurrentField C q
  boundary_hypertranscendental :
    HypertranscendentalOver C (Differential.logDeriv q)
  reconstructs : IntermediateField.adjoin (scalarLogCurrentField C q) ({q} : Set T) = ⊤
  equation : q′ = Differential.logDeriv q * q
  galoisGroup : Cˣ ≃* derivationPreservingAut (scalarLogCurrentField C q) T

/-- Infinite additive branch, with derivative fixed field and exact `G_a` torsor. -/
structure AdditivePersistentGaugeBranch
    (sigma : DifferentialAlgEquiv C T) : Type _ where
  q : T
  hypertranscendental : HypertranscendentalOver C q
  generates : differentialAdjoin C ({q} : Set T) = ⊤
  action : sigma.toAlgEquiv q = q + algebraMap C T 1
  automorphism_order : orderOf sigma.toAlgEquiv = 0
  fixedField : IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
    scalarDerivativeField C q
  boundary_hypertranscendental : HypertranscendentalOver C q′
  reconstructs : IntermediateField.adjoin (scalarDerivativeField C q) ({q} : Set T) = ⊤
  equation : q′ = algebraMap (scalarDerivativeField C q) T
    (scalarDerivativeCoefficient (F := C) q)
  galoisGroup : Multiplicative C ≃*
    derivationPreservingAut (scalarDerivativeField C q) T

/-- The hypertranscendental Schwarzian field is a universal projective boundary contained in the
exact cyclic fixed field of every scalar gauge branch. -/
theorem universalProjectiveBoundary_le_fixedField
    (sigma : DifferentialAlgEquiv C T)
    (q : T) (hq : HypertranscendentalOver C q)
    (hqgen : differentialAdjoin C ({q} : Set T) = ⊤)
    (hC : ∀ c : C, (algebraMap C T c)′ = 0) :
    HypertranscendentalOver C (schwarzian q) ∧
      differentialAdjoin C ({schwarzian q} : Set T) ≤
        IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) := by
  have hfixed : sigma.toAlgEquiv (schwarzian q) = schwarzian q :=
    schwarzian_fixed_of_differentialAlgEquiv sigma.toAlgEquiv hq hqgen
      sigma.map_deriv' hC
  refine ⟨hypertranscendentalOver_schwarzian hq, ?_⟩
  apply differentialAdjoin_le C
  · intro z hz
    have hzq : z = schwarzian q := Set.mem_singleton_iff.mp hz
    subst z
    exact (mem_fixedField_zpowers_iff sigma.toAlgEquiv (schwarzian q)).mpr hfixed
  · intro z hz
    have hzfixed := (mem_fixedField_zpowers_iff sigma.toAlgEquiv z).mp hz
    apply (mem_fixedField_zpowers_iff sigma.toAlgEquiv z′).mpr
    rw [sigma.map_deriv', hzfixed]

/-- Exhaustion by the four scalar persistent-gauge branches. -/
def PersistentGaugeBranchExhaustive (sigma : DifferentialAlgEquiv C T) : Prop :=
  TrivialPersistentGaugeBranch sigma ∨
    Nonempty (FiniteMultiplicativePersistentGaugeBranch sigma) ∨
    Nonempty (InfiniteMultiplicativePersistentGaugeBranch sigma) ∨
    Nonempty (AdditivePersistentGaugeBranch sigma)

/-- The four scalar persistent-gauge alternatives are pairwise disjoint. -/
def PersistentGaugeBranchesMutuallyExclusive (sigma : DifferentialAlgEquiv C T) : Prop :=
  (¬(TrivialPersistentGaugeBranch sigma ∧
      Nonempty (FiniteMultiplicativePersistentGaugeBranch sigma))) ∧
  (¬(TrivialPersistentGaugeBranch sigma ∧
      Nonempty (InfiniteMultiplicativePersistentGaugeBranch sigma))) ∧
  (¬(TrivialPersistentGaugeBranch sigma ∧
      Nonempty (AdditivePersistentGaugeBranch sigma))) ∧
  (¬(Nonempty (FiniteMultiplicativePersistentGaugeBranch sigma) ∧
      Nonempty (InfiniteMultiplicativePersistentGaugeBranch sigma))) ∧
  (¬(Nonempty (FiniteMultiplicativePersistentGaugeBranch sigma) ∧
      Nonempty (AdditivePersistentGaugeBranch sigma))) ∧
  (¬(Nonempty (InfiniteMultiplicativePersistentGaugeBranch sigma) ∧
      Nonempty (AdditivePersistentGaugeBranch sigma)))

omit [CharZero C] in
/-- The four branches are genuinely mutually exclusive, including multiplicative versus additive
normal forms written on different Möbius generators. -/
theorem persistentGaugeBranches_mutuallyExclusive
    (sigma : DifferentialAlgEquiv C T) :
    PersistentGaugeBranchesMutuallyExclusive sigma := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rintro ⟨htrivial, ⟨hfinite⟩⟩
    have horder : (1 : ℕ) = hfinite.order :=
      htrivial.automorphism_order.symm.trans hfinite.automorphism_order
    have hge := hfinite.order_ge_two
    omega
  · rintro ⟨htrivial, ⟨hinfinite⟩⟩
    have horder : (1 : ℕ) = 0 :=
      htrivial.automorphism_order.symm.trans hinfinite.automorphism_order
    omega
  · rintro ⟨htrivial, ⟨hadditive⟩⟩
    have horder : (1 : ℕ) = 0 :=
      htrivial.automorphism_order.symm.trans hadditive.automorphism_order
    omega
  · rintro ⟨⟨hfinite⟩, ⟨hinfinite⟩⟩
    have horder : hfinite.order = 0 :=
      hfinite.automorphism_order.symm.trans hinfinite.automorphism_order
    have hge := hfinite.order_ge_two
    omega
  · rintro ⟨⟨hfinite⟩, ⟨hadditive⟩⟩
    have horder : hfinite.order = 0 :=
      hfinite.automorphism_order.symm.trans hadditive.automorphism_order
    have hge := hfinite.order_ge_two
    omega
  · rintro ⟨⟨hinfinite⟩, ⟨hadditive⟩⟩
    exact sigma.not_unit_eigenvector_and_translate_one_on_generators
      hinfinite.q hadditive.q hinfinite.hypertranscendental
      hadditive.hypertranscendental hinfinite.generates hadditive.generates
      hinfinite.multiplier hinfinite.action hadditive.action

/-- Complete and pairwise-exact four-branch scalar persistent-gauge classification. -/
def CompletePersistentGaugeClassification (sigma : DifferentialAlgEquiv C T) : Prop :=
  PersistentGaugeBranchExhaustive sigma ∧
    PersistentGaugeBranchesMutuallyExclusive sigma

omit [Differential C] [DifferentialAlgebra C T] [CharZero C] [CharZero T] in
/-- A nonzero hypertranscendental scalar cannot vanish. -/
theorem ne_zero_of_hypertranscendentalOver {q : T}
    (hq : HypertranscendentalOver C q) : q ≠ 0 := by
  intro hq0
  have ht : Transcendental C q := by
    simpa using hypertranscendentalOver_jet_transcendental hq 0
  exact ht (hq0 ▸ isAlgebraic_zero)

set_option maxHeartbeats 800000 in
/-- **Complete scalar differential-automorphism gauge reduction.** -/
theorem differentialAlgEquiv_completePersistentGaugeClassification
    [IsAlgClosed C] [Differential.ContainConstants C T]
    (hconst : ∀ c : C, c′ = 0)
    (sigma : DifferentialAlgEquiv C T)
    (u : T) (huHT : HypertranscendentalOver C u)
    (hugen : differentialAdjoin C ({u} : Set T) = ⊤) :
    CompletePersistentGaugeClassification sigma := by
  classical
  have hC : ∀ c : C, (algebraMap C T c)′ = 0 := by
    intro c
    rw [deriv_algebraMap, hconst c, map_zero]
  have htu : Transcendental C u := by
    simpa using hypertranscendentalOver_jet_transcendental huHT 0
  have htop_ne_bot : (⊤ : IntermediateField C T) ≠ ⊥ := by
    intro htop
    apply notMem_bot_of_hypertranscendentalOver huHT
    rw [← htop]
    trivial
  obtain ⟨hu, huinv⟩ := differentialAlgEquiv_generator_mem_adjoin_singleton
    sigma.toAlgEquiv huHT hugen sigma.map_deriv'
  let e : RatFunc C ≃ₐ[C] RatFunc C :=
    ratFuncAlgEquivOfAdjoinInvariant sigma.toAlgEquiv u htu hu huinv
  refine ⟨?_, persistentGaugeBranches_mutuallyExclusive sigma⟩
  rcases ratFuncAlgEquiv_cyclicNormalForm e with he | hfinite | hinfinite | hadditive
  · left
    have hsigmau : sigma.toAlgEquiv u = u := by
      have hnat := coe_ratFuncAlgEquivOfAdjoinInvariant
        sigma.toAlgEquiv u htu hu huinv RatFunc.X
      change ((RatFunc.algEquivOfTranscendental u htu (e RatFunc.X) :
        IntermediateField.adjoin C {u}) : T) = sigma.toAlgEquiv
          ((RatFunc.algEquivOfTranscendental u htu RatFunc.X :
            IntermediateField.adjoin C {u}) : T) at hnat
      rw [he] at hnat
      simpa using hnat.symm
    have hsigma : sigma.toAlgEquiv = AlgEquiv.refl := by
      apply AlgEquiv.ext
      intro z
      have hz : z ∈ differentialAdjoin C ({u} : Set T) := by rw [hugen]; trivial
      rw [differentialAdjoin] at hz
      apply IntermediateField.adjoin_induction C
        (s := differentialJetSet ({u} : Set T))
        (p := fun w _ ↦ sigma.toAlgEquiv w = (AlgEquiv.refl : T ≃ₐ[C] T) w)
      · rintro w ⟨v, hv, n, rfl⟩
        have hvu : v = u := Set.mem_singleton_iff.mp hv
        subst v
        rw [sigma.map_differentialJet, hsigmau]
        rfl
      · intro c
        simp
      · intro a b _ _ ha hb
        simpa [map_add] using congrArg₂ (· + ·) ha hb
      · intro a _ ha
        simpa [map_inv₀] using congrArg Inv.inv ha
      · intro a b _ _ ha hb
        simpa [map_mul] using congrArg₂ (· * ·) ha hb
      · exact hz
    refine ⟨hsigma, ?_, ?_, ?_⟩
    · rw [hsigma]
      change orderOf (1 : T ≃ₐ[C] T) = 1
      simp
    · ext z
      rw [mem_fixedField_zpowers_iff]
      simp [hsigma]
    · intro tau
      apply Subtype.ext
      apply AlgEquiv.ext
      intro z
      exact tau.1.commutes z
  · right; left
    obtain ⟨h, a, N, hN, haorder, hconj⟩ := hfinite
    let q : T := ((RatFunc.algEquivOfTranscendental u htu (h RatFunc.X) :
      IntermediateField.adjoin C {u}) : T)
    have hqgen : differentialAdjoin C ({q} : Set T) = ⊤ := by
      rw [differentialAdjoin_ratFuncAlgEquiv_coordinate u htu h, hugen]
    have hqHT : HypertranscendentalOver C q :=
      hypertranscendentalOver_of_generates_ne_bot hC
        ((hypertranscendentalOver_iff_differentialIndependent_singleton C u).mp huHT)
        hugen (L := (⊤ : IntermediateField C T)) htop_ne_bot hqgen
    have hq0 : q ≠ 0 := ne_zero_of_hypertranscendentalOver hqHT
    have haction : sigma.toAlgEquiv q = q * algebraMap C T (a : C) := by
      have hconjX := congrArg (fun f : RatFunc C ≃ₐ[C] RatFunc C => f RatFunc.X) hconj
      have heval : e (h RatFunc.X) = h (ratFuncUnitScaleEquiv a RatFunc.X) := by
        apply h.symm.injective
        simpa using hconjX
      have hnat := coe_ratFuncAlgEquivOfAdjoinInvariant
        sigma.toAlgEquiv u htu hu huinv (h RatFunc.X)
      change ((RatFunc.algEquivOfTranscendental u htu (e (h RatFunc.X)) :
        IntermediateField.adjoin C {u}) : T) = sigma.toAlgEquiv q at hnat
      rw [heval] at hnat
      rw [ratFuncUnitScaleEquiv_X, map_mul, h.commutes] at hnat
      rw [map_mul, (RatFunc.algEquivOfTranscendental u htu).commutes] at hnat
      simpa [q, mul_comm] using hnat.symm
    have hsigmaOrder : orderOf sigma.toAlgEquiv = N :=
      (sigma.orderOf_eq_orderOf_unit_of_generator q hq0 hqgen a haction).trans haorder
    refine ⟨⟨q, hqHT, hqgen, hq0, a, N, hN, haorder, haction, hsigmaOrder,
      ?_, ?_, ?_, ?_, ?_⟩⟩
    · exact sigma.fixedField_zpowers_of_unit_eigenvector_of_finite_order
        q hqHT hq0 hqgen a hconst haction (by omega) haorder
    · exact hypertranscendentalOver_pow_of_pos hqHT (by omega)
    · exact adjoin_pow_eq_top q hq0 (by omega) hqgen
    · exact scalar_deriv_eq_radicalCoefficient_mul q hq0 (by omega)
    · exact scalarFiniteDifferentialGaloisGroupEquiv
        q hqHT hq0 hqgen hconst (by omega)
  · right; right; left
    obtain ⟨h, a, haorder, hconj⟩ := hinfinite
    let q : T := ((RatFunc.algEquivOfTranscendental u htu (h RatFunc.X) :
      IntermediateField.adjoin C {u}) : T)
    have hqgen : differentialAdjoin C ({q} : Set T) = ⊤ := by
      rw [differentialAdjoin_ratFuncAlgEquiv_coordinate u htu h, hugen]
    have hqHT : HypertranscendentalOver C q :=
      hypertranscendentalOver_of_generates_ne_bot hC
        ((hypertranscendentalOver_iff_differentialIndependent_singleton C u).mp huHT)
        hugen (L := (⊤ : IntermediateField C T)) htop_ne_bot hqgen
    have hq0 : q ≠ 0 := ne_zero_of_hypertranscendentalOver hqHT
    have haction : sigma.toAlgEquiv q = q * algebraMap C T (a : C) := by
      have hconjX := congrArg (fun f : RatFunc C ≃ₐ[C] RatFunc C => f RatFunc.X) hconj
      have heval : e (h RatFunc.X) = h (ratFuncUnitScaleEquiv a RatFunc.X) := by
        apply h.symm.injective
        simpa using hconjX
      have hnat := coe_ratFuncAlgEquivOfAdjoinInvariant
        sigma.toAlgEquiv u htu hu huinv (h RatFunc.X)
      change ((RatFunc.algEquivOfTranscendental u htu (e (h RatFunc.X)) :
        IntermediateField.adjoin C {u}) : T) = sigma.toAlgEquiv q at hnat
      rw [heval] at hnat
      rw [ratFuncUnitScaleEquiv_X, map_mul, h.commutes] at hnat
      rw [map_mul, (RatFunc.algEquivOfTranscendental u htu).commutes] at hnat
      simpa [q, mul_comm] using hnat.symm
    have hsigmaOrder : orderOf sigma.toAlgEquiv = 0 :=
      (sigma.orderOf_eq_orderOf_unit_of_generator q hq0 hqgen a haction).trans haorder
    refine ⟨⟨q, hqHT, hqgen, hq0, a, haorder, haction, hsigmaOrder,
      ?_, ?_, ?_, ?_, ?_⟩⟩
    · exact sigma.fixedField_zpowers_of_unit_eigenvector_of_infinite_order
        q hqHT hq0 hqgen a hconst haction haorder
    · exact logDeriv_hypertranscendentalOver hqHT hq0
    · exact scalarLogCurrentField_adjoin_amplitude_eq_top q hq0 hqgen
    · exact deriv_eq_logDeriv_mul q hq0
    · exact scalarDifferentialGaloisGroupEquiv q hqHT hq0 hqgen hconst
  · right; right; right
    obtain ⟨h, hconj⟩ := hadditive
    let q : T := ((RatFunc.algEquivOfTranscendental u htu (h RatFunc.X) :
      IntermediateField.adjoin C {u}) : T)
    have hqgen : differentialAdjoin C ({q} : Set T) = ⊤ := by
      rw [differentialAdjoin_ratFuncAlgEquiv_coordinate u htu h, hugen]
    have hqHT : HypertranscendentalOver C q :=
      hypertranscendentalOver_of_generates_ne_bot hC
        ((hypertranscendentalOver_iff_differentialIndependent_singleton C u).mp huHT)
        hugen (L := (⊤ : IntermediateField C T)) htop_ne_bot hqgen
    have haction : sigma.toAlgEquiv q = q + algebraMap C T 1 := by
      have hconjX := congrArg (fun f : RatFunc C ≃ₐ[C] RatFunc C => f RatFunc.X) hconj
      have heval : e (h RatFunc.X) = h (ratFuncTranslationEquiv 1 RatFunc.X) := by
        apply h.symm.injective
        simpa using hconjX
      have hnat := coe_ratFuncAlgEquivOfAdjoinInvariant
        sigma.toAlgEquiv u htu hu huinv (h RatFunc.X)
      change ((RatFunc.algEquivOfTranscendental u htu (e (h RatFunc.X)) :
        IntermediateField.adjoin C {u}) : T) = sigma.toAlgEquiv q at hnat
      rw [heval] at hnat
      rw [ratFuncTranslationEquiv_X, map_add, h.commutes] at hnat
      simpa [q] using hnat.symm
    have hsigmaOrder : orderOf sigma.toAlgEquiv = 0 :=
      sigma.orderOf_eq_zero_of_translate_one_generator q haction
    refine ⟨⟨q, hqHT, hqgen, haction, hsigmaOrder, ?_, ?_, ?_, ?_, ?_⟩⟩
    · exact sigma.fixedField_zpowers_of_translate_one q hqHT hqgen hconst haction
    · exact scalar_derivative_hypertranscendentalOver q hqHT
    · exact scalarDerivativeField_adjoin_amplitude_eq_top q hqgen
    · exact scalar_amplitude_deriv_eq_coefficient q
    · exact scalarAdditiveDifferentialGaloisGroupEquiv q hqHT hqgen hconst

section StableCoreCapstone

variable {F : Type*} [Field F] [Algebra C F] [Differential F]
  [DifferentialAlgebra C F]

