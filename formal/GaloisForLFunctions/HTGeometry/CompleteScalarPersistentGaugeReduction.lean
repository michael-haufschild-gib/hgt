/-- A derivation-closed intermediate field is a differential algebra for its induced derivation. -/
theorem derivationClosedDifferentialAlgebra
    (L : IntermediateField C F) (hL : DerivationClosed L) :
    letI : Differential L := derivationClosedDifferential L hL
    DifferentialAlgebra C L := by
  letI : Differential L := derivationClosedDifferential L hL
  refine ⟨fun c => ?_⟩
  apply Subtype.ext
  rw [derivationClosedDifferential_apply]
  exact deriv_algebraMap c

omit [Differential C] [CharZero C] [DifferentialAlgebra C F] in
/-- A generator of a derivation-closed ambient subfield generates the full subfield internally. -/
theorem differentialAdjoin_subfield_generator_eq_top
    (L : IntermediateField C F) (hL : DerivationClosed L)
    {u : F} (hu : differentialAdjoin C ({u} : Set F) = L)
    (humem : u ∈ L) :
    letI : Differential L := derivationClosedDifferential L hL
    differentialAdjoin C ({(⟨u, humem⟩ : L)} : Set L) = ⊤ := by
  letI : Differential L := derivationClosedDifferential L hL
  let q : L := ⟨u, humem⟩
  have hjet : (L.val : L →ₐ[C] F) '' differentialJetSet ({q} : Set L) =
      differentialJetSet ({u} : Set F) := by
    ext z
    constructor
    · rintro ⟨w, ⟨x, hx, n, rfl⟩, rfl⟩
      have hxq : x = q := Set.mem_singleton_iff.mp hx
      subst x
      refine ⟨u, rfl, n, ?_⟩
      exact (differentialJet_coe L hL q n).symm
    · rintro ⟨x, hx, n, rfl⟩
      have hxu : x = u := Set.mem_singleton_iff.mp hx
      subst x
      refine ⟨differentialJet n q, ⟨q, rfl, n, rfl⟩, ?_⟩
      exact differentialJet_coe L hL q n
  have hmap' : IntermediateField.map L.val (differentialAdjoin C ({q} : Set L)) = L := by
    show IntermediateField.map L.val
        (IntermediateField.adjoin C (differentialJetSet ({q} : Set L))) = L
    rw [IntermediateField.adjoin_map, hjet, ← differentialAdjoin, hu]
  apply eq_top_iff.mpr
  intro z _
  have hzmap : (z : F) ∈ IntermediateField.map L.val
      (differentialAdjoin C ({q} : Set L)) := by
    rw [hmap']
    exact z.2
  rw [IntermediateField.mem_map] at hzmap
  obtain ⟨w, hw, hwz⟩ := hzmap
  have hw_eq : w = z := Subtype.ext hwz
  simpa [hw_eq] using hw

end StableCoreCapstone

section FreeFieldCapstone

variable {C₀ : Type*} [Field C₀] [IsAlgClosed C₀] [CharZero C₀]

omit [IsAlgClosed C₀] [CharZero C₀] in
/-- The canonical scalar jet field is a differential algebra over the zero-derived base. -/
theorem jetFieldZeroDifferentialAlgebra :
    letI : Differential C₀ := ⟨0⟩
    DifferentialAlgebra C₀ (JetField C₀ Unit) := by
  letI : Differential C₀ := ⟨0⟩
  exact ⟨fun a => by rw [deriv_algebraMap_jetField a]; exact (map_zero _).symm⟩

/-- **Closed complete scalar persistent-gauge reduction.**  Every derivation-compatible
endomorphism of the canonical scalar free differential field has either erased stable core, or a
non-erased stable core whose induced automorphism has the complete four-branch fixed-boundary and
Picard--Vessiot gauge classification. -/
theorem freeScalar_completePersistentGaugeReduction
    (φ : JetField C₀ Unit →ₐ[C₀] JetField C₀ Unit)
    (hφ : ∀ x : JetField C₀ Unit, φ x′ = (φ x)′) :
    letI : Differential C₀ := ⟨0⟩
    letI : DifferentialAlgebra C₀ (JetField C₀ Unit) :=
      jetFieldZeroDifferentialAlgebra
    Xor (stableRangeCore φ = ⊥)
      (stableRangeCore φ ≠ ⊥ ∧
        letI : Differential (stableRangeCore φ) :=
          derivationClosedDifferential _ (derivationClosed_stableRangeCore φ hφ)
        letI : DifferentialAlgebra C₀ (stableRangeCore φ) :=
          derivationClosedDifferentialAlgebra _ (derivationClosed_stableRangeCore φ hφ)
        CompletePersistentGaugeClassification
          (stableRangeCoreDifferentialAlgEquiv φ hφ)) := by
  letI : Differential C₀ := ⟨0⟩
  letI : DifferentialAlgebra C₀ (JetField C₀ Unit) := jetFieldZeroDifferentialAlgebra
  rcases freeScalarDifferentialInversiveCore_projectiveLaw φ hφ with herased | hprojective
  · exact Or.inl ⟨herased.1, fun hright => hright.1 herased.1⟩
  · right
    refine ⟨⟨hprojective.2, ?_⟩, fun hleft => hprojective.2 hleft⟩
    obtain ⟨u, huHT, hugen, -⟩ := hprojective.1
    let L : IntermediateField C₀ (JetField C₀ Unit) := stableRangeCore φ
    have hL : DerivationClosed L := derivationClosed_stableRangeCore φ hφ
    letI : Differential L := derivationClosedDifferential L hL
    letI : DifferentialAlgebra C₀ L := derivationClosedDifferentialAlgebra L hL
    have humem : u ∈ L := by
      change u ∈ stableRangeCore φ
      rw [← hugen]
      exact subset_differentialAdjoin C₀ ({u} : Set (JetField C₀ Unit)) rfl
    let q : L := ⟨u, humem⟩
    have hqDI : DifferentialIndependent C₀ (fun _ : Unit => q) := by
      apply differentialIndependent_subfield L hL
      simpa [q] using
        ((hypertranscendentalOver_iff_differentialIndependent_singleton C₀ u).mp huHT)
    have hqHT : HypertranscendentalOver C₀ q :=
      (hypertranscendentalOver_iff_differentialIndependent_singleton C₀ q).mpr hqDI
    have hqgen : differentialAdjoin C₀ ({q} : Set L) = ⊤ := by
      exact differentialAdjoin_subfield_generator_eq_top L hL hugen humem
    haveI : Differential.ContainConstants C₀ L := by
      refine ⟨?_⟩
      intro x hx
      have hxF : ((x : JetField C₀ Unit))′ = 0 := by
        have hxval := congrArg Subtype.val hx
        simpa [derivationClosedDifferential_apply] using hxval
      obtain ⟨c, hc⟩ := mem_range_of_deriv_eq_zero C₀ hxF
      refine ⟨c, ?_⟩
      apply Subtype.ext
      exact hc
    exact differentialAlgEquiv_completePersistentGaugeClassification
      (fun c : C₀ => rfl) (stableRangeCoreDifferentialAlgEquiv φ hφ) q hqHT hqgen

end FreeFieldCapstone

