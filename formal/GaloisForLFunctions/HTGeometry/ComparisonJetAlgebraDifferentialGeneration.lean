import GaloisForLFunctions.HTGeometry.ComparisonJetAlgebra

/-!
# Tensor generation from differential Picard--Vessiot generators

Parameterized Picard--Vessiot rings are generated by every derivative of the entries of a
fundamental matrix, not generally by the entries alone.  The comparison-jet algebra contains the
matching derivatives of the comparison matrix and is derivation-stable.  Consequently it still
generates the tensor square over the left copy of the PPV ring.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open GaloisForLFunctions
open scoped TensorProduct Differential

universe u

variable {K R C : Type u} [Field K] [CommRing R] [Algebra K R]
  [Field C] [Algebra C K] [Algebra C R] [IsScalarTower C K R]
  [Differential K] [Differential R] [DifferentialAlgebra K R]
  [Differential C] [DifferentialAlgebra C R]
  {n : ℕ}

/-- The comparison-jet algebra generates the tensor square when the PPV ring is generated by all
derivatives of the fundamental-matrix entries and the inverse determinant. -/
theorem adjoin_comparisonJetAlgebra_eq_top_of_differentialGeneration
    (Y : Matrix (Fin n) (Fin n) R) (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun q : (Fin n × Fin n) × ℕ =>
        differentialJet q.2 (Y q.1.1 q.1.2)) ∪ {u}) = ⊤)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y)
    (hw : Z.det * w = 1) :
    Algebra.adjoin C (Set.range (algebraMap R (R ⊗[K] R))
      ∪ (comparisonJetAlgebra (C := C) Z w : Set (R ⊗[K] R))) = ⊤ := by
  classical
  let E := comparisonJetAlgebra (C := C) Z w
  let T : Subalgebra C (R ⊗[K] R) := Algebra.adjoin C
    (Set.range (algebraMap R (R ⊗[K] R)) ∪ (E : Set (R ⊗[K] R)))
  have hLmem : ∀ x : R, (x ⊗ₜ[K] (1 : R)) ∈ T := by
    intro x
    exact Algebra.subset_adjoin (Set.mem_union_left _ ⟨x, rfl⟩)
  have hEmem : ∀ e : R ⊗[K] R, e ∈ E → e ∈ T := by
    intro e he
    exact Algebra.subset_adjoin (Set.mem_union_right _ he)
  have hTderiv : ∀ e : R ⊗[K] R, e ∈ T → tensorSquareDerivation (K := K) e ∈ T := by
    intro e he
    induction he using Algebra.adjoin_induction with
    | mem x hx =>
        rcases hx with ⟨r, rfl⟩ | hx
        · simpa using hLmem (Differential.deriv r)
        · exact hEmem _ (comparisonJetAlgebra_deriv_stable Z hw hx)
    | algebraMap c =>
        rw [tensorSquareDerivation_algebraMap]
        exact T.algebraMap_mem _
    | add x y _ _ hx hy =>
        rw [map_add]
        exact T.add_mem hx hy
    | mul x y hxmem hymem hx hy =>
        rw [Derivation.leibniz]
        simp only [smul_eq_mul]
        exact T.add_mem (T.mul_mem hxmem hy) (T.mul_mem hymem hx)
  have hZmem : ∀ i j : Fin n, Z i j ∈ T := by
    intro i j
    exact hEmem _ (mem_comparisonJetAlgebra_entry Z w i j)
  have hwmem : w ∈ T := hEmem _ (mem_comparisonJetAlgebra_w Z w)
  have hRY : ∀ i j : Fin n, ((1 : R) ⊗ₜ[K] Y i j) ∈ T := by
    intro i j
    have hval : ((1 : R) ⊗ₜ[K] Y i j) =
        ∑ k, (Y i k ⊗ₜ[K] (1 : R)) * Z k j := by
      have h := congrFun (congrFun hZ i) j
      simp only [Matrix.mul_apply, leftFundamental, rightFundamental, Matrix.map_apply] at h
      exact h.symm
    rw [hval]
    exact T.sum_mem fun k _ => T.mul_mem (hLmem (Y i k)) (hZmem k j)
  have hRjet : ∀ k i j, ((1 : R) ⊗ₜ[K] differentialJet k (Y i j)) ∈ T := by
    intro k
    induction k with
    | zero =>
        intro i j
        simpa using hRY i j
    | succ k ih =>
        intro i j
        rw [differentialJet_succ]
        have hderiv : ((1 : R) ⊗ₜ[K] Differential.deriv (differentialJet k (Y i j))) =
            tensorSquareDerivation (K := K) ((1 : R) ⊗ₜ[K] differentialJet k (Y i j)) := by
          simp [tensorSquareDerivation_tmul]
        rw [hderiv]
        exact hTderiv _ (ih i j)
  have hdetZ : ((1 : R) ⊗ₜ[K] Y.det) =
      (Y.det ⊗ₜ[K] (1 : R)) * Z.det := by
    have h := congrArg Matrix.det hZ
    rw [Matrix.det_mul, det_leftFundamental, det_rightFundamental] at h
    exact h.symm
  have hRu : ((1 : R) ⊗ₜ[K] u) = (u ⊗ₜ[K] (1 : R)) * w := by
    have h1 : ((1 : R) ⊗ₜ[K] u) * ((1 : R) ⊗ₜ[K] Y.det) = 1 := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_comm u Y.det, hu,
        ← Algebra.TensorProduct.one_def]
    have h2 : ((u ⊗ₜ[K] (1 : R)) * w) * ((1 : R) ⊗ₜ[K] Y.det) = 1 := by
      rw [hdetZ]
      calc
        (u ⊗ₜ[K] (1 : R)) * w * ((Y.det ⊗ₜ[K] (1 : R)) * Z.det) =
            ((u ⊗ₜ[K] (1 : R)) * (Y.det ⊗ₜ[K] (1 : R))) * (Z.det * w) := by ring
        _ = ((u * Y.det) ⊗ₜ[K] (1 : R)) * 1 := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hw]
        _ = 1 := by
          rw [mul_one, mul_comm u Y.det, hu, ← Algebra.TensorProduct.one_def]
    calc
      ((1 : R) ⊗ₜ[K] u) =
          ((1 : R) ⊗ₜ[K] u) *
            (((u ⊗ₜ[K] (1 : R)) * w) * ((1 : R) ⊗ₜ[K] Y.det)) := by rw [h2, mul_one]
      _ = (((1 : R) ⊗ₜ[K] u) * ((1 : R) ⊗ₜ[K] Y.det)) *
          ((u ⊗ₜ[K] (1 : R)) * w) := by ring
      _ = (u ⊗ₜ[K] (1 : R)) * w := by rw [h1, one_mul]
  have hRumem : ((1 : R) ⊗ₜ[K] u) ∈ T := by
    rw [hRu]
    exact T.mul_mem (hLmem u) hwmem
  have hRmem : ∀ x : R, ((1 : R) ⊗ₜ[K] x) ∈ T := by
    intro x
    have hx : x ∈ Algebra.adjoin K
        (Set.range (fun q : (Fin n × Fin n) × ℕ =>
          differentialJet q.2 (Y q.1.1 q.1.2)) ∪ {u}) := by
      rw [htop]
      trivial
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
        rcases hy with ⟨q, rfl⟩ | hy
        · exact hRjet q.2 q.1.1 q.1.2
        · rw [Set.mem_singleton_iff] at hy
          simpa [hy] using hRumem
    | algebraMap a =>
        have hbalanced : ((1 : R) ⊗ₜ[K] algebraMap K R a) =
            (algebraMap K R a ⊗ₜ[K] (1 : R)) := by
          calc
            ((1 : R) ⊗ₜ[K] algebraMap K R a) = algebraMap K (R ⊗[K] R) a :=
              (Algebra.TensorProduct.includeRight.commutes a)
            _ = (algebraMap K R a ⊗ₜ[K] (1 : R)) :=
              (Algebra.TensorProduct.includeLeft.commutes a).symm
        rw [hbalanced]
        exact hLmem _
    | add x y _ _ hx hy =>
        rw [TensorProduct.tmul_add]
        exact T.add_mem hx hy
    | mul x y _ _ hx hy =>
        rw [show (1 : R) ⊗ₜ[K] (x * y) =
          ((1 : R) ⊗ₜ[K] x) * ((1 : R) ⊗ₜ[K] y) by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]]
        exact T.mul_mem hx hy
  change T = ⊤
  apply top_unique
  intro v hv
  clear hv
  induction v using TensorProduct.induction_on with
  | zero => exact T.zero_mem
  | tmul x y =>
      rw [show x ⊗ₜ[K] y = (x ⊗ₜ[K] (1 : R)) * ((1 : R) ⊗ₜ[K] y) by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]]
      exact T.mul_mem (hLmem x) (hRmem y)
  | add x y hx hy => exact T.add_mem hx hy

end

end GaloisForLFunctions.HTGeometry
