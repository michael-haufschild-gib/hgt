import GaloisForLFunctions.HTGeometry.ProductLawBell
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
# The newest coordinate is transcendental over the low subalgebra

The tower's determinant argument substitutes a fresh polynomial variable for the newest coordinate.
In the rational model that substitution cannot be a ring map of the whole field — the field contains
inverses of polynomials in the newest coordinate — but it does exist on the subring generated by the
low data and that coordinate, because the coordinate is transcendental over the low subalgebra.

The coordinates of the rational model are algebraically independent, being the images of the
polynomial variables under the injective map to the fraction field.  Transcendence over the algebra
they generate is then mathlib's `AlgebraicIndependent.transcendental_adjoin`, transcendence over the
field they generate is `IntermediateField.transcendental_adjoin_iff`, and the low subalgebra of the
product law is contained in that field because an intermediate field is closed under inverses.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- The coordinates of the model are the images of the polynomial variables. -/
theorem aeval_fx_eq_algebraMap :
    (MvPolynomial.aeval fx : MvPolynomial ℕ ℂ →ₐ[ℂ] CascadeField)
      = IsScalarTower.toAlgHom ℂ (MvPolynomial ℕ ℂ) CascadeField := by
  apply MvPolynomial.algHom_ext
  intro k
  rw [MvPolynomial.aeval_X]
  rfl

/-- **The coordinates are algebraically independent.** -/
theorem algebraicIndependent_fx : AlgebraicIndependent ℂ fx := by
  rw [algebraicIndependent_iff_injective_aeval, aeval_fx_eq_algebraMap]
  exact IsFractionRing.injective (MvPolynomial ℕ ℂ) CascadeField

/-- The subfield generated by the coordinates of index at most `m`. -/
noncomputable def lowFld (m : ℕ) : IntermediateField ℂ CascadeField :=
  IntermediateField.adjoin ℂ (fx '' {j : ℕ | j ≤ m})

theorem fx_mem_lowFld {j m : ℕ} (h : j ≤ m) : fx j ∈ lowFld m :=
  IntermediateField.subset_adjoin ℂ _ ⟨j, h, rfl⟩

/-- **The newest coordinate is transcendental over the field generated by the older ones.** -/
theorem transcendental_fx_over_lowFld (m : ℕ) : Transcendental (lowFld m) (fx (m + 1)) := by
  rw [lowFld, IntermediateField.transcendental_adjoin_iff]
  exact algebraicIndependent_fx.transcendental_adjoin (by simp)

variable (Q v : ℕ → Polynomial ℂ)

/-- Every factor at a low coordinate lies in the low field. -/
theorem fact_mem_lowFld {j m : ℕ} (h : j ≤ m) (p : Polynomial ℂ) :
    fact p j ∈ lowFld m := by
  induction p using Polynomial.induction_on with
  | C a =>
      rw [fact_C]
      exact (lowFld m).algebraMap_mem a
  | add p q hp hq =>
      rw [fact_add]
      exact (lowFld m).add_mem hp hq
  | monomial n a _ =>
      rw [fact_monomial]
      exact (lowFld m).mul_mem ((lowFld m).algebraMap_mem a)
        (pow_mem (fx_mem_lowFld h) (n + 1))

/-- **The low subalgebra of the product law sits inside the low field.** -/
theorem lowSub_le_lowFld (m : ℕ) : lowSub Q v m ≤ (lowFld m).toSubalgebra := by
  rw [lowSub, Algebra.adjoin_le_iff]
  rintro x ((⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩)
  · exact fx_mem_lowFld hj
  · exact (lowFld m).inv_mem (fact_mem_lowFld hj _)
  · exact (lowFld m).inv_mem (fact_mem_lowFld hj _)

/-- **The newest coordinate is transcendental over the low subalgebra.**  Hence the subring it
generates over the low data is a polynomial ring, which is what replaces the tower's substitution of
a fresh variable. -/
theorem transcendental_fx_over_lowSub (m : ℕ) :
    Transcendental (lowSub Q v m) (fx (m + 1)) := by
  intro halg
  refine transcendental_fx_over_lowFld m ?_
  obtain ⟨p, hp0, hpz⟩ := halg
  refine ⟨p.map (Subalgebra.inclusion (lowSub_le_lowFld Q v m)), ?_, ?_⟩
  · intro h0
    have hinj : Function.Injective
        (Subalgebra.inclusion (lowSub_le_lowFld Q v m)).toRingHom :=
      Subalgebra.inclusion_injective _
    refine hp0 (Polynomial.map_injective _ hinj ?_)
    rw [Polynomial.map_zero]
    exact h0
  · rw [Polynomial.aeval_def, Polynomial.eval₂_map] at *
    rw [← hpz]
    congr 1

/-- **The polynomial ring over the low subalgebra embeds in the model.** -/
theorem injective_aeval_fx (m : ℕ) :
    Function.Injective
      (Polynomial.aeval (fx (m + 1)) :
        Polynomial (lowSub Q v m) →ₐ[lowSub Q v m] CascadeField) :=
  transcendental_iff_injective.mp (transcendental_fx_over_lowSub Q v m)

end GaloisForLFunctions.HTGeometry
