import GaloisForLFunctions.HTGeometry.ThermodynamicDiameterLBitCascadeLaw
import GaloisForLFunctions.HTGeometry.InfiniteLBitHilbertDynamicsLaw

/-!
# Hilbert dynamics for the thermodynamic diameter cascade

For every physical coupling `0 ≤ g ≤ 1`, the diameter-scaled thermodynamic energy is a bounded
real multiplication Hamiltonian on `L²` of infinite configurations.  Its exponential phases form
a strongly continuous one-parameter unitary group.  This places the nonterminating finite-volume
wall-crossing cascade and standard infinite-volume Schrödinger dynamics in the same model family.
-/

open Filter MeasureTheory Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Real multiplication symbol of the diameter-scaled Hamiltonian. -/
def diameterScaledLBitHamiltonianSymbol
    (g : ℝ) (σ : InfiniteLBitConfiguration) : ℂ :=
  diameterScaledQuasiLocalInfiniteLBitEnergy g σ

theorem measurable_diameterScaledLBitHamiltonianSymbol
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    Measurable (diameterScaledLBitHamiltonianSymbol g) :=
  (Complex.continuous_ofReal.comp
    (continuous_diameterScaledQuasiLocalInfiniteLBitEnergy hg0 hg1)).measurable

theorem norm_diameterScaledLBitHamiltonianSymbol_le
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (σ : InfiniteLBitConfiguration) :
    ‖diameterScaledLBitHamiltonianSymbol g σ‖ ≤
      quasiLocalInfiniteLBitMass := by
  simpa [diameterScaledLBitHamiltonianSymbol, Complex.norm_real,
    Real.norm_eq_abs] using
    abs_diameterScaledQuasiLocalInfiniteLBitEnergy_le_mass hg0 hg1 σ

/-- Bounded self-adjoint Hamiltonian for the scaled thermodynamic model. -/
noncomputable def diameterScaledLBitHamiltonian
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    InfiniteLBitHilbertSpace μ →L[ℂ]
      InfiniteLBitHilbertSpace μ :=
  lpBoundedMulCLM
    (measurable_diameterScaledLBitHamiltonianSymbol hg0 hg1)
    quasiLocalInfiniteLBitMass_nonneg
    (norm_diameterScaledLBitHamiltonianSymbol_le hg0 hg1)

theorem diameterScaledLBitHamiltonian_isSelfAdjoint
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    IsSelfAdjoint (diameterScaledLBitHamiltonian μ hg0 hg1) := by
  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr
  intro f h
  exact lpBoundedMulCLM_inner_real
    (measurable_diameterScaledLBitHamiltonianSymbol hg0 hg1)
    quasiLocalInfiniteLBitMass_nonneg
    (norm_diameterScaledLBitHamiltonianSymbol_le hg0 hg1)
    (fun σ => by simp [diameterScaledLBitHamiltonianSymbol]) f h

/-- Unit phase generated by the scaled infinite energy. -/
noncomputable def diameterScaledLBitPhase
    (g t : ℝ) (σ : InfiniteLBitConfiguration) : ℂ :=
  Complex.exp
    (-Complex.I * (t : ℂ) *
      (diameterScaledQuasiLocalInfiniteLBitEnergy g σ : ℂ))

theorem continuous_diameterScaledLBitPhase
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) (t : ℝ) :
    Continuous (diameterScaledLBitPhase g t) := by
  unfold diameterScaledLBitPhase
  exact Complex.continuous_exp.comp
    ((continuous_const.mul continuous_const).mul
      (Complex.continuous_ofReal.comp
        (continuous_diameterScaledQuasiLocalInfiniteLBitEnergy hg0 hg1)))

@[simp]
theorem norm_diameterScaledLBitPhase
    (g t : ℝ) (σ : InfiniteLBitConfiguration) :
    ‖diameterScaledLBitPhase g t σ‖ = 1 := by
  rw [diameterScaledLBitPhase, Complex.norm_exp]
  simp

theorem diameterScaledLBitPhase_add
    (g t s : ℝ) (σ : InfiniteLBitConfiguration) :
    diameterScaledLBitPhase g (t + s) σ =
      diameterScaledLBitPhase g t σ *
        diameterScaledLBitPhase g s σ := by
  rw [diameterScaledLBitPhase, diameterScaledLBitPhase,
    diameterScaledLBitPhase, ← Complex.exp_add]
  congr 1
  push_cast
  ring

@[simp]
theorem diameterScaledLBitPhase_zero
    (g : ℝ) (σ : InfiniteLBitConfiguration) :
    diameterScaledLBitPhase g 0 σ = 1 := by
  simp [diameterScaledLBitPhase]

/-- Scaled infinite-volume Schrödinger evolution on `L²`. -/
noncomputable def diameterScaledLBitHilbertEvolution
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) (t : ℝ) :
    InfiniteLBitHilbertSpace μ →L[ℂ]
      InfiniteLBitHilbertSpace μ :=
  lpBoundedMulCLM
    (continuous_diameterScaledLBitPhase hg0 hg1 t).measurable
    zero_le_one (fun σ => by simp)

theorem diameterScaledLBitHilbertEvolution_coeFn
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) (t : ℝ)
    (ψ : InfiniteLBitHilbertSpace μ) :
    ((diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ :
        InfiniteLBitHilbertSpace μ) : InfiniteLBitConfiguration → ℂ) =ᵐ[μ]
      fun σ => diameterScaledLBitPhase g t σ * ψ σ :=
  lpBoundedMulCLM_coeFn
    (continuous_diameterScaledLBitPhase hg0 hg1 t).measurable
    zero_le_one (fun σ => by simp) ψ

@[simp]
theorem diameterScaledLBitHilbertEvolution_zero
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (ψ : InfiniteLBitHilbertSpace μ) :
    diameterScaledLBitHilbertEvolution μ hg0 hg1 0 ψ = ψ := by
  apply Lp.ext
  filter_upwards
    [diameterScaledLBitHilbertEvolution_coeFn μ hg0 hg1 0 ψ] with σ hσ
  rw [hσ]
  simp

theorem diameterScaledLBitHilbertEvolution_add
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (t s : ℝ) (ψ : InfiniteLBitHilbertSpace μ) :
    diameterScaledLBitHilbertEvolution μ hg0 hg1 (t + s) ψ =
      diameterScaledLBitHilbertEvolution μ hg0 hg1 t
        (diameterScaledLBitHilbertEvolution μ hg0 hg1 s ψ) := by
  apply Lp.ext
  filter_upwards
    [diameterScaledLBitHilbertEvolution_coeFn μ hg0 hg1 (t + s) ψ,
      diameterScaledLBitHilbertEvolution_coeFn μ hg0 hg1 s ψ,
      diameterScaledLBitHilbertEvolution_coeFn μ hg0 hg1 t
        (diameterScaledLBitHilbertEvolution μ hg0 hg1 s ψ)] with σ hts hs ht
  rw [hts, ht, hs, diameterScaledLBitPhase_add]
  ring

@[simp]
theorem diameterScaledLBitHilbertEvolution_neg_left
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (t : ℝ) (ψ : InfiniteLBitHilbertSpace μ) :
    diameterScaledLBitHilbertEvolution μ hg0 hg1 (-t)
      (diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ) = ψ := by
  rw [← diameterScaledLBitHilbertEvolution_add]
  simp

@[simp]
theorem diameterScaledLBitHilbertEvolution_neg_right
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (t : ℝ) (ψ : InfiniteLBitHilbertSpace μ) :
    diameterScaledLBitHilbertEvolution μ hg0 hg1 t
      (diameterScaledLBitHilbertEvolution μ hg0 hg1 (-t) ψ) = ψ := by
  rw [← diameterScaledLBitHilbertEvolution_add]
  simp

theorem norm_diameterScaledLBitHilbertEvolution_le
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (t : ℝ) (ψ : InfiniteLBitHilbertSpace μ) :
    ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ‖ ≤ ‖ψ‖ := by
  calc
    ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ‖
        ≤ ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t‖ * ‖ψ‖ :=
          (diameterScaledLBitHilbertEvolution μ hg0 hg1 t).le_opNorm ψ
    _ ≤ 1 * ‖ψ‖ := by
      gcongr
      exact norm_lpBoundedMulCLM_le
        (continuous_diameterScaledLBitPhase hg0 hg1 t).measurable
        zero_le_one (fun σ => by simp)
    _ = ‖ψ‖ := one_mul _

@[simp]
theorem norm_diameterScaledLBitHilbertEvolution
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (t : ℝ) (ψ : InfiniteLBitHilbertSpace μ) :
    ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ‖ = ‖ψ‖ := by
  apply le_antisymm
    (norm_diameterScaledLBitHilbertEvolution_le μ hg0 hg1 t ψ)
  calc
    ‖ψ‖ =
        ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 (-t)
          (diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ)‖ := by simp
    _ ≤ ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ‖ :=
      norm_diameterScaledLBitHilbertEvolution_le μ hg0 hg1 (-t) _

/-- Evolution at each time is a unitary linear isometric equivalence. -/
noncomputable def diameterScaledLBitHilbertUnitary
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) (t : ℝ) :
    InfiniteLBitHilbertSpace μ ≃ₗᵢ[ℂ]
      InfiniteLBitHilbertSpace μ where
  toFun := diameterScaledLBitHilbertEvolution μ hg0 hg1 t
  invFun := diameterScaledLBitHilbertEvolution μ hg0 hg1 (-t)
  left_inv := diameterScaledLBitHilbertEvolution_neg_left μ hg0 hg1 t
  right_inv := diameterScaledLBitHilbertEvolution_neg_right μ hg0 hg1 t
  map_add' := (diameterScaledLBitHilbertEvolution μ hg0 hg1 t).map_add
  map_smul' := (diameterScaledLBitHilbertEvolution μ hg0 hg1 t).map_smul
  norm_map' := norm_diameterScaledLBitHilbertEvolution μ hg0 hg1 t

theorem continuous_diameterScaledLBitPhase_time
    (g : ℝ) (σ : InfiniteLBitConfiguration) :
    Continuous (fun t : ℝ => diameterScaledLBitPhase g t σ) := by
  unfold diameterScaledLBitPhase
  fun_prop

/-- Strong continuity of every scaled infinite-volume orbit. -/
theorem continuous_diameterScaledLBitHilbertEvolution_time
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1)
    (ψ : InfiniteLBitHilbertSpace μ) :
    Continuous
      (fun t : ℝ =>
        diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ) := by
  rw [continuous_iff_continuousAt]
  intro t
  exact tendsto_lpBoundedMulCLM_apply
    (fun s => (continuous_diameterScaledLBitPhase hg0 hg1 s).measurable)
    (continuous_diameterScaledLBitPhase hg0 hg1 t).measurable
    zero_le_one
    (fun _ _ => by simp)
    (fun _ => by simp)
    (fun σ => (continuous_diameterScaledLBitPhase_time g σ).continuousAt)
    ψ

/-- **Thermodynamic Hilbert-dynamics capstone.**  At every physical coupling, the same scaled
interaction family has a self-adjoint infinite-volume Hamiltonian and strongly continuous unitary
dynamics. -/
theorem thermodynamicDiameterLBitHilbertDynamicsLaw
    (μ : Measure InfiniteLBitConfiguration)
    {g : ℝ} (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    IsSelfAdjoint (diameterScaledLBitHamiltonian μ hg0 hg1) ∧
    (∀ t s ψ,
      diameterScaledLBitHilbertEvolution μ hg0 hg1 (t + s) ψ =
        diameterScaledLBitHilbertEvolution μ hg0 hg1 t
          (diameterScaledLBitHilbertEvolution μ hg0 hg1 s ψ)) ∧
    (∀ t ψ,
      ‖diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ‖ = ‖ψ‖) ∧
    (∀ ψ,
      Continuous
        (fun t : ℝ =>
          diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ)) := by
  exact ⟨diameterScaledLBitHamiltonian_isSelfAdjoint μ hg0 hg1,
    fun t s ψ => diameterScaledLBitHilbertEvolution_add μ hg0 hg1 t s ψ,
    fun t ψ => norm_diameterScaledLBitHilbertEvolution μ hg0 hg1 t ψ,
    continuous_diameterScaledLBitHilbertEvolution_time μ hg0 hg1⟩

end

end GaloisForLFunctions.HTGeometry
