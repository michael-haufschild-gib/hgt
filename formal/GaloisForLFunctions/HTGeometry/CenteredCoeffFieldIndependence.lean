import GaloisForLFunctions.HTGeometry.GenericCenteredIndependence
import GaloisForLFunctions.HTGeometry.CenteredGenericCoefficients

/-!
# The centered coefficient field is generated by an algebraically independent family

The coefficients of the centered generic polynomial lie in the centered field, and the last of them
vanishes because the polynomial is centered.  The remaining `d - 1` are algebraically independent:
reading them back in the ambient field of rational functions loses nothing, and there they are
already known to be independent.

So the field the centered coefficients generate over the constants is generated by `d - 1`
independent transcendentals.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] [CharZero K] {d : ℕ}

/-- The coefficients of the centered polynomial indexed below the top one. -/
noncomputable def centeredLowCoeffIn (K : Type*) [Field K] [CharZero K] (d : ℕ)
    (k : Fin (d - 1)) : centeredField K d :=
  centeredCoeff K d (centeredIndex d k)

theorem val_centeredLowCoeffIn :
    ((centeredField K d).val ∘ centeredLowCoeffIn K d) = centeredLowCoeff K d :=
  _root_.funext fun _ => rfl

/-- **The centered coefficients are algebraically independent in the centered field.** -/
theorem algebraicIndependent_centeredLowCoeffIn (hd : 0 < d) :
    AlgebraicIndependent K (centeredLowCoeffIn K d) :=
  AlgebraicIndependent.of_comp (centeredField K d).val
    (by rw [val_centeredLowCoeffIn]; exact algebraicIndependent_centeredLowCoeff hd)

end GaloisForLFunctions.HTGeometry
