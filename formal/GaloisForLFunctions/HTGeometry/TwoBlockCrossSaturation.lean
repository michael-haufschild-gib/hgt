import GaloisForLFunctions.HTGeometry.JetFractionDerivationTransport

/-!
# The cross-difference saturation, on the two-block ring

The corpus's saturation certificate for the coefficient cross-relation lives in the jet fraction
field.  Clearing the denominators of its multiplier and descending along the two-block splitting puts
the same certificate in the two-block differential-polynomial ring, where it can be handed to each
irreducible factor of the cleared characteristic.
-/

namespace GaloisForLFunctions

open MvPolynomial

open scoped Differential

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Differential F] [Differential E] [Algebra F E]
  [DifferentialAlgebra F E] [CharZero F] [CharZero E]

omit [Differential F] [CharZero F] in
/-- The block swap is an involution. -/
theorem differentialPolynomialTwoBlockSwap_swap
    (X : DifferentialPolynomial (Unit ⊕ Unit) F) :
    differentialPolynomialTwoBlockSwap F (differentialPolynomialTwoBlockSwap F X) = X := by
  unfold differentialPolynomialTwoBlockSwap
  rw [MvPolynomial.rename_rename]
  have hid : (fun p : (Unit ⊕ Unit) × ℕ => (Equiv.sumComm Unit Unit p.1, p.2)) ∘
      (fun p : (Unit ⊕ Unit) × ℕ => (Equiv.sumComm Unit Unit p.1, p.2)) = id := by
    funext p
    rcases p with ⟨j, k⟩
    cases j <;> rfl
  rw [hid, MvPolynomial.rename_id]
  rfl

omit [CharZero F] in
/-- **The cross-difference saturation on the two-block ring.**  Some nonzero two-block multiple of
the cross-difference of two coefficients of the cleared characteristic lies in the differential ideal
generated by that characteristic. -/
theorem exists_twoBlock_crossDifference_saturation
    (G : IntermediateField F E) (hGclosed : DerivationClosed G) {y : E}
    (hG : G ≤ differentialAdjoin F ({y} : Set E))
    (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (P : DifferentialPolynomial Unit G)
    (hP : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    (Cc : PrimitiveTwoBlockDifferentialCharacteristic G hG hy P)
    (m n : (Unit × ℕ) →₀ ℕ) :
    ∃ M : DifferentialPolynomial (Unit ⊕ Unit) F,
      M * differentialPolynomialCrossDifference
          (differentialPolynomialTwoBlockCoefficient m Cc.polynomial)
          (differentialPolynomialTwoBlockCoefficient n Cc.polynomial)
        ∈ differentialPolynomialFamilyIterateIdeal Cc.polynomial := by
  classical
  letI : Differential (DifferentialPolynomial Unit F) := differentialPolynomialDifferential F
  letI : Differential G := derivationClosedDifferential G hGclosed
  letI : Differential (FractionRing (DifferentialPolynomial Unit F)) :=
    differentialIndependentJetFractionDifferential y hy
  set R := DifferentialPolynomial Unit F with hR
  set K := FractionRing R with hK
  set φ : G →ₐ[F] K := differentialIntermediateToJetFraction G hG hy with hφ
  set D : DifferentialPolynomial (Unit ⊕ Unit) F :=
    differentialPolynomialCrossDifference
      (differentialPolynomialTwoBlockCoefficient m Cc.polynomial)
      (differentialPolynomialTwoBlockCoefficient n Cc.polynomial) with hD
  -- the saturation certificate in the jet fraction field
  obtain ⟨a, b, hsat⟩ :=
    Cc.exists_mappedCrossRelation_saturation G hGclosed hG hy P hP m n
  set Icoeff : DifferentialPolynomial Unit K :=
    MvPolynomial.map φ.toRingHom (scalarDifferentialPolynomialInitial P) with hI
  set Scoeff : DifferentialPolynomial Unit K :=
    MvPolynomial.map φ.toRingHom (scalarDifferentialPolynomialSeparant P) with hS
  set Wrel : DifferentialPolynomial Unit K :=
    MvPolynomial.map φ.toRingHom
      (differentialCharacteristicCoefficientCrossRelation G (P.coeff m) (P.coeff n)
        (differentialPolynomialTwoBlockCoefficient m Cc.polynomial)
        (differentialPolynomialTwoBlockCoefficient n Cc.polynomial)) with hW
  -- the cross-difference maps to the cross-relation up to the clearing unit
  have hmapD : MvPolynomial.map (algebraMap R K)
      (differentialPolynomialTwoBlockEquiv F D) =
      MvPolynomial.C (Cc.scalar : K) * Wrel :=
    Cc.map_coefficientCrossRelation G hG hy P m n
  -- the ideal generated by the cleared characteristic is the one generated by the mapped one
  have hmapC : MvPolynomial.map (algebraMap R K)
      (differentialPolynomialTwoBlockEquiv F Cc.polynomial) =
      MvPolynomial.C (Cc.scalar : K) * MvPolynomial.map φ.toRingHom P := Cc.clearing
  have hideal : differentialPolynomialIterateIdeal
      (MvPolynomial.map (algebraMap R K) (differentialPolynomialTwoBlockEquiv F Cc.polynomial)) =
      differentialPolynomialIterateIdeal (MvPolynomial.map φ.toRingHom P) := by
    rw [hmapC]
    exact differentialPolynomialIterateIdeal_C_mul_unit Cc.scalar _
  -- multiply the certificate by the clearing unit to see the cross-difference
  have hsat' : Icoeff ^ a * Scoeff ^ b *
      MvPolynomial.map (algebraMap R K) (differentialPolynomialTwoBlockEquiv F D) ∈
      differentialPolynomialIterateIdeal
        (MvPolynomial.map (algebraMap R K)
          (differentialPolynomialTwoBlockEquiv F Cc.polynomial)) := by
    rw [hideal, hmapD]
    have h1 : Icoeff ^ a * Scoeff ^ b * (MvPolynomial.C (Cc.scalar : K) * Wrel)
        = MvPolynomial.C (Cc.scalar : K) * (Icoeff ^ a * Scoeff ^ b * Wrel) := by ring
    rw [h1]
    exact Ideal.mul_mem_left _ _ hsat
  -- clear the denominators of the multiplier
  obtain ⟨e, Zpoly, hZ⟩ := exists_mvPolynomial_fraction_clear (R := R) (K := K)
    (σ := Unit × ℕ) (Icoeff ^ a * Scoeff ^ b)
  set Z : DifferentialPolynomial (Unit ⊕ Unit) F :=
    (differentialPolynomialTwoBlockEquiv F).symm Zpoly with hZdef
  -- the two-block certificate, after descending
  have hmapZ : differentialPolynomialTwoBlockEquiv F Z = Zpoly := by
    rw [hZdef, AlgEquiv.apply_symm_apply]
  have hcombined : MvPolynomial.map (algebraMap R K)
      (differentialPolynomialTwoBlockEquiv F (Z * D)) ∈
      differentialPolynomialIterateIdeal
        (MvPolynomial.map (algebraMap R K)
          (differentialPolynomialTwoBlockEquiv F Cc.polynomial)) := by
    rw [map_mul, map_mul, hmapZ, hZ]
    have h2 : MvPolynomial.C (algebraMap R K (e : R)) * (Icoeff ^ a * Scoeff ^ b) *
        MvPolynomial.map (algebraMap R K) (differentialPolynomialTwoBlockEquiv F D)
        = MvPolynomial.C (algebraMap R K (e : R)) *
          (Icoeff ^ a * Scoeff ^ b *
            MvPolynomial.map (algebraMap R K)
              (differentialPolynomialTwoBlockEquiv F D)) := by ring
    rw [h2]
    exact Ideal.mul_mem_left _ _ hsat'
  obtain ⟨d, hd0, hmem⟩ :=
    exists_clear_mem_familyIterateIdeal_of_map_mem hy hcombined
  refine ⟨differentialPolynomialLeft (κ := Unit) d * Z, ?_⟩
  have hfinal : differentialPolynomialLeft (κ := Unit) d * (Z * D) =
      differentialPolynomialLeft (κ := Unit) d * Z * D := by ring
  rwa [hfinal] at hmem

omit [CharZero F] in
/-- **The same certificate for every factor.**  A differential principal ideal reverses divisibility
of its generator, so the two-block saturation is inherited by each divisor of the cleared
characteristic — in particular by each of its irreducible factors. -/
theorem exists_twoBlock_crossDifference_saturation_of_dvd
    (G : IntermediateField F E) (hGclosed : DerivationClosed G) {y : E}
    (hG : G ≤ differentialAdjoin F ({y} : Set E))
    (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (P : DifferentialPolynomial Unit G)
    (hP : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    (Cc : PrimitiveTwoBlockDifferentialCharacteristic G hG hy P)
    (m n : (Unit × ℕ) →₀ ℕ)
    {A : DifferentialPolynomial (Unit ⊕ Unit) F} (hA : A ∣ Cc.polynomial) :
    ∃ M : DifferentialPolynomial (Unit ⊕ Unit) F,
      M * differentialPolynomialCrossDifference
          (differentialPolynomialTwoBlockCoefficient m Cc.polynomial)
          (differentialPolynomialTwoBlockCoefficient n Cc.polynomial)
        ∈ differentialPolynomialFamilyIterateIdeal A := by
  obtain ⟨M, hM⟩ :=
    exists_twoBlock_crossDifference_saturation G hGclosed hG hy P hP Cc m n
  exact ⟨M, differentialPolynomialFamilyIterateIdeal_le_of_dvd hA hM⟩

omit [CharZero E] in
/-- **The factor step.**  A two-block differential-ideal certificate for an irreducible factor,
read in the swapped view where the left block becomes the polynomial variables, yields ordinary
divisibility in the two-block ring: the bridge cancels the multiplier over the jet fraction field and
primitivity contracts the divisibility back. -/
theorem dvd_of_saturation_bridge {y : E}
    (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    {A M Q : DifferentialPolynomial (Unit ⊕ Unit) F}
    (hmem : M * Q ∈ differentialPolynomialFamilyIterateIdeal A)
    (hAprim : MvPolynomialPrimitive
      (differentialPolynomialTwoBlockEquiv F (differentialPolynomialTwoBlockSwap F A)))
    (hA0 : differentialPolynomialTwoBlockEquiv F
      (differentialPolynomialTwoBlockSwap F A) ≠ 0)
    (hAvars : (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F A))).vars.Nonempty)
    (hAirr : Irreducible (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F A))))
    (hMorder : scalarDifferentialPolynomialOrder (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F M))) ≤
      scalarDifferentialPolynomialOrder (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F A))))
    (hMnot : ¬ (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F A))) ∣
      (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F M))))
    (hQorder : scalarDifferentialPolynomialOrder (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F Q))) ≤
      scalarDifferentialPolynomialOrder (MvPolynomial.map
        (algebraMap (DifferentialPolynomial Unit F)
          (FractionRing (DifferentialPolynomial Unit F)))
        (differentialPolynomialTwoBlockEquiv F
          (differentialPolynomialTwoBlockSwap F A)))) :
    A ∣ Q := by
  classical
  letI : Differential (DifferentialPolynomial Unit F) := differentialPolynomialDifferential F
  letI : Differential (FractionRing (DifferentialPolynomial Unit F)) :=
    differentialIndependentJetFractionDifferential y hy
  have hasc := map_equiv_swap_mem_iterateIdeal_of_mem_familyIterateIdeal hy hmem
  rw [map_mul, map_mul, map_mul] at hasc
  have hdvdK := irreducible_dvd_of_order_le_of_mul_mem_iterateIdeal hAvars hAirr hMorder hMnot
    hQorder hasc
  have hdvd := MvPolynomialPrimitive.dvd_of_fraction_map_dvd hAprim hA0 hdvdK
  have hequivdvd : differentialPolynomialTwoBlockSwap F A ∣
      differentialPolynomialTwoBlockSwap F Q := by
    have := map_dvd (differentialPolynomialTwoBlockEquiv F).symm.toRingHom hdvd
    simpa using this
  obtain ⟨T, hT⟩ := hequivdvd
  refine ⟨differentialPolynomialTwoBlockSwap F T, ?_⟩
  have hswapinv := congrArg (differentialPolynomialTwoBlockSwap F) hT
  rw [map_mul] at hswapinv
  rwa [differentialPolynomialTwoBlockSwap_swap, differentialPolynomialTwoBlockSwap_swap] at hswapinv

end

end GaloisForLFunctions
