import GaloisForLFunctions.HTGeometry.GammaLatticeNormalForm
import GaloisForLFunctions.HTGeometry.WeldCircleFaithfulness

/-!
# Prime-log lattice shifts satisfy the lattice condition

Shifts drawn from the group generated by the prime logarithms carry no nonzero integer combination
that is an integer: the transcendence of `e` forbids it.  This discharges the hypothesis of the
lattice normal-form datum for the shift set the archimedean cards use.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions.RHTower

noncomputable section

/-- **A family of prime-log lattice elements satisfies the lattice condition.** -/
theorem noNonzeroIntegerValue_primeLog {rr : ℕ} (mm : Fin rr → (Nat.Primes →₀ ℤ))
    (lamf : Fin rr → ℝ) (hlamf : ∀ k, lamf k = primeLogHom (mm k)) :
    NoNonzeroIntegerValue lamf := by
  intro n m hsum
  have hcomb : primeLogHom (∑ k, n k • mm k) = ∑ k, (n k : ℝ) * lamf k := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_zsmul, hlamf k, zsmul_eq_mul]
  rw [hsum, primeLogHom_apply] at hcomb
  obtain ⟨hm, -⟩ := primeLog_indep_mod_one _ m hcomb
  rw [hsum, hm]
  simp

/-- **The boundary datum of an arbitrary element of the prime-log shifted Gamma field.**  This is
the normal-form law of the archimedean cards with `NoIntegerRelation` removed: the shifts are
allowed to be an arbitrary finite family drawn from the group generated by the prime logarithms,
where that hypothesis is false. -/
theorem exists_hasShiftTubeDatum_primeLogGammaQuotient {M : ℝ} (hM : 0 < M) {r K Mm Mm' : ℕ}
    (hMm : 0 < Mm) (hMm' : 0 < Mm') (mm : Fin r → (Nat.Primes →₀ ℤ)) (lam : Fin r → ℝ)
    (hlamval : ∀ k, lam k = primeLogHom (mm k)) (hlam : ∀ i, 0 ≤ lam i)
    (hincong : ∀ i i', i ≠ i' → ∀ n : ℤ, ((lam i : ℝ) : ℂ) - ((lam i' : ℝ) : ℂ) ≠ (n : ℂ))
    (idx : Fin K → Fin r × ℕ) (hinj : Function.Injective idx)
    (ee : Fin Mm → Fin r → ℕ) (hee : Function.Injective ee)
    (P : Fin Mm → MvPolynomial (Fin K) (Polynomial ℂ)) (hP : ∀ i, P i ≠ 0)
    (ee' : Fin Mm' → Fin r → ℕ) (hee' : Function.Injective ee')
    (P' : Fin Mm' → MvPolynomial (Fin K) (Polynomial ℂ)) (hP' : ∀ i, P' i ≠ 0) :
    ∃ (d : ℤ) (ω : ℝ) (b : ℤ) (c : ℂ), c ≠ 0 ∧
      HasShiftTubeDatum M 0
        (fun σ t =>
          (∑ α : Fin Mm, jetFieldPolyFun lam idx (P α) ((σ : ℂ) + (t : ℂ) * Complex.I)
            * ∏ k : Fin r, gammaLine (σ + lam k) t ^ ee α k)
          / ∑ α : Fin Mm', jetFieldPolyFun lam idx (P' α) ((σ : ℂ) + (t : ℂ) * Complex.I)
            * ∏ k : Fin r, gammaLine (σ + lam k) t ^ ee' α k) d ω b c :=
  exists_hasShiftTubeDatum_jetGammaLatticeQuotient hM hMm hMm' lam hlam
    (noNonzeroIntegerValue_primeLog mm lam hlamval) hincong idx hinj ee hee P hP ee' hee' P' hP'

end

end GaloisForLFunctions.HTGeometry
