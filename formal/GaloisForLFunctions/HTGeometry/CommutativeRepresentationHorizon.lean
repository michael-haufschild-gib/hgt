import GaloisForLFunctions.HTGeometry.AlgebraicDirectionHorizon
import GaloisForLFunctions.HTGeometry.SymmetricAlgebraDerivation

/-!
# The general commutative-representation horizon theorem

Let a commutative principal-symbol algebra `A` act linearly on an arbitrary state space `M`.
Neither `M` nor the representation is assumed finite-dimensional, faithful, cyclic, graded, or
reduced.  Fix one observable root `m`.  Its complete directional state orbit is generated by
powers of the represented law element.

The decisive reduction is intrinsic: although the ambient representation may contain arbitrarily
many hidden sectors, the orbit visible from one root is the cyclic quotient

`A / Ann(m)`.

The quotient embeds linearly into `M`, so the complete state orbit is linearly independent exactly
when the law class in this quotient is transcendental.  After passing to the symmetric observable
algebra, this is exactly algebraic independence of the actual iterated differential jet.
Consequently the complete dependence horizon of every one-root autonomous commutative linear
principal-symbol model is a vector subspace of law space.

This removes ambient non-cyclicity as a possible escape from the cyclic horizon theorem.  A
nonlinear one-observable horizon requires structure beyond an autonomous commutative linear
representation: for example noncommutativity, nonlinear generator action, several coupled roots,
or a prolonged constraint complex.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u v w x

variable {K : Type u} {A : Type v} {M : Type w}
  [Field K] [CommRing A] [Algebra K A]
  [AddCommGroup M] [Module K M]

/-- Evaluation of the represented principal-symbol algebra on one distinguished root. -/
def commutativeRepresentationOrbitMap
    (ρ : A →ₐ[K] Module.End K M) (m : M) : A →ₗ[K] M where
  toFun a := ρ a m
  map_add' a b := by simp
  map_smul' c a := by simp

/-- Principal-symbol laws annihilating the distinguished root. -/
def commutativeRepresentationAnnihilator
    (ρ : A →ₐ[K] Module.End K M) (m : M) : Ideal A where
  carrier := {a | ρ a m = 0}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    change ρ a m = 0 at ha
    change ρ b m = 0 at hb
    simp [ha, hb]
  smul_mem' := by
    intro a b hb
    change ρ (a * b) m = 0
    rw [map_mul, Module.End.mul_apply, hb]
    simp

/-- The annihilator is exactly the kernel of root evaluation, after restricting scalars to `K`. -/
theorem commutativeRepresentationOrbitMap_ker
    (ρ : A →ₐ[K] Module.End K M) (m : M) :
    LinearMap.ker (commutativeRepresentationOrbitMap ρ m) =
      (commutativeRepresentationAnnihilator ρ m).restrictScalars K := by
  rfl

/-- The cyclic quotient visible from the root embeds into the full hidden state space. -/
def commutativeRepresentationCyclicEmbedding
    (ρ : A →ₐ[K] Module.End K M) (m : M) :
    (A ⧸ commutativeRepresentationAnnihilator ρ m) →ₗ[K] M :=
  ((commutativeRepresentationAnnihilator ρ m).restrictScalars K).liftQ
    (commutativeRepresentationOrbitMap ρ m)
    (le_of_eq (commutativeRepresentationOrbitMap_ker ρ m).symm)

/-- The visible cyclic quotient has no further kernel inside the ambient representation. -/
theorem commutativeRepresentationCyclicEmbedding_ker_eq_bot
    (ρ : A →ₐ[K] Module.End K M) (m : M) :
    LinearMap.ker (commutativeRepresentationCyclicEmbedding ρ m) = ⊥ := by
  exact Submodule.ker_liftQ_eq_bot'
    ((commutativeRepresentationAnnihilator ρ m).restrictScalars K)
    (commutativeRepresentationOrbitMap ρ m)
    (commutativeRepresentationOrbitMap_ker ρ m).symm

@[simp]
theorem commutativeRepresentationCyclicEmbedding_mk
    (ρ : A →ₐ[K] Module.End K M) (m : M) (a : A) :
    commutativeRepresentationCyclicEmbedding ρ m
        (Ideal.Quotient.mk (commutativeRepresentationAnnihilator ρ m) a) =
      ρ a m := by
  rw [← Ideal.Quotient.mk_eq_mk]
  rfl

@[simp]
theorem commutativeRepresentationCyclicEmbedding_power
    (ρ : A →ₐ[K] Module.End K M) (m : M) (a : A) (n : ℕ) :
    commutativeRepresentationCyclicEmbedding ρ m
        ((Ideal.Quotient.mk (commutativeRepresentationAnnihilator ρ m) a) ^ n) =
      ((ρ a) ^ n) m := by
  change commutativeRepresentationCyclicEmbedding ρ m
      (((Ideal.Quotient.mkₐ K (commutativeRepresentationAnnihilator ρ m)) a) ^ n) = _
  rw [← map_pow]
  rw [Ideal.Quotient.mkₐ_eq_mk, commutativeRepresentationCyclicEmbedding_mk, map_pow]

/-- **Cyclic reduction theorem.**  The complete power orbit seen from one root is linearly
independent exactly when the corresponding class in the root-annihilator quotient is
transcendental.  No cyclicity assumption on the ambient representation is needed. -/
theorem commutativeRepresentationPowerState_linearIndependent_iff_transcendental
    (ρ : A →ₐ[K] Module.End K M) (m : M) (a : A) :
    LinearIndependent K (fun n : ℕ => ((ρ a) ^ n) m) ↔
      Transcendental K
        (Ideal.Quotient.mk (commutativeRepresentationAnnihilator ρ m) a) := by
  let I := commutativeRepresentationAnnihilator ρ m
  let E := commutativeRepresentationCyclicEmbedding ρ m
  let q := Ideal.Quotient.mk I a
  constructor
  · intro h
    have hq : LinearIndependent K (fun n : ℕ => q ^ n) := by
      apply LinearIndependent.of_comp E
      simpa [E, q, I, Function.comp_def] using h
    exact (linearIndependent_powers_iff_transcendental q).mp hq
  · intro h
    have hq : LinearIndependent K (fun n : ℕ => q ^ n) :=
      (linearIndependent_powers_iff_transcendental q).mpr h
    have himage := hq.map' E
      (commutativeRepresentationCyclicEmbedding_ker_eq_bot ρ m)
    simpa [E, q, I, Function.comp_def] using himage

variable {V : Type x} [AddCommGroup V] [Module K V]

/-- The law map followed by the intrinsic quotient visible from the chosen root. -/
def commutativeRepresentationQuotientLawMap
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A) :
    V →ₗ[K] A ⧸ commutativeRepresentationAnnihilator ρ m :=
  (Ideal.Quotient.mkₐ K (commutativeRepresentationAnnihilator ρ m)).toLinearMap.comp L

/-- Directions whose visible principal-symbol class is algebraic over the base field. -/
def commutativeRepresentationHorizon
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A) :
    Submodule K V :=
  algebraicDirectionHorizon (commutativeRepresentationQuotientLawMap ρ m L)

/-- The derivation of the symmetric observable algebra selected by one law direction. -/
def commutativeRepresentationDirectionalDerivation
    (ρ : A →ₐ[K] Module.End K M) (L : V →ₗ[K] A) (v : V) :
    Derivation K (SymmetricAlgebra K M) (SymmetricAlgebra K M) :=
  symmetricAlgebraDerivation (ρ (L v))

/-- The actual complete iterated differential jet of the chosen root observable. -/
def commutativeRepresentationJet
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A)
    (v : V) (n : ℕ) : SymmetricAlgebra K M :=
  ((commutativeRepresentationDirectionalDerivation ρ L v :
      SymmetricAlgebra K M → SymmetricAlgebra K M)^[n])
    (SymmetricAlgebra.ι K M m)

/-- Iterated observable differentiation is exactly the represented principal-symbol power orbit. -/
theorem commutativeRepresentationJet_eq_powerObservable
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A)
    (v : V) : ∀ n : ℕ,
    commutativeRepresentationJet ρ m L v n =
      SymmetricAlgebra.ι K M (((ρ (L v)) ^ n) m) := by
  intro n
  induction n with
  | zero => simp [commutativeRepresentationJet]
  | succ n ih =>
      rw [commutativeRepresentationJet, Function.iterate_succ_apply',
        ← commutativeRepresentationJet, ih]
      rw [commutativeRepresentationDirectionalDerivation,
        symmetricAlgebraDerivation_ι]
      simp [pow_succ', Module.End.mul_apply]

/-- The actual differential jet is algebraically independent precisely off the algebraic locus of
the intrinsic root-annihilator quotient. -/
theorem commutativeRepresentationJet_algebraicIndependent_iff_transcendental
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A) (v : V) :
    AlgebraicIndependent K (commutativeRepresentationJet ρ m L v) ↔
      Transcendental K
        (Ideal.Quotient.mk (commutativeRepresentationAnnihilator ρ m) (L v)) := by
  have hjet : commutativeRepresentationJet ρ m L v =
      fun n : ℕ => SymmetricAlgebra.ι K M (((ρ (L v)) ^ n) m) :=
    funext (commutativeRepresentationJet_eq_powerObservable ρ m L v)
  rw [hjet, symmetricAlgebra_ι_algebraicIndependent_iff_linearIndependent]
  exact commutativeRepresentationPowerState_linearIndependent_iff_transcendental
    ρ m (L v)

/-- Horizon membership is algebraicity of the intrinsic visible law class. -/
theorem mem_commutativeRepresentationHorizon_iff
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A) (v : V) :
    v ∈ commutativeRepresentationHorizon ρ m L ↔
      IsAlgebraic K
        (Ideal.Quotient.mk (commutativeRepresentationAnnihilator ρ m) (L v)) := by
  rw [commutativeRepresentationHorizon, mem_algebraicDirectionHorizon_iff]
  simp [commutativeRepresentationQuotientLawMap, Ideal.Quotient.mkₐ_eq_mk]

/-- **General autonomous commutative principal-symbol horizon theorem.**  For an arbitrary
commutative algebra represented on an arbitrary hidden state space, the complete algebraic-
dependence horizon of one actual differential root is exactly the carrier of a vector subspace. -/
theorem commutativeRepresentation_dependenceHorizon_eq_submodule
    (ρ : A →ₐ[K] Module.End K M) (m : M) (L : V →ₗ[K] A) :
    {v : V | ¬ AlgebraicIndependent K (commutativeRepresentationJet ρ m L v)} =
      (commutativeRepresentationHorizon ρ m L : Set V) := by
  ext v
  rw [Set.mem_setOf_eq,
    commutativeRepresentationJet_algebraicIndependent_iff_transcendental]
  simpa [Transcendental] using
    (mem_commutativeRepresentationHorizon_iff ρ m L v).symm

end


end GaloisForLFunctions.HTGeometry
