import GaloisForLFunctions.HTGeometry.MeromorphicTranslation
import GaloisForLFunctions.HTGeometry.RankThreePeriods
import Mathlib.Analysis.Calculus.Deriv.Inv

/-!
# Fixed fields of meromorphic translation actions

A meromorphic germ fixed by arbitrarily small nonzero translations is
constant. Consequently the common fixed field of a rank-three translation
lattice generated by three Q-linearly independent complex periods is
exactly the embedded constant field.
-/

open Filter Topology Set Function
open scoped Differential

namespace GaloisForLFunctions

open Bottcher

noncomputable section

local instance univAnalyticDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

theorem translation_fixed_cross
    (q : ℂ) (a b : analyticSubring (Set.univ : Set ℂ)) (hb : b ≠ 0)
    (hfix : addTranslationMeroEquiv q
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
          algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) :
    addTranslationAnalyticEquiv q a * b =
      a * addTranslationAnalyticEquiv q b := by
  have hbF : algebraMap (analyticSubring Set.univ) (meroField Set.univ) b ≠ 0 :=
    fun h => hb ((IsFractionRing.injective (analyticSubring Set.univ)
      (meroField Set.univ)) (by simpa using h))
  have hsbA : addTranslationAnalyticEquiv q b ≠ 0 :=
    fun h => hb ((addTranslationAnalyticEquiv q).injective (by simpa using h))
  have hsb : algebraMap (analyticSubring Set.univ) (meroField Set.univ)
      (addTranslationAnalyticEquiv q b) ≠ 0 :=
    fun h => hsbA ((IsFractionRing.injective (analyticSubring Set.univ)
      (meroField Set.univ)) (by simpa using h))
  rw [map_div₀, addTranslationMeroEquiv_algebraMap,
    addTranslationMeroEquiv_algebraMap] at hfix
  have hcross := (div_eq_div_iff hsb hbF).mp hfix
  apply (IsFractionRing.injective (analyticSubring Set.univ)
    (meroField Set.univ))
  simpa only [map_mul] using hcross

theorem translation_fixed_cross_eqOn
    (q : ℂ) (a b : analyticSubring (Set.univ : Set ℂ)) (hb : b ≠ 0)
    {f g : ℂ → ℂ}
    (hfa : (Germ.coeRingHom (𝓟 Set.univ)) f = (a : Germ (𝓟 Set.univ) ℂ))
    (hgb : (Germ.coeRingHom (𝓟 Set.univ)) g = (b : Germ (𝓟 Set.univ) ℂ))
    (hfix : addTranslationMeroEquiv q
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
          algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) :
    Set.EqOn (fun z ↦ f (z + q) * g z) (fun z ↦ f z * g (z + q)) Set.univ := by
  have hcross := translation_fixed_cross q a b hb hfix
  have hv := congrArg Subtype.val hcross
  let htr : Tendsto (addTranslation q) (𝓟 Set.univ) (𝓟 Set.univ) :=
    tendsto_principal_principal.mpr (Set.mapsTo_univ _ _)
  change
    ((a : Germ (𝓟 Set.univ) ℂ).compTendsto (addTranslation q) htr *
      (b : Germ (𝓟 Set.univ) ℂ)) =
      (a : Germ (𝓟 Set.univ) ℂ) *
        (b : Germ (𝓟 Set.univ) ℂ).compTendsto (addTranslation q) htr at hv
  rw [← hfa, ← hgb] at hv
  change Germ.ofFun (l := 𝓟 Set.univ) (fun z ↦ f (z + q) * g z) =
    Germ.ofFun (l := 𝓟 Set.univ) (fun z ↦ f z * g (z + q)) at hv
  rw [Germ.coe_eq] at hv
  exact eventually_principal.mp hv

theorem quotientWronskian_eq_zero_of_small_translation_fixed
    (a b : analyticSubring (Set.univ : Set ℂ)) (hb : b ≠ 0)
    {f g : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f Set.univ)
    (hg : AnalyticOnNhd ℂ g Set.univ)
    (hfa : (Germ.coeRingHom (𝓟 Set.univ)) f = (a : Germ (𝓟 Set.univ) ℂ))
    (hgb : (Germ.coeRingHom (𝓟 Set.univ)) g = (b : Germ (𝓟 Set.univ) ℂ))
    (p : ℕ → ℂ) (hp0 : Tendsto p atTop (𝓝 0)) (hpne : ∀ n, p n ≠ 0)
    (hfix : ∀ n, addTranslationMeroEquiv (p n)
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
          algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) :
    Set.EqOn (fun z ↦ deriv f z * g z - f z * deriv g z) 0 Set.univ := by
  let N : ℂ → ℂ := fun z ↦ deriv f z * g z - f z * deriv g z
  have hN : AnalyticOnNhd ℂ N Set.univ := (hf.deriv.mul hg).sub (hf.mul hg.deriv)
  have hgne : ¬ Set.EqOn g 0 Set.univ := by
    intro hg0
    apply hb
    apply Subtype.ext
    rw [← hgb, ZeroMemClass.coe_zero]
    change Germ.ofFun (l := 𝓟 Set.univ) g =
      Germ.ofFun (l := 𝓟 Set.univ) (fun _ : ℂ ↦ 0)
    rw [Germ.coe_eq]
    exact eventually_principal.mpr hg0
  obtain ⟨w₀, hw₀⟩ : ∃ w₀, g w₀ ≠ 0 := by
    by_contra h
    push Not at h
    exact hgne (fun z _ => h z)
  have hlocal : ∀ w, g w ≠ 0 → N w = 0 := by
    intro w hgw
    have hpwithin : Tendsto p atTop (𝓝[≠] 0) := by
      exact tendsto_nhdsNE_of_forall_ne hp0 hpne
    let h : ℂ → ℂ := fun z ↦ f z / g z
    have hhan : AnalyticAt ℂ h w := (hf w (Set.mem_univ w)).div
      (hg w (Set.mem_univ w)) hgw
    have hslope := hhan.differentiableAt.hasDerivAt.tendsto_slope_zero.comp hpwithin
    have hgne_event : ∀ᶠ n in atTop, g (w + p n) ≠ 0 := by
      have ht : Tendsto (fun n ↦ w + p n) atTop (𝓝 w) := by
        simpa using (tendsto_const_nhds.add hp0 :
          Tendsto (fun n ↦ w + p n) atTop (𝓝 (w + 0)))
      exact ht.eventually ((hg w (Set.mem_univ w)).continuousAt.eventually_ne hgw)
    have hzero : ∀ᶠ n in atTop,
        (p n)⁻¹ * (h (w + p n) - h w) = 0 := by
      filter_upwards [hgne_event] with n hgn
      have hcross := translation_fixed_cross_eqOn (p n) a b hb hfa hgb (hfix n)
      have hwcross := hcross (Set.mem_univ w)
      have hquot : h (w + p n) = h w := by
        dsimp only [h]
        apply (div_eq_div_iff hgn hgw).mpr
        simpa [mul_comm] using hwcross
      rw [hquot, sub_self, mul_zero]
    have hderiv0 : deriv h w = 0 := by
      apply tendsto_nhds_unique hslope
      exact (tendsto_congr' hzero).mpr tendsto_const_nhds
    change deriv (f / g) w = 0 at hderiv0
    rw [deriv_div (hf w (Set.mem_univ w)).differentiableAt
      (hg w (Set.mem_univ w)).differentiableAt hgw] at hderiv0
    have hnum : deriv f w * g w - f w * deriv g w = 0 :=
      (div_eq_zero_iff.mp hderiv0).resolve_right (pow_ne_zero 2 hgw)
    exact hnum
  have hevent : N =ᶠ[𝓝 w₀] 0 := by
    filter_upwards [(hg w₀ (Set.mem_univ w₀)).continuousAt.eventually_ne hw₀] with w hw
    exact hlocal w hw
  exact hN.eqOn_of_preconnected_of_eventuallyEq analyticOnNhd_const
    isPreconnected_univ (Set.mem_univ w₀) hevent

theorem exists_constant_of_quotientWronskian_eq_zero
    (a b : analyticSubring (Set.univ : Set ℂ)) (hb : b ≠ 0)
    {f g : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f Set.univ)
    (hg : AnalyticOnNhd ℂ g Set.univ)
    (hfa : (Germ.coeRingHom (𝓟 Set.univ)) f = (a : Germ (𝓟 Set.univ) ℂ))
    (hgb : (Germ.coeRingHom (𝓟 Set.univ)) g = (b : Germ (𝓟 Set.univ) ℂ))
    (hN : Set.EqOn (fun z ↦ deriv f z * g z - f z * deriv g z) 0 Set.univ) :
    ∃ c : ℂ, algebraMap (analyticSubring Set.univ) (meroField Set.univ)
        (constToAnalytic Set.univ c) =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b := by
  have hgne : ¬ Set.EqOn g 0 Set.univ := by
    intro hg0
    apply hb
    apply Subtype.ext
    rw [← hgb, ZeroMemClass.coe_zero]
    change Germ.ofFun (l := 𝓟 Set.univ) g =
      Germ.ofFun (l := 𝓟 Set.univ) (fun _ : ℂ ↦ 0)
    rw [Germ.coe_eq]
    exact eventually_principal.mpr hg0
  obtain ⟨w₀, hw₀⟩ : ∃ w₀, g w₀ ≠ 0 := by
    by_contra h
    push Not at h
    exact hgne (fun z _ => h z)
  let c : ℂ := f w₀ / g w₀
  let h : ℂ → ℂ := fun z ↦ f z / g z
  have hVmem : {z : ℂ | g z ≠ 0} ∈ 𝓝 w₀ :=
    (hg w₀ (Set.mem_univ w₀)).continuousAt.eventually_ne hw₀
  rw [Metric.mem_nhds_iff] at hVmem
  obtain ⟨ε, hε, hball⟩ := hVmem
  let V := Metric.ball w₀ ε
  have hVo : IsOpen V := Metric.isOpen_ball
  have hVpc : IsPreconnected V := convex_ball w₀ ε |>.isPreconnected
  have hwV : w₀ ∈ V := Metric.mem_ball_self hε
  have hgV : ∀ z ∈ V, g z ≠ 0 := fun z hz ↦ hball hz
  have hhdiff : DifferentiableOn ℂ h V := by
    intro z hz
    exact ((hf z (Set.mem_univ z)).div
      (hg z (Set.mem_univ z)) (hgV z hz)).differentiableAt.differentiableWithinAt
  have hcdiff : DifferentiableOn ℂ (fun _ : ℂ ↦ c) V := differentiableOn_const c
  have hfderiv : ∀ z ∈ V,
      fderiv ℂ h z = fderiv ℂ (fun _ : ℂ ↦ c) z := by
    intro z hz
    have hderiv : deriv h z = 0 := by
      change deriv (f / g) z = 0
      rw [deriv_div (hf z (Set.mem_univ z)).differentiableAt
        (hg z (Set.mem_univ z)).differentiableAt (hgV z hz)]
      have hn := hN (Set.mem_univ z)
      change deriv f z * g z - f z * deriv g z = 0 at hn
      rw [hn, zero_div]
    rw [← toSpanSingleton_deriv, hderiv]
    simp
  have hhconst : Set.EqOn h (fun _ : ℂ ↦ c) V :=
    hVo.eqOn_of_fderiv_eq hVpc hhdiff hcdiff hfderiv hwV (by simp [h, c])
  have hfgV : Set.EqOn f (fun z ↦ c * g z) V := by
    intro z hz
    have hzq := hhconst hz
    dsimp only [h] at hzq
    exact (div_eq_iff (hgV z hz)).mp hzq
  have hfg : Set.EqOn f (fun z ↦ c * g z) Set.univ :=
    Bottcher.analyticOnNhd_eqOn_of_eqOn_isOpen hf
      (analyticOnNhd_const.mul hg) isPreconnected_univ
      (Set.subset_univ V) hVo ⟨w₀, hwV⟩ hfgV
  have hab : a = constToAnalytic Set.univ c * b := by
    apply Subtype.ext
    rw [← hfa]
    change Germ.ofFun (l := 𝓟 Set.univ) f =
      ((constToAnalytic Set.univ c : analyticSubring Set.univ) :
        Germ (𝓟 Set.univ) ℂ) * (b : Germ (𝓟 Set.univ) ℂ)
    rw [← hgb]
    change Germ.ofFun (l := 𝓟 Set.univ) f =
      Germ.ofFun (l := 𝓟 Set.univ) (fun z ↦ c * g z)
    rw [Germ.coe_eq]
    exact eventually_principal.mpr hfg
  refine ⟨c, ?_⟩
  rw [hab, map_mul, mul_div_cancel_right₀]
  exact fun hzero => hb ((IsFractionRing.injective (analyticSubring Set.univ)
    (meroField Set.univ)) (by simpa using hzero))

/-- An element of the global meromorphic germ field fixed by arbitrarily
small nonzero translations is constant. -/
theorem exists_constant_of_small_translation_fixed
    (z : meroField (Set.univ : Set ℂ))
    (p : ℕ → ℂ) (hp0 : Tendsto p atTop (𝓝 0)) (hpne : ∀ n, p n ≠ 0)
    (hfix : ∀ n, addTranslationMeroEquiv (p n) z = z) :
    ∃ c : ℂ, algebraMap (analyticSubring Set.univ) (meroField Set.univ)
        (constToAnalytic Set.univ c) = z := by
  obtain ⟨a, b, hbmem, hab⟩ :=
    IsFractionRing.div_surjective (analyticSubring Set.univ) z
  have hb : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hbmem
  obtain ⟨f, hf, hfa⟩ := a.2
  obtain ⟨g, hg, hgb⟩ := b.2
  have hfix' : ∀ n, addTranslationMeroEquiv (p n)
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
          algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b := by
    intro n
    rw [hab]
    exact hfix n
  have hN := quotientWronskian_eq_zero_of_small_translation_fixed
    a b hb hf hg hfa hgb p hp0 hpne hfix'
  obtain ⟨c, hc⟩ := exists_constant_of_quotientWronskian_eq_zero
    a b hb hf hg hfa hgb hN
  exact ⟨c, hc.trans hab⟩

/-- The common fixed field of the full rank-three translation lattice in the
global meromorphic germ field is the constant field. -/
theorem exists_constant_of_rankThree_translation_fixed
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (z : meroField (Set.univ : Set ℂ))
    (hfix : ∀ q ∈ Submodule.span ℤ (Set.range v),
      addTranslationMeroEquiv q z = z) :
    ∃ c : ℂ, algebraMap (analyticSubring Set.univ) (meroField Set.univ)
        (constToAnalytic Set.univ c) = z := by
  obtain ⟨p, hp_mem, hp_ne, hp_zero⟩ := exists_small_rankThree_periods v hv
  exact exists_constant_of_small_translation_fixed z p hp_zero hp_ne
    (fun n ↦ hfix (p n) (hp_mem n))

end

end GaloisForLFunctions
