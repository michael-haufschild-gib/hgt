import GaloisForLFunctions.HTGeometry.DifferentialAdjoinFiniteTrdeg
import GaloisForLFunctions.HTGeometry.FormalMahlerIntegerNormalization

/-!
# Finite jet constraints expose an infinite differential source

A finite algebraic constraint on the observed jet of `y` cannot produce a
hypertranscendental observable from a derivation-closed coefficient field of finite
transcendence degree.  Equivalently, if a hypertranscendental observable satisfies such a
constraint, then its coefficient reservoir has transcendence degree at least `aleph0`.

This is a constraint theorem, not an ODE evolution theorem: no existence, uniqueness, or
propagation claim is made.  It applies to any nonzero polynomial identity in a finite jet.  Thus
it contains finite-order Picard--Fuchs and Schwinger--Dyson reductions, minisuperspace
Wheeler--DeWitt equations, finite reaction-network and gene-regulation identities, and learned
differential equations whenever their exact coefficients live in the stated field.

The singleton specialization gives a positive source theorem.  If the coefficient field is
generated differentially by one input `h`, then a hypertranscendental output forces `h` itself to
be hypertranscendental.  The result is parent differential algebra; its value here is the exact
observability boundary and the reusable source-extraction interface.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A finite jet constraint over a derivation-closed intermediate field of finite transcendence
degree makes the constrained observable differentially algebraic over the base field. -/
theorem differentialAlgebraicOver_of_finiteJetConstraint_over_intermediate
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (S : IntermediateField F E) (hSclosed : DerivationClosed S)
    (hSfinite : Algebra.trdeg F S < Cardinal.aleph0)
    {y : E} {n : ℕ} {Q : MvPolynomial (Fin (n + 1)) S}
    (hQ : Q ≠ 0)
    (hann : MvPolynomial.aeval
      (fun j : Fin (n + 1) => differentialJet (j : ℕ) y) Q = 0) :
    DifferentialAlgebraicOver F y := by
  apply differentialAlgebraicOver_of_intermediate_trdeg_lt_aleph0
    S hSclosed hSfinite
  exact differentialAlgebraicOver_of_finiteJetRelation hQ hann

/-- **Quantitative positive residue.**  A finite jet constraint on a hypertranscendental
observable forces its derivation-closed coefficient reservoir to have infinite transcendence
degree over the base field. -/
theorem infinite_trdeg_of_hypertranscendentalOver_finiteJetConstraint
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {y : E} (hy : HypertranscendentalOver F y)
    (S : IntermediateField F E) (hSclosed : DerivationClosed S)
    {n : ℕ} {Q : MvPolynomial (Fin (n + 1)) S}
    (hQ : Q ≠ 0)
    (hann : MvPolynomial.aeval
      (fun j : Fin (n + 1) => differentialJet (j : ℕ) y) Q = 0) :
    Cardinal.aleph0 ≤ Algebra.trdeg F S := by
  by_contra hnot
  have hSfinite : Algebra.trdeg F S < Cardinal.aleph0 :=
    lt_of_not_ge hnot
  exact hy (differentialAlgebraicOver_of_finiteJetConstraint_over_intermediate
    S hSclosed hSfinite hQ hann)

/-- A finite jet constraint whose coefficients lie in the differential field generated by a
differentially algebraic input has a differentially algebraic output. -/
theorem differentialAlgebraicOver_of_finiteJetConstraint_over_singleton
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hh : DifferentialAlgebraicOver F h)
    {n : ℕ}
    {Q : MvPolynomial (Fin (n + 1))
      (differentialAdjoin F ({h} : Set E))}
    (hQ : Q ≠ 0)
    (hann : MvPolynomial.aeval
      (fun j : Fin (n + 1) => differentialJet (j : ℕ) y) Q = 0) :
    DifferentialAlgebraicOver F y := by
  apply differentialAlgebraicOver_trans hh
  exact differentialAlgebraicOver_of_finiteJetRelation hQ hann

/-- **Positive singleton source extraction.**  If a hypertranscendental observable satisfies a
finite jet constraint over the differential field generated by `h`, then `h` is itself
hypertranscendental. -/
theorem hypertranscendentalOver_input_of_finiteJetConstraint
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hy : HypertranscendentalOver F y)
    {n : ℕ}
    {Q : MvPolynomial (Fin (n + 1))
      (differentialAdjoin F ({h} : Set E))}
    (hQ : Q ≠ 0)
    (hann : MvPolynomial.aeval
      (fun j : Fin (n + 1) => differentialJet (j : ℕ) y) Q = 0) :
    HypertranscendentalOver F h := by
  intro hh
  exact hy (differentialAlgebraicOver_of_finiteJetConstraint_over_singleton
    hh hQ hann)

end

end GaloisForLFunctions.HTGeometry
