import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.RingTheory.Noetherian.Basic
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.Ideal.Quotient.Noetherian
import Mathlib.LinearAlgebra.FreeModule.Basic
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.LinearAlgebra.FreeModule.Finite.Basic
import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.RingTheory.QuotSMulTop

/-!
# A regular generating sequence of the maximal ideal makes a finite module free

Let `(A, 𝔪)` be a Noetherian local ring and `M` a finite `A`-module.  If some list `rs` with
`Ideal.ofList rs = 𝔪` is weakly regular on `M`, then `M` is free.

The proof is the classical induction on the length of `rs`, and it needs neither the Koszul complex
nor `Tor`: after quotienting by the first element `x` the induction hypothesis makes `M/xM` free
over `A/(x)`; a lift of a basis generates `M` by Nakayama, and the kernel `K` of the resulting
presentation satisfies `K ⊆ xK` because `x` is `M`-regular, hence vanishes by Nakayama again.

mathlib has regular sequences but no Cohen–Macaulay theory, so this statement — the "local criterion"
in the only form the horizon's étale/Kummer argument needs — has to be built here.
-/

namespace GaloisForLFunctions.HTGeometry

open RingTheory.Sequence
open scoped Pointwise

universe u v

/-- **A finite module carrying a regular generating sequence of the maximal ideal is free.**
Over a Noetherian local ring, if some list generating the maximal ideal is weakly regular on a
finite module, that module is free. -/
theorem free_of_isWeaklyRegular_of_ofList_eq_maximalIdeal :
    ∀ (d : ℕ) {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
      {rs : List A}, rs.length = d →
      ∀ {M : Type v} [AddCommGroup M] [Module A M] [Module.Finite A M],
      Ideal.ofList rs = IsLocalRing.maximalIdeal A →
      IsWeaklyRegular M rs →
      Module.Free A M := by
  intro d
  induction d with
  | zero =>
      intro A _ _ _ rs hlen M _ _ _ hspan _
      have hrs : rs = [] := List.eq_nil_of_length_eq_zero hlen
      subst hrs
      have hbot : IsLocalRing.maximalIdeal A = ⊥ := by
        rw [← hspan, Ideal.ofList_nil]
      letI : Field A := (IsLocalRing.isField_iff_maximalIdeal_eq.2 hbot).toField
      exact Module.Free.of_divisionRing A M
  | succ d ih =>
      intro A _ _ _ rs hlen M _ _ _ hspan hreg
      obtain ⟨x, rs', rfl⟩ : ∃ x rs', rs = x :: rs' := by
        cases rs with
        | nil => simp at hlen
        | cons a l => exact ⟨a, l, rfl⟩
      -- split the regular sequence
      rw [isWeaklyRegular_cons_iff'] at hreg
      obtain ⟨hx, hreg'⟩ := hreg
      -- `x` lies in the maximal ideal
      have hxm : x ∈ IsLocalRing.maximalIdeal A := by
        rw [← hspan]
        exact Ideal.subset_span (by simp)
      have hspan_le : Ideal.span ({x} : Set A) ≤ IsLocalRing.maximalIdeal A := by
        rw [Ideal.span_le]
        simpa using hxm
      have hne : Ideal.span ({x} : Set A) ≠ ⊤ := by
        intro h
        rw [h, top_le_iff] at hspan_le
        exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top hspan_le
      haveI : Nontrivial (A ⧸ Ideal.span ({x} : Set A)) :=
        Ideal.Quotient.nontrivial_iff.2 hne
      haveI : IsLocalRing (A ⧸ Ideal.span ({x} : Set A)) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
      haveI : Module.Finite A (QuotSMulTop x M) := inferInstance
      haveI : Module.Finite (A ⧸ Ideal.span ({x} : Set A)) (QuotSMulTop x M) :=
        Module.Finite.of_restrictScalars_finite A _ _
      -- the maximal ideal of the quotient is generated by the tail
      have hmkx : Ideal.Quotient.mk (Ideal.span ({x} : Set A)) x = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)
      have hspan' : Ideal.ofList (rs'.map (Ideal.Quotient.mk (Ideal.span ({x} : Set A))))
          = IsLocalRing.maximalIdeal (A ⧸ Ideal.span ({x} : Set A)) := by
        rw [← IsLocalRing.map_maximalIdeal_of_surjective
            (Ideal.Quotient.mk (Ideal.span ({x} : Set A))) Ideal.Quotient.mk_surjective,
          ← hspan, Ideal.ofList_cons, Ideal.map_sup, Ideal.map_span, Ideal.map_span]
        have h1 : (Ideal.Quotient.mk (Ideal.span ({x} : Set A))) '' ({x} : Set A) = {0} := by
          simp [hmkx]
        have h2 : (Ideal.Quotient.mk (Ideal.span ({x} : Set A))) '' {r | r ∈ rs'} =
            {r | r ∈ rs'.map (Ideal.Quotient.mk (Ideal.span ({x} : Set A)))} := by
          ext y
          simp [List.mem_map]
        rw [h1, h2, Ideal.span_singleton_eq_bot.2 rfl, bot_sup_eq]
      haveI hfree' : Module.Free (A ⧸ Ideal.span ({x} : Set A)) (QuotSMulTop x M) :=
        ih (by simpa using hlen) hspan' hreg'
      classical
      haveI : Fintype (Module.Free.ChooseBasisIndex (A ⧸ Ideal.span ({x} : Set A))
          (QuotSMulTop x M)) := Module.Free.ChooseBasisIndex.fintype _ _
      set b' := Module.Free.chooseBasis (A ⧸ Ideal.span ({x} : Set A)) (QuotSMulTop x M) with hb'
      have hq : Function.Surjective (Submodule.mkQ (x • (⊤ : Submodule A M))) :=
        Submodule.mkQ_surjective _
      choose m hm using fun i => hq (b' i)
      set φ : (Module.Free.ChooseBasisIndex (A ⧸ Ideal.span ({x} : Set A))
          (QuotSMulTop x M) → A) →ₗ[A] M := Fintype.linearCombination A m with hφ
      have hIle : Ideal.span ({x} : Set A) ≤ (⊥ : Ideal A).jacobson := by
        rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top]
        exact hspan_le
      -- surjectivity
      have hIsm : (Ideal.span ({x} : Set A)) • (⊤ : Submodule A M) = x • (⊤ : Submodule A M) :=
        Submodule.ideal_span_singleton_smul x ⊤
      have hact : ∀ (c : A) (z : QuotSMulTop x M),
          c • z = (Ideal.Quotient.mk (Ideal.span ({x} : Set A)) c) • z := fun c z =>
        (algebraMap_smul (A ⧸ Ideal.span ({x} : Set A)) c z).symm
      have hrange : LinearMap.range φ = Submodule.span A (Set.range m) := by
        rw [hφ]
        exact Fintype.range_linearCombination A m
      have hspanm : Submodule.span A (Set.range m) = ⊤ := by
        have hFG : (⊤ : Submodule A M).FG := Module.finite_def.mp ‹_›
        refine top_le_iff.1 (Submodule.le_of_le_smul_of_le_jacobson_bot hFG hIle ?_)
        intro y _
        obtain ⟨c, hc⟩ : ∃ c : Module.Free.ChooseBasisIndex (A ⧸ Ideal.span ({x} : Set A))
            (QuotSMulTop x M) → A,
            ∀ i, Ideal.Quotient.mk (Ideal.span ({x} : Set A)) (c i) =
              b'.repr (Submodule.mkQ (x • (⊤ : Submodule A M)) y) i := by
          choose c hc using fun i => Ideal.Quotient.mk_surjective
            (b'.repr (Submodule.mkQ (x • (⊤ : Submodule A M)) y) i)
          exact ⟨c, hc⟩
        have hsum : Submodule.mkQ (x • (⊤ : Submodule A M)) (∑ i, c i • m i)
            = Submodule.mkQ (x • (⊤ : Submodule A M)) y := by
          rw [map_sum]
          have : ∀ i, Submodule.mkQ (x • (⊤ : Submodule A M)) (c i • m i)
              = b'.repr (Submodule.mkQ (x • (⊤ : Submodule A M)) y) i • b' i := by
            intro i
            rw [map_smul, hm i, hact, hc i]
          rw [Finset.sum_congr rfl fun i _ => this i]
          exact b'.sum_repr _
        have hmem : y - (∑ i, c i • m i) ∈ x • (⊤ : Submodule A M) := by
          have := sub_eq_zero.2 hsum.symm
          rwa [← map_sub, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
        have hy : y = (∑ i, c i • m i) + (y - (∑ i, c i • m i)) := by abel
        rw [hy]
        refine Submodule.add_mem_sup ?_ ?_
        · exact Submodule.sum_mem _ fun i _ =>
            Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
        · rw [hIsm]; exact hmem
      have hsurjφ : Function.Surjective φ := by
        rw [← LinearMap.range_eq_top, hrange, hspanm]
      -- injectivity
      have hinjφ : Function.Injective φ := by
        have hker : LinearMap.ker φ ≤ (Ideal.span ({x} : Set A)) • (LinearMap.ker φ) := by
          intro c hc
          have hc0 : ∑ i, c i • m i = 0 := by
            simpa [hφ, Fintype.linearCombination_apply] using hc
          have hzero : ∑ i, (Ideal.Quotient.mk (Ideal.span ({x} : Set A)) (c i)) • b' i = 0 := by
            have := congrArg (Submodule.mkQ (x • (⊤ : Submodule A M))) hc0
            rw [map_sum, map_zero] at this
            rw [← this]
            exact Finset.sum_congr rfl fun i _ => by rw [map_smul, hm i, hact]
          have hall : ∀ i, Ideal.Quotient.mk (Ideal.span ({x} : Set A)) (c i) = 0 :=
            Fintype.linearIndependent_iff.1 b'.linearIndependent _ hzero
          have hdvd : ∀ i, x ∣ c i := fun i =>
            Ideal.mem_span_singleton.1 (Ideal.Quotient.eq_zero_iff_mem.1 (hall i))
          choose d hd using hdvd
          have hdker : d ∈ LinearMap.ker φ := by
            have hxd : x • (∑ i, d i • m i) = 0 := by
              rw [Finset.smul_sum]
              rw [← hc0]
              exact Finset.sum_congr rfl fun i _ => by rw [smul_smul, ← hd i]
            have : (∑ i, d i • m i) = 0 := hx (by simpa using hxd)
            simpa [hφ, Fintype.linearCombination_apply] using this
          have hcd : c = x • d := by
            funext i
            simpa using hd i
          rw [Submodule.ideal_span_singleton_smul, hcd]
          exact Submodule.smul_mem_pointwise_smul _ _ _ hdker
        have hbot : LinearMap.ker φ = ⊥ :=
          Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _
            (IsNoetherian.noetherian _) hker hIle
        exact LinearMap.ker_eq_bot.1 hbot
      exact Module.Free.of_equiv (LinearEquiv.ofBijective φ ⟨hinjφ, hsurjφ⟩)

end GaloisForLFunctions.HTGeometry
