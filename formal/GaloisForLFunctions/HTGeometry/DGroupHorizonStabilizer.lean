import GaloisForLFunctions.HTGeometry.CommutativeDGroupObservable
import GaloisForLFunctions.HTGeometry.DifferentialHorizonInterface

/-!
# The horizon stabilizer of a commutative `D`-group is the kernel of its logarithmic derivative

The logarithmic derivative of a commutative algebraic `D`-group is a group homomorphism, so
translating a point changes its logarithmic coordinates by the logarithmic coordinates of the
translating point.  Consequently a translation fixes the differential field generated by the
logarithmic coordinates of a point exactly when the translating point has vanishing logarithmic
derivative.

This identifies the embedded-horizon stabilizer with the sharp subgroup of the `D`-group — the
Manin kernel in the abelian case — without assuming the additivity as a hypothesis: it is a
consequence of the `D`-group structure.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

universe u

variable {G : Type*} [CommGroup G] {K L : Type u} [Field K] [Field L] [Algebra K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L] {n d : ℕ}

/-- The sharp subgroup of a commutative `D`-group: the points with vanishing logarithmic
derivative. -/
def dGroupSharp (P : DGroupPresentation G K L n d) : Set G :=
  {g : G | P.ell g = 0}

@[simp] theorem mem_dGroupSharp {P : DGroupPresentation G K L n d} {g : G} :
    g ∈ dGroupSharp P ↔ P.ell g = 0 := Iff.rfl

/-- The logarithmic derivative kills the identity. -/
theorem ell_one (P : DGroupPresentation G K L n d) : P.ell 1 = 0 := by
  have h := P.ell_mul (1 : G) 1
  rw [mul_one] at h
  funext j
  have hj := congrFun h j
  simp only [Pi.add_apply, Pi.zero_apply] at hj ⊢
  have hcancel : P.ell 1 j + P.ell 1 j = P.ell 1 j + 0 := by
    rw [add_zero]
    exact hj.symm
  exact add_left_cancel hcancel

/-- The sharp points form a subgroup: they are the kernel of the logarithmic derivative. -/
def dGroupSharpSubgroup (P : DGroupPresentation G K L n d) : Subgroup G where
  carrier := dGroupSharp P
  one_mem' := ell_one P
  mul_mem' := by
    intro a b ha hb
    show P.ell (a * b) = 0
    rw [P.ell_mul, show P.ell a = 0 from ha, show P.ell b = 0 from hb, add_zero]
  inv_mem' := by
    intro a ha
    show P.ell a⁻¹ = 0
    have h := P.ell_mul a a⁻¹
    rw [mul_inv_cancel, ell_one, show P.ell a = 0 from ha, zero_add] at h
    exact h.symm

@[simp] theorem mem_dGroupSharpSubgroup {P : DGroupPresentation G K L n d} {g : G} :
    g ∈ dGroupSharpSubgroup P ↔ P.ell g = 0 := Iff.rfl

/-- **The exact horizon stabilizer.**  For a translation action realized by differential
automorphisms which moves logarithmic coordinates along the group law, the stabilizer of the
differential field generated by the logarithmic coordinates of a point is exactly the sharp
subgroup. -/
theorem differentialTranslationStabilizer_ell_eq_dGroupSharp
    (P : DGroupPresentation G K L n d) (a : G)
    (translation : G → DifferentialAlgEquiv K L)
    (hequiv : ∀ (h : G) (j : Fin d),
      (translation h).toAlgEquiv (P.ell a j) = P.ell (a * h) j) :
    differentialTranslationStabilizer translation
        (differentialAdjoin K (Set.range (P.ell a))) = dGroupSharp P := by
  ext h
  constructor
  · intro hstab
    show P.ell h = 0
    funext j
    have hmem : P.ell a j ∈ differentialAdjoin K (Set.range (P.ell a)) :=
      subset_differentialAdjoin K _ ⟨j, rfl⟩
    have hfix := hstab _ hmem
    rw [hequiv h j] at hfix
    have hadd : P.ell (a * h) j = P.ell a j + P.ell h j :=
      congrFun (P.ell_mul a h) j
    rw [hadd] at hfix
    simp only [Pi.zero_apply]
    have hcancel : P.ell a j + P.ell h j = P.ell a j + 0 := by
      rw [add_zero]
      exact hfix
    exact add_left_cancel hcancel
  · intro hker z hz
    refine (translation h).fixed_on_differentialAdjoin (P.ell a) ?_ hz
    intro j
    rw [hequiv h j]
    have hadd : P.ell (a * h) j = P.ell a j + P.ell h j :=
      congrFun (P.ell_mul a h) j
    have hzero : P.ell h j = 0 := by
      have : P.ell h = 0 := hker
      rw [this]
      rfl
    rw [hadd, hzero, add_zero]

end

end GaloisForLFunctions.HTGeometry
