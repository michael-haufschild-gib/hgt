import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# The jets of an inverse are triangular in the jets of the element

For a nonzero `u` in a differential field, the jets of `u⁻¹` are obtained from the jets of `u` by a
*triangular* substitution: the `(i+1)`-st jet of `u⁻¹` is `−δ^{i+1}u / u²` plus an element of the
field generated by the jets of `u` of order at most `i`.

That is the structural fact behind the invariance of differential transcendence under `u ↦ u⁻¹`: the
substitution is affine and invertible in each top jet, so it cannot create an algebraic relation.
Here the substitution itself is proved, together with the field of jets of bounded order and its
behaviour under the derivation — the induction needs `δ(L_i) ⊆ L_{i+1}`.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

variable {F K : Type*} [Field F] [Field K] [Differential F] [Differential K]
  [Algebra F K] [DifferentialAlgebra F K]

/-- The field generated by the jets of `u` of order at most `i`. -/
def jetFieldLe (F : Type*) {K : Type*} [Field F] [Field K] [Differential K] [Algebra F K]
    (u : K) (i : ℕ) : IntermediateField F K :=
  IntermediateField.adjoin F ((fun j => differentialJet j u) '' Set.Iic i)

theorem differentialJet_mem_jetFieldLe (F : Type*) {K : Type*} [Field F] [Field K] [Differential K]
    [Algebra F K] (u : K) {i j : ℕ} (hj : j ≤ i) :
    differentialJet j u ∈ jetFieldLe F u i :=
  IntermediateField.subset_adjoin _ _ ⟨j, hj, rfl⟩

theorem jetFieldLe_mono (F : Type*) {K : Type*} [Field F] [Field K] [Differential K] [Algebra F K]
    (u : K) {i j : ℕ} (hij : i ≤ j) : jetFieldLe F u i ≤ jetFieldLe F u j := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro _ ⟨k, hk, rfl⟩
  exact differentialJet_mem_jetFieldLe F u (le_trans hk hij)

/-- **The jet field of bounded order is carried one step up by the derivation.** -/
theorem deriv_mem_jetFieldLe_succ (u : K) (i : ℕ) {x : K} (hx : x ∈ jetFieldLe F u i) :
    x′ ∈ jetFieldLe F u (i + 1) := by
  apply IntermediateField.adjoin_induction F
    (s := ((fun j => differentialJet j u) '' Set.Iic i))
    (p := fun y _ => y′ ∈ jetFieldLe F u (i + 1))
  · rintro y ⟨j, hj, rfl⟩
    have hj' : j ≤ i := hj
    rw [← differentialJet_succ]
    exact differentialJet_mem_jetFieldLe F u (by omega)
  · intro c
    rw [deriv_algebraMap]
    exact IntermediateField.algebraMap_mem _ _
  · intro a b _ _ hda hdb
    rw [map_add]
    exact IntermediateField.add_mem _ hda hdb
  · intro a ha hda
    rw [Derivation.leibniz_inv]
    have ha' : a ∈ jetFieldLe F u (i + 1) := jetFieldLe_mono F u (Nat.le_succ i) ha
    have hainv : a⁻¹ ∈ jetFieldLe F u (i + 1) := IntermediateField.inv_mem _ ha'
    have hasq : a⁻¹ ^ (2 : ℕ) ∈ jetFieldLe F u (i + 1) := by
      simpa [pow_two] using IntermediateField.mul_mem _ hainv hainv
    exact IntermediateField.mul_mem _ (IntermediateField.neg_mem _ hasq) hda
  · intro a b ha hb hda hdb
    rw [Derivation.leibniz]
    have ha' : a ∈ jetFieldLe F u (i + 1) := jetFieldLe_mono F u (Nat.le_succ i) ha
    have hb' : b ∈ jetFieldLe F u (i + 1) := jetFieldLe_mono F u (Nat.le_succ i) hb
    exact IntermediateField.add_mem _
      (IntermediateField.mul_mem _ ha' hdb) (IntermediateField.mul_mem _ hb' hda)
  exact hx

/-- **The jets of an inverse are triangular.**  The `(i+1)`-st jet of `u⁻¹` is `−δ^{i+1}u/u²` up to an
element of the field generated by the jets of `u` of order at most `i`. -/
theorem differentialJet_succ_inv {u : K} (_hu : u ≠ 0) (i : ℕ) :
    ∃ R ∈ jetFieldLe F u i,
      differentialJet (i + 1) u⁻¹ = -(differentialJet (i + 1) u) / u ^ 2 + R := by
  have hconv2 : ∀ x : K, x / u ^ 2 = x * (u⁻¹) ^ 2 := by
    intro x
    rw [div_eq_mul_inv, inv_pow]
  have hconv3 : ∀ x : K, x / u ^ 3 = x * (u⁻¹) ^ 3 := by
    intro x
    rw [div_eq_mul_inv, inv_pow]
  have hu1 : (u : K)′ = differentialJet 1 u := by
    have := (differentialJet_succ 0 u).symm
    rwa [differentialJet_zero] at this
  have hinv : ((u : K)⁻¹)′ = -((u : K)⁻¹) ^ 2 * (u : K)′ := Derivation.leibniz_inv _ _
  induction i with
  | zero =>
      refine ⟨0, zero_mem _, ?_⟩
      have h1 : differentialJet 1 u⁻¹ = ((u : K)⁻¹)′ := by
        have := (differentialJet_succ 0 u⁻¹).symm
        rwa [differentialJet_zero] at this
      rw [h1, add_zero, hinv, hu1]
      simp only [hconv2]
      ring
  | succ i ih =>
      obtain ⟨R, hR, hval⟩ := ih
      have hjet : (differentialJet (i + 1) u)′ = differentialJet (i + 2) u :=
        (differentialJet_succ (i + 1) u).symm
      have hderiv : differentialJet (i + 2) u⁻¹
          = -(differentialJet (i + 2) u) / u ^ 2
            + (2 * differentialJet (i + 1) u * differentialJet 1 u / u ^ 3 + R′) := by
        have hstep : differentialJet (i + 2) u⁻¹ = (differentialJet (i + 1) u⁻¹)′ :=
          differentialJet_succ (i + 1) u⁻¹
        have hsq : (((u : K)⁻¹) ^ 2)′ = 2 * (u : K)⁻¹ * ((u : K)⁻¹)′ := by
          rw [pow_two, Derivation.leibniz]
          ring
        rw [hstep, hval]
        simp only [hconv2, hconv3]
        rw [map_add, Derivation.leibniz, map_neg, hjet, hsq, hinv, hu1]
        ring
      refine ⟨2 * differentialJet (i + 1) u * differentialJet 1 u / u ^ 3 + R′, ?_, hderiv⟩
      have h1 : differentialJet (i + 1) u ∈ jetFieldLe F u (i + 1) :=
        differentialJet_mem_jetFieldLe F u (le_refl _)
      have h2 : differentialJet 1 u ∈ jetFieldLe F u (i + 1) :=
        differentialJet_mem_jetFieldLe F u (by omega)
      have h3 : (u : K) ∈ jetFieldLe F u (i + 1) := by
        have := differentialJet_mem_jetFieldLe F u (i := i + 1) (j := 0) (by omega)
        rwa [differentialJet_zero] at this
      have h4 : (u : K) ^ 3 ∈ jetFieldLe F u (i + 1) := by
        have := IntermediateField.mul_mem _ (IntermediateField.mul_mem _ h3 h3) h3
        simpa [pow_succ, pow_two, mul_assoc] using this
      have h5 : (2 : K) ∈ jetFieldLe F u (i + 1) := by
        simp
      refine IntermediateField.add_mem _ ?_ (deriv_mem_jetFieldLe_succ u i hR)
      exact IntermediateField.div_mem _
        (IntermediateField.mul_mem _ (IntermediateField.mul_mem _ h5 h1) h2) h4

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

variable {F K : Type*} [Field F] [Field K] [Differential F] [Differential K]
  [Algebra F K] [DifferentialAlgebra F K]

/-- Every jet of `u⁻¹` of order at most `i` lies in the jet field of `u` of order at most `i`. -/
theorem differentialJet_inv_mem_jetFieldLe {u : K} (hu : u ≠ 0) {i j : ℕ} (hj : j ≤ i) :
    differentialJet j u⁻¹ ∈ jetFieldLe F u i := by
  have hu0 : (u : K) ∈ jetFieldLe F u i := by
    have := differentialJet_mem_jetFieldLe F u (i := i) (j := 0) (Nat.zero_le i)
    rwa [differentialJet_zero] at this
  cases j with
  | zero =>
      rw [differentialJet_zero]
      exact IntermediateField.inv_mem _ hu0
  | succ k =>
      obtain ⟨R, hR, hval⟩ := differentialJet_succ_inv (F := F) hu k
      rw [hval]
      have hk : k + 1 ≤ i := hj
      have h1 : differentialJet (k + 1) u ∈ jetFieldLe F u i :=
        differentialJet_mem_jetFieldLe F u hk
      have h2 : (u : K) ^ 2 ∈ jetFieldLe F u i := by
        have := IntermediateField.mul_mem _ hu0 hu0
        simpa [pow_two] using this
      have h3 : R ∈ jetFieldLe F u i := jetFieldLe_mono F u (by omega) hR
      exact IntermediateField.add_mem _
        (IntermediateField.div_mem _ (IntermediateField.neg_mem _ h1) h2) h3

/-- **The jet fields of `u` and of `u⁻¹` coincide at every order.** -/
theorem jetFieldLe_inv (F : Type*) {K : Type*} [Field F] [Field K] [Differential F]
    [Differential K] [Algebra F K] [DifferentialAlgebra F K] {u : K} (hu : u ≠ 0) (i : ℕ) :
    jetFieldLe F u⁻¹ i = jetFieldLe F u i := by
  have hinv : u⁻¹ ≠ 0 := inv_ne_zero hu
  refine le_antisymm ?_ ?_
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ ⟨j, hj, rfl⟩
    exact differentialJet_inv_mem_jetFieldLe hu hj
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ ⟨j, hj, rfl⟩
    have h := differentialJet_inv_mem_jetFieldLe (F := F) hinv (i := i) (j := j) hj
    rwa [inv_inv] at h

/-- **Algebraicity of the top jet is the same for `u` and for `u⁻¹`.**  The triangular substitution is
affine in the top jet with invertible coefficient, so it neither creates nor destroys an algebraic
relation over the field of lower jets. -/
theorem isAlgebraic_differentialJet_succ_inv_iff {u : K} (hu : u ≠ 0) (i : ℕ) :
    IsAlgebraic (jetFieldLe F u i) (differentialJet (i + 1) u⁻¹)
      ↔ IsAlgebraic (jetFieldLe F u i) (differentialJet (i + 1) u) := by
  classical
  obtain ⟨R, hR, hval⟩ := differentialJet_succ_inv (F := F) hu i
  have hu0 : (u : K) ∈ jetFieldLe F u i := by
    have := differentialJet_mem_jetFieldLe F u (i := i) (j := 0) (Nat.zero_le i)
    rwa [differentialJet_zero] at this
  have hu2 : (u : K) ^ 2 ∈ jetFieldLe F u i := by
    have := IntermediateField.mul_mem _ hu0 hu0
    simpa [pow_two] using this
  have hu2ne : (u : K) ^ 2 ≠ 0 := pow_ne_zero 2 hu
  -- the two coefficients, as elements of the base field
  set c : K := -((u : K) ^ 2)⁻¹ with hc
  have hcmem : c ∈ jetFieldLe F u i :=
    IntermediateField.neg_mem _ (IntermediateField.inv_mem _ hu2)
  have hcalg : IsAlgebraic (jetFieldLe F u i) c := by
    have := isAlgebraic_algebraMap (R := jetFieldLe F u i) (A := K) ⟨c, hcmem⟩
    simpa using this
  have hRalg : IsAlgebraic (jetFieldLe F u i) R := by
    have := isAlgebraic_algebraMap (R := jetFieldLe F u i) (A := K) ⟨R, hR⟩
    simpa using this
  have hu2alg : IsAlgebraic (jetFieldLe F u i) ((u : K) ^ 2) := by
    have := isAlgebraic_algebraMap (R := jetFieldLe F u i) (A := K) ⟨(u : K) ^ 2, hu2⟩
    simpa using this
  have hlin : differentialJet (i + 1) u⁻¹ = c * differentialJet (i + 1) u + R := by
    rw [hval, hc]
    field_simp
  constructor
  · intro halg
    have hback : differentialJet (i + 1) u
        = (-(u : K) ^ 2) * (differentialJet (i + 1) u⁻¹ - R) := by
      have hstep : differentialJet (i + 1) u⁻¹ - R = c * differentialJet (i + 1) u := by
        rw [hlin]
        ring
      rw [hstep, hc]
      field_simp
    rw [hback]
    have hneg : IsAlgebraic (jetFieldLe F u i) (-(u : K) ^ 2) := by
      have := isAlgebraic_algebraMap (R := jetFieldLe F u i) (A := K)
        ⟨-(u : K) ^ 2, IntermediateField.neg_mem _ hu2⟩
      simpa using this
    refine hneg.mul ?_
    have hsub : differentialJet (i + 1) u⁻¹ - R
        = differentialJet (i + 1) u⁻¹ + (-R) := by ring
    rw [hsub]
    exact halg.add (by
      have := isAlgebraic_algebraMap (R := jetFieldLe F u i) (A := K)
        ⟨-R, IntermediateField.neg_mem _ hR⟩
      simpa using this)
  · intro halg
    rw [hlin]
    exact (hcalg.mul halg).add hRalg

end GaloisForLFunctions.HTGeometry
