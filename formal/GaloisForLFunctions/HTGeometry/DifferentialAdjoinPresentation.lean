import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Every element of a differential adjoin is a quotient of jet polynomials

The differential field generated by a set is the field generated by its jets, so membership is the
membership of a generated intermediate field: an element is a quotient of two polynomial expressions
in finitely many jets of the generators.

This is the presentation statement the residue law consumes — it turns "an element of the field" into
"a quotient of jet polynomials", which is the form the datum machinery accepts.
-/

namespace GaloisForLFunctions

/-- **The presentation of an element of a differential adjoin.**  Every element is a quotient of
polynomial expressions in the jets of the generators. -/
theorem mem_differentialAdjoin_iff (F : Type*) {K : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K] (s : Set K) (x : K) :
    x ∈ differentialAdjoin F s ↔
      ∃ r q : MvPolynomial (differentialJetSet s) F,
        x = (MvPolynomial.aeval Subtype.val) r / (MvPolynomial.aeval Subtype.val) q := by
  rw [differentialAdjoin]
  exact IntermediateField.mem_adjoin_iff F x

/-- The presentation, stated as an existence statement for a member. -/
theorem exists_jetPoly_presentation (F : Type*) {K : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K] {s : Set K} {x : K} (hx : x ∈ differentialAdjoin F s) :
    ∃ r q : MvPolynomial (differentialJetSet s) F,
      x = (MvPolynomial.aeval Subtype.val) r / (MvPolynomial.aeval Subtype.val) q :=
  (mem_differentialAdjoin_iff F s x).mp hx

/-- The jet set of a single generator is the range of its jets. -/
theorem differentialJetSet_singleton {K : Type*} [CommRing K] [Differential K] (x : K) :
    differentialJetSet ({x} : Set K) = Set.range (fun n : ℕ => differentialJet n x) := by
  ext y
  constructor
  · rintro ⟨z, hz, n, hn⟩
    rw [Set.mem_singleton_iff] at hz
    exact ⟨n, by rw [← hn, hz]⟩
  · rintro ⟨n, hn⟩
    exact ⟨x, Set.mem_singleton x, n, hn⟩

/-- **The presentation over a single generator.**  Every element of the differential field generated
by one element is a quotient of polynomial expressions in its jets. -/
theorem mem_differentialAdjoin_singleton_iff (F : Type*) {K : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K] (x y : K) :
    y ∈ differentialAdjoin F ({x} : Set K) ↔
      ∃ r q : MvPolynomial (differentialJetSet ({x} : Set K)) F,
        y = (MvPolynomial.aeval Subtype.val) r / (MvPolynomial.aeval Subtype.val) q :=
  mem_differentialAdjoin_iff F {x} y

/-- The jet set of a pair of generators is the union of their jet ranges — the shape the Gamma field
`ℂ(s)⟨ψ, Γ⟩` has. -/
theorem differentialJetSet_pair {K : Type*} [CommRing K] [Differential K] (x y : K) :
    differentialJetSet ({x, y} : Set K)
      = Set.range (fun n : ℕ => differentialJet n x)
        ∪ Set.range (fun n : ℕ => differentialJet n y) := by
  ext z
  constructor
  · rintro ⟨w, hw, n, hn⟩
    rcases hw with hx | hy
    · exact Or.inl ⟨n, by rw [← hn, hx]⟩
    · rw [Set.mem_singleton_iff] at hy
      exact Or.inr ⟨n, by rw [← hn, hy]⟩
  · rintro (⟨n, hn⟩ | ⟨n, hn⟩)
    · exact ⟨x, Or.inl rfl, n, hn⟩
    · exact ⟨y, Or.inr (Set.mem_singleton y), n, hn⟩

/-- **Only finitely many jets occur.**  Every element of a differential adjoin already lies in the
field generated by a finite set of jets — so a presentation is a jet polynomial in finitely many
variables, which is the form the residue machinery accepts. -/
theorem exists_finset_jets_of_mem_differentialAdjoin (F : Type*) {K : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K] {s : Set K} {x : K} (hx : x ∈ differentialAdjoin F s) :
    ∃ T : Finset K, (↑T : Set K) ⊆ differentialJetSet s ∧
      x ∈ IntermediateField.adjoin F (↑T : Set K) := by
  rw [differentialAdjoin] at hx
  exact IntermediateField.exists_finset_of_mem_adjoin hx

/-- **The finite presentation.**  Every element of a differential adjoin is a quotient of two
polynomials in finitely many jets of the generators — eq. `(23)` of the card in formal form. -/
theorem exists_finite_jetPoly_presentation (F : Type*) {K : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K] {s : Set K} {x : K} (hx : x ∈ differentialAdjoin F s) :
    ∃ T : Finset K, (↑T : Set K) ⊆ differentialJetSet s ∧
      ∃ r q : MvPolynomial (↑T : Set K) F,
        x = (MvPolynomial.aeval Subtype.val) r / (MvPolynomial.aeval Subtype.val) q := by
  obtain ⟨T, hT, hmem⟩ := exists_finset_jets_of_mem_differentialAdjoin F hx
  exact ⟨T, hT, (IntermediateField.mem_adjoin_iff F x).mp hmem⟩

/-- A presentation's numerator and denominator are finite sums of monomials in the jets: this is the
shape `∑_α a_α ∏_i x_i^{e_{α i}}` that the residue machinery consumes. -/
theorem aeval_eq_sum_monomials {F K : Type*} [CommSemiring F] [CommSemiring K] [Algebra F K]
    {T : Type*} (g : T → K) (r : MvPolynomial T F) :
    MvPolynomial.aeval g r
      = ∑ d ∈ r.support, algebraMap F K (r.coeff d) * ∏ i ∈ d.support, g i ^ d i := by
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq]

/-- A finite sum is a sum over `Fin N`: the index bookkeeping that turns a monomial expansion into
the `Fin N`-indexed family the residue machinery takes. -/
theorem exists_fin_sum_eq {M ι : Type*} [AddCommMonoid M] (s : Finset ι) (f : ι → M) :
    ∃ (N : ℕ) (g : Fin N → M), ∑ i ∈ s, f i = ∑ j : Fin N, g j := by
  classical
  refine ⟨s.card, fun j => f ((s.equivFin.symm j : { x // x ∈ s }) : ι), ?_⟩
  rw [← Finset.sum_attach s f]
  refine Fintype.sum_equiv s.equivFin _ _ ?_
  intro a
  simp

/-- The multiplicative counterpart: a finite product is a product over `Fin N`. -/
theorem exists_fin_prod_eq {M ι : Type*} [CommMonoid M] (s : Finset ι) (f : ι → M) :
    ∃ (N : ℕ) (g : Fin N → M), ∏ i ∈ s, f i = ∏ j : Fin N, g j := by
  classical
  refine ⟨s.card, fun j => f ((s.equivFin.symm j : { x // x ∈ s }) : ι), ?_⟩
  rw [← Finset.prod_attach s f]
  refine Fintype.prod_equiv s.equivFin _ _ ?_
  intro a
  simp

end GaloisForLFunctions
