import GaloisForLFunctions.HTGeometry.PrimeDirichletTailPattern

/-!
# Half-density coherence and tensor factorization

Boolean phase lifts have a common dephased diagonal, while their off-diagonal rank-one entries
are exactly weighted pair coherences. Product half-densities factor on both coordinate edge
families, supplying the observables used by Cartesian-product coherence reconstruction.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u v
variable {I : Type u} {J : Type v}

/-- Real rank-one kernel generated by a half-density. -/
def realRankOneKernel (ψ : I → ℝ) (i j : I) : ℝ :=
  ψ i * ψ j

/-- Boolean-signed half-density with prescribed diagonal weight. -/
def booleanHalfDensity (p : I → ℝ) (ε : I → Bool) (i : I) : ℝ :=
  Real.sqrt (p i) * primeDirichletRealSign (ε i)

/-- Real sign carried by Boolean pair coherence. -/
def booleanCoherenceReal (ε : I → Bool) (i j : I) : ℝ :=
  primeDirichletRealSign (Bool.xor (ε i) (ε j))

theorem primeDirichletRealSign_xor (a b : Bool) :
    primeDirichletRealSign (Bool.xor a b) =
      primeDirichletRealSign a *
        primeDirichletRealSign b := by
  cases a <;> cases b <;>
    norm_num [primeDirichletRealSign]

/-- Every off-diagonal kernel entry is the geometric-mean weight times the Boolean pair
coherence. -/
theorem realRankOneKernel_booleanHalfDensity
    (p : I → ℝ) (ε : I → Bool) (i j : I) :
    realRankOneKernel (booleanHalfDensity p ε) i j =
      Real.sqrt (p i) * Real.sqrt (p j) * booleanCoherenceReal ε i j := by
  rw [realRankOneKernel, booleanHalfDensity, booleanHalfDensity,
    booleanCoherenceReal, primeDirichletRealSign_xor]
  ring

/-- Dephasing forgets the entire Boolean orientation: every diagonal entry is the prescribed
weight. -/
theorem realRankOneKernel_booleanHalfDensity_diag
    (p : I → ℝ) (ε : I → Bool) (hp : ∀ i, 0 ≤ p i) (i : I) :
    realRankOneKernel (booleanHalfDensity p ε) i i = p i := by
  rw [realRankOneKernel_booleanHalfDensity]
  simp only [booleanCoherenceReal, Bool.xor_self]
  change Real.sqrt (p i) * Real.sqrt (p i) * 1 = p i
  nlinarith [Real.sq_sqrt (hp i)]

/-- Expectation of every diagonal observable is independent of the Boolean phase lift. -/
theorem diagonalExpectation_booleanHalfDensity
    [Fintype I] (p h : I → ℝ) (ε : I → Bool) (hp : ∀ i, 0 ≤ p i) :
    (∑ i, h i * realRankOneKernel (booleanHalfDensity p ε) i i) =
      ∑ i, h i * p i := by
  apply Finset.sum_congr rfl
  intro i _
  rw [realRankOneKernel_booleanHalfDensity_diag p ε hp]

/-- The order-two purity of the dephased diagonal is independent of the Boolean phase lift. -/
theorem dephasedPurity_booleanHalfDensity
    [Fintype I] (p : I → ℝ) (ε : I → Bool) (hp : ∀ i, 0 ≤ p i) :
    (∑ i, (realRankOneKernel (booleanHalfDensity p ε) i i) ^ (2 : ℕ)) =
      ∑ i, (p i) ^ (2 : ℕ) := by
  apply Finset.sum_congr rfl
  intro i _
  rw [realRankOneKernel_booleanHalfDensity_diag p ε hp]

/-- Product half-density of two independent systems. -/
def tensorHalfDensity (ψ : I → ℝ) (φ : J → ℝ) (x : I × J) : ℝ :=
  ψ x.1 * φ x.2

/-- Exact tensor-product factorization of rank-one kernels. -/
theorem realRankOneKernel_tensorHalfDensity
    (ψ : I → ℝ) (φ : J → ℝ) (x y : I × J) :
    realRankOneKernel (tensorHalfDensity ψ φ) x y =
      realRankOneKernel ψ x.1 y.1 * realRankOneKernel φ x.2 y.2 := by
  simp only [realRankOneKernel, tensorHalfDensity]
  ring

/-- Along a first-coordinate edge, the product kernel is the first coherence weighted by the
second diagonal mass. -/
theorem realRankOneKernel_tensorHalfDensity_left
    (ψ : I → ℝ) (φ : J → ℝ) (i i' : I) (j : J) :
    realRankOneKernel (tensorHalfDensity ψ φ) (i, j) (i', j) =
      realRankOneKernel ψ i i' * realRankOneKernel φ j j :=
  realRankOneKernel_tensorHalfDensity ψ φ _ _

/-- Along a second-coordinate edge, the product kernel is the second coherence weighted by the
first diagonal mass. -/
theorem realRankOneKernel_tensorHalfDensity_right
    (ψ : I → ℝ) (φ : J → ℝ) (i : I) (j j' : J) :
    realRankOneKernel (tensorHalfDensity ψ φ) (i, j) (i, j') =
      realRankOneKernel ψ i i * realRankOneKernel φ j j' :=
  realRankOneKernel_tensorHalfDensity ψ φ _ _

/-- Exact first-coordinate product-coherence formula for Boolean half-densities. -/
theorem booleanTensorKernel_left
    (p : I → ℝ) (q : J → ℝ) (ε : I → Bool) (δ : J → Bool)
    (hq : ∀ j, 0 ≤ q j) (i i' : I) (j : J) :
    realRankOneKernel
        (tensorHalfDensity (booleanHalfDensity p ε) (booleanHalfDensity q δ))
        (i, j) (i', j) =
      Real.sqrt (p i) * Real.sqrt (p i') * q j * booleanCoherenceReal ε i i' := by
  rw [realRankOneKernel_tensorHalfDensity_left,
    realRankOneKernel_booleanHalfDensity,
    realRankOneKernel_booleanHalfDensity_diag q δ hq]
  ring

/-- Exact second-coordinate product-coherence formula for Boolean half-densities. -/
theorem booleanTensorKernel_right
    (p : I → ℝ) (q : J → ℝ) (ε : I → Bool) (δ : J → Bool)
    (hp : ∀ i, 0 ≤ p i) (i : I) (j j' : J) :
    realRankOneKernel
        (tensorHalfDensity (booleanHalfDensity p ε) (booleanHalfDensity q δ))
        (i, j) (i, j') =
      p i * Real.sqrt (q j) * Real.sqrt (q j') * booleanCoherenceReal δ j j' := by
  rw [realRankOneKernel_tensorHalfDensity_right,
    realRankOneKernel_booleanHalfDensity_diag p ε hp,
    realRankOneKernel_booleanHalfDensity]
  ring

end

end GaloisForLFunctions.HTGeometry

