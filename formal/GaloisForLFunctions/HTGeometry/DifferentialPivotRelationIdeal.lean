import GaloisForLFunctions.HTGeometry.DifferentialJetPivotCore

/-!
# Complete relation ideals for affine differential pivot families

Choose a differentially independent pivot family `x`.  Suppose every dependent family member
`y r` has, at every jet order, an affine expression in the corresponding jets of `x`.  This file
computes the complete relation ideal of `Sum.elim x y`: it is generated by exactly those affine
jet relations.  In particular no nonlinear relation remains after the displayed linear relations
are imposed.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions MvPolynomial

noncomputable section

/-- The affine polynomial which replaces one dependent jet. -/
def differentialPivotAffineJet
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial B F :=
  MvPolynomial.C (h r n) +
    ∑ b, MvPolynomial.C (A r b) * MvPolynomial.X (b, n)

/-- Eliminate every dependent jet by its prescribed affine expression in the pivot jets. -/
def differentialPivotElimination
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) :
    DifferentialPolynomial (B ⊕ R) F →ₐ[F] DifferentialPolynomial B F :=
  differentialJetPivotElimination (differentialPivotAffineJet A h)
/-- Include pivot differential polynomials into the left variables of the full jet ring. -/
def differentialPivotInclusion
    {F B R : Type*} [Field F] :
    DifferentialPolynomial B F →ₐ[F] DifferentialPolynomial (B ⊕ R) F :=
  differentialJetPivotInclusion
@[simp]
theorem differentialPivotElimination_X_inl
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) (b : B) (n : ℕ) :
    differentialPivotElimination A h
        (MvPolynomial.X (Sum.inl b, n)) = MvPolynomial.X (b, n) :=
  differentialJetPivotElimination_X_inl _ b n
@[simp]
theorem differentialPivotElimination_X_inr
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialPivotElimination A h
        (MvPolynomial.X (Sum.inr r, n)) = differentialPivotAffineJet A h r n :=
  differentialJetPivotElimination_X_inr _ r n
@[simp]
theorem differentialPivotInclusion_X
    {F B R : Type*} [Field F] (b : B) (n : ℕ) :
    differentialPivotInclusion (R := R)
        (MvPolynomial.X (b, n)) =
      (MvPolynomial.X (Sum.inl b, n) : DifferentialPolynomial (B ⊕ R) F) :=
  differentialJetPivotInclusion_X b n
/-- Elimination is a left inverse to pivot inclusion. -/
@[simp]
theorem differentialPivotElimination_inclusion
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F)
    (P : DifferentialPolynomial B F) :
    differentialPivotElimination A h (differentialPivotInclusion P) = P :=
  differentialJetPivotElimination_inclusion _ P
/-- The displayed affine relation for one dependent jet. -/
def differentialPivotRelation
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial (B ⊕ R) F :=
  differentialJetPivotRelation (differentialPivotAffineJet A h) r n
/-- The ideal generated by all displayed affine jet relations. -/
def differentialPivotRelationIdeal
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) :
    Ideal (DifferentialPolynomial (B ⊕ R) F) :=
  differentialJetPivotRelationIdeal (differentialPivotAffineJet A h)
@[simp]
theorem differentialPivotElimination_relation
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialPivotElimination A h (differentialPivotRelation A h r n) = 0 :=
  differentialJetPivotElimination_relation _ r n
/-- Every polynomial differs from its eliminated pivot normal form by the generated affine
relation ideal. -/
theorem sub_inclusion_elimination_mem_differentialPivotRelationIdeal
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F)
    (P : DifferentialPolynomial (B ⊕ R) F) :
    P - differentialPivotInclusion (differentialPivotElimination A h P) ∈
      differentialPivotRelationIdeal A h :=
  sub_jetPivotInclusion_elimination_mem_relationIdeal _ P
/-- The algebraic kernel of pivot elimination is exactly the ideal generated by the affine jet
relations. -/
theorem differentialPivotRelationIdeal_eq_ker
    {F B R : Type*} [Field F] [Fintype B]
    (A : R → B → F) (h : R → ℕ → F) :
    differentialPivotRelationIdeal A h =
      RingHom.ker (differentialPivotElimination A h).toRingHom :=
  differentialJetPivotRelationIdeal_eq_ker _
/-- Evaluation of the full pivot/dependent family factors through affine jet elimination. -/
theorem differentialPolynomialEval_sumElim_eq_pivotElimination
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Fintype B]
    (x : B → K) (y : R → K) (A : R → B → F) (h : R → ℕ → F)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        ∑ b, algebraMap F K (A r b) * differentialJet n (x b))
    (P : DifferentialPolynomial (B ⊕ R) F) :
    differentialPolynomialEval (C := F) (Sum.elim x y) P =
      MvPolynomial.aeval (fun bn : B × ℕ => differentialJet bn.2 (x bn.1))
        (differentialPivotElimination A h P) :=
  differentialPolynomialEval_sumElim_eq_jetPivotElimination x y _
    (fun r n => by
      rw [hrel r n]
      simp [differentialPivotAffineJet])
      P
/-- Affine jet dependence makes the pivot family generate the same embedded differential field as
the full pivot/dependent family. -/
theorem differentialAdjoin_sumElim_eq_left_of_affineJets
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Fintype B]
    (x : B → K) (y : R → K) (A : R → B → F) (h : R → ℕ → F)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        ∑ b, algebraMap F K (A r b) * differentialJet n (x b)) :
    differentialAdjoin F (Set.range (Sum.elim x y)) =
      differentialAdjoin F (Set.range x) := by
  classical
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨_, ⟨i, rfl⟩, n, rfl⟩
    cases i with
    | inl b =>
        exact differentialJet_mem_differentialAdjoin F (Set.mem_range_self b) n
    | inr r =>
        change differentialJet n (y r) ∈ differentialAdjoin F (Set.range x)
        rw [hrel r n]
        apply IntermediateField.add_mem
        · exact IntermediateField.algebraMap_mem _ (h r n)
        · apply IntermediateField.sum_mem
          intro b _
          exact IntermediateField.mul_mem _
            (IntermediateField.algebraMap_mem _ (A r b))
            (differentialJet_mem_differentialAdjoin F (Set.mem_range_self b) n)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨_, ⟨b, rfl⟩, n, rfl⟩
    exact differentialJet_mem_differentialAdjoin F
      (show x b ∈ Set.range (Sum.elim x y) from ⟨Sum.inl b, rfl⟩) n

/-- **Complete differential relation theorem.**  If the pivot family is differentially
independent and every dependent jet has the displayed affine pivot expression, then all
relations of the combined family are generated by those affine jet relations.  There are no
additional nonlinear relations. -/
theorem differentialRelationIdeal_sumElim_eq_pivot
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Fintype B]
    (x : B → K) (y : R → K) (A : R → B → F) (h : R → ℕ → F)
    (hx : DifferentialIndependent F x)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        ∑ b, algebraMap F K (A r b) * differentialJet n (x b)) :
    differentialRelationIdeal (C := F) (Sum.elim x y) =
      differentialPivotRelationIdeal A h :=
  differentialRelationIdeal_sumElim_eq_jetPivot x y _ hx
    (fun r n => by
      rw [hrel r n]
      simp [differentialPivotAffineJet])
end

end GaloisForLFunctions.HTGeometry
