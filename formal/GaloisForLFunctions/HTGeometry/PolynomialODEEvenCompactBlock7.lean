/-- The decomposition is a symbolic integer polynomial identity on the entire unit cube. -/
theorem evenCompactUnitBlock7_eq {r t v : ℝ}
    (hr0 : 0 ≤ r) (hr1 : r ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) :
    evenCompactUnitBlock7 r t v = evenCompactUnitBlock7Lower r t v+evenCompactUnitBlock7Remainder r t v := by
  unfold evenCompactUnitBlock7 evenCompactUnitBlock7Lower evenCompactUnitBlock7Remainder
  rw [← add_div]
  congr 1
  simp only [oddCompactUnitSlack_eq hr0 hr1 ht0 ht1 hv0 hv1]
  ring

/-- Every omitted term has a proved nonnegative contribution. -/
theorem evenCompactUnitBlock7_remainder_nonneg {r t v : ℝ}
    (hr0 : 0 ≤ r) (ht0 : 0 ≤ t) (hv0 : 0 ≤ v) :
    0 ≤ evenCompactUnitBlock7Remainder r t v := by
  unfold evenCompactUnitBlock7Remainder oddCompactUnitSlack
  positivity

end
