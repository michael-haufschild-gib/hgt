import GaloisForLFunctions.HTGeometry.DifferentialIndependence

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

@[simp]
theorem differentialJet_neg_apply
    {K : Type*} [CommRing K] [Differential K] (n : ℕ) (x : K) :
    differentialJet n (-x) = -differentialJet n x := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [differentialJet_succ, differentialJet_succ, ih, map_neg]

/-- Global sign is invisible to the embedded differential field generated by one element. -/
theorem differentialAdjoin_neg_singleton
    (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : K) :
    differentialAdjoin F ({-x} : Set K) = differentialAdjoin F ({x} : Set K) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨w, hw, n, rfl⟩
    have hwx : w = -x := Set.mem_singleton_iff.mp hw
    subst w
    rw [differentialJet_neg_apply]
    exact IntermediateField.neg_mem _
      (differentialJet_mem_differentialAdjoin F (s := ({x} : Set K)) rfl n)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨w, hw, n, rfl⟩
    have hwx : w = x := Set.mem_singleton_iff.mp hw
    subst w
    have hmem := differentialJet_mem_differentialAdjoin F
      (s := ({-x} : Set K)) rfl n
    rw [differentialJet_neg_apply] at hmem
    simpa using IntermediateField.neg_mem _ hmem

/-- If every jet of `x - y` lies in the coefficient field, then `x` and `y` generate the same
embedded differential field. -/
theorem differentialAdjoin_singleton_eq_of_sub_jetsInBase
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K)
    (hbase : ∀ n, ∃ b : F, differentialJet n (x - y) = algebraMap F K b) :
    differentialAdjoin F ({x} : Set K) = differentialAdjoin F ({y} : Set K) := by
  have h := differentialAdjoin_addOfJetsInBase
    (F := F) (fun _ : Unit => y) (fun _ : Unit => x - y) (by
      intro _ n
      exact hbase n)
  have hfun : (fun _ : Unit => y + (x - y)) = (fun _ : Unit => x) := by
    funext _
    ring
  rw [hfun] at h
  simpa using h

/-- If every jet of `x + y` lies in the coefficient field, then `x` and `y` generate the same
embedded differential field: the only remaining ambiguity is the global projective sign. -/
theorem differentialAdjoin_singleton_eq_of_add_jetsInBase
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K)
    (hbase : ∀ n, ∃ b : F, differentialJet n (x + y) = algebraMap F K b) :
    differentialAdjoin F ({x} : Set K) = differentialAdjoin F ({y} : Set K) := by
  have h := differentialAdjoin_addOfJetsInBase
    (F := F) (fun _ : Unit => -y) (fun _ : Unit => x + y) (by
      intro _ n
      exact hbase n)
  have hfun : (fun _ : Unit => -y + (x + y)) = (fun _ : Unit => x) := by
    funext _
    ring
  rw [hfun] at h
  simpa [differentialAdjoin_neg_singleton] using h

/-- Two elements are projectively jet-equivalent over `F` when their difference, or their sum,
has every derivative in `F`. -/
def SignedBaseJetEquivalent
    (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K) : Prop :=
  (∀ n, ∃ b : F, differentialJet n (x - y) = algebraMap F K b) ∨
  (∀ n, ∃ b : F, differentialJet n (x + y) = algebraMap F K b)

/-- Projective jet-equivalence is sufficient for equality of the embedded generated differential
fields. -/
theorem differentialAdjoin_singleton_eq_of_signedBaseJetEquivalent
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K) (hxy : SignedBaseJetEquivalent F x y) :
    differentialAdjoin F ({x} : Set K) = differentialAdjoin F ({y} : Set K) := by
  rcases hxy with hsub | hadd
  · exact differentialAdjoin_singleton_eq_of_sub_jetsInBase x y hsub
  · exact differentialAdjoin_singleton_eq_of_add_jetsInBase x y hadd

/-- Simultaneous global sign reversal is invisible to the differential field generated by an
arbitrary family. -/
theorem differentialAdjoin_neg_range
    (F : Type*) {K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : ι → K) :
    differentialAdjoin F (Set.range fun i => -x i) =
      differentialAdjoin F (Set.range x) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨w, ⟨i, rfl⟩, n, rfl⟩
    rw [differentialJet_neg_apply]
    exact IntermediateField.neg_mem _
      (differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨w, ⟨i, rfl⟩, n, rfl⟩
    have hmem := differentialJet_mem_differentialAdjoin F
      (s := Set.range fun i => -x i) (Set.mem_range_self i) n
    rw [differentialJet_neg_apply] at hmem
    simpa using IntermediateField.neg_mem _ hmem

/-- A coordinatewise base-jet correction does not change the embedded differential field generated
by a family. -/
theorem differentialAdjoin_range_eq_of_sub_jetsInBase
    {F K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : ι → K)
    (hbase : ∀ i n, ∃ b : F,
      differentialJet n (x i - y i) = algebraMap F K b) :
    differentialAdjoin F (Set.range x) = differentialAdjoin F (Set.range y) := by
  have h := differentialAdjoin_addOfJetsInBase
    (F := F) y (fun i => x i - y i) hbase
  have hfun : (fun i => y i + (x i - y i)) = x := by
    funext i
    ring
  rw [hfun] at h
  exact h

/-- A coordinatewise base-jet correction after one global sign reversal does not change the
embedded differential field generated by a family. -/
theorem differentialAdjoin_range_eq_of_add_jetsInBase
    {F K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : ι → K)
    (hbase : ∀ i n, ∃ b : F,
      differentialJet n (x i + y i) = algebraMap F K b) :
    differentialAdjoin F (Set.range x) = differentialAdjoin F (Set.range y) := by
  have h := differentialAdjoin_addOfJetsInBase
    (F := F) (fun i => -y i) (fun i => x i + y i) hbase
  have hfun : (fun i => -y i + (x i + y i)) = x := by
    funext i
    ring
  rw [hfun, differentialAdjoin_neg_range] at h
  exact h

/-- Two equally indexed families are projectively jet-equivalent over `F` when one global choice
of sign makes every coordinatewise difference have all jets in `F`. -/
def SignedBaseJetEquivalentFamilies
    (F : Type*) {K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : ι → K) : Prop :=
  (∀ i n, ∃ b : F, differentialJet n (x i - y i) = algebraMap F K b) ∨
  (∀ i n, ∃ b : F, differentialJet n (x i + y i) = algebraMap F K b)

theorem differentialAdjoin_range_eq_of_signedBaseJetEquivalentFamilies
    {F K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : ι → K) (hxy : SignedBaseJetEquivalentFamilies F x y) :
    differentialAdjoin F (Set.range x) = differentialAdjoin F (Set.range y) := by
  rcases hxy with hsub | hadd
  · exact differentialAdjoin_range_eq_of_sub_jetsInBase x y hsub
  · exact differentialAdjoin_range_eq_of_add_jetsInBase x y hadd

/-- Joint differential independence of two nonempty left/right families forces their embedded
generated differential fields to be distinct. -/
theorem differentialIndependent_sum_unequal_differentialAdjoin
    {F K ι κ : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Nonempty ι] (x : ι → K) (y : κ → K)
    (hxy : DifferentialIndependent F (Sum.elim x y)) :
    differentialAdjoin F (Set.range x) ≠ differentialAdjoin F (Set.range y) := by
  unfold DifferentialIndependent at hxy
  let e := Equiv.sumProdDistrib ι κ ℕ
  have hsplit : AlgebraicIndependent F
      (Sum.elim
        (fun p : ι × ℕ => differentialJet p.2 (x p.1))
        (fun p : κ × ℕ => differentialJet p.2 (y p.1))) := by
    have h := AlgebraicIndependent.comp hxy e.symm e.symm.injective
    have hfun :
        ((fun p : (ι ⊕ κ) × ℕ => differentialJet p.2 (Sum.elim x y p.1)) ∘ e.symm) =
        Sum.elim
          (fun p : ι × ℕ => differentialJet p.2 (x p.1))
          (fun p : κ × ℕ => differentialJet p.2 (y p.1)) := by
      funext p
      rcases p with p | p
      · rcases p with ⟨i, n⟩
        simp [e]
      · rcases p with ⟨j, n⟩
        simp [e]
    rw [hfun] at h
    exact h
  have hxOverAlg : AlgebraicIndependent
      (Algebra.adjoin F
        (Set.range fun p : κ × ℕ => differentialJet p.2 (y p.1)))
      (fun p : ι × ℕ => differentialJet p.2 (x p.1)) :=
    (AlgebraicIndependent.sumElim_iff.mp hsplit).2
  have hxOverField : AlgebraicIndependent
      (IntermediateField.adjoin F
        (Set.range fun p : κ × ℕ => differentialJet p.2 (y p.1)))
      (fun p : ι × ℕ => differentialJet p.2 (x p.1)) :=
    IntermediateField.algebraicIndependent_adjoin_iff.mpr hxOverAlg
  have hxOverDifferentialAdjoin : AlgebraicIndependent
      (differentialAdjoin F (Set.range y))
      (fun p : ι × ℕ => differentialJet p.2 (x p.1)) := by
    have hset : differentialJetSet (Set.range y) =
        Set.range (fun p : κ × ℕ => differentialJet p.2 (y p.1)) := by
      ext z
      constructor
      · rintro ⟨w, ⟨j, rfl⟩, n, rfl⟩
        exact ⟨(j, n), rfl⟩
      · rintro ⟨⟨j, n⟩, rfl⟩
        exact ⟨y j, ⟨j, rfl⟩, n, rfl⟩
    rw [differentialAdjoin, hset]
    exact hxOverField
  intro heq
  let i : ι := Classical.choice inferInstance
  have hximem : x i ∈ differentialAdjoin F (Set.range y) := by
    rw [← heq]
    exact subset_differentialAdjoin F (Set.range x) (Set.mem_range_self i)
  have htrans : Transcendental (differentialAdjoin F (Set.range y)) (x i) := by
    simpa using hxOverDifferentialAdjoin.transcendental (i, 0)
  exact htrans (by
    simpa using isAlgebraic_algebraMap
      (R := differentialAdjoin F (Set.range y)) (A := K)
      (⟨x i, hximem⟩ : differentialAdjoin F (Set.range y)))

theorem differentialIndependent_sum_singletons_unequal_differentialAdjoin
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K)
    (hxy : DifferentialIndependent F
      (Sum.elim (fun _ : Unit => x) (fun _ : Unit => y))) :
    differentialAdjoin F ({x} : Set K) ≠ differentialAdjoin F ({y} : Set K) := by
  simpa using differentialIndependent_sum_unequal_differentialAdjoin
    (F := F) (fun _ : Unit => x) (fun _ : Unit => y) hxy

/-- **Exact projective field quotient for palettes.**  Suppose every pair of palettes outside the
global signed base-jet relation is jointly differentially independent.  Their generated embedded
differential fields are equal exactly along that projective relation. -/
theorem differentialAdjoin_range_eq_iff_signedBaseJetEquivalentFamilies
    {F K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Nonempty ι] (x y : ι → K)
    (hfree : ¬ SignedBaseJetEquivalentFamilies F x y →
      DifferentialIndependent F (Sum.elim x y)) :
    differentialAdjoin F (Set.range x) = differentialAdjoin F (Set.range y) ↔
      SignedBaseJetEquivalentFamilies F x y := by
  constructor
  · intro heq
    by_contra hnot
    exact differentialIndependent_sum_unequal_differentialAdjoin x y (hfree hnot) heq
  · exact differentialAdjoin_range_eq_of_signedBaseJetEquivalentFamilies x y

/-- **Exact projective field quotient.**  Suppose every pair outside the signed base-jet relation
is jointly differentially independent.  Then equality of the two embedded generated differential
fields is equivalent to signed base-jet equivalence. -/
theorem differentialAdjoin_singleton_eq_iff_signedBaseJetEquivalent
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x y : K)
    (hfree : ¬ SignedBaseJetEquivalent F x y →
      DifferentialIndependent F
        (Sum.elim (fun _ : Unit => x) (fun _ : Unit => y))) :
    differentialAdjoin F ({x} : Set K) = differentialAdjoin F ({y} : Set K) ↔
      SignedBaseJetEquivalent F x y := by
  constructor
  · intro heq
    by_contra hnot
    exact differentialIndependent_sum_singletons_unequal_differentialAdjoin x y (hfree hnot) heq
  · exact differentialAdjoin_singleton_eq_of_signedBaseJetEquivalent x y

end

end GaloisForLFunctions
