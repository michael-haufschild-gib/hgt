import GaloisForLFunctions.HTGeometry.AsymmetricBinaryTreeRG

/-!
# Generalized-amplitude-damping tree population algebra

The generalized amplitude damping channel with damping `d` and bath population `N` acts on the
diagonal Bloch coordinate by

`z ↦ (1-d)z + d(1-2N)`.

Its restriction to the invariant diagonal algebra is a binary channel.  Multiplication of the
population likelihoods from `p` independent identical branches therefore gives a specialization
of `asymmetricBinaryTreeRG`.  This module formalizes the unconditional algebra of that
specialization, its multiplier, its balanced-bath slice, and its damping endpoints.

Complete positivity, the physical parameter interval, real dynamics, and the external
hypertranscendence classification are not encoded as assumptions.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

/-- Diagonal Bloch-coordinate action of generalized amplitude damping. -/
def gadcPopulationBloch (d N z : ℚ) : ℚ :=
  (1 - d) * z + d * (1 - 2 * N)

/-- Probability of positive output from positive input in the diagonal channel. -/
def gadcPositiveOutputProbability (d N : ℚ) : ℚ :=
  1 - d * N

/-- Probability of positive output from negative input in the diagonal channel. -/
def gadcNegativeOutputProbability (d N : ℚ) : ℚ :=
  d * (1 - N)

/-- Positive-input Bloch endpoint of the channel ellipsoid. -/
theorem gadcPopulationBloch_positiveInput (d N : ℚ) :
    gadcPopulationBloch d N 1 = 1 - 2 * d * N := by
  simp [gadcPopulationBloch]
  ring

/-- Negative-input Bloch endpoint of the channel ellipsoid. -/
theorem gadcPopulationBloch_negativeInput (d N : ℚ) :
    gadcPopulationBloch d N (-1) = 2 * d * (1 - N) - 1 := by
  simp [gadcPopulationBloch]
  ring

/-- Positive transition probability recovered from its Bloch endpoint. -/
theorem gadcPositiveOutputProbability_eq_bloch (d N : ℚ) :
    gadcPositiveOutputProbability d N =
      (1 + gadcPopulationBloch d N 1) / 2 := by
  rw [gadcPopulationBloch_positiveInput]
  simp [gadcPositiveOutputProbability]
  ring

/-- Negative transition probability recovered from its Bloch endpoint. -/
theorem gadcNegativeOutputProbability_eq_bloch (d N : ℚ) :
    gadcNegativeOutputProbability d N =
      (1 + gadcPopulationBloch d N (-1)) / 2 := by
  rw [gadcPopulationBloch_negativeInput]
  simp [gadcNegativeOutputProbability]
  ring

/-- The thermal population is the affine fixed point of sequential damping. -/
@[simp] theorem gadcPopulationBloch_thermalFixedPoint (d N : ℚ) :
    gadcPopulationBloch d N (1 - 2 * N) = 1 - 2 * N := by
  simp [gadcPopulationBloch]
  ring

/-- The channel's positive-parent affine likelihood parameter. -/
def gadcPositiveSignal (d N : ℚ) : ℚ :=
  1 - 2 * d * N

/-- The channel's negative-parent affine likelihood parameter. -/
def gadcNegativeSignal (d N : ℚ) : ℚ :=
  2 * d * (1 - N) - 1

/-- The positive affine parameter is twice its transition probability minus one. -/
theorem gadcPositiveSignal_eq_probability (d N : ℚ) :
    gadcPositiveSignal d N = 2 * gadcPositiveOutputProbability d N - 1 := by
  simp [gadcPositiveSignal, gadcPositiveOutputProbability]
  ring

/-- The negative affine parameter is twice its transition probability minus one. -/
theorem gadcNegativeSignal_eq_probability (d N : ℚ) :
    gadcNegativeSignal d N = 2 * gadcNegativeOutputProbability d N - 1 := by
  simp [gadcNegativeSignal, gadcNegativeOutputProbability]
  ring

/-- Bath population cancels from the exact binary-channel signal gap. -/
theorem gadcOutputProbability_gap (d N : ℚ) :
    gadcPositiveOutputProbability d N - gadcNegativeOutputProbability d N = 1 - d := by
  simp [gadcPositiveOutputProbability, gadcNegativeOutputProbability]
  ring

/-- Equivalently, the two affine likelihood parameters differ by `2(1-d)`. -/
theorem gadcSignal_gap (d N : ℚ) :
    gadcPositiveSignal d N - gadcNegativeSignal d N = 2 * (1 - d) := by
  simp [gadcPositiveSignal, gadcNegativeSignal]
  ring

/-- Exact homogeneous population-likelihood update from `p` identical GADC branches. -/
def gadcHomogeneousPopulationBP (p : ℕ) (d N y : ℚ) : ℚ :=
  asymmetricBinaryHomogeneousBP p
    (gadcPositiveOutputProbability d N)
    (gadcNegativeOutputProbability d N) y

/-- The GADC population update has the exact two-affine-weight rational form. -/
theorem gadcHomogeneousPopulationBP_eq (p : ℕ) (d N y : ℚ) :
    gadcHomogeneousPopulationBP p d N y =
      ((1 + gadcPositiveSignal d N * y) ^ p -
          (1 + gadcNegativeSignal d N * y) ^ p) /
        ((1 + gadcPositiveSignal d N * y) ^ p +
          (1 + gadcNegativeSignal d N * y) ^ p) := by
  rw [gadcHomogeneousPopulationBP, asymmetricBinaryHomogeneousBP_eq]
  rw [gadcPositiveSignal_eq_probability, gadcNegativeSignal_eq_probability]

/-- Rational projective family generated by homogeneous GADC population branches. -/
def gadcTreePopulationRG (p : ℕ) (d N : ℚ) : RatFunc ℚ :=
  asymmetricBinaryTreeRG p (gadcPositiveSignal d N) (gadcNegativeSignal d N)

/-- At a balanced bath, the population family is exactly the symmetric Bethe/BSC family. -/
theorem gadcTreePopulationRG_balancedBath (p : ℕ) (d : ℚ) :
    gadcTreePopulationRG p d (1 / 2) = betheHolographicIsingRG p (1 - d) := by
  rw [gadcTreePopulationRG]
  have hpos : gadcPositiveSignal d (1 / 2) = 1 - d := by
    simp [gadcPositiveSignal]
    ring
  have hneg : gadcNegativeSignal d (1 / 2) = -(1 - d) := by
    simp [gadcNegativeSignal]
    ring
  rw [hpos, hneg, asymmetricBinaryTreeRG_symmetric]

/-- The exact zero-message multiplier is `p(1-d)` and is independent of bath population. -/
theorem gadcTreePopulation_linearMultiplier (p : ℕ) (d N : ℚ) :
    (derivative
          (asymmetricBinaryTreeNumerator p
            (gadcPositiveSignal d N) (gadcNegativeSignal d N))).eval 0 /
        (asymmetricBinaryTreeDenominator p
          (gadcPositiveSignal d N) (gadcNegativeSignal d N)).eval 0 =
      (p : ℚ) * (1 - d) := by
  rw [asymmetricBinaryTree_linearMultiplier, gadcSignal_gap]
  ring

/-- Zero damping is the noiseless symmetric tree family. -/
theorem gadcTreePopulationRG_zeroDamping (p : ℕ) (N : ℚ) :
    gadcTreePopulationRG p 0 N = betheHolographicIsingRG p 1 := by
  rw [gadcTreePopulationRG]
  have hpos : gadcPositiveSignal 0 N = 1 := by simp [gadcPositiveSignal]
  have hneg : gadcNegativeSignal 0 N = -1 := by simp [gadcNegativeSignal]
  rw [hpos, hneg, asymmetricBinaryTreeRG_symmetric]

/-- Full damping erases the input population and collapses the tree update. -/
@[simp] theorem gadcTreePopulationRG_fullDamping (p : ℕ) (N : ℚ) :
    gadcTreePopulationRG p 1 N = 0 := by
  rw [gadcTreePopulationRG]
  have hsignals : gadcNegativeSignal 1 N = gadcPositiveSignal 1 N := by
    simp [gadcPositiveSignal, gadcNegativeSignal]
    ring
  rw [hsignals]
  simp [asymmetricBinaryTreeRG]

end

end GaloisForLFunctions.HTGeometry
