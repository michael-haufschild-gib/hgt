import GaloisForLFunctions.HTGeometry.InvariantSubspaceRootSubset

/-!
# Subsets of the roots are invariant subspaces

The converse of the previous identification: for every `n`-element set of roots of `1 + t^L`, the
ideal generated by the product of `t - r` over that set is a shift-invariant subspace of dimension
`m = L - n`.

With the forward direction this makes the correspondence a bijection: the `m`-dimensional
shift-invariant subspaces of `K[t]/(1 + t^L)` are exactly the ideals cut out by `n`-element sets of
roots.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K : Type*} [Field K]

theorem shiftInvariant_ideal {f : K[X]}
    (I : Ideal (K[X] ⧸ Ideal.span ({f} : Set K[X])))
    (v : K[X] ⧸ Ideal.span ({f} : Set K[X])) (hv : v ∈ I) :
    (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X])) X) * v ∈ I :=
  I.mul_mem_left _ hv

variable [CharZero K] [IsAlgClosed K]

/-- The degree of a product over a subset of the labelled roots. -/
theorem natDegree_prod_rootSubset {m n : ℕ} (hL : 0 < m + n) (S : Finset (Fin (m + n))) :
    (∏ i ∈ S, (X - C (pureCriticalRootLabeling (K := K) hL i))).natDegree = S.card := by
  classical
  rw [Polynomial.natDegree_prod _ _ (fun i _ => Polynomial.X_sub_C_ne_zero _)]
  simp

/-- A product over a subset of the labelled roots divides the cyclic polynomial. -/
theorem prod_rootSubset_dvd {m n : ℕ} (hL : 0 < m + n) (S : Finset (Fin (m + n))) :
    (∏ i ∈ S, (X - C (pureCriticalRootLabeling (K := K) hL i)))
      ∣ pureCriticalCyclicPolynomial (K := K) (m + n) := by
  classical
  rw [← pureCriticalRootLabeling_prod hL]
  exact Finset.prod_dvd_prod_of_subset _ _ _ (Finset.subset_univ S)

/-- **A subset of the roots cuts out an invariant subspace of the complementary dimension.** -/
theorem finrank_ideal_rootSubset {m n : ℕ} (hL : 0 < m + n)
    (S : Finset (Fin (m + n))) (hS : S.card = n) :
    Module.finrank K (Submodule.restrictScalars K
        (Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span
            ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])))
          (Ideal.span ({∏ i ∈ S, (X - C (pureCriticalRootLabeling (K := K) hL i))} : Set K[X]))))
      = m := by
  have hf0 : pureCriticalCyclicPolynomial (K := K) (m + n) ≠ 0 := by
    rw [pureCriticalCyclicPolynomial]
    exact one_add_X_pow_ne_zero hL
  have hsum := finrank_ideal_add_natDegree_of_dvd (K := K) hf0 (prod_rootSubset_dvd hL S)
  rw [natDegree_prod_rootSubset hL S, hS] at hsum
  have hfdeg : (pureCriticalCyclicPolynomial (K := K) (m + n)).natDegree = m + n := by
    rw [pureCriticalCyclicPolynomial, add_comm, ← C_1, natDegree_X_pow_add_C]
  rw [hfdeg] at hsum
  omega

end GaloisForLFunctions.HTGeometry
