import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.Norm.Basic
import Mathlib.RingTheory.Norm.Transitivity
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Separable
import Mathlib.Analysis.SpecialFunctions.Complex.Circle
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# A Kronecker-type lemma on averages of roots of unity

If `f i` (`i : Fin k`) are `m`-th roots of unity and the average `(1/k) ∑ f i` is a **nonzero
algebraic integer**, then all the `f i` coincide.

The proof runs the classical norm argument in the number field `ℚ(f 0, …, f (k-1))`: every
`ℚ`-embedding into `ℂ` sends a root of unity to a root of unity, so every conjugate of the average
has modulus at most one, while the norm is a nonzero rational integer.  Hence all conjugates have
modulus exactly one, and equality in the triangle inequality forces the `f i` to be equal.
-/

namespace GaloisForLFunctions.HTGeometry.GroupCharacter

open Complex

theorem norm_eq_one_of_pow_eq_one {z : ℂ} {m : ℕ} (hm : m ≠ 0) (h : z ^ m = 1) : ‖z‖ = 1 := by
  have h1 : ‖z‖ ^ m = 1 := by rw [← norm_pow, h, norm_one]
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg z) hm).mp h1

theorem eq_one_of_norm_eq_one_of_re_eq_one {z : ℂ} (hn : ‖z‖ = 1) (hre : z.re = 1) : z = 1 := by
  have h1 : z.re ^ 2 + z.im ^ 2 = 1 := by
    have h2 : Complex.normSq z = 1 := by
      rw [Complex.normSq_eq_norm_sq, hn]; norm_num
    simpa [Complex.normSq_apply, sq] using h2
  have h2 : z.im = 0 := by nlinarith [sq_nonneg z.im, h1, hre]
  exact Complex.ext hre (by simpa using h2)

theorem eq_one_of_prod_le_one {ι : Type*} [Fintype ι] [DecidableEq ι] (a : ι → ℝ) (hnn : ∀ i, 0 ≤ a i)
    (hle : ∀ i, a i ≤ 1) (hprod : 1 ≤ ∏ i, a i) (j : ι) : a j = 1 := by
  by_contra hj
  have hlt : a j < 1 := lt_of_le_of_ne (hle j) hj
  have hkey : ∏ i, a i ≤ a j * ∏ i ∈ Finset.univ.erase j, (1 : ℝ) := by
    rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ j), mul_comm]
    refine mul_le_mul_of_nonneg_left ?_ (hnn j)
    exact Finset.prod_le_prod (fun i _ => hnn i) (fun i _ => hle i)
  simp only [Finset.prod_const_one, mul_one] at hkey
  linarith

/-- **Kronecker-type lemma.**  If the `f i` are `m`-th roots of unity and `(1/k) ∑ f i` is a nonzero
algebraic integer, then all the `f i` are equal. -/
theorem eq_const_of_isIntegral_avg {k m : ℕ} (hk : k ≠ 0) (hm : m ≠ 0) (f : Fin k → ℂ)
    (hroots : ∀ i, f i ^ m = 1)
    (hint : IsIntegral ℤ ((k : ℂ)⁻¹ * ∑ i, f i)) (hne : (∑ i, f i) ≠ 0) :
    ∃ ε : ℂ, ∀ i, f i = ε := by
  classical
  have hkC : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hk
  -- the number field generated by the roots of unity
  set S : Set ℂ := Set.range f with hS
  haveI : Finite S := Set.finite_range f
  have hSint : ∀ x ∈ S, IsIntegral ℚ x := by
    rintro _ ⟨i, rfl⟩
    exact ⟨Polynomial.X ^ m - Polynomial.C 1, Polynomial.monic_X_pow_sub_C 1 hm, by
      simp [hroots i]⟩
  set L := IntermediateField.adjoin ℚ S with hL
  haveI : FiniteDimensional ℚ ↥L := IntermediateField.finiteDimensional_adjoin hSint
  haveI : Algebra.IsSeparable ℚ ↥L := Algebra.IsSeparable.of_integral ℚ ↥L
  have hfL : ∀ i, f i ∈ L := fun i => IntermediateField.subset_adjoin ℚ S ⟨i, rfl⟩
  set g : Fin k → ↥L := fun i => ⟨f i, hfL i⟩ with hg
  set x : ↥L := (k : ↥L)⁻¹ * ∑ i, g i with hx
  have hxval : ((x : ↥L) : ℂ) = (k : ℂ)⁻¹ * ∑ i, f i := by
    rw [hx]
    push_cast
    simp [hg]
  -- `x` is a nonzero algebraic integer
  have hxne : x ≠ 0 := by
    intro h
    rw [h] at hxval
    simp only [ZeroMemClass.coe_zero] at hxval
    have h2 : (k : ℂ)⁻¹ * ∑ i, f i = 0 := hxval.symm
    rcases mul_eq_zero.mp h2 with h3 | h3
    · exact hkC (inv_eq_zero.mp h3)
    · exact hne h3
  have hxint : IsIntegral ℤ x := by
    refine IsIntegral.tower_bot (R := ℤ) (A := ↥L) (B := ℂ) ?_ ?_
    · exact FaithfulSMul.algebraMap_injective ↥L ℂ
    · rw [show (algebraMap ↥L ℂ) x = ((x : ↥L) : ℂ) from rfl, hxval]
      exact hint
  -- the norm is a nonzero rational integer
  have hnormint : IsIntegral ℤ (Algebra.norm ℚ x) := Algebra.isIntegral_norm ℚ hxint
  obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hnormint
  have hnormne : Algebra.norm ℚ x ≠ 0 := fun h => hxne (Algebra.norm_eq_zero_iff.mp h)
  have hzne : z ≠ 0 := fun h => hnormne (by rw [← hz, h]; simp)
  -- every conjugate has modulus at most one
  have hgpow : ∀ i, (g i) ^ m = 1 := by
    intro i
    refine Subtype.ext ?_
    push_cast
    simpa [hg] using hroots i
  have hbound : ∀ σ : ↥L →ₐ[ℚ] ℂ, ‖σ x‖ ≤ 1 := by
    intro σ
    have hone : ∀ i, ‖σ (g i)‖ = 1 := by
      intro i
      refine norm_eq_one_of_pow_eq_one hm ?_
      rw [← map_pow, hgpow i, map_one]
    have hσx : σ x = (k : ℂ)⁻¹ * ∑ i, σ (g i) := by
      rw [hx, map_mul, map_inv₀, map_natCast, map_sum]
    rw [hσx, norm_mul, norm_inv, Complex.norm_natCast]
    have hsum : ‖∑ i, σ (g i)‖ ≤ (k : ℝ) := by
      refine le_trans (norm_sum_le _ _) ?_
      rw [Finset.sum_congr rfl (fun i _ => hone i)]
      simp
    rw [inv_mul_le_iff₀ (by positivity)]
    · simpa using hsum
  -- the product of the conjugates is `z`, of modulus at most one, hence exactly one
  have hprod : (algebraMap ℚ ℂ) (Algebra.norm ℚ x) = ∏ σ : ↥L →ₐ[ℚ] ℂ, σ x :=
    Algebra.norm_eq_prod_embeddings ℚ ℂ x
  have hzabs : (1 : ℝ) ≤ ∏ σ : ↥L →ₐ[ℚ] ℂ, ‖σ x‖ := by
    rw [← norm_prod, ← hprod, ← hz]
    have hcast : ((algebraMap ℚ ℂ) ((algebraMap ℤ ℚ) z)) = (z : ℂ) := by
      push_cast
      simp
    rw [hcast]
    have : ‖(z : ℂ)‖ = |(z : ℝ)| := by simp
    rw [this]
    have : (1 : ℤ) ≤ |z| := Int.one_le_abs hzne
    exact_mod_cast this
  have hinclusion0 : ‖(IntermediateField.val L) x‖ = 1 :=
    eq_one_of_prod_le_one (fun σ : ↥L →ₐ[ℚ] ℂ => ‖σ x‖) (fun σ => norm_nonneg _)
      hbound hzabs (IntermediateField.val L)
  have hinclusion : ‖((x : ↥L) : ℂ)‖ = 1 := hinclusion0
  -- equality in the triangle inequality
  rw [hxval, norm_mul, norm_inv, Complex.norm_natCast] at hinclusion
  have hkposR : (0 : ℝ) < (k : ℝ) := by
    have : 0 < k := Nat.pos_of_ne_zero hk
    exact_mod_cast this
  have hsumnorm : ‖∑ i, f i‖ = (k : ℝ) := by
    field_simp at hinclusion
    linarith [hinclusion]
  refine ⟨(k : ℂ)⁻¹ * ∑ i, f i, ?_⟩
  set u : ℂ := (k : ℂ)⁻¹ * ∑ i, f i with hu
  have hune : u ≠ 0 := by
    rw [hu]
    exact mul_ne_zero (inv_ne_zero hkC) hne
  have hunorm : ‖u‖ = 1 := by
    rw [hu, norm_mul, norm_inv, Complex.norm_natCast, hsumnorm]
    field_simp
  have hquot : ∑ i, (f i / u) = (k : ℂ) := by
    rw [← Finset.sum_div, hu]
    field_simp
  have hre : ∑ i, (f i / u).re = (k : ℝ) := by
    have := congrArg Complex.re hquot
    simpa [Complex.re_sum] using this
  have hrele : ∀ i, (f i / u).re ≤ 1 := by
    intro i
    have hnorm : ‖f i / u‖ = 1 := by
      rw [norm_div, hunorm, norm_eq_one_of_pow_eq_one hm (hroots i), div_one]
    calc (f i / u).re ≤ ‖f i / u‖ := Complex.re_le_norm _
      _ = 1 := hnorm
  have hreeq : ∀ i, (f i / u).re = 1 := by
    intro i
    by_contra hi
    have hlt : (f i / u).re < 1 := lt_of_le_of_ne (hrele i) hi
    have : ∑ j, (f j / u).re < ∑ _j : Fin k, (1 : ℝ) :=
      Finset.sum_lt_sum (fun j _ => hrele j) ⟨i, Finset.mem_univ i, hlt⟩
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one] at this
    linarith [hre]
  intro i
  have hnorm : ‖f i / u‖ = 1 := by
    rw [norm_div, hunorm, norm_eq_one_of_pow_eq_one hm (hroots i), div_one]
  have : f i / u = 1 := eq_one_of_norm_eq_one_of_re_eq_one hnorm (hreeq i)
  field_simp at this
  exact this

end GaloisForLFunctions.HTGeometry.GroupCharacter
