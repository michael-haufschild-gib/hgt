import GaloisForLFunctions.HTGeometry.SpectralFormFactorMoments
import GaloisForLFunctions.HTGeometry.FiniteEntropyPlateauFutureLaw

/-!
# Autonomous temporal frame-potential obstruction

The long-time trace moments of a single time-independent Hamiltonian are not
Haar moments.  Their exact values count additive spectral collisions.  The
diagonal multiplicity packets alone force an all-replica floor, independently
of locality, randomness, spectral simplicity, or nonresonance.

Throughout the stable range `1 ≤ m ≤ D`, this floor is strictly larger than
Haar's frame potential `m!` whenever `D ≥ 2`.  Autonomous circuit complexity
can therefore be maximal without the autonomous orbit ever becoming a
unitary design.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Centered symmetric-window trace moment of the autonomous ensemble generated by one finite
real spectrum. Uniform spectral weights turn survival fidelity into normalized squared trace, so
the factor `D^(2m)` restores conventional `|Tr U(t)|^(2m)` normalization. Its completed-time
limit equals the pairwise frame potential of the translation-invariant temporal orbit closure. -/
def autonomousTemporalFramePotentialMean {D : ℕ}
    (energy : Fin D → ℝ) (m : ℕ) (T : ℝ) : ℂ :=
  (D : ℂ) ^ (2 * m) *
    finiteSpectralSurvivalFidelityMean
      (fun _ : Fin D => ((D : ℝ))⁻¹) energy m T

/-- Exact long-time value of the autonomous temporal frame potential. -/
def autonomousTemporalFramePotentialLimit {D : ℕ}
    (energy : Fin D → ℝ) (m : ℕ) : ℝ :=
  (D : ℝ) ^ (2 * m) *
    fidelityReplicaCollisionMass
      (fun _ : Fin D => ((D : ℝ))⁻¹) energy m

/-- Finite-time autonomous trace moments converge to complete additive-energy collision census,
without nonresonance, simplicity, locality, or randomness assumptions. -/
theorem autonomousTemporalFramePotentialMean_tendsto_collisionCensus
    {D : ℕ} (energy : Fin D → ℝ) (m : ℕ) :
    Tendsto (autonomousTemporalFramePotentialMean energy m) atTop
      (𝓝 (autonomousTemporalFramePotentialLimit energy m : ℂ)) := by
  unfold autonomousTemporalFramePotentialMean autonomousTemporalFramePotentialLimit
  simpa only [Complex.ofReal_mul, Complex.ofReal_pow, Complex.ofReal_natCast] using
    (tendsto_const_nhds (x := (D : ℂ) ^ (2 * m))).mul
      (finiteSpectralSurvivalFidelityMean_tendsto_collisionMass
        (fun _ : Fin D => ((D : ℝ))⁻¹) energy m)

/-- Every autonomous temporal ensemble lies above permutation-collision floor. Extra additive
spectral resonances can only increase its frame potential. -/
theorem replicaPairCount_le_autonomousTemporalFramePotentialLimit
    {D : ℕ} (energy : Fin D → ℝ) (m : ℕ) :
    replicaPairCount D m ≤ autonomousTemporalFramePotentialLimit energy m := by
  by_cases hD : D = 0
  · subst D
    by_cases hm : m = 0
    · subst m
      norm_num [autonomousTemporalFramePotentialLimit, replicaPairCount,
        fidelityReplicaCollisionMass, fidelityReplicaPermutationFloor,
        fidelityReplicaResonanceExcess, fidelityReplicaMultiplicityWeight]
    · have hmpos : 0 < m := Nat.pos_of_ne_zero hm
      simp [autonomousTemporalFramePotentialLimit, replicaPairCount,
        fidelityReplicaCollisionMass, fidelityReplicaPermutationFloor,
        fidelityReplicaResonanceExcess, hmpos.ne']
  · have hDpos : 0 < D := Nat.pos_of_ne_zero hD
    have hweight : ∀ i : Fin D, 0 < ((D : ℝ))⁻¹ := by
      intro i
      positivity
    have hfloor := fidelityReplicaCollisionMass_floor_le hweight energy m
    have hpow : 0 ≤ (D : ℝ) ^ (2 * m) := by positivity
    calc
      replicaPairCount D m =
          (D : ℝ) ^ (2 * m) *
            fidelityReplicaPermutationFloor
              (fun _ : Fin D => ((D : ℝ))⁻¹) m := by
        rw [fidelityReplicaPermutationFloor_uniform]
        have hDreal : (D : ℝ) ≠ 0 := by exact_mod_cast hD
        field_simp
      _ ≤ (D : ℝ) ^ (2 * m) *
          fidelityReplicaCollisionMass
            (fun _ : Fin D => ((D : ℝ))⁻¹) energy m :=
        mul_le_mul_of_nonneg_left hfloor hpow
      _ = autonomousTemporalFramePotentialLimit energy m := rfl

/-- First permutation collision census is exactly Hilbert-space dimension. -/
theorem replicaPairCount_one (D : ℕ) : replicaPairCount D 1 = D := by
  classical
  unfold replicaPairCount
  rw [piAntidiag_one_eq_image_single]
  rw [Finset.sum_image]
  · calc
      (∑ i : Fin D,
          (Nat.multinomial Finset.univ
            (fun j : Fin D => if j = i then 1 else 0) : ℝ) ^ 2) =
          ∑ _i : Fin D, (1 : ℝ) := by
            apply Finset.sum_congr rfl
            intro i hi
            have honeHot :
                (fun j : Fin D => if j = i then 1 else 0) = Pi.single i 1 := by
              funext j
              simp [Pi.single_apply, eq_comm]
            have hmult :
                Nat.multinomial Finset.univ
                    (fun j : Fin D => if j = i then 1 else 0) = 1 := by
              rw [honeHot]
              exact Nat.multinomial_single Finset.univ i 1
            simp [hmult]
      _ = D := by simp
  · intro i hi j hj hij
    by_contra hne
    have h := congrFun hij i
    simp [hne] at h

/-- Throughout the stable Haar range, permutation collisions alone strictly
exceed Haar's frame potential `m!` in every nontrivial dimension. -/
theorem factorial_lt_replicaPairCount_of_stableRange
    {D m : ℕ} (hD : 2 ≤ D) (hm : 1 ≤ m) (hmD : m ≤ D) :
    (Nat.factorial m : ℝ) < replicaPairCount D m := by
  rcases eq_or_lt_of_le hm with rfl | hmTwo
  · simpa [replicaPairCount_one] using
      (show (1 : ℝ) < D by exact_mod_cast hD)
  · have hchooseNat : 0 < D.choose m := Nat.choose_pos hmD
    have hchoose : (1 : ℝ) ≤ D.choose m := by exact_mod_cast hchooseNat
    have hfactorialNat : 1 < Nat.factorial m :=
      Nat.one_lt_factorial.mpr hmTwo
    have hfactorial : (1 : ℝ) < Nat.factorial m := by
      exact_mod_cast hfactorialNat
    have hlower := le_replicaPairCount D m
    calc
      (Nat.factorial m : ℝ) <
          (D.choose m : ℝ) * (Nat.factorial m : ℝ) ^ 2 := by nlinarith
      _ ≤ replicaPairCount D m := hlower

/-- **All-stable-replica autonomous design obstruction.**  At every order
`1 ≤ m ≤ D`, the completed temporal frame potential of one finite autonomous
Hamiltonian is strictly larger than the Haar value `m!`. -/
theorem factorial_lt_autonomousTemporalFramePotentialLimit_of_stableRange
    {D m : ℕ} (hD : 2 ≤ D) (hm : 1 ≤ m) (hmD : m ≤ D)
    (energy : Fin D → ℝ) :
    (Nat.factorial m : ℝ) < autonomousTemporalFramePotentialLimit energy m :=
  (factorial_lt_replicaPairCount_of_stableRange hD hm hmD).trans_le
    (replicaPairCount_le_autonomousTemporalFramePotentialLimit energy m)

/-- Stable-replica separation holds on every sufficiently late centered time
window, not merely at the completed limit. -/
theorem eventually_factorial_lt_re_autonomousTemporalFramePotentialMean_of_stableRange
    {D m : ℕ} (hD : 2 ≤ D) (hm : 1 ≤ m) (hmD : m ≤ D)
    (energy : Fin D → ℝ) :
    ∀ᶠ T : ℝ in atTop,
      (Nat.factorial m : ℝ) <
        (autonomousTemporalFramePotentialMean energy m T).re := by
  have htend :
      Tendsto (fun T => (autonomousTemporalFramePotentialMean energy m T).re) atTop
        (𝓝 (autonomousTemporalFramePotentialLimit energy m)) := by
    change Tendsto
      (Complex.re ∘ autonomousTemporalFramePotentialMean energy m) atTop
        (𝓝 (autonomousTemporalFramePotentialLimit energy m))
    exact Complex.continuous_re.continuousAt.tendsto.comp
      (autonomousTemporalFramePotentialMean_tendsto_collisionCensus energy m)
  exact htend.eventually_const_lt
    (factorial_lt_autonomousTemporalFramePotentialLimit_of_stableRange
      hD hm hmD energy)

/-- **Autonomous first-design obstruction.** Long-time first frame potential of every
finite-dimensional time-independent Hamiltonian orbit is at least Hilbert-space dimension. For
every nontrivial quantum system this is strictly above Haar value `1`. -/
theorem dimension_le_autonomousTemporalFramePotentialLimit_one
    {D : ℕ} (energy : Fin D → ℝ) :
    (D : ℝ) ≤ autonomousTemporalFramePotentialLimit energy 1 := by
  simpa [replicaPairCount_one] using
    replicaPairCount_le_autonomousTemporalFramePotentialLimit energy 1

/-- In dimension at least two, autonomous one-parameter orbit remains separated from Haar at
first frame-potential order. -/
theorem one_lt_autonomousTemporalFramePotentialLimit_one
    {D : ℕ} (hD : 2 ≤ D) (energy : Fin D → ℝ) :
    1 < autonomousTemporalFramePotentialLimit energy 1 := by
  have hdim : (1 : ℝ) < D := by exact_mod_cast (lt_of_lt_of_le Nat.one_lt_two hD)
  exact hdim.trans_le (dimension_le_autonomousTemporalFramePotentialLimit_one energy)

/-- Obstruction is not merely limiting equality: every sufficiently late centered time window
has first trace moment strictly above Haar first frame-potential value. -/
theorem eventually_one_lt_re_autonomousTemporalFramePotentialMean_one
    {D : ℕ} (hD : 2 ≤ D) (energy : Fin D → ℝ) :
    ∀ᶠ T : ℝ in atTop,
      1 < (autonomousTemporalFramePotentialMean energy 1 T).re := by
  have htend :
      Tendsto (fun T => (autonomousTemporalFramePotentialMean energy 1 T).re) atTop
        (𝓝 (autonomousTemporalFramePotentialLimit energy 1)) := by
    change Tendsto
      (Complex.re ∘ autonomousTemporalFramePotentialMean energy 1) atTop
        (𝓝 (autonomousTemporalFramePotentialLimit energy 1))
    exact Complex.continuous_re.continuousAt.tendsto.comp
      (autonomousTemporalFramePotentialMean_tendsto_collisionCensus energy 1)
  exact htend.eventually_const_lt
    (one_lt_autonomousTemporalFramePotentialLimit_one hD energy)

end

end GaloisForLFunctions.HTGeometry
