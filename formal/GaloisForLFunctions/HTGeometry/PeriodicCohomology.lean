import GaloisForLFunctions.HTGeometry.PeriodicFullAverage
import GaloisForLFunctions.HTGeometry.AlternatingFormExterior

/-!
# The cohomology of the periodic de Rham complex

A differential form on the torus obtained from a coordinate space by dividing out the lattice
generated by a nonzero period in each coordinate direction is a periodic form on the coordinate
space, so the de Rham complex of the torus is the complex of periodic forms of class `C^1`.  The
closed periodic forms of a given degree form a module, the exterior derivatives of periodic forms
form a submodule, and the quotient is the cohomology of the torus in that degree.  Sending a
constant alternating form to its class is an isomorphism onto that quotient: it is surjective
because averaging over the periods writes every closed periodic form as a constant form plus an
exact one, and injective because a constant form with a periodic primitive vanishes.  So the
inclusion of the translation-invariant forms into the periodic de Rham complex is a
quasi-isomorphism.

* `periodicClosedForms`, `periodicExactForms`, `periodicCohomology` : the cohomology module.
* `periodicCohomologyEquiv` : the cohomology of the torus is the space of constant alternating
  forms.
* `periodicCohomologyExteriorEquiv` : that cohomology is the exterior power of the coordinate
  space.
* `torusCohomologyEquiv`, `torusCohomologyExteriorEquiv` : the case of the real torus with the
  standard integer lattice.
-/

set_option maxSynthPendingDepth 3

namespace GaloisForLFunctions.HTGeometry

open ContinuousAlternatingMap

section PeriodicForms

variable {𝕜 : Type*} [RCLike 𝕜] {r n : ℕ}

/-- The space of forms on the torus in a given degree: periodic maps of class `C^1` from the
coordinate space to the alternating forms of that degree. -/
abbrev PeriodicFormSpace (𝕜 : Type*) [RCLike 𝕜] (r n : ℕ) :=
  (Fin r → 𝕜) → (Fin r → 𝕜) [⋀^Fin n]→L[𝕜] 𝕜

/-- The derivative of a sum of two differentiable maps into alternating forms. -/
theorem fderiv_form_add {ω₁ ω₂ : PeriodicFormSpace 𝕜 r n} (h₁ : Differentiable 𝕜 ω₁)
    (h₂ : Differentiable 𝕜 ω₂) :
    fderiv 𝕜 (ω₁ + ω₂) = fun w => fderiv 𝕜 ω₁ w + fderiv 𝕜 ω₂ w := by
  funext w
  exact fderiv_fun_add (h₁ w) (h₂ w)

/-- Continuity of a sum of derivatives, with the addition instance on the operator space named. -/
theorem continuous_fderiv_add {ω₁ ω₂ : PeriodicFormSpace 𝕜 r n} (h₁ : Continuous (fderiv 𝕜 ω₁))
    (h₂ : Continuous (fderiv 𝕜 ω₂)) :
    Continuous fun w => fderiv 𝕜 ω₁ w + fderiv 𝕜 ω₂ w := by
  haveI : ContinuousAdd ((Fin r → 𝕜) →L[𝕜] ((Fin r → 𝕜) [⋀^Fin n]→L[𝕜] 𝕜)) := by
    have htag : IsTopologicalAddGroup
        ((Fin r → 𝕜) →L[𝕜] ((Fin r → 𝕜) [⋀^Fin n]→L[𝕜] 𝕜)) := inferInstance
    exact htag.toContinuousAdd
  exact h₁.add h₂

/-- **The closed periodic forms of class `C^1` of a given degree.** -/
def periodicClosedForms (p : 𝕜) (r n : ℕ) : Submodule 𝕜 (PeriodicFormSpace 𝕜 r n) where
  carrier := {ω | Differentiable 𝕜 ω ∧ Continuous (fderiv 𝕜 ω) ∧
    (∀ (l : Fin r) (w : Fin r → 𝕜), ω (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = ω w) ∧
    ∀ w : Fin r → 𝕜, extDeriv ω w = 0}
  zero_mem' := by
    refine ⟨differentiable_const _, ?_, fun _ _ => rfl, fun w => extDeriv_const 0 w⟩
    have hfd : fderiv 𝕜 (0 : PeriodicFormSpace 𝕜 r n) = fun _ => 0 := by
      funext w
      exact fderiv_const_apply _
    rw [hfd]
    exact continuous_const
  add_mem' := by
    rintro ω₁ ω₂ ⟨h₁, hc₁, hp₁, hz₁⟩ ⟨h₂, hc₂, hp₂, hz₂⟩
    refine ⟨h₁.add h₂, ?_, fun l w => ?_, fun w => ?_⟩
    · rw [fderiv_form_add h₁ h₂]
      exact continuous_fderiv_add hc₁ hc₂
    · show ω₁ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) +
        ω₂ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = ω₁ w + ω₂ w
      rw [hp₁ l w, hp₂ l w]
    · show extDeriv (fun y => ω₁ y + ω₂ y) w = 0
      rw [extDeriv_fun_add (h₁ w) (h₂ w), hz₁ w, hz₂ w, add_zero]
  smul_mem' := by
    rintro c ω ⟨h, hc, hpp, hz⟩
    refine ⟨fun w => (h w).const_smul c, ?_, fun l w => ?_, fun w => ?_⟩
    · have hfd : fderiv 𝕜 (c • ω) = fun w => c • fderiv 𝕜 ω w := by
        funext w
        exact fderiv_const_smul (h w) c
      rw [hfd]
      exact hc.const_smul c
    · show c • ω (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = c • ω w
      rw [hpp l w]
    · show extDeriv (c • ω) w = 0
      rw [extDeriv_smul, hz w, smul_zero]

theorem mem_periodicClosedForms {p : 𝕜} {ω : PeriodicFormSpace 𝕜 r n} :
    ω ∈ periodicClosedForms p r n ↔ Differentiable 𝕜 ω ∧ Continuous (fderiv 𝕜 ω) ∧
      (∀ (l : Fin r) (w : Fin r → 𝕜), ω (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = ω w) ∧
      ∀ w : Fin r → 𝕜, extDeriv ω w = 0 :=
  Iff.rfl

/-- **The exact forms among the closed periodic forms**: the exterior derivatives of periodic forms
of class `C^1` one degree lower. -/
def periodicExactForms (p : 𝕜) (r n : ℕ) : Submodule 𝕜 (periodicClosedForms p r (n + 1)) where
  carrier := {ω | ∃ θ : PeriodicFormSpace 𝕜 r n, Differentiable 𝕜 θ ∧ Continuous (fderiv 𝕜 θ) ∧
    (∀ (l : Fin r) (w : Fin r → 𝕜), θ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = θ w) ∧
    ∀ w : Fin r → 𝕜, (ω : PeriodicFormSpace 𝕜 r (n + 1)) w = extDeriv θ w}
  zero_mem' := by
    refine ⟨0, differentiable_const _, ?_, fun _ _ => rfl, fun w => (extDeriv_const 0 w).symm⟩
    have hfd : fderiv 𝕜 (0 : PeriodicFormSpace 𝕜 r n) = fun _ => 0 := by
      funext w
      exact fderiv_const_apply _
    rw [hfd]
    exact continuous_const
  add_mem' := by
    rintro ω₁ ω₂ ⟨θ₁, h₁, hc₁, hp₁, he₁⟩ ⟨θ₂, h₂, hc₂, hp₂, he₂⟩
    refine ⟨θ₁ + θ₂, h₁.add h₂, ?_, fun l w => ?_, fun w => ?_⟩
    · rw [fderiv_form_add h₁ h₂]
      exact continuous_fderiv_add hc₁ hc₂
    · show θ₁ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) +
        θ₂ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = θ₁ w + θ₂ w
      rw [hp₁ l w, hp₂ l w]
    · show (ω₁ : PeriodicFormSpace 𝕜 r (n + 1)) w + (ω₂ : PeriodicFormSpace 𝕜 r (n + 1)) w =
        extDeriv (fun y => θ₁ y + θ₂ y) w
      rw [extDeriv_fun_add (h₁ w) (h₂ w), he₁ w, he₂ w]
  smul_mem' := by
    rintro c ω ⟨θ, h, hc, hpp, he⟩
    refine ⟨c • θ, fun w => (h w).const_smul c, ?_, fun l w => ?_, fun w => ?_⟩
    · have hfd : fderiv 𝕜 (c • θ) = fun w => c • fderiv 𝕜 θ w := by
        funext w
        exact fderiv_const_smul (h w) c
      rw [hfd]
      exact hc.const_smul c
    · show c • θ (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = c • θ w
      rw [hpp l w]
    · show c • ((ω : PeriodicFormSpace 𝕜 r (n + 1)) w) = extDeriv (c • θ) w
      rw [extDeriv_smul, he w]

/-- **The de Rham cohomology of the torus in a given degree**, computed by periodic forms on the
coordinate space. -/
abbrev periodicCohomology (p : 𝕜) (r n : ℕ) :=
  (↥(periodicClosedForms p r (n + 1))) ⧸ (periodicExactForms p r n)

end PeriodicForms

section CohomologyEquiv

variable {𝕜 : Type*} [RCLike 𝕜] {r n : ℕ}

/-- A constant form is a closed periodic form of class `C^1`. -/
theorem constantForm_mem (p : 𝕜) (α : (Fin r → 𝕜) [⋀^Fin (n + 1)]→L[𝕜] 𝕜) :
    (fun _ : Fin r → 𝕜 => α) ∈ periodicClosedForms p r (n + 1) := by
  refine ⟨differentiable_const _, ?_, fun _ _ => rfl, fun w => extDeriv_const α w⟩
  have hfd : fderiv 𝕜 (fun _ : Fin r → 𝕜 => α) = fun _ => 0 := by
    funext w
    exact fderiv_const_apply _
  rw [hfd]
  exact continuous_const

/-- **The class of a constant alternating form** in the cohomology of the torus. -/
noncomputable def constantClass (p : 𝕜) (r n : ℕ) :
    ((Fin r → 𝕜) [⋀^Fin (n + 1)]→L[𝕜] 𝕜) →ₗ[𝕜] periodicCohomology p r n where
  toFun α := Submodule.Quotient.mk ⟨fun _ => α, constantForm_mem p α⟩
  map_add' α β := by
    refine congrArg Submodule.Quotient.mk (Subtype.ext ?_)
    funext w
    rfl
  map_smul' c α := by
    refine congrArg Submodule.Quotient.mk (Subtype.ext ?_)
    funext w
    rfl

/-- **The cohomology of the torus is the space of constant alternating forms**: the inclusion of
the translation-invariant forms into the periodic de Rham complex is a quasi-isomorphism.  Every
class contains exactly one constant form — at least one because averaging a closed periodic form
over all the coordinate periods produces a constant form and changes it by an exact form with a
periodic primitive, and at most one because a constant form with a periodic primitive vanishes. -/
noncomputable def periodicCohomologyEquiv {p : 𝕜} (hp : p ≠ 0) (r n : ℕ) :
    ((Fin r → 𝕜) [⋀^Fin (n + 1)]→L[𝕜] 𝕜) ≃ₗ[𝕜] periodicCohomology p r n := by
  refine LinearEquiv.ofBijective (constantClass p r n) ⟨?_, ?_⟩
  · refine (injective_iff_map_eq_zero (constantClass p r n)).2 fun α hα => ?_
    have hexact : (⟨fun _ => α, constantForm_mem p α⟩ : periodicClosedForms p r (n + 1)) ∈
        periodicExactForms p r n := by
      rwa [← Submodule.Quotient.mk_eq_zero]
    obtain ⟨θ, hθ, hθc, hθp, hθeq⟩ := hexact
    exact periodic_const_add_exact_unique (α' := 0) hp hθ hθc hθp
      fun w => by rw [zero_add]; exact hθeq w
  · intro ξ
    refine Quotient.inductionOn' ξ fun ω => ?_
    obtain ⟨hdiff, hcont, hper, hclosed⟩ := ω.2
    obtain ⟨α, η, hηdiff, hηcont, hηper, hdecomp⟩ :=
      periodic_closed_eq_const_add_exact hp hdiff hcont hper hclosed
    refine ⟨α, ?_⟩
    refine (Submodule.Quotient.eq _).2 ?_
    refine ⟨fun y => -η y, fun w => (hηdiff w).neg, ?_, fun l w => ?_, fun w => ?_⟩
    · have hfun : (fun y : Fin r → 𝕜 => -η y) = (-1 : 𝕜) • η := by
        funext y
        rw [Pi.smul_apply, negOne_smul_alternating]
      rw [hfun]
      have hfd : fderiv 𝕜 ((-1 : 𝕜) • η) = fun w => (-1 : 𝕜) • fderiv 𝕜 η w := by
        funext w
        exact fderiv_const_smul (hηdiff w) (-1 : 𝕜)
      rw [hfd]
      exact hηcont.const_smul (-1 : 𝕜)
    · show -η (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = -η w
      rw [hηper l w]
    · show α - (ω : PeriodicFormSpace 𝕜 r (n + 1)) w = extDeriv (fun y => -η y) w
      have hneg : extDeriv (fun y => -η y) w = -extDeriv η w := by
        have hfun : (fun y : Fin r → 𝕜 => -η y) = (-1 : 𝕜) • η := by
          funext y
          rw [Pi.smul_apply, negOne_smul_alternating]
        rw [hfun, extDeriv_smul, negOne_smul_alternating]
      rw [hneg, hdecomp w]
      abel

/-- **The cohomology of the torus is the exterior power of the coordinate space**: the classes of
the invariant forms of degree `k` make up `Λ^k` of the universal cover. -/
noncomputable def periodicCohomologyExteriorEquiv {p : 𝕜} (hp : p ≠ 0) (r n : ℕ) :
    periodicCohomology p r n ≃ₗ[𝕜] ⋀[𝕜]^(n + 1) (Fin r → 𝕜) :=
  (periodicCohomologyEquiv hp r n).symm.trans (alternatingFormExteriorEquiv 𝕜 r (n + 1))

end CohomologyEquiv

section RealTorus

variable {r n : ℕ}

/-- **The de Rham cohomology of the real torus `ℝ^r / ℤ^r`** in degree `n + 1` is the space of
constant alternating forms of that degree, a form on the torus being a form on `ℝ^r` invariant under
the standard integer lattice. -/
noncomputable def torusCohomologyEquiv (r n : ℕ) :
    ((Fin r → ℝ) [⋀^Fin (n + 1)]→L[ℝ] ℝ) ≃ₗ[ℝ] periodicCohomology (1 : ℝ) r n :=
  periodicCohomologyEquiv one_ne_zero r n

/-- **The de Rham cohomology of the real torus is the exterior power of its universal cover.** -/
noncomputable def torusCohomologyExteriorEquiv (r n : ℕ) :
    periodicCohomology (1 : ℝ) r n ≃ₗ[ℝ] ⋀[ℝ]^(n + 1) (Fin r → ℝ) :=
  periodicCohomologyExteriorEquiv one_ne_zero r n

end RealTorus

end GaloisForLFunctions.HTGeometry
