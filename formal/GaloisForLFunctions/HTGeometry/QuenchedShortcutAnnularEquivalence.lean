import Mathlib.MeasureTheory.Measure.Haar.NormedSpace
import Mathlib.Analysis.SpecialFunctions.Exp

/-!
# The quenched shortcut–annular equivalence

A shortcut event read at time `t` from a coefficient vector `x` is the shortcut event at time one
read at `t • x`: the observable is homogeneous because its generator is linear, and the rarity
functional is radially invariant because the completed one-parameter orbit through `a • y` is the
completed one-parameter orbit through `y` whenever `a ≠ 0` — the two parameter rays sweep the same
set.  Consequently the Gaussian mass of the time-`t` event is a dilation integral over the fixed
time-one shortcut set.

That identity turns a probability bound into a ball-volume bound and, conversely, an annular volume
bound into a probability bound by dyadic shell summation.  Rarity-resolved complexity growth is
therefore exactly an annular packing problem, with no genericity, mixing, circuit or locality
premise anywhere.

All measure-theoretic statements are made in `ℝ≥0∞`, so no integrability side condition enters.
-/

open scoped ENNReal
open MeasureTheory Metric

namespace GaloisForLFunctions.HTGeometry

/-! ## Scale invariance of the completed one-parameter orbit -/

section Ray

variable {V P : Type*} [AddCommGroup V] [Module ℝ V]

/-- The one-parameter orbit swept by an observable along the ray through `y`. -/
def oneParameterRayOrbit (f : V → P) (y : V) : Set P := Set.range fun s : ℝ => f (s • y)

/-- **The ray orbit is radially invariant.**  Rescaling the coefficient vector reparametrises the
ray by a nonzero factor and sweeps exactly the same set of states. -/
theorem oneParameterRayOrbit_smul (f : V → P) {a : ℝ} (ha : a ≠ 0) (y : V) :
    oneParameterRayOrbit f (a • y) = oneParameterRayOrbit f y := by
  ext z
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨s * a, ?_⟩
    simp only [mul_smul]
  · rintro ⟨s, rfl⟩
    refine ⟨s * a⁻¹, ?_⟩
    have hsa : s * a⁻¹ * a = s := by field_simp
    simp only [smul_smul, hsa]

/-- The observable generated by a linear map is homogeneous: reading it at time `t` from `x` is
reading it at time one from `t • x`. -/
theorem linear_generator_homogeneous {W : Type*} [AddCommGroup W] [Module ℝ W]
    (H : V →ₗ[ℝ] W) (U : W → P) (t : ℝ) (x : V) :
    U (t • H x) = (fun y => U (H y)) (t • x) := by
  simp only [map_smul]

end Ray

section Orbit

variable {V P : Type*} [AddCommGroup V] [Module ℝ V] [TopologicalSpace P]

/-- The closure of the one-parameter ray orbit: the completed one-parameter orbit. -/
def completedRayOrbit (f : V → P) (y : V) : Set P := closure (oneParameterRayOrbit f y)

/-- **The completed one-parameter orbit is radially invariant.** -/
theorem completedRayOrbit_smul (f : V → P) {a : ℝ} (ha : a ≠ 0) (y : V) :
    completedRayOrbit f (a • y) = completedRayOrbit f y := by
  unfold completedRayOrbit
  rw [oneParameterRayOrbit_smul f ha]

/-- Every quantity read off the completed one-parameter orbit — in particular the Haar mass of a
target and its negative logarithm — is radially scale invariant. -/
theorem orbitFunctional_smul {W : Type*} (Ψ : Set P → W) (f : V → P) {a : ℝ} (ha : a ≠ 0) (y : V) :
    Ψ (completedRayOrbit f (a • y)) = Ψ (completedRayOrbit f y) := by
  rw [completedRayOrbit_smul f ha]

/-- The resolved unit-time shortcut set: the observable hits the target and the completed orbit
makes the target at least `B`-rare. -/
def resolvedShortcutSet (f : V → P) (Ψ : Set P → ℝ) (E : Set P) (B : ℝ) : Set V :=
  {y | f y ∈ E ∧ B ≤ Ψ (completedRayOrbit f y)}

/-- **The homogeneity reduction.**  For every nonzero time `t`, the resolved shortcut event at time
`t` is the preimage of the fixed unit-time shortcut set under the dilation `x ↦ t • x`. -/
theorem timeEvent_eq_preimage_smul (f : V → P) (Ψ : Set P → ℝ) (E : Set P) (B : ℝ)
    {t : ℝ} (ht : t ≠ 0) :
    {x : V | f (t • x) ∈ E ∧ B ≤ Ψ (completedRayOrbit f x)}
      = (fun x : V => t • x) ⁻¹' resolvedShortcutSet f Ψ E B := by
  ext x
  simp only [Set.mem_setOf_eq, Set.mem_preimage, resolvedShortcutSet]
  rw [orbitFunctional_smul Ψ f ht x]

end Orbit

/-! ## The Gaussian weight and its dyadic shells -/

section Weight

variable {V : Type*} [NormedAddCommGroup V]

/-- Unnormalized Gaussian weight of width `t`. -/
noncomputable def gaussianWeightAt (t : ℝ) (y : V) : ℝ≥0∞ :=
  ENNReal.ofReal (Real.exp (-‖y‖ ^ 2 / (2 * t ^ 2)))

/-- On the ball of radius `t` the width-`t` Gaussian weight is at least `e^{-1/2}`. -/
theorem gaussianWeightAt_ge_on_closedBall {t : ℝ} (ht : 0 < t) {y : V}
    (hy : y ∈ closedBall (0 : V) t) :
    ENNReal.ofReal (Real.exp (-(1 : ℝ) / 2)) ≤ gaussianWeightAt t y := by
  have hy' : ‖y‖ ≤ t := mem_closedBall_zero_iff.mp hy
  have h0 : (0 : ℝ) ≤ ‖y‖ := norm_nonneg y
  have hle : -(1 : ℝ) / 2 ≤ -‖y‖ ^ 2 / (2 * t ^ 2) := by
    rw [div_le_div_iff₀ (by norm_num) (by positivity)]
    nlinarith
  unfold gaussianWeightAt
  exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr hle)

/-- The dyadic decomposition of the coefficient space: the ball of radius `2t`, then the shells
between consecutive dyadic radii. -/
def dyadicShell (t : ℝ) : ℕ → Set V
  | 0 => closedBall (0 : V) (2 * t)
  | (j + 1) => {y | 2 ^ (j + 1) * t < ‖y‖ ∧ ‖y‖ ≤ 2 ^ (j + 2) * t}

theorem dyadicShell_subset_closedBall (t : ℝ) (j : ℕ) :
    dyadicShell (V := V) t j ⊆ closedBall (0 : V) (2 ^ (j + 1) * t) := by
  cases j with
  | zero =>
      intro y hy
      have hy' : ‖y‖ ≤ 2 * t := mem_closedBall_zero_iff.mp hy
      rw [mem_closedBall_zero_iff]
      simpa using hy'
  | succ k =>
      intro y hy
      rw [mem_closedBall_zero_iff]
      exact hy.2

theorem iUnion_dyadicShell {t : ℝ} (ht : 0 < t) :
    (⋃ j : ℕ, dyadicShell (V := V) t j) = Set.univ := by
  classical
  ext y
  simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
  have hexists : ∃ j : ℕ, ‖y‖ ≤ 2 ^ (j + 1) * t := by
    obtain ⟨n, hn⟩ := exists_nat_gt (‖y‖ / t)
    refine ⟨n, ?_⟩
    have h2 : (n : ℝ) ≤ 2 ^ n := by exact_mod_cast (Nat.lt_two_pow_self (n := n)).le
    have h3 : (2 : ℝ) ^ n ≤ 2 ^ (n + 1) := by
      refine pow_le_pow_right₀ (by norm_num) ?_
      omega
    have h4 : ‖y‖ / t < 2 ^ (n + 1) := lt_of_lt_of_le hn (h2.trans h3)
    rw [div_lt_iff₀ ht] at h4
    exact le_of_lt h4
  rcases Nat.eq_zero_or_pos (Nat.find hexists) with h0 | hpos
  · refine ⟨0, ?_⟩
    have hj := Nat.find_spec hexists
    rw [h0] at hj
    show y ∈ closedBall (0 : V) (2 * t)
    rw [mem_closedBall_zero_iff]
    simpa using hj
  · obtain ⟨k, hk⟩ : ∃ k, Nat.find hexists = k + 1 := ⟨Nat.find hexists - 1, by omega⟩
    refine ⟨k + 1, ?_⟩
    have hj := Nat.find_spec hexists
    rw [hk] at hj
    have hnot : ¬ (‖y‖ ≤ 2 ^ (k + 1) * t) := Nat.find_min hexists (by omega)
    show 2 ^ (k + 1) * t < ‖y‖ ∧ ‖y‖ ≤ 2 ^ (k + 2) * t
    exact ⟨not_le.mp hnot, hj⟩

/-- The Gaussian weight on the `j`th dyadic shell is at most `e^{1/2 - 4^j/2}`. -/
theorem gaussianWeightAt_le_on_dyadicShell {t : ℝ} (ht : 0 < t) (j : ℕ) {y : V}
    (hy : y ∈ dyadicShell (V := V) t j) :
    gaussianWeightAt t y ≤ ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) := by
  unfold gaussianWeightAt
  refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
  have ht2 : (0 : ℝ) < 2 * t ^ 2 := by positivity
  cases j with
  | zero =>
      rw [div_le_iff₀ ht2]
      norm_num
  | succ k =>
      have hlow : 2 ^ (k + 1) * t < ‖y‖ := hy.1
      have hpow : ((2 : ℝ) ^ (k + 1)) ^ 2 = (4 : ℝ) ^ (k + 1) := by
        rw [← pow_mul, mul_comm, pow_mul]
        norm_num
      have hnn : (0 : ℝ) ≤ 2 ^ (k + 1) * t := by positivity
      have hsq : ((2 : ℝ) ^ (k + 1) * t) ^ 2 ≤ ‖y‖ ^ 2 := by nlinarith
      have hsq' : (4 : ℝ) ^ (k + 1) * t ^ 2 ≤ ‖y‖ ^ 2 := by
        rw [mul_pow, hpow] at hsq
        exact hsq
      rw [div_le_iff₀ ht2]
      nlinarith [sq_nonneg t]

end Weight

section WeightSmul

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

theorem gaussianWeightAt_smul {t : ℝ} (ht : 0 < t) (x : V) :
    gaussianWeightAt t (t • x) = gaussianWeightAt 1 x := by
  unfold gaussianWeightAt
  have hnorm : ‖t • x‖ = t * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
  have hexp : -‖t • x‖ ^ 2 / (2 * t ^ 2) = -‖x‖ ^ 2 / (2 * 1 ^ 2) := by
    rw [hnorm, mul_pow]
    field_simp
  rw [hexp]

end WeightSmul

/-! ## Ball and shell bounds for the Gaussian mass -/

section Mass

variable {V : Type*} [NormedAddCommGroup V] [MeasurableSpace V] [BorelSpace V]

theorem measurable_gaussianWeightAt (t : ℝ) : Measurable (gaussianWeightAt (V := V) t) := by
  unfold gaussianWeightAt
  refine ENNReal.measurable_ofReal.comp ?_
  fun_prop

/-- **The ball-volume bound.**  The Haar mass of the part of `S` inside the ball of radius `t` is
controlled by the width-`t` Gaussian mass of `S`. -/
theorem measure_inter_closedBall_le_lintegral (μ : Measure V) {t : ℝ} (ht : 0 < t) (S : Set V) :
    ENNReal.ofReal (Real.exp (-(1 : ℝ) / 2)) * μ (S ∩ closedBall (0 : V) t)
      ≤ ∫⁻ y in S, gaussianWeightAt t y ∂μ := by
  calc ENNReal.ofReal (Real.exp (-(1 : ℝ) / 2)) * μ (S ∩ closedBall (0 : V) t)
      = ∫⁻ _ in S ∩ closedBall (0 : V) t, ENNReal.ofReal (Real.exp (-(1 : ℝ) / 2)) ∂μ :=
        (MeasureTheory.setLIntegral_const _ _).symm
    _ ≤ ∫⁻ y in S ∩ closedBall (0 : V) t, gaussianWeightAt t y ∂μ := by
        refine MeasureTheory.setLIntegral_mono (measurable_gaussianWeightAt t) ?_
        intro y hy
        exact gaussianWeightAt_ge_on_closedBall ht hy.2
    _ ≤ ∫⁻ y in S, gaussianWeightAt t y ∂μ :=
        MeasureTheory.lintegral_mono_set Set.inter_subset_left

omit [BorelSpace V] in
/-- **The dyadic shell bound.**  The width-`t` Gaussian mass of a set is controlled by the Haar
masses of its intersections with the dyadic balls, with Gaussian shell weights. -/
theorem lintegral_gaussianWeightAt_le_tsum (μ : Measure V) {t : ℝ} (ht : 0 < t) (S : Set V) :
    ∫⁻ y in S, gaussianWeightAt t y ∂μ
      ≤ ∑' j : ℕ, ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
          μ (S ∩ closedBall (0 : V) (2 ^ (j + 1) * t)) := by
  have hcover : S = ⋃ j : ℕ, S ∩ dyadicShell (V := V) t j := by
    rw [← Set.inter_iUnion, iUnion_dyadicShell ht, Set.inter_univ]
  calc ∫⁻ y in S, gaussianWeightAt t y ∂μ
      = ∫⁻ y in ⋃ j : ℕ, S ∩ dyadicShell (V := V) t j, gaussianWeightAt t y ∂μ := by
        rw [← hcover]
    _ ≤ ∑' j : ℕ, ∫⁻ y in S ∩ dyadicShell (V := V) t j, gaussianWeightAt t y ∂μ :=
        MeasureTheory.lintegral_iUnion_le _ _
    _ ≤ ∑' j : ℕ, ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
          μ (S ∩ closedBall (0 : V) (2 ^ (j + 1) * t)) := by
        refine ENNReal.tsum_le_tsum fun j => ?_
        calc ∫⁻ y in S ∩ dyadicShell (V := V) t j, gaussianWeightAt t y ∂μ
            ≤ ∫⁻ _ in S ∩ dyadicShell (V := V) t j,
                ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) ∂μ := by
              refine MeasureTheory.setLIntegral_mono measurable_const ?_
              intro y hy
              exact gaussianWeightAt_le_on_dyadicShell ht j hy.2
          _ = ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
                μ (S ∩ dyadicShell (V := V) t j) := MeasureTheory.setLIntegral_const _ _
          _ ≤ ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
                μ (S ∩ closedBall (0 : V) (2 ^ (j + 1) * t)) :=
              mul_le_mul_right (measure_mono
                (Set.inter_subset_inter_right _ (dyadicShell_subset_closedBall t j))) _

end Mass

/-! ## The Gaussian dilation identity and the equivalence -/

section Haar

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
  [FiniteDimensional ℝ V]

/-- **The Gaussian dilation identity.**  Integrating the unit-width Gaussian weight over the
dilated preimage of a set is the width-`t` Gaussian mass of the set, scaled by `t⁻ᵐ`, where `m` is
the dimension of the coefficient space. -/
theorem lintegral_gaussianWeight_preimage_smul (μ : Measure V) [μ.IsAddHaarMeasure]
    {t : ℝ} (ht : 0 < t) {S : Set V} (hS : MeasurableSet S) :
    ∫⁻ x in (fun x : V => t • x) ⁻¹' S, gaussianWeightAt 1 x ∂μ
      = ENNReal.ofReal ((t ^ Module.finrank ℝ V)⁻¹) * ∫⁻ y in S, gaussianWeightAt t y ∂μ := by
  have hg : Measurable (fun x : V => t • x) := measurable_const_smul t
  have hmap := MeasureTheory.setLIntegral_map (μ := μ) (f := gaussianWeightAt (V := V) t)
    (g := fun x : V => t • x) hS (measurable_gaussianWeightAt t) hg
  have hsub : ∫⁻ x in (fun x : V => t • x) ⁻¹' S, gaussianWeightAt t (t • x) ∂μ
      = ∫⁻ x in (fun x : V => t • x) ⁻¹' S, gaussianWeightAt 1 x ∂μ := by
    refine MeasureTheory.setLIntegral_congr_fun (hg hS) ?_
    intro x _
    exact gaussianWeightAt_smul ht x
  rw [← hsub, ← hmap, Measure.map_addHaar_smul μ (ne_of_gt ht), Measure.restrict_smul,
    MeasureTheory.lintegral_smul_measure, smul_eq_mul,
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ (t ^ Module.finrank ℝ V)⁻¹)]

/-- **The shortcut volume bound.**  If the resolved shortcut event at time `t` has Gaussian mass at
most `P`, then the shortcut set meets the ball of radius `t` in Haar mass at most
`e^{1/2} tᵐ P`. -/
theorem measure_inter_closedBall_le_of_lintegral_le (μ : Measure V) [μ.IsAddHaarMeasure]
    {t : ℝ} (ht : 0 < t) {S : Set V} (hS : MeasurableSet S) {P : ℝ≥0∞}
    (hP : ∫⁻ x in (fun x : V => t • x) ⁻¹' S, gaussianWeightAt 1 x ∂μ ≤ P) :
    μ (S ∩ closedBall (0 : V) t)
      ≤ ENNReal.ofReal (Real.exp ((1 : ℝ) / 2)) *
          (ENNReal.ofReal (t ^ Module.finrank ℝ V) * P) := by
  have hmpos : (0 : ℝ) < t ^ Module.finrank ℝ V := by positivity
  have hid := lintegral_gaussianWeight_preimage_smul μ ht hS
  have hkey : ENNReal.ofReal ((t ^ Module.finrank ℝ V)⁻¹) *
      ∫⁻ y in S, gaussianWeightAt t y ∂μ ≤ P := by
    rw [← hid]
    exact hP
  have hmul : ∫⁻ y in S, gaussianWeightAt t y ∂μ
      ≤ ENNReal.ofReal (t ^ Module.finrank ℝ V) * P := by
    have h := mul_le_mul_right hkey (ENNReal.ofReal (t ^ Module.finrank ℝ V))
    rwa [← mul_assoc, ← ENNReal.ofReal_mul (le_of_lt hmpos), mul_inv_cancel₀ (ne_of_gt hmpos),
      ENNReal.ofReal_one, one_mul] at h
  have hball := measure_inter_closedBall_le_lintegral μ ht S
  have h2 := mul_le_mul_right (hball.trans hmul) (ENNReal.ofReal (Real.exp ((1 : ℝ) / 2)))
  rwa [← mul_assoc, ← ENNReal.ofReal_mul (Real.exp_nonneg _), ← Real.exp_add,
    (by ring : (1 : ℝ) / 2 + -(1 : ℝ) / 2 = 0), Real.exp_zero, ENNReal.ofReal_one, one_mul] at h2

/-- **The annular transfer.**  A ball-volume bound `Vol` valid at every positive radius transfers
to a bound on the Gaussian mass of the dilated event, with the same shape and a dyadically summed
Gaussian weight. -/
theorem lintegral_gaussianWeight_preimage_smul_le_tsum (μ : Measure V) [μ.IsAddHaarMeasure]
    {t : ℝ} (ht : 0 < t) {S : Set V} (hS : MeasurableSet S) (Vol : ℝ → ℝ≥0∞)
    (hVol : ∀ R : ℝ, 0 < R → μ (S ∩ closedBall (0 : V) R) ≤ Vol R) :
    ∫⁻ x in (fun x : V => t • x) ⁻¹' S, gaussianWeightAt 1 x ∂μ
      ≤ ENNReal.ofReal ((t ^ Module.finrank ℝ V)⁻¹) *
          ∑' j : ℕ, ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
            Vol (2 ^ (j + 1) * t) := by
  rw [lintegral_gaussianWeight_preimage_smul μ ht hS]
  refine mul_le_mul_right ?_ _
  refine (lintegral_gaussianWeightAt_le_tsum μ ht S).trans ?_
  refine ENNReal.tsum_le_tsum fun j => ?_
  exact mul_le_mul_right (hVol _ (by positivity)) _

variable {P : Type*} [TopologicalSpace P]

/-- **The quenched shortcut–annular equivalence.**  The Gaussian mass of the resolved shortcut
event at time `t` is `t⁻ᵐ` times the width-`t` Gaussian mass of the fixed unit-time shortcut set.
Homogeneity of the observable and radial invariance of the completed orbit are the only inputs. -/
theorem gaussianMass_resolvedShortcut_timeEvent (μ : Measure V) [μ.IsAddHaarMeasure]
    (f : V → P) (Ψ : Set P → ℝ) (E : Set P) (B : ℝ) {t : ℝ} (ht : 0 < t)
    (hS : MeasurableSet (resolvedShortcutSet f Ψ E B)) :
    ∫⁻ x in {x : V | f (t • x) ∈ E ∧ B ≤ Ψ (completedRayOrbit f x)}, gaussianWeightAt 1 x ∂μ
      = ENNReal.ofReal ((t ^ Module.finrank ℝ V)⁻¹) *
          ∫⁻ y in resolvedShortcutSet f Ψ E B, gaussianWeightAt t y ∂μ := by
  rw [timeEvent_eq_preimage_smul f Ψ E B (ne_of_gt ht)]
  exact lintegral_gaussianWeight_preimage_smul μ ht hS

/-- **The shortcut ball-volume bound.**  A bound on the resolved shortcut probability at time `t`
bounds the Haar volume of the shortcut set inside the ball of radius `t`. -/
theorem measure_resolvedShortcut_inter_closedBall_le (μ : Measure V) [μ.IsAddHaarMeasure]
    (f : V → P) (Ψ : Set P → ℝ) (E : Set P) (B : ℝ) {t : ℝ} (ht : 0 < t)
    (hS : MeasurableSet (resolvedShortcutSet f Ψ E B)) {Prob : ℝ≥0∞}
    (hP : ∫⁻ x in {x : V | f (t • x) ∈ E ∧ B ≤ Ψ (completedRayOrbit f x)},
        gaussianWeightAt 1 x ∂μ ≤ Prob) :
    μ (resolvedShortcutSet f Ψ E B ∩ closedBall (0 : V) t)
      ≤ ENNReal.ofReal (Real.exp ((1 : ℝ) / 2)) *
          (ENNReal.ofReal (t ^ Module.finrank ℝ V) * Prob) := by
  rw [timeEvent_eq_preimage_smul f Ψ E B (ne_of_gt ht)] at hP
  exact measure_inter_closedBall_le_of_lintegral_le μ ht hS hP

/-- **The shortcut annular transfer.**  An annular volume bound for the shortcut set transfers to a
bound on the resolved shortcut probability at every time, with the same exponent. -/
theorem gaussianMass_resolvedShortcut_le_tsum (μ : Measure V) [μ.IsAddHaarMeasure]
    (f : V → P) (Ψ : Set P → ℝ) (E : Set P) (B : ℝ) {t : ℝ} (ht : 0 < t)
    (hS : MeasurableSet (resolvedShortcutSet f Ψ E B)) (Vol : ℝ → ℝ≥0∞)
    (hVol : ∀ R : ℝ, 0 < R →
      μ (resolvedShortcutSet f Ψ E B ∩ closedBall (0 : V) R) ≤ Vol R) :
    ∫⁻ x in {x : V | f (t • x) ∈ E ∧ B ≤ Ψ (completedRayOrbit f x)}, gaussianWeightAt 1 x ∂μ
      ≤ ENNReal.ofReal ((t ^ Module.finrank ℝ V)⁻¹) *
          ∑' j : ℕ, ENNReal.ofReal (Real.exp ((1 : ℝ) / 2 - 4 ^ j / 2)) *
            Vol (2 ^ (j + 1) * t) := by
  rw [timeEvent_eq_preimage_smul f Ψ E B (ne_of_gt ht)]
  exact lintegral_gaussianWeight_preimage_smul_le_tsum μ ht hS Vol hVol

end Haar

end GaloisForLFunctions.HTGeometry
