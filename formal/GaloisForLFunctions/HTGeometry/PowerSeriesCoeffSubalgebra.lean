import Mathlib

/-!
# Power series with coefficients in a subalgebra, and closure under division

The power series whose coefficients all lie in a fixed subalgebra form a subalgebra, and that
subalgebra is closed under division whenever the divisor has a constant coefficient that is a unit
of the subalgebra.  This is the engine behind "the continuation block of a rational expansion stays
inside the algebra generated by the expansion parameter": every operation used to build the block —
sums, products, and inversion of a series with unit constant term — stays inside the coefficient
subalgebra.

* `coeffSubalgebra S` — the power series with all coefficients in `S`.
* `mem_coeffSubalgebra_of_mul_eq_one` — closure under division.
* `expScaled_mem_coeffSubalgebra` — the exponential series of a scaled variable has coefficients in
  the algebra generated by the scale.
-/

namespace GaloisForLFunctions.HTGeometry

open PowerSeries Finset

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- The power series all of whose coefficients lie in a given subalgebra. -/
def coeffSubalgebra (S : Subalgebra R A) : Subalgebra R (PowerSeries A) where
  carrier := {f | ∀ n, PowerSeries.coeff n f ∈ S}
  zero_mem' := by intro n; simp
  one_mem' := by
    intro n
    rw [PowerSeries.coeff_one]
    split
    · exact S.one_mem
    · exact S.zero_mem
  add_mem' := by
    intro f g hf hg n
    rw [map_add]
    exact S.add_mem (hf n) (hg n)
  mul_mem' := by
    intro f g hf hg n
    rw [PowerSeries.coeff_mul]
    exact Subalgebra.sum_mem _ fun p _ => S.mul_mem (hf p.1) (hg p.2)
  algebraMap_mem' := by
    intro r n
    rw [PowerSeries.algebraMap_apply, PowerSeries.coeff_C]
    split
    · exact S.algebraMap_mem r
    · exact S.zero_mem

theorem mem_coeffSubalgebra_iff {S : Subalgebra R A} {f : PowerSeries A} :
    f ∈ coeffSubalgebra S ↔ ∀ n, PowerSeries.coeff n f ∈ S := Iff.rfl

/-- **Closure under division.**  If `f * g = 1`, the coefficients of `f` lie in `S`, and the constant
coefficient of `f` has an inverse in `S`, then the coefficients of `g` lie in `S` as well.  The
inverse coefficients are produced by the usual recursion, which never leaves `S`. -/
theorem mem_coeffSubalgebra_of_mul_eq_one {S : Subalgebra R A} {f g : PowerSeries A}
    (hf : f ∈ coeffSubalgebra S) (hfg : f * g = 1)
    {v : A} (hv : v ∈ S) (hvf : v * PowerSeries.coeff 0 f = 1) :
    g ∈ coeffSubalgebra S := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · have h0 : PowerSeries.coeff 0 f * PowerSeries.coeff 0 g = 1 := by
          have hc := congrArg (PowerSeries.coeff 0) hfg
          simpa [PowerSeries.coeff_mul] using hc
        have hg0 : PowerSeries.coeff 0 g = v := by
          calc PowerSeries.coeff 0 g
              = v * (PowerSeries.coeff 0 f * PowerSeries.coeff 0 g) := by
                rw [← mul_assoc, hvf, one_mul]
            _ = v := by rw [h0, mul_one]
        rw [hg0]
        exact hv
      · have hc := congrArg (PowerSeries.coeff n) hfg
        rw [PowerSeries.coeff_mul, PowerSeries.coeff_one, if_neg hn.ne'] at hc
        have hmem : ((0, n) : ℕ × ℕ) ∈ antidiagonal n := by simp
        rw [← Finset.add_sum_erase _ _ hmem] at hc
        have hsplit : PowerSeries.coeff 0 f * PowerSeries.coeff n g
            = -∑ p ∈ (antidiagonal n).erase (0, n),
                PowerSeries.coeff p.1 f * PowerSeries.coeff p.2 g :=
          eq_neg_of_add_eq_zero_left hc
        have hterms : ∀ p ∈ (antidiagonal n).erase (0, n),
            PowerSeries.coeff p.1 f * PowerSeries.coeff p.2 g ∈ S := by
          intro p hp
          have hp' := Finset.mem_of_mem_erase hp
          have hne : p ≠ (0, n) := Finset.ne_of_mem_erase hp
          have hsum' : p.1 + p.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hp'
          have hlt : p.2 < n := by
            rcases Nat.eq_zero_or_pos p.1 with h1 | h1
            · exact absurd (Prod.ext h1 (by omega)) hne
            · omega
          exact S.mul_mem (hf p.1) (ih p.2 hlt)
        have hrhs : PowerSeries.coeff 0 f * PowerSeries.coeff n g ∈ S := by
          rw [hsplit]
          exact S.neg_mem (Subalgebra.sum_mem _ hterms)
        have hgn : PowerSeries.coeff n g
            = v * (PowerSeries.coeff 0 f * PowerSeries.coeff n g) := by
          rw [← mul_assoc, hvf, one_mul]
        rw [hgn]
        exact S.mul_mem hv hrhs

/-- The exponential series of a scaled variable: `∑ₖ (c ^ k / k !) Xᵏ`.  Its coefficients lie in the
algebra generated by the scale. -/
noncomputable def expScaled {B : Type*} [CommRing B] [Algebra ℚ B] (c : B) : PowerSeries B :=
  PowerSeries.mk fun k => (algebraMap ℚ B ((k.factorial : ℚ)⁻¹)) * c ^ k

theorem expScaled_mem_coeffSubalgebra {B : Type*} [CommRing B] [Algebra ℚ B] (c : B) :
    expScaled c ∈ coeffSubalgebra (Algebra.adjoin ℚ ({c} : Set B)) := by
  intro k
  rw [expScaled, PowerSeries.coeff_mk]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
    (Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton ℚ c) k)

end GaloisForLFunctions.HTGeometry
