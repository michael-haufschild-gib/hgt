import GaloisForLFunctions.HTGeometry.SchwarzianFamilyCoordinates
import GaloisForLFunctions.HTGeometry.FreeJetTranslationFixedField

/-!
# The Schwarzian projective erosion tower

Iterating the Schwarzian on a free differential family produces a strictly descending tower of
differential subfields.  Each level is again a free differential family, and an element of level
`n` that is not a scalar uses a jet of order at least `3n`.  Consequently the intersection of the
tower is the base field.

The engine is the Schwarzian substitution `Φ`, the algebra endomorphism sending the `m`-th jet of a
generator to the `m`-th jet of that generator's Schwarzian.  It is the Schwarzian coordinate change
composed with the three-jet index shift, so it raises coordinate order by exactly three.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {C ι : Type*} [Field C] [CharZero C]

/-! ## Coordinate subfields -/

/-- The subfield generated by every jet of order below `k`. -/
def lowJetField (C ι : Type*) [Field C] (k : ℕ) :
    IntermediateField C (FreeFamilyJetField C ι) :=
  freeCoordinateField C (ι × ℕ) {p | p.2 < k}

omit [CharZero C] in
theorem lowJetField_zero : lowJetField C ι 0 = ⊥ := by
  have : {p : ι × ℕ | p.2 < 0} = (∅ : Set (ι × ℕ)) := by
    ext p; simp
  rw [lowJetField, this, freeCoordinateField_empty]

omit [CharZero C] in
theorem lowJetField_mono {k l : ℕ} (h : k ≤ l) : lowJetField C ι k ≤ lowJetField C ι l := by
  rw [lowJetField, lowJetField, freeCoordinateField, freeCoordinateField,
    IntermediateField.adjoin_le_iff]
  rintro _ ⟨p, hp, rfl⟩
  have hp' : p.2 < k := hp
  exact IntermediateField.subset_adjoin _ _ ⟨p, by simp only [Set.mem_setOf_eq]; omega, rfl⟩

/-- Coordinate subfields meet in the subfield of the common coordinates. -/
theorem freeCoordinateField_inf (S T : Set (ι × ℕ)) :
    freeCoordinateField C (ι × ℕ) S ⊓ freeCoordinateField C (ι × ℕ) T =
      freeCoordinateField C (ι × ℕ) (S ∩ T) := by
  refine le_antisymm ?_ ?_
  · intro f hf
    rw [mem_freeCoordinateField_iff]
    intro i hi
    by_cases hiS : i ∈ S
    · exact (mem_freeCoordinateField_iff T f).1 hf.2 i (fun hiT => hi ⟨hiS, hiT⟩)
    · exact (mem_freeCoordinateField_iff S f).1 hf.1 i hiS
  · refine le_inf ?_ ?_
    · rw [freeCoordinateField, freeCoordinateField, IntermediateField.adjoin_le_iff]
      rintro _ ⟨p, hp, rfl⟩
      exact IntermediateField.subset_adjoin _ _ ⟨p, hp.1, rfl⟩
    · rw [freeCoordinateField, freeCoordinateField, IntermediateField.adjoin_le_iff]
      rintro _ ⟨p, hp, rfl⟩
      exact IntermediateField.subset_adjoin _ _ ⟨p, hp.2, rfl⟩

omit [CharZero C] in
/-- A general form of derivation stability: an adjoined set whose members and derivatives lie in a
field `L` generates a subfield of `L` stable under the derivation. -/
theorem adjoin_le_derivationStable_of_mem {E : Type*} [Field E] [Algebra C E]
    {S : Set E} {L : IntermediateField C E} {D : Derivation C E E}
    (h : ∀ x ∈ S, x ∈ L ∧ D x ∈ L) :
    IntermediateField.adjoin C S ≤ derivationStable L D := by
  rw [IntermediateField.adjoin_le_iff]
  exact fun x hx => h x hx

/-! ## The graded solve-for-the-top-jet recursion -/

/-- The level-`j` graded Schwarzian generators of one packet. -/
def gradedSchwarzianGenerators (C : Type*) {ι : Type*} [Field C] (a : ι) (j : ℕ) :
    Set (FreeFamilyJetField C ι) :=
  (fun i : ℕ => familyJet C a i) '' {i | i ≤ 2} ∪
    (fun i : ℕ => differentialJet i (familySchwarzian C a)) '' {i | i ≤ j}

omit [CharZero C] in
theorem gradedSchwarzianGenerators_mono {a : ι} {j : ℕ} :
    gradedSchwarzianGenerators C a j ⊆ gradedSchwarzianGenerators C a (j + 1) := by
  rintro x (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
  · exact Or.inl ⟨i, hi, rfl⟩
  · have hi' : i ≤ j := hi
    exact Or.inr ⟨i, by simp only [Set.mem_setOf_eq]; omega, rfl⟩

/-- **Graded solve-for-the-top-jet.**  The jet of order `j + 3` of a generator lies in the field
generated by its first three jets and the first `j + 1` jets of its Schwarzian. -/
theorem familyJet_mem_gradedSchwarzianGenerators (a : ι) :
    ∀ j : ℕ, familyJet C a (j + 3) ∈
      IntermediateField.adjoin C (gradedSchwarzianGenerators C a j) := by
  have hbase : ∀ j : ℕ, ∀ i ≤ 2, familyJet C a i ∈
      IntermediateField.adjoin C (gradedSchwarzianGenerators C a j) := by
    intro j i hi
    exact IntermediateField.subset_adjoin _ _ (Or.inl ⟨i, hi, rfl⟩)
  have hschw : ∀ j : ℕ, ∀ i ≤ j, differentialJet i (familySchwarzian C a) ∈
      IntermediateField.adjoin C (gradedSchwarzianGenerators C a j) := by
    intro j i hi
    exact IntermediateField.subset_adjoin _ _ (Or.inr ⟨i, hi, rfl⟩)
  intro j
  induction j with
  | zero =>
      rw [familyJet_three_eq]
      refine add_mem (mul_mem (hbase 0 1 (by omega)) ?_) ?_
      · simpa using hschw 0 0 (by omega)
      · exact div_mem (mul_mem (div_mem (by simp) (by simp))
          (pow_mem (hbase 0 2 (by omega)) 2)) (hbase 0 1 (by omega))
  | succ j ih =>
      have hstable : IntermediateField.adjoin C (gradedSchwarzianGenerators C a j) ≤
          derivationStable (IntermediateField.adjoin C (gradedSchwarzianGenerators C a (j + 1)))
            (freeFamilyJetShift C ι) := by
        refine adjoin_le_derivationStable_of_mem ?_
        rintro x (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
        · have hi' : i ≤ 2 := hi
          refine ⟨hbase (j + 1) i hi, ?_⟩
          rw [freeFamilyJetShift_familyJet]
          rcases Nat.lt_or_ge i 2 with h | h
          · exact hbase (j + 1) (i + 1) (by omega)
          · have hi2 : i = 2 := by omega
            subst hi2
            have h3 : familyJet C a 3 ∈
                IntermediateField.adjoin C (gradedSchwarzianGenerators C a (j + 1)) := by
              rw [familyJet_three_eq]
              refine add_mem (mul_mem (hbase (j + 1) 1 (by omega)) ?_) ?_
              · simpa using hschw (j + 1) 0 (by omega)
              · exact div_mem (mul_mem (div_mem (by simp) (by simp))
                  (pow_mem (hbase (j + 1) 2 (by omega)) 2)) (hbase (j + 1) 1 (by omega))
            exact h3
        · have hi' : i ≤ j := hi
          refine ⟨hschw (j + 1) i (by omega), ?_⟩
          rw [show freeFamilyJetShift C ι (differentialJet i (familySchwarzian C a))
              = differentialJet (i + 1) (familySchwarzian C a) from by
            rw [differentialJet_succ, freeFamilyJetField_deriv_apply]]
          exact hschw (j + 1) (i + 1) (by omega)
      have hj := hstable ih
      have hshift : freeFamilyJetShift C ι (familyJet C a (j + 3)) = familyJet C a (j + 4) :=
        freeFamilyJetShift_familyJet a (j + 3)
      have hmem := hj.2
      rw [hshift] at hmem
      exact (show j + 1 + 3 = j + 4 from by omega) ▸ hmem

/-! ## The three-jet index shift and the Schwarzian substitution -/

theorem algebraicIndependent_shiftedFreeCoordinate (C ι : Type*) [Field C] [CharZero C] :
    AlgebraicIndependent C
      (fun p : ι × ℕ => freeCoordinate C (ι × ℕ) (p.1, p.2 + 3)) := by
  have hinj : Function.Injective (fun p : ι × ℕ => ((p.1, p.2 + 3) : ι × ℕ)) := by
    intro p q h
    simp only [Prod.mk.injEq] at h
    exact Prod.ext h.1 (by omega)
  exact (algebraicIndependent_freeCoordinate C (ι × ℕ)).comp _ hinj

/-- The index shift raising every jet order by three. -/
def jetShiftThree (C ι : Type*) [Field C] [CharZero C] :
    FreeFamilyJetField C ι →ₐ[C] FreeFamilyJetField C ι :=
  freeCoordinateBasisEval (algebraicIndependent_shiftedFreeCoordinate C ι)

@[simp]
theorem jetShiftThree_freeCoordinate (p : ι × ℕ) :
    jetShiftThree C ι (freeCoordinate C (ι × ℕ) p) =
      freeCoordinate C (ι × ℕ) (p.1, p.2 + 3) :=
  freeCoordinateBasisEval_freeCoordinate _ p

theorem jetShiftThree_injective : Function.Injective (jetShiftThree C ι) :=
  freeCoordinateBasisEval_injective _

/-- **The Schwarzian substitution.**  It sends the `m`-th jet of a generator to the `m`-th jet of
that generator's Schwarzian. -/
def schwarzianSubstitution (C ι : Type*) [Field C] [CharZero C] :
    FreeFamilyJetField C ι →ₐ[C] FreeFamilyJetField C ι :=
  ((familySchwarzianBasisEquiv C ι).toAlgHom).comp (jetShiftThree C ι)

@[simp]
theorem schwarzianSubstitution_familyJet (a : ι) (m : ℕ) :
    schwarzianSubstitution C ι (familyJet C a m) =
      differentialJet m (familySchwarzian C a) := by
  rw [schwarzianSubstitution, AlgHom.comp_apply, familyJet, jetShiftThree_freeCoordinate]
  change familySchwarzianBasisEquiv C ι (freeCoordinate C (ι × ℕ) (a, m + 3)) = _
  rw [familySchwarzianBasisEquiv_freeCoordinate,
    familySchwarzianSystem_of_ge (by simp)]
  simp

theorem schwarzianSubstitution_injective :
    Function.Injective (schwarzianSubstitution C ι) := by
  rw [schwarzianSubstitution]
  exact (familySchwarzianBasisEquiv C ι).injective.comp jetShiftThree_injective

/-! ## Intertwining -/

/-- The locus where an algebra endomorphism intertwines two derivations. -/
def derivationIntertwiner {E E' : Type*} [Field E] [Field E'] [Algebra C E] [Algebra C E']
    (T : E →ₐ[C] E') (D₁ : Derivation C E E) (D₂ : Derivation C E' E') :
    IntermediateField C E where
  carrier := {f | D₂ (T f) = T (D₁ f)}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_add, map_add, map_add, hx, hy, map_add]
  mul_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_mul, Derivation.leibniz, Derivation.leibniz, hx, hy, map_add,
      smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul, map_mul, map_mul]
  algebraMap_mem' := by
    intro c
    simp only [Set.mem_setOf_eq]
    rw [AlgHom.commutes, Derivation.map_algebraMap, Derivation.map_algebraMap, map_zero]
  inv_mem' := by
    intro x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [map_inv₀, Derivation.leibniz_inv, Derivation.leibniz_inv, hx, smul_eq_mul, smul_eq_mul,
      map_mul, map_neg, map_pow, map_inv₀]

omit [CharZero C] in
theorem mem_derivationIntertwiner_iff {E E' : Type*} [Field E] [Field E'] [Algebra C E]
    [Algebra C E'] {T : E →ₐ[C] E'} {D₁ : Derivation C E E} {D₂ : Derivation C E' E'} {f : E} :
    f ∈ derivationIntertwiner T D₁ D₂ ↔ D₂ (T f) = T (D₁ f) := Iff.rfl

/-- An intertwining checked on the coordinates holds everywhere. -/
theorem derivationIntertwiner_eq_top {E' : Type*} [Field E'] [Algebra C E']
    {T : FreeFamilyJetField C ι →ₐ[C] E'}
    {D₁ : Derivation C (FreeFamilyJetField C ι) (FreeFamilyJetField C ι)}
    {D₂ : Derivation C E' E'}
    (h : ∀ p : ι × ℕ, D₂ (T (freeCoordinate C (ι × ℕ) p)) = T (D₁ (freeCoordinate C (ι × ℕ) p))) :
    derivationIntertwiner T D₁ D₂ = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← freeCoordinateField_univ (C := C) (σ := ι × ℕ), freeCoordinateField,
    IntermediateField.adjoin_le_iff]
  rintro _ ⟨p, -, rfl⟩
  exact h p

/-- **The Schwarzian substitution is a differential homomorphism.** -/
theorem schwarzianSubstitution_deriv (f : FreeFamilyJetField C ι) :
    (schwarzianSubstitution C ι f)′ = schwarzianSubstitution C ι (f′) := by
  have htop : derivationIntertwiner (schwarzianSubstitution C ι)
      (freeFamilyJetShift C ι) (freeFamilyJetShift C ι) = ⊤ := by
    refine derivationIntertwiner_eq_top ?_
    rintro ⟨a, m⟩
    show freeFamilyJetShift C ι (schwarzianSubstitution C ι (familyJet C a m))
      = schwarzianSubstitution C ι (freeFamilyJetShift C ι (familyJet C a m))
    rw [freeFamilyJetShift_familyJet, schwarzianSubstitution_familyJet,
      schwarzianSubstitution_familyJet, ← freeFamilyJetField_deriv_apply, ← differentialJet_succ]
  have hf : f ∈ derivationIntertwiner (schwarzianSubstitution C ι)
      (freeFamilyJetShift C ι) (freeFamilyJetShift C ι) := by
    rw [htop]; trivial
  exact hf

/-- **The three-jet shift lowers coordinate derivations by three.** -/
theorem freeCoordinateDerivation_jetShiftThree (a : ι) (m : ℕ)
    (f : FreeFamilyJetField C ι) :
    freeCoordinateDerivation C (ι × ℕ) (a, m + 3) (jetShiftThree C ι f) =
      jetShiftThree C ι (freeCoordinateDerivation C (ι × ℕ) (a, m) f) := by
  have htop : derivationIntertwiner (jetShiftThree C ι)
      (freeCoordinateDerivation C (ι × ℕ) (a, m))
      (freeCoordinateDerivation C (ι × ℕ) (a, m + 3)) = ⊤ := by
    refine derivationIntertwiner_eq_top ?_
    intro p
    rw [jetShiftThree_freeCoordinate]
    by_cases hp : p = (a, m)
    · subst hp
      rw [freeCoordinateDerivation_freeCoordinate_self,
        freeCoordinateDerivation_freeCoordinate_self, map_one]
    · have hne : ((p.1, p.2 + 3) : ι × ℕ) ≠ (a, m + 3) := by
        intro hcon
        apply hp
        rw [Prod.mk.injEq] at hcon
        exact Prod.ext hcon.1 (by omega)
      rw [freeCoordinateDerivation_freeCoordinate_of_ne hne,
        freeCoordinateDerivation_freeCoordinate_of_ne hp, map_zero]
  have hf : f ∈ derivationIntertwiner (jetShiftThree C ι)
      (freeCoordinateDerivation C (ι × ℕ) (a, m))
      (freeCoordinateDerivation C (ι × ℕ) (a, m + 3)) := by
    rw [htop]; trivial
  exact hf

/-- The three-jet shift reflects membership in the low-order coordinate field. -/
theorem mem_lowJetField_of_jetShiftThree {k : ℕ} {g : FreeFamilyJetField C ι}
    (hg : jetShiftThree C ι g ∈ lowJetField C ι (k + 3)) :
    g ∈ lowJetField C ι k := by
  rw [lowJetField, mem_freeCoordinateField_iff]
  rintro ⟨a, m⟩ hm
  have hm' : ¬ m < k := hm
  have hshift : freeCoordinateDerivation C (ι × ℕ) (a, m + 3) (jetShiftThree C ι g) = 0 := by
    refine (mem_freeCoordinateField_iff _ _).1 hg (a, m + 3) ?_
    simp only [Set.mem_setOf_eq]
    omega
  rw [freeCoordinateDerivation_jetShiftThree] at hshift
  have := jetShiftThree_injective (C := C) (ι := ι)
  have hz : jetShiftThree C ι (freeCoordinateDerivation C (ι × ℕ) (a, m) g) =
      jetShiftThree C ι 0 := by rw [hshift, map_zero]
  exact this hz

/-! ## The coordinate change preserves the low-order fields -/

omit [CharZero C] in
theorem freeCoordinateField_mono {S T : Set (ι × ℕ)} (h : S ⊆ T) :
    freeCoordinateField C (ι × ℕ) S ≤ freeCoordinateField C (ι × ℕ) T := by
  rw [freeCoordinateField, freeCoordinateField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨p, hp, rfl⟩
  exact IntermediateField.subset_adjoin _ _ ⟨p, h hp, rfl⟩

omit [CharZero C] in
theorem familySchwarzianSystem_mem_lowJetField {p : ι × ℕ} {k : ℕ} (hp : p.2 < k) :
    familySchwarzianSystem C p ∈ lowJetField C ι k := by
  by_cases h3 : p.2 < 3
  · rw [familySchwarzianSystem_of_lt h3, lowJetField, familyJet]
    exact IntermediateField.subset_adjoin _ _ ⟨p, hp, rfl⟩
  · rw [familySchwarzianSystem_of_ge (by omega)]
    refine freeCoordinateField_mono (S := schwarzianSupport p.1 (p.2 - 3)) ?_
      (differentialJet_familySchwarzian_mem p.1 (p.2 - 3))
    rintro q ⟨-, -, h⟩
    simp only [Set.mem_setOf_eq]
    omega

theorem familyJet_mem_adjoin_familySchwarzianSystem {a : ι} {m k : ℕ} (hm : m < k + 3) :
    familyJet C a m ∈ IntermediateField.adjoin C
      (familySchwarzianSystem C '' {p : ι × ℕ | p.2 < k + 3}) := by
  rcases Nat.lt_or_ge m 3 with h3 | h3
  · refine IntermediateField.subset_adjoin _ _ ⟨(a, m), hm, ?_⟩
    exact familySchwarzianSystem_of_lt (by exact h3)
  · obtain ⟨j, rfl⟩ : ∃ j, m = j + 3 := ⟨m - 3, by omega⟩
    have hgen : gradedSchwarzianGenerators C a j ⊆
        (IntermediateField.adjoin C
          (familySchwarzianSystem C '' {p : ι × ℕ | p.2 < k + 3}) :
          Set (FreeFamilyJetField C ι)) := by
      rintro x (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
      · have hi' : i ≤ 2 := hi
        refine IntermediateField.subset_adjoin _ _ ⟨(a, i), by
          simp only [Set.mem_setOf_eq]; omega, ?_⟩
        exact familySchwarzianSystem_of_lt (by simp only []; omega)
      · have hi' : i ≤ j := hi
        refine IntermediateField.subset_adjoin _ _ ⟨(a, i + 3), by
          simp only [Set.mem_setOf_eq]; omega, ?_⟩
        rw [familySchwarzianSystem_of_ge (by simp)]
        simp
    have := familyJet_mem_gradedSchwarzianGenerators (C := C) a j
    exact (IntermediateField.adjoin_le_iff.2 hgen) this

theorem map_familySchwarzianBasisEquiv_lowJetField (k : ℕ) :
    (lowJetField C ι (k + 3)).map (familySchwarzianBasisEquiv C ι).toAlgHom
      = lowJetField C ι (k + 3) := by
  have hmap : (lowJetField C ι (k + 3)).map (familySchwarzianBasisEquiv C ι).toAlgHom
      = IntermediateField.adjoin C
        (familySchwarzianSystem C '' {p : ι × ℕ | p.2 < k + 3}) := by
    rw [lowJetField, freeCoordinateField, IntermediateField.adjoin_map]
    congr 1
    rw [Set.image_image]
    exact Set.image_congr' (fun p => familySchwarzianBasisEquiv_freeCoordinate p)
  rw [hmap]
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨p, hp, rfl⟩
    exact familySchwarzianSystem_mem_lowJetField hp
  · rw [lowJetField, freeCoordinateField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨p, hp, rfl⟩
    have := familyJet_mem_adjoin_familySchwarzianSystem (C := C) (a := p.1) (m := p.2) (k := k) hp
    exact this

/-- **The Schwarzian substitution raises coordinate order by exactly three.** -/
theorem mem_lowJetField_of_schwarzianSubstitution {k : ℕ} {g : FreeFamilyJetField C ι}
    (hg : schwarzianSubstitution C ι g ∈ lowJetField C ι (k + 3)) :
    g ∈ lowJetField C ι k := by
  rw [← map_familySchwarzianBasisEquiv_lowJetField k] at hg
  obtain ⟨y, hy, hxy⟩ := hg
  have hy' : y ∈ lowJetField C ι (k + 3) := hy
  have hEq : y = jetShiftThree C ι g := by
    apply (familySchwarzianBasisEquiv C ι).injective
    show familySchwarzianBasisEquiv C ι y
      = familySchwarzianBasisEquiv C ι (jetShiftThree C ι g)
    rw [show (familySchwarzianBasisEquiv C ι) (jetShiftThree C ι g)
        = schwarzianSubstitution C ι g from rfl]
    exact hxy
  rw [hEq] at hy'
  exact mem_lowJetField_of_jetShiftThree hy'

/-- The Schwarzian substitution sends the low-order fields into the shifted ones. -/
theorem map_schwarzianSubstitution_lowJetField_le (k : ℕ) :
    (lowJetField C ι k).map (schwarzianSubstitution C ι) ≤ lowJetField C ι (k + 3) := by
  rw [lowJetField, freeCoordinateField, IntermediateField.adjoin_map,
    IntermediateField.adjoin_le_iff]
  rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
  have hp' : p.2 < k := hp
  have hsub : schwarzianSubstitution C ι (freeCoordinate C (ι × ℕ) p)
      = differentialJet p.2 (familySchwarzian C p.1) := by
    exact schwarzianSubstitution_familyJet p.1 p.2
  rw [hsub, lowJetField]
  refine freeCoordinateField_mono (S := schwarzianSupport p.1 p.2) ?_
    (differentialJet_familySchwarzian_mem p.1 p.2)
  rintro q ⟨-, -, h⟩
  simp only [Set.mem_setOf_eq]
  omega

/-! ## The erosion tower -/

/-- The `n`-fold Schwarzian substitution. -/
def schwarzianIter (C ι : Type*) [Field C] [CharZero C] :
    ℕ → (FreeFamilyJetField C ι →ₐ[C] FreeFamilyJetField C ι)
  | 0 => AlgHom.id C _
  | n + 1 => (schwarzianIter C ι n).comp (schwarzianSubstitution C ι)

theorem schwarzianIter_succ_apply (n : ℕ) (f : FreeFamilyJetField C ι) :
    schwarzianIter C ι (n + 1) f = schwarzianIter C ι n (schwarzianSubstitution C ι f) := rfl

theorem schwarzianIter_injective (n : ℕ) :
    Function.Injective (schwarzianIter C ι n) := by
  induction n with
  | zero => exact fun x y h => h
  | succ n ih => exact ih.comp schwarzianSubstitution_injective

theorem schwarzianIter_deriv (n : ℕ) (f : FreeFamilyJetField C ι) :
    (schwarzianIter C ι n f)′ = schwarzianIter C ι n (f′) := by
  induction n generalizing f with
  | zero => rfl
  | succ n ih =>
      rw [schwarzianIter_succ_apply, schwarzianIter_succ_apply, ih,
        schwarzianSubstitution_deriv]

theorem schwarzianIter_differentialJet (n m : ℕ) (f : FreeFamilyJetField C ι) :
    differentialJet m (schwarzianIter C ι n f) = schwarzianIter C ι n (differentialJet m f) := by
  induction m with
  | zero => simp
  | succ m ih => rw [differentialJet_succ, ih, schwarzianIter_deriv, ← differentialJet_succ]

/-- The `n`-th level of the Schwarzian erosion tower. -/
def erosionLevel (C ι : Type*) [Field C] [CharZero C] (n : ℕ) :
    IntermediateField C (FreeFamilyJetField C ι) := (schwarzianIter C ι n).fieldRange

/-- The `n`-th Schwarzian iterate of a generator. -/
def erosionGenerator (C : Type*) {ι : Type*} [Field C] [CharZero C] (a : ι) (n : ℕ) :
    FreeFamilyJetField C ι := schwarzianIter C ι n (familyJet C a 0)

theorem erosionGenerator_mem (a : ι) (n : ℕ) :
    erosionGenerator C a n ∈ erosionLevel C ι n := ⟨_, rfl⟩

/-- **The tower descends.** -/
theorem erosionLevel_antitone (n : ℕ) : erosionLevel C ι (n + 1) ≤ erosionLevel C ι n := by
  rintro _ ⟨g, rfl⟩
  exact ⟨schwarzianSubstitution C ι g, rfl⟩

/-- **The depth law.**  A level-`n` element lying in the field of jets of order below `3n + k`
comes from an element of the field of jets of order below `k`. -/
theorem mem_lowJetField_of_schwarzianIter :
    ∀ (n k : ℕ) {g : FreeFamilyJetField C ι},
      schwarzianIter C ι n g ∈ lowJetField C ι (3 * n + k) → g ∈ lowJetField C ι k := by
  intro n
  induction n with
  | zero =>
      intro k g hg
      have hk : (3 : ℕ) * 0 + k = k := by omega
      rw [hk] at hg
      exact hg
  | succ n ih =>
      intro k g hg
      rw [schwarzianIter_succ_apply] at hg
      have hstep : schwarzianIter C ι n (schwarzianSubstitution C ι g) ∈
          lowJetField C ι (3 * n + (k + 3)) := by
        have : 3 * n + (k + 3) = 3 * (n + 1) + k := by omega
        rw [this]
        exact hg
      exact mem_lowJetField_of_schwarzianSubstitution (ih (k + 3) hstep)

/-- **A nonscalar level-`n` element has depth at least `3n`.** -/
theorem erosionLevel_inf_lowJetField (n : ℕ) :
    erosionLevel C ι n ⊓ lowJetField C ι (3 * n) = ⊥ := by
  refine le_antisymm ?_ bot_le
  rintro x ⟨⟨g, rfl⟩, hlow⟩
  have hg : g ∈ lowJetField C ι 0 := by
    refine mem_lowJetField_of_schwarzianIter n 0 ?_
    simpa using hlow
  rw [lowJetField_zero, IntermediateField.mem_bot] at hg
  obtain ⟨c, rfl⟩ := hg
  rw [IntermediateField.mem_bot]
  refine ⟨c, ?_⟩
  simp [AlgHom.commutes]

/-- **The depth law, stated on elements.** -/
theorem notMem_lowJetField_of_mem_erosionLevel {n : ℕ} {R : FreeFamilyJetField C ι}
    (hR : R ∈ erosionLevel C ι n) (hbase : R ∉ (⊥ : IntermediateField C (FreeFamilyJetField C ι))) :
    R ∉ lowJetField C ι (3 * n) := by
  intro hlow
  exact hbase (by
    rw [← erosionLevel_inf_lowJetField (C := C) (ι := ι) n]
    exact ⟨hR, hlow⟩)

/-! ## Strict descent -/

theorem familyJet_notMem_bot (a : ι) (m : ℕ) :
    familyJet C a m ∉ (⊥ : IntermediateField C (FreeFamilyJetField C ι)) := by
  intro hmem
  rw [IntermediateField.mem_bot] at hmem
  obtain ⟨c, hc⟩ := hmem
  have h1 : freeCoordinateDerivation C (ι × ℕ) (a, m) (familyJet C a m) = 1 :=
    freeCoordinateDerivation_freeCoordinate_self (a, m)
  rw [← hc, Derivation.map_algebraMap] at h1
  exact one_ne_zero h1.symm

theorem erosionGenerator_notMem_bot (a : ι) (n : ℕ) :
    erosionGenerator C a n ∉ (⊥ : IntermediateField C (FreeFamilyJetField C ι)) := by
  intro hmem
  rw [IntermediateField.mem_bot] at hmem
  obtain ⟨c, hc⟩ := hmem
  refine familyJet_notMem_bot (C := C) a 0 ?_
  rw [IntermediateField.mem_bot]
  refine ⟨c, ?_⟩
  refine schwarzianIter_injective n ?_
  rw [(schwarzianIter C ι n).commutes c]
  exact hc

theorem map_schwarzianIter_lowJetField_le :
    ∀ (n k : ℕ), (lowJetField C ι k).map (schwarzianIter C ι n) ≤ lowJetField C ι (3 * n + k) := by
  intro n
  induction n with
  | zero =>
      intro k
      rintro _ ⟨x, hx, rfl⟩
      have hk : (3 : ℕ) * 0 + k = k := by omega
      rw [hk]
      exact hx
  | succ n ih =>
      intro k
      rintro _ ⟨x, hx, rfl⟩
      have h1 : schwarzianSubstitution C ι x ∈ lowJetField C ι (k + 3) :=
        map_schwarzianSubstitution_lowJetField_le k
          ((IntermediateField.mem_map _).2 ⟨x, hx, rfl⟩)
      have h2 := ih (k + 3) ((IntermediateField.mem_map _).2
        ⟨schwarzianSubstitution C ι x, h1, rfl⟩)
      have heq : 3 * n + (k + 3) = 3 * (n + 1) + k := by omega
      rw [heq] at h2
      exact h2

theorem erosionGenerator_mem_lowJetField (a : ι) (n : ℕ) :
    erosionGenerator C a n ∈ lowJetField C ι (3 * n + 1) := by
  refine map_schwarzianIter_lowJetField_le n 1 ((IntermediateField.mem_map _).2
    ⟨familyJet C a 0, ?_, rfl⟩)
  exact IntermediateField.subset_adjoin _ _ ⟨(a, 0), by simp, rfl⟩

/-- **Strict descent.**  The `n`-th Schwarzian iterate of a generator lies in level `n` but not in
level `n + 1`. -/
theorem erosionGenerator_notMem_succ (a : ι) (n : ℕ) :
    erosionGenerator C a n ∉ erosionLevel C ι (n + 1) := by
  intro hmem
  refine erosionGenerator_notMem_bot (C := C) a n ?_
  rw [← erosionLevel_inf_lowJetField (C := C) (ι := ι) (n + 1)]
  refine ⟨hmem, ?_⟩
  refine lowJetField_mono (C := C) (ι := ι) (k := 3 * n + 1) (by omega) ?_
  exact erosionGenerator_mem_lowJetField a n

theorem erosionLevel_lt_of_nonempty [Nonempty ι] (n : ℕ) :
    erosionLevel C ι (n + 1) < erosionLevel C ι n := by
  refine lt_of_le_of_ne (erosionLevel_antitone n) ?_
  intro hcon
  obtain ⟨a⟩ := ‹Nonempty ι›
  exact erosionGenerator_notMem_succ (C := C) a n (hcon ▸ erosionGenerator_mem a n)

/-! ## Trivial intersection -/

/-- **The tower intersects in the base field.** -/
theorem iInf_erosionLevel : (⨅ n : ℕ, erosionLevel C ι n) = ⊥ := by
  refine le_antisymm ?_ (le_iInf fun n => bot_le)
  intro R hR
  obtain ⟨S, hS⟩ := exists_finset_mem_freeCoordinateField (C := C) (σ := ι × ℕ) R
  set N := S.sup (fun p : ι × ℕ => p.2) + 1 with hN
  have hlow : R ∈ lowJetField C ι N := by
    refine freeCoordinateField_mono (S := (S : Set (ι × ℕ))) ?_ hS
    intro p hp
    have := Finset.le_sup (f := fun q : ι × ℕ => q.2) hp
    simp only [Set.mem_setOf_eq]
    omega
  have hR' : R ∈ erosionLevel C ι N := by
    have := (iInf_le (fun n : ℕ => erosionLevel C ι n) N)
    exact this hR
  have hcap : R ∈ erosionLevel C ι N ⊓ lowJetField C ι (3 * N) :=
    ⟨hR', lowJetField_mono (by omega) hlow⟩
  rw [erosionLevel_inf_lowJetField] at hcap
  exact hcap

/-! ## Level independence -/

/-- **Every level of the tower is a free differential family.** -/
theorem differentialIndependent_erosionGenerator (n : ℕ) :
    DifferentialIndependent C (fun a : ι => erosionGenerator C a n) := by
  have hfam : (fun p : ι × ℕ => differentialJet p.2 (erosionGenerator C p.1 n))
      = fun p : ι × ℕ => schwarzianIter C ι n (freeCoordinate C (ι × ℕ) p) := by
    funext p
    rw [erosionGenerator, schwarzianIter_differentialJet, differentialJet_familyJet_zero]
    rfl
  rw [DifferentialIndependent, hfam]
  exact (algebraicIndependent_freeCoordinate C (ι × ℕ)).map'
    (f := schwarzianIter C ι n) (schwarzianIter_injective n)

/-! ## Exact order addition and index relabelling -/

/-- **The exact depth law.**  A level-`n` element has original jet order exactly `3n` more than its
order in the level-`n` variables. -/
theorem schwarzianIter_mem_lowJetField_iff (n k : ℕ) (g : FreeFamilyJetField C ι) :
    schwarzianIter C ι n g ∈ lowJetField C ι (3 * n + k) ↔ g ∈ lowJetField C ι k := by
  constructor
  · exact mem_lowJetField_of_schwarzianIter n k
  · intro hg
    exact map_schwarzianIter_lowJetField_le n k ((IntermediateField.mem_map _).2 ⟨g, hg, rfl⟩)

omit [CharZero C] in
theorem algebraicIndependent_relabelFreeCoordinate {κ : Type*} (e : ι ≃ κ) :
    AlgebraicIndependent C
      (fun p : ι × ℕ => freeCoordinate C (κ × ℕ) (e p.1, p.2)) := by
  have hinj : Function.Injective (fun p : ι × ℕ => ((e p.1, p.2) : κ × ℕ)) := by
    intro p q h
    simp only [Prod.mk.injEq, EmbeddingLike.apply_eq_iff_eq] at h
    exact Prod.ext h.1 h.2
  exact (algebraicIndependent_freeCoordinate C (κ × ℕ)).comp _ hinj

theorem relabelFreeCoordinate_adjoin_eq_top {κ : Type*} (e : ι ≃ κ) :
    IntermediateField.adjoin C
      (Set.range (fun p : ι × ℕ => freeCoordinate C (κ × ℕ) (e p.1, p.2))) = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← freeCoordinateField_univ (C := C) (σ := κ × ℕ), freeCoordinateField,
    IntermediateField.adjoin_le_iff]
  rintro _ ⟨q, -, rfl⟩
  exact IntermediateField.subset_adjoin _ _ ⟨(e.symm q.1, q.2), by simp⟩

/-- Relabelling the index set of a free differential family. -/
def relabelIndex (C : Type*) {ι κ : Type*} [Field C] [CharZero C] (e : ι ≃ κ) :
    FreeFamilyJetField C ι ≃ₐ[C] FreeFamilyJetField C κ :=
  freeCoordinateBasisEquiv (algebraicIndependent_relabelFreeCoordinate e)
    (relabelFreeCoordinate_adjoin_eq_top e)

@[simp]
theorem relabelIndex_familyJet {κ : Type*} (e : ι ≃ κ) (a : ι) (m : ℕ) :
    relabelIndex C e (familyJet C a m) = familyJet C (e a) m :=
  freeCoordinateBasisEquiv_freeCoordinate _ _ (a, m)

theorem relabelIndex_deriv {κ : Type*} (e : ι ≃ κ) (f : FreeFamilyJetField C ι) :
    (relabelIndex C e f)′ = relabelIndex C e (f′) := by
  have htop : derivationIntertwiner (C := C) ((relabelIndex C e).toAlgHom)
      (freeFamilyJetShift C ι) (freeFamilyJetShift C κ) = ⊤ := by
    refine derivationIntertwiner_eq_top ?_
    rintro ⟨a, m⟩
    show freeFamilyJetShift C κ (relabelIndex C e (familyJet C a m))
      = relabelIndex C e (freeFamilyJetShift C ι (familyJet C a m))
    rw [relabelIndex_familyJet, freeFamilyJetShift_familyJet, freeFamilyJetShift_familyJet,
      relabelIndex_familyJet]
  have hf : f ∈ derivationIntertwiner (C := C) ((relabelIndex C e).toAlgHom)
      (freeFamilyJetShift C ι) (freeFamilyJetShift C κ) := by
    rw [htop]; trivial
  exact hf

theorem relabelIndex_differentialJet {κ : Type*} (e : ι ≃ κ) (m : ℕ)
    (f : FreeFamilyJetField C ι) :
    relabelIndex C e (differentialJet m f) = differentialJet m (relabelIndex C e f) := by
  induction m with
  | zero => simp
  | succ m ih => rw [differentialJet_succ, differentialJet_succ, ← ih, relabelIndex_deriv]

theorem relabelIndex_familySchwarzian {κ : Type*} (e : ι ≃ κ) (a : ι) :
    relabelIndex C e (familySchwarzian C a) = familySchwarzian C (e a) := by
  have h1 : relabelIndex C e ((familyJet C a 0)′) = (familyJet C (e a) 0)′ := by
    rw [← relabelIndex_deriv, relabelIndex_familyJet]
  have e2 : ((familyJet C a 0)′′ : FreeFamilyJetField C ι) = ((familyJet C a 0)′)′ := rfl
  have e2' : ((familyJet C (e a) 0)′′ : FreeFamilyJetField C κ)
      = ((familyJet C (e a) 0)′)′ := rfl
  have h2 : relabelIndex C e ((familyJet C a 0)′′) = (familyJet C (e a) 0)′′ := by
    rw [e2, e2', ← relabelIndex_deriv, h1]
  have e3 : ((familyJet C a 0)′′′ : FreeFamilyJetField C ι) = ((familyJet C a 0)′′)′ := rfl
  have e3' : ((familyJet C (e a) 0)′′′ : FreeFamilyJetField C κ)
      = ((familyJet C (e a) 0)′′)′ := rfl
  have h3 : relabelIndex C e ((familyJet C a 0)′′′) = (familyJet C (e a) 0)′′′ := by
    rw [e3, e3', ← relabelIndex_deriv, h2]
  simp only [familySchwarzian, schwarzian, map_sub, map_div₀, map_mul, map_pow, h1, h2, h3,
    map_ofNat]

/-- The locus where two algebra homomorphisms agree. -/
def algHomEqualizer {E E' : Type*} [Field E] [Field E'] [Algebra C E] [Algebra C E']
    (T₁ T₂ : E →ₐ[C] E') : IntermediateField C E where
  carrier := {f | T₁ f = T₂ f}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_add, map_add, hx, hy]
  mul_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_mul, map_mul, hx, hy]
  algebraMap_mem' := by
    intro c
    simp only [Set.mem_setOf_eq]
    rw [AlgHom.commutes, AlgHom.commutes]
  inv_mem' := by
    intro x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [map_inv₀, map_inv₀, hx]

/-- Two algebra homomorphisms out of a free family jet field agreeing on the coordinates are
equal. -/
theorem algHom_ext_freeCoordinate {E' : Type*} [Field E'] [Algebra C E']
    {T₁ T₂ : FreeFamilyJetField C ι →ₐ[C] E'}
    (h : ∀ p : ι × ℕ, T₁ (freeCoordinate C (ι × ℕ) p) = T₂ (freeCoordinate C (ι × ℕ) p)) :
    T₁ = T₂ := by
  have htop : algHomEqualizer T₁ T₂ = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← freeCoordinateField_univ (C := C) (σ := ι × ℕ), freeCoordinateField,
      IntermediateField.adjoin_le_iff]
    rintro _ ⟨p, -, rfl⟩
    exact h p
  refine AlgHom.ext fun x => ?_
  have hx : x ∈ algHomEqualizer T₁ T₂ := by rw [htop]; trivial
  exact hx

/-- **Relabelling commutes with the Schwarzian substitution.** -/
theorem relabelIndex_schwarzianSubstitution {κ : Type*} (e : ι ≃ κ)
    (f : FreeFamilyJetField C ι) :
    relabelIndex C e (schwarzianSubstitution C ι f) =
      schwarzianSubstitution C κ (relabelIndex C e f) := by
  have hcomp : ((relabelIndex C e).toAlgHom.comp (schwarzianSubstitution C ι)) =
      ((schwarzianSubstitution C κ).comp (relabelIndex C e).toAlgHom) := by
    refine algHom_ext_freeCoordinate ?_
    rintro ⟨a, m⟩
    show relabelIndex C e (schwarzianSubstitution C ι (familyJet C a m))
      = schwarzianSubstitution C κ (relabelIndex C e (familyJet C a m))
    rw [schwarzianSubstitution_familyJet, relabelIndex_familyJet,
      schwarzianSubstitution_familyJet, relabelIndex_differentialJet,
      relabelIndex_familySchwarzian]
  exact congrArg (fun T => T f) hcomp

/-- **The tower is natural in the index set.**  Relabelling carries each erosion level onto the
corresponding level of the relabelled family. -/
theorem map_relabelIndex_erosionLevel {κ : Type*} (e : ι ≃ κ) (n : ℕ) :
    (erosionLevel C ι n).map (relabelIndex C e).toAlgHom = erosionLevel C κ n := by
  have hiter : ∀ (m : ℕ) (f : FreeFamilyJetField C ι),
      relabelIndex C e (schwarzianIter C ι m f) =
        schwarzianIter C κ m (relabelIndex C e f) := by
    intro m
    induction m with
    | zero => intro f; rfl
    | succ m ih =>
        intro f
        rw [schwarzianIter_succ_apply, schwarzianIter_succ_apply, ih,
          relabelIndex_schwarzianSubstitution]
  refine le_antisymm ?_ ?_
  · rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
    exact ⟨relabelIndex C e g, (hiter n g).symm⟩
  · rintro _ ⟨g, rfl⟩
    refine (IntermediateField.mem_map _).2 ⟨schwarzianIter C ι n ((relabelIndex C e).symm g), ?_, ?_⟩
    · exact ⟨_, rfl⟩
    · show relabelIndex C e (schwarzianIter C ι n ((relabelIndex C e).symm g)) = _
      rw [hiter n ((relabelIndex C e).symm g)]
      simp

end

