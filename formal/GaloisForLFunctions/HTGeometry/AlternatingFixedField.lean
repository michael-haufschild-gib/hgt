import GaloisForLFunctions.HTGeometry.PermutationAction
import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# The alternating fixed field is a quadratic extension of the symmetric one

The alternating group has index two in the symmetric group, so the rational functions fixed by even
permutations form a quadratic extension of the symmetric ones.  That quadratic extension is the one
generated by a square root of the discriminant, and its existence is what a Kummer base-change
argument has to exclude.
-/

namespace GaloisForLFunctions.HTGeometry

open Equiv

universe u

/-- **The alternating group has half as many elements as the symmetric group.** -/
theorem card_alternatingGroup_mul_two {m : ℕ} (hm : 2 ≤ m) :
    Fintype.card (alternatingGroup (Fin m)) * 2 = Nat.factorial m := by
  haveI : Nontrivial (Fin m) := Fin.nontrivial_iff_two_le.2 hm
  have hcard := Subgroup.card_mul_index (alternatingGroup (Fin m))
  rw [alternatingGroup.index_eq_two] at hcard
  rw [← Nat.card_eq_fintype_card, hcard, Nat.card_eq_fintype_card, Fintype.card_perm,
    Fintype.card_fin]

section

variable (K : Type u) [Field K] (m : ℕ)

/-- The alternating group acts on the field of rational functions. -/
@[implicit_reducible]
noncomputable instance permFractionActionAux :
    MulSemiringAction (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)) :=
  IsFractionRing.mulSemiringAction (Equiv.Perm (Fin m)) (MvPolynomial (Fin m) K)
    (FractionRing (MvPolynomial (Fin m) K))

instance permFractionDistribAux :
    SMulDistribClass (Equiv.Perm (Fin m)) (MvPolynomial (Fin m) K)
      (FractionRing (MvPolynomial (Fin m) K)) :=
  IsFractionRing.smulDistribClass (Equiv.Perm (Fin m)) (MvPolynomial (Fin m) K)
    (FractionRing (MvPolynomial (Fin m) K))

instance permFractionFaithfulAux :
    FaithfulSMul (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)) :=
  IsFractionRing.faithfulSMul (Equiv.Perm (Fin m)) (MvPolynomial (Fin m) K)
    (FractionRing (MvPolynomial (Fin m) K))

/-- **The rational functions have degree `m ! / 2` over the alternating fixed field.** -/
theorem finrank_over_alternatingFixedField_mul_two (hm : 2 ≤ m) :
    Module.finrank (FixedPoints.subfield (alternatingGroup (Fin m))
        (FractionRing (MvPolynomial (Fin m) K)))
      (FractionRing (MvPolynomial (Fin m) K)) * 2 = Nat.factorial m := by
  have hfr := FixedPoints.finrank_eq_card (alternatingGroup (Fin m))
    (FractionRing (MvPolynomial (Fin m) K))
  rw [hfr]
  exact card_alternatingGroup_mul_two hm

/-- **The alternating fixed field is a quadratic extension of the symmetric one.**  Stated for any
compatible algebra structure on the inclusion of fixed fields, of which there is exactly one.

This is the subfield generated by a square root of the discriminant, and the only proper subfield of
the splitting field that a cyclic base change could meet. -/
theorem finrank_alternating_over_symmetric (hm : 2 ≤ m)
    [Algebra (FixedPoints.subfield (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))]
    [IsScalarTower
      (FixedPoints.subfield (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      (FractionRing (MvPolynomial (Fin m) K))] :
    Module.finrank
        (FixedPoints.subfield (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
        (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      = 2 := by
  have htower := Module.finrank_mul_finrank
    (FixedPoints.subfield (Equiv.Perm (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
    (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
    (FractionRing (MvPolynomial (Fin m) K))
  rw [finrank_over_symmetricFixedField] at htower
  have halt := finrank_over_alternatingFixedField_mul_two K m hm
  have hpos : 0 < Nat.factorial m := Nat.factorial_pos m
  have hy : 0 < Module.finrank
      (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      (FractionRing (MvPolynomial (Fin m) K)) := by
    rcases Nat.eq_zero_or_pos (Module.finrank
      (FixedPoints.subfield (alternatingGroup (Fin m)) (FractionRing (MvPolynomial (Fin m) K)))
      (FractionRing (MvPolynomial (Fin m) K))) with h | h
    · rw [h, zero_mul] at halt
      omega
    · exact h
  refine Nat.eq_of_mul_eq_mul_right hy ?_
  rw [htower, ← halt, mul_comm]

end

end GaloisForLFunctions.HTGeometry
