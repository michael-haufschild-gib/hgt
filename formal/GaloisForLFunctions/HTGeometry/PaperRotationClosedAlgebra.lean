import GaloisForLFunctions.HTGeometry.PaperRotationConjugation
import GaloisForLFunctions.HTGeometry.PaperRotationIntegerRecurrence
import Mathlib.Topology.MetricSpace.Equicontinuity
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# The norm-closed algebra of integer rotation words

Return-time conjugations tend to the identity on every integer Weyl word. This property forms a
norm-closed star subalgebra, so it holds on the full generated algebra, including infinite norm
limits. No assertion of irrationality or finite support is part of the construction.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Filter Topology

local notation "RotOp" => PaperRotationHilbert →L[ℂ] PaperRotationHilbert

/-- The full norm-closed star algebra generated by all integer Weyl words at frequency `t`. -/
def paperRotationAlgebra (t : ℝ) : StarSubalgebra ℂ RotOp :=
  (StarAlgebra.adjoin ℂ
    (Set.range (fun ab : ℤ × ℤ => paperRotationWord ab.1 ((ab.2 : ℝ) * t)))).topologicalClosure

theorem paperRotationWord_mem_algebra (t : ℝ) (a b : ℤ) :
    paperRotationWord a ((b : ℝ) * t) ∈ paperRotationAlgebra t :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨(a, b), rfl⟩)

private def returnAlgebra (t : ℝ) : StarSubalgebra ℂ RotOp where
  carrier := {A | Tendsto (fun n =>
    paperRotationConjugation (paperRotationReturnTime t n : ℤ) A) atTop (𝓝 A)}
  algebraMap_mem' c := by
    simp only [Set.mem_setOf_eq, AlgHomClass.commutes]
    exact tendsto_const_nhds
  add_mem' hA hB := by
    simpa only [Set.mem_setOf_eq, map_add] using hA.add hB
  mul_mem' hA hB := by
    simpa only [Set.mem_setOf_eq, map_mul] using hA.mul hB
  star_mem' hA := by
    simpa only [Set.mem_setOf_eq, map_star] using hA.star

private theorem returnAlgebra_closed (t : ℝ) : IsClosed (returnAlgebra t : Set RotOp) := by
  have he : Equicontinuous
      (fun n : ℕ => paperRotationConjugation (paperRotationReturnTime t n : ℤ)) :=
    Metric.equicontinuous_of_continuity_modulus id tendsto_id _
      (fun A B n => (paperRotationConjugation_isometry _).dist_eq A B |>.le)
  exact he.isClosed_setOf_tendsto continuous_id

private theorem phase_int_mul (b : ℤ) (x : ℝ) :
    paperRotationPhase ((b : ℝ) * x) = paperRotationPhase x ^ b := by
  simp only [paperRotationPhase, Circle.exp_intCast_mul, Circle.coe_zpow]

private theorem word_return (t : ℝ) (a b : ℤ) :
    paperRotationWord a ((b : ℝ) * t) ∈ returnAlgebra t := by
  change Tendsto (fun n => paperRotationConjugation (paperRotationReturnTime t n : ℤ)
    (paperRotationWord a ((b : ℝ) * t))) atTop (𝓝 _)
  have hp := (paperRotationReturnPhase_tendsto t).zpow₀ b (Or.inl one_ne_zero)
  have he (n : ℕ) :
      paperRotationPhase ((paperRotationReturnTime t n : ℝ) * ((b : ℝ) * t)) =
        paperRotationPhase ((paperRotationReturnTime t n : ℝ) * t) ^ b := by
    rw [← phase_int_mul]
    congr 1
    ring
  have h := hp.smul (tendsto_const_nhds (x := paperRotationWord a ((b : ℝ) * t)))
  simpa only [paperRotationConjugation_word, Int.cast_natCast, he, one_zpow, one_smul] using h

/-- Return-time conjugation converges in operator norm on the entire generated algebra. -/
theorem paperRotationAlgebra_conjugation_tendsto (t : ℝ) (A : paperRotationAlgebra t) :
    Tendsto (fun n => paperRotationConjugation (paperRotationReturnTime t n : ℤ) A.1)
      atTop (𝓝 A.1) := by
  have h : paperRotationAlgebra t ≤ returnAlgebra t := by
    apply StarSubalgebra.topologicalClosure_minimal
    · apply StarAlgebra.adjoin_le
      rintro _ ⟨⟨a, b⟩, rfl⟩
      exact word_return t a b
    · exact returnAlgebra_closed t
  exact h A.2

end

end GaloisForLFunctions.HTGeometry
