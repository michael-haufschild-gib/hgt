import GaloisForLFunctions.HTGeometry.RankOneCriticalCenteredPolynomial
import GaloisForLFunctions.HTGeometry.CenteredFreeParameter
import GaloisForLFunctions.HTGeometry.SplittingFieldBaseEquiv
import GaloisForLFunctions.HTGeometry.Critical.Geometric.MonodromyFaithful
import GaloisForLFunctions.HTGeometry.Critical.Geometric.MonodromyJordan

/-!
# Full actual monodromy in the left rank-one case

For `n > 0`, the actual extension
`criticalSourceField K 1 n / criticalObservationField K 1 n` is generated by `-x₀`.  Its minimal
polynomial is the centered generic polynomial after identifying the actual observation field with
the centered coefficient field plus one free parameter.  Consequently its actual normal closure
has automorphism group `S_(n+1)`.  Faithfulness and the exact sheet count then force the literal
actual geometric monodromy subgroup to be the full permutation group.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Polynomial

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 4000000

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] {n : ℕ}

theorem fracEmbedRingHom_algebraMap_base
    {k F E : Type*} [Field k] [Field F] [Field E]
    [Algebra k F] [Algebra F E] [Algebra k E] [IsScalarTower k F E]
    (x : k) :
    fracEmbedRingHom F E
        (algebraMap k (FractionRing (Polynomial F)) x) =
      algebraMap k (FractionRing (Polynomial E)) x := by
  rw [IsScalarTower.algebraMap_apply k F (FractionRing (Polynomial F))]
  change fracEmbed F E
      (algebraMap F (FractionRing (Polynomial F)) (algebraMap k F x)) = _
  rw [(fracEmbed F E).commutes]
  exact (IsScalarTower.algebraMap_apply k F
    (FractionRing (Polynomial E)) x).symm

/-- The actual left-rank-one observation field is the centered free-parameter base inside the
generic splitting field. -/
noncomputable def rankOneCriticalObservationToCenteredFracSubEquiv
    (hn : 0 < n) :
    criticalObservationField K 1 n ≃ₐ[K]
      fracSub (centeredCoeffField K n.succ) (centeredField K n.succ) := by
  let F := centeredCoeffField K n.succ
  let E := centeredField K n.succ
  let A := fracSub F E
  let gRing : FractionRing (Polynomial F) →+* A :=
    { toFun := fun x => ⟨fracEmbedRingHom F E x, by
        change ∃ y, fracEmbed F E y = fracEmbedRingHom F E x
        exact ⟨x, rfl⟩⟩
      map_one' := Subtype.ext (map_one (fracEmbedRingHom F E))
      map_mul' := fun x y => Subtype.ext (map_mul (fracEmbedRingHom F E) x y)
      map_zero' := Subtype.ext (map_zero (fracEmbedRingHom F E))
      map_add' := fun x y => Subtype.ext (map_add (fracEmbedRingHom F E) x y) }
  let g : FractionRing (Polynomial F) →ₐ[K] A :=
    { toRingHom := gRing
      commutes' := fun x => by
        apply Subtype.ext
        dsimp only [gRing]
        change fracEmbedRingHom F E
            (algebraMap K (FractionRing (Polynomial F)) x) =
          algebraMap K (FractionRing (Polynomial E)) x
        exact fracEmbedRingHom_algebraMap_base (k := K) (F := F) (E := E) x }
  have hg : Function.Bijective g := by
    constructor
    · intro x y hxy
      apply fracEmbedRingHom_injective (F := F) (E := E)
      dsimp only [g, gRing] at hxy
      exact congrArg Subtype.val hxy
    · intro y
      have hy := y.property
      change ∃ x, fracEmbed F E x = (y : FractionRing (Polynomial E)) at hy
      obtain ⟨x, hx⟩ := hy
      dsimp only [g, gRing]
      change ∃ x, (⟨fracEmbedRingHom F E x, _⟩ : A) = y
      exact ⟨x, Subtype.ext hx⟩
  simpa only [A] using
    (rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn).trans
      (AlgEquiv.ofBijective g hg)

theorem rankOneCriticalObservationToCenteredFracSubEquiv_apply
    (hn : 0 < n) (x : criticalObservationField K 1 n) :
    ((rankOneCriticalObservationToCenteredFracSubEquiv (K := K) hn x :
        fracSub (centeredCoeffField K n.succ) (centeredField K n.succ)) :
      FractionRing (Polynomial (centeredField K n.succ))) =
      fracEmbedRingHom (centeredCoeffField K n.succ) (centeredField K n.succ)
        (rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn x) := by
  rfl

/-- Scalar action of the actual observation field on the centered generic splitting field. -/
@[reducible] noncomputable def rankOneCriticalCenteredAmbientAlgebra
    (hn : 0 < n) :
    Algebra (criticalObservationField K 1 n)
      (FractionRing (Polynomial (centeredField K n.succ))) := by
  let A := fracSub (centeredCoeffField K n.succ) (centeredField K n.succ)
  let ι : A →+* FractionRing (Polynomial (centeredField K n.succ)) :=
    { toFun := fun x => x.1
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  exact (ι.comp
    (rankOneCriticalObservationToCenteredFracSubEquiv (K := K) hn).toRingHom).toAlgebra

/-- The centered generic field with one free parameter is a splitting field of the actual
left-rank-one polynomial. -/
theorem isSplittingField_rankOneCriticalCenteredPolynomial
    (hn : 0 < n) :
    letI := rankOneCriticalCenteredAmbientAlgebra (K := K) hn
    Polynomial.IsSplittingField
      (criticalObservationField K 1 n)
      (FractionRing (Polynomial (centeredField K n.succ)))
      (rankOneCriticalCenteredPolynomial (K := K) hn) := by
  let O := criticalObservationField K 1 n
  let F := centeredCoeffField K n.succ
  let E := centeredField K n.succ
  let A := fracSub F E
  let Ω := FractionRing (Polynomial E)
  let p := rankOneCriticalCenteredPolynomial (K := K) hn
  let q := centeredMonicE K n.succ
  let eB := rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn
  let eA := rankOneCriticalObservationToCenteredFracSubEquiv (K := K) hn
  letI : Algebra F Ω := OreLocalization.instAlgebra
  letI : Algebra F A := A.algebra'
  letI : Algebra A Ω := A.toAlgebra
  have hsf : Polynomial.IsSplittingField A Ω
      (q.map (algebraMap F A)) :=
    isSplittingField_fracSub (F := F) (E := E)
      (p := q) centeredMonicE_ne_zero splits_centeredMonicE
        rootField_centeredMonicE_eq_top
  have hmapB : p.map eB.toRingHom =
      q.map (algebraMap F (FractionRing (Polynomial F))) :=
    map_rankOneCriticalCenteredPolynomial_eq_centeredMonicE (K := K) hn
  have hmap : p.map eA.toRingHom = q.map (algebraMap F A) := by
    apply Polynomial.ext
    intro k
    apply Subtype.ext
    rw [Polynomial.coeff_map, Polynomial.coeff_map]
    change
      ((rankOneCriticalObservationToCenteredFracSubEquiv (K := K) hn (p.coeff k) : A) : Ω) =
        ((algebraMap F A) (q.coeff k) : Ω)
    rw [rankOneCriticalObservationToCenteredFracSubEquiv_apply]
    have hk := congrArg
      (fun r : Polynomial (FractionRing (Polynomial F)) => r.coeff k) hmapB
    simp only [Polynomial.coeff_map] at hk
    change rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn (p.coeff k) =
      algebraMap F (FractionRing (Polynomial F)) (q.coeff k) at hk
    rw [hk]
    change fracEmbedRingHom F E
        (algebraMap F (FractionRing (Polynomial F)) (q.coeff k)) =
      algebraMap F Ω (q.coeff k)
    exact (fracEmbed F E).commutes (q.coeff k)
  letI : Algebra O Ω := rankOneCriticalCenteredAmbientAlgebra (K := K) hn
  have hAlg : algebraMap O Ω = (algebraMap A Ω).comp eA.toRingHom := rfl
  haveI : Polynomial.IsSplittingField A Ω (p.map eA.toRingHom) := hmap ▸ hsf
  exact isSplittingField_map_algEquiv_of_algebraMap_eq eA.toRingEquiv hAlg p

/-- The actual normal closure is a splitting field of the same centered polynomial. -/
theorem isSplittingField_criticalNormalClosure_rankOneCenteredPolynomial
    (hn : 0 < n) :
    Polynomial.IsSplittingField
      (criticalObservationField K 1 n)
      (criticalNormalClosure K 1 n)
      (rankOneCriticalCenteredPolynomial (K := K) hn) := by
  let O := criticalObservationField K 1 n
  let S := criticalSourceField K 1 n
  let N := criticalNormalClosure K 1 n
  let a : S := -criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n))
  letI : FiniteDimensional O S :=
    criticalSourceField_finiteDimensional_criticalObservationField K (by omega) hn
  letI : Algebra.IsSeparable O S := inferInstance
  letI : IsScalarTower O S (criticalSourceAlgebraicClosure K 1 n) :=
    AlgebraicClosure.instIsScalarTower S
  letI : Algebra.IsAlgebraic O (criticalSourceAlgebraicClosure K 1 n) :=
    Algebra.IsAlgebraic.trans O S (criticalSourceAlgebraicClosure K 1 n)
  letI : Normal O (criticalSourceAlgebraicClosure K 1 n) :=
    { splits' _ := IsAlgClosed.splits _ }
  letI : Normal O N :=
    normalClosure.normal O S (criticalSourceAlgebraicClosure K 1 n)
  letI : Algebra.IsAlgebraic O S := inferInstance
  have ha : IsIntegral O a := IsIntegral.of_finite O a
  have hsf := isSplittingField_minpoly_of_isNormalClosure_of_adjoin_singleton_eq_top
    (F := O) (S := S) (L := N) a ha
      (rankOneCriticalSourceField_adjoin_neg_raw_zero_eq_top (K := K) hn)
  rw [minpoly_neg_criticalSourceRaw_zero_eq_rankOneCriticalCenteredPolynomial
    (K := K) hn] at hsf
  exact hsf

/-- Automorphisms of the actual normal closure are the full symmetric group on `n+1` letters. -/
noncomputable def rankOneCriticalNormalClosurePermEquiv
    (hn : 0 < n) :
    (criticalNormalClosure K 1 n ≃ₐ[criticalObservationField K 1 n]
      criticalNormalClosure K 1 n) ≃* Equiv.Perm (Fin (n + 1)) := by
  let O := criticalObservationField K 1 n
  let N := criticalNormalClosure K 1 n
  let F := centeredCoeffField K n.succ
  let E := centeredField K n.succ
  let A := fracSub F E
  let Ω := FractionRing (Polynomial E)
  let p := rankOneCriticalCenteredPolynomial (K := K) hn
  let eA := rankOneCriticalObservationToCenteredFracSubEquiv (K := K) hn
  letI : Algebra O Ω := rankOneCriticalCenteredAmbientAlgebra (K := K) hn
  letI : Algebra F Ω := OreLocalization.instAlgebra
  letI : Algebra A Ω := A.toAlgebra
  letI : Polynomial.IsSplittingField O N p :=
    isSplittingField_criticalNormalClosure_rankOneCenteredPolynomial (K := K) hn
  letI : Polynomial.IsSplittingField O Ω p :=
    isSplittingField_rankOneCriticalCenteredPolynomial (K := K) hn
  have hAlg : algebraMap O Ω = (algebraMap A Ω).comp eA.toRingHom := rfl
  exact (splittingFieldAutEquiv (F := O) (p := p) (L := N) (L' := Ω)).trans
    ((autEquivOfBaseEquiv eA.toRingEquiv hAlg).trans
      (centeredFreeParameterMonodromy K n.succ))

theorem natCard_criticalNormalClosureAut_rankOne
    (hn : 0 < n) :
    Nat.card
        (criticalNormalClosure K 1 n ≃ₐ[criticalObservationField K 1 n]
          criticalNormalClosure K 1 n) =
      Nat.factorial (n + 1) := by
  calc
    Nat.card
        (criticalNormalClosure K 1 n ≃ₐ[criticalObservationField K 1 n]
          criticalNormalClosure K 1 n) =
        Nat.card (Equiv.Perm (Fin (n + 1))) :=
      Nat.card_congr (rankOneCriticalNormalClosurePermEquiv (K := K) hn).toEquiv
    _ = Nat.factorial (n + 1) := by
      rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]

/-- The actual left-rank-one critical geometric monodromy is the full symmetric group over every
algebraically closed characteristic-zero field. -/
theorem criticalGeometricMonodromy_one_left_eq_top
    (hn : 0 < n) :
    criticalGeometricMonodromy K 1 n = ⊤ := by
  classical
  let O := criticalObservationField K 1 n
  let N := criticalNormalClosure K 1 n
  let X := criticalGeometricSheet K 1 n
  let G := N ≃ₐ[O] N
  letI : FiniteDimensional O N :=
    criticalNormalClosure_finiteDimensional K (by omega) hn
  letI : Fintype G := Fintype.ofFinite G
  letI : Finite (criticalGeometricSheet K 1 n) :=
    finite_criticalGeometricSheet K (by omega) hn
  letI : Fintype X := Fintype.ofFinite X
  have hcardG : Fintype.card G = Nat.factorial (n + 1) := by
    rw [← Nat.card_eq_fintype_card]
    exact natCard_criticalNormalClosureAut_rankOne (K := K) hn
  have hcardX : Fintype.card X = n + 1 := by
    rw [← Nat.card_eq_fintype_card,
      natCard_criticalGeometricSheet_eq_criticalHorizonMultiplicity K (by omega) hn]
    simp [criticalHorizonMultiplicity, Nat.add_comm]
  have hcard : Fintype.card G = Fintype.card (Equiv.Perm X) := by
    rw [hcardG, Fintype.card_perm, hcardX]
  have hbij : Function.Bijective (criticalNormalClosureAction K 1 n) :=
    (Fintype.bijective_iff_injective_and_card (criticalNormalClosureAction K 1 n)).2
      ⟨criticalNormalClosureAction_injective K (by omega) hn, hcard⟩
  exact MonoidHom.range_eq_top.mpr hbij.surjective

end

end GaloisForLFunctions.HTGeometry
