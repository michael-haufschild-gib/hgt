import GaloisForLFunctions.HTGeometry.KolchinJetCapacity

/-!
# The Kolchin jet capacity is the minimal differential order

For a differentially algebraic element `x` of a differential field extension, let `n₀` be the least
`n` for which the `n`-th derivative is algebraic over the field generated by the lower ones — the
minimal order of an algebraic differential equation satisfied by `x`.  Then

```text
kolchinJetCapacity F x = n₀.
```

Both inequalities are elementary consequences of the jet-prefix theory: above `n₀` every jet is
algebraic over the length-`n₀` prefix, so no finite jet packet has rank more than `n₀`; below `n₀`
each jet is transcendental over its own prefix, so the first `n₀` jets are algebraically
independent and the packet of length `n₀` already has rank `n₀`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential F] [Differential E]
  [DifferentialAlgebra F E] [CharZero E]

/-- The orders at which a jet becomes algebraic over the field generated by the lower jets. -/
def differentialOrderSet (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) : Set ℕ :=
  {n : ℕ | IsAlgebraic (differentialJetPrefixField F x n) (differentialJet n x)}

/-- **The minimal differential order** of an element: the least order at which an algebraic
differential relation appears. -/
def differentialOrder (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) : ℕ :=
  sInf (differentialOrderSet F x)

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
theorem differentialOrderSet_nonempty {x : E} (hx : DifferentialAlgebraicOver F x) :
    (differentialOrderSet F x).Nonempty :=
  exists_algebraic_jet_over_prefix (k := F) hx

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
theorem differentialOrder_mem {x : E} (hx : DifferentialAlgebraicOver F x) :
    differentialOrder F x ∈ differentialOrderSet F x :=
  Nat.sInf_mem (differentialOrderSet_nonempty hx)

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
theorem transcendental_of_lt_differentialOrder {x : E} {m : ℕ} (hm : m < differentialOrder F x) :
    Transcendental (differentialJetPrefixField F x m) (differentialJet m x) := by
  intro halg
  have hmem : m ∈ differentialOrderSet F x := halg
  have hle : differentialOrder F x ≤ m := Nat.sInf_le hmem
  omega

/-- Above the minimal order every jet packet has rank at most the minimal order. -/
theorem kolchinJetRank_le_differentialOrder {x : E} (hx : DifferentialAlgebraicOver F x) (r : ℕ) :
    kolchinJetRank F x r ≤ differentialOrder F x := by
  classical
  have hn := differentialOrder_mem hx
  have hbase : ∀ z ∈ scalarFiniteJetPacket x r,
      IsAlgebraic (Algebra.adjoin F
        (↑(scalarJetPrefixPacket x (differentialOrder F x)) : Set E)) z := by
    intro z hz
    rw [mem_scalarFiniteJetPacket_iff] at hz
    obtain ⟨k, -, rfl⟩ := hz
    have halg : IsAlgebraic (differentialJetPrefixField F x (differentialOrder F x))
        (differentialJet k x) :=
      all_jets_algebraic_over_prefix (k := F) x (differentialOrder F x) hn k
    rw [coe_scalarJetPrefixPacket]
    exact isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateAdjoin _ halg
  calc kolchinJetRank F x r
      ≤ finiteAlgebraicMatroidRank F (scalarJetPrefixPacket x (differentialOrder F x)) :=
        finiteAlgebraicMatroidRank_le_of_isAlgebraic_adjoin _ _ hbase
    _ ≤ (scalarJetPrefixPacket x (differentialOrder F x)).card :=
        finiteAlgebraicMatroidRank_le_card _
    _ ≤ differentialOrder F x := card_scalarJetPrefixPacket_le x _

theorem kolchinJetCapacity_le_differentialOrder {x : E} (hx : DifferentialAlgebraicOver F x) :
    kolchinJetCapacity F x ≤ differentialOrder F x :=
  kolchinJetCapacity_le (kolchinJetRank_le_differentialOrder hx)

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- Below the minimal order the jets are algebraically independent. -/
theorem algebraicIndepOn_jets_lt_differentialOrder (x : E) (n : ℕ)
    (hn : n ≤ differentialOrder F x) :
    AlgebraicIndepOn F (fun m => differentialJet m x) (Set.Iio n) := by
  induction n with
  | zero =>
      simpa using (algebraicIndependent_empty_type :
        AlgebraicIndependent F (fun i : (∅ : Set ℕ) => differentialJet (i : ℕ) x))
  | succ n ih =>
      have hlt : n < differentialOrder F x := by omega
      have hstep := transcendental_of_lt_differentialOrder (F := F) (x := x) hlt
      rw [show Set.Iio (n + 1) = insert n (Set.Iio n) by ext m; simp]
      exact (ih (by omega)).insert
        (IntermediateField.transcendental_adjoin_iff.mp hstep)

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- The first `n + 1` jets are pairwise distinct below the minimal order. -/
theorem injOn_jets_lt_differentialOrder {x : E} {n : ℕ}
    (hn : n + 1 ≤ differentialOrder F x) :
    Set.InjOn (fun m => differentialJet m x) (Set.Iio (n + 1)) := by
  have hindepOn := algebraicIndepOn_jets_lt_differentialOrder (F := F) x (n + 1) hn
  intro m hm m' hm' hmm
  exact congrArg Subtype.val (hindepOn.injective (a₁ := ⟨m, hm⟩) (a₂ := ⟨m', hm'⟩) hmm)

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- Below the minimal order the jet packet has full cardinality. -/
theorem card_scalarFiniteJetPacket_of_lt_differentialOrder {x : E} {n : ℕ}
    (hn : n + 1 ≤ differentialOrder F x) :
    (scalarFiniteJetPacket x n).card = n + 1 := by
  classical
  have hinj := injOn_jets_lt_differentialOrder (F := F) hn
  have hpackEq : scalarFiniteJetPacket x n
      = (Finset.range (n + 1)).image (fun k => differentialJet k x) := rfl
  rw [hpackEq, Finset.card_image_of_injOn, Finset.card_range]
  intro m hm m' hm' hmm
  exact hinj (by simpa using hm) (by simpa using hm') hmm

set_option maxHeartbeats 4000000 in
omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- Below the minimal order the jet packet is algebraically independent. -/
theorem algebraicIndependent_scalarFiniteJetPacket {x : E} {n : ℕ}
    (hn : n + 1 ≤ differentialOrder F x) :
    AlgebraicIndependent F ((↑) : (↑(scalarFiniteJetPacket x n) : Set E) → E) := by
  classical
  have hindepOn := algebraicIndepOn_jets_lt_differentialOrder (F := F) x (n + 1) hn
  have hsub : (↑(scalarFiniteJetPacket x n) : Set E)
      ⊆ (fun m => differentialJet m x) '' Set.Iio (n + 1) := by
    intro z hz
    rw [Finset.mem_coe, mem_scalarFiniteJetPacket_iff] at hz
    obtain ⟨k, hk, rfl⟩ := hz
    exact ⟨k, by simpa using hk, rfl⟩
  exact AlgebraicIndependent.mono hsub hindepOn.image

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- Below the minimal order the jet rank is maximal. -/
theorem kolchinJetRank_eq_of_lt_differentialOrder {x : E} {n : ℕ}
    (hn : n + 1 ≤ differentialOrder F x) : kolchinJetRank F x n = n + 1 := by
  rw [kolchinJetRank,
    finiteAlgebraicMatroidRank_eq_card_of_algebraicIndependent _
      (algebraicIndependent_scalarFiniteJetPacket (F := F) hn),
    card_scalarFiniteJetPacket_of_lt_differentialOrder (F := F) hn]

/-- The packet of the first `n₀` jets already realises the capacity. -/
theorem differentialOrder_le_kolchinJetCapacity {x : E} (hx : DifferentialAlgebraicOver F x) :
    differentialOrder F x ≤ kolchinJetCapacity F x := by
  rcases Nat.eq_zero_or_pos (differentialOrder F x) with h0 | hpos
  · omega
  obtain ⟨n₀, hn₀⟩ : ∃ n₀, differentialOrder F x = n₀ + 1 :=
    ⟨differentialOrder F x - 1, by omega⟩
  have hrank : kolchinJetRank F x n₀ = n₀ + 1 :=
    kolchinJetRank_eq_of_lt_differentialOrder (F := F) (by omega)
  calc differentialOrder F x = n₀ + 1 := hn₀
    _ = kolchinJetRank F x n₀ := hrank.symm
    _ ≤ kolchinJetCapacity F x := kolchinJetRank_le_kolchinJetCapacity hx _

/-- **The Kolchin jet capacity is the minimal differential order.** -/
theorem kolchinJetCapacity_eq_differentialOrder {x : E} (hx : DifferentialAlgebraicOver F x) :
    kolchinJetCapacity F x = differentialOrder F x :=
  le_antisymm (kolchinJetCapacity_le_differentialOrder hx)
    (differentialOrder_le_kolchinJetCapacity hx)

end

end GaloisForLFunctions.HTGeometry
