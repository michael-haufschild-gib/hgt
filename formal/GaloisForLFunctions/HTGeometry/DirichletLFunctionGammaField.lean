import GaloisForLFunctions.HTGeometry.BoundedDirichletGammaField
import GaloisForLFunctions.HTGeometry.ZetaGammaFieldFieldCoefficients
import Mathlib.NumberTheory.LSeries.PrimesInAP

/-!
# Dirichlet L-functions over the Gamma field

Every Dirichlet `L`-function is differentially transcendental over the differential field generated by
`Γ` over `ℂ(s)`.

Its coefficients are bounded by one, so on every vertical line to the right of `1` the series
converges uniformly and the `L`-function is almost periodic there.  Its coefficients are nonzero at
every prime not dividing the modulus — in particular at every prime beyond the modulus — and the
logarithms of distinct primes are rationally independent, so the frequency rank of the line
restriction exceeds every natural number.  The finite phase law then excludes every relation with
coefficients in `ℂ(s)⟨Γ⟩`.
-/

open Filter Set Topology Function

open scoped Differential

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance lfunDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance lfunIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance lfunDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance lfunComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance lfunRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

variable {q : ℕ} [NeZero q]

/-- The Dirichlet series of an `L`-function, in the exponential indexing of the frequency
machinery. -/
theorem lfunction_hasSum (χ : DirichletCharacter ℂ q) {z : ℂ} (hz : 1 < z.re) :
    HasSum (fun i : ℕ => (χ ((i + 1 : ℕ) : ZMod q))
        * Complex.exp (-((Real.log ((i : ℝ) + 1) : ℝ) : ℂ) * z))
      (DirichletCharacter.LFunction χ z) := by
  classical
  have hsummable : LSeriesSummable (fun n : ℕ => (χ (n : ZMod q))) z :=
    LSeriesSummable_of_bounded_of_one_lt_re (m := 1)
      (fun n _ => DirichletCharacter.norm_le_one χ (n : ZMod q)) hz
  have hHasSum : HasSum (LSeries.term (fun n : ℕ => (χ (n : ZMod q))) z)
      (LSeries (fun n : ℕ => (χ (n : ZMod q))) z) := hsummable.hasSum
  have hzero : LSeries.term (fun n : ℕ => (χ (n : ZMod q))) z 0 = 0 := LSeries.term_zero _ _
  have hshift : HasSum (fun i : ℕ => LSeries.term (fun n : ℕ => (χ (n : ZMod q))) z (i + 1))
      (LSeries (fun n : ℕ => (χ (n : ZMod q))) z) := by
    rw [hasSum_nat_add_iff 1]
    simpa [hzero] using hHasSum
  have hterm : ∀ i : ℕ, LSeries.term (fun n : ℕ => (χ (n : ZMod q))) z (i + 1)
      = (χ ((i + 1 : ℕ) : ZMod q))
        * Complex.exp (-((Real.log ((i : ℝ) + 1) : ℝ) : ℂ) * z) := by
    intro i
    rw [LSeries.term_of_ne_zero (Nat.succ_ne_zero i), exp_neg_log_succ_mul]
    have hcast : (((i + 1 : ℕ)) : ℂ) = (i : ℂ) + 1 := by push_cast; ring
    rw [hcast]
    ring
  rw [DirichletCharacter.LFunction_eq_LSeries χ hz]
  rw [funext hterm] at hshift
  exact hshift

/-- Beyond the modulus every prime is coprime to it, so the character does not vanish there. -/
theorem lfunction_coeff_ne_zero (χ : DirichletCharacter ℂ q) {p : ℕ} (hp : p.Prime)
    (hpq : q < p) : (χ ((p : ℕ) : ZMod q)) ≠ 0 := by
  have hq0 : 0 < q := Nat.pos_of_ne_zero (NeZero.ne q)
  have hndvd : ¬ p ∣ q := by
    intro hdvd
    have := Nat.le_of_dvd hq0 hdvd
    omega
  have hcop : Nat.Coprime p q := (Nat.Prime.coprime_iff_not_dvd hp).mpr hndvd
  exact MulChar.apply_ne_zero_iff.mpr ((ZMod.isUnit_iff_coprime p q).mpr hcop)

/-- Arbitrarily many primes beyond any bound. -/
theorem exists_primes_gt (b : ℕ) (K : ℕ) :
    ∃ ps : Fin (K + 1) → Nat.Primes, Function.Injective ps ∧ ∀ i, b < (ps i : ℕ) := by
  have hmono : StrictMono (Nat.nth Nat.Prime) := by
    intro u v huv
    exact (Nat.nth_lt_nth Nat.infinite_setOf_prime).mpr huv
  refine ⟨fun i => ⟨Nat.nth Nat.Prime (b + 1 + (i : ℕ)), Nat.prime_nth_prime _⟩, ?_, ?_⟩
  · intro i j hij
    have h : Nat.nth Nat.Prime (b + 1 + (i : ℕ)) = Nat.nth Nat.Prime (b + 1 + (j : ℕ)) :=
      congrArg Subtype.val hij
    have := hmono.injective h
    exact Fin.ext (by omega)
  · intro i
    have hle : b + 1 + (i : ℕ) ≤ Nat.nth Nat.Prime (b + 1 + (i : ℕ)) := hmono.le_apply
    show b < Nat.nth Nat.Prime (b + 1 + (i : ℕ))
    omega

/-- The `L`-function is analytic on every upper half-plane: its only possible pole is at `1`. -/
theorem analyticOnNhd_lfunction_upperTail (χ : DirichletCharacter ℂ q) :
    AnalyticOnNhd ℂ (DirichletCharacter.LFunction χ) (upperTail 0) := by
  refine DifferentiableOn.analyticOnNhd ?_ (isOpen_upperTail 0)
  intro z hz
  have him : (0 : ℝ) < z.im := hz
  have hne : z ≠ 1 := by
    intro h
    rw [h] at him
    simp at him
  exact (DirichletCharacter.differentiableAt_LFunction χ z (Or.inl hne)).differentiableWithinAt

/-- The `L`-function as an upper-end analytic germ. -/
def lfunctionUpperAnalytic (χ : DirichletCharacter ℂ q) : upperEndAnalyticSubring :=
  ⟨(Germ.coeRingHom upperEndFilter (DirichletCharacter.LFunction χ)),
    ⟨DirichletCharacter.LFunction χ, 0, analyticOnNhd_lfunction_upperTail χ, rfl⟩⟩

@[simp] theorem lfunctionUpperAnalytic_coe (χ : DirichletCharacter ℂ q) :
    upperEndAnalyticSubring.subtype (lfunctionUpperAnalytic χ)
      = Germ.coeRingHom upperEndFilter (DirichletCharacter.LFunction χ) := rfl

/-- **Every Dirichlet `L`-function is differentially transcendental over the Gamma field.**  On any
vertical line to the right of `1` it satisfies no nontrivial differential relation whose coefficients
are nonzero elements of `ℂ(s)⟨Γ⟩`. -/
theorem lfunction_no_gammaField_field_relation (χ : DirichletCharacter ℂ q) {σ : ℝ} (hσ : 1 < σ)
    {n N : ℕ} (hN : 0 < N) (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialAdjoin (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0) :
    ∑ α : Fin N, x α * ∏ i : Fin (n + 1),
        (differentialJet (i : ℕ)
          (algebraMap upperEndAnalyticSubring upperEndMeroField
            (lfunctionUpperAnalytic χ))) ^ (e α i)
      ≠ 0 := by
  classical
  have hb : ∀ i : ℕ, ‖(χ ((i + 1 : ℕ) : ZMod q))‖ ≤ 1 :=
    fun i => DirichletCharacter.norm_le_one χ _
  have hD : DifferentiableOn ℂ (DirichletCharacter.LFunction χ)
      (verticalStrip σ ((σ - 1) / 2)) := by
    intro z hz
    have habs : |z.re - σ| < (σ - 1) / 2 := hz
    have h1 : σ - (σ - 1) / 2 < z.re := by
      have := (abs_lt.mp habs).1
      linarith
    have hre : 1 < z.re := by linarith
    have hne : z ≠ 1 := by
      intro h
      rw [h] at hre
      simp at hre
    exact (DirichletCharacter.differentiableAt_LFunction χ z (Or.inl hne)).differentiableWithinAt
  have hprimes : ∀ K : ℕ, ∃ ps : Fin (K + 1) → Nat.Primes, Function.Injective ps ∧
      ∀ i, (χ ((((ps i : ℕ) - 1) + 1 : ℕ) : ZMod q)) ≠ 0 := by
    intro K
    obtain ⟨ps, hps, hgt⟩ := exists_primes_gt q K
    refine ⟨ps, hps, fun i => ?_⟩
    have hp1 : 1 ≤ (ps i : ℕ) := ((ps i).2).one_lt.le
    have hcast : (((ps i : ℕ) - 1) + 1 : ℕ) = (ps i : ℕ) := by omega
    rw [hcast]
    exact lfunction_coeff_ne_zero χ (ps i).2 (hgt i)
  exact no_gammaField_field_relation_of_boundedDirichlet hσ
    (fun i : ℕ => (χ ((i + 1 : ℕ) : ZMod q))) (DirichletCharacter.LFunction χ) hb
    (fun z hz => lfunction_hasSum χ hz) hD hprimes hN e he (lfunctionUpperAnalytic χ) rfl x
    hxmem hx0

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {q : ℕ} [NeZero q]

/-- **The Bohr–Fourier expansion of a Dirichlet `L`-function carries arbitrarily many rationally
independent frequencies.**  Beyond the modulus every prime contributes a nonzero coefficient. -/
theorem lfunction_independent_spectrum (χ : DirichletCharacter ℂ q) {σ : ℝ} (hσ : 1 < σ) (K : ℕ) :
    ∃ ν : Fin (K + 1) → ℝ, LinearIndependent ℚ ν ∧
      ∀ i, ν i ∈ bohrSpectrum
        fun t : ℝ => DirichletCharacter.LFunction χ ((σ : ℂ) + (t : ℂ) * Complex.I) := by
  classical
  obtain ⟨ps, hps, hgt⟩ := exists_primes_gt q K
  have hR : (0 : ℝ) < (σ - 1) / 2 := by linarith
  have hb : ∀ i : ℕ, ‖(χ ((i + 1 : ℕ) : ZMod q))‖ ≤ 1 :=
    fun i => DirichletCharacter.norm_le_one χ _
  have hconv := boundedDirichlet_conv hb (fun z hz => lfunction_hasSum χ hz)
    (σ := σ) (R := (σ - 1) / 2) (by linarith)
  have hap : IsStripAlmostPeriodic (DirichletCharacter.LFunction χ) σ ((σ - 1) / 2) :=
    isStripAlmostPeriodic_dirichlet (fun i : ℕ => (χ ((i + 1 : ℕ) : ZMod q)))
      (fun i : ℕ => Real.log ((i : ℝ) + 1)) (DirichletCharacter.LFunction χ) hconv
  have hline : _root_.HTGeometry.IsBohrAlmostPeriodic
      fun t : ℝ => DirichletCharacter.LFunction χ ((σ : ℂ) + (t : ℂ) * Complex.I) :=
    isBohrAlmostPeriodic_line hR hap
  have hcont : Continuous
      fun t : ℝ => DirichletCharacter.LFunction χ ((σ : ℂ) + (t : ℂ) * Complex.I) := by
    have hdiff : DifferentiableOn ℂ (DirichletCharacter.LFunction χ)
        (verticalStrip σ ((σ - 1) / 2)) := by
      intro z hz
      have habs : |z.re - σ| < (σ - 1) / 2 := hz
      have h1 : σ - (σ - 1) / 2 < z.re := by
        have := (abs_lt.mp habs).1
        linarith
      have hre : 1 < z.re := by linarith
      have hne : z ≠ 1 := by
        intro h
        rw [h] at hre
        simp at hre
      exact (DirichletCharacter.differentiableAt_LFunction χ z (Or.inl hne)).differentiableWithinAt
    exact continuous_line_restriction hR hdiff
  refine ⟨fun i => -(Real.log (((ps i : ℕ)) : ℝ)),
    linearIndependent_rat_neg_log_primes ps hps, fun i => ?_⟩
  have hp1 : 1 ≤ (ps i : ℕ) := ((ps i).2).one_lt.le
  have hcast : ((((ps i : ℕ) - 1 : ℕ) : ℝ)) + 1 = (((ps i : ℕ)) : ℝ) := by
    rw [Nat.cast_sub hp1]
    push_cast
    ring
  have hm : ∀ ε : ℝ, 0 < ε → ∃ n₀ : ℕ, ((ps i : ℕ) - 1) < n₀ ∧ ∀ t : ℝ,
      ‖DirichletCharacter.LFunction χ ((σ : ℂ) + (t : ℂ) * Complex.I)
        - ∑ k ∈ Finset.range n₀,
          (χ ((k + 1 : ℕ) : ZMod q)) * Complex.exp (-((Real.log ((k : ℝ) + 1) : ℝ) : ℂ)
            * ((σ : ℂ) + (t : ℂ) * Complex.I))‖ ≤ ε := by
    intro ε hε
    obtain ⟨M, hM⟩ := boundedDirichlet_uniform_approx hb (fun z hz => lfunction_hasSum χ hz) hσ hε
    refine ⟨max M ((ps i : ℕ) - 1 + 1),
      lt_of_lt_of_le (Nat.lt_succ_self _) (le_max_right _ _), fun t => ?_⟩
    exact hM _ (le_max_left _ _) _ (by simp)
  have hcoeff := bohrCoefficient_dirichlet_line (fun i : ℕ => (χ ((i + 1 : ℕ) : ZMod q)))
    (fun i : ℕ => Real.log ((i : ℝ) + 1)) (DirichletCharacter.LFunction χ)
    zetaFrequency_injective hcont hline ((ps i : ℕ) - 1) hm
  show bohrCoefficient
    (fun t : ℝ => DirichletCharacter.LFunction χ ((σ : ℂ) + (t : ℂ) * Complex.I))
    (-(Real.log (((ps i : ℕ)) : ℝ))) ≠ 0
  rw [← hcast, hcoeff]
  refine mul_ne_zero ?_ ?_
  · have hne := lfunction_coeff_ne_zero χ (ps i).2 (hgt i)
    have hidx : ((((ps i : ℕ) - 1) + 1 : ℕ) : ZMod q) = (((ps i : ℕ)) : ZMod q) := by
      have : (((ps i : ℕ) - 1) + 1 : ℕ) = (ps i : ℕ) := by omega
      rw [this]
    rw [hidx]
    exact hne
  · have hpos : (0 : ℝ) <
        Real.exp (-(Real.log ((((ps i : ℕ) - 1 : ℕ) : ℝ) + 1)) * σ) := Real.exp_pos _
    exact_mod_cast ne_of_gt hpos

end

end GaloisForLFunctions.HTGeometry
