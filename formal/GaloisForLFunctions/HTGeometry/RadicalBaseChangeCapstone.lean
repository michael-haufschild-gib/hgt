import GaloisForLFunctions.HTGeometry.PolynomialBaseChangeAssembled
import GaloisForLFunctions.HTGeometry.KummerCyclic

/-!
# The instances of the splitting field of a product

Inside the splitting field of a product both factors split, so the field generated by the roots of
either is a splitting field of that factor: normal, finite, and Galois over the base in
characteristic zero.  The whole splitting field is Galois over the base and hence over each of
those.

These are the instances the base change step asks for, and they are all consequences of the ambient
being a splitting field of the product.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F L : Type*} [Field F] [CharZero F] [Field L] [Algebra F L]

omit [CharZero F] in
theorem splits_of_splits_mul_left {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    (h : ((p * q).map (algebraMap F L)).Splits) : (p.map (algebraMap F L)).Splits := by
  rw [Polynomial.map_mul] at h
  refine h.of_dvd (mul_ne_zero ?_ ?_) ⟨q.map (algebraMap F L), rfl⟩
  · exact fun hcon => hp ((Polynomial.map_eq_zero_iff (algebraMap F L).injective).1 hcon)
  · exact fun hcon => hq ((Polynomial.map_eq_zero_iff (algebraMap F L).injective).1 hcon)

omit [CharZero F] in
theorem splits_of_splits_mul_right {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    (h : ((p * q).map (algebraMap F L)).Splits) : (q.map (algebraMap F L)).Splits := by
  rw [mul_comm] at h
  exact splits_of_splits_mul_left hq hp h

omit [CharZero F] in
/-- The root field of a factor is a splitting field of that factor. -/
theorem isSplittingField_rootField_left {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    Polynomial.IsSplittingField F (rootField F (L := L) p) p :=
  isSplittingField_rootField (splits_of_splits_mul_left hp hq
    (Polynomial.IsSplittingField.splits' (K := F) (L := L) (f := p * q)))

omit [CharZero F] in
theorem isSplittingField_rootField_right {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    Polynomial.IsSplittingField F (rootField F (L := L) q) q :=
  isSplittingField_rootField (splits_of_splits_mul_right hp hq
    (Polynomial.IsSplittingField.splits' (K := F) (L := L) (f := p * q)))

theorem isGalois_rootField_left {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    IsGalois F (rootField F (L := L) p) := by
  haveI := isSplittingField_rootField_left (L := L) (p := p) (q := q) hp hq
  haveI : Normal F (rootField F (L := L) p) := Normal.of_isSplittingField p
  exact ⟨⟩

theorem isGalois_rootField_right {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    IsGalois F (rootField F (L := L) q) := by
  haveI := isSplittingField_rootField_right (L := L) (p := p) (q := q) hp hq
  haveI : Normal F (rootField F (L := L) q) := Normal.of_isSplittingField q
  exact ⟨⟩

omit [CharZero F] in
theorem finiteDimensional_rootField_left {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    FiniteDimensional F (rootField F (L := L) p) := by
  haveI := isSplittingField_rootField_left (L := L) (p := p) (q := q) hp hq
  exact Polynomial.IsSplittingField.finiteDimensional _ p

omit [CharZero F] in
theorem finiteDimensional_rootField_right {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    FiniteDimensional F (rootField F (L := L) q) := by
  haveI := isSplittingField_rootField_right (L := L) (p := p) (q := q) hp hq
  exact Polynomial.IsSplittingField.finiteDimensional _ q

/-- **The whole splitting field is Galois over the root field of either factor.** -/
theorem isGalois_top_over_rootField {p q : Polynomial F}
    [Polynomial.IsSplittingField F L (p * q)] :
    IsGalois (rootField F (L := L) q) L := by
  haveI : FiniteDimensional F L := Polynomial.IsSplittingField.finiteDimensional L (p * q)
  haveI : Normal F L := Normal.of_isSplittingField (p * q)
  haveI : IsGalois F L := ⟨⟩
  exact IsGalois.tower_top_intermediateField _

end GaloisForLFunctions.HTGeometry
