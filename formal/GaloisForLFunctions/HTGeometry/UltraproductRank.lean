import GaloisForLFunctions.HTGeometry.UniformJetRelation
import GaloisForLFunctions.HTGeometry.GeneratedFieldRank
import GaloisForLFunctions.HTGeometry.AlgebraicWitness

/-!
# Rank in an ultraproduct produces one equation for the whole family

An ultraproduct of copies of a field along an ultrafilter is again a field, and germ formation is a
homomorphism of algebras over the base.  A polynomial therefore annihilates the germ of a family of
tuples exactly when it annihilates almost every member.

Combining this with the generator bound: if in every ultraproduct each entry of the germ tuple is
algebraic over the subfield generated by a fixed number `d` of germs, then in every ultraproduct the
`d + 1` entries are algebraically dependent, so almost every member is annihilated; the compactness
step then produces a single nonzero polynomial annihilating **every** member.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter Cardinal

/-- The base algebra structure on a germ ring, through constant sequences. -/
noncomputable instance germAlgebra {ι K Ω : Type*} [CommRing K] [CommRing Ω] [Algebra K Ω]
    (l : Filter ι) : Algebra K (Filter.Germ l Ω) :=
  RingHom.toAlgebra
    ((Filter.Germ.coeRingHom l).comp ((Pi.constRingHom ι Ω).comp (algebraMap K Ω)))

variable {ι K Ω : Type*} [Field K] [CommRing Ω] [Algebra K Ω]

/-- Germ formation as a homomorphism of `K`-algebras. -/
noncomputable def germAlgHom (l : Filter ι) : (ι → Ω) →ₐ[K] Filter.Germ l Ω where
  toRingHom := Filter.Germ.coeRingHom l
  commutes' := fun _ => rfl

@[simp] theorem germAlgHom_apply (l : Filter ι) (f : ι → Ω) :
    germAlgHom (K := K) l f = (f : Filter.Germ l Ω) := rfl

/-- Evaluating a polynomial at the germs of coordinate sequences gives the germ of the pointwise
evaluations. -/
theorem aeval_germ {σ : Type*} (l : Filter ι) (ξ : ι → σ → Ω) (Q : MvPolynomial σ K) :
    MvPolynomial.aeval (fun i : σ => ((fun n => ξ n i : ι → Ω) : Filter.Germ l Ω)) Q
      = ((fun n => MvPolynomial.aeval (ξ n) Q : ι → Ω) : Filter.Germ l Ω) := by
  have hpi : ∀ n : ι,
      (MvPolynomial.aeval (fun i : σ => (fun n => ξ n i : ι → Ω)) Q) n
        = MvPolynomial.aeval (ξ n) Q := by
    intro n
    have := MvPolynomial.comp_aeval_apply (R := K)
      (fun i : σ => (fun n => ξ n i : ι → Ω)) (Pi.evalAlgHom K (fun _ : ι => Ω) n) Q
    simpa using this
  have hgerm := MvPolynomial.comp_aeval_apply (R := K)
    (fun i : σ => (fun n => ξ n i : ι → Ω)) (germAlgHom (K := K) l) Q
  have hrw : (fun i : σ => ((fun n => ξ n i : ι → Ω) : Filter.Germ l Ω))
      = fun i : σ => germAlgHom (K := K) l (fun n => ξ n i) := rfl
  rw [hrw, ← hgerm, germAlgHom_apply]
  congr 1
  funext n
  exact hpi n

theorem aeval_germ_eq_zero_iff {m : ℕ} (l : Filter ι) (ξ : ι → Fin m → Ω)
    (Q : MvPolynomial (Fin m) K) :
    MvPolynomial.aeval (fun i : Fin m => ((fun n => ξ n i : ι → Ω) : Filter.Germ l Ω)) Q = 0
      ↔ annihilationSet ξ Q ∈ l := by
  rw [aeval_germ]
  constructor
  · intro h
    have := Filter.Germ.coe_eq.mp (h.trans (Filter.Germ.coe_zero (l := l) (M := Ω)).symm)
    exact this
  · intro h
    refine (Filter.Germ.coe_eq.mpr ?_).trans (Filter.Germ.coe_zero (l := l) (M := Ω))
    exact h

/-! ## The uniform annihilator from an ultraproduct rank bound -/

/-- **Uniform annihilation from ultraproduct rank.**  If in every ultraproduct each of the `d + 1`
germ coordinates is algebraic over the subfield generated by `d` fixed germs, then one nonzero
polynomial in `d + 1` variables annihilates **every** member of the family. -/
theorem exists_uniform_annihilator_of_ultraproduct_rank {ι K Ω : Type*} [Field K] [Field Ω]
    [Algebra K Ω] {d : ℕ} (ξ : ι → Fin (d + 1) → Ω) (b : ι → Fin d → Ω)
    (h : ∀ u : Ultrafilter ι, ∀ i : Fin (d + 1),
      IsAlgebraic ↥(IntermediateField.adjoin K
          (Set.range fun j : Fin d =>
            ((fun n => b n j : ι → Ω) : Filter.Germ (u : Filter ι) Ω)))
        ((fun n => ξ n i : ι → Ω) : Filter.Germ (u : Filter ι) Ω)) :
    ∃ Q : MvPolynomial (Fin (d + 1)) K, Q ≠ 0 ∧ ∀ n : ι, MvPolynomial.aeval (ξ n) Q = 0 := by
  classical
  refine exists_uniform_annihilator ξ fun u => ?_
  have hcard : #(Set.range fun j : Fin d =>
      ((fun n => b n j : ι → Ω) : Filter.Germ (u : Filter ι) Ω)) ≤ (d : Cardinal) := by
    simpa using Cardinal.mk_range_le_lift
      (f := fun j : Fin d => ((fun n => b n j : ι → Ω) : Filter.Germ (u : Filter ι) Ω))
  have hdep := not_algebraicIndependent_of_isAlgebraic_over_adjoin
    (K := K) (L := Filter.Germ (u : Filter ι) Ω) _ hcard
    (fun i : Fin (d + 1) => ((fun n => ξ n i : ι → Ω) : Filter.Germ (u : Filter ι) Ω)) (h u)
  rw [algebraicIndependent_iff_injective_aeval] at hdep
  obtain ⟨Q₁, Q₂, hEq, hne⟩ := Function.not_injective_iff.mp hdep
  refine ⟨Q₁ - Q₂, sub_ne_zero.mpr hne, ?_⟩
  rw [← Ultrafilter.mem_coe, ← aeval_germ_eq_zero_iff, map_sub, hEq, sub_self]

/-- **A family of witnesses with common data gives a witness in the ultraproduct.**  The leading
coefficient survives because it is nonzero at *every* index, so its germ is nonzero along any
ultrafilter. -/
theorem algebraicWitness_germ {ι K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (u : Ultrafilter ι) {σ : Type*} {b : ι → σ → Ω} {y : ι → Ω} {m : ℕ}
    {P : ℕ → MvPolynomial σ K} (hlead : ∀ n : ι, MvPolynomial.aeval (b n) (P m) ≠ 0)
    (hrel : ∀ n : ι, ∑ i ∈ Finset.range (m + 1), MvPolynomial.aeval (b n) (P i) * y n ^ i = 0) :
    AlgebraicWitness K (fun w => ((fun n => b n w : ι → Ω) : Filter.Germ (u : Filter ι) Ω))
      ((fun n => y n : ι → Ω) : Filter.Germ (u : Filter ι) Ω) := by
  classical
  have hpi : ∀ i : ℕ, MvPolynomial.aeval (fun w : σ => (fun n : ι => b n w)) (P i)
      = fun n : ι => MvPolynomial.aeval (b n) (P i) := by
    intro i
    funext n
    have := MvPolynomial.comp_aeval_apply (R := K) (fun w : σ => (fun n : ι => b n w))
      (Pi.evalAlgHom K (fun _ : ι => Ω) n) (P i)
    simpa using this
  have hleadGerm : germAlgHom (K := K) (u : Filter ι)
      (MvPolynomial.aeval (fun w : σ => (fun n : ι => b n w)) (P m)) ≠ 0 := by
    rw [hpi m, germAlgHom_apply]
    intro h0
    have hev : (fun n : ι => MvPolynomial.aeval (b n) (P m)) =ᶠ[(u : Filter ι)] 0 :=
      Filter.Germ.coe_eq.mp (h0.trans (Filter.Germ.coe_zero (l := (u : Filter ι)) (M := Ω)).symm)
    obtain ⟨n, hn⟩ := hev.exists
    exact hlead n hn
  have hrelPi : ∑ i ∈ Finset.range (m + 1),
      MvPolynomial.aeval (fun w : σ => (fun n : ι => b n w)) (P i)
        * (fun n : ι => y n) ^ i = 0 := by
    funext n
    simp only [Finset.sum_apply, Pi.mul_apply, Pi.pow_apply, Pi.zero_apply]
    rw [show (fun i => (MvPolynomial.aeval (fun w : σ => (fun n : ι => b n w)) (P i)) n
        * y n ^ i) = fun i => MvPolynomial.aeval (b n) (P i) * y n ^ i from by
      funext i; rw [hpi i]]
    exact hrel n
  exact algebraicWitness_map_of_leading_ne_zero (K := K)
    (b := fun w : σ => (fun n : ι => b n w)) (y := fun n : ι => y n)
    (germAlgHom (u : Filter ι)) hleadGerm hrelPi

end GaloisForLFunctions.HTGeometry
