import GaloisForLFunctions.HTGeometry.DirichletLeadingTerm
import GaloisForLFunctions.HTGeometry.ShiftJetTower
import Mathlib

/-!
# The rational base of a unit shift

Let `K` be a field over `C` with a `C`-automorphism `sigma` and a transcendental element `x`
satisfying `sigma x = x + 1`.  The subfield `C(x)` is then `sigma`-stable, its `sigma`-invariants
are the constants, and no nonzero rational function vanishing at infinity with poles only at the
origin is a `sigma`-defect of `C(x)`.

These are the three base hypotheses of the jet-tower descent, and they hold for *any* realisation
of the unit shift.  A family `c n` with `c n * x ^ (n + 1)` a nonzero constant supplies the fourth:
the defects are linearly independent over the constants.
-/

open Polynomial

namespace HTGeometry

variable {K : Type*} [Field K] [Algebra ℂ K]

section Coordinate

variable {x : K}

/-- A transcendental coordinate makes polynomial evaluation injective. -/
theorem aeval_coord_injective (hx : Transcendental ℂ x) :
    Function.Injective (fun P : ℂ[X] => Polynomial.aeval x P) := by
  intro P Q h
  by_contra hne
  refine hx ⟨P - Q, sub_ne_zero.mpr hne, ?_⟩
  simp only [map_sub]
  simp only at h
  rw [h, sub_self]

theorem coord_ne_zero (hx : Transcendental ℂ x) : x ≠ 0 := by
  intro h0
  refine hx ⟨Polynomial.X, Polynomial.X_ne_zero, ?_⟩
  simp [h0]

/-- A unit shift of the coordinate becomes the substitution `X ↦ X + 1` on polynomials. -/
theorem sigma_aeval_coord (sigma : K ≃ₐ[ℂ] K) (hsig : sigma x = x + 1) (P : ℂ[X]) :
    sigma (Polynomial.aeval x P) = Polynomial.aeval x (P.comp (X + Polynomial.C 1)) := by
  rw [Polynomial.aeval_comp]
  simp only [map_add, Polynomial.aeval_X, map_one]
  rw [← hsig]
  exact (Polynomial.aeval_algHom_apply (sigma : K →ₐ[ℂ] K) x P).symm

/-- Rescaling by a nonzero constant preserves transcendence. -/
theorem transcendental_const_mul (hx : Transcendental ℂ x) {c : ℂ} (hc : c ≠ 0) :
    Transcendental ℂ (algebraMap ℂ K c * x) := by
  rintro ⟨P, hP0, hP⟩
  have hcomp : ∀ Q : ℂ[X], Polynomial.aeval x (Q.comp (Polynomial.C c * Polynomial.X))
      = Polynomial.aeval (algebraMap ℂ K c * x) Q := by
    intro Q
    rw [Polynomial.aeval_comp]
    simp
  have hne : P.comp (Polynomial.C c * Polynomial.X) ≠ 0 := by
    intro h0
    refine hP0 ?_
    have h1 : (Polynomial.C c * Polynomial.X).comp (Polynomial.C c⁻¹ * Polynomial.X)
        = (Polynomial.X : ℂ[X]) := by
      simp only [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
        ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc, Polynomial.C_1, one_mul]
    have hback : (P.comp (Polynomial.C c * Polynomial.X)).comp
        (Polynomial.C c⁻¹ * Polynomial.X) = P := by
      rw [Polynomial.comp_assoc, h1, Polynomial.comp_X]
    rw [← hback, h0, Polynomial.zero_comp]
  exact hx ⟨P.comp (Polynomial.C c * Polynomial.X), hne, by rw [hcomp P]; exact hP⟩

/-- The rational base generated by the coordinate. -/
noncomputable def coordBase (x : K) : IntermediateField ℂ K := IntermediateField.adjoin ℂ {x}

theorem coord_mem_coordBase : x ∈ coordBase x :=
  IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)

theorem coordBase_map_mem (phi : K ≃+* K)
    (hphiC : ∀ a : ℂ, phi (algebraMap ℂ K a) = algebraMap ℂ K a)
    (hphix : phi x ∈ coordBase x) :
    ∀ t ∈ coordBase x, phi t ∈ coordBase x := by
  intro t ht
  refine IntermediateField.adjoin_induction (F := ℂ)
    (p := fun z _ => phi z ∈ coordBase x) ?_ ?_ ?_ ?_ ?_ ht
  · intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hphix
  · intro a
    rw [hphiC a]
    exact (coordBase x).algebraMap_mem a
  · intro p q _ _ hp hq
    rw [phi.map_add]; exact add_mem hp hq
  · intro p _ hp
    rw [map_inv₀ phi]; exact inv_mem hp
  · intro p q _ _ hp hq
    rw [phi.map_mul]; exact mul_mem hp hq

theorem sigma_symm_coord (sigma : K ≃ₐ[ℂ] K) (hsig : sigma x = x + 1) :
    sigma.symm x = x - 1 := by
  have h : sigma.symm (sigma x) = x := sigma.symm_apply_apply x
  rw [hsig, map_add, map_one] at h
  linear_combination h

/-- **The rational base is shift stable.** -/
theorem coordBase_stable (sigma : K ≃ₐ[ℂ] K) (hsig : sigma x = x + 1) (u : K) :
    sigma u ∈ coordBase x ↔ u ∈ coordBase x := by
  have hfwd := coordBase_map_mem (x := x) (sigma : K ≃+* K)
    (fun a => sigma.commutes a)
    (show sigma x ∈ coordBase x by
      rw [hsig]; exact add_mem coord_mem_coordBase (one_mem _))
  have hbwd := coordBase_map_mem (x := x) (sigma.symm : K ≃+* K)
    (fun a => sigma.symm.commutes a)
    (show sigma.symm x ∈ coordBase x by
      rw [sigma_symm_coord sigma hsig]
      exact sub_mem coord_mem_coordBase (one_mem _))
  refine ⟨fun hu => ?_, fun hu => hfwd u hu⟩
  have hthis : sigma.symm (sigma u) ∈ coordBase x := hbwd _ hu
  rwa [sigma.symm_apply_apply] at hthis

/-- **The shift invariants of the rational base are the constants.** -/
theorem coordBase_fixed_const (hx : Transcendental ℂ x) (sigma : K ≃ₐ[ℂ] K)
    (hsig : sigma x = x + 1) (u : K) (hu : u ∈ coordBase x) (hfix : sigma u = u) :
    ∃ a : ℂ, u = algebraMap ℂ K a := by
  classical
  obtain ⟨N, D, hND⟩ := (IntermediateField.mem_adjoin_simple_iff ℂ u).mp hu
  rcases eq_or_ne D 0 with rfl | hD0
  · exact ⟨0, by simpa using hND⟩
  have hinj := aeval_coord_injective hx
  have hDK : Polynomial.aeval x D ≠ 0 := fun h => hD0 (hinj (by simpa using h))
  have hDsK : Polynomial.aeval x (D.comp (X + Polynomial.C 1)) ≠ 0 := by
    intro h
    have hz : sigma (Polynomial.aeval x D) = 0 := by
      rw [sigma_aeval_coord sigma hsig]; exact h
    exact hDK (by simpa using congrArg sigma.symm hz)
  have hNK : Polynomial.aeval x (N.comp (X + Polynomial.C 1)) * Polynomial.aeval x D
      = Polynomial.aeval x N * Polynomial.aeval x (D.comp (X + Polynomial.C 1)) := by
    have hsu : sigma u = Polynomial.aeval x (N.comp (X + Polynomial.C 1))
        / Polynomial.aeval x (D.comp (X + Polynomial.C 1)) := by
      rw [hND, map_div₀, sigma_aeval_coord sigma hsig, sigma_aeval_coord sigma hsig]
    rw [hsu, hND] at hfix
    field_simp at hfix
    linear_combination hfix
  have hpoly : (N.comp (X + Polynomial.C 1)) * D = N * (D.comp (X + Polynomial.C 1)) := by
    apply hinj
    simpa using hNK
  simp only [Polynomial.C_1] at hpoly
  obtain ⟨a, ha⟩ := eq_const_mul_of_shift_ratio_fixed hD0 hpoly
  refine ⟨a, ?_⟩
  rw [hND, ha, map_mul, Polynomial.aeval_C]
  field_simp

end Coordinate

section Defects

variable {x : K} {c : ℕ → K} {k : ℕ → ℂ}

/-- Every defect is a constant multiple of a power of the inverse coordinate. -/
theorem defect_eq_const_mul_inv_pow (hx : Transcendental ℂ x)
    (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n)) (n : ℕ) :
    c n = algebraMap ℂ K (k n) * (x⁻¹) ^ (n + 1) := by
  have hx0 : x ≠ 0 := coord_ne_zero hx
  have hxp : x ^ (n + 1) ≠ 0 := pow_ne_zero _ hx0
  have hinv : (x⁻¹) ^ (n + 1) * x ^ (n + 1) = 1 := by
    rw [← mul_pow, inv_mul_cancel₀ hx0, one_pow]
  calc c n = c n * (x ^ (n + 1) * (x⁻¹) ^ (n + 1)) := by
        rw [mul_comm (x ^ (n + 1)), hinv, mul_one]
    _ = (c n * x ^ (n + 1)) * (x⁻¹) ^ (n + 1) := by ring
    _ = algebraMap ℂ K (k n) * (x⁻¹) ^ (n + 1) := by rw [hc n]

theorem defect_mem_coordBase (hx : Transcendental ℂ x)
    (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n)) (n : ℕ) :
    c n ∈ coordBase x := by
  rw [defect_eq_const_mul_inv_pow hx hc n]
  exact mul_mem ((coordBase x).algebraMap_mem _) (pow_mem (inv_mem coord_mem_coordBase) _)

/-- **The defects are linearly independent over the constants.**  Scaling a dependence relation by
`x ^ (n+1)` turns it into a polynomial identity with nonzero constant term. -/
theorem defect_not_mem_span (hx : Transcendental ℂ x) (hk : ∀ n, k n ≠ 0)
    (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n)) (n : ℕ) :
    c n ∉ defectSpan c n := by
  classical
  intro hmem
  set Q : K → Prop := fun z =>
    ∃ p : ℂ[X], p.coeff 0 = 0 ∧ z * x ^ (n + 1) = Polynomial.aeval x p with hQ
  have hspan : Q (c n) := by
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
    · rintro z ⟨j, hj, rfl⟩
      refine ⟨Polynomial.C (k j) * Polynomial.X ^ (n - j), ?_, ?_⟩
      · have hnj : n - j ≠ 0 := by
          simp only [Set.mem_Iio] at hj
          omega
        simp [Polynomial.coeff_X_pow, Ne.symm hnj]
      · simp only [Set.mem_Iio] at hj
        have hsplit : (n : ℕ) + 1 = (j + 1) + (n - j) := by omega
        rw [hsplit, pow_add, ← mul_assoc, hc j]
        simp [Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
    · exact ⟨0, by simp, by simp⟩
    · rintro z w - - ⟨pz, hpz0, hpz⟩ ⟨pw, hpw0, hpw⟩
      exact ⟨pz + pw, by simp [hpz0, hpw0], by rw [add_mul, hpz, hpw, map_add]⟩
    · rintro a z - ⟨pz, hpz0, hpz⟩
      refine ⟨Polynomial.C a * pz, by simp [hpz0], ?_⟩
      rw [Algebra.smul_def, mul_assoc, hpz, map_mul, Polynomial.aeval_C]
  obtain ⟨p, hp0, hp⟩ := hspan
  rw [hc n] at hp
  have hne : p - Polynomial.C (k n) ≠ 0 := by
    intro h0
    have := congrArg (fun q : ℂ[X] => q.coeff 0) h0
    simp [hp0] at this
    exact hk n this
  refine hx ⟨p - Polynomial.C (k n), hne, ?_⟩
  rw [map_sub, ← hp, Polynomial.aeval_C, sub_self]

/-- Every element of the defect span is `q(x) / x ^ m` with `deg q < m`. -/
theorem defectSpan_shape (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n))
    {v : K} (hv : v ∈ defectSpanAll c) :
    ∃ (m : ℕ) (q : ℂ[X]), q.natDegree < m ∧ v * x ^ m = Polynomial.aeval x q := by
  classical
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
  · rintro z ⟨j, rfl⟩
    exact ⟨j + 1, Polynomial.C (k j), by simp, by rw [hc j, Polynomial.aeval_C]⟩
  · exact ⟨1, 0, by simp, by simp⟩
  · rintro z w - - ⟨m1, q1, hq1, hz⟩ ⟨m2, q2, hq2, hw⟩
    refine ⟨max m1 m2, q1 * Polynomial.X ^ (max m1 m2 - m1)
      + q2 * Polynomial.X ^ (max m1 m2 - m2), ?_, ?_⟩
    · refine lt_of_le_of_lt (Polynomial.natDegree_add_le _ _) ?_
      refine max_lt ?_ ?_
      · refine lt_of_le_of_lt (Polynomial.natDegree_mul_le) ?_
        rw [Polynomial.natDegree_X_pow]
        have := le_max_left m1 m2
        omega
      · refine lt_of_le_of_lt (Polynomial.natDegree_mul_le) ?_
        rw [Polynomial.natDegree_X_pow]
        have := le_max_right m1 m2
        omega
    · have h1 : max m1 m2 = m1 + (max m1 m2 - m1) := by have := le_max_left m1 m2; omega
      have h2 : max m1 m2 = m2 + (max m1 m2 - m2) := by have := le_max_right m1 m2; omega
      rw [map_add, map_mul, map_mul, Polynomial.aeval_X_pow, Polynomial.aeval_X_pow,
        ← hz, ← hw, add_mul]
      rw [show x ^ max m1 m2 = x ^ m1 * x ^ (max m1 m2 - m1) by rw [← pow_add, ← h1]]
      nth_rewrite 2 [show x ^ m1 * x ^ (max m1 m2 - m1)
        = x ^ m2 * x ^ (max m1 m2 - m2) by rw [← pow_add, ← pow_add, ← h1, ← h2]]
      ring
  · rintro a z - ⟨m, q, hq, hz⟩
    refine ⟨m, Polynomial.C a * q, ?_, ?_⟩
    · exact lt_of_le_of_lt (le_trans Polynomial.natDegree_mul_le (by simp)) hq
    · rw [map_mul, Polynomial.aeval_C, ← hz, Algebra.smul_def]
      ring

/-- **No nonzero defect is a shift defect of the rational base.** -/
theorem coordBase_defect_eq_zero (hx : Transcendental ℂ x)
    (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n))
    (sigma : K ≃ₐ[ℂ] K) (hsig : sigma x = x + 1)
    (u : K) (hu : u ∈ coordBase x) (v : K) (hv : v ∈ defectSpanAll c)
    (hduv : sigma u - u = v) : v = 0 := by
  classical
  obtain ⟨m, q, hqdeg, hvq⟩ := defectSpan_shape hc hv
  obtain ⟨N, D, hND⟩ := (IntermediateField.mem_adjoin_simple_iff ℂ u).mp hu
  have hinj := aeval_coord_injective hx
  have hcm : x ^ m ≠ 0 := pow_ne_zero _ (coord_ne_zero hx)
  rcases eq_or_ne D 0 with rfl | hD0
  · rw [show u = 0 by simpa using hND] at hduv
    simp at hduv
    exact hduv.symm
  rcases eq_or_ne N 0 with rfl | hN0
  · rw [show u = 0 by simpa using hND] at hduv
    simp at hduv
    exact hduv.symm
  have hDK : Polynomial.aeval x D ≠ 0 := fun h => hD0 (hinj (by simpa using h))
  have hDsK : Polynomial.aeval x (D.comp (X + Polynomial.C 1)) ≠ 0 := by
    intro h
    have hz : sigma (Polynomial.aeval x D) = 0 := by
      rw [sigma_aeval_coord sigma hsig]; exact h
    exact hDK (by simpa using congrArg sigma.symm hz)
  have hsu : sigma u = Polynomial.aeval x (N.comp (X + Polynomial.C 1))
      / Polynomial.aeval x (D.comp (X + Polynomial.C 1)) := by
    rw [hND, map_div₀, sigma_aeval_coord sigma hsig, sigma_aeval_coord sigma hsig]
  rw [hsu, hND] at hduv
  have hfield : Polynomial.aeval x
        ((N.comp (X + Polynomial.C 1) * D - N * D.comp (X + Polynomial.C 1))
          * Polynomial.X ^ m)
      = Polynomial.aeval x (q * (D.comp (X + Polynomial.C 1) * D)) := by
    simp only [map_mul, map_sub, Polynomial.aeval_X_pow]
    have hvv : v = Polynomial.aeval x (N.comp (X + Polynomial.C 1))
          * Polynomial.aeval x D
          / (Polynomial.aeval x (D.comp (X + Polynomial.C 1)) * Polynomial.aeval x D)
        - Polynomial.aeval x N * Polynomial.aeval x (D.comp (X + Polynomial.C 1))
          / (Polynomial.aeval x (D.comp (X + Polynomial.C 1)) * Polynomial.aeval x D) := by
      rw [← hduv]; field_simp
    rw [hvv] at hvq
    field_simp at hvq
    linear_combination hvq
  have hpoly : (N.comp (X + Polynomial.C 1) * D - N * D.comp (X + Polynomial.C 1))
      * Polynomial.X ^ m = q * (D.comp (X + Polynomial.C 1) * D) := hinj hfield
  simp only [Polynomial.C_1] at hpoly
  have hq0 : q = 0 := by
    by_contra hqne
    obtain ⟨A', B', hmon, hcop, hid'⟩ :=
      exists_coprime_monic_shift_identity (rd := Polynomial.X ^ m) (rn := q) hN0 hD0 hpoly
    exact no_rational_shift_antiderivative hmon hcop hqne hqdeg hid'
  rw [hq0, map_zero] at hvq
  exact (mul_eq_zero.mp hvq).resolve_right hcm

end Defects

/-- **Unit-shift jet transcendence over the rational base.**  A jet family whose shift defects are
constant multiples of inverse powers of the coordinate is free over `C(x)`: every jet is
transcendental over the field generated by its predecessors. -/
theorem coordBase_jetTower_transcendental {x : K} {c y : ℕ → K} {k : ℕ → ℂ}
    (hx : Transcendental ℂ x) (hk : ∀ n, k n ≠ 0)
    (hc : ∀ n, c n * x ^ (n + 1) = algebraMap ℂ K (k n))
    (sigma : K ≃ₐ[ℂ] K) (hsig : sigma x = x + 1)
    (hy : ∀ n, sigma (y n) = y n + c n) (n : ℕ) :
    Transcendental (jetTower (coordBase x) y n) (y n) :=
  jetTower_transcendental sigma (coordBase x) y c
    (coordBase_stable sigma hsig)
    (defect_mem_coordBase hx hc) hy
    (coordBase_fixed_const hx sigma hsig)
    (fun u hu v hv hduv => coordBase_defect_eq_zero hx hc sigma hsig u hu v hv hduv)
    (defect_not_mem_span hx hk hc) n

end HTGeometry
