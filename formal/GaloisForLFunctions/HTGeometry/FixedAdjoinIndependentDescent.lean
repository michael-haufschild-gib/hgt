import GaloisForLFunctions.HTGeometry.SemilinearCircuitDescent
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# Invariants of a field generated by fixed independent elements

Let `E → K` be a field extension and `y` a family in `K`, algebraically independent over `E`.
Let a family of automorphisms `σ_i` of `K` restrict to automorphisms `τ_i` of `E` and fix every
`y_j`.  Then every `σ`-invariant element of `E(y)` is a quotient `P(y)/Q(y)` of polynomials whose
coefficients are fixed by every `τ_i`: `E(y)^σ = E^τ(y)`.

The relations `P(y) = u Q(y)` form an `E`-subspace of pairs of coefficient vectors which is stable
under the coordinatewise action of the `τ_i`, and the least-support descent theorem produces a
nonzero fixed relation; algebraic independence forces its denominator to be nonzero.  No
finiteness of the group and no Galois correspondence is used.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {E K : Type*} [Field E] [Field K] [Algebra E K] {ι : Type*} {y : ι → K}
  {I : Type*} (σ : I → K ≃+* K) (τ : I → E ≃+* E)

/-- Polynomials are their coefficient vectors. -/
def finsuppMvPolynomialLinearEquiv (R : Type*) [CommSemiring R] (ι : Type*) :
    ((ι →₀ ℕ) →₀ R) ≃ₗ[R] MvPolynomial ι R :=
  (AddMonoidAlgebra.coeffLinearEquiv R).symm

theorem coeff_finsuppMvPolynomialLinearEquiv (R : Type*) [CommSemiring R] (ι : Type*)
    (v : (ι →₀ ℕ) →₀ R) (m : ι →₀ ℕ) :
    MvPolynomial.coeff m (finsuppMvPolynomialLinearEquiv R ι v) = v m := rfl

/-- An automorphism compatible with the coefficient action and fixing the variables commutes
with polynomial evaluation. -/
theorem ringEquiv_aeval_of_compatible
    (hστ : ∀ i a, σ i (algebraMap E K a) = algebraMap E K (τ i a))
    (hσy : ∀ i j, σ i (y j) = y j) (i : I) (P : MvPolynomial ι E) :
    σ i (aeval y P) = aeval y (P.map (τ i : E →+* E)) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [hστ]
  | add p q hp hq => simp [hp, hq]
  | mul_X p j hp => simp [hp, hσy]

/-- **Invariant elements of `E(y)` have invariant coefficients.** -/
theorem exists_fixed_fraction_of_fixed
    (hy : AlgebraicIndependent E y)
    (hστ : ∀ i a, σ i (algebraMap E K a) = algebraMap E K (τ i a))
    (hσy : ∀ i j, σ i (y j) = y j) {u : K}
    (hu : u ∈ IntermediateField.adjoin E (Set.range y)) (hfix : ∀ i, σ i u = u) :
    ∃ P Q : MvPolynomial ι E, (∀ i, P.map (τ i : E →+* E) = P) ∧
      (∀ i, Q.map (τ i : E →+* E) = Q) ∧ aeval y Q ≠ 0 ∧ u = aeval y P / aeval y Q := by
  classical
  by_cases hu0 : u = 0
  · exact ⟨0, 1, fun i => by simp, fun i => by simp, by simp, by simp [hu0]⟩
  obtain ⟨r, hr, s, hs, hrs⟩ := IntermediateField.mem_adjoin_iff_div.mp hu
  rw [Algebra.adjoin_range_eq_range_aeval] at hr hs
  obtain ⟨P₁, rfl⟩ := hr
  obtain ⟨Q₁, rfl⟩ := hs
  change u = aeval y P₁ / aeval y Q₁ at hrs
  have hs0 : aeval y Q₁ ≠ 0 := by
    intro h
    apply hu0
    rw [hrs, h, div_zero]
  -- the relation space `P(y) = u Q(y)`, as pairs of coefficient vectors
  let e : ((ι →₀ ℕ) ⊕ (ι →₀ ℕ) →₀ E) ≃ₗ[E] MvPolynomial ι E × MvPolynomial ι E :=
    (Finsupp.sumFinsuppLEquivProdFinsupp E).trans
      (LinearEquiv.prodCongr (finsuppMvPolynomialLinearEquiv E ι)
        (finsuppMvPolynomialLinearEquiv E ι))
  let rel : ((ι →₀ ℕ) ⊕ (ι →₀ ℕ) →₀ E) →ₗ[E] K :=
    ((aeval y : MvPolynomial ι E →ₐ[E] K).toLinearMap.comp (LinearMap.fst E _ _) -
      u • (aeval y : MvPolynomial ι E →ₐ[E] K).toLinearMap.comp (LinearMap.snd E _ _)).comp
        e.toLinearMap
  let W : Submodule E ((ι →₀ ℕ) ⊕ (ι →₀ ℕ) →₀ E) := LinearMap.ker rel
  have hmemW : ∀ v, v ∈ W ↔ aeval y (e v).1 = u * aeval y (e v).2 := by
    intro v
    change rel v = 0 ↔ _
    simp only [rel, LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.fst_apply, LinearMap.snd_apply, AlgHom.toLinearMap_apply, smul_eq_mul,
      LinearEquiv.coe_coe, sub_eq_zero]
  have hmap : ∀ i v, e (finsuppMapRangeRingEquiv τ i v) =
      ((e v).1.map (τ i : E →+* E), (e v).2.map (τ i : E →+* E)) := by
    intro i v
    ext m
    · change MvPolynomial.coeff m (finsuppMvPolynomialLinearEquiv E ι
          ((Finsupp.sumFinsuppLEquivProdFinsupp E (finsuppMapRangeRingEquiv τ i v)).1)) =
        MvPolynomial.coeff m ((finsuppMvPolynomialLinearEquiv E ι
          (Finsupp.sumFinsuppLEquivProdFinsupp E v).1).map (τ i : E →+* E))
      rw [coeff_finsuppMvPolynomialLinearEquiv, MvPolynomial.coeff_map,
        coeff_finsuppMvPolynomialLinearEquiv]
      simp [Finsupp.sumFinsuppLEquivProdFinsupp]
    · change MvPolynomial.coeff m (finsuppMvPolynomialLinearEquiv E ι
          ((Finsupp.sumFinsuppLEquivProdFinsupp E (finsuppMapRangeRingEquiv τ i v)).2)) =
        MvPolynomial.coeff m ((finsuppMvPolynomialLinearEquiv E ι
          (Finsupp.sumFinsuppLEquivProdFinsupp E v).2).map (τ i : E →+* E))
      rw [coeff_finsuppMvPolynomialLinearEquiv, MvPolynomial.coeff_map,
        coeff_finsuppMvPolynomialLinearEquiv]
      simp [Finsupp.sumFinsuppLEquivProdFinsupp]
  have hstable : ∀ i v, v ∈ W → finsuppMapRangeRingEquiv τ i v ∈ W := by
    intro i v hv
    rw [hmemW] at hv ⊢
    rw [hmap]
    change aeval y ((e v).1.map (τ i : E →+* E)) = u * aeval y ((e v).2.map (τ i : E →+* E))
    rw [← ringEquiv_aeval_of_compatible σ τ hστ hσy, ← ringEquiv_aeval_of_compatible σ τ hστ hσy,
      hv, map_mul, hfix]
  have hW0 : W ≠ ⊥ := by
    intro hbot
    have hmem : e.symm (P₁, Q₁) ∈ W := by
      rw [hmemW, LinearEquiv.apply_symm_apply, hrs]
      field_simp
    rw [hbot, Submodule.mem_bot, LinearEquiv.map_eq_zero_iff] at hmem
    apply hs0
    rw [show Q₁ = 0 from congrArg Prod.snd hmem, map_zero]
  obtain ⟨v, hvW, hv0, hvfix⟩ := stable_finsupp_submodule_exists_nonzero_fixed τ W hstable hW0
  have hrel := (hmemW v).mp hvW
  have hQ0 : aeval y (e v).2 ≠ 0 := by
    intro hQ
    rw [hQ, mul_zero] at hrel
    have hP : (e v).1 = 0 := hy (by rw [hrel, map_zero])
    have hQ' : (e v).2 = 0 := hy (by rw [hQ, map_zero])
    apply hv0
    apply e.injective
    rw [map_zero]
    exact Prod.ext hP hQ'
  have hfixe : ∀ i, ((e v).1.map (τ i : E →+* E), (e v).2.map (τ i : E →+* E)) = e v := by
    intro i
    rw [← hmap, hvfix i]
  refine ⟨(e v).1, (e v).2, fun i => congrArg Prod.fst (hfixe i),
    fun i => congrArg Prod.snd (hfixe i), hQ0, ?_⟩
  rw [eq_div_iff hQ0]
  exact hrel.symm

end

end GaloisForLFunctions.HTGeometry
