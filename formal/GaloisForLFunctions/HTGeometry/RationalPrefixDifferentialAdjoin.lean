import GaloisForLFunctions.HTGeometry.RadicalDifferentialAdjoin

/-!
# The differential field of an element over the differential field of a rational map of it

Let `E` be a differential field whose coefficient field `C` consists of constants, let `g` be an
element and let `P / Q` be a rational map that is not critical at `g`, that is whose Wronskian
`P'Q - PQ'` does not vanish there.  The chain rule expresses `g′` as a rational function of `g` and
of the derivative of `u = P(g)/Q(g)`, so the field obtained by adjoining `g` to the differential
field generated by `u` is already closed under the derivation.  Consequently the differential field
generated by `g` sits inside a single algebraic adjunction, of degree at most the degree of the
rational map.

This is the field-theoretic content of one step of a rational protocol: the prefix pullback is the
differential field of the image point, the extension is finite and generated by the source point
alone, and its degree is bounded by the degree of the map.  The radical case `P = X ^ N`, `Q = 1`,
is the multiplication-by-`N` isogeny.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open IntermediateField Polynomial

noncomputable section

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E]

/-- The derivation of a differential field, read over a coefficient field of constants. -/
def constDerivation (hC : ∀ c : C, (algebraMap C E c)′ = 0) : Derivation C E E :=
  Derivation.mk'
    { toFun := fun x => x′
      map_add' := fun x y => map_add Differential.deriv x y
      map_smul' := fun c x => by
        show (c • x)′ = c • x′
        rw [Algebra.smul_def, Derivation.leibniz, hC c, smul_zero, add_zero]
        simp [Algebra.smul_def] }
    (fun a b => Differential.deriv.leibniz a b)

omit [Differential C] [DifferentialAlgebra C E] in
@[simp] theorem constDerivation_apply (hC : ∀ c : C, (algebraMap C E c)′ = 0) (x : E) :
    constDerivation (E := E) hC x = x′ := rfl

omit [Differential C] [DifferentialAlgebra C E] in
/-- **The chain rule for polynomial evaluation.** -/
theorem deriv_aeval (hC : ∀ c : C, (algebraMap C E c)′ = 0) (g : E) (P : Polynomial C) :
    (Polynomial.aeval g P)′ = Polynomial.aeval g (derivative P) * g′ :=
  (constDerivation (E := E) hC).map_aeval P g

omit [Differential C] [Differential E] [DifferentialAlgebra C E] in
/-- Evaluating a polynomial with coefficients in the base at a generator stays inside the simple
adjunction of that generator over any intermediate field. -/
theorem aeval_mem_adjoin_simple (F : IntermediateField C E) (g : E) (p : Polynomial C) :
    Polynomial.aeval g p ∈ IntermediateField.adjoin (↥F) ({g} : Set E) := by
  have hg : g ∈ IntermediateField.adjoin (↥F) ({g} : Set E) :=
    IntermediateField.subset_adjoin _ _ rfl
  have hconst : ∀ a : C, algebraMap C E a ∈ IntermediateField.adjoin (↥F) ({g} : Set E) := by
    intro a
    have hstep : algebraMap C E a = algebraMap (↥F) E (algebraMap C (↥F) a) := by
      rw [← IsScalarTower.algebraMap_apply]
    rw [hstep]
    exact IntermediateField.algebraMap_mem _ _
  induction p using Polynomial.induction_on with
  | C a =>
      rw [Polynomial.aeval_C]
      exact hconst a
  | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
  | monomial n a _ =>
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      exact mul_mem (hconst a) (pow_mem hg _)

/-- The value of the rational map `P / Q` at an element. -/
def ratMapEval (P Q : Polynomial C) (g : E) : E :=
  Polynomial.aeval g P / Polynomial.aeval g Q

/-- The Wronskian `P'Q - P Q'` of a rational map at an element: it vanishes exactly when the map is
critical there. -/
def ratMapWronskian (P Q : Polynomial C) (g : E) : E :=
  Polynomial.aeval g (derivative P) * Polynomial.aeval g Q
    - Polynomial.aeval g P * Polynomial.aeval g (derivative Q)

omit [Differential C] [DifferentialAlgebra C E] in
/-- **The chain rule for a rational map.** -/
theorem deriv_ratMapEval (hC : ∀ c : C, (algebraMap C E c)′ = 0) {P Q : Polynomial C} {g : E} :
    (ratMapEval P Q g)′ = ratMapWronskian P Q g * (Polynomial.aeval g Q)⁻¹ ^ 2 * g′ := by
  rw [ratMapEval, Derivation.leibniz_div]
  simp only [smul_eq_mul]
  rw [deriv_aeval hC, deriv_aeval hC, ratMapWronskian]
  ring

/-- **Adjoining an element to the differential field of a noncritical rational map of it is
derivation closed.** -/
theorem derivationClosed_adjoin_of_ratMapEval (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0) :
    DerivationClosed (IntermediateField.adjoin
      (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) ({g} : Set E)) := by
  classical
  set u : E := ratMapEval P Q g with hu
  set B : IntermediateField C E := differentialAdjoin C ({u} : Set E) with hB
  letI : Differential ↥B :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C _)
  letI : DifferentialAlgebra ↥B E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C ({u} : Set E)) c⟩
  have hrange : ({g} : Set E) = Set.range (fun _ : Unit => g) := by simp
  rw [hrange]
  refine derivationClosed_adjoin_range_of_deriv_mem (fun _ : Unit => g) ?_
  intro _
  have hubase : u′ ∈ B :=
    derivationClosed_differentialAdjoin C _ (subset_differentialAdjoin C _ rfl)
  have hsolve : g′ = u′ * (ratMapWronskian P Q g)⁻¹ * Polynomial.aeval g Q ^ 2 := by
    rw [hu, deriv_ratMapEval hC]
    field_simp
  rw [hsolve]
  have hgmem : g ∈ IntermediateField.adjoin (↥B) (Set.range fun _ : Unit => g) :=
    IntermediateField.subset_adjoin _ _ ⟨(), rfl⟩
  have hpoly : ∀ p : Polynomial C, Polynomial.aeval g p
      ∈ IntermediateField.adjoin (↥B) (Set.range fun _ : Unit => g) := by
    intro p
    have := aeval_mem_adjoin_simple B g p
    rwa [hrange] at this
  refine mul_mem (mul_mem ?_ ?_) ?_
  · exact IntermediateField.algebraMap_mem
      (IntermediateField.adjoin (↥B) (Set.range fun _ : Unit => g)) (⟨u′, hubase⟩ : ↥B)
  · refine inv_mem (sub_mem (mul_mem (hpoly _) (hpoly _)) (mul_mem (hpoly _) (hpoly _)))
  · exact pow_mem (hpoly Q) 2

/-- **The differential field of an element sits in a single algebraic adjunction of the differential
field of a noncritical rational map of it.**  Every jet lies in the adjunction, by induction from
derivation closedness. -/
theorem differentialAdjoin_le_adjoin_ratMapEval (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0) :
    differentialAdjoin C ({g} : Set E) ≤
      ((↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))⟮g⟯).restrictScalars C := by
  rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
  rintro y ⟨x, hx, n, rfl⟩
  have hxg : x = g := hx
  rw [hxg]
  show differentialJet n g ∈ (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))⟮g⟯
  induction n with
  | zero => simpa using IntermediateField.mem_adjoin_simple_self _ g
  | succ n ih =>
      rw [differentialJet_succ]
      exact derivationClosed_adjoin_of_ratMapEval hC hQ hW ih

/-- The annihilating polynomial of the source point over the differential field of its image. -/
def ratMapAnnihilator (P Q : Polynomial C)
    (B : IntermediateField C E) (u : ↥B) : Polynomial ↥B :=
  P.map (algebraMap C ↥B) - Polynomial.C u * Q.map (algebraMap C ↥B)

omit [Differential C] [Differential E] [DifferentialAlgebra C E] in
theorem aeval_ratMapAnnihilator {P Q : Polynomial C} {g : E}
    (B : IntermediateField C E) (u : ↥B) :
    Polynomial.aeval g (ratMapAnnihilator P Q B u)
      = Polynomial.aeval g P - (u : E) * Polynomial.aeval g Q := by
  rw [ratMapAnnihilator, map_sub, map_mul, Polynomial.aeval_map_algebraMap,
    Polynomial.aeval_map_algebraMap, Polynomial.aeval_C]
  rfl

omit [Differential C] [Differential E] [DifferentialAlgebra C E] in
theorem natDegree_ratMapAnnihilator_le (P Q : Polynomial C)
    (B : IntermediateField C E) (u : ↥B) :
    (ratMapAnnihilator P Q B u).natDegree ≤ max P.natDegree Q.natDegree := by
  refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le_max ?_ ?_)
  · exact Polynomial.natDegree_map_le
  · exact le_trans (Polynomial.natDegree_C_mul_le u (Q.map (algebraMap C ↥B)))
      Polynomial.natDegree_map_le

omit [Differential C] [Differential E] [DifferentialAlgebra C E] in
/-- A noncritical rational map has a nonzero annihilating polynomial: if it vanished identically the
Wronskian would vanish too. -/
theorem ratMapAnnihilator_ne_zero {P Q : Polynomial C} {g : E}
    (B : IntermediateField C E) (u : ↥B) (hW : ratMapWronskian P Q g ≠ 0) :
    ratMapAnnihilator P Q B u ≠ 0 := by
  intro h
  have hmap : P.map (algebraMap C ↥B) = Polynomial.C u * Q.map (algebraMap C ↥B) := by
    rw [ratMapAnnihilator, sub_eq_zero] at h
    exact h
  have hderiv : (derivative P).map (algebraMap C ↥B)
      = Polynomial.C u * (derivative Q).map (algebraMap C ↥B) := by
    have := congrArg derivative hmap
    rwa [Polynomial.derivative_map, Polynomial.derivative_C_mul,
      Polynomial.derivative_map] at this
  have hval : ∀ p : Polynomial C, ∀ r : Polynomial C,
      p.map (algebraMap C ↥B) = Polynomial.C u * r.map (algebraMap C ↥B) →
      Polynomial.aeval g p = (u : E) * Polynomial.aeval g r := by
    intro p r hpr
    have := congrArg (Polynomial.aeval g) hpr
    rwa [Polynomial.aeval_map_algebraMap, map_mul, Polynomial.aeval_C,
      Polynomial.aeval_map_algebraMap] at this
  have e1 : Polynomial.aeval g P = (u : E) * Polynomial.aeval g Q := hval P Q hmap
  have e2 : Polynomial.aeval g (derivative P) = (u : E) * Polynomial.aeval g (derivative Q) :=
    hval _ _ hderiv
  apply hW
  rw [ratMapWronskian, e1, e2]
  ring

omit [Differential C] [DifferentialAlgebra C E] in
/-- **The degree bound of a rational prefix.**  Adjoining the source point to the differential field
of its image has degree at most the degree of the rational map. -/
theorem finrank_adjoin_ratMapEval_le
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0) :
    Module.finrank (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))
        (↥((↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))⟮g⟯))
      ≤ max P.natDegree Q.natDegree := by
  classical
  set u : E := ratMapEval P Q g with hu
  set B : IntermediateField C E := differentialAdjoin C ({u} : Set E) with hB
  have humem : u ∈ B := subset_differentialAdjoin C _ rfl
  set ub : ↥B := ⟨u, humem⟩ with hub
  set p : Polynomial ↥B := ratMapAnnihilator P Q B ub with hp
  have hp0 : p ≠ 0 := ratMapAnnihilator_ne_zero (g := g) B ub hW
  have hroot : Polynomial.aeval g p = 0 := by
    rw [hp, aeval_ratMapAnnihilator]
    show Polynomial.aeval g P - u * Polynomial.aeval g Q = 0
    rw [hu, ratMapEval, div_mul_cancel₀ _ hQ, sub_self]
  have halg : IsAlgebraic (↥B) g := ⟨p, hp0, hroot⟩
  have hint : IsIntegral (↥B) g := halg.isIntegral
  rw [IntermediateField.adjoin.finrank hint]
  refine le_trans (Polynomial.natDegree_le_natDegree
    (minpoly.degree_le_of_ne_zero (↥B) g hp0 hroot)) ?_
  exact natDegree_ratMapAnnihilator_le P Q B ub

/-- **A rational generator of the whole field.**  If the source point generates the ambient
differential field, adjoining it to the differential field of its image is everything. -/
theorem adjoin_ratMapEval_eq_top (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0)
    (htop : differentialAdjoin C ({g} : Set E) = ⊤) :
    (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))⟮g⟯ = ⊤ := by
  have hle := differentialAdjoin_le_adjoin_ratMapEval hC hQ hW
  rw [htop] at hle
  have hres :
      ((↥(differentialAdjoin C ({ratMapEval P Q g} : Set E)))⟮g⟯).restrictScalars C = ⊤ :=
    top_le_iff.mp hle
  refine IntermediateField.restrictScalars_injective C ?_
  rw [hres, IntermediateField.restrictScalars_top]

/-- **The prefix degree bound.**  For a generator of the whole differential field the ambient field
has degree at most the degree of the rational map over the differential field of the image point. -/
theorem finrank_differentialAdjoin_ratMapEval_le (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0)
    (htop : differentialAdjoin C ({g} : Set E) = ⊤) :
    Module.finrank (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) E
      ≤ max P.natDegree Q.natDegree := by
  have hb := finrank_adjoin_ratMapEval_le hQ hW
  rw [adjoin_ratMapEval_eq_top hC hQ hW htop] at hb
  rwa [IntermediateField.finrank_top'] at hb

/-- The ambient field is finite dimensional over the differential field of the image point. -/
theorem finiteDimensional_differentialAdjoin_ratMapEval (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0)
    (htop : differentialAdjoin C ({g} : Set E) = ⊤) :
    FiniteDimensional (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) E := by
  classical
  set u : E := ratMapEval P Q g with hu
  set B : IntermediateField C E := differentialAdjoin C ({u} : Set E) with hB
  have humem : u ∈ B := subset_differentialAdjoin C _ rfl
  set ub : ↥B := ⟨u, humem⟩ with hub
  set p : Polynomial ↥B := ratMapAnnihilator P Q B ub with hp
  have hp0 : p ≠ 0 := ratMapAnnihilator_ne_zero (g := g) B ub hW
  have hroot : Polynomial.aeval g p = 0 := by
    rw [hp, aeval_ratMapAnnihilator]
    show Polynomial.aeval g P - u * Polynomial.aeval g Q = 0
    rw [hu, ratMapEval, div_mul_cancel₀ _ hQ, sub_self]
  have halg : IsAlgebraic (↥B) g := ⟨p, hp0, hroot⟩
  have hint : IsIntegral (↥B) g := halg.isIntegral
  have hfd : FiniteDimensional (↥B) (↥((↥B)⟮g⟯)) :=
    IntermediateField.adjoin.finiteDimensional hint
  rw [adjoin_ratMapEval_eq_top hC hQ hW htop] at hfd
  exact (IntermediateField.topEquiv.toLinearEquiv).finiteDimensional

end

end GaloisForLFunctions.HTGeometry
