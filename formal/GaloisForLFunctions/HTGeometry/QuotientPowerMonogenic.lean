import GaloisForLFunctions.HTGeometry.ProductMonogenic
import Mathlib.RingTheory.Artinian.Module

/-!
# From the local factors to the whole algebra

An Artinian ring is the product of the quotients by the powers of its maximal ideals.  Each factor
`R/Iⁿ` is local with nilpotent maximal ideal `I/Iⁿ`, so if that maximal ideal is principal the factor
is generated by one element, and the product step assembles the generators into one.

The result is the criterion the model needs: a finite-dimensional commutative algebra over a field of
characteristic zero whose local factors have principal maximal ideals is generated by a single
element.
-/

namespace GaloisForLFunctions.HTGeometry

open IsLocalRing

/-! ## The quotient by a power of a maximal ideal -/

section QuotientPow

variable {R : Type*} [CommRing R] (I : Ideal R) [hI : I.IsMaximal] {n : ℕ}

theorem quotientPow_nontrivial (hn : 0 < n) : Nontrivial (R ⧸ I ^ n) := by
  have hne : I ^ n ≠ ⊤ := by
    intro htop
    exact hI.ne_top (top_le_iff.mp (htop ▸ Ideal.pow_le_self hn.ne'))
  refine ⟨⟨0, 1, ?_⟩⟩
  intro h
  refine hne ((Ideal.eq_top_iff_one _).mpr ?_)
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_one]
  exact h.symm

theorem isNilpotent_mk_of_mem (hn : 0 < n) {a : R} (ha : a ∈ I) :
    IsNilpotent (Ideal.Quotient.mk (I ^ n) a) :=
  ⟨n, by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.pow_mem_pow ha n⟩

theorem isUnit_mk_of_notMem (hn : 0 < n) {a : R} (ha : a ∉ I) :
    IsUnit (Ideal.Quotient.mk (I ^ n) a) := by
  obtain ⟨b, h, hmem, hb⟩ := hI.exists_inv ha
  have hnil : IsNilpotent (Ideal.Quotient.mk (I ^ n) h) := isNilpotent_mk_of_mem I hn hmem
  have hone : Ideal.Quotient.mk (I ^ n) b * Ideal.Quotient.mk (I ^ n) a
      = 1 - Ideal.Quotient.mk (I ^ n) h := by
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (I ^ n)), ← map_sub]
    congr 1
    linear_combination hb
  have hu : IsUnit (1 - Ideal.Quotient.mk (I ^ n) h) := hnil.isUnit_one_sub
  rw [← hone] at hu
  exact isUnit_of_mul_isUnit_right hu

theorem mem_of_not_isUnit_mk (hn : 0 < n) {a : R}
    (h : ¬ IsUnit (Ideal.Quotient.mk (I ^ n) a)) : a ∈ I := by
  by_contra hc
  exact h (isUnit_mk_of_notMem I hn hc)

theorem isLocalRing_quotientPow (hn : 0 < n) : IsLocalRing (R ⧸ I ^ n) := by
  haveI := quotientPow_nontrivial I hn
  refine IsLocalRing.of_nonunits_add ?_
  intro x y hx hy
  rw [mem_nonunits_iff] at hx hy ⊢
  intro hxy
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
  have ha : a ∈ I := mem_of_not_isUnit_mk I hn hx
  have hb : b ∈ I := mem_of_not_isUnit_mk I hn hy
  have hnil : IsNilpotent (Ideal.Quotient.mk (I ^ n) a + Ideal.Quotient.mk (I ^ n) b) := by
    have hm := isNilpotent_mk_of_mem I hn (Ideal.add_mem _ ha hb)
    rwa [map_add] at hm
  obtain ⟨k, hk⟩ := hnil
  have h1 : IsUnit ((Ideal.Quotient.mk (I ^ n) a + Ideal.Quotient.mk (I ^ n) b) ^ k) := hxy.pow k
  rw [hk] at h1
  exact absurd h1 not_isUnit_zero

theorem maximalIdeal_quotientPow (hn : 0 < n) :
    haveI := isLocalRing_quotientPow I hn
    maximalIdeal (R ⧸ I ^ n) = I.map (Ideal.Quotient.mk (I ^ n)) := by
  haveI := isLocalRing_quotientPow I hn
  refine le_antisymm ?_ ?_
  · intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have := mem_of_not_isUnit_mk I hn (IsLocalRing.mem_maximalIdeal _ |>.mp hx)
    exact Ideal.mem_map_of_mem _ this
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    haveI := quotientPow_nontrivial I hn
    obtain ⟨k, hk⟩ := isNilpotent_mk_of_mem I hn ha
    have h1 : IsUnit ((Ideal.Quotient.mk (I ^ n) a) ^ k) := hu.pow k
    rw [hk] at h1
    exact absurd h1 not_isUnit_zero

theorem maximalIdeal_quotientPow_pow (hn : 0 < n) :
    haveI := isLocalRing_quotientPow I hn
    (maximalIdeal (R ⧸ I ^ n)) ^ n = ⊥ := by
  haveI := isLocalRing_quotientPow I hn
  rw [maximalIdeal_quotientPow I hn, ← Ideal.map_pow, Ideal.map_quotient_self]

end QuotientPow

/-! ## Transport along an isomorphism -/

theorem exists_adjoin_eq_top_of_algEquiv {κ A B : Type*} [CommSemiring κ] [CommRing A] [CommRing B]
    [Algebra κ A] [Algebra κ B] (e : A ≃ₐ[κ] B)
    (h : ∃ β : B, Algebra.adjoin κ ({β} : Set B) = ⊤) :
    ∃ α : A, Algebra.adjoin κ ({α} : Set A) = ⊤ := by
  obtain ⟨β, hβ⟩ := h
  refine ⟨e.symm β, ?_⟩
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at hβ ⊢
  intro a
  obtain ⟨q, hq⟩ := hβ (e a)
  refine ⟨q, ?_⟩
  have h2 : Polynomial.aeval (e.symm β) q = e.symm (Polynomial.aeval β q) :=
    Polynomial.aeval_algHom_apply (e.symm : B →ₐ[κ] A) β q
  rw [h2, hq, AlgEquiv.symm_apply_apply]


/-! ## The criterion -/

/-- **A finite-dimensional algebra whose local factors have principal maximal ideals is generated by
one element.** -/
theorem exists_adjoin_eq_top_of_local_factors_principal
    {κ R : Type*} [Field κ] [CharZero κ] [CommRing R] [Algebra κ R] [FiniteDimensional κ R]
    {n : ℕ} (hn : 0 < n) (hnil : (nilradical R) ^ n = ⊥)
    (hprin : ∀ I : MaximalSpectrum R, ∃ t : R ⧸ I.asIdeal ^ n,
      I.asIdeal.map (Ideal.Quotient.mk (I.asIdeal ^ n)) = Ideal.span {t}) :
    ∃ γ : R, Algebra.adjoin κ ({γ} : Set R) = ⊤ := by
  classical
  haveI hart : IsArtinianRing R := isArtinian_of_tower κ inferInstance
  haveI : Fintype (MaximalSpectrum R) := Fintype.ofFinite _
  haveI hloc : ∀ I : MaximalSpectrum R, IsLocalRing (R ⧸ I.asIdeal ^ n) :=
    fun I => isLocalRing_quotientPow I.asIdeal hn
  haveI hfin : ∀ I : MaximalSpectrum R, FiniteDimensional κ (R ⧸ I.asIdeal ^ n) := fun I =>
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ κ (I.asIdeal ^ n)).toLinearMap
      Ideal.Quotient.mk_surjective
  haveI hresfin : ∀ I : MaximalSpectrum R,
      FiniteDimensional κ (ResidueField (R ⧸ I.asIdeal ^ n)) := fun I =>
    Module.Finite.of_surjective
      (IsScalarTower.toAlgHom κ (R ⧸ I.asIdeal ^ n)
        (ResidueField (R ⧸ I.asIdeal ^ n))).toLinearMap residue_surjective
  haveI hsep : ∀ I : MaximalSpectrum R,
      Algebra.IsSeparable κ (ResidueField (R ⧸ I.asIdeal ^ n)) := fun I => inferInstance
  have hnilp : ∀ I : MaximalSpectrum R, ∃ N : ℕ, (maximalIdeal (R ⧸ I.asIdeal ^ n)) ^ N = ⊥ :=
    fun I => ⟨n, maximalIdeal_quotientPow_pow I.asIdeal hn⟩
  have hmono : ∀ I : MaximalSpectrum R,
      ∃ γ : R ⧸ I.asIdeal ^ n, Algebra.adjoin κ ({γ} : Set (R ⧸ I.asIdeal ^ n)) = ⊤ := by
    intro I
    obtain ⟨t, ht⟩ := hprin I
    refine exists_adjoin_eq_top_of_principal_nilpotent (t := t) ?_
      (N := n) (maximalIdeal_quotientPow_pow I.asIdeal hn)
    rw [maximalIdeal_quotientPow I.asIdeal hn, ht]
  obtain ⟨α, hα⟩ := exists_adjoin_pi_eq_top (κ := κ)
    (fun I : MaximalSpectrum R => R ⧸ I.asIdeal ^ n) hnilp hmono
  refine exists_adjoin_eq_top_of_algEquiv ?_ ⟨α, hα⟩
  exact AlgEquiv.restrictScalars κ
    (((AlgEquiv.quotientBot R R).symm.trans
      (Ideal.quotientEquivAlgOfEq R hnil.symm)).trans
      (IsArtinianRing.quotNilradicalPowEquivPi R n))

end GaloisForLFunctions.HTGeometry
