import GaloisForLFunctions.HTGeometry.StableCoreDichotomyAlgebraic
import GaloisForLFunctions.HTGeometry.StableCoreClockPow
import GaloisForLFunctions.HTGeometry.EigenvalueUnique
import GaloisForLFunctions.HTGeometry.ChargeUnique

/-!
# The clock-character law at the persistent core: complete conclusion

Assembling the full conclusion of the charged clock-character law at the persistent core
`T = ∩ₙ Φⁿ(F)`, in the card's exact form.  Given a differential generator `q` of `T` (the differential
Lüroth output) and an algebraic clock character of positive charge (the algebraicity input), the
constraint `Φ|T`:

* (equation 3) acts on `q` by a Möbius transform;
* (equation 2) is diagonalized `ρ_λ(q) = λ^k·q` with a *unique* charge `k`;
* (equation 4) is multiplication by a *unique nonzero* constant, `Φ|T(q) = a·q`, `a ∈ C^*`.

Only the two structural inputs remain open: the differential Lüroth generator `q` and the polynomial
algebraicity of the clock character.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

/-- **Clock-character law at the core (complete conclusion).**  On the persistent core generated by a
differential-transcendental `q`, an algebraic clock character of positive charge forces `Φ|T` to act
Möbius (eq. 3), with a unique charge `k` (eq. 2) and a unique nonzero scaling constant (eq. 4). -/
theorem persistent_core_clock_character_complete
    {C F : Type*} [Field C] [IsAlgClosed C] [Field F] [CharZero F] [Algebra C F]
    [Differential C] [Differential F] [DifferentialAlgebra C F]
    (φ : F →ₐ[C] F) (hφ : ∀ x : F, φ x′ = (φ x)′)
    (ρ : C → (F ≃ₐ[C] F)) (hcommφ : ∀ lam : C, ∀ x, φ (ρ lam x) = ρ lam (φ x)) :
    letI : Differential (stableRangeCore φ) :=
      derivationClosedDifferential _ (derivationClosed_stableRangeCore φ hφ)
    ∀ {q : stableRangeCore φ} {P : Polynomial C},
      HypertranscendentalOver C q →
      differentialAdjoin C ({q} : Set (stableRangeCore φ)) = ⊤ →
      0 < P.natDegree →
      (∀ lam : C, lam ≠ 0 →
        (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q
          = algebraMap C (stableRangeCore φ) (P.eval lam) * q) →
      (∀ lam mu : C, lam ≠ 0 → mu ≠ 0 →
        (stableRangeCoreClockFamily φ ρ hcommφ (lam * mu)).toAlgHom q
          = (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom
            ((stableRangeCoreClockFamily φ ρ hcommφ mu).toAlgHom q)) →
      (∀ lam : C, lam ≠ 0 →
        (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv.toAlgHom
            ((stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q)
          = (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom
            ((stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv.toAlgHom q)) →
      -- equation (3): Möbius
      (∃ a b c d : C, a * d - b * c ≠ 0 ∧
          (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv q
              * (algebraMap C (stableRangeCore φ) c * q + algebraMap C (stableRangeCore φ) d)
            = algebraMap C (stableRangeCore φ) a * q + algebraMap C (stableRangeCore φ) b)
        -- equation (2): unique charge k
        ∧ (∃ k : ℕ, (∀ lam : C, lam ≠ 0 →
              (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q
                = algebraMap C (stableRangeCore φ) (lam ^ k) * q)
            ∧ ∀ m : ℕ, (∀ lam : C, lam ≠ 0 →
                (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q
                  = algebraMap C (stableRangeCore φ) (lam ^ m) * q) → m = k)
        -- equation (4): unique nonzero scaling constant
        ∧ (∃ a : C, a ≠ 0
            ∧ (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv q
              = algebraMap C (stableRangeCore φ) a * q
            ∧ ∀ b : C, (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv q
                = algebraMap C (stableRangeCore φ) b * q → b = a) := by
  letI : Differential (stableRangeCore φ) :=
    derivationClosedDifferential _ (derivationClosed_stableRangeCore φ hφ)
  intro q P hq hqtop hPdeg halg hmul hcomm
  have htrans : Transcendental C q := by
    simpa using hypertranscendentalOver_jet_transcendental hq 0
  have hq0 : q ≠ 0 := by rintro rfl; exact htrans isAlgebraic_zero
  have hP : P ≠ 0 := by rintro rfl; simp at hPdeg
  obtain ⟨heq3, ⟨a, ha⟩⟩ :=
    persistent_core_dichotomy_from_algebraic φ hφ ρ hcommφ hq hqtop hPdeg halg hmul hcomm
  obtain ⟨k, hk⟩ := stableRangeCoreSymmetry_family_pow φ ρ hcommφ hq0 hP halg hmul
  obtain ⟨hane, hbuniq⟩ :=
    algEquiv_eigenvalue_existsUnique (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv hq0 ha
  refine ⟨heq3, ⟨k, hk, fun m hm =>
    charge_unique_of_scaling (fun lam => (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom)
      hq0 hm hk⟩, a, hane, ha, ?_⟩
  intro b hb
  exact hbuniq.unique hb ha