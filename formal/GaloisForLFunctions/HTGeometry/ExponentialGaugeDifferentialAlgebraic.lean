import GaloisForLFunctions.HTGeometry.ExponentialObservationHypertranscendence
import GaloisForLFunctions.HTGeometry.AffineFirstOrderDifferentialAlgebraicity

/-!
# Exponential gauges are differentially algebraic

An element whose logarithmic derivative is differentially algebraic is itself differentially
algebraic: over the differential field generated by that logarithmic derivative it satisfies a
homogeneous first-order linear equation, and differential algebraicity is transitive.  In particular
the exponential of a differentially algebraic exponent is differentially algebraic.

Multiplying by such a gauge therefore changes neither the differentially algebraic phase nor the
hypertranscendental one, and neither does adding the gauge's logarithmic derivative.  This is the
invariance that lets a genus-changing exponential gauge be discarded before a differential
classification is applied.
-/

open scoped Differential

noncomputable section

namespace GaloisForLFunctions.HTGeometry

universe u

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
  [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]

/-- **A differentially algebraic logarithmic derivative forces differential algebraicity.**  If
`y′ = c y` with `c` differentially algebraic, then `y` is differentially algebraic. -/
theorem differentialAlgebraicOver_of_deriv_eq_mul {y c : E}
    (hc : DifferentialAlgebraicOver F c) (hrel : y′ = c * y) :
    DifferentialAlgebraicOver F y := by
  set S : IntermediateField F E := differentialAdjoin F ({c} : Set E)
  letI : DifferentialAlgebra S E :=
    ⟨fun a => derivationClosedDifferential_apply S
      (derivationClosed_differentialAdjoin F ({c} : Set E)) a⟩
  have hcS : c ∈ S := subset_differentialAdjoin F ({c} : Set E) rfl
  have hyS : DifferentialAlgebraicOver S y := by
    refine differentialAlgebraicOver_of_deriv_eq_base_mul (F := S) (E := E) (⟨c, hcS⟩ : S) ?_
    simpa using hrel
  exact differentialAlgebraicOver_trans hc hyS

/-- **The exponential of a differentially algebraic exponent is differentially algebraic.**  The
exponent enters only through the relation `y′ = P′ y`. -/
theorem differentialAlgebraicOver_of_deriv_eq_deriv_mul {y P : E}
    (hP : DifferentialAlgebraicOver F P) (hrel : y′ = P′ * y) :
    DifferentialAlgebraicOver F y :=
  differentialAlgebraicOver_of_deriv_eq_mul (differentialAlgebraicOver_deriv hP) hrel

/-- **An exponential gauge preserves the differentially algebraic phase.** -/
theorem differentialAlgebraicOver_mul_iff_of_expGauge {x y P : E}
    (hP : DifferentialAlgebraicOver F P) (hrel : y′ = P′ * y) (hy0 : y ≠ 0) :
    DifferentialAlgebraicOver F (x * y) ↔ DifferentialAlgebraicOver F x := by
  have hy : DifferentialAlgebraicOver F y :=
    differentialAlgebraicOver_of_deriv_eq_deriv_mul hP hrel
  constructor
  · intro hxy
    have h := differentialAlgebraicOver_div hxy hy
    rwa [mul_div_assoc, div_self hy0, mul_one] at h
  · intro hx
    exact differentialAlgebraicOver_mul hx hy

/-- **An exponential gauge preserves the hypertranscendental phase.** -/
theorem hypertranscendentalOver_mul_iff_of_expGauge {x y P : E}
    (hP : DifferentialAlgebraicOver F P) (hrel : y′ = P′ * y) (hy0 : y ≠ 0) :
    HypertranscendentalOver F (x * y) ↔ HypertranscendentalOver F x :=
  hypertranscendentalOver_mul_differentialAlgebraic_iff
    (differentialAlgebraicOver_of_deriv_eq_deriv_mul hP hrel) hy0

omit [CharZero E] in
/-- The logarithmic derivative of a gauged element is the original logarithmic derivative plus the
gauge's exponent derivative. -/
theorem logDeriv_mul_expGauge {x y P : E} (hrel : y′ = P′ * y) (hx0 : x ≠ 0) (hy0 : y ≠ 0) :
    (x * y)′ / (x * y) = x′ / x + P′ := by
  have hleib : (x * y)′ = x * y′ + y * x′ := by
    simp [smul_eq_mul, (Differential.deriv : Derivation ℤ E E).leibniz x y]
  rw [hleib, hrel]
  field_simp
  ring

/-- **An exponential gauge preserves the differentially algebraic phase of the logarithmic
derivative.** -/
theorem differentialAlgebraicOver_logDeriv_mul_iff_of_expGauge {x y P : E}
    (hP : DifferentialAlgebraicOver F P) (hrel : y′ = P′ * y) (hx0 : x ≠ 0) (hy0 : y ≠ 0) :
    DifferentialAlgebraicOver F ((x * y)′ / (x * y))
      ↔ DifferentialAlgebraicOver F (x′ / x) := by
  rw [logDeriv_mul_expGauge hrel hx0 hy0]
  have hPd : DifferentialAlgebraicOver F P′ := differentialAlgebraicOver_deriv hP
  constructor
  · intro h
    have := differentialAlgebraicOver_sub h hPd
    simpa using this
  · intro h
    exact differentialAlgebraicOver_add h hPd

/-- **An exponential gauge preserves the hypertranscendental phase of the logarithmic
derivative.** -/
theorem hypertranscendentalOver_logDeriv_mul_iff_of_expGauge {x y P : E}
    (hP : DifferentialAlgebraicOver F P) (hrel : y′ = P′ * y) (hx0 : x ≠ 0) (hy0 : y ≠ 0) :
    HypertranscendentalOver F ((x * y)′ / (x * y))
      ↔ HypertranscendentalOver F (x′ / x) := by
  rw [logDeriv_mul_expGauge hrel hx0 hy0]
  exact hypertranscendentalOver_add_differentialAlgebraic_iff
    (differentialAlgebraicOver_deriv hP)

end GaloisForLFunctions.HTGeometry

end
