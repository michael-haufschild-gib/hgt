import GaloisForLFunctions.HTGeometry.GappedEigenlineTimeUniformFloor
import GaloisForLFunctions.HTGeometry.SelfAdjointPropagator

/-!
# The card's boxed bound, at the physical propagator

Assembling the three pieces: a gapped eigenvector perturbed by `δ` leaves an eigenvector of the
perturbed operator within `√(2δ/Δ)`; the propagator of a self-adjoint generator fixes that
eigenvector's line and is an isometry; and an isometry fixing a line moves every state by at most
twice its distance to that line.

The result is uniform in time, and the time variable does not appear on the right-hand side.
-/

namespace HTGeometry

open RHTower GaloisForLFunctions.HTGeometry

noncomputable section

/-- **The time-uniform gapped floor at the propagator.**  A gapped eigenvector of `H₀` perturbed by
`V` of size `δ` never leaves a projective ball of radius `2√(2δ/Δ)` under the evolution generated by
`H₀ + V`, at any time. -/
theorem pureStateTraceDistance_propagator_le_of_gap
    {ι : Type*} [Fintype ι]
    (H₀ V : EuclideanSpace ℂ ι →L[ℂ] EuclideanSpace ℂ ι)
    (hH₀ : IsSelfAdjoint H₀) (hV : IsSelfAdjoint V)
    (Φ : EuclideanSpace ℂ ι) (hΦ : ‖Φ‖ = 1) (lam Δ δ : ℝ) (hΔ : 0 < Δ)
    (hΦeig : H₀ Φ = (lam : ℂ) • Φ)
    (hgap : ∀ x : EuclideanSpace ℂ ι, H₀.reApplyInnerSelf x
      ≤ lam * ‖x‖ ^ (2 : ℕ) - Δ * (‖x‖ ^ (2 : ℕ) - ‖(inner ℂ Φ x : ℂ)‖ ^ (2 : ℕ)))
    (hVnorm : ‖V‖ ≤ δ) (t : ℝ) :
    pureStateTraceDistance (selfAdjointPropagator (hH₀.add hV) t Φ) Φ
      ≤ 2 * Real.sqrt (2 * δ / Δ) := by
  haveI : FiniteDimensional ℂ (EuclideanSpace ℂ ι) := inferInstance
  obtain ⟨ψ, hψ, ⟨μ, hμ⟩, hdef⟩ :=
    exists_hasEigenvector_of_gap (E := EuclideanSpace ℂ ι) H₀ V hH₀ hV Φ hΦ lam Δ δ hΔ
      hΦeig hgap hVnorm
  have hfix : selfAdjointPropagator (hH₀.add hV) t ψ
      = Complex.exp ((-(t : ℂ) * Complex.I) * (μ : ℂ)) • ψ :=
    selfAdjointPropagator_apply_eigen (hH₀.add hV) t (μ : ℂ) ψ hμ
  have hc : ‖Complex.exp ((-(t : ℂ) * Complex.I) * (μ : ℂ))‖ = 1 := by
    rw [show (-(t : ℂ) * Complex.I) * (μ : ℂ) = ((-(t * μ) : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  exact pureStateTraceDistance_apply_le_of_gap (ι := ι)
    (selfAdjointPropagator (hH₀.add hV) t) Φ ψ hΦ hψ
    (Complex.exp ((-(t : ℂ) * Complex.I) * (μ : ℂ))) hc hfix Δ δ hdef

end

end HTGeometry
