import GaloisForLFunctions.HTGeometry.RittPrefixFieldStability
import GaloisForLFunctions.HTGeometry.RittJetDefect

/-!
# Linear independence of the jets

Each jet is transcendental over the field generated by its predecessors, so in particular it does not
lie in that field.  A vanishing base-linear combination of the first `n` jets therefore has its top
coefficient zero — otherwise the top jet would be a base combination of the lower ones — and the
argument repeats downward.

So the jets of a linearizer are linearly independent over the base, and a base-linear combination
determines its coefficients.  This is what turns the Faà di Bruno expansion into an identification of
individual coefficients with the closed-form leading coefficient of the shift defect.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- **The jets are linearly independent over the base.** -/
theorem jet_coeffs_eq_zero_of_sum_eq_zero (Fr : RittFrame K L) {τ : L} :
    ∀ (n : ℕ), (∀ j, j < n → Transcendental ↥(Fr.jetPrefixField τ j) (Fr.d^[j] τ)) →
      ∀ c : ℕ → K, ∑ j ∈ Finset.range n, algebraMap K L (c j) * Fr.d^[j] τ = 0 →
        ∀ j, j < n → c j = 0 := by
  intro n
  induction n with
  | zero =>
      intro _ c _ j hj
      omega
  | succ m ih =>
      intro htr c hsum j hj
      have hmem : ∀ i, i < m → Fr.d^[i] τ ∈ Fr.jetPrefixField τ m := fun i hi =>
        Fr.jet_mem_jetPrefixField hi
      have hlow : ∑ i ∈ Finset.range m, algebraMap K L (c i) * Fr.d^[i] τ
          ∈ Fr.jetPrefixField τ m := by
        refine sum_mem ?_
        intro i hi
        rw [Finset.mem_range] at hi
        exact mul_mem (IntermediateField.algebraMap_mem _ _) (hmem i hi)
      have hsplit : algebraMap K L (c m) * Fr.d^[m] τ
          = -∑ i ∈ Finset.range m, algebraMap K L (c i) * Fr.d^[i] τ := by
        rw [Finset.sum_range_succ] at hsum
        linear_combination hsum
      have hcm : c m = 0 := by
        by_contra hne
        have hcL : algebraMap K L (c m) ≠ 0 :=
          (map_ne_zero_iff _ (algebraMap K L).injective).mpr hne
        have htop : Fr.d^[m] τ ∈ Fr.jetPrefixField τ m := by
          have hinv : Fr.d^[m] τ = algebraMap K L (c m)⁻¹
              * (-∑ i ∈ Finset.range m, algebraMap K L (c i) * Fr.d^[i] τ) := by
            rw [← hsplit, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hne, map_one, one_mul]
          rw [hinv]
          exact mul_mem (IntermediateField.algebraMap_mem _ _) (neg_mem hlow)
        exact htr m (by omega)
          (isAlgebraic_algebraMap (⟨Fr.d^[m] τ, htop⟩ : ↥(Fr.jetPrefixField τ m)))
      rcases Nat.lt_or_ge j m with hjm | hjm
      · refine ih (fun i hi => htr i (by omega)) c ?_ j hjm
        rw [Finset.sum_range_succ, hcm, map_zero, zero_mul, add_zero] at hsum
        exact hsum
      · have : j = m := by omega
        rw [this]
        exact hcm

/-- An element of the jet span is an explicit base-linear combination of the jets. -/
theorem exists_coeffs_of_mem_jetSpan (Fr : RittFrame K L) {τ : L} {n : ℕ} {x : L}
    (hx : x ∈ Fr.jetSpan τ n) :
    ∃ c : ℕ → K, (∀ j, c j ≠ 0 → 1 ≤ j ∧ j ≤ n) ∧
      x = ∑ j ∈ Finset.range (n + 1), algebraMap K L (c j) * Fr.d^[j] τ := by
  classical
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      refine ⟨fun i => if i = j + 1 then 1 else 0, ?_, ?_⟩
      · intro i hi
        dsimp only at hi
        by_cases h : i = j + 1
        · omega
        · rw [if_neg h] at hi
          exact absurd rfl hi
      · rw [Finset.sum_eq_single (j + 1)]
        · dsimp only
          rw [if_pos rfl, map_one, one_mul]
        · intro b _ hb
          dsimp only
          rw [if_neg hb, map_zero, zero_mul]
        · intro hmem
          exact absurd (Finset.mem_range.mpr (by omega)) hmem
  | zero => exact ⟨0, fun j hj => absurd rfl hj, by simp⟩
  | add y z hy hz ihy ihz =>
      obtain ⟨cy, hcy, hyeq⟩ := ihy
      obtain ⟨cz, hcz, hzeq⟩ := ihz
      refine ⟨fun j => cy j + cz j, ?_, ?_⟩
      · intro j hj
        dsimp only at hj
        by_cases h : cy j = 0
        · exact hcz j (by intro hh; rw [h, hh, add_zero] at hj; exact hj rfl)
        · exact hcy j h
      · rw [hyeq, hzeq, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        dsimp only
        rw [map_add]
        ring
  | smul a y hy ihy =>
      obtain ⟨cy, hcy, hyeq⟩ := ihy
      refine ⟨fun j => a * cy j, ?_, ?_⟩
      · intro j hj
        dsimp only at hj
        exact hcy j fun h => hj (by rw [h, mul_zero])
      · rw [Algebra.smul_def, hyeq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        dsimp only
        rw [map_mul]
        ring

variable [CharZero K]

/-- **The top coefficient of the shift defect is the closed-form leading coefficient.** -/
theorem jetDefect_top_coeff (Fr : RittFrame K L) {τ : L} {q : K} (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ) {m : ℕ} (hm : 2 ≤ m)
    (htr : ∀ j, j < m → Transcendental ↥(Fr.jetPrefixField τ j) (Fr.d^[j] τ))
    {A : ℕ → K} (hA : Fr.σ (Fr.d^[m] τ) = algebraMap K L (q / Fr.ρ ^ m) * Fr.d^[m] τ
      + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ) :
    A (m - 1) = -(((m.choose 2 : ℕ) : K) * q * Fr.dK Fr.ρ / Fr.ρ ^ (m + 1)) := by
  classical
  obtain ⟨p, rfl⟩ : ∃ p, m = p + 2 := ⟨m - 2, by omega⟩
  set lam : K := -((((p + 2).choose 2 : ℕ) : K) * q * Fr.dK Fr.ρ / Fr.ρ ^ (p + 3)) with hlam
  have hdefeq : Fr.jetDefect τ q (p + 2)
      = ∑ j ∈ Finset.range (p + 2), algebraMap K L (A j) * Fr.d^[j] τ := by
    rw [RittFrame.jetDefect, hA]
    ring
  have hlead := jetDefect_leading Fr hqconst hshift p
  rw [hdefeq] at hlead
  obtain ⟨c, hcsupp, hceq⟩ := exists_coeffs_of_mem_jetSpan Fr hlead
  set e : ℕ → K := fun j =>
    A j - (if j = p + 1 then lam else 0) - (if j < p + 1 then c j else 0) with he
  have hzero : ∑ j ∈ Finset.range (p + 2), algebraMap K L (e j) * Fr.d^[j] τ = 0 := by
    have hetop : e (p + 1) = A (p + 1) - lam := by
      simp only [he, if_pos, lt_irrefl, if_false, sub_zero]
    have hrest : ∀ j ∈ Finset.range (p + 1),
        algebraMap K L (e j) * Fr.d^[j] τ
          = algebraMap K L (A j) * Fr.d^[j] τ - algebraMap K L (c j) * Fr.d^[j] τ := by
      intro j hj
      rw [Finset.mem_range] at hj
      have hej : e j = A j - c j := by
        simp only [he]
        rw [if_neg (by omega : ¬ j = p + 1), if_pos (by omega : j < p + 1)]
        ring
      rw [hej, map_sub, sub_mul]
    have hkey : ∑ j ∈ Finset.range (p + 1), algebraMap K L (A j) * Fr.d^[j] τ
        + algebraMap K L (A (p + 1)) * Fr.d^[p + 1] τ
        - algebraMap K L lam * Fr.d^[p + 1] τ
        = ∑ j ∈ Finset.range (p + 1), algebraMap K L (c j) * Fr.d^[j] τ := by
      rw [← Finset.sum_range_succ (fun j => algebraMap K L (A j) * Fr.d^[j] τ) (p + 1)]
      exact hceq
    rw [Finset.sum_range_succ, Finset.sum_congr rfl hrest, Finset.sum_sub_distrib, hetop,
      map_sub, sub_mul]
    linear_combination hkey
  have hres := jet_coeffs_eq_zero_of_sum_eq_zero Fr (p + 2) htr e hzero (p + 1) (by omega)
  have heval : e (p + 1) = A (p + 1) - lam := by
    simp only [he, if_pos, lt_irrefl, if_false, sub_zero]
  rw [heval] at hres
  have hp1 : (p + 2) - 1 = p + 1 := by omega
  rw [hp1]
  have hAlam : A (p + 1) = lam := by linear_combination hres
  rw [hAlam, hlam]

end GaloisForLFunctions.HTGeometry
