import Mathlib
import GaloisForLFunctions.HTGeometry.CofinalGenerativeAdmission

/-!
# Finite Fourier-kernel admission core

This module certifies the finite algebraic core of
`fourier-kernel-admission-reconstruction-and-contact-localization-law.md`.

Quadratic kernel tests jointly reconstruct a signed finite carrier and reflect its positive order.
Consequently domination by a positive base is equivalent to positivity of every kernel pencil.
The final inequality is the finite contact-localization estimate behind the spectral fourth-organ
prediction.  Analytic Fourier uniqueness and the infinite-measure limit remain paper-level.
-/

namespace GaloisForLFunctions.HTGeometry

open Finset

/-- Quadratic kernel test of a signed finite carrier. -/
def finiteKernelQuadratic {n : ℕ} (ν f : Fin n → ℝ) : ℝ :=
  ∑ x, ν x * f x ^ 2

/-- Coordinate packet used to prove that the full quadratic family reflects source order. -/
def finiteCoordinatePacket {n : ℕ} (x : Fin n) : Fin n → ℝ :=
  fun y => if y = x then 1 else 0

/-- A coordinate packet reads one source coefficient exactly. -/
theorem finiteKernelQuadratic_coordinate {n : ℕ} (ν : Fin n → ℝ) (x : Fin n) :
    finiteKernelQuadratic ν (finiteCoordinatePacket x) = ν x := by
  classical
  simp [finiteKernelQuadratic, finiteCoordinatePacket]

/-- A positive finite carrier has nonnegative response on every quadratic packet. -/
theorem finiteKernelQuadratic_nonneg_of_nonneg {n : ℕ} {ν : Fin n → ℝ}
    (hν : ∀ x, 0 ≤ ν x) (f : Fin n → ℝ) :
    0 ≤ finiteKernelQuadratic ν f := by
  unfold finiteKernelQuadratic
  exact Finset.sum_nonneg fun x _ => mul_nonneg (hν x) (sq_nonneg (f x))

/-- Canonical quadratic packets jointly reflect the full finite positive cone. -/
theorem finiteKernelQuadratic_nonneg_iff {n : ℕ} (ν : Fin n → ℝ) :
    (∀ x, 0 ≤ ν x) ↔ ∀ f, 0 ≤ finiteKernelQuadratic ν f := by
  constructor
  · exact fun hν f => finiteKernelQuadratic_nonneg_of_nonneg hν f
  · intro hall x
    simpa [finiteKernelQuadratic_coordinate] using hall (finiteCoordinatePacket x)

/-- Complete quadratic response reconstructs every signed finite coefficient. -/
theorem finiteKernelQuadratic_injective {n : ℕ} {ν ξ : Fin n → ℝ}
    (h : ∀ f, finiteKernelQuadratic ν f = finiteKernelQuadratic ξ f) :
    ν = ξ := by
  funext x
  simpa [finiteKernelQuadratic_coordinate] using h (finiteCoordinatePacket x)

/-- Quadratic pencil of an intervention against a positive compensating base. -/
def finiteKernelPencil {n : ℕ} (w h : Fin n → ℝ) (c : ℝ) (f : Fin n → ℝ) : ℝ :=
  finiteKernelQuadratic h f + c * finiteKernelQuadratic w f

/-- A kernel pencil is the quadratic test of the compensated source coefficient. -/
theorem finiteKernelPencil_eq {n : ℕ} (w h : Fin n → ℝ) (c : ℝ) (f : Fin n → ℝ) :
    finiteKernelPencil w h c f =
      finiteKernelQuadratic (fun x => h x + c * w x) f := by
  classical
  unfold finiteKernelPencil finiteKernelQuadratic
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x _
  ring

/-- Exact finite fusion: coordinate domination is equivalent to positivity of every kernel
pencil.  The observer atlas is generated by the source quadratic law, not fitted afterwards. -/
theorem dominatedAt_iff_finiteKernelPencil_nonneg {n : ℕ}
    (w h : Fin n → ℝ) (c : ℝ) (hc : 0 ≤ c) :
    DominatedAt w h c ↔ ∀ f, 0 ≤ finiteKernelPencil w h c f := by
  constructor
  · rintro ⟨_, hpoint⟩ f
    rw [finiteKernelPencil_eq]
    exact finiteKernelQuadratic_nonneg_of_nonneg hpoint f
  · intro hall
    refine ⟨hc, ?_⟩
    intro x
    have hx := hall (finiteCoordinatePacket x)
    simpa [finiteKernelPencil, finiteKernelQuadratic_coordinate] using hx

/-- Penalty carried by a declared region separated from the spectral contact set. -/
def finiteContactPenalty {n : ℕ} (μ f : Fin n → ℝ) (S : Finset (Fin n))
    (δ : ℝ) : ℝ :=
  ∑ x, if x ∈ S then δ * (μ x * f x ^ 2) else 0

/-- Quadratic energy above a declared lower spectral floor. -/
def finiteSpectralExcess {n : ℕ} (μ h : Fin n → ℝ) (α : ℝ)
    (f : Fin n → ℝ) : ℝ :=
  ∑ x, μ x * (h x - α) * f x ^ 2

/-- Finite contact localization: energy above the floor controls all mass separated from the
contact set by a gap `δ`. -/
theorem finiteContactPenalty_le_spectralExcess {n : ℕ}
    (μ h f : Fin n → ℝ) (α δ : ℝ) (S : Finset (Fin n))
    (hμ : ∀ x, 0 ≤ μ x) (hfloor : ∀ x, α ≤ h x)
    (hcontact : ∀ x ∈ S, α + δ ≤ h x) :
    finiteContactPenalty μ f S δ ≤ finiteSpectralExcess μ h α f := by
  classical
  unfold finiteContactPenalty finiteSpectralExcess
  apply Finset.sum_le_sum
  intro x _
  by_cases hx : x ∈ S
  · rw [if_pos hx]
    have hgap : δ ≤ h x - α := by linarith [hcontact x hx]
    have hweight : 0 ≤ μ x * f x ^ 2 := mul_nonneg (hμ x) (sq_nonneg _)
    calc
      δ * (μ x * f x ^ 2) ≤ (h x - α) * (μ x * f x ^ 2) :=
        mul_le_mul_of_nonneg_right hgap hweight
      _ = μ x * (h x - α) * f x ^ 2 := by ring
  · rw [if_neg hx]
    exact mul_nonneg (mul_nonneg (hμ x) (sub_nonneg.mpr (hfloor x))) (sq_nonneg _)

/-- Closed finite capstone: order reflection, reconstruction, compensated admission, and contact
localization are simultaneous consequences of one quadratic kernel law. -/
theorem finiteKernelAdmission_contact_capstone :
    (∀ (n : ℕ) (ν : Fin n → ℝ),
      ((∀ x, 0 ≤ ν x) ↔ ∀ f, 0 ≤ finiteKernelQuadratic ν f)) ∧
    (∀ (n : ℕ) (ν ξ : Fin n → ℝ),
      (∀ f, finiteKernelQuadratic ν f = finiteKernelQuadratic ξ f) → ν = ξ) ∧
    (∀ (n : ℕ) (w h : Fin n → ℝ) (c : ℝ), 0 ≤ c →
      (DominatedAt w h c ↔ ∀ f, 0 ≤ finiteKernelPencil w h c f)) ∧
    (∀ (n : ℕ) (μ h f : Fin n → ℝ) (α δ : ℝ) (S : Finset (Fin n)),
      (∀ x, 0 ≤ μ x) → (∀ x, α ≤ h x) →
      (∀ x ∈ S, α + δ ≤ h x) →
      finiteContactPenalty μ f S δ ≤ finiteSpectralExcess μ h α f) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact fun _ => finiteKernelQuadratic_nonneg_iff
  · exact fun _ _ _ => finiteKernelQuadratic_injective
  · intro n w h c hc
    exact dominatedAt_iff_finiteKernelPencil_nonneg w h c hc
  · exact fun _ => finiteContactPenalty_le_spectralExcess

end GaloisForLFunctions.HTGeometry
