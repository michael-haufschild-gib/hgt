import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Topology.UniformSpace.HeineCantor

/-!
# Finite-horizon locality near the atomic Anderson limit

For a finite tight-binding Hamiltonian

`H(g,p) = g T + diagonal(p)`,

the atomic limit `g = 0` has identically zero transition amplitude between
distinct sites.  Joint continuity of the matrix exponential, strengthened by
compactness of a prescribed time window, makes this vanishing uniform in time,
uniform across every pair of distinct sites, and stable under simultaneous
perturbation of hopping strength and onsite potential.

The final density-selection theorem is deliberately abstract: any dense
onsite-potential property available at each positive hopping strength can be
imposed without losing finite-horizon locality.  A spectral genericity theorem
can therefore be composed with this file without conflating finite-horizon
suppression with infinite-time Anderson dynamical localization.
-/

open Filter Set Topology
open NormedSpace

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

attribute [local instance] Matrix.linftyOpNormedRing
attribute [local instance] Matrix.linftyOpNormedAlgebra

/-- Finite tight-binding Hamiltonian with fixed hopping matrix, hopping scale,
and real onsite potential. -/
def scaledFiniteAndersonHamiltonian
    (T : Matrix ι ι ℂ) (g : ℝ) (p : ι → ℝ) :
    Matrix ι ι ℂ :=
  (g : ℂ) • T + Matrix.diagonal (fun i => (p i : ℂ))

/-- Schrödinger evolution generated by `scaledFiniteAndersonHamiltonian`. -/
def finiteAndersonEvolution
    (T : Matrix ι ι ℂ) (g : ℝ) (p : ι → ℝ) (t : ℝ) :
    Matrix ι ι ℂ :=
  exp ((-(Complex.I * (t : ℂ))) • scaledFiniteAndersonHamiltonian T g p)

/-- Every off-diagonal transition amplitude is smaller than `ε` throughout
the symmetric observation horizon `[-H,H]`. -/
def FiniteHorizonOffDiagonalSmall
    (T : Matrix ι ι ℂ) (g : ℝ) (p : ι → ℝ) (H ε : ℝ) : Prop :=
  ∀ i j : ι, i ≠ j → ∀ t ∈ Set.Icc (-H) H,
    ‖finiteAndersonEvolution T g p t i j‖ < ε

theorem continuous_uncurry_finiteAndersonEvolution
    (T : Matrix ι ι ℂ) (p : ι → ℝ) :
    Continuous (fun q : ℝ × ℝ => finiteAndersonEvolution T q.1 p q.2) := by
  unfold finiteAndersonEvolution scaledFiniteAndersonHamiltonian
  fun_prop

/-- At the atomic limit, evolution has no transition amplitude between
distinct sites at any time. -/
theorem finiteAndersonEvolution_atomic_offDiagonal
    (T : Matrix ι ι ℂ) (p : ι → ℝ) {i j : ι} (hij : i ≠ j) (t : ℝ) :
    finiteAndersonEvolution T 0 p t i j = 0 := by
  rw [finiteAndersonEvolution, scaledFiniteAndersonHamiltonian, Complex.ofReal_zero, zero_smul, zero_add]
  have hdiag :
      (-(Complex.I * (t : ℂ))) • Matrix.diagonal (fun i => (p i : ℂ)) =
        Matrix.diagonal (fun i => (-(Complex.I * (t : ℂ))) * (p i : ℂ)) := by
    ext a b
    by_cases hab : a = b
    · subst b
      simp
    · simp [Matrix.diagonal_apply_ne _ hab]
  rw [hdiag, Matrix.exp_diagonal]
  exact Matrix.diagonal_apply_ne _ hij

/-- For a fixed onsite potential, each off-diagonal transition amplitude
vanishes uniformly on every prescribed compact time window as hopping tends
to zero. -/
theorem eventually_uniform_offDiagonal_small
    (T : Matrix ι ι ℂ) (p : ι → ℝ) {i j : ι} (hij : i ≠ j)
    (H : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ g in 𝓝 0, ∀ t ∈ Set.Icc (-H) H,
      ‖finiteAndersonEvolution T g p t i j‖ < ε := by
  let K := Set.Icc (-H) H
  let f : ℝ → K → ℂ := fun g t => finiteAndersonEvolution T g p t.1 i j
  have hf : Continuous ↿f := by
    have hbase : Continuous
        (fun q : ℝ × K => finiteAndersonEvolution T q.1 p q.2.1) :=
      (continuous_uncurry_finiteAndersonEvolution T p).comp
        (continuous_fst.prodMk (continuous_subtype_val.comp continuous_snd))
    have hrow :
        Continuous (fun q : ℝ × K => finiteAndersonEvolution T q.1 p q.2.1 i) :=
      (continuous_apply i).comp hbase
    have hentry :
        Continuous (fun q : ℝ × K => finiteAndersonEvolution T q.1 p q.2.1 i j) :=
      (continuous_apply j).comp hrow
    exact hentry
  have huniform : TendstoUniformly f (f 0) (𝓝 0) :=
    Continuous.tendstoUniformly f hf 0
  rw [Metric.tendstoUniformly_iff] at huniform
  filter_upwards [huniform ε hε] with g hg
  intro t ht
  have hentry := hg ⟨t, ht⟩
  simpa [f, finiteAndersonEvolution_atomic_offDiagonal T p hij t,
    dist_zero_right] using hentry

/-- Vanishing is simultaneous for all finitely many off-diagonal site pairs. -/
theorem eventually_uniform_all_offDiagonal_small
    (T : Matrix ι ι ℂ) (p : ι → ℝ) (H : ℝ)
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ g in 𝓝 0, FiniteHorizonOffDiagonalSmall T g p H ε := by
  unfold FiniteHorizonOffDiagonalSmall
  rw [Filter.eventually_all]
  intro i
  rw [Filter.eventually_all]
  intro j
  by_cases hij : i = j
  · exact Filter.Eventually.of_forall fun _ hne => (hne hij).elim
  · exact (eventually_uniform_offDiagonal_small T p hij H hε).mono
      (fun _ hg _ => hg)

/-- Positive hopping strengths with uniform finite-horizon suppression exist
arbitrarily close to the atomic limit. -/
theorem exists_positive_uniform_all_offDiagonal_small
    (T : Matrix ι ι ℂ) (p : ι → ℝ) (H : ℝ)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ g : ℝ, 0 < g ∧ FiniteHorizonOffDiagonalSmall T g p H ε := by
  let s : Set ℝ := {g | FiniteHorizonOffDiagonalSmall T g p H ε}
  have hs : s ∈ 𝓝 (0 : ℝ) :=
    eventually_uniform_all_offDiagonal_small T p H hε
  obtain ⟨g, hgs, hgpos⟩ :=
    nonempty_nhds_inter_Ioi hs
      (not_isMax_of_lt (show (0 : ℝ) < 1 by norm_num))
  exact ⟨g, hgpos, hgs⟩

/-- Finite-horizon suppression persists in a joint neighborhood of the atomic
hopping scale and a chosen onsite potential. -/
theorem eventually_joint_uniform_all_offDiagonal_small
    (T : Matrix ι ι ℂ) (p₀ : ι → ℝ) (H : ℝ)
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ q : ℝ × (ι → ℝ) in 𝓝 (0, p₀),
      FiniteHorizonOffDiagonalSmall T q.1 q.2 H ε := by
  unfold FiniteHorizonOffDiagonalSmall
  rw [Filter.eventually_all]
  intro i
  rw [Filter.eventually_all]
  intro j
  by_cases hij : i = j
  · exact Filter.Eventually.of_forall fun _ hne => (hne hij).elim
  · let K := Set.Icc (-H) H
    let f : (ℝ × (ι → ℝ)) → K → ℂ :=
      fun q t => finiteAndersonEvolution T q.1 q.2 t.1 i j
    have hf : Continuous ↿f := by
      unfold f finiteAndersonEvolution scaledFiniteAndersonHamiltonian
      fun_prop
    have huniform : TendstoUniformly f (f (0, p₀)) (𝓝 (0, p₀)) :=
      Continuous.tendstoUniformly f hf (0, p₀)
    rw [Metric.tendstoUniformly_iff] at huniform
    filter_upwards [huniform ε hε] with q hq
    intro _hne t ht
    have hentry := hq ⟨t, ht⟩
    simpa [f, finiteAndersonEvolution_atomic_offDiagonal T p₀ hij t,
      dist_zero_right] using hentry

/-- Abstract dense-fiber selector: any dense property in every positive
hopping fiber can be imposed inside a joint neighborhood of the atomic
limit. -/
theorem exists_positive_dense_fiber_of_mem_nhds_prod
    {X : Type*} [TopologicalSpace X]
    (x₀ : X) (s : Set (ℝ × X))
    (hs : s ∈ 𝓝 (0, x₀))
    (good : ℝ → Set X)
    (hdense : ∀ g : ℝ, 0 < g → Dense (good g)) :
    ∃ g : ℝ, ∃ x : X, 0 < g ∧ x ∈ good g ∧ (g, x) ∈ s := by
  obtain ⟨u, v, huOpen, hzero, hvOpen, hx₀, huv⟩ :=
    mem_nhds_prod_iff'.mp hs
  obtain ⟨g, hgu, hgpos⟩ :=
    nonempty_nhds_inter_Ioi (huOpen.mem_nhds hzero)
      (not_isMax_of_lt (show (0 : ℝ) < 1 by norm_num))
  obtain ⟨x, hxgood, hxv⟩ :=
    (hdense g hgpos).exists_mem_open hvOpen ⟨x₀, hx₀⟩
  exact ⟨g, x, hgpos, hxgood, huv ⟨hgu, hxv⟩⟩

/-- Any dense onsite-potential property at each positive hopping strength is
compatible with arbitrarily strong finite-horizon suppression of every
off-diagonal transition amplitude. -/
theorem exists_positive_dense_good_uniform_all_offDiagonal_small
    (T : Matrix ι ι ℂ) (p₀ : ι → ℝ) (H : ℝ)
    {ε : ℝ} (hε : 0 < ε)
    (good : ℝ → Set (ι → ℝ))
    (hdense : ∀ g : ℝ, 0 < g → Dense (good g)) :
    ∃ g : ℝ, ∃ p : ι → ℝ,
      0 < g ∧ p ∈ good g ∧ FiniteHorizonOffDiagonalSmall T g p H ε := by
  let s : Set (ℝ × (ι → ℝ)) := {q |
    FiniteHorizonOffDiagonalSmall T q.1 q.2 H ε}
  have hs : s ∈ 𝓝 (0, p₀) :=
    eventually_joint_uniform_all_offDiagonal_small T p₀ H hε
  exact exists_positive_dense_fiber_of_mem_nhds_prod p₀ s hs good hdense

end

end GaloisForLFunctions.HTGeometry
