import GaloisForLFunctions.HTGeometry.KleinGordonGrowthRate

/-!
# Faraday--Rayleigh--Taylor Floquet identities from arXiv:2607.28932

This module certifies three reusable parts of the paper: the four exponential branches of the
viscous vertical equation, the Mathieu-limit coefficient split, and the logarithmic growth rate of
Floquet multipliers.  The last item is connected directly to the corpus's infinite-dimensional
Klein--Gordon monodromy rather than only to a finite matrix.
-/

noncomputable section

open MeasureTheory Filter
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

/-! ## Viscous vertical modes -/

/-- The two squared vertical wavenumbers in equation (14). -/
def faradayViscousWavenumberSq (beta gamma viscosity : ℝ) : ℝ :=
  beta ^ 2 + gamma / viscosity

/-- Positive viscosity parameter. -/
abbrev FaradayPositiveViscosity := Set.Ioi (0 : ℝ)

/-- Cleared form of `q^(2 : ℕ) = beta^(2 : ℕ) + gamma / C`, with no division left. -/
theorem faradayViscousWavenumberSq_cleared
    (beta gamma : ℝ) (viscosity : FaradayPositiveViscosity) :
    (viscosity : ℝ) * (faradayViscousWavenumberSq beta gamma viscosity - beta ^ 2) = gamma := by
  have hviscosity : (viscosity : ℝ) ≠ 0 := ne_of_gt viscosity.2
  rw [faradayViscousWavenumberSq]
  field_simp [hviscosity]
  ring

/-- Dimensionless squared `q` from equation (14), before multiplication by the radial wavenumber. -/
def faradayDimensionlessQSq (beta gamma viscosity : ℝ) : ℝ :=
  1 + gamma / (viscosity * beta ^ 2)

/-- The paper's dimensionless `q` and the physical vertical exponent used above are exactly the
same dispersion branch after multiplying by `beta^(2 : ℕ)`. -/
theorem faradayDimensionlessQSq_scaled
    (beta viscosity : Set.Ioi (0 : ℝ)) (gamma : ℝ) :
    (beta : ℝ) ^ 2 * faradayDimensionlessQSq beta gamma viscosity =
      faradayViscousWavenumberSq beta gamma viscosity := by
  have hbeta : (beta : ℝ) ≠ 0 := ne_of_gt beta.property
  have hviscosity : (viscosity : ℝ) ≠ 0 := ne_of_gt viscosity.property
  simp only [faradayDimensionlessQSq, faradayViscousWavenumberSq]
  field_simp [hbeta, hviscosity]

/-- `n`th certified jet of one exponential vertical branch. -/
def faradayExponentialJet (alpha amplitude : ℝ) (n : ℕ) (z : ℝ) : ℝ :=
  amplitude * alpha ^ n * Real.exp (alpha * z)

theorem hasDerivAt_faradayExponentialJet
    (alpha amplitude : ℝ) (n : ℕ) (z : ℝ) :
    HasDerivAt (faradayExponentialJet alpha amplitude n)
      (faradayExponentialJet alpha amplitude (n + 1) z) z := by
  have hinner : HasDerivAt (fun x : ℝ => alpha * x) alpha z := by
    simpa using (hasDerivAt_id z).const_mul alpha
  have h := ((Real.hasDerivAt_exp (alpha * z)).comp z hinner).const_mul
    (amplitude * alpha ^ n)
  have hval : amplitude * alpha ^ n * (Real.exp (alpha * z) * alpha) =
      faradayExponentialJet alpha amplitude (n + 1) z := by
    rw [faradayExponentialJet, pow_succ]
    ring
  rw [hval] at h
  exact h

/-- Four-branch vertical ansatz generated by roots `±beta` and `±q`. -/
def faradayVerticalModeJet
    (beta q a b c d : ℝ) (n : ℕ) (z : ℝ) : ℝ :=
  faradayExponentialJet beta a n z + faradayExponentialJet (-beta) b n z +
    faradayExponentialJet q c n z + faradayExponentialJet (-q) d n z

theorem hasDerivAt_faradayVerticalModeJet
    (beta q a b c d : ℝ) (n : ℕ) (z : ℝ) :
    HasDerivAt (faradayVerticalModeJet beta q a b c d n)
      (faradayVerticalModeJet beta q a b c d (n + 1) z) z := by
  exact (((hasDerivAt_faradayExponentialJet beta a n z).add
    (hasDerivAt_faradayExponentialJet (-beta) b n z)).add
    (hasDerivAt_faradayExponentialJet q c n z)).add
    (hasDerivAt_faradayExponentialJet (-q) d n z)

/-- The four exponential branches solve the factored fourth-order vertical equation exactly. -/
theorem faradayVerticalMode_factored_ode
    (beta q a b c d z : ℝ) :
    faradayVerticalModeJet beta q a b c d 4 z -
        (beta ^ 2 + q ^ 2) * faradayVerticalModeJet beta q a b c d 2 z +
        beta ^ 2 * q ^ 2 * faradayVerticalModeJet beta q a b c d 0 z = 0 := by
  simp only [faradayVerticalModeJet, faradayExponentialJet, pow_zero]
  ring

/-! ## Mathieu-limit coefficient split -/

/-- Squared RT frequency from appendix A.3. -/
def rayleighTaylorFrequencySq (atwood bond beta : ℝ) : ℝ :=
  (atwood * beta - (1 + atwood) * beta ^ 3 / (2 * bond)) * Real.tanh beta

/-- Parametric forcing coefficient in the weak-damping Mathieu limit. -/
def faradayMathieuForcing (amplitude atwood beta : ℝ) : ℝ :=
  amplitude * atwood * beta * Real.tanh beta

/-- Weak-damping scalar equation displayed in appendix A.3, represented by its value/second jet. -/
def rayleighTaylorFaradayMathieuResidual
    (atwood bond beta amplitude omega time value second : ℝ) : ℝ :=
  second + (-rayleighTaylorFrequencySq atwood bond beta +
    faradayMathieuForcing amplitude atwood beta * Real.cos (omega * time)) * value

/-- Removing vibration recovers the autonomous Rayleigh--Taylor equation exactly. -/
@[simp] theorem rayleighTaylorFaradayMathieuResidual_zero_amplitude
    (atwood bond beta omega time value second : ℝ) :
    rayleighTaylorFaradayMathieuResidual atwood bond beta 0 omega time value second =
      second - rayleighTaylorFrequencySq atwood bond beta * value := by
  simp [rayleighTaylorFaradayMathieuResidual, faradayMathieuForcing]
  ring

/-- Reversing forcing phase is equivalent to reversing forcing amplitude. -/
theorem rayleighTaylorFaradayMathieuResidual_phase_pi
    (atwood bond beta amplitude time value second : ℝ) (omega : Set.Ioi (0 : ℝ)) :
    rayleighTaylorFaradayMathieuResidual atwood bond beta amplitude omega
        (time + Real.pi / (omega : ℝ)) value second =
      rayleighTaylorFaradayMathieuResidual atwood bond beta (-amplitude) omega time value second := by
  have homega : (omega : ℝ) ≠ 0 := ne_of_gt omega.2
  have hphase : (omega : ℝ) * (time + Real.pi / (omega : ℝ)) =
      (omega : ℝ) * time + Real.pi := by
    field_simp [homega]
  rw [rayleighTaylorFaradayMathieuResidual, rayleighTaylorFaradayMathieuResidual, hphase,
    Real.cos_add_pi]
  simp only [faradayMathieuForcing]
  ring

/-! ## Floquet harmonic shifts -/

/-- Complex exponent `gamma + i n omega` of the `n`th Floquet harmonic in equation (12). -/
def faradayHarmonicExponent (base : ℂ) (n : ℤ) (omega : ℝ) : ℂ :=
  base + Complex.I * (n : ℂ) * (omega : ℂ)

/-- Every integer Floquet harmonic has the same multiplier after one forcing period. -/
theorem exp_faradayHarmonicExponent_mul_period
    (base : ℂ) (n : ℤ) (omega : Set.Ioi (0 : ℝ)) :
    Complex.exp (faradayHarmonicExponent base n omega *
        (((2 * Real.pi / (omega : ℝ) : ℝ)) : ℂ)) =
      Complex.exp (base * (((2 * Real.pi / (omega : ℝ) : ℝ)) : ℂ)) := by
  have homega : (omega : ℝ) ≠ 0 := ne_of_gt omega.property
  have hexponent :
      faradayHarmonicExponent base n omega *
          (((2 * Real.pi / (omega : ℝ) : ℝ)) : ℂ) =
        base * (((2 * Real.pi / (omega : ℝ) : ℝ)) : ℂ) +
          (n : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    rw [faradayHarmonicExponent]
    push_cast
    field_simp [homega]
  rw [hexponent, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

/-! ## Floquet growth rate and the corpus monodromy -/

/-- Closed data needed by equation (23): positive period and positive multiplier radius. -/
structure FaradayFloquetData where
  period : ℝ
  period_pos : 0 < period
  multiplierRadius : ℝ
  multiplierRadius_pos : 0 < multiplierRadius

/-- Equation (23): growth per unit time is logarithmic multiplier growth per period. -/
def faradayFloquetGrowthRate (D : FaradayFloquetData) : ℝ :=
  Real.log D.multiplierRadius / D.period

/-- Inverse form of equation (23): one period exponentiates back to multiplier radius. -/
theorem exp_faradayFloquetGrowthRate_mul_period (D : FaradayFloquetData) :
    Real.exp (faradayFloquetGrowthRate D * D.period) = D.multiplierRadius := by
  rw [faradayFloquetGrowthRate, div_mul_cancel₀ _ (ne_of_gt D.period_pos),
    Real.exp_log D.multiplierRadius_pos]

theorem faradayFloquetGrowthRate_pos_iff (D : FaradayFloquetData) :
    0 < faradayFloquetGrowthRate D ↔ 1 < D.multiplierRadius := by
  constructor
  · intro h
    rcases div_pos_iff.mp h with hgood | himpossible
    · exact (Real.log_pos_iff D.multiplierRadius_pos.le).mp hgood.1
    · exact absurd D.period_pos (not_lt_of_ge himpossible.2.le)
  · intro h
    exact div_pos ((Real.log_pos_iff D.multiplierRadius_pos.le).mpr h) D.period_pos

theorem faradayFloquetGrowthRate_neg_iff (D : FaradayFloquetData) :
    faradayFloquetGrowthRate D < 0 ↔ D.multiplierRadius < 1 := by
  constructor
  · intro h
    rcases div_neg_iff.mp h with himpossible | hgood
    · exact absurd D.period_pos (not_lt_of_ge himpossible.2.le)
    · exact (Real.log_neg_iff D.multiplierRadius_pos).mp hgood.1
  · intro h
    exact (div_neg_iff.mpr (Or.inr
      ⟨(Real.log_neg_iff D.multiplierRadius_pos).mpr h, D.period_pos⟩))

theorem faradayFloquetGrowthRate_eq_zero_iff (D : FaradayFloquetData) :
    faradayFloquetGrowthRate D = 0 ↔ D.multiplierRadius = 1 := by
  rw [faradayFloquetGrowthRate, div_eq_zero_iff]
  constructor
  · rintro (hlog | hperiod)
    · rcases Real.log_eq_zero.mp hlog with hzero | hone | hneg
      · exact absurd hzero (ne_of_gt D.multiplierRadius_pos)
      · exact hone
      · nlinarith [D.multiplierRadius_pos]
    · exact absurd hperiod (ne_of_gt D.period_pos)
  · intro h
    left
    simp [h]

/-- A periodic corpus Klein--Gordon clock with every analytic side condition stored as data. -/
structure CertifiedFaradayKGClock
    (E : Type*) [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] where
  W : ℝ → (Lp ℂ 2 (volume : Measure E) →L[ℂ] Lp ℂ 2 (volume : Measure E))
  bound : ℝ
  period : ℝ
  bound_nonneg : 0 ≤ bound
  norm_le_bound : ∀ r : ℝ, ‖W r‖ ≤ bound
  strongly_continuous : ∀ x : Lp ℂ 2 (volume : Measure E), Continuous fun r : ℝ => W r x
  periodic : ∀ r : ℝ, W (r + period) = W r
  period_pos : 0 < period

section CorpusClock

variable {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
  [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- Real multiplier radius of the certified corpus monodromy. -/
def kgFaradayMultiplierRadius (C : CertifiedFaradayKGClock E) : ℝ :=
  (spectralRadius ℂ (kgMonodromy C.W C.bound C.bound_nonneg C.norm_le_bound
    C.strongly_continuous C.period)).toReal

theorem kgFaradayMultiplierRadius_pos (C : CertifiedFaradayKGClock E) :
    0 < kgFaradayMultiplierRadius C := by
  rw [kgFaradayMultiplierRadius]
  apply ENNReal.toReal_pos
  · intro hzero
    have hann := spectralRadius_kgMonodromy_mem_annulus C.bound_nonneg C.norm_le_bound
      C.strongly_continuous C.periodic
    rw [hzero] at hann
    have hpos : (0 : ENNReal) < ENNReal.ofReal
        (Real.exp (-(C.bound * |C.period|))) := by
      rw [ENNReal.ofReal_pos]
      exact Real.exp_pos _
    exact (not_le_of_gt hpos) hann.1
  · exact spectralRadius_kgMonodromy_ne_top (T := C.period) C.bound_nonneg C.norm_le_bound
      C.strongly_continuous C.periodic

/-- Paper growth datum canonically induced by the corpus monodromy. -/
def kgFaradayFloquetData (C : CertifiedFaradayKGClock E) : FaradayFloquetData where
  period := C.period
  period_pos := C.period_pos
  multiplierRadius := kgFaradayMultiplierRadius C
  multiplierRadius_pos := kgFaradayMultiplierRadius_pos C

/-- Paper's matrix formula becomes the spectral-radius growth rate of the corpus monodromy. -/
theorem kgFaradayFloquetGrowthRate_eq (C : CertifiedFaradayKGClock E) :
    faradayFloquetGrowthRate (kgFaradayFloquetData C) =
      Real.log ((spectralRadius ℂ (kgMonodromy C.W C.bound C.bound_nonneg
        C.norm_le_bound C.strongly_continuous C.period)).toReal) / C.period := by
  rfl

/-- The corpus's asymptotic period-by-period estimate can be written using the paper's growth rate. -/
theorem eventually_norm_kgFieldStateT_le_of_faradayGrowthRate
    (C : CertifiedFaradayKGClock E) (epsilon : Set.Ioi (0 : ℝ))
    (g h : Lp ℂ 2 (volume : Measure E)) :
    ∀ᶠ n : ℕ in atTop, ‖kgFieldStateT C.W g h (n * C.period)‖ ≤
      (Real.exp (faradayFloquetGrowthRate (kgFaradayFloquetData C) * C.period) +
        (epsilon : ℝ)) ^ n * ‖kgPair E (g, h)‖ := by
  have hbase : Real.exp (faradayFloquetGrowthRate (kgFaradayFloquetData C) * C.period) =
      kgFaradayMultiplierRadius C := by
    rw [faradayFloquetGrowthRate]
    simp only [kgFaradayFloquetData]
    rw [div_mul_cancel₀ _ (ne_of_gt C.period_pos), Real.exp_log (kgFaradayMultiplierRadius_pos C)]
  rw [hbase, kgFaradayMultiplierRadius]
  exact eventually_norm_kgFieldStateT_le_of_spectralRadius C.bound_nonneg C.norm_le_bound
    C.strongly_continuous C.periodic epsilon.property g h

end CorpusClock

end GaloisForLFunctions.HTGeometry
