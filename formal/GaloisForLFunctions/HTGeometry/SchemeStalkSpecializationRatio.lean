import Mathlib.AlgebraicGeometry.ResidueField
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# The residue field at a generization is generated by ratios of germs

For a scheme `X` and points `x ⤳ y`, the local ring `𝒪_{X,x}` is a localization of `𝒪_{X,y}`:
any affine open containing `y` also contains `x`, and both stalks are localizations of the ring of
sections there.  Consequently every element of the residue field `κ (x)` is a ratio

`t = a (x) / b (x)` with `a , b ∈ 𝒪_{X,y}` and `b (x) ≠ 0`

of values at `x` of germs living at `y`.  This is the form of the statement that is used to
identify `κ (x)` with the fraction field of the image of `𝒪_{X,y}` in it.
-/

namespace HTGeometry

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

variable {X : Scheme.{u}} {x y : X}

/-- Evaluation at a generization `x` of germs at a specialization `y`. -/
noncomputable def stalkValueHom (h : x ⤳ y) :
    X.presheaf.stalk y →+* X.residueField x :=
  (X.presheaf.stalkSpecializes h ≫ X.residue x).hom

/-- The value at `x` of a germ at a specialization `y`. -/
noncomputable def stalkValue (h : x ⤳ y) (a : X.presheaf.stalk y) : X.residueField x :=
  stalkValueHom h a

theorem stalkValue_def (h : x ⤳ y) (a : X.presheaf.stalk y) :
    stalkValue h a = (X.residue x).hom ((X.presheaf.stalkSpecializes h).hom a) := rfl

@[simp] theorem stalkValue_zero (h : x ⤳ y) : stalkValue h 0 = 0 := map_zero (stalkValueHom h)

@[simp] theorem stalkValue_one (h : x ⤳ y) : stalkValue h 1 = 1 := map_one (stalkValueHom h)

@[simp] theorem stalkValue_mul (h : x ⤳ y) (a b : X.presheaf.stalk y) :
    stalkValue h (a * b) = stalkValue h a * stalkValue h b := map_mul (stalkValueHom h) a b

@[simp] theorem stalkValue_add (h : x ⤳ y) (a b : X.presheaf.stalk y) :
    stalkValue h (a + b) = stalkValue h a + stalkValue h b := map_add (stalkValueHom h) a b

@[simp] theorem stalkValue_sub (h : x ⤳ y) (a b : X.presheaf.stalk y) :
    stalkValue h (a - b) = stalkValue h a - stalkValue h b := map_sub (stalkValueHom h) a b

/-- **Every element of the residue field at a generization is a ratio of values of germs at the
specialization.**  An affine open around `y` contains `x`, and the stalk at `x` is the localization
of the sections there at the prime of `x`, so a lift of `t` is `α / σ` with `σ` invertible at `x`;
the germs of `α` and `σ` at `y` are the required elements. -/
theorem exists_stalkValue_ratio (h : x ⤳ y) (t : X.residueField x) :
    ∃ a b : X.presheaf.stalk y, stalkValue h b ≠ 0 ∧ t * stalkValue h b = stalkValue h a := by
  obtain ⟨U, hU, hyU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := y) (U := ⊤) trivial
  have hxU : x ∈ U := h.mem_open U.isOpen hyU
  letI instAlg : Algebra Γ(X, U) (X.presheaf.stalk x) :=
    X.presheaf.algebra_section_stalk (⟨x, hxU⟩ : ↥U)
  haveI instLoc : IsLocalization.AtPrime (X.presheaf.stalk x)
      (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal := hU.isLocalization_stalk ⟨x, hxU⟩
  obtain ⟨u, hu⟩ := X.residue_surjective x t
  obtain ⟨⟨α, σ⟩, hσ⟩ :=
    IsLocalization.surj (M := (hU.primeIdealOf (⟨x, hxU⟩ : ↥U)).asIdeal.primeCompl) u
  have hgerm : ∀ s : Γ(X, U), (X.presheaf.stalkSpecializes h).hom (X.presheaf.germ U y hyU s)
      = X.presheaf.germ U x hxU s := by
    intro s
    have := X.presheaf.germ_stalkSpecializes (U := U) hyU h
    exact congrArg (fun f : Γ(X, U) ⟶ _ => f.hom s) this
  have halg : ∀ s : Γ(X, U),
      (algebraMap Γ(X, U) (X.presheaf.stalk x)) s = X.presheaf.germ U x hxU s := fun _ => rfl
  refine ⟨X.presheaf.germ U y hyU α, X.presheaf.germ U y hyU σ, ?_, ?_⟩
  · have hunit : IsUnit ((algebraMap Γ(X, U) (X.presheaf.stalk x)) (σ : Γ(X, U))) :=
      IsLocalization.map_units (X.presheaf.stalk x) σ
    have hne : (X.residue x).hom (X.presheaf.germ U x hxU (σ : Γ(X, U))) ≠ 0 := by
      rw [← halg]
      intro hzero
      have hmem : (algebraMap Γ(X, U) (X.presheaf.stalk x)) (σ : Γ(X, U))
          ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
        (IsLocalRing.residue_eq_zero_iff _).1 hzero
      exact (IsLocalRing.maximalIdeal.isMaximal (X.presheaf.stalk x)).ne_top
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).eq_top_of_isUnit_mem hmem hunit)
    simpa [stalkValue, stalkValueHom, hgerm] using hne
  · have := congrArg (fun z => (X.residue x).hom z) hσ
    simp only [halg] at this
    simpa [stalkValue, stalkValueHom, hgerm, hu, map_mul] using this

end HTGeometry
