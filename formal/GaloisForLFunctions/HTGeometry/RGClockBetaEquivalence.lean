import GaloisForLFunctions.HTGeometry.AffineFirstOrderDifferentialAlgebraicity
import GaloisForLFunctions.HTGeometry.DifferentialAdjoinFiniteTrdeg
import GaloisForLFunctions.HTGeometry.FiniteDifferentialCircuitBoundary

/-!
# The exact RG clock and the exact beta field

For a hyperbolic renormalization germ with linearizer `Φ`, inverse `κ = Φ⁻¹`, beta field
`β = (log λ)κ/κ′` and clock `τ = log κ/log λ`, the three objects generate the same differential
field up to one algebraic step, so any one of them is differentially algebraic exactly when the
others are.  The mechanism is the affine first-order law over the differential field generated by
whichever object is assumed differentially algebraic.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {F L : Type*} [Field F] [Field L] [Algebra F L]
  [Differential F] [Differential L] [DifferentialAlgebra F L] [CharZero L]

/-- **First-order transfer over a differentially algebraic coefficient.**  If `y′ = a·y + b` with
`a` and `b` in the differential field generated by a differentially algebraic element, then `y` is
differentially algebraic over the base. -/
theorem differentialAlgebraicOver_of_firstOrder_over_adjoin {x : L}
    (hx : DifferentialAlgebraicOver F x) {y : L}
    (a b : differentialAdjoin F ({x} : Set L))
    (hrel : y′ = (a : L) * y + (b : L)) :
    DifferentialAlgebraicOver F y := by
  letI := derivationClosedDifferential (differentialAdjoin F ({x} : Set L))
    (derivationClosed_differentialAdjoin F ({x} : Set L))
  have hy : DifferentialAlgebraicOver (differentialAdjoin F ({x} : Set L)) y :=
    differentialAlgebraicOver_of_deriv_eq_base_mul_add a b hrel
  exact differentialAlgebraicOver_of_intermediate_trdeg_lt_aleph0
    (differentialAdjoin F ({x} : Set L))
    (derivationClosed_differentialAdjoin F ({x} : Set L))
    (differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hx) hy

/-- Every element of the differential field generated by a differentially algebraic element is
differentially algebraic. -/
theorem differentialAlgebraicOver_of_mem_adjoin {x : L} (hx : DifferentialAlgebraicOver F x)
    {y : L} (hy : y ∈ differentialAdjoin F ({x} : Set L)) :
    DifferentialAlgebraicOver F y :=
  differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    (differentialAdjoin F ({x} : Set L))
    (derivationClosed_differentialAdjoin F ({x} : Set L))
    (differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hx) hy

/-! ## The clock–beta equivalence -/

set_option maxHeartbeats 1000000 in
/-- **The exact RG clock is differentially algebraic exactly when the exact beta field is.**  Both
are equivalent to differential algebraicity of the inverse linearizer `κ`, since each pair is
linked by a first-order relation with coefficients in the field generated by the other. -/
theorem differentialAlgebraicOver_clock_iff_beta {c : F} (hc : c ≠ 0) {κ β τ : L}
    (hκ : κ ≠ 0) (hκ' : κ′ ≠ 0)
    (hβ : β * κ′ = algebraMap F L c * κ)
    (hτ : τ′ * (algebraMap F L c * κ) = κ′) :
    (DifferentialAlgebraicOver F κ ↔ DifferentialAlgebraicOver F β)
      ∧ (DifferentialAlgebraicOver F κ ↔ DifferentialAlgebraicOver F τ) := by
  have hcL : algebraMap F L c ≠ 0 := by
    intro h
    exact hc ((injective_iff_map_eq_zero (algebraMap F L)).mp
      (algebraMap F L).injective _ h)
  have hβ0 : β ≠ 0 := by
    intro h
    rw [h, zero_mul] at hβ
    exact (mul_ne_zero hcL hκ) hβ.symm
  constructor
  · constructor
    · intro hκDA
      refine differentialAlgebraicOver_of_mem_adjoin hκDA ?_
      have hmemκ : κ ∈ differentialAdjoin F ({κ} : Set L) :=
        subset_differentialAdjoin F ({κ} : Set L) rfl
      have hmemκ' : κ′ ∈ differentialAdjoin F ({κ} : Set L) :=
        derivationClosed_differentialAdjoin F ({κ} : Set L) hmemκ
      have hβeq : β = algebraMap F L c * κ / κ′ := by
        field_simp
        linear_combination hβ
      rw [hβeq]
      exact IntermediateField.div_mem _
        (IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ c) hmemκ) hmemκ'
    · intro hβDA
      have hmemβ : β ∈ differentialAdjoin F ({β} : Set L) := subset_differentialAdjoin F ({β} : Set L) rfl
      have ha : algebraMap F L c / β ∈ differentialAdjoin F ({β} : Set L) :=
        IntermediateField.div_mem _ (IntermediateField.algebraMap_mem _ c) hmemβ
      refine differentialAlgebraicOver_of_firstOrder_over_adjoin hβDA
        ⟨_, ha⟩ ⟨0, IntermediateField.zero_mem _⟩ ?_
      show κ′ = (algebraMap F L c / β) * κ + 0
      field_simp
      linear_combination -hβ
  · constructor
    · intro hκDA
      have hmemκ : κ ∈ differentialAdjoin F ({κ} : Set L) := subset_differentialAdjoin F ({κ} : Set L) rfl
      have hmemκ' : κ′ ∈ differentialAdjoin F ({κ} : Set L) :=
        derivationClosed_differentialAdjoin F ({κ} : Set L) hmemκ
      have hb : κ′ / (algebraMap F L c * κ) ∈ differentialAdjoin F ({κ} : Set L) :=
        IntermediateField.div_mem _ hmemκ'
          (IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ c) hmemκ)
      refine differentialAlgebraicOver_of_firstOrder_over_adjoin hκDA
        ⟨0, IntermediateField.zero_mem _⟩ ⟨_, hb⟩ ?_
      show τ′ = 0 * τ + κ′ / (algebraMap F L c * κ)
      rw [zero_mul, zero_add, eq_div_iff (mul_ne_zero hcL hκ)]
      exact hτ
    · intro hτDA
      have hmemτ : τ ∈ differentialAdjoin F ({τ} : Set L) := subset_differentialAdjoin F ({τ} : Set L) rfl
      have hmemτ' : τ′ ∈ differentialAdjoin F ({τ} : Set L) :=
        derivationClosed_differentialAdjoin F ({τ} : Set L) hmemτ
      have ha : algebraMap F L c * τ′ ∈ differentialAdjoin F ({τ} : Set L) :=
        IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ c) hmemτ'
      refine differentialAlgebraicOver_of_firstOrder_over_adjoin hτDA
        ⟨_, ha⟩ ⟨0, IntermediateField.zero_mem _⟩ ?_
      show κ′ = (algebraMap F L c * τ′) * κ + 0
      rw [add_zero]
      linear_combination -hτ

end

end GaloisForLFunctions.HTGeometry
