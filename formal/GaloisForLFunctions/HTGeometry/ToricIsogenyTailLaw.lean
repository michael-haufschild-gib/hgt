import GaloisForLFunctions.HTGeometry.TorusExpandingProtocolTail
import GaloisForLFunctions.HTGeometry.TorusProtocolMonomialTail
import GaloisForLFunctions.HTGeometry.AutonomousTailBridge
import GaloisForLFunctions.HTGeometry.StableCoreFunctoriality
import GaloisForLFunctions.HTGeometry.ToricLogTail

/-!
# The stable tail of a torus isogeny is its logarithmic-current frame

An isogeny of the split torus is a nonsingular integer matrix acting on the characters of a
differentially generic point.  Its stable tail — the intersection of all iterated pullback fields —
is the fixed field of the sector erased by the isogeny.  For a purely expanding isogeny the erased
sector separates characters, so the tail is exactly the differential field generated by the
logarithmic currents `δχ_i / χ_i`: every rational position is destroyed while the full differential
dimension survives in the flat frame.

The transport law is exact: an integral character matrix moves the logarithmic-current frame by the
same matrix, so a pure multiplication scales every current by its degree.

The tail depends only on the differential function field and the pullback, so it is unchanged by
any birational identification — in particular by passing from the dense torus to a toric
compactification, where the currents are the logarithmic one-forms of the boundary divisor.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

/-! ## Birational invariance of a stable tail -/

/-- **Birational invariance of the stable tail.**  A differential isomorphism intertwining two
endomorphisms carries the stable tail of one onto the stable tail of the other. -/
theorem map_stableRangeCore_of_algEquiv_intertwine
    {K E F : Type*} [Field K] [Field E] [Field F] [Algebra K E] [Algebra K F]
    (ι : E ≃ₐ[K] F) (ψ : E →ₐ[K] E) (φ : F →ₐ[K] F)
    (hcomm : ∀ z, φ (ι z) = ι (ψ z)) :
    IntermediateField.map ι.toAlgHom (stableRangeCore ψ) = stableRangeCore φ := by
  refine le_antisymm (map_stableRangeCore_le_of_intertwine ι.toAlgHom ψ φ hcomm) ?_
  have hcomm' : ∀ z, ψ (ι.symm z) = ι.symm (φ z) := by
    intro z
    apply ι.injective
    rw [ι.apply_symm_apply, ← hcomm, ι.apply_symm_apply]
  have hle := map_stableRangeCore_le_of_intertwine ι.symm.toAlgHom φ ψ hcomm'
  intro z hz
  have hmem : ι.symm z ∈ stableRangeCore ψ :=
    hle ⟨z, hz, rfl⟩
  exact ⟨ι.symm z, hmem, by simp⟩

section Torus

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E] [CharZero C] [IsAlgClosed C]

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

omit [CharZero C] [IsAlgClosed C] in
include hx hgen in
/-- A constant torus protocol is the constant sequence of one torus endomorphism. -/
theorem torusProtocol_const {A : Matrix (Fin r) (Fin r) ℤ} (hA : A.det ≠ 0)
    {m : ℕ → Matrix (Fin r) (Fin r) ℤ} (hmA : ∀ j, m j = A) (hm : ∀ j, (m j).det ≠ 0) :
    torusProtocol hx hgen m hm = fun _ => torusEndo hx hgen hA := by
  funext j
  exact torusEndo_congr hx hgen (hm j) hA (hmA j)

/-! ## The autonomous isogeny tail -/

include hx hgen in
/-- **The autonomous torus isogeny tail.**  The stable tail of a single nonsingular integer matrix
acting by monomial substitution is the fixed field of the sector it erases on the constant torus. -/
theorem torusEndo_stableRangeCore_eq_fixedField
    {A : Matrix (Fin r) (Fin r) ℤ} (hA : A.det ≠ 0) :
    stableRangeCore (torusEndo hx hgen hA)
      = IntermediateField.fixedField
          ((erasedSector (torusProtocolGroup C fun _ => A) 0).map (torusScaleRep hx hgen)) := by
  letI : TopologicalSpace (Fin r → Cˣ) := ⊥
  haveI : DiscreteTopology (Fin r → Cˣ) := ⟨rfl⟩
  haveI : IsTopologicalGroup (Fin r → Cˣ) := inferInstance
  have hm : ∀ j : ℕ, ((fun _ => A) j).det ≠ 0 := fun _ => hA
  have hclosure : erasedClosure (torusProtocolGroup C fun _ => A) 0
      = erasedSector (torusProtocolGroup C fun _ => A) 0 := by
    refine SetLike.ext' ?_
    exact (isClosed_discrete _).closure_eq
  rw [← nonautonomousTail_const_eq_stableRangeCore (torusEndo hx hgen hA) 0,
    ← torusProtocol_const hx hgen hA (fun _ => rfl) hm,
    torusProtocol_nonautonomousTail_eq_fixedField hx hgen (fun _ => A) hm 0, hclosure]

include hx hgen in
/-- **Theorem A: the exact autonomous isogeny tail.**  The stable tail of a nonsingular integer
isogeny of the split torus is the differential field generated by the logarithmic currents of the
palette together with the monomials whose exponent vector is annihilated by every erased scaling —
that is, by the coordinates of the quotient torus and the Maurer–Cartan frame. -/
theorem torusEndo_stableRangeCore_eq_torusInvariantMonomialField (hconst : ∀ c : C, c′ = 0)
    {A : Matrix (Fin r) (Fin r) ℤ} (hA : A.det ≠ 0) :
    stableRangeCore (torusEndo hx hgen hA)
      = (torusInvariantMonomialField C x
          ((erasedSector (torusProtocolGroup C fun _ => A) 0 : Subgroup (Fin r → Cˣ)) :
            Set (Fin r → Cˣ))).restrictScalars C := by
  rw [torusEndo_stableRangeCore_eq_fixedField hx hgen hA]
  exact fixedField_torusScaleRep_eq_torusInvariantMonomialField hx hgen hconst _

include hx hgen in
/-- **The autonomous separating isogeny tail.**  When the erased sector separates characters the
stable tail is exactly the logarithmic-current field. -/
theorem torusEndo_stableRangeCore_eq_torusVelocityField (hconst : ∀ c : C, c′ = 0)
    {A : Matrix (Fin r) (Fin r) ℤ} (hA : A.det ≠ 0)
    (hsep : ∀ e d : Fin r →₀ ℕ,
      (∀ u ∈ erasedSector (torusProtocolGroup C fun _ => A) 0,
        (∏ i, ((u i : C)) ^ e i) = ∏ i, ((u i : C)) ^ d i) → e = d) :
    stableRangeCore (torusEndo hx hgen hA) = torusVelocityField C x := by
  rw [torusEndo_stableRangeCore_eq_fixedField hx hgen hA]
  exact fixedField_torusScaleRep_eq_torusVelocityField hx hgen hconst _ hsep

/-! ## Pure multiplication -/

theorem ne_zero_of_two_le {N : ℕ} (hN : 2 ≤ N) : N ≠ 0 := by omega

/-- The pure multiplication isogeny matrix of degree `N`. -/
theorem det_scalarMatrix_ne_zero {N : ℕ} (hN : N ≠ 0) :
    (Matrix.diagonal fun _ : Fin r => (N : ℤ)).det ≠ 0 := by
  rw [Matrix.det_diagonal, Finset.prod_const]
  exact pow_ne_zero _ (Int.natCast_ne_zero.mpr hN)

include hx hgen in
/-- **Pure multiplication erases every position.**  For an integer degree at least two the stable
tail of the power isogeny is exactly the logarithmic-current field of the palette. -/
theorem torusPowerEndo_stableRangeCore_eq_torusVelocityField (hconst : ∀ c : C, c′ = 0)
    {N : ℕ} (hN : 2 ≤ N) :
    stableRangeCore
        (torusEndo hx hgen (det_scalarMatrix_ne_zero (r := r) (ne_zero_of_two_le hN)))
      = torusVelocityField C x := by
  letI : TopologicalSpace (Fin r → Cˣ) := ⊥
  haveI : DiscreteTopology (Fin r → Cˣ) := ⟨rfl⟩
  haveI : IsTopologicalGroup (Fin r → Cˣ) := inferInstance
  have hK : ∀ j : ℕ, 2 ≤ (fun _ : ℕ => N) j := fun _ => hN
  have hdet : ∀ j, (scalarStepMatrix r (fun _ : ℕ => N) j).det ≠ 0 :=
    det_scalarStepMatrix_ne_zero (scalarStep_ne_zero hK)
  have hstep : ∀ j : ℕ, scalarStepMatrix r (fun _ : ℕ => N) j
      = Matrix.diagonal fun _ : Fin r => (N : ℤ) := fun _ => rfl
  rw [← nonautonomousTail_const_eq_stableRangeCore _ 0,
    ← torusProtocol_const hx hgen
      (det_scalarMatrix_ne_zero (r := r) (ne_zero_of_two_le hN)) hstep hdet]
  exact scalarTorusProtocol_nonautonomousTail_eq_torusVelocityField hx hgen hconst hK 0

/-! ## The character-matrix transport law -/

omit [CharZero C] [IsAlgClosed C] in
include hx hgen in
/-- **The exact transport law.**  A nonsingular integer character matrix moves the complete
logarithmic-current frame by the same matrix. -/
theorem torusEndo_logDeriv {A : Matrix (Fin r) (Fin r) ℤ} (hA : A.det ≠ 0) (i : Fin r) :
    torusEndo hx hgen hA (Differential.logDeriv (x i))
      = ∑ j, ((A i j : ℤ) : E) * Differential.logDeriv (x j) := by
  have hx0 : ∀ j, x j ≠ 0 := torus_palette_ne_zero hx
  have hmap : torusEndo hx hgen hA (Differential.logDeriv (x i))
      = Differential.logDeriv (torusEndo hx hgen hA (x i)) := by
    rw [Differential.logDeriv, Differential.logDeriv, map_div₀, torusEndo_deriv]
  rw [hmap, torusEndo_apply, monomialFamily_apply]
  exact toricLogCurrent_laurentMonomial (Finset.univ : Finset (Fin r)) x (A i)
    (fun j _ => hx0 j)

omit [CharZero C] [IsAlgClosed C] in
include hx hgen in
/-- **Pure multiplication scales every logarithmic current by its degree.** -/
theorem torusPowerEndo_logDeriv {N : ℕ} (hN : N ≠ 0) (i : Fin r) :
    torusEndo hx hgen (det_scalarMatrix_ne_zero (r := r) hN) (Differential.logDeriv (x i))
      = (N : E) * Differential.logDeriv (x i) := by
  rw [torusEndo_logDeriv hx hgen (det_scalarMatrix_ne_zero (r := r) hN) i]
  rw [Finset.sum_eq_single i]
  · rw [Matrix.diagonal_apply_eq]
    norm_cast
  · intro j _ hji
    rw [Matrix.diagonal_apply_ne _ (Ne.symm hji)]
    norm_num
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-! ## The toric tail law -/

include hx hgen in
/-- **The toric expanding-tail law.**  For a differentially generic point of the split torus and a
pure multiplication of degree at least two, the stable tail is the differential field of the
logarithmic currents; those currents are differentially independent, so the tail has the full
differential dimension of the torus; the tail meets the rational function field of the position only
in the constants; and the isogeny scales every current by its degree. -/
theorem toricPowerIsogenyTail (hconst : ∀ c : C, c′ = 0) {N : ℕ} (hN : 2 ≤ N) :
    stableRangeCore
        (torusEndo hx hgen
          (det_scalarMatrix_ne_zero (r := r) (ne_zero_of_two_le hN)))
        = torusVelocityField C x
      ∧ DifferentialIndependent C (fun k => Differential.logDeriv (x k))
      ∧ torusVelocityField C x ⊓ IntermediateField.adjoin C (Set.range x)
          = (⊥ : IntermediateField C E)
      ∧ ∀ i, torusEndo hx hgen
            (det_scalarMatrix_ne_zero (r := r) (ne_zero_of_two_le hN))
            (Differential.logDeriv (x i))
          = (N : E) * Differential.logDeriv (x i) :=
  ⟨torusPowerEndo_stableRangeCore_eq_torusVelocityField hx hgen hconst hN,
    differentialIndependent_logDeriv hx,
    torusVelocityField_inf_adjoin_eq_bot hx hgen hconst,
    fun i => torusPowerEndo_logDeriv hx hgen (ne_zero_of_two_le hN) i⟩

end Torus

end

end GaloisForLFunctions.HTGeometry
