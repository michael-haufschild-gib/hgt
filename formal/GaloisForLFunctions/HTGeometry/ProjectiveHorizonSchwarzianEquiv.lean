import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianIndependence
import GaloisForLFunctions.HTGeometry.FreeCoordinateBasisEquiv

/-!
# The Schwarzian change of coordinates

The Schwarzian system is algebraically independent and generating, so it presents the free scalar
jet field as a free rational coordinate field on its own index.  The identification sends the
`m`-th free coordinate to the `m`-th Schwarzian coordinate: the first three to the jets of the base
coordinate, the rest to the jets of the Schwarzian.

Along this identification the projective gauge moves only the first three coordinates, so a
statement about coordinate derivations transports into a statement about the gauge.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- **The Schwarzian change of coordinates.** -/
def schwarzianBasisEquiv (C : Type*) [Field C] [CharZero C] :
    FreeCoordinateRationalField C ℕ ≃ₐ[C] FreeScalarJetField C :=
  freeCoordinateBasisEquiv algebraicIndependent_schwarzianSystem schwarzianSystem_adjoin_eq_top

@[simp]
theorem schwarzianBasisEquiv_freeCoordinate (m : ℕ) :
    schwarzianBasisEquiv C (freeCoordinate C ℕ m) = schwarzianSystem C m :=
  freeCoordinateBasisEquiv_freeCoordinate _ _ m

theorem schwarzianBasisEquiv_freeCoordinate_of_lt {m : ℕ} (hm : m < 3) :
    schwarzianBasisEquiv C (freeCoordinate C ℕ m) = freeCoordinate C ℕ m := by
  rw [schwarzianBasisEquiv_freeCoordinate, schwarzianSystem_of_lt hm]

theorem schwarzianBasisEquiv_freeCoordinate_of_ge {m : ℕ} (hm : 3 ≤ m) :
    schwarzianBasisEquiv C (freeCoordinate C ℕ m) =
      differentialJet (m - 3) (freeJetSchwarzian C) := by
  rw [schwarzianBasisEquiv_freeCoordinate, schwarzianSystem_of_ge hm]

omit [CharZero C] in
/-- The image of the coordinates from index three on is the differential field generated by the
Schwarzian. -/
theorem schwarzianBasisEquiv_image_tail :
    schwarzianSystem C '' {m : ℕ | 3 ≤ m} =
      Set.range (fun k : ℕ => differentialJet k (freeJetSchwarzian C)) := by
  ext z
  constructor
  · rintro ⟨m, hm, rfl⟩
    exact ⟨m - 3, (schwarzianSystem_of_ge hm).symm⟩
  · rintro ⟨k, rfl⟩
    refine ⟨k + 3, by simp, ?_⟩
    rw [schwarzianSystem_of_ge (by omega), show k + 3 - 3 = k from by omega]

end

end GaloisForLFunctions.HTGeometry
