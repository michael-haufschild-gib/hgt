import GaloisForLFunctions.HTGeometry.MilnorKGrading
import Mathlib.Algebra.Field.Subfield.Basic

/-!
# Functoriality of Milnor `K`-theory, and reduction to finitely generated subfields

A homomorphism of fields carries units to units and the Steinberg relation to the Steinberg
relation, so it induces a homomorphism of Milnor `K`-rings sending symbols to symbols.  Since
homomorphisms preserve torsion, a length-two symbol of a field is torsion as soon as its
counterpart in the subfield generated by its two entries is.

* `milnorKMap` : **the induced homomorphism of Milnor `K`-rings.**
* `milnorKMap_symbol` : it sends symbols to symbols.
* `milnorSymbol_mul_torsion_of_map` : **torsion descends along a field homomorphism.**
-/

namespace GaloisForLFunctions.HTGeometry

section Functoriality

variable {F E : Type*} [Field F] [Field E]

/-- The unit map induced by a field homomorphism. -/
def milnorUnitMap (f : F →+* E) : Fˣ →* Eˣ := Units.map (f : F →* E)

@[simp]
theorem milnorUnitMap_val (f : F →+* E) (a : Fˣ) : ((milnorUnitMap f a : Eˣ) : E) = f (a : F) :=
  rfl

/-- The additive map on the generators of the tensor algebra. -/
def milnorSymbolHom (f : F →+* E) : Additive Fˣ →+ MilnorK E where
  toFun a := milnorSymbol (milnorUnitMap f (Additive.toMul a))
  map_zero' := by
    show milnorSymbol (milnorUnitMap f 1) = 0
    rw [map_one, milnorSymbol_one]
  map_add' a b := by
    show milnorSymbol (milnorUnitMap f (Additive.toMul a * Additive.toMul b)) = _
    rw [map_mul, milnorSymbol_mul]

/-- The lift of the generator map to the tensor algebra. -/
def milnorKPreMap (f : F →+* E) : TensorAlgebra ℤ (Additive Fˣ) →ₐ[ℤ] MilnorK E :=
  TensorAlgebra.lift ℤ (milnorSymbolHom f).toIntLinearMap

@[simp]
theorem milnorKPreMap_ι (f : F →+* E) (a : Fˣ) :
    milnorKPreMap f (TensorAlgebra.ι ℤ (Additive.ofMul a)) = milnorSymbol (milnorUnitMap f a) := by
  rw [milnorKPreMap, TensorAlgebra.lift_ι_apply]
  rfl

/-- The image of a nonunit-free element stays away from `1`. -/
theorem milnorUnitMap_ne_one (f : F →+* E) {a : Fˣ} (ha : (a : F) ≠ 1) :
    ((milnorUnitMap f a : Eˣ) : E) ≠ 1 := by
  rw [milnorUnitMap_val]
  intro hone
  exact ha (f.injective (by rw [hone, map_one]))

theorem milnorUnitMap_oneSubUnit (f : F →+* E) {a : Fˣ} (ha : (a : F) ≠ 1) :
    milnorUnitMap f (oneSubUnit ha) = oneSubUnit (milnorUnitMap_ne_one f ha) := by
  refine Units.ext ?_
  rw [milnorUnitMap_val, oneSubUnit_val, oneSubUnit_val, map_sub, map_one, milnorUnitMap_val]

/-- **The homomorphism of Milnor `K`-rings induced by a field homomorphism.** -/
def milnorKMap (f : F →+* E) : MilnorK F →ₐ[ℤ] MilnorK E :=
  RingQuot.liftAlgHom ℤ ⟨milnorKPreMap f, by
    rintro x y ⟨a, ha⟩
    rw [map_mul, milnorKPreMap_ι, milnorKPreMap_ι, map_zero, milnorUnitMap_oneSubUnit]
    exact milnorSymbol_mul_oneSub (milnorUnitMap_ne_one f ha)⟩

@[simp]
theorem milnorKMap_symbol (f : F →+* E) (a : Fˣ) :
    milnorKMap f (milnorSymbol a) = milnorSymbol (milnorUnitMap f a) := by
  rw [milnorKMap, milnorSymbol, milnorKMk, RingQuot.liftAlgHom_mkAlgHom_apply, milnorKPreMap_ι]

/-- **Torsion descends along a field homomorphism.**  If the symbol of the preimages is torsion
then so is the symbol. -/
theorem milnorSymbol_mul_torsion_of_map (f : F →+* E) {a b : Fˣ}
    (h : (milnorSymbol a * milnorSymbol b : MilnorK F) ∈ torsionAddSubgroup (MilnorK F)) :
    (milnorSymbol (milnorUnitMap f a) * milnorSymbol (milnorUnitMap f b) : MilnorK E)
      ∈ torsionAddSubgroup (MilnorK E) := by
  obtain ⟨n, hn, hnz⟩ := h
  refine ⟨n, hn, ?_⟩
  have himg := congrArg (milnorKMap f) hnz
  rw [map_zsmul, map_mul, milnorKMap_symbol, milnorKMap_symbol, map_zero] at himg
  exact himg

/-- **Torsion of a length-two symbol descends along any field homomorphism hitting its
entries.** -/
theorem milnorSymbol_mul_torsion_of_ringHom (f : F →+* E) {a b : Eˣ} {x y : Fˣ}
    (hx : f (x : F) = (a : E)) (hy : f (y : F) = (b : E))
    (h : (milnorSymbol x * milnorSymbol y : MilnorK F) ∈ torsionAddSubgroup (MilnorK F)) :
    (milnorSymbol a * milnorSymbol b : MilnorK E) ∈ torsionAddSubgroup (MilnorK E) := by
  have hmap := milnorSymbol_mul_torsion_of_map f h
  have hxa : milnorUnitMap f x = a := Units.ext hx
  have hyb : milnorUnitMap f y = b := Units.ext hy
  rwa [hxa, hyb] at hmap


/-- **Torsion of a length-two symbol descends from any subfield containing its entries.** -/
theorem milnorSymbol_mul_torsion_of_subfield {F : Type*} [Field F] (K : Subfield F)
    {a b : Fˣ} {x y : Kˣ}
    (hx : ((x : K) : F) = (a : F)) (hy : ((y : K) : F) = (b : F))
    (h : (milnorSymbol x * milnorSymbol y : MilnorK K) ∈ torsionAddSubgroup (MilnorK K)) :
    (milnorSymbol a * milnorSymbol b : MilnorK F) ∈ torsionAddSubgroup (MilnorK F) := by
  have hmap := milnorSymbol_mul_torsion_of_map K.subtype h
  have hxa : milnorUnitMap K.subtype x = a := Units.ext hx
  have hyb : milnorUnitMap K.subtype y = b := Units.ext hy
  rwa [hxa, hyb] at hmap


end Functoriality

end GaloisForLFunctions.HTGeometry
