import GaloisForLFunctions.HTGeometry.IndependentFrequencyRank
import GaloisForLFunctions.HTGeometry.DirichletStripAlmostPeriodic

/-!
# Hypertranscendence of a Dirichlet series with independent exponents

A Dirichlet series `∑ a n e^{-λ n s}` that converges uniformly on the closed substrips of a vertical
strip is almost periodic there, and its Bohr spectrum on a line contains every exponent `-λ n` whose
coefficient is nonzero.  A `ℤ`-independent family of `K + 1` such exponents therefore forces the
rational frequency rank of the line restriction above `K`.

If that happens for every `K`, the rank is infinite, and the finite phase law forbids any nontrivial
differential relation with Gamma-field coefficients: the series is hypertranscendental over the
differential field generated by the rational functions and `Γ`.
-/

open Filter Topology

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions

open _root_.HTGeometry

/-- **A Dirichlet series with exponents of infinite rank has no Gamma-field relation.**  The
uniform convergence makes the series almost periodic on the strip; each `K + 1`-element
`ℤ`-independent family of exponents with nonzero coefficients pushes the rational frequency rank of
the line restriction past `K`; and infinite rank contradicts the finite phase law. -/
theorem dirichlet_no_gammaField_relation {n N k r : ℕ} {σ R rr ρ : ℝ} (hσ : 0 < σ)
    (hr : 0 < rr) (hρ : 0 < ρ) (hrρ : rr + ρ < R) (hR : 0 < R)
    (a : ℕ → ℂ) (lam : ℕ → ℝ) (D : ℂ → ℂ) (hinj : Function.Injective lam)
    (hD : DifferentiableOn ℂ D (verticalStrip σ R))
    (hconv : ∀ r' : ℝ, r' < R → ∀ ε : ℝ, 0 < ε → ∃ n₀ : ℕ, ∀ z ∈ closedStrip σ r',
      ‖D z - ∑ i ∈ Finset.range n₀, a i * Complex.exp (-(lam i : ℂ) * z)‖ ≤ ε)
    {f : ℝ →ᵇ ℂ} (hf : ∀ x : ℝ, f x = D ((σ : ℂ) + (x : ℂ) * Complex.I))
    (hfu : UniformContinuous (fun x => f x)) (hftb : HasTotallyBoundedOrbit (fun x => f x))
    [MeasurableSpace (BohrHull f)] [BorelSpace (BohrHull f)]
    (hrank : ∀ K : ℕ, ∃ idx : Fin (K + 1) → ℕ, (∀ i, a (idx i) ≠ 0) ∧
      (∀ i : Fin (K + 1), ∀ ε : ℝ, 0 < ε → ∃ n₀ : ℕ, idx i < n₀ ∧ ∀ t : ℝ,
        ‖D ((σ : ℂ) + (t : ℂ) * Complex.I)
          - ∑ i' ∈ Finset.range n₀,
            a i' * Complex.exp (-(lam i' : ℂ) * ((σ : ℂ) + (t : ℂ) * Complex.I))‖ ≤ ε) ∧
      LinearIndependent ℤ (fun i : Fin (K + 1) => -(lam (idx i))))
    (e : Fin N → Fin (n + 1) → ℕ) (F : Fin N → ℂ → ℂ)
    (j : Fin N → Fin k → ℕ) (p q : Fin N → Fin k → Polynomial ℂ)
    (E : Fin N → Fin k → Fin (r + 1) → ℕ)
    (jb : ℕ) (pb qb : Polynomial ℂ) (Db : ℕ)
    (hq : ∀ α i, q α i ≠ 0) (hqb : qb ≠ 0) (hpb : pb ≠ 0)
    (hdom : ∀ α i, GammaMonomialDominates (j α i) (p α i) (q α i) (E α i 0) jb pb qb Db)
    (β : Fin N)
    (hc : (∑ i, gammaJetLimit (j β i) (p β i) (q β i) (E β i) jb pb qb Db) ≠ 0)
    (hF : ∀ (α : Fin N) (t : ℝ),
      F α ((σ : ℂ) + (t : ℂ) * Complex.I)
        = ∑ i, gammaJetEltG σ (j α i) (p α i) (q α i) (E α i) t)
    (hrel : ∀ s : ℂ, ∑ α, F α s * ∏ i : Fin (n + 1), (iteratedDeriv (i : ℕ) D s) ^ (e α i) = 0)
    (he : Function.Injective e) : False := by
  have hap : IsStripAlmostPeriodic D σ R := isStripAlmostPeriodic_dirichlet a lam D hconv
  have hDa : IsBohrAlmostPeriodic fun t : ℝ => D ((σ : ℂ) + (t : ℂ) * Complex.I) :=
    isBohrAlmostPeriodic_line hR hap
  have hinf : ∀ K : ℕ, ¬ (Module.rank ℤ (bohrHullFrequencies f) ≤ (K : Cardinal)) := by
    intro K
    obtain ⟨idx, ha, hm, hind⟩ := hrank K
    exact not_rank_le_of_dirichlet_independent a lam D hinj hf hDa K idx ha hm hind
  exact no_gammaField_relation_of_infinite_rank hσ hr hρ hrρ hR hD hap e F j p q E jb pb qb Db
    hq hqb hpb hdom β hc hF hrel he hf hfu hftb hinf

end GaloisForLFunctions
