import GaloisForLFunctions.HTGeometry.QuadraticTowerSquareClasses
import GaloisForLFunctions.HTGeometry.QuadraticRootFlip

/-!
# Every block transposition of a multiquadratic splitting field is realized

A polynomial that factors into pairwise coprime quadratics splits over the multiquadratic extension
generated by the square roots of the block discriminants.  When those discriminants are independent
in the square-class group of the base, each square root can be negated independently, and negating
one of them transposes exactly the two roots of that block.

## Main results

* `exists_algEquiv_swap_quadRoot` — the block transposition, as a base algebra automorphism.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- **Every block transposition is realized.**  With the block discriminants independent in the
square-class group of the base and the splitting field generated by their square roots, negating one
square root gives a base automorphism transposing exactly that block's two roots. -/
theorem exists_algEquiv_swap_quadRoot
    {F L : Type*} [Field F] [Field L] [Algebra F L]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s ρ : ι → L) (h2 : (2 : L) ≠ 0)
    (hs : ∀ z, s z ∈ baseRange F L)
    (enum : ι ≃ Fin (Fintype.card ι))
    (hsq : ∀ z, ρ z * ρ z ∈ baseRange F L)
    (hindep : ∀ T : Finset ι, T.Nonempty →
      ¬ IsSqIn (baseRange F L) (∏ z ∈ T, ρ z * ρ z))
    (htop : radicalStage (baseRange F L)
      (fun n => if h : n < Fintype.card ι then ρ (enum.symm ⟨n, h⟩) else 1)
      (Fintype.card ι) = ⊤)
    (hcard : 0 < Fintype.card ι)
    (z₀ : ι) :
    ∃ σ : L ≃ₐ[F] L, ∀ p : ι × Bool,
      σ (quadRoot s ρ p) = quadRoot s ρ (Equiv.swap ((z₀, true) : ι × Bool) (z₀, false) p) := by
  classical
  set k : ℕ := Fintype.card ι - 1 with hk
  have hk1 : k + 1 = Fintype.card ι := by omega
  set ρ' : ℕ → L := fun n => if h : n < Fintype.card ι then ρ (enum.symm ⟨n, h⟩) else 1 with hρ'
  have hρ'apply : ∀ z : ι, ρ' (enum z) = ρ z := by
    intro z
    rw [hρ']
    have hlt : ((enum z : Fin (Fintype.card ι)) : ℕ) < Fintype.card ι := (enum z).2
    simp only [dif_pos hlt]
    congr 1
    exact enum.symm_apply_apply z
  have hsq' : ∀ j, j < k + 1 → ρ' j * ρ' j ∈ baseRange F L := by
    intro j hj
    rw [hk1] at hj
    rw [hρ']
    simp only [dif_pos hj]
    exact hsq _
  have hindep' : ∀ T : Finset ℕ, T ⊆ Finset.range (k + 1) → T.Nonempty →
      ¬ IsSqIn (baseRange F L) (∏ i ∈ T, ρ' i * ρ' i) := by
    intro T hT hne
    set S : Finset ι := T.image (fun n => if h : n < Fintype.card ι then enum.symm ⟨n, h⟩
      else enum.symm ⟨0, hcard⟩) with hS
    have hmem : ∀ n ∈ T, n < Fintype.card ι := by
      intro n hn
      have := Finset.mem_range.mp (hT hn)
      omega
    have hinj : ∀ a ∈ T, ∀ b ∈ T,
        (if h : a < Fintype.card ι then enum.symm ⟨a, h⟩ else enum.symm ⟨0, hcard⟩)
          = (if h : b < Fintype.card ι then enum.symm ⟨b, h⟩ else enum.symm ⟨0, hcard⟩) → a = b := by
      intro a ha b hb hab
      rw [dif_pos (hmem a ha), dif_pos (hmem b hb)] at hab
      have := enum.symm.injective hab
      exact congrArg Fin.val this
    have hSne : S.Nonempty := by
      obtain ⟨n, hn⟩ := hne
      exact ⟨_, Finset.mem_image_of_mem _ hn⟩
    have hprod : (∏ i ∈ T, ρ' i * ρ' i) = ∏ z ∈ S, ρ z * ρ z := by
      rw [hS, Finset.prod_image hinj]
      refine Finset.prod_congr rfl fun n hn => ?_
      rw [dif_pos (hmem n hn), hρ']
      simp only [dif_pos (hmem n hn)]
    rw [hprod]
    exact hindep S hSne
  have htop' : radicalStage (baseRange F L) ρ' (k + 1) = ⊤ := by
    rw [hk1]
    exact htop
  have hj₀ : ((enum z₀ : Fin (Fintype.card ι)) : ℕ) ≤ k := by
    have := (enum z₀).2
    omega
  obtain ⟨σ, hfix, hneg⟩ :=
    exists_algEquiv_neg_index (F := F) ρ' k ((enum z₀ : Fin (Fintype.card ι)) : ℕ) hj₀ h2
      hsq' hindep' htop'
  refine ⟨σ, fun p => ?_⟩
  refine map_quadRoot_of_flip s ρ z₀ (σ : L ≃+* L) ?_ ?_ ?_ p
  · intro z
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp (hs z)
    rw [← hx]
    exact σ.commutes x
  · intro z hz
    have hne : ((enum z : Fin (Fintype.card ι)) : ℕ) ≠ ((enum z₀ : Fin (Fintype.card ι)) : ℕ) := by
      intro h
      exact hz (enum.injective (Fin.ext h))
    have hlt : ((enum z : Fin (Fintype.card ι)) : ℕ) < k + 1 := by
      have := (enum z).2
      omega
    have := hfix _ hlt hne
    rwa [hρ'apply z] at this
  · have := hneg
    rwa [hρ'apply z₀] at this

end

end GaloisForLFunctions.HTGeometry
