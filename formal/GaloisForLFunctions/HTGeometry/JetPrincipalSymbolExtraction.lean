import GaloisForLFunctions.HTGeometry.RatFuncPositiveJetFieldReconstruction
import GaloisForLFunctions.HTGeometry.DifferentialLurothSingleGenerator
import GaloisForLFunctions.HTGeometry.ScalarDifferentialOrderWitness
import GaloisForLFunctions.HTGeometry.FreeCoordinateConstantKernel
import GaloisForLFunctions.HTGeometry.FreeDifferentialProtocolTimeLaw
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonActualSchwarzianDiamond

/-!
# Extracting a principal symbol inside the differential field it generates

Let `x` be the free generator of the free differential rational field on one scalar coordinate and
let `K` be a derivation-closed intermediate field strictly above the coefficients.  Differential
Lüroth presents `K` as `C⟨u⟩` for a single `u`.  If `u` has exact scalar differential order `r`,
then every element of `K` of exact order `n` is rational in `u, …, u^{(n-r)}`, and among those jets
only the top one meets the coordinate `x_n`.  Hence the coordinate derivation `∂/∂x_n` acts on that
part of `K` as a multiple of one fixed element, and the ratio of its values on two such elements
lies back in `K`.

That ratio is the classical principal-symbol quotient.  Applied to the pair
`x_n`, `δ^n(r(x))` it produces the ordinary derivative `r'(x)` inside the field generated by the two
deep observations, which is the missing step in the rational-observation reconstruction law.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-! ## The coordinate partials of the one-generator jet field -/

omit [CharZero C] in
theorem pd_eq_freeCoordinateDerivation {ι : Type*} (p : ι × ℕ) :
    (JetField.pd p : Derivation C (JetField C ι) (JetField C ι)) =
      freeCoordinateDerivation C (ι × ℕ) p := rfl

/-! ## Principal symbols survive differentiation -/

omit [CharZero C] in
/-- Differentiating raises the coordinate range by at most one. -/
theorem pd_differentialJet_eq_zero_of_gt {u : JetField C Unit} {m : ℕ}
    (hu : ∀ k : ℕ, m < k → JetField.pd ((), k) u = 0) :
    ∀ l j : ℕ, m + l < j → JetField.pd ((), j) (differentialJet l u) = 0 := by
  intro l
  induction l with
  | zero =>
      intro j hj
      rw [differentialJet_zero]
      exact hu j (by omega)
  | succ l ih =>
      intro j hj
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      rw [differentialJet_succ, JetField.pd_deriv_succ, ih (j' + 1) (by omega),
        ih j' (by omega), map_zero, add_zero]

omit [CharZero C] in
/-- **Principal symbols are invariant under differentiation.**  The top coordinate derivative of
the `l`-th jet equals the top coordinate derivative of the observable itself. -/
theorem pd_differentialJet_top {u : JetField C Unit} {m : ℕ}
    (hu : ∀ k : ℕ, m < k → JetField.pd ((), k) u = 0) (l : ℕ) :
    JetField.pd ((), m + l) (differentialJet l u) = JetField.pd ((), m) u := by
  induction l with
  | zero => rw [differentialJet_zero, Nat.add_zero]
  | succ l ih =>
      rw [show m + (l + 1) = (m + l) + 1 from by omega, differentialJet_succ,
        JetField.pd_deriv_succ,
        pd_differentialJet_eq_zero_of_gt hu l (m + l + 1) (by omega), map_zero, zero_add, ih]

/-! ## A derivation with one free direction on a finitely generated subfield -/

/-- If a derivation sends every generator of an adjoined field into a fixed multiple of one
element, then it does so on the whole field. -/
theorem exists_mem_mul_of_mem_adjoin
    {C A : Type*} [Field C] [Field A] [Algebra C A]
    (D : Derivation C A A) (t : A) (S : Set A)
    (hS : ∀ g ∈ S, ∃ q ∈ IntermediateField.adjoin C S, D g = q * t)
    {v : A} (hv : v ∈ IntermediateField.adjoin C S) :
    ∃ q ∈ IntermediateField.adjoin C S, D v = q * t := by
  apply IntermediateField.adjoin_induction C
    (p := fun y _ => ∃ q ∈ IntermediateField.adjoin C S, D y = q * t)
  · exact hS
  · intro c
    exact ⟨0, zero_mem _, by rw [Derivation.map_algebraMap, zero_mul]⟩
  · rintro y w hy hw ⟨qy, hqy, hDy⟩ ⟨qw, hqw, hDw⟩
    exact ⟨qy + qw, add_mem hqy hqw, by rw [map_add, hDy, hDw, add_mul]⟩
  · rintro y hy ⟨qy, hqy, hDy⟩
    refine ⟨-(y⁻¹ ^ (2 : ℕ)) * qy, mul_mem (neg_mem (pow_mem (inv_mem hy) 2)) hqy, ?_⟩
    rw [Derivation.leibniz_inv, smul_eq_mul, hDy]
    ring
  · rintro y w hy hw ⟨qy, hqy, hDy⟩ ⟨qw, hqw, hDw⟩
    refine ⟨y * qw + w * qy, add_mem (mul_mem hy hqw) (mul_mem hw hqy), ?_⟩
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, hDy, hDw]
    ring
  · exact hv

omit [CharZero C] in
/-- A derivation killing every generator of an adjoined field kills the whole field. -/
theorem derivation_eq_zero_of_mem_adjoin
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    (D : Derivation K A A) (S : Set A) (hS : ∀ g ∈ S, D g = 0)
    {v : A} (hv : v ∈ IntermediateField.adjoin K S) : D v = 0 := by
  obtain ⟨q, -, hq⟩ := exists_mem_mul_of_mem_adjoin D 0 S
    (fun g hg => ⟨0, zero_mem _, by rw [hS g hg, mul_zero]⟩) hv
  rw [hq, mul_zero]

omit [CharZero C] in
/-- Coordinate partials above the observational resolution annihilate everything visible below
it. -/
theorem pd_eq_zero_of_mem_jetObservableField {n N : ℕ} (hN : N ≤ n)
    {v : JetField C Unit}
    (hv : v ∈ jetObservableField C (JetField.jet ((), 0) : JetField C Unit) N) :
    JetField.pd ((), n) v = 0 := by
  rw [jetObservableField] at hv
  refine derivation_eq_zero_of_mem_adjoin _ _ ?_ hv
  rintro _ ⟨m, hm, rfl⟩
  change m < N at hm
  simp only [JetField.differentialJet_jet_of_zero]
  refine JetField.pd_jet_of_ne ?_
  intro hcon
  have hnm : n = m := congrArg Prod.snd hcon
  omega

/-! ## The extraction theorem -/

section Extraction

local instance jetPrincipalSymbolConstantDifferential : Differential C := ⟨0⟩

local instance jetPrincipalSymbolDifferentialAlgebra :
    DifferentialAlgebra C (JetField C Unit) :=
  ⟨fun c ↦ by
    change (algebraMap C (JetField C Unit) c)′ = algebraMap C (JetField C Unit) 0
    rw [JetField.deriv_algebraMap, map_zero]⟩

omit [CharZero C] in
theorem hypertranscendentalOver_freeGen :
    HypertranscendentalOver C (JetField.jet ((), 0) : JetField C Unit) :=
  (hypertranscendentalOver_iff_differentialIndependent_singleton C _).mpr
    JetField.differentialIndependent_jet

omit [CharZero C] in
theorem freeGen_notMem_bot_of_hasScalarDifferentialOrder
    {v : JetField C Unit} {n : ℕ}
    (hv : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) v n) :
    v ∉ (⊥ : IntermediateField C (JetField C Unit)) := by
  intro hbot
  refine hv.2 ?_
  have h0 : (⊥ : IntermediateField C (JetField C Unit)) ≤
      jetObservableField C (JetField.jet ((), 0) : JetField C Unit) n := bot_le
  exact h0 hbot

/-- **Principal-symbol extraction.**  Inside a derivation-closed intermediate field strictly above
the coefficients, the ratio of the top coordinate derivatives of two elements of the same exact
scalar differential order lies in that field. -/
theorem exists_mem_pd_ratio
    (K : IntermediateField C (JetField C Unit)) (hKclosed : DerivationClosed K)
    (hKbot : K ≠ ⊥) {n : ℕ} {v w : JetField C Unit} (hv : v ∈ K) (hw : w ∈ K)
    (hvo : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) v n)
    (hwo : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) w n)
    (hvne : JetField.pd ((), n) v ≠ 0) :
    ∃ q ∈ K, JetField.pd ((), n) w = q * JetField.pd ((), n) v := by
  classical
  set x : JetField C Unit := JetField.jet ((), 0) with hx
  have hxHT : HypertranscendentalOver C x := hypertranscendentalOver_freeGen
  have hxtop : differentialAdjoin C ({x} : Set (JetField C Unit)) = ⊤ :=
    differentialAdjoin_jet_zero_eq_top
  -- Lüroth presentation of `K`
  obtain ⟨u, hu⟩ := differentialLuroth (F := C) (E := JetField C Unit) K hKclosed
    (y := x) (by rw [hxtop]; exact le_top) JetField.differentialIndependent_jet hKbot
  have humem : u ∈ K := by
    rw [← hu]
    exact IntermediateField.subset_adjoin C _ ⟨u, rfl, 0, differentialJet_zero u⟩
  have hubot : u ∉ (⊥ : IntermediateField C (JetField C Unit)) := by
    intro hbot
    refine hKbot ?_
    refine le_antisymm ?_ bot_le
    rw [← hu]
    refine differentialAdjoin_le C ?_ derivationClosed_bot
    rintro z hz
    rw [Set.mem_singleton_iff] at hz
    exact hz ▸ hbot
  obtain ⟨r, huo, -⟩ := existsUnique_hasScalarDifferentialOrder
    (C := C) (E := JetField C Unit) (y := x) (z := u) (by rw [hxtop]; trivial) hubot
  -- orders of `v` and `w` over the Lüroth generator
  have hvmemu : v ∈ differentialAdjoin C ({u} : Set (JetField C Unit)) := by rw [hu]; exact hv
  have hwmemu : w ∈ differentialAdjoin C ({u} : Set (JetField C Unit)) := by rw [hu]; exact hw
  obtain ⟨s, hvs, -⟩ := existsUnique_hasScalarDifferentialOrder hvmemu
    (freeGen_notMem_bot_of_hasScalarDifferentialOrder hvo)
  obtain ⟨s', hws, -⟩ := existsUnique_hasScalarDifferentialOrder hwmemu
    (freeGen_notMem_bot_of_hasScalarDifferentialOrder hwo)
  have hsum : s + r = n :=
    (HasScalarDifferentialOrder.comp hxHT huo hvs).order_eq hvo
  have hsum' : s' + r = n :=
    (HasScalarDifferentialOrder.comp hxHT huo hws).order_eq hwo
  have hss : s' = s := by omega
  rw [hss] at hws
  -- the finitely generated part of `K` containing both
  set S : Set (JetField C Unit) := (fun i : ℕ => differentialJet i u) '' Set.Iio (s + 1) with hS
  have hLK : IntermediateField.adjoin C S ≤ K := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, -, rfl⟩
    rw [← hu]
    exact IntermediateField.subset_adjoin C _ ⟨u, rfl, i, rfl⟩
  set t : JetField C Unit := JetField.pd ((), n) (differentialJet s u) with ht
  have hgen : ∀ g ∈ S, ∃ q ∈ IntermediateField.adjoin C S,
      JetField.pd ((), n) g = q * t := by
    rintro _ ⟨i, hi, rfl⟩
    change i < s + 1 at hi
    rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp hi) with hlt | rfl
    · refine ⟨0, zero_mem _, ?_⟩
      have hord := huo.differentialJet_order hxHT i
      have hle : r + i + 1 ≤ n := by omega
      rw [pd_eq_zero_of_mem_jetObservableField hle hord.1, zero_mul]
    · exact ⟨1, one_mem _, by rw [one_mul]⟩
  -- both elements are visible in that part
  have hvL : v ∈ IntermediateField.adjoin C S := by
    have hmem := hvs.1
    rw [jetObservableField] at hmem
    exact hmem
  have hwL : w ∈ IntermediateField.adjoin C S := by
    have hmem := hws.1
    rw [jetObservableField] at hmem
    exact hmem
  obtain ⟨qv, hqv, hDv⟩ := exists_mem_mul_of_mem_adjoin _ t S hgen hvL
  obtain ⟨qw, hqw, hDw⟩ := exists_mem_mul_of_mem_adjoin _ t S hgen hwL
  have hqv0 : qv ≠ 0 := by
    intro hzero
    exact hvne (by rw [hDv, hzero, zero_mul])
  refine ⟨qw / qv, div_mem (hLK hqw) (hLK hqv), ?_⟩
  rw [hDw, hDv]
  field_simp

/-! ## The rational-observation reconstruction law -/

omit [CharZero C] in
/-- If a derivation preserves the generators of an adjoined field, it preserves the field. -/
theorem derivation_mem_adjoin_of_mem_adjoin
    {K A : Type*} [Field K] [Field A] [Algebra K A]
    (D : Derivation K A A) (S : Set A)
    (hS : ∀ g ∈ S, D g ∈ IntermediateField.adjoin K S)
    {v : A} (hv : v ∈ IntermediateField.adjoin K S) :
    D v ∈ IntermediateField.adjoin K S := by
  obtain ⟨q, hq, hDv⟩ := exists_mem_mul_of_mem_adjoin D 1 S
    (fun g hg => ⟨D g, hS g hg, (mul_one _).symm⟩) hv
  rw [hDv, mul_one]
  exact hq

omit [CharZero C] in
theorem ratFuncEval_mem_adjoin {K E : Type*} [Field K] [Field E] [Algebra K E]
    {y : E} (hy : Transcendental K y) (p : RatFunc K) :
    ratFuncEval y hy p ∈ IntermediateField.adjoin K ({y} : Set E) :=
  ((RatFunc.algEquivOfTranscendental y hy) p).2

omit [CharZero C] in
theorem exists_ratFuncEval_of_mem_adjoin {K E : Type*} [Field K] [Field E] [Algebra K E]
    {y : E} (hy : Transcendental K y) {z : E}
    (hz : z ∈ IntermediateField.adjoin K ({y} : Set E)) :
    ∃ p : RatFunc K, ratFuncEval y hy p = z := by
  refine ⟨(RatFunc.algEquivOfTranscendental y hy).symm ⟨z, hz⟩, ?_⟩
  rw [ratFuncEval, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply]
  rfl

section Reconstruction

variable [IsAlgClosed C]

omit [CharZero C] [IsAlgClosed C] in
/-- The free generator of the one-coordinate jet field is transcendental. -/
theorem transcendental_freeGen :
    Transcendental C (JetField.jet ((), 0) : JetField C Unit) :=
  JetField.algebraicIndependent_jet_free.transcendental (((), 0) : Unit × ℕ)

omit [CharZero C] [IsAlgClosed C] in
theorem pd_eq_zero_of_mem_adjoin_freeGen {k : ℕ} (hk : 0 < k)
    {v : JetField C Unit}
    (hv : v ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit))) :
    JetField.pd ((), k) v = 0 := by
  refine derivation_eq_zero_of_mem_adjoin _ _ ?_ hv
  rintro g hg
  rw [Set.mem_singleton_iff] at hg
  subst hg
  refine JetField.pd_jet_of_ne ?_
  intro hcon
  have hk0 : k = 0 := congrArg Prod.snd hcon
  omega

omit [CharZero C] [IsAlgClosed C] in
theorem pd_zero_mem_adjoin_freeGen {v : JetField C Unit}
    (hv : v ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit))) :
    JetField.pd ((), 0) v ∈
      IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)) := by
  refine derivation_mem_adjoin_of_mem_adjoin _ _ ?_ hv
  rintro g hg
  rw [Set.mem_singleton_iff] at hg
  subst hg
  rw [JetField.pd_jet_self]
  exact one_mem _

omit [IsAlgClosed C] in
/-- **The principal symbol of a nonaffine rational view is nonconstant.**  If the coordinate
derivative of a rational view of the free generator were a constant, the view would be affine. -/
theorem exists_affine_of_pd_zero_ratFuncEval_mem_bot {r : RatFunc C}
    (hbot : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen r) ∈
      (⊥ : IntermediateField C (JetField C Unit))) :
    ∃ a b : C, r = RatFunc.C a * RatFunc.X + RatFunc.C b := by
  classical
  obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp hbot
  set x : JetField C Unit := JetField.jet ((), 0) with hxdef
  set rx : JetField C Unit := ratFuncEval x transcendental_freeGen r with hrx
  set y : JetField C Unit := rx - algebraMap C (JetField C Unit) a * x with hy
  have hxmem : x ∈ IntermediateField.adjoin C ({x} : Set (JetField C Unit)) :=
    IntermediateField.subset_adjoin C _ rfl
  have hrxmem : rx ∈ IntermediateField.adjoin C ({x} : Set (JetField C Unit)) :=
    ratFuncEval_mem_adjoin _ r
  have hymem : y ∈ IntermediateField.adjoin C ({x} : Set (JetField C Unit)) :=
    sub_mem hrxmem (mul_mem (IntermediateField.algebraMap_mem _ a) hxmem)
  have hzero : ∀ i : Unit × ℕ,
      freeCoordinateDerivation C (Unit × ℕ) i (y : FreeCoordinateRationalField C (Unit × ℕ)) = 0 := by
    rintro ⟨j, k⟩
    obtain rfl : j = () := rfl
    have hpd : JetField.pd ((), k) y = 0 := by
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · rw [hy, map_sub, Derivation.leibniz, JetField.pd_jet_self,
          Derivation.map_algebraMap, smul_zero, smul_eq_mul, mul_one, ← ha]
        ring
      · rw [hy, map_sub, Derivation.leibniz, Derivation.map_algebraMap, smul_zero,
          smul_eq_mul, pd_eq_zero_of_mem_adjoin_freeGen hk hrxmem,
          pd_eq_zero_of_mem_adjoin_freeGen hk hxmem]
        ring
    exact hpd
  obtain ⟨b, hb⟩ := exists_algebraMap_of_forall_freeCoordinateDerivation_eq_zero hzero
  have hbJ : y = algebraMap C (JetField C Unit) b := hb
  refine ⟨a, b, ?_⟩
  refine ratFuncEval_injective x transcendental_freeGen ?_
  rw [map_add, map_mul, ratFuncEval_C, ratFuncEval_C, ratFuncEval_X]
  have : rx = algebraMap C (JetField C Unit) a * x + algebraMap C (JetField C Unit) b := by
    rw [← hbJ, hy]
    ring
  exact this

/-- **The nonaffine reconstruction law.**  For a rational view whose coordinate derivative is
nonconstant, the differential field generated by the `n`-th jets of the free generator and of the
view is everything. -/
theorem differentialAdjoin_jets_eq_top_of_pd_notMem_bot {r : RatFunc C} {n : ℕ} (hn : 0 < n)
    (hbot : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen r) ∉
      (⊥ : IntermediateField C (JetField C Unit))) :
    differentialAdjoin C
        ({differentialJet n (JetField.jet ((), 0) : JetField C Unit),
          differentialJet n (ratFuncEval _ transcendental_freeGen r)} :
          Set (JetField C Unit)) = ⊤ := by
  classical
  set x : JetField C Unit := JetField.jet ((), 0) with hxdef
  have hxt : Transcendental C x := transcendental_freeGen
  have hxHT : HypertranscendentalOver C x := hypertranscendentalOver_freeGen
  set rx : JetField C Unit := ratFuncEval x hxt r with hrx
  set v : JetField C Unit := differentialJet n x with hv
  set w : JetField C Unit := differentialJet n rx with hw
  set K : IntermediateField C (JetField C Unit) :=
    differentialAdjoin C ({v, w} : Set (JetField C Unit)) with hK
  have hKclosed : DerivationClosed K := derivationClosed_differentialAdjoin C _
  have hvK : v ∈ K := IntermediateField.subset_adjoin C _ ⟨v, by simp, 0, differentialJet_zero v⟩
  have hwK : w ∈ K := IntermediateField.subset_adjoin C _ ⟨w, by simp, 0, differentialJet_zero w⟩
  have hvorder : HasScalarDifferentialOrder C x v n :=
    hasScalarDifferentialOrder_differentialJet hxHT n
  have hrxmem : rx ∈ IntermediateField.adjoin C ({x} : Set (JetField C Unit)) :=
    ratFuncEval_mem_adjoin _ r
  have hrxbot : rx ∉ (⊥ : IntermediateField C (JetField C Unit)) := by
    intro hb
    obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hb
    apply hbot
    rw [← hc, Derivation.map_algebraMap]
    exact zero_mem _
  have hrxorder : HasScalarDifferentialOrder C x rx 0 :=
    hasScalarDifferentialOrder_zero_iff.mpr ⟨hrxmem, hrxbot⟩
  have hworder : HasScalarDifferentialOrder C x w n := by
    have h := hrxorder.differentialJet_order hxHT n
    rwa [Nat.zero_add] at h
  have hvpd : JetField.pd ((), n) v = 1 := by
    rw [hv, hxdef, JetField.differentialJet_jet_of_zero, JetField.pd_jet_self]
  have hwpd : JetField.pd ((), n) w = JetField.pd ((), 0) rx := by
    have h := pd_differentialJet_top (m := 0)
      (fun k hk => pd_eq_zero_of_mem_adjoin_freeGen hk hrxmem) n
    rwa [Nat.zero_add] at h
  have hKbot : K ≠ ⊥ := by
    intro hbotK
    exact freeGen_notMem_bot_of_hasScalarDifferentialOrder hvorder (hbotK ▸ hvK)
  obtain ⟨q, hqK, hq⟩ := exists_mem_pd_ratio K hKclosed hKbot hvK hwK hvorder hworder
    (by rw [hvpd]; exact one_ne_zero)
  have hsym : JetField.pd ((), 0) rx ∈ K := by
    rw [← hwpd, hq, hvpd, mul_one]
    exact hqK
  obtain ⟨r₂, hr₂⟩ := exists_ratFuncEval_of_mem_adjoin hxt
    (pd_zero_mem_adjoin_freeGen hrxmem)
  have hr₂nc : ¬ ∃ c : C, r₂ = RatFunc.C c := by
    rintro ⟨c, rfl⟩
    apply hbot
    rw [← hr₂, ratFuncEval_C]
    exact IntermediateField.mem_bot.mpr ⟨c, rfl⟩
  have htop := rational_positiveJet_observation_eq_top (C := C) hr₂nc hn
  refine top_unique ?_
  rw [← htop]
  refine differentialAdjoin_le C ?_ hKclosed
  rintro z hz
  rcases hz with hz | hz
  · rw [hz, hr₂]
    exact hsym
  · rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact hvK

omit [IsAlgClosed C] in
/-- **The affine failure.**  For an affine view the `n`-th jets generate only the depth-`n` jet
tail, which is a proper subfield. -/
theorem differentialAdjoin_jets_ne_top_of_affine {a b : C} {n : ℕ} (hn : 0 < n) :
    differentialAdjoin C
        ({differentialJet n (JetField.jet ((), 0) : JetField C Unit),
          differentialJet n
            (ratFuncEval _ transcendental_freeGen (RatFunc.C a * RatFunc.X + RatFunc.C b))} :
          Set (JetField C Unit)) ≠ ⊤ := by
  classical
  set x : JetField C Unit := JetField.jet ((), 0) with hxdef
  have hxt : Transcendental C x := transcendental_freeGen
  have hxHT : HypertranscendentalOver C x := hypertranscendentalOver_freeGen
  have hrxval : ratFuncEval x hxt (RatFunc.C a * RatFunc.X + RatFunc.C b)
      = algebraMap C (JetField C Unit) a * x + algebraMap C (JetField C Unit) b := by
    rw [map_add, map_mul, ratFuncEval_C, ratFuncEval_C, ratFuncEval_X]
  have hjet : differentialJet n
      (ratFuncEval x hxt (RatFunc.C a * RatFunc.X + RatFunc.C b))
      = algebraMap C (JetField C Unit) a * differentialJet n x := by
    rw [hrxval, differentialJet_constSlopeAffine x a b rfl n]
    have hb : differentialJet n b = 0 := by
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      rw [differentialJet_succ]
      show (differentialJet m b)′ = 0
      rfl
    rw [hb, map_zero, add_zero]
  intro htop
  have hsub : differentialAdjoin C
      ({differentialJet n x, differentialJet n
        (ratFuncEval x hxt (RatFunc.C a * RatFunc.X + RatFunc.C b))} : Set (JetField C Unit))
      ≤ jetTailField C x n := by
    refine differentialAdjoin_le C ?_ ?_
    · rintro z hz
      rcases hz with hz | hz
      · rw [hz]
        exact differentialJet_mem_jetTailField C x le_rfl
      · rw [Set.mem_singleton_iff] at hz
        rw [hz, hjet]
        exact mul_mem (IntermediateField.algebraMap_mem _ a)
          (differentialJet_mem_jetTailField C x le_rfl)
    · intro z hz
      exact _root_.GaloisForLFunctions.jetTailField_deriv_mem x n hz
  rw [htop] at hsub
  have hxmem : x ∈ jetTailField C x n := hsub (by trivial)
  have hle : jetTailField C x n ≤ jetTailField C x 1 := by
    rw [jetTailField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨m, hm, rfl⟩
    simp only [Set.mem_Ici] at hm
    exact differentialJet_mem_jetTailField C x (by omega)
  exact absurd (hle hxmem) (by
    intro hmem
    have hne : differentialJet 0 x ∈ jetTailField C x 1 := by simpa using hmem
    exact (hypertranscendentalOver_transcendental_over_strictJetTail hxHT 0)
      (by
        let z : jetTailField C x 1 := ⟨differentialJet 0 x, hne⟩
        change IsAlgebraic (jetTailField C x 1) (differentialJet 0 x)
        simpa [z] using! isAlgebraic_algebraMap z))

/-- **Exact affine/nonaffine reconstruction dichotomy.**  For a rational view of the free
generator and every positive depth, the `n`-th jet of the generator together with the `n`-th jet of
the view generates the whole differential field exactly when the view is not affine. -/
theorem differentialAdjoin_jets_eq_top_iff {r : RatFunc C} {n : ℕ} (hn : 0 < n) :
    differentialAdjoin C
        ({differentialJet n (JetField.jet ((), 0) : JetField C Unit),
          differentialJet n (ratFuncEval _ transcendental_freeGen r)} :
          Set (JetField C Unit)) = ⊤ ↔
      ¬ ∃ a b : C, r = RatFunc.C a * RatFunc.X + RatFunc.C b := by
  constructor
  · intro htop hafn
    obtain ⟨a, b, rfl⟩ := hafn
    exact differentialAdjoin_jets_ne_top_of_affine hn htop
  · intro hnaff
    refine differentialAdjoin_jets_eq_top_of_pd_notMem_bot hn ?_
    intro hbot
    exact hnaff (exists_affine_of_pd_zero_ratFuncEval_mem_bot hbot)

end Reconstruction

end Extraction

