import GaloisForLFunctions.HTGeometry.QubitUHFLocalPauli
import GaloisForLFunctions.HTGeometry.ThermodynamicPathCoefficientSummability
import GaloisForLFunctions.HTGeometry.FiniteHorizonCStarPerturbationLaw

/-!
# Standard UHF dynamics of an absolutely summable Pauli path field

An absolutely summable real coefficient field on the countable nearest-neighbour
Pauli labels defines a bounded self-adjoint element of the qubit UHF algebra.
Its exponential is a norm-continuous unitary one-parameter group, and conjugation
therefore gives a point-norm continuous one-parameter group of `C*`-automorphisms.

This is the infinite-volume dynamical layer used by the thermodynamic same-field
recurrence--complexity theorem.  No limiting dynamics is postulated: it is built
inside the standard qubit UHF algebra from the same local coefficients.
-/

open scoped BigOperators
open NormedSpace

namespace GaloisForLFunctions.HTGeometry

open PrimeQuasiLocalCharge

noncomputable section

noncomputable local instance primeUHFNormedAlgebraRat :
    NormedAlgebra ℚ (PrimeUHFAlgebra qubitLocalDim) :=
  NormedAlgebra.restrictScalars ℚ ℂ (PrimeUHFAlgebra qubitLocalDim)

/-- One coefficient-weighted local Pauli observable in the qubit UHF algebra. -/
def infinitePathUHFTerm (p : InfinitePathLabel → ℝ) (i : InfinitePathLabel) :
    PrimeUHFAlgebra qubitLocalDim :=
  ((p i : ℝ) : ℂ) • infinitePathUHFPauli i

@[simp] theorem norm_infinitePathUHFTerm
    (p : InfinitePathLabel → ℝ) (i : InfinitePathLabel) :
    ‖infinitePathUHFTerm p i‖ = |p i| := by
  rw [infinitePathUHFTerm, norm_smul, norm_infinitePathUHFPauli, mul_one,
    Complex.norm_real, Real.norm_eq_abs]

theorem summable_infinitePathUHFTerm
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) :
    Summable (infinitePathUHFTerm p) := by
  apply Summable.of_norm
  simpa only [norm_infinitePathUHFTerm] using hp

theorem isSelfAdjoint_infinitePathUHFTerm
    (p : InfinitePathLabel → ℝ) (i : InfinitePathLabel) :
    IsSelfAdjoint (infinitePathUHFTerm p i) := by
  have hr : IsSelfAdjoint (((p i : ℝ) : ℂ)) := by
    rw [IsSelfAdjoint, RCLike.star_def, Complex.conj_ofReal]
  exact hr.smul (isSelfAdjoint_infinitePathUHFPauli i)

/-- Bounded infinite-volume Hamiltonian of the countable local Pauli field. -/
def infinitePathUHFHamiltonian (p : InfinitePathLabel → ℝ) :
    PrimeUHFAlgebra qubitLocalDim :=
  ∑' i, infinitePathUHFTerm p i

theorem isSelfAdjoint_infinitePathUHFHamiltonian
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) :
    IsSelfAdjoint (infinitePathUHFHamiltonian p) := by
  rw [IsSelfAdjoint, infinitePathUHFHamiltonian]
  have hs := summable_infinitePathUHFTerm hp
  calc
    star (∑' i, infinitePathUHFTerm p i) =
        ∑' i, star (infinitePathUHFTerm p i) := by
      exact hs.map_tsum starAddEquiv continuous_star
    _ = ∑' i, infinitePathUHFTerm p i := by
      apply tsum_congr
      intro i
      exact (isSelfAdjoint_infinitePathUHFTerm p i).star_eq

/-- Schrödinger evolution generated by the bounded infinite-volume Hamiltonian. -/
def infinitePathUHFEvolution (p : InfinitePathLabel → ℝ) (t : ℝ) :
    PrimeUHFAlgebra qubitLocalDim :=
  exp (t • ((-Complex.I) • infinitePathUHFHamiltonian p))

theorem infinitePathUHFEvolution_mem_unitary
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) (t : ℝ) :
    infinitePathUHFEvolution p t ∈ unitary (PrimeUHFAlgebra qubitLocalDim) := by
  apply NormedSpace.exp_mem_unitary_of_mem_skewAdjoint
  apply skewAdjoint.smul_mem
  rw [skewAdjoint.mem_iff, star_smul,
    (isSelfAdjoint_infinitePathUHFHamiltonian hp).star_eq]
  simp

theorem continuous_infinitePathUHFEvolution (p : InfinitePathLabel → ℝ) :
    Continuous (infinitePathUHFEvolution p) := by
  apply NormedSpace.exp_continuous.comp
  fun_prop

@[simp] theorem infinitePathUHFEvolution_zero (p : InfinitePathLabel → ℝ) :
    infinitePathUHFEvolution p 0 = 1 := by
  simp [infinitePathUHFEvolution]

theorem infinitePathUHFEvolution_add
    (p : InfinitePathLabel → ℝ) (s t : ℝ) :
    infinitePathUHFEvolution p (s + t) =
      infinitePathUHFEvolution p s * infinitePathUHFEvolution p t := by
  rw [infinitePathUHFEvolution, infinitePathUHFEvolution,
    infinitePathUHFEvolution, add_smul]
  exact NormedSpace.exp_add_of_commute
    (((Commute.refl ((-Complex.I) • infinitePathUHFHamiltonian p)).smul_left s).smul_right t)

/-- Infinite-volume Heisenberg evolution of an observable. -/
def infinitePathUHFHeisenberg (p : InfinitePathLabel → ℝ)
    (t : ℝ) (A : PrimeUHFAlgebra qubitLocalDim) :
    PrimeUHFAlgebra qubitLocalDim :=
  star (infinitePathUHFEvolution p t) * A * infinitePathUHFEvolution p t

theorem continuous_infinitePathUHFHeisenberg
    (p : InfinitePathLabel → ℝ) (A : PrimeUHFAlgebra qubitLocalDim) :
    Continuous (fun t => infinitePathUHFHeisenberg p t A) := by
  unfold infinitePathUHFHeisenberg
  exact ((continuous_star.comp (continuous_infinitePathUHFEvolution p)).mul
    continuous_const).mul (continuous_infinitePathUHFEvolution p)

/-- The unitary implementing infinite-volume time `t`. -/
def infinitePathUHFUnitary
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) (t : ℝ) :
    unitary (PrimeUHFAlgebra qubitLocalDim) :=
  ⟨infinitePathUHFEvolution p t, infinitePathUHFEvolution_mem_unitary hp t⟩

/-- Standard UHF `C*`-dynamics generated by the infinite Pauli field. -/
def infinitePathUHFDynamics
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) (t : ℝ) :
    PrimeUHFAlgebra qubitLocalDim ≃⋆ₐ[ℂ] PrimeUHFAlgebra qubitLocalDim :=
  Unitary.conjStarAlgAut ℂ (PrimeUHFAlgebra qubitLocalDim)
    (star (infinitePathUHFUnitary hp t))

@[simp] theorem infinitePathUHFDynamics_apply
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|))
    (t : ℝ) (A : PrimeUHFAlgebra qubitLocalDim) :
    infinitePathUHFDynamics hp t A = infinitePathUHFHeisenberg p t A := by
  simp [infinitePathUHFDynamics, infinitePathUHFHeisenberg,
    infinitePathUHFUnitary]

/-- The automorphism group is continuous in the point-norm topology. -/
theorem continuous_infinitePathUHFDynamics_apply
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|))
    (A : PrimeUHFAlgebra qubitLocalDim) :
    Continuous (fun t => infinitePathUHFDynamics hp t A) := by
  simpa only [infinitePathUHFDynamics_apply] using
    continuous_infinitePathUHFHeisenberg p A

@[simp] theorem infinitePathUHFDynamics_zero
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|)) :
    infinitePathUHFDynamics hp 0 =
      StarAlgEquiv.refl ℂ (PrimeUHFAlgebra qubitLocalDim) := by
  ext A
  simp [infinitePathUHFDynamics_apply, infinitePathUHFHeisenberg]

/-- Additive time acts by composition on every UHF observable. -/
theorem infinitePathUHFDynamics_add_apply
    {p : InfinitePathLabel → ℝ} (hp : Summable (fun i => |p i|))
    (s t : ℝ) (A : PrimeUHFAlgebra qubitLocalDim) :
    infinitePathUHFDynamics hp (s + t) A =
      infinitePathUHFDynamics hp s (infinitePathUHFDynamics hp t A) := by
  simp only [infinitePathUHFDynamics_apply, infinitePathUHFHeisenberg]
  rw [infinitePathUHFEvolution_add, star_mul]
  have hcomm : Commute (infinitePathUHFEvolution p s)
      (infinitePathUHFEvolution p t) := by
    show infinitePathUHFEvolution p s * infinitePathUHFEvolution p t =
      infinitePathUHFEvolution p t * infinitePathUHFEvolution p s
    calc
      infinitePathUHFEvolution p s * infinitePathUHFEvolution p t =
          infinitePathUHFEvolution p (s + t) :=
        (infinitePathUHFEvolution_add p s t).symm
      _ = infinitePathUHFEvolution p (t + s) := by rw [add_comm]
      _ = infinitePathUHFEvolution p t * infinitePathUHFEvolution p s :=
        infinitePathUHFEvolution_add p t s
  rw [hcomm.eq]
  have hstar : star (infinitePathUHFEvolution p t) *
      star (infinitePathUHFEvolution p s) =
      star (infinitePathUHFEvolution p s) *
        star (infinitePathUHFEvolution p t) := by
    simpa only [star_mul] using congrArg star hcomm.eq
  rw [hstar]
  simp only [mul_assoc]

end

end GaloisForLFunctions.HTGeometry
