import GaloisForLFunctions.HTGeometry.HypertranscendentalPow
import GaloisForLFunctions.HTGeometry.DifferentialAdjoinScale

/-!
# The power endomorphism of a freely generated differential field

A differential field freely generated by one hypertranscendental element carries, for every positive
exponent, a differential endomorphism sending the generator to that power of itself: the generator
and its power are both differentially independent, so the universal parametrization of a free
differential field transports one onto the other, and the image is the differential field generated
by the power.

These endomorphisms compose by multiplying exponents, which makes them the prefix maps of a
multiplicative isogeny protocol.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {g : E} (hg : DifferentialIndependent C (fun _ : Unit ↦ g))
  (hgen : differentialAdjoin C (Set.range fun _ : Unit ↦ g) = ⊤)

include hgen in
/-- The generated differential field, seen from the ambient field. -/
private def genEquiv :
    E ≃ₐ[C] ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g)) :=
  ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv).symm

include hg hgen in
/-- **The power endomorphism.**  The differential endomorphism of a freely generated differential
field which sends the generator to its `N`-th power. -/
def powerEndo {N : ℕ} (hN : 0 < N) : E →ₐ[C] E :=
  (differentialAdjoin C (Set.range fun _ : Unit ↦ g ^ N)).val.comp
    ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
        (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg
        (differentialIndependent_pow hg hN)).toAlgHom.comp
      (genEquiv hgen).toAlgHom)

/-- The power endomorphism raises the generator to the exponent. -/
theorem powerEndo_gen {N : ℕ} (hN : 0 < N) : powerEndo hg hgen hN g = g ^ N := by
  have hgN : DifferentialIndependent C (fun _ : Unit ↦ g ^ N) :=
    differentialIndependent_pow hg hN
  have hpre : (genEquiv hgen) g =
      ⟨differentialJet 0 ((fun _ : Unit ↦ g) ()),
        differentialJet_mem_differentialAdjoin C (Set.mem_range_self ()) 0⟩ := by
    apply Subtype.ext
    simp only [genEquiv, differentialJet_zero]
    rfl
  have hjet := GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv_jet
    (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN () 0
  change ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
    (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN) ((genEquiv hgen) g) : E) = g ^ N
  rw [hpre, hjet]
  simp

/-- The power endomorphism commutes with the derivation. -/
theorem powerEndo_deriv {N : ℕ} (hN : 0 < N) (z : E) :
    powerEndo hg hgen hN z′ = (powerEndo hg hgen hN z)′ := by
  have hgN : DifferentialIndependent C (fun _ : Unit ↦ g ^ N) :=
    differentialIndependent_pow hg hN
  set e := GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
    (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN with he
  have hgenderiv (w : E) : (genEquiv hgen) w′ = ((genEquiv hgen) w)′ := by
    apply Subtype.ext
    have h1 : (((genEquiv hgen) w′ : ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g))) : E)
        = w′ := by
      simp only [genEquiv]
      rfl
    have h2 : (((genEquiv hgen) w : ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g))) : E)
        = w := by
      simp only [genEquiv]
      rfl
    rw [h1]
    have h3 := coe_differentialJet_differentialAdjoin (F := C)
      (Set.range fun _ : Unit ↦ g) 1 ((genEquiv hgen) w)
    simp only [differentialJet_succ, differentialJet_zero] at h3
    rw [h3, h2]
  change ((e ((genEquiv hgen) z′) : ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g ^ N))) : E)
    = (((e ((genEquiv hgen) z) : ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g ^ N))) : E))′
  rw [hgenderiv, GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv_deriv]
  have h4 := coe_differentialJet_differentialAdjoin (F := C)
    (Set.range fun _ : Unit ↦ g ^ N) 1 (e ((genEquiv hgen) z))
  simp only [differentialJet_succ, differentialJet_zero] at h4
  exact h4

/-- **The image of the power endomorphism** is the differential field generated by the power. -/
theorem powerEndo_map_top {N : ℕ} (hN : 0 < N) :
    IntermediateField.map (powerEndo hg hgen hN) ⊤ = differentialAdjoin C ({g ^ N} : Set E) := by
  have hgN : DifferentialIndependent C (fun _ : Unit ↦ g ^ N) :=
    differentialIndependent_pow hg hN
  have hset : (Set.range fun _ : Unit ↦ g ^ N) = ({g ^ N} : Set E) := by simp
  apply le_antisymm
  · rintro x hx
    rw [IntermediateField.mem_map] at hx
    obtain ⟨y, -, rfl⟩ := hx
    have : powerEndo hg hgen hN y ∈ differentialAdjoin C (Set.range fun _ : Unit ↦ g ^ N) :=
      ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
        (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN) ((genEquiv hgen) y)).2
    rwa [hset] at this
  · intro x hx
    rw [← hset] at hx
    rw [IntermediateField.mem_map]
    refine ⟨(genEquiv hgen).symm
      ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
        (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN).symm ⟨x, hx⟩), trivial, ?_⟩
    change (((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
      (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN)
        ((genEquiv hgen) ((genEquiv hgen).symm
          ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv
            (fun _ : Unit ↦ g) (fun _ : Unit ↦ g ^ N) hg hgN).symm ⟨x, hx⟩))) :
        ↥(differentialAdjoin C (Set.range fun _ : Unit ↦ g ^ N))) : E) = x
    rw [AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]

/-- **Power endomorphisms compose by multiplying exponents.** -/
theorem powerEndo_comp {M N : ℕ} (hM : 0 < M) (hN : 0 < N) :
    (powerEndo hg hgen hM).comp (powerEndo hg hgen hN)
      = powerEndo hg hgen (Nat.mul_pos hN hM) := by
  refine differentialAlgHom_ext_of_differentialAdjoin_eq_top (fun _ : Unit ↦ g) hgen _ _
    (fun z ↦ ?_) (fun z ↦ ?_) (fun _ ↦ ?_)
  · change powerEndo hg hgen hM (powerEndo hg hgen hN z′) = (powerEndo hg hgen hM
      (powerEndo hg hgen hN z))′
    rw [powerEndo_deriv, powerEndo_deriv]
  · exact powerEndo_deriv hg hgen (Nat.mul_pos hN hM) z
  · change powerEndo hg hgen hM (powerEndo hg hgen hN g) = powerEndo hg hgen (Nat.mul_pos hN hM) g
    rw [powerEndo_gen, powerEndo_gen, map_pow, powerEndo_gen, ← pow_mul]
    ring


/-- Power endomorphisms with equal exponents agree. -/
theorem powerEndo_congr {M N : ℕ} (hM : 0 < M) (hN : 0 < N) (h : M = N) :
    powerEndo hg hgen hM = powerEndo hg hgen hN := by
  subst h
  rfl

/-- The first power endomorphism is the identity. -/
theorem powerEndo_one (h1 : 0 < 1) : powerEndo hg hgen h1 = AlgHom.id C E := by
  refine differentialAlgHom_ext_of_differentialAdjoin_eq_top (fun _ : Unit ↦ g) hgen _ _
    (fun z ↦ powerEndo_deriv hg hgen h1 z) (fun z ↦ rfl) (fun _ ↦ ?_)
  change powerEndo hg hgen h1 g = g
  rw [powerEndo_gen, pow_one]

end

end

end GaloisForLFunctions.HTGeometry
