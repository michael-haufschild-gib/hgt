import GaloisForLFunctions.HTGeometry.AlgebraicTensorEigenvectorDescent

/-!
# Functorial uniqueness of derivations on algebraic field extensions

Two derivations on an algebraic field extension agree everywhere once they agree on the base.
For specialization arguments the two sides naturally take values in a larger target field, so the
usual same-codomain uniqueness statement is insufficient.  This module proves the target-valued
form directly from the minimal polynomial and its nonzero derivative in characteristic zero.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open Polynomial

/-- Restrict the source of a target-valued derivation along an algebra map. -/
def derivationCompAlgebraMapDomain
    (C K A L : Type*) [CommRing C] [CommRing K] [CommRing A] [CommRing L]
    [Algebra C K] [Algebra C A] [Algebra K A] [IsScalarTower C K A]
    [Algebra C L] [Algebra K L] [Algebra A L]
    [IsScalarTower C A L] [IsScalarTower K A L]
    (D : Derivation C A L) : Derivation C K L :=
  Derivation.mk'
    (D.toLinearMap.comp (IsScalarTower.toAlgHom C K A).toLinearMap) (by
      intro x y
      change D (algebraMap K A (x * y)) = _
      rw [map_mul, D.leibniz]
      simp [Algebra.smul_def, IsScalarTower.algebraMap_apply K A L])

@[simp]
theorem derivationCompAlgebraMapDomain_apply
    (C K A L : Type*) [CommRing C] [CommRing K] [CommRing A] [CommRing L]
    [Algebra C K] [Algebra C A] [Algebra K A] [IsScalarTower C K A]
    [Algebra C L] [Algebra K L] [Algebra A L]
    [IsScalarTower C A L] [IsScalarTower K A L]
    (D : Derivation C A L) (x : K) :
    derivationCompAlgebraMapDomain C K A L D x = D (algebraMap K A x) := rfl

/-- Kernel field of a derivation whose values lie in a larger field.  Faithfulness of the field
embedding supplies closure under inversion. -/
def derivationTargetKernelField
    {C A L : Type*} [Field C] [Field A] [Field L]
    [Algebra C A] [Algebra C L] [Algebra A L] [IsScalarTower C A L]
    (D : Derivation C A L) : IntermediateField C A where
  carrier := {x | D x = 0}
  zero_mem' := D.map_zero
  one_mem' := D.map_one_eq_zero
  add_mem' := fun {x y} hx hy => by
    change D (x + y) = 0
    rw [map_add, hx, hy, add_zero]
  mul_mem' := fun {x y} hx hy => by
    change D (x * y) = 0
    rw [D.leibniz, hx, hy]
    simp
  inv_mem' := fun {x} hx => by
    change D x⁻¹ = 0
    by_cases hx0 : x = 0
    · subst x
      simpa using D.map_zero
    · have h := D.leibniz x x⁻¹
      rw [mul_inv_cancel₀ hx0, D.map_one_eq_zero, hx] at h
      simp only [Algebra.smul_def, mul_zero, add_zero] at h
      have hxL : algebraMap A L x ≠ 0 := (map_ne_zero (algebraMap A L)).mpr hx0
      exact (mul_eq_zero.mp h.symm).resolve_left hxL
  algebraMap_mem' := fun c => D.map_algebraMap c

@[simp]
theorem mem_derivationTargetKernelField_iff
    {C A L : Type*} [Field C] [Field A] [Field L]
    [Algebra C A] [Algebra C L] [Algebra A L] [IsScalarTower C A L]
    {D : Derivation C A L} {x : A} :
    x ∈ derivationTargetKernelField D ↔ D x = 0 := Iff.rfl

/-- A target-valued derivation killing a generating set kills the field generated by that set. -/
theorem derivation_eq_zero_of_mem_adjoin_to_field
    {C A L : Type*} [Field C] [Field A] [Field L]
    [Algebra C A] [Algebra C L] [Algebra A L] [IsScalarTower C A L]
    (D : Derivation C A L) {S : Set A} (hS : ∀ x ∈ S, D x = 0)
    {y : A} (hy : y ∈ IntermediateField.adjoin C S) : D y = 0 := by
  have hle : IntermediateField.adjoin C S ≤ derivationTargetKernelField D := by
    rw [IntermediateField.adjoin_le_iff]
    exact fun x hx => hS x hx
  exact mem_derivationTargetKernelField_iff.mp (hle hy)

/-- Target-valued univariate chain rule when the derivation kills the coefficient field. -/
theorem derivation_aeval_of_coeff_eq_zero_to_field
    {C K A L : Type*} [Field C] [Field K] [Field A] [Field L]
    [Algebra C K] [Algebra C A] [Algebra K A] [IsScalarTower C K A]
    [Algebra C L] [Algebra A L] [IsScalarTower C A L]
    (D : Derivation C A L) (hK : ∀ c : K, D (algebraMap K A c) = 0)
    (u : A) (p : Polynomial K) :
    D (Polynomial.aeval u p) =
      algebraMap A L (Polynomial.aeval u p.derivative) * D u := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      simp only [map_add, hp, hq]
      ring
  | monomial n a =>
      rw [Polynomial.aeval_monomial, D.leibniz, hK,
        Polynomial.derivative_monomial, Polynomial.aeval_monomial,
        Derivation.leibniz_pow]
      simp only [Algebra.smul_def, map_mul, map_pow, map_natCast]
      simp only [mul_zero, add_zero]
      rw [show algebraMap ℕ L n = (n : L) by rfl]
      ring

/-- A target-valued derivation vanishing on the base of a characteristic-zero algebraic extension
vanishes on every algebraic element. -/
theorem derivation_eq_zero_of_isAlgebraic_extension_to_field
    {C K A L : Type*} [Field C] [Field K] [CharZero K] [Field A] [CharZero A]
    [Field L] [Algebra C K] [Algebra C A] [Algebra K A] [IsScalarTower C K A]
    [Algebra C L] [Algebra A L] [IsScalarTower C A L]
    (D : Derivation C A L)
    (hK : ∀ x : K, D (algebraMap K A x) = 0)
    {u : A} (hu : IsAlgebraic K u) : D u = 0 := by
  let p : Polynomial K := minpoly K u
  have hp0 : p ≠ 0 := minpoly.ne_zero hu.isIntegral
  have hdp0 : p.derivative ≠ 0 := by
    intro hcon
    have hnat := Polynomial.derivative_eq_zero.mp hcon
    have hpdeg : 0 < p.natDegree := minpoly.natDegree_pos hu.isIntegral
    omega
  have hpeval : Polynomial.aeval u p = 0 := minpoly.aeval K u
  have hdpeval : Polynomial.aeval u p.derivative ≠ 0 := by
    intro hcon
    have hle := minpoly.degree_le_of_ne_zero K u hdp0 hcon
    have hlt := Polynomial.degree_derivative_lt hp0
    exact absurd hle (not_le.mpr hlt)
  have hchain := derivation_aeval_of_coeff_eq_zero_to_field D hK u p
  rw [hpeval, map_zero] at hchain
  have hfactor : algebraMap A L (Polynomial.aeval u p.derivative) ≠ 0 := by
    simpa using (algebraMap A L).injective.ne hdpeval
  exact (mul_eq_zero.mp hchain.symm).resolve_left hfactor

/-- **Functorial uniqueness across an algebraic extension.**  A `C`-algebra embedding commutes
with two derivations on the whole algebraic field as soon as it commutes on the base field. -/
theorem derivation_map_eq_of_isAlgebraic
    {C K A L : Type*} [Field C] [Field K] [CharZero K] [Field A] [CharZero A]
    [Field L] [Algebra C K] [Algebra C A] [Algebra K A] [IsScalarTower C K A]
    [Algebra C L] [Algebra.IsAlgebraic K A]
    (rho : A →ₐ[C] L) (DA : Derivation C A A) (DL : Derivation C L L)
    (hmapK : ∀ x : K,
      rho (DA (algebraMap K A x)) = DL (rho (algebraMap K A x))) :
    ∀ y : A, rho (DA y) = DL (rho y) := by
  letI : Algebra A L := rho.toAlgebra
  letI : IsScalarTower C A L := IsScalarTower.of_algebraMap_eq fun c =>
    (rho.commutes c).symm
  let Dpush : Derivation C A L := derivationAlgebraMap C A L DA
  let Dpull : Derivation C A L := Derivation.mk'
    (DL.toLinearMap.comp rho.toLinearMap) (by
      intro x y
      change DL (rho (x * y)) = _
      rw [map_mul, DL.leibniz]
      change rho x * DL (rho y) + rho y * DL (rho x) =
        rho x * DL (rho y) + rho y * DL (rho x)
      rfl)
  let E : Derivation C A L := Dpull - Dpush
  intro y
  have hzero : E y = 0 :=
    derivation_eq_zero_of_isAlgebraic_extension_to_field E (fun x => by
      change DL (rho (algebraMap K A x)) - rho (DA (algebraMap K A x)) = 0
      rw [hmapK]
      exact sub_self _) (Algebra.IsAlgebraic.isAlgebraic y)
  change DL (rho y) - rho (DA y) = 0 at hzero
  exact (sub_eq_zero.mp hzero).symm

end GaloisForLFunctions.HTGeometry
