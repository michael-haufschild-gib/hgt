import GaloisForLFunctions.HTGeometry.TopologicallyAdmittedFellerAdmission

/-!
# Tail coordinates for finite probability comparisons

Lotz, arXiv:2609.09335, equation (17) in the proof of Theorem 1.1, expresses
an increasing-coefficient valuation as a constant plus a positive combination
of tails. Here the same change of coordinates acts on the corpus's actual
finite probability laws. Tail comparison is equivalent to comparison against
all coefficients generated by nonnegative increments, and the exact comparison
defect records each contributing tail. Signed profiles are allowed in the
underlying algebraic identity. No conic intrinsic-volume classification is asserted.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open scoped BigOperators NNReal

/-- Upper tails of a finite signed profile. -/
def lotzTail {n : ℕ} (w : Fin n → ℝ) (j : Fin n) : ℝ :=
  ∑ k, if j ≤ k then w k else 0

/-- Increasing coefficients generated by nonnegative increments. -/
def lotzCoefficient {n : ℕ} (a : ℝ) (c : Fin n → ℝ≥0) (k : Fin n) : ℝ :=
  a + ∑ j, if j ≤ k then (c j : ℝ) else 0

/-- The coefficient-to-tail identity used in the conic valuation classification. -/
theorem lotz_coefficient_tail_identity {n : ℕ} (a : ℝ) (c : Fin n → ℝ≥0)
    (w : Fin n → ℝ) :
    (∑ k, lotzCoefficient a c k * w k) =
      a * (∑ k, w k) + ∑ j, (c j : ℝ) * lotzTail w j := by
  simp only [lotzCoefficient, lotzTail, add_mul, Finset.sum_add_distrib,
    Finset.sum_mul, Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro k _
  split_ifs <;> simp

theorem lotzCoefficient_monotone {n : ℕ} (a : ℝ) (c : Fin n → ℝ≥0) :
    Monotone (lotzCoefficient a c) := by
  intro k l hkl
  unfold lotzCoefficient
  apply add_le_add le_rfl
  apply Finset.sum_le_sum
  intro j _
  by_cases hj : j ≤ k
  · simp [hj, hj.trans hkl]
  · simp only [if_neg hj]
    split_ifs
    · exact (c j).property
    · exact le_rfl

/-- Tail positivity is exactly positivity against every generated increasing coefficient. -/
theorem lotz_tail_nonneg_iff {n : ℕ} (w : Fin n → ℝ) :
    (∀ j, 0 ≤ lotzTail w j) ↔
      ∀ c : Fin n → ℝ≥0, 0 ≤ ∑ k, lotzCoefficient 0 c k * w k := by
  constructor
  · intro hw c
    rw [lotz_coefficient_tail_identity]
    simp only [zero_mul, zero_add]
    exact Finset.sum_nonneg fun j _ => mul_nonneg (c j).property (hw j)
  · intro h j
    have ht := h (Pi.single j 1)
    rw [lotz_coefficient_tail_identity] at ht
    simpa [Pi.single_apply, apply_ite] using ht

/-- Ordered tails completely characterize all increasing tests of two probability laws. -/
theorem lotz_probability_tail_order_iff {n : ℕ}
    (p q : FiniteProbabilityLaw (Fin n)) :
    (∀ j, lotzTail p.prob j ≤ lotzTail q.prob j) ↔
      ∀ (a : ℝ) (c : Fin n → ℝ≥0),
        (∑ k, p.prob k * lotzCoefficient a c k) ≤
        ∑ k, q.prob k * lotzCoefficient a c k := by
  constructor
  · intro h a c
    simp_rw [mul_comm _ (lotzCoefficient a c _)]
    rw [lotz_coefficient_tail_identity, lotz_coefficient_tail_identity,
      p.sum_prob, q.sum_prob]
    exact add_le_add le_rfl (Finset.sum_le_sum fun j _ =>
      mul_le_mul_of_nonneg_left (h j) (c j).property)
  · intro h j
    have ht := h 0 (Pi.single j 1)
    simp_rw [mul_comm _ (lotzCoefficient 0 (Pi.single j 1) _)] at ht
    rw [lotz_coefficient_tail_identity, lotz_coefficient_tail_identity] at ht
    simpa [Pi.single_apply, apply_ite] using ht

/-- The exact comparison defect, including the contribution of each upper tail. -/
theorem lotz_probability_comparison_defect {n : ℕ}
    (p q : FiniteProbabilityLaw (Fin n)) (a : ℝ) (c : Fin n → ℝ≥0) :
    (∑ k, q.prob k * lotzCoefficient a c k) -
      (∑ k, p.prob k * lotzCoefficient a c k) =
      ∑ j, (c j : ℝ) * (lotzTail q.prob j - lotzTail p.prob j) := by
  simp_rw [mul_comm _ (lotzCoefficient a c _)]
  rw [lotz_coefficient_tail_identity, lotz_coefficient_tail_identity,
    p.sum_prob, q.sum_prob]
  simp only [mul_sub, Finset.sum_sub_distrib]
  ring

/-- A tail is the expectation of its threshold coefficient. -/
theorem lotz_tail_probe {n : ℕ} (w : Fin n → ℝ) (j : Fin n) :
    (∑ k, lotzCoefficient 0 (Pi.single j 1) k * w k) = lotzTail w j := by
  rw [lotz_coefficient_tail_identity]
  simp [Pi.single_apply, apply_ite]

end GaloisForLFunctions.HTGeometry
