import GaloisForLFunctions.HTGeometry.MutualGeneratorMobius
import GaloisForLFunctions.HTGeometry.NonautonomousTailDichotomy
import GaloisForLFunctions.HTGeometry.NonautonomousTailHypertranscendence
import GaloisForLFunctions.HTGeometry.SchwarzianProjectiveInvariant

/-!
# The projective time law of a nonautonomous hypertranscendental tail

For a protocol of derivation-compatible injections of a scalar free differential field, the phase
tails are either all the base field or all nontrivial.  In the nontrivial phase each tail is
generated by one hypertranscendental element, the protocol carries the generator of one phase to a
fractional-linear transform of the generator of the previous phase with constant coefficients, and
the Schwarzian of the generator is a nonconstant observable transported unchanged along time.

The Schwarzian is independent of the chosen generator, so the transported observable belongs to the
tail rather than to a coordinate.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {C F : Type*} [Field C] [Field F] [Differential C] [Differential F] [Algebra C F]
  [DifferentialAlgebra C F] [CharZero C] [CharZero F]

omit [Differential C] [DifferentialAlgebra C F] [CharZero C] [CharZero F] in
/-- A derivation-preserving homomorphism carries the differential field generated by a set to the
differential field generated by the image of the set. -/
theorem map_differentialAdjoin (φ : F →ₐ[C] F) (hφ : ∀ x : F, φ x′ = (φ x)′) (s : Set F) :
    IntermediateField.map φ (differentialAdjoin C s) = differentialAdjoin C (φ '' s) := by
  rw [differentialAdjoin, differentialAdjoin, IntermediateField.adjoin_map]
  congr 1
  ext z
  constructor
  · rintro ⟨w, ⟨x, hx, n, rfl⟩, rfl⟩
    exact ⟨φ x, ⟨x, hx, rfl⟩, n, (differentialJet_algHom φ hφ x n).symm⟩
  · rintro ⟨w, ⟨x, hx, rfl⟩, n, rfl⟩
    exact ⟨differentialJet n x, ⟨x, hx, n, rfl⟩, differentialJet_algHom φ hφ x n⟩

omit [CharZero F] in
/-- A differential generator of a nontrivial subfield of a freely generated differential field is
hypertranscendental. -/
theorem hypertranscendentalOver_of_generates_ne_bot
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    {u : F} {L : IntermediateField C F} (hL : L ≠ ⊥)
    (hu : differentialAdjoin C ({u} : Set F) = L) :
    HypertranscendentalOver C u := by
  refine hypertranscendentalOver_of_notMem_bot_of_free hC hy hytop ?_
  intro hmem
  exact hL (hu ▸ differentialAdjoin_singleton_eq_bot_of_mem_bot hmem)

omit [Differential C] [DifferentialAlgebra C F] [CharZero C] [CharZero F] in
/-- The image of a phase generator generates the previous tail. -/
theorem differentialAdjoin_map_generator
    (φ : ℕ → F →ₐ[C] F) (hφ : ∀ i x, φ i x′ = (φ i x)′) (i : ℕ) {v : F}
    (hv : differentialAdjoin C ({v} : Set F) = nonautonomousTail φ (i + 1)) :
    differentialAdjoin C ({φ i v} : Set F) = nonautonomousTail φ i := by
  have h1 : IntermediateField.map (φ i) (differentialAdjoin C ({v} : Set F))
      = differentialAdjoin C ((φ i) '' ({v} : Set F)) :=
    map_differentialAdjoin (φ i) (hφ i) _
  rw [hv, map_nonautonomousTail_eq] at h1
  simpa using h1.symm

/-- **The protocol acts projectively on phase generators.**  The image of the generator of one
phase is a fractional-linear transform, with base-field coefficients, of the generator of the
previous phase. -/
theorem nonautonomousTail_projective_transition
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    (φ : ℕ → F →ₐ[C] F) (hφ : ∀ i x, φ i x′ = (φ i x)′)
    (hne : ∀ i, nonautonomousTail φ i ≠ ⊥) {i : ℕ} {u v : F}
    (hu : differentialAdjoin C ({u} : Set F) = nonautonomousTail φ i)
    (hv : differentialAdjoin C ({v} : Set F) = nonautonomousTail φ (i + 1)) :
    ∃ a b c d : C, a * d - b * c ≠ 0 ∧
      φ i v * (algebraMap C F c * u + algebraMap C F d)
        = algebraMap C F a * u + algebraMap C F b := by
  have hu' : HypertranscendentalOver C u :=
    hypertranscendentalOver_of_generates_ne_bot hC hy hytop (hne i) hu
  have hv' : HypertranscendentalOver C v :=
    hypertranscendentalOver_of_generates_ne_bot hC hy hytop (hne (i + 1)) hv
  have hw' : HypertranscendentalOver C (φ i v) :=
    (hypertranscendentalOver_algHom_iff (φ i) (hφ i) v).mpr hv'
  have hmapadj : differentialAdjoin C ({φ i v} : Set F) = nonautonomousTail φ i :=
    differentialAdjoin_map_generator φ hφ i hv
  refine mutual_generator_mobius hu' hw' ?_ ?_
  · rw [hu, ← hmapadj]
    exact subset_differentialAdjoin C _ rfl
  · rw [hmapadj, ← hu]
    exact subset_differentialAdjoin C _ rfl

/-- **The Schwarzian of a phase generator is transported unchanged through time.** -/
theorem nonautonomousTail_schwarzian_transport
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    (φ : ℕ → F →ₐ[C] F) (hφ : ∀ i x, φ i x′ = (φ i x)′)
    (hne : ∀ i, nonautonomousTail φ i ≠ ⊥) {i : ℕ} {u v : F}
    (hu : differentialAdjoin C ({u} : Set F) = nonautonomousTail φ i)
    (hv : differentialAdjoin C ({v} : Set F) = nonautonomousTail φ (i + 1)) :
    φ i (schwarzian v) = schwarzian u := by
  obtain ⟨a, b, c, d, hdet, hmob⟩ :=
    nonautonomousTail_projective_transition hC hy hytop φ hφ hne hu hv
  have hu' : HypertranscendentalOver C u :=
    hypertranscendentalOver_of_generates_ne_bot hC hy hytop (hne i) hu
  have htu : Transcendental C u := by
    simpa using hypertranscendentalOver_jet_transcendental hu' 0
  have hden : algebraMap C F c * u + algebraMap C F d ≠ 0 :=
    mobius_denominator_ne_zero htu hdet
  have hdu : u′ ≠ 0 := deriv_ne_zero_of_hypertranscendentalOver hu'
  have hdetF : algebraMap C F a * algebraMap C F d - algebraMap C F b * algebraMap C F c ≠ 0 :=
    mobius_det_ne_zero_algebraMap hdet
  have htrans : φ i v =
      (algebraMap C F a * u + algebraMap C F b) / (algebraMap C F c * u + algebraMap C F d) := by
    rw [eq_div_iff hden]
    exact hmob
  exact schwarzian_transport_of_projective_transition (φ i) (hφ i) u v
    (algebraMap C F a) (algebraMap C F b) (algebraMap C F c) (algebraMap C F d)
    (hC a) (hC b) (hC c) (hC d) hdetF hden hdu htrans

omit [CharZero C] in
/-- **The Schwarzian does not depend on the chosen differential generator.** -/
theorem schwarzian_eq_of_differentialAdjoin_eq
    (hC : ∀ a : C, (algebraMap C F a)′ = 0) {u w : F}
    (hu : HypertranscendentalOver C u) (hw : HypertranscendentalOver C w)
    (h : differentialAdjoin C ({u} : Set F) = differentialAdjoin C ({w} : Set F)) :
    schwarzian w = schwarzian u := by
  obtain ⟨a, b, c, d, hdet, hmob⟩ :=
    mutual_generator_mobius hu hw (by rw [h]; exact subset_differentialAdjoin C _ rfl)
      (by rw [← h]; exact subset_differentialAdjoin C _ rfl)
  have htu : Transcendental C u := by
    simpa using hypertranscendentalOver_jet_transcendental hu 0
  have hden : algebraMap C F c * u + algebraMap C F d ≠ 0 :=
    mobius_denominator_ne_zero htu hdet
  have hdu : u′ ≠ 0 := deriv_ne_zero_of_hypertranscendentalOver hu
  have hdetF : algebraMap C F a * algebraMap C F d - algebraMap C F b * algebraMap C F c ≠ 0 :=
    mobius_det_ne_zero_algebraMap hdet
  have hform : w =
      (algebraMap C F a * u + algebraMap C F b) / (algebraMap C F c * u + algebraMap C F d) := by
    rw [eq_div_iff hden]
    exact hmob
  rw [hform]
  exact schwarzian_mobius u (algebraMap C F a) (algebraMap C F b) (algebraMap C F c)
    (algebraMap C F d) (hC a) (hC b) (hC c) (hC d) hdetF hden hdu

/-- **The Schwarzian of a phase generator is not a base constant.** -/
theorem schwarzian_generator_ne_constant
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    {u : F} {L : IntermediateField C F} (hL : L ≠ ⊥)
    (hu : differentialAdjoin C ({u} : Set F) = L) (t : C) :
    schwarzian u ≠ algebraMap C F t :=
  schwarzian_ne_constant_of_hypertranscendentalOver
    (hypertranscendentalOver_of_generates_ne_bot hC hy hytop hL hu) t

end

end GaloisForLFunctions.HTGeometry
