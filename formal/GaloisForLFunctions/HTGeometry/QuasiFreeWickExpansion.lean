import Mathlib

/-!
# The quasi-free Wick expansion lands in the contraction algebra

For a centered quasi-free field the expectation of a product of field labels is the Isserlis sum
over perfect matchings of products of two-point contractions.  Written as the standard recursion,
this makes it immediate that every moment lies in the subalgebra generated by the contractions,
and hence — by linearity — that the expectation of every polynomial observable does.

The moment–cumulant inversion is the partition relation

```text
m(S) = ∑_{P a partition of S} ∏_{B ∈ P} κ(B).
```

Because a partition of a nonempty set with more than one block has strictly smaller blocks, the
relation determines `κ` by strong induction on the block size, and the induction also shows that
every connected correlator lies in the same contraction algebra.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

variable {ι K A : Type*} [CommRing K] [CommRing A] [Algebra K A]

/-! ## Wick moments -/

/-- The Isserlis/Wick moment of a list of field labels: the sum over perfect matchings of the
product of two-point contractions, in recursive form.  Odd-length lists give `0`. -/
def wickMoment (W : ι → ι → A) : List ι → A
  | [] => 1
  | (x :: rest) => ∑ k : Fin rest.length, W x rest[k] * wickMoment W (rest.eraseIdx k)
termination_by l => l.length
decreasing_by
  simp only [List.length_cons]
  have h := List.length_eraseIdx_le rest (k : ℕ)
  omega

@[simp] theorem wickMoment_nil (W : ι → ι → A) : wickMoment W [] = 1 := by
  simp only [wickMoment]

theorem wickMoment_cons (W : ι → ι → A) (x : ι) (rest : List ι) :
    wickMoment W (x :: rest)
      = ∑ k : Fin rest.length, W x rest[k] * wickMoment W (rest.eraseIdx k) := by
  simp only [wickMoment]

/-- **Every Wick moment lies in the algebra generated by the two-point contractions.** -/
theorem wickMoment_mem_adjoin (W : ι → ι → A) (S : Subalgebra K A)
    (hW : ∀ i j, W i j ∈ S) : ∀ l : List ι, wickMoment W l ∈ S := by
  intro l
  induction hn : l.length using Nat.strong_induction_on generalizing l with
  | _ n ih =>
    match l with
    | [] => rw [wickMoment_nil]; exact S.one_mem
    | (x :: rest) =>
      rw [wickMoment_cons]
      refine Subalgebra.sum_mem _ fun k _ => ?_
      refine Subalgebra.mul_mem _ (hW _ _) ?_
      refine ih (rest.eraseIdx k).length ?_ _ rfl
      subst hn
      simp only [List.length_cons]
      have h := List.length_eraseIdx_le rest (k : ℕ)
      omega

/-! ## Linearity: polynomial observables -/

/-- If a `K`-linear expectation takes every monomial into a subalgebra, it takes every polynomial
observable into that subalgebra. -/
theorem linear_mem_adjoin_of_monomial_mem {σ : Type*} (S : Subalgebra K A)
    (E : MvPolynomial σ K →ₗ[K] A)
    (hmon : ∀ d : σ →₀ ℕ, E (MvPolynomial.monomial d 1) ∈ S) (P : MvPolynomial σ K) :
    E P ∈ S := by
  classical
  rw [P.as_sum, map_sum]
  refine Subalgebra.sum_mem _ fun d _ => ?_
  have hd : MvPolynomial.monomial d (MvPolynomial.coeff d P)
      = MvPolynomial.coeff d P • MvPolynomial.monomial d (1 : K) := by
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [hd, map_smul]
  exact Subalgebra.smul_mem _ (hmon d) _

/-! ## The moment–cumulant inversion -/

variable [DecidableEq ι]

/-- Blocks of a partition with more than one block are strictly smaller than the ground set. -/
theorem card_lt_of_two_le_parts {s : Finset ι} (P : Finpartition s)
    (hP : 2 ≤ P.parts.card) {B : Finset ι} (hB : B ∈ P.parts) : B.card < s.card := by
  have hsub : B ⊆ s := Finpartition.subset P hB
  rcases lt_or_eq_of_le (Finset.card_le_card hsub) with h | h
  · exact h
  · exfalso
    have hBs : B = s := Finset.eq_of_subset_of_card_le hsub (le_of_eq h.symm)
    have hpos : (P.parts.erase B).Nonempty := by
      refine Finset.card_pos.mp ?_
      rw [Finset.card_erase_of_mem hB]
      omega
    obtain ⟨B', hB'mem⟩ := hpos
    have hne : B' ≠ B := (Finset.mem_erase.mp hB'mem).1
    have hB' : B' ∈ P.parts := (Finset.mem_erase.mp hB'mem).2
    have hB'sub : B' ⊆ s := Finpartition.subset P hB'
    have hdisj : Disjoint B' B := P.disjoint hB' hB hne
    obtain ⟨y, hy⟩ := P.nonempty_of_mem_parts hB'
    have hyB : y ∈ B := by rw [hBs]; exact hB'sub hy
    exact (Finset.disjoint_left.mp hdisj hy) hyB

/-- **Cumulants of a moment family stay in the contraction algebra.**  If `κ` satisfies the
moment–cumulant partition relation and every moment lies in a subalgebra, then every cumulant of a
nonempty label set does. -/
theorem cumulant_mem_of_partitionRelation (S : Subalgebra K A) (m κ : Finset ι → A)
    (hm : ∀ s : Finset ι, m s ∈ S)
    (hrel : ∀ s : Finset ι, m s = ∑ P : Finpartition s, ∏ B ∈ P.parts, κ B) :
    ∀ s : Finset ι, s.Nonempty → κ s ∈ S := by
  suffices H : ∀ n : ℕ, ∀ s : Finset ι, s.card ≤ n → s.Nonempty → κ s ∈ S by
    intro s hs
    exact H s.card s le_rfl hs
  intro n
  induction n with
  | zero =>
      intro s hcard hs
      exact absurd (Finset.card_eq_zero.mp (Nat.le_zero.mp hcard)) hs.ne_empty
  | succ n ih =>
    intro s hcard hs
    classical
    have hbot : s ≠ ⊥ := by
      simpa [Finset.bot_eq_empty] using hs.ne_empty
    set Pi : Finpartition s := Finpartition.indiscrete hbot with hPi
    have hPiParts : Pi.parts = {s} := by rw [hPi, Finpartition.indiscrete_parts]
    have hsplit : (∑ P : Finpartition s, ∏ B ∈ P.parts, κ B)
        = (∏ B ∈ Pi.parts, κ B)
          + ∑ P ∈ Finset.univ.erase Pi, ∏ B ∈ P.parts, κ B := by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ Pi)]
    have hPiProd : (∏ B ∈ Pi.parts, κ B) = κ s := by
      rw [hPiParts, Finset.prod_singleton]
    have hrest : (∑ P ∈ Finset.univ.erase Pi, ∏ B ∈ P.parts, κ B) ∈ S := by
      refine Subalgebra.sum_mem _ fun P hP => ?_
      have hPne : P ≠ Pi := (Finset.mem_erase.mp hP).1
      have htwo : 2 ≤ P.parts.card := by
        rcases Nat.lt_or_ge P.parts.card 2 with hlt | hge
        · exfalso
          rcases Nat.lt_or_ge P.parts.card 1 with h0 | h1
          · have hempty : P.parts = ∅ := Finset.card_eq_zero.mp (show P.parts.card = 0 by omega)
            have hsup := P.sup_parts
            rw [hempty] at hsup
            simp only [Finset.sup_empty] at hsup
            exact hs.ne_empty (by simpa [Finset.bot_eq_empty] using hsup.symm)
          · obtain ⟨B, hB⟩ := Finset.card_eq_one.mp (show P.parts.card = 1 by omega)
            have hsup := P.sup_parts
            rw [hB] at hsup
            simp only [Finset.sup_singleton, id_eq] at hsup
            exact hPne (Finpartition.ext (by rw [hB, hPiParts, hsup]))
        · exact hge
      refine Subalgebra.prod_mem _ fun B hB => ?_
      have hlt : B.card < s.card := card_lt_of_two_le_parts P htwo hB
      exact ih B (by omega) (P.nonempty_of_mem_parts hB)
    have hval := hrel s
    rw [hsplit, hPiProd] at hval
    have hkappa : κ s = m s - ∑ P ∈ Finset.univ.erase Pi, ∏ B ∈ P.parts, κ B := by
      rw [hval]; ring
    rw [hkappa]
    exact Subalgebra.sub_mem _ (hm s) hrest

/-! ## The face-complete closure -/

/-- The algebra generated by the two-point contractions. -/
def contractionAlgebra (K : Type*) [CommRing K] {ι A : Type*} [CommRing A] [Algebra K A]
    (W : ι → ι → A) : Subalgebra K A :=
  Algebra.adjoin K (Set.range fun p : ι × ι => W p.1 p.2)

theorem mem_contractionAlgebra (K : Type*) [CommRing K] {ι A : Type*} [CommRing A] [Algebra K A]
    (W : ι → ι → A) (i j : ι) : W i j ∈ contractionAlgebra K W :=
  Algebra.subset_adjoin ⟨(i, j), rfl⟩

/-- **Face-complete Gaussian Wick closure.**  For a centered quasi-free field — whose moments are
the Isserlis sums over perfect matchings — every connected correlator lies in the algebra
generated by the two-point contraction packet.  With the corpus rank theorem
`finiteRelativeTranscendenceRank_eq_zero_of_mem_adjoin` this is equation `(1)` of the card. -/
theorem connectedCorrelator_mem_contractionAlgebra
    (W : ι → ι → A) (m κ : Finset ι → A)
    (hmoment : ∀ s : Finset ι, ∃ l : List ι, m s = wickMoment W l)
    (hrel : ∀ s : Finset ι, m s = ∑ P : Finpartition s, ∏ B ∈ P.parts, κ B) :
    ∀ s : Finset ι, s.Nonempty → κ s ∈ contractionAlgebra K W := by
  refine cumulant_mem_of_partitionRelation (contractionAlgebra K W) m κ ?_ hrel
  intro s
  obtain ⟨l, hl⟩ := hmoment s
  rw [hl]
  exact wickMoment_mem_adjoin W (contractionAlgebra K W) (mem_contractionAlgebra K W) l

omit [DecidableEq ι] in
/-- The polynomial-observable form: an expectation that is Wick on monomials is contraction-valued
on every polynomial observable. -/
theorem expectation_polynomial_mem_contractionAlgebra {σ : Type*}
    (W : ι → ι → A) (E : MvPolynomial σ K →ₗ[K] A)
    (hmon : ∀ d : σ →₀ ℕ, ∃ l : List ι, E (MvPolynomial.monomial d 1) = wickMoment W l)
    (P : MvPolynomial σ K) : E P ∈ contractionAlgebra K W := by
  refine linear_mem_adjoin_of_monomial_mem (contractionAlgebra K W) E ?_ P
  intro d
  obtain ⟨l, hl⟩ := hmon d
  rw [hl]
  exact wickMoment_mem_adjoin W (contractionAlgebra K W) (mem_contractionAlgebra K W) l


end GaloisForLFunctions.HTGeometry
