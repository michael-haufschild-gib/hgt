import GaloisForLFunctions.HTGeometry.AlgebraicIndependentPair

/-!
# The inner function and its composition are algebraically independent

Clunie growth makes `f ∘ g` transcendental over the jet field of `g`, in particular over `ℂ(g)`.
Together with the transcendence of a nonconstant entire `g` over the constants this makes the pair
`(f ∘ g, g)` algebraically independent, so `g` is in turn transcendental over `ℂ(f ∘ g)`.

The consequence used downstream is a coefficient principle: a vanishing polynomial expression in `g`
whose coefficients are polynomials in `f ∘ g` has all its coefficient polynomials zero.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

/-! ### A polynomial relation witnesses algebraicity -/

/-- **A vanishing polynomial expression with coefficients in an intermediate field, not all zero,
makes the variable algebraic over that field.** -/
theorem isAlgebraic_of_finsetSum_relation {K : IntermediateField ℂ (meroField (Set.univ : Set ℂ))}
    {x : meroField (Set.univ : Set ℂ)} {d : ℕ} {ρ : ℕ → meroField (Set.univ : Set ℂ)}
    (hρ : ∀ i, ρ i ∈ K) (hne : ∃ i ∈ Finset.range (d + 1), ρ i ≠ 0)
    (hrel : ∑ i ∈ Finset.range (d + 1), ρ i * x ^ i = 0) :
    IsAlgebraic ↥K x := by
  classical
  obtain ⟨i₀, hi₀, hne₀⟩ := hne
  refine ⟨∑ i ∈ Finset.range (d + 1), Polynomial.C (⟨ρ i, hρ i⟩ : ↥K) * Polynomial.X ^ i, ?_, ?_⟩
  · intro hzero
    have hcoeff : (∑ i ∈ Finset.range (d + 1),
        Polynomial.C (⟨ρ i, hρ i⟩ : ↥K) * Polynomial.X ^ i).coeff i₀ = (⟨ρ i₀, hρ i₀⟩ : ↥K) := by
      simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hi₀]
    rw [hzero, Polynomial.coeff_zero] at hcoeff
    exact hne₀ (congrArg Subtype.val hcoeff.symm)
  · rw [map_sum]
    rw [← hrel]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    rfl

/-! ### The mero-field instances -/

theorem transcendental_jetElem_zero {u : ℂ → ℂ} (hu : Differentiable ℂ u)
    (hnc : ¬ ∃ c : ℂ, ∀ z : ℂ, u z = c) : Transcendental ℂ (jetElem hu 0) := by
  have han : AnalyticOnNhd ℂ u (Set.univ : Set ℂ) :=
    hu.differentiableOn.analyticOnNhd isOpen_univ
  have heq : jetElem hu 0 = analyticMeroElement u han := by
    rw [jetElem]
    exact analyticMeroElement_congr _ _ (by funext z; simp [iteratedDeriv_zero])
  rw [heq]
  exact transcendental_analyticMeroElement_of_nonconstant hu han hnc

/-- **The inner function is transcendental over the field generated by the composition.** -/
theorem not_isAlgebraic_inner_over_comp {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) :
    ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ
      ({jetElem hcomp 0} : Set (meroField (Set.univ : Set ℂ)))) (jetElem hg 0) := by
  have hgtr : Transcendental ℂ (jetElem hg 0) := transcendental_jetElem_zero hg hncg
  have hhtr : Transcendental ↥(Algebra.adjoin ℂ
      ({jetElem hg 0} : Set (meroField (Set.univ : Set ℂ)))) (jetElem hcomp 0) := by
    intro halg
    have h1 := GaloisForLFunctions.isAlgebraic_intermediateField_of_isAlgebraic_algebraAdjoin
      ({jetElem hg 0} : Set (meroField (Set.univ : Set ℂ))) halg
    refine not_isAlgebraic_comp_over_jetField hf hg hcomp hfnp hgnp (isAlgebraic_of_le ?_ h1)
    rw [IntermediateField.adjoin_le_iff]
    rintro y rfl
    exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨0, rfl⟩)
  have hpair := algebraicIndependent_pair_of_transcendental (R := ℂ) _ _ hgtr hhtr
  have hgt := transcendental_of_algebraicIndependent_pair (R := ℂ) _ _ hpair
  intro halg
  exact hgt (GaloisForLFunctions.isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateField _ halg)

/-- **The coefficient principle.**  A vanishing polynomial expression in the inner function whose
coefficients are polynomials in the composition has all coefficient polynomials zero. -/
theorem eq_zero_of_sum_aeval_mul_pow {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c)
    (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    {d : ℕ} {q : ℕ → Polynomial ℂ}
    (hrel : ∑ i ∈ Finset.range (d + 1),
      Polynomial.aeval (jetElem hcomp 0) (q i) * (jetElem hg 0) ^ i = 0) :
    ∀ i ∈ Finset.range (d + 1), q i = 0 := by
  classical
  have hmem : ∀ i : ℕ, Polynomial.aeval (jetElem hcomp 0) (q i)
      ∈ IntermediateField.adjoin ℂ
        ({jetElem hcomp 0} : Set (meroField (Set.univ : Set ℂ))) := by
    intro i
    have h := Polynomial.aeval_mem_adjoin_singleton ℂ (jetElem hcomp 0) (p := q i)
    exact IntermediateField.algebra_adjoin_le_adjoin ℂ _ h
  have hzero : ∀ i ∈ Finset.range (d + 1),
      Polynomial.aeval (jetElem hcomp 0) (q i) = 0 := by
    by_contra hcon
    push Not at hcon
    obtain ⟨i₀, hi₀, hne⟩ := hcon
    exact not_isAlgebraic_inner_over_comp hf hg hcomp hfnp hgnp hncg
      (isAlgebraic_of_finsetSum_relation hmem ⟨i₀, hi₀, hne⟩ hrel)
  intro i hi
  by_contra hqi
  exact transcendental_jetElem_zero hcomp hncomp ⟨q i, hqi, hzero i hi⟩

end

end GaloisForLFunctions.HTGeometry
