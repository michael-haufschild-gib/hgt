import GaloisForLFunctions.HTGeometry.GomesPolynomialExponentialSchwartz

/-!
# Canonical ground states for all finite polynomial profiles

The exact positive half-density exp(H/2) is now an actual complex Schwartz function
for every finite polynomial profile. It solves the existing shared-connection
supercharge and factorized Hamiltonian, including arbitrary lower-order perturbations.
-/

noncomputable section
open Polynomial MeasureTheory Filter
open scoped Topology NNReal ENNReal SchwartzMap

namespace GaloisForLFunctions.HTGeometry

/-- The positive half-density of any finite polynomial profile, realized in Schwartz space. -/
def gomesPolynomialGroundState (P : GomesFinitePolynomialProfile) : 𝓢(ℝ, ℂ) :=
  (gomesPolynomialAmplitudeSchwartz
    (gomesFinitePolynomialScale ⟨1 / 2, by change (0 : ℝ) < 1 / 2; positivity⟩ P) 1).postcompCLM
      Complex.ofRealCLM

/-- The canonical state retains the full, unnormalized half-density. -/
theorem gomesPolynomialGroundState_apply (P : GomesFinitePolynomialProfile) (x : ℝ) :
    gomesPolynomialGroundState P x = (Real.exp (P.val.eval x / 2) : ℂ) := by
  change (((1 : ℝ[X]).eval x * Real.exp ((C (1 / 2) * P.val).eval x) : ℝ) : ℂ) = _
  simp only [eval_one, one_mul, eval_mul, eval_C]
  congr 2
  ring

/-- A finite polynomial ground state vanishes nowhere. -/
theorem gomesPolynomialGroundState_pointwise_ne_zero (P : GomesFinitePolynomialProfile) (x : ℝ) :
    gomesPolynomialGroundState P x ≠ 0 := by
  rw [gomesPolynomialGroundState_apply]
  exact Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _)

/-- In particular, every finite profile has a nonzero canonical state. -/
theorem gomesPolynomialGroundState_ne_zero (P : GomesFinitePolynomialProfile) :
    gomesPolynomialGroundState P ≠ 0 := by
  intro h
  exact gomesPolynomialGroundState_pointwise_ne_zero P 0 (congrArg (fun f : 𝓢(ℝ, ℂ) => f 0) h)

/-- Undressing the canonical half-density yields the constant scalar one. -/
theorem gomesPolynomialGroundState_undressed (P : GomesFinitePolynomialProfile) (x : ℝ) :
    dilatonUndressed P.val (gomesPolynomialGroundState P) x = 1 := by
  rw [dilatonUndressed, gomesPolynomialGroundState_apply]
  change (Real.exp (-P.val.eval x / 2) : ℂ) * (Real.exp (P.val.eval x / 2) : ℂ) = 1
  rw [← Complex.ofReal_mul, ← Real.exp_add]
  have hz : -P.val.eval x / 2 + P.val.eval x / 2 = 0 := by ring
  rw [hz, Real.exp_zero, Complex.ofReal_one]

/-- The induced shared connection annihilates its canonical half-density. -/
theorem gomesPolynomialGroundState_supercharge (P : GomesFinitePolynomialProfile) :
    dilatonSuperchargeCLM P.val (gomesPolynomialGroundState P) = 0 := by
  rw [dilatonSupercharge_kernel_iff]
  intro x
  rw [gomesPolynomialGroundState_undressed, gomesPolynomialGroundState_undressed]

/-- Every finite polynomial profile has an exact zero-energy Schwartz state. -/
theorem gomesPolynomialGroundState_kernel (P : GomesFinitePolynomialProfile) :
    dilatonHamiltonianCLM P.val (gomesPolynomialGroundState P) = 0 := by
  rw [dilatonHamiltonian_kernel_iff]
  exact gomesPolynomialGroundState_supercharge P

/-- Its squared norm is exactly the raw density, including constant log-amplitude. -/
theorem gomesPolynomialGroundState_norm_sq (P : GomesFinitePolynomialProfile) (x : ℝ) :
    ‖gomesPolynomialGroundState P x‖ ^ 2 = dilatonWeight P.val x := by
  rw [gomesPolynomialGroundState_apply, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _), pow_two, ← Real.exp_add]
  unfold dilatonWeight
  congr 1
  ring

/-- Every zero-energy state has an exact scalar normal form, even when H(0) is nonzero. -/
theorem gomesPolynomialGroundState_kernel_normal_form (P : GomesFinitePolynomialProfile) (ψ : 𝓢(ℝ, ℂ)) :
    dilatonHamiltonianCLM P.val ψ = 0 ↔
      ψ = dilatonUndressed P.val ψ 0 • gomesPolynomialGroundState P := by
  constructor
  · intro h
    have hc := (dilatonHamiltonian_kernel_classification P.val ψ).mp h
    ext x
    apply mul_left_cancel₀ (dilatonGauge_ne_zero P.val x)
    change dilatonUndressed P.val ψ x = dilatonGauge P.val x *
      (dilatonUndressed P.val ψ 0 * gomesPolynomialGroundState P x)
    rw [hc, mul_left_comm, ← dilatonUndressed, gomesPolynomialGroundState_undressed, mul_one]
  · intro h
    rw [h, map_smul, gomesPolynomialGroundState_kernel, smul_zero]

/-- The complete Schwartz kernel is the line generated by the canonical half-density. -/
theorem gomesPolynomialGroundState_kernel_span (P : GomesFinitePolynomialProfile) (ψ : 𝓢(ℝ, ℂ)) :
    dilatonHamiltonianCLM P.val ψ = 0 ↔ ∃ c : ℂ, ψ = c • gomesPolynomialGroundState P := by
  constructor
  · intro h
    exact ⟨dilatonUndressed P.val ψ 0, (gomesPolynomialGroundState_kernel_normal_form P ψ).mp h⟩
  · rintro ⟨c, rfl⟩
    rw [map_smul, gomesPolynomialGroundState_kernel, smul_zero]

end GaloisForLFunctions.HTGeometry
