import GaloisForLFunctions.HTGeometry.TwoDefectDecomposition

/-!
# The relative visibility degree

The card's relative visibility theorem reads `trdeg_K N = 1 + (1 − aut f)·π(g)`, a statement about
the transcendence degree of the compositum *over* the shadow field.  Cardinal arithmetic has no
cancellation, so this is genuinely stronger than the additive form when `trdeg_ℂ K` is infinite —
which happens exactly on the hypertranscendental stratum.

Both regimes are proved here by transporting the mutual-algebraicity statements to the base `↥K` via
`IntermediateField.extendScalars` and computing the simple extensions relatively.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

universe u

/-! ### Generic relative computations -/

/-- A simple transcendental extension, up to mutual algebraicity, has relative degree one. -/
theorem relTrdeg_eq_one_of_mutually_algebraic {F L : Type u} [Field F] [Field L] [Algebra F L]
    {A B : IntermediateField F L} (hAB : A ≤ B) {x : L} (hx : Transcendental ↥A x)
    (hxB : ∀ y : L, y ∈ B → IsAlgebraic ↥(IntermediateField.adjoin ↥A ({x} : Set L)) y)
    (hBx : ∀ y : L, y ∈ IntermediateField.adjoin ↥A ({x} : Set L) → IsAlgebraic ↥B y) :
    relTrdeg hAB = 1 := by
  rw [relTrdeg_eq_trdeg_extendScalars]
  have hmut := trdeg_eq_of_mutually_algebraic (K := ↥A) (L := L)
    (A := IntermediateField.extendScalars hAB)
    (B := IntermediateField.adjoin ↥A ({x} : Set L)) hxB hBx
  rw [hmut]
  exact trdeg_adjoin_simple_eq_one hx

/-- Adjoining one element to a generated field is generated by the enlarged set. -/
theorem restrictScalars_adjoin_singleton {F L : Type u} [Field F] [Field L] [Algebra F L]
    (A : IntermediateField F L) (S : Set L) (x : L) (hA : A = IntermediateField.adjoin F S) :
    (IntermediateField.adjoin ↥A ({x} : Set L)).restrictScalars F
      = IntermediateField.adjoin F (insert x S) := by
  rw [IntermediateField.restrictScalars_adjoin_eq_sup, hA,
    show insert x S = {x} ∪ S from rfl, IntermediateField.adjoin_union]
  exact sup_comm _ _

/-- The relative degree of a simple adjunction of a transcendental element is one. -/
theorem relTrdeg_adjoin_insert {F L : Type u} [Field F] [Field L] [Algebra F L]
    {S : Set L} {x : L} (hx : Transcendental ↥(IntermediateField.adjoin F S) x) :
    relTrdeg (show IntermediateField.adjoin F S ≤ IntermediateField.adjoin F (insert x S) from by
      rw [IntermediateField.adjoin_le_iff]
      exact fun y hy => IntermediateField.subset_adjoin F _ (Set.mem_insert_of_mem _ hy)) = 1 := by
  set A : IntermediateField F L := IntermediateField.adjoin F S with hA
  have hident : (IntermediateField.adjoin ↥A ({x} : Set L)).restrictScalars F
      = IntermediateField.adjoin F (insert x S) := restrictScalars_adjoin_singleton A S x hA
  refine relTrdeg_eq_one_of_mutually_algebraic _ hx ?_ ?_
  · intro y hy
    have hy' : y ∈ (IntermediateField.adjoin ↥A ({x} : Set L)).restrictScalars F := by
      rw [hident]
      exact hy
    exact isAlgebraic_algebraMap
      (⟨y, hy'⟩ : ↥(IntermediateField.adjoin ↥A ({x} : Set L)))
  · intro y hy
    have hy' : y ∈ IntermediateField.adjoin F (insert x S) := by
      rw [← hident]
      exact hy
    exact isAlgebraic_algebraMap (⟨y, hy'⟩ : ↥(IntermediateField.adjoin F (insert x S)))

/-! ### The visibility degree, collapsing regime -/

theorem shadowField_le_visibilityField {f g : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hcomp : Differentiable ℂ fun w => f (g w)) :
    IntermediateField.adjoin ℂ (shadowSet hg) ≤ visibilityField hg hcomp := by
  rw [IntermediateField.adjoin_le_iff]
  intro y hy
  exact IntermediateField.subset_adjoin ℂ _ (Or.inl hy)

/-- **Relative visibility, collapsing regime.**  When the first jet of the composition is algebraic
over `K(h)`, the compositum has relative degree one over the shadow field. -/
theorem relTrdeg_visibilityField_eq_one {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hderiv : IsAlgebraic ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) (shadowSet hg)))
      (jetElem hcomp 1)) :
    relTrdeg (shadowField_le_visibilityField hg hcomp) = 1 := by
  set K : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ (shadowSet hg) with hK
  have hident : (IntermediateField.adjoin ↥K
        ({jetElem hcomp 0} : Set (meroField (Set.univ : Set ℂ)))).restrictScalars ℂ
      = IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) (shadowSet hg)) :=
    restrictScalars_adjoin_singleton K (shadowSet hg) (jetElem hcomp 0) hK
  have htr : Transcendental ↥K (jetElem hcomp 0) :=
    not_isAlgebraic_comp_over_shadowField hf hg hcomp hfnp hgnp
  refine relTrdeg_eq_one_of_mutually_algebraic _ htr ?_ ?_
  · intro y hy
    have h := isAlgebraic_visibilityField_over_compAdjoin hg hcomp hderiv y hy
    rw [← hident] at h
    exact h
  · intro y hy
    have hy' : y ∈ IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) (shadowSet hg)) := by
      rw [← hident]
      exact hy
    exact isAlgebraic_compAdjoin_over_visibilityField hg hcomp y hy'

/-- **Relative visibility, autonomous case.** -/
theorem relTrdeg_visibilityField_autonomous {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (haut : AutonomousFirstOrder f)
    (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c) :
    relTrdeg (shadowField_le_visibilityField hg hcomp) = 1 :=
  relTrdeg_visibilityField_eq_one hf hg hcomp hfnp hgnp
    (isAlgebraic_jetElem_comp_one_of_autonomous hf hg haut hcomp hncomp)

/-- **Relative visibility, primitive-rigid case.** -/
theorem relTrdeg_visibilityField_primitive_rigid {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    (hfo : FirstOrderDA f)
    (hpi : IsAlgebraic ↥(IntermediateField.adjoin ℂ (shadowSet hg)) (jetElem hg 0)) :
    relTrdeg (shadowField_le_visibilityField hg hcomp) = 1 := by
  obtain ⟨d, m, c, ⟨i₀, hi₀, k₀, hk₀, hne⟩, hrel⟩ := hfo
  refine relTrdeg_visibilityField_eq_one hf hg hcomp hfnp hgnp ?_
  set Kh : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) (shadowSet hg)) with hKh
  have hH : jetElem hcomp 0 ∈ Kh := IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)
  have hKle : IntermediateField.adjoin ℂ (shadowSet hg) ≤ Kh := by
    rw [IntermediateField.adjoin_le_iff]
    intro y hy
    exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ hy)
  have hG : IsAlgebraic ↥Kh (jetElem hg 0) := isAlgebraic_of_le hKle hpi
  have ha := isAlgebraic_compJetElem_one_of_firstOrder hf hg hcomp hfnp hgnp hncg hncomp
    hi₀ hk₀ hne hrel hH hG
  have hjg1 : jetElem hg 1 ∈ Kh :=
    IntermediateField.subset_adjoin ℂ _
      (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨0, rfl⟩))
  rw [jetElem_comp_one_eq hf hg hcomp]
  exact mem_algebraicClosure_iff.mp (mul_mem (mem_algebraicClosure_iff.mpr ha)
    (mem_algebraicClosure_iff.mpr (isAlgebraic_algebraMap (⟨_, hjg1⟩ : ↥Kh))))

/-! ### The visibility degree, nonautonomous regime -/

theorem shadowField_le_innerAdjoin {g : ℂ → ℂ} (hg : Differentiable ℂ g) :
    IntermediateField.adjoin ℂ (shadowSet hg)
      ≤ IntermediateField.adjoin ℂ (insert (jetElem hg 0) (shadowSet hg)) := by
  rw [IntermediateField.adjoin_le_iff]
  intro y hy
  exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ hy)

theorem innerAdjoin_le_ghField {f g : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hcomp : Differentiable ℂ fun w => f (g w)) :
    IntermediateField.adjoin ℂ (insert (jetElem hg 0) (shadowSet hg)) ≤ ghField hg hcomp := by
  rw [ghField, IntermediateField.adjoin_le_iff]
  intro y hy
  exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ hy)

theorem shadowField_le_ghField {f g : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hcomp : Differentiable ℂ fun w => f (g w)) :
    IntermediateField.adjoin ℂ (shadowSet hg) ≤ ghField hg hcomp :=
  le_trans (shadowField_le_innerAdjoin hg) (innerAdjoin_le_ghField hg hcomp)

/-- **Relative visibility, nonautonomous case.**  The compositum has relative degree two over the
shadow field: the inner primitive state is not compressed. -/
theorem relTrdeg_visibilityField_nonautonomous {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ fun w => f (g w))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    (hfo : FirstOrderDA f) (hnaut : ¬ AutonomousFirstOrder f)
    (hpi : ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ (shadowSet hg)) (jetElem hg 0)) :
    relTrdeg (shadowField_le_visibilityField hg hcomp) = 2 := by
  classical
  obtain ⟨d, m, c, ⟨i₀, hi₀, k₀, hk₀, hne⟩, hrel⟩ := hfo
  -- the composed derivative and the inner function
  have haKgh : IsAlgebraic ↥(ghField hg hcomp) (compJetElem hf hg 1) :=
    isAlgebraic_compJetElem_one_of_firstOrder hf hg hcomp hfnp hgnp hncg hncomp hi₀ hk₀ hne hrel
      (jetElem_comp_zero_mem_ghField hg hcomp)
      (isAlgebraic_algebraMap (⟨_, jetElem_zero_mem_ghField hg hcomp⟩ : ↥(ghField hg hcomp)))
  have hGalgN : IsAlgebraic ↥(visibilityField hg hcomp) (jetElem hg 0) :=
    isAlgebraic_inner_over_visibilityField hf hg hcomp hncg hi₀ hk₀ hne hrel hnaut
  -- the compositum and `K(g,h)` have the same relative degree
  have hstep0 : relTrdeg (shadowField_le_visibilityField hg hcomp)
      = relTrdeg (shadowField_le_ghField hg hcomp) := by
    rw [relTrdeg_eq_trdeg_extendScalars, relTrdeg_eq_trdeg_extendScalars]
    exact trdeg_eq_of_mutually_algebraic
      (isAlgebraic_visibilityField_over_ghField hf hg hcomp haKgh)
      (isAlgebraic_ghField_over_visibilityField hg hcomp hGalgN)
  -- the two relative steps
  have hone : relTrdeg (shadowField_le_innerAdjoin hg) = 1 := relTrdeg_adjoin_insert hpi
  have htrH : Transcendental ↥(IntermediateField.adjoin ℂ
      (insert (jetElem hg 0) (shadowSet hg))) (jetElem hcomp 0) := by
    intro halg
    refine not_isAlgebraic_comp_over_jetField hf hg hcomp hfnp hgnp (isAlgebraic_of_le ?_ halg)
    rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | rfl | ⟨j, rfl⟩)
    · exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨0, rfl⟩)
    · exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)
    · exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨j + 1, rfl⟩)
  have htwo : relTrdeg (innerAdjoin_le_ghField hg hcomp) = 1 := relTrdeg_adjoin_insert htrH
  -- the tower over the shadow field
  have htower := trdeg_add_relTrdeg (F := ↥(IntermediateField.adjoin ℂ (shadowSet hg)))
    (A := IntermediateField.extendScalars (shadowField_le_innerAdjoin hg))
    (B := IntermediateField.extendScalars (shadowField_le_ghField hg hcomp))
    (innerAdjoin_le_ghField hg hcomp)
  rw [hstep0, relTrdeg_eq_trdeg_extendScalars, ← htower,
    ← relTrdeg_eq_trdeg_extendScalars (shadowField_le_innerAdjoin hg), hone,
    show relTrdeg (F := ↥(IntermediateField.adjoin ℂ (shadowSet hg)))
      (A := IntermediateField.extendScalars (shadowField_le_innerAdjoin hg))
      (B := IntermediateField.extendScalars (shadowField_le_ghField hg hcomp))
      (innerAdjoin_le_ghField hg hcomp) = 1 from htwo]
  norm_num

end

end GaloisForLFunctions.HTGeometry
