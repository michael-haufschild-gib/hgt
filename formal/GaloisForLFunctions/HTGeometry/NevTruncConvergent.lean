import GaloisForLFunctions.HTGeometry.EntryComplexLimit

/-!
# The truncated Nevanlinna entries are the J-fraction convergent data

Each truncated entry is `±1 + h₀·z·(a bilinear partial sum)`, and the Christoffel–Darboux
identities collapse those sums to bilinear combinations of consecutive `monicOrtho` and
`secondKind` values.  The additive `±1` is cancelled exactly by the `1/h₀` constant of the mixed
identity, leaving

`B_n(z) = h₀·(Q_{n+1}(z)R_n(0) − Q_n(z)R_{n+1}(0))/h_n`,
`A_n(z) = h₀·(R_{n+1}(z)R_n(0) − R_n(z)R_{n+1}(0))/h_n`,

and the two companions with the roles of `0` and `z` exchanged.  So the Nevanlinna truncations *are*
the convergent data of the J-fraction generated by the three-term recurrence.
-/

open scoped BigOperators

namespace HTGeometry

variable {s : ℕ → ℝ}

/-- **The truncated `B` entry in convergent form.** -/
theorem nevBtruncC_eq (h : PositiveMomentForm s) (n : ℕ) (z : ℂ) :
    nevBtruncC s n z
      = ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) *
          ((monicOrthoC s (n + 1) z * secondKindC s n 0 -
            monicOrthoC s n z * secondKindC s (n + 1) 0) /
            ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ)) := by
  have h0 : ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s 0)
  have hn : ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s n)
  have hcd := mixedChristoffelDarbouxC h n z 0
  rw [nevBtruncC, bilinearPartialSum]
  have hcomm : ∑ k ∈ Finset.range (n + 1),
      secondKindC s k 0 * monicOrthoC s k z /
        ((momentInner s (monicOrtho s k) (monicOrtho s k) : ℝ) : ℂ)
      = ∑ k ∈ Finset.range (n + 1),
      monicOrthoC s k z * secondKindC s k 0 /
        ((momentInner s (monicOrtho s k) (monicOrtho s k) : ℝ) : ℂ) := by
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [mul_comm]
  rw [hcomm]
  have hz : (z - 0) = z := by ring
  rw [hz] at hcd
  rw [mul_assoc, hcd]
  field_simp
  ring

/-- **The truncated `A` entry in convergent form.** -/
theorem nevAtruncC_eq (h : PositiveMomentForm s) (n : ℕ) (z : ℂ) :
    nevAtruncC s n z
      = -(((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) *
          ((secondKindC s (n + 1) 0 * secondKindC s n z -
            secondKindC s n 0 * secondKindC s (n + 1) z) /
            ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ))) := by
  have hn : ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s n)
  have hcd := secondKindChristoffelDarbouxC h n 0 z
  rw [nevAtruncC, bilinearPartialSum]
  have hz : ((0 : ℂ) - z) = -z := by ring
  rw [hz] at hcd
  have hzs : z * ∑ k ∈ Finset.range (n + 1),
      secondKindC s k 0 * secondKindC s k z /
        ((momentInner s (monicOrtho s k) (monicOrtho s k) : ℝ) : ℂ)
      = -((secondKindC s (n + 1) 0 * secondKindC s n z -
          secondKindC s n 0 * secondKindC s (n + 1) z) /
          ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ)) := by
    linear_combination -hcd
  rw [mul_assoc, hzs]
  ring

/-- **The truncated `C` entry in convergent form.** -/
theorem nevCtruncC_eq (h : PositiveMomentForm s) (n : ℕ) (z : ℂ) :
    nevCtruncC s n z
      = -(((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) *
          ((monicOrthoC s (n + 1) 0 * secondKindC s n z -
            monicOrthoC s n 0 * secondKindC s (n + 1) z) /
            ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ))) := by
  have h0 : ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s 0)
  have hn : ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s n)
  have hcd := mixedChristoffelDarbouxC h n 0 z
  rw [nevCtruncC, bilinearPartialSum]
  have hz : ((0 : ℂ) - z) = -z := by ring
  rw [hz] at hcd
  have hzs : z * ∑ k ∈ Finset.range (n + 1),
      monicOrthoC s k 0 * secondKindC s k z /
        ((momentInner s (monicOrtho s k) (monicOrtho s k) : ℝ) : ℂ)
      = -((monicOrthoC s (n + 1) 0 * secondKindC s n z -
          monicOrthoC s n 0 * secondKindC s (n + 1) z) /
          ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ))
        - 1 / ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) := by
    linear_combination -hcd
  rw [mul_assoc, hzs]
  field_simp
  ring

/-- **The truncated `D` entry in convergent form.** -/
theorem nevDtruncC_eq (h : PositiveMomentForm s) (n : ℕ) (z : ℂ) :
    nevDtruncC s n z
      = -(((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) *
          ((monicOrthoC s (n + 1) 0 * monicOrthoC s n z -
            monicOrthoC s n 0 * monicOrthoC s (n + 1) z) /
            ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ))) := by
  have hn : ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s n)
  have hcd := christoffelDarbouxC h n 0 z
  rw [nevDtruncC, bilinearPartialSum]
  have hz : ((0 : ℂ) - z) = -z := by ring
  rw [hz] at hcd
  have hzs : z * ∑ k ∈ Finset.range (n + 1),
      monicOrthoC s k 0 * monicOrthoC s k z /
        ((momentInner s (monicOrtho s k) (monicOrtho s k) : ℝ) : ℂ)
      = -((monicOrthoC s (n + 1) 0 * monicOrthoC s n z -
          monicOrthoC s n 0 * monicOrthoC s (n + 1) z) /
          ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ)) := by
    linear_combination -hcd
  rw [mul_assoc, hzs]
  ring


/-! ## The finite-stage Möbius assembly -/

/-- The Wronskian at the origin, cleared of its denominator. -/
theorem monicOrthoC_wronskian_zero_mul (h : PositiveMomentForm s) (n : ℕ) :
    (monicOrthoC s (n + 1) 0 * secondKindC s n 0 -
        monicOrthoC s n 0 * secondKindC s (n + 1) 0) *
      ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ)
      = -((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) := by
  have h0 : ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s 0)
  rw [monicOrthoC_wronskian h n 0]
  push_cast
  field_simp

/-- **The finite-stage transform is a point of the truncated Möbius family.** -/
theorem nevTrunc_moebius_eq_convergent (h : PositiveMomentForm s) (n : ℕ) (z : ℂ)
    (hR : secondKindC s (n + 1) 0 ≠ 0) (hQz : monicOrthoC s (n + 1) z ≠ 0) :
    (nevAtruncC s n z * (monicOrthoC s (n + 1) 0 / secondKindC s (n + 1) 0) -
        nevCtruncC s n z) /
      (nevBtruncC s n z * (monicOrthoC s (n + 1) 0 / secondKindC s (n + 1) 0) -
        nevDtruncC s n z)
      = secondKindC s (n + 1) z / monicOrthoC s (n + 1) z := by
  have h0 : ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s 0)
  have hn : ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ) ≠ 0 := by
    simpa using h.self_ne_zero (monicOrtho_ne_zero s n)
  have hW := monicOrthoC_wronskian_zero_mul h n
  have hnum : nevAtruncC s n z * (monicOrthoC s (n + 1) 0 / secondKindC s (n + 1) 0) -
      nevCtruncC s n z
      = -(secondKindC s (n + 1) z / secondKindC s (n + 1) 0) := by
    rw [nevAtruncC_eq h, nevCtruncC_eq h]
    field_simp
    linear_combination (secondKindC s (n + 1) z) * hW
  have hden : nevBtruncC s n z * (monicOrthoC s (n + 1) 0 / secondKindC s (n + 1) 0) -
      nevDtruncC s n z
      = -(monicOrthoC s (n + 1) z / secondKindC s (n + 1) 0) := by
    rw [nevBtruncC_eq h, nevDtruncC_eq h]
    field_simp
    linear_combination (monicOrthoC s (n + 1) z) * hW
  rw [hnum, hden]
  field_simp


/-! ## Passage to the limit -/

open Filter Topology in
/-- **The entire `B` entry is the limit of the convergent data.**  Combining the convergent form of
the truncation with the existing uniform-limit theorem, the bilinear combination of consecutive
`monicOrtho` and `secondKind` values converges to the entire Nevanlinna entry. -/
theorem tendsto_convergentData_nevBinf (h : PositiveMomentForm s) {S P : ℝ}
    (hS : ∀ N, kernelRoot s (fun j => monicOrthoC s j 0) N ≤ S)
    (hP : ∀ N, kernelRoot s (fun j => secondKindC s j 0) N ≤ P) (z : ℂ) :
    Tendsto (fun n => ((momentInner s (monicOrtho s 0) (monicOrtho s 0) : ℝ) : ℂ) *
        ((monicOrthoC s (n + 1) z * secondKindC s n 0 -
          monicOrthoC s n z * secondKindC s (n + 1) 0) /
          ((momentInner s (monicOrtho s n) (monicOrtho s n) : ℝ) : ℂ)))
      atTop (nhds (nevBinf s z)) := by
  have hbase := tendsto_nevBtruncC h hS hP z
  refine hbase.congr fun n => ?_
  exact nevBtruncC_eq h n z


