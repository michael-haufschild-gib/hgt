import GaloisForLFunctions.HTGeometry.MilnorKGrading
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# The degree-two Milnor symbol and its standard identities

`K_2^M(F)` is generated by the symbols `{a, b}`, and the two defining relations give the whole
elementary calculus of those symbols: bilinearity, the Steinberg relation, the vanishing of
`{a, −a}`, and antisymmetry.

`{a, −a} = 0` is the usual computation `−a = (1 − a)/(1 − a⁻¹)`: the first factor is killed by
Steinberg at `a`, the second by Steinberg at `a⁻¹` after moving the inverse out of the first slot.
Antisymmetry follows by expanding `{ab, −ab} = 0` in both slots.

These are the identities the Euclidean reduction of a symbol over a number field consumes.
-/

namespace GaloisForLFunctions.HTGeometry

variable (F : Type*) [Field F]

/-- **The degree-two Milnor symbol** `{a, b}`. -/
def milnorSym2 (a b : Fˣ) : MilnorKDeg F 2 := milnorClassDeg F 2 ⟨[a, b], rfl⟩

variable {F}

theorem milnorSym2_eq_class {a b : Fˣ} {l : List Fˣ} (hl : l.length = 2) (h : l = [a, b]) :
    milnorClassDeg F 2 ⟨l, hl⟩ = milnorSym2 F a b :=
  milnorClassDeg_congr F hl rfl h

theorem milnorSym2_mul_left (a a' b : Fˣ) :
    milnorSym2 F (a * a') b = milnorSym2 F a b + milnorSym2 F a' b :=
  milnorClassDeg_mul_of_eq F a a' [] [b] rfl rfl rfl rfl rfl rfl

theorem milnorSym2_mul_right (a b b' : Fˣ) :
    milnorSym2 F a (b * b') = milnorSym2 F a b + milnorSym2 F a b' :=
  milnorClassDeg_mul_of_eq F b b' [a] [] rfl rfl rfl rfl rfl rfl

/-- **The Steinberg relation for the degree-two symbol.** -/
theorem milnorSym2_steinberg {a : Fˣ} (ha : (a : F) ≠ 1) :
    milnorSym2 F a (oneSubUnit ha) = 0 :=
  milnorClassDeg_steinberg_of_eq F ha [] [] rfl rfl

theorem milnorSym2_one_left (b : Fˣ) : milnorSym2 F 1 b = 0 := by
  have h := milnorSym2_mul_left (F := F) 1 1 b
  rw [one_mul] at h
  have h2 : milnorSym2 F 1 b + 0 = milnorSym2 F 1 b + milnorSym2 F 1 b := by
    rw [add_zero]
    exact h
  exact (add_left_cancel h2).symm

theorem milnorSym2_one_right (a : Fˣ) : milnorSym2 F a 1 = 0 := by
  have h := milnorSym2_mul_right (F := F) a 1 1
  rw [one_mul] at h
  have h2 : milnorSym2 F a 1 + 0 = milnorSym2 F a 1 + milnorSym2 F a 1 := by
    rw [add_zero]
    exact h
  exact (add_left_cancel h2).symm

theorem milnorSym2_inv_left (a b : Fˣ) : milnorSym2 F a⁻¹ b = -milnorSym2 F a b := by
  have h := milnorSym2_mul_left (F := F) a a⁻¹ b
  rw [mul_inv_cancel, milnorSym2_one_left] at h
  refine eq_neg_of_add_eq_zero_left ?_
  rw [add_comm]
  exact h.symm

theorem milnorSym2_inv_right (a b : Fˣ) : milnorSym2 F a b⁻¹ = -milnorSym2 F a b := by
  have h := milnorSym2_mul_right (F := F) a b b⁻¹
  rw [mul_inv_cancel, milnorSym2_one_right] at h
  refine eq_neg_of_add_eq_zero_left ?_
  rw [add_comm]
  exact h.symm

/-- **`{a, −a} = 0`.** -/
theorem milnorSym2_neg_self (a : Fˣ) : milnorSym2 F a (-a) = 0 := by
  by_cases ha : (a : F) = 1
  · have hone : a = 1 := Units.ext ha
    rw [hone, milnorSym2_one_left]
  · have hinv : ((a⁻¹ : Fˣ) : F) ≠ 1 := by
      intro hcon
      apply ha
      have h1 : a⁻¹ = 1 := Units.ext hcon
      have h2 : a = 1 := by
        rw [← inv_inv a, h1, inv_one]
      rw [h2]
      rfl
    have hane : (a : F) ≠ 0 := a.ne_zero
    have hval : ((oneSubUnit ha : Fˣ) : F) = 1 - (a : F) := rfl
    have hval' : ((oneSubUnit hinv : Fˣ) : F) = 1 - (a : F)⁻¹ := by
      show 1 - ((a⁻¹ : Fˣ) : F) = 1 - (a : F)⁻¹
      congr 1
      simp
    have hsub' : (1 : F) - (a : F)⁻¹ ≠ 0 := by
      rw [← hval']
      exact (oneSubUnit hinv).ne_zero
    have hkey : (-a : Fˣ) = oneSubUnit ha * (oneSubUnit hinv)⁻¹ := by
      refine Units.ext ?_
      show -(a : F) = ((oneSubUnit ha : Fˣ) : F) * (((oneSubUnit hinv)⁻¹ : Fˣ) : F)
      rw [Units.val_inv_eq_inv_val, hval, hval', eq_mul_inv_iff_mul_eq₀ hsub']
      have hcancel : (a : F) * (a : F)⁻¹ = 1 := mul_inv_cancel₀ hane
      linear_combination hcancel
    have hz : milnorSym2 F a (oneSubUnit hinv) = 0 := by
      have h := milnorSym2_inv_left (F := F) a (oneSubUnit hinv)
      rw [milnorSym2_steinberg hinv] at h
      exact (neg_eq_zero.mp h.symm)
    rw [hkey, milnorSym2_mul_right, milnorSym2_steinberg, milnorSym2_inv_right, hz]
    simp

/-- **Antisymmetry of the degree-two symbol.** -/
theorem milnorSym2_antisymm (a b : Fˣ) : milnorSym2 F a b = -milnorSym2 F b a := by
  have h := milnorSym2_neg_self (F := F) (a * b)
  have hneg1 : (-(a * b) : Fˣ) = (-a) * b := by
    refine Units.ext ?_
    push_cast
    ring
  have hneg2 : (-(a * b) : Fˣ) = a * (-b) := by
    refine Units.ext ?_
    push_cast
    ring
  have hA : milnorSym2 F a (-(a * b)) = milnorSym2 F a b := by
    rw [hneg1, milnorSym2_mul_right, milnorSym2_neg_self]
    simp
  have hB : milnorSym2 F b (-(a * b)) = milnorSym2 F b a := by
    rw [hneg2, milnorSym2_mul_right, milnorSym2_neg_self]
    simp
  rw [milnorSym2_mul_left, hA, hB] at h
  exact eq_neg_of_add_eq_zero_left h

/-- **The degree-two symbols generate.** -/
theorem closure_range_milnorSym2 :
    AddSubgroup.closure (Set.range fun p : Fˣ × Fˣ => milnorSym2 F p.1 p.2) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  refine QuotientAddGroup.induction_on x fun w => ?_
  induction w using FreeAbelianGroup.induction_on with
  | zero => exact (AddSubgroup.closure _).zero_mem
  | of s =>
      obtain ⟨l, hl⟩ := s
      match l, hl with
      | [a, b], _ =>
          exact AddSubgroup.subset_closure ⟨(a, b), rfl⟩
  | neg s ih =>
      have hmk : (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F 2)
          (-FreeAbelianGroup.of s))
          = -(QuotientAddGroup.mk (s := milnorRelSubgroupDeg F 2)
            (FreeAbelianGroup.of s)) := rfl
      rw [hmk]
      refine (AddSubgroup.closure _).neg_mem ?_
      obtain ⟨l, hl⟩ := s
      match l, hl with
      | [a, b], _ =>
          exact AddSubgroup.subset_closure ⟨(a, b), rfl⟩
  | add u v hu hv =>
      have hmk : (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F 2) (u + v))
          = QuotientAddGroup.mk (s := milnorRelSubgroupDeg F 2) u
            + QuotientAddGroup.mk (s := milnorRelSubgroupDeg F 2) v := rfl
      rw [hmk]
      exact (AddSubgroup.closure _).add_mem hu hv

/-- The degree-two symbol in its left slot, as a homomorphism out of the additive form of the
unit group. -/
def milnorSym2LeftHom (b : Fˣ) : Additive Fˣ →+ MilnorKDeg F 2 where
  toFun a := milnorSym2 F (Additive.toMul a) b
  map_zero' := milnorSym2_one_left b
  map_add' x y := milnorSym2_mul_left (Additive.toMul x) (Additive.toMul y) b

theorem milnorSym2LeftHom_apply (a b : Fˣ) :
    milnorSym2LeftHom (F := F) b (Additive.ofMul a) = milnorSym2 F a b := rfl

/-- **The symbol is `ℤ`-linear in the left slot.** -/
theorem milnorSym2_zpow_left (a b : Fˣ) (n : ℤ) :
    milnorSym2 F (a ^ n) b = n • milnorSym2 F a b := by
  have h : (milnorSym2LeftHom (F := F) b) (n • (Additive.ofMul a))
      = n • (milnorSym2LeftHom (F := F) b) (Additive.ofMul a) := map_zsmul _ _ _
  have hz : (n • (Additive.ofMul a) : Additive Fˣ) = Additive.ofMul (a ^ n) := rfl
  rw [hz] at h
  exact h

/-- **The symbol is `ℤ`-linear in the right slot.** -/
theorem milnorSym2_zpow_right (a b : Fˣ) (n : ℤ) :
    milnorSym2 F a (b ^ n) = n • milnorSym2 F a b := by
  have h1 : milnorSym2 F a (b ^ n) = -milnorSym2 F (b ^ n) a := milnorSym2_antisymm a (b ^ n)
  have h2 : milnorSym2 F (b ^ n) a = n • milnorSym2 F b a := milnorSym2_zpow_left b a n
  have h3 : milnorSym2 F b a = -milnorSym2 F a b := milnorSym2_antisymm b a
  rw [h1, h2, h3, smul_neg, neg_neg]

end GaloisForLFunctions.HTGeometry
