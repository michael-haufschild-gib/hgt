import Mathlib

/-!
# Regular sequences, depth, and the Cohen–Macaulay condition

Mathlib has regular sequences on a module (`RingTheory.Sequence.IsRegular`) but neither depth nor the
Cohen–Macaulay condition.  This file supplies both for a commutative ring acting on itself, phrased
throughout with ideal quotients so that `ringKrullDim` applies directly.

The substantive theorem is that a ring-regular sequence drops the Krull dimension by its own length:
each entry is a nonzerodivisor modulo the previous ones, so
`ringKrullDim_quotient_succ_le_of_nonZeroDivisor` applies at every step, and the third isomorphism
theorem identifies the successive quotients.  Since the final quotient is nontrivial, a regular
sequence is never longer than the dimension — which makes `IsCohenMacaulayRing`, the existence of a
regular sequence of full length, exactly the statement that depth equals dimension.
-/

namespace GaloisForLFunctions.HTGeometry

universe u

variable {R : Type u} [CommRing R]

/-- `x` is a nonzerodivisor modulo `I`. -/
def IsRegularOn (I : Ideal R) (x : R) : Prop :=
  (Ideal.Quotient.mk I x) ∈ nonZeroDivisors (R ⧸ I)

/-- A ring-regular sequence: every entry is a nonzerodivisor modulo the ideal generated by the
earlier ones, and the ideal generated by the whole list is proper. -/
structure IsRingRegularSeq (rs : List R) : Prop where
  regular : ∀ i, ∀ h : i < rs.length, IsRegularOn (Ideal.ofList (rs.take i)) rs[i]
  proper : Ideal.ofList rs ≠ ⊤

theorem ofList_nil : Ideal.ofList ([] : List R) = ⊥ := by
  simp [Ideal.ofList]

theorem ofList_cons (r : R) (rs : List R) :
    Ideal.ofList (r :: rs) = Ideal.span {r} ⊔ Ideal.ofList rs := by
  have hset : {x : R | x ∈ (r :: rs)} = insert r {x : R | x ∈ rs} := by
    ext x; simp
  rw [Ideal.ofList, Ideal.ofList, hset, Ideal.span_insert]

theorem quotient_mk_bot_injective : Function.Injective (Ideal.Quotient.mk (⊥ : Ideal R)) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  rwa [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_bot] at ha

theorem mem_nonZeroDivisors_of_bot {x : R}
    (h : (Ideal.Quotient.mk (⊥ : Ideal R)) x ∈ nonZeroDivisors (R ⧸ (⊥ : Ideal R))) :
    x ∈ nonZeroDivisors R := by
  have key : ∀ y : R, y * x = 0 → y = 0 := by
    intro y hy
    have hmul : (Ideal.Quotient.mk (⊥ : Ideal R) y) * (Ideal.Quotient.mk (⊥ : Ideal R) x) = 0 := by
      rw [← map_mul, hy, map_zero]
    have hz := (mem_nonZeroDivisors_iff.mp h).2 _ hmul
    exact quotient_mk_bot_injective (by rw [hz, map_zero])
  rw [mem_nonZeroDivisors_iff]
  exact ⟨fun y hy => key y (by rw [mul_comm]; exact hy), key⟩

theorem nonZeroDivisor_of_isRingRegularSeq_cons {r : R} {rs : List R}
    (h : IsRingRegularSeq (r :: rs)) : r ∈ nonZeroDivisors R := by
  have h0 := h.regular 0 (by simp)
  rw [IsRegularOn, List.take_zero, ofList_nil] at h0
  have hidx : (r :: rs)[0] = r := rfl
  rw [hidx] at h0
  exact mem_nonZeroDivisors_of_bot h0

theorem mem_nonZeroDivisors_of_ringEquiv {A B : Type*} [CommRing A] [CommRing B]
    (e : A ≃+* B) {a : A} (h : a ∈ nonZeroDivisors A) : e a ∈ nonZeroDivisors B := by
  rw [mem_nonZeroDivisors_iff] at h ⊢
  refine ⟨fun y hy => ?_, fun y hy => ?_⟩
  · have : e (a * e.symm y) = 0 := by rw [map_mul, e.apply_symm_apply, hy]
    have h2 : a * e.symm y = 0 := by
      have := congrArg e.symm this
      simpa using this
    have := h.1 _ h2
    have := congrArg e this
    simpa using this
  · have : e (e.symm y * a) = 0 := by rw [map_mul, e.apply_symm_apply, hy]
    have h2 : e.symm y * a = 0 := by
      have := congrArg e.symm this
      simpa using this
    have := h.2 _ h2
    have := congrArg e this
    simpa using this

theorem ofList_map {S : Type*} [CommRing S] (f : R →+* S) (l : List R) :
    Ideal.ofList (l.map f) = (Ideal.ofList l).map f := by
  rw [Ideal.ofList, Ideal.ofList, Ideal.map_span]
  congr 1
  ext x
  simp

/-- The tail of a ring-regular sequence is ring-regular modulo the head. -/
theorem isRingRegularSeq_tail {r : R} {rs : List R} (h : IsRingRegularSeq (r :: rs)) :
    IsRingRegularSeq (rs.map (Ideal.Quotient.mk (Ideal.span {r}))) := by
  set I : Ideal R := Ideal.span {r} with hI
  constructor
  · intro i hi
    rw [List.length_map] at hi
    set J : Ideal R := Ideal.ofList (rs.take i) with hJ
    have hlist : Ideal.ofList (List.take i (rs.map (Ideal.Quotient.mk I)))
        = Ideal.map (Ideal.Quotient.mk I) J := by
      rw [← List.map_take, ofList_map, hJ]
    have hsup : I ⊔ J = Ideal.ofList ((r :: rs).take (i + 1)) := by
      rw [List.take_succ_cons, ofList_cons, hI, hJ]
    have hreg := h.regular (i + 1) (by simpa using hi)
    rw [IsRegularOn, ← hsup] at hreg
    simp only [List.getElem_cons_succ] at hreg
    rw [IsRegularOn, hlist]
    have hback := mem_nonZeroDivisors_of_ringEquiv (DoubleQuot.quotQuotEquivQuotSup I J).symm hreg
    have helt : (DoubleQuot.quotQuotEquivQuotSup I J).symm ((Ideal.Quotient.mk (I ⊔ J)) rs[i])
        = Ideal.Quotient.mk (Ideal.map (Ideal.Quotient.mk I) J)
            ((rs.map (Ideal.Quotient.mk I))[i]) := by
      rw [← DoubleQuot.quotQuotEquivQuotSup_quotQuotMk I J rs[i], RingEquiv.symm_apply_apply,
        List.getElem_map]
      rfl
    rwa [helt] at hback
  · rw [ofList_map]
    intro htop
    apply h.proper
    rw [ofList_cons, ← hI]
    have hcm := Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      (Ideal.ofList rs)
    rw [htop, Ideal.comap_top, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at hcm
    rw [sup_comm]
    exact hcm.symm


/-- The quotient by the zero ideal has the same Krull dimension. -/
theorem ringKrullDim_quotient_bot :
    ringKrullDim (R ⧸ (⊥ : Ideal R)) = ringKrullDim R :=
  (ringKrullDim_eq_of_ringEquiv
    (RingEquiv.ofBijective (Ideal.Quotient.mk (⊥ : Ideal R))
      ⟨quotient_mk_bot_injective, Ideal.Quotient.mk_surjective⟩)).symm

/-- **A ring-regular sequence drops the Krull dimension by its length.** -/
theorem ringKrullDim_quotient_ofList_add_length_le :
    ∀ (n : ℕ) {R : Type u} [CommRing R] (rs : List R), rs.length = n → IsRingRegularSeq rs →
      ringKrullDim (R ⧸ Ideal.ofList rs) + (rs.length : WithBot ℕ∞) ≤ ringKrullDim R := by
  intro n
  induction n with
  | zero =>
      intro R _ rs hlen _
      have hnil : rs = [] := List.eq_nil_of_length_eq_zero hlen
      subst hnil
      rw [ofList_nil, ringKrullDim_quotient_bot]
      simp
  | succ n ih =>
      intro R _ rs hlen hreg
      obtain ⟨r, rs', rfl⟩ : ∃ r rs', rs = r :: rs' := by
        cases rs with
        | nil => simp at hlen
        | cons a l => exact ⟨a, l, rfl⟩
      have hlen' : rs'.length = n := by simpa using hlen
      set I : Ideal R := Ideal.span {r} with hI
      have hnzd : r ∈ nonZeroDivisors R := nonZeroDivisor_of_isRingRegularSeq_cons hreg
      have hstep : ringKrullDim (R ⧸ I) + 1 ≤ ringKrullDim R :=
        ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnzd
      have htail := isRingRegularSeq_tail hreg
      have hih := ih (rs'.map (Ideal.Quotient.mk I)) (by simpa using hlen') htail
      have hiso : ringKrullDim ((R ⧸ I) ⧸ Ideal.ofList (rs'.map (Ideal.Quotient.mk I)))
          = ringKrullDim (R ⧸ Ideal.ofList (r :: rs')) := by
        rw [ofList_map, ofList_cons, ← hI]
        exact ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotSup I (Ideal.ofList rs'))
      rw [hiso, List.length_map] at hih
      have hlenc : ((r :: rs').length : WithBot ℕ∞) = (rs'.length : WithBot ℕ∞) + 1 := by
        simp [List.length_cons]
      rw [hlenc, ← add_assoc]
      calc ringKrullDim (R ⧸ Ideal.ofList (r :: rs')) + (rs'.length : WithBot ℕ∞) + 1
          ≤ ringKrullDim (R ⧸ I) + 1 := by gcongr
        _ ≤ ringKrullDim R := hstep


theorem nontrivial_quotient_of_isRingRegularSeq {rs : List R} (h : IsRingRegularSeq rs) :
    Nontrivial (R ⧸ Ideal.ofList rs) :=
  Ideal.Quotient.nontrivial_iff.mpr h.proper

/-- **A ring-regular sequence is no longer than the Krull dimension.** -/
theorem length_le_ringKrullDim_of_isRingRegularSeq (rs : List R) (h : IsRingRegularSeq rs) :
    ((rs.length : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim R := by
  haveI := nontrivial_quotient_of_isRingRegularSeq h
  have hbase : (0 : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ Ideal.ofList rs) :=
    ringKrullDim_nonneg_of_nontrivial
  have hmain := ringKrullDim_quotient_ofList_add_length_le rs.length rs rfl h
  calc ((rs.length : ℕ∞) : WithBot ℕ∞)
      = 0 + ((rs.length : ℕ∞) : WithBot ℕ∞) := by rw [zero_add]
    _ ≤ ringKrullDim (R ⧸ Ideal.ofList rs) + ((rs.length : ℕ∞) : WithBot ℕ∞) := by gcongr
    _ ≤ ringKrullDim R := hmain

/-- The depth of a ring: the supremum of the lengths of its ring-regular sequences. -/
noncomputable def ringDepth (R : Type u) [CommRing R] : ℕ∞ :=
  ⨆ rs : {rs : List R // IsRingRegularSeq rs}, ((rs.1.length : ℕ) : ℕ∞)

/-- **A Cohen–Macaulay ring**: one carrying a ring-regular sequence as long as its Krull
dimension.  Together with `length_le_ringKrullDim_of_isRingRegularSeq` this says exactly that the
depth equals the dimension. -/
def IsCohenMacaulayRing (R : Type u) [CommRing R] : Prop :=
  ∃ rs : List R, IsRingRegularSeq rs ∧
    ((rs.length : ℕ∞) : WithBot ℕ∞) = ringKrullDim R

theorem IsCohenMacaulayRing.exists_maximal_regular {R : Type u} [CommRing R]
    (h : IsCohenMacaulayRing R) :
    ∃ rs : List R, IsRingRegularSeq rs ∧
      ∀ ss : List R, IsRingRegularSeq ss → ss.length ≤ rs.length := by
  obtain ⟨rs, hrs, hlen⟩ := h
  refine ⟨rs, hrs, fun ss hss => ?_⟩
  have h1 := length_le_ringKrullDim_of_isRingRegularSeq ss hss
  rw [← hlen] at h1
  exact_mod_cast h1


end GaloisForLFunctions.HTGeometry
