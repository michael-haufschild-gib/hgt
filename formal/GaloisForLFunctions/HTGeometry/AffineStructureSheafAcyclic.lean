import GaloisForLFunctions.HTGeometry.SheafCechLeray
import GaloisForLFunctions.HTGeometry.CechLocalizedExact
import GaloisForLFunctions.HTGeometry.LocalizationAwayDivisibility
import Mathlib.AlgebraicGeometry.AffineScheme

/-!
# Serre's vanishing theorem for the structure sheaf on affine opens

For a scheme `X`, the structure sheaf viewed as a sheaf of abelian groups has no higher
cohomology on any affine open set `V`:

`H^q(V, 𝒪_X) = 0` for `q > 0`,

with `H^q` the `Ext` cohomology of sheaves of abelian groups.

The proof is Cartan's criterion for the basic open subsets of `V`.  A finite cover of a basic open
`W` by basic opens `D(γ_i)` has the unit ideal generated by the `γ_i` in `Γ(W)`, the sections over
the intersection indexed by `s` form the localization of `Γ(W)` at `∏_{i ∈ s} γ_i`, and along the
enlargement `s ⊆ s ∪ {k}` the restriction is the localization map inverting `γ_k`.  The local
contraction criterion `FinsetCechDatum.exactAt_of_localized` then makes the Čech complex exact.

* `HTGeometry.schemeAbSheaf` : the structure sheaf as a sheaf of abelian groups.
* `HTGeometry.basicCover_exactAt` : Čech exactness of a basic-open cover of an affine open.
* `HTGeometry.affine_acyclicOn` : **Serre's vanishing theorem**.
-/

namespace HTGeometry

open CategoryTheory TopologicalSpace Opposite AlgebraicGeometry RHTower

universe w u

/-! ## The structure sheaf as an abelian sheaf -/

/-- **The structure sheaf of a scheme as a sheaf of abelian groups.** -/
noncomputable def schemeAbSheaf (X : Scheme.{u}) : TopCat.Sheaf AddCommGrpCat.{u} X :=
  (sheafCompose (Opens.grothendieckTopology X)
    (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)).obj X.sheaf

/-! ## Čech complexes of basic-open covers -/

section BasicCover

variable {X : Scheme.{u}} {W : X.Opens} {n : ℕ} (γ : Fin n → Γ(X, W))

/-- The cover of `W` by the basic open sets of a finite family of sections. -/
def basicCover : Fin n → X.Opens := fun i => X.basicOpen (γ i)

theorem coverInter_insert (V : X.Opens) (U : Fin n → X.Opens) (a : Fin n) (s : Finset (Fin n)) :
    coverInter V U (insert a s) = U a ⊓ coverInter V U s := by
  rw [coverInter, coverInter, Finset.inf_insert]
  ac_rfl

/-- The intersections of a basic-open cover are basic open sets. -/
theorem coverInter_basicCover (s : Finset (Fin n)) :
    coverInter W (basicCover γ) s = X.basicOpen (∏ i ∈ s, γ i) := by
  induction s using Finset.induction_on with
  | empty => rw [coverInter_empty, Finset.prod_empty, Scheme.basicOpen_one]
  | insert a s ha ih =>
    rw [coverInter_insert, ih, Finset.prod_insert ha, Scheme.basicOpen_mul]
    rfl

theorem coverInter_le (V : X.Opens) (U : Fin n → X.Opens) (s : Finset (Fin n)) :
    coverInter V U s ≤ V := inf_le_left

/-- Restriction of sections from `W` to an intersection of the cover. -/
noncomputable def basicCoverRes (s : Finset (Fin n)) :
    Γ(X, W) →+* Γ(X, coverInter W (basicCover γ) s) :=
  (X.presheaf.map (homOfLE (coverInter_le W (basicCover γ) s)).op).hom

theorem basicCoverRes_comp {s t : Finset (Fin n)} (h : s ⊆ t) (r : Γ(X, W)) :
    (X.presheaf.map (homOfLE (coverInter_anti (U := basicCover γ) (V := W) h)).op).hom
      (basicCoverRes γ s r) = basicCoverRes γ t r := by
  rw [basicCoverRes, basicCoverRes, ← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- **Čech exactness of a basic-open cover of an affine open.** -/
theorem basicCover_exactAt (hW : IsAffineOpen W) (hcov : W ≤ ⨆ i, basicCover γ i) (p : ℕ) :
    (sheafCech (schemeAbSheaf X) W (basicCover γ)).ExactAt p := by
  classical
  let D := sheafCech (schemeAbSheaf X) W (basicCover γ)
  letI alg : ∀ s : Finset (Fin n), Algebra Γ(X, W) Γ(X, coverInter W (basicCover γ) s) :=
    fun s => (basicCoverRes γ s).toAlgebra
  letI : ∀ s : Finset (Fin n), Module Γ(X, W) (D.obj s) := fun s => (alg s).toModule
  haveI hloc : ∀ s : Finset (Fin n),
      IsLocalization.Away (∏ i ∈ s, γ i) Γ(X, coverInter W (basicCover γ) s) := fun s =>
    hW.isLocalization_of_eq_basicOpen _ (homOfLE (coverInter_le W (basicCover γ) s))
      (coverInter_basicCover γ s)
  -- the restriction along an enlargement as an algebra map
  let φ : ∀ {s t : Finset (Fin n)} (h : s ⊆ t),
      Γ(X, coverInter W (basicCover γ) s) →ₐ[Γ(X, W)] Γ(X, coverInter W (basicCover γ) t) :=
    fun {s t} h =>
      { toRingHom := (X.presheaf.map (homOfLE (coverInter_anti (U := basicCover γ) h)).op).hom
        commutes' := fun r => basicCoverRes_comp γ h r }
  have hres : ∀ {s t : Finset (Fin n)} (h : s ⊆ t) (r : Γ(X, W)) (x : D.obj s),
      D.res h (r • x) = r • D.res h x := fun h r x => map_smul (φ h) r x
  have hspan : Ideal.span (Set.range γ) = ⊤ := by
    refine (hW.self_le_iSup_basicOpen_iff (s := Set.range γ)).mp ?_
    refine hcov.trans (iSup_le fun i => ?_)
    exact le_iSup (fun f : Set.range γ => X.basicOpen (f : Γ(X, W))) ⟨γ i, Set.mem_range_self i⟩
  have hdvd : ∀ (k : Fin n) (s : Finset (Fin n)), (∏ i ∈ insert k s, γ i) ∣ γ k * ∏ i ∈ s, γ i := by
    intro k s
    by_cases hk : k ∈ s
    · rw [Finset.insert_eq_of_mem hk]; exact dvd_mul_left _ _
    · rw [Finset.prod_insert hk]
  refine D.exactAt_of_localized hres γ hspan (fun k s y => ?_) (fun k s x hx => ?_) p
  · exact exists_map_eq_pow_smul (φ (Finset.subset_insert k s))
      (Finset.prod_dvd_prod_of_subset _ _ _ (Finset.subset_insert k s)) (hdvd k s) y
  · exact exists_pow_smul_eq_zero (φ (Finset.subset_insert k s)) (hdvd k s) x hx

end BasicCover

/-! ## Serre's vanishing theorem -/

section Serre

variable {X : Scheme.{u}} {V : X.Opens}

/-- The basic open subsets of an affine open. -/
def basicOpensOf (V : X.Opens) : Set X.Opens := {W | ∃ f : Γ(X, V), W = X.basicOpen f}

theorem cartanBasis_basicOpensOf (hV : IsAffineOpen V) : CartanBasis (basicOpensOf V) where
  inf_mem := by
    rintro _ _ ⟨f, rfl⟩ ⟨g, rfl⟩
    exact ⟨f * g, (Scheme.basicOpen_mul X f g).symm⟩
  isCompact := by
    rintro _ ⟨f, rfl⟩
    exact (hV.basicOpen f).isCompact
  basis := by
    rintro _ ⟨f, rfl⟩ O x hx hxO
    obtain ⟨g, hg, hxg⟩ := hV.exists_basicOpen_le (V := X.basicOpen f ⊓ O) ⟨x, hx, hxO⟩
      (X.basicOpen_le f hx)
    exact ⟨X.basicOpen g, ⟨g, rfl⟩, hxg, hg⟩

variable [HasExt.{w} (TopCat.Sheaf AddCommGrpCat.{u} X)]

omit [HasExt.{w} (TopCat.Sheaf AddCommGrpCat.{u} X)] in
theorem cartanExact_basicOpensOf (hV : IsAffineOpen V) :
    CartanExact (basicOpensOf V) (schemeAbSheaf X) := by
  rintro _ ⟨f, rfl⟩ n U hUB hUW hcov p
  choose g hg using hUB
  let γ : Fin n → Γ(X, X.basicOpen f) := fun i =>
    X.presheaf.map (homOfLE (X.basicOpen_le f)).op (g i)
  have hU : U = basicCover γ := by
    funext i
    rw [basicCover, Scheme.basicOpen_res, ← hg i]
    exact (inf_eq_right.mpr (hUW i)).symm
  subst hU
  exact basicCover_exactAt γ (hV.basicOpen f) hcov (p + 1)

/-- **Serre's vanishing theorem**: the structure sheaf has no higher cohomology on an affine
open set. -/
theorem affine_acyclicOn (hV : IsAffineOpen V) : DeningerAcyclicOn.{w} (schemeAbSheaf X) V :=
  fun q x => cartan_vanishing (cartanBasis_basicOpensOf hV) q _ (cartanExact_basicOpensOf hV) V
    ⟨1, (Scheme.basicOpen_one X).symm⟩ x

end Serre

end HTGeometry
