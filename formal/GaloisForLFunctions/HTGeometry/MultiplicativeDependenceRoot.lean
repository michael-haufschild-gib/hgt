import Mathlib.Analysis.SpecialFunctions.Log.Basic

/-!
# Multiplicative dependence of two positive reals

Two positive reals below one are either multiplicatively independent, or both are integer powers of
a single positive real: the relation lattice of `(a, b)` is the kernel of `(m, n) ↦ m log b -
n log a`, so it is generated by a primitive vector, and Bézout produces the common root
`β = aᵘ bᵛ`.
-/

namespace GaloisForLFunctions.HTGeometry

open Real

noncomputable section

/-- From a nontrivial multiplicative relation with positive exponents, Bézout produces a common
integer power root. -/
theorem exists_commonRoot_of_relation {a b : ℝ} (ha₀ : 0 < a) (hb₀ : 0 < b) {p q : ℕ}
    (hq : 0 < q) (hcop : Nat.Coprime p q) (hrel : b ^ p = a ^ q) :
    ∃ β : ℝ, 0 < β ∧ β ^ q = b ∧ β ^ p = a := by
  obtain ⟨u, v, huv⟩ : ∃ u v : ℤ, (p : ℤ) * u + (q : ℤ) * v = 1 := by
    refine ⟨Nat.gcdA p q, Nat.gcdB p q, ?_⟩
    have := Nat.gcd_eq_gcd_ab p q
    rw [hcop] at this
    push_cast at this ⊢
    linarith [this]
  refine ⟨a ^ u * b ^ v, mul_pos (zpow_pos ha₀ u) (zpow_pos hb₀ v), ?_, ?_⟩
  · have hb : b ^ (p : ℤ) = a ^ (q : ℤ) := by
      rw [zpow_natCast, zpow_natCast]
      exact hrel
    calc (a ^ u * b ^ v) ^ q = a ^ (u * (q : ℤ)) * b ^ (v * (q : ℤ)) := by
          rw [mul_pow, ← zpow_natCast (a ^ u) q, ← zpow_natCast (b ^ v) q, ← zpow_mul, ← zpow_mul]
      _ = b ^ ((p : ℤ) * u) * b ^ ((q : ℤ) * v) := by
          rw [show a ^ (u * (q : ℤ)) = (a ^ (q : ℤ)) ^ u from by rw [← zpow_mul, mul_comm],
            ← hb, ← zpow_mul, show (p : ℤ) * u = p * u from rfl, mul_comm ((p : ℤ)) u,
            show v * (q : ℤ) = (q : ℤ) * v from by ring]
      _ = b := by
          rw [← zpow_add₀ (ne_of_gt hb₀), huv, zpow_one]
  · have ha : a ^ (q : ℤ) = b ^ (p : ℤ) := by
      rw [zpow_natCast, zpow_natCast]
      exact hrel.symm
    calc (a ^ u * b ^ v) ^ p = a ^ (u * (p : ℤ)) * b ^ (v * (p : ℤ)) := by
          rw [mul_pow, ← zpow_natCast (a ^ u) p, ← zpow_natCast (b ^ v) p, ← zpow_mul, ← zpow_mul]
      _ = a ^ ((p : ℤ) * u) * a ^ ((q : ℤ) * v) := by
          rw [show b ^ (v * (p : ℤ)) = (b ^ (p : ℤ)) ^ v from by rw [← zpow_mul, mul_comm],
            ← ha, ← zpow_mul, mul_comm ((q : ℤ)) v, mul_comm u ((p : ℤ))]
      _ = a := by
          rw [← zpow_add₀ (ne_of_gt ha₀), huv, zpow_one]

/-- **Either multiplicatively independent, or a common integer power root.** -/
theorem multIndependent_or_commonRoot {a b : ℝ} (ha₀ : 0 < a) (ha₁ : a < 1) (hb₀ : 0 < b)
    (hb₁ : b < 1) :
    (∀ m n : ℤ, b ^ m = a ^ n → m = 0 ∧ n = 0) ∨
      ∃ (β : ℝ) (p q : ℕ), 0 < β ∧ 0 < q ∧ β ^ q = b ∧ β ^ p = a := by
  by_cases hind : ∀ m n : ℤ, b ^ m = a ^ n → m = 0 ∧ n = 0
  · exact Or.inl hind
  · refine Or.inr ?_
    push Not at hind
    obtain ⟨m, n, hmn, hne⟩ := hind
    have hloga : Real.log a < 0 := Real.log_neg ha₀ ha₁
    have hlogb : Real.log b < 0 := Real.log_neg hb₀ hb₁
    have hlog : (m : ℝ) * Real.log b = (n : ℝ) * Real.log a := by
      have := congrArg Real.log hmn
      rwa [Real.log_zpow, Real.log_zpow] at this
    -- both exponents are nonzero
    have hm0 : m ≠ 0 := by
      intro h
      subst h
      simp only [Int.cast_zero, zero_mul] at hlog
      have hn0 : (n : ℝ) = 0 := by
        rcases mul_eq_zero.mp hlog.symm with h | h
        · exact h
        · exact absurd h (ne_of_lt hloga)
      exact hne rfl (by exact_mod_cast hn0)
    have hn0 : n ≠ 0 := by
      intro h
      subst h
      simp only [Int.cast_zero, zero_mul] at hlog
      have hm : (m : ℝ) = 0 := by
        rcases mul_eq_zero.mp hlog with h | h
        · exact h
        · exact absurd h (ne_of_lt hlogb)
      exact hm0 (by exact_mod_cast hm)
    clear hne
    obtain ⟨M, N, hM, hN, hrel⟩ : ∃ M N : ℤ, 0 < M ∧ 0 < N ∧
        (M : ℝ) * Real.log b = (N : ℝ) * Real.log a := by
      rcases lt_or_gt_of_ne hn0 with hneg | hpos
      · refine ⟨-m, -n, ?_, by omega, by push_cast; linarith⟩
        have hNpos : (0 : ℝ) < (-n : ℤ) := by
          have : (n : ℝ) < 0 := by exact_mod_cast hneg
          push_cast
          linarith
        have hprod : ((-m : ℤ) : ℝ) * Real.log b = ((-n : ℤ) : ℝ) * Real.log a := by
          push_cast
          linarith
        have : (0 : ℝ) < ((-m : ℤ) : ℝ) := by
          nlinarith [mul_pos hNpos (neg_pos.mpr hloga)]
        exact_mod_cast this
      · refine ⟨m, n, ?_, hpos, hlog⟩
        have hNpos : (0 : ℝ) < (n : ℤ) := by exact_mod_cast hpos
        have : (0 : ℝ) < (m : ℝ) := by
          nlinarith [mul_pos hNpos (neg_pos.mpr hloga)]
        exact_mod_cast this
    have hMabs : (M.natAbs : ℤ) = M := Int.natAbs_of_nonneg (le_of_lt hM)
    have hNabs : (N.natAbs : ℤ) = N := Int.natAbs_of_nonneg (le_of_lt hN)
    have hMpos : 0 < M.natAbs := by omega
    have hNpos : 0 < N.natAbs := by omega
    have hd : 0 < Nat.gcd M.natAbs N.natAbs := Nat.gcd_pos_of_pos_left _ hMpos
    have hMd : (M.natAbs / Nat.gcd M.natAbs N.natAbs) * Nat.gcd M.natAbs N.natAbs = M.natAbs :=
      Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
    have hNd : (N.natAbs / Nat.gcd M.natAbs N.natAbs) * Nat.gcd M.natAbs N.natAbs = N.natAbs :=
      Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
    have hqpos : 0 < N.natAbs / Nat.gcd M.natAbs N.natAbs :=
      Nat.div_pos (Nat.le_of_dvd hNpos (Nat.gcd_dvd_right _ _)) hd
    have hcop : Nat.Coprime (M.natAbs / Nat.gcd M.natAbs N.natAbs)
        (N.natAbs / Nat.gcd M.natAbs N.natAbs) := Nat.coprime_div_gcd_div_gcd hd
    have hdR : ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) ≠ 0 := by
      exact_mod_cast hd.ne'
    have hrel' : ((M.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log b
        = ((N.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log a := by
      have hMR : ((M.natAbs : ℕ) : ℝ) = (M : ℝ) := by
        rw [show ((M.natAbs : ℕ) : ℝ) = (((M.natAbs : ℕ) : ℤ) : ℝ) from (Int.cast_natCast _).symm,
          hMabs]
      have hNR : ((N.natAbs : ℕ) : ℝ) = (N : ℝ) := by
        rw [show ((N.natAbs : ℕ) : ℝ) = (((N.natAbs : ℕ) : ℤ) : ℝ) from (Int.cast_natCast _).symm,
          hNabs]
      have hMsplit : ((M.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
          * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) = (M : ℝ) := by
        rw [← Nat.cast_mul, hMd, hMR]
      have hNsplit : ((N.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
          * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) = (N : ℝ) := by
        rw [← Nat.cast_mul, hNd, hNR]
      have hscaled : (((M.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log b)
          * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
          = (((N.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log a)
            * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) := by
        calc (((M.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log b)
              * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
            = (((M.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
                * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)) * Real.log b := by ring
          _ = (M : ℝ) * Real.log b := by rw [hMsplit]
          _ = (N : ℝ) * Real.log a := hrel
          _ = (((N.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)
                * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ)) * Real.log a := by rw [hNsplit]
          _ = (((N.natAbs / Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) * Real.log a)
                * ((Nat.gcd M.natAbs N.natAbs : ℕ) : ℝ) := by ring
      exact mul_right_cancel₀ hdR hscaled
    have hpow : b ^ (M.natAbs / Nat.gcd M.natAbs N.natAbs)
        = a ^ (N.natAbs / Nat.gcd M.natAbs N.natAbs) := by
      have h1 : Real.log (b ^ (M.natAbs / Nat.gcd M.natAbs N.natAbs))
          = Real.log (a ^ (N.natAbs / Nat.gcd M.natAbs N.natAbs)) := by
        rw [Real.log_pow, Real.log_pow]
        exact hrel'
      have h2 := congrArg Real.exp h1
      rwa [Real.exp_log (pow_pos hb₀ _), Real.exp_log (pow_pos ha₀ _)] at h2
    obtain ⟨β, hβ0, hβq, hβp⟩ := exists_commonRoot_of_relation ha₀ hb₀ hqpos hcop hpow
    exact ⟨β, M.natAbs / Nat.gcd M.natAbs N.natAbs, N.natAbs / Nat.gcd M.natAbs N.natAbs,
      hβ0, hqpos, hβq, hβp⟩

end

end GaloisForLFunctions.HTGeometry
