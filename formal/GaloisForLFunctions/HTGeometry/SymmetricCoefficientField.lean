import GaloisForLFunctions.HTGeometry.SymmetricRationalFunctions

/-!
# The symmetric part is the field generated by the elementary symmetric functions

A symmetric rational function is a ratio of symmetric polynomials, and by the fundamental theorem
of symmetric polynomials each of those is a polynomial in the elementary symmetric functions.  So
the symmetric part of the rational function field is exactly the subfield the elementary symmetric
functions generate over the constants.

This is the fundamental theorem of symmetric rational functions, and it identifies the base of the
generic polynomial with the field generated by its coefficients.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] {d : ℕ}

/-- The elementary symmetric functions, read as rational functions. -/
noncomputable def esymmGen (K : Type*) [Field K] (d : ℕ) (i : Fin d) :
    SymmetricRationalField K d :=
  algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
    (MvPolynomial.esymm (Fin d) K ((i : ℕ) + 1))

/-- The subfield the elementary symmetric functions generate over the constants. -/
noncomputable def esymmField (K : Type*) [Field K] (d : ℕ) :
    IntermediateField K (SymmetricRationalField K d) :=
  IntermediateField.adjoin K (Set.range (esymmGen K d))

/-- The symmetric part, read as an intermediate field over the constants. -/
noncomputable def symmetricPartField (K : Type*) [Field K] (d : ℕ) :
    IntermediateField K (SymmetricRationalField K d) where
  __ := symmetricPart K d
  algebraMap_mem' := by
    intro c
    have h1 : algebraMap K (SymmetricRationalField K d) c =
        algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
          (MvPolynomial.C c) := by
      rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin d) K)
        (SymmetricRationalField K d)]
      rfl
    have hfix : ∀ e : Equiv.Perm (Fin d),
        e • algebraMap K (SymmetricRationalField K d) c =
          algebraMap K (SymmetricRationalField K d) c := by
      intro e
      rw [h1, ← algebraMap_smul_mvPolynomial, perm_smul_mvPolynomial, rename_C]
    exact hfix

theorem mem_symmetricPartField_iff {z : SymmetricRationalField K d} :
    z ∈ symmetricPartField K d ↔ z ∈ symmetricPart K d := Iff.rfl

/-! ## The two descriptions agree -/

theorem esymmGen_mem_symmetricPartField (i : Fin d) :
    esymmGen K d i ∈ symmetricPartField K d := by
  have hfix : ∀ e : Equiv.Perm (Fin d), e • esymmGen K d i = esymmGen K d i := by
    intro e
    rw [esymmGen, ← algebraMap_smul_mvPolynomial]
    congr 1
    exact MvPolynomial.esymm_isSymmetric (Fin d) K ((i : ℕ) + 1) e
  exact hfix

theorem esymmField_le_symmetricPartField : esymmField K d ≤ symmetricPartField K d := by
  rw [esymmField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨i, rfl⟩
  exact esymmGen_mem_symmetricPartField i

/-- **A symmetric polynomial is a polynomial in the elementary symmetric functions.**  Read in the
rational function field, its image lies in the field they generate. -/
theorem algebraMap_mem_esymmField_of_isSymmetric {A : MvPolynomial (Fin d) K}
    (hA : A.IsSymmetric) :
    algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d) A ∈ esymmField K d := by
  obtain ⟨P, hP⟩ := MvPolynomial.esymmAlgHom_surjective (σ := Fin d) (R := K) (n := d)
    (by simp) ⟨A, (MvPolynomial.mem_symmetricSubalgebra A).2 hA⟩
  have hA' : A = MvPolynomial.aeval (fun i : Fin d => MvPolynomial.esymm (Fin d) K ((i : ℕ) + 1)) P := by
    rw [← MvPolynomial.esymmAlgHom_apply, hP]
  have hext : (IsScalarTower.toAlgHom K (MvPolynomial (Fin d) K)
        (SymmetricRationalField K d)).comp
        (MvPolynomial.aeval fun i : Fin d => MvPolynomial.esymm (Fin d) K ((i : ℕ) + 1)) =
      MvPolynomial.aeval (esymmGen K d) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    rw [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    rfl
  have hcomp : algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d) A =
      MvPolynomial.aeval (esymmGen K d) P := by
    rw [hA']
    exact congrArg (fun g => g P) hext
  rw [hcomp]
  have hmem : MvPolynomial.aeval (esymmGen K d) P ∈
      Algebra.adjoin K (Set.range (esymmGen K d)) := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨P, rfl⟩
  exact IntermediateField.algebra_adjoin_le_adjoin K (Set.range (esymmGen K d)) hmem

theorem symmetricPartField_le_esymmField : symmetricPartField K d ≤ esymmField K d := by
  intro z hz
  obtain ⟨A, B, hA, hB, _, rfl⟩ :=
    exists_isSymmetric_ratio_of_mem_symmetricPart (mem_symmetricPartField_iff.1 hz)
  exact div_mem (algebraMap_mem_esymmField_of_isSymmetric hA)
    (algebraMap_mem_esymmField_of_isSymmetric hB)

/-- **The fundamental theorem of symmetric rational functions.** -/
theorem symmetricPartField_eq_esymmField :
    symmetricPartField K d = esymmField K d :=
  le_antisymm symmetricPartField_le_esymmField esymmField_le_symmetricPartField

end GaloisForLFunctions.HTGeometry
