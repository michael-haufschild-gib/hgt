import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.InnerProductSpace.ProdL2

/-!
# Two-polarization tight formation and exact recovery

An orthogonal resolution of the identity on a Hilbert space `H` is a countable family of
self-adjoint idempotents `P_i` with `P_i P_j = 0` (`i ≠ j`) and `x = Σ_i P_i x`; it obeys Parseval,
`Σ_i ⟨P_i x, P_i y⟩ = ⟨x, y⟩`.  Conjugating by a unitary involution `J` gives the dual resolution
`Q_i = J P_i J`.

**Theorem 1.1.**  The two-polarization formation `B x = ((P_i x)_i, (Q_i x)_i)` into
`ℓ²(I; H) ⊕ ℓ²(I; H)` satisfies `⟨B x, B y⟩ = 2⟨x, y⟩` and `B*B = 2I`; `L = ½ B*` is a bounded left
inverse, `L((y_i), (z_i)) = ½ Σ_i (P_i y_i + Q_i z_i)`.  The formation Laplacian `Δ_R = R*R` of the
tight carrier is `Δ_B = 2I`.

**Theorem 2.1.**  The duality `W((y_i), (z_i)) = ((J z_i), (J y_i))` is a unitary involution with
`W B = B J` and `L W = J L`: the action transports formation and recovery and preserves the
Laplacian, frame bounds, kernel, Gram data and the recovered packet.  **Corollary 2.2.**  For any
bounded local packet `A`, `‖A x‖² + ‖B x‖² ≥ 2‖x‖²`.
-/

open Filter Topology
open scoped InnerProductSpace

noncomputable section

namespace GaloisForLFunctions.HTGeometry.TightFormation

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ι : Type*}

/-- A family of mutually orthogonal self-adjoint idempotents. -/
structure ProjectionFamily (ι H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  /-- the projections -/
  P : ι → H →L[ℂ] H
  symm : ∀ i x y, ⟪P i x, y⟫_ℂ = ⟪x, P i y⟫_ℂ
  idem : ∀ i x, P i (P i x) = P i x
  orth : ∀ i j, i ≠ j → ∀ x, P i (P j x) = 0

/-- An orthogonal resolution of the identity: self-adjoint idempotents, mutually orthogonal,
summing strongly to the identity. -/
structure OrthogonalResolution (ι H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    extends ProjectionFamily ι H where
  hasSum : ∀ x, HasSum (fun i => P i x) x

namespace ProjectionFamily

variable (R : ProjectionFamily ι H)

theorem inner_apply_apply (i : ι) (x y : H) : ⟪R.P i x, R.P i y⟫_ℂ = ⟪x, R.P i y⟫_ℂ := by
  rw [R.symm, R.idem]

theorem inner_apply_apply_of_ne {i j : ι} (hij : i ≠ j) (x y : H) :
    ⟪R.P i x, R.P j y⟫_ℂ = 0 := by
  rw [R.symm, R.orth i j hij, inner_zero_right]

/-- A finite sum of vectors from distinct ranges has squared norm the sum of the squared norms. -/
theorem norm_sq_finset_sum (t : Finset ι) (y : ι → H) :
    ‖∑ i ∈ t, R.P i (y i)‖ ^ 2 = ∑ i ∈ t, ‖R.P i (y i)‖ ^ 2 := by
  classical
  have h : ⟪∑ i ∈ t, R.P i (y i), ∑ i ∈ t, R.P i (y i)⟫_ℂ =
      ∑ i ∈ t, ((‖R.P i (y i)‖ ^ 2 : ℝ) : ℂ) := by
    rw [sum_inner]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [inner_sum, Finset.sum_eq_single i (fun j _ hji => R.inner_apply_apply_of_ne
      (Ne.symm hji) _ _) (fun hi' => absurd hi hi'), inner_self_eq_norm_sq_to_K]
    norm_cast
  rw [norm_sq_eq_re_inner (𝕜 := ℂ), h]
  simp only [map_sum, RCLike.re_to_complex, Complex.ofReal_re]

/-- Bessel defect of a finite partial sum: `‖x - Σ_{i ∈ t} P_i x‖² = ‖x‖² - Σ_{i ∈ t} ‖P_i x‖²`. -/
theorem norm_sq_sub_finset_sum (t : Finset ι) (x : H) :
    ‖x - ∑ i ∈ t, R.P i x‖ ^ 2 = ‖x‖ ^ 2 - ∑ i ∈ t, ‖R.P i x‖ ^ 2 := by
  have hre : RCLike.re ⟪x, ∑ i ∈ t, R.P i x⟫_ℂ = ∑ i ∈ t, ‖R.P i x‖ ^ 2 := by
    rw [inner_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← R.inner_apply_apply, ← norm_sq_eq_re_inner (𝕜 := ℂ)]
  rw [@norm_sub_sq ℂ, hre, R.norm_sq_finset_sum t fun _ => x]
  ring

/-- **Exhaustion criterion.**  If finite partial sums approximate `x` arbitrarily well, the
orthogonal series `Σ_i P_i x` converges unconditionally to `x`: the error is antitone in the index
set by the Bessel-defect identity. -/
theorem hasSum_of_approx (x : H) (happrox : ∀ ε > 0, ∃ t : Finset ι, ‖x - ∑ i ∈ t, R.P i x‖ < ε) :
    HasSum (fun i => R.P i x) x := by
  rw [HasSum, SummationFilter.unconditional_filter, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨t₀, ht₀⟩ := happrox ε hε
  filter_upwards [eventually_ge_atTop t₀] with t ht
  rw [dist_comm, dist_eq_norm]
  have hle : ‖x - ∑ i ∈ t, R.P i x‖ ^ 2 ≤ ‖x - ∑ i ∈ t₀, R.P i x‖ ^ 2 := by
    rw [R.norm_sq_sub_finset_sum, R.norm_sq_sub_finset_sum]
    exact sub_le_sub_left (Finset.sum_le_sum_of_subset_of_nonneg ht fun i _ _ => by positivity) _
  exact ((pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 hle).trans_lt ht₀

/-- The resolution generated by an exhausting projection family. -/
def toResolution (happrox : ∀ x : H, ∀ ε > 0, ∃ t : Finset ι, ‖x - ∑ i ∈ t, R.P i x‖ < ε) :
    OrthogonalResolution ι H where
  toProjectionFamily := R
  hasSum x := R.hasSum_of_approx x (happrox x)

end ProjectionFamily

namespace OrthogonalResolution

variable (R : OrthogonalResolution ι H)

/-- **Parseval** for the resolution: `Σ_i ⟨P_i x, P_i y⟩ = ⟨x, y⟩`. -/
theorem hasSum_inner (x y : H) : HasSum (fun i => ⟪R.P i x, R.P i y⟫_ℂ) ⟪x, y⟫_ℂ := by
  have h := (R.hasSum y).mapL (innerSL ℂ x)
  simp only [innerSL_apply_apply] at h
  exact h.congr_fun fun i => R.inner_apply_apply i x y

/-- **`(1.1)`**: `Σ_i ‖P_i x‖² = ‖x‖²`. -/
theorem hasSum_norm_sq (x : H) : HasSum (fun i => ‖R.P i x‖ ^ 2) (‖x‖ ^ 2) := by
  have h := (R.hasSum_inner x x).mapL Complex.reCLM
  simp only [Complex.reCLM_apply] at h
  convert h using 1
  · funext i
    exact norm_sq_eq_re_inner (𝕜 := ℂ) _
  · exact norm_sq_eq_re_inner (𝕜 := ℂ) _

theorem summable_norm_sq (x : H) : Summable fun i => ‖R.P i x‖ ^ 2 := (R.hasSum_norm_sq x).summable

theorem norm_apply_le (i : ι) (x : H) : ‖R.P i x‖ ≤ ‖x‖ := by
  have h := (R.summable_norm_sq x).le_tsum i fun j _ => by positivity
  rw [(R.hasSum_norm_sq x).tsum_eq] at h
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h

/-- **Synthesis converges**: for `(y_i) ∈ ℓ²(I; H)` the orthogonal series `Σ_i P_i y_i` converges,
with `‖Σ_i P_i y_i‖² = Σ_i ‖P_i y_i‖² ≤ Σ_i ‖y_i‖²`. -/
theorem summable_apply_lp [CompleteSpace H] (y : lp (fun _ : ι => H) 2) :
    Summable fun i => R.P i (y i) := by
  have hy : Summable fun i => ‖(y : ι → H) i‖ ^ 2 := by
    have := (memℓp_gen_iff (p := 2) (by norm_num)).1 (lp.memℓp y)
    simpa using this
  refine summable_iff_vanishing_norm.2 fun ε hε => ?_
  obtain ⟨s, hs⟩ := summable_iff_vanishing_norm.1 hy (ε ^ 2) (by positivity)
  refine ⟨s, fun t hts => ?_⟩
  have h1 := hs t hts
  have h2 : ‖∑ i ∈ t, R.P i (y i)‖ ^ 2 ≤ ∑ i ∈ t, ‖(y : ι → H) i‖ ^ 2 := by
    rw [R.norm_sq_finset_sum]
    exact Finset.sum_le_sum fun i _ =>
      pow_le_pow_left₀ (norm_nonneg _) (R.norm_apply_le i _) 2
  rw [Real.norm_of_nonneg (Finset.sum_nonneg fun i _ => by positivity)] at h1
  exact (pow_lt_pow_iff_left₀ (norm_nonneg _) hε.le two_ne_zero).1 (h2.trans_lt h1)

/-- The analysis map `x ↦ (P_i x)_i`, an isometry `H → ℓ²(I; H)`. -/
def analysis : H →ₗᵢ[ℂ] lp (fun _ : ι => H) 2 where
  toFun x := ⟨fun i => R.P i x, (memℓp_gen_iff (by norm_num)).2 (by
    simpa using R.summable_norm_sq x)⟩
  map_add' x y := lp.ext (funext fun i => map_add _ _ _)
  map_smul' c x := lp.ext (funext fun i => map_smul _ _ _)
  norm_map' x := by
    have h : ‖(⟨fun i => R.P i x, (memℓp_gen_iff (by norm_num)).2 (by
        simpa using R.summable_norm_sq x)⟩ : lp (fun _ : ι => H) 2)‖ ^ 2 = ‖x‖ ^ 2 := by
      rw [norm_sq_eq_re_inner (𝕜 := ℂ), lp.inner_eq_tsum, norm_sq_eq_re_inner (𝕜 := ℂ),
        (R.hasSum_inner x x).tsum_eq]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h

@[simp] theorem analysis_apply (x : H) (i : ι) : (R.analysis x : ι → H) i = R.P i x := rfl

/-- `Σ_i ⟨P_i x, y_i⟩ = ⟨x, Σ_i P_i y_i⟩`: the adjoint of the analysis map is synthesis. -/
theorem inner_analysis [CompleteSpace H] (x : H) (y : lp (fun _ : ι => H) 2) :
    ⟪R.analysis x, y⟫_ℂ = ⟪x, ∑' i, R.P i (y i)⟫_ℂ := by
  have h := (R.summable_apply_lp y).hasSum.mapL (innerSL ℂ x)
  simp only [innerSL_apply_apply] at h
  rw [lp.inner_eq_tsum, ← h.tsum_eq]
  refine tsum_congr fun i => ?_
  rw [analysis_apply, R.symm]

/-- Conjugation of a resolution by a unitary involution `J`: `Q_i = J P_i J`. -/
def conj (J : H ≃ₗᵢ[ℂ] H) (hJ : ∀ x, J (J x) = x) : OrthogonalResolution ι H where
  P i := J.toContinuousLinearEquiv.toContinuousLinearMap ∘L R.P i ∘L
    J.toContinuousLinearEquiv.toContinuousLinearMap
  symm i x y := by
    have hJs : ∀ a b : H, ⟪J a, b⟫_ℂ = ⟪a, J b⟫_ℂ := fun a b => by
      conv_lhs => rw [← hJ b]
      exact J.inner_map_map a (J b)
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
      ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
    rw [hJs, R.symm, hJs]
  idem i x := by
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
      ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
    rw [hJ, R.idem]
  orth i j hij x := by
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply,
      ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
    rw [hJ, R.orth i j hij, map_zero]
  hasSum x := by
    have h := (R.hasSum (J x)).mapL J.toContinuousLinearEquiv.toContinuousLinearMap
    simp only [ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_toContinuousLinearEquiv,
      hJ] at h
    exact h

theorem conj_apply (J : H ≃ₗᵢ[ℂ] H) (hJ : ∀ x, J (J x) = x) (i : ι) (x : H) :
    (R.conj J hJ).P i x = J (R.P i (J x)) := rfl

end OrthogonalResolution

/-! ### Theorem 1.1: the tight two-polarization formation -/

section Formation

variable (R : OrthogonalResolution ι H) (J : H ≃ₗᵢ[ℂ] H) (hJ : ∀ x, J (J x) = x)

/-- The formation space `𝒦 = ℓ²(I; H) ⊕ ℓ²(I; H)`. -/
abbrev FormationSpace (ι H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  WithLp 2 (lp (fun _ : ι => H) 2 × lp (fun _ : ι => H) 2)

/-- The pair `((P_i x)_i, (Q_i x)_i)`, before taking the `ℓ²` direct-sum norm. -/
def formationLin : H →ₗ[ℂ] FormationSpace ι H where
  toFun x := WithLp.toLp 2 (R.analysis x, (R.conj J hJ).analysis x)
  map_add' x y := by
    rw [map_add, map_add]
    rfl
  map_smul' c x := by
    rw [map_smul, map_smul]
    rfl

theorem norm_sq_formationLin (x : H) : ‖formationLin R J hJ x‖ ^ 2 = 2 * ‖x‖ ^ 2 := by
  rw [WithLp.prod_norm_sq_eq_of_L2]
  change ‖R.analysis x‖ ^ 2 + ‖(R.conj J hJ).analysis x‖ ^ 2 = _
  rw [LinearIsometry.norm_map, LinearIsometry.norm_map]
  ring

/-- **`(1.3)`**: the two-polarization formation `B x = ((P_i x)_i, (Q_i x)_i)`. -/
def formation : H →L[ℂ] FormationSpace ι H :=
  (formationLin R J hJ).mkContinuous (Real.sqrt 2) fun x => by
    have h := norm_sq_formationLin R J hJ x
    have h2 : ‖formationLin R J hJ x‖ = Real.sqrt 2 * ‖x‖ := by
      rw [← Real.sqrt_sq (norm_nonneg (formationLin R J hJ x)), h, Real.sqrt_mul (by norm_num),
        Real.sqrt_sq (norm_nonneg x)]
    exact h2.le

theorem formation_apply (x : H) :
    formation R J hJ x = WithLp.toLp 2 (R.analysis x, (R.conj J hJ).analysis x) := rfl

/-- **Theorem 1.1, `(1.4)`**: `⟨B x, B y⟩ = 2 ⟨x, y⟩`. -/
theorem inner_formation (x y : H) :
    ⟪formation R J hJ x, formation R J hJ y⟫_ℂ = 2 * ⟪x, y⟫_ℂ := by
  rw [formation_apply, formation_apply, WithLp.prod_inner_apply]
  change ⟪R.analysis x, R.analysis y⟫_ℂ + ⟪(R.conj J hJ).analysis x, (R.conj J hJ).analysis y⟫_ℂ = _
  rw [LinearIsometry.inner_map_map, LinearIsometry.inner_map_map]
  ring

/-- **`(1.4)`**: `‖B x‖² = 2 ‖x‖²`. -/
theorem norm_sq_formation (x : H) : ‖formation R J hJ x‖ ^ 2 = 2 * ‖x‖ ^ 2 :=
  norm_sq_formationLin R J hJ x

/-- `B` is bounded below: `‖B x‖ = √2 ‖x‖`; its kernel is zero and its range closed. -/
theorem norm_formation (x : H) : ‖formation R J hJ x‖ = Real.sqrt 2 * ‖x‖ := by
  rw [← Real.sqrt_sq (norm_nonneg (formation R J hJ x)), norm_sq_formation,
    Real.sqrt_mul (by norm_num), Real.sqrt_sq (norm_nonneg x)]

theorem isClosed_range_formation [CompleteSpace H] : IsClosed (Set.range (formation R J hJ)) := by
  have hiso : Isometry fun x => (Real.sqrt 2)⁻¹ • formation R J hJ x := by
    refine AddMonoidHomClass.isometry_of_norm
      ((Real.sqrt 2)⁻¹ • (formation R J hJ : H →+ FormationSpace ι H)) fun x => ?_
    simp only [AddMonoidHom.coe_smul, Pi.smul_apply, norm_smul, norm_inv,
      Real.norm_of_nonneg (Real.sqrt_nonneg 2)]
    rw [show ((formation R J hJ : H →+ FormationSpace ι H) x) = formation R J hJ x from rfl,
      norm_formation]
    field_simp
  have h := hiso.isClosedEmbedding.isClosed_range
  have heq : Set.range (formation R J hJ) =
      (fun v => Real.sqrt 2 • v) '' Set.range fun x => (Real.sqrt 2)⁻¹ • formation R J hJ x := by
    ext v
    simp only [Set.mem_range, Set.mem_image]
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨_, ⟨x, rfl⟩, by rw [smul_smul, mul_inv_cancel₀ (by positivity), one_smul]⟩
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, by rw [smul_smul, mul_inv_cancel₀ (by positivity), one_smul]⟩
  rw [heq]
  exact (Homeomorph.smulOfNeZero (Real.sqrt 2) (by positivity)).isClosedMap _ h

/-! ### Theorem 2.1: the duality lift -/

/-- `‖f‖² = Σ_i ‖f_i‖²` on a Hilbert direct sum. -/
theorem norm_sq_lp {G : ι → Type*} [∀ i, NormedAddCommGroup (G i)] [∀ i, InnerProductSpace ℂ (G i)]
    (f : lp G 2) : ‖f‖ ^ 2 = ∑' i, ‖(f : ∀ i, G i) i‖ ^ 2 := by
  have h := (lp.summable_inner (𝕜 := ℂ) f f).hasSum.mapL Complex.reCLM
  simp only [Complex.reCLM_apply] at h
  rw [norm_sq_eq_re_inner (𝕜 := ℂ), lp.inner_eq_tsum, RCLike.re_to_complex, ← h.tsum_eq]
  exact tsum_congr fun i => (norm_sq_eq_re_inner (𝕜 := ℂ) _).symm

/-- Pointwise application of `J` on `ℓ²(I; H)`. -/
def lpMap (J : H ≃ₗᵢ[ℂ] H) : lp (fun _ : ι => H) 2 →ₗᵢ[ℂ] lp (fun _ : ι => H) 2 where
  toFun y := ⟨fun i => J ((y : ι → H) i), (memℓp_gen_iff (by norm_num)).2 (by
    simpa using (memℓp_gen_iff (p := 2) (by norm_num)).1 (lp.memℓp y))⟩
  map_add' y y' := lp.ext (funext fun i => map_add J _ _)
  map_smul' c y := lp.ext (funext fun i => map_smul J _ _)
  norm_map' y := by
    have h : ‖(⟨fun i => J ((y : ι → H) i), (memℓp_gen_iff (by norm_num)).2 (by
        simpa using (memℓp_gen_iff (p := 2) (by norm_num)).1 (lp.memℓp y))⟩ :
          lp (fun _ : ι => H) 2)‖ ^ 2 = ‖y‖ ^ 2 := by
      rw [norm_sq_lp, norm_sq_lp]
      exact tsum_congr fun i => by rw [LinearIsometryEquiv.norm_map]
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h

@[simp] theorem lpMap_apply (y : lp (fun _ : ι => H) 2) (i : ι) :
    (lpMap J y : ι → H) i = J ((y : ι → H) i) := rfl

/-- The swap-and-dualize map `W((y_i), (z_i)) = ((J z_i), (J y_i))`. -/
def dualityLin : FormationSpace ι H →ₗ[ℂ] FormationSpace ι H where
  toFun v := WithLp.toLp 2 (lpMap J (WithLp.ofLp v).2, lpMap J (WithLp.ofLp v).1)
  map_add' v w := by
    simp only [WithLp.ofLp_add, Prod.fst_add, Prod.snd_add, map_add]
    rfl
  map_smul' c v := by
    simp only [WithLp.ofLp_smul, Prod.smul_fst, Prod.smul_snd, map_smul, RingHom.id_apply]
    rfl

theorem norm_dualityLin (v : FormationSpace ι H) : ‖dualityLin J v‖ = ‖v‖ := by
  have h : ‖dualityLin J v‖ ^ 2 = ‖v‖ ^ 2 := by
    rw [WithLp.prod_norm_sq_eq_of_L2, WithLp.prod_norm_sq_eq_of_L2]
    change ‖lpMap J (WithLp.ofLp v).2‖ ^ 2 + ‖lpMap J (WithLp.ofLp v).1‖ ^ 2 = _
    rw [LinearIsometry.norm_map, LinearIsometry.norm_map, add_comm]
    rfl
  exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h

include hJ in
theorem dualityLin_dualityLin (v : FormationSpace ι H) : dualityLin J (dualityLin J v) = v := by
  apply (WithLp.equiv 2 _).injective
  refine Prod.ext (lp.ext (funext fun i => ?_)) (lp.ext (funext fun i => ?_))
  · exact hJ _
  · exact hJ _

/-- **Theorem 2.1**: the duality lift `W`, a unitary involution of `𝒦`. -/
def duality : FormationSpace ι H ≃ₗᵢ[ℂ] FormationSpace ι H where
  toLinearEquiv :=
    { dualityLin J with
      invFun := dualityLin J
      left_inv := dualityLin_dualityLin J hJ
      right_inv := dualityLin_dualityLin J hJ }
  norm_map' := norm_dualityLin J

theorem duality_apply (v : FormationSpace ι H) : duality J hJ v = dualityLin J v := rfl

theorem duality_involutive (v : FormationSpace ι H) : duality J hJ (duality J hJ v) = v :=
  dualityLin_dualityLin J hJ v

include hJ in
theorem J_inner (a b : H) : ⟪J a, b⟫_ℂ = ⟪a, J b⟫_ℂ := by
  conv_lhs => rw [← hJ b]
  exact J.inner_map_map a (J b)

/-- **Theorem 2.1, `(2.2)`**: `W B = B J`. -/
theorem duality_formation (x : H) :
    duality J hJ (formation R J hJ x) = formation R J hJ (J x) := by
  apply (WithLp.equiv 2 _).injective
  refine Prod.ext (lp.ext (funext fun i => ?_)) (lp.ext (funext fun i => ?_))
  · change J ((R.conj J hJ).P i x) = R.P i (J x)
    rw [OrthogonalResolution.conj_apply, hJ]
  · change J (R.P i x) = (R.conj J hJ).P i (J x)
    rw [OrthogonalResolution.conj_apply, hJ]

/-! ### Corollary 2.2: compact local packets do not alter global coverage -/

/-- **Corollary 2.2, `(2.3)`**: for any bounded local packet `A`, `‖A x‖² + ‖B x‖² ≥ 2 ‖x‖²`. -/
theorem norm_sq_packet_ge {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (A : H →L[ℂ] Y) (x : H) :
    2 * ‖x‖ ^ 2 ≤ ‖WithLp.toLp 2 (A x, formation R J hJ x)‖ ^ 2 := by
  rw [WithLp.prod_norm_sq_eq_of_L2]
  change 2 * ‖x‖ ^ 2 ≤ ‖A x‖ ^ 2 + ‖formation R J hJ x‖ ^ 2
  rw [norm_sq_formation]
  nlinarith [norm_nonneg (A x)]

/-! ### Recovery: the decoder `L = ½ B*` and its covariance -/

section Recovery

variable [CompleteSpace H]

/-- **`(1.4)`, `(1.8)`**: `B*B = 2I`; the formation Laplacian of the tight carrier is `2I`. -/
theorem adjoint_formation_comp :
    ContinuousLinearMap.adjoint (formation R J hJ) ∘L formation R J hJ = (2 : ℂ) • 1 := by
  refine ContinuousLinearMap.ext fun x => ext_inner_right ℂ fun v => ?_
  rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_left, inner_formation,
    smul_apply, one_apply_eq_self, inner_smul_left, show (starRingEnd ℂ) (2 : ℂ) = 2 from
      map_ofNat _ 2]

/-- The formation Laplacian `Δ_R = R*R` of a formed channel. -/
def formationLaplacian {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y] [CompleteSpace Y]
    (T : H →L[ℂ] Y) : H →L[ℂ] H :=
  ContinuousLinearMap.adjoint T ∘L T

/-- **`(1.8)`**: `Δ_B = 2I`. -/
theorem formationLaplacian_formation :
    formationLaplacian (formation R J hJ) = (2 : ℂ) • 1 := adjoint_formation_comp R J hJ

/-- The decoder `L = ½ B*`. -/
def decoder : FormationSpace ι H →L[ℂ] H :=
  (2 : ℂ)⁻¹ • ContinuousLinearMap.adjoint (formation R J hJ)

/-- **`(1.5)`**: `L B = I`. -/
theorem decoder_formation (x : H) : decoder R J hJ (formation R J hJ x) = x := by
  have h := congrArg (fun T : H →L[ℂ] H => T x) (adjoint_formation_comp R J hJ)
  simp only [ContinuousLinearMap.comp_apply, smul_apply,
    one_apply_eq_self] at h
  rw [decoder, smul_apply, h, smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]

theorem formation_injective : Function.Injective (formation R J hJ) := fun x y h => by
  have := congrArg (decoder R J hJ) h
  rwa [decoder_formation, decoder_formation] at this

/-- **`(1.6)`, the synthesis formula**: `L((y_i), (z_i)) = ½ Σ_i (P_i y_i + Q_i z_i)`. -/
theorem decoder_apply (y z : lp (fun _ : ι => H) 2) :
    decoder R J hJ (WithLp.toLp 2 (y, z)) =
      (2 : ℂ)⁻¹ • ((∑' i, R.P i (y i)) + ∑' i, (R.conj J hJ).P i (z i)) := by
  rw [decoder, smul_apply]
  congr 1
  refine ext_inner_left ℂ fun x => ?_
  rw [ContinuousLinearMap.adjoint_inner_right, formation_apply, WithLp.prod_inner_apply]
  change ⟪R.analysis x, y⟫_ℂ + ⟪(R.conj J hJ).analysis x, z⟫_ℂ = _
  rw [R.inner_analysis, (R.conj J hJ).inner_analysis, inner_add_right]

/-- `B* W = J B*`. -/
theorem adjoint_formation_duality (v : FormationSpace ι H) :
    ContinuousLinearMap.adjoint (formation R J hJ) (duality J hJ v) =
      J (ContinuousLinearMap.adjoint (formation R J hJ) v) := by
  refine ext_inner_left ℂ fun x => ?_
  rw [ContinuousLinearMap.adjoint_inner_right, ← J_inner J hJ,
    ContinuousLinearMap.adjoint_inner_right, ← duality_formation R J hJ,
    ← LinearIsometryEquiv.inner_map_map (duality J hJ) (formation R J hJ x), duality_involutive]

/-- **Theorem 2.1, `(2.2)`**: decoder covariance `L W = J L`. -/
theorem decoder_duality (v : FormationSpace ι H) :
    decoder R J hJ (duality J hJ v) = J (decoder R J hJ v) := by
  rw [decoder, smul_apply, smul_apply, adjoint_formation_duality, map_smul]

/-- **Theorem 2.1, preserved data**: the duality preserves the formation Laplacian, the frame
bounds, the kernel, all Gram data, and the recovered packet. -/
theorem duality_invariants (x y : H) :
    ⟪formation R J hJ (J x), formation R J hJ (J y)⟫_ℂ = 2 * ⟪x, y⟫_ℂ ∧
      ‖duality J hJ (formation R J hJ x)‖ ^ 2 = 2 * ‖x‖ ^ 2 ∧
      (formation R J hJ (J x) = 0 ↔ x = 0) ∧
      ⟪duality J hJ (formation R J hJ x), duality J hJ (formation R J hJ y)⟫_ℂ =
        ⟪formation R J hJ x, formation R J hJ y⟫_ℂ ∧
      decoder R J hJ (duality J hJ (formation R J hJ x)) = J x := by
  refine ⟨by rw [inner_formation, LinearIsometryEquiv.inner_map_map], by
    rw [LinearIsometryEquiv.norm_map, norm_sq_formation], ⟨fun h => ?_, fun h => by
      rw [h, map_zero, map_zero]⟩, LinearIsometryEquiv.inner_map_map _ _ _, by
    rw [decoder_duality, decoder_formation]⟩
  have := congrArg (decoder R J hJ) h
  rw [decoder_formation, map_zero] at this
  rw [← hJ x, this, map_zero]

/-- **Corollary 2.2, transport**: replacing `(A, B)` by `(V A U*, W B U*)` keeps the lower bound and
conjugates the decoder: `x = U L W* (W B U* x)`. -/
theorem transport_packet {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (A : H →L[ℂ] Y) (U : H ≃ₗᵢ[ℂ] H) (V : Y ≃ₗᵢ[ℂ] Y) (x : H) :
    2 * ‖x‖ ^ 2 ≤
        ‖WithLp.toLp 2 (V (A (U.symm x)), duality J hJ (formation R J hJ (U.symm x)))‖ ^ 2 ∧
      U (decoder R J hJ ((duality J hJ).symm (duality J hJ
        (formation R J hJ (U.symm x))))) = x := by
  refine ⟨?_, by rw [LinearIsometryEquiv.symm_apply_apply, decoder_formation,
    LinearIsometryEquiv.apply_symm_apply]⟩
  rw [WithLp.prod_norm_sq_eq_of_L2]
  change 2 * ‖x‖ ^ 2 ≤ ‖V (A (U.symm x))‖ ^ 2 + ‖duality J hJ (formation R J hJ (U.symm x))‖ ^ 2
  rw [LinearIsometryEquiv.norm_map, LinearIsometryEquiv.norm_map, norm_sq_formation,
    LinearIsometryEquiv.norm_map]
  nlinarith [norm_nonneg (A (U.symm x))]

