import GaloisForLFunctions.HTGeometry.Critical.Observation.Field
import GaloisForLFunctions.HTGeometry.GenericRecipMemAdjoin

/-!
# The new reciprocal coordinate needs only the raw coordinates it sees

The inverse recursion expresses the `k`-th reciprocal coefficient through the raw coefficients of
index at most `k` and the inverse of the constant term.  The existing statement of that fact adjoins
*all* raw coefficients; the degree-bounded form is what the critical tower needs, because the source
field deliberately omits the last raw coordinate.

Consequently the postcritical reciprocal coordinate lies in the source field extended by the single
new raw coordinate — the base change along the free parameter, and no more.
-/

namespace GaloisForLFunctions.HTGeometry

variable (K : Type*) [Field K] (N : ℕ)

/-- The algebra generated by the raw coefficients up to a given index together with the inverse of
the constant term. -/
noncomputable def genericRawAlgebraUpTo (k : ℕ) : Subalgebra K (genericJetAlgebra K N) :=
  Algebra.adjoin K ((genericRaw K N '' {j : ℕ | j ≤ k}) ∪ {genericInv K N})

theorem genericRawAlgebraUpTo_mono {k k' : ℕ} (h : k ≤ k') :
    genericRawAlgebraUpTo K N k ≤ genericRawAlgebraUpTo K N k' := by
  refine Algebra.adjoin_mono ?_
  refine Set.union_subset_union_left _ ?_
  rintro x ⟨j, hj, rfl⟩
  exact ⟨j, le_trans hj h, rfl⟩

theorem genericRaw_mem_genericRawAlgebraUpTo {j k : ℕ} (h : j ≤ k) :
    genericRaw K N j ∈ genericRawAlgebraUpTo K N k :=
  Algebra.subset_adjoin (Or.inl ⟨j, h, rfl⟩)

theorem genericInv_mem_genericRawAlgebraUpTo (k : ℕ) :
    genericInv K N ∈ genericRawAlgebraUpTo K N k :=
  Algebra.subset_adjoin (Or.inr rfl)

/-- **Degree-bounded inverse recursion.**  The `k`-th reciprocal coefficient lies in the algebra of
the raw coefficients of index at most `k`. -/
theorem genericRecip_mem_genericRawAlgebraUpTo : ∀ k : ℕ,
    genericRecip K N k ∈ genericRawAlgebraUpTo K N k := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 =>
        rw [genericRecip]
        exact genericInv_mem_genericRawAlgebraUpTo K N 0
    | (j + 1) =>
        rw [genericRecip]
        refine Subalgebra.mul_mem _
          (Subalgebra.neg_mem _ (genericInv_mem_genericRawAlgebraUpTo K N (j + 1)))
          (Subalgebra.sum_mem _ fun i hi => ?_)
        have hi' : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        refine Subalgebra.mul_mem _
          (genericRaw_mem_genericRawAlgebraUpTo K N (by omega : i + 1 ≤ j + 1)) ?_
        exact genericRawAlgebraUpTo_mono K N (by omega : j - i ≤ j + 1) (ih (j - i) (by omega))

variable {K N}

/-- The critical source field extended by the one new raw coordinate. -/
noncomputable def criticalSourceFieldSup (K : Type*) [Field K] (m n : ℕ) :
    IntermediateField K (genericJetField K (m + n)) :=
  criticalSourceField K m n ⊔ IntermediateField.adjoin K {postcriticalRawFieldElement K m n}

/-- Every raw coordinate through the postcritical index lies in the extended source field. -/
theorem criticalAmbientRaw_mem_criticalSourceFieldSup (K : Type*) [Field K] (m n : ℕ)
    {j : ℕ} (hj : j ≤ m + n) :
    criticalAmbientRaw K m n j ∈ criticalSourceFieldSup K m n := by
  rcases lt_or_eq_of_le hj with hlt | heq
  · refine le_sup_left (α := IntermediateField K (genericJetField K (m + n))) ?_
    exact IntermediateField.subset_adjoin _ _ ⟨⟨j, hlt⟩, rfl⟩
  · refine le_sup_right (α := IntermediateField K (genericJetField K (m + n))) ?_
    have hval : criticalAmbientRaw K m n j = postcriticalRawFieldElement K m n := by
      rw [postcriticalRawFieldElement, heq]
    rw [hval]
    exact IntermediateField.subset_adjoin _ _ rfl

/-- The image of the constant-term inverse is the inverse of the zeroth raw coordinate. -/
theorem genericJetFieldMap_genericInv (K : Type*) [Field K] (m n : ℕ) :
    genericJetFieldMap K (m + n) (genericInv K (m + n))
      = (criticalAmbientRaw K m n 0)⁻¹ := by
  have h := congrArg (genericJetFieldMap K (m + n)) (genericRaw_zero_mul_inv (K := K) (N := m + n))
  rw [map_mul, map_one] at h
  have hne : criticalAmbientRaw K m n 0 ≠ 0 := by
    intro h0
    rw [show criticalAmbientRaw K m n 0
        = genericJetFieldMap K (m + n) (genericRaw K (m + n) 0) from rfl] at h0
    rw [h0, zero_mul] at h
    exact zero_ne_one h
  field_simp [← h]
  rw [show criticalAmbientRaw K m n 0
      = genericJetFieldMap K (m + n) (genericRaw K (m + n) 0) from rfl]
  linear_combination h

/-- **The postcritical reciprocal coordinate lies in the source field extended by the new raw
coordinate.** -/
theorem postcriticalReciprocalFieldElement_mem_criticalSourceFieldSup
    (K : Type*) [Field K] (m n : ℕ) :
    postcriticalReciprocalFieldElement K m n ∈ criticalSourceFieldSup K m n := by
  have hmem := genericRecip_mem_genericRawAlgebraUpTo K (m + n) (m + n)
  set S : Subalgebra K (genericJetAlgebra K (m + n)) :=
    (criticalSourceFieldSup K m n).toSubalgebra.comap (genericJetFieldMap K (m + n)) with hS
  have hle : genericRawAlgebraUpTo K (m + n) (m + n) ≤ S := by
    refine Algebra.adjoin_le ?_
    rintro x (⟨j, hj, rfl⟩ | rfl)
    · exact criticalAmbientRaw_mem_criticalSourceFieldSup K m n hj
    · rw [hS]
      show genericJetFieldMap K (m + n) (genericInv K (m + n))
        ∈ (criticalSourceFieldSup K m n).toSubalgebra
      rw [genericJetFieldMap_genericInv K m n]
      exact (criticalSourceFieldSup K m n).inv_mem
        (criticalAmbientRaw_mem_criticalSourceFieldSup K m n (Nat.zero_le _))
  exact hle hmem

end GaloisForLFunctions.HTGeometry
