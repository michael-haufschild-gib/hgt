import GaloisForLFunctions.HTGeometry.GenericMatrixFixedField
import GaloisForLFunctions.HTGeometry.PrimeValuationProfileFieldClassification

/-!
# The curvature field is exactly the invariant field of the generic torsor

The system matrix `A = Y⁻¹ δY` of the generic matrix generates a differential subfield of the free
differential rational field, and the slice recursion `B_{m+1} = δB_m + A·B_m` puts every slice
coordinate inside it.  Combined with the slice specialisation of
`GenericMatrixFixedField.lean`, this identifies the fixed field of the whole constant gauge group
with the differential field generated by the curvature:

`{u | ∀ Z ∈ GL_N(K), σ_Z u = u} = K⟨A⟩`.

Both inclusions are unconditional.  The easy one is that a constant left translation fixes the base
field and every jet of `A`; the hard one is the slice specialisation.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {K : Type*} [Field K] {N : ℕ}

/-- The entries of the system matrix. -/
def systemEntries (K : Type*) [Field K] (N : ℕ) : Set (JetField K (Fin N × Fin N)) :=
  {x | ∃ i j : Fin N, x = genericSystemMatrix K N i j}

theorem derivationClosed_curvatureField :
    DerivationClosed (differentialAdjoin K (systemEntries K N)) :=
  derivationClosed_differentialAdjoin_of_constants K
    (fun c => deriv_algebraMap_jetField_indexed c) _

theorem genericSystemMatrix_mem_curvatureField (i j : Fin N) :
    genericSystemMatrix K N i j ∈ differentialAdjoin K (systemEntries K N) :=
  subset_differentialAdjoin K _ ⟨i, j, rfl⟩

/-- **Every slice coordinate is a differential polynomial in the system matrix.** -/
theorem genericSliceMatrix_mem_curvatureField (m : ℕ) (i j : Fin N) :
    genericSliceMatrix K N m i j ∈ differentialAdjoin K (systemEntries K N) := by
  induction m generalizing i j with
  | zero =>
      rw [genericSliceMatrix_zero]
      by_cases h : i = j
      · subst h
        rw [Matrix.one_apply_eq]
        exact IntermediateField.one_mem _
      · rw [Matrix.one_apply_ne h]
        exact IntermediateField.zero_mem _
  | succ m ih =>
      rw [genericSliceMatrix_succ]
      refine IntermediateField.add_mem _ ?_ ?_
      · rw [matDeriv_apply]
        exact derivationClosed_curvatureField (ih i j)
      · rw [Matrix.mul_apply]
        refine sum_mem fun k _ => ?_
        exact IntermediateField.mul_mem _ (genericSystemMatrix_mem_curvatureField i k) (ih k j)

theorem sliceSubfield_le_curvatureField :
    sliceSubfield K N ≤ (differentialAdjoin K (systemEntries K N)).toSubfield := by
  rw [sliceSubfield, Subfield.closure_le]
  rintro x (⟨a, rfl⟩ | ⟨m, i, j, rfl⟩)
  · exact IntermediateField.algebraMap_mem _ a
  · exact genericSliceMatrix_mem_curvatureField m i j

/-- The left translation fixes the base field. -/
theorem leftTranslationFieldEquiv_algebraMap_base (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) (c : K) :
    leftTranslationFieldEquiv Z W hZW hWZ (algebraMap K (JetField K (Fin N × Fin N)) c)
      = algebraMap K (JetField K (Fin N × Fin N)) c := by
  have hb : (algebraMap K (JetField K (Fin N × Fin N)) c)
      = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
          (MvPolynomial.C c) := by
    rw [IsScalarTower.algebraMap_apply K (JetPoly K (Fin N × Fin N))
      (JetField K (Fin N × Fin N)), MvPolynomial.algebraMap_eq]
  rw [hb, leftTranslationFieldEquiv_algebraMap, leftTranslationPolyEquiv_C]

/-- The left translation fixes every jet of the system matrix. -/
theorem leftTranslationFieldEquiv_differentialJet_system (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) (n : ℕ) (i j : Fin N) :
    leftTranslationFieldEquiv Z W hZW hWZ
        (differentialJet n (genericSystemMatrix K N i j))
      = differentialJet n (genericSystemMatrix K N i j) := by
  induction n with
  | zero =>
      rw [differentialJet_zero]
      have h := map_leftTranslationFieldEquiv_genericSystemMatrix Z W hZW hWZ
      have := congrFun (congrFun h i) j
      simpa [Matrix.map_apply] using this
  | succ n ih =>
      rw [differentialJet_succ, leftTranslationFieldEquiv_deriv, ih, ← differentialJet_succ]

/-- **The curvature field is fixed by every constant left translation.** -/
theorem leftTranslationFieldEquiv_fixes_curvatureField (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) {u : JetField K (Fin N × Fin N)}
    (hu : u ∈ differentialAdjoin K (systemEntries K N)) :
    leftTranslationFieldEquiv Z W hZW hWZ u = u := by
  refine IntermediateField.adjoin_induction K
    (s := differentialJetSet (systemEntries K N))
    (p := fun y _ => leftTranslationFieldEquiv Z W hZW hWZ y = y) ?_ ?_ ?_ ?_ ?_ hu
  · rintro y ⟨x, ⟨i, j, rfl⟩, n, rfl⟩
    exact leftTranslationFieldEquiv_differentialJet_system Z W hZW hWZ n i j
  · intro c
    exact leftTranslationFieldEquiv_algebraMap_base Z W hZW hWZ c
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]

/-- **Card 12, item (2): the fixed field of the constant gauge group is the curvature field.** -/
theorem leftTranslationInvariants_eq_curvatureField [Infinite K] :
    {u : JetField K (Fin N × Fin N) | ∀ (Z W : Matrix (Fin N) (Fin N) K)
      (hZW : Z * W = 1) (hWZ : W * Z = 1), leftTranslationFieldEquiv Z W hZW hWZ u = u}
      = (differentialAdjoin K (systemEntries K N) : Set (JetField K (Fin N × Fin N))) := by
  ext u
  constructor
  · intro hu
    exact sliceSubfield_le_curvatureField (mem_sliceSubfield_of_leftTranslation_invariant u hu)
  · intro hu Z W hZW hWZ
    exact leftTranslationFieldEquiv_fixes_curvatureField Z W hZW hWZ hu

end

end GaloisForLFunctions.HTGeometry
