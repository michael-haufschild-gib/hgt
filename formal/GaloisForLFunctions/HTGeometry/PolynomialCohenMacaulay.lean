import GaloisForLFunctions.HTGeometry.CohenMacaulayDepth

/-!
# A polynomial ring over a field is Cohen–Macaulay

The variables are a regular sequence: a variable is a nonzerodivisor modulo the ideal generated by
any set of variables not containing it, because multiplying a monomial by that variable cannot
create an occurrence of a different one.  The sequence has length equal to the number of variables,
which is the Krull dimension, so the ring is Cohen–Macaulay in the sense of `IsCohenMacaulayRing`.

Along the way: a list without duplicates never repeats its `i`-th entry among the first `i`, which
mathlib does not have.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u

variable {K : Type u} [Field K] {n : ℕ}

theorem ofList_map_X (l : List (Fin n)) :
    Ideal.ofList (l.map (MvPolynomial.X : Fin n → MvPolynomial (Fin n) K))
      = Ideal.span (MvPolynomial.X '' {j : Fin n | j ∈ l}) := by
  rw [Ideal.ofList]
  congr 1
  ext p
  simp

/-- A variable is a nonzerodivisor modulo the ideal generated by the other variables. -/
theorem isRegularOn_X_of_notMem (L : List (Fin n)) {j : Fin n} (hj : j ∉ L) :
    IsRegularOn (Ideal.span (MvPolynomial.X '' {k : Fin n | k ∈ L}))
      (MvPolynomial.X j : MvPolynomial (Fin n) K) := by
  classical
  set J : Ideal (MvPolynomial (Fin n) K) :=
    Ideal.span (MvPolynomial.X '' {k : Fin n | k ∈ L}) with hJ
  have key : ∀ f : MvPolynomial (Fin n) K, f * MvPolynomial.X j ∈ J → f ∈ J := by
    intro f hf
    rw [hJ, MvPolynomial.mem_ideal_span_X_image] at hf ⊢
    intro m hm
    have hmem : m + Finsupp.single j 1 ∈ (f * MvPolynomial.X j).support := by
      rw [MvPolynomial.support_mul_X]
      exact Finset.mem_map_of_mem _ hm
    obtain ⟨k, hkL, hk⟩ := hf _ hmem
    refine ⟨k, hkL, ?_⟩
    have hkj : k ≠ j := fun h => hj (h ▸ hkL)
    have hval : ((m + Finsupp.single j 1 : Fin n →₀ ℕ)) k = m k := by
      rw [Finsupp.add_apply, Finsupp.single_apply, if_neg (Ne.symm hkj), add_zero]
    rwa [hval] at hk
  rw [IsRegularOn, mem_nonZeroDivisors_iff]
  have main : ∀ y : MvPolynomial (Fin n) K ⧸ J,
      y * (Ideal.Quotient.mk J (MvPolynomial.X j)) = 0 → y = 0 := by
    intro y hy
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (key f hy)
  exact ⟨fun y hy => main y (by rw [mul_comm]; exact hy), main⟩

/-- In a list without duplicates, the entry at index `i` does not occur among the first `i`. -/
theorem getElem_notMem_take_of_nodup {α : Type*} {l : List α} (h : l.Nodup) {i : ℕ}
    (hi : i < l.length) : l[i] ∉ l.take i := by
  intro hmem
  obtain ⟨k, hk, hkeq⟩ := List.getElem_of_mem hmem
  have hklt : k < i := by
    have hlen : (l.take i).length = min i l.length := List.length_take
    omega
  rw [List.getElem_take] at hkeq
  have := (List.Nodup.getElem_inj_iff h).mp hkeq
  omega

/-- **The variables form a regular sequence.** -/
theorem isRingRegularSeq_finRange_X (K : Type u) [Field K] (n : ℕ) :
    IsRingRegularSeq ((List.finRange n).map (MvPolynomial.X : Fin n → MvPolynomial (Fin n) K)) := by
  classical
  constructor
  · intro i hi
    rw [List.length_map, List.length_finRange] at hi
    rw [← List.map_take, ofList_map_X, List.getElem_map, List.getElem_finRange]
    refine isRegularOn_X_of_notMem _ ?_
    have hnd : (List.finRange n).Nodup := List.nodup_finRange n
    have hlen : i < (List.finRange n).length := by simpa using hi
    have := getElem_notMem_take_of_nodup hnd hlen
    rwa [List.getElem_finRange] at this
  · rw [ofList_map_X]
    intro htop
    have hone : (1 : MvPolynomial (Fin n) K)
        ∈ Ideal.span (MvPolynomial.X '' {j : Fin n | j ∈ List.finRange n}) := by
      rw [htop]; trivial
    rw [MvPolynomial.mem_ideal_span_X_image] at hone
    have hsupp : (0 : Fin n →₀ ℕ) ∈ (1 : MvPolynomial (Fin n) K).support := by
      simp [MvPolynomial.support_one]
    obtain ⟨j, _, hj⟩ := hone _ hsupp
    simp at hj

/-- **A polynomial ring over a field is Cohen–Macaulay.** -/
theorem isCohenMacaulayRing_mvPolynomial (K : Type u) [Field K] (n : ℕ) :
    IsCohenMacaulayRing (MvPolynomial (Fin n) K) := by
  refine ⟨(List.finRange n).map MvPolynomial.X, isRingRegularSeq_finRange_X K n, ?_⟩
  rw [List.length_map, List.length_finRange,
    MvPolynomial.ringKrullDim_of_isNoetherianRing (R := K) (ι := Fin n),
    ringKrullDim_eq_zero_of_field K]
  simp


end GaloisForLFunctions.HTGeometry
