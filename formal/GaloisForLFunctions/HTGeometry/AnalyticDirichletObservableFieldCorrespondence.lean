import GaloisForLFunctions.HTGeometry.FiniteAbscissaRationalCoordinateIndependence
import GaloisForLFunctions.HTGeometry.TailDenseObservableFieldClassification

/-!
# Analytic Dirichlet observable-field correspondence

A tail-dense prime sampler sends a continuous source observable to an actual meromorphic
Dirichlet germ. Over the genuine embedded coordinate field `ℂ(s)`, arbitrary independent source
spans are recovered exactly from the differential fields generated by these germs. One universal
source family canonically embeds its full powerset lattice into the analytic differential-field
lattice, preserving arbitrary-cardinality binary intersections and composita.

The central mechanism is source multiplication versus carrier linearity: the carrier is linear in
the observable, but pointwise products need not remain in the old source span.  Hence an
interaction observable creates a new relatively hypertranscendental analytic sector exactly when
it creates a new source direction.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

universe u v

set_option maxHeartbeats 600000
set_option synthInstance.maxHeartbeats 100000

local instance analyticObservableUpperEndAnalyticDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance analyticObservableUpperEndMeroComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance analyticObservableUpperEndMeroDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

/-! ## Bounded source realization -/

/-- A prime-supported coefficient stream with an arbitrary uniform bound has finite abscissa. -/
def uniformlyBoundedPrimeFiniteAbscissa
    (c : Nat.Primes → ℂ) (M : ℝ) (hc : ∀ p, ‖c p‖ ≤ M) :
    finiteAbscissaArithmeticSubalgebra := by
  refine ⟨arithmeticOfPrimeColumn c, 1, ?_⟩
  change ∀ y : ℝ, 1 < y →
    LSeriesSummable (fun n => arithmeticOfPrimeColumn c n) (y : ℂ)
  intro y hy
  have hM0 : 0 ≤ M :=
    (norm_nonneg (c ⟨2, Nat.prime_two⟩)).trans (hc ⟨2, Nat.prime_two⟩)
  apply LSeriesSummable_of_bounded_of_one_lt_re (m := M)
  · intro n hn
    by_cases hp : n.Prime
    · simpa [arithmeticOfPrimeColumn_apply_prime c ⟨n, hp⟩] using hc ⟨n, hp⟩
    · simp [arithmeticOfPrimeColumn, hp, hM0]
  · simpa using hy

@[simp]
theorem uniformlyBoundedPrimeFiniteAbscissa_apply
    (c : Nat.Primes → ℂ) (M : ℝ) (hc : ∀ p, ‖c p‖ ≤ M) (n : ℕ) :
    (uniformlyBoundedPrimeFiniteAbscissa c M hc).1 n = arithmeticOfPrimeColumn c n :=
  rfl

/-- The actual analytic carrier of one bounded prime observable at one Dirichlet shift. -/
def analyticPrimeObservableShiftCarrier
    (c : Nat.Primes → ℂ) (M : ℝ) (hc : ∀ p, ‖c p‖ ≤ M) (a : ℂ) :
    upperEndMeroField :=
  finiteAbscissaLSeriesToUpperEndMero
    (finiteAbscissaDirichletShift a (uniformlyBoundedPrimeFiniteAbscissa c M hc))

/-- Every analytic jet is the L-series realization of the shifted logarithmic source jet. -/
theorem differentialJet_analyticPrimeObservableShiftCarrier
    (c : Nat.Primes → ℂ) (M : ℝ) (hc : ∀ p, ‖c p‖ ≤ M)
    (a : ℂ) (k : ℕ) :
    GaloisForLFunctions.differentialJet k
        (analyticPrimeObservableShiftCarrier c M hc a) =
      finiteAbscissaLSeriesToUpperEndMero
        ((finiteAbscissaRotatedDeriv^[k])
          (finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa c M hc))) := by
  exact differentialJet_finiteAbscissaLSeriesToUpperEndMero _ k

/-- Exact prime coefficient formula for every shifted source jet. -/
theorem analyticPrimeObservableShiftJetSource_eq_arithmeticOfPrimeColumn
    (c : Nat.Primes → ℂ) (M : ℝ) (hc : ∀ p, ‖c p‖ ≤ M)
    (a : ℂ) (k : ℕ) :
    (((finiteAbscissaRotatedDeriv^[k])
      (finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa c M hc))).1) =
      arithmeticOfPrimeColumn
        (fun p => c p * primeShiftFactor a p * rotatedPrimeLogClock p ^ k) := by
  ext n
  rw [finiteAbscissaRotatedDeriv_iterate_apply,
    finiteAbscissaDirichletShift_apply]
  by_cases hn : n.Prime
  · let p : Nat.Primes := ⟨n, hn⟩
    rw [uniformlyBoundedPrimeFiniteAbscissa_apply,
      arithmeticOfPrimeColumn_apply_prime c p,
      arithmeticOfPrimeColumn_apply_prime _ p]
    rw [show cpowWeight a n = primeShiftFactor a p by
      exact cpowWeight_prime_eq_primeShiftFactor a p]
    simp only [rotatedPrimeLogClock, primeLogClock, p]
    ring
  · simp [uniformlyBoundedPrimeFiniteAbscissa, arithmeticOfPrimeColumn, hn]

/-! ## The actual `ℂ(s)` differential spectrum -/

/-- The prime-power packet theorem over the genuine embedded coordinate field `ℂ(s)`. -/
theorem algebraicIndependent_primePowerDilatedUpperEndMero_over_coordinate
    {d : ℕ} (B : Fin d → Type*)
    [∀ r, Fintype (B r)] [∀ r, DecidableEq (B r)]
    (f : ∀ r, B r → finiteAbscissaArithmeticSubalgebra)
    (a : ∀ r, B r → Nat.Primes → ℂ)
    (hf : ∀ r i, (f r i).1 = arithmeticOfPrimeColumn (a r i))
    (htail : ∀ r, TailCoefficientIndependent (a r)) :
    AlgebraicIndependent upperEndRationalCoordinateField
      (fun i : Σ r, B r =>
        finiteAbscissaLSeriesToUpperEndMero
          (finiteAbscissaPrimePowerDilation i.1 (f i.1 i.2))) := by
  let g : (Σ r, B r) → finiteAbscissaArithmeticSubalgebra := fun i =>
    finiteAbscissaPrimePowerDilation i.1 (f i.1 i.2)
  have hpacket := cofinitePrimePowerPacket_of_layerwise_tailIndependent d B a htail
  have hraw := algebraicIndependent_arithmeticPrimePowerColumns_of_cofinitePacket
    (primePowerSigmaExponent (A := B)) (primePowerSigmaCoefficient a) hpacket
  let incl : finiteAbscissaArithmeticSubalgebra →ₐ[ℂ] ArithmeticFunction ℂ :=
    finiteAbscissaArithmeticSubalgebra.val
  have hincl : Function.Injective incl := by
    intro x y hxy
    exact Subtype.ext hxy
  have hg : AlgebraicIndependent ℂ g := by
    apply (AlgHom.algebraicIndependent_iff incl hincl).mp
    convert hraw using 1
    funext i
    exact finiteAbscissaPrimePowerDilation_eq_arithmeticOfPrimePowerColumn
      i.1 (f i.1 i.2) (a i.1 i.2) (hf i.1 i.2)
  exact algebraicIndependent_finiteAbscissaLSeries_over_upperEndRationalCoordinate g hg

/-- A linearly independent finite family of bounded continuous source observables gives an
actual differentially independent family over `ℂ(s)`. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent
    {V : Type u} {J : Type v}
    [TopologicalSpace V] [Fintype J] [DecidableEq J] [Nonempty J]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun v : K => f j v.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j) (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
      (fun j => analyticPrimeObservableShiftCarrier
        (fun p => f j (x p)) (M j) (hM j) a) := by
  unfold GaloisForLFunctions.DifferentialIndependent
  apply algebraicIndependent_prod_nat_of_all_fin
  intro m
  let B : Fin 1 → Type v := fun _ => J × (Unit × Fin (m + 1))
  letI (r : Fin 1) : Fintype (B r) := inferInstance
  letI (r : Fin 1) : DecidableEq (B r) := Classical.decEq _
  let source : ∀ r, B r → finiteAbscissaArithmeticSubalgebra := fun _ q =>
    (finiteAbscissaRotatedDeriv^[q.2.2])
      (finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa
          (fun p => f q.1 (x p)) (M q.1) (hM q.1)))
  let coeff : ∀ r, B r → Nat.Primes → ℂ := fun _ q p =>
    f q.1 (x p) * primeShiftFactor a p * rotatedPrimeLogClock p ^ (q.2.2 : ℕ)
  have hsource : ∀ r q, (source r q).1 = arithmeticOfPrimeColumn (coeff r q) := by
    intro r q
    exact analyticPrimeObservableShiftJetSource_eq_arithmeticOfPrimeColumn
      (fun p => f q.1 (x p)) (M q.1) (hM q.1) a q.2.2
  have htail : ∀ r, TailCoefficientIndependent (coeff r) := by
    intro r
    have h := cofiniteTailDenseOn_primePowerShiftedRotatedJet_tailIndependent
      0 x K hx f hf hlinear (fun _ : Unit => a)
        (fun _ _ _ => Subsingleton.elim _ _) m
    norm_num at h
    simpa only [coeff] using h
  have hpacket := algebraicIndependent_primePowerDilatedUpperEndMero_over_coordinate
    B source coeff hsource htail
  let embed : J × Fin (m + 1) → Σ r, B r := fun q =>
    ⟨⟨0, by omega⟩, (q.1, ((), q.2))⟩
  have hembed : Function.Injective embed := by
    intro q r hqr
    have hval := congrArg (fun z : Σ r, B r => (z.2.1, z.2.2.2)) hqr
    exact Prod.ext (congrArg Prod.fst hval) (congrArg Prod.snd hval)
  have hsub := hpacket.comp embed hembed
  convert hsub using 1
  funext q
  rw [differentialJet_analyticPrimeObservableShiftCarrier]
  apply congrArg finiteAbscissaLSeriesToUpperEndMero
  apply Subtype.ext
  change ((finiteAbscissaRotatedDeriv^[q.2])
      (finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa
          (fun p => f q.1 (x p)) (M q.1) (hM q.1)))).1 =
    RHTower.mPart 1
      ((finiteAbscissaRotatedDeriv^[q.2])
        (finiteAbscissaDirichletShift a
          (uniformlyBoundedPrimeFiniteAbscissa
            (fun p => f q.1 (x p)) (M q.1) (hM q.1)))).1
  exact (RHTower.mPart_one _).symm

/-- **Arbitrary-source analytic freeness.** The finite-family theorem has finite character: an
arbitrary linearly independent family of bounded continuous source observables is differentially
independent over the actual coordinate field `ℂ(s)`. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent_arbitrary
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j) (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
      (fun j => analyticPrimeObservableShiftCarrier
        (fun p => f j (x p)) (M j) (hM j) a) := by
  unfold GaloisForLFunctions.DifferentialIndependent
  apply algebraicIndependent_of_finite_type
  intro t ht
  cases isEmpty_or_nonempty t with
  | inl htEmpty =>
      exact algebraicIndependent_empty_type_iff.mpr
        (FaithfulSMul.algebraMap_injective upperEndRationalCoordinateField
          upperEndMeroField)
  | inr htNonempty =>
      let J₀ : Set J := Prod.fst '' (t : Set (J × ℕ))
      letI : Finite J₀ := ht.image Prod.fst
      letI : Fintype J₀ := Fintype.ofFinite J₀
      letI : DecidableEq J₀ := Classical.decEq J₀
      let q₀ : t := Classical.choice htNonempty
      letI : Nonempty J₀ :=
        ⟨⟨q₀.1.1, ⟨q₀.1, q₀.2, rfl⟩⟩⟩
      let f₀ : J₀ → V → ℂ := fun j => f j.1
      let M₀ : J₀ → ℝ := fun j => M j.1
      have hf₀ : ∀ j, Continuous (f₀ j) := fun j => hf j.1
      have hM₀ : ∀ j p, ‖f₀ j (x p)‖ ≤ M₀ j := fun j p => hM j.1 p
      have hlinear₀ : LinearIndependent ℂ (fun j => fun z : K => f₀ j z.1) := by
        exact hlinear.comp (fun j : J₀ => j.1) Subtype.val_injective
      have hfinite :=
        cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent
          x K hx f₀ hf₀ hlinear₀ M₀ hM₀ a
      unfold GaloisForLFunctions.DifferentialIndependent at hfinite
      let e : t → J₀ × ℕ := fun q =>
        (⟨q.1.1, ⟨q.1, q.2, rfl⟩⟩, q.1.2)
      have he : Function.Injective e := by
        intro q r hqr
        apply Subtype.ext
        have hval := congrArg (fun z : J₀ × ℕ => (z.1.1, z.2)) hqr
        exact hval
      have hsub := hfinite.comp e he
      simpa only [Function.comp_apply, e, f₀, M₀] using hsub

/-! ## Source span versus generated field -/

/-- The analytic differential field generated by an arbitrary observable family over actual
`\mathbf C(s)`. -/
def analyticObservableShiftField
    {V J : Type*} (x : Nat.Primes → V) (f : J → V → ℂ)
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j) (a : ℂ) :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
    (Set.range fun j => analyticPrimeObservableShiftCarrier
      (fun p => f j (x p)) (M j) (hM j) a)

/-- Carrier linearity is exact and independent of the chosen convergence bounds. -/
theorem analyticPrimeObservableShiftCarrier_linearCombination
    {J : Type*} [Fintype J]
    (c : J → Nat.Primes → ℂ) (M : J → ℝ)
    (hM : ∀ j p, ‖c j p‖ ≤ M j) (u : J → ℂ)
    (d : Nat.Primes → ℂ) (N : ℝ) (hN : ∀ p, ‖d p‖ ≤ N)
    (hcoeff : ∀ p, d p = ∑ j, u j * c j p) (a : ℂ) :
    analyticPrimeObservableShiftCarrier d N hN a =
      ∑ j, algebraMap ℂ upperEndMeroField (u j) *
        analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a := by
  change finiteAbscissaLSeriesToUpperEndMero
      (finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa d N hN)) = _
  have hsource : finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa d N hN) =
      ∑ j, u j • finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)) := by
    apply Subtype.ext
    apply ArithmeticFunction.ext
    intro n
    rw [finiteAbscissaDirichletShift_apply]
    have hsum :
        ((∑ j, u j • finiteAbscissaDirichletShift a
          (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j))).1) =
        ∑ j, (u j • finiteAbscissaDirichletShift a
          (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j))).1 := by
      exact map_sum finiteAbscissaArithmeticSubalgebra.val _ Finset.univ
    rw [hsum]
    let ev : ArithmeticFunction ℂ →+ ℂ :=
      { toFun := fun F => F n
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    rw [show (∑ j, (u j • finiteAbscissaDirichletShift a
        (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j))).1) n =
          ∑ j, (u j • finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j))).1 n by
      exact map_sum ev _ Finset.univ]
    change cpowWeight a n * arithmeticOfPrimeColumn d n =
      ∑ j, u j * (cpowWeight a n * arithmeticOfPrimeColumn (c j) n)
    by_cases hn : n.Prime
    · let p : Nat.Primes := ⟨n, hn⟩
      rw [arithmeticOfPrimeColumn_apply_prime d p, hcoeff p]
      have hcprime : ∀ j, arithmeticOfPrimeColumn (c j) n = c j p := by
        intro j
        exact arithmeticOfPrimeColumn_apply_prime (c j) p
      simp_rw [hcprime]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    · simp [arithmeticOfPrimeColumn, hn]
  rw [hsource, map_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rw [map_smul]
  exact Algebra.smul_def _ _

/-- Carrier linearity for an arbitrary finitely supported source combination. This is the
finite-character form needed for fields generated by an arbitrary source family. -/
theorem analyticPrimeObservableShiftCarrier_finsuppLinearCombination
    {J : Type*} (c : J → Nat.Primes → ℂ) (M : J → ℝ)
    (hM : ∀ j p, ‖c j p‖ ≤ M j) (u : J →₀ ℂ)
    (d : Nat.Primes → ℂ) (N : ℝ) (hN : ∀ p, ‖d p‖ ≤ N)
    (hcoeff : ∀ p, d p = u.sum fun j z => z * c j p) (a : ℂ) :
    analyticPrimeObservableShiftCarrier d N hN a =
      u.sum fun j z => algebraMap ℂ upperEndMeroField z *
        analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a := by
  let S := {j // j ∈ u.support}
  let c₀ : S → Nat.Primes → ℂ := fun j => c j.1
  let M₀ : S → ℝ := fun j => M j.1
  let u₀ : S → ℂ := fun j => u j.1
  have hM₀ : ∀ j p, ‖c₀ j p‖ ≤ M₀ j := fun j p => hM j.1 p
  have hcoeff₀ : ∀ p, d p = ∑ j : S, u₀ j * c₀ j p := by
    intro p
    rw [hcoeff p]
    change (∑ j ∈ u.support, u j * c j p) =
      ∑ j : {j // j ∈ u.support}, u j.1 * c j.1 p
    exact (Finset.sum_coe_sort u.support fun j => u j * c j p).symm
  have hfinite := analyticPrimeObservableShiftCarrier_linearCombination
    c₀ M₀ hM₀ u₀ d N hN hcoeff₀ a
  rw [hfinite]
  change (∑ j : {j // j ∈ u.support},
      algebraMap ℂ upperEndMeroField (u j.1) *
        analyticPrimeObservableShiftCarrier (c j.1) (M j.1) (hM j.1) a) =
    ∑ j ∈ u.support, algebraMap ℂ upperEndMeroField (u j) *
      analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a
  exact Finset.sum_coe_sort u.support fun j =>
    algebraMap ℂ upperEndMeroField (u j) *
      analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a

/-- **Source escape creates a relatively hypertranscendental analytic sector.** If a bounded
continuous observable escapes the source span on the constraint set, its actual Dirichlet germ is
differentially independent over the whole analytic differential field generated by the old
observables over `ℂ(s)`. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span
    {V : Type u} {d : ℕ} [TopologicalSpace V] [Nonempty (Fin d)]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : Fin d → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun v : K => f j v.1))
    (M : Fin d → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (g : V → ℂ) (hg : Continuous g) (N : ℝ)
    (hN : ∀ p, ‖g (x p)‖ ≤ N) (a : ℂ)
    (hescape : (fun v : K => g v.1) ∉
      Submodule.span ℂ (Set.range fun j => fun v : K => f j v.1)) :
    GaloisForLFunctions.DifferentialIndependent
      (analyticObservableShiftField x f M hM a)
      (fun _ : Fin 1 => analyticPrimeObservableShiftCarrier
        (fun p => g (x p)) N hN a) := by
  let vf : Fin d → K → ℂ := fun j v => f j v.1
  let vg : K → ℂ := fun v => g v.1
  let F : Fin (d + 1) → V → ℂ := Fin.snoc f g
  let bounds : Fin (d + 1) → ℝ := Fin.snoc M N
  have hFcontinuous : ∀ j, Continuous (F j) := by
    intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · simpa [F] using hg
    · simpa [F] using hf i
  have hFlinear : LinearIndependent ℂ (fun j => fun v : K => F j v.1) := by
    have hsnoc : LinearIndependent ℂ (Fin.snoc vf vg) :=
      linearIndependent_finSnoc.mpr ⟨hlinear, hescape⟩
    have heq : (fun j => fun v : K => F j v.1) = Fin.snoc vf vg := by
      funext j v
      refine Fin.lastCases ?_ (fun i => ?_) j
      · simp [F, vf, vg]
      · simp [F, vf, vg]
    rw [heq]
    exact hsnoc
  have hbounds : ∀ j p, ‖F j (x p)‖ ≤ bounds j := by
    intro j p
    refine Fin.lastCases ?_ (fun i => ?_) j
    · simpa [F, bounds] using hN p
    · simpa [F, bounds] using hM i p
  have hDIext :=
    cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent
      x K hx F hFcontinuous hFlinear bounds hbounds a
  let left : Fin d → upperEndMeroField := fun j =>
    analyticPrimeObservableShiftCarrier (fun p => f j (x p)) (M j) (hM j) a
  let right : Fin 1 → upperEndMeroField := fun _ =>
    analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a
  let e : Fin d ⊕ Fin 1 ≃ Fin (d + 1) := finSumFinEquiv
  have hjoint : GaloisForLFunctions.DifferentialIndependent
      upperEndRationalCoordinateField (Sum.elim left right) := by
    have hcomp := hDIext.comp e e.injective
    have hfamily :
        ((fun j => analyticPrimeObservableShiftCarrier
          (fun p => F j (x p)) (bounds j) (hbounds j) a) ∘ e) =
            Sum.elim left right := by
      funext q
      rcases q with j | k
      · change analyticPrimeObservableShiftCarrier
          (fun p => F j.castSucc (x p)) (bounds j.castSucc) _ a = left j
        simp [F, bounds, left]
      · have hk : k = 0 := Subsingleton.elim _ _
        subst k
        change analyticPrimeObservableShiftCarrier
          (fun p => F (Fin.last d) (x p)) (bounds (Fin.last d)) _ a = right 0
        simp [F, bounds, right]
    rwa [hfamily] at hcomp
  simpa only [analyticObservableShiftField, left, right] using
    (GaloisForLFunctions.differentialIndependent_sum_right_over_left_differentialAdjoin
      left right hjoint)

/-- **Arbitrary-source escape law.** A bounded continuous observable outside the span of an
arbitrary independent bounded source family is differentially independent over the actual
analytic differential field generated by the entire family over `ℂ(s)`. Thus the field is a
canonical direct-limit object; no chosen finite chamber or inverse system enters the statement. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span_arbitrary
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (g : V → ℂ) (hg : Continuous g) (N : ℝ)
    (hN : ∀ p, ‖g (x p)‖ ≤ N) (a : ℂ)
    (hescape : (fun z : K => g z.1) ∉
      Submodule.span ℂ (Set.range fun j => fun z : K => f j z.1)) :
    GaloisForLFunctions.DifferentialIndependent
      (analyticObservableShiftField x f M hM a)
      (fun _ : Unit => analyticPrimeObservableShiftCarrier
        (fun p => g (x p)) N hN a) := by
  let vf : J → K → ℂ := fun j z => f j z.1
  let vg : K → ℂ := fun z => g z.1
  let F : Option J → V → ℂ := fun o => Option.casesOn' o g f
  let bounds : Option J → ℝ := fun o => Option.casesOn' o N M
  have hFcontinuous : ∀ o, Continuous (F o) := by
    intro o
    cases o with
    | none => simpa [F] using hg
    | some j => simpa [F] using hf j
  have hFlinear : LinearIndependent ℂ (fun o => fun z : K => F o z.1) := by
    have hoption : LinearIndependent ℂ
        (fun o => Option.casesOn' o vg vf : Option J → K → ℂ) :=
      hlinear.option hescape
    have heq : (fun o => fun z : K => F o z.1) =
        (fun o => Option.casesOn' o vg vf) := by
      funext o z
      cases o <;> rfl
    rw [heq]
    exact hoption
  have hbounds : ∀ o p, ‖F o (x p)‖ ≤ bounds o := by
    intro o p
    cases o with
    | none => simpa [F, bounds] using hN p
    | some j => simpa [F, bounds] using hM j p
  have hDIext :=
    cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent_arbitrary
      x K hx F hFcontinuous hFlinear bounds hbounds a
  let left : J → upperEndMeroField := fun j =>
    analyticPrimeObservableShiftCarrier (fun p => f j (x p)) (M j) (hM j) a
  let right : Unit → upperEndMeroField := fun _ =>
    analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a
  let e : J ⊕ Unit ≃ Option J :=
    { toFun := Sum.elim some fun _ => none
      invFun := fun o => Option.elim o (Sum.inr ()) Sum.inl
      left_inv := by
        intro q
        rcases q with j | u
        · rfl
        · cases u
          rfl
      right_inv := by
        intro o
        cases o <;> rfl }
  have hjoint : GaloisForLFunctions.DifferentialIndependent
      upperEndRationalCoordinateField (Sum.elim left right) := by
    have hcomp := hDIext.comp e e.injective
    have hfamily :
        ((fun o => analyticPrimeObservableShiftCarrier
          (fun p => F o (x p)) (bounds o) (hbounds o) a) ∘ e) =
            Sum.elim left right := by
      funext q
      rcases q with j | k
      · simp [e, F, bounds, left]
      · cases k
        simp [e, F, bounds, right]
    rwa [hfamily] at hcomp
  simpa only [analyticObservableShiftField, left, right] using
    (GaloisForLFunctions.differentialIndependent_sum_right_over_left_differentialAdjoin
      left right hjoint)

/-- **Analytic source-membership correspondence.** An actual bounded observable Dirichlet germ
belongs to the differential field generated by an independent finite family over `ℂ(s)` exactly
when the source observable belongs to the ordinary source span on the constraint set. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span
    {V : Type u} {d : ℕ} [TopologicalSpace V] [Nonempty (Fin d)]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : Fin d → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun v : K => f j v.1))
    (M : Fin d → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (g : V → ℂ) (hg : Continuous g) (N : ℝ)
    (hN : ∀ p, ‖g (x p)‖ ≤ N) (a : ℂ) :
    analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a ∈
        analyticObservableShiftField x f M hM a ↔
      (fun v : K => g v.1) ∈
        Submodule.span ℂ (Set.range fun j => fun v : K => f j v.1) := by
  let vf : Fin d → K → ℂ := fun j v => f j v.1
  let vg : K → ℂ := fun v => g v.1
  constructor
  · intro hmem
    by_contra hescape
    have hrel :=
      cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span
        x K hx f hf hlinear M hM g hg N hN a hescape
    unfold GaloisForLFunctions.DifferentialIndependent at hrel
    have ht := hrel.transcendental (0, 0)
    apply ht
    let z : analyticObservableShiftField x f M hM a :=
      ⟨analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a, hmem⟩
    refine ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, ?_⟩
    simp [z]
  · intro hspan
    rw [← Fintype.range_linearCombination ℂ vf] at hspan
    obtain ⟨A, hA⟩ := hspan
    have hcoeff : (fun p : Nat.Primes => g (x p)) =
        fun p => ∑ j, A j * f j (x p) := by
      funext p
      have hpK : x p ∈ K := hx.1 ⟨p, rfl⟩
      have hp := congrFun hA ⟨x p, hpK⟩
      simpa [Fintype.linearCombination_apply, vf, vg] using hp.symm
    have hcarrier := analyticPrimeObservableShiftCarrier_linearCombination
      (fun j p => f j (x p)) M hM A (fun p => g (x p)) N hN
        (fun p => congrFun hcoeff p) a
    rw [hcarrier]
    apply IntermediateField.sum_mem
    intro j hj
    apply IntermediateField.mul_mem
    · rw [IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField
        upperEndMeroField]
      exact IntermediateField.algebraMap_mem _
        (algebraMap ℂ upperEndRationalCoordinateField (A j))
    · exact GaloisForLFunctions.subset_differentialAdjoin
        upperEndRationalCoordinateField _ (Set.mem_range_self j)

/-- **Canonical arbitrary-source reconstruction.** For an arbitrary independent bounded source
family, its actual analytic differential field over `ℂ(s)` contains precisely the bounded
continuous observable carriers whose restrictions lie in the full algebraic source span. -/
theorem cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span_arbitrary
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (g : V → ℂ) (hg : Continuous g) (N : ℝ)
    (hN : ∀ p, ‖g (x p)‖ ≤ N) (a : ℂ) :
    analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a ∈
        analyticObservableShiftField x f M hM a ↔
      (fun z : K => g z.1) ∈
        Submodule.span ℂ (Set.range fun j => fun z : K => f j z.1) := by
  let vf : J → K → ℂ := fun j z => f j z.1
  let vg : K → ℂ := fun z => g z.1
  constructor
  · intro hmem
    by_contra hescape
    have hrel :=
      cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span_arbitrary
        x K hx f hf hlinear M hM g hg N hN a hescape
    unfold GaloisForLFunctions.DifferentialIndependent at hrel
    have ht := hrel.transcendental ((), 0)
    apply ht
    let z : analyticObservableShiftField x f M hM a :=
      ⟨analyticPrimeObservableShiftCarrier (fun p => g (x p)) N hN a, hmem⟩
    refine ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, ?_⟩
    simp [z]
  · intro hspan
    obtain ⟨u, hu⟩ :=
      Finsupp.mem_span_range_iff_exists_finsupp.mp hspan
    have hcoeff : ∀ p : Nat.Primes,
        g (x p) = u.sum fun j z => z * f j (x p) := by
      intro p
      have hpK : x p ∈ K := hx.1 ⟨p, rfl⟩
      have hp := congrFun hu ⟨x p, hpK⟩
      have hp' : u.sum (fun j z => z * f j (x p)) = g (x p) := by
        simpa only [Finsupp.sum, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
          vf, vg] using hp
      exact hp'.symm
    have hcarrier := analyticPrimeObservableShiftCarrier_finsuppLinearCombination
      (fun j p => f j (x p)) M hM u (fun p => g (x p)) N hN hcoeff a
    rw [hcarrier]
    change (u.sum fun j z => algebraMap ℂ upperEndMeroField z *
      analyticPrimeObservableShiftCarrier
        (fun p => f j (x p)) (M j) (hM j) a) ∈
          analyticObservableShiftField x f M hM a
    unfold Finsupp.sum
    apply IntermediateField.sum_mem
    intro j hj
    apply IntermediateField.mul_mem
    · rw [IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField
        upperEndMeroField]
      exact IntermediateField.algebraMap_mem _
        (algebraMap ℂ upperEndRationalCoordinateField (u j))
    · exact GaloisForLFunctions.subset_differentialAdjoin
        upperEndRationalCoordinateField _ (Set.mem_range_self j)

/-- The coefficientwise linear-combination law persists at every actual analytic jet. -/
theorem differentialJet_analyticPrimeObservableShiftCarrier_linearCombination
    {J : Type*} [Fintype J]
    (c : J → Nat.Primes → ℂ) (M : J → ℝ)
    (hM : ∀ j p, ‖c j p‖ ≤ M j) (u : J → ℂ)
    (d : Nat.Primes → ℂ) (N : ℝ) (hN : ∀ p, ‖d p‖ ≤ N)
    (hcoeff : ∀ p, d p = ∑ j, u j * c j p) (a : ℂ) (k : ℕ) :
    GaloisForLFunctions.differentialJet k
        (analyticPrimeObservableShiftCarrier d N hN a) =
      ∑ j, algebraMap ℂ upperEndMeroField (u j) *
        GaloisForLFunctions.differentialJet k
          (analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a) := by
  simp_rw [differentialJet_analyticPrimeObservableShiftCarrier]
  have hsource :
      (finiteAbscissaRotatedDeriv^[k])
          (finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa d N hN)) =
        ∑ j, u j • (finiteAbscissaRotatedDeriv^[k])
          (finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)) ) := by
    apply Subtype.ext
    apply ArithmeticFunction.ext
    intro n
    rw [finiteAbscissaRotatedDeriv_iterate_apply,
      finiteAbscissaDirichletShift_apply]
    have hsum :
        ((∑ j, u j • (finiteAbscissaRotatedDeriv^[k])
          (finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)))).1) =
        ∑ j, (u j • (finiteAbscissaRotatedDeriv^[k])
          (finiteAbscissaDirichletShift a
            (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)))).1 := by
      exact map_sum finiteAbscissaArithmeticSubalgebra.val _ Finset.univ
    rw [hsum]
    let ev : ArithmeticFunction ℂ →+ ℂ :=
      { toFun := fun F => F n
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    rw [show (∑ j, (u j • (finiteAbscissaRotatedDeriv^[k])
        (finiteAbscissaDirichletShift a
          (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)))).1) n =
          ∑ j, (u j • (finiteAbscissaRotatedDeriv^[k])
            (finiteAbscissaDirichletShift a
              (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)))).1 n by
      exact map_sum ev _ Finset.univ]
    change (Complex.I * (Real.log n : ℂ)) ^ k *
        (cpowWeight a n *
          (uniformlyBoundedPrimeFiniteAbscissa d N hN).1 n) =
      ∑ j, u j * (((finiteAbscissaRotatedDeriv^[k])
        (finiteAbscissaDirichletShift a
          (uniformlyBoundedPrimeFiniteAbscissa (c j) (M j) (hM j)))).1 n)
    rw [uniformlyBoundedPrimeFiniteAbscissa_apply]
    simp_rw [finiteAbscissaRotatedDeriv_iterate_apply,
      finiteAbscissaDirichletShift_apply,
      uniformlyBoundedPrimeFiniteAbscissa_apply]
    by_cases hn : n.Prime
    · let p : Nat.Primes := ⟨n, hn⟩
      rw [arithmeticOfPrimeColumn_apply_prime d p, hcoeff p]
      have hcprime : ∀ j, arithmeticOfPrimeColumn (c j) n = c j p := by
        intro j
        exact arithmeticOfPrimeColumn_apply_prime (c j) p
      simp_rw [hcprime]
      rw [Finset.mul_sum]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    · simp [arithmeticOfPrimeColumn, hn]
  rw [hsource, map_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rw [map_smul]
  exact Algebra.smul_def _ _

/-- Every jet respects an arbitrary finitely supported source combination. -/
theorem differentialJet_analyticPrimeObservableShiftCarrier_finsuppLinearCombination
    {J : Type*} (c : J → Nat.Primes → ℂ) (M : J → ℝ)
    (hM : ∀ j p, ‖c j p‖ ≤ M j) (u : J →₀ ℂ)
    (d : Nat.Primes → ℂ) (N : ℝ) (hN : ∀ p, ‖d p‖ ≤ N)
    (hcoeff : ∀ p, d p = u.sum fun j z => z * c j p) (a : ℂ) (k : ℕ) :
    GaloisForLFunctions.differentialJet k
        (analyticPrimeObservableShiftCarrier d N hN a) =
      u.sum fun j z => algebraMap ℂ upperEndMeroField z *
        GaloisForLFunctions.differentialJet k
          (analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a) := by
  let S := {j // j ∈ u.support}
  let c₀ : S → Nat.Primes → ℂ := fun j => c j.1
  let M₀ : S → ℝ := fun j => M j.1
  let u₀ : S → ℂ := fun j => u j.1
  have hM₀ : ∀ j p, ‖c₀ j p‖ ≤ M₀ j := fun j p => hM j.1 p
  have hcoeff₀ : ∀ p, d p = ∑ j : S, u₀ j * c₀ j p := by
    intro p
    rw [hcoeff p]
    change (∑ j ∈ u.support, u j * c j p) =
      ∑ j : {j // j ∈ u.support}, u j.1 * c j.1 p
    exact (Finset.sum_coe_sort u.support fun j => u j * c j p).symm
  have hfinite :=
    differentialJet_analyticPrimeObservableShiftCarrier_linearCombination
      c₀ M₀ hM₀ u₀ d N hN hcoeff₀ a k
  rw [hfinite]
  change (∑ j : {j // j ∈ u.support},
      algebraMap ℂ upperEndMeroField (u j.1) *
        GaloisForLFunctions.differentialJet k
          (analyticPrimeObservableShiftCarrier (c j.1) (M j.1) (hM j.1) a)) =
    ∑ j ∈ u.support, algebraMap ℂ upperEndMeroField (u j) *
      GaloisForLFunctions.differentialJet k
        (analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a)
  exact Finset.sum_coe_sort u.support fun j =>
    algebraMap ℂ upperEndMeroField (u j) *
      GaloisForLFunctions.differentialJet k
        (analyticPrimeObservableShiftCarrier (c j) (M j) (hM j) a)

/-- **Analytic observable-field order correspondence.** Inclusion of the actual embedded
differential fields is equivalent to inclusion of the finite-dimensional source-observable spans.
-/
theorem cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le
    {V : Type u} {d e : ℕ} [TopologicalSpace V]
    [Nonempty (Fin d)] [Nonempty (Fin e)]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : Fin d → V → ℂ) (g : Fin e → V → ℂ)
    (hf : ∀ j, Continuous (f j)) (hg : ∀ j, Continuous (g j))
    (hgind : LinearIndependent ℂ (fun j => fun v : K => g j v.1))
    (M : Fin d → ℝ) (N : Fin e → ℝ)
    (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (hN : ∀ j p, ‖g j (x p)‖ ≤ N j) (a : ℂ) :
    analyticObservableShiftField x f M hM a ≤
        analyticObservableShiftField x g N hN a ↔
      Submodule.span ℂ (Set.range fun j => fun v : K => f j v.1) ≤
        Submodule.span ℂ (Set.range fun j => fun v : K => g j v.1) := by
  constructor
  · intro hfield
    rw [Submodule.span_le]
    intro w hw
    obtain ⟨j, rfl⟩ := hw
    apply (cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span
      x K hx g hg hgind N hN (f j) (hf j) (M j) (hM j) a).mp
    apply hfield
    exact GaloisForLFunctions.subset_differentialAdjoin
      upperEndRationalCoordinateField _ (Set.mem_range_self j)
  · intro hspan
    unfold analyticObservableShiftField GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨y, ⟨j, rfl⟩, k, rfl⟩
    let vg : Fin e → K → ℂ := fun i v => g i v.1
    have hfj : (fun v : K => f j v.1) ∈ Submodule.span ℂ (Set.range vg) := by
      apply hspan
      exact Submodule.subset_span (Set.mem_range_self j)
    rw [← Fintype.range_linearCombination ℂ vg] at hfj
    obtain ⟨A, hA⟩ := hfj
    have hcoeff : (fun p : Nat.Primes => f j (x p)) =
        fun p => ∑ i, A i * g i (x p) := by
      funext p
      have hpK : x p ∈ K := hx.1 ⟨p, rfl⟩
      have hp := congrFun hA ⟨x p, hpK⟩
      simpa [Fintype.linearCombination_apply, vg] using hp.symm
    rw [differentialJet_analyticPrimeObservableShiftCarrier_linearCombination
      (fun i p => g i (x p)) N hN A (fun p => f j (x p)) (M j) (hM j)
        (fun p => congrFun hcoeff p) a k]
    apply IntermediateField.sum_mem
    intro i hi
    apply IntermediateField.mul_mem
    · rw [IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField
        upperEndMeroField]
      exact IntermediateField.algebraMap_mem _
        (algebraMap ℂ upperEndRationalCoordinateField (A i))
    · exact GaloisForLFunctions.differentialJet_mem_differentialAdjoin
        upperEndRationalCoordinateField (Set.mem_range_self i) k

/-- **Analytic Grassmann-field classification.** Two independent finite bounded continuous
source families generate the same actual embedded differential field over `ℂ(s)` exactly when
their source spans on the constraint set agree. -/
theorem cofiniteTailDenseOn_analyticObservableShiftField_eq_iff_span_eq
    {V : Type u} {d e : ℕ} [TopologicalSpace V]
    [Nonempty (Fin d)] [Nonempty (Fin e)]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : Fin d → V → ℂ) (g : Fin e → V → ℂ)
    (hf : ∀ j, Continuous (f j)) (hg : ∀ j, Continuous (g j))
    (hfind : LinearIndependent ℂ (fun j => fun v : K => f j v.1))
    (hgind : LinearIndependent ℂ (fun j => fun v : K => g j v.1))
    (M : Fin d → ℝ) (N : Fin e → ℝ)
    (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (hN : ∀ j p, ‖g j (x p)‖ ≤ N j) (a : ℂ) :
    analyticObservableShiftField x f M hM a =
        analyticObservableShiftField x g N hN a ↔
      Submodule.span ℂ (Set.range fun j => fun v : K => f j v.1) =
        Submodule.span ℂ (Set.range fun j => fun v : K => g j v.1) := by
  let hfg := cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le
    x K hx f g hf hg hgind M N hM hN a
  let hgf := cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le
    x K hx g f hg hf hfind N M hN hM a
  constructor
  · intro hfield
    exact le_antisymm (hfg.mp hfield.le) (hgf.mp hfield.ge)
  · intro hspan
    exact le_antisymm (hfg.mpr hspan.le) (hgf.mpr hspan.ge)

/-- **Complete analytic observable-field order law.** For arbitrary source families, inclusion of
the actual embedded differential fields is exactly inclusion of source-observable spans. -/
theorem cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le_arbitrary
    {V : Type u} {I : Type v} {J : Type w} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : I → V → ℂ) (g : J → V → ℂ)
    (hf : ∀ i, Continuous (f i)) (hg : ∀ j, Continuous (g j))
    (hgind : LinearIndependent ℂ (fun j => fun z : K => g j z.1))
    (M : I → ℝ) (N : J → ℝ)
    (hM : ∀ i p, ‖f i (x p)‖ ≤ M i)
    (hN : ∀ j p, ‖g j (x p)‖ ≤ N j) (a : ℂ) :
    analyticObservableShiftField x f M hM a ≤
        analyticObservableShiftField x g N hN a ↔
      Submodule.span ℂ (Set.range fun i => fun z : K => f i z.1) ≤
        Submodule.span ℂ (Set.range fun j => fun z : K => g j z.1) := by
  constructor
  · intro hfield
    rw [Submodule.span_le]
    intro source hsource
    obtain ⟨i, rfl⟩ := hsource
    apply (cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span_arbitrary
      x K hx g hg hgind N hN (f i) (hf i) (M i) (hM i) a).mp
    apply hfield
    exact GaloisForLFunctions.subset_differentialAdjoin
      upperEndRationalCoordinateField _ (Set.mem_range_self i)
  · intro hspan
    unfold analyticObservableShiftField GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨y, ⟨i, rfl⟩, k, rfl⟩
    let vg : J → K → ℂ := fun j z => g j z.1
    have hfi : (fun z : K => f i z.1) ∈
        Submodule.span ℂ (Set.range vg) := by
      apply hspan
      exact Submodule.subset_span (Set.mem_range_self i)
    obtain ⟨u, hu⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hfi
    have hcoeff : ∀ p : Nat.Primes,
        f i (x p) = u.sum fun j c => c * g j (x p) := by
      intro p
      have hpK : x p ∈ K := hx.1 ⟨p, rfl⟩
      have hp := congrFun hu ⟨x p, hpK⟩
      have hp' : u.sum (fun j c => c * g j (x p)) = f i (x p) := by
        simpa only [Finsupp.sum, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
          vg] using hp
      exact hp'.symm
    rw [differentialJet_analyticPrimeObservableShiftCarrier_finsuppLinearCombination
      (fun j p => g j (x p)) N hN u (fun p => f i (x p)) (M i) (hM i)
        hcoeff a k]
    unfold Finsupp.sum
    apply IntermediateField.sum_mem
    intro j hj
    apply IntermediateField.mul_mem
    · rw [IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField
        upperEndMeroField]
      exact IntermediateField.algebraMap_mem _
        (algebraMap ℂ upperEndRationalCoordinateField (u j))
    · exact GaloisForLFunctions.differentialJet_mem_differentialAdjoin
        upperEndRationalCoordinateField (Set.mem_range_self j) k

/-- **Complete analytic Grassmann-field classification.** Arbitrary independent bounded
continuous source families generate the same embedded differential field over `ℂ(s)` exactly
when they span the same source-observable subspace on the constraint set. -/
theorem cofiniteTailDenseOn_analyticObservableShiftField_eq_iff_span_eq_arbitrary
    {V : Type u} {I : Type v} {J : Type w} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : I → V → ℂ) (g : J → V → ℂ)
    (hf : ∀ i, Continuous (f i)) (hg : ∀ j, Continuous (g j))
    (hfind : LinearIndependent ℂ (fun i => fun z : K => f i z.1))
    (hgind : LinearIndependent ℂ (fun j => fun z : K => g j z.1))
    (M : I → ℝ) (N : J → ℝ)
    (hM : ∀ i p, ‖f i (x p)‖ ≤ M i)
    (hN : ∀ j p, ‖g j (x p)‖ ≤ N j) (a : ℂ) :
    analyticObservableShiftField x f M hM a =
        analyticObservableShiftField x g N hN a ↔
      Submodule.span ℂ (Set.range fun i => fun z : K => f i z.1) =
        Submodule.span ℂ (Set.range fun j => fun z : K => g j z.1) := by
  let hfg := cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le_arbitrary
    x K hx f g hf hg hgind M N hM hN a
  let hgf := cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le_arbitrary
    x K hx g f hg hf hfind N M hN hM a
  constructor
  · intro hfield
    exact le_antisymm (hfg.mp hfield.le) (hgf.mp hfield.ge)
  · intro hspan
    exact le_antisymm (hfg.mpr hspan.le) (hgf.mpr hspan.ge)

/-- An independent family identifies inclusion between spans of selected coordinates with
ordinary inclusion between their index sets. -/
theorem linearIndependent_span_image_le_span_image_iff
    {J : Type*} {E : Type*} [AddCommGroup E] [Module ℂ E]
    (v : J → E) (hv : LinearIndependent ℂ v) (S T : Set J) :
    Submodule.span ℂ (v '' S) ≤ Submodule.span ℂ (v '' T) ↔ S ⊆ T := by
  constructor
  · intro hspan j hjS
    have hjmem : v j ∈ Submodule.span ℂ (v '' T) := by
      apply hspan
      exact Submodule.subset_span ⟨j, hjS, rfl⟩
    have hT : LinearIndepOn ℂ v T := hv.linearIndepOn T
    exact (hT.mem_span_iff.mp hjmem) (hv.linearIndepOn (insert j T))
  · intro hST
    exact Submodule.span_mono (Set.image_mono hST)

/-- The canonical analytic field carried by a selected subset of one universal source family. -/
def analyticObservableSubsetField
    {V J : Type*} (x : Nat.Primes → V) (f : J → V → ℂ)
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (S : Set J) :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  analyticObservableShiftField x (fun j : S => f j.1)
    (fun j : S => M j.1) (fun j p => hM j.1 p) a

/-- **Canonical Boolean coordinate skeleton.** Subsets of any arbitrary independent bounded
continuous source family embed order-reflectingly into the actual analytic differential-field
lattice over `ℂ(s)`. This is a single canonical infinite construction, not a compatible family of
finite realizations. -/
theorem cofiniteTailDenseOn_analyticObservableSubsetField_le_iff_subset
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (S T : Set J) :
    analyticObservableSubsetField x f M hM a S ≤
        analyticObservableSubsetField x f M hM a T ↔ S ⊆ T := by
  let vf : J → K → ℂ := fun j z => f j z.1
  have hTlinear : LinearIndependent ℂ (fun j : T => fun z : K => f j.1 z.1) :=
    hlinear.comp (fun j : T => j.1) Subtype.val_injective
  have horder :=
    cofiniteTailDenseOn_analyticObservableShiftField_le_iff_span_le_arbitrary
      x K hx (fun j : S => f j.1) (fun j : T => f j.1)
      (fun j => hf j.1) (fun j => hf j.1) hTlinear
      (fun j : S => M j.1) (fun j : T => M j.1)
      (fun j p => hM j.1 p) (fun j p => hM j.1 p) a
  have hrangeS :
      Set.range (fun j : S => fun z : K => f j.1 z.1) = vf '' S := by
    ext z
    simp only [Set.mem_range, Set.mem_image, vf]
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨j.1, j.2, rfl⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j, hj⟩, rfl⟩
  have hrangeT :
      Set.range (fun j : T => fun z : K => f j.1 z.1) = vf '' T := by
    ext z
    simp only [Set.mem_range, Set.mem_image, vf]
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨j.1, j.2, rfl⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨⟨j, hj⟩, rfl⟩
  unfold analyticObservableSubsetField
  refine horder.trans ?_
  rw [hrangeS, hrangeT]
  exact linearIndependent_span_image_le_span_image_iff vf hlinear S T

/-- **Analytic source-field lattice embedding.** A universal independent bounded continuous
source family canonically embeds its complete powerset order into actual analytic differential
fields over `ℂ(s)`. -/
noncomputable def analyticObservableSubsetFieldOrderEmbedding
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j) (a : ℂ) :
    Set J ↪o IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  OrderEmbedding.ofMapLEIff
    (analyticObservableSubsetField x f M hM a)
    (fun S T => cofiniteTailDenseOn_analyticObservableSubsetField_le_iff_subset
      x K hx f hf hlinear M hM a S T)

/-- **Exact interaction-source creation law.** The product of two bounded continuous observables
creates a new relatively hypertranscendental analytic sector over the old field exactly when that
pointwise interaction creates a new direction in the source-observable space. -/
theorem cofiniteTailDenseOn_analyticObservableProduct_relativeHT_iff_product_escapes_span
    {V : Type u} {d : ℕ} [TopologicalSpace V] [Nonempty (Fin d)]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : Fin d → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun v : K => f j v.1))
    (M : Fin d → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (u v : V → ℂ) (hu : Continuous u) (hv : Continuous v)
    (N : ℝ) (hN : ∀ p, ‖u (x p) * v (x p)‖ ≤ N) (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent
        (analyticObservableShiftField x f M hM a)
        (fun _ : Fin 1 => analyticPrimeObservableShiftCarrier
          (fun p => u (x p) * v (x p)) N hN a) ↔
      (fun z : K => u z.1 * v z.1) ∉
        Submodule.span ℂ (Set.range fun j => fun z : K => f j z.1) := by
  let product : V → ℂ := fun z => u z * v z
  have hproduct : Continuous product := hu.mul hv
  constructor
  · intro hrel hspan
    have hmem :=
      (cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span
        x K hx f hf hlinear M hM product hproduct N hN a).mpr hspan
    unfold GaloisForLFunctions.DifferentialIndependent at hrel
    have ht := hrel.transcendental (0, 0)
    apply ht
    let z : analyticObservableShiftField x f M hM a :=
      ⟨analyticPrimeObservableShiftCarrier
        (fun p => u (x p) * v (x p)) N hN a, hmem⟩
    refine ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, ?_⟩
    simp [z]
  · intro hescape
    exact cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span
      x K hx f hf hlinear M hM product hproduct N hN a hescape

/-- **Complete interaction-source creation law.** The exact product-creation criterion remains
valid over a field generated by an arbitrary independent source family. -/
theorem cofiniteTailDenseOn_analyticObservableProduct_relativeHT_iff_product_escapes_span_arbitrary
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (u v : V → ℂ) (hu : Continuous u) (hv : Continuous v)
    (N : ℝ) (hN : ∀ p, ‖u (x p) * v (x p)‖ ≤ N) (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent
        (analyticObservableShiftField x f M hM a)
        (fun _ : Unit => analyticPrimeObservableShiftCarrier
          (fun p => u (x p) * v (x p)) N hN a) ↔
      (fun z : K => u z.1 * v z.1) ∉
        Submodule.span ℂ (Set.range fun j => fun z : K => f j z.1) := by
  let product : V → ℂ := fun z => u z * v z
  have hproduct : Continuous product := hu.mul hv
  constructor
  · intro hrel hspan
    have hmem :=
      (cofiniteTailDenseOn_analyticObservableShiftCarrier_mem_field_iff_mem_span_arbitrary
        x K hx f hf hlinear M hM product hproduct N hN a).mpr hspan
    unfold GaloisForLFunctions.DifferentialIndependent at hrel
    have ht := hrel.transcendental ((), 0)
    apply ht
    let z : analyticObservableShiftField x f M hM a :=
      ⟨analyticPrimeObservableShiftCarrier
        (fun p => u (x p) * v (x p)) N hN a, hmem⟩
    refine ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, ?_⟩
    simp [z]
  · intro hescape
    exact
      cofiniteTailDenseOn_analyticObservableShiftCarrier_relativeHT_of_not_mem_span_arbitrary
        x K hx f hf hlinear M hM product hproduct N hN a hescape

/-- **Actual analytic meet law.** Three jointly independent source blocks generate two analytic
differential fields whose intersection is exactly the field generated by their common source
block. Thus the observable-to-field correspondence preserves finite intersections, not only
order and equality. -/
theorem cofiniteTailDenseOn_analyticObservable_threeBlock_field_inf
    {V : Type u} {A B C : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (fa : A → V → ℂ) (fb : B → V → ℂ) (fc : C → V → ℂ)
    (hfa : ∀ i, Continuous (fa i)) (hfb : ∀ i, Continuous (fb i))
    (hfc : ∀ i, Continuous (fc i))
    (hlinear : LinearIndependent ℂ
      (Sum.elim (fun i => fun z : K => fa i z.1)
        (Sum.elim (fun i => fun z : K => fb i z.1)
          (fun i => fun z : K => fc i z.1))))
    (MA : A → ℝ) (MB : B → ℝ) (MC : C → ℝ)
    (hMA : ∀ i p, ‖fa i (x p)‖ ≤ MA i)
    (hMB : ∀ i p, ‖fb i (x p)‖ ≤ MB i)
    (hMC : ∀ i p, ‖fc i (x p)‖ ≤ MC i) (a : ℂ) :
    GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
        (Set.range (Sum.elim
          (fun i => analyticPrimeObservableShiftCarrier
            (fun p => fa i (x p)) (MA i) (hMA i) a)
          (fun i => analyticPrimeObservableShiftCarrier
            (fun p => fb i (x p)) (MB i) (hMB i) a))) ⊓
      GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
        (Set.range (Sum.elim
          (fun i => analyticPrimeObservableShiftCarrier
            (fun p => fa i (x p)) (MA i) (hMA i) a)
          (fun i => analyticPrimeObservableShiftCarrier
            (fun p => fc i (x p)) (MC i) (hMC i) a))) =
      GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
        (Set.range (fun i => analyticPrimeObservableShiftCarrier
          (fun p => fa i (x p)) (MA i) (hMA i) a)) := by
  let F : A ⊕ (B ⊕ C) → V → ℂ := Sum.elim fa (Sum.elim fb fc)
  let bounds : A ⊕ (B ⊕ C) → ℝ := Sum.elim MA (Sum.elim MB MC)
  have hFcontinuous : ∀ i, Continuous (F i) := by
    intro i
    rcases i with i | i
    · exact hfa i
    · rcases i with i | i
      · exact hfb i
      · exact hfc i
  have hFbounds : ∀ i p, ‖F i (x p)‖ ≤ bounds i := by
    intro i p
    rcases i with i | i
    · exact hMA i p
    · rcases i with i | i
      · exact hMB i p
      · exact hMC i p
  have hFlinear : LinearIndependent ℂ (fun j => fun z : K => F j z.1) := by
    have heq : (fun j => fun z : K => F j z.1) =
        Sum.elim (fun i => fun z : K => fa i z.1)
          (Sum.elim (fun i => fun z : K => fb i z.1)
            (fun i => fun z : K => fc i z.1)) := by
      funext j z
      rcases j with i | i
      · rfl
      · rcases i with i | i <;> rfl
    rw [heq]
    exact hlinear
  have hDI :=
    cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent_arbitrary
    x K hx F hFcontinuous hFlinear bounds hFbounds a
  let ca : A → upperEndMeroField := fun i =>
    analyticPrimeObservableShiftCarrier (fun p => fa i (x p)) (MA i) (hMA i) a
  let cb : B → upperEndMeroField := fun i =>
    analyticPrimeObservableShiftCarrier (fun p => fb i (x p)) (MB i) (hMB i) a
  let cc : C → upperEndMeroField := fun i =>
    analyticPrimeObservableShiftCarrier (fun p => fc i (x p)) (MC i) (hMC i) a
  have hjoint : GaloisForLFunctions.DifferentialIndependent
      upperEndRationalCoordinateField (Sum.elim ca (Sum.elim cb cc)) := by
    have hfamily :
        (fun j => analyticPrimeObservableShiftCarrier
          (fun p => F j (x p)) (bounds j) (hFbounds j) a) =
          Sum.elim ca (Sum.elim cb cc) := by
      funext j
      rcases j with i | i
      · rfl
      · rcases i with i | i <;> rfl
    rwa [hfamily] at hDI
  exact GaloisForLFunctions.differentialIndependent_threeBlock_differentialAdjoin_inf
    ca cb cc hjoint

/-- **Canonical infinite intersection law.** For one arbitrary independent source family, the
fields carried by two sets of source directions intersect exactly in the field carried by their
set-theoretic intersection. Thus the canonical subset-field embedding preserves binary meets,
even for infinite source sets. -/
theorem cofiniteTailDenseOn_analyticObservableSubsetField_inf
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (S T : Set J) :
    analyticObservableSubsetField x f M hM a S ⊓
        analyticObservableSubsetField x f M hM a T =
      analyticObservableSubsetField x f M hM a (S ∩ T) := by
  let A := {j // j ∈ S ∩ T}
  let B := {j // j ∈ S \ T}
  let C := {j // j ∈ T \ S}
  let e : A ⊕ (B ⊕ C) → J :=
    Sum.elim Subtype.val (Sum.elim Subtype.val Subtype.val)
  have he : Function.Injective e := by
    intro q r hqr
    rcases q with q | q
    · rcases r with r | r
      · congr 1
        exact Subtype.ext hqr
      · rcases r with r | r
        · exfalso
          change q.1 = r.1 at hqr
          exact r.2.2 (hqr ▸ q.2.2)
        · exfalso
          change q.1 = r.1 at hqr
          exact r.2.2 (hqr ▸ q.2.1)
    · rcases q with q | q
      · rcases r with r | r
        · exfalso
          change q.1 = r.1 at hqr
          exact q.2.2 (hqr ▸ r.2.2)
        · rcases r with r | r
          · congr 2
            exact Subtype.ext hqr
          · exfalso
            change q.1 = r.1 at hqr
            exact r.2.2 (hqr ▸ q.2.1)
      · rcases r with r | r
        · exfalso
          change q.1 = r.1 at hqr
          exact q.2.2 (hqr ▸ r.2.1)
        · rcases r with r | r
          · exfalso
            change q.1 = r.1 at hqr
            exact q.2.2 (hqr ▸ r.2.1)
          · congr 2
            exact Subtype.ext hqr
  have htriple : LinearIndependent ℂ
      (Sum.elim (fun i : A => fun z : K => f i.1 z.1)
        (Sum.elim (fun i : B => fun z : K => f i.1 z.1)
          (fun i : C => fun z : K => f i.1 z.1))) := by
    have hcomp := hlinear.comp e he
    have heq :
        (Sum.elim (fun i : A => fun z : K => f i.1 z.1)
          (Sum.elim (fun i : B => fun z : K => f i.1 z.1)
            (fun i : C => fun z : K => f i.1 z.1))) =
          (fun q => (fun j => fun z : K => f j z.1) (e q)) := by
      funext q z
      rcases q with q | q
      · rfl
      · rcases q with q | q <;> rfl
    rw [heq]
    simpa only [Function.comp_apply] using hcomp
  let carrier : J → upperEndMeroField := fun j =>
    analyticPrimeObservableShiftCarrier (fun p => f j (x p)) (M j) (hM j) a
  let cA : A → upperEndMeroField := fun i => carrier i.1
  let cB : B → upperEndMeroField := fun i => carrier i.1
  let cC : C → upperEndMeroField := fun i => carrier i.1
  have hmeet :
      GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
          (Set.range (Sum.elim cA cB)) ⊓
        GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
          (Set.range (Sum.elim cA cC)) =
        GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
          (Set.range cA) := by
    simpa only [cA, cB, cC, carrier] using
      (cofiniteTailDenseOn_analyticObservable_threeBlock_field_inf
        x K hx (fun i : A => f i.1) (fun i : B => f i.1) (fun i : C => f i.1)
        (fun i => hf i.1) (fun i => hf i.1) (fun i => hf i.1) htriple
        (fun i : A => M i.1) (fun i : B => M i.1) (fun i : C => M i.1)
        (fun i p => hM i.1 p) (fun i p => hM i.1 p) (fun i p => hM i.1 p) a)
  have hrangeS : Set.range (Sum.elim cA cB) =
      Set.range (fun i : S => carrier i.1) := by
    ext z
    constructor
    · rintro ⟨q, rfl⟩
      rcases q with i | i
      · exact ⟨⟨i.1, i.2.1⟩, rfl⟩
      · exact ⟨⟨i.1, i.2.1⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      by_cases hiT : i.1 ∈ T
      · exact ⟨Sum.inl ⟨i.1, i.2, hiT⟩, rfl⟩
      · exact ⟨Sum.inr ⟨i.1, i.2, hiT⟩, rfl⟩
  have hrangeT : Set.range (Sum.elim cA cC) =
      Set.range (fun i : T => carrier i.1) := by
    ext z
    constructor
    · rintro ⟨q, rfl⟩
      rcases q with i | i
      · exact ⟨⟨i.1, i.2.2⟩, rfl⟩
      · exact ⟨⟨i.1, i.2.1⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      by_cases hiS : i.1 ∈ S
      · exact ⟨Sum.inl ⟨i.1, hiS, i.2⟩, rfl⟩
      · exact ⟨Sum.inr ⟨i.1, i.2, hiS⟩, rfl⟩
  have hrangeA : Set.range cA =
      Set.range (fun i : ↥(S ∩ T) => carrier i.1) := rfl
  rw [hrangeS, hrangeT, hrangeA] at hmeet
  simpa only [analyticObservableSubsetField, analyticObservableShiftField, carrier] using hmeet

/-- **Canonical infinite compositum law.** The field carried by the union of two arbitrary sets
of independent source directions is exactly the compositum of the two carried fields. -/
theorem cofiniteTailDenseOn_analyticObservableSubsetField_sup
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j => fun z : K => f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (S T : Set J) :
    analyticObservableSubsetField x f M hM a S ⊔
        analyticObservableSubsetField x f M hM a T =
      analyticObservableSubsetField x f M hM a (S ∪ T) := by
  apply le_antisymm
  · apply sup_le
    · exact
        (cofiniteTailDenseOn_analyticObservableSubsetField_le_iff_subset
          x K hx f hf hlinear M hM a S (S ∪ T)).mpr Set.subset_union_left
    · exact
        (cofiniteTailDenseOn_analyticObservableSubsetField_le_iff_subset
          x K hx f hf hlinear M hM a T (S ∪ T)).mpr Set.subset_union_right
  · unfold analyticObservableSubsetField analyticObservableShiftField
    unfold GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨y, ⟨i, rfl⟩, k, rfl⟩
    rcases i.2 with hiS | hiT
    · apply (le_sup_left :
        IntermediateField.adjoin upperEndRationalCoordinateField
            (GaloisForLFunctions.differentialJetSet
              (Set.range fun j : S => analyticPrimeObservableShiftCarrier
                (fun p => f j.1 (x p)) (M j.1) (hM j.1) a)) ≤ _)
      exact IntermediateField.subset_adjoin upperEndRationalCoordinateField _
        ⟨analyticPrimeObservableShiftCarrier
            (fun p => f i.1 (x p)) (M i.1) (hM i.1) a,
          ⟨⟨i.1, hiS⟩, rfl⟩, k, rfl⟩
    · apply (le_sup_right :
        IntermediateField.adjoin upperEndRationalCoordinateField
            (GaloisForLFunctions.differentialJetSet
              (Set.range fun j : T => analyticPrimeObservableShiftCarrier
                (fun p => f j.1 (x p)) (M j.1) (hM j.1) a)) ≤ _)
      exact IntermediateField.subset_adjoin upperEndRationalCoordinateField _
        ⟨analyticPrimeObservableShiftCarrier
            (fun p => f i.1 (x p)) (M i.1) (hM i.1) a,
          ⟨⟨i.1, hiT⟩, rfl⟩, k, rfl⟩

/-- **Actual constraint-Hilbert spectrum over `ℂ(s)`.** In every finite valuation window, the
homogeneous coordinate Hilbert pivots of a tail-densely sampled constraint geometry become an
algebraically independent family of actual meromorphic Dirichlet germs over the genuine coordinate
field. Its exact cardinality is the shift-weighted Hilbert-rank sum. -/
theorem fullConstraintHilbert_actualAnalyticSpectrum_over_coordinate
    {d : ℕ} {σ : Type u} [Fintype σ]
    {A : Fin d → Type u} [∀ r, Fintype (A r)] [∀ r, DecidableEq (A r)]
    (x : Nat.Primes → σ → ℂ) (K : Set (σ → ℂ))
    (hx : CofiniteTailDenseOn x K)
    (M : ∀ r, fullConstraintHilbertIndex K (r + 1) → ℝ)
    (hM : ∀ r j p,
