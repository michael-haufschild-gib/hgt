import GaloisForLFunctions.HTGeometry.CanonicalFreeInterventionPresentation
import Mathlib.Tactic

/-!
# Free observed two-fields and universal route representations

The flat quotient of an intervention grammar classifies only boundary-annihilating readouts. A
general route may carry a source rewrite boundary to a nonzero target rewrite boundary. This file
keeps the two chain levels and proves the correct universal property.

Maps of primitive rewrite generators, history generators, and observers extend to exactly one
route morphism if and only if the primitive boundary and observer squares commute. Two linear
defect fields measure failure of those squares. Every complete defect is reconstructed exactly as
the finite linear combination of primitive defects, so there is no hidden higher linear coherence
obstruction.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe uk ui ur uo ud₂ ud₁ uu

/-- An algebraic two-term intervention field with an information-neutral observer. -/
structure LinearObservedTwoField
    (k : Type uk) (C₂ : Type ud₂) (C₁ : Type ud₁) (O : Type uu)
    [Field k] [AddCommGroup C₂] [Module k C₂]
    [AddCommGroup C₁] [Module k C₁]
    [AddCommGroup O] [Module k O] where
  /-- Boundary of a legal rewrite chain. -/
  boundary : C₂ →ₗ[k] C₁
  /-- Observable report of a history. -/
  observer : C₁ →ₗ[k] O
  /-- Every legal rewrite boundary is observer-neutral. -/
  observer_boundary : observer.comp boundary = 0

namespace LinearObservedTwoField

variable {k : Type uk} [Field k]
    {C₂ : Type ud₂} {C₁ : Type ud₁} {O : Type uu}
    [AddCommGroup C₂] [Module k C₂]
    [AddCommGroup C₁] [Module k C₁]
    [AddCommGroup O] [Module k O]

/-- A chain-level route representation preserving rewrite boundary and observation. -/
structure Hom
    {D₂ : Type*} {D₁ : Type*} {U : Type*}
    [AddCommGroup D₂] [Module k D₂]
    [AddCommGroup D₁] [Module k D₁]
    [AddCommGroup U] [Module k U]
    (P : LinearObservedTwoField k C₂ C₁ O)
    (Q : LinearObservedTwoField k D₂ D₁ U) where
  /-- Image of rewrite chains. -/
  faceMap : C₂ →ₗ[k] D₂
  /-- Image of histories. -/
  historyMap : C₁ →ₗ[k] D₁
  /-- Image of observer reports. -/
  observerMap : O →ₗ[k] U
  /-- The route transports source boundaries to target boundaries. -/
  boundary_natural : historyMap.comp P.boundary = Q.boundary.comp faceMap
  /-- The route transports source observations to target observations. -/
  observer_natural : observerMap.comp P.observer = Q.observer.comp historyMap

end LinearObservedTwoField

namespace LinearInterventionGrammar

variable {k : Type uk} {I : Type ui} {R : Type ur} {O : Type uo}
    [Field k] [AddCommGroup O] [Module k O]

/-- The unquotiented free observed two-field generated by an intervention grammar. -/
def freeObservedTwoField (G : LinearInterventionGrammar k I R O) :
    LinearObservedTwoField k G.Faces G.History O where
  boundary := G.boundary
  observer := G.observer
  observer_boundary := G.observer_boundary

variable {D₂ : Type ud₂} {D₁ : Type ud₁} {U : Type uu}
    [AddCommGroup D₂] [Module k D₂]
    [AddCommGroup D₁] [Module k D₁]
    [AddCommGroup U] [Module k U]
    (G : LinearInterventionGrammar k I R O)
    (Q : LinearObservedTwoField k D₂ D₁ U)

/-- Primitive data for a route, including target witnesses for every source rewrite. -/
structure GeneratorRouteData where
  /-- Target rewrite witness for each primitive source rewrite. -/
  faceGenerator : R → D₂
  /-- Target history for each primitive source intervention. -/
  historyGenerator : I → D₁
  /-- Transport of observer reports. -/
  observerMap : O →ₗ[k] U
  /-- Primitive boundary square. -/
  boundary_generator : ∀ r,
    Finsupp.linearCombination k historyGenerator (G.relation r) =
      Q.boundary (faceGenerator r)
  /-- Primitive observer square. -/
  observer_generator : ∀ i,
    observerMap (G.generatorObserver i) = Q.observer (historyGenerator i)

/-- Free linear extension of the target rewrite witnesses. -/
def GeneratorRouteData.faceLinear (A : GeneratorRouteData G Q) : G.Faces →ₗ[k] D₂ :=
  Finsupp.linearCombination k A.faceGenerator

/-- Free linear extension of the target histories. -/
def GeneratorRouteData.historyLinear (A : GeneratorRouteData G Q) : G.History →ₗ[k] D₁ :=
  Finsupp.linearCombination k A.historyGenerator

/-- Primitive boundary compatibility reconstructs the complete boundary square. -/
theorem GeneratorRouteData.boundary_natural (A : GeneratorRouteData G Q) :
    A.historyLinear.comp G.boundary = Q.boundary.comp A.faceLinear := by
  apply Finsupp.lhom_ext'
  intro r
  apply LinearMap.ext
  intro c
  simp [GeneratorRouteData.historyLinear, GeneratorRouteData.faceLinear,
    LinearInterventionGrammar.boundary, A.boundary_generator]

/-- Primitive observer compatibility reconstructs the complete observer square. -/
theorem GeneratorRouteData.observer_natural (A : GeneratorRouteData G Q) :
    A.observerMap.comp G.observer = Q.observer.comp A.historyLinear := by
  apply Finsupp.lhom_ext'
  intro i
  apply LinearMap.ext
  intro c
  simp [GeneratorRouteData.historyLinear, LinearInterventionGrammar.observer,
    A.observer_generator]

/-- The chain-level route generated by primitive compatible data. -/
def GeneratorRouteData.toHom (A : GeneratorRouteData G Q) :
    (G.freeObservedTwoField).Hom Q where
  faceMap := A.faceLinear
  historyMap := A.historyLinear
  observerMap := A.observerMap
  boundary_natural := A.boundary_natural
  observer_natural := A.observer_natural

/-- A linear map from a free finitely supported module is determined by coefficient-one
generators. -/
theorem linearMap_eq_linearCombination_of_single
    {J : Type*} {W : Type*} [AddCommGroup W] [Module k W]
    (F : (J →₀ k) →ₗ[k] W) (φ : J → W)
    (hF : ∀ j, F (Finsupp.single j 1) = φ j) :
    F = Finsupp.linearCombination k φ := by
  apply Finsupp.lhom_ext'
  intro j
  apply LinearMap.ext
  intro c
  have hs : Finsupp.single j c = c • Finsupp.single j (1 : k) := by
    ext x
    simp
  change F (Finsupp.single j c) =
    Finsupp.linearCombination k φ (Finsupp.single j c)
  rw [hs, map_smul, map_smul, hF j]
  simp

/-- A route morphism has the prescribed primitive generator data. -/
def ExtendsGeneratorRouteData (A : GeneratorRouteData G Q)
    (F : (G.freeObservedTwoField).Hom Q) : Prop :=
  (∀ r, F.faceMap (Finsupp.single r 1) = A.faceGenerator r) ∧
  (∀ i, F.historyMap (Finsupp.single i 1) = A.historyGenerator i) ∧
  F.observerMap = A.observerMap

/-- The generated route extends all three primitive data layers. -/
theorem GeneratorRouteData.toHom_extends (A : GeneratorRouteData G Q) :
    ExtendsGeneratorRouteData G Q A A.toHom := by
  constructor
  · intro r
    simp [GeneratorRouteData.toHom, GeneratorRouteData.faceLinear]
  constructor
  · intro i
    simp [GeneratorRouteData.toHom, GeneratorRouteData.historyLinear]
  · rfl

/-- Any route extending the same rewrite, history, and observer generators is the generated route. -/
theorem GeneratorRouteData.toHom_unique (A : GeneratorRouteData G Q)
    (F : (G.freeObservedTwoField).Hom Q)
    (hF : ExtendsGeneratorRouteData G Q A F) :
    F = A.toHom := by
  have hface : F.faceMap = A.faceLinear :=
    linearMap_eq_linearCombination_of_single F.faceMap A.faceGenerator hF.1
  have hhistory : F.historyMap = A.historyLinear :=
    linearMap_eq_linearCombination_of_single F.historyMap A.historyGenerator hF.2.1
  have hobserver : F.observerMap = A.observerMap := hF.2.2
  cases F
  simp_all [GeneratorRouteData.toHom]

/-- Compatible primitive data generate exactly one route morphism. -/
theorem GeneratorRouteData.existsUnique_hom (A : GeneratorRouteData G Q) :
    ∃! F : (G.freeObservedTwoField).Hom Q,
      ExtendsGeneratorRouteData G Q A F := by
  exact ⟨A.toHom, A.toHom_extends,
    fun F hF => GeneratorRouteData.toHom_unique G Q A F hF⟩

/-- The two primitive commutative-square tests for proposed route generator assignments. -/
def GeneratorSquares
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U) : Prop :=
  (∀ r, Finsupp.linearCombination k historyGenerator (G.relation r) =
    Q.boundary (faceGenerator r)) ∧
  (∀ i, observerMap (G.generatorObserver i) = Q.observer (historyGenerator i))

/-- A route morphism extends three separately specified generator assignments. -/
def ExtendsGeneratorAssignments
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U)
    (F : (G.freeObservedTwoField).Hom Q) : Prop :=
  (∀ r, F.faceMap (Finsupp.single r 1) = faceGenerator r) ∧
  (∀ i, F.historyMap (Finsupp.single i 1) = historyGenerator i) ∧
  F.observerMap = observerMap

/-- Failure of one primitive source rewrite to land on the declared target rewrite boundary. -/
def primitiveBoundaryDefect
    (faceGenerator : R → D₂) (historyGenerator : I → D₁) (r : R) : D₁ :=
  Finsupp.linearCombination k historyGenerator (G.relation r) -
    Q.boundary (faceGenerator r)

/-- Failure of one primitive history to commute with observation. -/
def primitiveObserverDefect
    (historyGenerator : I → D₁) (observerMap : O →ₗ[k] U) (i : I) : U :=
  observerMap (G.generatorObserver i) - Q.observer (historyGenerator i)

/-- Complete boundary-naturality defect of proposed route generator assignments. -/
def boundaryDefect
    (faceGenerator : R → D₂) (historyGenerator : I → D₁) : G.Faces →ₗ[k] D₁ :=
  (Finsupp.linearCombination k historyGenerator).comp G.boundary -
    Q.boundary.comp (Finsupp.linearCombination k faceGenerator)

/-- Complete observer-naturality defect of proposed route generator assignments. -/
def observerDefect
    (historyGenerator : I → D₁) (observerMap : O →ₗ[k] U) : G.History →ₗ[k] U :=
  observerMap.comp G.observer -
    Q.observer.comp (Finsupp.linearCombination k historyGenerator)

/-- Complete boundary defect on one weighted rewrite is its weighted primitive defect. -/
theorem boundaryDefect_single
    (faceGenerator : R → D₂) (historyGenerator : I → D₁) (r : R) (c : k) :
    boundaryDefect G Q faceGenerator historyGenerator (Finsupp.single r c) =
      c • primitiveBoundaryDefect G Q faceGenerator historyGenerator r := by
  simp [boundaryDefect, primitiveBoundaryDefect, LinearInterventionGrammar.boundary,
    smul_sub]

/-- Complete observer defect on one weighted history is its weighted primitive defect. -/
theorem observerDefect_single
    (historyGenerator : I → D₁) (observerMap : O →ₗ[k] U) (i : I) (c : k) :
    observerDefect G Q historyGenerator observerMap (Finsupp.single i c) =
      c • primitiveObserverDefect G Q historyGenerator observerMap i := by
  simp [observerDefect, primitiveObserverDefect, LinearInterventionGrammar.observer,
    smul_sub]

/-- **Boundary-defect reconstruction.** Every global rewrite defect is exactly the finite linear
combination of primitive rewrite defects. -/
theorem boundaryDefect_reconstruction
    (faceGenerator : R → D₂) (historyGenerator : I → D₁) (a : G.Faces) :
    boundaryDefect G Q faceGenerator historyGenerator a =
      Finsupp.linearCombination k
        (primitiveBoundaryDefect G Q faceGenerator historyGenerator) a := by
  congr 1
  apply Finsupp.lhom_ext'
  intro r
  apply LinearMap.ext
  intro c
  simp [boundaryDefect_single]

/-- **Observer-defect reconstruction.** Every global observation defect is exactly the finite
linear combination of primitive observation defects. -/
theorem observerDefect_reconstruction
    (historyGenerator : I → D₁) (observerMap : O →ₗ[k] U) (x : G.History) :
    observerDefect G Q historyGenerator observerMap x =
      Finsupp.linearCombination k
        (primitiveObserverDefect G Q historyGenerator observerMap) x := by
  congr 1
  apply Finsupp.lhom_ext'
  intro i
  apply LinearMap.ext
  intro c
  simp [observerDefect_single]

/-- The complete boundary defect vanishes exactly when every primitive boundary defect vanishes. -/
theorem boundaryDefect_eq_zero_iff
    (faceGenerator : R → D₂) (historyGenerator : I → D₁) :
    boundaryDefect G Q faceGenerator historyGenerator = 0 ↔
      ∀ r, primitiveBoundaryDefect G Q faceGenerator historyGenerator r = 0 := by
  constructor
  · intro h r
    have hr := congrArg
      (fun F : G.Faces →ₗ[k] D₁ => F (Finsupp.single r 1)) h
    simpa [boundaryDefect_single] using hr
  · intro h
    apply LinearMap.ext
    intro a
    rw [boundaryDefect_reconstruction]
    have hz : primitiveBoundaryDefect G Q faceGenerator historyGenerator = 0 :=
      funext h
    rw [hz]
    simp

/-- The complete observer defect vanishes exactly when every primitive observer defect vanishes. -/
theorem observerDefect_eq_zero_iff
    (historyGenerator : I → D₁) (observerMap : O →ₗ[k] U) :
    observerDefect G Q historyGenerator observerMap = 0 ↔
      ∀ i, primitiveObserverDefect G Q historyGenerator observerMap i = 0 := by
  constructor
  · intro h i
    have hi := congrArg
      (fun F : G.History →ₗ[k] U => F (Finsupp.single i 1)) h
    simpa [observerDefect_single] using hi
  · intro h
    apply LinearMap.ext
    intro x
    rw [observerDefect_reconstruction]
    have hz : primitiveObserverDefect G Q historyGenerator observerMap = 0 :=
      funext h
    rw [hz]
    simp

/-- Every route representation forces both primitive generator squares. -/
theorem generatorSquares_of_hom
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U)
    (F : (G.freeObservedTwoField).Hom Q)
    (hF : ExtendsGeneratorAssignments G Q faceGenerator historyGenerator observerMap F) :
    GeneratorSquares G Q faceGenerator historyGenerator observerMap := by
  have hface : F.faceMap = Finsupp.linearCombination k faceGenerator :=
    linearMap_eq_linearCombination_of_single F.faceMap faceGenerator hF.1
  have hhistory : F.historyMap = Finsupp.linearCombination k historyGenerator :=
    linearMap_eq_linearCombination_of_single F.historyMap historyGenerator hF.2.1
  constructor
  · intro r
    have hnat := congrArg
      (fun T : G.Faces →ₗ[k] D₁ => T (Finsupp.single r 1)) F.boundary_natural
    simp only [LinearMap.comp_apply] at hnat
    rw [hhistory, hface] at hnat
    simpa [freeObservedTwoField, LinearInterventionGrammar.boundary] using hnat
  · intro i
    have hnat := congrArg
      (fun T : G.History →ₗ[k] U => T (Finsupp.single i 1)) F.observer_natural
    simp only [LinearMap.comp_apply] at hnat
    rw [hhistory, hF.2.2] at hnat
    simpa [freeObservedTwoField, LinearInterventionGrammar.observer] using hnat

/-- Primitive boundary and observer squares are necessary and sufficient for exactly one route
representation extending the prescribed generator assignments. -/
theorem existsUnique_routeRepresentation_iff_generatorSquares
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U) :
    (∃! F : (G.freeObservedTwoField).Hom Q,
      ExtendsGeneratorAssignments G Q faceGenerator historyGenerator observerMap F) ↔
    GeneratorSquares G Q faceGenerator historyGenerator observerMap := by
  constructor
  · rintro ⟨F, hF, _⟩
    exact generatorSquares_of_hom G Q faceGenerator historyGenerator observerMap F hF
  · rintro ⟨hboundary, hobserver⟩
    let A : GeneratorRouteData G Q := {
      faceGenerator := faceGenerator
      historyGenerator := historyGenerator
      observerMap := observerMap
      boundary_generator := hboundary
      observer_generator := hobserver
    }
    have hA := A.existsUnique_hom
    simpa [ExtendsGeneratorRouteData, ExtendsGeneratorAssignments, A] using hA

/-- Primitive generator squares are equivalent to vanishing of both complete defect fields. -/
theorem generatorSquares_iff_defects_zero
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U) :
    GeneratorSquares G Q faceGenerator historyGenerator observerMap ↔
      boundaryDefect G Q faceGenerator historyGenerator = 0 ∧
      observerDefect G Q historyGenerator observerMap = 0 := by
  constructor
  · rintro ⟨hboundary, hobserver⟩
    constructor
    · apply (boundaryDefect_eq_zero_iff G Q faceGenerator historyGenerator).2
      intro r
      exact sub_eq_zero.mpr (hboundary r)
    · apply (observerDefect_eq_zero_iff G Q historyGenerator observerMap).2
      intro i
      exact sub_eq_zero.mpr (hobserver i)
  · rintro ⟨hboundary, hobserver⟩
    constructor
    · intro r
      exact sub_eq_zero.mp
        ((boundaryDefect_eq_zero_iff G Q faceGenerator historyGenerator).1 hboundary r)
    · intro i
      exact sub_eq_zero.mp
        ((observerDefect_eq_zero_iff G Q historyGenerator observerMap).1 hobserver i)

/-- **Universal chain-level route law.** Exactly one route representation exists precisely when
both complete defect fields vanish. -/
theorem freeObservedTwoField_routeRepresentation_capstone
    (faceGenerator : R → D₂) (historyGenerator : I → D₁)
    (observerMap : O →ₗ[k] U) :
    (∃! F : (G.freeObservedTwoField).Hom Q,
      ExtendsGeneratorAssignments G Q faceGenerator historyGenerator observerMap F) ↔
      boundaryDefect G Q faceGenerator historyGenerator = 0 ∧
      observerDefect G Q historyGenerator observerMap = 0 := by
  rw [existsUnique_routeRepresentation_iff_generatorSquares,
    generatorSquares_iff_defects_zero]

end LinearInterventionGrammar

end

end GaloisForLFunctions.HTGeometry
