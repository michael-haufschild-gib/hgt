import GaloisForLFunctions.HTGeometry.RadicalBaseChangeCapstone
import GaloisForLFunctions.HTGeometry.SplittingFieldCompositum

/-!
# The ambient field is a splitting field of one factor over the root field of the other

The splitting field of a product is generated by the roots of the two factors, so over the field
generated by the roots of one factor it is generated by the roots of the other.

Together with the roots being algebraic, that makes it a splitting field of the first factor over
the root field of the second — the form in which a base change statement can be read.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F L : Type*} [Field F] [Field L] [Algebra F L]

theorem rootSet_map_rootField {p q : Polynomial F} :
    (p.map (algebraMap F (rootField F (L := L) q))).rootSet L = p.rootSet L := by
  simp only [Polynomial.rootSet, Polynomial.aroots, Polynomial.map_map,
    ← IsScalarTower.algebraMap_eq]

theorem map_rootField_ne_zero {p : Polynomial F} (hp : p ≠ 0) (q : Polynomial F) :
    p.map (algebraMap F (rootField F (L := L) q)) ≠ 0 := fun h =>
  hp ((Polynomial.map_eq_zero_iff
    (algebraMap F (rootField F (L := L) q)).injective).1 h)

theorem separable_map_rootField {p : Polynomial F} (hsep : p.Separable) (q : Polynomial F) :
    (p.map (algebraMap F (rootField F (L := L) q))).Separable :=
  Polynomial.Separable.map (f := algebraMap F (rootField F (L := L) q)) hsep

/-- **The ambient field is a splitting field of one factor over the root field of the other.** -/
theorem isSplittingField_over_rootField {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    Polynomial.IsSplittingField (rootField F (L := L) q) L
      (p.map (algebraMap F (rootField F (L := L) q))) := by
  have hsplitAll := Polynomial.IsSplittingField.splits' (K := F) (L := L) (f := p * q)
  have hsplitp := splits_of_splits_mul_left (L := L) hp hq hsplitAll
  constructor
  · have h : Polynomial.map (algebraMap F L) p =
        Polynomial.map (algebraMap (rootField F (L := L) q) L)
          (Polynomial.map (algebraMap F (rootField F (L := L) q)) p) := by
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    rwa [h] at hsplitp
  · have hadj : IntermediateField.adjoin (rootField F (L := L) q) (p.rootSet L) = ⊤ := by
      refine IntermediateField.restrictScalars_injective F ?_
      rw [IntermediateField.restrictScalars_top]
      refine le_antisymm le_top ?_
      rw [← sup_adjoin_rootSet_eq_top (L := L) hp hq]
      refine sup_le ?_ ?_
      · rw [IntermediateField.adjoin_le_iff]
        exact IntermediateField.subset_adjoin _ _
      · intro x hx
        exact (IntermediateField.adjoin (rootField F (L := L) q) (p.rootSet L)).algebraMap_mem
          (⟨x, hx⟩ : rootField F (L := L) q)
    have halg : ∀ x ∈ (p.map (algebraMap F (rootField F (L := L) q))).rootSet L,
        IsAlgebraic (rootField F (L := L) q) x := by
      intro x hx
      rw [Polynomial.mem_rootSet] at hx
      exact ⟨_, hx.1, hx.2⟩
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg, rootSet_map_rootField, hadj]
    exact IntermediateField.top_toSubalgebra

end GaloisForLFunctions.HTGeometry
