import GaloisForLFunctions.HTGeometry.ManinMapQuotientCoordinates
import GaloisForLFunctions.HTGeometry.AbelianTailUniversalScaling

/-!
# The Manin horizon is universal

Assembling the three steps of the multiplication-tail theorem for two Abelian varieties of the
same dimension over two differential function fields:

* the stable intersection of the tower of torsion-translation fixed fields is the field fixed by
  the Kolchin closure of the primary torsion, hence by the Manin kernel;
* that field is the differential field generated by the Manin coordinates;
* if those coordinates are differentially independent, the field carries the canonical
  multiplication-by-`m` automorphism and, together with it, is isomorphic to the corresponding
  object built from any other Abelian variety with the same number of Manin coordinates.

The result is a no-hair statement: the abstract multiplication tail with its scaling dynamics sees
only the rank and the integer `m`.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {ι ι' κ K : Type*} [Field K] [Differential K]

/-- **The full Abelian no-hair theorem.**  Two multiplication towers whose Manin coordinate
families have the same index type produce the same differential field with the same
multiplication-by-`m` dynamics. -/
theorem multiplicationTail_noHair_of_maninCoordinates
    {L L' : Type*} [Field L] [Algebra K L] [Differential L] [DifferentialAlgebra K L]
    [Field L'] [Algebra K L'] [Differential L'] [DifferentialAlgebra K L']
    (translation : (ι → K) → DifferentialAlgEquiv K L)
    (T : ι' → Set (ι → K)) (Asharp : Set (ι → K)) (mu : κ → L)
    (hstab : ∀ z : L, IsKolchinClosedOver K {a : ι → K | (translation a).toAlgEquiv z = z})
    (hAclosed : IsKolchinClosedOver K Asharp)
    (hTA : ∀ n, T n ⊆ Asharp)
    (hmin : ∀ H : Set (ι → K), IsKolchinClosedOver K H → ZariskiDenseOver K H → Asharp ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, T n))
    (hinv : ∀ a ∈ Asharp, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ Asharp, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu))
    (translation' : (ι → K) → DifferentialAlgEquiv K L')
    (T' : ι' → Set (ι → K)) (Asharp' : Set (ι → K)) (mu' : κ → L')
    (hstab' : ∀ z : L', IsKolchinClosedOver K {a : ι → K | (translation' a).toAlgEquiv z = z})
    (hAclosed' : IsKolchinClosedOver K Asharp')
    (hTA' : ∀ n, T' n ⊆ Asharp')
    (hmin' : ∀ H : Set (ι → K), IsKolchinClosedOver K H → ZariskiDenseOver K H → Asharp' ⊆ H)
    (hdense' : ZariskiDenseOver K (⋃ n, T' n))
    (hinv' : ∀ a ∈ Asharp', ∀ j, (translation' a).toAlgEquiv (mu' j) = mu' j)
    (hquot' : ∀ z : L', (∀ a ∈ Asharp', (translation' a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu'))
    (hfree : DifferentialIndependent K mu) (hfree' : DifferentialIndependent K mu')
    (m : ℤ) (hm : (m : K) ≠ 0) :
    (⨅ n, differentialTranslationFixedField translation (T n))
        = differentialAdjoin K (Set.range mu) ∧
      (⨅ n, differentialTranslationFixedField translation' (T' n))
        = differentialAdjoin K (Set.range mu') ∧
      ∃ Φ : differentialAdjoin K (Set.range mu) ≃ₐ[K] differentialAdjoin K (Set.range mu'),
        (∀ z, Φ z′ = (Φ z)′) ∧
        (∀ j, Φ ⟨mu j, subset_differentialAdjoin K (Set.range mu) (Set.mem_range_self j)⟩ =
          ⟨mu' j, subset_differentialAdjoin K (Set.range mu') (Set.mem_range_self j)⟩) ∧
        (∀ z, Φ (multiplicationTailScaling mu hfree m hm z) =
          multiplicationTailScaling mu' hfree' m hm (Φ z)) := by
  refine ⟨?_, ?_, ?_⟩
  · exact iInf_differentialTranslationFixedField_eq_maninCoordinateField translation T Asharp mu
      hstab hAclosed hTA hmin hdense hinv hquot
  · exact iInf_differentialTranslationFixedField_eq_maninCoordinateField translation' T' Asharp'
      mu' hstab' hAclosed' hTA' hmin' hdense' hinv' hquot'
  · exact multiplicationTail_noHair mu mu' hfree hfree' m hm

end

end GaloisForLFunctions.HTGeometry
