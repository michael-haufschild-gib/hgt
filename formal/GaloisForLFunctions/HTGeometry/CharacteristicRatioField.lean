import GaloisForLFunctions.HTGeometry.CrossRelationDescentRelation

/-!
# The characteristic descends to the field of its coefficient ratios

Dividing a characteristic relation by one of its nonzero coefficients leaves a relation whose
coefficients are ratios of the original ones.  Those ratios generate an intermediate field, and the
normalized relation descends to it.

So the field generated by the coefficient ratios already carries a relation of the free element —
which is the object a Lüroth conclusion must identify with the whole intermediate field.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- The set of coefficient ratios of a relation, taken against a fixed coefficient. -/
def characteristicRatioSet (G : IntermediateField F E) (P : DifferentialPolynomial Unit G)
    (n : (Unit × ℕ) →₀ ℕ) : Set E :=
  Set.range fun m : (Unit × ℕ) →₀ ℕ => ((P.coeff m / P.coeff n : G) : E)

/-- The intermediate field generated by the coefficient ratios. -/
def characteristicRatioField (G : IntermediateField F E) (P : DifferentialPolynomial Unit G)
    (n : (Unit × ℕ) →₀ ℕ) : IntermediateField F E :=
  IntermediateField.adjoin F (characteristicRatioSet G P n)

theorem characteristicRatioField_le (G : IntermediateField F E)
    (P : DifferentialPolynomial Unit G) (n : (Unit × ℕ) →₀ ℕ) :
    characteristicRatioField G P n ≤ G := by
  refine IntermediateField.adjoin_le_iff.2 ?_
  rintro x ⟨m, rfl⟩
  exact (P.coeff m / P.coeff n).2

/-- **The normalized characteristic has its coefficients in the ratio field.** -/
theorem coeff_normalized_mem_ratioField (G : IntermediateField F E)
    (P : DifferentialPolynomial Unit G) (n m : (Unit × ℕ) →₀ ℕ) :
    (((MvPolynomial.C (P.coeff n)⁻¹ * P).coeff m : G) : E)
      ∈ characteristicRatioField G P n := by
  have hcoeff : ((MvPolynomial.C (P.coeff n)⁻¹ * P).coeff m : G)
      = P.coeff m / P.coeff n := by
    rw [MvPolynomial.coeff_C_mul]
    field_simp
  rw [hcoeff]
  exact IntermediateField.subset_adjoin F _ ⟨m, rfl⟩

/-- **The normalized characteristic descends to the ratio field.** -/
theorem map_descend_normalized (G : IntermediateField F E)
    (P : DifferentialPolynomial Unit G) (n : (Unit × ℕ) →₀ ℕ) :
    MvPolynomial.map
        (IntermediateField.inclusion (characteristicRatioField_le G P n) :
          characteristicRatioField G P n →ₐ[F] G).toRingHom
        (HTGeometry.descendCoefficients (characteristicRatioField_le G P n)
          (MvPolynomial.C (P.coeff n)⁻¹ * P) (coeff_normalized_mem_ratioField G P n))
      = MvPolynomial.C (P.coeff n)⁻¹ * P :=
  HTGeometry.map_descendCoefficients _ _ _

/-! ### The differential field generated by the ratios -/

variable [Differential E]

/-- The differential field generated by the coefficient ratios: the object a Lüroth conclusion
identifies with the intermediate field. -/
def characteristicDifferentialRatioField (G : IntermediateField F E)
    (P : DifferentialPolynomial Unit G) (n : (Unit × ℕ) →₀ ℕ) : IntermediateField F E :=
  differentialAdjoin F (characteristicRatioSet G P n)

theorem characteristicDifferentialRatioField_le (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) (P : DifferentialPolynomial Unit G)
    (n : (Unit × ℕ) →₀ ℕ) :
    characteristicDifferentialRatioField G P n ≤ G := by
  refine differentialAdjoin_le F ?_ hGclosed
  rintro x ⟨m, rfl⟩
  exact (P.coeff m / P.coeff n).2

/-- **The normalized characteristic has its coefficients in the differential ratio field.** -/
theorem coeff_normalized_mem_differentialRatioField (G : IntermediateField F E)
    (P : DifferentialPolynomial Unit G) (n m : (Unit × ℕ) →₀ ℕ) :
    (((MvPolynomial.C (P.coeff n)⁻¹ * P).coeff m : G) : E)
      ∈ characteristicDifferentialRatioField G P n := by
  have hcoeff : ((MvPolynomial.C (P.coeff n)⁻¹ * P).coeff m : G)
      = P.coeff m / P.coeff n := by
    rw [MvPolynomial.coeff_C_mul]
    field_simp
  rw [hcoeff]
  exact subset_differentialAdjoin F _ ⟨m, rfl⟩

/-- **The descended normalized characteristic is a relation over the differential ratio field.** -/
theorem descend_normalized_mem_relationIdeal (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) {y : E} (P : DifferentialPolynomial Unit G)
    (hP : P ∈ differentialIntermediateRelationIdeal G y) (n : (Unit × ℕ) →₀ ℕ) :
    HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n)
      ∈ differentialIntermediateRelationIdeal
        (characteristicDifferentialRatioField G P n) y := by
  rw [mem_differentialIntermediateRelationIdeal_iff]
  have hmap := differentialPolynomialEvalOver_map_inclusion
    (characteristicDifferentialRatioField_le G hGclosed P n) y
    (HTGeometry.descendCoefficients
      (characteristicDifferentialRatioField_le G hGclosed P n)
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n))
  rw [HTGeometry.map_descendCoefficients] at hmap
  rw [← hmap]
  exact Ideal.mul_mem_left _ _ hP

end

end GaloisForLFunctions
