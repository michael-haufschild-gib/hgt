import GaloisForLFunctions.HTGeometry.MilnorKTwoWeylAction
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Milnor's common sign-diagonal subgroup

This file classifies the subgroup `H₀ ≤ H` generated by the elements `hᵢⱼ(-1)`.  Intrinsically,
its diagonal coordinates are signs and its central coordinate is an integral multiple of
`{-1,-1}`.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {F : Type*} [Field F]

namespace MilnorDiagonalExtension

def fin4MinusOneSymbol (F : Type*) [Field F] : MilnorKDeg F 2 :=
  milnorSym2 F (-1 : Fˣ) (-1 : Fˣ)

theorem fin4MinusOneSymbol_mem_zmultiples :
    fin4MinusOneSymbol F ∈ AddSubgroup.zmultiples (fin4MinusOneSymbol F) := by
  rw [AddSubgroup.mem_zmultiples_iff]
  exact ⟨1, by simp⟩

theorem milnorDiagonalCocycle_mem_minusOne_zmultiples
    (u v : detOneDiagonalUnits F 4)
    (hu : ∀ i, u.1 i = 1 ∨ u.1 i = -1)
    (hv : ∀ i, v.1 i = 1 ∨ v.1 i = -1) :
    milnorDiagonalCocycle u v ∈ AddSubgroup.zmultiples (fin4MinusOneSymbol F) := by
  unfold milnorDiagonalCocycle
  apply AddSubgroup.sum_mem
  intro i hi
  apply AddSubgroup.sum_mem
  intro j hj
  by_cases hji : j ≤ i
  · simp only [hji, ↓reduceIte]
    rcases hu i with hui | hui <;> rcases hv j with hvj | hvj
    · simp [hui, hvj, milnorSym2_one_left]
    · simp [hui, hvj, milnorSym2_one_left]
    · simp [hui, hvj, milnorSym2_one_right]
    · rw [hui, hvj]
      exact fin4MinusOneSymbol_mem_zmultiples (F := F)
  · simp [hji]

/-- Intrinsic candidate for Milnor's `H₀`: sign diagonal and cyclic central coordinate. -/
def fin4MilnorSignSubgroup : Subgroup (MilnorDiagonalExtension F 4) where
  carrier := {x | (∀ i, x.diag.1 i = 1 ∨ x.diag.1 i = -1)
    ∧ x.central ∈ AddSubgroup.zmultiples (fin4MinusOneSymbol F)}
  one_mem' := by
    constructor
    · intro i
      left
      rfl
    · simp
  mul_mem' := by
    intro x y hx hy
    constructor
    · intro i
      rcases hx.1 i with hxi | hxi <;> rcases hy.1 i with hyi | hyi
      · left; simp [hxi, hyi]
      · right; simp [hxi, hyi]
      · right; simp [hxi, hyi]
      · left; simp [hxi, hyi]
    · exact (AddSubgroup.zmultiples (fin4MinusOneSymbol F)).add_mem
        ((AddSubgroup.zmultiples (fin4MinusOneSymbol F)).add_mem hx.2 hy.2)
        (milnorDiagonalCocycle_mem_minusOne_zmultiples x.diag y.diag hx.1 hy.1)
  inv_mem' := by
    intro x hx
    constructor
    · intro i
      rcases hx.1 i with hxi | hxi
      · left; simp [hxi]
      · right; simp [hxi]
    · exact (AddSubgroup.zmultiples (fin4MinusOneSymbol F)).sub_mem
        ((AddSubgroup.zmultiples (fin4MinusOneSymbol F)).neg_mem hx.2)
        (milnorDiagonalCocycle_mem_minusOne_zmultiples x.diag⁻¹ x.diag
          (by
            intro i
            rcases hx.1 i with hxi | hxi
            · left; simp [hxi]
            · right; simp [hxi]) hx.1)

/-- Subgroup generated by Milnor's canonical `hᵢⱼ(-1)` elements. -/
def fin4MilnorH0 : Subgroup (MilnorDiagonalExtension F 4) :=
  Subgroup.closure {x | ∃ (i j : Fin 4) (hij : i ≠ j),
    x = fin4MatsumotoDiagonalLift hij (-1 : Fˣ)}

theorem fin4MatsumotoDiagonalLift_neg_one_mem_signSubgroup
    {i j : Fin 4} (hij : i ≠ j) :
    fin4MatsumotoDiagonalLift hij (-1 : Fˣ) ∈ fin4MilnorSignSubgroup (F := F) := by
  constructor
  · intro k
    by_cases hki : k = i
    · subst k
      right
      simp [fin4MatsumotoDiagonalLift, fin4MatsumotoDiagonal, hij]
    · by_cases hkj : k = j
      · subst k
        right
        simp [fin4MatsumotoDiagonalLift, fin4MatsumotoDiagonal, hki]
      · left
        simp [fin4MatsumotoDiagonalLift, fin4MatsumotoDiagonal, hki, hkj]
  · by_cases hlt : i < j
    · simp [fin4MatsumotoDiagonalLift, hlt]
    · simp only [fin4MatsumotoDiagonalLift, hlt, ↓reduceIte]
      change fin4MinusOneSymbol F ∈ AddSubgroup.zmultiples (fin4MinusOneSymbol F)
      exact fin4MinusOneSymbol_mem_zmultiples (F := F)

theorem fin4MilnorH0_le_signSubgroup :
    fin4MilnorH0 (F := F) ≤ fin4MilnorSignSubgroup (F := F) := by
  refine (Subgroup.closure_le _).2 ?_
  rintro x ⟨i, j, hij, rfl⟩
  exact fin4MatsumotoDiagonalLift_neg_one_mem_signSubgroup hij

@[simp]
theorem fin4MatsumotoDiagonalLift_one {i j : Fin 4} (hij : i ≠ j) :
    fin4MatsumotoDiagonalLift hij (1 : Fˣ) = 1 := by
  apply MilnorDiagonalExtension.ext
  · apply Subtype.ext
    funext k
    simp [fin4MatsumotoDiagonalLift, fin4MatsumotoDiagonal]
  · simp [fin4MatsumotoDiagonalLift, milnorSym2_one_left]

theorem fin4MatsumotoDiagonalLift_of_sign_mem_H0 {i j : Fin 4}
    (hij : i ≠ j) (u : Fˣ) (hu : u = 1 ∨ u = -1) :
    fin4MatsumotoDiagonalLift hij u ∈ fin4MilnorH0 (F := F) := by
  rcases hu with rfl | rfl
  · rw [fin4MatsumotoDiagonalLift_one]
    exact Subgroup.one_mem _
  · exact Subgroup.subset_closure ⟨i, j, hij, rfl⟩

/-- Canonical common-subgroup element `hᵢⱼ(u)` for a sign `u ∈ {±1}`. -/
def fin4MilnorH0RootLift {i j : Fin 4} (hij : i ≠ j)
    (u : Fˣ) (hu : u = 1 ∨ u = -1) : fin4MilnorH0 (F := F) :=
  ⟨fin4MatsumotoDiagonalLift hij u,
    fin4MatsumotoDiagonalLift_of_sign_mem_H0 hij u hu⟩

theorem centralIncl_minusOneSymbol_mem_H0 :
    centralIncl (F := F) (n := 4)
        (Multiplicative.ofAdd (fin4MinusOneSymbol F))
      ∈ fin4MilnorH0 (F := F) := by
  let h01 : (0 : Fin 4) ≠ 1 := by decide
  have hh : fin4MatsumotoDiagonalLift h01 (-1 : Fˣ)
      ∈ fin4MilnorH0 (F := F) :=
    Subgroup.subset_closure ⟨0, 1, h01, rfl⟩
  have hsq := (fin4MilnorH0 (F := F)).mul_mem hh hh
  have heq : fin4MatsumotoDiagonalLift h01 (-1 : Fˣ)
        * fin4MatsumotoDiagonalLift h01 (-1 : Fˣ)
      = centralIncl (F := F) (n := 4)
          (Multiplicative.ofAdd (fin4MinusOneSymbol F)) := by
    simpa [fin4MinusOneSymbol] using
      (fin4MatsumotoDiagonalLift_mul h01 (-1 : Fˣ) (-1 : Fˣ))
  rwa [heq] at hsq

theorem centralIncl_mem_H0_of_mem_zmultiples {a : MilnorKDeg F 2}
    (ha : a ∈ AddSubgroup.zmultiples (fin4MinusOneSymbol F)) :
    centralIncl (F := F) (n := 4) (Multiplicative.ofAdd a)
      ∈ fin4MilnorH0 (F := F) := by
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
  have hm := (fin4MilnorH0 (F := F)).zpow_mem
    centralIncl_minusOneSymbol_mem_H0 m
  convert hm using 1
  rw [← map_zpow]
  apply congrArg
  apply Multiplicative.ext
  simp

theorem fin4DiagonalLiftProduct_mem_H0_of_mem_signSubgroup
    {x : MilnorDiagonalExtension F 4} (hx : x ∈ fin4MilnorSignSubgroup (F := F)) :
    fin4DiagonalLiftProduct x ∈ fin4MilnorH0 (F := F) := by
  exact (fin4MilnorH0 (F := F)).mul_mem
    ((fin4MilnorH0 (F := F)).mul_mem
      (fin4MatsumotoDiagonalLift_of_sign_mem_H0 (by decide) _ (hx.1 0))
      (fin4MatsumotoDiagonalLift_of_sign_mem_H0 (by decide) _ (hx.1 1)))
    (fin4MatsumotoDiagonalLift_of_sign_mem_H0 (by decide) _ (hx.1 2))

theorem fin4MilnorSignSubgroup_le_H0 :
    fin4MilnorSignSubgroup (F := F) ≤ fin4MilnorH0 (F := F) := by
  intro x hx
  let y := fin4DiagonalLiftProduct x
  have hyH0 : y ∈ fin4MilnorH0 (F := F) :=
    fin4DiagonalLiftProduct_mem_H0_of_mem_signSubgroup hx
  have hySign : y ∈ fin4MilnorSignSubgroup (F := F) :=
    fin4MilnorH0_le_signSubgroup hyH0
  let c := x * y⁻¹
  have hcSign : c ∈ fin4MilnorSignSubgroup (F := F) :=
    (fin4MilnorSignSubgroup (F := F)).mul_mem hx
      ((fin4MilnorSignSubgroup (F := F)).inv_mem hySign)
  have hcdiag : c.diag = 1 := by
    change x.diag * y.diag⁻¹ = 1
    rw [show y.diag = x.diag by exact fin4DiagonalLiftProduct_diag x]
    simp
  have hceq : c = centralIncl (F := F) (n := 4)
      (Multiplicative.ofAdd c.central) := by
    apply MilnorDiagonalExtension.ext
    · simpa using hcdiag
    · rfl
  have hcH0 : c ∈ fin4MilnorH0 (F := F) := by
    rw [hceq]
    exact centralIncl_mem_H0_of_mem_zmultiples hcSign.2
  have hxy : c * y = x := by
    change (x * y⁻¹) * y = x
    group
  rw [← hxy]
  exact (fin4MilnorH0 (F := F)).mul_mem hcH0 hyH0

/-- **Intrinsic classification of Milnor's common subgroup `H₀`.** -/
theorem fin4MilnorH0_eq_signSubgroup :
    fin4MilnorH0 (F := F) = fin4MilnorSignSubgroup (F := F) :=
  le_antisymm fin4MilnorH0_le_signSubgroup fin4MilnorSignSubgroup_le_H0

end MilnorDiagonalExtension

end GaloisForLFunctions.HTGeometry
