import GaloisForLFunctions.HTGeometry.MultiplicativeProtocolLogCurrentTail

/-!
# The multiplicative protocol over an algebraically closed field of constants

Over an algebraically closed coefficient field of characteristic zero with trivial derivation --
the setting of a nonautonomous isogeny protocol -- the multiplicative protocol needs no side
hypotheses at all: every accumulated exponent is realized by a primitive root of unity and every
step is surjective on the coefficient units, so the phase-tail identity, the position--velocity
description of the tail, and the purely expanding collapse to the velocity all hold outright.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open Polynomial

noncomputable section

/-- An algebraically closed field of characteristic zero has a primitive root of unity of every
positive order: the cyclotomic polynomial has positive degree, hence a root. -/
theorem exists_primitiveRoot_of_isAlgClosed (K : Type*) [Field K] [IsAlgClosed K] [CharZero K]
    {n : ℕ} (hn : 0 < n) :
    ∃ ζ : K, IsPrimitiveRoot ζ n := by
  haveI : NeZero ((n : ℕ) : K) := ⟨Nat.cast_ne_zero.mpr hn.ne'⟩
  have hdeg : (cyclotomic n K).degree ≠ 0 := by
    rw [degree_cyclotomic]
    exact_mod_cast (Nat.totient_pos.mpr hn).ne'
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root _ hdeg
  exact ⟨ζ, isRoot_cyclotomic_iff.mp hζ⟩

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E] [CharZero C]

omit [Differential C] [CharZero C] in
/-- Over an algebraically closed field every step of a multiplicative protocol is surjective on the
units, so the reversible-quotient transport applies to it. -/
theorem powerProtocolGroup_surjective [IsAlgClosed C] (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) (j : ℕ) :
    Function.Surjective (powerProtocolGroup C m j) := by
  intro u
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((u : Cˣ) : C) (hm j)
  have hz0 : z ≠ 0 := by
    intro h
    rw [h, zero_pow (hm j).ne'] at hz
    exact (Units.ne_zero u) hz.symm
  refine ⟨Units.mk0 z hz0, ?_⟩
  apply Units.ext
  simpa [powerProtocolGroup] using hz

section

variable {g : E} (hg : DifferentialIndependent C (fun _ : Unit ↦ g))
  (hgen : differentialAdjoin C (Set.range fun _ : Unit ↦ g) = ⊤)

include hg hgen in
/-- **The nonautonomous multiplicative tail over an algebraically closed constant field.**  For a
differentially independent generator of the ambient field and any sequence of positive exponents:

* the tail is the fixed field of the closed erased sector of the scaling action;
* it is generated by a reversible position `g ^ N` together with the velocity `g'/g`;
* if the accumulated exponents are unbounded, the position is erased completely and the tail is the
  velocity field alone -- hypertranscendental, and meeting the rational field of the position only
  in the constants. -/
theorem multiplicativeProtocol_phase_tail_algClosed
    [IsAlgClosed C] [TopologicalSpace Cˣ] [IsTopologicalGroup Cˣ] [DiscreteTopology Cˣ]
    (hconst : ∀ c : C, c′ = 0) (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) (i : ℕ) :
    nonautonomousTail (powerProtocol hg hgen m hm) i =
        IntermediateField.fixedField
          ((erasedClosure (powerProtocolGroup C m) i).map (scaleRep hg hgen)) ∧
      (∃ N : ℕ, nonautonomousTail (powerProtocol hg hgen m hm) i =
        differentialAdjoin C ({g ^ N, Differential.logDeriv g} : Set E)) ∧
      ((∀ B : ℕ, ∃ n : ℕ, B < prefixExponent m i n) →
        nonautonomousTail (powerProtocol hg hgen m hm) i =
            differentialAdjoin C ({Differential.logDeriv g} : Set E) ∧
          HypertranscendentalOver C (Differential.logDeriv g) ∧
          nonautonomousTail (powerProtocol hg hgen m hm) i ⊓
            IntermediateField.adjoin C ({g} : Set E) = ⊥) := by
  have hroot : ∀ n : ℕ, ∃ ζ : C, IsPrimitiveRoot ζ (prefixExponent m i n) := fun n ↦
    exists_primitiveRoot_of_isAlgClosed C (prefixExponent_pos hm i n)
  refine ⟨multiplicativeProtocol_nonautonomousTail_eq_fixedField hg hgen m hm i hroot,
    multiplicativeProtocol_nonautonomousTail_position_velocity hg hgen m hm i hconst hroot,
    fun hunb ↦ ?_⟩
  exact multiplicativeProtocol_nonautonomousTail_velocity_only hg hgen m hm i hconst hroot hunb

end

end

end GaloisForLFunctions.HTGeometry
