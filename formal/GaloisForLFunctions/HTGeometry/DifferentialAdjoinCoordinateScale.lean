import GaloisForLFunctions.HTGeometry.DifferentialAdjoinFiniteSupport
import GaloisForLFunctions.HTGeometry.TorusInvariantField

/-!
# Coordinatewise scaling on differential adjunctions

`TorusScaleAction` already supplies independent coordinate rescaling of an arbitrary freely
generating differential family.  This leaf adds two inverse-limit interfaces: root-of-unity
scalings fix coordinatewise power fields, and global scaling restricts exactly to every generated
subpalette field.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {F E ι : Type u} [Field F] [Field E]
  [Algebra F E] [Differential F] [Differential E]
  [DifferentialAlgebra F E] [CharZero E]

/-- A coordinate scaling by `N`-th roots of unity fixes the differential field generated by all
`N`-th powers. -/
theorem torusScaleEquiv_fixes_powAdjoin
    (x : ι → E) (hx : DifferentialIndependent F x)
    (hgen : differentialAdjoin F (Set.range x) = ⊤)
    (u : ι → Fˣ) (N : ℕ) (hroot : ∀ i, (u i : F) ^ N = 1)
    {z : E} (hz : z ∈ differentialAdjoin F (Set.range fun i ↦ x i ^ N)) :
    torusScaleEquiv hx hgen u z = z := by
  let σ := torusScaleEquiv hx hgen u
  let p : ∀ y : E, y ∈ differentialAdjoin F (Set.range fun i ↦ x i ^ N) → Prop :=
    fun y _ ↦ σ y = y
  change p z hz
  refine IntermediateField.adjoin_induction F (p := p) ?_ ?_ ?_ ?_ ?_ hz
  · rintro y ⟨w, ⟨i, rfl⟩, n, rfl⟩
    show σ (differentialJet n (x i ^ N)) = differentialJet n (x i ^ N)
    induction n with
    | zero =>
        simp only [differentialJet_zero]
        change torusScaleEquiv hx hgen u (x i ^ N) = x i ^ N
        rw [map_pow, torusScaleEquiv_apply, mul_pow, ← map_pow, hroot, map_one, one_mul]
    | succ n ih =>
        rw [differentialJet_succ]
        change torusScaleEquiv hx hgen u (differentialJet n (x i ^ N))′ = _
        rw [torusScaleEquiv_deriv, ih]
  · intro c
    exact σ.commutes c
  · intro a b ha hb hpa hpb
    change σ (a + b) = a + b
    change σ a = a at hpa
    change σ b = b at hpb
    simpa only [map_add] using congrArg₂ (fun q r ↦ q + r) hpa hpb
  · intro a ha hpa
    change σ a⁻¹ = a⁻¹
    change σ a = a at hpa
    simpa only [map_inv₀] using congrArg Inv.inv hpa
  · intro a b ha hb hpa hpb
    change σ (a * b) = a * b
    change σ a = a at hpa
    change σ b = b at hpb
    simpa only [map_mul] using congrArg₂ (fun q r ↦ q * r) hpa hpb

omit [CharZero E] in
/-- Global coordinate scaling restricts to identical coordinate scaling on every freely generated
subpalette field. -/
theorem torusScaleEquiv_restrict_differentialAdjoin
    {k : Type u} (x : ι → E) (hx : DifferentialIndependent F x)
    (hgen : differentialAdjoin F (Set.range x) = ⊤)
    (e : k → ι) (he : Function.Injective e)
    (U : ι → Fˣ) (u : k → Fˣ) (hU : ∀ j, U (e j) = u j)
    (z : differentialAdjoin F (Set.range (x ∘ e))) :
    torusScaleEquiv hx hgen U z.1 =
      ((torusScaleEquiv
          (differentialIndependent_differentialAdjoinGenerator (x ∘ e) (hx.comp e he))
          (differentialAdjoin_range_differentialAdjoinGenerator_eq_top (x ∘ e)) u)
        z).1 := by
  let y : k → E := x ∘ e
  have hy : DifferentialIndependent F y := hx.comp e he
  let L : IntermediateField F E := differentialAdjoin F (Set.range y)
  let yL : k → L := differentialAdjoinGenerator (F := F) y
  let Φ : E ≃ₐ[F] E := torusScaleEquiv hx hgen U
  let σ : L ≃ₐ[F] L := torusScaleEquiv
    (differentialIndependent_differentialAdjoinGenerator y hy)
    (differentialAdjoin_range_differentialAdjoinGenerator_eq_top y) u
  let f : L →ₐ[F] E := Φ.toAlgHom.comp L.val
  let g : L →ₐ[F] E := L.val.comp σ.toAlgHom
  have hfderiv (w : L) : f w′ = (f w)′ := by
    change Φ (Differential.deriv w.1) = Differential.deriv (Φ (w.1))
    exact torusScaleEquiv_deriv hx hgen U w.1
  have hgderiv (w : L) : g w′ = (g w)′ := by
    change (σ (Differential.deriv w)).1 = Differential.deriv ((σ w).1)
    exact congrArg Subtype.val
      (torusScaleEquiv_deriv
        (differentialIndependent_differentialAdjoinGenerator y hy)
        (differentialAdjoin_range_differentialAdjoinGenerator_eq_top y) u w)
  have hfgenerator (j : k) : f (yL j) = g (yL j) := by
    change Φ (x (e j)) = (σ (yL j)).1
    rw [torusScaleEquiv_apply, torusScaleEquiv_apply, hU]
    rfl
  have hfg : f = g :=
    differentialAlgHom_ext_of_differentialAdjoin_eq_top yL
      (differentialAdjoin_range_differentialAdjoinGenerator_eq_top y)
      f g hfderiv hgderiv hfgenerator
  exact AlgHom.congr_fun hfg z

omit [CharZero E] in
/-- Coordinate scaling packaged directly on the differential field of a selected subpalette. -/
def subpaletteTorusScaleEquiv
    {k : Type u} (x : ι → E) (hx : DifferentialIndependent F x)
    (e : k → ι) (he : Function.Injective e) (u : k → Fˣ) :
    differentialAdjoin F (Set.range (x ∘ e)) ≃ₐ[F]
      differentialAdjoin F (Set.range (x ∘ e)) :=
  torusScaleEquiv
    (differentialIndependent_differentialAdjoinGenerator (x ∘ e) (hx.comp e he))
    (differentialAdjoin_range_differentialAdjoinGenerator_eq_top (x ∘ e)) u

/-- Velocity field internal to a selected subpalette differential adjunction. -/
def subpaletteTorusVelocityField
    {k : Type u} (x : ι → E) (e : k → ι) :
    IntermediateField F (differentialAdjoin F (Set.range (x ∘ e))) :=
  differentialAdjoin F
    (Set.range fun j ↦ Differential.logDeriv
      (differentialAdjoinGenerator (F := F) (x ∘ e) j))

/-- Separating coordinate scalings characterize the internal velocity field of a selected
subpalette. -/
theorem subpaletteTorusScale_invariant_iff_mem_velocity
    [CharZero F] {r : ℕ}
    (hconst : ∀ c : F, c′ = 0)
    (x : ι → E) (hx : DifferentialIndependent F x)
    (e : Fin r → ι) (he : Function.Injective e)
    {S : Set (Fin r → Fˣ)}
    (hsep : ∀ a b : Fin r →₀ ℕ,
      (∀ u ∈ S, (∏ i, ((u i : F)) ^ a i) = ∏ i, ((u i : F)) ^ b i) → a = b)
    {z : differentialAdjoin F (Set.range (x ∘ e))} :
    (∀ u ∈ S, subpaletteTorusScaleEquiv x hx e he u z = z) ↔
      z ∈ subpaletteTorusVelocityField (F := F) x e := by
  change (∀ u ∈ S,
      torusScaleEquiv
        (differentialIndependent_differentialAdjoinGenerator (x ∘ e) (hx.comp e he))
        (differentialAdjoin_range_differentialAdjoinGenerator_eq_top (x ∘ e)) u z = z) ↔
    z ∈ torusVelocityField F (differentialAdjoinGenerator (F := F) (x ∘ e))
  exact torusScale_invariant_iff_mem_torusVelocityField
    (differentialIndependent_differentialAdjoinGenerator (x ∘ e) (hx.comp e he))
    (differentialAdjoin_range_differentialAdjoinGenerator_eq_top (x ∘ e)) hconst hsep

/-- The internal velocity field of a selected subpalette maps into the velocity field of the full
palette. -/
theorem subpaletteTorusVelocityField_le_global
    {k : Type u} (x : ι → E) (e : k → ι) :
    subpaletteTorusVelocityField (F := F) x e ≤
      (differentialAdjoin F
        (Set.range fun i ↦ Differential.logDeriv (x i))).comap
          (differentialAdjoin F (Set.range (x ∘ e))).val := by
  let V : IntermediateField F E :=
    differentialAdjoin F (Set.range fun i ↦ Differential.logDeriv (x i))
  let M : IntermediateField F (differentialAdjoin F (Set.range (x ∘ e))) :=
    V.comap (differentialAdjoin F (Set.range (x ∘ e))).val
  apply differentialAdjoin_le F
  · rintro w ⟨j, rfl⟩
    change Differential.logDeriv (x (e j)) ∈ V
    exact subset_differentialAdjoin F _ ⟨e j, rfl⟩
  · intro w hw
    change Differential.deriv (w : E) ∈ V
    exact derivationClosed_differentialAdjoin F _ hw

omit [CharZero E] in
/-- Fixedness descends from a global coordinate scaling to its restriction on a generated
subpalette field. -/
theorem torusScaleEquiv_subpalette_fixed_of_fixed
    {k : Type u} (x : ι → E) (hx : DifferentialIndependent F x)
    (hgen : differentialAdjoin F (Set.range x) = ⊤)
    (e : k → ι) (he : Function.Injective e)
    (U : ι → Fˣ) (u : k → Fˣ) (hU : ∀ j, U (e j) = u j)
    (z : differentialAdjoin F (Set.range (x ∘ e)))
    (hz : torusScaleEquiv hx hgen U z.1 = z.1) :
    subpaletteTorusScaleEquiv x hx e he u z = z := by
  have hrestrict := torusScaleEquiv_restrict_differentialAdjoin
    (F := F) (E := E) (x := x) hx hgen e he U u hU z
  apply Subtype.ext
  exact hrestrict.symm.trans hz

end

end GaloisForLFunctions.HTGeometry
