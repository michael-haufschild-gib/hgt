    ((29965018665131/68719476736000000000000000000000000 : ℝ)*u^(3 : ℕ)*w^(1 : ℕ) +
    (7208520963/137438953472000000000000000000000 : ℝ)*u^(3 : ℕ)*w^(3 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ) +
