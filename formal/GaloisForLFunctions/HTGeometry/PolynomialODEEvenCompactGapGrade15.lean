/-- Exact drift-degree 5 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade15Coeff5 (v : ℝ) : ℝ :=
  ((((-2141012569867063/225434243432448000000000000000000000000 : ℝ) +
    (-5739921108938587/601157982486528000000000000000000000000 : ℝ)*v^(1 : ℕ) : ℝ) +
