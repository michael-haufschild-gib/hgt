    ((22094436432789/68719476736000000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(3 : ℕ) +
    (459792763119/17179869184000000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(5 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ) +
