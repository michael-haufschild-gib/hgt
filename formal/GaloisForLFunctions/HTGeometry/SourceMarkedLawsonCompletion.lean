import GaloisForLFunctions.HTGeometry.SourceMarkedExactnessCompletion
import GaloisForLFunctions.HTGeometry.InterfinityGeometry.StableScottRealization

/-!
# Lawson geometry of source-marked completion

Stable-exactness geometry and provenance geometry see opposite semicontinuities.  Scott death tests
make acquisition of a primitive open; lower provenance tests make loss of a primitive open.  For a
source-marked completion state, both tests are carried by one submodule of the fixed source: the
vectors whose landings are target boundaries.

This file joins those two geometries.  Its topology is generated by both survival and exactness of
every fixed source marker.  Equivalently, it is the pullback of the lower--Scott (Lawson-style)
topology on the lattice of exact source relations.  Convergence is therefore not vectorwise:
every fixed source relation must eventually have exactly its limiting homological status.
-/

open Set Topology TopologicalSpace

namespace GaloisForLFunctions.HTGeometry
namespace BoundaryMigration
namespace SourceMarkedExFlag

universe u v

variable {k : Type u} {V W : Type v} [Field k]
variable [AddCommGroup V] [Module k V]
variable [AddCommGroup W] [Module k W]

/-- Source vectors that remain exact after landing in one completion state. -/
def exactSourceProfile (s : SourceMarkedExFlag k V W) : Submodule k V :=
  s.target.boundary.comap s.landing

theorem mem_exactSourceProfile_iff
    (s : SourceMarkedExFlag k V W) (x : V) :
    x ∈ exactSourceProfile s ↔ s ∈ exactAt x := by
  simp [exactSourceProfile, exactAt, survival]

/-- Both orientations of the fixed-marker exactness test. -/
def lawsonSubbasis : Set (Set (SourceMarkedExFlag k V W)) :=
  {U | ∃ x : V, U = survival x} ∪ {U | ∃ x : V, U = exactAt x}

/-- Two-sided source-marked exactness topology. -/
@[reducible] def lawsonTopology : TopologicalSpace (SourceMarkedExFlag k V W) :=
  generateFrom (lawsonSubbasis (k := k) (V := V) (W := W))

theorem isOpen_survival_lawson (x : V) :
    IsOpen[lawsonTopology] (survival (k := k) (W := W) x) :=
  isOpen_generateFrom_of_mem (Or.inl ⟨x, rfl⟩)

theorem isOpen_exactAt_lawson (x : V) :
    IsOpen[lawsonTopology] (exactAt (k := k) (W := W) x) :=
  isOpen_generateFrom_of_mem (Or.inr ⟨x, rfl⟩)

/-- Every fixed-marker phase is clopen: the marked topology forbids both spontaneous creation and
spontaneous annihilation of a completion defect. -/
theorem isClopen_survival_lawson (x : V) :
    @IsClopen (SourceMarkedExFlag k V W) lawsonTopology
      (survival (k := k) (W := W) x) := by
  letI : TopologicalSpace (SourceMarkedExFlag k V W) := lawsonTopology
  constructor
  · simpa [exactAt] using
      (isOpen_exactAt_lawson (k := k) (W := W) x).isClosed_compl
  · exact isOpen_survival_lawson (k := k) (W := W) x

/-- The marked topology is the pullback of the lower--Scott join on the lattice of exact source
relations. -/
theorem lawsonTopology_eq_lower_scott_pullback :
    lawsonTopology (k := k) (V := V) (W := W) =
      induced exactSourceProfile (Topology.lower (Submodule k V)) ⊓
        induced exactSourceProfile (Topology.scott (Submodule k V) univ) := by
  refine le_antisymm (le_inf ?_ ?_) ?_
  · rw [lower_submodule_eq_generateFrom, induced_generateFrom_eq]
    refine le_generateFrom ?_
    rintro U ⟨T, ⟨x, rfl⟩, rfl⟩
    simpa [exactSourceProfile, survival] using
      isOpen_survival_lawson (k := k) (W := W) x
  · rw [scott_submodule_eq_generateFrom, induced_generateFrom_eq]
    refine le_generateFrom ?_
    rintro U ⟨T, ⟨x, rfl⟩, rfl⟩
    simpa [mem_exactSourceProfile_iff] using
      isOpen_exactAt_lawson (k := k) (W := W) x
  · refine le_generateFrom ?_
    rintro U (⟨x, rfl⟩ | ⟨x, rfl⟩)
    · have hle : induced
          (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.lower (Submodule k V)) ⊓
          induced (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.scott (Submodule k V) univ) ≤
          induced (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.lower (Submodule k V)) := inf_le_left
      exact hle _ ⟨{B : Submodule k V | x ∉ B}, by
        rw [lower_submodule_eq_generateFrom]
        exact isOpen_generateFrom_of_mem ⟨x, rfl⟩,
        by ext s; simp [exactSourceProfile, survival]⟩
    · have hle : induced
          (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.lower (Submodule k V)) ⊓
          induced (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.scott (Submodule k V) univ) ≤
          induced (exactSourceProfile (k := k) (V := V) (W := W))
            (Topology.scott (Submodule k V) univ) := inf_le_right
      exact hle _ ⟨{B : Submodule k V | x ∈ B},
        isOpen_scott_Ici_span_singleton x,
        by ext s; simp [mem_exactSourceProfile_iff]⟩

/-- Lawson convergence is eventual stabilization of the exact/defect phase of every literal source
marker. -/
theorem tendsto_lawson_iff_eventually_same_survival
    {ι : Type*} {l : Filter ι}
    (stage : ι → SourceMarkedExFlag k V W)
    (physical : SourceMarkedExFlag k V W) :
    Filter.Tendsto stage l
        (@nhds (SourceMarkedExFlag k V W) lawsonTopology physical) ↔
      ∀ x : V, ∀ᶠ i in l,
        (stage i ∈ survival x ↔ physical ∈ survival x) := by
  change Filter.Tendsto stage l
      (@nhds (SourceMarkedExFlag k V W)
        (generateFrom (lawsonSubbasis (k := k) (V := V) (W := W))) physical) ↔ _
  rw [TopologicalSpace.tendsto_nhds_generateFrom_iff]
  constructor
  · intro h x
    by_cases hx : physical ∈ survival (k := k) (W := W) x
    · have hs := h (survival (k := k) (W := W) x) (Or.inl ⟨x, rfl⟩) hx
      filter_upwards [hs] with i hi
      exact iff_of_true hi hx
    · have hxe : physical ∈ exactAt (k := k) (W := W) x := hx
      have hs := h (exactAt (k := k) (W := W) x) (Or.inr ⟨x, rfl⟩) hxe
      filter_upwards [hs] with i hi
      exact iff_of_false hi hx
  · intro h U
    rintro (⟨x, rfl⟩ | ⟨x, rfl⟩) hx
    · filter_upwards [h x] with i hi
      exact hi.mpr hx
    · filter_upwards [h x] with i hi
      intro hs
      exact hx (hi.mp hs)

/-- A convergent Lawson completion preserves exactness of every marked source subspace. -/
theorem escapeFree_of_tendsto_lawson
    {ι : Type*} {l : Filter ι} [l.NeBot]
    {stage : ι → SourceMarkedExFlag k V W}
    {physical : SourceMarkedExFlag k V W}
    (Jsource : Submodule k V)
    (hstage : Filter.Tendsto stage l
      (@nhds (SourceMarkedExFlag k V W) lawsonTopology physical))
    (hexact : ∀ᶠ i in l,
      EscapeFree (stage i).landing Jsource (stage i).target.boundary) :
    EscapeFree physical.landing Jsource physical.target.boundary := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hy
  have hstatus := (tendsto_lawson_iff_eventually_same_survival stage physical).1 hstage x
  by_contra hescape
  have hphysical : physical ∈ survival x := hescape
  obtain ⟨i, hi, hsame⟩ := (hexact.and hstatus).exists
  exact (hsame.mpr hphysical) (hi (Submodule.mem_map_of_mem hx))

end SourceMarkedExFlag
end BoundaryMigration
end GaloisForLFunctions.HTGeometry
