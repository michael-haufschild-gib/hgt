import GaloisForLFunctions.HTGeometry.PolynomialODEJetRankThreeSourcePositiveChartEquivalence
import GaloisForLFunctions.HTGeometry.DerivationIterateLeibniz

open Complex Real

namespace HTGeometry

noncomputable section

set_option maxHeartbeats 1000000

/-- Modular vector field as a bundled derivation. -/
def modularThetaODEDerivation :
    Derivation ℂ ModularThetaODEPolynomial ModularThetaODEPolynomial :=
  MvPolynomial.mkDerivation ℂ modularThetaODEVectorField

@[simp] theorem modularThetaODEDerivation_X (i : ModularThetaODEState) :
    modularThetaODEDerivation (MvPolynomial.X i) =
      modularThetaODEVectorField i := by
  simp [modularThetaODEDerivation]

theorem modularThetaODEDerivation_apply (P : ModularThetaODEPolynomial) :
    modularThetaODEDerivation P = modularThetaODELie P := by
  induction P using MvPolynomial.induction_on with
  | C c =>
      simp [modularThetaODELie, modularThetaODEDerivation]
  | add P Q hP hQ =>
      rw [map_add, modularThetaODELie_add, hP, hQ]
  | mul_X P i hP =>
      rw [Derivation.leibniz, modularThetaODEDerivation_X,
        modularThetaODELie_mul, modularThetaODELie_X, hP]
      simp only [smul_eq_mul]
      ac_rfl

/-- Formal modular jets generated by the bundled vector-field derivation. -/
def modularThetaODEFormalJet (i : ModularThetaODEState) (n : ℕ) :
    ModularThetaODEPolynomial :=
  (⇑modularThetaODEDerivation)^[n] (MvPolynomial.X i)

/-- Evaluate formal modular jets at one algebraic state. -/
def evalModularThetaODEFormalJet
    (v : ModularThetaODEState → ℂ) (i : ModularThetaODEState) (n : ℕ) : ℂ :=
  MvPolynomial.eval v (modularThetaODEFormalJet i n)

theorem eval_modularThetaODEDerivation_iterate_mul
    (v : ModularThetaODEState → ℂ)
    (P Q : ModularThetaODEPolynomial) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (P * Q)) =
      scalarJetConvolution
        (fun k => MvPolynomial.eval v
          ((⇑modularThetaODEDerivation)^[k] P))
        (fun k => MvPolynomial.eval v
          ((⇑modularThetaODEDerivation)^[k] Q)) n := by
  rw [GaloisForLFunctions.HTGeometry.derivation_iterate_mul]
  unfold scalarJetConvolution
  simp only [map_sum, map_mul, nsmul_eq_mul]
  apply Finset.sum_congr rfl
  intro k hk
  rw [map_natCast]
  ring

theorem modularThetaODEDerivation_iterate_add
    (P Q : ModularThetaODEPolynomial) (n : ℕ) :
    (⇑modularThetaODEDerivation)^[n] (P + Q) =
      (⇑modularThetaODEDerivation)^[n] P +
        (⇑modularThetaODEDerivation)^[n] Q := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_add]
      simp only [Function.iterate_succ_apply']

theorem modularThetaODEDerivation_iterate_neg
    (P : ModularThetaODEPolynomial) (n : ℕ) :
    (⇑modularThetaODEDerivation)^[n] (-P) =
      -(⇑modularThetaODEDerivation)^[n] P := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_neg]
      simp only [Function.iterate_succ_apply']

theorem modularThetaODEDerivation_iterate_sub
    (P Q : ModularThetaODEPolynomial) (n : ℕ) :
    (⇑modularThetaODEDerivation)^[n] (P - Q) =
      (⇑modularThetaODEDerivation)^[n] P -
        (⇑modularThetaODEDerivation)^[n] Q := by
  rw [sub_eq_add_neg, modularThetaODEDerivation_iterate_add,
    modularThetaODEDerivation_iterate_neg, sub_eq_add_neg]

theorem modularThetaODEDerivation_C (c : ℂ) :
    modularThetaODEDerivation (MvPolynomial.C c) = 0 := by
  rw [modularThetaODEDerivation_apply, modularThetaODELie_C]

theorem modularThetaODEDerivation_iterate_C_mul
    (c : ℂ) (P : ModularThetaODEPolynomial) (n : ℕ) :
    (⇑modularThetaODEDerivation)^[n] (MvPolynomial.C c * P) =
      MvPolynomial.C c * (⇑modularThetaODEDerivation)^[n] P := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, Derivation.leibniz,
        modularThetaODEDerivation_C]
      simp only [smul_eq_mul, mul_zero, add_zero,
        Function.iterate_succ_apply']

theorem eval_modularThetaODEDerivation_iterate_add
    (v : ModularThetaODEState → ℂ)
    (P Q : ModularThetaODEPolynomial) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (P + Q)) =
      MvPolynomial.eval v ((⇑modularThetaODEDerivation)^[n] P) +
        MvPolynomial.eval v ((⇑modularThetaODEDerivation)^[n] Q) := by
  rw [modularThetaODEDerivation_iterate_add, map_add]

theorem eval_modularThetaODEDerivation_iterate_sub
    (v : ModularThetaODEState → ℂ)
    (P Q : ModularThetaODEPolynomial) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (P - Q)) =
      MvPolynomial.eval v ((⇑modularThetaODEDerivation)^[n] P) -
        MvPolynomial.eval v ((⇑modularThetaODEDerivation)^[n] Q) := by
  rw [modularThetaODEDerivation_iterate_sub, map_sub]

theorem eval_modularThetaODEDerivation_iterate_C_mul
    (v : ModularThetaODEState → ℂ) (c : ℂ)
    (P : ModularThetaODEPolynomial) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (MvPolynomial.C c * P)) =
      c * MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] P) := by
  rw [modularThetaODEDerivation_iterate_C_mul, map_mul,
    MvPolynomial.eval_C]

theorem modularThetaODEFormalJet_succ
    (i : ModularThetaODEState) (n : ℕ) :
    modularThetaODEFormalJet i (n + 1) =
      (⇑modularThetaODEDerivation)^[n] (modularThetaODEVectorField i) := by
  unfold modularThetaODEFormalJet
  rw [Function.iterate_succ_apply, modularThetaODEDerivation_X]

theorem modularThetaODEFormalJet_H_eq_HJet (n : ℕ) :
    modularThetaODEFormalJet .H n = modularThetaODEHJet n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [modularThetaODEFormalJet, Function.iterate_succ_apply',
        modularThetaODEDerivation_apply]
      change modularThetaODELie (modularThetaODEFormalJet .H n) = _
      rw [ih]
      rfl

theorem eval_modularThetaODEDerivation_iterate_C
    (v : ModularThetaODEState → ℂ) (c : ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (MvPolynomial.C c)) =
      c * scalarJetUnit n := by
  cases n with
  | zero => simp [scalarJetUnit]
  | succ n =>
      rw [Function.iterate_succ_apply, modularThetaODEDerivation_C,
        GaloisForLFunctions.HTGeometry.derivation_iterate_zero]
      simp [scalarJetUnit]

theorem eval_modularThetaODEDerivation_iterate_neg
    (v : ModularThetaODEState → ℂ)
    (P : ModularThetaODEPolynomial) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (-P)) =
      -MvPolynomial.eval v ((⇑modularThetaODEDerivation)^[n] P) := by
  rw [modularThetaODEDerivation_iterate_neg, map_neg]

theorem eval_modularThetaODEDerivation_iterate_P_add_RZ
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n]
          (MvPolynomial.X .P + MvPolynomial.X .R * MvPolynomial.X .Z)) =
      evalModularThetaODEFormalJet v .P n +
        scalarJetConvolution
          (evalModularThetaODEFormalJet v .R)
          (evalModularThetaODEFormalJet v .Z) n := by
  rw [eval_modularThetaODEDerivation_iterate_add,
    eval_modularThetaODEDerivation_iterate_mul]
  rfl

theorem evalModularThetaODEFormalJet_H_succ
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    evalModularThetaODEFormalJet v .H (n + 1) =
      -(1 / 6 : ℂ) *
        scalarJetConvolution
          (evalModularThetaODEFormalJet v .H)
          (fun k => evalModularThetaODEFormalJet v .P k +
            scalarJetConvolution
              (evalModularThetaODEFormalJet v .R)
              (evalModularThetaODEFormalJet v .Z) k) n := by
  rw [evalModularThetaODEFormalJet, modularThetaODEFormalJet_succ]
  simp only [modularThetaODEVectorField]
  rw [mul_assoc]
  rw [eval_modularThetaODEDerivation_iterate_C_mul,
    eval_modularThetaODEDerivation_iterate_mul]
  apply congrArg (fun q : ℂ => -(1 / 6 : ℂ) * q)
  unfold scalarJetConvolution
  simp_rw [eval_modularThetaODEDerivation_iterate_P_add_RZ]
  rfl

theorem eval_modularThetaODEDerivation_iterate_one_sub_Z_sq
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n]
          (MvPolynomial.C 1 - MvPolynomial.X .Z ^ (2 : ℕ))) =
      scalarJetUnit n -
        scalarJetConvolution
          (evalModularThetaODEFormalJet v .Z)
          (evalModularThetaODEFormalJet v .Z) n := by
  rw [eval_modularThetaODEDerivation_iterate_sub,
    eval_modularThetaODEDerivation_iterate_C,
    show MvPolynomial.X ModularThetaODEState.Z ^ (2 : ℕ) =
      MvPolynomial.X .Z * MvPolynomial.X .Z by ring,
    eval_modularThetaODEDerivation_iterate_mul]
  simp only [one_mul]
  rfl

theorem evalModularThetaODEFormalJet_Z_succ
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    evalModularThetaODEFormalJet v .Z (n + 1) =
      -scalarJetConvolution
        (evalModularThetaODEFormalJet v .R)
        (fun k => scalarJetUnit k -
          scalarJetConvolution
            (evalModularThetaODEFormalJet v .Z)
            (evalModularThetaODEFormalJet v .Z) k) n := by
  rw [evalModularThetaODEFormalJet, modularThetaODEFormalJet_succ]
  simp only [modularThetaODEVectorField]
  rw [show -MvPolynomial.X ModularThetaODEState.R *
      (MvPolynomial.C 1 - MvPolynomial.X .Z ^ (2 : ℕ)) =
    MvPolynomial.C (-1 : ℂ) *
      (MvPolynomial.X .R *
        (MvPolynomial.C 1 - MvPolynomial.X .Z ^ (2 : ℕ))) by simp]
  rw [eval_modularThetaODEDerivation_iterate_C_mul,
    eval_modularThetaODEDerivation_iterate_mul]
  rw [neg_one_mul]
  apply congrArg Neg.neg
  unfold scalarJetConvolution
  simp_rw [eval_modularThetaODEDerivation_iterate_one_sub_Z_sq]
  rfl

theorem evalModularThetaODEFormalJet_R_succ
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    evalModularThetaODEFormalJet v .R (n + 1) =
      -(2 / 3 : ℂ) *
        scalarJetConvolution
          (evalModularThetaODEFormalJet v .R)
          (fun k => evalModularThetaODEFormalJet v .P k +
            scalarJetConvolution
              (evalModularThetaODEFormalJet v .R)
              (evalModularThetaODEFormalJet v .Z) k) n := by
  rw [evalModularThetaODEFormalJet, modularThetaODEFormalJet_succ]
  simp only [modularThetaODEVectorField]
  rw [mul_assoc]
  rw [eval_modularThetaODEDerivation_iterate_C_mul,
    eval_modularThetaODEDerivation_iterate_mul]
  apply congrArg (fun q : ℂ => -(2 / 3 : ℂ) * q)
  unfold scalarJetConvolution
  simp_rw [eval_modularThetaODEDerivation_iterate_P_add_RZ]
  rfl

theorem eval_modularThetaODEDerivation_iterate_P_sq
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (MvPolynomial.X .P ^ (2 : ℕ))) =
      scalarJetConvolution
        (evalModularThetaODEFormalJet v .P)
        (evalModularThetaODEFormalJet v .P) n := by
  rw [show MvPolynomial.X ModularThetaODEState.P ^ (2 : ℕ) =
    MvPolynomial.X .P * MvPolynomial.X .P by ring,
    eval_modularThetaODEDerivation_iterate_mul]
  rfl

theorem eval_modularThetaODEDerivation_iterate_R_sq
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n] (MvPolynomial.X .R ^ (2 : ℕ))) =
      scalarJetConvolution
        (evalModularThetaODEFormalJet v .R)
        (evalModularThetaODEFormalJet v .R) n := by
  rw [show MvPolynomial.X ModularThetaODEState.R ^ (2 : ℕ) =
    MvPolynomial.X .R * MvPolynomial.X .R by ring,
    eval_modularThetaODEDerivation_iterate_mul]
  rfl

theorem eval_modularThetaODEDerivation_iterate_three_add_Z_sq
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n]
          (MvPolynomial.C 3 + MvPolynomial.X .Z ^ (2 : ℕ))) =
      3 * scalarJetUnit n +
        scalarJetConvolution
          (evalModularThetaODEFormalJet v .Z)
          (evalModularThetaODEFormalJet v .Z) n := by
  rw [eval_modularThetaODEDerivation_iterate_add,
    eval_modularThetaODEDerivation_iterate_C]
  rw [show MvPolynomial.X ModularThetaODEState.Z ^ (2 : ℕ) =
    MvPolynomial.X .Z * MvPolynomial.X .Z by ring,
    eval_modularThetaODEDerivation_iterate_mul]
  rfl

theorem eval_modularThetaODEDerivation_iterate_R_sq_mul_three_add_Z_sq
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v
        ((⇑modularThetaODEDerivation)^[n]
          (MvPolynomial.X .R ^ (2 : ℕ) *
            (MvPolynomial.C 3 + MvPolynomial.X .Z ^ (2 : ℕ)))) =
      scalarJetConvolution
        (scalarJetConvolution
          (evalModularThetaODEFormalJet v .R)
          (evalModularThetaODEFormalJet v .R))
        (fun k => 3 * scalarJetUnit k +
          scalarJetConvolution
            (evalModularThetaODEFormalJet v .Z)
            (evalModularThetaODEFormalJet v .Z) k) n := by
  rw [eval_modularThetaODEDerivation_iterate_mul]
  unfold scalarJetConvolution
  simp_rw [eval_modularThetaODEDerivation_iterate_R_sq,
    eval_modularThetaODEDerivation_iterate_three_add_Z_sq]
  rfl

theorem evalModularThetaODEFormalJet_P_succ
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    evalModularThetaODEFormalJet v .P (n + 1) =
      3 * scalarJetUnit n -
        (1 / 3 : ℂ) * scalarJetConvolution
          (evalModularThetaODEFormalJet v .P)
          (evalModularThetaODEFormalJet v .P) n +
        (1 / 12 : ℂ) *
          scalarJetConvolution
            (scalarJetConvolution
              (evalModularThetaODEFormalJet v .R)
              (evalModularThetaODEFormalJet v .R))
            (fun k => 3 * scalarJetUnit k +
              scalarJetConvolution
                (evalModularThetaODEFormalJet v .Z)
                (evalModularThetaODEFormalJet v .Z) k) n := by
  rw [evalModularThetaODEFormalJet, modularThetaODEFormalJet_succ]
  simp only [modularThetaODEVectorField]
  have hassoc :
      MvPolynomial.C (1 / 12 : ℂ) *
          MvPolynomial.X ModularThetaODEState.R ^ (2 : ℕ) *
            (MvPolynomial.C 3 + MvPolynomial.X ModularThetaODEState.Z ^ (2 : ℕ)) =
        MvPolynomial.C (1 / 12 : ℂ) *
          (MvPolynomial.X ModularThetaODEState.R ^ (2 : ℕ) *
            (MvPolynomial.C 3 + MvPolynomial.X ModularThetaODEState.Z ^ (2 : ℕ))) := by
    rw [mul_assoc]
  rw [hassoc]
  rw [eval_modularThetaODEDerivation_iterate_add,
    eval_modularThetaODEDerivation_iterate_sub,
    eval_modularThetaODEDerivation_iterate_C,
    eval_modularThetaODEDerivation_iterate_C_mul,
    eval_modularThetaODEDerivation_iterate_P_sq,
    eval_modularThetaODEDerivation_iterate_C_mul,
    eval_modularThetaODEDerivation_iterate_R_sq_mul_three_add_Z_sq]

/-- Algebraic self-dual seam with arbitrary modular scale. -/
def modularThetaODESeamState (R : ℂ) : ModularThetaODEState → ℂ
  | .H => 1
  | .Z => 0
  | .R => R
  | .P => 0

@[simp] theorem evalModularThetaODEFormalJet_zero
    (v : ModularThetaODEState → ℂ) (i : ModularThetaODEState) :
    evalModularThetaODEFormalJet v i 0 = v i := by
  simp [evalModularThetaODEFormalJet, modularThetaODEFormalJet]

theorem eval_modularThetaODESourceJet_eq_formalJet
    (v : ModularThetaODEState → ℂ) (n : ℕ) :
    MvPolynomial.eval v (modularThetaODESourceJet n) =
      (evalModularThetaODEFormalJet v .H (n + 2) -
        (1 / 4 : ℂ) * evalModularThetaODEFormalJet v .H n) / 2 := by
  unfold modularThetaODESourceJet
  rw [← modularThetaODEFormalJet_H_eq_HJet,
    ← modularThetaODEFormalJet_H_eq_HJet]
  simp only [map_mul, map_sub, MvPolynomial.eval_C]
  simp only [evalModularThetaODEFormalJet]
  ring

/-- Exact seam elimination for universal polynomial ODE source jets, at arbitrary scale. -/
theorem eval_modularThetaODESourceJet_seam_elimination (R : ℂ) :
    let v := modularThetaODESeamState R
    let f : ℕ → ℂ := fun n =>
      MvPolynomial.eval v (modularThetaODESourceJet n)
    signedEvenHankelThreeDetC
      (f 0 ^ (2 : ℕ))
      (2 * f 0 * f 2)
      (2 * f 0 * f 4 + 6 * f 2 ^ (2 : ℕ))
      (2 * f 0 * f 6 + 30 * f 2 * f 4)
      (2 * f 0 * f 8 + 56 * f 2 * f 6 + 70 * f 4 ^ (2 : ℕ)) =
      modularThetaReflectedEighthSeamPolynomial (R ^ (2 : ℕ)) := by
  let v := modularThetaODESeamState R
  let h := evalModularThetaODEFormalJet v .H
  let z := evalModularThetaODEFormalJet v .Z
  let r := evalModularThetaODEFormalJet v .R
  let p := evalModularThetaODEFormalJet v .P
  have helim := modularThetaReflectedEighthSeamJetElimination
    (1 : ℂ) R h z r p
    (by simp [h, v, modularThetaODESeamState])
    (by simp [z, v, modularThetaODESeamState])
    (by simp [r, v, modularThetaODESeamState])
    (by simp [p, v, modularThetaODESeamState])
    (fun n => evalModularThetaODEFormalJet_H_succ v n)
    (fun n => evalModularThetaODEFormalJet_Z_succ v n)
    (fun n => evalModularThetaODEFormalJet_R_succ v n)
    (fun n => evalModularThetaODEFormalJet_P_succ v n)
  dsimp only at helim ⊢
  rw [one_pow, one_mul] at helim
  simpa only [eval_modularThetaODESourceJet_eq_formalJet] using helim

/-- Time-reflection involution on modular ODE coordinates. -/
def modularThetaODEParityCoordinate :
    ModularThetaODEState → ModularThetaODEPolynomial
  | .H => MvPolynomial.X .H
  | .Z => -MvPolynomial.X .Z
  | .R => MvPolynomial.X .R
  | .P => -MvPolynomial.X .P

def modularThetaODEParityPullback :
    ModularThetaODEPolynomial →+* ModularThetaODEPolynomial :=
  MvPolynomial.eval₂Hom MvPolynomial.C modularThetaODEParityCoordinate

@[simp] theorem modularThetaODEParityPullback_C (c : ℂ) :
    modularThetaODEParityPullback (MvPolynomial.C c) = MvPolynomial.C c := by
  simp [modularThetaODEParityPullback]

@[simp] theorem modularThetaODEParityPullback_X (i : ModularThetaODEState) :
    modularThetaODEParityPullback (MvPolynomial.X i) =
      modularThetaODEParityCoordinate i := by
  simp [modularThetaODEParityPullback]

theorem modularThetaODELie_neg (P : ModularThetaODEPolynomial) :
    modularThetaODELie (-P) = -modularThetaODELie P := by
  simp [modularThetaODELie]

/-- Reflection reverses modular vector-field time. -/
theorem modularThetaODEParity_vectorField (i : ModularThetaODEState) :
    modularThetaODEParityPullback (modularThetaODEVectorField i) =
      -modularThetaODELie (modularThetaODEParityCoordinate i) := by
  cases i <;>
    simp only [modularThetaODEVectorField, map_sub, map_mul, map_pow,
      map_add, map_neg, modularThetaODEParityPullback_C,
      modularThetaODEParityPullback_X, modularThetaODEParityCoordinate,
      modularThetaODELie_neg, modularThetaODELie_X]
  all_goals
    apply MvPolynomial.funext
    intro v
    simp <;> ring

/-- Polynomial Lie derivative anti-commutes with seam reflection. -/
theorem modularThetaODEParity_lie (P : ModularThetaODEPolynomial) :
    modularThetaODEParityPullback (modularThetaODELie P) =
      -modularThetaODELie (modularThetaODEParityPullback P) := by
  induction P using MvPolynomial.induction_on with
  | C c =>
      rw [modularThetaODELie_C, map_zero,
        modularThetaODEParityPullback_C, modularThetaODELie_C, neg_zero]
  | add P Q hP hQ =>
      rw [modularThetaODELie_add, map_add, hP, hQ, map_add,
        modularThetaODELie_add]
      ring
  | mul_X P i hP =>
      rw [modularThetaODELie_mul, modularThetaODELie_X,
        map_add, map_mul, map_mul, hP,
        modularThetaODEParityPullback_X]
      rw [map_mul, modularThetaODEParityPullback_X,
        modularThetaODELie_mul, modularThetaODEParity_vectorField]
      ring

/-- Completed-theta jets have exact alternating parity. -/
theorem modularThetaODEParity_HJet (n : ℕ) :
    modularThetaODEParityPullback (modularThetaODEHJet n) =
      MvPolynomial.C ((-1 : ℂ) ^ n) * modularThetaODEHJet n := by
  induction n with
  | zero =>
      simp [modularThetaODEHJet, modularThetaODEParityCoordinate]
  | succ n ih =>
      rw [modularThetaODEHJet, modularThetaODEParity_lie, ih,
        modularThetaODELie_mul, modularThetaODELie_C]
      simp only [zero_mul, zero_add, pow_succ]
      apply MvPolynomial.funext
      intro v
      simp

/-- Seam evaluation is fixed by reflection pullback. -/
theorem eval_modularThetaODEParityPullback_seam
    (R : ℂ) (P : ModularThetaODEPolynomial) :
    MvPolynomial.eval (modularThetaODESeamState R)
        (modularThetaODEParityPullback P) =
      MvPolynomial.eval (modularThetaODESeamState R) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp
  | add P Q hP hQ =>
      simp only [map_add]
      rw [hP, hQ]
  | mul_X P i hP =>
      rw [map_mul, map_mul, hP, modularThetaODEParityPullback_X]
      cases i <;> simp [modularThetaODEParityCoordinate,
        modularThetaODESeamState]

/-- Every odd completed-theta formal jet vanishes on arbitrary algebraic seam. -/
theorem eval_modularThetaODEHJet_seam_odd_zero (R : ℂ) (k : ℕ) :
    MvPolynomial.eval (modularThetaODESeamState R)
        (modularThetaODEHJet (2 * k + 1)) = 0 := by
  have hfix := eval_modularThetaODEParityPullback_seam R
    (modularThetaODEHJet (2 * k + 1))
  rw [modularThetaODEParity_HJet, map_mul, MvPolynomial.eval_C,
    Odd.neg_one_pow (by exact ⟨k, by omega⟩), neg_one_mul] at hfix
  have htwo : (2 : ℂ) * MvPolynomial.eval (modularThetaODESeamState R)
      (modularThetaODEHJet (2 * k + 1)) = 0 := by
    linear_combination -hfix
  exact (mul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- Every odd normalized source jet vanishes on arbitrary algebraic seam. -/
theorem eval_modularThetaODESourceJet_seam_odd_zero (R : ℂ) (k : ℕ) :
    MvPolynomial.eval (modularThetaODESeamState R)
        (modularThetaODESourceJet (2 * k + 1)) = 0 := by
  unfold modularThetaODESourceJet
  simp only [map_mul, map_sub, MvPolynomial.eval_C]
  rw [show 2 * k + 1 + 2 = 2 * (k + 1) + 1 by omega,
    eval_modularThetaODEHJet_seam_odd_zero,
    eval_modularThetaODEHJet_seam_odd_zero]
  ring

/-- Full arbitrary-basepoint D1 polynomial restricts to exact degree-twelve seam polynomial. -/
theorem eval_modularThetaReflectedEighthGeneralPolynomial_seam (R : ℂ) :
    MvPolynomial.eval (modularThetaODESeamState R)
        modularThetaReflectedEighthGeneralPolynomial =
      modularThetaReflectedEighthSeamPolynomial (R ^ (2 : ℕ)) := by
  have helim := eval_modularThetaODESourceJet_seam_elimination R
  have h1 := eval_modularThetaODESourceJet_seam_odd_zero R 0
  have h3 := eval_modularThetaODESourceJet_seam_odd_zero R 1
  have h5 := eval_modularThetaODESourceJet_seam_odd_zero R 2
  have h7 := eval_modularThetaODESourceJet_seam_odd_zero R 3
  unfold modularThetaReflectedEighthGeneralPolynomial
  dsimp only
  simp only [map_sub, map_mul, map_pow, map_add, MvPolynomial.eval_C]
  rw [h1, h3, h5, h7]
  simp only [mul_zero, sub_zero]
  unfold signedEvenHankelThreeDetC at helim
  convert helim using 1
  all_goals ring

/-- Mass-normalized arbitrary-basepoint D1 has same exact seam restriction. -/
theorem eval_modularThetaReflectedEighthNormalizedPolynomial_seam (R : ℂ) :
    MvPolynomial.eval (modularThetaODESeamState R)
        modularThetaReflectedEighthNormalizedPolynomial =
      modularThetaReflectedEighthSeamPolynomial (R ^ (2 : ℕ)) := by
  have hfac :=
    eval_modularThetaReflectedEighthGeneralPolynomial_eq_H_pow_six_mul_normalized
      (modularThetaODESeamState R)
  rw [eval_modularThetaReflectedEighthGeneralPolynomial_seam] at hfac
  simpa [modularThetaODESeamState] using hfac.symm

/-- Pull Lyapunov observables back to four-state modular ODE coordinates. -/
def modularThetaGeneralLyapunovCoordinate :
    ModularThetaLyapunovState → ModularThetaODEPolynomial
  | .S => MvPolynomial.X .P + MvPolynomial.X .R * MvPolynomial.X .Z
  | .A => MvPolynomial.X .R ^ (2 : ℕ) *
      (MvPolynomial.C 1 - MvPolynomial.X .Z ^ (2 : ℕ))
  | .W => MvPolynomial.C (2 / 3 : ℂ) *
      (MvPolynomial.X .P + MvPolynomial.X .R * MvPolynomial.X .Z) -
        MvPolynomial.X .R * MvPolynomial.X .Z

def modularThetaGeneralLyapunovPullback :
    ModularThetaLyapunovPolynomial →+* ModularThetaODEPolynomial :=
  MvPolynomial.eval₂Hom MvPolynomial.C modularThetaGeneralLyapunovCoordinate

@[simp] theorem modularThetaGeneralLyapunovPullback_C (c : ℂ) :
    modularThetaGeneralLyapunovPullback (MvPolynomial.C c) =
      MvPolynomial.C c := by
  simp [modularThetaGeneralLyapunovPullback]

@[simp] theorem modularThetaGeneralLyapunovPullback_X
    (i : ModularThetaLyapunovState) :
    modularThetaGeneralLyapunovPullback (MvPolynomial.X i) =
      modularThetaGeneralLyapunovCoordinate i := by
  simp [modularThetaGeneralLyapunovPullback]

theorem modularThetaODELie_sub
    (P Q : ModularThetaODEPolynomial) :
    modularThetaODELie (P - Q) =
      modularThetaODELie P - modularThetaODELie Q := by
  simp [modularThetaODELie, sub_mul, Finset.sum_sub_distrib]

theorem modularThetaODELie_C_mul
    (c : ℂ) (P : ModularThetaODEPolynomial) :
    modularThetaODELie (MvPolynomial.C c * P) =
      MvPolynomial.C c * modularThetaODELie P := by
  rw [modularThetaODELie_mul, modularThetaODELie_C]
  ring

/-- Four-state quotient map intertwines modular and Lyapunov vector fields. -/
theorem modularThetaGeneralLyapunov_vectorField
    (i : ModularThetaLyapunovState) :
    modularThetaGeneralLyapunovPullback
        (modularThetaLyapunovVectorField i) =
      modularThetaODELie (modularThetaGeneralLyapunovCoordinate i) := by
  cases i with
  | S =>
      simp only [modularThetaLyapunovVectorField, map_sub, map_mul, map_pow,
        modularThetaGeneralLyapunovPullback_C,
        modularThetaGeneralLyapunovPullback_X,
        modularThetaGeneralLyapunovCoordinate]
      rw [modularThetaODELie_add, modularThetaODELie_X,
        modularThetaODELie_mul, modularThetaODELie_X,
        modularThetaODELie_X]
      apply MvPolynomial.funext
      intro v
      simp [modularThetaODEVectorField]
      ring

  | A =>
      simp only [modularThetaLyapunovVectorField, map_mul,
        modularThetaGeneralLyapunovPullback_C,
        modularThetaGeneralLyapunovPullback_X,
        modularThetaGeneralLyapunovCoordinate]
      rw [show MvPolynomial.X ModularThetaODEState.R ^ (2 : ℕ) =
        MvPolynomial.X .R * MvPolynomial.X .R by ring]
      rw [show MvPolynomial.X ModularThetaODEState.Z ^ (2 : ℕ) =
        MvPolynomial.X .Z * MvPolynomial.X .Z by ring]
      rw [modularThetaODELie_mul, modularThetaODELie_mul,
        modularThetaODELie_X, modularThetaODELie_sub,
        modularThetaODELie_C, modularThetaODELie_mul,
        modularThetaODELie_X]
      apply MvPolynomial.funext
      intro v
      simp [modularThetaODEVectorField]
      ring

  | W =>
      simp only [modularThetaLyapunovVectorField, map_sub, map_mul, map_pow,
        map_add, modularThetaGeneralLyapunovPullback_C,
        modularThetaGeneralLyapunovPullback_X,
        modularThetaGeneralLyapunovCoordinate]
      rw [modularThetaODELie_sub, modularThetaODELie_C_mul,
        modularThetaODELie_add, modularThetaODELie_X,
        modularThetaODELie_mul, modularThetaODELie_X,
        modularThetaODELie_X]
      apply MvPolynomial.funext
      intro v
      simp [modularThetaODEVectorField]
      ring

/-- Four-state quotient pullback intertwines polynomial Lie derivatives. -/
theorem modularThetaGeneralLyapunov_lie
    (P : ModularThetaLyapunovPolynomial) :
    modularThetaGeneralLyapunovPullback (modularThetaLyapunovLie P) =
      modularThetaODELie (modularThetaGeneralLyapunovPullback P) := by
  induction P using MvPolynomial.induction_on with
  | C c =>
      rw [modularThetaLyapunovLie_C_local,
        modularThetaGeneralLyapunovPullback_C, modularThetaODELie_C]
      simp
  | add P Q hP hQ =>
      rw [modularThetaLyapunovLie_add_local, map_add, hP, hQ,
        map_add, modularThetaODELie_add]
  | mul_X P i hP =>
      rw [modularThetaLyapunovLie_mul_local,
        modularThetaLyapunovLie_X_local, map_add, map_mul, map_mul,
        hP, modularThetaGeneralLyapunovPullback_X]
      rw [map_mul, modularThetaGeneralLyapunovPullback_X,
        modularThetaODELie_mul, modularThetaGeneralLyapunov_vectorField]

/-- Four-state quotient pullback intertwines covariant normalized Lie derivatives. -/
theorem modularThetaGeneralLyapunov_normalizedLie
    (P : ModularThetaLyapunovPolynomial) :
    modularThetaGeneralLyapunovPullback
        (modularThetaLyapunovNormalizedLie P) =
      modularThetaODENormalizedLie
        (modularThetaGeneralLyapunovPullback P) := by
  unfold modularThetaLyapunovNormalizedLie modularThetaODENormalizedLie
  rw [map_add, map_mul, modularThetaGeneralLyapunov_lie,
    map_mul, modularThetaGeneralLyapunovPullback_C,
    modularThetaGeneralLyapunovPullback_X]
  rfl

/-- Every normalized completed-theta jet transports through four-to-three quotient. -/
theorem modularThetaGeneralLyapunov_normalizedHJet (n : ℕ) :
    modularThetaGeneralLyapunovPullback
        (modularThetaLyapunovNormalizedHJet n) =
      modularThetaODENormalizedHJet n := by
  induction n with
  | zero => simp [modularThetaLyapunovNormalizedHJet,
      modularThetaODENormalizedHJet]
  | succ n ih =>
      rw [modularThetaLyapunovNormalizedHJet,
        modularThetaODENormalizedHJet,
        modularThetaGeneralLyapunov_normalizedLie, ih]

/-- Every normalized source jet transports through four-to-three quotient. -/
theorem modularThetaGeneralLyapunov_normalizedSourceJet (n : ℕ) :
    modularThetaGeneralLyapunovPullback
        (modularThetaLyapunovNormalizedSourceJet n) =
      modularThetaODENormalizedSourceJet n := by
  unfold modularThetaLyapunovNormalizedSourceJet
    modularThetaODENormalizedSourceJet
  simp only [map_sub, map_mul, modularThetaGeneralLyapunovPullback_C]
  rw [modularThetaGeneralLyapunov_normalizedHJet,
    modularThetaGeneralLyapunov_normalizedHJet]

/-- Full D1 polynomial transports through four-to-three quotient without expansion. -/
theorem modularThetaGeneralLyapunov_reflectedEighthPolynomial :
    modularThetaGeneralLyapunovPullback
        modularThetaLyapunovReflectedEighthPolynomial =
      modularThetaReflectedEighthNormalizedPolynomial := by
  unfold modularThetaLyapunovReflectedEighthPolynomial
    modularThetaReflectedEighthNormalizedPolynomial
  dsimp only
  simp only [map_sub, map_mul, map_pow, map_add,
    modularThetaGeneralLyapunovPullback_C]
  rw [modularThetaGeneralLyapunov_normalizedSourceJet 0,
    modularThetaGeneralLyapunov_normalizedSourceJet 1,
    modularThetaGeneralLyapunov_normalizedSourceJet 2,
    modularThetaGeneralLyapunov_normalizedSourceJet 3,
    modularThetaGeneralLyapunov_normalizedSourceJet 4,
    modularThetaGeneralLyapunov_normalizedSourceJet 5,
    modularThetaGeneralLyapunov_normalizedSourceJet 6,
    modularThetaGeneralLyapunov_normalizedSourceJet 7,
    modularThetaGeneralLyapunov_normalizedSourceJet 8]

/-- Lyapunov image of arbitrary algebraic modular seam. -/
def modularThetaLyapunovSeamState (R : ℂ) :
    ModularThetaLyapunovState → ℂ
  | .S => 0
  | .A => R ^ (2 : ℕ)
  | .W => 0

/-- Evaluation commutes with four-state-to-Lyapunov quotient at seam. -/
theorem eval_modularThetaGeneralLyapunovPullback_seam
    (R : ℂ) (P : ModularThetaLyapunovPolynomial) :
    MvPolynomial.eval (modularThetaODESeamState R)
        (modularThetaGeneralLyapunovPullback P) =
      MvPolynomial.eval (modularThetaLyapunovSeamState R) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp
  | add P Q hP hQ =>
      simp only [map_add]
      rw [hP, hQ]
  | mul_X P i hP =>
      rw [map_mul, map_mul, hP,
        modularThetaGeneralLyapunovPullback_X]
      cases i <;>
        simp [modularThetaGeneralLyapunovCoordinate,
          modularThetaODESeamState, modularThetaLyapunovSeamState]

/-- Lyapunov D1 restricts exactly to degree-twelve seam polynomial at arbitrary scale. -/
theorem eval_modularThetaLyapunovReflectedEighthPolynomial_seam (R : ℂ) :
    MvPolynomial.eval (modularThetaLyapunovSeamState R)
        modularThetaLyapunovReflectedEighthPolynomial =
      modularThetaReflectedEighthSeamPolynomial (R ^ (2 : ℕ)) := by
  rw [← eval_modularThetaGeneralLyapunovPullback_seam]
  rw [modularThetaGeneralLyapunov_reflectedEighthPolynomial,
    eval_modularThetaReflectedEighthNormalizedPolynomial_seam]
end


end HTGeometry
