import GaloisForLFunctions.HTGeometry.AffineExponentialAlgebraicLocusPoint
import GaloisForLFunctions.HTGeometry.AffineExponentialAlgebraicLocusOpenPoint
import GaloisForLFunctions.HTGeometry.AffineExponentialPointClosure

/-!
# Subgroup generated by a translated algebraic locus

This file takes the exact algebraic-number locus of a mixed complex point, translates it by a
chosen point, generates its point subgroup, and takes the subgroup's Zariski vanishing ideal.  The
result is an actual Hopf ideal, and the translated original point lies in its zero locus.
-/

open Coalgebra Bialgebra

namespace GaloisForLFunctions.HTGeometry
namespace AffineExponentialAlgebraicLocusSubgroup

open AffineExponentialGroup AffineExponentialPointEvaluation
open AffineExponentialPointClosure
open AffineExponentialAlgebraicLocusPoint
open AffineExponentialAlgebraicLocusOpenPoint

noncomputable section

/-- Complex points satisfying every algebraic-number regular relation satisfied by `p`. -/
def algebraicLocus {n : ℕ} (p : Point ℂ n) : Set (Point ℂ n) :=
  {r | ∀ f : CoordinateAlgebra (algebraicClosure ℚ ℂ) n,
    eval (k := algebraicClosure ℚ ℂ) p f = 0 →
      eval (k := algebraicClosure ℚ ℂ) r f = 0}

theorem self_mem_algebraicLocus {n : ℕ} (p : Point ℂ n) :
    p ∈ algebraicLocus p := by
  intro f hf
  exact hf

/-- Translate the exact algebraic locus by the inverse of `q`. -/
def translatedAlgebraicLocus {n : ℕ} (p q : Point ℂ n) : Set (Point ℂ n) :=
  (fun r => r * q⁻¹) '' algebraicLocus p

/-- Point subgroup generated by the translated exact algebraic locus. -/
def algebraicLocusGeneratedSubgroup {n : ℕ} (p q : Point ℂ n) :
    Subgroup (Point ℂ n) :=
  Subgroup.closure (translatedAlgebraicLocus p q)

/-- Hopf ideal of the Zariski closure of the subgroup generated by the translated locus. -/
def algebraicLocusSubgroupIdeal {n : ℕ} (p q : Point ℂ n) :
    Ideal (CoordinateAlgebra ℂ n) :=
  vanishingIdeal (algebraicLocusGeneratedSubgroup p q : Set (Point ℂ n))

instance algebraicLocusSubgroupIdeal_isHopfIdeal {n : ℕ} (p q : Point ℂ n) :
    (algebraicLocusSubgroupIdeal p q).IsHopfIdeal ℂ :=
  vanishingIdeal_isHopfIdeal (algebraicLocusGeneratedSubgroup p q)

theorem translated_mem_generatedSubgroup {n : ℕ} (p q r : Point ℂ n)
    (hr : r ∈ algebraicLocus p) :
    r * q⁻¹ ∈ algebraicLocusGeneratedSubgroup p q := by
  apply Subgroup.subset_closure
  exact ⟨r, hr, rfl⟩

theorem translated_mem_subgroup_zeroLocus {n : ℕ} (p q r : Point ℂ n)
    (hr : r ∈ algebraicLocus p) :
    r * q⁻¹ ∈ zeroLocus (algebraicLocusSubgroupIdeal p q) := by
  apply subset_zeroLocus_vanishingIdeal
  exact translated_mem_generatedSubgroup p q r hr

theorem div_mem_algebraicLocusSubgroup_zeroLocus {n : ℕ} (p q : Point ℂ n) :
    p * q⁻¹ ∈ zeroLocus (algebraicLocusSubgroupIdeal p q) :=
  translated_mem_subgroup_zeroLocus p q p (self_mem_algebraicLocus p)

/-- The exact algebraic locus supplies an algebraic coset representative and an actual subgroup
Hopf ideal containing the translated original point. -/
theorem exists_algebraic_coset_subgroup {n : ℕ} (p : Point ℂ n) :
    ∃ q : Point ℂ n,
      (∀ i, IsAlgebraic ℚ (additivePart q i)) ∧
      (∀ i, IsAlgebraic ℚ (torusPart q i : ℂ)) ∧
      q ∈ algebraicLocus p ∧
      p * q⁻¹ ∈ zeroLocus (algebraicLocusSubgroupIdeal p q) := by
  obtain ⟨q, hqadd, hqtorus, hqlocus⟩ := exists_algebraic_locus_point p
  exact ⟨q, hqadd, hqtorus, hqlocus,
    div_mem_algebraicLocusSubgroup_zeroLocus p q⟩

/-- Principal-open refinement: the algebraic coset representative can be chosen while preserving
nonvanishing of any prescribed regular function. -/
theorem exists_algebraic_coset_subgroup_avoiding {n : ℕ} (p : Point ℂ n)
    (g : CoordinateAlgebra (algebraicClosure ℚ ℂ) n)
    (hg : eval (k := algebraicClosure ℚ ℂ) p g ≠ 0) :
    ∃ q : Point ℂ n,
      (∀ i, IsAlgebraic ℚ (additivePart q i)) ∧
      (∀ i, IsAlgebraic ℚ (torusPart q i : ℂ)) ∧
      q ∈ algebraicLocus p ∧
      eval (k := algebraicClosure ℚ ℂ) q g ≠ 0 ∧
      p * q⁻¹ ∈ zeroLocus (algebraicLocusSubgroupIdeal p q) := by
  obtain ⟨q, hqadd, hqtorus, hqg, hqlocus⟩ :=
    exists_algebraic_locus_point_avoiding p g hg
  exact ⟨q, hqadd, hqtorus, hqlocus, hqg,
    div_mem_algebraicLocusSubgroup_zeroLocus p q⟩

end

end AffineExponentialAlgebraicLocusSubgroup
end GaloisForLFunctions.HTGeometry
