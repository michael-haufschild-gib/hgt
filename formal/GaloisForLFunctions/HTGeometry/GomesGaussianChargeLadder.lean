import GaloisForLFunctions.HTGeometry.GomesGaussianChargedConnection
import GaloisForLFunctions.HTGeometry.GomesGaussianChargeGroundState

/-!
# A nonzero Gaussian eigenstate ladder for every positive effective charge

The tensor-charge connection experiment now acts on the corpus's oscillator ladder.
The common connection fixes both the lowering coefficient and the spectral spacing.
States are constructed on the actual Schwartz domain from the previously closed ground
state theorem. No eigenvector or nonvanishing premise is supplied.
-/

noncomputable section
open scoped SchwartzMap

namespace GaloisForLFunctions.HTGeometry

/-- The unnormalized ladder generated by the charged creation operator. -/
def gomesGaussianChargeLadder (a : Set.Ioi (0 : ℝ)) : ℕ → 𝓢(ℝ, ℂ)
  | 0 => gomesGaussianChargeGroundState a
  | n + 1 => dilatonAdjointChargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a n)

/-- The base rung is the previously constructed Gaussian ground state. -/
theorem gomesGaussianChargeLadder_zero (a : Set.Ioi (0 : ℝ)) :
    gomesGaussianChargeLadder a 0 = gomesGaussianChargeGroundState a := rfl

/-- Raising is the literal recursive constructor. -/
theorem gomesGaussianChargeLadder_raise (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    dilatonAdjointChargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a n) =
      gomesGaussianChargeLadder a (n + 1) := rfl

/-- The first-order charge annihilates the base rung. -/
theorem gomesGaussianChargeLadder_lower_zero (a : Set.Ioi (0 : ℝ)) :
    dilatonSuperchargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a 0) = 0 :=
  (dilatonHamiltonian_kernel_iff _ _).mp (gomesGaussianChargeGroundState_kernel a)

/-- Commuting the charge through one raising step gives the exact recursion. -/
theorem gomesGaussianChargeLadder_lower_step (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    dilatonSuperchargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a (n + 1)) =
      dilatonAdjointChargeCLM (gomesGaussianLogWeight a.val)
        (dilatonSuperchargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a n)) +
      (4 * (Real.pi : ℂ) * a.val) • gomesGaussianChargeLadder a n := by
  have h := gomesGaussianCharge_commutator a.val (gomesGaussianChargeLadder a n)
  rw [sub_eq_iff_eq_add] at h
  exact h.trans (add_comm _ _)

/-- Lowering the next rung multiplies the previous one by the charge-scaled level. -/
theorem gomesGaussianChargeLadder_lower (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    dilatonSuperchargeCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a (n + 1)) =
      (4 * (Real.pi : ℂ) * a.val * ((n : ℂ) + 1)) • gomesGaussianChargeLadder a n := by
  induction n with
  | zero =>
    rw [gomesGaussianChargeLadder_lower_step, gomesGaussianChargeLadder_lower_zero, map_zero,
      zero_add]
    simp
  | succ n ih =>
    rw [gomesGaussianChargeLadder_lower_step, ih, map_smul, gomesGaussianChargeLadder_raise,
      ← add_smul]
    congr 1
    push_cast
    ring

/-- The positive-charge Hamiltonian has every nonnegative integer level of the exact spacing. -/
theorem gomesGaussianChargeLadder_eigen (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    dilatonHamiltonianCLM (gomesGaussianLogWeight a.val) (gomesGaussianChargeLadder a n) =
      (4 * (Real.pi : ℂ) * a.val * n) • gomesGaussianChargeLadder a n := by
  cases n with
  | zero =>
    rw [gomesGaussianChargeLadder_zero, gomesGaussianChargeGroundState_kernel]
    simp
  | succ n =>
    rw [dilatonHamiltonianCLM, ContinuousLinearMap.comp_apply,
      gomesGaussianChargeLadder_lower, map_smul, gomesGaussianChargeLadder_raise, Nat.cast_succ]

/-- The reversed charge has the same ladder with every eigenvalue shifted up one level. -/
theorem gomesGaussianChargeLadder_dual_eigen (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    dilatonHamiltonianCLM (gomesGaussianLogWeight (-a.val)) (gomesGaussianChargeLadder a n) =
      (4 * (Real.pi : ℂ) * a.val * ((n : ℂ) + 1)) • gomesGaussianChargeLadder a n := by
  rw [gomesGaussianHamiltonian_dual, gomesGaussianChargeLadder_eigen, ← add_smul]
  congr 1
  ring

/-- No rung vanishes: lowering a hypothetical zero would annihilate its nonzero predecessor. -/
theorem gomesGaussianChargeLadder_ne_zero (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    gomesGaussianChargeLadder a n ≠ 0 := by
  induction n with
  | zero => exact gomesGaussianChargeGroundState_ne_zero a
  | succ n ih =>
    intro hz
    have h := gomesGaussianChargeLadder_lower a n
    rw [hz, map_zero] at h
    have hp : 0 < 4 * Real.pi * a.val * ((n : ℝ) + 1) :=
      mul_pos (mul_pos (mul_pos (by linarith) Real.pi_pos) a.property)
        (by positivity)
    have hc : (4 * (Real.pi : ℂ) * a.val * ((n : ℂ) + 1)) ≠ 0 := by
      exact_mod_cast ne_of_gt hp
    exact ih ((smul_eq_zero.mp h.symm).resolve_left hc)

/-- Every positive-charge level is realized by a genuine nonzero Schwartz state. -/
theorem gomesGaussianChargeLadder_exists_eigen (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    ∃ ψ : 𝓢(ℝ, ℂ), ψ ≠ 0 ∧ dilatonHamiltonianCLM (gomesGaussianLogWeight a.val) ψ =
      (4 * (Real.pi : ℂ) * a.val * n) • ψ :=
  ⟨gomesGaussianChargeLadder a n, gomesGaussianChargeLadder_ne_zero a n,
    gomesGaussianChargeLadder_eigen a n⟩

/-- The dual sector also has a genuine nonzero state at every shifted level. -/
theorem gomesGaussianChargeLadder_exists_dual_eigen (a : Set.Ioi (0 : ℝ)) (n : ℕ) :
    ∃ ψ : 𝓢(ℝ, ℂ), ψ ≠ 0 ∧ dilatonHamiltonianCLM (gomesGaussianLogWeight (-a.val)) ψ =
      (4 * (Real.pi : ℂ) * a.val * ((n : ℂ) + 1)) • ψ :=
  ⟨gomesGaussianChargeLadder a n, gomesGaussianChargeLadder_ne_zero a n,
    gomesGaussianChargeLadder_dual_eigen a n⟩

/-- All iterates of the Hamiltonian are fixed exactly on every constructed rung. -/
theorem gomesGaussianChargeLadder_hamiltonian_iterate (a : Set.Ioi (0 : ℝ)) (k n : ℕ) :
    ((dilatonHamiltonianCLM (gomesGaussianLogWeight a.val))^[k]) (gomesGaussianChargeLadder a n) =
      ((4 * (Real.pi : ℂ) * a.val * n) ^ k) • gomesGaussianChargeLadder a n := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', ih, map_smul, gomesGaussianChargeLadder_eigen, smul_smul,
      pow_succ]

end GaloisForLFunctions.HTGeometry
