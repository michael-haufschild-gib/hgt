import GaloisForLFunctions.HTGeometry.FacePacketLayerGluing
import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence
import GaloisForLFunctions.HTGeometry.FiniteDifferentialCircuitBoundary

/-!
# Descending union of face layers

The descending induction of the paper adds one face layer at a time to the deeper ones.  The step is
the general fact that a set which is differentially independent over the field generated by a second
set may be adjoined to it: the two sets are automatically disjoint, because an element of the
generated field is differentially algebraic over it.

* **`diffIndepOn_union_of_base`** — the abstract descending step;
* `faceStar_empty_eq_facePacketUnion`, `facePacketUnion_union` — the face dictionary;
* **`facePacketUnion_diffIndepOn_union`** — the descending step for face families.
-/

open Filter Topology Set Function Complex
open scoped Classical Differential

namespace GaloisForLFunctions

open Bottcher HTGeometry
open MatroidGluing MatroidGluing.Rank

noncomputable section

/-! ## The abstract descending step -/

/-- **Adjoining an independent layer.**  If `B` is differentially independent over `k` and `A` is
differentially independent over the differential field generated by `B`, then `A ∪ B` is
differentially independent over `k`.  Disjointness is automatic. -/
theorem diffIndepOn_union_of_base
    {k K : Type*} [Field k] [Field K] [Algebra k K] [Differential K]
    {A B : Set K} (hB : DiffIndepOn k B)
    (hA : DiffIndepOn ↥(differentialAdjoin k B) A) :
    DiffIndepOn k (A ∪ B) := by
  classical
  have hdisj : Disjoint A B := by
    rw [Set.disjoint_left]
    intro x hxA hxB
    have hxK : x ∈ differentialAdjoin k B := subset_differentialAdjoin k B hxB
    have hsingle : DiffIndepOn ↥(differentialAdjoin k B) ({x} : Set K) :=
      hA.subset (Set.singleton_subset_iff.mpr hxA)
    let e : Unit ≃ ({x} : Set K) :=
      { toFun := fun _ => ⟨x, rfl⟩
        invFun := fun _ => ()
        left_inv := fun _ => rfl
        right_inv := fun y => Subtype.ext y.2.symm }
    have hUnit : DifferentialIndependent ↥(differentialAdjoin k B) (fun _ : Unit => x) := by
      have h := (differentialIndependent_equiv e
        (Subtype.val : ({x} : Set K) → K)).mpr hsingle
      simpa [e] using h
    exact differentialAlgebraicOver_algebraMap
      (E := K) (⟨x, hxK⟩ : ↥(differentialAdjoin k B)) hUnit
  exact (diffIndepOn_union_iff hdisj).mpr ⟨hB, hA⟩

/-! ## The face dictionary -/

variable {ι : Type} [Fintype ι] [DecidableEq ι]

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

/-- The full star of a face family is the union of its packets. -/
theorem faceStar_empty_eq_facePacketUnion (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (faces : Finset (Finset ι)) :
    faceStar faces (multipleEllipticGammaFacePacket τ hτ) ∅ =
      facePacketUnion τ hτ (↑faces : Set (Finset ι)) := by
  ext y
  simp [faceStar, facePacketUnion]

/-- The packet union of a union of face families splits. -/
theorem facePacketUnion_union (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (S T : Set (Finset ι)) :
    facePacketUnion τ hτ (S ∪ T) =
      facePacketUnion τ hτ S ∪ facePacketUnion τ hτ T := by
  ext y
  simp only [facePacketUnion, Set.mem_iUnion, Set.mem_union, exists_prop]
  constructor
  · rintro ⟨L, hL | hL, hy⟩
    · exact Or.inl ⟨L, hL, hy⟩
    · exact Or.inr ⟨L, hL, hy⟩
  · rintro (⟨L, hL, hy⟩ | ⟨L, hL, hy⟩)
    · exact ⟨L, Or.inl hL, hy⟩
    · exact ⟨L, Or.inr hL, hy⟩

/-- **The descending step for face families.**  A layer that is independent over the field
generated by the deeper faces may be adjoined to them. -/
theorem facePacketUnion_diffIndepOn_union (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (S T : Set (Finset ι))
    (hdeep : DiffIndepOn ℂ (facePacketUnion τ hτ S))
    (hlayer : DiffIndepOn ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
      (facePacketUnion τ hτ T)) :
    DiffIndepOn ℂ (facePacketUnion τ hτ (S ∪ T)) := by
  rw [facePacketUnion_union, Set.union_comm]
  exact diffIndepOn_union_of_base hdeep hlayer

theorem facePacketUnion_empty (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) :
    facePacketUnion τ hτ (∅ : Set (Finset ι)) = ∅ := by
  simp [facePacketUnion]

/-- **The descending induction.**  Adding one layer at a time, each independent over the field
generated by the layers already added, makes every partial union differentially independent over the
constants. -/
theorem facePacketUnion_diffIndepOn_iterate (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (layer part : ℕ → Set (Finset ι))
    (hpart0 : part 0 = ∅)
    (hpartsucc : ∀ k, part (k + 1) = part k ∪ layer k)
    (hstep : ∀ k, DiffIndepOn ↥(differentialAdjoin ℂ (facePacketUnion τ hτ (part k)))
      (facePacketUnion τ hτ (layer k))) :
    ∀ n, DiffIndepOn ℂ (facePacketUnion τ hτ (part n)) := by
  intro n
  induction n with
  | zero =>
      rw [hpart0, facePacketUnion_empty]
      exact diffIndepOn_empty
  | succ k ih =>
      rw [hpartsucc k]
      exact facePacketUnion_diffIndepOn_union τ hτ (part k) (layer k) ih (hstep k)

end

end GaloisForLFunctions
