import GaloisForLFunctions.HTGeometry.ConicCaratheodory
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Topology.Algebra.InfiniteSum.Order
import Mathlib.RingTheory.Noetherian.Basic

/-!
# The countable conic compression lemma

An absolutely convergent positive combination of countably many vectors in a finite-dimensional
space is already a positive combination of at most `finrank` of them.

There is no closed-cone hypothesis, and none is available: the cone generated by infinitely many
vectors need not be closed.  What makes the statement true is that the whole combination carries a
strictly positive weight on a finite spanning subfamily.  A bounded linear right inverse of the
evaluation map `k ↦ ∑_{i ∈ F₀} k_i v_i` rewrites any small vector of the span as a small
perturbation of the coefficients on `F₀`; absorbing a small enough tail of the series into those
coefficients keeps them positive, so the sum is an honest finite positive combination, and conic
Carathéodory trims it to a linearly independent subfamily.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

variable {ι : Type*} [DecidableEq ι]
variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-! ## A finite subfamily with the same span -/

theorem exists_finset_span_eq_span_range (v : ι → V) :
    ∃ F₀ : Finset ι,
      Submodule.span ℝ (v '' (F₀ : Set ι)) = Submodule.span ℝ (Set.range v) := by
  classical
  obtain ⟨T, hT⟩ := (IsNoetherian.noetherian (Submodule.span ℝ (Set.range v)))
  have hmem : ∀ t ∈ T, ∃ S : Finset V,
      (↑S : Set V) ⊆ Set.range v ∧ t ∈ Submodule.span ℝ (↑S : Set V) := by
    intro t ht
    have htw : t ∈ Submodule.span ℝ (Set.range v) := by
      rw [← hT]
      exact Submodule.subset_span ht
    exact Submodule.mem_span_finite_of_mem_span htw
  choose! S hSsub hSmem using hmem
  set U : Finset V := T.biUnion S with hU
  have hUsub : (↑U : Set V) ⊆ Set.range v := by
    intro u hu
    rw [hU, Finset.coe_biUnion] at hu
    obtain ⟨t, ht, hut⟩ := Set.mem_iUnion₂.1 hu
    exact hSsub t ht hut
  have hspanU : Submodule.span ℝ (↑U : Set V) = Submodule.span ℝ (Set.range v) := by
    refine le_antisymm (Submodule.span_mono hUsub) ?_
    rw [← hT]
    refine Submodule.span_le.2 fun t ht => ?_
    have hsub : (↑(S t) : Set V) ⊆ (↑U : Set V) := by
      intro y hy
      rw [hU, Finset.coe_biUnion]
      exact Set.mem_iUnion₂.2 ⟨t, ht, hy⟩
    exact Submodule.span_mono hsub (hSmem t ht)
  have hpre : ∀ u : { x // x ∈ U }, ∃ i : ι, v i = (u : V) := fun u => hUsub u.2
  choose idx hidx using hpre
  refine ⟨U.attach.image idx, ?_⟩
  have himg : v '' ((U.attach.image idx : Finset ι) : Set ι) = (↑U : Set V) := by
    ext y
    constructor
    · rintro ⟨i, hi, rfl⟩
      rw [Finset.coe_image] at hi
      obtain ⟨u, _, rfl⟩ := hi
      rw [hidx u]
      exact u.2
    · intro hy
      refine ⟨idx ⟨y, hy⟩, ?_, hidx ⟨y, hy⟩⟩
      rw [Finset.coe_image]
      exact ⟨⟨y, hy⟩, Finset.mem_coe.2 (Finset.mem_attach U _), rfl⟩
  rw [himg, hspanU]

/-! ## Bounded coefficients on a finite spanning subfamily -/

/-- The evaluation map of a finite subfamily. -/
noncomputable def finsetEval (v : ι → V) (F₀ : Finset ι) : ({ x // x ∈ F₀ } → ℝ) →ₗ[ℝ] V where
  toFun := fun k => ∑ i ∈ F₀.attach, k i • v (i : ι)
  map_add' := by
    intro k l
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => by rw [Pi.add_apply, add_smul]
  map_smul' := by
    intro r k
    rw [RingHom.id_apply, Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [Pi.smul_apply, smul_eq_mul, mul_smul]

omit [DecidableEq ι] [FiniteDimensional ℝ V] in
theorem finsetEval_apply (v : ι → V) (F₀ : Finset ι) (k : { x // x ∈ F₀ } → ℝ) :
    finsetEval v F₀ k = ∑ i ∈ F₀.attach, k i • v (i : ι) := rfl

omit [FiniteDimensional ℝ V] in
theorem range_finsetEval (v : ι → V) (F₀ : Finset ι) :
    LinearMap.range (finsetEval v F₀) = Submodule.span ℝ (v '' (F₀ : Set ι)) := by
  classical
  refine le_antisymm ?_ ?_
  · rintro w ⟨k, rfl⟩
    rw [finsetEval_apply]
    refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ ?_
    exact Submodule.subset_span ⟨(i : ι), i.2, rfl⟩
  · refine Submodule.span_le.2 ?_
    rintro w ⟨i, hi, rfl⟩
    refine ⟨fun j => if (j : ι) = i then 1 else 0, ?_⟩
    rw [finsetEval_apply, Finset.sum_eq_single (⟨i, hi⟩ : {x // x ∈ F₀})]
    · simp
    · intro j _ hj
      have hji : (j : ι) ≠ i := fun h => hj (Subtype.ext h)
      simp [hji]
    · intro hcon
      exact absurd (Finset.mem_attach F₀ _) hcon

omit [FiniteDimensional ℝ V] in
/-- **A bounded coefficient representation on a finite spanning subfamily.** -/
theorem exists_bounded_coeffs (v : ι → V) (F₀ : Finset ι) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ w ∈ Submodule.span ℝ (v '' (F₀ : Set ι)),
      ∃ k : { x // x ∈ F₀ } → ℝ, (∀ i, |k i| ≤ M * ‖w‖) ∧
        w = ∑ i ∈ F₀.attach, k i • v (i : ι) := by
  classical
  set L := finsetEval v F₀ with hL
  have hsurj : LinearMap.range L.rangeRestrict = ⊤ := LinearMap.range_rangeRestrict L
  obtain ⟨g, hg⟩ := L.rangeRestrict.exists_rightInverse_of_surjective hsurj
  have hgc : Continuous ⇑g := LinearMap.continuous_of_finiteDimensional g
  set G : (↥(LinearMap.range L)) →L[ℝ] ({ x // x ∈ F₀ } → ℝ) := ⟨g, hgc⟩ with hG
  refine ⟨‖G‖, norm_nonneg G, fun w hw => ?_⟩
  have hwW : w ∈ LinearMap.range L := by
    rw [hL, range_finsetEval]
    exact hw
  set y : ↥(LinearMap.range L) := ⟨w, hwW⟩ with hy
  have hval : L.rangeRestrict (g y) = y := DFunLike.congr_fun hg y
  have hLg : L (g y) = w := by
    have hc := congrArg (fun z : ↥(LinearMap.range L) => (z : V)) hval
    simpa [LinearMap.rangeRestrict, hy] using hc
  refine ⟨G y, fun i => ?_, ?_⟩
  · have hbound : ‖G y‖ ≤ ‖G‖ * ‖y‖ := G.le_opNorm y
    have hcoord : |G y i| ≤ ‖G y‖ := by
      simpa using norm_le_pi_norm (G y) i
    have hynorm : ‖y‖ = ‖w‖ := rfl
    rw [← hynorm]
    exact le_trans hcoord hbound
  · have hGy : G y = g y := rfl
    rw [hGy, ← finsetEval_apply, ← hL, hLg]

/-! ## The countable compression -/

/-- **(24.164) The countable conic compression lemma.**  An absolutely convergent positive
combination in a finite-dimensional space is a positive combination of at most `finrank` of its
vectors. -/
theorem exists_finite_pos_combination_of_summable (v : ι → V) (a : ι → ℝ)
    (ha : ∀ i, 0 < a i) (hsum : Summable fun i => a i * ‖v i‖) :
    ∃ (G : Finset ι) (c : ι → ℝ), (∀ i ∈ G, 0 < c i) ∧
      LinearIndependent ℝ (fun i : G => v i) ∧
      G.card ≤ Module.finrank ℝ V ∧
      ∑' i, a i • v i = ∑ i ∈ G, c i • v i := by
  classical
  have hnormeq : ∀ i, ‖a i • v i‖ = a i * ‖v i‖ := by
    intro i
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (ha i)]
  have hsummable : Summable fun i => a i • v i := by
    refine Summable.of_norm ?_
    exact hsum.congr fun i => (hnormeq i).symm
  obtain ⟨F₀, hF₀⟩ := exists_finset_span_eq_span_range v
  obtain ⟨M, hM0, hMbound⟩ := exists_bounded_coeffs v F₀
  have hWclosed : IsClosed ((Submodule.span ℝ (v '' (F₀ : Set ι)) : Submodule ℝ V) : Set V) :=
    Submodule.closed_of_finiteDimensional _
  set amin : ℝ := if h : F₀.Nonempty then F₀.inf' h a else 1 with hamin
  have hamin_pos : 0 < amin := by
    rw [hamin]
    split
    · rename_i h
      obtain ⟨i, _, hival⟩ := F₀.exists_mem_eq_inf' h a
      rw [hival]
      exact ha i
    · norm_num
  have hamin_le : ∀ i ∈ F₀, amin ≤ a i := by
    intro i hi
    have hne : F₀.Nonempty := ⟨i, hi⟩
    rw [hamin, dif_pos hne]
    exact Finset.inf'_le a hi
  set eps : ℝ := amin / (2 * (M + 1)) with heps
  have hMplus : (0 : ℝ) < M + 1 := by linarith
  have heps_pos : 0 < eps := by
    rw [heps]
    positivity
  have hev : {s : Finset ι | ∑ i ∈ s, a i • v i ∈ Metric.ball (∑' i, a i • v i) eps} ∈
      (atTop : Filter (Finset ι)) :=
    hsummable.hasSum (Metric.ball_mem_nhds _ heps_pos)
  obtain ⟨F₁, hF₁⟩ := Filter.eventually_atTop.1 hev
  set F : Finset ι := F₀ ∪ F₁ with hF
  have hball := hF₁ F (by rw [hF]; exact Finset.subset_union_right)
  set t : V := (∑' i, a i • v i) - ∑ i ∈ F, a i • v i with ht
  have htsmall : ‖t‖ < eps := by
    have hd : dist (∑ i ∈ F, a i • v i) (∑' i, a i • v i) < eps := hball
    rw [dist_eq_norm] at hd
    rw [ht, ← norm_neg]
    simpa using hd
  have htail : (∑' i, a i • v i) ∈ Submodule.span ℝ (v '' (F₀ : Set ι)) := by
    refine hWclosed.mem_of_tendsto hsummable.hasSum ?_
    filter_upwards with s
    rw [hF₀]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hpart : (∑ i ∈ F, a i • v i) ∈ Submodule.span ℝ (v '' (F₀ : Set ι)) := by
    rw [hF₀]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have htmem : t ∈ Submodule.span ℝ (v '' (F₀ : Set ι)) := by
    rw [ht]
    exact Submodule.sub_mem _ htail hpart
  obtain ⟨k, hkbound, hkval⟩ := hMbound t htmem
  obtain ⟨k', hk'mem, hk'not⟩ :
      ∃ k' : ι → ℝ, (∀ i, ∀ h : i ∈ F₀, k' i = k ⟨i, h⟩) ∧ (∀ i, i ∉ F₀ → k' i = 0) := by
    refine ⟨fun i => if h : i ∈ F₀ then k ⟨i, h⟩ else 0, fun i h => dif_pos h,
      fun i h => dif_neg h⟩
  have hk'sum : ∑ i ∈ F₀, k' i • v i = t := by
    rw [hkval, ← Finset.sum_attach F₀ fun i => k' i • v i]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hk'mem (i : ι) i.2]
  obtain ⟨b, hbdef⟩ : ∃ b : ι → ℝ, ∀ i, b i = a i + k' i := ⟨fun i => a i + k' i, fun _ => rfl⟩
  have hhalf : M * eps ≤ amin / 2 := by
    rw [heps, mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [hamin_pos, hM0]
  have hbpos : ∀ i ∈ F, 0 < b i := by
    intro i hi
    by_cases hiF₀ : i ∈ F₀
    · have hk : |k' i| ≤ M * ‖t‖ := by
        rw [hk'mem i hiF₀]
        exact hkbound _
      have hMt : M * ‖t‖ ≤ M * eps := mul_le_mul_of_nonneg_left htsmall.le hM0
      have hlow : -(amin / 2) ≤ k' i := by
        have habs := abs_le.1 hk
        linarith [habs.1]
      have hamin_i : amin ≤ a i := hamin_le i hiF₀
      rw [hbdef]
      linarith
    · rw [hbdef, hk'not i hiF₀, add_zero]
      exact ha i
  have hbsum : ∑ i ∈ F, b i • v i = ∑' i, a i • v i := by
    have hF₀F : F₀ ⊆ F := by rw [hF]; exact Finset.subset_union_left
    have hsplit : ∑ i ∈ F, b i • v i
        = (∑ i ∈ F, a i • v i) + ∑ i ∈ F, k' i • v i := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [hbdef, add_smul]
    have hrestrict : ∑ i ∈ F, k' i • v i = ∑ i ∈ F₀, k' i • v i := by
      refine (Finset.sum_subset hF₀F fun i _ hnot => ?_).symm
      rw [hk'not i hnot, zero_smul]
    rw [hsplit, hrestrict, hk'sum, ht]
    abel
  obtain ⟨G, c, hGF, hcpos, hli, hcard, hcsum⟩ :=
    exists_pos_combination_card_le_finrank v F b hbpos
  exact ⟨G, c, hcpos, hli, hcard, hbsum.symm.trans hcsum⟩

end GaloisForLFunctions.HTGeometry
