import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

/-- The field generated by a family and all its jets is the ordinary field generated by the
single jet-indexed family. -/
theorem differentialAdjoin_range_eq_adjoin_jetRange
    (F : Type*) {K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : ι → K) :
    differentialAdjoin F (Set.range x) =
      IntermediateField.adjoin F
        (Set.range fun p : ι × ℕ => differentialJet p.2 (x p.1)) := by
  unfold differentialAdjoin
  congr 1
  ext z
  constructor
  · rintro ⟨w, ⟨i, rfl⟩, n, rfl⟩
    exact ⟨(i, n), rfl⟩
  · rintro ⟨⟨i, n⟩, rfl⟩
    exact ⟨x i, ⟨i, rfl⟩, n, rfl⟩

/-- The canonical rational jet-field parametrization of a differentially independent palette. -/
def differentialIndependentAdjoinParametrization
    {F K ι : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K]
    (x : ι → K) (hx : DifferentialIndependent F x) :
    FractionRing (MvPolynomial (ι × ℕ) F) ≃ₐ[F]
      differentialAdjoin F (Set.range x) := by
  let jx : ι × ℕ → K := fun p => differentialJet p.2 (x p.1)
  have hxj : AlgebraicIndependent F jx := hx
  let ex0 : FractionRing (MvPolynomial (ι × ℕ) F) ≃ₐ[F]
      IntermediateField.adjoin F (Set.range jx) := hxj.aevalEquivField
  exact ex0.trans (IntermediateField.equivOfEq
    (differentialAdjoin_range_eq_adjoin_jetRange F x).symm)

@[simp]
theorem differentialIndependentAdjoinParametrization_X
    {F K ι : Type*} [Field F] [Field K]
    [Algebra F K] [Differential K]
    (x : ι → K) (hx : DifferentialIndependent F x) (i : ι) (n : ℕ) :
    differentialIndependentAdjoinParametrization x hx
        (algebraMap (MvPolynomial (ι × ℕ) F)
          (FractionRing (MvPolynomial (ι × ℕ) F)) (MvPolynomial.X (i, n))) =
      ⟨differentialJet n (x i),
        differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩ := by
  apply Subtype.ext
  simp [differentialIndependentAdjoinParametrization]

/-- Any two equally indexed differentially independent palettes generate canonically isomorphic
labelled fields over the coefficient field. -/
def differentialIndependentAdjoinAlgEquiv
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra F L] [Differential K] [Differential L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y) :
    differentialAdjoin F (Set.range x) ≃ₐ[F]
      differentialAdjoin F (Set.range y) :=
  (differentialIndependentAdjoinParametrization x hx).symm.trans
    (differentialIndependentAdjoinParametrization y hy)

@[simp]
theorem differentialIndependentAdjoinAlgEquiv_jet
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra F L] [Differential K] [Differential L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (i : ι) (n : ℕ) :
    differentialIndependentAdjoinAlgEquiv x y hx hy
        ⟨differentialJet n (x i),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩ =
      ⟨differentialJet n (y i),
        differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩ := by
  let q : FractionRing (MvPolynomial (ι × ℕ) F) :=
    algebraMap (MvPolynomial (ι × ℕ) F)
      (FractionRing (MvPolynomial (ι × ℕ) F)) (MvPolynomial.X (i, n))
  have hxpre :
      (differentialIndependentAdjoinParametrization x hx).symm
          ⟨differentialJet n (x i),
            differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩ = q := by
    apply (differentialIndependentAdjoinParametrization x hx).injective
    simp [q]
  change (differentialIndependentAdjoinParametrization y hy)
      ((differentialIndependentAdjoinParametrization x hx).symm _) = _
  rw [hxpre]
  exact differentialIndependentAdjoinParametrization_X y hy i n

/-- The canonical labelled field equivalence commutes with the derivation. -/
theorem differentialIndependentAdjoinAlgEquiv_deriv
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Differential F] [Differential K] [Differential L]
    [Algebra F K] [Algebra F L]
    [DifferentialAlgebra F K] [DifferentialAlgebra F L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (z : differentialAdjoin F (Set.range x)) :
    differentialIndependentAdjoinAlgEquiv x y hx hy z′ =
      (differentialIndependentAdjoinAlgEquiv x y hx hy z)′ := by
  apply Subtype.ext
  change ((differentialIndependentAdjoinAlgEquiv x y hx hy)
      ⟨z.1′, derivationClosed_differentialAdjoin F (Set.range x) z.2⟩).1 =
    ((differentialIndependentAdjoinAlgEquiv x y hx hy z).1)′
  let e := differentialIndependentAdjoinAlgEquiv x y hx hy
  let hclosedX := derivationClosed_differentialAdjoin F (Set.range x)
  apply IntermediateField.adjoin_induction F (s := differentialJetSet (Set.range x))
    (p := fun u hu =>
      (e ⟨u′, hclosedX hu⟩).1 = (e ⟨u, hu⟩).1′)
  · rintro u ⟨w, ⟨i, rfl⟩, n, rfl⟩
    have hmapn := congrArg Subtype.val
      (differentialIndependentAdjoinAlgEquiv_jet x y hx hy i n)
    have hmapn1 := congrArg Subtype.val
      (differentialIndependentAdjoinAlgEquiv_jet x y hx hy i (n + 1))
    change (e ⟨(differentialJet n (x i))′, _⟩).1 =
      (e ⟨differentialJet n (x i), _⟩).1′
    have hsuccX :
        (⟨(differentialJet n (x i))′, hclosedX
            (differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n)⟩ :
          differentialAdjoin F (Set.range x)) =
          ⟨differentialJet (n + 1) (x i),
            differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) (n + 1)⟩ := by
      apply Subtype.ext
      exact (differentialJet_succ n (x i)).symm
    calc
      (e ⟨(differentialJet n (x i))′, _⟩).1 =
          (e ⟨differentialJet (n + 1) (x i), _⟩).1 := by
            exact congrArg (fun t => (e t).1) hsuccX
      _ = differentialJet (n + 1) (y i) := hmapn1
      _ = (differentialJet n (y i))′ := differentialJet_succ n (y i)
      _ = (e ⟨differentialJet n (x i), _⟩).1′ := by
        exact congrArg Differential.deriv hmapn.symm
  · intro c
    have hdmap :
        (⟨(algebraMap F K c)′, hclosedX (IntermediateField.algebraMap_mem _ c)⟩ :
          differentialAdjoin F (Set.range x)) =
          algebraMap F (differentialAdjoin F (Set.range x)) c′ := by
      apply Subtype.ext
      exact deriv_algebraMap c
    calc
      (e ⟨(algebraMap F K c)′, _⟩).1 =
          (e (algebraMap F (differentialAdjoin F (Set.range x)) c′)).1 := by
            exact congrArg (fun t => (e t).1) hdmap
      _ = algebraMap F L c′ := by simp [e]
      _ = (algebraMap F L c)′ := (deriv_algebraMap c).symm
      _ = (e ⟨algebraMap F K c, _⟩).1′ := by
        exact congrArg Differential.deriv
          (congrArg Subtype.val (e.commutes c)).symm
  · intro a b ha hb hda hdb
    have hdadd :
        (⟨(a + b)′, hclosedX (IntermediateField.add_mem _ ha hb)⟩ :
          differentialAdjoin F (Set.range x)) =
          ⟨a′, hclosedX ha⟩ + ⟨b′, hclosedX hb⟩ := by
      apply Subtype.ext
      exact Differential.deriv.map_add a b
    calc
      (e ⟨(a + b)′, _⟩).1 =
          (e (⟨a′, hclosedX ha⟩ + ⟨b′, hclosedX hb⟩)).1 := by
            exact congrArg (fun t => (e t).1) hdadd
      _ = (e ⟨a′, hclosedX ha⟩).1 + (e ⟨b′, hclosedX hb⟩).1 := by
        exact congrArg Subtype.val (e.map_add ⟨a′, hclosedX ha⟩ ⟨b′, hclosedX hb⟩)
      _ = (e ⟨a, ha⟩).1′ + (e ⟨b, hb⟩).1′ := congrArg₂ (· + ·) hda hdb
      _ = ((e ⟨a, ha⟩).1 + (e ⟨b, hb⟩).1)′ :=
        (Differential.deriv.map_add _ _).symm
      _ = (e ⟨a + b, _⟩).1′ := by
        exact congrArg Differential.deriv
          (congrArg Subtype.val (e.map_add ⟨a, ha⟩ ⟨b, hb⟩)).symm
  · intro a ha hda
    let A : differentialAdjoin F (Set.range x) := ⟨a, ha⟩
    have hsourceInv :
        (⟨a⁻¹, IntermediateField.inv_mem _ ha⟩ :
          differentialAdjoin F (Set.range x)) = A⁻¹ := by
      apply Subtype.ext
      rfl
    have heInv :
        (e ⟨a⁻¹, IntermediateField.inv_mem _ ha⟩).1 = (e A).1⁻¹ := by
      calc
        (e ⟨a⁻¹, IntermediateField.inv_mem _ ha⟩).1 = (e (A⁻¹)).1 := by
          exact congrArg (fun t => (e t).1) hsourceInv
        _ = (e A).1⁻¹ := by
          exact congrArg Subtype.val (map_inv₀ e.toRingEquiv A)
    have hdinv :
        (⟨(a⁻¹)′, hclosedX (IntermediateField.inv_mem _ ha)⟩ :
          differentialAdjoin F (Set.range x)) =
          -(⟨a, ha⟩⁻¹) ^ (2 : ℕ) * ⟨a′, hclosedX ha⟩ := by
      apply Subtype.ext
      simpa [smul_eq_mul] using Derivation.leibniz_inv Differential.deriv a
    calc
      (e ⟨(a⁻¹)′, _⟩).1 =
          (e (-⟨a, ha⟩⁻¹ ^ (2 : ℕ) * ⟨a′, hclosedX ha⟩)).1 := by
            exact congrArg (fun t => (e t).1) hdinv
      _ = -(e ⟨a, ha⟩).1⁻¹ ^ (2 : ℕ) * (e ⟨a′, hclosedX ha⟩).1 := by simp
      _ = -(e ⟨a, ha⟩).1⁻¹ ^ (2 : ℕ) * (e ⟨a, ha⟩).1′ := by rw [hda]
      _ = ((e ⟨a, ha⟩).1⁻¹)′ := by
        simpa [smul_eq_mul] using (Derivation.leibniz_inv Differential.deriv (e ⟨a, ha⟩).1).symm
      _ = (e ⟨a⁻¹, _⟩).1′ := by
        exact congrArg Differential.deriv heInv.symm
  · intro a b ha hb hda hdb
    have hdmul :
        (⟨(a * b)′, hclosedX (IntermediateField.mul_mem _ ha hb)⟩ :
          differentialAdjoin F (Set.range x)) =
          ⟨a, ha⟩ * ⟨b′, hclosedX hb⟩ + ⟨b, hb⟩ * ⟨a′, hclosedX ha⟩ := by
      apply Subtype.ext
      change (a * b)′ = a * b′ + b * a′
      simpa only [smul_eq_mul] using Derivation.leibniz Differential.deriv a b
    calc
      (e ⟨(a * b)′, _⟩).1 =
          (e (⟨a, ha⟩ * ⟨b′, hclosedX hb⟩ +
            ⟨b, hb⟩ * ⟨a′, hclosedX ha⟩)).1 := by
              exact congrArg (fun t => (e t).1) hdmul
      _ = (e ⟨a, ha⟩).1 * (e ⟨b′, hclosedX hb⟩).1 +
          (e ⟨b, hb⟩).1 * (e ⟨a′, hclosedX ha⟩).1 := by simp
      _ = (e ⟨a, ha⟩).1 * (e ⟨b, hb⟩).1′ +
          (e ⟨b, hb⟩).1 * (e ⟨a, ha⟩).1′ := by rw [hda, hdb]
      _ = ((e ⟨a, ha⟩).1 * (e ⟨b, hb⟩).1)′ := by
        rw [Derivation.leibniz]
        simp [smul_eq_mul]
      _ = (e ⟨a * b, _⟩).1′ := by
        exact congrArg Differential.deriv
          (congrArg Subtype.val (e.map_mul ⟨a, ha⟩ ⟨b, hb⟩)).symm

/-- The canonical labelled equivalence is the unique base-field equivalence carrying each
labelled jet to its counterpart. -/
theorem differentialIndependentAdjoinAlgEquiv_unique_of_jet
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra F L] [Differential K] [Differential L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (e : differentialAdjoin F (Set.range x) ≃ₐ[F]
      differentialAdjoin F (Set.range y))
    (hjet : ∀ i n,
      e ⟨differentialJet n (x i),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩ =
        ⟨differentialJet n (y i),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩) :
    e = differentialIndependentAdjoinAlgEquiv x y hx hy := by
  have hhom : e.toAlgHom =
      (differentialIndependentAdjoinAlgEquiv x y hx hy).toAlgHom := by
    unfold differentialAdjoin
    apply IntermediateField.adjoin_algHom_ext
    rintro u ⟨w, ⟨i, rfl⟩, n, rfl⟩
    exact (hjet i n).trans
      (differentialIndependentAdjoinAlgEquiv_jet x y hx hy i n).symm
  apply AlgEquiv.ext
  exact AlgHom.congr_fun hhom

/-- A derivation-preserving base-field equivalence between two freely generated differential
fields is uniquely determined by the labelled order-zero generators. -/
theorem differentialIndependentAdjoinAlgEquiv_unique
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Differential F] [Differential K] [Differential L]
    [Algebra F K] [Algebra F L]
    [DifferentialAlgebra F K] [DifferentialAlgebra F L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (e : differentialAdjoin F (Set.range x) ≃ₐ[F]
      differentialAdjoin F (Set.range y))
    (hsource : ∀ i,
      e ⟨x i, subset_differentialAdjoin F (Set.range x) (Set.mem_range_self i)⟩ =
        ⟨y i, subset_differentialAdjoin F (Set.range y) (Set.mem_range_self i)⟩)
    (hderiv : ∀ z, e z′ = (e z)′) :
    e = differentialIndependentAdjoinAlgEquiv x y hx hy := by
  apply differentialIndependentAdjoinAlgEquiv_unique_of_jet x y hx hy e
  intro i n
  induction n with
  | zero =>
      simpa only [differentialJet_zero] using hsource i
  | succ n ih =>
      let Xn : differentialAdjoin F (Set.range x) :=
        ⟨differentialJet n (x i),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩
      let Yn : differentialAdjoin F (Set.range y) :=
        ⟨differentialJet n (y i),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) n⟩
      have hstepX : Xn′ =
          (⟨differentialJet (n + 1) (x i),
            differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) (n + 1)⟩ :
              differentialAdjoin F (Set.range x)) := by
        apply Subtype.ext
        exact (differentialJet_succ n (x i)).symm
      have hstepY : Yn′ =
          (⟨differentialJet (n + 1) (y i),
            differentialJet_mem_differentialAdjoin F (Set.mem_range_self i) (n + 1)⟩ :
              differentialAdjoin F (Set.range y)) := by
        apply Subtype.ext
        exact (differentialJet_succ n (y i)).symm
      calc
        e ⟨differentialJet (n + 1) (x i), _⟩ = e Xn′ := by
          exact congrArg e hstepX.symm
        _ = (e Xn)′ := hderiv Xn
        _ = Yn′ := congrArg Differential.deriv ih
        _ = ⟨differentialJet (n + 1) (y i), _⟩ := hstepY

end

end GaloisForLFunctions
