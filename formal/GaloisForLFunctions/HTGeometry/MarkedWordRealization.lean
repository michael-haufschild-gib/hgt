import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.RingTheory.TensorProduct.Finite
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Marked word presentations and their minimal realizations

A finite linear marked presentation reads a word by composing its letter operators, marks an
initial state and reads out a scalar.  Two minimal presentations with the same complete word
response are related by a unique response-preserving linear equivalence; this is the exact
presentation-invariance law for finite-linear marked processes.
-/

open Function

namespace GaloisForLFunctions.HTGeometry

/-- A marked linear presentation over an alphabet. -/
structure MarkedPresentation (K : Type*) [Field K] (A : Type*) (V : Type*)
    [AddCommGroup V] [Module K V] where
  /-- The source mark. -/
  init : V
  /-- The scalar readout. -/
  out : V →ₗ[K] K
  /-- The letter action. -/
  step : A → (V →ₗ[K] V)

namespace MarkedPresentation

variable {K : Type*} [Field K] {A : Type*}
variable {V : Type*} [AddCommGroup V] [Module K V]
variable {W : Type*} [AddCommGroup W] [Module K W]

/-- The word action reads the letters left to right. -/
def wordAction (P : MarkedPresentation K A V) : List A → (V →ₗ[K] V)
  | [] => LinearMap.id
  | a :: w => (P.wordAction w).comp (P.step a)

@[simp] theorem wordAction_nil (P : MarkedPresentation K A V) :
    P.wordAction [] = LinearMap.id := rfl

@[simp] theorem wordAction_cons (P : MarkedPresentation K A V) (a : A) (w : List A) :
    P.wordAction (a :: w) = (P.wordAction w).comp (P.step a) := rfl

theorem wordAction_append (P : MarkedPresentation K A V) (u v : List A) :
    P.wordAction (u ++ v) = (P.wordAction v).comp (P.wordAction u) := by
  induction u with
  | nil => simp
  | cons a u ih =>
      rw [List.cons_append, wordAction_cons, ih, wordAction_cons]
      ext x
      rfl

/-- The complete word response of a marked presentation. -/
def response (P : MarkedPresentation K A V) (w : List A) : K := P.out (P.wordAction w P.init)

@[simp] theorem response_apply (P : MarkedPresentation K A V) (w : List A) :
    P.response w = P.out (P.wordAction w P.init) := rfl

/-- The reachable subspace generated by the source mark. -/
def reachableSpan (P : MarkedPresentation K A V) : Submodule K V :=
  Submodule.span K (Set.range fun w : List A => P.wordAction w P.init)

/-- A presentation is reachable when its source mark generates the carrier. -/
def Reachable (P : MarkedPresentation K A V) : Prop := P.reachableSpan = ⊤

/-- The invisible subspace: states annihilated by every future readout. -/
def unobservable (P : MarkedPresentation K A V) : Submodule K V :=
  ⨅ w : List A, LinearMap.ker (P.out.comp (P.wordAction w))

/-- A presentation is observable when no nonzero state is invisible. -/
def Observable (P : MarkedPresentation K A V) : Prop := P.unobservable = ⊥

/-- A presentation is minimal when it is reachable and observable. -/
def Minimal (P : MarkedPresentation K A V) : Prop := P.Reachable ∧ P.Observable

theorem mem_unobservable_iff (P : MarkedPresentation K A V) (x : V) :
    x ∈ P.unobservable ↔ ∀ w : List A, P.out (P.wordAction w x) = 0 := by
  rw [unobservable, Submodule.mem_iInf]
  constructor
  · intro h w
    exact h w
  · intro h w
    exact h w

/-! ## The synthesis map -/

/-- Synthesis: send a finitely supported word coefficient family to the state it produces. -/
noncomputable def synthesis (P : MarkedPresentation K A V) : (List A →₀ K) →ₗ[K] V :=
  Finsupp.linearCombination K fun w : List A => P.wordAction w P.init

@[simp] theorem synthesis_single (P : MarkedPresentation K A V) (w : List A) (c : K) :
    P.synthesis (Finsupp.single w c) = c • P.wordAction w P.init := by
  rw [synthesis, Finsupp.linearCombination_single]

theorem range_synthesis (P : MarkedPresentation K A V) :
    LinearMap.range P.synthesis = P.reachableSpan := by
  rw [synthesis, Finsupp.range_linearCombination, reachableSpan]

theorem surjective_synthesis {P : MarkedPresentation K A V} (hP : P.Reachable) :
    Surjective P.synthesis := by
  rw [← LinearMap.range_eq_top, range_synthesis]
  exact hP

theorem out_wordAction_synthesis (P : MarkedPresentation K A V) (x : List A →₀ K)
    (v : List A) :
    P.out (P.wordAction v (P.synthesis x)) = x.sum fun w c => c * P.response (w ++ v) := by
  rw [synthesis, Finsupp.linearCombination_apply, Finsupp.sum]
  rw [map_sum, map_sum]
  rw [Finsupp.sum]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [map_smul, map_smul, smul_eq_mul, response_apply, wordAction_append]
  rfl

theorem ker_synthesis_eq_of_response_eq {P : MarkedPresentation K A V}
    {Q : MarkedPresentation K A W} (hP : P.Observable) (hQ : Q.Observable)
    (hr : ∀ w : List A, P.response w = Q.response w) :
    LinearMap.ker P.synthesis = LinearMap.ker Q.synthesis := by
  have key : ∀ (R : MarkedPresentation K A V) (_ : R.Observable) (x : List A →₀ K),
      R.synthesis x = 0 ↔ ∀ v : List A, (x.sum fun w c => c * R.response (w ++ v)) = 0 := by
    intro R hR x
    constructor
    · intro h v
      rw [← out_wordAction_synthesis R x v, h]
      simp
    · intro h
      have hmem : R.synthesis x ∈ R.unobservable := by
        rw [mem_unobservable_iff]
        intro v
        rw [out_wordAction_synthesis R x v]
        exact h v
      rw [hR] at hmem
      simpa using hmem
  have keyQ : ∀ (x : List A →₀ K),
      Q.synthesis x = 0 ↔ ∀ v : List A, (x.sum fun w c => c * Q.response (w ++ v)) = 0 := by
    intro x
    constructor
    · intro h v
      rw [← out_wordAction_synthesis Q x v, h]
      simp
    · intro h
      have hmem : Q.synthesis x ∈ Q.unobservable := by
        rw [mem_unobservable_iff]
        intro v
        rw [out_wordAction_synthesis Q x v]
        exact h v
      rw [hQ] at hmem
      simpa using hmem
  ext x
  rw [LinearMap.mem_ker, LinearMap.mem_ker, key P hP x, keyQ x]
  constructor
  · intro h v
    rw [← h v]
    refine Finsupp.sum_congr fun w _ => ?_
    rw [hr]
  · intro h v
    rw [← h v]
    refine Finsupp.sum_congr fun w _ => ?_
    rw [hr]

/-! ## Theorem 2.1 — unique minimal marked realization -/

theorem synthesis_single_nil (P : MarkedPresentation K A V) :
    P.synthesis (Finsupp.single [] (1 : K)) = P.init := by
  rw [synthesis_single, wordAction_nil, one_smul, LinearMap.id_apply]

theorem step_synthesis (P : MarkedPresentation K A V) (a : A) (y : List A →₀ K) :
    P.step a (P.synthesis y) = P.synthesis (y.mapDomain fun w => w ++ [a]) := by
  classical
  unfold synthesis
  rw [Finsupp.linearCombination_apply, Finsupp.linearCombination_apply,
    Finsupp.sum_mapDomain_index_inj (by
      intro u v huv
      exact List.append_cancel_right huv)]
  rw [Finsupp.sum, Finsupp.sum, map_sum]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [map_smul, wordAction_append]
  rfl

theorem out_synthesis (P : MarkedPresentation K A V) (y : List A →₀ K) :
    P.out (P.synthesis y) = y.sum fun w c => c * P.response w := by
  have h := out_wordAction_synthesis P y []
  rw [wordAction_nil] at h
  simpa using h

variable {P : MarkedPresentation K A V} {Q : MarkedPresentation K A W}

/-- The canonical marked equivalence between two minimal presentations of one response. -/
noncomputable def markedEquiv (hP : P.Minimal) (hQ : Q.Minimal)
    (hr : ∀ w : List A, P.response w = Q.response w) : V ≃ₗ[K] W :=
  (LinearMap.quotKerEquivOfSurjective P.synthesis (surjective_synthesis hP.1)).symm.trans
    ((Submodule.quotEquivOfEq _ _ (ker_synthesis_eq_of_response_eq hP.2 hQ.2 hr)).trans
      (LinearMap.quotKerEquivOfSurjective Q.synthesis (surjective_synthesis hQ.1)))

theorem markedEquiv_synthesis (hP : P.Minimal) (hQ : Q.Minimal)
    (hr : ∀ w : List A, P.response w = Q.response w) (x : List A →₀ K) :
    markedEquiv hP hQ hr (P.synthesis x) = Q.synthesis x := by
  rw [markedEquiv]
  simp only [LinearEquiv.trans_apply]
  rw [show (LinearMap.quotKerEquivOfSurjective P.synthesis
      (surjective_synthesis hP.1)).symm (P.synthesis x)
      = Submodule.Quotient.mk x by
    refine (LinearEquiv.symm_apply_eq _).2 ?_
    rfl]
  rfl

/-- **Theorem 2.1** (MR.5).  The marked equivalence transports the source mark, intertwines every
letter action, and recovers the readout. -/
theorem markedEquiv_spec (hP : P.Minimal) (hQ : Q.Minimal)
    (hr : ∀ w : List A, P.response w = Q.response w) :
    markedEquiv hP hQ hr P.init = Q.init ∧
      (∀ a : A, ∀ x : V, markedEquiv hP hQ hr (P.step a x) = Q.step a (markedEquiv hP hQ hr x)) ∧
      (∀ x : V, Q.out (markedEquiv hP hQ hr x) = P.out x) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [← synthesis_single_nil P, markedEquiv_synthesis hP hQ hr, synthesis_single_nil]
  · intro a x
    obtain ⟨y, rfl⟩ := surjective_synthesis hP.1 x
    rw [step_synthesis, markedEquiv_synthesis hP hQ hr, markedEquiv_synthesis hP hQ hr,
      step_synthesis]
  · intro x
    obtain ⟨y, rfl⟩ := surjective_synthesis hP.1 x
    rw [markedEquiv_synthesis hP hQ hr, out_synthesis, out_synthesis]
    refine Finsupp.sum_congr fun w _ => ?_
    rw [hr]

/-- **Theorem 2.1, uniqueness.**  A reachable source mark pins the marked equivalence. -/
theorem markedEquiv_unique (hP : P.Minimal) {S T : V →ₗ[K] W}
    (hSi : S P.init = Q.init) (hSa : ∀ a : A, ∀ x : V, S (P.step a x) = Q.step a (S x))
    (hTi : T P.init = Q.init) (hTa : ∀ a : A, ∀ x : V, T (P.step a x) = Q.step a (T x)) :
    S = T := by
  have hgen : ∀ w : List A, S (P.wordAction w P.init) = T (P.wordAction w P.init) := by
    intro w
    induction w using List.reverseRecOn with
    | nil => rw [wordAction_nil, LinearMap.id_apply, hSi, hTi]
    | append_singleton w a ih =>
        rw [wordAction_append, wordAction_cons, wordAction_nil]
        show S (P.step a (P.wordAction w P.init)) = T (P.step a (P.wordAction w P.init))
        rw [hSa, hTa, ih]
  refine LinearMap.ext fun x => ?_
  have hx : x ∈ P.reachableSpan := by
    rw [hP.1]
    exact Submodule.mem_top
  refine Submodule.span_induction (p := fun v _ => S v = T v) ?_ ?_ ?_ ?_ hx
  · rintro v ⟨w, rfl⟩
    exact hgen w
  · simp
  · intro u v _ _ hu hv
    rw [map_add, map_add, hu, hv]
  · intro c v _ hv
    rw [map_smul, map_smul, hv]

/-- **Theorem 2.1.**  Between minimal presentations of one response there is exactly one marked
equivalence. -/
theorem existsUnique_markedEquiv (hP : P.Minimal) (hQ : Q.Minimal)
    (hr : ∀ w : List A, P.response w = Q.response w) :
    ∃! S : V →ₗ[K] W, S P.init = Q.init ∧
      (∀ a : A, ∀ x : V, S (P.step a x) = Q.step a (S x)) ∧
      (∀ x : V, Q.out (S x) = P.out x) := by
  obtain ⟨h1, h2, h3⟩ := markedEquiv_spec hP hQ hr
  refine ⟨(markedEquiv hP hQ hr : V →ₗ[K] W), ⟨h1, h2, h3⟩, ?_⟩
  rintro T ⟨hT1, hT2, _⟩
  exact markedEquiv_unique hP hT1 hT2 h1 h2

/-! ## Doctrine restriction and the exact two-term memory law -/

section Restriction

variable {B : Type*}

/-- Restrict a presentation to a sub-alphabet. -/
def restrict (P : MarkedPresentation K A V) (f : B → A) : MarkedPresentation K B V where
  init := P.init
  out := P.out
  step b := P.step (f b)

@[simp] theorem restrict_init (P : MarkedPresentation K A V) (f : B → A) :
    (P.restrict f).init = P.init := rfl

@[simp] theorem restrict_out (P : MarkedPresentation K A V) (f : B → A) :
    (P.restrict f).out = P.out := rfl

@[simp] theorem restrict_step (P : MarkedPresentation K A V) (f : B → A) (b : B) :
    (P.restrict f).step b = P.step (f b) := rfl

variable (P : MarkedPresentation K A V) (f : B → A)

theorem init_mem_reachableSpan (R : MarkedPresentation K B V) : R.init ∈ R.reachableSpan :=
  Submodule.subset_span ⟨[], by
    show R.wordAction [] R.init = R.init
    rw [wordAction_nil, LinearMap.id_apply]⟩

theorem step_mem_reachableSpan (R : MarkedPresentation K B V) (b : B) {x : V}
    (hx : x ∈ R.reachableSpan) : R.step b x ∈ R.reachableSpan := by
  refine Submodule.span_induction (p := fun v _ => R.step b v ∈ R.reachableSpan) ?_ ?_ ?_ ?_ hx
  · rintro v ⟨w, rfl⟩
    refine Submodule.subset_span ⟨w ++ [b], ?_⟩
    show R.wordAction (w ++ [b]) R.init = R.step b (R.wordAction w R.init)
    rw [wordAction_append, wordAction_cons, wordAction_nil]
    rfl
  · rw [map_zero]
    exact Submodule.zero_mem _
  · intro u v _ _ hu hv
    rw [map_add]
    exact Submodule.add_mem _ hu hv
  · intro c v _ hv
    rw [map_smul]
    exact Submodule.smul_mem _ c hv

theorem step_mem_unobservable (R : MarkedPresentation K B V) (b : B) {x : V}
    (hx : x ∈ R.unobservable) : R.step b x ∈ R.unobservable := by
  rw [mem_unobservable_iff] at hx ⊢
  intro w
  have := hx (b :: w)
  rwa [wordAction_cons] at this

/-- The restricted reachable subspace. -/
def restrictedReachable : Submodule K V := (P.restrict f).reachableSpan

/-- The restricted invisible subspace inside the restricted reachable subspace. -/
def restrictedInvisible : Submodule K (P.restrictedReachable f) :=
  (P.restrict f).unobservable.comap (P.restrictedReachable f).subtype

/-- Every restricted letter action preserves the restricted reachable subspace. -/
def restrictedStep (b : B) : P.restrictedReachable f →ₗ[K] P.restrictedReachable f :=
  ((P.restrict f).step b).restrict fun _ hx => step_mem_reachableSpan (P.restrict f) b hx

theorem restrictedStep_coe (b : B) (x : P.restrictedReachable f) :
    ((P.restrictedStep f b x : P.restrictedReachable f) : V) = (P.restrict f).step b (x : V) := rfl

theorem restrictedStep_mapsTo (b : B) :
    P.restrictedInvisible f ≤ (P.restrictedInvisible f).comap (P.restrictedStep f b) := by
  intro x hx
  rw [Submodule.mem_comap, restrictedInvisible, Submodule.mem_comap]
  rw [restrictedInvisible, Submodule.mem_comap] at hx
  exact step_mem_unobservable (P.restrict f) b hx

/-- The minimal carrier of the restricted doctrine. -/
abbrev restrictedCarrier : Type _ :=
  (P.restrictedReachable f) ⧸ (P.restrictedInvisible f)

theorem restrictedInvisible_le_ker_out :
    P.restrictedInvisible f ≤ LinearMap.ker (P.out.comp (P.restrictedReachable f).subtype) := by
  intro x hx
  rw [restrictedInvisible, Submodule.mem_comap, mem_unobservable_iff] at hx
  have h := hx []
  rw [wordAction_nil] at h
  simpa using h

/-- The restricted minimal presentation on the quotient carrier (MR.9). -/
noncomputable def restrictedMinimal : MarkedPresentation K B (P.restrictedCarrier f) where
  init := Submodule.Quotient.mk ⟨P.init, init_mem_reachableSpan (P.restrict f)⟩
  out := (P.restrictedInvisible f).liftQ (P.out.comp (P.restrictedReachable f).subtype)
    (P.restrictedInvisible_le_ker_out f)
  step b := (P.restrictedInvisible f).mapQ (P.restrictedInvisible f) (P.restrictedStep f b)
    (P.restrictedStep_mapsTo f b)

theorem restrictedMinimal_wordAction (w : List B) (x : P.restrictedReachable f) :
    (P.restrictedMinimal f).wordAction w (Submodule.Quotient.mk x)
      = Submodule.Quotient.mk (⟨(P.restrict f).wordAction w (x : V),
        by
          induction w generalizing x with
          | nil =>
              rw [wordAction_nil]
              exact x.2
          | cons b w ih =>
              rw [wordAction_cons]
              exact ih ⟨(P.restrict f).step b (x : V),
                step_mem_reachableSpan (P.restrict f) b x.2⟩⟩
        : P.restrictedReachable f) := by
  induction w generalizing x with
  | nil => rfl
  | cons b w ih =>
      rw [wordAction_cons]
      show (P.restrictedMinimal f).wordAction w
          ((P.restrictedMinimal f).step b (Submodule.Quotient.mk x)) = _
      rw [show (P.restrictedMinimal f).step b (Submodule.Quotient.mk x)
          = Submodule.Quotient.mk (P.restrictedStep f b x) from rfl, ih]
      rfl

/-- The restricted minimal presentation realizes the restricted response. -/
theorem restrictedMinimal_response (w : List B) :
    (P.restrictedMinimal f).response w = (P.restrict f).response w := by
  rw [response_apply, response_apply]
  show (P.restrictedMinimal f).out
      ((P.restrictedMinimal f).wordAction w (P.restrictedMinimal f).init) = _
  rw [show (P.restrictedMinimal f).init
      = Submodule.Quotient.mk ⟨P.init, init_mem_reachableSpan (P.restrict f)⟩ from rfl,
    restrictedMinimal_wordAction]
  rfl

/-! ## Minimality and the dimension law -/

theorem restrictedMinimal_reachable : (P.restrictedMinimal f).Reachable := by
  rw [Reachable, reachableSpan, Submodule.eq_top_iff']
  intro q
  induction q using Submodule.Quotient.induction_on with
  | H x =>
      have hx : (x : V) ∈ (P.restrict f).reachableSpan := x.2
      refine Submodule.span_induction
        (p := fun v hv => Submodule.Quotient.mk (⟨v, hv⟩ : P.restrictedReachable f)
          ∈ Submodule.span K (Set.range fun w : List B =>
            (P.restrictedMinimal f).wordAction w (P.restrictedMinimal f).init)) ?_ ?_ ?_ ?_ hx
      · rintro v ⟨w, rfl⟩
        refine Submodule.subset_span ⟨w, ?_⟩
        show (P.restrictedMinimal f).wordAction w (P.restrictedMinimal f).init = _
        rw [show (P.restrictedMinimal f).init
            = Submodule.Quotient.mk ⟨P.init, init_mem_reachableSpan (P.restrict f)⟩ from rfl,
          restrictedMinimal_wordAction]
        rfl
      · rw [show (⟨0, Submodule.zero_mem _⟩ : P.restrictedReachable f) = 0 from rfl]
        simp
      · intro u v hu hv hu' hv'
        rw [show (⟨u + v, Submodule.add_mem _ hu hv⟩ : P.restrictedReachable f)
            = ⟨u, hu⟩ + ⟨v, hv⟩ from rfl, Submodule.Quotient.mk_add]
        exact Submodule.add_mem _ hu' hv'
      · intro c v hv hv'
        rw [show (⟨c • v, Submodule.smul_mem _ c hv⟩ : P.restrictedReachable f)
            = c • (⟨v, hv⟩ : P.restrictedReachable f) from rfl, Submodule.Quotient.mk_smul]
        exact Submodule.smul_mem _ c hv'

theorem restrictedMinimal_observable : (P.restrictedMinimal f).Observable := by
  rw [Observable, Submodule.eq_bot_iff]
  intro q hq
  induction q using Submodule.Quotient.induction_on with
  | H x =>
      rw [mem_unobservable_iff] at hq
      have hx : (x : V) ∈ (P.restrict f).unobservable := by
        rw [mem_unobservable_iff]
        intro w
        have h := hq w
        rw [show (Submodule.Quotient.mk x : P.restrictedCarrier f)
            = Submodule.Quotient.mk x from rfl, restrictedMinimal_wordAction] at h
        exact h
      rw [Submodule.Quotient.mk_eq_zero]
      exact hx

theorem restrictedMinimal_minimal : (P.restrictedMinimal f).Minimal :=
  ⟨P.restrictedMinimal_reachable f, P.restrictedMinimal_observable f⟩

variable [FiniteDimensional K V]

/-- **Theorem 3.1** (MR.10).  The restricted minimal memory is the reachable dimension minus the
invisible dimension. -/
theorem finrank_restrictedCarrier :
    Module.finrank K (P.restrictedCarrier f)
      = Module.finrank K (P.restrictedReachable f)
        - Module.finrank K (P.restrictedInvisible f) := by
  have h : Module.finrank K ((P.restrictedReachable f) ⧸ (P.restrictedInvisible f))
      + Module.finrank K (P.restrictedInvisible f)
      = Module.finrank K (P.restrictedReachable f) :=
    Submodule.finrank_quotient_add_finrank (P.restrictedInvisible f)
  have hle2 : Module.finrank K (P.restrictedInvisible f)
      ≤ Module.finrank K (P.restrictedReachable f) := Submodule.finrank_le _
  show Module.finrank K ((P.restrictedReachable f) ⧸ (P.restrictedInvisible f)) = _
  omega

/-- **Theorem 3.2** (MR.11).  Doctrine-memory loss splits exactly into reachability birth and
observability repair. -/
theorem memory_conservation :
    Module.finrank K V - Module.finrank K (P.restrictedCarrier f)
      = (Module.finrank K V - Module.finrank K (P.restrictedReachable f))
        + Module.finrank K (P.restrictedInvisible f) := by
  have hle : Module.finrank K (P.restrictedReachable f) ≤ Module.finrank K V :=
    Submodule.finrank_le _
  have hle2 : Module.finrank K (P.restrictedInvisible f)
      ≤ Module.finrank K (P.restrictedReachable f) := Submodule.finrank_le _
  rw [finrank_restrictedCarrier]
  omega

/-- **Corollary 3.3** (MR.12).  The restricted doctrine keeps the full memory exactly when it is
both reachable and observable in the ambient carrier. -/
theorem finrank_restrictedCarrier_eq_iff :
    Module.finrank K (P.restrictedCarrier f) = Module.finrank K V
      ↔ P.restrictedReachable f = ⊤ ∧ P.restrictedInvisible f = ⊥ := by
  have hle : Module.finrank K (P.restrictedReachable f) ≤ Module.finrank K V :=
    Submodule.finrank_le _
  have hle2 : Module.finrank K (P.restrictedInvisible f)
      ≤ Module.finrank K (P.restrictedReachable f) := Submodule.finrank_le _
  constructor
  · intro heq
    rw [finrank_restrictedCarrier] at heq
    have hR : Module.finrank K (P.restrictedReachable f) = Module.finrank K V := by omega
    have hN : Module.finrank K (P.restrictedInvisible f) = 0 := by omega
    refine ⟨Submodule.eq_top_of_finrank_eq hR, ?_⟩
    exact Submodule.finrank_eq_zero.mp hN
  · rintro ⟨hR, hN⟩
    have h1 : Module.finrank K (P.restrictedReachable f) = Module.finrank K V := by
      rw [hR]
      simp
    have h2 : Module.finrank K (P.restrictedInvisible f) = 0 := by
      rw [hN]
      simp
    rw [finrank_restrictedCarrier, h1, h2]
    omega

end Restriction

/-! ## Higher-slot tensor composition -/

section Tensor

open TensorProduct

variable (P : MarkedPresentation K A V) (Q : MarkedPresentation K A W)

/-- The tensor presentation of two presentations on one alphabet (MR.13). -/
noncomputable def tensor : MarkedPresentation K A (V ⊗[K] W) where
  init := P.init ⊗ₜ[K] Q.init
  out := (TensorProduct.lid K K).toLinearMap.comp (TensorProduct.map P.out Q.out)
  step a := TensorProduct.map (P.step a) (Q.step a)

theorem tensor_wordAction (w : List A) :
    (P.tensor Q).wordAction w = TensorProduct.map (P.wordAction w) (Q.wordAction w) := by
  induction w with
  | nil =>
      rw [wordAction_nil, wordAction_nil, wordAction_nil]
      exact (TensorProduct.map_id (R := K) (M := V) (N := W)).symm
  | cons a w ih =>
      rw [wordAction_cons, wordAction_cons, wordAction_cons, ih]
      show TensorProduct.map (P.wordAction w) (Q.wordAction w) ∘ₗ
          TensorProduct.map (P.step a) (Q.step a) = _
      rw [← TensorProduct.map_comp]

/-- **Theorem 4.1** (MR.14).  The tensor presentation realizes the pointwise product law. -/
theorem tensor_response (w : List A) :
    (P.tensor Q).response w = P.response w * Q.response w := by
  rw [response_apply, tensor_wordAction]
  show (TensorProduct.lid K K)
      ((TensorProduct.map P.out Q.out)
        ((TensorProduct.map (P.wordAction w) (Q.wordAction w)) (P.init ⊗ₜ[K] Q.init))) = _
  rw [TensorProduct.map_tmul, TensorProduct.map_tmul]
  rw [TensorProduct.lid_tmul, smul_eq_mul]
  rfl

/-- The minimal carrier of a presentation. -/
abbrev minimalCarrier (R : MarkedPresentation K A V) : Type _ := R.restrictedCarrier (id : A → A)

variable [FiniteDimensional K V] [FiniteDimensional K W]

/-- **Theorem 4.1** (MR.15).  The minimal memory of a tensor formation is bounded by the product
of the carrier dimensions. -/
theorem finrank_tensor_minimalCarrier_le :
    Module.finrank K ((P.tensor Q).minimalCarrier)
      ≤ Module.finrank K V * Module.finrank K W := by
  have hle : Module.finrank K ((P.tensor Q).restrictedReachable (id : A → A))
      ≤ Module.finrank K (V ⊗[K] W) := Submodule.finrank_le _
  have hq := finrank_restrictedCarrier (P.tensor Q) (id : A → A)
  have hT : Module.finrank K (V ⊗[K] W) = Module.finrank K V * Module.finrank K W :=
    Module.finrank_tensorProduct
  show Module.finrank K ((P.tensor Q).restrictedCarrier (id : A → A)) ≤ _
  omega

end Tensor

/-! ## The Hankel realization and the cofinal doctrine law -/

section Hankel

variable (r : List A → K)

/-- The shift of a response by a prefix word. -/
def shiftResponse (w : List A) : List A → K := fun v => r (w ++ v)

omit [Field K] in
@[simp] theorem shiftResponse_nil : shiftResponse r [] = r := by
  funext v
  rw [shiftResponse, List.nil_append]

/-- The letter shift operator on responses. -/
def shiftOp (a : A) : (List A → K) →ₗ[K] (List A → K) where
  toFun ρ := fun v => ρ (a :: v)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem shiftOp_apply (a : A) (ρ : List A → K) (v : List A) :
    shiftOp (K := K) a ρ v = ρ (a :: v) := rfl

theorem shiftOp_shiftResponse (a : A) (w : List A) :
    shiftOp (K := K) a (shiftResponse r w) = shiftResponse r (w ++ [a]) := by
  funext v
  rw [shiftOp_apply, shiftResponse, shiftResponse, List.append_assoc, List.cons_append,
    List.nil_append]

/-- The Hankel span of a response. -/
def hankelSpan : Submodule K (List A → K) :=
  Submodule.span K (Set.range (shiftResponse r))

theorem shiftResponse_mem_hankelSpan (w : List A) : shiftResponse r w ∈ hankelSpan r :=
  Submodule.subset_span ⟨w, rfl⟩

theorem hankelSpan_invariant (a : A) :
    hankelSpan r ≤ (hankelSpan r).comap (shiftOp (K := K) a) := by
  refine Submodule.span_le.2 ?_
  rintro ρ ⟨w, rfl⟩
  show shiftOp (K := K) a (shiftResponse r w) ∈ hankelSpan r
  rw [shiftOp_shiftResponse]
  exact shiftResponse_mem_hankelSpan r _

/-- The canonical Hankel presentation of a response. -/
def hankelPresentation : MarkedPresentation K A (hankelSpan r) where
  init := ⟨r, by simpa using shiftResponse_mem_hankelSpan r []⟩
  out := { toFun := fun ρ => (ρ : List A → K) []
           map_add' := fun _ _ => rfl
           map_smul' := fun _ _ => rfl }
  step a := (shiftOp (K := K) a).restrict fun x hx => hankelSpan_invariant r a hx

theorem hankelPresentation_wordAction (w : List A) (ρ : hankelSpan r) :
    (((hankelPresentation r).wordAction w ρ : hankelSpan r) : List A → K)
      = fun v => (ρ : List A → K) (w ++ v) := by
  induction w generalizing ρ with
  | nil =>
      rw [wordAction_nil]
      funext v
      rw [List.nil_append]
      rfl
  | cons a w ih =>
      rw [wordAction_cons]
      have h := ih ((hankelPresentation r).step a ρ)
      show (((hankelPresentation r).wordAction w ((hankelPresentation r).step a ρ)
        : hankelSpan r) : List A → K) = _
      rw [h]
      funext v
      show (shiftOp (K := K) a (ρ : List A → K)) (w ++ v) = (ρ : List A → K) ((a :: w) ++ v)
      rw [shiftOp_apply, List.cons_append]

theorem hankelPresentation_response (w : List A) :
    (hankelPresentation r).response w = r w := by
  rw [response_apply]
  show (((hankelPresentation r).wordAction w (hankelPresentation r).init
    : hankelSpan r) : List A → K) [] = r w
  rw [hankelPresentation_wordAction]
  show r (w ++ []) = r w
  rw [List.append_nil]

theorem hankelPresentation_reachable : (hankelPresentation r).Reachable := by
  rw [Reachable, reachableSpan, Submodule.eq_top_iff']
  intro ρ
  have hρ : (ρ : List A → K) ∈ hankelSpan r := ρ.2
  refine Submodule.span_induction
    (p := fun v hv => (⟨v, hv⟩ : hankelSpan r) ∈ Submodule.span K
      (Set.range fun w : List A => (hankelPresentation r).wordAction w
        (hankelPresentation r).init)) ?_ ?_ ?_ ?_ hρ
  · rintro v ⟨w, rfl⟩
    refine Submodule.subset_span ⟨w, ?_⟩
    refine Subtype.ext ?_
    show (((hankelPresentation r).wordAction w (hankelPresentation r).init
      : hankelSpan r) : List A → K) = shiftResponse r w
    rw [hankelPresentation_wordAction]
    rfl
  · rw [show (⟨0, Submodule.zero_mem _⟩ : hankelSpan r) = 0 from rfl]
    simp
  · intro u v hu hv hu' hv'
    rw [show (⟨u + v, Submodule.add_mem _ hu hv⟩ : hankelSpan r)
        = (⟨u, hu⟩ : hankelSpan r) + ⟨v, hv⟩ from rfl]
    exact Submodule.add_mem _ hu' hv'
  · intro c v hv hv'
    rw [show (⟨c • v, Submodule.smul_mem _ c hv⟩ : hankelSpan r)
        = c • (⟨v, hv⟩ : hankelSpan r) from rfl]
    exact Submodule.smul_mem _ c hv'

theorem hankelPresentation_observable : (hankelPresentation r).Observable := by
  rw [Observable, Submodule.eq_bot_iff]
  intro ρ hρ
  rw [mem_unobservable_iff] at hρ
  refine Subtype.ext ?_
  funext w
  have h := hρ w
  show (ρ : List A → K) w = 0
  have h' : (((hankelPresentation r).wordAction w ρ : hankelSpan r) : List A → K) []
      = (ρ : List A → K) (w ++ []) := by
    rw [hankelPresentation_wordAction]
  rw [List.append_nil] at h'
  rw [← h', ← h]
  rfl

/-- **The Hankel realization is minimal.** -/
theorem hankelPresentation_minimal : (hankelPresentation r).Minimal :=
  ⟨hankelPresentation_reachable r, hankelPresentation_observable r⟩

/-- **(MR.18), contrapositive.**  If every finite word set has bounded shift rank, the whole
response has a realization of that dimension. -/
theorem rank_hankelSpan_le_of_finset_le {M : ℕ}
    (h : ∀ F : Finset (List A),
      Module.rank K (Submodule.span K (shiftResponse r '' (F : Set (List A)))) ≤ (M : Cardinal)) :
    Module.rank K (hankelSpan r) ≤ (M : Cardinal) := by
  classical
  refine rank_le fun s hs => ?_
  have hmem : ∀ x : hankelSpan r, ∃ T : Finset (List A → K),
      ↑T ⊆ Set.range (shiftResponse r) ∧ (x : List A → K) ∈ Submodule.span K (T : Set _) := by
    intro x
    exact Submodule.mem_span_finite_of_mem_span x.2
  choose T hTsub hTmem using hmem
  set U : Finset (List A → K) := s.biUnion T with hU
  have hUsub : ∀ t ∈ U, t ∈ Set.range (shiftResponse r) := by
    intro t ht
    rw [hU, Finset.mem_biUnion] at ht
    obtain ⟨x, _, hx⟩ := ht
    exact hTsub x (Finset.mem_coe.2 hx)
  have hpre : ∀ t ∈ U, ∃ w : List A, shiftResponse r w = t := hUsub
  choose! wof hwof using hpre
  set F : Finset (List A) := U.image wof with hF
  have hUimage : ∀ t ∈ U, t ∈ shiftResponse r '' (F : Set (List A)) := by
    intro t ht
    refine ⟨wof t, ?_, hwof t ht⟩
    rw [hF, Finset.coe_image]
    exact ⟨t, Finset.mem_coe.2 ht, rfl⟩
  set W : Submodule K (List A → K) := Submodule.span K (shiftResponse r '' (F : Set (List A)))
    with hW
  have hsW : ∀ x ∈ s, (x : List A → K) ∈ W := by
    intro x hx
    refine Submodule.span_mono ?_ (hTmem x)
    intro t ht
    refine hUimage t ?_
    rw [hU, Finset.mem_biUnion]
    exact ⟨x, hx, Finset.mem_coe.1 ht⟩
  have hind : LinearIndependent K fun x : s => (⟨(x : hankelSpan r), hsW x x.2⟩ : W) := by
    have hcomp : LinearIndependent K fun x : s => ((x : hankelSpan r) : List A → K) := by
      exact hs.map' (hankelSpan r).subtype (Submodule.ker_subtype _)
    refine LinearIndependent.of_comp W.subtype ?_
    exact hcomp
  have hcard := hind.cardinal_le_rank
  have hle : (s.card : Cardinal) ≤ Module.rank K W := by
    simpa using hcard
  have hWle : Module.rank K W ≤ (M : Cardinal) := h F
  exact_mod_cast le_trans hle hWle

/-- **(MR.18).**  If the response has no finite-dimensional realization, no bound survives: some
finite word set already exceeds every proposed memory `M`. -/
theorem exists_finset_rank_gt_of_not_rank_le {M : ℕ}
    (h : ¬ Module.rank K (hankelSpan r) ≤ (M : Cardinal)) :
    ∃ F : Finset (List A),
      ¬ Module.rank K (Submodule.span K (shiftResponse r '' (F : Set (List A))))
        ≤ (M : Cardinal) := by
  by_contra hcon
  push Not at hcon
  exact h (rank_hankelSpan_le_of_finset_le r hcon)

end Hankel

/-! ## The complete star response and its GNS realization -/

section GNS

variable (st : A → A) (hst : ∀ a, st (st a) = a) (r : List A → K)

/-- Word star: reverse and apply the letter involution. -/
def wordStar (w : List A) : List A := (w.map st).reverse

omit [Field K] in
@[simp] theorem wordStar_nil : wordStar st ([] : List A) = [] := rfl

omit [Field K] in
theorem wordStar_cons (a : A) (w : List A) :
    wordStar st (a :: w) = wordStar st w ++ [st a] := by
  show ((a :: w).map st).reverse = (w.map st).reverse ++ [st a]
  rw [List.map_cons, List.reverse_cons]

omit [Field K] in
include hst in
theorem wordStar_involutive (w : List A) : wordStar st (wordStar st w) = w := by
  show ((((w.map st).reverse).map st).reverse) = w
  rw [List.map_reverse, List.reverse_reverse, List.map_map]
  refine List.map_id'' ?_ w
  intro a
  exact hst a

omit [Field K] in
include hst in
theorem wordStar_surjective : Function.Surjective (wordStar st (A := A)) :=
  fun w => ⟨wordStar st w, wordStar_involutive st hst w⟩

/-- The Gram map of a star response: the complete word-context pairing. -/
noncomputable def gramMap : (List A →₀ K) →ₗ[K] (List A → K) where
  toFun x := fun u => x.sum fun v c => c * r (wordStar st u ++ v)
  map_add' x y := by
    funext u
    exact Finsupp.sum_add_index' (fun _ => by rw [zero_mul]) (fun _ _ _ => by ring)
  map_smul' c x := by
    funext u
    rw [Finsupp.sum_smul_index' (fun _ => by rw [zero_mul])]
    show (x.sum fun v b => c * b * r (wordStar st u ++ v))
      = c * x.sum fun v b => b * r (wordStar st u ++ v)
    rw [Finsupp.mul_sum]
    refine Finsupp.sum_congr fun v _ => ?_
    ring

theorem gramMap_apply (x : List A →₀ K) (u : List A) :
    gramMap st r x u = x.sum fun v c => c * r (wordStar st u ++ v) := rfl

/-- The Gram radical: the kernel of the complete word-context pairing. -/
noncomputable def gramRadical : Submodule K (List A →₀ K) := LinearMap.ker (gramMap st r)

/-- Left multiplication by a letter on the free word module. -/
noncomputable def leftMul (a : A) : (List A →₀ K) →ₗ[K] (List A →₀ K) :=
  Finsupp.lmapDomain K K fun u => a :: u

@[simp] theorem leftMul_single (a : A) (u : List A) (c : K) :
    leftMul (K := K) a (Finsupp.single u c) = Finsupp.single (a :: u) c := by
  rw [leftMul, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

include hst in
theorem gramMap_leftMul (a : A) (x : List A →₀ K) (u : List A) :
    gramMap st r (leftMul (K := K) a x) u = gramMap st r x (st a :: u) := by
  classical
  rw [gramMap_apply, gramMap_apply, leftMul, Finsupp.lmapDomain_apply,
    Finsupp.sum_mapDomain_index_inj (by
      intro p q hpq
      exact List.tail_eq_of_cons_eq hpq)]
  refine Finsupp.sum_congr fun v _ => ?_
  congr 2
  rw [wordStar_cons, hst, List.append_assoc, List.cons_append, List.nil_append]

include hst in
theorem gramRadical_leftMul (a : A) :
    gramRadical st r ≤ (gramRadical st r).comap (leftMul (K := K) a) := by
  intro x hx
  show leftMul (K := K) a x ∈ gramRadical st r
  rw [gramRadical, LinearMap.mem_ker]
  funext u
  rw [gramMap_leftMul st hst r]
  rw [gramRadical, LinearMap.mem_ker] at hx
  rw [hx]
  rfl

/-- The complete word readout. -/
noncomputable def gramOut : (List A →₀ K) →ₗ[K] K :=
  Finsupp.linearCombination K r

theorem gramOut_apply (x : List A →₀ K) : gramOut r x = x.sum fun v c => c * r v := by
  rw [gramOut, Finsupp.linearCombination_apply]
  refine Finsupp.sum_congr fun v _ => ?_
  rw [smul_eq_mul]

theorem gramRadical_le_ker_gramOut : gramRadical st r ≤ LinearMap.ker (gramOut r) := by
  intro x hx
  rw [gramRadical, LinearMap.mem_ker] at hx
  rw [LinearMap.mem_ker, gramOut_apply]
  have h := congrFun hx []
  rw [gramMap_apply, wordStar_nil] at h
  simpa using h

/-- The GNS carrier of a complete star response. -/
abbrev gnsCarrier : Type _ := (List A →₀ K) ⧸ gramRadical st r

/-- **Theorem 5.1.**  The left word action, the empty-word mark and the cyclic readout form a
marked presentation on the GNS carrier. -/
noncomputable def gnsPresentation : MarkedPresentation K A (gnsCarrier st r) where
  init := Submodule.Quotient.mk (Finsupp.single [] 1)
  out := (gramRadical st r).liftQ (gramOut r) (gramRadical_le_ker_gramOut st r)
  step a := (gramRadical st r).mapQ (gramRadical st r) (leftMul (K := K) a)
    (gramRadical_leftMul st hst r a)

theorem gnsPresentation_wordAction (w : List A) (x : List A →₀ K) :
    (gnsPresentation st hst r).wordAction w (Submodule.Quotient.mk x)
      = Submodule.Quotient.mk (Finsupp.mapDomain (fun u => w.reverse ++ u) x) := by
  classical
  induction w generalizing x with
  | nil =>
      rw [wordAction_nil]
      show (Submodule.Quotient.mk x : gnsCarrier st r)
        = Submodule.Quotient.mk (Finsupp.mapDomain (fun u => List.reverse [] ++ u) x)
      rw [List.reverse_nil]
      congr 1
      rw [show (fun u : List A => ([] : List A) ++ u) = id by
        funext u
        rw [List.nil_append]
        rfl, Finsupp.mapDomain_id]
  | cons a w ih =>
      rw [wordAction_cons]
      show (gnsPresentation st hst r).wordAction w
        ((gnsPresentation st hst r).step a (Submodule.Quotient.mk x)) = _
      rw [show (gnsPresentation st hst r).step a (Submodule.Quotient.mk x)
          = Submodule.Quotient.mk (leftMul (K := K) a x) from rfl, ih]
      congr 1
      rw [leftMul, Finsupp.lmapDomain_apply, Finsupp.mapDomain_comp.symm]
      congr 1
      funext u
      rw [List.reverse_cons, List.append_assoc, List.cons_append, List.nil_append]
      rfl

/-- **Theorem 5.1.**  The GNS presentation realizes the reversed complete response. -/
theorem gnsPresentation_response (w : List A) :
    (gnsPresentation st hst r).response w = r w.reverse := by
  classical
  rw [response_apply]
  show (gnsPresentation st hst r).out
    ((gnsPresentation st hst r).wordAction w (Submodule.Quotient.mk (Finsupp.single [] 1))) = _
  rw [gnsPresentation_wordAction, Finsupp.mapDomain_single]
  show gramOut r (Finsupp.single (w.reverse ++ []) 1) = r w.reverse
  rw [List.append_nil, gramOut, Finsupp.linearCombination_single, one_smul]

/-- **Theorem 5.1.**  The GNS realization is minimal. -/
theorem gnsPresentation_minimal : (gnsPresentation st hst r).Minimal := by
  constructor
  · rw [Reachable, reachableSpan, Submodule.eq_top_iff']
    intro q
    induction q using Submodule.Quotient.induction_on with
    | H x =>
        classical
        refine Finsupp.induction x ?_ ?_
        · rw [show (Submodule.Quotient.mk 0 : gnsCarrier st r) = 0 from rfl]
          simp
        · intro u c y _ _ hy
          rw [show (Submodule.Quotient.mk (Finsupp.single u c + y) : gnsCarrier st r)
              = Submodule.Quotient.mk (Finsupp.single u c) + Submodule.Quotient.mk y from rfl]
          refine Submodule.add_mem _ ?_ hy
          have hmem : (Submodule.Quotient.mk (Finsupp.single u (1 : K)) : gnsCarrier st r)
              ∈ Submodule.span K (Set.range fun w : List A =>
                (gnsPresentation st hst r).wordAction w (gnsPresentation st hst r).init) := by
            refine Submodule.subset_span ⟨u.reverse, ?_⟩
            show (gnsPresentation st hst r).wordAction u.reverse
              (Submodule.Quotient.mk (Finsupp.single [] 1)) = _
            rw [gnsPresentation_wordAction, Finsupp.mapDomain_single, List.reverse_reverse,
              List.append_nil]
          have := Submodule.smul_mem _ c hmem
          rwa [← Submodule.Quotient.mk_smul, Finsupp.smul_single, smul_eq_mul, mul_one] at this
  · rw [Observable, Submodule.eq_bot_iff]
    intro q hq
    induction q using Submodule.Quotient.induction_on with
    | H x =>
        rw [mem_unobservable_iff] at hq
        rw [Submodule.Quotient.mk_eq_zero, gramRadical, LinearMap.mem_ker]
        funext u
        obtain ⟨t, rfl⟩ := wordStar_surjective st hst u
        have h := hq t.reverse
        rw [gnsPresentation_wordAction] at h
        show gramMap st r x (wordStar st t) = 0
        rw [gramMap_apply, wordStar_involutive st hst]
        have h' : gramOut r (Finsupp.mapDomain (fun v => t.reverse.reverse ++ v) x) = 0 := h
        rw [List.reverse_reverse] at h'
        rw [gramOut_apply, Finsupp.sum_mapDomain_index_inj (by
          intro p q hpq
          exact List.append_cancel_left hpq)] at h'
        exact h'

/-- **Theorem 5.1.**  The GNS dimension is the rank of the Gram kernel. -/
noncomputable def gnsCarrierEquivRange :
    gnsCarrier st r ≃ₗ[K] LinearMap.range (gramMap st r) :=
  LinearMap.quotKerEquivRange (gramMap st r)

end GNS

end MarkedPresentation

end GaloisForLFunctions.HTGeometry
