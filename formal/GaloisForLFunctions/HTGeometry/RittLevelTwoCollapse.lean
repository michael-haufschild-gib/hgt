import GaloisForLFunctions.HTGeometry.RittLevelTwoClassification
import GaloisForLFunctions.HTGeometry.RittJetDefect

/-!
# A collapse at jet order two is impossible

At jet order two the shift relation is completely explicit: the defect of the second jet is
`−q·(dρ)/ρ³` times the first jet, with no lower term at all.  So a second jet lying in the field
generated by the first two carries the relation

`σ(d²τ) = (q/ρ²)·d²τ + λ₂·dτ`,   `λ₂ = −q·(dρ)/ρ³ ≠ 0`,

whose linear inhomogeneity is nonzero.  The classification at jet order two allows a monomial
solution only when the whole inhomogeneity vanishes, so that alternative is excluded outright and
what remains is Ritt's order-one form or an affine transport equation — both refuted for a map with
no cocycle and no affine connection.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [CharZero K] [Field L] [Algebra K L]

/-- **A collapse of the jet tower at order two forces Ritt's form or an affine transport
equation.** -/
theorem ritt_or_affine_of_collapse_two (Fr : RittFrame K L) {τ : L} {q : K}
    (hqconst : Fr.dK q = 0) (hshift : Fr.σ τ = algebraMap K L q * τ) (hq : q ≠ 0)
    (hdρ : Fr.dK Fr.ρ ≠ 0) (htr0 : Transcendental K τ)
    (htr1 : Transcendental ↥(Fr.jetPrefixField τ 1) (Fr.d τ))
    (hjet2 : Fr.d^[2] τ ≠ 0) (hmem : Fr.d^[2] τ ∈ Fr.jetPrefixField τ 2) :
    (∃ (u : K) (I J : ℤ), u ≠ 0 ∧ ¬(I = 0 ∧ J = 0) ∧ Fr.ψ u = q ^ I * Fr.ρ ^ J * u) ∨
    (∃ (u c' h : K), u ≠ 0 ∧ c' ≠ 0 ∧ h ≠ 0 ∧ Fr.ψ u = c' * u + h) := by
  classical
  have hρ0 : Fr.ρ ≠ 0 := Fr.ρ_ne
  set lam : K := -(((0 + 2).choose 2 : K) * q * Fr.dK Fr.ρ / Fr.ρ ^ (0 + 3)) with hlamdef
  have hlead := jetDefect_leading Fr hqconst hshift 0
  rw [Fr.jetSpan_zero, Submodule.mem_bot, sub_eq_zero] at hlead
  have hlam0 : lam ≠ 0 := by
    rw [hlamdef, neg_ne_zero]
    have hch : (((0 + 2).choose 2 : ℕ) : K) ≠ 0 := by
      norm_num
    exact div_ne_zero (mul_ne_zero (mul_ne_zero hch hq) hdρ) (pow_ne_zero _ hρ0)
  have hcq : q / Fr.ρ ^ 2 ≠ 0 := div_ne_zero hq (pow_ne_zero _ hρ0)
  have hcik : q / Fr.ρ ^ 2 = q ^ (1 : ℤ) * Fr.ρ ^ (-(2 : ℤ)) := by
    have hinv : (Fr.ρ : K) ^ (-(2 : ℤ)) = (Fr.ρ ^ (2 : ℕ))⁻¹ := by
      rw [zpow_neg]
      norm_cast
    rw [zpow_one, hinv, div_eq_mul_inv]
  have hrel : Fr.σ (Fr.d^[2] τ) = algebraMap K L (q / Fr.ρ ^ 2) * Fr.d^[2] τ
      + (algebraMap K L lam * Fr.d τ
        + (algebraMap K L (0 : K) * τ + algebraMap K L (0 : K))) := by
    have hdef : Fr.jetDefect τ q 2 = algebraMap K L lam * Fr.d^[0 + 1] τ := hlead
    rw [map_zero, zero_mul, add_zero, add_zero]
    have hd1 : Fr.d^[0 + 1] τ = Fr.d τ := rfl
    rw [hd1] at hdef
    rw [RittFrame.jetDefect, sub_eq_iff_eq_add'] at hdef
    exact hdef
  rcases level_two_classification Fr hqconst hshift hq htr0 htr1 hjet2 hmem hcq hcik hrel with
      hritt | haff | ⟨-, -, -, -, -, hα, -, -, -, -, -⟩
  · exact Or.inl hritt
  · exact Or.inr haff.2
  · exact absurd hα hlam0

end GaloisForLFunctions.HTGeometry
