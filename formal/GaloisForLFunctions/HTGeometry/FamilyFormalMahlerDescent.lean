import GaloisForLFunctions.HTGeometry.FormalMahlerIntegerNormalization
import GaloisForLFunctions.HTGeometry.DifferentialIndependentConstantDescent
import GaloisForLFunctions.HTGeometry.FamilyJetFlattening

/-!
# Rational normalization of a joint formal differential relation

A nonzero complex algebraic relation between the formal jets of a *family* of power series can be
replaced by a nonzero relation with rational coefficients, at the cost of raising the jet order.

The complex coefficients and the point variable are absorbed into a differential adjunction whose
generators are polynomials in the point variable, hence contribute only finitely many distinct
jets; the constant-field descent then removes that adjunction, and a bound on the jet orders
occurring in the resulting relation returns it to jet-vector form.
-/

open PowerSeries MvPolynomial
open scoped Differential

namespace GaloisForLFunctions

noncomputable section

attribute [local instance] formalLaurentRatAlgebra formalLaurentRatComplexTower
  formalLaurentDifferential rationalZeroDifferential formalLaurentDifferentialAlgebraRat

local instance : CharZero FormalLaurent :=
  charZero_of_injective_algebraMap (algebraMap ℂ FormalLaurent).injective

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The jet polynomial of a family with the point slot moved into the coefficients. -/
def familyPointRow (n : ℕ) (Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ) :
    MvPolynomial (ι × Fin (n + 1)) (Polynomial ℂ) :=
  MvPolynomial.optionEquivRight ℂ (ι × Fin (n + 1)) Q

theorem familyPointRow_ne_zero {n : ℕ} {Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ}
    (hQ : Q ≠ 0) : familyPointRow n Q ≠ 0 :=
  (MvPolynomial.optionEquivRight ℂ (ι × Fin (n + 1))).injective.ne hQ

theorem aeval_map_familyPointRow (n : ℕ) (g : ι → ℂ⟦X⟧)
    (Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ) :
    aeval (fun p : ι × Fin (n + 1) => (⇑(d⁄dX ℂ))^[(p.2 : ℕ)] (g p.1))
        (MvPolynomial.map (algebraMap (Polynomial ℂ) (PowerSeries ℂ)) (familyPointRow n Q))
      = aeval (familyJets n g) Q := by
  let ψ : MvPolynomial (Option (ι × Fin (n + 1))) ℂ →+*
      MvPolynomial (ι × Fin (n + 1)) (PowerSeries ℂ) :=
    (MvPolynomial.map (algebraMap (Polynomial ℂ) (PowerSeries ℂ))).comp
      (MvPolynomial.optionEquivRight ℂ (ι × Fin (n + 1))).toRingEquiv.toRingHom
  let lhs : MvPolynomial (Option (ι × Fin (n + 1))) ℂ →+* PowerSeries ℂ :=
    (aeval (familyJets n g)).toRingHom
  let rhs : MvPolynomial (Option (ι × Fin (n + 1))) ℂ →+* PowerSeries ℂ :=
    (aeval (fun p : ι × Fin (n + 1) => (⇑(d⁄dX ℂ))^[(p.2 : ℕ)] (g p.1))).toRingHom.comp ψ
  have hhom : rhs = lhs := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [lhs, rhs, ψ, MvPolynomial.optionEquivRight_C]
      exact Polynomial.coe_C r
    · rintro (_ | p)
      · simp [lhs, rhs, ψ, MvPolynomial.optionEquivRight_X_none, familyJets]
        exact Polynomial.coe_X
      · simp [lhs, rhs, ψ, MvPolynomial.optionEquivRight_X_some, familyJets]
  change rhs Q = lhs Q
  rw [hhom]

/-- A joint relation makes the family differentially dependent over the differential field
generated by the coefficients of its point row. -/
theorem not_differentialIndependent_coefficientAdjoin_of_familyRelation
    {n : ℕ} {g : ι → ℂ⟦X⟧} {Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ}
    (hQ : Q ≠ 0) (hann : aeval (familyJets n g) Q = 0) :
    ¬ DifferentialIndependent
        ↥(differentialAdjoin ℚ (formalPointCoefficientGenerators (familyPointRow n Q)))
        (fun i => algebraMap (PowerSeries ℂ) FormalLaurent (g i)) := by
  intro hind
  have hR0 : familyPointRow n Q ≠ 0 := familyPointRow_ne_zero hQ
  have hQB0 : liftFormalPointRow (familyPointRow n Q) ≠ 0 := liftFormalPointRow_ne_zero hR0
  have hrowPS : aeval (fun p : ι × Fin (n + 1) => (⇑(d⁄dX ℂ))^[(p.2 : ℕ)] (g p.1))
      (MvPolynomial.map (algebraMap (Polynomial ℂ) (PowerSeries ℂ))
        (familyPointRow n Q)) = 0 := by
    rw [aeval_map_familyPointRow]
    exact hann
  have hrowLS : aeval (fun p : ι × Fin (n + 1) => differentialJet (p.2 : ℕ)
        (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1)))
      (MvPolynomial.map formalPointRowEmbedding (familyPointRow n Q)) = 0 := by
    have hmap := congrArg (algebraMap (PowerSeries ℂ) FormalLaurent) hrowPS
    rw [map_zero] at hmap
    rw [map_aeval_powerSeries_formalLaurent] at hmap
    rw [MvPolynomial.map_map, MvPolynomial.aeval_def, MvPolynomial.eval₂_map] at hmap
    change MvPolynomial.eval₂ formalPointRowEmbedding
      (fun p : ι × Fin (n + 1) => algebraMap (PowerSeries ℂ) FormalLaurent
        ((⇑(d⁄dX ℂ))^[(p.2 : ℕ)] (g p.1))) (familyPointRow n Q) = 0 at hmap
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
    change MvPolynomial.eval₂ formalPointRowEmbedding
      (fun p : ι × Fin (n + 1) => differentialJet (p.2 : ℕ)
        (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1))) (familyPointRow n Q) = 0
    rw [show (fun p : ι × Fin (n + 1) => differentialJet (p.2 : ℕ)
        (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1))) =
      (fun p : ι × Fin (n + 1) => algebraMap (PowerSeries ℂ) FormalLaurent
        ((⇑(d⁄dX ℂ))^[(p.2 : ℕ)] (g p.1))) by
        funext p
        exact differentialJet_formalLaurent_algebraMap (p.2 : ℕ) (g p.1)]
    exact hmap
  have hQBann : aeval (fun p : ι × Fin (n + 1) => differentialJet (p.2 : ℕ)
        (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1)))
      (liftFormalPointRow (familyPointRow n Q)) = 0 := by
    rw [← map_liftFormalPointRow (familyPointRow n Q)] at hrowLS
    rw [MvPolynomial.aeval_map_algebraMap] at hrowLS
    exact hrowLS
  have hρinj : Function.Injective (fun p : ι × Fin (n + 1) => (p.1, (p.2 : ℕ))) := by
    rintro ⟨i, a⟩ ⟨j, b⟩ h
    rw [Prod.mk.injEq] at h
    exact Prod.ext h.1 (Fin.ext h.2)
  refine hQB0 (MvPolynomial.rename_injective _ hρinj ?_)
  rw [map_zero]
  refine hind.eq_zero_of_aeval_eq_zero _ ?_
  rw [MvPolynomial.aeval_rename]
  exact hQBann

/-- The family is differentially dependent over `ℚ` itself. -/
theorem not_differentialIndependent_rat_of_familyRelation
    {n : ℕ} {g : ι → ℂ⟦X⟧} {Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ}
    (hQ : Q ≠ 0) (hann : aeval (familyJets n g) Q = 0) :
    ¬ DifferentialIndependent ℚ
        (fun i => algebraMap (PowerSeries ℂ) FormalLaurent (g i)) := fun hind =>
  not_differentialIndependent_coefficientAdjoin_of_familyRelation hQ hann
    (HTGeometry.differentialIndependent_family_differentialAdjoin_of_finite_jetSet
      (formalPointCoefficientGenerators_finite_jetSet (familyPointRow n Q)) hind)

/-- **Rational normalization of a joint relation.**  A nonzero complex relation between the jets of
a family yields a nonzero relation with rational coefficients. -/
theorem exists_rational_familyJets_relation
    {n : ℕ} {g : ι → ℂ⟦X⟧} {Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ}
    (hQ : Q ≠ 0) (hann : aeval (familyJets n g) Q = 0) :
    ∃ (n' : ℕ) (Q' : MvPolynomial (Option (ι × Fin (n' + 1))) ℂ), Q' ≠ 0 ∧
      (∀ m, IsAlgebraic ℚ (MvPolynomial.coeff m Q')) ∧
      aeval (familyJets n' g) Q' = 0 := by
  classical
  have hnot := not_differentialIndependent_rat_of_familyRelation hQ hann
  unfold DifferentialIndependent at hnot
  rw [algebraicIndependent_iff] at hnot
  push_neg at hnot
  obtain ⟨P, hPann, hP0⟩ := hnot
  set n' : ℕ := P.vars.sup (fun q : ι × ℕ => q.2) with hn'
  have hρinj : Function.Injective (fun p : ι × Fin (n' + 1) => (p.1, (p.2 : ℕ))) := by
    rintro ⟨i, a⟩ ⟨j, b⟩ h
    rw [Prod.mk.injEq] at h
    exact Prod.ext h.1 (Fin.ext h.2)
  have hvars : (P.vars : Set (ι × ℕ))
      ⊆ Set.range (fun p : ι × Fin (n' + 1) => (p.1, (p.2 : ℕ))) := by
    intro q hq
    have hle : q.2 ≤ n' := Finset.le_sup (f := fun r : ι × ℕ => r.2) hq
    exact ⟨(q.1, ⟨q.2, by omega⟩), rfl⟩
  obtain ⟨P₀, hP₀⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range P _ hρinj hvars
  have hP₀0 : P₀ ≠ 0 := by
    intro h
    exact hP0 (by rw [← hP₀, h, map_zero])
  have hP₀ann : aeval (fun p : ι × Fin (n' + 1) => differentialJet (p.2 : ℕ)
      (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1))) P₀ = 0 := by
    have := hPann
    rw [← hP₀, MvPolynomial.aeval_rename] at this
    exact this
  refine ⟨n', MvPolynomial.map (algebraMap ℚ ℂ)
    (MvPolynomial.rename (some : ι × Fin (n' + 1) → Option (ι × Fin (n' + 1))) P₀), ?_, ?_, ?_⟩
  · intro h
    refine hP₀0 (MvPolynomial.rename_injective _ (Option.some_injective _) ?_)
    rw [map_zero]
    exact MvPolynomial.map_injective (algebraMap ℚ ℂ) (algebraMap ℚ ℂ).injective
      (by rw [h, map_zero])
  · intro m
    rw [MvPolynomial.coeff_map]
    exact isAlgebraic_algebraMap _
  · apply (HahnSeries.ofPowerSeries_injective (Γ := ℤ) (R := ℂ))
    change algebraMap (PowerSeries ℂ) FormalLaurent
        (aeval (familyJets n' g) (MvPolynomial.map (algebraMap ℚ ℂ)
          (MvPolynomial.rename some P₀)))
      = algebraMap (PowerSeries ℂ) FormalLaurent 0
    rw [map_zero, map_aeval_complex_powerSeries_formalLaurent,
      MvPolynomial.aeval_map_algebraMap, MvPolynomial.aeval_rename]
    rw [show ((fun s : Option (ι × Fin (n' + 1)) =>
        algebraMap (PowerSeries ℂ) FormalLaurent (familyJets n' g s))
          ∘ (some : ι × Fin (n' + 1) → Option (ι × Fin (n' + 1))))
        = fun p : ι × Fin (n' + 1) => differentialJet (p.2 : ℕ)
            (algebraMap (PowerSeries ℂ) FormalLaurent (g p.1)) by
      funext p
      exact (differentialJet_formalLaurent_algebraMap (p.2 : ℕ) (g p.1)).symm]
    exact hP₀ann

end

end GaloisForLFunctions
