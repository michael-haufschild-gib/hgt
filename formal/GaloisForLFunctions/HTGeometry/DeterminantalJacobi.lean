import Mathlib
import GaloisForLFunctions.HTGeometry.DeterminantalIdeal

/-!
# Jacobi's formula for a derivation, and the singular locus of a determinantal stratum

A derivation of a determinant differentiates one row at a time, and expanding the resulting
determinant along that row leaves the cofactors — minors one size smaller.  Consequently every
derivation of a `(t+1)`-minor lies in the ideal generated by the `t`-minors, and at a point where
all `t`-minors vanish the whole Jacobian of the `(t+1)`-minors vanishes: the deeper determinantal
stratum is contained in the singular locus of the shallower one.

The finite-product Leibniz rule `derivation_prod` and the determinant formula `derivation_det` are
general facts about derivations of a commutative algebra and are stated as such.
-/

namespace GaloisForLFunctions.HTGeometry

open Finset

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- **The Leibniz rule for a finite product.** -/
theorem derivation_prod (D : Derivation R A A) {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → A) :
    D (∏ i ∈ s, f i) = ∑ i ∈ s, (∏ j ∈ s.erase i, f j) * D (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Derivation.leibniz, ih, Finset.sum_insert ha]
      have hera : (insert a s).erase a = s := Finset.erase_insert ha
      rw [hera]
      have hsum : ∑ i ∈ s, (∏ j ∈ (insert a s).erase i, f j) * D (f i)
          = ∑ i ∈ s, f a * ((∏ j ∈ s.erase i, f j) * D (f i)) := by
        refine Finset.sum_congr rfl fun i hi => ?_
        have hne : i ≠ a := fun h => ha (h ▸ hi)
        have herase : (insert a s).erase i = insert a (s.erase i) := by
          rw [Finset.erase_insert_of_ne (Ne.symm hne)]
        rw [herase, Finset.prod_insert (fun h => (Finset.mem_erase.mp h).2 |> ha)]
        ring
      rw [hsum, ← Finset.mul_sum]
      simp only [smul_eq_mul]
      ring

variable {n : Type*} [DecidableEq n] [Fintype n]

theorem prod_updateRow_perm (M : Matrix n n A) (σ : Equiv.Perm n) (k : n) (v : n → A) :
    ∏ i, (M.updateRow k v) (σ i) i
      = v (σ.symm k) * ∏ j ∈ Finset.univ.erase (σ.symm k), M (σ j) j := by
  classical
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ (σ.symm k))]
  congr 1
  · rw [Matrix.updateRow_apply, if_pos (Equiv.apply_symm_apply σ k)]
  · refine Finset.prod_congr rfl fun j hj => ?_
    have hjk : σ j ≠ k := by
      intro h
      exact (Finset.mem_erase.mp hj).1 (by rw [← h, Equiv.symm_apply_apply])
    rw [Matrix.updateRow_apply, if_neg hjk]

/-- **Jacobi's formula for a derivation.**  The derivation of a determinant is the sum of the
determinants obtained by differentiating one row at a time. -/
theorem derivation_det (D : Derivation R A A) (M : Matrix n n A) :
    D M.det = ∑ k, (M.updateRow k fun j => D (M k j)).det := by
  classical
  have hsign : ∀ (σ : Equiv.Perm n) (p : A),
      D (((Equiv.Perm.sign σ : ℤ) : A) * p) = ((Equiv.Perm.sign σ : ℤ) : A) * D p := by
    intro σ p
    rw [show (((Equiv.Perm.sign σ : ℤ) : A) * p) = ((Equiv.Perm.sign σ : ℤ)) • p by
      rw [zsmul_eq_mul], map_zsmul, zsmul_eq_mul]
  have hlhs : D M.det
      = ∑ σ : Equiv.Perm n, ((Equiv.Perm.sign σ : ℤ) : A)
          * ∑ i, (∏ j ∈ Finset.univ.erase i, M (σ j) j) * D (M (σ i) i) := by
    rw [Matrix.det_apply', map_sum]
    refine Finset.sum_congr rfl fun σ _ => ?_
    rw [hsign σ, derivation_prod D Finset.univ (fun i => M (σ i) i)]
  have hrhs : ∑ k, (M.updateRow k fun j => D (M k j)).det
      = ∑ σ : Equiv.Perm n, ((Equiv.Perm.sign σ : ℤ) : A)
          * ∑ i, (∏ j ∈ Finset.univ.erase i, M (σ j) j) * D (M (σ i) i) := by
    have hstep : ∀ k : n, (M.updateRow k fun j => D (M k j)).det
        = ∑ σ : Equiv.Perm n, ((Equiv.Perm.sign σ : ℤ) : A)
            * (D (M k (σ.symm k)) * ∏ j ∈ Finset.univ.erase (σ.symm k), M (σ j) j) := by
      intro k
      rw [Matrix.det_apply']
      exact Finset.sum_congr rfl fun σ _ => by rw [prod_updateRow_perm]
    rw [Finset.sum_congr rfl fun k _ => hstep k, Finset.sum_comm]
    refine Finset.sum_congr rfl fun σ _ => ?_
    rw [Finset.mul_sum]
    have hre := Equiv.sum_comp σ (fun k : n => ((Equiv.Perm.sign σ : ℤ) : A)
      * (D (M k (σ.symm k)) * ∏ j ∈ Finset.univ.erase (σ.symm k), M (σ j) j))
    rw [← hre]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Equiv.symm_apply_apply]
    ring
  rw [hlhs, hrhs]


/-! ### Derivations of minors -/

/-- **A derivation of a `(t+1)`-minor lies in the ideal of `t`-minors.**  Jacobi's formula plus the
cofactor expansion: differentiating one row at a time and expanding along that row leaves exactly the
`t`-minors of the original matrix. -/
theorem derivation_det_submatrix_mem_detIdeal (D : Derivation R A A) {N t : ℕ}
    (M : Matrix (Fin N) (Fin N) A) (I m : Fin (t + 1) → Fin N) :
    D ((M.submatrix I m).det) ∈ detIdeal M t := by
  classical
  rw [derivation_det]
  refine Ideal.sum_mem _ fun k _ => ?_
  rw [Matrix.det_succ_row _ k]
  refine Ideal.sum_mem _ fun j _ => ?_
  have hsub : (((M.submatrix I m).updateRow k
        fun l => D ((M.submatrix I m) k l)).submatrix k.succAbove j.succAbove)
      = M.submatrix (I ∘ k.succAbove) (m ∘ j.succAbove) := by
    funext a b
    have hne : k.succAbove a ≠ k := Fin.succAbove_ne k a
    simp [Matrix.submatrix_apply, Matrix.updateRow_apply, hne]
  rw [hsub]
  exact Ideal.mul_mem_left _ _ (minor_mem_detIdeal M _ _)


/-- **The deeper determinantal stratum is singular.**  At a point where every `t`-minor vanishes,
every partial derivative of every `(t+1)`-minor vanishes as well: the Jacobian of the defining
equations of the rank-`t` locus is zero on the rank-`(t−1)` locus.  This is the containment
`C_{k+1} ⊆ Sing(C_k)` of the determinantal stratification. -/
theorem pderiv_det_submatrix_eval_eq_zero {N t : ℕ} {σ : Type*} {K : Type*} [CommRing K]
    (M : Matrix (Fin N) (Fin N) (MvPolynomial σ K)) (I m : Fin (t + 1) → Fin N)
    (x : σ → K) (i : σ)
    (hx : ∀ I' m' : Fin t → Fin N, MvPolynomial.eval x ((M.submatrix I' m').det) = 0) :
    MvPolynomial.eval x (MvPolynomial.pderiv i ((M.submatrix I m).det)) = 0 := by
  classical
  have hle : detIdeal M t ≤ RingHom.ker (MvPolynomial.eval x) := by
    refine detIdeal_le fun I' m' => ?_
    exact RingHom.mem_ker.mpr (hx I' m')
  have hmem := derivation_det_submatrix_mem_detIdeal (MvPolynomial.pderiv i) M I m
  exact RingHom.mem_ker.mp (hle hmem)


end GaloisForLFunctions.HTGeometry
