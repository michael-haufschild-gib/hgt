import GaloisForLFunctions.HTGeometry.DifferentialAdjoinPresentation

/-!
# The jet algebra and clearing denominators

Elements of a differential adjoin are quotients of jet polynomials, so a relation with coefficients
in the field becomes, after multiplication by one nonzero element, a relation whose coefficients lie
in the *subalgebra* generated by the jets — polynomials with constant coefficients, no denominators.

Since multiplying by a nonzero element preserves both the relation and the nonvanishing of every
coefficient, nothing is lost: a relation over the differential field is a relation over its jet
algebra.
-/

namespace GaloisForLFunctions

open MvPolynomial

variable {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K] {s : Set K}

/-- The subalgebra generated by all jets of a set of generators. -/
def differentialJetAlgebra (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K]
    [Differential K] (s : Set K) : Subalgebra F K :=
  Algebra.adjoin F (differentialJetSet s)

/-- The jet algebra is the range of evaluation of polynomials at the jets. -/
theorem differentialJetAlgebra_eq_range (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K]
    [Differential K] (s : Set K) :
    differentialJetAlgebra F s
      = (MvPolynomial.aeval (Subtype.val : differentialJetSet s → K)).range := by
  rw [differentialJetAlgebra, ← Algebra.adjoin_range_eq_range_aeval, Subtype.range_coe]

/-- Evaluation at jets from any subset of the jet set lands in the jet algebra. -/
theorem aeval_mem_differentialJetAlgebra {T : Set K} (hT : T ⊆ differentialJetSet s)
    (r : MvPolynomial T F) :
    MvPolynomial.aeval (Subtype.val : T → K) r ∈ differentialJetAlgebra F s := by
  have hle : (MvPolynomial.aeval (Subtype.val : T → K)).range ≤ differentialJetAlgebra F s := by
    rw [← Algebra.adjoin_range_eq_range_aeval, Subtype.range_coe]
    exact Algebra.adjoin_le (fun y hy => Algebra.subset_adjoin (hT hy))
  exact hle ⟨r, rfl⟩

/-- **A denominator for a field element.**  Every element of the differential adjoin is cleared by a
nonzero element of the jet algebra. -/
theorem exists_jetAlgebra_denominator {x : K} (hx : x ∈ differentialAdjoin F s) :
    ∃ Q : K, Q ∈ differentialJetAlgebra F s ∧ Q ≠ 0
      ∧ x * Q ∈ differentialJetAlgebra F s := by
  classical
  obtain ⟨T, hT, r, q, hx'⟩ := exists_finite_jetPoly_presentation F hx
  by_cases hq : MvPolynomial.aeval (Subtype.val : (↑T : Set K) → K) q = 0
  · refine ⟨1, one_mem _, one_ne_zero, ?_⟩
    rw [mul_one, hx', hq, div_zero]
    exact zero_mem _
  · refine ⟨MvPolynomial.aeval (Subtype.val : (↑T : Set K) → K) q,
      aeval_mem_differentialJetAlgebra hT q, hq, ?_⟩
    rw [hx', div_mul_cancel₀ _ hq]
    exact aeval_mem_differentialJetAlgebra hT r

/-- **Clearing denominators in a finite family.**  One nonzero element clears every coefficient of a
finite family drawn from the differential adjoin. -/
theorem exists_common_denominator {N : ℕ} (c : Fin N → K)
    (hc : ∀ α, c α ∈ differentialAdjoin F s) :
    ∃ D : K, D ≠ 0 ∧ ∀ α, c α * D ∈ differentialJetAlgebra F s := by
  classical
  choose Q hQmem hQ0 hQmul using fun α => exists_jetAlgebra_denominator (F := F) (hc α)
  refine ⟨∏ β : Fin N, Q β, Finset.prod_ne_zero_iff.mpr fun β _ => hQ0 β, fun α => ?_⟩
  have hsplit : (∏ β : Fin N, Q β)
      = Q α * ∏ β ∈ Finset.univ.erase α, Q β := by
    rw [Finset.mul_prod_erase Finset.univ Q (Finset.mem_univ α)]
  rw [hsplit, ← mul_assoc]
  exact Subalgebra.mul_mem _ (hQmul α)
    (Subalgebra.prod_mem _ fun β _ => hQmem β)

/-- **A relation over the field is a relation over the jet algebra.**  Multiplying by a common
denominator preserves the relation and the nonvanishing of every coefficient. -/
theorem exists_cleared_relation {N : ℕ} {M : Type*} [AddCommMonoid M] [Module K M]
    (c : Fin N → K) (v : Fin N → M) (hc : ∀ α, c α ∈ differentialAdjoin F s)
    (hrel : ∑ α : Fin N, c α • v α = 0) :
    ∃ d : Fin N → K, (∀ α, d α ∈ differentialJetAlgebra F s)
      ∧ (∀ α, c α ≠ 0 → d α ≠ 0) ∧ ∑ α : Fin N, d α • v α = 0 := by
  obtain ⟨D, hD0, hDmem⟩ := exists_common_denominator (F := F) c hc
  refine ⟨fun α => c α * D, hDmem, fun α hα => mul_ne_zero hα hD0, ?_⟩
  have : ∑ α : Fin N, (c α * D) • v α = D • ∑ α : Fin N, c α • v α := by
    rw [Finset.smul_sum]
    exact Finset.sum_congr rfl fun α _ => by rw [smul_smul, mul_comm]
  rw [this, hrel, smul_zero]

/-- **The `Fin`-indexed presentation of a jet-algebra element.**  No denominator: a polynomial with
constant coefficients in finitely many jets. -/
theorem exists_fin_jetPoly_of_mem_algebra {y : K} (hy : y ∈ differentialJetAlgebra F s) :
    ∃ (M N : ℕ) (a : Fin M → K) (e : Fin M → Fin N → ℕ) (h : Fin N → K),
      (∀ α, a α ∈ Set.range (algebraMap F K)) ∧ (∀ i, h i ∈ differentialJetSet s)
        ∧ y = ∑ α : Fin M, a α * ∏ i : Fin N, h i ^ e α i := by
  classical
  rw [differentialJetAlgebra_eq_range] at hy
  obtain ⟨r, hr⟩ := hy
  obtain ⟨M, N, a, e, h, ha, hh, hval⟩ :=
    exists_fin_monomial_sum_mem (Subtype.val : differentialJetSet s → K) r
  refine ⟨M, N, a, e, h, ha, fun i => ?_, by rw [← hr]; exact hval⟩
  obtain ⟨z, hz⟩ := hh i
  exact hz ▸ z.2

end GaloisForLFunctions
