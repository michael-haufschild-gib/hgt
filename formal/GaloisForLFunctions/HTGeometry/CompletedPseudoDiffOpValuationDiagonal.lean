import GaloisForLFunctions.HTGeometry.CompletedPseudoDiffOpIntegerPrincipal

/-!
# Diagonal reduction over the completed pseudodifferential valuation ring

Matrices over the completed skew field admit row and column reduction by coefficients in its
valuation ring.  A globally least-valuation nonzero entry divides every entry on the left and on
the right, so one pair of integral shears clears its full column and row.  Recursion on the
complement gives a diagonal matrix.

The coefficient order is kept explicit throughout; no commutativity is used.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K]
variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- Simultaneously subtract integral left multiples of one source row from all rows. -/
def completedValuationRowShear (i₀ : ι)
    (c : ι → CompletedPseudoDiffOpInteger (K := K))
    (P : ι → κ → CompletedPseudoDiffOp K) : ι → κ → CompletedPseudoDiffOp K :=
  fun i j => P i j - (c i : CompletedPseudoDiffOp K) * P i₀ j

/-- Simultaneously subtract integral right multiples of one source column from all columns. -/
def completedValuationColShear (j₀ : κ)
    (c : κ → CompletedPseudoDiffOpInteger (K := K))
    (P : ι → κ → CompletedPseudoDiffOp K) : ι → κ → CompletedPseudoDiffOp K :=
  fun i j => P i j - P i j₀ * (c j : CompletedPseudoDiffOp K)

@[simp] theorem completedValuationRowShear_apply (i₀ : ι)
    (c : ι → CompletedPseudoDiffOpInteger (K := K))
    (P : ι → κ → CompletedPseudoDiffOp K) (i : ι) (j : κ) :
    completedValuationRowShear i₀ c P i j =
      P i j - (c i : CompletedPseudoDiffOp K) * P i₀ j := rfl

@[simp] theorem completedValuationColShear_apply (j₀ : κ)
    (c : κ → CompletedPseudoDiffOpInteger (K := K))
    (P : ι → κ → CompletedPseudoDiffOp K) (i : ι) (j : κ) :
    completedValuationColShear j₀ c P i j =
      P i j - P i j₀ * (c j : CompletedPseudoDiffOp K) := rfl

/-- One invertible integral row or column shear. -/
def CompletedValuationRowColStep
    (P Q : ι → κ → CompletedPseudoDiffOp K) : Prop :=
  (∃ (i₀ : ι) (c : ι → CompletedPseudoDiffOpInteger (K := K)), c i₀ = 0 ∧
      Q = completedValuationRowShear i₀ c P) ∨
  (∃ (j₀ : κ) (c : κ → CompletedPseudoDiffOpInteger (K := K)), c j₀ = 0 ∧
      Q = completedValuationColShear j₀ c P)

/-- Equivalence generated by integral row and column shears. -/
def CompletedValuationRowColEquiv :
    (ι → κ → CompletedPseudoDiffOp K) →
      (ι → κ → CompletedPseudoDiffOp K) → Prop :=
  Relation.ReflTransGen CompletedValuationRowColStep

theorem CompletedValuationRowColEquiv.refl
    (P : ι → κ → CompletedPseudoDiffOp K) :
    CompletedValuationRowColEquiv P P := Relation.ReflTransGen.refl

theorem CompletedValuationRowColEquiv.trans
    {P Q R : ι → κ → CompletedPseudoDiffOp K}
    (hPQ : CompletedValuationRowColEquiv P Q)
    (hQR : CompletedValuationRowColEquiv Q R) :
    CompletedValuationRowColEquiv P R := Relation.ReflTransGen.trans hPQ hQR

omit [Fintype ι] [Fintype κ] in
/-- A matrix is diagonalized when every nonzero entry is alone in its row and column. -/
def CompletedValuationDiagonalized (P : ι → κ → CompletedPseudoDiffOp K) : Prop :=
  ∀ i j, P i j ≠ 0 →
    (∀ i', i' ≠ i → P i' j = 0) ∧ (∀ j', j' ≠ j → P i j' = 0)

/-- A globally least-valuation entry can be cleared from its whole row and column by two integral
shears. -/
theorem exists_completedValuation_clear_pivot
    (P : ι → κ → CompletedPseudoDiffOp K)
    (i₀ : ι) (j₀ : κ) (h₀ : P i₀ j₀ ≠ 0) :
    ∃ (Q : ι → κ → CompletedPseudoDiffOp K) (i₁ : ι) (j₁ : κ),
      CompletedValuationRowColEquiv P Q ∧ Q i₁ j₁ ≠ 0 ∧
      (∀ i, i ≠ i₁ → Q i j₁ = 0) ∧
      (∀ j, j ≠ j₁ → Q i₁ j = 0) := by
  classical
  obtain ⟨p, -, hmin⟩ := Finset.exists_min_image
    (Finset.univ : Finset (ι × κ))
    (fun q => completedPseudoDiffOpAddValue (P q.1 q.2))
    ⟨(i₀, j₀), Finset.mem_univ _⟩
  have hp0 : P p.1 p.2 ≠ 0 := by
    intro hp
    have hle := hmin (i₀, j₀) (Finset.mem_univ _)
    rw [hp] at hle
    unfold completedPseudoDiffOpAddValue at hle
    rw [Valuation.map_zero] at hle
    exact completedPseudoDiffOpAddValue_ne_top_of_ne_zero h₀ (top_unique hle)
  have hpmin : ∀ i j, completedPseudoDiffOpAddValue (P p.1 p.2) ≤
      completedPseudoDiffOpAddValue (P i j) := by
    intro i j
    exact hmin (i, j) (Finset.mem_univ _)
  let c : ι → CompletedPseudoDiffOpInteger (K := K) := fun i =>
    if hi : i = p.1 then 0 else
      Classical.choose (exists_completedPseudoDiffOpInteger_left_factor hp0 (hpmin i p.2))
  have hc0 : c p.1 = 0 := by simp [c]
  have hc : ∀ i, i ≠ p.1 →
      (c i : CompletedPseudoDiffOp K) * P p.1 p.2 = P i p.2 := by
    intro i hi
    simp only [c, dif_neg hi]
    exact Classical.choose_spec
      (exists_completedPseudoDiffOpInteger_left_factor hp0 (hpmin i p.2))
  let P₁ := completedValuationRowShear p.1 c P
  have hP₁row : ∀ j, P₁ p.1 j = P p.1 j := by
    intro j
    simp [P₁, completedValuationRowShear, hc0]
  have hP₁col : ∀ i, i ≠ p.1 → P₁ i p.2 = 0 := by
    intro i hi
    simp [P₁, completedValuationRowShear, hc i hi]
  let d : κ → CompletedPseudoDiffOpInteger (K := K) := fun j =>
    if hj : j = p.2 then 0 else
      Classical.choose (exists_completedPseudoDiffOpInteger_right_factor hp0 (hpmin p.1 j))
  have hd0 : d p.2 = 0 := by simp [d]
  have hd : ∀ j, j ≠ p.2 →
      P p.1 p.2 * (d j : CompletedPseudoDiffOp K) = P p.1 j := by
    intro j hj
    simp only [d, dif_neg hj]
    exact Classical.choose_spec
      (exists_completedPseudoDiffOpInteger_right_factor hp0 (hpmin p.1 j))
  let P₂ := completedValuationColShear p.2 d P₁
  have hP₂piv : P₂ p.1 p.2 = P p.1 p.2 := by
    simp [P₂, completedValuationColShear, hd0, hP₁row]
  have hP₂col : ∀ i, i ≠ p.1 → P₂ i p.2 = 0 := by
    intro i hi
    simp [P₂, completedValuationColShear, hd0, hP₁col i hi]
  have hP₂row : ∀ j, j ≠ p.2 → P₂ p.1 j = 0 := by
    intro j hj
    simp [P₂, completedValuationColShear, hP₁row, hd j hj]
  have hPP₁ : CompletedValuationRowColEquiv P P₁ :=
    Relation.ReflTransGen.single (Or.inl ⟨p.1, c, hc0, rfl⟩)
  have hP₁P₂ : CompletedValuationRowColEquiv P₁ P₂ :=
    Relation.ReflTransGen.single (Or.inr ⟨p.2, d, hd0, rfl⟩)
  exact ⟨P₂, p.1, p.2, hPP₁.trans hP₁P₂, hP₂piv ▸ hp0, hP₂col, hP₂row⟩

/-- Complementary submatrix after deleting one row and one column. -/
def restrictCompletedValuationMatrix (i₀ : ι) (j₀ : κ)
    (P : ι → κ → CompletedPseudoDiffOp K) :
    {i : ι // i ≠ i₀} → {j : κ // j ≠ j₀} → CompletedPseudoDiffOp K :=
  fun i j => P i.1 j.1

@[simp] theorem restrictCompletedValuationMatrix_apply (i₀ : ι) (j₀ : κ)
    (P : ι → κ → CompletedPseudoDiffOp K)
    (i : {i : ι // i ≠ i₀}) (j : {j : κ // j ≠ j₀}) :
    restrictCompletedValuationMatrix i₀ j₀ P i j = P i.1 j.1 := rfl

/-- Row-column equivalence of a complementary block lifts while preserving a cleared pivot. -/
theorem exists_lift_completedValuationRowColEquiv
    {i₀ : ι} {j₀ : κ} {P : ι → κ → CompletedPseudoDiffOp K}
    (hcol : ∀ i, i ≠ i₀ → P i j₀ = 0)
    (hrow : ∀ j, j ≠ j₀ → P i₀ j = 0)
    {Q : {i : ι // i ≠ i₀} → {j : κ // j ≠ j₀} → CompletedPseudoDiffOp K}
    (h : CompletedValuationRowColEquiv
      (restrictCompletedValuationMatrix i₀ j₀ P) Q) :
    ∃ P' : ι → κ → CompletedPseudoDiffOp K,
      CompletedValuationRowColEquiv P P' ∧
      restrictCompletedValuationMatrix i₀ j₀ P' = Q ∧
      P' i₀ j₀ = P i₀ j₀ ∧
      (∀ i, i ≠ i₀ → P' i j₀ = 0) ∧
      (∀ j, j ≠ j₀ → P' i₀ j = 0) := by
  induction h with
  | refl => exact ⟨P, CompletedValuationRowColEquiv.refl P, rfl, rfl, hcol, hrow⟩
  | tail _ hQR ih =>
      obtain ⟨P', hPP', hres, hpiv, hcol', hrow'⟩ := ih
      rcases hQR with ⟨a₀, c, hc0, rfl⟩ | ⟨b₀, c, hc0, rfl⟩
      · let c' : ι → CompletedPseudoDiffOpInteger (K := K) := fun i =>
          if hi : i = i₀ then 0 else c ⟨i, hi⟩
        have hc'0 : c' a₀.1 = 0 := by simp [c', a₀.property, hc0]
        let P'' := completedValuationRowShear a₀.1 c' P'
        refine ⟨P'', Relation.ReflTransGen.tail hPP'
          (Or.inl ⟨a₀.1, c', hc'0, rfl⟩), ?_, ?_, ?_, ?_⟩
        · funext i j
          change P' i.1 j.1 - (c' i.1 : CompletedPseudoDiffOp K) * P' a₀.1 j.1 =
            _
          rw [show P' i.1 j.1 = _ from congrFun (congrFun hres i) j,
            show P' a₀.1 j.1 = _ from congrFun (congrFun hres a₀) j]
          simp [c', i.property]
        · simp [P'', completedValuationRowShear, c', hpiv]
        · intro i hi
          simp [P'', completedValuationRowShear, hcol' i hi,
            hcol' a₀.1 a₀.property]
        · intro j hj
          simp [P'', completedValuationRowShear, c', hrow' j hj]
      · let c' : κ → CompletedPseudoDiffOpInteger (K := K) := fun j =>
          if hj : j = j₀ then 0 else c ⟨j, hj⟩
        have hc'0 : c' b₀.1 = 0 := by simp [c', b₀.property, hc0]
        let P'' := completedValuationColShear b₀.1 c' P'
        refine ⟨P'', Relation.ReflTransGen.tail hPP'
          (Or.inr ⟨b₀.1, c', hc'0, rfl⟩), ?_, ?_, ?_, ?_⟩
        · funext i j
          change P' i.1 j.1 - P' i.1 b₀.1 * (c' j.1 : CompletedPseudoDiffOp K) =
            _
          rw [show P' i.1 j.1 = _ from congrFun (congrFun hres i) j,
            show P' i.1 b₀.1 = _ from congrFun (congrFun hres i) b₀]
          simp [c', j.property]
        · simp [P'', completedValuationColShear, c', hpiv]
        · intro i hi
          simp [P'', completedValuationColShear, c', hcol' i hi]
        · intro j hj
          simp [P'', completedValuationColShear, hrow' j hj,
            hrow' b₀.1 b₀.property]

/-- Diagonal reduction by recursion on the number of rows. -/
theorem exists_completedValuation_diagonalized_of_card_le :
    ∀ (n : ℕ) {ι : Type v} {κ : Type w}
      [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]
      (P : ι → κ → CompletedPseudoDiffOp K), Fintype.card ι ≤ n →
      ∃ Q : ι → κ → CompletedPseudoDiffOp K,
        CompletedValuationRowColEquiv P Q ∧ CompletedValuationDiagonalized Q := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
      intro ι κ _ _ _ _ P hcard
      by_cases hall : ∃ i j, P i j ≠ 0
      · obtain ⟨i₀, j₀, h₀⟩ := hall
        obtain ⟨P₁, i₁, j₁, hP₁, hpiv, hcol, hrow⟩ :=
          exists_completedValuation_clear_pivot P i₀ j₀ h₀
        have hcard' : Fintype.card {i : ι // i ≠ i₁} < n := by
          have hc : Fintype.card {i : ι // i ≠ i₁} = Fintype.card ι - 1 := by
            rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
          have hpos : 0 < Fintype.card ι := Fintype.card_pos_iff.mpr ⟨i₁⟩
          omega
        obtain ⟨Q, hQ, hQdiag⟩ := ih _ hcard'
          (restrictCompletedValuationMatrix i₁ j₁ P₁) le_rfl
        obtain ⟨P₂, hP₂, hres, -, hcol₂, hrow₂⟩ :=
          exists_lift_completedValuationRowColEquiv hcol hrow hQ
        refine ⟨P₂, hP₁.trans hP₂, ?_⟩
        intro i j hij
        by_cases hi : i = i₁
        · subst i
          have hj : j = j₁ := by
            by_contra hj
            exact hij (hrow₂ j hj)
          subst j
          exact ⟨hcol₂, hrow₂⟩
        · have hj : j ≠ j₁ := by
            intro h
            subst j
            exact hij (hcol₂ i hi)
          have hQij : Q ⟨i, hi⟩ ⟨j, hj⟩ ≠ 0 := by
            rw [← hres]
            exact hij
          obtain ⟨hQc, hQr⟩ := hQdiag ⟨i, hi⟩ ⟨j, hj⟩ hQij
          refine ⟨fun a ha => ?_, fun b hb => ?_⟩
          · by_cases hai : a = i₁
            · subst a
              exact hrow₂ j hj
            · have hz := hQc ⟨a, hai⟩
                (fun h => ha (congrArg Subtype.val h))
              rw [← hres] at hz
              exact hz
          · by_cases hbj : b = j₁
            · subst b
              exact hcol₂ i hi
            · have hz := hQr ⟨b, hbj⟩
                (fun h => hb (congrArg Subtype.val h))
              rw [← hres] at hz
              exact hz
      · refine ⟨P, CompletedValuationRowColEquiv.refl P, ?_⟩
        intro i j hij
        exact absurd ⟨i, j, hij⟩ hall

/-- Every finite matrix over the completed skew field is integrally row-column equivalent to a
diagonalized matrix. -/
theorem exists_completedValuation_diagonalized
    (P : ι → κ → CompletedPseudoDiffOp K) :
    ∃ Q : ι → κ → CompletedPseudoDiffOp K,
      CompletedValuationRowColEquiv P Q ∧ CompletedValuationDiagonalized Q :=
  exists_completedValuation_diagonalized_of_card_le (Fintype.card ι) P le_rfl

end


end DiffOp

end GaloisForLFunctions.HTGeometry
