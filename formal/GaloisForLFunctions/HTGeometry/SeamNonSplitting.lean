import Mathlib

/-!
# A first formal seam non-splitting class

This file formalizes the algebraic core of the `gamma-affine-stieltjes-log-independence`
residue.

The cutoff variable `X` models the cutoff scale `log P`.  The separable finite
counterterms are the submodule generated by `1` and `X`: constants plus linear
cutoff terms.  The first seam-visible residue is quadratic.  The theorem
`seamEpsilonOne_ne_zero` says that its class in the quotient by separable
counterterms is nonzero.

The order hierarchy then proves the same obstruction at every cutoff order:
`X^n` survives modulo the span of all lower powers `X^k`, `k < n`.

Mathematically this is the formal toy obstruction behind the statement:
an order-2 log counterterm cannot be absorbed by constants and order-1
archimedean/linear cutoff data.
-/

open Polynomial

namespace GaloisForLFunctions

noncomputable section

/-- The formal cutoff variable `L`, modelling the cutoff scale `log P`. -/
def seamCutoff : Polynomial ℚ := Polynomial.X

/-- Separable finite counterterms: constants plus terms linear in the cutoff. -/
def separableCounterterms : Submodule ℚ (Polynomial ℚ) :=
  Submodule.span ℚ ({(1 : Polynomial ℚ), seamCutoff} : Set (Polynomial ℚ))

/-- The first weld-visible quadratic term. -/
def quadraticWeldTerm : Polynomial ℚ := seamCutoff ^ (2 : ℕ)

/-- Every separable counterterm has zero quadratic coefficient. -/
lemma coeff_two_of_mem_separableCounterterms {P : Polynomial ℚ}
    (hP : P ∈ separableCounterterms) : P.coeff 2 = 0 := by
  change P ∈ Submodule.span ℚ ({(1 : Polynomial ℚ), seamCutoff} : Set (Polynomial ℚ)) at hP
  refine Submodule.span_induction
    (p := fun Q _ => Q.coeff 2 = 0)
    ?mem ?zero ?add ?smul hP
  · intro Q hQ
    simp [seamCutoff] at hQ
    rcases hQ with rfl | rfl
    · rw [Polynomial.coeff_one]
      norm_num
    · rw [Polynomial.coeff_X]
      norm_num
  · change (0 : Polynomial ℚ).coeff 2 = 0
    rw [Polynomial.coeff_zero]
  · intro P Q hPm hQm hPcoeff hQcoeff
    change (P + Q).coeff 2 = 0
    rw [Polynomial.coeff_add, hPcoeff, hQcoeff]
    norm_num
  · intro a P hPm hPcoeff
    change (a • P).coeff 2 = 0
    rw [Polynomial.coeff_smul, hPcoeff]
    norm_num

/-- The quadratic weld term cannot be absorbed by separable finite counterterms. -/
theorem quadraticWeldTerm_not_mem_separableCounterterms :
    quadraticWeldTerm ∉ separableCounterterms := by
  intro h
  have hcoeff : quadraticWeldTerm.coeff 2 = 0 := coeff_two_of_mem_separableCounterterms h
  have hquad : quadraticWeldTerm.coeff 2 = (1 : ℚ) := by
    rw [quadraticWeldTerm, seamCutoff, Polynomial.coeff_X_pow]
    norm_num
  rw [hquad] at hcoeff
  norm_num at hcoeff

/-- The quotient of cutoff germs by separable finite counterterms. -/
abbrev SeamWeldQuotient := (Polynomial ℚ) ⧸ separableCounterterms

/-- The first formal seam obstruction class. -/
def seamEpsilonOne : SeamWeldQuotient := Submodule.Quotient.mk quadraticWeldTerm

/-- The first seam obstruction class is nonzero. -/
theorem seamEpsilonOne_ne_zero : seamEpsilonOne ≠ 0 := by
  intro h
  apply quadraticWeldTerm_not_mem_separableCounterterms
  exact (Submodule.Quotient.mk_eq_zero separableCounterterms).mp h

/-- The coefficient-at-order linear functional. -/
def cutoffCoeff (n : ℕ) : Polynomial ℚ →ₗ[ℚ] ℚ where
  toFun := fun P => P.coeff n
  map_add' := by
    intro P Q
    rw [Polynomial.coeff_add]
  map_smul' := by
    intro a P
    simp [Polynomial.coeff_smul]

/-- The quadratic coefficient vanishes on separable finite counterterms. -/
lemma separableCounterterms_le_ker_cutoffCoeff_two :
    separableCounterterms ≤ LinearMap.ker (cutoffCoeff 2) := by
  intro P hP
  rw [LinearMap.mem_ker]
  exact coeff_two_of_mem_separableCounterterms hP

/-- The quadratic coefficient descends to the separable-counterterm seam quotient. -/
def seamQuadraticDetector : SeamWeldQuotient →ₗ[ℚ] ℚ :=
  separableCounterterms.liftQ (cutoffCoeff 2) separableCounterterms_le_ker_cutoffCoeff_two

@[simp]
theorem seamQuadraticDetector_mk (P : Polynomial ℚ) :
    seamQuadraticDetector (Submodule.Quotient.mk P : SeamWeldQuotient) = P.coeff 2 := by
  rfl

/-- The quadratic seam detector evaluates `ε₁` to `1`. -/
theorem seamQuadraticDetector_seamEpsilonOne :
    seamQuadraticDetector seamEpsilonOne = 1 := by
  rw [seamEpsilonOne, quadraticWeldTerm, seamQuadraticDetector_mk]
  rw [seamCutoff, Polynomial.coeff_X_pow]
  rw [if_pos rfl]

/-- The quadratic detector is invariant under changing representatives by separable counterterms. -/
theorem quadraticCoeff_eq_of_sub_mem_separableCounterterms {P Q : Polynomial ℚ}
    (h : P - Q ∈ separableCounterterms) : P.coeff 2 = Q.coeff 2 := by
  have hcoeff : (P - Q).coeff 2 = 0 := coeff_two_of_mem_separableCounterterms h
  rw [Polynomial.coeff_sub] at hcoeff
  linarith

/-- The half-quadratic coefficient from the Stieltjes seam model. -/
def gammaOneVisibleClass : SeamWeldQuotient :=
  Submodule.Quotient.mk ((Polynomial.C (1 / 2 : ℚ)) * quadraticWeldTerm)

/-- The quadratic detector reads the half-quadratic Stieltjes seam coefficient. -/
theorem seamQuadraticDetector_gammaOneVisibleClass :
    seamQuadraticDetector gammaOneVisibleClass = (1 / 2 : ℚ) := by
  rw [gammaOneVisibleClass, quadraticWeldTerm, seamQuadraticDetector_mk]
  rw [seamCutoff, Polynomial.coeff_C_mul_X_pow]
  rw [if_pos rfl]

/-- The half-quadratic Stieltjes seam class is nonzero. -/
theorem gammaOneVisibleClass_ne_zero : gammaOneVisibleClass ≠ 0 := by
  intro h
  have hdet := congrArg seamQuadraticDetector h
  rw [seamQuadraticDetector_gammaOneVisibleClass] at hdet
  norm_num at hdet

/-- Counterterms of cutoff order strictly below `n`. -/
def lowerOrderCounterterms (n : ℕ) : Submodule ℚ (Polynomial ℚ) :=
  Submodule.span ℚ ({P : Polynomial ℚ | ∃ k : ℕ, k < n ∧ P = seamCutoff ^ k} : Set (Polynomial ℚ))

/-- Every lower-order counterterm has zero coefficient at order `n`. -/
lemma coeff_self_of_mem_lowerOrderCounterterms (n : ℕ) {P : Polynomial ℚ}
    (hP : P ∈ lowerOrderCounterterms n) : P.coeff n = 0 := by
  change P ∈ Submodule.span ℚ
    ({P : Polynomial ℚ | ∃ k : ℕ, k < n ∧ P = seamCutoff ^ k} : Set (Polynomial ℚ)) at hP
  refine Submodule.span_induction
    (p := fun Q _ => Q.coeff n = 0)
    ?mem ?zero ?add ?smul hP
  · intro Q hQ
    rcases hQ with ⟨k, hk, rfl⟩
    rw [seamCutoff, Polynomial.coeff_X_pow]
    have hne : n ≠ k := by omega
    rw [if_neg hne]
  · change (0 : Polynomial ℚ).coeff n = 0
    rw [Polynomial.coeff_zero]
  · intro P Q hPm hQm hPcoeff hQcoeff
    change (P + Q).coeff n = 0
    rw [Polynomial.coeff_add, hPcoeff, hQcoeff]
    norm_num
  · intro a P hPm hPcoeff
    change (a • P).coeff n = 0
    rw [Polynomial.coeff_smul, hPcoeff]
    norm_num

/-- A cutoff term of exact order `n` cannot be absorbed by lower-order counterterms. -/
theorem cutoffOrderTerm_not_mem_lowerOrderCounterterms (n : ℕ) :
    seamCutoff ^ n ∉ lowerOrderCounterterms n := by
  intro h
  have hcoeff : (seamCutoff ^ n).coeff n = 0 := coeff_self_of_mem_lowerOrderCounterterms n h
  have hself : (seamCutoff ^ n).coeff n = (1 : ℚ) := by
    rw [seamCutoff, Polynomial.coeff_X_pow]
    rw [if_pos rfl]
  rw [hself] at hcoeff
  norm_num at hcoeff

/-- The quotient by all cutoff counterterms below order `n`. -/
abbrev CutoffOrderQuotient (n : ℕ) := (Polynomial ℚ) ⧸ lowerOrderCounterterms n

/-- The exact order-`n` cutoff obstruction class. -/
def cutoffOrderClass (n : ℕ) : CutoffOrderQuotient n :=
  Submodule.Quotient.mk (seamCutoff ^ n)

/-- The exact order-`n` cutoff obstruction class is nonzero. -/
theorem cutoffOrderClass_ne_zero (n : ℕ) : cutoffOrderClass n ≠ 0 := by
  intro h
  apply cutoffOrderTerm_not_mem_lowerOrderCounterterms n
  exact (Submodule.Quotient.mk_eq_zero (lowerOrderCounterterms n)).mp h

/-- The exact-order coefficient vanishes on lower-order counterterms. -/
lemma lowerOrderCounterterms_le_ker_cutoffCoeff (n : ℕ) :
    lowerOrderCounterterms n ≤ LinearMap.ker (cutoffCoeff n) := by
  intro P hP
  rw [LinearMap.mem_ker]
  exact coeff_self_of_mem_lowerOrderCounterterms n hP

/-- The exact-order coefficient descends to the quotient by lower-order counterterms. -/
def cutoffOrderDetector (n : ℕ) : CutoffOrderQuotient n →ₗ[ℚ] ℚ :=
  (lowerOrderCounterterms n).liftQ (cutoffCoeff n) (lowerOrderCounterterms_le_ker_cutoffCoeff n)

@[simp]
theorem cutoffOrderDetector_mk (n : ℕ) (P : Polynomial ℚ) :
    cutoffOrderDetector n (Submodule.Quotient.mk P : CutoffOrderQuotient n) = P.coeff n := by
  rfl

/-- The detector evaluates the exact-order obstruction class to `1`. -/
theorem cutoffOrderDetector_cutoffOrderClass (n : ℕ) :
    cutoffOrderDetector n (cutoffOrderClass n) = 1 := by
  rw [cutoffOrderClass, cutoffOrderDetector_mk]
  rw [seamCutoff, Polynomial.coeff_X_pow]
  rw [if_pos rfl]

/-- Exact-order detector is invariant under changing representatives by lower-order counterterms. -/
theorem cutoffCoeff_eq_of_sub_mem_lowerOrderCounterterms (n : ℕ) {P Q : Polynomial ℚ}
    (h : P - Q ∈ lowerOrderCounterterms n) : P.coeff n = Q.coeff n := by
  have hcoeff : (P - Q).coeff n = 0 := coeff_self_of_mem_lowerOrderCounterterms n h
  rw [Polynomial.coeff_sub] at hcoeff
  linarith

/-- The exact order-`n` cutoff obstruction class with leading coefficient `a`. -/
def scaledCutoffOrderClass (n : ℕ) (a : ℚ) : CutoffOrderQuotient n :=
  Submodule.Quotient.mk ((Polynomial.C a) * seamCutoff ^ n)

/-- The exact-order detector reads the leading coefficient of a scaled obstruction class. -/
theorem cutoffOrderDetector_scaledCutoffOrderClass (n : ℕ) (a : ℚ) :
    cutoffOrderDetector n (scaledCutoffOrderClass n a) = a := by
  rw [scaledCutoffOrderClass, cutoffOrderDetector_mk]
  rw [seamCutoff, Polynomial.coeff_C_mul_X_pow]
  rw [if_pos rfl]

/-- A nonzero leading coefficient gives a nonzero exact-order obstruction class. -/
theorem scaledCutoffOrderClass_ne_zero (n : ℕ) {a : ℚ} (ha : a ≠ 0) :
    scaledCutoffOrderClass n a ≠ 0 := by
  intro h
  have hdet := congrArg (cutoffOrderDetector n) h
  rw [cutoffOrderDetector_scaledCutoffOrderClass] at hdet
  simp at hdet
  exact ha hdet

end

end GaloisForLFunctions
