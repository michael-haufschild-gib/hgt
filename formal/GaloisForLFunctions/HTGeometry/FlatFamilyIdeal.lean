import GaloisForLFunctions.HTGeometry.WeightGradedFamily

/-!
# The flat family of a weight degeneration is saturated

The homogeneous parts of a polynomial in the extra variable, and the ideal generated by the
homogenizations:

```text
famComp, famComp_coeff        the weight-d part
sum_famComp                   ** a polynomial is the sum of its homogeneous parts **
famComp_mul_left_of_isFamHomog   multiplying by a homogeneous polynomial shifts the parts
familyIdeal                   the ideal generated by the homogenizations of the elements of I
mem_familyIdeal_iff           ** membership is part-by-part: F lies in the family ideal exactly
                                 when every homogeneous part of F dehomogenizes into I **
familyIdeal_saturated         ** and hence the family ideal is saturated in the extra variable **
```

The part-by-part criterion is what makes the family tractable.  One direction is a span induction in
which the only interesting case is a product, handled by decomposing the multiplier into homogeneous
parts and shifting; the other is the structure theorem, which writes a homogeneous element as a
power of the extra variable times the homogenization of its dehomogenization.

Saturation is then immediate: multiplying by the extra variable shifts the parts by one and leaves
their dehomogenizations alone.  This is the torsion-freeness of the family ring over the base line —
the flatness of the degeneration.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u
variable {σ : Type*} {K : Type u} [Field K]

/-- The weight-`d` part of a polynomial in the extra variable. -/
noncomputable def famComp (w : σ → ℤ) (d : ℤ) (F : Polynomial (MvPolynomial σ K)) :
    Polynomial (MvPolynomial σ K) :=
  ∑ j ∈ F.support, Polynomial.monomial j
    (MvPolynomial.weightedHomogeneousComponent w (d + j) (F.coeff j))

theorem famComp_coeff (w : σ → ℤ) (d : ℤ) (F : Polynomial (MvPolynomial σ K)) (j : ℕ) :
    (famComp w d F).coeff j
      = MvPolynomial.weightedHomogeneousComponent w (d + j) (F.coeff j) := by
  classical
  rw [famComp, Polynomial.finsetSum_coeff]
  by_cases hj : j ∈ F.support
  · rw [← Finset.add_sum_erase _ _ hj, Polynomial.coeff_monomial, if_pos rfl]
    rw [show (∑ i ∈ F.support.erase j,
        (Polynomial.monomial i
          (MvPolynomial.weightedHomogeneousComponent w (d + i) (F.coeff i))).coeff j) = 0 from ?_,
      add_zero]
    refine Finset.sum_eq_zero fun i hi => ?_
    have hne : i ≠ j := (Finset.mem_erase.mp hi).1
    rw [Polynomial.coeff_monomial, if_neg hne]
  · rw [Polynomial.notMem_support_iff] at hj
    rw [hj, map_zero]
    refine Finset.sum_eq_zero fun i hi => ?_
    rw [Polynomial.coeff_monomial]
    by_cases hij : i = j
    · exfalso
      subst hij
      exact (Polynomial.mem_support_iff.mp hi) hj
    · rw [if_neg hij]

/-- The weighted decomposition of a polynomial over the finitely many weights it uses. -/
theorem sum_weightedHomogeneousComponent_support (w : σ → ℤ) (p : MvPolynomial σ K) :
    ∑ e ∈ p.support.image (Finsupp.weight w),
        MvPolynomial.weightedHomogeneousComponent w e p = p := by
  classical
  ext γ
  rw [MvPolynomial.coeff_sum]
  by_cases hγ : γ ∈ p.support
  · have hmem : Finsupp.weight w γ ∈ p.support.image (Finsupp.weight w) :=
      Finset.mem_image_of_mem _ hγ
    rw [← Finset.add_sum_erase _ _ hmem,
      MvPolynomial.coeff_weightedHomogeneousComponent, if_pos rfl]
    rw [show (∑ e ∈ (p.support.image (Finsupp.weight w)).erase (Finsupp.weight w γ),
        MvPolynomial.coeff γ
          (MvPolynomial.weightedHomogeneousComponent w e p)) = 0 from ?_, add_zero]
    refine Finset.sum_eq_zero fun e he => ?_
    have hne : e ≠ Finsupp.weight w γ := (Finset.mem_erase.mp he).1
    rw [MvPolynomial.coeff_weightedHomogeneousComponent, if_neg (fun h => hne h.symm)]
  · rw [MvPolynomial.notMem_support_iff] at hγ
    rw [hγ]
    refine Finset.sum_eq_zero fun e _ => ?_
    rw [MvPolynomial.coeff_weightedHomogeneousComponent, hγ]
    exact ite_self 0

theorem weightedHomogeneousComponent_eq_zero_of_notMem {w : σ → ℤ} {p : MvPolynomial σ K} {e : ℤ}
    (he : e ∉ p.support.image (Finsupp.weight w)) :
    MvPolynomial.weightedHomogeneousComponent w e p = 0 := by
  classical
  ext γ
  rw [MvPolynomial.coeff_weightedHomogeneousComponent]
  by_cases hγ : Finsupp.weight w γ = e
  · rw [if_pos hγ, MvPolynomial.coeff_zero]
    by_contra hcon
    exact he (hγ ▸ Finset.mem_image_of_mem _ (MvPolynomial.mem_support_iff.mpr hcon))
  · rw [if_neg hγ, MvPolynomial.coeff_zero]

/-- The finitely many weights carried by a polynomial in the extra variable. -/
noncomputable def famWeights (w : σ → ℤ) (F : Polynomial (MvPolynomial σ K)) : Finset ℤ := by
  classical
  exact F.support.biUnion (fun j => (F.coeff j).support.image (fun α => Finsupp.weight w α - j))

/-- **A polynomial in the extra variable is the sum of its homogeneous parts.** -/
theorem sum_famComp (w : σ → ℤ) (F : Polynomial (MvPolynomial σ K)) :
    ∑ d ∈ famWeights w F, famComp w d F = F := by
  classical
  refine Polynomial.ext fun j => ?_
  rw [Polynomial.finsetSum_coeff]
  simp only [famComp_coeff]
  by_cases hj : j ∈ F.support
  · set p := F.coeff j with hp
    have hinj : Set.InjOn (fun d : ℤ => d + (j : ℤ)) ↑(famWeights w F) := by
      intro x _ y _ h
      simp only [] at h
      omega
    rw [show (∑ d ∈ famWeights w F,
        MvPolynomial.weightedHomogeneousComponent w (d + j) p)
        = ∑ e ∈ (famWeights w F).image (fun d => d + (j : ℤ)),
          MvPolynomial.weightedHomogeneousComponent w e p from
      (Finset.sum_image (f := fun e => MvPolynomial.weightedHomogeneousComponent w e p)
        hinj).symm]
    have hsub : p.support.image (Finsupp.weight w)
        ⊆ (famWeights w F).image (fun d => d + (j : ℤ)) := by
      intro e he
      obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp he
      refine Finset.mem_image.mpr ⟨Finsupp.weight w α - j, ?_, by ring⟩
      rw [famWeights, Finset.mem_biUnion]
      exact ⟨j, hj, Finset.mem_image_of_mem _ hα⟩
    rw [← Finset.sum_subset hsub ?_, sum_weightedHomogeneousComponent_support]
    intro e _ hnot
    exact weightedHomogeneousComponent_eq_zero_of_notMem hnot
  · rw [Polynomial.notMem_support_iff] at hj
    rw [hj]
    refine Finset.sum_eq_zero fun d _ => ?_
    rw [map_zero]

theorem famComp_add (w : σ → ℤ) (d : ℤ) (F G : Polynomial (MvPolynomial σ K)) :
    famComp w d (F + G) = famComp w d F + famComp w d G := by
  refine Polynomial.ext fun j => ?_
  rw [Polynomial.coeff_add, famComp_coeff, famComp_coeff, famComp_coeff,
    Polynomial.coeff_add, map_add]

theorem isFamHomog_famComp (w : σ → ℤ) (d : ℤ) (F : Polynomial (MvPolynomial σ K)) :
    IsFamHomog w d (famComp w d F) := by
  intro j
  rw [famComp_coeff]
  exact MvPolynomial.weightedHomogeneousComponent_isWeightedHomogeneous _ _

theorem famComp_eq_self_of_isFamHomog {w : σ → ℤ} {e : ℤ} {F : Polynomial (MvPolynomial σ K)}
    (hF : IsFamHomog w e F) : famComp w e F = F := by
  refine Polynomial.ext fun j => ?_
  rw [famComp_coeff]
  ext γ
  rw [MvPolynomial.coeff_weightedHomogeneousComponent]
  by_cases hγ : Finsupp.weight w γ = e + j
  · rw [if_pos hγ]
  · rw [if_neg hγ]
    by_contra hcon
    exact hγ (hF j (Ne.symm hcon))

theorem famComp_eq_zero_of_isFamHomog {w : σ → ℤ} {e d : ℤ} {F : Polynomial (MvPolynomial σ K)}
    (hF : IsFamHomog w e F) (hd : d ≠ e) : famComp w d F = 0 := by
  refine Polynomial.ext fun j => ?_
  rw [famComp_coeff, Polynomial.coeff_zero]
  ext γ
  rw [MvPolynomial.coeff_weightedHomogeneousComponent, MvPolynomial.coeff_zero]
  by_cases hγ : Finsupp.weight w γ = d + j
  · rw [if_pos hγ]
    by_contra hcon
    have := hF j hcon
    omega
  · rw [if_neg hγ]

/-- **Multiplying by a homogeneous polynomial shifts the homogeneous parts.** -/
theorem famComp_mul_left_of_isFamHomog {w : σ → ℤ} {e : ℤ} {H : Polynomial (MvPolynomial σ K)}
    (hH : IsFamHomog w e H) (G : Polynomial (MvPolynomial σ K)) (d : ℤ) :
    famComp w d (H * G) = H * famComp w (d - e) G := by
  classical
  refine Polynomial.ext fun j => ?_
  rw [famComp_coeff, Polynomial.coeff_mul, Polynomial.coeff_mul, map_sum]
  refine Finset.sum_congr rfl ?_
  rintro ⟨a, b⟩ hab
  have hsum : a + b = j := Finset.HasAntidiagonal.mem_antidiagonal.mp hab
  have hcast : (a : ℤ) + (b : ℤ) = (j : ℤ) := by exact_mod_cast hsum
  rw [mul_comm (H.coeff a), weightedHomogeneousComponent_mul_right (hH a),
    show d + (j : ℤ) - (e + (a : ℤ)) = d - e + (b : ℤ) from by omega,
    famComp_coeff, mul_comm]

theorem isFamHomog_X (w : σ → ℤ) :
    IsFamHomog w (-1) (Polynomial.X : Polynomial (MvPolynomial σ K)) := by
  classical
  intro j
  rw [Polynomial.coeff_X]
  by_cases hj : 1 = j
  · rw [if_pos hj, ← hj]
    intro γ hγ
    rw [MvPolynomial.coeff_one] at hγ
    by_cases hγ0 : γ = 0
    · rw [hγ0]
      simp
    · rw [if_neg (fun h => hγ0 h.symm)] at hγ
      exact absurd rfl hγ
  · rw [if_neg hj]
    intro γ hγ
    simp at hγ

theorem famComp_zero (w : σ → ℤ) (d : ℤ) :
    famComp w d (0 : Polynomial (MvPolynomial σ K)) = 0 := by
  rw [famComp]
  simp

theorem famComp_finsetSum {ι : Type*} (w : σ → ℤ) (d : ℤ) (s : Finset ι)
    (f : ι → Polynomial (MvPolynomial σ K)) :
    famComp w d (∑ i ∈ s, f i) = ∑ i ∈ s, famComp w d (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp [famComp_zero]
  | insert a s ha ih => rw [Finset.sum_insert ha, famComp_add, ih, Finset.sum_insert ha]

/-- The ideal of the flat family: generated by the homogenizations of the elements of `I`. -/
noncomputable def familyIdeal (w : σ → ℤ) (I : Ideal (MvPolynomial σ K)) :
    Ideal (Polynomial (MvPolynomial σ K)) :=
  Ideal.span {F | ∃ f ∈ I, f ≠ 0 ∧ homogenize w f = F}

theorem homogenize_mem_familyIdeal {w : σ → ℤ} {I : Ideal (MvPolynomial σ K)}
    {f : MvPolynomial σ K} (hf : f ∈ I) (hf0 : f ≠ 0) :
    homogenize w f ∈ familyIdeal w I :=
  Ideal.subset_span ⟨f, hf, hf0, rfl⟩

theorem mem_familyIdeal_of_isFamHomog {w : σ → ℤ} {I : Ideal (MvPolynomial σ K)} {e : ℤ}
    {F : Polynomial (MvPolynomial σ K)} (hF : IsFamHomog w e F)
    (hev : Polynomial.eval 1 F ∈ I) : F ∈ familyIdeal w I := by
  by_cases hF0 : F = 0
  · rw [hF0]
    exact Ideal.zero_mem _
  · have hf0 : Polynomial.eval 1 F ≠ 0 := eval_one_ne_zero_of_isFamHomog hF hF0
    rw [eq_X_pow_mul_homogenize hF hF0]
    exact Ideal.mul_mem_left _ _ (homogenize_mem_familyIdeal hev hf0)

theorem eval_one_famComp_mem {w : σ → ℤ} {I : Ideal (MvPolynomial σ K)}
    {F : Polynomial (MvPolynomial σ K)} (hF : F ∈ familyIdeal w I) :
    ∀ d : ℤ, Polynomial.eval 1 (famComp w d F) ∈ I := by
  classical
  induction hF using Submodule.span_induction with
  | mem G hG =>
    obtain ⟨f, hf, hf0, rfl⟩ := hG
    intro d
    by_cases hd : d = minWeight w f
    · rw [hd, famComp_eq_self_of_isFamHomog (isFamHomog_homogenize w f), homogenize_eval_one]
      exact hf
    · rw [famComp_eq_zero_of_isFamHomog (isFamHomog_homogenize w f) hd, Polynomial.eval_zero]
      exact Ideal.zero_mem _
  | zero =>
    intro d
    rw [famComp_zero, Polynomial.eval_zero]
    exact Ideal.zero_mem _
  | add x y _ _ hx hy =>
    intro d
    rw [famComp_add, Polynomial.eval_add]
    exact Ideal.add_mem _ (hx d) (hy d)
  | smul G x _ hx =>
    intro d
    have hmul : G • x = G * x := rfl
    have hG : G = ∑ e ∈ famWeights w G, famComp w e G := (sum_famComp w G).symm
    rw [hmul, hG, Finset.sum_mul, famComp_finsetSum, Polynomial.eval_finsetSum]
    refine Ideal.sum_mem _ fun e _ => ?_
    rw [famComp_mul_left_of_isFamHomog (isFamHomog_famComp w e G), Polynomial.eval_mul]
    exact Ideal.mul_mem_left _ _ (hx (d - e))

/-- **Membership in the family ideal is homogeneous-part-by-homogeneous-part.** -/
theorem mem_familyIdeal_iff {w : σ → ℤ} {I : Ideal (MvPolynomial σ K)}
    {F : Polynomial (MvPolynomial σ K)} :
    F ∈ familyIdeal w I ↔ ∀ d : ℤ, Polynomial.eval 1 (famComp w d F) ∈ I := by
  constructor
  · exact eval_one_famComp_mem
  · intro h
    have hF : F = ∑ d ∈ famWeights w F, famComp w d F := (sum_famComp w F).symm
    rw [hF]
    refine Ideal.sum_mem _ fun d _ => ?_
    exact mem_familyIdeal_of_isFamHomog (isFamHomog_famComp w d F) (h d)

/-- **The family ideal is saturated with respect to the extra variable**: the family ring is
torsion-free over the base line, which is the flatness of the degeneration. -/
theorem familyIdeal_saturated {w : σ → ℤ} {I : Ideal (MvPolynomial σ K)}
    {F : Polynomial (MvPolynomial σ K)} (h : Polynomial.X * F ∈ familyIdeal w I) :
    F ∈ familyIdeal w I := by
  rw [mem_familyIdeal_iff] at h ⊢
  intro d
  have hd := h (d - 1)
  rw [famComp_mul_left_of_isFamHomog (isFamHomog_X w), show d - 1 - (-1) = d from by ring,
    Polynomial.eval_mul, Polynomial.eval_X, one_mul] at hd
  exact hd

end GaloisForLFunctions.HTGeometry
