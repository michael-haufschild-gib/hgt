import GaloisForLFunctions.HTGeometry.KolchinNullstellensatz
import GaloisForLFunctions.HTGeometry.RittRaudenbushFinitelyMany

/-!
# Kolchin's Nullstellensatz for a differentially finitely generated algebra

A differentially reduced algebra presented by finitely many *differential* generators is a quotient
of a differential polynomial ring in finitely many indeterminates by a radical differential ideal.
Ritt–Raudenbush makes that ideal the radical differential ideal of a finite set, so the presentation
together with the Rabinowitsch equation is a *finite* differential system over the base, solvable in
a differential field extension.  Over a differentially closed field it is then solvable in the field
itself, and the solution is a differential point not killing the given element.

This is the form the theorem takes when the generators generate differentially rather than
algebraically: no finiteness of the algebra itself is required, only of the number of differential
generators.

* `exists_differentialAlgHom_ne_zero_of_diffFG`;
* `eq_zero_of_forall_mem_differentialPoints_of_diffFG`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

attribute [local instance] differentialPolynomialOverDifferential

/-- Jets commute with a derivation-preserving ring map. -/
theorem ringHom_map_differentialJet {E L : Type*} [CommRing E] [Differential E] [CommRing L]
    [Differential L] (f : E →+* L)
    (hf : ∀ x, f (Differential.deriv x) = Differential.deriv (f x)) :
    ∀ (n : ℕ) (u : E), f (differentialJet n u) = differentialJet n (f u)
  | 0, _ => rfl
  | (n + 1), u => by
      rw [differentialJet_succ, differentialJet_succ, hf, ringHom_map_differentialJet f hf n u]

/-- Evaluation of a renamed differential polynomial is evaluation at the renamed point. -/
theorem differentialPolynomialEvalOver_rename {ι κ K L : Type*} [CommRing K] [CommRing L]
    [Algebra K L] [Differential L] (g : ι → κ) (z : κ → L) (P : DifferentialPolynomial ι K) :
    differentialPolynomialEvalOver (K := K) z (MvPolynomial.rename (Prod.map g id) P)
      = differentialPolynomialEvalOver (K := K) (fun i => z (g i)) P := by
  rw [differentialPolynomialEvalOver, differentialPolynomialEvalOver,
    MvPolynomial.aeval_rename]
  rfl

universe u

variable {C E : Type u} [Field C] [Algebra ℚ C] [Differential C] [IsDifferentiallyClosed C]
  [CommRing E] [IsReduced E] [Algebra C E] [Algebra ℚ E]
  [Differential E] [DifferentialAlgebra C E]

/-- **Kolchin's Nullstellensatz, differential finite generation.**  Over a differentially closed
field, a nonzero element of a differentially reduced algebra generated by finitely many differential
generators is not killed by all differential points. -/
theorem exists_differentialAlgHom_ne_zero_of_diffFG {k : ℕ} (y : Fin k → E)
    (hy : Function.Surjective (differentialPolynomialEvalOver (K := C) (L := E) y))
    {e : E} (he : e ≠ 0) :
    ∃ χ : E →ₐ[C] C, (∀ x : E, χ (Differential.deriv x) = Differential.deriv (χ x)) ∧ χ e ≠ 0 := by
  classical
  have hbotrad : (⊥ : Ideal E).IsRadical := by
    intro y hy
    obtain ⟨n, hn⟩ := hy
    rw [Ideal.mem_bot] at hn ⊢
    exact IsReduced.eq_zero y ⟨n, hn⟩
  have hbotδ : ∀ x ∈ (⊥ : Ideal E), Differential.deriv x ∈ (⊥ : Ideal E) := by
    intro x hx
    rw [Ideal.mem_bot] at hx ⊢
    rw [hx, map_zero]
  obtain ⟨L, hLfield, hLdiff, f, hfδ, _, hfe⟩ :=
    exists_differentialField_hom_of_notMem (R := E) hbotrad hbotδ
      (e := e) (by rw [Ideal.mem_bot]; exact he)
  letI := hLfield
  letI := hLdiff
  letI : Algebra C L := (f.comp (algebraMap C E)).toAlgebra
  letI : Algebra ℚ L := (f.comp (algebraMap ℚ E)).toAlgebra
  have hCL : ∀ c : C, algebraMap C L c = f (algebraMap C E c) := fun _ => rfl
  have hcompatL : ∀ c : C, Differential.deriv (algebraMap C L c)
      = algebraMap C L (Differential.deriv c) := by
    intro c
    rw [hCL, hCL, ← hfδ, DifferentialAlgebra.deriv_algebraMap]
  letI fA : E →ₐ[C] L := { f with commutes' := fun c => rfl }
  have hfA : ∀ x : E, fA x = f x := fun _ => rfl
  set Ψ : DifferentialPolynomial (Fin k) C →ₐ[C] E :=
    differentialPolynomialEvalOver (K := C) y with hΨ
  set I : Ideal (DifferentialPolynomial (Fin k) C) :=
    RingHom.ker (Ψ : DifferentialPolynomial (Fin k) C →+* E) with hI
  have hIrad : I.IsRadical := by
    intro P hP
    obtain ⟨n, hn⟩ := hP
    have hpow : Ψ P ^ n = 0 := by
      rw [← map_pow]
      exact hn
    exact IsReduced.eq_zero _ ⟨n, hpow⟩
  have hIδ : ∀ P ∈ I, Differential.deriv P ∈ I := by
    intro P hP
    have hval : Ψ (differentialPolynomialOverDerivation (Fin k) C P)
        = Differential.deriv (Ψ P) :=
      differentialPolynomialEvalOver_derivation (K := C) y P
    show Ψ (Differential.deriv P) = 0
    rw [show Differential.deriv P = differentialPolynomialOverDerivation (Fin k) C P from rfl,
      hval, show Ψ P = 0 from hP, map_zero]
  obtain ⟨G, hG⟩ := radDiffFG_differentialPolynomial_fin (C := C) k I hIrad hIδ
  obtain ⟨Q, hQ⟩ := hy e
  set ι₀ : Fin k → ULift.{u} (Fin (k + 1)) := fun i => ULift.up i.castSucc with hι₀
  set ιlast : ULift.{u} (Fin (k + 1)) := ULift.up (Fin.last k) with hιlast
  set ρ : DifferentialPolynomial (Fin k) C →ₐ[C] DifferentialPolynomial (ULift.{u} (Fin (k + 1))) C
    := MvPolynomial.rename (Prod.map ι₀ id) with hρ
  set T : Finset (DifferentialPolynomial (ULift.{u} (Fin (k + 1))) C) :=
    G.image ρ ∪ {MvPolynomial.X (ιlast, 0) * ρ Q - 1} with hT
  obtain ⟨z, hzcast, hzlast⟩ : ∃ z : ULift.{u} (Fin (k + 1)) → L,
      (∀ i : Fin k, z (ι₀ i) = fA (y i)) ∧ z ιlast = (fA e)⁻¹ := by
    refine ⟨fun v => Fin.lastCases ((fA e)⁻¹) (fun i => fA (y i)) v.down, fun i => ?_, ?_⟩
    · exact Fin.lastCases_castSucc i
    · exact Fin.lastCases_last
  have hcomp : fA.comp Ψ = differentialPolynomialEvalOver (K := C) (fun i => fA (y i)) := by
    refine MvPolynomial.algHom_ext ?_
    rintro ⟨i, n⟩
    rw [AlgHom.comp_apply, hΨ, differentialPolynomialEvalOver_X,
      differentialPolynomialEvalOver_X]
    exact ringHom_map_differentialJet (fA : E →+* L) (fun x => hfδ x) n (y i)
  have hevalρ : ∀ P : DifferentialPolynomial (Fin k) C,
      differentialPolynomialEvalOver (K := C) z (ρ P) = fA (Ψ P) := by
    intro P
    rw [hρ, differentialPolynomialEvalOver_rename]
    have hfun : (fun i : Fin k => z (ι₀ i)) = fun i : Fin k => fA (y i) := funext hzcast
    rw [hfun, ← hcomp]
    rfl
  have hzsol : ∀ p ∈ T, differentialPolynomialEvalOver (K := C) z p = 0 := by
    intro p hp
    rcases Finset.mem_union.mp hp with hp | hp
    · obtain ⟨g, hgG, rfl⟩ := Finset.mem_image.mp hp
      rw [hevalρ]
      have hgI : g ∈ I := by
        rw [hG]
        exact subset_radicalDifferentialIdeal _ (by exact_mod_cast hgG)
      rw [show Ψ g = 0 from hgI, map_zero]
    · rw [Finset.mem_singleton] at hp
      subst hp
      rw [map_sub, map_mul, hevalρ, differentialPolynomialEvalOver_X, hzlast,
        differentialJet_zero, map_one, hQ, hfA]
      rw [inv_mul_cancel₀ hfe, sub_self]
  obtain ⟨b, hb⟩ := IsDifferentiallyClosed.exists_point (C := C) T ⟨L, hcompatL⟩ z hzsol
  set bb : Fin k → C := fun i => b (ι₀ i) with hbb
  set χ₀ : DifferentialPolynomial (Fin k) C →ₐ[C] C :=
    differentialPolynomialEvalOver (K := C) bb with hχ₀
  have hχ₀ρ : ∀ P : DifferentialPolynomial (Fin k) C,
      differentialPolynomialEvalOver (K := C) b (ρ P) = χ₀ P := by
    intro P
    rw [hρ, differentialPolynomialEvalOver_rename]
  have hχ₀δ : ∀ P : DifferentialPolynomial (Fin k) C,
      χ₀ (Differential.deriv P) = Differential.deriv (χ₀ P) :=
    fun P => differentialPolynomialEvalOver_derivation (K := C) bb P
  have hkerχ₀ : I ≤ RingHom.ker (χ₀ : DifferentialPolynomial (Fin k) C →+* C) := by
    rw [hG]
    refine radicalDifferentialIdeal_le ?_ ?_ ?_
    · intro g hg
      have := hb (ρ g) (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (by exact_mod_cast hg)))
      rw [hχ₀ρ] at this
      exact this
    · intro x hx
      obtain ⟨n, hn⟩ := hx
      have : χ₀ x ^ n = 0 := by rw [← map_pow]; exact hn
      exact pow_eq_zero_iff'.mp this |>.1
    · intro x hx
      show χ₀ (Differential.deriv x) = 0
      rw [hχ₀δ, show χ₀ x = 0 from hx, map_zero]
  set χ : E →ₐ[C] C :=
    (Ideal.Quotient.liftₐ I χ₀ (fun a ha => RingHom.mem_ker.mp (hkerχ₀ ha))).comp
      (Ideal.quotientKerAlgEquivOfSurjective hy).symm.toAlgHom with hχ
  have hχΨ : ∀ P : DifferentialPolynomial (Fin k) C, χ (Ψ P) = χ₀ P := by
    intro P
    show (Ideal.Quotient.liftₐ I χ₀ (fun a ha => RingHom.mem_ker.mp (hkerχ₀ ha)))
      ((Ideal.quotientKerAlgEquivOfSurjective hy).symm (Ψ P)) = _
    have hsymm : (Ideal.quotientKerAlgEquivOfSurjective hy).symm (Ψ P)
        = Ideal.Quotient.mk I P := by
      refine (AlgEquiv.symm_apply_eq _).mpr ?_
      rfl
    rw [hsymm]
    rfl
  refine ⟨χ, ?_, ?_⟩
  · intro x
    obtain ⟨P, rfl⟩ := hy x
    have hΨδ : Ψ (Differential.deriv P) = Differential.deriv (Ψ P) :=
      differentialPolynomialEvalOver_derivation (K := C) y P
    rw [← hΨδ, hχΨ, hχΨ, hχ₀δ]
  · rw [← hQ, hχΨ]
    have := hb (MvPolynomial.X (ιlast, 0) * ρ Q - 1)
      (Finset.mem_union_right _ (Finset.mem_singleton_self _))
    rw [map_sub, map_mul, hχ₀ρ, differentialPolynomialEvalOver_X, differentialJet_zero,
      map_one, sub_eq_zero] at this
    intro hzero
    rw [hzero, mul_zero] at this
    exact zero_ne_one this

/-- **The differential points of a differentially finitely generated algebra separate.** -/
theorem eq_zero_of_forall_mem_differentialPoints_of_diffFG {k : ℕ} (y : Fin k → E)
    (hy : Function.Surjective (differentialPolynomialEvalOver (K := C) (L := E) y))
    {x : E} (h : ∀ χ ∈ differentialPoints C E, χ x = 0) : x = 0 := by
  by_contra hx
  obtain ⟨χ, hχδ, hχx⟩ := exists_differentialAlgHom_ne_zero_of_diffFG (C := C) (E := E) y hy hx
  exact hχx (h χ hχδ)

end

end GaloisForLFunctions.HTGeometry
