import GaloisForLFunctions.HTGeometry.GeneralizedCliffordPrincipalSymbolFaithfulness
import Mathlib.LinearAlgebra.ExteriorPower.Basis

/-!
# Quantum-torus principal symbols

A pairwise `q`-commuting operator family has an information-complete exterior commutator symbol
whenever its ordered quadratic monomials are linearly independent.  The proof constructs an
explicit decoder from those monomials back to the second exterior power.  Injective linear changes
of law coordinates preserve the result, as does generalized-Clifford shift suspension to the
rational observable field.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped TensorProduct

universe u v w

variable {K : Type u} {M : Type v} {V : Type w} {ι : Type*}
  [Field K] [CharZero K]
  [AddCommGroup M] [Module K M]
  [AddCommGroup V] [Module K V]
  [Fintype ι] [LinearOrder ι]

/-- An increasing pair of law coordinates. -/
structure QuantumLawPair (ι : Type*) [LT ι] where
  lower : ι
  upper : ι
  isLt : lower < upper
  deriving DecidableEq

/-- The ordered quadratic monomial attached to an increasing law pair. -/
def quantumPairOperator (G : ι → Module.End K M) (p : QuantumLawPair ι) :
    Module.End K M :=
  G p.upper * G p.lower

/-- The canonical coordinate bivector attached to an increasing law pair. -/
def quantumPairWedge (p : QuantumLawPair ι) : ⋀[K]^2 (ι → K) :=
  exteriorPower.ιMulti K 2
    ![Pi.basisFun K ι p.lower, Pi.basisFun K ι p.upper]

/-- The linear operator pencil generated by a finite family. -/
def quantumGeneratorSymbol (G : ι → Module.End K M) :
    (ι → K) →ₗ[K] Module.End K M :=
  Fintype.linearCombination K G

omit [CharZero K] in
@[simp]
theorem quantumGeneratorSymbol_basisFun
    (G : ι → Module.End K M) (i : ι) :
    quantumGeneratorSymbol G (Pi.basisFun K ι i) = G i := by
  classical
  simp [quantumGeneratorSymbol]

/-- Decode the independent ordered quadratic monomials on their linear span. -/
def quantumPairSpanDecoder
    (q : K) (G : ι → Module.End K M)
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    Submodule.span K (Set.range (quantumPairOperator G)) →ₗ[K]
      ⋀[K]^2 (ι → K) :=
  (Finsupp.linearCombination K fun p : QuantumLawPair ι ↦
    (q - 1)⁻¹ • quantumPairWedge (K := K) p).comp hLI.repr

/-- Extend the ordered-pair decoder to the whole endomorphism space. -/
def quantumPairDecoder
    (q : K) (G : ι → Module.End K M)
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    Module.End K M →ₗ[K] ⋀[K]^2 (ι → K) :=
  Classical.choose (LinearMap.exists_extend (quantumPairSpanDecoder q G hLI))

omit [CharZero K] in
theorem quantumPairDecoder_apply
    (q : K) (G : ι → Module.End K M)
    (hLI : LinearIndependent K (quantumPairOperator G))
    (p : QuantumLawPair ι) :
    quantumPairDecoder q G hLI (quantumPairOperator G p) =
      (q - 1)⁻¹ • quantumPairWedge (K := K) p := by
  have hp : quantumPairOperator G p ∈
      Submodule.span K (Set.range (quantumPairOperator G)) :=
    Submodule.subset_span (Set.mem_range_self p)
  have hext := LinearMap.congr_fun
    (Classical.choose_spec (LinearMap.exists_extend (quantumPairSpanDecoder q G hLI)))
    ⟨quantumPairOperator G p, hp⟩
  rw [LinearMap.comp_apply] at hext
  have hrepr := hLI.repr_eq_single p ⟨quantumPairOperator G p, hp⟩ rfl
  calc
    quantumPairDecoder q G hLI (quantumPairOperator G p) =
        quantumPairSpanDecoder q G hLI ⟨quantumPairOperator G p, hp⟩ := by
      simpa [quantumPairDecoder] using hext
    _ = (q - 1)⁻¹ • quantumPairWedge (K := K) p := by
      unfold quantumPairSpanDecoder
      rw [LinearMap.comp_apply, hrepr]
      simp

omit [CharZero K] [Fintype ι] in
/-- A `q`-commuting pair has commutator `(q-1)` times its ordered quadratic monomial. -/
theorem quantumGenerator_commutator_of_lt
    (q : K) (G : ι → Module.End K M)
    (hComm : ∀ i j, i < j → G i * G j = q • (G j * G i))
    {i j : ι} (hij : i < j) :
    ⁅G i, G j⁆ =
      (q - 1) • quantumPairOperator G ⟨i, j, hij⟩ := by
  change ⁅G i, G j⁆ = (q - 1) • (G j * G i)
  rw [LieRing.of_associative_ring_bracket, hComm i j hij]
  module

/-- Decoder composed with the canonical quantum commutator symbol. -/
def decodedQuantumCommutatorMap
    (q : K) (G : ι → Module.End K M)
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    (⋀[K]^2 (ι → K)) →ₗ[K] ⋀[K]^2 (ι → K) :=
  (quantumPairDecoder q G hLI).comp
    (endomorphismCommutatorMap (quantumGeneratorSymbol G))

omit [CharZero K] in
/-- The ordered-monomial decoder is a left inverse to the canonical commutator symbol. -/
theorem decodedQuantumCommutatorMap_eq_id
    (q : K) (G : ι → Module.End K M)
    (hq : q ≠ 1)
    (hComm : ∀ i j, i < j → G i * G j = q • (G j * G i))
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    decodedQuantumCommutatorMap q G hLI = LinearMap.id := by
  apply ((Pi.basisFun K ι).exteriorPower 2).ext
  intro s
  rw [exteriorPower.basis_apply]
  let e : Fin 2 ↪o ι := Set.powersetCard.ofFinEmbEquiv.symm s
  have he : e 0 < e 1 := e.strictMono Fin.zero_lt_one
  let p : QuantumLawPair ι := ⟨e 0, e 1, he⟩
  change quantumPairDecoder q G hLI
      (endomorphismCommutatorMap (quantumGeneratorSymbol G)
        (exteriorPower.ιMulti K 2
          ![Pi.basisFun K ι (e 0), Pi.basisFun K ι (e 1)])) =
    exteriorPower.ιMulti K 2
      ![Pi.basisFun K ι (e 0), Pi.basisFun K ι (e 1)]
  rw [endomorphismCommutatorMap_wedge,
    quantumGeneratorSymbol_basisFun, quantumGeneratorSymbol_basisFun,
    quantumGenerator_commutator_of_lt q G hComm he,
    map_smul, quantumPairDecoder_apply]
  change (q - 1) • ((q - 1)⁻¹ • quantumPairWedge (K := K) p) =
    quantumPairWedge (K := K) p
  rw [smul_smul, mul_inv_cancel₀ (sub_ne_zero.mpr hq), one_smul]

omit [CharZero K] in
/-- **Canonical quantum-torus principal-symbol theorem.**  Independent ordered quadratic
monomials make the complete exterior commutator symbol injective. -/
theorem quantumGenerator_endomorphismCommutatorMap_injective
    (q : K) (G : ι → Module.End K M)
    (hq : q ≠ 1)
    (hComm : ∀ i j, i < j → G i * G j = q • (G j * G i))
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    Function.Injective
      (endomorphismCommutatorMap (quantumGeneratorSymbol G)) := by
  intro z z' hzz'
  have hdecoded := congrArg (quantumPairDecoder q G hLI) hzz'
  have hleft := LinearMap.congr_fun
    (decodedQuantumCommutatorMap_eq_id q G hq hComm hLI)
  calc
    z = decodedQuantumCommutatorMap q G hLI z := (hleft z).symm
    _ = decodedQuantumCommutatorMap q G hLI z' := hdecoded
    _ = z' := hleft z'

omit [Fintype ι] [LinearOrder ι] in
omit [CharZero K] in
/-- Exterior commutator symbols are natural under linear changes of law coordinates. -/
theorem endomorphismCommutatorMap_comp
    (symbol : (ι → K) →ₗ[K] Module.End K M)
    (L : V →ₗ[K] (ι → K)) :
    endomorphismCommutatorMap (symbol.comp L) =
      (endomorphismCommutatorMap symbol).comp (exteriorPower.map 2 L) := by
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro f
  have hf : f = ![f 0, f 1] := by
    funext i
    fin_cases i <;> rfl
  rw [hf, LinearMap.compAlternatingMap_apply,
    LinearMap.compAlternatingMap_apply, LinearMap.comp_apply,
    exteriorPower.map_apply_ιMulti, endomorphismCommutatorMap_wedge]
  have hLf : (⇑L ∘ ![f 0, f 1]) = ![L (f 0), L (f 1)] := by
    funext i
    fin_cases i <;> rfl
  rw [hLf, endomorphismCommutatorMap_wedge]
  rfl

omit [CharZero K] in
/-- **Coordinate-free quantum principal-symbol theorem.**  An injective linear family of
coefficients transports the canonical maximal commutator rank to any law space. -/
theorem quantumTorus_endomorphismCommutatorMap_injective
    (q : K) (G : ι → Module.End K M)
    (L : V →ₗ[K] (ι → K)) (hL : Function.Injective L)
    (hq : q ≠ 1)
    (hComm : ∀ i j, i < j → G i * G j = q • (G j * G i))
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    Function.Injective
      (endomorphismCommutatorMap ((quantumGeneratorSymbol G).comp L)) := by
  rw [endomorphismCommutatorMap_comp]
  exact (quantumGenerator_endomorphismCommutatorMap_injective q G hq hComm hLI).comp
    (exteriorPower.map_injective_field (n := 2) hL)

omit [CharZero K] in
/-- Shift suspension preserves the maximal quantum principal-symbol rank exactly. -/
theorem quantumTorus_derivationCommutatorMap_injective
    (q : K) (G : ι → Module.End K M)
    (L : V →ₗ[K] (ι → K)) (hL : Function.Injective L)
    (hq : q ≠ 1)
    (hComm : ∀ i j, i < j → G i * G j = q • (G j * G i))
    (hLI : LinearIndependent K (quantumPairOperator G)) :
    Function.Injective
      (derivationCommutatorMap
        (generalizedCliffordShiftFieldDerivationLaw
          ((quantumGeneratorSymbol G).comp L))) := by
  exact (generalizedCliffordField_derivationCommutatorMap_injective_iff
    ((quantumGeneratorSymbol G).comp L)).2
    (quantumTorus_endomorphismCommutatorMap_injective q G L hL hq hComm hLI)

end

end GaloisForLFunctions.HTGeometry
