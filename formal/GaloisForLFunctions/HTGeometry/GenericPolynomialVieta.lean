import GaloisForLFunctions.HTGeometry.GenericPolynomialSplitting
import Mathlib.RingTheory.Polynomial.Vieta

/-!
# The coefficients of the generic polynomial are the elementary symmetric functions

Expanding the product of the linear factors gives the coefficient of each power as the
corresponding elementary symmetric function of the roots, up to sign.  So the field generated by
the coefficients of the generic polynomial is exactly the field generated by the elementary
symmetric functions, which is the symmetric part.

The generic polynomial is therefore read over the field its own coefficients generate.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial Polynomial

variable {K : Type*} [Field K] {d : ℕ}

/-- **Vieta for the generic polynomial.** -/
theorem coeff_genericMonicF {k : ℕ} (hk : k ≤ d) :
    (genericMonicF K d).coeff k =
      (-1 : SymmetricRationalField K d) ^ (d - k) *
        algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
          (MvPolynomial.esymm (Fin d) K (d - k)) := by
  classical
  have hcard : (Finset.univ : Finset (Fin d)).card = d := by simp
  have hrewrite : genericMonicF K d =
      ∏ i : Fin d, (Polynomial.X + Polynomial.C (-genericRoot K d i)) := by
    rw [genericMonicF]
    exact Finset.prod_congr rfl fun i _ => by rw [map_neg, sub_eq_add_neg]
  rw [hrewrite, Finset.prod_X_add_C_coeff _ _ (by rw [hcard]; exact hk), hcard]
  rw [MvPolynomial.esymm, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t ht => ?_
  rw [Finset.mem_powersetCard] at ht
  rw [Finset.prod_neg, ht.2, map_prod]
  refine congrArg _ (Finset.prod_congr rfl fun i _ => ?_)
  rfl

/-- The coefficients of the generic polynomial, read as rational functions. -/
noncomputable def genericCoeff (K : Type*) [Field K] (d : ℕ) (k : Fin d) :
    SymmetricRationalField K d :=
  (genericMonicF K d).coeff (k : ℕ)

theorem genericCoeff_mem_esymmField (k : Fin d) : genericCoeff K d k ∈ esymmField K d := by
  have hk : (k : ℕ) ≤ d := le_of_lt k.2
  rw [genericCoeff, coeff_genericMonicF hk]
  refine mul_mem ?_ ?_
  · exact pow_mem (neg_mem (one_mem _)) _
  · obtain ⟨j, hj⟩ : ∃ j : Fin d, ((j : ℕ) + 1) = d - (k : ℕ) :=
      ⟨⟨d - (k : ℕ) - 1, by omega⟩, by simp only []; omega⟩
    have : algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
        (MvPolynomial.esymm (Fin d) K (d - (k : ℕ))) = esymmGen K d j := by
      rw [esymmGen, hj]
    rw [this, esymmField]
    exact IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩

theorem esymmGen_mem_adjoin_genericCoeff (i : Fin d) :
    esymmGen K d i ∈ IntermediateField.adjoin K (Set.range (genericCoeff K d)) := by
  obtain ⟨k, hk⟩ : ∃ k : Fin d, d - (k : ℕ) = (i : ℕ) + 1 :=
    ⟨⟨d - (i : ℕ) - 1, by omega⟩, by simp only []; omega⟩
  have hkd : (k : ℕ) ≤ d := le_of_lt k.2
  have hcoeff : genericCoeff K d k =
      (-1 : SymmetricRationalField K d) ^ ((i : ℕ) + 1) * esymmGen K d i := by
    rw [genericCoeff, coeff_genericMonicF hkd, hk, esymmGen]
  have hmem : genericCoeff K d k ∈
      IntermediateField.adjoin K (Set.range (genericCoeff K d)) :=
    IntermediateField.subset_adjoin _ _ ⟨k, rfl⟩
  have hunit : ((-1 : SymmetricRationalField K d) ^ ((i : ℕ) + 1))⁻¹ *
      genericCoeff K d k = esymmGen K d i := by
    rw [hcoeff, ← mul_assoc, inv_mul_cancel₀ (by
      exact pow_ne_zero _ (by norm_num)), one_mul]
  rw [← hunit]
  exact mul_mem (inv_mem (pow_mem (neg_mem (one_mem _)) _)) hmem

/-- **The generic polynomial is read over the field its coefficients generate.** -/
theorem esymmField_eq_adjoin_genericCoeff :
    esymmField K d = IntermediateField.adjoin K (Set.range (genericCoeff K d)) := by
  refine le_antisymm ?_ ?_
  · rw [esymmField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact esymmGen_mem_adjoin_genericCoeff i
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨k, rfl⟩
    exact genericCoeff_mem_esymmField k

/-- **The symmetric part is the field generated by the coefficients of the generic
polynomial.** -/
theorem symmetricPartField_eq_adjoin_genericCoeff :
    symmetricPartField K d = IntermediateField.adjoin K (Set.range (genericCoeff K d)) :=
  symmetricPartField_eq_esymmField.trans esymmField_eq_adjoin_genericCoeff

end GaloisForLFunctions.HTGeometry
