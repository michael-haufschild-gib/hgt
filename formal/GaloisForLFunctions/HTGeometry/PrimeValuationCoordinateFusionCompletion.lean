import GaloisForLFunctions.HTGeometry.AnalyticDirichletObservableFieldCorrespondence
import GaloisForLFunctions.HTGeometry.PrimeValuationFusionCompletionLaw
import GaloisForLFunctions.HTGeometry.UpperEndRationalCoordinateDifferentialAdjoin

/-!
# Coordinate-intrinsic prime-valuation fusion completion

The complete prime-valuation carrier family is jointly differentially independent over the
genuine embedded coordinate field `ℂ(s)`, not merely over the constants.  Its depth filtration
has exact constant frontier rank.  Moreover the derivation-closed carrier-fusion completions are
exactly the principal upper filter generated by the canonical all-layer differential field.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Module
open scoped Differential

noncomputable section

universe u

local instance coordinateFusionUpperEndAnalyticDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance coordinateFusionUpperEndMeroComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance coordinateFusionUpperEndMeroDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance coordinateFusionComplexDifferential : Differential ℂ where
  deriv := 0

local instance coordinateFusionUpperEndComplexDifferentialAlgebra :
    DifferentialAlgebra ℂ upperEndMeroField :=
  ⟨fun c => by
    rw [upperEndMero_deriv_complexConstant c]
    change (0 : upperEndMeroField) = algebraMap ℂ upperEndMeroField 0
    rw [map_zero]⟩

local instance coordinateFusionCoordinateDifferential :
    Differential upperEndRationalCoordinateField :=
  GaloisForLFunctions.derivationClosedDifferential
    upperEndRationalCoordinateField upperEndRationalCoordinateField_derivationClosed

local instance coordinateFusionCoordinateDifferentialAlgebra :
    DifferentialAlgebra upperEndRationalCoordinateField upperEndMeroField where
  deriv_algebraMap c := by
    change (c.1)′ = ((c′ : upperEndRationalCoordinateField) : upperEndMeroField)
    rfl

/-! ## The complete coordinate-relative differential spectrum -/

/-- Every finite valuation--residue--derivative rectangle is algebraically independent over the
genuine embedded coordinate field `ℂ(s)`. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_jets_algebraicIndependent_over_coordinate
    {d m : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    AlgebraicIndependent upperEndRationalCoordinateField
      (fun q : PrimeResidueValuationInteractionGridIndex d A × Fin (m + 1) =>
        GaloisForLFunctions.differentialJet q.2
          (primeResidueValuationUpperEndCarrier A y q.1.1 q.1.2)) := by
  letI : Fintype (∀ i, A i) := Fintype.ofFinite _
  letI : DecidableEq (∀ i, A i) := Classical.decEq _
  let B : Fin d → Type u := fun _ =>
    (∀ i, A i) × (Unit × Fin (m + 1))
  letI (r : Fin d) : Fintype (B r) := inferInstance
  letI (r : Fin d) : DecidableEq (B r) := Classical.decEq _
  let f : ∀ r, B r → finiteAbscissaArithmeticSubalgebra := fun _ x =>
    primeResidueAnalyticJetSource A y x
  let a : ∀ r, B r → Nat.Primes → ℂ := fun _ x =>
    primeResidueAnalyticJetCoefficient A y x
  have hf : ∀ r x, (f r x).1 = arithmeticOfPrimeColumn (a r x) := by
    intro r x
    exact primeResidueAnalyticJetSource_eq_arithmeticOfPrimeColumn A y x
  have htail : ∀ r, TailCoefficientIndependent (a r) := by
    intro r
    exact cofiniteTailDenseOn_primeResidueAnalyticJetCoefficient_tailIndependent A y hy
  have hraw := algebraicIndependent_primePowerDilatedUpperEndMero_over_coordinate
    B f a hf htail
  let embed : PrimeResidueValuationInteractionGridIndex d A × Fin (m + 1) →
      Σ r, B r := fun q => ⟨q.1.1, (q.1.2, ((), q.2))⟩
  let project : (Σ r, B r) →
      PrimeResidueValuationInteractionGridIndex d A × Fin (m + 1) :=
    fun q => (⟨q.1, q.2.1⟩, q.2.2.2)
  have hembed : Function.Injective embed := by
    exact Function.LeftInverse.injective (fun q => rfl : ∀ q, project (embed q) = q)
  have hsub := hraw.comp embed hembed
  let scale : PrimeResidueValuationInteractionGridIndex d A × Fin (m + 1) →
      upperEndRationalCoordinateField := fun q =>
    algebraMap ℂ upperEndRationalCoordinateField
      (((q.1.1.1 + 1 : ℕ) : ℂ) ^ (q.2 : ℕ))
  have hscale : ∀ q, scale q ≠ 0 := by
    intro q
    simpa [scale] using
      (algebraMap ℂ upperEndRationalCoordinateField).injective.ne
        (pow_ne_zero (q.2 : ℕ)
          (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero q.1.1.1)))
  have hscaled :=
    AlgebraicIndependent.const_mul_coordinates hsub scale hscale
  convert hscaled using 1
  funext q
  change GaloisForLFunctions.differentialJet q.2
      (finiteAbscissaLSeriesToUpperEndMero
        (finiteAbscissaPrimePowerDilation q.1.1
          (primeResidueFiniteAbscissaSource A y q.1.2))) =
    algebraMap upperEndRationalCoordinateField upperEndMeroField
        (algebraMap ℂ upperEndRationalCoordinateField
          ((((q.1.1.1 + 1 : ℕ) : ℂ) ^ (q.2 : ℕ)))) *
      finiteAbscissaLSeriesToUpperEndMero
        (finiteAbscissaPrimePowerDilation q.1.1
          ((finiteAbscissaRotatedDeriv^[q.2])
            (primeResidueFiniteAbscissaSource A y q.1.2)))
  rw [← IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField upperEndMeroField]
  rw [differentialJet_finiteAbscissaLSeriesToUpperEndMero,
    finiteAbscissaRotatedDeriv_iterate_primePowerDilation]
  rw [map_smul]
  rw [Algebra.smul_def]

/-- Every finite valuation--residue grid is jointly differentially independent over `ℂ(s)`. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_differentialIndependent_over_coordinate
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
      (primeResidueValuationUpperEndGridCarrier (d := d) A y) := by
  unfold GaloisForLFunctions.DifferentialIndependent
  exact algebraicIndependent_prod_nat_of_all_fin _ fun m =>
    cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_jets_algebraicIndependent_over_coordinate
      A y hy

/-- The entire countable valuation--residue carrier family is jointly differentially independent
over `ℂ(s)`.  This strengthens the finite-rectangle lower bound to a global free family. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndAllLayerCarrier_differentialIndependent_over_coordinate
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
      (primeResidueValuationUpperEndAllLayerCarrier A y) := by
  unfold GaloisForLFunctions.DifferentialIndependent
  apply algebraicIndependent_of_finite_type
  intro t ht
  have hdepth : ((fun q : (ℕ × (∀ i, A i)) × ℕ => q.1.1) '' (t : Set _)).Finite :=
    ht.image _
  have hjet : ((fun q : (ℕ × (∀ i, A i)) × ℕ => q.2) '' (t : Set _)).Finite :=
    ht.image _
  obtain ⟨d, hd⟩ := hdepth.bddAbove
  obtain ⟨m, hm⟩ := hjet.bddAbove
  let embed : t → PrimeResidueValuationInteractionGridIndex (d + 1) A × Fin (m + 1) :=
    fun q =>
      (⟨⟨q.1.1.1, Nat.lt_succ_of_le (hd ⟨q.1, q.2, rfl⟩)⟩, q.1.1.2⟩,
        ⟨q.1.2, Nat.lt_succ_of_le (hm ⟨q.1, q.2, rfl⟩)⟩)
  have hembed : Function.Injective embed := by
    intro q r hqr
    apply Subtype.ext
    have hval := congrArg
      (fun z : PrimeResidueValuationInteractionGridIndex (d + 1) A × Fin (m + 1) =>
        (((z.1.1 : ℕ), z.1.2), (z.2 : ℕ))) hqr
    simpa [embed] using hval
  have hrect :=
    cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_jets_algebraicIndependent_over_coordinate
      (d := d + 1) (m := m) A y hy
  have hsub := hrect.comp embed hembed
  simpa [embed, primeResidueValuationUpperEndAllLayerCarrier,
    primeResidueValuationUpperEndGridCarrier] using hsub

/-! ## Coordinate-relative frontiers -/

/-- Every selected finite grid sector is relatively HT over the coordinate differential field
generated by its complete complement. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndGridSector_relativeHT_over_coordinate
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop) :
    GaloisForLFunctions.DifferentialIndependent
      (GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
        (Set.range (primeResidueValuationUpperEndGridSectorComplementCarrier A y Q)))
      (primeResidueValuationUpperEndGridSectorCarrier A y Q) := by
  let total := PrimeResidueValuationInteractionGridIndex d A
  let other := PrimeResidueValuationGridSectorComplementIndex d A Q
  let cell := PrimeResidueValuationGridSectorIndex d A Q
  let full : total → upperEndMeroField :=
    primeResidueValuationUpperEndGridCarrier A y
  let left : other → upperEndMeroField :=
    primeResidueValuationUpperEndGridSectorComplementCarrier A y Q
  let right : cell → upperEndMeroField :=
    primeResidueValuationUpperEndGridSectorCarrier A y Q
  have hfull :=
    cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_differentialIndependent_over_coordinate
      (d := d) A y hy
  let embed : other ⊕ cell → total
    | Sum.inl x => x.1
    | Sum.inr x => x.1
  have hembed : Function.Injective embed := by
    intro x z hxz
    rcases x with x | x <;> rcases z with z | z
    · exact congrArg Sum.inl (Subtype.ext hxz)
    · exfalso
      change x.1 = z.1 at hxz
      exact x.2 (hxz ▸ z.2)
    · exfalso
      change x.1 = z.1 at hxz
      exact z.2 (hxz.symm ▸ x.2)
    · exact congrArg Sum.inr (Subtype.ext hxz)
  have hjoint := hfull.comp embed hembed
  have hfamily : full ∘ embed = Sum.elim left right := by
    funext x
    rcases x with x | x <;> rfl
  have hjoint' : GaloisForLFunctions.DifferentialIndependent
      upperEndRationalCoordinateField (Sum.elim left right) := by
    rw [← hfamily]
    exact hjoint
  exact GaloisForLFunctions.differentialIndependent_sum_right_over_left_differentialAdjoin
    left right hjoint'

/-- The coordinate-relative differential field generated by every valuation layer through depth
`n`. -/
def primeResidueValuationUpperEndCoordinateDepthPrefixField
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
    (Set.range (primeResidueValuationUpperEndDepthPrefixCarrier (n := n) A y))

/-- The complete next layer is relatively HT over the genuine coordinate field and all complete
earlier carrier layers, with exact relative rank equal to the state-space cardinality. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_relativeHT_over_coordinate
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    GaloisForLFunctions.DifferentialIndependent
        (primeResidueValuationUpperEndCoordinateDepthPrefixField n A y)
        (primeResidueValuationUpperEndNextLayerCarrier (n := n) A y) ∧
      Nat.card (PrimeResidueValuationNextLayerIndex n A) =
        ∏ i, Fintype.card (A i) := by
  constructor
  · simpa only [primeResidueValuationUpperEndCoordinateDepthPrefixField] using
      (cofiniteTailDenseOn_primeResidueValuationUpperEndGridSector_relativeHT_over_coordinate
        A y hy (fun x : PrimeResidueValuationInteractionGridIndex (n + 2) A =>
          x.1.1 = n + 1))
  · exact primeResidueValuationNextLayerIndex_card n A

theorem cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_not_mem_coordinatePrefix
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (z : ∀ i, A i) :
    primeResidueValuationUpperEndCarrier A y (n + 1) z ∉
      primeResidueValuationUpperEndCoordinateDepthPrefixField n A y := by
  let out : PrimeResidueValuationNextLayerIndex n A :=
    ⟨⟨⟨n + 1, by omega⟩, z⟩, rfl⟩
  have hrel :=
    (cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_relativeHT_over_coordinate
      n A y hy).1
  unfold GaloisForLFunctions.DifferentialIndependent at hrel
  have htrans : Transcendental
      (primeResidueValuationUpperEndCoordinateDepthPrefixField n A y)
      (primeResidueValuationUpperEndNextLayerCarrier (n := n) A y out) := by
    simpa using hrel.transcendental (out, 0)
  intro hmem
  apply htrans
  simpa using isAlgebraic_algebraMap
    (R := primeResidueValuationUpperEndCoordinateDepthPrefixField n A y)
    (A := upperEndMeroField)
    (⟨primeResidueValuationUpperEndCarrier A y (n + 1) z, hmem⟩ :
      primeResidueValuationUpperEndCoordinateDepthPrefixField n A y)

/-- The coordinate-relative depth-prefix fields form a strict infinite tower. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndCoordinateDepthPrefixField_strictMono
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    primeResidueValuationUpperEndCoordinateDepthPrefixField n A y <
      primeResidueValuationUpperEndCoordinateDepthPrefixField (n + 1) A y := by
  have hrange :
      Set.range (primeResidueValuationUpperEndDepthPrefixCarrier (n := n) A y) ⊆
        Set.range
          (primeResidueValuationUpperEndDepthPrefixCarrier (n := n + 1) A y) := by
    rintro _ ⟨q, rfl⟩
    let q' : PrimeResidueValuationDepthPrefixIndex (n + 1) A :=
      ⟨⟨⟨q.1.1.1, by omega⟩, q.1.2⟩, by
        change q.1.1.1 ≠ n + 1 + 1
        omega⟩
    exact ⟨q', rfl⟩
  have hle : primeResidueValuationUpperEndCoordinateDepthPrefixField n A y ≤
      primeResidueValuationUpperEndCoordinateDepthPrefixField (n + 1) A y := by
    unfold primeResidueValuationUpperEndCoordinateDepthPrefixField
    unfold GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨x, hx, k, rfl⟩
    exact IntermediateField.subset_adjoin upperEndRationalCoordinateField _
      ⟨x, hrange hx, k, rfl⟩
  let vacuum : ∀ i, A i := fun _ => 1
  have hnot : primeResidueValuationUpperEndCarrier A y (n + 1) vacuum ∉
      primeResidueValuationUpperEndCoordinateDepthPrefixField n A y :=
    cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_not_mem_coordinatePrefix
      n A y hy vacuum
  have hmem : primeResidueValuationUpperEndCarrier A y (n + 1) vacuum ∈
      primeResidueValuationUpperEndCoordinateDepthPrefixField (n + 1) A y := by
    let q : PrimeResidueValuationDepthPrefixIndex (n + 1) A :=
      ⟨⟨⟨n + 1, by omega⟩, vacuum⟩, by
        change n + 1 ≠ n + 1 + 1
        omega⟩
    change primeResidueValuationUpperEndCarrier A y (n + 1) vacuum ∈
      GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
        (Set.range
          (primeResidueValuationUpperEndDepthPrefixCarrier (n := n + 1) A y))
    exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨q, rfl⟩
  exact lt_of_le_of_ne hle fun heq => hnot (heq ▸ hmem)

/-- Neutral-source fusion creates the exact next carrier outside the complete coordinate prefix. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndCoordinateVacuumCreationLaw
    (n : ℕ) {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    GaloisForLFunctions.DifferentialIndependent
        (primeResidueValuationUpperEndCoordinateDepthPrefixField n A y)
        (primeResidueValuationUpperEndNextLayerCarrier (n := n) A y) ∧
      Nat.card (PrimeResidueValuationNextLayerIndex n A) =
        ∏ i, Fintype.card (A i) ∧
      primeResidueValuationUpperEndCoordinateDepthPrefixField n A y <
        primeResidueValuationUpperEndCoordinateDepthPrefixField (n + 1) A y ∧
      ∀ z : ∀ i, A i,
        primeResidueValuationUpperEndCarrier A y n z ∈
            primeResidueValuationUpperEndCoordinateDepthPrefixField n A y ∧
          primeResidueValuationUpperEndCarrier A y 0 (fun _ => 1) ∈
            primeResidueValuationUpperEndCoordinateDepthPrefixField n A y ∧
          primeValuationFusion n 0
              (primeResidueValuationObservableColumn A y n
                (anchoredRestrictedProductBasis A z))
              (primeResidueValuationObservableColumn A y 0
                (anchoredRestrictedProductBasis A (fun _ => 1))) =
            primeResidueValuationObservableColumn A y (n + 1)
              (anchoredRestrictedProductBasis A z) ∧
          primeResidueValuationUpperEndCarrier A y (n + 1) z ∉
            primeResidueValuationUpperEndCoordinateDepthPrefixField n A y := by
  obtain ⟨hnext, hrank⟩ :=
    cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_relativeHT_over_coordinate
      n A y hy
  refine ⟨hnext, hrank,
    cofiniteTailDenseOn_primeResidueValuationUpperEndCoordinateDepthPrefixField_strictMono
      n A y hy, ?_⟩
  intro z
  have hdis :
      Disjoint (pointedSupport A z) (pointedSupport A (fun _ => 1)) := by
    simp
  let inputN : PrimeResidueValuationDepthPrefixIndex n A :=
    ⟨⟨⟨n, by omega⟩, z⟩, by
      change n ≠ n + 1
      omega⟩
  let inputZero : PrimeResidueValuationDepthPrefixIndex n A :=
    ⟨⟨⟨0, by omega⟩, fun _ => 1⟩, by
      change 0 ≠ n + 1
      omega⟩
  constructor
  · exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨inputN, rfl⟩
  constructor
  · exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨inputZero, rfl⟩
  constructor
  · simpa using
      (primeResidueValuationAnchoredBasisColumn_fusion_of_disjoint
        A y n 0 z (fun _ => 1) hdis)
  · simpa using
      (cofiniteTailDenseOn_primeResidueValuationUpperEndNextLayer_not_mem_coordinatePrefix
        n A y hy z)

/-! ## The principal-filter completion classification -/

/-- Coordinate-based carrier-fusion completeness. -/
def PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField) : Prop :=
  ∀ (e r : ℕ) (z w : ∀ i, A i),
    Disjoint (pointedSupport A z) (pointedSupport A w) →
      primeResidueValuationUpperEndCarrier A y e z ∈ L →
      primeResidueValuationUpperEndCarrier A y r w ∈ L →
      primeResidueValuationUpperEndCarrier A y (e + r + 1)
        (pointedUnion A z w) ∈ L

theorem primeResidueValuationUpperEndCoordinate_allLayers_mem_of_fusionClosed
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField)
    (hzero : ∀ z : ∀ i, A i,
      primeResidueValuationUpperEndCarrier A y 0 z ∈ L)
    (hfusion : PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y L) :
    ∀ (e : ℕ) (z : ∀ i, A i),
      primeResidueValuationUpperEndCarrier A y e z ∈ L := by
  intro e
  induction e with
  | zero => exact hzero
  | succ e ih =>
      intro z
      have hdis :
          Disjoint (pointedSupport A z) (pointedSupport A (fun _ => 1)) := by
        simp
      have hcreated := hfusion e 0 z (fun _ => 1) hdis (ih z) (hzero (fun _ => 1))
      simpa using hcreated

/-- The canonical all-layer differential field over the genuine coordinate field. -/
def primeResidueValuationUpperEndCoordinateFusionCompletionField
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    IntermediateField upperEndRationalCoordinateField upperEndMeroField :=
  GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField
    (Set.range (primeResidueValuationUpperEndAllLayerCarrier A y))

theorem primeResidueValuationUpperEndCoordinateFusionCompletionField_zero_mem
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (z : ∀ i, A i) :
    primeResidueValuationUpperEndCarrier A y 0 z ∈
      primeResidueValuationUpperEndCoordinateFusionCompletionField A y := by
  exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨(0, z), rfl⟩

theorem primeResidueValuationUpperEndCoordinateFusionCompletionField_fusionClosed
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y
      (primeResidueValuationUpperEndCoordinateFusionCompletionField A y) := by
  intro e r z w _hdis _he _hr
  exact GaloisForLFunctions.subset_differentialAdjoin _ _
    ⟨(e + r + 1, pointedUnion A z w), rfl⟩

theorem primeResidueValuationUpperEndCoordinateFusionCompletionField_le
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField)
    (hderiv : GaloisForLFunctions.DerivationClosed L)
    (hzero : ∀ z : ∀ i, A i,
      primeResidueValuationUpperEndCarrier A y 0 z ∈ L)
    (hfusion : PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y L) :
    primeResidueValuationUpperEndCoordinateFusionCompletionField A y ≤ L := by
  apply GaloisForLFunctions.differentialAdjoin_le upperEndRationalCoordinateField
  · rintro _ ⟨x, rfl⟩
    exact primeResidueValuationUpperEndCoordinate_allLayers_mem_of_fusionClosed
      A y L hzero hfusion x.1 x.2
  · exact hderiv

theorem primeResidueValuationUpperEndCoordinateFusionCompletionField_derivationClosed
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    GaloisForLFunctions.DerivationClosed
      (primeResidueValuationUpperEndCoordinateFusionCompletionField A y) := by
  exact GaloisForLFunctions.derivationClosed_differentialAdjoin
    upperEndRationalCoordinateField _

/-- **Principal-filter classification.** Among derivation-closed intermediate fields over
`ℂ(s)`, carrier-fusion completions containing depth zero are exactly the upper interval above the
canonical all-layer field. -/
theorem primeResidueValuationUpperEndCoordinateFusionCompletion_principalFilter_iff
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField) :
    (GaloisForLFunctions.DerivationClosed L ∧
        (∀ z : ∀ i, A i, primeResidueValuationUpperEndCarrier A y 0 z ∈ L) ∧
        PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y L) ↔
      (GaloisForLFunctions.DerivationClosed L ∧
        primeResidueValuationUpperEndCoordinateFusionCompletionField A y ≤ L) := by
  constructor
  · rintro ⟨hderiv, hzero, hfusion⟩
    exact ⟨hderiv,
      primeResidueValuationUpperEndCoordinateFusionCompletionField_le
        A y L hderiv hzero hfusion⟩
  · rintro ⟨hderiv, hle⟩
    refine ⟨hderiv, ?_, ?_⟩
    · intro z
      exact hle (primeResidueValuationUpperEndCoordinateFusionCompletionField_zero_mem A y z)
    · intro e r z w _hdis _he _hr
      exact hle (GaloisForLFunctions.subset_differentialAdjoin _ _
        ⟨(e + r + 1, pointedUnion A z w), rfl⟩)

/-- Every coordinate-based fusion completion contains the complete countable free carrier family
and finite independent rectangles of exact rank `d * ∏ i, |A i|`. -/
theorem cofiniteTailDenseOn_primeResidueValuationUpperEndCoordinateFusionCompletionLaw
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ)
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField)
    (hzero : ∀ z : ∀ i, A i,
      primeResidueValuationUpperEndCarrier A y 0 z ∈ L)
    (hfusion : PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y L) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
        (primeResidueValuationUpperEndAllLayerCarrier A y) ∧
      (∀ x : ℕ × (∀ i, A i),
        primeResidueValuationUpperEndAllLayerCarrier A y x ∈ L) ∧
      ∀ d : ℕ,
        GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
            (primeResidueValuationUpperEndGridCarrier (d := d) A y) ∧
          (∀ x : PrimeResidueValuationInteractionGridIndex d A,
            primeResidueValuationUpperEndGridCarrier A y x ∈ L) ∧
          Nat.card (PrimeResidueValuationInteractionGridIndex d A) =
            d * ∏ i, Fintype.card (A i) := by
  have hall := primeResidueValuationUpperEndCoordinate_allLayers_mem_of_fusionClosed
    A y L hzero hfusion
  refine ⟨
    cofiniteTailDenseOn_primeResidueValuationUpperEndAllLayerCarrier_differentialIndependent_over_coordinate
      A y hy,
    ?_, ?_⟩
  · intro x
    exact hall x.1 x.2
  · intro d
    refine ⟨
      cofiniteTailDenseOn_primeResidueValuationUpperEndCarrier_differentialIndependent_over_coordinate
        (d := d) A y hy,
      ?_, primeResidueValuationInteractionGridIndex_card d A⟩
    intro x
    exact hall x.1 x.2

/-- **Actual-prime coordinate completion law.** Simultaneous unit residues modulo pairwise-coprime
moduli force exact finite-depth rank `d * ∏ i, φ(q i)` over the genuine coordinate field. -/
theorem pairwiseCoprimePrimeResidueValuationUpperEndCoordinateFusionCompletionLaw
    {ι : Type} [Fintype ι] [DecidableEq ι]
    (modulus : ι → ℕ) [∀ i, NeZero (modulus i)]
    [NeZero (∏ i, modulus i)]
    (h : Pairwise (Function.onFun Nat.Coprime modulus))
    (L : IntermediateField upperEndRationalCoordinateField upperEndMeroField) :
    let A := fun i => (ZMod (modulus i))ˣ
    let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
    (∀ z : ∀ i, A i,
      primeResidueValuationUpperEndCarrier A y 0 z ∈ L) →
    PrimeResidueValuationUpperEndCoordinateCarrierFusionClosed A y L →
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
        (primeResidueValuationUpperEndAllLayerCarrier A y) ∧
      (∀ x : ℕ × (∀ i, A i),
        primeResidueValuationUpperEndAllLayerCarrier A y x ∈ L) ∧
      ∀ d : ℕ,
        GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
            (primeResidueValuationUpperEndGridCarrier (d := d) A y) ∧
          (∀ x : PrimeResidueValuationInteractionGridIndex d A,
            primeResidueValuationUpperEndGridCarrier A y x ∈ L) ∧
          Nat.card (PrimeResidueValuationInteractionGridIndex d A) =
            d * ∏ i, Nat.totient (modulus i) := by
  dsimp only
  intro hzero hfusion
  let A := fun i => (ZMod (modulus i))ˣ
  let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
  letI : TopologicalSpace (∀ i, A i) := ⊥
  letI : DiscreteTopology (∀ i, A i) := ⟨rfl⟩
  have hy : CofiniteTailDenseOn y Set.univ :=
    cofiniteTailDenseOn_univ_of_recurringValueSet_eq_univ y
      (recurringValueSet_pairwiseCoprimePrimeUnitResidueProfile modulus h)
  obtain ⟨hallDI, hallMem, hfinite⟩ :=
    cofiniteTailDenseOn_primeResidueValuationUpperEndCoordinateFusionCompletionLaw
      A y hy L hzero hfusion
  refine ⟨hallDI, hallMem, ?_⟩
  intro d
  obtain ⟨hind, hmem, hrank⟩ := hfinite d
  refine ⟨hind, hmem, ?_⟩
  dsimp [A] at hrank ⊢
  simpa only [ZMod.card_units_eq_totient] using hrank

end

