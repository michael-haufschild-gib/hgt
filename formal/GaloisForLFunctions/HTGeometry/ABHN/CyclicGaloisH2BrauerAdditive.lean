import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisAlgebraBrauerTensorProduct
import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisH2BrauerSubgroup
import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisH2TorsionBrauer

/-!
# Additive cyclic cohomology-to-Brauer map

The cyclic tensor-product formula makes the selected map from cyclic `H²` to `BrauerGroup K`
an additive homomorphism.  This removes the free-abelian presentation workaround: multiplication
of cyclic parameters is exactly addition of their Brauer classes.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

/-- The selected cyclic `H²` Brauer map preserves addition in every finite cyclic degree. -/
theorem cyclicGaloisH2BrauerMap_add
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z w : cyclicGaloisH2 K L) :
    cyclicGaloisH2BrauerMap K L (z + w) =
      cyclicGaloisH2BrauerMap K L z + cyclicGaloisH2BrauerMap K L w := by
  obtain ⟨a, ha⟩ := cyclicGaloisH2BaseProjection_surjective K L z
  obtain ⟨b, hb⟩ := cyclicGaloisH2BaseProjection_surjective K L w
  have hab : cyclicGaloisH2BaseProjection K L (a + b) = z + w := by
    rw [map_add, ha, hb]
  calc
    cyclicGaloisH2BrauerMap K L (z + w) =
        brauerClass (cyclicGaloisH2ParameterCSA K L (a + b)) :=
      (cyclicGaloisH2Parameter_brauerClass_eq_brauerMap_of_baseProjection
        K L (a + b) (z + w) hab).symm
    _ = brauerClass (cyclicGaloisH2ParameterCSA K L a) +
        brauerClass (cyclicGaloisH2ParameterCSA K L b) := by
      simpa [cyclicGaloisH2ParameterCSA] using
        (cyclicGaloisAlgebra_brauerClass_add K L
          (a.toMul : K) (b.toMul : K) a.toMul.ne_zero b.toMul.ne_zero).symm
    _ = cyclicGaloisH2BrauerMap K L z + cyclicGaloisH2BrauerMap K L w := by
      rw [cyclicGaloisH2Parameter_brauerClass_eq_brauerMap_of_baseProjection K L a z ha,
        cyclicGaloisH2Parameter_brauerClass_eq_brauerMap_of_baseProjection K L b w hb]

/-- Cyclic `H² → Br(K)` as an actual additive homomorphism. -/
noncomputable def cyclicGaloisH2BrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisH2 K L →+ BrauerGroup K where
  toFun := cyclicGaloisH2BrauerMap K L
  map_zero' := by
    exact cyclicGaloisH2BrauerMap_zero_eq_split K L
  map_add' := cyclicGaloisH2BrauerMap_add K L

@[simp]
theorem cyclicGaloisH2BrauerAddHom_apply
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z : cyclicGaloisH2 K L) :
    cyclicGaloisH2BrauerAddHom K L z = cyclicGaloisH2BrauerMap K L z := rfl

/-- The additive cyclic `H²` map with codomain restricted to classes generated by `L/K`. -/
noncomputable def cyclicGaloisH2BrauerSubgroupAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisH2 K L →+ cyclicGaloisBrauerSubgroup K L :=
  (cyclicGaloisH2BrauerAddHom K L).codRestrict (cyclicGaloisBrauerSubgroup K L)
    (cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L)

/-- Every cyclic Brauer class generated by `L/K` is represented by one cyclic `H²` class;
additive closure is no longer needed after the tensor-product theorem. -/
theorem cyclicGaloisH2BrauerSubgroupAddHom_surjective
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    Function.Surjective (cyclicGaloisH2BrauerSubgroupAddHom K L) := by
  intro x
  have hx : (x : BrauerGroup K) ∈
      AddSubgroup.closure (Set.range (cyclicGaloisH2BrauerMap K L)) := by
    rw [← cyclicGaloisBrauerSubgroup_eq_closure_range_cyclicGaloisH2BrauerMap]
    exact x.property
  have hle : AddSubgroup.closure (Set.range (cyclicGaloisH2BrauerMap K L)) ≤
      (cyclicGaloisH2BrauerAddHom K L).range := by
    rw [AddSubgroup.closure_le]
    rintro y ⟨z, rfl⟩
    exact ⟨z, rfl⟩
  obtain ⟨z, hz⟩ := hle hx
  refine ⟨z, ?_⟩
  apply Subtype.ext
  exact hz

/-- Range of additive cyclic `H²` realization is exactly cyclic Brauer subgroup. -/
theorem cyclicGaloisH2BrauerAddHom_range
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    (cyclicGaloisH2BrauerAddHom K L).range = cyclicGaloisBrauerSubgroup K L := by
  apply le_antisymm
  · rintro x ⟨z, rfl⟩
    exact cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L z
  · intro x hx
    obtain ⟨z, hz⟩ := cyclicGaloisH2BrauerSubgroupAddHom_surjective K L ⟨x, hx⟩
    exact ⟨z, congrArg Subtype.val hz⟩

/-- Direct first-isomorphism theorem for cyclic `H²`: quotient only by the actual kernel of
its Brauer realization, with no free-abelian detour. -/
noncomputable def cyclicGaloisH2QuotientBrauerKernelAddEquiv
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisH2 K L ⧸ (cyclicGaloisH2BrauerSubgroupAddHom K L).ker ≃+
      cyclicGaloisBrauerSubgroup K L :=
  QuotientAddGroup.quotientKerEquivOfSurjective
    (cyclicGaloisH2BrauerSubgroupAddHom K L)
    (cyclicGaloisH2BrauerSubgroupAddHom_surjective K L)

/-- Cyclic `H² → Br(K)` with codomain restricted to the defining relative Brauer kernel. -/
noncomputable def cyclicGaloisH2RelativeBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (hdeg : Module.finrank K L = n + 1) :
    cyclicGaloisH2 K L →+ scalarExtensionBrauerKernel K L :=
  (cyclicGaloisH2BrauerAddHom K L).codRestrict (scalarExtensionBrauerKernel K L)
    (cyclicGaloisH2BrauerMap_mem_scalarExtensionBrauerKernel K L n hdeg)

/-- A finite cyclic `H²` coordinate `ZMod n` induces an additive Brauer map. -/
noncomputable def cyclicGaloisH2InvariantBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : cyclicGaloisH2 K L ≃+ ZMod n) : ZMod n →+ BrauerGroup K :=
  (cyclicGaloisH2BrauerAddHom K L).comp e.symm.toAddMonoidHom

/-- Finite continuous cyclic `H² → Br(K)` is additive. -/
noncomputable def finiteGaloisContinuousCyclicH2BrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    continuousGaloisUnitCohomology 2 K L →+ BrauerGroup K :=
  (cyclicGaloisH2BrauerAddHom K L).comp
    (finiteGaloisContinuousH2ToOrdinaryH2AddEquiv K L).toAddMonoidHom

/-- A finite continuous cyclic invariant `ZMod n` induces an additive Brauer map. -/
noncomputable def finiteGaloisContinuousCyclicH2InvariantBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ZMod n) :
    ZMod n →+ BrauerGroup K :=
  (finiteGaloisContinuousCyclicH2BrauerAddHom K L).comp e.symm.toAddMonoidHom

/-- A finite `ℚ/ℤ[n]` local-invariant coordinate induces an additive Brauer map. -/
noncomputable def finiteGaloisContinuousCyclicH2TorsionInvariantBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ratModIntNTorsion n) :
    ratModIntNTorsion n →+ BrauerGroup K :=
  (finiteGaloisContinuousCyclicH2BrauerAddHom K L).comp e.symm.toAddMonoidHom

/-- Finite continuous cyclic `H²` with codomain restricted to defining relative kernel. -/
noncomputable def finiteGaloisContinuousCyclicH2RelativeBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (m : ℕ) (hdeg : Module.finrank K L = m + 1) :
    continuousGaloisUnitCohomology 2 K L →+ scalarExtensionBrauerKernel K L :=
  (finiteGaloisContinuousCyclicH2BrauerAddHom K L).codRestrict
    (scalarExtensionBrauerKernel K L)
    (finiteGaloisContinuousCyclicH2BrauerMap_mem_scalarExtensionBrauerKernel
      K L m hdeg)

/-- A finite `ℚ/ℤ[n]` coordinate maps additively into defining relative Brauer kernel. -/
noncomputable def finiteGaloisContinuousCyclicH2TorsionInvariantRelativeBrauerAddHom
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ratModIntNTorsion n)
    (m : ℕ) (hdeg : Module.finrank K L = m + 1) :
    ratModIntNTorsion n →+ scalarExtensionBrauerKernel K L :=
  (finiteGaloisContinuousCyclicH2TorsionInvariantBrauerAddHom K L n e).codRestrict
    (scalarExtensionBrauerKernel K L)
    (finiteGaloisContinuousCyclicH2TorsionInvariantBrauerMap_mem_scalarExtensionBrauerKernel
      K L n e m hdeg)

@[simp]
theorem finiteGaloisContinuousCyclicH2TorsionInvariantBrauerAddHom_apply
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ratModIntNTorsion n)
    (z : ratModIntNTorsion n) :
    finiteGaloisContinuousCyclicH2TorsionInvariantBrauerAddHom K L n e z =
      finiteGaloisContinuousCyclicH2TorsionInvariantBrauerMap K L n e z := rfl

end GaloisForLFunctions.HTGeometry.ABHN
