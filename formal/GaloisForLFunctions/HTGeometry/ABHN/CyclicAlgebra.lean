import Mathlib.Algebra.Ring.Action.End
import Mathlib.Algebra.SkewPolynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Twisted cyclic-algebra carrier

For a ring automorphism `sigma`, the ordinary finite skew group algebra cannot represent the
cyclic-algebra relation `X^n = a`: its finite group generator already satisfies `X^n = 1`.
This file instead starts with the skew polynomial ring for the nonnegative powers of `sigma` and
quotients by the two-sided closure of `X^n - a`.

The result is the raw twisted cyclic-algebra carrier.  It has the two defining relations proved
below, but this file does not assert centrality, finite dimensionality, simplicity, or a Brauer
class.  Those require the additional finite cyclic Galois hypotheses and the normal-form theorem
that reduces powers of `X` modulo `n`.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

open Multiplicative

/-- The nonnegative powers of a ring automorphism, as a monoid action. -/
noncomputable def cyclicPowerRingAut {L : Type*} [CommRing L]
    (sigma : L ≃+* L) : Multiplicative ℕ →* RingAut L where
  toFun n := sigma ^ (toAdd n)
  map_one' := by
    simp
  map_mul' m n := by
    change sigma ^ (toAdd (m * n)) = sigma ^ (toAdd m) * sigma ^ (toAdd n)
    simpa using (pow_add sigma (toAdd m) (toAdd n))

/-- The semiring action used to form the skew polynomial ring for `sigma`. -/
noncomputable abbrev cyclicSkewAction {L : Type*} [CommRing L]
    (sigma : L ≃+* L) : MulSemiringAction (Multiplicative ℕ) L :=
  MulSemiringAction.compHom L (cyclicPowerRingAut sigma)

/-- The skew polynomial carrier whose formal variable acts as `sigma` on coefficients. -/
abbrev CyclicSkewPolynomial (L : Type*) [CommRing L] (_sigma : L ≃+* L) :=
  SkewMonoidAlgebra L (Multiplicative ℕ)

noncomputable instance {L : Type*} [CommRing L] (sigma : L ≃+* L) :
    Ring (CyclicSkewPolynomial L sigma) := by
  dsimp [CyclicSkewPolynomial]
  letI : MulSemiringAction (Multiplicative ℕ) L := cyclicSkewAction sigma
  infer_instance

/-- The formal skew variable. -/
noncomputable def cyclicSkewX {L : Type*} [CommRing L] (sigma : L ≃+* L) :
    CyclicSkewPolynomial L sigma :=
  SkewMonoidAlgebra.single (ofAdd 1) 1

/-- A constant coefficient in the skew polynomial carrier. -/
noncomputable def cyclicSkewC {L : Type*} [CommRing L] (sigma : L ≃+* L) (a : L) :
    CyclicSkewPolynomial L sigma :=
  SkewMonoidAlgebra.single 1 a

/-- A power of the skew variable is the corresponding single-term skew polynomial. -/
theorem cyclicSkewX_pow_eq_single {L : Type*} [CommRing L] (sigma : L ≃+* L) (m : ℕ) :
    cyclicSkewX sigma ^ m = SkewMonoidAlgebra.single (ofAdd m) 1 := by
  induction m with
  | zero =>
    rfl
  | succ m ih =>
    rw [pow_succ, ih]
    letI : MulSemiringAction (Multiplicative ℕ) L := cyclicSkewAction sigma
    unfold cyclicSkewX
    have h :
        (SkewMonoidAlgebra.single (ofAdd m) (1 : L) *
          SkewMonoidAlgebra.single (ofAdd 1) 1 :
          SkewMonoidAlgebra L (Multiplicative ℕ)) =
        SkewMonoidAlgebra.single (ofAdd (m + 1)) 1 := by
      rw [SkewMonoidAlgebra.single_mul_single]
      congr 1
      simp
    exact h

/-- A skew monomial is its coefficient followed by the corresponding variable power. -/
theorem cyclicSkewMonomial_eq {L : Type*} [CommRing L] (sigma : L ≃+* L) (m : ℕ) (b : L) :
    SkewPolynomial.monomial m b = cyclicSkewC sigma b * cyclicSkewX sigma ^ m := by
  rw [cyclicSkewX_pow_eq_single]
  letI : MulSemiringAction (Multiplicative ℕ) L := cyclicSkewAction sigma
  unfold cyclicSkewC
  have h :
      (SkewMonoidAlgebra.single 1 b * SkewMonoidAlgebra.single (ofAdd m) 1 :
        SkewMonoidAlgebra L (Multiplicative ℕ)) =
      SkewPolynomial.monomial m b := by
    rw [SkewMonoidAlgebra.single_mul_single]
    congr 1
    · simp
    · simp
  exact h.symm

/-- The relation imposed by a cyclic-algebra parameter. -/
noncomputable def cyclicRelation {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : CyclicSkewPolynomial L sigma :=
  cyclicSkewX sigma ^ n - cyclicSkewC sigma a

/-- The two-sided ideal generated by the cyclic relation. -/
noncomputable def cyclicRelationIdeal {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : Ideal (CyclicSkewPolynomial L sigma) :=
  (TwoSidedIdeal.span ({cyclicRelation sigma n a} : Set _)).asIdeal

noncomputable instance {L : Type*} [CommRing L] (sigma : L ≃+* L) (n : ℕ) (a : L) :
    (cyclicRelationIdeal sigma n a).IsTwoSided := by
  dsimp [cyclicRelationIdeal]
  infer_instance

/-- The raw quotient carrier for the cyclic algebra with relation `X^n = a`. -/
abbrev CyclicAlgebra {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) :=
  CyclicSkewPolynomial L sigma ⧸ cyclicRelationIdeal sigma n a

/-- The image of the skew variable in the cyclic-algebra quotient. -/
noncomputable def cyclicAlgebraX {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : CyclicAlgebra sigma n a :=
  Ideal.Quotient.mk _ (cyclicSkewX sigma)

/-- The image of a coefficient in the cyclic-algebra quotient. -/
noncomputable def cyclicAlgebraC {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b : L) : CyclicAlgebra sigma n a :=
  Ideal.Quotient.mk _ (cyclicSkewC sigma b)

/-- The quotient image of a skew monomial is its coefficient times a variable power. -/
theorem cyclicAlgebraMonomial_eq {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b : L) (m : ℕ) :
    (Ideal.Quotient.mk (cyclicRelationIdeal sigma n a) (SkewPolynomial.monomial m b) :
      CyclicAlgebra sigma n a) =
      cyclicAlgebraC sigma n a b * cyclicAlgebraX sigma n a ^ m := by
  rw [cyclicSkewMonomial_eq]
  rw [map_mul, map_pow]
  rfl

/-- Constants multiply as their coefficients do in the skew polynomial carrier. -/
theorem cyclicSkewC_mul (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (b c : L) : cyclicSkewC sigma b * cyclicSkewC sigma c = cyclicSkewC sigma (b * c) := by
  letI : MulSemiringAction (Multiplicative ℕ) L := cyclicSkewAction sigma
  unfold cyclicSkewC
  have h :
      (SkewMonoidAlgebra.single 1 b * SkewMonoidAlgebra.single 1 c :
        SkewMonoidAlgebra L (Multiplicative ℕ)) = SkewMonoidAlgebra.single 1 (b * c) := by
    rw [SkewMonoidAlgebra.single_mul_single]
    simp
  exact h

/-- Coefficients multiply in the cyclic-algebra quotient. -/
theorem cyclicAlgebraC_mul (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b c : L) :
    cyclicAlgebraC sigma n a b * cyclicAlgebraC sigma n a c =
      cyclicAlgebraC sigma n a (b * c) := by
  change Ideal.Quotient.mk _ (cyclicSkewC sigma b) * Ideal.Quotient.mk _ (cyclicSkewC sigma c) =
    Ideal.Quotient.mk _ (cyclicSkewC sigma (b * c))
  rw [← map_mul]
  exact congrArg (Ideal.Quotient.mk _) (cyclicSkewC_mul L sigma b c)

/-- Coefficients commute in the cyclic-algebra quotient. -/
theorem cyclicAlgebraC_comm (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b c : L) :
    cyclicAlgebraC sigma n a b * cyclicAlgebraC sigma n a c =
      cyclicAlgebraC sigma n a c * cyclicAlgebraC sigma n a b := by
  rw [cyclicAlgebraC_mul, cyclicAlgebraC_mul, mul_comm]

/-- The coefficient one is the quotient-ring unit. -/
theorem cyclicAlgebraC_one (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : cyclicAlgebraC sigma n a 1 = 1 := by
  rfl

/-- The coefficient inclusion into the skew polynomial carrier, as a ring homomorphism. -/
noncomputable def cyclicSkewCRingHom (L : Type*) [CommRing L] (sigma : L ≃+* L) :
    L →+* CyclicSkewPolynomial L sigma where
  toFun := cyclicSkewC sigma
  map_one' := rfl
  map_mul' := fun b c => (cyclicSkewC_mul L sigma b c).symm
  map_zero' := by
    unfold cyclicSkewC
    exact SkewMonoidAlgebra.single_zero _
  map_add' := by
    intro b c
    exact SkewMonoidAlgebra.single_add 1 b c

/-- The coefficient inclusion into the cyclic-algebra quotient, as a ring homomorphism. -/
noncomputable def cyclicAlgebraCRingHom (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : L →+* CyclicAlgebra sigma n a :=
  (Ideal.Quotient.mk _).comp (cyclicSkewCRingHom L sigma)

/-- Evaluation of the coefficient ring homomorphism is the named quotient coefficient. -/
theorem cyclicAlgebraCRingHom_apply (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b : L) : cyclicAlgebraCRingHom L sigma n a b =
      cyclicAlgebraC sigma n a b := rfl

/-- The imposed cyclic relation holds in the quotient. -/
theorem cyclicAlgebraX_pow (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a : L) : cyclicAlgebraX sigma n a ^ n = cyclicAlgebraC sigma n a a := by
  change Ideal.Quotient.mk _ (cyclicSkewX sigma) ^ n =
    Ideal.Quotient.mk _ (cyclicSkewC sigma a)
  rw [← map_pow]
  apply sub_eq_zero.mp
  rw [← map_sub]
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact TwoSidedIdeal.subset_span (by simp [cyclicRelation])

/-- If the parameter is a unit and the cyclic degree is nonzero, then the cyclic variable is a
unit.  This is the first structural distinction between the nonzero cyclic algebras used for
Brauer classes and the degenerate parameter-zero quotient. -/
theorem cyclicAlgebraX_isUnit {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (hn : n ≠ 0) (a : L) (ha : IsUnit a) :
    IsUnit (cyclicAlgebraX sigma n a) := by
  apply (isUnit_pow_iff hn).mp
  rw [cyclicAlgebraX_pow]
  rw [← cyclicAlgebraCRingHom_apply]
  exact IsUnit.map _ ha

/-- The distinguished unit represented by the cyclic variable at a unit parameter. -/
noncomputable def cyclicAlgebraXUnit {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (hn : n ≠ 0) (a : L) (ha : IsUnit a) : (CyclicAlgebra sigma n a)ˣ :=
  (cyclicAlgebraX_isUnit sigma n hn a ha).unit

/-- The distinguished cyclic unit has underlying quotient element `X`. -/
theorem cyclicAlgebraXUnit_coe {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (hn : n ≠ 0) (a : L) (ha : IsUnit a) :
    (cyclicAlgebraXUnit sigma n hn a ha : CyclicAlgebra sigma n a) =
      cyclicAlgebraX sigma n a :=
  IsUnit.unit_spec _

/-- The skew variable commutes with coefficients by the automorphism `sigma`. -/
theorem cyclicSkewX_mul_cyclicSkewC (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (b : L) : cyclicSkewX sigma * cyclicSkewC sigma b =
      cyclicSkewC sigma (sigma b) * cyclicSkewX sigma := by
  letI : MulSemiringAction (Multiplicative ℕ) L := cyclicSkewAction sigma
  unfold cyclicSkewX cyclicSkewC
  have h :
      (SkewMonoidAlgebra.single (ofAdd 1) (1 : L) * SkewMonoidAlgebra.single 1 b :
        SkewMonoidAlgebra L (Multiplicative ℕ)) =
      SkewMonoidAlgebra.single 1 (sigma b) * SkewMonoidAlgebra.single (ofAdd 1) 1 := by
    rw [SkewMonoidAlgebra.single_mul_single, SkewMonoidAlgebra.single_mul_single]
    congr 1
    simp only [one_mul, smul_one, mul_one]
    change (sigma ^ 1) b = sigma b
    simp
  exact h

/-- The twisted coefficient relation descends to the cyclic-algebra quotient. -/
theorem cyclicAlgebraX_mul_cyclicAlgebraC (L : Type*) [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (a b : L) : cyclicAlgebraX sigma n a * cyclicAlgebraC sigma n a b =
      cyclicAlgebraC sigma n a (sigma b) * cyclicAlgebraX sigma n a := by
  change Ideal.Quotient.mk _ (cyclicSkewX sigma) * Ideal.Quotient.mk _ (cyclicSkewC sigma b) =
    Ideal.Quotient.mk _ (cyclicSkewC sigma (sigma b)) * Ideal.Quotient.mk _ (cyclicSkewX sigma)
  rw [← map_mul, ← map_mul]
  exact congrArg (Ideal.Quotient.mk _) (cyclicSkewX_mul_cyclicSkewC L sigma b)

/-- Conjugation by the cyclic unit acts on coefficients by the twisting automorphism.  This is the
crossed-product relation needed to turn a nonzero cyclic algebra into a Brauer representative. -/
theorem cyclicAlgebraXUnit_conj_C {L : Type*} [CommRing L] (sigma : L ≃+* L)
    (n : ℕ) (hn : n ≠ 0) (a b : L) (ha : IsUnit a) :
    (cyclicAlgebraXUnit sigma n hn a ha : CyclicAlgebra sigma n a) *
        cyclicAlgebraC sigma n a b *
        (↑((cyclicAlgebraXUnit sigma n hn a ha)⁻¹) : CyclicAlgebra sigma n a) =
      cyclicAlgebraC sigma n a (sigma b) := by
  rw [cyclicAlgebraXUnit_coe]
  rw [cyclicAlgebraX_mul_cyclicAlgebraC]
  rw [mul_assoc]
  rw [← cyclicAlgebraXUnit_coe sigma n hn a ha]
  simp

/-- The relation `X^n = a` reduces every monomial power of `X` to exponent less than `n`.
This is the monomial normal-form step; spanning and linear independence of these normal forms are
separate finite-dimensionality tasks. -/
theorem cyclicAlgebraX_pow_mul_normalForm (L : Type*) [CommRing L]
    (sigma : L ≃+* L) (n q r : ℕ) (a : L) :
    cyclicAlgebraX sigma n a ^ (n * q + r) =
      cyclicAlgebraC sigma n a (a ^ q) * cyclicAlgebraX sigma n a ^ r := by
  induction q with
  | zero =>
    simp only [Nat.mul_zero, zero_add, pow_zero]
    rw [cyclicAlgebraC_one, one_mul]
  | succ q ih =>
    rw [Nat.mul_succ, Nat.add_comm (n * q) n, Nat.add_assoc, pow_add, cyclicAlgebraX_pow]
    rw [ih, ← mul_assoc, cyclicAlgebraC_mul]
    rw [pow_succ]
    rw [mul_comm a (a ^ q)]

/-- A quotient monomial has a representative with variable exponent reduced modulo `n`. -/
theorem cyclicAlgebraMonomial_normalForm {L : Type*} [CommRing L]
    (sigma : L ≃+* L) (n q r : ℕ) (a b : L) :
    (Ideal.Quotient.mk (cyclicRelationIdeal sigma n a)
      (SkewPolynomial.monomial (n * q + r) b) : CyclicAlgebra sigma n a) =
      cyclicAlgebraC sigma n a (b * a ^ q) * cyclicAlgebraX sigma n a ^ r := by
  rw [cyclicAlgebraMonomial_eq]
  rw [cyclicAlgebraX_pow_mul_normalForm, ← mul_assoc, cyclicAlgebraC_mul]

/-- Every quotient monomial has a representative whose variable exponent is `m % n`. -/
theorem cyclicAlgebraMonomial_mod_normalForm {L : Type*} [CommRing L]
    (sigma : L ≃+* L) (n : ℕ) (a b : L) (m : ℕ) :
    (Ideal.Quotient.mk (cyclicRelationIdeal sigma n a) (SkewPolynomial.monomial m b) :
      CyclicAlgebra sigma n a) =
      cyclicAlgebraC sigma n a (b * a ^ (m / n)) * cyclicAlgebraX sigma n a ^ (m % n) := by
  conv_lhs => rw [← Nat.div_add_mod m n]
  exact cyclicAlgebraMonomial_normalForm sigma n (m / n) (m % n) a b

end GaloisForLFunctions.HTGeometry.ABHN
