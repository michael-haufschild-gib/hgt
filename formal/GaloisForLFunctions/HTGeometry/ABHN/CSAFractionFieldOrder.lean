/-!
# Finite multiplication-closed lattices in fraction-field algebras

Given a finite basis of a `K`-algebra, a common denominator for its multiplication
constants produces a finite `R`-subalgebra generated by the scaled basis. This is
the algebraic first step in constructing orders of central simple algebras.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

open nonZeroDivisors

open scoped BigOperators TensorProduct

universe u v w z

/-- Scalar multiplication on a vector space over a fraction field has no torsion from the base
domain. -/
theorem fractionField_noZeroSMulDivisors
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [AddCommGroup A] [Module R A] [Module K A] [IsScalarTower R K A] :
    NoZeroSMulDivisors R A := by
  constructor
  intro r x h
  by_cases hr : r = 0
  · exact Or.inl hr
  right
  have hmap : algebraMap R K r ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_iff_ne_zero.mpr hr)
  apply (smul_eq_zero.mp ?_).resolve_left hmap
  rw [IsScalarTower.algebraMap_smul K r x]
  exact h

/-- The `R`-lattice generated by `1` and a basis of `A` scaled by `d`. -/
noncomputable def scaledBasisLattice
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) : Submodule R A :=
  Submodule.span R ({1} ∪ Set.range fun i => (algebraMap R K d) • b i)

theorem scaledBasisLattice_one_mem
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) :
    (1 : A) ∈ scaledBasisLattice R K A ι b d := by
  apply Submodule.subset_span
  exact Or.inl rfl

theorem scaledBasisLattice_scaledBasis_mem
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) (i : ι) :
    (algebraMap R K d) • b i ∈ scaledBasisLattice R K A ι b d := by
  apply Submodule.subset_span
  exact Or.inr ⟨i, rfl⟩

theorem scaledBasisLattice_moduleFinite
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) :
    Module.Finite R (scaledBasisLattice R K A ι b d) := by
  apply Module.Finite.span_of_finite R
  exact (Set.finite_singleton (1 : A)).union (Set.finite_range _)

theorem scaledBasisLattice_mul_mem
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    ∀ x y : A, x ∈ scaledBasisLattice R K A ι b d →
      y ∈ scaledBasisLattice R K A ι b d → x * y ∈ scaledBasisLattice R K A ι b d := by
  classical
  choose r hr using hcoeff
  let g : ι → A := fun i => (algebraMap R K d) • b i
  let S : Set A := {1} ∪ Set.range g
  let M : Submodule R A := Submodule.span R S
  have hM : M = scaledBasisLattice R K A ι b d := by
    simp only [M, S, g, scaledBasisLattice]
  have hg_mem (i : ι) : g i ∈ M := by
    apply Submodule.subset_span
    exact Or.inr ⟨i, rfl⟩
  have hgen_mul : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ M := by
    intro x hx y hy
    rcases hx with rfl | ⟨i, rfl⟩
    · rcases hy with rfl | ⟨j, rfl⟩
      · have h_one : (1 : A) ∈ M := by
          apply Submodule.subset_span
          exact Or.inl rfl
        simpa using h_one
      · simpa [M, S, g] using hg_mem j
    · rcases hy with rfl | ⟨j, rfl⟩
      · simpa [M, S, g] using hg_mem i
      · have hsum : g i * g j = ∑ k, (r i j k) • g k := by
          dsimp [g]
          calc
            (algebraMap R K d) • b i * ((algebraMap R K d) • b j) =
                (algebraMap R K d) • ((algebraMap R K d) • (b i * b j)) := by
                  rw [smul_mul_assoc, mul_smul_comm]
            _ = (algebraMap R K d) • ((algebraMap R K d) •
                ∑ k, b.repr (b i * b j) k • b k) := by rw [b.sum_repr]
            _ = ∑ k, (r i j k) • ((algebraMap R K d) • b k) := by
              rw [Finset.smul_sum, Finset.smul_sum]
              apply Finset.sum_congr rfl
              intro k hk
              rw [smul_smul, smul_smul, ← IsScalarTower.smul_assoc,
                Algebra.smul_def, Algebra.smul_def]
              congr 1
              have hscalar : (algebraMap R K d * algebraMap R K d) *
                  b.repr (b i * b j) k = r i j k • algebraMap R K d := by
                rw [Algebra.smul_def]
                rw [mul_assoc, hr, mul_comm]
              exact congrArg (algebraMap K A) hscalar
        rw [hsum]
        apply M.sum_mem
        intro k hk
        exact M.smul_mem _ (hg_mem k)
  intro x y hx hy
  rw [← hM] at hx hy ⊢
  refine Submodule.span_induction (p := fun x _ => ∀ y, y ∈ M → x * y ∈ M) ?_ ?_ ?_ ?_ hx y hy
  · intro x hx y hy
    refine Submodule.span_induction (p := fun y _ => x * y ∈ M) ?_ ?_ ?_ ?_ hy
    · exact fun y hy => hgen_mul x hx y hy
    · simp
    · intro y z hy hz hyM hzM
      simpa [mul_add] using M.add_mem hyM hzM
    · intro a y hy hyM
      simpa only [mul_smul_comm] using M.smul_mem a hyM
  · intro y hy
    simp
  · intro x z hx hz hxM hzM y hy
    simpa [add_mul] using M.add_mem (hxM y hy) (hzM y hy)
  · intro a x hx hxM y hy
    simpa only [smul_mul_assoc] using M.smul_mem a (hxM y hy)

/-- The finite subalgebra generated by a scaled basis with integral multiplication constants. -/
noncomputable def scaledBasisOrder
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) : Subalgebra R A :=
  (scaledBasisLattice R K A ι b d).toSubalgebra
    (scaledBasisLattice_one_mem R K A ι b d)
    (scaledBasisLattice_mul_mem R K A ι b d hcoeff)

theorem scaledBasisOrder_moduleFinite
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    Module.Finite R (scaledBasisOrder R K A ι b d hcoeff) := by
  let L := scaledBasisLattice R K A ι b d
  let O := scaledBasisOrder R K A ι b d hcoeff
  have hsub : O.toSubmodule = L := by
    change Subalgebra.toSubmodule (L.toSubalgebra _ _) = L
    exact Submodule.toSubalgebra_toSubmodule L _ _
  letI : Module.Finite R L := scaledBasisLattice_moduleFinite R K A ι b d
  letI : Module.Finite R O.toSubmodule :=
    Module.Finite.equiv (LinearEquiv.ofEq L O.toSubmodule hsub.symm)
  exact Module.Finite.equiv (Subalgebra.toSubmoduleEquiv O)

theorem scaledBasisOrder_scaledBasis_mem
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) (i : ι) :
    (algebraMap R K d) • b i ∈ scaledBasisOrder R K A ι b d hcoeff := by
  exact scaledBasisLattice_scaledBasis_mem R K A ι b d i

/-- A nonzero scaled basis still spans the ambient `K`-algebra. -/
theorem scaledBasisLattice_span_eq_top
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) (hd : d ≠ 0) :
    Submodule.span K (scaledBasisLattice R K A ι b d : Set A) = ⊤ := by
  rw [eq_top_iff, ← b.span_eq]
  apply Submodule.span_le.2
  rintro x ⟨i, rfl⟩
  have hscaled : (algebraMap R K d) • b i ∈ scaledBasisLattice R K A ι b d :=
    scaledBasisLattice_scaledBasis_mem R K A ι b d i
  have hspan : (algebraMap R K d) • b i ∈
      Submodule.span K (scaledBasisLattice R K A ι b d : Set A) :=
    Submodule.subset_span hscaled
  have hmap : algebraMap R K d ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_iff_ne_zero.mpr hd)
  rw [← inv_smul_smul₀ hmap (b i)]
  exact (Submodule.span K (scaledBasisLattice R K A ι b d : Set A)).smul_mem _ hspan

/-- The finite subalgebra generated by a nonzero scaled basis has full generic span. -/
theorem scaledBasisOrder_span_eq_top
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) (hd : d ≠ 0)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    Submodule.span K (scaledBasisOrder R K A ι b d hcoeff : Set A) = ⊤ := by
  change Submodule.span K ((scaledBasisOrder R K A ι b d hcoeff).toSubmodule : Set A) = ⊤
  rw [scaledBasisOrder, Submodule.toSubalgebra_toSubmodule]
  exact scaledBasisLattice_span_eq_top R K A ι b d hd

/-- The finite scaled-basis order is torsion-free over its base domain. -/
theorem scaledBasisOrder_noZeroSMulDivisors
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    NoZeroSMulDivisors R (scaledBasisOrder R K A ι b d hcoeff) := by
  constructor
  rintro r ⟨x, hx⟩ h
  have hval : r • x = 0 := by
    exact congrArg Subtype.val h
  letI : NoZeroSMulDivisors R A := fractionField_noZeroSMulDivisors R K A
  rcases NoZeroSMulDivisors.eq_zero_or_eq_zero_of_smul_eq_zero hval with hr | hxzero
  · exact Or.inl hr
  · right
    exact Subtype.ext hxzero

/-- The canonical `K`-algebra map from a scalar extension of an `R`-subalgebra into the
ambient `K`-algebra. -/
noncomputable def subalgebraScalarExtensionMap
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) : K ⊗[R] O →ₐ[K] A :=
  O.val.liftEquiv R K O A

@[simp]
theorem subalgebraScalarExtensionMap_tmul
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) (s : K) (o : O) :
    subalgebraScalarExtensionMap R K A O (s ⊗ₜ[R] o) = s • (o : A) :=
  rfl

/-- If an `R`-subalgebra spans the ambient algebra over `K`, its scalar-extension map is
surjective. -/
theorem subalgebraScalarExtensionMap_surjective
    (R : Type u) [CommRing R] (K : Type v) [Field K] [Algebra R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) (hspan : Submodule.span K (O : Set A) = ⊤) :
    Function.Surjective (subalgebraScalarExtensionMap R K A O) := by
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← hspan]
  apply Submodule.span_le.2
  intro x hx
  exact ⟨1 ⊗ₜ[R] ⟨x, hx⟩, by simp⟩

/-- For a fraction field, scalar extension of a subalgebra embeds into the ambient algebra. -/
theorem subalgebraScalarExtensionMap_injective
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) :
    Function.Injective (subalgebraScalarExtensionMap R K A O) := by
  letI : Module.Flat R K := IsLocalization.flat K (nonZeroDivisors R)
  have hl : Function.Injective (LinearMap.lTensor K O.val.toLinearMap) :=
    Module.Flat.lTensor_preserves_injective_linearMap _ Subtype.val_injective
  have hcomm (z : K ⊗[R] O) :
      IsLocalization.algebraLid (nonZeroDivisors R) K A
        ((LinearMap.lTensor K O.val.toLinearMap) z) =
        subalgebraScalarExtensionMap R K A O z := by
    induction z using TensorProduct.induction_on with
    | zero => simp [subalgebraScalarExtensionMap]
    | add x y hx hy => simp [hx, hy]
    | tmul s o =>
      simp only [LinearMap.lTensor_tmul, IsLocalization.algebraLid,
        Algebra.TensorProduct.lidOfCompatibleSMul_tmul]
      rfl
  intro x y hxy
  apply hl
  apply (IsLocalization.algebraLid (nonZeroDivisors R) K A).injective
  rw [hcomm, hcomm, hxy]

/-- A finite subalgebra with full fraction-field span recovers the ambient algebra after scalar
extension. -/
noncomputable def subalgebraScalarExtensionEquiv
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) (hspan : Submodule.span K (O : Set A) = ⊤) :
    K ⊗[R] O ≃ₐ[K] A :=
  AlgEquiv.ofBijective (subalgebraScalarExtensionMap R K A O)
    ⟨subalgebraScalarExtensionMap_injective R K A O,
      subalgebraScalarExtensionMap_surjective R K A O hspan⟩

@[simp]
theorem subalgebraScalarExtensionEquiv_apply
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (O : Subalgebra R A) (hspan : Submodule.span K (O : Set A) = ⊤) (x : K ⊗[R] O) :
    subalgebraScalarExtensionEquiv R K A O hspan x =
      subalgebraScalarExtensionMap R K A O x :=
  rfl

/-- The fraction-field scalar extension of the scaled-basis order surjects onto the ambient
algebra. -/
theorem scaledBasisOrder_scalarExtensionMap_surjective
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) (hd : d ≠ 0)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    Function.Surjective
      (subalgebraScalarExtensionMap R K A (scaledBasisOrder R K A ι b d hcoeff)) :=
  subalgebraScalarExtensionMap_surjective R K A _
    (scaledBasisOrder_span_eq_top R K A ι b d hd hcoeff)

/-- The scaled-basis order recovers the original algebra after fraction-field scalar extension. -/
noncomputable def scaledBasisOrderScalarExtensionEquiv
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) (d : R) (hd : d ≠ 0)
    (hcoeff : ∀ i j k : ι, ∃ r : R,
      algebraMap R K d * b.repr (b i * b j) k = algebraMap R K r) :
    K ⊗[R] (scaledBasisOrder R K A ι b d hcoeff) ≃ₐ[K] A :=
  subalgebraScalarExtensionEquiv R K A (scaledBasisOrder R K A ι b d hcoeff)
    (scaledBasisOrder_span_eq_top R K A ι b d hd hcoeff)

theorem exists_finite_scaledBasisOrder_of_isFractionRing
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) :
    ∃ (d : R) (O : Subalgebra R A), d ≠ 0 ∧ Module.Finite R O ∧
      ∀ i : ι, (algebraMap R K d) • b i ∈ O := by
  obtain ⟨d, hd, hcoeff⟩ := basis_mul_structureConstants_exists_commonDenominator R K A ι b
  refine ⟨d, scaledBasisOrder R K A ι b d hcoeff, hd,
    scaledBasisOrder_moduleFinite R K A ι b d hcoeff, ?_⟩
  exact scaledBasisOrder_scaledBasis_mem R K A ι b d hcoeff

/-- Every finite-dimensional fraction-field algebra has a finite multiplication-closed
subalgebra whose `K`-linear span is the full ambient algebra. -/
theorem exists_finite_spanning_scaledBasisOrder_of_isFractionRing
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : Type w) [Ring A] [Algebra R A] [Algebra K A] [IsScalarTower R K A]
    (ι : Type z) [Fintype ι] (b : Module.Basis ι K A) :
    ∃ (d : R) (O : Subalgebra R A), d ≠ 0 ∧ Module.Finite R O ∧
      Submodule.span K (O : Set A) = ⊤ := by
  obtain ⟨d, hd, hcoeff⟩ := basis_mul_structureConstants_exists_commonDenominator R K A ι b
  refine ⟨d, scaledBasisOrder R K A ι b d hcoeff, hd,
    scaledBasisOrder_moduleFinite R K A ι b d hcoeff,
    scaledBasisOrder_span_eq_top R K A ι b d hd hcoeff⟩

/-- Every finite-dimensional central simple algebra has a finite multiplication-closed
subalgebra whose scalar extension to the fraction field is the original algebra. -/
theorem exists_fractionFieldOrder_of_csa
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K] [Algebra R K]
    [IsFractionRing R K]
    (A : CSA.{v, w} K) [Algebra R A.carrier] [IsScalarTower R K A.carrier] :
    ∃ (O : Subalgebra R A.carrier) (_ : K ⊗[R] O ≃ₐ[K] A.carrier), Module.Finite R O := by
  let b := Module.finBasis K A.carrier
  obtain ⟨d, O, hd, hfinite, hspan⟩ :=
    exists_finite_spanning_scaledBasisOrder_of_isFractionRing R K A.carrier
      (Fin (Module.finrank K A.carrier)) b
  exact ⟨O, subalgebraScalarExtensionEquiv R K A.carrier O hspan, hfinite⟩

/-- Over a Noetherian domain, every finite-dimensional central simple fraction-field algebra has
a finite order which is free after inverting one nonzero element. -/
theorem exists_fractionFieldOrder_free_away_of_csa
    (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K]
    (A : CSA.{v, w} K) [Algebra R A.carrier] [IsScalarTower R K A.carrier] :
    ∃ (O : Subalgebra R A.carrier) (_ : K ⊗[R] O ≃ₐ[K] A.carrier) (r : R), r ≠ 0 ∧
      Module.Free (Localization (Submonoid.powers r)) (LocalizedModule.Away r O) := by
  obtain ⟨O, e, hfinite⟩ := exists_fractionFieldOrder_of_csa R K A
  letI : Module.Finite R O := hfinite
  letI : Module.FinitePresentation R O := Module.finitePresentation_of_finite R O
  obtain ⟨r, hr, hfree⟩ := exists_nonzero_away_free_of_fractionField_baseChange R K O
  exact ⟨O, e, r, hr, hfree⟩

end GaloisForLFunctions.HTGeometry.ABHN
