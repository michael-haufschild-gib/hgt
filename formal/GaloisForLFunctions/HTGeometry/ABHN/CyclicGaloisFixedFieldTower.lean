import GaloisForLFunctions.HTGeometry.FixedFieldDichotomy
import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisH2CarryInflation
import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisNormQuotientTowerDescent

/-!
# Compatible fixed-field layers in a finite cyclic Galois extension

Powers of one chosen cyclic generator define a divisor-indexed chain of fixed fields.  The layer
indexed by `m` has degree `m`, divisibility gives literal field inclusion, and relative degrees are
the expected quotients.  A single invariant top-field valuation and top norm-surjectivity classify
every divisor layer as `ZMod m` in genuine cyclic `H²`.

Most importantly, actual group-cohomological inflation between nested layers is injective.  Thus
these fields provide a genuine compatible finite local `H²` tower rather than a family of
unrelated degree-by-degree models.
-/

namespace GaloisForLFunctions.HTGeometry

/-- The subgroup generated by the `m`th power of a generator has index `m`, provided `m` divides
the finite cyclic group order. -/
theorem zpowers_pow_index_eq_of_generator
    {G : Type*} [Group G] [Fintype G]
    (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    {m : ℕ} (hm0 : m ≠ 0) (hm : m ∣ Fintype.card G) :
    (Subgroup.zpowers (g ^ m)).index = m := by
  classical
  let H : Subgroup G := Subgroup.zpowers (g ^ m)
  have horder : orderOf g = Fintype.card G := by
    simpa [Nat.card_eq_fintype_card] using
      orderOf_eq_card_of_forall_mem_zpowers hg
  have hmorder : m ∣ orderOf g := by
    rw [horder]
    exact hm
  have hcardH : Nat.card H = Fintype.card G / m := by
    change Nat.card (Subgroup.zpowers (g ^ m)) = _
    rw [Nat.card_zpowers, orderOf_pow_of_dvd hm0 hmorder, horder]
  have hmul : Nat.card H * H.index = Nat.card G := Subgroup.card_mul_index H
  rw [hcardH, Nat.card_eq_fintype_card] at hmul
  have hpos : 0 < Fintype.card G / m := by
    rw [← hcardH]
    exact Nat.card_pos
  refine Nat.eq_of_mul_eq_mul_left hpos ?_
  exact hmul.trans (Nat.div_mul_cancel hm).symm

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry.ABHN

noncomputable section

attribute [local instance] IsCyclic.commGroup

variable (K M : Type) [Field K] [Field M] [Algebra K M]
  [FiniteDimensional K M] [IsGalois K M] [IsCyclic Gal(M/K)]

/-- Fixed-field layer of degree `m` inside a finite cyclic Galois extension. -/
noncomputable def cyclicGaloisFixedFieldLayer (m : ℕ) : IntermediateField K M :=
  IntermediateField.fixedField
    (Subgroup.zpowers (cyclicGaloisGenerator K M ^ m))

theorem cyclicGaloisFixedFieldLayer_finrank
    {m : ℕ} (hm0 : m ≠ 0) (hm : m ∣ Module.finrank K M) :
    Module.finrank K (cyclicGaloisFixedFieldLayer K M m) = m := by
  rw [cyclicGaloisFixedFieldLayer,
    GaloisForLFunctions.HTGeometry.finrank_fixedField_eq_index]
  apply GaloisForLFunctions.HTGeometry.zpowers_pow_index_eq_of_generator
  · exact cyclicGaloisGenerator_spec K M
  · exact hm0
  · rwa [← Nat.card_eq_fintype_card,
      IsGalois.card_aut_eq_finrank K M]

@[simp] theorem cyclicGaloisFixedFieldLayer_one :
    cyclicGaloisFixedFieldLayer K M 1 = ⊥ := by
  unfold cyclicGaloisFixedFieldLayer
  rw [pow_one]
  have htop : Subgroup.zpowers (cyclicGaloisGenerator K M) = ⊤ :=
    (Subgroup.zpowers (cyclicGaloisGenerator K M)).eq_top_iff'.mpr
      (cyclicGaloisGenerator_spec K M)
  rw [htop, IsGalois.fixedField_top]

@[simp] theorem cyclicGaloisFixedFieldLayer_finrank_eq_top :
    cyclicGaloisFixedFieldLayer K M (Module.finrank K M) = ⊤ := by
  unfold cyclicGaloisFixedFieldLayer
  rw [cyclicGaloisGenerator_pow_finrank K M,
    Subgroup.zpowers_one_eq_bot, IntermediateField.fixedField_bot]

instance cyclicGaloisFixedFieldLayer_isGalois (m : ℕ) :
    IsGalois K (cyclicGaloisFixedFieldLayer K M m) := by
  unfold cyclicGaloisFixedFieldLayer
  infer_instance

instance cyclicGaloisFixedFieldLayer_gal_isCyclic (m : ℕ) :
    IsCyclic Gal(cyclicGaloisFixedFieldLayer K M m/K) := by
  let H : Subgroup Gal(M/K) :=
    Subgroup.zpowers (cyclicGaloisGenerator K M ^ m)
  letI : IsCyclic (Gal(M/K) ⧸ H) :=
    isCyclic_of_surjective (QuotientGroup.mk' H)
      (QuotientGroup.mk'_surjective H)
  exact isCyclic_of_surjective (IsGalois.normalAutEquivQuotient H)
    (IsGalois.normalAutEquivQuotient H).surjective

omit [IsGalois K M] in
theorem cyclicGaloisFixedFieldLayer_normQuotient_finite
    (m : ℕ)
    [Finite (Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K M)] :
    Finite (Additive Kˣ ⧸
      cyclicGaloisH2BaseNormImage K (cyclicGaloisFixedFieldLayer K M m)) :=
  cyclicGaloisH2BaseNormQuotient_finite_of_tower K
    (cyclicGaloisFixedFieldLayer K M m) M

/-- Every divisor layer inherits the split local norm-quotient invariant from one invariant
top-field valuation and top-field norm-surjectivity on valuation-zero units. -/
noncomputable def cyclicGaloisFixedFieldLayer_normQuotientSplitValuationEquiv
    {m : ℕ} (hm0 : m ≠ 0) (hm : m ∣ Module.finrank K M)
    (vK : Valuation K (WithZero (Multiplicative ℤ)))
    (vM : Valuation M (WithZero (Multiplicative ℤ))) (u : Kˣ)
    (hu : Multiplicative.toAdd (tameValHom vK u) = 1)
    (hbase : ∀ x : K, vM (algebraMap K M x) = vK x)
    (hM : ∀ (σ : Gal(M/K)) (x : M), vM (σ x) = vM x)
    (hzeroM : ∀ a : Kˣ, tameValHom vK a = 1 →
      ∃ b : Mˣ, Units.map (Algebra.norm K) b = a) :
    Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K
        (cyclicGaloisFixedFieldLayer K M m) ≃+ ZMod m :=
  cyclicGaloisH2BaseNormQuotientSplitValuationEquiv K
    (cyclicGaloisFixedFieldLayer K M m) vK
    (vM.comap (algebraMap (cyclicGaloisFixedFieldLayer K M m) M)) m u hu
    (cyclicGaloisFixedFieldLayer_finrank K M hm0 hm)
    (fun x => by
      simpa [cyclicGaloisFixedFieldLayer_finrank K M hm0 hm] using
        tameValHom_norm_eq_pow_of_top_gal_invariant K
          (cyclicGaloisFixedFieldLayer K M m) M vK vM hbase hM x)
    (tameValHom_norm_zero_surjective_of_tower K
      (cyclicGaloisFixedFieldLayer K M m) M vK hzeroM)

/-- Genuine cyclic degree-two Galois cohomology of every divisor layer is `ZMod m`, using the
valuation inherited from one common top extension. -/
noncomputable def cyclicGaloisFixedFieldLayerH2SplitValuationEquiv
    {m : ℕ} (hm0 : m ≠ 0) (hm : m ∣ Module.finrank K M)
    (vK : Valuation K (WithZero (Multiplicative ℤ)))
    (vM : Valuation M (WithZero (Multiplicative ℤ))) (u : Kˣ)
    (hu : Multiplicative.toAdd (tameValHom vK u) = 1)
    (hbase : ∀ x : K, vM (algebraMap K M x) = vK x)
    (hM : ∀ (σ : Gal(M/K)) (x : M), vM (σ x) = vM x)
    (hzeroM : ∀ a : Kˣ, tameValHom vK a = 1 →
      ∃ b : Mˣ, Units.map (Algebra.norm K) b = a) :
    cyclicGaloisH2 K (cyclicGaloisFixedFieldLayer K M m) ≃+ ZMod m :=
  (cyclicGaloisH2BaseNormQuotientEquiv K
    (cyclicGaloisFixedFieldLayer K M m)).symm.trans
      (cyclicGaloisFixedFieldLayer_normQuotientSplitValuationEquiv K M
        hm0 hm vK vM u hu hbase hM hzeroM)

omit [FiniteDimensional K M] [IsGalois K M] in
theorem cyclicGaloisFixedFieldLayer_mono
    {m n : ℕ} (hmn : m ∣ n) :
    cyclicGaloisFixedFieldLayer K M m ≤
      cyclicGaloisFixedFieldLayer K M n := by
  unfold cyclicGaloisFixedFieldLayer
  apply IntermediateField.fixedField_antitone
  rw [Subgroup.zpowers_le]
  rcases hmn with ⟨d, rfl⟩
  rw [pow_mul]
  exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _

theorem cyclicGaloisFixedFieldLayer_relative_finrank
    {m n : ℕ} (hm0 : m ≠ 0) (hmn : m ∣ n)
    (hn : n ∣ Module.finrank K M) :
    letI : Algebra (cyclicGaloisFixedFieldLayer K M m)
        (cyclicGaloisFixedFieldLayer K M n) :=
      (IntermediateField.inclusion
        (cyclicGaloisFixedFieldLayer_mono K M hmn)).toAlgebra
    Module.finrank (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) = n / m := by
  letI : Algebra (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) :=
    (IntermediateField.inclusion
      (cyclicGaloisFixedFieldLayer_mono K M hmn)).toAlgebra
  haveI : IsScalarTower K (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) :=
    .of_algebraMap_eq fun _ => rfl
  have hn0 : n ≠ 0 := by
    intro hnzero
    subst n
    simp only [zero_dvd_iff] at hn
    exact Module.finrank_pos.ne' hn
  have hmul := Module.finrank_mul_finrank K
    (cyclicGaloisFixedFieldLayer K M m)
    (cyclicGaloisFixedFieldLayer K M n)
  rw [cyclicGaloisFixedFieldLayer_finrank K M hm0 (hmn.trans hn),
    cyclicGaloisFixedFieldLayer_finrank K M hn0 hn] at hmul
  have hdiv : m * (n / m) = n := by
    simpa [Nat.mul_comm] using Nat.div_mul_cancel hmn
  exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hm0)
    (hmul.trans hdiv.symm)

/-- Genuine cohomological inflation between two divisor layers of one invariant top extension is
injective.  This is the actual directed-system map, not a separately defined proxy transition. -/
theorem cyclicGaloisFixedFieldLayer_inflation_injective
    {m n : ℕ} (hmn : m ∣ n)
    (vK : Valuation K (WithZero (Multiplicative ℤ)))
    (vM : Valuation M (WithZero (Multiplicative ℤ))) (u : Kˣ)
    (hu : Multiplicative.toAdd (tameValHom vK u) = 1)
    (hbase : ∀ x : K, vM (algebraMap K M x) = vK x)
    (hM : ∀ (σ : Gal(M/K)) (x : M), vM (σ x) = vM x)
    (hzeroM : ∀ a : Kˣ, tameValHom vK a = 1 →
      ∃ b : Mˣ, Units.map (Algebra.norm K) b = a) :
    letI : Algebra (cyclicGaloisFixedFieldLayer K M m)
        (cyclicGaloisFixedFieldLayer K M n) :=
      (IntermediateField.inclusion
        (cyclicGaloisFixedFieldLayer_mono K M hmn)).toAlgebra
    Function.Injective
      (groupCohomology.map
        (AlgEquiv.restrictNormalHom (F := K)
          (K₁ := cyclicGaloisFixedFieldLayer K M n)
          (cyclicGaloisFixedFieldLayer K M m))
        (galoisTowerUnitsRepresentationHom K
          (cyclicGaloisFixedFieldLayer K M m)
          (cyclicGaloisFixedFieldLayer K M n)) 2).hom := by
  letI : Algebra (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) :=
    (IntermediateField.inclusion
      (cyclicGaloisFixedFieldLayer_mono K M hmn)).toAlgebra
  haveI : IsScalarTower K (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) :=
    .of_algebraMap_eq fun _ => rfl
  letI : FiniteDimensional (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n) :=
    FiniteDimensional.right K (cyclicGaloisFixedFieldLayer K M m)
      (cyclicGaloisFixedFieldLayer K M n)
  apply cyclicGaloisH2Inflation_injective_of_splitValuation K
    (cyclicGaloisFixedFieldLayer K M m)
    (cyclicGaloisFixedFieldLayer K M n) vK
    (vM.comap (algebraMap (cyclicGaloisFixedFieldLayer K M m) M))
    (vM.comap (algebraMap (cyclicGaloisFixedFieldLayer K M n) M)) u hu
  · exact tameValHom_norm_eq_pow_of_top_gal_invariant K
      (cyclicGaloisFixedFieldLayer K M m) M vK vM hbase hM
  · exact tameValHom_norm_zero_surjective_of_tower K
      (cyclicGaloisFixedFieldLayer K M m) M vK hzeroM
  · exact tameValHom_norm_eq_pow_of_top_gal_invariant K
      (cyclicGaloisFixedFieldLayer K M n) M vK vM hbase hM
  · exact tameValHom_norm_zero_surjective_of_tower K
      (cyclicGaloisFixedFieldLayer K M n) M vK hzeroM

end


end GaloisForLFunctions.HTGeometry.ABHN
