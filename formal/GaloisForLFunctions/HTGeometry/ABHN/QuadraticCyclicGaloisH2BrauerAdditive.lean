import GaloisForLFunctions.HTGeometry.ABHN.QuadraticCyclicGaloisH2TorsionBrauer

/-!
# Additivity of quadratic cyclic cohomological Brauer maps

When the degree-two norm quotient is identified with `ℤ/2ℤ`, the existing selected quadratic
cyclic Brauer representative becomes additive.  No tensor-product formula is needed in this
degree: zero is split and the sole nonzero generator is killed by two.

This proves an actual degree-two cohomology-to-Brauer additive bridge under the supplied
norm-quotient identification.  The analogous arbitrary-degree statement still needs the cyclic
tensor-product/Morita formula.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

open CategoryTheory groupCohomology Rep Rep.FiniteCyclicGroup

attribute [local instance] IsCyclic.commGroup

variable (K L : Type) [Field K] [Field L] [Algebra K L] [IsCyclic Gal(L/K)]
  [FiniteDimensional K L] [IsGalois K L]

/-- The two elements of `ℤ/2ℤ` are zero and one. -/
theorem zmod_two_eq_zero_or_eq_one (z : ZMod 2) : z = 0 ∨ z = 1 := by
  fin_cases z
  · exact Or.inl rfl
  · exact Or.inr rfl

/-- The additive `ℤ/2ℤ`-to-Brauer map generated by the selected quadratic cyclic norm-quotient
class. -/
noncomputable def quadraticCyclicNormQuotientBrauerAddHom
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2) :
    ZMod 2 →+ BrauerGroup K :=
  ZMod.lift 2 ⟨{
    toFun := fun z ↦ z • quadraticCyclicNormQuotientBrauerMap K L hdeg e 1
    map_zero' := by simp
    map_add' := by intro x y; rw [add_zsmul]
  }, by
    change (2 : ℤ) • quadraticCyclicNormQuotientBrauerMap K L hdeg e 1 = 0
    change (2 : ℤ) • quadraticCyclicGaloisH2BrauerMap K L hdeg
      (cyclicGaloisH2BaseNormQuotientEquiv K L (e.symm 1)) = 0
    exact two_zsmul_quadraticCyclicGaloisH2BrauerMap_eq_zero K L hdeg _⟩

/-- The originally selected quadratic norm-quotient representative agrees pointwise with its
additive refinement. -/
theorem quadraticCyclicNormQuotientBrauerMap_eq_addHom
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2) (z : ZMod 2) :
    quadraticCyclicNormQuotientBrauerMap K L hdeg e z =
      quadraticCyclicNormQuotientBrauerAddHom K L hdeg e z := by
  rcases zmod_two_eq_zero_or_eq_one z with rfl | rfl
  · rw [quadraticCyclicNormQuotientBrauerMap_zero_eq_split]
    exact (quadraticCyclicNormQuotientBrauerAddHom K L hdeg e).map_zero.symm
  · change quadraticCyclicNormQuotientBrauerMap K L hdeg e ((1 : ℤ) : ZMod 2) =
      quadraticCyclicNormQuotientBrauerAddHom K L hdeg e ((1 : ℤ) : ZMod 2)
    rw [quadraticCyclicNormQuotientBrauerAddHom, ZMod.lift_coe]
    simp

/-- The inverse of the canonical norm-quotient presentation as an additive homomorphism. -/
noncomputable def quadraticCyclicGaloisH2ToNormQuotientAddHom :
    cyclicGaloisH2 K L →+ Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L where
  toFun := (cyclicGaloisH2BaseNormQuotientEquiv K L).symm
  map_zero' := by simp
  map_add' := by
    intro x y
    exact map_add (cyclicGaloisH2BaseNormQuotientEquiv K L).symm x y

/-- The additive refinement of the selected quadratic cyclic `H²` Brauer map. -/
noncomputable def quadraticCyclicGaloisH2BrauerAddHom
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2) :
    cyclicGaloisH2 K L →+ BrauerGroup K :=
  (quadraticCyclicNormQuotientBrauerAddHom K L hdeg e).comp
    ((e.toAddMonoidHom).comp (quadraticCyclicGaloisH2ToNormQuotientAddHom K L))

/-- Evaluation formula for the additive quadratic cyclic `H²` Brauer map. -/
theorem quadraticCyclicGaloisH2BrauerAddHom_apply
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2)
    (z : cyclicGaloisH2 K L) :
    quadraticCyclicGaloisH2BrauerAddHom K L hdeg e z =
      quadraticCyclicNormQuotientBrauerAddHom K L hdeg e
        (e ((cyclicGaloisH2BaseNormQuotientEquiv K L).symm z)) := rfl

/-- The existing selected quadratic cyclic `H²` Brauer representative agrees pointwise with its
additive refinement. -/
theorem quadraticCyclicGaloisH2BrauerMap_eq_addHom
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2)
    (z : cyclicGaloisH2 K L) :
    quadraticCyclicGaloisH2BrauerMap K L hdeg z =
      quadraticCyclicGaloisH2BrauerAddHom K L hdeg e z := by
  let q := (cyclicGaloisH2BaseNormQuotientEquiv K L).symm z
  have hq : cyclicGaloisH2BaseNormQuotientEquiv K L q = z :=
    (cyclicGaloisH2BaseNormQuotientEquiv K L).apply_symm_apply z
  rw [← hq]
  rw [quadraticCyclicGaloisH2BrauerAddHom_apply]
  rw [(cyclicGaloisH2BaseNormQuotientEquiv K L).symm_apply_apply]
  change quadraticCyclicGaloisH2BrauerMap K L hdeg
      (cyclicGaloisH2BaseNormQuotientEquiv K L q) =
    quadraticCyclicNormQuotientBrauerAddHom K L hdeg e (e q)
  simpa [quadraticCyclicNormQuotientBrauerMap] using
    (quadraticCyclicNormQuotientBrauerMap_eq_addHom K L hdeg e (e q))

/-- The selected quadratic cyclic `H²` Brauer map preserves addition once the norm quotient is
presented as `ℤ/2ℤ`. -/
theorem quadraticCyclicGaloisH2BrauerMap_add
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2)
    (x y : cyclicGaloisH2 K L) :
    quadraticCyclicGaloisH2BrauerMap K L hdeg (x + y) =
      quadraticCyclicGaloisH2BrauerMap K L hdeg x +
        quadraticCyclicGaloisH2BrauerMap K L hdeg y := by
  rw [quadraticCyclicGaloisH2BrauerMap_eq_addHom,
    quadraticCyclicGaloisH2BrauerMap_eq_addHom,
    quadraticCyclicGaloisH2BrauerMap_eq_addHom]
  exact (quadraticCyclicGaloisH2BrauerAddHom K L hdeg e).map_add x y

/-- The selected quadratic cyclic `H²` Brauer map sends zero to zero, in additive Brauer-group
notation. -/
theorem quadraticCyclicGaloisH2BrauerMap_zero
    (hdeg : Module.finrank K L = 2)
    (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod 2) :
    quadraticCyclicGaloisH2BrauerMap K L hdeg 0 = 0 := by
  rw [quadraticCyclicGaloisH2BrauerMap_eq_addHom]
  exact (quadraticCyclicGaloisH2BrauerAddHom K L hdeg e).map_zero

end GaloisForLFunctions.HTGeometry.ABHN
