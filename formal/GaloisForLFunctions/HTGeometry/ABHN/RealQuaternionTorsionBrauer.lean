import GaloisForLFunctions.HTGeometry.ABHN.RealQuaternionCSA
import GaloisForLFunctions.HTGeometry.ABHN.RatModIntTorsion

/-!
# The quaternionic two-torsion Brauer map

Hamilton quaternions define a concrete additive map from `ℤ/2ℤ` and, equivalently, from the
two-torsion subgroup of `ℚ/ℤ` into `Br(ℝ)`.  This is the explicit quaternionic half of the
classical real local invariant.  It neither proves that the quaternion class is non-split nor
classifies all real Brauer classes.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

/-- The real quaternion Brauer class is killed by two, expressed as an integer scalar identity. -/
theorem two_zsmul_realQuaternionBrauerClass_eq_zero :
    (2 : ℤ) • (brauerClass realQuaternionCSA : BrauerGroup ℝ) = 0 := by
  calc
    (2 : ℤ) • (brauerClass realQuaternionCSA : BrauerGroup ℝ) =
        (1 : ℤ) • brauerClass realQuaternionCSA + (1 : ℤ) • brauerClass realQuaternionCSA := by
      rw [← add_zsmul]
      norm_num
    _ = brauerClass realQuaternionCSA + brauerClass realQuaternionCSA := by simp
    _ = 0 := realQuaternionBrauerClass_add_self

/-- The additive map from `ℤ/2ℤ` generated by the real quaternion Brauer class. -/
noncomputable def realQuaternionBrauerZModTwoAddHom : ZMod 2 →+ BrauerGroup ℝ :=
  ZMod.lift 2 ⟨{
    toFun := fun z ↦ z • brauerClass realQuaternionCSA
    map_zero' := by simp
    map_add' := by intro x y; rw [add_zsmul]
  }, two_zsmul_realQuaternionBrauerClass_eq_zero⟩

/-- The generator of `ℤ/2ℤ` maps to the real quaternion Brauer class. -/
theorem realQuaternionBrauerZModTwoAddHom_one :
    realQuaternionBrauerZModTwoAddHom (1 : ZMod 2) = brauerClass realQuaternionCSA := by
  change realQuaternionBrauerZModTwoAddHom ((1 : ℤ) : ZMod 2) = _
  rw [realQuaternionBrauerZModTwoAddHom, ZMod.lift_coe]
  simp

/-- The quaternionic two-torsion Brauer map, indexed by the corresponding subgroup of `ℚ/ℤ`. -/
noncomputable def realQuaternionBrauerRatModIntTwoTorsionAddHom :
    ratModIntNTorsion 2 →+ BrauerGroup ℝ :=
  realQuaternionBrauerZModTwoAddHom.comp
    (zmodRatModIntAddEquivNTorsion 2 (by norm_num)).symm.toAddMonoidHom

/-- The quaternionic two-torsion Brauer map sends zero to the split class. -/
theorem realQuaternionBrauerRatModIntTwoTorsionAddHom_zero :
    realQuaternionBrauerRatModIntTwoTorsionAddHom 0 = brauerSplitClass ℝ := by
  exact realQuaternionBrauerRatModIntTwoTorsionAddHom.map_zero

end GaloisForLFunctions.HTGeometry.ABHN
