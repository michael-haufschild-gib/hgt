import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisAlgebraCompanionRepresentation

/-!
# Additive cyclic relative Brauer subgroup

For a fixed finite cyclic Galois extension `L/K`, this file defines the additive subgroup of
`Br(K)` generated by cyclic algebras with defining field `L`.  Every generator becomes split over
`L`; consequently the entire subgroup is contained in the relative Brauer kernel
`ker (Br(K) → Br(L))`.

This is an additive Brauer-side construction.  It deliberately does not assert that the chosen
cyclic `H²` representative map is additive; proving the tensor-product formula for cyclic
algebras remains the missing comparison.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

/-- The set of Brauer classes of nonzero cyclic Galois algebras with fixed defining extension. -/
noncomputable def cyclicGaloisBrauerClassGenerators
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] : Set (BrauerGroup K) :=
  {x | ∃ a : Kˣ, x = brauerClass (cyclicGaloisAlgebraCSA K L (a : K) a.ne_zero)}

/-- The additive subgroup of `Br(K)` generated by cyclic algebras split by the fixed cyclic
Galois extension `L/K`. -/
noncomputable def cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] : AddSubgroup (BrauerGroup K) :=
  AddSubgroup.closure (cyclicGaloisBrauerClassGenerators K L)

/-- The cyclic algebra defined by a nonzero base-field unit belongs to the cyclic relative
Brauer subgroup. -/
theorem cyclicGaloisAlgebra_brauerClass_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] (a : Kˣ) :
    brauerClass (cyclicGaloisAlgebraCSA K L (a : K) a.ne_zero) ∈
      cyclicGaloisBrauerSubgroup K L :=
  AddSubgroup.subset_closure ⟨a, rfl⟩

/-- Every additive combination of cyclic Galois Brauer classes with defining field `L` becomes
split after scalar extension to `L`. -/
theorem cyclicGaloisBrauerSubgroup_le_scalarExtensionBrauerKernel
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisBrauerSubgroup K L ≤ scalarExtensionBrauerKernel K L := by
  rw [cyclicGaloisBrauerSubgroup, AddSubgroup.closure_le]
  rintro x ⟨a, rfl⟩
  exact cyclicGaloisAlgebra_brauerClass_mem_scalarExtensionBrauerKernel K L
    (Module.finrank K L - 1)
    (by
      simpa [Nat.pred_eq_sub_one, Nat.succ_eq_add_one] using
        (Nat.succ_pred_eq_of_pos (Module.finrank_pos)).symm)
    (a : K) a.ne_zero

/-- The inclusion of cyclic Brauer combinations into the defining relative Brauer kernel. -/
noncomputable def cyclicGaloisBrauerSubgroupToRelativeBrauerKernel
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisBrauerSubgroup K L →+ scalarExtensionBrauerKernel K L :=
  (cyclicGaloisBrauerSubgroup K L).subtype.codRestrict (scalarExtensionBrauerKernel K L)
    fun x => cyclicGaloisBrauerSubgroup_le_scalarExtensionBrauerKernel K L x.property

/-- The relative-kernel inclusion retains the original cyclic Brauer class. -/
theorem cyclicGaloisBrauerSubgroupToRelativeBrauerKernel_coe
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (x : cyclicGaloisBrauerSubgroup K L) :
    ((cyclicGaloisBrauerSubgroupToRelativeBrauerKernel K L x :
      scalarExtensionBrauerKernel K L) : BrauerGroup K) = x := rfl

/-- Scalar extension vanishes on the additive subgroup generated by cyclic Galois Brauer
classes with defining field `L`.  This is the exactness fragment available without the cyclic
tensor-product formula. -/
theorem scalarExtensionBrauerAddHom_comp_cyclicGaloisBrauerSubgroup_subtype_eq_zero
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    (scalarExtensionBrauerAddHom K L).comp (cyclicGaloisBrauerSubgroup K L).subtype = 0 := by
  ext x
  exact cyclicGaloisBrauerSubgroup_le_scalarExtensionBrauerKernel K L x.property

end GaloisForLFunctions.HTGeometry.ABHN
