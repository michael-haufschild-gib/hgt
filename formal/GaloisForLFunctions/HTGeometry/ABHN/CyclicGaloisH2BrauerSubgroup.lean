import GaloisForLFunctions.HTGeometry.ABHN.CyclicGaloisBrauerSubgroup

/-!
# Cyclic cohomology maps into the additive cyclic Brauer subgroup

Every selected cyclic cohomology, norm-quotient, and finite continuous cohomology representative
is the Brauer class of a cyclic algebra with the fixed defining field.  This file factors all
such selected maps through the additive subgroup generated by those cyclic classes.

The factors are functions, not additive homomorphisms: additivity still requires the missing
tensor-product comparison between the cyclic parameter product and Brauer tensor addition.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

/-- The selected cyclic `H²` Brauer representative belongs to the additive cyclic Brauer
subgroup for its defining extension. -/
theorem cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z : cyclicGaloisH2 K L) :
    cyclicGaloisH2BrauerMap K L z ∈ cyclicGaloisBrauerSubgroup K L := by
  let u : Additive Kˣ := Additive.ofMul (cyclicGaloisH2FixedBaseUnit K L
    (cyclicGaloisH2Representative K L z))
  change brauerClass (cyclicGaloisAlgebraCSA K L (u.toMul : K) u.toMul.ne_zero) ∈
    cyclicGaloisBrauerSubgroup K L
  exact cyclicGaloisAlgebra_brauerClass_mem_cyclicGaloisBrauerSubgroup K L u.toMul

/-- The selected cyclic `H²` Brauer map with codomain restricted to the additive cyclic Brauer
subgroup. -/
noncomputable def cyclicGaloisH2BrauerSubgroupMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisH2 K L → cyclicGaloisBrauerSubgroup K L :=
  fun z ↦ ⟨cyclicGaloisH2BrauerMap K L z,
    cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L z⟩

/-- The cyclic-subgroup factor retains the selected `H²` Brauer representative. -/
theorem cyclicGaloisH2BrauerSubgroupMap_coe
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z : cyclicGaloisH2 K L) :
    ((cyclicGaloisH2BrauerSubgroupMap K L z : cyclicGaloisBrauerSubgroup K L) :
      BrauerGroup K) = cyclicGaloisH2BrauerMap K L z := rfl

/-- The cyclic-subgroup factor followed by its relative-kernel inclusion is the existing
selected relative Brauer map. -/
theorem cyclicGaloisH2BrauerSubgroupMap_toRelativeBrauerKernel_eq
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (hdeg : Module.finrank K L = n + 1) (z : cyclicGaloisH2 K L) :
    cyclicGaloisBrauerSubgroupToRelativeBrauerKernel K L
      (cyclicGaloisH2BrauerSubgroupMap K L z) =
      cyclicGaloisH2RelativeBrauerMap K L n hdeg z := by
  apply Subtype.ext
  rfl

/-- A selected cyclic norm-quotient Brauer representative belongs to the additive cyclic Brauer
subgroup. -/
theorem cyclicGaloisNormQuotientBrauerMap_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod n) (z : ZMod n) :
    cyclicGaloisNormQuotientBrauerMap K L n e z ∈ cyclicGaloisBrauerSubgroup K L := by
  change cyclicGaloisH2BrauerMap K L
    (cyclicGaloisH2BaseNormQuotientEquiv K L (e.symm z)) ∈
      cyclicGaloisBrauerSubgroup K L
  exact cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L _

/-- The cyclic norm-quotient Brauer map with codomain restricted to the additive cyclic Brauer
subgroup. -/
noncomputable def cyclicGaloisNormQuotientBrauerSubgroupMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : Additive Kˣ ⧸ cyclicGaloisH2BaseNormImage K L ≃+ ZMod n) :
    ZMod n → cyclicGaloisBrauerSubgroup K L :=
  fun z ↦ ⟨cyclicGaloisNormQuotientBrauerMap K L n e z,
    cyclicGaloisNormQuotientBrauerMap_mem_cyclicGaloisBrauerSubgroup K L n e z⟩

/-- A selected finite cyclic `H²` invariant Brauer representative belongs to the additive cyclic
Brauer subgroup. -/
theorem cyclicGaloisH2InvariantBrauerMap_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : cyclicGaloisH2 K L ≃+ ZMod n) (z : ZMod n) :
    cyclicGaloisH2InvariantBrauerMap K L n e z ∈ cyclicGaloisBrauerSubgroup K L := by
  change cyclicGaloisH2BrauerMap K L (e.symm z) ∈ cyclicGaloisBrauerSubgroup K L
  exact cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L _

/-- The finite cyclic `H²` invariant Brauer map with codomain restricted to the additive cyclic
Brauer subgroup. -/
noncomputable def cyclicGaloisH2InvariantBrauerSubgroupMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : cyclicGaloisH2 K L ≃+ ZMod n) :
    ZMod n → cyclicGaloisBrauerSubgroup K L :=
  fun z ↦ ⟨cyclicGaloisH2InvariantBrauerMap K L n e z,
    cyclicGaloisH2InvariantBrauerMap_mem_cyclicGaloisBrauerSubgroup K L n e z⟩

/-- A selected finite continuous cyclic `H²` Brauer representative belongs to the additive cyclic
Brauer subgroup. -/
theorem finiteGaloisContinuousCyclicH2BrauerMap_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z : continuousGaloisUnitCohomology 2 K L) :
    finiteGaloisContinuousCyclicH2BrauerMap K L z ∈ cyclicGaloisBrauerSubgroup K L := by
  change cyclicGaloisH2BrauerMap K L
    (finiteGaloisContinuousH2ToOrdinaryH2AddEquiv K L z) ∈ cyclicGaloisBrauerSubgroup K L
  exact cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L _

/-- The finite continuous cyclic `H²` Brauer map with codomain restricted to the additive cyclic
Brauer subgroup. -/
noncomputable def finiteGaloisContinuousCyclicH2BrauerSubgroupMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    continuousGaloisUnitCohomology 2 K L → cyclicGaloisBrauerSubgroup K L :=
  fun z ↦ ⟨finiteGaloisContinuousCyclicH2BrauerMap K L z,
    finiteGaloisContinuousCyclicH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L z⟩

/-- A selected finite continuous cyclic invariant Brauer representative belongs to the additive
cyclic Brauer subgroup. -/
theorem finiteGaloisContinuousCyclicH2InvariantBrauerMap_mem_cyclicGaloisBrauerSubgroup
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ZMod n) (z : ZMod n) :
    finiteGaloisContinuousCyclicH2InvariantBrauerMap K L n e z ∈
      cyclicGaloisBrauerSubgroup K L := by
  change finiteGaloisContinuousCyclicH2BrauerMap K L (e.symm z) ∈
    cyclicGaloisBrauerSubgroup K L
  exact finiteGaloisContinuousCyclicH2BrauerMap_mem_cyclicGaloisBrauerSubgroup K L _

/-- The finite continuous cyclic invariant Brauer map with codomain restricted to the additive
cyclic Brauer subgroup. -/
noncomputable def finiteGaloisContinuousCyclicH2InvariantBrauerSubgroupMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (n : ℕ) (e : continuousGaloisUnitCohomology 2 K L ≃+ ZMod n) :
    ZMod n → cyclicGaloisBrauerSubgroup K L :=
  fun z ↦ ⟨finiteGaloisContinuousCyclicH2InvariantBrauerMap K L n e z,
    finiteGaloisContinuousCyclicH2InvariantBrauerMap_mem_cyclicGaloisBrauerSubgroup K L n e z⟩

/-- Every selected cyclic `H²` Brauer representative is itself a generator of the additive
cyclic Brauer subgroup. -/
theorem cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerClassGenerators
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L]
    (z : cyclicGaloisH2 K L) :
    cyclicGaloisH2BrauerMap K L z ∈ cyclicGaloisBrauerClassGenerators K L := by
  let u : Additive Kˣ := Additive.ofMul (cyclicGaloisH2FixedBaseUnit K L
    (cyclicGaloisH2Representative K L z))
  change brauerClass (cyclicGaloisAlgebraCSA K L (u.toMul : K) u.toMul.ne_zero) ∈
    cyclicGaloisBrauerClassGenerators K L
  exact ⟨u.toMul, rfl⟩

/-- The additive cyclic Brauer subgroup is precisely the additive closure of the selected cyclic
`H²` Brauer representatives.  Tensor compatibility would strengthen this by showing the range
itself is already a subgroup. -/
theorem cyclicGaloisBrauerSubgroup_eq_closure_range_cyclicGaloisH2BrauerMap
    (K L : Type) [Field K] [Field L] [Algebra K L]
    [IsCyclic Gal(L/K)] [FiniteDimensional K L] [IsGalois K L] :
    cyclicGaloisBrauerSubgroup K L =
      AddSubgroup.closure (Set.range (cyclicGaloisH2BrauerMap K L)) := by
  apply le_antisymm
  · rw [cyclicGaloisBrauerSubgroup, AddSubgroup.closure_le]
    rintro x ⟨a, rfl⟩
    apply AddSubgroup.subset_closure
    refine ⟨cyclicGaloisH2BaseProjection K L (Additive.ofMul a), ?_⟩
    simpa [cyclicGaloisH2ParameterCSA] using
      (cyclicGaloisH2Parameter_brauerClass_eq_brauerMap_of_baseProjection K L
        (Additive.ofMul a) (cyclicGaloisH2BaseProjection K L (Additive.ofMul a)) rfl).symm
  · rw [AddSubgroup.closure_le]
    rintro x ⟨z, rfl⟩
    exact AddSubgroup.subset_closure
      (cyclicGaloisH2BrauerMap_mem_cyclicGaloisBrauerClassGenerators K L z)

end GaloisForLFunctions.HTGeometry.ABHN
