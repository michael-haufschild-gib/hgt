import GaloisForLFunctions.HTGeometry.ABHN.HasseFiniteRamification
import GaloisForLFunctions.HTGeometry.ABHN.RationalFunctionPlaces

/-!
# Finitely many places outside a principal open

The complement of a principal open in the affine model of a global field has finitely many
finite places.  With the archimedean or infinite place included, it is still finite.  These are
the candidate exceptional places associated to the nonzero elements supplied by the generic
Azumaya-locus construction.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

open IsDedekindDomain NumberField
open scoped NumberField Polynomial

universe u

/-- A nonzero element of a principal localization has a representation with nonzero numerator.
This converts the second localization witness in a two-stage principal-open construction back
into a nonzero element of the original ring. -/
theorem exists_nonzero_numerator_of_nonzero_principalLocalization
    (R : Type u) [CommRing R] [IsDomain R] (r : R) (hr : r ≠ 0)
    (s : Localization (Submonoid.powers r)) (hs : s ≠ 0) :
    ∃ (n : ℕ) (a : R), a ≠ 0 ∧
      s * (algebraMap R (Localization (Submonoid.powers r)) r) ^ n =
        algebraMap R (Localization (Submonoid.powers r)) a := by
  have hpow : Submonoid.powers r ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hr
  letI : IsDomain (Localization (Submonoid.powers r)) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization (Submonoid.powers r)) hpow
  obtain ⟨n, a, hsa⟩ := IsLocalization.Away.surj r s
  refine ⟨n, a, ?_, hsa⟩
  intro ha
  subst a
  rw [map_zero] at hsa
  have hmap : (algebraMap R (Localization (Submonoid.powers r)) r) ^ n ≠ 0 :=
    pow_ne_zero n (IsLocalization.to_map_ne_zero_of_mem_nonZeroDivisors
      (Localization (Submonoid.powers r)) hpow
      (mem_nonZeroDivisors_iff_ne_zero.mpr hr))
  exact (mul_ne_zero hs hmap) hsa

/-- If a principal-localization element has numerator relation `s * r^n = a`, then its image
is a unit after inverting the product `r * a`.  This supplies the comparison map from the second
localization stage to the single localization controlling both exceptional divisor sets. -/
theorem principalLocalization_numeratorRelation_map_isUnit
    (R : Type u) [CommRing R] (r a : R) (n : ℕ)
    (s : Localization (Submonoid.powers r))
    (hsa : s * (algebraMap R (Localization (Submonoid.powers r)) r) ^ n =
      algebraMap R (Localization (Submonoid.powers r)) a) :
    IsUnit (IsLocalization.Away.awayToAwayRight
      (S := Localization (Submonoid.powers r))
      (P := Localization (Submonoid.powers (r * a))) r a s) := by
  let f : Localization (Submonoid.powers r) →+*
      Localization (Submonoid.powers (r * a)) :=
    IsLocalization.Away.awayToAwayRight r a
  have hfa : IsUnit (algebraMap R (Localization (Submonoid.powers (r * a))) a) := by
    apply isUnit_of_dvd_unit (map_dvd _ (dvd_mul_left a r))
    simpa only [map_mul] using
      (IsLocalization.Away.algebraMap_isUnit
        (S := Localization (Submonoid.powers (r * a))) (r * a))
  have hrel : f s * (algebraMap R (Localization (Submonoid.powers (r * a))) r) ^ n =
      algebraMap R (Localization (Submonoid.powers (r * a))) a := by
    have h := congrArg f hsa
    dsimp [f] at h
    simpa only [map_mul, map_pow, IsLocalization.Away.awayToAwayRight_eq] using h
  have hprod : IsUnit (f s *
      (algebraMap R (Localization (Submonoid.powers (r * a))) r) ^ n) := hrel.symm ▸ hfa
  exact (IsUnit.mul_iff.mp hprod).1

/-- Only finitely many height-one primes divide the principal ideal generated by a nonzero
element of a Dedekind domain. -/
theorem finite_heightOneSpectrum_divisors_span_singleton
    (R : Type u) [CommRing R] [IsDedekindDomain R] (r : R) (hr : r ≠ 0) :
    {P : HeightOneSpectrum R | P.asIdeal ∣ Ideal.span ({r} : Set R)}.Finite := by
  apply Ideal.finite_factors
  intro h
  apply hr
  have hrmem : r ∈ (⊥ : Ideal R) := by
    change r ∈ (0 : Ideal R)
    rw [← h]
    exact Ideal.subset_span (Set.mem_singleton r)
  simpa using hrmem

/-- The finite rational-function-field places omitted by a nonzero polynomial principal open
form a finite set. -/
theorem rationalFunction_finite_principalOpenBadPlaces
    (F : Type u) [Field F] [Finite F] (r : F[X]) (hr : r ≠ 0) :
    {p : RationalFunctionPlace F | match p with
      | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
      | .infinite => False}.Finite := by
  let s : Set (HeightOneSpectrum F[X]) :=
    {v | v.asIdeal ∣ Ideal.span ({r} : Set F[X])}
  have hs : s.Finite := finite_heightOneSpectrum_divisors_span_singleton F[X] r hr
  have heq : {p : RationalFunctionPlace F | match p with
      | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
      | .infinite => False} = RationalFunctionPlace.finite '' s := by
    ext p
    cases p <;> simp [s]
  rw [heq]
  exact hs.image RationalFunctionPlace.finite

/-- The exceptional rational-function-field places for a nonzero polynomial principal open,
including the place at infinity, form a finite set. -/
theorem rationalFunction_finite_principalOpenBadPlaces_with_infinite
    (F : Type u) [Field F] [Finite F] (r : F[X]) (hr : r ≠ 0) :
    {p : RationalFunctionPlace F | match p with
      | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
      | .infinite => True}.Finite := by
  let s : Set (RationalFunctionPlace F) :=
    {p | match p with
      | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
      | .infinite => False}
  have hs : s.Finite := rationalFunction_finite_principalOpenBadPlaces F r hr
  have hinfinite : ({RationalFunctionPlace.infinite} : Set (RationalFunctionPlace F)).Finite :=
    Set.finite_singleton _
  have heq : {p : RationalFunctionPlace F | match p with
      | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
      | .infinite => True} = s ∪ {RationalFunctionPlace.infinite} := by
    ext p
    cases p <;> simp [s]
  rw [heq]
  exact hs.union hinfinite

/-- The finite places of a number field omitted by a nonzero integral principal open form a
finite set. -/
theorem numberField_finite_principalOpenBadFinitePlaces
    (K : Type u) [Field K] [NumberField K] (r : 𝓞 K) (hr : r ≠ 0) :
    {w : NumberField.FinitePlace K |
      w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))}.Finite := by
  let s : Set (HeightOneSpectrum (𝓞 K)) :=
    {v | v.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))}
  have hs : s.Finite := finite_heightOneSpectrum_divisors_span_singleton (𝓞 K) r hr
  have h_inj : Set.InjOn NumberField.FinitePlace.maximalIdeal
      {w : NumberField.FinitePlace K |
        w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))} :=
    Function.Injective.injOn NumberField.FinitePlace.maximalIdeal_injective
  refine (hs.subset ?_).of_finite_image h_inj
  intro w hw
  rcases hw with ⟨w, hw, rfl⟩
  exact hw

/-- The exceptional number-field places for a nonzero integral principal open, including all
archimedean places, form a finite set. -/
theorem numberField_finite_principalOpenBadPlaces
    (K : Type u) [Field K] [NumberField K] (r : 𝓞 K) (hr : r ≠ 0) :
    {p : NumberFieldPlace K | match p with
      | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))
      | .infinite _ => True}.Finite := by
  let s : Set (NumberFieldPlace K) :=
    {p | match p with
      | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))
      | .infinite _ => False}
  have hfinite : {w : NumberField.FinitePlace K |
      w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))}.Finite :=
    numberField_finite_principalOpenBadFinitePlaces K r hr
  have hs : s.Finite := by
    have heq : s = NumberFieldPlace.finite ''
        {w : NumberField.FinitePlace K |
          w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))} := by
      ext p
      cases p <;> simp [s]
    rw [heq]
    exact hfinite.image NumberFieldPlace.finite
  have hinfinite : (Set.range (NumberFieldPlace.infinite : InfinitePlace K →
      NumberFieldPlace K)).Finite := by
    simpa only [Set.image_univ] using
      (Set.finite_univ : (Set.univ : Set (InfinitePlace K)).Finite).image
        (fun w => NumberFieldPlace.infinite w)
  have heq : {p : NumberFieldPlace K | match p with
      | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))
      | .infinite _ => True} = s ∪
        Set.range (NumberFieldPlace.infinite : InfinitePlace K → NumberFieldPlace K) := by
    ext p
    cases p <;> simp [s]
  rw [heq]
  exact hs.union hinfinite

/-- Candidate exceptional places for a two-stage rational-function-field principal open.  The
finite branch records prime divisors of either original-ring numerator; infinity is retained. -/
def rationalFunctionTwoPrincipalOpenCandidateBadPlaces
    (F : Type u) [Field F] [Finite F] (r a : F[X]) : Set (RationalFunctionPlace F) :=
  {p | match p with
    | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X]) ∨
        v.asIdeal ∣ Ideal.span ({a} : Set F[X])
    | .infinite => True}

/-- The candidate exceptional places associated to two nonzero rational-function-field
principal-open numerators are finite. -/
theorem rationalFunction_finite_twoPrincipalOpenCandidateBadPlaces
    (F : Type u) [Field F] [Finite F] (r a : F[X]) (hr : r ≠ 0) (ha : a ≠ 0) :
    (rationalFunctionTwoPrincipalOpenCandidateBadPlaces F r a).Finite := by
  have hrfin := rationalFunction_finite_principalOpenBadPlaces_with_infinite F r hr
  have hafin := rationalFunction_finite_principalOpenBadPlaces_with_infinite F a ha
  have heq : rationalFunctionTwoPrincipalOpenCandidateBadPlaces F r a =
      {p : RationalFunctionPlace F | match p with
        | .finite v => v.asIdeal ∣ Ideal.span ({r} : Set F[X])
        | .infinite => True} ∪
      {p : RationalFunctionPlace F | match p with
        | .finite v => v.asIdeal ∣ Ideal.span ({a} : Set F[X])
        | .infinite => True} := by
    ext p
    cases p <;> simp [rationalFunctionTwoPrincipalOpenCandidateBadPlaces]
  rw [heq]
  exact hrfin.union hafin

/-- Candidate exceptional places for a two-stage number-field principal open.  The finite branch
records prime divisors of either original-ring numerator; all archimedean places are retained. -/
def numberFieldTwoPrincipalOpenCandidateBadPlaces
    (K : Type u) [Field K] [NumberField K] (r a : 𝓞 K) : Set (NumberFieldPlace K) :=
  {p | match p with
    | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K)) ∨
        w.maximalIdeal.asIdeal ∣ Ideal.span ({a} : Set (𝓞 K))
    | .infinite _ => True}

/-- The candidate exceptional places associated to two nonzero number-field principal-open
numerators are finite. -/
theorem numberField_finite_twoPrincipalOpenCandidateBadPlaces
    (K : Type u) [Field K] [NumberField K] (r a : 𝓞 K) (hr : r ≠ 0) (ha : a ≠ 0) :
    (numberFieldTwoPrincipalOpenCandidateBadPlaces K r a).Finite := by
  have hrfin := numberField_finite_principalOpenBadPlaces K r hr
  have hafin := numberField_finite_principalOpenBadPlaces K a ha
  have heq : numberFieldTwoPrincipalOpenCandidateBadPlaces K r a =
      {p : NumberFieldPlace K | match p with
        | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({r} : Set (𝓞 K))
        | .infinite _ => True} ∪
      {p : NumberFieldPlace K | match p with
        | .finite w => w.maximalIdeal.asIdeal ∣ Ideal.span ({a} : Set (𝓞 K))
        | .infinite _ => True} := by
    ext p
    cases p <;> simp [numberFieldTwoPrincipalOpenCandidateBadPlaces]
  rw [heq]
  exact hrfin.union hafin

end GaloisForLFunctions.HTGeometry.ABHN
