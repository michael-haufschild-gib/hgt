import GaloisForLFunctions.HTGeometry.ABHN.CentralDivisionSeparableElement
import Mathlib.LinearAlgebra.Dimension.FreeAndStrongRankCondition
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Nontrivial separable-generator subfields of nonsplit Brauer representatives

An algebra generated by one element in a finite division algebra is commutative and closed under
inverses.  It is therefore a field even though its ambient division algebra need not be
commutative.  Applied to the Jacobson--Noether witness, every nonsplit Brauer class has a central
division representative containing a nontrivial finite subfield generated by a separable element.

This leaves a precise local structural problem: enlarge this field to a maximal subfield and prove
that a maximal subfield of the local central division algebra can be chosen unramified.
-/

namespace GaloisForLFunctions.HTGeometry.ABHN

open scoped IsMulCommutative

noncomputable section

universe u

variable (K D : Type u) [Field K] [DivisionRing D] [Algebra K D]

/-- A one-generator subalgebra of a finite division algebra over a field is itself a field. -/
theorem algebraAdjoinSingleton_isField_of_finiteDivisionRing
    [Module.Finite K D] (x : D) :
    IsField (Algebra.adjoin K ({x} : Set D)) := by
  let S := Algebra.adjoin K ({x} : Set D)
  change IsField S
  haveI : Algebra.IsIntegral K D := Algebra.IsIntegral.of_finite K D
  refine
    { exists_pair_ne := ⟨0, 1, zero_ne_one⟩
      mul_comm := mul_comm
      mul_inv_cancel := ?_ }
  intro a ha
  have haD : (a : D) ≠ 0 := by
    intro hzero
    apply ha
    exact Subtype.ext hzero
  have hinv : (a : D)⁻¹ ∈ S :=
    (Algebra.IsIntegral.isIntegral (R := K) (a : D)).inv_mem a.property
  exact ⟨⟨(a : D)⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ haD)⟩

/-- An element outside the base generates a subalgebra strictly larger than the base. -/
theorem algebraAdjoinSingleton_ne_bot_of_not_mem_base
    (x : D) (hx : x ∉ (⊥ : Subalgebra K D)) :
    Algebra.adjoin K ({x} : Set D) ≠ ⊥ := by
  intro hadjoin
  apply hx
  rw [← hadjoin]
  exact Algebra.self_mem_adjoin_singleton K x

/-- The field generated by an element outside the base has degree strictly larger than one. -/
theorem one_lt_finrank_algebraAdjoinSingleton_of_not_mem_base
    [Module.Finite K D] (x : D) (hx : x ∉ (⊥ : Subalgebra K D)) :
    1 < Module.finrank K (Algebra.adjoin K ({x} : Set D)) := by
  have hne := algebraAdjoinSingleton_ne_bot_of_not_mem_base K D x hx
  have hneOne : Module.finrank K (Algebra.adjoin K ({x} : Set D)) ≠ 1 := by
    intro heq
    exact hne (Subalgebra.eq_bot_of_finrank_one heq)
  have hpos : 0 < Module.finrank K (Algebra.adjoin K ({x} : Set D)) :=
    Module.finrank_pos
  omega

/-- Every nonsplit Brauer class has a central division representative containing a nontrivial
finite field generated by a separable element. -/
theorem brauerGroup_ne_split_exists_nontrivial_separableSubfield
    (K : Type u) [Field K] (x : BrauerGroup K) (hx : x ≠ brauerSplitClass K) :
    ∃ (D : Type u) (_ : DivisionRing D) (_ : Algebra K D)
      (_ : Module.Finite K D) (_ : Algebra.IsCentral K D) (y : D),
      x = brauerClass (centralDivisionCSA K D) ∧
        y ∉ (⊥ : Subalgebra K D) ∧ IsSeparable K y ∧
          IsField (Algebra.adjoin K ({y} : Set D)) ∧
            1 < Module.finrank K (Algebra.adjoin K ({y} : Set D)) := by
  obtain ⟨D, hD, aD, finD, centralD, y, hclass, hybase, hysep⟩ :=
    brauerGroup_ne_split_exists_centralDivision_separable K x hx
  exact ⟨D, hD, aD, finD, centralD, y, hclass, hybase, hysep,
    algebraAdjoinSingleton_isField_of_finiteDivisionRing K D y,
    one_lt_finrank_algebraAdjoinSingleton_of_not_mem_base K D y hybase⟩

end

end GaloisForLFunctions.HTGeometry.ABHN
