import GaloisForLFunctions.HTGeometry.AnalyticGermRing
import GaloisForLFunctions.HTGeometry.AnalyticHadamardDivision

/-!
# The maximal ideal of the local ring of analytic germs in two variables

Evaluation at the base point is a surjective ring homomorphism from the local ring of analytic germs
onto `ℂ`.  At the origin of `ℂ × ℂ` its kernel is generated by the two coordinate germs — this is
Hadamard division — so the quotient of the local ring by the coordinate ideal is `ℂ`.

* `germValue`, `analyticGermValue` — evaluation at the base point.
* `germCoordFst`, `germCoordSnd` — the two coordinate germs at the origin.
* `ker_analyticGermValue_eq_span` — the kernel is the coordinate ideal.
* `analyticGermQuotientCoordEquiv` — the quotient by the coordinate ideal is `ℂ`.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Evaluation of a germ at its base point. -/
def germValue (p : E) : Germ (𝓝 p) ℂ →+* ℂ where
  toFun := Quotient.lift (fun f : E → ℂ => f p)
    (fun _ _ h => Filter.EventuallyEq.eq_of_nhds h)
  map_one' := rfl
  map_mul' g₁ g₂ := by
    refine Germ.inductionOn₂ g₁ g₂ fun f₁ f₂ => ?_
    rfl
  map_zero' := rfl
  map_add' g₁ g₂ := by
    refine Germ.inductionOn₂ g₁ g₂ fun f₁ f₂ => ?_
    rfl

omit [NormedSpace ℂ E] in
@[simp]
theorem germValue_coe (p : E) (f : E → ℂ) : germValue p (f : Germ (𝓝 p) ℂ) = f p := rfl

/-- Evaluation of an analytic germ at its base point. -/
def analyticGermValue (p : E) : AnalyticGerm p →+* ℂ :=
  (germValue p).comp (analyticGermSubring p).subtype

@[simp]
theorem analyticGermValue_of {p : E} {f : E → ℂ} (hf : AnalyticAt ℂ f p) :
    analyticGermValue p (analyticGermOf hf) = f p := rfl

theorem analyticGermValue_surjective (p : E) : Function.Surjective (analyticGermValue p) := by
  intro c
  exact ⟨analyticGermOf (analyticAt_const (v := c) (x := p)), rfl⟩

/-- The germ of a product of analytic functions is the product of their germs. -/
theorem analyticGermOf_mul {p : E} {f g : E → ℂ} (hf : AnalyticAt ℂ f p)
    (hg : AnalyticAt ℂ g p) :
    analyticGermOf (hf.mul hg) = analyticGermOf hf * analyticGermOf hg := rfl

/-- Analytic germs agreeing near the point are equal. -/
theorem analyticGermOf_congr {p : E} {f g : E → ℂ} (hf : AnalyticAt ℂ f p)
    (hg : AnalyticAt ℂ g p) (h : f =ᶠ[𝓝 p] g) :
    analyticGermOf hf = analyticGermOf hg :=
  (analyticGermOf_eq_iff hf hg).mpr h

/-! ### The coordinate ideal at the origin of `ℂ × ℂ` -/

/-- The germ of the first coordinate at the origin. -/
noncomputable def germCoordFst : AnalyticGerm ((0 : ℂ), (0 : ℂ)) :=
  analyticGermOf (f := fun v : ℂ × ℂ => v.1) analyticAt_fst

/-- The germ of the second coordinate at the origin. -/
noncomputable def germCoordSnd : AnalyticGerm ((0 : ℂ), (0 : ℂ)) :=
  analyticGermOf (f := fun v : ℂ × ℂ => v.2) analyticAt_snd

theorem analyticGermValue_germCoordFst :
    analyticGermValue ((0 : ℂ), (0 : ℂ)) germCoordFst = 0 := rfl

theorem analyticGermValue_germCoordSnd :
    analyticGermValue ((0 : ℂ), (0 : ℂ)) germCoordSnd = 0 := rfl

/-- **The kernel of evaluation at the origin is the coordinate ideal.**  Containment of the ideal in
the kernel is immediate; the converse is Hadamard division. -/
theorem ker_analyticGermValue_eq_span :
    RingHom.ker (analyticGermValue ((0 : ℂ), (0 : ℂ)))
      = Ideal.span {germCoordFst, germCoordSnd} := by
  apply le_antisymm
  · rintro ⟨-, f, hf, rfl⟩ hker
    have hf0 : f (0 : ℂ × ℂ) = 0 := hker
    have hf' : AnalyticAt ℂ f (0 : ℂ × ℂ) := hf
    obtain ⟨A, B, hA, hB, hEq⟩ := exists_hadamard_decomposition hf'
    have hmul : AnalyticAt ℂ (fun v : ℂ × ℂ => v.1 * A v + v.2 * B v) ((0 : ℂ), (0 : ℂ)) :=
      (analyticAt_fst.mul hA).add (analyticAt_snd.mul hB)
    have hstep : analyticGermOf hf = analyticGermOf hmul := by
      refine analyticGermOf_congr hf hmul ?_
      filter_upwards [hEq] with v hv
      rw [hv, hf0, zero_add]
    have hcomb : analyticGermOf hf
        = germCoordFst * analyticGermOf hA + germCoordSnd * analyticGermOf hB := by
      rw [hstep]
      rfl
    have hmem : analyticGermOf hf ∈ Ideal.span {germCoordFst, germCoordSnd} := by
      rw [hcomb]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ ?_) (Ideal.mul_mem_right _ _ ?_)
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    exact hmem
  · rw [Ideal.span_le]
    rintro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [SetLike.mem_coe, RingHom.mem_ker]
    rcases hx with rfl | rfl
    · exact analyticGermValue_germCoordFst
    · exact analyticGermValue_germCoordSnd

/-- **The quotient of the local ring by the coordinate ideal is `ℂ`.**  In particular it is
one-dimensional. -/
noncomputable def analyticGermQuotientCoordEquiv :
    (AnalyticGerm ((0 : ℂ), (0 : ℂ)) ⧸ Ideal.span {germCoordFst, germCoordSnd}) ≃+* ℂ := by
  refine RingEquiv.trans (Ideal.quotEquivOfEq ker_analyticGermValue_eq_span.symm) ?_
  exact RingHom.quotientKerEquivOfSurjective
    (analyticGermValue_surjective ((0 : ℂ), (0 : ℂ)))

end GaloisForLFunctions.HTGeometry
