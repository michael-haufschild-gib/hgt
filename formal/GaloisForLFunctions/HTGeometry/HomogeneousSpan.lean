import GaloisForLFunctions.HTGeometry.DegenerationTransport

/-!
# Ideals generated by homogeneous elements

```text
homogeneousComponent_mul_eq_zero_of_lt   multiplying by a homogeneous factor kills low degrees
homogeneousComponent_self_or_zero        a homogeneous polynomial is its own component, or zero
isHomogIdeal_span                        ** an ideal generated by homogeneous elements is
                                            homogeneous **
```

The span induction needs the multiplier decomposed: a general coefficient is the sum of its
homogeneous components, each of which either shifts the degree of the factor or pushes it out of
range, so the component of the product is a combination of components of the factor.

This is what makes the degeneration theorem applicable to a determinantal ideal: the minors are
homogeneous, so the ideal they generate is.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u
variable {σ : Type*} {K : Type u} [Field K]

theorem homogeneousComponent_mul_eq_zero_of_lt {h : MvPolynomial σ K} {i : ℕ}
    (hh : h.IsHomogeneous i) (g : MvPolynomial σ K) {e : ℕ} (hei : e < i) :
    MvPolynomial.homogeneousComponent e (h * g) = 0 := by
  classical
  ext γ
  rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_zero]
  by_cases hγ : Finsupp.degree γ = e
  · rw [if_pos hγ, MvPolynomial.coeff_mul]
    refine Finset.sum_eq_zero ?_
    rintro ⟨α, β⟩ hαβ
    have hsum : α + β = γ := Finset.HasAntidiagonal.mem_antidiagonal.mp hαβ
    by_cases hα : MvPolynomial.coeff α h = 0
    · rw [hα, zero_mul]
    · exfalso
      have hdα : Finsupp.degree α = i := by
        have := hh hα
        rwa [weight_one_eq_degree] at this
      have hadd : Finsupp.degree α + Finsupp.degree β = Finsupp.degree γ := by
        rw [← hsum]
        simp [map_add]
      omega
  · rw [if_neg hγ]

theorem homogeneousComponent_self_or_zero {g : MvPolynomial σ K} {d : ℕ}
    (hg : g.IsHomogeneous d) (e : ℕ) :
    MvPolynomial.homogeneousComponent e g = if e = d then g else 0 := by
  classical
  ext γ
  rw [MvPolynomial.coeff_homogeneousComponent]
  by_cases hed : e = d
  · rw [if_pos hed]
    by_cases hγ : Finsupp.degree γ = e
    · rw [if_pos hγ]
    · rw [if_neg hγ]
      by_contra hcon
      refine hγ ?_
      have := hg (Ne.symm hcon)
      rw [weight_one_eq_degree] at this
      omega
  · rw [if_neg hed, MvPolynomial.coeff_zero]
    by_cases hγ : Finsupp.degree γ = e
    · rw [if_pos hγ]
      by_contra hcon
      have := hg hcon
      rw [weight_one_eq_degree] at this
      omega
    · rw [if_neg hγ]

/-- **An ideal generated by homogeneous elements is homogeneous.** -/
theorem isHomogIdeal_span {G : Set (MvPolynomial σ K)}
    (hG : ∀ g ∈ G, ∃ d, g.IsHomogeneous d) : IsHomogIdeal (Ideal.span G) := by
  classical
  intro e x hx
  induction hx using Submodule.span_induction generalizing e with
  | mem g hg =>
    obtain ⟨d, hd⟩ := hG g hg
    rw [homogeneousComponent_self_or_zero hd]
    split
    · exact Ideal.subset_span hg
    · exact Ideal.zero_mem _
  | zero =>
    rw [map_zero]
    exact Ideal.zero_mem _
  | add a b _ _ ha hb =>
    rw [map_add]
    exact Ideal.add_mem _ (ha e) (hb e)
  | smul r a _ ha =>
    have hexp : (r : MvPolynomial σ K) * a
        = ∑ i ∈ Finset.range (r.totalDegree + 1),
          (MvPolynomial.homogeneousComponent i r) * a := by
      conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent r]
      rw [Finset.sum_mul]
    show MvPolynomial.homogeneousComponent e (r * a) ∈ Ideal.span G
    rw [hexp, map_sum]
    refine Ideal.sum_mem _ fun i _ => ?_
    by_cases hie : i ≤ e
    · have hkey : MvPolynomial.homogeneousComponent e
          ((MvPolynomial.homogeneousComponent i r) * a)
          = (MvPolynomial.homogeneousComponent i r)
            * MvPolynomial.homogeneousComponent (e - i) a := by
        have hshift := homogeneousComponent_mul_left
          (MvPolynomial.homogeneousComponent_isHomogeneous i r) a (e - i)
        rwa [show i + (e - i) = e from by omega] at hshift
      rw [hkey]
      exact Ideal.mul_mem_left _ _ (ha (e - i))
    · rw [homogeneousComponent_mul_eq_zero_of_lt
        (MvPolynomial.homogeneousComponent_isHomogeneous i r) a (by omega)]
      exact Ideal.zero_mem _

end GaloisForLFunctions.HTGeometry
