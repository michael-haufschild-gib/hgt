import GaloisForLFunctions.HTGeometry.DifferenceDifferential
import GaloisForLFunctions.HTGeometry.AnalyticSubringEvaluation
import GaloisForLFunctions.HTGeometry.MeromorphicThetaDefect
import GaloisForLFunctions.HTGeometry.MeromorphicTranslationDifferentialOperator
import GaloisForLFunctions.HTGeometry.MeromorphicTranslationFixedField
import GaloisForLFunctions.HTGeometry.EllipticGammaMixedFace
import Mathlib.Order.Filter.Germ.Basic

/-!
# Rank-three meromorphic source-boundary reconstruction

The full integer subgroup generated by three rationally independent source periods acts on the
global meromorphic differential field by commuting translations.  Its joint-fixed field is exactly
the embedded complex constants.  Consequently the unpointed translation boundary cannot
reconstruct a primitive, while the same boundary together with any additive calibration that is
injective on constants does reconstruct it.
-/

open Filter Set
open scoped Differential

namespace GaloisForLFunctions

open Bottcher

noncomputable section

local instance rankThreeSourceBoundaryDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance rankThreeSourceBoundaryComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring Set.univ) := (constToAnalytic Set.univ).toAlgebra

local instance rankThreeSourceBoundaryComplexAlgebraMero :
    Algebra ℂ (meroField Set.univ) :=
  ((algebraMap (analyticSubring Set.univ) (meroField Set.univ)).comp
    (constToAnalytic Set.univ)).toAlgebra

local instance rankThreeSourceBoundaryDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

/-- The physical integer period subgroup generated by three source periods. -/
abbrev rankThreePeriodGroup (v : Fin 3 → ℂ) : Type :=
  Submodule.span ℤ (Set.range v)

/-- Translation by every element of the physical period subgroup, as one commuting
difference-differential field. -/
def rankThreeMeromorphicDifferenceDifferentialField (v : Fin 3 → ℂ) :
    CommutingDifferenceDifferentialField (rankThreePeriodGroup v) ℂ
      (meroField Set.univ) where
  aut q := addTranslationMeroEquiv (q : ℂ)
  aut_comm p q x := by
    simpa only [addTranslationMeroEquiv_add] using
      congrArg (fun r : ℂ ↦ addTranslationMeroEquiv r x)
        (add_comm (p : ℂ) (q : ℂ))
  aut_deriv q x := addTranslationMeroEquiv_deriv (q : ℂ) x
  aut_algebraMap q c := by
    change addTranslationMeroEquiv (q : ℂ)
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ)
          (constToAnalytic Set.univ c)) = _
    exact addTranslationMeroEquiv_const (q : ℂ) c

/-- The embedded complex constants, regarded as an additive calibration target. -/
def meromorphicConstantEmbedding : ℂ →+ meroField (Set.univ : Set ℂ) :=
  (algebraMap ℂ (meroField Set.univ)).toAddMonoidHom

/-- For a rank-three source, joint translation invariance is equivalent to being constant. -/
theorem rankThree_jointFixed_iff_constant
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (z : meroField (Set.univ : Set ℂ)) :
    JointFixed (rankThreeMeromorphicDifferenceDifferentialField v) z ↔
      ∃ c : ℂ, meromorphicConstantEmbedding c = z := by
  constructor
  · intro hfixed
    obtain ⟨c, hc⟩ := exists_constant_of_rankThree_translation_fixed v hv z
      (fun q hq ↦ hfixed ⟨q, hq⟩)
    exact ⟨c, hc⟩
  · rintro ⟨c, rfl⟩ q
    exact (rankThreeMeromorphicDifferenceDifferentialField v).aut_algebraMap q c

/-- The full rank-three translation boundary still forgets the nonzero constant gauge. -/
theorem rankThree_boundaryFingerprint_not_injective
    (v : Fin 3 → ℂ) :
    ¬ Function.Injective
      (rankThreeMeromorphicDifferenceDifferentialField v).boundaryFingerprint := by
  apply (rankThreeMeromorphicDifferenceDifferentialField v).boundaryFingerprint_not_injective_of_jointFixed
    (meromorphicConstantEmbedding 1)
  · intro q
    exact (rankThreeMeromorphicDifferenceDifferentialField v).aut_algebraMap q 1
  · change algebraMap ℂ (meroField Set.univ) 1 ≠ 0
    simp

/-- **Pointed rank-three source reconstruction.**  The translation boundary together with any
additive source calibration reconstructs every meromorphic primitive as soon as that calibration
separates the residual complex constants. -/
theorem rankThree_pointedBoundaryFingerprint_injective
    {A : Type*} [AddCommGroup A]
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (calibration : meroField (Set.univ : Set ℂ) →+ A)
    (hcalibration : Function.Injective
      (calibration.comp meromorphicConstantEmbedding)) :
    Function.Injective
      ((rankThreeMeromorphicDifferenceDifferentialField v).pointedBoundaryFingerprint
        calibration) := by
  apply (rankThreeMeromorphicDifferenceDifferentialField v).pointedBoundaryFingerprint_injective
    calibration
  intro z hfixed hzero
  obtain ⟨c, hc⟩ := (rankThree_jointFixed_iff_constant v hv z).mp hfixed
  have hc0 : (calibration.comp meromorphicConstantEmbedding) c =
      (calibration.comp meromorphicConstantEmbedding) 0 := by
    simpa [hc] using hzero
  have hc_zero : c = (0 : ℂ) := hcalibration hc0
  rw [← hc, hc_zero]
  exact map_zero (algebraMap ℂ (meroField Set.univ))

/-! ## Reconstruction from the three source equations -/

theorem addTranslationMeroEquiv_zero_apply
    (z : meroField (Set.univ : Set ℂ)) :
    addTranslationMeroEquiv 0 z = z := by
  apply (addTranslationMeroEquiv 0).injective
  simpa using addTranslationMeroEquiv_add 0 0 z

/-- Periods fixing a given meromorphic primitive form an additive subgroup. -/
def meromorphicTranslationStabilizer
    (z : meroField (Set.univ : Set ℂ)) : AddSubgroup ℂ where
  carrier := {q | addTranslationMeroEquiv q z = z}
  zero_mem' := by
    change addTranslationMeroEquiv 0 z = z
    exact addTranslationMeroEquiv_zero_apply z
  add_mem' := by
    intro p q hp hq
    change addTranslationMeroEquiv (p + q) z = z
    change addTranslationMeroEquiv p z = z at hp
    change addTranslationMeroEquiv q z = z at hq
    rw [← addTranslationMeroEquiv_add, hq, hp]
  neg_mem' := by
    intro p hp
    change addTranslationMeroEquiv (-p) z = z
    change addTranslationMeroEquiv p z = z at hp
    apply (addTranslationMeroEquiv p).injective
    rw [addTranslationMeroEquiv_add, add_neg_cancel,
      addTranslationMeroEquiv_zero_apply, hp]

/-- Fixing the three source translations already forces invariance under their entire integer
span.  Thus the full period-boundary used above is generated by the actual finite source data. -/
theorem rankThree_span_fixed_of_generator_fixed
    (v : Fin 3 → ℂ) (z : meroField (Set.univ : Set ℂ))
    (hfixed : ∀ i, addTranslationMeroEquiv (v i) z = z) :
    ∀ q ∈ Submodule.span ℤ (Set.range v), addTranslationMeroEquiv q z = z := by
  intro q hq
  have hrange : Set.range v ⊆ meromorphicTranslationStabilizer z := by
    rintro _ ⟨i, rfl⟩
    exact hfixed i
  have hspan : Submodule.span ℤ (Set.range v) ≤
      (meromorphicTranslationStabilizer z).toIntSubmodule :=
    Submodule.span_le.mpr hrange
  exact hspan hq

/-- The three source generators acting on the global meromorphic differential field. -/
def rankThreeGeneratorMeromorphicDifferenceDifferentialField (v : Fin 3 → ℂ) :
    CommutingDifferenceDifferentialField (Fin 3) ℂ (meroField Set.univ) where
  aut i := addTranslationMeroEquiv (v i)
  aut_comm i j x := by
    simpa only [addTranslationMeroEquiv_add] using
      congrArg (fun r : ℂ ↦ addTranslationMeroEquiv r x)
        (add_comm (v i) (v j))
  aut_deriv i x := addTranslationMeroEquiv_deriv (v i) x
  aut_algebraMap i c := by
    change addTranslationMeroEquiv (v i)
        (algebraMap (analyticSubring Set.univ) (meroField Set.univ)
          (constToAnalytic Set.univ c)) = _
    exact addTranslationMeroEquiv_const (v i) c

/-- The common fixed field of the three source generators is exactly the complex constants. -/
theorem rankThree_generator_jointFixed_iff_constant
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (z : meroField (Set.univ : Set ℂ)) :
    JointFixed (rankThreeGeneratorMeromorphicDifferenceDifferentialField v) z ↔
      ∃ c : ℂ, meromorphicConstantEmbedding c = z := by
  constructor
  · intro hfixed
    obtain ⟨c, hc⟩ := exists_constant_of_rankThree_translation_fixed v hv z
      (rankThree_span_fixed_of_generator_fixed v z hfixed)
    exact ⟨c, hc⟩
  · rintro ⟨c, rfl⟩ i
    exact (rankThreeGeneratorMeromorphicDifferenceDifferentialField v).aut_algebraMap i c

/-- The three unpointed source equations forget the nonzero constant gauge. -/
theorem rankThree_generator_boundaryFingerprint_not_injective
    (v : Fin 3 → ℂ) :
    ¬ Function.Injective
      (rankThreeGeneratorMeromorphicDifferenceDifferentialField v).boundaryFingerprint := by
  apply (rankThreeGeneratorMeromorphicDifferenceDifferentialField v).boundaryFingerprint_not_injective_of_jointFixed
    (meromorphicConstantEmbedding 1)
  · intro i
    exact (rankThreeGeneratorMeromorphicDifferenceDifferentialField v).aut_algebraMap i 1
  · change algebraMap ℂ (meroField Set.univ) 1 ≠ 0
    simp

/-- **Finite-source reconstruction.**  The three source defects plus a calibration injective on
constants reconstruct the meromorphic primitive.  No boundary values outside the source
generators are assumed. -/
theorem rankThree_generator_pointedBoundaryFingerprint_injective
    {A : Type*} [AddCommGroup A]
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (calibration : meroField (Set.univ : Set ℂ) →+ A)
    (hcalibration : Function.Injective
      (calibration.comp meromorphicConstantEmbedding)) :
    Function.Injective
      ((rankThreeGeneratorMeromorphicDifferenceDifferentialField v).pointedBoundaryFingerprint
        calibration) := by
  apply (rankThreeGeneratorMeromorphicDifferenceDifferentialField v).pointedBoundaryFingerprint_injective
    calibration
  intro z hfixed hzero
  obtain ⟨c, hc⟩ :=
    (rankThree_generator_jointFixed_iff_constant v hv z).mp hfixed
  have hc0 : (calibration.comp meromorphicConstantEmbedding) c =
      (calibration.comp meromorphicConstantEmbedding) 0 := by
    simpa [hc] using hzero
  have hc_zero : c = (0 : ℂ) := hcalibration hc0
  rw [← hc, hc_zero]
  exact map_zero (algebraMap ℂ (meroField Set.univ))

/-! ## Multiplicative source reconstruction -/

/-- The three multiplicative source ratios of a nonzero meromorphic primitive. -/
def rankThreeGeneratorMultiplicativeBoundary
    (v : Fin 3 → ℂ) (x : meroField (Set.univ : Set ℂ)) :
    Fin 3 → meroField Set.univ := fun i ↦
  addTranslationMeroEquiv (v i) x / x

/-- Equal multiplicative source ratios are exactly a joint-fixed quotient. -/
theorem rankThreeGeneratorMultiplicativeBoundary_eq_iff_div_jointFixed
    (v : Fin 3 → ℂ) (x y : meroField (Set.univ : Set ℂ))
    (hx : x ≠ 0) (hy : y ≠ 0) :
    rankThreeGeneratorMultiplicativeBoundary v x =
        rankThreeGeneratorMultiplicativeBoundary v y ↔
      JointFixed (rankThreeGeneratorMeromorphicDifferenceDifferentialField v) (x / y) := by
  constructor
  · intro h i
    have hi := congrFun h i
    simp only [rankThreeGeneratorMultiplicativeBoundary] at hi
    rw [map_div₀]
    have hcross : addTranslationMeroEquiv (v i) x * y =
        addTranslationMeroEquiv (v i) y * x :=
      (div_eq_div_iff hx hy).mp hi
    apply (div_eq_div_iff
      ((addTranslationMeroEquiv (v i)).map_ne_zero_iff.mpr hy) hy).mpr
    simpa [mul_comm] using! hcross
  · intro h
    funext i
    have hi := h i
    rw [map_div₀] at hi
    have hcross : addTranslationMeroEquiv (v i) x * y =
        addTranslationMeroEquiv (v i) y * x := by
      have := (div_eq_div_iff
        ((addTranslationMeroEquiv (v i)).map_ne_zero_iff.mpr hy) hy).mp hi
      simpa [mul_comm] using! this
    exact (div_eq_div_iff hx hy).mpr hcross

/-- **Unpointed multiplicative reconstruction.**  For a rationally independent rank-three
source, two nonzero meromorphic primitives have the same three source ratios exactly when they
differ by one nonzero complex scalar.  Thus source-preserving morphisms are reconstructed, not
merely object equality. -/
theorem rankThreeGeneratorMultiplicativeBoundary_eq_iff_constant_multiple
    (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (x y : meroField (Set.univ : Set ℂ)) (hx : x ≠ 0) (hy : y ≠ 0) :
    rankThreeGeneratorMultiplicativeBoundary v x =
        rankThreeGeneratorMultiplicativeBoundary v y ↔
      ∃ c : ℂ, c ≠ 0 ∧ x = meromorphicConstantEmbedding c * y := by
  rw [rankThreeGeneratorMultiplicativeBoundary_eq_iff_div_jointFixed v x y hx hy,
    rankThree_generator_jointFixed_iff_constant v hv (x / y)]
  constructor
  · rintro ⟨c, hc⟩
    have hc0 : c ≠ 0 := by
      intro hzero
      apply hx
      have : x / y = 0 := by simpa [hzero] using hc.symm
      exact (div_eq_zero_iff.mp this).resolve_right hy
    refine ⟨c, hc0, ?_⟩
    exact (div_eq_iff hy).mp hc.symm
  · rintro ⟨c, hc0, rfl⟩
    refine ⟨c, ?_⟩
    rw [mul_div_cancel_right₀ _ hy]

/-- The multiplicative source boundary together with an arbitrary source-pointing observation. -/
def rankThreeGeneratorPointedMultiplicativeBoundary
    {A : Type*} (v : Fin 3 → ℂ)
    (calibration : meroField (Set.univ : Set ℂ) → A)
    (x : meroField (Set.univ : Set ℂ)) :
    (Fin 3 → meroField Set.univ) × A :=
  (rankThreeGeneratorMultiplicativeBoundary v x, calibration x)

/-- **Pointed multiplicative reconstruction.**  If the source pointing selects at most one point
on every nonzero constant orbit, then the three multiplicative source ratios plus that pointing
reconstruct the meromorphic primitive itself. -/
theorem rankThreeGeneratorPointedMultiplicativeBoundary_injOn
    {A : Type*} (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (calibration : meroField (Set.univ : Set ℂ) → A)
    (hcalibration : ∀ (c : ℂ) (y : meroField (Set.univ : Set ℂ)),
      c ≠ 0 → y ≠ 0 →
      calibration (meromorphicConstantEmbedding c * y) = calibration y → c = 1) :
    Set.InjOn (rankThreeGeneratorPointedMultiplicativeBoundary v calibration)
      {x : meroField (Set.univ : Set ℂ) | x ≠ 0} := by
  intro x hx y hy hxy
  have hboundary := congrArg Prod.fst hxy
  have hpoint := congrArg Prod.snd hxy
  obtain ⟨c, hc0, hc⟩ :=
    (rankThreeGeneratorMultiplicativeBoundary_eq_iff_constant_multiple
      v hv x y hx hy).mp hboundary
  have hc1 : c = 1 := hcalibration c y hc0 hy (by simpa [hc] using! hpoint)
  rw [hc, hc1]
  change algebraMap ℂ (meroField Set.univ) 1 * y = y
  rw [map_one, one_mul]

/-! ## A genuine regular-point calibration -/

/-- A fraction presentation of a global meromorphic germ together with a pointed regular value.
Both numerator and denominator are required to be nonzero at the point, so the value belongs to
the multiplicative fibre and can normalize its constant gauge. -/
structure RegularPointedMeromorphicPresentation (z : ℂ) where
  numerator : analyticSubring (Set.univ : Set ℂ)
  denominator : analyticSubring (Set.univ : Set ℂ)
  numerator_eval_ne_zero :
    univGermEval z (numerator : Germ (Filter.principal Set.univ) ℂ) ≠ 0
  denominator_eval_ne_zero :
    univGermEval z (denominator : Germ (Filter.principal Set.univ) ℂ) ≠ 0

namespace RegularPointedMeromorphicPresentation

/-- The global meromorphic germ represented by a pointed regular fraction. -/
def toMero {z : ℂ} (X : RegularPointedMeromorphicPresentation z) :
    meroField (Set.univ : Set ℂ) :=
  algebraMap (analyticSubring Set.univ) (meroField Set.univ) X.numerator /
    algebraMap (analyticSubring Set.univ) (meroField Set.univ) X.denominator

/-- Its literal value at the pointed regular point. -/
def value {z : ℂ} (X : RegularPointedMeromorphicPresentation z) : ℂ :=
  univGermEval z (X.numerator : Germ (Filter.principal Set.univ) ℂ) /
    univGermEval z (X.denominator : Germ (Filter.principal Set.univ) ℂ)

theorem numerator_ne_zero {z : ℂ} (X : RegularPointedMeromorphicPresentation z) :
    X.numerator ≠ 0 := by
  intro h
  apply X.numerator_eval_ne_zero
  simp [h]

theorem denominator_ne_zero {z : ℂ} (X : RegularPointedMeromorphicPresentation z) :
    X.denominator ≠ 0 := by
  intro h
  apply X.denominator_eval_ne_zero
  simp [h]

theorem toMero_ne_zero {z : ℂ} (X : RegularPointedMeromorphicPresentation z) :
    X.toMero ≠ 0 := by
  apply div_ne_zero
  · intro hzero
    apply X.numerator_ne_zero
    apply IsFractionRing.injective (analyticSubring Set.univ) (meroField Set.univ)
    simpa using hzero
  · intro hzero
    apply X.denominator_ne_zero
    apply IsFractionRing.injective (analyticSubring Set.univ) (meroField Set.univ)
    simpa using hzero

theorem value_ne_zero {z : ℂ} (X : RegularPointedMeromorphicPresentation z) :
    X.value ≠ 0 :=
  div_ne_zero X.numerator_eval_ne_zero X.denominator_eval_ne_zero

/-- Equality to a constant multiple in the fraction field evaluates to the same constant multiple
at every common regular point. -/
theorem value_eq_constant_mul_of_toMero_eq
    {z : ℂ} (X Y : RegularPointedMeromorphicPresentation z) (c : ℂ)
    (h : X.toMero = meromorphicConstantEmbedding c * Y.toMero) :
    X.value = c * Y.value := by
  let A := analyticSubring (Set.univ : Set ℂ)
  let F := meroField (Set.univ : Set ℂ)
  have hxd : algebraMap A F X.denominator ≠ 0 := by
    intro hzero
    apply X.denominator_ne_zero
    apply IsFractionRing.injective A F
    simpa using hzero
  have hyd : algebraMap A F Y.denominator ≠ 0 := by
    intro hzero
    apply Y.denominator_ne_zero
    apply IsFractionRing.injective A F
    simpa using hzero
  have hdiv : algebraMap A F X.numerator / algebraMap A F X.denominator =
      algebraMap A F (constToAnalytic Set.univ c * Y.numerator) /
        algebraMap A F Y.denominator := by
    simpa [toMero, meromorphicConstantEmbedding, map_mul, mul_div_assoc] using! h
  have hcrossF := (div_eq_div_iff hxd hyd).mp hdiv
  have hcrossA : X.numerator * Y.denominator =
      (constToAnalytic Set.univ c * Y.numerator) * X.denominator := by
    apply IsFractionRing.injective A F
    simpa only [map_mul] using hcrossF
  have heval := congrArg
    (fun a : A ↦ univGermEval z (a : Germ (Filter.principal Set.univ) ℂ)) hcrossA
  simp only [univGermEval_analyticSubring_mul] at heval
  have hconsteval : univGermEval z
      ((constToAnalytic Set.univ c : analyticSubring Set.univ) :
        Germ (Filter.principal Set.univ) ℂ) = c := by
    rfl
  rw [hconsteval] at heval
  change univGermEval z (X.numerator : Germ (Filter.principal Set.univ) ℂ) /
      univGermEval z (X.denominator : Germ (Filter.principal Set.univ) ℂ) =
    c * (univGermEval z (Y.numerator : Germ (Filter.principal Set.univ) ℂ) /
      univGermEval z (Y.denominator : Germ (Filter.principal Set.univ) ℂ))
  field_simp [X.denominator_eval_ne_zero, Y.denominator_eval_ne_zero]
  calc
    _ = c * univGermEval z
        (Y.numerator : Germ (Filter.principal Set.univ) ℂ) *
          univGermEval z
            (X.denominator : Germ (Filter.principal Set.univ) ℂ) := heval
    _ = _ := by ring

/-- **Regular-point analytic reconstruction.**  On a rationally independent rank-three source,
the three multiplicative source equations and one common nonzero regular value reconstruct the
global meromorphic germ.  This instantiates the abstract calibration theorem by literal analytic
evaluation, rather than by storing the germ as its own calibration. -/
theorem eq_toMero_of_same_sourceBoundary_and_value
    {z : ℂ} (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (X Y : RegularPointedMeromorphicPresentation z)
    (hboundary : rankThreeGeneratorMultiplicativeBoundary v X.toMero =
      rankThreeGeneratorMultiplicativeBoundary v Y.toMero)
    (hvalue : X.value = Y.value) :
    X.toMero = Y.toMero := by
  obtain ⟨c, hc0, hc⟩ :=
    (rankThreeGeneratorMultiplicativeBoundary_eq_iff_constant_multiple
      v hv X.toMero Y.toMero X.toMero_ne_zero Y.toMero_ne_zero).mp hboundary
  have hpoint : X.value = c * Y.value :=
    value_eq_constant_mul_of_toMero_eq X Y c hc
  have hc1 : c = 1 := by
    apply (mul_right_cancel₀ Y.value_ne_zero)
    simpa [hvalue] using hpoint.symm
  simpa [hc1, meromorphicConstantEmbedding] using hc

/-- The set of global meromorphic germs represented by a regular fraction that solves one
finite multiplicative source constraint and has one prescribed pointed value.  This is constructed
from the source boundary and pointing; it does not store a chosen solution. -/
def pointedSourceSolutionGermSet
    {z : ℂ} (v : Fin 3 → ℂ)
    (boundary : Fin 3 → meroField (Set.univ : Set ℂ)) (pointValue : ℂ) :
    Set (meroField (Set.univ : Set ℂ)) :=
  {x | ∃ X : RegularPointedMeromorphicPresentation z,
    X.toMero = x ∧
    rankThreeGeneratorMultiplicativeBoundary v x = boundary ∧
    X.value = pointValue}

/-- **Canonical source-effectivity fibre.**  For a rationally independent rank-three source, the
pointed solution set constructed only from the boundary constraint and point value contains at
most one analytic germ.  Nonemptiness is effectivity; this theorem is reconstruction. -/
theorem pointedSourceSolutionGermSet_subsingleton
    {z : ℂ} (v : Fin 3 → ℂ) (hv : LinearIndependent ℚ v)
    (boundary : Fin 3 → meroField (Set.univ : Set ℂ)) (pointValue : ℂ) :
    (pointedSourceSolutionGermSet (z := z) v boundary pointValue).Subsingleton := by
  intro x hx y hy
  obtain ⟨X, rfl, hXboundary, hXvalue⟩ := hx
  obtain ⟨Y, rfl, hYboundary, hYvalue⟩ := hy
  apply eq_toMero_of_same_sourceBoundary_and_value v hv X Y
  · exact hXboundary.trans hYboundary.symm
  · exact hXvalue.trans hYvalue.symm

end RegularPointedMeromorphicPresentation

/-! ## The actual elliptic-gamma primitive -/

/-- The ordered rank-three source periods of the additive elliptic gamma function. -/
def ellipticGammaSourcePeriods (sigma tau : ℂ) : Fin 3 → ℂ :=
  ![1, sigma, tau]

/-- The genuine elliptic-gamma product as a pointed regular meromorphic presentation at any point
off its numerator and denominator divisors. -/
def ellipticGammaRegularPointedPresentation
    (sigma tau z : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hzF : ellipticGammaForwardProduct sigma tau z ≠ 0)
    (hzB : ellipticGammaBackwardProduct sigma tau z ≠ 0) :
    RegularPointedMeromorphicPresentation z where
  numerator := ellipticGammaForwardAnalytic sigma tau hsigma htau
  denominator := ellipticGammaBackwardAnalytic sigma tau hsigma htau
  numerator_eval_ne_zero := by simpa using hzF
  denominator_eval_ne_zero := by simpa using hzB

@[simp] theorem ellipticGammaRegularPointedPresentation_toMero
    (sigma tau z : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hzF : ellipticGammaForwardProduct sigma tau z ≠ 0)
    (hzB : ellipticGammaBackwardProduct sigma tau z ≠ 0) :
    (ellipticGammaRegularPointedPresentation sigma tau z hsigma htau hzF hzB).toMero =
      ellipticGammaMero sigma tau hsigma htau := by
  rfl

@[simp] theorem ellipticGammaRegularPointedPresentation_value
    (sigma tau z : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hzF : ellipticGammaForwardProduct sigma tau z ≠ 0)
    (hzB : ellipticGammaBackwardProduct sigma tau z ≠ 0) :
    (ellipticGammaRegularPointedPresentation sigma tau z hsigma htau hzF hzB).value =
      ellipticGammaProduct sigma tau z := by
  rfl

/-- **Actual elliptic-gamma source reconstruction.**  Any nonzero meromorphic fraction regular at
the source point, with the same three multiplicative source ratios and the same pointed value as
the genuine irrational elliptic-gamma product, is that product in the global meromorphic field. -/
theorem eq_ellipticGammaMero_of_same_sourceBoundary_and_value
    (sigma tau z : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (hzF : ellipticGammaForwardProduct sigma tau z ≠ 0)
    (hzB : ellipticGammaBackwardProduct sigma tau z ≠ 0)
    (Y : RegularPointedMeromorphicPresentation z)
    (hboundary : rankThreeGeneratorMultiplicativeBoundary
        (ellipticGammaSourcePeriods sigma tau) Y.toMero =
      rankThreeGeneratorMultiplicativeBoundary
        (ellipticGammaSourcePeriods sigma tau)
        (ellipticGammaMero sigma tau hsigma htau))
    (hvalue : Y.value = ellipticGammaProduct sigma tau z) :
    Y.toMero = ellipticGammaMero sigma tau hsigma htau := by
  let X := ellipticGammaRegularPointedPresentation sigma tau z hsigma htau hzF hzB
  exact RegularPointedMeromorphicPresentation.eq_toMero_of_same_sourceBoundary_and_value
    (ellipticGammaSourcePeriods sigma tau) hindependent Y X
    (by simpa [X] using hboundary) (by simpa [X] using hvalue)

end

end GaloisForLFunctions
