import GaloisForLFunctions.HTGeometry.OneSidedJetIndependence
import GaloisForLFunctions.HTGeometry.ProjectiveJetHorizon
import GaloisForLFunctions.HTGeometry.JetHypertranscendenceBridge
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg

/-!
# Hypertranscendence as an infinite additive-torsor staircase

The *derivative-shadow tower* of an element `x` of a differential field is the descending chain of
jet-tail fields `D_k = F⟨x^{(k)}⟩` (`jetTailField F x k`).  Each step adjoins exactly one element,

`D_k = D_{k+1}(x^{(k)})`,

so its transcendence degree `ε_k` is `0` or `1`, and `ε_k = 1` exactly when `x^{(k)}` is
transcendental over the strict tail.  Hypertranscendence is precisely the all-ones staircase:
every step is a genuine primitive extension.

The forward implication is the corpus's jet-horizon theorem; the converse is the one-sided
independence criterion, which turns step-by-step transcendence into algebraic independence of the
whole jet sequence.

## Main results

* `jetTailField_succ_adjoin` — the tower step is a simple extension;
* `trdeg_jetStep_le_one` — hence `ε_k ∈ {0,1}`;
* `hypertranscendentalOver_iff_forall_jetStep` — HT is the all-ones staircase;
* `deriv_jet_mem_jetTailField_succ` — every step is a primitive (`G_a`) extension;
* `exists_jetStep_algebraic_of_not_hypertranscendentalOver` — a differentially algebraic element
  has a collapsing step.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential

/-! ### The tower step is simple -/

/-- The jet index set splits off its least element. -/
theorem image_Ici_succ_union {E : Type*} (j : ℕ → E) (n : ℕ) :
    j '' Set.Ici (n + 1) ∪ {j n} = j '' Set.Ici n := by
  ext y
  constructor
  · rintro (⟨m, hm, rfl⟩ | rfl)
    · exact ⟨m, by simp only [Set.mem_Ici] at hm ⊢; omega, rfl⟩
    · exact ⟨n, Set.self_mem_Ici, rfl⟩
  · rintro ⟨m, hm, rfl⟩
    simp only [Set.mem_Ici] at hm
    rcases Nat.eq_or_lt_of_le hm with rfl | hlt
    · exact Or.inr rfl
    · exact Or.inl ⟨m, by simp only [Set.mem_Ici]; omega, rfl⟩

/-- **The derivative-shadow step is a simple extension.**  `D_k = D_{k+1}(x^{(k)})`. -/
theorem jetTailField_succ_adjoin (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) (n : ℕ) :
    (IntermediateField.adjoin (jetTailField F x (n + 1)) {differentialJet n x}).restrictScalars F
      = jetTailField F x n := by
  rw [jetTailField, IntermediateField.adjoin_adjoin_left]
  rw [jetTailField]
  congr 1
  exact image_Ici_succ_union (fun m => differentialJet m x) n

/-- **Every step costs at most one.**  The tower step has transcendence degree at most one. -/
theorem trdeg_jetStep_le_one {F E : Type} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : E) (n : ℕ) :
    Algebra.trdeg (jetTailField F x (n + 1))
        (IntermediateField.adjoin (jetTailField F x (n + 1)) {differentialJet n x}) ≤ 1 := by
  have hrange : Set.range (fun _ : Unit => differentialJet n x) = {differentialJet n x} := by
    ext y; simp
  have h := trdeg_intermediateFieldAdjoin_range_le
    (F := (jetTailField F x (n + 1) : Type)) (E := E) (I := Unit)
    (fun _ : Unit => differentialJet n x)
  rw [hrange] at h
  simpa using h

/-- **Every step is a primitive extension.**  The derivative of the step generator already lies in
the step's base field, so the step is a `G_a`-primitive, never a multiplicative one. -/
theorem deriv_jet_mem_jetTailField_succ (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) (n : ℕ) :
    (differentialJet n x)′ ∈ jetTailField F x (n + 1) := by
  rw [← differentialJet_succ]
  exact differentialJet_mem_jetTailField F x (le_refl (n + 1))

/-! ### The staircase characterization -/

/-- The `k`-th step of the derivative-shadow staircase is *strict* when the `k`-th jet is
transcendental over the field generated by all higher jets. -/
def JetStepStrict (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : E) (k : ℕ) : Prop :=
  Transcendental (jetTailField F x (k + 1)) (differentialJet k x)

/-- **Hypertranscendence is the all-ones staircase.**  An element is hypertranscendental over the
base exactly when every derivative-shadow step is a genuine primitive extension. -/
theorem hypertranscendentalOver_iff_forall_jetStep {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) :
    HypertranscendentalOver F x ↔ ∀ k, JetStepStrict F x k := by
  constructor
  · intro hx k
    exact hypertranscendentalOver_transcendental_over_strictJetTail hx k
  · intro hstep
    rw [hypertranscendentalOver_iff_algebraicIndependent_jets]
    refine algebraicIndependent_of_transcendental_tail (j := fun m => differentialJet m x) ?_
    intro n
    have h := hstep n
    rw [JetStepStrict, jetTailField, IntermediateField.transcendental_adjoin_iff] at h
    exact h

/-- **A differentially algebraic element has a collapsing step.** -/
theorem exists_jetStep_algebraic_of_not_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E] {x : E}
    (hx : ¬ HypertranscendentalOver F x) : ∃ k, ¬ JetStepStrict F x k := by
  by_contra hcon
  push Not at hcon
  exact hx ((hypertranscendentalOver_iff_forall_jetStep x).mpr hcon)

/-- **A collapsing step is exactly an algebraic jet.**  If the `k`-th step is not strict, the
`k`-th jet is algebraic over the strict tail, so the step costs nothing. -/
theorem isAlgebraic_of_not_jetStepStrict {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] {x : E} {k : ℕ} (h : ¬ JetStepStrict F x k) :
    IsAlgebraic (jetTailField F x (k + 1)) (differentialJet k x) := by
  rw [JetStepStrict, Transcendental, not_not] at h
  exact h

end GaloisForLFunctions.HTGeometry
