/-!
# Applications of arXiv:2608.29060 to existing HTGeometry interfaces

This module transfers the paper's odd-dimensional fixed-generator obstruction, reflection-stable
domain principle, and Bellman recursion into existing corpus abstractions. The skew-generator
results are exact over arbitrary finite odd index types. The final theorem shows that exponential
discounting preserves the local-gate max-plus recursion already available for finite reachability
layers.
-/

noncomputable section

open MeasureTheory Set Filter Topology
open scoped BigOperators ENNReal Matrix NNReal Pointwise

namespace Matrix

/-- A matrix exponential fixes every vector in the generator's kernel.  The proof avoids any
coordinatewise manipulation of the exponential series by lifting the vector to a repeated-column
matrix and transporting the resulting semiconjugacy through `exp`. -/
theorem exp_mulVec_of_mulVec_eq_zero
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (z : ι → ℝ) (hz : A *ᵥ z = 0) :
    NormedSpace.exp A *ᵥ z = z := by
  cases isEmpty_or_nonempty ι with
  | inl _ => exact Subsingleton.elim _ _
  | inr hι =>
      letI := hι
      open scoped Norms.Operator in
        have hsemi : SemiconjBy (Matrix.replicateCol ι z) 0 A := by
          rw [SemiconjBy]
          rw [mul_zero, ← Matrix.replicateCol_mulVec, hz, Matrix.replicateCol_zero]
        have hexp := hsemi.exp_right
        rw [SemiconjBy, NormedSpace.exp_zero, mul_one,
          ← Matrix.replicateCol_mulVec] at hexp
        exact Matrix.replicateCol_injective hexp.symm

/-- A left-kernel vector has constant projection along the linear flow generated by a matrix. -/
theorem dotProduct_exp_mulVec_of_transpose_mulVec_eq_zero
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (z x : ι → ℝ) (hz : A.transpose *ᵥ z = 0) :
    dotProduct z (NormedSpace.exp A *ᵥ x) = dotProduct z x := by
  calc
    dotProduct z (NormedSpace.exp A *ᵥ x) =
        dotProduct x ((NormedSpace.exp A).transpose *ᵥ z) := by
      simpa using Matrix.dotProduct_transpose_mulVec
        (A := (NormedSpace.exp A).transpose) (x := z) (y := x)
    _ = dotProduct x (NormedSpace.exp A.transpose *ᵥ z) := by
      rw [Matrix.exp_transpose]
    _ = dotProduct x z := by
      rw [Matrix.exp_mulVec_of_mulVec_eq_zero A.transpose z hz]
    _ = dotProduct z x := dotProduct_comm _ _

end Matrix

namespace GaloisForLFunctions.HTGeometry

/-! ## Centered inradius and historical hull -/

/-- Centered inradius of an arbitrary subset of a normed real space. -/
def bellmanShorelineCenteredInradius
    {F : Type*} [NormedAddCommGroup F] (K : Set F) : ℝ≥0∞ :=
  ⨆ (r : ℝ≥0) (_ : Metric.closedBall (0 : F) (r : ℝ) ⊆ K), (r : ℝ≥0∞)

/-- A set contained in a nontrivial closed linear half-space has zero centered inradius. -/
theorem bellmanShorelineCenteredInradius_eq_zero_of_subset_halfspace
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {K : Set (ι → ℝ)} {n : ι → ℝ} (hn : n ≠ 0)
    (hK : K ⊆ {x | dotProduct n x ≤ 0}) :
    bellmanShorelineCenteredInradius K = 0 := by
  apply le_antisymm
  · rw [bellmanShorelineCenteredInradius]
    refine iSup_le fun r => iSup_le fun hr => ?_
    have hrzero : r = 0 := by
      apply NNReal.eq
      by_contra hrne
      have hrpos : 0 < (r : ℝ) := lt_of_le_of_ne r.property (Ne.symm hrne)
      have hnpos : 0 < ‖n‖ := norm_pos_iff.mpr hn
      let x : ι → ℝ := ((r : ℝ) / ‖n‖) • n
      have hxnorm : ‖x‖ = (r : ℝ) := by
        rw [show x = ((r : ℝ) / ‖n‖) • n from rfl, norm_smul, Real.norm_eq_abs,
          abs_of_pos (div_pos hrpos hnpos), div_mul_cancel₀ _ hnpos.ne']
      have hxball : x ∈ Metric.closedBall (0 : ι → ℝ) (r : ℝ) := by
        simp [Metric.mem_closedBall, dist_zero_right, hxnorm]
      have hdotnonneg : 0 ≤ dotProduct n n := by
        exact Finset.sum_nonneg fun i _ => mul_self_nonneg (n i)
      have hdotne : dotProduct n n ≠ 0 := fun h => hn (dotProduct_self_eq_zero.mp h)
      have hdotpos : 0 < dotProduct n n := lt_of_le_of_ne hdotnonneg (Ne.symm hdotne)
      have hxpos : 0 < dotProduct n x := by
        rw [show x = ((r : ℝ) / ‖n‖) • n from rfl, dotProduct_smul, smul_eq_mul]
        exact mul_pos (div_pos hrpos hnpos) hdotpos
      exact (not_lt_of_ge (hK (hr hxball))) hxpos
    simp [hrzero]
  · exact bot_le

/-- Historical generator consisting of origin and every nonnegative-age supplier. -/
def bellmanShorelineHistoryGenerator
    {F : Type*} [Zero F] (v : ℝ → F) : Set F :=
  insert 0 (Set.range fun tau : ℝ≥0 => v tau)

/-- Convex memory generated by origin and nonnegative-age suppliers. -/
def bellmanShorelineHistoryHull
    {ι : Type*} [Fintype ι] (v : ℝ → (ι → ℝ)) : Set (ι → ℝ) :=
  convexHull ℝ (bellmanShorelineHistoryGenerator v)

/-- Convergence of suppliers to origin at infinite age compactifies historical generator. -/
theorem bellmanShorelineHistoryGenerator_isCompact
    {F : Type*} [TopologicalSpace F] [T2Space F] [Zero F]
    (v : ℝ → F) (hcontinuous : Continuous fun tau : ℝ≥0 => v tau)
    (htendsto : Tendsto (fun tau : ℝ≥0 => v tau) atTop (𝓝 0)) :
    IsCompact (bellmanShorelineHistoryGenerator v) := by
  rw [bellmanShorelineHistoryGenerator]
  rw [← cocompact_eq_atTop] at htendsto
  exact htendsto.isCompact_insert_range_of_cocompact hcontinuous

/-- Paper's exponential supplier generator is compact at every phase. -/
theorem bellmanShorelineDiscountedHistoryGenerator_isCompact
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {kappa : ℝ} (hkappa : 0 < kappa) {omega : ℝ → E}
    (homega : Continuous omega) (hunit : ∀ s, ‖omega s‖ = 1) (sigma : ℝ) :
    IsCompact
      (bellmanShorelineHistoryGenerator
        (fun tau => bellmanShorelineDiscountedSupplier kappa omega sigma tau)) := by
  apply bellmanShorelineHistoryGenerator_isCompact
  · exact bellmanShorelineDiscountedSupplier_continuous kappa homega sigma
  · exact bellmanShorelineDiscountedSupplier_tendsto_atTop_zero
      hkappa omega hunit sigma

/-- A signed direction nonpositive on every historical supplier forces zero centered inradius. -/
theorem bellmanShorelineHistoryHull_centeredInradius_eq_zero
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (v : ℝ → (ι → ℝ))
    (h : ∃ n ≠ 0, ∀ tau : ℝ≥0, dotProduct n (v tau) ≤ 0) :
    bellmanShorelineCenteredInradius (bellmanShorelineHistoryHull v) = 0 := by
  obtain ⟨n, hn, hhalf⟩ := h
  apply bellmanShorelineCenteredInradius_eq_zero_of_subset_halfspace hn
  apply convexHull_min
  · rintro x (rfl | ⟨tau, rfl⟩)
    · simp
    · exact hhalf tau
  · exact convex_halfSpace_le (dotProductBilin ℝ ℝ n).isLinear 0

/-- Historical certificate theorem specialized to an actual exponentially discounted orbit.
Every exposed contact has an exact certificate of at most `N` origin-or-supplier atoms. -/
theorem bellmanShoreline_exponentialHistory_exposedCertificate
    {N : ℕ} {kappa : ℝ} (hkappa : 0 < kappa)
    {omega : ℝ → (Fin N → ℝ)} (homega : Continuous omega)
    (hunit : ∀ s, ‖omega s‖ = 1) (sigma : ℝ)
    {x n : Fin N → ℝ} {mu : ℝ}
    (hx : x ∈ closure (convexHull ℝ
      (bellmanShorelineHistoryGenerator
        (fun tau => bellmanShorelineDiscountedSupplier kappa omega sigma tau))))
    (hn : n ≠ 0)
    (hsupport : ∀ y ∈ bellmanShorelineHistoryGenerator
      (fun tau => bellmanShorelineDiscountedSupplier kappa omega sigma tau),
        dotProduct n y ≤ mu)
    (hcontact : dotProduct n x = mu) :
    ∃ (w : Fin N → ℝ) (z : Fin N → (Fin N → ℝ)),
      (∀ i, 0 ≤ w i) ∧ (∑ i, w i = 1) ∧
        (∀ i, z i ∈ bellmanShorelineExposedSlice
          (bellmanShorelineHistoryGenerator
            (fun tau => bellmanShorelineDiscountedSupplier kappa omega sigma tau)) n mu) ∧
          ∑ i, w i • z i = x := by
  apply bellmanShoreline_exists_exposed_atomic_of_mem_closure_convexHull
    (bellmanShorelineDiscountedHistoryGenerator_isCompact hkappa homega hunit sigma)
  · exact ⟨0, Set.mem_insert 0 _⟩
  · exact hx
  · exact hn
  · exact hsupport
  · exact hcontact

/-- Deadline lower bound and hull membership squeeze current point onto bottleneck support plane.
This is abstract core of paper's current-contact proposition. -/
theorem bellmanShoreline_currentContact_of_deadline
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    {H : Set F} (hcompact : IsCompact H) {p n : F}
    (hp : p ∈ H)
    (hdeadline : bellmanShorelineSupport H n ≤ inner ℝ n p) :
    inner ℝ n p = bellmanShorelineSupport H n := by
  apply le_antisymm
  · exact le_csSup
      (hcompact.bddAbove_image (continuous_const.inner continuous_id).continuousOn)
      ⟨p, hp, rfl⟩
  · exact hdeadline

/-- Current-contact equality is invariant under the paper's positive physical-time
normalization.  This bridges the normalized hull `H` back to the directional hull `K`. -/
theorem bellmanShoreline_currentContact_under_positive_rescaling
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    {a : ℝ} (ha : 0 < a) {K : Set F}
    (hcompact : IsCompact K) (hne : K.Nonempty) {omega n : F}
    (homega : omega ∈ K)
    (hdeadline :
      bellmanShorelineSupport ((fun x : F => a • x) '' K) n ≤ inner ℝ n (a • omega)) :
    inner ℝ n omega = bellmanShorelineSupport K n := by
  have heq := bellmanShoreline_currentContact_of_deadline
    (hcompact.image (continuous_const_smul a))
    (p := a • omega) (n := n) ⟨omega, homega, rfl⟩ hdeadline
  rw [bellmanShorelineSupport_image_smul ha hcompact hne n,
    real_inner_smul_right] at heq
  exact mul_left_cancel₀ ha.ne' heq

namespace RandomMixedGraph

/-- Every real skew-symmetric matrix in odd finite dimension has zero determinant. -/
theorem RealSkewSymmetricMatrix.det_eq_zero_of_odd
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RealSkewSymmetricMatrix ι) (hodd : Odd (Fintype.card ι)) :
    D.matrix.det = 0 := by
  have hdet := congrArg Matrix.det D.transpose_eq_neg
  rw [Matrix.det_transpose, Matrix.det_neg, hodd.neg_one_pow, neg_one_mul] at hdet
  linear_combination hdet / 2

/-- An odd-dimensional real skew generator has a nonzero fixed axis. -/
theorem RealSkewSymmetricMatrix.exists_nonzero_axis
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RealSkewSymmetricMatrix ι) (hodd : Odd (Fintype.card ι)) :
    ∃ z ≠ 0, D.matrix *ᵥ z = 0 := by
  exact Matrix.exists_mulVec_eq_zero_iff.mpr (D.det_eq_zero_of_odd hodd)

/-- A kernel axis of a real skew generator is orthogonal to every generated velocity. -/
theorem RealSkewSymmetricMatrix.axis_annihilates_velocity
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RealSkewSymmetricMatrix ι) {z : ι → ℝ}
    (hz : D.matrix *ᵥ z = 0) (x : ι → ℝ) :
    dotProduct z (D.matrix *ᵥ x) = 0 := by
  calc
    dotProduct z (D.matrix *ᵥ x) =
        dotProduct x (D.matrix.transpose *ᵥ z) := by
      simpa using Matrix.dotProduct_transpose_mulVec
        (A := D.matrix.transpose) (x := z) (y := x)
    _ = 0 := by
      rw [D.transpose_eq_neg, Matrix.neg_mulVec, hz, neg_zero, dotProduct_zero]

/-- Every kernel axis of a skew generator has constant projection along its matrix-exponential
orbit.  Thus an odd-dimensional fixed generator cannot rotate its initial state across both sides
of the axis hyperplane. -/
theorem RealSkewSymmetricMatrix.axis_projection_matrixExp
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RealSkewSymmetricMatrix ι) {z : ι → ℝ}
    (hz : D.matrix *ᵥ z = 0) (s : ℝ) (x : ι → ℝ) :
    dotProduct z (NormedSpace.exp (s • D.matrix) *ᵥ x) = dotProduct z x := by
  apply Matrix.dotProduct_exp_mulVec_of_transpose_mulVec_eq_zero
  rw [Matrix.transpose_smul, D.transpose_eq_neg, Matrix.smul_mulVec,
    Matrix.neg_mulVec, hz, neg_zero, smul_zero]

end RandomMixedGraph

/-- Constant projection onto one axis forces discounted memory into a closed half-space, after
choosing the sign of that axis. This is the geometric obstruction behind the paper's need for
precession in odd dimension. -/
theorem bellmanShoreline_fixedAxis_has_nonpositive_direction
    {ι : Type*} [Fintype ι]
    (omega : ℝ → (ι → ℝ)) (z : ι → ℝ) (c kappa sigma : ℝ)
    (hz : z ≠ 0) (haxis : ∀ s, dotProduct z (omega s) = c) :
    ∃ n ≠ 0, ∀ tau,
      dotProduct n (bellmanShorelineDiscountedSupplier kappa omega sigma tau) ≤ 0 := by
  by_cases hc : c ≤ 0
  · refine ⟨z, hz, fun tau => ?_⟩
    rw [bellmanShorelineDiscountedSupplier, dotProduct_smul, haxis]
    exact mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le hc
  · refine ⟨-z, neg_ne_zero.mpr hz, fun tau => ?_⟩
    rw [bellmanShorelineDiscountedSupplier, dotProduct_smul, neg_dotProduct, haxis]
    exact mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le
      (neg_nonpos.mpr (le_of_not_ge hc))

/-- Full odd-dimensional fixed-generator obstruction from the paper: a single real
skew-symmetric generator always leaves one signed direction nonpositive along the entire
discounted supplier curve. -/
theorem bellmanShoreline_odd_fixedGenerator_obstruction
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RandomMixedGraph.RealSkewSymmetricMatrix ι)
    (hodd : Odd (Fintype.card ι)) (omega0 : ι → ℝ) (kappa sigma : ℝ) :
    ∃ n ≠ 0, ∀ tau,
      dotProduct n
        (bellmanShorelineDiscountedSupplier kappa
          (fun s => NormedSpace.exp (s • D.matrix) *ᵥ omega0) sigma tau) ≤ 0 := by
  obtain ⟨z, hz, hkernel⟩ := D.exists_nonzero_axis hodd
  apply bellmanShoreline_fixedAxis_has_nonpositive_direction
    (omega := fun s => NormedSpace.exp (s • D.matrix) *ᵥ omega0)
    z (dotProduct z omega0) kappa sigma hz
  intro s
  exact D.axis_projection_matrixExp hkernel s omega0

/-- Exact centered-inradius conclusion of the paper's odd fixed-generator proposition. -/
theorem bellmanShoreline_odd_fixedGenerator_centeredInradius_eq_zero
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D : RandomMixedGraph.RealSkewSymmetricMatrix ι)
    (hodd : Odd (Fintype.card ι)) (omega0 : ι → ℝ) (kappa sigma : ℝ) :
    bellmanShorelineCenteredInradius
      (bellmanShorelineHistoryHull
        (fun tau => bellmanShorelineDiscountedSupplier kappa
          (fun s => NormedSpace.exp (s • D.matrix) *ᵥ omega0) sigma tau)) = 0 := by
  apply bellmanShorelineHistoryHull_centeredInradius_eq_zero
  obtain ⟨n, hn, hhalf⟩ :=
    bellmanShoreline_odd_fixedGenerator_obstruction D hodd omega0 kappa sigma
  exact ⟨n, hn, fun tau => hhalf tau⟩

/-- Reflection symmetrization retains every centered interval already admitted by the original
exponential-character domain. -/
theorem symmetricInradius_characterDomain_conv_reflect
    {mu : Measure ℝ} [SFinite mu] (hmu : mu ≠ 0) {r : ℝ≥0}
    (hr : Set.Icc (-(r : ℝ)) (r : ℝ) ⊆ characterDomain mu) :
    (r : ℝ≥0∞) ≤ symmetricInradius (characterDomain (mu ∗ reflectMeasure mu)) := by
  apply le_symmetricInradius
  rw [characterDomain_conv_reflect hmu]
  intro s hs
  refine ⟨hr hs, ?_⟩
  rw [Set.mem_neg]
  apply hr
  constructor <;> linarith [hs.1, hs.2]

/-- Multiplication by a nonnegative exponential discount commutes with the finite-layer max-plus
Bellman reporter. -/
theorem discounted_sSup_image_reachSet_succ
    {X Gamma : Type*} [Finite Gamma] [Nonempty Gamma]
    {act : Gamma → X → X} {chi : X} {pair : X → X → ℝ} {pull : Gamma → X → X}
    (hpair : ∀ (g : Gamma) (z v : X), pair (act g z) v = pair z (pull g v))
    (a : ℝ) (ha : 0 ≤ a) (s : ℕ) (v : X) :
    a * sSup ((fun z => pair z v) '' HTGeometry.reachSet act chi (s + 1)) =
      max (a * sSup ((fun z => pair z v) '' HTGeometry.reachSet act chi s))
        (⨆ g : Gamma,
          a * sSup ((fun z => pair z (pull g v)) '' HTGeometry.reachSet act chi s)) := by
  rw [HTGeometry.sSup_image_reachSet_succ hpair s v,
    mul_max_of_nonneg _ _ ha,
    HTGeometry.Monotone.map_ciSup_of_finite
      (fun _ _ h => mul_le_mul_of_nonneg_left h ha)]

/-- Exponential memory discount preserves corpus's exact unitary-overlap Bellman recursion. -/
theorem exponentiallyDiscounted_sSup_unitaryOverlap_reachSet_succ
    {Gamma V : Type*} [Finite Gamma] [Nonempty Gamma]
    [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    (u : Gamma → (V ≃ₗᵢ[ℂ] V)) (chi : V)
    (kappa tau : ℝ) (s : ℕ) (v : V) :
    Real.exp (-kappa * tau) *
        sSup ((fun z => ‖(inner ℂ z v : ℂ)‖ ^ 2) ''
          HTGeometry.reachSet (fun g => (u g : V → V)) chi (s + 1)) =
      max
        (Real.exp (-kappa * tau) *
          sSup ((fun z => ‖(inner ℂ z v : ℂ)‖ ^ 2) ''
            HTGeometry.reachSet (fun g => (u g : V → V)) chi s))
        (⨆ g : Gamma, Real.exp (-kappa * tau) *
          sSup ((fun z => ‖(inner ℂ z ((u g).symm v) : ℂ)‖ ^ 2) ''
            HTGeometry.reachSet (fun g => (u g : V → V)) chi s)) := by
  apply discounted_sSup_image_reachSet_succ
    (act := fun g => (u g : V → V))
    (pair := fun z w => ‖(inner ℂ z w : ℂ)‖ ^ 2)
    (pull := fun g w => (u g).symm w)
    (a := Real.exp (-kappa * tau)) (s := s) (v := v)
  · intro g z w
    have hinner : (inner ℂ ((u g) z) w : ℂ) =
        (inner ℂ z ((u g).symm w) : ℂ) := by
      conv_lhs => rw [← (u g).apply_symm_apply w]
      exact (u g).inner_map_map z ((u g).symm w)
    rw [hinner]
  · exact (Real.exp_pos _).le

end GaloisForLFunctions.HTGeometry

