import GaloisForLFunctions.HTGeometry.SquareMatrixCokernelAnnihilator
import GaloisForLFunctions.HTGeometry.SmithNormalFormDVR
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-!
# The cokernel annihilator of a corank-one matrix is its determinant ideal

`JacobianKaehlerAnnihilator.jacobian_smul_kaehler_eq_zero` already gives one inclusion of the
Jacobian–different bridge: a square presentation's Jacobian annihilates the relative differentials.
This file supplies the reverse inclusion over a discrete valuation ring.

Smith normal form (`SmithNormalFormDVR.exists_smithNormalForm`) writes `U M V = diagonal d` with
`U`, `V` of unit determinant.  Equivalent matrices have equal cokernel annihilators, and for a
diagonal matrix that annihilator is entrywise divisibility.  Reducing modulo the maximal ideal,
`Matrix.rank_diagonal` counts the unit entries, so corank one of the reduction leaves exactly one
non-unit among the elementary divisors — and then the intersection of the divisibility conditions
collapses onto their product:

```text
mem_range_diagonal_mulVecLin_iff, mem_annihilator_coker_diagonal_iff
prod_associated_of_unique_nonunit, annihilator_coker_diagonal_eq_span_det
mulVec_left_cancel, mem_annihilator_coker_iff, annihilator_coker_eq_of_unit_equiv
residue_eq_zero_iff_not_isUnit
annihilator_coker_eq_span_det_of_corank_one
    ** corank one  ⟹  Ann (coker M) = (det M) **
```

Read at a place of a finite extension, with the cotangent module presented by the Jacobian, this
says the different is generated by the Jacobian — so its divisorial order is the order of the
Jacobian, and a Jacobian of order one is a simple fold.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

variable {B : Type*} [CommRing B] {n : ℕ}

/-- The range of a diagonal matrix is the set of vectors divisible entrywise. -/
theorem mem_range_diagonal_mulVecLin_iff (d w : Fin n → B) :
    w ∈ LinearMap.range (Matrix.diagonal d).mulVecLin ↔ ∀ i, d i ∣ w i := by
  constructor
  · rintro ⟨v, rfl⟩ i
    exact ⟨v i, by simp [Matrix.mulVec, dotProduct, Matrix.diagonal_apply]⟩
  · intro h
    choose c hc using h
    refine ⟨c, ?_⟩
    funext i
    rw [Matrix.mulVecLin_apply]
    simp only [Matrix.mulVec, dotProduct, Matrix.diagonal_apply, ite_mul, zero_mul,
      Finset.sum_ite_eq, Finset.mem_univ, if_true]
    exact (hc i).symm

/-- An element annihilates the cokernel of a diagonal matrix exactly when every diagonal entry
divides it. -/
theorem mem_annihilator_coker_diagonal_iff (d : Fin n → B) (x : B) :
    x ∈ Module.annihilator B
        ((Fin n → B) ⧸ LinearMap.range (Matrix.diagonal d).mulVecLin) ↔ ∀ i, d i ∣ x := by
  constructor
  · intro hx i
    have h := Module.mem_annihilator.mp hx (Submodule.Quotient.mk 1)
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h
    have := (mem_range_diagonal_mulVecLin_iff d (x • (1 : Fin n → B))).mp h i
    simpa using this
  · intro h
    refine Module.mem_annihilator.mpr fun q => ?_
    obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    refine (mem_range_diagonal_mulVecLin_iff d (x • v)).mpr fun i => ?_
    exact Dvd.dvd.mul_right (h i) (v i)

/-- With a single non-unit among them, the product of a family is associated to that entry. -/
theorem prod_associated_of_unique_nonunit (d : Fin n → B) (j : Fin n)
    (h : ∀ i, i ≠ j → IsUnit (d i)) : Associated (∏ i, d i) (d j) := by
  classical
  have hsplit : ∏ i, d i = d j * ∏ i ∈ Finset.univ.erase j, d i := by
    rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ j)]
    ring
  have hunit : IsUnit (∏ i ∈ Finset.univ.erase j, d i) := by
    refine Finset.prod_induction _ IsUnit (fun a b => IsUnit.mul) isUnit_one ?_
    intro i hi
    exact h i (Finset.ne_of_mem_erase hi)
  obtain ⟨u, hu⟩ := hunit
  refine ⟨u⁻¹, ?_⟩
  rw [hsplit, ← hu, mul_assoc, Units.mul_inv, mul_one]

/-- **The annihilator of a diagonal cokernel with one non-unit entry is the determinant ideal.** -/
theorem annihilator_coker_diagonal_eq_span_det (d : Fin n → B) (j : Fin n)
    (h : ∀ i, i ≠ j → IsUnit (d i)) :
    Module.annihilator B
        ((Fin n → B) ⧸ LinearMap.range (Matrix.diagonal d).mulVecLin)
      = Ideal.span {(Matrix.diagonal d).det} := by
  have hdet : Associated (Matrix.diagonal d).det (d j) := by
    rw [Matrix.det_diagonal]
    exact prod_associated_of_unique_nonunit d j h
  apply le_antisymm
  · intro y hy
    have hyd : d j ∣ y := (mem_annihilator_coker_diagonal_iff d y).mp hy j
    exact Ideal.mem_span_singleton.mpr (hdet.dvd.trans hyd)
  · intro y hy
    have hdy : (Matrix.diagonal d).det ∣ y := Ideal.mem_span_singleton.mp hy
    refine (mem_annihilator_coker_diagonal_iff d y).mpr fun i => ?_
    rcases eq_or_ne i j with rfl | hij
    · exact hdet.symm.dvd.trans hdy
    · exact (h i hij).dvd

/-- An invertible matrix can be cancelled from a matrix-vector equation. -/
theorem mulVec_left_cancel {U : Matrix (Fin n) (Fin n) B}
    (hU : IsUnit U.det) {a b : Fin n → B} (h : U *ᵥ a = U *ᵥ b) : a = b := by
  have hres := congrArg (fun y => U⁻¹ *ᵥ y) h
  simpa [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul U hU, Matrix.one_mulVec] using hres

/-- Membership in the annihilator of a cokernel, spelled with vectors. -/
theorem mem_annihilator_coker_iff (M : Matrix (Fin n) (Fin n) B) (x : B) :
    x ∈ Module.annihilator B ((Fin n → B) ⧸ LinearMap.range M.mulVecLin)
      ↔ ∀ v : Fin n → B, ∃ w, M *ᵥ w = x • v := by
  constructor
  · intro hx v
    have h := Module.mem_annihilator.mp hx (Submodule.Quotient.mk v)
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h
    obtain ⟨w, hw⟩ := h
    exact ⟨w, by simpa [Matrix.mulVecLin_apply] using hw⟩
  · intro h
    refine Module.mem_annihilator.mpr fun q => ?_
    obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    obtain ⟨w, hw⟩ := h v
    exact ⟨w, by simpa [Matrix.mulVecLin_apply] using hw⟩

/-- **Equivalent matrices have the same cokernel annihilator.** -/
theorem annihilator_coker_eq_of_unit_equiv
    {M D U V : Matrix (Fin n) (Fin n) B}
    (hU : IsUnit U.det) (hV : IsUnit V.det) (h : U * M * V = D) :
    Module.annihilator B ((Fin n → B) ⧸ LinearMap.range M.mulVecLin)
      = Module.annihilator B ((Fin n → B) ⧸ LinearMap.range D.mulVecLin) := by
  have hUinv : U * U⁻¹ = 1 := Matrix.mul_nonsing_inv U hU
  have hUinv' : U⁻¹ * U = 1 := Matrix.nonsing_inv_mul U hU
  have hVinv : V * V⁻¹ = 1 := Matrix.mul_nonsing_inv V hV
  ext x
  rw [mem_annihilator_coker_iff, mem_annihilator_coker_iff]
  constructor
  · intro hx v
    obtain ⟨w₀, hw₀⟩ := hx (U⁻¹ *ᵥ v)
    refine ⟨V⁻¹ *ᵥ w₀, ?_⟩
    rw [← h]
    calc (U * M * V) *ᵥ (V⁻¹ *ᵥ w₀)
        = (U * M * V * V⁻¹) *ᵥ w₀ := by rw [Matrix.mulVec_mulVec]
      _ = (U * M) *ᵥ w₀ := by rw [Matrix.mul_assoc, hVinv, Matrix.mul_one]
      _ = U *ᵥ (M *ᵥ w₀) := by rw [Matrix.mulVec_mulVec]
      _ = U *ᵥ (x • (U⁻¹ *ᵥ v)) := by rw [hw₀]
      _ = x • ((U * U⁻¹) *ᵥ v) := by rw [← Matrix.mulVec_mulVec, Matrix.mulVec_smul]
      _ = x • v := by rw [hUinv, Matrix.one_mulVec]
  · intro hx v
    obtain ⟨w₀, hw₀⟩ := hx (U *ᵥ v)
    refine ⟨V *ᵥ w₀, ?_⟩
    have hchain : U *ᵥ (M *ᵥ (V *ᵥ w₀)) = U *ᵥ (x • v) := by
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, h, hw₀, Matrix.mulVec_smul]
    exact mulVec_left_cancel hU hchain

section DVR

variable [IsDomain B] [IsDiscreteValuationRing B]

/-- Reduction detects non-units. -/
theorem residue_eq_zero_iff_not_isUnit (b : B) :
    IsLocalRing.residue B b = 0 ↔ ¬ IsUnit b := by
  rw [IsLocalRing.residue_eq_zero_iff]
  constructor
  · intro hb hu
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hb
  · intro hb
    by_contra hc
    exact hb (IsLocalRing.notMem_maximalIdeal.mp hc)

/-- **The annihilator of the cokernel is the determinant ideal, at corank one.** -/
theorem annihilator_coker_eq_span_det_of_corank_one
    (M : Matrix (Fin n) (Fin n) B)
    (hrank : (M.map (IsLocalRing.residue B)).rank + 1 = n) :
    Module.annihilator B ((Fin n → B) ⧸ LinearMap.range M.mulVecLin)
      = Ideal.span {M.det} := by
  classical
  obtain ⟨U, V, d, hU, hV, hUMV, -⟩ := exists_smithNormalForm M
  set ρ := IsLocalRing.residue B with hρ
  have hmapmul : (U.map ρ) * (M.map ρ) * (V.map ρ) = (Matrix.diagonal d).map ρ := by
    rw [← Matrix.map_mul, ← Matrix.map_mul, hUMV]
  have hdiagmap : (Matrix.diagonal d).map ρ = Matrix.diagonal (fun i => ρ (d i)) := by
    ext i j
    by_cases hij : i = j <;> simp [hij]
  have hUdet : IsUnit ((U.map ρ).det) := by
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hU.map ρ
  have hVdet : IsUnit ((V.map ρ).det) := by
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hV.map ρ
  have hrankeq : (Matrix.diagonal fun i => ρ (d i)).rank = (M.map ρ).rank := by
    rw [← hdiagmap, ← hmapmul, Matrix.rank_mul_eq_left_of_isUnit_det _ _ hVdet,
      Matrix.rank_mul_eq_right_of_isUnit_det _ _ hUdet]
  have hcard : Fintype.card {i : Fin n // ρ (d i) ≠ 0} + 1 = n := by
    rw [← Matrix.rank_diagonal (fun i => ρ (d i)), hrankeq]
    exact hrank
  have hcompl : Fintype.card {i : Fin n // ¬ (ρ (d i) ≠ 0)} = 1 := by
    have := Fintype.card_subtype_compl (fun i : Fin n => ρ (d i) ≠ 0)
    simp only [Fintype.card_fin] at this
    omega
  obtain ⟨j, hj⟩ := Fintype.card_eq_one_iff.mp hcompl
  have hjnonunit : ¬ IsUnit (d j) :=
    (residue_eq_zero_iff_not_isUnit (d j)).mp (not_not.mp j.2)
  have hother : ∀ i, i ≠ j.1 → IsUnit (d i) := by
    intro i hi
    by_contra hc
    have : (⟨i, not_not.mpr ((residue_eq_zero_iff_not_isUnit (d i)).mpr hc)⟩ :
        {i : Fin n // ¬ (ρ (d i) ≠ 0)}) = j := hj _
    exact hi (congrArg Subtype.val this)
  have hdiagann := annihilator_coker_diagonal_eq_span_det d j.1 hother
  have hann : Module.annihilator B ((Fin n → B) ⧸ LinearMap.range M.mulVecLin)
      = Module.annihilator B
        ((Fin n → B) ⧸ LinearMap.range (Matrix.diagonal d).mulVecLin) :=
    annihilator_coker_eq_of_unit_equiv hU hV hUMV
  rw [hann, hdiagann]
  have hdetassoc : Associated M.det (Matrix.diagonal d).det := by
    obtain ⟨u, hu⟩ := hU
    obtain ⟨v, hv⟩ := hV
    refine ⟨u * v, ?_⟩
    have := congrArg Matrix.det hUMV
    rw [Matrix.det_mul, Matrix.det_mul, ← hu, ← hv] at this
    rw [← this]
    push_cast
    ring
  apply le_antisymm
  · exact Ideal.span_singleton_le_span_singleton.mpr hdetassoc.dvd
  · exact Ideal.span_singleton_le_span_singleton.mpr hdetassoc.symm.dvd

end DVR

end GaloisForLFunctions.HTGeometry
