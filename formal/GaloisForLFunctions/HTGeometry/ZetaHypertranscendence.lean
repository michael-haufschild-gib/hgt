import GaloisForLFunctions.HTGeometry.ZetaInvGammaField
import GaloisForLFunctions.HTGeometry.JetHypertranscendenceBridge

/-!
# Zeta, Dirichlet `L`-functions, and their reciprocals are hypertranscendental over the Gamma field

The finite phase law excludes every differential relation over `ℂ(s)⟨Γ⟩` for `ζ` and for every
Dirichlet `L`-function, and inversion carries that exclusion to their reciprocals.  Read through the
jet-relation characterisation of hypertranscendence, the four statements become statements about the
differential field generated by `Γ`: none of the four functions is differentially algebraic over it,
so in particular none of them lies in it.
-/

open Filter Set Topology Function

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance zetaHtDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance zetaHtIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance zetaHtDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance zetaHtComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance zetaHtRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

local instance zetaHtRatFuncDifferential : Differential (RatFunc ℂ) :=
  ratFuncCoordinateDifferential

local instance zetaHtRatFuncDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncDifferentialAlgebra

local instance zetaHtGammaFieldDifferentialAlgebra :
    DifferentialAlgebra
      ↥(differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField))
      upperEndMeroField where
  deriv_algebraMap _ := rfl

/-- The differential field generated by `Γ` over the rational coordinate field, inside the upper-end
meromorphic carrier: the coefficient field of the finite phase law. -/
abbrev gammaCoefficientField : IntermediateField (RatFunc ℂ) upperEndMeroField :=
  differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField)

/-- An element hypertranscendental over the Gamma field does not belong to it. -/
theorem not_mem_gammaCoefficientField_of_hypertranscendental {u : upperEndMeroField}
    (h : HypertranscendentalOver ↥gammaCoefficientField u) : u ∉ gammaCoefficientField := by
  intro hmem
  refine not_mem_range_algebraMap_of_algebraicIndependent_jets
    ((hypertranscendentalOver_iff_algebraicIndependent_jets u).mp h) ?_
  exact ⟨⟨u, hmem⟩, rfl⟩

/-- **Zeta is hypertranscendental over the Gamma field.** -/
theorem zeta_hypertranscendentalOver_gammaCoefficientField {σ : ℝ} (hσ : 1 < σ) :
    HypertranscendentalOver ↥gammaCoefficientField
      (algebraMap upperEndAnalyticSubring upperEndMeroField zetaUpperAnalytic) := by
  refine hypertranscendentalOver_of_no_jet_relation ?_
  intro n N hN e he c hc
  exact zeta_no_gammaField_field_relation hσ hN e he
    (fun α => algebraMap ↥gammaCoefficientField upperEndMeroField (c α))
    (fun α => (c α).2) (fun α h0 => hc α (Subtype.ext h0))

/-- **The reciprocal of zeta is hypertranscendental over the Gamma field.** -/
theorem zetaInv_hypertranscendentalOver_gammaCoefficientField {σ : ℝ} (hσ : 1 < σ) :
    HypertranscendentalOver ↥gammaCoefficientField
      (algebraMap upperEndAnalyticSubring upperEndMeroField zetaUpperAnalytic)⁻¹ :=
  hypertranscendentalOver_inv zetaMero_ne_zero
    (zeta_hypertranscendentalOver_gammaCoefficientField hσ)

/-- Zeta does not lie in the differential field generated by `Γ`. -/
theorem zetaMero_not_mem_gammaCoefficientField {σ : ℝ} (hσ : 1 < σ) :
    algebraMap upperEndAnalyticSubring upperEndMeroField zetaUpperAnalytic
      ∉ gammaCoefficientField :=
  not_mem_gammaCoefficientField_of_hypertranscendental
    (zeta_hypertranscendentalOver_gammaCoefficientField hσ)

/-- The reciprocal of zeta does not lie in the differential field generated by `Γ`. -/
theorem zetaInvMero_not_mem_gammaCoefficientField {σ : ℝ} (hσ : 1 < σ) :
    (algebraMap upperEndAnalyticSubring upperEndMeroField zetaUpperAnalytic)⁻¹
      ∉ gammaCoefficientField :=
  not_mem_gammaCoefficientField_of_hypertranscendental
    (zetaInv_hypertranscendentalOver_gammaCoefficientField hσ)

variable {q : ℕ} [NeZero q]

/-- **Every Dirichlet `L`-function is hypertranscendental over the Gamma field.** -/
theorem lfunction_hypertranscendentalOver_gammaCoefficientField (χ : DirichletCharacter ℂ q)
    {σ : ℝ} (hσ : 1 < σ) :
    HypertranscendentalOver ↥gammaCoefficientField
      (algebraMap upperEndAnalyticSubring upperEndMeroField (lfunctionUpperAnalytic χ)) := by
  refine hypertranscendentalOver_of_no_jet_relation ?_
  intro n N hN e he c hc
  exact lfunction_no_gammaField_field_relation χ hσ hN e he
    (fun α => algebraMap ↥gammaCoefficientField upperEndMeroField (c α))
    (fun α => (c α).2) (fun α h0 => hc α (Subtype.ext h0))

/-- **The reciprocal of every Dirichlet `L`-function is hypertranscendental over the Gamma
field.** -/
theorem lfunctionInv_hypertranscendentalOver_gammaCoefficientField (χ : DirichletCharacter ℂ q)
    {σ : ℝ} (hσ : 1 < σ) :
    HypertranscendentalOver ↥gammaCoefficientField
      (algebraMap upperEndAnalyticSubring upperEndMeroField (lfunctionUpperAnalytic χ))⁻¹ :=
  hypertranscendentalOver_inv (lfunctionMero_ne_zero χ)
    (lfunction_hypertranscendentalOver_gammaCoefficientField χ hσ)

/-- A Dirichlet `L`-function does not lie in the differential field generated by `Γ`. -/
theorem lfunctionMero_not_mem_gammaCoefficientField (χ : DirichletCharacter ℂ q) {σ : ℝ}
    (hσ : 1 < σ) :
    algebraMap upperEndAnalyticSubring upperEndMeroField (lfunctionUpperAnalytic χ)
      ∉ gammaCoefficientField :=
  not_mem_gammaCoefficientField_of_hypertranscendental
    (lfunction_hypertranscendentalOver_gammaCoefficientField χ hσ)

/-- The reciprocal of a Dirichlet `L`-function does not lie in the differential field generated by
`Γ`. -/
theorem lfunctionInvMero_not_mem_gammaCoefficientField (χ : DirichletCharacter ℂ q) {σ : ℝ}
    (hσ : 1 < σ) :
    (algebraMap upperEndAnalyticSubring upperEndMeroField (lfunctionUpperAnalytic χ))⁻¹
      ∉ gammaCoefficientField :=
  not_mem_gammaCoefficientField_of_hypertranscendental
    (lfunctionInv_hypertranscendentalOver_gammaCoefficientField χ hσ)

end

end GaloisForLFunctions.HTGeometry
