import GaloisForLFunctions.HTGeometry.ConstitutiveCompetitivePathVariation
import GaloisForLFunctions.HTGeometry.PrimeBooleanMassHankelQuantumFusion
import Mathlib.Tactic

/-!
# Constitutive tropical-projective work

A finite family of exact constitutive actions produces mandatory work by taking the largest
available increment.  Forward-plus-reverse work is the projective width of the family of
increments.  It vanishes exactly when every relative action is unchanged, and those relative
actions descend through an observer exactly when all observer-collapsed widths vanish.

This is the multi-parent extension of competitive two-action variation.  It also gives a closed
history conservation law: after one parent is chosen as reference, mandatory work is its exact
endpoint change plus a nonnegative tropical relative-work term.
-/

namespace GaloisForLFunctions.HTGeometry

variable {X P : Type*}

/-- Mandatory work generated by a nonempty finite family of exact actions. -/
noncomputable def constitutiveFamilyWork [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (x y : X) : ℝ :=
  let increments := Finset.univ.image (fun p => constitutiveExactWork (A p) x y)
  increments.max' (Finset.univ_nonempty.image _)

/-- Forward-plus-reverse family work: the tropical projective width of the action increment
packet. -/
noncomputable def constitutiveFamilyWidth [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (x y : X) : ℝ :=
  constitutiveFamilyWork A x y + constitutiveFamilyWork A y x

/-- Relative action profile in the affine chart selected by a reference parent. -/
def constitutiveRelativeProfile (A : P → X → ℝ) (p₀ : P) (x : X) : P → ℝ :=
  fun p => A p x - A p₀ x

/-- Every parent increment is bounded above by mandatory family work. -/
theorem constitutiveExactWork_le_familyWork [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p : P) (x y : X) :
    constitutiveExactWork (A p) x y ≤ constitutiveFamilyWork A x y := by
  unfold constitutiveFamilyWork
  apply Finset.le_max'
  exact Finset.mem_image.mpr ⟨p, Finset.mem_univ p, rfl⟩

/-- A parent which dominates every increment realizes the family maximum. -/
theorem constitutiveFamilyWork_eq_of_dominates [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p₀ : P) (x y : X)
    (hmax : ∀ p, constitutiveExactWork (A p) x y ≤ constitutiveExactWork (A p₀) x y) :
    constitutiveFamilyWork A x y = constitutiveExactWork (A p₀) x y := by
  apply le_antisymm
  · unfold constitutiveFamilyWork
    apply Finset.max'_le
    intro z hz
    obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hz
    exact hmax p
  · exact constitutiveExactWork_le_familyWork A p₀ x y

/-- The family width is nonnegative. -/
theorem constitutiveFamilyWidth_nonneg [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (x y : X) :
    0 ≤ constitutiveFamilyWidth A x y := by
  have hxy := constitutiveExactWork_le_familyWork A (Classical.choice inferInstance) x y
  have hyx := constitutiveExactWork_le_familyWork A (Classical.choice inferInstance) y x
  simp only [constitutiveFamilyWidth, constitutiveExactWork] at *
  linarith

/-- **Tropical projective zero law.** Width vanishes exactly when all parent increments agree. -/
theorem constitutiveFamilyWidth_eq_zero_iff [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (x y : X) :
    constitutiveFamilyWidth A x y = 0 ↔
      ∀ p q, constitutiveExactWork (A p) x y = constitutiveExactWork (A q) x y := by
  constructor
  · intro hzero p q
    have hp := constitutiveExactWork_le_familyWork A p x y
    have hq := constitutiveExactWork_le_familyWork A q y x
    have hqp := constitutiveExactWork_le_familyWork A q x y
    have hp' := constitutiveExactWork_le_familyWork A p y x
    simp only [constitutiveFamilyWidth, constitutiveExactWork] at hzero hp hq hqp hp'
    simp only [constitutiveExactWork]
    linarith
  · intro hall
    let p₀ : P := Classical.choice inferInstance
    have hforward : constitutiveFamilyWork A x y = constitutiveExactWork (A p₀) x y :=
      constitutiveFamilyWork_eq_of_dominates A p₀ x y (fun p => (hall p p₀).le)
    have hbackward : constitutiveFamilyWork A y x = constitutiveExactWork (A p₀) y x := by
      apply constitutiveFamilyWork_eq_of_dominates A p₀ y x
      intro p
      simp only [constitutiveExactWork]
      have hp := hall p p₀
      simp only [constitutiveExactWork] at hp
      linarith
    rw [constitutiveFamilyWidth, hforward, hbackward]
    simp [constitutiveExactWork]

/-- Width is symmetric. -/
theorem constitutiveFamilyWidth_comm [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (x y : X) :
    constitutiveFamilyWidth A x y = constitutiveFamilyWidth A y x := by
  simp only [constitutiveFamilyWidth]
  ring

/-- Adding a common scalar potential changes family work only by its exact increment. -/
theorem constitutiveFamilyWork_add_common_potential [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (C : X → ℝ) (x y : X) :
    constitutiveFamilyWork (fun p z => A p z + C z) x y =
      constitutiveExactWork C x y + constitutiveFamilyWork A x y := by
  let p₀ : P := Classical.choice inferInstance
  obtain ⟨pmax, -, hpmax⟩ := Finset.mem_image.mp
    (Finset.max'_mem
      (Finset.univ.image (fun p => constitutiveExactWork (A p) x y))
      (Finset.univ_nonempty.image _))
  have hmax : ∀ p, constitutiveExactWork (A p) x y ≤ constitutiveExactWork (A pmax) x y := by
    intro p
    calc
      constitutiveExactWork (A p) x y ≤ constitutiveFamilyWork A x y :=
        constitutiveExactWork_le_familyWork A p x y
      _ = constitutiveExactWork (A pmax) x y := hpmax.symm
  have hshift : ∀ p,
      constitutiveExactWork (fun z => A p z + C z) x y =
        constitutiveExactWork C x y + constitutiveExactWork (A p) x y := by
    intro p
    simp only [constitutiveExactWork]
    ring
  have hshiftmax : ∀ p,
      constitutiveExactWork (fun z => A p z + C z) x y ≤
        constitutiveExactWork (fun z => A pmax z + C z) x y := by
    intro p
    rw [hshift, hshift]
    linarith [hmax p]
  rw [constitutiveFamilyWork_eq_of_dominates
      (fun p z => A p z + C z) pmax x y hshiftmax,
    constitutiveFamilyWork_eq_of_dominates A pmax x y hmax, hshift]

/-- Projective width is invariant under a common scalar-presentation change. -/
theorem constitutiveFamilyWidth_add_common_potential [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (C : X → ℝ) (x y : X) :
    constitutiveFamilyWidth (fun p z => A p z + C z) x y =
      constitutiveFamilyWidth A x y := by
  rw [constitutiveFamilyWidth, constitutiveFamilyWork_add_common_potential,
    constitutiveFamilyWork_add_common_potential, constitutiveFamilyWidth]
  simp only [constitutiveExactWork]
  ring

/-- Relative tropical work after choosing one parent as affine reference. -/
noncomputable def constitutiveRelativeFamilyWork [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p₀ : P) (x y : X) : ℝ :=
  constitutiveFamilyWork A x y - constitutiveExactWork (A p₀) x y

/-- Relative tropical work is nonnegative because the reference increment is one candidate. -/
theorem constitutiveRelativeFamilyWork_nonneg [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p₀ : P) (x y : X) :
    0 ≤ constitutiveRelativeFamilyWork A p₀ x y := by
  unfold constitutiveRelativeFamilyWork
  exact sub_nonneg.mpr (constitutiveExactWork_le_familyWork A p₀ x y)

/-- **Reference conservation law.** Mandatory work is exact reference work plus relative tropical
work. -/
theorem constitutiveFamilyWork_conservation [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p₀ : P) (x y : X) :
    constitutiveFamilyWork A x y =
      constitutiveExactWork (A p₀) x y + constitutiveRelativeFamilyWork A p₀ x y := by
  unfold constitutiveRelativeFamilyWork
  ring

/-- The conservation law extends to every finite history. -/
theorem constitutiveFamilyPathWork_conservation [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (p₀ : P) (xs : List X) :
    constitutivePathWork (constitutiveFamilyWork A) xs =
      constitutiveEndpointChange (A p₀) xs +
        constitutivePathWork (constitutiveRelativeFamilyWork A p₀) xs := by
  have hfun : constitutiveFamilyWork A = fun x y =>
      constitutiveExactWork (A p₀) x y + constitutiveRelativeFamilyWork A p₀ x y := by
    funext x y
    exact constitutiveFamilyWork_conservation A p₀ x y
  rw [hfun, constitutivePathWork_add, constitutivePathWork_exact]

/-- Closed multi-parent histories have nonnegative mandatory work. -/
theorem constitutiveFamilyPathWork_nonneg_of_closed [Fintype P] [Nonempty P]
    (A : P → X → ℝ) {xs : List X} (hxs : ConstitutiveClosedPath xs) :
    0 ≤ constitutivePathWork (constitutiveFamilyWork A) xs := by
  let p₀ : P := Classical.choice inferInstance
  rw [constitutiveFamilyPathWork_conservation A p₀ xs,
    constitutiveEndpointChange_eq_zero_of_closed (A p₀) hxs, zero_add]
  clear hxs
  induction xs with
  | nil => simp [constitutivePathWork]
  | cons x xs ih =>
      cases xs with
      | nil => simp [constitutivePathWork]
      | cons y ys =>
          simp only [constitutivePathWork]
          exact add_nonneg (constitutiveRelativeFamilyWork_nonneg A p₀ x y) ih

/-- **Observer memory law.** A reference-chart projective profile descends through an observer
exactly when every observer-collapsed family two-cycle has zero width. -/
theorem relativeProfile_factorsThroughRange_iff_collapsedWidth_zero
    [Fintype P] [Nonempty P] {Q : Type*}
    (q : X → Q) (A : P → X → ℝ) (p₀ : P) :
    FactorsThroughRange q (constitutiveRelativeProfile A p₀) ↔
      ∀ x y, q x = q y → constitutiveFamilyWidth A x y = 0 := by
  rw [factorsThroughRange_iff_kernelRefines]
  constructor
  · intro h x y hxy
    apply (constitutiveFamilyWidth_eq_zero_iff A x y).mpr
    intro p r
    have hprofile := h x y hxy
    have hp := congrFun hprofile p
    have hr := congrFun hprofile r
    simp only [constitutiveRelativeProfile, constitutiveExactWork] at hp hr ⊢
    linarith
  · intro h x y hxy
    funext p
    have hwidth := (constitutiveFamilyWidth_eq_zero_iff A x y).mp (h x y hxy) p p₀
    simp only [constitutiveRelativeProfile, constitutiveExactWork] at hwidth ⊢
    linarith

/-- Failure of projective-profile descent is witnessed by strictly positive invisible width. -/
theorem exists_collapsed_positive_familyWidth_of_not_factorsThroughRange
    [Fintype P] [Nonempty P] {Q : Type*}
    (q : X → Q) (A : P → X → ℝ) (p₀ : P)
    (h : ¬ FactorsThroughRange q (constitutiveRelativeProfile A p₀)) :
    ∃ x y, q x = q y ∧ 0 < constitutiveFamilyWidth A x y := by
  rw [relativeProfile_factorsThroughRange_iff_collapsedWidth_zero] at h
  push Not at h
  obtain ⟨x, y, hxy, hne⟩ := h
  exact ⟨x, y, hxy, lt_of_le_of_ne (constitutiveFamilyWidth_nonneg A x y) (Ne.symm hne)⟩

/-- A scalar mandatory law exists exactly on the common-gauge stratum, stated without choosing a
global basepoint: all family widths vanish. -/
theorem familyWork_exact_implies_width_zero [Fintype P] [Nonempty P]
    (A : P → X → ℝ) (V : X → ℝ)
    (hexact : ∀ x y, constitutiveFamilyWork A x y = constitutiveExactWork V x y) :
    ∀ x y, constitutiveFamilyWidth A x y = 0 := by
  intro x y
  rw [constitutiveFamilyWidth, hexact, hexact]
  simp [constitutiveExactWork]

/-! ## Affine clocks and the prime recurrence prediction -/

/-- Linear action family generated by a finite clock packet. -/
def affineClockAction (lambda : P → ℝ) (p : P) (t : ℝ) : ℝ :=
  t * lambda p

/-- On a forward interval, the largest clock realizes mandatory family work. -/
theorem affineClock_familyWork_eq_max [Fintype P] [Nonempty P]
    (lambda : P → ℝ) (pmax : P) (hmax : ∀ p, lambda p ≤ lambda pmax)
    {s t : ℝ} (hst : s ≤ t) :
    constitutiveFamilyWork (affineClockAction lambda) s t =
      (t - s) * lambda pmax := by
  rw [constitutiveFamilyWork_eq_of_dominates (affineClockAction lambda) pmax s t]
  · simp only [affineClockAction, constitutiveExactWork]
    ring
  · intro p
    simp only [affineClockAction, constitutiveExactWork]
    have hnonneg : 0 ≤ (t - s) * (lambda pmax - lambda p) :=
      mul_nonneg (sub_nonneg.mpr hst) (sub_nonneg.mpr (hmax p))
    nlinarith

/-- On the reverse interval, the smallest clock realizes mandatory family work. -/
theorem affineClock_reverse_familyWork_eq_min [Fintype P] [Nonempty P]
    (lambda : P → ℝ) (pmin : P) (hmin : ∀ p, lambda pmin ≤ lambda p)
    {s t : ℝ} (hst : s ≤ t) :
    constitutiveFamilyWork (affineClockAction lambda) t s =
      (s - t) * lambda pmin := by
  rw [constitutiveFamilyWork_eq_of_dominates (affineClockAction lambda) pmin t s]
  · simp only [affineClockAction, constitutiveExactWork]
    ring
  · intro p
    simp only [affineClockAction, constitutiveExactWork]
    have hnonneg : 0 ≤ (t - s) * (lambda p - lambda pmin) :=
      mul_nonneg (sub_nonneg.mpr hst) (sub_nonneg.mpr (hmin p))
    nlinarith

/-- **Affine tropical-width law.** Forward-plus-reverse work is elapsed time times clock span. -/
theorem affineClock_familyWidth_eq_span [Fintype P] [Nonempty P]
    (lambda : P → ℝ) (pmin pmax : P)
    (hmin : ∀ p, lambda pmin ≤ lambda p)
    (hmax : ∀ p, lambda p ≤ lambda pmax)
    {s t : ℝ} (hst : s ≤ t) :
    constitutiveFamilyWidth (affineClockAction lambda) s t =
      (t - s) * (lambda pmax - lambda pmin) := by
  rw [constitutiveFamilyWidth, affineClock_familyWork_eq_max lambda pmax hmax hst,
    affineClock_reverse_familyWork_eq_min lambda pmin hmin hst]
  ring

/-- Clock width at arbitrary orientation is absolute elapsed time times clock span. -/
theorem affineClock_familyWidth_eq_abs_mul_span [Fintype P] [Nonempty P]
    (lambda : P → ℝ) (pmin pmax : P)
    (hmin : ∀ p, lambda pmin ≤ lambda p)
    (hmax : ∀ p, lambda p ≤ lambda pmax)
    (s t : ℝ) :
    constitutiveFamilyWidth (affineClockAction lambda) s t =
      |t - s| * (lambda pmax - lambda pmin) := by
  rcases le_total s t with hst | hts
  · rw [affineClock_familyWidth_eq_span lambda pmin pmax hmin hmax hst,
      abs_of_nonneg (sub_nonneg.mpr hst)]
  · rw [constitutiveFamilyWidth_comm,
      affineClock_familyWidth_eq_span lambda pmin pmax hmin hmax hts,
      abs_of_nonpos (sub_nonpos.mpr hts)]
    ring

/-- **Centered selector reduction.**  With a nonzero clock span, zero projective width is exactly
the centered parameter value.  The theorem does not assert that any arithmetic source forces the
width to vanish. -/
theorem affineClock_centeredWidth_eq_zero_iff [Fintype P] [Nonempty P]
    (lambda : P → ℝ) (pmin pmax : P)
    (hmin : ∀ p, lambda pmin ≤ lambda p)
    (hmax : ∀ p, lambda p ≤ lambda pmax)
    (hspan : lambda pmin < lambda pmax) (a : ℝ) :
    constitutiveFamilyWidth (affineClockAction lambda) 0 a = 0 ↔ a = 0 := by
  rw [affineClock_familyWidth_eq_abs_mul_span lambda pmin pmax hmin hmax 0 a]
  simp only [sub_zero]
  constructor
  · intro h
    have hspan0 : lambda pmax - lambda pmin ≠ 0 := sub_ne_zero.mpr hspan.ne'
    have habs : |a| = 0 := (mul_eq_zero.mp h).resolve_right hspan0
    exact abs_eq_zero.mp habs
  · rintro rfl
    simp

namespace PrimeTropical

open _root_.HTGeometry.ConstraintFrameRelativity

/-- Marked logarithmic clock on a finite prime aperture. -/
noncomputable def clock {F : Finset Nat.Primes} (p : F) : ℝ :=
  Real.log (p.1.1 : ℝ)

/-- **Recurrent observer/open tropical-history theorem.**  A finite prime phase packet returns
arbitrarily close to the identity at arbitrarily late times, while its projective action width is
at least elapsed-time times the full logarithmic clock span. -/
theorem exists_large_return_with_tropical_width
    (F : Finset Nat.Primes) [Nonempty F] (pmin pmax : F)
    (hmin : ∀ p : F, clock (F := F) pmin ≤ clock (F := F) p)
    (hmax : ∀ p : F, clock (F := F) p ≤ clock (F := F) pmax)
    {ε T : ℝ} (hε : 0 < ε) (hT : 0 < T) :
    ∃ t : ℝ, T ≤ t ∧
      (∀ p : F, ‖shellFlow (F := F) 1 t p - 1‖ < ε) ∧
      T * (clock (F := F) pmax - clock (F := F) pmin) ≤
        constitutiveFamilyWidth
          (affineClockAction (fun p : F => clock (F := F) p)) 0 t := by
  obtain ⟨t, ht, hreturn⟩ := _root_.HTGeometry.primeBooleanFusion_exists_large_return F hε hT
  refine ⟨t, ht, hreturn, ?_⟩
  have ht0 : 0 ≤ t := le_trans (le_of_lt hT) ht
  rw [affineClock_familyWidth_eq_span (fun p : F => clock (F := F) p)
    pmin pmax hmin hmax ht0]
  simp only [sub_zero]
  have hspan : 0 ≤ clock (F := F) pmax - clock (F := F) pmin :=
    sub_nonneg.mpr (hmin pmax)
  exact mul_le_mul_of_nonneg_right ht hspan

end PrimeTropical

end GaloisForLFunctions.HTGeometry
