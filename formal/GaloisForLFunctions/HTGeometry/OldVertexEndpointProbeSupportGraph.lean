import GaloisForLFunctions.HTGeometry.EigenbranchProbeSupportGraph

/-!
# Physical old-vertex support graph after leaf attachment

Previously nonzero old-local transitions persist inside every new layer,
while one two-step response creates a bridge from every nonanchor layer to
the anchor.  This module packages those amplitudes into a connected,
nonbipartite support graph generated by Hermitian probes on the old system.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Filter Topology

/-- Support graph generated by probes acting on the old-system factor and
lifted as `B ⊗ I` across the new local alphabet. -/
def oldSystemEigenbranchProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix I I ℂ)
    (t : ℂ) :
    SimpleGraph (I × ρ) where
  Adj x y :=
    x ≠ y ∧
      ∃ p,
        affineEigenbranchSesquilinearMatrixProbe
            energy V (branch x) (branch y)
            (layerMatrixCoupling (probe p)
              (1 : Matrix ρ ρ ℂ))
            x y t ≠ 0 ∨
          affineEigenbranchSesquilinearMatrixProbe
            energy V (branch y) (branch x)
            (layerMatrixCoupling (probe p)
              (1 : Matrix ρ ρ ℂ))
            y x t ≠ 0
  symm := by
    constructor
    intro x y hxy
    exact ⟨hxy.1.symm, by
      rcases hxy.2 with ⟨p, hp | hp⟩
      · exact ⟨p, Or.inr hp⟩
      · exact ⟨p, Or.inl hp⟩⟩
  loopless := by
    constructor
    intro x hxx
    exact hxx.1 rfl

/-- Physical old-system probes containing within-layer copies and selected
cross-layer bridges contain the corresponding anchored replica graph. -/
theorem anchoredReplicaGraph_le_oldSystemProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (G : SimpleGraph I) (anchor : ρ)
    (source target : ρ → I)
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix I I ℂ)
    (t : ℂ)
    (hwithin :
      ∀ ⦃a b⦄, G.Adj a b → ∀ r,
        ∃ p,
          affineEigenbranchSesquilinearMatrixProbe
            energy V (branch (a, r)) (branch (b, r))
            (layerMatrixCoupling (probe p)
              (1 : Matrix ρ ρ ℂ))
            (a, r) (b, r) t ≠ 0)
    (hbridge :
      ∀ r, r ≠ anchor →
        ∃ p,
          affineEigenbranchSesquilinearMatrixProbe
            energy V
            (branch (source r, r))
            (branch (target r, anchor))
            (layerMatrixCoupling (probe p)
              (1 : Matrix ρ ρ ℂ))
            (source r, r) (target r, anchor) t ≠ 0) :
    anchoredReplicaGraph G anchor source target ≤
      oldSystemEigenbranchProbeSupportGraph
        energy V branch probe t := by
  intro x y hxy
  rcases hxy with hsame | ⟨r, hr, hcross⟩
  · have hne : x ≠ y := by
      intro h
      subst y
      exact hsame.2.ne rfl
    refine ⟨hne, ?_⟩
    obtain ⟨p, hp⟩ := hwithin hsame.2 x.2
    have hlayer : y.2 = x.2 := hsame.1.symm
    have hx : (x.1, x.2) = x := Prod.eta x
    have hy : (y.1, x.2) = y :=
      Prod.ext rfl hlayer.symm
    exact ⟨p, Or.inl (by simpa [hx, hy] using hp)⟩
  · rcases hcross with hcross | hcross
    · rcases hcross with ⟨rfl, rfl⟩
      refine ⟨fun h => hr (congrArg Prod.snd h), ?_⟩
      obtain ⟨p, hp⟩ := hbridge r hr
      exact ⟨p, Or.inl hp⟩
    · rcases hcross with ⟨rfl, rfl⟩
      refine ⟨fun h => hr (congrArg Prod.snd h.symm), ?_⟩
      obtain ⟨p, hp⟩ := hbridge r hr
      exact ⟨p, Or.inr hp⟩

/-- Oriented labels of an arbitrary graph's edges. -/
def GraphEdge {I : Type*} (G : SimpleGraph I) :=
  {p : I × I // G.Adj p.1 p.2}

/-- **Old-vertex leaf-extension law.** A connected, nonbipartite
old-observer transition graph remains connected and nonbipartite after
attaching an arbitrary finite local factor.  One coded onsite vector, one
real-symmetric anchor-star interaction, and one common coupling interval
simultaneously preserve all old edges and create all layer bridges.

Every support edge in the conclusion is witnessed by a Hermitian probe on
the old-system factor. -/
theorem
    exists_eventually_oldSystemProbeSupportGraph_good
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ] [Nonempty I]
    (energy : I → ℝ) (hmax : MaximallyProjectiveEnergy energy)
    (anchor : ρ)
    (attachment : Matrix I I ℂ)
    (hattachmentSymm :
      ∀ x y, attachment x y = attachment y x)
    (hattachmentReal :
      ∀ x y,
        (starRingEnd ℂ) (attachment x y) = attachment x y)
    (G : SimpleGraph I) (hGconnected : G.Preconnected)
    (hGnonbipartite : ¬ G.IsBipartite)
    (baseProbe : GraphEdge G → Matrix I I ℂ)
    (hbaseProbeHermitian :
      ∀ e, (baseProbe e).IsHermitian)
    (hbaseProbeEntry :
      ∀ e, baseProbe e e.1.1 e.1.2 ≠ 0)
    (crossSource crossMiddle crossTarget :
      NonanchorLayer anchor → I)
    (crossProbe : NonanchorLayer anchor → Matrix I I ℂ)
    (hcrossProbeHermitian :
      ∀ q, (crossProbe q).IsHermitian)
    (hsourceMiddle :
      ∀ q, crossSource q ≠ crossMiddle q)
    (hmiddleTarget :
      ∀ q, crossMiddle q ≠ crossTarget q)
    (hattachment :
      ∀ q,
        attachment (crossSource q) (crossMiddle q) ≠ 0)
    (hcrossProbe :
      ∀ q,
        crossProbe q (crossMiddle q) (crossTarget q) ≠ 0) :
    ∃ n : ℕ, ∃ branch : I × ρ → ℂ → ℂ,
      ∃ probe :
          Sum (GraphEdge G) (NonanchorLayer anchor) →
            Matrix I I ℂ,
        (∀ p, (probe p).IsHermitian) ∧
        Function.Injective
          (layeredEnergy
            (fun i => (energy i : ℂ))
            (fun r =>
              (codedIntegerLayerShift anchor n r : ℂ))) ∧
        (∀ x, AnalyticAt ℂ (branch x) 0) ∧
        (∀ x,
          branch x 0 =
            layeredEnergy
              (fun i => (energy i : ℂ))
              (fun r =>
                (codedIntegerLayerShift anchor n r : ℂ)) x) ∧
        (∀ x,
          ∀ᶠ t in 𝓝 0,
            matrixCharpolyRelation
              (Matrix.diagonal
                  (layeredEnergy
                    (fun i => (energy i : ℂ))
                    (fun r =>
                      (codedIntegerLayerShift anchor n r : ℂ))) +
                t • layerMatrixCoupling attachment
                  (anchorStarLayerEdge anchor),
                branch x t) = 0) ∧
        ∀ᶠ t : ℝ in 𝓝[≠] 0,
          (oldSystemEigenbranchProbeSupportGraph
              (layeredEnergy
                (fun i => (energy i : ℂ))
                (fun r =>
                  (codedIntegerLayerShift anchor n r : ℂ)))
              (layerMatrixCoupling attachment
                (anchorStarLayerEdge anchor))
              branch probe t).Preconnected ∧
            ¬ (oldSystemEigenbranchProbeSupportGraph
              (layeredEnergy
                (fun i => (energy i : ℂ))
                (fun r =>
                  (codedIntegerLayerShift anchor n r : ℂ)))
              (layerMatrixCoupling attachment
                (anchorStarLayerEdge anchor))
              branch probe t).IsBipartite := by
  classical
  let Edge := GraphEdge G
  let Layer := NonanchorLayer anchor
  letI : Fintype (GraphEdge G) :=
    Fintype.ofInjective Subtype.val Subtype.val_injective
  letI : Fintype (NonanchorLayer anchor) :=
    Fintype.ofInjective Subtype.val Subtype.val_injective
  let Persistent := Edge × ρ
  let persistentProbe :
      Persistent → Matrix (I × ρ) (I × ρ) ℂ :=
    fun er =>
      layerMatrixCoupling (baseProbe er.1)
        (1 : Matrix ρ ρ ℂ)
  let persistentSource : Persistent → I × ρ :=
    fun er => (er.1.1.1, er.2)
  let persistentTarget : Persistent → I × ρ :=
    fun er => (er.1.1.2, er.2)
  have hpersistent :
      ∀ er : Persistent,
        persistentProbe er
          (persistentSource er) (persistentTarget er) ≠ 0 := by
    intro er
    simp [persistentProbe, persistentSource, persistentTarget,
      layerMatrixCoupling, hbaseProbeEntry]
  obtain ⟨n, branch, hinj, hbranchAnalytic,
      hbranchBase, hbranchRoot, hall⟩ :=
    exists_eventually_allLayerCrossAndPersistentProbes_ne_zero
      energy hmax anchor (fun q : Layer => q.1)
      (fun q => q.2)
      attachment crossProbe
      crossSource crossMiddle crossTarget
      hsourceMiddle hmiddleTarget hattachmentSymm hattachmentReal
      hattachment hcrossProbe
      persistentProbe persistentSource persistentTarget hpersistent
  let probe : Sum Edge Layer → Matrix I I ℂ
    | Sum.inl e => baseProbe e
    | Sum.inr q => crossProbe q
  refine ⟨n, branch, probe, ?_, hinj, hbranchAnalytic,
    hbranchBase, hbranchRoot, ?_⟩
  · intro p
    cases p with
    | inl e => exact hbaseProbeHermitian e
    | inr q => exact hcrossProbeHermitian q
  · filter_upwards [hall] with t ht
    let center : I :=
      Classical.choice (inferInstance : Nonempty I)
    let source : ρ → I := fun r =>
      if hr : r ≠ anchor
      then crossSource ⟨r, hr⟩
      else center
    let target : ρ → I := fun r =>
      if hr : r ≠ anchor
      then crossTarget ⟨r, hr⟩
      else center
    have hle :
        anchoredReplicaGraph G anchor source target ≤
          oldSystemEigenbranchProbeSupportGraph
            (layeredEnergy
              (fun i => (energy i : ℂ))
              (fun r =>
                (codedIntegerLayerShift anchor n r : ℂ)))
            (layerMatrixCoupling attachment
              (anchorStarLayerEdge anchor))
            branch probe t := by
      apply anchoredReplicaGraph_le_oldSystemProbeSupportGraph
      · intro a b hab r
        let e : Edge := ⟨(a, b), hab⟩
        refine ⟨Sum.inl e, ?_⟩
        simpa [probe, persistentProbe, persistentSource,
          persistentTarget, e] using ht.2 (e, r)
      · intro r hr
        let q : Layer := ⟨r, hr⟩
        refine ⟨Sum.inr q, ?_⟩
        have hsource : source r = crossSource q := by
          simp [source, q, hr]
        have htarget : target r = crossTarget q := by
          simp [target, q, hr]
        rw [hsource, htarget]
        simpa [probe, q] using ht.1 q
    exact ⟨
      preconnected_of_anchoredReplicaGraph_le
        G hGconnected anchor source target _ hle,
      not_isBipartite_of_anchoredReplicaGraph_le
        G hGnonbipartite anchor source target _ hle⟩

end

end GaloisForLFunctions.HTGeometry
