import GaloisForLFunctions.HTGeometry.CoordinateDivisorOrder
import Mathlib.Algebra.MvPolynomial.Expand

/-!
# A monomial map is injective and fixes every coordinate divisor

Composing two monomial maps multiplies their exponents, so a monomial map with positive exponents
becomes, after composing with a second one, the uniform expansion by the product of the exponents.
That expansion is injective, hence so is the original map.

Killing a coordinate commutes with a monomial map, and the kernel of the coordinate-killing map is
the ideal generated by that coordinate.  Consequently a monomial map pulls each coordinate divisor
back to itself: the coordinate divisors are totally invariant, which is the divisor dynamics of the
horizon theorem realised in the toric model.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {R : Type*} [CommRing R] {σ : Type*} [Fintype σ] [DecidableEq σ]

omit [Fintype σ] [DecidableEq σ] in
theorem monomialMap_comp (e f : σ → ℕ) :
    (monomialMap R σ f).comp (monomialMap R σ e) = monomialMap R σ fun i => f i * e i := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rw [AlgHom.comp_apply, monomialMap_X, monomialMap_X, map_pow, monomialMap_X, ← pow_mul]

omit [Fintype σ] [DecidableEq σ] in
theorem monomialMap_const_eq_expand (n : ℕ) :
    monomialMap R σ (fun _ => n) = MvPolynomial.expand n :=
  MvPolynomial.algHom_ext fun i => by rw [monomialMap_X, MvPolynomial.expand_X]

omit [DecidableEq σ] in
/-- **A monomial map with positive exponents is injective.** -/
theorem monomialMap_injective (e : σ → ℕ) (he : ∀ i, 1 ≤ e i) :
    Function.Injective (monomialMap R σ e) := by
  have hE : 0 < ∏ j : σ, e j := Finset.prod_pos fun i _ => he i
  have hcomp : (monomialMap R σ fun i => (∏ j : σ, e j) / e i).comp (monomialMap R σ e) =
      MvPolynomial.expand (∏ j : σ, e j) := by
    rw [monomialMap_comp]
    have hfun : (fun i => (∏ j : σ, e j) / e i * e i) = fun _ : σ => ∏ j : σ, e j :=
      funext fun i => Nat.div_mul_cancel (Finset.dvd_prod_of_mem _ (Finset.mem_univ i))
    rw [hfun, monomialMap_const_eq_expand]
  have hinj : Function.Injective
      (⇑(monomialMap R σ fun i => (∏ j : σ, e j) / e i) ∘ ⇑(monomialMap R σ e)) := by
    rw [← AlgHom.coe_comp, hcomp]
    exact MvPolynomial.expand_injective hE
  exact hinj.of_comp

variable (R σ)

/-- Setting one coordinate to zero. -/
noncomputable def killCoord (i : σ) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  MvPolynomial.aeval fun j => if j = i then 0 else X j

variable {R σ}

omit [Fintype σ] in
@[simp] theorem killCoord_X_self (i : σ) : killCoord R σ i (X i) = 0 := by
  simp [killCoord]

omit [Fintype σ] in
@[simp] theorem killCoord_X_of_ne {i j : σ} (h : j ≠ i) : killCoord R σ i (X j) = X j := by
  simp [killCoord, h]

omit [Fintype σ] in
/-- A polynomial differs from its restriction to the coordinate hyperplane by a multiple of that
coordinate. -/
theorem sub_killCoord_mem_span (i : σ) (p : MvPolynomial σ R) :
    p - killCoord R σ i p ∈ Ideal.span {(X i : MvPolynomial σ R)} := by
  induction p using MvPolynomial.induction_on with
  | C c => simp [killCoord]
  | add p q hp hq =>
    have : p + q - killCoord R σ i (p + q) =
        (p - killCoord R σ i p) + (q - killCoord R σ i q) := by
      rw [map_add]; ring
    rw [this]
    exact Ideal.add_mem _ hp hq
  | mul_X p j hp =>
    by_cases h : j = i
    · subst h
      refine Ideal.mem_span_singleton.mpr ⟨p, ?_⟩
      rw [map_mul, killCoord_X_self, mul_zero, sub_zero, mul_comm]
    · have hrw : p * X j - killCoord R σ i (p * X j) = (p - killCoord R σ i p) * X j := by
        rw [map_mul, killCoord_X_of_ne h]; ring
      rw [hrw]
      exact Ideal.mul_mem_right _ _ hp

omit [Fintype σ] in
/-- **The kernel of the coordinate-killing map is the ideal generated by that coordinate.** -/
theorem comap_bot_killCoord (i : σ) :
    Ideal.comap (killCoord R σ i).toRingHom (⊥ : Ideal (MvPolynomial σ R)) =
      Ideal.span {(X i : MvPolynomial σ R)} := by
  refine le_antisymm (fun p hp => ?_) (fun p hp => ?_)
  · have hzero : killCoord R σ i p = 0 := hp
    have := sub_killCoord_mem_span i p
    rwa [hzero, sub_zero] at this
  · obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
    show killCoord R σ i (X i * q) ∈ (⊥ : Ideal (MvPolynomial σ R))
    rw [map_mul, killCoord_X_self, zero_mul]
    exact Ideal.zero_mem _

omit [Fintype σ] in
theorem killCoord_comp_monomialMap (e : σ → ℕ) (he : ∀ i, 1 ≤ e i) (i : σ) :
    (killCoord R σ i).comp (monomialMap R σ e) =
      (monomialMap R σ e).comp (killCoord R σ i) := by
  refine MvPolynomial.algHom_ext fun j => ?_
  rw [AlgHom.comp_apply, AlgHom.comp_apply, monomialMap_X]
  by_cases h : j = i
  · subst h
    have hne : e j ≠ 0 := by have := he j; omega
    rw [killCoord_X_self, map_zero, map_pow, killCoord_X_self, zero_pow hne]
  · rw [killCoord_X_of_ne h, map_pow, killCoord_X_of_ne h, monomialMap_X]

/-- **A monomial map pulls each coordinate divisor back to itself.**  The coordinate divisors are
totally invariant, which is the divisor dynamics of the horizon theorem in the toric model. -/
theorem comap_monomialMap_span_X (e : σ → ℕ) (he : ∀ i, 1 ≤ e i) (i : σ) :
    Ideal.comap (monomialMap R σ e).toRingHom (Ideal.span {(X i : MvPolynomial σ R)}) =
      Ideal.span {(X i : MvPolynomial σ R)} := by
  have hbot : Ideal.comap (monomialMap R σ e).toRingHom (⊥ : Ideal (MvPolynomial σ R)) = ⊥ := by
    ext p
    constructor
    · intro hp
      have hp' : monomialMap R σ e p = monomialMap R σ e 0 := by
        rw [map_zero]
        exact hp
      simpa using monomialMap_injective e he hp'
    · intro hp
      have hp' : p = 0 := by simpa using hp
      simp [hp']
  have hcomm : (killCoord R σ i).toRingHom.comp (monomialMap R σ e).toRingHom =
      (monomialMap R σ e).toRingHom.comp (killCoord R σ i).toRingHom :=
    congrArg AlgHom.toRingHom (killCoord_comp_monomialMap e he i)
  rw [← comap_bot_killCoord (R := R) i, Ideal.comap_comap, hcomm, ← Ideal.comap_comap, hbot]

end GaloisForLFunctions.HTGeometry
