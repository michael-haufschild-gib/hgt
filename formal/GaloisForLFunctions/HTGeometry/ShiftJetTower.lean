import GaloisForLFunctions.HTGeometry.ShiftTowerAmbient
import Mathlib

/-!
# The jet tower and differential transcendence of a shift primitive

Let `K` be a field with an automorphism `sigma` fixing the constants, let `F` be a `sigma`-stable
intermediate field, and let `y n` be a sequence with

`sigma (y n) = y n + c n`,   `c n` in `F`.

The jet tower is `F 0 = F`, `F (n+1) = F n (y n)`.  If no nonzero `sigma`-defect of `F` lies in the
span of the `c n`, and `c n` never lies in the span of its predecessors, then every `y n` is
transcendental over the field generated by its predecessors.

The engine is the pair `descentStep_ambient` / `descentStep_fixed_ambient`, which propagate the two
descent hypotheses one level up the tower, and `transcendental_ambient`, which converts the
hypothesis at each level into transcendence of the next jet.
-/

open Polynomial IntermediateField

namespace HTGeometry

variable {K : Type*} [Field K] [Algebra ℂ K]

/-- The tower obtained by adjoining the jets one at a time. -/
noncomputable def jetTower (F : IntermediateField ℂ K) (y : ℕ → K) :
    ℕ → IntermediateField ℂ K
  | 0 => F
  | (n + 1) => (IntermediateField.adjoin (jetTower F y n) {y n}).restrictScalars ℂ

@[simp] theorem jetTower_zero (F : IntermediateField ℂ K) (y : ℕ → K) :
    jetTower F y 0 = F := rfl

theorem mem_jetTower_succ_iff (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) (u : K) :
    u ∈ jetTower F y (n + 1) ↔ u ∈ IntermediateField.adjoin (jetTower F y n) {y n} := Iff.rfl

theorem le_jetTower_succ (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) :
    jetTower F y n ≤ jetTower F y (n + 1) := by
  intro u hu
  rw [mem_jetTower_succ_iff]
  simpa using (IntermediateField.adjoin (jetTower F y n) {y n}).algebraMap_mem ⟨u, hu⟩

theorem jet_mem_jetTower_succ (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) :
    y n ∈ jetTower F y (n + 1) := by
  rw [mem_jetTower_succ_iff]
  exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)

theorem base_le_jetTower (F : IntermediateField ℂ K) (y : ℕ → K) :
    ∀ n, F ≤ jetTower F y n
  | 0 => le_refl _
  | (n + 1) => le_trans (base_le_jetTower F y n) (le_jetTower_succ F y n)

/-- A simple adjunction is stable under any algebra automorphism that stabilises the base and
sends the adjoined element into the extension. -/
theorem adjoin_stable_of_gen
    (phi : K ≃ₐ[ℂ] K) (S : IntermediateField ℂ K) (x : K)
    (hS : ∀ t ∈ S, phi t ∈ S)
    (hx : phi x ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ) :
    ∀ t ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ,
      phi t ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ := by
  intro t ht
  set L : IntermediateField ℂ K := (IntermediateField.adjoin S {x}).restrictScalars ℂ with hL
  have hmem : t ∈ IntermediateField.adjoin S {x} := ht
  have hle : S ≤ L := by
    intro u hu
    simpa using (IntermediateField.adjoin S {x}).algebraMap_mem ⟨u, hu⟩
  refine IntermediateField.adjoin_induction (F := S)
    (p := fun z _ => phi z ∈ L) ?_ ?_ ?_ ?_ ?_ hmem
  · intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hx
  · intro z
    exact hle (hS (z : K) z.2)
  · intro p q _ _ hp hq
    rw [map_add]; exact add_mem hp hq
  · intro p _ hp
    rw [map_inv₀]; exact inv_mem hp
  · intro p q _ _ hp hq
    rw [map_mul]; exact mul_mem hp hq

/-- The span of the first `n` defects. -/
noncomputable def defectSpan (c : ℕ → K) (n : ℕ) : Submodule ℂ K :=
  Submodule.span ℂ (c '' Set.Iio n)

@[simp] theorem defectSpan_zero (c : ℕ → K) : defectSpan c 0 = ⊥ := by
  simp [defectSpan]

theorem defectSpan_succ (c : ℕ → K) (n : ℕ) :
    defectSpan c (n + 1) = defectSpan c n ⊔ Submodule.span ℂ {c n} := by
  have hIio : Set.Iio (n + 1) = Set.Iio n ∪ {n} := by
    ext k; simp [Set.mem_Iio, Nat.lt_succ_iff_lt_or_eq]
  rw [defectSpan, defectSpan, hIio, Set.image_union, Submodule.span_union, Set.image_singleton]

/-- The full span of admissible defects. -/
noncomputable def defectSpanAll (c : ℕ → K) : Submodule ℂ K := Submodule.span ℂ (Set.range c)

theorem mem_defectSpanAll (c : ℕ → K) (n : ℕ) : c n ∈ defectSpanAll c :=
  Submodule.subset_span ⟨n, rfl⟩

/-- If every defect lies in a subfield, so does their whole span. -/
theorem defectSpanAll_le_of_mem {F : IntermediateField ℂ K} {c : ℕ → K}
    (hcF : ∀ n, c n ∈ F) : ∀ v ∈ defectSpanAll c, v ∈ F := by
  intro v hv
  have hle : defectSpanAll c ≤ F.toSubmodule := by
    rw [defectSpanAll, Submodule.span_le]
    rintro _ ⟨n, rfl⟩
    exact hcF n
  exact hle hv

section Tower

variable (sigma : K ≃ₐ[ℂ] K) (F : IntermediateField ℂ K) (y c : ℕ → K)

/-- **The jet tower propagates the descent hypotheses and every jet is transcendental over its
predecessors.** -/
theorem jetTower_induction
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan c n) :
    ∀ n, (∀ u : K, sigma u ∈ jetTower F y n ↔ u ∈ jetTower F y n)
       ∧ (∀ u ∈ jetTower F y n, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
       ∧ (∀ u ∈ jetTower F y n, ∀ v ∈ defectSpanAll c,
            sigma u - u = v → v ∈ defectSpan c n)
       ∧ Transcendental (jetTower F y n) (y n) := by
  intro n
  induction n with
  | zero =>
      have hdef0 : ∀ u ∈ jetTower F y 0, ∀ v ∈ defectSpanAll c,
          sigma u - u = v → v ∈ defectSpan c 0 := by
        intro u hu v hv hduv
        rw [defectSpan_zero, Submodule.mem_bot]
        exact hdefF u hu v hv hduv
      exact ⟨hFstab, hfixF, hdef0,
        transcendental_ambient (sigma := (sigma : K ≃+* K)) hFstab
          (fun a => sigma.commutes a) (hcF 0) (hy 0)
          (T := defectSpanAll c) (W := defectSpan c 0) hdef0
          (mem_defectSpanAll c 0) (hindep 0)⟩
  | succ n ih =>
      obtain ⟨hstab, hfix, hdef, htr⟩ := ih
      have hcn : c n ∈ jetTower F y n := base_le_jetTower F y n (hcF n)
      have hsymmcn : sigma.symm (c n) ∈ jetTower F y n := by
        refine (hstab (sigma.symm (c n))).mp ?_
        simpa using hcn
      -- forward stability
      have hfwd : ∀ t ∈ jetTower F y (n + 1), sigma t ∈ jetTower F y (n + 1) := by
        refine adjoin_stable_of_gen sigma (jetTower F y n) (y n)
          (fun t ht => (hstab t).mpr ht) ?_
        rw [hy n]
        exact add_mem (jet_mem_jetTower_succ F y n) (le_jetTower_succ F y n hcn)
      -- backward stability
      have hbwd : ∀ t ∈ jetTower F y (n + 1), sigma.symm t ∈ jetTower F y (n + 1) := by
        refine adjoin_stable_of_gen sigma.symm (jetTower F y n) (y n)
          (fun t ht => (hstab (sigma.symm t)).mp (by simpa using ht)) ?_
        have hsy : sigma.symm (y n) = y n - sigma.symm (c n) := by
          have := congrArg sigma.symm (hy n)
          simp only [AlgEquiv.symm_apply_apply, map_add] at this
          linear_combination -this
        rw [hsy]
        exact sub_mem (jet_mem_jetTower_succ F y n) (le_jetTower_succ F y n hsymmcn)
      have hstab' : ∀ u : K, sigma u ∈ jetTower F y (n + 1) ↔ u ∈ jetTower F y (n + 1) := by
        intro u
        refine ⟨fun hu => ?_, fun hu => hfwd u hu⟩
        have := hbwd (sigma u) hu
        simpa using this
      -- the two descent hypotheses one level up
      have hfix' : ∀ u ∈ jetTower F y (n + 1), sigma u = u →
          ∃ a : ℂ, u = algebraMap ℂ K a := by
        intro u hu hfu
        exact descentStep_fixed_ambient (sigma := (sigma : K ≃+* K)) hstab hcn (hy n) htr
          (T := defectSpanAll c) (W := defectSpan c n) hfix hdef
          (mem_defectSpanAll c n) (hindep n) hu hfu
      have hdef' : ∀ u ∈ jetTower F y (n + 1), ∀ v ∈ defectSpanAll c,
          sigma u - u = v → v ∈ defectSpan c (n + 1) := by
        intro u hu v hv hduv
        rw [defectSpan_succ]
        refine descentStep_ambient (sigma := (sigma : K ≃+* K)) hstab hcn (hy n) htr
          (T := defectSpanAll c) (W := defectSpan c n) hfix hdef
          (mem_defectSpanAll c n) (hindep n) hu ?_ hv hduv
        exact base_le_jetTower F y n (defectSpanAll_le_of_mem hcF v hv)
      exact ⟨hstab', hfix', hdef',
        transcendental_ambient (sigma := (sigma : K ≃+* K)) hstab'
          (fun a => sigma.commutes a)
          (base_le_jetTower F y (n + 1) (hcF (n + 1))) (hy (n + 1))
          (T := defectSpanAll c) (W := defectSpan c (n + 1)) hdef'
          (mem_defectSpanAll c (n + 1)) (hindep (n + 1))⟩

/-- Every jet is transcendental over the field generated by its predecessors. -/
theorem jetTower_transcendental
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan c n) (n : ℕ) :
    Transcendental (jetTower F y n) (y n) :=
  (jetTower_induction sigma F y c hFstab hcF hy hfixF hdefF hindep n).2.2.2

end Tower

end HTGeometry
