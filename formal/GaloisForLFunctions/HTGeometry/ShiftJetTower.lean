import GaloisForLFunctions.HTGeometry.ShiftTowerAmbient
import GaloisForLFunctions.HTGeometry.RelativeShiftJetTower
import Mathlib

/-!
# The jet tower and differential transcendence of a shift primitive

Let `K` be a field with an automorphism `sigma` fixing the constants, let `F` be a `sigma`-stable
intermediate field, and let `y n` be a sequence with

`sigma (y n) = y n + c n`,   `c n` in `F`.

The jet tower is `F 0 = F`, `F (n+1) = F n (y n)`.  If no nonzero `sigma`-defect of `F` lies in the
span of the `c n`, and `c n` never lies in the span of its predecessors, then every `y n` is
transcendental over the field generated by its predecessors.

This is the constant field `ℂ` of the base-relative development in `RelativeShiftJetTower`: the
tower, the defect spans and the whole induction are `HTGeometry.Rel` at `C := ℂ`, so every
declaration here is that one specialised.  The engine is the pair `Rel.descentStep_ambient` /
`Rel.descentStep_fixed_ambient`, which propagate the two descent hypotheses one level up the
tower, and `Rel.transcendental_ambient`, which converts the hypothesis at each level into
transcendence of the next jet.
-/

open Polynomial IntermediateField

namespace HTGeometry

variable {K : Type*} [Field K] [Algebra ℂ K]

/-- The tower obtained by adjoining the jets one at a time. -/
noncomputable def jetTower (F : IntermediateField ℂ K) (y : ℕ → K) :
    ℕ → IntermediateField ℂ K :=
  Rel.jetTower F y

@[simp] theorem jetTower_zero (F : IntermediateField ℂ K) (y : ℕ → K) :
    jetTower F y 0 = F := rfl

theorem mem_jetTower_succ_iff (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) (u : K) :
    u ∈ jetTower F y (n + 1) ↔ u ∈ IntermediateField.adjoin (jetTower F y n) {y n} :=
  Rel.mem_jetTower_succ_iff F y n u

theorem le_jetTower_succ (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) :
    jetTower F y n ≤ jetTower F y (n + 1) :=
  Rel.le_jetTower_succ F y n

theorem jet_mem_jetTower_succ (F : IntermediateField ℂ K) (y : ℕ → K) (n : ℕ) :
    y n ∈ jetTower F y (n + 1) :=
  Rel.jet_mem_jetTower_succ F y n

theorem base_le_jetTower (F : IntermediateField ℂ K) (y : ℕ → K) :
    ∀ n, F ≤ jetTower F y n :=
  Rel.base_le_jetTower F y

/-- A simple adjunction is stable under any algebra automorphism that stabilises the base and
sends the adjoined element into the extension. -/
theorem adjoin_stable_of_gen
    (phi : K ≃ₐ[ℂ] K) (S : IntermediateField ℂ K) (x : K)
    (hS : ∀ t ∈ S, phi t ∈ S)
    (hx : phi x ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ) :
    ∀ t ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ,
      phi t ∈ (IntermediateField.adjoin S {x}).restrictScalars ℂ :=
  Rel.adjoin_stable_of_gen phi S x hS hx

/-- The span of the defects already used. -/
noncomputable def defectSpan (c : ℕ → K) (n : ℕ) : Submodule ℂ K :=
  Rel.defectSpan ℂ c n

@[simp] theorem defectSpan_zero (c : ℕ → K) : defectSpan c 0 = ⊥ :=
  Rel.defectSpan_zero c

theorem defectSpan_succ (c : ℕ → K) (n : ℕ) :
    defectSpan c (n + 1) = defectSpan c n ⊔ Submodule.span ℂ {c n} :=
  Rel.defectSpan_succ c n

/-- The full span of admissible defects. -/
noncomputable def defectSpanAll (c : ℕ → K) : Submodule ℂ K :=
  Rel.defectSpanAll ℂ c

theorem mem_defectSpanAll (c : ℕ → K) (n : ℕ) : c n ∈ defectSpanAll c :=
  Rel.mem_defectSpanAll c n

/-- If every defect lies in a subfield, so does their whole span. -/
theorem defectSpanAll_le_of_mem {F : IntermediateField ℂ K} {c : ℕ → K}
    (hcF : ∀ n, c n ∈ F) : ∀ v ∈ defectSpanAll c, v ∈ F :=
  Rel.defectSpanAll_le_of_mem hcF

section Tower

variable (sigma : K ≃ₐ[ℂ] K) (F : IntermediateField ℂ K) (y c : ℕ → K)

/-- **The jet tower propagates the descent hypotheses and every jet is transcendental over its
predecessors.** -/
theorem jetTower_induction
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan c n) :
    ∀ n, (∀ u : K, sigma u ∈ jetTower F y n ↔ u ∈ jetTower F y n)
       ∧ (∀ u ∈ jetTower F y n, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
       ∧ (∀ u ∈ jetTower F y n, ∀ v ∈ defectSpanAll c,
            sigma u - u = v → v ∈ defectSpan c n)
       ∧ Transcendental (jetTower F y n) (y n) :=
  Rel.jetTower_induction sigma F y c hFstab hcF hy hfixF hdefF hindep

theorem jetTower_transcendental
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : ℂ, u = algebraMap ℂ K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan c n) (n : ℕ) :
    Transcendental (jetTower F y n) (y n) :=
  Rel.jetTower_transcendental sigma F y c hFstab hcF hy hfixF hdefF hindep n

end Tower

end HTGeometry
