import GaloisForLFunctions.HTGeometry.BohrHullPullback
import GaloisForLFunctions.HTGeometry.BohrHullCharacter

/-!
# The frequency group of the hull, and the frequencies of hull observables

The frequencies that extend from the line to the hull form an additive subgroup of `ℝ`: the
character group of the phase carrier, viewed inside `ℝ`.  It contains the Bohr spectrum of `f`, and
therefore the whole additive group the spectrum generates.

The second theorem is the observable law.  If `F` is any continuous function on the hull, its
pullback `t ↦ F (ι t)` has translation distance dominated by that of `f`, so every frequency of the
pullback is already a frequency of the hull of `f`.  A continuous translation-equivariant observable
cannot create new phase: its frequencies live in the character group of the carrier.
-/

open Filter Topology Metric

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions

open HTGeometry

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] {f : ℝ →ᵇ E}

theorem isBohrHullFrequency_zero (f : ℝ →ᵇ E) : IsBohrHullFrequency f 0 := by
  have h : (fun t : BohrLine f => expChar 0 t.val) = fun _ : BohrLine f => (1 : ℂ) := by
    funext t
    unfold expChar
    norm_num
  rw [IsBohrHullFrequency, h]
  exact uniformContinuous_const

theorem isBohrHullFrequency_neg {mu : ℝ} (hmu : IsBohrHullFrequency f mu) :
    IsBohrHullFrequency f (-mu) := by
  have h : (fun t : BohrLine f => expChar (-mu) t.val)
      = fun t : BohrLine f => (starRingEnd ℂ) (expChar mu t.val) := by
    funext t
    unfold expChar
    rw [← Complex.exp_conj]
    congr 1
    simp [Complex.conj_I]
  rw [IsBohrHullFrequency, h]
  have hconj : UniformContinuous (fun z : ℂ => (starRingEnd ℂ) z) := by
    refine (LipschitzWith.of_dist_le_mul (K := 1) fun a b => ?_).uniformContinuous
    have hd : dist ((starRingEnd ℂ) a) ((starRingEnd ℂ) b) = dist a b := by
      rw [dist_eq_norm, dist_eq_norm, ← map_sub]
      exact RCLike.norm_conj _
    simp [hd]
  exact hconj.comp hmu

theorem isBohrHullFrequency_add {mu nu : ℝ} (hmu : IsBohrHullFrequency f mu)
    (hnu : IsBohrHullFrequency f nu) : IsBohrHullFrequency f (mu + nu) := by
  have hprod : (fun t : BohrLine f => expChar (mu + nu) t.val)
      = fun t : BohrLine f => expChar mu t.val * expChar nu t.val := by
    funext t
    unfold expChar
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [IsBohrHullFrequency, hprod]
  refine Metric.uniformContinuous_iff.mpr fun ε hε => ?_
  obtain ⟨δ₁, hδ₁, h₁⟩ := Metric.uniformContinuous_iff.mp hmu (ε := ε / 2) (by linarith)
  obtain ⟨δ₂, hδ₂, h₂⟩ := Metric.uniformContinuous_iff.mp hnu (ε := ε / 2) (by linarith)
  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun {s t} hst => ?_⟩
  have hs₁ := h₁ (lt_of_lt_of_le hst (min_le_left _ _))
  have hs₂ := h₂ (lt_of_lt_of_le hst (min_le_right _ _))
  rw [dist_eq_norm] at hs₁ hs₂ ⊢
  have hsplit : expChar mu s.val * expChar nu s.val - expChar mu t.val * expChar nu t.val
      = expChar mu s.val * (expChar nu s.val - expChar nu t.val)
        + (expChar mu s.val - expChar mu t.val) * expChar nu t.val := by ring
  have hnorm1 : ‖expChar mu s.val‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  have hnorm2 : ‖expChar nu t.val‖ = 1 := Complex.norm_exp_ofReal_mul_I _
  calc ‖expChar mu s.val * expChar nu s.val - expChar mu t.val * expChar nu t.val‖
      ≤ ‖expChar mu s.val * (expChar nu s.val - expChar nu t.val)‖
        + ‖(expChar mu s.val - expChar mu t.val) * expChar nu t.val‖ := by
        rw [hsplit]; exact norm_add_le _ _
    _ = ‖expChar nu s.val - expChar nu t.val‖ + ‖expChar mu s.val - expChar mu t.val‖ := by
        rw [norm_mul, norm_mul, hnorm1, hnorm2, one_mul, mul_one]
    _ < ε := by linarith

/-- The frequencies of the hull form an additive subgroup of `ℝ`: the character group of the phase
carrier, read inside the line. -/
def bohrHullFrequencies (f : ℝ →ᵇ E) : AddSubgroup ℝ where
  carrier := {mu : ℝ | IsBohrHullFrequency f mu}
  zero_mem' := isBohrHullFrequency_zero f
  add_mem' := isBohrHullFrequency_add
  neg_mem' := isBohrHullFrequency_neg

@[simp] theorem mem_bohrHullFrequencies {mu : ℝ} :
    mu ∈ bohrHullFrequencies f ↔ IsBohrHullFrequency f mu := Iff.rfl

/-- The Bohr spectrum of `f` lies in the character group of its hull. -/
theorem bohrSpectrum_subset_bohrHullFrequencies {fc : ℝ →ᵇ ℂ}
    (hfa : HTGeometry.IsBohrAlmostPeriodic (fun x => fc x)) :
    bohrSpectrum (fun x => fc x) ⊆ (bohrHullFrequencies fc : Set ℝ) := fun _ hmu =>
  isBohrHullFrequency_of_bohrCoefficient_ne_zero hfa hmu

/-- Hence the whole additive group generated by the spectrum lies there. -/
theorem closure_bohrSpectrum_le_bohrHullFrequencies {fc : ℝ →ᵇ ℂ}
    (hfa : HTGeometry.IsBohrAlmostPeriodic (fun x => fc x)) :
    AddSubgroup.closure (bohrSpectrum (fun x => fc x)) ≤ bohrHullFrequencies fc :=
  AddSubgroup.closure_le _ |>.mpr (bohrSpectrum_subset_bohrHullFrequencies hfa)

/-- A frequency transports backwards along a uniformly continuous comparison of translation
distances. -/
theorem isBohrHullFrequency_of_uniformContinuous_compare {E' : Type*} [NormedAddCommGroup E']
    {g : ℝ →ᵇ E'}
    (h : UniformContinuous (fun t : BohrLine f => (BohrLine.of g t.val))) {mu : ℝ}
    (hmu : IsBohrHullFrequency g mu) : IsBohrHullFrequency f mu :=
  hmu.comp h

variable (hf : UniformContinuous (fun x => f x)) (htb : HasTotallyBoundedOrbit (fun x => f x))

include hf htb in
/-- A continuous observable of the hull, packaged as a bounded continuous function on the line. -/
def observableBC (F : BohrHull f → ℂ) (hF : Continuous F) : ℝ →ᵇ ℂ :=
  haveI : CompactSpace (BohrHull f) := compactSpace_bohrHull htb
  (BoundedContinuousFunction.mkOfCompact ⟨F, hF⟩).compContinuous
    ⟨bohrIota f, continuous_bohrIota hf⟩

@[simp] theorem observableBC_apply (F : BohrHull f → ℂ) (hF : Continuous F) (t : ℝ) :
    observableBC hf htb F hF t = F (bohrIota f t) := rfl

include hf htb in
/-- **An observable's translation distance is dominated by the translation distance of `f`.** -/
theorem uniformContinuous_compare_observableBC (F : BohrHull f → ℂ) (hF : Continuous F) :
    UniformContinuous
      (fun t : BohrLine f => (BohrLine.of (observableBC hf htb F hF) t.val)) := by
  haveI : CompactSpace (BohrHull f) := compactSpace_bohrHull htb
  have hFu : UniformContinuous F := CompactSpace.uniformContinuous_of_continuous hF
  refine Metric.uniformContinuous_iff.mpr fun ε hε => ?_
  obtain ⟨δ, hδ, hδF⟩ := Metric.uniformContinuous_iff.mp hFu (ε := ε / 2) (by linarith)
  refine ⟨δ, hδ, fun {s t} hst => ?_⟩
  have hle : dist (BohrLine.of (observableBC hf htb F hF) s.val)
      (BohrLine.of (observableBC hf htb F hF) t.val) ≤ ε / 2 := by
    show dist (translateBC s.val (observableBC hf htb F hF))
      (translateBC t.val (observableBC hf htb F hF)) ≤ ε / 2
    refine (BoundedContinuousFunction.dist_le (by linarith)).mpr fun r => ?_
    have hiota : dist (bohrIota f (r + s.val)) (bohrIota f (r + t.val)) < δ := by
      rw [bohrIota_add, bohrIota_add, add_comm (bohrIota f r) (bohrIota f s.val),
        add_comm (bohrIota f r) (bohrIota f t.val),
        dist_add_bohrIota f r (bohrIota f s.val) (bohrIota f t.val), dist_bohrIota]
      simpa using hst
    exact le_of_lt (hδF hiota)
  exact lt_of_le_of_lt hle (by linarith)

include hf htb in
/-- **The observable law.**  Every Bohr frequency of a continuous observable of the hull is
already a frequency of the hull of `f`. -/
theorem bohrSpectrum_observable_subset_bohrHullFrequencies
    (F : BohrHull f → ℂ) (hF : Continuous F) :
    bohrSpectrum (fun t => F (bohrIota f t)) ⊆ (bohrHullFrequencies f : Set ℝ) := by
  intro mu hmu
  set g : ℝ →ᵇ ℂ := observableBC hf htb F hF with hg
  have hga : HTGeometry.IsBohrAlmostPeriodic (fun x => g x) :=
    isBohrAlmostPeriodic_comp_bohrIota htb hF
  have hmug : IsBohrHullFrequency g mu :=
    isBohrHullFrequency_of_bohrCoefficient_ne_zero hga hmu
  exact isBohrHullFrequency_of_uniformContinuous_compare
    (uniformContinuous_compare_observableBC hf htb F hF) hmug

end

end GaloisForLFunctions
