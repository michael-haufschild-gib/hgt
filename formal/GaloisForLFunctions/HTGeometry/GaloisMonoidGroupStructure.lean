import GaloisForLFunctions.HTGeometry.GaloisDifferentialPointGroup

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped TensorProduct Differential
open GaloisForLFunctions

/-- Inverses of generators propagate through multiplicative closure. -/
theorem exists_inverse_mem_submonoidClosure {M : Type*} [Monoid M] {T : Set M}
    (hinv : ∀ x ∈ T, ∃ y ∈ T, x * y = 1)
    {x : M} (hx : x ∈ Submonoid.closure T) :
    ∃ y ∈ Submonoid.closure T, x * y = 1 := by
  induction hx using Submonoid.closure_induction with
  | mem x hx =>
      obtain ⟨y, hy, hxy⟩ := hinv x hx
      exact ⟨y, Submonoid.subset_closure hy, hxy⟩
  | one => exact ⟨1, Submonoid.one_mem _, one_mul 1⟩
  | mul x y _ _ hx hy =>
      obtain ⟨x', hx', hxx'⟩ := hx
      obtain ⟨y', hy', hyy'⟩ := hy
      refine ⟨y' * x', Submonoid.mul_mem _ hy' hx', ?_⟩
      calc
        (x * y) * (y' * x') = x * (y * y') * x' := by simp only [mul_assoc]
        _ = x * x' := by rw [hyy', mul_one]
        _ = 1 := hxx'

universe u

variable {K R C : Type u} [Field K] [CommRing R] [Nontrivial R] [Algebra K R]
  [Field C] [Algebra C K] [Algebra C R] [IsScalarTower C K R]
  [Differential K] [Differential R] [DifferentialAlgebra K R]
  [Differential C] [DifferentialAlgebra C R]

/-- The Galois monoid generated by differential tensor points is a group. -/
theorem galoisMonoid_exists_inverse_mem
    (E : Subalgebra C (R ⊗[K] R)) {ι : Type*}
    (b : Module.Basis ι C E)
    (hgen : Algebra.adjoin C
      (Set.range (algebraMap R (R ⊗[K] R)) ∪ (E : Set (R ⊗[K] R))) = ⊤)
    (hindep : LinearIndependent R (fun i => ((b i : E) : R ⊗[K] R)))
    {σK : K ≃+* K} {σR : R ≃+* R}
    (hcompat : ∀ x : K, σR (algebraMap K R x) = algebraMap K R (σK x))
    (hconstC : ∀ x : C, σR (algebraMap C R x) = algebraMap C R x)
    (hEσ : ∀ e ∈ E, differenceTensorEquiv σK σR hcompat e = e)
    (hEδ : ∀ e ∈ E, tensorSquareDerivation (K := K) e ∈ E)
    (hsimple : IsSigmaSimple σR)
    (hnew : ∀ x : R, σR x = x → ∃ c : C, x = algebraMap C R c)
    (Y : Matrix (Fin 2) (Fin 2) R)
    (Z : Matrix (Fin 2) (Fin 2) (R ⊗[K] R)) (hZE : ∀ i j, Z i j ∈ E)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y)
    (hdet : Z.det ^ 2 = 1)
    (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin 2 × Fin 2 => Y p.1 p.2) ∪ {u}) = ⊤)
    {g : Matrix (Fin 2) (Fin 2) C}
    (hg : g ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ)) :
    ∃ g' ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ), g * g' = 1 := by
  apply exists_inverse_mem_submonoidClosure (T := {g : Matrix (Fin 2) (Fin 2) C |
    ∃ χ ∈ tensorDifferentialPoints E hEδ, galoisMatrixAt E Z hZE χ = g}) ?_ hg
  rintro x ⟨χ, hχ, rfl⟩
  have hsq := galoisMatrixAt_det_pow_eq_one E Z hZE hdet χ
  have hunit : IsUnit (galoisMatrixAt E Z hZE χ).det := by
    rw [isUnit_iff_ne_zero]
    intro hz
    rw [hz, zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hsq
    exact zero_ne_one hsq
  obtain ⟨χ', hχ', hinv⟩ := exists_inverse_tensorDifferentialPoint E b hgen hindep
    hcompat hconstC hEσ hEδ hsimple hnew χ hχ Y Z hZE hZ hunit u hu htop
  exact ⟨galoisMatrixAt E Z hZE χ', ⟨χ', hχ', rfl⟩, hinv⟩

/-- Conjugation by a matrix whose inverse preserves a matrix family preserves its tangent space. -/
theorem conj_mem_matrixTangentM_vanishingIdeal
    {H : Set (Matrix (Fin 2) (Fin 2) C)}
    (hHone : (1 : Matrix (Fin 2) (Fin 2) C) ∈ H)
    {g g' : Matrix (Fin 2) (Fin 2) C} (hgg' : g * g' = 1)
    (hconj : ∀ h ∈ H, g * h * g' ∈ H)
    {A : Matrix (Fin 2) (Fin 2) C}
    (hA : A ∈ matrixTangentM (matrixVanishingIdeal H)
      (subset_matrixZeroSet_vanishingIdeal H hHone)) :
    g * A * g' ∈ matrixTangentM (matrixVanishingIdeal H)
      (subset_matrixZeroSet_vanishingIdeal H hHone) := by
  rw [mem_matrixTangentM] at hA ⊢
  intro P hP
  let P' := matrixRightTranslate g' (matrixLeftTranslate g P)
  have hP' : P' ∈ matrixVanishingIdeal H := by
    intro h hh
    dsimp [P']
    rw [evalOver_matrixRightTranslate_self, evalOver_matrixLeftTranslate_self]
    exact hP _ (by simpa only [mul_assoc] using hconj h hh)
  have ha := hA P' hP'
  dsimp [P'] at ha
  change differentialPolynomialEvalOver (K := C)
    (fun q : Fin 2 × Fin 2 => dualMatrix 1 A q.1 q.2)
      (matrixRightTranslate g' (matrixLeftTranslate g P)) = 0 at ha
  rw [evalOver_matrixRightTranslate, evalOver_matrixLeftTranslate] at ha
  have hmap (M : Matrix (Fin 2) (Fin 2) C) :
      M.map (algebraMap C (DualNumber C)) = dualMatrix M 0 := by
    apply Matrix.ext fun i j => TrivSqZeroExt.ext ?_ ?_
    · simp [Matrix.map_apply, dualMatrix, TrivSqZeroExt.algebraMap_eq_inl]
    · simp [Matrix.map_apply, dualMatrix, TrivSqZeroExt.algebraMap_eq_inl]
  have hmat :
      g.map (algebraMap C (DualNumber C)) * dualMatrix 1 A *
          g'.map (algebraMap C (DualNumber C)) = dualMatrix 1 (g * A * g') := by
    rw [hmap, hmap, dualMatrix_mul, dualMatrix_mul]
    simp only [mul_one, mul_zero, zero_add, add_zero, hgg']
  rw [← hmat]
  simpa only [mul_assoc] using ha

/-- The Picard--Vessiot Galois monoid supplies the inverse-adjoint hypothesis required by the
determinant-one Cassidy endgame. -/
theorem galoisMonoid_detOne_inverse_adjoint
    (E : Subalgebra C (R ⊗[K] R)) {ι : Type*}
    (b : Module.Basis ι C E)
    (hgen : Algebra.adjoin C
      (Set.range (algebraMap R (R ⊗[K] R)) ∪ (E : Set (R ⊗[K] R))) = ⊤)
    (hindep : LinearIndependent R (fun i => ((b i : E) : R ⊗[K] R)))
    {σK : K ≃+* K} {σR : R ≃+* R}
    (hcompat : ∀ x : K, σR (algebraMap K R x) = algebraMap K R (σK x))
    (hconstC : ∀ x : C, σR (algebraMap C R x) = algebraMap C R x)
    (hEσ : ∀ e ∈ E, differenceTensorEquiv σK σR hcompat e = e)
    (hEδ : ∀ e ∈ E, tensorSquareDerivation (K := K) e ∈ E)
    (hsimple : IsSigmaSimple σR)
    (hnew : ∀ x : R, σR x = x → ∃ c : C, x = algebraMap C R c)
    (Y : Matrix (Fin 2) (Fin 2) R)
    (Z : Matrix (Fin 2) (Fin 2) (R ⊗[K] R)) (hZE : ∀ i j, Z i j ∈ E)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y)
    (hdet : Z.det ^ 2 = 1)
    (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin 2 × Fin 2 => Y p.1 p.2) ∪ {u}) = ⊤) :
    ∀ g ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ),
      ∃ g' : Matrix (Fin 2) (Fin 2) C, g * g' = 1 ∧
        ∀ W ∈ matrixTangentM (matrixVanishingIdeal
            {h ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ) | h.det = 1})
          (subset_matrixZeroSet_vanishingIdeal _
            ⟨Submonoid.one_mem _, Matrix.det_one⟩),
          g * W * g' ∈ matrixTangentM (matrixVanishingIdeal
            {h ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ) | h.det = 1})
            (subset_matrixZeroSet_vanishingIdeal _
              ⟨Submonoid.one_mem _, Matrix.det_one⟩) := by
  intro g hg
  obtain ⟨g', hg', hgg'⟩ := galoisMonoid_exists_inverse_mem E b hgen hindep hcompat hconstC
    hEσ hEδ hsimple hnew Y Z hZE hZ hdet u hu htop hg
  refine ⟨g', hgg', ?_⟩
  apply conj_mem_matrixTangentM_vanishingIdeal
    (H := {h ∈ galoisMonoid E Z hZE (tensorDifferentialPoints E hEδ) | h.det = 1})
    (hHone := ⟨Submonoid.one_mem _, Matrix.det_one⟩) hgg'
  intro h hh
  refine ⟨Submonoid.mul_mem _ (Submonoid.mul_mem _ hg hh.1) hg', ?_⟩
  have hdetgg' : g.det * g'.det = 1 := by
    rw [← Matrix.det_mul, hgg', Matrix.det_one]
  rw [Matrix.det_mul, Matrix.det_mul, hh.2, mul_one, hdetgg']

end

end GaloisForLFunctions.HTGeometry
