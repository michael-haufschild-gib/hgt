import GaloisForLFunctions.HTGeometry.GenericJetAlgebra

/-!
# The reciprocal coefficients add nothing to the algebra

Every reciprocal coefficient of the generic jet lies in the algebra generated by the raw
coefficients together with the inverse of the constant term: the inverse recursion never leaves it.

This is the tautological half of "the observation field at a later resolution is the whole jet
field" — the reciprocal packet is redundant data, and only the raw coordinates are free.
-/

namespace GaloisForLFunctions.HTGeometry

variable (K : Type*) [Field K] (N : ℕ)

/-- The algebra generated by the raw coefficients and the inverse of the constant term. -/
noncomputable def genericRawAlgebra : Subalgebra K (genericJetAlgebra K N) :=
  Algebra.adjoin K (Set.range (genericRaw K N) ∪ {genericInv K N})

theorem genericRaw_mem_genericRawAlgebra (j : ℕ) :
    genericRaw K N j ∈ genericRawAlgebra K N :=
  Algebra.subset_adjoin (Or.inl ⟨j, rfl⟩)

theorem genericInv_mem_genericRawAlgebra :
    genericInv K N ∈ genericRawAlgebra K N :=
  Algebra.subset_adjoin (Or.inr rfl)

/-- **Every reciprocal coefficient lies in the algebra of the raw ones.** -/
theorem genericRecip_mem_genericRawAlgebra : ∀ k : ℕ,
    genericRecip K N k ∈ genericRawAlgebra K N := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 =>
        rw [genericRecip]
        exact genericInv_mem_genericRawAlgebra K N
    | (j + 1) =>
        rw [genericRecip]
        refine Subalgebra.mul_mem _ (Subalgebra.neg_mem _ (genericInv_mem_genericRawAlgebra K N))
          (Subalgebra.sum_mem _ (fun i hi => ?_))
        exact Subalgebra.mul_mem _ (genericRaw_mem_genericRawAlgebra K N (i + 1))
          (ih (j - i) (by omega))

end GaloisForLFunctions.HTGeometry
