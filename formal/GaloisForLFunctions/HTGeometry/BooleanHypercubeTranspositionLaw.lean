import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.GroupTheory.Perm.Sign
import Mathlib.Data.Bool.Basic
import Mathlib.Data.Fintype.Pi

/-!
# Boolean hypercube transposition law

The transpositions along the edges of a finite Boolean hypercube generate its
full symmetric group.  The proof constructs the transposition between any two
vertices by patching their coordinates one at a time.
-/

open Equiv Set Subgroup

namespace GaloisForLFunctions.HTGeometry

/-- Toggle coordinate `i` of a Boolean vertex. -/
def boolToggle {n : ℕ} (x : Fin n → Bool) (i : Fin n) : Fin n → Bool :=
  Function.update x i (!x i)

/-- Replace the coordinates in `s` of `x` by those of `y`. -/
def boolPatch {n : ℕ} (x y : Fin n → Bool) (s : Finset (Fin n)) : Fin n → Bool :=
  fun j => if j ∈ s then y j else x j

/-- Set of transpositions joining adjacent vertices of the Boolean hypercube. -/
def hypercubeEdgeSwaps (n : ℕ) : Set (Equiv.Perm (Fin n → Bool)) :=
  {σ | ∃ x i, σ = Equiv.swap x (boolToggle x i)}

theorem boolToggle_ne {n : ℕ} (x : Fin n → Bool) (i : Fin n) :
    x ≠ boolToggle x i := by
  intro h
  have hi := congrFun h i
  rw [show boolToggle x i i = !x i by simp [boolToggle]] at hi
  exact Bool.self_ne_not (x i) hi

theorem hypercubeEdgeSwaps_isSwap {n : ℕ} {σ : Equiv.Perm (Fin n → Bool)}
    (hσ : σ ∈ hypercubeEdgeSwaps n) : σ.IsSwap := by
  rcases hσ with ⟨x, i, rfl⟩
  exact ⟨x, boolToggle x i, boolToggle_ne x i, rfl⟩

/-- Every patch transposition is generated by hypercube-edge transpositions. -/
theorem swap_boolPatch_mem_closure {n : ℕ} (x y : Fin n → Bool)
    (s : Finset (Fin n)) :
    Equiv.swap x (boolPatch x y s) ∈ Subgroup.closure (hypercubeEdgeSwaps n) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      have hp : boolPatch x y ∅ = x := by
        funext j
        simp [boolPatch]
      rw [hp, Equiv.swap_self]
      exact Subgroup.one_mem _
  | @insert i s hi ih =>
      let z := boolPatch x y s
      let z' := boolPatch x y (insert i s)
      have hxz : Equiv.swap x z ∈ Subgroup.closure (hypercubeEdgeSwaps n) := ih
      have hzz' : Equiv.swap z z' ∈ Subgroup.closure (hypercubeEdgeSwaps n) := by
        by_cases hxy : y i = x i
        · have hzx : z' = z := by
            funext j
            by_cases hji : j = i
            · subst j
              simp [z, z', boolPatch, hi, hxy]
            · simp [z, z', boolPatch, hji]
          rw [hzx, Equiv.swap_self]
          exact Subgroup.one_mem _
        · have hyx : y i = !x i := Bool.eq_not_iff.mpr hxy
          have hzval : z i = x i := by simp [z, boolPatch, hi]
          have htoggle : z' = boolToggle z i := by
            funext j
            by_cases hji : j = i
            · subst j
              simp [z, z', boolPatch, boolToggle, hi, hyx, hzval]
            · simp [z, z', boolPatch, boolToggle, hi, hji]
          rw [htoggle]
          exact Subgroup.subset_closure ⟨z, i, rfl⟩
      exact _root_.SubmonoidClass.swap_mem_trans
        (Subgroup.closure (hypercubeEdgeSwaps n)) hxz hzz'

/-- Every transposition of Boolean vertices is generated by hypercube edges. -/
theorem swap_mem_hypercubeEdgeSwaps_closure {n : ℕ} (x y : Fin n → Bool) :
    Equiv.swap x y ∈ Subgroup.closure (hypercubeEdgeSwaps n) := by
  have hp : boolPatch x y Finset.univ = y := by
    funext j
    simp [boolPatch]
  rw [← hp]
  exact swap_boolPatch_mem_closure x y Finset.univ

/-- Edge transpositions of the Boolean `n`-cube generate its full symmetric group. -/
theorem closure_hypercubeEdgeSwaps (n : ℕ) :
    Subgroup.closure (hypercubeEdgeSwaps n) = ⊤ := by
  letI : Finite (Fin n → Bool) := Finite.of_fintype _
  apply top_unique
  rw [← Equiv.Perm.closure_isSwap, Subgroup.closure_le]
  intro σ hσ
  rcases hσ with ⟨x, y, hxy, rfl⟩
  exact swap_mem_hypercubeEdgeSwaps_closure x y

end GaloisForLFunctions.HTGeometry
