import GaloisForLFunctions.HTGeometry.ShiftMinpolyTranscendence
import Mathlib

/-!
# The jet tower over an arbitrary field of constants

The jet-tower descent with the field of constants left free.  When the coefficient field carries
shift-invariant elements beyond the scalars -- for instance a field of `1`-periodic functions -- the
descent must be run with those invariants as the constants, so every span, every intermediate field
and every fixed-point statement is taken over that field.

Let `K` be a field over `C` with an automorphism fixing `C`, let `F` be a stable intermediate field,
and let `y n` satisfy `sigma (y n) = y n + c n` with `c n` in `F`.  If no nonzero defect of `F` lies
in the `C`-span of the `c n`, and `c n` never lies in the span of its predecessors, then every `y n`
is transcendental over the field generated by its predecessors.
-/

open Polynomial IntermediateField

namespace HTGeometry.Rel

variable {C K : Type*} [Field C] [Field K] [Algebra C K]

section Restrict

variable (sigma : K ≃+* K) (S : IntermediateField C K)

/-- Restrict an automorphism to an intermediate field it stabilises. -/
noncomputable def restrictEquiv (h : ∀ u : K, sigma u ∈ S ↔ u ∈ S) : S ≃+* S where
  toFun u := ⟨sigma u.1, (h u.1).mpr u.2⟩
  invFun v := ⟨sigma.symm v.1, by
    have := (h (sigma.symm v.1)).mp (by simp only [RingEquiv.apply_symm_apply]; exact v.2)
    exact this⟩
  left_inv u := by ext; simp
  right_inv v := by ext; simp
  map_mul' u v := by ext; simp
  map_add' u v := by ext; simp

@[simp] theorem restrictEquiv_coe (h : ∀ u : K, sigma u ∈ S ↔ u ∈ S) (u : S) :
    ((restrictEquiv sigma S h u : S) : K) = sigma (u : K) := rfl

end Restrict

section Ambient

variable {sigma : K ≃+* K} {S : IntermediateField C K}

/-- The linear map realising an intermediate field inside the ambient field. -/
noncomputable def subVal (S : IntermediateField C K) : S →ₗ[C] K :=
  (IntermediateField.val S).toLinearMap

@[simp] theorem subVal_apply (S : IntermediateField C K) (u : S) : subVal S u = (u : K) := rfl

/-- **Terminal transcendence, ambient form.**  If no element of `S` has `sigma`-defect a nonzero
constant multiple of `c`, no element with defect `c` is algebraic over `S`. -/
theorem transcendental_ambient [CharZero C]
    (hstab : ∀ u : K, sigma u ∈ S ↔ u ∈ S)
    (_hsigmaC : ∀ a : C, sigma (algebraMap C K a) = algebraMap C K a)
    {y c : K} (hcS : c ∈ S) (hsy : sigma y = y + c)
    {T W : Submodule C K}
    (hdefect : ∀ u ∈ S, ∀ v ∈ T, sigma u - u = v → v ∈ W)
    (hcT : c ∈ T) (hcW : c ∉ W) :
    Transcendental S y := by
  classical
  set sigmaS : S ≃+* S := restrictEquiv sigma S hstab with hsigmaS
  have hcompat : ∀ a : S, sigma (algebraMap S K a) = algebraMap S K (sigmaS a) := by
    intro a; rfl
  have hsy' : sigma y = y + algebraMap S K (⟨c, hcS⟩ : S) := hsy
  refine transcendental_of_defect_unattainable (Cst := C) (sigma := sigma) (sigmaE := sigmaS)
    hcompat hsy' (T := T.comap (subVal S)) (W := W.comap (subVal S)) ?_ ?_ ?_
  · intro u v hv hdef
    have hu : (u : K) ∈ S := u.2
    have hvK : (v : K) ∈ T := hv
    have hdefK : sigma (u : K) - (u : K) = (v : K) := by
      have := congrArg (fun z : S => (z : K)) hdef
      simpa [hsigmaS] using this
    exact hdefect _ hu _ hvK hdefK
  · exact hcT
  · intro hmem
    exact hcW hmem

/-- **Descent step, ambient form.**  The `sigma`-defect of an element of `S(y)` lies in the span of
the old admissible defects together with `c`. -/
theorem descentStep_ambient [CharZero C]
    (hstab : ∀ u : K, sigma u ∈ S ↔ u ∈ S)
    {y c : K} (hcS : c ∈ S) (hsy : sigma y = y + c)
    (htr : Transcendental S y)
    {T W : Submodule C K}
    (hfix : ∀ u ∈ S, sigma u = u → ∃ a : C, u = algebraMap C K a)
    (hdefect : ∀ u ∈ S, ∀ v ∈ T, sigma u - u = v → v ∈ W)
    (hcT : c ∈ T) (hcW : c ∉ W)
    {b w : K} (hb : b ∈ IntermediateField.adjoin S {y}) (hwS : w ∈ S) (hwT : w ∈ T)
    (hdef : sigma b - b = w) :
    w ∈ W ⊔ Submodule.span C {c} := by
  classical
  obtain ⟨N, D, hD, hcop, hbeq⟩ := exists_coprime_monic_repr htr hb
  set sigmaS : S ≃+* S := restrictEquiv sigma S hstab with hsigmaS
  have hcompat : ∀ a : S, sigma (algebraMap S K a) = algebraMap S K (sigmaS a) := fun a => rfl
  have hsy' : sigma y = y + algebraMap S K (⟨c, hcS⟩ : S) := hsy
  have hfix' : ∀ v : S, sigmaS v = v → ∃ a : C, v = algebraMap C S a := by
    intro v hv
    have hvK : sigma (v : K) = (v : K) := congrArg (fun z : S => (z : K)) hv
    obtain ⟨a, ha⟩ := hfix _ v.2 hvK
    exact ⟨a, Subtype.ext (by simpa using ha)⟩
  have hdefect' : ∀ v : S, ∀ z ∈ T.comap (subVal S), sigmaS v - v = z → z ∈ W.comap (subVal S) := by
    intro v z hz hdz
    have hdK : sigma (v : K) - (v : K) = (z : K) :=
      congrArg (fun x : S => (x : K)) hdz
    exact hdefect _ v.2 _ hz hdK
  have hdefS : sigma (aeval y N / aeval y D) - aeval y N / aeval y D
      = algebraMap S K (⟨w, hwS⟩ : S) := by rw [← hbeq]; exact hdef
  have hres := descentStep_defect_mem (Cst := C) (sigma := sigma) (sigmaE := sigmaS)
    hcompat hsy' htr hfix' hdefect' (T := T.comap (subVal S)) (W := W.comap (subVal S))
    hcT hcW hD hcop (w := (⟨w, hwS⟩ : S)) hwT hdefS
  have hmap := Submodule.mem_map_of_mem (f := subVal S) hres
  have hle : Submodule.map (subVal S)
      ((W.comap (subVal S)) ⊔ Submodule.span C {(⟨c, hcS⟩ : S)})
      ≤ W ⊔ Submodule.span C {c} := by
    rw [Submodule.map_le_iff_le_comap]
    refine sup_le (Submodule.comap_mono le_sup_left) ?_
    rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self c)
  exact hle hmap

/-- **Fixed-point step, ambient form.**  A `sigma`-invariant element of `S(y)` is a constant. -/
theorem descentStep_fixed_ambient [CharZero C]
    (hstab : ∀ u : K, sigma u ∈ S ↔ u ∈ S)
    {y c : K} (hcS : c ∈ S) (hsy : sigma y = y + c)
    (htr : Transcendental S y)
    {T W : Submodule C K}
    (hfix : ∀ u ∈ S, sigma u = u → ∃ a : C, u = algebraMap C K a)
    (hdefect : ∀ u ∈ S, ∀ v ∈ T, sigma u - u = v → v ∈ W)
    (hcT : c ∈ T) (hcW : c ∉ W)
    {b : K} (hb : b ∈ IntermediateField.adjoin S {y}) (hdef : sigma b = b) :
    ∃ a : C, b = algebraMap C K a := by
  classical
  obtain ⟨N, D, hD, hcop, hbeq⟩ := exists_coprime_monic_repr htr hb
  set sigmaS : S ≃+* S := restrictEquiv sigma S hstab with hsigmaS
  have hcompat : ∀ a : S, sigma (algebraMap S K a) = algebraMap S K (sigmaS a) := fun a => rfl
  have hsy' : sigma y = y + algebraMap S K (⟨c, hcS⟩ : S) := hsy
  have hfix' : ∀ v : S, sigmaS v = v → ∃ a : C, v = algebraMap C S a := by
    intro v hv
    have hvK : sigma (v : K) = (v : K) := congrArg (fun z : S => (z : K)) hv
    obtain ⟨a, ha⟩ := hfix _ v.2 hvK
    exact ⟨a, Subtype.ext (by simpa using ha)⟩
  have hdefect' : ∀ v : S, ∀ z ∈ T.comap (subVal S), sigmaS v - v = z →
      z ∈ W.comap (subVal S) := by
    intro v z hz hdz
    exact hdefect _ v.2 _ hz (congrArg (fun x : S => (x : K)) hdz)
  have hdefS : sigma (aeval y N / aeval y D) = aeval y N / aeval y D := by
    rw [← hbeq]; exact hdef
  obtain ⟨a, ha⟩ := descentStep_fixed (Cst := C) (sigma := sigma) (sigmaE := sigmaS)
    hcompat hsy' htr hfix' hdefect' (T := T.comap (subVal S)) (W := W.comap (subVal S))
    hcT hcW hD hcop hdefS
  refine ⟨a, ?_⟩
  rw [hbeq, ha, ← IsScalarTower.algebraMap_apply C S K]

end Ambient

/-- The tower obtained by adjoining the jets one at a time. -/
noncomputable def jetTower (F : IntermediateField C K) (y : ℕ → K) :
    ℕ → IntermediateField C K
  | 0 => F
  | (n + 1) => (IntermediateField.adjoin (jetTower F y n) {y n}).restrictScalars C

@[simp] theorem jetTower_zero (F : IntermediateField C K) (y : ℕ → K) :
    jetTower F y 0 = F := rfl

theorem mem_jetTower_succ_iff (F : IntermediateField C K) (y : ℕ → K) (n : ℕ) (u : K) :
    u ∈ jetTower F y (n + 1) ↔ u ∈ IntermediateField.adjoin (jetTower F y n) {y n} := Iff.rfl

theorem le_jetTower_succ (F : IntermediateField C K) (y : ℕ → K) (n : ℕ) :
    jetTower F y n ≤ jetTower F y (n + 1) := by
  intro u hu
  rw [mem_jetTower_succ_iff]
  simpa using (IntermediateField.adjoin (jetTower F y n) {y n}).algebraMap_mem ⟨u, hu⟩

theorem jet_mem_jetTower_succ (F : IntermediateField C K) (y : ℕ → K) (n : ℕ) :
    y n ∈ jetTower F y (n + 1) := by
  rw [mem_jetTower_succ_iff]
  exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)

theorem base_le_jetTower (F : IntermediateField C K) (y : ℕ → K) :
    ∀ n, F ≤ jetTower F y n
  | 0 => le_refl _
  | (n + 1) => le_trans (base_le_jetTower F y n) (le_jetTower_succ F y n)

/-- A simple adjunction is stable under any algebra automorphism that stabilises the base and
sends the adjoined element into the extension. -/
theorem adjoin_stable_of_gen
    (phi : K ≃ₐ[C] K) (S : IntermediateField C K) (x : K)
    (hS : ∀ t ∈ S, phi t ∈ S)
    (hx : phi x ∈ (IntermediateField.adjoin S {x}).restrictScalars C) :
    ∀ t ∈ (IntermediateField.adjoin S {x}).restrictScalars C,
      phi t ∈ (IntermediateField.adjoin S {x}).restrictScalars C := by
  intro t ht
  set L : IntermediateField C K := (IntermediateField.adjoin S {x}).restrictScalars C with hL
  have hmem : t ∈ IntermediateField.adjoin S {x} := ht
  have hle : S ≤ L := by
    intro u hu
    change u ∈ (IntermediateField.adjoin S {x}).restrictScalars C
    exact (IntermediateField.adjoin S {x}).algebraMap_mem ⟨u, hu⟩
  refine IntermediateField.adjoin_induction (F := S)
    (p := fun z _ => phi z ∈ L) ?_ ?_ ?_ ?_ ?_ hmem
  · intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hx
  · intro z
    exact hle (hS (z : K) z.2)
  · intro p q _ _ hp hq
    rw [map_add]; exact add_mem hp hq
  · intro p _ hp
    rw [map_inv₀]; exact inv_mem hp
  · intro p q _ _ hp hq
    rw [map_mul]; exact mul_mem hp hq

variable (C) in
/-- The span of the first `n` defects. -/
noncomputable def defectSpan (c : ℕ → K) (n : ℕ) : Submodule C K :=
  Submodule.span C (c '' Set.Iio n)

@[simp] theorem defectSpan_zero (c : ℕ → K) : defectSpan C c 0 = ⊥ := by
  simp [defectSpan]

theorem defectSpan_succ (c : ℕ → K) (n : ℕ) :
    defectSpan C c (n + 1) = defectSpan C c n ⊔ Submodule.span C {c n} := by
  have hIio : Set.Iio (n + 1) = Set.Iio n ∪ {n} := by
    ext k; simp
  rw [defectSpan, defectSpan, hIio, Set.image_union, Submodule.span_union, Set.image_singleton]

variable (C) in
/-- The full span of admissible defects. -/
noncomputable def defectSpanAll (c : ℕ → K) : Submodule C K := Submodule.span C (Set.range c)

theorem mem_defectSpanAll (c : ℕ → K) (n : ℕ) : c n ∈ defectSpanAll C c :=
  Submodule.subset_span ⟨n, rfl⟩

/-- If every defect lies in a subfield, so does their whole span. -/
theorem defectSpanAll_le_of_mem {F : IntermediateField C K} {c : ℕ → K}
    (hcF : ∀ n, c n ∈ F) : ∀ v ∈ defectSpanAll C c, v ∈ F := by
  intro v hv
  have hle : defectSpanAll C c ≤ F.toSubmodule := by
    rw [defectSpanAll, Submodule.span_le]
    rintro _ ⟨n, rfl⟩
    exact hcF n
  exact hle hv

section Tower

variable (sigma : K ≃ₐ[C] K) (F : IntermediateField C K) (y c : ℕ → K)

/-- **The jet tower propagates the descent hypotheses and every jet is transcendental over its
predecessors.** -/
theorem jetTower_induction [CharZero C]
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : C, u = algebraMap C K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll C c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan C c n) :
    ∀ n, (∀ u : K, sigma u ∈ jetTower F y n ↔ u ∈ jetTower F y n)
       ∧ (∀ u ∈ jetTower F y n, sigma u = u → ∃ a : C, u = algebraMap C K a)
       ∧ (∀ u ∈ jetTower F y n, ∀ v ∈ defectSpanAll C c,
            sigma u - u = v → v ∈ defectSpan C c n)
       ∧ Transcendental (jetTower F y n) (y n) := by
  intro n
  induction n with
  | zero =>
      have hdef0 : ∀ u ∈ jetTower F y 0, ∀ v ∈ defectSpanAll C c,
          sigma u - u = v → v ∈ defectSpan C c 0 := by
        intro u hu v hv hduv
        rw [defectSpan_zero, Submodule.mem_bot]
        exact hdefF u hu v hv hduv
      exact ⟨hFstab, hfixF, hdef0,
        transcendental_ambient (sigma := (sigma : K ≃+* K)) hFstab
          (fun a => sigma.commutes a) (hcF 0) (hy 0)
          (T := defectSpanAll C c) (W := defectSpan C c 0) hdef0
          (mem_defectSpanAll c 0) (hindep 0)⟩
  | succ n ih =>
      obtain ⟨hstab, hfix, hdef, htr⟩ := ih
      have hcn : c n ∈ jetTower F y n := base_le_jetTower F y n (hcF n)
      have hsymmcn : sigma.symm (c n) ∈ jetTower F y n := by
        refine (hstab (sigma.symm (c n))).mp ?_
        simpa using hcn
      -- forward stability
      have hfwd : ∀ t ∈ jetTower F y (n + 1), sigma t ∈ jetTower F y (n + 1) := by
        refine adjoin_stable_of_gen sigma (jetTower F y n) (y n)
          (fun t ht => (hstab t).mpr ht) ?_
        rw [hy n]
        exact add_mem (jet_mem_jetTower_succ F y n) (le_jetTower_succ F y n hcn)
      -- backward stability
      have hbwd : ∀ t ∈ jetTower F y (n + 1), sigma.symm t ∈ jetTower F y (n + 1) := by
        refine adjoin_stable_of_gen sigma.symm (jetTower F y n) (y n)
          (fun t ht => (hstab (sigma.symm t)).mp (by simpa using ht)) ?_
        have hsy : sigma.symm (y n) = y n - sigma.symm (c n) := by
          have := congrArg sigma.symm (hy n)
          simp only [AlgEquiv.symm_apply_apply, map_add] at this
          linear_combination -this
        rw [hsy]
        exact sub_mem (jet_mem_jetTower_succ F y n) (le_jetTower_succ F y n hsymmcn)
      have hstab' : ∀ u : K, sigma u ∈ jetTower F y (n + 1) ↔ u ∈ jetTower F y (n + 1) := by
        intro u
        refine ⟨fun hu => ?_, fun hu => hfwd u hu⟩
        have := hbwd (sigma u) hu
        simpa using this
      -- the two descent hypotheses one level up
      have hfix' : ∀ u ∈ jetTower F y (n + 1), sigma u = u →
          ∃ a : C, u = algebraMap C K a := by
        intro u hu hfu
        exact descentStep_fixed_ambient (sigma := (sigma : K ≃+* K)) hstab hcn (hy n) htr
          (T := defectSpanAll C c) (W := defectSpan C c n) hfix hdef
          (mem_defectSpanAll c n) (hindep n) hu hfu
      have hdef' : ∀ u ∈ jetTower F y (n + 1), ∀ v ∈ defectSpanAll C c,
          sigma u - u = v → v ∈ defectSpan C c (n + 1) := by
        intro u hu v hv hduv
        rw [defectSpan_succ]
        refine descentStep_ambient (sigma := (sigma : K ≃+* K)) hstab hcn (hy n) htr
          (T := defectSpanAll C c) (W := defectSpan C c n) hfix hdef
          (mem_defectSpanAll c n) (hindep n) hu ?_ hv hduv
        exact base_le_jetTower F y n (defectSpanAll_le_of_mem hcF v hv)
      exact ⟨hstab', hfix', hdef',
        transcendental_ambient (sigma := (sigma : K ≃+* K)) hstab'
          (fun a => sigma.commutes a)
          (base_le_jetTower F y (n + 1) (hcF (n + 1))) (hy (n + 1))
          (T := defectSpanAll C c) (W := defectSpan C c (n + 1)) hdef'
          (mem_defectSpanAll c (n + 1)) (hindep (n + 1))⟩

/-- Every jet is transcendental over the field generated by its predecessors. -/
theorem jetTower_transcendental [CharZero C]
    (hFstab : ∀ u : K, sigma u ∈ F ↔ u ∈ F)
    (hcF : ∀ n, c n ∈ F)
    (hy : ∀ n, sigma (y n) = y n + c n)
    (hfixF : ∀ u ∈ F, sigma u = u → ∃ a : C, u = algebraMap C K a)
    (hdefF : ∀ u ∈ F, ∀ v ∈ defectSpanAll C c, sigma u - u = v → v = 0)
    (hindep : ∀ n, c n ∉ defectSpan C c n) (n : ℕ) :
    Transcendental (jetTower F y n) (y n) :=
  (jetTower_induction sigma F y c hFstab hcF hy hfixF hdefF hindep n).2.2.2

end Tower

end HTGeometry.Rel
