import GaloisForLFunctions.HTGeometry.EllipticGammaExternalDefectNonElliptic
import GaloisForLFunctions.HTGeometry.MeromorphicTranslationDifferentialOperator
import GaloisForLFunctions.HTGeometry.MeromorphicThetaDefectPunctured
import GaloisForLFunctions.HTGeometry.MeromorphicPuncturedTranslationEquality

/-!
# Differential-linear atomicity of the external elliptic-gamma defect

Every nonzero constant-coefficient differential operator applied to a nonresonant external
difference of the logarithmic derivative of the genuine elliptic-gamma product remains outside
the `(1, τ)`-elliptic meromorphic fraction field.  This upgrades order-one separation to the
full cyclic `ℂ[∂]`-module generated by the actual external defect.
-/

open Filter Topology Set Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher

noncomputable section

local instance ellipticGammaDifferentialAtomicDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance ellipticGammaDifferentialAtomicComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring Set.univ) := (constToAnalytic Set.univ).toAlgebra

local instance ellipticGammaDifferentialAtomicComplexAlgebraMero :
    Algebra ℂ (meroField Set.univ) :=
  ((algebraMap (analyticSubring Set.univ) (meroField Set.univ)).comp
    (constToAnalytic Set.univ)).toAlgebra

local instance ellipticGammaDifferentialAtomicDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

/-- **Differential-linear atomicity of the actual elliptic-gamma external defect.**

For every nonzero `L ∈ ℂ[∂]`, the element `L(∂)(T_h ψ - ψ)`, where `ψ` is the logarithmic
derivative of the genuine elliptic-gamma double product, is not a `(1, τ)`-elliptic quotient
of entire functions. -/
theorem ellipticGammaExternalLogDerivDefect_differentialOperator_ne_ellipticFraction
    {L : Polynomial ℂ} (hL : L ≠ 0)
    {σ τ h : ℂ} (hσ : 0 < σ.im) (hτ : 0 < τ.im)
    (hσnt : ThetaTranslationNontorsion τ σ)
    (hnonres : ThetaTranslationNonresonant τ σ h)
    {a b : analyticSubring (Set.univ : Set ℂ)} (hb : b ≠ 0)
    {f g : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f Set.univ)
    (hg : AnalyticOnNhd ℂ g Set.univ)
    (hfa : Germ.coeRingHom (𝓟 Set.univ) f = (a : Germ (𝓟 Set.univ) ℂ))
    (hgb : Germ.coeRingHom (𝓟 Set.univ) g = (b : Germ (𝓟 Set.univ) ℂ))
    (hperiodOne : Function.Periodic (fun z => f z / g z) 1)
    (hperiodTau : Function.Periodic (fun z => f z / g z) τ) :
    differentialOperatorApply L
        (addTranslationMeroEquiv h (ellipticGammaLogDerivMero σ τ hσ hτ) -
          ellipticGammaLogDerivMero σ τ hσ hτ) ≠
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b := by
  intro heq
  let x : meroField Set.univ :=
    addTranslationMeroEquiv h (ellipticGammaLogDerivMero σ τ hσ hτ) -
      ellipticGammaLogDerivMero σ τ hσ hτ
  have hmixed : addTranslationMeroEquiv σ x - x =
      thetaLogDerivDefectMero h τ hτ := by
    exact ellipticGammaLogDerivMero_mixed_face_sigma hσ hτ
  have hcomm := addTranslationMeroEquiv_defect_differentialOperatorApply σ L x
  rw [hmixed] at hcomm
  have heq' : differentialOperatorApply L x =
      algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) b := by
    exact heq
  rw [heq'] at hcomm
  have hfield : differentialOperatorApply L (thetaLogDerivDefectMero h τ hτ) =
      addTranslationMeroEquiv σ
          (algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
            algebraMap (analyticSubring Set.univ) (meroField Set.univ) b) -
        algebraMap (analyticSubring Set.univ) (meroField Set.univ) a /
          algebraMap (analyticSubring Set.univ) (meroField Set.univ) b :=
    hcomm.symm
  have hrep :=
    hasPuncturedMeromorphicRep_differentialOperatorApply_thetaLogDerivDefectMero
      L h τ hτ
  have hlocal := hrep.eq_shiftCoboundary_nhdsNE σ hb hg hfa hgb hfield
  apply thetaDifferentialOperator_ne_ellipticShiftCoboundary_of_eventuallyEq
    hL hτ hσnt hnonres (fun z => f z / g z)
  · exact hf.meromorphicOn.div hg.meromorphicOn
  · exact hperiodOne
  · exact hperiodTau
  · intro n
    exact hlocal (additiveOrbitPoint (thetaHalfPeriod τ - h) σ n)

end

end GaloisForLFunctions
