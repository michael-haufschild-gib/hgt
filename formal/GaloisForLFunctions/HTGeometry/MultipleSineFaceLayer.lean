/-!
# Gluing one layer of the multiple-sine face hierarchy

Over the differential field generated by the deeper face packets and the rational coordinates, the
structural translations are base-normalizing differential automorphisms, the star of every direction
is a union of full translation orbits with free exponents, and every off-star translate is
differentially algebraic.  The nested-star gluing engine then makes a whole uniform layer jointly
independent over that field.
-/

open Filter Set Topology Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open GaloisForLFunctions.MatroidGluing GaloisForLFunctions.MatroidGluing.Rank
open GaloisForLFunctions.MatroidGluing.Meromorphic

noncomputable section

noncomputable local instance msflDecidableEq :
    DecidableEq (meroField (Set.univ : Set ℂ)) := Classical.decEq _

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ### Free exponents on the star of a direction -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 1000000 in
/-- **Free translates on the star of a direction.**  Distinct exponents give distinct elements of
the star: inside one face by faithful labelling, across faces by packet separation. -/
theorem facePacketSlice_zpow_injective_of_two_le {μ : ℂ} {rad : ι → ℝ} (hrad : ∀ k, 0 < rad k)
    (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im)
    (faces : Finset (Finset ι)) (hfaces : ∀ J ∈ faces, 2 ≤ (Jᶜ : Finset ι).card)
    (A : Finset ι) (q : ι) (m n : ℤ) (y z : meroField (Set.univ : Set ℂ))
    (hy : y ∈ ⋃ J ∈ faces.filter (fun J => insert q A ⊆ J),
      facePacketSlice (fun k => μ * (rad k : ℂ)) hω J q)
    (hz : z ∈ ⋃ J ∈ faces.filter (fun J => insert q A ⊆ J),
      facePacketSlice (fun k => μ * (rad k : ℂ)) hω J q)
    (hyz : (meroTranslationPerm (μ * (rad q : ℂ)) ^ m) y
      = (meroTranslationPerm (μ * (rad q : ℂ)) ^ n) z) :
    m = n := by
  classical
  obtain ⟨J, hJ, hyJ⟩ := Set.mem_iUnion₂.mp hy
  obtain ⟨L, hL, hzL⟩ := Set.mem_iUnion₂.mp hz
  have hJf := Finset.mem_filter.mp hJ
  have hLf := Finset.mem_filter.mp hL
  have hqJ : q ∈ J := hJf.2 (Finset.mem_insert_self q A)
  have hqL : q ∈ L := hLf.2 (Finset.mem_insert_self q A)
  have hJcard : 2 ≤ (Jᶜ : Finset ι).card := hfaces J hJf.1
  have hLcard : 2 ≤ (Lᶜ : Finset ι).card := hfaces L hLf.1
  have hyPacket : (meroTranslationPerm (μ * (rad q : ℂ)) ^ m) y
      ∈ facePacket (fun k => μ * (rad k : ℂ)) hω J := by
    rw [facePacket_eq_orbitUnion _ hω hqJ]
    exact ⟨m, y, hyJ, rfl⟩
  have hzPacket : (meroTranslationPerm (μ * (rad q : ℂ)) ^ n) z
      ∈ facePacket (fun k => μ * (rad k : ℂ)) hω L := by
    rw [facePacket_eq_orbitUnion _ hω hqL]
    exact ⟨n, z, hzL, rfl⟩
  have hJL : J = L := by
    by_contra hcon
    exact Set.disjoint_left.mp
      (facePacket_disjoint_of_two_le hrad hind hω hJcard hLcard hcon) hyPacket
      (hyz ▸ hzPacket)
  subst hJL
  have hne : (Jᶜ : Finset ι).Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨α, hα, hyval⟩ :=
    exists_exponent_of_mem_facePacketSlice (fun k => μ * (rad k : ℂ)) hω hne hyJ
  obtain ⟨β, hβ, hzval⟩ :=
    exists_exponent_of_mem_facePacketSlice (fun k => μ * (rad k : ℂ)) hω hne hzL
  rw [meroTranslationPerm_zpow_apply, meroTranslationPerm_zpow_apply, hyval, hzval,
    addTranslationMeroEquiv_add, addTranslationMeroEquiv_add] at hyz
  have hy' : (m : ℂ) * (μ * (rad q : ℂ)) + faceShift (fun k => μ * (rad k : ℂ)) J α
      = faceShift (fun k => μ * (rad k : ℂ)) J
        (fun k => if (k : ι) = q then m else α k) := by
    rw [faceShift_update _ hqJ hα m]
    ring
  have hz' : (n : ℂ) * (μ * (rad q : ℂ)) + faceShift (fun k => μ * (rad k : ℂ)) J β
      = faceShift (fun k => μ * (rad k : ℂ)) J
        (fun k => if (k : ι) = q then n else β k) := by
    rw [faceShift_update _ hqJ hβ n]
    ring
  rw [hy', hz'] at hyz
  have hfun := facePacket_label_injective hrad hind hω hJcard hne hyz
  have hval := congrFun hfun ⟨q, hqJ⟩
  simpa using hval

/-! ### Off-star translates are differentially algebraic over the deeper field -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 1000000 in
/-- Every integer translate of a packet element in a surviving direction differs from it by an
element of the deeper face field. -/
theorem facePacket_zsmul_translate_sub_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    {J : Finset ι} {q : ι} (hqJ : q ∉ J) (h2 : 2 ≤ (Jᶜ : Finset ι).card)
    (hqS : insert q J ∈ S) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ facePacket ω hω J) (n : ℤ) :
    addTranslationMeroEquiv ((n : ℂ) * ω q) y - y
      ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
  classical
  have hone : ∀ x : meroField (Set.univ : Set ℂ), x ∈ facePacket ω hω J →
      addTranslationMeroEquiv (ω q) x - x
        ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
    intro x hx
    obtain ⟨d, hd, r, hr, hstep⟩ := facePacket_offFace_translate_sub_mem ω hω hqJ h2 hx
    rw [hstep]
    refine (differentialAdjoin ℂ (sineDeeperGenerators ω hω S)).sub_mem ?_ ?_
    · exact subset_differentialAdjoin ℂ _ (Or.inr hr)
    · exact subset_differentialAdjoin ℂ _
        (Or.inl (Set.mem_iUnion₂.mpr ⟨insert q J, hqS, hd⟩))
  have hstable : ∀ x ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S),
      addTranslationMeroEquiv (ω q) x ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) :=
    fun x hx => differentialAdjoin_sineDeeperGenerators_translate_stable_of_closed ω hω q
      (fun L hL hq => hS L hL q hq) hx
  have hstable' : ∀ x ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S),
      addTranslationMeroEquiv (-(ω q)) x
        ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) :=
    fun x hx => differentialAdjoin_sineDeeperGenerators_neg_translate_stable_of_closed ω hω q
      (fun L hL hq => hS L hL q hq) hx
  have hstep : ∀ m : ℤ, addTranslationMeroEquiv ((m : ℂ) * ω q) y - y
      ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
    intro m
    induction m using Int.induction_on with
    | zero =>
        rw [Int.cast_zero, zero_mul, addTranslationMeroEquiv_zero_apply, sub_self]
        exact zero_mem _
    | succ m ih =>
        have hsplit : addTranslationMeroEquiv (((m + 1 : ℤ) : ℂ) * ω q) y - y
            = addTranslationMeroEquiv (ω q)
                (addTranslationMeroEquiv ((m : ℂ) * ω q) y - y)
              + (addTranslationMeroEquiv (ω q) y - y) := by
          rw [map_sub, addTranslationMeroEquiv_add]
          have harg : ω q + (m : ℂ) * ω q = ((m + 1 : ℤ) : ℂ) * ω q := by
            push_cast
            ring
          rw [harg]
          ring
        rw [hsplit]
        exact add_mem (hstable _ ih) (hone y hy)
    | pred m ih =>
        have hsplit : addTranslationMeroEquiv (((-m - 1 : ℤ) : ℂ) * ω q) y - y
            = addTranslationMeroEquiv (-(ω q))
                (addTranslationMeroEquiv (((-m : ℤ) : ℂ) * ω q) y - y)
              + (addTranslationMeroEquiv (-(ω q)) y - y) := by
          rw [map_sub, addTranslationMeroEquiv_add]
          have harg : -(ω q) + ((-m : ℤ) : ℂ) * ω q = ((-m - 1 : ℤ) : ℂ) * ω q := by
            push_cast
            ring
          rw [harg]
          ring
        rw [hsplit]
        refine add_mem (hstable' _ ih) ?_
        have hback : addTranslationMeroEquiv (-(ω q)) y - y
            = -(addTranslationMeroEquiv (-(ω q))
              (addTranslationMeroEquiv (ω q) y - y)) := by
          rw [map_sub, addTranslationMeroEquiv_add, neg_add_cancel,
            addTranslationMeroEquiv_zero_apply]
          ring
        rw [hback]
        exact neg_mem (hstable' _ (hone y hy))
  exact hstep n


/-! ### The structural translation as a base-normalizing automorphism -/

set_option synthInstance.maxHeartbeats 1000000 in
/-- **A structural translation as a differential semilinear automorphism over the deeper face
field.**  It normalizes the deeper field and commutes with the derivation. -/
def sineFaceSemilinearEquiv (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) {S : Set (Finset ι)}
    (q : ι) (hS : ∀ L ∈ S, q ∉ L → insert q L ∈ S) :
    DifferentialSemilinearEquiv ↥(differentialAdjoin ℂ (sineDeeperGenerators ω hω S))
      (meroField (Set.univ : Set ℂ)) where
  baseEquiv := meroTranslationRestrict (differentialAdjoin ℂ (sineDeeperGenerators ω hω S)) (ω q)
    (fun x hx => differentialAdjoin_sineDeeperGenerators_translate_stable_of_closed ω hω q hS hx)
    (fun x hx =>
      differentialAdjoin_sineDeeperGenerators_neg_translate_stable_of_closed ω hω q hS hx)
  ambientEquiv := addTranslationMeroEquiv (ω q)
  map_algebraMap' _ := rfl
  map_base_deriv' c := by
    apply Subtype.ext
    exact addTranslationMeroEquiv_deriv (ω q) (c : meroField (Set.univ : Set ℂ))
  map_ambient_deriv' x := addTranslationMeroEquiv_deriv (ω q) x

@[simp]
theorem sineFaceSemilinearEquiv_ambient (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (q : ι) (hS : ∀ L ∈ S, q ∉ L → insert q L ∈ S)
    (x : meroField (Set.univ : Set ℂ)) :
    (sineFaceSemilinearEquiv ω hω q hS).ambientEquiv x
      = addTranslationMeroEquiv (ω q) x := rfl

/-! ### Membership gives differential algebraicity over a generated field -/

set_option synthInstance.maxHeartbeats 1000000 in
theorem differentialAlgebraicOver_of_mem_differentialAdjoin
    (T : Set (meroField (Set.univ : Set ℂ))) {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ T) :
    DifferentialAlgebraicOver ↥(differentialAdjoin ℂ T) x := by
  have h := differentialAlgebraicOver_algebraMap
    (F := ↥(differentialAdjoin ℂ T)) (E := meroField (Set.univ : Set ℂ)) ⟨x, hx⟩
  simpa using h

/-! ### One layer of the hierarchy -/

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- **Joint independence of a uniform face layer over the deeper face field.** -/
theorem sineFaceStar_diffIndepOn_deeper {μ : ℂ} {rad : ι → ℝ} (hrad : ∀ k, 0 < rad k)
    (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (faces : Finset (Finset ι)) (s : ℕ) (huniform : ∀ J ∈ faces, J.card = s)
    (hfaces : ∀ J ∈ faces, 2 ≤ (Jᶜ : Finset ι).card)
    (hcoface : ∀ J ∈ faces, ∀ p : ι, p ∉ J → insert p J ∈ S)
    (hAtomic : ∀ J ∈ faces,
      DiffIndepOn ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω S))
        (facePacket (fun k => μ * (rad k : ℂ)) hω J)) :
    DiffIndepOn ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω S))
      (faceStar faces (facePacket (fun k => μ * (rad k : ℂ)) hω) ∅) := by
  classical
  haveI : DifferentialAlgebra
      ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω S))
      (meroField (Set.univ : Set ℂ)) :=
    ⟨fun x => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin ℂ
        (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω S)) x⟩
  refine differentialRank_uniformFace_nestedStar_diffIndepOn_of_orbit_semilinear
    faces (facePacket (fun k => μ * (rad k : ℂ)) hω)
    (fun q => sineFaceSemilinearEquiv (fun k => μ * (rad k : ℂ)) hω q
      (fun L hL hq => hS L hL q hq))
    s huniform hAtomic
    (fun A q => ⋃ J ∈ faces.filter (fun J => insert q A ⊆ J),
      facePacketSlice (fun k => μ * (rad k : ℂ)) hω J q)
    (fun A q _ _ => ?_) (fun A q _ _ m n y z hy hz hyz => ?_)
    (fun A q _ _ t ht n z hz => ?_)
  · exact faceStar_eq_orbitUnion (fun k => μ * (rad k : ℂ)) hω faces A q
  · exact facePacketSlice_zpow_injective_of_two_le hrad hind hω faces hfaces A q m n y z
      hy hz hyz
  · rw [Finset.coe_image] at hz
    obtain ⟨y, hyt, rfl⟩ := hz
    obtain ⟨J, hJ, hyJ⟩ := Set.mem_iUnion₂.mp (ht hyt)
    have hJf := Finset.mem_filter.mp hJ
    have hJf' := Finset.mem_filter.mp hJf.1
    have hqJ : q ∉ J := hJf.2
    have hstep := facePacket_zsmul_translate_sub_mem (fun k => μ * (rad k : ℂ)) hω hS
      hqJ (hfaces J hJf'.1) (hcoface J hJf'.1 q hqJ) hyJ n
    rw [show (sineFaceSemilinearEquiv (fun k => μ * (rad k : ℂ)) hω q
        (fun L hL hq => hS L hL q hq)).ambientEquiv.toEquiv
        = meroTranslationPerm (μ * (rad q : ℂ)) from rfl, meroTranslationPerm_zpow_apply]
    refine differentialAlgebraicOver_differentialAdjoin_of_sub
      (↑t : Set (meroField (Set.univ : Set ℂ)))
      (subset_differentialAdjoin _ (↑t : Set (meroField (Set.univ : Set ℂ))) hyt) ?_
    exact differentialAlgebraicOver_of_mem_differentialAdjoin _ hstep


end

