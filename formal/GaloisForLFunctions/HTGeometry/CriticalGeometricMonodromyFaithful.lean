import GaloisForLFunctions.HTGeometry.CriticalGeometricMonodromy

/-!
# Faithfulness of the actual critical normal-closure action

The actual normal closure is generated by the images of all source-field embeddings.  Therefore an
automorphism acting trivially on every actual geometric sheet fixes every generator of the normal
closure and is the identity.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000

/-- The Galois action of the actual normal closure on the actual geometric sheets is faithful. -/
theorem criticalNormalClosureAction_injective
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    Function.Injective (criticalNormalClosureAction K m n) := by
  letI : FiniteDimensional (criticalObservationField K m n)
      (criticalSourceField K m n) :=
    criticalSourceField_finiteDimensional_criticalObservationField K hm hn
  letI : Algebra.IsSeparable (criticalObservationField K m n)
      (criticalSourceField K m n) := inferInstance
  letI : IsScalarTower (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra.IsAlgebraic (criticalObservationField K m n)
      (criticalSourceAlgebraicClosure K m n) :=
    Algebra.IsAlgebraic.trans (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n)
  letI : Normal (criticalObservationField K m n)
      (criticalSourceAlgebraicClosure K m n) where
    splits' _ := IsAlgClosed.splits _
  letI : Normal (criticalObservationField K m n)
      (criticalNormalClosure K m n) :=
    normalClosure.normal (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n)
  letI : Algebra.IsAlgebraic (criticalObservationField K m n)
      (criticalSourceField K m n) := inferInstance
  intro σ τ hστ
  let M : IntermediateField (criticalObservationField K m n)
      (criticalNormalClosure K m n) :=
    { carrier := {x | σ x = τ x}
      zero_mem' := by simp
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        rw [map_add, map_add, hx, hy]
      one_mem' := by simp
      mul_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        rw [map_mul, map_mul, hx, hy]
      neg_mem' := by
        intro x hx
        simp only [Set.mem_setOf_eq] at hx ⊢
        rw [map_neg, map_neg, hx]
      inv_mem' := by
        intro x hx
        simp only [Set.mem_setOf_eq] at hx ⊢
        rw [map_inv₀, map_inv₀, hx]
      algebraMap_mem' := by
        intro x
        simp only [Set.mem_setOf_eq]
        rw [map_algebraMap, map_algebraMap] }
  have hle : IntermediateField.normalClosure
      (criticalObservationField K m n) (criticalSourceField K m n)
      (criticalNormalClosure K m n) ≤ M := by
    rw [normalClosure_le_iff]
    intro f
    rintro _ ⟨x, rfl⟩
    change σ (f x) = τ (f x)
    have hf : criticalNormalClosureAction K m n σ f =
        criticalNormalClosureAction K m n τ f :=
      DFunLike.congr_fun hστ f
    exact DFunLike.congr_fun hf x
  have htop : IntermediateField.normalClosure
      (criticalObservationField K m n) (criticalSourceField K m n)
      (criticalNormalClosure K m n) = ⊤ :=
    (Algebra.IsAlgebraic.isNormalClosure_iff.mp
      (inferInstance : IsNormalClosure (criticalObservationField K m n)
        (criticalSourceField K m n) (criticalNormalClosure K m n))).2
  apply AlgEquiv.ext
  intro x
  have hx : x ∈ M := by
    apply hle
    rw [htop]
    exact Set.mem_univ x
  exact hx

end

end GaloisForLFunctions.HTGeometry
