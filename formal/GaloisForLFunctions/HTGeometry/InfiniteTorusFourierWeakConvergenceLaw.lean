import Mathlib

/-!
# Fourier weak convergence on arbitrary compact product tori

The character group of an arbitrary product torus consists of finitely
supported integer functions. These cylinder characters are uniformly dense
in all continuous complex reporters. Consequently convergence of every
finite-support character integral forces weak convergence of the complete
probability law, even when the spectral label type is infinite.
-/

open Filter MeasureTheory Set Topology
open scoped BoundedContinuousFunction ComplexConjugate

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A finite-support Fourier character on an arbitrary product of unit
additive circles. -/
def infiniteTorusFourier
    {I : Type*} (n : I →₀ ℤ) :
    C((I → UnitAddCircle), ℂ) where
  toFun x := n.prod fun i m => fourier m (x i)
  continuous_toFun := by
    classical
    unfold Finsupp.prod
    fun_prop

@[simp]
theorem infiniteTorusFourier_single
    {I : Type*} (i : I) (x : I → UnitAddCircle) :
    infiniteTorusFourier (Finsupp.single i 1) x =
      fourier 1 (x i) := by
  classical
  simp [infiniteTorusFourier, Finsupp.prod_single_index]

@[simp]
theorem infiniteTorusFourier_zero
    {I : Type*} :
    infiniteTorusFourier (0 : I →₀ ℤ) = 1 := by
  ext x
  simp [infiniteTorusFourier]

theorem infiniteTorusFourier_add
    {I : Type*} (m n : I →₀ ℤ)
    (x : I → UnitAddCircle) :
    infiniteTorusFourier (m + n) x =
      infiniteTorusFourier m x *
        infiniteTorusFourier n x := by
  classical
  simp only [infiniteTorusFourier, ContinuousMap.coe_mk]
  rw [Finsupp.prod_add_index'
    (h := fun i q => fourier q (x i))
    (fun i => fourier_zero)
    (fun i a b => fourier_add)]

theorem infiniteTorusFourier_neg
    {I : Type*} (n : I →₀ ℤ)
    (x : I → UnitAddCircle) :
    infiniteTorusFourier (-n) x =
      conj (infiniteTorusFourier n x) := by
  classical
  simp only [infiniteTorusFourier, ContinuousMap.coe_mk]
  rw [Finsupp.prod_neg_index]
  · simp_rw [fourier_neg]
    exact (map_finsuppProd (starRingEnd ℂ) n
      (fun i m => fourier m (x i))).symm
  · intro i
    exact fourier_zero

/-- Star subalgebra generated by all finite-support product-torus
characters. -/
def infiniteTorusFourierSubalgebra (I : Type*) :
    StarSubalgebra ℂ C((I → UnitAddCircle), ℂ) where
  toSubalgebra :=
    Algebra.adjoin ℂ
      (Set.range (infiniteTorusFourier (I := I)))
  star_mem' := by
    change
      Algebra.adjoin ℂ
          (Set.range (infiniteTorusFourier (I := I))) ≤
        star
          (Algebra.adjoin ℂ
            (Set.range (infiniteTorusFourier (I := I))))
    refine Algebra.adjoin_le ?_
    rintro _ ⟨n, rfl⟩
    refine Algebra.subset_adjoin ⟨-n, ?_⟩
    ext x
    simp only [infiniteTorusFourier_neg,
      starRingEnd_apply, ContinuousMap.star_apply]

/-- The character algebra is exactly the linear span of finite-support
characters. -/
theorem infiniteTorusFourierSubalgebra_coe
    (I : Type*) :
    (infiniteTorusFourierSubalgebra I).toSubalgebra.toSubmodule =
      Submodule.span ℂ
        (Set.range (infiniteTorusFourier (I := I))) := by
  apply Algebra.adjoin_eq_span_of_subset
  refine .trans
    (fun x =>
      Submonoid.closure_induction (fun _ => id)
        ⟨0, ?_⟩ ?_)
    Submodule.subset_span
  · exact infiniteTorusFourier_zero
  · rintro _ _ _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n, ?_⟩
    ext x
    exact infiniteTorusFourier_add m n x

/-- Finite-support torus characters separate every pair of distinct points,
including on an infinite product torus. -/
theorem infiniteTorusFourierSubalgebra_separatesPoints
    (I : Type*) :
    (infiniteTorusFourierSubalgebra I).SeparatesPoints := by
  classical
  intro x y hxy
  rw [Ne, funext_iff, not_forall] at hxy
  obtain ⟨i, hi⟩ := hxy
  refine
    ⟨_,
      ⟨infiniteTorusFourier (Finsupp.single i 1),
        Algebra.subset_adjoin
          ⟨Finsupp.single i 1, rfl⟩,
        rfl⟩,
      ?_⟩
  dsimp only
  rw [infiniteTorusFourier_single,
    infiniteTorusFourier_single,
    fourier_one, fourier_one, Ne, Subtype.coe_inj]
  contrapose hi
  exact AddCircle.injective_toCircle one_ne_zero hi

/-- **Infinite-product Fourier density.** Finite-support characters are
uniformly dense in all continuous complex reporters on every compact
product torus. -/
theorem span_infiniteTorusFourier_closure_eq_top
    (I : Type*) :
    (Submodule.span ℂ
      (Set.range
        (infiniteTorusFourier (I := I)))).topologicalClosure =
      ⊤ := by
  rw [← infiniteTorusFourierSubalgebra_coe]
  exact congr_arg
    (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints
      (infiniteTorusFourierSubalgebra I)
      (infiniteTorusFourierSubalgebra_separatesPoints I))

variable {X : Type*} [TopologicalSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X]

/-- Integration of a complex continuous function depends continuously on
a probability measure over a compact space. -/
theorem continuous_integral_complex_continuousMap_infinite
    (f : C(X, ℂ)) :
    Continuous
      (fun μ : ProbabilityMeasure X =>
        ∫ x, f x ∂(μ : Measure X)) := by
  rw [continuous_iff_continuousAt]
  intro μ
  have hid :
      Tendsto (fun ν : ProbabilityMeasure X => ν)
        (𝓝 μ) (𝓝 μ) :=
    tendsto_id
  have hall :=
    (ProbabilityMeasure.tendsto_iff_forall_integral_rclike_tendsto ℂ).1
      hid
  let fb : X →ᵇ ℂ :=
    ContinuousMap.equivBoundedOfCompact X ℂ f
  change
    Tendsto
      (fun ν : ProbabilityMeasure X =>
        ∫ x, f x ∂(ν : Measure X))
      (𝓝 μ)
      (𝓝 (∫ x, f x ∂(μ : Measure X)))
  simpa [fb] using hall fb

/-- A convergent map and one of its cluster points have the same Hausdorff
limit. -/
theorem eq_of_mapClusterPt_of_tendsto_infinite
    {α Y : Type*} [TopologicalSpace Y] [T2Space Y]
    {l : Filter α} {u : α → Y} {x y : Y}
    (hx : MapClusterPt x l u)
    (hy : Tendsto u l (𝓝 y)) :
    x = y := by
  by_contra hxy
  have hd : Disjoint (𝓝 x) (𝓝 y) :=
    disjoint_nhds_nhds.mpr hxy
  have hle :
      𝓝 x ⊓ map u l ≤ 𝓝 x ⊓ 𝓝 y :=
    inf_le_inf_left _ hy
  have hne : (𝓝 x ⊓ map u l).NeBot := hx
  have hne' : (𝓝 x ⊓ 𝓝 y).NeBot :=
    hne.mono hle
  exact hne'.ne hd.eq_bot

private def infiniteIntegralDifferenceLinearMap
    (μ ν : ProbabilityMeasure X) : C(X, ℂ) →ₗ[ℂ] ℂ where
  toFun f :=
    (∫ x, f x ∂(μ : Measure X)) -
      ∫ x, f x ∂(ν : Measure X)
  map_add' f g := by
    have hfμ : Integrable (fun x => f x) (μ : Measure X) :=
      f.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hgμ : Integrable (fun x => g x) (μ : Measure X) :=
      g.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hfν : Integrable (fun x => f x) (ν : Measure X) :=
      f.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hgν : Integrable (fun x => g x) (ν : Measure X) :=
      g.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    simp only [ContinuousMap.add_apply]
    rw [integral_add hfμ hgμ, integral_add hfν hgν]
    ring
  map_smul' c f := by
    simp only [ContinuousMap.smul_apply]
    rw [integral_smul, integral_smul]
    simp only [RingHom.id_apply]
    ring

private theorem norm_infiniteIntegralDifferenceLinearMap_le
    (μ ν : ProbabilityMeasure X) (f : C(X, ℂ)) :
    ‖infiniteIntegralDifferenceLinearMap μ ν f‖ ≤
      2 * ‖f‖ := by
  have hμ :
      ‖∫ x, f x ∂(μ : Measure X)‖ ≤ ‖f‖ := by
    have h :=
      norm_integral_le_of_norm_le_const
        (μ := (μ : Measure X))
        (Filter.Eventually.of_forall
          fun x => f.norm_coe_le_norm x)
    simpa using h
  have hν :
      ‖∫ x, f x ∂(ν : Measure X)‖ ≤ ‖f‖ := by
    have h :=
      norm_integral_le_of_norm_le_const
        (μ := (ν : Measure X))
        (Filter.Eventually.of_forall
          fun x => f.norm_coe_le_norm x)
    simpa using h
  change
    ‖(∫ x, f x ∂(μ : Measure X)) -
        ∫ x, f x ∂(ν : Measure X)‖ ≤
      2 * ‖f‖
  calc
    ‖(∫ x, f x ∂(μ : Measure X)) -
        ∫ x, f x ∂(ν : Measure X)‖
        ≤ ‖∫ x, f x ∂(μ : Measure X)‖ +
          ‖∫ x, f x ∂(ν : Measure X)‖ :=
            norm_sub_le _ _
    _ ≤ ‖f‖ + ‖f‖ := add_le_add hμ hν
    _ = 2 * ‖f‖ := by ring

private def infiniteIntegralDifference
    (μ ν : ProbabilityMeasure X) : C(X, ℂ) →L[ℂ] ℂ :=
  (infiniteIntegralDifferenceLinearMap μ ν).mkContinuous 2
    (norm_infiniteIntegralDifferenceLinearMap_le μ ν)

/-- Probability measures on an arbitrary compact product torus are
determined by every finite-support Fourier character. -/
theorem probabilityMeasure_ext_of_infiniteTorusFourier_integral_eq
    {I : Type*} [Countable I]
    (μ ν : ProbabilityMeasure (I → UnitAddCircle))
    (h : ∀ n : I →₀ ℤ,
      (∫ x, infiniteTorusFourier n x
        ∂(μ : Measure (I → UnitAddCircle))) =
      ∫ x, infiniteTorusFourier n x
        ∂(ν : Measure (I → UnitAddCircle))) :
    μ = ν := by
  let L := infiniteIntegralDifference μ ν
  have hspan :
      Submodule.span ℂ
          (Set.range
            (infiniteTorusFourier (I := I))) ≤
        L.toLinearMap.ker := by
    apply Submodule.span_le.mpr
    rintro f ⟨n, rfl⟩
    change
      (∫ x, infiniteTorusFourier n x
          ∂(μ : Measure (I → UnitAddCircle))) -
        ∫ x, infiniteTorusFourier n x
          ∂(ν : Measure (I → UnitAddCircle)) = 0
    rw [h n, sub_self]
  have hclosure :
      (Submodule.span ℂ
        (Set.range
          (infiniteTorusFourier (I := I)))).topologicalClosure ≤
        L.toLinearMap.ker :=
    Submodule.topologicalClosure_minimal _
      hspan L.isClosed_ker
  rw [span_infiniteTorusFourier_closure_eq_top] at hclosure
  have hzero (f : C((I → UnitAddCircle), ℂ)) :
      L f = 0 := by
    exact hclosure Submodule.mem_top
  apply ProbabilityMeasure.toMeasure_injective
  apply MeasureTheory.ext_of_forall_integral_eq_of_IsFiniteMeasure
  intro f
  let fc : C((I → UnitAddCircle), ℂ) :=
    ⟨fun x => (f x : ℂ),
      Complex.continuous_ofReal.comp f.continuous⟩
  have hz := hzero fc
  have hfcμ :
      Integrable (fun x => (f x : ℂ))
        (μ : Measure (I → UnitAddCircle)) :=
    fc.continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hfcν :
      Integrable (fun x => (f x : ℂ))
        (ν : Measure (I → UnitAddCircle)) :=
    fc.continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  change
    (∫ x, (f x : ℂ)
      ∂(μ : Measure (I → UnitAddCircle))) -
      ∫ x, (f x : ℂ)
        ∂(ν : Measure (I → UnitAddCircle)) = 0 at hz
  have hre := congrArg Complex.re hz
  simp only [Complex.sub_re, Complex.zero_re] at hre
  have hμ :
      (∫ x, (f x : ℂ)
        ∂(μ : Measure (I → UnitAddCircle))).re =
          ∫ x, f x
            ∂(μ : Measure (I → UnitAddCircle)) := by
    simpa using (integral_re hfcμ).symm
  have hν :
      (∫ x, (f x : ℂ)
        ∂(ν : Measure (I → UnitAddCircle))).re =
          ∫ x, f x
            ∂(ν : Measure (I → UnitAddCircle)) := by
    simpa using (integral_re hfcν).symm
  rw [hμ, hν] at hre
  exact sub_eq_zero.mp hre

/-- Convergence of every finite-support Fourier integral forces weak
convergence on an arbitrary compact product torus. -/
theorem probabilityMeasure_tendsto_of_infiniteTorusFourier_integral_tendsto
    {α I : Type*} [Countable I]
    {l : Filter α}
    (μs : α → ProbabilityMeasure (I → UnitAddCircle))
    (μ : ProbabilityMeasure (I → UnitAddCircle))
    (h : ∀ n : I →₀ ℤ,
      Tendsto
        (fun a =>
          ∫ x, infiniteTorusFourier n x
            ∂(μs a : Measure (I → UnitAddCircle)))
        l
        (𝓝 (∫ x, infiniteTorusFourier n x
          ∂(μ : Measure (I → UnitAddCircle))))) :
    Tendsto μs l (𝓝 μ) := by
  apply tendsto_nhds_of_unique_mapClusterPt
  intro ν hν
  apply
    probabilityMeasure_ext_of_infiniteTorusFourier_integral_eq
  intro n
  let F :
      ProbabilityMeasure (I → UnitAddCircle) → ℂ :=
    fun ρ =>
      ∫ x, infiniteTorusFourier n x
        ∂(ρ : Measure (I → UnitAddCircle))
  have hcluster :
      MapClusterPt (F ν) l (F ∘ μs) :=
    hν.continuousAt_comp
      (continuous_integral_complex_continuousMap_infinite
        (infiniteTorusFourier n)).continuousAt
  have ht :
      Tendsto (F ∘ μs) l (𝓝 (F μ)) := by
    simpa [F, Function.comp_def] using h n
  exact
    eq_of_mapClusterPt_of_tendsto_infinite hcluster ht

/-- **Complete infinite-spectrum Fourier-to-ensemble lift.** If every
finite-support Fourier coefficient converges, there is exactly one weak
limit probability law with those coefficients. -/
theorem existsUnique_probabilityMeasure_tendsto_of_infiniteTorusFourier_limit
    {α I : Type*} [Countable I]
    {l : Filter α} [l.NeBot]
    (μs : α → ProbabilityMeasure (I → UnitAddCircle))
    (limit : (I →₀ ℤ) → ℂ)
    (h : ∀ n : I →₀ ℤ,
      Tendsto
        (fun a =>
          ∫ x, infiniteTorusFourier n x
            ∂(μs a : Measure (I → UnitAddCircle)))
        l (𝓝 (limit n))) :
    ∃! μ : ProbabilityMeasure (I → UnitAddCircle),
      Tendsto μs l (𝓝 μ) ∧
        ∀ n : I →₀ ℤ,
          (∫ x, infiniteTorusFourier n x
            ∂(μ : Measure (I → UnitAddCircle))) =
              limit n := by
  obtain ⟨μ, hμcluster⟩ :=
    exists_clusterPt_of_compactSpace (map μs l)
  have hμmap : MapClusterPt μ l μs := hμcluster
  have hcoeff :
      ∀ n : I →₀ ℤ,
        (∫ x, infiniteTorusFourier n x
          ∂(μ : Measure (I → UnitAddCircle))) =
            limit n := by
    intro n
    let F :
        ProbabilityMeasure (I → UnitAddCircle) → ℂ :=
      fun ρ =>
        ∫ x, infiniteTorusFourier n x
          ∂(ρ : Measure (I → UnitAddCircle))
    have hcluster :
        MapClusterPt (F μ) l (F ∘ μs) :=
      hμmap.continuousAt_comp
        (continuous_integral_complex_continuousMap_infinite
          (infiniteTorusFourier n)).continuousAt
    have ht :
        Tendsto (F ∘ μs) l (𝓝 (limit n)) := by
      simpa [F, Function.comp_def] using h n
    exact
      eq_of_mapClusterPt_of_tendsto_infinite hcluster ht
  have hconv : Tendsto μs l (𝓝 μ) := by
    apply
      probabilityMeasure_tendsto_of_infiniteTorusFourier_integral_tendsto
        μs μ
    intro n
    simpa [hcoeff n] using h n
  refine ⟨μ, ⟨hconv, hcoeff⟩, ?_⟩
  intro ν hν
  exact tendsto_nhds_unique hν.1 hconv

/-! ## Actual uniformly sampled phase laws -/

/-- Normalized Lebesgue probability measure on the unit interval. -/
def infiniteTorusUnitIntervalProbabilityMeasure :
    ProbabilityMeasure ℝ :=
  ⟨volume.restrict (Ioc 0 1), by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    norm_num⟩

/-- Centered uniform-time phase point for an arbitrary countable real
frequency family. -/
def infiniteTorusPhasePoint
    {I : Type*} (omega : I → ℝ) (A u : ℝ) :
    I → UnitAddCircle :=
  fun i =>
    ((A * (2 * u - 1) * omega i /
      (2 * Real.pi) : ℝ) : UnitAddCircle)

/-- The arbitrary-product phase point is continuous in sampled time. -/
theorem infiniteTorusPhasePoint_continuous
    {I : Type*} (omega : I → ℝ) (A : ℝ) :
    Continuous (infiniteTorusPhasePoint omega A) := by
  unfold infiniteTorusPhasePoint
  apply continuous_pi
  intro i
  exact
    (AddCircle.continuous_mk' (1 : ℝ)).comp
      (by fun_prop)

/-- Pushforward law of uniformly sampled centered observation time on a
countable product torus. -/
def infiniteTorusPhaseProbabilityMeasure
    {I : Type*} [Countable I]
    (omega : I → ℝ) (A : ℝ) :
    ProbabilityMeasure (I → UnitAddCircle) :=
  ProbabilityMeasure.map
    infiniteTorusUnitIntervalProbabilityMeasure
    (f := infiniteTorusPhasePoint omega A)
    (infiniteTorusPhasePoint_continuous omega A).aemeasurable

/-- Finite-support real detuning selected by an arbitrary-spectrum
character. -/
def infiniteTorusCharacterDetuning
    {I : Type*} (n : I →₀ ℤ) (omega : I → ℝ) : ℝ :=
  n.sum fun i m => (m : ℝ) * omega i

/-- Evaluation of a finite-support torus character on an actual sampled
phase point. -/
theorem infiniteTorusFourier_phasePoint
    {I : Type*} (n : I →₀ ℤ)
    (omega : I → ℝ) (A u : ℝ) :
    infiniteTorusFourier n
        (infiniteTorusPhasePoint omega A u) =
      Complex.exp
        (((A * (2 * u - 1) *
          infiniteTorusCharacterDetuning n omega : ℝ) : ℂ) *
            Complex.I) := by
  classical
  rw [infiniteTorusFourier]
  simp only [ContinuousMap.coe_mk,
    infiniteTorusPhasePoint, fourier_coe_apply]
  rw [Finsupp.prod]
  calc
    (∏ i ∈ n.support,
        Complex.exp
          (2 * (Real.pi : ℂ) * Complex.I * (n i : ℂ) *
            ((A * (2 * u - 1) * omega i /
              (2 * Real.pi) : ℝ) : ℂ) / 1)) =
      ∏ i ∈ n.support,
        Complex.exp
          ((((A * (2 * u - 1) *
            ((n i : ℝ) * omega i) : ℝ) : ℂ) *
              Complex.I)) := by
        apply Finset.prod_congr rfl
        intro i hi
        congr 1
        push_cast
        field_simp [Real.pi_ne_zero]
    _ = Complex.exp
        (∑ i ∈ n.support,
          ((((A * (2 * u - 1) *
            ((n i : ℝ) * omega i) : ℝ) : ℂ) *
              Complex.I))) := by
        rw [Complex.exp_sum]
    _ = Complex.exp
        (((A * (2 * u - 1) *
          infiniteTorusCharacterDetuning n omega : ℝ) : ℂ) *
            Complex.I) := by
        congr 1
        simp only [infiniteTorusCharacterDetuning, Finsupp.sum]
        push_cast
        rw [Finset.mul_sum]
        rw [Finset.sum_mul]

/-- Centering the unit interval converts its exponential average into the
standard sinc kernel. -/
theorem infiniteTorus_interval_exp_centered_eq_sinc
    (A : ℝ) :
    ∫ u in (0 : ℝ)..1,
        Complex.exp
          (((A * (2 * u - 1) : ℝ) : ℂ) *
            Complex.I) =
      Real.sinc A := by
  by_cases hA : A = 0
  · subst A
    simp
  have hfun :
      (fun u : ℝ =>
        Complex.exp
          (((A * (2 * u - 1) : ℝ) : ℂ) *
            Complex.I)) =
      fun u : ℝ =>
        Complex.exp
          ((((2 * A) * u + (-A) : ℝ) : ℂ) *
            Complex.I) := by
    funext u
    congr 2
    push_cast
    ring
  rw [hfun]
  rw [intervalIntegral.integral_comp_mul_add
    (fun t : ℝ =>
      Complex.exp ((t : ℂ) * Complex.I))
    (mul_ne_zero (by norm_num) hA) (-A)]
  rw [show 2 * A * 0 + -A = -A by ring,
    show 2 * A * 1 + -A = A by ring]
  rw [integral_exp_mul_I_eq_sinc]
  simp only [Complex.real_smul]
  push_cast
  field_simp [hA]

/-- **Exact countably infinite phase-ensemble law.** Every finite-support
Fourier coefficient of the actual uniformly sampled infinite phase law is
the sinc of its selected spectral detuning. -/
theorem infiniteTorusPhaseProbabilityMeasure_fourier_integral
    {I : Type*} [Countable I]
    (n : I →₀ ℤ) (omega : I → ℝ) (A : ℝ) :
    (∫ x, infiniteTorusFourier n x
        ∂(infiniteTorusPhaseProbabilityMeasure omega A :
          Measure (I → UnitAddCircle))) =
      Real.sinc
        (A * infiniteTorusCharacterDetuning n omega) := by
  rw [infiniteTorusPhaseProbabilityMeasure,
    ProbabilityMeasure.toMeasure_map]
  rw [integral_map
    (infiniteTorusPhasePoint_continuous omega A).aemeasurable
    (by fun_prop)]
  simp_rw [infiniteTorusFourier_phasePoint]
  rw [show
    (infiniteTorusUnitIntervalProbabilityMeasure :
      Measure ℝ) =
      volume.restrict (Ioc 0 1) by rfl]
  rw [← intervalIntegral.integral_of_le
    (by norm_num : (0 : ℝ) ≤ 1)]
  simpa [mul_assoc, mul_left_comm, mul_comm] using
    infiniteTorus_interval_exp_centered_eq_sinc
      (A * infiniteTorusCharacterDetuning n omega)

end

