import GaloisForLFunctions.HTGeometry.PrimeProfileInvariantGrassmannRepresentation

/-!
# Prime-profile clock saturation law

The invariant-Grassmann representation identifies the differential-field locus, but its existing
surface starts with a subspace already known to be clock-invariant.  This leaf supplies the missing
closure law for an arbitrary prime-profile subspace: differential adjunction is exactly ordinary
field adjunction after taking the least invariant source subspace.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

set_option maxHeartbeats 800000

/-- The least quotient subspace containing `W` and invariant under the prime logarithmic clock. -/
def primeProfileClockSaturation
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    Submodule ℂ PrimeProfileClockQuotient :=
  ⨅ (U : Submodule ℂ PrimeProfileClockQuotient) (_hWU : W ≤ U)
      (_hU : PrimeProfileClockInvariant U), U

/-- Clock saturation contains the original source subspace. -/
theorem le_primeProfileClockSaturation
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    W ≤ primeProfileClockSaturation W := by
  intro q hq
  simp only [primeProfileClockSaturation, Submodule.mem_iInf]
  intro U hWU hU
  exact hWU hq

/-- Clock saturation is invariant under the descended prime clock. -/
theorem primeProfileClockSaturation_invariant
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    PrimeProfileClockInvariant (primeProfileClockSaturation W) := by
  intro q hq
  simp only [primeProfileClockSaturation, Submodule.mem_iInf] at hq ⊢
  intro U hWU hU
  exact hU q (hq U hWU hU)

/-- Clock saturation is the least invariant subspace containing the original source subspace. -/
theorem primeProfileClockSaturation_le
    {W U : Submodule ℂ PrimeProfileClockQuotient}
    (hWU : W ≤ U) (hU : PrimeProfileClockInvariant U) :
    primeProfileClockSaturation W ≤ U := by
  intro q hq
  simp only [primeProfileClockSaturation, Submodule.mem_iInf] at hq
  exact hq U hWU hU

/-- Clock saturation is monotone. -/
theorem primeProfileClockSaturation_mono
    {U W : Submodule ℂ PrimeProfileClockQuotient} (hUW : U ≤ W) :
    primeProfileClockSaturation U ≤ primeProfileClockSaturation W :=
  primeProfileClockSaturation_le
    (hUW.trans (le_primeProfileClockSaturation W))
    (primeProfileClockSaturation_invariant W)

/-- Clock saturation is idempotent. -/
theorem primeProfileClockSaturation_idempotent
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    primeProfileClockSaturation (primeProfileClockSaturation W) =
      primeProfileClockSaturation W := by
  apply le_antisymm
  · exact primeProfileClockSaturation_le le_rfl
      (primeProfileClockSaturation_invariant W)
  · exact le_primeProfileClockSaturation (primeProfileClockSaturation W)

/-- The fixed points of clock saturation are exactly the invariant source subspaces. -/
theorem primeProfileClockSaturation_eq_self_iff
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    primeProfileClockSaturation W = W ↔ PrimeProfileClockInvariant W := by
  constructor
  · intro h
    rw [← h]
    exact primeProfileClockSaturation_invariant W
  · intro hW
    apply le_antisymm
    · exact primeProfileClockSaturation_le le_rfl hW
    · exact le_primeProfileClockSaturation W

/-- The complete clock module generated by a Grassmann basis of `W` is precisely the least clock
saturation of `W`; no choice of basis or source representative remains. -/
theorem primeProfileClockSubmodule_grassmannSource_eq_saturation
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    primeProfileClockSubmodule (primeProfileGrassmannSource W) =
      primeProfileClockSaturation W := by
  apply le_antisymm
  · rw [primeProfileClockSubmodule, Submodule.span_le]
    rintro _ ⟨⟨i, n⟩, rfl⟩
    apply (primeProfileClockSaturation_invariant W).jet_mem
    apply le_primeProfileClockSaturation W
    rw [primeProfileClockClass_grassmannSource]
    exact (Module.Basis.ofVectorSpace ℂ W i).2
  · apply primeProfileClockSaturation_le
    · intro q hq
      rw [← primeProfileStaticSubmodule_grassmannSource W] at hq
      unfold primeProfileStaticSubmodule at hq
      unfold primeProfileClockSubmodule
      refine Submodule.span_mono ?_ hq
      rintro _ ⟨i, rfl⟩
      refine ⟨(i, 0), ?_⟩
      simp [primeProfileClockJetFamily]
    · exact primeProfileClockSubmodule_invariant (primeProfileGrassmannSource W)

/-- **Prime-clock saturation law.**  For an arbitrary prime-profile source subspace, closing its
represented carriers under differentiation is exactly the ordinary Grassmann field of the least
clock-invariant source subspace containing it. -/
theorem differentialAdjoin_grassmannSource_eq_grassmannField_saturation
    (W : Submodule ℂ PrimeProfileClockQuotient) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource W i))) =
      primeProfileGrassmannField (primeProfileClockSaturation W) := by
  let S := primeProfileClockSaturation W
  have hS : PrimeProfileClockInvariant S :=
    primeProfileClockSaturation_invariant W
  have hfields :
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (primeProfileGrassmannSource W i))) =
        GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (primeProfileGrassmannSource S i))) := by
    apply (primeProfile_differentialAdjoin_eq_iff_intrinsicClockSubmodule_eq
      (primeProfileGrassmannSource W) (primeProfileGrassmannSource S)
      (primeProfileGrassmannSource_supportedOnPositivePrimePowers W)
      (primeProfileGrassmannSource_supportedOnPositivePrimePowers S)).2
    rw [primeProfileClockSubmodule_grassmannSource_eq_saturation W,
      primeProfileClockSubmodule_grassmannSource S hS]
  calc
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource W i))) =
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource S i))) := hfields
    _ = primeProfileGrassmannField S :=
      differentialAdjoin_grassmannSource_eq_grassmannField S hS

/-- Differential fields generated by arbitrary source subspaces are ordered exactly by their
clock saturations. -/
theorem differentialAdjoin_grassmannSource_le_iff_saturation_le
    (U W : Submodule ℂ PrimeProfileClockQuotient) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource U i))) ≤
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource W i))) ↔
      primeProfileClockSaturation U ≤ primeProfileClockSaturation W := by
  rw [differentialAdjoin_grassmannSource_eq_grassmannField_saturation U,
    differentialAdjoin_grassmannSource_eq_grassmannField_saturation W]
  exact primeProfileGrassmannField_le_iff _ _

/-- Differential fields generated by arbitrary source subspaces are equal exactly when their
clock saturations are equal. -/
theorem differentialAdjoin_grassmannSource_eq_iff_saturation_eq
    (U W : Submodule ℂ PrimeProfileClockQuotient) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource U i))) =
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (primeProfileGrassmannSource W i))) ↔
      primeProfileClockSaturation U = primeProfileClockSaturation W := by
  rw [differentialAdjoin_grassmannSource_eq_grassmannField_saturation U,
    differentialAdjoin_grassmannSource_eq_grassmannField_saturation W]
  exact primeProfileGrassmannField_eq_iff _ _

end


end GaloisForLFunctions.HTGeometry
