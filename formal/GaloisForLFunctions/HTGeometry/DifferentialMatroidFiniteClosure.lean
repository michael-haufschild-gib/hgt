import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence

/-!
# Finite closure in the differential matroid

For every family, matroid closure is exactly differential algebraicity over the differential field
generated by that family. The finite declarations here are compatibility interfaces for existing
packet applications of the unconditional closure law.
-/

open scoped Differential

namespace GaloisForLFunctions

open Set

noncomputable section

universe u v

/-- On a positive-width finite packet, closure in the genuine differential matroid is precisely
differential-algebraic closure of the generated differential field. -/
theorem differentialMatroid_mem_closure_range_fin_succ_iff
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (x : Fin (n + 1) → E) (y : E) :
    y ∈ (differentialMatroid F E).closure (Set.range x) ↔
      DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y :=
  HTGeometry.differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin

/-- Fintype form of finite differential closure, including the empty packet. -/
theorem differentialMatroid_mem_closure_range_fintype_iff
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    [Fintype ι] (x : ι → E) (y : E) :
    y ∈ (differentialMatroid F E).closure (Set.range x) ↔
      DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y :=
  HTGeometry.differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin

end

end GaloisForLFunctions
