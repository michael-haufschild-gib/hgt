import GaloisForLFunctions.HTGeometry.DifferentialMatroid
import GaloisForLFunctions.HTGeometry.DifferentialMatroidClosure

/-!
# Finite closure in the differential matroid

For a nonempty finite family, matroid closure is exactly differential algebraicity over the
differential field generated by that family.  This removes the independence restriction from the
basic closure theorem on the finite packets used by applications.
-/

open scoped Differential

namespace GaloisForLFunctions

open Set

noncomputable section

universe u v

/-- On a nonempty finite packet, closure in the genuine differential matroid is precisely
differential-algebraic closure of the generated differential field. -/
theorem differentialMatroid_mem_closure_range_fin_succ_iff
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (x : Fin (n + 1) → E) (y : E) :
    y ∈ (differentialMatroid F E).closure (Set.range x) ↔
      DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y := by
  let M := differentialMatroid F E
  obtain ⟨I, hI⟩ := M.exists_isBasis (Set.range x)
  have hIind : DiffIndepOn F I := by
    exact (differentialMatroid_indep_iff (F := F) (E := E)).mp hI.indep
  have hIclosure (z : E) :
      z ∈ M.closure I ↔
        DifferentialAlgebraicOver (differentialAdjoin F I) z := by
    exact differentialMatroid_mem_closure_iff_of_indep hIind z
  have hclosure : M.closure I = M.closure (Set.range x) :=
    hI.closure_eq_closure
  constructor
  · intro hy
    have hyI : y ∈ M.closure I := by
      rw [hclosure]
      exact hy
    have hyBase := (hIclosure y).mp hyI
    exact HTGeometry.differentialAlgebraicOver_mono_differentialAdjoin_narrow
      (differentialAdjoin F (Set.range x))
      (derivationClosed_differentialAdjoin F (Set.range x))
      (hI.subset.trans (subset_differentialAdjoin F (Set.range x))) hyBase
  · intro hy
    have hxBase : ∀ i,
        DifferentialAlgebraicOver (differentialAdjoin F I) (x i) := by
      intro i
      apply (hIclosure (x i)).mp
      rw [hclosure]
      exact M.mem_closure_of_mem ⟨i, rfl⟩
    have hfield :
        (differentialAdjoin (differentialAdjoin F I) (Set.range x)).restrictScalars F =
          differentialAdjoin F (Set.range x) := by
      rw [differentialAdjoin_union]
      rw [Set.union_eq_right.mpr hI.subset]
    letI : DifferentialAlgebra (differentialAdjoin F I) E :=
      ⟨fun c => derivationClosedDifferential_apply (differentialAdjoin F I)
        (derivationClosed_differentialAdjoin F I) c⟩
    have hyNested : DifferentialAlgebraicOver
        (differentialAdjoin (differentialAdjoin F I) (Set.range x)) y := by
      rw [← hfield] at hy
      exact hy
    have hyI := HTGeometry.differentialAlgebraicOver_trans_fin_succ_narrow
      x hxBase y hyNested
    have : y ∈ M.closure I := (hIclosure y).mpr hyI
    rwa [hclosure] at this

/-- Fintype form of finite differential closure.  Nonemptiness excludes the vacuous zero-coordinate
packet and is automatic for every positive-width matrix family. -/
theorem differentialMatroid_mem_closure_range_fintype_iff
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    [Fintype ι] [Nonempty ι] (x : ι → E) (y : E) :
    y ∈ (differentialMatroid F E).closure (Set.range x) ↔
      DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y := by
  have hcard : 0 < Fintype.card ι := Fintype.card_pos_iff.mpr inferInstance
  let n := Fintype.card ι - 1
  have hcardEq : Fintype.card ι = n + 1 := by
    dsimp [n]
    omega
  let e : Fin (n + 1) ≃ ι :=
    (finCongr hcardEq.symm).trans (Fintype.equivFin ι).symm
  have hrange : Set.range (x ∘ e) = Set.range x := by
    ext z
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e i, rfl⟩
    · rintro ⟨i, rfl⟩
      obtain ⟨j, rfl⟩ := e.surjective i
      exact ⟨j, rfl⟩
  have h := differentialMatroid_mem_closure_range_fin_succ_iff
    (F := F) (E := E) (x ∘ e) y
  rw [hrange] at h
  exact h

end

end GaloisForLFunctions
