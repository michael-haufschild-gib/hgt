/-
# Elementary symmetric polynomials are polynomials in the power sums

Newton's identities express each power sum through the elementary symmetric polynomials.  Over a
ring in which the integers are invertible they can be solved the other way, so every elementary
symmetric polynomial lies in the subalgebra generated by the power sums.

This is what turns a symmetric function of a spectrum into a polynomial in the *traces* of the
matrix, which are polynomials in its entries -- and hence in the coordinates of a linear family.

Main results:
* `esymm_mem_adjoin_psum` — **every elementary symmetric polynomial is a polynomial in the power
  sums**.
-/
import Mathlib.RingTheory.MvPolynomial.Symmetric.NewtonIdentities

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

variable (σ : Type*) [Fintype σ] (R : Type*) [CommRing R] [Algebra ℚ R]

/-- **Newton inversion.**  Over a `ℚ`-algebra every elementary symmetric polynomial lies in the
subalgebra generated by the power sums of positive order. -/
theorem esymm_mem_adjoin_psum : ∀ k : ℕ, MvPolynomial.esymm σ R k ∈
    Algebra.adjoin R (Set.range fun j : ℕ => MvPolynomial.psum σ R (j + 1)) := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    set A := Algebra.adjoin R (Set.range fun j : ℕ => MvPolynomial.psum σ R (j + 1)) with hA
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      rw [MvPolynomial.esymm_zero]
      exact one_mem _
    · have hpsumMem : ∀ j : ℕ, 0 < j → MvPolynomial.psum σ R j ∈ A := by
        intro j hj
        refine Algebra.subset_adjoin ⟨j - 1, ?_⟩
        show MvPolynomial.psum σ R (j - 1 + 1) = MvPolynomial.psum σ R j
        rw [Nat.sub_add_cancel hj]
      have hnewton := MvPolynomial.psum_eq_mul_esymm_sub_sum σ R k hk
      set Ssum := ∑ a ∈ Finset.HasAntidiagonal.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
        (-1 : MvPolynomial σ R) ^ a.1 * MvPolynomial.esymm σ R a.1 *
          MvPolynomial.psum σ R a.2 with hSsum
      have hSmem : Ssum ∈ A := by
        rw [hSsum]
        refine Subalgebra.sum_mem _ fun a ha => ?_
        rw [Finset.mem_filter] at ha
        obtain ⟨hmem, hIoo⟩ := ha
        have hsum : a.1 + a.2 = k := Finset.mem_antidiagonal.mp hmem
        have h1 : a.1 < k := hIoo.2
        have h2 : 0 < a.2 := by omega
        refine Subalgebra.mul_mem _ (Subalgebra.mul_mem _ ?_ (ih a.1 h1)) (hpsumMem a.2 h2)
        exact Subalgebra.pow_mem _ (neg_mem (one_mem _)) _
      set u : MvPolynomial σ R := (-1 : MvPolynomial σ R) ^ (k + 1) with hu
      have husq : u * u = 1 := by
        rw [hu, ← pow_add]
        rw [show k + 1 + (k + 1) = 2 * (k + 1) by ring, pow_mul]
        norm_num
      have hkey : (k : MvPolynomial σ R) * MvPolynomial.esymm σ R k
          = u * (MvPolynomial.psum σ R k + Ssum) := by
        rw [hnewton]
        have hstep : u * (u * (k : MvPolynomial σ R) * MvPolynomial.esymm σ R k - Ssum + Ssum)
            = (u * u) * ((k : MvPolynomial σ R) * MvPolynomial.esymm σ R k) := by ring
        rw [hstep, husq, one_mul]
      have hcastC : (k : MvPolynomial σ R) = MvPolynomial.C (k : R) := (map_natCast _ k).symm
      have hinv : MvPolynomial.C (algebraMap ℚ R (1 / (k : ℚ))) * (k : MvPolynomial σ R) = 1 := by
        rw [hcastC, ← map_mul]
        have hkR : (k : R) = algebraMap ℚ R (k : ℚ) := (map_natCast (algebraMap ℚ R) k).symm
        rw [hkR, ← map_mul, one_div, inv_mul_cancel₀ (by exact_mod_cast hk.ne'), map_one, map_one]
      have hrepr : MvPolynomial.esymm σ R k
          = MvPolynomial.C (algebraMap ℚ R (1 / (k : ℚ))) *
            (u * (MvPolynomial.psum σ R k + Ssum)) := by
        rw [← hkey, ← mul_assoc, hinv, one_mul]
      rw [hrepr]
      refine Subalgebra.mul_mem _ ?_ (Subalgebra.mul_mem _ ?_ ?_)
      · have := Subalgebra.algebraMap_mem A (algebraMap ℚ R (1 / (k : ℚ)))
        rwa [MvPolynomial.algebraMap_eq] at this
      · exact Subalgebra.pow_mem _ (neg_mem (one_mem _)) _
      · exact Subalgebra.add_mem _ (hpsumMem k hk) hSmem

end

end GaloisForLFunctions.HTGeometry
