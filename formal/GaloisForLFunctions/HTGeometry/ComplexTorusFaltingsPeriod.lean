import GaloisForLFunctions.HTGeometry.DualZLatticeCovolume
import Mathlib.LinearAlgebra.Matrix.SchurComplement
import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# Faltings periods of a complex torus and of its dual

Let `A = ℂ^g / Λ` be a complex torus with period lattice `Λ = M ℤ^{2g}` for an invertible real
`2g × 2g` matrix `M`, written here with the row convention (`Λ` is the `ℤ`-span of the rows of `M`).
The Hodge line `ω_A` is generated by `dz₁ ∧ … ∧ dz_g` and carries the Faltings metric

`‖ω‖² = C(g) · |∫_{A(ℂ)} ω ∧ ω̄|`.

This file records the two quantitative ingredients of Proposition 4.1 of Suzuki, *Duality invariance
of Faltings heights, Hodge line bundles and global periods* (arXiv:2504.04993):

* `ComplexTorusPeriod.norm_det_dzFrame`: the frame change from the real coframe
  `(dx₁, …, dx_g, dy₁, …, dy_g)` to `(dz₁, …, dz_g, dz̄₁, …, dz̄_g)` has determinant `(-2i)^g`,
  of absolute value `2 ^ g`.  This is the source of the factor `2 ^ g` in
  `‖dz₁ ∧ … ∧ dz_g‖² = C(g) · 2^g · |det M|`.
* `ComplexTorusPeriod.faltingsNormSq_eq_sq_det_mul_dual`: with
  `‖dz₁ ∧ … ∧ dz_g‖² = C(g) · 2^g · covol(Λ)` and the dual torus `B = ℂ^g / (Mᵀ)⁻¹ ℤ^{2g}`,

  `‖dz₁ ∧ … ∧ dz_g‖²_A = (det M)² · ‖dz*₁ ∧ … ∧ dz*_g‖²_B`,

  which is exactly Suzuki's conclusion that the canonical isomorphism `ω_A ≅ ω_B` — which sends
  `dz₁ ∧ … ∧ dz_g` to `±(det M) · dz*₁ ∧ … ∧ dz*_g` — is an isometry.

What is *not* formalised here is the identification of the transition factor `±det M` with the
canonical isomorphism `ω_A ≅ ω_B` of (0013); that identification uses Serre duality on a complex
torus and the Appell–Humbert description of `Pic⁰`, neither of which exists in mathlib.  Everything
quantitative around it is proved.
-/

namespace GaloisForLFunctions.HTGeometry.ComplexTorusPeriod

open Matrix DualZLattice

/-! ### The `2 ^ g` from the holomorphic coframe -/

/-- The matrix of the coframe `(dz₁, …, dz_g, dz̄₁, …, dz̄_g)` in the real coframe
`(dx₁, …, dx_g, dy₁, …, dy_g)`:  `dz_k = dx_k + i dy_k`, `dz̄_k = dx_k - i dy_k`. -/
noncomputable def dzFrame (g : ℕ) : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ :=
  Matrix.fromBlocks (1 : Matrix (Fin g) (Fin g) ℂ) (Complex.I • (1 : Matrix (Fin g) (Fin g) ℂ))
    (1 : Matrix (Fin g) (Fin g) ℂ) ((-Complex.I) • (1 : Matrix (Fin g) (Fin g) ℂ))

/-- `det (dz₁ ∧ … ∧ dz̄_g / dx₁ ∧ … ∧ dy_g) = (-2i)^g`, the `g`-fold product of
`dz ∧ dz̄ = -2i · dx ∧ dy`. -/
theorem det_dzFrame (g : ℕ) : (dzFrame g).det = (-2 * Complex.I) ^ g := by
  have hinv : Invertible ((-Complex.I) • (1 : Matrix (Fin g) (Fin g) ℂ)) :=
    ⟨Complex.I • (1 : Matrix (Fin g) (Fin g) ℂ), by simp [smul_smul, Complex.I_mul_I],
      by simp [smul_smul, Complex.I_mul_I]⟩
  rw [dzFrame, Matrix.det_fromBlocks₂₂]
  have hinvOf : ⅟((-Complex.I) • (1 : Matrix (Fin g) (Fin g) ℂ)) = Complex.I • 1 :=
    invOf_eq_right_inv (by simp [smul_smul, Complex.I_mul_I])
  rw [hinvOf]
  have hblock : (1 : Matrix (Fin g) (Fin g) ℂ)
      - (Complex.I • (1 : Matrix (Fin g) (Fin g) ℂ)) * (Complex.I • 1) * 1
      = (2 : ℂ) • (1 : Matrix (Fin g) (Fin g) ℂ) := by
    simp [smul_smul, Complex.I_mul_I]
    module
  rw [hblock, Matrix.det_smul, Matrix.det_smul, Matrix.det_one, mul_one, mul_one,
    Fintype.card_fin, ← mul_pow]
  ring_nf

/-- **The factor `2 ^ g`.** -/
theorem norm_det_dzFrame (g : ℕ) : ‖(dzFrame g).det‖ = 2 ^ g := by
  rw [det_dzFrame, norm_pow]
  congr 1
  simp [Complex.norm_def, Complex.normSq_apply]

/-! ### Faltings norms of a period lattice and its dual -/

variable {g : ℕ}

/-- `‖dz₁ ∧ … ∧ dz_g‖²` for the complex torus with period lattice the row lattice of `M`, with
normalisation constant `C`. -/
noncomputable def faltingsNormSq (C : ℝ) (g : ℕ)
    (M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ) : ℝ :=
  C * 2 ^ g * ZLattice.covolume (rowLattice M)

theorem faltingsNormSq_eq (C : ℝ) {M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ}
    (hM : IsUnit M.det) : faltingsNormSq C g M = C * 2 ^ g * |M.det| := by
  rw [faltingsNormSq, covolume_rowLattice M hM]

theorem det_inv_transpose (M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ) :
    ((M⁻¹)ᵀ).det = (M.det)⁻¹ := by
  rw [Matrix.det_transpose, Matrix.det_nonsing_inv, Ring.inverse_eq_inv']

/-- The dual torus `B = ℂ^g / (Mᵀ)⁻¹ ℤ^{2g}` has Faltings norm `C · 2^g · |det M|⁻¹`. -/
theorem faltingsNormSq_dual (C : ℝ) {M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ}
    (hM : IsUnit M.det) :
    faltingsNormSq C g ((M⁻¹)ᵀ) = C * 2 ^ g * |M.det|⁻¹ := by
  rw [faltingsNormSq_eq C (isUnit_det_inv_transpose hM), det_inv_transpose M, abs_inv]

/-- **Duality invariance of the complex period.**  The canonical isomorphism `ω_A ≅ ω_B` scales the
generator by `det M`, and with that scaling the Faltings norms of `A` and of its dual `B` agree. -/
theorem faltingsNormSq_eq_sq_det_mul_dual (C : ℝ)
    {M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ} (hM : IsUnit M.det) :
    faltingsNormSq C g M = (M.det) ^ 2 * faltingsNormSq C g ((M⁻¹)ᵀ) := by
  have hne : M.det ≠ 0 := hM.ne_zero
  rw [faltingsNormSq_eq C hM, faltingsNormSq_dual C hM]
  have habs : |M.det| ≠ 0 := abs_ne_zero.mpr hne
  field_simp
  rw [sq_abs]

/-- The product of the two Faltings norms is independent of the period matrix. -/
theorem faltingsNormSq_mul_dual (C : ℝ) {M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℝ}
    (hM : IsUnit M.det) :
    faltingsNormSq C g M * faltingsNormSq C g ((M⁻¹)ᵀ) = (C * 2 ^ g) ^ 2 := by
  have hne : M.det ≠ 0 := hM.ne_zero
  have habs : |M.det| ≠ 0 := abs_ne_zero.mpr hne
  rw [faltingsNormSq_eq C hM, faltingsNormSq_dual C hM]
  field_simp

end GaloisForLFunctions.HTGeometry.ComplexTorusPeriod
