import GaloisForLFunctions.HTGeometry.RittScalingMonomial
import GaloisForLFunctions.HTGeometry.RittPrefixFieldStability

/-!
# The classification at jet order one

The first jet prefix field is the simple extension `K⟮τ⟯`, and the shift scales its generator,
`σ τ = q·τ`.  So the scaling classification applies verbatim with the base field itself as the field
of coefficients: a solution of

`σ V = c·V + α·τ + β`,   `α`, `β` in the base,

either splits off a pure power relation `ψ(w) = q^s·w` with `s ≠ 0`, or an affine relation
`ψ(w) = q^s·c·w + h` with `h ≠ 0`, or is a monomial `u·τ^j` whose inhomogeneity vanishes and whose
coefficient satisfies `ψ(u) = q^{−j}·c·u`.

The first alternative is Ritt's order-one form with exponent pair `(s, 0)`; the second is an affine
transport equation; the third is the one shape that is a genuine solution — the tautology
`σ(τ^j) = q^j·τ^j`.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The first jet prefix field is the simple extension generated by the linearizer. -/
theorem jetPrefixField_one (Fr : RittFrame K L) (τ : L) :
    Fr.jetPrefixField τ 1 = IntermediateField.adjoin K ({τ} : Set L) := by
  rw [RittFrame.jetPrefixField]
  congr 1
  ext x
  constructor
  · rintro ⟨j, hj, rfl⟩
    have hj0 : j = 0 := by omega
    rw [hj0]
    exact rfl
  · rintro rfl
    exact ⟨0, by omega, rfl⟩

/-- **The classification at jet order one.** -/
theorem level_one_classification (Fr : RittFrame K L) {τ : L} {q : K} (hq : q ≠ 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ) (htr : Transcendental K τ)
    {V : L} (hV0 : V ≠ 0) (hV : V ∈ Fr.jetPrefixField τ 1)
    {c α β : K} (hc : c ≠ 0)
    (hrel : Fr.σ V = algebraMap K L c * V + (algebraMap K L α * τ + algebraMap K L β)) :
    (∃ (w : K) (s : ℤ), w ≠ 0 ∧ s ≠ 0 ∧ Fr.ψ w = q ^ s * w) ∨
    (∃ (w : K) (s : ℤ) (h : K), w ≠ 0 ∧ h ≠ 0 ∧ (h = β ∨ h = α / q) ∧
      Fr.ψ w = q ^ s * c * w + h) ∨
    (∃ (u : K) (j : ℤ), u ≠ 0 ∧ α = 0 ∧ β = 0 ∧ V = algebraMap K L u * τ ^ j ∧
      Fr.ψ u = q ^ (-j) * c * u) := by
  have hVadj : V ∈ IntermediateField.adjoin K ({τ} : Set L) := by
    rwa [jetPrefixField_one Fr τ] at hV
  exact scaling_dichotomy_of_mem_adjoin (E := K) Fr.σ Fr.ψ Fr.comp htr hq hc hshift hV0 hVadj hrel

end GaloisForLFunctions.HTGeometry
