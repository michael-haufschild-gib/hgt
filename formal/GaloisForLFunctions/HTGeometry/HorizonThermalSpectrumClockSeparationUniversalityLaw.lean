/-- **Infinite phase-state law.**  Every derivation-closed algebraic state field that contains a
normalized horizon phase has at least countably infinite transcendence degree over the complete,
possibly infinite, thermal-intensity field. -/
theorem
    aleph0_le_trdeg_normalizedHorizonBogoliubovPhaseAtlas_intensityField
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (j : ι)
    (S : IntermediateField
