/-- On the physical imaginary-frequency line, opposite frequency is complex conjugation for the
Gamma carrier. -/
theorem gamma_imaginary_conjugate_frequency (x : ℝ) :
    Complex.Gamma (-(Complex.I * x)) =
      star (Complex.Gamma (Complex.I * x)) := by
  simpa using (Complex.Gamma_conj (Complex.I * (x : ℂ)))

/-- Exact imaginary-axis Gamma reflection identity underlying the thermal horizon spectrum. -/
theorem gamma_imaginary_reflection_planck
    (x : ℝ) (hx : x ≠ 0) :
    Complex.Gamma (Complex.I * x) *
        Complex.Gamma (-(Complex.I * x)) =
      (Real.pi : ℂ) /
        ((x : ℂ) * Complex.sinh (Real.pi * x)) := by
  let z : ℂ := Complex.I * x
  have hz : z ≠ 0 := mul_ne_zero Complex.I_ne_zero (by exact_mod_cast hx)
  have href := Complex.Gamma_mul_Gamma_one_sub z
  rw [show 1 - z = -z + 1 by ring,
    Complex.Gamma_add_one (-z) (neg_ne_zero.mpr hz)] at href
  have hdiv := congrArg (fun w : ℂ => w / (-z)) href
  have hgamma :
      Complex.Gamma z * Complex.Gamma (-z) =
        ((Real.pi : ℂ) / Complex.sin (Real.pi * z)) / (-z) := by
    field_simp [hz] at hdiv ⊢
    · simpa [mul_assoc, mul_left_comm, mul_comm] using hdiv
  rw [hgamma]
  change
    ((Real.pi : ℂ) /
      Complex.sin ((Real.pi : ℂ) * (Complex.I * (x : ℂ)))) /
        (-(Complex.I * (x : ℂ))) =
      (Real.pi : ℂ) /
        ((x : ℂ) * Complex.sinh ((Real.pi : ℂ) * (x : ℂ)))
  have hsReal : Real.sinh (Real.pi * x) ≠ 0 := by
    intro hs
    have harg : Real.pi * x = 0 := by
      apply Real.sinh_injective
      simpa using hs
    exact hx (mul_eq_zero.mp harg |>.resolve_left Real.pi_ne_zero)
  have hs :
      Complex.sinh ((Real.pi : ℂ) * (x : ℂ)) ≠ 0 := by
    rw [← Complex.ofReal_mul, ← Complex.ofReal_sinh]
    exact Complex.ofReal_ne_zero.mpr hsReal
  rw [show (Real.pi : ℂ) * (Complex.I * (x : ℂ)) =
      ((Real.pi : ℂ) * (x : ℂ)) * Complex.I by ring,
    Complex.sin_mul_I]
  field_simp [hs, hx]
  simp [Complex.I_sq]

/-- After the elementary Boltzmann and frequency factors in the exact Bogoliubov coefficient are
included, Gamma reflection is exactly the Planck denominator. -/
theorem gamma_imaginary_thermal_factor
    (x : ℝ) (hx : x ≠ 0) :
    (x : ℂ) * Complex.exp (-(Real.pi : ℂ) * (x : ℂ)) *
        (Complex.Gamma (Complex.I * x) *
          Complex.Gamma (-(Complex.I * x))) =
      (2 * (Real.pi : ℂ)) /
        (Complex.exp (2 * (Real.pi : ℂ) * (x : ℂ)) - 1) := by
  rw [gamma_imaginary_reflection_planck x hx]
  have hxC : (x : ℂ) ≠ 0 := by exact_mod_cast hx
  have hsReal : Real.sinh (Real.pi * x) ≠ 0 := by
    intro hs
    have harg : Real.pi * x = 0 := by
      apply Real.sinh_injective
      simpa using hs
    exact hx (mul_eq_zero.mp harg |>.resolve_left Real.pi_ne_zero)
  have hs :
      Complex.sinh ((Real.pi : ℂ) * (x : ℂ)) ≠ 0 := by
    rw [← Complex.ofReal_mul, ← Complex.ofReal_sinh]
    exact Complex.ofReal_ne_zero.mpr hsReal
  have htwoexp :
      Complex.exp (2 * (Real.pi : ℂ) * (x : ℂ)) - 1 ≠ 0 := by
    have harg : 2 * Real.pi * x ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hx
    have hreal : Real.exp (2 * Real.pi * x) ≠ 1 := by
      simpa [Real.exp_eq_one_iff] using harg
    have hcast :
        Complex.exp ((2 * Real.pi * x : ℝ) : ℂ) - 1 ≠ 0 := by
      rw [← Complex.ofReal_exp]
      exact sub_ne_zero.mpr (by exact_mod_cast hreal)
    convert hcast using 1
    push_cast
    ring
  ring_nf at hs htwoexp ⊢
  field_simp [hxC, hs, htwoexp]
  rw [mul_comm (Complex.sinh _) 2, Complex.two_sinh]
  rw [mul_add, mul_neg, mul_one, ← Complex.exp_add]
  ring_nf

/-! ## Exact phase-clock transition on the physical frequency ray -/

/-- Universal vertical Gamma phase slope with arbitrary positive real shift and arbitrary
linear phase calibration. -/
def gammaVerticalLinearPhaseSlope (sigma calibration x : ℝ) : ℝ :=
  (Complex.digamma ((sigma : ℂ) + (x : ℂ) * Complex.I)).re - calibration

/-- Exact curvature formula for every positive-shift vertical Gamma phase. -/
theorem hasDerivAt_gammaVerticalLinearPhaseSlope
    {sigma : ℝ} (hsigma : 0 < sigma) (calibration x : ℝ) :
    HasDerivAt (gammaVerticalLinearPhaseSlope sigma calibration)
      (-(deriv Complex.digamma
        ((sigma : ℂ) + (x : ℂ) * Complex.I)).im) x := by
  have hpos : 0 < (((sigma : ℂ) + (x : ℂ) * Complex.I).re) := by
    simpa using hsigma
  have houter :=
    (RHTower.digamma_analyticOnNhd_re_pos _ hpos).differentiableAt.hasDerivAt
  have hinner : HasDerivAt
      (fun u : ℝ => (sigma : ℂ) + (u : ℂ) * Complex.I) Complex.I x := by
    convert! (((Complex.ofRealCLM.hasDerivAt (x := x)).mul_const Complex.I).const_add
      (sigma : ℂ)) using 1
    simp
  have hcomp := (houter.hasFDerivAt.restrictScalars ℝ).comp x hinner.hasFDerivAt
  have hpsi : HasDerivAt
      (fun u : ℝ => Complex.digamma ((sigma : ℂ) + (u : ℂ) * Complex.I))
      (deriv Complex.digamma
        ((sigma : ℂ) + (x : ℂ) * Complex.I) * Complex.I) x := by
    simpa [Function.comp_def, mul_comm] using hcomp.hasDerivAt
  have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt x hpsi
  unfold gammaVerticalLinearPhaseSlope
  convert! hre.sub_const calibration using 1
  change -(deriv Complex.digamma (↑sigma + ↑x * I)).im =
    (deriv Complex.digamma (↑sigma + ↑x * I) * I).re
  rw [Complex.mul_re]
  simp

theorem continuous_gammaVerticalLinearPhaseSlope
    {sigma : ℝ} (hsigma : 0 < sigma) (calibration : ℝ) :
    Continuous (gammaVerticalLinearPhaseSlope sigma calibration) := by
  rw [continuous_iff_continuousAt]
  intro x
  exact (hasDerivAt_gammaVerticalLinearPhaseSlope hsigma calibration x).continuousAt

/-- **Universal positive Gamma phase-dispersion law.**  Every positive-shift vertical Gamma phase
has strictly positive curvature at every positive frequency, for every linear calibration. -/
theorem deriv_gammaVerticalLinearPhaseSlope_pos
    {sigma x : ℝ} (hsigma : 0 < sigma) (calibration : ℝ) (hx : 0 < x) :
    0 < deriv (gammaVerticalLinearPhaseSlope sigma calibration) x := by
  rw [(hasDerivAt_gammaVerticalLinearPhaseSlope hsigma calibration x).deriv]
  exact neg_pos.mpr (RHTower.deriv_digamma_vertical_im_neg hsigma hx)

theorem strictMonoOn_gammaVerticalLinearPhaseSlope
    {sigma : ℝ} (hsigma : 0 < sigma) (calibration : ℝ) :
    StrictMonoOn (gammaVerticalLinearPhaseSlope sigma calibration) (Set.Ici 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ici 0)
  · exact (continuous_gammaVerticalLinearPhaseSlope hsigma calibration).continuousOn
  · intro x hx
    rw [interior_Ici, Set.mem_Ioi] at hx
    exact deriv_gammaVerticalLinearPhaseSlope_pos hsigma calibration hx

@[simp] theorem gammaVerticalLinearPhaseSlope_zero
    (sigma calibration : ℝ) :
    gammaVerticalLinearPhaseSlope sigma calibration 0 =
      (Complex.digamma (sigma : ℂ)).re - calibration := by
  simp [gammaVerticalLinearPhaseSlope]

theorem gammaVerticalLinearPhaseSlope_tendsto_atTop
    {sigma : ℝ} (hsigma : 0 < sigma) (calibration : ℝ) :
    Tendsto (gammaVerticalLinearPhaseSlope sigma calibration) atTop atTop := by
  have h :=
    re_digamma_vertical_tendsto_atTop (le_of_lt hsigma)
  have hsum := h.atTop_add (tendsto_const_nhds (x := -calibration))
  simpa [gammaVerticalLinearPhaseSlope, sub_eq_add_neg] using! hsum

/-- **Universal one-turn Gamma phase law.**  For every positive real shift and every linear phase
calibration, a positive stationary frequency exists uniquely exactly when the calibration exceeds
the real digamma value at the shift. -/
theorem existsUnique_pos_gammaVerticalLinearPhaseSlope_eq_zero_iff
    {sigma : ℝ} (hsigma : 0 < sigma) (calibration : ℝ) :
    (∃! x : ℝ, 0 < x ∧ gammaVerticalLinearPhaseSlope sigma calibration x = 0) ↔
      (Complex.digamma (sigma : ℂ)).re < calibration := by
  constructor
  · intro hexists
    by_contra hcalibration
    have hbase :
        calibration ≤ (Complex.digamma (sigma : ℂ)).re :=
      le_of_not_gt hcalibration
    obtain ⟨x, hx, -⟩ := hexists
    have hmono := strictMonoOn_gammaVerticalLinearPhaseSlope hsigma calibration
      (Set.mem_Ici.mpr le_rfl) (Set.mem_Ici.mpr hx.1.le) hx.1
    rw [gammaVerticalLinearPhaseSlope_zero] at hmono
    linarith
  · intro hcalibration
    have hzeroNeg : gammaVerticalLinearPhaseSlope sigma calibration 0 < 0 := by
      rw [gammaVerticalLinearPhaseSlope_zero]
      linarith
    have hevent :
        ∀ᶠ x : ℝ in atTop,
          0 < gammaVerticalLinearPhaseSlope sigma calibration x :=
      (gammaVerticalLinearPhaseSlope_tendsto_atTop hsigma calibration).eventually
        (eventually_gt_atTop 0)
    obtain ⟨y, hy, hySlope⟩ :=
      ((eventually_gt_atTop (0 : ℝ)).and hevent).exists
    obtain ⟨x, hxmem, hxzero⟩ := intermediate_value_Icc hy.le
      (continuous_gammaVerticalLinearPhaseSlope hsigma calibration).continuousOn
      (Set.mem_Icc.mpr ⟨hzeroNeg.le, hySlope.le⟩)
    have hxPos : 0 < x := by
      rcases hxmem with ⟨hxNonneg, -⟩
      exact lt_of_le_of_ne hxNonneg fun hx0 => by
        subst x
        linarith
    refine ⟨x, ⟨hxPos, hxzero⟩, ?_⟩
    intro z hz
    exact ((strictMonoOn_gammaVerticalLinearPhaseSlope hsigma calibration).injOn
      (Set.mem_Ici.mpr hxPos.le) (Set.mem_Ici.mpr hz.1.le)
      (hxzero.trans hz.2.symm)).symm

/-- Intrinsic dimensionless Gamma phase slope, regularized through the pole by the recurrence
`Re ψ(ix) = Re ψ(1+ix)` for `x ≠ 0`.  On the positive physical ray this is the derivative of
`arg Γ(ix)` with respect to `x`. -/
def intrinsicHorizonGammaPhaseSlope (x : ℝ) : ℝ :=
  (Complex.digamma ((1 : ℂ) + (x : ℂ) * Complex.I)).re

/-- Full dimensionless phase slope of the Carlitz--Willey coefficient after setting
`rho = omega'/kappa`.  The elementary channel phase contributes the constant `-log rho`. -/
def horizonBogoliubovChannelPhaseSlope (rho x : ℝ) : ℝ :=
  intrinsicHorizonGammaPhaseSlope x - Real.log rho

/-- The horizon channel slope is the unit-shift specialization of the universal vertical Gamma
phase law. -/
theorem horizonBogoliubovChannelPhaseSlope_eq_gammaVertical
    (rho x : ℝ) :
    horizonBogoliubovChannelPhaseSlope rho x =
      gammaVerticalLinearPhaseSlope 1 (Real.log rho) x := by
  rfl

/-- Phase-carrying part of the exact Carlitz--Willey coefficient.  Positive real normalization
factors are omitted because they do not affect its logarithmic phase slope. -/
def horizonBogoliubovPhaseCarrier (rho x : ℝ) : ℂ :=
  Complex.exp (-(Complex.I * (x : ℂ)) * (Real.log rho : ℂ)) *
    Complex.Gamma (Complex.I * (x : ℂ))

theorem horizonBogoliubovPhaseCarrier_ne_zero {rho x : ℝ} (hx : x ≠ 0) :
    horizonBogoliubovPhaseCarrier rho x ≠ 0 := by
  apply mul_ne_zero (Complex.exp_ne_zero _) (Complex.Gamma_ne_zero ?_)
  intro m h
  have him := congrArg Complex.im h
  simp only [Complex.mul_im, Complex.I_re, Complex.ofReal_im, Complex.I_im,
    Complex.ofReal_re, zero_mul, one_mul, Complex.neg_im, Complex.natCast_im, neg_zero] at him
  exact hx (by simpa using him)

/-- Exact real-frequency derivative of the phase-carrying Bogoliubov coefficient. -/
theorem hasDerivAt_horizonBogoliubovPhaseCarrier {rho x : ℝ} (hx : x ≠ 0) :
    HasDerivAt (horizonBogoliubovPhaseCarrier rho)
      (horizonBogoliubovPhaseCarrier rho x *
        (Complex.I *
          (Complex.digamma (Complex.I * (x : ℂ)) - (Real.log rho : ℂ)))) x := by
  let z : ℂ := Complex.I * (x : ℂ)
  have hpole : ∀ m : ℕ, z ≠ -(m : ℂ) := by
    intro m h
    have him := congrArg Complex.im h
    simp only [z, Complex.mul_im, Complex.I_re, Complex.ofReal_im, Complex.I_im,
      Complex.ofReal_re, zero_mul, one_mul, Complex.neg_im, Complex.natCast_im, neg_zero] at him
    exact hx (by simpa using him)
  have hinner : HasDerivAt (fun u : ℝ => Complex.I * (u : ℂ)) Complex.I x := by
    convert! Complex.ofRealCLM.hasFDerivAt.hasDerivAt.const_mul Complex.I using 1
    simp
  have hGammaOuter :=
    (Complex.differentiableAt_Gamma z hpole).hasDerivAt
  have hGammaComp :=
    (hGammaOuter.hasFDerivAt.restrictScalars ℝ).comp x hinner.hasFDerivAt
  have hGamma : HasDerivAt
      (fun u : ℝ => Complex.Gamma (Complex.I * (u : ℂ)))
      (deriv Complex.Gamma z * Complex.I) x := by
    simpa [z, Function.comp_def, mul_comm] using hGammaComp.hasDerivAt
  have hphaseArg : HasDerivAt
      (fun u : ℝ => -(Complex.I * (u : ℂ)) * (Real.log rho : ℂ))
      (-(Complex.I) * (Real.log rho : ℂ)) x := by
    convert! hinner.neg.mul_const (Real.log rho : ℂ) using 1
  have hExp : HasDerivAt
      (fun u : ℝ =>
        Complex.exp (-(Complex.I * (u : ℂ)) * (Real.log rho : ℂ)))
      (Complex.exp (-(Complex.I * (x : ℂ)) * (Real.log rho : ℂ)) *
        (-(Complex.I) * (Real.log rho : ℂ))) x := by
    have h := (Complex.hasDerivAt_exp
      (-(Complex.I * (x : ℂ)) * (Real.log rho : ℂ))).scomp x hphaseArg
    simpa [mul_comm] using! h
  have hmul := hExp.mul hGamma
  have hlog :
      deriv Complex.Gamma z =
        Complex.Gamma z * Complex.digamma z := by
    rw [Complex.digamma_def, logDeriv_apply]
    field_simp [Complex.Gamma_ne_zero hpole]
  unfold horizonBogoliubovPhaseCarrier
  rw [hlog] at hmul
  convert! hmul using 1
  ring

/-- The regularized intrinsic slope is exactly the physical imaginary-axis digamma slope away
from the zero-frequency pole. -/
theorem intrinsicHorizonGammaPhaseSlope_eq_physical {x : ℝ} (hx : x ≠ 0) :
    intrinsicHorizonGammaPhaseSlope x =
      (Complex.digamma (Complex.I * (x : ℂ))).re := by
  have hpole : ∀ m : ℕ, Complex.I * (x : ℂ) ≠ -(m : ℂ) := by
    intro m h
    have him := congrArg Complex.im h
    simp only [Complex.mul_im, Complex.I_re, Complex.ofReal_im, Complex.I_im,
      Complex.ofReal_re, zero_mul, one_mul, Complex.neg_im, Complex.natCast_im, neg_zero] at him
    exact hx (by simpa using him)
  have hrec := Complex.digamma_apply_add_one (Complex.I * (x : ℂ)) hpole
  have hinvRe : ((Complex.I * (x : ℂ))⁻¹).re = 0 := by
    rw [Complex.inv_re]
    simp
  unfold intrinsicHorizonGammaPhaseSlope
  rw [show (1 : ℂ) + (x : ℂ) * Complex.I =
      Complex.I * (x : ℂ) + 1 by ring, hrec, Complex.add_re, hinvRe, add_zero]

/-- The named channel slope is exactly the imaginary logarithmic derivative of the
phase-carrying Bogoliubov coefficient, hence the dimensionless group-delay observable. -/
theorem horizonBogoliubovPhaseCarrier_logDeriv_im
    {rho x : ℝ} (hx : x ≠ 0) :
    ((deriv (horizonBogoliubovPhaseCarrier rho) x) /
      horizonBogoliubovPhaseCarrier rho x).im =
