  have h :=
    (HTGeometry.hypertranscendentalOver_wignerSmithLogClock_iff
      horizonBogoliubovGammaAmplitudeMero).1
      hypertranscendentalOver_horizonBogoliubovGammaWignerSmithLogClockMero
  simpa [horizonBogoliubovGammaWignerSmithLogClockMero] using h

theorem differentialAlgebraicOver_normalizedHorizonBogoliubovIntensityAtlas
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
