  rw [mul_div_cancel_left₀ _ (horizonBogoliubovPhaseCarrier_ne_zero hx)]
  rw [Complex.mul_im]
  have hphys := intrinsicHorizonGammaPhaseSlope_eq_physical hx
  unfold horizonBogoliubovChannelPhaseSlope
  rw [hphys]
  simp

/-- Exact curvature of the intrinsic horizon phase slope. -/
theorem hasDerivAt_intrinsicHorizonGammaPhaseSlope (x : ℝ) :
