/-- **Thermal spectrum does not collapse the horizon clock.** For every index type and every
channelwise family of nonzero DA meromorphic prefactors, the complete normalized intensity atlas
of the exact solvable moving-horizon Gamma channel is DA, yet every complex amplitude, orientation
quotient, and logarithmic Wigner--Smith current remains HT over the field generated by all
intensities. -/
theorem horizonThermalSpectrumClock_fieldSeparationUniversality
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0) :
    HorizonThermalSpectrumClockSeparationCertificate
      gauge reflectedGauge := by
  exact
    ⟨differentialAlgebraicOver_normalizedHorizonBogoliubovIntensityAtlas
      gauge reflectedGauge hgauge hreflectedGauge,
    hypertranscendentalOver_normalizedHorizonBogoliubovAmplitudeAtlas_intensityField
      gauge reflectedGauge hgauge hreflectedGauge hgauge_ne,
    hypertranscendentalOver_normalizedHorizonBogoliubovPhaseAtlas_intensityField
      gauge reflectedGauge hgauge hreflectedGauge
      hgauge_ne hreflectedGauge_ne,
    hypertranscendentalOver_normalizedHorizonBogoliubovWignerSmithAtlas_intensityField
      gauge reflectedGauge hgauge hreflectedGauge hgauge_ne,
    hypertranscendentalOver_normalizedHorizonBogoliubovPhaseSlopeAtlas_intensityField
      gauge reflectedGauge hgauge hreflectedGauge
      hgauge_ne hreflectedGauge_ne⟩

