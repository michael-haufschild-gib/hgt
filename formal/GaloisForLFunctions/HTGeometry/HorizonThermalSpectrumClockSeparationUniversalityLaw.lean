/-- Above the exact channel threshold `rho = exp(-gamma)`, the full Carlitz--Willey phase has one
and only one positive stationary frequency. -/
theorem existsUnique_pos_horizonBogoliubovChannelPhaseSlope_eq_zero
    {rho : ℝ} (hrho : Real.exp (-Real.eulerMascheroniConstant) < rho) :
    ∃! x : ℝ, 0 < x ∧ horizonBogoliubovChannelPhaseSlope rho x = 0 := by
  have hrhoPos : 0 < rho :=
    lt_trans (Real.exp_pos _) hrho
  have hzeroNeg : horizonBogoliubovChannelPhaseSlope rho 0 < 0 := by
    rw [horizonBogoliubovChannelPhaseSlope, intrinsicHorizonGammaPhaseSlope_zero]
    have hlog : -Real.eulerMascheroniConstant < Real.log rho := by
      exact (Real.lt_log_iff_exp_lt hrhoPos).2 hrho
    linarith
  have hevent :
      ∀ᶠ x : ℝ in atTop, 0 < horizonBogoliubovChannelPhaseSlope rho x :=
    (horizonBogoliubovChannelPhaseSlope_tendsto_atTop rho).eventually
      (eventually_gt_atTop 0)
  obtain ⟨y, hy, hySlope⟩ :=
    ((eventually_gt_atTop (0 : ℝ)).and hevent).exists
  have hcont : Continuous (horizonBogoliubovChannelPhaseSlope rho) :=
    continuous_intrinsicHorizonGammaPhaseSlope.sub continuous_const
  obtain ⟨x, hxmem, hxzero⟩ := intermediate_value_Icc hy.le hcont.continuousOn
    (Set.mem_Icc.mpr ⟨hzeroNeg.le, hySlope.le⟩)
  have hxPos : 0 < x := by
    rcases hxmem with ⟨hxNonneg, -⟩
    exact lt_of_le_of_ne hxNonneg fun hx0 => by
      subst x
      linarith
  refine ⟨x, ⟨hxPos, hxzero⟩, ?_⟩
  intro z hz
  exact ((strictMonoOn_horizonBogoliubovChannelPhaseSlope rho).injOn
    (Set.mem_Ici.mpr hxPos.le) (Set.mem_Ici.mpr hz.1.le)
    (hxzero.trans hz.2.symm)).symm

/-- At or below the exact threshold, the full phase slope is strictly positive at every positive
frequency, so no stationary point exists. -/
theorem horizonBogoliubovChannelPhaseSlope_pos_of_le_threshold
    {rho x : ℝ} (hrho : 0 < rho)
    (hthreshold : rho ≤ Real.exp (-Real.eulerMascheroniConstant))
    (hx : 0 < x) :
    0 < horizonBogoliubovChannelPhaseSlope rho x := by
  have hslope :
      intrinsicHorizonGammaPhaseSlope 0 < intrinsicHorizonGammaPhaseSlope x :=
    strictMonoOn_intrinsicHorizonGammaPhaseSlope
      (Set.mem_Ici.mpr le_rfl) (Set.mem_Ici.mpr hx.le) hx
  have hlog : Real.log rho ≤ -Real.eulerMascheroniConstant := by
    exact (Real.log_le_iff_le_exp hrho).2 hthreshold
  rw [intrinsicHorizonGammaPhaseSlope_zero] at hslope
  unfold horizonBogoliubovChannelPhaseSlope
  linarith

/-- **Exact horizon phase-transition classification.**  A positive-frequency stationary point
exists uniquely exactly when the channel ratio exceeds `exp(-gamma)`. -/
theorem existsUnique_pos_horizonBogoliubovChannelPhaseSlope_eq_zero_iff
    {rho : ℝ} (hrho : 0 < rho) :
    (∃! x : ℝ, 0 < x ∧ horizonBogoliubovChannelPhaseSlope rho x = 0) ↔
      Real.exp (-Real.eulerMascheroniConstant) < rho := by
  constructor
  · intro hexists
    by_contra hthreshold
    have hle : rho ≤ Real.exp (-Real.eulerMascheroniConstant) :=
      le_of_not_gt hthreshold
    obtain ⟨x, hx, -⟩ := hexists
    have hpos :=
      horizonBogoliubovChannelPhaseSlope_pos_of_le_threshold hrho hle hx.1
    linarith
  · exact existsUnique_pos_horizonBogoliubovChannelPhaseSlope_eq_zero

/-- Once the unique stationary frequency is named, the full channel phase slope is negative
before it and positive after it. -/
theorem horizonBogoliubovChannelPhaseSlope_sign_of_eq_zero
    {rho T : ℝ} (hT : 0 < T)
    (hzero : horizonBogoliubovChannelPhaseSlope rho T = 0) :
    (∀ x, 0 ≤ x → x < T →
      horizonBogoliubovChannelPhaseSlope rho x < 0) ∧
    (∀ x, T < x →
      0 < horizonBogoliubovChannelPhaseSlope rho x) := by
  constructor
  · intro x hx hxT
    have hlt := strictMonoOn_horizonBogoliubovChannelPhaseSlope rho
      (Set.mem_Ici.mpr hx) (Set.mem_Ici.mpr hT.le) hxT
    linarith
  · intro x hTx
    have hlt := strictMonoOn_horizonBogoliubovChannelPhaseSlope rho
      (Set.mem_Ici.mpr hT.le) (Set.mem_Ici.mpr (hT.le.trans hTx.le)) hTx
    linarith

/-- Channelwise normalized horizon amplitude with its elementary/DA prefactor restored. -/
def normalizedHorizonBogoliubovAmplitudeAtlas
    {ι : Type*} (gauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  gauge i * horizonBogoliubovGammaAmplitudeMero

/-- Opposite-frequency normalized horizon amplitude with its independent elementary/DA
prefactor restored. -/
def normalizedHorizonBogoliubovReflectedAtlas
    {ι : Type*} (reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  reflectedGauge i * horizonBogoliubovGammaConjugateFrequencyMero

/-- Complete reflected-frequency intensity atlas of the normalized horizon channels. -/
def normalizedHorizonBogoliubovIntensityAtlas
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  normalizedHorizonBogoliubovAmplitudeAtlas gauge i *
    normalizedHorizonBogoliubovReflectedAtlas reflectedGauge i

/-- Complete orientation-quotient atlas of the normalized horizon channels. -/
def normalizedHorizonBogoliubovPhaseAtlas
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  normalizedHorizonBogoliubovAmplitudeAtlas gauge i /
    normalizedHorizonBogoliubovReflectedAtlas reflectedGauge i

/-- Complete logarithmic Wigner--Smith-current atlas of the normalized horizon channels. -/
def normalizedHorizonBogoliubovWignerSmithAtlas
    {ι : Type*} (gauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  HTGeometry.wignerSmithLogClock
    (normalizedHorizonBogoliubovAmplitudeAtlas gauge i)

/-- Logarithmic frequency slope of the complete orientation quotient.  On the physical
imaginary-frequency line, where opposite frequency is complex conjugation, this is the
unit-modulus phase slope up to the fixed coordinate factor. -/
def normalizedHorizonBogoliubovPhaseSlopeAtlas
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  HTGeometry.wignerSmithLogClock
    (normalizedHorizonBogoliubovPhaseAtlas gauge reflectedGauge i)

theorem normalizedHorizonBogoliubovIntensityAtlas_eq
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) :
    normalizedHorizonBogoliubovIntensityAtlas gauge reflectedGauge i =
      (gauge i * reflectedGauge i) *
        horizonBogoliubovGammaIntensityCoreMero := by
  unfold normalizedHorizonBogoliubovIntensityAtlas
    normalizedHorizonBogoliubovAmplitudeAtlas
    normalizedHorizonBogoliubovReflectedAtlas
    horizonBogoliubovGammaIntensityCoreMero
  ring

theorem normalizedHorizonBogoliubovPhaseAtlas_eq
    {ι : Type*} (gauge reflectedGauge : ι → meroField Set.univ)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (i : ι) :
    normalizedHorizonBogoliubovPhaseAtlas gauge reflectedGauge i =
      (gauge i / reflectedGauge i) *
        horizonBogoliubovGammaPhaseQuotientMero := by
  unfold normalizedHorizonBogoliubovPhaseAtlas
    normalizedHorizonBogoliubovAmplitudeAtlas
    normalizedHorizonBogoliubovReflectedAtlas
  rw [horizonBogoliubovGammaPhaseQuotientMero_eq_ratio]
  field_simp [hreflectedGauge_ne i,
    horizonBogoliubovGammaConjugateFrequencyMero_ne_zero]

/-- The normalized horizon Gamma amplitude itself is hypertranscendental. -/
