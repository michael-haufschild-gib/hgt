import GaloisForLFunctions.HTGeometry.EisensteinCriterion

/-!
# The tame different exponent from a monic relation

For an extension of discrete valuation rings and an element satisfying a monic relation of degree
the ramification index, being Eisenstein and presenting a uniformizer are the same condition.  Each
direction is a valuation computation, and together they reduce the different exponent to the bare
data of a monogenic presentation: the derivative at the presented element has valuation exactly one
less than the ramification index, with no hypothesis on the coefficients and none on the element
beyond its being a uniformizer.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsDiscreteValuationRing

variable {A B : Type*}
variable [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]

/-- **A monic relation of degree the ramification index is Eisenstein exactly when it presents a
uniformizer.** -/
theorem eisenstein_iff_addVal_eq_one (ψ : A →+* B) {πA : A} (hπA : Irreducible πA)
    (e : ℕ) (he : 0 < e) (hram : addVal B (ψ πA) = (e : ℕ∞))
    {g : A[X]} (hmonic : g.Monic) (hdeg : g.natDegree = e)
    {x : B} (hroot : eval x (g.map ψ) = 0) :
    ((∀ i < e, addVal A (g.coeff i) ≠ 0) ∧ addVal A (g.coeff 0) = 1) ↔ addVal B x = 1 := by
  constructor
  · rintro ⟨hcoef, hc0⟩
    exact addVal_eq_one_of_eisenstein_root ψ hπA e he hram hmonic hdeg
      (fun i hi _ => hcoef i hi) hc0 hroot
  · intro hx
    exact eisenstein_of_monic_uniformizer_root ψ hπA e he hram hx hmonic hdeg hroot

/-- **The tame different exponent of a monogenic presentation.**  Only the extension, the monic
relation and tameness are assumed. -/
theorem addVal_eval_derivative_of_monic_uniformizer_root (ψ : A →+* B) {πA : A}
    (hπA : Irreducible πA) (e : ℕ) (he : 0 < e) (hram : addVal B (ψ πA) = (e : ℕ∞))
    {x : B} (hx : addVal B x = 1)
    {g : A[X]} (hmonic : g.Monic) (hdeg : g.natDegree = e)
    (hroot : eval x (g.map ψ) = 0) (htame : addVal B ((e : ℕ) : B) = 0) :
    addVal B (eval x (derivative (g.map ψ))) = ((e - 1 : ℕ) : ℕ∞) := by
  obtain ⟨hcoef, _⟩ := eisenstein_of_monic_uniformizer_root ψ hπA e he hram hx hmonic hdeg hroot
  exact addVal_eval_derivative_map_eisenstein ψ hπA e he hram hmonic hdeg
    (fun i hi _ => hcoef i hi) x (irreducible_of_addVal_eq_one hx) htame

/-- **The local different of a monogenic presentation.**  The ideal generated by the derivative at
the presented uniformizer is the `(e-1)`-st power of the maximal ideal, so the ramification divisor
has coefficient exactly `e - 1`. -/
theorem span_eval_derivative_of_monic_uniformizer_root (ψ : A →+* B) {πA : A}
    (hπA : Irreducible πA) (e : ℕ) (he : 0 < e) (hram : addVal B (ψ πA) = (e : ℕ∞))
    {x : B} (hx : addVal B x = 1)
    {g : A[X]} (hmonic : g.Monic) (hdeg : g.natDegree = e)
    (hroot : eval x (g.map ψ) = 0) (htame : addVal B ((e : ℕ) : B) = 0) :
    Ideal.span {eval x (derivative (g.map ψ))} = Ideal.span {x ^ (e - 1)} := by
  obtain ⟨hcoef, _⟩ := eisenstein_of_monic_uniformizer_root ψ hπA e he hram hx hmonic hdeg hroot
  have hmonic' : (g.map ψ).Monic := hmonic.map ψ
  have hdeg' : (g.map ψ).natDegree = e := by rw [hmonic.natDegree_map, hdeg]
  have hcoef' : ∀ i ∈ Finset.range (g.map ψ).natDegree,
      (((g.map ψ).natDegree : ℕ) : ℕ∞) ≤ addVal B ((g.map ψ).coeff i) := by
    intro i hi
    rw [hdeg'] at hi ⊢
    rw [Polynomial.coeff_map]
    by_cases hzero : g.coeff i = 0
    · rw [hzero, map_zero, AddValuation.map_zero]
      exact le_top
    · exact le_addVal_map_of_addVal_ne_zero ψ hπA e hram hzero
        (hcoef i (Finset.mem_range.mp hi))
  have hmain := span_eval_derivative_monic hmonic' (by rw [hdeg']; exact he) hcoef' x
    (irreducible_of_addVal_eq_one hx) (by rw [hdeg']; exact htame)
  rwa [hdeg'] at hmain

end GaloisForLFunctions.HTGeometry
