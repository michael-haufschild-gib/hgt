import GaloisForLFunctions.HTGeometry.FractionRingDerivation
import GaloisForLFunctions.HTGeometry.MvPolynomialGradient
import Mathlib.Algebra.MvPolynomial.Supported
import Mathlib.RingTheory.Localization.NumDen

/-!
# Free coordinate fields

This file computes the simultaneous kernel of the coordinate derivations on a free rational
function field.  For a set `S` of coordinates, a rational function belongs to the subfield
generated by `S` exactly when every coordinate derivation outside `S` kills it.

The proof uses a reduced numerator and denominator in the multivariable polynomial UFD.  The
quotient rule and relative primality force each of their forbidden partial derivatives to divide
the polynomial it differentiates.  Strict decrease of total degree then makes those derivatives
zero, so both polynomials are supported on `S`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The literal rational function field on a free coordinate family. -/
abbrev FreeCoordinateRationalField (C σ : Type*) [Field C] :=
  FractionRing (MvPolynomial σ C)

/-- The `i`-th free coordinate in the literal fraction field. -/
def freeCoordinate
    (C σ : Type*) [Field C] (i : σ) : FreeCoordinateRationalField C σ :=
  algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)
    (MvPolynomial.X i)

/-- The rational subfield generated by the coordinates indexed by `S`. -/
def freeCoordinateField
    (C σ : Type*) [Field C] (S : Set σ) :
    IntermediateField C (FreeCoordinateRationalField C σ) :=
  IntermediateField.adjoin C (freeCoordinate C σ '' S)

/-- The polynomial `i`-th partial derivative, valued in the ambient fraction field. -/
def freeCoordinatePolynomialDerivation
    (C σ : Type*) [Field C] (i : σ) :
    Derivation C (MvPolynomial σ C) (FreeCoordinateRationalField C σ) :=
  (Algebra.linearMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)).compDer
    (MvPolynomial.pderiv i)

@[simp]
theorem freeCoordinatePolynomialDerivation_apply
    {C σ : Type*} [Field C] (i : σ) (p : MvPolynomial σ C) :
    freeCoordinatePolynomialDerivation C σ i p =
      algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)
        (MvPolynomial.pderiv i p) :=
  rfl

/-- The quotient-rule extension of the `i`-th partial derivative. -/
def freeCoordinateDerivation
    (C σ : Type*) [Field C] (i : σ) :
    Derivation C (FreeCoordinateRationalField C σ)
      (FreeCoordinateRationalField C σ) :=
  GaloisForLFunctions.fractionRingDerivation
    (freeCoordinatePolynomialDerivation C σ i)

@[simp]
theorem freeCoordinateDerivation_algebraMap
    {C σ : Type*} [Field C] (i : σ) (p : MvPolynomial σ C) :
    freeCoordinateDerivation C σ i
        (algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) p) =
      algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)
        (MvPolynomial.pderiv i p) := by
  rw [freeCoordinateDerivation,
    GaloisForLFunctions.fractionRingDerivation_algebraMap]
  rfl

@[simp]
theorem freeCoordinateDerivation_freeCoordinate_self
    {C σ : Type*} [Field C] (i : σ) :
    freeCoordinateDerivation C σ i (freeCoordinate C σ i) = 1 := by
  rw [freeCoordinate, freeCoordinateDerivation_algebraMap,
    MvPolynomial.pderiv_X_self, map_one]

theorem freeCoordinateDerivation_freeCoordinate_of_ne
    {C σ : Type*} [Field C] {i j : σ} (h : j ≠ i) :
    freeCoordinateDerivation C σ i (freeCoordinate C σ j) = 0 := by
  rw [freeCoordinate, freeCoordinateDerivation_algebraMap,
    MvPolynomial.pderiv_X_of_ne h, map_zero]

/-- The common kernel of all coordinate derivations outside `S`. -/
def freeCoordinateCommonKernelField
    (C σ : Type*) [Field C] (S : Set σ) :
    IntermediateField C (FreeCoordinateRationalField C σ) where
  carrier := {f | ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy i hi
    simp [hx i hi, hy i hi]
  mul_mem' := by
    intro x y hx hy i hi
    simp [Derivation.leibniz, hx i hi, hy i hi]
  algebraMap_mem' := by
    intro c i hi
    exact (freeCoordinateDerivation C σ i).map_algebraMap c
  inv_mem' := by
    intro x hx i hi
    simp [(freeCoordinateDerivation C σ i).leibniz_inv, hx i hi]

@[simp]
theorem mem_freeCoordinateCommonKernelField_iff
    {C σ : Type*} [Field C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) :
    f ∈ freeCoordinateCommonKernelField C σ S ↔
      ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0 :=
  Iff.rfl

/-- Every rational function generated by `S` is killed by each coordinate derivation outside
`S`. -/
theorem freeCoordinateField_le_commonKernel
    {C σ : Type*} [Field C] (S : Set σ) :
    freeCoordinateField C σ S ≤ freeCoordinateCommonKernelField C σ S := by
  rw [freeCoordinateField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨j, hj, rfl⟩ i hi
  exact freeCoordinateDerivation_freeCoordinate_of_ne
    (fun hji ↦ hi (hji ▸ hj))

/-- Over a domain, a multivariable polynomial dividing its own nonzero partial derivative would
have simultaneously no larger and strictly smaller total degree. -/
theorem mvPolynomial_pderiv_eq_zero_of_self_dvd
    {C σ : Type*} [Field C] (p : MvPolynomial σ C) (i : σ)
    (hdiv : p ∣ MvPolynomial.pderiv i p) :
    MvPolynomial.pderiv i p = 0 := by
  by_contra hne
  have hle := MvPolynomial.totalDegree_le_of_dvd_of_isDomain hdiv hne
  have hlt := GaloisForLFunctions.totalDegree_pderiv_lt p i hne
  exact (not_lt_of_ge hle) hlt

/-- In characteristic zero, every variable occurring in a polynomial has a nonzero partial
derivative. -/
theorem mvPolynomial_pderiv_ne_zero_of_mem_vars
    {C σ : Type*} [Field C] [CharZero C]
    {p : MvPolynomial σ C} {i : σ} (hi : i ∈ p.vars) :
    MvPolynomial.pderiv i p ≠ 0 := by
  obtain ⟨s, hs, his⟩ := (MvPolynomial.mem_vars_iff_mem_support i).mp hi
  exact GaloisForLFunctions.pderiv_ne_zero_of_mem_support hs his

/-- A polynomial supported on `S`, embedded into the fraction field, belongs to the rational
subfield generated by `S`. -/
theorem algebraMap_mem_freeCoordinateField_of_mem_supported
    {C σ : Type*} [Field C] {S : Set σ} {p : MvPolynomial σ C}
    (hp : p ∈ MvPolynomial.supported C S) :
    algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) p ∈
      freeCoordinateField C σ S := by
  rw [MvPolynomial.supported_eq_adjoin_X] at hp
  induction hp using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with ⟨i, hi, rfl⟩
      exact IntermediateField.subset_adjoin C (freeCoordinate C σ '' S) ⟨i, hi, rfl⟩
  | algebraMap c =>
      simpa only [IsScalarTower.algebraMap_apply C (MvPolynomial σ C)
        (FreeCoordinateRationalField C σ)] using
          (freeCoordinateField C σ S).algebraMap_mem c
  | add p q hp hq =>
      simpa only [map_add] using (freeCoordinateField C σ S).add_mem hp hq
  | mul p q hp hq =>
      simpa only [map_mul] using (freeCoordinateField C σ S).mul_mem hp hq

/-- **Free-coordinate partial-kernel theorem.** A rational function in free coordinates belongs
to the subfield generated by `S` exactly when every coordinate derivation outside `S` kills it. -/
theorem mem_freeCoordinateField_iff
    {C σ : Type*} [Field C] [CharZero C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) :
    f ∈ freeCoordinateField C σ S ↔
      ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0 := by
  constructor
  · intro hf
    exact freeCoordinateField_le_commonKernel S hf
  · intro hf
    let P := MvPolynomial σ C
    let F := FreeCoordinateRationalField C σ
    let p : P := IsFractionRing.num P f
    let q : P := IsFractionRing.den P f
    have hq : q ≠ 0 := (IsFractionRing.den P f).property
    have hqF : algebraMap P F q ≠ 0 :=
      (IsFractionRing.injective P F).ne hq
    have hrel : algebraMap P F p = f * algebraMap P F q := by
      exact (div_eq_iff hqF).mp (IsFractionRing.mk'_num_den' P f)
    have hcoprime : IsRelPrime p q := by
      simpa only [p, q] using IsFractionRing.num_den_reduced P f
    have hpqDeriv : ∀ i, i ∉ S →
        MvPolynomial.pderiv i p = 0 ∧ MvPolynomial.pderiv i q = 0 := by
      intro i hi
      have hderiv := congrArg (freeCoordinateDerivation C σ i) hrel
      simp only [freeCoordinateDerivation_algebraMap, Derivation.leibniz,
        smul_eq_mul, hf i hi, zero_mul, add_zero] at hderiv
      have hcrossF :
          algebraMap P F (MvPolynomial.pderiv i p * q) =
            algebraMap P F (p * MvPolynomial.pderiv i q) := by
        simp only [map_mul]
        rw [hderiv, hrel]
        ring
      have hcross :
          MvPolynomial.pderiv i p * q = p * MvPolynomial.pderiv i q :=
        (IsFractionRing.injective P F) hcrossF
      have hpdiv : p ∣ MvPolynomial.pderiv i p := by
        apply hcoprime.dvd_of_dvd_mul_right
        exact ⟨MvPolynomial.pderiv i q, hcross⟩
      have hqdiv : q ∣ MvPolynomial.pderiv i q := by
        apply hcoprime.symm.dvd_of_dvd_mul_left
        exact ⟨MvPolynomial.pderiv i p, by simpa [mul_comm] using hcross.symm⟩
      exact ⟨mvPolynomial_pderiv_eq_zero_of_self_dvd p i hpdiv,
        mvPolynomial_pderiv_eq_zero_of_self_dvd q i hqdiv⟩
    have hpSupported : p ∈ MvPolynomial.supported C S := by
      rw [MvPolynomial.mem_supported]
      intro i hi
      by_contra hiS
      exact mvPolynomial_pderiv_ne_zero_of_mem_vars hi (hpqDeriv i hiS).1
    have hqSupported : q ∈ MvPolynomial.supported C S := by
      rw [MvPolynomial.mem_supported]
      intro i hi
      by_contra hiS
      exact mvPolynomial_pderiv_ne_zero_of_mem_vars hi (hpqDeriv i hiS).2
    have hpField : algebraMap P F p ∈ freeCoordinateField C σ S :=
      algebraMap_mem_freeCoordinateField_of_mem_supported hpSupported
    have hqField : algebraMap P F q ∈ freeCoordinateField C σ S :=
      algebraMap_mem_freeCoordinateField_of_mem_supported hqSupported
    rw [← IsFractionRing.mk'_num_den' P f]
    exact (freeCoordinateField C σ S).div_mem hpField hqField

@[simp]
theorem freeCoordinateField_empty
    {C σ : Type*} [Field C] :
    freeCoordinateField C σ ∅ = ⊥ := by
  simp [freeCoordinateField]

@[simp]
theorem freeCoordinateField_univ
    {C σ : Type*} [Field C] [CharZero C] :
    freeCoordinateField C σ Set.univ = ⊤ := by
  rw [IntermediateField.eq_top_iff]
  intro f hf
  rw [mem_freeCoordinateField_iff]
  simp

/-- Empty-set specialization: the common kernel of every free coordinate derivation is exactly
the scalar coefficient field. -/
theorem all_freeCoordinateDerivations_eq_zero_iff
    {C σ : Type*} [Field C] [CharZero C]
    (f : FreeCoordinateRationalField C σ) :
    (∀ i, freeCoordinateDerivation C σ i f = 0) ↔
      ∃ c : C, f = algebraMap C (FreeCoordinateRationalField C σ) c := by
  rw [← mem_freeCoordinateField_iff (∅ : Set σ) f, freeCoordinateField_empty,
    IntermediateField.mem_bot]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨c, rfl⟩
  · rintro ⟨c, rfl⟩
    exact ⟨c, rfl⟩

/-- The tail field generated by every coordinate of order at least `n`. -/
def freeCoordinateTailField
    (C ι : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C (ι × ℕ)) :=
  freeCoordinateField C (ι × ℕ) {j | n ≤ j.2}

/-- Tail specialization of the partial-kernel theorem: membership in the order-`n` tail is
equivalent to annihilation by every lower-order coordinate derivation. -/
theorem mem_freeCoordinateTailField_iff
    {C ι : Type*} [Field C] [CharZero C] (n : ℕ)
    (f : FreeCoordinateRationalField C (ι × ℕ)) :
    f ∈ freeCoordinateTailField C ι n ↔
      ∀ i : ι, ∀ k < n, freeCoordinateDerivation C (ι × ℕ) (i, k) f = 0 := by
  rw [freeCoordinateTailField, mem_freeCoordinateField_iff]
  constructor
  · intro h i k hk
    exact h (i, k) (by simpa using hk)
  · intro h ⟨i, k⟩ hk
    exact h i k (by simpa using hk)

@[simp]
theorem freeCoordinateTailField_zero
    {C ι : Type*} [Field C] [CharZero C] :
    freeCoordinateTailField C ι 0 = ⊤ := by
  simp [freeCoordinateTailField]

end

end GaloisForLFunctions.HTGeometry
