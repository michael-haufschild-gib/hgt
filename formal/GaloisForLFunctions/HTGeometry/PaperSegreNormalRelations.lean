import GaloisForLFunctions.HTGeometry.PaperHomogeneousGeneratorIdeal
import GaloisForLFunctions.HTGeometry.SegreDiagonalRing

/-!
# Segre relations in the normal cone of the coordinate-block product ideal

Application of the OpenAI StableCoordinate Rees specialization mechanism,
ported at fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb. All generators and ideal
order bounds are supplied here over an arbitrary commutative coefficient ring.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

variable (K : Type*) [CommRing K] (m n : ℕ)

/-- The actual pair products in the native biprojective Cox ring. -/
def paperSegrePairGenerator (ij : Fin (m + 1) × Fin (n + 1)) :
    MvPolynomial (BiprojVar m n) K :=
  X (Sum.inl ij.1) * X (Sum.inr ij.2)

/-- Ideal generated by all left-right coordinate products. -/
def paperSegrePairIdeal : Ideal (MvPolynomial (BiprojVar m n) K) :=
  paperHomogeneousGeneratorIdeal (paperSegrePairGenerator K m n)

/-- This ideal is exactly the product of the two native coordinate-block ideals. -/
theorem paperSegrePairIdeal_eq_product :
    paperSegrePairIdeal K m n =
      Ideal.span (Set.range fun i : Fin (m + 1) => (X (Sum.inl i) : MvPolynomial (BiprojVar m n) K)) *
      Ideal.span (Set.range fun j : Fin (n + 1) => (X (Sum.inr j) : MvPolynomial (BiprojVar m n) K)) := by
  rw [paperSegrePairIdeal, paperHomogeneousGeneratorIdeal, Ideal.span_mul_span]
  congr 1
  ext p
  constructor
  · rintro ⟨⟨i, j⟩, rfl⟩
    exact ⟨X (Sum.inl i), ⟨i, rfl⟩, X (Sum.inr j), ⟨j, rfl⟩, rfl⟩
  · rintro ⟨x, ⟨i, rfl⟩, y, ⟨j, rfl⟩, rfl⟩
    exact ⟨(i, j), rfl⟩

/-- All data required by the source normal-relation theorem are proved for pair products. -/
def paperSegreNormalPresentation :
    PaperHomogeneousNormalPresentationData K (BiprojVar m n)
      (Fin (m + 1) × Fin (n + 1)) (paperSegrePairIdeal K m n) :=
  paperHomogeneousGeneratorNormalPresentation (paperSegrePairGenerator K m n) 2
    (Nat.succ_pos 1) (fun ij => (isHomogeneous_X K (Sum.inl ij.1)).mul
      (isHomogeneous_X K (Sum.inr ij.2)))

/-- The pair-product initial classes in the actual associated graded ring. -/
def paperSegreNormalMap : MvPolynomial (Fin (m + 1) × Fin (n + 1)) K →+*
    PaperIdealAssociatedGraded (paperSegrePairIdeal K m n) :=
  (paperSegreNormalPresentation K m n).polynomialMap

/-- Every scalar polynomial relation is preserved, and no new one appears. -/
theorem paperSegreNormalMap_relations_iff (p : MvPolynomial (Fin (m + 1) × Fin (n + 1)) K) :
    paperSegreNormalMap K m n p = 0 ↔ aeval (paperSegrePairGenerator K m n) p = 0 :=
  (paperSegreNormalPresentation K m n).polynomialMap_eq_zero_iff p

/-- Native Segre coordinates are the balanced pair monomials. -/
theorem paperSegreDiagonalPresentation_X (i : Fin (m + 1)) (j : Fin (n + 1)) :
    segreDiagonalPresentation K m n (X (i, j)) =
      AddMonoidAlgebra.single (segrePairExponent m n i j) 1 := by
  change AddMonoidAlgebra.mapDomain (segrePairMarginalBalanced m n)
    (AddMonoidAlgebra.single (Finsupp.single (i, j) 1) 1) = _
  rw [AddMonoidAlgebra.mapDomain_single]
  congr 1
  apply Subtype.ext
  exact segrePairMarginal_single m n i j 1

/-- Inclusion of a native Segre coordinate is the actual left-right pair product. -/
theorem paperSegreToBiprojective_pair (i : Fin (m + 1)) (j : Fin (n + 1)) :
    segreToBiprojective K m n (AddMonoidAlgebra.single (segrePairExponent m n i j) 1) =
      paperSegrePairGenerator K m n (i, j) := by
  change AddMonoidAlgebra.mapDomain (AddSubmonoid.subtype (segreExponentSubmonoid m n))
    (AddMonoidAlgebra.single (segrePairExponent m n i j) 1) = _
  rw [AddMonoidAlgebra.mapDomain_single]
  simp only [paperSegrePairGenerator, X, monomial_mul, mul_one]
  rfl

/-- The existing native Segre presentation is exactly pair-product substitution. -/
theorem paperSegrePairEvaluation_eq :
    aeval (paperSegrePairGenerator K m n) =
      (segreToBiprojective K m n).comp (segreDiagonalPresentation K m n) := by
  ext ij : 1
  rcases ij with ⟨i, j⟩
  simp only [aeval_X, AlgHom.comp_apply, paperSegreDiagonalPresentation_X,
    paperSegreToBiprojective_pair]

/-- The normal map has precisely the kernel of the existing native Segre presentation. -/
theorem paperSegreNormalMap_eq_zero_iff (p : MvPolynomial (Fin (m + 1) × Fin (n + 1)) K) :
    paperSegreNormalMap K m n p = 0 ↔ segreDiagonalPresentation K m n p = 0 := by
  rw [paperSegreNormalMap_relations_iff, paperSegrePairEvaluation_eq]
  change segreToBiprojective K m n (segreDiagonalPresentation K m n p) = 0 ↔ _
  exact (segreToBiprojective_injective K m n).eq_iff' (map_zero _)

end

end GaloisForLFunctions.HTGeometry
