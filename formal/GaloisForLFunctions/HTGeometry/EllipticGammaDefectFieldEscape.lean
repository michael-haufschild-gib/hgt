import GaloisForLFunctions.HTGeometry.EllipticGammaTranslatePacket
import GaloisForLFunctions.HTGeometry.ThetaGenericShift

/-!
# The elliptic gamma escapes the field generated by its own defects

The bottom layer of the all-order argument needs the genuine elliptic-gamma logarithmic derivative
to be hypertranscendental over the differential field generated by a finite separated family of its
external defects.  This is a free-block replication count in the differential matroid: if `Psi` were
differentially algebraic over the field generated by `|A|` defects, then the copy of that data
translated by a generic shift `w` would have rank at most `|A|` as well, while the two copies
together generate the defects at `A`, at `A + w` and at `w`, which are `2|A|+1` differentially
independent elements.  Submodularity of the matroid rank then gives `2|A|+1 <= 2|A|`.

* **`hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin`** — the escape law;
* **`ellipticGammaTranslatePacket_diffIndepOn_of_separated`** — hence the order-one translation
  packet is unconditionally differentially independent, over the constants and over every
  differentially algebraic extension.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions

open Bottcher HTGeometry

noncomputable section

attribute [local instance] ellipticGammaStructuralGeneratorRestrictedDifferential
  ellipticGammaStructuralGeneratorDifferentialAlgebra ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

/-! ## Elementary resonance bookkeeping -/

theorem ThetaTranslationNonresonant.neg {τ q h : ℂ}
    (hres : ThetaTranslationNonresonant τ q h) :
    ThetaTranslationNonresonant τ q (-h) := by
  rintro ⟨a, b, n, hab⟩
  refine hres ⟨-a, -b, -n, ?_⟩
  have hneg : h = -(-h) := by ring
  rw [hneg, hab]
  push_cast
  ring

theorem thetaTranslationNonresonant_ne_zero {τ q h : ℂ}
    (hres : ThetaTranslationNonresonant τ q h) : h ≠ 0 := by
  intro h0
  exact hres ⟨0, 0, 0, by simp [h0]⟩

/-! ## The defect identities -/

variable {sigma tau : ℂ}

/-- The defect at a sum is the translated defect plus the defect of the translation. -/
theorem ellipticGammaExternalLogDerivDefectMero_translate_add
    (a w : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    addTranslationMeroEquiv w
        (ellipticGammaExternalLogDerivDefectMero a sigma tau hsigma htau) +
      ellipticGammaExternalLogDerivDefectMero w sigma tau hsigma htau =
      ellipticGammaExternalLogDerivDefectMero (a + w) sigma tau hsigma htau := by
  rw [ellipticGammaExternalLogDerivDefectMero, ellipticGammaExternalLogDerivDefectMero,
    ellipticGammaExternalLogDerivDefectMero, map_sub, addTranslationMeroEquiv_add]
  have harg : w + a = a + w := by ring
  rw [harg]
  ring

/-! ## The escape law -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 800000 in
/-- **The genuine elliptic gamma escapes the differential field generated by its own defects.**
A free-block replication count: a differential-algebraic relation over the field of the `A`-defects
would make the block translated by a generic shift `w` have rank at most `|A|` too, while the two
blocks generate the `2|A|+1` independent defects at `A`, `A + w` and `w`. -/
theorem hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (A : Finset ℂ)
    (hnonres : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma a)
    (hsep : ∀ a ∈ A, ∀ b ∈ A, a ≠ b → ThetaTranslationNonresonant tau sigma (a - b)) :
    HypertranscendentalOver
      ↥(differentialAdjoin ℂ
        ((fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau) '' ↑A))
      (ellipticGammaLogDerivMero sigma tau hsigma htau) := by
  classical
  intro hDA
  set Ψ := ellipticGammaLogDerivMero sigma tau hsigma htau with hΨdef
  set Δ : ℂ → meroField (Set.univ : Set ℂ) :=
    fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau with hΔdef
  set M := differentialMatroid ℂ (meroField (Set.univ : Set ℂ)) with hMdef
  have hsubclos : ∀ X : Set (meroField (Set.univ : Set ℂ)), X ⊆ M.closure X := by
    intro X
    refine M.subset_closure X ?_
    rw [hMdef, differentialMatroid_ground]
    exact Set.subset_univ _
  have hclos : Ψ ∈ M.closure (Δ '' ↑A) :=
    differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin.mpr hDA
  -- a generic shift
  obtain ⟨w, hw⟩ := exists_thetaGenericShift tau sigma
    (insert 0 (A ∪ (A.image (fun a => -a) ∪ (A ×ˢ A).image (fun p => p.1 - p.2))))
  have hw0 : ThetaTranslationNonresonant tau sigma w := by
    have h := hw 0 (Finset.mem_insert_self _ _)
    simpa using h
  have hwa : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma (w + a) := fun a ha =>
    hw a (Finset.mem_insert_of_mem (Finset.mem_union_left _ ha))
  have hwna : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma (w + -a) := fun a ha =>
    hw (-a) (Finset.mem_insert_of_mem (Finset.mem_union_right _
      (Finset.mem_union_left _ (Finset.mem_image_of_mem _ ha))))
  have hwab : ∀ a ∈ A, ∀ b ∈ A, ThetaTranslationNonresonant tau sigma (w + (a - b)) :=
    fun a ha b hb => hw (a - b) (Finset.mem_insert_of_mem (Finset.mem_union_right _
      (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨(a, b), Finset.mem_product.mpr ⟨ha, hb⟩,
        rfl⟩))))
  -- the enlarged shift set
  set C : Finset ℂ := insert w (A ∪ A.image (fun a => a + w)) with hCdef
  have hzeroNotMem : (0 : ℂ) ∉ A := fun h0 =>
    thetaTranslationNonresonant_ne_zero (hnonres 0 h0) rfl
  have hwNotMem : w ∉ A ∪ A.image (fun a => a + w) := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hA | himg
    · exact thetaTranslationNonresonant_ne_zero (hwna w hA) (by ring)
    · obtain ⟨a, ha, hae⟩ := Finset.mem_image.mp himg
      have ha0 : a = 0 := by linear_combination hae
      exact hzeroNotMem (ha0 ▸ ha)
  have hdisj : Disjoint A (A.image (fun a => a + w)) := by
    rw [Finset.disjoint_left]
    intro a ha hmem
    obtain ⟨b, hb, hbe⟩ := Finset.mem_image.mp hmem
    have hzero : w + (b - a) = 0 := by linear_combination hbe
    exact thetaTranslationNonresonant_ne_zero (hwab b hb a ha) hzero
  have hcardC : C.card = 2 * A.card + 1 := by
    rw [hCdef, Finset.card_insert_of_notMem hwNotMem,
      Finset.card_union_of_disjoint hdisj,
      Finset.card_image_of_injective _ (add_left_injective w)]
    ring
  have hCmem : ∀ c ∈ C, c = w ∨ c ∈ A ∨ ∃ a ∈ A, a + w = c := by
    intro c hc
    rcases Finset.mem_insert.mp hc with h | h
    · exact Or.inl h
    · rcases Finset.mem_union.mp h with h | h
      · exact Or.inr (Or.inl h)
      · obtain ⟨a, ha, hae⟩ := Finset.mem_image.mp h
        exact Or.inr (Or.inr ⟨a, ha, hae⟩)
  have hCnonres : ∀ c ∈ C, ThetaTranslationNonresonant tau sigma c := by
    intro c hc
    rcases hCmem c hc with rfl | hA | ⟨a, ha, rfl⟩
    · exact hw0
    · exact hnonres c hA
    · have hcomm : a + w = w + a := by ring
      rw [hcomm]
      exact hwa a ha
  have hCsep : ∀ c ∈ C, ∀ d ∈ C, c ≠ d →
      ThetaTranslationNonresonant tau sigma (c - d) := by
    intro c hc d hd hcd
    rcases hCmem c hc with rfl | hcA | ⟨a, ha, rfl⟩
    · rcases hCmem d hd with rfl | hdA | ⟨b, hb, rfl⟩
      · exact absurd rfl hcd
      · have he : c - d = c + -d := by ring
        rw [he]
        exact hwna d hdA
      · have he : c - (b + c) = -b := by ring
        rw [he]
        exact (hnonres b hb).neg
    · rcases hCmem d hd with rfl | hdA | ⟨b, hb, rfl⟩
      · have he : c - d = -(d + -c) := by ring
        rw [he]
        exact (hwna c hcA).neg
      · exact hsep c hcA d hdA hcd
      · have he : c - (b + w) = -(w + (b - c)) := by ring
        rw [he]
        exact (hwab b hb c hcA).neg
    · rcases hCmem d hd with rfl | hdA | ⟨b, hb, rfl⟩
      · have he : a + d - d = a := by ring
        rw [he]
        exact hnonres a ha
      · have he : a + w - d = w + (a - d) := by ring
        rw [he]
        exact hwab a ha d hdA
      · have hab : a ≠ b := by
          intro hab
          exact hcd (by rw [hab])
        have he : a + w - (b + w) = a - b := by ring
        rw [he]
        exact hsep a ha b hb hab
  -- the enlarged defect family is differentially independent
  have hCindep : DifferentialIndependent ℂ (fun c : {x // x ∈ C} => Δ (c : ℂ)) :=
    (differentialIndependent_meromorphicRationalCoordinateField_iff _).mp
      (ellipticGammaExternalDefectFamily_differentialIndependent_rationalBase
        (fun c : {x // x ∈ C} => (c : ℂ)) sigma tau hsigma htau hindependent
        (fun j => hCnonres (j : ℂ) j.2)
        (fun i j hji => hCsep (j : ℂ) j.2 (i : ℂ) i.2 (fun hh => hji (Subtype.ext hh))))
  -- the two rank-bounded blocks
  set σw := (addTranslationMeroDifferentialAlgEquiv w).toDifferentialSemilinearEquiv with hσwdef
  set S₁ : Set (meroField (Set.univ : Set ℂ)) := insert Ψ (Δ '' ↑A) with hS1def
  set S₂ : Set (meroField (Set.univ : Set ℂ)) := σw.ambientEquiv '' S₁ with hS2def
  have hS1rank : M.eRk S₁ ≤ (A.card : ℕ∞) := by
    have hsub : S₁ ⊆ M.closure (Δ '' ↑A) := Set.insert_subset hclos (hsubclos _)
    calc M.eRk S₁ ≤ M.eRk (M.closure (Δ '' ↑A)) := M.eRk_mono hsub
      _ = M.eRk (Δ '' ↑A) := M.eRk_closure_eq _
      _ ≤ (Δ '' (↑A : Set ℂ)).encard := M.eRk_le_encard _
      _ ≤ ((↑A : Set ℂ)).encard := Set.encard_image_le _ _
      _ = (A.card : ℕ∞) := Set.encard_coe_eq_coe_finsetCard A
  have hclos2 : σw.ambientEquiv Ψ ∈ M.closure (σw.ambientEquiv '' (Δ '' ↑A)) :=
    (DifferentialSemilinearEquiv.mem_differentialMatroid_closure_image_iff
      σw (Δ '' ↑A) Ψ).mpr hclos
  have hS2rank : M.eRk S₂ ≤ (A.card : ℕ∞) := by
    have himage : S₂ = insert (σw.ambientEquiv Ψ) (σw.ambientEquiv '' (Δ '' ↑A)) := by
      rw [hS2def, hS1def, Set.image_insert_eq]
    have hsub : S₂ ⊆ M.closure (σw.ambientEquiv '' (Δ '' ↑A)) := by
      rw [himage]
      exact Set.insert_subset hclos2 (hsubclos _)
    calc M.eRk S₂ ≤ M.eRk (M.closure (σw.ambientEquiv '' (Δ '' ↑A))) := M.eRk_mono hsub
      _ = M.eRk (σw.ambientEquiv '' (Δ '' ↑A)) := M.eRk_closure_eq _
      _ ≤ (σw.ambientEquiv '' (Δ '' (↑A : Set ℂ))).encard := M.eRk_le_encard _
      _ ≤ (Δ '' (↑A : Set ℂ)).encard := Set.encard_image_le _ _
      _ ≤ ((↑A : Set ℂ)).encard := Set.encard_image_le _ _
      _ = (A.card : ℕ∞) := Set.encard_coe_eq_coe_finsetCard A
  -- the enlarged defects live in the field generated by the two blocks
  have hmemfield : ∀ c ∈ C, Δ c ∈ differentialAdjoin ℂ (S₁ ∪ S₂) := by
    have hΨmem : Ψ ∈ differentialAdjoin ℂ (S₁ ∪ S₂) :=
      subset_differentialAdjoin ℂ _ (Or.inl (Set.mem_insert _ _))
    have hTΨmem : σw.ambientEquiv Ψ ∈ differentialAdjoin ℂ (S₁ ∪ S₂) :=
      subset_differentialAdjoin ℂ _ (Or.inr ⟨Ψ, Set.mem_insert _ _, rfl⟩)
    have hΔw : Δ w ∈ differentialAdjoin ℂ (S₁ ∪ S₂) := by
      have hval : Δ w = σw.ambientEquiv Ψ - Ψ := rfl
      rw [hval]
      exact (differentialAdjoin ℂ (S₁ ∪ S₂)).sub_mem hTΨmem hΨmem
    intro c hc
    rcases hCmem c hc with rfl | hA | ⟨a, ha, rfl⟩
    · exact hΔw
    · exact subset_differentialAdjoin ℂ _ (Or.inl (Set.mem_insert_of_mem _ ⟨c, hA, rfl⟩))
    · have hΔa : σw.ambientEquiv (Δ a) ∈ differentialAdjoin ℂ (S₁ ∪ S₂) :=
        subset_differentialAdjoin ℂ _
          (Or.inr ⟨Δ a, Set.mem_insert_of_mem _ ⟨a, ha, rfl⟩, rfl⟩)
      have heq : Δ (a + w) = σw.ambientEquiv (Δ a) + Δ w :=
        (ellipticGammaExternalLogDerivDefectMero_translate_add a w hsigma htau).symm
      rw [heq]
      exact (differentialAdjoin ℂ (S₁ ∪ S₂)).add_mem hΔa hΔw
  have hCclosure : Δ '' ↑C ⊆ M.closure (S₁ ∪ S₂) := by
    rintro y ⟨c, hc, rfl⟩
    exact differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin.mpr
      (HTGeometry.differentialAlgebraicOver_algebraMap
        (⟨Δ c, hmemfield c hc⟩ : ↥(differentialAdjoin ℂ (S₁ ∪ S₂))))
  have hCrankle : M.eRk (Δ '' ↑C) ≤ (A.card : ℕ∞) + (A.card : ℕ∞) := by
    calc M.eRk (Δ '' ↑C) ≤ M.eRk (M.closure (S₁ ∪ S₂)) := M.eRk_mono hCclosure
      _ = M.eRk (S₁ ∪ S₂) := M.eRk_closure_eq _
      _ ≤ M.eRk S₁ + M.eRk S₂ := M.eRk_union_le_eRk_add_eRk _ _
      _ ≤ (A.card : ℕ∞) + (A.card : ℕ∞) := add_le_add hS1rank hS2rank
  -- but they are independent of cardinality `2|A| + 1`
  have hCrange : Δ '' (↑C : Set ℂ) = Set.range (fun c : {x // x ∈ C} => Δ (c : ℂ)) := by
    ext y
    constructor
    · rintro ⟨c, hc, rfl⟩
      exact ⟨⟨c, hc⟩, rfl⟩
    · rintro ⟨c, rfl⟩
      exact ⟨(c : ℂ), c.2, rfl⟩
  have hCindepSet : M.Indep (Δ '' ↑C) := by
    rw [hMdef, differentialMatroid_indep_iff, hCrange]
    exact diffIndepOn_range_of_differentialIndependent hCindep
  have hCinj : Set.InjOn Δ (↑C : Set ℂ) := by
    intro x hx y hy hxy
    have hji : Function.Injective (fun c : {x // x ∈ C} => Δ (c : ℂ)) := hCindep.injective
    have hpair := hji (a₁ := ⟨x, hx⟩) (a₂ := ⟨y, hy⟩) hxy
    exact congrArg (fun c : {x // x ∈ C} => ((c : ℂ))) hpair
  have hCencard : (Δ '' (↑C : Set ℂ)).encard = (C.card : ℕ∞) := by
    rw [Set.InjOn.encard_image hCinj, Set.encard_coe_eq_coe_finsetCard]
  -- the rank count is contradictory
  have hfinal : ((C.card : ℕ) : ℕ∞) ≤ ((A.card + A.card : ℕ) : ℕ∞) := by
    rw [Nat.cast_add]
    rw [← hCencard, ← hCindepSet.eRk_eq_encard]
    exact hCrankle
  have hnat : C.card ≤ A.card + A.card := by exact_mod_cast hfinal
  omega

/-- The escape law over the embedded rational coordinate field: adjoining the coordinate changes no
closure of the meromorphic differential matroid. -/
theorem hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin_rationalBase
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (A : Finset ℂ)
    (hnonres : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma a)
    (hsep : ∀ a ∈ A, ∀ b ∈ A, a ≠ b → ThetaTranslationNonresonant tau sigma (a - b)) :
    HypertranscendentalOver
      ↥(differentialAdjoin meromorphicRationalCoordinateField
        ((fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau) '' ↑A))
      (ellipticGammaLogDerivMero sigma tau hsigma htau) := by
  intro hDA
  refine hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin
    hsigma htau hindependent A hnonres hsep ?_
  have hmem :
      ellipticGammaLogDerivMero sigma tau hsigma htau ∈
        (differentialMatroid meromorphicRationalCoordinateField
          (meroField (Set.univ : Set ℂ))).closure
          ((fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau) '' ↑A) :=
    differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin.mpr hDA
  rw [differentialMatroid_meromorphicRationalCoordinateField_eq] at hmem
  exact differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin.mp hmem

/-! ## The unconditional order-one packet -/

/-- **The order-one translation packet is unconditionally differentially independent.** -/
theorem ellipticGammaTranslatePacket_diffIndepOn_of_separated
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (A : Finset ℂ)
    (hnonres : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma a)
    (hsep : ∀ a ∈ A, ∀ b ∈ A, a ≠ b → ThetaTranslationNonresonant tau sigma (a - b)) :
    DiffIndepOn ℂ
      (insert (ellipticGammaLogDerivMero sigma tau hsigma htau)
        (Set.range (ellipticGammaTranslateFamily (fun a : {x // x ∈ A} => (a : ℂ))
          sigma tau hsigma htau))) := by
  classical
  have hrange : Set.range (ellipticGammaExternalDefectFamily
      (fun a : {x // x ∈ A} => (a : ℂ)) sigma tau hsigma htau) =
      (fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau) '' ↑A := by
    ext y
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨(a : ℂ), a.2, rfl⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨⟨c, hc⟩, rfl⟩
  refine ellipticGammaTranslatePacket_diffIndepOn _ sigma tau hsigma htau hindependent
    (fun j => hnonres (j : ℂ) j.2)
    (fun i j hji => hsep (j : ℂ) j.2 (i : ℂ) i.2 (fun hh => hji (Subtype.ext hh))) ?_
  rw [hrange]
  exact hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin
    hsigma htau hindependent A hnonres hsep

/-- **The order-one translation packet is unconditionally differentially independent over every
differentially algebraic extension.**  This is the bottom-layer atomicity input of the all-order
argument, with no remaining hypotheses beyond rational independence of the periods and separation
of the shift family. -/
theorem ellipticGammaTranslatePacket_diffIndepOn_daExtension_of_separated
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (A : Finset ℂ)
    (hnonres : ∀ a ∈ A, ThetaTranslationNonresonant tau sigma a)
    (hsep : ∀ a ∈ A, ∀ b ∈ A, a ≠ b → ThetaTranslationNonresonant tau sigma (a - b))
    {G : Set (meroField (Set.univ : Set ℂ))}
    (hG : ∀ g ∈ G, DifferentialAlgebraicOver ℂ g) :
    DiffIndepOn ↥(differentialAdjoin ℂ G)
      (insert (ellipticGammaLogDerivMero sigma tau hsigma htau)
        (Set.range (ellipticGammaTranslateFamily (fun a : {x // x ∈ A} => (a : ℂ))
          sigma tau hsigma htau))) := by
  classical
  have hrange : Set.range (ellipticGammaExternalDefectFamily
      (fun a : {x // x ∈ A} => (a : ℂ)) sigma tau hsigma htau) =
      (fun c => ellipticGammaExternalLogDerivDefectMero c sigma tau hsigma htau) '' ↑A := by
    ext y
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨(a : ℂ), a.2, rfl⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨⟨c, hc⟩, rfl⟩
  refine ellipticGammaTranslatePacket_diffIndepOn_daExtension
    (fun a : {x // x ∈ A} => (a : ℂ)) sigma tau hsigma htau hindependent
    (fun j => hnonres (j : ℂ) j.2)
    (fun i j hji => hsep (j : ℂ) j.2 (i : ℂ) i.2 (fun hh => hji (Subtype.ext hh))) ?_ hG
  rw [hrange]
  exact hypertranscendentalOver_ellipticGammaLogDerivMero_defectAdjoin_rationalBase
    hsigma htau hindependent A hnonres hsep

end

