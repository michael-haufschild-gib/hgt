import GaloisForLFunctions.HTGeometry.DifferentialJetAlgebra

/-!
# A logarithmic derivative generates the differential field

For a nonzero `x` in a differential field extension, the differential field generated by `x` over
`F` is the ordinary field generated by `x` together with all jets of `x′/x`.  This is the abstract
content of the Bell-polynomial identity `G^{(n)}/G = Bell_n(Ψ, Ψ′, …)`, with no reference to `Γ`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

variable {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential F] [Differential K]
  [DifferentialAlgebra F K]

omit [Differential F] [DifferentialAlgebra F K] in
/-- **The jet algebra is closed under the derivation** whenever the base is.  This is the version
the archimedean cards need: their base `ℂ(s)` is not a field of constants. -/
theorem deriv_mem_differentialJetAlgebra' {s : Set K}
    (hbase : ∀ c : F, ∃ c' : F, (algebraMap F K c)′ = algebraMap F K c')
    {y : K} (hy : y ∈ differentialJetAlgebra F s) : (y)′ ∈ differentialJetAlgebra F s := by
  induction hy using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨z, hz, n, hn⟩ := hx
      refine Algebra.subset_adjoin ⟨z, hz, n + 1, ?_⟩
      rw [differentialJet_succ, hn]
  | algebraMap c =>
      obtain ⟨c', hc'⟩ := hbase c
      rw [hc']
      exact Subalgebra.algebraMap_mem _ _
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact add_mem ihx ihy
  | mul x y hx hy ihx ihy =>
      rw [Derivation.leibniz]
      simp only [smul_eq_mul]
      exact add_mem (mul_mem hx ihy) (mul_mem hy ihx)

omit [Differential F] [DifferentialAlgebra F K] in
/-- **Every jet of `x` is `x` times an element of the jet algebra of its logarithmic derivative.** -/
theorem exists_jet_factor_of_logDeriv
    (hbase : ∀ c : F, ∃ c' : F, (algebraMap F K c)′ = algebraMap F K c') {x ψ : K}
    (hx : (x)′ = x * ψ) (n : ℕ) :
    ∃ y ∈ differentialJetAlgebra F ({ψ} : Set K), differentialJet n x = x * y := by
  induction n with
  | zero =>
      refine ⟨1, one_mem _, ?_⟩
      rw [differentialJet_zero, mul_one]
  | succ n ih =>
      obtain ⟨y, hy, hn⟩ := ih
      refine ⟨ψ * y + (y)′,
        add_mem (mul_mem (Algebra.subset_adjoin ⟨ψ, Set.mem_singleton _, 0, rfl⟩) hy)
          (deriv_mem_differentialJetAlgebra' hbase hy), ?_⟩
      have hleib := Differential.deriv.leibniz x y
      rw [differentialJet_succ, hn, hleib, hx]
      simp only [smul_eq_mul]
      ring

omit [Differential F] [DifferentialAlgebra F K] in
/-- The differential field generated by `x` is contained in the field generated by `x` and the jets
of its logarithmic derivative. -/
theorem differentialAdjoin_singleton_le_adjoin_logDeriv
    (hbase : ∀ c : F, ∃ c' : F, (algebraMap F K c)′ = algebraMap F K c') {x ψ : K}
    (hx : (x)′ = x * ψ) :
    differentialAdjoin F ({x} : Set K)
      ≤ IntermediateField.adjoin F ({x} ∪ differentialJetSet ({ψ} : Set K)) := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro y ⟨z, hz, n, rfl⟩
  rw [Set.mem_singleton_iff] at hz
  rw [hz]
  obtain ⟨w, hw, hjet⟩ := exists_jet_factor_of_logDeriv hbase hx n
  rw [hjet]
  refine mul_mem (IntermediateField.subset_adjoin F _
    (Set.mem_union_left _ (Set.mem_singleton _))) ?_
  have hmem : w ∈ Algebra.adjoin F ({x} ∪ differentialJetSet ({ψ} : Set K)) :=
    Algebra.adjoin_mono Set.subset_union_right hw
  exact IntermediateField.algebra_adjoin_le_adjoin F _ hmem

/-- The logarithmic derivative lies in the differential field generated by `x`. -/
theorem logDeriv_mem_differentialAdjoin_singleton {x ψ : K} (hx0 : x ≠ 0) (hx : (x)′ = x * ψ) :
    ψ ∈ differentialAdjoin F ({x} : Set K) := by
  have hxm : x ∈ differentialAdjoin F ({x} : Set K) :=
    subset_differentialAdjoin F _ (Set.mem_singleton _)
  have hxd : (x)′ ∈ differentialAdjoin F ({x} : Set K) :=
    derivationClosed_differentialAdjoin F _ hxm
  have heq : ψ = (x)′ / x := by
    rw [hx, mul_comm, mul_div_assoc, div_self hx0, mul_one]
  rw [heq]
  exact div_mem hxd hxm

/-- Every jet of the logarithmic derivative lies in the differential field generated by `x`. -/
theorem differentialJetSet_logDeriv_subset_differentialAdjoin {x ψ : K} (hx0 : x ≠ 0)
    (hx : (x)′ = x * ψ) :
    differentialJetSet ({ψ} : Set K)
      ⊆ (differentialAdjoin F ({x} : Set K) : Set K) := by
  rintro y ⟨z, hz, n, rfl⟩
  rw [Set.mem_singleton_iff] at hz
  subst hz
  induction n with
  | zero =>
      rw [differentialJet_zero]
      exact logDeriv_mem_differentialAdjoin_singleton hx0 hx
  | succ n ih =>
      rw [differentialJet_succ]
      exact derivationClosed_differentialAdjoin F _ ih

/-- **The logarithmic-derivative generation law.**  `K_x = L(x)` where `L` is generated by the jets
of `x′/x`. -/
theorem differentialAdjoin_singleton_eq_adjoin_logDeriv
    (hbase : ∀ c : F, ∃ c' : F, (algebraMap F K c)′ = algebraMap F K c') {x ψ : K}
    (hx0 : x ≠ 0) (hx : (x)′ = x * ψ) :
    differentialAdjoin F ({x} : Set K)
      = IntermediateField.adjoin F ({x} ∪ differentialJetSet ({ψ} : Set K)) := by
  refine le_antisymm (differentialAdjoin_singleton_le_adjoin_logDeriv hbase hx) ?_
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro y (hy | hy)
  · rw [Set.mem_singleton_iff] at hy
    subst hy
    exact subset_differentialAdjoin F _ (Set.mem_singleton _)
  · exact differentialJetSet_logDeriv_subset_differentialAdjoin hx0 hx hy

end GaloisForLFunctions.HTGeometry
