import GaloisForLFunctions.HTGeometry.SortedSpectrumGapExtremality

/-!
# Extremality for linearly independent spectral-gap frames

Standard projective recurrence uses every gap from one anchor.  Observer quotients instead produce
a forest of component-root gaps with different anchors.  This file proves the more general law:
any linearly independent finite family of balanced spectral gaps inherits Kleinbock--Margulis
extremality from real spectral-relation escape.

The proof clears the clock denominator.  A constant combination of normalized gaps would give a
nonzero balanced coefficient vector on the raw spectrum.  Linear independence of the incidence
rows makes that coefficient nonzero, while spectral escape forbids it on every nonempty open
simple-spectrum chart.
-/

open MeasureTheory Set
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

section LinearGapFrame

variable {I E : Type*} [Fintype I] [DecidableEq I] [Fintype E]

/-- Balanced incidence row of an oriented spectral gap. -/
def edgeIncidenceRow (tail head : E → I) (e : E) : I → ℝ :=
  fun i => (if head e = i then 1 else 0) - (if tail e = i then 1 else 0)

omit [Fintype E] in
theorem sum_edgeIncidenceRow (tail head : E → I) (e : E) :
    ∑ i, edgeIncidenceRow tail head e i = 0 := by
  simp [edgeIncidenceRow, Finset.sum_sub_distrib]

omit [Fintype E] in
theorem sum_edgeIncidenceRow_mul (tail head : E → I) (e : E) (energy : I → ℝ) :
    ∑ i, edgeIncidenceRow tail head e i * energy i =
      energy (head e) - energy (tail e) := by
  calc
    ∑ i, edgeIncidenceRow tail head e i * energy i =
        ∑ i, ((if head e = i then 1 else 0) * energy i -
          (if tail e = i then 1 else 0) * energy i) := by
            apply Finset.sum_congr rfl
            intro i _
            simp only [edgeIncidenceRow]
            ring
    _ = energy (head e) - energy (tail e) := by
      rw [Finset.sum_sub_distrib]
      simp

/-- Raw balanced spectral coefficient generated by a weighted gap frame. -/
def edgeLinearCoefficient (tail head : E → I) (a : E → ℝ) : I → ℝ :=
  ∑ e, a e • edgeIncidenceRow tail head e

theorem sum_edgeLinearCoefficient (tail head : E → I) (a : E → ℝ) :
    ∑ i, edgeLinearCoefficient tail head a i = 0 := by
  simp only [edgeLinearCoefficient, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_eq_zero
  intro e _
  rw [← Finset.mul_sum, sum_edgeIncidenceRow, mul_zero]

theorem sum_edgeLinearCoefficient_mul
    (tail head : E → I) (a : E → ℝ) (energy : I → ℝ) :
    ∑ i, edgeLinearCoefficient tail head a i * energy i =
      ∑ e, a e * (energy (head e) - energy (tail e)) := by
  simp only [edgeLinearCoefficient, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  calc
    ∑ i, (∑ e, a e * edgeIncidenceRow tail head e i) * energy i =
        ∑ i, ∑ e, (a e * edgeIncidenceRow tail head e i) * energy i := by
          apply Finset.sum_congr rfl
          intro i _
          rw [Finset.sum_mul]
    _ = ∑ e, ∑ i, (a e * edgeIncidenceRow tail head e i) * energy i :=
      Finset.sum_comm
    _ = ∑ e, a e * (energy (head e) - energy (tail e)) := by
      apply Finset.sum_congr rfl
      intro e _
      calc
        ∑ i, (a e * edgeIncidenceRow tail head e i) * energy i =
            a e * ∑ i, edgeIncidenceRow tail head e i * energy i := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro i _
              ring
        _ = a e * (energy (head e) - energy (tail e)) := by
          rw [sum_edgeIncidenceRow_mul]

omit [Fintype I] in
theorem edgeLinearCoefficient_ne_zero
    (tail head : E → I)
    (hlin : LinearIndependent ℝ (edgeIncidenceRow tail head))
    {a : E → ℝ} (ha : a ≠ 0) :
    edgeLinearCoefficient tail head a ≠ 0 := by
  intro hzero
  have hall := (Fintype.linearIndependent_iff.mp hlin) a
  have ha0 : ∀ e, a e = 0 := hall hzero
  exact ha (funext ha0)

end LinearGapFrame

section LinearGapRatio

variable {m n : ℕ} {I : Type*} [Fintype I] [DecidableEq I]

/-- Coefficient on the clock gap followed by coefficients on all normalized target gaps. -/
def edgeGapRatioWeight (w : Fin n → ℝ) (kappa : ℝ) : Fin (n + 1) → ℝ :=
  Fin.cases (-kappa) w

/-- Normalize an arbitrary independent spectral-gap frame by its first gap. -/
def edgeGapRatioMap (spec : I → ℝ)
    (tail head : Fin (n + 1) → I) : Fin n → ℝ :=
  fun k => (spec (head k.succ) - spec (tail k.succ)) /
    (spec (head 0) - spec (tail 0))

theorem edgeGapRatioWeight_ne_zero {w : Fin n → ℝ} (hw : w ≠ 0) (kappa : ℝ) :
    edgeGapRatioWeight w kappa ≠ 0 := by
  intro hzero
  apply hw
  funext k
  have hk := congrFun hzero k.succ
  simpa [edgeGapRatioWeight] using hk

theorem sum_edgeGapRatioCoefficient_mul
    (tail head : Fin (n + 1) → I) (w : Fin n → ℝ) (kappa : ℝ)
    (energy : I → ℝ) :
    ∑ i, edgeLinearCoefficient tail head (edgeGapRatioWeight w kappa) i * energy i =
      (∑ k, w k * (energy (head k.succ) - energy (tail k.succ))) -
        kappa * (energy (head 0) - energy (tail 0)) := by
  rw [sum_edgeLinearCoefficient_mul, Fin.sum_univ_succ]
  simp [edgeGapRatioWeight]
  ring

/-- No nonzero combination of normalized independent gaps is constant on a spectral-escape
chart. -/
theorem no_constant_combination_edgeGapRatio
    (base : Matrix I I ℂ) (generator : Fin m → Matrix I I ℂ)
    (hS : SpectrumEscapesRealRelations (Set.range (realAffineMatrix base generator)))
    (tail head : Fin (n + 1) → I)
    (hlin : LinearIndependent ℝ (edgeIncidenceRow tail head))
    (hclock : head 0 ≠ tail 0)
    {U : Set (Fin m → ℝ)} (hU : IsOpen U) (hUne : U.Nonempty)
    (spec : (Fin m → ℝ) → I → ℝ)
    (hinj : ∀ q ∈ U, Function.Injective (spec q))
    (hroot : ∀ q ∈ U, ∀ i,
      matrixCharpolyRelation (realAffineMatrix base generator q, ((spec q i : ℝ) : ℂ)) = 0)
    (w : Fin n → ℝ)
    (hconst : ∀ x ∈ U, ∀ y ∈ U,
      ∑ k, w k * edgeGapRatioMap (spec x) tail head k =
        ∑ k, w k * edgeGapRatioMap (spec y) tail head k) :
    w = 0 := by
  by_contra hw
  obtain ⟨x₀, hx₀⟩ := hUne
  let kappa : ℝ := ∑ k, w k * edgeGapRatioMap (spec x₀) tail head k
  let a := edgeGapRatioWeight w kappa
  refine not_relation_on_open_of_spectrumEscapes base generator hS
    (sum_edgeLinearCoefficient tail head a)
    (edgeLinearCoefficient_ne_zero tail head hlin
      (edgeGapRatioWeight_ne_zero hw kappa)) hU ⟨x₀, hx₀⟩ spec hinj hroot ?_
  intro q hq
  have hden : spec q (head 0) - spec q (tail 0) ≠ 0 := by
    intro h
    exact hclock ((hinj q hq) (sub_eq_zero.mp h))
  have hratio : ∑ k, w k * edgeGapRatioMap (spec q) tail head k = kappa :=
    hconst q hq x₀ hx₀
  rw [sum_edgeGapRatioCoefficient_mul]
  have hexpand : ∀ k : Fin n,
      w k * (spec q (head k.succ) - spec q (tail k.succ)) =
        (spec q (head 0) - spec q (tail 0)) *
          (w k * edgeGapRatioMap (spec q) tail head k) := by
    intro k
    unfold edgeGapRatioMap
    field_simp
  calc
    (∑ k, w k * (spec q (head k.succ) - spec q (tail k.succ))) -
        kappa * (spec q (head 0) - spec q (tail 0)) =
      (spec q (head 0) - spec q (tail 0)) *
          (∑ k, w k * edgeGapRatioMap (spec q) tail head k) -
        kappa * (spec q (head 0) - spec q (tail 0)) := by
          congr 1
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun k _ => hexpand k
    _ = 0 := by rw [hratio]; ring

/-- **Extremality of an arbitrary independent normalized gap frame.** -/
theorem theoremA_edgeGapRatio [NeZero m] (hn : 0 < n)
    (base : Matrix I I ℂ) (generator : Fin m → Matrix I I ℂ)
    (hS : SpectrumEscapesRealRelations (Set.range (realAffineMatrix base generator)))
    (tail head : Fin (n + 1) → I)
    (hlin : LinearIndependent ℝ (edgeIncidenceRow tail head))
    (hclock : head 0 ≠ tail 0)
    {U : Set (Fin m → ℝ)} (hU : IsOpen U) (hUc : IsPreconnected U) (hUne : U.Nonempty)
    (spec : (Fin m → ℝ) → I → ℝ)
    (hinj : ∀ q ∈ U, Function.Injective (spec q))
    (hroot : ∀ q ∈ U, ∀ i,
      matrixCharpolyRelation (realAffineMatrix base generator q, ((spec q i : ℝ) : ℂ)) = 0)
    (hF : AnalyticOnNhd ℝ (fun q => edgeGapRatioMap (spec q) tail head) U) :
    volume {x ∈ U |
      KleinbockMargulis.VWA fun k => edgeGapRatioMap (spec x) tail head k} = 0 :=
  KleinbockMargulis.theoremA_analytic hn hU hUc hF
    (fun w hw => no_constant_combination_edgeGapRatio base generator hS tail head hlin hclock
      hU hUne spec hinj hroot w hw)

end LinearGapRatio

section SortedLinearGapRatio

variable {N D n : ℕ} {P : Fin N → Matrix (Fin D) (Fin D) ℂ}

theorem analyticOnNhd_sortedEdgeGapRatio
    (hP : ∀ a, (P a).IsHermitian)
    (tail head : Fin (n + 1) → Fin D) (hclock : head 0 ≠ tail 0)
    {U : Set (Fin N → ℝ)} (hUsimple : U ⊆ simpleEnsembleLocus hP) :
    AnalyticOnNhd ℝ
      (fun q => edgeGapRatioMap (sortedEnsembleSpectrum hP q) tail head) U := by
  intro theta htheta
  have hne :
      sortedEnsembleSpectrum hP theta (head 0) -
          sortedEnsembleSpectrum hP theta (tail 0) ≠ 0 := by
    intro h
    exact hclock ((injective_sortedEnsembleSpectrum hP (hUsimple htheta))
      (sub_eq_zero.mp h))
  refine analyticAt_pi_iff.mpr fun k => ?_
  have hnum :
      AnalyticAt ℝ
        (fun q : Fin N → ℝ =>
          sortedEnsembleSpectrum hP q (head k.succ) -
            sortedEnsembleSpectrum hP q (tail k.succ)) theta :=
    (analyticAt_sortedEnsembleSpectrum hP (hUsimple htheta) (head k.succ)).sub
      (analyticAt_sortedEnsembleSpectrum hP (hUsimple htheta) (tail k.succ))
  have hden :
      AnalyticAt ℝ
        (fun q : Fin N → ℝ =>
          sortedEnsembleSpectrum hP q (head 0) -
            sortedEnsembleSpectrum hP q (tail 0)) theta :=
    (analyticAt_sortedEnsembleSpectrum hP (hUsimple htheta) (head 0)).sub
      (analyticAt_sortedEnsembleSpectrum hP (hUsimple htheta) (tail 0))
  exact hnum.div hden hne

/-- **Sorted-spectrum extremality for an arbitrary independent gap frame.** -/
theorem theoremA_sortedEdgeGapRatio [NeZero N] (hn : 0 < n)
    (hP : ∀ a, (P a).IsHermitian)
    (hS : SpectrumEscapesRealRelations (Set.range (spectralEnsembleMatrix P)))
    (tail head : Fin (n + 1) → Fin D)
    (hlin : LinearIndependent ℝ (edgeIncidenceRow tail head))
    (hclock : head 0 ≠ tail 0)
    {U : Set (Fin N → ℝ)} (hU : IsOpen U) (hUc : IsPreconnected U) (hUne : U.Nonempty)
    (hUsimple : U ⊆ simpleEnsembleLocus hP) :
    volume {x ∈ U | KleinbockMargulis.VWA fun k =>
      edgeGapRatioMap (sortedEnsembleSpectrum hP x) tail head k} = 0 := by
  have hfamily : realAffineMatrix 0 P = spectralEnsembleMatrix P :=
    funext fun theta => realAffineMatrix_zero_eq_spectralEnsembleMatrix P theta
  refine theoremA_edgeGapRatio hn 0 P (by rw [hfamily]; exact hS)
    tail head hlin hclock hU hUc hUne
    (fun q => sortedEnsembleSpectrum hP q)
    (fun q hq => injective_sortedEnsembleSpectrum hP (hUsimple hq)) ?_
    (analyticOnNhd_sortedEdgeGapRatio hP tail head hclock hUsimple)
  intro q _ i
  rw [realAffineMatrix_zero_eq_spectralEnsembleMatrix]
  exact matrixCharpolyRelation_sortedEnsembleSpectrum hP q i

/-- **Global extremality for an arbitrary independent gap frame.**  The local chart law holds on
every ball contained in the simple-spectrum locus; second countability reduces the full locus to a
countable union of such balls. -/
theorem volume_vwa_sortedEdgeGapRatio_eq_zero [NeZero N] (hn : 0 < n)
    (hP : ∀ a, (P a).IsHermitian)
    (hS : SpectrumEscapesRealRelations (Set.range (spectralEnsembleMatrix P)))
    (tail head : Fin (n + 1) → Fin D)
    (hlin : LinearIndependent ℝ (edgeIncidenceRow tail head))
    (hclock : head 0 ≠ tail 0) :
    volume {x ∈ simpleEnsembleLocus hP |
      KleinbockMargulis.VWA fun k =>
        edgeGapRatioMap (sortedEnsembleSpectrum hP x) tail head k} = 0 := by
  classical
  set B : {p : (Fin N → ℝ) × ℝ //
      0 < p.2 ∧ Metric.ball p.1 p.2 ⊆ simpleEnsembleLocus hP} →
      Set (Fin N → ℝ) := fun p => Metric.ball p.1.1 p.1.2 with hB
  obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable B
    (fun p => Metric.isOpen_ball)
  have hunion : (⋃ p, B p) = simpleEnsembleLocus hP := by
    refine Set.Subset.antisymm (Set.iUnion_subset fun p => p.2.2) ?_
    intro x hx
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp
      (isOpen_simpleEnsembleLocus hP) x hx
    exact Set.mem_iUnion.mpr
      ⟨⟨(x, r), hr, hball⟩, Metric.mem_ball_self hr⟩
  have hsub : {x ∈ simpleEnsembleLocus hP |
        KleinbockMargulis.VWA fun k =>
          edgeGapRatioMap (sortedEnsembleSpectrum hP x) tail head k}
      ⊆ ⋃ p ∈ T, {x ∈ B p |
        KleinbockMargulis.VWA fun k =>
          edgeGapRatioMap (sortedEnsembleSpectrum hP x) tail head k} := by
    rintro x ⟨hxU, hxV⟩
    rw [← hunion, ← hT] at hxU
    obtain ⟨p, hp, hxp⟩ := Set.mem_iUnion₂.mp hxU
    exact Set.mem_iUnion₂.mpr ⟨p, hp, hxp, hxV⟩
  refine measure_mono_null hsub ?_
  rw [measure_biUnion_null_iff hTc]
  intro p _
  exact theoremA_sortedEdgeGapRatio hn hP hS tail head hlin hclock
    Metric.isOpen_ball Metric.isPreconnected_ball
    ⟨p.1.1, Metric.mem_ball_self p.2.1⟩ p.2.2

end SortedLinearGapRatio

end

end GaloisForLFunctions.HTGeometry
