import Mathlib.RingTheory.Discriminant
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Polynomial.Div
import GaloisForLFunctions.HTGeometry.TraceDualBasisSeparability

/-!
# The fibre of a finite free polynomial algebra at the origin

For `B` finite free over `R[X]` with basis `e`, the quotient by the ideal generated by the parameter
`w = algebraMap R[X] B X` is finite free over `R` with basis the images of `e`, and its discriminant
is the value at `0` of the discriminant upstairs:

```text
fibreBasis e  : Module.Basis (Fin n) R (B ⧸ (w))
discr_fibreBasis :  Algebra.discr R (fibreBasis e) = (Algebra.discr R[X] e).eval 0
```

Linear independence is "a constant divisible by `X` is zero"; spanning is "reduce each coordinate
mod `X`"; the discriminant identity is the observation that the multiplication matrix of the class
of `b` in the reduced basis is the coefficientwise value at `0` of the multiplication matrix of `b`.

No tensor products are involved: this is the concrete replacement for `R ⊗_{R[X]} B` in the
induction on the number of variables.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

set_option maxHeartbeats 1600000
set_option linter.unusedSectionVars false

/-- The parameter, as an element of the algebra. -/
noncomputable abbrev param (R B : Type*) [CommRing R] [CommRing B] [Algebra R[X] B] : B :=
  algebraMap R[X] B X

/-- The fibre of the algebra at the origin. -/
abbrev fibreQuot (R B : Type*) [CommRing R] [CommRing B] [Algebra R[X] B] : Type _ :=
  B ⧸ Ideal.span {param R B}

noncomputable instance instAlgebraFibreQuot (R B : Type*) [CommRing R] [CommRing B]
    [Algebra R[X] B] [Algebra R B] : Algebra R (fibreQuot R B) := Ideal.Quotient.algebra R

instance instTowerFibreQuot (R B : Type*) [CommRing R] [CommRing B]
    [Algebra R[X] B] [Algebra R B] [IsScalarTower R R[X] B] :
    IsScalarTower R R[X] (fibreQuot R B) :=
  IsScalarTower.of_algebraMap_eq (fun r => by
    show Ideal.Quotient.mk (Ideal.span {param R B}) (algebraMap R B r) = _
    rw [IsScalarTower.algebraMap_apply R R[X] B]
    rfl)

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R[X] B] [Algebra R B]
  [IsScalarTower R R[X] B] [Module.Free R[X] B] [Module.Finite R[X] B]
  {n : ℕ} (e : Module.Basis (Fin n) R[X] B)

theorem param_mk_eq_zero :
    (Ideal.Quotient.mk (Ideal.span {param R B})) (param R B) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_span_singleton_self _

theorem algebraMap_fibreQuot (p : R[X]) :
    algebraMap R[X] (fibreQuot R B) p = algebraMap R (fibreQuot R B) (p.eval 0) := by
  have hdvd : (X : R[X]) ∣ (p - Polynomial.C (p.eval 0)) := by
    rw [Polynomial.X_dvd_iff]
    simp [Polynomial.coeff_zero_eq_eval_zero]
  obtain ⟨q, hq⟩ := hdvd
  have hp : p = Polynomial.C (p.eval 0) + X * q := by linear_combination hq
  have hX : algebraMap R[X] (fibreQuot R B) X = 0 := param_mk_eq_zero
  conv_lhs => rw [hp]
  rw [map_add, map_mul, hX, zero_mul, add_zero,
    show (Polynomial.C (p.eval 0) : R[X]) = algebraMap R R[X] (p.eval 0) from rfl,
    ← IsScalarTower.algebraMap_apply R R[X] (fibreQuot R B)]

/-- The images of a basis in the fibre. -/
noncomputable def fibreVec (i : Fin n) : fibreQuot R B :=
  Ideal.Quotient.mk (Ideal.span {param R B}) (e i)

theorem mk_smul_eq (p : R[X]) (b : B) :
    Ideal.Quotient.mk (Ideal.span {param R B}) (p • b)
      = (p.eval 0) • Ideal.Quotient.mk (Ideal.span {param R B}) b := by
  rw [Algebra.smul_def, map_mul, Algebra.smul_def]
  congr 1
  exact algebraMap_fibreQuot p

theorem mk_eq_sum (b : B) :
    Ideal.Quotient.mk (Ideal.span {param R B}) b
      = ∑ i, ((e.repr b i).eval 0) • fibreVec e i := by
  conv_lhs => rw [← e.sum_repr b]
  rw [map_sum]
  exact Finset.sum_congr rfl (fun i _ => mk_smul_eq _ _)


theorem fibreVec_linearIndependent : LinearIndependent R (fibreVec e) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  have hmk : Ideal.Quotient.mk (Ideal.span {param R B}) (∑ j, (Polynomial.C (g j)) • e j) = 0 := by
    rw [map_sum, ← hg]
    exact Finset.sum_congr rfl (fun j _ => by rw [mk_smul_eq]; simp [fibreVec])
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hmk
  obtain ⟨y, hy⟩ := hmk
  have hyexp : y = ∑ j, (e.repr y j) • e j := (e.sum_repr y).symm
  have hxy : ∑ j, (Polynomial.C (g j)) • e j = ∑ j, (X * e.repr y j) • e j := by
    rw [hy]
    conv_lhs => rw [hyexp]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Algebra.mul_smul_comm,
      show param R B * e j = (X : R[X]) • e j from (Algebra.smul_def X (e j)).symm,
      smul_smul, mul_comm]
  have hcoef : ∀ j, (Polynomial.C (g j) : R[X]) = X * e.repr y j := by
    intro j
    have h1 : e.repr (∑ k, (Polynomial.C (g k)) • e k) j
        = e.repr (∑ k, (X * e.repr y k) • e k) j := by rw [hxy]
    rw [repr_sum_apply, repr_sum_apply] at h1
    exact h1
  have := hcoef i
  have h0 : (Polynomial.C (g i) : R[X]).coeff 0 = ((X : R[X]) * e.repr y i).coeff 0 := by
    rw [this]
  simpa using h0


theorem fibreVec_span : ⊤ ≤ Submodule.span R (Set.range (fibreVec e)) := by
  intro q _
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [mk_eq_sum e b]
  exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))

/-- The basis of the fibre induced by a basis of the algebra. -/
noncomputable def fibreBasis : Module.Basis (Fin n) R (fibreQuot R B) :=
  Module.Basis.mk (fibreVec_linearIndependent e) (fibreVec_span e)

@[simp] theorem fibreBasis_apply (i : Fin n) : fibreBasis e i = fibreVec e i :=
  Module.Basis.mk_apply _ _ _

theorem fibreBasis_repr (b : B) (i : Fin n) :
    (fibreBasis e).repr (Ideal.Quotient.mk (Ideal.span {param R B}) b) i
      = (e.repr b i).eval 0 := by
  haveI : Module.Free R (fibreQuot R B) := Module.Free.of_basis (fibreBasis e)
  haveI : Module.Finite R (fibreQuot R B) := Module.Finite.of_basis (fibreBasis e)
  have h : Ideal.Quotient.mk (Ideal.span {param R B}) b
      = ∑ j, ((e.repr b j).eval 0) • (fibreBasis e) j := by
    rw [mk_eq_sum e b]
    exact Finset.sum_congr rfl (fun j _ => by rw [fibreBasis_apply])
  rw [h, repr_sum_apply]

theorem leftMulMatrix_fibre (b : B) (i j : Fin n) :
    Algebra.leftMulMatrix (fibreBasis e) (Ideal.Quotient.mk (Ideal.span {param R B}) b) i j
      = (Algebra.leftMulMatrix e b i j).eval 0 := by
  rw [Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul, fibreBasis_apply,
    show (Ideal.Quotient.mk (Ideal.span {param R B}) b) * fibreVec e j
      = Ideal.Quotient.mk (Ideal.span {param R B}) (b * e j) from (map_mul _ _ _).symm,
    fibreBasis_repr]

include e in
theorem trace_fibre (b : B) :
    Algebra.trace R (fibreQuot R B) (Ideal.Quotient.mk (Ideal.span {param R B}) b)
      = (Algebra.trace R[X] B b).eval 0 := by
  classical
  haveI : Module.Free R (fibreQuot R B) := Module.Free.of_basis (fibreBasis e)
  haveI : Module.Finite R (fibreQuot R B) := Module.Finite.of_basis (fibreBasis e)
  rw [Algebra.trace_eq_matrix_trace (fibreBasis e), Algebra.trace_eq_matrix_trace e,
    Matrix.trace, Matrix.trace, Polynomial.eval_finsetSum]
  exact Finset.sum_congr rfl (fun i _ => leftMulMatrix_fibre e b i i)

theorem discr_fibreBasis :
    Algebra.discr R (fibreBasis e) = (Algebra.discr R[X] e).eval 0 := by
  classical
  haveI : Module.Free R (fibreQuot R B) := Module.Free.of_basis (fibreBasis e)
  haveI : Module.Finite R (fibreQuot R B) := Module.Finite.of_basis (fibreBasis e)
  rw [Algebra.discr_def, Algebra.discr_def]
  have hmat : Algebra.traceMatrix R (fibreBasis e)
      = (Algebra.traceMatrix R[X] e).map (Polynomial.evalRingHom 0) := by
    ext i j
    rw [Algebra.traceMatrix_apply, Algebra.traceForm_apply, fibreBasis_apply, fibreBasis_apply,
      show fibreVec e i * fibreVec e j
        = Ideal.Quotient.mk (Ideal.span {param R B}) (e i * e j) from (map_mul _ _ _).symm,
      trace_fibre e, Matrix.map_apply, Algebra.traceMatrix_apply, Algebra.traceForm_apply]
    rfl
  rw [hmat, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
  rfl

end GaloisForLFunctions.HTGeometry
