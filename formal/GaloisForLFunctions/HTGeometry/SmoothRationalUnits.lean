import GaloisForLFunctions.HTGeometry.RationalTameData

/-!
# The smooth rational units

For a bound `N` the `N`-smooth rational units are those whose `q`-adic valuation vanishes at every
prime `q > N`.  This is a subgroup of `ℚˣ` by additivity of the valuation, it is monotone in `N`,
every rational unit is `N`-smooth for `N` large, and — by unique factorization — it is generated by
`−1` together with the primes `≤ N`.

The `1`-smooth units are exactly `±1`.

This is the filtration Tate's computation of the tame kernel of `ℚ` runs down.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Classical

section Smooth

/-- A nonzero integer as a rational unit. -/
def intRatUnit {m : ℤ} (hm : m ≠ 0) : ℚˣ :=
  Units.mk0 ((m : ℚ)) (Int.cast_ne_zero.2 hm)

theorem intRatUnit_val {m : ℤ} (hm : m ≠ 0) : ((intRatUnit hm : ℚˣ) : ℚ) = (m : ℚ) := rfl

/-- A nonzero natural number as a rational unit. -/
def natRatUnit {m : ℕ} (hm : m ≠ 0) : ℚˣ :=
  Units.mk0 ((m : ℚ)) (by exact_mod_cast hm)

theorem natRatUnit_val {m : ℕ} (hm : m ≠ 0) : ((natRatUnit hm : ℚˣ) : ℚ) = (m : ℚ) := rfl

theorem natRatUnit_one : natRatUnit (one_ne_zero (α := ℕ)) = 1 := by
  refine Units.ext ?_
  rw [natRatUnit_val]
  simp

theorem natRatUnit_mul {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) :
    natRatUnit (mul_ne_zero ha hb) = natRatUnit ha * natRatUnit hb := by
  refine Units.ext ?_
  rw [natRatUnit_val, Units.val_mul, natRatUnit_val, natRatUnit_val]
  push_cast
  ring

/-! ## The subgroup -/

/-- The `N`-smooth rational units: the `q`-adic valuation vanishes at every prime `q > N`. -/
def smoothUnits (N : ℕ) : Subgroup ℚˣ where
  carrier := {u : ℚˣ | ∀ q : ℕ, q.Prime → N < q → padicValRat q ((u : ℚˣ) : ℚ) = 0}
  mul_mem' := by
    intro a b ha hb q hq hqN
    haveI : Fact q.Prime := ⟨hq⟩
    rw [Units.val_mul, padicValRat.mul a.ne_zero b.ne_zero, ha q hq hqN, hb q hq hqN, add_zero]
  one_mem' := by
    intro q hq _
    haveI : Fact q.Prime := ⟨hq⟩
    rw [Units.val_one, padicValRat.one]
  inv_mem' := by
    intro a ha q hq hqN
    haveI : Fact q.Prime := ⟨hq⟩
    rw [Units.val_inv_eq_inv_val, padicValRat.inv, ha q hq hqN, neg_zero]

theorem mem_smoothUnits_iff {N : ℕ} {u : ℚˣ} :
    u ∈ smoothUnits N ↔ ∀ q : ℕ, q.Prime → N < q → padicValRat q ((u : ℚˣ) : ℚ) = 0 :=
  Iff.rfl

theorem smoothUnits_mono {M N : ℕ} (h : M ≤ N) : smoothUnits M ≤ smoothUnits N := by
  intro u hu q hq hqN
  exact hu q hq (lt_of_le_of_lt h hqN)

theorem neg_one_mem_smoothUnits (N : ℕ) : (-1 : ℚˣ) ∈ smoothUnits N := by
  intro q hq _
  haveI : Fact q.Prime := ⟨hq⟩
  have hval : (((-1 : ℚˣ)) : ℚ) = ((-1 : ℤ) : ℚ) := by norm_num
  rw [hval, padicValRat.of_int]
  simp [padicValInt]

/-- A prime at most `N` is `N`-smooth. -/
theorem prime_mem_smoothUnits {N q : ℕ} (hq : q.Prime) (hqN : q ≤ N) :
    natRatUnit hq.ne_zero ∈ smoothUnits N := by
  intro r hr hrN
  haveI : Fact r.Prime := ⟨hr⟩
  rw [natRatUnit_val]
  have hnr : ¬ r ∣ q := by
    intro hdvd
    have := Nat.le_of_dvd hq.pos hdvd
    omega
  have hz : padicValRat r ((q : ℤ) : ℚ) = 0 := by
    rw [padicValRat.of_int, padicValInt]
    have : padicValNat r ((q : ℤ)).natAbs = 0 := by
      refine padicValNat.eq_zero_of_not_dvd ?_
      simpa using hnr
    rw [this]
    rfl
  simpa using hz

/-! ## Generation -/

/-- The generating set: `−1` and the primes at most `N`. -/
def smoothGens (N : ℕ) : Set ℚˣ :=
  {(-1 : ℚˣ)} ∪ {u : ℚˣ | ∃ q : ℕ, ∃ hq : q.Prime, q ≤ N ∧ u = natRatUnit hq.ne_zero}

theorem smoothGens_subset (N : ℕ) : smoothGens N ⊆ (smoothUnits N : Set ℚˣ) := by
  rintro u (hu | ⟨q, hq, hqN, rfl⟩)
  · rw [Set.mem_singleton_iff] at hu
    rw [hu]
    exact neg_one_mem_smoothUnits N
  · exact prime_mem_smoothUnits hq hqN

/-- Every natural number all of whose prime factors are at most `N` is in the generated
subgroup. -/
theorem natRatUnit_mem_closure_smoothGens (N : ℕ) :
    ∀ m : ℕ, ∀ hm : m ≠ 0, (∀ q : ℕ, q.Prime → q ∣ m → q ≤ N) →
      natRatUnit hm ∈ Subgroup.closure (smoothGens N) := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro hm hfac
    rcases eq_or_ne m 1 with rfl | hone
    · have : natRatUnit hm = 1 := natRatUnit_one
      rw [this]
      exact Subgroup.one_mem _
    · obtain ⟨q, hq, hqd⟩ := Nat.exists_prime_and_dvd hone
      obtain ⟨m', rfl⟩ := hqd
      have hq0 : q ≠ 0 := hq.ne_zero
      have hm'0 : m' ≠ 0 := by
        intro hc
        exact hm (by rw [hc, mul_zero])
      have hlt : m' < q * m' := by
        have h1 : 1 < q := hq.one_lt
        have h2 : 0 < m' := Nat.pos_of_ne_zero hm'0
        nlinarith
      have hfac' : ∀ r : ℕ, r.Prime → r ∣ m' → r ≤ N := by
        intro r hr hrd
        exact hfac r hr (Dvd.dvd.mul_left hrd q)
      have hqN : q ≤ N := hfac q hq ⟨m', rfl⟩
      have hmem' := ih m' hlt hm'0 hfac'
      have hmemq : natRatUnit hq0 ∈ Subgroup.closure (smoothGens N) :=
        Subgroup.subset_closure (Or.inr ⟨q, hq, hqN, rfl⟩)
      have hsplit : natRatUnit hm = natRatUnit hq0 * natRatUnit hm'0 := by
        refine Units.ext ?_
        rw [natRatUnit_val, Units.val_mul, natRatUnit_val, natRatUnit_val]
        push_cast
        ring
      rw [hsplit]
      exact Subgroup.mul_mem _ hmemq hmem'

/-- **Unique factorization for the smooth units.**  Every `N`-smooth rational unit is a product of
`−1` and primes at most `N`. -/
theorem smoothUnits_le_closure (N : ℕ) :
    smoothUnits N ≤ Subgroup.closure (smoothGens N) := by
  intro u hu
  set q : ℚ := ((u : ℚˣ) : ℚ) with hqdef
  have hq0 : q ≠ 0 := u.ne_zero
  have hnum : q.num ≠ 0 := Rat.num_ne_zero.2 hq0
  have hnat : q.num.natAbs ≠ 0 := Int.natAbs_ne_zero.2 hnum
  have hden : q.den ≠ 0 := q.den_nz
  -- the numerator and the denominator are `N`-smooth naturals
  have hfacnum : ∀ r : ℕ, r.Prime → r ∣ q.num.natAbs → r ≤ N := by
    intro r hr hrd
    by_contra hcon
    haveI : Fact r.Prime := ⟨hr⟩
    have hval := hu r hr (not_le.mp hcon)
    have hden' : ¬ r ∣ q.den := fun hc => not_dvd_num_and_den (p := r) q ⟨hrd, hc⟩
    have h1 : padicValRat r q
        = (padicValNat r q.num.natAbs : ℤ) - (padicValNat r q.den : ℤ) := padicValRat_eq_sub q
    have h2 : padicValNat r q.den = 0 := padicValNat.eq_zero_of_not_dvd hden'
    have h3 : 1 ≤ padicValNat r q.num.natAbs := one_le_padicValNat_of_dvd hnat hrd
    rw [hval, h2] at h1
    omega
  have hfacden : ∀ r : ℕ, r.Prime → r ∣ q.den → r ≤ N := by
    intro r hr hrd
    by_contra hcon
    haveI : Fact r.Prime := ⟨hr⟩
    have hval := hu r hr (not_le.mp hcon)
    have hnum' : ¬ r ∣ q.num.natAbs := fun hc => not_dvd_num_and_den (p := r) q ⟨hc, hrd⟩
    have h1 : padicValRat r q
        = (padicValNat r q.num.natAbs : ℤ) - (padicValNat r q.den : ℤ) := padicValRat_eq_sub q
    have h2 : padicValNat r q.num.natAbs = 0 := padicValNat.eq_zero_of_not_dvd hnum'
    have h3 : 1 ≤ padicValNat r q.den := one_le_padicValNat_of_dvd hden hrd
    rw [hval, h2] at h1
    omega
  have hmemnum := natRatUnit_mem_closure_smoothGens N q.num.natAbs hnat hfacnum
  have hmemden := natRatUnit_mem_closure_smoothGens N q.den hden hfacden
  have hmemneg : (-1 : ℚˣ) ∈ Subgroup.closure (smoothGens N) :=
    Subgroup.subset_closure (Or.inl rfl)
  -- assemble `u = ± |num| / den`
  have hdQ : ((q.den : ℚ)) ≠ 0 := den_cast_ne_zero q
  have hAbs : (((q.num.natAbs : ℕ)) : ℚ) = |(q.num : ℚ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hdecomp : u = (natRatUnit hnat) * (natRatUnit hden)⁻¹ ∨
      u = (-1 : ℚˣ) * ((natRatUnit hnat) * (natRatUnit hden)⁻¹) := by
    rcases abs_choice ((q.num : ℚ)) with hc | hc
    · left
      refine Units.ext ?_
      have hA : (((q.num.natAbs : ℕ)) : ℚ) = (q.num : ℚ) := hAbs.trans hc
      have hkey : (((q.num.natAbs : ℕ)) : ℚ) * ((q.den : ℚ))⁻¹ = q := by
        rw [hA]
        field_simp
        linarith [num_eq_mul_den q]
      rw [Units.val_mul, Units.val_inv_eq_inv_val, natRatUnit_val, natRatUnit_val, hkey]
    · right
      refine Units.ext ?_
      have hA : (((q.num.natAbs : ℕ)) : ℚ) = -(q.num : ℚ) := hAbs.trans hc
      have hval : (((-1 : ℚˣ)) : ℚ) = -1 := by norm_num
      have hkey : (-1 : ℚ) * ((((q.num.natAbs : ℕ)) : ℚ) * ((q.den : ℚ))⁻¹) = q := by
        rw [hA]
        field_simp
        linarith [num_eq_mul_den q]
      rw [Units.val_mul, Units.val_mul, Units.val_inv_eq_inv_val, natRatUnit_val, natRatUnit_val,
        hval, hkey]
  rcases hdecomp with h | h
  · rw [h]
    exact Subgroup.mul_mem _ hmemnum (Subgroup.inv_mem _ hmemden)
  · rw [h]
    exact Subgroup.mul_mem _ hmemneg (Subgroup.mul_mem _ hmemnum (Subgroup.inv_mem _ hmemden))

theorem closure_smoothGens_eq (N : ℕ) :
    Subgroup.closure (smoothGens N) = smoothUnits N :=
  le_antisymm (Subgroup.closure_le _ |>.2 (smoothGens_subset N)) (smoothUnits_le_closure N)

end Smooth

end GaloisForLFunctions.HTGeometry
