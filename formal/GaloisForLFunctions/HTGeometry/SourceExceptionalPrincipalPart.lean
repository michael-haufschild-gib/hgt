import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Source exceptional principal parts

For a nonzero element `x` of a commutative domain, the simple denominator layer generated by
`1 / x` in `R[x⁻¹] / R` is canonically the Cartier quotient `R / (x)`.

This is the algebraic source-landing bridge used by the reciprocal exceptional section. It does
not construct an analytic dagger or imply the Riemann hypothesis.
-/

open scoped nonZeroDivisors

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable (R : Type*) [CommRing R] [NoZeroDivisors R] (x : R)

/-- Localization of `R` obtained by inverting the powers of `x`. -/
abbrev ExceptionalAway := Localization.Away x

/-- Image of the original ring inside its localization, regarded as a linear submodule. -/
def integralLocalizationSubmodule :
    Submodule R (ExceptionalAway R x) :=
  LinearMap.range (Algebra.linearMap R (ExceptionalAway R x))

/-- Numerators multiplied by the reciprocal exceptional section `1 / x`. -/
def reciprocalExceptionalLinearMap :
    R →ₗ[R] ExceptionalAway R x where
  toFun r :=
    algebraMap R (ExceptionalAway R x) r *
      IsLocalization.Away.invSelf x
  map_add' a b := by
    rw [map_add, add_mul]
  map_smul' a b := by
    simp only [RingHom.id_apply, Algebra.smul_def, map_mul,
      Algebra.algebraMap_self_apply]
    ac_rfl

/-- Principal part of `r / x`, modulo the integral image of `R`. -/
def sourceExceptionalPrincipalPartMap :
    R →ₗ[R]
      (ExceptionalAway R x ⧸ integralLocalizationSubmodule R x) :=
  (integralLocalizationSubmodule R x).mkQ.comp
    (reciprocalExceptionalLinearMap R x)

/-- The principal part `[r / x]` vanishes exactly when `r` is divisible by `x`. -/
theorem sourceExceptionalPrincipalPartMap_eq_zero_iff
    (hx : x ≠ 0) (r : R) :
    sourceExceptionalPrincipalPartMap R x r = 0 ↔
      ∃ a : R, r = x * a := by
  constructor
  · intro hr
    have hmem :
        reciprocalExceptionalLinearMap R x r ∈
          integralLocalizationSubmodule R x := by
      simpa [sourceExceptionalPrincipalPartMap, LinearMap.comp_apply] using hr
    obtain ⟨a, ha⟩ := hmem
    refine ⟨a, ?_⟩
    apply IsLocalization.injective (ExceptionalAway R x)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hx)
    have hmul := congrArg
      (fun z : ExceptionalAway R x =>
        algebraMap R (ExceptionalAway R x) x * z) ha
    have hmul' :
        algebraMap R (ExceptionalAway R x) x *
            algebraMap R (ExceptionalAway R x) a =
          algebraMap R (ExceptionalAway R x) r := by
      calc
        algebraMap R (ExceptionalAway R x) x *
              algebraMap R (ExceptionalAway R x) a =
            algebraMap R (ExceptionalAway R x) x *
              (algebraMap R (ExceptionalAway R x) r *
                IsLocalization.Away.invSelf x) := by
                  simpa [reciprocalExceptionalLinearMap] using hmul
        _ = algebraMap R (ExceptionalAway R x) r *
              (algebraMap R (ExceptionalAway R x) x *
                IsLocalization.Away.invSelf x) := by
                  ring
        _ = algebraMap R (ExceptionalAway R x) r := by
              rw [IsLocalization.Away.mul_invSelf, mul_one]
    simpa only [map_mul] using hmul'.symm
  · rintro ⟨a, rfl⟩
    change (integralLocalizationSubmodule R x).mkQ
      (algebraMap R (ExceptionalAway R x) (x * a) *
        IsLocalization.Away.invSelf x) = 0
    rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
    change
      algebraMap R (ExceptionalAway R x) (x * a) *
        IsLocalization.Away.invSelf x ∈
          integralLocalizationSubmodule R x
    refine ⟨a, ?_⟩
    simp only [Algebra.linearMap_apply, map_mul]
    calc
      algebraMap R (ExceptionalAway R x) a =
          algebraMap R (ExceptionalAway R x) a * 1 := by rw [mul_one]
      _ = algebraMap R (ExceptionalAway R x) a *
          (algebraMap R (ExceptionalAway R x) x *
            IsLocalization.Away.invSelf x) := by
            rw [IsLocalization.Away.mul_invSelf]
      _ = (algebraMap R (ExceptionalAway R x) x *
          algebraMap R (ExceptionalAway R x) a) *
            IsLocalization.Away.invSelf x := by ac_rfl

/-- Kernel form of the source exceptional principal-parts theorem. -/
theorem ker_sourceExceptionalPrincipalPartMap
    (hx : x ≠ 0) :
    LinearMap.ker (sourceExceptionalPrincipalPartMap R x) = R ∙ x := by
  ext r
  rw [LinearMap.mem_ker,
    sourceExceptionalPrincipalPartMap_eq_zero_iff R x hx,
    Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨a, by simp [mul_comm]⟩
  · rintro ⟨a, ha⟩
    exact ⟨a, by simpa [smul_eq_mul, mul_comm] using ha.symm⟩

/-- The denominator layer generated by `1 / x` is linearly equivalent to `R / (x)`. -/
noncomputable def sourceExceptionalPrincipalPartEquiv
    (hx : x ≠ 0) :
    (R ⧸ R ∙ x) ≃ₗ[R]
      LinearMap.range (sourceExceptionalPrincipalPartMap R x) :=
  Submodule.quotEquivOfEq
      (R ∙ x)
      (LinearMap.ker (sourceExceptionalPrincipalPartMap R x))
      (ker_sourceExceptionalPrincipalPartMap R x hx).symm ≪≫ₗ
    (sourceExceptionalPrincipalPartMap R x).quotKerEquivRange

/-- The equivalence sends the residue class of `r` to the principal part `[r / x]`. -/
theorem sourceExceptionalPrincipalPartEquiv_mk
    (hx : x ≠ 0) (r : R) :
    ((sourceExceptionalPrincipalPartEquiv R x hx
          (Submodule.Quotient.mk r) :
        LinearMap.range (sourceExceptionalPrincipalPartMap R x)) :
      ExceptionalAway R x ⧸ integralLocalizationSubmodule R x) =
      sourceExceptionalPrincipalPartMap R x r := by
  simp [sourceExceptionalPrincipalPartEquiv, LinearEquiv.trans_apply,
    Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivRange_apply_mk]

end

end GaloisForLFunctions.HTGeometry
