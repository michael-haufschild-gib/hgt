import Mathlib

/-!
# One-sided transcendence detects algebraic independence

A sequence in a field extension is algebraically independent exactly when every term is
transcendental over the field generated by its *strict successors*.  One-sidedness is enough: an
algebraic relation involves finitely many terms, and its smallest participating index is then
algebraic over the tail it does not touch.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Transcendence descends along an inclusion of subalgebras. -/
theorem transcendental_of_le_subalgebra {F E : Type*} [CommRing F] [CommRing E] [Algebra F E]
    {A B : Subalgebra F E} (hAB : A ≤ B) {y : E} (h : Transcendental B y) :
    Transcendental A y := by
  intro halg
  refine h ?_
  obtain ⟨p, hp0, hp⟩ := halg
  refine ⟨p.map (Subalgebra.inclusion hAB), ?_, ?_⟩
  · exact (Polynomial.map_ne_zero_iff (Subalgebra.inclusion_injective hAB)).mpr hp0
  · rw [Polynomial.aeval_def, Polynomial.eval₂_map] at *
    rw [← hp]
    congr 1

/-- **The one-sided criterion, finite prefixes.** -/
theorem algebraicIndependent_fin_of_transcendental_tail
    {F E : Type*} [Field F] [Field E] [Algebra F E] {j : ℕ → E}
    (h : ∀ n, Transcendental (Algebra.adjoin F (j '' Set.Ici (n + 1))) (j n)) :
    ∀ (N m : ℕ), AlgebraicIndependent F (fun i : Fin N => j (m + (i : ℕ))) := by
  intro N
  induction N with
  | zero => intro m; exact algebraicIndependent_empty_type
  | succ N ih =>
      intro m
      have hIH : AlgebraicIndependent F (fun i : Fin N => j (m + 1 + (i : ℕ))) := ih (m + 1)
      have htr : Transcendental
          (Algebra.adjoin F (Set.range (fun i : Fin N => j (m + 1 + (i : ℕ))))) (j m) := by
        refine transcendental_of_le_subalgebra ?_ (h m)
        refine Algebra.adjoin_mono ?_
        rintro y ⟨i, rfl⟩
        exact ⟨m + 1 + (i : ℕ), by simp, rfl⟩
      have hopt : AlgebraicIndependent F
          (fun o : Option (Fin N) => o.elim (j m) (fun i : Fin N => j (m + 1 + (i : ℕ)))) :=
        AlgebraicIndependent.option_iff.mpr ⟨hIH, htr⟩
      have hcomp := hopt.comp (finSuccEquiv N) (finSuccEquiv N).injective
      have hfun : ((fun o : Option (Fin N) => o.elim (j m) (fun i : Fin N => j (m + 1 + (i : ℕ))))
          ∘ (finSuccEquiv N)) = fun i : Fin (N + 1) => j (m + (i : ℕ)) := by
        funext i
        refine Fin.cases ?_ (fun i => ?_) i
        · simp
        · simp only [Function.comp_apply, finSuccEquiv_succ, Option.elim, Fin.val_succ]
          congr 1
          omega
      rwa [hfun] at hcomp

/-- **The one-sided criterion.**  A sequence each of whose terms is transcendental over the field
generated by its strict successors is algebraically independent. -/
theorem algebraicIndependent_of_transcendental_tail
    {F E : Type*} [Field F] [Field E] [Algebra F E] {j : ℕ → E}
    (h : ∀ n, Transcendental (Algebra.adjoin F (j '' Set.Ici (n + 1))) (j n)) :
    AlgebraicIndependent F j := by
  classical
  have hfin := algebraicIndependent_fin_of_transcendental_tail h
  rw [algebraicIndependent_iff]
  intro p hp
  have hsub : ↑p.vars ⊆ Set.range (fun i : Fin (p.vars.sup id + 1) => (i : ℕ)) := by
    intro i hi
    refine ⟨⟨i, ?_⟩, rfl⟩
    have hle := Finset.le_sup (f := (id : ℕ → ℕ)) (Finset.mem_coe.mp hi)
    simp only [id_eq] at hle
    omega
  obtain ⟨q, hq⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range p
    (fun i : Fin (p.vars.sup id + 1) => (i : ℕ)) Fin.val_injective hsub
  rw [← hq, MvPolynomial.aeval_rename] at hp
  have hjfun : (j ∘ fun i : Fin (p.vars.sup id + 1) => (i : ℕ))
      = fun i : Fin (p.vars.sup id + 1) => j (0 + (i : ℕ)) := by
    funext i; simp
  rw [hjfun] at hp
  rw [← hq, algebraicIndependent_iff.mp (hfin (p.vars.sup id + 1) 0) q hp, map_zero]

end GaloisForLFunctions.HTGeometry
