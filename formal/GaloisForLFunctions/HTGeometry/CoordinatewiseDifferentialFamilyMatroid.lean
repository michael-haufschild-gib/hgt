import GaloisForLFunctions.HTGeometry.DifferentialFamilyMatroid
import GaloisForLFunctions.HTGeometry.SourceLogarithmicBoundary

/-!
# Coordinatewise differential-algebraic replacement of represented matroids

This module upgrades the finite coordinatewise replacement theorem to arbitrary
families.  Finitarity of the differential matroid promotes equality on every
finite restriction to equality of the entire represented matroid.  As a concrete
application, a raw multiplicative family and its coordinatewise algebraic
logarithmic derivatives represent the same differential matroid, including when
they are joined to an arbitrary additive family.
-/

namespace GaloisForLFunctions.HTGeometry

open Set
open scoped Classical Differential

noncomputable section

universe u v w

/-- Every member of a set is differential-algebraic over the differential field
generated by that set. -/
theorem differentialAlgebraicOver_differentialAdjoin_of_mem
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {s : Set E} {x : E} (hx : x ∈ s) :
    DifferentialAlgebraicOver (differentialAdjoin F s) x := by
  let S := differentialAdjoin F s
  letI : DifferentialAlgebra S E :=
    ⟨fun c ↦ derivationClosedDifferential_apply S
      (derivationClosed_differentialAdjoin F s) c⟩
  have hxS : x ∈ S := subset_differentialAdjoin F s hx
  have h := differentialAlgebraicOver_algebraMap
    (F := S) (E := E) (⟨x, hxS⟩ : S)
  simpa [S] using h

/-- A differential family matroid is finitary: dependence of an arbitrary
subfamily is witnessed by a finite subfamily. -/
instance differentialFamilyMatroid_finitary
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x : ι → E) :
    (GaloisForLFunctions.differentialFamilyMatroid (F := F) x).Finitary := by
  unfold GaloisForLFunctions.differentialFamilyMatroid
  infer_instance

/-- Coordinatewise mutually differential-algebraic finite families have the same
differential-independence status, including the empty family. -/
theorem coordinatewiseMutuallyDifferentialAlgebraic_finite_iff
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    [Finite ι] (x y : ι → E)
    (hxy : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({y i} : Set E)) (x i))
    (hyx : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({x i} : Set E)) (y i)) :
    DifferentialIndependent F x ↔ DifferentialIndependent F y := by
  classical
  cases isEmpty_or_nonempty ι with
  | inl hEmpty =>
      letI : IsEmpty ι := hEmpty
      exact iff_of_true algebraicIndependent_empty_type
        algebraicIndependent_empty_type
  | inr hNonempty =>
      letI : Nonempty ι := hNonempty
      obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
      cases n with
      | zero => exact False.elim (Fin.elim0 (e (Classical.choice hNonempty)))
      | succ n =>
          have h := coordinatewiseMutuallyDifferentialAlgebraic_fin_succ_iff
            (F := F) (E := E) (x ∘ e.symm) (y ∘ e.symm)
            (fun i ↦ hxy (e.symm i)) (fun i ↦ hyx (e.symm i))
          rwa [differentialIndependent_equiv e.symm x,
            differentialIndependent_equiv e.symm y] at h

/-- Coordinatewise mutual differential algebraicity preserves the entire represented
differential matroid, for families of arbitrary cardinality. -/
theorem differentialFamilyMatroid_eq_of_coordinatewiseMutuallyDifferentialAlgebraic
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x y : ι → E)
    (hxy : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({y i} : Set E)) (x i))
    (hyx : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({x i} : Set E)) (y i)) :
    GaloisForLFunctions.differentialFamilyMatroid (F := F) x =
      GaloisForLFunctions.differentialFamilyMatroid (F := F) y := by
  classical
  apply Matroid.ext_indep
  · simp [GaloisForLFunctions.differentialFamilyMatroid]
  · intro I _
    constructor
    · intro hxI
      apply Matroid.indep_of_forall_finite_subset_indep
      intro J hJI hJFinite
      have hxJ := hxI.subset hJI
      rw [GaloisForLFunctions.differentialFamilyMatroid_indep_iff] at hxJ ⊢
      letI : Finite J := hJFinite.to_subtype
      exact (coordinatewiseMutuallyDifferentialAlgebraic_finite_iff
        (F := F) (E := E)
        (fun j : J ↦ x j) (fun j : J ↦ y j)
        (fun j ↦ hxy j) (fun j ↦ hyx j)).mp hxJ
    · intro hyI
      apply Matroid.indep_of_forall_finite_subset_indep
      intro J hJI hJFinite
      have hyJ := hyI.subset hJI
      rw [GaloisForLFunctions.differentialFamilyMatroid_indep_iff] at hyJ ⊢
      letI : Finite J := hJFinite.to_subtype
      exact (coordinatewiseMutuallyDifferentialAlgebraic_finite_iff
        (F := F) (E := E)
        (fun j : J ↦ x j) (fun j : J ↦ y j)
        (fun j ↦ hxy j) (fun j ↦ hyx j)).mpr hyJ

/-- Coordinatewise mutual differential algebraicity preserves differential
independence for a family of arbitrary cardinality. -/
theorem coordinatewiseMutuallyDifferentialAlgebraic_iff
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x y : ι → E)
    (hxy : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({y i} : Set E)) (x i))
    (hyx : ∀ i,
      DifferentialAlgebraicOver (differentialAdjoin F ({x i} : Set E)) (y i)) :
    DifferentialIndependent F x ↔ DifferentialIndependent F y := by
  have hM := differentialFamilyMatroid_eq_of_coordinatewiseMutuallyDifferentialAlgebraic
    x y hxy hyx
  constructor
  · intro hx
    apply (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := y)).mp
    rw [← hM]
    exact (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := x)).mpr hx
  · intro hy
    apply (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := x)).mp
    rw [hM]
    exact (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := y)).mpr hy

/-- Replacing every coordinate by its algebraic logarithmic derivative preserves the
entire differential family matroid, without a finiteness hypothesis. -/
theorem differentialFamilyMatroid_deriv_div_self_eq
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x : ι → E) :
    GaloisForLFunctions.differentialFamilyMatroid (F := F) x =
      GaloisForLFunctions.differentialFamilyMatroid (F := F)
        (fun i ↦ (x i)′ / x i) := by
  apply differentialFamilyMatroid_eq_of_coordinatewiseMutuallyDifferentialAlgebraic
  · intro i
    exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).1
  · intro i
    exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).2

/-- Replacing every coordinate by its algebraic logarithmic derivative preserves
differential independence, without a finiteness hypothesis. -/
theorem differentialIndependent_deriv_div_self_iff
    {F E : Type u} {ι : Type v} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x : ι → E) :
    DifferentialIndependent F x ↔
      DifferentialIndependent F (fun i ↦ (x i)′ / x i) := by
  apply coordinatewiseMutuallyDifferentialAlgebraic_iff
  · intro i
    exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).1
  · intro i
    exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).2

/-- Replacing an arbitrary multiplicative block by its coordinatewise algebraic
logarithmic derivative preserves the full differential matroid jointly with an
arbitrary additive block. -/
theorem differentialFamilyMatroid_sumElim_deriv_div_self_eq
    {F E : Type u} {A : Type v} {ι : Type w}
    [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (u : A → E) (x : ι → E) :
    GaloisForLFunctions.differentialFamilyMatroid (F := F) (Sum.elim u x) =
      GaloisForLFunctions.differentialFamilyMatroid (F := F)
        (Sum.elim u (fun i ↦ (x i)′ / x i)) := by
  apply differentialFamilyMatroid_eq_of_coordinatewiseMutuallyDifferentialAlgebraic
  · rintro (a | i)
    · exact differentialAlgebraicOver_differentialAdjoin_of_mem
        (F := F) (s := ({u a} : Set E)) rfl
    · exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).1
  · rintro (a | i)
    · exact differentialAlgebraicOver_differentialAdjoin_of_mem
        (F := F) (s := ({u a} : Set E)) rfl
    · exact (raw_logCoordinate_mutuallyDifferentialAlgebraic (F := F) (x i)).2

/-- Replacing an arbitrary multiplicative block by its coordinatewise algebraic
logarithmic derivative preserves joint differential independence with an
arbitrary additive block. -/
theorem differentialIndependent_sumElim_deriv_div_self_iff
    {F E : Type u} {A : Type v} {ι : Type w}
    [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (u : A → E) (x : ι → E) :
    DifferentialIndependent F (Sum.elim u x) ↔
      DifferentialIndependent F (Sum.elim u (fun i ↦ (x i)′ / x i)) := by
  have hM := differentialFamilyMatroid_sumElim_deriv_div_self_eq
    (F := F) u x
  constructor
  · intro hx
    apply (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E)
      (x := Sum.elim u (fun i ↦ (x i)′ / x i))).mp
    rw [← hM]
    exact (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := Sum.elim u x)).mpr hx
  · intro hy
    apply (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E) (x := Sum.elim u x)).mp
    rw [hM]
    exact (GaloisForLFunctions.differentialFamilyMatroid_eq_freeOn_iff
      (F := F) (E := E)
      (x := Sum.elim u (fun i ↦ (x i)′ / x i))).mpr hy

end

end GaloisForLFunctions.HTGeometry
