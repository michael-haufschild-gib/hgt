import GaloisForLFunctions.HTGeometry.ColorGramMinkowskiOrbit
import Mathlib.LinearAlgebra.Matrix.SchurComplement
import Mathlib.LinearAlgebra.UnitaryGroup

/-!
# Regular colour-Gram fibres are transitive `SU(3)` orbits

Equal colour-Gram records were previously shown to differ by a left `U(3)` transformation. On the
regular locus this file removes the determinant phase without changing the event:

* the three maximal minors define a nonzero complex normal to the event columns;
* a rank-one phase rotation along that normal fixes the event;
* its determinant is the prescribed phase; and
* composing it with the canonical unitary Gram transporter yields an `SU(3)` transporter.

Thus equal regular `3 × 2` Gram records are exactly left `SU(3)` orbits. This proves transitivity,
not yet freeness, of the `SU(3)` action on each regular fibre.
-/

open Matrix
open scoped ComplexOrder Matrix

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Rotate a self-adjoint idempotent subspace by a scalar phase. -/
def phaseByProjection
    {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n ℂ) (t : ℂ) : Matrix n n ℂ :=
  1 + (t - 1) • P

/-- A unit phase produces a unitary rotation on a self-adjoint idempotent subspace. -/
theorem phaseByProjection_conjTranspose_mul_self
    {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n ℂ) (t : ℂ)
    (hPstar : Pᴴ = P) (hPidempotent : P * P = P)
    (ht : star t * t = 1) :
    (phaseByProjection P t)ᴴ * phaseByProjection P t = 1 := by
  have ht' : t * star t = 1 := by
    simpa [mul_comm] using ht
  simp only [phaseByProjection, Matrix.conjTranspose_add,
    Matrix.conjTranspose_one, Matrix.conjTranspose_smul, hPstar]
  rw [add_mul, one_mul, mul_add, mul_one, smul_mul, mul_smul_comm,
    hPidempotent, smul_smul]
  ext i j
  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply,
    smul_eq_mul]
  rw [star_sub, star_one]
  ring_nf
  have hentry : t * P i j * star t = P i j := by
    calc
      t * P i j * star t = (t * star t) * P i j := by ring
      _ = P i j := by rw [ht']; simp
  rw [hentry]
  ring

/-- Hermitian norm square of a finite complex root. -/
def rootHermitianNormSq
    {n : Type*} [Fintype n] (v : n → ℂ) : ℂ :=
  star v ⬝ᵥ v

/-- Orthogonal rank-one projector onto the line generated by a nonzero root. -/
def rankOneOrthogonalProjection
    {n : Type*} [Fintype n] (v : n → ℂ) : Matrix n n ℂ :=
  Matrix.vecMulVec ((rootHermitianNormSq v)⁻¹ • v) (star v)

/-- A Hermitian norm square is fixed by complex conjugation. -/
theorem rootHermitianNormSq_star
    {n : Type*} [Fintype n] (v : n → ℂ) :
    star (rootHermitianNormSq v) = rootHermitianNormSq v := by
  exact (Matrix.star_dotProduct v v).symm

/-- The normalized rank-one operator is self-adjoint. -/
theorem rankOneOrthogonalProjection_conjTranspose
    {n : Type*} [Fintype n] (v : n → ℂ) :
    (rankOneOrthogonalProjection v)ᴴ =
      rankOneOrthogonalProjection v := by
  ext i j
  simp only [rankOneOrthogonalProjection, Matrix.conjTranspose_apply,
    Matrix.vecMulVec_apply, Pi.star_apply, star_mul, star_star]
  simp only [Pi.smul_apply, smul_eq_mul, star_mul, star_inv₀]
  rw [rootHermitianNormSq_star]
  ring

/-- The normalized rank-one operator is idempotent when its root is nonzero. -/
theorem rankOneOrthogonalProjection_idempotent
    {n : Type*} [Fintype n] (v : n → ℂ)
    (hnorm : rootHermitianNormSq v ≠ 0) :
    rankOneOrthogonalProjection v * rankOneOrthogonalProjection v =
      rankOneOrthogonalProjection v := by
  have hdot :
      star v ⬝ᵥ (rootHermitianNormSq v)⁻¹ • v = 1 := by
    rw [dotProduct_smul]
    simp only [smul_eq_mul, rootHermitianNormSq]
    exact inv_mul_cancel₀ hnorm
  simp only [rankOneOrthogonalProjection,
    Matrix.vecMulVec_mul_vecMulVec, hdot, one_smul]

/-- Phase rotation on the line generated by a nonzero root. -/
def phaseAlongRoot
    {n : Type*} [Fintype n] [DecidableEq n]
    (v : n → ℂ) (t : ℂ) : Matrix n n ℂ :=
  phaseByProjection (rankOneOrthogonalProjection v) t

/-- Phase rotation along a nonzero root is unitary. -/
theorem phaseAlongRoot_conjTranspose_mul_self
    {n : Type*} [Fintype n] [DecidableEq n]
    (v : n → ℂ) (t : ℂ)
    (hnorm : rootHermitianNormSq v ≠ 0)
    (ht : star t * t = 1) :
    (phaseAlongRoot v t)ᴴ * phaseAlongRoot v t = 1 := by
  exact phaseByProjection_conjTranspose_mul_self
    (rankOneOrthogonalProjection v) t
    (rankOneOrthogonalProjection_conjTranspose v)
    (rankOneOrthogonalProjection_idempotent v hnorm) ht

/-- The determinant of a phase rotation along one root is the prescribed phase. -/
theorem phaseAlongRoot_det
    {n : Type*} [Fintype n] [DecidableEq n]
    (v : n → ℂ) (t : ℂ)
    (hnorm : rootHermitianNormSq v ≠ 0) :
    (phaseAlongRoot v t).det = t := by
  have hdot :
      star v ⬝ᵥ (rootHermitianNormSq v)⁻¹ • v = 1 := by
    rw [dotProduct_smul]
    simp only [smul_eq_mul, rootHermitianNormSq]
    exact inv_mul_cancel₀ hnorm
  simp only [phaseAlongRoot, phaseByProjection, rankOneOrthogonalProjection]
  rw [← Matrix.smul_vecMulVec]
  rw [Matrix.vecMulVec_eq Unit,
    Matrix.det_one_add_replicateCol_mul_replicateRow]
  rw [dotProduct_smul, hdot]
  simp

/-- Phase rotation along a root fixes every matrix Hermitian-orthogonal to that root. -/
theorem phaseAlongRoot_mul_eq_self_of_orthogonal
    {n m : Type*} [Fintype n] [DecidableEq n] [Fintype m]
    (v : n → ℂ) (X : Matrix n m ℂ) (t : ℂ)
    (horthogonal : star v ᵥ* X = 0) :
    phaseAlongRoot v t * X = X := by
  simp only [phaseAlongRoot, phaseByProjection, rankOneOrthogonalProjection]
  rw [Matrix.add_mul, Matrix.one_mul, Matrix.smul_mul,
    Matrix.vecMulVec_mul, horthogonal]
  have hz :
      Matrix.vecMulVec ((rootHermitianNormSq v)⁻¹ • v)
          (0 : m → ℂ) = 0 := by
    ext i j
    simp [Matrix.vecMulVec_apply]
  rw [hz, smul_zero, add_zero]

/-- Complex normal of the two columns of a `3 × 2` colour event. -/
def colorEventNormal (X : ColorEventMatrix) : Fin 3 → ℂ :=
  ![star (colorMinor12 X), -star (colorMinor02 X), star (colorMinor01 X)]

/-- The complex normal is Hermitian-orthogonal to both event columns. -/
theorem colorEventNormal_vecMul (X : ColorEventMatrix) :
    star (colorEventNormal X) ᵥ* X = 0 := by
  funext j
  fin_cases j <;>
    simp [colorEventNormal, colorMinor01, colorMinor02, colorMinor12,
      Matrix.vecMul, dotProduct, Fin.sum_univ_succ] <;>
    ring

/-- Squared norm of the event normal is exactly the maximal-minor energy. -/
theorem colorEventNormal_rootHermitianNormSq
    (X : ColorEventMatrix) :
    rootHermitianNormSq (colorEventNormal X) =
      (colorMinorEnergy X : ℂ) := by
  simp [rootHermitianNormSq, colorEventNormal, dotProduct,
    colorMinorEnergy, Fin.sum_univ_succ, Complex.mul_conj]
  ring

/-- A positive-definite colour Gram record has a nonzero event normal. -/
theorem colorEventNormal_rootHermitianNormSq_ne_zero
    (X : ColorEventMatrix) (hX : (colorGramMatrix X).PosDef) :
    rootHermitianNormSq (colorEventNormal X) ≠ 0 := by
  rw [colorEventNormal_rootHermitianNormSq]
  have hdet :=
    (colorGramMatrix_posSemidef X).posDef_iff_det_ne_zero.mp hX
  rw [colorGramMatrix_det_eq_minorEnergy] at hdet
  exact hdet

/--
Correct the determinant of the canonical unitary Gram transporter by a phase on the source
event's one-dimensional normal complement.
-/
def colorSpecialTransporter
    (X Y : ColorEventMatrix) (hGram : Xᴴ * X = Yᴴ * Y) :
    Matrix (Fin 3) (Fin 3) ℂ :=
  let U := colorOrbitUnitary X Y hGram
  U * phaseAlongRoot (colorEventNormal X) (star U.det)

/-- The determinant-corrected transporter still carries the source event to the target event. -/
theorem colorSpecialTransporter_mul
    (X Y : ColorEventMatrix) (hGram : Xᴴ * X = Yᴴ * Y) :
    colorSpecialTransporter X Y hGram * X = Y := by
  simp only [colorSpecialTransporter]
  rw [Matrix.mul_assoc,
    phaseAlongRoot_mul_eq_self_of_orthogonal
      (colorEventNormal X) X _ (colorEventNormal_vecMul X),
    colorOrbitUnitary_mul X Y hGram]

/-- On the regular locus, the determinant-corrected transporter belongs to `SU(3)`. -/
theorem colorSpecialTransporter_mem_specialUnitary
    (X Y : ColorEventMatrix) (hGram : Xᴴ * X = Yᴴ * Y)
    (hX : (colorGramMatrix X).PosDef) :
    colorSpecialTransporter X Y hGram ∈
      Matrix.specialUnitaryGroup (Fin 3) ℂ := by
  let U := colorOrbitUnitary X Y hGram
  let D := phaseAlongRoot (colorEventNormal X) (star U.det)
  have hUstar : Uᴴ * U = 1 :=
    colorOrbitUnitary_conjTranspose_mul_self X Y hGram
  have hUmem : U ∈ Matrix.unitaryGroup (Fin 3) ℂ := by
    rw [Matrix.mem_unitaryGroup_iff']
    simpa [Matrix.star_eq_conjTranspose] using hUstar
  have hdetUnit := Matrix.det_of_mem_unitary hUmem
  have hphase : star (star U.det) * star U.det = 1 := by
    simpa only [star_star] using hdetUnit.2
  have hnorm :
      rootHermitianNormSq (colorEventNormal X) ≠ 0 :=
    colorEventNormal_rootHermitianNormSq_ne_zero X hX
  have hDstar : Dᴴ * D = 1 :=
    phaseAlongRoot_conjTranspose_mul_self
      (colorEventNormal X) (star U.det) hnorm hphase
  have hDmem : D ∈ Matrix.unitaryGroup (Fin 3) ℂ := by
    rw [Matrix.mem_unitaryGroup_iff']
    simpa [Matrix.star_eq_conjTranspose] using hDstar
  rw [Matrix.mem_specialUnitaryGroup_iff]
  constructor
  · exact (Matrix.unitaryGroup (Fin 3) ℂ).mul_mem hUmem hDmem
  · simp only [colorSpecialTransporter, Matrix.det_mul]
    rw [phaseAlongRoot_det (colorEventNormal X) (star U.det) hnorm]
    exact hdetUnit.2

/--
On the regular locus, equal Gram records are exactly the orbits of left `SU(3)`, not merely
left `U(3)`.
-/
theorem colorGramMatrix_eq_iff_exists_left_specialUnitary
    (X Y : ColorEventMatrix) (hX : (colorGramMatrix X).PosDef) :
    Xᴴ * X = Yᴴ * Y ↔
      ∃ U : Matrix (Fin 3) (Fin 3) ℂ,
        U ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ ∧ U * X = Y := by
  constructor
  · intro hGram
    exact ⟨colorSpecialTransporter X Y hGram,
      colorSpecialTransporter_mem_specialUnitary X Y hGram hX,
      colorSpecialTransporter_mul X Y hGram⟩
  · rintro ⟨U, hU, rfl⟩
    have hUnitary :=
      Matrix.specialUnitaryGroup_le_unitaryGroup hU
    have hUstar : Uᴴ * U = 1 := by
      have h := (Matrix.mem_unitaryGroup_iff').mp hUnitary
      simpa [Matrix.star_eq_conjTranspose] using h
    simpa [colorGramMatrix] using
      (colorGramMatrix_left_invariant U X hUstar).symm

/-- Complete an event's two columns by an arbitrary third column. -/
def colorEventFrameWithThird
    (X : ColorEventMatrix) (w : Fin 3 → ℂ) :
    Matrix (Fin 3) (Fin 3) ℂ :=
  fun i j => if j = 0 then X i 0 else if j = 1 then X i 1 else w i

/-- Complete a colour event by its canonical complex normal. -/
def colorEventFrame (X : ColorEventMatrix) :
    Matrix (Fin 3) (Fin 3) ℂ :=
  colorEventFrameWithThird X (colorEventNormal X)

/-- Determinant against an arbitrary third column is its pairing with the event normal. -/
theorem colorEventFrameWithThird_det
    (X : ColorEventMatrix) (w : Fin 3 → ℂ) :
    (colorEventFrameWithThird X w).det =
      star (colorEventNormal X) ⬝ᵥ w := by
  rw [Matrix.det_fin_three]
  simp [colorEventFrameWithThird, colorEventNormal,
    colorMinor01, colorMinor02, colorMinor12,
    dotProduct, Fin.sum_univ_succ]
  ring

/-- Determinant of the canonical completed event frame is its maximal-minor energy. -/
theorem colorEventFrame_det (X : ColorEventMatrix) :
    (colorEventFrame X).det = (colorMinorEnergy X : ℂ) := by
  rw [colorEventFrame, colorEventFrameWithThird_det,
    ← colorEventNormal_rootHermitianNormSq]
  rfl

/-- A regular event's canonical completed frame is invertible. -/
theorem colorEventFrame_isUnit
    (X : ColorEventMatrix) (hX : (colorGramMatrix X).PosDef) :
    IsUnit (colorEventFrame X) := by
  rw [Matrix.isUnit_iff_isUnit_det, isUnit_iff_ne_zero,
    colorEventFrame_det]
  have hdet :=
    (colorGramMatrix_posSemidef X).posDef_iff_det_ne_zero.mp hX
  rwa [colorGramMatrix_det_eq_minorEnergy] at hdet

/-- Left multiplication acts on all three columns of a completed event frame. -/
theorem colorEventFrameWithThird_mul
    (U : Matrix (Fin 3) (Fin 3) ℂ)
    (X : ColorEventMatrix) (w : Fin 3 → ℂ) :
    U * colorEventFrameWithThird X w =
      colorEventFrameWithThird (U * X) (U *ᵥ w) := by
  ext i j
  fin_cases j <;>
    simp [colorEventFrameWithThird, Matrix.mul_apply,
      Matrix.mulVec, dotProduct]

/-- If a left matrix fixes an event, it acts only on the completed frame's normal column. -/
theorem colorEventFrame_mul_of_fix_event
    (U : Matrix (Fin 3) (Fin 3) ℂ)
    (X : ColorEventMatrix) (hfix : U * X = X) :
    U * colorEventFrame X =
      colorEventFrameWithThird X (U *ᵥ colorEventNormal X) := by
  rw [colorEventFrame, colorEventFrameWithThird_mul, hfix]

/-- A special-unitary matrix fixing a regular event also fixes its canonical normal. -/
theorem specialUnitary_fix_regular_event_normal
    (U : Matrix (Fin 3) (Fin 3) ℂ)
    (X : ColorEventMatrix)
    (hU : U ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ)
    (hX : (colorGramMatrix X).PosDef)
    (hfix : U * X = X) :
    U *ᵥ colorEventNormal X = colorEventNormal X := by
  let n := colorEventNormal X
  let z := U *ᵥ n - n
  have hUnitary :=
    Matrix.specialUnitaryGroup_le_unitaryGroup hU
  have hUstar : Uᴴ * U = 1 := by
    have h := (Matrix.mem_unitaryGroup_iff').mp hUnitary
    simpa [Matrix.star_eq_conjTranspose] using h
  have hUstarFix : Uᴴ * X = X := by
    calc
      Uᴴ * X = Uᴴ * (U * X) := by rw [hfix]
      _ = (Uᴴ * U) * X := by rw [Matrix.mul_assoc]
      _ = X := by rw [hUstar, Matrix.one_mul]
  have hFixStar : Xᴴ * U = Xᴴ := by
    have h := congrArg Matrix.conjTranspose hUstarFix
    simpa [Matrix.conjTranspose_mul] using h
  have hXz : Xᴴ *ᵥ z = 0 := by
    have horth := colorEventNormal_vecMul X
    have hXn : Xᴴ *ᵥ n = 0 := by
      rw [Matrix.mulVec_conjTranspose, horth]
      simp
    simp only [z, Matrix.mulVec_sub]
    rw [Matrix.mulVec_mulVec, hFixStar, hXn, sub_self]
  have hdetFrame :
      (colorEventFrameWithThird X (U *ᵥ n)).det =
        (colorEventFrame X).det := by
    have hUdet : U.det = 1 := hU.2
    rw [← colorEventFrame_mul_of_fix_event U X hfix,
      Matrix.det_mul, hUdet, one_mul]
  have hnz : star n ⬝ᵥ z = 0 := by
    rw [colorEventFrameWithThird_det] at hdetFrame
    rw [colorEventFrame_det, ← colorEventNormal_rootHermitianNormSq] at hdetFrame
    simp only [z, dotProduct_sub]
    exact sub_eq_zero.mpr hdetFrame
  have hFrameZ : (colorEventFrame X)ᴴ *ᵥ z = 0 := by
    ext i
    fin_cases i
    · have h := congrFun hXz 0
      simpa [colorEventFrame, colorEventFrameWithThird,
        Matrix.mulVec, dotProduct, Fin.sum_univ_succ] using h
    · have h := congrFun hXz 1
      simpa [colorEventFrame, colorEventFrameWithThird,
        Matrix.mulVec, dotProduct, Fin.sum_univ_succ] using h
    · simpa [colorEventFrame, colorEventFrameWithThird,
        Matrix.mulVec, dotProduct, Fin.sum_univ_succ] using hnz
  have hFrameUnit := colorEventFrame_isUnit X hX
  have hFrameStarUnit : IsUnit (colorEventFrame X)ᴴ := by
    simpa [Matrix.star_eq_conjTranspose] using hFrameUnit.star
  have hinjective :
      Function.Injective (colorEventFrame X)ᴴ.mulVec :=
    Matrix.mulVec_injective_iff_isUnit.mpr hFrameStarUnit
  have hz : z = 0 := by
    apply hinjective
    simpa using hFrameZ
  exact sub_eq_zero.mp hz

/-- The stabilizer in `SU(3)` of a regular colour event is trivial. -/
theorem specialUnitary_fix_regular_event_eq_one
    (U : Matrix (Fin 3) (Fin 3) ℂ)
    (X : ColorEventMatrix)
    (hU : U ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ)
    (hX : (colorGramMatrix X).PosDef)
    (hfix : U * X = X) :
    U = 1 := by
  have hnormal :
      U *ᵥ colorEventNormal X = colorEventNormal X :=
    specialUnitary_fix_regular_event_normal U X hU hX hfix
  have hFrameFix : U * colorEventFrame X = colorEventFrame X := by
    rw [colorEventFrame_mul_of_fix_event U X hfix, hnormal]
    rfl
  have hFrameUnit := colorEventFrame_isUnit X hX
  apply hFrameUnit.mul_right_cancel
  simpa using hFrameFix

/-- The left `SU(3)` action is free at every regular colour event. -/
theorem left_specialUnitary_action_free_on_regular
    (X : ColorEventMatrix) (hX : (colorGramMatrix X).PosDef)
    (U V : Matrix (Fin 3) (Fin 3) ℂ)
    (hU : U ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ)
    (hV : V ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ)
    (hUV : U * X = V * X) :
    U = V := by
  have hVUnitary :=
    Matrix.specialUnitaryGroup_le_unitaryGroup hV
  have hVstar : Vᴴ * V = 1 := by
    have h := (Matrix.mem_unitaryGroup_iff').mp hVUnitary
    simpa [Matrix.star_eq_conjTranspose] using h
  have hVmulStar : V * Vᴴ = 1 := by
    have h := (Matrix.mem_unitaryGroup_iff).mp hVUnitary
    simpa [Matrix.star_eq_conjTranspose] using h
  have hVdet : V.det = 1 := hV.2
  let W := Vᴴ * U
  have hW : W ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ := by
    have hVstarMem :
        Vᴴ ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ := by
      rw [Matrix.mem_specialUnitaryGroup_iff]
      constructor
      · have hstarMem := Unitary.star_mem hVUnitary
        simpa [Matrix.star_eq_conjTranspose] using hstarMem
      · rw [Matrix.det_conjTranspose, hVdet, star_one]
    exact (Matrix.specialUnitaryGroup (Fin 3) ℂ).mul_mem hVstarMem hU
  have hWfix : W * X = X := by
    simp only [W, Matrix.mul_assoc]
    rw [hUV, ← Matrix.mul_assoc, hVstar, Matrix.one_mul]
  have hWone : W = 1 :=
    specialUnitary_fix_regular_event_eq_one W X hW hX hWfix
  have hVU : Vᴴ * U = 1 := hWone
  calc
    U = 1 * U := by rw [Matrix.one_mul]
    _ = (V * Vᴴ) * U := by
      rw [hVmulStar]
    _ = V * (Vᴴ * U) := by rw [Matrix.mul_assoc]
    _ = V := by rw [hVU, Matrix.mul_one]

/-- Every two regular equal-Gram events are related by a unique left `SU(3)` transporter. -/
theorem existsUnique_left_specialUnitary_of_eq_gram
    (X Y : ColorEventMatrix)
    (hX : (colorGramMatrix X).PosDef)
    (hGram : Xᴴ * X = Yᴴ * Y) :
    ∃! U : Matrix.specialUnitaryGroup (Fin 3) ℂ,
      (U.1 : Matrix (Fin 3) (Fin 3) ℂ) * X = Y := by
  let Umat := colorSpecialTransporter X Y hGram
  have hUmem :
      Umat ∈ Matrix.specialUnitaryGroup (Fin 3) ℂ :=
    colorSpecialTransporter_mem_specialUnitary X Y hGram hX
  refine ⟨⟨Umat, hUmem⟩, colorSpecialTransporter_mul X Y hGram, ?_⟩
  intro V hV
  apply Subtype.ext
  exact left_specialUnitary_action_free_on_regular
    X hX V.1 Umat V.2 hUmem
    (hV.trans (colorSpecialTransporter_mul X Y hGram).symm)

end GaloisForLFunctions.HTGeometry
