import GaloisForLFunctions.HTGeometry.CoprimePrimeResidueInteraction

/-!
# Observer-clock interaction anomaly

A scale-dependent observer clock acts on joint observables by pointwise multiplication.  The
row-plus-column marginal space is not an ideal under this action: a clock preserves every marginal
exactly when its rate is constant.  The resulting anchored interaction is the product of clock
contrast and organ contrast, and its action on all marginals reconstructs the clock modulo scalar
gauge.
-/

namespace GaloisForLFunctions.HTGeometry

open Set

noncomputable section

/-- Pointwise action of a scale clock on a joint observable. -/
def observerClockMultiplier
    {A B : Type*} (rate : A → ℂ)
    (f : FullValueSubtype (A × B) → ℂ) :
    FullValueSubtype (A × B) → ℂ :=
  fun x => rate x.1.1 * f x

/-- Separated scale/organ observable generated by a clock and an organ reporter. -/
def separatedClockOrganObservable
    {A B : Type*} (rate : A → ℂ) (organ : B → ℂ) :
    FullValueSubtype (A × B) → ℂ :=
  fun x => rate x.1.1 * organ x.1.2

/-- Clock-generated interaction, represented in the anchored complement. -/
def observerClockInteractionAnomaly
    (A B : Type*) [One A] [One B]
    (rate : A → ℂ) (f : FullValueSubtype (A × B) → ℂ) :
    FullValueSubtype (A × B) → ℂ :=
  productAnchoredInteractionPart A B (observerClockMultiplier rate f)

/-- Preservation of every row-plus-column marginal by a scale clock. -/
def ProductMarginalClockStable
    (A B : Type*) (rate : A → ℂ) : Prop :=
  ∀ f : FullValueSubtype (A × B) → ℂ,
    f ∈ productMarginalObservableSubmodule A B →
      observerClockMultiplier rate f ∈ productMarginalObservableSubmodule A B

/-- Constant clock rescaling preserves every marginal observable.  In particular this covers the
constant sign/phase subgroup supplied by functional-equation reflection. -/
theorem constantObserverClock_preserves_marginals
    (A B : Type*) (c : ℂ) :
    ProductMarginalClockStable A B (fun _ => c) := by
  intro f hf
  have heq : observerClockMultiplier (fun _ : A => c) f = c • f := by
    funext x
    simp [observerClockMultiplier]
  rw [heq]
  exact (productMarginalObservableSubmodule A B).smul_mem c hf

/-- Anchored interaction is the exact quotient test for row-plus-column marginality. -/
theorem mem_productMarginalObservableSubmodule_iff_anchoredInteractionPart_eq_zero
    (A B : Type*) [One A] [One B]
    (f : FullValueSubtype (A × B) → ℂ) :
    f ∈ productMarginalObservableSubmodule A B ↔
      productAnchoredInteractionPart A B f = 0 := by
  constructor
  · intro hf
    have hi := productAnchoredInteractionPart_mem A B f
    have hrc : productRowPart A B f + productColumnPart A B f ∈
        productMarginalObservableSubmodule A B :=
      Submodule.mem_sup.mpr
        ⟨productRowPart A B f, productRowPart_mem_fst A B f,
          productColumnPart A B f, productColumnPart_mem_snd A B f, rfl⟩
    have hdecomp := product_decompose_row_column_anchored A B f
    have him : productAnchoredInteractionPart A B f ∈
        productMarginalObservableSubmodule A B := by
      have heq : productAnchoredInteractionPart A B f =
          f - (productRowPart A B f + productColumnPart A B f) := by
        funext x
        have hx := congrFun hdecomp x
        simp only [Pi.add_apply] at hx
        change productAnchoredInteractionPart A B f x =
          f x - (productRowPart A B f x + productColumnPart A B f x)
        linear_combination hx
      rw [heq]
      exact Submodule.sub_mem _ hf hrc
    have hdis := (productAnchoredInteractionSubmodule_isCompl A B).1
    rw [Submodule.disjoint_def] at hdis
    exact hdis _ him hi
  · intro hi
    have hrc : productRowPart A B f + productColumnPart A B f ∈
        productMarginalObservableSubmodule A B :=
      Submodule.mem_sup.mpr
        ⟨productRowPart A B f, productRowPart_mem_fst A B f,
          productColumnPart A B f, productColumnPart_mem_snd A B f, rfl⟩
    rw [← product_decompose_row_column_anchored A B f, hi, add_zero]
    exact hrc

/-- Constant clock action lifts through marginal recovery without creating quotient information. -/
theorem constantObserverClock_informationNeutral
    (A B : Type*) [One A] [One B] (c : ℂ)
    (f : FullValueSubtype (A × B) → ℂ)
    (hf : f ∈ productMarginalObservableSubmodule A B) :
    observerClockInteractionAnomaly A B (fun _ => c) f = 0 := by
  apply (mem_productMarginalObservableSubmodule_iff_anchoredInteractionPart_eq_zero
    A B (observerClockMultiplier (fun _ : A => c) f)).mp
  exact constantObserverClock_preserves_marginals A B c f hf

/-- Exact fusion law: clock contrast times organ contrast is the whole interaction anomaly. -/
theorem productAnchoredInteractionPart_separatedClockOrganObservable
    (A B : Type*) [One A] [One B]
    (rate : A → ℂ) (organ : B → ℂ)
    (x : FullValueSubtype (A × B)) :
    productAnchoredInteractionPart A B
        (separatedClockOrganObservable rate organ) x =
      (rate x.1.1 - rate 1) * (organ x.1.2 - organ 1) := by
  simp [productAnchoredInteractionPart, productRowPart, productColumnPart,
    separatedClockOrganObservable]
  ring

/-- A separated clock/organ observable is marginal exactly when one factor is constant. -/
theorem separatedClockOrganObservable_mem_marginal_iff
    (A B : Type*) [One A] [One B]
    (rate : A → ℂ) (organ : B → ℂ) :
    separatedClockOrganObservable rate organ ∈
        productMarginalObservableSubmodule A B ↔
      (∀ a, rate a = rate 1) ∨ (∀ b, organ b = organ 1) := by
  rw [mem_productMarginalObservableSubmodule_iff_anchoredInteractionPart_eq_zero]
  constructor
  · intro hi
    by_contra h
    have hrateNot : ¬ ∀ a, rate a = rate 1 := fun hrate => h (Or.inl hrate)
    have horganNot : ¬ ∀ b, organ b = organ 1 := fun horgan => h (Or.inr horgan)
    obtain ⟨a, ha⟩ := not_forall.mp hrateNot
    obtain ⟨b, hb⟩ := not_forall.mp horganNot
    have hz := congrFun hi
      (⟨(a, b), Set.mem_univ _⟩ : FullValueSubtype (A × B))
    rw [productAnchoredInteractionPart_separatedClockOrganObservable] at hz
    have hrate : rate a - rate 1 ≠ 0 := sub_ne_zero.mpr ha
    have horgan : organ b - organ 1 ≠ 0 := sub_ne_zero.mpr hb
    exact mul_ne_zero hrate horgan (by simpa using hz)
  · rintro (hrate | horgan)
    · funext x
      rw [productAnchoredInteractionPart_separatedClockOrganObservable,
        hrate x.1.1]
      simp
    · funext x
      rw [productAnchoredInteractionPart_separatedClockOrganObservable,
        horgan x.1.2]
      simp

/-- Indicator of one non-anchor organ state. -/
def anchoredColumnProbe
    {B : Type*} [One B] [DecidableEq B] (b₁ : B) (b : B) : ℂ :=
  if b = b₁ then 1 else 0

/-- Lift of the two-state probe to a marginal joint observable. -/
def liftedAnchoredColumnProbe
    (A B : Type*) [One B] [DecidableEq B] (b₁ : B) :
    FullValueSubtype (A × B) → ℂ :=
  fun x => anchoredColumnProbe b₁ x.1.2

theorem liftedAnchoredColumnProbe_mem_marginal
    (A B : Type*) [One B] [DecidableEq B] (b₁ : B) :
    liftedAnchoredColumnProbe A B b₁ ∈
      productMarginalObservableSubmodule A B := by
  apply Submodule.mem_sup_right
  intro x y hxy
  change x.1.2 = y.1.2 at hxy
  simp only [liftedAnchoredColumnProbe]
  rw [hxy]

/-- Exact multiplier-algebra classification: only scalar clocks preserve all marginals. -/
theorem productMarginalClockStable_iff_anchoredConstant
    (A B : Type*) [One A] [One B] [DecidableEq B]
    (b₁ : B) (hb₁ : b₁ ≠ 1) (rate : A → ℂ) :
    ProductMarginalClockStable A B rate ↔ ∀ a, rate a = rate 1 := by
  constructor
  · intro hstable a
    let f := liftedAnchoredColumnProbe A B b₁
    have hfm : f ∈ productMarginalObservableSubmodule A B :=
      liftedAnchoredColumnProbe_mem_marginal A B b₁
    have hmult := hstable f hfm
    have hz :=
      (mem_productMarginalObservableSubmodule_iff_anchoredInteractionPart_eq_zero
        A B (observerClockMultiplier rate f)).mp hmult
    have hpoint := congrFun hz
      (⟨(a, b₁), Set.mem_univ _⟩ : FullValueSubtype (A × B))
    have hone : (1 : B) ≠ b₁ := Ne.symm hb₁
    simp [observerClockMultiplier, f, liftedAnchoredColumnProbe, anchoredColumnProbe,
      productAnchoredInteractionPart, productRowPart, productColumnPart, hone] at hpoint
    exact sub_eq_zero.mp hpoint
  · intro hrate f hf
    have heq : observerClockMultiplier rate f = rate 1 • f := by
      funext x
      simp [observerClockMultiplier, hrate x.1.1]
    rw [heq]
    exact (productMarginalObservableSubmodule A B).smul_mem _ hf

theorem productAnchoredInteractionPart_add
    (A B : Type*) [One A] [One B]
    (f g : FullValueSubtype (A × B) → ℂ) :
    productAnchoredInteractionPart A B (f + g) =
      productAnchoredInteractionPart A B f +
        productAnchoredInteractionPart A B g := by
  funext x
  simp [productAnchoredInteractionPart, productRowPart, productColumnPart]
  ring

theorem productAnchoredInteractionPart_smul
    (A B : Type*) [One A] [One B]
    (c : ℂ) (f : FullValueSubtype (A × B) → ℂ) :
    productAnchoredInteractionPart A B (c • f) =
      c • productAnchoredInteractionPart A B f := by
  funext x
  simp [productAnchoredInteractionPart, productRowPart, productColumnPart]
  ring

theorem observerClockMultiplier_add_rate
    {A B : Type*} (rate₁ rate₂ : A → ℂ)
    (f : FullValueSubtype (A × B) → ℂ) :
    observerClockMultiplier (rate₁ + rate₂) f =
      observerClockMultiplier rate₁ f + observerClockMultiplier rate₂ f := by
  funext x
  simp [observerClockMultiplier]
  ring

/-- Anomaly signatures jointly reconstruct the clock modulo constant scalar gauge. -/
theorem observerClockInteractionAnomaly_eq_iff_rate_difference_anchoredConstant
    (A B : Type*) [One A] [One B] [DecidableEq B]
    (b₁ : B) (hb₁ : b₁ ≠ 1) (rate₁ rate₂ : A → ℂ) :
    (∀ f : FullValueSubtype (A × B) → ℂ,
        f ∈ productMarginalObservableSubmodule A B →
          observerClockInteractionAnomaly A B rate₁ f =
            observerClockInteractionAnomaly A B rate₂ f) ↔
      ∀ a, rate₁ a - rate₂ a = rate₁ 1 - rate₂ 1 := by
  constructor
  · intro hsignature a
    let f := liftedAnchoredColumnProbe A B b₁
    have hf := liftedAnchoredColumnProbe_mem_marginal A B b₁
    have hpoint := congrFun (hsignature f hf)
      (⟨(a, b₁), Set.mem_univ _⟩ : FullValueSubtype (A × B))
    have hone : (1 : B) ≠ b₁ := Ne.symm hb₁
    simp [observerClockInteractionAnomaly, observerClockMultiplier, f,
      liftedAnchoredColumnProbe, anchoredColumnProbe, productAnchoredInteractionPart,
      productRowPart, productColumnPart, hone] at hpoint
    linear_combination hpoint
  · intro hrate f hf
    have hzero :=
      (mem_productMarginalObservableSubmodule_iff_anchoredInteractionPart_eq_zero
        A B f).mp hf
    let c : ℂ := rate₁ 1 - rate₂ 1
    have hmult : observerClockMultiplier rate₁ f =
        observerClockMultiplier rate₂ f + c • f := by
      funext x
      simp only [observerClockMultiplier, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      have hr : rate₁ x.1.1 = rate₂ x.1.1 + c := by
        dsimp only [c]
        linear_combination hrate x.1.1
      rw [hr]
      ring
    rw [observerClockInteractionAnomaly, observerClockInteractionAnomaly, hmult,
      productAnchoredInteractionPart_add, productAnchoredInteractionPart_smul,
      hzero, smul_zero, add_zero]

/-- Fixed sign reporter on the smallest nontrivial organ. -/
def finTwoOrganSign (b : Fin 2) : ℂ :=
  if b = 1 then 1 else -1

@[simp] theorem finTwoOrganSign_one : finTwoOrganSign 1 = 1 := by
  simp [finTwoOrganSign]

@[simp] theorem finTwoOrganSign_zero : finTwoOrganSign 0 = -1 := by
  simp [finTwoOrganSign]

/-- The literal two-state interaction is twice the anchored clock contrast. -/
theorem finTwo_clock_interaction_anomaly_zero
    (A : Type*) [One A] (rate : A → ℂ) (a : A) :
    productAnchoredInteractionPart A (Fin 2)
        (separatedClockOrganObservable rate finTwoOrganSign)
        ⟨(a, 0), Set.mem_univ _⟩ =
      -2 * (rate a - rate 1) := by
  rw [productAnchoredInteractionPart_separatedClockOrganObservable]
  simp
  ring

end

end GaloisForLFunctions.HTGeometry
