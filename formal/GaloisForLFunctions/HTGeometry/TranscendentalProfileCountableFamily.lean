import GaloisForLFunctions.HTGeometry.TranscendentalProfileRealization

/-!
# Countable dilate families

A joint algebraic differential relation involves only finitely many members of a family, so joint
hypertranscendence of every nonempty finite restriction is joint hypertranscendence of the whole
family.  The base of a power profile can be chosen transcendental over the field generated by the
algebraic numbers and a whole countable set of dilations at once, so one entire source serves a
countable dilate family.
-/

open PowerSeries MvPolynomial

namespace GaloisForLFunctions

noncomputable section

/-- The members of a family that a joint relation actually uses. -/
def relationIndices {ι : Type*} [DecidableEq ι] {n : ℕ}
    (Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ) : Finset ι :=
  Q.vars.biUnion fun s => s.elim ∅ fun p => {p.1}

theorem mem_relationIndices {ι : Type*} [DecidableEq ι] {n : ℕ}
    {Q : MvPolynomial (Option (ι × Fin (n + 1))) ℂ} {i : ι} {j : Fin (n + 1)}
    (h : some (i, j) ∈ Q.vars) : i ∈ relationIndices Q :=
  Finset.mem_biUnion.mpr ⟨some (i, j), h, Finset.mem_singleton_self i⟩

/-- **Joint hypertranscendence is a finite-restriction property.** -/
theorem jointlyHypertranscendental_of_finite_restrictions {ι : Type*} [DecidableEq ι] [Nonempty ι]
    (f : ι → ℂ → ℂ)
    (h : ∀ S : Finset ι, S.Nonempty → JointlyHypertranscendental (fun i : S => f i)) :
    JointlyHypertranscendental f := by
  classical
  rintro ⟨n, Q, hQ, hrel⟩
  obtain ⟨i₀⟩ := ‹Nonempty ι›
  set S : Finset ι := insert i₀ (relationIndices Q) with hS
  have hSne : S.Nonempty := ⟨i₀, Finset.mem_insert_self _ _⟩
  set σ : Option (↥S × Fin (n + 1)) → Option (ι × Fin (n + 1)) :=
    fun s => s.map fun p => ((p.1 : ι), p.2) with hσ
  have hinj : Function.Injective σ := by
    rintro (_ | ⟨⟨i, hi⟩, j⟩) (_ | ⟨⟨i', hi'⟩, j'⟩) hEq <;> simp only [hσ, Option.map] at hEq
    · rfl
    · exact absurd hEq (by simp)
    · exact absurd hEq (by simp)
    · obtain ⟨rfl, rfl⟩ := Prod.mk.injEq .. ▸ Option.some_injective _ hEq
      rfl
  have hvars : (↑Q.vars : Set (Option (ι × Fin (n + 1)))) ⊆ Set.range σ := by
    rintro (_ | ⟨i, j⟩) hs
    · exact ⟨none, rfl⟩
    · exact ⟨some (⟨i, Finset.mem_insert_of_mem (mem_relationIndices hs)⟩, j), rfl⟩
  obtain ⟨Q₀, hQ₀⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range Q σ hinj hvars
  refine h S hSne ⟨n, Q₀, ?_, ?_⟩
  · intro hzero
    exact hQ (by rw [← hQ₀, hzero, map_zero])
  · intro z
    have hcomp : famJetPoint f n z ∘ σ = famJetPoint (fun i : S => f i) n z := by
      funext s
      cases s with
      | none => rfl
      | some p => rfl
    have := hrel z
    rw [← hQ₀, MvPolynomial.eval_rename, hcomp] at this
    exact this

variable {ι : Type*} [Countable ι] [DecidableEq ι] [Nonempty ι]

/-- **One entire source for a countable dilate family.**  For every countable family of distinct
nonzero complex dilations — with no arithmetic hypothesis whatsoever — there is an entire function
with full Taylor support whose whole dilate family is jointly hypertranscendental. -/
theorem exists_entire_dilates_jointlyHypertranscendental_countable (q : ι → ℂ)
    (hq0 : ∀ i, q i ≠ 0) (hqinj : Function.Injective q) :
    ∃ F : ℂ → ℂ, ContDiff ℂ (⊤ : ℕ∞) F ∧
      (∀ n, PowerSeries.coeff n (taylorPS F) ≠ 0) ∧
      JointlyHypertranscendental (fun (i : ι) (z : ℂ) => F (q i * z)) := by
  classical
  obtain ⟨K, x, hx0, hx1, hKalg, hqK, htr⟩ :=
    exists_transcendental_base q (ε := 1) one_pos
  refine ⟨transcendentalProfileFunction x confinedProfile,
    contDiff_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile,
    taylorPS_transcendentalProfileFunction_ne_zero hx0 hx1 sq_le_confinedProfile, ?_⟩
  refine jointlyHypertranscendental_of_finite_restrictions _ fun S hS => ?_
  haveI : Nonempty ↥S := hS.to_subtype
  exact jointlyHypertranscendental_dilates_of_transcendentalProfile
    (contDiff_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile)
    (fun i : S => q (i : ι))
    (taylorPS_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile)
    htr hKalg boundedRelationConfinement_confinedProfile
    (fun i => hq0 _) (fun i j hij => Subtype.ext (hqinj hij)) (fun i => hqK _)

end

end GaloisForLFunctions
