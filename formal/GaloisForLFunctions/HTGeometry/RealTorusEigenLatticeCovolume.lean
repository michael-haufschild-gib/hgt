import GaloisForLFunctions.HTGeometry.InvolutionTateDualLattice
import GaloisForLFunctions.HTGeometry.RealTorusComponentGroup
import Mathlib.Algebra.Module.ZLattice.Covolume

/-!
# Covolume of the eigenlattice sum

Let `L ⊆ ℝⁿ` be a full `ℤ`-lattice stable under an `ℝ`-linear involution `σ`, and let
`L⁺ ⊕ L⁻ ⊆ L` be the sum of its two eigenlattices.  Then

```
covol(L⁺ ⊕ L⁻) = #(L / (L⁺ ⊕ L⁻)) · covol(L) .
```

This is the determinant identity

```
det Q = (2^g / #π₀(A(ℝ))) · det M
```

used in the proof of Proposition 5.1 of Suzuki, *Duality invariance of Faltings heights, Hodge line
bundles and global periods* (arXiv:2504.04993): `det M` is the covolume of the period lattice `Λ`,
`det Q` (up to the factor `2^g` coming from the `w`-coordinates) is the covolume of `Λ⁺ ⊕ Λ⁻`, and
`#(Λ/(Λ⁺ ⊕ Λ⁻)) = 2^g / #π₀(A(ℝ))` is the index formula
`InvolutionTate.card_defect_mul_card_H1`.

Combining the two gives Suzuki's `(0030)` in covolume form.
-/

namespace GaloisForLFunctions.HTGeometry.RealTorusCovolume

open Submodule LinearMap Module InvolutionTate RealTorus

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {L : Submodule ℤ (ι → ℝ)} {σ : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)}

/-- The sublattice of `L` generated by its two eigenlattices. -/
def eigenSum (σ : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (L : Submodule ℤ (ι → ℝ))
    (hL : ∀ x ∈ L, σ x ∈ L) : Submodule ℤ (ι → ℝ) :=
  Submodule.map L.subtype (plusPart (sigmaLat σ L hL) ⊔ minusPart (sigmaLat σ L hL))

theorem eigenSum_le (hL : ∀ x ∈ L, σ x ∈ L) : eigenSum σ L hL ≤ L := by
  rw [eigenSum, Submodule.map_le_iff_le_comap]
  intro y _
  simp

theorem two_zsmul_mem_eigenSum [DiscreteTopology L] (hσ : ∀ x, σ (σ x) = x)
    (hL : ∀ x ∈ L, σ x ∈ L) {x : ι → ℝ} (hx : x ∈ L) : (2 : ℤ) • x ∈ eigenSum σ L hL := by
  refine ⟨(2 : ℤ) • (⟨x, hx⟩ : L), ?_, ?_⟩
  · exact two_smul_mem_sup (sigmaLat_involutive hσ hL) ⟨x, hx⟩
  · simp

theorem discreteTopology_eigenSum (hL : ∀ x ∈ L, σ x ∈ L) [DiscreteTopology L] :
    DiscreteTopology (eigenSum σ L hL) :=
  (Topology.IsEmbedding.inclusion
    (show ((eigenSum σ L hL : Submodule ℤ (ι → ℝ)) : Set (ι → ℝ)) ⊆ (L : Set (ι → ℝ)) from
      eigenSum_le hL)).discreteTopology

theorem isZLattice_eigenSum (hσ : ∀ x, σ (σ x) = x) (hL : ∀ x ∈ L, σ x ∈ L)
    [DiscreteTopology L] [IsZLattice ℝ L] [DiscreteTopology (eigenSum σ L hL)] :
    IsZLattice ℝ (eigenSum σ L hL) := by
  refine ⟨?_⟩
  refine top_le_iff.mp ?_
  rw [← IsZLattice.span_top (K := ℝ) (L := L)]
  rw [Submodule.span_le]
  intro x hx
  have hmem : (2 : ℤ) • x ∈ eigenSum σ L hL := two_zsmul_mem_eigenSum hσ hL hx
  have hx' : x = (2⁻¹ : ℝ) • ((2 : ℤ) • x) := by
    rw [← Int.cast_smul_eq_zsmul ℝ (2 : ℤ) x, smul_smul]
    norm_num
  rw [hx']
  exact Submodule.smul_mem _ _ (Submodule.subset_span hmem)

theorem addSubgroupOf_map_subtype {E : Type*} [AddCommGroup E] (M : Submodule ℤ E)
    (P : Submodule ℤ M) :
    (Submodule.map M.subtype P).toAddSubgroup.addSubgroupOf M.toAddSubgroup = P.toAddSubgroup := by
  ext x
  simp [AddSubgroup.mem_addSubgroupOf, Submodule.mem_map]

theorem relIndex_eigenSum (hL : ∀ x ∈ L, σ x ∈ L) :
    AddSubgroup.relIndex (eigenSum σ L hL).toAddSubgroup L.toAddSubgroup
      = Nat.card (defect (sigmaLat σ L hL)) := by
  rw [AddSubgroup.relIndex, eigenSum, addSubgroupOf_map_subtype]
  rfl

/-- **The covolume of the eigenlattice sum.** -/
theorem covolume_eigenSum (hσ : ∀ x, σ (σ x) = x) (hL : ∀ x ∈ L, σ x ∈ L)
    [DiscreteTopology L] [IsZLattice ℝ L] :
    ZLattice.covolume (eigenSum σ L hL)
      = Nat.card (defect (sigmaLat σ L hL)) * ZLattice.covolume L := by
  haveI := discreteTopology_eigenSum (σ := σ) hL
  haveI := isZLattice_eigenSum hσ hL
  have h := ZLattice.covolume_div_covolume_eq_relIndex (eigenSum σ L hL) L (eigenSum_le hL)
  rw [relIndex_eigenSum hL] at h
  have hne : ZLattice.covolume L ≠ 0 := ZLattice.covolume_ne_zero L MeasureTheory.volume
  field_simp at h
  linarith [h]


/-- **Suzuki's `det Q = (2^g / #π₀(A(ℝ))) · det M`, in covolume form.**  Multiplying the covolume
of the eigenlattice sum by the number of connected components of the real points returns
`2 ^ (rank of the anti-invariant lattice)` times the covolume of the full lattice. -/
theorem covolume_eigenSum_mul_card_H1 (hσ : ∀ x, σ (σ x) = x) (hL : ∀ x ∈ L, σ x ∈ L)
    [DiscreteTopology L] [IsZLattice ℝ L] :
    ZLattice.covolume (eigenSum σ L hL) * Nat.card (H1 (sigmaLat σ L hL))
      = 2 ^ finrank ℤ (minusPart (sigmaLat σ L hL)) * ZLattice.covolume L := by
  have hidx := card_defect_mul_card_H1 (sigmaLat_involutive hσ hL)
  rw [covolume_eigenSum hσ hL]
  have : (Nat.card (defect (sigmaLat σ L hL)) : ℝ) * (Nat.card (H1 (sigmaLat σ L hL)) : ℝ)
      = ((2 : ℕ) ^ finrank ℤ (minusPart (sigmaLat σ L hL)) : ℕ) := by
    exact_mod_cast congrArg (fun n : ℕ => (n : ℝ)) hidx
  push_cast at this ⊢
  nlinarith [this, ZLattice.covolume_pos L MeasureTheory.volume]

end GaloisForLFunctions.HTGeometry.RealTorusCovolume
