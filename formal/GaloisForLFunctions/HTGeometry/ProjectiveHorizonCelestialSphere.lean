import GaloisForLFunctions.HTGeometry.ProjectiveHorizonActualSchwarzianDiamond
import GaloisForLFunctions.HTGeometry.MobiusObservationHypertranscendence
import GaloisForLFunctions.HTGeometry.MutualGeneratorMobius
import GaloisForLFunctions.HTGeometry.SchwarzianProjectiveInvariant
import Mathlib.LinearAlgebra.Projectivization.Basic

/-!
# The projective derivative horizons of one hypertranscendental scalar

Fix a hypertranscendental scalar `x` over a field of differential constants `C`.  Every
nondegenerate fractional-linear coordinate `(a x + b) / (c x + d)` has a first derivative horizon,
the differential field generated by the derivative of that coordinate.  This file proves that the
horizon depends only on the projective class of the denominator covector `(c, d)`, that distinct
covector classes give distinct horizons, and that any two distinct horizons join to the whole
differential field generated by `x` and meet exactly in the differential field generated by the
Schwarzian of `x`.

The covector `(c, d)` is the linear form cutting out the pole of the coordinate, so its projective
class is a point of the projective line over `C`.  The three theorems together say that the
horizon family is a faithful realization of that projective line by differential subfields, and
that each *ordered pair of distinct points* recovers the source: exactly the boundary-pair
description of the oriented geodesics of the associated rank-one hyperbolic geometry.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential
open scoped LinearAlgebra.Projectivization

noncomputable section

variable {C E : Type*} [Field C] [CharZero C] [Field E] [CharZero E]
  [Algebra C E] [Differential C] [Differential E] [DifferentialAlgebra C E]

/-! ## The horizon attached to a denominator covector -/

/-- The projective derivative horizon of `x` cut out by the covector `(c, d)`: the differential
field generated by the derivative of any nondegenerate fractional-linear coordinate whose
denominator is `c * x + d`.  The covector `(0, d)` describes the point at infinity, whose
coordinate is `x` itself. -/
def rowHorizon (C : Type*) {E : Type*} [Field C] [Field E] [Algebra C E] [Differential E]
    (x : E) (c d : C) : IntermediateField C E :=
  letI := Classical.propDecidable (c = 0)
  if c = 0 then jetTailField C x 1
  else jetTailField C ((algebraMap C E c * x + algebraMap C E d)⁻¹) 1

omit [CharZero C] [CharZero E] [Differential C] [DifferentialAlgebra C E] in
theorem rowHorizon_zero_left (x : E) (d : C) :
    rowHorizon C x 0 d = jetTailField C x 1 := by
  rw [rowHorizon]
  exact if_pos rfl

omit [CharZero C] [CharZero E] [Differential C] [DifferentialAlgebra C E] in
theorem rowHorizon_of_ne_zero (x : E) {c : C} (hc : c ≠ 0) (d : C) :
    rowHorizon C x c d =
      jetTailField C ((algebraMap C E c * x + algebraMap C E d)⁻¹) 1 := by
  rw [rowHorizon]
  exact if_neg hc

omit [CharZero C] [CharZero E] in
theorem deriv_algebraMap_eq_zero (hconst : ∀ t : C, t′ = 0) (t : C) :
    (algebraMap C E t)′ = 0 := by
  rw [deriv_algebraMap, hconst t, map_zero]

omit [CharZero C] [CharZero E] in
/-- The horizon depends only on the projective class of the denominator covector. -/
theorem rowHorizon_smul (hconst : ∀ t : C, t′ = 0) (x : E) {t : C} (ht : t ≠ 0) (c d : C) :
    rowHorizon C x (t * c) (t * d) = rowHorizon C x c d := by
  by_cases hc : c = 0
  · subst hc
    rw [mul_zero, rowHorizon_zero_left, rowHorizon_zero_left]
  · have htc : t * c ≠ 0 := mul_ne_zero ht hc
    have htE : algebraMap C E t ≠ 0 := by
      simpa using (algebraMap C E).injective.ne ht
    rw [rowHorizon_of_ne_zero _ htc, rowHorizon_of_ne_zero _ hc]
    have hform : (algebraMap C E (t * c) * x + algebraMap C E (t * d))⁻¹ =
        algebraMap C E t⁻¹ * (algebraMap C E c * x + algebraMap C E d)⁻¹ +
          algebraMap C E 0 := by
      rw [map_mul, map_mul, map_inv₀, map_zero, add_zero, mul_assoc, ← mul_add, mul_inv]
    rw [hform]
    exact jetTailField_constSlopeAffine_eq _ t⁻¹ 0 (hconst _) (inv_ne_zero ht) 1

/-! ## Identification of the Möbius horizon -/

/-- **Choice independence.**  Every nondegenerate fractional-linear coordinate with denominator
covector `(c, d)` has the same first derivative horizon, namely `rowHorizon C x c d`. -/
theorem jetTailField_mobiusObservable_one_eq_rowHorizon
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (a b c d : C) (hdet : a * d - b * c ≠ 0) :
    jetTailField C (mobiusObservable a b c d x) 1 = rowHorizon C x c d := by
  by_cases hc : c = 0
  · subst hc
    rw [rowHorizon_zero_left]
    exact mobiusJetTailField_eq_of_stabilizer x a b 0 d hdet rfl (hconst _) 1
  · rw [rowHorizon_of_ne_zero _ hc]
    have hden : algebraMap C E c * x + algebraMap C E d ≠ 0 :=
      mobiusDenominator_ne_zero_of_hypertranscendentalOver x hx a b c d hdet
    have hden' : x * algebraMap C E c + algebraMap C E d ≠ 0 := by
      simpa [mul_comm] using hden
    have hcE : algebraMap C E c ≠ 0 := by
      simpa using (algebraMap C E).injective.ne hc
    have hB : (b * c - a * d) / c ≠ 0 := by
      refine div_ne_zero ?_ hc
      intro hzero
      exact hdet (by linear_combination -hzero)
    have hform : mobiusObservable a b c d x =
        algebraMap C E ((b * c - a * d) / c) *
            (algebraMap C E c * x + algebraMap C E d)⁻¹ +
          algebraMap C E (a / c) := by
      unfold mobiusObservable
      rw [map_div₀, map_div₀, map_sub, map_mul, map_mul]
      field_simp [hden, hden']
      ring
    rw [hform]
    exact jetTailField_constSlopeAffine_eq _ ((b * c - a * d) / c) (a / c)
      (hconst _) hB 1

/-! ## Möbius invariance of the generated field and of the projective curvature -/

omit [CharZero C] [CharZero E] [Differential C] in
theorem mem_jetTailField_zero_self (u : E) : u ∈ jetTailField C u 0 := by
  simpa using differentialJet_mem_jetTailField C u (n := 0) (m := 0) le_rfl

omit [CharZero C] [CharZero E] [Differential C] in
theorem mobiusObservable_mem_jetTailField_zero (u : E) (p q r s : C) :
    mobiusObservable p q r s u ∈ jetTailField C u 0 := by
  have hu : u ∈ jetTailField C u 0 := mem_jetTailField_zero_self u
  exact div_mem
    (add_mem (mul_mem (IntermediateField.algebraMap_mem _ p) hu)
      (IntermediateField.algebraMap_mem _ q))
    (add_mem (mul_mem (IntermediateField.algebraMap_mem _ r) hu)
      (IntermediateField.algebraMap_mem _ s))

omit [CharZero C] [CharZero E] in
theorem jetTailField_zero_le_of_mem (x : E) {z : E} (hz : z ∈ jetTailField C x 0) :
    jetTailField C z 0 ≤ jetTailField C x 0 := by
  rw [jetTailField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨m, -, rfl⟩
  exact _root_.GaloisForLFunctions.differentialJet_mem_jetTailField_of_mem x 0 hz m

omit [CharZero C] [CharZero E] in
/-- A nondegenerate fractional-linear change of coordinate generates the same differential
field. -/
theorem jetTailField_mobiusObservable_zero
    (x : E) (hx : HypertranscendentalOver C x) (a b c d : C) (hdet : a * d - b * c ≠ 0) :
    jetTailField C (mobiusObservable a b c d x) 0 = jetTailField C x 0 := by
  refine le_antisymm
    (jetTailField_zero_le_of_mem x (mobiusObservable_mem_jetTailField_zero x a b c d)) ?_
  have hrec := mobiusObservable_recover_of_hypertranscendental x hx a b c d hdet
  have hxmem : x ∈ jetTailField C (mobiusObservable a b c d x) 0 := by
    have hmem :=
      mobiusObservable_mem_jetTailField_zero (mobiusObservable a b c d x) d (-b) (-c) a
    rwa [← hrec] at hmem
  exact jetTailField_zero_le_of_mem _ hxmem

/-- The Schwarzian is a projective invariant of a hypertranscendental scalar. -/
theorem schwarzian_mobiusObservable (hconst : ∀ t : C, t′ = 0) (x : E)
    (hx : HypertranscendentalOver C x) (a b c d : C) (hdet : a * d - b * c ≠ 0) :
    schwarzian (mobiusObservable a b c d x) = schwarzian x := by
  have hden : algebraMap C E c * x + algebraMap C E d ≠ 0 :=
    mobiusDenominator_ne_zero_of_hypertranscendentalOver x hx a b c d hdet
  have hdx : x′ ≠ 0 := deriv_ne_zero_of_hypertranscendentalOver hx
  have hdetE :
      algebraMap C E a * algebraMap C E d - algebraMap C E b * algebraMap C E c ≠ 0 := by
    rw [← map_mul, ← map_mul, ← map_sub]
    simpa using (algebraMap C E).injective.ne hdet
  exact schwarzian_mobius x _ _ _ _ (deriv_algebraMap_eq_zero hconst a)
    (deriv_algebraMap_eq_zero hconst b) (deriv_algebraMap_eq_zero hconst c)
    (deriv_algebraMap_eq_zero hconst d) hdetE hden hdx

theorem actualSchwarzianDifferentialField_mobiusObservable
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (a b c d : C) (hdet : a * d - b * c ≠ 0) :
    actualSchwarzianDifferentialField C (mobiusObservable a b c d x) =
      actualSchwarzianDifferentialField C x := by
  unfold actualSchwarzianDifferentialField
  rw [schwarzian_mobiusObservable hconst x hx a b c d hdet]

/-! ## Two distinct boundary points, one common coordinate -/

/-- Two distinct denominator covectors exhibit their horizons as the two opposite first horizons
of one common hypertranscendental coordinate. -/
theorem exists_common_source
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {c d c' d' : C} (hdet : c * d' - c' * d ≠ 0) :
    ∃ y : E, HypertranscendentalOver C y ∧
      rowHorizon C x c d = jetTailField C y 1 ∧
      rowHorizon C x c' d' = jetTailField C y⁻¹ 1 ∧
      jetTailField C y 0 = jetTailField C x 0 ∧
      actualSchwarzianDifferentialField C y = actualSchwarzianDifferentialField C x := by
  have hdet1 : c' * d - d' * c ≠ 0 := fun h => hdet (by linear_combination -h)
  have hdet2 : c * d' - d * c' ≠ 0 := fun h => hdet (by linear_combination h)
  refine ⟨mobiusObservable c' d' c d x,
    hypertranscendentalOver_mobiusObservable x hx c' d' c d hdet1, ?_, ?_, ?_, ?_⟩
  · exact (jetTailField_mobiusObservable_one_eq_rowHorizon hconst x hx c' d' c d hdet1).symm
  · have hinv : (mobiusObservable c' d' c d x)⁻¹ = mobiusObservable c d c' d' x := by
      unfold mobiusObservable
      rw [inv_div]
    rw [hinv]
    exact (jetTailField_mobiusObservable_one_eq_rowHorizon hconst x hx c d c' d' hdet2).symm
  · exact jetTailField_mobiusObservable_zero x hx c' d' c d hdet1
  · exact actualSchwarzianDifferentialField_mobiusObservable hconst x hx c' d' c d hdet1

/-- **Injective realization of the projective line.**  Denominator covectors in distinct
projective classes have distinct horizons. -/
theorem rowHorizon_ne (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {c d c' d' : C} (hdet : c * d' - c' * d ≠ 0) :
    rowHorizon C x c d ≠ rowHorizon C x c' d' := by
  obtain ⟨y, hy, h1, h2, -, -⟩ := exists_common_source hconst x hx hdet
  rw [h1, h2]
  exact fun h => jetTailField_inv_ne_of_hypertranscendentalOver y hy h.symm

/-- **The boundary-pair reconstruction law.**  Two horizons at distinct points of the projective
line join to the whole differential field generated by the source and meet exactly in the
differential field generated by its Schwarzian. -/
theorem rowHorizon_sup_inf
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {c d c' d' : C} (hdet : c * d' - c' * d ≠ 0) :
    rowHorizon C x c d ⊔ rowHorizon C x c' d' = jetTailField C x 0 ∧
      rowHorizon C x c d ⊓ rowHorizon C x c' d' = actualSchwarzianDifferentialField C x := by
  obtain ⟨y, hy, h1, h2, h0, hs⟩ := exists_common_source hconst x hx hdet
  obtain ⟨hsup, hinf, -⟩ := hypertranscendentalOver_projectiveHorizon_schwarzianDiamond y hy
  rw [h1, h2]
  exact ⟨by rw [hsup, h0], by rw [hinf, hs]⟩

/-! ## Exact classification of horizon equality -/

omit [CharZero C] [CharZero E] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] in
theorem exists_smul_of_det_eq_zero {c d c' d' : C} (h : c * d' - c' * d = 0)
    (hcd : ¬(c = 0 ∧ d = 0)) (hcd' : ¬(c' = 0 ∧ d' = 0)) :
    ∃ t : C, t ≠ 0 ∧ c' = t * c ∧ d' = t * d := by
  by_cases hc : c = 0
  · have hd : d ≠ 0 := fun hd0 => hcd ⟨hc, hd0⟩
    have hc' : c' = 0 := by
      have hzero : c' * d = 0 := by rw [hc] at h; linear_combination -h
      rcases mul_eq_zero.mp hzero with h1 | h1
      · exact h1
      · exact absurd h1 hd
    have hd' : d' ≠ 0 := fun hd0 => hcd' ⟨hc', hd0⟩
    exact ⟨d' / d, div_ne_zero hd' hd, by rw [hc, hc', mul_zero], by field_simp⟩
  · have hc'0 : c' ≠ 0 := by
      intro hc'0
      have hzero : c * d' = 0 := by rw [hc'0] at h; linear_combination h
      rcases mul_eq_zero.mp hzero with h1 | h1
      · exact hc h1
      · exact hcd' ⟨hc'0, h1⟩
    refine ⟨c' / c, div_ne_zero hc'0 hc, by field_simp, ?_⟩
    field_simp
    linear_combination h

/-- **Exact horizon classification.**  Two nonzero denominator covectors have the same horizon
exactly when they lie in the same projective class. -/
theorem rowHorizon_eq_iff (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {c d c' d' : C} (hcd : ¬(c = 0 ∧ d = 0)) (hcd' : ¬(c' = 0 ∧ d' = 0)) :
    rowHorizon C x c d = rowHorizon C x c' d' ↔ c * d' - c' * d = 0 := by
  constructor
  · intro heq
    by_contra hdet
    exact rowHorizon_ne hconst x hx hdet heq
  · intro hdet
    obtain ⟨t, ht, hc', hd'⟩ := exists_smul_of_det_eq_zero hdet hcd hcd'
    rw [hc', hd', rowHorizon_smul hconst x ht]

/-! ## Equivariance -/

/-- Composition of two nondegenerate fractional-linear observations is the observation by the
matrix product. -/
theorem mobiusObservable_comp (x : E) (hx : HypertranscendentalOver C x)
    (a b c d α β γ δ : C) (hdetM : a * d - b * c ≠ 0) (hdetG : α * δ - β * γ ≠ 0) :
    mobiusObservable a b c d (mobiusObservable α β γ δ x) =
      mobiusObservable (a * α + b * γ) (a * β + b * δ) (c * α + d * γ) (c * β + d * δ) x := by
  have hy : HypertranscendentalOver C (mobiusObservable α β γ δ x) :=
    hypertranscendentalOver_mobiusObservable x hx α β γ δ hdetG
  have hu : algebraMap C E γ * x + algebraMap C E δ ≠ 0 :=
    mobiusDenominator_ne_zero_of_hypertranscendentalOver x hx α β γ δ hdetG
  have hu' : x * algebraMap C E γ + algebraMap C E δ ≠ 0 := by
    simpa [mul_comm] using hu
  have hv : algebraMap C E c * mobiusObservable α β γ δ x + algebraMap C E d ≠ 0 :=
    mobiusDenominator_ne_zero_of_hypertranscendentalOver _ hy a b c d hdetM
  have hMG : (a * α + b * γ) * (c * β + d * δ) - (a * β + b * δ) * (c * α + d * γ) ≠ 0 := by
    have hEq : (a * α + b * γ) * (c * β + d * δ) - (a * β + b * δ) * (c * α + d * γ)
        = (a * d - b * c) * (α * δ - β * γ) := by ring
    rw [hEq]
    exact mul_ne_zero hdetM hdetG
  have hw : algebraMap C E (c * α + d * γ) * x + algebraMap C E (c * β + d * δ) ≠ 0 :=
    mobiusDenominator_ne_zero_of_hypertranscendentalOver x hx _ _ _ _ hMG
  unfold mobiusObservable at hv ⊢
  rw [div_eq_div_iff hv hw]
  field_simp [hu, hu']
  simp only [map_add, map_mul]
  ring

/-- **Equivariance.**  A nondegenerate fractional-linear change of source moves each horizon to
the horizon of the covector transported by the same matrix. -/
theorem rowHorizon_mobiusObservable
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {c d : C} (hcd : ¬(c = 0 ∧ d = 0)) (α β γ δ : C) (hdetG : α * δ - β * γ ≠ 0) :
    rowHorizon C (mobiusObservable α β γ δ x) c d
      = rowHorizon C x (c * α + d * γ) (c * β + d * δ) := by
  obtain ⟨a, b, hdetM⟩ : ∃ a b : C, a * d - b * c ≠ 0 := by
    by_cases hc : c = 0
    · exact ⟨1, 0, by simpa [hc] using fun h => hcd ⟨hc, h⟩⟩
    · exact ⟨0, 1, by simpa using hc⟩
  have hy : HypertranscendentalOver C (mobiusObservable α β γ δ x) :=
    hypertranscendentalOver_mobiusObservable x hx α β γ δ hdetG
  have hMG : (a * α + b * γ) * (c * β + d * δ) - (a * β + b * δ) * (c * α + d * γ) ≠ 0 := by
    have hEq : (a * α + b * γ) * (c * β + d * δ) - (a * β + b * δ) * (c * α + d * γ)
        = (a * d - b * c) * (α * δ - β * γ) := by ring
    rw [hEq]
    exact mul_ne_zero hdetM hdetG
  calc rowHorizon C (mobiusObservable α β γ δ x) c d
      = jetTailField C (mobiusObservable a b c d (mobiusObservable α β γ δ x)) 1 :=
        (jetTailField_mobiusObservable_one_eq_rowHorizon hconst _ hy a b c d hdetM).symm
    _ = jetTailField C
          (mobiusObservable (a * α + b * γ) (a * β + b * δ) (c * α + d * γ)
            (c * β + d * δ) x) 1 := by
        rw [mobiusObservable_comp x hx a b c d α β γ δ hdetM hdetG]
    _ = rowHorizon C x (c * α + d * γ) (c * β + d * δ) :=
        jetTailField_mobiusObservable_one_eq_rowHorizon hconst x hx _ _ _ _ hMG

/-! ## The celestial sphere -/

theorem fin_two_ne_zero_iff {K : Type*} [Field K] {v : Fin 2 → K} :
    v ≠ 0 ↔ ¬(v 0 = 0 ∧ v 1 = 0) := by
  constructor
  · rintro hv ⟨h0, h1⟩
    exact hv (funext fun i => by fin_cases i <;> simpa)
  · intro h hv
    exact h ⟨by simp [hv], by simp [hv]⟩

theorem projectivization_mk_eq_mk_of_det_eq_zero {K : Type*} [Field K] {v w : Fin 2 → K}
    (hv : v ≠ 0) (hw : w ≠ 0) (h : v 0 * w 1 - w 0 * v 1 = 0) :
    Projectivization.mk K v hv = Projectivization.mk K w hw := by
  obtain ⟨t, ht, h0, h1⟩ :=
    exists_smul_of_det_eq_zero (c := v 0) (d := v 1) (c' := w 0) (d' := w 1)
      (by linear_combination h) (fin_two_ne_zero_iff.mp hv) (fin_two_ne_zero_iff.mp hw)
  have hwv : w = t • v := by
    funext i
    fin_cases i
    · simpa using h0
    · simpa using h1
  rw [Projectivization.mk_eq_mk_iff']
  exact ⟨t⁻¹, by rw [hwv, smul_smul, inv_mul_cancel₀ ht, one_smul]⟩

/-- The horizon of `x` at a point of the projective line over `C`.  The point `[p₀ : p₁]` is the
boundary point with affine coordinate `p₀ / p₁`, cut out by the covector `(p₁, -p₀)`. -/
def celestialHorizon (C : Type*) {E : Type*} [Field C] [Field E] [Algebra C E] [Differential E]
    (x : E) (p : ℙ C (Fin 2 → C)) : IntermediateField C E :=
  rowHorizon C x (p.rep 1) (-(p.rep 0))

omit [CharZero C] [CharZero E] in
theorem celestialHorizon_mk (hconst : ∀ t : C, t′ = 0) (x : E) (v : Fin 2 → C) (hv : v ≠ 0) :
    celestialHorizon C x (Projectivization.mk C v hv) = rowHorizon C x (v 1) (-(v 0)) := by
  obtain ⟨t, ht⟩ := Projectivization.exists_smul_eq_mk_rep C v hv
  have h0 : (Projectivization.mk C v hv).rep 0 = (t : C) * v 0 := by
    simp [← ht, Units.smul_def]
  have h1 : (Projectivization.mk C v hv).rep 1 = (t : C) * v 1 := by
    simp [← ht, Units.smul_def]
  rw [celestialHorizon, h0, h1, show -((t : C) * v 0) = (t : C) * (-(v 0)) by ring,
    rowHorizon_smul hconst x t.ne_zero]

omit [CharZero C] [Field E] [CharZero E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] in
theorem celestialHorizon_rep_det_ne_zero {p q : ℙ C (Fin 2 → C)} (hpq : p ≠ q) :
    p.rep 1 * -(q.rep 0) - q.rep 1 * -(p.rep 0) ≠ 0 := by
  intro h
  apply hpq
  have hmk := projectivization_mk_eq_mk_of_det_eq_zero (K := C)
    p.rep_nonzero q.rep_nonzero (by linear_combination h)
  rwa [Projectivization.mk_rep, Projectivization.mk_rep] at hmk

/-- **Faithful realization of the celestial sphere.**  Distinct boundary points of the projective
line have distinct derivative horizons. -/
theorem celestialHorizon_injective (hconst : ∀ t : C, t′ = 0) (x : E)
    (hx : HypertranscendentalOver C x) :
    Function.Injective (celestialHorizon C x) := by
  intro p q hpq
  by_contra hne
  exact rowHorizon_ne hconst x hx (celestialHorizon_rep_det_ne_zero hne) hpq

/-- **The oriented-geodesic reconstruction law.**  Every ordered pair of distinct boundary points
reconstructs the source: their horizons join to the whole differential field generated by `x`, and
meet exactly in the differential field generated by the Schwarzian of `x`. -/
theorem celestialHorizon_sup_inf (hconst : ∀ t : C, t′ = 0) (x : E)
    (hx : HypertranscendentalOver C x) {p q : ℙ C (Fin 2 → C)} (hpq : p ≠ q) :
    celestialHorizon C x p ⊔ celestialHorizon C x q = jetTailField C x 0 ∧
      celestialHorizon C x p ⊓ celestialHorizon C x q =
        actualSchwarzianDifferentialField C x :=
  rowHorizon_sup_inf hconst x hx (celestialHorizon_rep_det_ne_zero hpq)

theorem inverseVector_ne_zero {K : Type*} [Field K] {α β γ δ : K}
    (hdet : α * δ - β * γ ≠ 0) {v : Fin 2 → K} (hv : v ≠ 0) :
    ![δ * v 0 - β * v 1, α * v 1 - γ * v 0] ≠ 0 := by
  rw [fin_two_ne_zero_iff]
  rintro ⟨h0, h1⟩
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h0 h1
  refine (fin_two_ne_zero_iff.mp hv) ⟨?_, ?_⟩
  · have hz : (α * δ - β * γ) * v 0 = 0 := by linear_combination α * h0 + β * h1
    exact (mul_eq_zero.mp hz).resolve_left hdet
  · have hz : (α * δ - β * γ) * v 1 = 0 := by linear_combination γ * h0 + δ * h1
    exact (mul_eq_zero.mp hz).resolve_left hdet

/-- **Equivariance.**  A nondegenerate fractional-linear change of source transports every
boundary point of the celestial sphere by the inverse matrix. -/
theorem celestialHorizon_mobiusObservable
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (α β γ δ : C) (hdetG : α * δ - β * γ ≠ 0) (v : Fin 2 → C) (hv : v ≠ 0) :
    celestialHorizon C (mobiusObservable α β γ δ x) (Projectivization.mk C v hv)
      = celestialHorizon C x
          (Projectivization.mk C ![δ * v 0 - β * v 1, α * v 1 - γ * v 0]
            (inverseVector_ne_zero hdetG hv)) := by
  have hcd : ¬(v 1 = 0 ∧ -(v 0) = 0) := by
    rintro ⟨h1, h0⟩
    exact (fin_two_ne_zero_iff.mp hv) ⟨neg_eq_zero.mp h0, h1⟩
  rw [celestialHorizon_mk hconst _ v hv, celestialHorizon_mk hconst x _ _,
    rowHorizon_mobiusObservable hconst x hx hcd α β γ δ hdetG]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  congr 1 <;> ring

/-- **The scalar hypertranscendental horizon family is a celestial sphere.**  For a
hypertranscendental scalar over a field of differential constants, the derivative horizon of a
nondegenerate fractional-linear coordinate depends only on the projective class of its pole; the
resulting map from the projective line to differential subfields is injective and fractional-
linearly equivariant; and every ordered pair of distinct points of that line reconstructs the
whole differential field generated by the source while sharing one common projective curvature. -/
theorem hypertranscendentalOver_celestialSphere_realization
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x) :
    (∀ a b c d : C, a * d - b * c ≠ 0 →
        jetTailField C (mobiusObservable a b c d x) 1 = rowHorizon C x c d) ∧
      Function.Injective (celestialHorizon C x) ∧
      (∀ p q : ℙ C (Fin 2 → C), p ≠ q →
        celestialHorizon C x p ⊔ celestialHorizon C x q = jetTailField C x 0 ∧
          celestialHorizon C x p ⊓ celestialHorizon C x q =
            actualSchwarzianDifferentialField C x) :=
  ⟨fun a b c d hdet => jetTailField_mobiusObservable_one_eq_rowHorizon hconst x hx a b c d hdet,
    celestialHorizon_injective hconst x hx,
    fun _ _ hpq => celestialHorizon_sup_inf hconst x hx hpq⟩

/-! ## Boundary stabilizers and the oriented-geodesic space -/

theorem projectivization_mk_eq_mk_iff {K : Type*} [Field K] {v w : Fin 2 → K}
    (hv : v ≠ 0) (hw : w ≠ 0) :
    Projectivization.mk K v hv = Projectivization.mk K w hw ↔ v 0 * w 1 - w 0 * v 1 = 0 := by
  refine ⟨fun h => ?_, projectivization_mk_eq_mk_of_det_eq_zero hv hw⟩
  obtain ⟨a, ha⟩ := (Projectivization.mk_eq_mk_iff K v w hv hw).mp h
  have h0 : v 0 = (a : K) * w 0 := by rw [← ha]; simp [Units.smul_def]
  have h1 : v 1 = (a : K) * w 1 := by rw [← ha]; simp [Units.smul_def]
  rw [h0, h1]
  ring

theorem celestialHorizon_mk_eq_mk_iff
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {v w : Fin 2 → C} (hv : v ≠ 0) (hw : w ≠ 0) :
    celestialHorizon C x (Projectivization.mk C v hv)
        = celestialHorizon C x (Projectivization.mk C w hw) ↔
      v 0 * w 1 - w 0 * v 1 = 0 := by
  rw [← projectivization_mk_eq_mk_iff hv hw]
  exact ⟨fun h => celestialHorizon_injective hconst x hx h, fun h => by rw [h]⟩

theorem vecOne_zero_ne_zero {K : Type*} [Field K] : ![(1 : K), 0] ≠ 0 := by
  rw [fin_two_ne_zero_iff]
  simp

theorem vecZero_one_ne_zero {K : Type*} [Field K] : ![(0 : K), 1] ≠ 0 := by
  rw [fin_two_ne_zero_iff]
  simp

/-- **Parabolic stabilizer of one horizon.**  A nondegenerate fractional-linear change of source
leaves the horizon at infinity in place exactly when it is affine, that is when it fixes the
boundary point at infinity. -/
theorem celestialHorizon_infinity_fixed_iff
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (α β γ δ : C) (hdetG : α * δ - β * γ ≠ 0) :
    celestialHorizon C (mobiusObservable α β γ δ x)
          (Projectivization.mk C ![1, 0] vecOne_zero_ne_zero)
        = celestialHorizon C x (Projectivization.mk C ![1, 0] vecOne_zero_ne_zero) ↔
      γ = 0 := by
  rw [celestialHorizon_mobiusObservable hconst x hx α β γ δ hdetG _ vecOne_zero_ne_zero,
    celestialHorizon_mk_eq_mk_iff hconst x hx]
  simp

/-- **Cartan stabilizer of an oriented geodesic.**  A nondegenerate fractional-linear change of
source leaves both the horizon at infinity and the horizon at zero in place exactly when it is
linear, that is when it fixes both endpoints of the corresponding oriented geodesic. -/
theorem celestialHorizon_pair_fixed_iff
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (α β γ δ : C) (hdetG : α * δ - β * γ ≠ 0) :
    (celestialHorizon C (mobiusObservable α β γ δ x)
          (Projectivization.mk C ![1, 0] vecOne_zero_ne_zero)
        = celestialHorizon C x (Projectivization.mk C ![1, 0] vecOne_zero_ne_zero) ∧
      celestialHorizon C (mobiusObservable α β γ δ x)
          (Projectivization.mk C ![0, 1] vecZero_one_ne_zero)
        = celestialHorizon C x (Projectivization.mk C ![0, 1] vecZero_one_ne_zero)) ↔
      γ = 0 ∧ β = 0 := by
  rw [celestialHorizon_infinity_fixed_iff hconst x hx α β γ δ hdetG,
    celestialHorizon_mobiusObservable hconst x hx α β γ δ hdetG _ vecZero_one_ne_zero,
    celestialHorizon_mk_eq_mk_iff hconst x hx]
  simp [neg_eq_zero]

/-- The oriented geodesics of the rank-one hyperbolic geometry whose visual boundary is the
projective line: ordered pairs of distinct boundary points. -/
abbrev orientedGeodesicSpace (C : Type*) [Field C] : Type _ :=
  {pq : ℙ C (Fin 2 → C) × ℙ C (Fin 2 → C) // pq.1 ≠ pq.2}

/-- The endpoint horizons of an oriented geodesic. -/
def geodesicHorizonPair (C : Type*) {E : Type*} [Field C] [Field E] [Algebra C E]
    [Differential E] (x : E) (g : orientedGeodesicSpace C) :
    IntermediateField C E × IntermediateField C E :=
  (celestialHorizon C x g.1.1, celestialHorizon C x g.1.2)

/-- **The geodesic reconstruction law.**  The two endpoint horizons of an oriented geodesic are
distinct, join to the whole differential field generated by the source, and meet exactly in the
differential field generated by its Schwarzian. -/
theorem geodesicHorizonPair_reconstruction
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    (g : orientedGeodesicSpace C) :
    (geodesicHorizonPair C x g).1 ≠ (geodesicHorizonPair C x g).2 ∧
      (geodesicHorizonPair C x g).1 ⊔ (geodesicHorizonPair C x g).2 = jetTailField C x 0 ∧
      (geodesicHorizonPair C x g).1 ⊓ (geodesicHorizonPair C x g).2 =
        actualSchwarzianDifferentialField C x := by
  obtain ⟨hsup, hinf⟩ := celestialHorizon_sup_inf hconst x hx g.2
  exact ⟨fun h => g.2 (celestialHorizon_injective hconst x hx h), hsup, hinf⟩

/-- **Unique oriented geodesic through an ordered pair of distinct horizons.**  Every ordered pair
of distinct horizons in the family is the endpoint pair of exactly one oriented geodesic. -/
theorem existsUnique_orientedGeodesic
    (hconst : ∀ t : C, t′ = 0) (x : E) (hx : HypertranscendentalOver C x)
    {p q : ℙ C (Fin 2 → C)}
    (hne : celestialHorizon C x p ≠ celestialHorizon C x q) :
    ∃! g : orientedGeodesicSpace C,
      geodesicHorizonPair C x g = (celestialHorizon C x p, celestialHorizon C x q) := by
  have hpq : p ≠ q := fun h => hne (by rw [h])
  refine ⟨⟨(p, q), hpq⟩, rfl, ?_⟩
  rintro ⟨⟨p', q'⟩, hp'q'⟩ hg
  have h1 : celestialHorizon C x p' = celestialHorizon C x p := congrArg Prod.fst hg
  have h2 : celestialHorizon C x q' = celestialHorizon C x q := congrArg Prod.snd hg
  have hp : p' = p := celestialHorizon_injective hconst x hx h1
  have hq : q' = q := celestialHorizon_injective hconst x hx h2
  simp only [Subtype.mk.injEq, Prod.mk.injEq]
  exact ⟨hp, hq⟩

/-! ## The prime field of constants -/

section PrimeFieldBase

/-- The prime field carries the trivial derivation. -/
local instance primeFieldDifferential : Differential ℚ := ⟨0⟩

local instance primeFieldDifferentialAlgebra
    {K : Type*} [Field K] [CharZero K] [Differential K] : DifferentialAlgebra ℚ K :=
  ⟨fun q => by
    rw [deriv_algebraMap_rat_eq_zero, show q′ = (0 : ℚ) from rfl, map_zero]⟩

/-- **Prime-field celestial realization.**  Every scalar that is hypertranscendental over some
characteristic-zero coefficient field carries a faithful horizon family indexed by the projective
line over the prime field of constants, in which every ordered pair of distinct boundary points
reconstructs the source and every pair shares one projective curvature. -/
theorem hypertranscendentalOver_celestialSphere_realization_prime
    {F K : Type*} [Field F] [CharZero F] [Field K] [CharZero K] [Differential K]
    [Algebra F K] {x : K} (hx : HypertranscendentalOver F x) :
    (∀ a b c d : ℚ, a * d - b * c ≠ 0 →
        jetTailField ℚ (mobiusObservable a b c d x) 1 = rowHorizon ℚ x c d) ∧
      Function.Injective (celestialHorizon ℚ x) ∧
      (∀ p q : ℙ ℚ (Fin 2 → ℚ), p ≠ q →
        celestialHorizon ℚ x p ⊔ celestialHorizon ℚ x q = jetTailField ℚ x 0 ∧
          celestialHorizon ℚ x p ⊓ celestialHorizon ℚ x q =
            actualSchwarzianDifferentialField ℚ x) :=
  hypertranscendentalOver_celestialSphere_realization (fun _ => rfl) x
    (hypertranscendentalOver_restrictRat hx)

end PrimeFieldBase

end

