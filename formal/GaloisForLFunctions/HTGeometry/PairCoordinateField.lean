import GaloisForLFunctions.HTGeometry.PairLinearFamily

/-!
# The coordinate subfield as the peel's ambient algebra

The peel of the two-coordinate law needs an ambient algebra that is stable under the law and under
every coordinate derivation, that is free of a higher coordinate, and that contains the inverse of
any univariate factor — the last because the limit of the border row acquires a logarithmic
derivative of the leading coefficient of the last placed polynomial.

The subfield generated by the coordinates up to `m` does all four, and its membership test is a
single derivation condition: `f` lies in it exactly when every higher coordinate derivation kills
`f`.  Stability under the coordinate derivations is then immediate from their commuting, and
stability under the law is the chain rule.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

variable {p : ℕ → MvPolynomial (Fin 2) ℂ}

/-! ## The subfield generated by the coordinates up to a level -/

/-- The rational subfield generated by the coordinates up to `m`. -/
noncomputable def coordField (m : ℕ) : IntermediateField ℂ CascadeField :=
  freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ)

theorem mem_coordField_iff {m : ℕ} {f : CascadeField} :
    f ∈ coordField m ↔ ∀ i, m < i → fpderiv i f = 0 := by
  rw [coordField, mem_freeCoordinateField_iff]
  constructor
  · intro h i hi
    rw [fpderiv_eq_freeCoordinateDerivation]
    exact h i (by simp only [Finset.coe_range, Set.mem_Iio]; omega)
  · intro h i hi
    rw [← fpderiv_eq_freeCoordinateDerivation]
    simp only [Finset.coe_range, Set.mem_Iio] at hi
    exact h i (by omega)

theorem coordField_mono {m m' : ℕ} (h : m ≤ m') : coordField m ≤ coordField m' := by
  intro f hf
  rw [mem_coordField_iff] at hf ⊢
  exact fun i hi => hf i (by omega)

/-! ## What the peel's objects are made of -/

theorem fx_mem_coordField {j m : ℕ} (h : j ≤ m) : fx j ∈ coordField m := by
  rw [mem_coordField_iff]
  exact fun i hi => fpderiv_fx_of_ne (by omega)

theorem fact_mem_coordField {j m : ℕ} (h : j ≤ m) (q : Polynomial ℂ) :
    fact q j ∈ coordField m := by
  rw [mem_coordField_iff]
  exact fun i hi => fpderiv_fact_of_ne (by omega)

theorem pairFactor_mem_coordField {j m : ℕ} (h : j + 1 ≤ m) (q : MvPolynomial (Fin 2) ℂ) :
    pairFactor q j ∈ coordField m := by
  rw [mem_coordField_iff]
  exact fun i hi => fpderiv_pairFactor_of_ne (by omega) (by omega) q

theorem pairJet_mem_coordField {l m : ℕ} (h : l ≤ m) : pairJet p l ∈ coordField m := by
  rw [mem_coordField_iff]
  exact fun i hi => fpderiv_pairJet_of_gt p (by omega)

/-! ## Stability -/

/-- **The subfield is stable under every coordinate derivation.**  This is exactly the commuting of
mixed coordinate derivatives. -/
theorem fpderiv_mem_coordField {m : ℕ} (k : ℕ) {f : CascadeField} (h : f ∈ coordField m) :
    fpderiv k f ∈ coordField m := by
  rw [mem_coordField_iff] at h ⊢
  intro i hi
  rw [fpderiv_comm i k f, h i hi, map_zero]

/-- **The chain rule on the subfield.** -/
theorem pairDerivation_eq_sum_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m) :
    pairDerivation p f = ∑ l ∈ Finset.range (m + 1), pairJet p l * fpderiv l f := by
  have hchain := freeCoordinate_chainRule (Finset.range (m + 1)) (pairDerivation p) h
  rw [hchain]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [fpderiv_eq_freeCoordinateDerivation]
  congr 1
  exact pairDerivation_fx p l

/-- **The subfield is stable under the law.** -/
theorem pairDerivation_mem_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m) :
    pairDerivation p f ∈ coordField m := by
  rw [pairDerivation_eq_sum_coordField h]
  refine sum_mem fun l hl => ?_
  have hlm : l < m + 1 := Finset.mem_range.mp hl
  exact mul_mem (pairJet_mem_coordField (by omega)) (fpderiv_mem_coordField l h)

theorem iterate_pairDerivation_mem_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m)
    (r : ℕ) : ((pairDerivation p : CascadeField → CascadeField)^[r]) f ∈ coordField m := by
  induction r with
  | zero => simpa using h
  | succ r ih =>
      rw [Function.iterate_succ_apply']
      exact pairDerivation_mem_coordField ih

/-! ## The mixed commutation law on the subfield -/

theorem pairMixCommutator_eq_zero_coordField {m k : ℕ} {F : CascadeField}
    (h : F ∈ coordField m) : pairMixCommutator p m k F = 0 := by
  have hgen : ∀ x ∈ freeCoordinate ℂ ℕ '' (↑(Finset.range (m + 1)) : Set ℕ),
      pairMixCommutator p m k x = (0 : Derivation ℂ CascadeField CascadeField) x := by
    rintro _ ⟨j, hj, rfl⟩
    simp only [Finset.coe_range, Set.mem_Iio] at hj
    have hfx : freeCoordinate ℂ ℕ j = fx j := rfl
    rw [hfx]
    simpa using pairMixCommutator_fx (p := p) (k := k) (by omega : j ≤ m)
  have hle := adjoin_le_derivationEqualizer hgen
  have hmem : F ∈ derivationEqualizer (pairMixCommutator p m k)
      (0 : Derivation ℂ CascadeField CascadeField) := hle h
  rw [mem_derivationEqualizer_iff] at hmem
  simpa using hmem

/-- **The exact mixed commutation law on the subfield.** -/
theorem fpderiv_pairDerivation_mixed_coordField {m k : ℕ} {F : CascadeField}
    (h : F ∈ coordField m) :
    fpderiv k (pairDerivation p F) = pairDerivation p (fpderiv k F) + pairJetMix p m k F := by
  have h0 := pairMixCommutator_eq_zero_coordField (p := p) (k := k) h
  rw [pairMixCommutator_apply] at h0
  linear_combination h0

/-- **The gradient of a derivative is the shifted gradient.** -/
theorem gradient_pairDerivation_eq_coordField {m : ℕ} {F : CascadeField} (h : F ∈ coordField m) :
    (fun l => fpderiv l (pairDerivation p F))
      = pairGradShift p m (fun l => fpderiv l F) := by
  funext k
  exact fpderiv_pairDerivation_mixed_coordField h

/-- **The gradient of an iterate is an iterate of the shifted operator.** -/
theorem gradient_iterate_pair_eq_coordField {m : ℕ} (r : ℕ) {F : CascadeField}
    (h : F ∈ coordField m) :
    (fun l => fpderiv l (((pairDerivation p : CascadeField → CascadeField)^[r]) F))
      = ((pairGradShift p m)^[r]) (fun l => fpderiv l F) := by
  induction r generalizing F with
  | zero => simp
  | succ r ih =>
      rw [Function.iterate_succ_apply, ih (pairDerivation_mem_coordField h),
        gradient_pairDerivation_eq_coordField h, Function.iterate_succ_apply]

/-! ## Freedom from a higher coordinate -/

theorem TopFree.inv {m : ℕ} {f : CascadeField} (h : TopFree m f) : TopFree m f⁻¹ := by
  rcases eq_or_ne f 0 with rfl | hf
  · rw [inv_zero]
    exact topFree_zero m
  · obtain ⟨N, D, hD, hval, hN0, hD0⟩ := h
    have hNne : N ≠ 0 := by
      intro hc
      rw [hc, map_zero] at hval
      exact hf (by
        rcases mul_eq_zero.mp hval with hc' | hc'
        · exact absurd ((map_eq_zero_iff _ (IsFractionRing.injective _ _)).mp hc') hD
        · exact hc')
    refine ⟨D, N, hNne, ?_, hD0, hN0⟩
    have hDne : algebraMap (MvPolynomial ℕ ℂ) CascadeField D ≠ 0 := by
      simpa using (IsFractionRing.injective (MvPolynomial ℕ ℂ) CascadeField).ne hD
    field_simp
    linear_combination -hval

/-- The elements free of the coordinate `m` form a subfield. -/
noncomputable def topFreeField (m : ℕ) : IntermediateField ℂ CascadeField where
  carrier := {f | TopFree m f}
  zero_mem' := topFree_zero m
  one_mem' := topFree_one m
  add_mem' := fun hx hy => TopFree.add hx hy
  mul_mem' := fun hx hy => TopFree.mul hx hy
  algebraMap_mem' := fun c => topFree_algebraMap_complex m c
  inv_mem' := fun _ hx => TopFree.inv hx

/-- **Everything generated by lower coordinates is free of a higher one.** -/
theorem topFree_of_mem_coordField {m m' : ℕ} (hm : m' < m) {f : CascadeField}
    (hf : f ∈ coordField m') : TopFree m f := by
  have hle : coordField m' ≤ topFreeField m := by
    rw [coordField, freeCoordinateField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨j, hj, rfl⟩
    simp only [Finset.coe_range, Set.mem_Iio] at hj
    have hfx : freeCoordinate ℂ ℕ j = fx j := rfl
    rw [hfx, ← fact_X j]
    exact topFree_fact (m := m) (j := j) (by omega) Polynomial.X
  exact hle hf

end GaloisForLFunctions.HTGeometry
