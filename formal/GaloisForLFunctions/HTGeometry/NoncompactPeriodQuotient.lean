import GaloisForLFunctions.HTGeometry.FullPeriodExtraction

/-!
# Noncompactness of a period quotient

A quotient of a finite-dimensional real space by an additive subgroup is compact only if the
subgroup spans.  The obstruction is exhibited by a single linear functional: if the subgroup misses
a hyperplane, a nonzero functional annihilating it descends to a continuous surjection of the
quotient onto the line, and the line is not compact.

Applied to a period group this is the noncompactness clause of a quasi-Abelian period quotient: a
function whose periods span less than the ambient space has a noncompact period quotient.  Since the
span of a subgroup is unchanged by dividing out the directions along which it contains a whole line,
the criterion may be read on the period group itself rather than on the discrete part.
-/

open Set Submodule Module

namespace GaloisForLFunctions.HTGeometry

variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]

/-- **A subgroup that fails to span has a noncompact quotient.** -/
theorem not_isCompact_univ_quotient_of_span_ne_top
    (Γ : AddSubgroup W) (h : Submodule.span ℝ (Γ : Set W) ≠ ⊤) :
    ¬ IsCompact (Set.univ : Set (W ⧸ Γ)) := by
  intro hcompact
  obtain ⟨f, hf0, hfker⟩ :=
    Submodule.exists_dual_map_eq_bot_of_lt_top (lt_top_iff_ne_top.mpr h) inferInstance
  have hfΓ : ∀ x ∈ Γ, f x = 0 := by
    intro x hx
    have hmem : f x ∈ (Submodule.span ℝ (Γ : Set W)).map f :=
      Submodule.mem_map_of_mem (Submodule.subset_span hx)
    rw [hfker, Submodule.mem_bot] at hmem
    exact hmem
  set F : W ⧸ Γ → ℝ :=
    ⇑(QuotientAddGroup.lift Γ f.toAddMonoidHom (fun x hx => hfΓ x hx)) with hFdef
  have hFcomp : ∀ w : W, F (QuotientAddGroup.mk' Γ w) = f w := fun _ => rfl
  have hFcont : Continuous F := by
    refine continuous_coinduced_dom.mpr ?_
    exact LinearMap.continuous_of_finiteDimensional f
  have hFsurj : Function.Surjective F := by
    intro r
    obtain ⟨w, hw⟩ := LinearMap.surjective_of_ne_zero hf0 r
    exact ⟨QuotientAddGroup.mk' Γ w, by rw [hFcomp]; exact hw⟩
  have himg : F '' Set.univ = Set.univ := by
    rw [Set.image_univ, hFsurj.range_eq]
  have hcompR : IsCompact (Set.univ : Set ℝ) := by
    rw [← himg]
    exact hcompact.image hFcont
  exact NoncompactSpace.noncompact_univ hcompR

omit [FiniteDimensional ℝ W] in
/-- A subgroup generated by fewer elements than the dimension cannot span. -/
theorem span_closure_ne_top_of_card_lt_finrank {s : Finset W}
    (hcard : s.card < Module.finrank ℝ W) :
    Submodule.span ℝ ((AddSubgroup.closure (s : Set W) : AddSubgroup W) : Set W) ≠ ⊤ := by
  have hspan : Submodule.span ℝ ((AddSubgroup.closure (s : Set W) : AddSubgroup W) : Set W)
      = Submodule.span ℝ (s : Set W) := by
    refine le_antisymm ?_ (Submodule.span_mono AddSubgroup.subset_closure)
    rw [Submodule.span_le]
    intro x hx
    exact (AddSubgroup.closure_le (Submodule.span ℝ (s : Set W)).toAddSubgroup).mpr
      Submodule.subset_span hx
  rw [hspan]
  intro hcon
  have hle : Module.finrank ℝ (Submodule.span ℝ (s : Set W)) ≤ s.card :=
    finrank_span_finset_le_card s
  rw [hcon, finrank_top] at hle
  omega

/-- **Noncompact period quotient.**  A function whose periods span less than the ambient space has
a noncompact period quotient. -/
theorem not_isCompact_univ_quotient_translationPeriods
    {G : W → ℂ} (h : Submodule.span ℝ ((translationPeriods G : AddSubgroup W) : Set W) ≠ ⊤) :
    ¬ IsCompact (Set.univ : Set (W ⧸ translationPeriods G)) :=
  not_isCompact_univ_quotient_of_span_ne_top _ h

end GaloisForLFunctions.HTGeometry
