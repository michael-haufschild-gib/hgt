import GaloisForLFunctions.HTGeometry.DennisSteinScaling
import GaloisForLFunctions.HTGeometry.SteinbergMatsumotoComparison

/-!
# Dennis--Stein reduction modulo Steinberg symbols

The Dennis--Stein part of Matsumoto's field theorem has a precise quotient-level
normal form before one proves that all of `K₂` is generated by symbols.  Let
`SymbolSubgroup` be the subgroup generated by the torus symbols.  The cross-torus
comparison identifies every torus commutator with an element of this subgroup.
Consequently the scaling formula has no residual term modulo `SymbolSubgroup`:
whenever the second Dennis--Stein parameter is a unit,

```text
⟨a,b⟩ ≡ ⟨ba,1⟩  (mod SymbolSubgroup).
```

Over a field this reduces every nondegenerate Dennis--Stein word to the single
right-one family.  Thus the unresolved algebraic core is not general two-variable
Dennis--Stein calculus; it is the elimination of that right-one family (equivalently,
the field normal-form/generation theorem).
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n] [Fintype n]

/-- The subgroup generated by all finite-rank Steinberg symbols. -/
def steinbergSymbolSubgroup (R : Type*) [CommRing R] (n : Type*) [DecidableEq n]
    [Fintype n] : Subgroup (SteinbergGroup R n) :=
  Subgroup.closure {z | ∃ (i j : n) (hij : i ≠ j) (u v : Rˣ), z = steinbergSymbol hij u v}

/-- Every displayed Steinberg symbol belongs to the symbol subgroup. -/
theorem steinbergSymbol_mem_symbolSubgroup {i j : n} (hij : i ≠ j) (u v : Rˣ) :
    steinbergSymbol hij u v ∈ steinbergSymbolSubgroup R n :=
  Subgroup.subset_closure ⟨i, j, hij, u, v, rfl⟩

/-- Every cross-torus commutator belongs to the subgroup generated by Steinberg symbols. -/
theorem torusCommutator_mem_symbolSubgroup {i j k : n} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (w t : Rˣ) :
    torusCommutator hij hik w t ∈ steinbergSymbolSubgroup R n := by
  have hrewrite : torusCommutator hij hik w t = (steinbergSymbol hij t w)⁻¹ := by
    calc torusCommutator hij hik w t = (torusCommutator hik hij t w)⁻¹ := by
          unfold torusCommutator
          group
      _ = (steinbergSymbol hij t w)⁻¹ := by
        rw [torusCommutator_eq_steinbergSymbol hij hik hjk]
  rw [hrewrite]
  exact (steinbergSymbolSubgroup R n).inv_mem (steinbergSymbol_mem_symbolSubgroup hij t w)

/-- Scaling by a unit changes a Dennis--Stein symbol only by a Steinberg-symbol factor. -/
theorem dennisStein_mem_symbolSubgroup_iff_normalize_right {i j k : n} (hij : i ≠ j)
    (hik : i ≠ k) (hjk : j ≠ k) (a : R) (b w : Rˣ) (hw : (w : R) = 1 + a * (b : R)) :
    dennisStein hij a (b : R) w ∈ steinbergSymbolSubgroup R n ↔
      dennisStein hij ((b : R) * a) 1 w ∈ steinbergSymbolSubgroup R n := by
  let C : SteinbergGroup R n := torusCommutator hij hik w b
  have hC : C ∈ steinbergSymbolSubgroup R n := by
    exact torusCommutator_mem_symbolSubgroup hij hik hjk w b
  have hnorm := dennisStein_normalize_right hij hik hjk a b w hw
  change dennisStein hij a (b : R) w ∈ steinbergSymbolSubgroup R n ↔
    dennisStein hij ((b : R) * a) 1 w ∈ steinbergSymbolSubgroup R n
  constructor
  · intro h
    have hrewrite : dennisStein hij ((b : R) * a) 1 w
        = dennisStein hij a (b : R) w * C⁻¹ := by
      rw [hnorm]
      simp only [C, torusCommutator]
      group
    rw [hrewrite]
    exact (steinbergSymbolSubgroup R n).mul_mem h
      ((steinbergSymbolSubgroup R n).inv_mem hC)
  · intro h
    rw [hnorm]
    exact (steinbergSymbolSubgroup R n).mul_mem h hC

/-- Over a field, every Dennis--Stein word with nonzero second parameter reduces to a
right-one word modulo Steinberg symbols. -/
theorem dennisStein_mem_symbolSubgroup_iff_right_one_of_ne_zero {F : Type*} [Field F]
    {n : Type*} [DecidableEq n] [Fintype n] {i j k : n} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (a b : F) (hb : b ≠ 0) (w : Fˣ) (hw : (w : F) = 1 + a * b) :
    dennisStein hij a b w ∈ steinbergSymbolSubgroup F n ↔
      dennisStein hij (a * b) 1 w ∈ steinbergSymbolSubgroup F n := by
  let bUnit : Fˣ := Units.mk0 b hb
  have hwUnit : (w : F) = 1 + a * (bUnit : F) := by
    simpa [bUnit] using hw
  have h := dennisStein_mem_symbolSubgroup_iff_normalize_right hij hik hjk a bUnit w hwUnit
  simpa [bUnit, mul_comm] using h

/-- Over a field, every Dennis--Stein word reduces modulo Steinberg symbols to the
right-one family.  The zero second parameter is the only degenerate case, and both
sides then collapse to the identity. -/
theorem dennisStein_mem_symbolSubgroup_iff_right_one {F : Type*} [Field F]
    {n : Type*} [DecidableEq n] [Fintype n] {i j k : n} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (a b : F) (w : Fˣ) (hw : (w : F) = 1 + a * b) :
    dennisStein hij a b w ∈ steinbergSymbolSubgroup F n ↔
      dennisStein hij (a * b) 1 w ∈ steinbergSymbolSubgroup F n := by
  rcases eq_or_ne b 0 with rfl | hb
  · have hw1 : w = 1 := by
      apply Units.ext
      simpa using hw
    rw [hw1, dennisStein_right_zero]
    simp only [mul_zero]
    rw [dennisStein_left_zero]
  · exact dennisStein_mem_symbolSubgroup_iff_right_one_of_ne_zero hij hik hjk a b hb w hw

end GaloisForLFunctions.HTGeometry
