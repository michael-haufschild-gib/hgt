import Mathlib

/-!
# Hadamard division for analytic germs in two complex variables

A function analytic at the origin of `ℂ × ℂ` and vanishing there lies in the ideal generated by the
two coordinates: `f = x A + y B` near the origin with `A` and `B` analytic.

The proof splits the power series in its first multilinear slot.  Writing `v = x • (1,0) + y • (0,1)`
and currying the `(n+1)`-st term of the series on the left produces two series `qA`, `qB` of the same
radius of convergence whose sums are the required factors.

* `curryShiftSeries` — the left-curried shift of a formal multilinear series.
* `radius_le_curryShiftSeries` — the shift does not decrease the radius of convergence.
* `exists_hadamard_decomposition` — the division statement.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter Topology
open scoped ENNReal NNReal

noncomputable section

/-- The `n`-th term of the series obtained by fixing `e` in the first slot of the `(n+1)`-st term. -/
def curryShiftSeries (p : FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ) (e : ℂ × ℂ) :
    FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ :=
  fun n => (p (n + 1)).curryLeft e

theorem curryShiftSeries_apply (p : FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ) (e : ℂ × ℂ) (n : ℕ)
    (m : Fin n → ℂ × ℂ) : curryShiftSeries p e n m = p (n + 1) (Fin.cons e m) :=
  ContinuousMultilinearMap.curryLeft_apply _ _ _

theorem norm_curryShiftSeries_le (p : FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ) (e : ℂ × ℂ) (n : ℕ) :
    ‖curryShiftSeries p e n‖ ≤ ‖p (n + 1)‖ * ‖e‖ := by
  refine ContinuousMultilinearMap.opNorm_le_bound (by positivity) ?_
  intro m
  rw [curryShiftSeries_apply]
  refine ((p (n + 1)).le_opNorm _).trans ?_
  rw [Fin.prod_univ_succ]
  simp only [Fin.cons_zero, Fin.cons_succ]
  rw [← mul_assoc]

/-- The left-curried shift does not decrease the radius of convergence. -/
theorem radius_le_curryShiftSeries (p : FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ) (e : ℂ × ℂ) :
    p.radius ≤ (curryShiftSeries p e).radius := by
  refine ENNReal.le_of_forall_nnreal_lt fun r hr => ?_
  by_cases hr0 : r = 0
  · simp [hr0]
  have hrne : (r : ℝ) ≠ 0 := by simpa using hr0
  have hrpos : (0 : ℝ) < (r : ℝ) := lt_of_le_of_ne r.coe_nonneg (Ne.symm hrne)
  obtain ⟨C, hC, hCn⟩ := p.norm_mul_pow_le_of_lt_radius hr
  refine (curryShiftSeries p e).le_radius_of_bound (C * ‖e‖ / r) fun n => ?_
  have h1 : ‖curryShiftSeries p e n‖ * (r : ℝ) ^ n ≤ ‖p (n + 1)‖ * ‖e‖ * (r : ℝ) ^ n :=
    mul_le_mul_of_nonneg_right (norm_curryShiftSeries_le p e n) (by positivity)
  have h2 : ‖p (n + 1)‖ * (r : ℝ) ^ (n + 1) ≤ C := hCn (n + 1)
  have hkey : ‖p (n + 1)‖ * (r : ℝ) ^ n ≤ C / (r : ℝ) := by
    rw [le_div_iff₀ hrpos]
    calc ‖p (n + 1)‖ * (r : ℝ) ^ n * (r : ℝ) = ‖p (n + 1)‖ * (r : ℝ) ^ (n + 1) := by ring
      _ ≤ C := h2
  calc ‖curryShiftSeries p e n‖ * (r : ℝ) ^ n
      ≤ ‖p (n + 1)‖ * ‖e‖ * (r : ℝ) ^ n := h1
    _ = (‖p (n + 1)‖ * (r : ℝ) ^ n) * ‖e‖ := by ring
    _ ≤ (C / (r : ℝ)) * ‖e‖ := mul_le_mul_of_nonneg_right hkey (norm_nonneg e)
    _ = C * ‖e‖ / (r : ℝ) := by ring

/-- Splitting a term of the series in its first slot along the two coordinate directions. -/
theorem apply_eq_curryShiftSeries_add (p : FormalMultilinearSeries ℂ (ℂ × ℂ) ℂ) (n : ℕ)
    (v : ℂ × ℂ) :
    p (n + 1) (fun _ => v)
      = v.1 * curryShiftSeries p (1, 0) n (fun _ => v)
        + v.2 * curryShiftSeries p (0, 1) n (fun _ => v) := by
  obtain ⟨x, y⟩ := v
  have hcons : (fun _ : Fin (n + 1) => ((x, y) : ℂ × ℂ))
      = Fin.cons ((x, y) : ℂ × ℂ) (fun _ : Fin n => ((x, y) : ℂ × ℂ)) := by
    funext i
    induction i using Fin.cases with
    | zero => simp
    | succ j => simp
  have hxy : ((x, y) : ℂ × ℂ)
      = x • ((1 : ℂ), (0 : ℂ)) + y • ((0 : ℂ), (1 : ℂ)) := by
    simp
  have hcurry : (p (n + 1)).curryLeft ((x, y) : ℂ × ℂ)
      = x • (p (n + 1)).curryLeft ((1 : ℂ), (0 : ℂ))
        + y • (p (n + 1)).curryLeft ((0 : ℂ), (1 : ℂ)) := by
    rw [hxy, map_add, map_smul, map_smul]
  rw [hcons, ← ContinuousMultilinearMap.curryLeft_apply, hcurry]
  simp [curryShiftSeries, ContinuousMultilinearMap.curryLeft_apply, smul_eq_mul]

/-- **Hadamard division in two complex variables.**  A function analytic at the origin is its value
there plus a combination of the two coordinates with analytic coefficients. -/
theorem exists_hadamard_decomposition {f : ℂ × ℂ → ℂ} (hf : AnalyticAt ℂ f 0) :
    ∃ A B : ℂ × ℂ → ℂ, AnalyticAt ℂ A 0 ∧ AnalyticAt ℂ B 0 ∧
      ∀ᶠ v in 𝓝 (0 : ℂ × ℂ), f v = f 0 + v.1 * A v + v.2 * B v := by
  obtain ⟨p, r, hp⟩ := hf
  set qA := curryShiftSeries p (1, 0) with hqA
  set qB := curryShiftSeries p (0, 1) with hqB
  have hrp : r ≤ p.radius := hp.r_le
  have hApos : 0 < qA.radius := lt_of_lt_of_le hp.r_pos (hrp.trans (radius_le_curryShiftSeries _ _))
  have hBpos : 0 < qB.radius := lt_of_lt_of_le hp.r_pos (hrp.trans (radius_le_curryShiftSeries _ _))
  refine ⟨qA.sum, qB.sum, (qA.hasFPowerSeriesOnBall hApos).analyticAt,
    (qB.hasFPowerSeriesOnBall hBpos).analyticAt, ?_⟩
  have hball : Metric.eball (0 : ℂ × ℂ) (min r (min qA.radius qB.radius)) ∈ 𝓝 (0 : ℂ × ℂ) := by
    refine Metric.eball_mem_nhds _ ?_
    simp only [lt_min_iff]
    exact ⟨hp.r_pos, hApos, hBpos⟩
  filter_upwards [hball] with v hv
  simp only [Metric.mem_eball, lt_min_iff] at hv
  obtain ⟨hvr, hvA, hvB⟩ := hv
  have hsumf : HasSum (fun n => p n fun _ => v) (f v) := by
    simpa using hp.hasSum (by simpa [Metric.mem_eball] using hvr)
  have hsumA : HasSum (fun n => qA n fun _ => v) (qA.sum v) := by
    simpa using (qA.hasFPowerSeriesOnBall hApos).hasSum (by simpa [Metric.mem_eball] using hvA)
  have hsumB : HasSum (fun n => qB n fun _ => v) (qB.sum v) := by
    simpa using (qB.hasFPowerSeriesOnBall hBpos).hasSum (by simpa [Metric.mem_eball] using hvB)
  have hsplit : HasSum (fun n => p (n + 1) fun _ => v)
      (v.1 * qA.sum v + v.2 * qB.sum v) := by
    have := (hsumA.mul_left v.1).add (hsumB.mul_left v.2)
    refine this.congr_fun fun n => ?_
    rw [apply_eq_curryShiftSeries_add p n v]
  have hshift : HasSum (fun n => p (n + 1) fun _ => v) (f v - p 0 fun _ => v) := by
    have h := (hasSum_nat_add_iff' (f := fun n => p n fun _ => v) 1).mpr hsumf
    simpa using h
  have hzero : (p 0 fun _ => v) = f 0 := by
    have := hp.coeff_zero (fun _ => v)
    simpa using this
  have := hsplit.unique hshift
  rw [hzero] at this
  linear_combination -this

end

end GaloisForLFunctions.HTGeometry
