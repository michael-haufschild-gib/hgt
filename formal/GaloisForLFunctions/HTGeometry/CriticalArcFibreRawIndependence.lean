import GaloisForLFunctions.HTGeometry.CriticalArcFibre
import GaloisForLFunctions.HTGeometry.FiniteFieldGeneratorIndependence
import GaloisForLFunctions.HTGeometry.TruncatedReciprocalCoefficientField

/-!
# Raw-coordinate independence on the exact critical arc fibre

Every point of the exact common-scale critical fibre completes to mutually inverse raw and
reciprocal jets below the horizon.  The reciprocal recursion places all observed reciprocal
coordinates in the field generated by the completed raw jet.  Since the raw and reciprocal
observations form an independent family of the same size, the completed raw jet itself is
algebraically independent.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

/-- Full raw polynomial associated to an arc-fibre point. -/
noncomputable def criticalArcFibreRawPolynomial
    {K : Type*} [Field K] {m n : ℕ} (p : CriticalArcFibre K m n) :
    (CriticalArcLaurentField K m n)[X] :=
  p.1.1 + criticalArcRawTail K m n

/-- Full reciprocal polynomial associated to an arc-fibre point. -/
noncomputable def criticalArcFibreReciprocalPolynomial
    {K : Type*} [Field K] {m n : ℕ} (p : CriticalArcFibre K m n) :
    (CriticalArcLaurentField K m n)[X] :=
  p.1.2 + criticalArcReciprocalTail K m n

/-- Completed raw coefficients through the critical horizon. -/
noncomputable def criticalArcFibreRawCoordinate
    {K : Type*} [Field K] {m n : ℕ} (p : CriticalArcFibre K m n) :
    Fin (m + n) → CriticalArcLaurentField K m n := fun j ↦
  (criticalArcFibreRawPolynomial p).coeff (j : ℕ)

/-- The completed raw and reciprocal polynomials are inverse modulo the horizon. -/
theorem criticalArcFibre_truncated_inverse
    {K : Type*} [Field K] {m n : ℕ} (p : CriticalArcFibre K m n) :
    (X : (CriticalArcLaurentField K m n)[X]) ^ (m + n) ∣
      criticalArcFibreRawPolynomial p * criticalArcFibreReciprocalPolynomial p - 1 := by
  exact (dvd_criticalLowProduct_sub_one_iff_mul_sub_one
    (X_pow_dvd_criticalArcRawTail K m n)
    (X_pow_dvd_criticalArcReciprocalTail K m n) p.1.1 p.1.2).1 p.2.2.2

/-- The completed raw polynomial has no coefficients beyond the horizon. -/
theorem criticalArcFibreRawPolynomial_coeff_eq_zero_of_add_le
    {K : Type*} [Field K] {m n k : ℕ} (hn : 0 < n)
    (p : CriticalArcFibre K m n) (hk : m + n ≤ k) :
    (criticalArcFibreRawPolynomial p).coeff k = 0 := by
  have hA : p.1.1.coeff k = 0 :=
    (Polynomial.degree_lt_iff_coeff_zero p.1.1 m).mp p.2.1 k (by omega)
  rw [criticalArcFibreRawPolynomial, Polynomial.coeff_add, hA,
    criticalArcRawTail_coeff_eq_zero_of_add_le K hn hk, zero_add]

/-- Every coefficient of the completed raw polynomial belongs to the field generated by the raw
coordinates through the horizon. -/
theorem criticalArcFibreRawPolynomial_coeff_mem_adjoin
    {K : Type*} [Field K] {m n : ℕ} (hn : 0 < n)
    (p : CriticalArcFibre K m n) (k : ℕ) :
    (criticalArcFibreRawPolynomial p).coeff k ∈
      IntermediateField.adjoin K (Set.range (criticalArcFibreRawCoordinate p)) := by
  by_cases hk : k < m + n
  · exact IntermediateField.subset_adjoin K _
      ⟨(⟨k, hk⟩ : Fin (m + n)), rfl⟩
  · rw [criticalArcFibreRawPolynomial_coeff_eq_zero_of_add_le hn p
      (Nat.le_of_not_gt hk)]
    exact (IntermediateField.adjoin K _).zero_mem

/-- Each specialized raw observation lies in the field generated by the completed raw jet. -/
theorem criticalArcRawObservation_mem_fibreRaw_adjoin
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (p : CriticalArcFibre K m n) (i : Fin n) :
    criticalArcObservation K m n (Sum.inl i) ∈
      IntermediateField.adjoin K (Set.range (criticalArcFibreRawCoordinate p)) := by
  let j : Fin (m + n) := ⟨m + (i : ℕ), by omega⟩
  have hj := IntermediateField.subset_adjoin K
    (Set.range (criticalArcFibreRawCoordinate p))
    (Set.mem_range_self j)
  have hA : p.1.1.coeff (m + (i : ℕ)) = 0 :=
    (Polynomial.degree_lt_iff_coeff_zero p.1.1 m).mp p.2.1 _ (by omega)
  simpa [criticalArcFibreRawCoordinate, criticalArcFibreRawPolynomial, j, hA,
    criticalArcRawTail_coeff K hm hn, criticalObservationArcEmbedding_raw]
    using hj

/-- Each specialized reciprocal observation lies in the field generated by the completed raw
jet. -/
theorem criticalArcReciprocalObservation_mem_fibreRaw_adjoin
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (p : CriticalArcFibre K m n) (j : Fin m) :
    criticalArcObservation K m n (Sum.inr j) ∈
      IntermediateField.adjoin K (Set.range (criticalArcFibreRawCoordinate p)) := by
  let S := IntermediateField.adjoin K (Set.range (criticalArcFibreRawCoordinate p))
  have hcoeff := coeff_mem_intermediateField_of_dvd_truncated_inverse S
    (criticalArcFibre_truncated_inverse p)
    (criticalArcFibreRawPolynomial_coeff_mem_adjoin hn p)
    (n + (j : ℕ)) (by omega)
  have hB : p.1.2.coeff (n + (j : ℕ)) = 0 :=
    (Polynomial.degree_lt_iff_coeff_zero p.1.2 n).mp p.2.2.1 _ (by omega)
  simpa [S, criticalArcFibreReciprocalPolynomial, hB,
    criticalArcReciprocalTail_coeff K hm hn,
    criticalObservationArcEmbedding_recip] using hcoeff

/-- The completed raw jet of every exact arc-fibre point is algebraically independent over the
ground field. -/
theorem algebraicIndependent_criticalArcFibreRawCoordinate
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (p : CriticalArcFibre K m n) :
    AlgebraicIndependent K (criticalArcFibreRawCoordinate p) := by
  apply algebraicIndependent_of_independent_family_mem_adjoin
    (criticalArcFibreRawCoordinate p) (criticalArcObservation K m n)
    (algebraicIndependent_criticalArcObservation K m n)
  · intro s
    rcases s with i | j
    · exact criticalArcRawObservation_mem_fibreRaw_adjoin K hm hn p i
    · exact criticalArcReciprocalObservation_mem_fibreRaw_adjoin K hm hn p j
  · simp [add_comm]

end

end GaloisForLFunctions.HTGeometry
