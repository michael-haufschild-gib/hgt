import GaloisForLFunctions.HTGeometry.ModularCubicProjectionTransgression

/-!
# Source-frame modular holonomy

An invertible source density and an invertible completion frame need not commute. Their
multiplicative commutator is a nonabelian cocycle. It exactly measures the failure of inner source
modular transport to commute with completion framing, reverses to its inverse up to frame gauge,
and deforms the cubic projection extension seen by a source sigma-trace.

This is algebraic and pre-divisor: no spectrum, zero, positivity, order, or phase selection enters.
-/

namespace GaloisForLFunctions.HTGeometry

section Generic

variable {A G : Type*} [Ring A] [AddCommGroup G]

/-- Inner source modular action generated by an invertible source density. -/
def sourceModularAutomorphism (c : Aˣ) : A →+* A where
  toFun x := (↑(c⁻¹) : A) * x * (↑c : A)
  map_one' := by simp
  map_mul' x y := by simp [mul_assoc]
  map_zero' := by simp
  map_add' x y := by simp [mul_add, add_mul]

/-- Completion polarization transported by an invertible frame. -/
def sourceFramedElement (u : Aˣ) (x : A) : A :=
  (↑u : A) * x * (↑(u⁻¹) : A)

/-- Source-frame mismatch: multiplicative commutator of source density and completion frame. -/
def sourceFrameModularHolonomy (c u : Aˣ) : Aˣ :=
  c⁻¹ * u * c * u⁻¹

/-- The mismatch is a nonabelian cocycle under successive completion frames. -/
theorem sourceFrameModularHolonomy_mul (c u v : Aˣ) :
    sourceFrameModularHolonomy c (u * v) =
      sourceFrameModularHolonomy c u * u *
        sourceFrameModularHolonomy c v * u⁻¹ := by
  simp [sourceFrameModularHolonomy]
  group

/-- Reversing completion sends source-frame mismatch to its inverse, up to frame gauge. -/
theorem sourceFrameModularHolonomy_inv (c u : Aˣ) :
    sourceFrameModularHolonomy c u⁻¹ =
      u⁻¹ * (sourceFrameModularHolonomy c u)⁻¹ * u := by
  simp [sourceFrameModularHolonomy]
  group

/-- Holonomy is trivial exactly when source density and completion frame commute. -/
theorem sourceFrameModularHolonomy_eq_one_iff (c u : Aˣ) :
    sourceFrameModularHolonomy c u = 1 ↔ c * u = u * c := by
  constructor
  · intro h
    have h' : u * c = c * u := by
      calc
        u * c = c * sourceFrameModularHolonomy c u * u := by
          simp [sourceFrameModularHolonomy]
          group
        _ = c * 1 * u := by rw [h]
        _ = c * u := by simp
    exact h'.symm
  · intro h
    change c⁻¹ * u * c * u⁻¹ = 1
    rw [mul_assoc c⁻¹ u c, h.symm]
    simp

/-- Exact equivariance law: modular transport after framing equals holonomy conjugation of the
framed modular transport. No centralizer assumption is used. -/
theorem sourceModularAutomorphism_sourceFramedElement
    (c u : Aˣ) (x : A) :
    sourceModularAutomorphism c (sourceFramedElement u x) =
      sourceFramedElement (sourceFrameModularHolonomy c u)
        (sourceFramedElement u (sourceModularAutomorphism c x)) := by
  simp [sourceModularAutomorphism, sourceFramedElement,
    sourceFrameModularHolonomy, mul_assoc]

/-- Inner source transport preserves idempotents. -/
theorem sourceModularAutomorphism_idempotent
    (c : Aˣ) (x : A) (hx : x * x = x) :
    sourceModularAutomorphism c x * sourceModularAutomorphism c x =
      sourceModularAutomorphism c x := by
  simpa using (sourceModularAutomorphism c).map_mul x x ▸
    congrArg (sourceModularAutomorphism c) hx

/-- Completion framing preserves idempotents. -/
theorem sourceFramedElement_idempotent
    (u : Aˣ) (x : A) (hx : x * x = x) :
    sourceFramedElement u x * sourceFramedElement u x = sourceFramedElement u x := by
  simp only [sourceFramedElement, mul_assoc]
  simp
  rw [← mul_assoc, hx]

/-- Cubic defect of source modular transport relative to the completion frame and its neutral
reference polarization. -/
def sourceFrameCubicDefect (c u : Aˣ) (p : A) : A :=
  cubicProjectionAssociatorAlgebra
    (sourceModularAutomorphism c (sourceFramedElement u p))
    (sourceFramedElement u p) p

/-- Exact modular anomaly corresponding to the source-frame cubic defect. -/
def sourceFrameCubicAnomaly (c u : Aˣ) (p : A) : A :=
  cubicProjectionModularAnomaly (sourceModularAutomorphism c)
    (sourceModularAutomorphism c (sourceFramedElement u p))
    (sourceFramedElement u p) p

/-- **Source-frame cubic transgression.** A sigma-trace reads the holonomy-deformed completion
associator as one exact source modular anomaly. -/
theorem IsSigmaTrace.map_sourceFrameCubicDefect
    (c u : Aˣ) (p : A) (hp : p * p = p)
    (tau : A →+ G) (htau : IsSigmaTrace (sourceModularAutomorphism c) tau) :
    tau (sourceFrameCubicDefect c u p) =
      tau (sourceFrameCubicAnomaly c u p) := by
  apply htau.map_cubicProjectionAssociatorAlgebra
  · exact sourceModularAutomorphism_idempotent c _
      (sourceFramedElement_idempotent u p hp)
  · exact sourceFramedElement_idempotent u p hp
  · exact hp

/-- If source density commutes with completion frame and fixes the reference polarization, the
cubic source-frame defect vanishes. This closes central and prime-separable frames as producers. -/
theorem sourceFrameCubicDefect_eq_zero_of_central
    (c u : Aˣ) (p : A)
    (hcu : c * u = u * c)
    (hcp : sourceModularAutomorphism c p = p) :
    sourceFrameCubicDefect c u p = 0 := by
  have hhol : sourceFrameModularHolonomy c u = 1 :=
    (sourceFrameModularHolonomy_eq_one_iff c u).2 hcu
  have htransport :
      sourceModularAutomorphism c (sourceFramedElement u p) =
        sourceFramedElement u p := by
    calc
      sourceModularAutomorphism c (sourceFramedElement u p) =
          sourceFramedElement (sourceFrameModularHolonomy c u)
            (sourceFramedElement u (sourceModularAutomorphism c p)) :=
        sourceModularAutomorphism_sourceFramedElement c u p
      _ = sourceFramedElement u p := by rw [hcp, hhol]; simp [sourceFramedElement]
  rw [sourceFrameCubicDefect, htransport]
  simp [cubicProjectionAssociatorAlgebra]

end Generic

section Matrix

variable {K n : Type*} [CommRing K] [Fintype n] [DecidableEq n]

/-- Every finite matrix holonomy has determinant one. Thus finite determinant/K1 phase cannot read
the source-frame mismatch; any nonzero integer must be a relative cofinal boundary. -/
theorem det_sourceFrameModularHolonomy (c u : (Matrix n n K)ˣ) :
    Matrix.det (↑(sourceFrameModularHolonomy c u) : Matrix n n K) = 1 := by
  simp only [sourceFrameModularHolonomy, Units.val_mul, Matrix.det_mul]
  calc
    Matrix.det (↑(c⁻¹) : Matrix n n K) * Matrix.det (↑u : Matrix n n K) *
          Matrix.det (↑c : Matrix n n K) * Matrix.det (↑(u⁻¹) : Matrix n n K) =
        (Matrix.det (↑(c⁻¹) : Matrix n n K) * Matrix.det (↑c : Matrix n n K)) *
          (Matrix.det (↑u : Matrix n n K) * Matrix.det (↑(u⁻¹) : Matrix n n K)) := by
      ring
    _ = Matrix.det ((↑(c⁻¹) : Matrix n n K) * (↑c : Matrix n n K)) *
          Matrix.det ((↑u : Matrix n n K) * (↑(u⁻¹) : Matrix n n K)) := by
      rw [Matrix.det_mul, Matrix.det_mul]
    _ = 1 := by simp

end Matrix

end GaloisForLFunctions.HTGeometry
