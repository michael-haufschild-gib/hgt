import GaloisForLFunctions.HTGeometry.MultipleSineFaceLayer
import GaloisForLFunctions.HTGeometry.MultipleSineBoundaryFaceDA

/-!
# Joint independence of all proper multiple-sine face packets

Descending one layer at a time from the maximal faces, every layer is differentially independent
over the field generated by the deeper layers and the rational coordinates, and the boundary faces
contribute only differentially algebraic elements.  The union of the external packets of all faces
retaining at least two periods is therefore differentially independent over the rational coordinate
field — hence over the constants.
-/

open Filter Set Topology Complex
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open GaloisForLFunctions.MatroidGluing GaloisForLFunctions.MatroidGluing.Rank

noncomputable section

noncomputable local instance msapfDecidableEq :
    DecidableEq (meroField (Set.univ : Set ℂ)) := Classical.decEq _

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ### Atomicity of a single face of the layer -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 1000000 in
/-- **A face of the layer is atomic over the deeper field.**  Two of its surviving directions carry
the rank-two difference system, and the palette of the next face down is free over the complementary
base. -/
theorem sineLayerFace_diffIndepOn_deeper {μ : ℂ} {rad : ι → ℝ} (hrad : ∀ k, 0 < rad k)
    (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im)
    (N B : Set (Finset ι)) (hNfaces : ∀ L ∈ N, 2 ≤ (Lᶜ : Finset ι).card)
    (hBfaces : ∀ L ∈ B, (Lᶜ : Finset ι).card < 2)
    (hS : ∀ L ∈ N ∪ B, ∀ p : ι, p ∉ L → insert p L ∈ N ∪ B)
    (hdeep : DiffIndepOn ↥meromorphicRationalCoordinateField
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N))
    (J : Finset ι) (h3 : 3 ≤ (Jᶜ : Finset ι).card) (hJS : J ∉ N ∪ B)
    (hcoface : ∀ p : ι, p ∉ J → insert p J ∈ N) :
    DiffIndepOn
      ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω (N ∪ B)))
      (facePacket (fun k => μ * (rad k : ℂ)) hω J) := by
  classical
  obtain ⟨P, hPsub, hPcard⟩ := Finset.exists_subset_card_eq (show 2 ≤ (Jᶜ : Finset ι).card by omega)
  obtain ⟨q, u, hqu, hP⟩ := Finset.card_eq_two.mp hPcard
  have hqJ : q ∉ J := Finset.mem_compl.mp (hPsub (by rw [hP]; simp))
  have huJ : u ∉ J := Finset.mem_compl.mp (hPsub (by rw [hP]; simp))
  have h2 : 2 ≤ (Jᶜ : Finset ι).card := by omega
  have hne : (Jᶜ : Finset ι).Nonempty := Finset.card_pos.mp (by omega)
  have hstep := face_compl_card_insert_add_one J hqJ
  have hqu2 : 2 ≤ ((insert q J)ᶜ : Finset ι).card := by omega
  have hne' : ((insert q J)ᶜ : Finset ι).Nonempty := Finset.card_pos.mp (by omega)
  have hqN : insert q J ∈ N := hcoface q hqJ
  have huN : insert u J ∈ N := hcoface u huJ
  have hqB : insert q J ∉ B := by
    intro hcon
    have := hBfaces _ hcon
    omega
  have hμ : μ ≠ 0 := by
    intro hzero
    have hpos := hω q
    rw [hzero] at hpos
    simp at hpos
  have hirr : Irrational (rad q / rad u) :=
    irrational_ratio_of_linearIndependent_ray hrad hind hqu
  have hindep := sineFacePalette_differentialIndependent_of_deeper_with_boundary hrad hind hω
    N B hNfaces
    (fun L hL y hy => differentialAlgebraicOver_facePacket_of_compl_lt_two
      (fun k => μ * (rad k : ℂ)) hω (hBfaces L hL) hy)
    hdeep J hqN hqB
  exact sineFacePacket_differentialIndependent_of_free hrad hind hω hS J hqJ huJ
    (Or.inl hqN) (Or.inl huN) hJS h2 hne hne' hqu2 hμ rfl rfl hirr hindep

/-! ### One layer of the descending induction -/

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- **One descending step.**  The layer whose faces retain `k + 3` periods is jointly independent
over the field generated by the deeper layers, the boundary faces and the rational coordinates. -/
theorem sineFaceLayer_diffIndepOn_deeper {μ : ℂ} {rad : ι → ℝ} (hrad : ∀ k, 0 < rad k)
    (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im) (k : ℕ)
    (hdeep : DiffIndepOn ↥meromorphicRationalCoordinateField
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω (sineDeeperFaces ι (k + 1)))) :
    DiffIndepOn
      ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω
        (sineDeeperFaces ι (k + 1) ∪ sineBoundaryFaces ι)))
      (faceStar (sineFaceLayer ι (k + 1)) (facePacket (fun k => μ * (rad k : ℂ)) hω) ∅) := by
  classical
  have hNfaces : ∀ L ∈ sineDeeperFaces ι (k + 1), 2 ≤ (Lᶜ : Finset ι).card := fun L hL => hL.1
  have hBfaces : ∀ L ∈ sineBoundaryFaces ι, (Lᶜ : Finset ι).card < 2 := fun L hL => hL
  have hS : ∀ L ∈ sineDeeperFaces ι (k + 1) ∪ sineBoundaryFaces ι, ∀ p : ι, p ∉ L →
      insert p L ∈ sineDeeperFaces ι (k + 1) ∪ sineBoundaryFaces ι := by
    intro L hL p hp
    have hcard := face_compl_card_insert_add_one L hp
    have hlt : ((insert p L)ᶜ : Finset ι).card < k + 3 := by
      rcases hL with hLN | hLB
      · have h2 := hLN.2
        omega
      · have h2 : (Lᶜ : Finset ι).card < 2 := hLB
        omega
    by_cases hb : ((insert p L)ᶜ : Finset ι).card < 2
    · exact Or.inr hb
    · refine Or.inl ⟨by omega, by omega⟩
  have hfaces : ∀ J ∈ sineFaceLayer ι (k + 1), 3 ≤ (Jᶜ : Finset ι).card := by
    intro J hJ
    have hc := (mem_sineFaceLayer_iff J).mp hJ
    omega
  have hcoface : ∀ J ∈ sineFaceLayer ι (k + 1), ∀ p : ι, p ∉ J →
      insert p J ∈ sineDeeperFaces ι (k + 1) := by
    intro J hJ p hp
    have hcomp := (mem_sineFaceLayer_iff J).mp hJ
    have hcard := face_compl_card_insert_add_one J hp
    exact ⟨by omega, by omega⟩
  refine sineFaceStar_diffIndepOn_deeper hrad hind hω hS (sineFaceLayer ι (k + 1))
    (Fintype.card ι - (k + 3)) (fun J hJ => card_of_mem_sineFaceLayer hJ)
    (fun J hJ => by have hc := hfaces J hJ; omega)
    (fun J hJ p hp => Or.inl (hcoface J hJ p hp)) ?_
  intro J hJ
  refine sineLayerFace_diffIndepOn_deeper hrad hind hω (sineDeeperFaces ι (k + 1))
    (sineBoundaryFaces ι) hNfaces hBfaces hS hdeep J (hfaces J hJ) ?_ (hcoface J hJ)
  intro hcon
  have hcomp := (mem_sineFaceLayer_iff J).mp hJ
  rcases hcon with hJN | hJB
  · have h2 := hJN.2
    omega
  · have h2 : (Jᶜ : Finset ι).card < 2 := hJB
    omega

/-! ### Removing the boundary and the rational base -/

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- Independence over the deeper field with boundary is independence over the deeper field of the
non-boundary faces alone. -/
theorem sineFaceLayer_diffIndepOn_rationalBase {μ : ℂ} {rad : ι → ℝ}
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im) (N B : Set (Finset ι))
    (hBfaces : ∀ L ∈ B, (Lᶜ : Finset ι).card < 2)
    {I : Set (meroField (Set.univ : Set ℂ))}
    (hlayer : DiffIndepOn
      ↥(differentialAdjoin ℂ (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω (N ∪ B))) I) :
    DiffIndepOn ↥(differentialAdjoin ↥meromorphicRationalCoordinateField
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N)) I := by
  classical
  haveI : DifferentialAlgebra
      ↥(differentialAdjoin ↥meromorphicRationalCoordinateField
        (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N))
      (meroField (Set.univ : Set ℂ)) :=
    ⟨fun x => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin ↥meromorphicRationalCoordinateField
        (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N)) x⟩
  have hgen : sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω (N ∪ B)
      = (meromorphicRationalCoordinateField : Set (meroField (Set.univ : Set ℂ)))
        ∪ (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N
          ∪ sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω B) := by
    rw [sineDeeperGenerators, sineFacePacketUnion_union]
    exact Set.union_comm _ _
  have hcarrier : ((differentialAdjoin ℂ
        (sineDeeperGenerators (fun k => μ * (rad k : ℂ)) hω (N ∪ B)) :
      IntermediateField ℂ (meroField (Set.univ : Set ℂ))) : Set (meroField (Set.univ : Set ℂ)))
      = ((differentialAdjoin
          ↥(differentialAdjoin ↥meromorphicRationalCoordinateField
            (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N))
          (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω B) :
        IntermediateField _ (meroField (Set.univ : Set ℂ))) :
        Set (meroField (Set.univ : Set ℂ))) := by
    rw [coe_differentialAdjoin_differentialAdjoin,
      coe_differentialAdjoin_base meromorphicRationalCoordinateField_derivationClosed, hgen]
  have hnested : DiffIndepOn
      ↥(differentialAdjoin
        ↥(differentialAdjoin ↥meromorphicRationalCoordinateField
          (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N))
        (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω B)) I :=
    differentialIndependent_of_coe_eq hcarrier hlayer
  have hBDA : ∀ y ∈ sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω B,
      DifferentialAlgebraicOver
        ↥(differentialAdjoin ↥meromorphicRationalCoordinateField
          (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω N)) y := by
    intro y hy
    obtain ⟨L, hLB, hyL⟩ := Set.mem_iUnion₂.mp hy
    have hdaC := differentialAlgebraicOver_facePacket_of_compl_lt_two
      (fun k => μ * (rad k : ℂ)) hω (hBfaces L hLB) hyL
    have hdaK : DifferentialAlgebraicOver ↥meromorphicRationalCoordinateField y :=
      differentialAlgebraicOver_meromorphicRationalCoordinateField_iff.mpr hdaC
    exact differentialAlgebraicOver_mono hdaK
  exact (diffIndepOn_differentialAdjoin_iff_of_differentialAlgebraicOver hBDA).mp hnested

/-! ### The descending induction -/

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- **All layers.**  Every initial family of face layers is jointly differentially independent over
the rational coordinate field. -/
theorem multipleSineDeeperFaces_diffIndepOn {μ : ℂ} {rad : ι → ℝ} (hrad : ∀ k, 0 < rad k)
    (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im) :
    ∀ k : ℕ, DiffIndepOn ↥meromorphicRationalCoordinateField
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω (sineDeeperFaces ι (k + 1))) := by
  classical
  intro k
  induction k with
  | zero =>
      have hset : sineDeeperFaces ι 1 = (↑(maximalFaces ι) : Set (Finset ι)) := by
        rw [sineDeeperFaces_succ, sineDeeperFaces_zero, Set.empty_union,
          sineFaceLayer_zero_eq_maximalFaces]
      rw [hset, ← faceStar_empty_eq_sineFacePacketUnion]
      exact multipleSineMaximalFaces_diffIndepOn_rationalBase hrad hind hω
  | succ k ih =>
      have hlayer := sineFaceLayer_diffIndepOn_deeper hrad hind hω k ih
      rw [faceStar_empty_eq_sineFacePacketUnion] at hlayer
      have hbase := sineFaceLayer_diffIndepOn_rationalBase hω
        (sineDeeperFaces ι (k + 1)) (sineBoundaryFaces ι) (fun L hL => hL) hlayer
      have hunion := diffIndepOn_union_of_base ih hbase
      rw [sineDeeperFaces_succ, sineFacePacketUnion_union, Set.union_comm]
      exact hunion

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- **All proper face packets are jointly differentially independent.**  For a ray period family
with rationally independent radii, the union of the external translation packets of every face
retaining at least two periods is differentially independent over the rational coordinate field. -/
theorem multipleSineProperFacePackets_diffIndepOn_rationalBase {μ : ℂ} {rad : ι → ℝ}
    (hrad : ∀ k, 0 < rad k) (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im) :
    DiffIndepOn ↥meromorphicRationalCoordinateField
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω {J : Finset ι | 2 ≤ (Jᶜ).card}) := by
  classical
  have hfinal := multipleSineDeeperFaces_diffIndepOn hrad hind hω (Fintype.card ι)
  have hset : sineDeeperFaces ι (Fintype.card ι + 1) = {J : Finset ι | 2 ≤ (Jᶜ).card} := by
    ext J
    simp only [sineDeeperFaces, Set.mem_setOf_eq]
    have hcardle : (Jᶜ : Finset ι).card ≤ Fintype.card ι := Finset.card_le_univ _
    exact ⟨fun h => h.1, fun h => ⟨h, by omega⟩⟩
  rwa [hset] at hfinal

set_option maxHeartbeats 2000000 in
set_option synthInstance.maxHeartbeats 1200000 in
/-- **All proper face packets are jointly differentially independent over the constants.** -/
theorem multipleSineProperFacePackets_diffIndepOn {μ : ℂ} {rad : ι → ℝ}
    (hrad : ∀ k, 0 < rad k) (hind : LinearIndependent ℚ (fun k => μ * (rad k : ℂ)))
    (hω : ∀ k, 0 < (μ * (rad k : ℂ)).im) :
    DiffIndepOn ℂ
      (sineFacePacketUnion (fun k => μ * (rad k : ℂ)) hω {J : Finset ι | 2 ≤ (Jᶜ).card}) := by
  have h := multipleSineProperFacePackets_diffIndepOn_rationalBase hrad hind hω
  exact HTGeometry.DifferentialIndependent.restrictScalarsTower h

end

