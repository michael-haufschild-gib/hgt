import GaloisForLFunctions.HTGeometry.GammaFieldAutonomousOrder
import GaloisForLFunctions.HTGeometry.FiniteFieldGeneratorIndependence
import GaloisForLFunctions.HTGeometry.MeromorphicRealizationDerivative
import GaloisForLFunctions.HTGeometry.DerivationBellChain

/-!
# Exact Gamma-relative differential order of finite Euler data

This module realizes finite Euler anchor, reciprocal product, and logarithmic flux inside the
upper-end meromorphic germ field. Coefficients lie in the differential field generated by the
rational coordinate and the Gamma germ. A weighted Vandermonde Jacobian proves independence of
the first `|S|` flux jets; finite derivation-closed state generation supplies the matching relation.
All three observables therefore have unconditional exact differential order `|S|`.
-/

open Complex Set Filter Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance finiteEulerGammaDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring
local instance finiteEulerGammaIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _
local instance finiteEulerGammaDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential
local instance finiteEulerGammaComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra
local instance finiteEulerGammaRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra
local instance finiteEulerGammaRatDiff : Differential (RatFunc ℂ) := ratFuncCoordinateDifferential
local instance finiteEulerGammaRatDiffAlg : DifferentialAlgebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncDifferentialAlgebra

abbrev finiteEulerGammaCoefficientField : IntermediateField (RatFunc ℂ) upperEndMeroField :=
  differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField)

local instance finiteEulerGammaDiffAlg :
    DifferentialAlgebra ↥finiteEulerGammaCoefficientField upperEndMeroField where
  deriv_algebraMap _ := rfl

def GammaMeroRelationAtOrder (u : upperEndMeroField) (n : ℕ) : Prop :=
  ¬ AlgebraicIndependent ↥finiteEulerGammaCoefficientField
    (fun i : Fin (n + 1) => differentialJet (i : ℕ) u)

theorem exists_fin_jet_monomial_relation_of_not_algebraicIndependent
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    {u : K} {n : ℕ}
    (h : ¬ AlgebraicIndependent F
      (fun i : Fin (n + 1) => differentialJet (i : ℕ) u)) :
    ∃ N : ℕ, 0 < N ∧ ∃ (e : Fin N → Fin (n + 1) → ℕ), Function.Injective e ∧
      ∃ c : Fin N → F, (∀ α, c α ≠ 0) ∧
        ∑ α : Fin N, algebraMap F K (c α) *
          ∏ i : Fin (n + 1), (differentialJet (i : ℕ) u) ^ (e α i) = 0 := by
  classical
  rw [algebraicIndependent_iff_injective_aeval] at h
  obtain ⟨Q₁, Q₂, hEq, hne⟩ := Function.not_injective_iff.mp h
  let Q : MvPolynomial (Fin (n + 1)) F := Q₁ - Q₂
  have hQ0 : Q ≠ 0 := sub_ne_zero.mpr hne
  have hQeval : MvPolynomial.aeval
      (fun i : Fin (n + 1) => differentialJet (i : ℕ) u) Q = 0 := by
    simp only [Q, map_sub, hEq, sub_self]
  let N : ℕ := Q.support.card
  let d : Fin N → (Fin (n + 1) →₀ ℕ) := fun α =>
    ((Q.support.equivFin.symm α : {m // m ∈ Q.support}) : Fin (n + 1) →₀ ℕ)
  let e : Fin N → Fin (n + 1) → ℕ := fun α i => d α i
  let c : Fin N → F := fun α => Q.coeff (d α)
  have hsupp : Q.support.Nonempty := by
    by_contra hempty
    apply hQ0
    rw [← MvPolynomial.support_eq_empty]
    exact Finset.not_nonempty_iff_eq_empty.mp hempty
  have hN : 0 < N := Finset.card_pos.mpr hsupp
  refine ⟨N, hN, e, ?_, c, ?_, ?_⟩
  · intro α β hαβ
    apply Q.support.equivFin.symm.injective
    apply Subtype.ext
    apply Finsupp.ext
    intro i
    exact congrFun hαβ i
  · intro α
    exact MvPolynomial.mem_support_iff.mp (Q.support.equivFin.symm α).2
  · let y : Fin (n + 1) → K := fun i => differentialJet (i : ℕ) u
    dsimp [c, e, d, N]
    calc
      (∑ α : Fin Q.support.card,
          algebraMap F K
            (Q.coeff ((Q.support.equivFin.symm α : {m // m ∈ Q.support}) :
              Fin (n + 1) →₀ ℕ)) *
          ∏ i : Fin (n + 1), y i ^
            (((Q.support.equivFin.symm α : {m // m ∈ Q.support}) :
              Fin (n + 1) →₀ ℕ) i)) =
          ∑ m ∈ Q.support, algebraMap F K (Q.coeff m) *
            ∏ i : Fin (n + 1), y i ^ m i := by
        rw [← Finset.sum_attach Q.support]
        refine Fintype.sum_equiv Q.support.equivFin.symm _ _ fun α => ?_
        rfl
      _ = MvPolynomial.eval₂ (algebraMap F K) y Q := by
        rw [MvPolynomial.eval₂_eq]
        apply Finset.sum_congr rfl
        intro m hm
        congr 1
        exact (Finsupp.prod_fintype m (fun i k => y i ^ k)
          (fun i => pow_zero (y i))).symm
      _ = 0 := by simpa [MvPolynomial.aeval_def] using hQeval

theorem gammaFieldRelationAtOrder_of_gammaMeroRelation {n : ℕ} (Psi : upperEndAnalyticSubring)
    (h : GammaMeroRelationAtOrder
      (algebraMap upperEndAnalyticSubring upperEndMeroField Psi) n) :
    GammaFieldRelationAtOrder Psi n := by
  obtain ⟨N, hN, e, he, c, hc, hzero⟩ :=
    exists_fin_jet_monomial_relation_of_not_algebraicIndependent h
  refine ⟨N, hN, e, he,
    fun α => algebraMap ↥finiteEulerGammaCoefficientField upperEndMeroField (c α), ?_, ?_, hzero⟩
  · intro α
    exact (c α).2
  · intro α hzero
    apply hc α
    apply (algebraMap ↥finiteEulerGammaCoefficientField upperEndMeroField).injective
    simpa using hzero

def finitePrimeEulerMeroState (S : Finset Nat.Primes) (i : Fin (Fintype.card ↥S)) :
    upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField
    (expLineUpperAnalytic (finitePrimeFrequency S i))

def finiteEulerAnchorMero (S : Finset Nat.Primes) : upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField
    (finiteEulerAnchorUpperEndAnalytic S)

theorem finiteEulerGamma_state_identity (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) (s : ℂ) :
    finitePrimeDamping S i *
        phasePoint (finitePrimeFrequency S) (-Complex.I * (s - 1)) i =
      expLine (finitePrimeFrequency S i) s := by
  unfold phasePoint expLine
  have hp : (0 : ℝ) < (((finitePrimeAt S i : Nat.Primes) : ℕ) : ℝ) := by
    exact_mod_cast (finitePrimeAt S i).2.pos
  have hdamp : finitePrimeDamping S i =
      Complex.exp (finitePrimeFrequency S i : ℂ) := by
    simp only [finitePrimeDamping, finitePrimeFrequency]
    rw [show ((-Real.log (((finitePrimeAt S i : Nat.Primes) : ℕ) : ℝ) : ℝ) : ℂ) =
        -((Real.log (((finitePrimeAt S i : Nat.Primes) : ℕ) : ℝ) : ℝ) : ℂ) by
          push_cast; rfl,
      Complex.exp_neg]
    congr 1
    rw [← Complex.ofReal_exp, Real.exp_log hp]
    norm_cast
  rw [hdamp, ← Complex.exp_add]
  congr 1
  ring_nf
  norm_num

theorem finiteEulerGamma_anchor_identity (S : Finset Nat.Primes) (s : ℂ) :
    finiteEulerAnchorEntire S s =
      ∏ i : Fin (Fintype.card ↥S),
        (1 - expLine (finitePrimeFrequency S i) s) := by
  unfold finiteEulerAnchorEntire finiteEulerCharacteristicDet
  rw [finiteEulerCharacteristicMatrix, Matrix.det_diagonal]
  apply Finset.prod_congr rfl
  intro i hi
  rw [finiteEulerGamma_state_identity]

theorem finiteEulerGamma_anchor_germ_identity (S : Finset Nat.Primes) :
    finiteEulerAnchorUpperEndAnalytic S =
      ∏ i : Fin (Fintype.card ↥S),
        (1 - expLineUpperAnalytic (finitePrimeFrequency S i)) := by
  apply Subtype.ext
  change upperEndAnalyticSubring.subtype (finiteEulerAnchorUpperEndAnalytic S) =
    upperEndAnalyticSubring.subtype
      (∏ i : Fin (Fintype.card ↥S),
        (1 - expLineUpperAnalytic (finitePrimeFrequency S i)))
  rw [finiteEulerAnchorUpperEndAnalytic_repr, map_prod]
  simp only [map_sub, map_one, expLineUpperAnalytic_subtype]
  calc
    (Germ.coeRingHom upperEndFilter) (finiteEulerAnchorEntire S) =
        (Germ.coeRingHom upperEndFilter)
          (fun s : ℂ => ∏ i : Fin (Fintype.card ↥S),
            (1 - expLine (finitePrimeFrequency S i) s)) := by
      apply Germ.coe_eq.mpr
      filter_upwards with s
      exact finiteEulerGamma_anchor_identity S s
    _ = (Germ.coeRingHom upperEndFilter)
        (∏ i : Fin (Fintype.card ↥S),
          (fun s : ℂ => 1 - expLine (finitePrimeFrequency S i) s)) := by
      congr 1
      funext s
      simp
    _ = ∏ i : Fin (Fintype.card ↥S),
        (Germ.coeRingHom upperEndFilter)
          (fun s : ℂ => 1 - expLine (finitePrimeFrequency S i) s) := by
      exact map_prod (Germ.coeRingHom upperEndFilter)
        (fun i : Fin (Fintype.card ↥S) =>
          (fun s : ℂ => 1 - expLine (finitePrimeFrequency S i) s)) Finset.univ
    _ = ∏ i : Fin (Fintype.card ↥S),
        (1 - (Germ.coeRingHom upperEndFilter)
          (expLine (finitePrimeFrequency S i))) := by
      apply Finset.prod_congr rfl
      intro i hi
      change (Germ.coeRingHom upperEndFilter)
          ((1 : ℂ → ℂ) - expLine (finitePrimeFrequency S i)) = _
      rw [map_sub, map_one]

theorem finiteEulerGamma_anchor_eq_prod_state (S : Finset Nat.Primes) :
    finiteEulerAnchorMero S =
      ∏ i : Fin (Fintype.card ↥S), (1 - finitePrimeEulerMeroState S i) := by
  rw [finiteEulerAnchorMero, finiteEulerGamma_anchor_germ_identity, map_prod]
  apply Finset.prod_congr rfl
  intro i hi
  rw [map_sub, map_one]
  rfl

theorem finiteEulerGamma_state_deriv_mem (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) :
    (finitePrimeEulerMeroState S i)′ ∈
      IntermediateField.adjoin ↥finiteEulerGammaCoefficientField (Set.range (finitePrimeEulerMeroState S)) := by
  change differentialJet 1
      (algebraMap upperEndAnalyticSubring upperEndMeroField
        (expLineUpperAnalytic (finitePrimeFrequency S i))) ∈ _
  rw [differentialJet_one_expLine]
  apply IntermediateField.mul_mem
  · exact IntermediateField.algebraMap_mem _
      (⟨upperEndComplexToMero (finitePrimeFrequency S i : ℂ),
        upperEndComplexToMero_mem_gammaAdjoin _⟩ : ↥finiteEulerGammaCoefficientField)
  · exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)

theorem finiteEulerGamma_anchor_mem_state_adjoin (S : Finset Nat.Primes) :
    finiteEulerAnchorMero S ∈
      IntermediateField.adjoin ↥finiteEulerGammaCoefficientField (Set.range (finitePrimeEulerMeroState S)) := by
  rw [finiteEulerGamma_anchor_eq_prod_state]
  apply IntermediateField.prod_mem
  intro i hi
  exact IntermediateField.sub_mem _ (IntermediateField.one_mem _)
    (IntermediateField.subset_adjoin _ _ (Set.mem_range_self i))

theorem finiteEulerGamma_anchor_initial_jets_ai (S : Finset Nat.Primes) :
    AlgebraicIndependent ↥finiteEulerGammaCoefficientField
      (fun i : Fin (Fintype.card ↥S) => differentialJet (i : ℕ) (finiteEulerAnchorMero S)) := by
  by_cases hk : Fintype.card ↥S = 0
  · rw [hk]
    exact algebraicIndependent_empty_type
  · obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hk
    rw [hn]
    by_contra hdep
    have hrel : GammaMeroRelationAtOrder (finiteEulerAnchorMero S) n := by
      simpa [GammaMeroRelationAtOrder, finiteEulerAnchorMero] using hdep
    have hg := gammaFieldRelationAtOrder_of_gammaMeroRelation (finiteEulerAnchorUpperEndAnalytic S)
      (by simpa [finiteEulerAnchorMero] using hrel)
    have hle := gammaFieldMinimalOrder_le hg
    rw [gammaFieldMinimalOrder_finiteEulerAnchorEntire_eq, hn] at hle
    omega

theorem finiteEulerGamma_state_ai (S : Finset Nat.Primes) :
    AlgebraicIndependent ↥finiteEulerGammaCoefficientField (finitePrimeEulerMeroState S) := by
  let M := IntermediateField.adjoin ↥finiteEulerGammaCoefficientField (Set.range (finitePrimeEulerMeroState S))
  have hclosed : DerivationClosed M :=
    derivationClosed_adjoin_range_of_deriv_mem (finitePrimeEulerMeroState S) (finiteEulerGamma_state_deriv_mem S)
  let y : Fin (Fintype.card ↥S) → upperEndMeroField := fun i =>
    differentialJet (i : ℕ) (finiteEulerAnchorMero S)
  have hy : AlgebraicIndependent ↥finiteEulerGammaCoefficientField y :=
    finiteEulerGamma_anchor_initial_jets_ai S
  have hymem : ∀ i, y i ∈ M := by
    intro i
    exact differentialJet_mem_of_derivationClosed hclosed (i : ℕ)
      (finiteEulerGamma_anchor_mem_state_adjoin S)
  exact algebraicIndependent_of_independent_family_mem_adjoin
    (finitePrimeEulerMeroState S) y hy hymem rfl

theorem finiteEulerGamma_anchor_ne_zero (S : Finset Nat.Primes) : finiteEulerAnchorMero S ≠ 0 := by
  rw [finiteEulerGamma_anchor_eq_prod_state]
  apply Finset.prod_ne_zero_iff.mpr
  intro i hi
  apply sub_ne_zero.mpr
  intro hone
  exact (finiteEulerGamma_state_ai S).transcendental i (by
    rw [← hone]
    exact isAlgebraic_one)

def gammaMeroMinimalOrder (u : upperEndMeroField) : ℕ :=
  sInf {n | GammaMeroRelationAtOrder u n}

theorem finiteEulerGamma_minimal_anchor (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerAnchorMero S) = Fintype.card ↥S := by
  have hu : GammaMeroRelationAtOrder (finiteEulerAnchorMero S) (Fintype.card ↥S) := by
    change ¬ AlgebraicIndependent ↥finiteEulerGammaCoefficientField
      (fun i : Fin (Fintype.card ↥S + 1) =>
        differentialJet (i : ℕ) (finiteEulerAnchorMero S))
    have hdep := not_algebraicIndependent_jets_of_mem_finite_derivationClosed_state
      (finitePrimeEulerMeroState S) (finiteEulerGamma_state_deriv_mem S) (finiteEulerGamma_anchor_mem_state_adjoin S)
    have hcard : Fintype.card (Fin (Fintype.card ↥S)) = Fintype.card ↥S :=
      Fintype.card_fin _
    rw [hcard] at hdep
    exact hdep
  apply le_antisymm (Nat.sInf_le hu)
  have hmin : GammaMeroRelationAtOrder (finiteEulerAnchorMero S) (gammaMeroMinimalOrder (finiteEulerAnchorMero S)) := by
    change sInf {n | GammaMeroRelationAtOrder (finiteEulerAnchorMero S) n} ∈
      {n | GammaMeroRelationAtOrder (finiteEulerAnchorMero S) n}
    apply Nat.sInf_mem
    exact ⟨Fintype.card ↥S, hu⟩
  have hg := gammaFieldRelationAtOrder_of_gammaMeroRelation (finiteEulerAnchorUpperEndAnalytic S)
    (by simpa [finiteEulerAnchorMero] using hmin)
  have hle := gammaFieldMinimalOrder_le hg
  rw [gammaFieldMinimalOrder_finiteEulerAnchorEntire_eq] at hle
  exact hle

theorem finiteEulerGamma_minimal_inv_eq {u : upperEndMeroField} (hu : u ≠ 0) :
    gammaMeroMinimalOrder u⁻¹ = gammaMeroMinimalOrder u := by
  unfold gammaMeroMinimalOrder
  congr 1
  ext n
  exact not_congr (algebraicIndependent_fin_jets_inv_iff hu n)

theorem finiteEulerGamma_minimal_product (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerAnchorMero S)⁻¹ = Fintype.card ↥S := by
  rw [finiteEulerGamma_minimal_inv_eq (finiteEulerGamma_anchor_ne_zero S), finiteEulerGamma_minimal_anchor]

/-- Meromorphic finite Euler product, reciprocal to its determinant anchor. -/
def finiteEulerProductMero (S : Finset Nat.Primes) : upperEndMeroField :=
  (finiteEulerAnchorMero S)⁻¹

/-- Exact Gamma-relative differential order of the finite Euler determinant anchor. -/
theorem gammaMeroMinimalOrder_finiteEulerAnchor_eq (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerAnchorMero S) = Fintype.card ↥S :=
  finiteEulerGamma_minimal_anchor S

/-- Exact Gamma-relative differential order of the finite Euler product. -/
theorem gammaMeroMinimalOrder_finiteEulerProduct_eq (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerProductMero S) = Fintype.card ↥S := by
  simpa [finiteEulerProductMero] using finiteEulerGamma_minimal_product S

def finitePrimeEulerLogState (S : Finset Nat.Primes) (i : Fin (Fintype.card ↥S)) :
    upperEndMeroField :=
  finitePrimeEulerMeroState S i / (1 - finitePrimeEulerMeroState S i)

theorem finiteEulerGamma_one_sub_state_ne_zero (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) : 1 - finitePrimeEulerMeroState S i ≠ 0 := by
  apply sub_ne_zero.mpr
  intro hone
  exact (finiteEulerGamma_state_ai S).transcendental i (by
    rw [← hone]
    exact isAlgebraic_one)

theorem finiteEulerGamma_state_eq_logState_div (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) :
    finitePrimeEulerMeroState S i = finitePrimeEulerLogState S i / (1 + finitePrimeEulerLogState S i) := by
  rw [finitePrimeEulerLogState]
  field_simp [finiteEulerGamma_one_sub_state_ne_zero S i]
  ring

theorem finiteEulerGamma_logState_ai (S : Finset Nat.Primes) :
    AlgebraicIndependent ↥finiteEulerGammaCoefficientField (finitePrimeEulerLogState S) := by
  apply algebraicIndependent_of_independent_family_mem_adjoin
    (finitePrimeEulerLogState S) (finitePrimeEulerMeroState S) (finiteEulerGamma_state_ai S)
  · intro i
    rw [finiteEulerGamma_state_eq_logState_div S i]
    apply IntermediateField.div_mem
    · exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
    · exact IntermediateField.add_mem _ (IntermediateField.one_mem _)
        (IntermediateField.subset_adjoin _ _ (Set.mem_range_self i))
  · rfl

theorem finiteEulerGamma_logState_deriv (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) :
    (finitePrimeEulerLogState S i)′ =
      upperEndComplexToMero (finitePrimeFrequency S i : ℂ) *
        finitePrimeEulerLogState S i * (1 + finitePrimeEulerLogState S i) := by
  let x := finitePrimeEulerMeroState S i
  let mu := upperEndComplexToMero (finitePrimeFrequency S i : ℂ)
  have hx0 : 1 - x ≠ 0 := finiteEulerGamma_one_sub_state_ne_zero S i
  have hdx : x′ = mu * x := by
    dsimp [x, mu, finitePrimeEulerMeroState]
    change differentialJet 1
      (algebraMap upperEndAnalyticSubring upperEndMeroField
        (expLineUpperAnalytic (finitePrimeFrequency S i))) = _
    exact differentialJet_one_expLine _
  change (x / (1 - x))′ = mu * (x / (1 - x)) * (1 + x / (1 - x))
  rw [differential_deriv_div x (1 - x) hx0]
  have hden : (1 - x)′ = -x′ := by
    simp
  rw [hden, hdx]
  field_simp [hx0]
  ring

theorem finiteEulerGamma_logState_deriv_mem (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) :
    (finitePrimeEulerLogState S i)′ ∈
      IntermediateField.adjoin ↥finiteEulerGammaCoefficientField (Set.range (finitePrimeEulerLogState S)) := by
  rw [finiteEulerGamma_logState_deriv]
  apply IntermediateField.mul_mem
  · apply IntermediateField.mul_mem
    · exact IntermediateField.algebraMap_mem _
        (⟨upperEndComplexToMero (finitePrimeFrequency S i : ℂ),
          upperEndComplexToMero_mem_gammaAdjoin _⟩ : ↥finiteEulerGammaCoefficientField)
    · exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
  · exact IntermediateField.add_mem _ (IntermediateField.one_mem _)
      (IntermediateField.subset_adjoin _ _ (Set.mem_range_self i))

def logisticPolynomialDerivation {d K : Type*} [Fintype d] [DecidableEq d]
    [CommRing K] (mu : d → K) (Q : MvPolynomial d K) : MvPolynomial d K :=
  ∑ i, MvPolynomial.C (mu i) * MvPolynomial.X i * (1 + MvPolynomial.X i) *
    MvPolynomial.pderiv i Q

theorem eval_zero_pderiv_logisticPolynomialDerivation
    {d K : Type*} [Fintype d] [DecidableEq d] [Field K]
    (mu : d → K) (Q : MvPolynomial d K) (i : d) :
    MvPolynomial.eval (0 : d → K)
        (MvPolynomial.pderiv i (logisticPolynomialDerivation mu Q)) =
      mu i * MvPolynomial.eval 0 (MvPolynomial.pderiv i Q) := by
  classical
  rw [logisticPolynomialDerivation, map_sum, MvPolynomial.eval_sum]
  rw [Finset.sum_eq_single i]
  · simp [Derivation.leibniz]
    ring
  · intro j hj hji
    simp [Derivation.leibniz, hji]
  · simp

theorem eval_zero_pderiv_iterate_logisticPolynomialDerivation
    {d K : Type*} [Fintype d] [DecidableEq d] [Field K]
    (mu : d → K) (Q : MvPolynomial d K) (i : d) (j : ℕ) :
    MvPolynomial.eval (0 : d → K)
        (MvPolynomial.pderiv i ((logisticPolynomialDerivation mu)^[j] Q)) =
      (mu i) ^ j * MvPolynomial.eval 0 (MvPolynomial.pderiv i Q) := by
  induction j with
  | zero => simp
  | succ j ih =>
      rw [Function.iterate_succ_apply',
        eval_zero_pderiv_logisticPolynomialDerivation, ih, pow_succ]
      ring

def logisticJetJacobian {k : ℕ} {K : Type*} [Field K]
    (mu : Fin k → K) (Q : MvPolynomial (Fin k) K) : Matrix (Fin k) (Fin k) K :=
  fun i j => MvPolynomial.eval (0 : Fin k → K)
    (MvPolynomial.pderiv i ((logisticPolynomialDerivation mu)^[(j : ℕ)] Q))

theorem logisticJetJacobian_eq_weightedVandermonde
    {k : ℕ} {K : Type*} [Field K]
    (mu : Fin k → K) (Q : MvPolynomial (Fin k) K) :
    logisticJetJacobian mu Q =
      Matrix.diagonal (fun i => MvPolynomial.eval (0 : Fin k → K)
        (MvPolynomial.pderiv i Q)) * Matrix.vandermonde mu := by
  ext i j
  rw [logisticJetJacobian, Matrix.mul_apply, Finset.sum_eq_single i]
  · rw [Matrix.diagonal_apply_eq, Matrix.vandermonde_apply,
      eval_zero_pderiv_iterate_logisticPolynomialDerivation]
    ring
  · intro l hl hli
    rw [Matrix.diagonal_apply_ne _ (Ne.symm hli), zero_mul]
  · simp

theorem logisticJetJacobian_det_ne_zero
    {k : ℕ} {K : Type*} [Field K]
    (mu : Fin k → K) (hmu : Function.Injective mu)
    (Q : MvPolynomial (Fin k) K)
    (hlinear : ∀ i, MvPolynomial.eval (0 : Fin k → K)
      (MvPolynomial.pderiv i Q) ≠ 0) :
    (logisticJetJacobian mu Q).det ≠ 0 := by
  rw [logisticJetJacobian_eq_weightedVandermonde, Matrix.det_mul,
    Matrix.det_diagonal]
  apply mul_ne_zero
  · exact Finset.prod_ne_zero_iff.mpr fun i _ => hlinear i
  · rw [Matrix.det_vandermonde_ne_zero_iff]
    exact fun i j hij => hmu hij

theorem symbolicLogisticJet_algebraicIndependent
    {k : ℕ} {K : Type*} [Field K] [CharZero K]
    (mu : Fin k → K) (hmu : Function.Injective mu)
    (Q : MvPolynomial (Fin k) K)
    (hlinear : ∀ i, MvPolynomial.eval (0 : Fin k → K)
      (MvPolynomial.pderiv i Q) ≠ 0) :
    AlgebraicIndependent K
      (fun j : Fin k => (logisticPolynomialDerivation mu)^[(j : ℕ)] Q) := by
  apply MvPolynomial.algebraicIndependent_of_jacobian_det_ne_zero
    (coordinate := id)
  intro hzero
  apply logisticJetJacobian_det_ne_zero mu hmu Q hlinear
  have hmatrix : logisticJetJacobian mu Q =
      (MvPolynomial.polynomialJacobianMinor
        (fun j : Fin k => (logisticPolynomialDerivation mu)^[(j : ℕ)] Q) id).map
          (MvPolynomial.eval (0 : Fin k → K)) := by
    ext i j
    rfl
  rw [hmatrix]
  change ((MvPolynomial.eval (0 : Fin k → K)).mapMatrix
    (MvPolynomial.polynomialJacobianMinor
      (fun j : Fin k => (logisticPolynomialDerivation mu)^[(j : ℕ)] Q) id)).det = 0
  rw [← RingHom.map_det, hzero, map_zero]

def logisticFluxSeed {d K : Type*} [Fintype d] [DecidableEq d]
    [CommRing K] (mu : d → K) : MvPolynomial d K :=
  ∑ i, MvPolynomial.C (-mu i) * MvPolynomial.X i

theorem eval_zero_pderiv_logisticFluxSeed
    {d K : Type*} [Fintype d] [DecidableEq d] [Field K]
    (mu : d → K) (i : d) :
    MvPolynomial.eval (0 : d → K)
      (MvPolynomial.pderiv i (logisticFluxSeed mu)) = -mu i := by
  classical
  rw [logisticFluxSeed, map_sum, MvPolynomial.eval_sum]
  rw [Finset.sum_eq_single i]
  · simp [Derivation.leibniz]
  · intro j hj hji
    simp [Derivation.leibniz, hji]
  · simp

theorem symbolicLogisticFluxJet_algebraicIndependent
    {k : ℕ} {K : Type*} [Field K] [CharZero K]
    (mu : Fin k → K) (hmu : Function.Injective mu)
    (hmu0 : ∀ i, mu i ≠ 0) :
    AlgebraicIndependent K
      (fun j : Fin k => (logisticPolynomialDerivation mu)^[(j : ℕ)]
        (logisticFluxSeed mu)) := by
  apply symbolicLogisticJet_algebraicIndependent mu hmu (logisticFluxSeed mu)
  intro i
  rw [eval_zero_pderiv_logisticFluxSeed]
  exact neg_ne_zero.mpr (hmu0 i)

theorem algebraicIndependent_aeval_family
    {F K d j : Type*} [Field F] [Field K] [Algebra F K]
    {y : d → K} (hy : AlgebraicIndependent F y)
    {P : j → MvPolynomial d F} (hP : AlgebraicIndependent F P) :
    AlgebraicIndependent F (fun a => MvPolynomial.aeval y (P a)) := by
  rw [algebraicIndependent_iff] at hy hP ⊢
  intro Q hQ
  apply hP Q
  apply hy
  have hcomp := MvPolynomial.comp_aeval_apply P (MvPolynomial.aeval y) Q
  rw [hQ] at hcomp
  exact hcomp

theorem deriv_eval₂_logisticPolynomialDerivation
    {d K : Type*} [Fintype d] [DecidableEq d]
    [Field K] [Algebra ℂ K] [Differential K]
    (hconst : ∀ c : ℂ, (algebraMap ℂ K c)′ = 0)
    (mu : d → ℂ) (y : d → K)
    (hy : ∀ i, (y i)′ = algebraMap ℂ K (mu i) * y i * (1 + y i))
    (P : MvPolynomial d ℂ) :
    (MvPolynomial.eval₂ (algebraMap ℂ K) y P)′ =
      MvPolynomial.eval₂ (algebraMap ℂ K) y
        (logisticPolynomialDerivation mu P) := by
  rw [← MvPolynomial.aeval_def]
  have hchain := jacobian_aeval_eq_sum_pderiv
    (fun x : K => x′)
    (fun a b => by exact (Differential.deriv (R := K)).map_add a b)
    (fun a b => by
      have h := (Differential.deriv (R := K)).leibniz a b
      simp only [smul_eq_mul] at h
      exact h)
    hconst y P
  rw [hchain, logisticPolynomialDerivation, MvPolynomial.eval₂_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [hy i]
  simp [MvPolynomial.aeval_def]
  ring

def finiteEulerFluxMero (S : Finset Nat.Primes) : upperEndMeroField :=
  ∑ i : Fin (Fintype.card ↥S),
    upperEndComplexToMero (-(finitePrimeFrequency S i : ℂ)) * finitePrimeEulerLogState S i

theorem finiteEulerGamma_flux_eq_eval₂_seed (S : Finset Nat.Primes) :
    finiteEulerFluxMero S = MvPolynomial.eval₂ upperEndComplexToMero (finitePrimeEulerLogState S)
      (logisticFluxSeed (fun i => (finitePrimeFrequency S i : ℂ))) := by
  rw [finiteEulerFluxMero, logisticFluxSeed, MvPolynomial.eval₂_sum]
  apply Finset.sum_congr rfl
  intro i hi
  simp

theorem finiteEulerGamma_flux_differentialJet_eq_eval₂_iterate (S : Finset Nat.Primes) (j : ℕ) :
    differentialJet j (finiteEulerFluxMero S) =
      MvPolynomial.eval₂ upperEndComplexToMero (finitePrimeEulerLogState S)
        ((logisticPolynomialDerivation
          (fun i => (finitePrimeFrequency S i : ℂ)))^[j]
            (logisticFluxSeed (fun i => (finitePrimeFrequency S i : ℂ)))) := by
  induction j with
  | zero =>
      simp [differentialJet_zero, finiteEulerGamma_flux_eq_eval₂_seed]
  | succ j ih =>
      rw [differentialJet_succ, ih, Function.iterate_succ_apply']
      apply deriv_eval₂_logisticPolynomialDerivation
        upperEndMero_deriv_complexConstant
      intro i
      exact finiteEulerGamma_logState_deriv S i

def complexToFiniteEulerGamma : ℂ →+* finiteEulerGammaCoefficientField :=
  upperEndComplexToMero.codRestrict finiteEulerGammaCoefficientField
    (fun c => upperEndComplexToMero_mem_gammaAdjoin c)

@[simp] theorem algebraMap_complexToFiniteEulerGamma (c : ℂ) :
    algebraMap ↥finiteEulerGammaCoefficientField upperEndMeroField
        (complexToFiniteEulerGamma c) =
      upperEndComplexToMero c := rfl

theorem eval₂_complex_eq_aeval_map_finiteEulerGamma
    {d : Type*} (y : d → upperEndMeroField) (P : MvPolynomial d ℂ) :
    MvPolynomial.eval₂ upperEndComplexToMero y P =
      MvPolynomial.aeval y (P.map complexToFiniteEulerGamma) := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [complexToFiniteEulerGamma]
  | add P Q hP hQ => simp [hP, hQ]
  | mul_X P i hP => simp [hP]

theorem map_logisticPolynomialDerivation
    {d K L : Type*} [Fintype d] [DecidableEq d]
    [CommRing K] [CommRing L] (phi : K →+* L)
    (mu : d → K) (Q : MvPolynomial d K) :
    (logisticPolynomialDerivation mu Q).map phi =
      logisticPolynomialDerivation (fun i => phi (mu i)) (Q.map phi) := by
  classical
  simp [logisticPolynomialDerivation, MvPolynomial.pderiv_map]

theorem map_logisticFluxSeed
    {d K L : Type*} [Fintype d] [DecidableEq d]
    [CommRing K] [CommRing L] (phi : K →+* L) (mu : d → K) :
    (logisticFluxSeed mu).map phi =
      logisticFluxSeed (fun i => phi (mu i)) := by
  classical
  simp [logisticFluxSeed]

theorem map_iterate_logisticPolynomialDerivation
    {d K L : Type*} [Fintype d] [DecidableEq d]
    [CommRing K] [CommRing L] (phi : K →+* L)
    (mu : d → K) (Q : MvPolynomial d K) (j : ℕ) :
    (((logisticPolynomialDerivation mu)^[j] Q).map phi) =
      (logisticPolynomialDerivation (fun i => phi (mu i)))^[j] (Q.map phi) := by
  induction j with
  | zero => rfl
  | succ j ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
        map_logisticPolynomialDerivation, ih]

def finiteEulerGammaFrequency (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) : finiteEulerGammaCoefficientField :=
  complexToFiniteEulerGamma (finitePrimeFrequency S i : ℂ)

theorem finiteEulerGammaFrequency_injective (S : Finset Nat.Primes) :
    Function.Injective (finiteEulerGammaFrequency S) := by
  intro i j hij
  apply finitePrimeFrequency_injective S
  exact Complex.ofReal_injective (complexToFiniteEulerGamma.injective hij)

theorem finiteEulerGammaFrequency_ne_zero (S : Finset Nat.Primes)
    (i : Fin (Fintype.card ↥S)) : finiteEulerGammaFrequency S i ≠ 0 := by
  intro hzero
  have hc : (finitePrimeFrequency S i : ℂ) = 0 := by
    apply complexToFiniteEulerGamma.injective
    simpa [finiteEulerGammaFrequency] using hzero
  exact (Complex.ofReal_ne_zero.mpr
    ((finitePrimeFrequency_linearIndependent S).ne_zero i)) hc

theorem finiteEulerGamma_symbolicGammaFluxJet_algebraicIndependent (S : Finset Nat.Primes) :
    AlgebraicIndependent ↥finiteEulerGammaCoefficientField
      (fun j : Fin (Fintype.card ↥S) =>
        (logisticPolynomialDerivation (finiteEulerGammaFrequency S))^[(j : ℕ)]
          (logisticFluxSeed (finiteEulerGammaFrequency S))) := by
  exact symbolicLogisticFluxJet_algebraicIndependent
    (finiteEulerGammaFrequency S) (finiteEulerGammaFrequency_injective S)
      (finiteEulerGammaFrequency_ne_zero S)

theorem finiteEulerGamma_flux_initial_jets_ai (S : Finset Nat.Primes) :
    AlgebraicIndependent ↥finiteEulerGammaCoefficientField
      (fun j : Fin (Fintype.card ↥S) => differentialJet (j : ℕ) (finiteEulerFluxMero S)) := by
  have h := algebraicIndependent_aeval_family (finiteEulerGamma_logState_ai S)
    (finiteEulerGamma_symbolicGammaFluxJet_algebraicIndependent S)
  rw [show (fun j : Fin (Fintype.card ↥S) =>
      differentialJet (j : ℕ) (finiteEulerFluxMero S)) =
      (fun j : Fin (Fintype.card ↥S) =>
        MvPolynomial.aeval (finitePrimeEulerLogState S)
          ((logisticPolynomialDerivation (finiteEulerGammaFrequency S))^[(j : ℕ)]
            (logisticFluxSeed (finiteEulerGammaFrequency S)))) by
    funext j
    rw [finiteEulerGamma_flux_differentialJet_eq_eval₂_iterate,
      eval₂_complex_eq_aeval_map_finiteEulerGamma,
      map_iterate_logisticPolynomialDerivation, map_logisticFluxSeed]
    rfl]
  exact h

theorem finiteEulerGamma_flux_mem_logState_adjoin (S : Finset Nat.Primes) :
    finiteEulerFluxMero S ∈
      IntermediateField.adjoin ↥finiteEulerGammaCoefficientField (Set.range (finitePrimeEulerLogState S)) := by
  rw [finiteEulerFluxMero]
  apply IntermediateField.sum_mem
  intro i hi
  apply IntermediateField.mul_mem
  · exact IntermediateField.algebraMap_mem _
      (⟨upperEndComplexToMero (-(finitePrimeFrequency S i : ℂ)),
        upperEndComplexToMero_mem_gammaAdjoin _⟩ : ↥finiteEulerGammaCoefficientField)
  · exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)

theorem finiteEulerGamma_minimal_flux (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerFluxMero S) = Fintype.card ↥S := by
  have hu : GammaMeroRelationAtOrder (finiteEulerFluxMero S) (Fintype.card ↥S) := by
    change ¬ AlgebraicIndependent ↥finiteEulerGammaCoefficientField
      (fun i : Fin (Fintype.card ↥S + 1) =>
        differentialJet (i : ℕ) (finiteEulerFluxMero S))
    have hdep := not_algebraicIndependent_jets_of_mem_finite_derivationClosed_state
      (finitePrimeEulerLogState S) (finiteEulerGamma_logState_deriv_mem S) (finiteEulerGamma_flux_mem_logState_adjoin S)
    have hcard : Fintype.card (Fin (Fintype.card ↥S)) = Fintype.card ↥S :=
      Fintype.card_fin _
    rw [hcard] at hdep
    exact hdep
  apply le_antisymm (Nat.sInf_le hu)
  have hmin : GammaMeroRelationAtOrder (finiteEulerFluxMero S) (gammaMeroMinimalOrder (finiteEulerFluxMero S)) := by
    change sInf {n | GammaMeroRelationAtOrder (finiteEulerFluxMero S) n} ∈
      {n | GammaMeroRelationAtOrder (finiteEulerFluxMero S) n}
    apply Nat.sInf_mem
    exact ⟨Fintype.card ↥S, hu⟩
  by_contra hnot
  have hlt : gammaMeroMinimalOrder (finiteEulerFluxMero S) < Fintype.card ↥S :=
    Nat.lt_of_not_ge hnot
  let inc : Fin (gammaMeroMinimalOrder (finiteEulerFluxMero S) + 1) → Fin (Fintype.card ↥S) :=
    fun i => ⟨i, by omega⟩
  have hinc : Function.Injective inc := by
    intro i j hij
    apply Fin.ext
    exact congrArg (fun x : Fin (Fintype.card ↥S) => (x : ℕ)) hij
  have hsub := (finiteEulerGamma_flux_initial_jets_ai S).comp inc hinc
  apply hmin
  rw [show (fun i : Fin (gammaMeroMinimalOrder (finiteEulerFluxMero S) + 1) =>
      differentialJet (i : ℕ) (finiteEulerFluxMero S)) =
      (fun j : Fin (Fintype.card ↥S) => differentialJet (j : ℕ) (finiteEulerFluxMero S)) ∘ inc by
    rfl]
  exact hsub

/-- Exact Gamma-relative differential order of the finite Euler logarithmic flux. -/
theorem gammaMeroMinimalOrder_finiteEulerFlux_eq (S : Finset Nat.Primes) :
    gammaMeroMinimalOrder (finiteEulerFluxMero S) = Fintype.card ↥S :=
  finiteEulerGamma_minimal_flux S

end
