import Mathlib.Algebra.BigOperators.Group.List.Basic

namespace GaloisForLFunctions.HTGeometry.HurwitzFactorization

variable {G : Type*} [Group G]

/-- Equivalence generated by the product-preserving adjacent Hurwitz move. -/
inductive Related : List G → List G → Prop
  | refl (l) : Related l l
  | move (l r : List G) (a b : G) :
      Related (l ++ a :: b :: r) (l ++ b :: (b⁻¹ * a * b) :: r)
  | symm {l r} : Related l r → Related r l
  | trans {l m r} : Related l m → Related m r → Related l r

theorem Related.prod_eq {l r : List G} (h : Related l r) : l.prod = r.prod := by
  induction h with
  | refl => rfl
  | move l r a b => simp [List.prod_append, List.prod_cons, mul_assoc]
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem Related.length_eq {l r : List G} (h : Related l r) : l.length = r.length := by
  induction h with
  | refl => rfl
  | move l r a b => simp
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem Related.forall_iff {P : G → Prop}
    (hP : ∀ a b, P (b⁻¹ * a * b) ↔ P a) {l r : List G} (h : Related l r) :
    (∀ a ∈ l, P a) ↔ ∀ a ∈ r, P a := by
  induction h with
  | refl => rfl
  | move l r a b =>
      simp only [List.mem_append, or_imp, forall_and, List.forall_mem_cons, hP]
      tauto
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem Related.map {H : Type*} [Group H] {l r : List G} (h : Related l r)
    (φ : G →* H) : Related (l.map φ) (r.map φ) := by
  induction h with
  | refl => exact .refl _
  | move l r a b =>
      simpa only [List.map_append, List.map_cons, map_mul, map_inv] using
        Related.move (l.map φ) (r.map φ) (φ a) (φ b)
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem Related.prepend {l r : List G} (h : Related l r) (p : List G) :
    Related (p ++ l) (p ++ r) := by
  induction h with
  | refl => exact .refl _
  | move l r a b => simpa only [List.append_assoc] using Related.move (p ++ l) r a b
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem Related.append {l r : List G} (h : Related l r) (p : List G) :
    Related (l ++ p) (r ++ p) := by
  induction h with
  | refl => exact .refl _
  | move l r a b =>
      simpa only [List.append_assoc, List.cons_append] using Related.move l (r ++ p) a b
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Moving the first factor through the tail conjugates it by that tail's product. -/
theorem move_first (a : G) (l : List G) :
    Related (a :: l) (l ++ [l.prod⁻¹ * a * l.prod]) := by
  induction l generalizing a with
  | nil => simpa using Related.refl [a]
  | cons b l ih =>
      have h₁ : Related (a :: b :: l) (b :: (b⁻¹ * a * b) :: l) :=
        Related.move [] l a b
      have h₂ := (ih (b⁻¹ * a * b)).prepend [b]
      exact h₁.trans (by simpa [List.prod_cons, mul_assoc] using h₂)

/-- The same cycling identity expressed using the invariant full product. -/
theorem move_first_by_product (a : G) (l : List G) :
    Related (a :: l) (l ++ [(a :: l).prod⁻¹ * a * (a :: l).prod]) := by
  simpa [List.prod_cons, mul_assoc] using move_first a l

/-- Moving an entire prefix past the suffix conjugates each moved factor by the full product. -/
theorem cycle_prefix (l r : List G) :
    Related (l ++ r) (r ++ l.map (fun a => (l ++ r).prod⁻¹ * a * (l ++ r).prod)) := by
  induction l generalizing r with
  | nil => simp only [List.nil_append, List.map_nil, List.append_nil]; exact .refl _
  | cons a l ih =>
      let σ := (a :: l ++ r).prod
      let c := σ⁻¹ * a * σ
      have h₁ : Related (a :: l ++ r) (l ++ (r ++ [c])) := by
        simpa only [c, σ, List.cons_append, List.append_assoc] using move_first_by_product a (l ++ r)
      have hp : (l ++ (r ++ [c])).prod = σ := h₁.prod_eq.symm
      have h₂ := ih (r ++ [c])
      rw [hp] at h₂
      exact h₁.trans (by simpa only [c, σ, List.cons_append, List.map_cons, List.append_assoc,
        List.singleton_append, List.nil_append] using h₂)

/-- A full cycle of adjacent moves conjugates every factor by the inverse of its product. -/
theorem conjugate_by_product (l : List G) :
    Related l (l.map (fun a => l.prod⁻¹ * a * l.prod)) := by
  simpa only [List.append_nil, List.nil_append] using cycle_prefix l []

end GaloisForLFunctions.HTGeometry.HurwitzFactorization
