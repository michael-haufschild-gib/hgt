import GaloisForLFunctions.HTGeometry.DifferentialKernelCharacteristic
import Mathlib.Algebra.Polynomial.EraseLead

/-!
# Pseudo-reduction by a scalar differential characteristic polynomial

This file builds the pseudo-division foundation needed after selecting an irreducible minimal
scalar differential relation.  No characteristic-set reduction theorem is assumed.  The first
layer is honest univariate pseudo-division over an integral domain: a power of the divisor's
leading coefficient clears every division step.  The second layer transports that construction
through the equivalence which singles out one multivariable-polynomial variable.

The differential layer then uses the characteristic initial at the leader and the characteristic
separant at higher jets.  Its output records the powers explicitly and records the congruence in
the differential ideal generated by the characteristic polynomial; it does not assume the later
two-copy coefficient-ratio theorem.
-/

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

open Polynomial

namespace Polynomial

/-- A pseudo-division certificate over an integral domain.  The multiplier is an explicit power
of the divisor's leading coefficient. -/
structure PseudoDivision
    {R : Type*} [CommRing R] (p q : R[X]) where
  exponent : ℕ
  quotient : R[X]
  remainder : R[X]
  eq_mul_add :
    Polynomial.C (q.leadingCoeff ^ exponent) * p = q * quotient + remainder
  remainder_degree_lt : remainder.degree < q.degree

/-- One nonmonic division step cancels the leading term and strictly lowers degree. -/
theorem pseudoDivision_step_degree_lt
    {R : Type*} [CommRing R] [NoZeroDivisors R]
    {p q : R[X]} (h : q.degree ≤ p.degree ∧ p ≠ 0) (hq : q ≠ 0) :
    (Polynomial.C q.leadingCoeff * p -
        q * (Polynomial.C p.leadingCoeff * Polynomial.X ^ (p.natDegree - q.natDegree))).degree <
      p.degree := by
  have hpLead : p.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr h.2
  have hqLead : q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hq
  have hnat : q.natDegree ≤ p.natDegree :=
    Polynomial.natDegree_le_natDegree h.1
  have hleft0 : Polynomial.C q.leadingCoeff * p ≠ 0 :=
    mul_ne_zero (Polynomial.C_ne_zero.mpr hqLead) h.2
  have hdeg :
      (Polynomial.C q.leadingCoeff * p).degree =
        (q * (Polynomial.C p.leadingCoeff *
          Polynomial.X ^ (p.natDegree - q.natDegree))).degree := by
    rw [Polynomial.degree_C_mul hqLead, Polynomial.degree_mul,
      Polynomial.degree_C_mul_X_pow _ hpLead,
      Polynomial.degree_eq_natDegree h.2, Polynomial.degree_eq_natDegree hq,
      ← Nat.cast_add, Nat.add_sub_of_le hnat]
  have hlead :
      (Polynomial.C q.leadingCoeff * p).leadingCoeff =
        (q * (Polynomial.C p.leadingCoeff *
          Polynomial.X ^ (p.natDegree - q.natDegree))).leadingCoeff := by
    simp only [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
      Polynomial.leadingCoeff_X_pow, mul_one]
  have hcancel := Polynomial.degree_sub_lt hdeg hleft0 hlead
  rwa [Polynomial.degree_C_mul hqLead] at hcancel

/-- Pseudo-division over an integral domain, constructed recursively rather than assumed from a
field-division or localization interface. -/
noncomputable def pseudoDivision
    {R : Type*} [CommRing R] [NoZeroDivisors R] :
    ∀ (p : R[X]) {q : R[X]}, q ≠ 0 → PseudoDivision p q
  | p, q, hq => by
      classical
      by_cases h : q.degree ≤ p.degree ∧ p ≠ 0
      · let z := Polynomial.C p.leadingCoeff *
          Polynomial.X ^ (p.natDegree - q.natDegree)
        let p₁ := Polynomial.C q.leadingCoeff * p - q * z
        have hwf : p₁.degree < p.degree := by
          exact pseudoDivision_step_degree_lt h hq
        let d := pseudoDivision p₁ hq
        exact
          { exponent := d.exponent + 1
            quotient := Polynomial.C (q.leadingCoeff ^ d.exponent) * z + d.quotient
            remainder := d.remainder
            eq_mul_add := by
              have hd := d.eq_mul_add
              dsimp only [p₁] at hd
              dsimp only [z]
              simp only [pow_succ, map_mul]
              calc
                Polynomial.C (q.leadingCoeff ^ d.exponent) *
                    Polynomial.C q.leadingCoeff * p =
                    Polynomial.C (q.leadingCoeff ^ d.exponent) *
                      (Polynomial.C q.leadingCoeff * p - q *
                        (Polynomial.C p.leadingCoeff *
                          Polynomial.X ^ (p.natDegree - q.natDegree))) +
                      q * (Polynomial.C (q.leadingCoeff ^ d.exponent) *
                        (Polynomial.C p.leadingCoeff *
                          Polynomial.X ^ (p.natDegree - q.natDegree))) := by ring
                _ = d.remainder + q * d.quotient +
                      q * (Polynomial.C (q.leadingCoeff ^ d.exponent) *
                        (Polynomial.C p.leadingCoeff *
                          Polynomial.X ^ (p.natDegree - q.natDegree))) := by
                    rw [hd]
                    ring
                _ = q *
                      (Polynomial.C (q.leadingCoeff ^ d.exponent) *
                          (Polynomial.C p.leadingCoeff *
                            Polynomial.X ^ (p.natDegree - q.natDegree)) + d.quotient) +
                        d.remainder := by ring
            remainder_degree_lt := d.remainder_degree_lt }
      · exact
          { exponent := 0
            quotient := 0
            remainder := p
            eq_mul_add := by simp
            remainder_degree_lt := by
              by_cases hp : p = 0
              · subst p
                exact (bot_lt_iff_ne_bot.mpr
                  (Polynomial.degree_ne_bot.mpr hq))
              · exact lt_of_not_ge fun hdeg ↦ h ⟨hdeg, hp⟩ }
  termination_by p => p

end Polynomial

end

end GaloisForLFunctions
