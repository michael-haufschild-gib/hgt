/-- Positive part of a unit-cube monomial complement. -/
def oddCompactUnitSlack (u t w : ℝ) (i j k : ℕ) : ℝ :=
  max 0 (1-u^i*t^j*w^k)

/-- On the unit cube, the positive-part notation is the exact polynomial complement. -/
theorem oddCompactUnitSlack_eq {u t w : ℝ}
    (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hw0 : 0 ≤ w) (hw1 : w ≤ 1) (i j k : ℕ) :
    oddCompactUnitSlack u t w i j k = 1-u^i*t^j*w^k := by
  have hu := pow_le_one₀ hu0 hu1 (n := i)
  have ht := pow_le_one₀ ht0 ht1 (n := j)
  have hw := pow_le_one₀ hw0 hw1 (n := k)
  have hut : u^i*t^j ≤ 1 := by
    simpa only [one_mul] using mul_le_mul hu ht (pow_nonneg ht0 j) (by norm_num : (0:ℝ) ≤ 1)
  have hutw : u^i*t^j*w^k ≤ 1 := by
    simpa only [one_mul] using mul_le_mul hut hw (pow_nonneg hw0 k) (by norm_num : (0:ℝ) ≤ 1)
  exact max_eq_right (by linarith)

