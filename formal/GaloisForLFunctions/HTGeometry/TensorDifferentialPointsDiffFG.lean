import GaloisForLFunctions.HTGeometry.DifferentialGaloisSeparation
import GaloisForLFunctions.HTGeometry.KolchinNullstellensatzDiffFG
import GaloisForLFunctions.HTGeometry.ComparisonJetAlgebra

/-!
# Separation for a subalgebra of constants generated by finitely many jets

The constants algebra of a parameterized torsor is generated by *all* jets of finitely many
elements, so it is differentially finitely generated but need not be of finite type.  Kolchin's
Nullstellensatz in its differential form applies exactly to that situation, and turns the jet
presentation into the separation property the isomonodromy endgame consumes.

* `coe_differentialJet` — the induced derivation of a stable subalgebra iterates the ambient one;
* `eq_zero_of_forall_mem_tensorDifferentialPoints_of_jetAdjoin`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

open scoped TensorProduct Differential

universe u

variable {K R C : Type u} [Field K] [CommRing R] [Algebra K R]
  [Field C] [Algebra C K] [Algebra C R] [IsScalarTower C K R]
  [Differential K] [Differential R] [DifferentialAlgebra K R]
  [Differential C] [DifferentialAlgebra C R]

omit [Differential C] [DifferentialAlgebra C R] in
/-- The jets of the induced derivation of a stable subalgebra are the ambient jets. -/
theorem coe_differentialJet (E : Subalgebra C (R ⊗[K] R))
    (hEδ : ∀ e ∈ E, tensorSquareDerivation (K := K) e ∈ E) (x : E) :
    letI : Differential (R ⊗[K] R) := ⟨tensorSquareDerivation (K := K)⟩
    letI : Differential E := subalgebraDifferential E hEδ
    ∀ n : ℕ, ((differentialJet n x : E) : R ⊗[K] R) = tensorJet (K := K) n ((x : E) : R ⊗[K] R) := by
  letI : Differential (R ⊗[K] R) := ⟨tensorSquareDerivation (K := K)⟩
  letI : Differential E := subalgebraDifferential E hEδ
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [differentialJet_succ, tensorJet_succ, ← ih]
      exact subalgebraDifferential_coe E hEδ _

/-- **The differential points of a jet-generated subalgebra of constants separate.**  The
subalgebra need not be of finite type: finitely many differential generators suffice. -/
theorem eq_zero_of_forall_mem_tensorDifferentialPoints_of_jetAdjoin [Algebra ℚ C]
    [IsDifferentiallyClosed C]
    (E : Subalgebra C (R ⊗[K] R)) (hEδ : ∀ e ∈ E, tensorSquareDerivation (K := K) e ∈ E)
    [IsReduced E] {k : ℕ} (v : Fin k → R ⊗[K] R) (hv : ∀ i, v i ∈ E)
    (hadj : Algebra.adjoin C (Set.range fun p : Fin k × ℕ => tensorJet (K := K) p.2 (v p.1)) = E)
    (e : E) (h : ∀ χ ∈ tensorDifferentialPoints E hEδ, χ e = 0) : e = 0 := by
  classical
  letI : Differential (R ⊗[K] R) := ⟨tensorSquareDerivation (K := K)⟩
  letI : Differential E := subalgebraDifferential E hEδ
  letI : Algebra ℚ E := ((algebraMap C E).comp (algebraMap ℚ C)).toAlgebra
  haveI : DifferentialAlgebra C E := by
    refine ⟨fun c => ?_⟩
    apply Subtype.ext
    show tensorSquareDerivation (K := K) ((algebraMap C E c : E) : R ⊗[K] R)
      = ((algebraMap C E (Differential.deriv c) : E) : R ⊗[K] R)
    show tensorSquareDerivation (K := K) (algebraMap C (R ⊗[K] R) c)
      = algebraMap C (R ⊗[K] R) (Differential.deriv c)
    exact tensorSquareDerivation_algebraMap c
  set y : Fin k → E := fun i => ⟨v i, hv i⟩ with hy
  have hjet : ∀ (p : Fin k × ℕ),
      ((differentialJet p.2 (y p.1) : E) : R ⊗[K] R) = tensorJet (K := K) p.2 (v p.1) := by
    rintro ⟨i, n⟩
    exact coe_differentialJet E hEδ (y i) n
  have hsurj : Function.Surjective
      (differentialPolynomialEvalOver (K := C) (L := E) y) := by
    set Φ : DifferentialPolynomial (Fin k) C →ₐ[C] E :=
      differentialPolynomialEvalOver (K := C) y with hΦ
    have hsub : Algebra.adjoin C
        (Set.range fun p : Fin k × ℕ => tensorJet (K := K) p.2 (v p.1))
        ≤ Subalgebra.map E.val Φ.range := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨p, rfl⟩
      obtain ⟨i, n⟩ := p
      exact ⟨differentialJet n (y i),
        ⟨MvPolynomial.X ((i, n) : Fin k × ℕ),
          differentialPolynomialEvalOver_X (K := C) y i n⟩, hjet (i, n)⟩
    intro x
    have hxE : (x : R ⊗[K] R) ∈
        Algebra.adjoin C (Set.range fun p : Fin k × ℕ => tensorJet (K := K) p.2 (v p.1)) := by
      rw [hadj]; exact x.2
    obtain ⟨t, ht, hteq⟩ := hsub hxE
    have : t = x := Subtype.ext hteq
    rw [this] at ht
    exact ht
  refine eq_zero_of_forall_mem_differentialPoints_of_diffFG (C := C) (E := E) y hsurj ?_
  intro χ hχ
  refine h χ ?_
  intro z hz
  exact hχ ⟨z, hz⟩

end

end GaloisForLFunctions.HTGeometry
