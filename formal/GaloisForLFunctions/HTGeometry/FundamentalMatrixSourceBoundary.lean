import GaloisForLFunctions.HTGeometry.FundamentalMatrixSourceGauge
import GaloisForLFunctions.HTGeometry.SourceBoundaryBaseChange
import GaloisForLFunctions.HTGeometry.DifferentialRankTower

/-!
# The curved source-boundary law for an arbitrary local system

The differential field generated by a fundamental matrix of the adjoint local system, together with
the entries of its inverse, is stable under every source direction and closed under the derivation.
Over that field the affine datum is flat, so the source-boundary criterion applies verbatim to the
family multiplied by the inverse fundamental matrix, with increments the inverse fundamental matrix
applied to the inverse-twisted increments.

No structure of the local system is used: not diagonalizability, not a triangular filtration, not
irreducibility.  The only input is the existence of an invertible solution matrix in the ambient
field, which is what a Picard–Vessiot extension supplies.  Together with rank additivity along a
tower this computes the differential rank of the observables relative to the fundamental matrix.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C K L : Type u} [Field C] [Field K] [Field L]
  [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]
  {I : Type u} (tau : I → K ≃+* K) (sigma : I → L ≃+* L)

variable {κ : Type u} [Fintype κ] [DecidableEq κ]

/-- The entries of a fundamental matrix together with the entries of its inverse. -/
def fundamentalGenerators (Y Yinv : Matrix κ κ L) : Set L :=
  Set.range (fun p : κ × κ => Y p.1 p.2) ∪ Set.range (fun p : κ × κ => Yinv p.1 p.2)

/-- The differential field generated over the base by a fundamental matrix and its inverse. -/
@[reducible]
def fundamentalField (K : Type u) {L : Type u} [Field K] [Field L] [Algebra K L] [Differential L]
    {κ : Type u} (Y Yinv : Matrix κ κ L) : IntermediateField K L :=
  differentialAdjoin K (fundamentalGenerators Y Yinv)

omit [Differential K] [DifferentialAlgebra K L] [Fintype κ] [DecidableEq κ] in
theorem fundamental_mem_field (Y Yinv : Matrix κ κ L) (p q : κ) :
    Y p q ∈ fundamentalField K Y Yinv :=
  subset_differentialAdjoin K _ (Or.inl ⟨(p, q), rfl⟩)

omit [Differential K] [DifferentialAlgebra K L] [Fintype κ] [DecidableEq κ] in
theorem fundamentalInv_mem_field (Y Yinv : Matrix κ κ L) (p q : κ) :
    Yinv p q ∈ fundamentalField K Y Yinv :=
  subset_differentialAdjoin K _ (Or.inr ⟨(p, q), rfl⟩)

/-! ### Entries of products stay in the field -/

omit [Differential K] [Differential L] [DifferentialAlgebra K L] [DecidableEq κ] in
theorem entry_mem_baseMat_mul {B : IntermediateField K L} {Z : Matrix κ κ L}
    (hZ : ∀ p q, Z p q ∈ B) (A : Matrix κ κ K) (p q : κ) :
    ((baseMat A : Matrix κ κ L) * Z) p q ∈ B := by
  rw [Matrix.mul_apply]
  refine B.sum_mem fun r _ => B.mul_mem ?_ (hZ r q)
  simp [baseMat]

omit [Differential K] [Differential L] [DifferentialAlgebra K L] [DecidableEq κ] in
theorem entry_mem_mul_baseMat {B : IntermediateField K L} {Z : Matrix κ κ L}
    (hZ : ∀ p q, Z p q ∈ B) (A : Matrix κ κ K) (p q : κ) :
    (Z * (baseMat A : Matrix κ κ L)) p q ∈ B := by
  rw [Matrix.mul_apply]
  refine B.sum_mem fun r _ => B.mul_mem (hZ p r) ?_
  simp [baseMat]

/-! ### Source stability of the fundamental field -/

/-- **The field generated by a fundamental matrix is source-stable.** -/
theorem fundamentalField_stable
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    {Y Yinv : Matrix κ κ L} {M Minv : I → Matrix κ κ K}
    (hYY : Y * Yinv = 1) (hYY' : Yinv * Y = 1)
    (hMM : ∀ i, M i * Minv i = 1) (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y)
    (i : I) (x : L) :
    sigma i x ∈ fundamentalField K Y Yinv ↔ x ∈ fundamentalField K Y Yinv := by
  refine sourceStable_mem_differentialAdjoin_iff tau sigma hcomp hderivL _ ?_ ?_ i x
  · rintro j x (⟨⟨p, q⟩, rfl⟩ | ⟨⟨p, q⟩, rfl⟩)
    · have hval : sigma j (Y p q) = ((baseMat (M j) : Matrix κ κ L) * Y) p q := by
        rw [← hfund j]; rfl
      rw [hval]
      exact entry_mem_baseMat_mul (fun a b => fundamental_mem_field Y Yinv a b) (M j) p q
    · have hval : sigma j (Yinv p q) = (Yinv * (baseMat (Minv j) : Matrix κ κ L)) p q := by
        rw [← map_sigma_fundamental_inv sigma hYY hYY' hMM hMM' hfund j]; rfl
      rw [hval]
      exact entry_mem_mul_baseMat (fun a b => fundamentalInv_mem_field Y Yinv a b) (Minv j) p q
  · rintro j x (⟨⟨p, q⟩, rfl⟩ | ⟨⟨p, q⟩, rfl⟩)
    · have hval : (sigma j).symm (Y p q)
          = ((baseMat ((Minv j).map (tau j).symm) : Matrix κ κ L) * Y) p q := by
        rw [← map_sigma_symm_fundamental tau sigma hcomp hMM' hfund j]; rfl
      rw [hval]
      exact entry_mem_baseMat_mul (fun a b => fundamental_mem_field Y Yinv a b) _ p q
    · have hval : (sigma j).symm (Yinv p q)
          = (Yinv * (baseMat ((M j).map (tau j).symm) : Matrix κ κ L)) p q := by
        rw [← map_sigma_symm_fundamental_inv tau sigma hcomp hYY hYY' hMM hMM' hfund j]; rfl
      rw [hval]
      exact entry_mem_mul_baseMat (fun a b => fundamentalInv_mem_field Y Yinv a b) _ p q

/-! ### The flattened family and its increments -/

/-- The increment of the flattened family, as an element of the fundamental field. -/
def fundamentalIncrement (Y Yinv : Matrix κ κ L) (Minv : I → Matrix κ κ K) (om : I → κ → K)
    (i : I) (p : κ) : ↥(fundamentalField K Y Yinv) :=
  ⟨Matrix.mulVec (Yinv * (baseMat (Minv i) : Matrix κ κ L))
      (fun q => algebraMap K L (om i q)) p, by
    simp only [Matrix.mulVec, dotProduct]
    refine (fundamentalField K Y Yinv).sum_mem fun r _ => ?_
    exact (fundamentalField K Y Yinv).mul_mem
      (entry_mem_mul_baseMat (fun a b => fundamentalInv_mem_field Y Yinv a b) (Minv i) p r)
      ((fundamentalField K Y Yinv).algebraMap_mem _)⟩

/-- **The curved source-boundary criterion for an arbitrary local system with a fundamental
matrix.**  The flattened family is differentially independent over the fundamental field exactly
when the boundary classes of its increments are linearly independent over the constant-coefficient
differential operators. -/
theorem fundamental_differentialIndependent_iff [CharZero L]
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ y : L, (∀ i, sigma i y = y) → ∃ c : C, algebraMap C L c = y)
    (hC : ∀ c : C, (algebraMap C L c)′ = 0)
    {Y Yinv : Matrix κ κ L} {M Minv : I → Matrix κ κ K} {om : I → κ → K} {z : κ → L}
    (hYY : Y * Yinv = 1) (hYY' : Yinv * Y = 1)
    (hMM : ∀ i, M i * Minv i = 1) (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y)
    (hshift : ∀ i p, sigma i (z p)
      = Matrix.mulVec (baseMat (M i) : Matrix κ κ L) z p + algebraMap K L (om i p)) :
    DifferentialIndependent ↥(fundamentalField K Y Yinv) (Matrix.mulVec Yinv z) ↔
      LinearIndependent (Polynomial C)
        (fun p : κ =>
          boundaryClass
            (restrictSource sigma (fundamentalField K Y Yinv)
              (fundamentalField_stable tau sigma hcomp hderivL hYY hYY' hMM hMM' hfund))
            (algebraMap_C_deriv_eq_zero_of_base (fundamentalField K Y Yinv) hC)
            (restrictSource_fixesConstants sigma (fundamentalField K Y Yinv)
              (fundamentalField_stable tau sigma hcomp hderivL hYY hYY' hMM hMM' hfund) hCfixed)
            (restrictSource_deriv sigma (fundamentalField K Y Yinv)
              (fundamentalField_stable tau sigma hcomp hderivL hYY hYY' hMM hMM' hfund) hderivL)
            fun i => fundamentalIncrement Y Yinv Minv om i p) :=
  differentialIndependent_iff_linearIndependent_boundaryClass_baseChange sigma
    (fundamentalField K Y Yinv)
    (fundamentalField_stable tau sigma hcomp hderivL hYY hYY' hMM hMM' hfund)
    hderivL hCfixed hfixed
    (algebraMap_C_deriv_eq_zero_of_base (fundamentalField K Y Yinv) hC)
    (Matrix.mulVec Yinv z) (fun i p => fundamentalIncrement Y Yinv Minv om i p)
    fun i p => fundamental_shift sigma hYY hYY' hMM hMM' hfund hshift i p

/-! ### The flattening keeps the relative rank -/

/-- The flattened family generates the same differential field over the fundamental field. -/
theorem differentialAdjoin_fundamentalFlatten {Y Yinv : Matrix κ κ L}
    (hYY : Y * Yinv = 1) (z : κ → L) :
    differentialAdjoin ↥(fundamentalField K Y Yinv) (Set.range (Matrix.mulVec Yinv z))
      = differentialAdjoin ↥(fundamentalField K Y Yinv) (Set.range z) := by
  have hz : Matrix.mulVec Y (Matrix.mulVec Yinv z) = z := by
    rw [Matrix.mulVec_mulVec, hYY, Matrix.one_mulVec]
  refine le_antisymm ?_ ?_
  · refine differentialAdjoin_le _ ?_
      (derivationClosed_differentialAdjoin ↥(fundamentalField K Y Yinv) _)
    rintro - ⟨p, rfl⟩
    simp only [Matrix.mulVec, dotProduct]
    refine (differentialAdjoin ↥(fundamentalField K Y Yinv) (Set.range z)).sum_mem fun r _ => ?_
    refine (differentialAdjoin ↥(fundamentalField K Y Yinv) (Set.range z)).mul_mem ?_
      (subset_differentialAdjoin _ _ ⟨r, rfl⟩)
    exact (differentialAdjoin ↥(fundamentalField K Y Yinv) (Set.range z)).algebraMap_mem
      ⟨Yinv p r, fundamentalInv_mem_field Y Yinv p r⟩
  · refine differentialAdjoin_le _ ?_
      (derivationClosed_differentialAdjoin ↥(fundamentalField K Y Yinv) _)
    rintro - ⟨p, rfl⟩
    have hzp : z p = Matrix.mulVec Y (Matrix.mulVec Yinv z) p := by rw [hz]
    rw [hzp]
    simp only [Matrix.mulVec, dotProduct]
    refine (differentialAdjoin ↥(fundamentalField K Y Yinv)
      (Set.range (Matrix.mulVec Yinv z))).sum_mem fun r _ => ?_
    refine (differentialAdjoin ↥(fundamentalField K Y Yinv)
      (Set.range (Matrix.mulVec Yinv z))).mul_mem ?_ (subset_differentialAdjoin _ _ ⟨r, rfl⟩)
    exact (differentialAdjoin ↥(fundamentalField K Y Yinv)
      (Set.range (Matrix.mulVec Yinv z))).algebraMap_mem
      ⟨Y p r, fundamental_mem_field Y Yinv p r⟩

/-- The flattening does not change the differential rank over the fundamental field. -/
theorem eRk_fundamentalFlatten [CharZero L] {Y Yinv : Matrix κ κ L}
    (hYY : Y * Yinv = 1) (z : κ → L) :
    (differentialMatroid ↥(fundamentalField K Y Yinv) L).eRk
        (Set.range (Matrix.mulVec Yinv z))
      = (differentialMatroid ↥(fundamentalField K Y Yinv) L).eRk (Set.range z) := by
  rw [← Matroid.eRk_closure_eq, ← Matroid.eRk_closure_eq (X := Set.range z),
    differentialMatroid_closure_eq_differentialClosure,
    differentialMatroid_closure_eq_differentialClosure]
  unfold differentialClosure
  rw [differentialAdjoin_fundamentalFlatten hYY z]

/-- **The curved rank law for an arbitrary local system with a fundamental matrix.**  The rank of
the fundamental matrix together with the observables splits as the rank of the fundamental matrix
plus the rank of the flattened family over the field it generates. -/
theorem fundamental_eRk_union [CharZero L] {Y Yinv : Matrix κ κ L}
    (hYY : Y * Yinv = 1) (z : κ → L) :
    (differentialMatroid K L).eRk (fundamentalGenerators Y Yinv ∪ Set.range z)
      = (differentialMatroid K L).eRk (fundamentalGenerators Y Yinv)
        + (differentialMatroid ↥(fundamentalField K Y Yinv) L).eRk
            (Set.range (Matrix.mulVec Yinv z)) := by
  rw [eRk_union_eq_eRk_add_eRk, eRk_fundamentalFlatten hYY z]

end

end GaloisForLFunctions.HTGeometry
