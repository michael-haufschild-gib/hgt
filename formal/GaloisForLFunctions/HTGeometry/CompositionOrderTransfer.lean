import GaloisForLFunctions.HTGeometry.EntireJetEvaluation
import GaloisForLFunctions.HTGeometry.DifferentialOrder

/-!
# Transferring an algebraic differential equation across a nonconstant substitution

A differential-polynomial relation in the jets of an entire `g` that holds along the range of a
nonconstant entire `φ` holds everywhere: the range is open by the open mapping theorem, and an
entire function vanishing on a nonempty open set is zero.  So `g` itself is differentially
algebraic of that order.

Together with the jet chain rule `deriv_iteratedDeriv_comp_entire` — which puts every `g⁽ʲ⁾ ∘ φ` in the
differential field generated by `φ` and `g ∘ φ` — this is the analytic half of the
composition-decomposition law: if `φ` and `g ∘ φ` are differentially algebraic of order `N`, so is
`g`, with order at most `2N`.  The remaining half is the transcendence count that produces the
relation.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- **An entire function vanishing on the range of a nonconstant entire map is zero.**  The range is
open by the open mapping theorem, and an analytic function vanishing on a nonempty open subset of a
connected set vanishes on all of it. -/
theorem eq_zero_of_eq_zero_on_range {Q φ : ℂ → ℂ}
    (hQ : AnalyticOnNhd ℂ Q Set.univ) (hφ : AnalyticOnNhd ℂ φ Set.univ)
    (hnc : ∀ c : ℂ, ∃ z, φ z ≠ c)
    (h : ∀ z, Q (φ z) = 0) : ∀ w, Q w = 0 := by
  rcases hφ.is_constant_or_isOpen isPreconnected_univ with ⟨c, hc⟩ | hopen
  · obtain ⟨z, hz⟩ := hnc c
    exact absurd (hc z (Set.mem_univ z)) hz
  · have hUopen : IsOpen (φ '' Set.univ) := hopen Set.univ (subset_refl _) isOpen_univ
    have hw₀ : φ 0 ∈ φ '' Set.univ := ⟨0, Set.mem_univ 0, rfl⟩
    have hev : Q =ᶠ[nhds (φ 0)] 0 := by
      filter_upwards [hUopen.mem_nhds hw₀] with w hw
      obtain ⟨z, _, rfl⟩ := hw
      exact h z
    have hzero := hQ.eqOn_zero_of_preconnected_of_eventuallyEq_zero isPreconnected_univ
      (Set.mem_univ (φ 0)) hev
    intro w
    exact hzero (Set.mem_univ w)

/-- **The jet chain rule.**  Differentiating the `j`-th derivative of the outer function composed
with the inner one multiplies by the inner derivative and raises the jet order. -/
theorem deriv_iteratedDeriv_comp_entire {g φ : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hφ : Differentiable ℂ φ) (j : ℕ) (z : ℂ) :
    deriv (fun z => iteratedDeriv j g (φ z)) z
      = iteratedDeriv (j + 1) g (φ z) * deriv φ z := by
  have h : deriv (iteratedDeriv j g ∘ φ) z
      = deriv (iteratedDeriv j g) (φ z) * deriv φ z :=
    deriv_comp z ((differentiable_iteratedDeriv_of_entire hg j) (φ z)) (hφ z)
  rw [iteratedDeriv_succ]
  exact h

/-- **Order transfer along a nonconstant entire substitution.**  A nonzero differential polynomial in
the jets of `g` that vanishes along the range of a nonconstant entire `φ` makes `g` differentially
algebraic of that order.  This is the step that converts a relation in the inner variable into an
algebraic differential equation for the outer function. -/
theorem differentiallyAlgebraicOfOrder_of_relation_on_range {g φ : ℂ → ℂ}
    (hg : Differentiable ℂ g) (hφ : Differentiable ℂ φ)
    (hnc : ∀ c : ℂ, ∃ z, φ z ≠ c) {M : ℕ}
    (P : MvPolynomial (Fin (M + 2)) ℂ) (hP : P ≠ 0)
    (hrel : ∀ z : ℂ, MvPolynomial.eval
      (Fin.cons (φ z) fun j : Fin (M + 1) => iteratedDeriv (j : ℕ) g (φ z)) P = 0) :
    DifferentiallyAlgebraicOfOrder g M := by
  refine ⟨P, hP, ?_⟩
  have hQana : AnalyticOnNhd ℂ
      (fun w => MvPolynomial.eval
        (Fin.cons w fun j : Fin (M + 1) => iteratedDeriv (j : ℕ) g w) P) Set.univ :=
    analyticOnNhd_jetEval hg M P
  have hφana : AnalyticOnNhd ℂ φ Set.univ :=
    Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ
  exact eq_zero_of_eq_zero_on_range hQana hφana hnc hrel

end GaloisForLFunctions.HTGeometry
