import GaloisForLFunctions.HTGeometry.ManinKernelKolchinClosure
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Quotient coordinates for the Manin horizon

The invariants of the Manin kernel are the differential rational functions of the Manin map.  Two
halves of that statement are unconditional and are proved here.

* The field fixed by a family of differential automorphisms is closed under the derivation, so it
  contains the whole differential field generated by any family of invariant elements.  This gives
  the inclusion `K⟨mu⟩ ≤ L^{A^sharp}` from invariance of the Manin coordinates alone.
* If a map has exactly the orbits of a group action as its fibres, then a function is invariant
  precisely when it factors through that map.  This is the set-theoretic content of the
  differential rational quotient theorem.

The reverse inclusion — that every invariant differential rational function is a differential
rational function of the Manin map — is the quotient theorem for differential algebraic groups and
enters as an explicit hypothesis.  With it, the stable multiplication tail is exactly the field
generated by the Manin coordinates.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

/-! ### Fixed fields of differential automorphisms -/

variable {K L A : Type*} [Field K] [Field L] [Algebra K L] [Differential L]

/-- The field fixed by differential automorphisms is closed under the derivation. -/
theorem derivationClosed_differentialTranslationFixedField
    (translation : A → DifferentialAlgEquiv K L) (S : Set A) :
    DerivationClosed (differentialTranslationFixedField translation S) := by
  intro z hz a ha
  rw [(translation a).map_deriv', hz a ha]

/-- A family of invariant elements generates a differential subfield of the fixed field. -/
theorem differentialAdjoin_le_differentialTranslationFixedField
    (translation : A → DifferentialAlgEquiv K L) (S : Set A) {κ : Type*} (mu : κ → L)
    (hinv : ∀ a ∈ S, ∀ j, (translation a).toAlgEquiv (mu j) = mu j) :
    differentialAdjoin K (Set.range mu) ≤ differentialTranslationFixedField translation S := by
  refine differentialAdjoin_le K ?_ (derivationClosed_differentialTranslationFixedField
    translation S)
  rintro z ⟨j, rfl⟩ a ha
  exact hinv a ha j

/-! ### Orbit fibres and factorisation -/

/-- **The quotient principle.**  If the fibres of a map are exactly the orbits of a group action,
a function is invariant exactly when it factors through the map. -/
theorem invariant_iff_factorsThrough_of_fibre_eq_orbit
    {X Q V G : Type*} [Group G] [MulAction G X] [Nonempty V]
    (mu : X → Q) (hfib : ∀ x y : X, mu x = mu y ↔ ∃ g : G, y = g • x) (f : X → V) :
    (∀ (g : G) (x : X), f (g • x) = f x) ↔ ∃ h : Q → V, ∀ x, f x = h (mu x) := by
  classical
  constructor
  · intro hinv
    have hfactor : Function.FactorsThrough f mu := by
      intro x y hxy
      obtain ⟨g, rfl⟩ := (hfib x y).mp hxy
      exact (hinv g x).symm
    refine ⟨Function.extend mu f (fun _ => Classical.arbitrary V), fun x => ?_⟩
    exact (hfactor.extend_apply (fun _ => Classical.arbitrary V) x).symm
  · rintro ⟨h, hh⟩ g x
    have hmu : mu (g • x) = mu x := ((hfib x (g • x)).mpr ⟨g, rfl⟩).symm
    rw [hh (g • x), hh x, hmu]

/-! ### The Manin horizon -/

variable {ι : Type*} [Differential K]

omit [Differential K] in
/-- **Equation (2), invariant-field form.**  Given that the Manin coordinates are Manin-kernel
invariant and that every Manin-kernel invariant is a differential rational function of them, the
field of Manin-kernel invariants is the differential field they generate. -/
theorem differentialTranslationFixedField_eq_maninCoordinateField
    (translation : (ι → K) → DifferentialAlgEquiv K L) (Asharp : Set (ι → K))
    {κ : Type*} (mu : κ → L)
    (hinv : ∀ a ∈ Asharp, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ Asharp, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu)) :
    differentialTranslationFixedField translation Asharp
      = differentialAdjoin K (Set.range mu) := by
  refine le_antisymm (fun z hz => hquot z hz) ?_
  exact differentialAdjoin_le_differentialTranslationFixedField translation Asharp mu hinv

/-- **The Manin-horizon theorem.**  The stable intersection of the tower of translation fixed
fields is the differential field generated by the Manin coordinates.

The tower step and the identification of the Kolchin closure with the Manin kernel are proved; the
inputs are the classical ones the paper proof names: Kolchin closedness of point stabilisers,
Kolchin closedness, torsion containment and minimality of the Manin kernel, Zariski density of the
primary torsion, invariance of the Manin coordinates, and the differential rational quotient
theorem. -/
theorem iInf_differentialTranslationFixedField_eq_maninCoordinateField
    {ι' : Type*} (translation : (ι → K) → DifferentialAlgEquiv K L)
    (T : ι' → Set (ι → K)) (Asharp : Set (ι → K)) {κ : Type*} (mu : κ → L)
    (hstab : ∀ z : L, IsKolchinClosedOver K {a : ι → K | (translation a).toAlgEquiv z = z})
    (hAclosed : IsKolchinClosedOver K Asharp)
    (hTA : ∀ n, T n ⊆ Asharp)
    (hmin : ∀ H : Set (ι → K), IsKolchinClosedOver K H → ZariskiDenseOver K H → Asharp ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, T n))
    (hinv : ∀ a ∈ Asharp, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ Asharp, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu)) :
    (⨅ n, differentialTranslationFixedField translation (T n))
      = differentialAdjoin K (Set.range mu) := by
  rw [iInf_differentialTranslationFixedField_eq_maninKernel translation T Asharp hstab
    hAclosed hTA hmin hdense]
  exact differentialTranslationFixedField_eq_maninCoordinateField translation Asharp mu hinv hquot

end

end GaloisForLFunctions.HTGeometry
