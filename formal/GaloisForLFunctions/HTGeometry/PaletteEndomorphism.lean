import GaloisForLFunctions.HTGeometry.DifferentialAdjoinScale

/-!
# Endomorphisms of a freely generated differential field given by a palette

A differential field freely generated by a differentially independent palette admits, for every
other differentially independent palette on the same index set, a differential endomorphism sending
the first palette to the second: the universal parametrization of a free differential field
transports one onto the other, and the image is the differential field generated by the second
palette.

Two such endomorphisms agreeing on the generating palette are equal, so composites are computed on
the palette alone.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {C E ι : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {x y : ι → E} (hx : DifferentialIndependent C x) (hy : DifferentialIndependent C y)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

include hgen in
/-- The generated differential field of a generating palette, seen from the ambient field. -/
def paletteGenEquiv : E ≃ₐ[C] ↥(differentialAdjoin C (Set.range x)) :=
  ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv).symm

include hx hy hgen in
/-- **The palette endomorphism.**  The differential endomorphism of a freely generated differential
field sending one differentially independent palette to another. -/
def paletteEndo : E →ₐ[C] E :=
  (differentialAdjoin C (Set.range y)).val.comp
    ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy).toAlgHom.comp
      (paletteGenEquiv hgen).toAlgHom)

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
/-- The palette endomorphism carries the first palette to the second. -/
theorem paletteEndo_apply (i : ι) : paletteEndo hx hy hgen (x i) = y i := by
  have hpre : (paletteGenEquiv hgen) (x i) =
      ⟨differentialJet 0 (x i),
        differentialJet_mem_differentialAdjoin C (Set.mem_range_self i) 0⟩ := by
    apply Subtype.ext
    simp only [paletteGenEquiv, differentialJet_zero]
    rfl
  have hjet := GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv_jet x y hx hy i 0
  change ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy)
    ((paletteGenEquiv hgen) (x i)) : E) = y i
  rw [hpre, hjet]
  simp

omit [CharZero E] in
/-- The palette endomorphism commutes with the derivation. -/
theorem paletteEndo_deriv (z : E) :
    paletteEndo hx hy hgen z′ = Differential.deriv (paletteEndo hx hy hgen z) := by
  set e := GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy with he
  have hgenderiv (w : E) : (paletteGenEquiv hgen) w′ = Differential.deriv
      ((paletteGenEquiv hgen) w) := by
    apply Subtype.ext
    have h1 : (((paletteGenEquiv hgen) w′ : ↥(differentialAdjoin C (Set.range x))) : E) = w′ := by
      simp only [paletteGenEquiv]
      rfl
    have h2 : (((paletteGenEquiv hgen) w : ↥(differentialAdjoin C (Set.range x))) : E) = w := by
      simp only [paletteGenEquiv]
      rfl
    rw [h1]
    have h3 := coe_differentialJet_differentialAdjoin (F := C)
      (Set.range x) 1 ((paletteGenEquiv hgen) w)
    simp only [differentialJet_succ, differentialJet_zero] at h3
    rw [h3, h2]
  change ((e ((paletteGenEquiv hgen) z′) : ↥(differentialAdjoin C (Set.range y))) : E)
    = Differential.deriv ((e ((paletteGenEquiv hgen) z) :
        ↥(differentialAdjoin C (Set.range y))) : E)
  rw [hgenderiv, GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv_deriv]
  have h4 := coe_differentialJet_differentialAdjoin (F := C)
    (Set.range y) 1 (e ((paletteGenEquiv hgen) z))
  simp only [differentialJet_succ, differentialJet_zero] at h4
  exact h4

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
/-- **The image of the palette endomorphism** is the differential field generated by the second
palette. -/
theorem paletteEndo_map_top :
    IntermediateField.map (paletteEndo hx hy hgen) ⊤ = differentialAdjoin C (Set.range y) := by
  apply le_antisymm
  · rintro z hz
    rw [IntermediateField.mem_map] at hz
    obtain ⟨w, -, rfl⟩ := hz
    exact ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy)
      ((paletteGenEquiv hgen) w)).2
  · intro z hz
    rw [IntermediateField.mem_map]
    refine ⟨(paletteGenEquiv hgen).symm
      ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy).symm ⟨z, hz⟩),
      trivial, ?_⟩
    change (((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy)
      ((paletteGenEquiv hgen) ((paletteGenEquiv hgen).symm
        ((GaloisForLFunctions.differentialIndependentAdjoinAlgEquiv x y hx hy).symm ⟨z, hz⟩))) :
        ↥(differentialAdjoin C (Set.range y))) : E) = z
    rw [AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]

end

omit [CharZero E] in
/-- **Palette endomorphisms are determined by their values on the generating palette.** -/
theorem paletteEndo_eq_of_apply {x z : ι → E} (hx : DifferentialIndependent C x)
    (hz : DifferentialIndependent C z)
    (hgen : differentialAdjoin C (Set.range x) = ⊤)
    (f : E →ₐ[C] E) (hfderiv : ∀ w : E, f w′ = Differential.deriv (f w))
    (hfx : ∀ i, f (x i) = z i) :
    f = paletteEndo hx hz hgen :=
  differentialAlgHom_ext_of_differentialAdjoin_eq_top x hgen f (paletteEndo hx hz hgen)
    hfderiv (fun w ↦ paletteEndo_deriv hx hz hgen w)
    (fun i ↦ by rw [hfx i, paletteEndo_apply])

end

end GaloisForLFunctions.HTGeometry
