import GaloisForLFunctions.HTGeometry.FZZCigarBackreactionCriticality

/-!
# Fractional-winding replica backreaction of the stringy cigar

Halder--Jafferis construct the conically singular replica deformation of the
`SL(2,ℝ)ₖ/U(1)` cigar by replacing the unit winding condensate with a non-local operator of
winding `1 - δ`.  At finite bosonic level `k > 2`, its radial Liouville dressing is not changed
by the same factor: in terms of `a = 1/k` the two weights are

`w(δ) = 1 - δ`,
`r(a,δ) = 1 - δ / (1 - 2a)`.

This file isolates the exact finite-level backreaction carried by that mismatch.  On the physical
range `0 < a < 1/2`, a positive conical deficit has strictly stronger radial dressing than thermal
winding, while a conical surplus reverses the inequality.  Equality is rigid: it occurs only at the
smooth cigar `δ = 0`.  Thus the sign separating deficit and surplus chambers comes from the actual
fractional-winding black-hole operator; it is absent at the infinite-level/Rindler limit.

The result is source-faithful genus-zero input.  It does not identify the replica parameter with a
Mellin or zeta variable.  Any arithmetic continuation must instead be derived from the still-open
torus one-point function of the stringy area operator.

Physics sources:

* Halder--Jafferis, *Thermal Bekenstein--Hawking entropy from the worldsheet*,
  arXiv:2310.02313, §4.
* Halder--Jafferis, *Stretched horizon, replica trick and off-shell winding condensate, and all
  that*, arXiv:2402.00932, equations (3.28)--(3.33).
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

namespace FZZCigar

/-- Fractional winding carried by the conical replica condensate. -/
def replicaWindingWeight (δ : ℝ) : ℝ :=
  1 - δ

/-- Finite-level radial Liouville weight of the same replica condensate, with `a = 1/k`. -/
def replicaRadialWeight (a δ : ℝ) : ℝ :=
  1 - δ / (1 - 2 * a)

/-- Radial-over-winding dressing generated by finite-level cigar backreaction. -/
def replicaDressingMismatch (a δ : ℝ) : ℝ :=
  replicaWindingWeight δ - replicaRadialWeight a δ

/-- Exact finite-level replica Ward law.  Multiplication by the shifted-level gap removes the
radial propagator and leaves the conical source `2aδ`. -/
theorem one_sub_two_mul_replicaDressingMismatch
    {a δ : ℝ} (ha : a ≠ 1 / 2) :
    (1 - 2 * a) * replicaDressingMismatch a δ = 2 * a * δ := by
  have hden : 1 - 2 * a ≠ 0 := by
    intro h
    apply ha
    linarith
  rw [replicaDressingMismatch, replicaWindingWeight, replicaRadialWeight]
  field_simp [hden]
  ring

/-- Closed form of the source-generated replica dressing mismatch. -/
theorem replicaDressingMismatch_eq
    {a δ : ℝ} (ha : a ≠ 1 / 2) :
    replicaDressingMismatch a δ = 2 * a * δ / (1 - 2 * a) := by
  have hden : 1 - 2 * a ≠ 0 := by
    intro h
    apply ha
    linarith
  rw [replicaDressingMismatch, replicaWindingWeight, replicaRadialWeight]
  field_simp [hden]
  ring

/-- Positive conical deficit produces a strictly positive radial-over-winding mismatch at every
finite physical level. -/
theorem replicaDressingMismatch_pos
    {a δ : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) (hδ : 0 < δ) :
    0 < replicaDressingMismatch a δ := by
  rw [replicaDressingMismatch_eq (ne_of_lt haHalf)]
  exact div_pos (mul_pos (mul_pos zero_lt_two ha0) hδ) (by linarith)

/-- A positive conical deficit damps the radial Liouville profile more strongly than it reduces
thermal winding. -/
theorem replicaRadialWeight_lt_replicaWindingWeight
    {a δ : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) (hδ : 0 < δ) :
    replicaRadialWeight a δ < replicaWindingWeight δ := by
  have h := replicaDressingMismatch_pos ha0 haHalf hδ
  rw [replicaDressingMismatch] at h
  linarith

/-- A conical surplus reverses the finite-level radial backreaction. -/
theorem replicaDressingMismatch_neg
    {a δ : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) (hδ : δ < 0) :
    replicaDressingMismatch a δ < 0 := by
  rw [replicaDressingMismatch_eq (ne_of_lt haHalf)]
  exact div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg (mul_pos zero_lt_two ha0) hδ)
    (by linarith)

/-- At finite physical level, radial and winding replica weights agree exactly for the smooth
black-hole saddle. -/
theorem replicaRadialWeight_eq_replicaWindingWeight_iff
    {a δ : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) :
    replicaRadialWeight a δ = replicaWindingWeight δ ↔ δ = 0 := by
  constructor
  · intro hweights
    have h : replicaDressingMismatch a δ = 0 := by
      rw [replicaDressingMismatch, hweights]
      ring
    rw [replicaDressingMismatch_eq (ne_of_lt haHalf)] at h
    have haDen : 1 - 2 * a ≠ 0 := ne_of_gt (by linarith)
    have hnum : 2 * a * δ = 0 := by
      rcases (div_eq_zero_iff).mp h with hnum | hden
      · exact hnum
      · exact absurd hden haDen
    rcases mul_eq_zero.mp hnum with htwoa | hδ
    · exact absurd htwoa (mul_ne_zero (by norm_num) ha0.ne')
    · exact hδ
  · rintro rfl
    simp [replicaRadialWeight, replicaWindingWeight]

/-- The finite-level mismatch is odd under exchanging replica deficit and surplus. -/
theorem replicaDressingMismatch_neg_defect (a δ : ℝ) :
    replicaDressingMismatch a (-δ) = -replicaDressingMismatch a δ := by
  simp only [replicaDressingMismatch, replicaWindingWeight, replicaRadialWeight]
  ring

end FZZCigar

end

end GaloisForLFunctions.HTGeometry
