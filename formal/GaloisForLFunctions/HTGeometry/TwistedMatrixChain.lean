import GaloisForLFunctions.HTGeometry.DifferentialOperatorChainDegree

/-!
# Twisted matrix chains and their restarts

For a ring endomorphism `σ` and a matrix `C`, the twisted chain is the ordered product

`C · σ(C) · σ²(C) ⋯ σ^{n-1}(C)`.

It satisfies a recursion from the left as well as from the right, `P_{n+1} = C · σ(P_n)`, and it
splits: `P_{m+n} = P_m · σ^m(P_n)`.  The splitting has one structural consequence, which is what
makes an induction on twisted chains possible at all:

`P_{kN} = ` the `k`-th term of the twisted chain of `P_N` with respect to `σ^N`.

So restarting a twisted chain at any index produces *the same kind of object* — a twisted chain,
with the `N`-step block as generator and `σ^N` as twist.  Every invariant of twisted chains
therefore recurses along restarts.

* `iterHom` — the iterates of a ring endomorphism, as ring endomorphisms;
* `twistedFamily`, `twistedChain`;
* `twistedChain_left`, `twistedChain_add`, `twistedChain_restart`;
* `twistedChain_eq_chainProdK`, `twistedChain_eq_chainProd` — agreement with the ordered products
  of the operator-degree layer.
-/

namespace GaloisForLFunctions.HTGeometry

variable {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]

/-- The `n`-fold iterate of a ring endomorphism, as a ring endomorphism. -/
def iterHom (σ : R →+* R) : ℕ → (R →+* R)
  | 0 => RingHom.id R
  | n + 1 => σ.comp (iterHom σ n)

@[simp] theorem iterHom_zero (σ : R →+* R) : iterHom σ 0 = RingHom.id R := rfl

theorem iterHom_succ (σ : R →+* R) (n : ℕ) : iterHom σ (n + 1) = σ.comp (iterHom σ n) := rfl

theorem iterHom_add (σ : R →+* R) (m n : ℕ) :
    iterHom σ (m + n) = (iterHom σ m).comp (iterHom σ n) := by
  induction m with
  | zero => simp [iterHom]
  | succ m ih =>
      rw [show m + 1 + n = (m + n) + 1 from by omega, iterHom_succ, ih, iterHom_succ,
        RingHom.comp_assoc]

/-- Iterating the `N`-th iterate multiplies the exponent. -/
theorem iterHom_iterHom (σ : R →+* R) (N j : ℕ) :
    iterHom (iterHom σ N) j = iterHom σ (j * N) := by
  induction j with
  | zero => simp
  | succ j ih =>
      rw [iterHom_succ, ih, ← iterHom_add, show N + j * N = (j + 1) * N from by ring]

/-- The `σ`-twisted family generated by a single matrix: `σⁿ(C)`. -/
def twistedFamily (σ : R →+* R) (C : Matrix ι ι R) (n : ℕ) : Matrix ι ι R :=
  C.map (iterHom σ n)

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem twistedFamily_zero (σ : R →+* R) (C : Matrix ι ι R) :
    twistedFamily σ C 0 = C := by
  ext i j
  rfl

omit [Fintype ι] [DecidableEq ι] in
theorem twistedFamily_map (σ : R →+* R) (C : Matrix ι ι R) (m n : ℕ) :
    twistedFamily σ C (m + n) = (twistedFamily σ C n).map (iterHom σ m) := by
  rw [twistedFamily, twistedFamily, iterHom_add, Matrix.map_map]
  rfl

/-- The ordered product `C · σ(C) ⋯ σ^{n-1}(C)`. -/
def twistedChain (σ : R →+* R) (C : Matrix ι ι R) : ℕ → Matrix ι ι R
  | 0 => 1
  | n + 1 => twistedChain σ C n * twistedFamily σ C n

@[simp] theorem twistedChain_zero (σ : R →+* R) (C : Matrix ι ι R) :
    twistedChain σ C 0 = 1 := rfl

@[simp] theorem twistedChain_succ (σ : R →+* R) (C : Matrix ι ι R) (n : ℕ) :
    twistedChain σ C (n + 1) = twistedChain σ C n * twistedFamily σ C n := rfl

@[simp] theorem twistedChain_one (σ : R →+* R) (C : Matrix ι ι R) :
    twistedChain σ C 1 = C := by
  rw [twistedChain_succ, twistedChain_zero, twistedFamily_zero, one_mul]

/-- **The chain also recurses from the left.** -/
theorem twistedChain_left (σ : R →+* R) (C : Matrix ι ι R) (n : ℕ) :
    twistedChain σ C (n + 1) = C * (twistedChain σ C n).map σ := by
  induction n with
  | zero =>
      rw [twistedChain_one, twistedChain_zero,
        Matrix.map_one _ (map_zero σ) (map_one σ), mul_one]
  | succ n ih =>
      have hmap : twistedFamily σ C (n + 1) = (twistedFamily σ C n).map σ := by
        rw [add_comm n 1, twistedFamily_map, iterHom_succ, iterHom_zero, RingHom.comp_id]
      have hstep : twistedChain σ C n * twistedFamily σ C n
          = C * (twistedChain σ C n).map σ := ih
      rw [twistedChain_succ, ih, hmap, mul_assoc, ← Matrix.map_mul, hstep]

/-- **The chain splits.** -/
theorem twistedChain_add (σ : R →+* R) (C : Matrix ι ι R) (m n : ℕ) :
    twistedChain σ C (m + n)
      = twistedChain σ C m * (twistedChain σ C n).map (iterHom σ m) := by
  induction n with
  | zero =>
      simp [Matrix.map_one _ (map_zero (iterHom σ m)) (map_one (iterHom σ m))]
  | succ n ih =>
      have hstep : twistedChain σ C (m + n) * twistedFamily σ C (m + n)
          = twistedChain σ C (m + n + 1) := rfl
      rw [show m + (n + 1) = m + n + 1 from by omega, ← hstep, ih, twistedFamily_map,
        mul_assoc, ← Matrix.map_mul]
      rfl

/-- **Restarting a twisted chain at step `N` produces the twisted chain of its `N`-step block, with
`σ^N` as the twist.**  So the class of twisted chains is closed under restart, and every invariant
of a twisted chain recurses along its restarts. -/
theorem twistedChain_restart (σ : R →+* R) (C : Matrix ι ι R) (N k : ℕ) :
    twistedChain σ C (k * N)
      = twistedChain (iterHom σ N) (twistedChain σ C N) k := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hblock : twistedFamily (iterHom σ N) (twistedChain σ C N) k
          = (twistedChain σ C N).map (iterHom σ (k * N)) := by
        rw [twistedFamily, iterHom_iterHom]
      rw [show (k + 1) * N = k * N + N from by ring, twistedChain_add, ih, ← hblock]
      rfl

theorem twistedChain_eq_zero_restart_iff (σ : R →+* R) (C : Matrix ι ι R) (N k : ℕ) :
    twistedChain σ C (k * N) = 0
      ↔ twistedChain (iterHom σ N) (twistedChain σ C N) k = 0 := by
  rw [twistedChain_restart]

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry.DiffOp

open GaloisForLFunctions.HTGeometry

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem twistedChain_eq_chainProdK {K : Type*} [Field K] (σ : K →+* K) (C : Matrix ι ι K) (n : ℕ) :
    twistedChain σ C n = chainProdK (twistedFamily σ C) n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [twistedChain_succ, chainProdK_succ, ih]

theorem twistedChain_eq_chainProd {K : Type*} [Field K] [Differential K]
    (σ : DiffOp K →+* DiffOp K) (C : Matrix ι ι (DiffOp K)) (n : ℕ) :
    twistedChain σ C n = chainProd (twistedFamily σ C) n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [twistedChain_succ, chainProd_succ, ih]

end GaloisForLFunctions.HTGeometry.DiffOp
