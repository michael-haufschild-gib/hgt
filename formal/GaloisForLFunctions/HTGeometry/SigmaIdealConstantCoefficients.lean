import GaloisForLFunctions.HTGeometry.DifferenceSigmaSimple

/-!
# `σ`-ideals of a ring with a constant basis are generated by constants

The Galois correspondence for a Picard--Vessiot ring rests on the following purely algebraic fact,
and not on any model theory.  Let `A` be a difference ring which is an algebra over a `σ`-simple
difference ring `R`, and suppose `A` carries a family of *constants* linearly independent over `R`.
Then every nonzero element of a `σ`-ideal expressible in that family produces a nonzero element of
the same ideal all of whose coefficients are constants of `R`.

The proof is the minimal-support argument run one level up: the `j`-th coefficients of the elements
of the ideal supported in a fixed finite set form a `σ`-ideal of `R`, so `σ`-simplicity normalises
one coefficient to one, and subtracting the shifted element strictly shrinks the support.

For the tensor square of a Picard--Vessiot ring the comparison matrix supplies exactly such a family
of constants, so this is the engine which turns the two torsor halves into the ideal correspondence.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Linear independence of a family over the base, in the finite-support form used here. -/
def BasisIndependentOver (R : Type*) [CommRing R] {A ι : Type*} [CommRing A] [Algebra R A]
    (b : ι → A) : Prop :=
  ∀ (t : Finset ι) (ρ : ι → R), (∑ j ∈ t, algebraMap R A (ρ j) * b j) = 0 → ∀ j ∈ t, ρ j = 0

/-- **`σ`-ideals are generated by constant coefficients.** -/
theorem exists_constant_coeff_mem_sigmaIdeal [Nontrivial R]
    (σR : R ≃+* R) (σA : A ≃+* A)
    (hcompat : ∀ r : R, σA (algebraMap R A r) = algebraMap R A (σR r))
    (hsimple : IsSigmaSimple σR)
    {ι : Type*} [DecidableEq ι] (b : ι → A) (hb : ∀ j, σA (b j) = b j)
    (I : Ideal A) (hI : IsSigmaIdeal σA I) :
    ∀ (n : ℕ) (s : Finset ι) (r : ι → R), s.card = n →
      (∃ j ∈ s, r j ≠ 0) → (∑ j ∈ s, algebraMap R A (r j) * b j) ∈ I →
      ∃ (t : Finset ι) (d : ι → R), t.Nonempty ∧ (∀ j ∈ t, σR (d j) = d j) ∧
        (∀ j ∈ t, d j ≠ 0) ∧ (∑ j ∈ t, algebraMap R A (d j) * b j) ∈ I := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro s r hcard hne hmem
    obtain ⟨j₁, hj₁s, hj₁⟩ := hne
    have hshiftsum : ∀ u : ι → R,
        (∑ j ∈ s, algebraMap R A (σR (u j)) * b j)
          = σA (∑ j ∈ s, algebraMap R A (u j) * b j) := by
      intro u
      rw [map_sum]
      exact (Finset.sum_congr rfl fun j _ => by rw [map_mul, hcompat, hb]).symm
    set L : Ideal R :=
      { carrier := {ρ : R | ∃ u : ι → R, u j₁ = ρ ∧
          (∑ j ∈ s, algebraMap R A (u j) * b j) ∈ I}
        add_mem' := by
          rintro x y ⟨u, hu, huI⟩ ⟨v, hv, hvI⟩
          refine ⟨fun j => u j + v j, by rw [← hu, ← hv], ?_⟩
          have hsum : (∑ j ∈ s, algebraMap R A (u j + v j) * b j)
              = (∑ j ∈ s, algebraMap R A (u j) * b j)
                + ∑ j ∈ s, algebraMap R A (v j) * b j := by
            rw [← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun j _ => by rw [map_add, add_mul]
          rw [hsum]
          exact I.add_mem huI hvI
        zero_mem' := by
          refine ⟨fun _ => 0, rfl, ?_⟩
          have hz : (∑ j ∈ s, algebraMap R A (0 : R) * b j) = 0 := by simp
          rw [hz]
          exact I.zero_mem
        smul_mem' := by
          rintro c x ⟨u, hu, huI⟩
          refine ⟨fun j => c * u j, by rw [← hu]; rfl, ?_⟩
          have hsum : (∑ j ∈ s, algebraMap R A (c * u j) * b j)
              = algebraMap R A c * ∑ j ∈ s, algebraMap R A (u j) * b j := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl fun j _ => by rw [map_mul]; ring
          rw [hsum]
          exact I.mul_mem_left _ huI } with hLdef
    have hLsigma : IsSigmaIdeal σR L := by
      rintro x ⟨u, hu, huI⟩
      refine ⟨fun j => σR (u j), by rw [← hu], ?_⟩
      rw [hshiftsum u]
      exact hI _ huI
    have hLne : L ≠ ⊥ := by
      intro hbot
      apply hj₁
      have hmemL : r j₁ ∈ L := ⟨r, rfl, hmem⟩
      rw [hbot] at hmemL
      simpa using hmemL
    have hLtop : L = ⊤ := (hsimple L hLsigma).resolve_left hLne
    have h1 : (1 : R) ∈ L := by rw [hLtop]; trivial
    obtain ⟨u, hu1, huI⟩ := h1
    set d : ι → R := fun j => u j - σR (u j) with hddef
    have hdval : ∀ j : ι, d j = u j - σR (u j) := fun _ => rfl
    have hdmem : (∑ j ∈ s, algebraMap R A (d j) * b j) ∈ I := by
      have hsub : (∑ j ∈ s, algebraMap R A (d j) * b j)
          = (∑ j ∈ s, algebraMap R A (u j) * b j)
            - ∑ j ∈ s, algebraMap R A (σR (u j)) * b j := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun j _ => by rw [hdval, map_sub, sub_mul]
      rw [hsub, hshiftsum u]
      exact I.sub_mem huI (hI _ huI)
    have hdj₁ : d j₁ = 0 := by
      rw [hdval, hu1, map_one, sub_self]
    by_cases hall : ∀ j ∈ s, d j = 0
    · refine ⟨s.filter (fun j => u j ≠ 0), u, ⟨j₁, ?_⟩, ?_, ?_, ?_⟩
      · rw [Finset.mem_filter]
        exact ⟨hj₁s, by rw [hu1]; exact one_ne_zero⟩
      · intro j hj
        have hjs : j ∈ s := (Finset.mem_filter.mp hj).1
        have hz := hall j hjs
        rw [hdval] at hz
        exact (sub_eq_zero.mp hz).symm
      · intro j hj
        exact (Finset.mem_filter.mp hj).2
      · have hsum : (∑ j ∈ s.filter (fun j => u j ≠ 0), algebraMap R A (u j) * b j)
            = ∑ j ∈ s, algebraMap R A (u j) * b j := by
          refine Finset.sum_subset (Finset.filter_subset _ _) ?_
          intro x hx hxn
          rw [Finset.mem_filter] at hxn
          have hux : u x = 0 := by
            by_contra hc
            exact hxn ⟨hx, hc⟩
          rw [hux, map_zero, zero_mul]
        rw [hsum]
        exact huI
    · push Not at hall
      obtain ⟨j₂, hj₂s, hj₂⟩ := hall
      have hj₂ne : j₂ ≠ j₁ := by
        intro hcon
        rw [hcon] at hj₂
        exact hj₂ hdj₁
      have hsum : (∑ j ∈ s.erase j₁, algebraMap R A (d j) * b j)
          = ∑ j ∈ s, algebraMap R A (d j) * b j := by
        refine Finset.sum_subset (Finset.erase_subset _ _) ?_
        intro x hx hxn
        have hxj : x = j₁ := by
          by_contra hc
          exact hxn (Finset.mem_erase.mpr ⟨hc, hx⟩)
        rw [hxj, hdj₁, map_zero, zero_mul]
      refine ih (s.erase j₁).card ?_ (s.erase j₁) d rfl
        ⟨j₂, Finset.mem_erase.mpr ⟨hj₂ne, hj₂s⟩, hj₂⟩ ?_
      · rw [← hcard]
        exact Finset.card_erase_lt_of_mem hj₁s
      · rw [hsum]
        exact hdmem

/-- **The nonzero conclusion.**  With linear independence the produced element is nonzero. -/
theorem exists_nonzero_constant_coeff_mem_sigmaIdeal [Nontrivial R]
    (σR : R ≃+* R) (σA : A ≃+* A)
    (hcompat : ∀ r : R, σA (algebraMap R A r) = algebraMap R A (σR r))
    (hsimple : IsSigmaSimple σR)
    {ι : Type*} [DecidableEq ι] (b : ι → A) (hb : ∀ j, σA (b j) = b j)
    (hli : BasisIndependentOver R b)
    (I : Ideal A) (hI : IsSigmaIdeal σA I)
    (s : Finset ι) (r : ι → R) (hne : ∃ j ∈ s, r j ≠ 0)
    (hmem : (∑ j ∈ s, algebraMap R A (r j) * b j) ∈ I) :
    ∃ (t : Finset ι) (d : ι → R), (∀ j ∈ t, σR (d j) = d j) ∧
      (∑ j ∈ t, algebraMap R A (d j) * b j) ∈ I ∧
      (∑ j ∈ t, algebraMap R A (d j) * b j) ≠ 0 := by
  obtain ⟨t, d, htne, hconst, hnz, hdI⟩ :=
    exists_constant_coeff_mem_sigmaIdeal σR σA hcompat hsimple b hb I hI
      s.card s r rfl hne hmem
  refine ⟨t, d, hconst, hdI, ?_⟩
  intro hzero
  obtain ⟨j, hj⟩ := htne
  exact hnz j hj (hli t d hzero j hj)

end

end GaloisForLFunctions.HTGeometry
