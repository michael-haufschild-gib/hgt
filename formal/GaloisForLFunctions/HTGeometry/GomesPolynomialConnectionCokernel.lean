import GaloisForLFunctions.HTGeometry.GomesPolynomialDifferentialRemainder
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Exact finite-dimensional cokernels of polynomial connections

Although every real spectral shift of a nonconstant polynomial connection fails to be
invertible, its missing-output space is finite and explicit. Differential remainders
identify the cokernel with the polynomials below the coefficient degree, and hence with
one real coordinate for each of those degrees.
-/

noncomputable section
open Polynomial

namespace GaloisForLFunctions.HTGeometry

/-- Polynomial forcings modulo the outputs generated by the connection. -/
abbrev GomesPolynomialConnectionCokernel (A : ℝ[X]) :=
  ℝ[X] ⧸ LinearMap.range (gomesPolynomialFirstOrderLinearMap A)

/-- Canonical differential remainder identifies the actual quotient with low-degree polynomials. -/
def gomesPolynomialConnectionCokernelEquiv (A : GomesNonconstantPolynomialCoefficient) :
    GomesPolynomialConnectionCokernel A.val ≃ₗ[ℝ] degreeLT ℝ A.val.natDegree :=
  (Submodule.quotEquivOfEq _ _ (gomesPolynomialDifferentialRemainder_ker A).symm).trans
    ((gomesPolynomialDifferentialRemainder A).quotKerEquivOfSurjective
      (gomesPolynomialDifferentialRemainder_surjective A))

/-- A forcing class is represented by its exact differential remainder. -/
theorem gomesPolynomialConnectionCokernelEquiv_mk
    (A : GomesNonconstantPolynomialCoefficient) (Q : ℝ[X]) :
    gomesPolynomialConnectionCokernelEquiv A (Submodule.Quotient.mk Q) =
      gomesPolynomialDifferentialRemainder A Q := by
  simp [gomesPolynomialConnectionCokernelEquiv]

/-- Low-degree coefficients give complete, independent coordinates on the missing-output space. -/
def gomesPolynomialConnectionCokernelCoordinates (A : GomesNonconstantPolynomialCoefficient) :
    GomesPolynomialConnectionCokernel A.val ≃ₗ[ℝ] (Fin A.val.natDegree → ℝ) :=
  (gomesPolynomialConnectionCokernelEquiv A).trans (degreeLTEquiv ℝ A.val.natDegree)

/-- Each quotient coordinate is the corresponding coefficient of the canonical remainder. -/
theorem gomesPolynomialConnectionCokernelCoordinates_mk
    (A : GomesNonconstantPolynomialCoefficient) (Q : ℝ[X]) (i : Fin A.val.natDegree) :
    gomesPolynomialConnectionCokernelCoordinates A (Submodule.Quotient.mk Q) i =
      (gomesPolynomialDifferentialRemainder A Q).val.coeff i := by
  change degreeLTEquiv ℝ A.val.natDegree
    (gomesPolynomialConnectionCokernelEquiv A (Submodule.Quotient.mk Q)) i = _
  rw [gomesPolynomialConnectionCokernelEquiv_mk]
  rfl

/-- The concrete quotient is finite dimensional. -/
instance gomesPolynomialConnectionCokernel_finite (A : GomesNonconstantPolynomialCoefficient) :
    Module.Finite ℝ (GomesPolynomialConnectionCokernel A.val) :=
  Module.Finite.equiv (gomesPolynomialConnectionCokernelCoordinates A).symm

/-- The exact number of independent missing polynomial outputs is the coefficient degree. -/
theorem gomesPolynomialConnectionCokernel_finrank (A : GomesNonconstantPolynomialCoefficient) :
    Module.finrank ℝ (GomesPolynomialConnectionCokernel A.val) = A.val.natDegree := by
  rw [(gomesPolynomialConnectionCokernelCoordinates A).finrank_eq, Module.finrank_fin_fun]

/-- All obstruction coordinates are necessary: the cokernel dimension is strictly positive. -/
theorem gomesPolynomialConnectionCokernel_finrank_pos (A : GomesNonconstantPolynomialCoefficient) :
    0 < Module.finrank ℝ (GomesPolynomialConnectionCokernel A.val) := by
  rw [gomesPolynomialConnectionCokernel_finrank]
  exact gomesNonconstantPolynomialCoefficient_degree_pos A

/-- Equality of forcing classes is exactly equality of their differential remainders. -/
theorem gomesPolynomialConnectionCokernel_mk_eq_iff
    (A : GomesNonconstantPolynomialCoefficient) (Q R : ℝ[X]) :
    (Submodule.Quotient.mk Q : GomesPolynomialConnectionCokernel A.val) = Submodule.Quotient.mk R ↔
      gomesPolynomialDifferentialRemainder A Q = gomesPolynomialDifferentialRemainder A R := by
  rw [← (gomesPolynomialConnectionCokernelEquiv A).injective.eq_iff,
    gomesPolynomialConnectionCokernelEquiv_mk, gomesPolynomialConnectionCokernelEquiv_mk]

/-- Every low-degree polynomial supplies its own canonical quotient representative. -/
theorem gomesPolynomialConnectionCokernelEquiv_low_degree
    (A : GomesNonconstantPolynomialCoefficient) (R : degreeLT ℝ A.val.natDegree) :
    gomesPolynomialConnectionCokernelEquiv A (Submodule.Quotient.mk R.val) = R := by
  rw [gomesPolynomialConnectionCokernelEquiv_mk, gomesPolynomialDifferentialRemainder_low_degree]

end GaloisForLFunctions.HTGeometry
