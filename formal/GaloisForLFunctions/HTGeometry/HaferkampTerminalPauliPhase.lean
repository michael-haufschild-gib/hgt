import GaloisForLFunctions.HTGeometry.HaferkampTerminalBlockEmbedding
import GaloisForLFunctions.HTGeometry.StaticLocalLaboratoryComplexityGrowthLaw

open scoped BigOperators ComplexConjugate Matrix

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Eigenvalue of the determinant-one local phase generated by `I ⊗ Z`. -/
def terminalPauliPhaseEigenvalue (t : ℝ) (x : Bool × Bool) : ℂ :=
  if x.2 then Complex.exp (-(Complex.I * (t : ℂ))) else Complex.exp (Complex.I * (t : ℂ))

/-- A literal one-parameter `SU(4)` phase in the local `I ⊗ Z` direction. -/
def terminalPauliPhaseMatrix (t : ℝ) : Matrix (Bool × Bool) (Bool × Bool) ℂ :=
  Matrix.diagonal (terminalPauliPhaseEigenvalue t)

theorem terminalPauliPhaseEigenvalue_norm (t : ℝ) (x : Bool × Bool) :
    ‖terminalPauliPhaseEigenvalue t x‖ = 1 := by
  rcases x with ⟨x, b⟩
  simp only [terminalPauliPhaseEigenvalue]
  split_ifs <;> rw [Complex.norm_exp] <;> simp

theorem terminalPauliPhaseMatrix_det (t : ℝ) : (terminalPauliPhaseMatrix t).det = 1 := by
  rw [terminalPauliPhaseMatrix, Matrix.det_diagonal, Fintype.prod_prod_type,
    Fintype.prod_bool, Fintype.prod_bool]
  have hphase :
      Complex.exp (-(Complex.I * (t : ℂ))) * Complex.exp (Complex.I * (t : ℂ)) = 1 := by
    rw [← Complex.exp_add]
    have hzero : -(Complex.I * (t : ℂ)) + Complex.I * (t : ℂ) = 0 := by ring
    rw [hzero, Complex.exp_zero]
  simpa [terminalPauliPhaseEigenvalue, hphase]

theorem terminalPauliPhaseMatrix_mem_specialUnitary (t : ℝ) :
    terminalPauliPhaseMatrix t ∈ Matrix.specialUnitaryGroup (Bool × Bool) ℂ := by
  rw [Matrix.mem_specialUnitaryGroup_iff]
  refine ⟨?_, terminalPauliPhaseMatrix_det t⟩
  exact StaticLocalLaboratoryComplexityGrowthLaw.mem_unitaryGroup_diagonal_general
    (terminalPauliPhaseEigenvalue t) (terminalPauliPhaseEigenvalue_norm t)

/-- The local determinant-one phase as an actual `SU(4)` path. -/
def terminalPauliPhase (t : ℝ) : Matrix.specialUnitaryGroup (Bool × Bool) ℂ :=
  ⟨terminalPauliPhaseMatrix t, terminalPauliPhaseMatrix_mem_specialUnitary t⟩

@[simp] theorem terminalPauliPhaseMatrix_zero : terminalPauliPhaseMatrix 0 = 1 := by
  ext x y
  by_cases hxy : x = y
  · subst y
    rcases x with ⟨a, b⟩
    simp [terminalPauliPhaseMatrix, terminalPauliPhaseEigenvalue]
  · simp [terminalPauliPhaseMatrix, hxy]

@[simp] theorem terminalPauliPhase_zero : terminalPauliPhase 0 = 1 := by
  apply Subtype.ext
  exact terminalPauliPhaseMatrix_zero

/-- Entrywise real derivative of a finite complex matrix curve.  This avoids
depending on a particular equivalent finite-dimensional matrix norm. -/
def EntrywiseMatrixHasDerivAt {ι κ : Type*}
    (F : ℝ → Matrix ι κ ℂ) (F' : Matrix ι κ ℂ) (t : ℝ) : Prop :=
  ∀ i j, HasDerivAt (fun s : ℝ => F s i j) (F' i j) t

theorem entrywiseHasDerivAt_terminalPauliPhaseMatrix :
    EntrywiseMatrixHasDerivAt terminalPauliPhaseMatrix
      (Complex.I • boolTwoQubitPauli none (some 2)) 0 := by
  have hplusInner : HasDerivAt (fun t : ℝ => Complex.I * (t : ℂ)) Complex.I 0 := by
    simpa using (Complex.ofRealCLM.hasDerivAt (x := (0 : ℝ))).const_mul Complex.I
  have hminusInner : HasDerivAt (fun t : ℝ => -(Complex.I * (t : ℂ))) (-Complex.I) 0 := by
    convert ((Complex.ofRealCLM.hasDerivAt (x := (0 : ℝ))).const_mul Complex.I).neg using 1 <;>
      simp
  have hplus : HasDerivAt (fun t : ℝ => Complex.exp (Complex.I * (t : ℂ))) Complex.I 0 := by
    simpa [Function.comp_def] using (Complex.hasDerivAt_exp (0 : ℂ)).scomp hplusInner
  have hminus : HasDerivAt (fun t : ℝ => Complex.exp (-(Complex.I * (t : ℂ)))) (-Complex.I) 0 := by
    simpa [Function.comp_def] using (Complex.hasDerivAt_exp (0 : ℂ)).scomp hminusInner
  intro x
  intro y
  by_cases hxy : x = y
  · subst y
    rcases x with ⟨a, b⟩
    fin_cases b
    · simpa [terminalPauliPhaseMatrix, terminalPauliPhaseEigenvalue,
        boolTwoQubitPauli, boolPauliOption, finiteQubitPauli, Matrix.kronecker] using hplus
    · simpa [terminalPauliPhaseMatrix, terminalPauliPhaseEigenvalue,
        boolTwoQubitPauli, boolPauliOption, finiteQubitPauli, Matrix.kronecker] using hminus
  · have hpauli : boolTwoQubitPauli none (some 2) x y = 0 := by
      rcases x with ⟨x₁, x₂⟩
      rcases y with ⟨y₁, y₂⟩
      fin_cases x₁ <;> fin_cases x₂ <;> fin_cases y₁ <;> fin_cases y₂ <;>
        simp_all [boolTwoQubitPauli, boolPauliOption, finiteQubitPauli, Matrix.kronecker]
    simpa [terminalPauliPhaseMatrix, hxy, hpauli] using
      (hasDerivAt_const (x := (0 : ℝ)) (c := (0 : ℂ)))

/-- Left multiplication of any local gate by the exact Pauli phase stays in `SU(4)`. -/
def terminalPauliGatePath (U : Matrix.specialUnitaryGroup (Bool × Bool) ℂ) (t : ℝ) :
    Matrix.specialUnitaryGroup (Bool × Bool) ℂ :=
  terminalPauliPhase t * U

@[simp] theorem terminalPauliGatePath_zero
    (U : Matrix.specialUnitaryGroup (Bool × Bool) ℂ) : terminalPauliGatePath U 0 = U := by
  simp [terminalPauliGatePath]

theorem entrywiseHasDerivAt_terminalPauliGatePath
    (U : Matrix.specialUnitaryGroup (Bool × Bool) ℂ) :
    EntrywiseMatrixHasDerivAt (fun t : ℝ =>
      (terminalPauliGatePath U t : Matrix (Bool × Bool) (Bool × Bool) ℂ))
      (Complex.I • (boolTwoQubitPauli none (some 2) *
        (U : Matrix (Bool × Bool) (Bool × Bool) ℂ))) 0 := by
  intro x y
  change HasDerivAt (fun t : ℝ => ∑ z,
    terminalPauliPhaseMatrix t x z * (U : Matrix (Bool × Bool) (Bool × Bool) ℂ) z y)
    ((Complex.I • (boolTwoQubitPauli none (some 2) *
      (U : Matrix (Bool × Bool) (Bool × Bool) ℂ)) :
      Matrix (Bool × Bool) (Bool × Bool) ℂ) x y) 0
  simpa only [Matrix.smul_mul, Matrix.mul_apply] using
    (HasDerivAt.fun_sum (fun z _ =>
      (entrywiseHasDerivAt_terminalPauliPhaseMatrix x z).mul_const
        ((U : Matrix (Bool × Bool) (Bool × Bool) ℂ) z y)))

end

end GaloisForLFunctions.HTGeometry
