import GaloisForLFunctions.HTGeometry.DifferentialKernelCharacteristic

/-!
# Relations persist, with their rank, when the coefficient field grows

A differential-polynomial relation of an element over a coefficient field is still a relation over any
larger coefficient field, and pushing its coefficients forward along an injective map changes neither
its order nor its degree in the leader.

So the minimal rank of a relation can only drop when the coefficient field grows.  This monotonicity
is what a Lüroth argument compares: the rank over the field generated by one coefficient ratio against
the rank over the whole intermediate field.
-/

namespace GaloisForLFunctions

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- **Evaluation is unchanged by enlarging the coefficient field.** -/
theorem differentialPolynomialEvalOver_map_inclusion {G₁ G₂ : IntermediateField F E}
    (h : G₁ ≤ G₂) (y : E) (P : DifferentialPolynomial Unit G₁) :
    differentialPolynomialEvalOver (K := G₂) (fun _ : Unit ↦ y)
        (MvPolynomial.map (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom P) =
      differentialPolynomialEvalOver (K := G₁) (fun _ : Unit ↦ y) P := by
  change MvPolynomial.eval₂ (algebraMap G₂ E)
      (fun a : Unit × ℕ ↦ differentialJet a.2 y)
        (MvPolynomial.map (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom P) =
    MvPolynomial.eval₂ (algebraMap G₁ E)
      (fun a : Unit × ℕ ↦ differentialJet a.2 y) P
  rw [MvPolynomial.eval₂_map]
  rfl

/-- **A relation over a smaller coefficient field is a relation over a larger one.** -/
theorem mem_differentialIntermediateRelationIdeal_map {G₁ G₂ : IntermediateField F E}
    (h : G₁ ≤ G₂) (y : E) {P : DifferentialPolynomial Unit G₁}
    (hP : P ∈ differentialIntermediateRelationIdeal G₁ y) :
    MvPolynomial.map (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom P
      ∈ differentialIntermediateRelationIdeal G₂ y := by
  rw [mem_differentialIntermediateRelationIdeal_iff] at hP ⊢
  rw [differentialPolynomialEvalOver_map_inclusion h y P]
  exact hP

/-- **Pushing coefficients forward injectively preserves the order.** -/
theorem scalarDifferentialPolynomialOrder_map {K L : Type*} [CommRing K] [CommRing L]
    {f : K →+* L} (hf : Function.Injective f) (P : DifferentialPolynomial Unit K) :
    scalarDifferentialPolynomialOrder (MvPolynomial.map f P)
      = scalarDifferentialPolynomialOrder P := by
  unfold scalarDifferentialPolynomialOrder
  rw [MvPolynomial.vars_map_of_injective _ hf]

/-- **Pushing coefficients forward injectively preserves the degree in the leader.** -/
theorem scalarDifferentialPolynomialLeaderDegree_map {K L : Type*} [CommRing K] [CommRing L]
    {f : K →+* L} (hf : Function.Injective f) (P : DifferentialPolynomial Unit K) :
    scalarDifferentialPolynomialLeaderDegree (MvPolynomial.map f P)
      = scalarDifferentialPolynomialLeaderDegree P := by
  unfold scalarDifferentialPolynomialLeaderDegree scalarDifferentialPolynomialLeader
  rw [scalarDifferentialPolynomialOrder_map hf P]
  rw [MvPolynomial.degreeOf_eq_sup, MvPolynomial.degreeOf_eq_sup,
    MvPolynomial.support_map_of_injective _ hf]

/-- A relation of minimal rank over a larger field has rank at most that of any relation over a
smaller one. -/
theorem minimalRank_le_of_le {G₁ G₂ : IntermediateField F E} (h : G₁ ≤ G₂) (y : E)
    {P : DifferentialPolynomial Unit G₁} {Q : DifferentialPolynomial Unit G₂}
    (hP : P ∈ differentialIntermediateRelationIdeal G₁ y) (hPne : P ≠ 0)
    (hPvars : (MvPolynomial.vars P).Nonempty)
    (hQ : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G₂ y : Set _) Q) :
    scalarDifferentialPolynomialOrder Q ≤ scalarDifferentialPolynomialOrder P := by
  have hmap := mem_differentialIntermediateRelationIdeal_map h y hP
  have hne : MvPolynomial.map (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom P ≠ 0 := by
    intro h0
    refine hPne ?_
    have hinj : Function.Injective
        ((IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom) :=
      (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).injective
    exact MvPolynomial.map_injective _ hinj (by simpa using h0)
  have hinj : Function.Injective
      ((IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom) :=
    (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).injective
  have hvars : (MvPolynomial.vars
      (MvPolynomial.map (IntermediateField.inclusion h : G₁ →ₐ[F] G₂).toRingHom P)).Nonempty := by
    rw [MvPolynomial.vars_map_of_injective _ hinj]
    exact hPvars
  have hle := (hQ.2.2.2 hmap hne hvars).1
  rwa [scalarDifferentialPolynomialOrder_map hinj P] at hle

end

end GaloisForLFunctions
