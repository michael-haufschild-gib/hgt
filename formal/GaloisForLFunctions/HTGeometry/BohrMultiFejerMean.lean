import GaloisForLFunctions.HTGeometry.BohrMultiFejerKernel

/-!
# The multi-dimensional Fejér kernel has mean one

Expanding the product of one-dimensional Fejér kernels gives a trigonometric polynomial whose
frequencies are the integer combinations `∑_j (a_j − b_j)β_j`.  If the base frequencies are linearly
independent over `ℚ`, such a combination vanishes only on the diagonal `a_j = b_j`, so the mean of
the kernel is the sum of the weights over the diagonal:

`(∏_j (N_j+1)) · ∏_j (N_j+1)⁻¹ = 1`.

Together with nonnegativity and the concentration bound, the multi-dimensional Fejér kernel is
therefore an approximate identity of total mass one on the group generated by the base frequencies.
-/

open Filter Topology

namespace GaloisForLFunctions

noncomputable section

open scoped BigOperators

/-- Rational independence forces a vanishing integer combination to be diagonal. -/
theorem multiFejer_diagonal_of_freq_eq_zero {ι : Type*} [Fintype ι] {β : ι → ℝ}
    (hind : LinearIndependent ℚ β) (v : ι → ℕ × ℕ)
    (hv : ∑ j : ι, (((v j).1 : ℝ) - ((v j).2 : ℝ)) * β j = 0) :
    ∀ j : ι, (v j).1 = (v j).2 := by
  intro j
  have hq : ∑ i : ι, (((v i).1 : ℚ) - ((v i).2 : ℚ)) • β i = 0 := by
    have hcast : ∀ i : ι, (((v i).1 : ℚ) - ((v i).2 : ℚ)) • β i
        = (((v i).1 : ℝ) - ((v i).2 : ℝ)) * β i := by
      intro i
      rw [Rat.smul_def]
      push_cast
      ring
    rw [Finset.sum_congr rfl fun i _ => hcast i]
    exact hv
  have hzero := (Fintype.linearIndependent_iff.mp hind)
    (fun i => ((v i).1 : ℚ) - ((v i).2 : ℚ)) hq j
  have : ((v j).1 : ℚ) = ((v j).2 : ℚ) := sub_eq_zero.mp hzero
  exact_mod_cast this

/-- **The multi-dimensional Fejér kernel has mean one.** -/
theorem bohrMean_multiFejerKernel {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → ℝ} (hind : LinearIndependent ℚ β) (N : ι → ℕ) :
    bohrMean (multiFejerKernel β N) = 1 := by
  classical
  set Box : Finset (ι → ℕ × ℕ) :=
    Fintype.piFinset (fun j : ι => Finset.range (N j + 1) ×ˢ Finset.range (N j + 1)) with hBox
  set C : ℂ := ∏ j : ι, ((N j : ℂ) + 1)⁻¹ with hC
  set mu : (ι → ℕ × ℕ) → ℝ :=
    fun v => ∑ j : ι, (((v j).1 : ℝ) - ((v j).2 : ℝ)) * β j with hmu
  have hexp : multiFejerKernel β N = fun u => ∑ v ∈ Box, C * expChar (mu v) u :=
    funext fun u => multiFejerKernel_eq_sum β N u
  rw [hexp, bohrMean_sum_expChar Box (fun _ => C) mu]
  -- only the diagonal survives
  have hstep : ∀ v ∈ Box,
      (if mu v = 0 then C else 0) = if (∀ j : ι, (v j).1 = (v j).2) then C else 0 := by
    intro v _
    by_cases hd : ∀ j : ι, (v j).1 = (v j).2
    · rw [if_pos hd, if_pos]
      rw [hmu]
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [hd j]
      ring
    · rw [if_neg hd, if_neg]
      intro hz
      exact hd (multiFejer_diagonal_of_freq_eq_zero hind v hz)
  rw [Finset.sum_congr rfl hstep, ← Finset.sum_filter]
  -- the diagonal is the image of the index box
  set Diag : Finset (ι → ℕ) := Fintype.piFinset (fun j : ι => Finset.range (N j + 1)) with hDiag
  have hinj : Function.Injective (fun (A : ι → ℕ) => fun j : ι => (A j, A j)) := by
    intro A B hAB
    funext j
    have := congrFun hAB j
    exact congrArg Prod.fst this
  have hfilter : (Box.filter fun v => ∀ j : ι, (v j).1 = (v j).2)
      = Diag.image (fun (A : ι → ℕ) => fun j : ι => (A j, A j)) := by
    ext v
    simp only [Finset.mem_filter, Finset.mem_image, hBox, hDiag, Fintype.mem_piFinset,
      Finset.mem_product, Finset.mem_range]
    constructor
    · rintro ⟨hv, hd⟩
      refine ⟨fun j => (v j).1, fun j => (hv j).1, ?_⟩
      funext j
      exact Prod.ext rfl (hd j)
    · rintro ⟨A, hA, rfl⟩
      exact ⟨fun j => ⟨hA j, hA j⟩, fun j => rfl⟩
  rw [hfilter, Finset.sum_const, Finset.card_image_of_injective _ hinj, hDiag,
    Fintype.card_piFinset]
  have hcard : ∀ j : ι, (Finset.range (N j + 1)).card = N j + 1 := fun j => Finset.card_range _
  rw [Finset.prod_congr rfl fun j _ => hcard j, nsmul_eq_mul, hC]
  push_cast
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_eq_one fun j _ => ?_
  have hne : ((N j : ℂ) + 1) ≠ 0 := by
    intro hz
    have hR : ((N j : ℝ) + 1) = 0 := by exact_mod_cast hz
    have : (0 : ℝ) < (N j : ℝ) + 1 := by positivity
    linarith
  field_simp

end

end GaloisForLFunctions
