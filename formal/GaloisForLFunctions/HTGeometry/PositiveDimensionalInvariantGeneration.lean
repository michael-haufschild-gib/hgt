import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.RingTheory.TensorProduct.IncludeLeftSubRight

/-!
# Positive-dimensional differential invariant generation

For an affine group-scheme torsor, the canonical torsor map identifies the coaction equalizer
with the faithfully-flat descent equalizer.  Consequently its coinvariants are exactly the base
field.  Applying this with the differential field generated by observables proves differential
invariant generation without a finiteness or zero-dimensionality hypothesis on the acting group
coordinate algebra.
-/

open scoped TensorProduct

namespace GaloisForLFunctions.HTGeometry

universe u v w

section Torsor

variable (E : Type u) (L : Type v) (A : Type w)
variable [Field E] [Field L] [CommRing A]
variable [Algebra E L] [Algebra E A]

/-- Algebraic data of an affine right torsor over `E`: the canonical torsor map is an
isomorphism and carries the two faithfully-flat descent maps to the constant map and coaction. -/
structure AffineTorsorCoaction where
  coaction : L →ₐ[E] L ⊗[E] A
  canonical : L ⊗[E] L ≃ₐ[L] L ⊗[E] A
  canonical_includeLeft : ∀ x : L,
    canonical (Algebra.TensorProduct.includeLeft
      (R := E) (S := L) (A := L) (B := L) x) =
      Algebra.TensorProduct.includeLeft
        (R := E) (S := L) (A := L) (B := A) x
  canonical_includeRight : ∀ x : L,
    canonical (Algebra.TensorProduct.includeRight (R := E) (A := L) (B := L) x) = coaction x

namespace AffineTorsorCoaction

variable {E L A}

/-- Coaction coinvariants of an affine torsor are exactly scalars from its base field.  The proof
uses effective faithfully-flat descent, not a pointwise enumeration of the acting group. -/
theorem coinvariant_eq_range (T : AffineTorsorCoaction E L A) :
    {x : L | T.coaction x = Algebra.TensorProduct.includeLeft
      (R := E) (S := L) (A := L) (B := A) x} =
      Set.range (algebraMap E L) := by
  ext x
  constructor
  · intro hx
    rw [← Algebra.IsEffective.eqLocus_includeLeft_includeRight
      (Algebra.IsEffective.of_faithfullyFlat E L)]
    change Algebra.TensorProduct.includeLeft
        (R := E) (S := L) (A := L) (B := L) x =
      Algebra.TensorProduct.includeRight (R := E) (A := L) (B := L) x
    apply T.canonical.injective
    rw [T.canonical_includeLeft, T.canonical_includeRight, hx]
  · rintro ⟨e, rfl⟩
    change T.coaction (algebraMap E L e) =
      Algebra.TensorProduct.includeLeft
        (R := E) (S := L) (A := L) (B := A) (algebraMap E L e)
    rw [T.coaction.commutes]
    simp

end AffineTorsorCoaction

/-- An affine torsor together with a family of rational-point evaluations which jointly separate
regular functions on the acting group after extension to `L`. -/
structure PointSeparatingTorsorAction extends AffineTorsorCoaction E L A where
  Point : Type (max u v w)
  evaluation : Point → (L ⊗[E] A →ₐ[L] L)
  evaluation_jointlyInjective :
    Function.Injective (fun z : L ⊗[E] A ↦ fun p ↦ evaluation p z)

namespace PointSeparatingTorsorAction

variable {E L A}

/-- Elements fixed under every separating rational point are exactly the base-field scalars. -/
theorem fixedByPoints_eq_range (T : PointSeparatingTorsorAction E L A) :
    {x : L | ∀ p, T.evaluation p (T.coaction x) = x} =
      Set.range (algebraMap E L) := by
  rw [← T.toAffineTorsorCoaction.coinvariant_eq_range]
  ext x
  constructor
  · intro hx
    change T.coaction x = Algebra.TensorProduct.includeLeft
      (R := E) (S := L) (A := L) (B := A) x
    apply T.evaluation_jointlyInjective
    funext p
    calc
      T.evaluation p (T.coaction x) = x := hx p
      _ = T.evaluation p (Algebra.TensorProduct.includeLeft
          (R := E) (S := L) (A := L) (B := A) x) :=
        ((T.evaluation p).commutes x).symm
  · intro hx p
    rw [hx]
    exact (T.evaluation p).commutes x

end PointSeparatingTorsorAction

end Torsor

section DifferentialGeneration

variable {C : Type u} {K : Type v} {A : Type w}
variable [Field C] [Field K] [Algebra C K] [Differential K]
variable (observables : Set K) [CommRing A]
variable [Algebra (differentialAdjoin C observables) A]

/-- If the observable quotient is an affine torsor under a group scheme, then its group-scheme
coinvariants are exactly the differential field generated by the observables.  In particular this
applies unchanged when the acting affine group scheme is positive-dimensional. -/
theorem differentialAdjoin_eq_coactionCoinvariants
    (T : AffineTorsorCoaction (differentialAdjoin C observables) K A) :
    (differentialAdjoin C observables : Set K) =
      {x : K | T.coaction x = Algebra.TensorProduct.includeLeft
        (R := differentialAdjoin C observables)
        (S := K) (A := K) (B := A) x} := by
  change (IntermediateField.adjoin C (differentialJetSet observables) : Set K) = _
  rw [IntermediateField.adjoin_eq_range_algebraMap_adjoin]
  exact T.coinvariant_eq_range.symm

/-- Rational-point form of differential invariant generation: when rational points jointly
separate the acting group coordinate algebra, their common fixed field is precisely the
differential field generated by the quotient observables. -/
theorem differentialAdjoin_eq_pointInvariants
    (T : PointSeparatingTorsorAction (differentialAdjoin C observables) K A) :
    (differentialAdjoin C observables : Set K) =
      {x : K | ∀ p, T.evaluation p (T.coaction x) = x} := by
  change (IntermediateField.adjoin C (differentialJetSet observables) : Set K) = _
  rw [IntermediateField.adjoin_eq_range_algebraMap_adjoin]
  exact T.fixedByPoints_eq_range.symm

end DifferentialGeneration

end GaloisForLFunctions.HTGeometry
