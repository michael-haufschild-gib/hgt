import GaloisForLFunctions.HTGeometry.GomesPolynomialDifferentialDivision

/-!
# Canonical source and obstruction projections for polynomial connections

Differential division supplies linear source and remainder maps. Vanishing remainder is
exactly polynomial solvability. Equality of remainders is exactly equality modulo the
connection range, so the remainder is a complete obstruction rather than a one-sided test.
-/

noncomputable section
open Polynomial

namespace GaloisForLFunctions.HTGeometry

/-- The source polynomial recovered by canonical differential division. -/
def gomesPolynomialDifferentialSource (A : GomesNonconstantPolynomialCoefficient) : ℝ[X] →ₗ[ℝ] ℝ[X] :=
  (LinearMap.fst ℝ ℝ[X] (degreeLT ℝ A.val.natDegree)).comp
    (gomesPolynomialDifferentialDivisionEquiv A).toLinearMap

/-- The canonical finite-dimensional obstruction to polynomial solvability. -/
def gomesPolynomialDifferentialRemainder (A : GomesNonconstantPolynomialCoefficient) :
    ℝ[X] →ₗ[ℝ] degreeLT ℝ A.val.natDegree :=
  (LinearMap.snd ℝ ℝ[X] (degreeLT ℝ A.val.natDegree)).comp
    (gomesPolynomialDifferentialDivisionEquiv A).toLinearMap

/-- The source map recovers the prescribed source from every assembled decomposition. -/
theorem gomesPolynomialDifferentialSource_assemble (A : GomesNonconstantPolynomialCoefficient)
    (B : ℝ[X]) (R : degreeLT ℝ A.val.natDegree) :
    gomesPolynomialDifferentialSource A (gomesPolynomialFirstOrderOperator A.val B + R.val) = B := by
  change (gomesPolynomialDifferentialDivisionEquiv A _).1 = B
  rw [gomesPolynomialDifferentialDivisionEquiv_assemble]

/-- The remainder map recovers the prescribed remainder from every assembled decomposition. -/
theorem gomesPolynomialDifferentialRemainder_assemble (A : GomesNonconstantPolynomialCoefficient)
    (B : ℝ[X]) (R : degreeLT ℝ A.val.natDegree) :
    gomesPolynomialDifferentialRemainder A (gomesPolynomialFirstOrderOperator A.val B + R.val) = R := by
  change (gomesPolynomialDifferentialDivisionEquiv A _).2 = R
  rw [gomesPolynomialDifferentialDivisionEquiv_assemble]

/-- Every polynomial is the sum of its generated output and its canonical obstruction. -/
theorem gomesPolynomialDifferentialRemainder_decomposition
    (A : GomesNonconstantPolynomialCoefficient) (Q : ℝ[X]) :
    Q = gomesPolynomialFirstOrderOperator A.val (gomesPolynomialDifferentialSource A Q) +
      (gomesPolynomialDifferentialRemainder A Q).val :=
  gomesPolynomialDifferentialDivisionEquiv_reconstruct A Q

/-- Generated outputs have zero canonical obstruction. -/
theorem gomesPolynomialDifferentialRemainder_operator
    (A : GomesNonconstantPolynomialCoefficient) (B : ℝ[X]) :
    gomesPolynomialDifferentialRemainder A (gomesPolynomialFirstOrderOperator A.val B) = 0 := by
  simpa using gomesPolynomialDifferentialRemainder_assemble A B 0

/-- The obstruction projection fixes every low-degree representative. -/
theorem gomesPolynomialDifferentialRemainder_low_degree
    (A : GomesNonconstantPolynomialCoefficient) (R : degreeLT ℝ A.val.natDegree) :
    gomesPolynomialDifferentialRemainder A R.val = R := by
  simpa [gomesPolynomialFirstOrderOperator] using gomesPolynomialDifferentialRemainder_assemble A 0 R

/-- Every low-degree obstruction occurs. -/
theorem gomesPolynomialDifferentialRemainder_surjective (A : GomesNonconstantPolynomialCoefficient) :
    Function.Surjective (gomesPolynomialDifferentialRemainder A) :=
  fun R => ⟨R.val, gomesPolynomialDifferentialRemainder_low_degree A R⟩

/-- Vanishing canonical remainder is precisely membership in the polynomial connection range. -/
theorem gomesPolynomialDifferentialRemainder_zero_iff_range
    (A : GomesNonconstantPolynomialCoefficient) (Q : ℝ[X]) :
    gomesPolynomialDifferentialRemainder A Q = 0 ↔
      Q ∈ LinearMap.range (gomesPolynomialFirstOrderLinearMap A.val) := by
  constructor
  · intro h
    refine ⟨gomesPolynomialDifferentialSource A Q, ?_⟩
    have hd := gomesPolynomialDifferentialRemainder_decomposition A Q
    rw [h] at hd
    simpa [gomesPolynomialFirstOrderLinearMap] using hd.symm
  · rintro ⟨B, rfl⟩
    exact gomesPolynomialDifferentialRemainder_operator A B

/-- The range of the connection is exactly the kernel of its obstruction map. -/
theorem gomesPolynomialDifferentialRemainder_ker (A : GomesNonconstantPolynomialCoefficient) :
    LinearMap.ker (gomesPolynomialDifferentialRemainder A) =
      LinearMap.range (gomesPolynomialFirstOrderLinearMap A.val) := by
  ext Q
  exact gomesPolynomialDifferentialRemainder_zero_iff_range A Q

/-- Two forcings have equal obstructions exactly when their difference is generated by the connection. -/
theorem gomesPolynomialDifferentialRemainder_eq_iff
    (A : GomesNonconstantPolynomialCoefficient) (Q R : ℝ[X]) :
    gomesPolynomialDifferentialRemainder A Q = gomesPolynomialDifferentialRemainder A R ↔
      Q - R ∈ LinearMap.range (gomesPolynomialFirstOrderLinearMap A.val) := by
  rw [← gomesPolynomialDifferentialRemainder_zero_iff_range, map_sub, sub_eq_zero]

/-- The low-degree sector and connection range together cover every polynomial. -/
theorem gomesPolynomialFirstOrder_range_sup_low_degree (A : GomesNonconstantPolynomialCoefficient) :
    LinearMap.range (gomesPolynomialFirstOrderLinearMap A.val) ⊔ degreeLT ℝ A.val.natDegree = ⊤ := by
  apply top_unique
  intro Q _
  have h := gomesPolynomialDifferentialRemainder_decomposition A Q
  rw [h]
  exact Submodule.add_mem_sup ⟨gomesPolynomialDifferentialSource A Q, rfl⟩
    (gomesPolynomialDifferentialRemainder A Q).property

end GaloisForLFunctions.HTGeometry
