import GaloisForLFunctions.HTGeometry.RationalInvariantDifferential
import GaloisForLFunctions.HTGeometry.RationalAffineConnection

/-!
# The normalizing shift at jet level two is a rational affine connection

At jet level two the substitution acts on the top coordinate by `y₂ ↦ R'·y₂ + R''·y₁²`, so an
invariant affine structure there is an element `t` of the field generated by `y₀` and `y₁` with

`Φ(t) = R'·t − R''·y₁²`.

Slicing `t` as a coprime fraction in `y₁` over the rational functions of `y₀` turns this into a
statement about rational maps.  The substitution acts on `y₁` by the *pure scaling* `y₁ ↦ R'·y₁`, so
the twisted composition preserves degrees and coprimality; the denominator therefore divides its own
image and equals it up to a scalar, and one comparison of coefficients — at the index two above the
degree of the denominator — turns the shift equation into

`a(R)·(R')² = R'·a − R''`,

the rational affine-connection equation, for the ratio of that coefficient of the numerator by the
leading coefficient of the denominator.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-! ## The second jet of the substituted value -/

/-- The ambient derivation of an element depending only on the free generator is its partial in that
generator against the first jet coordinate. -/
theorem jetDerivation_of_order_zero {v : JetField C Unit}
    (hv : ∀ k : ℕ, k ≠ 0 → JetField.pd ((), k) v = 0) :
    JetField.jetDerivation v = JetField.jet ((), 1) * JetField.pd ((), 0) v := by
  classical
  have hmem := (mem_freeCoordinateField_iff (C := C) (σ := Unit × ℕ)
      (↑({((), 0)} : Finset (Unit × ℕ)) : Set (Unit × ℕ)) v).mpr (by
    rintro ⟨⟨⟩, k⟩ hk
    exact hv k (by rintro rfl; exact hk (by simp)))
  have h := freeCoordinate_chainRule ({((), 0)} : Finset (Unit × ℕ))
    (JetField.jetDerivation (C := C) (ι := Unit)) hmem
  rw [Finset.sum_singleton] at h
  refine h.trans ?_
  congr 1
  exact JetField.jetDerivation_jet ((), 0)

/-- **The second jet of the substituted value.**  Differentiating `R'(y₀)·y₁` once more produces the
affine action on the second coordinate with remainder `R''(y₀)·y₁²`. -/
theorem substitutionShift_two (R : RatFunc C) :
    substitutionShift R 2
      = JetField.pd ((), 0) (substitutionDeriv R) * JetField.jet ((), 1) ^ 2 := by
  have hjet : substitutionJet R 2 = JetField.jetDerivation (substitutionJet R 1) := by
    rw [substitutionJet, substitutionJet,
      show (2 : ℕ) = 1 + 1 from rfl, differentialJet_succ, JetField.deriv_eq]
  have hone := substitutionJet_one R
  have hleib : JetField.jetDerivation
      ((JetField.jet ((), 1) : JetField C Unit) * substitutionDeriv R)
      = JetField.jetDerivation (JetField.jet ((), 1) : JetField C Unit) * substitutionDeriv R
        + (JetField.jet ((), 1) : JetField C Unit)
          * JetField.jetDerivation (substitutionDeriv R) := by
    have h := (JetField.jetDerivation (C := C) (ι := Unit)).leibniz
      (JetField.jet ((), 1) : JetField C Unit) (substitutionDeriv R)
    simp only [smul_eq_mul] at h
    rw [h]
    ring
  have hderiv : JetField.jetDerivation (substitutionDeriv R)
      = JetField.jet ((), 1) * JetField.pd ((), 0) (substitutionDeriv R) :=
    jetDerivation_of_order_zero (fun k hk => pd_substitutionDeriv_eq_zero R hk)
  rw [substitutionShift, hjet, hone, hleib, JetField.jetDerivation_jet, hderiv]
  ring

/-! ## The second derivative as a rational function -/

theorem substitutionDeriv_ratFuncDeriv (R : RatFunc C) :
    substitutionDeriv (ratFuncDeriv R) = JetField.pd ((), 0) (substitutionDeriv R) := by
  rw [substitutionDeriv, substitutionValue, ratFuncEval_ratFuncDeriv]

/-! ## The level-two normalizing shift is a rational affine connection -/

/-- **A normalizing shift at jet level two solves the rational affine-connection equation.**
Slicing the shift as a coprime fraction in the first jet coordinate, the denominator divides its own
twisted image and hence equals it up to a scalar; comparing the numerator coefficient two above the
degree of the denominator with the leading coefficient of the denominator turns the shift equation
into `a(R)·(R')² = R'·a − R''`. -/
theorem exists_ratFuncDeriv_affine_connection_of_hasNormalizingShift_two
    (R : RatFunc C) (hR : substitutionDeriv R ≠ 0)
    (h : HasNormalizingShift R hR (show (1 : ℕ) ≤ 2 by norm_num)) :
    ∃ a : RatFunc C,
      ratFuncSubstitutionAlgHom R (not_isConst_of_substitutionDeriv_ne_zero hR) a
          * ratFuncDeriv R ^ 2
        = ratFuncDeriv R * a - ratFuncDeriv (ratFuncDeriv R) := by
  classical
  obtain ⟨t, ht⟩ := h
  set x : JetField C Unit := JetField.jet ((), 1) with hxdef
  have hxtr : Transcendental (jetPrefixField C 1) x := transcendental_jet_over_jetPrefixField 1
  have hinj : Function.Injective (Polynomial.aeval (R := ↥(jetPrefixField C 1)) x) :=
    transcendental_iff_injective.mp hxtr
  set Φ : ↥(jetPrefixField C 1) →+* ↥(jetPrefixField C 1) :=
    (jetSubstitutionPrefix R hR 1).toRingHom with hΦdef
  set ρF : ↥(jetPrefixField C 1) := substitutionDerivPrefix R (le_refl 1) with hρFdef
  have hρF : ρF ≠ 0 := substitutionDerivPrefix_ne_zero R hR (le_refl 1)
  have hρval : (algebraMap ↥(jetPrefixField C 1) (JetField C Unit)) ρF = substitutionDeriv R := rfl
  set T : Polynomial ↥(jetPrefixField C 1) := Polynomial.C ρF * Polynomial.X with hTdef
  have hT : T.natDegree = 1 := natDegree_scaleSubst hρF
  set ddF : ↥(jetPrefixField C 1) :=
    ⟨JetField.pd ((), 0) (substitutionDeriv R), by
      rw [← substitutionDeriv_ratFuncDeriv]
      exact substitutionDeriv_mem_jetPrefixField (ratFuncDeriv R) (le_refl 1)⟩ with hddFdef
  have hddval : (algebraMap ↥(jetPrefixField C 1) (JetField C Unit)) ddF
      = JetField.pd ((), 0) (substitutionDeriv R) := rfl
  -- the substitution acts on the first jet coordinate by a pure scaling
  have hact : jetSubstitution R hR x = Polynomial.aeval x T := by
    rw [hxdef, jetSubstitution_jet, substitutionJet_one, hTdef, map_mul, Polynomial.aeval_C,
      Polynomial.aeval_X, hρval]
    ring
  -- the shift equation on the jet field
  have htJ : jetSubstitution R hR (t : JetField C Unit)
      = substitutionDeriv R * (t : JetField C Unit) - substitutionShift R 2 := by
    have hc := congrArg (fun z : ↥(jetPrefixField C 2) =>
      (algebraMap ↥(jetPrefixField C 2) (JetField C Unit) z)) ht
    simp only [map_sub, map_mul] at hc
    rw [← jetSubstitution_algebraMap_prefix] at hc
    exact hc
  have hord : ∀ j : ℕ, 1 < j → JetField.pd ((), j) (t : JetField C Unit) = 0 := by
    intro j hj
    exact (mem_jetPrefixField_iff 2 (t : JetField C Unit)).mp t.2 j (by omega)
  have hmemadj : (t : JetField C Unit) ∈ IntermediateField.adjoin (jetPrefixField C 1)
      ({x} : Set (JetField C Unit)) := mem_adjoin_jet_of_order hord
  -- slice the shift as a coprime fraction in the first jet coordinate
  set f : RatFunc ↥(jetPrefixField C 1) :=
    (RatFunc.algEquivOfTranscendental x hxtr).symm ⟨(t : JetField C Unit), hmemadj⟩ with hfdef
  have hxeval : ratFuncEval x hxtr f = (t : JetField C Unit) := by
    simp only [ratFuncEval, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, hfdef,
      AlgEquiv.apply_symm_apply]
    rfl
  set P : Polynomial ↥(jetPrefixField C 1) := f.num with hPdef
  set Q : Polynomial ↥(jetPrefixField C 1) := f.denom with hQdef
  have hQ0 : Q ≠ 0 := RatFunc.denom_ne_zero f
  have hcop : IsCoprime P Q := RatFunc.isCoprime_num_denom f
  have hQy : Polynomial.aeval x Q ≠ 0 := fun hh => hQ0 (hinj (by simpa using hh))
  have htdiv : (t : JetField C Unit) = Polynomial.aeval x P / Polynomial.aeval x Q := by
    rw [← hxeval, ratFuncEval_eq_div]
  -- the shift term
  have hσ : substitutionShift R 2
      = Polynomial.aeval x (Polynomial.C ddF * Polynomial.X ^ 2) := by
    rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X, substitutionShift_two, hddval]
  -- the cross identity
  have hΦQ0 : twistComp Φ T Q ≠ 0 := twistComp_ne_zero Φ hT hQ0
  have hΦQy : Polynomial.aeval x (twistComp Φ T Q) ≠ 0 :=
    fun hh => hΦQ0 (hinj (by simpa using hh))
  have hLHS : jetSubstitution R hR (t : JetField C Unit)
      = Polynomial.aeval x (twistComp Φ T P) / Polynomial.aeval x (twistComp Φ T Q) := by
    rw [htdiv, map_div₀, jetSubstitution_aeval_of_act R hR hact,
      jetSubstitution_aeval_of_act R hR hact]
  rw [hLHS, htdiv, hσ, ← hρval] at htJ
  have hcrossJ : Polynomial.aeval x (twistComp Φ T P * Q)
      = Polynomial.aeval x (twistComp Φ T Q
          * (Polynomial.C ρF * P - Polynomial.C ddF * Polynomial.X ^ 2 * Q)) := by
    simp only [map_mul, map_sub, map_pow, Polynomial.aeval_C, Polynomial.aeval_X] at htJ ⊢
    field_simp at htJ
    linear_combination htJ
  have hcross := hinj hcrossJ
  -- the denominator is a scalar eigenvector
  have hcopΦ : IsCoprime (twistComp Φ T P) (twistComp Φ T Q) := by
    obtain ⟨u, v, huv⟩ := hcop
    refine ⟨twistComp Φ T u, twistComp Φ T v, ?_⟩
    rw [← twistComp_mul, ← twistComp_mul, ← twistComp_add, huv]
    rw [show (1 : Polynomial ↥(jetPrefixField C 1)) = Polynomial.C 1 from by rw [map_one],
      twistComp_C, map_one, map_one]
  have hdvd : twistComp Φ T Q ∣ Q :=
    hcopΦ.symm.dvd_of_dvd_mul_left ⟨_, hcross⟩
  obtain ⟨e', he'0, he'⟩ := eq_C_mul_of_dvd_of_natDegree_eq hQ0 hdvd
    (natDegree_twistComp Φ hT Q).symm
  set e : ↥(jetPrefixField C 1) := e'⁻¹ with hedef
  have hdQ : twistComp Φ T Q = Polynomial.C e * Q := by
    conv_rhs => rw [he']
    rw [hedef, ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ he'0, map_one, one_mul]
  have hPeq : twistComp Φ T P = Polynomial.C e * (Polynomial.C ρF * P
      - Polynomial.C ddF * Polynomial.X ^ 2 * Q) := by
    refine mul_right_cancel₀ hQ0 ?_
    rw [hcross, hdQ]
    ring
  -- compare coefficients
  set n : ℕ := Q.natDegree with hndef
  set q : ↥(jetPrefixField C 1) := Q.coeff n with hqdef
  set p : ↥(jetPrefixField C 1) := P.coeff (n + 2) with hpdef
  have hq0 : q ≠ 0 := by
    rw [hqdef, hndef, ← Polynomial.leadingCoeff]
    exact Polynomial.leadingCoeff_ne_zero.mpr hQ0
  have h2 : Φ q * ρF ^ n = e * q := by
    have := coeff_eigen_of_twistComp_scale Φ (ρ := ρF) (c := e) (P := Q) (by rw [← hTdef]; exact hdQ) n
    exact this
  have h1 : Φ p * ρF ^ (n + 2) = e * (ρF * p - ddF * q) := by
    have hL : (twistComp Φ T P).coeff (n + 2) = Φ (P.coeff (n + 2)) * ρF ^ (n + 2) := by
      rw [hTdef]; exact coeff_twistComp_scale Φ ρF P (n + 2)
    have hR' : (twistComp Φ T P).coeff (n + 2)
        = (Polynomial.C e * (Polynomial.C ρF * P
            - Polynomial.C ddF * Polynomial.X ^ 2 * Q)).coeff (n + 2) := by rw [hPeq]
    rw [hL] at hR'
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_sub, mul_assoc] at hR'
    rw [show Polynomial.X ^ 2 * Q = Q * Polynomial.X ^ 2 from by ring] at hR'
    have hXQ : (Q * Polynomial.X ^ 2).coeff (n + 2) = q := by
      rw [hqdef]
      simp [Polynomial.coeff_mul_X_pow']
    rw [hR', hXQ]
  -- eliminate the scalar
  have hkey : Φ p * ρF ^ 2 * q = Φ q * (ρF * p - ddF * q) := by
    have h3 : Φ p * ρF ^ (n + 2) * q = Φ q * ρF ^ n * (ρF * p - ddF * q) := by
      calc Φ p * ρF ^ (n + 2) * q = (e * (ρF * p - ddF * q)) * q := by rw [h1]
        _ = (e * q) * (ρF * p - ddF * q) := by ring
        _ = (Φ q * ρF ^ n) * (ρF * p - ddF * q) := by rw [h2]
    have hpow : ρF ^ (n + 2) = ρF ^ n * ρF ^ 2 := by rw [← pow_add]
    rw [hpow] at h3
    refine mul_left_cancel₀ (pow_ne_zero n hρF) ?_
    linear_combination h3
  have hΦq0 : Φ q ≠ 0 := fun hh => hq0 ((map_eq_zero_iff Φ Φ.injective).mp hh)
  have hfinal : Φ (p / q) * ρF ^ 2 = ρF * (p / q) - ddF := by
    rw [map_div₀]
    field_simp
    linear_combination hkey
  -- transport to rational functions
  have hordA : ∀ j : ℕ, 0 < j → JetField.pd ((), j)
      (algebraMap ↥(jetPrefixField C 1) (JetField C Unit) (p / q)) = 0 := by
    intro j hj
    exact (mem_jetPrefixField_iff 1 _).mp (p / q).2 j (by omega)
  obtain ⟨A, hA⟩ := exists_ratFunc_of_order_zero hordA
  refine ⟨A, ?_⟩
  have hev : Function.Injective
      (ratFuncEval (JetField.jet ((), 0) : JetField C Unit) transcendental_freeGen) :=
    ratFuncEval_injective _ transcendental_freeGen
  refine hev ?_
  rw [map_mul, map_pow, map_sub, map_mul, ratFuncEval_ratFuncSubstitution, hA,
    ratFuncEval_ratFuncDeriv, ratFuncEval_ratFuncDeriv, substitutionDeriv_ratFuncDeriv]
  have hcoe := congrArg (fun z : ↥(jetPrefixField C 1) =>
    (algebraMap ↥(jetPrefixField C 1) (JetField C Unit) z)) hfinal
  simp only [map_sub, map_mul, map_pow] at hcoe
  have hcoeq : jetSubstitution R hR
      (algebraMap ↥(jetPrefixField C 1) (JetField C Unit) (p / q))
      = algebraMap ↥(jetPrefixField C 1) (JetField C Unit) (Φ (p / q)) := rfl
  rw [← hcoeq, hρval, hddval] at hcoe
  exact hcoe

/-- **For a polynomial map the level-two shift equation is the affine-connection equation.** -/
theorem exists_isAffineConnection_of_hasNormalizingShift_two {P : Polynomial C}
    (hP : substitutionDeriv (algebraMap (Polynomial C) (RatFunc C) P) ≠ 0)
    (h : HasNormalizingShift (algebraMap (Polynomial C) (RatFunc C) P) hP
      (show (1 : ℕ) ≤ 2 by norm_num)) :
    ∃ a : RatFunc C, IsAffineConnection P (not_isConst_of_substitutionDeriv_ne_zero hP) a := by
  obtain ⟨a, ha⟩ := exists_ratFuncDeriv_affine_connection_of_hasNormalizingShift_two _ hP h
  rw [ratFuncDeriv_algebraMap, ratFuncDeriv_algebraMap] at ha
  refine ⟨a, ?_⟩
  show algebraMap (Polynomial C) (RatFunc C) (Polynomial.derivative P ^ 2)
      * ratFuncSubstitutionAlgHom (algebraMap (Polynomial C) (RatFunc C) P)
          (not_isConst_of_substitutionDeriv_ne_zero hP) a = _
  rw [map_pow, mul_comm]
  exact ha

end

end GaloisForLFunctions.HTGeometry
