import GaloisForLFunctions.HTGeometry.DispersivePDE.ScalarSolitons
import GaloisForLFunctions.HTGeometry.CoshFourierTransform
import Mathlib.Analysis.Complex.Trigonometric

/-!
# Electron-acoustic KP solitons, breathers, and lumps (arXiv:2609.03539)

Closed formalization of reusable mathematics around equations (14), (21)--(47) in Mondal,
Chatterjee, and Sahu. It connects the paper to the corpus KP jet interface, proves corrected
one-soliton and quadratic Hirota families, and records exact defects in printed dispersion,
amplitude, lump-curvature, and `b₇` formulas. Every result is premise-free: admissible physical
parameters are generated by total positive parameterizations rather than theorem hypotheses.
-/

namespace GaloisForLFunctions.HTGeometry.DispersivePDE

/-- Pointwise residual of generalized KP. -/
def generalKPResidual (α δ ρ : ℝ) (J : RealEvolutionJetKP) (t x y : ℝ) : ℝ :=
  J.utx t x y + α * (J.ux t x y ^ (2 : ℕ) + J.u t x y * J.uxx t x y)
    + δ * J.uxxxx t x y + ρ * J.uyy t x y

/-- Expanded generalized KP equation
`(uₜ + α u uₓ + δ uₓₓₓ)ₓ + ρ uᵧᵧ = 0`. -/
def SolvesGeneralKP (α δ ρ : ℝ) (J : RealEvolutionJetKP) : Prop :=
  ∀ t x y, generalKPResidual α δ ρ J t x y = 0

/-- Division-free dispersion relation, with transverse wave number `k * slope`. -/
def mondalFrequency (δ ρ k slope : ℝ) : ℝ :=
  δ * k ^ (3 : ℕ) + ρ * k * slope ^ (2 : ℕ)

/-- Half-phase used by the `sech²` form of the one-soliton. -/
noncomputable def mondalPhase (δ ρ k slope shift t x y : ℝ) : ℝ :=
  (1 / 2 : ℝ) * (k * x + k * slope * y - mondalFrequency δ ρ k slope * t + shift)

/-- Corrected affine-phase one-soliton obtained from the paper's Hirota ansatz. -/
noncomputable def mondalSoliton (α δ ρ k slope shift t x y : ℝ) : ℝ :=
  (3 * δ / α) * k ^ (2 : ℕ) * solitonQ (mondalPhase δ ρ k slope shift t x y)

private theorem hasDerivAt_mondalPhase_time
    (δ ρ k slope shift t x y : ℝ) :
    HasDerivAt (fun s => mondalPhase δ ρ k slope shift s x y)
      ((1 / 2 : ℝ) * (-mondalFrequency δ ρ k slope)) t := by
  have h := (hasDerivAt_const t (k * x + k * slope * y)).sub
    ((hasDerivAt_id t).const_mul (mondalFrequency δ ρ k slope))
  have h := h.add_const shift
  have h := h.const_mul (1 / 2 : ℝ)
  simpa [mondalPhase, id_eq] using h

private theorem hasDerivAt_mondalPhase_space
    (δ ρ k slope shift t x y : ℝ) :
    HasDerivAt (fun z => mondalPhase δ ρ k slope shift t z y) ((1 / 2 : ℝ) * k) x := by
  have h := ((hasDerivAt_id x).const_mul k).add_const (k * slope * y)
  have h := h.sub (hasDerivAt_const x (mondalFrequency δ ρ k slope * t))
  have h := h.add_const shift
  have h := h.const_mul (1 / 2 : ℝ)
  simpa [mondalPhase, id_eq] using h

private theorem hasDerivAt_mondalPhase_transverse
    (δ ρ k slope shift t x y : ℝ) :
    HasDerivAt (fun z => mondalPhase δ ρ k slope shift t x z)
      ((1 / 2 : ℝ) * (k * slope)) y := by
  have h := (hasDerivAt_const y (k * x)).add
    ((hasDerivAt_id y).const_mul (k * slope))
  have h := h.sub (hasDerivAt_const y (mondalFrequency δ ρ k slope * t))
  have h := h.add_const shift
  have h := h.const_mul (1 / 2 : ℝ)
  simpa [mondalPhase, id_eq] using h

private theorem hasDerivAt_const_mul_comp
    {f g : ℝ → ℝ} {f' c d x : ℝ}
    (hf : HasDerivAt f f' (g x)) (hg : HasDerivAt g d x) :
    HasDerivAt (fun z => c * f (g z)) ((c * d) * f') x := by
  have h := (hf.comp x hg).const_mul c
  apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp

/-- Certified derivative jet of the corrected affine-phase one-soliton. -/
noncomputable def mondalSolitonJet (α δ ρ k slope shift : ℝ) : RealEvolutionJetKP where
  u := mondalSoliton α δ ρ k slope shift
  ut := fun t x y => ((3 * δ / α) * k ^ (2 : ℕ)
    * ((1 / 2 : ℝ) * (-mondalFrequency δ ρ k slope)))
    * solitonQ1 (mondalPhase δ ρ k slope shift t x y)
  ux := fun t x y => ((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k))
    * solitonQ1 (mondalPhase δ ρ k slope shift t x y)
  uxx := fun t x y => (((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k))
    * ((1 / 2 : ℝ) * k))
    * solitonQ2 (mondalPhase δ ρ k slope shift t x y)
  uxxx := fun t x y => ((((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k))
    * ((1 / 2 : ℝ) * k)) * ((1 / 2 : ℝ) * k))
    * solitonQ3 (mondalPhase δ ρ k slope shift t x y)
  uxxxx := fun t x y => (((((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k))
    * ((1 / 2 : ℝ) * k)) * ((1 / 2 : ℝ) * k)) * ((1 / 2 : ℝ) * k))
      * solitonQ4 (mondalPhase δ ρ k slope shift t x y)
  utx := fun t x y => (((3 * δ / α) * k ^ (2 : ℕ)
    * ((1 / 2 : ℝ) * (-mondalFrequency δ ρ k slope))) * ((1 / 2 : ℝ) * k))
      * solitonQ2 (mondalPhase δ ρ k slope shift t x y)
  uy := fun t x y => ((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * (k * slope)))
    * solitonQ1 (mondalPhase δ ρ k slope shift t x y)
  uyy := fun t x y => (((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * (k * slope)))
    * ((1 / 2 : ℝ) * (k * slope))) * solitonQ2 (mondalPhase δ ρ k slope shift t x y)
  hasDerivAt_time := by
    intro t x y
    simpa [mondalSoliton] using hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ)) (hasDerivAt_solitonQ _)
      (hasDerivAt_mondalPhase_time δ ρ k slope shift t x y)
  hasDerivAt_space := by
    intro t x y
    simpa [mondalSoliton] using hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ)) (hasDerivAt_solitonQ _)
      (hasDerivAt_mondalPhase_space δ ρ k slope shift t x y)
  hasDerivAt_space_one := by
    intro t x y
    exact hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k)) (hasDerivAt_solitonQ1 _)
      (hasDerivAt_mondalPhase_space δ ρ k slope shift t x y)
  hasDerivAt_space_two := by
    intro t x y
    exact hasDerivAt_const_mul_comp
      (c := ((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k)) * ((1 / 2 : ℝ) * k))
      (hasDerivAt_solitonQ2 _)
      (hasDerivAt_mondalPhase_space δ ρ k slope shift t x y)
  hasDerivAt_space_three := by
    intro t x y
    exact hasDerivAt_const_mul_comp
      (c := (((3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * k)) * ((1 / 2 : ℝ) * k))
        * ((1 / 2 : ℝ) * k)) (hasDerivAt_solitonQ3 _)
      (hasDerivAt_mondalPhase_space δ ρ k slope shift t x y)
  hasDerivAt_time_space := by
    intro t x y
    exact hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * (-mondalFrequency δ ρ k slope)))
      (hasDerivAt_solitonQ1 _)
      (hasDerivAt_mondalPhase_space δ ρ k slope shift t x y)
  hasDerivAt_transverse := by
    intro t x y
    simpa [mondalSoliton] using hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ)) (hasDerivAt_solitonQ _)
      (hasDerivAt_mondalPhase_transverse δ ρ k slope shift t x y)
  hasDerivAt_transverse_one := by
    intro t x y
    exact hasDerivAt_const_mul_comp
      (c := (3 * δ / α) * k ^ (2 : ℕ) * ((1 / 2 : ℝ) * (k * slope)))
      (hasDerivAt_solitonQ1 _)
      (hasDerivAt_mondalPhase_transverse δ ρ k slope shift t x y)

theorem mondalSoliton_solves (α δ ρ k slope shift : ℝ) :
    SolvesGeneralKP α δ ρ (mondalSolitonJet α δ ρ k slope shift) := by
  intro t x y
  unfold generalKPResidual
  by_cases hα : α = 0
  · subst α
    simp [mondalSolitonJet, mondalSoliton]
  · simp only [mondalSolitonJet, mondalSoliton]
    unfold mondalFrequency solitonQ4 solitonQ2 solitonQ1 solitonQ solitonT
    field_simp [hα]
    ring

theorem solvesGeneralKP_six_iff (σ : ℝ) (J : RealEvolutionJetKP) :
    SolvesGeneralKP 6 1 (3 * σ) J ↔ SolvesKP σ J := by
  constructor <;> intro h t x y
  · have hh := h t x y
    unfold generalKPResidual at hh
    convert hh using 1
    all_goals ring
  · have hh := h t x y
    unfold generalKPResidual
    convert hh using 1
    all_goals ring

theorem mondalCanonical_eq_kpLineSoliton :
    mondalSoliton 6 1 3 2 0 0 = kpLineSoliton := by
  funext t x y
  simp only [mondalSoliton, mondalPhase, mondalFrequency, kpLineSoliton, kdvSoliton]
  rw [show (3 * 1 / 6 : ℝ) * 2 ^ (2 : ℕ) = 2 by ring]
  apply congrArg (fun z => 2 * solitonQ z)
  ring

/-! ## Two-sided KP reflection -/

private theorem hasDerivAt_negArgument (x : ℝ) :
    HasDerivAt (fun z : ℝ => -z) (-1) x := by
  have h := (hasDerivAt_id x).neg
  apply h.congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp [id_eq]

private theorem hasDerivAt_comp_neg
    {f : ℝ → ℝ} {f' x : ℝ} (hf : HasDerivAt f f' (-x)) :
    HasDerivAt (fun z => f (-z)) (-f') x := by
  have h := hf.comp x (hasDerivAt_negArgument x)
  apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp

private theorem hasDerivAt_neg_comp_neg
    {f : ℝ → ℝ} {f' x : ℝ} (hf : HasDerivAt f f' (-x)) :
    HasDerivAt (fun z => -f (-z)) f' x := by
  have h := (hf.comp x (hasDerivAt_negArgument x)).neg
  apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp [Function.comp_def]

/-- Sign-reflection carrying a right-moving KP field to the left-moving equation. -/
noncomputable def mondalKPReflect (J : RealEvolutionJetKP) : RealEvolutionJetKP where
  u := fun t x y => -J.u t (-x) y
  ut := fun t x y => -J.ut t (-x) y
  ux := fun t x y => J.ux t (-x) y
  uxx := fun t x y => -J.uxx t (-x) y
  uxxx := fun t x y => J.uxxx t (-x) y
  uxxxx := fun t x y => -J.uxxxx t (-x) y
  utx := fun t x y => J.utx t (-x) y
  uy := fun t x y => -J.uy t (-x) y
  uyy := fun t x y => -J.uyy t (-x) y
  hasDerivAt_time := by
    intro t x y
    exact (J.hasDerivAt_time t (-x) y).neg
  hasDerivAt_space := by
    intro t x y
    exact hasDerivAt_neg_comp_neg (J.hasDerivAt_space t (-x) y)
  hasDerivAt_space_one := by
    intro t x y
    exact hasDerivAt_comp_neg (J.hasDerivAt_space_one t (-x) y)
  hasDerivAt_space_two := by
    intro t x y
    exact hasDerivAt_neg_comp_neg (J.hasDerivAt_space_two t (-x) y)
  hasDerivAt_space_three := by
    intro t x y
    exact hasDerivAt_comp_neg (J.hasDerivAt_space_three t (-x) y)
  hasDerivAt_time_space := by
    intro t x y
    exact hasDerivAt_neg_comp_neg (J.hasDerivAt_time_space t (-x) y)
  hasDerivAt_transverse := by
    intro t x y
    exact (J.hasDerivAt_transverse t (-x) y).neg
  hasDerivAt_transverse_one := by
    intro t x y
    exact (J.hasDerivAt_transverse_one t (-x) y).neg

theorem generalKPResidual_reflect (α δ ρ : ℝ) (J : RealEvolutionJetKP) (t x y : ℝ) :
    generalKPResidual α (-δ) (-ρ) (mondalKPReflect J) t x y =
      generalKPResidual α δ ρ J t (-x) y := by
  simp [generalKPResidual, mondalKPReflect]

theorem mondalKPReflect_solves_iff (α δ ρ : ℝ) (J : RealEvolutionJetKP) :
    SolvesGeneralKP α (-δ) (-ρ) (mondalKPReflect J) ↔ SolvesGeneralKP α δ ρ J := by
  constructor
  · intro h t x y
    have hz := h t (-x) y
    rw [generalKPResidual_reflect] at hz
    simpa using hz
  · intro h t x y
    rw [generalKPResidual_reflect]
    exact h t (-x) y

/-! ## Exact Hirota curvature and corrections to the displayed one-soliton formulas -/

noncomputable def mondalOneTau (k shift x : ℝ) : ℝ :=
  1 + Real.exp (k * x + shift)

noncomputable def mondalOneTauLog (k shift x : ℝ) : ℝ :=
  Real.log (mondalOneTau k shift x)

noncomputable def mondalOneTauLogSlope (k shift x : ℝ) : ℝ :=
  k * HTGeometry.logisticVar ((k * x + shift) / 2)

theorem mondalOneTau_pos (k shift x : ℝ) : 0 < mondalOneTau k shift x := by
  unfold mondalOneTau
  positivity

theorem hasDerivAt_mondalOneTauLog (k shift x : ℝ) :
    HasDerivAt (mondalOneTauLog k shift) (mondalOneTauLogSlope k shift x) x := by
  have hphase : HasDerivAt (fun z : ℝ => k * z + shift) k x := by
    simpa [id_eq] using ((hasDerivAt_id x).const_mul k).add_const shift
  have hexp := (Real.hasDerivAt_exp (k * x + shift)).comp x hphase
  have htau : HasDerivAt (fun z : ℝ => 1 + Real.exp (k * z + shift))
      (Real.exp (k * x + shift) * k) x := by
    have h := (hasDerivAt_const x (1 : ℝ)).add hexp
    apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp [Function.comp_def]
  have hlog := htau.log (by positivity)
  apply (hlog.congr_deriv ?_).congr_of_eventuallyEq
  · exact Filter.Eventually.of_forall fun z => by simp [mondalOneTauLog, mondalOneTau]
  · rw [mondalOneTauLogSlope, HTGeometry.logisticVar_eq_exp]
    have hexpTwo : Real.exp (2 * ((k * x + shift) / 2)) = Real.exp (k * x + shift) := by
      congr 1
      ring
    rw [hexpTwo]
    ring

theorem hasDerivAt_mondalOneTauLogSlope (k shift x : ℝ) :
    HasDerivAt (mondalOneTauLogSlope k shift)
      ((k ^ (2 : ℕ) / 4) * solitonQ ((k * x + shift) / 2)) x := by
  have hphase : HasDerivAt (fun z : ℝ => (k * z + shift) / 2) (k / 2) x := by
    have h := ((hasDerivAt_id x).const_mul k).add_const shift
    simpa [id_eq] using h.div_const 2
  have hlogistic := (HTGeometry.hasDerivAt_logisticVar ((k * x + shift) / 2)).comp x hphase
  have h := hlogistic.const_mul k
  apply (h.congr_deriv ?_).congr_of_eventuallyEq
  · exact Filter.Eventually.of_forall fun z => by simp [mondalOneTauLogSlope]
  · rw [solitonQ_eq_inv_cosh_sq]
    ring

theorem mondalHirotaCurvature_eq_soliton
    (α δ ρ k slope shift t x y : ℝ) :
    (12 * δ / α) * ((k ^ (2 : ℕ) / 4) * solitonQ (mondalPhase δ ρ k slope shift t x y)) =
      mondalSoliton α δ ρ k slope shift t x y := by
  unfold mondalSoliton
  ring

/-- Paper's right-moving frequency (24), expressed without division via `l = k * slope`. -/
def mondalPrintedRightFrequency (β γ k slope : ℝ) : ℝ :=
  β * k ^ (3 : ℕ) - γ * k * slope ^ (2 : ℕ)

/-- Paper's left-moving frequency (36), expressed without division via `L = K * slope`. -/
def mondalPrintedLeftFrequency (β γ k slope : ℝ) : ℝ :=
  -β * k ^ (3 : ℕ) + γ * k * slope ^ (2 : ℕ)

theorem mondalPrintedRightFrequency_eq_neg_correct (β γ k slope : ℝ) :
    mondalPrintedRightFrequency β γ k slope = -mondalFrequency (-β) γ k slope := by
  unfold mondalPrintedRightFrequency mondalFrequency
  ring

theorem mondalPrintedLeftFrequency_eq_neg_correct (β γ k slope : ℝ) :
    mondalPrintedLeftFrequency β γ k slope = -mondalFrequency β (-γ) k slope := by
  unfold mondalPrintedLeftFrequency mondalFrequency
  ring

theorem mondalPrintedRightAmplitude_eq_neg_four_mul_correct (α β k : ℝ) :
    (12 * β / α) * k ^ (2 : ℕ) = -4 * ((3 * (-β) / α) * k ^ (2 : ℕ)) := by
  ring

theorem mondalPrintedLeftAmplitude_eq_four_mul_correct (α β k : ℝ) :
    (12 * β / α) * k ^ (2 : ℕ) = 4 * ((3 * β / α) * k ^ (2 : ℕ)) := by
  ring

/-! ## Conjugate-pair breather algebra -/

noncomputable def mondalComplexDispersion (δ ρ : ℝ) (k l : ℂ) : ℂ :=
  (δ : ℂ) * k ^ (3 : ℕ) + (ρ : ℂ) * l ^ (2 : ℕ) / k

theorem mondalComplexDispersion_conj (δ ρ : ℝ) (k l : ℂ) :
    starRingEnd ℂ (mondalComplexDispersion δ ρ k l) =
      mondalComplexDispersion δ ρ (starRingEnd ℂ k) (starRingEnd ℂ l) := by
  simp [mondalComplexDispersion, map_add, map_mul, map_div₀, map_pow]

noncomputable def mondalComplexBreatherTau (interaction : ℝ) (z : ℂ) : ℂ :=
  1 + Complex.exp z + Complex.exp (starRingEnd ℂ z)
    + (interaction : ℂ) * Complex.exp (z + starRingEnd ℂ z)

noncomputable def mondalRealBreatherTau (interaction : ℝ) (z : ℂ) : ℝ :=
  1 + 2 * Real.exp z.re * Real.cos z.im + interaction * Real.exp (2 * z.re)

theorem mondal_exp_conjugate_pair (z : ℂ) :
    Complex.exp z + Complex.exp (starRingEnd ℂ z) =
      ((2 * Real.exp z.re * Real.cos z.im : ℝ) : ℂ) := by
  apply Complex.ext
  · change (Complex.exp z).re + (Complex.exp (starRingEnd ℂ z)).re =
      2 * Real.exp z.re * Real.cos z.im
    rw [Complex.exp_re, Complex.exp_re]
    simp
    ring
  · change (Complex.exp z).im + (Complex.exp (starRingEnd ℂ z)).im = 0
    rw [Complex.exp_im, Complex.exp_im]
    simp

theorem mondal_exp_add_conj (z : ℂ) :
    Complex.exp (z + starRingEnd ℂ z) = ((Real.exp (2 * z.re) : ℝ) : ℂ) := by
  apply Complex.ext
  · change (Complex.exp (z + starRingEnd ℂ z)).re = Real.exp (2 * z.re)
    rw [Complex.exp_re]
    simp
    ring
  · change (Complex.exp (z + starRingEnd ℂ z)).im = 0
    rw [Complex.exp_im]
    simp

theorem mondalComplexBreatherTau_eq_real (interaction : ℝ) (z : ℂ) :
    mondalComplexBreatherTau interaction z = (mondalRealBreatherTau interaction z : ℂ) := by
  unfold mondalComplexBreatherTau mondalRealBreatherTau
  rw [show (1 : ℂ) + Complex.exp z + Complex.exp (starRingEnd ℂ z) =
      1 + (Complex.exp z + Complex.exp (starRingEnd ℂ z)) by ring,
    mondal_exp_conjugate_pair, mondal_exp_add_conj]
  push_cast
  ring

theorem mondalComplexBreatherTau_im (interaction : ℝ) (z : ℂ) :
    (mondalComplexBreatherTau interaction z).im = 0 := by
  rw [mondalComplexBreatherTau_eq_real]
  simp

/-- Bilinear KP residual
`(DₜDₓ + δ Dₓ⁴ + ρ Dᵧ²) F · F`, expanded on a certified jet. -/
def hirotaKPResidual (δ ρ : ℝ) (J : RealEvolutionJetKP) (t x y : ℝ) : ℝ :=
  2 * (J.u t x y * J.utx t x y - J.ut t x y * J.ux t x y)
    + 2 * δ * (J.u t x y * J.uxxxx t x y
      - 4 * J.ux t x y * J.uxxx t x y + 3 * J.uxx t x y ^ (2 : ℕ))
    + 2 * ρ * (J.u t x y * J.uyy t x y - J.uy t x y ^ (2 : ℕ))

def SolvesHirotaKP (δ ρ : ℝ) (J : RealEvolutionJetKP) : Prop :=
  ∀ t x y, hirotaKPResidual δ ρ J t x y = 0

/-- Bilinear residual obtained by reversing time in the displayed KP equation. -/
def hirotaKPTimeReversedResidual
    (δ ρ : ℝ) (J : RealEvolutionJetKP) (t x y : ℝ) : ℝ :=
  -2 * (J.u t x y * J.utx t x y - J.ut t x y * J.ux t x y)
    + 2 * δ * (J.u t x y * J.uxxxx t x y
      - 4 * J.ux t x y * J.uxxx t x y + 3 * J.uxx t x y ^ (2 : ℕ))
    + 2 * ρ * (J.u t x y * J.uyy t x y - J.uy t x y ^ (2 : ℕ))

def SolvesHirotaKPTimeReversed (δ ρ : ℝ) (J : RealEvolutionJetKP) : Prop :=
  ∀ t x y, hirotaKPTimeReversedResidual δ ρ J t x y = 0

def mondalAffineForm (a b c d t x y : ℝ) : ℝ := a * x + b * y + c * t + d

/-! ## Exact one-exponential Hirota symbol -/

def mondalExpPhase (omega k l shift t x y : ℝ) : ℝ :=
  k * x + l * y - omega * t + shift

noncomputable def mondalExpWave (omega k l shift t x y : ℝ) : ℝ :=
  Real.exp (mondalExpPhase omega k l shift t x y)

private theorem hasDerivAt_mondalExpWave_time
    (omega k l shift t x y : ℝ) :
    HasDerivAt (fun z => mondalExpWave omega k l shift z x y)
      ((-omega) * mondalExpWave omega k l shift t x y) t := by
  have hphase : HasDerivAt (fun z : ℝ => mondalExpPhase omega k l shift z x y)
      (-omega) t := by
    have h := (hasDerivAt_const t (k * x + l * y)).sub
      ((hasDerivAt_id t).const_mul omega)
    have h := h.add_const shift
    simpa [mondalExpPhase, id_eq] using h
  have h := (Real.hasDerivAt_exp _).comp t hphase
  apply (h.congr_deriv (by simp [mondalExpWave, mul_comm])).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by
    simp [mondalExpWave, mondalExpPhase]

private theorem hasDerivAt_mondalExpWave_space
    (omega k l shift t x y : ℝ) :
    HasDerivAt (fun z => mondalExpWave omega k l shift t z y)
      (k * mondalExpWave omega k l shift t x y) x := by
  have hphase : HasDerivAt (fun z : ℝ => mondalExpPhase omega k l shift t z y) k x := by
    have h := ((hasDerivAt_id x).const_mul k).add_const (l * y)
    have h := h.sub (hasDerivAt_const x (omega * t))
    have h := h.add_const shift
    simpa [mondalExpPhase, id_eq] using h
  have h := (Real.hasDerivAt_exp _).comp x hphase
  apply (h.congr_deriv (by simp [mondalExpWave, mul_comm])).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by
    simp [mondalExpWave, mondalExpPhase]

private theorem hasDerivAt_mondalExpWave_transverse
    (omega k l shift t x y : ℝ) :
    HasDerivAt (fun z => mondalExpWave omega k l shift t x z)
      (l * mondalExpWave omega k l shift t x y) y := by
  have hphase : HasDerivAt (fun z : ℝ => mondalExpPhase omega k l shift t x z) l y := by
    have h := (hasDerivAt_const y (k * x)).add ((hasDerivAt_id y).const_mul l)
    have h := h.sub (hasDerivAt_const y (omega * t))
    have h := h.add_const shift
    simpa [mondalExpPhase, id_eq] using h
  have h := (Real.hasDerivAt_exp _).comp y hphase
  apply (h.congr_deriv (by simp [mondalExpWave, mul_comm])).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by
    simp [mondalExpWave, mondalExpPhase]

private theorem hasDerivAt_const_mul_mondalExpWave_space
    (c omega k l shift t x y : ℝ) :
    HasDerivAt (fun z => c * mondalExpWave omega k l shift t z y)
      (c * k * mondalExpWave omega k l shift t x y) x := by
  have h := (hasDerivAt_mondalExpWave_space omega k l shift t x y).const_mul c
  apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp

private theorem hasDerivAt_const_mul_mondalExpWave_transverse
    (c omega k l shift t x y : ℝ) :
    HasDerivAt (fun z => c * mondalExpWave omega k l shift t x z)
      (c * l * mondalExpWave omega k l shift t x y) y := by
  have h := (hasDerivAt_mondalExpWave_transverse omega k l shift t x y).const_mul c
  apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun z => by simp

/-- Certified jet of `1 + exp(kx + ly - omega*t + shift)`. -/
noncomputable def mondalOneExponentialTauJet
    (omega k l shift : ℝ) : RealEvolutionJetKP where
  u := fun t x y => 1 + mondalExpWave omega k l shift t x y
  ut := fun t x y => (-omega) * mondalExpWave omega k l shift t x y
  ux := fun t x y => k * mondalExpWave omega k l shift t x y
  uxx := fun t x y => k ^ (2 : ℕ) * mondalExpWave omega k l shift t x y
  uxxx := fun t x y => k ^ (3 : ℕ) * mondalExpWave omega k l shift t x y
  uxxxx := fun t x y => k ^ (4 : ℕ) * mondalExpWave omega k l shift t x y
  utx := fun t x y => (-omega) * k * mondalExpWave omega k l shift t x y
  uy := fun t x y => l * mondalExpWave omega k l shift t x y
  uyy := fun t x y => l ^ (2 : ℕ) * mondalExpWave omega k l shift t x y
  hasDerivAt_time := by
    intro t x y
    have h := (hasDerivAt_const t (1 : ℝ)).add
      (hasDerivAt_mondalExpWave_time omega k l shift t x y)
    apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp
  hasDerivAt_space := by
    intro t x y
    have h := (hasDerivAt_const x (1 : ℝ)).add
      (hasDerivAt_mondalExpWave_space omega k l shift t x y)
    apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp
  hasDerivAt_space_one := by
    intro t x y
    convert hasDerivAt_const_mul_mondalExpWave_space k omega k l shift t x y using 1
    all_goals ring
  hasDerivAt_space_two := by
    intro t x y
    convert hasDerivAt_const_mul_mondalExpWave_space (k ^ (2 : ℕ)) omega k l shift t x y using 1
    all_goals ring
  hasDerivAt_space_three := by
    intro t x y
    convert hasDerivAt_const_mul_mondalExpWave_space (k ^ (3 : ℕ)) omega k l shift t x y using 1
    all_goals ring
  hasDerivAt_time_space := by
    intro t x y
    convert hasDerivAt_const_mul_mondalExpWave_space (-omega) omega k l shift t x y using 1
  hasDerivAt_transverse := by
    intro t x y
    have h := (hasDerivAt_const y (1 : ℝ)).add
      (hasDerivAt_mondalExpWave_transverse omega k l shift t x y)
    apply (h.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp
  hasDerivAt_transverse_one := by
    intro t x y
    convert hasDerivAt_const_mul_mondalExpWave_transverse l omega k l shift t x y using 1
    all_goals ring

def mondalHirotaSymbol (δ ρ omega k l : ℝ) : ℝ :=
  -omega * k + δ * k ^ (4 : ℕ) + ρ * l ^ (2 : ℕ)

def mondalTimeReversedHirotaSymbol (δ ρ omega k l : ℝ) : ℝ :=
  omega * k + δ * k ^ (4 : ℕ) + ρ * l ^ (2 : ℕ)

theorem mondalTimeReversedHirotaSymbol_eq
    (δ ρ omega k l : ℝ) :
    mondalTimeReversedHirotaSymbol δ ρ omega k l =
      mondalHirotaSymbol δ ρ (-omega) k l := by
  unfold mondalTimeReversedHirotaSymbol mondalHirotaSymbol
  ring

theorem mondalOneExponentialTau_hirotaResidual
    (δ ρ omega k l shift t x y : ℝ) :
    hirotaKPResidual δ ρ (mondalOneExponentialTauJet omega k l shift) t x y =
      2 * mondalExpWave omega k l shift t x y * mondalHirotaSymbol δ ρ omega k l := by
  unfold hirotaKPResidual mondalOneExponentialTauJet mondalHirotaSymbol
  ring

theorem mondalOneExponentialTau_timeReversedHirotaResidual
    (δ ρ omega k l shift t x y : ℝ) :
    hirotaKPTimeReversedResidual δ ρ
        (mondalOneExponentialTauJet omega k l shift) t x y =
      2 * mondalExpWave omega k l shift t x y *
        mondalTimeReversedHirotaSymbol δ ρ omega k l := by
  unfold hirotaKPTimeReversedResidual mondalOneExponentialTauJet
    mondalTimeReversedHirotaSymbol
  ring

theorem mondalCorrectFrequency_symbol_zero (δ ρ k slope : ℝ) :
    mondalHirotaSymbol δ ρ (mondalFrequency δ ρ k slope) k (k * slope) = 0 := by
  unfold mondalHirotaSymbol mondalFrequency
  ring

theorem mondalOneExponentialTau_corrected_solvesHirota
    (δ ρ k slope shift : ℝ) :
    SolvesHirotaKP δ ρ
      (mondalOneExponentialTauJet (mondalFrequency δ ρ k slope) k (k * slope) shift) := by
  intro t x y
  rw [mondalOneExponentialTau_hirotaResidual, mondalCorrectFrequency_symbol_zero, mul_zero]

theorem mondalPrintedRightFrequency_symbol (β γ k slope : ℝ) :
    mondalHirotaSymbol (-β) γ (mondalPrintedRightFrequency β γ k slope) k (k * slope) =
      2 * k ^ (2 : ℕ) * (-β * k ^ (2 : ℕ) + γ * slope ^ (2 : ℕ)) := by
  unfold mondalHirotaSymbol mondalPrintedRightFrequency
  ring

theorem mondalPrintedLeftFrequency_symbol (β γ k slope : ℝ) :
    mondalHirotaSymbol β (-γ) (mondalPrintedLeftFrequency β γ k slope) k (k * slope) =
      2 * k ^ (2 : ℕ) * (β * k ^ (2 : ℕ) - γ * slope ^ (2 : ℕ)) := by
  unfold mondalHirotaSymbol mondalPrintedLeftFrequency
  ring

theorem mondalPrintedRightFrequency_timeReversedSymbol_zero (β γ k slope : ℝ) :
    mondalTimeReversedHirotaSymbol (-β) γ
      (mondalPrintedRightFrequency β γ k slope) k (k * slope) = 0 := by
  unfold mondalTimeReversedHirotaSymbol mondalPrintedRightFrequency
  ring

theorem mondalPrintedLeftFrequency_timeReversedSymbol_zero (β γ k slope : ℝ) :
    mondalTimeReversedHirotaSymbol β (-γ)
      (mondalPrintedLeftFrequency β γ k slope) k (k * slope) = 0 := by
  unfold mondalTimeReversedHirotaSymbol mondalPrintedLeftFrequency
  ring

theorem mondalPrintedRightOneTau_solvesTimeReversedHirota
    (β γ k slope shift : ℝ) :
    SolvesHirotaKPTimeReversed (-β) γ
      (mondalOneExponentialTauJet
        (mondalPrintedRightFrequency β γ k slope) k (k * slope) shift) := by
  intro t x y
  rw [mondalOneExponentialTau_timeReversedHirotaResidual,
    mondalPrintedRightFrequency_timeReversedSymbol_zero, mul_zero]

theorem mondalPrintedLeftOneTau_solvesTimeReversedHirota
    (β γ k slope shift : ℝ) :
    SolvesHirotaKPTimeReversed β (-γ)
      (mondalOneExponentialTauJet
        (mondalPrintedLeftFrequency β γ k slope) k (k * slope) shift) := by
  intro t x y
  rw [mondalOneExponentialTau_timeReversedHirotaResidual,
    mondalPrintedLeftFrequency_timeReversedSymbol_zero, mul_zero]

/-- Projective two-soliton interaction coefficient `-P(p₁-p₂) : P(p₁+p₂)`. -/
def mondalInteractionNumerator
    (δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂ : ℝ) : ℝ :=
  -mondalHirotaSymbol δ ρ (omega₁ - omega₂) (k₁ - k₂) (l₁ - l₂)

def mondalInteractionDenominator
    (δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂ : ℝ) : ℝ :=
  mondalHirotaSymbol δ ρ (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂)

theorem mondalInteraction_projective_cancellation
    (δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂ : ℝ) :
    mondalInteractionDenominator δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂ *
        mondalInteractionNumerator δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂
      + mondalHirotaSymbol δ ρ (omega₁ - omega₂) (k₁ - k₂) (l₁ - l₂) *
        mondalInteractionDenominator δ ρ omega₁ k₁ l₁ omega₂ k₂ l₂ = 0 := by
  unfold mondalInteractionNumerator mondalInteractionDenominator
  ring

/-! ## Closed two-exponential tau functions -/

/-- Constant certified KP jet. -/
def realEvolutionJetKPConst (c : ℝ) : RealEvolutionJetKP where
  u := fun _ _ _ => c
  ut := fun _ _ _ => 0
  ux := fun _ _ _ => 0
  uxx := fun _ _ _ => 0
  uxxx := fun _ _ _ => 0
  uxxxx := fun _ _ _ => 0
  utx := fun _ _ _ => 0
  uy := fun _ _ _ => 0
  uyy := fun _ _ _ => 0
  hasDerivAt_time := by intro t x y; exact hasDerivAt_const t c
  hasDerivAt_space := by intro t x y; exact hasDerivAt_const x c
  hasDerivAt_space_one := by intro t x y; exact hasDerivAt_const x 0
  hasDerivAt_space_two := by intro t x y; exact hasDerivAt_const x 0
  hasDerivAt_space_three := by intro t x y; exact hasDerivAt_const x 0
  hasDerivAt_time_space := by intro t x y; exact hasDerivAt_const x 0
  hasDerivAt_transverse := by intro t x y; exact hasDerivAt_const y c
  hasDerivAt_transverse_one := by intro t x y; exact hasDerivAt_const y 0

/-- Pointwise sum of certified KP jets. -/
noncomputable def realEvolutionJetKPAdd
    (J K : RealEvolutionJetKP) : RealEvolutionJetKP where
  u := fun t x y => J.u t x y + K.u t x y
  ut := fun t x y => J.ut t x y + K.ut t x y
  ux := fun t x y => J.ux t x y + K.ux t x y
  uxx := fun t x y => J.uxx t x y + K.uxx t x y
  uxxx := fun t x y => J.uxxx t x y + K.uxxx t x y
  uxxxx := fun t x y => J.uxxxx t x y + K.uxxxx t x y
  utx := fun t x y => J.utx t x y + K.utx t x y
  uy := fun t x y => J.uy t x y + K.uy t x y
  uyy := fun t x y => J.uyy t x y + K.uyy t x y
  hasDerivAt_time := by
    intro t x y
    exact (J.hasDerivAt_time t x y).add (K.hasDerivAt_time t x y)
  hasDerivAt_space := by
    intro t x y
    exact (J.hasDerivAt_space t x y).add (K.hasDerivAt_space t x y)
  hasDerivAt_space_one := by
    intro t x y
    exact (J.hasDerivAt_space_one t x y).add (K.hasDerivAt_space_one t x y)
  hasDerivAt_space_two := by
    intro t x y
    exact (J.hasDerivAt_space_two t x y).add (K.hasDerivAt_space_two t x y)
  hasDerivAt_space_three := by
    intro t x y
    exact (J.hasDerivAt_space_three t x y).add (K.hasDerivAt_space_three t x y)
  hasDerivAt_time_space := by
    intro t x y
    exact (J.hasDerivAt_time_space t x y).add (K.hasDerivAt_time_space t x y)
  hasDerivAt_transverse := by
    intro t x y
    exact (J.hasDerivAt_transverse t x y).add (K.hasDerivAt_transverse t x y)
  hasDerivAt_transverse_one := by
    intro t x y
    exact (J.hasDerivAt_transverse_one t x y).add (K.hasDerivAt_transverse_one t x y)

/-- Constant scalar multiple of a certified KP jet. -/
noncomputable def realEvolutionJetKPScale (c : ℝ) (J : RealEvolutionJetKP) : RealEvolutionJetKP where
  u := fun t x y => c * J.u t x y
  ut := fun t x y => c * J.ut t x y
  ux := fun t x y => c * J.ux t x y
  uxx := fun t x y => c * J.uxx t x y
  uxxx := fun t x y => c * J.uxxx t x y
  uxxxx := fun t x y => c * J.uxxxx t x y
  utx := fun t x y => c * J.utx t x y
  uy := fun t x y => c * J.uy t x y
  uyy := fun t x y => c * J.uyy t x y
  hasDerivAt_time := by
    intro t x y
    exact (J.hasDerivAt_time t x y).const_mul c
  hasDerivAt_space := by
    intro t x y
    exact (J.hasDerivAt_space t x y).const_mul c
  hasDerivAt_space_one := by
    intro t x y
    exact (J.hasDerivAt_space_one t x y).const_mul c
  hasDerivAt_space_two := by
    intro t x y
    exact (J.hasDerivAt_space_two t x y).const_mul c
  hasDerivAt_space_three := by
    intro t x y
    exact (J.hasDerivAt_space_three t x y).const_mul c
  hasDerivAt_time_space := by
    intro t x y
    exact (J.hasDerivAt_time_space t x y).const_mul c
  hasDerivAt_transverse := by
    intro t x y
    exact (J.hasDerivAt_transverse t x y).const_mul c
  hasDerivAt_transverse_one := by
    intro t x y
    exact (J.hasDerivAt_transverse_one t x y).const_mul c

/-- Certified jet of one pure exponential phase. -/
noncomputable def mondalExpWaveJet
    (omega k l shift : ℝ) : RealEvolutionJetKP :=
  realEvolutionJetKPAdd (mondalOneExponentialTauJet omega k l shift)
    (realEvolutionJetKPConst (-1))

theorem mondalExpWave_add
    (omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂ t x y : ℝ) :
    mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y =
      mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
        mondalExpWave omega₂ k₂ l₂ shift₂ t x y := by
  unfold mondalExpWave
  rw [← Real.exp_add]
  congr 1
  unfold mondalExpPhase
  ring

/-- Homogeneous two-exponential tau jet
`d(1 + exp η₁ + exp η₂) + n exp(η₁ + η₂)`.
Using projective coefficients avoids any nonvanishing premise on `d`. -/
noncomputable def mondalTwoExponentialTauJet
    (d n omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂ : ℝ) : RealEvolutionJetKP :=
  realEvolutionJetKPAdd
    (realEvolutionJetKPScale d
      (realEvolutionJetKPAdd (realEvolutionJetKPConst 1)
        (realEvolutionJetKPAdd
          (mondalExpWaveJet omega₁ k₁ l₁ shift₁)
          (mondalExpWaveJet omega₂ k₂ l₂ shift₂))))
    (realEvolutionJetKPScale n
      (mondalExpWaveJet (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂)))

theorem mondalTwoExponentialTau_hirotaResidual
    (δ ρ d n omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂ t x y : ℝ) :
    hirotaKPResidual δ ρ
        (mondalTwoExponentialTauJet d n
          omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂) t x y =
      2 * d ^ (2 : ℕ) * mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalHirotaSymbol δ ρ omega₁ k₁ l₁
        + 2 * d ^ (2 : ℕ) * mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalHirotaSymbol δ ρ omega₂ k₂ l₂
        + 2 * d * n *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalHirotaSymbol δ ρ (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂)
        + 2 * d ^ (2 : ℕ) *
          mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalHirotaSymbol δ ρ (omega₁ - omega₂) (k₁ - k₂) (l₁ - l₂)
        + 2 * d * n *
          mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalHirotaSymbol δ ρ omega₂ k₂ l₂
        + 2 * d * n *
          mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalHirotaSymbol δ ρ omega₁ k₁ l₁ := by
  simp only [hirotaKPResidual, mondalTwoExponentialTauJet, realEvolutionJetKPAdd,
    realEvolutionJetKPScale, realEvolutionJetKPConst, mondalExpWaveJet,
    mondalOneExponentialTauJet]
  unfold mondalHirotaSymbol
  ring

theorem mondalTwoExponentialTau_timeReversedHirotaResidual
    (δ ρ d n omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂ t x y : ℝ) :
    hirotaKPTimeReversedResidual δ ρ
        (mondalTwoExponentialTauJet d n
          omega₁ k₁ l₁ shift₁ omega₂ k₂ l₂ shift₂) t x y =
      2 * d ^ (2 : ℕ) * mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalTimeReversedHirotaSymbol δ ρ omega₁ k₁ l₁
        + 2 * d ^ (2 : ℕ) * mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalTimeReversedHirotaSymbol δ ρ omega₂ k₂ l₂
        + 2 * d * n *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalTimeReversedHirotaSymbol δ ρ (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂)
        + 2 * d ^ (2 : ℕ) *
          mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalTimeReversedHirotaSymbol δ ρ (omega₁ - omega₂) (k₁ - k₂) (l₁ - l₂)
        + 2 * d * n *
          mondalExpWave omega₁ k₁ l₁ shift₁ t x y *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalTimeReversedHirotaSymbol δ ρ omega₂ k₂ l₂
        + 2 * d * n *
          mondalExpWave omega₂ k₂ l₂ shift₂ t x y *
          mondalExpWave (omega₁ + omega₂) (k₁ + k₂) (l₁ + l₂) (shift₁ + shift₂) t x y *
          mondalTimeReversedHirotaSymbol δ ρ omega₁ k₁ l₁ := by
  simp only [hirotaKPTimeReversedResidual, mondalTwoExponentialTauJet,
    realEvolutionJetKPAdd, realEvolutionJetKPScale, realEvolutionJetKPConst,
    mondalExpWaveJet, mondalOneExponentialTauJet]
  unfold mondalTimeReversedHirotaSymbol
  ring

def mondalCorrectInteractionNumerator
    (δ ρ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  mondalInteractionNumerator δ ρ
    (mondalFrequency δ ρ k₁ slope₁) k₁ (k₁ * slope₁)
    (mondalFrequency δ ρ k₂ slope₂) k₂ (k₂ * slope₂)

def mondalCorrectInteractionDenominator
    (δ ρ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  mondalInteractionDenominator δ ρ
    (mondalFrequency δ ρ k₁ slope₁) k₁ (k₁ * slope₁)
    (mondalFrequency δ ρ k₂ slope₂) k₂ (k₂ * slope₂)

noncomputable def mondalCorrectedTwoExponentialTauJet
    (δ ρ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) : RealEvolutionJetKP :=
  mondalTwoExponentialTauJet
    (mondalCorrectInteractionDenominator δ ρ k₁ slope₁ k₂ slope₂)
    (mondalCorrectInteractionNumerator δ ρ k₁ slope₁ k₂ slope₂)
    (mondalFrequency δ ρ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalFrequency δ ρ k₂ slope₂) k₂ (k₂ * slope₂) shift₂

theorem mondalCorrectedTwoExponentialTau_solvesHirota
    (δ ρ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) :
    SolvesHirotaKP δ ρ
      (mondalCorrectedTwoExponentialTauJet δ ρ k₁ slope₁ shift₁ k₂ slope₂ shift₂) := by
  intro t x y
  unfold mondalCorrectedTwoExponentialTauJet
  rw [mondalTwoExponentialTau_hirotaResidual]
  simp only [mondalCorrectFrequency_symbol_zero, mul_zero, add_zero]
  unfold mondalCorrectInteractionNumerator mondalCorrectInteractionDenominator
    mondalInteractionNumerator mondalInteractionDenominator
  rw [mondalExpWave_add
    (mondalFrequency δ ρ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalFrequency δ ρ k₂ slope₂) k₂ (k₂ * slope₂) shift₂ t x y]
  ring

/-! ### Exact audit of printed two-soliton interaction coefficients (28) and (40) -/

def mondalPrintedRightA12Numerator (β γ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  k₁ * mondalPrintedRightFrequency β γ k₂ slope₂
    + k₂ * mondalPrintedRightFrequency β γ k₁ slope₁
    - β * (4 * k₁ ^ (3 : ℕ) * k₂ + 4 * k₁ * k₂ ^ (3 : ℕ) - 6 * k₁ ^ (2 : ℕ) * k₂ ^ (2 : ℕ))
    + 2 * γ * (k₁ * slope₁) * (k₂ * slope₂)

def mondalPrintedRightA12Denominator (β γ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  k₁ * mondalPrintedRightFrequency β γ k₂ slope₂
    + k₂ * mondalPrintedRightFrequency β γ k₁ slope₁
    - β * (4 * k₁ ^ (3 : ℕ) * k₂ + 4 * k₁ * k₂ ^ (3 : ℕ) + 6 * k₁ ^ (2 : ℕ) * k₂ ^ (2 : ℕ))
    + 2 * γ * (k₁ * slope₁) * (k₂ * slope₂)

theorem mondalPrintedRightA12Numerator_factor (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedRightA12Numerator β γ k₁ slope₁ k₂ slope₂ =
      -k₁ * k₂ * (3 * β * (k₁ - k₂) ^ (2 : ℕ) + γ * (slope₁ - slope₂) ^ (2 : ℕ)) := by
  unfold mondalPrintedRightA12Numerator mondalPrintedRightFrequency
  ring

theorem mondalPrintedRightA12Denominator_factor (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedRightA12Denominator β γ k₁ slope₁ k₂ slope₂ =
      -k₁ * k₂ * (3 * β * (k₁ + k₂) ^ (2 : ℕ) + γ * (slope₁ - slope₂) ^ (2 : ℕ)) := by
  unfold mondalPrintedRightA12Denominator mondalPrintedRightFrequency
  ring

theorem mondalPrintedRightA12Numerator_eq_symbol (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedRightA12Numerator β γ k₁ slope₁ k₂ slope₂ =
      -mondalTimeReversedHirotaSymbol (-β) γ
        (mondalPrintedRightFrequency β γ k₁ slope₁ -
          mondalPrintedRightFrequency β γ k₂ slope₂)
        (k₁ - k₂) (k₁ * slope₁ - k₂ * slope₂) := by
  unfold mondalPrintedRightA12Numerator mondalPrintedRightFrequency
    mondalTimeReversedHirotaSymbol
  ring

theorem mondalPrintedRightA12Denominator_eq_symbol (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedRightA12Denominator β γ k₁ slope₁ k₂ slope₂ =
      mondalTimeReversedHirotaSymbol (-β) γ
        (mondalPrintedRightFrequency β γ k₁ slope₁ +
          mondalPrintedRightFrequency β γ k₂ slope₂)
        (k₁ + k₂) (k₁ * slope₁ + k₂ * slope₂) := by
  unfold mondalPrintedRightA12Denominator mondalPrintedRightFrequency
    mondalTimeReversedHirotaSymbol
  ring

noncomputable def mondalPrintedRightTwoTauJet
    (β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) : RealEvolutionJetKP :=
  mondalTwoExponentialTauJet
    (mondalPrintedRightA12Denominator β γ k₁ slope₁ k₂ slope₂)
    (mondalPrintedRightA12Numerator β γ k₁ slope₁ k₂ slope₂)
    (mondalPrintedRightFrequency β γ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalPrintedRightFrequency β γ k₂ slope₂) k₂ (k₂ * slope₂) shift₂

theorem mondalPrintedRightTwoTau_solvesTimeReversedHirota
    (β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) :
    SolvesHirotaKPTimeReversed (-β) γ
      (mondalPrintedRightTwoTauJet β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂) := by
  intro t x y
  unfold mondalPrintedRightTwoTauJet
  rw [mondalTwoExponentialTau_timeReversedHirotaResidual]
  simp only [mondalPrintedRightFrequency_timeReversedSymbol_zero, mul_zero, add_zero]
  rw [mondalPrintedRightA12Numerator_eq_symbol,
    mondalPrintedRightA12Denominator_eq_symbol]
  rw [mondalExpWave_add
    (mondalPrintedRightFrequency β γ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalPrintedRightFrequency β γ k₂ slope₂) k₂ (k₂ * slope₂) shift₂ t x y]
  ring

def mondalPrintedLeftB12Numerator (β γ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  k₁ * mondalPrintedLeftFrequency β γ k₂ slope₂
    + k₂ * mondalPrintedLeftFrequency β γ k₁ slope₁
    + β * (4 * k₁ ^ (3 : ℕ) * k₂ + 4 * k₁ * k₂ ^ (3 : ℕ) - 6 * k₁ ^ (2 : ℕ) * k₂ ^ (2 : ℕ))
    - 2 * γ * (k₁ * slope₁) * (k₂ * slope₂)

def mondalPrintedLeftB12Denominator (β γ k₁ slope₁ k₂ slope₂ : ℝ) : ℝ :=
  k₁ * mondalPrintedLeftFrequency β γ k₂ slope₂
    + k₂ * mondalPrintedLeftFrequency β γ k₁ slope₁
    + β * (4 * k₁ ^ (3 : ℕ) * k₂ + 4 * k₁ * k₂ ^ (3 : ℕ) + 6 * k₁ ^ (2 : ℕ) * k₂ ^ (2 : ℕ))
    - 2 * γ * (k₁ * slope₁) * (k₂ * slope₂)

theorem mondalPrintedLeftB12Numerator_factor (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedLeftB12Numerator β γ k₁ slope₁ k₂ slope₂ =
      k₁ * k₂ * (3 * β * (k₁ - k₂) ^ (2 : ℕ) + γ * (slope₁ - slope₂) ^ (2 : ℕ)) := by
  unfold mondalPrintedLeftB12Numerator mondalPrintedLeftFrequency
  ring

theorem mondalPrintedLeftB12Denominator_factor (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedLeftB12Denominator β γ k₁ slope₁ k₂ slope₂ =
      k₁ * k₂ * (3 * β * (k₁ + k₂) ^ (2 : ℕ) + γ * (slope₁ - slope₂) ^ (2 : ℕ)) := by
  unfold mondalPrintedLeftB12Denominator mondalPrintedLeftFrequency
  ring

theorem mondalPrintedLeftB12Numerator_eq_symbol (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedLeftB12Numerator β γ k₁ slope₁ k₂ slope₂ =
      -mondalTimeReversedHirotaSymbol β (-γ)
        (mondalPrintedLeftFrequency β γ k₁ slope₁ -
          mondalPrintedLeftFrequency β γ k₂ slope₂)
        (k₁ - k₂) (k₁ * slope₁ - k₂ * slope₂) := by
  unfold mondalPrintedLeftB12Numerator mondalPrintedLeftFrequency
    mondalTimeReversedHirotaSymbol
  ring

theorem mondalPrintedLeftB12Denominator_eq_symbol (β γ k₁ slope₁ k₂ slope₂ : ℝ) :
    mondalPrintedLeftB12Denominator β γ k₁ slope₁ k₂ slope₂ =
      mondalTimeReversedHirotaSymbol β (-γ)
        (mondalPrintedLeftFrequency β γ k₁ slope₁ +
          mondalPrintedLeftFrequency β γ k₂ slope₂)
        (k₁ + k₂) (k₁ * slope₁ + k₂ * slope₂) := by
  unfold mondalPrintedLeftB12Denominator mondalPrintedLeftFrequency
    mondalTimeReversedHirotaSymbol
  ring

noncomputable def mondalPrintedLeftTwoTauJet
    (β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) : RealEvolutionJetKP :=
  mondalTwoExponentialTauJet
    (mondalPrintedLeftB12Denominator β γ k₁ slope₁ k₂ slope₂)
    (mondalPrintedLeftB12Numerator β γ k₁ slope₁ k₂ slope₂)
    (mondalPrintedLeftFrequency β γ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalPrintedLeftFrequency β γ k₂ slope₂) k₂ (k₂ * slope₂) shift₂

theorem mondalPrintedLeftTwoTau_solvesTimeReversedHirota
    (β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂ : ℝ) :
    SolvesHirotaKPTimeReversed β (-γ)
      (mondalPrintedLeftTwoTauJet β γ k₁ slope₁ shift₁ k₂ slope₂ shift₂) := by
  intro t x y
  unfold mondalPrintedLeftTwoTauJet
  rw [mondalTwoExponentialTau_timeReversedHirotaResidual]
  simp only [mondalPrintedLeftFrequency_timeReversedSymbol_zero, mul_zero, add_zero]
  rw [mondalPrintedLeftB12Numerator_eq_symbol,
    mondalPrintedLeftB12Denominator_eq_symbol]
  rw [mondalExpWave_add
    (mondalPrintedLeftFrequency β γ k₁ slope₁) k₁ (k₁ * slope₁) shift₁
    (mondalPrintedLeftFrequency β γ k₂ slope₂) k₂ (k₂ * slope₂) shift₂ t x y]
  ring

/-! ## Quadratic Hirota tau functions and the lump correction -/

def mondalQuadraticTau
    (a b c d e h j m offset t x y : ℝ) : ℝ :=
  mondalAffineForm a b c d t x y ^ (2 : ℕ) + mondalAffineForm e h j m t x y ^ (2 : ℕ) + offset

private theorem hasDerivAt_mondalAffineForm_time
    (a b c d t x y : ℝ) :
    HasDerivAt (fun z => mondalAffineForm a b c d z x y) c t := by
  unfold mondalAffineForm
  have h := ((hasDerivAt_const t (a * x + b * y)).add
    ((hasDerivAt_id t).const_mul c)).add_const d
  simpa [id_eq] using h

private theorem hasDerivAt_mondalAffineForm_space
    (a b c d t x y : ℝ) :
    HasDerivAt (fun z => mondalAffineForm a b c d t z y) a x := by
  unfold mondalAffineForm
  have h := ((hasDerivAt_id x).const_mul a).add_const (b * y)
  have h := h.add_const (c * t)
  have h := h.add_const d
  simpa [id_eq, add_assoc] using h

private theorem hasDerivAt_mondalAffineForm_transverse
    (a b c d t x y : ℝ) :
    HasDerivAt (fun z => mondalAffineForm a b c d t x z) b y := by
  unfold mondalAffineForm
  have h := ((hasDerivAt_const y (a * x)).add
    ((hasDerivAt_id y).const_mul b)).add_const (c * t)
  have h := h.add_const d
  simpa [id_eq, add_assoc] using h

/-- Actual derivative jet of `f² + g² + offset` for affine `f,g`. -/
noncomputable def mondalQuadraticTauJet
    (a b c d e h j m offset : ℝ) : RealEvolutionJetKP where
  u := mondalQuadraticTau a b c d e h j m offset
  ut := fun t x y => 2 * (c * mondalAffineForm a b c d t x y
    + j * mondalAffineForm e h j m t x y)
  ux := fun t x y => 2 * (a * mondalAffineForm a b c d t x y
    + e * mondalAffineForm e h j m t x y)
  uxx := fun _ _ _ => 2 * (a ^ (2 : ℕ) + e ^ (2 : ℕ))
  uxxx := fun _ _ _ => 0
  uxxxx := fun _ _ _ => 0
  utx := fun _ _ _ => 2 * (c * a + j * e)
  uy := fun t x y => 2 * (b * mondalAffineForm a b c d t x y
    + h * mondalAffineForm e h j m t x y)
  uyy := fun _ _ _ => 2 * (b ^ (2 : ℕ) + h ^ (2 : ℕ))
  hasDerivAt_time := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_time a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_time e h j m t x y
    have hder := ((hf.pow 2).add (hg.pow 2)).add_const offset
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp [mondalQuadraticTau]
  hasDerivAt_space := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_space a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_space e h j m t x y
    have hder := ((hf.pow 2).add (hg.pow 2)).add_const offset
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp [mondalQuadraticTau]
  hasDerivAt_space_one := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_space a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_space e h j m t x y
    have hder := (hf.const_mul a).add (hg.const_mul e) |>.const_mul 2
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp
  hasDerivAt_space_two := by
    intro t x y
    exact hasDerivAt_const x (2 * (a ^ (2 : ℕ) + e ^ (2 : ℕ)))
  hasDerivAt_space_three := by
    intro t x y
    exact hasDerivAt_const x 0
  hasDerivAt_time_space := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_space a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_space e h j m t x y
    have hder := (hf.const_mul c).add (hg.const_mul j) |>.const_mul 2
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp
  hasDerivAt_transverse := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_transverse a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_transverse e h j m t x y
    have hder := ((hf.pow 2).add (hg.pow 2)).add_const offset
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp [mondalQuadraticTau]
  hasDerivAt_transverse_one := by
    intro t x y
    have hf := hasDerivAt_mondalAffineForm_transverse a b c d t x y
    have hg := hasDerivAt_mondalAffineForm_transverse e h j m t x y
    have hder := (hf.const_mul b).add (hg.const_mul h) |>.const_mul 2
    apply (hder.congr_deriv (by ring)).congr_of_eventuallyEq
    exact Filter.Eventually.of_forall fun z => by simp

/-- Determinant-one parameterization of paper's lump spatial affine forms. -/
def mondalLumpH (r b : ℝ) : ℝ := 1 + r * b
def mondalLumpNormSq (r : ℝ) : ℝ := 1 + r ^ (2 : ℕ)

noncomputable def mondalLumpVelocityF (gammaLog r b : ℝ) : ℝ :=
  Real.exp gammaLog *
    (b ^ (2 : ℕ) - mondalLumpH r b ^ (2 : ℕ) + 2 * r * b * mondalLumpH r b) /
      mondalLumpNormSq r

/-- Corrected `b₇`: final `b₅ b₆²` term has positive sign. -/
noncomputable def mondalLumpVelocityG (gammaLog r b : ℝ) : ℝ :=
  Real.exp gammaLog *
    (2 * b * mondalLumpH r b - r * b ^ (2 : ℕ) + r * mondalLumpH r b ^ (2 : ℕ)) /
      mondalLumpNormSq r

/-- Printed `b₇` from equation (45), with the erroneous negative final term. -/
noncomputable def mondalPrintedLumpVelocityG (gammaLog r b : ℝ) : ℝ :=
  Real.exp gammaLog *
    (2 * b * mondalLumpH r b - r * b ^ (2 : ℕ) - r * mondalLumpH r b ^ (2 : ℕ)) /
      mondalLumpNormSq r

noncomputable def mondalLumpOffset (beta gammaLog r : ℝ) : ℝ :=
  3 * beta / Real.exp gammaLog * mondalLumpNormSq r ^ (3 : ℕ)

noncomputable def mondalCorrectedLumpTauJet
    (beta gammaLog r b d m : ℝ) : RealEvolutionJetKP :=
  mondalQuadraticTauJet 1 b (mondalLumpVelocityF gammaLog r b) d
    r (mondalLumpH r b) (mondalLumpVelocityG gammaLog r b) m
    (mondalLumpOffset beta gammaLog r)

theorem mondalCorrectedLumpTau_solvesHirota
    (beta gammaLog r b d m : ℝ) :
    SolvesHirotaKP beta (-Real.exp gammaLog)
      (mondalCorrectedLumpTauJet beta gammaLog r b d m) := by
  intro t x y
  have hnorm : mondalLumpNormSq r ≠ 0 := by
    unfold mondalLumpNormSq
    nlinarith [sq_nonneg r]
  have hgamma : Real.exp gammaLog ≠ 0 := Real.exp_ne_zero gammaLog
  unfold hirotaKPResidual mondalCorrectedLumpTauJet mondalQuadraticTauJet
  unfold mondalLumpVelocityF mondalLumpVelocityG mondalLumpOffset mondalLumpH
    mondalLumpNormSq mondalQuadraticTau mondalAffineForm
  field_simp [hnorm, hgamma]
  ring

theorem mondalPrintedLumpVelocityG_error (gammaLog r b : ℝ) :
    mondalLumpVelocityG gammaLog r b - mondalPrintedLumpVelocityG gammaLog r b =
      2 * Real.exp gammaLog * r * mondalLumpH r b ^ (2 : ℕ) / mondalLumpNormSq r := by
  have hnorm : mondalLumpNormSq r ≠ 0 := by
    unfold mondalLumpNormSq
    nlinarith [sq_nonneg r]
  unfold mondalLumpVelocityG mondalPrintedLumpVelocityG
  field_simp [hnorm]
  ring

noncomputable def mondalLumpCurvatureCore (a e f g offset : ℝ) : ℝ :=
  let tau := f ^ (2 : ℕ) + g ^ (2 : ℕ) + offset
  let q := a * f + e * g
  (2 * (a ^ (2 : ℕ) + e ^ (2 : ℕ)) * tau - 4 * q ^ (2 : ℕ)) / tau ^ (2 : ℕ)

noncomputable def mondalPrintedLumpCurvatureCore (a e f g offset : ℝ) : ℝ :=
  let tau := f ^ (2 : ℕ) + g ^ (2 : ℕ) + offset
  let q := a * f + e * g
  (2 * (a ^ (2 : ℕ) + e ^ (2 : ℕ)) * tau - 4 * q) / tau ^ (2 : ℕ)

theorem mondalPrintedLumpCurvature_error (a e f g offset : ℝ) :
    mondalPrintedLumpCurvatureCore a e f g offset -
        mondalLumpCurvatureCore a e f g offset =
      4 * ((a * f + e * g) ^ (2 : ℕ) - (a * f + e * g)) /
        (f ^ (2 : ℕ) + g ^ (2 : ℕ) + offset) ^ (2 : ℕ) := by
  unfold mondalPrintedLumpCurvatureCore mondalLumpCurvatureCore
  ring

noncomputable def mondalPositiveQuadraticTauJet
    (a b c d e h j m offsetLog : ℝ) : RealEvolutionJetKP :=
  mondalQuadraticTauJet a b c d e h j m (Real.exp offsetLog)

theorem mondalPositiveQuadraticTau_pos
    (a b c d e h j m offsetLog t x y : ℝ) :
    0 < (mondalPositiveQuadraticTauJet a b c d e h j m offsetLog).u t x y := by
  unfold mondalPositiveQuadraticTauJet mondalQuadraticTauJet mondalQuadraticTau
  nlinarith [sq_nonneg (mondalAffineForm a b c d t x y),
    sq_nonneg (mondalAffineForm e h j m t x y), Real.exp_pos offsetLog]

noncomputable def mondalPositiveQuadraticTauLog
    (a b c d e h j m offsetLog t x y : ℝ) : ℝ :=
  Real.log ((mondalPositiveQuadraticTauJet a b c d e h j m offsetLog).u t x y)

noncomputable def mondalPositiveQuadraticTauLogSlope
    (a b c d e h j m offsetLog t x y : ℝ) : ℝ :=
  (mondalPositiveQuadraticTauJet a b c d e h j m offsetLog).ux t x y /
    (mondalPositiveQuadraticTauJet a b c d e h j m offsetLog).u t x y

theorem hasDerivAt_mondalPositiveQuadraticTauLog
    (a b c d e h j m offsetLog t x y : ℝ) :
    HasDerivAt (fun z => mondalPositiveQuadraticTauLog
      a b c d e h j m offsetLog t z y)
      (mondalPositiveQuadraticTauLogSlope a b c d e h j m offsetLog t x y) x := by
  let J := mondalPositiveQuadraticTauJet a b c d e h j m offsetLog
  have hpos := mondalPositiveQuadraticTau_pos a b c d e h j m offsetLog t x y
  have h := (J.hasDerivAt_space t x y).log (ne_of_gt hpos)
  exact h

theorem hasDerivAt_mondalPositiveQuadraticTauLogSlope
    (a b c d e h j m offsetLog t x y : ℝ) :
    HasDerivAt (fun z => mondalPositiveQuadraticTauLogSlope
      a b c d e h j m offsetLog t z y)
      (mondalLumpCurvatureCore a e
        (mondalAffineForm a b c d t x y) (mondalAffineForm e h j m t x y)
        (Real.exp offsetLog)) x := by
  let J := mondalPositiveQuadraticTauJet a b c d e h j m offsetLog
  have hne : J.u t x y ≠ 0 := ne_of_gt
    (mondalPositiveQuadraticTau_pos a b c d e h j m offsetLog t x y)
  have h := (J.hasDerivAt_space_one t x y).div (J.hasDerivAt_space t x y) hne
  apply (h.congr_deriv ?_)
  unfold J mondalPositiveQuadraticTauJet mondalQuadraticTauJet
    mondalLumpCurvatureCore mondalQuadraticTau
  field_simp [hne]
  ring

/-! ## Premise-free parameterization of the paper's physical regime -/

noncomputable def mondalKappa (q : ℝ) : ℝ := 3 / 2 + Real.exp q
noncomputable def mondalHotConcentration (p : ℝ) : ℝ := Real.exp p
def mondalTemperatureRatio (s : ℝ) : ℝ := s ^ (2 : ℕ)

noncomputable def mondalA1 (q : ℝ) : ℝ :=
  (mondalKappa q - 1 / 2) / (mondalKappa q - 3 / 2)

noncomputable def mondalB1 (q : ℝ) : ℝ :=
  (mondalKappa q ^ (2 : ℕ) - 1 / 4) / (2 * (mondalKappa q - 3 / 2) ^ (2 : ℕ))

noncomputable def mondalPhaseSpeedSq (q p s : ℝ) : ℝ :=
  1 / mondalA1 q + mondalHotConcentration p * mondalTemperatureRatio s

noncomputable def mondalPhaseSpeed (q p s : ℝ) : ℝ :=
  Real.sqrt (mondalPhaseSpeedSq q p s)

noncomputable def mondalA (q p s : ℝ) : ℝ :=
  2 * mondalPhaseSpeed q p s * mondalA1 q * mondalHotConcentration p

noncomputable def mondalB (q p s : ℝ) : ℝ :=
  2 * mondalB1 q / mondalA1 q
    + 2 * mondalPhaseSpeedSq q p s * mondalA1 q ^ (2 : ℕ) * mondalHotConcentration p ^ (2 : ℕ)
    + mondalHotConcentration p ^ (2 : ℕ) * mondalA1 q

noncomputable def mondalC (q p : ℝ) : ℝ := mondalHotConcentration p / mondalA1 q
noncomputable def mondalD (q p s : ℝ) : ℝ :=
  mondalPhaseSpeedSq q p s * mondalHotConcentration p * mondalA1 q

noncomputable def mondalAlpha (q p s : ℝ) : ℝ := -mondalB q p s / mondalA q p s
noncomputable def mondalBeta (q p s : ℝ) : ℝ := -mondalC q p / mondalA q p s
noncomputable def mondalGamma (q p s : ℝ) : ℝ := mondalD q p s / mondalA q p s

theorem mondalKappa_gt_three_halves (q : ℝ) : 3 / 2 < mondalKappa q := by
  unfold mondalKappa
  have := Real.exp_pos q
  linarith

theorem mondalA1_pos (q : ℝ) : 0 < mondalA1 q := by
  have h := Real.exp_pos q
  have hnum : mondalKappa q - 1 / 2 = 1 + Real.exp q := by
    unfold mondalKappa
    ring
  have hden : mondalKappa q - 3 / 2 = Real.exp q := by
    unfold mondalKappa
    ring
  rw [mondalA1, hnum, hden]
  exact div_pos (by linarith) h

theorem mondalB1_pos (q : ℝ) : 0 < mondalB1 q := by
  have h := Real.exp_pos q
  have hnum : 0 < mondalKappa q ^ (2 : ℕ) - 1 / 4 := by
    unfold mondalKappa
    nlinarith [sq_nonneg (Real.exp q)]
  have hden : 0 < 2 * (mondalKappa q - 3 / 2) ^ (2 : ℕ) := by
    have heq : mondalKappa q - 3 / 2 = Real.exp q := by
      unfold mondalKappa
      ring
    rw [heq]
    positivity
  unfold mondalB1
  exact div_pos hnum hden

theorem mondalPhaseSpeedSq_pos (q p s : ℝ) : 0 < mondalPhaseSpeedSq q p s := by
  unfold mondalPhaseSpeedSq mondalHotConcentration mondalTemperatureRatio
  have hA := mondalA1_pos q
  have hp := Real.exp_pos p
  positivity

theorem mondalPhaseSpeed_pos (q p s : ℝ) : 0 < mondalPhaseSpeed q p s := by
  exact Real.sqrt_pos.2 (mondalPhaseSpeedSq_pos q p s)

theorem mondalA_pos (q p s : ℝ) : 0 < mondalA q p s := by
  unfold mondalA mondalHotConcentration
  have hs := mondalPhaseSpeed_pos q p s
  have hA1 := mondalA1_pos q
  have hp := Real.exp_pos p
  positivity

theorem mondalB_pos (q p s : ℝ) : 0 < mondalB q p s := by
  unfold mondalB mondalHotConcentration
  have hA1 := mondalA1_pos q
  have hB1 := mondalB1_pos q
  have hs := mondalPhaseSpeedSq_pos q p s
  have hp := Real.exp_pos p
  positivity

theorem mondalC_pos (q p : ℝ) : 0 < mondalC q p := by
  unfold mondalC mondalHotConcentration
  exact div_pos (Real.exp_pos p) (mondalA1_pos q)

theorem mondalD_pos (q p s : ℝ) : 0 < mondalD q p s := by
  unfold mondalD mondalHotConcentration
  exact mul_pos (mul_pos (mondalPhaseSpeedSq_pos q p s) (Real.exp_pos p)) (mondalA1_pos q)

theorem mondalAlpha_neg (q p s : ℝ) : mondalAlpha q p s < 0 := by
  unfold mondalAlpha
  exact div_neg_of_neg_of_pos (neg_neg_of_pos (mondalB_pos q p s)) (mondalA_pos q p s)

theorem mondalBeta_neg (q p s : ℝ) : mondalBeta q p s < 0 := by
  unfold mondalBeta
  exact div_neg_of_neg_of_pos (neg_neg_of_pos (mondalC_pos q p)) (mondalA_pos q p s)

theorem mondalGamma_pos (q p s : ℝ) : 0 < mondalGamma q p s := by
  unfold mondalGamma
  exact div_pos (mondalD_pos q p s) (mondalA_pos q p s)

theorem mondalA1_gt_one (q : ℝ) : 1 < mondalA1 q := by
  have hexp := Real.exp_pos q
  have hnum : mondalKappa q - 1 / 2 = 1 + Real.exp q := by
    unfold mondalKappa
    ring
  have hden : mondalKappa q - 3 / 2 = Real.exp q := by
    unfold mondalKappa
    ring
  rw [mondalA1, hnum, hden]
  apply (lt_div_iff₀ hexp).2
  linarith

theorem mondalPhaseSpeed_sq (q p s : ℝ) :
    mondalPhaseSpeed q p s ^ (2 : ℕ) = mondalPhaseSpeedSq q p s := by
  unfold mondalPhaseSpeed
  exact Real.sq_sqrt (le_of_lt (mondalPhaseSpeedSq_pos q p s))

theorem mondalBeta_div_gamma (q p s : ℝ) :
    mondalBeta q p s / mondalGamma q p s =
      -1 / (mondalPhaseSpeedSq q p s * mondalA1 q ^ (2 : ℕ)) := by
  have hA : mondalA q p s ≠ 0 := ne_of_gt (mondalA_pos q p s)
  have hA1 : mondalA1 q ≠ 0 := ne_of_gt (mondalA1_pos q)
  have hp : mondalHotConcentration p ≠ 0 := by
    unfold mondalHotConcentration
    exact Real.exp_ne_zero p
  have hs : mondalPhaseSpeedSq q p s ≠ 0 := ne_of_gt (mondalPhaseSpeedSq_pos q p s)
  unfold mondalBeta mondalGamma mondalC mondalD
  field_simp [hA, hA1, hp, hs]

theorem mondalBeta_div_alpha (q p s : ℝ) :
    mondalBeta q p s / mondalAlpha q p s = mondalC q p / mondalB q p s := by
  have hA : mondalA q p s ≠ 0 := ne_of_gt (mondalA_pos q p s)
  have hB : mondalB q p s ≠ 0 := ne_of_gt (mondalB_pos q p s)
  unfold mondalBeta mondalAlpha
  field_simp [hA, hB]

theorem mondalCorrectedLeftAmplitudeFactor_pos (q p s : ℝ) :
    0 < 3 * mondalBeta q p s / mondalAlpha q p s := by
  have hb := mondalBeta_neg q p s
  have ha := mondalAlpha_neg q p s
  exact div_pos_of_neg_of_neg (mul_neg_of_pos_of_neg (by positivity) hb) ha

theorem mondalCorrectedRightAmplitudeFactor_neg (q p s : ℝ) :
    3 * (-mondalBeta q p s) / mondalAlpha q p s < 0 := by
  exact div_neg_of_pos_of_neg
    (mul_pos (by positivity) (neg_pos.mpr (mondalBeta_neg q p s)))
    (mondalAlpha_neg q p s)

noncomputable def mondalPhysicalLumpOffset (q p s : ℝ) : ℝ :=
  3 * mondalBeta q p s / mondalGamma q p s

theorem mondalPhysicalLumpOffset_neg (q p s : ℝ) :
    mondalPhysicalLumpOffset q p s < 0 := by
  unfold mondalPhysicalLumpOffset
  exact div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg (by positivity) (mondalBeta_neg q p s))
    (mondalGamma_pos q p s)

noncomputable def mondalPhysicalLumpTau (q p s t x y : ℝ) : ℝ :=
  (x - mondalGamma q p s * t) ^ (2 : ℕ) + y ^ (2 : ℕ) + mondalPhysicalLumpOffset q p s

theorem mondalPhysicalLumpTau_origin_neg (q p s : ℝ) :
    mondalPhysicalLumpTau q p s 0 0 0 < 0 := by
  simpa [mondalPhysicalLumpTau] using mondalPhysicalLumpOffset_neg q p s

theorem mondalPhysicalLumpTau_has_zero (q p s : ℝ) :
    mondalPhysicalLumpTau q p s 0 (Real.sqrt (-mondalPhysicalLumpOffset q p s)) 0 = 0 := by
  have hnonneg : 0 ≤ -mondalPhysicalLumpOffset q p s :=
    le_of_lt (neg_pos.mpr (mondalPhysicalLumpOffset_neg q p s))
  rw [mondalPhysicalLumpTau]
  simp only [mul_zero, sub_zero]
  rw [Real.sq_sqrt hnonneg]
  ring

end GaloisForLFunctions.HTGeometry.DispersivePDE
