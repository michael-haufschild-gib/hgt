import GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElasticaCorrectedJacobiMomentum
import Mathlib.Tactic

/-!
# Bohm potential and WKB phase of the corrected Jacobi wave

The paper's WKB phase is twice the Hasimoto phase used by the complex NLS field.  Here its two
partial derivatives are certified, and the phase equation is proved together with the exact Bohm
potential generated by the corrected Jacobi curvature.
-/

namespace GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElastica

noncomputable def correctedJacobiBohmTerm
    (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (s : ℝ) : ℝ :=
  physicalJacobiCurvatureAcceleration k₀ P J s /
    physicalJacobiCurvature k₀ P J s

theorem correctedJacobiBohmTerm_eq
    (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (s : ℝ) :
    correctedJacobiBohmTerm k₀ P J s =
      -physicalJacobiCurvature k₀ P J s ^ 2 / 2 -
        (k₀ : ℝ) ^ 2 * physicalGamma P ^ 2 / 4 +
        (k₀ : ℝ) ^ 6 * physicalNu P ^ 2 /
          (4 * physicalJacobiCurvature k₀ P J s ^ 4) := by
  rw [correctedJacobiBohmTerm, physicalJacobiCurvature_equation]
  field_simp [ne_of_gt (physicalJacobiCurvature_pos k₀ P J s)]

/-- Paper equation (53), with `λ=-γ²/2` and `τ₀=k₀ν/2`. -/
theorem correctedJacobiHydrodynamicPotential_eq
    (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (s : ℝ) :
    physicalJacobiCurvature k₀ P J s ^ 2 +
        2 * correctedJacobiBohmTerm k₀ P J s =
      (k₀ : ℝ) ^ 2 * waveLambda (physicalGamma P) +
        2 * (k₀ : ℝ) ^ 4 * physicalJacobiTorsionScale k₀ P ^ 2 /
          physicalJacobiCurvature k₀ P J s ^ 4 := by
  rw [correctedJacobiBohmTerm_eq, waveLambda, physicalJacobiTorsionScale]
  ring

noncomputable def correctedJacobiHydroPhase
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) : ℝ :=
  2 * physicalJacobiPhase k₀ P J
    (s - physicalJacobiWaveSpeed D k₀ P * t)

noncomputable def correctedJacobiHydroPhaseT
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) : ℝ :=
  -2 * physicalJacobiWaveSpeed D k₀ P *
    physicalJacobiPhaseSlope k₀ P J
      (s - physicalJacobiWaveSpeed D k₀ P * t)

noncomputable def correctedJacobiHydroPhaseX
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) : ℝ :=
  2 * physicalJacobiPhaseSlope k₀ P J
    (s - physicalJacobiWaveSpeed D k₀ P * t)

theorem hasDerivAt_correctedJacobiHydroPhase_time
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) :
    HasDerivAt (fun r : ℝ => correctedJacobiHydroPhase D k₀ P J r s)
      (correctedJacobiHydroPhaseT D k₀ P J t s) t := by
  have hinner : HasDerivAt
      (fun r : ℝ => s - physicalJacobiWaveSpeed D k₀ P * r)
      (-physicalJacobiWaveSpeed D k₀ P) t := by
    simpa using! ((hasDerivAt_id t).const_mul
      (physicalJacobiWaveSpeed D k₀ P)).const_sub s
  have hcomp :=
    (physicalJacobiPhase_hasDerivAt k₀ P J
      (s - physicalJacobiWaveSpeed D k₀ P * t)).scomp t hinner
  have h := hcomp.const_mul 2
  change HasDerivAt
    (fun r : ℝ => 2 * physicalJacobiPhase k₀ P J
      (s - physicalJacobiWaveSpeed D k₀ P * r))
    (correctedJacobiHydroPhaseT D k₀ P J t s) t
  apply h.congr_deriv
  rw [correctedJacobiHydroPhaseT]
  simp only [smul_eq_mul]
  ring

theorem hasDerivAt_correctedJacobiHydroPhase_space
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) :
    HasDerivAt (correctedJacobiHydroPhase D k₀ P J t)
      (correctedJacobiHydroPhaseX D k₀ P J t s) s := by
  have hinner : HasDerivAt
      (fun y : ℝ => y - physicalJacobiWaveSpeed D k₀ P * t) 1 s :=
    (hasDerivAt_id s).sub_const _
  have hcomp :=
    (physicalJacobiPhase_hasDerivAt k₀ P J
      (s - physicalJacobiWaveSpeed D k₀ P * t)).scomp s hinner
  have h := hcomp.const_mul 2
  change HasDerivAt
    (fun y : ℝ => 2 * physicalJacobiPhase k₀ P J
      (y - physicalJacobiWaveSpeed D k₀ P * t))
    (correctedJacobiHydroPhaseX D k₀ P J t s) s
  apply h.congr_deriv
  rw [correctedJacobiHydroPhaseX]
  simp only [one_smul]

/-- The fluid velocity is `D ∂ₛΦ` for the paper's doubled WKB phase. -/
theorem correctedJacobiHydroVelocity_eq_phaseDerivative
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) :
    travelingHydroVelocity (D : ℝ) (k₀ : ℝ)
        (physicalJacobiTorsionScale k₀ P)
        (physicalJacobiWaveSpeed D k₀ P)
        (correctedJacobiCurvatureProfileJet k₀ P J) t s =
      (D : ℝ) * correctedJacobiHydroPhaseX D k₀ P J t s := by
  rw [correctedJacobiHydroVelocity_eq_phaseSlope,
    correctedJacobiHydroPhaseX]
  ring

/-- Paper equation (52): exact WKB/Madelung phase balance. -/
theorem correctedJacobiHydroPhaseEquation
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t s : ℝ) :
    correctedJacobiHydroPhaseT D k₀ P J t s +
        travelingHydroVelocity (D : ℝ) (k₀ : ℝ)
          (physicalJacobiTorsionScale k₀ P)
          (physicalJacobiWaveSpeed D k₀ P)
          (correctedJacobiCurvatureProfileJet k₀ P J) t s ^ 2 /
            (2 * (D : ℝ)) =
      (D : ℝ) *
        (travelingDensity (correctedJacobiCurvatureProfileJet k₀ P J)
            (physicalJacobiWaveSpeed D k₀ P) t s +
          2 * correctedJacobiBohmTerm k₀ P J
            (s - physicalJacobiWaveSpeed D k₀ P * t)) := by
  rw [correctedJacobiHydroPhaseT,
    correctedJacobiHydroVelocity_eq_phaseSlope,
    correctedJacobiTravelingDensity_eq_curvature_sq,
    correctedJacobiHydrodynamicPotential_eq,
    physicalJacobiWaveSpeed, physicalJacobiPhaseSlope,
    physicalJacobiTorsionScale, waveLambda, physicalJacobiCurvature]
  field_simp [D.ne_zero, ne_of_gt k₀.property,
    ne_of_gt (correctedJacobiAmplitude_pos P J
      (physicalJacobiArgument k₀ P
        (s - (D : ℝ) * (k₀ : ℝ) * physicalGamma P * t)))]
  ring

theorem correctedJacobiHydroPhase_center
    (D : ℝˣ) (k₀ : PositiveCurvatureScale) (P : PhysicalRegionI)
    (J : JacobiEllipticSystem P.val.modulus) (t : ℝ) :
    correctedJacobiHydroPhase D k₀ P J t
      (physicalJacobiWaveSpeed D k₀ P * t) = 0 := by
  rw [correctedJacobiHydroPhase]
  have hz : physicalJacobiWaveSpeed D k₀ P * t -
      physicalJacobiWaveSpeed D k₀ P * t = 0 := by ring
  rw [hz, physicalJacobiPhase_zero]
  ring

end GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElastica
