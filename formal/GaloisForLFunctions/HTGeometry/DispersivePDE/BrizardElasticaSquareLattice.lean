import GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElasticaParameterTransport
import Mathlib.Tactic

/-!
# Brizard's lemniscatic modulus and the analytic square lattice

The paper identifies its stationary `m = 1/2` solution as lemniscatic.  This module constructs the
actual mathlib period lattice generated by `1` and `i`.  Multiplication by `i` preserves that lattice,
whereas the analytic invariant `g₃` has homogeneity weight `-6`; hence `g₃ = -g₃`, so `g₃ = 0`.
Brizard's rational invariant at `m = 1/2` vanishes for the same reason.  Both analytic and algebraic
curves therefore have the square-lattice short-Weierstrass shape `y² = x³ + a x`.
-/

namespace GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElastica

/-- The square period lattice generated by `1` and `i`. -/
noncomputable def squarePeriodPair : PeriodPair where
  ω₁ := 1
  ω₂ := Complex.I
  indep := by
    simpa only [Complex.coe_basisOneI] using Complex.basisOneI.linearIndependent

/-- The quarter-turn scalar as a nonzero complex unit. -/
noncomputable def complexIUnit : ℂˣ := Units.mk0 Complex.I Complex.I_ne_zero

@[simp] theorem coe_complexIUnit : (complexIUnit : ℂ) = Complex.I := rfl

/-- A quarter turn merely changes the integral basis of the square lattice. -/
theorem scaleI_square_lattice :
    (scalePeriodPair complexIUnit squarePeriodPair).lattice = squarePeriodPair.lattice := by
  ext z
  constructor
  · intro hz
    obtain ⟨m, n, hmn⟩ := PeriodPair.mem_lattice.mp hz
    rw [PeriodPair.mem_lattice]
    refine ⟨-n, m, ?_⟩
    simp only [scalePeriodPair_ω₁, scalePeriodPair_ω₂, coe_complexIUnit,
      squarePeriodPair] at hmn
    simp only [squarePeriodPair]
    push_cast at hmn ⊢
    rw [Complex.I_mul_I] at hmn
    linear_combination hmn
  · intro hz
    obtain ⟨m, n, hmn⟩ := PeriodPair.mem_lattice.mp hz
    rw [PeriodPair.mem_lattice]
    refine ⟨n, -m, ?_⟩
    simp only [scalePeriodPair_ω₁, scalePeriodPair_ω₂, coe_complexIUnit,
      squarePeriodPair]
    simp only [squarePeriodPair] at hmn
    push_cast at hmn ⊢
    rw [Complex.I_mul_I]
    linear_combination hmn

theorem scaleI_square_G_six :
    (scalePeriodPair complexIUnit squarePeriodPair).G 6 = squarePeriodPair.G 6 := by
  rw [PeriodPair.G, PeriodPair.G, scaleI_square_lattice]

theorem complexI_inv_pow_six : (Complex.I : ℂ)⁻¹ ^ 6 = -1 := by
  rw [Complex.inv_I]
  rw [show (-Complex.I : ℂ) ^ 6 = Complex.I ^ 6 by ring]
  rw [show (Complex.I : ℂ) ^ 6 = (Complex.I ^ 2) ^ 3 by ring]
  rw [Complex.I_sq]
  norm_num

theorem scaleI_square_g₃ :
    (scalePeriodPair complexIUnit squarePeriodPair).g₃ = squarePeriodPair.g₃ := by
  rw [PeriodPair.g₃, PeriodPair.g₃, scaleI_square_G_six]

/-- Quarter-turn symmetry forces the square lattice's weight-six invariant to vanish. -/
theorem squarePeriodPair_g₃_zero : squarePeriodPair.g₃ = 0 := by
  have hscale := scalePeriodPair_g₃ complexIUnit squarePeriodPair
  rw [scaleI_square_g₃] at hscale
  simp only [coe_complexIUnit, complexI_inv_pow_six, neg_one_mul] at hscale
  have htwo : (2 : ℂ) * squarePeriodPair.g₃ = 0 := by
    linear_combination hscale
  exact (mul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- Paper equation (75) also has `g₃ = 0` at the lemniscatic modulus `m = 1/2`. -/
theorem brizard_half_modulus_g₃_zero (q₀ : ℝˣ) :
    g₃ { modulus := (1 / 2 : ℝ), q₀ := q₀ } = 0 := by
  rw [g₃]
  ring

/-- The pole-free square-lattice trace satisfies the lemniscatic cubic differential equation. -/
theorem squareHalfShift_equation (x : ℝ) :
    halfShiftWeierstrassPrime squarePeriodPair x ^ 2 =
      4 * halfShiftWeierstrass squarePeriodPair x ^ 3 -
        squarePeriodPair.g₂ * halfShiftWeierstrass squarePeriodPair x := by
  have h := halfShiftWeierstrass_equation squarePeriodPair x
  rw [squarePeriodPair_g₃_zero] at h
  simpa only [squarePeriodPair, one_pow, one_mul, sub_zero] using h

theorem squareAnalyticCurve_a₆ : (analyticWeierstrassCurve squarePeriodPair).a₆ = 0 := by
  rw [analyticWeierstrassCurve]
  change -squarePeriodPair.g₃ / 4 = 0
  rw [squarePeriodPair_g₃_zero]
  norm_num

theorem brizardHalfCurve_a₆ (q₀ : ℝˣ) :
    (weierstrassCurve { modulus := (1 / 2 : ℝ), q₀ := q₀ }).a₆ = 0 := by
  rw [weierstrassCurve]
  change -g₃ { modulus := (1 / 2 : ℝ), q₀ := q₀ } / 4 = 0
  rw [brizard_half_modulus_g₃_zero]
  norm_num

/-- Without yet using nonvanishing of `g₂`, the square lattice's `j` is exactly `0` or `1728`. -/
theorem squarePeriodPair_periodJ_cases :
    periodJ squarePeriodPair = 0 ∨ periodJ squarePeriodPair = 1728 := by
  rw [periodJ, squarePeriodPair_g₃_zero]
  by_cases h₂ : squarePeriodPair.g₂ = 0
  · left
    simp [h₂]
  · right
    field_simp [h₂]
    ring

end GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElastica
