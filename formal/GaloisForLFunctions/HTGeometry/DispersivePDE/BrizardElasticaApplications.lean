/-!
# Closed application atlas for arXiv:2607.21750

One assumption-free certificate gathers every mechanically transferred theorem from Brizard's
elastica-NLS paper: analytic NLS solutions, curvature/torsion conservation, Jacobi parameter
transport, cubic first integrals, and the resulting Weierstrass curve.
-/

namespace GaloisForLFunctions.HTGeometry.DispersivePDE.BrizardElastica

/-- Assumption-free atlas of the paper's applications in the local Lean corpus. -/
structure ClosedAtlas : Prop where
  planeWaveSolution : ∀ D a k : ℝ, SolvesNLS D (planeWaveJet D a k)
  envelopeSolitonSolution : ∀ D k v : ℝ, SolvesNLS D (envelopeSolitonJet D k v)
  opticalSolitonSolution : ∀ D k : ℝ, SolvesNLS D (envelopeSolitonJet D k 0)
  hasimotoSolitonSolution : ∀ D τ₀ : ℝ, SolvesNLS D (envelopeSolitonJet D τ₀ τ₀)
  corpusBrightNormalization :
    opticalSoliton 1 1 = fun t x => 2 * nlsBrightSoliton t x
  jacobiSnDerivative : ∀ x : ℝ,
    HasDerivAt jacobiSnOne (jacobiCnOne x * jacobiDnOne x) x
  jacobiCnDerivative : ∀ x : ℝ,
    HasDerivAt jacobiCnOne (-(jacobiSnOne x * jacobiDnOne x)) x
  jacobiDnDerivative : ∀ x : ℝ,
    HasDerivAt jacobiDnOne (jacobiDnOne1 x) x
  jacobiLameEquation : ∀ x : ℝ,
    HasDerivAt jacobiDnOne1
      ((2 * jacobiSnOne x ^ 2 - 1) * jacobiDnOne x) x
  jacobiQuadratic₁ : ∀ x : ℝ,
    jacobiSnOne x ^ 2 + jacobiCnOne x ^ 2 = 1
  jacobiQuadratic₂ : ∀ x : ℝ,
    jacobiDnOne x ^ 2 + jacobiSnOne x ^ 2 = 1
  jacobiFirstIntegral : ∀ x : ℝ,
    (jacobiCnOne x * jacobiDnOne x) ^ 2 =
      (1 - jacobiSnOne x ^ 2) * (1 - jacobiSnOne x ^ 2)
  jacobiInitialData :
    jacobiSnOne 0 = 0 ∧ jacobiCnOne 0 = 1 ∧ jacobiDnOne 0 = 1
  jacobiSubstitutionResidual : ∀ a q₀ γ ν X Y : ℝ,
    (-2 * a * X * Y) ^ 2 -
        dimensionlessCurvatureRHS q₀ γ ν (q₀ - a * X ^ 2) =
      4 * a * X ^ 2 * clearedJacobiResidual a q₀ (γ ^ 2) (ν ^ 2) X Y
  jacobiSnQuartic : ∀ m X : ℝ,
    m * X ^ 4 - (1 + m) * X ^ 2 + 1 =
      (1 - X ^ 2) * (1 - m * X ^ 2)
  jacobiScQuartic : ∀ m X : ℝ,
    (1 - m) * X ^ 4 + (2 - m) * X ^ 2 + 1 =
      (1 + X ^ 2) * (1 + (1 - m) * X ^ 2)
  jacobiSdQuartic : ∀ m X : ℝ,
    -m * (1 - m) * X ^ 4 + (2 * m - 1) * X ^ 2 + 1 =
      (1 - (1 - m) * X ^ 2) * (1 + m * X ^ 2)
  parameterJacobiQuartic : ∀ (P : Parameters) (X Y : ℝ),
    clearedJacobiResidual P.modulus (P.q₀ : ℝ) (gammaSq P) (nuSq P) X Y =
      P.modulus * (Y ^ 2 - (1 - X ^ 2) * (1 - P.modulus * X ^ 2))
  parameterJacobiInitial : ∀ P : Parameters,
    clearedJacobiResidual P.modulus (P.q₀ : ℝ) (gammaSq P) (nuSq P) 0 1 = 0
  parameterJacobiNonzero : ∀ (P : NonzeroModulusParameters) (X Y : ℝ),
    clearedJacobiResidual P.val.modulus (P.val.q₀ : ℝ)
        (gammaSq P.val) (nuSq P.val) X Y = 0 ↔
      Y ^ 2 = (1 - X ^ 2) * (1 - P.val.modulus * X ^ 2)
  parameterJacobiZeroCollapse : ∀ (q₀ : ℝˣ) (X Y : ℝ),
    clearedJacobiResidual 0 (q₀ : ℝ)
        (gammaSq { modulus := 0, q₀ := q₀ })
        (nuSq { modulus := 0, q₀ := q₀ }) X Y = 0
  degenerateJacobiCurvature : ∀ k₀ s : ℝ,
    degenerateJacobiCurvatureSq k₀ s =
      (k₀ * jacobiDnOne (k₀ * s / 2)) ^ 2
  opticalEnvelopeJacobiBoundary : ∀ D k t x : ℝ,
    envelope D k 0 t x = 2 * k * jacobiDnOne (k * x)
  opticalDensityIsElasticaCurvature : ∀ D k t x : ℝ,
    ‖opticalSoliton D k t x‖ ^ 2 = degenerateJacobiCurvatureSq (2 * k) x
  scaledBrightSolution : ∀ a : ℝ,
    SolvesFocusingNLS (nlsScaleJet a nlsBrightSolitonJet)
  scaledPlaneSolution : ∀ a : ℝ,
    SolvesFocusingNLS (nlsScaleJet a nlsPlaneWaveJet)
  scaledDarkSolution : ∀ a : ℝ,
    SolvesDefocusingNLS (nlsScaleJet a nlsDarkSolitonJet)
  scaledBrizardPlaneSolution : ∀ a D b k : ℝ,
    SolvesNLS D (nlsScaleJet a (planeWaveJet D b k))
  scaledEnvelopeSolution : ∀ a D k v : ℝ,
    SolvesNLS D (nlsScaleJet a (envelopeSolitonJet D k v))
  focusingScalingClosure : ∀ (a : ℝ) (S : FocusingSolutionJet),
    SolvesFocusingNLS (scaleFocusingSolution a S).val
  defocusingScalingClosure : ∀ (a : ℝ) (S : DefocusingSolutionJet),
    SolvesDefocusingNLS (scaleDefocusingSolution a S).val
  brizardScalingClosure : ∀ (D a : ℝ) (S : BrizardSolutionJet D),
    SolvesNLS D (scaleBrizardSolution D a S).val
  scalingIdentity : ∀ (J : ComplexEvolutionJet2) (t x : ℝ),
    (nlsScaleJet 1 J).u t x = J.u t x
  scalingZero : ∀ (J : ComplexEvolutionJet2) (t x : ℝ),
    (nlsScaleJet 0 J).u t x = 0
  scalingComposition : ∀ (a b : ℝ) (J : ComplexEvolutionJet2) (t x : ℝ),
    (nlsScaleJet a (nlsScaleJet b J)).u t x =
      (nlsScaleJet (a * b) J).u t x
  scaledDensity : ∀ (a : ℝ) (J : ComplexEvolutionJet2) (t x : ℝ),
    ‖(nlsScaleJet a J).u t x‖ ^ 2 =
      a ^ 2 * ‖J.u (a ^ 2 * t) (a * x)‖ ^ 2
  scalingJetIdentity : ∀ J : ComplexEvolutionJet2, nlsScaleJet 1 J = J
  scalingJetComposition : ∀ (a b : ℝ) (J : ComplexEvolutionJet2),
    nlsScaleJet a (nlsScaleJet b J) = nlsScaleJet (a * b) J
  scalingJetZero : ∀ J : ComplexEvolutionJet2,
    nlsScaleJet 0 J = zeroComplexEvolutionJet2
  scalingSolutionComposition : ∀ (D a b : ℝ) (S : BrizardSolutionJet D),
    scaleBrizardSolution D a (scaleBrizardSolution D b S) =
      scaleBrizardSolution D (a * b) S
  scalingSolutionZero : ∀ (D : ℝ) (S : BrizardSolutionJet D),
    scaleBrizardSolution D 0 S = zeroBrizardSolution D
  printedScalingDensity : ∀ (a : ℝˣ) (J : ComplexEvolutionJet2) (t x : ℝ),
    ‖(printedInverseScaleJet a J).u t x‖ ^ 2 =
      ((a : ℝ)⁻¹) ^ 2 * ‖J.u ((a : ℝ) ^ 2 * t) ((a : ℝ) * x)‖ ^ 2
  printedScalingResidual : ∀ (a : ℝˣ) (S : FocusingSolutionJet) (t x : ℝ),
    focusingResidual (printedInverseScaleJet a S) t x =
      2 * ((((a : ℝ) : ℂ)⁻¹ ^ 3 - ((a : ℝ) : ℂ))) *
        (‖S.val.u ((a : ℝ) ^ 2 * t) ((a : ℝ) * x)‖ ^ 2 : ℂ) *
          S.val.u ((a : ℝ) ^ 2 * t) ((a : ℝ) * x)
  printedScalingCounterexample :
    ¬ SolvesFocusingNLS (printedInverseScaleJet realTwoUnit nlsPlaneWaveJet)
  galileanNorm : ∀ (D v : ℝ) (u : ℝ → ℝ → ℂ) (t x : ℝ),
    ‖galileanField D v u t x‖ = ‖u t (x - 2 * D * v * t)‖
  galileanIdentity : ∀ (D : ℝ) (u : ℝ → ℝ → ℂ) (t x : ℝ),
    galileanField D 0 u t x = u t x
  galileanComposition : ∀ (D v w : ℝ) (u : ℝ → ℝ → ℂ) (t x : ℝ),
    galileanField D v (galileanField D w u) t x =
      galileanField D (v + w) u t x
  galileanPlaneWave : ∀ D a k v t x : ℝ,
    galileanField D v (planeWave D a k) t x = planeWave D a (k + v) t x
  galileanEnvelope : ∀ D k v w t x : ℝ,
    galileanField D v (envelopeSoliton D k w) t x =
      envelopeSoliton D k (v + w) t x
  galileanOptical : ∀ D k v t x : ℝ,
    galileanField D v (opticalSoliton D k) t x = envelopeSoliton D k v t x
  galileanJetDensity : ∀ (D v : ℝ) (J : TransportCompatibleJet2) (t x : ℝ),
    ‖(galileanJet D v J).u t x‖ ^ 2 = ‖J.u t (x - 2 * D * v * t)‖ ^ 2
  galileanSolutionClosure : ∀ (D v : ℝ)
      (S : TransportCompatibleBrizardSolution D),
    SolvesNLS D (galileanBrizardSolution D v S).val
  galileanCertifiedField : ∀ (D v : ℝ)
      (S : TransportCompatibleBrizardSolution D) (t x : ℝ),
    (galileanBrizardSolution D v S).val.u t x = galileanField D v S.val.u t x
  galileanCompatibleClosure : ∀ (D v : ℝ)
      (S : TransportCompatibleBrizardSolution D),
    SolvesNLS D (galileanCompatibleBrizardSolution D v S).val.toComplexEvolutionJet2
  galileanCompatibleComposition : ∀ (D v w : ℝ)
      (S : TransportCompatibleBrizardSolution D) (t x : ℝ),
    (galileanCompatibleBrizardSolution D v
        (galileanCompatibleBrizardSolution D w S)).val.u t x =
      (galileanCompatibleBrizardSolution D (v + w) S).val.u t x
  galileanPlaneCompatible : ∀ D a k : ℝ,
    SolvesNLS D (planeWaveCompatibleSolution D a k).val.toComplexEvolutionJet2
  galileanPlaneCertifiedOrbit : ∀ D a k v t x : ℝ,
    (galileanCompatibleBrizardSolution D v
        (planeWaveCompatibleSolution D a k)).val.u t x =
      planeWave D a (k + v) t x
  galileanSolitonCompatible : ∀ D k v : ℝ,
    SolvesNLS D (envelopeSolitonCompatibleSolution D k v).val.toComplexEvolutionJet2
  galileanSolitonCertifiedOrbit : ∀ D k v w t x : ℝ,
    (galileanCompatibleBrizardSolution D w
        (envelopeSolitonCompatibleSolution D k v)).val.u t x =
      envelopeSoliton D k (w + v) t x
  galileanOpticalCertifiedOrbit : ∀ D k v t x : ℝ,
    (galileanCompatibleBrizardSolution D v
        (envelopeSolitonCompatibleSolution D k 0)).val.u t x =
      envelopeSoliton D k v t x
  breatherEndpointSolution : SolvesFocusingNLS breatherLatticeEndpoint
  breatherEndpointIdentification : ∀ t x : ℝ,
    breatherLatticeEndpoint.u t x =
      (Real.sqrt 2 : ℂ) * nlsBrightSoliton (2 * t) (Real.sqrt 2 * x)
  sechCurvatureDensity : ∀ x : ℝ, sechDensity x = solitonQ x
  sechMassCurrentLaw : ∀ D x : ℝ, sechMassCurrent D x = 2 * D
  sechMomentumCurrentLaw : ∀ D x : ℝ,
    sechMomentumCurrent D x = sechQuantumStress D x
  sechMassCurrentDerivative : ∀ D x : ℝ,
    HasDerivAt (sechMassCurrent D) 0 x
  sechQuantumStressDerivative : ∀ D x : ℝ,
    HasDerivAt (sechQuantumStress D) (sechMomentumDerivative D x) x
  sechMomentumCurrentDerivative : ∀ D x : ℝ,
    HasDerivAt (sechMomentumCurrent D) (sechMomentumDerivative D x) x
  sechContinuity : ∀ D t x : ℝ,
    (0 : ℝ) + 0 = 0 ∧
      HasDerivAt (fun _ : ℝ => sechDensity x) 0 t ∧
      HasDerivAt (sechMassCurrent D) 0 x
  sechMomentumBalance : ∀ D t x : ℝ,
    (0 : ℝ) + sechMomentumDerivative D x = sechMomentumDerivative D x ∧
      HasDerivAt (fun _ : ℝ => sechMassCurrent D x) 0 t ∧
      HasDerivAt (sechMomentumCurrent D) (sechMomentumDerivative D x) x ∧
      HasDerivAt (sechQuantumStress D) (sechMomentumDerivative D x) x
  sechBohmPotential : ∀ x : ℝ, sechBohmTerm x = 1 - 2 * solitonQ x
  sechHydrodynamicPotential : ∀ x : ℝ,
    sechDensity x + 2 * sechBohmTerm x = 2 - 3 * solitonQ x
  travelingDensityTimeDerivative : ∀ (K : CurvatureProfileJet) (c t s : ℝ),
    HasDerivAt (fun r : ℝ => travelingDensity K c r s)
      (travelingDensityT K c t s) t
  travelingDensitySpaceDerivative : ∀ (K : CurvatureProfileJet) (c t s : ℝ),
    HasDerivAt (travelingDensity K c t) (travelingDensityX K c t s) s
  travelingMassCurrentLaw : ∀ (D k₀ τ₀ c : ℝ)
      (K : CurvatureProfileJet) (t s : ℝ),
    travelingMassCurrent D k₀ τ₀ c K t s =
      c * travelingDensity K c t s + 2 * D * k₀ ^ 2 * τ₀
  travelingContinuity : ∀ (D k₀ τ₀ c : ℝ)
      (K : CurvatureProfileJet) (t s : ℝ),
    travelingDensityT K c t s + c * travelingDensityX K c t s = 0 ∧
      HasDerivAt (fun r : ℝ => travelingDensity K c r s)
        (travelingDensityT K c t s) t ∧
      HasDerivAt (travelingMassCurrent D k₀ τ₀ c K t)
        (c * travelingDensityX K c t s) s
  unboostedContinuityDefect : ∀ (K : CurvatureProfileJet) (c t s : ℝ),
    travelingDensityT K c t s + 0 = -c * travelingDensityX K c t s
  halfShiftAvoidsPoles : ∀ (L : PeriodPair) (x : ℝ),
    halfShiftArgument L x ∉ L.lattice
  halfShiftDerivative : ∀ (L : PeriodPair) (x : ℝ),
    HasDerivAt (halfShiftWeierstrass L) (halfShiftWeierstrassPrime L x) x
  halfShiftSecondDerivative : ∀ (L : PeriodPair) (x : ℝ),
    HasDerivAt (halfShiftWeierstrassPrime L) (halfShiftWeierstrassSecond L x) x
  halfShiftDifferentiatedCubic : ∀ (L : PeriodPair) (x : ℝ),
    2 * halfShiftWeierstrassPrime L x * halfShiftWeierstrassSecond L x =
      L.ω₁ ^ 2 * ((12 * halfShiftWeierstrass L x ^ 2 - L.g₂) *
        halfShiftWeierstrassPrime L x)
  halfShiftCubic : ∀ (L : PeriodPair) (x : ℝ),
    halfShiftWeierstrassPrime L x ^ 2 =
      L.ω₁ ^ 2 *
        (4 * halfShiftWeierstrass L x ^ 3 -
          L.g₂ * halfShiftWeierstrass L x - L.g₃)
  halfShiftPeriodicity : ∀ L : PeriodPair,
    Function.Periodic (halfShiftWeierstrass L) 1
  halfShiftCurvePoint : ∀ (L : PeriodPair) (x : ℝ),
    (analyticWeierstrassCurve L).toAffine.Equation
      (halfShiftWeierstrass L x)
      (halfShiftWeierstrassPrime L x / (2 * L.ω₁))
  normalizedFirstPeriod : ∀ L : PeriodPair, (normalizedPeriodPair L).ω₁ = 1
  normalizedTraceDerivative : ∀ (L : PeriodPair) (x : ℝ),
    HasDerivAt (normalizedWeierstrass L) (normalizedWeierstrassPrime L x) x
  normalizedTraceCubic : ∀ (L : PeriodPair) (x : ℝ),
    normalizedWeierstrassPrime L x ^ 2 =
      4 * normalizedWeierstrass L x ^ 3 -
        (normalizedPeriodPair L).g₂ * normalizedWeierstrass L x -
        (normalizedPeriodPair L).g₃
  normalizedTracePeriodicity : ∀ L : PeriodPair,
    Function.Periodic (normalizedWeierstrass L) 1
  normalizedTraceCurvePoint : ∀ (L : PeriodPair) (x : ℝ),
    (analyticWeierstrassCurve (normalizedPeriodPair L)).toAffine.Equation
      (normalizedWeierstrass L x) (normalizedWeierstrassPrime L x / 2)
  scaledEisensteinFour : ∀ (c : ℂˣ) (L : PeriodPair),
    (scalePeriodPair c L).G 4 = (c : ℂ)⁻¹ ^ 4 * L.G 4
  scaledEisensteinSix : ∀ (c : ℂˣ) (L : PeriodPair),
    (scalePeriodPair c L).G 6 = (c : ℂ)⁻¹ ^ 6 * L.G 6
  scaledInvariant₂ : ∀ (c : ℂˣ) (L : PeriodPair),
    (scalePeriodPair c L).g₂ = (c : ℂ)⁻¹ ^ 4 * L.g₂
  scaledInvariant₃ : ∀ (c : ℂˣ) (L : PeriodPair),
    (scalePeriodPair c L).g₃ = (c : ℂ)⁻¹ ^ 6 * L.g₃
  scaledWeierstrass : ∀ (c : ℂˣ) (L : PeriodPair) (z : ℂ),
