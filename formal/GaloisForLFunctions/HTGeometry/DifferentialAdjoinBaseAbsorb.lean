import GaloisForLFunctions.HTGeometry.DifferentialAdjoinCommute

/-!
# Absorbing a derivation-closed base into a differential adjunction

Adjoining a set of differential generators over a derivation-closed intermediate field fills out the
same subfield of the ambient field as adjoining that field together with the generators over the
smaller base.  The statement is an equality of carriers, which is the form the coefficient transfer
of `AlgebraicIndependentRangeTransfer` consumes.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Jets of a derivation-closed intermediate field stay inside it. -/
theorem differentialJetSet_subset_of_derivationClosed {k K : Type*} [Field k] [Field K]
    [Algebra k K] [Differential K] {K₀ : IntermediateField k K} (hK₀ : DerivationClosed K₀) :
    differentialJetSet (K₀ : Set K) ⊆ (K₀ : Set K) := by
  rintro y ⟨x, hx, n, rfl⟩
  induction n with
  | zero => simpa using hx
  | succ n ih =>
      rw [differentialJet_succ]
      exact hK₀ ih

/-- **Base absorption.**  Adjoining `B` over a derivation-closed intermediate field `K₀` fills out
the differential field generated by `K₀ ∪ B` over the smaller base. -/
theorem coe_differentialAdjoin_base {k K : Type*} [Field k] [Field K] [Algebra k K]
    [Differential K] {K₀ : IntermediateField k K} (hK₀ : DerivationClosed K₀) (B : Set K) :
    (differentialAdjoin (↥K₀) B : Set K)
      = (differentialAdjoin k ((K₀ : Set K) ∪ B) : Set K) := by
  have hjet : differentialJetSet ((K₀ : Set K) ∪ B)
      = differentialJetSet (K₀ : Set K) ∪ differentialJetSet B :=
    differentialJetSet_union _ _
  have hK₀jet : differentialJetSet (K₀ : Set K) ⊆ (K₀ : Set K) :=
    differentialJetSet_subset_of_derivationClosed hK₀
  have hBsub : differentialJetSet B ⊆ (differentialAdjoin k ((K₀ : Set K) ∪ B) : Set K) := by
    intro y hy
    exact IntermediateField.subset_adjoin k _ (by rw [hjet]; exact Or.inr hy)
  have hDE : K₀ ≤ differentialAdjoin k ((K₀ : Set K) ∪ B) := by
    intro y hy
    exact IntermediateField.subset_adjoin k _ (by rw [hjet]; exact Or.inl ⟨y, hy, 0, by simp⟩)
  refine Set.Subset.antisymm ?_ ?_
  · have h1 : differentialAdjoin (↥K₀) B ≤ IntermediateField.extendScalars hDE := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [IntermediateField.coe_extendScalars]
      exact hBsub hy
    have h2 := SetLike.coe_subset_coe.mpr h1
    rwa [IntermediateField.coe_extendScalars] at h2
  · have h1 : differentialAdjoin k ((K₀ : Set K) ∪ B)
        ≤ IntermediateField.restrictScalars k (differentialAdjoin (↥K₀) B) := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro y hy
      rw [IntermediateField.coe_restrictScalars]
      rw [hjet] at hy
      rcases hy with hy | hy
      · exact (differentialAdjoin (↥K₀) B).algebraMap_mem (⟨y, hK₀jet hy⟩ : ↥K₀)
      · exact IntermediateField.subset_adjoin (↥K₀) _ hy
    have h2 := SetLike.coe_subset_coe.mpr h1
    rwa [IntermediateField.coe_restrictScalars] at h2

/-- Differential independence over a derivation-closed base and its generators, in the two
presentations of the same field. -/
theorem differentialIndependent_differentialAdjoin_base {k K ι : Type*} [Field k] [Field K]
    [Algebra k K] [Differential K] {K₀ : IntermediateField k K} (hK₀ : DerivationClosed K₀)
    (B : Set K) {x : ι → K}
    (hx : DifferentialIndependent ↥(differentialAdjoin (↥K₀) B) x) :
    DifferentialIndependent ↥(differentialAdjoin k ((K₀ : Set K) ∪ B)) x :=
  differentialIndependent_of_coe_eq (by
    rw [← coe_differentialAdjoin_base hK₀ B]) hx

/-- The converse presentation. -/
theorem differentialIndependent_differentialAdjoin_base' {k K ι : Type*} [Field k] [Field K]
    [Algebra k K] [Differential K] {K₀ : IntermediateField k K} (hK₀ : DerivationClosed K₀)
    (B : Set K) {x : ι → K}
    (hx : DifferentialIndependent ↥(differentialAdjoin k ((K₀ : Set K) ∪ B)) x) :
    DifferentialIndependent ↥(differentialAdjoin (↥K₀) B) x :=
  differentialIndependent_of_coe_eq (coe_differentialAdjoin_base hK₀ B).symm hx

end

end GaloisForLFunctions.HTGeometry
