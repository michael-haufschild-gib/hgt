import GaloisForLFunctions.HTGeometry.TorusUnimodular
import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape
import GaloisForLFunctions.HTGeometry.RadicalTowerDegree

/-!
# The diagonal case of a torus substitution

A diagonal integer matrix substitutes each coordinate by a power of itself.  Adjoining the whole
palette to the differential field generated by those powers gives a field already closed under the
derivation: the logarithmic derivative of a power is a multiple of the logarithmic derivative, so
each coordinate derivative is a quotient of elements of the adjunction.

Hence a diagonal torus substitution presents the ambient field as a single algebraic adjunction of
the palette over the substituted field, radical in each coordinate.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {r : ℕ} {x : Fin r → E}

omit [Differential C] [Differential E] [DifferentialAlgebra C E] [CharZero E] in
/-- A diagonal substitution raises each coordinate to its own exponent. -/
theorem monomialFamily_diagonal_apply (d : Fin r → ℤ) (i : Fin r) :
    monomialFamily (Matrix.diagonal d) x i = x i ^ d i := by
  classical
  rw [monomialFamily_apply, Finset.prod_eq_single i]
  · rw [Matrix.diagonal_apply_eq]
  · intro j _ hji
    rw [Matrix.diagonal_apply_ne _ (Ne.symm hji), zpow_zero]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

variable (hx : DifferentialIndependent C x)

include hx in
/-- **The diagonal adjunction is derivation closed.**  Adjoining the palette to the differential
field of its coordinatewise powers gives a derivation-closed field. -/
theorem derivationClosed_adjoin_of_diagonal {d : Fin r → ℤ} (hd : ∀ i, d i ≠ 0) :
    DerivationClosed (IntermediateField.adjoin
      (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x))))
      (Set.range x)) := by
  classical
  have hx0 : ∀ i, x i ≠ 0 := torus_palette_ne_zero hx
  set B : IntermediateField C E :=
    differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) with hB
  letI : Differential ↥B :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C _)
  letI : DifferentialAlgebra ↥B E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C
        (Set.range (monomialFamily (Matrix.diagonal d) x))) c⟩
  refine derivationClosed_adjoin_range_of_deriv_mem x fun i ↦ ?_
  have hpowmem : x i ^ d i ∈ B := by
    rw [hB, ← monomialFamily_diagonal_apply d i]
    exact subset_differentialAdjoin C _ (Set.mem_range_self i)
  have hderivmem : Differential.deriv (x i ^ d i) ∈ B :=
    derivationClosed_differentialAdjoin C _ hpowmem
  have hpow0 : x i ^ d i ≠ 0 := zpow_ne_zero _ (hx0 i)
  have hdcast : (d i : E) ≠ 0 := Int.cast_ne_zero.mpr (hd i)
  have hxi : x i ≠ 0 := hx0 i
  have hsolve : Differential.deriv (x i)
      = x i * (Differential.deriv (x i ^ d i) * ((d i : E) * x i ^ d i)⁻¹) := by
    have hlog := logDeriv_zpow (x i) hxi (d i)
    rw [Differential.logDeriv, Differential.logDeriv] at hlog
    field_simp at hlog
    field_simp
    linear_combination -hlog
  rw [hsolve]
  refine mul_mem ?_ (mul_mem ?_ ?_)
  · exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
  · exact IntermediateField.algebraMap_mem _ (⟨_, hderivmem⟩ : ↥B)
  · refine inv_mem (mul_mem ?_ ?_)
    · exact IntermediateField.algebraMap_mem _ ((d i : ↥B))
    · exact IntermediateField.algebraMap_mem _ (⟨_, hpowmem⟩ : ↥B)

include hx in
/-- **The palette generates the ambient field over the diagonal substitution.**  The differential
field of the palette is contained in the single algebraic adjunction. -/
theorem differentialAdjoin_le_adjoin_diagonal {d : Fin r → ℤ} (hd : ∀ i, d i ≠ 0) :
    differentialAdjoin C (Set.range x) ≤
      (IntermediateField.adjoin
        (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x))))
        (Set.range x)).restrictScalars C := by
  rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
  rintro z ⟨w, ⟨i, rfl⟩, n, rfl⟩
  show differentialJet n (x i) ∈ IntermediateField.adjoin
    (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)))) (Set.range x)
  induction n with
  | zero =>
      simpa using IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
  | succ n ih =>
      rw [differentialJet_succ]
      exact derivationClosed_adjoin_of_diagonal hx hd ih

include hx in
/-- **The diagonal presentation.**  For a generating palette the ambient field is the algebraic
adjunction of the palette to the differential field of its coordinatewise powers. -/
theorem adjoin_diagonal_eq_top (hgen : differentialAdjoin C (Set.range x) = ⊤)
    {d : Fin r → ℤ} (hd : ∀ i, d i ≠ 0) :
    IntermediateField.adjoin
      (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x))))
      (Set.range x) = ⊤ := by
  set B : IntermediateField C E :=
    differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) with hB
  have hle := differentialAdjoin_le_adjoin_diagonal hx hd
  rw [hgen] at hle
  have hres : (IntermediateField.adjoin (↥B) (Set.range x)).restrictScalars C = ⊤ :=
    top_le_iff.mp hle
  have htop : (⊤ : IntermediateField (↥B) E).restrictScalars C = ⊤ :=
    IntermediateField.restrictScalars_top
  exact IntermediateField.restrictScalars_injective C (hres.trans htop.symm)


include hx in
/-- **The degree of a diagonal torus substitution.**  The ambient field has degree at most the
product of the absolute exponents over the differential field of the coordinatewise powers. -/
theorem finrank_diagonal_le_prod (hgen : differentialAdjoin C (Set.range x) = ⊤)
    {d : Fin r → ℤ} (hd : ∀ i, d i ≠ 0) :
    Module.finrank
        (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)))) E
      ≤ ∏ i, (d i).natAbs := by
  classical
  set B : IntermediateField C E :=
    differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) with hB
  have hpowmem : ∀ i, x i ^ d i ∈ B := by
    intro i
    rw [hB, ← monomialFamily_diagonal_apply d i]
    exact subset_differentialAdjoin C _ (Set.mem_range_self i)
  have hx0 : ∀ i, x i ≠ 0 := torus_palette_ne_zero hx
  have hnat : ∀ i, ∃ c : ↥B, x i ^ (d i).natAbs = algebraMap (↥B) E c := by
    intro i
    have hz : x i ^ ((d i).natAbs : ℤ) ∈ B := by
      rcases le_or_gt 0 (d i) with hpos | hneg
      · rw [show (((d i).natAbs : ℕ) : ℤ) = d i by omega]
        exact hpowmem i
      · rw [show (((d i).natAbs : ℕ) : ℤ) = -d i by omega, zpow_neg]
        exact inv_mem (hpowmem i)
    rw [zpow_natCast] at hz
    exact ⟨⟨x i ^ (d i).natAbs, hz⟩, rfl⟩
  have hrange : Set.range x = x '' ((Finset.univ : Finset (Fin r)) : Set (Fin r)) := by
    simp
  have hbound := finrank_adjoin_image_le_prod (F := ↥B) (L := E) x
    (fun i ↦ (d i).natAbs) (fun i ↦ Int.natAbs_pos.mpr (hd i)) hnat Finset.univ
  rw [← hrange, adjoin_diagonal_eq_top hx hgen hd] at hbound
  rwa [IntermediateField.finrank_top'] at hbound


include hx in
/-- **The diagonal substitution has finite degree.**  Each palette coordinate is integral over the
differential field of the coordinatewise powers, and together they generate the ambient field. -/
theorem finiteDimensional_diagonal (hgen : differentialAdjoin C (Set.range x) = ⊤)
    {d : Fin r → ℤ} (hd : ∀ i, d i ≠ 0) :
    FiniteDimensional
      (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)))) E := by
  classical
  have hpowmem : ∀ i, x i ^ d i
      ∈ differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) := by
    intro i
    rw [← monomialFamily_diagonal_apply d i]
    exact subset_differentialAdjoin C _ (Set.mem_range_self i)
  have hint : ∀ z ∈ Set.range x, IsIntegral
      (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)))) z := by
    rintro _ ⟨i, rfl⟩
    have hz : x i ^ ((d i).natAbs)
        ∈ differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) := by
      have hzz : x i ^ (((d i).natAbs : ℕ) : ℤ)
          ∈ differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)) := by
        rcases le_or_gt 0 (d i) with hpos | hneg
        · rw [show ((((d i).natAbs : ℕ)) : ℤ) = d i by omega]
          exact hpowmem i
        · rw [show ((((d i).natAbs : ℕ)) : ℤ) = -(d i) by omega, zpow_neg]
          exact inv_mem (hpowmem i)
      rwa [zpow_natCast] at hzz
    exact isIntegral_of_pow_mem (α := x i)
      (c := (⟨x i ^ ((d i).natAbs), hz⟩ :
        ↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x)))))
      (Int.natAbs_pos.mpr (hd i)) rfl
  haveI : Finite (Set.range x) := Set.finite_range x
  haveI hfd0 : FiniteDimensional
      (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x))))
      ↥(IntermediateField.adjoin
        (↥(differentialAdjoin C (Set.range (monomialFamily (Matrix.diagonal d) x))))
        (Set.range x)) := IntermediateField.finiteDimensional_adjoin hint
  rw [adjoin_diagonal_eq_top hx hgen hd] at hfd0
  exact (IntermediateField.topEquiv.toLinearEquiv).finiteDimensional

end

end

end GaloisForLFunctions.HTGeometry
