import Mathlib
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Resolvent traces are differentially generated by the second trace

For a positive spectrum `(E n)` with multiplicities `(ρ n)`, the one-loop cutoff action

```text
W_s(x) = (1/2) ∑_{n ∈ s} ρ n · log (x + E n)
```

has `r`-th derivative `(1/2)(-1)^{r-1}(r-1)! Q_{s,r}(x)` with
`Q_{s,r}(x) = ∑_{n ∈ s} ρ n / (x + E n)^r`.  The vertex hierarchy is therefore the derivative chain
of the second trace: `Q_{r+1} = -(Q_r)'/r`.  The same recursion holds for the infinite spectrum on
any open connected set carrying a summable majorant, by termwise differentiation.

Consequently, in any differential field, a family obeying that recursion from index two upwards
lies in the differential field generated by its second member: the whole homogeneous mass-source
vertex hierarchy has zero relative differential rank over the second resolvent trace.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

noncomputable section

/-! ## One resolvent term -/

theorem hasDerivAt_resolventTerm (ρ c : ℝ) (m : ℕ) {x : ℝ} (hx : x + c ≠ 0) :
    HasDerivAt (fun y : ℝ => ρ / (y + c) ^ (m + 1))
      (-((m : ℝ) + 1) * ρ / (x + c) ^ (m + 2)) x := by
  have h1 : HasDerivAt (fun y : ℝ => y + c) 1 x := (hasDerivAt_id x).add_const c
  have hg : HasDerivAt (fun y : ℝ => (y + c) ^ (m + 1)) (((m : ℝ) + 1) * (x + c) ^ m) x := by
    refine (h1.fun_pow (m + 1)).congr_deriv ?_
    push_cast
    ring
  have hc : HasDerivAt (fun _ : ℝ => ρ) 0 x := hasDerivAt_const x ρ
  refine (hc.fun_div hg (pow_ne_zero _ hx)).congr_deriv ?_
  field_simp
  ring

theorem hasDerivAt_logTerm (ρ c : ℝ) {x : ℝ} (hx : 0 < x + c) :
    HasDerivAt (fun y : ℝ => ρ * Real.log (y + c)) (ρ / (x + c) ^ 1) x := by
  have h1 : HasDerivAt (fun y : ℝ => y + c) 1 x := (hasDerivAt_id x).add_const c
  have hlog : HasDerivAt (fun y : ℝ => Real.log (y + c)) ((x + c)⁻¹ * 1) x := by
    have h := (Real.hasDerivAt_log (ne_of_gt hx)).comp x h1
    exact h
  refine (hlog.const_mul ρ).congr_deriv ?_
  rw [pow_one]
  field_simp

/-! ## Finite cutoff -/

/-- The finite-cutoff resolvent trace of order `r`. -/
def cutoffResolventTrace (ρ E : ℕ → ℝ) (s : Finset ℕ) (r : ℕ) (x : ℝ) : ℝ :=
  ∑ n ∈ s, ρ n / (x + E n) ^ r

/-- The finite-cutoff one-loop action. -/
def cutoffAction (ρ E : ℕ → ℝ) (s : Finset ℕ) (x : ℝ) : ℝ :=
  (1 / 2) * ∑ n ∈ s, ρ n * Real.log (x + E n)

/-- The finite-cutoff homogeneous mass-source vertex of order `m + 1`. -/
def cutoffVertex (ρ E : ℕ → ℝ) (s : Finset ℕ) (m : ℕ) (x : ℝ) : ℝ :=
  (1 / 2) * (-1 : ℝ) ^ m * (Nat.factorial m : ℝ) * cutoffResolventTrace ρ E s (m + 1) x

theorem hasDerivAt_cutoffResolventTrace (ρ E : ℕ → ℝ) (s : Finset ℕ) (m : ℕ) {x : ℝ}
    (hx : ∀ n ∈ s, x + E n ≠ 0) :
    HasDerivAt (cutoffResolventTrace ρ E s (m + 1))
      (-((m : ℝ) + 1) * cutoffResolventTrace ρ E s (m + 2) x) x := by
  have hsum : HasDerivAt (fun y : ℝ => ∑ n ∈ s, ρ n / (y + E n) ^ (m + 1))
      (∑ n ∈ s, -((m : ℝ) + 1) * ρ n / (x + E n) ^ (m + 2)) x :=
    HasDerivAt.fun_sum fun n hn => hasDerivAt_resolventTerm (ρ n) (E n) m (hx n hn)
  refine hsum.congr_deriv ?_
  rw [cutoffResolventTrace, Finset.mul_sum]
  exact Finset.sum_congr rfl fun n _ => by ring

/-- **Equation `(3)` at the first order.**  The first vertex is the derivative of the action. -/
theorem hasDerivAt_cutoffAction (ρ E : ℕ → ℝ) (s : Finset ℕ) {x : ℝ}
    (hx : ∀ n ∈ s, 0 < x + E n) :
    HasDerivAt (cutoffAction ρ E s) (cutoffVertex ρ E s 0 x) x := by
  have hsum : HasDerivAt (fun y : ℝ => ∑ n ∈ s, ρ n * Real.log (y + E n))
      (∑ n ∈ s, ρ n / (x + E n) ^ 1) x :=
    HasDerivAt.fun_sum fun n hn => hasDerivAt_logTerm (ρ n) (E n) (hx n hn)
  refine ((hsum.const_mul (1 / 2 : ℝ)).congr_deriv ?_)
  rw [cutoffVertex, cutoffResolventTrace]
  norm_num

/-- **Equation `(3)`.**  Each vertex is the derivative of the previous one, so the vertex of order
`m + 1` is the `(m+1)`-st derivative of the action. -/
theorem hasDerivAt_cutoffVertex (ρ E : ℕ → ℝ) (s : Finset ℕ) (m : ℕ) {x : ℝ}
    (hx : ∀ n ∈ s, x + E n ≠ 0) :
    HasDerivAt (cutoffVertex ρ E s m) (cutoffVertex ρ E s (m + 1) x) x := by
  have h := (hasDerivAt_cutoffResolventTrace ρ E s m hx).const_mul
    ((1 / 2) * (-1 : ℝ) ^ m * (Nat.factorial m : ℝ))
  refine h.congr_deriv ?_
  rw [cutoffVertex]
  rw [show Nat.factorial (m + 1) = (m + 1) * Nat.factorial m from rfl]
  push_cast
  ring

/-! ## Infinite spectrum: termwise differentiation -/

/-- The resolvent trace of the full spectrum. -/
def resolventTrace (ρ E : ℕ → ℝ) (r : ℕ) (x : ℝ) : ℝ :=
  ∑' n, ρ n / (x + E n) ^ r

/-- **Equation `(4)`.**  On an open connected set carrying a summable majorant for the next-order
terms, the resolvent trace differentiates termwise:  `Q_{r+1} = -(Q_r)'/(r+1)`. -/
theorem hasDerivAt_resolventTrace {ρ E : ℕ → ℝ} {t : Set ℝ} (hopen : IsOpen t)
    (hconn : IsPreconnected t) (m : ℕ)
    (hpole : ∀ n : ℕ, ∀ y ∈ t, y + E n ≠ 0)
    {u : ℕ → ℝ} (hu : Summable u)
    (hbound : ∀ n : ℕ, ∀ y ∈ t, ‖-((m : ℝ) + 1) * ρ n / (y + E n) ^ (m + 2)‖ ≤ u n)
    {x₀ : ℝ} (hx₀ : x₀ ∈ t) (hsum : Summable fun n => ρ n / (x₀ + E n) ^ (m + 1))
    {x : ℝ} (hx : x ∈ t) :
    HasDerivAt (resolventTrace ρ E (m + 1))
      (-((m : ℝ) + 1) * resolventTrace ρ E (m + 2) x) x := by
  have hderiv := hasDerivAt_tsum_of_isPreconnected (u := u)
    (g := fun n y => ρ n / (y + E n) ^ (m + 1))
    (g' := fun n y => -((m : ℝ) + 1) * ρ n / (y + E n) ^ (m + 2))
    hu hopen hconn (fun n y hy => hasDerivAt_resolventTerm (ρ n) (E n) m (hpole n y hy))
    hbound hx₀ hsum hx
  refine hderiv.congr_deriv ?_
  rw [resolventTrace]
  have hfun : (fun n => -((m : ℝ) + 1) * ρ n / (x + E n) ^ (m + 2))
      = fun n => (-((m : ℝ) + 1)) * (ρ n / (x + E n) ^ (m + 2)) := by
    funext n
    ring
  rw [hfun, tsum_mul_left]

/-! ## Abstract differential generation -/

variable {F L : Type*} [Field F] [Field L] [Algebra F L] [Differential F] [Differential L]
  [DifferentialAlgebra F L]

/-- **The vertex hierarchy is differentially generated by the second trace.**  A family obeying
`q (r+1) = -(q r)'/r` from index two upwards lies in the differential field generated by `q 2`. -/
theorem mem_differentialAdjoin_of_resolventRecursion (q : ℕ → L)
    (hq : ∀ r : ℕ, 2 ≤ r → q (r + 1) = -(Differential.deriv (q r)) / (r : L)) :
    ∀ r : ℕ, 2 ≤ r → q r ∈ differentialAdjoin F ({q 2} : Set L) := by
  intro r
  induction r with
  | zero => intro h; omega
  | succ r ih =>
    intro _
    rcases Nat.lt_or_ge r 2 with hlt | hge
    · have hr : r = 1 := by omega
      subst hr
      exact subset_differentialAdjoin F _ rfl
    · have hmem := ih hge
      rw [hq r hge]
      refine div_mem ?_ ?_
      · exact neg_mem ((derivationClosed_differentialAdjoin F _) hmem)
      · exact (differentialAdjoin F ({q 2} : Set L)).natCast_mem r

end

end GaloisForLFunctions.HTGeometry
