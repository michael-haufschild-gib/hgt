import GaloisForLFunctions.HTGeometry.HypertranscendentalClockIncompressibility

/-!
# The jet order is the rational-expressibility order

An element of the free differential rational field lies in the subfield generated by a set of jet
coordinates exactly when all partial derivatives with respect to the remaining coordinates vanish.

The nontrivial direction is proved by descent on the total degree of a denominator: differentiating
a fractional representation with respect to an outside coordinate produces another fractional
representation of the same element with a denominator of strictly smaller total degree, so a
denominator whose outside partial derivatives all vanish exists, and in characteristic zero such a
polynomial involves no outside coordinate.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace JetField

noncomputable section

variable {C : Type u} {ι : Type v} [Field C]

section Polynomials

variable [CharZero C]

/-- In characteristic zero, differentiating with respect to a coordinate occurring in a polynomial
gives a nonzero polynomial. -/
theorem pderiv_ne_zero_of_mem_vars {a : JetPoly C ι} {q : ι × ℕ} (hq : q ∈ a.vars) :
    MvPolynomial.pderiv q a ≠ 0 := by
  classical
  obtain ⟨d, hd, hdq⟩ := (MvPolynomial.mem_vars_iff_mem_support q).mp hq
  have hdq' : 1 ≤ d q := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hdq)
  set d' : (ι × ℕ) →₀ ℕ := d - Finsupp.single q 1 with hd'
  have hsum : d' + Finsupp.single q 1 = d := by
    ext r
    by_cases hr : r = q
    · subst hr
      simp only [hd', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]
      omega
    · simp [hd', hr]
  have hval : d' q + 1 = d q := by
    simp only [hd', Finsupp.tsub_apply, Finsupp.single_eq_same]
    omega
  intro hzero
  have hcoeff := MvPolynomial.coeff_pderiv (i := q) a d'
  rw [hzero, MvPolynomial.coeff_zero, hsum] at hcoeff
  have hne : MvPolynomial.coeff d a ≠ 0 := MvPolynomial.mem_support_iff.mp hd
  have hcast : ((d' q : C) + 1) ≠ 0 := by
    have hnat : ((d' q + 1 : ℕ) : C) ≠ 0 := by
      rw [hval]
      exact Nat.cast_ne_zero.mpr (by omega : d q ≠ 0)
    push_cast at hnat
    exact hnat
  exact absurd hcoeff.symm (mul_ne_zero hne hcast)

/-- A polynomial all of whose partial derivatives outside a set of coordinates vanish involves only
coordinates from that set. -/
theorem vars_subset_of_pderiv_eq_zero {a : JetPoly C ι} {S : Set (ι × ℕ)}
    (h : ∀ q ∉ S, MvPolynomial.pderiv q a = 0) : ↑a.vars ⊆ S := by
  intro q hq
  by_contra hqS
  exact pderiv_ne_zero_of_mem_vars (Finset.mem_coe.mp hq) (h q hqS)

omit [CharZero C] in
theorem totalDegree_pderiv_lt {a : JetPoly C ι} {q : ι × ℕ}
    (hne : MvPolynomial.pderiv q a ≠ 0) :
    (MvPolynomial.pderiv q a).totalDegree < a.totalDegree := by
  classical
  obtain ⟨m, hm⟩ := MvPolynomial.support_nonempty.mpr hne
  have hstep : ∀ n ∈ (MvPolynomial.pderiv q a).support,
      (n.sum fun _ e => e) + 1 ≤ a.totalDegree := by
    intro n hn
    have hcoeff := MvPolynomial.coeff_pderiv (i := q) a n
    have hnz : MvPolynomial.coeff n (MvPolynomial.pderiv q a) ≠ 0 :=
      MvPolynomial.mem_support_iff.mp hn
    rw [hcoeff] at hnz
    have hmem : n + Finsupp.single q 1 ∈ a.support :=
      MvPolynomial.mem_support_iff.mpr (left_ne_zero_of_mul hnz)
    have hle := MvPolynomial.le_totalDegree hmem
    have hsum : ((n + Finsupp.single q 1).sum fun _ e => e) = (n.sum fun _ e => e) + 1 := by
      rw [Finsupp.sum_add_index' (by intro _; rfl) (by intro _ _ _; rfl),
        Finsupp.sum_single_index rfl]
    omega
  have hbound : ((MvPolynomial.pderiv q a).support.sup fun s => s.sum fun _ e => e) + 1
      ≤ a.totalDegree := by
    have h1 : (m.sum fun _ e => e) + 1 ≤ a.totalDegree := hstep m hm
    have h2 : ((MvPolynomial.pderiv q a).support.sup fun s => s.sum fun _ e => e)
        ≤ a.totalDegree - 1 := by
      refine Finset.sup_le fun n hn => ?_
      have := hstep n hn
      omega
    omega
  have h3 : (MvPolynomial.pderiv q a).totalDegree
      = ((MvPolynomial.pderiv q a).support.sup fun s => s.sum fun _ e => e) := rfl
  omega

end Polynomials

/-- The image of a polynomial supported on a set of coordinates lies in the subfield generated by
those coordinates. -/
theorem algebraMap_mem_adjoin_of_vars_subset {S : Set (ι × ℕ)} {a : JetPoly C ι}
    (ha : ↑a.vars ⊆ S) :
    algebraMap (JetPoly C ι) (JetField C ι) a ∈
      IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S) := by
  have hmemsup : a ∈ MvPolynomial.supported C S := MvPolynomial.mem_supported.mpr ha
  rw [MvPolynomial.supported_eq_adjoin_X] at hmemsup
  have hsub : Algebra.adjoin C (MvPolynomial.X '' S) ≤
      (IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S)).toSubalgebra.comap
        (MvPolynomial.aeval (fun p : ι × ℕ => (jet p : JetField C ι))) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨p, hp, rfl⟩
    have hmem : MvPolynomial.aeval (fun q : ι × ℕ => (jet q : JetField C ι))
        (MvPolynomial.X p : JetPoly C ι)
        ∈ IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S) := by
      rw [MvPolynomial.aeval_X]
      exact IntermediateField.subset_adjoin C _ ⟨p, hp, rfl⟩
    exact hmem
  have hmem := hsub hmemsup
  rw [algebraMap_eq_aeval]
  exact hmem

/-- **Rational expressibility from vanishing partials.**  An element whose partial derivatives
outside a set of coordinates all vanish is a rational function of those coordinates. -/
theorem mem_adjoin_of_pd_eq_zero [CharZero C] {S : Set (ι × ℕ)} {u : JetField C ι}
    (hu : ∀ q ∉ S, pd q u = 0) :
    u ∈ IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S) := by
  classical
  have key : ∀ n : ℕ, ∀ a b : JetPoly C ι, b ≠ 0 → b.totalDegree ≤ n →
      u * algebraMap (JetPoly C ι) (JetField C ι) b
        = algebraMap (JetPoly C ι) (JetField C ι) a →
      u ∈ IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro a b hb hdeg hrel
      have hbne : algebraMap (JetPoly C ι) (JetField C ι) b ≠ 0 := by
        intro hzero
        exact hb ((IsFractionRing.to_map_eq_zero_iff (R := JetPoly C ι)
          (K := JetField C ι)).mp hzero)
      have hstep : ∀ q ∉ S,
          u * algebraMap (JetPoly C ι) (JetField C ι) (MvPolynomial.pderiv q b)
            = algebraMap (JetPoly C ι) (JetField C ι) (MvPolynomial.pderiv q a) := by
        intro q hq
        have hd := congrArg (pd q) hrel
        rw [Derivation.leibniz, hu q hq, smul_zero, add_zero, pd_algebraMap, pd_algebraMap,
          smul_eq_mul] at hd
        exact hd
      by_cases hall : ∀ q ∉ S, MvPolynomial.pderiv q b = 0
      · have hbvars : ↑b.vars ⊆ S := vars_subset_of_pderiv_eq_zero hall
        have havars : ↑a.vars ⊆ S := by
          refine vars_subset_of_pderiv_eq_zero fun q hq => ?_
          have h1 := hstep q hq
          rw [hall q hq, map_zero, mul_zero] at h1
          exact (IsFractionRing.to_map_eq_zero_iff (R := JetPoly C ι)
            (K := JetField C ι)).mp h1.symm
        have hA := algebraMap_mem_adjoin_of_vars_subset havars
        have hB := algebraMap_mem_adjoin_of_vars_subset hbvars
        have hu' : u = algebraMap (JetPoly C ι) (JetField C ι) a
            / algebraMap (JetPoly C ι) (JetField C ι) b := by
          rw [eq_div_iff hbne]
          exact hrel
        rw [hu']
        exact div_mem hA hB
      · obtain ⟨q, hqS, hqb⟩ : ∃ q, q ∉ S ∧ MvPolynomial.pderiv q b ≠ 0 := by
          by_contra hcon
          refine hall fun q hq => ?_
          by_contra hz
          exact hcon ⟨q, hq, hz⟩
        have hlt : (MvPolynomial.pderiv q b).totalDegree < b.totalDegree :=
          totalDegree_pderiv_lt hqb
        exact ih (MvPolynomial.pderiv q b).totalDegree (by omega)
          (MvPolynomial.pderiv q a) (MvPolynomial.pderiv q b) hqb le_rfl (hstep q hqS)
  obtain ⟨⟨a, b⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors (JetPoly C ι)) u
  exact key ((b : JetPoly C ι).totalDegree) a (b : JetPoly C ι)
    (nonZeroDivisors.ne_zero b.2) le_rfl hb


/-- The kernel of a derivation, as an intermediate field. -/
def derivationKernelField (D : Derivation C (JetField C ι) (JetField C ι)) :
    IntermediateField C (JetField C ι) where
  __ := derivationEqualizer D 0
  inv_mem' := by
    intro x hx
    have hx' : D x = 0 := by
      have := mem_derivationEqualizer.mp hx
      simpa using this
    have hgoal : D x⁻¹ = 0 := by
      by_cases hx0 : x = 0
      · rw [hx0, inv_zero, map_zero]
      · have hone : D (x * x⁻¹) = 0 := by
          rw [mul_inv_cancel₀ hx0]
          exact D.map_one_eq_zero
        rw [Derivation.leibniz, hx', smul_zero, add_zero] at hone
        have := smul_eq_zero.mp hone
        exact this.resolve_left hx0
    exact mem_derivationEqualizer.mpr (by simpa using hgoal)

/-- Coordinates outside a generating set annihilate the field it generates. -/
theorem pd_eq_zero_of_mem_adjoin {S : Set (ι × ℕ)} {q : ι × ℕ} (hq : q ∉ S)
    {u : JetField C ι}
    (hu : u ∈ IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S)) :
    pd q u = 0 := by
  have hle : IntermediateField.adjoin C ((fun p => (jet p : JetField C ι)) '' S)
      ≤ derivationKernelField (pd q) := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨p, hp, rfl⟩
    have hne : q ≠ p := fun hcon => hq (hcon ▸ hp)
    have hzero : pd q (jet p : JetField C ι) = 0 := pd_jet_of_ne hne
    exact mem_derivationEqualizer.mpr (by simpa using hzero)
  have hmem := hle hu
  have := mem_derivationEqualizer.mp hmem
  simpa using this

/-- **Membership in a jet level.**  An element is a rational function of the jets of level at most
`N` exactly when all its partial derivatives above level `N` vanish. -/
theorem mem_jetLevel_iff [CharZero C] {N : ℕ} {u : JetField C ι} :
    u ∈ IntermediateField.adjoin C
        ((fun p => (jet p : JetField C ι)) '' {p : ι × ℕ | p.2 ≤ N})
      ↔ ∀ (j : ι) (m : ℕ), N < m → pd (j, m) u = 0 := by
  constructor
  · intro hu j m hm
    refine pd_eq_zero_of_mem_adjoin ?_ hu
    intro hmem
    exact absurd (Set.mem_setOf_eq ▸ hmem) (by omega)
  · intro h
    refine mem_adjoin_of_pd_eq_zero fun q hq => ?_
    have hq' : ¬ (q.2 ≤ N) := fun hle => hq hle
    have := h q.1 q.2 (by omega)
    rwa [Prod.mk.eta] at this

/-- **The Frechet order is the rational-expressibility order.** -/
theorem ordJet_le_iff [Fintype ι] [CharZero C] (u : JetField C ι) (N : ℕ) :
    ordJet u ≤ N ↔ u ∈ IntermediateField.adjoin C
      ((fun p => (jet p : JetField C ι)) '' {p : ι × ℕ | p.2 ≤ N}) := by
  rw [mem_jetLevel_iff, ordJet, DiffOp.degVec_le_iff]
  constructor
  · intro h j m hm
    have := DiffOp.degree_le_iff.mp (h j) m hm
    rwa [coeff_frechet] at this
  · intro h j
    refine DiffOp.degree_le_iff.mpr fun m hm => ?_
    rw [coeff_frechet]
    exact h j m hm

/-- The Frechet order is the least jet level at which the element is a rational function of the
jets. -/
theorem isLeast_ordJet [Fintype ι] [CharZero C] (u : JetField C ι) :
    IsLeast {N : ℕ | u ∈ IntermediateField.adjoin C
      ((fun p => (jet p : JetField C ι)) '' {p : ι × ℕ | p.2 ≤ N})} (ordJet u) := by
  constructor
  · exact (ordJet_le_iff u (ordJet u)).mp le_rfl
  · intro N hN
    exact (ordJet_le_iff u N).mpr hN

end

end JetField

end GaloisForLFunctions.HTGeometry
