import GaloisForLFunctions.HTGeometry.BaseGaugeJetField

/-!
# Differential-algebraic gauges are blind to the divisor

Let `F ⊆ L` be a differential field extension and let a *gauge* be multiplication of a family by
nonzero elements of `F` (in the intended application: multiplication of every translate of a
meromorphic function by the corresponding translate of a nonzero rational function).  Then

* the differential field generated by the family is unchanged;
* the differential field generated by the logarithmic derivatives is unchanged, because a gauge
  shifts each of them by an element of `F`;
* every finite additive source extractor changes only by an element of `F`, so the extracted
  source class modulo `F` is unchanged;
* every finite jet field, and hence the minimal differential aperture, is unchanged.

None of these data sees the divisor: the companion module `RHTower/XiFinitePacketGauge` produces,
for every prescribed finite off-critical quartet packet, a rational gauge of the completed `ξ`
carrying exactly that packet.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

noncomputable section

variable {F L : Type*} [Field F] [Field L] [Algebra F L]
  [Differential F] [Differential L] [DifferentialAlgebra F L]

/-- **Equation `(1)`.**  A coordinatewise nonzero base gauge of a translate family generates the
same differential field. -/
theorem differentialAdjoin_gauge_eq {ι : Type*} (x : ι → L) (a : ι → F) (ha : ∀ i, a i ≠ 0) :
    differentialAdjoin F (Set.range fun i => algebraMap F L (a i) * x i)
      = differentialAdjoin F (Set.range x) :=
  differentialAdjoin_range_mulBase_eq x a ha

/-- **Equation `(2)`.**  A gauge shifts each logarithmic derivative by an element of the base, and
an additive base shift generates the same differential field. -/
theorem differentialAdjoin_logDerivGauge_eq {ι : Type*} (y : ι → L) (b : ι → F) :
    differentialAdjoin F (Set.range fun i => y i + algebraMap F L (b i))
      = differentialAdjoin F (Set.range y) := by
  have h := differentialAdjoin_range_affineBase_eq y (fun _ => (1 : F)) b (fun _ => one_ne_zero)
  simpa using h

/-- Differential independence of a translate family is a gauge invariant. -/
theorem differentialIndependent_gauge_iff {ι : Type*} [Fintype ι] [DecidableEq ι] [CharZero L]
    (x : ι → L) (a : ι → F) (ha : ∀ i, a i ≠ 0) :
    DifferentialIndependent F (fun i => algebraMap F L (a i) * x i)
      ↔ DifferentialIndependent F x :=
  differentialIndependent_mulBase_iff x a ha

/-- Differential independence of a logarithmic-derivative family is a gauge invariant. -/
theorem differentialIndependent_logDerivGauge_iff {ι : Type*} [Fintype ι] [DecidableEq ι]
    [CharZero L]
    (y : ι → L) (b : ι → F) :
    DifferentialIndependent F (fun i => y i + algebraMap F L (b i))
      ↔ DifferentialIndependent F y := by
  have h := differentialIndependent_affineBase_iff y (fun _ => (1 : F)) b (fun _ => one_ne_zero)
  simpa using h

omit [Differential F] [Differential L] [DifferentialAlgebra F L] in
/-- **Equation `(3)`.**  An additive source extractor sees a gauge only through an element of the
base field, so the extracted source class modulo `F` is a gauge invariant. -/
theorem sourceClass_gauge_invariant {T : L →+ L}
    (hT : ∀ b : F, T (algebraMap F L b) ∈ (algebraMap F L).range) (y : L) (b : F) :
    T (y + algebraMap F L b) - T y ∈ (algebraMap F L).range := by
  rw [map_add, add_sub_cancel_left]
  exact hT b

/-- **The complete gauge-invariant data list.**  For a coordinatewise nonzero base gauge of a
family and an arbitrary additive base shift of the associated logarithmic-derivative family, the
generated differential fields, the differential independence status, and every finite jet field
coincide before and after the gauge. -/
theorem gauge_invariant_data {ι : Type*} [Fintype ι] [DecidableEq ι] [CharZero L]
    (x : ι → L) (a : ι → F) (ha : ∀ i, a i ≠ 0) (y : ι → L) (b : ι → F) :
    differentialAdjoin F (Set.range fun i => algebraMap F L (a i) * x i)
        = differentialAdjoin F (Set.range x) ∧
      differentialAdjoin F (Set.range fun i => y i + algebraMap F L (b i))
        = differentialAdjoin F (Set.range y) ∧
      (DifferentialIndependent F (fun i => algebraMap F L (a i) * x i)
        ↔ DifferentialIndependent F x) ∧
      (DifferentialIndependent F (fun i => y i + algebraMap F L (b i))
        ↔ DifferentialIndependent F y) ∧
      (∀ i m, jetField_baseGaugeJetField F (algebraMap F L (a i) * x i) m = jetField_baseGaugeJetField F (x i) m) ∧
      (∀ i m, JetAlgebraicOver F (algebraMap F L (a i) * x i) m ↔ JetAlgebraicOver F (x i) m) :=
  ⟨differentialAdjoin_gauge_eq x a ha, differentialAdjoin_logDerivGauge_eq y b,
    differentialIndependent_gauge_iff x a ha, differentialIndependent_logDerivGauge_iff y b,
    fun i m => jetField_mul_base_eq (ha i) (x i) m,
    fun i m => jetAlgebraicOver_mul_base_iff (ha i) (x i) m⟩

end

end GaloisForLFunctions.HTGeometry
