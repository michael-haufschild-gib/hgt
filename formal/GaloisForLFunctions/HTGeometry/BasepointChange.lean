import GaloisForLFunctions.HTGeometry.MovedRayPencil
import GaloisForLFunctions.HTGeometry.ObserverBoundaryAtInfinity

/-!
# Basepoint change

A geodesic ray of observer metrics moved by a symmetry, `t ↦ g* exp (t T) g`, no longer starts at
the reference metric.  It is nevertheless asymptotic to a ray that does:

```text
∃ S,  Asymptotic (t ↦ g* exp (t T) g) (t ↦ exp (t S)),
```

and the direction `S` is the one whose degeneration flag is the transported flag of `T`.  So the
boundary at infinity does not depend on the basepoint, and the action of the symmetry group on it
is the action on flags.

The estimate is the pair of pencil bounds: both `P⁻¹ Q` and `Q⁻¹ P` stay bounded along the ray, so
the logarithm of the relative spectrum stays bounded, so the distance does.
-/

namespace GaloisForLFunctions.HTGeometry

open Module InnerProductSpace

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [FiniteDimensional ℂ E]

/-! ## Moved rays -/

/-- The ray generated by a Hermitian direction, moved by a symmetry of the observer space. -/
noncomputable def movedRay (g : E ≃ₗ[ℂ] E) {T : E →ₗ[ℂ] E} (hT : T.IsSymmetric) (t : ℝ) :
    ObserverMetric E where
  form := congrOp g ((metricRay T t : E →ₗ[ℂ] E))
  isSymm := isSymmetric_congrOp g (isSymmetric_metricRay hT rfl t)
  isPos := fun _ hv => inner_congrOp_pos g (fun _ hu => inner_metricRay_pos hT rfl hu t) hv

theorem dist_movedRay (g : E ≃ₗ[ℂ] E) {T S : E →ₗ[ℂ] E} (hT : T.IsSymmetric)
    (hS : S.IsSymmetric) (t : ℝ) :
    dist (movedRay g hT t) (observerRay hS t)
      = observerDist (isSymmetric_congrOp g (isSymmetric_metricRay hT rfl t)) rfl
          (isSymmetric_metricRay hS rfl t) :=
  rfl

/-! ## A moved ray is asymptotic to a ray from the reference metric -/

/-- **A moved ray stays a bounded distance from the ray of the transported direction.**  Both
pencils are bounded uniformly along the ray, so the whole relative spectrum stays in a fixed
interval and the distance is bounded by its logarithm. -/
theorem asymptotic_movedRay (g : E ≃ₗ[ℂ] E) {T : E →ₗ[ℂ] E} (hT : T.IsSymmetric)
    (b gs : OrthonormalBasis (Fin (finrank ℂ E)) ℂ E) {w : Fin (finrank ℂ E) → ℝ}
    (hw : Antitone w) (hdT : ∀ i, T (b i) = ((w i : ℝ) : ℂ) • b i)
    (htri₁ : ∀ j, LinearMap.adjoint ((g.symm : E →ₗ[ℂ] E)) (gs j)
      ∈ Submodule.span ℂ (b '' Set.Iic j))
    (htri₂ : ∀ i, LinearMap.adjoint ((g : E →ₗ[ℂ] E)) (b i)
      ∈ Submodule.span ℂ (gs '' Set.Iic i)) :
    Asymptotic (movedRay g hT) (observerRay (isSymmetric_diagOp gs w)) := by
  classical
  set C₁ := ∑ j, ∑ i, ‖(inner ℂ (b i)
    (LinearMap.adjoint ((g.symm : E →ₗ[ℂ] E)) (gs j)) : ℂ)‖ * ‖g.symm (b i)‖ with hC₁
  set C₂ := ‖LinearMap.toContinuousLinearMap ((g : E →ₗ[ℂ] E))‖
    * ∑ i, ∑ j, ‖(inner ℂ (gs j) (LinearMap.adjoint ((g : E →ₗ[ℂ] E)) (b i)) : ℂ)‖ with hC₂
  refine ⟨Real.sqrt (finrank ℂ E) * Real.log (max 1 (max C₁ C₂)), fun t ht => ?_⟩
  have hdS : ∀ j, diagOp gs w (gs j) = ((w j : ℝ) : ℂ) • gs j := diagOp_apply_basis gs w
  have h1 := le_trans (norm_pencil_le g hT rfl ht b gs hw hdT hdS htri₁)
    (le_trans (le_max_left C₁ C₂) (le_max_right 1 (max C₁ C₂)))
  have h2 := le_trans
    (norm_mirror_pencil_le g (isSymmetric_diagOp gs w) rfl ht b gs hw hdT hdS htri₂)
    (le_trans (le_max_right C₁ C₂) (le_max_right 1 (max C₁ C₂)))
  rw [dist_movedRay g hT (isSymmetric_diagOp gs w) t]
  exact observerDist_le_of_norm_le _ rfl _
    (fun _ hv => inner_congrOp_pos g (fun _ hu => inner_metricRay_pos hT rfl hu t) hv)
    (fun _ hv => inner_metricRay_pos (isSymmetric_diagOp gs w) rfl hv t)
    (le_max_left 1 (max C₁ C₂)) h1 h2

/-- **Basepoint change.**  Every ray moved by a symmetry is asymptotic to a ray from the reference
metric, and the direction of that ray is the one carrying the transported degeneration flag.  So the
boundary at infinity is independent of the basepoint, and a symmetry acts on it through its action
on flags. -/
theorem exists_asymptotic_observerRay (g : E ≃ₗ[ℂ] E) {T : E →ₗ[ℂ] E} (hT : T.IsSymmetric) :
    ∃ (S : E →ₗ[ℂ] E) (hS : S.IsSymmetric),
      Asymptotic (movedRay g hT) (observerRay hS) ∧
        ∀ c : ℝ, eigenSum S c = (eigenSum T c).map (LinearMap.adjoint (g : E →ₗ[ℂ] E)) := by
  classical
  obtain ⟨b, w, hw, hd⟩ := exists_antitone_eigenframe hT (rfl : finrank ℂ E = finrank ℂ E)
  have hcard : finrank ℂ E = Fintype.card (Fin (finrank ℂ E)) := by
    rw [Fintype.card_fin]
  have hLI : LinearIndependent ℂ (fun i => LinearMap.adjoint ((g : E →ₗ[ℂ] E)) (b i)) :=
    (b.toBasis.linearIndependent).map' (LinearMap.adjoint ((g : E →ₗ[ℂ] E)))
      (LinearMap.ker_eq_bot.2 (adjoint_equiv_injective g))
  refine ⟨diagOp (gramSchmidtOrthonormalBasis hcard
      (fun i => LinearMap.adjoint ((g : E →ₗ[ℂ] E)) (b i))) w, isSymmetric_diagOp _ w,
    asymptotic_movedRay g hT b _ hw hd
      (fun j => adjoint_symm_gramSchmidt_mem_span g b hcard hLI j)
      (fun i => mem_span_gramSchmidtOrthonormalBasis hcard hLI i),
    eigenSum_diagOp_eq_map g b _ hw hd (span_gramSchmidtOrthonormalBasis_Iic hcard hLI)⟩

end GaloisForLFunctions.HTGeometry
