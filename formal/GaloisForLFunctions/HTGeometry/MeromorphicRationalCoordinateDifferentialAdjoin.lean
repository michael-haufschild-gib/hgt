import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicBaseChange
import GaloisForLFunctions.HTGeometry.MeromorphicEllipticRationalCompositum

/-!
# The embedded rational coordinate as a differential adjunction

The genuine meromorphic image of `ℂ(X)` is exactly the differential field generated by the
coordinate germ.  In particular the coordinate is differentially algebraic over the constants:
its first derivative is one.
-/

open Filter Set Topology
open scoped Differential nonZeroDivisors

namespace GaloisForLFunctions

open Bottcher Polynomial

noncomputable section

local instance meromorphicRationalDifferentialAdjoinDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance meromorphicRationalDifferentialAdjoinComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring Set.univ) := (constToAnalytic Set.univ).toAlgebra

local instance meromorphicRationalDifferentialAdjoinComplexAlgebraMero :
    Algebra ℂ (meroField Set.univ) :=
  ((algebraMap (analyticSubring Set.univ) (meroField Set.univ)).comp
    (constToAnalytic Set.univ)).toAlgebra

local instance meromorphicRationalDifferentialAdjoinRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField Set.univ) :=
  (ratfuncToMero Set.univ isOpen_univ isPreconnected_univ
    Set.univ_nonempty Set.infinite_univ).toAlgebra

local instance meromorphicRationalDifferentialAdjoinRatFuncDifferential :
    Differential (RatFunc ℂ) := ratFuncCoordinateDifferential

local instance meromorphicRationalDifferentialAdjoinMeroDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance meromorphicRationalDifferentialAdjoinDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) (meroField Set.univ) :=
  ⟨meroField_deriv_ratfuncToMero⟩

/-- The genuine global meromorphic coordinate germ. -/
def meromorphicRationalCoordinate : meroField (Set.univ : Set ℂ) :=
  algebraMap (RatFunc ℂ) (meroField Set.univ) RatFunc.X

/-- The meromorphic coordinate satisfies the exact value-jet relation `z' = 1`. -/
theorem meromorphicRationalCoordinate_deriv :
    (meromorphicRationalCoordinate)′ =
      algebraMap ℂ (meroField Set.univ) 1 := by
  rw [meromorphicRationalCoordinate, deriv_algebraMap]
  change algebraMap (RatFunc ℂ) (meroField Set.univ)
      (HTGeometry.ratFuncCoordinateDerivation ℂ RatFunc.X) = _
  rw [show HTGeometry.ratFuncCoordinateDerivation ℂ RatFunc.X = 1 by
    rw [show RatFunc.X =
        algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X by rfl,
      HTGeometry.ratFuncCoordinateDerivation_algebraMap]
    simp]
  simp

/-- The coordinate germ is differentially algebraic over the embedded complex constants. -/
theorem differentialAlgebraicOver_meromorphicRationalCoordinate :
    DifferentialAlgebraicOver ℂ meromorphicRationalCoordinate := by
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hindependent
  rw [algebraicIndependent_iff] at hindependent
  let P : MvPolynomial (Unit × ℕ) ℂ :=
    MvPolynomial.X ((), 1) - MvPolynomial.C 1
  have hrelation : MvPolynomial.aeval
      (fun p : Unit × ℕ ↦ differentialJet p.2 meromorphicRationalCoordinate) P = 0 := by
    simp [P, differentialJet_succ, meromorphicRationalCoordinate_deriv]
  have hzero : P = 0 := hindependent P hrelation
  have heval := congrArg
    (MvPolynomial.eval (fun _ : Unit × ℕ ↦ (0 : ℂ))) hzero
  simp [P] at heval

/-- The embedded rational-function field is the differential field generated by the coordinate
germ.  This identifies the abstract coefficient field in DA base change with the actual
`ℂ(z)` carrier used by meromorphic special functions. -/
theorem differentialAdjoin_meromorphicRationalCoordinate_eq :
    differentialAdjoin ℂ ({meromorphicRationalCoordinate} :
      Set (meroField Set.univ)) = meromorphicRationalCoordinateField := by
  apply le_antisymm
  · apply differentialAdjoin_le ℂ
    · intro z hz
      simp only [Set.mem_singleton_iff] at hz
      subst z
      exact (mem_meromorphicRationalCoordinateField_iff _).mpr
        ⟨RatFunc.X, rfl⟩
    · exact meromorphicRationalCoordinateField_derivationClosed
  · intro z hz
    rw [mem_meromorphicRationalCoordinateField_iff] at hz
    obtain ⟨r, rfl⟩ := hz
    have hr : r ∈ IntermediateField.adjoin ℂ ({RatFunc.X} : Set (RatFunc ℂ)) := by
      rw [RatFunc.adjoin_X]
      trivial
    apply IntermediateField.adjoin_induction ℂ
      (s := ({RatFunc.X} : Set (RatFunc ℂ)))
      (p := fun q _ => algebraMap (RatFunc ℂ) (meroField Set.univ) q ∈
        differentialAdjoin ℂ ({meromorphicRationalCoordinate} :
          Set (meroField Set.univ)))
    · intro q hq
      simp only [Set.mem_singleton_iff] at hq
      subst q
      simpa [meromorphicRationalCoordinate] using
        subset_differentialAdjoin ℂ
          ({meromorphicRationalCoordinate} : Set (meroField Set.univ))
          (Set.mem_singleton meromorphicRationalCoordinate)
    · intro a
      rw [meromorphicRatFunc_algebraMap_complex]
      exact (differentialAdjoin ℂ
        ({meromorphicRationalCoordinate} : Set (meroField Set.univ))).algebraMap_mem a
    · intro a b ha hb hma hmb
      rw [(algebraMap (RatFunc ℂ) (meroField Set.univ)).map_add]
      exact (differentialAdjoin ℂ
        ({meromorphicRationalCoordinate} : Set (meroField Set.univ))).add_mem hma hmb
    · intro a ha hma
      rw [map_inv₀ (algebraMap (RatFunc ℂ) (meroField Set.univ))]
      exact (differentialAdjoin ℂ
        ({meromorphicRationalCoordinate} : Set (meroField Set.univ))).inv_mem hma
    · intro a b ha hb hma hmb
      rw [(algebraMap (RatFunc ℂ) (meroField Set.univ)).map_mul]
      exact (differentialAdjoin ℂ
        ({meromorphicRationalCoordinate} : Set (meroField Set.univ))).mul_mem hma hmb
    exact hr

end

end GaloisForLFunctions
