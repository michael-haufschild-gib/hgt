import GaloisForLFunctions.HTGeometry.StanleyReisnerNumeratorDifferentialMatroid

/-!
# Translation denominators and Laurent exponent shifts

The localization denominator monoid generated by `t_v = x_v + 1` is represented as the range of
the translation-monomial homomorphism.  Every denominator therefore has a chosen exponent vector.
Dividing a facet translation polynomial by that monomial is the injective coefficient reindexing
which subtracts the facet-visible denominator exponent and lands in integral Laurent exponents.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

/-- Multiplicative notation for additive nonnegative translation exponent vectors. -/
abbrev TranslationExponent (α : Type*) := Multiplicative (α → ℕ)

/-- Send a translation exponent to the monomial `product_v (x_v+1)^(n_v)`. -/
def translationMonomialHom
    {R α : Type*} [CommRing R] [Fintype α] :
    TranslationExponent α →* MvPolynomial α R where
  toFun n := ∏ v, (X v + 1) ^ (Multiplicative.toAdd n v)
  map_one' := by simp
  map_mul' n m := by
    simp only [toAdd_mul, Pi.add_apply, pow_add,
      Finset.prod_mul_distrib]

/-- The denominator monoid generated by the translation variables `t_v=x_v+1`. -/
def translationSubmonoid
    (R α : Type*) [CommRing R] [Fintype α] :
    Submonoid (MvPolynomial α R) :=
  MonoidHom.mrange (translationMonomialHom (R := R) (α := α))

/-- A chosen exponent vector representing a translation denominator. -/
def translationDenominatorExponent
    {R α : Type*} [CommRing R] [Fintype α]
    (d : translationSubmonoid R α) : α → ℕ :=
  Multiplicative.toAdd (Classical.choose d.2)

/-- The chosen exponent reconstructs its denominator exactly. -/
theorem translationDenominatorExponent_spec
    {R α : Type*} [CommRing R] [Fintype α]
    (d : translationSubmonoid R α) :
    (d : MvPolynomial α R) =
      ∏ v, (X v + 1) ^ (translationDenominatorExponent d v) := by
  exact (Classical.choose_spec d.2).symm

/-- Subtract the facet-visible denominator exponent from a numerator monomial exponent. -/
def facetLaurentExponentShift
    {R α : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    (d : translationSubmonoid R α) (F : Finset α) :
    (α →₀ ℕ) → (α → ℤ) :=
  fun e v => (e v : ℤ) - if v ∈ F then translationDenominatorExponent d v else 0

/-- Dividing by a fixed translation monomial is injective on exponent vectors. -/
theorem facetLaurentExponentShift_injective
    {R α : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    (d : translationSubmonoid R α) (F : Finset α) :
    Function.Injective (facetLaurentExponentShift d F) := by
  intro e f h
  apply Finsupp.ext
  intro v
  have hv := congrFun h v
  dsimp [facetLaurentExponentShift] at hv
  have hv' : (e v : ℤ) = (f v : ℤ) := sub_left_inj.mp hv
  exact Int.ofNat_inj.mp hv'

/-- Reindex a finite facet translation polynomial by the negative denominator exponent. -/
def facetLaurentShift
    {R α : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    (d : translationSubmonoid R α) (F : Finset α)
    (P : MvPolynomial α R) : (α → ℤ) →₀ R :=
  Finsupp.mapDomain (facetLaurentExponentShift d F) P

/-- Laurent denominator reindexing is injective on finite coefficient rows. -/
theorem facetLaurentShift_injective
    {R α : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    (d : translationSubmonoid R α) (F : Finset α) :
    Function.Injective (facetLaurentShift d F) :=
  Finsupp.mapDomain_injective (facetLaurentExponentShift_injective d F)

end

end GaloisForLFunctions.HTGeometry
