import GaloisForLFunctions.HTGeometry.DifferentialMatroidFoundations
import GaloisForLFunctions.HTGeometry.DifferentialExchange
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Differential-matroid closure and Steinitz exchange

`DifferentialMatroidFoundations` proves heredity and finitarity for differential independence,
while `DifferentialExchange` proves the polynomial partial-evaluation mechanism.  This module
connects those two layers at the actual set-valued closure used by a matroid.

The key theorem is `differentialClosure_exchange`: if `x` becomes differentially algebraic after
adjoining `y`, but was not differentially algebraic before, then `y` becomes differentially
algebraic after adjoining `x`.  No exchange hypothesis is packaged as input.
-/

open scoped Classical Differential

namespace GaloisForLFunctions

noncomputable section

/-- The jets of a range are the range of the doubly indexed jet family. -/
theorem differentialJetSet_range_eq
    {K ι : Type*} [CommRing K] [Differential K] (x : ι → K) :
    differentialJetSet (Set.range x) =
      Set.range (fun p : ι × ℕ => differentialJet p.2 (x p.1)) := by
  ext z
  constructor
  · rintro ⟨a, ⟨i, rfl⟩, n, rfl⟩
    exact ⟨(i, n), rfl⟩
  · rintro ⟨⟨i, n⟩, rfl⟩
    exact ⟨x i, ⟨i, rfl⟩, n, rfl⟩

/-- Joint differential independence splits after adjoining the right family. -/
theorem differentialIndependent_sumElim_right_iff
    {k K ι κ : Type*} [Field k] [Field K] [Algebra k K] [Differential K]
    (x : ι → K) (y : κ → K) :
    DifferentialIndependent k (Sum.elim x y) ↔
      DifferentialIndependent k y ∧
        DifferentialIndependent (differentialAdjoin k (Set.range y)) x := by
  unfold DifferentialIndependent
  let e := Equiv.sumProdDistrib ι κ ℕ
  let xj : ι × ℕ → K := fun p => differentialJet p.2 (x p.1)
  let yj : κ × ℕ → K := fun p => differentialJet p.2 (y p.1)
  have hfun :
      (fun p : (ι ⊕ κ) × ℕ => differentialJet p.2 (Sum.elim x y p.1)) =
        (Sum.elim xj yj) ∘ e := by
    funext p
    rcases p with ⟨i | j, n⟩ <;> rfl
  rw [hfun, algebraicIndependent_equiv e]
  rw [AlgebraicIndependent.sumElim_iff]
  change _ ↔ _ ∧ AlgebraicIndependent (differentialAdjoin k (Set.range y)) xj
  rw [differentialAdjoin, differentialJetSet_range_eq]
  exact and_congr_right
    (fun _ => IntermediateField.algebraicIndependent_adjoin_iff.symm)

/-- Differential independence is invariant under a bijective reindexing. -/
theorem differentialIndependent_equiv
    {k K ι κ : Type*} [CommRing k] [CommRing K] [Algebra k K] [Differential K]
    (e : ι ≃ κ) (x : κ → K) :
    DifferentialIndependent k (x ∘ e) ↔ DifferentialIndependent k x := by
  constructor
  · intro h
    have h' := h.comp e.symm e.symm.injective
    simpa [Function.comp_def] using h'
  · intro h
    exact h.comp e e.injective

/-- Adjoining one new set element preserves differential independence exactly when that element
is hypertranscendental over the differential field generated by the old set. -/
theorem diffIndepOn_insert_iff
    {k K : Type*} [Field k] [Field K] [Algebra k K] [Differential K]
    {s : Set K} {x : K} (hx : x ∉ s) :
    DiffIndepOn k (insert x s) ↔
      DiffIndepOn k s ∧
        ¬ DifferentialAlgebraicOver (differentialAdjoin k s) x := by
  classical
  let e : {z // z ∈ insert x s} ≃ Unit ⊕ s :=
    (Set.subtypeInsertEquivOption hx).trans
      ((Equiv.optionEquivSumPUnit.{0} s).trans
        ((Equiv.sumCongr (Equiv.refl s)
          (Equiv.equivPUnit Unit : Unit ≃ PUnit).symm).trans
            (Equiv.sumComm s Unit)))
  have hfamily :
      (Subtype.val : {z // z ∈ insert x s} → K) =
        (Sum.elim (fun _ : Unit => x) (Subtype.val : s → K)) ∘ e := by
    funext z
    by_cases hz : z.1 = x
    · simp [e, Set.subtypeInsertEquivOption, hz]
    · simp [e, Set.subtypeInsertEquivOption, hz]
  unfold DiffIndepOn
  rw [hfamily, differentialIndependent_equiv e,
    differentialIndependent_sumElim_right_iff, Subtype.range_val]
  simp [DifferentialAlgebraicOver]

/-- Differential adjunction by `s` and then by `y` is the same embedded field as adjunction by
`insert y s`. -/
theorem differentialAdjoin_insert
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (s : Set E) (y : E) :
    (differentialAdjoin (differentialAdjoin F s) ({y} : Set E)).restrictScalars F =
      differentialAdjoin F (insert y s) := by
  rw [differentialAdjoin, differentialAdjoin,
    IntermediateField.adjoin_adjoin_left]
  congr 1
  ext z
  constructor
  · rintro (⟨w, hw, n, rfl⟩ | ⟨w, hw, n, rfl⟩)
    · exact ⟨w, Set.mem_insert_of_mem y hw, n, rfl⟩
    · simp only [Set.mem_singleton_iff] at hw
      subst w
      exact ⟨y, Set.mem_insert y s, n, rfl⟩
  · rintro ⟨w, hw, n, rfl⟩
    rcases Set.mem_insert_iff.mp hw with hwy | hws
    · subst w
      exact Set.mem_union_right _ ⟨y, Set.mem_singleton y, n, rfl⟩
    · exact Set.mem_union_left _ ⟨w, hws, n, rfl⟩

/-- Coefficient-field form of `differentialAdjoin_insert`. -/
theorem differentialAlgebraicOver_insert_iff_nested
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (s : Set E) (y x : E) :
    DifferentialAlgebraicOver (differentialAdjoin F (insert y s)) x ↔
      DifferentialAlgebraicOver
        (differentialAdjoin (differentialAdjoin F s) ({y} : Set E)) x := by
  rw [← differentialAdjoin_insert s y]
  rfl

/-- Differential-algebraic closure generated by a set. -/
def differentialClosure
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (s : Set E) : Set E :=
  {x | DifferentialAlgebraicOver (differentialAdjoin F s) x}

/-- Every generator belongs to its differential-algebraic closure. -/
theorem subset_differentialClosure
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (s : Set E) : s ⊆ differentialClosure F s := by
  intro x hx
  let B := differentialAdjoin F s
  let xb : B := ⟨x, subset_differentialAdjoin F s hx⟩
  change DifferentialAlgebraicOver B x
  unfold DifferentialAlgebraicOver
  intro hind
  have htrans : Transcendental B x :=
    hind.algebraicIndependent.transcendental Unit.unit
  apply htrans
  simpa [xb] using (isAlgebraic_algebraMap (R := B) (A := E) xb)

/-- **Differential Steinitz exchange.** If `x` lies in the differential closure after adjoining
`y`, but not in the original differential closure, then `y` lies in the closure after adjoining
`x`.  This is the exchange law itself, derived from the existing partial-evaluation theorem. -/
theorem differentialClosure_exchange
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {s : Set E} {x y : E}
    (hx : x ∈ differentialClosure F (insert y s))
    (hxn : x ∉ differentialClosure F s) :
    y ∈ differentialClosure F (insert x s) := by
  let B := differentialAdjoin F s
  letI : DifferentialAlgebra B E :=
    ⟨fun c => derivationClosedDifferential_apply B
      (derivationClosed_differentialAdjoin F s) c⟩
  have hxBy : DifferentialAlgebraicOver
      (differentialAdjoin B ({y} : Set E)) x := by
    exact (differentialAlgebraicOver_insert_iff_nested s y x).mp hx
  let y1 : Unit → E := fun _ => y
  let x1 : Unit → E := fun _ => x
  have hxDI : DifferentialIndependent B x1 := by
    change ¬ DifferentialAlgebraicOver B x at hxn
    exact Classical.not_not.mp hxn
  have hpairXY : ¬ DifferentialIndependent B (Sum.elim x1 y1) := by
    intro hp
    have hsplit := (differentialIndependent_sumElim_right_iff x1 y1).mp hp
    have hyrange : Set.range y1 = ({y} : Set E) := by
      ext z
      simp [y1]
    rw [hyrange] at hsplit
    apply hxBy
    simpa [x1] using hsplit.2
  have hpair : ¬ DifferentialIndependent B (Sum.elim y1 x1) := by
    intro hp
    have hswap := hp.comp (Equiv.sumComm Unit Unit)
      (Equiv.sumComm Unit Unit).injective
    have heq : (Sum.elim y1 x1) ∘ (Equiv.sumComm Unit Unit) =
        Sum.elim x1 y1 := by
      funext z
      rcases z with u | u <;> rfl
    apply hpairXY
    rw [heq] at hswap
    exact hswap
  have hrelNe : differentialRelationIdeal (C := B) (Sum.elim y1 x1) ≠ ⊥ := by
    intro hbot
    exact hpair ((differentialIndependent_iff_relationIdeal_eq_bot _).mpr hbot)
  have hlt : (⊥ : Ideal (DifferentialPolynomial (Unit ⊕ Unit) B)) <
      differentialRelationIdeal (C := B) (Sum.elim y1 x1) :=
    bot_lt_iff_ne_bot.mpr hrelNe
  obtain ⟨P, hPmem, hPbot⟩ := SetLike.exists_of_lt hlt
  have hP0 : P ≠ 0 := by simpa using hPbot
  have hPeval : differentialPolynomialEval (C := B) (Sum.elim y1 x1) P = 0 :=
    (mem_differentialRelationIdeal_iff _ _).mp hPmem
  have hyNested : DifferentialAlgebraicOver
      (differentialAdjoin B ({x} : Set E)) y := by
    exact differentialExchange y x ⟨P, hP0, hPeval⟩ hxDI
  exact (differentialAlgebraicOver_insert_iff_nested s x y).mpr hyNested

end

end GaloisForLFunctions
