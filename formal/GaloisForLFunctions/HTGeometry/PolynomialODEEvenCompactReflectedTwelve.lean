/-- The normalized polynomial is the full modular reflection jet, with all thirteen Leibniz terms. -/
theorem evenCompactReflectedScalar12_eq (u a w : ℝ) :
    MvPolynomial.eval (oddCompactState u a w) (oddCompactReflectedJetPolynomial 12) =
      (evenCompactReflectedScalar12 u a w : ℂ) := by
  have hf : MvPolynomial.eval (oddCompactState u a w)
      (oddCompactReflectedJetPolynomial 12) =
      ((((((1 : ℝ)*oddCompactSourceScalar0 u a w*evenCompactSourceScalar12 u a w +
    ((-12 : ℝ)*oddCompactSourceScalar1 u a w*evenCompactSourceScalar11 u a w +
    (66 : ℝ)*oddCompactSourceScalar2 u a w*oddCompactSourceScalar10 u a w)) +
    ((-220 : ℝ)*oddCompactSourceScalar3 u a w*oddCompactSourceScalar9 u a w +
    ((495 : ℝ)*oddCompactSourceScalar4 u a w*oddCompactSourceScalar8 u a w +
    (-792 : ℝ)*oddCompactSourceScalar5 u a w*oddCompactSourceScalar7 u a w))) +
    (((924 : ℝ)*oddCompactSourceScalar6 u a w*oddCompactSourceScalar6 u a w +
    ((-792 : ℝ)*oddCompactSourceScalar7 u a w*oddCompactSourceScalar5 u a w +
    (495 : ℝ)*oddCompactSourceScalar8 u a w*oddCompactSourceScalar4 u a w)) +
    (((-220 : ℝ)*oddCompactSourceScalar9 u a w*oddCompactSourceScalar3 u a w +
    (66 : ℝ)*oddCompactSourceScalar10 u a w*oddCompactSourceScalar2 u a w) +
    ((-12 : ℝ)*evenCompactSourceScalar11 u a w*oddCompactSourceScalar1 u a w +
    (1 : ℝ)*evenCompactSourceScalar12 u a w*oddCompactSourceScalar0 u a w)))) : ℝ) : ℂ) := by
    rw [eval_oddCompactReflectedJetPolynomial]
    norm_num only [Finset.sum_range_succ, Finset.sum_empty, Nat.choose, Nat.reduceSub, Nat.reduceAdd]
    simp only [oddCompactSourceScalar0_eq, oddCompactSourceScalar1_eq, oddCompactSourceScalar2_eq, oddCompactSourceScalar3_eq, oddCompactSourceScalar4_eq, oddCompactSourceScalar5_eq, oddCompactSourceScalar6_eq, oddCompactSourceScalar7_eq, oddCompactSourceScalar8_eq, oddCompactSourceScalar9_eq, oddCompactSourceScalar10_eq, evenCompactSourceScalar11_eq, evenCompactSourceScalar12_eq]
    push_cast
    ring
  rw [hf]
  apply congrArg Complex.ofReal
  unfold oddCompactSourceScalar0 oddCompactSourceScalar1 oddCompactSourceScalar2 oddCompactSourceScalar3 oddCompactSourceScalar4 oddCompactSourceScalar5 oddCompactSourceScalar6 oddCompactSourceScalar7 oddCompactSourceScalar8 oddCompactSourceScalar9 oddCompactSourceScalar10 evenCompactSourceScalar11 evenCompactSourceScalar12 evenCompactReflectedScalar12
  ring

