import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaPacketCoface
import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaFacePalette

/-!
# Translation stability of the deeper face field

The descending face-lifting argument works over the differential field generated by all deeper face
packets.  That field must be stable under every structural translation, since the translations are
the automorphisms of the simultaneous telescoping system.  Stability is a consequence of the two
coface facts: a deleted direction preserves a packet, and a surviving direction changes a packet
element by an element of the next packet — so an *upward closed* face family generates a
translation-stable differential field.

* `facePacketUnion` — the union of the packets of a face family;
* **`facePacketUnion_translate_mem`** — the generators move inside the generated field;
* **`differentialAdjoin_facePacketUnion_translate_stable`** — hence the whole generated differential
  field is translation stable.
-/

open Filter Topology Set Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher

noncomputable section

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The union of the packets of a family of deleted faces. -/
def facePacketUnion (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (S : Set (Finset ι)) :
    Set (meroField (Set.univ : Set ℂ)) :=
  ⋃ L ∈ S, multipleEllipticGammaFacePacket τ hτ L

/-- **The generators move inside the generated field.**  A deleted direction preserves the packet;
a surviving direction changes the element by a member of the next packet, which belongs to the
family because it is upward closed. -/
theorem facePacketUnion_translate_mem (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) {S : Set (Finset ι)}
    (q : ι) (hS : ∀ L ∈ S, q ∉ L → insert q L ∈ S)
    {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ facePacketUnion τ hτ S) :
    addTranslationMeroEquiv (τ q) y ∈
      differentialAdjoin ℂ (facePacketUnion τ hτ S) := by
  obtain ⟨L, hL, hyL⟩ := Set.mem_iUnion₂.mp hy
  by_cases hqL : q ∈ L
  · refine subset_differentialAdjoin ℂ _ ?_
    exact Set.mem_iUnion₂.mpr ⟨L, hL, facePacket_translate_mem τ hτ L hqL hyL⟩
  · have hnext : addTranslationMeroEquiv (τ q) y - y ∈
        multipleEllipticGammaFacePacket τ hτ (insert q L) :=
      facePacket_translate_sub_mem τ hτ L hqL hyL
    have hy' : y ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S) :=
      subset_differentialAdjoin ℂ _ (Set.mem_iUnion₂.mpr ⟨L, hL, hyL⟩)
    have hnext' : addTranslationMeroEquiv (τ q) y - y ∈
        differentialAdjoin ℂ (facePacketUnion τ hτ S) :=
      subset_differentialAdjoin ℂ _
        (Set.mem_iUnion₂.mpr ⟨insert q L, hS L hL hqL, hnext⟩)
    have hsum := (differentialAdjoin ℂ (facePacketUnion τ hτ S)).add_mem hnext' hy'
    simpa using hsum

set_option synthInstance.maxHeartbeats 400000 in
/-- **The deeper face field is translation stable.**  Every structural translation maps the
differential field generated by an upward closed family of face packets into itself. -/
theorem differentialAdjoin_facePacketUnion_translate_stable (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (q : ι) (hS : ∀ L ∈ S, q ∉ L → insert q L ∈ S)
    {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)) :
    addTranslationMeroEquiv (τ q) x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S) := by
  classical
  let K := differentialAdjoin ℂ (facePacketUnion τ hτ S)
  have hKclosed : DerivationClosed K :=
    derivationClosed_differentialAdjoin ℂ (facePacketUnion τ hτ S)
  let p : ∀ y : meroField (Set.univ : Set ℂ),
      y ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S) → Prop :=
    fun y _ => addTranslationMeroEquiv (τ q) y ∈ K
  change p x hx
  refine IntermediateField.adjoin_induction ℂ (p := p) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨y₀, hy₀, n, rfl⟩
    have hy₀' : addTranslationMeroEquiv (τ q) y₀ ∈ K :=
      facePacketUnion_translate_mem τ hτ q hS hy₀
    have hjet : addTranslationMeroEquiv (τ q) (differentialJet n y₀) =
        differentialJet n (addTranslationMeroEquiv (τ q) y₀) := by
      simpa using!
        (addTranslationMeroDifferentialAlgEquiv (τ q)).map_differentialJet n y₀
    show addTranslationMeroEquiv (τ q) (differentialJet n y₀) ∈ K
    rw [hjet]
    exact hKclosed.differentialJet_mem hy₀' n
  · intro c
    have : addTranslationMeroEquiv (τ q)
        (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c) =
        algebraMap ℂ (meroField (Set.univ : Set ℂ)) c :=
      addTranslationMeroEquiv_algebraMap_complex (τ q) c
    show addTranslationMeroEquiv (τ q) _ ∈ K
    rw [this]
    exact K.algebraMap_mem c
  · intro y z _ _ hpy hpz
    show addTranslationMeroEquiv (τ q) (y + z) ∈ K
    rw [map_add]
    exact K.add_mem hpy hpz
  · intro y _ hpy
    show addTranslationMeroEquiv (τ q) y⁻¹ ∈ K
    rw [map_inv₀]
    exact K.inv_mem hpy
  · intro y z _ _ hpy hpz
    show addTranslationMeroEquiv (τ q) (y * z) ∈ K
    rw [map_mul]
    exact K.mul_mem hpy hpz

end

end GaloisForLFunctions
