import GaloisForLFunctions.HTGeometry.CenteredCoeffFieldIndependence
import GaloisForLFunctions.HTGeometry.CenteredPolynomialOverCoefficients
import GaloisForLFunctions.HTGeometry.CenteredDiscriminantIdentification
import GaloisForLFunctions.HTGeometry.IrreducibleRadicalTransport
import GaloisForLFunctions.HTGeometry.EisensteinRadical
import GaloisForLFunctions.HTGeometry.RadicalDegreeExact
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

/-!
# The centered coefficient field is a rational function field

The top centered coefficient vanishes, so the coefficient field is generated by the remaining
`d - 1` coefficients, and those are algebraically independent.  Hence it is a rational function
field in `d - 1` variables, the constant coefficient being one of them.

A variable is prime, so a radical polynomial over it is irreducible at every exponent; transporting
that back, a root of the radical polynomial over the constant coefficient generates an extension of
exactly the degree of the radical — the degree input of the base change step.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped IntermediateField

variable {K : Type*} [Field K] [CharZero K] {d : ℕ}

/-! ## The generators -/

theorem centeredCoeff_top_eq_zero (hd : 0 < d) :
    centeredCoeff K d (⟨d - 1, by omega⟩ : Fin d) = 0 :=
  Subtype.ext (coeff_centeredMonicF_pred (by omega))

/-- **The coefficient field is generated by the coefficients below the top one.** -/
theorem adjoin_range_centeredLowCoeffIn (hd : 0 < d) :
    IntermediateField.adjoin K (Set.range (centeredLowCoeffIn K d)) = centeredCoeffField K d := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨k, rfl⟩
    exact IntermediateField.subset_adjoin _ _ ⟨centeredIndex d k, rfl⟩
  · rw [centeredCoeffField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨k, rfl⟩
    by_cases hk : (k : ℕ) = d - 1
    · have hzero : centeredCoeff K d k = 0 := by
        have hk' : k = (⟨d - 1, by omega⟩ : Fin d) := Fin.ext hk
        rw [hk']
        exact centeredCoeff_top_eq_zero hd
      simp only [SetLike.mem_coe, hzero]
      exact zero_mem _
    · have hlt : (k : ℕ) < d - 1 := by
        have := k.isLt
        omega
      refine IntermediateField.subset_adjoin _ _ ⟨⟨(k : ℕ), hlt⟩, ?_⟩
      show centeredCoeff K d (centeredIndex d ⟨(k : ℕ), hlt⟩) = centeredCoeff K d k
      congr 1

/-! ## The rational function model -/

/-- **The centered coefficient field is a rational function field.** -/
noncomputable def centeredCoeffFieldEquiv (K : Type*) [Field K] [CharZero K] (d : ℕ)
    (hd : 0 < d) :
    FractionRing (MvPolynomial (Fin (d - 1)) K) ≃ₐ[K] centeredCoeffField K d :=
  (algebraicIndependent_centeredLowCoeffIn hd).aevalEquivField.trans
    (IntermediateField.equivOfEq (adjoin_range_centeredLowCoeffIn hd))

theorem coe_centeredCoeffFieldEquiv_X (hd : 0 < d) (k : Fin (d - 1)) :
    ((centeredCoeffFieldEquiv K d hd
        (algebraMap (MvPolynomial (Fin (d - 1)) K)
          (FractionRing (MvPolynomial (Fin (d - 1)) K))
          (MvPolynomial.X k)) : centeredCoeffField K d) : centeredField K d) =
      centeredLowCoeffIn K d k := by
  have hcoe : ∀ z : ↥(IntermediateField.adjoin K (Set.range (centeredLowCoeffIn K d))),
      ((IntermediateField.equivOfEq (adjoin_range_centeredLowCoeffIn hd) z :
        centeredCoeffField K d) : centeredField K d) = (z : centeredField K d) := fun _ => rfl
  show ((IntermediateField.equivOfEq (adjoin_range_centeredLowCoeffIn hd)
      ((algebraicIndependent_centeredLowCoeffIn hd).aevalEquivField
        (algebraMap _ _ (MvPolynomial.X k))) : centeredCoeffField K d) :
      centeredField K d) = _
  rw [hcoe, (algebraicIndependent_centeredLowCoeffIn hd).aevalEquivField_algebraMap_apply_coe,
    MvPolynomial.aeval_X]

/-- The constant coefficient is the image of the first variable. -/
theorem centeredCoeffFieldEquiv_zero (hd : 0 < d) (hd1 : 0 < d - 1) :
    centeredCoeffFieldEquiv K d hd
      (algebraMap (MvPolynomial (Fin (d - 1)) K)
        (FractionRing (MvPolynomial (Fin (d - 1)) K))
        (MvPolynomial.X ⟨0, hd1⟩)) = centeredConstant K d hd := by
  refine Subtype.ext ?_
  rw [coe_centeredCoeffFieldEquiv_X hd ⟨0, hd1⟩]
  show centeredCoeff K d (centeredIndex d ⟨0, hd1⟩) = centeredCoeff K d ⟨0, hd⟩
  congr 1

/-! ## The radical polynomial over the constant coefficient -/

/-- **The radical polynomial over the constant coefficient is irreducible.** -/
theorem irreducible_X_pow_sub_C_centeredConstant (hd : 0 < d) (hd1 : 0 < d - 1) {n : ℕ}
    (hn : 0 < n) :
    Irreducible (Polynomial.X ^ n - Polynomial.C (centeredConstant K d hd) :
      Polynomial (centeredCoeffField K d)) := by
  rw [← centeredCoeffFieldEquiv_zero hd hd1]
  exact irreducible_X_pow_sub_C_map (centeredCoeffFieldEquiv K d hd).toRingEquiv
    (irreducible_X_pow_sub_C_of_prime (MvPolynomial.X_prime (i := (⟨0, hd1⟩ : Fin (d - 1)))) hn)

set_option synthInstance.maxHeartbeats 400000 in
/-- **A root of it generates an extension of exactly that degree.** -/
theorem finrank_adjoin_centeredConstant_root {L : Type*} [Field L]
    [Algebra (centeredCoeffField K d) L] (hd : 0 < d) (hd1 : 0 < d - 1) {n : ℕ} (hn : 0 < n)
    {α : L} (hα : α ^ n = algebraMap (centeredCoeffField K d) L (centeredConstant K d hd)) :
    Module.finrank (centeredCoeffField K d) (centeredCoeffField K d)⟮α⟯ = n :=
  finrank_adjoin_of_irreducible hn (irreducible_X_pow_sub_C_centeredConstant hd hd1 hn) hα

end GaloisForLFunctions.HTGeometry
