import GaloisForLFunctions.HTGeometry.DifferentialReesFormationSpectrum
import GaloisForLFunctions.HTGeometry.ConstitutiveInvariantPositivityKMSWall
import GaloisForLFunctions.RHTower.DiagonalEllTwoOperator
import GaloisForLFunctions.HTGeometry.DiagonalCompactOperator
import GaloisForLFunctions.HTGeometry.HilbertSchmidtMatrix

/-!
# Canonical thermal Toeplitz--Rees formation field

Formation number is the unique derivation with value `T - 1` on the augmentation generator, on the
positive Rees algebra generated by that element.  Its grade completion has compact resolvent,
functional-equation parity, Toeplitz creation, and the canonical KMS history mass.  One grade index
therefore reconstructs five previously separate route shadows.

These are the Lean certificates for ULF-TAFM-26.
-/

open scoped LaurentPolynomial Differential ENNReal InnerProductSpace

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open LaurentPolynomial Filter Topology

local notation "FormA" => AugmentationFormationAlgebra

@[simp] theorem formationNumber_add
    (P Q : FormA) :
    formationNumber (P + Q) = formationNumber P + formationNumber Q := by
  simp [formationNumber, mul_add]

@[simp] theorem formationNumber_zero : formationNumber (0 : FormA) = 0 := by
  simp [formationNumber]

@[simp] theorem formationNumber_one : formationNumber (1 : FormA) = 0 := by
  simp [formationNumber]

/-- Formation number is a derivation. -/
theorem formationNumber_mul (P Q : FormA) :
    formationNumber (P * Q) =
      P * formationNumber Q + Q * formationNumber P := by
  rw [formationNumber, laurentFormationDerivative_mul,
    formationNumber, formationNumber]
  ring

@[simp] theorem laurentFormationDerivative_C (z : ℤ) :
    laurentFormationDerivative (C z : FormA) = 0 := by
  calc
    laurentFormationDerivative (C z : FormA) =
        laurentFormationDerivative (C z * T 0) := by simp
    _ = C (0 * z) * T (0 - 1) := laurentFormationDerivative_C_mul_T z 0
    _ = 0 := by simp

@[simp] theorem formationNumber_C (z : ℤ) :
    formationNumber (C z : FormA) = 0 := by
  rw [formationNumber, laurentFormationDerivative_C, mul_zero]

@[simp] theorem formationNumber_augmentationGenerator :
    formationNumber (T 1 - 1 : FormA) = T 1 - 1 := by
  simp [formationNumber]

def formationNumberAddHom : FormA →+ FormA where
  toFun := formationNumber
  map_zero' := formationNumber_zero
  map_add' := formationNumber_add

def formationNumberLinearMap : FormA →ₗ[ℤ] FormA where
  toFun := formationNumber
  map_add' := formationNumber_add
  map_smul' z P := formationNumberAddHom.map_zsmul z P

/-- Canonical derivation carrying the augmentation generator to itself. -/
def formationNumberDerivation : Derivation ℤ FormA FormA :=
  Derivation.mk formationNumberLinearMap formationNumber_one formationNumber_mul

@[simp] theorem formationNumberDerivation_apply (P : FormA) :
    formationNumberDerivation P = formationNumber P := rfl

@[simp] theorem formationNumberDerivation_augmentationGenerator :
    formationNumberDerivation (T 1 - 1 : FormA) = T 1 - 1 :=
  formationNumber_augmentationGenerator

/-- Any derivation carrying the augmentation generator to itself agrees with formation number on
the full positive Rees algebra generated by that element. -/
theorem formationNumber_unique_on_positiveRees
    (D : Derivation ℤ FormA FormA)
    (hD : D (T 1 - 1 : FormA) = T 1 - 1) {P : FormA}
    (hP : P ∈ Algebra.adjoin ℤ ({T 1 - 1} : Set FormA)) :
    D P = formationNumber P := by
  have heq :
      Set.EqOn D formationNumberDerivation ({T 1 - 1} : Set FormA) := by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact hD.trans formationNumberDerivation_augmentationGenerator.symm
  exact D.eqOn_adjoin heq hP

/-- Every positive Rees grade is a pure formation-number eigenvector. -/
theorem formationNumber_augmentationPower (r : ℕ) :
    formationNumber ((T 1 - 1 : FormA) ^ r) =
      (r : FormA) * (T 1 - 1) ^ r := by
  simpa [augmentationFormationBoundary] using formationNumber_boundary r (1 : FormA)

/-- Compact-resolvent multiplier of canonical formation number. -/
def formationResolventMultiplier (n : ℕ) : ℂ :=
  (((n : ℝ) + 1)⁻¹ : ℝ)

theorem norm_formationResolventMultiplier_le_one (n : ℕ) :
    ‖formationResolventMultiplier n‖ ≤ 1 := by
  rw [formationResolventMultiplier, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (inv_nonneg.mpr (by positivity))]
  have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
  have h : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith
  exact inv_le_one_of_one_le₀ h

/-- Bounded inverse `(N+1)⁻¹` on the Hilbert completion of formation grades. -/
def formationResolvent : ToeplitzSpace →L[ℂ] ToeplitzSpace :=
  RHTower.diagonalOperator formationResolventMultiplier
    norm_formationResolventMultiplier_le_one

@[simp] theorem formationResolvent_apply (f : ToeplitzSpace) (n : ℕ) :
    (formationResolvent f : ℕ → ℂ) n = formationResolventMultiplier n * f n := rfl

theorem formationResolvent_lpBasis (n : ℕ) :
    formationResolvent (HilbertSchmidt.lpBasis ℕ n) =
      formationResolventMultiplier n • HilbertSchmidt.lpBasis ℕ n := by
  rw [HilbertSchmidt.lpBasis_apply]
  ext k
  rw [formationResolvent_apply]
  simp only [lp.single_apply, Pi.single_apply]
  by_cases h : k = n
  · subst h
    simp
  · simp [h]

theorem tendsto_norm_formationResolventMultiplier :
    Tendsto (fun n : ℕ => ‖formationResolventMultiplier n‖) atTop (nhds 0) := by
  have h : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (nhds 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  refine h.congr fun n => ?_
  rw [formationResolventMultiplier, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (inv_nonneg.mpr (by positivity)), one_div]

/-- Global formation properness: canonical formation number has compact resolvent. -/
theorem isCompactOperator_formationResolvent :
    IsCompactOperator formationResolvent := by
  refine isCompactOperator_of_diag_tendsto_cofinite
    (HilbertSchmidt.lpBasis ℕ) formationResolvent_lpBasis ?_
  simpa only [Nat.cofinite_eq_atTop] using tendsto_norm_formationResolventMultiplier

/-- Functional-equation parity on the Hilbert completion of formation grades. -/
def formationParityMultiplier (n : ℕ) : ℂ := (-1 : ℂ) ^ n

theorem norm_formationParityMultiplier_le_one (n : ℕ) :
    ‖formationParityMultiplier n‖ ≤ 1 := by
  simp [formationParityMultiplier]

def formationParity : ToeplitzSpace →L[ℂ] ToeplitzSpace :=
  RHTower.diagonalOperator formationParityMultiplier
    norm_formationParityMultiplier_le_one

@[simp] theorem formationParity_apply (f : ToeplitzSpace) (n : ℕ) :
    (formationParity f : ℕ → ℂ) n = formationParityMultiplier n * f n := rfl

/-- Reflection parity is involutive. -/
theorem formationParity_involutive :
    formationParity ∘L formationParity = ContinuousLinearMap.id ℂ ToeplitzSpace := by
  ext f n
  simp only [ContinuousLinearMap.comp_apply, formationParity_apply,
    formationParityMultiplier, ContinuousLinearMap.id_apply]
  have hs : (((-1 : ℂ) ^ n) ^ 2) = 1 := by
    rw [← pow_mul, mul_comm n 2, pow_mul]
    norm_num
  calc
    (-1 : ℂ) ^ n * ((-1 : ℂ) ^ n * f n) =
        (((-1 : ℂ) ^ n) ^ 2) * f n := by ring
    _ = f n := by rw [hs, one_mul]

/-- Reflection parity commutes with formation resolvent. -/
theorem formationParity_commutes_resolvent :
    formationParity ∘L formationResolvent = formationResolvent ∘L formationParity := by
  ext f n
  simp only [ContinuousLinearMap.comp_apply, formationParity_apply,
    formationResolvent_apply]
  ring

/-- Reflection parity reverses one step of open formation history. -/
theorem formationParity_shift_anticommutes :
    formationParity ∘L shiftOp 1 = -(shiftOp 1 ∘L formationParity) := by
  ext f n
  cases n with
  | zero => simp [formationParity_apply, shiftOp_apply, shiftFun]
  | succ n =>
      simp only [ContinuousLinearMap.comp_apply, formationParity_apply,
        shiftOp_apply, shiftFun, Nat.succ_lt_succ_iff, Nat.not_lt_zero,
        ↓reduceIte, Nat.add_sub_cancel, neg_apply]
      change (-1 : ℂ) ^ (n + 1) * f n = -((-1 : ℂ) ^ n * f n)
      rw [pow_succ]
      ring

/-- One intrinsic grade simultaneously controls formation energy, Hilbert resolvent, Hilbert and
Laurent reflection parity, normalized thermal mass, and Toeplitz defect rank. -/
theorem canonicalThermalRees_jointSpectrum
    {q : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (n : ℕ) :
    formationNumber ((T 1 - 1 : FormA) ^ n) =
        (n : FormA) * (T 1 - 1) ^ n ∧
      formationResolvent (basisVec n) =
        formationResolventMultiplier n • basisVec n ∧
      formationParity (basisVec n) =
        formationParityMultiplier n • basisVec n ∧
      SameModuloAugmentationBoundary (n + 1)
        (invert (augmentationFormationBoundary n (1 : FormA)))
        ((-1 : FormA) ^ n * augmentationFormationBoundary n (1 : FormA)) ∧
      toeplitzGibbsState q 1 = 1 ∧
      toeplitzGibbsState q (historyLayer n) =
        (1 - (q : ℂ)) * (q : ℂ) ^ n ∧
      Module.finrank ℂ (defectSubmodule n) = n ∧
      IsCompactOperator formationResolvent := by
  refine ⟨formationNumber_augmentationPower n, ?_, ?_,
    augmentationReflection_associatedGraded_parity n (1 : FormA),
    toeplitzGibbsState_one hq0.le hq1,
    toeplitzGibbsState_layer q n, finrank_defectSubmodule n,
    isCompactOperator_formationResolvent⟩
  · rw [formationResolvent, basisVec, RHTower.diagonalOperator_single]
    ext k
    by_cases h : k = n
    · subst h
      simp [lp.single_apply]
    · simp [lp.single_apply, h]
  · rw [formationParity, basisVec, RHTower.diagonalOperator_single]
    ext k
    by_cases h : k = n
    · subst h
      simp [lp.single_apply]
    · simp [lp.single_apply, h]

end

end GaloisForLFunctions.HTGeometry
