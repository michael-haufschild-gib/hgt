import GaloisForLFunctions.HTGeometry.FixedActionC5JacobianGermAnalyticClosure

open scoped BigOperators ContDiff

namespace HTGeometry

noncomputable section

/-- A real germ equality propagates through every iterated derivative. -/
theorem eventuallyEq_iteratedDeriv_real
    {f g : ℝ → ℝ} {x : ℝ} (h : f =ᶠ[nhds x] g) (n : ℕ) :
    iteratedDeriv n f =ᶠ[nhds x] iteratedDeriv n g := by
  induction n with
  | zero => simpa [iteratedDeriv_zero] using h
  | succ n ih =>
      rw [iteratedDeriv_succ, iteratedDeriv_succ]
      exact ih.deriv

/-- Iterated real derivatives commute with a positive translation for smooth functions. -/
theorem iteratedDeriv_comp_const_add_real
    (f : ℝ → ℝ) (hf : ContDiff ℝ ∞ f) :
    ∀ (n : ℕ) (u t : ℝ),
      iteratedDeriv n (fun x => f (u + x)) t = iteratedDeriv n f (u + t) := by
  intro n
  induction n generalizing f with
  | zero => intro u t; simp [iteratedDeriv_zero]
  | succ n ih =>
      intro u t
      rw [iteratedDeriv_succ', iteratedDeriv_succ']
      have hd : deriv (fun x => f (u + x)) = fun x => deriv f (u + x) := by
        funext x
        have hinner : HasDerivAt (fun x : ℝ => u + x) 1 x := by
          simpa using (hasDerivAt_id x).const_add u
        have hcomp := (hf.differentiable (by simp)).differentiableAt.hasDerivAt.comp x hinner
        simpa [Function.comp_def] using hcomp.deriv
      rw [hd]
      exact ih (f := deriv f) hf.deriv' u t

/-- Reflection multiplies the `n`th real jet by `(-1)^n`. -/
theorem iteratedDeriv_comp_const_sub_real
    (f : ℝ → ℝ) (hf : ContDiff ℝ ∞ f) :
    ∀ (n : ℕ) (u t : ℝ),
      iteratedDeriv n (fun x => f (u - x)) t =
        (-1 : ℝ) ^ n * iteratedDeriv n f (u - t) := by
  intro n
  induction n generalizing f with
  | zero => intro u t; simp [iteratedDeriv_zero]
  | succ n ih =>
      intro u t
      rw [iteratedDeriv_succ', iteratedDeriv_succ']
      have hd : deriv (fun x => f (u - x)) = fun x => -deriv f (u - x) := by
        funext x
        have hinner : HasDerivAt (fun x : ℝ => u - x) (-1) x := by
          simpa using (hasDerivAt_id x).const_sub u
        have hcomp := (hf.differentiable (by simp)).differentiableAt.hasDerivAt.comp x hinner
        simpa [Function.comp_def] using hcomp.deriv
      rw [hd, show (fun x => -deriv f (u - x)) =
        -(fun x => deriv f (u - x)) by rfl,
        iteratedDeriv_neg, ih (f := deriv f) hf.deriv']
      ring

def c5FirstShiftedFaceGerm
    (a b s m da db ds dm dq : ℝ → ℝ) (t : ℝ) : ℝ :=
  let H₀ := a t * (t * m t) - (a t + t * b t) * s t
  let H₁ := da t * (t * m t) + a t * (t * dm t) -
    (da t + t * db t) * s t - (a t + t * b t) * ds t
  (t * da t) * H₀ + (t * a t) * H₁ - dq t * ((t * a t) * H₀)

/-- First shifted face generated by an atom potential `f` and likelihood potential `g`. -/
def c5FirstShiftedFacePotentialGerm
    (f g : ℝ → ℝ) (u t : ℝ) : ℝ :=
  c5FirstShiftedFaceGerm
    (fun x => iteratedDeriv 1 f (u - x) - iteratedDeriv 1 f (u + x))
    (fun x => -iteratedDeriv 2 f (u + x) - iteratedDeriv 2 f (u - x))
    (fun x => 2 * iteratedDeriv 1 f u - iteratedDeriv 1 f (u + x) -
      iteratedDeriv 1 f (u - x))
    (fun x => iteratedDeriv 2 f (u - x) - iteratedDeriv 2 f (u + x))
    (fun x => iteratedDeriv 1 g (u - x) - iteratedDeriv 1 g (u + x))
    (fun x => -iteratedDeriv 2 g (u + x) - iteratedDeriv 2 g (u - x))
    (fun x => 2 * iteratedDeriv 1 g u - iteratedDeriv 1 g (u + x) -
      iteratedDeriv 1 g (u - x))
    (fun x => iteratedDeriv 2 g (u - x) - iteratedDeriv 2 g (u + x))
    (fun x => 2 * g u - g (u + x) - g (u - x)) t

/-- Smooth potentials generate a globally smooth first shifted-face germ. -/
theorem contDiff_c5FirstShiftedFacePotentialGerm
    (f g : ℝ → ℝ) (u : ℝ) (hf : ContDiff ℝ ∞ f) (hg : ContDiff ℝ ∞ g) :
    ContDiff ℝ ∞ (c5FirstShiftedFacePotentialGerm f g u) := by
  have hfj (n : ℕ) : ContDiff ℝ ∞ (iteratedDeriv n f) :=
    contDiff_top_iteratedDeriv_real f hf n
  have hgj (n : ℕ) : ContDiff ℝ ∞ (iteratedDeriv n g) :=
    contDiff_top_iteratedDeriv_real g hg n
  unfold c5FirstShiftedFacePotentialGerm c5FirstShiftedFaceGerm
  fun_prop

theorem c5FirstShiftedFaceGerm_seamJetClassification
    (a b s m da db ds dm dq : ℝ → ℝ)
    (ha : ContDiffAt ℝ ∞ a 0) (hb : ContDiffAt ℝ ∞ b 0)
    (hs : ContDiffAt ℝ ∞ s 0) (hm : ContDiffAt ℝ ∞ m 0)
    (hda : ContDiffAt ℝ ∞ da 0) (hdb : ContDiffAt ℝ ∞ db 0)
    (hds : ContDiffAt ℝ ∞ ds 0) (hdm : ContDiffAt ℝ ∞ dm 0)
    (hdq : ContDiffAt ℝ ∞ dq 0)
    (a₁ a₃ s₂ s₄ d₁ d₃ e₂ e₄ : ℝ)
    (ha0 : iteratedDeriv 0 a 0 = 0)
    (ha1 : iteratedDeriv 1 a 0 = a₁)
    (ha2 : iteratedDeriv 2 a 0 = 0)
    (ha3 : iteratedDeriv 3 a 0 = a₃)
    (hb0 : iteratedDeriv 0 b 0 = a₁)
    (hb1 : iteratedDeriv 1 b 0 = 0)
    (hb2 : iteratedDeriv 2 b 0 = a₃)
    (hs0 : iteratedDeriv 0 s 0 = 0)
    (hs1 : iteratedDeriv 1 s 0 = 0)
    (hs2 : iteratedDeriv 2 s 0 = s₂)
    (hs3 : iteratedDeriv 3 s 0 = 0)
    (hs4 : iteratedDeriv 4 s 0 = s₄)
    (hm0 : iteratedDeriv 0 m 0 = 0)
    (hm1 : iteratedDeriv 1 m 0 = s₂)
    (hm2 : iteratedDeriv 2 m 0 = 0)
    (hm3 : iteratedDeriv 3 m 0 = s₄)
    (hda0 : iteratedDeriv 0 da 0 = 0)
    (hda1 : iteratedDeriv 1 da 0 = d₁)
    (hda2 : iteratedDeriv 2 da 0 = 0)
    (hda3 : iteratedDeriv 3 da 0 = d₃)
    (hdb0 : iteratedDeriv 0 db 0 = d₁)
    (hdb1 : iteratedDeriv 1 db 0 = 0)
    (hdb2 : iteratedDeriv 2 db 0 = d₃)
    (hds0 : iteratedDeriv 0 ds 0 = 0)
    (hds1 : iteratedDeriv 1 ds 0 = 0)
    (hds2 : iteratedDeriv 2 ds 0 = e₂)
    (hds3 : iteratedDeriv 3 ds 0 = 0)
    (hds4 : iteratedDeriv 4 ds 0 = e₄)
    (hdm0 : iteratedDeriv 0 dm 0 = 0)
    (hdm1 : iteratedDeriv 1 dm 0 = e₂)
    (hdm2 : iteratedDeriv 2 dm 0 = 0)
    (hdm3 : iteratedDeriv 3 dm 0 = e₄)
    (hdq0 : iteratedDeriv 0 dq 0 = 0) :
    (∀ k < 7, iteratedDeriv k
        (c5FirstShiftedFaceGerm a b s m da db ds dm dq) 0 = 0) ∧
      iteratedDeriv 7 (c5FirstShiftedFaceGerm a b s m da db ds dm dq) 0 =
        420 * (2 * a₁ * d₁ * s₄ - 2 * d₁ * a₃ * s₂ +
          a₁ ^ 2 * e₄ - 2 * a₁ * d₃ * s₂ - 2 * a₁ * a₃ * e₂) := by
  let x : ℝ → ℝ := id
  let H₀ : ℝ → ℝ := fun t =>
    a t * (x t * m t) - (a t + x t * b t) * s t
  let H₁ : ℝ → ℝ := fun t =>
    da t * (x t * m t) + a t * (x t * dm t) -
      (da t + x t * db t) * s t - (a t + x t * b t) * ds t
  let P₀ : ℝ → ℝ := fun t => (x t * a t) * H₀ t
  let G : ℝ → ℝ := fun t =>
    (x t * da t) * H₀ t + (x t * a t) * H₁ t - dq t * P₀ t
  have hx : ContDiffAt ℝ ∞ x 0 := by
    simpa only [x] using (contDiffAt_id : ContDiffAt ℝ ∞ (id : ℝ → ℝ) 0)
  have hH₀ : ContDiffAt ℝ ∞ H₀ 0 := by dsimp only [H₀]; fun_prop
  have hH₁ : ContDiffAt ℝ ∞ H₁ 0 := by dsimp only [H₁]; fun_prop
  have hP₀ : ContDiffAt ℝ ∞ P₀ 0 := by dsimp only [P₀]; fun_prop
  have hG : ContDiffAt ℝ ∞ G 0 := by dsimp only [G]; fun_prop
  have hmul (f g : ℝ → ℝ) (hf : ContDiffAt ℝ ∞ f 0)
      (hg : ContDiffAt ℝ ∞ g 0) (k : ℕ) :
      iteratedDeriv k (fun t => f t * g t) 0 =
        realScalarJetConvolution
          (fun j => iteratedDeriv j f 0) (fun j => iteratedDeriv j g 0) k := by
    exact iteratedDeriv_mul_eq_realScalarJetConvolution
      (hf.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
      (hg.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
  have hadd (f g : ℝ → ℝ) (hf : ContDiffAt ℝ ∞ f 0)
      (hg : ContDiffAt ℝ ∞ g 0) (k : ℕ) :
      iteratedDeriv k (fun t => f t + g t) 0 =
        iteratedDeriv k f 0 + iteratedDeriv k g 0 :=
    iteratedDeriv_add
      (hf.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
      (hg.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
  have hsub (f g : ℝ → ℝ) (hf : ContDiffAt ℝ ∞ f 0)
      (hg : ContDiffAt ℝ ∞ g 0) (k : ℕ) :
      iteratedDeriv k (fun t => f t - g t) 0 =
        iteratedDeriv k f 0 - iteratedDeriv k g 0 :=
    iteratedDeriv_sub
      (hf.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
      (hg.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
  have hxj (k : ℕ) : iteratedDeriv k x 0 = realScalarJetId k := by
    rcases k with _ | _ | k <;> simp [x, realScalarJetId, iteratedDeriv_id]
  have hxmulj (f : ℝ → ℝ) (hf : ContDiffAt ℝ ∞ f 0) (k : ℕ) :
      iteratedDeriv k (fun t => x t * f t) 0 =
        realScalarJetConvolution realScalarJetId
          (fun j => iteratedDeriv j f 0) k := by
    rw [hmul x f hx hf k]
    simp only [hxj]
  have habj (k : ℕ) : iteratedDeriv k (fun t => a t + x t * b t) 0 =
      iteratedDeriv k a 0 + realScalarJetConvolution realScalarJetId
        (fun j => iteratedDeriv j b 0) k := by
    rw [hadd a (fun t => x t * b t) ha (hx.mul hb) k, hxmulj b hb k]
  have hdabj (k : ℕ) : iteratedDeriv k (fun t => da t + x t * db t) 0 =
      iteratedDeriv k da 0 + realScalarJetConvolution realScalarJetId
        (fun j => iteratedDeriv j db 0) k := by
    rw [hadd da (fun t => x t * db t) hda (hx.mul hdb) k, hxmulj db hdb k]
  have hxm0 : iteratedDeriv 0 (fun t => x t * m t) 0 = 0 := by
    rw [hxmulj m hm]
    norm_num [realScalarJetConvolution, realScalarJetId, hm0]
  have hxm1 : iteratedDeriv 1 (fun t => x t * m t) 0 = 0 := by
    rw [hxmulj m hm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hm0]
  have hxm2 : iteratedDeriv 2 (fun t => x t * m t) 0 = 2 * s₂ := by
    rw [hxmulj m hm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hm0, hm1]
  have hxm3 : iteratedDeriv 3 (fun t => x t * m t) 0 = 0 := by
    rw [hxmulj m hm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hm0, hm1, hm2]
  have hxm4 : iteratedDeriv 4 (fun t => x t * m t) 0 = 4 * s₄ := by
    rw [hxmulj m hm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hm0, hm1, hm2, hm3]
  have hxdm0 : iteratedDeriv 0 (fun t => x t * dm t) 0 = 0 := by
    rw [hxmulj dm hdm]
    norm_num [realScalarJetConvolution, realScalarJetId, hdm0]
  have hxdm1 : iteratedDeriv 1 (fun t => x t * dm t) 0 = 0 := by
    rw [hxmulj dm hdm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hdm0]
  have hxdm2 : iteratedDeriv 2 (fun t => x t * dm t) 0 = 2 * e₂ := by
    rw [hxmulj dm hdm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hdm0, hdm1]
  have hxdm3 : iteratedDeriv 3 (fun t => x t * dm t) 0 = 0 := by
    rw [hxmulj dm hdm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hdm0, hdm1, hdm2]
  have hxdm4 : iteratedDeriv 4 (fun t => x t * dm t) 0 = 4 * e₄ := by
    rw [hxmulj dm hdm]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hdm0, hdm1, hdm2, hdm3]
  have hxa0 : iteratedDeriv 0 (fun t => x t * a t) 0 = 0 := by
    rw [hxmulj a ha]
    norm_num [realScalarJetConvolution, realScalarJetId, ha0]
  have hxa1 : iteratedDeriv 1 (fun t => x t * a t) 0 = 0 := by
    rw [hxmulj a ha]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, ha0]
  have hxa2 : iteratedDeriv 2 (fun t => x t * a t) 0 = 2 * a₁ := by
    rw [hxmulj a ha]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, ha0, ha1]
  have hxda0 : iteratedDeriv 0 (fun t => x t * da t) 0 = 0 := by
    rw [hxmulj da hda]
    norm_num [realScalarJetConvolution, realScalarJetId, hda0]
  have hxda1 : iteratedDeriv 1 (fun t => x t * da t) 0 = 0 := by
    rw [hxmulj da hda]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hda0]
  have hxda2 : iteratedDeriv 2 (fun t => x t * da t) 0 = 2 * d₁ := by
    rw [hxmulj da hda]
    norm_num [realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, hda0, hda1]
  have hH₀j (k : ℕ) : iteratedDeriv k H₀ 0 =
      realScalarJetConvolution (fun j => iteratedDeriv j a 0)
          (fun j => iteratedDeriv j (fun t => x t * m t) 0) k -
        realScalarJetConvolution
          (fun j => iteratedDeriv j (fun t => a t + x t * b t) 0)
          (fun j => iteratedDeriv j s 0) k := by
    rw [show iteratedDeriv k H₀ 0 = iteratedDeriv k
      (fun t => a t * (x t * m t) - (a t + x t * b t) * s t) 0 by rfl,
      hsub _ _ (ha.mul (hx.mul hm)) ((ha.add (hx.mul hb)).mul hs) k,
      hmul a _ ha (hx.mul hm) k, hmul _ s (ha.add (hx.mul hb)) hs k]
  have hH₁j (k : ℕ) : iteratedDeriv k H₁ 0 =
      realScalarJetConvolution (fun j => iteratedDeriv j da 0)
          (fun j => iteratedDeriv j (fun t => x t * m t) 0) k +
        realScalarJetConvolution (fun j => iteratedDeriv j a 0)
          (fun j => iteratedDeriv j (fun t => x t * dm t) 0) k -
        realScalarJetConvolution
          (fun j => iteratedDeriv j (fun t => da t + x t * db t) 0)
          (fun j => iteratedDeriv j s 0) k -
        realScalarJetConvolution
          (fun j => iteratedDeriv j (fun t => a t + x t * b t) 0)
          (fun j => iteratedDeriv j ds 0) k := by
    rw [show iteratedDeriv k H₁ 0 = iteratedDeriv k
      (fun t => da t * (x t * m t) + a t * (x t * dm t) -
        (da t + x t * db t) * s t - (a t + x t * b t) * ds t) 0 by rfl,
      hsub _ _ (((hda.mul (hx.mul hm)).add (ha.mul (hx.mul hdm))).sub
        ((hda.add (hx.mul hdb)).mul hs)) ((ha.add (hx.mul hb)).mul hds) k,
      hsub _ _ ((hda.mul (hx.mul hm)).add (ha.mul (hx.mul hdm)))
        ((hda.add (hx.mul hdb)).mul hs) k,
      hadd _ _ (hda.mul (hx.mul hm)) (ha.mul (hx.mul hdm)) k,
      hmul da _ hda (hx.mul hm) k, hmul a _ ha (hx.mul hdm) k,
      hmul _ s (hda.add (hx.mul hdb)) hs k,
      hmul _ ds (ha.add (hx.mul hb)) hds k]
  have hH₀zero (k : ℕ) (hk : k < 5) : iteratedDeriv k H₀ 0 = 0 := by
    interval_cases k <;>
      norm_num [hH₀j, habj, hxm0, hxm1, hxm2, hxm3, hxm4,
        realScalarJetConvolution, realScalarJetId,
        Finset.sum_range_succ, Nat.choose, ha0, ha1, ha2, ha3, hb0, hb1, hb2,
        hs0, hs1, hs2, hs3, hs4, hm0, hm1, hm2, hm3]; ring
  have hH₀five : iteratedDeriv 5 H₀ 0 = 10 * (a₁ * s₄ - 2 * a₃ * s₂) := by
    rw [hH₀j]
    norm_num [habj, hxm0, hxm1, hxm2, hxm3, hxm4,
      realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose, ha0, ha1, ha2, ha3, hb0, hb1, hb2,
      hs0, hs1, hs2, hs3, hs4, hm0, hm1, hm2, hm3]
    ring
  have hH₁zero (k : ℕ) (hk : k < 5) : iteratedDeriv k H₁ 0 = 0 := by
    interval_cases k <;>
      norm_num [hH₁j, hxm0, hxm1, hxm2, hxm3, hxm4,
        hxdm0, hxdm1, hxdm2, hxdm3, hxdm4, habj, hdabj, realScalarJetConvolution,
        realScalarJetId, Finset.sum_range_succ, Nat.choose,
        ha0, ha1, ha2, ha3, hb0, hb1, hb2, hs0, hs1, hs2, hs3, hs4,
        hm0, hm1, hm2, hm3, hda0, hda1, hda2, hda3, hdb0, hdb1, hdb2,
        hds0, hds1, hds2, hds3, hds4, hdm0, hdm1, hdm2, hdm3]; ring
  have hH₁five : iteratedDeriv 5 H₁ 0 =
      10 * (d₁ * s₄ + a₁ * e₄ - 2 * d₃ * s₂ - 2 * a₃ * e₂) := by
    rw [hH₁j]
    norm_num [hxm0, hxm1, hxm2, hxm3, hxm4,
      hxdm0, hxdm1, hxdm2, hxdm3, hxdm4, habj, hdabj,
      realScalarJetConvolution, realScalarJetId,
      Finset.sum_range_succ, Nat.choose,
      ha0, ha1, ha2, ha3, hb0, hb1, hb2, hs0, hs1, hs2, hs3, hs4,
      hm0, hm1, hm2, hm3, hda0, hda1, hda2, hda3, hdb0, hdb1, hdb2,
      hds0, hds1, hds2, hds3, hds4, hdm0, hdm1, hdm2, hdm3]
    ring
  have hP₀j (k : ℕ) : iteratedDeriv k P₀ 0 =
      realScalarJetConvolution
        (fun j => iteratedDeriv j (fun t => x t * a t) 0)
        (fun j => iteratedDeriv j H₀ 0) k := by
    rw [show iteratedDeriv k P₀ 0 = iteratedDeriv k
      (fun t => (x t * a t) * H₀ t) 0 by rfl,
      hmul _ H₀ (hx.mul ha) hH₀ k]
  have hP₀zero (k : ℕ) (hk : k < 7) : iteratedDeriv k P₀ 0 = 0 := by
    rw [hP₀j]
    interval_cases k <;>
      norm_num [realScalarJetConvolution, realScalarJetId, Finset.sum_range_succ,
        Nat.choose, hxa0, hxa1, hH₀zero]
  have hGj (k : ℕ) : iteratedDeriv k G 0 =
      realScalarJetConvolution
          (fun j => iteratedDeriv j (fun t => x t * da t) 0)
          (fun j => iteratedDeriv j H₀ 0) k +
        realScalarJetConvolution
          (fun j => iteratedDeriv j (fun t => x t * a t) 0)
          (fun j => iteratedDeriv j H₁ 0) k -
        realScalarJetConvolution (fun j => iteratedDeriv j dq 0)
          (fun j => iteratedDeriv j P₀ 0) k := by
    rw [show iteratedDeriv k G 0 = iteratedDeriv k
      (fun t => (x t * da t) * H₀ t + (x t * a t) * H₁ t - dq t * P₀ t) 0 by rfl,
      hsub _ _ (((hx.mul hda).mul hH₀).add ((hx.mul ha).mul hH₁))
        (hdq.mul hP₀) k,
      hadd _ _ ((hx.mul hda).mul hH₀) ((hx.mul ha).mul hH₁) k,
      hmul _ H₀ (hx.mul hda) hH₀ k, hmul _ H₁ (hx.mul ha) hH₁ k,
      hmul dq P₀ hdq hP₀ k]
  have hGzero (k : ℕ) (hk : k < 7) : iteratedDeriv k G 0 = 0 := by
    rw [hGj]
    interval_cases k <;>
      norm_num [realScalarJetConvolution, realScalarJetId, Finset.sum_range_succ,
        Nat.choose, hxa0, hxa1, hxda0, hxda1,
        hH₀zero, hH₁zero, hP₀zero]
  have hGseven : iteratedDeriv 7 G 0 =
      420 * (2 * a₁ * d₁ * s₄ - 2 * d₁ * a₃ * s₂ +
        a₁ ^ 2 * e₄ - 2 * a₁ * d₃ * s₂ - 2 * a₁ * a₃ * e₂) := by
    rw [hGj]
    norm_num [realScalarJetConvolution, realScalarJetId, Finset.sum_range_succ,
      Nat.choose, ha0, ha1, hda0, hda1, hdq0,
      hxa0, hxa1, hxa2, hxda0, hxda1, hxda2,
      hH₀zero, hH₀five, hH₁zero, hH₁five, hP₀zero]
    ring
  have hdef : c5FirstShiftedFaceGerm a b s m da db ds dm dq = G := by
    funext t
    simp only [c5FirstShiftedFaceGerm, G, H₀, H₁, P₀, x, id_eq]
  rw [hdef]
  exact ⟨hGzero, hGseven⟩

/-- Exact seventh-order obstruction of the potential-generated first shifted face. -/
theorem c5FirstShiftedFacePotentialGerm_seamJetClassification
    (f g : ℝ → ℝ) (u : ℝ) (hf : ContDiff ℝ ∞ f) (hg : ContDiff ℝ ∞ g) :
    (∀ k < 7, iteratedDeriv k (c5FirstShiftedFacePotentialGerm f g u) 0 = 0) ∧
      iteratedDeriv 7 (c5FirstShiftedFacePotentialGerm f g u) 0 =
        3360 *
          (iteratedDeriv 2 g u *
              (2 * (-iteratedDeriv 3 f u) * (-iteratedDeriv 4 f u) -
                (-iteratedDeriv 2 f u) * (-iteratedDeriv 5 f u)) -
            (-iteratedDeriv 2 f u) *
              (-2 * iteratedDeriv 3 g u * (-iteratedDeriv 4 f u) -
                2 * (-iteratedDeriv 3 f u) * iteratedDeriv 4 g u +
                (-iteratedDeriv 2 f u) * iteratedDeriv 5 g u +
                iteratedDeriv 2 g u * (-iteratedDeriv 5 f u))) := by
  let a : ℝ → ℝ := fun x => iteratedDeriv 1 f (u - x) - iteratedDeriv 1 f (u + x)
  let b : ℝ → ℝ := fun x => -iteratedDeriv 2 f (u + x) - iteratedDeriv 2 f (u - x)
  let s : ℝ → ℝ := fun x => 2 * iteratedDeriv 1 f u - iteratedDeriv 1 f (u + x) -
    iteratedDeriv 1 f (u - x)
  let m : ℝ → ℝ := fun x => iteratedDeriv 2 f (u - x) - iteratedDeriv 2 f (u + x)
  let da : ℝ → ℝ := fun x => iteratedDeriv 1 g (u - x) - iteratedDeriv 1 g (u + x)
  let db : ℝ → ℝ := fun x => -iteratedDeriv 2 g (u + x) - iteratedDeriv 2 g (u - x)
  let ds : ℝ → ℝ := fun x => 2 * iteratedDeriv 1 g u - iteratedDeriv 1 g (u + x) -
    iteratedDeriv 1 g (u - x)
  let dm : ℝ → ℝ := fun x => iteratedDeriv 2 g (u - x) - iteratedDeriv 2 g (u + x)
  let dq : ℝ → ℝ := fun x => 2 * g u - g (u + x) - g (u - x)
  have hfj (n : ℕ) : ContDiff ℝ ∞ (iteratedDeriv n f) :=
    contDiff_top_iteratedDeriv_real f hf n
  have hgj (n : ℕ) : ContDiff ℝ ∞ (iteratedDeriv n g) :=
    contDiff_top_iteratedDeriv_real g hg n
  have ha : ContDiffAt ℝ ∞ a 0 := by dsimp only [a]; fun_prop
  have hb : ContDiffAt ℝ ∞ b 0 := by dsimp only [b]; fun_prop
  have hs : ContDiffAt ℝ ∞ s 0 := by dsimp only [s]; fun_prop
  have hm : ContDiffAt ℝ ∞ m 0 := by dsimp only [m]; fun_prop
  have hda : ContDiffAt ℝ ∞ da 0 := by dsimp only [da]; fun_prop
  have hdb : ContDiffAt ℝ ∞ db 0 := by dsimp only [db]; fun_prop
  have hds : ContDiffAt ℝ ∞ ds 0 := by dsimp only [ds]; fun_prop
  have hdm : ContDiffAt ℝ ∞ dm 0 := by dsimp only [dm]; fun_prop
  have hdq : ContDiffAt ℝ ∞ dq 0 := by dsimp only [dq]; fun_prop
  have hplus (h : ℝ → ℝ) (hh : ContDiff ℝ ∞ h) (n k : ℕ) :
      iteratedDeriv k (fun x => iteratedDeriv n h (u + x)) 0 =
        iteratedDeriv (n + k) h u := by
    rw [iteratedDeriv_comp_const_add_real _
      (contDiff_top_iteratedDeriv_real h hh n) k u 0]
    rw [← congrFun (iteratedDeriv_iteratedDeriv_real h n k) u]
    simp
  have hminus (h : ℝ → ℝ) (hh : ContDiff ℝ ∞ h) (n k : ℕ) :
      iteratedDeriv k (fun x => iteratedDeriv n h (u - x)) 0 =
        (-1 : ℝ) ^ k * iteratedDeriv (n + k) h u := by
    rw [iteratedDeriv_comp_const_sub_real _
      (contDiff_top_iteratedDeriv_real h hh n) k u 0]
    rw [← congrFun (iteratedDeriv_iteratedDeriv_real h n k) u]
    simp
  have hodd (h : ℝ → ℝ) (hh : ContDiff ℝ ∞ h) (n k : ℕ) :
      iteratedDeriv k
          (fun x => iteratedDeriv n h (u - x) - iteratedDeriv n h (u + x)) 0 =
        (((-1 : ℝ) ^ k) - 1) * iteratedDeriv (n + k) h u := by
    let fm : ℝ → ℝ := fun x => iteratedDeriv n h (u - x)
    let fp : ℝ → ℝ := fun x => iteratedDeriv n h (u + x)
    have hfm : ContDiff ℝ ∞ fm := by
      dsimp only [fm]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.sub contDiff_id)
    have hfp : ContDiff ℝ ∞ fp := by
      dsimp only [fp]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.add contDiff_id)
    change iteratedDeriv k (fm - fp) 0 = _
    rw [iteratedDeriv_sub
      (hfm.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
      (hfp.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))]
    change iteratedDeriv k (fun x => iteratedDeriv n h (u - x)) 0 -
      iteratedDeriv k (fun x => iteratedDeriv n h (u + x)) 0 = _
    rw [hminus h hh n k, hplus h hh n k]
    ring
  have hnegEven (h : ℝ → ℝ) (hh : ContDiff ℝ ∞ h) (n k : ℕ) :
      iteratedDeriv k
          (fun x => -iteratedDeriv n h (u + x) - iteratedDeriv n h (u - x)) 0 =
        -(1 + (-1 : ℝ) ^ k) * iteratedDeriv (n + k) h u := by
    let fp : ℝ → ℝ := fun x => iteratedDeriv n h (u + x)
    let fm : ℝ → ℝ := fun x => iteratedDeriv n h (u - x)
    have hfp : ContDiff ℝ ∞ fp := by
      dsimp only [fp]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.add contDiff_id)
    have hfm : ContDiff ℝ ∞ fm := by
      dsimp only [fm]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.sub contDiff_id)
    rw [show (fun x => -iteratedDeriv n h (u + x) - iteratedDeriv n h (u - x)) =
        -(fp + fm) by funext x; simp only [Pi.neg_apply, Pi.add_apply, fp, fm]; ring,
      iteratedDeriv_neg,
      iteratedDeriv_add
        (hfp.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
        (hfm.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))]
    change -(iteratedDeriv k (fun x => iteratedDeriv n h (u + x)) 0 +
      iteratedDeriv k (fun x => iteratedDeriv n h (u - x)) 0) = _
    rw [hplus h hh n k, hminus h hh n k]
    ring
  have hcenter (h : ℝ → ℝ) (hh : ContDiff ℝ ∞ h) (n k : ℕ) (hk : 0 < k) :
      iteratedDeriv k
          (fun x => 2 * iteratedDeriv n h u - iteratedDeriv n h (u + x) -
            iteratedDeriv n h (u - x)) 0 =
        -(1 + (-1 : ℝ) ^ k) * iteratedDeriv (n + k) h u := by
    let fc : ℝ → ℝ := fun _ => 2 * iteratedDeriv n h u
    let fp : ℝ → ℝ := fun x => iteratedDeriv n h (u + x)
    let fm : ℝ → ℝ := fun x => iteratedDeriv n h (u - x)
    have hfc : ContDiff ℝ ∞ fc := by dsimp only [fc]; fun_prop
    have hfp : ContDiff ℝ ∞ fp := by
      dsimp only [fp]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.add contDiff_id)
    have hfm : ContDiff ℝ ∞ fm := by
      dsimp only [fm]
      exact (contDiff_top_iteratedDeriv_real h hh n).comp
        (contDiff_const.sub contDiff_id)
    rw [show (fun x => 2 * iteratedDeriv n h u - iteratedDeriv n h (u + x) -
          iteratedDeriv n h (u - x)) = fc - (fp + fm) by
        funext x; simp only [Pi.sub_apply, Pi.add_apply, fc, fp, fm]; ring]
    change iteratedDeriv k (fun x => fc x - (fp x + fm x)) 0 = _
    have hsub : iteratedDeriv k (fun x => fc x - (fp x + fm x)) 0 =
        iteratedDeriv k fc 0 - iteratedDeriv k (fun x => fp x + fm x) 0 :=
      iteratedDeriv_sub
        (hfc.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
        ((hfp.add hfm).contDiffAt.of_le
          (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
    have hadd : iteratedDeriv k (fun x => fp x + fm x) 0 =
        iteratedDeriv k fp 0 + iteratedDeriv k fm 0 :=
      iteratedDeriv_add
        (hfp.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
        (hfm.contDiffAt.of_le (by exact_mod_cast (le_top : ((k : ℕ) : ℕ∞) ≤ ⊤)))
    rw [hsub, hadd]
    change iteratedDeriv k (fun _ : ℝ => 2 * iteratedDeriv n h u) 0 -
      (iteratedDeriv k (fun x => iteratedDeriv n h (u + x)) 0 +
        iteratedDeriv k (fun x => iteratedDeriv n h (u - x)) 0) = _
    have hconst : iteratedDeriv k (fun _ : ℝ => 2 * iteratedDeriv n h u) 0 = 0 := by
      rcases k with _ | k
      · omega
      · simp [iteratedDeriv_succ']
    rw [hconst, hplus h hh n k, hminus h hh n k]
    ring
  have ha0 : iteratedDeriv 0 a 0 = 0 := by simp [a, iteratedDeriv_zero]
  have ha1 : iteratedDeriv 1 a 0 = -2 * iteratedDeriv 2 f u := by
    convert hodd f hf 1 1 using 1
    all_goals norm_num [a]
  have ha2 : iteratedDeriv 2 a 0 = 0 := by
    convert hodd f hf 1 2 using 1
    all_goals norm_num [a]
  have ha3 : iteratedDeriv 3 a 0 = -2 * iteratedDeriv 4 f u := by
    convert hodd f hf 1 3 using 1
    all_goals norm_num [a]
  have hb0 : iteratedDeriv 0 b 0 = -2 * iteratedDeriv 2 f u := by
    simp [b, iteratedDeriv_zero]; ring
  have hb1 : iteratedDeriv 1 b 0 = 0 := by
    convert hnegEven f hf 2 1 using 1
    all_goals norm_num [b]
  have hb2 : iteratedDeriv 2 b 0 = -2 * iteratedDeriv 4 f u := by
    convert hnegEven f hf 2 2 using 1
    all_goals norm_num [b]
  have hs0 : iteratedDeriv 0 s 0 = 0 := by simp [s, iteratedDeriv_zero]; ring
  have hs1 : iteratedDeriv 1 s 0 = 0 := by
    convert hcenter f hf 1 1 (by norm_num) using 1
    all_goals norm_num [s]
  have hs2 : iteratedDeriv 2 s 0 = -2 * iteratedDeriv 3 f u := by
    convert hcenter f hf 1 2 (by norm_num) using 1
    all_goals norm_num [s]
  have hs3 : iteratedDeriv 3 s 0 = 0 := by
    convert hcenter f hf 1 3 (by norm_num) using 1
    all_goals norm_num [s]
  have hs4 : iteratedDeriv 4 s 0 = -2 * iteratedDeriv 5 f u := by
    convert hcenter f hf 1 4 (by norm_num) using 1
    all_goals norm_num [s]
  have hm0 : iteratedDeriv 0 m 0 = 0 := by simp [m, iteratedDeriv_zero]
  have hm1 : iteratedDeriv 1 m 0 = -2 * iteratedDeriv 3 f u := by
    convert hodd f hf 2 1 using 1
    all_goals norm_num [m]
  have hm2 : iteratedDeriv 2 m 0 = 0 := by
    convert hodd f hf 2 2 using 1
    all_goals norm_num [m]
  have hm3 : iteratedDeriv 3 m 0 = -2 * iteratedDeriv 5 f u := by
    convert hodd f hf 2 3 using 1
    all_goals norm_num [m]
  have hda0 : iteratedDeriv 0 da 0 = 0 := by simp [da, iteratedDeriv_zero]
  have hda1 : iteratedDeriv 1 da 0 = -2 * iteratedDeriv 2 g u := by
    convert hodd g hg 1 1 using 1
    all_goals norm_num [da]
  have hda2 : iteratedDeriv 2 da 0 = 0 := by
    convert hodd g hg 1 2 using 1
    all_goals norm_num [da]
  have hda3 : iteratedDeriv 3 da 0 = -2 * iteratedDeriv 4 g u := by
    convert hodd g hg 1 3 using 1
    all_goals norm_num [da]
  have hdb0 : iteratedDeriv 0 db 0 = -2 * iteratedDeriv 2 g u := by
    simp [db, iteratedDeriv_zero]; ring
  have hdb1 : iteratedDeriv 1 db 0 = 0 := by
    convert hnegEven g hg 2 1 using 1
    all_goals norm_num [db]
  have hdb2 : iteratedDeriv 2 db 0 = -2 * iteratedDeriv 4 g u := by
    convert hnegEven g hg 2 2 using 1
    all_goals norm_num [db]
  have hds0 : iteratedDeriv 0 ds 0 = 0 := by simp [ds, iteratedDeriv_zero]; ring
  have hds1 : iteratedDeriv 1 ds 0 = 0 := by
    convert hcenter g hg 1 1 (by norm_num) using 1
    all_goals norm_num [ds]
  have hds2 : iteratedDeriv 2 ds 0 = -2 * iteratedDeriv 3 g u := by
    convert hcenter g hg 1 2 (by norm_num) using 1
    all_goals norm_num [ds]
  have hds3 : iteratedDeriv 3 ds 0 = 0 := by
    convert hcenter g hg 1 3 (by norm_num) using 1
    all_goals norm_num [ds]
  have hds4 : iteratedDeriv 4 ds 0 = -2 * iteratedDeriv 5 g u := by
    convert hcenter g hg 1 4 (by norm_num) using 1
    all_goals norm_num [ds]
  have hdm0 : iteratedDeriv 0 dm 0 = 0 := by simp [dm, iteratedDeriv_zero]
  have hdm1 : iteratedDeriv 1 dm 0 = -2 * iteratedDeriv 3 g u := by
    convert hodd g hg 2 1 using 1
    all_goals norm_num [dm]
  have hdm2 : iteratedDeriv 2 dm 0 = 0 := by
    convert hodd g hg 2 2 using 1
    all_goals norm_num [dm]
  have hdm3 : iteratedDeriv 3 dm 0 = -2 * iteratedDeriv 5 g u := by
    convert hodd g hg 2 3 using 1
    all_goals norm_num [dm]
  have hdq0 : iteratedDeriv 0 dq 0 = 0 := by
    simp [dq, iteratedDeriv_zero]; ring
  have hmain := c5FirstShiftedFaceGerm_seamJetClassification
    a b s m da db ds dm dq ha hb hs hm hda hdb hds hdm hdq
    (-2 * iteratedDeriv 2 f u) (-2 * iteratedDeriv 4 f u)
    (-2 * iteratedDeriv 3 f u) (-2 * iteratedDeriv 5 f u)
    (-2 * iteratedDeriv 2 g u) (-2 * iteratedDeriv 4 g u)
    (-2 * iteratedDeriv 3 g u) (-2 * iteratedDeriv 5 g u)
    ha0 ha1 ha2 ha3 hb0 hb1 hb2 hs0 hs1 hs2 hs3 hs4 hm0 hm1 hm2 hm3
    hda0 hda1 hda2 hda3 hdb0 hdb1 hdb2 hds0 hds1 hds2 hds3 hds4
    hdm0 hdm1 hdm2 hdm3 hdq0
  have hdef : c5FirstShiftedFacePotentialGerm f g u =
      c5FirstShiftedFaceGerm a b s m da db ds dm dq := by
    funext x
    rfl
  rw [hdef]
  constructor
  · exact hmain.1
  · rw [hmain.2]
    ring

end

end HTGeometry
