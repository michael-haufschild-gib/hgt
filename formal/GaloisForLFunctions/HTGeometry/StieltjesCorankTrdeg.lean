import Mathlib
import GaloisForLFunctions.HTGeometry.SymmetricBlockAlgebraicIndependence

/-!
# The Laurent coefficients of a finite Euler truncation and the multiplier-log field

`f1-inversion-single-prime-stieltjes-collapse`, §2 and §2′.

For a finite multiplier system with logarithms `L₁, …, L_r` the truncated Euler zeta

```text
ζ_S(s) = ∏ᵢ 1/(1 - e^{-s Lᵢ}) = (1/(s^r ∏ᵢ Lᵢ)) · ∑ₖ aₖ sᵏ,
aₖ = ∑_{k₁+…+k_r=k} ∏ᵢ B⁺_{kᵢ} Lᵢ^{kᵢ} / kᵢ!
```

has Laurent coefficients `aₖ / ∏ᵢ Lᵢ`.  This module works with the exact algebraic content:

* `stieltjesVal` — the Laurent coefficient values at a multiplier-log family;
* `stieltjesField_le_logField` — every Laurent coefficient lies in `ℚ(L₁,…,L_r)`;
* `stieltjesVal_single` — the exact corank-one formula `aₖ/L = B⁺ₖ L^{k-1}/k!`;
* `logField_le_stieltjesField_single`, `stieltjesField_single_eq` — for one multiplier the two
  fields are *equal*, so their transcendence degrees agree: the corank-one collapse.
-/

open Algebra

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- The value of the `k`-th Laurent block coefficient at a multiplier-log family. -/
def blockCoeffVal {r : ℕ} (L : Fin r → ℝ) (k : ℕ) : ℝ :=
  MvPolynomial.aeval L (PowerSeries.coeff k (beurlingBlock r))

/-- The `k`-th Laurent coefficient of the truncated Euler zeta at a multiplier-log family. -/
def stieltjesVal {r : ℕ} (L : Fin r → ℝ) (k : ℕ) : ℝ :=
  blockCoeffVal L k / ∏ i, L i

/-- The field generated by the multiplier logs. -/
def logField {r : ℕ} (L : Fin r → ℝ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ (Set.range L)

/-- The field generated by the Laurent coefficients. -/
def stieltjesField {r : ℕ} (L : Fin r → ℝ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ (Set.range (stieltjesVal L))

theorem mem_logField {r : ℕ} (L : Fin r → ℝ) (i : Fin r) : L i ∈ logField L :=
  IntermediateField.subset_adjoin ℚ _ ⟨i, rfl⟩

theorem blockCoeffVal_mem_logField {r : ℕ} (L : Fin r → ℝ) (k : ℕ) :
    blockCoeffVal L k ∈ logField L := by
  rw [blockCoeffVal]
  set p : MvPolynomial (Fin r) ℚ := PowerSeries.coeff k (beurlingBlock r) with hp
  have hmem : ∀ i : Fin r, L i ∈ logField L := mem_logField L
  -- evaluation of a polynomial at members of a subfield stays in the subfield
  have hmain : ∀ q : MvPolynomial (Fin r) ℚ,
      MvPolynomial.aeval L q ∈ (logField L).toSubalgebra := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C c =>
        rw [MvPolynomial.aeval_C]
        exact (logField L).toSubalgebra.algebraMap_mem c
    | add q₁ q₂ h₁ h₂ =>
        rw [map_add]
        exact Subalgebra.add_mem _ h₁ h₂
    | mul_X q i h =>
        rw [map_mul, MvPolynomial.aeval_X]
        exact Subalgebra.mul_mem _ h (hmem i)
  exact hmain p

theorem prod_mem_logField {r : ℕ} (L : Fin r → ℝ) : (∏ i, L i) ∈ logField L :=
  Subalgebra.prod_mem _ (fun i _ => mem_logField L i)

theorem stieltjesVal_mem_logField {r : ℕ} (L : Fin r → ℝ) (k : ℕ) :
    stieltjesVal L k ∈ logField L := by
  rw [stieltjesVal, div_eq_mul_inv]
  exact (logField L).mul_mem (blockCoeffVal_mem_logField L k)
    ((logField L).inv_mem (prod_mem_logField L))

/-- **The Laurent coefficients lie in the multiplier-log field.** -/
theorem stieltjesField_le_logField {r : ℕ} (L : Fin r → ℝ) :
    stieltjesField L ≤ logField L := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro x ⟨k, rfl⟩
  exact stieltjesVal_mem_logField L k

/-! ## The corank-one collapse -/

theorem beurlingBlock_one_coeff (k : ℕ) :
    PowerSeries.coeff k (beurlingBlock 1)
      = MvPolynomial.C (bernoulli' k / (k.factorial : ℚ)) * (MvPolynomial.X 0) ^ k := by
  rw [beurlingBlock, symmetricBlock, Fin.prod_univ_one, scaledFactor, PowerSeries.coeff_mk]

theorem blockCoeffVal_single (ℓ : ℝ) (k : ℕ) :
    blockCoeffVal (fun _ : Fin 1 => ℓ) k = (bernoulli' k / (k.factorial : ℚ) : ℚ) * ℓ ^ k := by
  rw [blockCoeffVal, beurlingBlock_one_coeff k, map_mul, map_pow, MvPolynomial.aeval_C,
    MvPolynomial.aeval_X]
  norm_num

/-- **The exact corank-one Laurent formula.**  `γ_k = B⁺_k L^{k-1}/k!`. -/
theorem stieltjesVal_single {ℓ : ℝ} (hℓ : ℓ ≠ 0) (k : ℕ) :
    stieltjesVal (fun _ : Fin 1 => ℓ) k
      = ((bernoulli' k / (k.factorial : ℚ) : ℚ) : ℝ) * ℓ ^ k / ℓ := by
  rw [stieltjesVal, blockCoeffVal_single]
  congr 1
  simp

theorem stieltjesVal_single_two {ℓ : ℝ} (hℓ : ℓ ≠ 0) :
    stieltjesVal (fun _ : Fin 1 => ℓ) 2 = ℓ / 12 := by
  rw [stieltjesVal_single hℓ 2, bernoulli'_two]
  norm_num
  field_simp

/-- **The corank-one collapse.**  For a single multiplier the Laurent coefficients generate the
whole multiplier-log field. -/
theorem logField_le_stieltjesField_single {ℓ : ℝ} (hℓ : ℓ ≠ 0) :
    logField (fun _ : Fin 1 => ℓ) ≤ stieltjesField (fun _ : Fin 1 => ℓ) := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro x ⟨i, rfl⟩
  have hmem : stieltjesVal (fun _ : Fin 1 => ℓ) 2 ∈ stieltjesField (fun _ : Fin 1 => ℓ) :=
    IntermediateField.subset_adjoin ℚ _ ⟨2, rfl⟩
  have h12 : ((12 : ℚ) : ℝ) ∈ stieltjesField (fun _ : Fin 1 => ℓ) := by
    have h := (stieltjesField (fun _ : Fin 1 => ℓ)).algebraMap_mem (12 : ℚ)
    simp at h
    simpa using h
  have hx : (fun _ : Fin 1 => ℓ) i = ((12 : ℚ) : ℝ) * stieltjesVal (fun _ : Fin 1 => ℓ) 2 := by
    rw [stieltjesVal_single_two hℓ]
    push_cast
    ring
  rw [hx]
  exact (stieltjesField (fun _ : Fin 1 => ℓ)).mul_mem h12 hmem

/-- **Equality of the two fields in the corank-one case.** -/
theorem stieltjesField_single_eq {ℓ : ℝ} (hℓ : ℓ ≠ 0) :
    stieltjesField (fun _ : Fin 1 => ℓ) = logField (fun _ : Fin 1 => ℓ) :=
  le_antisymm (stieltjesField_le_logField _) (logField_le_stieltjesField_single hℓ)

/-- **The corank-one transcendence-degree identity.**  With one multiplier the transcendence degree
of the Laurent-coefficient field equals that of the multiplier-log field — so a single Frobenius
collapses the Stieltjes transcendence degree to the transcendence degree of one logarithm. -/
theorem trdeg_stieltjesField_single {ℓ : ℝ} (hℓ : ℓ ≠ 0) :
    Algebra.trdeg ℚ (stieltjesField (fun _ : Fin 1 => ℓ))
      = Algebra.trdeg ℚ (logField (fun _ : Fin 1 => ℓ)) := by
  rw [stieltjesField_single_eq hℓ]

end GaloisForLFunctions.HTGeometry
