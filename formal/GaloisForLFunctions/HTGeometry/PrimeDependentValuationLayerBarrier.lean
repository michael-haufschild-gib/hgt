import GaloisForLFunctions.HTGeometry.PrimeClockAnalyticEulerCompletion
import GaloisForLFunctions.HTGeometry.UpperEndRationalCoordinateDifferentialAdjoin

/-!
# Prime-dependent sources across the complete valuation-layer boundary

The scalar completion boundary compares a replicated profile `(p, e) ↦ u e` with the differential
field generated by every prime-zeta dilation.  A general arithmetic source is not replicated: its
prime-power coordinate `(p, e) ↦ f (p ^ (e + 1))` may depend on the prime ray.

This module removes the replication hypothesis.  Only one arithmetic condition survives: the
source must have infinitely many valuation layers on which it is nowhere vanishing.  At any such
layer outside the finitely many layers used by a proposed relation, every old layer profile is
zero while the new source is a nowhere-zero common weight, so the entire clock jet of the new
source is annihilated first and the old layers are separated afterwards.  This is a strict
triangular refinement of the diagonal leading-echelon law, which cannot see a source that is
active on every layer at once.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Filter Set

noncomputable section

local instance primeDependentLayerUpperEndDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance primeDependentLayerUpperEndComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance primeDependentLayerUpperEndDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

/-- At one valuation layer, a finite rotated-log jet packet weighted by a nowhere-vanishing
prime factor is still independent modulo finite prime rays.  Dividing by the weight reduces to
the pure clock-power statement. -/
theorem primePowerLayerJetCoefficients_eq_zero
    (e m : Nat) (w : Nat.Primes → ℂ) (hw : ∀ p, w p ≠ 0)
    (c : Fin (m + 1) → ℂ)
    (hfin : {p : Nat.Primes |
        ∑ k : Fin (m + 1), c k *
          (rotatedPrimePowerClockWeight (p, e) ^ (k : Nat) * w p) ≠ 0}.Finite) :
    c = 0 := by
  classical
  have hbase := primePowerRotatedLogPowers_tailCoefficientIndependent e m
  have hweighted := (tailCoefficientIndependent_commonWeight_iff
      (fun k : Fin (m + 1) => fun p : Nat.Primes =>
        ((((e + 1 : Nat) : ℂ) * rotatedPrimeLogClock p) ^ (k : Nat))) w hw).mpr hbase
  apply hweighted c
  have hset : {p : Nat.Primes |
      ∑ k : Fin (m + 1), c k *
        (w p * ((((e + 1 : Nat) : ℂ) * rotatedPrimeLogClock p) ^ (k : Nat))) ≠ 0} =
      {p : Nat.Primes |
        ∑ k : Fin (m + 1), c k *
          (rotatedPrimePowerClockWeight (p, e) ^ (k : Nat) * w p) ≠ 0} := by
    ext p
    simp only [Set.mem_setOf_eq,
      rotatedPrimePowerClockWeight_eq_valuation_mul_primeLog]
    have hsum : (∑ k : Fin (m + 1), c k *
        (w p * ((((e + 1 : Nat) : ℂ) * rotatedPrimeLogClock p) ^ (k : Nat)))) =
        ∑ k : Fin (m + 1), c k *
          (((((e + 1 : Nat) : ℂ) * rotatedPrimeLogClock p) ^ (k : Nat)) * w p) := by
      apply Finset.sum_congr rfl
      intro k _
      ring
    rw [hsum]
  rw [hset]
  exact hfin

/-- Reading a clock-local finite jet combination at one fixed valuation layer leaves only
finitely many active prime rays. -/
theorem primeProfileJetCombination_layer_finite
    {I : Type*} [Fintype I] (G : I → ArithmeticFunction ℂ) (m : Nat)
    (c : I × Fin (m + 1) → ℂ)
    (hlocal : PrimePowerClockLocal
      (primePowerCoordinateProfile (∑ col, c col • primeProfileJetSource G m col)))
    (e : Nat) :
    {p : Nat.Primes |
      ∑ col : I × Fin (m + 1), c col *
        (rotatedPrimePowerClockWeight (p, e) ^ (col.2 : Nat) *
          primePowerCoordinateProfile (G col.1) (p, e)) ≠ 0}.Finite := by
  classical
  apply hlocal.subset
  intro p hp
  refine ⟨(p, e), rfl, ?_⟩
  let ev : ArithmeticFunction ℂ →+ ℂ :=
    { toFun := fun g => primePowerCoordinateProfile g (p, e)
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  rw [show primePowerCoordinateProfile
      (∑ col, c col • primeProfileJetSource G m col) (p, e) =
      ∑ col, primePowerCoordinateProfile
        (c col • primeProfileJetSource G m col) (p, e) from
    map_sum ev _ Finset.univ]
  simpa only [primePowerCoordinateProfile_smul, primeProfileJetSource,
    primePowerCoordinateProfile_primeProfileRotatedLogJet] using! hp

/-- The prime-power coordinate profile of an arbitrary source is its value on the corresponding
prime power. -/
theorem primePowerCoordinateProfile_apply_eq
    (f : ArithmeticFunction ℂ) (p : Nat.Primes) (e : Nat) :
    primePowerCoordinateProfile f (p, e) = f ((p : Nat) ^ (e + 1)) := by
  simp [primePowerCoordinateProfile]

/-- **Triangular valuation-layer clock law.**  A source that is nowhere vanishing on one
valuation layer avoided by a finite family of distinct scalar valuation layers has its complete
polynomial clock orbit free over that family.  No hypothesis is placed on the behaviour of the
new source at the layers actually used. -/
theorem primeProfileClockIndependent_newSource_valuationLayers
    {H : Type*} [Fintype H] [DecidableEq H]
    (f : ArithmeticFunction ℂ)
    (idx : H → Nat) (hidx : Function.Injective idx)
    (e₀ : Nat) (he₀ : ∀ z : H, idx z ≠ e₀)
    (hf₀ : ∀ p : Nat.Primes, f ((p : Nat) ^ (e₀ + 1)) ≠ 0) :
    PrimeProfileClockIndependent
      (Sum.elim (fun _ : Unit => f)
        (fun z : H => scalarReplicatedPrimeProfile
          (scalarValuationBasisProfile (idx z)))) := by
  classical
  set G : Unit ⊕ H → ArithmeticFunction ℂ :=
    Sum.elim (fun _ : Unit => f)
      (fun z : H => scalarReplicatedPrimeProfile
        (scalarValuationBasisProfile (idx z))) with hGdef
  have hprofile : ∀ (z : H) (p : Nat.Primes) (e : Nat),
      primePowerCoordinateProfile (G (Sum.inr z)) (p, e) =
        (if e = idx z then (1 : ℂ) else 0) := by
    intro z p e
    rw [hGdef]
    simp [scalarValuationBasisProfile,
      primePowerCoordinateProfile_scalarReplicatedPrimeProfile
        (scalarValuationBasisProfile (idx z)) (p, e)]
  have hnew : ∀ (p : Nat.Primes) (e : Nat),
      primePowerCoordinateProfile (G (Sum.inl ())) (p, e) =
        f ((p : Nat) ^ (e + 1)) := by
    intro p e
    rw [hGdef]
    exact primePowerCoordinateProfile_apply_eq f p e
  rw [primeProfileClockIndependent_iff_finiteTailIndependent]
  intro m c hlocal
  change PrimePowerClockLocal
    (primePowerCoordinateProfile
      (∑ col, c col • primeProfileJetSource G m col)) at hlocal
  -- Step 1: the avoided layer annihilates the entire clock jet of the new source.
  have hnewzero : ∀ k : Fin (m + 1), c (Sum.inl (), k) = 0 := by
    have hfin := primeProfileJetCombination_layer_finite G m c hlocal e₀
    have hreduce : ∀ p : Nat.Primes,
        (∑ col : (Unit ⊕ H) × Fin (m + 1), c col *
          (rotatedPrimePowerClockWeight (p, e₀) ^ (col.2 : Nat) *
            primePowerCoordinateProfile (G col.1) (p, e₀))) =
          ∑ k : Fin (m + 1), c (Sum.inl (), k) *
            (rotatedPrimePowerClockWeight (p, e₀) ^ (k : Nat) *
              f ((p : Nat) ^ (e₀ + 1))) := by
      intro p
      rw [Fintype.sum_prod_type, Fintype.sum_sum_type]
      have hright : ∀ z : H,
          (∑ k : Fin (m + 1), c (Sum.inr z, k) *
            (rotatedPrimePowerClockWeight (p, e₀) ^ (k : Nat) *
              primePowerCoordinateProfile (G (Sum.inr z)) (p, e₀))) = 0 := by
        intro z
        apply Finset.sum_eq_zero
        intro k _
        rw [hprofile z p e₀, if_neg (fun h => he₀ z h.symm)]
        ring
      simp only [hright, Finset.sum_const_zero, add_zero,
        Finset.univ_unique, Finset.sum_singleton, hnew]
    have hfin' : {p : Nat.Primes |
        ∑ k : Fin (m + 1), c (Sum.inl (), k) *
          (rotatedPrimePowerClockWeight (p, e₀) ^ (k : Nat) *
            f ((p : Nat) ^ (e₀ + 1))) ≠ 0}.Finite := by
      apply hfin.subset
      intro p hp
      simp only [Set.mem_setOf_eq] at hp ⊢
      rw [hreduce p]
      exact hp
    have := primePowerLayerJetCoefficients_eq_zero e₀ m
      (fun p => f ((p : Nat) ^ (e₀ + 1))) hf₀
      (fun k => c (Sum.inl (), k)) hfin'
    intro k
    exact congrFun this k
  -- Step 2: each remaining layer separates by its own private valuation coordinate.
  have holdzero : ∀ (z : H) (k : Fin (m + 1)), c (Sum.inr z, k) = 0 := by
    intro z
    have hfin := primeProfileJetCombination_layer_finite G m c hlocal (idx z)
    have hreduce : ∀ p : Nat.Primes,
        (∑ col : (Unit ⊕ H) × Fin (m + 1), c col *
          (rotatedPrimePowerClockWeight (p, idx z) ^ (col.2 : Nat) *
            primePowerCoordinateProfile (G col.1) (p, idx z))) =
          ∑ k : Fin (m + 1), c (Sum.inr z, k) *
            (rotatedPrimePowerClockWeight (p, idx z) ^ (k : Nat) * (1 : ℂ)) := by
      intro p
      rw [Fintype.sum_prod_type, Fintype.sum_sum_type]
      have hleft : (∑ k : Fin (m + 1), c (Sum.inl (), k) *
          (rotatedPrimePowerClockWeight (p, idx z) ^ (k : Nat) *
            primePowerCoordinateProfile (G (Sum.inl ())) (p, idx z))) = 0 := by
        apply Finset.sum_eq_zero
        intro k _
        rw [hnewzero k, zero_mul]
      rw [Finset.univ_unique, Finset.sum_singleton, hleft, zero_add]
      rw [Finset.sum_eq_single z]
      · apply Finset.sum_congr rfl
        intro k _
        rw [hprofile z p (idx z), if_pos rfl]
      · intro y _ hy
        apply Finset.sum_eq_zero
        intro k _
        rw [hprofile y p (idx z), if_neg (fun h => hy (hidx h.symm))]
        ring
      · intro hz
        exact absurd (Finset.mem_univ z) hz
    have hfin' : {p : Nat.Primes |
        ∑ k : Fin (m + 1), c (Sum.inr z, k) *
          (rotatedPrimePowerClockWeight (p, idx z) ^ (k : Nat) * (1 : ℂ)) ≠ 0}.Finite := by
      apply hfin.subset
      intro p hp
      simp only [Set.mem_setOf_eq] at hp ⊢
      rw [hreduce p]
      exact hp
    have := primePowerLayerJetCoefficients_eq_zero (idx z) m
      (fun _ => (1 : ℂ)) (fun _ => one_ne_zero)
      (fun k => c (Sum.inr z, k)) hfin'
    intro k
    exact congrFun this k
  funext col
  obtain ⟨i, k⟩ := col
  rcases i with u | z
  · cases u
    exact hnewzero k
  · exact holdzero z k

/-- A finite-abscissa source with infinitely many nowhere-vanishing valuation layers always
supplies a layer avoiding any prescribed finite set of layers. -/
theorem exists_nonvanishing_layer_notMem
    (f : ArithmeticFunction ℂ)
    (hinf : ¬ {e : Nat | ∀ p : Nat.Primes, f ((p : Nat) ^ (e + 1)) ≠ 0}.Finite)
    (used : Finset Nat) :
    ∃ e₀ : Nat, (∀ p : Nat.Primes, f ((p : Nat) ^ (e₀ + 1)) ≠ 0) ∧ e₀ ∉ used := by
  by_contra hnone
  push Not at hnone
  apply hinf
  apply used.finite_toSet.subset
  intro e he
  exact Finset.mem_coe.mpr (hnone e he)

/-- **Analytic prime-dependent completion barrier.**  A finite-abscissa arithmetic source
supported on positive prime powers, nowhere vanishing on infinitely many valuation layers, has
an actual upper-end meromorphic carrier that is differentially independent over the single field
generated by the genuine coordinate and every prime-zeta dilation at once. -/
theorem analyticPrimeProfileCarrier_differentialIndependent_over_all_valuationLayers
    (F : finiteAbscissaArithmeticSubalgebra)
    (hsupport : PrimeProfileSupportedOnPositivePrimePowers F.1)
    (hinf : ¬ {e : Nat | ∀ p : Nat.Primes, F.1 ((p : Nat) ^ (e + 1)) ≠ 0}.Finite) :
    GaloisForLFunctions.DifferentialIndependent
      analyticScalarValuationLayerDifferentialField
      (fun _ : Unit => finiteAbscissaLSeriesToUpperEndMero F) := by
  classical
  let y : upperEndMeroField := finiteAbscissaLSeriesToUpperEndMero F
  let G : Set upperEndMeroField := Set.range analyticScalarValuationLayerCarrier
  have hstages : ∀ G₀ : Set upperEndMeroField,
      G₀ ⊆ G → G₀.Finite →
        GaloisForLFunctions.DiffIndepOn
          (GaloisForLFunctions.differentialAdjoin
            upperEndRationalCoordinateField G₀)
          ({y} : Set upperEndMeroField) := by
    intro G₀ hG₀ hfinite
    letI : Fintype G₀ := hfinite.fintype
    letI : DecidableEq G₀ := Classical.decEq G₀
    choose idx hidxCarrier using fun z : G₀ ↦ hG₀ z.2
    have hidx : Function.Injective idx := by
      intro z w hzw
      apply Subtype.ext
      rw [← hidxCarrier z, ← hidxCarrier w, hzw]
    obtain ⟨e₀, he₀nonzero, he₀used⟩ :=
      exists_nonvanishing_layer_notMem F.1 hinf (Finset.univ.image idx)
    have he₀ : ∀ z : G₀, idx z ≠ e₀ := by
      intro z hz
      exact he₀used (Finset.mem_image.mpr ⟨z, Finset.mem_univ z, hz⟩)
    let sources : Unit ⊕ G₀ → finiteAbscissaArithmeticSubalgebra :=
      Sum.elim (fun _ : Unit ↦ F)
        (fun z : G₀ ↦ boundedScalarReplicatedFiniteAbscissa
          (scalarValuationBasisProfile (idx z)) 1
          (scalarValuationBasisProfile_norm_le_one (idx z)))
    have hsourceSupport : ∀ i,
        PrimeProfileSupportedOnPositivePrimePowers (sources i).1 := by
      intro i
      rcases i with u | z
      · exact hsupport
      · exact scalarReplicatedPrimeProfile_supportedOnPositivePrimePowers _
    have hclock : PrimeProfileClockIndependent (fun i ↦ (sources i).1) := by
      have hfamily : (fun i ↦ (sources i).1) =
          Sum.elim (fun _ : Unit ↦ F.1)
            (fun z : G₀ ↦ scalarReplicatedPrimeProfile
              (scalarValuationBasisProfile (idx z))) := by
        funext i
        rcases i with u | z <;> rfl
      rw [hfamily]
      exact primeProfileClockIndependent_newSource_valuationLayers
        F.1 idx hidx e₀ he₀ he₀nonzero
    have hcombined :=
      differentialIndependent_finiteAbscissaPrimeProfiles_of_clockIndependent
        sources hsourceSupport hclock
    have hfamily :
        (fun i ↦ finiteAbscissaLSeriesToUpperEndMero (sources i)) =
          Sum.elim (fun _ : Unit ↦ y) (fun z : G₀ ↦ z.1) := by
      funext i
      rcases i with u | z
      · rfl
      · simpa only [sources, analyticScalarValuationLayerCarrier,
          analyticScalarReplicatedCarrier] using! hidxCarrier z
    rw [hfamily] at hcombined
    have hrelative :=
      (GaloisForLFunctions.differentialIndependent_sumElim_right_iff
        (fun _ : Unit ↦ y) (fun z : G₀ ↦ z.1)).mp hcombined |>.2
    rw [Subtype.range_val] at hrelative
    unfold GaloisForLFunctions.DiffIndepOn
    have hsingleton := hrelative.comp
      (fun _ : ({y} : Set upperEndMeroField) ↦ ())
      (fun a b _ ↦ Subsingleton.elim a b)
    have htarget :
        ((fun _ : Unit ↦ y) ∘
            (fun _ : ({y} : Set upperEndMeroField) ↦ ())) =
          (fun z : ({y} : Set upperEndMeroField) ↦ z.1) := by
      funext z
      exact (Set.mem_singleton_iff.mp z.2).symm
    rw [htarget] at hsingleton
    exact hsingleton
  have hset : GaloisForLFunctions.DiffIndepOn
      (GaloisForLFunctions.differentialAdjoin upperEndRationalCoordinateField G)
      ({y} : Set upperEndMeroField) :=
    diffIndepOn_differentialAdjoin_of_forall_finite_subset hstages
  unfold GaloisForLFunctions.DiffIndepOn at hset
  have hunit := hset.comp (fun _ : Unit ↦
      (⟨y, Set.mem_singleton y⟩ : ({y} : Set upperEndMeroField)))
    (fun a b _ ↦ Subsingleton.elim a b)
  simpa [analyticScalarValuationLayerDifferentialField, G, y,
    Function.comp_def] using! hunit

/-- **Prime-dependent hypertranscendence across the completion boundary.**  Under the same
arithmetic hypotheses the carrier is hypertranscendental over the complete valuation-layer
field. -/
theorem analyticPrimeProfileCarrier_hypertranscendentalOver_all_valuationLayers
    (F : finiteAbscissaArithmeticSubalgebra)
    (hsupport : PrimeProfileSupportedOnPositivePrimePowers F.1)
    (hinf : ¬ {e : Nat | ∀ p : Nat.Primes, F.1 ((p : Nat) ^ (e + 1)) ≠ 0}.Finite) :
    HypertranscendentalOver
      analyticScalarValuationLayerDifferentialField
      (finiteAbscissaLSeriesToUpperEndMero F) := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  exact analyticPrimeProfileCarrier_differentialIndependent_over_all_valuationLayers
    F hsupport hinf

/-- A meromorphic inverse of an analytic germ is realized by any analytic germ inverting it. -/
theorem algebraMap_upperEndAnalytic_inv_eq
    (a b : upperEndAnalyticSubring) (hab : a * b = 1) :
    (algebraMap upperEndAnalyticSubring upperEndMeroField a)⁻¹ =
      algebraMap upperEndAnalyticSubring upperEndMeroField b := by
  apply inv_eq_of_mul_eq_one_right
  rw [← map_mul, hab, map_one]

/-- Every algebraic jet of an embedded rational coordinate gauge stays inside the complete
valuation-layer field.  The coordinate field is derivation-closed, and the layer field is an
extension of it. -/
theorem differentialJet_mem_valuationLayerField_of_mem_rationalCoordinate
    (x : upperEndMeroField) (hx : x ∈ upperEndRationalCoordinateField) (n : Nat) :
    GaloisForLFunctions.differentialJet n x ∈
      analyticScalarValuationLayerDifferentialField := by
  have hcoord : ∀ k : Nat, GaloisForLFunctions.differentialJet k x ∈
      upperEndRationalCoordinateField := by
    intro k
    induction k with
    | zero => simpa using hx
    | succ k ih =>
        rw [GaloisForLFunctions.differentialJet_succ]
        exact upperEndRationalCoordinateField_derivationClosed ih
  simpa using IntermediateField.algebraMap_mem
    analyticScalarValuationLayerDifferentialField
    (⟨GaloisForLFunctions.differentialJet n x, hcoord n⟩ :
      upperEndRationalCoordinateField)

/-- **Rational-gauge invariance across the completion boundary.**  Translating a family by
embedded rational coordinate gauges does not change differential independence over the complete
prime-zeta valuation-layer field. -/
theorem differentialIndependent_over_all_valuationLayers_add_rationalCoordinate
    {ι : Type*} {x : ι → upperEndMeroField}
    (hx : GaloisForLFunctions.DifferentialIndependent
      analyticScalarValuationLayerDifferentialField x)
    (r : ι → upperEndMeroField)
    (hr : ∀ i, r i ∈ upperEndRationalCoordinateField) :
    GaloisForLFunctions.DifferentialIndependent
      analyticScalarValuationLayerDifferentialField (fun i ↦ x i + r i) := by
  apply hx.addOfJetsInBase
  intro i n
  exact ⟨⟨GaloisForLFunctions.differentialJet n (r i),
    differentialJet_mem_valuationLayerField_of_mem_rationalCoordinate (r i) (hr i) n⟩, rfl⟩

end

