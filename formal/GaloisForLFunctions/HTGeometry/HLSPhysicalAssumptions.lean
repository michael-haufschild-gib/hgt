import GaloisForLFunctions.HTGeometry.HLSKinematics
import GaloisForLFunctions.HTGeometry.HLSFockAlgebra
import Mathlib.Analysis.Analytic.Basic
import Mathlib.Analysis.Distribution.Distribution
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.Analysis.InnerProductSpace.LinearPMap
import Mathlib.Analysis.InnerProductSpace.Orthogonal
import Mathlib.Tactic

/-!
# Physical input interfaces for the Haag--Łopuszański--Sohnius theorem

These records make explicit the assumptions that a physical HLS theorem would
need.  They are data interfaces only: this file postulates no axiom, constructs
no purported QFT model, and proves no classification result.  The generator
interface uses Mathlib's densely defined `LinearPMap` adjoint and records actual
self-adjointness.  `HLSGeneratorIntegrationData` separately ties those generators
to strongly continuous one-parameter Poincaré flows.

Together with `HLSKinematics` and `HLSScattering`, this separates the available
finite algebraic infrastructure from the still-open analytic HLS theorem.
-/

noncomputable section

open Filter
open scoped Topology Matrix

namespace GaloisForLFunctions.HTGeometry

universe u v w

/-- One-dimensional Hilbert subspace generated by a proposed vacuum vector. -/
def hlsVacuumSector {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (vacuum : E) : Submodule ℂ E :=
  Submodule.span ℂ ({vacuum} : Set E)

/-- A Hilbert state space split into vacuum, one-particle, multiparticle, bosonic, and fermionic
sectors.  The fields state an orthogonal, complete sector decomposition but do not construct a
Hilbert completion of the algebraic Fock space. -/
structure HLSStateSectorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  vacuum : E
  oneParticleSector : Submodule ℂ E
  multiparticleSector : Submodule ℂ E
  bosonicSector : Submodule ℂ E
  fermionicSector : Submodule ℂ E
  fermionParity : E ≃ₗᵢ[ℂ] E
  vacuum_normalized : inner ℂ vacuum vacuum = 1
  vacuum_orthogonal_oneParticle : hlsVacuumSector vacuum ⟂ oneParticleSector
  vacuum_orthogonal_multiparticle : hlsVacuumSector vacuum ⟂ multiparticleSector
  oneParticle_orthogonal_multiparticle : oneParticleSector ⟂ multiparticleSector
  sector_complete : hlsVacuumSector vacuum ⊔ oneParticleSector ⊔ multiparticleSector = ⊤
  boson_fermion_orthogonal : bosonicSector ⟂ fermionicSector
  statistics_complete : bosonicSector ⊔ fermionicSector = ⊤
  parity_involutive : ∀ ψ, fermionParity (fermionParity ψ) = ψ
  parity_isometric : ∀ ψ, ‖fermionParity ψ‖ = ‖ψ‖
  bosonic_fixed : ∀ ψ ∈ bosonicSector, fermionParity ψ = ψ
  fermionic_negated : ∀ ψ ∈ fermionicSector, fermionParity ψ = -ψ

/-- One-particle labels with mass, four-momentum, twice-spin, statistics, the mass-shell
condition, positive energy, and finite multiplicity at each exact mass. -/
structure HLSOneParticleData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  state : A → E
  mass : A → ℝ
  momentum : A → HLSMinkowskiVector
  spinTwice : A → ℤ
  fermionic : A → Prop
  state_nonzero : ∀ a, state a ≠ 0
  positive_energy : ∀ a, 0 ≤ momentum a 0
  on_mass_shell : ∀ a, hlsMassShell (mass a) (momentum a)
  spin_statistics : ∀ a, fermionic a ↔ Odd (spinTwice a)
  finite_multiplicity_at_mass : ∀ m, Set.Finite {a | mass a = m}
  finite_multiplicity_below_mass : ∀ m, Set.Finite {a | mass a ≤ m}

/-- Bosonic particle labels have integral spin, as a direct consequence of the supplied
spin--statistics equivalence. -/
theorem HLSOneParticleData.bosonic_spin_twice_even {A : Type v} {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (data : HLSOneParticleData A E) (a : A) (ha : ¬ data.fermionic a) :
    Even (data.spinTwice a) := by
  apply Int.not_odd_iff_even.mp
  intro hodd
  exact ha ((data.spin_statistics a).mpr hodd)

/-- Unitary representation of the proper orthochronous Poincaré group. -/
structure HLSPoincareRepresentation (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E)

/-- Strong-operator topology on unitary linear equivalences: pointwise topology after evaluating
an equivalence on every Hilbert-space vector. -/
abbrev hlsStrongUnitaryTopology (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] : TopologicalSpace (E ≃ₗᵢ[ℂ] E) :=
  TopologicalSpace.induced (fun U => fun ψ => U ψ) inferInstance

/-- A physically continuous unitary Poincaré representation.  Continuity is strong (pointwise on
Hilbert vectors), using the explicit Poincaré topological-group proof and strong-operator
topology from this layer. -/
structure HLSStronglyContinuousPoincareRepresentation (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E)
  strongly_continuous : @Continuous HLSPhysicalPoincareGroup (E ≃ₗᵢ[ℂ]
    E) hlsPhysicalPoincareTopology (hlsStrongUnitaryTopology E) action

/-- Forget strong continuity, retaining the underlying unitary Poincaré action. -/
def HLSStronglyContinuousPoincareRepresentation.toPoincareRepresentation {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (ρ : HLSStronglyContinuousPoincareRepresentation E) : HLSPoincareRepresentation E :=
  ⟨ρ.action⟩

/-- A strongly continuous Poincaré representation is strongly continuous on its full translation
subgroup. -/
theorem HLSStronglyContinuousPoincareRepresentation.translation_strongly_continuous {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (ρ : HLSStronglyContinuousPoincareRepresentation E) :
    @Continuous HLSMinkowskiVector (E ≃ₗᵢ[ℂ] E) inferInstance (hlsStrongUnitaryTopology E)
      (fun a => ρ.action (hlsTranslation a)) := by
  exact @Continuous.comp HLSMinkowskiVector HLSPhysicalPoincareGroup (E ≃ₗᵢ[ℂ] E)
    inferInstance hlsPhysicalPoincareTopology (hlsStrongUnitaryTopology E)
    hlsTranslation ρ.action ρ.strongly_continuous hlsTranslation_continuous

/-- A strongly continuous Poincaré representation is strongly continuous on the pure-Lorentz
subgroup. -/
theorem HLSStronglyContinuousPoincareRepresentation.lorentz_strongly_continuous {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (ρ : HLSStronglyContinuousPoincareRepresentation E) :
    @Continuous hlsProperOrthoLorentzGroup (E ≃ₗᵢ[ℂ] E)
      hlsProperOrthoLorentzTopology (hlsStrongUnitaryTopology E)
      (fun g => ρ.action (hlsLorentzAt g)) := by
  exact @Continuous.comp hlsProperOrthoLorentzGroup HLSPhysicalPoincareGroup (E ≃ₗᵢ[ℂ] E)
    hlsProperOrthoLorentzTopology hlsPhysicalPoincareTopology (hlsStrongUnitaryTopology E)
    hlsLorentzAt ρ.action ρ.strongly_continuous hlsLorentzAt_continuous

/-- The unit-modulus translation character of momentum `p` at translation `x`. -/
def hlsTranslationPhase (p x : HLSMinkowskiVector) : ℂ :=
  Complex.exp (-Complex.I * (hlsMinkowskiPairing p x : ℂ))

/-- Physical translation phases are unitary scalars. -/
theorem hlsTranslationPhase_norm (p x : HLSMinkowskiVector) :
    ‖hlsTranslationPhase p x‖ = 1 := by
  rw [hlsTranslationPhase, Complex.norm_exp]
  simp [Complex.mul_re]

/-- The translation phase at fixed momentum is a character of the translation subgroup. -/
theorem hlsTranslationPhase_add (p x y : HLSMinkowskiVector) :
    hlsTranslationPhase p (x + y) = hlsTranslationPhase p x * hlsTranslationPhase p y := by
  simp only [hlsTranslationPhase, hlsMinkowskiPairing_add_right]
  push_cast
  rw [mul_add, Complex.exp_add]

/-- The translation character is Lorentz invariant when momentum and translation are transformed
together. -/
theorem hlsTranslationPhase_lorentz (g : hlsProperOrthoLorentzGroup)
    (p x : HLSMinkowskiVector) :
    hlsTranslationPhase (g.1 p) (g.1 x) = hlsTranslationPhase p x := by
  simp only [hlsTranslationPhase]
  rw [hlsProperOrthoLorentz_preserves_pairing]

/-- The translation character is invariant under the canonical physical Spin-plus action. -/
theorem hlsTranslationPhase_spinPlus (s : HLSSpinPlusGroup)
    (p x : HLSMinkowskiVector) :
    hlsTranslationPhase ((hlsSpinPlusToProperLorentz s).1 p)
      ((hlsSpinPlusToProperLorentz s).1 x) = hlsTranslationPhase p x :=
  hlsTranslationPhase_lorentz (hlsSpinPlusToProperLorentz s) p x

/-- The translation character is trivial at the zero translation. -/
theorem hlsTranslationPhase_zero (p : HLSMinkowskiVector) : hlsTranslationPhase p 0 = 1 := by
  simp [hlsTranslationPhase, hlsMinkowskiPairing]

/-- The zero momentum has the trivial translation character. -/
theorem hlsTranslationPhase_zero_momentum (x : HLSMinkowskiVector) :
    hlsTranslationPhase 0 x = 1 := by
  simp [hlsTranslationPhase, hlsMinkowskiPairing]

/-- At fixed translation, momenta add as characters multiply. -/
theorem hlsTranslationPhase_add_momentum (p q x : HLSMinkowskiVector) :
    hlsTranslationPhase (p + q) x =
      hlsTranslationPhase p x * hlsTranslationPhase q x := by
  simp only [hlsTranslationPhase, hlsMinkowskiPairing_add_left]
  push_cast
  rw [mul_add, Complex.exp_add]

/-- Negating momentum inverts the corresponding translation character. -/
theorem hlsTranslationPhase_neg_momentum (p x : HLSMinkowskiVector) :
    hlsTranslationPhase (-p) x = (hlsTranslationPhase p x)⁻¹ := by
  rw [hlsTranslationPhase, hlsTranslationPhase, ← Complex.exp_neg]
  congr 1
  simp only [hlsMinkowskiPairing, Pi.neg_apply]
  push_cast
  ring

/-- The translation character of an ordered multiparticle momentum sum factors into its
one-particle characters. -/
theorem hlsTranslationPhase_list_sum (ps : List HLSMinkowskiVector) (x : HLSMinkowskiVector) :
    hlsTranslationPhase ps.sum x = (ps.map fun p => hlsTranslationPhase p x).prod := by
  induction ps with
  | nil => simpa using hlsTranslationPhase_zero_momentum x
  | cons p ps ih =>
    simp only [List.sum_cons, List.map_cons, List.prod_cons]
    rw [hlsTranslationPhase_add_momentum, ih]

/-- Translation characters multiply when ordered particle configurations are concatenated. -/
theorem hlsTranslationPhase_list_append (ps qs : List HLSMinkowskiVector)
    (x : HLSMinkowskiVector) :
    hlsTranslationPhase (ps ++ qs).sum x =
      hlsTranslationPhase ps.sum x * hlsTranslationPhase qs.sum x := by
  rw [List.sum_append, hlsTranslationPhase_add_momentum]

/-- Compatibility of labelled one-particle states and the full state-sector split with a unitary
Poincaré representation.  This is the actual positive-energy one-particle representation input;
the mass-shell and energy inequalities live in `HLSOneParticleData`.  The translation character
and Lorentz covariance fields connect those labels to the represented Poincaré action. -/
structure HLSOneParticlePoincareData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sectors : HLSStateSectorData E
  particles : HLSOneParticleData A E
  poincare : HLSPoincareRepresentation E
  vacuum_invariant : ∀ g, poincare.action g sectors.vacuum = sectors.vacuum
  vacuum_invariant_vectors : {ψ | ∀ g, poincare.action g ψ = ψ} = hlsVacuumSector sectors.vacuum
  particleLorentz : hlsProperOrthoLorentzGroup →* Equiv.Perm A
  lorentz_state_covariant : ∀ g a,
    poincare.action (hlsLorentzAt g) (particles.state a) = particles.state (particleLorentz g a)
  momentum_lorentz_covariant : ∀ g a,
    particles.momentum (particleLorentz g a) = g.1 (particles.momentum a)
  mass_lorentz_invariant : ∀ g a,
    particles.mass (particleLorentz g a) = particles.mass a
  spin_lorentz_invariant : ∀ g a,
    particles.spinTwice (particleLorentz g a) = particles.spinTwice a
  statistics_lorentz_invariant : ∀ g a,
    particles.fermionic (particleLorentz g a) ↔ particles.fermionic a
  translation_eigenstate : ∀ x a,
    poincare.action (hlsTranslation x) (particles.state a) =
      hlsTranslationPhase (particles.momentum a) x • particles.state a
  oneParticle_invariant : ∀ g ψ, ψ ∈ sectors.oneParticleSector →
    poincare.action g ψ ∈ sectors.oneParticleSector
  multiparticle_invariant : ∀ g ψ, ψ ∈ sectors.multiparticleSector →
    poincare.action g ψ ∈ sectors.multiparticleSector
  bosonic_invariant : ∀ g ψ, ψ ∈ sectors.bosonicSector →
    poincare.action g ψ ∈ sectors.bosonicSector
  fermionic_invariant : ∀ g ψ, ψ ∈ sectors.fermionicSector →
    poincare.action g ψ ∈ sectors.fermionicSector
  particle_state_in_oneParticle : ∀ a, particles.state a ∈ sectors.oneParticleSector
  bosonic_particle_state : ∀ a, ¬ particles.fermionic a →
    particles.state a ∈ sectors.bosonicSector
  fermionic_particle_state : ∀ a, particles.fermionic a →
    particles.state a ∈ sectors.fermionicSector

/-- Lorentz transport preserves the mass-shell assertion carried by every one-particle label. -/
theorem HLSOneParticlePoincareData.lorentz_transported_mass_shell {A : Type v} {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (data : HLSOneParticlePoincareData A E) (g : hlsProperOrthoLorentzGroup) (a : A) :
    hlsMassShell (data.particles.mass (data.particleLorentz g a))
      (data.particles.momentum (data.particleLorentz g a)) := by
  rw [data.mass_lorentz_invariant, data.momentum_lorentz_covariant]
  exact (hlsProperOrthoLorentz_preserves_massShell g (data.particles.mass a)
    (data.particles.momentum a)).mpr (data.particles.on_mass_shell a)

/-- A Hilbert-space realization of the algebraic Bose/Fermi Fock core.  Its image is dense in
the physical state space, and the vacuum and one-creation states land in their named sectors.
This records the completion map without pretending that the present file constructs it. -/
structure HLSFockStateCompletionData (B : Type v) (F : Type w) [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sectors : HLSStateSectorData E
  completion : HLSAlgebraicFock B F →ₗ[ℂ] E
  completion_injective : Function.Injective completion
  dense_range : Dense (Set.range completion)
  vacuum_image : completion 1 = sectors.vacuum
  parity_compatible : ∀ x,
    sectors.fermionParity (completion x) = completion (hlsFockParity B F x)
  boson_creation_in_bosonic : ∀ b, completion (hlsBosonCreate B F b) ∈ sectors.bosonicSector
  fermion_creation_in_fermionic : ∀ f,
    completion (hlsFermionCreate B F f) ∈ sectors.fermionicSector

/-- Physical parity fixes a completed bosonic creation state. -/
theorem HLSFockStateCompletionData.parity_boson_creation {B : Type v} {F : Type w}
    [AddCommGroup B] [Module ℂ B] [AddCommGroup F] [Module ℂ F] {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (data : HLSFockStateCompletionData B F E) (b : B) :
    data.sectors.fermionParity (data.completion (hlsBosonCreate B F b)) =
      data.completion (hlsBosonCreate B F b) := by
  rw [data.parity_compatible, hlsFockParity_apply_bosonCreate]

/-- Physical parity negates a completed fermionic creation state. -/
theorem HLSFockStateCompletionData.parity_fermion_creation {B : Type v} {F : Type w}
    [AddCommGroup B] [Module ℂ B] [AddCommGroup F] [Module ℂ F] {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (data : HLSFockStateCompletionData B F E) (f : F) :
    data.sectors.fermionParity (data.completion (hlsFermionCreate B F f)) =
      -data.completion (hlsFermionCreate B F f) := by
  rw [data.parity_compatible, hlsFockParity_apply_fermionCreate, map_neg]

/-- Unitary representation of the canonical physical Spin-plus Poincaré group. -/
structure HLSSpinPoincareRepresentation (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSSpinPoincareGroup →* (E ≃ₗᵢ[ℂ] E)

/-- A genuinely self-adjoint, possibly unbounded Hilbert-space operator.  Mathlib's
`LinearPMap` adjoint makes this stronger than a merely symmetric common-domain map: its domain
is dense and its graph is closed. -/
structure HLSDomainOperator (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  operator : E →ₗ.[ℂ] E
  selfAdjoint : IsSelfAdjoint operator

/-- A self-adjoint HLS generator has a dense domain. -/
theorem HLSDomainOperator.domain_dense {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (T : HLSDomainOperator E) :
    Dense (T.operator.domain : Set E) := T.selfAdjoint.dense_domain

/-- A self-adjoint HLS generator has a closed graph. -/
theorem HLSDomainOperator.graph_closed {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (T : HLSDomainOperator E) :
    IsClosed (T.operator.graph : Set (E × E)) := T.selfAdjoint.isClosed

/-- Self-adjoint translation and Lorentz generators on a dense common invariant domain.  The
nonnegative energy form is the common-domain expression of the positive-energy condition.
Differentiating a group representation to these generators remains additional work. -/
structure HLSInfinitesimalPoincareData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → HLSDomainOperator E
  lorentz : Fin 4 → Fin 4 → HLSDomainOperator E
  translation_domain : ∀ μ, (translation μ).operator.domain = commonDomain
  lorentz_domain : ∀ μ ν, (lorentz μ ν).operator.domain = commonDomain
  translation_invariant : ∀ μ x (hx : x ∈ commonDomain),
    (translation μ).operator ⟨x, by rw [translation_domain μ]; exact hx⟩ ∈ commonDomain
  lorentz_invariant : ∀ μ ν x (hx : x ∈ commonDomain),
    (lorentz μ ν).operator ⟨x, by rw [lorentz_domain μ ν]; exact hx⟩ ∈ commonDomain
  energy_form_nonnegative : ∀ (x : commonDomain),
    0 ≤ (inner ℂ
      ((translation 0).operator ⟨(x : E), by rw [translation_domain 0]; exact x.property⟩)
      (x : E)).re

/-- Translation generator restricted to the common invariant domain. -/
def HLSInfinitesimalPoincareData.translationOnDomain {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (data : HLSInfinitesimalPoincareData E)
    (μ : Fin 4) : data.commonDomain →ₗ[ℂ] data.commonDomain :=
  ((data.translation μ).operator.toFun.comp
    (Submodule.inclusion (by rw [data.translation_domain μ]))).codRestrict data.commonDomain
      (fun x => by
        change (data.translation μ).operator ⟨(x : E), _⟩ ∈ data.commonDomain
        exact data.translation_invariant μ x x.property)

/-- Lorentz generator restricted to the common invariant domain. -/
def HLSInfinitesimalPoincareData.lorentzOnDomain {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (data : HLSInfinitesimalPoincareData E)
    (μ ν : Fin 4) : data.commonDomain →ₗ[ℂ] data.commonDomain :=
  ((data.lorentz μ ν).operator.toFun.comp
    (Submodule.inclusion (by rw [data.lorentz_domain μ ν]))).codRestrict data.commonDomain
      (fun x => by
        change (data.lorentz μ ν).operator ⟨(x : E), _⟩ ∈ data.commonDomain
        exact data.lorentz_invariant μ ν x x.property)

/-- Minkowski metric, regarded as a complex scalar for operator identities. -/
def hlsComplexMinkowskiMetric (μ ν : Fin 4) : ℂ :=
  (hlsMinkowskiMetric μ ν : ℂ)

/-- Commutator of two operators which preserve one common domain. -/
def hlsDomainCommutator {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (D : Submodule ℂ E) (A B : D →ₗ[ℂ] D) : D →ₗ[ℂ] D :=
  A.comp B - B.comp A

/-- Anticommutator of two operators which preserve one common domain. -/
def hlsDomainAnticommutator {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (D : Submodule ℂ E) (A B : D →ₗ[ℂ] D) : D →ₗ[ℂ] D :=
  A.comp B + B.comp A

/-- Matrix commutator for finite Weyl-spinor transformations. -/
def hlsMatrixCommutator {ι : Type v} [Fintype ι] [DecidableEq ι]
    (A B : Matrix ι ι ℂ) : Matrix ι ι ℂ :=
  A * B - B * A

/-- Exact Poincaré Lie-algebra relations for self-adjoint generators, expressed on their common
invariant domain.  `HLSGeneratorIntegrationData` can further identify these generators with
derivatives of a strongly continuous group action. -/
structure HLSInfinitesimalPoincareLieData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  generators : HLSInfinitesimalPoincareData E
  lorentz_antisymmetric : ∀ μ ν,
    generators.lorentzOnDomain μ ν = -generators.lorentzOnDomain ν μ
  translations_commute : ∀ μ ν,
    hlsDomainCommutator generators.commonDomain (generators.translationOnDomain μ)
      (generators.translationOnDomain ν) = 0
  lorentz_translation : ∀ μ ν ρ,
    hlsDomainCommutator generators.commonDomain (generators.lorentzOnDomain μ ν)
      (generators.translationOnDomain ρ) =
        Complex.I • (hlsComplexMinkowskiMetric ν ρ • generators.translationOnDomain μ -
          hlsComplexMinkowskiMetric μ ρ • generators.translationOnDomain ν)
  lorentz_bracket : ∀ μ ν ρ σ,
    hlsDomainCommutator generators.commonDomain (generators.lorentzOnDomain μ ν)
      (generators.lorentzOnDomain ρ σ) =
        Complex.I •
          (hlsComplexMinkowskiMetric μ σ • generators.lorentzOnDomain ν ρ +
            hlsComplexMinkowskiMetric ν ρ • generators.lorentzOnDomain μ σ -
            hlsComplexMinkowskiMetric μ ρ • generators.lorentzOnDomain ν σ -
            hlsComplexMinkowskiMetric ν σ • generators.lorentzOnDomain μ ρ)

/-- Strong derivative of a unitary one-parameter Poincaré action on a common invariant domain.
The `-i` convention makes a self-adjoint generator `T` satisfy `U(t) = exp(-itT)` formally. -/
def hlsUnitaryGeneratorDerivative {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E]
    (action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E))
    (flow : ℝ → HLSPhysicalPoincareGroup) (D : Submodule ℂ E) (T : D →ₗ[ℂ] E) : Prop :=
  ∀ ψ : D, Tendsto
    (fun t : ℝ => (t : ℂ)⁻¹ • (action (flow t) (ψ : E) - (ψ : E)))
    (𝓝[≠] (0 : ℝ)) (𝓝 (-Complex.I • T ψ))

/-- Integration data connecting a strongly continuous Poincaré representation with its
self-adjoint infinitesimal translation and Lorentz generators.  Translation flows are fixed to
the concrete coordinate translations; Lorentz flows are continuous one-parameter subgroups
whose derivatives define the named Lorentz generators. -/
structure HLSGeneratorIntegrationData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  representation : HLSStronglyContinuousPoincareRepresentation E
  generators : HLSInfinitesimalPoincareData E
  lorentzFlow : Fin 4 → Fin 4 → ℝ → HLSPhysicalPoincareGroup
  lorentzFlow_zero : ∀ μ ν, lorentzFlow μ ν 0 = 1
  lorentzFlow_add : ∀ μ ν s t,
    lorentzFlow μ ν (s + t) = lorentzFlow μ ν s * lorentzFlow μ ν t
  lorentzFlow_continuous : ∀ μ ν, @Continuous ℝ HLSPhysicalPoincareGroup
    inferInstance hlsPhysicalPoincareTopology (lorentzFlow μ ν)
  translation_derivative : ∀ μ,
    hlsUnitaryGeneratorDerivative representation.action (hlsTranslationAt μ) generators.commonDomain
      (generators.commonDomain.subtype.comp (generators.translationOnDomain μ))
  lorentz_derivative : ∀ μ ν,
    hlsUnitaryGeneratorDerivative representation.action (lorentzFlow μ ν) generators.commonDomain
      (generators.commonDomain.subtype.comp (generators.lorentzOnDomain μ ν))

/-- The invariant alternating tensor on two-component Weyl spinors. -/
def hlsWeylEpsilon : Matrix (Fin 2) (Fin 2) ℂ :=
  !![0, 1;
     -1, 0]

/-- Weyl epsilon is antisymmetric. -/
theorem hlsWeylEpsilon_antisymmetric : hlsWeylEpsilon.transpose = -hlsWeylEpsilon := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hlsWeylEpsilon]

/-- The Weyl epsilon tensor is nondegenerate: its square is minus the identity. -/
theorem hlsWeylEpsilon_squared : hlsWeylEpsilon * hlsWeylEpsilon = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [hlsWeylEpsilon, Matrix.mul_apply, Fin.sum_univ_two]

/-- Standard Weyl sigma matrices `(1, σ₁, σ₂, σ₃)` for signature `(1, 3)`. -/
def hlsWeylSigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ :=
  ![!![1, 0; 0, 1],
    !![0, 1; 1, 0],
    !![0, -Complex.I; Complex.I, 0],
    !![1, 0; 0, -1]]

/-- Conjugate Weyl matrices `(1, -σ₁, -σ₂, -σ₃)`. -/
def hlsWeylBarSigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ :=
  ![!![1, 0; 0, 1],
    !![0, -1; -1, 0],
    !![0, Complex.I; -Complex.I, 0],
    !![-1, 0; 0, 1]]

/-- The standard Weyl matrices satisfy the Clifford relation for the HLS Minkowski metric. -/
theorem hlsWeylSigma_clifford (μ ν : Fin 4) :
    hlsWeylSigma μ * hlsWeylBarSigma ν + hlsWeylSigma ν * hlsWeylBarSigma μ =
      ((2 : ℂ) * hlsComplexMinkowskiMetric μ ν) • 1 := by
  fin_cases μ <;> fin_cases ν <;>
    ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [hlsWeylSigma, hlsWeylBarSigma, hlsComplexMinkowskiMetric, hlsMinkowskiMetric] <;>
      ring

/-- The barred Weyl matrices satisfy the companion Clifford identity. -/
theorem hlsWeylBarSigma_clifford (μ ν : Fin 4) :
    hlsWeylBarSigma μ * hlsWeylSigma ν + hlsWeylBarSigma ν * hlsWeylSigma μ =
      ((2 : ℂ) * hlsComplexMinkowskiMetric μ ν) • 1 := by
  fin_cases μ <;> fin_cases ν <;>
    ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [hlsWeylSigma, hlsWeylBarSigma, hlsComplexMinkowskiMetric, hlsMinkowskiMetric] <;>
      ring

/-- Four-component Dirac spinors in the Weyl decomposition. -/
abbrev HLSDiracSpinor := Fin 2 ⊕ Fin 2

/-- Weyl-basis Dirac gamma matrices for signature `(1,3)`. -/
def hlsWeylGamma (μ : Fin 4) : Matrix HLSDiracSpinor HLSDiracSpinor ℂ :=
  Matrix.fromBlocks 0 (hlsWeylSigma μ) (hlsWeylBarSigma μ) 0

/-- The Weyl-basis gamma matrices satisfy the four-dimensional Minkowski Clifford relation. -/
theorem hlsWeylGamma_clifford (μ ν : Fin 4) :
    hlsWeylGamma μ * hlsWeylGamma ν + hlsWeylGamma ν * hlsWeylGamma μ =
      ((2 : ℂ) * hlsComplexMinkowskiMetric μ ν) • 1 := by
  simp only [hlsWeylGamma, Matrix.fromBlocks_multiply, Matrix.fromBlocks_add]
  simp only [Matrix.zero_mul, Matrix.mul_zero, zero_add, add_zero]
  rw [hlsWeylSigma_clifford μ ν, hlsWeylBarSigma_clifford μ ν]
  rw [← Matrix.fromBlocks_one, Matrix.fromBlocks_smul]
  simp

/-- Chirality operator in the Weyl Dirac basis. -/
def hlsWeylGammaFive : Matrix HLSDiracSpinor HLSDiracSpinor ℂ :=
  Matrix.fromBlocks (-1) 0 0 1

/-- The chirality operator is an involution. -/
theorem hlsWeylGammaFive_squared : hlsWeylGammaFive * hlsWeylGammaFive = 1 := by
  simp [hlsWeylGammaFive, Matrix.fromBlocks_multiply, ← Matrix.fromBlocks_one]

/-- Chirality anticommutes with every Minkowski gamma matrix. -/
theorem hlsWeylGammaFive_anticommutes (μ : Fin 4) :
    hlsWeylGammaFive * hlsWeylGamma μ + hlsWeylGamma μ * hlsWeylGammaFive = 0 := by
  simp [hlsWeylGammaFive, hlsWeylGamma, Matrix.fromBlocks_multiply,
    Matrix.fromBlocks_add, Matrix.fromBlocks_zero]

/-- The gamma adjoint rule has the Lorentzian sign prescribed by the Minkowski metric. -/
theorem hlsWeylGamma_conjTranspose (μ : Fin 4) :
    (hlsWeylGamma μ)ᴴ = (hlsMinkowskiCoordinateSign μ : ℂ) • hlsWeylGamma μ := by
  fin_cases μ <;>
    ext i j <;> rcases i with i | i <;> rcases j with j | j <;>
    fin_cases i <;> fin_cases j <;>
    simp [hlsWeylGamma, hlsWeylSigma, hlsWeylBarSigma, hlsMinkowskiCoordinateSign,
      Matrix.conjTranspose_apply]

/-- Projector onto left-handed Weyl components. -/
def hlsWeylLeftProjector : Matrix HLSDiracSpinor HLSDiracSpinor ℂ :=
  Matrix.fromBlocks 1 0 0 0

/-- Projector onto right-handed Weyl components. -/
def hlsWeylRightProjector : Matrix HLSDiracSpinor HLSDiracSpinor ℂ :=
  Matrix.fromBlocks 0 0 0 1

/-- The Weyl projectors are complementary, idempotent, and mutually orthogonal. -/
theorem hlsWeyl_chiral_projectors :
    hlsWeylLeftProjector + hlsWeylRightProjector = 1 ∧
      hlsWeylLeftProjector * hlsWeylLeftProjector = hlsWeylLeftProjector ∧
      hlsWeylRightProjector * hlsWeylRightProjector = hlsWeylRightProjector ∧
      hlsWeylLeftProjector * hlsWeylRightProjector = 0 ∧
      hlsWeylRightProjector * hlsWeylLeftProjector = 0 := by
  simp [hlsWeylLeftProjector, hlsWeylRightProjector, Matrix.fromBlocks_add,
    Matrix.fromBlocks_multiply, ← Matrix.fromBlocks_one, Matrix.fromBlocks_zero]

/-- A gamma matrix carries right-handed Weyl components to left-handed ones. -/
theorem hlsWeyl_leftProjector_gamma (μ : Fin 4) :
    hlsWeylLeftProjector * hlsWeylGamma μ = hlsWeylGamma μ * hlsWeylRightProjector := by
  simp [hlsWeylLeftProjector, hlsWeylRightProjector, hlsWeylGamma,
    Matrix.fromBlocks_multiply]

/-- A gamma matrix carries left-handed Weyl components to right-handed ones. -/
theorem hlsWeyl_rightProjector_gamma (μ : Fin 4) :
    hlsWeylRightProjector * hlsWeylGamma μ = hlsWeylGamma μ * hlsWeylLeftProjector := by
  simp [hlsWeylLeftProjector, hlsWeylRightProjector, hlsWeylGamma,
    Matrix.fromBlocks_multiply]

/-- Weyl-spinor transformation and translation-invariance laws on a common invariant domain.
The matrices `lorentzOnSpinor` are supplied representation data; deriving the unique Weyl form
from physical hypotheses is part of the unformalized HLS classification proof. -/
structure HLSWeylSuperchargeData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  lorentz : Fin 4 → Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  supercharge : Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  lorentzOnSpinor : Fin 4 → Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  translation_commutes_supercharge : ∀ μ α,
    hlsDomainCommutator commonDomain (translation μ) (supercharge α) = 0
  lorentz_covariant_supercharge : ∀ μ ν α,
    hlsDomainCommutator commonDomain (lorentz μ ν) (supercharge α) =
      ∑ β, (lorentzOnSpinor μ ν α β) • supercharge β

/-- Full common-domain Weyl superalgebra interface.  It records the mixed anticommutator,
same-chirality central charge, centrality, and positivity used in the HLS classification.  It
does not derive them: that derivation is precisely the remaining physical HLS theorem. -/
structure HLSWeylSuperalgebraData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  supercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  conjugateSupercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  sigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  centralCharge : N → N → commonDomain →ₗ[ℂ] commonDomain
  conjugate_adjoint : ∀ I α (ψ φ : commonDomain),
    inner ℂ (supercharge I α ψ : E) (φ : E) =
      inner ℂ (ψ : E) (conjugateSupercharge I α φ : E)
  mixed_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator commonDomain (supercharge I α) (conjugateSupercharge J β) =
      ∑ μ, (if I = J then (2 : ℂ) * sigma μ α β else 0) • translation μ
  same_chirality_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator commonDomain (supercharge I α) (supercharge J β) =
      hlsWeylEpsilon α β • centralCharge I J
  centralCharge_antisymmetric : ∀ I J, centralCharge I J = -centralCharge J I
  central_commutes_translation : ∀ I J μ,
    hlsDomainCommutator commonDomain (centralCharge I J) (translation μ) = 0
  central_commutes_supercharge : ∀ I J K α,
    hlsDomainCommutator commonDomain (centralCharge I J) (supercharge K α) = 0
  mixed_positive : ∀ I α (ψ : commonDomain),
    0 ≤ (inner ℂ
      ((hlsDomainAnticommutator commonDomain (supercharge I α)
        (conjugateSupercharge I α) ψ : commonDomain) : E)
      (ψ : E)).re

/-- A full Weyl superalgebra on the same common domain as genuine Poincaré generators.  Unlike
the reusable algebra interface above, this record identifies its translations and Lorentz action
with the self-adjoint Poincaré system, so every HLS bracket is an equation among one set of
physical operators. -/
structure HLSPoincareWeylSuperalgebraData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  poincare : HLSInfinitesimalPoincareLieData E
  supercharge : N → Fin 2 → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  conjugateSupercharge : N → Fin 2 → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  lorentzOnSpinor : Fin 4 → Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  lorentzOnSpinor_antisymmetric : ∀ μ ν,
    lorentzOnSpinor μ ν = -lorentzOnSpinor ν μ
  lorentzOnSpinor_bracket : ∀ μ ν ρ σ,
    hlsMatrixCommutator (lorentzOnSpinor μ ν) (lorentzOnSpinor ρ σ) =
      Complex.I •
        (hlsComplexMinkowskiMetric μ σ • lorentzOnSpinor ν ρ +
          hlsComplexMinkowskiMetric ν ρ • lorentzOnSpinor μ σ -
          hlsComplexMinkowskiMetric μ ρ • lorentzOnSpinor ν σ -
          hlsComplexMinkowskiMetric ν σ • lorentzOnSpinor μ ρ)
  sigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  sigma_standard : sigma = hlsWeylSigma
  centralCharge : N → N → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  conjugate_adjoint : ∀ I α (ψ φ : poincare.generators.commonDomain),
    inner ℂ (supercharge I α ψ : E) (φ : E) =
      inner ℂ (ψ : E) (conjugateSupercharge I α φ : E)
  translation_commutes_supercharge : ∀ I μ α,
    hlsDomainCommutator poincare.generators.commonDomain
      (poincare.generators.translationOnDomain μ) (supercharge I α) = 0
  lorentz_covariant_supercharge : ∀ I μ ν α,
    hlsDomainCommutator poincare.generators.commonDomain
      (poincare.generators.lorentzOnDomain μ ν) (supercharge I α) =
        ∑ β, lorentzOnSpinor μ ν α β • supercharge I β
  mixed_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
      (conjugateSupercharge J β) =
        ∑ μ, (if I = J then (2 : ℂ) * sigma μ α β else 0) •
          poincare.generators.translationOnDomain μ
  same_chirality_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
      (supercharge J β) = hlsWeylEpsilon α β • centralCharge I J
  centralCharge_antisymmetric : ∀ I J, centralCharge I J = -centralCharge J I
  central_commutes_translation : ∀ I J μ,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (poincare.generators.translationOnDomain μ) = 0
  central_commutes_lorentz : ∀ I J μ ν,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (poincare.generators.lorentzOnDomain μ ν) = 0
  central_commutes_supercharge : ∀ I J K α,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (supercharge K α) = 0
  mixed_positive : ∀ I α (ψ : poincare.generators.commonDomain),
    0 ≤ (inner ℂ
      ((hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
        (conjugateSupercharge I α) ψ : poincare.generators.commonDomain) : E)
      (ψ : E)).re

/-- A Weyl superalgebra whose Poincaré generators are the actual derivatives of a strongly
continuous physical Poincaré action.  This removes the otherwise possible mismatch between the
group representation used by scattering and the infinitesimal algebra used by supercharges. -/
structure HLSIntegratedPoincareWeylSuperalgebraData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  integration : HLSGeneratorIntegrationData E
  superalgebra : HLSPoincareWeylSuperalgebraData N E
  generators_agree : superalgebra.poincare.generators = integration.generators

/-- A unitary scattering operator together with its exact Poincaré invariance. -/
structure HLSSMatrixData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  poincare : HLSPoincareRepresentation E
  scattering : E ≃ₗᵢ[ℂ] E
  poincare_invariant : ∀ g ψ,
    scattering (poincare.action g ψ) = poincare.action g (scattering ψ)

/-- S-matrix data tied to the physical state sectors.  Stable vacuum and one-particle states are
fixed by scattering, while the multiparticle sector is invariant. -/
structure HLSPhysicalScatteringData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  particlePoincare : HLSOneParticlePoincareData A E
  stronglyContinuousPoincare : HLSStronglyContinuousPoincareRepresentation E
  stronglyContinuous_agrees : stronglyContinuousPoincare.toPoincareRepresentation =
    particlePoincare.poincare
  sMatrix : HLSSMatrixData E
  poincare_agrees : sMatrix.poincare = particlePoincare.poincare
  scattering_nontrivial : ∃ ψ, sMatrix.scattering ψ ≠ ψ
  vacuum_fixed : sMatrix.scattering particlePoincare.sectors.vacuum = particlePoincare.sectors.vacuum
  oneParticle_fixed : ∀ ψ ∈ particlePoincare.sectors.oneParticleSector,
    sMatrix.scattering ψ = ψ
  multiparticle_invariant : ∀ ψ ∈ particlePoincare.sectors.multiparticleSector,
    sMatrix.scattering ψ ∈ particlePoincare.sectors.multiparticleSector

/-- The physical S-matrix commutes with the actual strongly continuous Poincaré action,
not only with a separately named abstract representation. -/
theorem HLSPhysicalScatteringData.scattering_commutes_strongly_continuous_poincare
    {A : Type v} {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (data : HLSPhysicalScatteringData A E)
    (g : HLSPhysicalPoincareGroup) (ψ : E) :
    data.sMatrix.scattering (data.stronglyContinuousPoincare.action g ψ) =
      data.stronglyContinuousPoincare.action g (data.sMatrix.scattering ψ) := by
  have hsc := congrArg (fun ρ : HLSPoincareRepresentation E => ρ.action)
    data.stronglyContinuous_agrees
  have hsm := congrArg (fun ρ : HLSPoincareRepresentation E => ρ.action)
    data.poincare_agrees
  change data.sMatrix.scattering
      (data.stronglyContinuousPoincare.toPoincareRepresentation.action g ψ) =
    data.stronglyContinuousPoincare.toPoincareRepresentation.action g
      (data.sMatrix.scattering ψ)
  rw [hsc, ← hsm]
  exact data.sMatrix.poincare_invariant g ψ

/-- A symmetry generator represented on an S-invariant common domain.  The agreement field makes
the domain action a restriction of the unitary scattering operator, and the final field is the
operator equation `[S, G] = 0`. -/
structure HLSScatteringGeneratorSymmetryData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sMatrix : HLSSMatrixData E
  commonDomain : Submodule ℂ E
  scatteringOnDomain : commonDomain →ₗ[ℂ] commonDomain
  scattering_agrees : ∀ ψ : commonDomain,
    (scatteringOnDomain ψ : E) = sMatrix.scattering (ψ : E)
  generator : commonDomain →ₗ[ℂ] commonDomain
  generator_commutes_scattering :
    hlsDomainCommutator commonDomain scatteringOnDomain generator = 0

/-- The same scattering-symmetry condition simultaneously for all components of an extended Weyl
supercharge. -/
structure HLSSMatrixWeylSymmetryData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  sMatrix : HLSSMatrixData E
  commonDomain : Submodule ℂ E
  scatteringOnDomain : commonDomain →ₗ[ℂ] commonDomain
  scattering_agrees : ∀ ψ : commonDomain,
    (scatteringOnDomain ψ : E) = sMatrix.scattering (ψ : E)
  supercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  supercharge_commutes_scattering : ∀ I α,
    hlsDomainCommutator commonDomain scatteringOnDomain (supercharge I α) = 0

/-- Physical scattering symmetry for the same integrated Weyl superalgebra that acts on the
strongly continuous Poincaré representation.  The domain action is a literal restriction of the
unitary S-matrix, so these are not independent abstract scattering and supercharge systems. -/
structure HLSPhysicalWeylScatteringData (N : Type v) [DecidableEq N] (A : Type w) (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  physicalScattering : HLSPhysicalScatteringData A E
  physicalWeyl : HLSIntegratedPoincareWeylSuperalgebraData N E
  scatteringOnDomain : physicalWeyl.superalgebra.poincare.generators.commonDomain →ₗ[ℂ]
    physicalWeyl.superalgebra.poincare.generators.commonDomain
  fermionParityOnDomain : physicalWeyl.superalgebra.poincare.generators.commonDomain →ₗ[ℂ]
    physicalWeyl.superalgebra.poincare.generators.commonDomain
  fermionParity_agrees : ∀ ψ : physicalWeyl.superalgebra.poincare.generators.commonDomain,
    (fermionParityOnDomain ψ : E) =
      physicalScattering.particlePoincare.sectors.fermionParity (ψ : E)
  fermionParity_involutive : fermionParityOnDomain.comp fermionParityOnDomain = LinearMap.id
  scattering_agrees : ∀ ψ : physicalWeyl.superalgebra.poincare.generators.commonDomain,
    (scatteringOnDomain ψ : E) = physicalScattering.sMatrix.scattering (ψ : E)
  supercharge_odd : ∀ I α,
    fermionParityOnDomain.comp (physicalWeyl.superalgebra.supercharge I α) =
      -(physicalWeyl.superalgebra.supercharge I α).comp fermionParityOnDomain
  conjugateSupercharge_odd : ∀ I α,
    fermionParityOnDomain.comp (physicalWeyl.superalgebra.conjugateSupercharge I α) =
      -(physicalWeyl.superalgebra.conjugateSupercharge I α).comp fermionParityOnDomain
  supercharge_commutes_scattering : ∀ I α,
    hlsDomainCommutator physicalWeyl.superalgebra.poincare.generators.commonDomain
      scatteringOnDomain (physicalWeyl.superalgebra.supercharge I α) = 0
  conjugateSupercharge_commutes_scattering : ∀ I α,
    hlsDomainCommutator physicalWeyl.superalgebra.poincare.generators.commonDomain
      scatteringOnDomain (physicalWeyl.superalgebra.conjugateSupercharge I α) = 0

/-- Additive action on ordered finite asymptotic configurations. -/
structure HLSAdditiveGeneratorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (A : Type v) where
  oneParticleContribution : A → E
  multiparticleContribution : List A → E
  additive : ∀ left right,
    multiparticleContribution (left ++ right) =
      multiparticleContribution left + multiparticleContribution right

/-- The sign by which an odd generator passes one fermionic particle. -/
def hlsFermionSign (isFermionic : Bool) : ℂ := if isFermionic then -1 else 1

/-- Graded additivity for an odd generator on ordered multiparticle configurations. -/
structure HLSOddAdditiveGeneratorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (A : Type v) where
  fermionic : A → Bool
  oneParticleContribution : A → E
  multiparticleContribution : List A → E
  empty : multiparticleContribution [] = 0
  prepend_graded : ∀ a configuration,
    multiparticleContribution (a :: configuration) = oneParticleContribution a +
      hlsFermionSign (fermionic a) • multiparticleContribution configuration

/-- Graded multiparticle additivity using the same proposition-valued statistics assignment as a
physical one-particle system.  `gradedSign` avoids choosing a global decision procedure for every
particle-statistics proposition. -/
structure HLSPhysicalOddAdditiveGeneratorData (A : Type v) (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  fermionic : A → Prop
  gradedSign : A → ℂ
  bosonic_sign : ∀ a, ¬ fermionic a → gradedSign a = 1
  fermionic_sign : ∀ a, fermionic a → gradedSign a = -1
  oneParticleContribution : A → E
  multiparticleContribution : List A → E
  empty : multiparticleContribution [] = 0
  prepend_graded : ∀ a configuration,
    multiparticleContribution (a :: configuration) = oneParticleContribution a +
      gradedSign a • multiparticleContribution configuration

/-- An HLS symmetry generator may connect only particle types of equal mass. -/
structure HLSMassPreservingGeneratorData (A : Type u) where
  mass : A → ℝ
  transition : A → A → Prop
  connects_equal_mass : ∀ a b, transition a b → mass a = mass b

/-- Massive-sector assumptions attached to the actual one-particle Poincaré system.  Vacuum
uniqueness is supplied by `vacuum_invariant_vectors`; positive mass and a gap are the explicit
infrared restriction for this massive HLS setting. -/
structure HLSMassiveSectorRestrictions (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  particlePoincare : HLSOneParticlePoincareData A E
  positive_mass : ∀ a, 0 < particlePoincare.particles.mass a
  mass_gap : ∃ m₀, 0 < m₀ ∧ ∀ a, m₀ ≤ particlePoincare.particles.mass a

/-- The massive-sector condition excludes massless one-particle labels. -/
theorem HLSMassiveSectorRestrictions.mass_ne_zero {A : Type v} {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (data : HLSMassiveSectorRestrictions A E) (a : A) :
    data.particlePoincare.particles.mass a ≠ 0 :=
  ne_of_gt (data.positive_mass a)

/-- A finite-order distributional generator kernel on a momentum-space open region. -/
structure HLSDistributionalGeneratorKernelData where
  momentumRegion : TopologicalSpace.Opens HLSMinkowskiVector
  order : ℕ∞
  finite_order : order ≠ ⊤
  kernel : Distribution momentumRegion ℂ order

/-- Elastic amplitude data on a regular physical region after excluding normal thresholds.
Generic scattering is expressed as relative density of nonzero amplitudes in that region. -/
structure HLSAnalyticScatteringData where
  elasticAmplitude : ℂ × ℂ → ℂ
  physicalRegion : Set (ℂ × ℂ)
  normalThresholds : Set (ℂ × ℂ)
  regularPhysicalRegion : Set (ℂ × ℂ)
  physical_region_open : IsOpen physicalRegion
  normal_thresholds_closed : IsClosed normalThresholds
  regular_region : regularPhysicalRegion = physicalRegion \ normalThresholds
  analytic_regular_region : AnalyticOn ℂ elasticAmplitude regularPhysicalRegion
  scattering_occurs : ∃ st ∈ regularPhysicalRegion, elasticAmplitude st ≠ 0
  scattering : regularPhysicalRegion ⊆
    closure {st | st ∈ regularPhysicalRegion ∧ elasticAmplitude st ≠ 0}

/-- Removing closed normal thresholds from the open physical region leaves an open analytic
scattering region. -/
theorem HLSAnalyticScatteringData.regular_region_open (data : HLSAnalyticScatteringData) :
    IsOpen data.regularPhysicalRegion := by
  rw [data.regular_region]
  rw [Set.sdiff_eq]
  exact data.physical_region_open.inter data.normal_thresholds_closed.isOpen_compl

/-- Combined physical S-matrix and analytic elastic-amplitude input.  Relating a concrete Hilbert
space S-matrix to LSZ amplitudes is deliberately left as an explicit further construction rather
than silently identifying these two levels. -/
structure HLSPhysicalAnalyticScatteringInput (A : Type v) (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  physicalScattering : HLSPhysicalScatteringData A E
  analyticElastic : HLSAnalyticScatteringData

/-- One coherent package of the physical HLS input: an integrated, graded symmetry of a
nontrivial unitary S-matrix; massive finite-multiplicity particles; regular analytic elastic
scattering; and distributional kernels for all Poincaré and supercharge generators.  It remains
input data, not a purported premise-free classification theorem. -/
structure HLSPhysicalSystemInput (N B : Type v) [DecidableEq N] (A F : Type w) (E : Type u)
    [AddCommGroup B] [Module ℂ B] [AddCommGroup F] [Module ℂ F]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  weylScattering : HLSPhysicalWeylScatteringData N A E
  fockCompletion : HLSFockStateCompletionData B F E
  fock_sectors_agree : fockCompletion.sectors =
    weylScattering.physicalScattering.particlePoincare.sectors
  bosonicLabel : {a : A //
    ¬ weylScattering.physicalScattering.particlePoincare.particles.fermionic a} → B
  fermionicLabel : {a : A //
    weylScattering.physicalScattering.particlePoincare.particles.fermionic a} → F
  bosonicLabel_state : ∀ a,
    fockCompletion.completion (hlsBosonCreate B F (bosonicLabel a)) =
      weylScattering.physicalScattering.particlePoincare.particles.state a
  fermionicLabel_state : ∀ a,
    fockCompletion.completion (hlsFermionCreate B F (fermionicLabel a)) =
      weylScattering.physicalScattering.particlePoincare.particles.state a
  massive : HLSMassiveSectorRestrictions A E
  massive_particles_agree : massive.particlePoincare =
    weylScattering.physicalScattering.particlePoincare
  oddAdditivity : HLSPhysicalOddAdditiveGeneratorData A E
  oddAdditivity_statistics_agree : oddAdditivity.fermionic =
    weylScattering.physicalScattering.particlePoincare.particles.fermionic
  massPreserving : HLSMassPreservingGeneratorData A
  massPreserving_mass_agrees : massPreserving.mass =
    weylScattering.physicalScattering.particlePoincare.particles.mass
  analyticElastic : HLSAnalyticScatteringData
  translationKernel : Fin 4 → HLSDistributionalGeneratorKernelData
  lorentzKernel : Fin 4 → Fin 4 → HLSDistributionalGeneratorKernelData
  superchargeKernel : N → Fin 2 → HLSDistributionalGeneratorKernelData
  conjugateSuperchargeKernel : N → Fin 2 → HLSDistributionalGeneratorKernelData

/-- A bosonic labelled one-particle state is fixed by the physical fermion parity. -/
theorem HLSPhysicalSystemInput.bosonic_label_parity {N B : Type v} [DecidableEq N]
    {A F : Type w} {E : Type u} [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (data : HLSPhysicalSystemInput N B A F E)
    (a : {a : A //
      ¬ data.weylScattering.physicalScattering.particlePoincare.particles.fermionic a}) :
    data.weylScattering.physicalScattering.particlePoincare.sectors.fermionParity
      (data.weylScattering.physicalScattering.particlePoincare.particles.state a) =
        data.weylScattering.physicalScattering.particlePoincare.particles.state a := by
  have h := data.fockCompletion.parity_boson_creation (data.bosonicLabel a)
  rw [data.fock_sectors_agree, data.bosonicLabel_state] at h
  exact h

/-- A fermionic labelled one-particle state is negated by the physical fermion parity. -/
theorem HLSPhysicalSystemInput.fermionic_label_parity {N B : Type v} [DecidableEq N]
    {A F : Type w} {E : Type u} [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (data : HLSPhysicalSystemInput N B A F E)
    (a : {a : A //
      data.weylScattering.physicalScattering.particlePoincare.particles.fermionic a}) :
    data.weylScattering.physicalScattering.particlePoincare.sectors.fermionParity
      (data.weylScattering.physicalScattering.particlePoincare.particles.state a) =
        -data.weylScattering.physicalScattering.particlePoincare.particles.state a := by
  have h := data.fockCompletion.parity_fermion_creation (data.fermionicLabel a)
  rw [data.fock_sectors_agree, data.fermionicLabel_state] at h
  exact h

/-- The equal-mass selection rule in a full physical input refers to its actual particle masses. -/
theorem HLSPhysicalSystemInput.transition_preserves_particle_mass {N B : Type v} [DecidableEq N]
    {A F : Type w} {E : Type u} [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (data : HLSPhysicalSystemInput N B A F E) (a b : A)
    (hab : data.massPreserving.transition a b) :
    data.weylScattering.physicalScattering.particlePoincare.particles.mass a =
      data.weylScattering.physicalScattering.particlePoincare.particles.mass b := by
  rw [← data.massPreserving_mass_agrees]
  exact data.massPreserving.connects_equal_mass a b hab

/-- The graded sign of a fermionic physical particle is minus one. -/
theorem HLSPhysicalSystemInput.fermionic_graded_sign {N B : Type v} [DecidableEq N]
    {A F : Type w} {E : Type u} [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (data : HLSPhysicalSystemInput N B A F E) (a : A)
    (ha : data.weylScattering.physicalScattering.particlePoincare.particles.fermionic a) :
    data.oddAdditivity.gradedSign a = -1 := by
  apply data.oddAdditivity.fermionic_sign a
  rw [data.oddAdditivity_statistics_agree]
  exact ha

end GaloisForLFunctions.HTGeometry
