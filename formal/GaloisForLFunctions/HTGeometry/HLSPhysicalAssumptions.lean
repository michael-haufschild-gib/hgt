import GaloisForLFunctions.HTGeometry.HLSKinematics
import GaloisForLFunctions.HTGeometry.HLSFockAlgebra
import Mathlib.Analysis.Analytic.Basic
import Mathlib.Analysis.Distribution.Distribution
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.Analysis.InnerProductSpace.LinearPMap
import Mathlib.Analysis.InnerProductSpace.Orthogonal
import Mathlib.Tactic

/-!
# Physical input interfaces for the Haag--Łopuszański--Sohnius theorem

These records make explicit the assumptions that a physical HLS theorem would
need.  They are data interfaces only: this file postulates no axiom, constructs
no purported QFT model, and proves no classification result.  The generator
interface uses Mathlib's densely defined `LinearPMap` adjoint and records actual
self-adjointness; it still does not differentiate a group representation.

Together with `HLSKinematics` and `HLSScattering`, this separates the available
finite algebraic infrastructure from the still-open analytic HLS theorem.
-/

noncomputable section

open scoped Topology

namespace GaloisForLFunctions.HTGeometry

universe u v w

/-- One-dimensional Hilbert subspace generated by a proposed vacuum vector. -/
def hlsVacuumSector {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (vacuum : E) : Submodule ℂ E :=
  Submodule.span ℂ ({vacuum} : Set E)

/-- A Hilbert state space split into vacuum, one-particle, multiparticle, bosonic, and fermionic
sectors.  The fields state an orthogonal, complete sector decomposition but do not construct a
Hilbert completion of the algebraic Fock space. -/
structure HLSStateSectorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  vacuum : E
  oneParticleSector : Submodule ℂ E
  multiparticleSector : Submodule ℂ E
  bosonicSector : Submodule ℂ E
  fermionicSector : Submodule ℂ E
  fermionParity : E ≃ₗᵢ[ℂ] E
  vacuum_normalized : inner ℂ vacuum vacuum = 1
  vacuum_orthogonal_oneParticle : hlsVacuumSector vacuum ⟂ oneParticleSector
  vacuum_orthogonal_multiparticle : hlsVacuumSector vacuum ⟂ multiparticleSector
  oneParticle_orthogonal_multiparticle : oneParticleSector ⟂ multiparticleSector
  sector_complete : hlsVacuumSector vacuum ⊔ oneParticleSector ⊔ multiparticleSector = ⊤
  boson_fermion_orthogonal : bosonicSector ⟂ fermionicSector
  statistics_complete : bosonicSector ⊔ fermionicSector = ⊤
  parity_involutive : ∀ ψ, fermionParity (fermionParity ψ) = ψ
  parity_isometric : ∀ ψ, ‖fermionParity ψ‖ = ‖ψ‖
  bosonic_fixed : ∀ ψ ∈ bosonicSector, fermionParity ψ = ψ
  fermionic_negated : ∀ ψ ∈ fermionicSector, fermionParity ψ = -ψ

/-- One-particle labels with mass, four-momentum, twice-spin, statistics, the mass-shell
condition, positive energy, and finite multiplicity at each exact mass. -/
structure HLSOneParticleData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  state : A → E
  mass : A → ℝ
  momentum : A → HLSMinkowskiVector
  spinTwice : A → ℤ
  fermionic : A → Prop
  state_nonzero : ∀ a, state a ≠ 0
  positive_energy : ∀ a, 0 ≤ momentum a 0
  on_mass_shell : ∀ a, hlsMassShell (mass a) (momentum a)
  spin_statistics : ∀ a, fermionic a ↔ Odd (spinTwice a)
  finite_multiplicity_at_mass : ∀ m, Set.Finite {a | mass a = m}
  finite_multiplicity_below_mass : ∀ m, Set.Finite {a | mass a ≤ m}

/-- Unitary representation of the proper orthochronous Poincaré group. -/
structure HLSPoincareRepresentation (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E)

/-- Strong-operator topology on unitary linear equivalences: pointwise topology after evaluating
an equivalence on every Hilbert-space vector. -/
abbrev hlsStrongUnitaryTopology (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] : TopologicalSpace (E ≃ₗᵢ[ℂ] E) :=
  TopologicalSpace.induced (fun U => fun ψ => U ψ) inferInstance

/-- A physically continuous unitary Poincaré representation.  Continuity is strong (pointwise on
Hilbert vectors), using the explicit Poincaré and strong-operator topologies from this layer. -/
structure HLSStronglyContinuousPoincareRepresentation (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E)
  strongly_continuous : @Continuous HLSPhysicalPoincareGroup (E ≃ₗᵢ[ℂ]
    E) hlsPhysicalPoincareTopology (hlsStrongUnitaryTopology E) action

/-- Forget strong continuity, retaining the underlying unitary Poincaré action. -/
def HLSStronglyContinuousPoincareRepresentation.toPoincareRepresentation {E : Type u}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (ρ : HLSStronglyContinuousPoincareRepresentation E) : HLSPoincareRepresentation E :=
  ⟨ρ.action⟩

/-- Compatibility of labelled one-particle states and the full state-sector split with a unitary
Poincaré representation.  This is the actual positive-energy one-particle representation input;
the mass-shell and energy inequalities live in `HLSOneParticleData`. -/
structure HLSOneParticlePoincareData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sectors : HLSStateSectorData E
  particles : HLSOneParticleData A E
  poincare : HLSPoincareRepresentation E
  vacuum_invariant : ∀ g, poincare.action g sectors.vacuum = sectors.vacuum
  oneParticle_invariant : ∀ g ψ, ψ ∈ sectors.oneParticleSector →
    poincare.action g ψ ∈ sectors.oneParticleSector
  multiparticle_invariant : ∀ g ψ, ψ ∈ sectors.multiparticleSector →
    poincare.action g ψ ∈ sectors.multiparticleSector
  bosonic_invariant : ∀ g ψ, ψ ∈ sectors.bosonicSector →
    poincare.action g ψ ∈ sectors.bosonicSector
  fermionic_invariant : ∀ g ψ, ψ ∈ sectors.fermionicSector →
    poincare.action g ψ ∈ sectors.fermionicSector
  particle_state_in_oneParticle : ∀ a, particles.state a ∈ sectors.oneParticleSector
  bosonic_particle_state : ∀ a, ¬ particles.fermionic a →
    particles.state a ∈ sectors.bosonicSector
  fermionic_particle_state : ∀ a, particles.fermionic a →
    particles.state a ∈ sectors.fermionicSector

/-- A Hilbert-space realization of the algebraic Bose/Fermi Fock core.  Its image is dense in
the physical state space, and the vacuum and one-creation states land in their named sectors.
This records the completion map without pretending that the present file constructs it. -/
structure HLSFockStateCompletionData (B : Type v) (F : Type w) [AddCommGroup B] [Module ℂ B]
    [AddCommGroup F] [Module ℂ F] (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sectors : HLSStateSectorData E
  completion : HLSAlgebraicFock B F →ₗ[ℂ] E
  dense_range : Dense (Set.range completion)
  vacuum_image : completion 1 = sectors.vacuum
  boson_creation_in_bosonic : ∀ b, completion (hlsBosonCreate B F b) ∈ sectors.bosonicSector
  fermion_creation_in_fermionic : ∀ f,
    completion (hlsFermionCreate B F f) ∈ sectors.fermionicSector

/-- Unitary representation of a spin-Poincaré group after supplying the missing algebraic
spin-to-Lorentz cover data. -/
structure HLSSpinPoincareRepresentation (cover : HLSSpinLorentzCoverData) (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  action : HLSSpinPoincareGroup cover →* (E ≃ₗᵢ[ℂ] E)

/-- A genuinely self-adjoint, possibly unbounded Hilbert-space operator.  Mathlib's
`LinearPMap` adjoint makes this stronger than a merely symmetric common-domain map: its domain
is dense and its graph is closed. -/
structure HLSDomainOperator (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  operator : E →ₗ.[ℂ] E
  selfAdjoint : IsSelfAdjoint operator

/-- A self-adjoint HLS generator has a dense domain. -/
theorem HLSDomainOperator.domain_dense {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (T : HLSDomainOperator E) :
    Dense (T.operator.domain : Set E) := T.selfAdjoint.dense_domain

/-- A self-adjoint HLS generator has a closed graph. -/
theorem HLSDomainOperator.graph_closed {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (T : HLSDomainOperator E) :
    IsClosed (T.operator.graph : Set (E × E)) := T.selfAdjoint.isClosed

/-- Self-adjoint translation and Lorentz generators on a dense common invariant domain.  The
nonnegative energy form is the common-domain expression of the positive-energy condition.
Differentiating a group representation to these generators remains additional work. -/
structure HLSInfinitesimalPoincareData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → HLSDomainOperator E
  lorentz : Fin 4 → Fin 4 → HLSDomainOperator E
  translation_domain : ∀ μ, (translation μ).operator.domain = commonDomain
  lorentz_domain : ∀ μ ν, (lorentz μ ν).operator.domain = commonDomain
  translation_invariant : ∀ μ x (hx : x ∈ commonDomain),
    (translation μ).operator ⟨x, by rw [translation_domain μ]; exact hx⟩ ∈ commonDomain
  lorentz_invariant : ∀ μ ν x (hx : x ∈ commonDomain),
    (lorentz μ ν).operator ⟨x, by rw [lorentz_domain μ ν]; exact hx⟩ ∈ commonDomain
  energy_form_nonnegative : ∀ (x : commonDomain),
    0 ≤ (inner ℂ
      ((translation 0).operator ⟨(x : E), by rw [translation_domain 0]; exact x.property⟩)
      (x : E)).re

/-- Translation generator restricted to the common invariant domain. -/
def HLSInfinitesimalPoincareData.translationOnDomain {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (data : HLSInfinitesimalPoincareData E)
    (μ : Fin 4) : data.commonDomain →ₗ[ℂ] data.commonDomain :=
  ((data.translation μ).operator.toFun.comp
    (Submodule.inclusion (by rw [data.translation_domain μ]))).codRestrict data.commonDomain
      (fun x => by
        change (data.translation μ).operator ⟨(x : E), _⟩ ∈ data.commonDomain
        exact data.translation_invariant μ x x.property)

/-- Lorentz generator restricted to the common invariant domain. -/
def HLSInfinitesimalPoincareData.lorentzOnDomain {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (data : HLSInfinitesimalPoincareData E)
    (μ ν : Fin 4) : data.commonDomain →ₗ[ℂ] data.commonDomain :=
  ((data.lorentz μ ν).operator.toFun.comp
    (Submodule.inclusion (by rw [data.lorentz_domain μ ν]))).codRestrict data.commonDomain
      (fun x => by
        change (data.lorentz μ ν).operator ⟨(x : E), _⟩ ∈ data.commonDomain
        exact data.lorentz_invariant μ ν x x.property)

/-- Minkowski metric, regarded as a complex scalar for operator identities. -/
def hlsComplexMinkowskiMetric (μ ν : Fin 4) : ℂ :=
  (hlsMinkowskiMetric μ ν : ℂ)

/-- Commutator of two operators which preserve one common domain. -/
def hlsDomainCommutator {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (D : Submodule ℂ E) (A B : D →ₗ[ℂ] D) : D →ₗ[ℂ] D :=
  A.comp B - B.comp A

/-- Anticommutator of two operators which preserve one common domain. -/
def hlsDomainAnticommutator {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (D : Submodule ℂ E) (A B : D →ₗ[ℂ] D) : D →ₗ[ℂ] D :=
  A.comp B + B.comp A

/-- Exact Poincaré Lie-algebra relations for self-adjoint generators, expressed on their common
invariant domain.  This supplies the infinitesimal Lorentz assumptions used by HLS; it does not
claim that the supplied group action differentiates to these operators. -/
structure HLSInfinitesimalPoincareLieData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  generators : HLSInfinitesimalPoincareData E
  translations_commute : ∀ μ ν,
    hlsDomainCommutator generators.commonDomain (generators.translationOnDomain μ)
      (generators.translationOnDomain ν) = 0
  lorentz_translation : ∀ μ ν ρ,
    hlsDomainCommutator generators.commonDomain (generators.lorentzOnDomain μ ν)
      (generators.translationOnDomain ρ) =
        Complex.I • (hlsComplexMinkowskiMetric ν ρ • generators.translationOnDomain μ -
          hlsComplexMinkowskiMetric μ ρ • generators.translationOnDomain ν)
  lorentz_bracket : ∀ μ ν ρ σ,
    hlsDomainCommutator generators.commonDomain (generators.lorentzOnDomain μ ν)
      (generators.lorentzOnDomain ρ σ) =
        Complex.I •
          (hlsComplexMinkowskiMetric μ σ • generators.lorentzOnDomain ν ρ +
            hlsComplexMinkowskiMetric ν ρ • generators.lorentzOnDomain μ σ -
            hlsComplexMinkowskiMetric μ ρ • generators.lorentzOnDomain ν σ -
            hlsComplexMinkowskiMetric ν σ • generators.lorentzOnDomain μ ρ)

/-- Strong derivative of a unitary one-parameter Poincaré action on a common invariant domain.
The `-i` convention makes a self-adjoint generator `T` satisfy `U(t) = exp(-itT)` formally. -/
def hlsUnitaryGeneratorDerivative {E : Type u} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E]
    (action : HLSPhysicalPoincareGroup →* (E ≃ₗᵢ[ℂ] E))
    (flow : ℝ → HLSPhysicalPoincareGroup) (D : Submodule ℂ E) (T : E →ₗ.[ℂ] E) : Prop :=
  ∀ ψ : D, Tendsto
    (fun t : ℝ => (t : ℂ)⁻¹ • (action (flow t) (ψ : E) - (ψ : E)))
    (𝓝[≠] (0 : ℝ)) (𝓝 (-Complex.I • T ⟨(ψ : E), ψ.property⟩))

/-- Integration data connecting a strongly continuous Poincaré representation with its
self-adjoint infinitesimal translation and Lorentz generators.  Translation flows are fixed to
the concrete coordinate translations; Lorentz flows are continuous one-parameter subgroups
whose derivatives define the named Lorentz generators. -/
structure HLSGeneratorIntegrationData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  representation : HLSStronglyContinuousPoincareRepresentation E
  generators : HLSInfinitesimalPoincareData E
  translationFlow : Fin 4 → ℝ → HLSPhysicalPoincareGroup
  lorentzFlow : Fin 4 → Fin 4 → ℝ → HLSPhysicalPoincareGroup
  translationFlow_eq : ∀ μ t, translationFlow μ t = hlsTranslationAt μ t
  lorentzFlow_zero : ∀ μ ν, lorentzFlow μ ν 0 = 1
  lorentzFlow_add : ∀ μ ν s t,
    lorentzFlow μ ν (s + t) = lorentzFlow μ ν s * lorentzFlow μ ν t
  lorentzFlow_continuous : ∀ μ ν, @Continuous ℝ HLSPhysicalPoincareGroup
    inferInstance hlsPhysicalPoincareTopology (lorentzFlow μ ν)
  translation_derivative : ∀ μ,
    hlsUnitaryGeneratorDerivative representation.action (translationFlow μ) generators.commonDomain
      (generators.translation μ).operator
  lorentz_derivative : ∀ μ ν,
    hlsUnitaryGeneratorDerivative representation.action (lorentzFlow μ ν) generators.commonDomain
      (generators.lorentz μ ν).operator

/-- The invariant alternating tensor on two-component Weyl spinors. -/
def hlsWeylEpsilon : Matrix (Fin 2) (Fin 2) ℂ :=
  !![0, 1;
     -1, 0]

/-- Weyl epsilon is antisymmetric. -/
theorem hlsWeylEpsilon_antisymmetric : hlsWeylEpsilon.transpose = -hlsWeylEpsilon := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hlsWeylEpsilon]

/-- Weyl-spinor transformation and translation-invariance laws on a common invariant domain.
The matrices `lorentzOnSpinor` are supplied representation data; deriving the unique Weyl form
from physical hypotheses is part of the unformalized HLS classification proof. -/
structure HLSWeylSuperchargeData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  lorentz : Fin 4 → Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  supercharge : Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  lorentzOnSpinor : Fin 4 → Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  translation_commutes_supercharge : ∀ μ α,
    hlsDomainCommutator commonDomain (translation μ) (supercharge α) = 0
  lorentz_covariant_supercharge : ∀ μ ν α,
    hlsDomainCommutator commonDomain (lorentz μ ν) (supercharge α) =
      ∑ β, (lorentzOnSpinor μ ν α β) • supercharge β

/-- Full common-domain Weyl superalgebra interface.  It records the mixed anticommutator,
same-chirality central charge, centrality, and positivity used in the HLS classification.  It
does not derive them: that derivation is precisely the remaining physical HLS theorem. -/
structure HLSWeylSuperalgebraData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  commonDomain : Submodule ℂ E
  translation : Fin 4 → commonDomain →ₗ[ℂ] commonDomain
  supercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  conjugateSupercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  sigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  centralCharge : N → N → commonDomain →ₗ[ℂ] commonDomain
  mixed_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator commonDomain (supercharge I α) (conjugateSupercharge J β) =
      ∑ μ, (if I = J then (2 : ℂ) * sigma μ α β else 0) • translation μ
  same_chirality_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator commonDomain (supercharge I α) (supercharge J β) =
      hlsWeylEpsilon α β • centralCharge I J
  centralCharge_antisymmetric : ∀ I J, centralCharge I J = -centralCharge J I
  central_commutes_translation : ∀ I J μ,
    hlsDomainCommutator commonDomain (centralCharge I J) (translation μ) = 0
  central_commutes_supercharge : ∀ I J K α,
    hlsDomainCommutator commonDomain (centralCharge I J) (supercharge K α) = 0
  mixed_positive : ∀ I α (ψ : commonDomain),
    0 ≤ (inner ℂ
      ((hlsDomainAnticommutator commonDomain (supercharge I α)
        (conjugateSupercharge I α) ψ : commonDomain) : E)
      (ψ : E)).re

/-- A full Weyl superalgebra on the same common domain as genuine Poincaré generators.  Unlike
the reusable algebra interface above, this record identifies its translations and Lorentz action
with the self-adjoint Poincaré system, so every HLS bracket is an equation among one set of
physical operators. -/
structure HLSPoincareWeylSuperalgebraData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  poincare : HLSInfinitesimalPoincareLieData E
  supercharge : N → Fin 2 → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  conjugateSupercharge : N → Fin 2 → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  lorentzOnSpinor : Fin 4 → Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  sigma : Fin 4 → Matrix (Fin 2) (Fin 2) ℂ
  centralCharge : N → N → poincare.generators.commonDomain →ₗ[ℂ]
    poincare.generators.commonDomain
  translation_commutes_supercharge : ∀ I μ α,
    hlsDomainCommutator poincare.generators.commonDomain
      (poincare.generators.translationOnDomain μ) (supercharge I α) = 0
  lorentz_covariant_supercharge : ∀ I μ ν α,
    hlsDomainCommutator poincare.generators.commonDomain
      (poincare.generators.lorentzOnDomain μ ν) (supercharge I α) =
        ∑ β, lorentzOnSpinor μ ν α β • supercharge I β
  mixed_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
      (conjugateSupercharge J β) =
        ∑ μ, (if I = J then (2 : ℂ) * sigma μ α β else 0) •
          poincare.generators.translationOnDomain μ
  same_chirality_anticommutator : ∀ I J α β,
    hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
      (supercharge J β) = hlsWeylEpsilon α β • centralCharge I J
  centralCharge_antisymmetric : ∀ I J, centralCharge I J = -centralCharge J I
  central_commutes_translation : ∀ I J μ,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (poincare.generators.translationOnDomain μ) = 0
  central_commutes_lorentz : ∀ I J μ ν,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (poincare.generators.lorentzOnDomain μ ν) = 0
  central_commutes_supercharge : ∀ I J K α,
    hlsDomainCommutator poincare.generators.commonDomain (centralCharge I J)
      (supercharge K α) = 0
  mixed_positive : ∀ I α (ψ : poincare.generators.commonDomain),
    0 ≤ (inner ℂ
      ((hlsDomainAnticommutator poincare.generators.commonDomain (supercharge I α)
        (conjugateSupercharge I α) ψ : poincare.generators.commonDomain) : E)
      (ψ : E)).re

/-- A unitary scattering operator together with its exact Poincaré invariance. -/
structure HLSSMatrixData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  poincare : HLSPoincareRepresentation E
  scattering : E ≃ₗᵢ[ℂ] E
  poincare_invariant : ∀ g ψ,
    scattering (poincare.action g ψ) = poincare.action g (scattering ψ)

/-- S-matrix data tied to the physical state sectors.  Stable vacuum and one-particle states are
fixed by scattering, while the multiparticle sector is invariant. -/
structure HLSPhysicalScatteringData (A : Type v) (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  particlePoincare : HLSOneParticlePoincareData A E
  sMatrix : HLSSMatrixData E
  poincare_agrees : sMatrix.poincare = particlePoincare.poincare
  vacuum_fixed : sMatrix.scattering particlePoincare.sectors.vacuum = particlePoincare.sectors.vacuum
  oneParticle_fixed : ∀ ψ ∈ particlePoincare.sectors.oneParticleSector,
    sMatrix.scattering ψ = ψ
  multiparticle_invariant : ∀ ψ ∈ particlePoincare.sectors.multiparticleSector,
    sMatrix.scattering ψ ∈ particlePoincare.sectors.multiparticleSector

/-- A symmetry generator represented on an S-invariant common domain.  The agreement field makes
the domain action a restriction of the unitary scattering operator, and the final field is the
operator equation `[S, G] = 0`. -/
structure HLSScatteringGeneratorSymmetryData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] where
  sMatrix : HLSSMatrixData E
  commonDomain : Submodule ℂ E
  scatteringOnDomain : commonDomain →ₗ[ℂ] commonDomain
  scattering_agrees : ∀ ψ : commonDomain,
    (scatteringOnDomain ψ : E) = sMatrix.scattering (ψ : E)
  generator : commonDomain →ₗ[ℂ] commonDomain
  generator_commutes_scattering :
    hlsDomainCommutator commonDomain scatteringOnDomain generator = 0

/-- The same scattering-symmetry condition simultaneously for all components of an extended Weyl
supercharge. -/
structure HLSSMatrixWeylSymmetryData (N : Type v) [DecidableEq N] (E : Type u)
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] where
  sMatrix : HLSSMatrixData E
  commonDomain : Submodule ℂ E
  scatteringOnDomain : commonDomain →ₗ[ℂ] commonDomain
  scattering_agrees : ∀ ψ : commonDomain,
    (scatteringOnDomain ψ : E) = sMatrix.scattering (ψ : E)
  supercharge : N → Fin 2 → commonDomain →ₗ[ℂ] commonDomain
  supercharge_commutes_scattering : ∀ I α,
    hlsDomainCommutator commonDomain scatteringOnDomain (supercharge I α) = 0

/-- Additive action on ordered finite asymptotic configurations. -/
structure HLSAdditiveGeneratorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (A : Type v) where
  oneParticleContribution : A → E
  multiparticleContribution : List A → E
  additive : ∀ left right,
    multiparticleContribution (left ++ right) =
      multiparticleContribution left + multiparticleContribution right

/-- The sign by which an odd generator passes one fermionic particle. -/
def hlsFermionSign (isFermionic : Bool) : ℂ := if isFermionic then -1 else 1

/-- Graded additivity for an odd generator on ordered multiparticle configurations. -/
structure HLSOddAdditiveGeneratorData (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (A : Type v) where
  fermionic : A → Bool
  oneParticleContribution : A → E
  multiparticleContribution : List A → E
  empty : multiparticleContribution [] = 0
  prepend_graded : ∀ a configuration,
    multiparticleContribution (a :: configuration) = oneParticleContribution a +
      hlsFermionSign (fermionic a) • multiparticleContribution configuration

/-- An HLS symmetry generator may connect only particle types of equal mass. -/
structure HLSMassPreservingGeneratorData (A : Type u) where
  mass : A → ℝ
  transition : A → A → Prop
  connects_equal_mass : ∀ a b, transition a b → mass a = mass b

/-- Massive-sector assumptions used to avoid vacuum degeneracy, massless infrared behavior, and
infinite low-mass particle towers.  `infraredRegularity` remains a named proposition because the
present finite-order distributional-kernel interface does not formalize massless infrared
estimates. -/
structure HLSMassiveSectorRestrictions (E : Type u) [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (A : Type v) where
  vacuum : E
  vacuumOrbit : Set E
  vacuum_unique : ∀ ψ ∈ vacuumOrbit, ψ = vacuum
  mass : A → ℝ
  positive_mass : ∀ a, 0 < mass a
  mass_gap : ∃ m₀, 0 < m₀ ∧ ∀ a, m₀ ≤ mass a
  infraredRegularity : Prop

/-- A finite-order distributional generator kernel on a momentum-space open region. -/
structure HLSDistributionalGeneratorKernelData where
  momentumRegion : TopologicalSpace.Opens HLSMinkowskiVector
  order : ℕ∞
  kernel : Distribution momentumRegion ℂ order

/-- Elastic amplitude data on a regular physical region after excluding normal thresholds.
Generic scattering is expressed as relative density of nonzero amplitudes in that region. -/
structure HLSAnalyticScatteringData where
  elasticAmplitude : ℂ × ℂ → ℂ
  physicalRegion : Set (ℂ × ℂ)
  normalThresholds : Set (ℂ × ℂ)
  regularPhysicalRegion : Set (ℂ × ℂ)
  regular_region : regularPhysicalRegion = physicalRegion \ normalThresholds
  analytic_regular_region : AnalyticOn ℂ elasticAmplitude regularPhysicalRegion
  scattering_occurs : ∃ st ∈ regularPhysicalRegion, elasticAmplitude st ≠ 0
  scattering_generic : regularPhysicalRegion ⊆
    closure {st | st ∈ regularPhysicalRegion ∧ elasticAmplitude st ≠ 0}

end GaloisForLFunctions.HTGeometry
