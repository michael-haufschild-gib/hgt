import GaloisForLFunctions.HTGeometry.RootFieldTransport

/-!
# The root field of a split polynomial is normal

The base-change and transport laws assume normality of the field generated by the roots of a
polynomial.  Nothing supplied it, although it is free: the corpus already proves that this field is
a splitting field of the polynomial once the polynomial splits in the ambient field, and a splitting
field is normal over its base.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F : Type*} [Field F] {p : Polynomial F}

/-- **The root field of a split polynomial is normal over the base.** -/
theorem normal_rootField {L : Type*} [Field L] [Algebra F L]
    (hp : (p.map (algebraMap F L)).Splits) :
    Normal F (rootField F (L := L) p) :=
  haveI := isSplittingField_rootField (F := F) (p := p) (L := L) hp
  Normal.of_isSplittingField p

/-- Existence form: a split polynomial has a normal root field. -/
theorem exists_normal_rootField {L : Type*} [Field L] [Algebra F L]
    (hp : (p.map (algebraMap F L)).Splits) :
    ∃ _ : Polynomial.IsSplittingField F (rootField F (L := L) p) p,
      Normal F (rootField F (L := L) p) :=
  ⟨isSplittingField_rootField (F := F) (p := p) (L := L) hp, normal_rootField hp⟩

end GaloisForLFunctions.HTGeometry
