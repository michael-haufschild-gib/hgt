import GaloisForLFunctions.HTGeometry.RadialAngularRecurrenceCompletionLaw
import GaloisForLFunctions.RHTower.FiniteKrausRecurrenceFutureFanLaw

/-!
# Operational future fan for finite quantum recurrence

One finite diagonal reference history has radically different admissible
long-time completions.  A normalized reset-noise Kraus channel can remain
below every prescribed finite operational tolerance and nevertheless erase
all initial-state distinguishability.  Around the same reference spectrum,
unitary completions of every positive projective temporal rank remain below
the same prescribed finite Heisenberg tolerance.

The two branches separate asymptotic survival from recurrence arithmetic in
one physically normalized statement.
-/

open Filter
open scoped BigOperators ComplexOrder ENNReal MatrixOrder Topology

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Matrix realization of one unit-time step generated by a finite diagonal
energy list. -/
def finiteDiagonalUnitaryMatrix
    {m : ℕ} (energy : Fin m → ℝ) : RHTower.QuantumMatrix m :=
  Matrix.diagonal (fun i => Complex.exp ((-Complex.I) * energy i))

/-- The finite diagonal matrix realization is unitary. -/
theorem finiteDiagonalUnitaryMatrix_star_mul
    {m : ℕ} (energy : Fin m → ℝ) :
    (finiteDiagonalUnitaryMatrix energy).conjTranspose *
        finiteDiagonalUnitaryMatrix energy = 1 := by
  have hstar :
      (finiteDiagonalUnitaryMatrix energy).conjTranspose =
        Matrix.diagonal
          (fun i => Complex.exp (Complex.I * energy i)) := by
    ext i j
    by_cases hij : i = j
    · subst j
      simp [finiteDiagonalUnitaryMatrix, Matrix.conjTranspose_apply,
        ← Complex.exp_conj]
    · simp [finiteDiagonalUnitaryMatrix, Matrix.conjTranspose_apply,
        hij, Ne.symm hij]
  rw [hstar, finiteDiagonalUnitaryMatrix,
    Matrix.diagonal_mul_diagonal]
  ext i j
  by_cases hij : i = j
  · subst j
    simp [← Complex.exp_add]
  · simp [hij]

/-- A deterministic CPTP completion is uniformly close to the diagonal
unitary reference through `N` and forgets every pair of initial states. -/
def HasCPTPForgettingCompletion
    {d : ℕ} (energy : Fin (d + 1) → ℝ)
    (N : ℕ) (η : ℝ) : Prop :=
  ∃ (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r ≤ 1),
    0 < r ∧ r < 1 ∧
      (∀ ρ : RHTower.DensityMatrix (d + 1), ∀ n ≤ N,
        (RHTower.finiteQuantumOperationalTheory (d + 1)).distance
            ((RHTower.resetMixedKrausChannel
              (finiteDiagonalUnitaryMatrix energy)
              (finiteDiagonalUnitaryMatrix_star_mul energy)
              r hr0 hr1).evolve^[n] ρ)
            ((RHTower.unitaryKrausChannel
              (finiteDiagonalUnitaryMatrix energy)
              (finiteDiagonalUnitaryMatrix_star_mul energy)).evolve^[n] ρ) <
          ENNReal.ofReal η) ∧
      ∀ ρ σ : RHTower.DensityMatrix (d + 1),
        Tendsto
          ((RHTower.resetMixedKrausChannel
            (finiteDiagonalUnitaryMatrix energy)
            (finiteDiagonalUnitaryMatrix_star_mul energy)
            r hr0 hr1).toOperationalChannel.distanceAt ρ σ)
          atTop (𝓝 0)

/-- A unitary completion of exact temporal rank `k` remains uniformly close
to the same reference through the chosen continuous-time horizon. -/
def HasAngularRankCompletion
    {d : ℕ} (energy : Fin (d + 1) → ℝ)
    (k : ℕ) (H η : ℝ) : Prop :=
  ∃ perturbed : Fin (d + 1) → ℝ,
    projectiveTemporalRank perturbed = k ∧
      (∀ i, dist (perturbed i) (energy i) < η / (2 * (H + 1))) ∧
      FiniteIndexAngularApproximation energy perturbed H η

/-- **Operational quantum-recurrence future fan.** Every finite diagonal
reference record has one deterministic CPTP completion that erases all
initial-state information, while for every admissible positive integer
`k` it also has a nearby unitary completion of exact temporal dimension
`k`.  Both conclusions hold at arbitrary positive finite tolerance and
arbitrary prescribed finite horizons. -/
theorem finiteQuantumObservation_futureFan
    {d : ℕ} (energy : Fin (d + 1) → ℝ)
    (N : ℕ) (H η : ℝ) (hH : 0 ≤ H) (hη : 0 < η) :
    HasCPTPForgettingCompletion energy N η ∧
      ∀ k : ℕ, 0 < k → k ≤ d →
        HasAngularRankCompletion energy k H η := by
  constructor
  · exact RHTower.exists_CPTP_finiteHorizon_close_unitary_and_forgetting
      (finiteDiagonalUnitaryMatrix energy)
      (finiteDiagonalUnitaryMatrix_star_mul energy) N η hη
  · intro k hk hkd
    obtain ⟨perturbed, hrank, henergy, hangular⟩ :=
      exists_finiteHorizonIndistinguishable_exactProjectiveTemporalRank
        hk hkd energy H η hH hη
    exact ⟨perturbed, hrank, henergy, by
      simpa [FiniteIndexAngularApproximation,
        finiteIndexHeisenbergEvolution, heisenbergConjugation] using hangular⟩

end GaloisForLFunctions.HTGeometry

