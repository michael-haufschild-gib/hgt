import GaloisForLFunctions.HTGeometry.SeparableBuresProbabilityDesignLaw
import GaloisForLFunctions.HTGeometry.SchattenOneBanach
import GaloisForLFunctions.HTGeometry.HilbertSchmidtFiniteRankDensity
import Mathlib.Analysis.Convex.Integral

/-!
# Compact target covariance bodies in separable Hilbert space

For a norm-compact family `V`, this module builds the closed real convex hull
of its positive rank-one rays in the genuine Schatten-one Banach space.  The
body is trace-norm compact without a finite-dimensional, finite-rank, or
finite-target assumption.  It also proves that every probability covariance
supported on `V` belongs to this same compact body.
-/

noncomputable section

namespace RHTower

open MeasureTheory Set
open scoped InnerProductSpace

variable {X H : Type*} [MeasurableSpace X]
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Positive rank-one rays generated by an occupied target family. -/
def separableBuresTargetRaySet (V : Set H) :
    Set (SchattenOneOperator H) :=
  positiveRankOneSchattenOne '' V

/-- Closed convex target covariance body, with closure taken in trace norm. -/
def separableBuresCompactTargetBody (V : Set H) :
    Set (SchattenOneOperator H) :=
  closedConvexHull ℝ (separableBuresTargetRaySet V)

theorem positiveRankOneSchattenOne_mem_targetBody
    {V : Set H} {v : H} (hv : v ∈ V) :
    positiveRankOneSchattenOne v ∈ separableBuresCompactTargetBody V := by
  apply subset_closedConvexHull
  exact ⟨v, hv, rfl⟩

theorem separableBuresCompactTargetBody_nonempty
    {V : Set H} (hV : V.Nonempty) :
    (separableBuresCompactTargetBody V).Nonempty := by
  obtain ⟨v, hv⟩ := hV
  exact ⟨positiveRankOneSchattenOne v,
    positiveRankOneSchattenOne_mem_targetBody hv⟩

theorem separableBuresCompactTargetBody_convex (V : Set H) :
    Convex ℝ (separableBuresCompactTargetBody V) :=
  convex_closedConvexHull

theorem separableBuresCompactTargetBody_isClosed (V : Set H) :
    IsClosed (separableBuresCompactTargetBody V) :=
  isClosed_closedConvexHull

/-- **Infinite-dimensional compact target-body theorem.**  A norm-compact
target family generates a trace-norm compact closed convex covariance body. -/
theorem separableBuresCompactTargetBody_isCompact
    {V : Set H} (hV : IsCompact V) :
    IsCompact (separableBuresCompactTargetBody V) := by
  rw [separableBuresCompactTargetBody,
    closedConvexHull_eq_closure_convexHull]
  have hray : IsCompact (separableBuresTargetRaySet V) :=
    hV.image continuous_positiveRankOneSchattenOne
  have hconv : TotallyBounded
      (convexHull ℝ (separableBuresTargetRaySet V)) :=
    totallyBounded_convexHull _ hray.totallyBounded
  exact hconv.closure.isCompact_of_isClosed isClosed_closure

/-- Closed-unit-ball target rays generate a trace-norm unit body. -/
theorem separableBuresCompactTargetBody_norm_le_one
    {V : Set H} (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1) :
    ∀ M ∈ separableBuresCompactTargetBody V, ‖M‖ ≤ 1 := by
  have hray : separableBuresTargetRaySet V ⊆
      Metric.closedBall (0 : SchattenOneOperator H) 1 := by
    rintro M ⟨v, hv, rfl⟩
    rw [Metric.mem_closedBall, dist_zero_right,
      norm_positiveRankOneSchattenOne]
    nlinarith [norm_nonneg v, hVnorm v hv]
  have hbody : separableBuresCompactTargetBody V ⊆
      Metric.closedBall (0 : SchattenOneOperator H) 1 := by
    exact closedConvexHull_min hray (convex_closedBall 0 1)
      Metric.isClosed_closedBall
  intro M hM
  simpa [Metric.mem_closedBall, dist_zero_right] using hbody hM

/-- Every element of the target body remains a positive operator. -/
theorem separableBuresCompactTargetBody_isPositive
    (V : Set H) {M : SchattenOneOperator H}
    (hM : M ∈ separableBuresCompactTargetBody V) :
    (M : H →L[ℂ] H).IsPositive := by
  let forgetReal : SchattenOneOperator H →L[ℝ] (H →L[ℂ] H) :=
    schattenOneCoeCLM.restrictScalars ℝ
  have hrays : separableBuresTargetRaySet V ⊆
      forgetReal ⁻¹' Set.Ici (0 : H →L[ℂ] H) := by
    rintro M ⟨v, _hv, rfl⟩
    change 0 ≤ InnerProductSpace.rankOne ℂ v v
    exact (ContinuousLinearMap.nonneg_iff_isPositive _).2
      (InnerProductSpace.isPositive_rankOne_self v)
  have hbody : separableBuresCompactTargetBody V ⊆
      forgetReal ⁻¹' Set.Ici (0 : H →L[ℂ] H) := by
    apply closedConvexHull_min hrays
    · exact (convex_Ici (0 : H →L[ℂ] H)).linear_preimage
        forgetReal.toLinearMap
    · exact CStarAlgebra.isClosed_nonneg.preimage forgetReal.continuous
  exact (ContinuousLinearMap.nonneg_iff_isPositive _).1 (hbody hM)

/-- Every genuine probability covariance supported on `V` has a unique
Schatten-one representative in the compact target body. -/
theorem targetProbabilityCovariance_mem_separableBuresCompactTargetBody
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    {M : H →L[ℂ] H} (hM : IsTargetProbabilityCovariance V M) :
    ∃ M₁ : SchattenOneOperator H,
      (M₁ : H →L[ℂ] H) = M ∧
      M₁ ∈ separableBuresCompactTargetBody V := by
  obtain ⟨design, t, htId, htV, rfl⟩ := hM
  let ray : H → SchattenOneOperator H := positiveRankOneSchattenOne
  have hrayMeas : AEStronglyMeasurable ray (design : Measure H) :=
    continuous_positiveRankOneSchattenOne.aestronglyMeasurable
  have hrayInt : Integrable ray (design : Measure H) := by
    apply Integrable.of_bound hrayMeas 1
    filter_upwards [htV] with v hv
    rw [show ray v = positiveRankOneSchattenOne v by rfl,
      norm_positiveRankOneSchattenOne]
    nlinarith [norm_nonneg v, hVnorm v hv]
  let M₁ : SchattenOneOperator H := ∫ v, ray v ∂(design : Measure H)
  have hM₁body : M₁ ∈ separableBuresCompactTargetBody V := by
    apply (separableBuresCompactTargetBody_convex V).integral_mem
      (separableBuresCompactTargetBody_isClosed V)
    · filter_upwards [htV] with v hv
      exact positiveRankOneSchattenOne_mem_targetBody hv
    · exact hrayInt
  refine ⟨M₁, ?_, hM₁body⟩
  have hforget := schattenOneCoeCLM.integral_comp_comm hrayInt
  have hopInt : Integrable
      (fun v ↦ schattenOneCoeCLM (ray v)) (design : Measure H) :=
    schattenOneCoeCLM.integrable_comp hrayInt
  apply ContinuousLinearMap.ext
  intro q
  rw [rangeCovariance_l2Synthesis_apply]
  change (schattenOneCoeCLM M₁) q = _
  rw [← hforget]
  rw [ContinuousLinearMap.integral_apply hopInt q]
  apply integral_congr_ae
  filter_upwards [htId] with v hv
  rw [show ray v = positiveRankOneSchattenOne v by rfl,
    schattenOneCoeCLM_apply]
  change inner ℂ v q • v = inner ℂ (t v) q • t v
  rw [hv]

/-- The positive square root of every unit-ball target probability covariance
is Hilbert--Schmidt with norm at most one. -/
theorem targetProbabilityCovariance_root_isHilbertSchmidt_norm_le_one
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    {M : H →L[ℂ] H} (hM : IsTargetProbabilityCovariance V M) :
    (CFC.sqrt M).IsHilbertSchmidt ∧
      ContinuousLinearMap.hsNorm (CFC.sqrt M) ≤ 1 := by
  obtain ⟨design, t, htId, htV, rfl⟩ := hM
  let T := l2Synthesis (design : Measure H) t
  have hT : T.IsHilbertSchmidt := l2Synthesis_isHilbertSchmidt _ t
  have htBound : ∀ᵐ v ∂(design : Measure H), ‖t v‖ ≤ 1 := by
    filter_upwards [htId, htV] with v htv hv
    rw [htv]
    exact hVnorm v hv
  have htNorm : ‖t‖ ≤ 1 := by
    have h := Lp.norm_le_of_ae_bound (p := (2 : ENNReal))
      (μ := (design : Measure H)) zero_le_one htBound
    have hmass : measureUnivNNReal (design : Measure H) = 1 := by
      simp [measureUnivNNReal]
    rw [hmass] at h
    simpa using h
  obtain ⟨S, hS, hfactor⟩ := exists_rangeCovarianceRoot_factor_through T
  have hroot : CFC.sqrt (rangeCovariance T) = T ∘L S := hfactor
  have hrootHS : (CFC.sqrt (rangeCovariance T)).IsHilbertSchmidt := by
    rw [hroot]
    exact hT.comp_right S
  refine ⟨hrootHS, ?_⟩
  rw [hroot]
  calc
    ContinuousLinearMap.hsNorm (T ∘L S) ≤
        ContinuousLinearMap.hsNorm T * ‖S‖ :=
      hT.hsNorm_comp_right_le S
    _ ≤ ‖t‖ * 1 := by
      rw [hsNorm_l2Synthesis_eq_norm]
      exact mul_le_mul_of_nonneg_left hS (norm_nonneg t)
    _ ≤ 1 := by simpa using htNorm

/-- Genuine target probability covariances are closed under real convex
mixtures.  The witness is the literal convex mixture of the two probability
laws, not an auxiliary covariance. -/
theorem isTargetProbabilityCovariance_real_convex
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} {M N : H →L[ℂ] H}
    (hM : IsTargetProbabilityCovariance V M)
    (hN : IsTargetProbabilityCovariance V N)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    IsTargetProbabilityCovariance V
      ((a : ℂ) • M + (b : ℂ) • N) := by
  obtain ⟨p, tp, htpId, hpV, hpCov⟩ := hM
  obtain ⟨q, tq, htqId, hqV, hqCov⟩ := hN
  let wa : ENNReal := ENNReal.ofReal a
  let wb : ENNReal := ENNReal.ofReal b
  let mixMeasure : Measure H :=
    wa • (p : Measure H) + wb • (q : Measure H)
  have hmixProb : IsProbabilityMeasure mixMeasure := ⟨by
    simp only [mixMeasure, Measure.add_apply, Measure.smul_apply,
      IsProbabilityMeasure.measure_univ, smul_eq_mul, mul_one]
    rw [show wa = ENNReal.ofReal a by rfl,
      show wb = ENNReal.ofReal b by rfl,
      ← ENNReal.ofReal_add ha hb, hab, ENNReal.ofReal_one]⟩
  let design : ProbabilityMeasure H := ⟨mixMeasure, hmixProb⟩
  have hdesignV : ∀ᵐ v ∂(design : Measure H), v ∈ V := by
    rw [ae_iff] at hpV hqV ⊢
    change mixMeasure {v | v ∉ V} = 0
    simp [mixMeasure, hpV, hqV]
  have hidP : MemLp (fun v : H ↦ v) 2 (p : Measure H) :=
    (memLp_congr_ae htpId.symm).2 (Lp.memLp tp)
  have hidQ : MemLp (fun v : H ↦ v) 2 (q : Measure H) :=
    (memLp_congr_ae htqId.symm).2 (Lp.memLp tq)
  have hmeasP :=
    (measurable_id : Measurable (fun v : H ↦ v)).aestronglyMeasurable
      (μ := (p : Measure H))
  have hmeasQ :=
    (measurable_id : Measurable (fun v : H ↦ v)).aestronglyMeasurable
      (μ := (q : Measure H))
  have hintP : Integrable (fun v : H ↦ ‖v‖ ^ 2) (p : Measure H) :=
    (memLp_two_iff_integrable_sq_norm hmeasP).1 hidP
  have hintQ : Integrable (fun v : H ↦ ‖v‖ ^ 2) (q : Measure H) :=
    (memLp_two_iff_integrable_sq_norm hmeasQ).1 hidQ
  have hidMem : MemLp (fun v : H ↦ v) 2 (design : Measure H) := by
    have hintMix : Integrable (fun v : H ↦ ‖v‖ ^ 2) mixMeasure :=
      (hintP.smul_measure (by simp [wa])).add_measure
        (hintQ.smul_measure (by simp [wb]))
    have hmeasMix :=
      (measurable_id : Measurable (fun v : H ↦ v)).aestronglyMeasurable
        (μ := (design : Measure H))
    exact (memLp_two_iff_integrable_sq_norm hmeasMix).2 hintMix
  let t : Lp H 2 (design : Measure H) :=
    hidMem.toLp (fun v : H ↦ v)
  have htId : (t : H → H) =ᵐ[(design : Measure H)] (fun v ↦ v) :=
    hidMem.coeFn_toLp
  refine ⟨design, t, htId, hdesignV, ?_⟩
  rw [hpCov, hqCov]
  apply ContinuousLinearMap.ext
  intro r
  let f : H → H := fun v ↦ inner ℂ v r • v
  have hfMeas : AEStronglyMeasurable f (p : Measure H) :=
    ((continuous_id.inner continuous_const).smul continuous_id).aestronglyMeasurable
  have hfMeasQ : AEStronglyMeasurable f (q : Measure H) :=
    ((continuous_id.inner continuous_const).smul continuous_id).aestronglyMeasurable
  have hfP : Integrable f (p : Measure H) := by
    refine Integrable.mono' (hintP.const_mul ‖r‖) hfMeas ?_
    filter_upwards with v
    calc
      ‖f v‖ = ‖inner ℂ v r‖ * ‖v‖ := norm_smul _ _
      _ ≤ (‖v‖ * ‖r‖) * ‖v‖ :=
        mul_le_mul_of_nonneg_right (norm_inner_le_norm v r) (norm_nonneg v)
      _ = ‖r‖ * ‖v‖ ^ 2 := by ring
  have hfQ : Integrable f (q : Measure H) := by
    refine Integrable.mono' (hintQ.const_mul ‖r‖) hfMeasQ ?_
    filter_upwards with v
    calc
      ‖f v‖ = ‖inner ℂ v r‖ * ‖v‖ := norm_smul _ _
      _ ≤ (‖v‖ * ‖r‖) * ‖v‖ :=
        mul_le_mul_of_nonneg_right (norm_inner_le_norm v r) (norm_nonneg v)
      _ = ‖r‖ * ‖v‖ ^ 2 := by ring
  have hcovP :
      rangeCovariance (l2Synthesis (p : Measure H) tp) r =
        ∫ v, f v ∂(p : Measure H) := by
    rw [rangeCovariance_l2Synthesis_apply]
    apply integral_congr_ae
    filter_upwards [htpId] with v hv
    simp only [f, hv]
  have hcovQ :
      rangeCovariance (l2Synthesis (q : Measure H) tq) r =
        ∫ v, f v ∂(q : Measure H) := by
    rw [rangeCovariance_l2Synthesis_apply]
    apply integral_congr_ae
    filter_upwards [htqId] with v hv
    simp only [f, hv]
  have hcovMix :
      rangeCovariance (l2Synthesis (design : Measure H) t) r =
        ∫ v, f v ∂(design : Measure H) := by
    rw [rangeCovariance_l2Synthesis_apply]
    apply integral_congr_ae
    filter_upwards [htId] with v hv
    simp only [f, hv]
  rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.smul_apply, hcovP, hcovQ, hcovMix]
  change (a : ℂ) • (∫ v, f v ∂(p : Measure H)) +
      (b : ℂ) • (∫ v, f v ∂(q : Measure H)) =
    ∫ v, f v ∂(wa • (p : Measure H) + wb • (q : Measure H))
  rw [integral_add_measure
    (hfP.smul_measure (by simp [wa]))
    (hfQ.smul_measure (by simp [wb])),
    integral_smul_measure, integral_smul_measure]
  simp only [wa, wb, ENNReal.toReal_ofReal ha, ENNReal.toReal_ofReal hb]
  rw [RCLike.real_smul_eq_coe_smul (K := ℂ),
    RCLike.real_smul_eq_coe_smul (K := ℂ)]
  rfl

/-- Every generating ray is itself the covariance of the Dirac probability
law at its generating target. -/
theorem positiveRankOne_isTargetProbabilityCovariance
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} {v : H} (hv : v ∈ V) :
    IsTargetProbabilityCovariance V
      (InnerProductSpace.rankOne ℂ v v) := by
  let design : ProbabilityMeasure H :=
    ⟨Measure.dirac v, Measure.dirac.isProbabilityMeasure⟩
  have hidMem : MemLp (fun x : H ↦ x) 2 (design : Measure H) := by
    refine MemLp.of_bound
      (measurable_id : Measurable (fun x : H ↦ x)).aestronglyMeasurable
      ‖v‖ ?_
    change ∀ᵐ x ∂Measure.dirac v, ‖x‖ ≤ ‖v‖
    rw [MeasureTheory.ae_dirac_eq]
    exact le_refl ‖v‖
  let t : Lp H 2 (design : Measure H) :=
    hidMem.toLp (fun x : H ↦ x)
  have htId : (t : H → H) =ᵐ[(design : Measure H)] (fun x ↦ x) :=
    hidMem.coeFn_toLp
  refine ⟨design, t, htId, ?_, ?_⟩
  · change ∀ᵐ x ∂Measure.dirac v, x ∈ V
    rw [MeasureTheory.ae_dirac_eq]
    exact hv
  · apply ContinuousLinearMap.ext
    intro r
    rw [rangeCovariance_l2Synthesis_apply]
    calc
      inner ℂ v r • v = ∫ x, inner ℂ x r • x ∂Measure.dirac v := by
        rw [integral_dirac]
      _ = ∫ x, inner ℂ (t x) r • t x ∂(design : Measure H) := by
        apply integral_congr_ae
        filter_upwards [htId] with x hx
        rw [hx]

/-- Every finite real convex combination of generating rays is a genuine
target probability covariance. -/
theorem convexHull_targetRaySet_isTargetProbabilityCovariance
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} {M : SchattenOneOperator H}
    (hM : M ∈ convexHull ℝ (separableBuresTargetRaySet V)) :
    IsTargetProbabilityCovariance V (M : H →L[ℂ] H) := by
  let targetSet : Set (SchattenOneOperator H) :=
    {A | IsTargetProbabilityCovariance V (A : H →L[ℂ] H)}
  have hray : separableBuresTargetRaySet V ⊆ targetSet := by
    rintro A ⟨v, hv, rfl⟩
    exact positiveRankOne_isTargetProbabilityCovariance hv
  have hconv : Convex ℝ targetSet := by
    rw [convex_iff_add_mem]
    intro A hA B hB a b ha hb hab
    change IsTargetProbabilityCovariance V (A : H →L[ℂ] H) at hA
    change IsTargetProbabilityCovariance V (B : H →L[ℂ] H) at hB
    change IsTargetProbabilityCovariance V
      ((a : ℂ) • (A : H →L[ℂ] H) +
        (b : ℂ) • (B : H →L[ℂ] H))
    exact isTargetProbabilityCovariance_real_convex hA hB ha hb hab
  exact convexHull_min hray hconv hM

/-- Every point of the trace-norm closed target body has a Hilbert--Schmidt
positive square root of norm at most one.  Probability-law witnesses are
needed only on the dense finite convex hull; lower semicontinuity carries the
uniform root bound through trace-norm closure. -/
theorem separableBuresCompactTargetBody_root_isHilbertSchmidt_norm_le_one
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    {M : SchattenOneOperator H}
    (hM : M ∈ separableBuresCompactTargetBody V) :
    (CFC.sqrt (M : H →L[ℂ] H)).IsHilbertSchmidt ∧
      ContinuousLinearMap.hsNorm (CFC.sqrt (M : H →L[ℂ] H)) ≤ 1 := by
  have hMclosure : M ∈
      closure (convexHull ℝ (separableBuresTargetRaySet V)) := by
    simpa [separableBuresCompactTargetBody,
      closedConvexHull_eq_closure_convexHull] using hM
  obtain ⟨Mn, hMnHull, hMnLim⟩ :=
    mem_closure_iff_seq_limit.mp hMclosure
  have hMnBody : ∀ n,
      Mn n ∈ separableBuresCompactTargetBody V := by
    intro n
    exact convexHull_subset_closedConvexHull (hMnHull n)
  have hMnPos : ∀ n, 0 ≤ (Mn n : H →L[ℂ] H) := by
    intro n
    exact (ContinuousLinearMap.nonneg_iff_isPositive _).2
      (separableBuresCompactTargetBody_isPositive V (hMnBody n))
  have hMPos : 0 ≤ (M : H →L[ℂ] H) :=
    (ContinuousLinearMap.nonneg_iff_isPositive _).2
      (separableBuresCompactTargetBody_isPositive V hM)
  have hCoeLim : Filter.Tendsto (fun n ↦ (Mn n : H →L[ℂ] H)) Filter.atTop
      (nhds (M : H →L[ℂ] H)) :=
    schattenOneCoeCLM.continuous.continuousAt.tendsto.comp hMnLim
  have hRootLim : Filter.Tendsto
      (fun n ↦ CFC.sqrt (Mn n : H →L[ℂ] H)) Filter.atTop
      (nhds (CFC.sqrt (M : H →L[ℂ] H))) := by
    have hSqrtContinuous : ContinuousOn
        (CFC.sqrt : (H →L[ℂ] H) → H →L[ℂ] H)
        {A : H →L[ℂ] H | 0 ≤ A} := CFC.continuousOn_sqrt
    apply (hSqrtContinuous (M : H →L[ℂ] H) hMPos).tendsto.comp
    exact tendsto_nhdsWithin_iff.mpr
      ⟨hCoeLim, Filter.Eventually.of_forall hMnPos⟩
  have hRootN : ∀ n,
      (CFC.sqrt (Mn n : H →L[ℂ] H)).IsHilbertSchmidt ∧
        ContinuousLinearMap.hsNorm
          (CFC.sqrt (Mn n : H →L[ℂ] H)) ≤ 1 := by
    intro n
    exact targetProbabilityCovariance_root_isHilbertSchmidt_norm_le_one
      hVnorm
      (convexHull_targetRaySet_isTargetProbabilityCovariance (hMnHull n))
  exact ContinuousLinearMap.isHilbertSchmidt_and_hsNorm_le_of_tendsto zero_le_one
    (fun n ↦ (hRootN n).1) (fun n ↦ (hRootN n).2) hRootLim

/-- Mixed-topology continuity of a nuclear product.  Operator-norm
convergence of a uniformly Hilbert--Schmidt-bounded right factor is enough
for trace-norm continuity after multiplication by one fixed
Hilbert--Schmidt left factor. -/
theorem traceNorm_comp_tendsto_of_fixed_hilbertSchmidt_of_unit_hsBound
    [TopologicalSpace.SeparableSpace H]
    {A : H →L[ℂ] H} (hA : A.IsHilbertSchmidt)
    {Bseq : ℕ → H →L[ℂ] H} {B : H →L[ℂ] H}
    (hBseq : ∀ n, (Bseq n).IsHilbertSchmidt)
    (hB : B.IsHilbertSchmidt)
    (hBseqBound : ∀ n, ContinuousLinearMap.hsNorm (Bseq n) ≤ 1)
    (hBBound : ContinuousLinearMap.hsNorm B ≤ 1)
    (hlim : Filter.Tendsto Bseq Filter.atTop (nhds B)) :
    Filter.Tendsto
      (fun n ↦ traceNorm H (A ∘L Bseq n)) Filter.atTop
      (nhds (traceNorm H (A ∘L B))) := by
  let Sseq : ℕ → SchattenOneOperator H := fun n ↦
    ⟨A ∘L Bseq n, memSchattenClass_one_comp hA (hBseq n)⟩
  let S : SchattenOneOperator H :=
    ⟨A ∘L B, memSchattenClass_one_comp hA hB⟩
  have hSseq : Filter.Tendsto Sseq Filter.atTop (nhds S) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨s, hsRank, hsApprox⟩ :=
      hA.exists_hasRankLE_hsNorm_sub_lt (show 0 < ε / 4 by positivity)
    let A₀ : H →L[ℂ] H :=
      ContinuousLinearMap.hsTruncation (ContinuousLinearMap.hsBasis ℂ H) A s
    have hA₀HS : A₀.IsHilbertSchmidt :=
      (memSchattenClass_two_iff_isHilbertSchmidt A₀).mp
        (memSchattenClass_of_hasRankLE (by norm_num) hsRank)
    have hAerr : (A - A₀).IsHilbertSchmidt := hA.sub hA₀HS
    let c : ℝ := (s.card : ℝ) * ‖A₀‖
    have hc : 0 ≤ c := mul_nonneg (Nat.cast_nonneg _) (norm_nonneg A₀)
    have hc1 : 0 < c + 1 := by linarith
    have hδ : 0 < ε / (2 * (c + 1)) := by positivity
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim _ hδ
    refine ⟨N, fun n hn ↦ ?_⟩
    let D : H →L[ℂ] H := Bseq n - B
    have hDHS : D.IsHilbertSchmidt := (hBseq n).sub hB
    have hDHSBound : ContinuousLinearMap.hsNorm D ≤ 2 := by
      have htri := ContinuousLinearMap.hsNorm_add_le (hBseq n) hB.neg
      have hneg : ContinuousLinearMap.hsNorm (-B) =
          ContinuousLinearMap.hsNorm B := by
        rw [ContinuousLinearMap.hsNorm,
          ContinuousLinearMap.hsNormSq_neg_eq_self]
        rfl
      rw [hneg] at htri
      change ContinuousLinearMap.hsNorm (Bseq n - B) ≤ 2
      rw [sub_eq_add_neg]
      linarith [hBseqBound n, hBBound]
    have hDnorm : ‖D‖ < ε / (2 * (c + 1)) := by
      simpa only [D, dist_eq_norm] using hN n hn
    have hfirst : traceNorm H ((A - A₀) ∘L D) < ε / 2 := by
      calc
        traceNorm H ((A - A₀) ∘L D) =
            rectTraceNorm H H ((A - A₀) ∘L D) :=
          (rectTraceNorm_eq_traceNorm _).symm
        _ ≤ ContinuousLinearMap.hsNorm D *
            ContinuousLinearMap.hsNorm (A - A₀) :=
          rectTraceNorm_comp_le_hsNorm_mul_hsNorm hDHS hAerr
        _ ≤ 2 * ContinuousLinearMap.hsNorm (A - A₀) :=
          mul_le_mul_of_nonneg_right hDHSBound
            (ContinuousLinearMap.hsNorm_nonneg _)
        _ < 2 * (ε / 4) :=
          mul_lt_mul_of_pos_left hsApprox (by norm_num)
        _ = ε / 2 := by ring
    have hsecond : traceNorm H (A₀ ∘L D) < ε / 2 := by
      have hrank : HasRankLE (A₀ ∘L D) s.card :=
        hasRankLE_comp_right hsRank D
      calc
        traceNorm H (A₀ ∘L D) ≤
            (s.card : ℝ) * ‖A₀ ∘L D‖ :=
          traceNorm_le_rank_mul_norm_of_hasRankLE hrank
        _ ≤ (s.card : ℝ) * (‖A₀‖ * ‖D‖) :=
          mul_le_mul_of_nonneg_left
            (ContinuousLinearMap.opNorm_comp_le A₀ D) (Nat.cast_nonneg _)
        _ = c * ‖D‖ := by simp [c]; ring
        _ ≤ (c + 1) * ‖D‖ :=
          mul_le_mul_of_nonneg_right (by linarith)
            (norm_nonneg D)
        _ < (c + 1) * (ε / (2 * (c + 1))) :=
          mul_lt_mul_of_pos_left hDnorm hc1
        _ = ε / 2 := by field_simp
    have hfirstMem : MemSchattenClass 1 ((A - A₀) ∘L D) :=
      memSchattenClass_one_comp hAerr hDHS
    have hsecondRank : HasRankLE (A₀ ∘L D) s.card :=
      hasRankLE_comp_right hsRank D
    have hsecondMem : MemSchattenClass 1 (A₀ ∘L D) :=
      memSchattenClass_of_hasRankLE one_pos hsecondRank
    have hdecomp : A ∘L D = (A - A₀) ∘L D + A₀ ∘L D := by
      ext x
      simp [D]
      module
    have htotal : traceNorm H (A ∘L D) < ε := by
      rw [hdecomp]
      have htri := traceNorm_add_le
        (hfirstMem.isCompactOperator one_pos)
        (hsecondMem.isCompactOperator one_pos)
        hfirstMem.one_summable hsecondMem.one_summable
      linarith
    rw [dist_eq_norm, SchattenOneOperator.norm_def]
    have hcoe :
        (((Sseq n - S : SchattenOneOperator H) : H →L[ℂ] H)) =
          A ∘L D := by
      ext x
      simp [Sseq, S, D]
    rw [hcoe]
    exact htotal
  have hnorm : Filter.Tendsto (fun n ↦ ‖Sseq n‖) Filter.atTop
      (nhds ‖S‖) := by
    simpa only [Function.comp_def] using tendsto_norm.comp hSseq
  change Filter.Tendsto
    (fun n ↦ traceNorm H (A ∘L Bseq n)) Filter.atTop
    (nhds (traceNorm H (A ∘L B))) at hnorm
  exact hnorm

/-- Bures root fidelity against a fixed Hilbert--Schmidt source root is
continuous on the entire infinite-dimensional compact target body in its
trace-norm topology. -/
theorem continuousOn_operatorBuresRootFidelity_compactTargetBody
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    (C : H →L[ℂ] H) (hCroot : (CFC.sqrt C).IsHilbertSchmidt) :
    ContinuousOn
      (fun M : SchattenOneOperator H ↦
        operatorBuresRootFidelity C (M : H →L[ℂ] H))
      (separableBuresCompactTargetBody V) := by
  rw [continuousOn_iff_continuous_restrict,
    continuous_iff_seqContinuous]
  intro M Mlim hMlim
  have hBaseLim : Filter.Tendsto
      (fun n ↦ (M n : SchattenOneOperator H)) Filter.atTop
      (nhds (Mlim : SchattenOneOperator H)) :=
    tendsto_subtype_rng.mp hMlim
  have hCoeLim : Filter.Tendsto
      (fun n ↦ ((M n : SchattenOneOperator H) : H →L[ℂ] H))
      Filter.atTop
      (nhds ((Mlim : SchattenOneOperator H) : H →L[ℂ] H)) :=
    schattenOneCoeCLM.continuous.continuousAt.tendsto.comp hBaseLim
  have hPosSeq : ∀ n,
      0 ≤ ((M n : SchattenOneOperator H) : H →L[ℂ] H) := by
    intro n
    exact (ContinuousLinearMap.nonneg_iff_isPositive _).2
      (separableBuresCompactTargetBody_isPositive V (M n).property)
  have hPosLim :
      0 ≤ ((Mlim : SchattenOneOperator H) : H →L[ℂ] H) :=
    (ContinuousLinearMap.nonneg_iff_isPositive _).2
      (separableBuresCompactTargetBody_isPositive V Mlim.property)
  have hRootLim : Filter.Tendsto
      (fun n ↦ CFC.sqrt
        ((M n : SchattenOneOperator H) : H →L[ℂ] H))
      Filter.atTop
      (nhds (CFC.sqrt
        ((Mlim : SchattenOneOperator H) : H →L[ℂ] H))) := by
    have hSqrtContinuous : ContinuousOn
        (CFC.sqrt : (H →L[ℂ] H) → H →L[ℂ] H)
        {A : H →L[ℂ] H | 0 ≤ A} := CFC.continuousOn_sqrt
    apply (hSqrtContinuous _ hPosLim).tendsto.comp
    exact tendsto_nhdsWithin_iff.mpr
      ⟨hCoeLim, Filter.Eventually.of_forall hPosSeq⟩
  have hRootSeq : ∀ n,
      (CFC.sqrt ((M n : SchattenOneOperator H) : H →L[ℂ] H)).IsHilbertSchmidt ∧
        ContinuousLinearMap.hsNorm
          (CFC.sqrt ((M n : SchattenOneOperator H) : H →L[ℂ] H)) ≤ 1 := by
    intro n
    exact separableBuresCompactTargetBody_root_isHilbertSchmidt_norm_le_one
      hVnorm (M n).property
  have hRootAt :
      (CFC.sqrt ((Mlim : SchattenOneOperator H) : H →L[ℂ] H)).IsHilbertSchmidt ∧
        ContinuousLinearMap.hsNorm
          (CFC.sqrt ((Mlim : SchattenOneOperator H) : H →L[ℂ] H)) ≤ 1 :=
    separableBuresCompactTargetBody_root_isHilbertSchmidt_norm_le_one
      hVnorm Mlim.property
  have htrace :=
    traceNorm_comp_tendsto_of_fixed_hilbertSchmidt_of_unit_hsBound
      hCroot (fun n ↦ (hRootSeq n).1) hRootAt.1
      (fun n ↦ (hRootSeq n).2) hRootAt.2 hRootLim
  simpa only [Function.comp_def, Set.restrict_apply,
    operatorBuresRootFidelity] using htrace

/-- On every nonempty norm-compact occupied target family, both worst and
best Bures target covariances are attained in the infinite-dimensional
trace-norm compact body. -/
theorem exists_extremal_operatorBuresRootFidelity_compactTargetBody
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    {V : Set H} (hVcompact : IsCompact V) (hVnonempty : V.Nonempty)
    (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    (C : H →L[ℂ] H) (hCroot : (CFC.sqrt C).IsHilbertSchmidt) :
    ∃ Mmin ∈ separableBuresCompactTargetBody V,
      ∃ Mmax ∈ separableBuresCompactTargetBody V,
        (∀ M ∈ separableBuresCompactTargetBody V,
          operatorBuresRootFidelity C (Mmin : H →L[ℂ] H) ≤
            operatorBuresRootFidelity C (M : H →L[ℂ] H)) ∧
        (∀ M ∈ separableBuresCompactTargetBody V,
          operatorBuresRootFidelity C (M : H →L[ℂ] H) ≤
            operatorBuresRootFidelity C (Mmax : H →L[ℂ] H)) := by
  have hbodyCompact :=
    separableBuresCompactTargetBody_isCompact hVcompact
  have hbodyNonempty :=
    separableBuresCompactTargetBody_nonempty hVnonempty
  have hcont := continuousOn_operatorBuresRootFidelity_compactTargetBody
    hVnorm C hCroot
  obtain ⟨Mmin, hMmin, hmin⟩ :=
    hbodyCompact.exists_isMinOn hbodyNonempty hcont
  obtain ⟨Mmax, hMmax, hmax⟩ :=
    hbodyCompact.exists_isMaxOn hbodyNonempty hcont
  exact ⟨Mmin, hMmin, Mmax, hMmax, hmin, hmax⟩

/-- Exact identification of the probability-design capacity with an attained
maximum over the trace-norm compact covariance body.  Genuine finite designs
are dense enough: continuity supplies the closed-body endpoint even when the
maximizer itself has no chosen probability-law witness. -/
theorem exists_compactTargetBody_max_eq_targetProbabilityBuresCapacity
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    (μ : Measure X) (u : Lp H 2 μ)
    {V : Set H} (hVcompact : IsCompact V) (hVnonempty : V.Nonempty)
    (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1) :
    ∃ Mmax ∈ separableBuresCompactTargetBody V,
      targetProbabilityBuresCapacity μ u V =
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ u))
          (Mmax : H →L[ℂ] H) ^ 2 ∧
      ∀ M ∈ separableBuresCompactTargetBody V,
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ u))
          (M : H →L[ℂ] H) ≤
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ u))
          (Mmax : H →L[ℂ] H) := by
  let U := l2Synthesis μ u
  let C := rangeCovariance U
  have hU : U.IsHilbertSchmidt := l2Synthesis_isHilbertSchmidt μ u
  obtain ⟨R, _hR, hrootFactor⟩ :=
    exists_rangeCovarianceRoot_factor_through U
  have hCroot : (CFC.sqrt C).IsHilbertSchmidt := by
    change (rangeCovarianceRoot U).IsHilbertSchmidt
    rw [hrootFactor]
    exact hU.comp_right R
  have hbodyCompact :=
    separableBuresCompactTargetBody_isCompact hVcompact
  have hbodyNonempty :=
    separableBuresCompactTargetBody_nonempty hVnonempty
  have hcont := continuousOn_operatorBuresRootFidelity_compactTargetBody
    hVnorm C hCroot
  obtain ⟨Mmax, hMmax, hmax⟩ :=
    hbodyCompact.exists_isMaxOn hbodyNonempty hcont
  have hvaluesNonempty :
      (targetProbabilityBuresValueSet μ u V).Nonempty := by
    obtain ⟨v, hv⟩ := hVnonempty
    exact ⟨operatorBuresRootFidelity C
        (InnerProductSpace.rankOne ℂ v v) ^ 2,
      InnerProductSpace.rankOne ℂ v v,
      positiveRankOne_isTargetProbabilityCovariance hv, rfl⟩
  have hcapacityUpper : targetProbabilityBuresCapacity μ u V ≤
      operatorBuresRootFidelity C (Mmax : H →L[ℂ] H) ^ 2 := by
    apply csSup_le hvaluesNonempty
    intro q hq
    obtain ⟨M, hM, rfl⟩ := hq
    obtain ⟨M₁, hM₁coe, hM₁body⟩ :=
      targetProbabilityCovariance_mem_separableBuresCompactTargetBody
        hVnorm hM
    have hle := hmax hM₁body
    change operatorBuresRootFidelity C (M₁ : H →L[ℂ] H) ≤
      operatorBuresRootFidelity C (Mmax : H →L[ℂ] H) at hle
    rw [hM₁coe] at hle
    have hleft := operatorBuresRootFidelity_nonneg C M
    have hright := operatorBuresRootFidelity_nonneg C
      (Mmax : H →L[ℂ] H)
    exact (sq_le_sq₀ hleft hright).2 hle
  have hMmaxClosure : Mmax ∈
      closure (convexHull ℝ (separableBuresTargetRaySet V)) := by
    simpa [separableBuresCompactTargetBody,
      closedConvexHull_eq_closure_convexHull] using hMmax
  obtain ⟨Mn, hMnHull, hMnLim⟩ :=
    mem_closure_iff_seq_limit.mp hMmaxClosure
  have hMnBody : ∀ n, Mn n ∈ separableBuresCompactTargetBody V := by
    intro n
    exact convexHull_subset_closedConvexHull (hMnHull n)
  have hfidLim : Filter.Tendsto
      (fun n ↦ operatorBuresRootFidelity C (Mn n : H →L[ℂ] H))
      Filter.atTop
      (nhds (operatorBuresRootFidelity C
        (Mmax : H →L[ℂ] H))) := by
    apply (hcont Mmax hMmax).tendsto.comp
    exact tendsto_nhdsWithin_iff.mpr
      ⟨hMnLim, Filter.Eventually.of_forall hMnBody⟩
  have hsquareLim := hfidLim.pow 2
  have hcapacityLower :
      operatorBuresRootFidelity C (Mmax : H →L[ℂ] H) ^ 2 ≤
        targetProbabilityBuresCapacity μ u V := by
    apply le_of_tendsto' hsquareLim
    intro n
    exact operatorBuresRootFidelity_sq_le_targetProbabilityBuresCapacity
      μ u hVnorm
      (convexHull_targetRaySet_isTargetProbabilityCovariance (hMnHull n))
  refine ⟨Mmax, hMmax, ?_, hmax⟩
  change targetProbabilityBuresCapacity μ u V =
    operatorBuresRootFidelity C (Mmax : H →L[ℂ] H) ^ 2
  exact le_antisymm hcapacityUpper hcapacityLower

/-- **Attained infinite-dimensional complete-union law.**  Continuum capture
mass is controlled by one actual maximizer in the trace-norm compact occupied
target body.  No target count, finite rank, or ambient dimension appears. -/
theorem exists_compactTargetBody_max_capture_bound
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    (μ : Measure X) [IsFiniteMeasure μ]
    {u : X → H} (hu : Measurable u) (huLp : MemLp u 2 μ)
    (V : Set H) (hVcompact : IsCompact V) (hVnonempty : V.Nonempty)
    (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    (a : ℝ) (ha : 0 < a) :
    ∃ Mmax ∈ separableBuresCompactTargetBody V,
      a ^ 2 * μ.real (setOverlapCaptureEvent V u a) ≤
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ (huLp.toLp u)))
          (Mmax : H →L[ℂ] H) ^ 2 ∧
      ∀ M ∈ separableBuresCompactTargetBody V,
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ (huLp.toLp u)))
          (M : H →L[ℂ] H) ≤
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis μ (huLp.toLp u)))
          (Mmax : H →L[ℂ] H) := by
  obtain ⟨Mmax, hMmax, hcapacity, hmax⟩ :=
    exists_compactTargetBody_max_eq_targetProbabilityBuresCapacity
      μ (huLp.toLp u) hVcompact hVnonempty hVnorm
  refine ⟨Mmax, hMmax, ?_, hmax⟩
  by_cases hmass : 0 < μ.real (setOverlapCaptureEvent V u a)
  · have hbound := compact_capture_le_targetProbabilityBuresCapacity
      μ hu huLp V hVcompact hVnonempty hVnorm a ha hmass
    rwa [hcapacity] at hbound
  · have hzero : μ.real (setOverlapCaptureEvent V u a) = 0 := by
      exact le_antisymm (not_lt.mp hmass) (measureReal_nonneg)
    rw [hzero, mul_zero]
    exact sq_nonneg _

/-- Canonical covariance of all source sheets surviving one measurable return
removal. -/
noncomputable def returnRestrictedSourceCovariance
    (μ : Measure X) {u : X → H} (huLp : MemLp u 2 μ)
    (returnSet : Set X) : H →L[ℂ] H :=
  rangeCovariance
    (l2Synthesis (μ.restrict returnSetᶜ)
      ((huLp.mono_measure Measure.restrict_le_self).toLp u))

set_option maxHeartbeats 1000000 in
/-- Return-excised attained complete-union law.  Removed mass is charged once;
all surviving source sheets remain in the restricted covariance. -/
theorem exists_compactTargetBody_max_returnExcised_capture_bound
    [MeasurableSpace H] [BorelSpace H]
    [TopologicalSpace.SeparableSpace H]
    (μ : Measure X) [IsFiniteMeasure μ]
    {u : X → H} (hu : Measurable u) (huLp : MemLp u 2 μ)
    (V : Set H) (hVcompact : IsCompact V) (hVnonempty : V.Nonempty)
    (hVnorm : ∀ v ∈ V, ‖v‖ ≤ 1)
    (a : ℝ) (ha : 0 < a)
    (returnSet : Set X) (hreturn : MeasurableSet returnSet) :
    ∃ Mmax ∈ separableBuresCompactTargetBody V,
      μ.real (setOverlapCaptureEvent V u a) ≤
        μ.real returnSet +
          operatorBuresRootFidelity
            (returnRestrictedSourceCovariance μ huLp returnSet)
            (Mmax : H →L[ℂ] H) ^ 2 / a ^ 2 ∧
      ∀ M ∈ separableBuresCompactTargetBody V,
        operatorBuresRootFidelity
          (returnRestrictedSourceCovariance μ huLp returnSet)
          (M : H →L[ℂ] H) ≤
        operatorBuresRootFidelity
          (returnRestrictedSourceCovariance μ huLp returnSet)
          (Mmax : H →L[ℂ] H) := by
  let ν : Measure X := μ.restrict returnSetᶜ
  have huLpν : MemLp u 2 ν :=
    huLp.mono_measure Measure.restrict_le_self
  obtain ⟨Mmax, hMmax, hsurvive, hmax⟩ :=
    exists_compactTargetBody_max_capture_bound
      ν hu huLpν V hVcompact hVnonempty hVnorm a ha
  refine ⟨Mmax, hMmax, ?_, ?_⟩
  let E := setOverlapCaptureEvent V u a
  have hcut : μ.real E ≤ μ.real returnSet + ν.real E := by
    have hsub : E ⊆ returnSet ∪ (E ∩ returnSetᶜ) := by
      intro x hx
      by_cases hxReturn : x ∈ returnSet
      · exact Set.mem_union_left _ hxReturn
      · exact Set.mem_union_right _ ⟨hx, hxReturn⟩
    calc
      μ.real E ≤ μ.real (returnSet ∪ (E ∩ returnSetᶜ)) :=
        measureReal_mono hsub
      _ ≤ μ.real returnSet + μ.real (E ∩ returnSetᶜ) :=
        measureReal_union_le _ _
      _ = μ.real returnSet + ν.real E := by
        rw [show ν = μ.restrict returnSetᶜ by rfl,
          measureReal_restrict_apply' hreturn.compl]
  have hresidual : ν.real E ≤
      operatorBuresRootFidelity
        (rangeCovariance (l2Synthesis ν (huLpν.toLp u)))
        (Mmax : H →L[ℂ] H) ^ 2 / a ^ 2 := by
    apply (le_div_iff₀' (sq_pos_of_pos ha)).2
    simpa [E, mul_comm] using hsurvive
  apply hcut.trans
  have hadd : μ.real returnSet + ν.real E ≤
      μ.real returnSet +
        operatorBuresRootFidelity
          (rangeCovariance (l2Synthesis ν (huLpν.toLp u)))
          (Mmax : H →L[ℂ] H) ^ 2 / a ^ 2 := by
    gcongr
  simpa [returnRestrictedSourceCovariance, ν, huLpν, E] using hadd
  · intro M hM
    simpa [returnRestrictedSourceCovariance, ν, huLpν] using hmax M hM

end RHTower
