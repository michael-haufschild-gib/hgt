import GaloisForLFunctions.HTGeometry.SimplicialConstraintTower
import GaloisForLFunctions.HTGeometry.SquarefreeVeroneseIdeal
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Stanley--Reisner ideals as intersections of facet coordinate ideals

For an arbitrary finite facet family, the squarefree nonface ideal is exactly the intersection of
the coordinate ideals complementary to its facets.  The proof is coefficientwise: a monomial lies
in the nonface ideal precisely when its support is contained in no facet.  Localization preserves
the finite intersection, giving the Laurent-localized identity used by HT relation geometries.
-/

namespace GaloisForLFunctions.HTGeometry

open Finset MvPolynomial

variable {R α : Type*} [CommSemiring R] [DecidableEq α]

/-- The squarefree exponent with support exactly `J`. -/
noncomputable def indicatorExponent (J : Finset α) : α →₀ ℕ :=
  ∑ j ∈ J, Finsupp.single j 1

/-- Squarefree exponents indexed by the nonfaces of a finite facet family. -/
def nonfaceExponents (facets : Finset (Finset α)) : Set (α →₀ ℕ) :=
  {e | ∃ J : Finset α,
    ¬ IsFaceOf (↑facets : Set (Finset α)) J ∧ e = indicatorExponent J}

/-- The Stanley--Reisner ideal generated by the squarefree monomials of all nonfaces. -/
noncomputable def stanleyReisnerIdeal (R : Type*) [CommSemiring R]
    (facets : Finset (Finset α)) : Ideal (MvPolynomial α R) :=
  Ideal.span ((fun e => monomial e (1 : R)) '' nonfaceExponents facets)

/-- The coordinate ideal generated by variables outside a facet.  Over a field this is the
standard facet prime of the Stanley--Reisner decomposition. -/
noncomputable def facetIdeal (R : Type*) [CommSemiring R] (F : Finset α) :
    Ideal (MvPolynomial α R) :=
  Ideal.span (X '' {i : α | i ∉ F})

omit [DecidableEq α] in
/-- Faces are closed under taking subsets. -/
lemma isFaceOf_mono {facets : Set (Finset α)} {J K : Finset α}
    (hJK : J ⊆ K) (hK : IsFaceOf facets K) : IsFaceOf facets J := by
  obtain ⟨F, hF, hKF⟩ := hK
  exact ⟨F, hF, hJK.trans hKF⟩

/-- A polynomial lies in the Stanley--Reisner ideal exactly when every monomial in its support has
nonface variable support. -/
theorem mem_stanleyReisnerIdeal_iff (facets : Finset (Finset α)) (P : MvPolynomial α R) :
    P ∈ stanleyReisnerIdeal R facets ↔
      ∀ d ∈ P.support, ¬ IsFaceOf (↑facets : Set (Finset α)) d.support := by
  rw [stanleyReisnerIdeal, MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h d hd hface
    obtain ⟨e, ⟨J, hJ, rfl⟩, hed⟩ := h d hd
    apply hJ
    apply isFaceOf_mono _ hface
    rw [← VeroneseIdeal.support_sum_single J]
    exact Finsupp.support_mono hed
  · intro h d hd
    refine ⟨indicatorExponent d.support, ⟨d.support, h d hd, rfl⟩, ?_⟩
    intro i
    rw [indicatorExponent, VeroneseIdeal.sum_single_apply]
    split_ifs with hi
    · exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
    · exact Nat.zero_le _

omit [DecidableEq α] in
/-- A polynomial belongs to a facet coordinate ideal exactly when each supported monomial uses a
variable outside that facet. -/
theorem mem_facetIdeal_iff (F : Finset α) (P : MvPolynomial α R) :
    P ∈ facetIdeal R F ↔ ∀ d ∈ P.support, ¬ d.support ⊆ F := by
  rw [facetIdeal, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h d hd hsub
    obtain ⟨i, hiF, hdi⟩ := h d hd
    exact hiF (hsub (Finsupp.mem_support_iff.mpr hdi))
  · intro h d hd
    obtain ⟨i, hid, hiF⟩ := Finset.not_subset.mp (h d hd)
    exact ⟨i, hiF, Finsupp.mem_support_iff.mp hid⟩

/-- **Arbitrary finite-complex facet decomposition.**  The nonface ideal is the finite
intersection of the coordinate ideals complementary to the facets. -/
theorem stanleyReisnerIdeal_eq_inf_facetIdeal (facets : Finset (Finset α)) :
    stanleyReisnerIdeal R facets = facets.inf (facetIdeal R) := by
  ext P
  rw [mem_stanleyReisnerIdeal_iff, Finset.inf_eq_iInf]
  simp only [Ideal.mem_iInf, mem_facetIdeal_iff]
  constructor
  · intro h F hF d hd hsub
    exact h d hd ⟨F, hF, hsub⟩
  · intro h d hd hface
    obtain ⟨F, hF, hsub⟩ := hface
    exact h F hF d hd hsub

/-- **Localized facet decomposition.**  Extension to any localization preserves the finite facet
intersection.  In particular this applies to the Laurent presentation obtained by inverting the
vertex translates. -/
theorem localized_stanleyReisnerIdeal_eq_inf_facetIdeal
    {S : Type*} [CommSemiring S]
    (M : Submonoid (MvPolynomial α R))
    [Algebra (MvPolynomial α R) S] [IsLocalization M S]
    (facets : Finset (Finset α)) :
    Ideal.map (algebraMap (MvPolynomial α R) S) (stanleyReisnerIdeal R facets) =
      facets.inf (fun F =>
        Ideal.map (algebraMap (MvPolynomial α R) S) (facetIdeal R F)) := by
  rw [stanleyReisnerIdeal_eq_inf_facetIdeal]
  change IsLocalization.mapFrameHom M S (facets.inf (facetIdeal R)) =
    facets.inf (fun F => IsLocalization.mapFrameHom M S (facetIdeal R F))
  exact map_finset_inf (IsLocalization.mapFrameHom M S) facets (facetIdeal R)

end GaloisForLFunctions.HTGeometry
