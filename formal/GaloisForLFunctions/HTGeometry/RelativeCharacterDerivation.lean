import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic

/-!
# Relative character derivations

Let `α` and `β` be characters from a commutative algebra `A` to its scalar
field. A relative character derivation satisfies

`d (a * b) = α a * d b + d a * β b`.

The main theorem proves that every such derivation is inner when the two
characters are distinct. Thus a non-inner relative one-class can be supported
only on the character diagonal.

This is the dependency-closed algebraic consumer for the
reflected-character singular-splitting Bockstein programme. It does not
construct a completed source Bockstein or prove that an Xi conormal lands in
this relative class.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A]

/-! ## Character-diagonal support -/

/-- A carrier class on which the two endpoint characters induce the same
scalar action. Cohomology classes in `Ext_A(k_α, k_β)` have this property:
central multiplication may be computed at either endpoint. -/
def IsRelativeCharacterCarrier
    {V : Type*} [AddCommGroup V] [Module K V]
    (α β : A →ₐ[K] K) (x : V) : Prop :=
  ∀ a, α a • x = β a • x

/-- **Character-diagonal support.** A nonzero internal carrier with equal
endpoint actions forces the two characters to coincide. This is the
dependency-closed vector-level form of the standard all-degree support law
`Ext_A^n(k_α, k_β) = 0` for distinct characters. -/
theorem relativeCharacters_eq_of_nonzero_carrier
    {V : Type*} [AddCommGroup V] [Module K V]
    {α β : A →ₐ[K] K} {x : V}
    (hx : x ≠ 0) (hcarrier : IsRelativeCharacterCarrier α β x) :
    α = β := by
  ext a
  have hzero : (α a - β a) • x = 0 := by
    rw [sub_smul, hcarrier a, sub_self]
  exact sub_eq_zero.mp ((smul_eq_zero.mp hzero).resolve_right hx)

/-- Twisted Leibniz law for a one-cochain between scalar characters `α` and
`β`. -/
def IsRelativeCharacterDerivation
    (α β : A →ₐ[K] K) (d : A →ₗ[K] K) : Prop :=
  ∀ a b, d (a * b) = α a * d b + d a * β b

/-- A relative character derivation is inner when it is a scalar multiple of
the character difference. -/
def IsInnerRelativeCharacterDerivation
    (α β : A →ₐ[K] K) (d : A →ₗ[K] K) : Prop :=
  ∃ c : K, ∀ a, d a = c * (α a - β a)

/-- The degree-zero Hochschild coboundary generated by a scalar `c`. -/
def relativeCharacterCoboundary
    (α β : A →ₐ[K] K) (c : K) : A →ₗ[K] K where
  toFun a := c * (α a - β a)
  map_add' a b := by
    simp only [map_add]
    ring
  map_smul' r a := by
    simp only [map_smul, RingHom.id_apply]
    ring

/-- A scalar character difference satisfies the twisted Leibniz law. This is
the algebraic form of an off-diagonal divided difference being exact. -/
theorem relativeCharacterCoboundary_isRelativeCharacterDerivation
    (α β : A →ₐ[K] K) (c : K) :
    IsRelativeCharacterDerivation α β
      (relativeCharacterCoboundary α β c) := by
  intro a b
  change c * (α (a * b) - β (a * b)) =
    α a * (c * (α b - β b)) + c * (α a - β a) * β b
  rw [map_mul, map_mul]
  ring

/-- A scalar character difference is inner by construction. -/
theorem relativeCharacterCoboundary_isInner
    (α β : A →ₐ[K] K) (c : K) :
    IsInnerRelativeCharacterDerivation α β
      (relativeCharacterCoboundary α β c) :=
  ⟨c, fun _ => rfl⟩

/-- **Distinct-character splitting.** Every relative character derivation on
a commutative algebra is inner when its endpoint characters differ. No
continuity or boundedness hypothesis is used. -/
theorem isInnerRelativeCharacterDerivation_of_ne
    {α β : A →ₐ[K] K} {d : A →ₗ[K] K}
    (hαβ : α ≠ β) (hd : IsRelativeCharacterDerivation α β d) :
    IsInnerRelativeCharacterDerivation α β d := by
  have hex : ∃ b : A, α b ≠ β b := by
    by_contra h
    apply hαβ
    ext b
    exact not_ne_iff.mp (not_exists.mp h b)
  obtain ⟨b, hb⟩ := hex
  refine ⟨d b / (α b - β b), ?_⟩
  intro a
  have heq :
      α a * d b + d a * β b =
        α b * d a + d b * β a := by
    rw [← hd a b, ← hd b a, mul_comm a b]
  have hrel :
      d b * (α a - β a) =
        d a * (α b - β b) := by
    linear_combination heq
  have hden : α b - β b ≠ 0 := sub_ne_zero.mpr hb
  field_simp [hden]
  simpa [mul_comm] using hrel.symm

/-- A non-inner relative character derivation forces collision of its two
endpoint characters. -/
theorem relativeCharacters_eq_of_not_inner
    {α β : A →ₐ[K] K} {d : A →ₗ[K] K}
    (hd : IsRelativeCharacterDerivation α β d)
    (houter : ¬ IsInnerRelativeCharacterDerivation α β d) :
    α = β := by
  by_contra hαβ
  exact houter (isInnerRelativeCharacterDerivation_of_ne hαβ hd)

/-- On the character diagonal every inner relative derivation is zero, so
any cochain with a nonzero value is outer. -/
theorem not_inner_of_eq_of_exists_ne_zero
    {α β : A →ₐ[K] K} {d : A →ₗ[K] K}
    (hαβ : α = β) (hd0 : ∃ a, d a ≠ 0) :
    ¬ IsInnerRelativeCharacterDerivation α β d := by
  rintro ⟨c, hc⟩
  obtain ⟨a, ha⟩ := hd0
  apply ha
  rw [hc a, hαβ]
  simp

end GaloisForLFunctions.HTGeometry
