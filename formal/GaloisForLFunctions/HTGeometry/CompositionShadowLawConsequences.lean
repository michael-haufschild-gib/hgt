/-- **The differential order law.**  Composing with an autonomous first-order cap gives the shadow
rank of the input plus one. -/
theorem daRank_comp {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (haut : AutonomousFirstOrder f) (hcomp : Differentiable ℂ (fun w => f (g w)))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) :
    daRank hcomp = shadowRank' hg + 1 :=
  trdeg_shadow_law_infinite hf hg haut hcomp hfnp hgnp hncomp hncg

/-- **The primitive compression ledger.**  Along a chain of autonomous first-order caps the
differential rank after `N` steps, together with the defects met along the way, is the initial rank
plus `N`. -/
theorem compression_ledger {h : ℕ → ℂ → ℂ} (hh : ∀ k, Differentiable ℂ (h k))
    (defect : ℕ → Cardinal) (N : ℕ)
    (hstep : ∀ k, k < N → daRank (hh (k + 1)) = shadowRank' (hh k) + 1)
    (hdefect : ∀ k, k < N → daRank (hh k) = shadowRank' (hh k) + defect k) :
    daRank (hh N) + ∑ k ∈ Finset.range N, defect k = daRank (hh 0) + (N : Cardinal) := by
  induction N with
  | zero => simp
  | succ N ih =>
      have hstep' : ∀ k, k < N → daRank (hh (k + 1)) = shadowRank' (hh k) + 1 :=
        fun k hk => hstep k (by omega)
      have hdefect' : ∀ k, k < N → daRank (hh k) = shadowRank' (hh k) + defect k :=
        fun k hk => hdefect k (by omega)
      have hih := ih hstep' hdefect'
      have hlast : daRank (hh (N + 1)) + defect N = daRank (hh N) + 1 := by
        rw [hstep N (by omega), hdefect N (by omega)]
        ring
      calc daRank (hh (N + 1)) + ∑ k ∈ Finset.range (N + 1), defect k
          = (daRank (hh (N + 1)) + defect N) + ∑ k ∈ Finset.range N, defect k := by
            rw [Finset.sum_range_succ]; ring
        _ = (daRank (hh N) + ∑ k ∈ Finset.range N, defect k) + 1 := by rw [hlast]; ring
        _ = daRank (hh 0) + ((N : Cardinal) + 1) := by rw [hih]; ring
        _ = daRank (hh 0) + ((N + 1 : ℕ) : Cardinal) := by push_cast; ring

