/-- **The hypertranscendental transfer.**  If the coordinate and the derivatives of positive order
of the inner function are algebraically independent, the coordinate and the jets of the composition
up to order `n` have transcendence degree `n + 2`. -/
theorem trdeg_jetField_comp_of_algebraicIndependent {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (haut : AutonomousFirstOrder f)
    (hcomp : Differentiable ℂ (fun w => f (g w)))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) (n : ℕ)
    (hind : AlgebraicIndependent ℂ
      (Fin.cons coordElem (fun j : Fin n => jetElem hg ((j : ℕ) + 1)) :
        Fin (n + 1) → meroField (Set.univ : Set ℂ))) :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
        (insert (jetGen hg n 0) (Set.range fun k : Fin (n + 1) => jetElem hcomp (k : ℕ))))
      = (n : Cardinal) + 2 := by
  have hshadow : Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
      (insert (jetGen hg n 0) (Set.range fun j : Fin n => jetElem hg ((j : ℕ) + 1))))
      = (n : Cardinal) + 1 := by
    have h1 := trdeg_intermediateFieldAdjoin_range_eq_cardinalMk_of_algebraicIndependent _ hind
    rw [jetGen_zero_eq_coordElem hg n, ← Fin.range_cons]
    refine h1.trans ?_
    simp
  rw [trdeg_shadow_law hf hg haut hcomp hfnp hgnp hncomp hncg n, hshadow]
  ring

end

