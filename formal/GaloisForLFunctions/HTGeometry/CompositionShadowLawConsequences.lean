/-- **An algebraic generator adds no transcendence degree.** -/
theorem trdeg_adjoin_insert_eq_of_isAlgebraic
    {S : Set (meroField (Set.univ : Set ℂ))} {x : meroField (Set.univ : Set ℂ)}
    (halg : IsAlgebraic ↥(IntermediateField.adjoin ℂ S) x) :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ (insert x S))
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ S) := by
  classical
  set K : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ S with hK
  set M : IntermediateField ↥K (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ↥K ({x} : Set (meroField (Set.univ : Set ℂ))) with hM
  have hLeq : M.restrictScalars ℂ = IntermediateField.adjoin ℂ (insert x S) :=
    adjoin_insert_eq_restrictScalars S x
  rw [← hLeq]
  show Algebra.trdeg ℂ ↥M = Algebra.trdeg ℂ ↥K
  haveI : FiniteDimensional ↥K ↥M := IntermediateField.adjoin.finiteDimensional halg.isIntegral
  haveI : Algebra.IsAlgebraic ↥K ↥M := Algebra.IsAlgebraic.of_finite ↥K ↥M
  exact trdeg_eq_of_isAlgebraic

/-- The differential rank of an entire function: the transcendence degree over `ℂ` of the field
generated by the coordinate together with all jets. -/
def daRank {u : ℂ → ℂ} (hu : Differentiable ℂ u) : Cardinal :=
  Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
    (insert coordElem (Set.range fun k : ℕ => jetElem hu k)))

/-- The shadow rank of an entire function: the same transcendence degree for the derivatives of
positive order only. -/
def shadowRank' {u : ℂ → ℂ} (hu : Differentiable ℂ u) : Cardinal :=
  Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
    (insert coordElem (Set.range fun j : ℕ => jetElem hu (j + 1))))

/-- The full jet family is the shadow family together with the function itself. -/
theorem jetSet_eq_insert {u : ℂ → ℂ} (hu : Differentiable ℂ u) :
    insert coordElem (Set.range fun k : ℕ => jetElem hu k)
      = insert (jetElem hu 0)
        (insert coordElem (Set.range fun j : ℕ => jetElem hu (j + 1))) := by
  ext y
  constructor
  · rintro (rfl | ⟨k, rfl⟩)
    · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
    · rcases k with _ | j
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨j, rfl⟩)
  · rintro (rfl | rfl | ⟨j, rfl⟩)
    · exact Set.mem_insert_of_mem _ ⟨0, rfl⟩
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ ⟨j + 1, rfl⟩

