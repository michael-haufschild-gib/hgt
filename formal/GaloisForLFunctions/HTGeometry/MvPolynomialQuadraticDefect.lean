import GaloisForLFunctions.HTGeometry.MvPolynomialFirstOrderTaylor

/-!
# An explicit quadratic representation of the Taylor defect

The first-order Taylor defect of a polynomial lies in the square of the ideal generated by the
increment.  For quantitative work an ideal membership is not enough: one needs the defect written
as an explicit finite sum

```text
defect = ∑_{a,b} L_a L_b · Q_{ab}(S, L) ,
```

with `Q_{ab}` polynomials in the base point and the increment that do not depend on either.  The
representation is produced by the same induction as the ideal membership; the multiplication step

```text
defect(p · X_i) = (S_i + L_i) · defect(p) + L_i · ∑_j ∂_j p(S) L_j
```

adds the factor `X_{inl i} + X_{inr i}` to every entry and creates the new entries `∂_a p` in the
column `b = i`.

With such a representation a Gevrey bound on the defect follows from Gevrey bounds on `S` and `L`
and is **quadratic** in the size of `L`, which is what a nonlinear recursion needs.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

variable {ι R A : Type*} [CommRing R] [CommRing A] [Algebra R A] [Fintype ι] [DecidableEq ι]

omit [Fintype ι] [DecidableEq ι] in
theorem aeval_sumElim_rename_inl (S L : ι → A) (Z : MvPolynomial ι R) :
    MvPolynomial.aeval (Sum.elim S L) (MvPolynomial.rename Sum.inl Z)
      = MvPolynomial.aeval S Z := by
  rw [MvPolynomial.aeval_rename]
  rfl

/-- **The Taylor defect has an explicit quadratic representation.**  The coefficient polynomials
depend only on the differential polynomial, not on the point or the increment. -/
theorem exists_taylorDefect_repr (P : MvPolynomial ι R) :
    ∃ Q : ι → ι → MvPolynomial (ι ⊕ ι) R,
      ∀ S L : ι → A, taylorDefect S L P
        = ∑ a, ∑ b, L a * L b * MvPolynomial.aeval (Sum.elim S L) (Q a b) := by
  classical
  induction P using MvPolynomial.induction_on with
  | C r =>
      refine ⟨fun _ _ => 0, fun S L => ?_⟩
      rw [taylorDefect_C]
      simp
  | add p q hp hq =>
      obtain ⟨Qp, hQp⟩ := hp
      obtain ⟨Qq, hQq⟩ := hq
      refine ⟨fun a b => Qp a b + Qq a b, fun S L => ?_⟩
      rw [taylorDefect_add, hQp, hQq, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [map_add]
      ring
  | mul_X p i hp =>
      obtain ⟨Qp, hQp⟩ := hp
      refine ⟨fun a b =>
        Qp a b * (MvPolynomial.X (Sum.inl i) + MvPolynomial.X (Sum.inr i))
          + (if b = i then MvPolynomial.rename Sum.inl (MvPolynomial.pderiv a p) else 0),
        fun S L => ?_⟩
      have hsplit : ∀ a b : ι,
          L a * L b * MvPolynomial.aeval (Sum.elim S L)
              (Qp a b * (MvPolynomial.X (Sum.inl i) + MvPolynomial.X (Sum.inr i))
                + (if b = i then MvPolynomial.rename Sum.inl (MvPolynomial.pderiv a p) else 0))
            = (S i + L i) * (L a * L b * MvPolynomial.aeval (Sum.elim S L) (Qp a b))
              + (if b = i then L i * (MvPolynomial.aeval S (MvPolynomial.pderiv a p) * L a)
                  else 0) := by
        intro a b
        by_cases hb : b = i
        · subst hb
          simp only [if_true, map_add, map_mul, MvPolynomial.aeval_X, Sum.elim_inl,
            Sum.elim_inr, aeval_sumElim_rename_inl]
          ring
        · simp only [if_neg hb, map_add, map_mul, MvPolynomial.aeval_X, Sum.elim_inl,
            Sum.elim_inr, add_zero]
          ring
      rw [taylorDefect_mul_X, hQp]
      rw [Finset.sum_congr rfl fun a _ =>
        Finset.sum_congr rfl fun b _ => hsplit a b]
      have hinner : ∀ a : ι,
          ∑ b, ((S i + L i) * (L a * L b * MvPolynomial.aeval (Sum.elim S L) (Qp a b))
              + (if b = i then L i * (MvPolynomial.aeval S (MvPolynomial.pderiv a p) * L a)
                  else 0))
            = (S i + L i) * (∑ b, L a * L b * MvPolynomial.aeval (Sum.elim S L) (Qp a b))
              + L i * (MvPolynomial.aeval S (MvPolynomial.pderiv a p) * L a) := by
        intro a
        rw [Finset.sum_add_distrib, ← Finset.mul_sum,
          Finset.sum_ite_eq' Finset.univ i
            (fun _ => L i * (MvPolynomial.aeval S (MvPolynomial.pderiv a p) * L a)),
          if_pos (Finset.mem_univ i)]
      rw [Finset.sum_congr rfl fun a _ => hinner a, Finset.sum_add_distrib, ← Finset.mul_sum,
        ← Finset.mul_sum]

end GaloisForLFunctions.HTGeometry
