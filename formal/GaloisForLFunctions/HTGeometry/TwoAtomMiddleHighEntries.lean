  unfold twoAtomOddProfile3
  constructor
  · apply (le_div_iff₀ (by positivity : 0 < q^2*(2*q-3)^2)).mpr
    linarith only [hlower]
  · apply (div_le_iff₀ (by positivity : 0 < q^2*(2*q-3)^2)).mpr
    linarith only [hupper]

