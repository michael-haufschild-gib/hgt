        (4159673686060546875 : ℝ)*u^5*(1-u)^2 +
        (1980276895390625000 : ℝ)*u^6*(1-u)^1 +
        (397387623242187500 : ℝ)*u^7*(1-u)^0)*v^0*(1-v)^2 +
      ((58103944736269172 : ℝ)*u^0*(1-u)^7 +
