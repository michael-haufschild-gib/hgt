      unfold twoAtomOddNumerator3
      dsimp [u,v]
      ring
    rw [heq]
    positivity
  have hupper : 0 ≤ 14000*(q^2*(2*q-3)^2)-twoAtomOddNumerator3 q z := by
    have heq : 14000*(q^2*(2*q-3)^2)-twoAtomOddNumerator3 q z =
      (2/8251953125 : ℝ)*(
      ((927741871875000 : ℝ)*u^0*(1-u)^7 +
        (30640982287500000 : ℝ)*u^1*(1-u)^6 +
        (221751180330468750 : ℝ)*u^2*(1-u)^5 +
