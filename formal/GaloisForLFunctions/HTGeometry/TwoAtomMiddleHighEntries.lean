/-- Positive polynomial reserves for the actual middle entry 3. -/
theorem twoAtomOddProfile3_middle_bounds {q z : ℝ} (hq0 : 37/10 ≤ q) (hq1 : q ≤ 7)
    (hz0 : 0 ≤ z) (hz1 : z ≤ 1/65000) :
    100 ≤ twoAtomOddProfile3 q z ∧ twoAtomOddProfile3 q z ≤ 14000 := by
  let u := (10*q-37)/33
  let v := 65000*z
