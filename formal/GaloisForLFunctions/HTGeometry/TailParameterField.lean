import GaloisForLFunctions.HTGeometry.TailCoefficientLinearSolve
import Mathlib.Algebra.MvPolynomial.Supported
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The parameters are recovered from the tail coefficients and the first parameter

Each tail coefficient is linear in the parameter it introduces, with leading coefficient a nonzero
power of the first parameter and remainder involving only earlier parameters.  Solving that linear
equation expresses the parameter through the tail coefficients, the first parameter and the earlier
parameters, so an induction recovers all of them.

Hence the field of rational functions in the parameters is generated over the constants by the tail
coefficients together with the first parameter alone.  That is the field-theoretic content of the
triangular parameter change.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] [CharZero K] {n : ℕ}

omit [CharZero K] in
theorem notMem_vars_of_degreeOf_eq_zero {i : Fin n} {p : MvPolynomial (Fin n) K}
    (h : p.degreeOf i = 0) : i ∉ p.vars := fun hi =>
  MvPolynomial.mem_vars_iff_degreeOf_ne_zero.1 hi h

omit [CharZero K] in
/-- **A polynomial in a restricted set of variables lands in any field containing them.** -/
theorem algebraMap_mem_of_vars_subset {S : Set (Fin n)} {p : MvPolynomial (Fin n) K}
    (hp : ↑p.vars ⊆ S)
    {F : IntermediateField K (FractionRing (MvPolynomial (Fin n) K))}
    (hS : ∀ i ∈ S, algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
      (MvPolynomial.X i) ∈ F) :
    algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)) p ∈ F := by
  classical
  have hmem : p ∈ Algebra.adjoin K (MvPolynomial.X '' S) := by
    have h := MvPolynomial.mem_supported.2 hp
    rwa [MvPolynomial.supported_eq_adjoin_X] at h
  set φ : MvPolynomial (Fin n) K →ₐ[K] FractionRing (MvPolynomial (Fin n) K) :=
    IsScalarTower.toAlgHom K (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
    with hφ
  have himg : φ p ∈ Algebra.adjoin K (φ '' (MvPolynomial.X '' S)) := by
    rw [← AlgHom.map_adjoin]
    exact ⟨p, hmem, rfl⟩
  refine Algebra.adjoin_le (S := F.toSubalgebra) ?_ himg
  rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
  exact hS i hi

/-- The field generated over the constants by the tail coefficients and the first parameter. -/
noncomputable def tailParamField (K : Type*) [Field K] (n : ℕ) :
    IntermediateField K (FractionRing (MvPolynomial (Fin n) K)) :=
  IntermediateField.adjoin K
    (Set.range (fun j : Fin n =>
        algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
          (tailCoeff K n j)) ∪
      {z | ∃ j : Fin n, (j : ℕ) = 0 ∧
        z = algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
          (MvPolynomial.X j)})

omit [CharZero K] in
theorem tailCoeff_mem_tailParamField (j : Fin n) :
    algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
      (tailCoeff K n j) ∈ tailParamField K n :=
  IntermediateField.subset_adjoin _ _ (Or.inl ⟨j, rfl⟩)

omit [CharZero K] in
theorem X_zero_mem_tailParamField {j : Fin n} (hj : (j : ℕ) = 0) :
    algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
      (MvPolynomial.X j) ∈ tailParamField K n :=
  IntermediateField.subset_adjoin _ _ (Or.inr ⟨j, hj, rfl⟩)

theorem tailLead_ne_zero (j : Fin n) : tailLead K n j ≠ 0 := by
  have hj : (j : ℕ) < n := j.2
  have hne : ((n - (j : ℕ) : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.2 (by omega)
  have hC : ((n - (j : ℕ) : ℕ) : MvPolynomial (Fin n) K) =
      MvPolynomial.C (((n - (j : ℕ) : ℕ) : K)) := (map_natCast MvPolynomial.C _).symm
  rw [tailLead, hC]
  exact mul_ne_zero (fun hcon => hne (MvPolynomial.C_eq_zero.1 hcon))
    (pow_ne_zero _ (MvPolynomial.X_ne_zero _))

omit [CharZero K] in
theorem tailLead_mem_tailParamField (j : Fin n) :
    algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
      (tailLead K n j) ∈ tailParamField K n := by
  rw [tailLead, map_mul, map_pow, map_natCast]
  exact mul_mem (natCast_mem _ _) (pow_mem (X_zero_mem_tailParamField rfl) _)

/-- **Every parameter lies in the field generated by the tail coefficients and the first
parameter.** -/
theorem X_mem_tailParamField (j : Fin n) :
    algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
      (MvPolynomial.X j) ∈ tailParamField K n := by
  induction hm : (j : ℕ) using Nat.strong_induction_on generalizing j with
  | _ m ih =>
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · exact X_zero_mem_tailParamField (by omega)
    have hj0 : (j : ℕ) ≠ 0 := by omega
    have hrem : algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (tailRemainder K n j) ∈ tailParamField K n := by
      refine algebraMap_mem_of_vars_subset (S := {i : Fin n | (i : ℕ) < m}) ?_ ?_
      · intro i hi
        by_contra hcon
        simp only [Set.mem_setOf_eq, not_lt] at hcon
        exact notMem_vars_of_degreeOf_eq_zero
          (degreeOf_tailRemainder_eq_zero (K := K) (i := j) (j := i) hj0 (by omega)) hi
      · intro i hi
        exact ih (i : ℕ) hi i rfl
    have hlead : algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (tailLead K n j) ≠ 0 := by
      intro hcon
      exact tailLead_ne_zero (K := K) j
        (IsFractionRing.injective _ _ (by rw [hcon, map_zero]))
    have heq : algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (tailCoeff K n j) =
        algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (tailLead K n j) *
          algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (MvPolynomial.X j) +
          algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (tailRemainder K n j) := by
      rw [← map_mul, ← map_add, ← tailCoeff_eq]
    have hsol : algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (MvPolynomial.X j) =
        (algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (tailCoeff K n j) -
          algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (tailRemainder K n j)) /
          algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
            (tailLead K n j) := by
      rw [eq_div_iff hlead]
      linear_combination -heq
    rw [hsol]
    exact div_mem (sub_mem (tailCoeff_mem_tailParamField j) hrem)
      (tailLead_mem_tailParamField j)

/-- **The parameter field is generated by the tail coefficients and the first parameter.** -/
theorem tailParamField_eq_top : tailParamField K n = ⊤ := by
  refine le_antisymm le_top ?_
  intro z _
  obtain ⟨p, q, -, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial (Fin n) K) z
  refine div_mem ?_ ?_ <;>
    exact algebraMap_mem_of_vars_subset (S := Set.univ) (fun i _ => trivial)
      (fun i _ => X_mem_tailParamField i)

end GaloisForLFunctions.HTGeometry
