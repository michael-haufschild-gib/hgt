import GaloisForLFunctions.HTGeometry.CommonQuadraticGenerators
import Mathlib.RingTheory.Etale.Field
import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Finite etale algebras with one surviving quadratic class

An etale algebra over a field is a finite product of separable fields. If a
nonempty algebra-generating family consists of roots in one nonsquare class,
every factor is the same quadratic field. The resulting algebra equivalence
counts the factors by half the dimension of the original algebra.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open scoped IntermediateField
universe u v
variable {F M : Type*} [Field F] [Field M] [Algebra F M]
variable {R : Type u} [CommRing R] [Algebra F R] [Algebra.Etale F R]

/-- A finite etale algebra generated by scaled roots of one nonsquare is a
product of copies of that precise quadratic field; degree counts the copies. -/
theorem etale_common_quadratic_decomposition {ι : Type*}
    (r : ι → R) (w : ι → F) (i₀ : ι) {c : F}
    (hc : ¬ IsSquare c) (hw : ∀ i, w i ≠ 0)
    (hr : ∀ i, r i * r i = algebraMap F R (c * w i ^ 2))
    (hgen : Algebra.adjoin F (Set.range r) = ⊤)
    {s : M} (hs : s * s = algebraMap F M c) :
    ∃ (I : Type u) (_ : Fintype I) (_e : R ≃ₐ[F] (I → F⟮s⟯)),
      Fintype.card I * 2 = Module.finrank F R := by
  classical
  obtain ⟨I, hI, A, hA, hAlg, e, _⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod F R).mp inferInstance
  letI := hI
  letI := hA
  letI := hAlg
  letI : Fintype I := Fintype.ofFinite I
  have heach (i : I) : Nonempty (A i ≃ₐ[F] F⟮s⟯) := by
    let f : R →ₐ[F] A i := (Pi.evalAlgHom F A i).comp e.toAlgHom
    have hsurj : Function.Surjective f := (Function.surjective_eval i).comp e.surjective
    have hgen' : Algebra.adjoin F (Set.range (fun j => f (r j))) = ⊤ := by
      rw [show Set.range (fun j => f (r j)) = f '' Set.range r from Set.range_comp f r,
        ← AlgHom.map_adjoin, hgen, Algebra.map_top]
      exact f.range_eq_top.mpr hsurj
    have hr' (j : ι) : f (r j) * f (r j) = algebraMap F (A i) (c * w j ^ 2) := by
      rw [← map_mul, hr, AlgHom.commutes]
    exact (common_quadratic_generators (fun j => f (r j)) w i₀ hc hw hr'
      (IntermediateField.adjoin_eq_top_of_algebra F _ hgen') hs).2
  let e' : R ≃ₐ[F] (I → F⟮s⟯) :=
    e.trans (AlgEquiv.piCongrRight fun i => Classical.choice (heach i))
  refine ⟨I, inferInstance, e', ?_⟩
  letI : FiniteDimensional F F⟮s⟯ :=
    IntermediateField.adjoin.finiteDimensional (isIntegral_of_sq_mem_bot hs)
  have hd := e'.toLinearEquiv.finrank_eq
  have hsdegree : Module.finrank F F⟮s⟯ = 2 :=
    finrank_adjoin_eq_two hs (root_not_mem_bot_of_not_isSquare hs hc)
  rw [Module.finrank_pi_fintype] at hd
  simpa only [hsdegree, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, Nat.cast_id] using hd.symm

end GaloisForLFunctions.HTGeometry
