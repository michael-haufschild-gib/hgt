import GaloisForLFunctions.HTGeometry.TranslateFamilyIndependence
import GaloisForLFunctions.HTGeometry.EllipticGammaAtomicOverDAExtension

/-!
# The order-one translation packet

The bottom layer of the all-order argument needs the *translation orbit* of the genuine elliptic
gamma logarithmic derivative to be differentially independent, not merely its family of external
defects.  The two statements differ by an invertible shear, so the orbit statement follows from the
corpus's defect theorem together with a single further input: the logarithmic derivative itself is
hypertranscendental over the differential field generated by its defects.

* **`ellipticGammaTranslatePacket_diffIndepOn`** — the order-one orbit is differentially independent
  over the constants;
* **`ellipticGammaTranslatePacket_diffIndepOn_daExtension`** — and over every differentially
  algebraic extension, in particular over the field `D` of the all-order argument.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions

open Bottcher HTGeometry

noncomputable section

attribute [local instance] ellipticGammaStructuralGeneratorRestrictedDifferential
  ellipticGammaStructuralGeneratorDifferentialAlgebra ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

/-- The translation orbit of the genuine elliptic-gamma logarithmic derivative. -/
def ellipticGammaTranslateFamily {kappa : Type*} (hs : kappa → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    kappa → meroField (Set.univ : Set ℂ) := fun j =>
  addTranslationMeroEquiv (hs j) (ellipticGammaLogDerivMero sigma tau hsigma htau)

theorem ellipticGammaTranslateFamily_eq_add_defect {kappa : Type*} (hs : kappa → ℂ)
    (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) (j : kappa) :
    ellipticGammaTranslateFamily hs sigma tau hsigma htau j =
      ellipticGammaLogDerivMero sigma tau hsigma htau +
        ellipticGammaExternalDefectFamily hs sigma tau hsigma htau j := by
  rw [ellipticGammaTranslateFamily, ellipticGammaExternalDefectFamily,
    ellipticGammaExternalLogDerivDefectMero]
  ring

/-- **The order-one translation packet is differentially independent over the constants.**  The
external defects are independent by the order-one atomic theorem, the logarithmic derivative is
hypertranscendental over the field they generate, and adding it to each of them is an invertible
shear of the free jet ring. -/
theorem ellipticGammaTranslatePacket_diffIndepOn {kappa : Type*}
    (hs : kappa → ℂ) (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (hnonres : ∀ j, ThetaTranslationNonresonant tau sigma (hs j))
    (hsep : ∀ i j, j ≠ i → ThetaTranslationNonresonant tau sigma (hs j - hs i))
    (hHT : HypertranscendentalOver
      ↥(differentialAdjoin ℂ
        (Set.range (ellipticGammaExternalDefectFamily hs sigma tau hsigma htau)))
      (ellipticGammaLogDerivMero sigma tau hsigma htau)) :
    DiffIndepOn ℂ
      (insert (ellipticGammaLogDerivMero sigma tau hsigma htau)
        (Set.range (ellipticGammaTranslateFamily hs sigma tau hsigma htau))) := by
  classical
  set F := ellipticGammaLogDerivMero sigma tau hsigma htau with hF
  set d := ellipticGammaExternalDefectFamily hs sigma tau hsigma htau with hd
  have hdefC : DifferentialIndependent ℂ d :=
    (differentialIndependent_meromorphicRationalCoordinateField_iff d).mp
      (ellipticGammaExternalDefectFamily_differentialIndependent_rationalBase
        hs sigma tau hsigma htau hindependent hnonres hsep)
  have hdefSet : DiffIndepOn ℂ (Set.range d) :=
    diffIndepOn_range_of_differentialIndependent hdefC
  have hsingle : DiffIndepOn ↥(differentialAdjoin ℂ (Set.range d)) ({F} : Set _) := by
    have hfam : DifferentialIndependent ↥(differentialAdjoin ℂ (Set.range d))
        (fun _ : Unit => F) :=
      (hypertranscendentalOver_iff_differentialIndependent_singleton _ F).mp hHT
    have hrange := diffIndepOn_range_of_differentialIndependent hfam
    rwa [Set.range_const] at hrange
  have hunion : DiffIndepOn ℂ (insert F (Set.range d)) := by
    have h := diffIndepOn_union_of_base hdefSet hsingle
    rwa [Set.singleton_union] at h
  have hv : F ∉ Set.range d := notMem_of_hypertranscendentalOver_differentialAdjoin hHT
  have hshear := diffIndepOn_insert_translate F (Set.range d) hv hunion
  have himage : (fun s => F + s) '' Set.range d =
      Set.range (ellipticGammaTranslateFamily hs sigma tau hsigma htau) := by
    ext y
    constructor
    · rintro ⟨s, ⟨j, rfl⟩, rfl⟩
      exact ⟨j, ellipticGammaTranslateFamily_eq_add_defect hs sigma tau hsigma htau j⟩
    · rintro ⟨j, rfl⟩
      exact ⟨d j, ⟨j, rfl⟩,
        (ellipticGammaTranslateFamily_eq_add_defect hs sigma tau hsigma htau j).symm⟩
  rwa [himage] at hshear

/-- **The order-one translation packet stays independent over every differentially algebraic
extension.**  This is the bottom-layer atomicity input of the all-order argument. -/
theorem ellipticGammaTranslatePacket_diffIndepOn_daExtension {kappa : Type*}
    (hs : kappa → ℂ) (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (hnonres : ∀ j, ThetaTranslationNonresonant tau sigma (hs j))
    (hsep : ∀ i j, j ≠ i → ThetaTranslationNonresonant tau sigma (hs j - hs i))
    (hHT : HypertranscendentalOver
      ↥(differentialAdjoin meromorphicRationalCoordinateField
        (Set.range (ellipticGammaExternalDefectFamily hs sigma tau hsigma htau)))
      (ellipticGammaLogDerivMero sigma tau hsigma htau))
    {G : Set (meroField (Set.univ : Set ℂ))}
    (hG : ∀ g ∈ G, DifferentialAlgebraicOver ℂ g) :
    DiffIndepOn ↥(differentialAdjoin ℂ G)
      (insert (ellipticGammaLogDerivMero sigma tau hsigma htau)
        (Set.range (ellipticGammaTranslateFamily hs sigma tau hsigma htau))) := by
  classical
  have hbase : DiffIndepOn meromorphicRationalCoordinateField
      (insert (ellipticGammaLogDerivMero sigma tau hsigma htau)
        (Set.range (ellipticGammaTranslateFamily hs sigma tau hsigma htau))) := by
    set F := ellipticGammaLogDerivMero sigma tau hsigma htau with hF
    set d := ellipticGammaExternalDefectFamily hs sigma tau hsigma htau with hd
    have hdefSet : DiffIndepOn meromorphicRationalCoordinateField (Set.range d) :=
      diffIndepOn_range_of_differentialIndependent
        (ellipticGammaExternalDefectFamily_differentialIndependent_rationalBase
          hs sigma tau hsigma htau hindependent hnonres hsep)
    have hsingle : DiffIndepOn
        ↥(differentialAdjoin meromorphicRationalCoordinateField (Set.range d))
        ({F} : Set _) := by
      have hfam : DifferentialIndependent
          ↥(differentialAdjoin meromorphicRationalCoordinateField (Set.range d))
          (fun _ : Unit => F) :=
        (hypertranscendentalOver_iff_differentialIndependent_singleton _ F).mp hHT
      have hrange := diffIndepOn_range_of_differentialIndependent hfam
      rwa [Set.range_const] at hrange
    have hunion : DiffIndepOn meromorphicRationalCoordinateField (insert F (Set.range d)) := by
      have h := diffIndepOn_union_of_base hdefSet hsingle
      rwa [Set.singleton_union] at h
    have hv : F ∉ Set.range d := notMem_of_hypertranscendentalOver_differentialAdjoin hHT
    have hshear := diffIndepOn_insert_translate F (Set.range d) hv hunion
    have himage : (fun s => F + s) '' Set.range d =
        Set.range (ellipticGammaTranslateFamily hs sigma tau hsigma htau) := by
      ext y
      constructor
      · rintro ⟨s, ⟨j, rfl⟩, rfl⟩
        exact ⟨j, ellipticGammaTranslateFamily_eq_add_defect hs sigma tau hsigma htau j⟩
      · rintro ⟨j, rfl⟩
        exact ⟨d j, ⟨j, rfl⟩,
          (ellipticGammaTranslateFamily_eq_add_defect hs sigma tau hsigma htau j).symm⟩
    rwa [himage] at hshear
  exact differentialIndependent_differentialAdjoin_of_rationalBase hbase hG

end

end GaloisForLFunctions
