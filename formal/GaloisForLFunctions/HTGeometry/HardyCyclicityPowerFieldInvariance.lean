import GaloisForLFunctions.HTGeometry.LocalAnalyticExponentialClock
import GaloisForLFunctions.HTGeometry.KreinIndexEscapeStratification
import GaloisForLFunctions.HTGeometry.HardyDiskBlaschke
import GaloisForLFunctions.HTGeometry.ParabolicCayleyAutomorphism
import GaloisForLFunctions.HTGeometry.ParabolicOrbitCircleClosure
import GaloisForLFunctions.HTGeometry.RegularizedHerglotzTransform
import GaloisForLFunctions.HTGeometry.CayleyOuterFamilyGauge

/-!
# The inner gauge is invisible at every power level

A finite Blaschke product composed with a parabolic disc automorphism is a rational function of the
disc coordinate, so it is a unit of the differential base field `ℂ(w)` inside the meromorphic
differential field of the disc.  Consequently, for every `N ≥ 1`, the differential field generated
over `ℂ(w)` by the `N`-th powers of the parabolic orbit of `B·O` equals the one generated by the
`N`-th powers of the parabolic orbit of `O`, and differential independence of the orbit transfers
in both directions.

The rational realization is explicit: in the Mobius normal form the parabolic automorphism is
`τ_t(w) = ((2i − t)w + t) / (−t w + (2i + t))`, and one Blaschke factor with zero `a` composed with
it is `(N_t − a D_t)/(D_t − conj a · N_t)`.
-/

open Complex Filter MeasureTheory Set

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open Bottcher

/-! ## The disc as an analytic chart -/

theorem isPreconnected_openDisc : IsPreconnected openDisc :=
  (convex_ball (0 : ℂ) 1).isPreconnected

theorem openDisc_nonempty : Set.Nonempty openDisc := ⟨0, by simp [openDisc]⟩

theorem openDisc_infinite : Set.Infinite openDisc := by
  have hinj : Set.InjOn (fun r : ℝ => (r : ℂ)) (Set.Ioo (0 : ℝ) 1) := by
    intro a _ b _ hab
    exact Complex.ofReal_inj.mp hab
  have hsub : (fun r : ℝ => (r : ℂ)) '' Set.Ioo (0 : ℝ) 1 ⊆ openDisc := by
    rintro _ ⟨r, hr, rfl⟩
    rw [mem_openDisc_iff, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr.1]
    exact hr.2
  exact Set.Infinite.mono hsub ((Set.Ioo_infinite (by norm_num)).image hinj)

theorem mem_openDisc_zero : (0 : ℂ) ∈ openDisc := by simp [mem_openDisc_iff]

/-! ## Analytic functions as meromorphic elements -/

/-- The meromorphic element of a function analytic on the chart. -/
def analyticMero {U : Set ℂ} {f : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f U) : meroField U :=
  algebraMap (analyticSubring U) (meroField U)
    ⟨Germ.coeRingHom (Filter.principal U) f, ⟨f, hf, rfl⟩⟩

theorem analyticMero_mul {U : Set ℂ} {f g : ℂ → ℂ}
    (hf : AnalyticOnNhd ℂ f U) (hg : AnalyticOnNhd ℂ g U) :
    analyticMero (hf.mul hg) = analyticMero hf * analyticMero hg := by
  rw [analyticMero, analyticMero, analyticMero, ← map_mul]
  congr 1

/-- **Rational realization.**  An analytic function that satisfies a polynomial linear relation
`Q · f = P` on the chart is the image of the rational function `P/Q` under the base-field
embedding. -/
theorem analyticMero_eq_ratfuncToMero {U : Set ℂ} (hUo : IsOpen U) (hUc : IsPreconnected U)
    (hUne : U.Nonempty) (hUinf : U.Infinite) {f : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f U)
    (P Q : Polynomial ℂ) (hQ : Q ≠ 0) (heval : ∀ z ∈ U, Q.eval z * f z = P.eval z) :
    analyticMero hf = ratfuncToMero U hUo hUc hUne hUinf
      (algebraMap (Polynomial ℂ) (RatFunc ℂ) P / algebraMap (Polynomial ℂ) (RatFunc ℂ) Q) := by
  letI := isDomain_analyticSubring U hUo hUc hUne
  have hQmero : polyToMero U Q ≠ 0 := by
    intro h
    exact hQ (polyToMero_injective U hUo hUc hUne hUinf (by rw [h, map_zero]))
  have hPM : ∀ p : Polynomial ℂ,
      polyToMero U p = algebraMap (analyticSubring U) (meroField U) (polyToAnalytic U p) :=
    fun _ => rfl
  rw [map_div₀, ratfuncToMero_algebraMap_polynomial, ratfuncToMero_algebraMap_polynomial,
    eq_div_iff hQmero, hPM, hPM, analyticMero, ← map_mul]
  congr 1
  apply Subtype.ext
  show ((f : Germ (Filter.principal U) ℂ)) * ((fun z => Q.eval z : ℂ → ℂ) : Germ _ ℂ)
      = ((fun z => P.eval z : ℂ → ℂ) : Germ _ ℂ)
  rw [← Germ.coe_mul, Germ.coe_eq]
  refine Filter.eventually_principal.mpr fun z hz => ?_
  show f z * Q.eval z = P.eval z
  rw [mul_comm]
  exact heval z hz

/-! ## The parabolic automorphism in Mobius normal form -/

/-- Numerator of `τ_t` in the disc coordinate. -/
def parabolicNumPoly (t : ℝ) : Polynomial ℂ :=
  Polynomial.C (2 * Complex.I - (t : ℂ)) * Polynomial.X + Polynomial.C (t : ℂ)

/-- Denominator of `τ_t` in the disc coordinate. -/
def parabolicDenPoly (t : ℝ) : Polynomial ℂ :=
  Polynomial.C (-(t : ℂ)) * Polynomial.X + Polynomial.C (2 * Complex.I + (t : ℂ))

@[simp] theorem eval_parabolicNumPoly (t : ℝ) (w : ℂ) :
    (parabolicNumPoly t).eval w = (2 * Complex.I - (t : ℂ)) * w + (t : ℂ) := by
  simp [parabolicNumPoly]

@[simp] theorem eval_parabolicDenPoly (t : ℝ) (w : ℂ) :
    (parabolicDenPoly t).eval w = -(t : ℂ) * w + (2 * Complex.I + (t : ℂ)) := by
  simp [parabolicDenPoly]

theorem cayleyToUpper_sub_I_mul (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (cayleyToUpper w + (t : ℂ) - Complex.I) * (1 - w) = (parabolicNumPoly t).eval w := by
  have hne : (1 : ℂ) - w ≠ 0 := one_sub_ne_zero_of_norm_lt_one hw
  rw [cayleyToUpper, eval_parabolicNumPoly]
  field_simp
  ring

theorem cayleyToUpper_add_I_mul (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (cayleyToUpper w + (t : ℂ) + Complex.I) * (1 - w) = (parabolicDenPoly t).eval w := by
  have hne : (1 : ℂ) - w ≠ 0 := one_sub_ne_zero_of_norm_lt_one hw
  rw [cayleyToUpper, eval_parabolicDenPoly]
  field_simp
  ring

theorem eval_parabolicDenPoly_ne_zero (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (parabolicDenPoly t).eval w ≠ 0 := by
  rw [← cayleyToUpper_add_I_mul t hw]
  exact mul_ne_zero (add_I_ne_zero_of_im_pos (im_cayleyToUpper_add_pos hw))
    (one_sub_ne_zero_of_norm_lt_one hw)

/-- **The parabolic automorphism is the Mobius quotient of the two polynomials.** -/
theorem parabolicAut_eq_div (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    parabolicAut t w = (parabolicNumPoly t).eval w / (parabolicDenPoly t).eval w := by
  have hne : (1 : ℂ) - w ≠ 0 := one_sub_ne_zero_of_norm_lt_one hw
  rw [parabolicAut, cayleyToDisc, ← cayleyToUpper_sub_I_mul t hw, ← cayleyToUpper_add_I_mul t hw,
    mul_div_mul_right _ _ hne]

/-! ## One Blaschke factor composed with the parabolic automorphism -/

/-- Numerator of `b_a ∘ τ_t`. -/
def blaschkeFactorNumPoly (a : ℂ) (t : ℝ) : Polynomial ℂ :=
  Polynomial.C (2 * Complex.I - (t : ℂ) + a * (t : ℂ)) * Polynomial.X
    + Polynomial.C ((t : ℂ) - a * (2 * Complex.I + (t : ℂ)))

/-- Denominator of `b_a ∘ τ_t`. -/
def blaschkeFactorDenPoly (a : ℂ) (t : ℝ) : Polynomial ℂ :=
  Polynomial.C (-(t : ℂ) - (starRingEnd ℂ) a * (2 * Complex.I - (t : ℂ))) * Polynomial.X
    + Polynomial.C (2 * Complex.I + (t : ℂ) - (starRingEnd ℂ) a * (t : ℂ))

theorem eval_blaschkeFactorNumPoly_eq (a : ℂ) (t : ℝ) (w : ℂ) :
    (blaschkeFactorNumPoly a t).eval w
      = (parabolicNumPoly t).eval w - a * (parabolicDenPoly t).eval w := by
  simp only [blaschkeFactorNumPoly, eval_parabolicNumPoly, eval_parabolicDenPoly,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  ring

theorem eval_blaschkeFactorDenPoly_eq (a : ℂ) (t : ℝ) (w : ℂ) :
    (blaschkeFactorDenPoly a t).eval w
      = (parabolicDenPoly t).eval w - (starRingEnd ℂ) a * (parabolicNumPoly t).eval w := by
  simp only [blaschkeFactorDenPoly, eval_parabolicNumPoly, eval_parabolicDenPoly,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  ring

theorem eval_blaschkeFactorDenPoly (a : ℂ) (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (blaschkeFactorDenPoly a t).eval w
      = (parabolicDenPoly t).eval w * (1 - (starRingEnd ℂ) a * parabolicAut t w) := by
  have hden : (parabolicDenPoly t).eval w ≠ 0 := eval_parabolicDenPoly_ne_zero t hw
  rw [eval_blaschkeFactorDenPoly_eq, parabolicAut_eq_div t hw]
  field_simp

theorem eval_blaschkeFactorNumPoly (a : ℂ) (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (blaschkeFactorNumPoly a t).eval w
      = (parabolicDenPoly t).eval w * (parabolicAut t w - a) := by
  have hden : (parabolicDenPoly t).eval w ≠ 0 := eval_parabolicDenPoly_ne_zero t hw
  rw [eval_blaschkeFactorNumPoly_eq, parabolicAut_eq_div t hw]
  field_simp

theorem blaschke_orbit_denom_ne_zero {a : ℂ} (ha : ‖a‖ < 1) (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    1 - (starRingEnd ℂ) a * parabolicAut t w ≠ 0 := by
  refine blaschke_denom_ne_zero ?_
  have h := norm_parabolicAut_lt_one (t := t) hw
  nlinarith [norm_nonneg (parabolicAut t w), norm_nonneg a]

theorem eval_blaschkeFactorDenPoly_ne_zero {a : ℂ} (ha : ‖a‖ < 1) (t : ℝ) {w : ℂ}
    (hw : ‖w‖ < 1) : (blaschkeFactorDenPoly a t).eval w ≠ 0 := by
  rw [eval_blaschkeFactorDenPoly a t hw]
  exact mul_ne_zero (eval_parabolicDenPoly_ne_zero t hw) (blaschke_orbit_denom_ne_zero ha t hw)

/-- The composed factor is the quotient of the two polynomials. -/
theorem eval_blaschkeFactorDenPoly_mul {a : ℂ} (ha : ‖a‖ < 1) (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (blaschkeFactorDenPoly a t).eval w * blaschkeFactor a (parabolicAut t w)
      = (blaschkeFactorNumPoly a t).eval w := by
  have hb : 1 - (starRingEnd ℂ) a * parabolicAut t w ≠ 0 := blaschke_orbit_denom_ne_zero ha t hw
  rw [eval_blaschkeFactorDenPoly a t hw, eval_blaschkeFactorNumPoly a t hw, blaschkeFactor]
  field_simp

theorem linear_poly_ne_zero {c₁ c₀ : ℂ} (hc : ¬(c₁ = 0 ∧ c₀ = 0)) :
    Polynomial.C c₁ * Polynomial.X + Polynomial.C c₀ ≠ 0 := by
  intro hz
  refine hc ⟨?_, ?_⟩
  · have h0 : c₀ = 0 := by
      have := congrArg (Polynomial.eval 0) hz
      simpa using this
    have h1 : c₁ + c₀ = 0 := by
      have := congrArg (Polynomial.eval 1) hz
      simpa using this
    linear_combination h1 - h0
  · have := congrArg (Polynomial.eval 0) hz
    simpa using this

theorem blaschkeFactorNumPoly_ne_zero {a : ℂ} (ha : a ≠ 1) (t : ℝ) :
    blaschkeFactorNumPoly a t ≠ 0 := by
  rw [blaschkeFactorNumPoly]
  refine linear_poly_ne_zero ?_
  rintro ⟨h1, h0⟩
  refine ha ?_
  have hsum : 2 * Complex.I * (1 - a) = 0 := by linear_combination h1 + h0
  rcases mul_eq_zero.mp hsum with h2 | h2
  · exact absurd h2 (by simp [Complex.I_ne_zero])
  · linear_combination -h2

/-! ## The whole Blaschke product composed with the parabolic automorphism -/

variable (B : FiniteBlaschke)

/-- Numerator of `B ∘ τ_t`. -/
def blaschkeOrbitNumPoly (t : ℝ) : Polynomial ℂ :=
  ∏ j, blaschkeFactorNumPoly (B.zeros j) t

/-- Denominator of `B ∘ τ_t`. -/
def blaschkeOrbitDenPoly (t : ℝ) : Polynomial ℂ :=
  ∏ j, blaschkeFactorDenPoly (B.zeros j) t

theorem norm_zeros_lt_one (j : Fin B.deg) : ‖B.zeros j‖ < 1 :=
  lt_of_le_of_lt (B.zeros_le j) B.bound_lt

theorem zeros_ne_one (j : Fin B.deg) : B.zeros j ≠ 1 := by
  intro hj
  have h := norm_zeros_lt_one B j
  rw [hj, norm_one] at h
  exact lt_irrefl 1 h

theorem eval_blaschkeOrbitDenPoly_ne_zero (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (blaschkeOrbitDenPoly B t).eval w ≠ 0 := by
  rw [blaschkeOrbitDenPoly, Polynomial.eval_prod]
  exact Finset.prod_ne_zero_iff.mpr fun j _ =>
    eval_blaschkeFactorDenPoly_ne_zero (norm_zeros_lt_one B j) t hw

theorem blaschkeOrbitDenPoly_ne_zero (t : ℝ) : blaschkeOrbitDenPoly B t ≠ 0 := by
  intro h
  exact eval_blaschkeOrbitDenPoly_ne_zero B t (w := 0) (by simp) (by rw [h]; simp)

theorem blaschkeOrbitNumPoly_ne_zero (t : ℝ) : blaschkeOrbitNumPoly B t ≠ 0 := by
  rw [blaschkeOrbitNumPoly]
  exact Finset.prod_ne_zero_iff.mpr fun j _ =>
    blaschkeFactorNumPoly_ne_zero (zeros_ne_one B j) t

/-- **The composed Blaschke product is a quotient of two polynomials.** -/
theorem eval_blaschkeOrbit_mul (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    (blaschkeOrbitDenPoly B t).eval w * B.fn (parabolicAut t w)
      = (blaschkeOrbitNumPoly B t).eval w := by
  rw [blaschkeOrbitDenPoly, blaschkeOrbitNumPoly, Polynomial.eval_prod, Polynomial.eval_prod,
    FiniteBlaschke.fn, blaschkeProd, ← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun j _ =>
    eval_blaschkeFactorDenPoly_mul (norm_zeros_lt_one B j) t hw

/-- The composed Blaschke product as an element of the rational base field. -/
def blaschkeOrbitRat (t : ℝ) : RatFunc ℂ :=
  algebraMap (Polynomial ℂ) (RatFunc ℂ) (blaschkeOrbitNumPoly B t) /
    algebraMap (Polynomial ℂ) (RatFunc ℂ) (blaschkeOrbitDenPoly B t)

theorem blaschkeOrbitRat_ne_zero (t : ℝ) : blaschkeOrbitRat B t ≠ 0 := by
  rw [blaschkeOrbitRat]
  refine div_ne_zero ?_ ?_
  · intro h
    exact blaschkeOrbitNumPoly_ne_zero B t
      (IsFractionRing.injective (Polynomial ℂ) (RatFunc ℂ) (by rw [h, map_zero]))
  · intro h
    exact blaschkeOrbitDenPoly_ne_zero B t
      (IsFractionRing.injective (Polynomial ℂ) (RatFunc ℂ) (by rw [h, map_zero]))

/-! ## Analyticity of the two orbits on the disc -/

theorem analyticAt_cayleyToUpper {w : ℂ} (hw : ‖w‖ < 1) : AnalyticAt ℂ cayleyToUpper w := by
  have hne : (1 : ℂ) - w ≠ 0 := one_sub_ne_zero_of_norm_lt_one hw
  have h : AnalyticAt ℂ (fun z : ℂ => Complex.I * (1 + z) / (1 - z)) w :=
    (analyticAt_const.mul (analyticAt_const.add analyticAt_id)).div
      (analyticAt_const.sub analyticAt_id) hne
  exact h

theorem analyticAt_cayleyToUpper_add (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    AnalyticAt ℂ (fun z : ℂ => cayleyToUpper z + (t : ℂ)) w :=
  (analyticAt_cayleyToUpper hw).add analyticAt_const

theorem analyticAt_parabolicAut (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    AnalyticAt ℂ (parabolicAut t) w := by
  have h1 := analyticAt_cayleyToUpper_add t hw
  have hne : cayleyToUpper w + (t : ℂ) + Complex.I ≠ 0 :=
    add_I_ne_zero_of_im_pos (im_cayleyToUpper_add_pos hw)
  exact (h1.sub analyticAt_const).div (h1.add analyticAt_const) hne

theorem analyticOnNhd_blaschkeFn (B : FiniteBlaschke) :
    AnalyticOnNhd ℂ B.fn (Metric.ball 0 B.radius) :=
  B.differentiableOn_fn.analyticOnNhd Metric.isOpen_ball

theorem analyticOnNhd_blaschkeOrbit (B : FiniteBlaschke) (t : ℝ) :
    AnalyticOnNhd ℂ (fun w => B.fn (parabolicAut t w)) openDisc := by
  intro w hw
  have hw1 : ‖w‖ < 1 := mem_openDisc_iff.mp hw
  have hmem : parabolicAut t w ∈ Metric.ball (0 : ℂ) B.radius := by
    have h := norm_parabolicAut_lt_one (t := t) hw1
    simpa [Metric.mem_ball, dist_zero_right] using h.trans B.one_lt_radius
  exact AnalyticAt.comp (x := w) (analyticOnNhd_blaschkeFn B _ hmem)
    (analyticAt_parabolicAut t hw1)

/-- The carrier orbit written in the straightened half-plane coordinate. -/
def carrierOrbitFun (ν : Measure ℝ) (t : ℝ) (w : ℂ) : ℂ :=
  Complex.exp (cayleyToDisc (cauchyTransform ν (cayleyToUpper w + (t : ℂ))))

theorem carrierOrbitFun_eq (ν : Measure ℝ) (t : ℝ) {w : ℂ} (hw : ‖w‖ < 1) :
    carrierOrbitFun ν t w = outerCarrier ν (parabolicAut t w) := by
  rw [carrierOrbitFun, outerCarrier, cayleyToUpper_parabolicAut hw]

theorem analyticAt_carrierOrbitFun (ν : Measure ℝ) [IsFiniteMeasure ν] (t : ℝ) {w : ℂ}
    (hw : ‖w‖ < 1) : AnalyticAt ℂ (carrierOrbitFun ν t) w := by
  have h1 := analyticAt_cayleyToUpper_add t hw
  have him : 0 < (cayleyToUpper w + (t : ℂ)).im := im_cayleyToUpper_add_pos hw
  have hC : AnalyticAt ℂ (cauchyTransform ν) (cayleyToUpper w + (t : ℂ)) :=
    analyticOnNhd_cauchyTransform ν isOpen_upperHalf (fun z hz => ne_of_gt hz) _ him
  have hcomp : AnalyticAt ℂ (fun z : ℂ => cauchyTransform ν (cayleyToUpper z + (t : ℂ))) w :=
    AnalyticAt.comp (g := cauchyTransform ν) (f := fun z : ℂ => cayleyToUpper z + (t : ℂ))
      (x := w) hC h1
  have hne : cauchyTransform ν (cayleyToUpper w + (t : ℂ)) + Complex.I ≠ 0 :=
    add_I_ne_zero_of_im_nonneg (im_cauchyTransform_nonneg ν him)
  exact ((hcomp.sub analyticAt_const).div (hcomp.add analyticAt_const) hne).cexp

theorem analyticOnNhd_carrierOrbit (ν : Measure ℝ) [IsFiniteMeasure ν] (t : ℝ) :
    AnalyticOnNhd ℂ (fun w => outerCarrier ν (parabolicAut t w)) openDisc := by
  intro w hw
  refine (analyticAt_carrierOrbitFun ν t (mem_openDisc_iff.mp hw)).congr ?_
  filter_upwards [isOpen_openDisc.mem_nhds hw] with z hz
  exact carrierOrbitFun_eq ν t (mem_openDisc_iff.mp hz)

/-! ## The two orbits as meromorphic elements of the disc chart -/

/-- The parabolic orbit of the bounded outer carrier. -/
def carrierOrbitMero (ν : Measure ℝ) [IsFiniteMeasure ν] (t : ℝ) : meroField openDisc :=
  analyticMero (analyticOnNhd_carrierOrbit ν t)

/-- The parabolic orbit of the inner-gauged carrier `B · O`. -/
def gaugedOrbitMero (ν : Measure ℝ) [IsFiniteMeasure ν] (B : FiniteBlaschke) (t : ℝ) :
    meroField openDisc :=
  analyticMero ((analyticOnNhd_blaschkeOrbit B t).mul (analyticOnNhd_carrierOrbit ν t))

theorem blaschkeOrbitMero_eq_ratfunc (B : FiniteBlaschke) (t : ℝ) :
    analyticMero (analyticOnNhd_blaschkeOrbit B t)
      = ratfuncToMero openDisc isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
          openDisc_infinite (blaschkeOrbitRat B t) := by
  rw [blaschkeOrbitRat]
  refine analyticMero_eq_ratfuncToMero isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
    openDisc_infinite _ _ _ (blaschkeOrbitDenPoly_ne_zero B t) ?_
  intro z hz
  exact eval_blaschkeOrbit_mul B t (mem_openDisc_iff.mp hz)

/-! ## Power-level invariance -/

/-- **The inner gauge is invisible at every power level.**  For every `N`, the parabolic orbit of
`B · O` generates exactly the same differential field over `ℂ(w)` as the parabolic orbit of `O`. -/
theorem gaugedOrbit_differentialAdjoin_pow_eq (ν : Measure ℝ) [IsFiniteMeasure ν]
    (B : FiniteBlaschke) (N : ℕ) :
    letI := isDomain_analyticSubring openDisc isOpen_openDisc isPreconnected_openDisc
      openDisc_nonempty
    letI : Algebra (RatFunc ℂ) (meroField openDisc) :=
      (ratfuncToMero openDisc isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
        openDisc_infinite).toAlgebra
    letI : Differential (RatFunc ℂ) := GaloisForLFunctions.ratFuncCoordinateDifferential
    letI := meroFieldDifferential isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
    letI : DifferentialAlgebra (RatFunc ℂ) (meroField openDisc) :=
      meroFieldRatFuncDifferentialAlgebra isOpen_openDisc isPreconnected_openDisc
        openDisc_nonempty openDisc_infinite
    differentialAdjoin (RatFunc ℂ) (Set.range fun t : ℝ => (gaugedOrbitMero ν B t) ^ N) =
      differentialAdjoin (RatFunc ℂ) (Set.range fun t : ℝ => (carrierOrbitMero ν t) ^ N) := by
  letI := isDomain_analyticSubring openDisc isOpen_openDisc isPreconnected_openDisc
    openDisc_nonempty
  letI : Algebra (RatFunc ℂ) (meroField openDisc) :=
    (ratfuncToMero openDisc isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
      openDisc_infinite).toAlgebra
  letI : Differential (RatFunc ℂ) := GaloisForLFunctions.ratFuncCoordinateDifferential
  letI := meroFieldDifferential isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
  letI : DifferentialAlgebra (RatFunc ℂ) (meroField openDisc) :=
    meroFieldRatFuncDifferentialAlgebra isOpen_openDisc isPreconnected_openDisc
      openDisc_nonempty openDisc_infinite
  have hgauge : ∀ t : ℝ, gaugedOrbitMero ν B t
      = algebraMap (RatFunc ℂ) (meroField openDisc) (blaschkeOrbitRat B t)
          * carrierOrbitMero ν t := by
    intro t
    have hmul := analyticMero_mul (analyticOnNhd_blaschkeOrbit B t) (analyticOnNhd_carrierOrbit ν t)
    rw [gaugedOrbitMero, hmul, carrierOrbitMero, blaschkeOrbitMero_eq_ratfunc]
    rfl
  have hpow : (fun t : ℝ => (gaugedOrbitMero ν B t) ^ N)
      = fun t : ℝ => (algebraMap (RatFunc ℂ) (meroField openDisc) (blaschkeOrbitRat B t)
          * carrierOrbitMero ν t) ^ N := by
    funext t
    rw [hgauge t]
  rw [hpow]
  exact differentialAdjoin_range_pow_baseGauge_eq (carrierOrbitMero ν) (blaschkeOrbitRat B)
    (blaschkeOrbitRat_ne_zero B) N

/-- **The inner gauge preserves differential independence of the parabolic orbit.** -/
theorem gaugedOrbit_differentialIndependent_iff (ν : Measure ℝ) [IsFiniteMeasure ν]
    (B : FiniteBlaschke) :
    letI := isDomain_analyticSubring openDisc isOpen_openDisc isPreconnected_openDisc
      openDisc_nonempty
    letI : Algebra (RatFunc ℂ) (meroField openDisc) :=
      (ratfuncToMero openDisc isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
        openDisc_infinite).toAlgebra
    letI : Differential (RatFunc ℂ) := GaloisForLFunctions.ratFuncCoordinateDifferential
    letI := meroFieldDifferential isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
    letI : DifferentialAlgebra (RatFunc ℂ) (meroField openDisc) :=
      meroFieldRatFuncDifferentialAlgebra isOpen_openDisc isPreconnected_openDisc
        openDisc_nonempty openDisc_infinite
    DifferentialIndependent (RatFunc ℂ) (gaugedOrbitMero ν B) ↔
      DifferentialIndependent (RatFunc ℂ) (carrierOrbitMero ν) := by
  letI := isDomain_analyticSubring openDisc isOpen_openDisc isPreconnected_openDisc
    openDisc_nonempty
  letI : Algebra (RatFunc ℂ) (meroField openDisc) :=
    (ratfuncToMero openDisc isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
      openDisc_infinite).toAlgebra
  letI : Differential (RatFunc ℂ) := GaloisForLFunctions.ratFuncCoordinateDifferential
  letI := meroFieldDifferential isOpen_openDisc isPreconnected_openDisc openDisc_nonempty
  letI : DifferentialAlgebra (RatFunc ℂ) (meroField openDisc) :=
    meroFieldRatFuncDifferentialAlgebra isOpen_openDisc isPreconnected_openDisc
      openDisc_nonempty openDisc_infinite
  have hgauge : gaugedOrbitMero ν B
      = fun t : ℝ => algebraMap (RatFunc ℂ) (meroField openDisc) (blaschkeOrbitRat B t)
          * carrierOrbitMero ν t
          + algebraMap (RatFunc ℂ) (meroField openDisc) 0 := by
    funext t
    have hmul := analyticMero_mul (analyticOnNhd_blaschkeOrbit B t) (analyticOnNhd_carrierOrbit ν t)
    rw [map_zero, add_zero, gaugedOrbitMero, hmul, carrierOrbitMero,
      blaschkeOrbitMero_eq_ratfunc]
    rfl
  rw [hgauge]
  exact _root_.GaloisForLFunctions.differentialIndependent_affineBase_iff
    (F := RatFunc ℂ) (K := meroField openDisc) (ι := ℝ)
    (carrierOrbitMero ν) (blaschkeOrbitRat B) (fun _ : ℝ => (0 : RatFunc ℂ))
    (blaschkeOrbitRat_ne_zero B)

