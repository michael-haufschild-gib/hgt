import GaloisForLFunctions.HTGeometry.SteinbergIndexAvoidance

/-!
# The row subgroups, and centrality of `K₂`

Everything proved for the column subgroups has a transpose.  The generators with a fixed *first*
index commute, the map to the matrices sends their product to `1 + Σ_k b_k E_ik`, and a row sum
vanishes only when all its coefficients do — so the map is injective on the row subgroup too.

With both halves, Milnor's argument closes.  For a spare index `h` an element `y` of `K₂` whose word
avoids `h` centralizes both the `h`-column and the `h`-row, and every generator is a commutator of
one of each:

```text
x_ij(a) = [x_ih(a), x_hj(1)] ,
```

so `y` commutes with every generator, hence lies in the centre.  That is the centrality half of
"`St(R) → E(R)` is the universal central extension".
-/

noncomputable section

open Matrix

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n]

/-! ## The row subgroup -/

/-- The generators of the row subgroup at an index: those with that first index. -/
def rowGens (i : n) : Set (SteinbergGroup R n) :=
  {x | ∃ (k : n) (hik : i ≠ k) (a : R), x = steinbergX hik a}

omit [DecidableEq n] in
theorem rowGens_comm (i : n) :
    ∀ x ∈ rowGens (R := R) (n := n) i, ∀ y ∈ rowGens (R := R) (n := n) i, x * y = y * x := by
  rintro x ⟨k, hik, a, rfl⟩ y ⟨l, hil, b, rfl⟩
  exact steinbergX_commute_row hik hil a b

/-- **The row subgroup**: generated by the generators with a fixed first index. -/
def rowSubgroup (i : n) : Subgroup (SteinbergGroup R n) :=
  Subgroup.closure (rowGens i)

instance rowSubgroup_isMulCommutative (i : n) :
    IsMulCommutative (rowSubgroup (R := R) (n := n) i) :=
  Subgroup.isMulCommutative_closure (rowGens_comm i)

omit [DecidableEq n] in
theorem steinbergX_mem_rowSubgroup {i k : n} (hik : i ≠ k) (a : R) :
    steinbergX hik a ∈ rowSubgroup (R := R) (n := n) i :=
  Subgroup.subset_closure ⟨k, hik, a, rfl⟩

/-! ## The matrix side -/

variable [Fintype n]

omit [Fintype n] in
theorem single_row_apply {i : n} (b : n → R) (p k : n) :
    (Matrix.single i k (b k) : Matrix n n R) i p = if k = p then b k else 0 := by
  by_cases h : k = p <;> simp [h]

/-- The `(i, p)` entry of a row sum is the `p`-th coefficient. -/
theorem sum_single_row_apply {i : n} (b : n → R) (p : n) :
    (∑ k, Matrix.single i k (b k) : Matrix n n R) i p = b p := by
  classical
  rw [Matrix.sum_apply]
  rw [Finset.sum_congr rfl (fun k (_ : k ∈ Finset.univ) => single_row_apply b p k)]
  rw [Finset.sum_ite_eq' Finset.univ p (fun k => b k), if_pos (Finset.mem_univ p)]

/-- **A row sum vanishes only if all its coefficients do.** -/
theorem sum_single_row_eq_zero_iff {i : n} (b : n → R) :
    (∑ k, Matrix.single i k (b k) : Matrix n n R) = 0 ↔ ∀ k, b k = 0 := by
  constructor
  · intro h k
    rw [← sum_single_row_apply b k, h]
    simp
  · intro h
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [h k, Matrix.single_zero]

/-! ## The row element -/

/-- The row generator at an index, trivial at the row index itself. -/
def rowGen (i k : n) (a : R) : SteinbergGroup R n :=
  if h : i = k then 1 else steinbergX h a

omit [Fintype n] in
theorem rowGen_self (i : n) (a : R) : rowGen i i a = (1 : SteinbergGroup R n) := by
  rw [rowGen, dif_pos rfl]

omit [Fintype n] in
theorem rowGen_of_ne {i k : n} (h : i ≠ k) (a : R) : rowGen i k a = steinbergX h a := by
  rw [rowGen, dif_neg h]

omit [Fintype n] in
theorem rowGen_zero (i k : n) : rowGen i k (0 : R) = 1 := by
  rw [rowGen]
  split_ifs with h
  · rfl
  · exact steinbergX_zero h

omit [Fintype n] in
theorem rowGen_mul (i k : n) (a b : R) :
    rowGen i k (a + b) = rowGen i k a * rowGen i k b := by
  rw [rowGen, rowGen, rowGen]
  split_ifs with h
  · rw [one_mul]
  · exact (steinbergX_mul h a b).symm

omit [Fintype n] in
theorem rowGen_commute (i k l : n) (a b : R) :
    Commute (rowGen i k a) (rowGen (R := R) i l b) := by
  rw [rowGen, rowGen]
  split_ifs with hk hl hl
  · exact Commute.one_left _
  · exact Commute.one_left _
  · exact Commute.one_right _
  · exact steinbergX_commute_row hk hl a b

/-- The row element with prescribed coefficients. -/
def rowElt (i : n) (b : n → R) : SteinbergGroup R n :=
  Finset.noncommProd Finset.univ (fun k => rowGen i k (b k))
    (fun k _ l _ _ => rowGen_commute i k l (b k) (b l))

theorem rowElt_zero (i : n) : rowElt i (0 : n → R) = 1 := by
  rw [rowElt]
  refine noncommProd_eq_one _ _ (fun k _ => ?_) _
  exact rowGen_zero i k

theorem rowElt_mul (i : n) (b c : n → R) :
    rowElt i (b + c) = rowElt i b * rowElt i c := by
  rw [rowElt, rowElt, rowElt]
  have hfun : (fun k => rowGen i k ((b + c) k))
      = (fun k => rowGen i k (b k)) * (fun k => rowGen i k (c k)) := by
    funext k
    exact rowGen_mul i k (b k) (c k)
  rw [Finset.noncommProd_congr rfl (fun k _ => congrFun hfun k)]
  refine Finset.noncommProd_mul_distrib _ _ _ _ ?_
  intro x _ y _ _
  exact rowGen_commute i x y (c x) (b y)

theorem rowElt_neg (i : n) (b : n → R) : rowElt i (-b) = (rowElt i b)⁻¹ := by
  have h := rowElt_mul i (-b) b
  rw [neg_add_cancel, rowElt_zero] at h
  exact eq_inv_of_mul_eq_one_left h.symm

/-! ## The image of a row element -/

theorem steinbergToGL_rowGen (i k : n) (a : R) :
    ((steinbergToGL (rowGen i k a) : (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + Matrix.single i k (if i = k then 0 else a) := by
  rw [rowGen]
  split_ifs with h
  · subst h
    simp
  · rw [steinbergToGL_x h a, elemUnit_val, Matrix.transvection]

theorem steinbergToGL_noncommProd_row (i : n) (b : n → R) (s : Finset n)
    (comm : (↑s : Set n).Pairwise (Function.onFun Commute (fun k => rowGen i k (b k)))) :
    ((steinbergToGL (Finset.noncommProd s (fun k => rowGen i k (b k)) comm) :
        (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + ∑ k ∈ s, Matrix.single i k (if i = k then 0 else b k) := by
  classical
  induction s using Finset.cons_induction with
  | empty => simp
  | cons a s ha ih =>
      rw [Finset.noncommProd_cons]
      have hcomm : (↑s : Set n).Pairwise
          (Function.onFun Commute (fun k => rowGen i k (b k))) :=
        fun x hx y hy hxy => comm (by simp [hx]) (by simp [hy]) hxy
      rw [map_mul, Units.val_mul, steinbergToGL_rowGen, ih hcomm, Finset.sum_cons]
      have hzero : ∀ k ∈ s, (Matrix.single i a (if i = a then 0 else b a) : Matrix n n R)
          * Matrix.single i k (if i = k then 0 else b k) = 0 := by
        intro k hk
        by_cases hik : i = a
        · subst hik
          simp
        · simp [Ne.symm hik]
      have hcross : (Matrix.single i a (if i = a then 0 else b a) : Matrix n n R)
          * ∑ k ∈ s, Matrix.single i k (if i = k then 0 else b k) = 0 := by
        rw [Finset.mul_sum]
        exact Finset.sum_eq_zero hzero
      rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one, hcross]
      simp only [Matrix.one_mul]
      abel

theorem steinbergToGL_rowElt (i : n) (b : n → R) :
    ((steinbergToGL (rowElt i b) : (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + ∑ k, Matrix.single i k (if i = k then 0 else b k) :=
  steinbergToGL_noncommProd_row i b Finset.univ _

theorem rowElt_eq_one_of_image (i : n) (b : n → R)
    (h : steinbergToGL (rowElt i b) = 1) : rowElt i b = 1 := by
  have hval : ((steinbergToGL (rowElt i b) : (Matrix n n R)ˣ) : Matrix n n R) = 1 := by
    rw [h]
    rfl
  rw [steinbergToGL_rowElt] at hval
  have hsum : (∑ k, Matrix.single i k (if i = k then 0 else b k) : Matrix n n R) = 0 := by
    have h2 : (1 : Matrix n n R) + ∑ k, Matrix.single i k (if i = k then 0 else b k)
        = 1 + 0 := by
      rw [hval, add_zero]
    exact add_left_cancel h2
  have hzero := (sum_single_row_eq_zero_iff (i := i) (fun k => if i = k then 0 else b k)).1 hsum
  rw [rowElt]
  refine noncommProd_eq_one _ _ (fun k _ => ?_) _
  by_cases hk : i = k
  · rw [hk, rowGen_self]
  · have : b k = 0 := by
      have := hzero k
      rwa [if_neg hk] at this
    rw [this, rowGen_zero]

/-! ## The row subgroup is the range, and the map is injective on it -/

/-- The row elements form a subgroup. -/
def rowRange (i : n) : Subgroup (SteinbergGroup R n) where
  carrier := Set.range (rowElt i)
  mul_mem' := by
    rintro _ _ ⟨b, rfl⟩ ⟨c, rfl⟩
    exact ⟨b + c, rowElt_mul i b c⟩
  one_mem' := ⟨0, rowElt_zero i⟩
  inv_mem' := by
    rintro _ ⟨b, rfl⟩
    exact ⟨-b, rowElt_neg i b⟩

theorem steinbergX_mem_rowRange {i k : n} (hik : i ≠ k) (a : R) :
    steinbergX hik a ∈ rowRange (R := R) (n := n) i := by
  refine ⟨Pi.single k a, ?_⟩
  rw [rowElt]
  have hins : (Finset.univ : Finset n) = insert k (Finset.univ.erase k) :=
    (Finset.insert_erase (Finset.mem_univ k)).symm
  have hrest : ∀ l ∈ Finset.univ.erase k,
      rowGen (R := R) i l ((Pi.single k a : n → R) l) = 1 := by
    intro l hl
    have hlk : l ≠ k := Finset.ne_of_mem_erase hl
    rw [Pi.single_eq_of_ne hlk, rowGen_zero]
  rw [Finset.noncommProd_congr hins (fun l _ => rfl)]
  rw [Finset.noncommProd_insert_of_notMem _ _ _ _ (Finset.notMem_erase k _)]
  rw [noncommProd_eq_one _ _ hrest, mul_one, Pi.single_eq_same, rowGen_of_ne hik]

omit [Fintype n] in
theorem rowGen_mem_rowSubgroup (i k : n) (a : R) :
    rowGen i k a ∈ rowSubgroup (R := R) (n := n) i := by
  by_cases hk : i = k
  · rw [hk, rowGen_self]
    exact Subgroup.one_mem _
  · rw [rowGen_of_ne hk]
    exact steinbergX_mem_rowSubgroup hk a

theorem rowSubgroup_eq_rowRange (i : n) :
    rowSubgroup (R := R) (n := n) i = rowRange (R := R) (n := n) i := by
  refine le_antisymm ?_ ?_
  · rw [rowSubgroup]
    refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨k, hik, a, rfl⟩
    exact steinbergX_mem_rowRange hik a
  · rintro _ ⟨b, rfl⟩
    rw [rowElt]
    exact noncommProd_mem_subgroup _ _ _ (fun l _ => rowGen_mem_rowSubgroup i l (b l)) _

/-- **The map to the matrices is injective on the row subgroup.** -/
theorem steinbergToGL_injOn_rowSubgroup (i : n) :
    Set.InjOn (steinbergToGL (R := R) (n := n))
      (rowSubgroup (R := R) (n := n) i : Set (SteinbergGroup R n)) := by
  intro x hx y hy hxy
  have hmem : x * y⁻¹ ∈ rowSubgroup (R := R) (n := n) i :=
    Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hy)
  rw [rowSubgroup_eq_rowRange] at hmem
  obtain ⟨b, hb⟩ := hmem
  have himg : steinbergToGL (rowElt i b) = 1 := by
    rw [hb, map_mul, map_inv, hxy, mul_inv_cancel]
  have hone := rowElt_eq_one_of_image i b himg
  rw [hone] at hb
  exact (mul_inv_eq_one.1 hb.symm)

/-! ## Centrality on the row -/

omit [Fintype n] in
/-- **Conjugating a row generator by a generator whose second index avoids the row stays in the row
subgroup.** -/
theorem conj_steinbergX_mem_rowSubgroup {i p q k : n} (hpq : p ≠ q) (hik : i ≠ k)
    (hqi : q ≠ i) (b a : R) :
    steinbergX hpq b * steinbergX hik a * (steinbergX hpq b)⁻¹
      ∈ rowSubgroup (R := R) (n := n) i := by
  by_cases hkp : k = p
  · subst hkp
    have hiq : i ≠ q := fun h => hqi h.symm
    have hchain := steinbergX_chain hik hpq hiq a b
    -- `x_ik(a) x_kq(b) x_ik(a)⁻¹ x_kq(b)⁻¹ = x_iq(a*b)`
    have hval : steinbergX hpq b * steinbergX hik a * (steinbergX hpq b)⁻¹
        = (steinbergX hiq (a * b))⁻¹ * steinbergX hik a := by
      have h1 : steinbergX hpq b * (steinbergX hik a)⁻¹ * (steinbergX hpq b)⁻¹
          = (steinbergX hik a)⁻¹ * steinbergX hiq (a * b) := by
        rw [← hchain]
        group
      have h2 := congrArg (fun z => z⁻¹) h1
      simpa [mul_assoc] using h2
    rw [hval]
    refine Subgroup.mul_mem _ (Subgroup.inv_mem _ ?_) (steinbergX_mem_rowSubgroup hik a)
    exact steinbergX_mem_rowSubgroup hiq (a * b)
  · have hcomm := steinbergX_commute hpq hik hqi (fun h => hkp h.symm) b a
    have hval : steinbergX hpq b * steinbergX hik a * (steinbergX hpq b)⁻¹
        = steinbergX hik a := by
      rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    rw [hval]
    exact steinbergX_mem_rowSubgroup hik a

omit [Fintype n] in
theorem conj_rowSubgroup_le {i p q : n} (hpq : p ≠ q) (hqi : q ≠ i) (b : R) :
    ∀ x ∈ rowSubgroup (R := R) (n := n) i,
      steinbergX hpq b * x * (steinbergX hpq b)⁻¹ ∈ rowSubgroup (R := R) (n := n) i := by
  intro x hx
  have hsub : rowSubgroup (R := R) (n := n) i
      ≤ (rowSubgroup (R := R) (n := n) i).comap
        (MulAut.conj (steinbergX hpq b)).toMonoidHom := by
    rw [rowSubgroup]
    refine (Subgroup.closure_le _).2 ?_
    rintro z ⟨k, hik, a, rfl⟩
    exact conj_steinbergX_mem_rowSubgroup hpq hik hqi b a
  exact hsub hx

omit [Fintype n] in
theorem steinbergX_mem_rowNormalizer {i p q : n} (hpq : p ≠ q) (hqi : q ≠ i) (b : R) :
    steinbergX hpq b ∈ Subgroup.normalizer (rowSubgroup (R := R) (n := n) i) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    exact conj_rowSubgroup_le hpq hqi b x hx
  · intro hx
    have h := conj_rowSubgroup_le hpq hqi (-b)
      (steinbergX hpq b * x * (steinbergX hpq b)⁻¹) hx
    rw [steinbergX_neg hpq b] at h
    have hval : (steinbergX hpq b)⁻¹ * (steinbergX hpq b * x * (steinbergX hpq b)⁻¹)
        * ((steinbergX hpq b)⁻¹)⁻¹ = x := by
      group
    rwa [hval] at h

/-- **An element of `K₂` in the normalizer of a row subgroup centralizes it.** -/
theorem KTwo_commute_rowSubgroup_of_mem_normalizer {i : n} {y : SteinbergGroup R n}
    (hy : y ∈ KTwo R n) (hnorm : y ∈ Subgroup.normalizer (rowSubgroup (R := R) (n := n) i)) :
    ∀ x ∈ rowSubgroup (R := R) (n := n) i, y * x = x * y := by
  intro x hx
  have hconj : y * x * y⁻¹ ∈ rowSubgroup (R := R) (n := n) i :=
    (Subgroup.mem_normalizer_iff.1 hnorm x).1 hx
  have hy1 : steinbergToGL y = 1 := (mem_KTwo_iff y).1 hy
  have himg : steinbergToGL (y * x * y⁻¹) = steinbergToGL x := by
    rw [map_mul, map_mul, map_inv, hy1, one_mul, inv_one, mul_one]
  have heq : y * x * y⁻¹ = x :=
    steinbergToGL_injOn_rowSubgroup i hconj hx himg
  have hmul := congrArg (fun z => z * y) heq
  simpa [mul_assoc] using hmul

omit [Fintype n] in
/-- The index generators avoid a spare index in the second position too. -/
theorem indexGens_mem_rowNormalizer {T : Finset n} {i : n} (hi : i ∉ T) :
    ∀ z ∈ indexGens (R := R) (n := n) T,
      z ∈ Subgroup.normalizer (rowSubgroup (R := R) (n := n) i) := by
  rintro z ⟨p, q, hpq, _, hqT, b, rfl⟩
  refine steinbergX_mem_rowNormalizer hpq ?_ b
  intro hcon
  exact hi (hcon ▸ hqT)

/-- **An element of `K₂` centralizes the row at any index its word avoids.** -/
theorem KTwo_commute_rowSubgroup_of_not_mem {y : SteinbergGroup R n} {T : Finset n} {i : n}
    (hy : y ∈ KTwo R n) (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hi : i ∉ T) :
    ∀ x ∈ rowSubgroup (R := R) (n := n) i, y * x = x * y := by
  refine KTwo_commute_rowSubgroup_of_mem_normalizer hy ?_
  exact (Subgroup.closure_le _).2 (indexGens_mem_rowNormalizer hi) hyT

/-! ## Centrality -/

/-- **An element of `K₂` commutes with every generator.**  At an index its word avoids it
centralizes both the column and the row, and every generator is a commutator of one of each. -/
theorem KTwo_commute_steinbergX {y : SteinbergGroup R n} {T : Finset n} {h : n}
    (hy : y ∈ KTwo R n) (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hh : h ∉ T) {i j : n} (hij : i ≠ j) (a : R) :
    y * steinbergX hij a = steinbergX hij a * y := by
  by_cases hjh : j = h
  · subst hjh
    exact KTwo_commute_columnSubgroup_of_not_mem hy hyT hh _
      (steinbergX_mem_columnSubgroup hij a)
  · by_cases hih : i = h
    · subst hih
      exact KTwo_commute_rowSubgroup_of_not_mem hy hyT hh _ (steinbergX_mem_rowSubgroup hij a)
    · have hhj : h ≠ j := fun hc => hjh hc.symm
      have hcomm := steinbergX_eq_commutator hih hhj hij a
      have hc1 : Commute y (steinbergX hih a) :=
        KTwo_commute_columnSubgroup_of_not_mem hy hyT hh _
          (steinbergX_mem_columnSubgroup hih a)
      have hc2 : Commute y (steinbergX hhj (1 : R)) :=
        KTwo_commute_rowSubgroup_of_not_mem hy hyT hh _ (steinbergX_mem_rowSubgroup hhj 1)
      rw [hcomm]
      exact ((hc1.mul_right hc2).mul_right hc1.inv_right).mul_right hc2.inv_right

/-- **`K₂` is central.**  An element of `K₂` whose word avoids some index lies in the centre of the
Steinberg group.  This is the centrality half of "`St(R) → E(R)` is the universal central
extension"; the other half, perfectness, is `steinbergGroup_perfect`. -/
theorem KTwo_mem_center {y : SteinbergGroup R n} {T : Finset n} {h : n}
    (hy : y ∈ KTwo R n) (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hh : h ∉ T) :
    y ∈ Subgroup.center (SteinbergGroup R n) := by
  have hgen : (⊤ : Subgroup (SteinbergGroup R n))
      = Subgroup.closure (Set.range (PresentedGroup.of : SteinbergGen R n → SteinbergGroup R n)) :=
    (PresentedGroup.closure_range_of (steinbergRels R n)).symm
  have hclosure : Subgroup.closure
        (Set.range (PresentedGroup.of : SteinbergGen R n → SteinbergGroup R n))
      ≤ Subgroup.centralizer ({y} : Set (SteinbergGroup R n)) := by
    refine (Subgroup.closure_le _).2 ?_
    rintro z ⟨g, rfl⟩
    show steinbergX g.hij g.a ∈ (Subgroup.centralizer ({y} : Set (SteinbergGroup R n)) :
      Set (SteinbergGroup R n))
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    rintro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    exact KTwo_commute_steinbergX hy hyT hh g.hij g.a
  have hcent : (⊤ : Subgroup (SteinbergGroup R n))
      ≤ Subgroup.centralizer ({y} : Set (SteinbergGroup R n)) :=
    le_trans (le_of_eq hgen) hclosure
  rw [Subgroup.mem_center_iff]
  intro z
  have hz := hcent (Subgroup.mem_top z)
  rw [Subgroup.mem_centralizer_iff] at hz
  exact (hz y (Set.mem_singleton y)).symm

/-- **Centrality at a spare index.**  If the index type has an index to spare beyond the word of
`y`, then `y` is central. -/
theorem KTwo_mem_center_of_card {y : SteinbergGroup R n} (hy : y ∈ KTwo R n)
    {T : Finset n} (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hcard : T.card < Fintype.card n) :
    y ∈ Subgroup.center (SteinbergGroup R n) := by
  have hne : T ≠ Finset.univ := by
    intro hcon
    rw [hcon, Finset.card_univ] at hcard
    exact lt_irrefl _ hcard
  obtain ⟨h, hh⟩ : ∃ h : n, h ∉ T := by
    by_contra hcon
    push Not at hcon
    exact hne (Finset.eq_univ_iff_forall.2 hcon)
  exact KTwo_mem_center hy hyT hh

end GaloisForLFunctions.HTGeometry

end
