import GaloisForLFunctions.HTGeometry.PrimeRadialFusionKolchinRank
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.SetTheory.Cardinal.Finite

/-!
# Intrinsic tail-relative rank of prime-radial differential fields

The visible valuation quotient is not merely represented by a chosen rectangle of jets.  Its
lifted channels generate the whole radial differential field over the complete invisible tail,
and every bounded jet field has intrinsic ordinary transcendence degree equal to the size of the
channel-by-jet rectangle.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

set_option maxHeartbeats 2400000

universe u

/-! ## A reusable exact transcendence-degree lemma -/

/-- An algebraically independent family is a transcendence basis of the ordinary field that it
generates, so the transcendence degree of that field is exactly the cardinality of the family. -/
theorem trdeg_intermediateFieldAdjoin_range_eq_cardinalMk_of_algebraicIndependent
    {F E I : Type u} [Field F] [Field E] [Algebra F E]
    (x : I → E) (hx : AlgebraicIndependent F x) :
    Algebra.trdeg F (IntermediateField.adjoin F (Set.range x)) = Cardinal.mk I := by
  let L := IntermediateField.adjoin F (Set.range x)
  let xL : I → L := fun i =>
    ⟨x i, IntermediateField.subset_adjoin F (Set.range x) (Set.mem_range_self i)⟩
  have hxL : AlgebraicIndependent F xL := by
    apply AlgebraicIndependent.of_comp (L.val : L →ₐ[F] E)
    simpa only [Function.comp_apply, L, xL] using! hx
  have htop : IntermediateField.adjoin F (Set.range xL) = ⊤ := by
    let J := IntermediateField.adjoin F (Set.range xL)
    apply top_unique
    intro z hz
    change z ∈ J
    let p : ∀ y, y ∈ L → Prop := fun y hy => (⟨y, hy⟩ : L) ∈ J
    change p (z : E) z.2
    refine IntermediateField.adjoin_induction F (p := p) ?_ ?_ ?_ ?_ ?_ z.2
    · rintro y ⟨i, rfl⟩
      change xL i ∈ J
      exact IntermediateField.subset_adjoin F (Set.range xL) (Set.mem_range_self i)
    · intro c
      change algebraMap F L c ∈ J
      exact IntermediateField.algebraMap_mem J c
    · intro a b ha hb haJ hbJ
      simpa only [p, Subtype.coe_eta] using! J.add_mem haJ hbJ
    · intro a ha haJ
      simpa only [p, Subtype.coe_eta] using! J.inv_mem haJ
    · intro a b ha hb haJ hbJ
      simpa only [p, Subtype.coe_eta] using! J.mul_mem haJ hbJ
  have halg : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range xL)) L := by
    apply (IntermediateField.isAlgebraic_adjoin_iff_top
      (F := F) (s := Set.range xL) (S := L)).mp
    constructor
    intro a
    let J := IntermediateField.adjoin F (Set.range xL)
    let aJ : J := ⟨a, by
      change a ∈ IntermediateField.adjoin F (Set.range xL)
      rw [htop]
      trivial⟩
    have haJ : algebraMap J L aJ = a := rfl
    rw [← haJ]
    exact isAlgebraic_algebraMap (R := J) (A := L) aJ
  have hbasis : IsTranscendenceBasis F xL :=
    hxL.isTranscendenceBasis_iff_isAlgebraic.mpr halg
  simpa only [L] using hbasis.cardinalMk_eq_trdeg.symm

/-! ## Profile spans generate exactly their radial differential fields -/

/-- The fraction-field carrier of one radial profile. -/
def primeRadialCarrierOfProfile
    (u : PrimeRadialProfile) : arithmeticFunctionFractionField :=
  algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (primeRadialSource u)

@[simp]
theorem primeRadialCarrierOfProfile_zero :
    primeRadialCarrierOfProfile 0 = 0 := by
  simp [primeRadialCarrierOfProfile]

@[simp]
theorem primeRadialCarrierOfProfile_add (u v : PrimeRadialProfile) :
    primeRadialCarrierOfProfile (u + v) =
      primeRadialCarrierOfProfile u + primeRadialCarrierOfProfile v := by
  simp [primeRadialCarrierOfProfile]

@[simp]
theorem primeRadialCarrierOfProfile_smul (z : ℂ) (u : PrimeRadialProfile) :
    primeRadialCarrierOfProfile (z • u) = z • primeRadialCarrierOfProfile u := by
  unfold primeRadialCarrierOfProfile
  rw [map_smul]
  simp only [Algebra.smul_def, map_mul,
    IsScalarTower.algebraMap_apply ℂ (ArithmeticFunction ℂ)
      arithmeticFunctionFractionField]

/-- Every carrier whose profile lies in a linear span already belongs to the differential field
generated by the spanning carrier family. -/
theorem primeRadialCarrierOfProfile_mem_differentialAdjoin_of_mem_span
    {I : Type*} (u : I → PrimeRadialProfile) (v : PrimeRadialProfile)
    (hv : v ∈ Submodule.span ℂ (Set.range u)) :
    primeRadialCarrierOfProfile v ∈
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => primeRadialCarrierOfProfile (u i))) := by
  let L := GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
    (Set.range (fun i => primeRadialCarrierOfProfile (u i)))
  refine Submodule.span_induction
    (p := fun w : PrimeRadialProfile => fun _ => primeRadialCarrierOfProfile w ∈ L)
    (hx := hv) ?_ ?_ ?_ ?_
  · intro w hw
    obtain ⟨i, rfl⟩ := hw
    exact GaloisForLFunctions.subset_differentialAdjoin finitePrimeCoefficientField _
      (Set.mem_range_self i)
  · simp [L]
  · intro w z _hw _hz hwL hzL
    simpa [L] using L.add_mem hwL hzL
  · intro a w _hw hwL
    have haL : algebraMap ℂ arithmeticFunctionFractionField a ∈ L := by
      simpa only [IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
        arithmeticFunctionFractionField] using
        L.algebraMap_mem (algebraMap ℂ finitePrimeCoefficientField a)
    have hmul := L.mul_mem haL hwL
    simpa only [primeRadialCarrierOfProfile_smul, Algebra.smul_def] using hmul

/-- Differential adjunction of a radial carrier family depends exactly on the linear span of its
profiles. -/
theorem differentialAdjoin_primeRadialCarrier_eq_primeRadialDifferentialField_span
    {I : Type*} (u : I → PrimeRadialProfile) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => primeRadialCarrierOfProfile (u i))) =
      primeRadialDifferentialField (Submodule.span ℂ (Set.range u)) := by
  apply le_antisymm
  · apply GaloisForLFunctions.differentialAdjoin_le finitePrimeCoefficientField
    · rintro _ ⟨i, rfl⟩
      exact (primeRadialSource_mem_differentialField_iff
        (Submodule.span ℂ (Set.range u)) (u i)).mpr
          (Submodule.subset_span (Set.mem_range_self i))
    · exact GaloisForLFunctions.derivationClosed_differentialAdjoin
        finitePrimeCoefficientField _
  · unfold primeRadialDifferentialField
    apply GaloisForLFunctions.differentialAdjoin_le finitePrimeCoefficientField
    · rintro _ ⟨i, rfl⟩
      exact primeRadialCarrierOfProfile_mem_differentialAdjoin_of_mem_span u _
        (Module.Basis.ofVectorSpace ℂ (Submodule.span ℂ (Set.range u)) i).2
    · exact GaloisForLFunctions.derivationClosed_differentialAdjoin
        finitePrimeCoefficientField _

/-! ## The visible quotient and generation over the complete tail -/

/-- The complete tail together with the lifted visible channels spans the original profile
subspace. -/
theorem primeRadialTail_sup_prefixSpan_eq
    (W : Submodule ℂ PrimeRadialProfile) (N : Nat) :
    primeRadialTailSubmodule W N ⊔
        Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N)) = W := by
  apply le_antisymm
  · apply sup_le
    · exact inf_le_left
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact (primeRadialPrefixChannelLiftInW W N i).2
  · intro u hu
    let R := PrimeRadialPrefixRange W N
    let b := Module.Basis.ofVectorSpace ℂ R
    let q : R := ⟨primeRadialPrefixMap N u, ⟨⟨u, hu⟩, rfl⟩⟩
    let v : PrimeRadialProfile :=
      (b.repr q).sum fun i z => z • primeRadialPrefixChannelProfile W N i
    have hvW : v ∈ W := by
      change (b.repr q).sum
        (fun i z => z • primeRadialPrefixChannelProfile W N i) ∈ W
      rw [Finsupp.sum]
      exact Submodule.sum_mem W fun i _ =>
        W.smul_mem _ (primeRadialPrefixChannelLiftInW W N i).2
    have hvspan :
        v ∈ Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N)) := by
      change (b.repr q).sum
        (fun i z => z • primeRadialPrefixChannelProfile W N i) ∈
          Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N))
      rw [Finsupp.sum]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
        (Submodule.subset_span (Set.mem_range_self i))
    have hmap : primeRadialPrefixMap N v = primeRadialPrefixMap N u := by
      change primeRadialPrefixMap N
          ((b.repr q).sum fun i z => z • primeRadialPrefixChannelProfile W N i) =
        primeRadialPrefixMap N u
      rw [map_finsuppSum]
      have hterm : ∀ i (z : ℂ),
          primeRadialPrefixMap N (z • primeRadialPrefixChannelProfile W N i) =
            z • ((b i : R) : Fin N → ℂ) := by
        intro i z
        rw [map_smul]
        exact congrArg (fun y => z • y)
          (primeRadialPrefixMap_channelLiftInW W N i)
      rw [Finsupp.sum_fintype _ _ (by intro i; simp)]
      simp_rw [hterm]
      have hrepr := congrArg (R.subtype : R →ₗ[ℂ] (Fin N → ℂ)) (b.sum_repr q)
      simpa [R, b, q] using hrepr
    have htail : u - v ∈ primeRadialTailSubmodule W N := by
      refine ⟨W.sub_mem hu hvW, ?_⟩
      change primeRadialPrefixMap N (u - v) = 0
      rw [map_sub, hmap, sub_self]
    have htailSup : u - v ∈ primeRadialTailSubmodule W N ⊔
        Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N)) :=
      (le_sup_left : primeRadialTailSubmodule W N ≤
        primeRadialTailSubmodule W N ⊔
          Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N))) htail
    have hvSup : v ∈ primeRadialTailSubmodule W N ⊔
        Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N)) :=
      (le_sup_right : Submodule.span ℂ
          (Set.range (primeRadialPrefixChannelProfile W N)) ≤
        primeRadialTailSubmodule W N ⊔
          Submodule.span ℂ (Set.range (primeRadialPrefixChannelProfile W N))) hvspan
    simpa only [sub_add_cancel] using Submodule.add_mem _ htailSup hvSup

/-- The differential field obtained by adjoining the visible quotient channels to the complete
invisible tail. -/
def primeRadialRelativeDifferentialField
    (W : Submodule ℂ PrimeRadialProfile) (N : Nat) :
    IntermediateField (primeRadialTailDifferentialField W N)
      arithmeticFunctionFractionField :=
  GaloisForLFunctions.differentialAdjoin (primeRadialTailDifferentialField W N)
    (Set.range (primeRadialPrefixChannelCarrier W N))

/-- **Tail-extension generation law.**  After restricting scalars back to the intrinsic prime
coefficient field, adjoining the visible quotient channels to the complete tail gives exactly the
radial differential field represented by `W`. -/
theorem primeRadialRelativeDifferentialField_restrictScalars_eq
    (W : Submodule ℂ PrimeRadialProfile) (N : Nat) :
    (primeRadialRelativeDifferentialField W N).restrictScalars
        finitePrimeCoefficientField =
      primeRadialDifferentialField W := by
  unfold primeRadialRelativeDifferentialField primeRadialTailDifferentialField
  rw [GaloisForLFunctions.differentialAdjoin_union]
  rw [← Set.Sum.elim_range]
  let profiles := Sum.elim
    (primeRadialBasisProfile (primeRadialTailSubmodule W N))
    (primeRadialPrefixChannelProfile W N)
  have hcarriers :
      Sum.elim (primeRadialTailBasisCarrier W N)
          (primeRadialPrefixChannelCarrier W N) =
        fun q => primeRadialCarrierOfProfile (profiles q) := by
    funext q
    rcases q with i | j <;> rfl
  rw [hcarriers,
    differentialAdjoin_primeRadialCarrier_eq_primeRadialDifferentialField_span]
  have hspan : Submodule.span ℂ (Set.range profiles) = W := by
    change Submodule.span ℂ (Set.range (Sum.elim
      (primeRadialBasisProfile (primeRadialTailSubmodule W N))
      (primeRadialPrefixChannelProfile W N))) = W
    rw [Set.Sum.elim_range, Submodule.span_union,
      span_primeRadialBasisProfile, primeRadialTail_sup_prefixSpan_eq]
  exact congrArg primeRadialDifferentialField hspan

/-! ## Intrinsic finite-jet transcendence degree -/

/-- The finite visible channel-by-jet family. -/
def primeRadialPrefixJetFamily
    (W : Submodule ℂ PrimeRadialProfile) (N r : Nat) :
    PrimeRadialPrefixChannelIndex W N × Fin (r + 1) →
      arithmeticFunctionFractionField :=
  fun q => GaloisForLFunctions.differentialJet q.2
    (primeRadialPrefixChannelCarrier W N q.1)

/-- The ordinary field generated by the finite visible jet block over the complete tail. -/
def primeRadialFiniteJetField
    (W : Submodule ℂ PrimeRadialProfile) (N r : Nat) :
    IntermediateField (primeRadialTailDifferentialField W N)
      arithmeticFunctionFractionField :=
  IntermediateField.adjoin (primeRadialTailDifferentialField W N)
    (Set.range (primeRadialPrefixJetFamily W N r))

/-- The finite visible jet family is algebraically independent over the complete tail. -/
theorem algebraicIndependent_primeRadialPrefixJetFamily
    (W : Submodule ℂ PrimeRadialProfile) (N r : Nat) :
    AlgebraicIndependent (primeRadialTailDifferentialField W N)
      (primeRadialPrefixJetFamily W N r) := by
  simpa only [primeRadialPrefixJetFamily] using!
    algebraicIndependent_primeRadialPrefixChannelJetRectangle W N r

/-- **Intrinsic finite-jet rank law.**  The ordinary transcendence degree of the generated
finite-jet field is exactly the cardinality of the channel-by-jet block. -/
theorem primeRadialFiniteJetField_trdeg
    (W : Submodule ℂ PrimeRadialProfile) (N r : Nat) :
    Algebra.trdeg (primeRadialTailDifferentialField W N)
        (primeRadialFiniteJetField W N r) =
      Cardinal.mk (PrimeRadialPrefixChannelIndex W N × Fin (r + 1)) := by
  exact trdeg_intermediateFieldAdjoin_range_eq_cardinalMk_of_algebraicIndependent
    (primeRadialPrefixJetFamily W N r)
    (algebraicIndependent_primeRadialPrefixJetFamily W N r)

/-- The intrinsic finite-jet transcendence degree is the integer
`(r + 1) * dim π_N(W)`. -/
theorem primeRadialFiniteJetField_trdeg_eq_relativeJetRank
    (W : Submodule ℂ PrimeRadialProfile) (N r : Nat) :
    Algebra.trdeg (primeRadialTailDifferentialField W N)
        (primeRadialFiniteJetField W N r) =
      (primeRadialKolchinRank W N r : Cardinal) := by
  rw [primeRadialFiniteJetField_trdeg, ← Nat.cast_card,
    primeRadialPrefixChannelJetRectangle_natCard]

end

end GaloisForLFunctions.HTGeometry
