import GaloisForLFunctions.HTGeometry.GomesFormalConstantLineOrder
import GaloisForLFunctions.HTGeometry.GomesFormalParityGenerators
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Exact algebra generated by differentiation and parity

Over the scalar formal-series center, these two actual operators generate the
entire constant-line algebra. The result is a sharp classification, not only a
failure to generate the full second-derivative commutant.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- The formal matrix algebra generated by differentiation and a chosen affine reflection. -/
def gomesDerivativeReflectionGeneratedAlgebra (c : K) :
    Subalgebra (PowerSeries K) (Matrix (Fin 2) (Fin 2) (PowerSeries K)) :=
  Algebra.adjoin (PowerSeries K) {gomesEvenOddDerivativeMatrix K, gomesPolynomialReflectionMatrix K c}

/-- The derivative belongs to every generated reflection algebra. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_derivative_mem (c : K) :
    gomesEvenOddDerivativeMatrix K ∈ gomesDerivativeReflectionGeneratedAlgebra K c :=
  Algebra.subset_adjoin (Set.mem_insert _ _)

/-- The chosen reflection belongs to its generated algebra. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_reflection_mem (c : K) :
    gomesPolynomialReflectionMatrix K c ∈ gomesDerivativeReflectionGeneratedAlgebra K c :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- Both generators lie in the exact constant-line algebra at every center. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_le_constantLine (c : K) :
    gomesDerivativeReflectionGeneratedAlgebra K c ≤ gomesFormalConstantLineOrder K := by
  apply Algebra.adjoin_le
  intro M hM
  rcases hM with rfl | hM
  · simp [gomesFormalConstantLineOrder_mem_iff, gomesEvenOddDerivativeMatrix]
  · rcases hM with rfl
    change PowerSeries.constantCoeff (gomesPolynomialReflectionMatrix K c 1 0) = 0
    rw [gomesPolynomialReflectionMatrix_eq]
    simp

/-- Differentiation and parity generate every matrix satisfying the boundary condition. -/
theorem gomesDerivativeParityGeneratedAlgebra_eq_constantLine :
    gomesDerivativeReflectionGeneratedAlgebra K 0 = gomesFormalConstantLineOrder K := by
  apply le_antisymm (gomesDerivativeReflectionGeneratedAlgebra_le_constantLine K 0)
  let S := gomesDerivativeReflectionGeneratedAlgebra K 0
  have hD : gomesEvenOddDerivativeMatrix K ∈ S :=
    gomesDerivativeReflectionGeneratedAlgebra_derivative_mem K 0
  have hR : gomesPolynomialReflectionMatrix K 0 ∈ S :=
    gomesDerivativeReflectionGeneratedAlgebra_reflection_mem K 0
  have h00 : ( !![1, 0; 0, 0] : Matrix (Fin 2) (Fin 2) (PowerSeries K)) ∈ S := by
    rw [← gomesParity_half_add_projection K]
    exact S.smul_mem (S.add_mem S.one_mem hR) _
  have h11 : ( !![0, 0; 0, 1] : Matrix (Fin 2) (Fin 2) (PowerSeries K)) ∈ S := by
    rw [← gomesParity_half_sub_projection K]
    exact S.smul_mem (S.sub_mem S.one_mem hR) _
  have h01 : ( !![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) (PowerSeries K)) ∈ S := by
    rw [← gomesParity_half_add_derivative_upperTransfer K]
    exact S.smul_mem (S.add_mem hD (S.mul_mem hR hD)) _
  have h10 : ( !![0, 0; PowerSeries.X, 0] : Matrix (Fin 2) (Fin 2) (PowerSeries K)) ∈ S := by
    rw [← gomesParity_half_sub_derivative_lowerTransfer K]
    exact S.smul_mem (S.sub_mem hD (S.mul_mem hR hD)) _
  intro M hM
  obtain ⟨a, b, c, d, rfl⟩ := (gomesFormalConstantLineOrder_mem_iff_matrix K M).mp hM
  rw [gomesFormalConstantLine_matrix_decomposition]
  exact S.add_mem (S.add_mem (S.add_mem (S.smul_mem h00 a) (S.smul_mem h01 b))
    (S.smul_mem h10 c)) (S.smul_mem h11 d)

end GaloisForLFunctions.HTGeometry
