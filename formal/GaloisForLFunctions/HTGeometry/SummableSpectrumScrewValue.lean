import GaloisForLFunctions.HTGeometry.SummableSpectrumScrewHull

/-!
# The value functional of a summable-spectrum screw line

A summable positive weight family `a` turns the product torus into a bounded
nonnegative energy landscape
`F(z) = ∑ a i * (1 - Re z i)`,
whose restriction to the screw line is the almost-periodic series
`P(t) = ∑ a i * (1 - cos (omega i * t))`.

The landscape is continuous and takes values in `[0, 2 ∑ a]`. Its image on the
relation hull is exactly a closed interval starting at zero, because the hull is
compact and connected. The upper endpoint reaches the absolute bound `2 ∑ a` exactly
when the all-antipodal phase lies in the hull, which by the relation-hull law is an
exact parity condition on the lattice of integer relations among the frequencies.
-/

open Complex Filter MeasureTheory Set Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {I : Type*}

/-! ## The circle coordinate -/

/-- Complex coordinate of a point of the unit additive circle. -/
def screwCoord (x : UnitAddCircle) : ℂ := fourier 1 x

theorem screwCoord_continuous : Continuous (screwCoord : UnitAddCircle → ℂ) :=
  (fourier 1).continuous

theorem screwCoord_norm (x : UnitAddCircle) : ‖screwCoord x‖ = 1 := by
  rw [screwCoord, fourier_apply]
  exact Circle.norm_coe _

theorem screwCoord_ofReal (r : ℝ) :
    screwCoord ((r : ℝ) : UnitAddCircle) =
      Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (r : ℂ)) := by
  rw [screwCoord, fourier_coe_apply]
  norm_num

@[simp]
theorem screwCoord_zero : screwCoord (0 : UnitAddCircle) = 1 := by
  rw [screwCoord, fourier_apply]
  simp

theorem abs_screwCoord_re_le_one (x : UnitAddCircle) : |(screwCoord x).re| ≤ 1 := by
  have h := Complex.abs_re_le_norm (screwCoord x)
  rwa [screwCoord_norm] at h

theorem screwCoord_re_le_one (x : UnitAddCircle) : (screwCoord x).re ≤ 1 :=
  (abs_le.mp (abs_screwCoord_re_le_one x)).2

theorem neg_one_le_screwCoord_re (x : UnitAddCircle) : (-1 : ℝ) ≤ (screwCoord x).re :=
  (abs_le.mp (abs_screwCoord_re_le_one x)).1

/-- The all-antipodal phase point: every coordinate is the half period. -/
def screwAntipode (I : Type*) : I → UnitAddCircle := fun _ => ((1 / 2 : ℝ) : UnitAddCircle)

theorem screwCoord_antipode : screwCoord ((1 / 2 : ℝ) : UnitAddCircle) = -1 := by
  rw [screwCoord_ofReal]
  rw [show 2 * (Real.pi : ℂ) * Complex.I * ((1 / 2 : ℝ) : ℂ) = (Real.pi : ℂ) * Complex.I by
    push_cast; ring]
  exact Complex.exp_pi_mul_I

/-- A unit-modulus coordinate with real part `-1` is the half period. -/
theorem eq_half_of_screwCoord_re_eq_neg_one {x : UnitAddCircle}
    (hx : (screwCoord x).re = -1) : x = ((1 / 2 : ℝ) : UnitAddCircle) := by
  have hnorm : ‖screwCoord x‖ = 1 := screwCoord_norm x
  have hval : screwCoord x = -1 := by
    have hsq : (screwCoord x).re ^ 2 + (screwCoord x).im ^ 2 = 1 := by
      have hns : Complex.normSq (screwCoord x) = 1 := by
        rw [Complex.normSq_eq_norm_sq, hnorm]; norm_num
      simpa [Complex.normSq_apply, sq] using hns
    have him : (screwCoord x).im = 0 := by
      have : (screwCoord x).im ^ 2 = 0 := by
        rw [hx] at hsq; nlinarith [hsq]
      exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp this
    apply Complex.ext <;> simp [hx, him]
  have hcirc : AddCircle.toCircle (T := (1 : ℝ)) x =
      AddCircle.toCircle (T := (1 : ℝ)) ((1 / 2 : ℝ) : UnitAddCircle) := by
    apply Subtype.ext
    have h1 : ((AddCircle.toCircle (T := (1 : ℝ)) x : Circle) : ℂ) = -1 := by
      rw [← hval, screwCoord, fourier_apply, one_smul]
    have h2 : ((AddCircle.toCircle (T := (1 : ℝ)) ((1 / 2 : ℝ) : UnitAddCircle) : Circle) : ℂ)
        = -1 := by
      rw [← screwCoord_antipode, screwCoord, fourier_apply, one_smul]
    rw [h1, h2]
  exact AddCircle.injective_toCircle one_ne_zero hcirc

/-! ## The value functional -/

/-- Weighted phase-defect energy of a torus point. -/
def screwValue (a : I → ℝ) (z : I → UnitAddCircle) : ℝ :=
  ∑' i, a i * (1 - (screwCoord (z i)).re)

/-- The screw series generated by the weights `a` and the frequencies `omega`. -/
def screwSeries (a omega : I → ℝ) (t : ℝ) : ℝ :=
  ∑' i, a i * (1 - Real.cos (omega i * t))

theorem screwCoord_screwPhase_re (omega : I → ℝ) (t : ℝ) (i : I) :
    (screwCoord (screwPhase omega t i)).re = Real.cos (omega i * t) := by
  rw [screwPhase, screwCoord_ofReal]
  rw [show 2 * (Real.pi : ℂ) * Complex.I * ((omega i * t / (2 * Real.pi) : ℝ) : ℂ)
      = ((omega i * t : ℝ) : ℂ) * Complex.I by
    have hpi : (Real.pi : ℂ) ≠ 0 := by
      exact_mod_cast Real.pi_ne_zero
    push_cast
    field_simp]
  exact Complex.exp_ofReal_mul_I_re _

/-- On the screw line the value functional is the almost-periodic screw series. -/
theorem screwSeries_eq_screwValue (a omega : I → ℝ) (t : ℝ) :
    screwSeries a omega t = screwValue a (screwPhase omega t) := by
  simp only [screwSeries, screwValue, screwCoord_screwPhase_re]

section Weights

variable {a : I → ℝ}

theorem screwValue_term_nonneg (hpos : ∀ i, 0 ≤ a i) (z : I → UnitAddCircle) (i : I) :
    0 ≤ a i * (1 - (screwCoord (z i)).re) :=
  mul_nonneg (hpos i) (by linarith [screwCoord_re_le_one (z i)])

theorem screwValue_term_le (hpos : ∀ i, 0 ≤ a i) (z : I → UnitAddCircle) (i : I) :
    a i * (1 - (screwCoord (z i)).re) ≤ 2 * a i := by
  have h := neg_one_le_screwCoord_re (z i)
  nlinarith [hpos i]

theorem screwValue_summable (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a)
    (z : I → UnitAddCircle) :
    Summable fun i => a i * (1 - (screwCoord (z i)).re) :=
  Summable.of_nonneg_of_le (screwValue_term_nonneg hpos z) (screwValue_term_le hpos z)
    (hsum.mul_left 2)

theorem screwValue_nonneg (hpos : ∀ i, 0 ≤ a i) (z : I → UnitAddCircle) :
    0 ≤ screwValue a z :=
  tsum_nonneg (screwValue_term_nonneg hpos z)

theorem screwValue_le_two_mul (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a)
    (z : I → UnitAddCircle) :
    screwValue a z ≤ 2 * ∑' i, a i := by
  rw [screwValue, ← tsum_mul_left]
  exact (screwValue_summable hpos hsum z).tsum_le_tsum (screwValue_term_le hpos z)
    (hsum.mul_left 2)

@[simp]
theorem screwValue_zero (a : I → ℝ) : screwValue a (0 : I → UnitAddCircle) = 0 := by
  simp [screwValue]

theorem screwValue_continuous (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a) :
    Continuous (screwValue a) := by
  refine continuous_tsum (u := fun i => 2 * a i) (fun i => ?_) (hsum.mul_left 2) ?_
  · exact (continuous_const.mul
      ((continuous_const.sub
        (Complex.continuous_re.comp
          (screwCoord_continuous.comp (continuous_apply i))))))
  · intro i z
    rw [Real.norm_eq_abs, abs_of_nonneg (screwValue_term_nonneg hpos z i)]
    exact screwValue_term_le hpos z i

/-- The all-antipodal phase realizes the absolute energy bound. -/
theorem screwValue_antipode (a : I → ℝ) :
    screwValue a (screwAntipode I) = 2 * ∑' i, a i := by
  rw [screwValue, ← tsum_mul_left]
  refine tsum_congr fun i => ?_
  rw [screwAntipode, screwCoord_antipode, Complex.neg_re, Complex.one_re]
  ring

/-- Strict positivity of the weights makes the absolute bound rigid: only the
all-antipodal phase attains it. -/
theorem eq_screwAntipode_of_screwValue_eq (hpos : ∀ i, 0 < a i) (hsum : Summable a)
    {z : I → UnitAddCircle} (hz : screwValue a z = 2 * ∑' i, a i) :
    z = screwAntipode I := by
  have hpos' : ∀ i, 0 ≤ a i := fun i => (hpos i).le
  have hdiff : ∀ i, 0 ≤ 2 * a i - a i * (1 - (screwCoord (z i)).re) := by
    intro i
    have := neg_one_le_screwCoord_re (z i)
    nlinarith [hpos i]
  have hsumdiff : Summable fun i => 2 * a i - a i * (1 - (screwCoord (z i)).re) :=
    (hsum.mul_left 2).sub (screwValue_summable hpos' hsum z)
  have htsum : (∑' i, (2 * a i - a i * (1 - (screwCoord (z i)).re))) = 0 := by
    rw [Summable.tsum_sub (hsum.mul_left 2) (screwValue_summable hpos' hsum z)]
    rw [tsum_mul_left, ← screwValue, hz]
    ring
  have hzero : ∀ i, 2 * a i - a i * (1 - (screwCoord (z i)).re) = 0 := by
    intro i
    have hle := hsumdiff.le_tsum i (fun j _ => hdiff j)
    rw [htsum] at hle
    linarith [hdiff i]
  funext i
  have hre : (screwCoord (z i)).re = -1 := by
    have h := hzero i
    have ha := hpos i
    nlinarith [h, ha]
  exact eq_half_of_screwCoord_re_eq_neg_one hre

end Weights


/-! ## Value law and parity law on the relation hull -/

section Hull

variable [Countable I] {a omega : I → ℝ}

/-- Maximal phase-defect energy attained on the relation hull. -/
def screwHullMax (a omega : I → ℝ) : ℝ := sSup (screwValue a '' screwHull omega)

theorem isGreatest_screwHullMax (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a) :
    IsGreatest (screwValue a '' screwHull omega) (screwHullMax a omega) := by
  obtain ⟨z, hz, hmax⟩ :=
    (isCompact_screwHull omega).exists_isMaxOn ⟨0, zero_mem_screwHull omega⟩
      (screwValue_continuous hpos hsum).continuousOn
  have hg : IsGreatest (screwValue a '' screwHull omega) (screwValue a z) := by
    refine ⟨⟨z, hz, rfl⟩, ?_⟩
    rintro _ ⟨w, hw, rfl⟩
    exact hmax hw
  rw [screwHullMax, hg.csSup_eq]
  exact hg

theorem screwValue_le_screwHullMax (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a)
    {z : I → UnitAddCircle} (hz : z ∈ screwHull omega) :
    screwValue a z ≤ screwHullMax a omega :=
  (isGreatest_screwHullMax hpos hsum).2 ⟨z, hz, rfl⟩

theorem screwHullMax_nonneg (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a) :
    0 ≤ screwHullMax (a := a) (omega := omega) := by
  have := screwValue_le_screwHullMax hpos hsum (zero_mem_screwHull omega)
  simpa using this

theorem screwHullMax_le_two_mul (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a) :
    screwHullMax (a := a) (omega := omega) ≤ 2 * ∑' i, a i := by
  obtain ⟨z, _, hz⟩ := (isGreatest_screwHullMax (omega := omega) hpos hsum).1
  rw [← hz]
  exact screwValue_le_two_mul hpos hsum z

/-- **No-gap value law.** The phase-defect energy image of the relation hull is exactly
the closed interval from zero to the maximal energy: a compact connected domain has a
compact connected real image, whose minimum is the neutral phase. -/
theorem screwValue_image_screwHull (hpos : ∀ i, 0 ≤ a i) (hsum : Summable a) :
    screwValue a '' screwHull omega = Set.Icc 0 (screwHullMax a omega) := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨z, hz, rfl⟩
    exact ⟨screwValue_nonneg hpos z, screwValue_le_screwHullMax hpos hsum hz⟩
  · obtain ⟨zmax, hzmax, hval⟩ := (isGreatest_screwHullMax (omega := omega) hpos hsum).1
    have hiv :=
      (isConnected_screwHull omega).isPreconnected.intermediate_value
        (zero_mem_screwHull omega) hzmax (screwValue_continuous hpos hsum).continuousOn
    rw [screwValue_zero, hval] at hiv
    exact hiv

end Hull

/-! ## The antipodal character and the parity obstruction -/

private theorem prod_neg_one_zpow {I : Type*} (s : Finset I) (f : I → ℤ) :
    ∏ i ∈ s, (-1 : ℂ) ^ (f i) = (-1 : ℂ) ^ (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
      rw [Finset.prod_insert hi, Finset.sum_insert hi, ih,
        ← zpow_add₀ (by norm_num : (-1 : ℂ) ≠ 0)]

theorem fourier_antipode (m : ℤ) :
    fourier m ((1 / 2 : ℝ) : UnitAddCircle) = (-1 : ℂ) ^ m := by
  rw [fourier_coe_apply]
  rw [show 2 * (Real.pi : ℂ) * Complex.I * (m : ℂ) * ((1 / 2 : ℝ) : ℂ) / (1 : ℝ)
      = (m : ℂ) * ((Real.pi : ℂ) * Complex.I) by push_cast; ring]
  rw [Complex.exp_int_mul, Complex.exp_pi_mul_I]

/-- The antipodal phase evaluates a finite-support character to the parity sign of its
total coefficient. -/
theorem infiniteTorusFourier_screwAntipode {I : Type*} (n : I →₀ ℤ) :
    infiniteTorusFourier n (screwAntipode I) = (-1 : ℂ) ^ (n.sum fun _ m => m) := by
  classical
  simp only [infiniteTorusFourier, ContinuousMap.coe_mk, Finsupp.prod, Finsupp.sum,
    screwAntipode]
  rw [← prod_neg_one_zpow n.support fun i => n i]
  exact Finset.prod_congr rfl fun i _ => fourier_antipode (n i)

theorem neg_one_zpow_eq_one_iff (k : ℤ) : (-1 : ℂ) ^ k = 1 ↔ Even k := by
  refine ⟨fun h => ?_, fun h => h.neg_one_zpow⟩
  rcases Int.even_or_odd k with hk | hk
  · exact hk
  · rw [hk.neg_one_zpow] at h
    exact absurd h (by norm_num)

/-- The antipodal phase annihilates the relation lattice exactly when every relation has
even total coefficient. -/
theorem screwAntipode_mem_screwAnnihilator_iff {I : Type*} (omega : I → ℝ) :
    screwAntipode I ∈ screwAnnihilator omega ↔
      ∀ n : I →₀ ℤ, n ∈ screwRelationLattice omega → Even (n.sum fun _ m => m) := by
  constructor
  · intro h n hn
    have := h n hn
    rw [infiniteTorusFourier_screwAntipode] at this
    exact (neg_one_zpow_eq_one_iff _).mp this
  · intro h n hn
    rw [infiniteTorusFourier_screwAntipode]
    exact (neg_one_zpow_eq_one_iff _).mpr (h n hn)

/-- **Parity law.** With strictly positive summable weights, the maximal hull energy
attains the absolute bound `2 ∑ a` exactly when every finite integer relation among the
frequencies has even total coefficient. -/
theorem screwHullMax_eq_two_mul_tsum_iff [Countable I] {a omega : I → ℝ}
    (hpos : ∀ i, 0 < a i) (hsum : Summable a) :
    screwHullMax a omega = 2 * ∑' i, a i ↔
      ∀ n : I →₀ ℤ, n ∈ screwRelationLattice omega → Even (n.sum fun _ m => m) := by
  have hpos' : ∀ i, 0 ≤ a i := fun i => (hpos i).le
  rw [← screwAntipode_mem_screwAnnihilator_iff omega,
    ← screwHull_eq_screwAnnihilator omega]
  constructor
  · intro hmax
    obtain ⟨z, hz, hval⟩ := (isGreatest_screwHullMax (omega := omega) hpos' hsum).1
    rw [hmax] at hval
    rw [← eq_screwAntipode_of_screwValue_eq hpos hsum hval]
    exact hz
  · intro hmem
    refine le_antisymm (screwHullMax_le_two_mul hpos' hsum) ?_
    have := screwValue_le_screwHullMax (omega := omega) hpos' hsum hmem
    rwa [screwValue_antipode] at this

/-- Rational independence of the frequencies is sufficient but not necessary for the
parity condition: a trivial relation lattice satisfies it automatically. -/
theorem parity_of_screwRelationLattice_trivial {I : Type*} {omega : I → ℝ}
    (h : ∀ n : I →₀ ℤ, n ∈ screwRelationLattice omega → n = 0) :
    ∀ n : I →₀ ℤ, n ∈ screwRelationLattice omega → Even (n.sum fun _ m => m) := by
  intro n hn
  rw [h n hn]
  simp

end

end GaloisForLFunctions.HTGeometry
