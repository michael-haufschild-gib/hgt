import GaloisForLFunctions.HTGeometry.BarnesScalarAnnihilator
import GaloisForLFunctions.HTGeometry.NormalCrossingSourceTransport

/-!
# The Barnes source is a normal-crossing source

In the ladder variables `x_j = T_j - 1` the structural annihilator of the Barnes source is the
principal ideal generated by the product of all the variables.  For a frame of `N` periods that
principal ideal *is* the squarefree Veronese ideal of order `N`: the only squarefree monomial of
degree `N` in `N` variables is the full product.

Hence the Barnes source is a normal-crossing source of order `N`, and the whole physical package —
source height, arc-contact order, powered period-incidence level, polarizing half-density — is
transported to it by the package theorem.
-/

open scoped Differential BigOperators

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher VeroneseIdeal

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic zeroNomeScalarTower

variable {N : ℕ}

/-! ## The top Veronese ideal is principal -/

theorem veroneseGens_card (N : ℕ) :
    veroneseGens ℂ (Fin N) N = {∏ j, (MvPolynomial.X j : MvPolynomial (Fin N) ℂ)} := by
  ext P
  constructor
  · rintro ⟨J, hJ, rfl⟩
    have hJu : J = Finset.univ := by
      apply Finset.eq_univ_of_card
      rw [hJ, Fintype.card_fin]
    rw [hJu]
    rfl
  · rintro rfl
    exact ⟨Finset.univ, by rw [Finset.card_univ, Fintype.card_fin], rfl⟩

theorem veroneseIdeal_card (N : ℕ) :
    veroneseIdeal ℂ (Fin N) N
      = Ideal.span {∏ j, (MvPolynomial.X j : MvPolynomial (Fin N) ℂ)} := by
  rw [veroneseIdeal, veroneseGens_card]

/-! ## The ladder variables -/

/-- Passing from the ladder variables `x_j` to the translation variables `T_j = x_j + 1`. -/
def ladderVarSubst (N : ℕ) :
    MvPolynomial (Fin N) ℂ ≃ₐ[ℂ] MvPolynomial (Fin N) ℂ :=
  mvPolynomialBaseTranslation (fun _ : Fin N => (-1 : ℂ))

theorem ladderVarSubst_prod (N : ℕ) :
    ladderVarSubst N (∏ j, (MvPolynomial.X j : MvPolynomial (Fin N) ℂ))
      = ∏ j, (MvPolynomial.X j - 1 : MvPolynomial (Fin N) ℂ) := by
  rw [ladderVarSubst, map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [mvPolynomialBaseTranslation_X, map_neg, map_one]
  ring

/-- The action of an operator written in the ladder variables. -/
def xTransApply (ω : Fin N → ℂ) (Q : MvPolynomial (Fin N) ℂ)
    (y : meroField (Set.univ : Set ℂ)) : meroField (Set.univ : Set ℂ) :=
  transApply ω (ladderVarSubst N Q) y

/-! ## The realization -/

/-- **The annihilator of the Barnes source is the top Veronese ideal.** -/
theorem barnesAnnihilator_eq_veroneseIdeal [NeZero N] (ω : Fin N → ℂ)
    (hω : ∀ i, 0 < (ω i).im)
    (hindep : ∀ n : Fin N → ℤ, ∑ k, (n k : ℂ) * ω k = 0 → ∀ k, n k = 0) :
    {Q : MvPolynomial (Fin N) ℂ | DifferentialAlgebraicOver (RatFunc ℂ)
        (xTransApply ω Q (barnesSourceLogDerivMero ω hω))}
      = (veroneseIdeal ℂ (Fin N) N : Set (MvPolynomial (Fin N) ℂ)) := by
  ext Q
  rw [Set.mem_setOf_eq, xTransApply,
    differentialAlgebraicOver_transApply_barnesSource_iff ω hω hindep,
    ← ladderVarSubst_prod N, SetLike.mem_coe, veroneseIdeal_card, Ideal.mem_span_singleton]
  exact map_dvd_iff (ladderVarSubst N)

/-- **The Barnes source is a normal-crossing source of order `N`.**  Every conclusion of the
physical package theorem therefore applies to it. -/
theorem isNormalCrossingSource_barnesSource [NeZero N] (ω : Fin N → ℂ)
    (hω : ∀ i, 0 < (ω i).im)
    (hindep : ∀ n : Fin N → ℤ, ∑ k, (n k : ℂ) * ω k = 0 → ∀ k, n k = 0) :
    IsNormalCrossingSource
      {Q : MvPolynomial (Fin N) ℂ | DifferentialAlgebraicOver (RatFunc ℂ)
        (xTransApply ω Q (barnesSourceLogDerivMero ω hω))} N :=
  barnesAnnihilator_eq_veroneseIdeal ω hω hindep

end

end GaloisForLFunctions.HTGeometry
