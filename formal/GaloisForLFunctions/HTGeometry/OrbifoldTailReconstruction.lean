import GaloisForLFunctions.HTGeometry.ProjectiveJetHorizon
import GaloisForLFunctions.HTGeometry.SchwarzianProjectiveInvariant
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Tactic

/-!
# First-jet rigidity for holographic orbifold-tail reconstruction

The minimal orbifold currents have the form `q(y) * (y')^k`.  This file proves the exact
coefficient-separation theorem used to show that a Möbius equivalence between two such currents is
necessarily a pure scaling with the same tensor order.  It also certifies that the first jet of an
HT scalar is transcendental over the field generated by the scalar itself.
-/

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

open Polynomial

/-- Rigidity after clearing a Möbius denominator between two positive-degree monomial currents. -/
theorem monomial_mobius_cleared_rigidity
    {K : Type*} [Field K] [CharZero K]
    (q₁ q₂ a b c d : K) (k₁ k₂ : ℕ)
    (hk₁ : 0 < k₁) (hk₂ : 0 < k₂)
    (hq₁ : q₁ ≠ 0) (hq₂ : q₂ ≠ 0)
    (hdet : a * d - b * c ≠ 0)
    (hpoly :
      monomial (k₁ + k₂) (c * q₁ * q₂) +
          monomial k₂ (d * q₂) -
          monomial k₁ (a * q₁) - C b = 0) :
    c = 0 ∧ b = 0 ∧ k₁ = k₂ ∧ q₂ = (a / d) * q₁ := by
  have hc : c = 0 := by
    have hcoeff := congrArg (fun p : K[X] => p.coeff (k₁ + k₂)) hpoly
    simp [coeff_monomial, coeff_C, hk₁.ne', hk₂.ne'] at hcoeff
    rcases hcoeff with (hc | hq₁') | hq₂'
    · exact hc
    · exact (hq₁ hq₁').elim
    · exact (hq₂ hq₂').elim
  have hb : b = 0 := by
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) hpoly
    simp [coeff_monomial, hk₁.ne', hk₂.ne', hc] at hcoeff
    exact hcoeff
  have had : a * d ≠ 0 := by simpa [hc, hb] using hdet
  have hd : d ≠ 0 := right_ne_zero_of_mul had
  have hpoly' : monomial k₂ (d * q₂) - monomial k₁ (a * q₁) = 0 := by
    simpa [hc, hb] using hpoly
  have hk : k₁ = k₂ := by
    by_contra hne
    have hcoeff := congrArg (fun p : K[X] => p.coeff k₂) hpoly'
    simp only [coeff_sub, coeff_monomial, hne, if_false, if_true,
      sub_zero, coeff_zero] at hcoeff
    exact (mul_ne_zero hd hq₂) hcoeff
  subst k₂
  have hcoeff := congrArg (fun p : K[X] => p.coeff k₁) hpoly'
  simp only [coeff_sub, coeff_monomial, if_true, coeff_zero] at hcoeff
  refine ⟨hc, hb, rfl, ?_⟩
  calc
    q₂ = (a * q₁) / d := by
      apply (eq_div_iff hd).2
      linear_combination hcoeff
    _ = (a / d) * q₁ := by field_simp

/-- A Möbius relation between positive-power currents in a transcendental first-jet coordinate
has zero denominator coefficient, zero translation, equal powers, and proportional amplitudes. -/
theorem firstJet_mobius_rigidity
    {K E : Type*} [Field K] [CharZero K] [Field E] [Algebra K E]
    (t : E) (ht : Transcendental K t)
    (q₁ q₂ a b c d : K) (k₁ k₂ : ℕ)
    (hk₁ : 0 < k₁) (hk₂ : 0 < k₂)
    (hq₁ : q₁ ≠ 0) (hq₂ : q₂ ≠ 0)
    (hdet : a * d - b * c ≠ 0)
    (hden : algebraMap K E c * algebraMap K E q₁ * t ^ k₁ + algebraMap K E d ≠ 0)
    (heq : algebraMap K E q₂ * t ^ k₂ =
      (algebraMap K E a * algebraMap K E q₁ * t ^ k₁ + algebraMap K E b) /
        (algebraMap K E c * algebraMap K E q₁ * t ^ k₁ + algebraMap K E d)) :
    c = 0 ∧ b = 0 ∧ k₁ = k₂ ∧ q₂ = (a / d) * q₁ := by
  let P : K[X] :=
    monomial (k₁ + k₂) (c * q₁ * q₂) +
      monomial k₂ (d * q₂) - monomial k₁ (a * q₁) - C b
  have hmul := (eq_div_iff hden).mp heq
  have hcross :
      algebraMap K E (c * q₁ * q₂) * t ^ (k₁ + k₂) +
          algebraMap K E (d * q₂) * t ^ k₂ -
          algebraMap K E (a * q₁) * t ^ k₁ - algebraMap K E b = 0 := by
    simp only [map_mul, pow_add]
    linear_combination hmul
  have heval : aeval t P = 0 := by
    simp only [P, aeval_sub, aeval_add, aeval_monomial, aeval_C]
    exact hcross
  have hP : P = 0 := by
    by_contra hP0
    exact ht ⟨P, hP0, heval⟩
  exact monomial_mobius_cleared_rigidity q₁ q₂ a b c d k₁ k₂
    hk₁ hk₂ hq₁ hq₂ hdet hP

/-- The first derivative of an HT scalar is transcendental over the ordinary field generated by
the scalar.  This is the precise first-jet independence needed by orbifold-current rigidity. -/
theorem hypertranscendentalOver_deriv_transcendental_adjoin_self
    {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential E]
    {y : E} (hy : HypertranscendentalOver C y) :
    Transcendental (IntermediateField.adjoin C {y}) y′ := by
  let j : ℕ → E := fun n => differentialJet n y
  have hj : AlgebraicIndependent C j :=
    algebraicIndependent_differentialJet_of_hypertranscendentalOver hy
  have hsub : Transcendental (Algebra.adjoin C (j '' ({0} : Set ℕ))) (j 1) :=
    hj.transcendental_adjoin (by simp)
  have himage : j '' ({0} : Set ℕ) = {y} := by
    ext z
    simp [j]
  rw [himage] at hsub
  apply (IntermediateField.transcendental_adjoin_iff).2
  simpa [j, differentialJet_succ] using hsub

/-- HT specialization of first-jet Möbius rigidity over the field generated by the source value. -/
theorem hypertranscendental_orbifoldCurrent_mobius_rigidity
    {C E : Type*} [Field C] [CharZero C] [Field E] [CharZero E]
    [Algebra C E] [Differential E]
    {y : E} (hy : HypertranscendentalOver C y)
    (q₁ q₂ a b c d : IntermediateField.adjoin C {y}) (k₁ k₂ : ℕ)
    (hk₁ : 0 < k₁) (hk₂ : 0 < k₂)
    (hq₁ : q₁ ≠ 0) (hq₂ : q₂ ≠ 0)
    (hdet : a * d - b * c ≠ 0)
    (hden :
      algebraMap (IntermediateField.adjoin C {y}) E c *
          algebraMap (IntermediateField.adjoin C {y}) E q₁ * y′ ^ k₁ +
          algebraMap (IntermediateField.adjoin C {y}) E d ≠ 0)
    (heq :
      algebraMap (IntermediateField.adjoin C {y}) E q₂ * y′ ^ k₂ =
        (algebraMap (IntermediateField.adjoin C {y}) E a *
              algebraMap (IntermediateField.adjoin C {y}) E q₁ * y′ ^ k₁ +
              algebraMap (IntermediateField.adjoin C {y}) E b) /
          (algebraMap (IntermediateField.adjoin C {y}) E c *
              algebraMap (IntermediateField.adjoin C {y}) E q₁ * y′ ^ k₁ +
              algebraMap (IntermediateField.adjoin C {y}) E d)) :
    c = 0 ∧ b = 0 ∧ k₁ = k₂ ∧ q₂ = (a / d) * q₁ :=
  firstJet_mobius_rigidity y′
    (hypertranscendentalOver_deriv_transcendental_adjoin_self hy)
    q₁ q₂ a b c d k₁ k₂ hk₁ hk₂ hq₁ hq₂ hdet hden heq

end


end GaloisForLFunctions
