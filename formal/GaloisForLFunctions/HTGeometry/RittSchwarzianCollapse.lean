import GaloisForLFunctions.HTGeometry.RittSchwarzian
import GaloisForLFunctions.HTGeometry.RittGeneralInhomogeneity
import GaloisForLFunctions.HTGeometry.RittAffineTowerDichotomy
import GaloisForLFunctions.HTGeometry.RittLevelTwoClassification
import GaloisForLFunctions.HTGeometry.RittJetIndependence
import GaloisForLFunctions.HTGeometry.RittRegularLevelTwo

/-!
# A collapse at jet order three is refuted by the Schwarzian

If the third jet lies in the field generated by the first three, then so does the Schwarzian
combination `S = d³τ/dτ − (3/2)(d²τ/dτ)²`, and `S` solves the affine transport equation

`σ S = ρ^{−2}·S + h`,  `h = −(d²ρ)/ρ³ + (3/2)(dρ)²/ρ⁴`,

whose inhomogeneity is a *nonzero base constant* — minus the Schwarzian derivative of the map over
`ρ²`, nonzero for any map that is not a Möbius transformation.

Unlike the data the coefficient descent extracts, this one cannot be satisfied for free.  Its
multiplier is `ρ^{−2}`, not `ρ^{−1}`: the degree-one branch of the level dichotomy leaves a
homogeneous relation with multiplier `q^{−1}`, whose only solutions are `κ/τ` by the classification,
and the accompanying constant-term relation then has inhomogeneity

`(q/ρ²)·h·ρ²/κ·τ − λ₂·dτ`,

a polynomial with a nonzero coefficient at `dτ` because the second jet's shift defect is nonzero.  So
every branch ends in Ritt's order-one form or an affine transport equation with a controlled
inhomogeneity.
-/

namespace GaloisForLFunctions.HTGeometry

open _root_.Polynomial

variable {K L : Type*} [Field K] [CharZero K] [Field L] [CharZero L] [Algebra K L]

/-- **A collapse of the jet tower at order three forces Ritt's form or an affine transport
equation.** -/
theorem ritt_or_affine_of_collapse_three (Fr : RittFrame K L) {τ : L} {q : K}
    {P : K → Prop} (hPreg : RittRegular Fr q P)
    (hqconst : Fr.dK q = 0) (hshift : Fr.σ τ = algebraMap K L q * τ) (hq : q ≠ 0)
    (hSch : -(Fr.dK (Fr.dK Fr.ρ) / Fr.ρ ^ 3) + (3 / 2) * (Fr.dK Fr.ρ) ^ 2 / Fr.ρ ^ 4 ≠ 0)
    (htr0 : Transcendental K τ)
    (htr0' : Transcendental ↥(Fr.jetPrefixField τ 0) τ)
    (htr1 : Transcendental ↥(Fr.jetPrefixField τ 1) (Fr.d τ))
    (htr2 : Transcendental ↥(Fr.jetPrefixField τ 2) (Fr.d^[2] τ))
    (hdτ : Fr.d τ ≠ 0) (hmem : Fr.d^[3] τ ∈ Fr.jetPrefixField τ 3) :
    (∃ (u : K) (I J : ℤ), u ≠ 0 ∧ ¬(I = 0 ∧ J = 0) ∧ Fr.ψ u = q ^ I * Fr.ρ ^ J * u) ∨
    (∃ (u h : K) (I J : ℤ), u ≠ 0 ∧ h ≠ 0 ∧ P h ∧
      Fr.ψ u = q ^ I * Fr.ρ ^ J * u + h) := by
  classical
  have hρ0 : Fr.ρ ≠ 0 := Fr.ρ_ne
  -- a constant chain-rule factor has vanishing Schwarzian, so the hypothesis carries `dρ ≠ 0`
  have hdρ : Fr.dK Fr.ρ ≠ 0 := by
    intro h0
    refine hSch ?_
    rw [h0, dK_zero Fr]
    simp
  set hS : K := -(Fr.dK (Fr.dK Fr.ρ) / Fr.ρ ^ 3)
    + (3 / 2) * (Fr.dK Fr.ρ) ^ 2 / Fr.ρ ^ 4 with hSdef
  set S : L := schwarzianJet Fr τ with hSdefL
  have hSrel : Fr.σ S = algebraMap K L ((Fr.ρ ^ 2)⁻¹) * S + algebraMap K L hS :=
    sigma_schwarzianJet Fr hqconst hshift hq hdτ
  have hS0 : S ≠ 0 := by
    intro hzero
    rw [hzero, map_zero, mul_zero, zero_add] at hSrel
    exact hSch ((map_eq_zero_iff _ (algebraMap K L).injective).mp hSrel.symm)
  -- the two base constants of the argument lie in the regularity class
  have hz3 : (Fr.ρ : K) ^ (-3 : ℤ) = (Fr.ρ ^ (3 : ℕ))⁻¹ := by
    rw [zpow_neg]; norm_cast
  have hz4 : (Fr.ρ : K) ^ (-4 : ℤ) = (Fr.ρ ^ (4 : ℕ))⁻¹ := by
    rw [zpow_neg]; norm_cast
  have hPdρ : P (Fr.dK Fr.ρ) := hPreg.deriv hPreg.rho_mem
  have hPhS : P hS := by
    have h32 : P ((3 : K) / 2) := by
      have h := hPreg.ratCast (3 / 2 : ℚ)
      norm_num at h
      exact h
    have hrw : hS = -(Fr.dK (Fr.dK Fr.ρ)) * Fr.ρ ^ (-3 : ℤ)
        + (3 : K) / 2 * (Fr.dK Fr.ρ * Fr.dK Fr.ρ) * Fr.ρ ^ (-4 : ℤ) := by
      rw [hSdef, hz3, hz4]
      field_simp
    rw [hrw]
    exact hPreg.add (hPreg.mul (hPreg.neg (hPreg.deriv hPdρ)) (hPreg.rzpow _))
      (hPreg.mul (hPreg.mul h32 (hPreg.mul hPdρ hPdρ)) (hPreg.rzpow _))
  have hcinv : ((Fr.ρ ^ 2)⁻¹ : K) ≠ 0 := inv_ne_zero (pow_ne_zero _ hρ0)
  have hSmem : S ∈ Fr.jetPrefixField τ 3 := by
    have h1 : Fr.d τ ∈ Fr.jetPrefixField τ 3 := by
      have h := Fr.jet_mem_jetPrefixField (τ := τ) (j := 1) (n := 3) (by omega)
      simpa using h
    have h2 : Fr.d^[2] τ ∈ Fr.jetPrefixField τ 3 :=
      Fr.jet_mem_jetPrefixField (τ := τ) (j := 2) (n := 3) (by omega)
    rw [hSdefL, schwarzianJet]
    refine sub_mem (div_mem hmem h1) (mul_mem ?_ (pow_mem (div_mem h2 h1) 2))
    have : ((3 : L) / 2) = algebraMap K L ((3 : K) / 2) := by
      rw [map_div₀, map_ofNat, map_ofNat]
    rw [this]
    exact IntermediateField.algebraMap_mem _ _
  -- the second jet's shift defect
  have hdef2 := sigma_jet_two Fr hqconst hshift
  set lam2 : K := -(q * Fr.dK Fr.ρ / Fr.ρ ^ 3) with hlam2
  have hlam20 : lam2 ≠ 0 := by
    rw [hlam2, neg_ne_zero]
    exact div_ne_zero (mul_ne_zero hq hdρ) (pow_ne_zero _ hρ0)
  have hPlam2 : P lam2 := by
    have hrw : lam2 = -(q * Fr.dK Fr.ρ * Fr.ρ ^ (-3 : ℤ)) := by
      rw [hlam2, hz3, div_eq_mul_inv]
    rw [hrw]
    exact hPreg.neg (hPreg.mul (hPreg.mul hPreg.q_mem hPdρ) (hPreg.rzpow _))
  have haK0 : q / Fr.ρ ^ 2 ≠ 0 := div_ne_zero hq (pow_ne_zero _ hρ0)
  -- apply the level dichotomy at jet order two
  have hβmem : algebraMap K L hS ∈ Fr.jetPrefixField τ 2 :=
    IntermediateField.algebraMap_mem _ _
  have hSmem' : S ∈ Fr.jetPrefixField τ (2 + 1) := hSmem
  have hSrel' : Fr.σ S = algebraMap K L ((Fr.ρ ^ 2)⁻¹) * S
      + (algebraMap K L (0 : K) * Fr.d^[2] τ + algebraMap K L hS) := by
    rw [map_zero, zero_mul, zero_add]
    exact hSrel
  rcases affine_descent_dichotomy_gen Fr hqconst hshift hq htr2 hS0 hSmem' hcinv hβmem hSrel'
    with ⟨-, hmem2⟩ | hdiag | ⟨w, N, A', hw0, hwmem, hN, hAsh, hconn⟩ |
      ⟨-, -, -, -, -, -, -, hαne, -, -, -⟩ | ⟨v, hv0, hvmem, hveq, hlin⟩
  · -- the Schwarzian already lives over the first two jets
    refine level_two_regular_inhom Fr hPreg hqconst hshift hq htr0 htr1 hS0 hmem2 hcinv
      (i₀ := 0) (k₀ := -2) ?_ (G := fun j => if j = 0 then C hS else 0) (n := 1)
      ⟨0, by omega, ?_⟩ ?_ ?_
    · rw [zpow_zero, one_mul, zpow_neg]
      norm_cast
    · simp only [if_true]
      exact fun hz => hSch (C_eq_zero.mp hz)
    · intro j k
      by_cases hj : j = 0
      · rw [hj, if_pos rfl, coeff_C]
        split
        · exact hPhS
        · exact hPreg.zero
      · rw [if_neg hj, coeff_zero]
        exact hPreg.zero
    · rw [hSrel, Finset.sum_range_one]
      simp
  · -- impossible: the second jet has a nonzero shift defect
    exfalso
    rw [hdef2] at hdiag
    have hz : algebraMap K L lam2 * Fr.d τ = 0 := by linear_combination hdiag
    rcases mul_eq_zero.mp hz with hh | hh
    · exact hlam20 ((map_eq_zero_iff _ (algebraMap K L).injective).mp hh)
    · exact hdτ hh
  · -- the affine connection at jet order two
    have hjetind : ∀ j, j < 2 → Transcendental ↥(Fr.jetPrefixField τ j) (Fr.d^[j] τ) := by
      intro j hj
      interval_cases j
      · exact htr0'
      · exact htr1
    have hcoef : A' 0 = 0 ∧ A' 1 = lam2 := by
      have hbase : algebraMap K L (A' 0) * τ + algebraMap K L (A' 1) * Fr.d τ
          = algebraMap K L lam2 * Fr.d τ := by
        have h2 : ∑ j ∈ Finset.range 2, algebraMap K L (A' j) * Fr.d^[j] τ
            = algebraMap K L lam2 * Fr.d τ := by
          rw [hdef2] at hAsh
          linear_combination -hAsh
        rw [Finset.sum_range_succ, Finset.sum_range_one] at h2
        simpa using h2
      have hzero : ∑ j ∈ Finset.range 2,
          algebraMap K L ((fun j : ℕ => if j = 0 then A' 0 else A' 1 - lam2) j) * Fr.d^[j] τ
          = 0 := by
        rw [Finset.sum_range_succ, Finset.sum_range_one]
        simp only [if_neg (by omega : ¬ (1 : ℕ) = 0), map_sub, if_true,
          Function.iterate_zero_apply, Function.iterate_one, sub_mul]
        linear_combination hbase
      have hc0 := jet_coeffs_eq_zero_of_sum_eq_zero Fr 2 hjetind
        (fun j : ℕ => if j = 0 then A' 0 else A' 1 - lam2) hzero 0 (by omega)
      have hc1 := jet_coeffs_eq_zero_of_sum_eq_zero Fr 2 hjetind
        (fun j : ℕ => if j = 0 then A' 0 else A' 1 - lam2) hzero 1 (by omega)
      simp only [if_true] at hc0
      simp only [if_neg (by omega : ¬ (1 : ℕ) = 0)] at hc1
      exact ⟨hc0, by linear_combination hc1⟩
    have hA'0 : A' 0 = 0 := hcoef.1
    have hA'1 : A' 1 = lam2 := hcoef.2
    have hNlam : -(N : K) * A' 1 ≠ 0 := by
      rw [hA'1]
      exact mul_ne_zero (neg_ne_zero.mpr (Nat.cast_ne_zero.mpr (by omega))) hlam20
    have hcq2 : q / Fr.ρ ^ 2 = q ^ (1 : ℤ) * Fr.ρ ^ (-(2 : ℤ)) := by
      rw [zpow_one, zpow_neg, div_eq_mul_inv]
      norm_cast
    refine level_two_regular_inhom Fr hPreg hqconst hshift hq htr0 htr1 hw0 hwmem haK0 hcq2
      (G := fun j => if j = 1 then C (-(N : K) * A' 1) else C (-(N : K) * A' 0) * X) (n := 2)
      ⟨1, by omega, ?_⟩ ?_ ?_
    · simp only [if_true]
      exact fun hz => hNlam (C_eq_zero.mp hz)
    · have hP1 : P (-(N : K) * A' 1) := by
        rw [hA'1]
        exact hPreg.mul (hPreg.neg (hPreg.natCast N)) hPlam2
      have hP0 : P (-(N : K) * A' 0) := by
        rw [hA'0, mul_zero]
        exact hPreg.zero
      intro j k
      by_cases hj : j = 1
      · rw [hj, if_pos rfl, coeff_C]
        split
        · exact hP1
        · exact hPreg.zero
      · rw [if_neg hj, coeff_C_mul]
        refine hPreg.mul hP0 ?_
        rw [coeff_X]
        split
        · exact hPreg.one
        · exact hPreg.zero
    · rw [hconn, Finset.sum_range_succ, Finset.sum_range_one, Finset.sum_range_succ,
        Finset.sum_range_one]
      simp only [if_neg (by omega : ¬ (0 : ℕ) = 1), if_true, map_mul, aeval_C, aeval_X,
        pow_zero, pow_one, mul_one, Function.iterate_zero_apply, Function.iterate_one]
  · exact absurd rfl hαne
  · -- the degree-one branch: the leading coefficient is a monomial and the companion is explicit
    obtain ⟨y, hymem, hyeq⟩ := hlin rfl
    have hjetind : ∀ j, j < 2 → Transcendental ↥(Fr.jetPrefixField τ j) (Fr.d^[j] τ) := by
      intro j hj
      interval_cases j
      · exact htr0'
      · exact htr1
    have hcv : (Fr.ρ ^ 2)⁻¹ / (q / Fr.ρ ^ 2) = q⁻¹ := by
      field_simp
    have hveq' : Fr.σ v = algebraMap K L (q⁻¹) * v := by
      rw [hveq, hcv, show (0 : K) / (q / Fr.ρ ^ 2) = 0 by simp, map_zero, add_zero]
    have hqinv : (q⁻¹ : K) = q ^ (-1 : ℤ) * Fr.ρ ^ (0 : ℤ) := by
      rw [zpow_zero, mul_one, zpow_neg_one]
    have hvrel : Fr.σ v = algebraMap K L (q⁻¹) * v
        + (algebraMap K L (0 : K) * Fr.d τ
          + (algebraMap K L (0 : K) * τ + algebraMap K L (0 : K))) := by
      rw [map_zero, zero_mul, zero_mul, add_zero, add_zero, add_zero]
      exact hveq'
    rcases level_two_classification Fr hqconst hshift hq htr0 htr1 hv0 hvmem
        (inv_ne_zero hq) hqinv hvrel with hritt | ⟨hne, -⟩ |
        ⟨κA, e₀, e₁, hκA0, hψκ, -, -, -, hvform, hi, hk⟩
    · exact Or.inl hritt
    · exact absurd ⟨rfl, rfl, rfl⟩ hne
    · -- `v = κ_A / τ`
      have he₁ : e₁ = 0 := by omega
      have he₀ : e₀ = -1 := by omega
      rw [he₀, he₁, zpow_zero, mul_one] at hvform
      have hτ0 : τ ≠ 0 := by
        intro hh
        exact htr0 (by rw [hh]; exact isAlgebraic_zero)
      have hκAL : algebraMap K L κA ≠ 0 :=
        (map_ne_zero_iff _ (algebraMap K L).injective).mpr hκA0
      set μ : K := q / Fr.ρ ^ 2 * hS * Fr.ρ ^ 2 / κA with hμ
      have hμ0 : μ ≠ 0 :=
        div_ne_zero (mul_ne_zero (mul_ne_zero haK0 hSch) (pow_ne_zero _ hρ0)) hκA0
      have hfrac : algebraMap K L (q / Fr.ρ ^ 2) * algebraMap K L hS
          / (algebraMap K L ((Fr.ρ ^ 2)⁻¹) * v) = algebraMap K L μ * τ := by
        have hvL : v = algebraMap K L κA * τ ^ (-1 : ℤ) := hvform
        have hμL : algebraMap K L μ
            = algebraMap K L (q / Fr.ρ ^ 2) * algebraMap K L hS * algebraMap K L (Fr.ρ ^ 2)
              / algebraMap K L κA := by
          rw [hμ, map_div₀, map_mul, map_mul]
        have hiL : algebraMap K L ((Fr.ρ ^ 2)⁻¹) = (algebraMap K L (Fr.ρ ^ 2))⁻¹ := map_inv₀ _ _
        have hρ2L : algebraMap K L (Fr.ρ ^ 2) ≠ 0 :=
          (map_ne_zero_iff _ (algebraMap K L).injective).mpr (pow_ne_zero _ hρ0)
        rw [hvL, hμL, hiL, zpow_neg_one]
        field_simp
      have hcq2 : q / Fr.ρ ^ 2 = q ^ (1 : ℤ) * Fr.ρ ^ (-(2 : ℤ)) := by
        rw [zpow_one, zpow_neg, div_eq_mul_inv]
        norm_cast
      have hyrel : Fr.σ y = algebraMap K L (q / Fr.ρ ^ 2) * y
          + ∑ j ∈ Finset.range 2,
            aeval τ ((fun j : ℕ => if j = 1 then C (-lam2) else C μ * X) j) * (Fr.d τ) ^ j := by
        rw [hyeq, hfrac, hdef2, Finset.sum_range_succ, Finset.sum_range_one]
        simp only [if_neg (by omega : ¬ (0 : ℕ) = 1), if_true, map_mul, aeval_C, aeval_X,
          map_neg, pow_zero, pow_one, mul_one]
        ring
      have hy0 : y ≠ 0 := by
        intro hzero
        rw [hzero, map_zero, mul_zero, zero_add] at hyrel
        have hsum : ∑ j ∈ Finset.range 2, algebraMap K L
            ((fun j : ℕ => if j = 0 then μ else -lam2) j) * Fr.d^[j] τ = 0 := by
          rw [Finset.sum_range_succ, Finset.sum_range_one] at hyrel ⊢
          simp only [if_neg (by omega : ¬ (0 : ℕ) = 1), if_neg (by omega : ¬ (1 : ℕ) = 0),
            if_true, map_mul, aeval_C, aeval_X, map_neg, pow_zero, pow_one, mul_one,
            Function.iterate_zero_apply, Function.iterate_one] at hyrel ⊢
          linear_combination -hyrel
        have hc1 := jet_coeffs_eq_zero_of_sum_eq_zero Fr 2 hjetind
          (fun j : ℕ => if j = 0 then μ else -lam2) hsum 1 (by omega)
        simp only [if_neg (by omega : ¬ (1 : ℕ) = 0), neg_eq_zero] at hc1
        exact hlam20 hc1
      refine level_two_regular_inhom Fr hPreg hqconst hshift hq htr0 htr1 hy0 hymem haK0 hcq2
        (G := fun j : ℕ => if j = 1 then C (-lam2) else C μ * X) (n := 2) ⟨1, by omega, ?_⟩
        ?_ hyrel
      · simp only [if_true]
        exact fun hz => hlam20 (neg_eq_zero.mp (C_eq_zero.mp hz))
      · have hPμ : P μ := by
          have hrw : μ = q * hS * κA⁻¹ := by
            rw [hμ]
            field_simp
          rw [hrw]
          exact hPreg.mul (hPreg.mul hPreg.q_mem hPhS) (hPreg.fixed_inv κA hκA0 hψκ)
        intro j k
        by_cases hj : j = 1
        · rw [hj, if_pos rfl, coeff_C]
          split
          · exact hPreg.neg hPlam2
          · exact hPreg.zero
        · rw [if_neg hj, coeff_C_mul]
          refine hPreg.mul hPμ ?_
          rw [coeff_X]
          split
          · exact hPreg.one
          · exact hPreg.zero

end GaloisForLFunctions.HTGeometry
