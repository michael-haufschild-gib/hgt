import GaloisForLFunctions.HTGeometry.DifferenceSystemPicardVessiot

/-!
# Generation of the concrete Picard--Vessiot quotient

The localized generic-matrix ring is generated by matrix entries and the inverse determinant.
Every quotient therefore retains the exact Picard--Vessiot generation property.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K : Type*} [Field K] {n : ℕ}

/-- Generic matrix entries and the inverse determinant generate the localized coordinate ring. -/
theorem pvLocalization_adjoin_genericVariables :
    Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n =>
        algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n)
          (MvPolynomial.X p)) ∪
        {IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)}) = ⊤ := by
  let U : Subalgebra K (pvLocalization K n) := Algebra.adjoin K
    (Set.range (fun p : Fin n × Fin n =>
      algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n)
        (MvPolynomial.X p)) ∪
      {IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)})
  have hpolynomial : ∀ a : MvPolynomial (Fin n × Fin n) K,
      algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n) a ∈ U := by
    intro a
    apply MvPolynomial.induction_on a
    · intro c
      change algebraMap K (pvLocalization K n) c ∈ U
      exact U.algebraMap_mem c
    · intro p q hp hq
      rw [map_add]
      exact U.add_mem hp hq
    · intro p i hp
      rw [map_mul]
      exact U.mul_mem hp (Algebra.subset_adjoin (Set.mem_union_left _ ⟨i, rfl⟩))
  apply eq_top_iff.mpr
  intro z _
  change z ∈ U
  obtain ⟨m, a, hza⟩ := IsLocalization.Away.surj
    ((fundamentalMatrix K n).det) z
  have hz : algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n) a *
      IsLocalization.Away.invSelf ((fundamentalMatrix K n).det) ^ m = z := by
    rw [← hza, mul_assoc]
    rw [← mul_pow, IsLocalization.Away.mul_invSelf]
    simp
  rw [← hz]
  exact U.mul_mem (hpolynomial a)
    (U.pow_mem
      (Algebra.subset_adjoin (Set.mem_union_right _ (Set.mem_singleton _))) m)

/-- Fundamental-matrix entries and the inverse determinant generate the localization. -/
theorem pvLocalization_adjoin :
    Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => pvFundamental K n p.1 p.2) ∪
        {IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)}) = ⊤ := by
  simpa [pvFundamental, fundamentalMatrix, Matrix.map_apply] using
    (pvLocalization_adjoin_genericVariables (K := K) (n := n))

/-- The images of the fundamental entries and inverse determinant generate every quotient. -/
theorem pvQuotient_adjoin (M : Ideal (pvLocalization K n)) :
    Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n =>
        Ideal.Quotient.mk M (pvFundamental K n p.1 p.2)) ∪
        {Ideal.Quotient.mk M
          (IsLocalization.Away.invSelf ((fundamentalMatrix K n).det))}) = ⊤ := by
  change Algebra.adjoin K
    (Set.range (fun p : Fin n × Fin n =>
      (Ideal.Quotient.mkₐ K M) (pvFundamental K n p.1 p.2)) ∪
      {(Ideal.Quotient.mkₐ K M)
        (IsLocalization.Away.invSelf ((fundamentalMatrix K n).det))}) = ⊤
  have h := Algebra.adjoin_image (R := K) (Ideal.Quotient.mkₐ K M)
    (Set.range (fun p : Fin n × Fin n => pvFundamental K n p.1 p.2) ∪
      {IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)})
  rw [pvLocalization_adjoin, Algebra.map_top,
    (AlgHom.range_eq_top (Ideal.Quotient.mkₐ K M)).2 Ideal.Quotient.mk_surjective] at h
  have himage : (Ideal.Quotient.mkₐ K M) ''
      (Set.range (fun p : Fin n × Fin n => pvFundamental K n p.1 p.2) ∪
        {IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)}) =
      Set.range (fun p : Fin n × Fin n =>
        (Ideal.Quotient.mkₐ K M) (pvFundamental K n p.1 p.2)) ∪
        {(Ideal.Quotient.mkₐ K M)
          (IsLocalization.Away.invSelf ((fundamentalMatrix K n).det))} := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      rcases hy with ⟨p, rfl⟩ | rfl
      · exact Set.mem_union_left _ ⟨p, rfl⟩
      · exact Set.mem_union_right _ (Set.mem_singleton _)
    · rintro (⟨p, rfl⟩ | rfl)
      · exact ⟨pvFundamental K n p.1 p.2, Set.mem_union_left _ ⟨p, rfl⟩, rfl⟩
      · exact ⟨IsLocalization.Away.invSelf ((fundamentalMatrix K n).det),
          Set.mem_union_right _ (Set.mem_singleton _), rfl⟩
  rwa [himage] at h

/-- The distinguished inverse remains a right inverse of the fundamental determinant in every
quotient. -/
theorem pvQuotient_det_mul_inverse (M : Ideal (pvLocalization K n)) :
    (((pvFundamental K n).map (Ideal.Quotient.mk M)).det) *
      Ideal.Quotient.mk M
        (IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)) = 1 := by
  have hmap : ((pvFundamental K n).map (Ideal.Quotient.mk M)).det =
      Ideal.Quotient.mk M (pvFundamental K n).det := by
    rw [RingHom.map_det (Ideal.Quotient.mk M) (pvFundamental K n),
      RingHom.mapMatrix_apply]
  rw [hmap]
  have hdet : (pvFundamental K n).det =
      algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n)
        ((fundamentalMatrix K n).det) := by
    rw [pvFundamental, RingHom.map_det, RingHom.mapMatrix_apply]
  rw [hdet]
  change Ideal.Quotient.mk M
      (algebraMap (MvPolynomial (Fin n × Fin n) K) (pvLocalization K n)
        ((fundamentalMatrix K n).det)) *
    Ideal.Quotient.mk M
      (IsLocalization.Away.invSelf ((fundamentalMatrix K n).det)) = 1
  rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]

end


end GaloisForLFunctions.HTGeometry
