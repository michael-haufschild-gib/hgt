import Mathlib

/-!
# A base transcendental over the algebraic numbers together with a countable set

The field generated by the algebraic numbers and countably many prescribed complex numbers is
countable, so the complex numbers algebraic over it form a null set of the real line.  Every real
interval therefore contains a base transcendental over that field.  This is what a power profile
`t ^ e n` needs in order to defeat every relation whose coefficients and dilations lie in the
prescribed field: the grouped relation is a polynomial identity in the base.
-/

open Set MeasureTheory

namespace GaloisForLFunctions

noncomputable section

/-- A countable set of complex numbers generates a countable subfield. -/
theorem countable_subfield_closure {s : Set ℂ} (hs : s.Countable) :
    Countable ↥(Subfield.closure s) := by
  have hs0 : Cardinal.mk ↥s ≤ Cardinal.aleph0 := Cardinal.mk_le_aleph0_iff.mpr hs.to_subtype
  have hcard : Cardinal.mk ↥(Subfield.closure s) ≤ max (Cardinal.mk ↥s) Cardinal.aleph0 :=
    Subfield.cardinalMk_closure_le_max s
  exact Cardinal.mk_le_aleph0_iff.mp (hcard.trans (max_le hs0 le_rfl))

/-- The complex numbers algebraic over `ℚ` form a countable set. -/
theorem countable_isAlgebraic_rat : {z : ℂ | IsAlgebraic ℚ z}.Countable :=
  Algebraic.countable ℚ ℂ

/-- **Every real interval contains a base transcendental over a countable subfield.**  The complex
numbers algebraic over the subfield are countable, so their real points form a null set. -/
theorem exists_transcendental_mem_Ioo (K : Subfield ℂ) [Countable ↥K] {a b : ℝ} (hab : a < b) :
    ∃ x : ℝ, x ∈ Set.Ioo a b ∧ Transcendental K (x : ℂ) := by
  by_contra hcon
  push Not at hcon
  have hsub : Set.Ioo a b ⊆ Complex.ofReal ⁻¹' {z : ℂ | IsAlgebraic K z} := by
    intro x hx
    exact not_not.mp (hcon x hx)
  have hcount : (Complex.ofReal ⁻¹' {z : ℂ | IsAlgebraic K z}).Countable :=
    (Algebraic.countable ↥K ℂ).preimage Complex.ofReal_injective
  have h0 : volume (Set.Ioo a b) = 0 :=
    measure_mono_null hsub (hcount.measure_zero volume)
  rw [Real.volume_Ioo] at h0
  simp only [ENNReal.ofReal_eq_zero, sub_nonpos] at h0
  linarith

/-- **A base for a power profile, transcendental over the field generated by the algebraic numbers
and a countable family of dilations.** -/
theorem exists_transcendental_base {ι : Type*} [Countable ι] (q : ι → ℂ) {ε : ℝ} (hε : 0 < ε) :
    ∃ (K : Subfield ℂ) (x : ℝ), 0 < x ∧ x < ε ∧
      (∀ z : ℂ, IsAlgebraic ℚ z → z ∈ K) ∧ (∀ i, q i ∈ K) ∧ Transcendental K (x : ℂ) := by
  classical
  set s : Set ℂ := {z : ℂ | IsAlgebraic ℚ z} ∪ Set.range q with hs
  have hscount : s.Countable :=
    Set.Countable.union countable_isAlgebraic_rat (Set.countable_range q)
  set K : Subfield ℂ := Subfield.closure s with hK
  haveI : Countable ↥K := countable_subfield_closure hscount
  obtain ⟨x, hx, htr⟩ := exists_transcendental_mem_Ioo K (a := 0) (b := ε) hε
  refine ⟨K, x, hx.1, hx.2, ?_, ?_, htr⟩
  · intro z hz
    exact Subfield.subset_closure (Or.inl hz)
  · intro i
    exact Subfield.subset_closure (Or.inr ⟨i, rfl⟩)

end

end GaloisForLFunctions
