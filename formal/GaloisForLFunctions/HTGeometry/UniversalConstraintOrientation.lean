import GaloisForLFunctions.HTGeometry.UniversalFiniteConstraintCarrier
import GaloisForLFunctions.HTGeometry.UpperEndRationalGauge
import GaloisForLFunctions.HTGeometry.FacetSewnHerglotzStanleyReisner

/-!
# Universal constraint--orientation product geometry

Finite rational residue surgery changes only the rational gauge representative of the universal
prime-log source.  The whole universal facet palette therefore remains differentially independent,
and every finite Stanley--Reisner differential matroid persists in every finite residue-sign
chamber.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions MvPolynomial Polynomial
open scoped Differential

noncomputable section

/-- Apply an arbitrary rational base-field gauge independently to every member of the universal
facet palette. -/
def universalFacetOrbitRationalGaugeSource
    (r : UniversalFacetOrbitIndex → RatFunc ℂ) (q : UniversalFacetOrbitIndex) :
    upperEndMeroField := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  exact boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
      universalFacetOrbitGauge q +
    algebraMap (RatFunc ℂ) upperEndMeroField (r q)

/-- Arbitrary coordinatewise rational gauges preserve differential independence of the complete
universal palette. -/
theorem universalFacetOrbitRationalGaugeSource_differentialIndependent
    (r : UniversalFacetOrbitIndex → RatFunc ℂ) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    DifferentialIndependent (RatFunc ℂ) (universalFacetOrbitRationalGaugeSource r) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  have h := DifferentialIndependent.addUpperEndRatfunc
    universalFacetOrbitGauge_differentialIndependent r
  simpa [universalFacetOrbitRationalGaugeSource] using h

/-- Rational gauges do not change the embedded differential field generated by the universal
palette. -/
theorem universalFacetOrbitRationalGaugeSource_differentialAdjoin_eq
    (r : UniversalFacetOrbitIndex → RatFunc ℂ) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    differentialAdjoin (RatFunc ℂ) (Set.range (universalFacetOrbitRationalGaugeSource r)) =
      differentialAdjoin (RatFunc ℂ)
        (Set.range (boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
          universalFacetOrbitGauge)) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  let base := boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
    universalFacetOrbitGauge
  let correction : UniversalFacetOrbitIndex → upperEndMeroField := fun q =>
    algebraMap (RatFunc ℂ) upperEndMeroField (r q)
  have h := differentialAdjoin_addOfJetsInBase base correction
    (fun q n => upperEndRatfunc_allJets_closed (r q) n)
  simpa [base, correction, universalFacetOrbitRationalGaugeSource] using h

/-- Every rational gauge of the fixed universal palette retains every finite localized
Stanley--Reisner nonlinear differential matroid. -/
theorem universalFacetOrbitRationalGauge_stanleyReisnerLaurentDifferentialMatroid
    (r : UniversalFacetOrbitIndex → RatFunc ℂ)
    {α ι : Type*}
    [Fintype α] [Fintype ι] [DecidableEq α] [DecidableEq ι]
    (d : translationSubmonoid (Polynomial ℂ) α)
    (facets : Finset (Finset α))
    (N : ι → MvPolynomial α (Polynomial ℂ) ⧸
      stanleyReisnerIdeal (Polynomial ℂ) facets) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    let e := finiteVertexNatEmbedding α
    let source : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) →
        upperEndMeroField := fun q =>
      universalFacetOrbitRationalGaugeSource r
        (finiteFacetOrbitUniversalIndex e facets q.1)
    DifferentialIndependent ℂ
        (differentialOperatorRowApply
          (finiteFinsuppOperatorRows (stanleyReisnerLaurentRows d facets N)) source) ↔
      LinearIndependent (Polynomial ℂ) N := by
  classical
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  let e := finiteVertexNatEmbedding α
  let fullSource := universalFacetOrbitRationalGaugeSource r
  let source : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) →
      upperEndMeroField := fun q =>
    fullSource (finiteFacetOrbitUniversalIndex e facets q.1)
  have hsourceRat : DifferentialIndependent (RatFunc ℂ) source := by
    have hcomp := (universalFacetOrbitRationalGaugeSource_differentialIndependent r).comp
      (fun q : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) =>
        finiteFacetOrbitUniversalIndex e facets q.1)
      ((finiteFacetOrbitUniversalIndex_injective e facets).comp Subtype.val_injective)
    simpa [source, fullSource, Function.comp_def] using hcomp
  have hsource : DifferentialIndependent ℂ source :=
    differentialIndependent_upperEnd_restrictComplex source hsourceRat
  change DifferentialIndependent ℂ
      (differentialOperatorRowApply
        (finiteFinsuppOperatorRows (stanleyReisnerLaurentRows d facets N)) source) ↔
    LinearIndependent (Polynomial ℂ) N
  exact differentialIndependent_stanleyReisnerLaurentRows_iff
    (C := ℂ) (K := upperEndMeroField)
    upperEndMero_deriv_complexConstant d facets N source hsource

/-- A finite real change of the prime-log residue sequence. -/
abbrev PrimeResidueSurgery := Nat.Primes →₀ ℝ

/-- The rational correction obtained by translating a finite prime-log residue surgery by `h`. -/
def primeResidueSurgeryRatFunc (a : PrimeResidueSurgery) (h : ℂ) : RatFunc ℂ :=
  a.sum fun p delta =>
    RatFunc.C (delta : ℂ) *
      (RatFunc.C (primeLogSupport p : ℂ) - (RatFunc.X + RatFunc.C h))⁻¹

/-- The universal translated source after one finite residue surgery of the underlying generator. -/
def universalFacetOrbitSurgerySource
    (a : PrimeResidueSurgery) (q : UniversalFacetOrbitIndex) : upperEndMeroField := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  exact boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
      universalFacetOrbitGauge q +
    algebraMap (RatFunc ℂ) upperEndMeroField
      (primeResidueSurgeryRatFunc a (universalFacetOrbitShift q))

/-- Every finite residue surgery preserves differential independence of the complete universal
facet palette. -/
theorem universalFacetOrbitSurgerySource_differentialIndependent
    (a : PrimeResidueSurgery) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    DifferentialIndependent (RatFunc ℂ) (universalFacetOrbitSurgerySource a) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  have h := DifferentialIndependent.addUpperEndRatfunc
    universalFacetOrbitGauge_differentialIndependent
    (fun q => primeResidueSurgeryRatFunc a (universalFacetOrbitShift q))
  simpa [universalFacetOrbitSurgerySource] using h

/-- Finite residue surgery does not change the embedded differential field generated by the
complete universal palette. -/
theorem universalFacetOrbitSurgerySource_differentialAdjoin_eq
    (a : PrimeResidueSurgery) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    differentialAdjoin (RatFunc ℂ) (Set.range (universalFacetOrbitSurgerySource a)) =
      differentialAdjoin (RatFunc ℂ)
        (Set.range (boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
          universalFacetOrbitGauge)) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  let base := boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
    universalFacetOrbitGauge
  let correction : UniversalFacetOrbitIndex → upperEndMeroField := fun q =>
    algebraMap (RatFunc ℂ) upperEndMeroField
      (primeResidueSurgeryRatFunc a (universalFacetOrbitShift q))
  have h := differentialAdjoin_addOfJetsInBase base correction
    (fun q n => upperEndRatfunc_allJets_closed
      (primeResidueSurgeryRatFunc a (universalFacetOrbitShift q)) n)
  simpa [base, correction, universalFacetOrbitSurgerySource] using h

/-- The surgically modified translate differs from the original translate by the displayed
rational base-field element. -/
theorem universalFacetOrbitSurgerySource_sub_base
    (a : PrimeResidueSurgery) (q : UniversalFacetOrbitIndex) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    universalFacetOrbitSurgerySource a q -
        boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
          universalFacetOrbitGauge q =
      algebraMap (RatFunc ℂ) upperEndMeroField
        (primeResidueSurgeryRatFunc a (universalFacetOrbitShift q)) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  simp [universalFacetOrbitSurgerySource]

/-- Flip exactly the residue signs indexed by a finite prime set. -/
def universalSignFlipSurgery (J : Finset Nat.Primes) : PrimeResidueSurgery :=
  Finsupp.onFinset J
    (fun p => if p ∈ J then
      -2 * primeDyadicWeight (fun q => universalFacetOrbitGauge q) p else 0)
    (by
      intro p hp
      by_contra hmem
      simp [hmem] at hp)

/-- The signed residue mass after surgery. -/
def universalSurgeryResidueMass (a : PrimeResidueSurgery) (p : Nat.Primes) : ℝ :=
  primeDyadicWeight (fun q => universalFacetOrbitGauge q) p + a p

@[simp]
theorem universalSignFlipSurgery_apply (J : Finset Nat.Primes) (p : Nat.Primes) :
    universalSignFlipSurgery J p = if p ∈ J then
      -2 * primeDyadicWeight (fun q => universalFacetOrbitGauge q) p else 0 := by
  classical
  exact Finsupp.onFinset_apply

@[simp]
theorem universalSurgeryResidueMass_signFlip
    (J : Finset Nat.Primes) (p : Nat.Primes) :
    universalSurgeryResidueMass (universalSignFlipSurgery J) p =
      if p ∈ J then -primeDyadicWeight (fun q => universalFacetOrbitGauge q) p
      else primeDyadicWeight (fun q => universalFacetOrbitGauge q) p := by
  classical
  simp only [universalSurgeryResidueMass, universalSignFlipSurgery_apply]
  split <;> ring

/-- The negative residue set of the sign-flipped representative is exactly the chosen chamber
vertex. -/
theorem universalSurgeryResidueMass_signFlip_neg_iff
    (J : Finset Nat.Primes) (p : Nat.Primes) :
    universalSurgeryResidueMass (universalSignFlipSurgery J) p < 0 ↔ p ∈ J := by
  classical
  rw [universalSurgeryResidueMass_signFlip]
  split_ifs with hp
  · simp [hp, primeDyadicWeight_pos]
  · exact iff_of_false (not_lt_of_ge (primeDyadicWeight_pos _ _).le) hp

/-- The complete negative-residue locus is the chosen finite chamber vertex. -/
theorem universalSurgeryResidueMass_negativeSet_signFlip (J : Finset Nat.Primes) :
    {p : Nat.Primes |
      universalSurgeryResidueMass (universalSignFlipSurgery J) p < 0} =
      (J : Set Nat.Primes) := by
  ext p
  exact universalSurgeryResidueMass_signFlip_neg_iff J p

/-- The exact negative residue index is the cubical distance from the positive chamber. -/
theorem universalSurgeryResidueMass_negativeIndex_signFlip (J : Finset Nat.Primes) :
    Set.ncard {p : Nat.Primes |
      universalSurgeryResidueMass (universalSignFlipSurgery J) p < 0} = J.card := by
  rw [universalSurgeryResidueMass_negativeSet_signFlip]
  simp

/-- A canonical finite residue chamber of any prescribed depth. -/
def universalResidueChamberOfIndex (k : ℕ) : Finset Nat.Primes :=
  (Finset.range k).map (Infinite.natEmbedding Nat.Primes)

@[simp]
theorem universalResidueChamberOfIndex_card (k : ℕ) :
    (universalResidueChamberOfIndex k).card = k := by
  simp [universalResidueChamberOfIndex]

/-- Every finite negative residue index occurs inside the same universal differential field. -/
theorem universalResidueChamber_realizes_index (k : ℕ) :
    Set.ncard {p : Nat.Primes |
      universalSurgeryResidueMass
        (universalSignFlipSurgery (universalResidueChamberOfIndex k)) p < 0} = k := by
  rw [universalSurgeryResidueMass_negativeIndex_signFlip,
    universalResidueChamberOfIndex_card]

/-- **Constraint--orientation product law.**  For every finite residue surgery, every finite
simplicial facet family, and every finite localized structural family, the surgically modified
universal source realizes exactly the same Stanley--Reisner nonlinear differential matroid. -/
theorem universalFacetOrbitSurgery_stanleyReisnerLaurentDifferentialMatroid
    (a : PrimeResidueSurgery)
    {α ι : Type*}
    [Fintype α] [Fintype ι] [DecidableEq α] [DecidableEq ι]
    (d : translationSubmonoid (Polynomial ℂ) α)
    (facets : Finset (Finset α))
    (N : ι → MvPolynomial α (Polynomial ℂ) ⧸
      stanleyReisnerIdeal (Polynomial ℂ) facets) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    let e := finiteVertexNatEmbedding α
    let source : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) →
        upperEndMeroField := fun q =>
      universalFacetOrbitSurgerySource a
        (finiteFacetOrbitUniversalIndex e facets q.1)
    DifferentialIndependent ℂ
        (differentialOperatorRowApply
          (finiteFinsuppOperatorRows (stanleyReisnerLaurentRows d facets N)) source) ↔
      LinearIndependent (Polynomial ℂ) N := by
  classical
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  let e := finiteVertexNatEmbedding α
  let fullSource := universalFacetOrbitSurgerySource a
  let source : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) →
      upperEndMeroField := fun q =>
    fullSource (finiteFacetOrbitUniversalIndex e facets q.1)
  have hsourceRat : DifferentialIndependent (RatFunc ℂ) source := by
    have hcomp := (universalFacetOrbitSurgerySource_differentialIndependent a).comp
      (fun q : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) =>
        finiteFacetOrbitUniversalIndex e facets q.1)
      ((finiteFacetOrbitUniversalIndex_injective e facets).comp Subtype.val_injective)
    simpa [source, fullSource, Function.comp_def] using hcomp
  have hsource : DifferentialIndependent ℂ source :=
    differentialIndependent_upperEnd_restrictComplex source hsourceRat
  change DifferentialIndependent ℂ
      (differentialOperatorRowApply
        (finiteFinsuppOperatorRows (stanleyReisnerLaurentRows d facets N)) source) ↔
    LinearIndependent (Polynomial ℂ) N
  exact differentialIndependent_stanleyReisnerLaurentRows_iff
    (C := ℂ) (K := upperEndMeroField)
    upperEndMero_deriv_complexConstant d facets N source hsource

/-- The universal surgically modified source packet used by one squarefree face test. -/
def universalSurgeryFaceStructuralSource
    {α : Type*} [Fintype α] [DecidableEq α]
    (a : PrimeResidueSurgery) (facets : Finset (Finset α)) (J : Finset α) :
    FiniteFinsuppRowIndex
        (stanleyReisnerLaurentRows
          (1 : translationSubmonoid (Polynomial ℂ) α) facets
          (stanleyReisnerFaceFamily facets J)) → upperEndMeroField :=
  fun q => universalFacetOrbitSurgerySource a
    (finiteFacetOrbitUniversalIndex (finiteVertexNatEmbedding α) facets q.1)

/-- The universal analytic structural output attached to one candidate face. -/
def universalSurgeryFaceStructuralOutput
    {α : Type*} [Fintype α] [DecidableEq α]
    (a : PrimeResidueSurgery) (facets : Finset (Finset α))
    (J : Finset α) : upperEndMeroField := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  exact differentialOperatorRowApply
    (finiteFinsuppOperatorRows
      (stanleyReisnerLaurentRows
        (1 : translationSubmonoid (Polynomial ℂ) α) facets
        (stanleyReisnerFaceFamily facets J)))
    (universalSurgeryFaceStructuralSource a facets J) Unit.unit

set_option maxHeartbeats 800000 in
/-- Every finite simplicial complex is recovered exactly as the zero pattern of structural outputs
in every finite residue chamber of the one universal field. -/
theorem universalSurgeryFaceStructuralOutput_eq_zero_iff_nonface
    {α : Type*} [Fintype α] [DecidableEq α]
    (a : PrimeResidueSurgery) (facets : Finset (Finset α)) (J : Finset α) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    universalSurgeryFaceStructuralOutput a facets J = 0 ↔
      ¬ IsFaceOf (↑facets : Set (Finset α)) J := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
  letI := upperEndMeroFieldDifferential
  exact structuralFaceOutput_eq_zero_iff_nonface facets J
    (universalSurgeryFaceStructuralSource a facets J)
    (universalFacetOrbitSurgery_stanleyReisnerLaurentDifferentialMatroid a 1 facets
      (stanleyReisnerFaceFamily facets J))

/-- At every finite orientation index, the zero pattern of the one-field structural outputs is an
arbitrary prescribed finite simplicial complex. -/
theorem universal_orientationIndex_faceGeometry_product
    (k : ℕ) {α : Type*} [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :
    let Jk := universalResidueChamberOfIndex k
    let a := universalSignFlipSurgery Jk
    Set.ncard {p : Nat.Primes | universalSurgeryResidueMass a p < 0} = k ∧
      ∀ J : Finset α,
        letI := isDomain_upperEndAnalyticSubring
        letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
        letI := upperEndMeroFieldDifferential
        universalSurgeryFaceStructuralOutput a facets J = 0 ↔
          ¬ IsFaceOf (↑facets : Set (Finset α)) J := by
  dsimp only
  exact ⟨universalResidueChamber_realizes_index k,
    universalSurgeryFaceStructuralOutput_eq_zero_iff_nonface _ facets⟩

/-- **Universal constraint--orientation product theorem.**  At every prescribed finite residue
index `k`, the sign-flipped representative generates the same embedded differential field as the
positive universal source and realizes the exact localized Stanley--Reisner differential matroid
of every finite simplicial facet family. -/
theorem universal_constraintOrientation_product
    (k : ℕ)
    {α ι : Type*}
    [Fintype α] [Fintype ι] [DecidableEq α] [DecidableEq ι]
    (d : translationSubmonoid (Polynomial ℂ) α)
    (facets : Finset (Finset α))
    (N : ι → MvPolynomial α (Polynomial ℂ) ⧸
      stanleyReisnerIdeal (Polynomial ℂ) facets) :
    let J := universalResidueChamberOfIndex k
    let a := universalSignFlipSurgery J
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra ℂ upperEndMeroField := upperEndComplexToMero.toAlgebra
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := upperEndMeroFieldDifferential
    differentialAdjoin (RatFunc ℂ) (Set.range (universalFacetOrbitSurgerySource a)) =
        differentialAdjoin (RatFunc ℂ)
          (Set.range (boundedGaugeTranslatedPrimeLogUpperEnd universalFacetOrbitShift
            universalFacetOrbitGauge)) ∧
      Set.ncard {p : Nat.Primes | universalSurgeryResidueMass a p < 0} = k ∧
      (let e := finiteVertexNatEmbedding α
       let source : FiniteFinsuppRowIndex (stanleyReisnerLaurentRows d facets N) →
           upperEndMeroField := fun q =>
         universalFacetOrbitSurgerySource a
           (finiteFacetOrbitUniversalIndex e facets q.1)
       DifferentialIndependent ℂ
           (differentialOperatorRowApply
             (finiteFinsuppOperatorRows (stanleyReisnerLaurentRows d facets N)) source) ↔
         LinearIndependent (Polynomial ℂ) N) := by
  dsimp only
  refine ⟨universalFacetOrbitSurgerySource_differentialAdjoin_eq _,
    universalResidueChamber_realizes_index k, ?_⟩
  exact universalFacetOrbitSurgery_stanleyReisnerLaurentDifferentialMatroid
    (universalSignFlipSurgery (universalResidueChamberOfIndex k)) d facets N

end

end GaloisForLFunctions.HTGeometry
