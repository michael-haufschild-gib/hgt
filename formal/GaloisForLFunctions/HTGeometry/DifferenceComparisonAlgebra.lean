import GaloisForLFunctions.HTGeometry.DifferenceTensorGeneration
import GaloisForLFunctions.HTGeometry.TensorBasisIndependence

/-!
# Finite ordinary comparison algebra

The ordinary difference-Galois comparison algebra is generated by the entries of the tensor
comparison matrix and one inverse determinant.  It is finite type, fixed by the tensor difference
operator, generates the tensor square over the left PV factor, and has a constants basis that stays
linearly independent over the PV ring.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped TensorProduct

universe u

variable {K R C : Type u} [Field K] [CommRing R] [Algebra K R]
  [Field C] [Algebra C K] [Algebra C R] [IsScalarTower C K R]
  {n : ℕ}

/-- Subalgebra generated by the ordinary comparison matrix and its inverse determinant. -/
def comparisonAlgebra (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    Subalgebra C (R ⊗[K] R) :=
  Algebra.adjoin C (Set.range (fun p : Fin n × Fin n => Z p.1 p.2) ∪ {w})

instance comparisonAlgebra.instFiniteType
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    Algebra.FiniteType C (comparisonAlgebra (C := C) Z w) := by
  constructor
  rw [Subalgebra.fg_top (comparisonAlgebra (C := C) Z w), Subalgebra.fg_def]
  exact ⟨_, (Set.finite_range _).union (Set.finite_singleton w), rfl⟩

theorem mem_comparisonAlgebra_entry
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) (i j : Fin n) :
    Z i j ∈ comparisonAlgebra (C := C) Z w :=
  Algebra.subset_adjoin (Set.mem_union_left _ ⟨(i, j), rfl⟩)

theorem mem_comparisonAlgebra_inverseDet
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    w ∈ comparisonAlgebra (C := C) Z w :=
  Algebra.subset_adjoin (Set.mem_union_right _ rfl)

/-- The finite comparison algebra is pointwise fixed by the tensor difference operator. -/
theorem comparisonAlgebra_fixed
    {σK : K ≃+* K} {σR : R ≃+* R}
    (hcompat : ∀ x : K, σR (algebraMap K R x) = algebraMap K R (σK x))
    (hconstC : ∀ x : C, σR (algebraMap C R x) = algebraMap C R x)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R))
    (hZσ : ∀ i j, differenceTensorEquiv σK σR hcompat (Z i j) = Z i j)
    (w : R ⊗[K] R) (hw : Z.det * w = 1)
    {e : R ⊗[K] R} (he : e ∈ comparisonAlgebra (C := C) Z w) :
    differenceTensorEquiv σK σR hcompat e = e := by
  let τ := differenceTensorEquiv σK σR hcompat
  have hZmap : Z.map τ = Z := by
    ext i j
    exact hZσ i j
  have hdetσ : τ Z.det = Z.det := by
    calc
      τ Z.det = (Z.map τ).det := RingHom.map_det τ.toRingHom Z
      _ = Z.det := by rw [hZmap]
  have hwσ : τ w = w := by
    have hright : Z.det * τ w = 1 := by
      calc
        Z.det * τ w = τ Z.det * τ w := by rw [hdetσ]
        _ = τ (Z.det * w) := by rw [map_mul]
        _ = 1 := by rw [hw, map_one]
    calc
      τ w = (Z.det * w) * τ w := by rw [hw, one_mul]
      _ = w * (Z.det * τ w) := by ring
      _ = w := by rw [hright, mul_one]
  induction he using Algebra.adjoin_induction with
  | mem y hy =>
      rcases hy with ⟨p, rfl⟩ | hy
      · exact hZσ p.1 p.2
      · rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact hwσ
  | algebraMap c =>
      rw [IsScalarTower.algebraMap_apply C R (R ⊗[K] R)]
      change τ (algebraMap C R c ⊗ₜ[K] (1 : R)) =
        algebraMap C R c ⊗ₜ[K] (1 : R)
      rw [differenceTensorEquiv_tmul, hconstC, map_one]
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

/-- The left PV factor together with the finite comparison algebra generates the tensor square. -/
theorem adjoin_comparisonAlgebra_eq_top
    (Y : Matrix (Fin n) (Fin n) R) (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) = ⊤)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y) (hw : Z.det * w = 1) :
    Algebra.adjoin C (Set.range (algebraMap R (R ⊗[K] R))
      ∪ (comparisonAlgebra (C := C) Z w : Set (R ⊗[K] R))) = ⊤ := by
  set T : Set (R ⊗[K] R) := Set.range (algebraMap R (R ⊗[K] R))
    ∪ (comparisonAlgebra (C := C) Z w : Set (R ⊗[K] R)) with hT
  have hK := adjoin_tensor_comparison_eq_top Y u hu htop Z w hZ hw
  have hmem : ∀ y : R ⊗[K] R,
      y ∈ Algebra.adjoin K ((Set.range (fun x : R => x ⊗ₜ[K] (1 : R))
          ∪ Set.range (fun p : Fin n × Fin n => Z p.1 p.2)) ∪ {w}) →
      y ∈ Algebra.adjoin C T := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem z hz =>
        rcases hz with (⟨r, hr⟩ | ⟨p, hp⟩) | hz
        · refine Algebra.subset_adjoin (Set.mem_union_left _ ⟨r, ?_⟩)
          rw [← hr]
          rfl
        · refine Algebra.subset_adjoin (Set.mem_union_right _ ?_)
          rw [← hp]
          exact mem_comparisonAlgebra_entry Z w p.1 p.2
        · rw [Set.mem_singleton_iff] at hz
          refine Algebra.subset_adjoin (Set.mem_union_right _ ?_)
          rw [hz]
          exact mem_comparisonAlgebra_inverseDet Z w
    | algebraMap k =>
        have halg : algebraMap K (R ⊗[K] R) k =
            algebraMap R (R ⊗[K] R) (algebraMap K R k) := by
          rw [← IsScalarTower.algebraMap_apply]
        rw [halg]
        exact Algebra.subset_adjoin (Set.mem_union_left _ ⟨_, rfl⟩)
    | add p q _ _ hp hq => exact Subalgebra.add_mem _ hp hq
    | mul p q _ _ hp hq => exact Subalgebra.mul_mem _ hp hq
  refine top_unique fun x _ => ?_
  refine hmem x ?_
  rw [hK]
  exact Algebra.mem_top

/-- A chosen constants basis of the finite comparison algebra stays independent over the PV ring. -/
theorem linearIndependent_comparisonAlgebra_chooseBasis [Nontrivial R]
    {σK : K ≃+* K} {σR : R ≃+* R}
    (hcompat : ∀ x : K, σR (algebraMap K R x) = algebraMap K R (σK x))
    (hconstC : ∀ x : C, σR (algebraMap C R x) = algebraMap C R x)
    (hsimple : IsSigmaSimple σR)
    (hnonew : ∀ r : R, σR r = r → ∃ c : C, r = algebraMap C R c)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R))
    (hZσ : ∀ i j, differenceTensorEquiv σK σR hcompat (Z i j) = Z i j)
    (w : R ⊗[K] R) (hw : Z.det * w = 1) :
    LinearIndependent R (fun i =>
      (((Module.Free.chooseBasis C (comparisonAlgebra (C := C) Z w)) i :
        comparisonAlgebra (C := C) Z w) : R ⊗[K] R)) := by
  classical
  let τ := differenceTensorEquiv σK σR hcompat
  apply linearIndependent_constants_basis σR τ
  · intro r
    change τ (r ⊗ₜ[K] (1 : R)) = σR r ⊗ₜ[K] (1 : R)
    rw [differenceTensorEquiv_tmul, map_one]
  · exact hsimple
  · intro e
    exact comparisonAlgebra_fixed hcompat hconstC Z hZσ w hw e.2
  · exact hnonew

end

end GaloisForLFunctions.HTGeometry
