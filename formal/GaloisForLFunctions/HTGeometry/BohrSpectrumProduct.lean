import GaloisForLFunctions.HTGeometry.BohrProductRule

/-!
# The spectrum of a product

The Bohr spectrum of a product is contained in the sum of the spectra, hence in the additive
subgroup they generate.  This is the form the differential-algebraic analysis uses: a polynomial
expression in a function and its derivatives has all of its frequencies in the group generated by
the frequencies of the function, because differentiation does not enlarge the spectrum and
multiplication only adds frequencies.
-/

open MeasureTheory ComplexConjugate

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions

open HTGeometry

noncomputable section

/-- **The spectrum of a product lies in the sum of the spectra.** -/
theorem exists_add_eq_of_mem_bohrSpectrum_mul {f g : ℝ →ᵇ ℂ}
    (hf : UniformContinuous (fun x => f x)) (htbf : HasTotallyBoundedOrbit (fun x => f x))
    (hg : UniformContinuous (fun x => g x)) (htbg : HasTotallyBoundedOrbit (fun x => g x))
    {lam : ℝ} (hlam : lam ∈ bohrSpectrum (fun t => f t * g t)) :
    ∃ mu ∈ bohrSpectrum (fun x => f x), ∃ nu ∈ bohrSpectrum (fun x => g x), mu + nu = lam := by
  by_contra hcon
  push Not at hcon
  refine hlam (bohrCoefficient_mul_eq_zero hf htbf hg htbg ?_)
  intro mu nu hsum
  by_cases hmu : bohrCoefficient (fun x => f x) mu = 0
  · exact Or.inl hmu
  · right
    by_contra hnu
    exact hcon mu hmu nu hnu hsum

/-- **The spectrum of a product lies in the subgroup generated by the two spectra.** -/
theorem bohrSpectrum_mul_subset_closure {f g : ℝ →ᵇ ℂ}
    (hf : UniformContinuous (fun x => f x)) (htbf : HasTotallyBoundedOrbit (fun x => f x))
    (hg : UniformContinuous (fun x => g x)) (htbg : HasTotallyBoundedOrbit (fun x => g x)) :
    bohrSpectrum (fun t => f t * g t)
      ⊆ (AddSubgroup.closure (bohrSpectrum (fun x => f x) ∪ bohrSpectrum (fun x => g x)) :
          Set ℝ) := by
  intro lam hlam
  obtain ⟨mu, hmu, nu, hnu, hsum⟩ :=
    exists_add_eq_of_mem_bohrSpectrum_mul hf htbf hg htbg hlam
  rw [← hsum]
  exact AddSubgroup.add_mem _
    (AddSubgroup.subset_closure (Set.mem_union_left _ hmu))
    (AddSubgroup.subset_closure (Set.mem_union_right _ hnu))

end

end GaloisForLFunctions
