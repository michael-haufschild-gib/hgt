import GaloisForLFunctions.HTGeometry.GaussBonnetFixedChargeAGibbsHellingerRates
import GaloisForLFunctions.HTGeometry.BistochasticMixingMajorization

/-!
The critical Gibbs Markov family derived from arXiv:2609.00025 is a concrete
semigroup in the corpus's doubly stochastic matrix space. All admission proofs
come from its already closed transition laws.
-/
namespace GaloisForLFunctions.HTGeometry

open Matrix

noncomputable section

/-- Every critical Gibbs transition power as a genuine doubly stochastic matrix. -/
def egbFixedChargeACriticalBistochastic (n m : ℕ) :
    doublyStochastic ℝ (Fin (2 ^ (n + 3))) :=
  ⟨Matrix.of (fun i j => ((egbFixedChargeACriticalMarkovMatrix n ^ m) i j).re),
    mem_doublyStochastic_iff_sum.mpr
      ⟨egbFixedChargeACriticalMarkovMatrix_pow_nonneg n m,
        egbFixedChargeACriticalMarkovMatrix_pow_row_sum n m,
        egbFixedChargeACriticalMarkovMatrix_pow_column_sum n m⟩⟩

/-- The bistochastic action is exactly the existing packaged real Markov action. -/
theorem egbFixedChargeACriticalBistochastic_action
    (n m : ℕ) (f : Fin (2 ^ (n + 3)) → ℝ) :
    (egbFixedChargeACriticalBistochastic n m).val *ᵥ f =
      (egbFixedChargeACriticalMarkovIteratedKernel n m).toFinitePositiveKernel.applyReal f := rfl

/-- Zero transitions are the identity in the doubly stochastic matrix space. -/
theorem egbFixedChargeACriticalBistochastic_zero (n : ℕ) :
    egbFixedChargeACriticalBistochastic n 0 = 1 := by
  apply Subtype.ext
  ext i j
  by_cases h : i = j <;>
    simp [egbFixedChargeACriticalBistochastic, Matrix.one_apply, h]

/-- The doubly stochastic representatives obey the exact transition semigroup law. -/
theorem egbFixedChargeACriticalBistochastic_mul (n a b : ℕ) :
    egbFixedChargeACriticalBistochastic n a * egbFixedChargeACriticalBistochastic n b =
      egbFixedChargeACriticalBistochastic n (a + b) := by
  apply Subtype.ext
  ext i j
  change (∑ k, ((egbFixedChargeACriticalMarkovMatrix n ^ a) i k).re *
    ((egbFixedChargeACriticalMarkovMatrix n ^ b) k j).re) =
      ((egbFixedChargeACriticalMarkovMatrix n ^ (a + b)) i j).re
  rw [pow_add (egbFixedChargeACriticalMarkovMatrix n) a b, Matrix.mul_apply, Complex.re_sum]
  simp only [Complex.mul_re, egbFixedChargeACriticalMarkovMatrix_pow_im_zero, mul_zero, sub_zero]

/-- The entire family is generated by powers of its single-step bistochastic matrix. -/
theorem egbFixedChargeACriticalBistochastic_pow (n m : ℕ) :
    egbFixedChargeACriticalBistochastic n 1 ^ m = egbFixedChargeACriticalBistochastic n m := by
  induction m with
  | zero => rw [pow_zero, egbFixedChargeACriticalBistochastic_zero]
  | succ m ih =>
    rw [pow_succ (egbFixedChargeACriticalBistochastic n 1) m, ih,
      egbFixedChargeACriticalBistochastic_mul]

end

end GaloisForLFunctions.HTGeometry
