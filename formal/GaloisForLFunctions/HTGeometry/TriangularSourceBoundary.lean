import GaloisForLFunctions.HTGeometry.SourceStableDifferentialAdjoin
import GaloisForLFunctions.HTGeometry.InvariantSubDatum
import GaloisForLFunctions.HTGeometry.FiniteDifferentialCircuitBoundary
import GaloisForLFunctions.HTGeometry.DifferentialIndependentTower

/-!
# The unipotent triangular datum is flat over its invariant block

A source datum whose adjoint local system is unipotent above an invariant block is not flat over
the original base: its complementary observables shift by combinations of the block observables.
Over the differential field generated by the block, however, those combinations are coefficients,
and the datum is flat again.

So the source-boundary criterion applies verbatim to the complementary block after base change:
differential independence over the block field is linear independence, over the constant-coefficient
differential operators of that field, of the boundary classes of the enlarged increments.  This is
the first genuinely non-diagonalizable case of the curved rank problem.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C K L : Type u} [Field C] [Field K] [Field L]
  [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]
  {I : Type u} (tau : I → K ≃+* K) (sigma : I → L ≃+* L)

variable {κ : Type u} [Fintype κ] [DecidableEq κ]

/-- The differential field generated over the base by the observables of an invariant block. -/
@[reducible]
def blockField (K : Type u) {L : Type u} [Field K] [Field L] [Algebra K L] [Differential L]
    {κ : Type u} (z : κ → L) (S : Finset κ) : IntermediateField K L :=
  differentialAdjoin K (Set.range fun q : {x : κ // x ∈ S} => z ↑q)

/-- The increment forced on the complementary block, as an element of the block field. -/
def blockIncrement (M : I → κ → κ → K) (om : I → κ → K) (z : κ → L) (S : Finset κ)
    (i : I) (p : κ) : ↥(blockField K z S) :=
  ⟨enlargedIncrement M om z S i p, enlargedIncrement_mem_adjoin M om z S i p⟩

omit [Fintype κ] [DecidableEq κ] in
/-- The block field is stable under every source direction, in both directions. -/
theorem blockField_stable (z : κ → L) (S : Finset κ)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    (hgen : ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, sigma i x ∈ blockField K z S)
    (hgenSymm :
      ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, (sigma i).symm x ∈ blockField K z S)
    (i : I) (x : L) :
    sigma i x ∈ blockField K z S ↔ x ∈ blockField K z S :=
  sourceStable_mem_differentialAdjoin_iff tau sigma hcomp hderivL _ hgen hgenSymm i x

/-- **The unipotent triangular source-boundary criterion.**  Over the differential field of an
invariant block, a unipotent triangular datum is flat, so the complementary observables are
differentially independent exactly when the boundary classes of their enlarged increments are
linearly independent over the constant-coefficient differential operators of the block field. -/
theorem unipotentTriangular_differentialIndependent_iff [CharZero L]
    {z : κ → L} {M : I → κ → κ → K} {om : I → κ → K} (S : Finset κ)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ y : L, (∀ i, sigma i y = y) → ∃ c : C, algebraMap C L c = y)
    (hC : ∀ c : C, (algebraMap C L c)′ = 0)
    (hshift : ∀ i p, sigma i (z p)
      = (∑ q, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p))
    (hunipotent : ∀ i p q, p ∉ S → q ∉ S → M i p q = if p = q then 1 else 0)
    (hgen : ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, sigma i x ∈ blockField K z S)
    (hgenSymm :
      ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, (sigma i).symm x ∈ blockField K z S) :
    DifferentialIndependent ↥(blockField K z S) (fun p : {x : κ // x ∉ S} => z ↑p) ↔
      LinearIndependent (Polynomial C)
        (fun p : {x : κ // x ∉ S} =>
          boundaryClass
            (restrictSource sigma (blockField K z S)
              (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm))
            (algebraMap_C_deriv_eq_zero_of_base (blockField K z S) hC)
            (restrictSource_fixesConstants sigma (blockField K z S)
              (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hCfixed)
            (restrictSource_deriv sigma (blockField K z S)
              (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hderivL)
            fun i => blockIncrement M om z S i ↑p) :=
  differentialIndependent_iff_linearIndependent_boundaryClass_baseChange sigma
    (blockField K z S) (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm)
    hderivL hCfixed hfixed (algebraMap_C_deriv_eq_zero_of_base (blockField K z S) hC)
    (fun p : {x : κ // x ∉ S} => z ↑p) (fun i p => blockIncrement M om z S i ↑p)
    fun i p => by
      have h := triangular_shift_enlarged sigma hshift S
        (m := fun _ _ => (1 : K)) (fun i p q hp hq => hunipotent i p q hp hq) i p.2
      rwa [map_one, one_mul] at h

/-- **Hypertranscendence from the triangular criterion.**  Independence of the boundary classes of
the enlarged increments over the constant-coefficient differential operators of the block field
makes the complementary observables differentially independent already over the original base. -/
theorem unipotentTriangular_differentialIndependent_of_linearIndependent [CharZero L]
    {z : κ → L} {M : I → κ → κ → K} {om : I → κ → K} (S : Finset κ)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ y : L, (∀ i, sigma i y = y) → ∃ c : C, algebraMap C L c = y)
    (hC : ∀ c : C, (algebraMap C L c)′ = 0)
    (hshift : ∀ i p, sigma i (z p)
      = (∑ q, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p))
    (hunipotent : ∀ i p q, p ∉ S → q ∉ S → M i p q = if p = q then 1 else 0)
    (hgen : ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, sigma i x ∈ blockField K z S)
    (hgenSymm :
      ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, (sigma i).symm x ∈ blockField K z S)
    (hind : LinearIndependent (Polynomial C)
      (fun p : {x : κ // x ∉ S} =>
        boundaryClass
          (restrictSource sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm))
          (algebraMap_C_deriv_eq_zero_of_base (blockField K z S) hC)
          (restrictSource_fixesConstants sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hCfixed)
          (restrictSource_deriv sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hderivL)
          fun i => blockIncrement M om z S i ↑p)) :
    DifferentialIndependent K (fun p : {x : κ // x ∉ S} => z ↑p) :=
  DifferentialIndependent.restrictScalarsTower
    ((unipotentTriangular_differentialIndependent_iff tau sigma S hcomp hderivL hCfixed hfixed hC
      hshift hunipotent hgen hgenSymm).2 hind)

/-- **The whole triangular family is hypertranscendental.**  A block independent over the base
together with boundary classes independent over the block field make the entire family
differentially independent over the base. -/
theorem unipotentTriangular_differentialIndependent_sumElim [CharZero L]
    {z : κ → L} {M : I → κ → κ → K} {om : I → κ → K} (S : Finset κ)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ y : L, (∀ i, sigma i y = y) → ∃ c : C, algebraMap C L c = y)
    (hC : ∀ c : C, (algebraMap C L c)′ = 0)
    (hshift : ∀ i p, sigma i (z p)
      = (∑ q, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p))
    (hunipotent : ∀ i p q, p ∉ S → q ∉ S → M i p q = if p = q then 1 else 0)
    (hgen : ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, sigma i x ∈ blockField K z S)
    (hgenSymm :
      ∀ i, ∀ x ∈ Set.range fun q : {x : κ // x ∈ S} => z ↑q, (sigma i).symm x ∈ blockField K z S)
    (hblock : DifferentialIndependent K fun q : {x : κ // x ∈ S} => z ↑q)
    (hind : LinearIndependent (Polynomial C)
      (fun p : {x : κ // x ∉ S} =>
        boundaryClass
          (restrictSource sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm))
          (algebraMap_C_deriv_eq_zero_of_base (blockField K z S) hC)
          (restrictSource_fixesConstants sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hCfixed)
          (restrictSource_deriv sigma (blockField K z S)
            (blockField_stable tau sigma z S hcomp hderivL hgen hgenSymm) hderivL)
          fun i => blockIncrement M om z S i ↑p)) :
    DifferentialIndependent K
      (Sum.elim (fun p : {x : κ // x ∉ S} => z ↑p) fun q : {x : κ // x ∈ S} => z ↑q) :=
  differentialIndependent_sumElim hblock
    ((unipotentTriangular_differentialIndependent_iff tau sigma S hcomp hderivL hCfixed hfixed hC
      hshift hunipotent hgen hgenSymm).2 hind)

end

end GaloisForLFunctions.HTGeometry
