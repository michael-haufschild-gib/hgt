import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# A denominator-free witness for algebraicity over a simple polynomial subalgebra

An element algebraic over the subalgebra `K[t]` generated by a single element satisfies a relation
whose coefficients are *polynomials* in `t`, with a nonzero leading coefficient.  This is the
univariate form of `algebraicWitness_of_isAlgebraic_adjoin`, in the shape the Euler-relation
transfer consumes.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

/-- **Algebraicity over `K[t]` gives a polynomial-coefficient relation.** -/
theorem exists_polynomialCoeff_relation_of_isAlgebraic_adjoin_singleton
    {K F : Type*} [Field K] [CommRing F] [Algebra K F] {t y : F}
    (h : IsAlgebraic ↥(Algebra.adjoin K ({t} : Set F)) y) :
    ∃ (m : ℕ) (C : ℕ → Polynomial K), Polynomial.aeval t (C m) ≠ 0 ∧
      ∑ i ∈ Finset.range (m + 1), Polynomial.aeval t (C i) * y ^ i = 0 := by
  classical
  obtain ⟨p, hp0, hp⟩ := h
  have hrange : ∀ i : ℕ, ∃ R : Polynomial K,
      Polynomial.aeval t R = ((p.coeff i : _) : F) := by
    intro i
    obtain ⟨x, hxeq, hx⟩ : ∃ x : F, x = ((p.coeff i : _) : F) ∧ x ∈ Algebra.adjoin K ({t} : Set F) :=
      ⟨_, rfl, (p.coeff i).2⟩
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨R, hR⟩ := hx
    exact ⟨R, by rw [show Polynomial.aeval t R = (Polynomial.aeval t).toRingHom R from rfl, hR,
      hxeq]⟩
  choose C hC using hrange
  refine ⟨p.natDegree, C, ?_, ?_⟩
  · rw [hC]
    intro h0
    exact hp0 (Polynomial.leadingCoeff_eq_zero.mp (Subtype.ext h0))
  · have hsum : Polynomial.aeval y p
        = ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i • y ^ i :=
      Polynomial.aeval_eq_sum_range y
    rw [hp] at hsum
    refine Eq.trans ?_ hsum.symm
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hC i, Algebra.smul_def]
    rfl

end GaloisForLFunctions.HTGeometry
