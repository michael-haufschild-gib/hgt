import GaloisForLFunctions.HTGeometry.HolomorphicPeriodIncidenceExclusion
import GaloisForLFunctions.HTGeometry.PhysicalOsculationEffectivityFracture

/-!
# Physical/holomorphic period-incidence universality

Rationally independent conic rank-three sources carry exact local physical osculation while their
global period-incidence multiplier is ineffective.  The same nondiscrete period group also has a
sharp bounded-holomorphic exclusion: completion adds no first-order holomorphic class, and the
all-power flat intersection contains no nonzero bounded-holomorphic evaluation.
-/

open Filter
open scoped Topology ENNReal

namespace GaloisForLFunctions

noncomputable section

/-- Integer period group generated by the conic rank-three physical source. -/
def conicRankThreePeriodGroup (α : ℂ) : Submodule ℤ ℂ :=
  Submodule.span ℤ (Set.range (conicRankThreeSource α))

/-- **Physical/holomorphic period-incidence law.**  Exact contact orders two and three coexist
with global incidence ineffectivity, while bounded-holomorphic data sees neither the first
completion defect nor a nonzero all-power flat class. -/
theorem conicRankThree_physicalHolomorphicPeriodIncidenceUniversality
    (α : ℂ) (hlin : LinearIndependent ℚ (conicRankThreeSource α))
    (f : ℂ → ℂ) (R : ℝ)
    (hf : AnalyticOnNhd ℂ f (Metric.ball 0 1))
    (hmap : Set.MapsTo f (Metric.ball 0 1) (Metric.closedBall 0 R)) :
    analyticOrderAt (rankThreeTransversePhysicalPullback α) 0 = 2 ∧
      analyticOrderAt (conicPhysicalPullback α) 0 = 3 ∧
      ¬ (periodIncidenceMultiplier (conicRankThreePeriodGroup α)).HasLeftInverse ∧
      (periodHolomorphicEvaluation (conicRankThreePeriodGroup α) f R hmap ∈
            closure (Set.range
              (periodIncidenceMultiplier (conicRankThreePeriodGroup α))) ↔
        periodHolomorphicEvaluation (conicRankThreePeriodGroup α) f R hmap ∈
            Set.range (periodIncidenceMultiplier (conicRankThreePeriodGroup α))) ∧
      ((∀ r : ℕ,
          periodHolomorphicEvaluation (conicRankThreePeriodGroup α) f R hmap ∈
            Set.range (poweredPeriodIncidenceMultiplier
              (conicRankThreePeriodGroup α) r)) →
        periodHolomorphicEvaluation (conicRankThreePeriodGroup α) f R hmap = 0) := by
  have hphysical := rankThreePhysicalOsculation_effectivity_fracture α hlin
  have hno : ¬ (periodIncidenceMultiplier
      (conicRankThreePeriodGroup α)).HasLeftInverse := by
    simpa [conicRankThreePeriodGroup] using hphysical.2.2
  have hnondiscrete : ¬ DiscreteTopology (conicRankThreePeriodGroup α) := by
    intro hdiscrete
    exact hno
      ((periodIncidenceMultiplier_hasLeftInverse_iff_discrete
        (conicRankThreePeriodGroup α)).2 hdiscrete)
  have hholomorphic := holomorphic_period_incidence_exclusion
    (conicRankThreePeriodGroup α) hnondiscrete f R hf hmap
  exact ⟨hphysical.1, hphysical.2.1, hno,
    hholomorphic.1, hholomorphic.2⟩

end

end GaloisForLFunctions
