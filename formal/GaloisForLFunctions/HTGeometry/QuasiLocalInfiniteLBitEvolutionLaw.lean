import GaloisForLFunctions.HTGeometry.QuasiLocalInfiniteLBitDynamicsLaw

/-!
# Reversible Schrödinger phase evolution for the infinite l-bit energy

The bounded continuous infinite energy defines a genuine one-parameter evolution on continuous
complex amplitudes over the compact Boolean configuration space.  At time `t`, every
configuration amplitude is multiplied by the unit phase `exp(-i t E(σ))`.

This file proves the group law, inverse law, exact uniform-norm preservation, and norm-topology
continuity of every time orbit.  The evolution is packaged as a complex-linear isometric
equivalence.  No measure, Hilbert completion, or operator-algebra interpretation is imposed.
-/

open Set Filter
open scoped Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Infinite Boolean configuration space. -/
abbrev InfiniteLBitConfiguration :=
  ℕ → Bool

/-- Continuous complex amplitudes on the compact infinite configuration space. -/
abbrev ContinuousInfiniteLBitAmplitude :=
  C(InfiniteLBitConfiguration, ℂ)

/-- Unit Schrödinger phase generated by the infinite diagonal energy. -/
noncomputable def quasiLocalInfiniteLBitPhase
    (t : ℝ) (σ : InfiniteLBitConfiguration) : ℂ :=
  Complex.exp
    (-Complex.I * (t : ℂ) *
      (quasiLocalInfiniteLBitEnergy σ : ℂ))

/-- The Schrödinger phase is continuous in configuration at every time. -/
theorem continuous_quasiLocalInfiniteLBitPhase
    (t : ℝ) :
    Continuous (quasiLocalInfiniteLBitPhase t) := by
  unfold quasiLocalInfiniteLBitPhase
  exact Complex.continuous_exp.comp
    ((continuous_const.mul continuous_const).mul
      (Complex.continuous_ofReal.comp
        continuous_quasiLocalInfiniteLBitEnergy))

/-- Every Schrödinger phase has exactly unit modulus. -/
@[simp]
theorem norm_quasiLocalInfiniteLBitPhase
    (t : ℝ) (σ : InfiniteLBitConfiguration) :
    ‖quasiLocalInfiniteLBitPhase t σ‖ = 1 := by
  rw [quasiLocalInfiniteLBitPhase, Complex.norm_exp]
  simp

/-- Phase multiplication law. -/
theorem quasiLocalInfiniteLBitPhase_add
    (t s : ℝ) (σ : InfiniteLBitConfiguration) :
    quasiLocalInfiniteLBitPhase (t + s) σ =
      quasiLocalInfiniteLBitPhase t σ *
        quasiLocalInfiniteLBitPhase s σ := by
  rw [quasiLocalInfiniteLBitPhase,
    quasiLocalInfiniteLBitPhase,
    quasiLocalInfiniteLBitPhase,
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Time zero has trivial phase. -/
@[simp]
theorem quasiLocalInfiniteLBitPhase_zero
    (σ : InfiniteLBitConfiguration) :
    quasiLocalInfiniteLBitPhase 0 σ = 1 := by
  simp [quasiLocalInfiniteLBitPhase]

/-- Negative time supplies the pointwise phase inverse. -/
theorem quasiLocalInfiniteLBitPhase_neg_mul
    (t : ℝ) (σ : InfiniteLBitConfiguration) :
    quasiLocalInfiniteLBitPhase (-t) σ *
        quasiLocalInfiniteLBitPhase t σ = 1 := by
  rw [← quasiLocalInfiniteLBitPhase_add]
  simp

/-- Pointwise Schrödinger evolution of a continuous amplitude. -/
noncomputable def quasiLocalInfiniteLBitEvolution
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    ContinuousInfiniteLBitAmplitude where
  toFun := fun σ =>
    quasiLocalInfiniteLBitPhase t σ * ψ σ
  continuous_toFun :=
    (continuous_quasiLocalInfiniteLBitPhase t).mul
      ψ.continuous

@[simp]
theorem quasiLocalInfiniteLBitEvolution_apply
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude)
    (σ : InfiniteLBitConfiguration) :
    quasiLocalInfiniteLBitEvolution t ψ σ =
      quasiLocalInfiniteLBitPhase t σ * ψ σ :=
  rfl

/-- Time zero is the identity evolution. -/
@[simp]
theorem quasiLocalInfiniteLBitEvolution_zero
    (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution 0 ψ = ψ := by
  ext σ
  simp

/-- Exact one-parameter group law. -/
theorem quasiLocalInfiniteLBitEvolution_add
    (t s : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution (t + s) ψ =
      quasiLocalInfiniteLBitEvolution t
        (quasiLocalInfiniteLBitEvolution s ψ) := by
  ext σ
  rw [quasiLocalInfiniteLBitEvolution_apply,
    quasiLocalInfiniteLBitEvolution_apply,
    quasiLocalInfiniteLBitEvolution_apply,
    quasiLocalInfiniteLBitPhase_add]
  ring

/-- Evolution is additive in the amplitude. -/
theorem quasiLocalInfiniteLBitEvolution_map_add
    (t : ℝ) (ψ φ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution t (ψ + φ) =
      quasiLocalInfiniteLBitEvolution t ψ +
        quasiLocalInfiniteLBitEvolution t φ := by
  ext σ
  simp [mul_add]

/-- Evolution is complex homogeneous in the amplitude. -/
theorem quasiLocalInfiniteLBitEvolution_map_smul
    (t : ℝ) (c : ℂ)
    (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution t (c • ψ) =
      c • quasiLocalInfiniteLBitEvolution t ψ := by
  ext σ
  change
    quasiLocalInfiniteLBitPhase t σ * (c * ψ σ) =
      c * (quasiLocalInfiniteLBitPhase t σ * ψ σ)
  ring

/-- Negative time is a left inverse. -/
@[simp]
theorem quasiLocalInfiniteLBitEvolution_neg_left
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution (-t)
        (quasiLocalInfiniteLBitEvolution t ψ) = ψ := by
  rw [← quasiLocalInfiniteLBitEvolution_add]
  simp

/-- Negative time is a right inverse. -/
@[simp]
theorem quasiLocalInfiniteLBitEvolution_neg_right
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolution t
        (quasiLocalInfiniteLBitEvolution (-t) ψ) = ψ := by
  rw [← quasiLocalInfiniteLBitEvolution_add]
  simp

/-- Evolution is nonexpansive in the uniform norm. -/
theorem norm_quasiLocalInfiniteLBitEvolution_le
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    ‖quasiLocalInfiniteLBitEvolution t ψ‖ ≤ ‖ψ‖ := by
  rw [ContinuousMap.norm_le _ (norm_nonneg ψ)]
  intro σ
  rw [quasiLocalInfiniteLBitEvolution_apply,
    norm_mul,
    norm_quasiLocalInfiniteLBitPhase,
    one_mul]
  exact ContinuousMap.norm_coe_le_norm ψ σ

/-- Exact uniform-norm preservation. -/
@[simp]
theorem norm_quasiLocalInfiniteLBitEvolution
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    ‖quasiLocalInfiniteLBitEvolution t ψ‖ = ‖ψ‖ := by
  apply le_antisymm
    (norm_quasiLocalInfiniteLBitEvolution_le t ψ)
  calc
    ‖ψ‖ =
        ‖quasiLocalInfiniteLBitEvolution (-t)
          (quasiLocalInfiniteLBitEvolution t ψ)‖ := by
            rw [quasiLocalInfiniteLBitEvolution_neg_left]
    _ ≤ ‖quasiLocalInfiniteLBitEvolution t ψ‖ :=
      norm_quasiLocalInfiniteLBitEvolution_le
        (-t) (quasiLocalInfiniteLBitEvolution t ψ)

/-- The evolution at each time is a complex-linear isometric equivalence of continuous
amplitudes. -/
noncomputable def quasiLocalInfiniteLBitEvolutionLinearIsometryEquiv
    (t : ℝ) :
    ContinuousInfiniteLBitAmplitude ≃ₗᵢ[ℂ]
      ContinuousInfiniteLBitAmplitude where
  toFun := quasiLocalInfiniteLBitEvolution t
  invFun := quasiLocalInfiniteLBitEvolution (-t)
  left_inv := quasiLocalInfiniteLBitEvolution_neg_left t
  right_inv := quasiLocalInfiniteLBitEvolution_neg_right t
  map_add' := quasiLocalInfiniteLBitEvolution_map_add t
  map_smul' := quasiLocalInfiniteLBitEvolution_map_smul t
  norm_map' := norm_quasiLocalInfiniteLBitEvolution t

@[simp]
theorem quasiLocalInfiniteLBitEvolutionLinearIsometryEquiv_apply
    (t : ℝ) (ψ : ContinuousInfiniteLBitAmplitude) :
    quasiLocalInfiniteLBitEvolutionLinearIsometryEquiv t ψ =
      quasiLocalInfiniteLBitEvolution t ψ :=
  rfl

/-- Pointwise time evolution is continuous for every amplitude and configuration. -/
theorem continuous_quasiLocalInfiniteLBitEvolution_apply_time
    (ψ : ContinuousInfiniteLBitAmplitude)
    (σ : InfiniteLBitConfiguration) :
    Continuous
      (fun t : ℝ =>
        quasiLocalInfiniteLBitEvolution t ψ σ) := by
  unfold quasiLocalInfiniteLBitEvolution
  exact
    (Complex.continuous_exp.comp
      ((continuous_const.mul
        Complex.continuous_ofReal).mul
          continuous_const)).mul
      continuous_const

/-- **Strong time-continuity law.**  Every amplitude orbit is continuous in the uniform-norm
topology of continuous functions. -/
theorem continuous_quasiLocalInfiniteLBitEvolution_time
    (ψ : ContinuousInfiniteLBitAmplitude) :
    Continuous
      (fun t : ℝ =>
        quasiLocalInfiniteLBitEvolution t ψ) := by
  apply ContinuousMap.continuous_of_continuous_uncurry
  change Continuous
    (fun p : ℝ × InfiniteLBitConfiguration =>
      quasiLocalInfiniteLBitPhase p.1 p.2 * ψ p.2)
  have htime :
      Continuous (fun p : ℝ × InfiniteLBitConfiguration =>
        (p.1 : ℂ)) :=
    Complex.continuous_ofReal.comp continuous_fst
  have henergy :
      Continuous (fun p : ℝ × InfiniteLBitConfiguration =>
        (quasiLocalInfiniteLBitEnergy p.2 : ℂ)) :=
    Complex.continuous_ofReal.comp
      (continuous_quasiLocalInfiniteLBitEnergy.comp
        continuous_snd)
  have hphase :
      Continuous
        (fun p : ℝ × InfiniteLBitConfiguration =>
          quasiLocalInfiniteLBitPhase p.1 p.2) := by
    unfold quasiLocalInfiniteLBitPhase
    exact Complex.continuous_exp.comp
      ((continuous_const.mul htime).mul henergy)
  exact hphase.mul
    (ψ.continuous.comp continuous_snd)

end

end GaloisForLFunctions.HTGeometry
