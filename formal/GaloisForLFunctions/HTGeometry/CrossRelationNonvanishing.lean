import GaloisForLFunctions.HTGeometry.CrossRelationDescentRelation

/-!
# The cross-relation of two coefficients with a non-base ratio does not vanish

The coefficient cross-relation is built to be zero exactly when its two entries are proportional over
the base field.  So if the two characteristic coefficients have a ratio outside the base — which a
nonzero relation always provides — the cross-relation is a *nonzero* relation.

That is what makes the Lüroth comparison non-vacuous: the small field generated by the two
coefficients really does carry a relation of the free element.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- **A non-base ratio makes the cross-relation nonzero.** -/
theorem crossRelation_ne_zero (G : IntermediateField F E) (p q : G)
    {P Q : DifferentialPolynomial Unit F} (hQ : Q ≠ 0)
    (hratio : ∀ c : F, (p : E) ≠ algebraMap F E c * (q : E)) :
    differentialCharacteristicCoefficientCrossRelation G p q P Q ≠ 0 := by
  classical
  intro hzero
  obtain ⟨m, hm⟩ := MvPolynomial.exists_coeff_ne_zero hQ
  have hcoeff : (q * algebraMap F G (P.coeff m) - p * algebraMap F G (Q.coeff m) : G) = 0 := by
    have := congrArg (fun R => MvPolynomial.coeff m R) hzero
    simpa [differentialCharacteristicCoefficientCrossRelation, MvPolynomial.coeff_sub,
      MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map] using this
  have hQm : (algebraMap F G (Q.coeff m)) ≠ 0 := by
    simpa using (algebraMap F G).injective.ne hm
  have hmul : q * algebraMap F G (P.coeff m) = p * algebraMap F G (Q.coeff m) :=
    sub_eq_zero.1 hcoeff
  have hp : p = q * algebraMap F G (P.coeff m / Q.coeff m) := by
    have hdiv : p = (q * algebraMap F G (P.coeff m)) / algebraMap F G (Q.coeff m) := by
      rw [eq_div_iff hQm, hmul]
    rw [hdiv, map_div₀]
    ring
  refine hratio (P.coeff m / Q.coeff m) ?_
  have hE : (p : E) = ((q * algebraMap F G (P.coeff m / Q.coeff m) : G) : E) := by
    rw [← hp]
  rw [hE]
  simp [mul_comm]

end

end GaloisForLFunctions
