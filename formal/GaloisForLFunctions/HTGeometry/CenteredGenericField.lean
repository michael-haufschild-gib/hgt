import GaloisForLFunctions.HTGeometry.CenteredGenericPolynomial

/-!
# The field generated by the centered roots

The centered roots generate an intermediate field of the rational function field over the
constants.  Permuting the variables permutes the centered roots, so that field is stable under the
symmetric group, and the action on it is faithful because the centered roots are distinct.

Artin's theorem then gives that field degree `d!` over the part fixed by the symmetric group.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial Polynomial

variable {K : Type*} [Field K] {d : ℕ}

/-! ## Scalars commute with the action -/

noncomputable scoped instance permMvPolynomialSMulCommClass (σ : Type*) (K : Type*)
    [CommSemiring K] : SMulCommClass (Equiv.Perm σ) K (MvPolynomial σ K) where
  smul_comm e c p := by
    show rename (e : σ → σ) (c • p) = c • rename (e : σ → σ) p
    rw [map_smul]

noncomputable scoped instance permSymmetricRationalFieldSMulCommClass (K : Type*) [Field K]
    (d : ℕ) : SMulCommClass (Equiv.Perm (Fin d)) K (SymmetricRationalField K d) :=
  IsFractionRing.smulCommClass (Equiv.Perm (Fin d)) K (MvPolynomial (Fin d) K) K
    (SymmetricRationalField K d)

/-- A permutation as an algebra automorphism of the rational function field over the constants. -/
noncomputable def permAlgEquiv (K : Type*) [Field K] (d : ℕ) (e : Equiv.Perm (Fin d)) :
    SymmetricRationalField K d ≃ₐ[K] SymmetricRationalField K d :=
  MulSemiringAction.toAlgEquiv K (SymmetricRationalField K d) e

@[simp]
theorem permAlgEquiv_apply (e : Equiv.Perm (Fin d)) (z : SymmetricRationalField K d) :
    permAlgEquiv K d e z = e • z := rfl

/-! ## The centered field -/

variable [CharZero K]

/-- The field generated by the centered roots over the constants. -/
noncomputable def centeredField (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    IntermediateField K (SymmetricRationalField K d) :=
  IntermediateField.adjoin K (Set.range (centeredRoot K d))

theorem centeredRoot_mem_centeredField (i : Fin d) :
    centeredRoot K d i ∈ centeredField K d :=
  IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩

/-- **The centered field is stable under permuting the variables.** -/
theorem centeredField_map (e : Equiv.Perm (Fin d)) :
    (centeredField K d).map (permAlgEquiv K d e).toAlgHom = centeredField K d := by
  rw [centeredField, IntermediateField.adjoin_map]
  congr 1
  rw [← Set.range_comp]
  have hcomp : ⇑(permAlgEquiv K d e).toAlgHom ∘ centeredRoot K d =
      centeredRoot K d ∘ ⇑e := by
    funext i
    exact smul_centeredRoot e i
  rw [hcomp]
  rw [Set.range_comp, e.range_eq_univ, Set.image_univ]

/-! ## The action on the centered field -/

theorem smul_mem_centeredField (e : Equiv.Perm (Fin d)) {x : SymmetricRationalField K d}
    (hx : x ∈ centeredField K d) : e • x ∈ centeredField K d := by
  have h : (permAlgEquiv K d e) x ∈
      (centeredField K d).map (permAlgEquiv K d e).toAlgHom := ⟨x, hx, rfl⟩
  rw [centeredField_map] at h
  exact h

noncomputable scoped instance centeredFieldAction (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    MulSemiringAction (Equiv.Perm (Fin d)) (centeredField K d) where
  smul e x := ⟨e • (x : SymmetricRationalField K d), smul_mem_centeredField e x.2⟩
  one_smul _ := Subtype.ext (one_smul _ _)
  mul_smul _ _ _ := Subtype.ext (mul_smul _ _ _)
  smul_zero e := Subtype.ext (smul_zero e)
  smul_add e _ _ := Subtype.ext (smul_add e _ _)
  smul_one e := Subtype.ext (smul_one e)
  smul_mul e _ _ := Subtype.ext (smul_mul' e _ _)

@[simp]
theorem coe_smul_centeredField (e : Equiv.Perm (Fin d)) (x : centeredField K d) :
    ((e • x : centeredField K d) : SymmetricRationalField K d) =
      e • (x : SymmetricRationalField K d) := rfl

noncomputable scoped instance centeredFieldFaithful (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    FaithfulSMul (Equiv.Perm (Fin d)) (centeredField K d) where
  eq_of_smul_eq_smul {a b} h := by
    refine Equiv.ext fun i => ?_
    have hi := h ⟨centeredRoot K d i, centeredRoot_mem_centeredField i⟩
    have hval : a • centeredRoot K d i = b • centeredRoot K d i := Subtype.ext_iff.1 hi
    rw [smul_centeredRoot, smul_centeredRoot] at hval
    exact centeredRoot_injective hval

/-- The part of the centered field fixed by the symmetric group. -/
noncomputable def centeredSymmetricPart (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    Subfield (centeredField K d) :=
  FixedPoints.subfield (Equiv.Perm (Fin d)) (centeredField K d)

/-- **Artin's theorem for the centered field.**  The field generated by the centered roots has
degree `d!` over the part fixed by the symmetric group. -/
theorem finrank_centeredSymmetricPart (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    Module.finrank (centeredSymmetricPart K d) (centeredField K d) = Nat.factorial d := by
  rw [centeredSymmetricPart, FixedPoints.finrank_eq_card, Fintype.card_perm, Fintype.card_fin]

end GaloisForLFunctions.HTGeometry
