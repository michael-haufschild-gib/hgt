/-
# The divisor of a linear polynomial is birational to the coefficient spectrum

A polynomial of degree one in one variable, `C a * X + C b` with `a ≠ 0`, has the single root
`-b/a` in the fraction field of the coefficient ring.  When it is primitive, Gauss's lemma turns
divisibility in the fraction field into divisibility in the coefficient ring, so the kernel of
evaluation at that root is exactly the ideal it generates.  Consequently the residue ring of its
divisor embeds in the fraction field of the coefficients, and — since that fraction field is already
generated by the coefficient ring — the divisor is birational to the coefficient spectrum.

This is the algebraic form of "the ramification divisor maps birationally onto the branch divisor":
a residue degree of one, for a divisorial valuation cut out by a polynomial that is linear in its
marked coordinate.

Main results:
* `ker_aeval_linearRoot` — **the kernel of evaluation at the root is the principal ideal**.
* `injective_quotient_lift_aeval_linearRoot` — the residue ring embeds in the fraction field.
-/
import Mathlib

open Polynomial

namespace GaloisForLFunctions.HTGeometry

set_option linter.unusedSectionVars false

noncomputable section

variable {S : Type*} [CommRing S] [IsDomain S] [IsGCDMonoid S]
variable (F : Type*) [Field F] [Algebra S F] [IsFractionRing S F]

/-- The root in the fraction field of a linear polynomial with nonzero leading coefficient. -/
def linearRoot (a b : S) : F := -(algebraMap S F b) / (algebraMap S F a)

theorem aeval_linearRoot {a b : S} (ha : a ≠ 0) :
    Polynomial.aeval (linearRoot F a b) (Polynomial.C a * Polynomial.X + Polynomial.C b)
      = (0 : F) := by
  have haF : algebraMap S F a ≠ 0 := by
    simpa using (IsFractionRing.to_map_eq_zero_iff (R := S) (K := F) (x := a)).not.mpr ha
  simp only [map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, linearRoot]
  field_simp
  ring

/-- **The kernel of evaluation at the root of a primitive linear polynomial is the ideal it
generates.**  Gauss's lemma turns divisibility in the fraction field into divisibility in the
coefficient ring. -/
theorem ker_aeval_linearRoot {a b : S} (ha : a ≠ 0)
    (hprim : (Polynomial.C a * Polynomial.X + Polynomial.C b).IsPrimitive) :
    RingHom.ker ((Polynomial.aeval (linearRoot F a b) :
        Polynomial S →ₐ[S] F) : Polynomial S →+* F)
      = Ideal.span {Polynomial.C a * Polynomial.X + Polynomial.C b} := by
  classical
  have haF : algebraMap S F a ≠ 0 := by
    simpa using (IsFractionRing.to_map_eq_zero_iff (R := S) (K := F) (x := a)).not.mpr ha
  set g : Polynomial S := Polynomial.C a * Polynomial.X + Polynomial.C b with hg
  have hgmap : g.map (algebraMap S F)
      = Polynomial.C (algebraMap S F a) * (Polynomial.X - Polynomial.C (linearRoot F a b)) := by
    rw [hg]
    ext k
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
      mul_sub, Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_C_mul,
      Polynomial.coeff_X, Polynomial.coeff_C]
    rcases k with _ | k
    · simp only [linearRoot, if_neg (by omega : ¬ (1 = 0)), if_pos trivial]
      field_simp
      ring
    · rcases k with _ | k <;> simp
  refine le_antisymm ?_ ?_
  · intro p hp
    have hroot : (p.map (algebraMap S F)).IsRoot (linearRoot F a b) := by
      have := hp
      rw [RingHom.mem_ker] at this
      simpa [Polynomial.eval_map, Polynomial.aeval_def] using this
    have hdvd : (Polynomial.X - Polynomial.C (linearRoot F a b)) ∣ p.map (algebraMap S F) :=
      (Polynomial.dvd_iff_isRoot).mpr hroot
    have hunit : IsUnit (Polynomial.C (algebraMap S F a)) :=
      Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr haF)
    have hgdvd : g.map (algebraMap S F) ∣ p.map (algebraMap S F) := by
      rw [hgmap]
      exact (IsUnit.mul_left_dvd hunit).mpr hdvd
    have := (hprim.dvd_iff_fraction_map_dvd_fraction_map F).mpr hgdvd
    rw [Ideal.mem_span_singleton]
    exact this
  · rw [Ideal.span_le]
    rintro q hq
    rw [Set.mem_singleton_iff] at hq
    subst hq
    rw [SetLike.mem_coe, RingHom.mem_ker]
    exact aeval_linearRoot F ha

/-- **The quotient by a primitive linear polynomial embeds in the fraction field.**  Together with
`IsFractionRing S F` this says the residue ring of the divisor of `C a * X + C b` has fraction field
`F` itself: the divisor maps birationally to the coefficient spectrum. -/
theorem injective_quotient_lift_aeval_linearRoot {a b : S} (ha : a ≠ 0)
    (hprim : (Polynomial.C a * Polynomial.X + Polynomial.C b).IsPrimitive) :
    Function.Injective (Ideal.Quotient.lift
      (Ideal.span {Polynomial.C a * Polynomial.X + Polynomial.C b})
      ((Polynomial.aeval (linearRoot F a b) : Polynomial S →ₐ[S] F) : Polynomial S →+* F)
      (fun p hp => by
        rw [← RingHom.mem_ker, ker_aeval_linearRoot F ha hprim]
        exact hp)) := by
  intro z w hzw
  have hz : Ideal.Quotient.lift
      (Ideal.span {Polynomial.C a * Polynomial.X + Polynomial.C b})
      ((Polynomial.aeval (linearRoot F a b) : Polynomial S →ₐ[S] F) : Polynomial S →+* F)
      (fun p hp => by
        rw [← RingHom.mem_ker, ker_aeval_linearRoot F ha hprim]
        exact hp) (z - w) = 0 := by
    rw [map_sub, hzw, sub_self]
  have hzero : z - w = 0 := by
    revert hz
    generalize hd : z - w = d
    intro hz
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective d
    rw [Ideal.Quotient.lift_mk] at hz
    rw [Ideal.Quotient.eq_zero_iff_mem, ← ker_aeval_linearRoot F ha hprim, RingHom.mem_ker]
    exact hz
  exact sub_eq_zero.mp hzero

end

end GaloisForLFunctions.HTGeometry
