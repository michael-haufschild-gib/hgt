import GaloisForLFunctions.HTGeometry.FreeDifferentialLinearAction
import GaloisForLFunctions.HTGeometry.ScalarEigenDifferentialTorsor

/-!
# The abstract tail of a linear symmetry depends only on the representation

The differential field freely generated by a generic vector, together with the automorphisms
induced by a finite linear symmetry group and by a commuting invertible endomorphism, is
determined by the linear data alone: two freely generated palettes whose symmetry groups and
endomorphisms are conjugate by one invertible constant matrix carry isomorphic fixed fields with
intertwined endomorphisms.

Two consequences: a trivial symmetry group leaves the whole free differential field, with the
endomorphism scaling every coordinate; and the sign involution on a single generic coordinate has
the square of that coordinate as its exact fixed field, on which the scaling endomorphism acts by
the square of the scalar.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Matrix

noncomputable section

variable {F K L ι : Type*} [Field F] [Field K] [Field L]
  [Algebra F K] [Algebra F L] [Differential F] [Differential K] [Differential L]
  [DifferentialAlgebra F K] [DifferentialAlgebra F L] [Fintype ι] [DecidableEq ι]

section NoHair

variable (x : ι → K) (hx : DifferentialIndependent F x)
  (hgen : differentialAdjoin F (Set.range x) = ⊤)
  (y : ι → L) (hy : DifferentialIndependent F y)
  (hygen : differentialAdjoin F (Set.range y) = ⊤)
  (hconst : ∀ c : F, c′ = 0)

include hx hy hgen hygen hconst in
/-- The comparison equivalence attached to an invertible constant matrix: it carries the palette
of the source to the recombined palette of the target. -/
theorem exists_tailComparison (phi : (Matrix ι ι F)ˣ) :
    ∃ Phi : K ≃ₐ[F] L, (∀ z, Phi z′ = (Phi z)′) ∧
      ∀ i, Phi (x i) = matrixLinearForms (phi : Matrix ι ι F) y i := by
  have hy' : DifferentialIndependent F (matrixLinearForms (phi : Matrix ι ι F) y) :=
    differentialIndependent_matrixLinearForms_units y hy hconst phi
  have hy'gen : differentialAdjoin F
      (Set.range (matrixLinearForms (phi : Matrix ι ι F) y)) = ⊤ :=
    differentialAdjoin_range_matrixLinearForms_units_eq_top y hygen phi
  refine ⟨differentialIndependentTopAlgEquiv x (matrixLinearForms (phi : Matrix ι ι F) y)
      hx hy' hgen hy'gen, ?_, ?_⟩
  · exact differentialIndependentTopAlgEquiv_deriv _ _ _ _ _ _
  · exact fun i => differentialIndependentTopAlgEquiv_apply _ _ _ _ _ _ i

include hx hy hgen hygen hconst in
/-- **Conjugate linear data give intertwined tail automorphisms.**  If a comparison equivalence
carries the source palette to the `phi`-recombination of the target palette, then it intertwines
the automorphisms of any pair of matrices conjugate by `phi`. -/
theorem tailComparison_intertwine {Phi : K ≃ₐ[F] L} (hderiv : ∀ z, Phi z′ = (Phi z)′)
    {phi : (Matrix ι ι F)ˣ} (hPhi : ∀ i, Phi (x i) = matrixLinearForms (phi : Matrix ι ι F) y i)
    {M M' : (Matrix ι ι F)ˣ}
    (hM : (M : Matrix ι ι F) * (phi : Matrix ι ι F)
      = (phi : Matrix ι ι F) * (M' : Matrix ι ι F)) (z : K) :
    Phi (matrixTailEquiv x hx hgen hconst M z)
      = matrixTailEquiv y hy hygen hconst M' (Phi z) := by
  have hfg : (Phi.toAlgHom.comp (matrixTailEquiv x hx hgen hconst M).toAlgHom)
      = ((matrixTailEquiv y hy hygen hconst M').toAlgHom.comp Phi.toAlgHom) := by
    refine differentialAlgHom_ext_of_differentialAdjoin_eq_top x hgen _ _ ?_ ?_ ?_
    · intro w
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [matrixTailEquiv_deriv, hderiv]
    · intro w
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [hderiv, matrixTailEquiv_deriv]
    · intro i
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      rw [matrixTailEquiv_apply, hPhi, matrixLinearForms, matrixLinearForms, map_sum, map_sum]
      have hleft : ∀ j : ι, Phi (algebraMap F K ((M : Matrix ι ι F) i j) * x j)
          = algebraMap F L ((M : Matrix ι ι F) i j)
            * matrixLinearForms (phi : Matrix ι ι F) y j := by
        intro j
        rw [map_mul, AlgEquiv.commutes, hPhi]
      have hright : ∀ j : ι, matrixTailEquiv y hy hygen hconst M'
            (algebraMap F L ((phi : Matrix ι ι F) i j) * y j)
          = algebraMap F L ((phi : Matrix ι ι F) i j)
            * matrixLinearForms (M' : Matrix ι ι F) y j := by
        intro j
        rw [map_mul, AlgEquiv.commutes, matrixTailEquiv_apply]
      simp only [hleft, hright]
      have hL : ∀ j : ι, algebraMap F L ((M : Matrix ι ι F) i j)
          * matrixLinearForms (phi : Matrix ι ι F) y j
          = algebraMap F L ((M : Matrix ι ι F) i j) * matrixLinearForms _ y j := fun j => rfl
      have hstep : matrixLinearForms ((M : Matrix ι ι F) * (phi : Matrix ι ι F)) y i
          = matrixLinearForms ((phi : Matrix ι ι F) * (M' : Matrix ι ι F)) y i := by
        rw [hM]
      rw [matrixLinearForms_mul, matrixLinearForms_mul] at hstep
      simpa [matrixLinearForms, hL] using hstep
  exact AlgHom.congr_fun hfg z

include hx hy hgen hygen hconst in
/-- **Abstract tail no-hair theorem.**  Linearly equivalent symmetry data produce isomorphic
tail fields with intertwined endomorphisms, whatever the ambient differential fields are. -/
theorem tail_no_hair {G : Type*} [Group G] (phi : (Matrix ι ι F)ˣ)
    (rho rho' : G →* (Matrix ι ι F)ˣ)
    (hrho : ∀ g, rho g * phi = phi * rho' g)
    (A A' : (Matrix ι ι F)ˣ) (hA : A * phi = phi * A') :
    ∃ Phi : K ≃ₐ[F] L, (∀ z, Phi z′ = (Phi z)′) ∧
      (tailFixedField x hx hgen hconst rho).map Phi.toAlgHom
        = tailFixedField y hy hygen hconst rho' ∧
      ∀ z, Phi (matrixTailEquiv x hx hgen hconst A z)
        = matrixTailEquiv y hy hygen hconst A' (Phi z) := by
  obtain ⟨Phi, hderiv, hPhi⟩ := exists_tailComparison x hx hgen y hy hygen hconst phi
  have hconj : ∀ M M' : (Matrix ι ι F)ˣ, M * phi = phi * M' →
      ∀ z, Phi (matrixTailEquiv x hx hgen hconst M z)
        = matrixTailEquiv y hy hygen hconst M' (Phi z) := by
    intro M M' hM z
    refine tailComparison_intertwine x hx hgen y hy hygen hconst hderiv hPhi ?_ z
    exact congrArg (Units.val) hM
  have hinv : ∀ g : G, (rho g)⁻¹ * phi = phi * (rho' g)⁻¹ := by
    intro g
    have h := hrho g
    calc (rho g)⁻¹ * phi = (rho g)⁻¹ * (phi * rho' g) * (rho' g)⁻¹ := by group
      _ = (rho g)⁻¹ * (rho g * phi) * (rho' g)⁻¹ := by rw [h]
      _ = phi * (rho' g)⁻¹ := by group
  refine ⟨Phi, hderiv, ?_, hconj A A' hA⟩
  ext w
  rw [mem_map_algEquiv_iff Phi, mem_tailFixedField_iff, mem_tailFixedField_iff]
  simp only [tailRepresentation_eq]
  constructor
  · intro h g
    have hstep := hconj ((rho g)⁻¹) ((rho' g)⁻¹) (hinv g) (Phi.symm w)
    rw [h g, Phi.apply_symm_apply] at hstep
    exact hstep.symm
  · intro h g
    have hstep := hconj ((rho g)⁻¹) ((rho' g)⁻¹) (hinv g) (Phi.symm w)
    rw [Phi.apply_symm_apply, h g] at hstep
    exact Phi.injective (by rw [hstep, Phi.apply_symm_apply])

end NoHair

section Scalar

/-- The invertible scalar matrix of a unit. -/
def scalarUnit (m : Fˣ) : (Matrix ι ι F)ˣ where
  val := Matrix.scalar ι (m : F)
  inv := Matrix.scalar ι ((m⁻¹ : Fˣ) : F)
  val_inv := by rw [← map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, map_one]
  inv_val := by rw [← map_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one]

omit [Differential F] in
@[simp]
theorem scalarUnit_val (m : Fˣ) :
    ((scalarUnit (ι := ι) m : (Matrix ι ι F)ˣ) : Matrix ι ι F) = Matrix.scalar ι (m : F) := rfl

omit [Differential F] in
theorem scalarUnit_inv (m : Fˣ) : (scalarUnit (ι := ι) m)⁻¹ = scalarUnit (ι := ι) m⁻¹ := by
  refine Units.ext ?_
  rfl

omit [Differential F] [Differential K] [DifferentialAlgebra F K] in
theorem matrixLinearForms_scalar (m : F) (x : ι → K) (i : ι) :
    matrixLinearForms (Matrix.scalar ι m) x i = algebraMap F K m * x i := by
  rw [matrixLinearForms, Finset.sum_eq_single i]
  · rw [Matrix.scalar_apply, Matrix.diagonal_apply_eq]
  · intro j _ hj
    rw [Matrix.scalar_apply, Matrix.diagonal_apply_ne _ (Ne.symm hj), map_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ i) h

variable (x : ι → K) (hx : DifferentialIndependent F x)
  (hgen : differentialAdjoin F (Set.range x) = ⊤) (hconst : ∀ c : F, c′ = 0)

@[simp]
theorem matrixTailEquiv_scalarUnit_apply (m : Fˣ) (i : ι) :
    matrixTailEquiv x hx hgen hconst (scalarUnit m) (x i) = algebraMap F K (m : F) * x i := by
  rw [matrixTailEquiv_apply, scalarUnit_val, matrixLinearForms_scalar]

include hx hgen hconst in
/-- **Universal multiplication tail.**  A trivial symmetry group leaves the whole freely generated
differential field. -/
theorem tailFixedField_of_trivial {G : Type*} [Group G] (rho : G →* (Matrix ι ι F)ˣ)
    (hrho : ∀ g, rho g = 1) : tailFixedField x hx hgen hconst rho = ⊤ := by
  refine eq_top_iff.mpr fun z _ => ?_
  refine (mem_tailFixedField_iff x hx hgen hconst rho z).mpr fun g => ?_
  rw [hrho g, map_one]
  rfl

end Scalar

section Involution

omit [Differential F] [DifferentialAlgebra F K] in
/-- In characteristic not two the sign is a unit of order two. -/
theorem orderOf_neg_one_units (hF : (2 : F) ≠ 0) : orderOf (-1 : Fˣ) = 2 := by
  refine orderOf_eq_prime ?_ ?_
  · rw [← Units.val_eq_one]
    push_cast
    norm_num
  · intro h
    apply hF
    have hval : ((-1 : Fˣ) : F) = ((1 : Fˣ) : F) := congrArg Units.val h
    push_cast at hval
    linear_combination -hval

omit [Differential F] [DifferentialAlgebra F K] in
/-- A hypertranscendental element is a differentially independent one-element palette. -/
theorem differentialIndependent_const_unit (v : K) (hv : HypertranscendentalOver F v) :
    DifferentialIndependent F (fun _ : Unit => v) :=
  (hypertranscendentalOver_iff_differentialIndependent_singleton F v).mp hv

omit [Differential F] [DifferentialAlgebra F K] in
/-- A generating element is a generating one-element palette. -/
theorem differentialAdjoin_range_const_unit (v : K)
    (hgenv : differentialAdjoin F ({v} : Set K) = ⊤) :
    differentialAdjoin F (Set.range (fun _ : Unit => v)) = ⊤ := by
  rw [Set.range_const]
  exact hgenv

/-- The scaling endomorphism acts on the invariant square coordinate by the square of the
scalar. -/
theorem matrixTailEquiv_scalarUnit_sq (v : K) (hv : HypertranscendentalOver F v)
    (hgenv : differentialAdjoin F ({v} : Set K) = ⊤) (hconst : ∀ c : F, c′ = 0) (m : Fˣ) :
    matrixTailEquiv (fun _ : Unit => v) (differentialIndependent_const_unit v hv)
        (differentialAdjoin_range_const_unit v hgenv) hconst (scalarUnit m) (v ^ 2)
      = algebraMap F K ((m : F) ^ 2) * v ^ 2 := by
  have happ := matrixTailEquiv_scalarUnit_apply (fun _ : Unit => v)
    (differentialIndependent_const_unit v hv)
    (differentialAdjoin_range_const_unit v hgenv) hconst m ()
  rw [pow_two, map_mul, happ, map_pow, pow_two]
  ring

variable [CharZero F] [CharZero K]

variable (v : K) (hv : HypertranscendentalOver F v) (hv0 : v ≠ 0)
  (hgenv : differentialAdjoin F ({v} : Set K) = ⊤) (hconst : ∀ c : F, c′ = 0)

include hv hv0 hgenv hconst in
/-- **Flexible Lattes no-hair corollary.**  The sign involution of a single generic differential
coordinate has exactly the differential field of its square as fixed field, and the scaling
endomorphism acts on that square by the square of the scalar. -/
theorem tailFixedField_sign_involution :
    IntermediateField.fixedField (Subgroup.zpowers
        (matrixTailEquiv (fun _ : Unit => v) (differentialIndependent_const_unit v hv)
          (differentialAdjoin_range_const_unit v hgenv) hconst (scalarUnit (-1))))
      = differentialAdjoin F ({v ^ 2} : Set K) := by
  set hx := differentialIndependent_const_unit v hv with hxdef
  set hgen := differentialAdjoin_range_const_unit v hgenv with hgendef
  set sigma : DifferentialAlgEquiv F K :=
    matrixTailDifferentialAlgEquiv (fun _ : Unit => v) hx hgen hconst (scalarUnit (-1))
    with hsigma
  have hF2 : (2 : F) ≠ 0 := two_ne_zero
  have hval : sigma.toAlgEquiv v = v * algebraMap F K ((-1 : Fˣ) : F) := by
    have happ := matrixTailEquiv_scalarUnit_apply (fun _ : Unit => v) hx hgen hconst
      (-1 : Fˣ) ()
    rw [hsigma, matrixTailDifferentialAlgEquiv_toAlgEquiv]
    rw [happ, mul_comm]
  exact DifferentialAlgEquiv.fixedField_zpowers_of_unit_eigenvector_of_finite_order
    sigma v hv hv0 hgenv (-1 : Fˣ) hconst hval (by norm_num) (orderOf_neg_one_units hF2)

end Involution

end

end GaloisForLFunctions.HTGeometry
