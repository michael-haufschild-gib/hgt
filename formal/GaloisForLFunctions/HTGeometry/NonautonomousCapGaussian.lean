import GaloisForLFunctions.HTGeometry.GaussianExponentialCompositionField

/-!
# Breaking autonomy restores the primitive state

The nonautonomous first-order entire cap `B(w) = w exp w` satisfies `w B′(w) = (w + 1) B(w)` and has
minimal differential order one, like the exponential.  Applied to the Gaussian primitive `G` it
produces `Q = G Y` with `Y = exp G`, and the logarithmic derivative `q = Q′/Q` obeys

`q G = E (1 + G)`,  `a := q′ + 2z q = −(q − E)²`,  `a (1 + G)² = −q²`,

so `G`, then `E` and `Y`, are algebraic over the differential field generated by `Q`.  Since the four
states `z, E, G, Y` are algebraically independent, the jet field of `Q` has transcendence degree
four: `ord_DA (B ∘ G) = 3`, against `ord_DA (exp ∘ G) = 2` for the autonomous cap on the same input.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open scoped Differential

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

/-! ### Nonvanishing of the Gaussian primitive shifted by a constant -/

theorem deriv_zero_meroField : (0 : meroField (Set.univ : Set ℂ))′ = 0 :=
  (meroComplexDerivation_apply 0).symm.trans (map_zero meroComplexDerivation)

theorem deriv_const_add_gaussPrimElem (c : ℂ) :
    (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c + gaussPrimElem)′ = gaussElem := by
  have h1 : meroComplexDerivation (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c + gaussPrimElem)
      = meroComplexDerivation (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)
        + meroComplexDerivation gaussPrimElem := map_add _ _ _
  simp only [meroComplexDerivation_apply] at h1
  rw [h1, deriv_complexConst, zero_add, deriv_gaussPrimElem]

/-- A constant shift of the Gaussian primitive is never zero: its derivative is the Gaussian
exponential, which is nonzero. -/
theorem const_add_gaussPrimElem_ne_zero (c : ℂ) :
    algebraMap ℂ (meroField (Set.univ : Set ℂ)) c + gaussPrimElem ≠ 0 := by
  intro h
  have hd := deriv_const_add_gaussPrimElem c
  rw [h, deriv_zero_meroField] at hd
  exact gaussElem_ne_zero hd.symm

theorem gaussPrimElem_ne_zero : gaussPrimElem ≠ 0 := by
  have h := const_add_gaussPrimElem_ne_zero 0
  rw [map_zero, zero_add] at h
  exact h

theorem one_add_gaussPrimElem_ne_zero :
    (1 : meroField (Set.univ : Set ℂ)) + gaussPrimElem ≠ 0 := by
  have h := const_add_gaussPrimElem_ne_zero 1
  rwa [map_one] at h

theorem two_add_gaussPrimElem_ne_zero :
    (2 : meroField (Set.univ : Set ℂ)) + gaussPrimElem ≠ 0 := by
  have h := const_add_gaussPrimElem_ne_zero 2
  rwa [map_ofNat] at h

theorem deriv_gaussElem_coord :
    gaussElem′ = -((2 : meroField (Set.univ : Set ℂ)) * coordElem) * gaussElem := by
  rw [deriv_gaussElem, algebraMap_gaussLogDeriv_eq]
  have hneg : algebraMap ℂ (meroField (Set.univ : Set ℂ)) (-2 : ℂ)
      = -(2 : meroField (Set.univ : Set ℂ)) := by
    rw [show (-2 : ℂ) = -(2 : ℂ) by norm_num, map_neg, map_ofNat]
  rw [hneg]
  ring

theorem deriv_one_add_gaussPrimElem :
    ((1 : meroField (Set.univ : Set ℂ)) + gaussPrimElem)′ = gaussElem := by
  have h := deriv_const_add_gaussPrimElem 1
  rwa [map_one] at h

/-! ### The nonautonomous composite -/

/-- The composite `B ∘ G` for the nonautonomous cap `B(w) = w exp w`. -/
def prodQ : ℂ → ℂ := fun z : ℂ => gaussPrimitive z * Complex.exp (gaussPrimitive z)

theorem differentiable_prodQ : Differentiable ℂ prodQ :=
  differentiable_gaussPrimitive.mul differentiable_expGauss

theorem jetElem_prodQ_zero :
    jetElem differentiable_prodQ 0 = gaussPrimElem * gaussExpElem := by
  rw [jetElem, gaussPrimElem, gaussExpElem,
    ← analyticMeroElement_mul analyticOnNhd_gaussPrimitive analyticOnNhd_expGauss]
  refine analyticMeroElement_congr _ _ ?_
  rw [iteratedDeriv_zero]
  rfl

theorem prodQElem_ne_zero : jetElem differentiable_prodQ 0 ≠ 0 := by
  rw [jetElem_prodQ_zero]
  exact mul_ne_zero gaussPrimElem_ne_zero gaussExpElem_ne_zero

theorem deriv_prodQElem :
    (jetElem differentiable_prodQ 0)′
      = gaussElem * gaussExpElem * (1 + gaussPrimElem) := by
  rw [jetElem_prodQ_zero, differential_deriv_mul, deriv_gaussPrimElem, deriv_gaussExpElem]
  ring

/-! ### The jet field of the composite -/

/-- The jet field of an entire function is closed under the derivation. -/
theorem derivationClosed_jetField {u : ℂ → ℂ} (hu : Differentiable ℂ u) :
    DerivationClosed (IntermediateField.adjoin ℂ
      (insert coordElem (Set.range fun k : ℕ => jetElem hu k))) := by
  set S : Set (meroField (Set.univ : Set ℂ)) :=
    insert coordElem (Set.range fun k : ℕ => jetElem hu k) with hS
  have hbase : ∀ c : ℂ, (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)′
      ∈ IntermediateField.adjoin ℂ S := by
    intro c
    rw [deriv_complexConst]
    exact zero_mem _
  have hgen : ∀ x ∈ S, x ∈ IntermediateField.adjoin ℂ S ∧ x′ ∈ IntermediateField.adjoin ℂ S := by
    rintro x (rfl | ⟨k, rfl⟩)
    · exact ⟨IntermediateField.subset_adjoin ℂ S (Set.mem_insert _ _), by
        rw [deriv_coordElem]; exact one_mem _⟩
    · refine ⟨IntermediateField.subset_adjoin ℂ S (Set.mem_insert_of_mem _ ⟨k, rfl⟩), ?_⟩
      have hstep : (jetElem hu k)′ = jetElem hu (k + 1) := (jetElem_succ_eq_deriv hu k).symm
      rw [hstep]
      exact IntermediateField.subset_adjoin ℂ S (Set.mem_insert_of_mem _ ⟨k + 1, rfl⟩)
  intro x hx
  have hle := adjoin_le_derivStableField (C := ℂ)
    (L := IntermediateField.adjoin ℂ S) (hbase := hbase) hgen
  exact (mem_derivStableField_iff.mp (hle hx)).2

/-- The jet field of the composite. -/
def prodQField : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
  IntermediateField.adjoin ℂ
    (insert coordElem (Set.range fun k : ℕ => jetElem differentiable_prodQ k))

theorem coordElem_mem_prodQField : coordElem ∈ prodQField :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

theorem jetElem_mem_prodQField (k : ℕ) : jetElem differentiable_prodQ k ∈ prodQField :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨k, rfl⟩)

theorem derivationClosed_prodQField : DerivationClosed prodQField :=
  derivationClosed_jetField differentiable_prodQ

theorem ofNat_mem_prodQField : (2 : meroField (Set.univ : Set ℂ)) ∈ prodQField := by
  have h2 : (2 : meroField (Set.univ : Set ℂ))
      = algebraMap ℂ (meroField (Set.univ : Set ℂ)) (2 : ℂ) := (map_ofNat _ 2).symm
  rw [h2]
  exact IntermediateField.algebraMap_mem _ _

/-! ### The logarithmic derivative and its companion -/

/-- The logarithmic derivative of the composite. -/
def logQ : meroField (Set.univ : Set ℂ) :=
  (jetElem differentiable_prodQ 1) / (jetElem differentiable_prodQ 0)

/-- The companion element `q′ + 2z q`. -/
def compQ : meroField (Set.univ : Set ℂ) :=
  logQ′ + (2 : meroField (Set.univ : Set ℂ)) * coordElem * logQ

theorem logQ_mem_prodQField : logQ ∈ prodQField :=
  IntermediateField.div_mem _ (jetElem_mem_prodQField 1) (jetElem_mem_prodQField 0)

theorem compQ_mem_prodQField : compQ ∈ prodQField := by
  refine IntermediateField.add_mem _ (derivationClosed_prodQField logQ_mem_prodQField) ?_
  exact IntermediateField.mul_mem _
    (IntermediateField.mul_mem _ ofNat_mem_prodQField coordElem_mem_prodQField)
    logQ_mem_prodQField

/-! ### The recovery identities -/

theorem logQ_mul_gaussPrimElem :
    logQ * gaussPrimElem = gaussElem * (1 + gaussPrimElem) := by
  have hjet1 : jetElem differentiable_prodQ 1 = (jetElem differentiable_prodQ 0)′ :=
    jetElem_succ_eq_deriv differentiable_prodQ 0
  have hq : logQ * jetElem differentiable_prodQ 0 = (jetElem differentiable_prodQ 0)′ := by
    rw [logQ, hjet1]
    exact div_mul_cancel₀ _ prodQElem_ne_zero
  rw [deriv_prodQElem, jetElem_prodQ_zero] at hq
  refine mul_right_cancel₀ gaussExpElem_ne_zero ?_
  linear_combination hq

theorem deriv_logQ_mul :
    logQ′ * gaussPrimElem + logQ * gaussElem
      = -((2 : meroField (Set.univ : Set ℂ)) * coordElem) * gaussElem * (1 + gaussPrimElem)
        + gaussElem * gaussElem := by
  have h : (logQ * gaussPrimElem)′ = (gaussElem * (1 + gaussPrimElem))′ := by
    rw [logQ_mul_gaussPrimElem]
  rw [differential_deriv_mul, differential_deriv_mul, deriv_gaussPrimElem,
    deriv_gaussElem_coord, deriv_one_add_gaussPrimElem] at h
  linear_combination h

theorem compQ_mul_gaussPrimElem :
    compQ * gaussPrimElem = gaussElem * (gaussElem - logQ) := by
  rw [compQ]
  linear_combination deriv_logQ_mul
    + ((2 : meroField (Set.univ : Set ℂ)) * coordElem) * logQ_mul_gaussPrimElem

theorem gaussElem_eq_mul : gaussElem = gaussPrimElem * (logQ - gaussElem) := by
  linear_combination -logQ_mul_gaussPrimElem

theorem compQ_eq : compQ = -((logQ - gaussElem) ^ 2) := by
  refine mul_right_cancel₀ gaussPrimElem_ne_zero ?_
  linear_combination compQ_mul_gaussPrimElem + (-(logQ - gaussElem)) * gaussElem_eq_mul

theorem logQ_ne_zero : logQ ≠ 0 := by
  intro h
  have hprod := logQ_mul_gaussPrimElem
  rw [h, zero_mul] at hprod
  exact mul_ne_zero gaussElem_ne_zero one_add_gaussPrimElem_ne_zero hprod.symm

theorem compQ_mul_one_add_sq :
    compQ * (1 + gaussPrimElem) ^ 2 = -(logQ ^ 2) := by
  have hfac : (logQ - gaussElem) * (1 + gaussPrimElem) = logQ := by
    linear_combination logQ_mul_gaussPrimElem
  calc compQ * (1 + gaussPrimElem) ^ 2
      = -(((logQ - gaussElem) * (1 + gaussPrimElem)) ^ 2) := by rw [compQ_eq]; ring
    _ = -(logQ ^ 2) := by rw [hfac]

theorem compQ_ne_zero : compQ ≠ 0 := by
  intro h
  have hkey := compQ_mul_one_add_sq
  rw [h, zero_mul] at hkey
  have hq2 : logQ ^ 2 = 0 := by linear_combination hkey
  exact logQ_ne_zero (pow_eq_zero_iff (two_ne_zero) |>.mp hq2)

theorem compQ_add_sq_mul :
    (compQ + logQ ^ 2) * gaussPrimElem
      = gaussElem ^ 2 * ((2 : meroField (Set.univ : Set ℂ)) + gaussPrimElem) := by
  linear_combination compQ_mul_gaussPrimElem
    + (logQ + gaussElem) * logQ_mul_gaussPrimElem

theorem compQ_add_sq_ne_zero : compQ + logQ ^ 2 ≠ 0 := by
  intro h
  have hkey := compQ_add_sq_mul
  rw [h, zero_mul] at hkey
  exact mul_ne_zero (pow_ne_zero 2 gaussElem_ne_zero) two_add_gaussPrimElem_ne_zero hkey.symm

/-! ### Everything is algebraic over the jet field of the composite -/

/-- A quadratic relation with coefficients in an intermediate field and nonzero leading coefficient
witnesses algebraicity. -/
theorem isAlgebraic_of_quadratic_mem {J : IntermediateField ℂ (meroField (Set.univ : Set ℂ))}
    {x a b c : meroField (Set.univ : Set ℂ)} (ha : a ∈ J) (hb : b ∈ J) (hc : c ∈ J)
    (ha0 : a ≠ 0) (h : a * x ^ 2 + b * x + c = 0) : IsAlgebraic ↥J x := by
  refine ⟨Polynomial.C (⟨a, ha⟩ : ↥J) * Polynomial.X ^ 2
    + Polynomial.C (⟨b, hb⟩ : ↥J) * Polynomial.X + Polynomial.C (⟨c, hc⟩ : ↥J), ?_, ?_⟩
  · intro hzero
    have hcoeff : (Polynomial.C (⟨a, ha⟩ : ↥J) * Polynomial.X ^ 2
        + Polynomial.C (⟨b, hb⟩ : ↥J) * Polynomial.X
        + Polynomial.C (⟨c, hc⟩ : ↥J)).coeff 2 = (⟨a, ha⟩ : ↥J) := by
      simp
    rw [hzero, Polynomial.coeff_zero] at hcoeff
    exact ha0 (congrArg Subtype.val hcoeff.symm)
  · simp only [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    exact h

theorem quadratic_gaussPrimElem :
    compQ * gaussPrimElem ^ 2 + 2 * compQ * gaussPrimElem + (compQ + logQ ^ 2) = 0 := by
  linear_combination compQ_mul_one_add_sq

theorem quadratic_gaussElem :
    1 * gaussElem ^ 2 + -(2 * logQ) * gaussElem + (logQ ^ 2 + compQ) = 0 := by
  linear_combination compQ_eq

theorem quadratic_gaussExpElem :
    (compQ + logQ ^ 2) * gaussExpElem ^ 2
      + 2 * compQ * jetElem differentiable_prodQ 0 * gaussExpElem
      + compQ * jetElem differentiable_prodQ 0 ^ 2 = 0 := by
  rw [jetElem_prodQ_zero]
  linear_combination (gaussExpElem ^ 2) * compQ_mul_one_add_sq

theorem isAlgebraic_gaussPrimElem_prodQField : IsAlgebraic ↥prodQField gaussPrimElem :=
  isAlgebraic_of_quadratic_mem compQ_mem_prodQField
    (IntermediateField.mul_mem _ ofNat_mem_prodQField compQ_mem_prodQField)
    (IntermediateField.add_mem _ compQ_mem_prodQField
      (IntermediateField.pow_mem _ logQ_mem_prodQField 2))
    compQ_ne_zero quadratic_gaussPrimElem

theorem isAlgebraic_gaussElem_prodQField : IsAlgebraic ↥prodQField gaussElem :=
  isAlgebraic_of_quadratic_mem (one_mem _)
    (IntermediateField.neg_mem _
      (IntermediateField.mul_mem _ ofNat_mem_prodQField logQ_mem_prodQField))
    (IntermediateField.add_mem _ (IntermediateField.pow_mem _ logQ_mem_prodQField 2)
      compQ_mem_prodQField)
    one_ne_zero quadratic_gaussElem

theorem isAlgebraic_gaussExpElem_prodQField : IsAlgebraic ↥prodQField gaussExpElem :=
  isAlgebraic_of_quadratic_mem
    (IntermediateField.add_mem _ compQ_mem_prodQField
      (IntermediateField.pow_mem _ logQ_mem_prodQField 2))
    (IntermediateField.mul_mem _
      (IntermediateField.mul_mem _ ofNat_mem_prodQField compQ_mem_prodQField)
      (jetElem_mem_prodQField 0))
    (IntermediateField.mul_mem _ compQ_mem_prodQField
      (IntermediateField.pow_mem _ (jetElem_mem_prodQField 0) 2))
    compQ_add_sq_ne_zero quadratic_gaussExpElem

/-! ### The rank of the nonautonomous composite -/

theorem jetElem_prodQ_mem_quadField (k : ℕ) :
    jetElem differentiable_prodQ k ∈ quadField := by
  induction k with
  | zero =>
      rw [jetElem_prodQ_zero]
      exact IntermediateField.mul_mem _ gaussPrimElem_mem_quadField gaussExpElem_mem_quadField
  | succ k ih =>
      rw [jetElem_succ_eq_deriv]
      exact derivationClosed_quadField ih

theorem prodQField_le_quadField : prodQField ≤ quadField := by
  rw [prodQField, IntermediateField.adjoin_le_iff]
  rintro y (rfl | ⟨k, rfl⟩)
  · exact coordElem_mem_quadField
  · exact jetElem_prodQ_mem_quadField _

/-- **The nonautonomous cap keeps all four states.** -/
theorem daRank_prodQ : daRank differentiable_prodQ = 4 := by
  have hAB : ∀ y : meroField (Set.univ : Set ℂ), y ∈ quadField → IsAlgebraic ↥prodQField y := by
    intro y hy
    refine isAlgebraic_of_adjoin_of_generators prodQField (insert gaussExpElem gaussTriple)
      ?_ hy
    rintro w (rfl | rfl | rfl | rfl)
    · exact isAlgebraic_gaussExpElem_prodQField
    · exact isAlgebraic_gaussPrimElem_prodQField
    · exact isAlgebraic_gaussElem_prodQField
    · exact isAlgebraic_algebraMap (⟨coordElem, coordElem_mem_prodQField⟩ : ↥prodQField)
  have hBA : ∀ y : meroField (Set.univ : Set ℂ), y ∈ prodQField → IsAlgebraic ↥quadField y := by
    intro y hy
    exact isAlgebraic_algebraMap (⟨y, prodQField_le_quadField hy⟩ : ↥quadField)
  have hEq := trdeg_eq_of_mutually_algebraic hAB hBA
  rw [daRank]
  exact hEq.symm.trans trdeg_quadField

/-- **Breaking autonomy restores the compressed primitive state.**  For the same inner function `G`,
the autonomous cap `exp` gives differential rank three and the nonautonomous cap `w ↦ w exp w` gives
differential rank four. -/
theorem nonautonomous_cap_restores_state :
    daRank differentiable_expGauss = 3 ∧ daRank differentiable_prodQ = 4 :=
  ⟨daRank_expGauss, daRank_prodQ⟩

end

