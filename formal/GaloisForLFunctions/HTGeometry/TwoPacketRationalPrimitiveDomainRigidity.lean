import GaloisForLFunctions.HTGeometry.TwoPacketRationalPrimitiveRigidity
import Mathlib.Tactic

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

/-- Every member of a field generated by an algebraically independent family is the evaluation
of a rational function in the corresponding free coordinates. -/
theorem exists_freeCoordinateEvalMap_eq_of_mem_adjoin
    {C E ι : Type*} [Field C] [Field E] [Algebra C E]
    (g : ι → E) (hg : AlgebraicIndependent C g) {z : E}
    (hz : z ∈ IntermediateField.adjoin C (Set.range g)) :
    ∃ F : FreeCoordinateRationalField C ι,
      freeCoordinateEvalMap g hg F = z := by
  let p : ∀ z : E, z ∈ IntermediateField.adjoin C (Set.range g) → Prop :=
    fun z _ => ∃ F : FreeCoordinateRationalField C ι,
      freeCoordinateEvalMap g hg F = z
  change p z hz
  refine IntermediateField.adjoin_induction C (p := p) ?_ ?_ ?_ ?_ ?_ hz
  · rintro _ ⟨i, rfl⟩
    exact ⟨freeCoordinate C ι i, freeCoordinateEvalMap_freeCoordinate g hg i⟩
  · intro c
    exact ⟨algebraMap C (FreeCoordinateRationalField C ι) c, by simp⟩
  · intro x y hx hy
    rintro ⟨F, rfl⟩ ⟨G, rfl⟩
    exact ⟨F + G, by simp⟩
  · intro x hx
    rintro ⟨F, rfl⟩
    exact ⟨F⁻¹, by simp⟩
  · intro x y hx hy
    rintro ⟨F, rfl⟩ ⟨G, rfl⟩
    exact ⟨F * G, by simp⟩

/-- Denominator-safe transport of one finite rational formation through a domain algebra map.
Algebraic independence of the target coordinates prevents the chosen denominator from vanishing. -/
theorem freeCoordinateEvalMap_eq_map_of_eq_algebraMap
    {C ι A L E : Type*} [Field C] [Fintype ι]
    [CommRing A] [IsDomain A] [Field L] [Field E]
    [Algebra C A] [Algebra A L] [Algebra C L] [IsScalarTower C A L]
    [IsFractionRing A L] [Algebra C E]
    (g : ι → A)
    (hg : AlgebraicIndependent C (fun i => algebraMap A L (g i)))
    (r : A →ₐ[C] E) (g' : ι → E) (hg' : AlgebraicIndependent C g')
    (hcoord : ∀ i, r (g i) = g' i)
    (F : FreeCoordinateRationalField C ι) (z : A)
    (hF : freeCoordinateEvalMap (fun i => algebraMap A L (g i)) hg F =
      algebraMap A L z) :
    freeCoordinateEvalMap g' hg' F = r z := by
  obtain ⟨P, Q, hQ, hrep⟩ :=
    IsFractionRing.div_surjective (MvPolynomial ι C) F
  have hsourceNaturality :
      ((IsScalarTower.toAlgHom C A L).comp (MvPolynomial.aeval g)) =
        MvPolynomial.aeval (fun i => algebraMap A L (g i)) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp
  have htargetNaturality :
      r.comp (MvPolynomial.aeval g) = MvPolynomial.aeval g' := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [hcoord]
  have hQ0 : Q ≠ 0 := by
    intro hzero
    have hone : (1 : MvPolynomial ι C) = 0 := hQ.1 1 (by simp [hzero])
    exact one_ne_zero hone
  have hsource : MvPolynomial.aeval g P = MvPolynomial.aeval g Q * z := by
    apply IsFractionRing.injective A L
    have hmap :
        MvPolynomial.aeval (fun i => algebraMap A L (g i)) P /
            MvPolynomial.aeval (fun i => algebraMap A L (g i)) Q =
          algebraMap A L z := by
      calc
        _ = freeCoordinateEvalMap (fun i => algebraMap A L (g i)) hg
            (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P /
              algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) Q) := by
                simp
        _ = freeCoordinateEvalMap (fun i => algebraMap A L (g i)) hg F := by
              rw [hrep]
        _ = algebraMap A L z := hF
    have hden : MvPolynomial.aeval (fun i => algebraMap A L (g i)) Q ≠ 0 :=
      fun hzero => hQ0 ((algebraicIndependent_iff_injective_aeval.mp hg)
        (by simpa using hzero))
    have hcleared := (div_eq_iff hden).mp hmap
    rw [map_mul]
    change (((IsScalarTower.toAlgHom C A L).comp (MvPolynomial.aeval g)) P) =
      (((IsScalarTower.toAlgHom C A L).comp (MvPolynomial.aeval g)) Q) *
        algebraMap A L z
    rw [hsourceNaturality]
    simpa [mul_comm] using hcleared
  have htarget := congrArg r hsource
  have hden' : MvPolynomial.aeval g' Q ≠ 0 :=
    fun hzero => hQ0 ((algebraicIndependent_iff_injective_aeval.mp hg')
      (by simpa using hzero))
  have hmap : MvPolynomial.aeval g' P / MvPolynomial.aeval g' Q =
      freeCoordinateEvalMap g' hg' F := by
    calc
      _ = freeCoordinateEvalMap g' hg'
          (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P /
            algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) Q) := by
              simp
      _ = freeCoordinateEvalMap g' hg' F := by rw [hrep]
  rw [← hmap, div_eq_iff hden']
  rw [← DFunLike.congr_fun htargetNaturality P,
    ← DFunLike.congr_fun htargetNaturality Q]
  change r (MvPolynomial.aeval g P) =
    r z * r (MvPolynomial.aeval g Q)
  simpa only [map_mul, mul_comm] using htarget

/-- Sums of corresponding coordinates from two jointly free packets remain algebraically
independent. -/
theorem algebraicIndependent_add_of_sum_elim
    {C E ι : Type*} [Field C] [Field E] [Algebra C E]
    (g₀ g₁ : ι → E)
    (hpacket : AlgebraicIndependent C (Sum.elim g₀ g₁)) :
    AlgebraicIndependent C (fun i => g₀ i + g₁ i) := by
  rw [algebraicIndependent_iff_injective_aeval]
  intro P Q hPQ
  apply freeCoordinateAddPolynomialMap_injective
  apply (algebraicIndependent_iff_injective_aeval.mp hpacket)
  have hnaturality :
      (MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
          (freeCoordinateAddPolynomialMap C ι) =
        MvPolynomial.aeval (fun i => g₀ i + g₁ i) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [freeCoordinateAddPolynomialMap]
  change (((MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
      (freeCoordinateAddPolynomialMap C ι)) P) =
    (((MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
      (freeCoordinateAddPolynomialMap C ι)) Q)
  rw [hnaturality]
  exact hPQ

theorem freeCoordinateEvalMap_addMap
    {C E ι : Type*} [Field C] [Field E] [Algebra C E]
    (g₀ g₁ : ι → E)
    (hpacket : AlgebraicIndependent C (Sum.elim g₀ g₁))
    (hsum : AlgebraicIndependent C (fun i => g₀ i + g₁ i)) :
    (freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateAddMap C ι) =
      freeCoordinateEvalMap (fun i => g₀ i + g₁ i) hsum := by
  have hRing :
      ((freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateAddMap C ι)).toRingHom =
      (freeCoordinateEvalMap (fun i => g₀ i + g₁ i) hsum).toRingHom := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (MvPolynomial ι C))
    apply RingHom.ext
    intro P
    change freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket
        (freeCoordinateAddMap C ι
          (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)) =
      freeCoordinateEvalMap (fun i => g₀ i + g₁ i) hsum
        (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)
    rw [freeCoordinateAddMap_algebraMap,
      freeCoordinateEvalMap_algebraMap, freeCoordinateEvalMap_algebraMap]
    have hnaturality :
        (MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
            (freeCoordinateAddPolynomialMap C ι) =
          MvPolynomial.aeval (fun i => g₀ i + g₁ i) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [freeCoordinateAddPolynomialMap]
    exact DFunLike.congr_fun hnaturality P
  apply DFunLike.ext _ _
  intro F
  exact congrArg (fun φ : FreeCoordinateRationalField C ι →+* E => φ F) hRing

theorem freeCoordinateEvalMap_leftMap
    {C E ι : Type*} [Field C] [Field E] [Algebra C E]
    (g₀ g₁ : ι → E)
    (hpacket : AlgebraicIndependent C (Sum.elim g₀ g₁))
    (hleft : AlgebraicIndependent C g₀) :
    (freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateLeftMap C ι) =
      freeCoordinateEvalMap g₀ hleft := by
  have hRing :
      ((freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateLeftMap C ι)).toRingHom =
      (freeCoordinateEvalMap g₀ hleft).toRingHom := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (MvPolynomial ι C))
    apply RingHom.ext
    intro P
    change freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket
        (freeCoordinateLeftMap C ι
          (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)) =
      freeCoordinateEvalMap g₀ hleft
        (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)
    rw [freeCoordinateLeftMap_algebraMap,
      freeCoordinateEvalMap_algebraMap, freeCoordinateEvalMap_algebraMap]
    have hnaturality :
        (MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
            (MvPolynomial.rename (R := C) Sum.inl) =
          MvPolynomial.aeval g₀ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp
    exact DFunLike.congr_fun hnaturality P
  apply DFunLike.ext _ _
  intro F
  exact congrArg (fun φ : FreeCoordinateRationalField C ι →+* E => φ F) hRing

theorem freeCoordinateEvalMap_rightMap
    {C E ι : Type*} [Field C] [Field E] [Algebra C E]
    (g₀ g₁ : ι → E)
    (hpacket : AlgebraicIndependent C (Sum.elim g₀ g₁))
    (hright : AlgebraicIndependent C g₁) :
    (freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateRightMap C ι) =
      freeCoordinateEvalMap g₁ hright := by
  have hRing :
      ((freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket).comp
        (freeCoordinateRightMap C ι)).toRingHom =
      (freeCoordinateEvalMap g₁ hright).toRingHom := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (MvPolynomial ι C))
    apply RingHom.ext
    intro P
    change freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket
        (freeCoordinateRightMap C ι
          (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)) =
      freeCoordinateEvalMap g₁ hright
        (algebraMap (MvPolynomial ι C) (FreeCoordinateRationalField C ι) P)
    rw [freeCoordinateRightMap_algebraMap,
      freeCoordinateEvalMap_algebraMap, freeCoordinateEvalMap_algebraMap]
    have hnaturality :
        (MvPolynomial.aeval (Sum.elim g₀ g₁)).comp
            (MvPolynomial.rename (R := C) Sum.inr) =
          MvPolynomial.aeval g₁ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp
    exact DFunLike.congr_fun hnaturality P
  apply DFunLike.ext _ _
  intro F
  exact congrArg (fun φ : FreeCoordinateRationalField C ι →+* E => φ F) hRing

/-- Exact domain-level form of the finite two-packet theorem. Packet maps are required only on
the source domain, not on its whole fraction field. -/
theorem twoPacketRationalFormation_domain_eq_linear
    {C ι A L E : Type*} [Field C] [CharZero C] [Fintype ι]
    [CommRing A] [IsDomain A] [Field L] [Field E]
    [Algebra C A] [Algebra A L] [Algebra C L] [IsScalarTower C A L]
    [IsFractionRing A L] [Algebra C E]
    (g : ι → A)
    (hg : AlgebraicIndependent C (fun i => algebraMap A L (g i)))
    (g₀ g₁ : ι → E)
    (hpacket : AlgebraicIndependent C (Sum.elim g₀ g₁))
    (r₀ r₁ r₀₁ : A →ₐ[C] E)
    (h₀ : ∀ i, r₀ (g i) = g₀ i)
    (h₁ : ∀ i, r₁ (g i) = g₁ i)
    (h₀₁ : ∀ i, r₀₁ (g i) = g₀ i + g₁ i)
    (F : FreeCoordinateRationalField C ι) (z : A)
    (hF : freeCoordinateEvalMap (fun i => algebraMap A L (g i)) hg F =
      algebraMap A L z)
    (hadd : r₀₁ z = r₀ z + r₁ z) :
    ∃! c : ι → C, F = freeCoordinateLinearForm C ι c := by
  have hg₀ : AlgebraicIndependent C g₀ := by
    convert hpacket.comp (Sum.inl : ι → ι ⊕ ι) Sum.inl_injective using 1
    funext i
    rfl
  have hg₁ : AlgebraicIndependent C g₁ := by
    convert hpacket.comp (Sum.inr : ι → ι ⊕ ι) Sum.inr_injective using 1
    funext i
    rfl
  have hgsum : AlgebraicIndependent C (fun i => g₀ i + g₁ i) :=
    algebraicIndependent_add_of_sum_elim g₀ g₁ hpacket
  have heval₀ : freeCoordinateEvalMap g₀ hg₀ F = r₀ z :=
    freeCoordinateEvalMap_eq_map_of_eq_algebraMap g hg r₀ g₀ hg₀ h₀ F z hF
  have heval₁ : freeCoordinateEvalMap g₁ hg₁ F = r₁ z :=
    freeCoordinateEvalMap_eq_map_of_eq_algebraMap g hg r₁ g₁ hg₁ h₁ F z hF
  have heval₀₁ : freeCoordinateEvalMap (fun i => g₀ i + g₁ i) hgsum F = r₀₁ z :=
    freeCoordinateEvalMap_eq_map_of_eq_algebraMap g hg r₀₁
      (fun i => g₀ i + g₁ i) hgsum h₀₁ F z hF
  have hformal : freeCoordinateAddMap C ι F =
      freeCoordinateLeftMap C ι F + freeCoordinateRightMap C ι F := by
    let packetEval := freeCoordinateEvalMap (Sum.elim g₀ g₁) hpacket
    have hAddEval : packetEval (freeCoordinateAddMap C ι F) =
        freeCoordinateEvalMap (fun i => g₀ i + g₁ i) hgsum F := by
      exact DFunLike.congr_fun
        (freeCoordinateEvalMap_addMap g₀ g₁ hpacket hgsum) F
    have hLeftEval : packetEval (freeCoordinateLeftMap C ι F) =
        freeCoordinateEvalMap g₀ hg₀ F := by
      exact DFunLike.congr_fun
        (freeCoordinateEvalMap_leftMap g₀ g₁ hpacket hg₀) F
    have hRightEval : packetEval (freeCoordinateRightMap C ι F) =
        freeCoordinateEvalMap g₁ hg₁ F := by
      exact DFunLike.congr_fun
        (freeCoordinateEvalMap_rightMap g₀ g₁ hpacket hg₁) F
    apply packetEval.injective
    change packetEval (freeCoordinateAddMap C ι F) =
      packetEval (freeCoordinateLeftMap C ι F + freeCoordinateRightMap C ι F)
    rw [hAddEval, map_add, hLeftEval, hRightEval]
    rw [heval₀₁, heval₀, heval₁, hadd]
  exact freeCoordinate_rational_additive_eq_linear F hformal

end

end GaloisForLFunctions.HTGeometry
