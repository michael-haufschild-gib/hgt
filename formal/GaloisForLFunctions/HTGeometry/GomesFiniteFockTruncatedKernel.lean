import GaloisForLFunctions.HTGeometry.GomesFiniteFockSymbolClassification

/-!
# The exact finite Fock symbol kernel

No coefficients at or above the horizon can be detected by the clock. Equality
of actual matrices is exactly equality modulo the corresponding power of X.
-/

noncomputable section
open Matrix Polynomial
namespace GaloisForLFunctions.HTGeometry.GammaFactorialFock

/-- Equality of actual symbol matrices is precisely divisibility of their difference by the horizon. -/
theorem gomesFiniteFockPolynomialHom_eq_iff_dvd (N : ℕ) (p q : ℂ[X]) :
    gomesFiniteFockPolynomialHom N p = gomesFiniteFockPolynomialHom N q ↔ X ^ N ∣ p - q := by
  rw [gomesFiniteFockPolynomialHom_eq_iff, Polynomial.X_pow_dvd_iff]
  constructor
  · intro h j hj
    simpa only [Polynomial.coeff_sub, sub_eq_zero] using h ⟨j, hj⟩
  · intro h j
    simpa only [Polynomial.coeff_sub, sub_eq_zero] using h j.val j.isLt

/-- The exact kernel is the principal ideal generated by X to the horizon power. -/
theorem gomesFiniteFockPolynomialHom_zero_iff (N : ℕ) (p : ℂ[X]) :
    gomesFiniteFockPolynomialHom N p = 0 ↔ X ^ N ∣ p := by
  rw [← map_zero (gomesFiniteFockPolynomialHom N), gomesFiniteFockPolynomialHom_eq_iff_dvd,
    sub_zero]

/-- The derivative-clock functional calculus has exactly the expected principal kernel. -/
theorem gomesFiniteFockPolynomialHom_ker (N : ℕ) :
    RingHom.ker (gomesFiniteFockPolynomialHom N).toRingHom = Ideal.span {X ^ N} := by
  ext p
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  exact gomesFiniteFockPolynomialHom_zero_iff N p

/-- Every polynomial-clock symmetry algebra is commutative, despite lying in a full matrix algebra. -/
theorem gomesFiniteFockCommutant_commute (N : ℕ) (E F : gomesFiniteFockCommutant N) :
    Commute E.val F.val := by
  obtain ⟨p, rfl⟩ := gomesFiniteFockSymbolHom_surjective N E
  obtain ⟨q, rfl⟩ := gomesFiniteFockSymbolHom_surjective N F
  exact (Commute.all p q).map (gomesFiniteFockPolynomialHom N)

end GaloisForLFunctions.HTGeometry.GammaFactorialFock
