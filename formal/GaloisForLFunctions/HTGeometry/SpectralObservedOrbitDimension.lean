import GaloisForLFunctions.HTGeometry.WeightedPhaseCurveDimension
import GaloisForLFunctions.HTGeometry.ObserverProfileStability
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.Matrix.Spectrum

/-!
# The completed observed orbit has the dimension of the visible gap module

In an eigenbasis of the Hamiltonian the evolved reporter entry `(U(t) B U(t)^*)_{ij}` is the initial
entry times the phase of the gap `E_i - E_j`.  The observed orbit is therefore the image of a
weighted phase curve — frequencies the energy gaps, weights the transformed reporter entries — under
the fixed injective linear map which conjugates a tuple of matrices by the eigenvector unitary.

Both are bi-Lipschitz, so the completed orbit has Minkowski dimension the rational rank of the gaps
carrying a nonzero reporter entry: the visible gap module.
-/

open scoped Matrix Matrix.Norms.L2Operator NNReal

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {d : Type*} [Fintype d] [DecidableEq d] {N : ℕ}

section Evolution

/-- The evolution generated by a diagonal Hamiltonian is diagonal, with the phases of its
entries. -/
theorem unitaryEvolution_diagonal (E : d → ℝ) (t : ℝ) :
    unitaryEvolution (Matrix.diagonal fun i => (E i : ℂ)) t
      = Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))) := by
  unfold unitaryEvolution
  have hsm : t • ((-Complex.I) • (Matrix.diagonal fun i => (E i : ℂ)))
      = Matrix.diagonal (fun i => -(Complex.I * (t * E i))) := by
    ext i j
    by_cases h : i = j
    · subst h
      simp [Matrix.diagonal]
      ring
    · simp [Matrix.diagonal, h]
  rw [hsm, Matrix.exp_diagonal]
  congr 1
  funext i
  rw [Pi.coe_exp]
  exact (congrFun Complex.exp_eq_exp_ℂ _).symm

/-- The evolution generated by a conjugated Hamiltonian is the conjugated evolution. -/
theorem unitaryEvolution_conj (V A : Matrix d d ℂ) (hV : IsUnit V) (t : ℝ) :
    unitaryEvolution (V * A * V⁻¹) t = V * unitaryEvolution A t * V⁻¹ := by
  unfold unitaryEvolution
  have hsm : t • ((-Complex.I) • (V * A * V⁻¹)) = V * (t • ((-Complex.I) • A)) * V⁻¹ := by
    simp
  rw [hsm, Matrix.exp_conj _ _ hV]

/-- The inverse of a unitary matrix is its adjoint. -/
theorem inv_eq_star_of_mem_unitary {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ)) :
    V⁻¹ = star V :=
  Matrix.inv_eq_left_inv (Unitary.mem_iff.mp hV).1

/-- **Evolution of a diagonalized Hamiltonian.** -/
theorem unitaryEvolution_conj_diagonal (V : Matrix d d ℂ) (hV : V ∈ unitary (Matrix d d ℂ))
    (E : d → ℝ) (t : ℝ) :
    unitaryEvolution (V * Matrix.diagonal (fun i => (E i : ℂ)) * star V) t
      = V * Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))) * star V := by
  have hinv : V⁻¹ = star V := inv_eq_star_of_mem_unitary hV
  have hunit : IsUnit V :=
    ⟨⟨V, star V, (Unitary.mem_iff.mp hV).2, (Unitary.mem_iff.mp hV).1⟩, rfl⟩
  rw [← hinv, unitaryEvolution_conj V _ hunit, unitaryEvolution_diagonal]

/-- A Hermitian matrix is the conjugate of the diagonal matrix of its eigenvalues. -/
theorem isHermitian_eq_conj_diagonal {H : Matrix d d ℂ} (hH : H.IsHermitian) :
    H = (hH.eigenvectorUnitary : Matrix d d ℂ) *
        Matrix.diagonal (fun i => (hH.eigenvalues i : ℂ)) *
        star (hH.eigenvectorUnitary : Matrix d d ℂ) := by
  have hspec := hH.spectral_theorem
  rw [Unitary.conjStarAlgAut_apply] at hspec
  exact hspec

/-- **Spectral form of the evolution.**  A Hermitian generator evolves by conjugating the diagonal
phase matrix of its eigenvalues. -/
theorem unitaryEvolution_spectral {H : Matrix d d ℂ} (hH : H.IsHermitian) (t : ℝ) :
    unitaryEvolution H t
      = (hH.eigenvectorUnitary : Matrix d d ℂ) *
          Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * hH.eigenvalues i)))) *
          star (hH.eigenvectorUnitary : Matrix d d ℂ) := by
  have hev : unitaryEvolution H t
      = unitaryEvolution ((hH.eigenvectorUnitary : Matrix d d ℂ) *
          Matrix.diagonal (fun i => (hH.eigenvalues i : ℂ)) *
          star (hH.eigenvectorUnitary : Matrix d d ℂ)) t := by
    rw [← isHermitian_eq_conj_diagonal hH]
  rw [hev, unitaryEvolution_conj_diagonal _ hH.eigenvectorUnitary.2]

end Evolution

section Assembly

omit [DecidableEq d] in
/-- The entries of a conjugation. -/
theorem conjugation_entry_sum (V X : Matrix d d ℂ) (i j : d) :
    (V * X * star V) i j = ∑ a, ∑ b, V i a * X a b * (star V) b j := by
  rw [Matrix.mul_apply]
  simp_rw [Matrix.mul_apply, Finset.sum_mul]
  rw [Finset.sum_comm]

/-- Conjugating every matrix of a reporter tuple, read in entry coordinates. -/
def conjTuple (V : Matrix d d ℂ) : ((Fin N × d × d) → ℂ) →ₗ[ℂ] ((Fin N × d × d) → ℂ) where
  toFun x := fun p => (V * Matrix.of (fun i j => x (p.1, i, j)) * star V) p.2.1 p.2.2
  map_add' x y := by
    funext p
    simp only [Pi.add_apply, conjugation_entry_sum, Matrix.of_apply]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun b _ => by ring
  map_smul' r x := by
    funext p
    simp only [Pi.smul_apply, smul_eq_mul, conjugation_entry_sum, Matrix.of_apply,
      RingHom.id_apply]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun b _ => by ring

/-- Conjugation by a unitary is undone by conjugation by its adjoint. -/
theorem star_conj_cancel {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ))
    (Z : Matrix d d ℂ) : star V * (V * Z * star V) * V = Z := by
  have hstar : star V * V = 1 := (Unitary.mem_iff.mp hV).1
  simp only [Matrix.mul_assoc]
  rw [hstar, Matrix.mul_one, ← Matrix.mul_assoc, hstar, Matrix.one_mul]

theorem conjTuple_injective {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ)) :
    Function.Injective (conjTuple (N := N) V) := by
  have key : ∀ Z : Matrix d d ℂ, star V * (V * Z * star V) * V = Z := star_conj_cancel hV
  intro x y h
  funext p
  obtain ⟨a, i, j⟩ := p
  have hm : V * Matrix.of (fun i j => x (a, i, j)) * star V
      = V * Matrix.of (fun i j => y (a, i, j)) * star V := by
    ext i' j'
    exact congrFun h (a, i', j')
  have hx : Matrix.of (fun i j => x (a, i, j)) = Matrix.of (fun i j => y (a, i, j)) := by
    rw [← key (Matrix.of fun i j => x (a, i, j)), ← key (Matrix.of fun i j => y (a, i, j)), hm]
  have hentry := congrArg (fun M : Matrix d d ℂ => M i j) hx
  simpa using hentry

/-- The reporter tuple assembled from entry coordinates by conjugation. -/
def orbitAssembly (V : Matrix d d ℂ) :
    ((Fin N × d × d) → ℂ) →ₗ[ℂ] EuclideanSpace ℂ (Fin N × d × d) :=
  ((EuclideanSpace.equiv (Fin N × d × d) ℂ).symm.toLinearEquiv.toLinearMap).comp (conjTuple V)

theorem orbitAssembly_injective {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ)) :
    Function.Injective (orbitAssembly (N := N) V) :=
  (EuclideanSpace.equiv (Fin N × d × d) ℂ).symm.injective.comp (conjTuple_injective hV)

theorem isBiLipschitz_orbitAssembly {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ)) :
    IsBiLipschitz (orbitAssembly (N := N) V : ((Fin N × d × d) → ℂ) → _) :=
  isBiLipschitz_of_linearMap_injective _ (orbitAssembly_injective hV)

end Assembly

section Orbit

/-- The entries of a diagonal conjugation. -/
theorem diagonal_conj_entry (delta : d → ℂ) (X : Matrix d d ℂ) (i j : d) :
    (Matrix.diagonal delta * X * star (Matrix.diagonal delta)) i j
      = delta i * X i j * (starRingEnd ℂ) (delta j) := by
  rw [Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose, Matrix.mul_assoc,
    Matrix.diagonal_mul, Matrix.mul_diagonal, Pi.star_apply, ← mul_assoc]
  rfl

/-- **The phase-curve tuple is a diagonal conjugation.**  A packet whose frequencies are the gaps
of `E` and whose weights are the entries of `w • X` traces the diagonal phase conjugation of
`w • X`. -/
theorem of_weightedPhaseCurve_eq_smul {ι : Type*} [Fintype ι] (omega : ι → ℝ) (c : ι → ℂ)
    (E : d → ℝ) (w : ℂ) (X : Matrix d d ℂ) (t : ℝ) (key : d → d → ι)
    (homega : ∀ i j, omega (key i j) = E j - E i) (hc : ∀ i j, c (key i j) = w * X i j) :
    Matrix.of (fun i j => weightedPhaseCurve omega c t (key i j))
      = w • (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))) * X *
          star (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))))) := by
  ext i j
  rw [Matrix.of_apply, weightedPhaseCurve_apply, Matrix.smul_apply, smul_eq_mul,
    diagonal_conj_entry, homega, hc]
  have hconj : (starRingEnd ℂ) (Complex.exp (-(Complex.I * ((t : ℂ) * ((E j : ℝ) : ℂ)))))
      = Complex.exp (Complex.I * ((t : ℂ) * ((E j : ℝ) : ℂ))) := by
    rw [← Complex.exp_conj]
    congr 1
    simp
  rw [hconj]
  have hexp : Complex.exp (-(Complex.I * ((t : ℂ) * ((E i : ℝ) : ℂ))))
        * Complex.exp (Complex.I * ((t : ℂ) * ((E j : ℝ) : ℂ)))
      = Complex.exp (Complex.I * ((t : ℂ) * ((E j - E i : ℝ) : ℂ))) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [← hexp]
  ring

/-- **The evolved reporter is a conjugated diagonal phase conjugation.** -/
theorem evolved_reporter_conj {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ)) (E : d → ℝ)
    {H : Matrix d d ℂ}
    (hHV : H = V * Matrix.diagonal (fun i => (E i : ℂ)) * star V) (B : Matrix d d ℂ) (t : ℝ) :
    unitaryEvolution H t * B * star (unitaryEvolution H t)
      = V * (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i))))
            * (star V * B * V)
            * star (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))))) * star V := by
  have hstar : star V * V = 1 := (Unitary.mem_iff.mp hV).1
  have hU : unitaryEvolution H t
      = V * Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))) * star V := by
    rw [hHV, unitaryEvolution_conj_diagonal V hV]
  have hst : star ((V * Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i)))))
        * star V)
      = V * (star (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * E i))))) * star V) := by
    simp only [star_mul, star_star, Matrix.mul_assoc]
  rw [hU, hst]
  simp only [Matrix.mul_assoc]

/-- The gap frequency of an entry coordinate. -/
def eigenGapFrequency (N : ℕ) {H : Matrix d d ℂ} (hH : H.IsHermitian) :
    (Fin N × d × d) → ℝ :=
  fun p => hH.eigenvalues p.2.2 - hH.eigenvalues p.2.1

/-- The weight of an entry coordinate: the reporter entry in an eigenbasis, weighted. -/
def eigenReporterWeight (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ}
    (hH : H.IsHermitian) : (Fin N × d × d) → ℂ :=
  fun p => (Real.sqrt (lam p.1) : ℂ) *
    (star (hH.eigenvectorUnitary : Matrix d d ℂ) * B p.1 *
      (hH.eigenvectorUnitary : Matrix d d ℂ)) p.2.1 p.2.2

/-- **The observed orbit is a weighted phase curve read through a fixed conjugation.** -/
theorem observedOrbit_eq_orbitAssembly (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ)
    {H : Matrix d d ℂ} (hH : H.IsHermitian) (t : ℝ) :
    observedOrbit lam B H t
      = orbitAssembly (hH.eigenvectorUnitary : Matrix d d ℂ)
          (weightedPhaseCurve (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) t) := by
  refine congrArg (EuclideanSpace.equiv (Fin N × d × d) ℂ).symm ?_
  funext p
  obtain ⟨a, i, j⟩ := p
  have hmid : Matrix.of (fun i j =>
        weightedPhaseCurve (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) t (a, i, j))
      = (Real.sqrt (lam a) : ℂ) •
        (Matrix.diagonal (fun i => Complex.exp (-(Complex.I * (t * hH.eigenvalues i))))
          * (star (hH.eigenvectorUnitary : Matrix d d ℂ) * B a *
              (hH.eigenvectorUnitary : Matrix d d ℂ))
          * star (Matrix.diagonal
              (fun i => Complex.exp (-(Complex.I * (t * hH.eigenvalues i)))))) :=
    of_weightedPhaseCurve_eq_smul _ _ hH.eigenvalues _ _ t (fun i j => (a, i, j))
      (fun i j => rfl) (fun i j => rfl)
  have hrep := evolved_reporter_conj (V := (hH.eigenvectorUnitary : Matrix d d ℂ))
    hH.eigenvectorUnitary.2 hH.eigenvalues (isHermitian_eq_conj_diagonal hH) (B a) t
  show (Real.sqrt (lam a) : ℂ) *
      (unitaryEvolution H t * B a * star (unitaryEvolution H t)) i j
    = ((hH.eigenvectorUnitary : Matrix d d ℂ) * Matrix.of (fun i j =>
        weightedPhaseCurve (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) t (a, i, j))
        * star (hH.eigenvectorUnitary : Matrix d d ℂ)) i j
  rw [hmid, hrep, Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_apply, smul_eq_mul]

/-- The gaps between energies which the reporter family resolves: those whose reporter entry in an
eigenbasis is nonzero. -/
def visibleGapSet (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ} (hH : H.IsHermitian) : Set ℝ :=
  {g | ∃ a : Fin N, ∃ i j : d,
    (star (hH.eigenvectorUnitary : Matrix d d ℂ) * B a *
      (hH.eigenvectorUnitary : Matrix d d ℂ)) i j ≠ 0 ∧ g = hH.eigenvalues i - hH.eigenvalues j}

theorem span_rat_image_neg (S : Set ℝ) :
    Submodule.span ℚ ((fun x => -x) '' S) = Submodule.span ℚ S := by
  refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
  · rintro _ ⟨x, hx, rfl⟩
    exact Submodule.neg_mem _ (Submodule.subset_span hx)
  · intro x hx
    have hxx : x = -(-x) := (neg_neg x).symm
    rw [hxx]
    exact Submodule.neg_mem _ (Submodule.subset_span ⟨x, hx, rfl⟩)

/-- **Completed observed orbit dimension.**  The closure of the observed orbit of a weighted
reporter family has Minkowski dimension the rational rank of the visible gap module. -/
theorem exists_hasBoxDim_closure_range_observedOrbit (lam : Fin N → ℝ) (hlam : ∀ a, 0 < lam a)
    (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ} (hH : H.IsHermitian) :
    ∃ k : ℕ, (k : ℝ) = (Module.finrank ℚ (Submodule.span ℚ (visibleGapSet B hH)) : ℝ) ∧
      HasBoxDim (closure (Set.range (observedOrbit lam B H))) (k : ℝ) := by
  have hbi : IsBiLipschitz
      (orbitAssembly (N := N) (hH.eigenvectorUnitary : Matrix d d ℂ) :
        ((Fin N × d × d) → ℂ) → EuclideanSpace ℂ (Fin N × d × d)) :=
    isBiLipschitz_orbitAssembly hH.eigenvectorUnitary.2
  obtain ⟨k, hk, hdim⟩ := exists_hasBoxDim_closure_range_image_weightedPhaseCurve
    (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) hbi
  have horbit : observedOrbit lam B H
      = (orbitAssembly (hH.eigenvectorUnitary : Matrix d d ℂ)) ∘
        weightedPhaseCurve (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) := by
    funext t
    exact observedOrbit_eq_orbitAssembly lam B hH t
  have hsupport : eigenGapFrequency N hH '' {p | eigenReporterWeight lam B hH p ≠ 0}
      = (fun x => -x) '' visibleGapSet B hH := by
    ext g
    constructor
    · rintro ⟨p, hp, rfl⟩
      obtain ⟨a, i, j⟩ := p
      refine ⟨hH.eigenvalues i - hH.eigenvalues j, ⟨a, i, j, ?_, rfl⟩, ?_⟩
      · intro hzero
        exact hp (by rw [eigenReporterWeight, hzero, mul_zero])
      · rw [eigenGapFrequency]
        ring
    · rintro ⟨g', ⟨a, i, j, hne, rfl⟩, rfl⟩
      refine ⟨(a, i, j), ?_, ?_⟩
      · have hsq : (Real.sqrt (lam a) : ℂ) ≠ 0 := by
          simp only [ne_eq, Complex.ofReal_eq_zero]
          exact Real.sqrt_ne_zero'.mpr (hlam a)
        exact mul_ne_zero hsq hne
      · rw [eigenGapFrequency]
        ring
  refine ⟨k, ?_, ?_⟩
  · rw [hk, hsupport, span_rat_image_neg]
  · rw [horbit]
    exact hdim

end Orbit

section Horizon

open scoped ENNReal

/-- The completed observed orbit is compact. -/
theorem isCompact_closure_range_observedOrbit (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ)
    {H : Matrix d d ℂ} (hH : H.IsHermitian) :
    IsCompact (closure (Set.range (observedOrbit lam B H))) := by
  have horbit : observedOrbit lam B H
      = (orbitAssembly (hH.eigenvectorUnitary : Matrix d d ℂ)) ∘
        weightedPhaseCurve (eigenGapFrequency N hH) (eigenReporterWeight lam B hH) := by
    funext t
    exact observedOrbit_eq_orbitAssembly lam B hH t
  rw [horbit]
  exact isCompact_closure_range_image_weightedPhaseCurve _ _
    (isBiLipschitz_orbitAssembly hH.eigenvectorUnitary.2).continuous

/-- **Finite horizons exhaust the completed orbit.**  If the closure of a curve is compact then
every resolution slack is realized inside a finite time window. -/
theorem exists_horizon_forall_dist_le {W : Type*} [MetricSpace W] {f : ℝ → W}
    (hK : IsCompact (closure (Set.range f))) {eta : ℝ} (heta : 0 < eta) :
    ∃ T : ℝ, 0 ≤ T ∧ ∀ x ∈ closure (Set.range f), ∃ t ∈ Set.Icc (-T) T, dist x (f t) ≤ eta := by
  have hcover : closure (Set.range f) ⊆ ⋃ t : ℝ, Metric.ball (f t) eta := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := Metric.mem_closure_iff.mp hx eta heta
    obtain ⟨t, rfl⟩ := hy
    exact Set.mem_iUnion.mpr ⟨t, by simpa using hxy⟩
  obtain ⟨s, hs⟩ := hK.elim_finite_subcover (fun t : ℝ => Metric.ball (f t) eta)
    (fun t => Metric.isOpen_ball) hcover
  refine ⟨∑ t ∈ s, |t|, Finset.sum_nonneg fun t _ => abs_nonneg t, fun x hx => ?_⟩
  obtain ⟨t, hts, hxt⟩ := Set.mem_iUnion₂.mp (hs hx)
  have habs : |t| ≤ ∑ u ∈ s, |u| :=
    Finset.single_le_sum (f := fun u => |u|) (fun u _ => abs_nonneg u) hts
  refine ⟨t, ⟨?_, ?_⟩, le_of_lt (Metric.mem_ball.mp hxt)⟩
  · linarith [neg_abs_le t]
  · linarith [le_abs_self t]

/-- **Finite horizon under the completed profile.**  Every finite-horizon profile is at most the
completed profile at the same resolution. -/
theorem externalCoveringNumber_orbitSegment_le_completed (lam : Fin N → ℝ)
    (B : Fin N → Matrix d d ℂ) (H : Matrix d d ℂ) (T : ℝ) (eps : ℝ≥0) :
    Metric.externalCoveringNumber eps (orbitSegment lam B H T)
      ≤ Metric.externalCoveringNumber eps (closure (Set.range (observedOrbit lam B H))) := by
  refine Metric.externalCoveringNumber_mono_set ?_
  rintro _ ⟨t, -, rfl⟩
  exact subset_closure ⟨t, rfl⟩

/-- **Completed profile under the shifted finite-horizon profile.**  For every resolution slack
there is a horizon beyond which the completed profile at the shifted resolution is at most the
finite-horizon profile. -/
theorem exists_horizon_externalCoveringNumber_completed_le (lam : Fin N → ℝ)
    (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ} (hH : H.IsHermitian) (eps eta : ℝ≥0)
    (heta : 0 < (eta : ℝ)) :
    ∃ T : ℝ, 0 ≤ T ∧ ∀ T' : ℝ, T ≤ T' →
      Metric.externalCoveringNumber (eps + eta) (closure (Set.range (observedOrbit lam B H)))
        ≤ Metric.externalCoveringNumber eps (orbitSegment lam B H T') := by
  obtain ⟨T, hT0, hdense⟩ :=
    exists_horizon_forall_dist_le (isCompact_closure_range_observedOrbit lam B hH) heta
  refine ⟨T, hT0, fun T' hT' => ?_⟩
  refine externalCoveringNumber_le_of_forall_exists_dist_le ?_
  intro y hy
  obtain ⟨t, ht, hyt⟩ := hdense y hy
  exact ⟨observedOrbit lam B H t,
    ⟨t, Set.Icc_subset_Icc (by linarith) (by linarith) ht, rfl⟩, hyt⟩

/-- **Ordered-limit sandwich.**  Beyond a finite horizon the finite-horizon profile is trapped
between the completed profile at the shifted resolution and the completed profile itself, so the
resolution limit of the finite-horizon profiles computes the dimension of the completed orbit. -/
theorem exists_horizon_externalCoveringNumber_sandwich (lam : Fin N → ℝ)
    (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ} (hH : H.IsHermitian) (eps eta : ℝ≥0)
    (heta : 0 < (eta : ℝ)) :
    ∃ T : ℝ, 0 ≤ T ∧ ∀ T' : ℝ, T ≤ T' →
      Metric.externalCoveringNumber (eps + eta) (closure (Set.range (observedOrbit lam B H)))
          ≤ Metric.externalCoveringNumber eps (orbitSegment lam B H T') ∧
        Metric.externalCoveringNumber eps (orbitSegment lam B H T')
          ≤ Metric.externalCoveringNumber eps (closure (Set.range (observedOrbit lam B H))) := by
  obtain ⟨T, hT0, hle⟩ :=
    exists_horizon_externalCoveringNumber_completed_le lam B hH eps eta heta
  exact ⟨T, hT0, fun T' hT' =>
    ⟨hle T' hT', externalCoveringNumber_orbitSegment_le_completed lam B H T' eps⟩⟩

end Horizon

section SectorForm

open Classical in
/-- The spectral projection onto an energy sector. -/
def sectorProj {H : Matrix d d ℂ} (hH : H.IsHermitian) (mu : ℝ) : Matrix d d ℂ :=
  (hH.eigenvectorUnitary : Matrix d d ℂ) *
    Matrix.diagonal (fun p => if hH.eigenvalues p = mu then (1 : ℂ) else 0) *
    star (hH.eigenvectorUnitary : Matrix d d ℂ)

/-- A conjugation by a unitary vanishes only on the zero matrix. -/
theorem conj_eq_zero_iff {V : Matrix d d ℂ} (hV : V ∈ unitary (Matrix d d ℂ))
    (X : Matrix d d ℂ) : V * X * star V = 0 ↔ X = 0 := by
  constructor
  · intro h
    rw [← star_conj_cancel hV X, h, Matrix.mul_zero, Matrix.zero_mul]
  · intro h
    rw [h, Matrix.mul_zero, Matrix.zero_mul]

/-- A sector-to-sector block of a reporter is the conjugate of the corresponding block of the
reporter in the eigenbasis. -/
theorem sectorProj_mul_mul {H : Matrix d d ℂ} (hH : H.IsHermitian) (mu nu : ℝ)
    (Ba : Matrix d d ℂ) :
    sectorProj hH mu * Ba * sectorProj hH nu
      = (hH.eigenvectorUnitary : Matrix d d ℂ) *
          (Matrix.diagonal (fun p => if hH.eigenvalues p = mu then (1 : ℂ) else 0)
            * (star (hH.eigenvectorUnitary : Matrix d d ℂ) * Ba *
                (hH.eigenvectorUnitary : Matrix d d ℂ))
            * Matrix.diagonal (fun q => if hH.eigenvalues q = nu then (1 : ℂ) else 0))
          * star (hH.eigenvectorUnitary : Matrix d d ℂ) := by
  classical
  rw [sectorProj, sectorProj]
  simp only [Matrix.mul_assoc]

/-- The entries of a sector-restricted block. -/
theorem indicator_conj_entry (mu nu : ℝ) (E : d → ℝ) (X : Matrix d d ℂ) (p q : d)
    [DecidablePred fun r : d => E r = mu] [DecidablePred fun r : d => E r = nu] :
    (Matrix.diagonal (fun r => if E r = mu then (1 : ℂ) else 0) * X
        * Matrix.diagonal (fun r => if E r = nu then (1 : ℂ) else 0)) p q
      = (if E p = mu then (1 : ℂ) else 0) * X p q * (if E q = nu then (1 : ℂ) else 0) := by
  rw [Matrix.mul_assoc, Matrix.diagonal_mul, Matrix.mul_diagonal, ← mul_assoc]

/-- **A sector block is nonzero exactly when it has a nonzero eigenbasis entry.** -/
theorem sectorProj_mul_mul_ne_zero_iff {H : Matrix d d ℂ} (hH : H.IsHermitian) (mu nu : ℝ)
    (Ba : Matrix d d ℂ) :
    sectorProj hH mu * Ba * sectorProj hH nu ≠ 0
      ↔ ∃ p q : d, hH.eigenvalues p = mu ∧ hH.eigenvalues q = nu ∧
          (star (hH.eigenvectorUnitary : Matrix d d ℂ) * Ba *
            (hH.eigenvectorUnitary : Matrix d d ℂ)) p q ≠ 0 := by
  classical
  rw [sectorProj_mul_mul, ne_eq, conj_eq_zero_iff hH.eigenvectorUnitary.2]
  constructor
  · intro h
    by_contra hcon
    push Not at hcon
    refine h ?_
    ext p q
    rw [indicator_conj_entry mu nu hH.eigenvalues]
    by_cases hp : hH.eigenvalues p = mu
    · by_cases hq : hH.eigenvalues q = nu
      · rw [hcon p q hp hq]
        simp
      · rw [if_neg hq]
        simp
    · rw [if_neg hp]
      simp
  · rintro ⟨p, q, hp, hq, hne⟩ hzero
    refine hne ?_
    have hentry : (Matrix.diagonal (fun r => if hH.eigenvalues r = mu then (1 : ℂ) else 0)
        * (star (hH.eigenvectorUnitary : Matrix d d ℂ) * Ba *
            (hH.eigenvectorUnitary : Matrix d d ℂ))
        * Matrix.diagonal (fun r => if hH.eigenvalues r = nu then (1 : ℂ) else 0)) p q = 0 := by
      rw [hzero]
      simp
    rw [indicator_conj_entry mu nu hH.eigenvalues, if_pos hp, if_pos hq, one_mul, mul_one]
      at hentry
    exact hentry

omit [DecidableEq d] in
/-- The Hilbert–Schmidt norm vanishes only on the zero matrix. -/
theorem hsNorm_eq_zero_iff (X : Matrix d d ℂ) : hsNorm X = 0 ↔ X = 0 := by
  rw [hsNorm, norm_eq_zero, matVec]
  constructor
  · intro h
    ext i j
    have hfun := congrArg (EuclideanSpace.equiv (d × d) ℂ) h
    simp only [ContinuousLinearEquiv.apply_symm_apply, map_zero] at hfun
    exact congrFun hfun (i, j)
  · intro h
    subst h
    ext p
    simp

/-- **The visible gap module in sector form.**  A gap is visible exactly when the corresponding
weighted sector block of the reporter family has positive Hilbert–Schmidt mass. -/
theorem visibleGapSet_eq_sectorGapSet (lam : Fin N → ℝ) (hlam : ∀ a, 0 < lam a)
    (B : Fin N → Matrix d d ℂ) {H : Matrix d d ℂ} (hH : H.IsHermitian) :
    visibleGapSet B hH
      = {g | ∃ i j : d,
          0 < ∑ a, lam a * hsNorm (sectorProj hH (hH.eigenvalues i) * B a *
                sectorProj hH (hH.eigenvalues j)) ^ 2
            ∧ g = hH.eigenvalues i - hH.eigenvalues j} := by
  have hpos : ∀ i j : d,
      (0 < ∑ a, lam a * hsNorm (sectorProj hH (hH.eigenvalues i) * B a *
            sectorProj hH (hH.eigenvalues j)) ^ 2)
        ↔ ∃ a : Fin N, sectorProj hH (hH.eigenvalues i) * B a *
            sectorProj hH (hH.eigenvalues j) ≠ 0 := by
    intro i j
    rw [Finset.sum_pos_iff_of_nonneg fun a _ =>
      mul_nonneg (hlam a).le (by positivity)]
    constructor
    · rintro ⟨a, -, ha⟩
      refine ⟨a, fun hzero => ?_⟩
      rw [hzero] at ha
      have hz : hsNorm (0 : Matrix d d ℂ) = 0 := (hsNorm_eq_zero_iff _).mpr rfl
      rw [hz] at ha
      simp at ha
    · rintro ⟨a, ha⟩
      refine ⟨a, Finset.mem_univ a, ?_⟩
      have hne : hsNorm (sectorProj hH (hH.eigenvalues i) * B a *
          sectorProj hH (hH.eigenvalues j)) ≠ 0 := fun h => ha ((hsNorm_eq_zero_iff _).mp h)
      have hsq : 0 < hsNorm (sectorProj hH (hH.eigenvalues i) * B a *
          sectorProj hH (hH.eigenvalues j)) ^ 2 :=
        pow_pos (lt_of_le_of_ne (hsNorm_nonneg _) (Ne.symm hne)) 2
      exact mul_pos (hlam a) hsq
  ext g
  constructor
  · rintro ⟨a, i, j, hne, rfl⟩
    refine ⟨i, j, ?_, rfl⟩
    rw [hpos i j]
    exact ⟨a, (sectorProj_mul_mul_ne_zero_iff hH _ _ (B a)).mpr ⟨i, j, rfl, rfl, hne⟩⟩
  · rintro ⟨i, j, hmass, rfl⟩
    obtain ⟨a, ha⟩ := (hpos i j).mp hmass
    obtain ⟨p, q, hp, hq, hne⟩ := (sectorProj_mul_mul_ne_zero_iff hH _ _ (B a)).mp ha
    exact ⟨a, p, q, hne, by rw [hp, hq]⟩

end SectorForm

