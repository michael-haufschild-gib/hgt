import GaloisForLFunctions.HTGeometry.DifferentialJointSolvability
import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealSaturation

/-!
# One step towards a differentially closed field

Collecting every consistent differential system over `F` — a number of indeterminates together with
a proper differential ideal — into a single differential polynomial ring on the disjoint union of
all their variables, the radical differential ideal generated by all of them is proper: membership
of one is witnessed by finitely many generators, hence by finitely many systems, and those are
jointly solvable, so evaluation at a joint solution is a differential map to a field which kills
those generators.

A point of that ideal therefore solves every consistent system over `F` at once, in one differential
field extension.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential
open GaloisForLFunctions

universe u

variable (F : Type u) [Field F] [Algebra ℚ F] [Differential F]

/-- A consistent differential system over `F` in finitely many indeterminates. -/
def DiffSystem : Type u :=
  Σ n : ℕ, {I : Ideal (DifferentialPolynomial (ULift.{u} (Fin n)) F) //
    (∀ x ∈ I, differentialPolynomialOverDerivation (ULift.{u} (Fin n)) F x ∈ I) ∧ I ≠ ⊤}

/-- The indeterminates of all the systems over `F` at once. -/
def systemVars : Type u := Σ s : DiffSystem F, ULift.{u} (Fin s.1)

variable {F}

/-- The ideal of a system. -/
def DiffSystem.ideal (s : DiffSystem F) :
    Ideal (DifferentialPolynomial (ULift.{u} (Fin s.1)) F) := s.2.1

omit [Algebra ℚ F] in
theorem DiffSystem.deriv_mem_ideal (s : DiffSystem F) :
    ∀ x ∈ s.ideal, differentialPolynomialOverDerivation (ULift.{u} (Fin s.1)) F x ∈ s.ideal :=
  s.2.2.1

omit [Algebra ℚ F] in
theorem DiffSystem.ideal_ne_top (s : DiffSystem F) : s.ideal ≠ ⊤ := s.2.2.2

/-- The variables of one system inside the variables of all of them. -/
def systemEmbedding (s : DiffSystem F) : ULift.{u} (Fin s.1) → systemVars F := fun i => ⟨s, i⟩

variable (F)

/-- All the systems over `F`, transported into the differential polynomial ring on all the
variables. -/
def systemGenerators : Set (DifferentialPolynomial (systemVars F) F) :=
  {p | ∃ s : DiffSystem F, ∃ q ∈ s.2.1, differentialRename (systemEmbedding s) q = p}

/-- **Finitely many systems are solved in one extension**, uniformly in the variables of all the
systems. -/
theorem exists_ext_solving_finset (T : Finset (DiffSystem F)) :
    ∃ (E : DiffFieldExt F) (Y : systemVars F → E.carrier),
      ∀ s ∈ T, ∀ p ∈ s.ideal,
        differentialPolynomialEvalOver (K := F) (fun i => Y (systemEmbedding s i)) p = 0 := by
  classical
  induction T using Finset.induction_on with
  | empty => exact ⟨DiffFieldExt.refl, fun _ => 0, by simp⟩
  | insert s T hs ih =>
      obtain ⟨E, Y, hY⟩ := ih
      obtain ⟨M, z, hz⟩ := exists_point_over_ext E s.deriv_mem_ideal s.ideal_ne_top
      letI : Algebra F M.carrier :=
        ((algebraMap E.carrier M.carrier).comp (algebraMap F E.carrier)).toAlgebra
      haveI htower : IsScalarTower F E.carrier M.carrier :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hFM : ∀ a : F, algebraMap F M.carrier a
          = algebraMap E.carrier M.carrier (algebraMap F E.carrier a) := fun _ => rfl
      have hcompatFM : ∀ a : F, Differential.deriv (algebraMap F M.carrier a)
          = algebraMap F M.carrier (Differential.deriv a) := by
        intro a
        rw [hFM, hFM, M.compat, E.compat]
      obtain ⟨Y', hY'eq, hY'ne⟩ : ∃ Y' : systemVars F → M.carrier,
          (fun i => Y' (systemEmbedding s i)) = z ∧
            ∀ s' : DiffSystem F, s' ≠ s → ∀ i, Y' (systemEmbedding s' i)
              = algebraMap E.carrier M.carrier (Y (systemEmbedding s' i)) := by
        refine ⟨fun v => if h : v.1 = s then z (h ▸ v.2)
          else algebraMap E.carrier M.carrier (Y v), ?_, ?_⟩
        · funext i
          exact dif_pos rfl
        · intro s' hne i
          exact dif_neg hne
      refine ⟨⟨M.carrier, hcompatFM⟩, Y', ?_⟩
      intro s' hs' p hp
      rcases Finset.mem_insert.mp hs' with rfl | hs'T
      · rw [hY'eq]
        rw [← differentialPolynomialEvalOver_differentialCoeffExtend (F := F) (L := E.carrier)
          (M := M.carrier) z p]
        exact hz p hp
      · have hne : s' ≠ s := fun h => hs (h ▸ hs'T)
        have hfun : (fun i => Y' (systemEmbedding s' i))
            = fun i => algebraMap E.carrier M.carrier (Y (systemEmbedding s' i)) :=
          funext (hY'ne s' hne)
        rw [hfun]
        have hφδ : ∀ x : E.carrier, algebraMap E.carrier M.carrier (Differential.deriv x)
            = Differential.deriv (algebraMap E.carrier M.carrier x) := fun x => (M.compat x).symm
        have hφF : ∀ a : F, algebraMap E.carrier M.carrier (algebraMap F E.carrier a)
            = algebraMap F M.carrier a := fun a => (hFM a).symm
        have hmapped := map_differentialPolynomialEvalOver (F := F) (L := E.carrier)
          (M := M.carrier) (algebraMap E.carrier M.carrier) hφδ hφF
          (fun i => Y (systemEmbedding s' i)) p
        rw [← hmapped, hY s' hs'T p hp, map_zero]

/-- **One step of the differential closure.**  A single differential field extension carries a
solution of every consistent differential system over `F`.

The differential polynomial ring on the variables of all systems at once carries the radical
differential ideal generated by all of them; membership of one is witnessed by finitely many
generators, hence by finitely many systems, which are jointly solvable, so the evaluation at a joint
solution is a differential map to a field killing those generators — and the ideal is therefore
proper.  A point of it solves every system simultaneously. -/
theorem exists_ext_solving_all :
    ∃ E : DiffFieldExt F, ∀ (n : ℕ) (I : Ideal (DifferentialPolynomial (ULift.{u} (Fin n)) F)),
      (∀ x ∈ I, differentialPolynomialOverDerivation (ULift.{u} (Fin n)) F x ∈ I) → I ≠ ⊤ →
      ∃ y : ULift.{u} (Fin n) → E.carrier,
        ∀ p ∈ I, differentialPolynomialEvalOver (K := F) y p = 0 := by
  classical
  letI : Differential (DifferentialPolynomial (systemVars F) F) :=
    differentialPolynomialOverDifferential (systemVars F) F
  have hJrad : (radicalDifferentialIdeal (systemGenerators F)).IsRadical :=
    isRadical_radicalDifferentialIdeal _
  have hJδ : ∀ x ∈ radicalDifferentialIdeal (systemGenerators F),
      differentialPolynomialOverDerivation (systemVars F) F x
        ∈ radicalDifferentialIdeal (systemGenerators F) :=
    deriv_mem_radicalDifferentialIdeal _
  have hJne : radicalDifferentialIdeal (systemGenerators F) ≠ ⊤ := by
    intro htop
    have hone : (1 : DifferentialPolynomial (systemVars F) F)
        ∈ radicalDifferentialIdeal (systemGenerators F) := by
      rw [htop]; trivial
    obtain ⟨T₀, hT₀, hone'⟩ := exists_finset_subset_mem_radicalDifferentialIdeal hone
    obtain ⟨E, Y, hY⟩ := exists_ext_solving_finset F
      (T₀.attach.image (fun t => (hT₀ (Finset.mem_coe.mpr t.2)).choose))
    have hker : ∀ t ∈ T₀, differentialPolynomialEvalOver (K := F) (L := E.carrier) Y t = 0 := by
      intro t ht
      set s := (hT₀ (Finset.mem_coe.mpr ht)).choose with hs
      obtain ⟨q, hq, hqt⟩ := (hT₀ (Finset.mem_coe.mpr ht)).choose_spec
      have hsT : s ∈ T₀.attach.image (fun t => (hT₀ (Finset.mem_coe.mpr t.2)).choose) :=
        Finset.mem_image.mpr ⟨⟨t, ht⟩, Finset.mem_attach _ _, rfl⟩
      rw [← hqt, differentialPolynomialEvalOver_differentialRename]
      exact hY s hsT q hq
    have hkerrad : (RingHom.ker
        ((differentialPolynomialEvalOver (K := F) (L := E.carrier) Y :
          DifferentialPolynomial (systemVars F) F →ₐ[F] E.carrier) :
            DifferentialPolynomial (systemVars F) F →+* E.carrier)).IsRadical ∧
        ∀ x ∈ RingHom.ker
          ((differentialPolynomialEvalOver (K := F) (L := E.carrier) Y :
            DifferentialPolynomial (systemVars F) F →ₐ[F] E.carrier) :
              DifferentialPolynomial (systemVars F) F →+* E.carrier),
          Differential.deriv x ∈ RingHom.ker
            ((differentialPolynomialEvalOver (K := F) (L := E.carrier) Y :
              DifferentialPolynomial (systemVars F) F →ₐ[F] E.carrier) :
                DifferentialPolynomial (systemVars F) F →+* E.carrier) :=
      isRadical_ker_of_field _ fun x =>
        differentialPolynomialEvalOver_derivation (K := F) Y x
    have hle := radicalDifferentialIdeal_le (S := (T₀ : Set (DifferentialPolynomial
      (systemVars F) F)))
      (I := RingHom.ker
        ((differentialPolynomialEvalOver (K := F) (L := E.carrier) Y :
          DifferentialPolynomial (systemVars F) F →ₐ[F] E.carrier) :
            DifferentialPolynomial (systemVars F) F →+* E.carrier))
      (fun t ht => hker t (by simpa using ht)) hkerrad.1 hkerrad.2
    have hone0 := hle hone'
    rw [RingHom.mem_ker] at hone0
    simp only [map_one] at hone0
    exact one_ne_zero hone0
  obtain ⟨L, hLfield, hLdiff, hLalg, hLcompat, Y, hY⟩ :=
    exists_point_of_ne_top (F := F) (ι := systemVars F) hJrad hJδ hJne
  letI := hLfield
  letI := hLdiff
  letI := hLalg
  letI : Algebra ℚ L := ((algebraMap F L).comp (algebraMap ℚ F)).toAlgebra
  refine ⟨⟨L, hLcompat⟩, ?_⟩
  intro n I hIδ hIne
  refine ⟨fun i => Y (systemEmbedding ⟨n, I, hIδ, hIne⟩ i), ?_⟩
  intro p hp
  rw [← differentialPolynomialEvalOver_differentialRename (F := F)
    (systemEmbedding (⟨n, I, hIδ, hIne⟩ : DiffSystem F)) Y p]
  exact hY _ (subset_radicalDifferentialIdeal _ ⟨⟨n, I, hIδ, hIne⟩, p, hp, rfl⟩)

end

end GaloisForLFunctions.HTGeometry
