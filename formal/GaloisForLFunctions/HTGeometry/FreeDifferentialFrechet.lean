import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import GaloisForLFunctions.HTGeometry.DifferentialOperatorOreMatrix
import GaloisForLFunctions.HTGeometry.JetFieldDerivationExpansion

/-!
# The Frechet row of an element of the free differential field

For `u` in the free differential rational field `C⟨x_j : j ∈ ι⟩` the Frechet row is the family of
linear differential operators

`J(u)_j = ∑_m (∂u/∂x_j^{(m)}) ∂^m`,

one for each coordinate `j`.  It is the coordinate expression of the universal differential of
`u` in the free operator module generated by `dx_j`.

The three structural properties proved here are

* `J` is a derivation: `J(u v) = u J(v) + v J(u)`;
* `J` intertwines the derivation of the field with left multiplication by `∂`:
  `J(δ u) = ∂ · J(u)`;
* `J` sends the coordinate `x_k^{(n)}` to the monomial `∂ⁿ` in the `k`-th slot.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace JetField

noncomputable section

variable {C : Type u} {ι : Type v} [Field C]

theorem finite_support_pd (u : JetField C ι) (j : ι) :
    (Function.support fun m : ℕ => pd (j, m) u).Finite := by
  classical
  obtain ⟨s, hs⟩ := exists_finset_pd_eq_zero u
  refine Set.Finite.subset ((s.filter fun p => p.1 = j).image Prod.snd).finite_toSet ?_
  intro m hm
  have hmem : ((j, m) : ι × ℕ) ∈ s := by
    by_contra hcon
    exact hm (hs (j, m) hcon)
  refine Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨(j, m), ?_, rfl⟩)
  exact Finset.mem_filter.mpr ⟨hmem, rfl⟩

/-- The Frechet row of `u`: the `j`-th component is `∑_m (∂u/∂x_j^{(m)}) ∂^m`. -/
def frechet (u : JetField C ι) (j : ι) : DiffOp (JetField C ι) :=
  DiffOp.ofFinsupp (Finsupp.ofSupportFinite (fun m => pd (j, m) u) (finite_support_pd u j))

@[simp] theorem coeff_frechet (u : JetField C ι) (j : ι) (m : ℕ) :
    DiffOp.coeff (frechet u j) m = pd (j, m) u := by
  rw [frechet, DiffOp.coeff, DiffOp.toFinsupp_ofFinsupp, Finsupp.ofSupportFinite_coe]

@[simp] theorem frechet_zero (j : ι) : frechet (0 : JetField C ι) j = 0 := by
  ext m
  rw [coeff_frechet, map_zero, DiffOp.coeff_zero]

theorem frechet_add (u w : JetField C ι) (j : ι) :
    frechet (u + w) j = frechet u j + frechet w j := by
  ext m
  rw [coeff_frechet, map_add, DiffOp.coeff_add, coeff_frechet, coeff_frechet]

theorem frechet_mul (u w : JetField C ι) (j : ι) :
    frechet (u * w) j = u • frechet w j + w • frechet u j := by
  ext m
  rw [coeff_frechet, Derivation.leibniz, DiffOp.coeff_add, DiffOp.coeff_smul, DiffOp.coeff_smul,
    coeff_frechet, coeff_frechet, smul_eq_mul, smul_eq_mul]

theorem frechet_algebraMap (c : C) (j : ι) :
    frechet (algebraMap C (JetField C ι) c) j = 0 := by
  ext m
  rw [coeff_frechet, Derivation.map_algebraMap, DiffOp.coeff_zero]

/-- The Frechet row intertwines the derivation of the field with left multiplication by `∂`. -/
theorem frechet_deriv (u : JetField C ι) (j : ι) :
    frechet (u′) j = DiffOp.dpartial (frechet u j) := by
  ext m
  cases m with
  | zero =>
    rw [coeff_frechet, DiffOp.coeff_dpartial_zero, coeff_frechet, pd_deriv_zero]
  | succ m =>
    rw [coeff_frechet, DiffOp.coeff_dpartial_succ, coeff_frechet, coeff_frechet,
      pd_deriv_succ]
    exact add_comm _ _

theorem frechet_differentialJet (n : ℕ) (u : JetField C ι) (j : ι) :
    frechet (differentialJet n u) j = DiffOp.dpartial^[n] (frechet u j) := by
  induction n with
  | zero => rw [differentialJet_zero, Function.iterate_zero_apply]
  | succ n ih =>
    rw [differentialJet_succ, frechet_deriv, ih, Function.iterate_succ_apply']

theorem frechet_jet_self (k : ι) (n : ℕ) :
    frechet (jet ((k, n) : ι × ℕ) : JetField C ι) k = DiffOp.mono n 1 := by
  ext m
  rw [coeff_frechet, DiffOp.coeff_mono]
  by_cases h : n = m
  · subst h
    rw [if_pos rfl, pd_jet_self]
  · rw [if_neg h, pd_jet_of_ne]
    intro hcon
    exact h (congrArg Prod.snd hcon).symm

theorem frechet_jet_of_ne {j k : ι} (n : ℕ) (h : j ≠ k) :
    frechet (jet ((k, n) : ι × ℕ) : JetField C ι) j = 0 := by
  ext m
  rw [coeff_frechet, DiffOp.coeff_zero, pd_jet_of_ne]
  intro hcon
  exact h (congrArg Prod.fst hcon)

end

end JetField

end GaloisForLFunctions.HTGeometry
