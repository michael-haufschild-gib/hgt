import GaloisForLFunctions.HTGeometry.RittLogTowerDefect
import GaloisForLFunctions.HTGeometry.RittAffineLinearSplit
import GaloisForLFunctions.HTGeometry.RittTowerDescentStep

/-!
# One level of the affine tower descent

The coprime split of a relation `σ W = c·W + (α·t_m + β)` over the simple transcendental extension
generated by the `m`-th jet returns five shapes.  Translated back to the tower they are: the
inhomogeneity has no top component and `W` already lies one level down; the level defect vanishes;
the subleading coefficient of a monic denominator solves an affine relation with multiplier
`ρ^{-(m+1)}` and inhomogeneity a negative integer multiple of the defect; a degree-two numerator
gives an eigenvector together with a companion whose inhomogeneity is a base constant minus twice
the defect; and a degree-one numerator gives its leading coefficient, together — when the top
component vanishes — with a companion whose inhomogeneity is a base multiple of `β` minus the
defect.
-/

namespace GaloisForLFunctions.HTGeometry

namespace RittFrame

variable {K L : Type*} [Field K] [Field L] [CharZero L] [Algebra K L]

/-- **One level of the affine tower descent.** -/
theorem logTower_dichotomy (Fr : RittFrame K L) {u : L} {b : K}
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b)
    {m : ℕ} (htr : Transcendental ↥(Fr.jetPrefixField u m) (Fr.d^[m] u))
    {W : L} (hW0 : W ≠ 0) (hWmem : W ∈ Fr.jetPrefixField u (m + 1))
    {c α : K} (hc : c ≠ 0) {β : L} (hβmem : β ∈ Fr.jetPrefixField u m)
    (hrel : Fr.σ W = algebraMap K L c * W + (algebraMap K L α * Fr.d^[m] u + β)) :
    (α = 0 ∧ W ∈ Fr.jetPrefixField u m) ∨
    (Fr.towerDefect u b m = 0) ∨
    (∃ (w : L) (N : ℕ), w ≠ 0 ∧ w ∈ Fr.jetPrefixField u m ∧ 1 ≤ N ∧
      Fr.σ w = algebraMap K L ((Fr.ρ ^ (m + 1))⁻¹) * w
        - (N : L) * Fr.towerDefect u b m) ∨
    (∃ v Z : L, v ≠ 0 ∧ v ∈ Fr.jetPrefixField u m ∧ Z ∈ Fr.jetPrefixField u m ∧ α ≠ 0 ∧
      Fr.σ v = algebraMap K L (c * (Fr.ρ ^ (m + 1)) ^ (2 : ℕ)) * v ∧
      Fr.σ Z = algebraMap K L ((Fr.ρ ^ (m + 1))⁻¹) * Z
        + algebraMap K L ((Fr.ρ ^ (m + 1))⁻¹ * α / c) / v - 2 * Fr.towerDefect u b m) ∨
    (∃ v p : L, v ≠ 0 ∧ v ∈ Fr.jetPrefixField u m ∧ p ∈ Fr.jetPrefixField u m ∧
      W = v * Fr.d^[m] u + p ∧
      Fr.σ v = algebraMap K L (c * Fr.ρ ^ (m + 1)) * v
        + algebraMap K L (α * Fr.ρ ^ (m + 1)) ∧
      Fr.σ p = algebraMap K L c * p + β - Fr.σ v * Fr.towerDefect u b m) := by
  classical
  set E : IntermediateField K L := Fr.jetPrefixField u m with hE
  have hEσ : ∀ x ∈ E, Fr.σ x ∈ E := Fr.sigma_mem_affineJetPrefixField hu m
  set φ : ↥E →+* ↥E :=
    { toFun := fun x => ⟨Fr.σ (x : L), hEσ (x : L) x.2⟩
      map_one' := by ext; simp
      map_mul' := fun _ _ => by ext; simp
      map_zero' := by ext; simp
      map_add' := fun _ _ => by ext; simp } with hφ
  have hcompE : ∀ x : ↥E, Fr.σ (algebraMap ↥E L x) = algebraMap ↥E L (φ x) := fun _ => rfl
  have hρ0 : Fr.ρ ≠ 0 := Fr.ρ_ne
  set aK : K := (Fr.ρ ^ (m + 1))⁻¹ with haK
  have haK0 : aK ≠ 0 := inv_ne_zero (pow_ne_zero _ hρ0)
  set aE : ↥E := ⟨algebraMap K L aK, IntermediateField.algebraMap_mem _ _⟩ with haE
  have haE0 : aE ≠ 0 := by
    intro h
    exact ((map_ne_zero_iff _ (algebraMap K L).injective).mpr haK0) (congrArg Subtype.val h)
  set bE : ↥E := ⟨Fr.towerDefect u b m, Fr.towerDefect_mem u b m⟩ with hbE
  have hσt : Fr.σ (Fr.d^[m] u)
      = algebraMap ↥E L aE * Fr.d^[m] u + algebraMap ↥E L bE :=
    Fr.sigma_jet_eq_defect hu m
  set cE : ↥E := ⟨algebraMap K L c, IntermediateField.algebraMap_mem _ _⟩ with hcE
  have hcE0 : cE ≠ 0 := by
    intro h
    exact ((map_ne_zero_iff _ (algebraMap K L).injective).mpr hc) (congrArg Subtype.val h)
  set αE : ↥E := ⟨algebraMap K L α, IntermediateField.algebraMap_mem _ _⟩ with hαE
  set βE : ↥E := ⟨β, hβmem⟩ with hβE
  have hrelE : Fr.σ W = algebraMap ↥E L cE * W
      + (algebraMap ↥E L αE * Fr.d^[m] u + algebraMap ↥E L βE) := hrel
  have hWmem' : W ∈ IntermediateField.adjoin ↥E ({Fr.d^[m] u} : Set L) := by
    have := (jetPrefixField_succ_eq Fr u m) ▸ hWmem
    exact this
  have hres :=
    affine_eigen_dichotomy_split (E := ↥E) Fr.σ φ hcompE htr haE0 hcE0 hσt hW0 hWmem' hrelE
  have haKL : algebraMap K L aK ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr haK0
  have hcL : algebraMap K L c ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr hc
  have hpowK : (Fr.ρ : K) ^ (m + 1) ≠ 0 := pow_ne_zero _ hρ0
  have hpowL : algebraMap K L (Fr.ρ ^ (m + 1)) ≠ 0 :=
    (map_ne_zero_iff _ (algebraMap K L).injective).mpr hpowK
  have haKinv : algebraMap K L aK * algebraMap K L (Fr.ρ ^ (m + 1)) = 1 := by
    rw [← map_mul, haK, inv_mul_cancel₀ hpowK, map_one]
  rcases hres with ⟨hα0, x, hx⟩ | h2 | ⟨w, N, hw0, hN, hconn⟩ | ⟨v, Z, Y, hv0, hαne, hveq, hZ, -⟩ |
    ⟨v, pp, hv0, hWsplit, hveq, hpp⟩
  · refine Or.inl ⟨?_, ?_⟩
    · have h := congrArg (fun z : ↥E => (z : L)) hα0
      simp only [hαE] at h
      exact (algebraMap K L).injective (by simpa using h)
    · rw [hx]; exact x.2
  · exact Or.inr (Or.inl h2)
  · refine Or.inr (Or.inr (Or.inl ⟨(w : L), N, ?_, w.2, hN, ?_⟩))
    · intro h
      exact hw0 (Subtype.ext (by simpa using h))
    · have hcast := congrArg (fun z : ↥E => (z : L)) hconn
      simp only [hφ, haE, hbE] at hcast
      push_cast at hcast
      linear_combination hcast
  · have hvL : (v : L) ≠ 0 := fun h => hv0 (Subtype.ext (by simpa using h))
    refine Or.inr (Or.inr (Or.inr (Or.inl ⟨(v : L), (Z : L), hvL, v.2, Z.2, ?_, ?_, ?_⟩)))
    · intro h
      refine hαne (Subtype.ext ?_)
      simp [hαE, h]
    · have hcast := congrArg (fun z : ↥E => (z : L)) hveq
      simp only [hφ, haE, hcE] at hcast
      push_cast at hcast
      have h2 : (algebraMap K L aK) ^ (2 : ℕ) * (algebraMap K L (Fr.ρ ^ (m + 1))) ^ (2 : ℕ) = 1 := by
        rw [← mul_pow, haKinv, one_pow]
      rw [map_mul, map_pow]
      linear_combination (algebraMap K L (Fr.ρ ^ (m + 1))) ^ (2 : ℕ) * hcast - Fr.σ (v : L) * h2
    · have hcast := congrArg (fun z : ↥E => (z : L)) hZ
      simp only [hφ, haE, hcE, hαE, hbE] at hcast
      push_cast at hcast
      have hbridge : algebraMap K L (aK * α / c) / (v : L)
          = algebraMap K L aK * algebraMap K L α / (algebraMap K L c * (v : L)) := by
        rw [map_div₀, map_mul, div_div]
      rw [hbridge]
      have h2E : ((2 : ↥E) : L) = 2 := rfl
      rw [h2E] at hcast
      linear_combination hcast
  · have hvL : (v : L) ≠ 0 := fun h => hv0 (Subtype.ext (by simpa using h))
    refine Or.inr (Or.inr (Or.inr (Or.inr
      ⟨(v : L), (pp : L), hvL, v.2, pp.2, hWsplit, ?_, ?_⟩)))
    · have hcast := congrArg (fun z : ↥E => (z : L)) hveq
      simp only [hφ, haE, hcE, hαE] at hcast
      push_cast at hcast
      rw [map_mul, map_mul]
      linear_combination algebraMap K L (Fr.ρ ^ (m + 1)) * hcast - Fr.σ (v : L) * haKinv
    · have hcast := congrArg (fun z : ↥E => (z : L)) hpp
      simp only [hφ, hcE, hbE, hβE] at hcast
      push_cast at hcast
      linear_combination hcast

end RittFrame

end GaloisForLFunctions.HTGeometry
