import GaloisForLFunctions.HTGeometry.SpecializationDescent

/-!
# Descent along a specialisation, several generators at a time

Two specialisations of a subalgebra that agree on the base and on a set of elements agree at every
element of the subalgebra lying in the subfield that set generates — provided one of them does not
kill any nonzero element of the subalgebra generated by that set.

The proviso is the whole content.  An element of the generated subfield is a fraction in the
generators, and the two specialisations agree at numerator and denominator; the only way the value
can fail to be determined is that the denominator is killed.  For a single generator that is
excluded by a Bézout identity, which is the one-variable statement.  For several generators there is
no such identity, and the correct replacement is faithfulness: a specialisation to a *generic* point
of a component, rather than to a closed point, kills nothing, and then the fraction is determined.

This is the form the rational-descent step of a fibre argument actually needs: a witness with two
components over the same generic data proves that a coordinate separating the components is not a
rational function of that data.
-/

namespace GaloisForLFunctions.HTGeometry

open IntermediateField

variable {F L M : Type*} [Field F] [Field L] [Algebra F L] [Field M]

/-- **Two specialisations agreeing on the base and on a set agree on the subalgebra it
generates.** -/
theorem eq_on_adjoin (O : Subalgebra F L) (π₁ π₂ : O →+* M)
    (hF : ∀ a : F, π₁ (algebraMap F O a) = π₂ (algebraMap F O a))
    {S : Set O} (hS : ∀ s ∈ S, π₁ s = π₂ s) :
    ∀ b ∈ Algebra.adjoin F S, π₁ b = π₂ b := by
  intro b hb
  induction hb using Algebra.adjoin_induction with
  | mem x hx => exact hS x hx
  | algebraMap r => exact hF r
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, map_mul, hx, hy]

/-- **Every element of the subfield generated by a set is a fraction of elements of the subalgebra
generated by it.** -/
theorem exists_frac_of_mem_adjoin (O : Subalgebra F L) {S : Set O} {v : L}
    (hv : v ∈ IntermediateField.adjoin F ((↑) '' S : Set L)) :
    ∃ a b : O, a ∈ Algebra.adjoin F S ∧ b ∈ Algebra.adjoin F S ∧ (a : L) / (b : L) = v := by
  rw [← IntermediateField.mem_toSubfield, IntermediateField.adjoin_toSubfield] at hv
  obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.1 hv
  have himg : ∀ w : L, w ∈ Subring.closure (Set.range (algebraMap F L) ∪ ((↑) '' S : Set L)) →
      ∃ c : O, c ∈ Algebra.adjoin F S ∧ (c : L) = w := by
    intro w hw
    rw [← Algebra.adjoin_eq_ring_closure, Subalgebra.mem_toSubring,
      show ((↑) '' S : Set L) = (O.val) '' S from rfl, Algebra.adjoin_image] at hw
    obtain ⟨c, hc, hcw⟩ := Subalgebra.mem_map.1 hw
    exact ⟨c, hc, hcw⟩
  obtain ⟨a, ha, hay⟩ := himg y hy
  obtain ⟨b, hb, hbz⟩ := himg z hz
  exact ⟨a, b, ha, hb, by rw [hay, hbz, hyz]⟩

/-- **Descent along a faithful-denominator specialisation.**  If one of the two specialisations
kills no nonzero element of the subalgebra generated by the data, then the two agree at every
element of the subfield generated by the data. -/
theorem eq_of_mem_adjoin_set (O : Subalgebra F L) (π₁ π₂ : O →+* M)
    (hF : ∀ a : F, π₁ (algebraMap F O a) = π₂ (algebraMap F O a))
    {S : Set O} (hS : ∀ s ∈ S, π₁ s = π₂ s)
    (hker : ∀ b ∈ Algebra.adjoin F S, (b : L) ≠ 0 → π₁ b ≠ 0)
    {v : O} (hv : (v : L) ∈ IntermediateField.adjoin F ((↑) '' S : Set L)) :
    π₁ v = π₂ v := by
  obtain ⟨a, b, ha, hb, hab⟩ := exists_frac_of_mem_adjoin O hv
  by_cases hb0 : (b : L) = 0
  · rw [hb0, div_zero] at hab
    have hv0 : v = 0 := Subtype.ext hab.symm
    rw [hv0, map_zero, map_zero]
  · have hvb : v * b = a := by
      refine Subtype.ext ?_
      rw [Subalgebra.coe_mul, ← hab, div_mul_cancel₀ _ hb0]
    have h1 : π₁ v * π₁ b = π₁ a := by rw [← map_mul, hvb]
    have h2 : π₂ v * π₂ b = π₂ a := by rw [← map_mul, hvb]
    rw [← eq_on_adjoin O π₁ π₂ hF hS b hb, ← eq_on_adjoin O π₁ π₂ hF hS a ha] at h2
    exact mul_right_cancel₀ (hker b hb hb0) (h1.trans h2.symm)

/-- **Rational descent along several generators.** -/
theorem not_mem_adjoin_set_of_ne (O : Subalgebra F L) (π₁ π₂ : O →+* M)
    (hF : ∀ a : F, π₁ (algebraMap F O a) = π₂ (algebraMap F O a))
    {S : Set O} (hS : ∀ s ∈ S, π₁ s = π₂ s)
    (hker : ∀ b ∈ Algebra.adjoin F S, (b : L) ≠ 0 → π₁ b ≠ 0)
    {v : O} (hne : π₁ v ≠ π₂ v) :
    (v : L) ∉ IntermediateField.adjoin F ((↑) '' S : Set L) :=
  fun hv => hne (eq_of_mem_adjoin_set O π₁ π₂ hF hS hker hv)

/-- **Rational descent from a generic point.**  A faithful specialisation kills nothing, so the
denominator hypothesis is automatic: if one of the two specialisations is injective, an element they
separate is not a rational function of data they agree on. -/
theorem not_mem_adjoin_set_of_ne_of_injective (O : Subalgebra F L) (π₁ π₂ : O →+* M)
    (hF : ∀ a : F, π₁ (algebraMap F O a) = π₂ (algebraMap F O a))
    {S : Set O} (hS : ∀ s ∈ S, π₁ s = π₂ s) (hinj : Function.Injective π₁)
    {v : O} (hne : π₁ v ≠ π₂ v) :
    (v : L) ∉ IntermediateField.adjoin F ((↑) '' S : Set L) := by
  refine not_mem_adjoin_set_of_ne O π₁ π₂ hF hS (fun b _ hb0 hcon => hb0 ?_) hne
  have : b = 0 := hinj (by rw [hcon, map_zero])
  rw [this, ZeroMemClass.coe_zero]

/-- **The algebra-map form**, where agreement on the base is automatic. -/
theorem not_mem_adjoin_set_of_ne_algHom [Algebra F M] (O : Subalgebra F L)
    (π₁ π₂ : O →ₐ[F] M) {S : Set O} (hS : ∀ s ∈ S, π₁ s = π₂ s) (hinj : Function.Injective π₁)
    {v : O} (hne : π₁ v ≠ π₂ v) :
    (v : L) ∉ IntermediateField.adjoin F ((↑) '' S : Set L) :=
  not_mem_adjoin_set_of_ne_of_injective O π₁.toRingHom π₂.toRingHom
    (fun a => by simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]) hS hinj hne

/-! ## A worked instance

The hypotheses are satisfiable with more than one generator, and the conclusion is not vacuous: the
identity and the shift of the last variable agree on the other two and separate it.
-/

section Instance

open MvPolynomial

variable (K : Type*) [Field K]

/-- The polynomial algebra in three variables, inside its fraction field. -/
noncomputable abbrev threeVarAlgebra : Subalgebra K (FractionRing (MvPolynomial (Fin 3) K)) :=
  (IsScalarTower.toAlgHom K (MvPolynomial (Fin 3) K)
    (FractionRing (MvPolynomial (Fin 3) K))).range

noncomputable def threeVarEquiv :
    MvPolynomial (Fin 3) K ≃ₐ[K] threeVarAlgebra K :=
  AlgEquiv.ofInjective _ (IsFractionRing.injective (MvPolynomial (Fin 3) K)
    (FractionRing (MvPolynomial (Fin 3) K)))

/-- The shift of the last variable, as a map on the subalgebra. -/
noncomputable def threeVarShift :
    threeVarAlgebra K →ₐ[K] FractionRing (MvPolynomial (Fin 3) K) :=
  (MvPolynomial.aeval
      ![algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0),
        algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1),
        algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2)
          + 1]).comp
    (threeVarEquiv K).symm.toAlgHom

theorem threeVarEquiv_coe (p : MvPolynomial (Fin 3) K) :
    ((threeVarEquiv K p : threeVarAlgebra K) : FractionRing (MvPolynomial (Fin 3) K))
      = algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) p := rfl

theorem threeVarShift_gen (i : Fin 3) :
    threeVarShift K (threeVarEquiv K (X i))
      = ![algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0),
          algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1),
          algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2)
            + 1] i := by
  simp [threeVarShift]

/-- **The multi-generator descent is not vacuous.**  The inclusion and the shift of the last
variable agree on the base and on the first two variables, and the inclusion is faithful, so the last
variable is not a rational function of the first two. -/
theorem X_two_not_mem_adjoin_X_zero_X_one :
    algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2) ∉
      IntermediateField.adjoin K
        ({algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0),
          algebraMap (MvPolynomial (Fin 3) K)
            (FractionRing (MvPolynomial (Fin 3) K)) (X 1)} :
          Set (FractionRing (MvPolynomial (Fin 3) K))) := by
  have himage : ((↑) '' ({threeVarEquiv K (X 0), threeVarEquiv K (X 1)} : Set (threeVarAlgebra K)) :
      Set (FractionRing (MvPolynomial (Fin 3) K)))
      = {algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 0),
         algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 1)} := by
    rw [Set.image_pair, threeVarEquiv_coe, threeVarEquiv_coe]
  rw [← himage, ← threeVarEquiv_coe]
  refine not_mem_adjoin_set_of_ne_algHom (threeVarAlgebra K)
    (Subalgebra.val _) (threeVarShift K) ?_ Subtype.val_injective ?_
  · rintro s (rfl | rfl)
    · rw [Subalgebra.coe_val, threeVarEquiv_coe, threeVarShift_gen]
      rfl
    · rw [Subalgebra.coe_val, threeVarEquiv_coe, threeVarShift_gen]
      rfl
  · rw [Subalgebra.coe_val, threeVarEquiv_coe, threeVarShift_gen]
    refine fun hcon => one_ne_zero (α := FractionRing (MvPolynomial (Fin 3) K)) ?_
    have hzero :
        algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2) + 0
          = algebraMap (MvPolynomial (Fin 3) K) (FractionRing (MvPolynomial (Fin 3) K)) (X 2)
            + 1 := by
      rw [add_zero]
      exact hcon
    exact (add_left_cancel hzero).symm

end Instance

end GaloisForLFunctions.HTGeometry
