import GaloisForLFunctions.HTGeometry.AlgebraicGroupIsogenyTailCorollaries

/-!
# The Maurer–Cartan logarithmic derivative of the generic point

For the differential jet field `(K, δ)` of an integral commutative algebraic group `G` with generic
point `g ∈ G(K)`, the right Maurer–Cartan logarithmic derivative is the tangent vector at the
identity

`ℓ_δ(g) = G(ψ_δ)(g) · G(ι)(g)⁻¹ ∈ ker(G(K[ε]) → G(K))`,  `ψ_δ(a) = a + ε δa`, `ι(a) = a`.

Its coordinates are the values of the corresponding point derivation at the identity on generators
of the maximal ideal of `O_(G,e)`.  We prove

`coords(ℓ_δ(g)) = Σ_i ℓ_i c_i`,

where `ℓ_i` are the Maurer–Cartan coordinates of `δ` against the translation-invariant derivations
`D_i` and `c_i ∈ C^r` are the (constant, `C`-linearly independent) coordinates of the invariant
tangent vectors of the `D_i`.  Consequently the differential field generated by the coordinates of
`ℓ_δ(g)` is the velocity field `C⟨ℓ⟩`.
-/

open CategoryTheory Limits AlgebraicGeometry Opposite
open MonoidalCategory CartesianMonoidalCategory MonObj
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C : Type u} [Field C] (G : Over (Spec (.of C))) [GrpObj G] [IsIntegral G.left]

section BaseChange

variable (L : Type u) [Field L] [Algebra C L] [Algebra G.left.functionField L]
  [IsScalarTower C G.left.functionField L]

/-- `F[ε] → L[ε]`, `a + εb ↦ a + εb`. -/
def dualBaseChange : DualL G.left.functionField →ₐ[C] DualL L where
  toFun p := TrivSqZeroExt.inl (algebraMap _ L p.fst) + TrivSqZeroExt.inr (algebraMap _ L p.snd)
  map_one' := TrivSqZeroExt.ext (by simp) (by simp)
  map_mul' p q := TrivSqZeroExt.ext (by simp) (by
    simp only [TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_add,
      TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, TrivSqZeroExt.fst_inl,
      TrivSqZeroExt.fst_inr, add_zero, zero_add, smul_eq_mul, MulOpposite.smul_eq_mul_unop,
      MulOpposite.unop_op, map_add, map_mul])
  map_zero' := TrivSqZeroExt.ext (by simp) (by simp)
  map_add' p q := TrivSqZeroExt.ext (by simp) (by simp [Algebra.algebraMap_eq_smul_one, add_smul])
  commutes' c := TrivSqZeroExt.ext (by
    change algebraMap _ L (algebraMap C G.left.functionField c) + 0 = algebraMap C L c
    rw [add_zero, ← IsScalarTower.algebraMap_apply]) (by
    change 0 + algebraMap _ L 0 = 0
    simp)

omit [GrpObj G] in
@[simp]
theorem dualBaseChange_fst (p : DualL G.left.functionField) :
    (dualBaseChange G L p).fst = algebraMap _ L p.fst := by
  simp [dualBaseChange]

omit [GrpObj G] in
@[simp]
theorem dualBaseChange_snd (p : DualL G.left.functionField) :
    (dualBaseChange G L p).snd = algebraMap _ L p.snd := by
  simp [dualBaseChange, Algebra.algebraMap_eq_smul_one]

omit [GrpObj G] in
theorem dualBaseChange_comp_dualGraph
    (D : Derivation C G.left.functionField G.left.functionField) :
    (dualBaseChange G L).comp (dualGraph G G.left.functionField D) =
      dualGraph G L ((Algebra.linearMap G.left.functionField L).compDer D) :=
  AlgHom.ext fun a => TrivSqZeroExt.ext (by simp) (by simp)

omit [GrpObj G] in
theorem pointSourceMap_dualBaseChange_genericLift
    (D : Derivation C G.left.functionField G.left.functionField) :
    pointSourceMap (dualBaseChange G L) ≫ genericLift G G.left.functionField D =
      genericLift G L ((Algebra.linearMap G.left.functionField L).compDer D) := by
  rw [genericLift, genericLift, ← Category.assoc, ← pointSourceMap_comp,
    dualBaseChange_comp_dualGraph]

theorem pointSourceMap_dualBaseChange_tangentLift
    (D : Derivation C G.left.functionField G.left.functionField) :
    pointSourceMap (dualBaseChange G L) ≫ tangentLift G G.left.functionField D =
      tangentLift G L ((Algebra.linearMap G.left.functionField L).compDer D) := by
  have h := (pointPush G (dualBaseChange G L)).map_mul (genericLift G G.left.functionField D)
    (genericLift G G.left.functionField 0)⁻¹
  rw [map_inv, pointPush_apply, pointPush_apply, pointPush_apply,
    pointSourceMap_dualBaseChange_genericLift, pointSourceMap_dualBaseChange_genericLift] at h
  have h0 : (Algebra.linearMap G.left.functionField L).compDer
      (0 : Derivation C G.left.functionField G.left.functionField) = 0 := by
    ext a
    simp
  rw [h0] at h
  exact h

variable [LocallyOfFiniteType G.hom]

/-- **Tangent coordinates commute with extension of scalars.** -/
theorem tangentCoords_compDer (D : Derivation C G.left.functionField G.left.functionField)
    (k : Fin (tangentRank G)) :
    tangentCoords G L ((Algebra.linearMap G.left.functionField L).compDer D) k =
      algebraMap _ L (tangentCoords G G.left.functionField D k) := by
  have hsf : CommRingCat.ofHom (dualBaseChange G L).toRingHom ≫
      CommRingCat.ofHom (sqzFst (C := C) (L := L) (M := L)).toRingHom =
      CommRingCat.ofHom (sqzFst (C := C) (L := G.left.functionField)
        (M := G.left.functionField)).toRingHom ≫
        CommRingCat.ofHom (algebraMap G.left.functionField L) :=
    CommRingCat.hom_ext (RingHom.ext fun p => by simp)
  have hev : identityEvalAt G G.left.functionField ≫
      CommRingCat.ofHom (algebraMap G.left.functionField L) = identityEvalAt G L :=
    CommRingCat.hom_ext (RingHom.ext fun a =>
      (IsScalarTower.algebraMap_apply C G.left.functionField L _).symm)
  have hfst : (tangentChi G G.left.functionField D ≫
      CommRingCat.ofHom (dualBaseChange G L).toRingHom) ≫
      CommRingCat.ofHom (sqzFst (C := C) (L := L) (M := L)).toRingHom = identityEvalAt G L := by
    rw [Category.assoc, hsf, ← Category.assoc, tangentChi_fst, hev]
  haveI := isLocalHom_of_comp_sqzFst G _ (φ := identityEvalAt G L) hfst
  have hχ : tangentChi G L ((Algebra.linearMap G.left.functionField L).compDer D) =
      tangentChi G G.left.functionField D ≫ CommRingCat.ofHom (dualBaseChange G L).toRingHom := by
    have e : pointSourceMap (dualBaseChange G L) ≫ tangentLift G G.left.functionField D =
        pointSourceMap (dualBaseChange G L) ≫ stalkPoint G (identityCenter G)
          (tangentChi G G.left.functionField D) (tangentChi_const G G.left.functionField D) := by
      rw [← tangentLift_eq]
    rw [pointSourceMap_dualBaseChange_tangentLift, tangentLift_eq,
      pointSourceMap_comp_stalkPoint] at e
    exact stalkPoint_injective G e
  simp only [tangentCoords, hχ]
  change (dualBaseChange G L (tangentChi G G.left.functionField D (tangentGenerators G k))).snd = _
  simp

end BaseChange

/-! ### The Maurer–Cartan point -/

variable [LocallyOfFiniteType G.hom] [CharZero C]

/-- **The right Maurer–Cartan logarithmic derivative of the generic point**,
`ℓ_δ(g) = G(ψ_δ)(g) · G(ι)(g)⁻¹`, a `K[ε]`-point of `G` reducing to the identity. -/
def maurerCartanPoint : algebraicPointSource (K := C) (R := DualL (GroupJetField G)) ⟶ G :=
  (pointSourceMap (derivationGraphAlgHom (groupJetDerivation G)) ≫
      genericPointAt G (GroupJetField G)) *
    (pointSourceMap (dualInl (C := C) (L := GroupJetField G)) ≫
      genericPointAt G (GroupJetField G))⁻¹

/-- The restriction `δ|_F : F → K`. -/
abbrev jetDerivationOnFunctions : Derivation C G.left.functionField (GroupJetField G) :=
  (groupJetDerivation G).compAlgebraMap G.left.functionField

theorem maurerCartanPoint_eq_tangentLift :
    maurerCartanPoint G = tangentLift G (GroupJetField G) (jetDerivationOnFunctions G) := by
  have h1 : pointSourceMap (derivationGraphAlgHom (groupJetDerivation G)) ≫
      genericPointAt G (GroupJetField G) =
        genericLift G (GroupJetField G) (jetDerivationOnFunctions G) := by
    rw [genericPointAt, ← Category.assoc, ← pointSourceMap_comp, genericLift]
    congr 2
  have h2 : pointSourceMap (dualInl (C := C) (L := GroupJetField G)) ≫
      genericPointAt G (GroupJetField G) = genericLift G (GroupJetField G) 0 := by
    rw [genericPointAt, ← Category.assoc, ← pointSourceMap_comp, dualGraph_zero, genericLift]
  rw [maurerCartanPoint, h1, h2]
  rfl

attribute [local instance] trivialDifferential

omit [GrpObj G] in
/-- A differential adjoin is contained in every derivation-closed intermediate field containing its
generators. -/
theorem differentialAdjoin_le_of_derivationClosed {S : Set (GroupJetField G)}
    {L : IntermediateField C (GroupJetField G)} (hL : DerivationClosed L) (hS : S ⊆ L) :
    differentialAdjoin C S ≤ L := by
  refine IntermediateField.adjoin_le_iff.mpr ?_
  rintro _ ⟨y, hy, n, rfl⟩
  induction n with
  | zero => exact hS hy
  | succ n ih => rw [differentialJet_succ]; exact hL ih

omit [GrpObj G] in
/-- Two generating sets that generate each other generate the same differential field. -/
theorem differentialAdjoin_eq_of_mutual {X Y : Set (GroupJetField G)}
    (hXY : X ⊆ differentialAdjoin C Y) (hYX : Y ⊆ differentialAdjoin C X) :
    differentialAdjoin C X = differentialAdjoin C Y :=
  le_antisymm (differentialAdjoin_le_of_derivationClosed G (derivationClosed_differentialAdjoin C Y)
      hXY)
    (differentialAdjoin_le_of_derivationClosed G (derivationClosed_differentialAdjoin C X) hYX)

variable [IsCommMonObj G] [IsAlgClosed C]

omit [LocallyOfFiniteType G.hom] [CharZero C] [IsAlgClosed C] [IsCommMonObj G] in
theorem conjDerivation_eq_of_isTranslationInvariant
    {D : Derivation C G.left.functionField G.left.functionField} (hD : IsTranslationInvariant G D)
    (x : 𝟙_ (Over (Spec (.of C))) ⟶ G) : conjDerivation (groupTranslationAlgEquiv G x) D = D := by
  ext a
  rw [conjDerivation_apply, ← hD x, AlgEquiv.apply_symm_apply]

omit [CharZero C] in
/-- **The invariant tangent vectors have constant coordinates.** -/
theorem tangentCoords_mem_range_of_isTranslationInvariant
    {D : Derivation C G.left.functionField G.left.functionField} (hD : IsTranslationInvariant G D)
    (k : Fin (tangentRank G)) :
    tangentCoords G G.left.functionField D k ∈ Set.range (algebraMap C G.left.functionField) :=
  mem_range_algebraMap_of_translation_fixed G _ fun x => by
    rw [← tangentCoords_conjDerivation, conjDerivation_eq_of_isTranslationInvariant G hD]

/-- The constant coordinates `c_i` of the invariant tangent vectors. -/
def invariantTangentCoords (i : Fin (groupDim G)) (k : Fin (tangentRank G)) : C :=
  (tangentCoords_mem_range_of_isTranslationInvariant G (mcDerivation_invariant G i) k).choose

theorem algebraMap_invariantTangentCoords (i : Fin (groupDim G)) (k : Fin (tangentRank G)) :
    algebraMap C G.left.functionField (invariantTangentCoords G i k) =
      tangentCoords G G.left.functionField (mcDerivation G i) k :=
  (tangentCoords_mem_range_of_isTranslationInvariant G (mcDerivation_invariant G i) k).choose_spec

omit [IsAlgClosed C] in
theorem jetDerivationOnFunctions_eq_sum :
    jetDerivationOnFunctions G = ∑ i, mcVelocity G i •
      (Algebra.linearMap G.left.functionField (GroupJetField G)).compDer (mcDerivation G i) := by
  ext a
  rw [Derivation.compAlgebraMap_apply, groupJetDerivation_eq_sum_mcVelocity]
  rw [← Derivation.coeFnAddMonoidHom_apply, map_sum, Finset.sum_apply]
  rfl

/-- **The coordinates of the Maurer–Cartan logarithmic derivative**:
`coords(ℓ_δ(g))_k = Σ_i ℓ_i c_(i,k)`. -/
theorem tangentCoords_jetDerivationOnFunctions (k : Fin (tangentRank G)) :
    tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G) k =
      ∑ i, mcVelocity G i * algebraMap C (GroupJetField G) (invariantTangentCoords G i k) := by
  have h : tangentCoordsLinear G (GroupJetField G) (jetDerivationOnFunctions G) =
      tangentCoordsLinear G (GroupJetField G) (∑ i, mcVelocity G i •
        (Algebra.linearMap G.left.functionField (GroupJetField G)).compDer (mcDerivation G i)) := by
    rw [← jetDerivationOnFunctions_eq_sum]
  rw [map_sum] at h
  have hk := congrFun h k
  change tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G) k = _ at hk
  rw [hk, Finset.sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, Pi.smul_apply, smul_eq_mul]
  change mcVelocity G i * tangentCoords G (GroupJetField G) _ k = _
  rw [tangentCoords_compDer, ← algebraMap_invariantTangentCoords,
    ← IsScalarTower.algebraMap_apply]

omit [IsAlgClosed C] in
/-- The invariant derivations are linearly independent over `F`. -/
theorem mcDerivation_linearIndependent :
    LinearIndependent G.left.functionField (mcDerivation G) := by
  rw [Fintype.linearIndependent_iff]
  intro a ha
  have h := eq_zero_of_sum_mul_derivationMatrix (mcDerivation_det_ne_zero G)
    (RingHom.id G.left.functionField) a (fun j => by
      have := congrArg (fun E : Derivation C G.left.functionField G.left.functionField =>
        E (groupBasis G j)) ha
      simp only [Derivation.zero_apply] at this
      rw [← Derivation.coeFnAddMonoidHom_apply, map_sum, Finset.sum_apply] at this
      rw [← this]
      exact Finset.sum_congr rfl fun i _ => by rfl)
  exact congrFun h

/-- **The constant coordinate vectors `c_i` are linearly independent over `C`.** -/
theorem invariantTangentCoords_linearIndependent :
    LinearIndependent C (invariantTangentCoords G) := by
  rw [Fintype.linearIndependent_iff]
  intro b hb
  have hsum : ∑ i, algebraMap C G.left.functionField (b i) • mcDerivation G i = 0 := by
    apply tangentCoordsLinear_injective G G.left.functionField
    rw [map_sum, map_zero]
    funext k
    rw [Finset.sum_apply, Pi.zero_apply]
    have hk := congrFun hb k
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hk
    have := congrArg (algebraMap C G.left.functionField) hk
    rw [map_sum, map_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, Pi.smul_apply, smul_eq_mul, map_mul]
    change _ * tangentCoords G G.left.functionField (mcDerivation G i) k = _
    rw [← algebraMap_invariantTangentCoords]
  have := (Fintype.linearIndependent_iff.mp (mcDerivation_linearIndependent G)) _ hsum
  intro i
  exact (algebraMap C G.left.functionField).injective (by rw [this i, map_zero])

/-- **The Maurer–Cartan velocity is recovered from the coordinates of `ℓ_δ(g)`.** -/
theorem exists_mcVelocity_eq_sum_coords :
    ∃ M : Fin (groupDim G) → Fin (tangentRank G) → C, ∀ i, mcVelocity G i =
      ∑ k, algebraMap C (GroupJetField G) (M i k) *
        tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G) k := by
  classical
  let Φ : (Fin (groupDim G) → C) →ₗ[C] (Fin (tangentRank G) → C) :=
    Fintype.linearCombination C (invariantTangentCoords G)
  have hΦ : LinearMap.ker Φ = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro v hv
    funext i
    exact (Fintype.linearIndependent_iff.mp (invariantTangentCoords_linearIndependent G)) v
      (by rw [← Fintype.linearCombination_apply]; exact hv) i
  obtain ⟨Ψ, hΨ⟩ := Φ.exists_leftInverse_of_injective hΦ
  let M : Fin (groupDim G) → Fin (tangentRank G) → C := fun i k => Ψ (Pi.single k 1) i
  have hcol : ∀ i j, (∑ k, M i k * invariantTangentCoords G j k) = if i = j then 1 else 0 := by
    intro i j
    have hΨj := congrFun (LinearMap.congr_fun hΨ (Pi.single j 1)) i
    rw [LinearMap.comp_apply, LinearMap.id_apply, Fintype.linearCombination_apply_single,
      one_smul] at hΨj
    rw [pi_eq_sum_univ' (invariantTangentCoords G j), map_sum, Finset.sum_apply] at hΨj
    rw [Pi.single_apply, eq_comm] at hΨj
    rw [hΨj]
    exact Finset.sum_congr rfl fun k _ => by
      rw [map_smul, Pi.smul_apply, smul_eq_mul, mul_comm]
  refine ⟨M, fun i => ?_⟩
  have hterm : ∀ k, algebraMap C (GroupJetField G) (M i k) *
      tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G) k =
      ∑ j, mcVelocity G j *
        algebraMap C (GroupJetField G) (M i k * invariantTangentCoords G j k) := by
    intro k
    rw [tangentCoords_jetDerivationOnFunctions, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by rw [map_mul]; ring
  rw [Finset.sum_congr rfl fun k _ => hterm k, Finset.sum_comm]
  have hj : ∀ j, (∑ k, mcVelocity G j *
      algebraMap C (GroupJetField G) (M i k * invariantTangentCoords G j k)) =
      mcVelocity G j * algebraMap C (GroupJetField G) (if i = j then 1 else 0) := by
    intro j
    rw [← Finset.mul_sum, ← map_sum, hcol]
  rw [Finset.sum_congr rfl fun j _ => hj j, Finset.sum_eq_single i]
  · rw [if_pos rfl, map_one, _root_.mul_one]
  · intro j _ hji
    rw [if_neg (Ne.symm hji), map_zero, MulZeroClass.mul_zero]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- **The coordinates of the Maurer–Cartan logarithmic derivative and the velocity `ℓ` generate the
same differential field together with any positions.** -/
theorem differentialAdjoin_union_mcPoint (S : Set (GroupJetField G)) :
    differentialAdjoin C (S ∪ Set.range (tangentCoords G (GroupJetField G)
      (jetDerivationOnFunctions G))) = differentialAdjoin C (S ∪ Set.range (mcVelocity G)) := by
  obtain ⟨M, hM⟩ := exists_mcVelocity_eq_sum_coords G
  apply differentialAdjoin_eq_of_mutual G
  · rintro _ (hs | ⟨k, rfl⟩)
    · exact subset_differentialAdjoin C _ (Or.inl hs)
    · rw [tangentCoords_jetDerivationOnFunctions]
      exact IntermediateField.sum_mem _ fun i _ => IntermediateField.mul_mem _
        (subset_differentialAdjoin C _ (Or.inr ⟨i, rfl⟩)) (IntermediateField.algebraMap_mem _ _)
  · rintro _ (hs | ⟨i, rfl⟩)
    · exact subset_differentialAdjoin C _ (Or.inl hs)
    · rw [hM i]
      exact IntermediateField.sum_mem _ fun k _ => IntermediateField.mul_mem _
        (IntermediateField.algebraMap_mem _ _) (subset_differentialAdjoin C _ (Or.inr ⟨k, rfl⟩))

variable (α : G ⟶ G) [IsIsogeny G α]

omit [IsIsogeny G α] in
/-- **Theorem B with the Maurer–Cartan logarithmic derivative**:
`K^(H(C)) = C⟨F^(H(C)), ℓ_δ(g)⟩`, the differential field generated by the invariant positions and
the coordinates of the Maurer–Cartan point `ℓ_δ(g) = G(ψ_δ)(g) · G(ι)(g)⁻¹`. -/
theorem deckClosure_fixed_iff_mem_differentialAdjoin_maurerCartanPoint (u : GroupJetField G) :
    (∀ x ∈ deckClosurePoints G α, jetTranslation G x u = u) ↔
      u ∈ differentialAdjoin C (algebraMap _ (GroupJetField G) '' deckClosurePositions G α ∪
        Set.range (tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G))) := by
  rw [differentialAdjoin_union_mcPoint, deckClosure_fixed_iff_mem_differentialAdjoin]

/-- **Corollary C, (5) with the Maurer–Cartan logarithmic derivative**: if the iterated kernels are
Zariski dense, `Tail(α) = C⟨ℓ_δ(g)⟩`. -/
theorem mem_isogenyTail_iff_mem_differentialAdjoin_maurerCartanPoint
    (hdense : Dense (⋃ n, (fun c => rationalPointHom G c default) '' isogenyKernelPoints G α n))
    (u : GroupJetField G) :
    (∀ n, u ∈ Set.range ((⇑(jetIsogenyPullback G α))^[n])) ↔
      u ∈ differentialAdjoin C
        (Set.range (tangentCoords G (GroupJetField G) (jetDerivationOnFunctions G))) := by
  have h := differentialAdjoin_union_mcPoint G ∅
  rw [Set.empty_union, Set.empty_union] at h
  rw [h, mem_isogenyTail_iff_mem_velocityField G α hdense]

end

end GaloisForLFunctions.HTGeometry
