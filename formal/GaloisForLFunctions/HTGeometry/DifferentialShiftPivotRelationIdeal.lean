import GaloisForLFunctions.HTGeometry.DifferentialPolynomial

/-!
# Complete relation ideals for shifted differential pivots

This module computes the full jet-relation ideal when every dependent jet is a scalar multiple
of a possibly higher-order jet of one differentially independent pivot.  The shift in jet order
is the feature not covered by the same-order affine pivot theorem.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions MvPolynomial

noncomputable section

/-- The pivot monomial which replaces one dependent jet. -/
def differentialShiftPivotJet
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial B F :=
  MvPolynomial.C (c r n) * MvPolynomial.X (base r, n + offset r)

/-- Eliminate every dependent jet by its shifted pivot expression. -/
def differentialShiftPivotElimination
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) :
    DifferentialPolynomial (B ⊕ R) F →ₐ[F] DifferentialPolynomial B F :=
  MvPolynomial.bind₁ fun q ↦
    match q.1 with
    | Sum.inl b => MvPolynomial.X (b, q.2)
    | Sum.inr r => differentialShiftPivotJet base offset c r q.2

/-- Include pivot differential polynomials into the left variables of the full jet ring. -/
def differentialShiftPivotInclusion
    {F B R : Type*} [Field F] :
    DifferentialPolynomial B F →ₐ[F] DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.rename fun q ↦ (Sum.inl q.1, q.2)

@[simp]
theorem differentialShiftPivotElimination_X_inl
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) (b : B) (n : ℕ) :
    differentialShiftPivotElimination base offset c
        (MvPolynomial.X (Sum.inl b, n)) = MvPolynomial.X (b, n) := by
  simp [differentialShiftPivotElimination]

@[simp]
theorem differentialShiftPivotElimination_X_inr
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) (r : R) (n : ℕ) :
    differentialShiftPivotElimination base offset c
        (MvPolynomial.X (Sum.inr r, n)) = differentialShiftPivotJet base offset c r n := by
  simp [differentialShiftPivotElimination]

@[simp]
theorem differentialShiftPivotInclusion_X
    {F B R : Type*} [Field F] (b : B) (n : ℕ) :
    differentialShiftPivotInclusion (R := R) (MvPolynomial.X (b, n)) =
      (MvPolynomial.X (Sum.inl b, n) : DifferentialPolynomial (B ⊕ R) F) := by
  simp [differentialShiftPivotInclusion]

/-- Elimination is a left inverse to pivot inclusion. -/
@[simp]
theorem differentialShiftPivotElimination_inclusion
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F)
    (P : DifferentialPolynomial B F) :
    differentialShiftPivotElimination base offset c (differentialShiftPivotInclusion P) = P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [differentialShiftPivotElimination, differentialShiftPivotInclusion]
  | add P Q hP hQ => simp [hP, hQ]
  | mul_X P q hP =>
      rcases q with ⟨b, n⟩
      simp only [map_mul, hP, differentialShiftPivotInclusion_X,
        differentialShiftPivotElimination_X_inl]

/-- The displayed shifted relation for one dependent jet. -/
def differentialShiftPivotRelation
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.X (Sum.inr r, n) -
    differentialShiftPivotInclusion (differentialShiftPivotJet base offset c r n)

/-- The ideal generated by all shifted pivot jet relations. -/
def differentialShiftPivotRelationIdeal
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) :
    Ideal (DifferentialPolynomial (B ⊕ R) F) :=
  Ideal.span (Set.range fun rn : R × ℕ ↦
    differentialShiftPivotRelation base offset c rn.1 rn.2)

@[simp]
theorem differentialShiftPivotElimination_relation
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) (r : R) (n : ℕ) :
    differentialShiftPivotElimination base offset c
        (differentialShiftPivotRelation base offset c r n) = 0 := by
  simp [differentialShiftPivotRelation]

/-- Every polynomial differs from its eliminated pivot normal form by the displayed relations. -/
theorem sub_shiftPivotInclusion_elimination_mem_relationIdeal
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F)
    (P : DifferentialPolynomial (B ⊕ R) F) :
    P - differentialShiftPivotInclusion (differentialShiftPivotElimination base offset c P) ∈
      differentialShiftPivotRelationIdeal base offset c := by
  classical
  let I := differentialShiftPivotRelationIdeal base offset c
  induction P using MvPolynomial.induction_on with
  | C a =>
      change MvPolynomial.C a - differentialShiftPivotInclusion
        (differentialShiftPivotElimination base offset c (MvPolynomial.C a)) ∈ I
      simp [differentialShiftPivotElimination, differentialShiftPivotInclusion]
  | add P Q hP hQ =>
      change P + Q - differentialShiftPivotInclusion
        (differentialShiftPivotElimination base offset c (P + Q)) ∈ I
      have hadd := I.add_mem hP hQ
      convert hadd using 1 <;> simp <;> ring
  | mul_X P q hP =>
      rcases q with ⟨i, n⟩
      cases i with
      | inl b =>
          have hmul := Ideal.mul_mem_right (MvPolynomial.X (Sum.inl b, n)) I hP
          convert hmul using 1 <;> simp <;> ring
      | inr r =>
          have hgen : differentialShiftPivotRelation base offset c r n ∈ I :=
            Ideal.subset_span (Set.mem_range_self (r, n))
          have hmul₁ := Ideal.mul_mem_right (MvPolynomial.X (Sum.inr r, n)) I hP
          have hmul₂ := Ideal.mul_mem_left I
            (differentialShiftPivotInclusion
              (differentialShiftPivotElimination base offset c P)) hgen
          have hsum := I.add_mem hmul₁ hmul₂
          convert hsum using 1 <;>
            simp [differentialShiftPivotRelation] <;> ring

/-- The shifted pivot relation ideal is exactly the elimination kernel. -/
theorem differentialShiftPivotRelationIdeal_eq_ker
    {F B R : Type*} [Field F]
    (base : R → B) (offset : R → ℕ) (c : R → ℕ → F) :
    differentialShiftPivotRelationIdeal base offset c =
      RingHom.ker (differentialShiftPivotElimination base offset c).toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨r, n⟩, rfl⟩
    change differentialShiftPivotElimination base offset c
      (differentialShiftPivotRelation base offset c r n) = 0
    exact differentialShiftPivotElimination_relation base offset c r n
  · intro P hP
    have helim : differentialShiftPivotElimination base offset c P = 0 :=
      RingHom.mem_ker.mp hP
    have hnormal :=
      sub_shiftPivotInclusion_elimination_mem_relationIdeal base offset c P
    simpa [helim] using hnormal

/-- Evaluation of the combined family factors through shifted pivot elimination. -/
theorem differentialPolynomialEval_sumElim_eq_shiftPivotElimination
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (base : R → B) (offset : R → ℕ) (c : R → ℕ → F)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (c r n) * differentialJet (n + offset r) (x (base r)))
    (P : DifferentialPolynomial (B ⊕ R) F) :
    differentialPolynomialEval (C := F) (Sum.elim x y) P =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))
        (differentialShiftPivotElimination base offset c P) := by
  let left := differentialPolynomialEval (C := F) (Sum.elim x y)
  let right := (MvPolynomial.aeval
    (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))).comp
      (differentialShiftPivotElimination base offset c)
  have heq : left = right := by
    apply MvPolynomial.algHom_ext
    rintro ⟨i, n⟩
    cases i with
    | inl b => simp [left, right, differentialPolynomialEval]
    | inr r =>
        simp only [left, right, differentialPolynomialEval_X, Sum.elim_inr,
          AlgHom.coe_comp, Function.comp_apply, differentialShiftPivotElimination_X_inr]
        rw [hrel r n]
        simp [differentialShiftPivotJet]
  exact AlgHom.congr_fun heq P

/-- **Complete shifted-pivot relation theorem.** If the pivot family is differentially
independent and each dependent jet is a scalar multiple of a shifted pivot jet, the displayed
linear relations generate every relation of the combined family. -/
theorem differentialRelationIdeal_sumElim_eq_shiftPivot
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (base : R → B) (offset : R → ℕ) (c : R → ℕ → F)
    (hx : DifferentialIndependent F x)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (c r n) * differentialJet (n + offset r) (x (base r))) :
    differentialRelationIdeal (C := F) (Sum.elim x y) =
      differentialShiftPivotRelationIdeal base offset c := by
  rw [differentialShiftPivotRelationIdeal_eq_ker]
  ext P
  rw [mem_differentialRelationIdeal_iff, RingHom.mem_ker]
  rw [differentialPolynomialEval_sumElim_eq_shiftPivotElimination
    x y base offset c hrel P]
  constructor
  · intro hzero
    unfold DifferentialIndependent at hx
    exact hx.eq_zero_of_aeval_eq_zero _ hzero
  · intro hzero
    change differentialShiftPivotElimination base offset c P = 0 at hzero
    rw [hzero]
    exact map_zero _

end

end GaloisForLFunctions.HTGeometry
