import GaloisForLFunctions.HTGeometry.JetHorizonReconstruction

/-!
# The horizon tower is a tower of additive primitive extensions

Consecutive derivative horizons differ by one jet, and the derivative of that jet already lies in
the lower horizon: each adjoined jet solves the inhomogeneous additive equation `δ X = δ^{j+1} y`
with coefficient in the next horizon.  That is the equation whose additive Picard--Vessiot torsor
the successive-torsor law names, and combined with the additive-layer bound — a layer automorphism
moves the adjoined jet by a constant — it exhibits every step of the tower as an additive torsor.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C F : Type*} [Field C] [CharZero C] [Field F] [CharZero F] [Algebra C F]
  [Differential F]

/-- The depth-`j` horizon of a family. -/
def jetHorizon (C : Type*) [Field C] [Algebra C F] {ι : Type*} (y : ι → F) (j : ℕ) :
    IntermediateField C F :=
  differentialAdjoin C (Set.range fun i => differentialJet j (y i))

omit [CharZero C] [CharZero F] in
/-- The adjoined jet solves the additive equation of the next horizon. -/
theorem deriv_differentialJet_mem_jetHorizon_succ {ι : Type*} (y : ι → F) (j : ℕ) (i : ι) :
    (differentialJet j (y i))′ ∈ jetHorizon C y (j + 1) := by
  rw [← differentialJet_succ]
  exact subset_differentialAdjoin C _ ⟨i, rfl⟩

omit [CharZero C] [CharZero F] in
/-- The horizons decrease with depth. -/
theorem jetHorizon_succ_le (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    {ι : Type*} (y : ι → F) (j : ℕ) :
    jetHorizon C y (j + 1) ≤ jetHorizon C y j := by
  refine differentialAdjoin_le C ?_
    (derivationClosed_differentialAdjoin_of_constants C hC _)
  rintro x ⟨i, rfl⟩
  have hmem : differentialJet 1 (differentialJet j (y i)) ∈ jetHorizon C y j :=
    differentialJet_mem_differentialAdjoin C (Set.mem_range_self i) 1
  have heq : differentialJet 1 (differentialJet j (y i)) = differentialJet (j + 1) (y i) := by
    rw [← differentialJet_add 1 j (y i), Nat.add_comm]
  rwa [heq] at hmem

omit [CharZero C] [CharZero F] in
/-- A derivation-closed intermediate field contains every jet of each of its elements. -/
theorem differentialJet_mem_of_derivationClosed {K : IntermediateField C F}
    (hK : DerivationClosed K) : ∀ (m : ℕ) {x : F}, x ∈ K → differentialJet m x ∈ K := by
  intro m
  induction m with
  | zero => intro x hx; simpa using hx
  | succ m ih =>
      intro x hx
      rw [differentialJet_succ]
      exact hK (ih hx)

omit [CharZero C] [CharZero F] in
/-- **The layer identity, membership form.**  A differential field generated by a family whose
derivatives lie in a derivation-closed subfield is that subfield with the family adjoined.  Stated
as an equivalence of memberships, so that no restriction of scalars is formed. -/
theorem mem_differentialAdjoin_iff_mem_adjoin {ι : Type*} (w : ι → F)
    (K : IntermediateField C F) (hKclosed : DerivationClosed K) (hδ : ∀ i, (w i)′ ∈ K)
    (hKle : K ≤ differentialAdjoin C (Set.range w)) (x : F) :
    x ∈ differentialAdjoin C (Set.range w)
      ↔ x ∈ IntermediateField.adjoin (↥K) (Set.range w) := by
  classical
  constructor
  · intro hx
    rw [differentialAdjoin] at hx
    refine IntermediateField.adjoin_induction C
      (p := fun u _ => u ∈ IntermediateField.adjoin (↥K) (Set.range w)) ?_ ?_ ?_ ?_ ?_ hx
    · rintro u ⟨_, ⟨i, rfl⟩, m, rfl⟩
      cases m with
      | zero => simpa using IntermediateField.subset_adjoin (↥K) (Set.range w) ⟨i, rfl⟩
      | succ m =>
          have hmem : differentialJet m ((w i)′) ∈ K :=
            differentialJet_mem_of_derivationClosed hKclosed m (hδ i)
          have := IntermediateField.algebraMap_mem
            (IntermediateField.adjoin (↥K) (Set.range w)) (⟨_, hmem⟩ : ↥K)
          rw [differentialJet_succ_apply]
          exact this
    · intro c
      have hcK : algebraMap C F c ∈ K := K.algebraMap_mem c
      exact IntermediateField.algebraMap_mem
        (IntermediateField.adjoin (↥K) (Set.range w)) (⟨_, hcK⟩ : ↥K)
    · intro u v _ _ hu hv
      exact (IntermediateField.adjoin (↥K) (Set.range w)).add_mem hu hv
    · intro u _ hu
      exact (IntermediateField.adjoin (↥K) (Set.range w)).inv_mem hu
    · intro u v _ _ hu hv
      exact (IntermediateField.adjoin (↥K) (Set.range w)).mul_mem hu hv
  · intro hx
    refine IntermediateField.adjoin_induction (↥K)
      (p := fun u _ => u ∈ differentialAdjoin C (Set.range w)) ?_ ?_ ?_ ?_ ?_ hx
    · rintro u ⟨i, rfl⟩
      exact subset_differentialAdjoin C _ ⟨i, rfl⟩
    · intro c
      exact hKle c.2
    · intro u v _ _ hu hv
      exact (differentialAdjoin C (Set.range w)).add_mem hu hv
    · intro u _ hu
      exact (differentialAdjoin C (Set.range w)).inv_mem hu
    · intro u v _ _ hu hv
      exact (differentialAdjoin C (Set.range w)).mul_mem hu hv

omit [CharZero C] [CharZero F] in
/-- **The layer identity for the horizon tower.**  The depth-`j` horizon consists exactly of the
elements of the depth-`j+1` horizon with the depth-`j` jets adjoined. -/
theorem mem_jetHorizon_iff_mem_adjoin_succ (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    {ι : Type*} (y : ι → F) (j : ℕ) (x : F) :
    x ∈ jetHorizon C y j
      ↔ x ∈ IntermediateField.adjoin (↥(jetHorizon C y (j + 1)))
          (Set.range fun i => differentialJet j (y i)) :=
  mem_differentialAdjoin_iff_mem_adjoin (fun i => differentialJet j (y i))
    (jetHorizon C y (j + 1))
    (derivationClosed_differentialAdjoin_of_constants C hC _)
    (fun i => deriv_differentialJet_mem_jetHorizon_succ y j i)
    (jetHorizon_succ_le hC y j) x

end

end GaloisForLFunctions.HTGeometry
