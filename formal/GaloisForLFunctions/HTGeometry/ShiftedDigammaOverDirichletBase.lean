import GaloisForLFunctions.HTGeometry.DirichletShiftedDigammaCarrier

/-!
# Joint shifted-digamma independence over all convergent Dirichlet series

Pairwise distinct integer pole orbits remain independent after adjoining every Dirichlet
series of finite absolute-convergence abscissa. The arithmetic extension creates no new
rational shift coboundaries, so the full rational charge-matrix obstruction survives.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance shiftedDigammaDirichletDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring
local instance shiftedDigammaDirichletDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential
local instance shiftedDigammaDirichletComplex : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-- Any finite family of pairwise incongruent shifted digammas is differentially independent
over the actual field generated by the coordinate and all convergent Dirichlet series. -/
theorem differentialIndependent_shiftedRotDigamma_over_dirZetaBase
    {r : ℕ} (lam : Fin r → ℂ)
    (hincong : ∀ i i', i ≠ i' → ∀ n : ℤ, lam i - lam i' ≠ (n : ℂ)) :
    DifferentialIndependent (dirZetaBase : Type _)
      (fun i => shiftedRotDigammaMero (lam i)) := by
  classical
  unfold DifferentialIndependent
  apply algebraicIndependent_of_finite_type
  intro t ht
  letI : Fintype t := ht.fintype
  set N : ℕ := ht.toFinset.sup (fun p => p.2) with hN
  have hle : ∀ p ∈ t, p.2 < N + 1 := by
    intro p hp
    have : p.2 ≤ N := by
      rw [hN]
      exact Finset.le_sup (f := fun p : Fin r × ℕ => p.2) (by simpa using hp)
    omega
  let E : Fin r × Fin (N + 1) ≃ Fin (r * (N + 1)) := finProdFinEquiv
  let xj : Fin (r * (N + 1)) → upperEndMeroField :=
    fun k => differentialJet ((E.symm k).2 : ℕ) (shiftedRotDigammaMero (lam (E.symm k).1))
  let rj : ℕ → RatFunc ℂ := fun n =>
    if h : n < r * (N + 1) then
      algebraMap ℂ (RatFunc ℂ) ((-Complex.I) ^ ((E.symm ⟨n, h⟩).2 : ℕ)) *
        familyIncrement lam (E.symm ⟨n, h⟩).1 ((E.symm ⟨n, h⟩).2 : ℕ)
    else 0
  have hrjk : ∀ k : Fin (r * (N + 1)), rj (k : ℕ) =
      algebraMap ℂ (RatFunc ℂ) ((-Complex.I) ^ ((E.symm k).2 : ℕ)) *
        familyIncrement lam (E.symm k).1 ((E.symm k).2 : ℕ) := by
    intro k
    simp only [rj, k.isLt, dif_pos, Fin.eta]
  have hjet : ∀ k : Fin (r * (N + 1)),
      upperEndTranslationMeroEquiv Complex.I (xj k) = xj k + dirRatRealization (rj k) := by
    intro k
    rw [hrjk]
    exact shiftedRotDigammaJet_rational_shift lam (E.symm k).1 ((E.symm k).2 : ℕ)
  have hcharge : ∀ (w : RatFunc ℂ) (delta : Fin (r * (N + 1)) → ℂ),
      ratShift w - w = ∑ k, algebraMap ℂ (RatFunc ℂ) (delta k) * rj k →
        ∀ k, delta k = 0 := by
    intro w delta hw
    have hrewrite : (∑ k : Fin (r * (N + 1)),
        algebraMap ℂ (RatFunc ℂ) (delta k) * rj k) =
        ∑ i : Fin r, ∑ j : Fin (N + 1),
          algebraMap ℂ (RatFunc ℂ) (delta (E (i, j)) * (-Complex.I) ^ (j : ℕ)) *
            familyIncrement lam i (j : ℕ) := by
      rw [← Fintype.sum_prod_type']
      refine (Fintype.sum_equiv E _ _ fun p => ?_).symm
      rw [hrjk, Equiv.symm_apply_apply, map_mul]
      ring
    rw [hrewrite] at hw
    have hz := ratShift_sub_familyIncrement_combination lam hincong hw
    intro k
    have h := hz (E.symm k).1 (E.symm k).2
    simp only [Prod.mk.eta, Equiv.apply_symm_apply] at h
    exact (mul_eq_zero.mp h).resolve_right (pow_ne_zero _ (neg_ne_zero.mpr Complex.I_ne_zero))
  have hindep : AlgebraicIndependent (dirZetaBase : Type _) xj :=
    algebraicIndependent_dirZetaBase_of_rationalIncrements xj rj hjet hcharge
  let f : t → Fin (r * (N + 1)) :=
    fun p => E (p.1.1, ⟨p.1.2, hle p.1 p.2⟩)
  have hf : Function.Injective f := by
    intro p q hpq
    have h1 : (p.1.1, (⟨p.1.2, hle p.1 p.2⟩ : Fin (N + 1))) =
        (q.1.1, (⟨q.1.2, hle q.1 q.2⟩ : Fin (N + 1))) := E.injective hpq
    have h2 : p.1.1 = q.1.1 := congrArg (fun z : Fin r × Fin (N + 1) => z.1) h1
    have h3 : p.1.2 = q.1.2 := congrArg (fun z : Fin r × Fin (N + 1) => (z.2 : ℕ)) h1
    exact Subtype.ext (Prod.ext h2 h3)
  have hcomp := hindep.comp f hf
  have hfun : xj ∘ f = fun p : t => differentialJet p.1.2 (shiftedRotDigammaMero (lam p.1.1)) := by
    funext p
    simp [Function.comp_apply, xj, f]
  rwa [hfun] at hcomp

end

end GaloisForLFunctions.HTGeometry
