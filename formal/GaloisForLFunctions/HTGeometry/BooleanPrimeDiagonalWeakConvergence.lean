import GaloisForLFunctions.HTGeometry.DenseContinuousMeasureWeakConvergence

open Filter MeasureTheory Set Topology
open scoped BoundedContinuousFunction ComplexConjugate

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- One prime's two Boolean replica coordinates. -/
abbrev BooleanReplicaPair := ZMod 2 × ZMod 2

/-- One Walsh character of a Boolean replica pair. -/
def booleanReplicaPairCharacter (a x : BooleanReplicaPair) : ℂ :=
  ZMod.stdAddChar (a.1 * x.1 + a.2 * x.2)

@[simp]
theorem booleanReplicaPairCharacter_zero (x : BooleanReplicaPair) :
    booleanReplicaPairCharacter 0 x = 1 := by
  simp [booleanReplicaPairCharacter]

theorem booleanReplicaPairCharacter_add (a b x : BooleanReplicaPair) :
    booleanReplicaPairCharacter (a + b) x =
      booleanReplicaPairCharacter a x * booleanReplicaPairCharacter b x := by
  rw [booleanReplicaPairCharacter, booleanReplicaPairCharacter]
  change ZMod.stdAddChar (((a.1 + b.1) * x.1) + ((a.2 + b.2) * x.2)) = _
  rw [add_mul, add_mul]
  rw [show (a.1 * x.1 + b.1 * x.1) + (a.2 * x.2 + b.2 * x.2) =
      (a.1 * x.1 + a.2 * x.2) + (b.1 * x.1 + b.2 * x.2) by abel]
  exact (ZMod.stdAddChar (N := 2)).map_add_eq_mul' _ _

theorem booleanReplicaPairCharacter_neg (a x : BooleanReplicaPair) :
    booleanReplicaPairCharacter (-a) x =
      starRingEnd ℂ (booleanReplicaPairCharacter a x) := by
  rw [booleanReplicaPairCharacter, booleanReplicaPairCharacter]
  change ZMod.stdAddChar (((-a.1) * x.1) + ((-a.2) * x.2)) = _
  rw [neg_mul, neg_mul, ← neg_add,
    (ZMod.stdAddChar (N := 2)).map_neg_eq_inv]
  simp only [ZMod.stdAddChar_apply]
  exact Complex.inv_eq_conj (Circle.norm_coe _)

private theorem zmodTwo_toCircle_injective :
    Function.Injective (ZMod.toCircle : ZMod 2 → Circle) :=
  (AddCircle.injective_toCircle one_ne_zero).comp (ZMod.toAddCircle_injective 2)

theorem booleanReplicaPairCharacter_separates
    {x y : BooleanReplicaPair} (hxy : x ≠ y) :
    ∃ a : BooleanReplicaPair,
      booleanReplicaPairCharacter a x ≠ booleanReplicaPairCharacter a y := by
  have hp : x.1 ≠ y.1 ∨ x.2 ≠ y.2 := by
    rw [Ne, Prod.ext_iff, not_and_or] at hxy
    exact hxy
  rcases hp with h | h
  · refine ⟨(1, 0), ?_⟩
    simp only [booleanReplicaPairCharacter, one_mul, zero_mul, add_zero,
      ZMod.stdAddChar_apply]
    exact fun heq => h (zmodTwo_toCircle_injective (Subtype.ext heq))
  · refine ⟨(0, 1), ?_⟩
    simp only [booleanReplicaPairCharacter, zero_mul, one_mul, zero_add,
      ZMod.stdAddChar_apply]
    exact fun heq => h (zmodTwo_toCircle_injective (Subtype.ext heq))

/-- Finite-support Walsh character on an arbitrary product of Boolean replica pairs. -/
def infiniteBooleanReplicaWalsh {I : Type*} (n : I →₀ BooleanReplicaPair) :
    C((I → BooleanReplicaPair), ℂ) where
  toFun x := n.prod fun i a => booleanReplicaPairCharacter a (x i)
  continuous_toFun := by
    classical
    unfold Finsupp.prod
    fun_prop

@[simp]
theorem infiniteBooleanReplicaWalsh_zero {I : Type*} :
    infiniteBooleanReplicaWalsh (0 : I →₀ BooleanReplicaPair) = 1 := by
  ext x
  simp [infiniteBooleanReplicaWalsh]

theorem infiniteBooleanReplicaWalsh_add {I : Type*}
    (m n : I →₀ BooleanReplicaPair) (x : I → BooleanReplicaPair) :
    infiniteBooleanReplicaWalsh (m + n) x =
      infiniteBooleanReplicaWalsh m x * infiniteBooleanReplicaWalsh n x := by
  classical
  simp only [infiniteBooleanReplicaWalsh, ContinuousMap.coe_mk]
  rw [Finsupp.prod_add_index'
    (h := fun i a => booleanReplicaPairCharacter a (x i))]
  · intro i
    exact booleanReplicaPairCharacter_zero (x i)
  · intro i a b
    exact booleanReplicaPairCharacter_add a b (x i)

theorem infiniteBooleanReplicaWalsh_neg {I : Type*}
    (n : I →₀ BooleanReplicaPair) (x : I → BooleanReplicaPair) :
    infiniteBooleanReplicaWalsh (-n) x =
      starRingEnd ℂ (infiniteBooleanReplicaWalsh n x) := by
  classical
  simp only [infiniteBooleanReplicaWalsh, ContinuousMap.coe_mk]
  rw [Finsupp.prod_neg_index]
  · simp_rw [booleanReplicaPairCharacter_neg]
    exact (map_finsuppProd (starRingEnd ℂ) n
      (fun i a => booleanReplicaPairCharacter a (x i))).symm
  · intro i
    exact booleanReplicaPairCharacter_zero (x i)

/-- Star algebra generated by finite-support Boolean Walsh characters. -/
def infiniteBooleanReplicaWalshSubalgebra (I : Type*) :
    StarSubalgebra ℂ C((I → BooleanReplicaPair), ℂ) where
  toSubalgebra := Algebra.adjoin ℂ
    (Set.range (infiniteBooleanReplicaWalsh (I := I)))
  star_mem' := by
    change Algebra.adjoin ℂ (Set.range (infiniteBooleanReplicaWalsh (I := I))) ≤
      star (Algebra.adjoin ℂ (Set.range (infiniteBooleanReplicaWalsh (I := I))))
    refine Algebra.adjoin_le ?_
    rintro _ ⟨n, rfl⟩
    refine Algebra.subset_adjoin ⟨-n, ?_⟩
    ext x
    simp only [infiniteBooleanReplicaWalsh_neg, starRingEnd_apply,
      ContinuousMap.star_apply]

theorem infiniteBooleanReplicaWalshSubalgebra_coe (I : Type*) :
    (infiniteBooleanReplicaWalshSubalgebra I).toSubalgebra.toSubmodule =
      Submodule.span ℂ (Set.range (infiniteBooleanReplicaWalsh (I := I))) := by
  apply Algebra.adjoin_eq_span_of_subset
  refine .trans
    (fun x => Submonoid.closure_induction (fun _ => id) ⟨0, ?_⟩ ?_)
    Submodule.subset_span
  · exact infiniteBooleanReplicaWalsh_zero
  · rintro _ _ _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n, ?_⟩
    ext x
    exact infiniteBooleanReplicaWalsh_add m n x

theorem infiniteBooleanReplicaWalshSubalgebra_separatesPoints (I : Type*) :
    (infiniteBooleanReplicaWalshSubalgebra I).SeparatesPoints := by
  classical
  intro x y hxy
  rw [Ne, funext_iff, not_forall] at hxy
  obtain ⟨i, hi⟩ := hxy
  obtain ⟨a, ha⟩ := booleanReplicaPairCharacter_separates hi
  refine ⟨_, ⟨infiniteBooleanReplicaWalsh (Finsupp.single i a),
    Algebra.subset_adjoin ⟨Finsupp.single i a, rfl⟩, rfl⟩, ?_⟩
  simpa [infiniteBooleanReplicaWalsh, Finsupp.prod_single_index,
    booleanReplicaPairCharacter_zero] using ha

theorem span_infiniteBooleanReplicaWalsh_closure_eq_top (I : Type*) :
    (Submodule.span ℂ
      (Set.range (infiniteBooleanReplicaWalsh (I := I)))).topologicalClosure = ⊤ := by
  rw [← infiniteBooleanReplicaWalshSubalgebra_coe]
  exact congr_arg
    (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints
      (infiniteBooleanReplicaWalshSubalgebra I)
      (infiniteBooleanReplicaWalshSubalgebra_separatesPoints I))

/-- Independent uniform law on two Boolean replicas at one prime. -/
def independentBooleanReplicaPairPMF : PMF BooleanReplicaPair :=
  PMF.uniformOfFintype BooleanReplicaPair

/-- Uniform diagonal law on two Boolean replicas at one prime. -/
def diagonalBooleanReplicaPairPMF : PMF BooleanReplicaPair :=
  PMF.map (fun x : ZMod 2 => (x, x)) (PMF.uniformOfFintype (ZMod 2))

/-- Literal finite set of ordinary primes at most `N`. -/
abbrev BooleanPrimeCutoff (N : ℕ) := {p : Nat.Primes // p.1 ≤ N}

private def booleanPrimeCutoffEquiv (N : ℕ) :
    BooleanPrimeCutoff N ≃
      {n : ℕ // n ∈ (Finset.Iic N).filter Nat.Prime} where
  toFun p := ⟨p.1.1, Finset.mem_filter.mpr ⟨Finset.mem_Iic.mpr p.2, p.1.2⟩⟩
  invFun n := ⟨⟨n.1, (Finset.mem_filter.mp n.2).2⟩,
    Finset.mem_Iic.mp (Finset.mem_filter.mp n.2).1⟩
  left_inv p := by ext; rfl
  right_inv n := by ext; rfl

noncomputable instance booleanPrimeCutoffFintype (N : ℕ) :
    Fintype (BooleanPrimeCutoff N) :=
  Fintype.ofEquiv _ (booleanPrimeCutoffEquiv N).symm

theorem card_booleanPrimeCutoff (N : ℕ) :
    Fintype.card (BooleanPrimeCutoff N) = Nat.primeCounting N := by
  rw [Fintype.card_congr (booleanPrimeCutoffEquiv N)]
  rw [Fintype.card_coe]
  symm
  show Nat.count Nat.Prime (N + 1) = _
  rw [Nat.count_eq_card_filter_range, Nat.range_succ_eq_Iic]

/-- Independent expectation on the literal Boolean prime cube below `N`. -/
def booleanPrimeIndependentExpectation (N : ℕ)
    (F : (BooleanPrimeCutoff N → ZMod 2) →
      (BooleanPrimeCutoff N → ZMod 2) → ℝ) : ℝ :=
  ((2 : ℝ) ^ Nat.primeCounting N)⁻¹ ^ 2 * ∑ u, ∑ v, F u v

/-- Diagonal Haar expectation on the literal Boolean prime cube below `N`. -/
def booleanPrimeDiagonalExpectation (N : ℕ)
    (F : (BooleanPrimeCutoff N → ZMod 2) →
      (BooleanPrimeCutoff N → ZMod 2) → ℝ) : ℝ :=
  ((2 : ℝ) ^ Nat.primeCounting N)⁻¹ * ∑ u, F u u

/-- Equality-cylinder kernel on the prime cube below `N`. -/
def booleanPrimeDiagonalKernel {N : ℕ}
    (u v : BooleanPrimeCutoff N → ZMod 2) : ℝ :=
  if u = v then 1 else 0

theorem sum_booleanPrimeDiagonalKernel_mul (N : ℕ)
    (F : (BooleanPrimeCutoff N → ZMod 2) →
      (BooleanPrimeCutoff N → ZMod 2) → ℝ) :
    (∑ u, ∑ v, booleanPrimeDiagonalKernel u v * F u v) = ∑ u, F u u := by
  classical
  apply Finset.sum_congr rfl
  intro u hu
  simp [booleanPrimeDiagonalKernel]

/-- **Literal Boolean entropy normalization.** Multiplication by `2 ^ π(N)` turns the
independent equality-cylinder law into the prime-cube diagonal Haar coupling. -/
theorem booleanPrimeDiagonalExpectation_eq_normalized (N : ℕ)
    (F : (BooleanPrimeCutoff N → ZMod 2) →
      (BooleanPrimeCutoff N → ZMod 2) → ℝ) :
    (2 : ℝ) ^ Nat.primeCounting N * booleanPrimeIndependentExpectation N
      (fun u v => booleanPrimeDiagonalKernel u v * F u v) =
        booleanPrimeDiagonalExpectation N F := by
  rw [booleanPrimeIndependentExpectation, booleanPrimeDiagonalExpectation,
    sum_booleanPrimeDiagonalKernel_mul]
  have hpow : (2 : ℝ) ^ Nat.primeCounting N ≠ 0 := pow_ne_zero _ (by norm_num)
  field_simp

theorem booleanPrimeDiagonalMass (N : ℕ) :
    booleanPrimeIndependentExpectation N booleanPrimeDiagonalKernel =
      ((2 : ℝ) ^ Nat.primeCounting N)⁻¹ := by
  have hnorm := booleanPrimeDiagonalExpectation_eq_normalized N (fun _ _ => 1)
  simp only [mul_one] at hnorm
  have hdiag : booleanPrimeDiagonalExpectation N (fun _ _ => 1) = 1 := by
    rw [booleanPrimeDiagonalExpectation]
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
    rw [Fintype.card_fun, ZMod.card, card_booleanPrimeCutoff]
    norm_num
  rw [hdiag] at hnorm
  have hpow : (2 : ℝ) ^ Nat.primeCounting N ≠ 0 := pow_ne_zero _ (by norm_num)
  calc
    booleanPrimeIndependentExpectation N booleanPrimeDiagonalKernel =
        ((2 : ℝ) ^ Nat.primeCounting N)⁻¹ *
          ((2 : ℝ) ^ Nat.primeCounting N *
            booleanPrimeIndependentExpectation N booleanPrimeDiagonalKernel) := by field_simp
    _ = ((2 : ℝ) ^ Nat.primeCounting N)⁻¹ := by rw [hnorm]; ring

theorem booleanPrime_scalar_normalization_forced
    {α : Type*} {l : Filter α} (N : α → ℕ) (c : α → ℝ) (M : ℝ)
    (h : Tendsto (fun x => c x *
      booleanPrimeIndependentExpectation (N x) booleanPrimeDiagonalKernel) l (𝓝 M)) :
    Tendsto (fun x => c x / (2 : ℝ) ^ Nat.primeCounting (N x)) l (𝓝 M) := by
  refine h.congr' (Eventually.of_forall fun x => ?_)
  rw [booleanPrimeDiagonalMass]
  simp [div_eq_mul_inv]

/-- Local law after conditioning the two replicas to agree at primes at most `N`. -/
def finiteBooleanReplicaLocalMeasure (N : ℕ) (p : Nat.Primes) :
    Measure BooleanReplicaPair :=
  if p.1 ≤ N then diagonalBooleanReplicaPairPMF.toMeasure
  else independentBooleanReplicaPairPMF.toMeasure

noncomputable instance finiteBooleanReplicaLocalMeasure_isProbability
    (N : ℕ) (p : Nat.Primes) :
    IsProbabilityMeasure (finiteBooleanReplicaLocalMeasure N p) := by
  rw [finiteBooleanReplicaLocalMeasure]
  split <;> infer_instance

/-- Infinite Boolean-pair law conditioned to agree at every prime at most `N`. -/
def finiteBooleanReplicaDiagonalProbabilityMeasure (N : ℕ) :
    ProbabilityMeasure (Nat.Primes → BooleanReplicaPair) :=
  ⟨Measure.infinitePi (finiteBooleanReplicaLocalMeasure N), inferInstance⟩

/-- All-prime Haar diagonal coupling. -/
def booleanReplicaDiagonalProbabilityMeasure :
    ProbabilityMeasure (Nat.Primes → BooleanReplicaPair) :=
  ⟨Measure.infinitePi (fun _ : Nat.Primes => diagonalBooleanReplicaPairPMF.toMeasure),
    inferInstance⟩

/-- Finite-support Walsh moments factor over any product probability law. -/
theorem integral_infiniteBooleanReplicaWalsh_infinitePi
    (μ : Nat.Primes → Measure BooleanReplicaPair)
    [∀ p, IsProbabilityMeasure (μ p)]
    (n : Nat.Primes →₀ BooleanReplicaPair) :
    ∫ x, infiniteBooleanReplicaWalsh n x ∂Measure.infinitePi μ =
      n.prod fun p a => ∫ y, booleanReplicaPairCharacter a y ∂μ p := by
  classical
  have hfun : (fun x : Nat.Primes → BooleanReplicaPair =>
      infiniteBooleanReplicaWalsh n x) =
      fun x => ∏ p : ↑n.support, booleanReplicaPairCharacter (n p) (x p) := by
    funext x
    rw [show (∏ p : ↑n.support, booleanReplicaPairCharacter (n p) (x p)) =
        ∏ p ∈ n.support, booleanReplicaPairCharacter (n p) (x p) from
      Finset.prod_attach n.support
        (fun p => booleanReplicaPairCharacter (n p) (x p))]
    rfl
  rw [hfun]
  let f : (↑n.support → BooleanReplicaPair) → ℂ :=
    fun x => ∏ p : ↑n.support, booleanReplicaPairCharacter (n p) (x p)
  change (∫ x, f (n.support.restrict x) ∂Measure.infinitePi μ) = _
  rw [MeasureTheory.integral_restrict_infinitePi μ
    (by fun_prop : Continuous f).aestronglyMeasurable]
  rw [MeasureTheory.integral_fintype_prod_eq_prod]
  exact Finset.prod_attach n.support
    (fun p => ∫ y, booleanReplicaPairCharacter (n p) y ∂μ p)

/-- Every finite-support Walsh moment of the normalized finite diagonal law is eventually exactly
the corresponding all-prime diagonal moment. -/
theorem eventually_integral_finiteBooleanReplicaDiagonal_eq
    (n : Nat.Primes →₀ BooleanReplicaPair) :
    ∀ᶠ N in atTop,
      (∫ x, infiniteBooleanReplicaWalsh n x
          ∂(finiteBooleanReplicaDiagonalProbabilityMeasure N :
            Measure (Nat.Primes → BooleanReplicaPair))) =
        ∫ x, infiniteBooleanReplicaWalsh n x
          ∂(booleanReplicaDiagonalProbabilityMeasure :
            Measure (Nat.Primes → BooleanReplicaPair)) := by
  classical
  let S : Finset ℕ := n.support.image fun p : Nat.Primes => p.1
  obtain ⟨N₀, hN₀⟩ := Finset.exists_nat_subset_range S
  filter_upwards [eventually_ge_atTop N₀] with N hN
  rw [show (finiteBooleanReplicaDiagonalProbabilityMeasure N :
      Measure (Nat.Primes → BooleanReplicaPair)) =
      Measure.infinitePi (finiteBooleanReplicaLocalMeasure N) by rfl]
  rw [show (booleanReplicaDiagonalProbabilityMeasure :
      Measure (Nat.Primes → BooleanReplicaPair)) =
      Measure.infinitePi
        (fun _ : Nat.Primes => diagonalBooleanReplicaPairPMF.toMeasure) by rfl]
  rw [integral_infiniteBooleanReplicaWalsh_infinitePi,
    integral_infiniteBooleanReplicaWalsh_infinitePi]
  apply Finsupp.prod_congr
  intro p hp
  have hpS : p.1 ∈ S := Finset.mem_image.mpr ⟨p, hp, rfl⟩
  have hpLt : p.1 < N₀ := Finset.mem_range.mp (hN₀ hpS)
  have hpN : p.1 ≤ N := le_trans hpLt.le hN
  simp [finiteBooleanReplicaLocalMeasure, hpN]

/-- **Boolean diagonal weak-* limit.** The normalized finite equality-cylinder laws converge to
the canonical all-prime diagonal coupling against every continuous reporter. -/
theorem tendsto_finiteBooleanReplicaDiagonalProbabilityMeasure :
    Tendsto finiteBooleanReplicaDiagonalProbabilityMeasure atTop
      (𝓝 booleanReplicaDiagonalProbabilityMeasure) := by
  apply probabilityMeasure_tendsto_of_denseSpan_integral_tendsto
    (Set.range (infiniteBooleanReplicaWalsh (I := Nat.Primes)))
    (span_infiniteBooleanReplicaWalsh_closure_eq_top Nat.Primes)
  rintro _ ⟨n, rfl⟩
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [eventually_integral_finiteBooleanReplicaDiagonal_eq n] with N hN
  exact hN.symm

end

