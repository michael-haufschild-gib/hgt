import GaloisForLFunctions.HTGeometry.LinearFormPrime
import GaloisForLFunctions.HTGeometry.DiscriminantPolynomial
import GaloisForLFunctions.HTGeometry.SquareClassPrime

/-!
# The discriminant times the centered constant coefficient is not a square

The centered roots of a monic polynomial are the roots with their average removed, so the constant
coefficient of the centered polynomial is, up to a constant factor, the product of the linear forms
`d * X i - sum of all variables`.  Each of them is prime, and the discriminant is the square of the
Vandermonde product, which is unchanged by the translation.

Evaluating at a point whose coordinates are distinct and sum to zero, with the zeroth one zero,
shows that the zeroth form divides neither the Vandermonde square nor the remaining forms.  So the
whole product is divisible by that prime exactly once and is not a square in the rational function
field in the roots — hence not a square in any subfield, in particular not in the field generated by
the coefficients.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] [CharZero K] {d : ℕ}

/-- The scaled centered coordinate: `d` times a variable minus the sum of all of them. -/
noncomputable def avgForm (K : Type*) [Field K] (d : ℕ) (i : Fin d) : MvPolynomial (Fin d) K :=
  (d : MvPolynomial (Fin d) K) * MvPolynomial.X i - ∑ j : Fin d, MvPolynomial.X j

omit [CharZero K] in
theorem aeval_avgForm {A : Type*} [CommRing A] [Algebra K A] (v : Fin d → A) (i : Fin d) :
    MvPolynomial.aeval v (avgForm K d i) = (d : A) * v i - ∑ j : Fin d, v j := by
  rw [avgForm, map_sub, map_mul, map_sum]
  simp only [MvPolynomial.aeval_X, map_natCast]

omit [CharZero K] in
theorem aeval_vandermondePoly {A : Type*} [CommRing A] [Algebra K A] (v : Fin d → A) :
    MvPolynomial.aeval v (vandermondePoly K d) = vandermondeProd v := by
  rw [vandermondePoly, vandermondeProd, vandermondeProd, map_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_X]

/-! ## A point with distinct coordinates summing to zero -/

/-- The sum of the indices below the last one. -/
def balancedTail (d : ℕ) : ℕ := ∑ k ∈ Finset.range (d - 1), k

theorem one_le_balancedTail (hd : 3 ≤ d) : 1 ≤ balancedTail d := by
  rw [balancedTail]
  exact Finset.single_le_sum (f := fun k : ℕ => k) (fun k _ => Nat.zero_le k)
    (Finset.mem_range.2 (show 1 < d - 1 by omega))

/-- A point whose coordinates are pairwise distinct and sum to zero. -/
noncomputable def balancedPoint (K : Type*) [Field K] (d : ℕ) (i : Fin d) : K :=
  if (i : ℕ) = d - 1 then -((balancedTail d : ℕ) : K) else ((i : ℕ) : K)

omit [CharZero K] in
theorem sum_balancedPoint (hd : 3 ≤ d) : ∑ i : Fin d, balancedPoint K d i = 0 := by
  have hlast : ((⟨d - 1, by omega⟩ : Fin d) : ℕ) = d - 1 := rfl
  have hsplit : ∀ i : Fin d, balancedPoint K d i =
      ((i : ℕ) : K) + (if (i : ℕ) = d - 1
        then -((balancedTail d : ℕ) : K) - ((i : ℕ) : K) else 0) := by
    intro i
    rw [balancedPoint]
    by_cases hi : (i : ℕ) = d - 1
    · rw [if_pos hi, if_pos hi]
      ring
    · rw [if_neg hi, if_neg hi, add_zero]
  rw [Finset.sum_congr rfl (fun i _ => hsplit i), Finset.sum_add_distrib]
  have hfirst : ∑ i : Fin d, ((i : ℕ) : K) = ((∑ k ∈ Finset.range d, k : ℕ) : K) := by
    rw [Nat.cast_sum]
    exact Fin.sum_univ_eq_sum_range (fun k : ℕ => (k : K)) d
  have hsecond : ∑ i : Fin d, (if (i : ℕ) = d - 1
      then -((balancedTail d : ℕ) : K) - ((i : ℕ) : K) else 0) =
      -((balancedTail d : ℕ) : K) - ((d - 1 : ℕ) : K) := by
    rw [Finset.sum_eq_single (⟨d - 1, by omega⟩ : Fin d)]
    · rw [if_pos hlast, hlast]
    · intro i _ hi
      refine if_neg fun hcon => hi ?_
      exact Fin.ext (by rw [hcon, hlast])
    · intro hcon
      exact absurd (Finset.mem_univ _) hcon
  have hrange : (∑ k ∈ Finset.range d, k) = balancedTail d + (d - 1) := by
    rw [balancedTail]
    conv_lhs => rw [show d = (d - 1) + 1 from by omega]
    exact Finset.sum_range_succ _ _
  rw [hfirst, hsecond, hrange]
  push_cast
  ring

theorem balancedPoint_injective (hd : 3 ≤ d) :
    Function.Injective (balancedPoint K d) := by
  have hS := one_le_balancedTail (d := d) hd
  intro i j hij
  rw [balancedPoint, balancedPoint] at hij
  by_cases hi : (i : ℕ) = d - 1 <;> by_cases hj : (j : ℕ) = d - 1
  · exact Fin.ext (hi.trans hj.symm)
  · rw [if_pos hi, if_neg hj] at hij
    exfalso
    have hz : ((balancedTail d + (j : ℕ) : ℕ) : K) = 0 := by
      push_cast
      linear_combination -hij
    have := Nat.cast_eq_zero.1 hz
    omega
  · rw [if_neg hi, if_pos hj] at hij
    exfalso
    have hz : ((balancedTail d + (i : ℕ) : ℕ) : K) = 0 := by
      push_cast
      linear_combination hij
    have := Nat.cast_eq_zero.1 hz
    omega
  · rw [if_neg hi, if_neg hj] at hij
    exact Fin.ext (Nat.cast_injective hij)

theorem balancedPoint_ne_zero (hd : 3 ≤ d) {i : Fin d} (hi : (i : ℕ) ≠ 0) :
    balancedPoint K d i ≠ 0 := by
  have hS := one_le_balancedTail (d := d) hd
  rw [balancedPoint]
  by_cases hlast : (i : ℕ) = d - 1
  · rw [if_pos hlast]
    intro hcon
    have : ((balancedTail d : ℕ) : K) = 0 := by linear_combination -hcon
    have := Nat.cast_eq_zero.1 this
    omega
  · rw [if_neg hlast]
    intro hcon
    exact hi (Nat.cast_eq_zero.1 hcon)

/-! ## The zeroth form divides the product exactly once -/

variable [NeZero d]

omit [CharZero K] in
theorem avgForm_zero_eq_toMvPolynomial :
    avgForm K d 0 = (avgShearMatrix K d).toMvPolynomial 0 :=
  (avgShearMatrix_toMvPolynomial_zero (K := K) (d := d)).symm

theorem prime_avgForm_zero (hd : 2 ≤ d) : Prime (avgForm K d 0) := by
  rw [avgForm_zero_eq_toMvPolynomial]
  exact prime_avgShearMatrix_toMvPolynomial hd

/-- The remaining part of the product: the Vandermonde square times all the other forms. -/
noncomputable def avgCofactor (K : Type*) [Field K] (d : ℕ) [NeZero d] :
    MvPolynomial (Fin d) K :=
  vandermondePoly K d * vandermondePoly K d *
    ∏ i ∈ Finset.univ.erase (0 : Fin d), avgForm K d i

omit [CharZero K] in
theorem avgProduct_eq :
    vandermondePoly K d * vandermondePoly K d * ∏ i : Fin d, avgForm K d i =
      avgForm K d 0 * avgCofactor K d := by
  rw [avgCofactor, ← Finset.prod_erase_mul _ _ (Finset.mem_univ (0 : Fin d))]
  ring

/-- **The zeroth form does not divide the cofactor.** -/
theorem not_dvd_avgCofactor (hd : 3 ≤ d) : ¬ (avgForm K d 0 ∣ avgCofactor K d) := by
  rintro ⟨G, hG⟩
  have hval := congrArg (MvPolynomial.aeval (balancedPoint K d)) hG
  rw [map_mul, aeval_avgForm, sum_balancedPoint hd] at hval
  have hzero : balancedPoint K d (0 : Fin d) = 0 := by
    have h0 : ((0 : Fin d) : ℕ) = 0 := rfl
    rw [balancedPoint, h0, if_neg (by omega)]
    exact Nat.cast_zero
  rw [hzero, mul_zero, sub_zero, zero_mul] at hval
  rw [avgCofactor, map_mul, map_mul, map_prod, aeval_vandermondePoly] at hval
  have hV : vandermondeProd (balancedPoint K d) ≠ 0 :=
    vandermondeProd_ne_zero (balancedPoint_injective hd)
  have hterms : ∀ i ∈ Finset.univ.erase (0 : Fin d),
      MvPolynomial.aeval (balancedPoint K d) (avgForm K d i) ≠ 0 := by
    intro i hi
    rw [Finset.mem_erase] at hi
    rw [aeval_avgForm, sum_balancedPoint hd, sub_zero]
    refine mul_ne_zero ?_ (balancedPoint_ne_zero hd ?_)
    · exact Nat.cast_ne_zero.2 (NeZero.ne d)
    · intro hcon
      exact hi.1 (Fin.ext (by rw [hcon]; rfl))
  have hprod : ∏ i ∈ Finset.univ.erase (0 : Fin d),
      MvPolynomial.aeval (balancedPoint K d) (avgForm K d i) ≠ 0 :=
    Finset.prod_ne_zero_iff.2 hterms
  exact (mul_ne_zero (mul_ne_zero hV hV) hprod) hval

/-- **The discriminant times the centered constant coefficient is not a square.**  The product of
the Vandermonde square with all the centered coordinates has odd valuation at the zeroth centered
coordinate, which is prime. -/
theorem not_isSquare_vandermondeSq_mul_avgProduct (hd : 3 ≤ d) :
    ¬ IsSquare (algebraMap (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K))
      (vandermondePoly K d * vandermondePoly K d * ∏ i : Fin d, avgForm K d i)) :=
  not_isSquare_of_prime_dvd_once (prime_avgForm_zero (by omega)) avgProduct_eq
    (not_dvd_avgCofactor hd)

end GaloisForLFunctions.HTGeometry
