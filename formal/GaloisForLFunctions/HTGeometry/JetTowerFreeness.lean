import GaloisForLFunctions.HTGeometry.ShiftJetTower
import Mathlib

/-!
# From tower transcendence to algebraic independence

A sequence in which every term is transcendental over the field generated by its predecessors is
algebraically independent.  The jet tower produces exactly that hypothesis, so this turns the
descent conclusion into the free-jet statement that hypertranscendence is defined by.
-/

open Polynomial

namespace HTGeometry

variable {K : Type*} [Field K] [Algebra ℂ K]

/-- Transcendence over an intermediate field descends to any subalgebra it contains. -/
theorem transcendental_adjoin_of_le {F L : IntermediateField ℂ K} (hFL : F ≤ L)
    {s : Set K} (hs : s ⊆ (L : Set K)) {t : K} (h : Transcendental L t) :
    Transcendental (Algebra.adjoin (F : Type _) s) t := by
  have hsub : ∀ a ∈ Algebra.adjoin (F : Type _) s, a ∈ L := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact hs hx
    | algebraMap r => exact hFL r.2
    | add p q _ _ hp hq => exact add_mem hp hq
    | mul p q _ _ hp hq => exact mul_mem hp hq
  let phi : (Algebra.adjoin (F : Type _) s) →+* L :=
    { toFun := fun a => ⟨a.1, hsub a.1 a.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hinj : Function.Injective phi := by
    intro a b hab
    have h2 : (a : K) = (b : K) := congrArg (fun w : L => (w : K)) hab
    exact Subtype.ext h2
  have hcomp : (algebraMap (L : Type _) K).comp phi
      = algebraMap (Algebra.adjoin (F : Type _) s) K := by
    ext a
    rfl
  rintro ⟨p, hp0, hp⟩
  refine h ⟨p.map phi, (Polynomial.map_ne_zero_iff hinj).mpr hp0, ?_⟩
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
  rw [Polynomial.aeval_def] at hp
  exact hp

/-- Algebraic independence over an intermediate field descends to any subalgebra it contains. -/
theorem algebraicIndependent_adjoin_of_le {F L : IntermediateField ℂ K} (hFL : F ≤ L)
    {s : Set K} (hs : s ⊆ (L : Set K)) {ι : Type*} {x : ι → K}
    (h : AlgebraicIndependent (L : Type _) x) :
    AlgebraicIndependent (Algebra.adjoin (F : Type _) s) x := by
  have hsub : ∀ a ∈ Algebra.adjoin (F : Type _) s, a ∈ L := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem z hz => exact hs hz
    | algebraMap r => exact hFL r.2
    | add p q _ _ hp hq => exact add_mem hp hq
    | mul p q _ _ hp hq => exact mul_mem hp hq
  let phi : (Algebra.adjoin (F : Type _) s) →+* L :=
    { toFun := fun a => ⟨a.1, hsub a.1 a.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hinj : Function.Injective phi := by
    intro a b hab
    have h2 : (a : K) = (b : K) := congrArg (fun w : L => (w : K)) hab
    exact Subtype.ext h2
  letI : Algebra (Algebra.adjoin (F : Type _) s) L := phi.toAlgebra
  haveI : IsScalarTower (Algebra.adjoin (F : Type _) s) L K :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact h.restrictScalars hinj

theorem jetTower_mono (F : IntermediateField ℂ K) (y : ℕ → K) {j n : ℕ} (hjn : j ≤ n) :
    jetTower F y j ≤ jetTower F y n := by
  induction n with
  | zero => rw [Nat.le_zero.mp hjn]
  | succ n ih =>
      rcases Nat.lt_succ_iff_lt_or_eq.mp (Nat.lt_succ_of_le hjn) with hlt | heq
      · exact le_trans (ih (Nat.lt_succ_iff.mp hlt)) (le_jetTower_succ F y n)
      · rw [heq]

theorem jet_mem_jetTower (F : IntermediateField ℂ K) (y : ℕ → K) {j n : ℕ} (hjn : j < n) :
    y j ∈ jetTower F y n :=
  jetTower_mono F y hjn (jet_mem_jetTower_succ F y j)

/-- The first `n` jets are algebraically independent over the base. -/
theorem algebraicIndepOn_Iio_of_jetTower (F : IntermediateField ℂ K) (y : ℕ → K)
    (h : ∀ n, Transcendental (jetTower F y n) (y n)) (n : ℕ) :
    AlgebraicIndepOn (F : Type _) y (Set.Iio n) := by
  induction n with
  | zero =>
      have hempty : Set.Iio 0 = (∅ : Set ℕ) := by
        ext j; simp
      rw [hempty]
      have : IsEmpty ((∅ : Set ℕ) : Type _) := by
        constructor
        rintro ⟨j, hj⟩
        exact hj
      exact algebraicIndependent_empty_type_iff.mpr (algebraMap (F : Type _) K).injective
  | succ n ih =>
      have hins : Set.Iio (n + 1) = insert n (Set.Iio n) := by
        ext j; simp [Set.mem_Iio]
      rw [hins]
      refine ih.insert ?_
      refine transcendental_adjoin_of_le (base_le_jetTower F y n) ?_ (h n)
      rintro _ ⟨j, hj, rfl⟩
      exact jet_mem_jetTower F y hj

/-- **Tower transcendence is algebraic independence.** -/
theorem algebraicIndependent_of_jetTower_transcendental (F : IntermediateField ℂ K) (y : ℕ → K)
    (h : ∀ n, Transcendental (jetTower F y n) (y n)) :
    AlgebraicIndependent (F : Type _) y := by
  refine algebraicIndependent_of_finite_type fun t ht => ?_
  obtain ⟨b, hb⟩ := ht.bddAbove
  have hsub : t ⊆ Set.Iio (b + 1) := fun j hj => by
    have := hb hj
    simp only [Set.mem_Iio]
    omega
  exact (algebraicIndepOn_Iio_of_jetTower F y h (b + 1)).comp
    (Set.inclusion hsub) (Set.inclusion_injective hsub)

end HTGeometry
