import GaloisForLFunctions.HTGeometry.FZZCigarReplicaBackreaction
import GaloisForLFunctions.HTGeometry.BlackHoleTemperatureUniversalKreinSign

/-!
# Finite-level FZZ replica backreaction as a complete positive scale

The fractional-winding deformation of the finite-level `SL(2,ℝ)ₖ/U(1)` cigar has exact dressing
mismatch

`replicaDressingMismatch a δ = δ · 2a / (1 - 2a)`, where `a = 1/k` and `0 < a < 1/2`.

This file extracts the coefficient of the conical source `δ`.  Unlike a Hawking-temperature
rescaling, it is generated by the finite-string-level radial/winding mismatch.  Its physical range
is exactly the whole positive half-line: the inverse scale map is

`a(β) = β / (2(1 + β))`.

Consequently, requiring the black-hole spectral-duality odd square to remain in the nonpositive
real Krein chamber at every physical cigar level is equivalent to imaginary-axis frequency.  At
each single level there is still an explicit off-axis blind point.  Selection therefore comes from
the complete finite-level family, not from KMS, CCR, group, inverse, or Krein laws at one
temperature.

## Exact scope

All results here are unconditional algebraic consequences of two black-hole inputs already proved
in this development: the fractional-winding replica Ward law and the exact odd scattering factor.
They do **not** prove that one resonance or Mellin divisor is canonically transported while `k`
varies.  Since varying `k` changes the cigar CFT, that cross-level identification is the remaining
physical obstruction.  A source-faithful construction should come from the finite-`k` torus
one-point function of the stringy area operator, not from an assumed common zero.

Physics sources:

* Halder--Jafferis, arXiv:2310.02313, fractional-winding replica deformation.
* Halder--Jafferis, arXiv:2402.00932, finite-level radial/winding dressing mismatch.
* Grozdanov--Vrbica, arXiv:2505.14229, exact black-hole spectral duality and odd factor.
-/

open Complex

namespace GaloisForLFunctions.HTGeometry.FZZCigar

noncomputable section

/-- Coefficient of the conical source in the exact finite-level replica dressing mismatch. -/
def replicaLinearizedDressingScale (a : ℝ) : ℝ :=
  2 * a / (1 - 2 * a)

/-- The exact replica mismatch factors into conical source times finite-level response scale. -/
theorem replicaDressingMismatch_eq_delta_mul_linearizedScale
    {a δ : ℝ} (ha : a ≠ 1 / 2) :
    replicaDressingMismatch a δ = δ * replicaLinearizedDressingScale a := by
  rw [replicaDressingMismatch_eq ha]
  simp only [replicaLinearizedDressingScale]
  ring

/-- Finite-level response scale is strictly positive throughout the physical cigar range. -/
theorem replicaLinearizedDressingScale_pos
    {a : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) :
    0 < replicaLinearizedDressingScale a := by
  rw [replicaLinearizedDressingScale]
  exact div_pos (mul_pos zero_lt_two ha0) (by linarith)

/-- Physical cigar level parameter producing a prescribed positive response scale. -/
def replicaLevelForScale (β : ℝ) : ℝ :=
  β / (2 * (1 + β))

theorem replicaLevelForScale_pos {β : ℝ} (hβ : 0 < β) :
    0 < replicaLevelForScale β := by
  rw [replicaLevelForScale]
  exact div_pos hβ (mul_pos zero_lt_two (by linarith))

theorem replicaLevelForScale_lt_half {β : ℝ} (hβ : 0 < β) :
    replicaLevelForScale β < 1 / 2 := by
  rw [replicaLevelForScale]
  have hden : 0 < 2 * (1 + β) := mul_pos zero_lt_two (by linarith)
  rw [div_lt_iff₀ hden]
  linarith

/-- Every positive scale is produced by the explicit physical cigar level `a(β)`. -/
theorem replicaLinearizedDressingScale_replicaLevelForScale
    {β : ℝ} (hβ : 0 < β) :
    replicaLinearizedDressingScale (replicaLevelForScale β) = β := by
  rw [replicaLinearizedDressingScale, replicaLevelForScale]
  have h1 : 1 + β ≠ 0 := ne_of_gt (by linarith)
  field_simp [h1]
  ring

/-- The explicit scale-to-level map is also a left inverse on the physical cigar range. -/
theorem replicaLevelForScale_replicaLinearizedDressingScale
    {a : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) :
    replicaLevelForScale (replicaLinearizedDressingScale a) = a := by
  rw [replicaLevelForScale, replicaLinearizedDressingScale]
  have hden : 1 - 2 * a ≠ 0 := ne_of_gt (by linarith)
  field_simp [hden]
  ring

/-- Finite physical cigar levels and positive response scales are in exact one-to-one
correspondence. -/
theorem existsUnique_physicalReplicaLevel_scale_eq
    {β : ℝ} (hβ : 0 < β) :
    ∃! a : ℝ,
      0 < a ∧ a < 1 / 2 ∧ replicaLinearizedDressingScale a = β := by
  refine ⟨replicaLevelForScale β,
    ⟨replicaLevelForScale_pos hβ, replicaLevelForScale_lt_half hβ,
      replicaLinearizedDressingScale_replicaLevelForScale hβ⟩, ?_⟩
  intro a ha
  rcases ha with ⟨ha0, haHalf, hscale⟩
  calc
    a = replicaLevelForScale (replicaLinearizedDressingScale a) :=
      (replicaLevelForScale_replicaLinearizedDressingScale ha0 haHalf).symm
    _ = replicaLevelForScale β := by rw [hscale]

/-- The odd black-hole scattering square stays in the passive Krein chamber at every finite
physical FZZ cigar level. -/
def FZZReplicaLevelUniversalKreinSign (ω : ℂ) : Prop :=
  ∀ a : ℝ, 0 < a → a < 1 / 2 →
    ((Complex.sinh
      (((replicaLinearizedDressingScale a : ℝ) : ℂ) * ω / 2)) ^ (2 : ℕ)).im = 0 ∧
    ((Complex.sinh
      (((replicaLinearizedDressingScale a : ℝ) : ℂ) * ω / 2)) ^ (2 : ℕ)).re ≤ 0

/-- **Finite-level FZZ selection.**  Level-universal passive sign is exactly imaginary-axis
frequency.  The scale completeness comes from fractional-winding backreaction, not temperature
rescaling. -/
theorem fzzReplicaLevelUniversalKreinSign_iff_re_eq_zero (ω : ℂ) :
    FZZReplicaLevelUniversalKreinSign ω ↔ ω.re = 0 := by
  constructor
  · intro hlevel
    apply (GaloisForLFunctions.hawkingTemperatureUniversalKreinSign_iff_re_eq_zero ω).mp
    intro β hβ
    have hchamber := hlevel (replicaLevelForScale β)
      (replicaLevelForScale_pos hβ) (replicaLevelForScale_lt_half hβ)
    rw [replicaLinearizedDressingScale_replicaLevelForScale hβ] at hchamber
    exact hchamber
  · intro hre a ha0 haHalf
    exact (GaloisForLFunctions.hawkingTemperatureUniversalKreinSign_iff_re_eq_zero ω).mpr hre
      (replicaLinearizedDressingScale a)
      (replicaLinearizedDressingScale_pos ha0 haHalf)

/-- **Sharp fixed-level no-go.**  Every individual finite cigar level has an explicit off-axis
point in the strict negative chamber.  Finite-level backreaction selects only when its complete
physical family acts on the same spectral object. -/
theorem fixed_fzzReplicaLevel_has_offAxis_krein_blind_point
    {a : ℝ} (ha0 : 0 < a) (haHalf : a < 1 / 2) :
    ∃ ω : ℂ,
      ω.re ≠ 0 ∧
        ((Complex.sinh
          (((replicaLinearizedDressingScale a : ℝ) : ℂ) * ω / 2)) ^ (2 : ℕ)).im = 0 ∧
        ((Complex.sinh
          (((replicaLinearizedDressingScale a : ℝ) : ℂ) * ω / 2)) ^ (2 : ℕ)).re < 0 := by
  exact GaloisForLFunctions.fixed_hawking_temperature_has_offAxis_krein_blind_point
    (replicaLinearizedDressingScale a)
    (replicaLinearizedDressingScale_pos ha0 haHalf)

end

end GaloisForLFunctions.HTGeometry.FZZCigar
