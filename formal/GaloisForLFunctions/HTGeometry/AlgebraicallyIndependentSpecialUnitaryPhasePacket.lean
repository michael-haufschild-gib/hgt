import GaloisForLFunctions.HTGeometry.TranscendentalBaseExistence
import GaloisForLFunctions.HTGeometry.OneSidedJetIndependence

/-!
# Algebraically independent determinant-one phase packets

Every countable coefficient field inside `ℂ` admits finite packets of unit
phases with exactly one determinant relation and no other algebraic relation.
The construction recursively chooses real parameters transcendental over the
field generated by the preceding phases and sends them to the unit circle by
the rational Cayley transform.

The final packet has `d + 1` phases, product one, and an algebraically
independent `d`-coordinate affine chart.  This is the intrinsic projective
transcendence supply needed to compare an arbitrary fixed spectral torus with
a finite-parameter circuit image.
-/

open Set
open GaloisForLFunctions

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Rational Cayley transform from the real line to the unit circle. -/
def cayleyUnitPhase (x : ℝ) : ℂ :=
  (1 + Complex.I * (x : ℂ)) / (1 - Complex.I * (x : ℂ))

lemma cayleyUnitPhase_den_ne_zero (x : ℝ) :
    (1 - Complex.I * (x : ℂ)) ≠ 0 := by
  intro h
  have hre := congrArg Complex.re h
  norm_num at hre

lemma cayleyUnitPhase_norm (x : ℝ) : ‖cayleyUnitPhase x‖ = 1 := by
  have hden := cayleyUnitPhase_den_ne_zero x
  have hconj : starRingEnd ℂ (1 - Complex.I * (x : ℂ)) =
      1 + Complex.I * (x : ℂ) := by
    simp
  rw [cayleyUnitPhase, ← hconj, norm_div, Complex.norm_conj,
    div_self (norm_ne_zero_iff.mpr hden)]

lemma cayleyUnitPhase_add_one_ne_zero (x : ℝ) :
    cayleyUnitPhase x + 1 ≠ 0 := by
  have hden := cayleyUnitPhase_den_ne_zero x
  have hz : cayleyUnitPhase x * (1 - Complex.I * (x : ℂ)) =
      1 + Complex.I * (x : ℂ) := by
    rw [cayleyUnitPhase]
    field_simp [hden]
  intro hplus
  have hzneg : cayleyUnitPhase x = -1 := eq_neg_of_add_eq_zero_left hplus
  rw [hzneg] at hz
  have hbad : (0 : ℂ) = 2 := by linear_combination hz
  norm_num at hbad

lemma ofReal_eq_cayleyUnitPhase_sub_div (x : ℝ) :
    (x : ℂ) = (cayleyUnitPhase x - 1) /
      (Complex.I * (cayleyUnitPhase x + 1)) := by
  have hden := cayleyUnitPhase_den_ne_zero x
  have hz : cayleyUnitPhase x * (1 - Complex.I * (x : ℂ)) =
      1 + Complex.I * (x : ℂ) := by
    rw [cayleyUnitPhase]
    field_simp [hden]
  rw [eq_div_iff (mul_ne_zero Complex.I_ne_zero
    (cayleyUnitPhase_add_one_ne_zero x))]
  linear_combination -hz

/-- Algebraic independence survives the Cayley transform whenever the base
field contains `i`: the inverse transform is rational over that field. -/
theorem transcendental_cayleyUnitPhase
    (K : Type*) [Field K] [Algebra K ℂ]
    (iK : K) (hiK : algebraMap K ℂ iK = Complex.I)
    {x : ℝ} (hx : Transcendental K (x : ℂ)) :
    Transcendental K (cayleyUnitPhase x) := by
  intro hAlg
  have hOne : IsAlgebraic K (1 : ℂ) := isAlgebraic_one
  have hIalg : IsAlgebraic K Complex.I := by
    rw [← hiK]
    exact isAlgebraic_algebraMap (R := K) (A := ℂ) iK
  have hNum : IsAlgebraic K (cayleyUnitPhase x - 1) := hAlg.sub hOne
  have hDen : IsAlgebraic K (Complex.I * (cayleyUnitPhase x + 1)) :=
    hIalg.mul (hAlg.add hOne)
  have hRhs : IsAlgebraic K
      ((cayleyUnitPhase x - 1) /
        (Complex.I * (cayleyUnitPhase x + 1))) := by
    exact hNum.mul hDen.inv
  exact hx (by simpa [ofReal_eq_cayleyUnitPhase_sub_div x] using hRhs)

/-- Every real interval contains a number transcendental over a countable
intermediate field, using the canonical intermediate-field algebra structure. -/
theorem exists_transcendental_mem_Ioo_intermediate
    {K : Type*} [Field K] [Algebra K ℂ]
    (F : IntermediateField K ℂ) [Countable F]
    {a b : ℝ} (hab : a < b) :
    ∃ x : ℝ, x ∈ Set.Ioo a b ∧ Transcendental F (x : ℂ) := by
  by_contra hcon
  push Not at hcon
  have hsub : Set.Ioo a b ⊆
      Complex.ofReal ⁻¹' {z : ℂ | IsAlgebraic F z} := by
    intro x hx
    exact not_not.mp (hcon x hx)
  have hcount :
      (Complex.ofReal ⁻¹' {z : ℂ | IsAlgebraic F z}).Countable :=
    (Algebraic.countable F ℂ).preimage Complex.ofReal_injective
  have hzero : MeasureTheory.volume (Set.Ioo a b) = 0 :=
    MeasureTheory.measure_mono_null hsub
      (hcount.measure_zero MeasureTheory.volume)
  rw [Real.volume_Ioo] at hzero
  simp only [ENNReal.ofReal_eq_zero, sub_nonpos] at hzero
  linarith

/-- **Unit-circle transcendence supply.** Every countable complex subfield
containing `i` admits an algebraically independent unit-modulus packet of any
prescribed finite size. -/
theorem exists_algebraicIndependent_unitPhase_fin
    (K : Subfield ℂ) [Countable ↥K] (hI : Complex.I ∈ K) :
    ∀ n : ℕ, ∃ z : Fin n → ℂ,
      AlgebraicIndependent K z ∧ ∀ i, ‖z i‖ = 1 := by
  intro n
  induction n with
  | zero =>
      exact ⟨fun i => Fin.elim0 i, algebraicIndependent_empty_type,
        fun i => Fin.elim0 i⟩
  | succ n ih =>
      obtain ⟨z, hzind, hznorm⟩ := ih
      let F : IntermediateField K ℂ :=
        IntermediateField.adjoin K (Set.range z)
      have hKcard : Cardinal.mk K ≤ Cardinal.aleph0 :=
        Cardinal.mk_le_aleph0_iff.mpr inferInstance
      have hrangeCount : (Set.range z).Countable := Set.countable_range z
      have hrangeCard : Cardinal.mk ↥(Set.range z) ≤ Cardinal.aleph0 :=
        Cardinal.mk_le_aleph0_iff.mpr hrangeCount.to_subtype
      have hFcard : Cardinal.mk F ≤ Cardinal.aleph0 := by
        refine (IntermediateField.cardinalMk_adjoin_le K (Set.range z)).trans ?_
        exact max_le (max_le hKcard hrangeCard) le_rfl
      letI : Countable F := Cardinal.mk_le_aleph0_iff.mp hFcard
      obtain ⟨x, _hxmem, hxtrans⟩ :=
        exists_transcendental_mem_Ioo_intermediate F
          (show (0 : ℝ) < 1 by norm_num)
      have hIF : Complex.I ∈ F := by
        change (algebraMap K ℂ) (⟨Complex.I, hI⟩ : K) ∈ F
        exact F.algebraMap_mem (⟨Complex.I, hI⟩ : K)
      have hiF : algebraMap F ℂ (⟨Complex.I, hIF⟩ : F) = Complex.I := rfl
      have hwtransF : Transcendental F (cayleyUnitPhase x) :=
        transcendental_cayleyUnitPhase F
          (⟨Complex.I, hIF⟩ : F) hiF hxtrans
      have hle : Algebra.adjoin K (Set.range z) ≤ F.toSubalgebra := by
        refine Algebra.adjoin_le ?_
        rintro y ⟨i, rfl⟩
        exact IntermediateField.subset_adjoin K (Set.range z) ⟨i, rfl⟩
      have hwtrans : Transcendental (Algebra.adjoin K (Set.range z))
          (cayleyUnitPhase x) :=
        transcendental_of_le_subalgebra hle hwtransF
      have hopt : AlgebraicIndependent K
          (fun o : Option (Fin n) => o.elim (cayleyUnitPhase x) z) :=
        AlgebraicIndependent.option_iff.mpr ⟨hzind, hwtrans⟩
      let z' : Fin (n + 1) → ℂ :=
        fun i => (fun o : Option (Fin n) => o.elim (cayleyUnitPhase x) z)
          (finSuccEquiv n i)
      have hz'ind : AlgebraicIndependent K z' :=
        hopt.comp (finSuccEquiv n) (finSuccEquiv n).injective
      refine ⟨z', hz'ind, ?_⟩
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · exact cayleyUnitPhase_norm x
      · exact hznorm j

/-- Add the unique phase that cancels the determinant of a unit packet. -/
def specialUnitPhasePacket {d : ℕ} (z : Fin d → ℂ) : Fin (d + 1) → ℂ :=
  Fin.cases (∏ i, z i)⁻¹ z

theorem specialUnitPhasePacket_succ {d : ℕ} (z : Fin d → ℂ) (i : Fin d) :
    specialUnitPhasePacket z i.succ = z i := by
  rfl

theorem specialUnitPhasePacket_norm {d : ℕ} {z : Fin d → ℂ}
    (hz : ∀ i, ‖z i‖ = 1) (i : Fin (d + 1)) :
    ‖specialUnitPhasePacket z i‖ = 1 := by
  refine Fin.cases ?_ (fun j => ?_) i
  · simp [specialUnitPhasePacket, norm_prod, hz]
  · exact hz j

theorem specialUnitPhasePacket_prod {d : ℕ} {z : Fin d → ℂ}
    (hz : ∀ i, ‖z i‖ = 1) :
    ∏ i, specialUnitPhasePacket z i = 1 := by
  rw [Fin.prod_univ_succ]
  change (∏ i, z i)⁻¹ * ∏ i, z i = 1
  exact inv_mul_cancel₀ (Finset.prod_ne_zero_iff.mpr fun i _ =>
    norm_ne_zero_iff.mp (by rw [hz i]; norm_num))

/-- **Projective phase-packet law.** Every countable complex coefficient
field has a determinant-one packet whose `d` projective phase coordinates are
algebraically independent over that field. -/
theorem exists_algebraicIndependent_specialUnitPhasePacket
    (K : Subfield ℂ) [Countable ↥K] (hI : Complex.I ∈ K) (d : ℕ) :
    ∃ phase : Fin (d + 1) → ℂ,
      (∀ i, ‖phase i‖ = 1) ∧
      (∏ i, phase i = 1) ∧
      AlgebraicIndependent K (fun i : Fin d => phase i.succ) := by
  obtain ⟨z, hzind, hznorm⟩ :=
    exists_algebraicIndependent_unitPhase_fin K hI d
  refine ⟨specialUnitPhasePacket z,
    specialUnitPhasePacket_norm hznorm,
    specialUnitPhasePacket_prod hznorm, ?_⟩
  simpa only [specialUnitPhasePacket_succ] using hzind

end

end GaloisForLFunctions.HTGeometry
