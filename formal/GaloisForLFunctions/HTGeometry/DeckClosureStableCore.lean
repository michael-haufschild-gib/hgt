import GaloisForLFunctions.HTGeometry.StableDifferentialCore
import Mathlib.FieldTheory.Galois.Basic

/-!
# Stable cores as invariants of the total deck group

Suppose that the image of every iterate of a field endomorphism is the fixed field of the
corresponding finite-depth deck group.  Then its stable core is exactly the fixed field of the
subgroup generated by every finite-depth deck group.

For an isogeny of an algebraic group, the generated subgroup is the algebraic precursor of the
Zariski closure of all iterated kernels.  The geometric identification with that closure and with
Maurer--Cartan differential invariants is a paper-level input; this file proves the unconditional
Galois-theoretic intersection theorem on which that identification rests.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- Fixed points of the subgroup generated by an arbitrary family of deck groups are exactly the
intersection of the individual fixed fields. -/
theorem fixedField_iSup {ι : Type*} (Γ : ι → Subgroup (F ≃ₐ[K] F)) :
    IntermediateField.fixedField (⨆ n, Γ n) =
      ⨅ n, IntermediateField.fixedField (Γ n) := by
  apply le_antisymm
  · refine le_iInf ?_
    intro n
    exact IntermediateField.fixedField_le (le_iSup Γ n)
  · rw [IntermediateField.le_iff_le]
    refine iSup_le ?_
    intro n σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hxn : x ∈ IntermediateField.fixedField (Γ n) :=
      (iInf_le (fun m => IntermediateField.fixedField (Γ m)) n) hx
    exact (IntermediateField.mem_fixedField_iff (Γ n) x).mp hxn σ hσ

/-- The fixed field of two jointly generated symmetry groups is the intersection of their fixed
fields. -/
theorem fixedField_sup (Γ Δ : Subgroup (F ≃ₐ[K] F)) :
    IntermediateField.fixedField (Γ ⊔ Δ) =
      IntermediateField.fixedField Γ ⊓ IntermediateField.fixedField Δ := by
  apply le_antisymm
  · exact le_inf
      (IntermediateField.fixedField_le le_sup_left)
      (IntermediateField.fixedField_le le_sup_right)
  · rw [IntermediateField.le_iff_le]
    refine sup_le ?_ ?_
    · intro σ hσ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have hxΓ : x ∈ IntermediateField.fixedField Γ :=
        (IntermediateField.mem_inf.mp hx).1
      exact (IntermediateField.mem_fixedField_iff Γ x).mp hxΓ σ hσ
    · intro σ hσ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have hxΔ : x ∈ IntermediateField.fixedField Δ :=
        (IntermediateField.mem_inf.mp hx).2
      exact (IntermediateField.mem_fixedField_iff Δ x).mp hxΔ σ hσ

/-- Adding a holonomy group to all finite-depth deck groups intersects the total deck fixed field
with the holonomy fixed field. -/
theorem fixedField_iSup_sup
    {ι : Type*} (Γ : ι → Subgroup (F ≃ₐ[K] F)) (Δ : Subgroup (F ≃ₐ[K] F)) :
    IntermediateField.fixedField ((⨆ n, Γ n) ⊔ Δ) =
      (⨅ n, IntermediateField.fixedField (Γ n)) ⊓
        IntermediateField.fixedField Δ := by
  rw [fixedField_sup, fixedField_iSup]

/-- An element is fixed by the group generated by an arbitrary family exactly when it is fixed by
every group in that family. -/
theorem mem_fixedField_iSup_iff {ι : Type*} (Γ : ι → Subgroup (F ≃ₐ[K] F)) (x : F) :
    x ∈ IntermediateField.fixedField (⨆ n, Γ n) ↔
      ∀ n, x ∈ IntermediateField.fixedField (Γ n) := by
  rw [fixedField_iSup]
  constructor
  · intro hx n
    exact (iInf_le (fun m => IntermediateField.fixedField (Γ m)) n) hx
  · intro hx
    rw [← SetLike.mem_coe, IntermediateField.coe_iInf, Set.mem_iInter]
    exact hx

/-- **Deck-closure stable-core theorem.**  If every iterate image is the fixed field of its
finite-depth deck subgroup, the stable core is the fixed field of the group generated by all
iterated deck transformations. -/
theorem stableRangeCore_eq_fixedField_iSup
    (φ : F →ₐ[K] F) (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ =
      IntermediateField.fixedField (Γ n)) :
    stableRangeCore φ = IntermediateField.fixedField (⨆ n, Γ n) := by
  rw [stableRangeCore, fixedField_iSup]
  exact iInf_congr hdeck

/-- A stable deck core followed by an additional holonomy quotient is the fixed field of the
jointly generated total deck and holonomy group. -/
theorem stableRangeCore_inf_fixedField_eq_fixedField_iSup_sup
    (φ : F →ₐ[K] F) (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ =
      IntermediateField.fixedField (Γ n))
    (Δ : Subgroup (F ≃ₐ[K] F)) :
    stableRangeCore φ ⊓ IntermediateField.fixedField Δ =
      IntermediateField.fixedField ((⨆ n, Γ n) ⊔ Δ) := by
  rw [stableRangeCore_eq_fixedField_iSup φ Γ hdeck, fixedField_sup]

/-- Pointwise form of the deck-closure theorem: stable-core membership is invariance under
every finite-depth deck group. -/
theorem mem_stableRangeCore_iff_fixedBy_iteratedDeck
    (φ : F →ₐ[K] F) (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ =
      IntermediateField.fixedField (Γ n)) (x : F) :
    x ∈ stableRangeCore φ ↔
      ∀ n, x ∈ IntermediateField.fixedField (Γ n) := by
  rw [stableRangeCore_eq_fixedField_iSup φ Γ hdeck, mem_fixedField_iSup_iff]

end

end GaloisForLFunctions.HTGeometry
