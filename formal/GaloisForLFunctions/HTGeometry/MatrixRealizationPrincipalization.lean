import GaloisForLFunctions.HTGeometry.MatrixFacetCodimension
import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetIdeal

/-!
# Finite internal state forces the same principal geometry

The finite-state facet-codimension law is unconditional (`matrix_facetComplementRankOne`), so the
combinatorial classification applies to it verbatim and the structural conclusion holds for an
arbitrary constant internal channel of any dimension:

* `principalization_of_matrixRealization` — a finite facet antichain carrying entire `ℂ^m`-valued
  facet carriers, each reproduced up to a constant matrix by every omitted translation and each
  having some hypertranscendental component, is either the full simplex `{V}` or exactly the
  deletion family `{V ∖ {u} : u ∈ U}` for a nonempty block `U`;
* **`stanleyReisnerIdeal_principal_of_matrixRealization`** — in the non-simplex case its
  Stanley–Reisner ideal is the principal ideal generated by the squarefree monomial `∏_{u ∈ U} X u`.

Increasing the number of constant matrix channels therefore does not produce new relation geometry
at any finite cutoff: the principal pure stratum is the only one available.
-/

open Finset MvPolynomial

namespace GaloisForLFunctions.HTGeometry

variable {α : Type*} [DecidableEq α]

/-- **Structural classification from a finite-state datum.**  Such a facet antichain is the full
simplex or a single-vertex deletion family. -/
theorem principalization_of_matrixRealization {m : ℕ} {V : Finset α} {facets : Finset (Finset α)}
    (hanti : FacetAntichain (↑facets : Set (Finset α)))
    (R : MatrixFacetRealization m V (↑facets : Set (Finset α)))
    (hsub : ∀ F ∈ facets, F ⊆ V) (hne : facets.Nonempty) :
    (↑facets : Set (Finset α)) = {V} ∨
      ∃ U : Finset α, U.Nonempty ∧ U ⊆ V ∧
        (↑facets : Set (Finset α)) = deletionFacets V U := by
  refine facetAntichain_eq_singleton_or_deletionFacets ?_ hanti
    (matrix_facetComplementRankOne R (fun F hF => hsub F (Finset.mem_coe.mp hF)))
  obtain ⟨F, hF⟩ := hne
  exact ⟨F, Finset.mem_coe.mpr hF⟩

/-- **Principalization for finite-state data.**  On a finite ambient vertex type, a facet antichain
that is not the full simplex and carries a constant-matrix facet datum has principal
Stanley–Reisner ideal, generated by the squarefree monomial of its deleted block. -/
theorem stanleyReisnerIdeal_principal_of_matrixRealization [Fintype α] {m : ℕ}
    {facets : Finset (Finset α)} (hanti : FacetAntichain (↑facets : Set (Finset α)))
    (R : MatrixFacetRealization m (Finset.univ : Finset α) (↑facets : Set (Finset α)))
    (hne : facets.Nonempty)
    (hnotsimplex : (↑facets : Set (Finset α)) ≠ {(Finset.univ : Finset α)}) :
    ∃ U : Finset α, U.Nonempty ∧
      stanleyReisnerIdeal ℂ facets
        = Ideal.span ({∏ u ∈ U, X u} : Set (MvPolynomial α ℂ)) := by
  rcases principalization_of_matrixRealization hanti R
    (fun F _ => Finset.subset_univ F) hne with hsimp | ⟨U, hUne, _, hUeq⟩
  · exact absurd hsimp hnotsimplex
  · refine ⟨U, hUne, ?_⟩
    have hfin : facets = deletionFacetFinset U := by
      apply Finset.coe_injective
      rw [hUeq, coe_deletionFacetFinset]
    rw [hfin, stanleyReisnerIdeal_deletionFacetFinset_eq_span_product]

end GaloisForLFunctions.HTGeometry
