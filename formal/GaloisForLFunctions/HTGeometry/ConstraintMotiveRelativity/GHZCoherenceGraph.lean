import Mathlib

/-!
# The GHZ coherence graph: state and history reconstruction

The framed GHZ phase state `Ψ_φ = d^{-1/2} ∑_j e^{iφ_j} e_j` is invisible to either boundary
reduction but is read by the pairwise cross-coherences `C_{jk}(Ω_φ) = e^{i(φ_j - φ_k)}`.  A family
of such probes is indexed by an oriented edge set `E`, and the observation map is
`[z] ↦ (z_j z_k^{-1})_{(j,k) ∈ E}`.

Its kernel consists of the phase vectors that are constant on each connected component of the probe
graph, so the map separates points of the phase fibre exactly when the probe graph is connected; a
spanning tree of `d - 1` probes is minimal and sufficient, and a family of `m` probes leaves at
least `d - m` components, hence at least `d - m - 1` invisible relative-phase directions.

The same statements over `ℤ` describe the winding class of a lifted closed history: the edge
winding map is injective exactly when the probe graph is connected, while endpoint probe values are
blind to winding altogether, and executed action is a further datum.
-/

namespace HTGeometry.ConstraintMotiveRelativity

open scoped InnerProductSpace

section GHZProbe

variable {d : ℕ}

/-- The framed GHZ phase vector `(GCR.1)` in the diagonal coordinates. -/
noncomputable def ghzVector (φ : Fin d → ℝ) : EuclideanSpace ℂ (Fin d) :=
  WithLp.toLp 2 fun j => ((Real.sqrt d : ℝ) : ℂ)⁻¹ * Complex.exp (Complex.I * (φ j : ℂ))

@[simp] theorem ghzVector_apply (φ : Fin d → ℝ) (j : Fin d) :
    (ghzVector φ).ofLp j = ((Real.sqrt d : ℝ) : ℂ)⁻¹ * Complex.exp (Complex.I * (φ j : ℂ)) := rfl

/-- The framed GHZ state as the rank-one projector onto its phase vector. -/
noncomputable def ghzState (Ψ : EuclideanSpace ℂ (Fin d)) :
    EuclideanSpace ℂ (Fin d) →ₗ[ℂ] EuclideanSpace ℂ (Fin d) where
  toFun x := ⟪Ψ, x⟫_ℂ • Ψ
  map_add' x y := by rw [inner_add_right, add_smul]
  map_smul' a x := by rw [inner_smul_right, smul_smul]; rfl

@[simp] theorem ghzState_apply (Ψ x : EuclideanSpace ℂ (Fin d)) :
    ghzState Ψ x = ⟪Ψ, x⟫_ℂ • Ψ := rfl

/-- The cross-coherence probe `(GCR.3)` of a state between two diagonal directions. -/
noncomputable def coherenceProbe (Ω : EuclideanSpace ℂ (Fin d) →ₗ[ℂ] EuclideanSpace ℂ (Fin d))
    (j k : Fin d) : ℂ :=
  (d : ℂ) * ⟪EuclideanSpace.single j (1 : ℂ), Ω (EuclideanSpace.single k (1 : ℂ))⟫_ℂ

/-- **`(GCR.4)`.**  On the phase fibre the cross-coherence probe is the relative phase. -/
theorem coherenceProbe_ghz (hd : 0 < d) (φ : Fin d → ℝ) (j k : Fin d) :
    coherenceProbe (ghzState (ghzVector φ)) j k
      = Complex.exp (Complex.I * ((φ j - φ k : ℝ) : ℂ)) := by
  have hdne : ((d : ℂ)) ≠ 0 := by
    exact_mod_cast Nat.cast_ne_zero.2 hd.ne'
  have hdR : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd
  have hsq : ((Real.sqrt d : ℝ) : ℂ) ≠ 0 := by
    have : Real.sqrt d ≠ 0 := (Real.sqrt_pos.2 hdR).ne'
    exact_mod_cast this
  have hsqsq : (((Real.sqrt d : ℝ) : ℂ)) * (((Real.sqrt d : ℝ) : ℂ)) = (d : ℂ) := by
    have : Real.sqrt d * Real.sqrt d = (d : ℝ) := Real.mul_self_sqrt hdR.le
    exact_mod_cast this
  rw [coherenceProbe, ghzState_apply, inner_smul_right,
    EuclideanSpace.inner_single_right, EuclideanSpace.inner_single_left, ghzVector_apply,
    ghzVector_apply]
  simp only [map_mul, map_inv₀, Complex.conj_ofReal, ← Complex.exp_conj, map_mul, Complex.conj_I,
    Complex.conj_ofReal, one_mul]
  have hexp : Complex.exp (-Complex.I * (φ k : ℂ)) * Complex.exp (Complex.I * (φ j : ℂ))
      = Complex.exp (Complex.I * ((φ j - φ k : ℝ) : ℂ)) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [map_one, one_mul]
  calc (d : ℂ) * ((((Real.sqrt d : ℝ) : ℂ))⁻¹ * Complex.exp (-Complex.I * (φ k : ℂ)) *
        ((((Real.sqrt d : ℝ) : ℂ))⁻¹ * Complex.exp (Complex.I * (φ j : ℂ))))
      = ((d : ℂ) * ((((Real.sqrt d : ℝ) : ℂ))⁻¹ * (((Real.sqrt d : ℝ) : ℂ))⁻¹)) *
        (Complex.exp (-Complex.I * (φ k : ℂ)) * Complex.exp (Complex.I * (φ j : ℂ))) := by ring
    _ = Complex.exp (Complex.I * ((φ j - φ k : ℝ) : ℂ)) := by
        rw [hexp, ← hsqsq]
        field_simp

end GHZProbe

section ProbeGraph

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The undirected graph generated by a family of oriented coherence probes. -/
def probeGraph (E : Finset (V × V)) : SimpleGraph V :=
  SimpleGraph.fromRel fun j k => (j, k) ∈ E

omit [Fintype V] [DecidableEq V] in
theorem adj_probeGraph {E : Finset (V × V)} {j k : V} :
    (probeGraph E).Adj j k ↔ j ≠ k ∧ ((j, k) ∈ E ∨ (k, j) ∈ E) := Iff.rfl

omit [Fintype V] [DecidableEq V] in
/-- A vector constant along every edge is constant along every walk. -/
theorem eq_of_adj_of_reachable {M : Type*} {G : SimpleGraph V} {z : V → M}
    (h : ∀ j k, G.Adj j k → z j = z k) {j k : V} (hr : G.Reachable j k) : z j = z k := by
  obtain ⟨w⟩ := hr
  induction w with
  | nil => rfl
  | cons hadj p ih => rw [h _ _ hadj]; exact ih

omit [Fintype V] [DecidableEq V] in
/-- **`(GCR.6)`.**  The kernel of the graph observation map consists exactly of the phase vectors
pulled back from the connected components: it is a torus of dimension `c(G)`, and `c(G) - 1` after
the common diagonal is quotiented out. -/
theorem ker_probe_eq_range (M : Type*) (G : SimpleGraph V) :
    {z : V → M | ∀ j k, G.Adj j k → z j = z k}
      = Set.range fun w : G.ConnectedComponent → M => fun v => w (G.connectedComponentMk v) := by
  ext z
  constructor
  · intro hz
    refine ⟨SimpleGraph.ConnectedComponent.lift z ?_, ?_⟩
    · intro v w p _
      exact eq_of_adj_of_reachable hz ⟨p⟩
    · funext v
      rfl
  · rintro ⟨w, rfl⟩ j k hadj
    exact congrArg w (SimpleGraph.ConnectedComponent.sound hadj.reachable)

omit [Fintype V] [DecidableEq V] in
/-- The pullback of a component labelling kills every probe. -/
theorem pullback_mem_ker {M : Type*} (G : SimpleGraph V) (w : G.ConnectedComponent → M) :
    ∀ j k, G.Adj j k → w (G.connectedComponentMk j) = w (G.connectedComponentMk k) :=
  fun _ _ hadj => congrArg w (SimpleGraph.ConnectedComponent.sound hadj.reachable)

/-- **Theorem 2.1.**  The coherence probes separate the points of the phase fibre exactly when the
probe graph is connected. -/
theorem probe_separates_iff_connected [Nonempty V] (G : SimpleGraph V) (M : Type*) [Nontrivial M] :
    ((∀ z : V → M, (∀ j k, G.Adj j k → z j = z k) → ∃ a : M, ∀ j, z j = a) ↔ G.Connected) := by
  classical
  constructor
  · intro hsep
    obtain ⟨a, b, hab⟩ := exists_pair_ne M
    refine ⟨?_⟩
    intro j k
    by_contra hnr
    set z : V → M := fun v => if G.Reachable j v then a else b with hz
    have hconst : ∀ u v, G.Adj u v → z u = z v := by
      intro u v huv
      by_cases hu : G.Reachable j u
      · have hv : G.Reachable j v := hu.trans huv.reachable
        rw [hz]
        simp [hu, hv]
      · have hv : ¬ G.Reachable j v := fun hv => hu (hv.trans huv.reachable.symm)
        rw [hz]
        simp [hu, hv]
    obtain ⟨c, hc⟩ := hsep z hconst
    have h1 : z j = a := by rw [hz]; simp
    have h2 : z k = b := by rw [hz]; simp [hnr]
    rw [hc j] at h1
    rw [hc k] at h2
    exact hab (h1.symm.trans h2)
  · intro hconn z hz
    obtain ⟨j₀⟩ := ‹Nonempty V›
    exact ⟨z j₀, fun j => eq_of_adj_of_reachable hz (hconn.preconnected j j₀)⟩

theorem one_ne_expPi : (1 : Circle) ≠ Circle.exp Real.pi := by
  intro h
  have hc := congrArg (fun c : Circle => (c : ℂ)) h
  simp only [Circle.coe_one, Circle.coe_exp] at hc
  rw [show ((Real.pi : ℝ) : ℂ) * Complex.I = Real.pi * Complex.I from rfl,
    Complex.exp_pi_mul_I] at hc
  norm_num at hc

instance : Nontrivial Circle := ⟨⟨1, Circle.exp Real.pi, one_ne_expPi⟩⟩

/-- **Theorem 2.1 for phases.**  A connected probe graph reconstructs the framed phase state. -/
theorem phase_reconstruction_iff_connected [Nonempty V] (G : SimpleGraph V) :
    ((∀ z : V → Circle, (∀ j k, G.Adj j k → z j = z k) → ∃ a : Circle, ∀ j, z j = a)
      ↔ G.Connected) :=
  probe_separates_iff_connected G Circle

/-- **Theorem 4.1.**  The integral edge-winding map is injective modulo the diagonal exactly when
the probe graph is connected. -/
theorem winding_reconstruction_iff_connected [Nonempty V] (G : SimpleGraph V) :
    ((∀ m : V → ℤ, (∀ j k, G.Adj j k → m j = m k) → ∃ a : ℤ, ∀ j, m j = a) ↔ G.Connected) :=
  probe_separates_iff_connected G ℤ

end ProbeGraph

section ProbeCount

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The real edge-difference map of a probe family. -/
noncomputable def edgeDiff (E : Finset (V × V)) : (V → ℝ) →ₗ[ℝ] (↥E → ℝ) where
  toFun m := fun e => m (e : V × V).1 - m (e : V × V).2
  map_add' m n := by funext e; simp; ring
  map_smul' a m := by funext e; simp; ring

omit [Fintype V] [DecidableEq V] in
theorem mem_ker_edgeDiff {E : Finset (V × V)} {m : V → ℝ} :
    m ∈ LinearMap.ker (edgeDiff E) ↔ ∀ e ∈ E, m e.1 = m e.2 := by
  constructor
  · intro hm e he
    have := congrFun (LinearMap.mem_ker.1 hm) ⟨e, he⟩
    simpa [edgeDiff, sub_eq_zero] using this
  · intro hm
    rw [LinearMap.mem_ker]
    funext e
    have := hm (e : V × V) e.2
    simpa [edgeDiff, sub_eq_zero] using this

omit [Fintype V] in
/-- The kernel of the real edge-difference map is exactly the set of labellings constant along the
probe graph. -/
theorem ker_edgeDiff_eq (E : Finset (V × V)) :
    (LinearMap.ker (edgeDiff E) : Set (V → ℝ))
      = {m : V → ℝ | ∀ j k, (probeGraph E).Adj j k → m j = m k} := by
  ext m
  rw [SetLike.mem_coe, mem_ker_edgeDiff]
  constructor
  · intro hm j k hadj
    rcases hadj.2 with h | h
    · exact hm (j, k) h
    · exact (hm (k, j) h).symm
  · intro hm e he
    by_cases hjk : e.1 = e.2
    · rw [hjk]
    · exact hm _ _ ⟨hjk, Or.inl (by simpa using he)⟩

/-- The pullback of a component labelling, as a linear map. -/
noncomputable def componentPullback (G : SimpleGraph V) :
    (G.ConnectedComponent → ℝ) →ₗ[ℝ] (V → ℝ) where
  toFun w := fun v => w (G.connectedComponentMk v)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [Fintype V] [DecidableEq V] in
theorem componentPullback_injective (G : SimpleGraph V) :
    Function.Injective (componentPullback G) := by
  intro w w' h
  funext c
  obtain ⟨v, rfl⟩ := c.exists_rep
  exact congrFun h v

omit [Fintype V] in
theorem range_componentPullback (E : Finset (V × V)) :
    LinearMap.range (componentPullback (probeGraph E)) = LinearMap.ker (edgeDiff E) := by
  apply SetLike.ext'
  rw [ker_edgeDiff_eq]
  ext m
  rw [SetLike.mem_coe, LinearMap.mem_range]
  constructor
  · rintro ⟨w, rfl⟩
    exact pullback_mem_ker (probeGraph E) w
  · intro hm
    have hmem : m ∈ {z : V → ℝ | ∀ j k, (probeGraph E).Adj j k → z j = z k} := hm
    rw [ker_probe_eq_range ℝ (probeGraph E)] at hmem
    obtain ⟨w, hw⟩ := hmem
    exact ⟨w, hw⟩

/-- **`(GCR.6)` numerically.**  The invisible phase directions of a probe family are exactly the
component labellings. -/
noncomputable def kerEdgeDiffEquiv (E : Finset (V × V)) :
    ((probeGraph E).ConnectedComponent → ℝ) ≃ₗ[ℝ] ↥(LinearMap.ker (edgeDiff E)) :=
  (LinearEquiv.ofInjective _ (componentPullback_injective (probeGraph E))).trans
    (LinearEquiv.ofEq _ _ (range_componentPullback E))

theorem finrank_ker_edgeDiff (E : Finset (V × V)) :
    Module.finrank ℝ (LinearMap.ker (edgeDiff E))
      = Fintype.card (probeGraph E).ConnectedComponent := by
  rw [← LinearEquiv.finrank_eq (kerEdgeDiffEquiv E)]
  simp

/-- **Corollary 2.2, `(GCR.7)`.**  A family of `m` probes leaves at least `d - m` components, hence
at least `d - m - 1` invisible relative-phase directions. -/
theorem card_le_card_components_add_card (E : Finset (V × V)) :
    Fintype.card V ≤ Fintype.card (probeGraph E).ConnectedComponent + E.card := by
  have hrn := LinearMap.finrank_range_add_finrank_ker (edgeDiff E)
  have hV : Module.finrank ℝ (V → ℝ) = Fintype.card V := by simp
  have hE : Module.finrank ℝ (↥E → ℝ) = E.card := by simp
  have hle : Module.finrank ℝ (LinearMap.range (edgeDiff E)) ≤ E.card := by
    rw [← hE]
    exact Submodule.finrank_le _
  rw [hV, finrank_ker_edgeDiff] at hrn
  omega

/-! ### Minimality and sufficiency of a spanning tree -/

theorem card_edgeFinset_probeGraph_le (E : Finset (V × V)) [DecidableRel (probeGraph E).Adj] :
    (probeGraph E).edgeFinset.card ≤ E.card := by
  classical
  refine le_trans (Finset.card_le_card ?_) (Finset.card_image_le (s := E) (f := fun e => s(e.1, e.2)))
  intro e he
  rw [SimpleGraph.mem_edgeFinset] at he
  induction e with
  | _ j k =>
      rw [SimpleGraph.mem_edgeSet] at he
      rcases he.2 with h | h
      · exact Finset.mem_image.2 ⟨(j, k), h, rfl⟩
      · exact Finset.mem_image.2 ⟨(k, j), h, Sym2.eq_swap⟩

/-- **Theorem 2.1, minimality.**  A connected probe family has at least `d - 1` probes. -/
theorem card_le_card_probes_add_one (E : Finset (V × V)) (h : (probeGraph E).Connected) :
    Fintype.card V ≤ E.card + 1 := by
  classical
  have h1 := h.card_vert_le_card_edgeSet_add_one
  rw [Nat.card_eq_fintype_card] at h1
  have h2 : Nat.card (probeGraph E).edgeSet ≤ E.card := by
    rw [Nat.card_eq_fintype_card, ← SimpleGraph.edgeFinset_card]
    exact card_edgeFinset_probeGraph_le E
  omega

end ProbeCount

section SpanningTree

variable {V : Type*} [Fintype V] [DecidableEq V]

omit [DecidableEq V] in
/-- **Theorem 2.1, tree probe count.**  A probe family whose graph is a tree uses exactly
`d - 1` probes' worth of edges. -/
theorem tree_probe_card (E : Finset (V × V)) [Fintype (probeGraph E).edgeSet]
    (h : (probeGraph E).IsTree) : (probeGraph E).edgeFinset.card + 1 = Fintype.card V :=
  h.card_edgeFinset

/-- **Theorem 2.1, sufficiency.**  The star family of `d - 1` probes is connected, so `d - 1`
probes suffice. -/
theorem exists_spanning_probe_family (d : ℕ) [NeZero d] :
    ∃ E : Finset (Fin d × Fin d), E.card + 1 = d ∧ (probeGraph E).Connected := by
  classical
  refine ⟨(Finset.univ.erase (0 : Fin d)).image fun j => ((0 : Fin d), j), ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ (fun a b hab => (Prod.mk.injEq _ _ _ _ ▸ hab).2),
      Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin]
    have : 0 < d := Nat.pos_of_ne_zero (NeZero.ne d)
    omega
  · have hreach : ∀ j : Fin d, (probeGraph ((Finset.univ.erase (0 : Fin d)).image
        fun j => ((0 : Fin d), j))).Reachable (0 : Fin d) j := by
      intro j
      by_cases hj : j = 0
      · rw [hj]
      · refine SimpleGraph.Adj.reachable ?_
        refine ⟨Ne.symm hj, Or.inl ?_⟩
        exact Finset.mem_image.2 ⟨j, Finset.mem_erase.2 ⟨hj, Finset.mem_univ _⟩, rfl⟩
    exact ⟨fun j k => (hreach j).symm.trans (hreach k)⟩

end SpanningTree

section CycleLaw

variable {V : Type*}

/-- The product of edge values along a walk. -/
def walkProd {M : Type*} [CommGroup M] {G : SimpleGraph V} (f : V → V → M) :
    {j k : V} → G.Walk j k → M
  | _, _, SimpleGraph.Walk.nil => 1
  | _, _, SimpleGraph.Walk.cons (u := u) (v := v) _ p => f u v * walkProd f p

@[simp] theorem walkProd_nil {M : Type*} [CommGroup M] {G : SimpleGraph V} (f : V → V → M)
    (j : V) : walkProd f (SimpleGraph.Walk.nil : G.Walk j j) = 1 := rfl

@[simp] theorem walkProd_cons {M : Type*} [CommGroup M] {G : SimpleGraph V} (f : V → V → M)
    {u v k : V} (h : G.Adj u v) (p : G.Walk v k) :
    walkProd f (SimpleGraph.Walk.cons h p) = f u v * walkProd f p := rfl

/-- **Theorem 3.1, forward.**  Coherence values telescope along every walk. -/
theorem walkProd_telescope {M : Type*} [CommGroup M] {G : SimpleGraph V} (z : V → M)
    {j k : V} (w : G.Walk j k) : walkProd (fun u v => z u * (z v)⁻¹) w = z j * (z k)⁻¹ := by
  induction w with
  | nil => simp
  | @cons u v k h p ih =>
      rw [walkProd_cons, ih]
      group

/-- **Theorem 3.1, the cycle law.**  The oriented product around every closed walk is one. -/
theorem walkProd_closed_eq_one {M : Type*} [CommGroup M] {G : SimpleGraph V} (z : V → M)
    {j : V} (w : G.Walk j j) : walkProd (fun u v => z u * (z v)⁻¹) w = 1 := by
  rw [walkProd_telescope]
  group

theorem walkProd_append {M : Type*} [CommGroup M] {G : SimpleGraph V} (f : V → V → M)
    {j k l : V} (p : G.Walk j k) (q : G.Walk k l) :
    walkProd f (p.append q) = walkProd f p * walkProd f q := by
  induction p with
  | nil => simp
  | cons h p ih => rw [SimpleGraph.Walk.cons_append, walkProd_cons, walkProd_cons, ih, mul_assoc]

theorem walkProd_reverse {M : Type*} [CommGroup M] {G : SimpleGraph V} {f : V → V → M}
    (hf : ∀ u v, f v u = (f u v)⁻¹) {j k : V} (p : G.Walk j k) :
    walkProd f p.reverse = (walkProd f p)⁻¹ := by
  induction p with
  | nil => simp
  | @cons u v k h p ih =>
      rw [SimpleGraph.Walk.reverse_cons, walkProd_append, ih, walkProd_cons, walkProd_cons,
        walkProd_nil, hf u v]
      group

/-- **Theorem 3.1, converse.**  An edge family whose oriented product around every closed walk is
one is the coherence family of a vertex phase assignment. -/
theorem exists_potential_of_cycle_law {M : Type*} [CommGroup M] {G : SimpleGraph V}
    (hconn : G.Connected) {f : V → V → M} (hf : ∀ u v, f v u = (f u v)⁻¹)
    (hcycle : ∀ (j : V) (w : G.Walk j j), walkProd f w = 1) :
    ∃ z : V → M, ∀ u v, G.Adj u v → f u v = z u * (z v)⁻¹ := by
  classical
  obtain ⟨r⟩ := hconn.nonempty
  have w : ∀ v : V, G.Walk r v := fun v => (hconn.preconnected r v).some
  refine ⟨fun v => (walkProd f (w v))⁻¹, ?_⟩
  intro u v hadj
  have hindep : ∀ (x : V) (q : G.Walk r x), walkProd f q = walkProd f (w x) := by
    intro x q
    have hc := hcycle r (q.append (w x).reverse)
    rw [walkProd_append, walkProd_reverse hf] at hc
    exact mul_inv_eq_one.1 hc
  have hstep : walkProd f ((w u).append (SimpleGraph.Walk.cons hadj SimpleGraph.Walk.nil))
      = walkProd f (w u) * f u v := by
    rw [walkProd_append, walkProd_cons, walkProd_nil, mul_one]
  have heq := hindep v ((w u).append (SimpleGraph.Walk.cons hadj SimpleGraph.Walk.nil))
  rw [hstep] at heq
  show f u v = (walkProd f (w u))⁻¹ * ((walkProd f (w v))⁻¹)⁻¹
  rw [← heq]
  group

/-! ### The integral cut lattice -/

/-- The signed sum of edge windings along a walk. -/
def walkSum {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (f : V → V → A) :
    {j k : V} → G.Walk j k → A
  | _, _, SimpleGraph.Walk.nil => 0
  | _, _, SimpleGraph.Walk.cons (u := u) (v := v) _ p => f u v + walkSum f p

@[simp] theorem walkSum_nil {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (f : V → V → A)
    (j : V) : walkSum f (SimpleGraph.Walk.nil : G.Walk j j) = 0 := rfl

@[simp] theorem walkSum_cons {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (f : V → V → A)
    {u v k : V} (h : G.Adj u v) (p : G.Walk v k) :
    walkSum f (SimpleGraph.Walk.cons h p) = f u v + walkSum f p := rfl

/-- **`(GCR.9)`.**  Edge windings telescope along every walk. -/
theorem walkSum_telescope {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (n : V → A)
    {j k : V} (w : G.Walk j k) : walkSum (fun u v => n u - n v) w = n j - n k := by
  induction w with
  | nil => simp
  | @cons u v k h p ih =>
      rw [walkSum_cons, ih]
      abel

/-- **Theorem 4.1, image.**  The signed sum of a cut winding around every closed walk is zero. -/
theorem walkSum_closed_eq_zero {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (n : V → A)
    {j : V} (w : G.Walk j j) : walkSum (fun u v => n u - n v) w = 0 := by
  rw [walkSum_telescope]
  abel

theorem walkSum_append {A : Type*} [AddCommGroup A] {G : SimpleGraph V} (f : V → V → A)
    {j k l : V} (p : G.Walk j k) (q : G.Walk k l) :
    walkSum f (p.append q) = walkSum f p + walkSum f q := by
  induction p with
  | nil => simp
  | cons h p ih => rw [SimpleGraph.Walk.cons_append, walkSum_cons, walkSum_cons, ih, add_assoc]

theorem walkSum_reverse {A : Type*} [AddCommGroup A] {G : SimpleGraph V} {f : V → V → A}
    (hf : ∀ u v, f v u = -f u v) {j k : V} (p : G.Walk j k) :
    walkSum f p.reverse = -walkSum f p := by
  induction p with
  | nil => simp
  | @cons u v k h p ih =>
      rw [SimpleGraph.Walk.reverse_cons, walkSum_append, ih, walkSum_cons, walkSum_cons,
        walkSum_nil, hf u v]
      abel

/-- **Theorem 4.1, image is the cut lattice.**  An antisymmetric edge winding whose signed sum
around every closed walk vanishes is the cut winding of a vertex labelling. -/
theorem exists_potential_of_cut_law {A : Type*} [AddCommGroup A] {G : SimpleGraph V}
    (hconn : G.Connected) {f : V → V → A} (hf : ∀ u v, f v u = -f u v)
    (hcycle : ∀ (j : V) (w : G.Walk j j), walkSum f w = 0) :
    ∃ n : V → A, ∀ u v, G.Adj u v → f u v = n u - n v := by
  classical
  obtain ⟨r⟩ := hconn.nonempty
  have w : ∀ v : V, G.Walk r v := fun v => (hconn.preconnected r v).some
  refine ⟨fun v => -walkSum f (w v), ?_⟩
  intro u v hadj
  have hindep : ∀ (x : V) (q : G.Walk r x), walkSum f q = walkSum f (w x) := by
    intro x q
    have hc := hcycle r (q.append (w x).reverse)
    rw [walkSum_append, walkSum_reverse hf] at hc
    exact sub_eq_zero.1 (by rw [sub_eq_add_neg]; exact hc)
  have hstep : walkSum f ((w u).append (SimpleGraph.Walk.cons hadj SimpleGraph.Walk.nil))
      = walkSum f (w u) + f u v := by
    rw [walkSum_append, walkSum_cons, walkSum_nil, add_zero]
  have heq := hindep v ((w u).append (SimpleGraph.Walk.cons hadj SimpleGraph.Walk.nil))
  rw [hstep] at heq
  show f u v = -walkSum f (w u) - -walkSum f (w v)
  rw [← heq]
  abel

end CycleLaw

section ActionLayer

variable {d : ℕ}

/-- **`(GCR.8)`.**  Endpoint probes are blind to winding: a closed history returns every
cross-coherence to its initial value whatever its winding class. -/
theorem probe_blind_to_winding (φ : Fin d → ℝ) (θ : ℝ) (m : Fin d → ℤ) (j k : Fin d) :
    Complex.exp (Complex.I *
        (((φ j + θ + 2 * Real.pi * m j) - (φ k + θ + 2 * Real.pi * m k) : ℝ) : ℂ))
      = Complex.exp (Complex.I * ((φ j - φ k : ℝ) : ℂ)) := by
  have hsplit : Complex.I *
      (((φ j + θ + 2 * Real.pi * m j) - (φ k + θ + 2 * Real.pi * m k) : ℝ) : ℂ)
      = Complex.I * ((φ j - φ k : ℝ) : ℂ) + ((m j - m k : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
    push_cast
    ring
  rw [hsplit, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

/-- The diagonal projector `P = 1 - d⁻¹ 𝟙𝟙ᵀ` of `(GCR.11)`. -/
noncomputable def diagProj (d : ℕ) : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ) where
  toFun m := fun j => m j - (d : ℝ)⁻¹ * ∑ i, m i
  map_add' m n := by
    funext j
    simp only [Pi.add_apply, Finset.sum_add_distrib]
    ring
  map_smul' a m := by
    funext j
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, ← Finset.mul_sum]
    ring

@[simp] theorem diagProj_apply (m : Fin d → ℝ) (j : Fin d) :
    diagProj d m j = m j - (d : ℝ)⁻¹ * ∑ i, m i := rfl

/-- **`(GCR.11)`.**  The minimum executed action of a winding class. -/
noncomputable def minAction (d : ℕ) (T : ℝ) (m : Fin d → ℝ) : ℝ :=
  2 * Real.pi ^ (2 : ℕ) / (d * T) * ∑ j, diagProj d m j ^ (2 : ℕ)

/-- The minimum action depends only on the winding class modulo the diagonal, so a connected family
of lifted edge histories determines it. -/
theorem diagProj_add_const (hd : 0 < d) (m : Fin d → ℝ) (a : ℝ) :
    diagProj d (m + fun _ => a) = diagProj d m := by
  have hdne : ((d : ℝ)) ≠ 0 := by
    have : (0 : ℝ) < d := by exact_mod_cast hd
    exact this.ne'
  funext j
  simp only [diagProj_apply, Pi.add_apply, Finset.sum_add_distrib, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  field_simp
  ring

theorem minAction_diag_invariant (hd : 0 < d) (T : ℝ) (m : Fin d → ℝ) (a : ℝ) :
    minAction d T (m + fun _ => a) = minAction d T m := by
  rw [minAction, minAction, diagProj_add_const hd]

/-- The executed action of a piecewise-linear history. -/
noncomputable def pathLength : List (EuclideanSpace ℝ (Fin d)) → ℝ
  | [] => 0
  | [_] => 0
  | a :: b :: rest => dist a b + pathLength (b :: rest)

/-- **§5.**  Executed action is an additional datum: two closed histories with the same endpoints
and the same winding class can have different executed action. -/
theorem executed_action_not_determined (hd : 0 < d) :
    ∃ p q : List (EuclideanSpace ℝ (Fin d)),
      p.head? = q.head? ∧ p.getLast? = q.getLast? ∧ pathLength p ≠ pathLength q := by
  classical
  set e : EuclideanSpace ℝ (Fin d) := EuclideanSpace.single ⟨0, hd⟩ (1 : ℝ) with he
  have hne : ‖e‖ = 1 := by
    rw [he, PiLp.norm_single]
    simp
  refine ⟨[0], [0, e, 0], rfl, rfl, ?_⟩
  have h1 : pathLength ([0] : List (EuclideanSpace ℝ (Fin d))) = 0 := rfl
  have h2 : pathLength ([0, e, 0] : List (EuclideanSpace ℝ (Fin d))) = 2 := by
    show dist (0 : EuclideanSpace ℝ (Fin d)) e + (dist e (0 : EuclideanSpace ℝ (Fin d)) + 0) = 2
    rw [dist_zero_left, dist_zero_right, hne]
    norm_num
  rw [h1, h2]
  norm_num

end ActionLayer

end HTGeometry.ConstraintMotiveRelativity

