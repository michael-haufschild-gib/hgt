import GaloisForLFunctions.HTGeometry.ConstraintMotiveRelativity.PrimeGammaReesEventGerm

/-!
# The Kummer–Gamma one-sided corona flow and intervention rigidity

On the raw prime coefficient space `X = ℂ^P` with the first-trace corona ideal `I = ℓ¹(P)`, a
diagonal multiplier descends to the quotient exactly when it is bounded, and the descended map is
injective exactly when the multiplier is bounded away from zero off a finite set.  The raw Gamma
scaling `G_t = M_{p^{-2t}}` is a two-sided flat group generated by twice the signed Kummer period
`-log p`, but it descends to the fixed corona only for `t ≥ 0`, where it is surjective and — for
`t > 0` — noninjective.  Its finite holonomy on the Gamma coefficient family is exactly the
physical Bockstein `β_t = F_{-t} - F_t`, whose corona class vanishes only at `t = 0`.

Moving-ideal transport is flat, so no scalar normalization, finite change, cofinitely invertible
diagonal intervention, or moving-ideal gauge can annihilate that fixed-fibre class.
-/

namespace HTGeometry.ConstraintMotiveRelativity

open Filter Topology

section Corona

/-- The raw prime coefficient space. -/
abbrev CoefSpace := Nat.Primes → ℂ

/-- **`(1)`.**  The first-trace corona ideal. -/
def coronaIdeal : Submodule ℂ CoefSpace where
  carrier := {x | Summable fun p => ‖x p‖}
  add_mem' := fun {x y} hx hy =>
    Summable.of_nonneg_of_le (fun p => norm_nonneg _) (fun p => norm_add_le _ _) (hx.add hy)
  zero_mem' := by
    show Summable fun _ : Nat.Primes => ‖(0 : ℂ)‖
    simp
  smul_mem' := fun a x hx => by
    show Summable fun p => ‖a • x p‖
    exact (hx.mul_left ‖a‖).congr fun p => by rw [smul_eq_mul, norm_mul]

theorem mem_coronaIdeal {x : CoefSpace} : x ∈ coronaIdeal ↔ Summable fun p => ‖x p‖ := Iff.rfl

/-- **`(5)`.**  The diagonal multiplier. -/
def diagMulLin (m : CoefSpace) : CoefSpace →ₗ[ℂ] CoefSpace where
  toFun x := fun p => m p * x p
  map_add' x y := by funext p; simp; ring
  map_smul' a x := by funext p; simp; ring

@[simp] theorem diagMulLin_apply (m x : CoefSpace) (p : Nat.Primes) :
    diagMulLin m x p = m p * x p := rfl

/-! ### Theorem 2.1 — the diagonal classification -/

/-- A bounded multiplier preserves the corona ideal. -/
theorem diagMulLin_mem_of_bounded {m : CoefSpace} {C : ℝ} (hC : ∀ p, ‖m p‖ ≤ C) {x : CoefSpace}
    (hx : x ∈ coronaIdeal) : diagMulLin m x ∈ coronaIdeal := by
  have hC0 : 0 ≤ C := le_trans (norm_nonneg (m ⟨2, Nat.prime_two⟩)) (hC _)
  refine Summable.of_nonneg_of_le (fun p => norm_nonneg _) (fun p => ?_) (hx.mul_left C)
  rw [diagMulLin_apply, norm_mul]
  exact mul_le_mul_of_nonneg_right (hC p) (norm_nonneg _)

/-- The prime enumeration. -/
noncomputable def primeEnum (n : ℕ) : Nat.Primes := ⟨Nat.nth Nat.Prime n, Nat.prime_nth_prime n⟩

theorem primeEnum_surjective : Function.Surjective primeEnum := fun p =>
  ⟨Nat.count Nat.Prime (p : ℕ), Subtype.ext (Nat.nth_count p.2)⟩

theorem primeEnum_injective : Function.Injective primeEnum := by
  intro a b hab
  have h := congrArg (fun q : Nat.Primes => (q : ℕ)) hab
  exact Nat.nth_injective Nat.infinite_setOf_prime h

/-- An unbounded multiplier is large along an injective sequence of primes. -/
theorem exists_injective_large {m : CoefSpace} (hub : ∀ C : ℝ, ∃ p, C < ‖m p‖) :
    ∃ q : ℕ → Nat.Primes, Function.Injective q ∧ ∀ n : ℕ, ((n : ℝ) + 1) ^ 3 ≤ ‖m (q n)‖ := by
  classical
  set a : ℕ → ℝ := fun k => ‖m (primeEnum k)‖ with ha
  have hfreq : ∀ n : ℕ, ∃ᶠ k in atTop, ((n : ℝ) + 1) ^ 3 ≤ a k := by
    intro n
    rw [frequently_atTop]
    intro N
    obtain ⟨p, hp⟩ := hub (max (((n : ℝ) + 1) ^ 3)
      ((Finset.range (N + 1)).sup' (by simp) a))
    obtain ⟨k, rfl⟩ := primeEnum_surjective p
    refine ⟨k, ?_, le_trans (le_max_left _ _) hp.le⟩
    by_contra hk
    push Not at hk
    have hmem : k ∈ Finset.range (N + 1) := Finset.mem_range.2 (by omega)
    have hle : a k ≤ (Finset.range (N + 1)).sup' (by simp) a :=
      Finset.le_sup' a hmem
    have := lt_of_le_of_lt (le_max_right (((n : ℝ) + 1) ^ 3)
      ((Finset.range (N + 1)).sup' (by simp) a)) hp
    linarith
  obtain ⟨φ, hφ, hP⟩ := Filter.extraction_forall_of_frequently hfreq
  exact ⟨primeEnum ∘ φ, primeEnum_injective.comp hφ.injective, hP⟩

/-- **Theorem 2.1 (1).**  A diagonal multiplier preserves the corona ideal exactly when it is
bounded. -/
theorem diagMulLin_mem_iff_bounded (m : CoefSpace) :
    (∀ x ∈ coronaIdeal, diagMulLin m x ∈ coronaIdeal) ↔ ∃ C : ℝ, ∀ p, ‖m p‖ ≤ C := by
  classical
  constructor
  · intro hpres
    by_contra hub
    push Not at hub
    have hub' : ∀ C : ℝ, ∃ p, C < ‖m p‖ := fun C => hub C
    obtain ⟨q, hq, hlarge⟩ := exists_injective_large hub'
    set u : ℕ → ℂ := fun n => if m (q n) = 0 then 0 else
      (((((n : ℝ) + 1) ^ 2)⁻¹ : ℝ) : ℂ) * (starRingEnd ℂ (m (q n)) / (‖m (q n)‖ : ℂ)) with hu
    set x : CoefSpace := fun p => if h : ∃ n, q n = p then u h.choose else 0 with hx
    have hxq : ∀ n : ℕ, x (q n) = u n := by
      intro n
      have hex : ∃ k, q k = q n := ⟨n, rfl⟩
      rw [hx]
      simp only [dif_pos hex]
      congr 1
      exact hq hex.choose_spec
    have hmq : ∀ n : ℕ, m (q n) ≠ 0 := by
      intro n hzero
      have hl := hlarge n
      rw [hzero, norm_zero] at hl
      have hpos : (0 : ℝ) < ((n : ℝ) + 1) ^ 3 := by positivity
      linarith
    have hnormu : ∀ n : ℕ, ‖u n‖ = (((n : ℝ) + 1) ^ 2)⁻¹ := by
      intro n
      rw [hu]
      simp only [if_neg (hmq n)]
      rw [norm_mul, norm_div, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
        Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (by positivity : (0:ℝ) < (((n : ℝ) + 1) ^ 2)⁻¹),
        abs_of_pos (norm_pos_iff.2 (hmq n)), div_self (norm_pos_iff.2 (hmq n)).ne', mul_one]
    have hbase : Summable fun n : ℕ => (((n : ℝ) + 1) ^ 2)⁻¹ := by
      have h1 : Summable fun n : ℕ => 1 / ((n : ℝ)) ^ 2 :=
        Real.summable_one_div_nat_pow.2 (by norm_num)
      have h2 : Summable fun n : ℕ => 1 / (((n + 1 : ℕ) : ℝ)) ^ 2 := (summable_nat_add_iff 1).2 h1
      exact h2.congr fun n => by push_cast; rw [one_div]
    have hzero : ∀ p : Nat.Primes, p ∉ Set.range q → ‖x p‖ = 0 := by
      intro p hp
      have hne : ¬ ∃ n, q n = p := fun ⟨n, hn⟩ => hp ⟨n, hn⟩
      rw [hx]
      simp only [dif_neg hne, norm_zero]
    have hxsum : Summable fun p => ‖x p‖ := by
      refine (hq.summable_iff hzero).1 ?_
      exact hbase.congr fun n => by rw [Function.comp_apply, hxq, hnormu]
    have hmem : diagMulLin m x ∈ coronaIdeal := hpres x hxsum
    have hcomp := hmem.comp_injective hq
    have hlow : ∀ n : ℕ, ((n : ℝ) + 1) ≤ ((fun p => ‖diagMulLin m x p‖) ∘ q) n := by
      intro n
      simp only [Function.comp_apply, diagMulLin_apply, norm_mul, hxq, hnormu]
      have h2 : (0 : ℝ) < ((n : ℝ) + 1) := by positivity
      calc ((n : ℝ) + 1) = ((n : ℝ) + 1) ^ 3 * (((n : ℝ) + 1) ^ 2)⁻¹ := by
            field_simp
            try ring
        _ ≤ ‖m (q n)‖ * (((n : ℝ) + 1) ^ 2)⁻¹ := by
            gcongr
            exact hlarge n
    have hdiv : ¬ Summable fun n : ℕ => ((n : ℝ) + 1) := by
      intro hs
      have hz := hs.tendsto_atTop_zero
      have h1 : Filter.Tendsto (fun n : ℕ => ((n : ℝ) + 1)) atTop atTop :=
        tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop
      exact not_tendsto_nhds_of_tendsto_atTop h1 0 hz
    exact hdiv (hcomp.of_nonneg_of_le (fun n => by positivity) hlow)
  · rintro ⟨C, hC⟩ x hx
    exact diagMulLin_mem_of_bounded hC hx

/-- **Theorem 2.1 (2).**  The descended multiplier is injective exactly when the multiplier is
bounded away from zero off a finite set. -/
theorem diagMul_ker_iff (m : CoefSpace) :
    (∀ x : CoefSpace, diagMulLin m x ∈ coronaIdeal → x ∈ coronaIdeal)
      ↔ ∃ (F : Finset Nat.Primes) (ε : ℝ), 0 < ε ∧ ∀ p ∉ F, ε ≤ ‖m p‖ := by
  classical
  constructor
  · intro hinj
    by_contra hcon
    push Not at hcon
    have hfreq : ∀ n : ℕ, ∃ᶠ k in atTop, ‖m (primeEnum k)‖ < (2 : ℝ) ^ (-(n : ℤ)) := by
      intro n
      rw [frequently_atTop]
      intro N
      obtain ⟨p, hpF, hp⟩ := hcon ((Finset.range N).image primeEnum) ((2 : ℝ) ^ (-(n : ℤ)))
        (by positivity)
      obtain ⟨k, rfl⟩ := primeEnum_surjective p
      refine ⟨k, ?_, hp⟩
      by_contra hk
      push Not at hk
      exact hpF (Finset.mem_image.2 ⟨k, Finset.mem_range.2 hk, rfl⟩)
    obtain ⟨φ, hφ, hP⟩ := Filter.extraction_forall_of_frequently hfreq
    set q : ℕ → Nat.Primes := primeEnum ∘ φ with hqdef
    have hq : Function.Injective q := primeEnum_injective.comp hφ.injective
    set x : CoefSpace := fun p => if ∃ n, q n = p then 1 else 0 with hx
    have hxq : ∀ n : ℕ, x (q n) = 1 := by
      intro n
      have hex : ∃ k, q k = q n := ⟨n, rfl⟩
      rw [hx]
      simp only [if_pos hex]
    have hxzero : ∀ p : Nat.Primes, p ∉ Set.range q → ‖diagMulLin m x p‖ = 0 := by
      intro p hp
      have hne : ¬ ∃ n, q n = p := fun ⟨n, hn⟩ => hp ⟨n, hn⟩
      rw [diagMulLin_apply, hx]
      simp only [if_neg hne, mul_zero, norm_zero]
    have hmx : diagMulLin m x ∈ coronaIdeal := by
      refine (hq.summable_iff hxzero).1 ?_
      have hb : Summable fun n : ℕ => (2 : ℝ) ^ (-(n : ℤ)) := by
        have := summable_geometric_of_lt_one (r := (2 : ℝ)⁻¹) (by norm_num) (by norm_num)
        refine this.congr fun n => ?_
        rw [zpow_neg, zpow_natCast, ← inv_pow]
      refine hb.of_nonneg_of_le (fun n => norm_nonneg _) fun n => ?_
      simp only [Function.comp_apply, diagMulLin_apply, norm_mul, hxq, norm_one, mul_one]
      exact (hP n).le
    have hxmem := hinj x hmx
    have hxsum : Summable fun n : ℕ => ‖x (q n)‖ := hxmem.comp_injective hq
    have hone : ∀ n : ℕ, ‖x (q n)‖ = 1 := fun n => by rw [hxq, norm_one]
    have := (hxsum.congr hone).tendsto_atTop_zero
    have hlim : Filter.Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (nhds 1) := tendsto_const_nhds
    have := tendsto_nhds_unique this hlim
    norm_num at this
  · rintro ⟨F, ε, hε, hF⟩ x hx
    have hcompl : Summable fun p : {p : Nat.Primes // p ∉ F} => ‖x (p : Nat.Primes)‖ := by
      have hsub : Summable fun p : {p : Nat.Primes // p ∉ F} => ‖diagMulLin m x (p : Nat.Primes)‖ :=
        (Finset.summable_compl_iff F).2 hx
      refine (hsub.mul_left ε⁻¹).of_nonneg_of_le (fun p => norm_nonneg _) fun p => ?_
      rw [diagMulLin_apply, norm_mul]
      rw [inv_mul_eq_div, le_div_iff₀ hε]
      have h1 := hF (p : Nat.Primes) p.2
      nlinarith [norm_nonneg (x (p : Nat.Primes)), hε]
    exact (Finset.summable_compl_iff F).1 hcompl

/-- **Theorem 2.1 (3).**  A multiplier equal to one off a finite set induces the identity. -/
theorem diagMul_sub_mem_of_eq_one {m : CoefSpace} {F : Finset Nat.Primes}
    (hF : ∀ p ∉ F, m p = 1) (x : CoefSpace) : diagMulLin m x - x ∈ coronaIdeal := by
  classical
  refine (Finset.summable_compl_iff F).1 ?_
  have hz : ∀ p : {p : Nat.Primes // p ∉ F}, ‖(diagMulLin m x - x) (p : Nat.Primes)‖ = 0 := by
    intro p
    simp only [Pi.sub_apply, diagMulLin_apply, hF _ p.2, one_mul, sub_self, norm_zero]
  exact summable_zero.congr fun p => (hz p).symm

/-- **Theorem 2.1 (4).**  A multiplier whose large-value sets are finite induces a noninjective
map. -/
theorem diagMul_not_ker_of_small {m : CoefSpace}
    (hm : ∀ ε : ℝ, 0 < ε → {p : Nat.Primes | ε ≤ ‖m p‖}.Finite) :
    ¬ ∀ x : CoefSpace, diagMulLin m x ∈ coronaIdeal → x ∈ coronaIdeal := by
  classical
  rw [diagMul_ker_iff]
  rintro ⟨F, ε, hε, hF⟩
  have hsub : ((↑F : Set Nat.Primes))ᶜ ⊆ {p : Nat.Primes | ε ≤ ‖m p‖} := fun p hp => hF p hp
  exact (Set.Finite.infinite_compl F.finite_toSet) ((hm ε hε).subset hsub)

end Corona

section GammaFlow

/-- **`(2)`.**  The occupancy Fisher density. -/
noncomputable def dCoef (p : Nat.Primes) : ℝ := (p : ℝ) / ((p : ℝ) + 1) ^ 2

theorem dCoef_pos (p : Nat.Primes) : 0 < dCoef p := by
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  rw [dCoef]
  positivity

theorem inv_four_mul_le_dCoef (p : Nat.Primes) : (4 * (p : ℝ))⁻¹ ≤ dCoef p := by
  have hp : (1 : ℝ) ≤ (p : ℕ) := by exact_mod_cast p.2.one_lt.le
  have hp0 : (0 : ℝ) < (p : ℕ) := by linarith
  rw [dCoef, inv_le_iff_one_le_mul₀ (by positivity)]
  rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
  nlinarith

/-- **`(2)`.**  The Gamma coefficient family. -/
noncomputable def gammaCoef (t : ℝ) (p : Nat.Primes) : ℂ := ((dCoef p * (p : ℝ) ^ t : ℝ) : ℂ)

/-- **`(2)`.**  The physical Bockstein. -/
noncomputable def bockstein (t : ℝ) : CoefSpace := fun p => gammaCoef (-t) p - gammaCoef t p

@[simp] theorem bockstein_zero : bockstein 0 = 0 := by
  funext p
  simp [bockstein]

theorem norm_bockstein (t : ℝ) (p : Nat.Primes) :
    ‖bockstein t p‖ = dCoef p * |(p : ℝ) ^ (-t) - (p : ℝ) ^ t| := by
  have hd := (dCoef_pos p).le
  show ‖gammaCoef (-t) p - gammaCoef t p‖ = _
  rw [gammaCoef, gammaCoef, ← Complex.ofReal_sub, Complex.norm_real,
    Real.norm_eq_abs, ← mul_sub, abs_mul, abs_of_nonneg hd]

theorem bockstein_neg (t : ℝ) : bockstein (-t) = -bockstein t := by
  funext p
  show gammaCoef (- -t) p - gammaCoef (-t) p = -(gammaCoef (-t) p - gammaCoef t p)
  rw [neg_neg]
  ring

theorem bockstein_not_mem_of_pos {s : ℝ} (hs : 0 < s) : bockstein s ∉ coronaIdeal := by
  intro hcon
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlow : ∀ p : Nat.Primes,
      (s * Real.log 2 / 4) * (1 / (p : ℝ)) ≤ ‖bockstein s p‖ := by
    intro p
    have hp1 : (1 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.one_lt
    have hp0 : (0 : ℝ) < (p : ℕ) := by linarith
    have hlogp : Real.log 2 ≤ Real.log p :=
      Real.log_le_log (by norm_num) (by exact_mod_cast p.2.two_le)
    have hpt : (1 : ℝ) + s * Real.log p ≤ (p : ℝ) ^ s := by
      rw [Real.rpow_def_of_pos hp0]
      have hx := Real.add_one_le_exp (Real.log p * s)
      nlinarith
    have hnegt : (p : ℝ) ^ (-s) ≤ 1 := by
      rw [Real.rpow_neg hp0.le, inv_le_one₀ (Real.rpow_pos_of_pos hp0 s)]
      exact Real.one_le_rpow hp1.le hs.le
    have habs : s * Real.log 2 ≤ |(p : ℝ) ^ (-s) - (p : ℝ) ^ s| := by
      have hge : s * Real.log 2 ≤ (p : ℝ) ^ s - (p : ℝ) ^ (-s) := by
        nlinarith [mul_le_mul_of_nonneg_left hlogp hs.le]
      have hnn : (0 : ℝ) ≤ (p : ℝ) ^ s - (p : ℝ) ^ (-s) := by
        nlinarith [mul_le_mul_of_nonneg_left hlogp hs.le, Real.log_nonneg hp1.le]
      rw [abs_sub_comm, abs_of_nonneg hnn]
      exact hge
    rw [norm_bockstein]
    have hd := inv_four_mul_le_dCoef p
    have h1 : (s * Real.log 2 / 4) * (1 / (p : ℝ)) = (4 * (p : ℝ))⁻¹ * (s * Real.log 2) := by
      field_simp
    rw [h1]
    exact mul_le_mul hd habs (by positivity) (dCoef_pos p).le
  have hnn : ∀ p : Nat.Primes, 0 ≤ (s * Real.log 2 / 4) * (1 / (p : ℝ)) := by
    intro p
    have hp0 : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
    positivity
  have hs2 : Summable fun p : Nat.Primes => (s * Real.log 2 / 4) * (1 / (p : ℝ)) :=
    hcon.of_nonneg_of_le hnn hlow
  refine Nat.Primes.not_summable_one_div ?_
  have hc : (s * Real.log 2 / 4) ≠ 0 := by positivity
  exact (hs2.mul_left (s * Real.log 2 / 4)⁻¹).congr fun p => by field_simp

/-- **`(3)`.**  The corona class of the Bockstein vanishes only at the neutral grade. -/
theorem bockstein_mem_coronaIdeal_iff (t : ℝ) : bockstein t ∈ coronaIdeal ↔ t = 0 := by
  constructor
  · intro hmem
    rcases lt_trichotomy t 0 with h | h | h
    · refine absurd ?_ (bockstein_not_mem_of_pos (s := -t) (by linarith))
      rw [bockstein_neg]
      exact coronaIdeal.neg_mem hmem
    · exact h
    · exact absurd hmem (bockstein_not_mem_of_pos h)
  · rintro rfl
    rw [bockstein_zero]
    exact coronaIdeal.zero_mem

end GammaFlow


section RawFlow

/-- **`(8)`.**  The raw Gamma scaling multiplier. -/
noncomputable def gammaMul (t : ℝ) (p : Nat.Primes) : ℂ := (((p : ℝ) ^ (-2 * t) : ℝ) : ℂ)

@[simp] theorem norm_gammaMul (t : ℝ) (p : Nat.Primes) :
    ‖gammaMul t p‖ = (p : ℝ) ^ (-2 * t) := by
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  rw [gammaMul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.rpow_pos_of_pos hp _)]

/-- **`(9)`.**  The raw flow is a group. -/
theorem gammaFlow_group (s t : ℝ) (x : CoefSpace) :
    diagMulLin (gammaMul s) (diagMulLin (gammaMul t) x) = diagMulLin (gammaMul (s + t)) x := by
  funext p
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  simp only [diagMulLin_apply, gammaMul]
  rw [← mul_assoc, ← Complex.ofReal_mul, ← Real.rpow_add hp]
  congr 2
  ring

@[simp] theorem gammaMul_zero (p : Nat.Primes) : gammaMul 0 p = 1 := by
  simp [gammaMul]

/-- **`(10)`.**  Its coordinatewise generator is twice the signed Kummer period. -/
theorem hasDerivAt_gammaMul (p : Nat.Primes) :
    HasDerivAt (fun t : ℝ => ((p : ℝ) ^ (-2 * t) : ℝ)) (-2 * Real.log p) 0 := by
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  have hbase : HasDerivAt (fun t : ℝ => Real.log p * (-2 * t)) (Real.log p * -2) 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).const_mul (-2 : ℝ)).const_mul (Real.log p)
  have hexp := hbase.exp
  have hval : Real.exp (Real.log p * (-2 * 0)) * (Real.log p * -2) = -2 * Real.log p := by
    simp
    ring
  rw [hval] at hexp
  refine hexp.congr_of_eventuallyEq ?_
  filter_upwards with t
  rw [Real.rpow_def_of_pos hp]

theorem finite_primes_le (N : ℕ) : {p : Nat.Primes | (p : ℕ) ≤ N}.Finite := by
  refine Set.Finite.of_finite_image ?_ (Set.injOn_of_injective Subtype.val_injective)
  refine Set.Finite.subset (Finset.range (N + 1)).finite_toSet ?_
  rintro n ⟨p, hp, rfl⟩
  simpa using Nat.lt_succ_of_le hp

/-- **Theorem 3.1 (3).**  The raw flow descends to the fixed corona exactly for `t ≥ 0`. -/
theorem gammaMul_bounded_iff (t : ℝ) : (∃ C : ℝ, ∀ p, ‖gammaMul t p‖ ≤ C) ↔ 0 ≤ t := by
  constructor
  · rintro ⟨C, hC⟩
    by_contra ht
    push Not at ht
    have hs : (0 : ℝ) < -2 * t := by linarith
    obtain ⟨M, hM⟩ := exists_nat_gt (Real.exp ((max C 0 + 1) / (-2 * t)))
    obtain ⟨q, hqM, hqprime⟩ := Nat.exists_infinite_primes M
    set p : Nat.Primes := ⟨q, hqprime⟩ with hp
    have hq0 : (0 : ℝ) < ((q : ℕ) : ℝ) := by exact_mod_cast hqprime.pos
    have hMq : ((M : ℕ) : ℝ) ≤ ((q : ℕ) : ℝ) := by exact_mod_cast hqM
    have hexp : Real.exp ((max C 0 + 1) / (-2 * t)) < ((q : ℕ) : ℝ) := lt_of_lt_of_le hM hMq
    have hlog : (max C 0 + 1) / (-2 * t) < Real.log ((q : ℕ) : ℝ) := by
      have := Real.log_lt_log (Real.exp_pos _) hexp
      rwa [Real.log_exp] at this
    have hbig : max C 0 + 1 < (-2 * t) * Real.log ((q : ℕ) : ℝ) := by
      rw [div_lt_iff₀ hs] at hlog
      linarith
    have hrp : (1 : ℝ) + (-2 * t) * Real.log ((q : ℕ) : ℝ) ≤ ((q : ℕ) : ℝ) ^ (-2 * t) := by
      rw [Real.rpow_def_of_pos hq0]
      have hx := Real.add_one_le_exp (Real.log ((q : ℕ) : ℝ) * (-2 * t))
      nlinarith
    have hle := hC p
    rw [norm_gammaMul] at hle
    have : max C 0 + 1 ≤ C := by
      have hpp : ((p : ℕ) : ℝ) = ((q : ℕ) : ℝ) := rfl
      rw [hpp] at hle
      linarith
    have h0 : C ≤ max C 0 := le_max_left _ _
    linarith
  · intro ht
    refine ⟨1, fun p => ?_⟩
    have hp1 : (1 : ℝ) ≤ (p : ℕ) := by exact_mod_cast p.2.one_lt.le
    rw [norm_gammaMul]
    exact Real.rpow_le_one_of_one_le_of_nonpos hp1 (by linarith)

/-- **Theorem 3.1 (3).**  For `t ≥ 0` the descended map is surjective on raw representatives. -/
theorem gammaFlow_surjective (t : ℝ) (y : CoefSpace) :
    ∃ x : CoefSpace, diagMulLin (gammaMul t) x = y := by
  refine ⟨fun p => (((p : ℝ) ^ (2 * t) : ℝ) : ℂ) * y p, ?_⟩
  funext p
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  simp only [diagMulLin_apply, gammaMul]
  rw [← mul_assoc, ← Complex.ofReal_mul, ← Real.rpow_add hp]
  norm_num

/-- **Theorem 3.1 (3).**  For `t > 0` the descended map is not injective. -/
theorem gammaFlow_not_injective {t : ℝ} (ht : 0 < t) :
    ¬ ∀ x : CoefSpace, diagMulLin (gammaMul t) x ∈ coronaIdeal → x ∈ coronaIdeal := by
  refine diagMul_not_ker_of_small fun ε hε => ?_
  obtain ⟨N, hN⟩ := exists_nat_gt ((1 / ε) ^ (1 / (2 * t)))
  refine (finite_primes_le N).subset fun p hp => ?_
  simp only [Set.mem_setOf_eq, norm_gammaMul] at hp ⊢
  by_contra hcon
  push Not at hcon
  have hp0 : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  have hNp : ((N : ℕ) : ℝ) < ((p : ℕ) : ℝ) := by exact_mod_cast hcon
  have hbig : ((1 / ε) ^ (1 / (2 * t))) < ((p : ℕ) : ℝ) := lt_trans hN hNp
  have h1 : (1 / ε) < ((p : ℕ) : ℝ) ^ (2 * t) := by
    have hb : (0 : ℝ) ≤ (1 / ε) ^ (1 / (2 * t)) := Real.rpow_nonneg (by positivity) _
    have hlt := Real.rpow_lt_rpow hb hbig (by positivity : (0:ℝ) < 2 * t)
    rwa [← Real.rpow_mul (by positivity : (0:ℝ) ≤ 1 / ε), one_div (2 * t),
      inv_mul_cancel₀ (by positivity : (2 * t) ≠ 0), Real.rpow_one] at hlt
  have h2 : ((p : ℕ) : ℝ) ^ (-2 * t) < ε := by
    rw [show (-2 : ℝ) * t = -(2 * t) by ring, Real.rpow_neg hp0.le,
      inv_lt_comm₀ (Real.rpow_pos_of_pos hp0 _) hε]
    rw [one_div] at h1
    exact h1
  linarith

/-- **Theorem 3.1 (4), `(11)`.**  The finite holonomy of the raw flow on the Gamma coefficient
family is the physical Bockstein. -/
theorem gammaFlow_holonomy (t : ℝ) :
    diagMulLin (gammaMul t) (gammaCoef t) - gammaCoef t = bockstein t := by
  funext p
  have hp : (0 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.pos
  show gammaMul t p * gammaCoef t p - gammaCoef t p = gammaCoef (-t) p - gammaCoef t p
  congr 1
  rw [gammaMul, gammaCoef, gammaCoef, ← Complex.ofReal_mul]
  congr 1
  rw [← mul_assoc, mul_comm ((p : ℝ) ^ (-2 * t)) (dCoef p), mul_assoc, ← Real.rpow_add hp]
  congr 2
  ring

end RawFlow

section MovingIdeal

/-- **`(13)`.**  The moving corona ideal of a linear automorphism. -/
noncomputable def movingIdeal (A : CoefSpace ≃ₗ[ℂ] CoefSpace) : Submodule ℂ CoefSpace :=
  Submodule.map (A : CoefSpace →ₗ[ℂ] CoefSpace) coronaIdeal

/-- **Theorem 4.1, `(14)`.**  Moving-ideal transport is an isomorphism. -/
noncomputable def movingTransport (A : CoefSpace ≃ₗ[ℂ] CoefSpace) :
    (CoefSpace ⧸ coronaIdeal) ≃ₗ[ℂ] (CoefSpace ⧸ movingIdeal A) :=
  Submodule.Quotient.equiv coronaIdeal (movingIdeal A) A rfl

/-- **Theorem 4.1, `(15)`.**  Transport between two moving fibres. -/
noncomputable def movingComp (A B : CoefSpace ≃ₗ[ℂ] CoefSpace) :
    (CoefSpace ⧸ movingIdeal A) ≃ₗ[ℂ] (CoefSpace ⧸ movingIdeal B) :=
  (movingTransport A).symm.trans (movingTransport B)

/-- **Theorem 4.1, `(16)`.**  The transports compose. -/
theorem movingComp_trans (A B C : CoefSpace ≃ₗ[ℂ] CoefSpace)
    (z : CoefSpace ⧸ movingIdeal A) :
    movingComp B C (movingComp A B z) = movingComp A C z := by
  simp [movingComp]

end MovingIdeal

section Rigidity

/-- **Corollary 5.1 (1).**  Nonzero scalar normalization preserves the corona class. -/
theorem rigidity_scalar {c : ℂ} (hc : c ≠ 0) (x : CoefSpace) :
    c • x ∈ coronaIdeal ↔ x ∈ coronaIdeal := by
  constructor
  · intro h
    have := coronaIdeal.smul_mem c⁻¹ h
    rwa [smul_smul, inv_mul_cancel₀ hc, one_smul] at this
  · exact fun h => coronaIdeal.smul_mem c h

/-- **Corollary 5.1 (2).**  A finite diagonal change preserves the corona class. -/
theorem rigidity_finite_change {m : CoefSpace} {F : Finset Nat.Primes}
    (hF : ∀ p ∉ F, m p = 1) (x : CoefSpace) :
    diagMulLin m x ∈ coronaIdeal ↔ x ∈ coronaIdeal := by
  have hdiff := diagMul_sub_mem_of_eq_one hF x
  constructor
  · intro h
    have := coronaIdeal.sub_mem h hdiff
    simpa using this
  · intro h
    have := coronaIdeal.add_mem h hdiff
    simpa using this

/-- **Corollary 5.1 (3).**  A bounded diagonal intervention with a cofinite lower bound preserves
the corona class. -/
theorem rigidity_cofinite_lower {m : CoefSpace} {C : ℝ} (hb : ∀ p, ‖m p‖ ≤ C)
    (hlow : ∃ (F : Finset Nat.Primes) (ε : ℝ), 0 < ε ∧ ∀ p ∉ F, ε ≤ ‖m p‖) (x : CoefSpace) :
    diagMulLin m x ∈ coronaIdeal ↔ x ∈ coronaIdeal :=
  ⟨(diagMul_ker_iff m).2 hlow x, fun h => diagMulLin_mem_of_bounded hb h⟩

/-- **Corollary 5.1 (4).**  Moving-ideal transport preserves vanishing of the class. -/
theorem rigidity_moving (A : CoefSpace ≃ₗ[ℂ] CoefSpace) (x : CoefSpace) :
    movingTransport A (Submodule.Quotient.mk x) = 0
      ↔ (Submodule.Quotient.mk x : CoefSpace ⧸ coronaIdeal) = 0 :=
  ⟨fun h => by simpa using congrArg (movingTransport A).symm h,
    fun h => by rw [h, map_zero]⟩

/-- **Intervention rigidity.**  For every grade the physical Bockstein class survives every scalar
normalization, finite diagonal change, cofinitely invertible bounded diagonal intervention and
moving-ideal transport; it vanishes only at the neutral grade. -/
theorem intervention_rigidity {t : ℝ} (ht : t ≠ 0) :
    bockstein t ∉ coronaIdeal ∧
    (∀ c : ℂ, c ≠ 0 → c • bockstein t ∉ coronaIdeal) ∧
    (∀ (m : CoefSpace) (F : Finset Nat.Primes), (∀ p ∉ F, m p = 1) →
      diagMulLin m (bockstein t) ∉ coronaIdeal) ∧
    (∀ (m : CoefSpace) (C : ℝ), (∀ p, ‖m p‖ ≤ C) →
      (∃ (F : Finset Nat.Primes) (ε : ℝ), 0 < ε ∧ ∀ p ∉ F, ε ≤ ‖m p‖) →
      diagMulLin m (bockstein t) ∉ coronaIdeal) ∧
    (∀ A : CoefSpace ≃ₗ[ℂ] CoefSpace,
      movingTransport A (Submodule.Quotient.mk (bockstein t)) ≠ 0) := by
  have hb : bockstein t ∉ coronaIdeal := fun h => ht ((bockstein_mem_coronaIdeal_iff t).1 h)
  refine ⟨hb, ?_, ?_, ?_, ?_⟩
  · exact fun c hc h => hb ((rigidity_scalar hc _).1 h)
  · exact fun m F hF h => hb ((rigidity_finite_change hF _).1 h)
  · exact fun m C hbd hlow h => hb ((rigidity_cofinite_lower hbd hlow _).1 h)
  · intro A h
    rw [rigidity_moving] at h
    exact hb ((Submodule.Quotient.mk_eq_zero _).1 h)

end Rigidity

