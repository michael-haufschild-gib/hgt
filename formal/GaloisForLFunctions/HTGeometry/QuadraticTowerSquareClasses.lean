import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.Tactic

/-!
# Square classes along a quadratic tower

A tower `K₀ ⊆ K₁ ⊆ … ⊆ K_k` of subfields of `L`, where each step is spanned by `1` and a square
root `ρ_j` of an element `d_j = ρ_j²` of the previous stage, creates no square classes beyond the
`2^k` twists by the `d_j`.  Precisely, an element of the bottom field that becomes a square at the
top is, after multiplication by some sub-product of the `d_j`, already a square at the bottom.

Consequently, if no nonempty sub-product of the `d_j` is a square at the bottom, then every `ρ_j`
is genuinely new at its stage, so the tower is strictly increasing at every step: this is the
Kummer independence used to compute a multiquadratic Galois group.

Everything is phrased with `Subfield L` and elements of `L`, so no `Algebra` instances, coercions
or `IntermediateField.restrictScalars` bookkeeping appear.

## Main results

* `isSq_or_isSq_mul_of_span` — one quadratic step creates at most the one new square class `d`.
* `QuadraticTower` — the tower data.
* `QuadraticTower.exists_twist_isSq` — the square-class statement along the whole tower.
* `QuadraticTower.notMem_of_independent` — independence makes every step strict.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

variable {L : Type*} [Field L]

/-- `x` is a square inside the subfield `K`. -/
def IsSqIn (K : Subfield L) (x : L) : Prop := ∃ w ∈ K, x = w * w

theorem isSqIn_mul_self {K : Subfield L} {w : L} (hw : w ∈ K) : IsSqIn K (w * w) :=
  ⟨w, hw, rfl⟩

/-- **One quadratic step creates only the square class of `d = r * r`.**  If an element `c` of `K`
is the square of `x + y r` with `x, y ∈ K` and `r ∉ K`, then `c` or `(r*r) * c` is already a
square in `K`. -/
theorem isSq_or_isSq_mul_of_span {K : Subfield L} {r c x y : L}
    (h2 : (2 : L) ≠ 0) (hrr : r * r ∈ K) (hrK : r ∉ K)
    (hc : c ∈ K) (hx : x ∈ K) (hy : y ∈ K)
    (hz : c = (x + y * r) * (x + y * r)) :
    IsSqIn K c ∨ IsSqIn K ((r * r) * c) := by
  have hexp : c = (x * x + y * y * (r * r)) + (2 * (x * y)) * r := by
    rw [hz]; ring
  have hxy : x * y = 0 := by
    by_contra hne
    have h2xy : 2 * (x * y) ≠ 0 := mul_ne_zero h2 hne
    have h2K : (2 : L) ∈ K := by
      have h1 := K.one_mem
      have hsum := K.add_mem h1 h1
      rwa [show (1 : L) + 1 = 2 by norm_num] at hsum
    have hrmem : r ∈ K := by
      have hsolve : r = (c - (x * x + y * y * (r * r))) / (2 * (x * y)) := by
        rw [eq_div_iff h2xy]
        linear_combination -hexp
      rw [hsolve]
      exact K.div_mem (K.sub_mem hc (K.add_mem (K.mul_mem hx hx)
        (K.mul_mem (K.mul_mem hy hy) hrr)))
        (K.mul_mem h2K (K.mul_mem hx hy))
    exact hrK hrmem
  have hc' : c = x * x + y * y * (r * r) := by
    rw [hexp, hxy]
    ring
  rcases mul_eq_zero.mp hxy with hx0 | hy0
  · right
    refine ⟨(r * r) * y, K.mul_mem hrr hy, ?_⟩
    rw [hc', hx0]
    ring
  · left
    refine ⟨x, hx, ?_⟩
    rw [hc', hy0]
    ring

/-- **The quadratic step is spanned by `1` and the root.**  If `r ∉ K` and `r * r ∈ K`, the
subfield generated by `K` and `r` is exactly `K + K·r`.  The inverse of `x + y r` is
`(x - y r)/(x² - y²(r*r))`, whose denominator cannot vanish precisely because `r ∉ K`. -/
theorem mem_closure_insert_iff {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K) :
    ∀ z ∈ Subfield.closure ((K : Set L) ∪ {r}), ∃ x ∈ K, ∃ y ∈ K, z = x + y * r := by
  classical
  have hden : ∀ x ∈ K, ∀ y ∈ K, x + y * r ≠ 0 → x * x - y * y * (r * r) ≠ 0 := by
    intro x hx y hy hne hzero
    by_cases hy0 : y = 0
    · subst hy0
      simp only [zero_mul, add_zero] at hne
      simp only [zero_mul, sub_zero, mul_eq_zero, or_self] at hzero
      exact hne hzero
    · have hsq : (x / y) * (x / y) = r * r := by
        field_simp
        linear_combination hzero
      have hfac : (r - x / y) * (r + x / y) = 0 := by linear_combination -hsq
      have hxy : x / y ∈ K := K.div_mem hx hy
      rcases mul_eq_zero.mp hfac with h | h
      · exact hrK (by rw [sub_eq_zero.mp h]; exact hxy)
      · refine hrK ?_
        have hr : r = -(x / y) := eq_neg_of_add_eq_zero_left h
        rw [hr]
        exact K.neg_mem hxy
  set S : Subfield L :=
    { carrier := {w : L | ∃ x ∈ K, ∃ y ∈ K, w = x + y * r}
      mul_mem' := by
        rintro _ _ ⟨x₁, hx₁, y₁, hy₁, rfl⟩ ⟨x₂, hx₂, y₂, hy₂, rfl⟩
        refine ⟨x₁ * x₂ + y₁ * y₂ * (r * r), K.add_mem (K.mul_mem hx₁ hx₂)
          (K.mul_mem (K.mul_mem hy₁ hy₂) hrr), x₁ * y₂ + y₁ * x₂,
          K.add_mem (K.mul_mem hx₁ hy₂) (K.mul_mem hy₁ hx₂), by ring⟩
      one_mem' := ⟨1, K.one_mem, 0, K.zero_mem, by ring⟩
      add_mem' := by
        rintro _ _ ⟨x₁, hx₁, y₁, hy₁, rfl⟩ ⟨x₂, hx₂, y₂, hy₂, rfl⟩
        exact ⟨x₁ + x₂, K.add_mem hx₁ hx₂, y₁ + y₂, K.add_mem hy₁ hy₂, by ring⟩
      zero_mem' := ⟨0, K.zero_mem, 0, K.zero_mem, by ring⟩
      neg_mem' := by
        rintro _ ⟨x, hx, y, hy, rfl⟩
        exact ⟨-x, K.neg_mem hx, -y, K.neg_mem hy, by ring⟩
      inv_mem' := by
        rintro _ ⟨x, hx, y, hy, rfl⟩
        by_cases hz : x + y * r = 0
        · rw [hz]
          exact ⟨0, K.zero_mem, 0, K.zero_mem, by simp⟩
        · have hd := hden x hx y hy hz
          refine ⟨x / (x * x - y * y * (r * r)),
            K.div_mem hx (K.sub_mem (K.mul_mem hx hx) (K.mul_mem (K.mul_mem hy hy) hrr)),
            -y / (x * x - y * y * (r * r)),
            K.div_mem (K.neg_mem hy) (K.sub_mem (K.mul_mem hx hx)
              (K.mul_mem (K.mul_mem hy hy) hrr)), ?_⟩
          have hstep : (x + y * r) *
              (x / (x * x - y * y * (r * r)) +
                (-y / (x * x - y * y * (r * r))) * r)
              = ((x + y * r) * (x + (-y) * r)) / (x * x - y * y * (r * r)) := by
            field_simp
          have hmul : (x + y * r) *
              (x / (x * x - y * y * (r * r)) +
                (-y / (x * x - y * y * (r * r))) * r) = 1 := by
            rw [hstep, show (x + y * r) * (x + (-y) * r) = x * x - y * y * (r * r) by ring,
              div_self hd]
          exact inv_eq_of_mul_eq_one_right hmul } with hS
  have hle : Subfield.closure ((K : Set L) ∪ {r}) ≤ S := by
    refine Subfield.closure_le.mpr ?_
    rintro w (hw | hw)
    · exact ⟨w, hw, 0, K.zero_mem, by ring⟩
    · have : w = r := hw
      subst this
      exact ⟨0, K.zero_mem, 1, K.one_mem, by ring⟩
  intro z hz
  exact hle hz

/-- **Uniqueness of the quadratic coordinates.**  When `r ∉ K` the representation `x + y r` with
`x, y ∈ K` is unique, so `{1, r}` is a `K`-basis of `K(r)`. -/
theorem span_unique {K : Subfield L} {r : L} (hrK : r ∉ K)
    {x y x' y' : L} (hx : x ∈ K) (hy : y ∈ K) (hx' : x' ∈ K) (hy' : y' ∈ K)
    (h : x + y * r = x' + y' * r) : x = x' ∧ y = y' := by
  by_cases hyy : y = y'
  · subst hyy
    refine ⟨?_, rfl⟩
    have : x = x' := by linear_combination h
    exact this
  · exfalso
    have hne : y - y' ≠ 0 := sub_ne_zero.mpr hyy
    have hr : r = (x' - x) / (y - y') := by
      rw [eq_div_iff hne]
      linear_combination h
    exact hrK (by rw [hr]; exact K.div_mem (K.sub_mem hx' hx) (K.sub_mem hy hy'))

/-! ### The induction in hypothesis form

The tower's `span` field can only be established *after* one knows that the previous root is new,
which is itself a consequence of the square-class statement one stage lower.  The version below
takes the tower data as hypotheses bounded by `j`, so it can be fed by a strong induction that
builds `span` and `notMem` together.
-/

/-- **Square classes along the first `j` steps.**  Only the data below stage `j` is used. -/
theorem exists_twist_isSq_of_partial
    (M : ℕ → Subfield L) (ρ : ℕ → L) (h2 : (2 : L) ≠ 0)
    (hmono : ∀ i, M i ≤ M (i + 1)) :
    ∀ j : ℕ,
      (∀ i, i < j → ρ i * ρ i ∈ M 0) →
      (∀ i, i < j → ∀ z ∈ M (i + 1), ∃ x ∈ M i, ∃ y ∈ M i, z = x + y * ρ i) →
      (∀ T : Finset ℕ, T ⊆ Finset.range j → T.Nonempty →
        ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i)) →
      ∀ c ∈ M 0, IsSqIn (M j) c →
        ∃ T ⊆ Finset.range j, IsSqIn (M 0) (c * ∏ i ∈ T, ρ i * ρ i) := by
  have hle : ∀ i j : ℕ, i ≤ j → M i ≤ M j := by
    intro i j hij
    induction j with
    | zero =>
        have hi : i = 0 := Nat.le_zero.mp hij
        subst hi
        exact le_rfl
    | succ n ih =>
        rcases Nat.lt_or_ge i (n + 1) with h | h
        · exact le_trans (ih (by omega)) (hmono n)
        · have hi : i = n + 1 := by omega
          subst hi
          exact le_rfl
  intro j
  induction j with
  | zero =>
      intro _ _ _ c hc hsq
      exact ⟨∅, by simp, by simpa using hsq⟩
  | succ n ih =>
      intro hsqmem hspan hindep c hc hsq
      have hsqmem' : ∀ i, i < n → ρ i * ρ i ∈ M 0 := fun i hi => hsqmem i (by omega)
      have hspan' : ∀ i, i < n → ∀ z ∈ M (i + 1), ∃ x ∈ M i, ∃ y ∈ M i, z = x + y * ρ i :=
        fun i hi => hspan i (by omega)
      have hindep' : ∀ T : Finset ℕ, T ⊆ Finset.range n → T.Nonempty →
          ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i) := by
        intro T hT hne
        refine hindep T (fun i hi => ?_) hne
        have := Finset.mem_range.mp (hT hi)
        exact Finset.mem_range.mpr (by omega)
      have hnot : ρ n ∉ M n := by
        intro hmem
        have hdsq : IsSqIn (M n) (ρ n * ρ n) := ⟨ρ n, hmem, rfl⟩
        obtain ⟨T, hT, hTsq⟩ := ih hsqmem' hspan' hindep' (ρ n * ρ n) (hsqmem n (by omega)) hdsq
        have hnT : n ∉ T := fun h => by
          have := Finset.mem_range.mp (hT h)
          omega
        refine hindep (insert n T) ?_ ⟨n, Finset.mem_insert_self _ _⟩ ?_
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hiT
          · exact Finset.mem_range.mpr (by omega)
          · have := Finset.mem_range.mp (hT hiT)
            exact Finset.mem_range.mpr (by omega)
        · rw [Finset.prod_insert hnT]
          exact hTsq
      obtain ⟨z, hz, hzz⟩ := hsq
      obtain ⟨x, hx, y, hy, hzeq⟩ := hspan n (by omega) z hz
      subst hzeq
      have hcMn : c ∈ M n := hle 0 n (Nat.zero_le n) hc
      have hrrMn : ρ n * ρ n ∈ M n := hle 0 n (Nat.zero_le n) (hsqmem n (by omega))
      rcases isSq_or_isSq_mul_of_span h2 hrrMn hnot hcMn hx hy hzz with hcase | hcase
      · obtain ⟨T, hT, hTsq⟩ := ih hsqmem' hspan' hindep' c hc hcase
        refine ⟨T, ?_, hTsq⟩
        intro i hi
        have hi' := Finset.mem_range.mp (hT hi)
        exact Finset.mem_range.mpr (by omega)
      · have hdc : ρ n * ρ n * c ∈ M 0 := (M 0).mul_mem (hsqmem n (by omega)) hc
        obtain ⟨T, hT, hTsq⟩ := ih hsqmem' hspan' hindep' (ρ n * ρ n * c) hdc hcase
        have hnT : n ∉ T := fun h => by
          have := Finset.mem_range.mp (hT h)
          omega
        refine ⟨insert n T, ?_, ?_⟩
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hiT
          · exact Finset.mem_range.mpr (by omega)
          · have := Finset.mem_range.mp (hT hiT)
            exact Finset.mem_range.mpr (by omega)
        · rw [Finset.prod_insert hnT]
          obtain ⟨w, hw, hweq⟩ := hTsq
          refine ⟨w, hw, ?_⟩
          rw [← hweq]
          ring

/-- **The step is strict**, in hypothesis form: independence one stage further makes the `j`-th
root new. -/
theorem notMem_of_partial
    (M : ℕ → Subfield L) (ρ : ℕ → L) (h2 : (2 : L) ≠ 0)
    (hmono : ∀ i, M i ≤ M (i + 1)) (j : ℕ)
    (hsqmem : ∀ i, i < j + 1 → ρ i * ρ i ∈ M 0)
    (hspan : ∀ i, i < j → ∀ z ∈ M (i + 1), ∃ x ∈ M i, ∃ y ∈ M i, z = x + y * ρ i)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range (j + 1) → T.Nonempty →
      ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i)) :
    ρ j ∉ M j := by
  intro hmem
  have hindep' : ∀ T : Finset ℕ, T ⊆ Finset.range j → T.Nonempty →
      ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i) := by
    intro T hT hne
    refine hindep T (fun i hi => ?_) hne
    have := Finset.mem_range.mp (hT hi)
    exact Finset.mem_range.mpr (by omega)
  have hdsq : IsSqIn (M j) (ρ j * ρ j) := ⟨ρ j, hmem, rfl⟩
  obtain ⟨T, hT, hTsq⟩ :=
    exists_twist_isSq_of_partial M ρ h2 hmono j (fun i hi => hsqmem i (by omega))
      hspan hindep' (ρ j * ρ j) (hsqmem j (by omega)) hdsq
  have hjT : j ∉ T := fun h => by
    have := Finset.mem_range.mp (hT h)
    omega
  refine hindep (insert j T) ?_ ⟨j, Finset.mem_insert_self _ _⟩ ?_
  · intro i hi
    rcases Finset.mem_insert.mp hi with rfl | hiT
    · exact Finset.mem_range.mpr (by omega)
    · have := Finset.mem_range.mp (hT hiT)
      exact Finset.mem_range.mpr (by omega)
  · rw [Finset.prod_insert hjT]
    exact hTsq

/-- A tower of subfields of `L`, each step spanned by `1` and a square root of an element of the
previous step. -/
structure QuadraticTower (L : Type*) [Field L] (k : ℕ) where
  /-- The subfields of the tower. -/
  M : ℕ → Subfield L
  /-- The adjoined square roots. -/
  ρ : ℕ → L
  /-- Every stage contains the previous one. -/
  mono : ∀ j, M j ≤ M (j + 1)
  /-- The `j`-th radicand already lies in the bottom stage. -/
  sq_mem : ∀ j, j < k → ρ j * ρ j ∈ M 0
  /-- The `j`-th root lies in the next stage. -/
  root_mem : ∀ j, j < k → ρ j ∈ M (j + 1)
  /-- Every element of the next stage is `x + y ρ j` with `x, y` in the current one. -/
  span : ∀ j, j < k → ∀ z ∈ M (j + 1), ∃ x ∈ M j, ∃ y ∈ M j, z = x + y * ρ j

namespace QuadraticTower

variable {k : ℕ} (C : QuadraticTower L k)

/-- The radicands of the tower. -/
def d (j : ℕ) : L := C.ρ j * C.ρ j

theorem le_of_le {i j : ℕ} (hij : i ≤ j) : C.M i ≤ C.M j := by
  induction j with
  | zero =>
      have hi : i = 0 := Nat.le_zero.mp hij
      subst hi
      exact le_rfl
  | succ n ih =>
      rcases Nat.lt_or_ge i (n + 1) with h | h
      · exact le_trans (ih (by omega)) (C.mono n)
      · have hi : i = n + 1 := by omega
        subst hi
        exact le_rfl

theorem d_def (j : ℕ) : C.d j = C.ρ j * C.ρ j := rfl

theorem d_mem_bot {j : ℕ} (hj : j < k) : C.d j ∈ C.M 0 := C.sq_mem j hj

/-- **Square classes along the tower.**  If no nonempty sub-product of the radicands is a square
at the bottom, then an element of the bottom field that is a square at stage `j` becomes a square
at the bottom after a twist by a sub-product of the first `j` radicands. -/
theorem exists_twist_isSq (h2 : (2 : L) ≠ 0)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn (C.M 0) (∏ i ∈ T, C.d i)) :
    ∀ j, j ≤ k → ∀ c ∈ C.M 0, IsSqIn (C.M j) c →
      ∃ T ⊆ Finset.range j, IsSqIn (C.M 0) (c * ∏ i ∈ T, C.d i) := by
  intro j
  induction j with
  | zero =>
      intro _ c hc hsq
      exact ⟨∅, by simp, by simpa using hsq⟩
  | succ n ih =>
      intro hn c hc hsq
      have hnk : n < k := by omega
      have hnk' : n ≤ k := by omega
      have hnot : C.ρ n ∉ C.M n := by
        intro hmem
        have hdsq : IsSqIn (C.M n) (C.d n) := ⟨C.ρ n, hmem, rfl⟩
        obtain ⟨T, hT, hTsq⟩ := ih hnk' (C.d n) (C.d_mem_bot hnk) hdsq
        have hnT : n ∉ T := fun h => by
          have := Finset.mem_range.mp (hT h)
          omega
        refine hindep (insert n T) ?_ ⟨n, Finset.mem_insert_self _ _⟩ ?_
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hiT
          · exact Finset.mem_range.mpr hnk
          · have := Finset.mem_range.mp (hT hiT)
            exact Finset.mem_range.mpr (by omega)
        · rw [Finset.prod_insert hnT]
          exact hTsq
      obtain ⟨z, hz, hzz⟩ := hsq
      obtain ⟨x, hx, y, hy, hzeq⟩ := C.span n hnk z hz
      subst hzeq
      have hcMn : c ∈ C.M n := C.le_of_le (Nat.zero_le n) hc
      have hrrMn : C.ρ n * C.ρ n ∈ C.M n := C.le_of_le (Nat.zero_le n) (C.sq_mem n hnk)
      rcases isSq_or_isSq_mul_of_span h2 hrrMn hnot hcMn hx hy hzz with hcase | hcase
      · obtain ⟨T, hT, hTsq⟩ := ih hnk' c hc hcase
        refine ⟨T, ?_, hTsq⟩
        intro i hi
        have hi' := Finset.mem_range.mp (hT hi)
        exact Finset.mem_range.mpr (by omega)
      · have hdc : C.d n * c ∈ C.M 0 := (C.M 0).mul_mem (C.d_mem_bot hnk) hc
        obtain ⟨T, hT, hTsq⟩ := ih hnk' (C.d n * c) hdc hcase
        have hnT : n ∉ T := fun h => by
          have := Finset.mem_range.mp (hT h)
          omega
        refine ⟨insert n T, ?_, ?_⟩
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hiT
          · exact Finset.mem_range.mpr (by omega)
          · have := Finset.mem_range.mp (hT hiT)
            exact Finset.mem_range.mpr (by omega)
        · rw [Finset.prod_insert hnT]
          obtain ⟨w, hw, hweq⟩ := hTsq
          refine ⟨w, hw, ?_⟩
          rw [← hweq]
          ring

/-- **Independence makes every step of the tower strict.** -/
theorem notMem_of_independent (h2 : (2 : L) ≠ 0)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn (C.M 0) (∏ i ∈ T, C.d i))
    {j : ℕ} (hj : j < k) : C.ρ j ∉ C.M j := by
  intro hmem
  have hdsq : IsSqIn (C.M j) (C.d j) := ⟨C.ρ j, hmem, rfl⟩
  obtain ⟨T, hT, hTsq⟩ :=
    C.exists_twist_isSq h2 hindep j (by omega) (C.d j) (C.d_mem_bot hj) hdsq
  have hjT : j ∉ T := fun h => by
    have := Finset.mem_range.mp (hT h)
    omega
  refine hindep (insert j T) ?_ ⟨j, Finset.mem_insert_self _ _⟩ ?_
  · intro i hi
    rcases Finset.mem_insert.mp hi with rfl | hiT
    · exact Finset.mem_range.mpr hj
    · have := Finset.mem_range.mp (hT hiT)
      exact Finset.mem_range.mpr (by omega)
  · rw [Finset.prod_insert hjT]
    exact hTsq

end QuadraticTower

/-! ### The concrete tower generated by the roots -/

/-- The subfield generated by a base field and the first `j` roots. -/
noncomputable def radicalStage (F₀ : Subfield L) (ρ : ℕ → L) (j : ℕ) : Subfield L :=
  Subfield.closure ((F₀ : Set L) ∪ ρ '' (Set.Iio j))

theorem radicalStage_zero (F₀ : Subfield L) (ρ : ℕ → L) : radicalStage F₀ ρ 0 = F₀ := by
  rw [radicalStage]
  simp [Subfield.closure_eq]

theorem radicalStage_mono (F₀ : Subfield L) (ρ : ℕ → L) (j : ℕ) :
    radicalStage F₀ ρ j ≤ radicalStage F₀ ρ (j + 1) := by
  refine Subfield.closure_mono ?_
  refine Set.union_subset_union_right _ ?_
  exact Set.image_mono (fun i hi => lt_trans hi (Nat.lt_succ_self j))

theorem root_mem_radicalStage_succ (F₀ : Subfield L) (ρ : ℕ → L) (j : ℕ) :
    ρ j ∈ radicalStage F₀ ρ (j + 1) :=
  Subfield.subset_closure (Or.inr ⟨j, Nat.lt_succ_self j, rfl⟩)

theorem base_le_radicalStage (F₀ : Subfield L) (ρ : ℕ → L) (j : ℕ) :
    F₀ ≤ radicalStage F₀ ρ j := by
  intro x hx
  exact Subfield.subset_closure (Or.inl hx)

/-- **The generated tower is quadratic at every step**, given Kummer independence of the
radicands. -/
theorem span_radicalStage_of_independent
    (F₀ : Subfield L) (ρ : ℕ → L) (k : ℕ) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k → ρ j * ρ j ∈ F₀)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn F₀ (∏ i ∈ T, ρ i * ρ i)) :
    ∀ j, j ≤ k → ∀ i, i < j → ∀ z ∈ radicalStage F₀ ρ (i + 1),
      ∃ x ∈ radicalStage F₀ ρ i, ∃ y ∈ radicalStage F₀ ρ i, z = x + y * ρ i := by
  classical
  set M : ℕ → Subfield L := radicalStage F₀ ρ with hM
  have hM0 : M 0 = F₀ := radicalStage_zero F₀ ρ
  have hmono : ∀ j, M j ≤ M (j + 1) := radicalStage_mono F₀ ρ
  have hsq0 : ∀ j, j < k → ρ j * ρ j ∈ M 0 := by
    intro j hj
    rw [hM0]
    exact hsq j hj
  have hindep0 : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i) := by
    rw [hM0]
    exact hindep
  intro j
  induction j with
  | zero => intro _ i hi; omega
  | succ n ih =>
      intro hn i hi
      rcases Nat.lt_or_ge i n with hin | hin
      · exact ih (by omega) i hin
      · have hieq : i = n := by omega
        subst hieq
        have hik : i < k := by omega
        have hspanPrev : ∀ m, m < i → ∀ z ∈ M (m + 1),
            ∃ x ∈ M m, ∃ y ∈ M m, z = x + y * ρ m := ih (by omega)
        have hindepSucc : ∀ T : Finset ℕ, T ⊆ Finset.range (i + 1) → T.Nonempty →
            ¬ IsSqIn (M 0) (∏ i ∈ T, ρ i * ρ i) := by
          intro T hT hne
          refine hindep0 T (fun m hm => ?_) hne
          have := Finset.mem_range.mp (hT hm)
          exact Finset.mem_range.mpr (by omega)
        have hnot : ρ i ∉ M i :=
          notMem_of_partial M ρ h2 hmono i (fun m hm => hsq0 m (by omega))
            hspanPrev hindepSucc
        have hrr : ρ i * ρ i ∈ M i := base_le_radicalStage F₀ ρ i (hsq i hik)
        have hsub : M (i + 1) ≤ Subfield.closure ((M i : Set L) ∪ {ρ i}) := by
          refine Subfield.closure_le.mpr ?_
          rintro w (hw | ⟨m, hm, rfl⟩)
          · exact Subfield.subset_closure (Or.inl (base_le_radicalStage F₀ ρ i hw))
          · have hmlt : m < i + 1 := Set.mem_Iio.mp hm
            rcases Nat.lt_or_ge m i with hmi | hmi
            · refine Subfield.subset_closure (Or.inl ?_)
              exact Subfield.subset_closure (Or.inr ⟨m, Set.mem_Iio.mpr hmi, rfl⟩)
            · have hmi' : m = i := by omega
              subst hmi'
              exact Subfield.subset_closure (Or.inr rfl)
        intro z hz
        exact mem_closure_insert_iff hrr hnot z (hsub hz)

/-- Each stage is contained in the field generated by the previous stage and the new root. -/
theorem radicalStage_succ_le_closure (F₀ : Subfield L) (ρ : ℕ → L) (i : ℕ) :
    radicalStage F₀ ρ (i + 1) ≤ Subfield.closure ((radicalStage F₀ ρ i : Set L) ∪ {ρ i}) := by
  refine Subfield.closure_le.mpr ?_
  rintro w (hw | ⟨m, hm, rfl⟩)
  · exact Subfield.subset_closure (Or.inl (base_le_radicalStage F₀ ρ i hw))
  · have hmlt : m < i + 1 := Set.mem_Iio.mp hm
    rcases Nat.lt_or_ge m i with hmi | hmi
    · refine Subfield.subset_closure (Or.inl ?_)
      exact Subfield.subset_closure (Or.inr ⟨m, Set.mem_Iio.mpr hmi, rfl⟩)
    · have hmi' : m = i := by omega
      subst hmi'
      exact Subfield.subset_closure (Or.inr rfl)

theorem root_mem_radicalStage {F₀ : Subfield L} {ρ : ℕ → L} {j i : ℕ} (hj : j < i) :
    ρ j ∈ radicalStage F₀ ρ i :=
  Subfield.subset_closure (Or.inr ⟨j, Set.mem_Iio.mpr hj, rfl⟩)

/-- **The tower attached to an independent family of radicands.** -/
noncomputable def independentTower
    (F₀ : Subfield L) (ρ : ℕ → L) (k : ℕ) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k → ρ j * ρ j ∈ F₀)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn F₀ (∏ i ∈ T, ρ i * ρ i)) : QuadraticTower L k where
  M := radicalStage F₀ ρ
  ρ := ρ
  mono := radicalStage_mono F₀ ρ
  sq_mem := by
    intro j hj
    rw [radicalStage_zero]
    exact hsq j hj
  root_mem := fun j _ => root_mem_radicalStage_succ F₀ ρ j
  span := fun j hj => span_radicalStage_of_independent F₀ ρ k h2 hsq hindep k le_rfl j hj

@[simp] theorem independentTower_bot
    (F₀ : Subfield L) (ρ : ℕ → L) (k : ℕ) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k → ρ j * ρ j ∈ F₀)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range k → T.Nonempty →
      ¬ IsSqIn F₀ (∏ i ∈ T, ρ i * ρ i)) :
    (independentTower F₀ ρ k h2 hsq hindep).M 0 = F₀ :=
  radicalStage_zero F₀ ρ

/-! ### Conjugation of a quadratic step

The unique coordinates of the previous section make `x + y r ↦ x − y r` a well-defined ring
automorphism of `K(r)` fixing `K` pointwise and negating `r`.  This is the automorphism that
realizes one transposition of a product of quadratics.
-/

/-- The coordinates of an element of `K(r)` in the basis `{1, r}` are unique. -/
theorem existsUnique_coords {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K)
    {z : L} (hz : z ∈ Subfield.closure ((K : Set L) ∪ {r})) :
    ∃! p : L × L, p.1 ∈ K ∧ p.2 ∈ K ∧ z = p.1 + p.2 * r := by
  obtain ⟨x, hx, y, hy, hzeq⟩ := mem_closure_insert_iff hrr hrK z hz
  refine ⟨(x, y), ⟨hx, hy, hzeq⟩, ?_⟩
  rintro ⟨x', y'⟩ ⟨hx', hy', hz'⟩
  obtain ⟨h1, h2⟩ := span_unique hrK hx' hy' hx hy (by rw [← hz', ← hzeq])
  simp only [Prod.mk.injEq]
  exact ⟨h1, h2⟩

/-- The conjugation `x + y r ↦ x − y r` on `K(r)`, as a function on `L`. -/
noncomputable def quadConj (K : Subfield L) (r : L) (z : L) : L := by
  classical
  exact if h : ∃ p : L × L, p.1 ∈ K ∧ p.2 ∈ K ∧ z = p.1 + p.2 * r then
    (Classical.choose h).1 - (Classical.choose h).2 * r
  else z

theorem quadConj_eq {K : Subfield L} {r : L} (hrK : r ∉ K)
    {x y : L} (hx : x ∈ K) (hy : y ∈ K) :
    quadConj K r (x + y * r) = x - y * r := by
  classical
  have hex : ∃ p : L × L, p.1 ∈ K ∧ p.2 ∈ K ∧ x + y * r = p.1 + p.2 * r := ⟨(x, y), hx, hy, rfl⟩
  rw [quadConj, dif_pos hex]
  obtain ⟨hx', hy', heq⟩ := Classical.choose_spec hex
  obtain ⟨h1, h2⟩ := span_unique hrK hx' hy' hx hy heq.symm
  rw [h1, h2]

theorem quadConj_base {K : Subfield L} {r : L} (hrK : r ∉ K) {x : L} (hx : x ∈ K) :
    quadConj K r x = x := by
  have h := quadConj_eq hrK hx K.zero_mem
  simpa using h

theorem quadConj_root {K : Subfield L} {r : L} (hrK : r ∉ K) :
    quadConj K r r = -r := by
  have h := quadConj_eq hrK K.zero_mem K.one_mem
  simpa using h

theorem quadConj_add {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K)
    {z w : L} (hz : z ∈ Subfield.closure ((K : Set L) ∪ {r}))
    (hw : w ∈ Subfield.closure ((K : Set L) ∪ {r})) :
    quadConj K r (z + w) = quadConj K r z + quadConj K r w := by
  obtain ⟨x, hx, y, hy, rfl⟩ := mem_closure_insert_iff hrr hrK z hz
  obtain ⟨x', hx', y', hy', rfl⟩ := mem_closure_insert_iff hrr hrK w hw
  have hsum : x + y * r + (x' + y' * r) = (x + x') + (y + y') * r := by ring
  rw [hsum, quadConj_eq hrK (K.add_mem hx hx') (K.add_mem hy hy'),
    quadConj_eq hrK hx hy, quadConj_eq hrK hx' hy']
  ring

theorem quadConj_mul {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K)
    {z w : L} (hz : z ∈ Subfield.closure ((K : Set L) ∪ {r}))
    (hw : w ∈ Subfield.closure ((K : Set L) ∪ {r})) :
    quadConj K r (z * w) = quadConj K r z * quadConj K r w := by
  obtain ⟨x, hx, y, hy, rfl⟩ := mem_closure_insert_iff hrr hrK z hz
  obtain ⟨x', hx', y', hy', rfl⟩ := mem_closure_insert_iff hrr hrK w hw
  have hprod : (x + y * r) * (x' + y' * r)
      = (x * x' + y * y' * (r * r)) + (x * y' + y * x') * r := by ring
  rw [hprod, quadConj_eq hrK (K.add_mem (K.mul_mem hx hx') (K.mul_mem (K.mul_mem hy hy') hrr))
      (K.add_mem (K.mul_mem hx hy') (K.mul_mem hy hx')),
    quadConj_eq hrK hx hy, quadConj_eq hrK hx' hy']
  ring

theorem quadConj_involutive {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K)
    {z : L} (hz : z ∈ Subfield.closure ((K : Set L) ∪ {r})) :
    quadConj K r (quadConj K r z) = z := by
  obtain ⟨x, hx, y, hy, rfl⟩ := mem_closure_insert_iff hrr hrK z hz
  rw [quadConj_eq hrK hx hy]
  have hneg : x - y * r = x + (-y) * r := by ring
  rw [hneg, quadConj_eq hrK hx (K.neg_mem hy)]
  ring

theorem quadConj_mem {K : Subfield L} {r : L} (hrr : r * r ∈ K) (hrK : r ∉ K)
    {z : L} (hz : z ∈ Subfield.closure ((K : Set L) ∪ {r})) :
    quadConj K r z ∈ Subfield.closure ((K : Set L) ∪ {r}) := by
  obtain ⟨x, hx, y, hy, rfl⟩ := mem_closure_insert_iff hrr hrK z hz
  rw [quadConj_eq hrK hx hy]
  have hxmem : x ∈ Subfield.closure ((K : Set L) ∪ {r}) := Subfield.subset_closure (Or.inl hx)
  have hymem : y ∈ Subfield.closure ((K : Set L) ∪ {r}) := Subfield.subset_closure (Or.inl hy)
  have hrmem : r ∈ Subfield.closure ((K : Set L) ∪ {r}) := Subfield.subset_closure (Or.inr rfl)
  exact Subfield.sub_mem _ hxmem (Subfield.mul_mem _ hymem hrmem)

/-! ### Conjugation as a field automorphism

When the quadratic step exhausts `L`, conjugation is a ring automorphism of `L`, and an algebra
automorphism over any base contained in `K`.  This is the shape `Polynomial.Gal.restrict`
consumes.
-/

section Top

variable {K : Subfield L} {r : L}

theorem mem_of_closure_eq_top (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤) (z : L) :
    z ∈ Subfield.closure ((K : Set L) ∪ {r}) := by
  rw [htop]
  exact Subfield.mem_top z

/-- Conjugation of the top quadratic step, as a ring automorphism of `L`. -/
noncomputable def quadConjEquiv (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤) : L ≃+* L where
  toFun := quadConj K r
  invFun := quadConj K r
  left_inv := fun z => quadConj_involutive hrr hrK (mem_of_closure_eq_top htop z)
  right_inv := fun z => quadConj_involutive hrr hrK (mem_of_closure_eq_top htop z)
  map_mul' := fun z w =>
    quadConj_mul hrr hrK (mem_of_closure_eq_top htop z) (mem_of_closure_eq_top htop w)
  map_add' := fun z w =>
    quadConj_add hrr hrK (mem_of_closure_eq_top htop z) (mem_of_closure_eq_top htop w)

@[simp] theorem quadConjEquiv_apply (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤) (z : L) :
    quadConjEquiv hrr hrK htop z = quadConj K r z := rfl

theorem quadConjEquiv_base (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤) {x : L} (hx : x ∈ K) :
    quadConjEquiv hrr hrK htop x = x := quadConj_base hrK hx

theorem quadConjEquiv_root (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤) :
    quadConjEquiv hrr hrK htop r = -r := quadConj_root hrK

/-- Conjugation of the top quadratic step, as an algebra automorphism over any base field whose
image lies in `K`. -/
noncomputable def quadConjAlgEquiv {F : Type*} [Field F] [Algebra F L]
    (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤)
    (hbase : ∀ x : F, algebraMap F L x ∈ K) : L ≃ₐ[F] L :=
  AlgEquiv.ofRingEquiv (f := quadConjEquiv hrr hrK htop)
    (fun x => quadConj_base hrK (hbase x))

@[simp] theorem quadConjAlgEquiv_apply {F : Type*} [Field F] [Algebra F L]
    (hrr : r * r ∈ K) (hrK : r ∉ K)
    (htop : Subfield.closure ((K : Set L) ∪ {r}) = ⊤)
    (hbase : ∀ x : F, algebraMap F L x ∈ K) (z : L) :
    quadConjAlgEquiv (F := F) hrr hrK htop hbase z = quadConj K r z := rfl

/-! ### Conjugation swaps the two roots of the adjoined quadratic -/

theorem two_mem (K' : Subfield L) : (2 : L) ∈ K' := by
  have h1 := K'.one_mem
  have hsum := K'.add_mem h1 h1
  rwa [show (1 : L) + 1 = 2 by norm_num] at hsum

/-- The two roots of `X² − sX + p` with discriminant `r * r` are `(s ± r)/2`, and conjugation by
`r` exchanges them. -/
theorem quadConj_rootPlus (hrK : r ∉ K) (h2 : (2 : L) ≠ 0) {s : L} (hs : s ∈ K) :
    quadConj K r ((s + r) / 2) = (s - r) / 2 := by
  have hsplit : (s + r) / 2 = s / 2 + (1 / 2) * r := by
    field_simp
  have hs2 : s / 2 ∈ K := K.div_mem hs (two_mem K)
  have h12 : (1 : L) / 2 ∈ K := K.div_mem K.one_mem (two_mem K)
  rw [hsplit, quadConj_eq hrK hs2 h12]
  field_simp

theorem quadConj_rootMinus (hrK : r ∉ K) (h2 : (2 : L) ≠ 0) {s : L} (hs : s ∈ K) :
    quadConj K r ((s - r) / 2) = (s + r) / 2 := by
  have hsplit : (s - r) / 2 = s / 2 + (-(1 / 2)) * r := by
    field_simp
    ring
  have hs2 : s / 2 ∈ K := K.div_mem hs (two_mem K)
  have h12 : -((1 : L) / 2) ∈ K := K.neg_mem (K.div_mem K.one_mem (two_mem K))
  rw [hsplit, quadConj_eq hrK hs2 h12]
  field_simp
  ring

/-- The two roots are genuinely distinct, since `r ≠ 0` when `r ∉ K`. -/
theorem rootPlus_ne_rootMinus (hrK : r ∉ K) (h2 : (2 : L) ≠ 0) (s : L) :
    (s + r) / 2 ≠ (s - r) / 2 := by
  intro heq
  have hmul : s + r = s - r := by
    have hc : ((s + r) / 2) * 2 = ((s - r) / 2) * 2 := by rw [heq]
    rwa [div_mul_cancel₀ _ h2, div_mul_cancel₀ _ h2] at hc
  have h2r : (2 : L) * r = 0 := by linear_combination hmul
  have hr0 : r = 0 := (mul_eq_zero.mp h2r).resolve_left h2
  exact hrK (hr0 ▸ K.zero_mem)

end Top

/-- **The conjugation attached to the last radicand.**  If the tower generated by `ρ₀, …, ρ_k`
exhausts `L` and the radicands are Kummer independent over `F₀`, then `L` has a ring automorphism
fixing `F₀` and every earlier root, and negating `ρ_k`. -/
theorem exists_ringEquiv_neg_top
    (F₀ : Subfield L) (ρ : ℕ → L) (k : ℕ) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k + 1 → ρ j * ρ j ∈ F₀)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range (k + 1) → T.Nonempty →
      ¬ IsSqIn F₀ (∏ i ∈ T, ρ i * ρ i))
    (htop : radicalStage F₀ ρ (k + 1) = ⊤) :
    ∃ σ : L ≃+* L, (∀ x ∈ F₀, σ x = x) ∧ (∀ j, j < k → σ (ρ j) = ρ j) ∧
      σ (ρ k) = -ρ k := by
  classical
  set K : Subfield L := radicalStage F₀ ρ k with hK
  have hrr : ρ k * ρ k ∈ K := base_le_radicalStage F₀ ρ k (hsq k (by omega))
  have hspan := span_radicalStage_of_independent F₀ ρ (k + 1) h2 hsq hindep k (by omega)
  have hrK : ρ k ∉ K :=
    notMem_of_partial (radicalStage F₀ ρ) ρ h2 (radicalStage_mono F₀ ρ) k
      (fun m hm => by
        rw [radicalStage_zero]
        exact hsq m (by omega))
      hspan
      (by
        intro T hT hne
        rw [radicalStage_zero]
        exact hindep T hT hne)
  have htop' : Subfield.closure ((K : Set L) ∪ {ρ k}) = ⊤ := by
    refine top_le_iff.mp ?_
    rw [← htop]
    exact radicalStage_succ_le_closure F₀ ρ k
  refine ⟨quadConjEquiv hrr hrK htop', ?_, ?_, ?_⟩
  · intro x hx
    exact quadConjEquiv_base hrr hrK htop' (base_le_radicalStage F₀ ρ k hx)
  · intro j hj
    exact quadConjEquiv_base hrr hrK htop' (root_mem_radicalStage hj)
  · exact quadConjEquiv_root hrr hrK htop'


/-! ### Algebra form over a base field -/

section BaseField

variable {F : Type*} [Field F] [Algebra F L]

/-- The base subfield attached to an algebra structure. -/
abbrev baseRange (F L : Type*) [Field F] [Field L] [Algebra F L] : Subfield L :=
  (algebraMap F L).fieldRange

/-- **The conjugation attached to the last radicand, over a base field.** -/
theorem exists_algEquiv_neg_top (ρ : ℕ → L) (k : ℕ) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k + 1 → ρ j * ρ j ∈ baseRange F L)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range (k + 1) → T.Nonempty →
      ¬ IsSqIn (baseRange F L) (∏ i ∈ T, ρ i * ρ i))
    (htop : radicalStage (baseRange F L) ρ (k + 1) = ⊤) :
    ∃ σ : L ≃ₐ[F] L, (∀ j, j < k → σ (ρ j) = ρ j) ∧ σ (ρ k) = -ρ k := by
  obtain ⟨σ, hbase, hfix, hneg⟩ :=
    exists_ringEquiv_neg_top (baseRange F L) ρ k h2 hsq hindep htop
  refine ⟨AlgEquiv.ofRingEquiv (f := σ) ?_, hfix, hneg⟩
  intro x
  exact hbase _ (RingHom.mem_fieldRange_self (algebraMap F L) x)

/-- The stage subfields only depend on the *image* of the root family. -/
theorem radicalStage_congr (F₀ : Subfield L) (ρ ρ' : ℕ → L) (j : ℕ)
    (h : ρ '' (Set.Iio j) = ρ' '' (Set.Iio j)) :
    radicalStage F₀ ρ j = radicalStage F₀ ρ' j := by
  rw [radicalStage, radicalStage, h]

/-- **Every block flip is realized**: for any index `j₀ ≤ k`, an algebra automorphism of `L`
negating `ρ j₀` and fixing every other `ρ j`, `j ≤ k`. -/
theorem exists_algEquiv_neg_index (ρ : ℕ → L) (k j₀ : ℕ) (hj₀ : j₀ ≤ k) (h2 : (2 : L) ≠ 0)
    (hsq : ∀ j, j < k + 1 → ρ j * ρ j ∈ baseRange F L)
    (hindep : ∀ T : Finset ℕ, T ⊆ Finset.range (k + 1) → T.Nonempty →
      ¬ IsSqIn (baseRange F L) (∏ i ∈ T, ρ i * ρ i))
    (htop : radicalStage (baseRange F L) ρ (k + 1) = ⊤) :
    ∃ σ : L ≃ₐ[F] L,
      (∀ j, j < k + 1 → j ≠ j₀ → σ (ρ j) = ρ j) ∧ σ (ρ j₀) = -ρ j₀ := by
  classical
  set e : Equiv.Perm ℕ := Equiv.swap j₀ k with he
  set ρ' : ℕ → L := ρ ∘ e with hρ'
  have hmapsTo : ∀ j, j < k + 1 → e j < k + 1 := by
    intro j hj
    rcases eq_or_ne j j₀ with rfl | h1
    · simp only [he, Equiv.swap_apply_left]
      omega
    · rcases eq_or_ne j k with rfl | h2'
      · have : e j = j₀ := by simp [he, Equiv.swap_apply_right]
        rw [this]
        omega
      · have : e j = j := by simp [he, Equiv.swap_apply_of_ne_of_ne h1 h2']
        rw [this]
        exact hj
  have himage : ρ' '' (Set.Iio (k + 1)) = ρ '' (Set.Iio (k + 1)) := by
    apply Set.Subset.antisymm
    · rintro _ ⟨j, hj, rfl⟩
      exact ⟨e j, Set.mem_Iio.mpr (hmapsTo j (Set.mem_Iio.mp hj)), rfl⟩
    · rintro _ ⟨j, hj, rfl⟩
      refine ⟨e.symm j, Set.mem_Iio.mpr ?_, ?_⟩
      · have : e.symm = e := by simp [he, Equiv.symm_swap]
        rw [this]
        exact hmapsTo j (Set.mem_Iio.mp hj)
      · simp [hρ']
  have hsq' : ∀ j, j < k + 1 → ρ' j * ρ' j ∈ baseRange F L := by
    intro j hj
    exact hsq (e j) (hmapsTo j hj)
  have hindep' : ∀ T : Finset ℕ, T ⊆ Finset.range (k + 1) → T.Nonempty →
      ¬ IsSqIn (baseRange F L) (∏ i ∈ T, ρ' i * ρ' i) := by
    intro T hT hne
    have hprod : (∏ i ∈ T, ρ' i * ρ' i) = ∏ i ∈ T.image e, ρ i * ρ i := by
      rw [Finset.prod_image (fun a _ b _ hab => e.injective hab)]
      rfl
    rw [hprod]
    refine hindep (T.image e) ?_ (hne.image e)
    intro i hi
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hi
    exact Finset.mem_range.mpr (hmapsTo j (Finset.mem_range.mp (hT hj)))
  have htop' : radicalStage (baseRange F L) ρ' (k + 1) = ⊤ := by
    rw [radicalStage_congr _ ρ' ρ (k + 1) himage]
    exact htop
  obtain ⟨σ, hfix, hneg⟩ := exists_algEquiv_neg_top (F := F) ρ' k h2 hsq' hindep' htop'
  have hρ'k : ρ' k = ρ j₀ := by simp [hρ', he, Equiv.swap_apply_right]
  refine ⟨σ, ?_, by rw [← hρ'k]; exact hneg⟩
  intro j hj hjne
  rcases eq_or_ne j k with rfl | hjk
  · have hj₀k : j₀ ≠ j := fun h => hjne h.symm
    have hlt : j₀ < j := by omega
    have : ρ' j₀ = ρ j := by simp [hρ', he, Equiv.swap_apply_left]
    rw [← this]
    exact hfix j₀ hlt
  · have hjj : ρ' j = ρ j := by
      simp [hρ', he, Equiv.swap_apply_of_ne_of_ne hjne hjk]
    rw [← hjj]
    exact hfix j (by omega)

end BaseField

/-! ### The quadratic and its two roots as a polynomial identity -/

section QuadraticPolynomial

open Polynomial

/-- A monic quadratic with a square root of its discriminant factors into the two linear factors
`X − (s ± r)/2`. -/
theorem quadratic_eq_prod_linear (h2 : (2 : L) ≠ 0) (s p r : L)
    (hr : r * r = s * s - 4 * p) :
    (X ^ (2 : ℕ) - C s * X + C p : L[X]) = (X - C ((s + r) / 2)) * (X - C ((s - r) / 2)) := by
  have hsum : ((s + r) / 2) + ((s - r) / 2) = s := by
    field_simp
    ring
  have hprod : ((s + r) / 2) * ((s - r) / 2) = p := by
    field_simp
    linear_combination -hr
  have hexpand : (X - C ((s + r) / 2)) * (X - C ((s - r) / 2))
      = X ^ (2 : ℕ) - C (((s + r) / 2) + ((s - r) / 2)) * X + C (((s + r) / 2) * ((s - r) / 2)) := by
    rw [map_add, map_mul]
    ring
  rw [hexpand, hsum, hprod]

/-- The two roots are distinct exactly when the discriminant is nonzero. -/
theorem quadratic_roots_ne (h2 : (2 : L) ≠ 0) {s r : L} (hr : r ≠ 0) :
    (s + r) / 2 ≠ (s - r) / 2 := by
  intro heq
  have hc : ((s + r) / 2) * 2 = ((s - r) / 2) * 2 := by rw [heq]
  rw [div_mul_cancel₀ _ h2, div_mul_cancel₀ _ h2] at hc
  have h2r : (2 : L) * r = 0 := by linear_combination hc
  exact hr ((mul_eq_zero.mp h2r).resolve_left h2)

end QuadraticPolynomial

