import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.Polynomial.Coeff
import Mathlib.Algebra.Polynomial.BigOperators
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.LinearAlgebra.Matrix.Block

/-!
# The triangular coefficient law of a jet tail

For the tail `R(t) = p₁ + p₂ t + ⋯ + pₙ t^{n-1}` of a jet, the coefficient of `t^j` in `R^m` is
linear in `p_{j+1}` with coefficient `m p₁^{m-1}`, and its remaining part involves only
`p₁, …, p_j`.  So the change of parameters `p ↦ (coefficients of the powers)` is triangular with
invertible diagonal.

The constant term is `p₁^m`, which is the first coordinate of that change.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

universe u

variable {K : Type u} [CommRing K]

/-- The tail of a jet, with indeterminate coefficients. -/
noncomputable def triangularTailPoly (K : Type u) [CommRing K] (n : ℕ) : (MvPolynomial ℕ K)[X] :=
  ∑ i ∈ Finset.range n, C (MvPolynomial.X i) * X ^ i

theorem coeff_triangularTailPoly (n i : ℕ) :
    (triangularTailPoly K n).coeff i = if i < n then MvPolynomial.X i else 0 := by
  classical
  rw [triangularTailPoly, finsetSum_coeff]
  by_cases h : i < n
  · rw [if_pos h, Finset.sum_eq_single i]
    · rw [coeff_C_mul, coeff_X_pow, if_pos rfl, mul_one]
    · intro b _ hb
      rw [coeff_C_mul, coeff_X_pow, if_neg (fun hc => hb hc.symm), mul_zero]
    · intro hi
      exact absurd (Finset.mem_range.2 h) hi
  · rw [if_neg h]
    refine Finset.sum_eq_zero (fun b hb => ?_)
    have hbn : b < n := Finset.mem_range.1 hb
    rw [coeff_C_mul, coeff_X_pow, if_neg (fun hc => h (lt_of_eq_of_lt hc hbn)), mul_zero]

/-- The subalgebra generated by the first `k` coefficients. -/
noncomputable def tailAdjoin (K : Type u) [CommRing K] (k : ℕ) : Subalgebra K (MvPolynomial ℕ K) :=
  Algebra.adjoin K (MvPolynomial.X '' {i : ℕ | i < k})

theorem X_mem_tailAdjoin {i k : ℕ} (h : i < k) : MvPolynomial.X i ∈ tailAdjoin K k :=
  Algebra.subset_adjoin ⟨i, h, rfl⟩

theorem tailAdjoin_mono {k l : ℕ} (h : k ≤ l) : tailAdjoin K k ≤ tailAdjoin K l :=
  Algebra.adjoin_mono (Set.image_mono (fun _ hi => lt_of_lt_of_le hi h))

/-- **The convolution recursion for the coefficients of the powers of the tail.**  This is the
engine of every induction on the power, and the bridge between the tail's powers and the recursion
defining the numerators of the truncated inverse. -/
theorem coeff_triangularTailPoly_pow_succ (n m j : ℕ) :
    ((triangularTailPoly K n) ^ (m + 1)).coeff j
      = ∑ p ∈ Finset.antidiagonal j,
          (if p.1 < n then MvPolynomial.X p.1 else 0)
            * ((triangularTailPoly K n) ^ m).coeff p.2 := by
  classical
  rw [pow_succ, mul_comm, coeff_mul]
  exact Finset.sum_congr rfl (fun p _ => by rw [coeff_triangularTailPoly])

/-- **The coefficient of `t^b` in `R^m` involves only the first `b + 1` parameters.** -/
theorem coeff_triangularTailPoly_pow_mem (n : ℕ) : ∀ (m b : ℕ),
    ((triangularTailPoly K n) ^ m).coeff b ∈ tailAdjoin K (b + 1) := by
  intro m
  induction m with
  | zero =>
      intro b
      rw [pow_zero, coeff_one]
      by_cases h : b = 0
      · rw [if_pos h]
        exact one_mem _
      · rw [if_neg h]
        exact zero_mem _
  | succ m ih =>
      intro b
      rw [pow_succ, mul_comm, coeff_mul]
      refine Subalgebra.sum_mem _ (fun p hp => ?_)
      rw [Finset.mem_antidiagonal] at hp
      refine Subalgebra.mul_mem _ ?_ ?_
      · rw [coeff_triangularTailPoly]
        by_cases h : p.1 < n
        · rw [if_pos h]
          exact X_mem_tailAdjoin (by omega)
        · rw [if_neg h]
          exact zero_mem _
      · exact tailAdjoin_mono (by omega) (ih p.2)

/-- **The constant term of `R^m` is `p₁^m`.** -/
theorem coeff_zero_triangularTailPoly_pow {n : ℕ} (hn : 0 < n) (m : ℕ) :
    ((triangularTailPoly K n) ^ m).coeff 0 = (MvPolynomial.X 0) ^ m := by
  induction m with
  | zero => rw [pow_zero, pow_zero, coeff_one_zero]
  | succ m ih =>
      rw [pow_succ, mul_comm, Polynomial.mul_coeff_zero, coeff_triangularTailPoly, if_pos hn, ih,
        pow_succ, mul_comm]

/-- **A later parameter does not occur in the earlier ones.** -/
theorem pderiv_eq_zero_of_mem_tailAdjoin {j k : ℕ} (h : k ≤ j) {f : MvPolynomial ℕ K}
    (hf : f ∈ tailAdjoin K k) : MvPolynomial.pderiv j f = 0 := by
  refine Algebra.adjoin_induction (p := fun g _ => MvPolynomial.pderiv j g = 0) ?_ ?_ ?_ ?_ hf
  · rintro _ ⟨i, hi, rfl⟩
    have hik : i < k := hi
    exact MvPolynomial.pderiv_X_of_ne (by omega)
  · intro r
    exact (MvPolynomial.pderiv j).map_algebraMap r
  · intro f g _ _ hfz hgz
    rw [map_add, hfz, hgz, add_zero]
  · intro f g _ _ hfz hgz
    rw [Derivation.leibniz, hfz, hgz, smul_zero, smul_zero, add_zero]

/-- **The diagonal of the triangular coefficient law.**  The coefficient of `t^j` in `R^m` is linear
in `p_{j+1}` with coefficient `m p₁^{m-1}`: differentiating in `p_{j+1}` kills every other term.

The only term involving `p_{j+1}` chooses `p_{j+1} t^j` once and the constant term `p₁` in each of
the remaining `m - 1` factors, and there are `m` ways to choose which factor. -/
theorem pderiv_coeff_triangularTailPoly_pow {n j : ℕ} (hj : 0 < j) (hjn : j < n) (m : ℕ) :
    MvPolynomial.pderiv j (((triangularTailPoly K n) ^ (m + 1)).coeff j)
      = (m + 1 : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ m := by
  induction m with
  | zero =>
      rw [pow_one, coeff_triangularTailPoly, if_pos hjn, MvPolynomial.pderiv_X_self, pow_zero]
      simp
  | succ m ih =>
      rw [pow_succ, mul_comm, coeff_mul, map_sum]
      have hterm : ∀ p ∈ Finset.antidiagonal j,
          MvPolynomial.pderiv j
              ((triangularTailPoly K n).coeff p.1 * ((triangularTailPoly K n) ^ (m + 1)).coeff p.2)
            = (if p.1 = j then (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (m + 1) else 0)
              + (if p.2 = j then
                  (m + 1 : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (m + 1) else 0) := by
        intro p hp
        rw [Finset.mem_antidiagonal] at hp
        have hp1n : p.1 < n := by omega
        rw [coeff_triangularTailPoly, if_pos hp1n, Derivation.leibniz]
        by_cases h1 : p.1 = j
        · have hp2 : p.2 = 0 := by omega
          rw [if_pos h1, if_neg (by omega : ¬ p.2 = j), add_zero,
            pderiv_eq_zero_of_mem_tailAdjoin (by omega)
              (coeff_triangularTailPoly_pow_mem (K := K) n (m + 1) p.2), smul_zero, zero_add, hp2,
            coeff_zero_triangularTailPoly_pow (by omega), h1, MvPolynomial.pderiv_X_self, smul_eq_mul,
            mul_one]
        · rw [if_neg h1, zero_add,
            MvPolynomial.pderiv_X_of_ne (by omega : p.1 ≠ j), smul_zero, add_zero]
          by_cases h2 : p.2 = j
          · have hp1 : p.1 = 0 := by omega
            rw [if_pos h2, hp1, h2, ih, smul_comm, smul_eq_mul, ← pow_succ']
          · rw [if_neg h2, pderiv_eq_zero_of_mem_tailAdjoin (by omega)
              (coeff_triangularTailPoly_pow_mem (K := K) n (m + 1) p.2), smul_zero]
      rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib]
      rw [Finset.sum_eq_single ((j, 0) : ℕ × ℕ), Finset.sum_eq_single ((0, j) : ℕ × ℕ)]
      · rw [if_pos rfl, if_pos rfl, add_comm, ← succ_nsmul]
      · intro b hbm hb
        have hsum := Finset.mem_antidiagonal.1 hbm
        exact if_neg (fun hc => hb (Prod.ext (by omega) hc))
      · intro hb
        exact absurd (Finset.mem_antidiagonal.2 (by omega)) hb
      · intro b hbm hb
        have hsum := Finset.mem_antidiagonal.1 hbm
        exact if_neg (fun hc => hb (Prod.ext hc (by omega)))
      · intro hb
        exact absurd (Finset.mem_antidiagonal.2 (by omega)) hb

/-- The derivative of a power of a variable. -/
theorem pderiv_X_pow_self (i m : ℕ) :
    MvPolynomial.pderiv i ((MvPolynomial.X i : MvPolynomial ℕ K) ^ (m + 1))
      = (m + 1 : ℕ) • (MvPolynomial.X i : MvPolynomial ℕ K) ^ m := by
  induction m with
  | zero => simp
  | succ m ih =>
      rw [pow_succ, Derivation.leibniz, MvPolynomial.pderiv_X_self, ih, smul_eq_mul, mul_one,
        smul_comm, smul_eq_mul, ← pow_succ', add_comm, ← succ_nsmul]

/-- **A later variable does not occur in the subalgebra generated by the earlier ones.** -/
theorem degreeOf_eq_zero_of_mem_tailAdjoin [Nontrivial K] {j k : ℕ} (h : k ≤ j)
    {f : MvPolynomial ℕ K} (hf : f ∈ tailAdjoin K k) : MvPolynomial.degreeOf j f = 0 := by
  classical
  refine Algebra.adjoin_induction (p := fun g _ => MvPolynomial.degreeOf j g = 0) ?_ ?_ ?_ ?_ hf
  · rintro _ ⟨i, hi, rfl⟩
    have hik : i < k := hi
    rw [MvPolynomial.degreeOf_X, if_neg (by omega)]
  · intro r
    rw [MvPolynomial.algebraMap_eq, MvPolynomial.degreeOf_C]
  · intro f g _ _ hfd hgd
    exact Nat.le_zero.1 (le_trans (MvPolynomial.degreeOf_add_le j f g) (by omega))
  · intro f g _ _ hfd hgd
    exact Nat.le_zero.1 (le_trans (MvPolynomial.degreeOf_mul_le j f g) (by omega))

/-- **A coefficient below the diagonal does not involve the diagonal variable.** -/
theorem degreeOf_coeff_triangularTailPoly_pow_of_lt [Nontrivial K] {n j b : ℕ} (h : b < j) (m : ℕ) :
    MvPolynomial.degreeOf j (((triangularTailPoly K n) ^ m).coeff b) = 0 :=
  degreeOf_eq_zero_of_mem_tailAdjoin (by omega) (coeff_triangularTailPoly_pow_mem n m b)

/-- **The diagonal coefficient is linear in its variable.**  Two occurrences of `p_{j+1}` would need
two factors contributing `t^j` each, which overshoots `t^j`. -/
theorem degreeOf_coeff_triangularTailPoly_pow_self [Nontrivial K] {n j : ℕ} (hj : 0 < j) (hjn : j < n) :
    ∀ m : ℕ, MvPolynomial.degreeOf j (((triangularTailPoly K n) ^ m).coeff j) ≤ 1 := by
  intro m
  induction m with
  | zero =>
      rw [pow_zero, coeff_one, if_neg (by omega)]
      simp
  | succ m ih =>
      rw [pow_succ, mul_comm, coeff_mul]
      refine le_trans (MvPolynomial.degreeOf_sum_le _ _ _) (Finset.sup_le (fun p hp => ?_))
      rw [Finset.mem_antidiagonal] at hp
      refine le_trans (MvPolynomial.degreeOf_mul_le _ _ _) ?_
      by_cases h1 : p.1 = j
      · have hp2 : p.2 = 0 := by omega
        rw [coeff_triangularTailPoly, if_pos (by omega), MvPolynomial.degreeOf_X, if_pos h1.symm, hp2,
          degreeOf_coeff_triangularTailPoly_pow_of_lt (by omega)]
      · rw [coeff_triangularTailPoly, if_pos (by omega : p.1 < n), MvPolynomial.degreeOf_X,
          if_neg (fun hc => h1 hc.symm), zero_add]
        by_cases h2 : p.2 = j
        · rw [h2]
          exact ih
        · rw [degreeOf_coeff_triangularTailPoly_pow_of_lt (by omega)]
          omega

/-- **The coefficient in the explicit form of `(9)`.**  The `j`-th coefficient of `R^{m+1}` is
`(m+1) p₁^m p_{j+1}` plus a polynomial in the earlier parameters, with that remainder exhibited. -/
theorem coeff_triangularTailPoly_pow_decomp {n j : ℕ} (hj : 0 < j) (hjn : j < n) (m : ℕ) :
    ∃ H ∈ tailAdjoin K j, ((triangularTailPoly K n) ^ (m + 1)).coeff j
      = (m + 1 : ℕ) • ((MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ m * MvPolynomial.X j) + H := by
  induction m with
  | zero =>
      refine ⟨0, zero_mem _, ?_⟩
      rw [pow_one, coeff_triangularTailPoly, if_pos hjn]
      simp
  | succ m ih =>
      obtain ⟨H, hH, hHeq⟩ := ih
      have hmem0 : ((j, 0) : ℕ × ℕ) ∈ Finset.antidiagonal j := by simp
      have hmem1 : ((0, j) : ℕ × ℕ) ∈ (Finset.antidiagonal j).erase ((j, 0) : ℕ × ℕ) := by
        refine Finset.mem_erase.2 ⟨fun hc => ?_, by simp⟩
        exact absurd (congrArg Prod.fst hc) (by omega)
      refine ⟨(MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) * H
        + ∑ p ∈ ((Finset.antidiagonal j).erase ((j, 0) : ℕ × ℕ)).erase ((0, j) : ℕ × ℕ),
            (triangularTailPoly K n).coeff p.1 * ((triangularTailPoly K n) ^ (m + 1)).coeff p.2, ?_, ?_⟩
      · refine Subalgebra.add_mem _ (Subalgebra.mul_mem _ (X_mem_tailAdjoin (by omega)) hH) ?_
        refine Subalgebra.sum_mem _ (fun p hp => ?_)
        have hp2 := Finset.mem_erase.1 hp
        have hp1 := Finset.mem_erase.1 hp2.2
        have hsum : p.1 + p.2 = j := Finset.mem_antidiagonal.1 hp1.2
        have hne0 : p.1 ≠ 0 := by
          intro hc
          exact hp2.1 (Prod.ext hc (by omega))
        have hnej : p.1 ≠ j := by
          intro hc
          exact hp1.1 (Prod.ext hc (by omega))
        refine Subalgebra.mul_mem _ ?_ ?_
        · rw [coeff_triangularTailPoly, if_pos (by omega : p.1 < n)]
          exact X_mem_tailAdjoin (by omega)
        · exact tailAdjoin_mono (by omega) (coeff_triangularTailPoly_pow_mem n (m + 1) p.2)
      · rw [pow_succ, mul_comm, coeff_mul, ← Finset.add_sum_erase _ _ hmem0,
          ← Finset.add_sum_erase _ _ hmem1]
        rw [coeff_triangularTailPoly, if_pos hjn, coeff_zero_triangularTailPoly_pow (by omega),
          coeff_triangularTailPoly, if_pos (by omega : 0 < n), hHeq]
        simp only [nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
        ring

/-! ## The Jacobian of the parameter change -/

/-- The coefficients of the parameter change, up to the sign of `(6)`, which is a unit and affects
neither triangularity nor independence. -/
noncomputable def paramCoeff (K : Type u) [CommRing K] (n j : ℕ) : MvPolynomial ℕ K :=
  ((triangularTailPoly K n) ^ (n - j)).coeff j

/-- **Above the diagonal the Jacobian vanishes**: the `j`-th coefficient does not involve the later
parameters. -/
theorem pderiv_paramCoeff_of_lt {n i j : ℕ} (h : j < i) :
    MvPolynomial.pderiv i (paramCoeff K n j) = 0 :=
  pderiv_eq_zero_of_mem_tailAdjoin (by omega) (coeff_triangularTailPoly_pow_mem n (n - j) j)

/-- **On the diagonal it is `(n - j) p₁^{n-j-1}`.** -/
theorem pderiv_paramCoeff_self {n j : ℕ} (hjn : j < n) :
    MvPolynomial.pderiv j (paramCoeff K n j)
      = (n - j : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (n - j - 1) := by
  rcases Nat.eq_zero_or_pos j with rfl | hj
  · rw [paramCoeff, Nat.sub_zero, coeff_zero_triangularTailPoly_pow (by omega)]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [pderiv_X_pow_self]
    simp
  · have hm : n - j - 1 + 1 = n - j := by omega
    rw [paramCoeff, ← hm, pderiv_coeff_triangularTailPoly_pow hj hjn, hm]

/-- **The parameter change, in the form of `(9)`.**  Each coefficient is `(n-j) p₁^{n-j-1} p_{j+1}`
plus a polynomial in the strictly earlier parameters. -/
theorem paramCoeff_decomp {n j : ℕ} (hj : 0 < j) (hjn : j < n) :
    ∃ H ∈ tailAdjoin K j, paramCoeff K n j
      = (n - j : ℕ) • ((MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (n - j - 1)
          * MvPolynomial.X j) + H := by
  obtain ⟨H, hH, hHeq⟩ := coeff_triangularTailPoly_pow_decomp (K := K) hj hjn (n - j - 1)
  refine ⟨H, hH, ?_⟩
  rw [paramCoeff, show n - j = n - j - 1 + 1 by omega, hHeq, Nat.add_sub_cancel]

/-- **And at the first index it is `p₁^n`**, which is `(8)`. -/
theorem paramCoeff_zero {n : ℕ} (hn : 0 < n) :
    paramCoeff K n 0 = (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ n := by
  rw [paramCoeff, Nat.sub_zero, coeff_zero_triangularTailPoly_pow hn]

/-- **The Jacobian of the parameter change is triangular**, so its determinant is the product of the
diagonal entries `(n - j) p₁^{n-j-1}`.  In characteristic zero and on `p₁ ≠ 0` every factor is
nonzero, which is the étaleness the Kummer base change needs. -/
theorem det_paramJacobian (n : ℕ) :
    (Matrix.of (fun i j : Fin n => MvPolynomial.pderiv (i : ℕ) (paramCoeff K n (j : ℕ)))).det
      = ∏ j : Fin n, ((n - (j : ℕ) : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K)
          ^ (n - (j : ℕ) - 1)) := by
  have htri : (Matrix.of (fun i j : Fin n =>
      MvPolynomial.pderiv (i : ℕ) (paramCoeff K n (j : ℕ)))).BlockTriangular id := by
    intro i j hij
    exact pderiv_paramCoeff_of_lt (by exact_mod_cast hij)
  rw [Matrix.det_of_upperTriangular htri]
  exact Finset.prod_congr rfl (fun j _ => pderiv_paramCoeff_self j.2)

end GaloisForLFunctions.HTGeometry
