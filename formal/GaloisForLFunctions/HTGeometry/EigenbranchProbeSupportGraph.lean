import GaloisForLFunctions.HTGeometry.AllLayerEndpointPhysicalActivation
import GaloisForLFunctions.HTGeometry.AnchoredReplicaGraph
import GaloisForLFunctions.HTGeometry.LocalInteractionLiftAnalyticRelationLaw

/-!
# Physical eigenbranch probe-support graph

This module packages nonzero physical bra--ket amplitudes of a finite family
of strictly new-factor-local Hermitian probes into an undirected simple
graph.  Containing an anchored replica graph then certifies connectedness
and nonbipartiteness.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Filter Topology

/-- Undirected support graph generated by a family of operators on the new
local factor, evaluated between canonical eigenbranch vectors. -/
def newLayerEigenbranchProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix ρ ρ ℂ)
    (t : ℂ) :
    SimpleGraph (I × ρ) where
  Adj x y :=
    x ≠ y ∧
      ∃ p,
        affineEigenbranchSesquilinearMatrixProbe
            energy V (branch x) (branch y)
            (layerMatrixCoupling (1 : Matrix I I ℂ) (probe p))
            x y t ≠ 0 ∨
          affineEigenbranchSesquilinearMatrixProbe
            energy V (branch y) (branch x)
            (layerMatrixCoupling (1 : Matrix I I ℂ) (probe p))
            y x t ≠ 0
  symm := by
    constructor
    intro x y hxy
    exact ⟨hxy.1.symm, by
      rcases hxy.2 with ⟨p, hp | hp⟩
      · exact ⟨p, Or.inr hp⟩
      · exact ⟨p, Or.inl hp⟩⟩
  loopless := by
    constructor
    intro x hxx
    exact hxx.1 rfl

/-- Within-layer copies of `G` and selected cross-layer bridges force an
anchored replica graph into the physical probe-support graph. -/
theorem anchoredReplicaGraph_le_newLayerProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (G : SimpleGraph I) (anchor : ρ)
    (source target : ρ → I)
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix ρ ρ ℂ)
    (t : ℂ)
    (hwithin :
      ∀ ⦃a b⦄, G.Adj a b → ∀ r,
        ∃ p,
          affineEigenbranchSesquilinearMatrixProbe
            energy V (branch (a, r)) (branch (b, r))
            (layerMatrixCoupling (1 : Matrix I I ℂ) (probe p))
            (a, r) (b, r) t ≠ 0)
    (hbridge :
      ∀ r, r ≠ anchor →
        ∃ p,
          affineEigenbranchSesquilinearMatrixProbe
            energy V
            (branch (source r, r))
            (branch (target r, anchor))
            (layerMatrixCoupling (1 : Matrix I I ℂ) (probe p))
            (source r, r) (target r, anchor) t ≠ 0) :
    anchoredReplicaGraph G anchor source target ≤
      newLayerEigenbranchProbeSupportGraph
        energy V branch probe t := by
  intro x y hxy
  rcases hxy with hsame | ⟨r, hr, hcross⟩
  · have hne : x ≠ y := by
      intro h
      subst y
      exact hsame.2.ne rfl
    refine ⟨hne, ?_⟩
    obtain ⟨p, hp⟩ := hwithin hsame.2 x.2
    have hlayer : y.2 = x.2 := hsame.1.symm
    have hx : (x.1, x.2) = x := Prod.eta x
    have hy : (y.1, x.2) = y := by
      exact Prod.ext rfl hlayer.symm
    exact ⟨p, Or.inl (by simpa [hx, hy] using hp)⟩
  · rcases hcross with hcross | hcross
    · rcases hcross with ⟨rfl, rfl⟩
      refine ⟨fun h => hr (congrArg Prod.snd h), ?_⟩
      obtain ⟨p, hp⟩ := hbridge r hr
      exact ⟨p, Or.inl hp⟩
    · rcases hcross with ⟨rfl, rfl⟩
      refine ⟨fun h => hr (congrArg Prod.snd h.symm), ?_⟩
      obtain ⟨p, hp⟩ := hbridge r hr
      exact ⟨p, Or.inr hp⟩

/-- Physical probe-support graph is connected once it contains the
connected anchored replica skeleton. -/
theorem newLayerProbeSupportGraph_preconnected
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ] [Nonempty I]
    (G : SimpleGraph I) (hG : G.Preconnected)
    (anchor : ρ) (source target : ρ → I)
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix ρ ρ ℂ)
    (t : ℂ)
    (hle :
      anchoredReplicaGraph G anchor source target ≤
        newLayerEigenbranchProbeSupportGraph
          energy V branch probe t) :
    (newLayerEigenbranchProbeSupportGraph
      energy V branch probe t).Preconnected :=
  preconnected_of_anchoredReplicaGraph_le
    G hG anchor source target _ hle

/-- Physical probe-support graph remains nonbipartite once it contains one
nonbipartite anchor replica. -/
theorem newLayerProbeSupportGraph_not_isBipartite
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (G : SimpleGraph I) (hG : ¬ G.IsBipartite)
    (anchor : ρ) (source target : ρ → I)
    (energy : I × ρ → ℂ)
    (V : Matrix (I × ρ) (I × ρ) ℂ)
    (branch : I × ρ → ℂ → ℂ)
    (probe : η → Matrix ρ ρ ℂ)
    (t : ℂ)
    (hle :
      anchoredReplicaGraph G anchor source target ≤
        newLayerEigenbranchProbeSupportGraph
          energy V branch probe t) :
    ¬ (newLayerEigenbranchProbeSupportGraph
      energy V branch probe t).IsBipartite :=
  not_isBipartite_of_anchoredReplicaGraph_le
    G hG anchor source target _ hle

/-- Oriented labels of support-graph edges. -/
def TransitionSupportEdge
    {I : Type*} (transition : Matrix I I ℂ) :=
  {p : I × I // (transitionSupportGraph transition).Adj p.1 p.2}

/-- Nonanchor layer labels. -/
def NonanchorLayer
    {ρ : Type*} (anchor : ρ) :=
  {r : ρ // r ≠ anchor}

/-- **New-leaf all-observer graph law.** Assume the old transition matrix
has connected, nonbipartite support.  For any finite new local alphabet with
at least two labels, the real anchor-star interaction admits a finite family
of Hermitian probes acting only on the new factor such that, throughout one
common punctured real coupling interval, their physical eigenbranch support
graph is connected and nonbipartite.

Thus the newly attached leaf inherits the same graph-theoretic observability
needed for another attachment step. -/
theorem
    exists_eventually_newLayerProbeSupportGraph_good
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ] [Nonempty I]
    (energy : I × ρ → ℂ) (hinj : Function.Injective energy)
    (henergyReal :
      ∀ x, (starRingEnd ℂ) (energy x) = energy x)
    (transition : Matrix I I ℂ)
    (htransitionReal :
      ∀ x y,
        (starRingEnd ℂ) (transition x y) = transition x y)
    (anchor other : ρ) (hother : other ≠ anchor)
    (branch : I × ρ → ℂ → ℂ)
    (hbranchAnalytic : ∀ x, AnalyticAt ℂ (branch x) 0)
    (hbranchBase : ∀ x, branch x 0 = energy x)
    (hbranchRoot :
      ∀ x,
        ∀ᶠ t in 𝓝 0,
          matrixCharpolyRelation
            (Matrix.diagonal energy +
              t • layerMatrixCoupling transition
                (anchorStarLayerEdge anchor),
              branch x t) = 0)
    (hbranchReal :
      ∀ᶠ t : ℝ in 𝓝 0, ∀ x,
        (starRingEnd ℂ) (branch x t) = branch x t)
    (hconnected :
      (transitionSupportGraph transition).Preconnected)
    (hnonbipartite :
      ¬ (transitionSupportGraph transition).IsBipartite) :
    ∃ probe :
        Sum (TransitionSupportEdge transition × ρ)
          (NonanchorLayer anchor) → Matrix ρ ρ ℂ,
      (∀ p, (probe p).IsHermitian) ∧
      ∀ᶠ t : ℝ in 𝓝[≠] 0,
        (newLayerEigenbranchProbeSupportGraph
            energy
            (layerMatrixCoupling transition
              (anchorStarLayerEdge anchor))
            branch probe t).Preconnected ∧
          ¬ (newLayerEigenbranchProbeSupportGraph
            energy
            (layerMatrixCoupling transition
              (anchorStarLayerEdge anchor))
            branch probe t).IsBipartite := by
  classical
  letI : Fintype (TransitionSupportEdge transition) :=
    Fintype.ofInjective Subtype.val Subtype.val_injective
  letI : Fintype (NonanchorLayer anchor) :=
    Fintype.ofInjective Subtype.val Subtype.val_injective
  let Edge := TransitionSupportEdge transition
  let Layer := NonanchorLayer anchor
  have hab : ∀ e : Edge, e.1.1 ≠ e.1.2 :=
    fun e => e.2.1
  have htransition :
      ∀ e : Edge, transition e.1.2 e.1.1 ≠ 0 := by
    intro e
    exact (mul_ne_zero_iff.mp e.2.2).2
  obtain ⟨sameProbe, hsameProbeHermitian, hsame⟩ :=
    exists_eventually_all_hermitianNewLayerSesquilinearProbes_ne_zero
      energy hinj henergyReal transition htransitionReal
      anchor other hother branch hbranchAnalytic hbranchBase
      hbranchRoot hbranchReal
      (fun e : Edge => e.1.1) (fun e : Edge => e.1.2)
      hab htransition
  let bridgeProbe : Layer → Matrix ρ ρ ℂ :=
    fun r => hermitianLayerCosineProbe r.1 anchor
  let bridgeProbeLift :
      Layer → Matrix (I × ρ) (I × ρ) ℂ :=
    fun r =>
      layerMatrixCoupling (1 : Matrix I I ℂ) (bridgeProbe r)
  let center : I := Classical.choice (inferInstance : Nonempty I)
  let bridgeSource : Layer → I × ρ :=
    fun r => (center, r.1)
  let bridgeTarget : Layer → I × ρ :=
    fun _ => (center, anchor)
  have hbridgeEntry :
      ∀ r : Layer,
        bridgeProbeLift r (bridgeSource r) (bridgeTarget r) ≠ 0 := by
    intro r
    simp [bridgeProbeLift, bridgeProbe, bridgeSource, bridgeTarget,
      layerMatrixCoupling, hermitianLayerCosineProbe,
      directedLayerMatrix, r.2]
  have hbridgeBilinear :
      ∀ᶠ t : ℝ in 𝓝 0, ∀ r : Layer,
        affineEigenbranchMatrixProbe
          energy
          (layerMatrixCoupling transition
            (anchorStarLayerEdge anchor))
          (branch (bridgeSource r)) (branch (bridgeTarget r))
          (bridgeProbeLift r)
          (bridgeSource r) (bridgeTarget r) t ≠ 0 :=
    eventually_all_affineMatrixProbes_ne_zero_of_base_entries
      energy hinj
      (layerMatrixCoupling transition
        (anchorStarLayerEdge anchor))
      branch hbranchAnalytic hbranchBase
      bridgeProbeLift bridgeSource bridgeTarget hbridgeEntry
  have hbridgePhysical :
      ∀ᶠ t : ℝ in 𝓝[≠] 0, ∀ r : Layer,
        affineEigenbranchSesquilinearMatrixProbe
          energy
          (layerMatrixCoupling transition
            (anchorStarLayerEdge anchor))
          (branch (bridgeSource r)) (branch (bridgeTarget r))
          (bridgeProbeLift r)
          (bridgeSource r) (bridgeTarget r) t ≠ 0 := by
    have hbridgeBilinearPunctured :
        ∀ᶠ t : ℝ in 𝓝[≠] 0, ∀ r : Layer,
          affineEigenbranchMatrixProbe
            energy
            (layerMatrixCoupling transition
              (anchorStarLayerEdge anchor))
            (branch (bridgeSource r)) (branch (bridgeTarget r))
            (bridgeProbeLift r)
            (bridgeSource r) (bridgeTarget r) t ≠ 0 :=
      Filter.Eventually.filter_mono inf_le_left hbridgeBilinear
    have hbranchRealPunctured :
        ∀ᶠ t : ℝ in 𝓝[≠] 0, ∀ x,
          (starRingEnd ℂ) (branch x t) = branch x t :=
      Filter.Eventually.filter_mono inf_le_left hbranchReal
    filter_upwards
      [hbridgeBilinearPunctured, hbranchRealPunctured]
        with t ht hreal
    intro r
    rw [
      affineEigenbranchSesquilinearMatrixProbe_eq_bilinear_of_left_real
        energy
        (layerMatrixCoupling transition
          (anchorStarLayerEdge anchor))
        (branch (bridgeSource r)) (branch (bridgeTarget r))
        (bridgeProbeLift r)
        (bridgeSource r) (bridgeTarget r) t]
    · exact ht r
    · intro i
      apply star_affineEigenbranchAdjugateColumn_eq
      · exact henergyReal
      · rintro ⟨x, u⟩ ⟨y, v⟩
        simp [layerMatrixCoupling, htransitionReal,
          anchorStarLayerEdge_entrywise_real]
      · exact hreal (bridgeSource r)
      · simp
  let probe :
      Sum (Edge × ρ) Layer → Matrix ρ ρ ℂ
    | Sum.inl er => sameProbe er.1 er.2
    | Sum.inr r => bridgeProbe r
  refine ⟨probe, ?_, ?_⟩
  · intro p
    cases p with
    | inl er => exact hsameProbeHermitian er.1 er.2
    | inr r =>
        exact hermitianLayerCosineProbe_isHermitian r.1 anchor
  · filter_upwards [hsame, hbridgePhysical] with t hsameT hbridgeT
    have hle :
        anchoredReplicaGraph
            (transitionSupportGraph transition)
            anchor (fun _ => center) (fun _ => center) ≤
          newLayerEigenbranchProbeSupportGraph
            energy
            (layerMatrixCoupling transition
              (anchorStarLayerEdge anchor))
            branch probe t := by
      apply anchoredReplicaGraph_le_newLayerProbeSupportGraph
      · intro a b habEdge r
        let e : Edge := ⟨(a, b), habEdge⟩
        refine ⟨Sum.inl (e, r), ?_⟩
        simpa [probe, e] using hsameT e r
      · intro r hr
        let q : Layer := ⟨r, hr⟩
        refine ⟨Sum.inr q, ?_⟩
        simpa [probe, bridgeProbeLift, bridgeSource,
          bridgeTarget, q] using hbridgeT q
    exact ⟨
      newLayerProbeSupportGraph_preconnected
        (transitionSupportGraph transition) hconnected
        anchor (fun _ => center) (fun _ => center)
        energy
        (layerMatrixCoupling transition
          (anchorStarLayerEdge anchor))
        branch probe t hle,
      newLayerProbeSupportGraph_not_isBipartite
        (transitionSupportGraph transition) hnonbipartite
        anchor (fun _ => center) (fun _ => center)
        energy
        (layerMatrixCoupling transition
          (anchorStarLayerEdge anchor))
        branch probe t hle⟩

end

end GaloisForLFunctions.HTGeometry
