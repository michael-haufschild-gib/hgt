import Mathlib

/-!
# The prime support of a completely multiplicative arithmetic function is not finitely generated

The multiplicative monoid generated by a finite set of primes contains no prime outside that set,
because a prime dividing a product of primes is one of them.  Since there are infinitely many
primes, no finite set of primes generates them all.

This is the hypothesis of the universality theorem for Dirichlet differential fields: it is what
distinguishes a genuine Euler product with full prime support from one supported on finitely many
primes.  Verifying it once means it never has to be assumed for a particular character.
-/

namespace GaloisForLFunctions.HTGeometry

/-- A prime in the multiplicative closure of a finite set of primes belongs to that set. -/
theorem mem_of_prime_mem_closure {s : Finset ℕ} (hs : ∀ a ∈ s, Nat.Prime a) {q : ℕ}
    (hq : Nat.Prime q) (h : q ∈ Submonoid.closure (s : Set ℕ)) : q ∈ s := by
  classical
  have key : ∀ x ∈ Submonoid.closure (s : Set ℕ),
      x ≠ 0 ∧ ∀ p : ℕ, Nat.Prime p → p ∣ x → p ∈ s := by
    intro x hx
    refine Submonoid.closure_induction ?_ ?_ ?_ hx
    · intro a ha
      simp only [Finset.mem_coe] at ha
      refine ⟨(hs a ha).ne_zero, ?_⟩
      intro p hp hpa
      rwa [(Nat.prime_dvd_prime_iff_eq hp (hs a ha)).mp hpa]
    · exact ⟨one_ne_zero, fun p hp hp1 => absurd (Nat.eq_one_of_dvd_one hp1) hp.ne_one⟩
    · rintro x y - - ⟨hx0, hxp⟩ ⟨hy0, hyp⟩
      refine ⟨mul_ne_zero hx0 hy0, ?_⟩
      intro p hp hpxy
      rcases (Nat.Prime.dvd_mul hp).mp hpxy with hd | hd
      · exact hxp p hp hd
      · exact hyp p hp hd
  exact (key q h).2 q hq dvd_rfl

/-- **No finite set of primes generates every prime.**  The prime support of a completely
multiplicative function with full support is not finitely generated. -/
theorem primeSupport_not_finitelyGenerated :
    ¬ ∃ s : Finset ℕ, (∀ a ∈ s, Nat.Prime a) ∧
      ∀ q : ℕ, Nat.Prime q → q ∈ Submonoid.closure (s : Set ℕ) := by
  rintro ⟨s, hs, hgen⟩
  obtain ⟨q, hqs, hq⟩ := Nat.exists_infinite_primes (s.sup id + 1)
  have hmem : q ∈ s := mem_of_prime_mem_closure hs hq (hgen q hq)
  have hle : q ≤ s.sup id := Finset.le_sup (f := id) hmem
  omega

end GaloisForLFunctions.HTGeometry
