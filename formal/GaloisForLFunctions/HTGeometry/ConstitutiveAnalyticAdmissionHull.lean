import GaloisForLFunctions.HTGeometry.ConstitutiveEndogenousUnitizationInterference
import Mathlib.Topology.UrysohnsLemma

namespace HTGeometry

noncomputable section

/-!
# Analytic admission hull

Algebraic law saturation first forms the equivalence relation generated by a primitive relation.
Analytic admission then takes the largest Hausdorff quotient of that algebraic quotient.  The
result is characterized exactly by the continuous real-valued observers that unitize the primitive
relation.  This separates algebraic realizability from continuous-Hausdorff realizability without
choosing coordinates or a route-specific receiver.
-/

/-- Equivalence relation generated by a primitive law relation. -/
def algebraicAdmissionSetoid {X : Type*} (R : X → X → Prop) : Setoid X :=
  Relation.EqvGen.setoid R

/-- Algebraic unitization quotient. -/
abbrev AlgebraicAdmission {X : Type*} (R : X → X → Prop) :=
  Quotient (algebraicAdmissionSetoid R)

/-- Canonical map into the algebraic unitization quotient. -/
def algebraicAdmissionMk {X : Type*} (R : X → X → Prop) (x : X) :
    AlgebraicAdmission R :=
  Quotient.mk _ x

/-- Continuous-Hausdorff admission quotient of the algebraic unitization quotient. -/
abbrev AnalyticAdmission {X : Type*} [TopologicalSpace X] (R : X → X → Prop) :=
  T2Quotient (AlgebraicAdmission R)

/-- Canonical map into analytic admission. -/
def analyticAdmissionMk {X : Type*} [TopologicalSpace X]
    (R : X → X → Prop) (x : X) : AnalyticAdmission R :=
  T2Quotient.mk (algebraicAdmissionMk R x)

/-- Two source points are analytically admitted together when their canonical images agree. -/
def analyticAdmissionRel {X : Type*} [TopologicalSpace X]
    (R : X → X → Prop) (x y : X) : Prop :=
  analyticAdmissionMk R x = analyticAdmissionMk R y

theorem continuous_analyticAdmissionMk {X : Type*} [TopologicalSpace X]
    (R : X → X → Prop) : Continuous (analyticAdmissionMk R) := by
  exact (T2Quotient.continuous_mk _).comp continuous_quotient_mk'

/-- Analytic admission contains every primitive identification. -/
theorem analyticAdmissionRel_contains {X : Type*} [TopologicalSpace X]
    {R : X → X → Prop} {x y : X} (hxy : R x y) :
    analyticAdmissionRel R x y := by
  apply congrArg T2Quotient.mk
  exact Quotient.sound (Relation.EqvGen.rel x y hxy)

/-- An observer respecting primitive identifications respects their full equivalence saturation. -/
theorem eqvGen_observer_eq {X Y : Type*} {R : X → X → Prop}
    (q : X → Y) (hR : ∀ x y, R x y → q x = q y) :
    ∀ x y, Relation.EqvGen R x y → q x = q y := by
  apply Relation.EqvGen.eqvGen_le (r := R) (r' := Setoid.ker q)
  intro x y hxy
  exact hR x y hxy

/-- Algebraic observer lift. -/
def algebraicAdmissionObserverLift {X Y : Type*} {R : X → X → Prop}
    (q : X → Y) (hR : ∀ x y, R x y → q x = q y) :
    AlgebraicAdmission R → Y :=
  Quotient.lift q (eqvGen_observer_eq q hR)

theorem continuous_algebraicAdmissionObserverLift
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    {R : X → X → Prop} (q : X → Y) (hq : Continuous q)
    (hR : ∀ x y, R x y → q x = q y) :
    Continuous (algebraicAdmissionObserverLift q hR) := by
  exact hq.quotient_lift (eqvGen_observer_eq q hR)

/-- Every continuous Hausdorff-valued unitizing observer factors through analytic admission. -/
def analyticAdmissionObserverLift
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [T2Space Y]
    {R : X → X → Prop} (q : X → Y) (hq : Continuous q)
    (hR : ∀ x y, R x y → q x = q y) :
    AnalyticAdmission R → Y :=
  T2Quotient.lift (continuous_algebraicAdmissionObserverLift q hq hR)

theorem analyticAdmissionObserverLift_mk
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [T2Space Y]
    {R : X → X → Prop} (q : X → Y) (hq : Continuous q)
    (hR : ∀ x y, R x y → q x = q y) (x : X) :
    analyticAdmissionObserverLift q hq hR (analyticAdmissionMk R x) = q x := by
  exact T2Quotient.lift_mk _ _

/-- Analytically admitted points are erased by every continuous Hausdorff-valued unitizing
observer. -/
theorem analyticAdmissionRel_erases_every_continuous_T2_observer
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [T2Space Y]
    {R : X → X → Prop} {x y : X} (hxy : analyticAdmissionRel R x y)
    (q : X → Y) (hq : Continuous q)
    (hR : ∀ a b, R a b → q a = q b) : q x = q y := by
  have h := congrArg (analyticAdmissionObserverLift q hq hR) hxy
  simpa [analyticAdmissionObserverLift_mk] using h

/-- **Bipolar admission theorem.** On a compact Hausdorff source, analytic admission is exactly
indistinguishability by continuous real-valued observers that unitize the primitive relation. -/
theorem analyticAdmissionRel_iff_continuous_real_observers
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
    {R : X → X → Prop} {x y : X} :
    analyticAdmissionRel R x y ↔
      ∀ f : C(X, ℝ), (∀ a b, R a b → f a = f b) → f x = f y := by
  constructor
  · intro hxy f hf
    exact analyticAdmissionRel_erases_every_continuous_T2_observer hxy f f.continuous hf
  · intro hscalar
    by_contra hne
    let Q := AnalyticAdmission R
    let ax : Q := analyticAdmissionMk R x
    let ay : Q := analyticAdmissionMk R y
    have haxy : ax ≠ ay := hne
    letI : CompactSpace (AlgebraicAdmission R) := Quotient.compactSpace
    letI : CompactSpace Q := Quotient.compactSpace
    letI : NormalSpace Q := inferInstance
    obtain ⟨g, hg0, hg1, _⟩ := exists_continuous_zero_one_of_isClosed
      (isClosed_singleton : IsClosed ({ax} : Set Q))
      (isClosed_singleton : IsClosed ({ay} : Set Q))
      (Set.disjoint_singleton.mpr haxy)
    let f : C(X, ℝ) :=
      ⟨fun z => g (analyticAdmissionMk R z),
        g.continuous.comp (continuous_analyticAdmissionMk R)⟩
    have hfR : ∀ a b, R a b → f a = f b := by
      intro a b hab
      exact congrArg g (analyticAdmissionRel_contains hab)
    have hfeq := hscalar f hfR
    have hx0 : f x = 0 := hg0 (Set.mem_singleton ax)
    have hy1 : f y = 1 := hg1 (Set.mem_singleton ay)
    linarith

end

end HTGeometry
