import GaloisForLFunctions.HTGeometry.CohenMacaulayDepth
import Mathlib.RingTheory.Regular.RegularSequence

/-!
# The corpus's ring-regular sequences are mathlib's module-regular sequences

`RingTheory.Sequence.IsRegular M rs` specialised to `M = R` asks exactly what `IsRingRegularSeq`
asks: each entry is a nonzerodivisor modulo the ideal generated by the earlier ones, and the whole
ideal is proper.  The only difference is presentation — mathlib phrases regularity as
`IsSMulRegular (R ⧸ I • ⊤)` and properness as `⊤ ≠ ofList rs • ⊤`.

```text
smul_quotient_eq_mk_mul          r • z = mk r * z on a quotient
isSMulRegular_quotient_iff       IsSMulRegular (R ⧸ I) x ↔ IsRegularOn I x
ofList_smul_top                  I • ⊤ = I inside R
isRingRegularSeq_iff_isRegular   ** the two notions agree **
```

This matters because it connects the Cohen–Macaulay development here to
`Mathlib/RingTheory/Depth/Rees.lean`, whose `exists_isRegular_tfae` characterises the existence of a
regular sequence of length `n` by the vanishing of `Ext^i(R/I, M)` for `i < n`.  That is the tool
the remaining inductive step of the Hankel card needs: with Rees, "depth ≥ n" becomes an
Ext-vanishing statement and the depth lemma for a short exact sequence follows from the long exact
`Ext` sequence.
-/

namespace GaloisForLFunctions.HTGeometry

universe u
variable {R : Type u} [CommRing R]

theorem smul_quotient_eq_mk_mul (I : Ideal R) (r : R) (z : R ⧸ I) :
    r • z = Ideal.Quotient.mk I r * z := by
  induction z using Quotient.inductionOn with
  | h a => rfl

/-- The module-theoretic regularity of `x` on `R ⧸ I` is the corpus's `IsRegularOn`. -/
theorem isSMulRegular_quotient_iff (I : Ideal R) (x : R) :
    IsSMulRegular (R ⧸ I) x ↔ IsRegularOn I x := by
  rw [IsRegularOn, mem_nonZeroDivisors_iff]
  constructor
  · intro h
    refine ⟨fun z hz => ?_, fun z hz => ?_⟩
    · refine h ?_
      show x • z = x • 0
      rw [smul_quotient_eq_mk_mul, smul_zero]
      exact hz
    · refine h ?_
      show x • z = x • 0
      rw [smul_quotient_eq_mk_mul, smul_zero, mul_comm]
      exact hz
  · rintro ⟨h1, h2⟩ a b hab
    have hab' : x • a = x • b := hab
    have hzero : Ideal.Quotient.mk I x * (a - b) = 0 := by
      rw [mul_sub]
      rw [smul_quotient_eq_mk_mul, smul_quotient_eq_mk_mul] at hab'
      rw [hab', sub_self]
    have hsub := h1 (a - b) hzero
    exact sub_eq_zero.mp hsub

theorem ofList_smul_top (l : List R) :
    (Ideal.ofList l • (⊤ : Submodule R R)) = Ideal.ofList l := by simp

/-- **The corpus's ring-regular sequence is mathlib's module-regular sequence for `M = R`.**  This
connects the Cohen–Macaulay development to `RingTheory.Sequence` and, through it, to the Rees
theorem `exists_isRegular_tfae`. -/
theorem isRingRegularSeq_iff_isRegular (rs : List R) :
    IsRingRegularSeq rs ↔ RingTheory.Sequence.IsRegular R rs := by
  constructor
  · intro h
    refine ⟨⟨fun i hi => ?_⟩, ?_⟩
    · rw [ofList_smul_top]
      exact (isSMulRegular_quotient_iff _ _).mpr (h.regular i hi)
    · intro htop
      exact h.proper (by rw [ofList_smul_top] at htop; exact htop.symm)
  · intro h
    refine ⟨fun i hi => ?_, ?_⟩
    · have hreg := h.regular_mod_prev i hi
      rw [ofList_smul_top] at hreg
      exact (isSMulRegular_quotient_iff _ _).mp hreg
    · intro htop
      exact h.top_ne_smul (by rw [ofList_smul_top]; exact htop.symm)


end GaloisForLFunctions.HTGeometry
