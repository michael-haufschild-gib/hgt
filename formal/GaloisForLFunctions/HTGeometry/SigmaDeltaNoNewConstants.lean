import GaloisForLFunctions.HTGeometry.DifferentialPrincipalIdeal
import GaloisForLFunctions.HTGeometry.KolchinNullstellensatzDiffFG

/-!
# No new difference constants in a differentially finite σ-δ-simple algebra

A differentially finitely generated reduced algebra over a differentially closed field cannot
acquire new fixed elements when it is simple for the commuting difference and differential
operators.  A differential point sends a putative fixed element `x` to a scalar `c`.  The
differential ideal generated by `x - c` is proper, difference-stable, and differential-stable;
double simplicity therefore forces `x = c`.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C R : Type u} [Field C] [Algebra ℚ C] [Differential C]
  [IsDifferentiallyClosed C] [CommRing R] [Nontrivial R] [IsReduced R]
  [Algebra C R] [Algebra ℚ R] [Differential R] [DifferentialAlgebra C R]

/-- A differentially finitely generated `σ`-`δ`-simple algebra over differentially closed
constants has no new `σ`-constants. -/
theorem exists_eq_algebraMap_of_isSigmaDeltaSimple_of_diffFG
    (σ : R ≃+* R) (hσδ : CommutesDeriv σ)
    (hσC : ∀ c : C, σ (algebraMap C R c) = algebraMap C R c)
    (hsimple : IsSigmaDeltaSimple σ)
    {k : ℕ} (y : Fin k → R)
    (hy : Function.Surjective
      (differentialPolynomialEvalOver (K := C) (L := R) y))
    {x : R} (hx : σ x = x) :
    ∃ c : C, x = algebraMap C R c := by
  obtain ⟨χ, hχδ, -⟩ :=
    exists_differentialAlgHom_ne_zero_of_diffFG (C := C) (E := R) y hy
      (e := (1 : R)) one_ne_zero
  let c : C := χ x
  let p : R := x - algebraMap C R c
  have hpσ : σ p = p := by
    simp only [p, map_sub, hx, hσC]
  have hpχ : χ p = 0 := by
    simp [p, c]
  have hproper : derivationIterateIdeal p ≠ ⊤ :=
    derivationIterateIdeal_ne_top_of_ringHom χ.toRingHom hχδ hpχ
  have hsd : IsSigmaDeltaIdeal σ (derivationIterateIdeal p) :=
    isSigmaDeltaIdeal_derivationIterateIdeal_of_fixed hσδ hpσ
  have hbot : derivationIterateIdeal p = ⊥ :=
    (hsimple (derivationIterateIdeal p) hsd).resolve_right hproper
  have hpzero : p = 0 := by
    rw [← Ideal.mem_bot, ← hbot]
    exact iterate_deriv_mem_derivationIterateIdeal p 0
  exact ⟨c, sub_eq_zero.mp hpzero⟩

end

end GaloisForLFunctions.HTGeometry
