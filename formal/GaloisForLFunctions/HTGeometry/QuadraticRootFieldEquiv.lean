import GaloisForLFunctions.HTGeometry.QuadraticAdjoinSquareKernel

/-!
# Identifying quadratic root fields

A root of a nonsquare scalar has minimal polynomial `X^2-C c`. Its generated
field is therefore algebra-equivalent to the field generated by any other
root of that scalar, even when the ambient extension fields differ.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open Polynomial
open scoped IntermediateField
variable {F L M : Type*} [Field F] [Field L] [Field M] [Algebra F L] [Algebra F M]

/-- The precise minimal polynomial of a root of a nonsquare scalar. -/
theorem minpoly_of_root_nonsquare {c : F} {r : L}
    (hr : r * r = algebraMap F L c) (hc : ¬ IsSquare c) :
    minpoly F r = X ^ 2 - C c := by
  have hi := isIntegral_of_sq_mem_bot hr
  have hd : (minpoly F r).natDegree = 2 := by
    rw [← IntermediateField.adjoin.finrank hi]
    exact finrank_adjoin_eq_two hr (root_not_mem_bot_of_not_isSquare hr hc)
  apply (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hi)
    (Polynomial.monic_X_pow_sub_C c (by decide : (2 : ℕ) ≠ 0)) ?_ ?_).symm
  · apply minpoly.dvd F r
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, pow_two, hr, sub_self]
  · rw [hd, Polynomial.natDegree_sub_C, Polynomial.natDegree_X_pow]

/-- Two roots of the same nonsquare scalar generate isomorphic quadratic fields. -/
def quadraticRootFieldEquiv {c : F} {r : L} {s : M}
    (hr : r * r = algebraMap F L c) (hs : s * s = algebraMap F M c)
    (hc : ¬ IsSquare c) : F⟮r⟯ ≃ₐ[F] F⟮s⟯ :=
  (IntermediateField.adjoin.powerBasis (isIntegral_of_sq_mem_bot hr)).equivOfMinpoly
    (IntermediateField.adjoin.powerBasis (isIntegral_of_sq_mem_bot hs)) (by
      rw [IntermediateField.adjoin.powerBasis_gen, IntermediateField.minpoly_gen,
        IntermediateField.adjoin.powerBasis_gen, IntermediateField.minpoly_gen,
        minpoly_of_root_nonsquare hr hc, minpoly_of_root_nonsquare hs hc])

end GaloisForLFunctions.HTGeometry
