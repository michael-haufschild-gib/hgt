import GaloisForLFunctions.HTGeometry.QDifferenceLaurentOneVariable
import GaloisForLFunctions.HTGeometry.FiniteAlgebraicStateBoundary
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity

/-!
# Euler versus ordinary derivation

On `k((z))` the Euler operator is the coordinate times the ordinary derivative, and the same holds
on `k(z)`.  Differential algebraicity over `k(z)` is therefore the same notion for both
derivations: the differential field generated by an element for one derivation is closed under the
other, because the two differ by a unit of the base field, and closure plus finite transcendence
degree is exactly the criterion for differential algebraicity.
-/

namespace GaloisForLFunctions.HTGeometry

open HahnSeries

open scoped RatFunc

noncomputable section

variable {k : Type*} [Field k]

local instance eoIntAlgebraRatFunc : Algebra ℤ (RatFunc k) := Ring.toIntAlgebra _

/-- The coordinate of `k((z))`. -/
def laurentCoord (k : Type*) [Field k] : LaurentSeries k := HahnSeries.single 1 1

theorem algebraMap_ratFuncX : algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X = laurentCoord k :=
  RatFunc.coe_X

theorem laurentCoord_mul_inv : laurentCoord k * HahnSeries.single (-1) 1 = 1 := by
  rw [laurentCoord, HahnSeries.single_mul_single, mul_one]
  norm_num

theorem algebraMap_ratFuncX_inv :
    algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X⁻¹ = HahnSeries.single (-1) 1 := by
  have hne : (RatFunc.X : RatFunc k) ≠ 0 := RatFunc.X_ne_zero
  have h : algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X
      * algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hne, map_one]
  rw [algebraMap_ratFuncX] at h
  have hcoordne : laurentCoord k ≠ 0 := by
    intro hzero
    have := congrArg (fun x : LaurentSeries k => x.coeff 1) hzero
    simp [laurentCoord] at this
  exact mul_left_cancel₀ hcoordne (by rw [h, laurentCoord_mul_inv])

/-- The ordinary differential structure of `k((z))`: the Euler operator divided by the
coordinate. -/
@[reducible] def innerOrdinaryDifferential : Differential (LaurentSeries k) :=
  hahnScaledDifferential (Int.castAddHom k) (HahnSeries.single (-1) 1)

theorem innerOrdinaryDifferential_deriv (f : LaurentSeries k) :
    (innerOrdinaryDifferential (k := k)).deriv f
      = HahnSeries.single (-1) 1 * innerEuler f :=
  hahnScaledDifferential_deriv _ _ _

/-- The ordinary differential structure of `k(z)`. -/
@[reducible] def ratFuncOrdinaryDifferential : Differential (RatFunc k) :=
  ⟨Derivation.restrictScalars ℤ (ratFuncDerivative k)⟩

theorem ratFuncOrdinaryDifferential_deriv (f : RatFunc k) :
    (ratFuncOrdinaryDifferential (k := k)).deriv f = ratFuncDerivative k f := rfl

theorem ratFuncEulerOp_eq_X_mul (f : RatFunc k) :
    ratFuncEulerOp f = RatFunc.X * ratFuncDerivative k f := by
  rw [ratFuncEulerOp, toRF, RatFunc.algebraMap_X]

theorem ratFuncDerivative_eq_inv_mul (f : RatFunc k) :
    ratFuncDerivative k f = (RatFunc.X : RatFunc k)⁻¹ * ratFuncEulerOp f := by
  rw [ratFuncEulerOp_eq_X_mul, ← mul_assoc, inv_mul_cancel₀ RatFunc.X_ne_zero, one_mul]

/-- The Laurent expansion intertwines the two ordinary derivatives. -/
theorem algebraMap_ratFuncDerivative (f : RatFunc k) :
    algebraMap (RatFunc k) (LaurentSeries k) (ratFuncDerivative k f)
      = HahnSeries.single (-1) 1 * innerEuler (algebraMap (RatFunc k) (LaurentSeries k) f) := by
  rw [ratFuncDerivative_eq_inv_mul, map_mul, algebraMap_ratFuncX_inv, algebraMap_ratFuncEulerOp]

/-! ## The two notions of differential algebraicity agree -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 400000 in
/-- **Differential algebraicity over `k(z)` does not depend on which of the two derivations is
used.**  The differential field generated for one derivation is closed under the other, because
the two differ by a unit of the base field. -/
theorem differentialAlgebraicOver_ordinary_of_euler [CharZero k] {x : LaurentSeries k}
    (hx : letI := innerDifferential (k := k)
      DifferentialAlgebraicOver (RatFunc k) x) :
    letI := innerOrdinaryDifferential (k := k)
    DifferentialAlgebraicOver (RatFunc k) x := by
  letI dE := innerDifferential (k := k)
  letI cE := cylinderDifferential (1 : k)
  haveI := IsScalarTower.of_algebraMap_eq (R := k) (S := RatFunc k) (A := LaurentSeries k)
    fun c => by
      rw [algebraMap_k_laurentSeries]
      exact (algebraMap_const_laurentSeries c).symm
  haveI hcz : CharZero (LaurentSeries k) :=
    charZero_of_injective_algebraMap (algebraMap k (LaurentSeries k)).injective
  haveI daE : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _ cE dE :=
    ⟨fun y => by
      rw [innerDifferential_deriv, cylinderDifferential_deriv, cylDeriv_one_eq_ratFuncEulerOp,
        algebraMap_ratFuncEulerOp]⟩
  set S : IntermediateField (RatFunc k) (LaurentSeries k) :=
    @differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ dE ({x} : Set (LaurentSeries k))
    with hS
  have hxS : x ∈ S := @subset_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ dE _ x rfl
  have hclosedE : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _ dE S :=
    @derivationClosed_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ cE dE _ daE _
  have hfin : Algebra.trdeg (RatFunc k) S < Cardinal.aleph0 :=
    @differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic (RatFunc k) (LaurentSeries k)
      _ _ _ cE dE daE _ _ hx
  have daO : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _
      (ratFuncOrdinaryDifferential (k := k)) (innerOrdinaryDifferential (k := k)) :=
    @DifferentialAlgebra.mk (RatFunc k) (LaurentSeries k) _ _ _
      (ratFuncOrdinaryDifferential (k := k)) (innerOrdinaryDifferential (k := k))
      (fun y => by
        rw [innerOrdinaryDifferential_deriv, ratFuncOrdinaryDifferential_deriv,
          algebraMap_ratFuncDerivative])
  have hclosedO : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _
      (innerOrdinaryDifferential (k := k)) S := by
    intro y hy
    have hy' : (innerOrdinaryDifferential (k := k)).deriv y
        = algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X⁻¹
          * (innerDifferential (k := k)).deriv y := by
      rw [innerOrdinaryDifferential_deriv, algebraMap_ratFuncX_inv, innerDifferential_deriv]
    show (innerOrdinaryDifferential (k := k)).deriv y ∈ S
    rw [hy']
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (hclosedE hy)
  exact @differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg (RatFunc k)
    (LaurentSeries k) _ _ _ (ratFuncOrdinaryDifferential (k := k))
    (innerOrdinaryDifferential (k := k)) daO hcz S hclosedO hfin x hxS

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 400000 in
/-- The converse transfer: the Euler derivation is the coordinate times the ordinary one. -/
theorem differentialAlgebraicOver_euler_of_ordinary [CharZero k] {x : LaurentSeries k}
    (hx : letI := innerOrdinaryDifferential (k := k)
      DifferentialAlgebraicOver (RatFunc k) x) :
    letI := innerDifferential (k := k)
    DifferentialAlgebraicOver (RatFunc k) x := by
  letI dO := innerOrdinaryDifferential (k := k)
  letI cO := ratFuncOrdinaryDifferential (k := k)
  haveI := IsScalarTower.of_algebraMap_eq (R := k) (S := RatFunc k) (A := LaurentSeries k)
    fun c => by
      rw [algebraMap_k_laurentSeries]
      exact (algebraMap_const_laurentSeries c).symm
  haveI hcz : CharZero (LaurentSeries k) :=
    charZero_of_injective_algebraMap (algebraMap k (LaurentSeries k)).injective
  haveI daO : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _ cO dO :=
    @DifferentialAlgebra.mk (RatFunc k) (LaurentSeries k) _ _ _ cO dO
      (fun y => by
        rw [innerOrdinaryDifferential_deriv, ratFuncOrdinaryDifferential_deriv,
          algebraMap_ratFuncDerivative])
  set S : IntermediateField (RatFunc k) (LaurentSeries k) :=
    @differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ dO ({x} : Set (LaurentSeries k))
    with hS
  have hxS : x ∈ S := @subset_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ dO _ x rfl
  have hclosedO : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _ dO S :=
    @derivationClosed_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ cO dO _ daO _
  have hfin : Algebra.trdeg (RatFunc k) S < Cardinal.aleph0 :=
    @differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic (RatFunc k) (LaurentSeries k)
      _ _ _ cO dO daO _ _ hx
  have daE : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _
      (cylinderDifferential (1 : k)) (innerDifferential (k := k)) :=
    @DifferentialAlgebra.mk (RatFunc k) (LaurentSeries k) _ _ _
      (cylinderDifferential (1 : k)) (innerDifferential (k := k))
      (fun y => by
        rw [innerDifferential_deriv, cylinderDifferential_deriv, cylDeriv_one_eq_ratFuncEulerOp,
          algebraMap_ratFuncEulerOp])
  have hclosedE : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _
      (innerDifferential (k := k)) S := by
    intro y hy
    have hy' : (innerDifferential (k := k)).deriv y
        = algebraMap (RatFunc k) (LaurentSeries k) RatFunc.X
          * (innerOrdinaryDifferential (k := k)).deriv y := by
      rw [innerOrdinaryDifferential_deriv, algebraMap_ratFuncX, innerDifferential_deriv,
        laurentCoord, ← mul_assoc, HahnSeries.single_mul_single, mul_one]
      norm_num
    show (innerDifferential (k := k)).deriv y ∈ S
    rw [hy']
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (hclosedO hy)
  exact @differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg (RatFunc k)
    (LaurentSeries k) _ _ _ (cylinderDifferential (1 : k)) (innerDifferential (k := k)) daE hcz
    S hclosedE hfin x hxS

/-- **Hypertranscendence for the Euler derivation gives hypertranscendence for the ordinary
one.** -/
theorem hypertranscendentalOver_ordinary_of_euler [CharZero k] {x : LaurentSeries k}
    (hx : letI := innerDifferential (k := k)
      HypertranscendentalOver (RatFunc k) x) :
    letI := innerOrdinaryDifferential (k := k)
    HypertranscendentalOver (RatFunc k) x :=
  fun hDA => hx (differentialAlgebraicOver_euler_of_ordinary hDA)

/-! ## Rescaling the derivation by a unit of the base -/

set_option maxHeartbeats 1000000 in
set_option synthInstance.maxHeartbeats 400000 in
/-- **Rescaling the derivation of `k((z))` by a nonzero rational function does not change
differential algebraicity over `k(z)`.**  The differential field generated for one derivation is
closed under the other. -/
theorem differentialAlgebraicOver_scaledDeriv [CharZero k]
    (C₁ C₂ : Differential (RatFunc k)) (D₁ D₂ : Differential (LaurentSeries k)) (u : RatFunc k)
    (hcompat₁ : ∀ y : RatFunc k, D₁.deriv (algebraMap (RatFunc k) (LaurentSeries k) y)
      = algebraMap (RatFunc k) (LaurentSeries k) (C₁.deriv y))
    (hcompat₂ : ∀ y : RatFunc k, D₂.deriv (algebraMap (RatFunc k) (LaurentSeries k) y)
      = algebraMap (RatFunc k) (LaurentSeries k) (C₂.deriv y))
    (hscale : ∀ f : LaurentSeries k,
      D₁.deriv f = algebraMap (RatFunc k) (LaurentSeries k) u * D₂.deriv f)
    {x : LaurentSeries k}
    (hx : @DifferentialAlgebraicOver (RatFunc k) (LaurentSeries k) _ _ _ D₂ x) :
    @DifferentialAlgebraicOver (RatFunc k) (LaurentSeries k) _ _ _ D₁ x := by
  haveI := IsScalarTower.of_algebraMap_eq (R := k) (S := RatFunc k) (A := LaurentSeries k)
    fun c => by
      rw [algebraMap_k_laurentSeries]
      exact (algebraMap_const_laurentSeries c).symm
  haveI hcz : CharZero (LaurentSeries k) :=
    charZero_of_injective_algebraMap (algebraMap k (LaurentSeries k)).injective
  haveI da₂ : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _ C₂ D₂ :=
    @DifferentialAlgebra.mk (RatFunc k) (LaurentSeries k) _ _ _ C₂ D₂ (fun y => hcompat₂ y)
  haveI da₁ : @DifferentialAlgebra (RatFunc k) (LaurentSeries k) _ _ _ C₁ D₁ :=
    @DifferentialAlgebra.mk (RatFunc k) (LaurentSeries k) _ _ _ C₁ D₁ (fun y => hcompat₁ y)
  set S : IntermediateField (RatFunc k) (LaurentSeries k) :=
    @differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ D₂ ({x} : Set (LaurentSeries k))
    with hS
  have hxS : x ∈ S := @subset_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ _ D₂ _ x rfl
  have hclosed₂ : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _ D₂ S :=
    @derivationClosed_differentialAdjoin (RatFunc k) (LaurentSeries k) _ _ C₂ D₂ _ da₂ _
  have hfin : Algebra.trdeg (RatFunc k) S < Cardinal.aleph0 :=
    @differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic (RatFunc k) (LaurentSeries k)
      _ _ _ C₂ D₂ da₂ _ _ hx
  have hclosed₁ : @DerivationClosed (RatFunc k) (LaurentSeries k) _ _ _ D₁ S := by
    intro y hy
    show D₁.deriv y ∈ S
    rw [hscale]
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (hclosed₂ hy)
  exact @differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg (RatFunc k)
    (LaurentSeries k) _ _ _ C₁ D₁ da₁ hcz S hclosed₁ hfin x hxS

end

end GaloisForLFunctions.HTGeometry
