        (80238323817431040 : ℝ)*(z-24)^(0 : ℕ) + (61850815290116096 : ℝ)*(z-24)^(1 : ℕ) + (20152231875004416 : ℝ)*(z-24)^(2 : ℕ) + (3747761346357248 : ℝ)*(z-24)^(3 : ℕ) + (447754466283520 : ℝ)*(z-24)^(4 : ℕ) + (36377649532928 : ℝ)*(z-24)^(5 : ℕ) + (2062118209536 : ℝ)*(z-24)^(6 : ℕ) + (81880651776 : ℝ)*(z-24)^(7 : ℕ) + (2238382080 : ℝ)*(z-24)^(8 : ℕ) + (40212480 : ℝ)*(z-24)^(9 : ℕ) + (428032 : ℝ)*(z-24)^(10 : ℕ) + (2048 : ℝ)*(z-24)^(11 : ℕ) := by ring
    rw [hid]
    positivity
  · have hid : (2*z)^(11 : ℕ)-(-1 : ℝ)^(11 : ℕ)*((-2048 : ℝ)*(z)^(1 : ℕ) + (2095104 : ℝ)*(z)^(2 : ℕ) + (-58370048 : ℝ)*(z)^(3 : ℕ) + (298496000 : ℝ)*(z)^(4 : ℕ) + (-505303040 : ℝ)*(z)^(5 : ℕ) + (367589376 : ℝ)*(z)^(6 : ℕ) + (-131045376 : ℝ)*(z)^(7 : ℕ) + (24330240 : ℝ)*(z)^(8 : ℕ) + (-2365440 : ℝ)*(z)^(9 : ℕ) + (112640 : ℝ)*(z)^(10 : ℕ) + (-2048 : ℝ)*(z)^(11 : ℕ)) =
        (3036164657392730112 : ℝ)*(z-24)^(0 : ℕ) + (1366500551097874432 : ℝ)*(z-24)^(1 : ℕ) + (277420969455826944 : ℝ)*(z-24)^(2 : ℕ) + (33448888819996672 : ℝ)*(z-24)^(3 : ℕ) + (2651966380912640 : ℝ)*(z-24)^(4 : ℕ) + (144439399886848 : ℝ)*(z-24)^(5 : ℕ) + (5471925516288 : ℝ)*(z-24)^(6 : ℕ) + (142346840064 : ℝ)*(z-24)^(7 : ℕ) + (2433024000 : ℝ)*(z-24)^(8 : ℕ) + (24668160 : ℝ)*(z-24)^(9 : ℕ) + (112640 : ℝ)*(z-24)^(10 : ℕ) := by ring
    have h : 0 ≤ (2*z)^(11 : ℕ)-(-1 : ℝ)^(11 : ℕ)*((-2048 : ℝ)*(z)^(1 : ℕ) + (2095104 : ℝ)*(z)^(2 : ℕ) + (-58370048 : ℝ)*(z)^(3 : ℕ) + (298496000 : ℝ)*(z)^(4 : ℕ) + (-505303040 : ℝ)*(z)^(5 : ℕ) + (367589376 : ℝ)*(z)^(6 : ℕ) + (-131045376 : ℝ)*(z)^(7 : ℕ) + (24330240 : ℝ)*(z)^(8 : ℕ) + (-2365440 : ℝ)*(z)^(9 : ℕ) + (112640 : ℝ)*(z)^(10 : ℕ) + (-2048 : ℝ)*(z)^(11 : ℕ)) := by
      rw [hid]
      positivity
    linarith only [h]

