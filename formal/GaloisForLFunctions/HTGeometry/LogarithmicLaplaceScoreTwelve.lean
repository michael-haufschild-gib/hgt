/-- Signed leading-monomial bounds through order twelve on the extended score ray. -/
theorem laplaceCoolingJet_signed_bounds_twelve {n : ℕ} (hn : n ≤ 12) {z : ℝ}
    (hz : 24 ≤ z) :
    0 ≤ (-1 : ℝ)^n*laplaceCoolingJet n 0 z ∧
      (-1 : ℝ)^n*laplaceCoolingJet n 0 z ≤ (2*z)^n := by
  by_cases h : n ≤ 10
  · exact laplaceCoolingJet_signed_bounds h (by linarith)
  · have he : n = 11 ∨ n = 12 := by omega
    rcases he with rfl | rfl
    · exact laplaceCoolingJet_11_bounds hz
    · exact laplaceCoolingJet_12_bounds hz

end
end HTGeometry
