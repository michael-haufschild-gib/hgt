import GaloisForLFunctions.HTGeometry.LogarithmicLaplaceScoreBounds

/-! # Signed logarithmic Laplace differentiation through order twelve -/
namespace HTGeometry
noncomputable section
set_option maxHeartbeats 4000000

/-- Exact order-11 score, with every alternating coefficient retained. -/
theorem laplaceCoolingJet_11 (z : ℝ) :
    laplaceCoolingJet 11 0 z = (-2048 : ℝ)*(z)^(1 : ℕ) + (2095104 : ℝ)*(z)^(2 : ℕ) + (-58370048 : ℝ)*(z)^(3 : ℕ) + (298496000 : ℝ)*(z)^(4 : ℕ) + (-505303040 : ℝ)*(z)^(5 : ℕ) + (367589376 : ℝ)*(z)^(6 : ℕ) + (-131045376 : ℝ)*(z)^(7 : ℕ) + (24330240 : ℝ)*(z)^(8 : ℕ) + (-2365440 : ℝ)*(z)^(9 : ℕ) + (112640 : ℝ)*(z)^(10 : ℕ) + (-2048 : ℝ)*(z)^(11 : ℕ) := by
  norm_num [laplaceCoolingJet]
  ring

/-- Both score reserves have nonnegative coefficients after translation by twenty-four. -/
theorem laplaceCoolingJet_11_bounds {z : ℝ} (hz : 24 ≤ z) :
    0 ≤ (-1 : ℝ)^(11 : ℕ)*laplaceCoolingJet 11 0 z ∧
      (-1 : ℝ)^(11 : ℕ)*laplaceCoolingJet 11 0 z ≤ (2*z)^(11 : ℕ) := by
  have hy : 0 ≤ z-24 := by linarith
  rw [laplaceCoolingJet_11]
  constructor
