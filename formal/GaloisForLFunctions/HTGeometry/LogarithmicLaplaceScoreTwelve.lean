        (148704742688776617984 : ℝ)*(z-24)^(0 : ℕ) + (73722671658064089088 : ℝ)*(z-24)^(1 : ℕ) + (16669494197450903552 : ℝ)*(z-24)^(2 : ℕ) + (2268844027876073472 : ℝ)*(z-24)^(3 : ℕ) + (206504835541970944 : ℝ)*(z-24)^(4 : ℕ) + (13194690496069632 : ℝ)*(z-24)^(5 : ℕ) + (603788542066688 : ℝ)*(z-24)^(6 : ℕ) + (19782367199232 : ℝ)*(z-24)^(7 : ℕ) + (454664736768 : ℝ)*(z-24)^(8 : ℕ) + (6979399680 : ℝ)*(z-24)^(9 : ℕ) + (64385024 : ℝ)*(z-24)^(10 : ℕ) + (270336 : ℝ)*(z-24)^(11 : ℕ) := by ring
