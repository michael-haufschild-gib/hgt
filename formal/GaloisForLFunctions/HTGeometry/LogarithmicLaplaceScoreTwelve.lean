import GaloisForLFunctions.HTGeometry.LogarithmicLaplaceScoreBounds

/-! # Signed logarithmic Laplace differentiation through order twelve -/
namespace HTGeometry
noncomputable section
set_option maxHeartbeats 4000000

/-- Exact order-11 score, with every alternating coefficient retained. -/
theorem laplaceCoolingJet_11 (z : ℝ) :
    laplaceCoolingJet 11 0 z = (-2048 : ℝ)*(z)^1 + (2095104 : ℝ)*(z)^2 + (-58370048 : ℝ)*(z)^3 + (298496000 : ℝ)*(z)^4 + (-505303040 : ℝ)*(z)^5 + (367589376 : ℝ)*(z)^6 + (-131045376 : ℝ)*(z)^7 + (24330240 : ℝ)*(z)^8 + (-2365440 : ℝ)*(z)^9 + (112640 : ℝ)*(z)^10 + (-2048 : ℝ)*(z)^11 := by
  norm_num [laplaceCoolingJet]
  ring

/-- Both score reserves have nonnegative coefficients after translation by twenty-four. -/
theorem laplaceCoolingJet_11_bounds {z : ℝ} (hz : 24 ≤ z) :
    0 ≤ (-1 : ℝ)^11*laplaceCoolingJet 11 0 z ∧
      (-1 : ℝ)^11*laplaceCoolingJet 11 0 z ≤ (2*z)^11 := by
  have hy : 0 ≤ z-24 := by linarith
  rw [laplaceCoolingJet_11]
  constructor
  · have hid : (-1 : ℝ)^11*((-2048 : ℝ)*(z)^1 + (2095104 : ℝ)*(z)^2 + (-58370048 : ℝ)*(z)^3 + (298496000 : ℝ)*(z)^4 + (-505303040 : ℝ)*(z)^5 + (367589376 : ℝ)*(z)^6 + (-131045376 : ℝ)*(z)^7 + (24330240 : ℝ)*(z)^8 + (-2365440 : ℝ)*(z)^9 + (112640 : ℝ)*(z)^10 + (-2048 : ℝ)*(z)^11) =
        (80238323817431040 : ℝ)*(z-24)^0 + (61850815290116096 : ℝ)*(z-24)^1 + (20152231875004416 : ℝ)*(z-24)^2 + (3747761346357248 : ℝ)*(z-24)^3 + (447754466283520 : ℝ)*(z-24)^4 + (36377649532928 : ℝ)*(z-24)^5 + (2062118209536 : ℝ)*(z-24)^6 + (81880651776 : ℝ)*(z-24)^7 + (2238382080 : ℝ)*(z-24)^8 + (40212480 : ℝ)*(z-24)^9 + (428032 : ℝ)*(z-24)^10 + (2048 : ℝ)*(z-24)^11 := by ring
    rw [hid]
    positivity
  · have hid : (2*z)^11-(-1 : ℝ)^11*((-2048 : ℝ)*(z)^1 + (2095104 : ℝ)*(z)^2 + (-58370048 : ℝ)*(z)^3 + (298496000 : ℝ)*(z)^4 + (-505303040 : ℝ)*(z)^5 + (367589376 : ℝ)*(z)^6 + (-131045376 : ℝ)*(z)^7 + (24330240 : ℝ)*(z)^8 + (-2365440 : ℝ)*(z)^9 + (112640 : ℝ)*(z)^10 + (-2048 : ℝ)*(z)^11) =
        (3036164657392730112 : ℝ)*(z-24)^0 + (1366500551097874432 : ℝ)*(z-24)^1 + (277420969455826944 : ℝ)*(z-24)^2 + (33448888819996672 : ℝ)*(z-24)^3 + (2651966380912640 : ℝ)*(z-24)^4 + (144439399886848 : ℝ)*(z-24)^5 + (5471925516288 : ℝ)*(z-24)^6 + (142346840064 : ℝ)*(z-24)^7 + (2433024000 : ℝ)*(z-24)^8 + (24668160 : ℝ)*(z-24)^9 + (112640 : ℝ)*(z-24)^10 := by ring
    have h : 0 ≤ (2*z)^11-(-1 : ℝ)^11*((-2048 : ℝ)*(z)^1 + (2095104 : ℝ)*(z)^2 + (-58370048 : ℝ)*(z)^3 + (298496000 : ℝ)*(z)^4 + (-505303040 : ℝ)*(z)^5 + (367589376 : ℝ)*(z)^6 + (-131045376 : ℝ)*(z)^7 + (24330240 : ℝ)*(z)^8 + (-2365440 : ℝ)*(z)^9 + (112640 : ℝ)*(z)^10 + (-2048 : ℝ)*(z)^11) := by
      rw [hid]
      positivity
    linarith only [h]

/-- Exact order-12 score, with every alternating coefficient retained. -/
theorem laplaceCoolingJet_12 (z : ℝ) :
    laplaceCoolingJet 12 0 z = (-4096 : ℝ)*(z)^1 + (8384512 : ℝ)*(z)^2 + (-354410496 : ℝ)*(z)^3 + (2504708096 : ℝ)*(z)^4 + (-5650022400 : ℝ)*(z)^5 + (5421678592 : ℝ)*(z)^6 + (-2569814016 : ℝ)*(z)^7 + (651374592 : ℝ)*(z)^8 + (-91238400 : ℝ)*(z)^9 + (6983680 : ℝ)*(z)^10 + (-270336 : ℝ)*(z)^11 + (4096 : ℝ)*(z)^12 := by
  norm_num [laplaceCoolingJet]
  ring

/-- Both score reserves have nonnegative coefficients after translation by twenty-four. -/
theorem laplaceCoolingJet_12_bounds {z : ℝ} (hz : 24 ≤ z) :
    0 ≤ (-1 : ℝ)^12*laplaceCoolingJet 12 0 z ∧
      (-1 : ℝ)^12*laplaceCoolingJet 12 0 z ≤ (2*z)^12 := by
  have hy : 0 ≤ z-24 := by linarith
  rw [laplaceCoolingJet_12]
  constructor
  · have hid : (-1 : ℝ)^12*((-4096 : ℝ)*(z)^1 + (8384512 : ℝ)*(z)^2 + (-354410496 : ℝ)*(z)^3 + (2504708096 : ℝ)*(z)^4 + (-5650022400 : ℝ)*(z)^5 + (5421678592 : ℝ)*(z)^6 + (-2569814016 : ℝ)*(z)^7 + (651374592 : ℝ)*(z)^8 + (-91238400 : ℝ)*(z)^9 + (6983680 : ℝ)*(z)^10 + (-270336 : ℝ)*(z)^11 + (4096 : ℝ)*(z)^12) =
        (882600409311117312 : ℝ)*(z-24)^0 + (1070999890979778560 : ℝ)*(z-24)^1 + (470722199204982784 : ℝ)*(z-24)^2 + (111741582770577408 : ℝ)*(z-24)^3 + (16675065456152576 : ℝ)*(z-24)^4 + (1683969570471936 : ℝ)*(z-24)^5 + (119479655612416 : ℝ)*(z-24)^6 + (6048639860736 : ℝ)*(z-24)^7 + (218017738752 : ℝ)*(z-24)^8 + (5477683200 : ℝ)*(z-24)^9 + (91328512 : ℝ)*(z-24)^10 + (909312 : ℝ)*(z-24)^11 + (4096 : ℝ)*(z-24)^12 := by ring
    rw [hid]
    positivity
  · have hid : (2*z)^12-(-1 : ℝ)^12*((-4096 : ℝ)*(z)^1 + (8384512 : ℝ)*(z)^2 + (-354410496 : ℝ)*(z)^3 + (2504708096 : ℝ)*(z)^4 + (-5650022400 : ℝ)*(z)^5 + (5421678592 : ℝ)*(z)^6 + (-2569814016 : ℝ)*(z)^7 + (651374592 : ℝ)*(z)^8 + (-91238400 : ℝ)*(z)^9 + (6983680 : ℝ)*(z)^10 + (-270336 : ℝ)*(z)^11 + (4096 : ℝ)*(z)^12) =
        (148704742688776617984 : ℝ)*(z-24)^0 + (73722671658064089088 : ℝ)*(z-24)^1 + (16669494197450903552 : ℝ)*(z-24)^2 + (2268844027876073472 : ℝ)*(z-24)^3 + (206504835541970944 : ℝ)*(z-24)^4 + (13194690496069632 : ℝ)*(z-24)^5 + (603788542066688 : ℝ)*(z-24)^6 + (19782367199232 : ℝ)*(z-24)^7 + (454664736768 : ℝ)*(z-24)^8 + (6979399680 : ℝ)*(z-24)^9 + (64385024 : ℝ)*(z-24)^10 + (270336 : ℝ)*(z-24)^11 := by ring
    have h : 0 ≤ (2*z)^12-(-1 : ℝ)^12*((-4096 : ℝ)*(z)^1 + (8384512 : ℝ)*(z)^2 + (-354410496 : ℝ)*(z)^3 + (2504708096 : ℝ)*(z)^4 + (-5650022400 : ℝ)*(z)^5 + (5421678592 : ℝ)*(z)^6 + (-2569814016 : ℝ)*(z)^7 + (651374592 : ℝ)*(z)^8 + (-91238400 : ℝ)*(z)^9 + (6983680 : ℝ)*(z)^10 + (-270336 : ℝ)*(z)^11 + (4096 : ℝ)*(z)^12) := by
      rw [hid]
      positivity
    linarith only [h]

/-- Signed leading-monomial bounds through order twelve on the extended score ray. -/
theorem laplaceCoolingJet_signed_bounds_twelve {n : ℕ} (hn : n ≤ 12) {z : ℝ}
    (hz : 24 ≤ z) :
    0 ≤ (-1 : ℝ)^n*laplaceCoolingJet n 0 z ∧
      (-1 : ℝ)^n*laplaceCoolingJet n 0 z ≤ (2*z)^n := by
  by_cases h : n ≤ 10
  · exact laplaceCoolingJet_signed_bounds h (by linarith)
  · have he : n = 11 ∨ n = 12 := by omega
    rcases he with rfl | rfl
    · exact laplaceCoolingJet_11_bounds hz
    · exact laplaceCoolingJet_12_bounds hz

end
end HTGeometry
