import GaloisForLFunctions.HTGeometry.FixedFieldDichotomy
import GaloisForLFunctions.HTGeometry.CyclicSubgroupUnique

/-!
# A cyclic extension has at most one quadratic subextension

The degree of an intermediate field over the base is the index of its fixing subgroup, so two
quadratic subextensions have fixing subgroups of the same order.  In a cyclic group subgroups of the
same order coincide, and the Galois correspondence then identifies the two fields.

This is what pins the quadratic subextension of a Kummer extension to the one generated by the
square root of the radicand.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Classical

variable {F M : Type*} [Field F] [Field M] [Algebra F M] [FiniteDimensional F M] [IsGalois F M]

theorem finrank_eq_index_fixingSubgroup (K : IntermediateField F M) :
    Module.finrank F K = K.fixingSubgroup.index := by
  have h := finrank_fixedField_eq_index (F := F) (E := M) K.fixingSubgroup
  rwa [IsGalois.fixedField_fixingSubgroup] at h

/-- **A cyclic extension has at most one quadratic subextension.** -/
theorem eq_of_finrank_eq_two_of_isCyclic (hcyc : IsCyclic (M ≃ₐ[F] M))
    {K₁ K₂ : IntermediateField F M} (h1 : Module.finrank F K₁ = 2)
    (h2 : Module.finrank F K₂ = 2) : K₁ = K₂ := by
  have hi1 : K₁.fixingSubgroup.index = 2 := by
    rw [← finrank_eq_index_fixingSubgroup, h1]
  have hi2 : K₂.fixingSubgroup.index = 2 := by
    rw [← finrank_eq_index_fixingSubgroup, h2]
  have hc1 := Subgroup.card_mul_index K₁.fixingSubgroup
  have hc2 := Subgroup.card_mul_index K₂.fixingSubgroup
  rw [hi1] at hc1
  rw [hi2] at hc2
  have hcard : Nat.card K₁.fixingSubgroup = Nat.card K₂.fixingSubgroup := by omega
  have hsub : K₁.fixingSubgroup = K₂.fixingSubgroup := by
    refine subgroup_eq_of_card_eq ?_
    rwa [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
  have he1 := IsGalois.fixedField_fixingSubgroup (F := F) (E := M) K₁
  have he2 := IsGalois.fixedField_fixingSubgroup (F := F) (E := M) K₂
  rw [← he1, ← he2, hsub]

end GaloisForLFunctions.HTGeometry
