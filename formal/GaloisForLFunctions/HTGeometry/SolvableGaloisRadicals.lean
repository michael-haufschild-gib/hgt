import Mathlib.FieldTheory.AbelRuffini
import Mathlib.FieldTheory.KummerExtension
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import GaloisForLFunctions.HTGeometry.NormalClosureSheetAction

/-!
# Solvable Galois groups give radical extensions

The converse of Abel–Ruffini in characteristic zero: if the Galois group of the minimal polynomial
of an algebraic element is solvable, the element is solvable by radicals.

* A finite nontrivial solvable group has a proper normal subgroup with cyclic quotient: take a
  maximal proper normal subgroup; the quotient is simple and solvable, hence commutative, hence
  generated by any nontrivial element.
* **Induction core.**  Let `M/K` be finite Galois with solvable group of order dividing `n`, `K`
  containing a primitive `n`-th root of unity, and `φ : M → E` a ring map sending `K` into the
  radical closure of `F` in `E`.  The fixed field `K₁` of a proper normal subgroup with cyclic
  quotient is a cyclic extension of `K` of degree dividing `n`, so by Kummer theory `K₁ = K(α)` with
  `αᵏ ∈ K`; hence `φ(K₁)` consists of radicals, and `M/K₁` is a smaller instance.
* **Top level.**  Adjoin to the splitting field of the minimal polynomial a primitive `n`-th root of
  unity `ξ`, `n` its degree.  The splitting field of `p(Xⁿ - 1)` is Galois over `F(ξ)` with group
  embedded in the Galois group of `p`, so the induction core applies over `F(ξ)`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Polynomial

/-- **A finite nontrivial solvable group has a proper normal subgroup with cyclic quotient.** -/
theorem exists_normal_ne_top_isCyclic_quotient {G : Type*} [Group G] [Finite G] [IsSolvable G]
    [Nontrivial G] :
    ∃ (N : Subgroup G) (hN : N.Normal), N ≠ ⊤ ∧ (letI := hN; IsCyclic (G ⧸ N)) := by
  classical
  let S : Set (Subgroup G) := {N | N.Normal ∧ N ≠ ⊤}
  have hbot : (⊥ : Subgroup G) ∈ S := ⟨inferInstance, bot_ne_top⟩
  obtain ⟨N, hNmax⟩ := (Set.toFinite S).exists_maximal ⟨⊥, hbot⟩
  obtain ⟨hN, hNtop⟩ := hNmax.1
  haveI : N.Normal := hN
  haveI : Nontrivial (G ⧸ N) := QuotientGroup.nontrivial_iff.mpr hNtop
  haveI : IsSimpleGroup (G ⧸ N) := by
    refine ⟨fun H hH => ?_⟩
    let H' : Subgroup G := H.comap (QuotientGroup.mk' N)
    have hH' : H'.Normal := hH.comap _
    have hle : N ≤ H' := by
      intro x hx
      change (x : G ⧸ N) ∈ H
      rw [(QuotientGroup.eq_one_iff x).mpr hx]
      exact H.one_mem
    by_cases htop : H' = ⊤
    · right
      apply top_unique
      intro y _
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N y
      have hx : x ∈ H' := by rw [htop]; trivial
      exact hx
    · left
      have hHN : H' = N := le_antisymm (hNmax.2 ⟨hH', htop⟩ hle) hle
      apply le_antisymm _ bot_le
      intro y hy
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N y
      have hx : x ∈ H' := hy
      rw [hHN] at hx
      rw [Subgroup.mem_bot]
      exact (QuotientGroup.eq_one_iff x).mpr hx
  haveI : IsSolvable (G ⧸ N) := solvable_of_surjective (QuotientGroup.mk'_surjective N)
  have hcomm : ∀ a b : G ⧸ N, a * b = b * a :=
    IsSimpleGroup.comm_iff_isSolvable.mpr inferInstance
  obtain ⟨g, hg⟩ := exists_ne (1 : G ⧸ N)
  have hnormal : (Subgroup.zpowers g).Normal :=
    ⟨fun a ha b => by rwa [hcomm b a, mul_inv_cancel_right]⟩
  refine ⟨N, hN, hNtop, ⟨g, fun x => ?_⟩⟩
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal _ hnormal with h | h
  · exfalso
    have hgm : g ∈ Subgroup.zpowers g := Subgroup.mem_zpowers g
    rw [h, Subgroup.mem_bot] at hgm
    exact hg hgm
  · have hx : x ∈ Subgroup.zpowers g := by rw [h]; trivial
    exact hx

universe u

section Induction

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- A field generated over `K` by elements mapping to radicals maps into the radicals, once `K`
does. -/
theorem forall_map_mem_solvableByRad_of_adjoin {K L : Type*} [Field K] [Field L] [Algebra K L]
    (φ : L →+* E) (hK : ∀ c : K, φ (algebraMap K L c) ∈ solvableByRad F E) {s : Set L}
    (hs : IntermediateField.adjoin K s = ⊤) (hsR : ∀ y ∈ s, φ y ∈ solvableByRad F E) :
    ∀ y : L, φ y ∈ solvableByRad F E := by
  let T : IntermediateField K L :=
    ((solvableByRad F E).toSubfield.comap φ).toIntermediateField hK
  have hle : IntermediateField.adjoin K s ≤ T := by
    rw [IntermediateField.adjoin_le_iff]
    exact hsR
  intro y
  exact hle (hs.symm ▸ IntermediateField.mem_top)

/-- **Induction core of the converse of Abel–Ruffini.** -/
theorem forall_map_mem_solvableByRad (n : ℕ) (hn : n ≠ 0) :
    ∀ (d : ℕ) (K M : Type u) [Field K] [Field M] [Algebra K M] [FiniteDimensional K M]
      [IsGalois K M], Module.finrank K M = d → IsSolvable Gal(M/K) → d ∣ n →
      (∃ ζ : K, IsPrimitiveRoot ζ n) → ∀ φ : M →+* E,
      (∀ c : K, φ (algebraMap K M c) ∈ solvableByRad F E) → ∀ x : M, φ x ∈ solvableByRad F E := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro K M _ _ _ _ _ hd hsolv hdn hζ φ hK x
  have hcard : Nat.card Gal(M/K) = d := (IsGalois.card_aut_eq_finrank K M).trans hd
  by_cases hG : Nontrivial Gal(M/K)
  · obtain ⟨N, hN, hNtop, hcyc⟩ := exists_normal_ne_top_isCyclic_quotient (G := Gal(M/K))
    haveI := hN
    let K₁ := IntermediateField.fixedField N
    haveI : IsGalois K K₁ := IsGalois.of_fixedField_normal_subgroup N
    haveI : IsCyclic Gal(K₁/K) :=
      isCyclic_of_surjective (IsGalois.normalAutEquivQuotient N).toMonoidHom
        (IsGalois.normalAutEquivQuotient N).surjective
    have htower := Module.finrank_mul_finrank K K₁ M
    have hkd : Module.finrank K K₁ ∣ d := ⟨_, (htower.trans hd).symm⟩
    have hkn : Module.finrank K K₁ ∣ n := hkd.trans hdn
    have hk0 : Module.finrank K K₁ ≠ 0 := Module.finrank_pos.ne'
    obtain ⟨ζ, hζ⟩ := hζ
    have hζk : IsPrimitiveRoot (ζ ^ (n / Module.finrank K K₁)) (Module.finrank K K₁) := by
      have h := hζ.pow_of_dvd (Nat.div_ne_zero_iff_of_dvd hkn |>.mpr ⟨hn, hk0⟩)
        (Nat.div_dvd_of_dvd hkn)
      rwa [Nat.div_div_self hkn hn] at h
    obtain ⟨α, ⟨c, hc⟩, hα⟩ := exists_root_adjoin_eq_top_of_isCyclic K K₁
      ⟨_, (mem_primitiveRoots (Nat.pos_of_ne_zero hk0)).mpr hζk⟩
    have hK₁ : ∀ y : K₁, φ (algebraMap K₁ M y) ∈ solvableByRad F E := by
      refine forall_map_mem_solvableByRad_of_adjoin (φ.comp (algebraMap K₁ M))
        (fun c' => ?_) hα ?_
      · change φ (algebraMap K₁ M (algebraMap K K₁ c')) ∈ solvableByRad F E
        rw [← IsScalarTower.algebraMap_apply]
        exact hK c'
      · intro y hy
        rw [Set.mem_singleton_iff.mp hy]
        apply solvableByRad.rad_mem hk0
        change (φ (algebraMap K₁ M α)) ^ Module.finrank K K₁ ∈ solvableByRad F E
        rw [← map_pow, ← map_pow, ← hc, ← IsScalarTower.algebraMap_apply]
        exact hK c
    have hd1 : Module.finrank K₁ M = Nat.card N := IntermediateField.finrank_fixedField_eq_card N
    have hNcard : Nat.card N ∣ d := hcard ▸ N.card_subgroup_dvd_card
    have hlt : Nat.card N < d := by
      have hidx := N.index_mul_card
      rw [hcard] at hidx
      have hidx1 : N.index ≠ 1 := fun h => hNtop (Subgroup.index_eq_one.mp h)
      have hd0 : d ≠ 0 := by rw [← hcard]; exact Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
      have hidx0 : N.index ≠ 0 := by
        intro h0
        rw [h0, zero_mul] at hidx
        exact hd0 hidx.symm
      have hc0 : Nat.card N ≠ 0 := by
        intro h0
        rw [h0, mul_zero] at hidx
        exact hd0 hidx.symm
      calc Nat.card N = 1 * Nat.card N := (one_mul _).symm
        _ < N.index * Nat.card N :=
          Nat.mul_lt_mul_of_pos_right (by omega) (Nat.pos_of_ne_zero hc0)
        _ = d := hidx
    haveI : IsSolvable ↥(K₁.fixingSubgroup) := by
      rw [IntermediateField.fixingSubgroup_fixedField]
      exact subgroup_solvable_of_solvable N
    have hsolv1 : IsSolvable Gal(M/K₁) :=
      solvable_of_surjective (f := (IntermediateField.fixingSubgroupEquiv K₁).toMonoidHom)
        (IntermediateField.fixingSubgroupEquiv K₁).surjective
    exact ih _ hlt K₁ M hd1 hsolv1 (hNcard.trans hdn)
      ⟨_, hζ.map_of_injective (algebraMap K K₁).injective⟩ φ hK₁ x
  · have hd1 : d = 1 := by
      rw [← hcard]
      exact Nat.card_eq_one_iff_unique.mpr ⟨not_nontrivial_iff_subsingleton.mp hG, inferInstance⟩
    have hbot : (⊥ : Subalgebra K M) = ⊤ := Subalgebra.bot_eq_top_of_finrank_eq_one (hd.trans hd1)
    have hx : x ∈ (⊥ : Subalgebra K M) := hbot ▸ Algebra.mem_top
    obtain ⟨c, rfl⟩ := Algebra.mem_bot.mp hx
    exact hK c

end Induction

/-- **Converse of Abel–Ruffini.**  Over a field of characteristic zero, an algebraic element whose
minimal polynomial has solvable Galois group is solvable by radicals. -/
theorem mem_solvableByRad_of_isSolvable_gal_minpoly {F : Type u} {E : Type*} [Field F] [Field E]
    [Algebra F E] [CharZero F] [IsAlgClosed E] {α : E} (hα : IsIntegral F α)
    (hsolv : IsSolvable (minpoly F α).Gal) : α ∈ solvableByRad F E := by
  classical
  set p := minpoly F α with hpdef
  have hp0 : p ≠ 0 := minpoly.ne_zero hα
  set n := Module.finrank F p.SplittingField with hndef
  have hn : n ≠ 0 := Module.finrank_pos.ne'
  haveI : NeZero n := ⟨hn⟩
  set q := p * (X ^ n - 1) with hqdef
  have hX0 : (X ^ n - 1 : F[X]) ≠ 0 := by
    simpa using X_pow_sub_C_ne_zero (R := F) (Nat.pos_of_ne_zero hn) 1
  have hq0 : q ≠ 0 := mul_ne_zero hp0 hX0
  let M := q.SplittingField
  haveI : Normal F M := Normal.of_isSplittingField q
  haveI : IsGalois F M := ⟨⟩
  have hsolvM : IsSolvable Gal(M/F) := gal_mul_isSolvable hsolv (gal_X_pow_sub_one_isSolvable n)
  have hsplitq : (q.map (algebraMap F M)).Splits := SplittingField.splits q
  have hqM0 : q.map (algebraMap F M) ≠ 0 := Polynomial.map_ne_zero hq0
  have hsplitp : (p.map (algebraMap F M)).Splits :=
    hsplitq.of_dvd hqM0 (Polynomial.map_dvd _ (dvd_mul_right p _))
  have hsplitX : ((X ^ n - 1 : F[X]).map (algebraMap F M)).Splits :=
    hsplitq.of_dvd hqM0 (Polynomial.map_dvd _ (dvd_mul_left _ p))
  -- a primitive `n`-th root of unity in `M`
  have hXM0 : ((X ^ n - 1 : F[X]).map (algebraMap F M)) ≠ 0 := Polynomial.map_ne_zero hX0
  have hsplitC : ((cyclotomic n F).map (algebraMap F M)).Splits :=
    hsplitX.of_dvd hXM0 (Polynomial.map_dvd _ (cyclotomic.dvd_X_pow_sub_one n F))
  have hdegC : ((cyclotomic n F).map (algebraMap F M)).degree ≠ 0 := by
    rw [Polynomial.degree_map]
    exact (degree_cyclotomic_pos n F (Nat.pos_of_ne_zero hn)).ne'
  obtain ⟨ξ, hξroot⟩ := hsplitC.exists_eval_eq_zero hdegC
  have hξ : IsPrimitiveRoot ξ n := by
    rw [← isRoot_cyclotomic_iff, ← map_cyclotomic n (algebraMap F M)]
    exact hξroot
  let K₀ : IntermediateField F M := IntermediateField.adjoin F (Set.range fun _ : Unit => ξ)
  have hξK₀ : ξ ∈ K₀ := IntermediateField.subset_adjoin F _ ⟨(), rfl⟩
  let N₀ : IntermediateField F M := IntermediateField.adjoin F (p.rootSet M)
  haveI : IsSplittingField F N₀ p := IntermediateField.adjoin_rootSet_isSplittingField hsplitp
  haveI : Normal F N₀ := Normal.of_isSplittingField p
  haveI : IsGalois F N₀ := ⟨⟩
  -- `N₀` and `K₀` generate `M`
  have hsup : N₀ ⊔ K₀ = ⊤ := by
    have htop : ∀ y : M, y ∈ IntermediateField.adjoin F (q.rootSet M) := fun y =>
      IntermediateField.algebra_adjoin_le_adjoin F _
        ((IsSplittingField.adjoin_rootSet M q).symm ▸ Algebra.mem_top)
    have hle : IntermediateField.adjoin F (q.rootSet M) ≤ N₀ ⊔ K₀ := by
      rw [IntermediateField.adjoin_le_iff]
      intro y hy
      rw [Polynomial.mem_rootSet] at hy
      have hy' : aeval y p * aeval y (X ^ n - 1 : F[X]) = 0 := by
        rw [← map_mul]
        exact hy.2
      rcases mul_eq_zero.mp hy' with hyp | hyX
      · apply le_sup_left (a := N₀)
        apply IntermediateField.subset_adjoin F
        rw [Polynomial.mem_rootSet]
        exact ⟨hp0, hyp⟩
      · apply le_sup_right (b := K₀)
        have hyn : y ^ n = 1 := by
          simpa [sub_eq_zero] using hyX
        obtain ⟨i, -, hi⟩ := hξ.eq_pow_of_pow_eq_one hyn
        rw [← hi]
        exact pow_mem hξK₀ i
    apply top_unique
    intro y _
    exact hle (htop y)
  -- the Galois group over `K₀` embeds in that of `N₀`
  haveI : IsGalois K₀ M := IsGalois.tower_top_intermediateField K₀
  have hdiv : Module.finrank K₀ M ∣ n := by
    rw [← IsGalois.card_aut_eq_finrank]
    have h1 := Subgroup.card_dvd_of_injective _
      (IntermediateField.restrictRestrictAlgEquivMapHom_injective N₀ K₀ hsup)
    have h2 : Nat.card Gal(N₀/F) = n := by
      rw [IsGalois.card_aut_eq_finrank, hndef]
      exact (IsSplittingField.algEquiv N₀ p).toLinearEquiv.finrank_eq
    rwa [h2] at h1
  haveI : IsSolvable ↥K₀.fixingSubgroup := subgroup_solvable_of_solvable _
  have hsolv0 : IsSolvable Gal(M/K₀) :=
    solvable_of_surjective (f := (IntermediateField.fixingSubgroupEquiv K₀).toMonoidHom)
      (IntermediateField.fixingSubgroupEquiv K₀).surjective
  -- an embedding into `E`, which sends `K₀` to radicals
  let φ : M →ₐ[F] E := IsAlgClosed.lift
  have hbase : ∀ c : K₀, (φ : M →+* E) (algebraMap K₀ M c) ∈ solvableByRad F E := by
    refine forall_map_mem_solvableByRad_of_adjoin ((φ : M →+* E).comp (algebraMap K₀ M))
      (fun c => ?_) (adjoin_range_restrict_eq_top (K := F) (fun _ : Unit => ξ)) ?_
    · change φ (algebraMap K₀ M (algebraMap F K₀ c)) ∈ solvableByRad F E
      rw [← IsScalarTower.algebraMap_apply, φ.commutes]
      exact (solvableByRad F E).algebraMap_mem c
    · rintro _ ⟨u, rfl⟩
      apply solvableByRad.rad_mem hn
      change (φ ξ) ^ n ∈ solvableByRad F E
      rw [← map_pow, hξ.pow_eq_one, map_one]
      exact (solvableByRad F E).one_mem
  have hall := forall_map_mem_solvableByRad (F := F) (E := E) n hn _ K₀ M rfl hsolv0 hdiv
    ⟨⟨ξ, hξK₀⟩, IsPrimitiveRoot.coe_submonoidClass_iff.mp hξ⟩ (φ : M →+* E) hbase
  -- `α` is the image of a root of `p` in `M`
  have hroot : α ∈ p.rootSet E := by
    rw [Polynomial.mem_rootSet]
    exact ⟨hp0, minpoly.aeval F α⟩
  rw [← hsplitp.image_rootSet φ] at hroot
  obtain ⟨β, -, hβ⟩ := hroot
  rw [← hβ]
  exact hall β

end

end GaloisForLFunctions.HTGeometry
