import GaloisForLFunctions.HTGeometry.GammaDifferentialFE

/-!
# The reciprocal jet polynomials

If `g` is a nonvanishing function and `f = 1/g`, every derivative of `f` is a rational function of
the jet of `g` with denominator a power of `g`:

`f⁽ʲ⁾ · g^{j+1} = A_j(g, g', …, g⁽ʲ⁾)`,

where the numerators are generated by `A_0 = 1` and `A_{j+1} = D(A_j)·X₀ − (j+1)·A_j·X₁`, with `D`
the jet derivation `X_i ↦ X_{i+1}`.  These are the polynomials that transport an algebraic
differential equation from a function to its reciprocal.

The arity is fixed at `Fin (N+2)` and the recursion is run only up to `j ≤ N`; the key bookkeeping
lemma is that `A_j` involves no variable above `X_j`, so the jet chain rule closes inside the fixed
arity.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

/-! ## Commuting partial derivations -/

theorem pderiv_comm {n : ℕ} (i j : Fin n) (Q : MvPolynomial (Fin n) ℂ) :
    pderiv i (pderiv j Q) = pderiv j (pderiv i Q) := by
  classical
  have hconst : ∀ a b c : Fin n,
      pderiv a ((Pi.single b 1 : Fin n → MvPolynomial (Fin n) ℂ) c) = 0 := by
    intro a b c
    rw [Pi.single_apply]
    split
    · rw [pderiv_one]
    · rw [map_zero]
  induction Q using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p l hp =>
      simp only [Derivation.leibniz, pderiv_X, map_add, smul_eq_mul, hconst, mul_zero,
        zero_add]
      rw [hp]
      ring

/-! ## The jet derivation -/

/-- The jet derivation `X_i ↦ X_{i+1}` on a fixed arity, truncated at the top variable. -/
def jetShiftDeriv (N : ℕ) (Q : MvPolynomial (Fin (N + 2)) ℂ) : MvPolynomial (Fin (N + 2)) ℂ :=
  ∑ i : Fin (N + 1), (pderiv i.castSucc Q) * X i.succ

/-! ## The reciprocal numerators -/

/-- The reciprocal jet numerators `A_j`, with `A_0 = 1` and
`A_{j+1} = D(A_j)·X₀ − (j+1)·A_j·X₁`. -/
def recipNum (N : ℕ) : ℕ → MvPolynomial (Fin (N + 2)) ℂ
  | 0 => 1
  | j + 1 => jetShiftDeriv N (recipNum N j) * X 0 - C ((j : ℂ) + 1) * recipNum N j * X 1

@[simp] theorem recipNum_zero (N : ℕ) : recipNum N 0 = 1 := rfl

theorem recipNum_succ (N : ℕ) (j : ℕ) :
    recipNum N (j + 1)
      = jetShiftDeriv N (recipNum N j) * X 0 - C ((j : ℂ) + 1) * recipNum N j * X 1 := rfl

/-! ## The support bookkeeping -/

theorem pderiv_jetShiftDeriv_top (N : ℕ) {Q : MvPolynomial (Fin (N + 2)) ℂ} {k : ℕ}
    (hQ : ∀ i : Fin (N + 2), k < (i : ℕ) → pderiv i Q = 0) :
    ∀ i : Fin (N + 2), k + 1 < (i : ℕ) → pderiv i (jetShiftDeriv N Q) = 0 := by
  intro i hi
  rw [jetShiftDeriv, map_sum]
  refine Finset.sum_eq_zero fun m _ => ?_
  rw [Derivation.leibniz, pderiv_X]
  have h1 : pderiv i (pderiv m.castSucc Q) = 0 := by
    rw [pderiv_comm, hQ i (by omega), map_zero]
  have h2 : (pderiv m.castSucc Q)
      * ((Pi.single i 1 : Fin (N + 2) → MvPolynomial (Fin (N + 2)) ℂ) m.succ) = 0 := by
    by_cases hEq : (i : Fin (N + 2)) = m.succ
    · have hm : k < ((m.castSucc : Fin (N + 2)) : ℕ) := by
        have hval : (i : ℕ) = (m : ℕ) + 1 := by
          rw [hEq]
          simp
        simp only [Fin.val_castSucc]
        omega
      rw [hQ m.castSucc hm, zero_mul]
    · have hz : (Pi.single i 1 : Fin (N + 2) → MvPolynomial (Fin (N + 2)) ℂ) m.succ = 0 := by
        simp [hEq]
      exact mul_eq_zero_of_right _ hz
  simp only [smul_eq_mul, h1, mul_zero]
  simpa using h2

theorem pderiv_recipNum_top (N : ℕ) : ∀ j : ℕ, j ≤ N →
    ∀ i : Fin (N + 2), j < (i : ℕ) → pderiv i (recipNum N j) = 0 := by
  intro j
  induction j with
  | zero =>
      intro _ i _
      rw [recipNum_zero, pderiv_one]
  | succ j ih =>
      intro hj i hi
      have hjN : j ≤ N := by omega
      have hprev := ih hjN
      rw [recipNum_succ, map_sub]
      have hA : pderiv i (jetShiftDeriv N (recipNum N j) * X 0) = 0 := by
        rw [Derivation.leibniz, pderiv_X]
        have h1 : pderiv i (jetShiftDeriv N (recipNum N j)) = 0 :=
          pderiv_jetShiftDeriv_top N hprev i (by omega)
        have h2 : (Pi.single i 1 : Fin (N + 2) → MvPolynomial (Fin (N + 2)) ℂ) 0 = 0 := by
          have hne : (0 : Fin (N + 2)) ≠ i := by
            intro hEq
            rw [← hEq] at hi
            simp at hi
          simp [hne]
        simp only [smul_eq_mul, h1, mul_zero]
        rw [h2, mul_zero, add_zero]
      have hB : pderiv i (C ((j : ℂ) + 1) * recipNum N j * X 1) = 0 := by
        rw [Derivation.leibniz, pderiv_X, Derivation.leibniz, pderiv_C]
        have h1 : pderiv i (recipNum N j) = 0 := hprev i (by omega)
        have h2 : (Pi.single i 1 : Fin (N + 2) → MvPolynomial (Fin (N + 2)) ℂ) 1 = 0 := by
          have hne : (1 : Fin (N + 2)) ≠ i := by
            intro hEq
            rw [← hEq] at hi
            have hval : ((1 : Fin (N + 2)) : ℕ) = 1 := by simp
            rw [hval] at hi
            omega
          simp [hne]
        simp only [smul_eq_mul, h1, mul_zero, add_zero]
        rw [h2, mul_zero]
      rw [hA, hB, sub_zero]

/-! ## The jet identity for a reciprocal -/

theorem eval_jetShiftDeriv (N : ℕ) (Q : MvPolynomial (Fin (N + 2)) ℂ) (g : ℂ → ℂ) (z : ℂ)
    (hQ : pderiv (Fin.last (N + 1)) Q = 0) :
    eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z) (jetShiftDeriv N Q)
      = ∑ i : Fin (N + 2),
          eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z) (pderiv i Q)
            * iteratedDeriv ((i : ℕ) + 1) g z := by
  rw [jetShiftDeriv, map_sum, Fin.sum_univ_castSucc (n := N + 1)]
  have hlast : eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z)
      (pderiv (Fin.last (N + 1)) Q) * iteratedDeriv ((Fin.last (N + 1) : ℕ) + 1) g z = 0 := by
    rw [hQ, map_zero, zero_mul]
  rw [hlast, add_zero]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_mul, eval_X]
  congr 1

/-- **The reciprocal jet identity.** -/
theorem recipNum_eval (N : ℕ) {g f : ℂ → ℂ} {U : Set ℂ} (hU : IsOpen U)
    (hgd : ∀ k : ℕ, ∀ z ∈ U, HasDerivAt (iteratedDeriv k g) (iteratedDeriv (k + 1) g z) z)
    (hfd : ∀ k : ℕ, ∀ z ∈ U, HasDerivAt (iteratedDeriv k f) (iteratedDeriv (k + 1) f z) z)
    (hinv : ∀ z ∈ U, f z * g z = 1) :
    ∀ j : ℕ, j ≤ N → ∀ z ∈ U,
      iteratedDeriv j f z * (g z) ^ (j + 1)
        = eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z) (recipNum N j) := by
  intro j
  induction j with
  | zero =>
      intro _ z hz
      rw [recipNum_zero, map_one, iteratedDeriv_zero, pow_one]
      exact hinv z hz
  | succ j ih =>
      intro hj z hz
      have hjN : j ≤ N := by omega
      have hIH := ih hjN
      have hev : (fun w => iteratedDeriv j f w * (g w) ^ (j + 1))
          =ᶠ[nhds z] fun w =>
            eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g w) (recipNum N j) := by
        filter_upwards [hU.mem_nhds hz] with w hw
        exact hIH w hw
      have hg0 : HasDerivAt g (iteratedDeriv 1 g z) z := by
        have h := hgd 0 z hz
        rw [iteratedDeriv_zero] at h
        exact h
      have hLeft : HasDerivAt (fun w => iteratedDeriv j f w * (g w) ^ (j + 1))
          (iteratedDeriv (j + 1) f z * (g z) ^ (j + 1)
            + iteratedDeriv j f z
              * ((((j + 1 : ℕ)) : ℂ) * (g z) ^ (j + 1 - 1) * iteratedDeriv 1 g z)) z :=
        (hfd j z hz).mul (hg0.pow (j + 1))
      have hRight : HasDerivAt
          (fun w => eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g w) (recipNum N j))
          (∑ i : Fin (N + 2),
            eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z) (pderiv i (recipNum N j))
              * iteratedDeriv ((i : ℕ) + 1) g z) z :=
        hasDerivAt_mvEval_jet (recipNum N j)
          (fun i => fun w => iteratedDeriv (i : ℕ) g w)
          (fun i => iteratedDeriv ((i : ℕ) + 1) g z) z (fun i => hgd (i : ℕ) z hz)
      have hlastzero : pderiv (Fin.last (N + 1)) (recipNum N j) = 0 := by
        refine pderiv_recipNum_top N j hjN (Fin.last (N + 1)) ?_
        have hv : ((Fin.last (N + 1) : Fin (N + 2)) : ℕ) = N + 1 := rfl
        omega
      have hderiv : iteratedDeriv (j + 1) f z * (g z) ^ (j + 1)
            + iteratedDeriv j f z
              * ((((j + 1 : ℕ)) : ℂ) * (g z) ^ (j + 1 - 1) * iteratedDeriv 1 g z)
          = eval (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) g z)
              (jetShiftDeriv N (recipNum N j)) := by
        rw [eval_jetShiftDeriv N (recipNum N j) g z hlastzero, ← hLeft.deriv, ← hRight.deriv,
          hev.deriv_eq]
      have hIHz := hIH z hz
      have hi0 : iteratedDeriv ((0 : Fin (N + 2)) : ℕ) g z = g z := by
        show iteratedDeriv 0 g z = g z
        rw [iteratedDeriv_zero]
      have hi1 : iteratedDeriv ((1 : Fin (N + 2)) : ℕ) g z = iteratedDeriv 1 g z := by
        congr 1
      rw [recipNum_succ, map_sub, map_mul, map_mul, map_mul, eval_C, eval_X, eval_X, hi0, hi1]
      have hmul := congrArg (fun x : ℂ => x * g z) hderiv
      have hsimp : (j + 1 : ℕ) - 1 = j := by omega
      rw [hsimp] at hmul
      push_cast at hmul
      linear_combination hmul - ((j : ℂ) + 1) * iteratedDeriv 1 g z * hIHz

/-! ## The numerators are nonzero -/

theorem iteratedDeriv_cexp (k : ℕ) : iteratedDeriv k Complex.exp = Complex.exp := by
  induction k with
  | zero => rw [iteratedDeriv_zero]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext z
      exact (Complex.hasDerivAt_exp z).deriv

theorem hasDerivAt_iteratedDeriv_cexp (k : ℕ) (z : ℂ) :
    HasDerivAt (iteratedDeriv k Complex.exp) (iteratedDeriv (k + 1) Complex.exp z) z := by
  rw [iteratedDeriv_cexp, iteratedDeriv_cexp]
  exact Complex.hasDerivAt_exp z

theorem hasDerivAt_cexp_neg (z : ℂ) :
    HasDerivAt (fun w : ℂ => Complex.exp (-w)) (-Complex.exp (-z)) z := by
  have hneg : HasDerivAt (fun w : ℂ => -w) (-1 : ℂ) z := (hasDerivAt_id z).neg
  have h := (Complex.hasDerivAt_exp (-z)).comp z hneg
  simpa [Function.comp_def] using h

theorem iteratedDeriv_cexp_neg (k : ℕ) :
    iteratedDeriv k (fun w : ℂ => Complex.exp (-w))
      = fun w : ℂ => (-1 : ℂ) ^ k * Complex.exp (-w) := by
  induction k with
  | zero =>
      rw [iteratedDeriv_zero]
      funext w
      rw [pow_zero, one_mul]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext z
      have h : HasDerivAt (fun w : ℂ => (-1 : ℂ) ^ k * Complex.exp (-w))
          ((-1 : ℂ) ^ k * (-Complex.exp (-z))) z := (hasDerivAt_cexp_neg z).const_mul _
      rw [h.deriv]
      ring

theorem hasDerivAt_iteratedDeriv_cexp_neg (k : ℕ) (z : ℂ) :
    HasDerivAt (iteratedDeriv k (fun w : ℂ => Complex.exp (-w)))
      (iteratedDeriv (k + 1) (fun w : ℂ => Complex.exp (-w)) z) z := by
  have h2 : iteratedDeriv (k + 1) (fun w : ℂ => Complex.exp (-w)) z
      = (-1 : ℂ) ^ k * (-Complex.exp (-z)) := by
    rw [iteratedDeriv_cexp_neg]
    ring
  rw [h2, iteratedDeriv_cexp_neg]
  exact (hasDerivAt_cexp_neg z).const_mul _

/-- **The reciprocal numerators are nonzero.**  Testing the jet identity on the exponential pair
`g = exp`, `f = exp(−·)` at the origin evaluates `A_j` to `(−1)ʲ`. -/
theorem recipNum_ne_zero (N : ℕ) {j : ℕ} (hj : j ≤ N) : recipNum N j ≠ 0 := by
  have hkey := recipNum_eval N (g := Complex.exp) (f := fun w : ℂ => Complex.exp (-w))
    (U := Set.univ) isOpen_univ
    (fun k z _ => hasDerivAt_iteratedDeriv_cexp k z)
    (fun k z _ => hasDerivAt_iteratedDeriv_cexp_neg k z)
    (fun z _ => by
      rw [← Complex.exp_add]
      simp)
    j hj 0 (Set.mem_univ 0)
  have hjet : (fun i : Fin (N + 2) => iteratedDeriv (i : ℕ) Complex.exp 0)
      = fun _ : Fin (N + 2) => (1 : ℂ) := by
    funext i
    rw [iteratedDeriv_cexp]
    simp
  rw [hjet] at hkey
  have hleft : iteratedDeriv j (fun w : ℂ => Complex.exp (-w)) 0 * Complex.exp 0 ^ (j + 1)
      = (-1 : ℂ) ^ j := by
    rw [iteratedDeriv_cexp_neg]
    simp
  rw [hleft] at hkey
  intro h0
  rw [h0, map_zero] at hkey
  exact (pow_ne_zero j (by norm_num : (-1 : ℂ) ≠ 0)) hkey

end

end GaloisForLFunctions.HTGeometry
