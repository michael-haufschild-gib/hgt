import Mathlib.Topology.Algebra.Algebra

/-!
# One-atom Runge absorption

Runge approximation on the upper half-plane says that the polynomial algebra generated by one
Cauchy coordinate `r(z) = (λ-z)⁻¹` is compact-open dense in the holomorphic function algebra: the
coordinate is a biholomorphism of the half-plane and ordinary polynomial Runge approximation
applies after conjugation.  That classical analytic theorem is represented below by the exact
input `OneGeneratorRungeDense`.

The new deduction needed by the HT paper is purely topological-algebraic: once one generator is
dense, adjoining any collection of extra carriers cannot produce a smaller completion.  Thus a
compact-open completion that already contains one such atom is the entire ambient holomorphic
algebra, not a chamber-sensitive invariant.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Exact interface for the classical one-coordinate Runge theorem in an ambient topological
algebra. -/
def OneGeneratorRungeDense
    (C A : Type*) [CommSemiring C] [Semiring A] [Algebra C A]
    [TopologicalSpace A] [IsTopologicalSemiring A] (r : A) : Prop :=
  (Algebra.adjoin C ({r} : Set A)).topologicalClosure = ⊤

/-- **Dense-generator absorption.**  Every subalgebra containing a Runge-dense generator is itself
dense. -/
theorem subalgebra_topologicalClosure_eq_top_of_oneGeneratorRungeDense
    {C A : Type*} [CommSemiring C] [Semiring A] [Algebra C A]
    [TopologicalSpace A] [IsTopologicalSemiring A]
    (r : A) (hr : OneGeneratorRungeDense C A r)
    (B : Subalgebra C A) (hrB : r ∈ B) :
    B.topologicalClosure = ⊤ := by
  have hle : Algebra.adjoin C ({r} : Set A) ≤ B := by
    apply Algebra.adjoin_le
    intro x hx
    simpa only [Set.mem_singleton_iff] using hx ▸ hrB
  have hclosure := Subalgebra.topologicalClosure_mono hle
  rw [hr] at hclosure
  exact top_unique hclosure

/-- Adjoining an arbitrary set of extra generators to a Runge-dense atom still has the full
ambient completion. -/
theorem adjoin_insert_topologicalClosure_eq_top_of_oneGeneratorRungeDense
    {C A : Type*} [CommSemiring C] [Semiring A] [Algebra C A]
    [TopologicalSpace A] [IsTopologicalSemiring A]
    (r : A) (E : Set A) (hr : OneGeneratorRungeDense C A r) :
    (Algebra.adjoin C (insert r E)).topologicalClosure = ⊤ := by
  apply subalgebra_topologicalClosure_eq_top_of_oneGeneratorRungeDense r hr
  exact Algebra.subset_adjoin (Set.mem_insert r E)

/-- Any two completed carrier algebras containing the same Runge-dense atom coincide, regardless
of their additional generators. -/
theorem completed_adjoins_equal_of_common_oneGeneratorRungeDense
    {C A : Type*} [CommSemiring C] [Semiring A] [Algebra C A]
    [TopologicalSpace A] [IsTopologicalSemiring A]
    (r : A) (E F : Set A) (hr : OneGeneratorRungeDense C A r) :
    (Algebra.adjoin C (insert r E)).topologicalClosure =
      (Algebra.adjoin C (insert r F)).topologicalClosure := by
  rw [adjoin_insert_topologicalClosure_eq_top_of_oneGeneratorRungeDense r E hr,
    adjoin_insert_topologicalClosure_eq_top_of_oneGeneratorRungeDense r F hr]

end

end GaloisForLFunctions.HTGeometry
