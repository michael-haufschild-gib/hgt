import GaloisForLFunctions.HTGeometry.MeromorphicGermTameSymbol
import GaloisForLFunctions.HTGeometry.MilnorKDegTwoSymbol
import Mathlib.GroupTheory.OrderOfElement

/-!
# A fixed-clock integer degree on the meromorphic K2 source

Constant/germ symbols are divisible by every positive integer in the full complex germ K2.
Every additive map from that ambient group to the integers therefore kills them. Retaining a
fixed non-torsion clock gives a different source: the subgroup whose actual tame boundary lies
in the cyclic group generated by that clock. It has an integer degree, split by `{clock,z}`.
The degree cannot extend to the full ambient group.
-/

namespace GaloisForLFunctions.HTGeometry
noncomputable section

/-- An explicit complex unit root; no algebraic extension is needed in the ambient field. -/
def complexUnitRoot (c : ℂˣ) (n : ℕ) : ℂˣ :=
  Units.mk0 (Complex.exp (Complex.log (c : ℂ) / (n : ℂ))) (Complex.exp_ne_zero _)

theorem complexUnitRoot_pow (c : ℂˣ) {n : ℕ} (hn : n ≠ 0) :
    complexUnitRoot c n ^ n = c := by
  apply Units.ext
  change Complex.exp (Complex.log (c : ℂ) / (n : ℂ)) ^ n = (c : ℂ)
  rw [← Complex.exp_nat_mul]
  have he : (n : ℂ) * (Complex.log (c : ℂ) / (n : ℂ)) = Complex.log (c : ℂ) := by
    field_simp
  rw [he, Complex.exp_log c.ne_zero]

/-- Every constant/germ symbol is infinitely divisible in the full ambient Milnor K2. -/
theorem constantMeroSymbol_divisible (c : ℂˣ) (b : MeroGermˣ) {n : ℕ} (hn : n ≠ 0) :
    ∃ y : MilnorKDeg MeroGerm 2,
      n • y = milnorSym2 MeroGerm (milnorUnitMap constGerm c) b := by
  refine ⟨milnorSym2 MeroGerm (milnorUnitMap constGerm (complexUnitRoot c n)) b, ?_⟩
  change n • (milnorSym2LeftHom b) (Additive.ofMul
    (milnorUnitMap constGerm (complexUnitRoot c n))) = _
  rw [← map_nsmul]
  change milnorSym2 MeroGerm ((milnorUnitMap constGerm (complexUnitRoot c n)) ^ n) b = _
  rw [← map_pow, complexUnitRoot_pow c hn]

/-- An integer divisible by every positive natural number is zero. -/
theorem int_eq_zero_of_forall_nsmul (k : ℤ)
    (h : ∀ n : ℕ, n ≠ 0 → ∃ j : ℤ, n • j = k) : k = 0 := by
  obtain ⟨j, hj⟩ := h (k.natAbs + 1) (by omega)
  have hd : ((k.natAbs + 1 : ℕ) : ℤ) ∣ k := by
    refine ⟨j, ?_⟩
    simpa only [nsmul_eq_mul] using hj.symm
  apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hd
  rw [Int.natAbs_natCast]
  omega

/-- No additive integer readout on the full ambient K2 can retain a constant/germ symbol. -/
theorem constantMeroSymbol_integerHom_zero
    (F : MilnorKDeg MeroGerm 2 →+ ℤ) (c : ℂˣ) (b : MeroGermˣ) :
    F (milnorSym2 MeroGerm (milnorUnitMap constGerm c) b) = 0 := by
  apply int_eq_zero_of_forall_nsmul
  intro n hn
  obtain ⟨y, hy⟩ := constantMeroSymbol_divisible c b hn
  refine ⟨F y, ?_⟩
  rw [← map_nsmul, hy]

/-- The genuine local coordinate as a meromorphic unit. -/
def meroGermCoordinateUnit : MeroGermˣ :=
  meroGermUnitOf id analyticAt_id.meromorphicAt
    (by rw [meromorphicOrderAt_id]; exact WithTop.coe_ne_top)

theorem meroGermCoordinateUnit_order : meroGermUnitOrder meroGermCoordinateUnit = 1 := by
  apply WithTop.coe_injective
  rw [meroGermCoordinateUnit, meroGermUnitOf_order, meromorphicOrderAt_id]
  rfl

/-- The concrete tame boundary of a constant/germ symbol. -/
theorem constantMeroSymbol_boundary (c : ℂˣ) (b : MeroGermˣ) :
    meroGermTameBoundary (milnorSym2 MeroGerm (milnorUnitMap constGerm c) b) =
      Additive.ofMul (c ^ meroGermUnitOrder b) := by
  apply Additive.toMul.injective
  apply Units.ext
  change meroGermTameBoundaryValue
    (milnorSym2 MeroGerm (milnorUnitMap constGerm c) b) = _
  rw [milnorSym2, meroGermTameBoundaryValue_symbol_of_limit _ _ c.ne_zero
    (MeroGerm.hasLimit_const (c : ℂ))]
  change (c : ℂ) ^ meroGermUnitOrder b = ((c ^ meroGermUnitOrder b : ℂˣ) : ℂ)
  push_cast
  rfl

/-- Retain the fixed clock: only classes with boundary in its integer powers are admitted. -/
def markedTameK2 (c : ℂˣ) : AddSubgroup (MilnorKDeg MeroGerm 2) where
  carrier := {x | ∃ n : ℤ, meroGermTameBoundary x = Additive.ofMul (c ^ n)}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨n, hn⟩ ⟨m, hm⟩
    refine ⟨n + m, ?_⟩
    rw [map_add, hn, hm, zpow_add]
    rfl
  neg_mem' := by
    rintro x ⟨n, hn⟩
    refine ⟨-n, ?_⟩
    rw [map_neg, hn, zpow_neg]
    rfl

/-- Boundary exponent in the retained clock. Uniqueness will use its infinite order. -/
def markedTameExponent (c : ℂˣ) (x : markedTameK2 c) : ℤ := x.property.choose

theorem markedTameExponent_spec (c : ℂˣ) (x : markedTameK2 c) :
    meroGermTameBoundary x.val = Additive.ofMul (c ^ markedTameExponent c x) :=
  x.property.choose_spec

theorem markedTameExponent_eq (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n))
    (x : markedTameK2 c) (n : ℤ)
    (h : meroGermTameBoundary x.val = Additive.ofMul (c ^ n)) :
    markedTameExponent c x = n :=
  hc (congrArg Additive.toMul ((markedTameExponent_spec c x).symm.trans h))

/-- Integer degree on the actual subgroup of K2 with a fixed infinite-order clock. -/
def markedTameDegree (c : ℂˣ) (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    markedTameK2 c →+ ℤ where
  toFun := markedTameExponent c
  map_zero' := markedTameExponent_eq c hc 0 0 (by simp)
  map_add' x y := by
    apply markedTameExponent_eq c hc (x + y) _
    change meroGermTameBoundary (x.val + y.val) = _
    rw [map_add, markedTameExponent_spec, markedTameExponent_spec, zpow_add]
    rfl

/-- Every constant-clock/germ symbol lies in the retained source subgroup. -/
def markedTameSymbol (c : ℂˣ) (b : MeroGermˣ) : markedTameK2 c :=
  ⟨milnorSym2 MeroGerm (milnorUnitMap constGerm c) b,
    meroGermUnitOrder b, constantMeroSymbol_boundary c b⟩

/-- Its integer degree is the full signed meromorphic multiplicity. -/
theorem markedTameDegree_symbol (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) (b : MeroGermˣ) :
    markedTameDegree c hc (markedTameSymbol c b) = meroGermUnitOrder b :=
  markedTameExponent_eq c hc _ _ (constantMeroSymbol_boundary c b)

/-- The coordinate supplies a primitive degree-one source class. -/
theorem markedTameDegree_coordinate (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    markedTameDegree c hc (markedTameSymbol c meroGermCoordinateUnit) = 1 := by
  rw [markedTameDegree_symbol, meroGermCoordinateUnit_order]

theorem markedTameDegree_surjective (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    Function.Surjective (markedTameDegree c hc) := by
  intro n
  refine ⟨n • markedTameSymbol c meroGermCoordinateUnit, ?_⟩
  rw [map_zsmul, markedTameDegree_coordinate]
  simp

/-- Degree zero is exactly the tame kernel inside the fixed-clock source. -/
theorem markedTameDegree_eq_zero_iff (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) (x : markedTameK2 c) :
    markedTameDegree c hc x = 0 ↔ meroGermTameBoundary x.val = 0 := by
  constructor
  · intro h
    rw [markedTameExponent_spec, show markedTameExponent c x = 0 from h]
    simp
  · intro h
    exact markedTameExponent_eq c hc x 0 (by simpa using h)

/-- The marked source modulo its tame kernel is exactly the integer lattice. -/
def markedTameDegreeQuotientEquiv (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    (markedTameK2 c ⧸ (markedTameDegree c hc).ker) ≃+ ℤ :=
  QuotientAddGroup.quotientKerEquivOfSurjective (markedTameDegree c hc)
    (markedTameDegree_surjective c hc)

/-- Retaining the clock is essential: its integer degree cannot extend to the ambient K2. -/
theorem markedTameDegree_not_extend (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    ¬ ∃ F : MilnorKDeg MeroGerm 2 →+ ℤ,
      ∀ x : markedTameK2 c, F x.val = markedTameDegree c hc x := by
  rintro ⟨F, hF⟩
  have he := hF (markedTameSymbol c meroGermCoordinateUnit)
  rw [markedTameDegree_coordinate] at he
  change F (milnorSym2 MeroGerm (milnorUnitMap constGerm c) meroGermCoordinateUnit) = 1 at he
  rw [constantMeroSymbol_integerHom_zero] at he
  exact zero_ne_one he

/-- The fixed-clock subgroup is genuinely smaller: an ambient half of its primitive class
    necessarily leaves the marked source. -/
theorem markedTameCoordinate_half_outside (c : ℂˣ)
    (hc : Function.Injective (fun n : ℤ => c ^ n)) :
    ∃ y : MilnorKDeg MeroGerm 2,
      (2 : ℕ) • y = (markedTameSymbol c meroGermCoordinateUnit).val ∧
      y ∉ markedTameK2 c := by
  obtain ⟨y, hy⟩ := constantMeroSymbol_divisible c meroGermCoordinateUnit
    (n := 2) (by norm_num)
  refine ⟨y, hy, ?_⟩
  intro hm
  let z : markedTameK2 c := ⟨y, hm⟩
  have he : (2 : ℕ) • z = markedTameSymbol c meroGermCoordinateUnit := Subtype.ext hy
  have hd := congrArg (markedTameDegree c hc) he
  rw [map_nsmul, markedTameDegree_coordinate] at hd
  simp only [nsmul_eq_mul] at hd
  omega

/-- Refining the retained clock changes the source subgroup without changing the ambient class. -/
def markedTameClockChange (c d : ℂˣ) (n : ℤ) (h : c = d ^ n) :
    markedTameK2 c →+ markedTameK2 d where
  toFun x := ⟨x.val, n * markedTameExponent c x, by
    rw [markedTameExponent_spec]
    have he (k : ℤ) : c ^ k = d ^ (n * k) := by rw [h, zpow_mul]
    exact congrArg Additive.ofMul (he _)⟩
  map_zero' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl

@[simp] theorem markedTameClockChange_val (c d : ℂˣ) (n : ℤ) (h : c = d ^ n)
    (x : markedTameK2 c) : (markedTameClockChange c d n h x).val = x.val := rfl

/-- Clock refinement multiplies integer degree by the exact covering index. -/
theorem markedTameDegree_clockChange (c d : ℂˣ) (n : ℤ) (h : c = d ^ n)
    (hc : Function.Injective (fun k : ℤ => c ^ k))
    (hd : Function.Injective (fun k : ℤ => d ^ k)) (x : markedTameK2 c) :
    markedTameDegree d hd (markedTameClockChange c d n h x) =
      n * markedTameDegree c hc x := by
  apply markedTameExponent_eq d hd
  change meroGermTameBoundary x.val = _
  rw [markedTameExponent_spec]
  have he (k : ℤ) : c ^ k = d ^ (n * k) := by rw [h, zpow_mul]
  exact congrArg Additive.ofMul (he _)

end
end GaloisForLFunctions.HTGeometry
