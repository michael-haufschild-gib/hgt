import GaloisForLFunctions.HTGeometry.PolynomialPhaseActiveSupport
import GaloisForLFunctions.HTGeometry.LaurentMonomialSpanAlgebraicity
import GaloisForLFunctions.HTGeometry.DifferentialHopfPrimitive
import GaloisForLFunctions.HTGeometry.ScalarDifferentialOrderUpperBound

/-!
# Exact active-character aperture of polynomial phases

Diagonal polynomial differentiation preserves monomial support.  The symbolic
jets of a polynomial therefore lie in the field generated by the Laurent
monomials indexed by its support.  Rational exponent-span relations make this
field algebraic over a field of transcendence degree equal to the active
character rank.  Algebraic dependence of one more jet supplies an autonomous
relation at that rank.

Combined with the active-lattice lower bound, this proves that every polynomial
phase has minimal autonomous differential order exactly equal to its active
character rank, without full-support, injectivity, or linear-term hypotheses.
-/

open Complex Set

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The diagonal polynomial derivation creates no new monomial exponent. -/
theorem support_diagonalPolynomialDerivation_subset {k : ℕ}
    (omega : Fin k → ℝ) (Q : MvPolynomial (Fin k) ℂ) :
    (diagonalPolynomialDerivation omega Q).support ⊆ Q.support := by
  intro e he
  rw [MvPolynomial.mem_support_iff] at he ⊢
  contrapose! he
  rw [diagonalPolynomialDerivation, MvPolynomial.coeff_sum]
  apply Finset.sum_eq_zero
  intro i hi
  rw [show MvPolynomial.C (Complex.I * (omega i : ℂ)) * MvPolynomial.X i *
      MvPolynomial.pderiv i Q =
        MvPolynomial.C (Complex.I * (omega i : ℂ)) *
          (MvPolynomial.X i * MvPolynomial.pderiv i Q) by ring,
    MvPolynomial.coeff_C_mul,
    GaloisForLFunctions.coeff_X_mul_pderiv, he, mul_zero, mul_zero]

/-- Every iterated diagonal polynomial derivative remains supported on the
original polynomial's monomials. -/
theorem support_iterate_diagonalPolynomialDerivation_subset {k : ℕ}
    (omega : Fin k → ℝ) (Q : MvPolynomial (Fin k) ℂ) (j : ℕ) :
    ((diagonalPolynomialDerivation omega)^[j] Q).support ⊆ Q.support := by
  induction j with
  | zero => exact fun _ h => h
  | succ j ih =>
      rw [Function.iterate_succ_apply']
      exact fun e he => ih (support_diagonalPolynomialDerivation_subset omega _ he)

/-- Rational and integral ranks agree for the rationalized span of an integer
character family. -/
theorem rank_span_rat_intCharacterToRat {k : ℕ} (S : Set (Fin k → ℤ)) :
    Module.rank ℚ (Submodule.span ℚ (intCharacterToRat '' S)) =
      Module.rank ℤ (Submodule.span ℤ S) := by
  have hZ : Module.rank ℤ (Submodule.span ℤ S) =
      Module.rank ℤ (Submodule.span ℤ (intCharacterToRat '' S)) := by
    rw [← Submodule.map_span]
    exact (Submodule.equivMapOfInjective _ injective_intCharacterToRat
      (Submodule.span ℤ S)).rank_eq
  calc
    Module.rank ℚ (Submodule.span ℚ (intCharacterToRat '' S)) =
        Module.rank ℤ (Submodule.span ℤ (intCharacterToRat '' S)) :=
      (rank_span_int_eq_rank_span_rat (intCharacterToRat '' S)).symm
    _ = Module.rank ℤ (Submodule.span ℤ S) := hZ.symm

/-- The subtype-indexed exponent family has the same range as the image of
the support set. -/
theorem range_natExponentCharacter_support {k : ℕ}
    (Q : MvPolynomial (Fin k) ℂ) :
    Set.range (fun e : ↥Q.support => natExponentCharacter e.1) =
      natExponentCharacter '' (Q.support : Set (Fin k →₀ ℕ)) := by
  ext m
  constructor
  · rintro ⟨e, rfl⟩
    exact ⟨e.1, e.2, rfl⟩
  · rintro ⟨e, he, rfl⟩
    exact ⟨⟨e, he⟩, rfl⟩

/-- Evaluation of a polynomial supported on `Q` belongs to any intermediate
field containing the corresponding Laurent monomials. -/
theorem aeval_mem_of_support_subset {k : ℕ} {E : Type}
    [Field E] [Algebra ℂ E]
    (x : Fin k → E) (K : IntermediateField ℂ E)
    (Q P : MvPolynomial (Fin k) ℂ) (hsub : P.support ⊆ Q.support)
    (hmono : ∀ e ∈ Q.support,
      laurentMonomial x (natExponentCharacter e) ∈ K) :
    MvPolynomial.aeval x P ∈ K := by
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
  apply K.sum_mem
  intro e he
  apply K.mul_mem (K.algebraMap_mem (P.coeff e))
  rw [← laurentMonomial_natCast]
  exact hmono e (hsub he)

/-- A polynomial phase admits an autonomous relation at exactly its active
character rank, without any nondegeneracy assumption on its support. -/
theorem exists_polynomialPhase_realAutonomousAnnihilator_activeLatticeNatRank
    {k : ℕ} {rho : Fin k → ℝ} (hrho : ∀ i, 0 < rho i)
    (omega : Fin k → ℝ) (Q : MvPolynomial (Fin k) ℂ) :
    ∃ P : Polynomial
        (MvPolynomial
          (Fin (activeLatticeNatRank (polynomialPhaseObservable Q))) ℂ),
      P ≠ 0 ∧
        RealAutonomousAnnihilator
          (phaseFunction omega (polynomialPhaseObservable Q))
          (activeLatticeNatRank (polynomialPhaseObservable Q)) P := by
  classical
  let R := MvPolynomial (Fin k) ℂ
  let E := FractionRing R
  let x : Fin k → E := fun i => algebraMap R E (MvPolynomial.X i)
  have hx0 : ∀ i, x i ≠ 0 := by
    intro i
    simpa [x] using
      (IsFractionRing.injective R E).ne (MvPolynomial.X_ne_zero i)
  obtain ⟨K, hKtr, hKmono⟩ :=
    exists_laurentMonomial_algebraicClosure_rank_le
      (F := ℂ) x hx0
        (fun e : ↥Q.support => natExponentCharacter e.1)
  rw [range_natExponentCharacter_support Q] at hKtr
  rw [rank_span_rat_intCharacterToRat] at hKtr
  change Algebra.trdeg ℂ K ≤ Module.rank ℤ (polynomialCharacterLattice Q) at hKtr
  rw [← activeLattice_polynomialPhaseObservable,
    ← natCast_activeLatticeNatRank] at hKtr
  have hmono : ∀ e ∈ Q.support,
      laurentMonomial x (natExponentCharacter e) ∈ K := by
    intro e he
    exact hKmono ⟨e, he⟩
  have hjets : ∀ j : Fin
      (activeLatticeNatRank (polynomialPhaseObservable Q) + 1),
      MvPolynomial.aeval x
          ((diagonalPolynomialDerivation omega)^[(j : ℕ)] Q) ∈ K := by
    intro j
    apply aeval_mem_of_support_subset x K Q
    · exact support_iterate_diagonalPolynomialDerivation_subset omega Q j
    · exact hmono
  let y : Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1) → K :=
    fun j => ⟨MvPolynomial.aeval x
      ((diagonalPolynomialDerivation omega)^[(j : ℕ)] Q), hjets j⟩
  have hdep : ¬ AlgebraicIndependent ℂ y :=
    GaloisForLFunctions.not_algebraicIndependent_of_trdeg_le hKtr y
  rw [algebraicIndependent_iff_injective_aeval] at hdep
  obtain ⟨H, hH0, hHy⟩ :
      ∃ H : MvPolynomial
          (Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1)) ℂ,
        H ≠ 0 ∧ MvPolynomial.aeval y H = 0 := by
    obtain ⟨H₁, H₂, hEq, hne⟩ := Function.not_injective_iff.mp hdep
    exact ⟨H₁ - H₂, sub_ne_zero.mpr hne, by rw [map_sub, hEq, sub_self]⟩
  have hpush : MvPolynomial.aeval
      (fun j : Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1) =>
        MvPolynomial.aeval x
          ((diagonalPolynomialDerivation omega)^[(j : ℕ)] Q)) H = 0 := by
    have h := MvPolynomial.comp_aeval_apply y K.val H
    rw [hHy, map_zero] at h
    exact h.symm
  have hxAI : AlgebraicIndependent ℂ x := by
    have hX := (MvPolynomial.algebraicIndependent_X (Fin k) ℂ).map
      (f := IsScalarTower.toAlgHom ℂ R E)
      (IsFractionRing.injective R E).injOn
    simpa [x, R, Function.comp_def] using hX
  have hsymbolic : MvPolynomial.aeval
      (fun j : Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1) =>
        (diagonalPolynomialDerivation omega)^[(j : ℕ)] Q) H = 0 := by
    rw [algebraicIndependent_iff_injective_aeval] at hxAI
    apply hxAI
    have hcomp := MvPolynomial.comp_aeval_apply
      (fun j : Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1) =>
        (diagonalPolynomialDerivation omega)^[(j : ℕ)] Q)
      (MvPolynomial.aeval x) H
    rw [hpush] at hcomp
    simpa using hcomp
  refine ⟨jetUnlift H, jetUnlift_ne_zero hH0, ?_⟩
  apply realAutonomousAnnihilator_of_phaseJetEval_eq_zero hrho
    (analyticOnNhd_polynomialPhaseObservable Q (polyannulus rho))
  intro z hz
  let a : Fin (activeLatticeNatRank (polynomialPhaseObservable Q) + 1) → ℂ :=
    fun j => phaseJet omega (polynomialPhaseObservable Q) (j : ℕ) z
  have hlift : phaseJetEval omega (polynomialPhaseObservable Q)
      (jetUnlift H) z = MvPolynomial.eval a H := by
    rw [phaseJetEval]
    change Polynomial.eval₂
      (MvPolynomial.eval fun j : Fin
        (activeLatticeNatRank (polynomialPhaseObservable Q)) => a j.castSucc)
      (a (Fin.last (activeLatticeNatRank (polynomialPhaseObservable Q))))
      (jetUnlift H) = MvPolynomial.eval a H
    rw [← eval_jetLift a, lastVariableJetLift_jetUnlift]
  rw [hlift]
  have hzero := congrArg (MvPolynomial.eval z) hsymbolic
  rw [eval_aeval_polynomialFamily] at hzero
  simpa [a, phaseJet_polynomialPhaseObservable,
    polynomialPhaseObservable] using hzero

/-- Exact autonomous order of every polynomial phase: the number of independent
active Fourier characters. -/
theorem autonomousMinimalOrder_polynomialPhase_eq_activeLatticeNatRank
    {k : ℕ} {rho : Fin k → ℝ} (hrho : ∀ i, 0 < rho i)
    (omega : Fin k → ℝ) (hindep : RationallyIndependentFrequency omega)
    (Q : MvPolynomial (Fin k) ℂ) :
    autonomousMinimalOrder
        (phaseFunction omega (polynomialPhaseObservable Q)) =
      activeLatticeNatRank (polynomialPhaseObservable Q) := by
  apply autonomousMinimalOrder_eq_activeLatticeNatRank_of_relation
    hrho hindep
    (analyticOnNhd_polynomialPhaseObservable Q (polyannulus rho))
  exact exists_polynomialPhase_realAutonomousAnnihilator_activeLatticeNatRank
    hrho omega Q

/-- Differential-order compression for polynomial phases is equivalent to a
positive-dimensional torus stabilizer. -/
theorem autonomousMinimalOrder_polynomialPhase_lt_card_iff_stabilizer_pos
    {k : ℕ} {rho : Fin k → ℝ} (hrho : ∀ i, 0 < rho i)
    (omega : Fin k → ℝ) (hindep : RationallyIndependentFrequency omega)
    (Q : MvPolynomial (Fin k) ℂ) :
    autonomousMinimalOrder
        (phaseFunction omega (polynomialPhaseObservable Q)) < k ↔
      0 < Module.finrank ℂ
        (characterAnnihilator (activeSupport (polynomialPhaseObservable Q))) := by
  simpa using autonomousMinimalOrder_lt_card_iff_stabilizer_pos_of_exact
    (autonomousMinimalOrder_polynomialPhase_eq_activeLatticeNatRank
      hrho omega hindep Q)

end

end GaloisForLFunctions.HTGeometry
