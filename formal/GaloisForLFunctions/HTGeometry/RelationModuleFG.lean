import Mathlib.Algebra.Group.Commutator
import Mathlib.Tactic.Group
import Mathlib.GroupTheory.Finiteness
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Noetherian.Basic
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.RingTheory.Int.Basic

/-!
# The relation module of a normally generated subgroup

For a group `F` and a set `S ⊆ F` write `N = normalClosure S`.  The quotient `N / ⁅F, N⁆` — the
**relation module** of `S` when `F` is free and `N` is the group of relations — is abelian, and it
is generated by the images of `S` alone, even though `N` itself is almost never generated by `S`.

Consequently a *finite* `S` forces `N / ⁅F, N⁆` to be a finitely generated abelian group, so every
one of its subgroups is finitely generated.  This is the finiteness engine behind Hopf's formula:
for a presentation `1 → N → F → G → 1` with `F` free and `S` a finite set of relators, the second
integral homology of `G` is the subgroup `(N ∩ ⁅F, F⁆)/⁅F, N⁆` of exactly this quotient.

* `normalClosure_eq_closure_sup_commutator` : `N = ⟪S⟫ ⊔ ⁅F, N⁆`.
* `relationQuotient_mul_comm` : the quotient is abelian.
* `relationQuotient_fg` : it is finitely generated when `S` is finite.
* `relationQuotient_subgroup_fg` : hence so is each of its subgroups.
-/

namespace GaloisForLFunctions.HTGeometry

open Subgroup
open scoped commutatorElement

variable {F : Type*} [Group F]

/-- Every conjugate of a member of `S` lies in `⟪S⟫ ⊔ ⁅F, ⟪⟪S⟫⟫⁆`, because `x s x⁻¹ = ⁅x, s⁆ · s`. -/
theorem normalClosure_le_closure_sup_commutator (S : Set F) :
    normalClosure S ≤ closure S ⊔ ⁅(⊤ : Subgroup F), normalClosure S⁆ := by
  show closure (Group.conjugatesOfSet S) ≤ _
  rw [closure_le]
  rintro y hy
  rw [Group.mem_conjugatesOfSet_iff] at hy
  obtain ⟨s, hs, hconj⟩ := hy
  obtain ⟨x, rfl⟩ := isConj_iff.mp hconj
  have h1 : ⁅x, s⁆ ∈ ⁅(⊤ : Subgroup F), normalClosure S⁆ :=
    commutator_mem_commutator (mem_top x) (subset_normalClosure hs)
  have hx : x * s * x⁻¹ = ⁅x, s⁆ * s := by group
  refine SetLike.mem_coe.2 ?_
  rw [hx]
  exact mul_mem (SetLike.le_def.1 le_sup_right h1)
    (SetLike.le_def.1 le_sup_left (subset_closure hs))

/-- **The normal closure is the ordinary closure together with `⁅F, N⁆`.** -/
theorem normalClosure_eq_closure_sup_commutator (S : Set F) :
    normalClosure S = closure S ⊔ ⁅(⊤ : Subgroup F), normalClosure S⁆ :=
  le_antisymm (normalClosure_le_closure_sup_commutator S)
    (sup_le (closure_le _ |>.2 subset_normalClosure) (commutator_le_right _ _))

/-- `⁅F, N⁆`, read inside `N = normalClosure S`. -/
abbrev relationCommutator (S : Set F) : Subgroup (normalClosure S) :=
  (⁅(⊤ : Subgroup F), normalClosure S⁆).subgroupOf (normalClosure S)

instance (S : Set F) : (relationCommutator S).Normal :=
  Subgroup.Normal.subgroupOf (commutator_normal _ _) _

/-- The relation module `N / ⁅F, N⁆` of a normal generating set `S`. -/
abbrev RelationQuotient (S : Set F) : Type _ :=
  (normalClosure S) ⧸ relationCommutator S

/-- **The relation module is abelian**: `⁅N, N⁆ ≤ ⁅F, N⁆`. -/
theorem relationQuotient_mul_comm (S : Set F) (a b : RelationQuotient S) : a * b = b * a := by
  refine QuotientGroup.induction_on a fun n => QuotientGroup.induction_on b fun m => ?_
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, mem_subgroupOf]
  have hval : (((n * m)⁻¹ * (m * n) : normalClosure S) : F) = ⁅(m⁻¹ : F), (n⁻¹ : F)⁆ := by
    push_cast
    group
  rw [hval]
  exact commutator_mem_commutator (mem_top _) (inv_mem n.2)

/-- The canonical projection `N → N / ⁅F, N⁆`. -/
abbrev relationQuotientMk (S : Set F) : (normalClosure S) →* RelationQuotient S :=
  QuotientGroup.mk' (relationCommutator S)

/-- `⟪S⟫`, read inside `N`, is the closure of the preimage of `S`. -/
theorem closureSubgroupOf_eq (S : Set F) :
    (closure S).subgroupOf (normalClosure S) =
      closure ((normalClosure S).subtype ⁻¹' S) := by
  have hinj : Function.Injective (normalClosure S).subtype := Subtype.val_injective
  have hsub : S ⊆ Set.range ((normalClosure S).subtype) := by
    intro s hs
    exact ⟨⟨s, subset_normalClosure hs⟩, rfl⟩
  have himg : ((normalClosure S).subtype) '' (((normalClosure S).subtype) ⁻¹' S) = S :=
    Set.image_preimage_eq_of_subset hsub
  calc (closure S).subgroupOf (normalClosure S)
      = Subgroup.comap ((normalClosure S).subtype) (closure S) := rfl
    _ = Subgroup.comap ((normalClosure S).subtype)
          (Subgroup.map ((normalClosure S).subtype)
            (closure (((normalClosure S).subtype) ⁻¹' S))) := by
          rw [MonoidHom.map_closure, himg]
    _ = closure (((normalClosure S).subtype) ⁻¹' S) :=
          Subgroup.comap_map_eq_self_of_injective hinj _

/-- **The relation module is generated by the images of `S`.** -/
theorem relationQuotient_closure_image (S : Set F) :
    closure ((relationQuotientMk S) ''
        (((normalClosure S).subtype) ⁻¹' S)) = ⊤ := by
  have hsplit :
      ((closure S).subgroupOf (normalClosure S)) ⊔ relationCommutator S = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (closure_le _ |>.2 subset_normalClosure)
        (commutator_le_right _ _), ← normalClosure_eq_closure_sup_commutator,
      Subgroup.subgroupOf_self]
  have hsurj : Function.Surjective (relationQuotientMk S) :=
    QuotientGroup.mk'_surjective _
  have hker : Subgroup.map (relationQuotientMk S) (relationCommutator S) = ⊥ := by
    rw [eq_bot_iff]
    rintro _ ⟨x, hx, rfl⟩
    rw [Subgroup.mem_bot, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hx
  calc closure ((relationQuotientMk S) '' (((normalClosure S).subtype) ⁻¹' S))
      = Subgroup.map (relationQuotientMk S)
          (closure (((normalClosure S).subtype) ⁻¹' S)) := (MonoidHom.map_closure _ _).symm
    _ = Subgroup.map (relationQuotientMk S) ((closure S).subgroupOf (normalClosure S)) := by
          rw [closureSubgroupOf_eq]
    _ = Subgroup.map (relationQuotientMk S) ((closure S).subgroupOf (normalClosure S))
          ⊔ Subgroup.map (relationQuotientMk S) (relationCommutator S) := by rw [hker, sup_bot_eq]
    _ = Subgroup.map (relationQuotientMk S)
          (((closure S).subgroupOf (normalClosure S)) ⊔ relationCommutator S) :=
          (Subgroup.map_sup _ _ _).symm
    _ = ⊤ := by rw [hsplit]; exact Subgroup.map_top_of_surjective _ hsurj

/-- **A finite normal generating set makes the relation module finitely generated.** -/
theorem relationQuotient_fg (S : Set F) (hS : S.Finite) : Group.FG (RelationQuotient S) := by
  refine Group.fg_iff.2 ⟨_, relationQuotient_closure_image S, ?_⟩
  refine Set.Finite.image _ ?_
  exact hS.preimage ((normalClosure S).subtype_injective.injOn)

/-- **Every subgroup of a finitely generated abelian group is finitely generated**, because such a
group is a Noetherian `ℤ`-module. -/
theorem subgroup_fg_of_commGroup_fg {A : Type*} [CommGroup A] (hA : Group.FG A) (H : Subgroup A) :
    Group.FG H := by
  haveI := hA
  haveI : Module.Finite ℤ (Additive A) := Module.Finite.iff_addGroup_fg.2 inferInstance
  haveI : IsNoetherian ℤ (Additive A) := inferInstance
  have hsub : (AddSubgroup.toIntSubmodule (Subgroup.toAddSubgroup H)).FG :=
    IsNoetherian.noetherian _
  have h2 : (Subgroup.toAddSubgroup H).FG := by
    have := (Submodule.fg_iff_addSubgroup_fg
      (AddSubgroup.toIntSubmodule (Subgroup.toAddSubgroup H))).1 hsub
    simpa using this
  exact (Group.fg_iff_subgroup_fg H).2 ((Subgroup.fg_iff_add_fg H).2 h2)

/-- **Every subgroup of the relation module of a finite normal generating set is finitely
generated**, since the module is a finitely generated abelian group.  For a presentation
`1 → normalClosure S → F → G → 1` of `G` by finitely many relators this is the finiteness of
`H₂(G, ℤ) = (normalClosure S ∩ ⁅F, F⁆)/⁅F, normalClosure S⁆`. -/
theorem relationQuotient_subgroup_fg (S : Set F) (hS : S.Finite)
    (H : Subgroup (RelationQuotient S)) : Group.FG H := by
  letI : CommGroup (RelationQuotient S) :=
    { (inferInstance : Group (RelationQuotient S)) with
      mul_comm := relationQuotient_mul_comm S }
  exact subgroup_fg_of_commGroup_fg (relationQuotient_fg S hS) H

/-- **A normal subgroup with a finite normal generating set has finitely generated image whenever
that image is central.**  The image is a quotient of the relation module `N/⁅F, N⁆`, because
`ψ⁅x, n⁆ = ⁅ψ x, ψ n⁆ = 1` once `ψ n` commutes with everything in the image.

This is the finiteness engine for central extensions: if `Ĝ ↠ G` is a central extension whose
kernel is the image of the relations of a finite presentation of `G`, the kernel is a finitely
generated abelian group. -/
theorem fg_map_of_central {H : Type*} [Group H] (S : Set F) (hS : S.Finite) (ψ : F →* H)
    (hcomm : ∀ n ∈ normalClosure S, ∀ x : F, ψ n * ψ x = ψ x * ψ n) :
    Group.FG ((normalClosure S).map ψ) := by
  haveI : Group.FG (RelationQuotient S) := relationQuotient_fg S hS
  have hcomm' : ⁅(⊤ : Subgroup F), normalClosure S⁆ ≤ ψ.ker := by
    rw [commutator_le]
    intro x _ n hn
    have : ψ ⁅x, n⁆ = ⁅ψ x, ψ n⁆ := by
      simp [commutatorElement_def, map_mul, map_inv]
    rw [MonoidHom.mem_ker, this, commutatorElement_def, ← hcomm n hn x]
    group
  set χ : (normalClosure S) →* H := ψ.comp (normalClosure S).subtype with hχ
  have hker : relationCommutator S ≤ χ.ker := by
    intro k hk
    rw [mem_subgroupOf] at hk
    exact hcomm' hk
  set χ' : RelationQuotient S →* H := QuotientGroup.lift (relationCommutator S) χ hker with hχ'
  have hcompose : χ'.comp (QuotientGroup.mk' (relationCommutator S)) = χ :=
    MonoidHom.ext fun _ => rfl
  have h1 : Subgroup.map (QuotientGroup.mk' (relationCommutator S)) ⊤ = ⊤ :=
    Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  have h2 : Subgroup.map ((normalClosure S).subtype) ⊤ = normalClosure S := by
    rw [← MonoidHom.range_eq_map]
    exact (normalClosure S).range_subtype
  have hrange : χ'.range = (normalClosure S).map ψ := by
    rw [MonoidHom.range_eq_map]
    calc Subgroup.map χ' ⊤
        = Subgroup.map χ' (Subgroup.map (QuotientGroup.mk' (relationCommutator S)) ⊤) := by
          rw [h1]
      _ = Subgroup.map (χ'.comp (QuotientGroup.mk' (relationCommutator S))) ⊤ :=
          Subgroup.map_map _ _ _
      _ = Subgroup.map χ ⊤ := by rw [hcompose]
      _ = Subgroup.map ψ (Subgroup.map ((normalClosure S).subtype) ⊤) :=
          (Subgroup.map_map _ _ _).symm
      _ = Subgroup.map ψ (normalClosure S) := by rw [h2]
  haveI : Group.FG χ'.range := inferInstance
  rw [← hrange]
  infer_instance

/-- Centrality of the image is enough. -/
theorem fg_map_of_le_center {H : Type*} [Group H] (S : Set F) (hS : S.Finite) (ψ : F →* H)
    (hcentral : (normalClosure S).map ψ ≤ Subgroup.center H) :
    Group.FG ((normalClosure S).map ψ) := by
  refine fg_map_of_central S hS ψ fun n hn x => ?_
  have : ψ n ∈ Subgroup.center H := hcentral ⟨n, hn, rfl⟩
  exact ((Subgroup.mem_center_iff).1 this (ψ x)).symm

/-- **The kernel of a central extension of a finitely presented group is finitely generated.**
If `ψ : F ↠ Ĝ` is onto, the composite `π ∘ ψ` has kernel the normal closure of a *finite* set of
relators, and the kernel of `π` is central in `Ĝ`, then `ker π` is a finitely generated abelian
group.

Applied to `π : St(R) ↠ E(R)` this says that `K₂(R)` is finitely generated as soon as the Steinberg
group admits a surjection from a group in which the relations of `E(R)` are finitely many. -/
theorem fg_ker_of_central_extension {G H : Type*} [Group G] [Group H] (S : Set F) (hS : S.Finite)
    (ψ : F →* G) (hψ : Function.Surjective ψ) (π : G →* H)
    (hrel : normalClosure S = (π.comp ψ).ker) (hcentral : π.ker ≤ Subgroup.center G) :
    Group.FG π.ker := by
  have hkey : (normalClosure S).map ψ = π.ker := by
    rw [hrel, ← MonoidHom.comap_ker π ψ, Subgroup.map_comap_eq_self_of_surjective hψ]
  have := fg_map_of_le_center S hS ψ (by rw [hkey]; exact hcentral)
  rwa [hkey] at this

end GaloisForLFunctions.HTGeometry
