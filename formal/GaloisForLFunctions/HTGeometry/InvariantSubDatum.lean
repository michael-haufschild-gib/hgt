import GaloisForLFunctions.HTGeometry.DiagonalizableCurvedRankLaw

/-!
# Invariant sub-data of an affine source local system

A set of indices closed under the adjoint local system carries its own affine source datum: the
restricted observables satisfy the same shape of law with the restricted matrix and the restricted
increments.  Differential rank is monotone along such a restriction, so every invariant block
gives a lower bound for the rank of the whole family.

On the complementary block a triangular datum is again affine, but its increments are no longer
base elements: they are `K`-combinations of the invariant subfamily together with a base term.
This is exactly the enlargement of the coefficient field that a non-diagonalizable local system
forces, and it is recorded here in the form the flat theory would consume.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C K L : Type u} [Field C] [Field K] [Field L]
  [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]
  {I : Type u} (tau : I → K ≃+* K) (sigma : I → L ≃+* L)

variable {κ : Type u} [Fintype κ] [DecidableEq κ]

/-! ### An invariant block is a source datum -/

omit [Differential K] [Differential L] [DifferentialAlgebra K L] [DecidableEq κ] in
/-- **An invariant block of indices carries its own affine source datum.**  If the adjoint local
system sends the block into itself, the restricted observables satisfy the affine law with the
restricted matrix. -/
theorem invariant_shift_restrict {z : κ → L} {M : I → κ → κ → K} {om : I → κ → K}
    (hshift : ∀ i p, sigma i (z p)
      = (∑ q, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p))
    (S : Finset κ) (hinvar : ∀ i p q, p ∈ S → q ∉ S → M i p q = 0)
    (i : I) (p : {x : κ // x ∈ S}) :
    sigma i (z ↑p)
      = (∑ q : {x : κ // x ∈ S}, algebraMap K L (M i ↑p ↑q) * z ↑q)
        + algebraMap K L (om i ↑p) := by
  classical
  rw [hshift i ↑p]
  refine congrArg₂ (· + ·) ?_ rfl
  rw [Finset.sum_coe_sort S fun q => algebraMap K L (M i ↑p q) * z q]
  refine (Finset.sum_subset (Finset.subset_univ S) fun q _ hq => ?_).symm
  rw [hinvar i ↑p q p.2 hq, map_zero, zero_mul]

omit [Differential K] [Differential L] [DifferentialAlgebra K L] [Fintype κ] in
/-- The restriction of a diagonal datum to an invariant block is diagonal. -/
theorem invariant_diagonal_restrict {M : I → κ → κ → K} {m : I → κ → K}
    (hdiag : ∀ i p q, M i p q = if p = q then m i p else 0)
    (S : Finset κ) (i : I) (p q : {x : κ // x ∈ S}) :
    M i ↑p ↑q = if p = q then m i ↑p else 0 := by
  rw [hdiag i ↑p ↑q]
  by_cases h : p = q
  · rw [if_pos h, if_pos (by rw [h])]
  · rw [if_neg h, if_neg fun hpq => h (Subtype.ext hpq)]

/-! ### Rank monotonicity along a block -/

omit [Fintype κ] [DecidableEq κ] in
/-- The observables of an invariant block have differential rank at most that of the whole
family. -/
theorem eRk_restrict_le [CharZero L] (z : κ → L) (S : Finset κ) :
    (differentialMatroid K L).eRk (Set.range fun p : {x : κ // x ∈ S} => z ↑p)
      ≤ (differentialMatroid K L).eRk (Set.range z) :=
  Matroid.eRk_mono _ (by rintro - ⟨p, rfl⟩; exact ⟨↑p, rfl⟩)

/-! ### The complementary block and the enlargement of the coefficient field -/

/-- The increment forced on the complementary block of a triangular datum: a `K`-combination of
the invariant subfamily together with the base increment. -/
def enlargedIncrement (M : I → κ → κ → K) (om : I → κ → K) (z : κ → L) (S : Finset κ)
    (i : I) (p : κ) : L :=
  (∑ q ∈ S, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p)

omit [Differential K] [Differential L] [DifferentialAlgebra K L] in
/-- **The complementary block of a triangular datum is affine over the invariant block.**  If the
adjoint local system is diagonal off the invariant block, every complementary observable satisfies
a scalar affine law whose increment is an element of the field generated by the invariant
subfamily over `K`, not of `K` itself. -/
theorem triangular_shift_enlarged {z : κ → L} {M : I → κ → κ → K} {om : I → κ → K}
    (hshift : ∀ i p, sigma i (z p)
      = (∑ q, algebraMap K L (M i p q) * z q) + algebraMap K L (om i p))
    (S : Finset κ) {m : I → κ → K}
    (hoff : ∀ i p q, p ∉ S → q ∉ S → M i p q = if p = q then m i p else 0)
    (i : I) {p : κ} (hp : p ∉ S) :
    sigma i (z p)
      = algebraMap K L (m i p) * z p + enlargedIncrement M om z S i p := by
  classical
  rw [hshift i p, enlargedIncrement, ← add_assoc]
  refine congrArg₂ (· + ·) ?_ rfl
  rw [← Finset.sum_add_sum_compl S fun q => algebraMap K L (M i p q) * z q, add_comm]
  refine congrArg₂ (· + ·) ?_ rfl
  rw [Finset.sum_congr rfl fun q hq => by
        rw [hoff i p q hp (Finset.mem_compl.mp hq)],
    Finset.sum_eq_single p]
  · rw [if_pos rfl]
  · intro b _ hb
    rw [if_neg fun h => hb h.symm, map_zero, zero_mul]
  · intro hpS
    exact absurd (Finset.mem_compl.mpr hp) hpS

omit [Differential K] [DifferentialAlgebra K L] [Fintype κ] [DecidableEq κ] in
/-- The enlarged increment lies in the field generated over `K` by the invariant subfamily. -/
theorem enlargedIncrement_mem_adjoin (M : I → κ → κ → K) (om : I → κ → K) (z : κ → L)
    (S : Finset κ) (i : I) (p : κ) :
    enlargedIncrement M om z S i p
      ∈ differentialAdjoin K (Set.range fun q : {x : κ // x ∈ S} => z ↑q) := by
  classical
  set B := differentialAdjoin K (Set.range fun q : {x : κ // x ∈ S} => z ↑q) with hB
  refine B.add_mem ?_ (B.algebraMap_mem _)
  refine B.sum_mem fun q hq => B.mul_mem (B.algebraMap_mem _) ?_
  exact subset_differentialAdjoin K _ ⟨⟨q, hq⟩, rfl⟩

omit [Differential K] [Differential L] [DifferentialAlgebra K L] [Fintype κ] [DecidableEq κ] in
/-- An invariant block with no incoming coupling from its complement is the whole story only when
the complement is empty: the enlargement is trivial exactly when the off-block coupling
vanishes. -/
theorem enlargedIncrement_eq_algebraMap_of_no_coupling {M : I → κ → κ → K} {om : I → κ → K}
    (z : κ → L) (S : Finset κ) (hzero : ∀ i p q, q ∈ S → M i p q = 0) (i : I) (p : κ) :
    enlargedIncrement M om z S i p = algebraMap K L (om i p) := by
  classical
  rw [enlargedIncrement, Finset.sum_congr rfl fun q hq => by
    rw [hzero i p q hq, map_zero, zero_mul], Finset.sum_const_zero, zero_add]

end

end GaloisForLFunctions.HTGeometry
