import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealGeneration

/-!
# A maximal non-finitely-generated radical differential ideal is prime

This is the Zorn step of Ritt's basis theorem.  If `a b ∈ M` with `a, b ∉ M`, then the radical
differential ideals generated by `M ∪ {a}` and `M ∪ {b}` are strictly larger, hence finitely
generated by maximality; the product law puts the pairwise products of their generators inside `M`,
and squares of elements of `M` inside the radical differential ideal those products generate.  So
`M` is finitely generated after all.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

/-- **The product law, for sets.** -/
theorem mul_mem_of_forall_mul_mem {I : Ideal R} (hrad : I.IsRadical)
    (hδ : ∀ x ∈ I, Differential.deriv x ∈ I) {S T : Set R}
    (h : ∀ s ∈ S, ∀ t ∈ T, s * t ∈ I)
    {u v : R} (hu : u ∈ radicalDifferentialIdeal S)
    (hv : v ∈ radicalDifferentialIdeal T) : u * v ∈ I := by
  have hT : ∀ s ∈ S, radicalDifferentialIdeal T ≤ mulColonIdeal I s := fun s hs =>
    radicalDifferentialIdeal_le
      (fun t ht => by
        simp only [SetLike.mem_coe, mem_mulColonIdeal]
        exact h s hs t ht)
      (isRadical_mulColonIdeal hrad s) (deriv_mem_mulColonIdeal hrad hδ s)
  have hS : radicalDifferentialIdeal S ≤ mulColonIdeal I v :=
    radicalDifferentialIdeal_le
      (fun s hs => by
        simp only [SetLike.mem_coe, mem_mulColonIdeal]
        rw [mul_comm]
        exact hT s hs hv)
      (isRadical_mulColonIdeal hrad v) (deriv_mem_mulColonIdeal hrad hδ v)
  have hfin := hS hu
  rw [mem_mulColonIdeal] at hfin
  rwa [mul_comm]

/-- An ideal is finitely generated as a radical differential ideal. -/
def IsRadDiffFG (I : Ideal R) : Prop :=
  ∃ T : Finset R, I = radicalDifferentialIdeal (T : Set R)

/-- **A maximal non-finitely-generated radical differential ideal is prime.** -/
theorem mem_or_mem_of_maximal_not_radDiffFG {M : Ideal R} (hrad : M.IsRadical)
    (hδ : ∀ x ∈ M, Differential.deriv x ∈ M) (hnotfg : ¬ IsRadDiffFG M)
    (hmax : ∀ J : Ideal R, J.IsRadical → (∀ x ∈ J, Differential.deriv x ∈ J) → M < J →
      IsRadDiffFG J)
    {a b : R} (hab : a * b ∈ M) : a ∈ M ∨ b ∈ M := by
  classical
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨ha, hb⟩ := hcon
  set A := radicalDifferentialIdeal ((M : Set R) ∪ {a}) with hA
  set B := radicalDifferentialIdeal ((M : Set R) ∪ {b}) with hB
  have hMA : M ≤ A := fun x hx =>
    subset_radicalDifferentialIdeal _ (Or.inl hx)
  have hMB : M ≤ B := fun x hx =>
    subset_radicalDifferentialIdeal _ (Or.inl hx)
  have haA : a ∈ A := subset_radicalDifferentialIdeal _ (Or.inr rfl)
  have hbB : b ∈ B := subset_radicalDifferentialIdeal _ (Or.inr rfl)
  have hltA : M < A := lt_of_le_of_ne hMA (fun h => ha (h ▸ haA))
  have hltB : M < B := lt_of_le_of_ne hMB (fun h => hb (h ▸ hbB))
  obtain ⟨TA, hTA⟩ := hmax A (isRadical_radicalDifferentialIdeal _)
    (deriv_mem_radicalDifferentialIdeal _) hltA
  obtain ⟨TB, hTB⟩ := hmax B (isRadical_radicalDifferentialIdeal _)
    (deriv_mem_radicalDifferentialIdeal _) hltB
  have hpair : ∀ s ∈ ((M : Set R) ∪ {a}), ∀ t ∈ ((M : Set R) ∪ {b}), s * t ∈ M := by
    rintro s (hs | hs) t (ht | ht)
    · exact M.mul_mem_right _ hs
    · exact M.mul_mem_right _ hs
    · exact M.mul_mem_left _ ht
    · rw [Set.mem_singleton_iff] at hs ht
      subst hs; subst ht; exact hab
  set F : Finset R := (TA ×ˢ TB).image (fun p => p.1 * p.2) with hF
  have hFsub : ∀ x ∈ (F : Set R), x ∈ M := by
    intro x hx
    simp only [hF, Finset.coe_image, Set.mem_image, Finset.mem_coe, Finset.mem_product] at hx
    obtain ⟨p, ⟨hp1, hp2⟩, rfl⟩ := hx
    refine mul_mem_of_forall_mul_mem hrad hδ hpair ?_ ?_
    · rw [← hA, hTA]
      exact subset_radicalDifferentialIdeal _ (by exact_mod_cast hp1)
    · rw [← hB, hTB]
      exact subset_radicalDifferentialIdeal _ (by exact_mod_cast hp2)
  have hFle : radicalDifferentialIdeal (F : Set R) ≤ M :=
    radicalDifferentialIdeal_le hFsub hrad hδ
  have hMle : M ≤ radicalDifferentialIdeal (F : Set R) := by
    intro m hm
    have hsq : m * m ∈ radicalDifferentialIdeal (F : Set R) := by
      refine mul_mem_of_forall_mul_mem (isRadical_radicalDifferentialIdeal _)
        (deriv_mem_radicalDifferentialIdeal _) (S := (TA : Set R)) (T := (TB : Set R)) ?_ ?_ ?_
      · intro s hs t ht
        refine subset_radicalDifferentialIdeal _ ?_
        simp only [hF, Finset.coe_image, Set.mem_image, Finset.mem_coe, Finset.mem_product]
        exact ⟨(s, t), ⟨by exact_mod_cast hs, by exact_mod_cast ht⟩, rfl⟩
      · rw [← hTA]; exact hMA hm
      · rw [← hTB]; exact hMB hm
    exact isRadical_radicalDifferentialIdeal _ ⟨2, by rw [pow_two]; exact hsq⟩
  exact hnotfg ⟨F, le_antisymm hMle hFle⟩

end

end GaloisForLFunctions.HTGeometry
