import GaloisForLFunctions.HTGeometry.DedekindLocalUniformizer
import GaloisForLFunctions.HTGeometry.NakayamaAdjoin

/-!
# A Dedekind order over a local ring is generated by one element

Let `S` be a local ring and `B` a Dedekind domain, finite as an `S`-module, with the extension of the
maximal ideal nonzero.  Then `B = S[α]` for a single `α`.

The residue field of `S` acts on `B/𝔪B`, which is therefore a finite-dimensional quotient of a
Dedekind domain, hence generated by one element.  Lifting that generator to `B` and lifting the
representing polynomial coefficient-wise along the surjection `S → S/𝔪`, Nakayama's lemma promotes
residual generation to genuine generation.
-/

namespace GaloisForLFunctions.HTGeometry

open IsLocalRing

section

variable (S B : Type*) [CommRing S] [IsLocalRing S] [CommRing B] [Algebra S B]

/-- The maximal ideal of the base, extended to the algebra. -/
abbrev maxExt : Ideal B := (maximalIdeal S).map (algebraMap S B)

theorem le_comap_maxExt : maximalIdeal S ≤ (maxExt S B).comap (algebraMap S B) :=
  Ideal.le_comap_map

/-- The residue field of the base acts on the quotient by the extended maximal ideal. -/
noncomputable instance residueAlgebraQuotient : Algebra (ResidueField S) (B ⧸ maxExt S B) :=
  (Ideal.quotientMap (maxExt S B) (algebraMap S B) (le_comap_maxExt S B)).toAlgebra

instance residueQuotient_isScalarTower : IsScalarTower S (ResidueField S) (B ⧸ maxExt S B) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

end

section

variable {S B : Type*} [CommRing S] [IsLocalRing S] [CommRing B] [Algebra S B]

/-- **Residual generation over the base promotes to generation.** -/
theorem adjoin_eq_top_of_adjoin_quotient_eq_top [Module.Finite S B] (α : B)
    (h : Algebra.adjoin S ({Ideal.Quotient.mk (maxExt S B) α} : Set (B ⧸ maxExt S B)) = ⊤) :
    Algebra.adjoin S ({α} : Set B) = ⊤ := by
  refine adjoin_eq_top_of_sub_aeval_mem_map_maximalIdeal α ?_
  intro b
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at h
  obtain ⟨q, hq⟩ := h (Ideal.Quotient.mk (maxExt S B) b)
  refine ⟨q, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
  have hcomm : Polynomial.aeval (Ideal.Quotient.mk (maxExt S B) α) q
      = Ideal.Quotient.mk (maxExt S B) (Polynomial.aeval α q) :=
    Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ S (maxExt S B)) α q
  rw [← hcomm, hq, sub_self]

/-- Generation over the residue field is generation over the base. -/
theorem adjoin_base_eq_top_of_adjoin_residue (γ : B ⧸ maxExt S B)
    (h : Algebra.adjoin (ResidueField S) ({γ} : Set (B ⧸ maxExt S B)) = ⊤) :
    Algebra.adjoin S ({γ} : Set (B ⧸ maxExt S B)) = ⊤ := by
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at h ⊢
  intro b
  obtain ⟨qb, hq⟩ := h b
  obtain ⟨q, rfl⟩ := Polynomial.map_surjective (algebraMap S (ResidueField S))
    Ideal.Quotient.mk_surjective qb
  refine ⟨q, ?_⟩
  rw [← hq, Polynomial.aeval_map_algebraMap]

end

/-- **A Dedekind order over a local ring with characteristic-zero residue field is generated by one
element.** -/
theorem exists_adjoin_eq_top_of_dedekind_finite {S B : Type*} [CommRing S] [IsLocalRing S]
    [CharZero (ResidueField S)] [CommRing B] [IsDedekindDomain B] [Algebra S B] [Module.Finite S B]
    [FiniteDimensional (ResidueField S) (B ⧸ maxExt S B)] (h𝔞 : maxExt S B ≠ ⊥) :
    ∃ α : B, Algebra.adjoin S ({α} : Set B) = ⊤ := by
  obtain ⟨γ, hγ⟩ := exists_adjoin_eq_top_quotient_dedekind (κ := ResidueField S) h𝔞
  obtain ⟨α, rfl⟩ := Ideal.Quotient.mk_surjective γ
  exact ⟨α, adjoin_eq_top_of_adjoin_quotient_eq_top α
    (adjoin_base_eq_top_of_adjoin_residue _ hγ)⟩

end GaloisForLFunctions.HTGeometry
