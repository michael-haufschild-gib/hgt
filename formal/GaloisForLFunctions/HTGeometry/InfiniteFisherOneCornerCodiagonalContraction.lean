import GaloisForLFunctions.HTGeometry.RankTwoFisherCutoffWard

/-!
# Infinite-dimensional joined-codiagonal contraction

The finite joined-reporter estimate has a coordinate-free operator form.
Let `e` be an orthogonal cutoff, `psi` a unit source state, and `D` an
arbitrary contraction.  The lower corner of the pointed
connection generated by `psi` and `D psi` is the joined row/column reporter

`2⁻¹/² (|(1-e)D psi><e psi| + |(1-e)psi><eD psi|)`.

Its Hilbert--Schmidt energy is at most `1/2`, in arbitrary Hilbert dimension.
Consequently pairing any physical Hilbert--Schmidt lower corner against this
reporter costs at most half of that corner's energy.  No cutoff-commutation,
finite-rank, coordinate, compactness, or summability hypothesis is present.
-/

open Complex
open scoped InnerProductSpace

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open ContinuousLinearMap InnerProductSpace

variable {H : Type*}
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Lower-corner joined endpoint reporter generated by a source contraction. -/
def infiniteFisherOneCornerJoinedReporter
    (e D : H →L[ℂ] H) (psi : H) : H →L[ℂ] H :=
  cutoffLowerBoundary e (pointedFisherConnection psi (D psi))

private theorem projection_norm_sq_add_complement
    (e : H →L[ℂ] H) (he : IsIdempotentElem e)
    (heAdj : adjoint e = e) (x : H) :
    ‖e x‖ ^ 2 + ‖(1 - e) x‖ ^ 2 = ‖x‖ ^ 2 := by
  have hstar : IsStarProjection e := by
    rw [isStarProjection_iff]
    exact ⟨he, by simpa [star_eq_adjoint] using heAdj⟩
  obtain ⟨hRange, heq⟩ :=
    isStarProjection_iff_eq_starProjection_range.mp hstar
  letI : e.range.HasOrthogonalProjection := hRange
  have hdecomp :=
    Submodule.norm_sq_eq_add_norm_sq_starProjection x e.range
  rw [← heq, Submodule.starProjection_orthogonal', ← heq] at hdecomp
  linarith

private theorem norm_apply_le_of_norm_le_one
    {D : H →L[ℂ] H} (hD : ‖D‖ ≤ 1) (x : H) :
    ‖D x‖ ≤ ‖x‖ := by
  calc
    ‖D x‖ ≤ ‖D‖ * ‖x‖ := ContinuousLinearMap.le_opNorm D x
    _ ≤ 1 * ‖x‖ :=
      mul_le_mul_of_nonneg_right hD (norm_nonneg x)
    _ = ‖x‖ := one_mul _

/-- **Infinite joined-reporter half-unit law.**  A unit state, an orthogonal
cutoff, and any contraction generate a lower-corner reporter of
Hilbert--Schmidt energy at most one half.  The contraction may mix the two
cutoff sectors arbitrarily. -/
theorem hsNormSq_infiniteFisherOneCornerJoinedReporter_le_half
    (e D : H →L[ℂ] H) (psi : H)
    (he : IsIdempotentElem e) (heAdj : adjoint e = e)
    (hpsi : ‖psi‖ = 1) (hD : ‖D‖ ≤ 1) :
    hsNormSq (infiniteFisherOneCornerJoinedReporter e D psi) ≤
      (1 / 2 : ℝ) := by
  let A : H := (1 - e) (D psi)
  let B : H := e psi
  let C : H := (1 - e) psi
  let E : H := e (D psi)
  have hsplit : ‖B‖ ^ 2 + ‖C‖ ^ 2 = 1 := by
    simpa only [B, C, hpsi, one_pow] using
      projection_norm_sq_add_complement e he heAdj psi
  have hsplitD :
      ‖A‖ ^ 2 + ‖E‖ ^ 2 ≤ 1 := by
    have hprojection :
        ‖E‖ ^ 2 + ‖A‖ ^ 2 = ‖D psi‖ ^ 2 := by
      simpa only [A, E] using
        projection_norm_sq_add_complement e he heAdj (D psi)
    have hDpsi : ‖D psi‖ ≤ 1 := by
      calc
        ‖D psi‖ ≤ ‖psi‖ := norm_apply_le_of_norm_le_one hD psi
        _ = 1 := hpsi
    have hDpsiSq : ‖D psi‖ ^ 2 ≤ 1 := by
      nlinarith [norm_nonneg (D psi)]
    linarith
  have hcross :
      Complex.re (inner ℂ A C * inner ℂ E B) ≤
        (‖A‖ * ‖C‖) * (‖E‖ * ‖B‖) := by
    calc
      Complex.re (inner ℂ A C * inner ℂ E B) ≤
          ‖inner ℂ A C * inner ℂ E B‖ :=
        Complex.re_le_norm _
      _ = ‖inner ℂ A C‖ * ‖inner ℂ E B‖ := norm_mul _ _
      _ ≤ (‖A‖ * ‖C‖) * (‖E‖ * ‖B‖) := by
        exact mul_le_mul
          (norm_inner_le_norm A C)
          (norm_inner_le_norm E B)
          (norm_nonneg _) (mul_nonneg (norm_nonneg A) (norm_nonneg C))
  have hbound :
      ‖A‖ ^ 2 * ‖B‖ ^ 2 + ‖C‖ ^ 2 * ‖E‖ ^ 2 +
          2 * Complex.re (inner ℂ A C * inner ℂ E B) ≤
        (‖A‖ * ‖B‖ + ‖C‖ * ‖E‖) ^ 2 := by
    nlinarith
  have htwoDimensionalCauchy :
      (‖A‖ * ‖B‖ + ‖C‖ * ‖E‖) ^ 2 ≤
        (‖A‖ ^ 2 + ‖E‖ ^ 2) *
          (‖B‖ ^ 2 + ‖C‖ ^ 2) := by
    nlinarith [sq_nonneg (‖A‖ * ‖C‖ - ‖E‖ * ‖B‖)]
  have hproduct :
      (‖A‖ ^ 2 + ‖E‖ ^ 2) *
          (‖B‖ ^ 2 + ‖C‖ ^ 2) ≤ 1 := by
    rw [hsplit]
    simpa using hsplitD
  rw [infiniteFisherOneCornerJoinedReporter,
    pointedFisherConnection_lowerBoundary e heAdj psi (D psi)]
  rw [hsNormSq_smul
    ((isHilbertSchmidt_rankOne A B).add
      (isHilbertSchmidt_rankOne C E)),
    invSqrtTwo_norm_sq,
    hsNormSq_rankOne_add_rankOne]
  change
    (1 / 2 : ℝ) *
        (‖A‖ ^ 2 * ‖B‖ ^ 2 + ‖C‖ ^ 2 * ‖E‖ ^ 2 +
          2 * Complex.re (inner ℂ A C * inner ℂ E B)) ≤ 1 / 2
  nlinarith

/-- **Universal infinite source-codiagonal contraction.**  Pairing any
Hilbert--Schmidt source corner against an arbitrary contractive joined reporter loses at
least half the available corner energy. -/
theorem norm_sq_hsInner_infiniteFisherOneCornerJoinedReporter_le_half
    (source e D : H →L[ℂ] H) (psi : H)
    (hsource : IsHilbertSchmidt source)
    (he : IsIdempotentElem e) (heAdj : adjoint e = e)
    (hpsi : ‖psi‖ = 1) (hD : ‖D‖ ≤ 1) :
    ‖hsInner source
        (infiniteFisherOneCornerJoinedReporter e D psi)‖ ^ 2 ≤
      (1 / 2 : ℝ) * hsNormSq source := by
  have hreporter :
      IsHilbertSchmidt
        (infiniteFisherOneCornerJoinedReporter e D psi) := by
    exact ((pointedFisherConnection_isHilbertSchmidt psi (D psi)).comp_right e)
      |>.comp_left (1 - e)
  have hcs := norm_hsInner_le hsource hreporter
  have hreporterBound :=
    hsNormSq_infiniteFisherOneCornerJoinedReporter_le_half
      e D psi he heAdj hpsi hD
  have hsourceSq : hsNorm source ^ 2 = hsNormSq source := by
    rw [hsNorm, Real.sq_sqrt (hsNormSq_nonneg source)]
  have hreporterSq :
      hsNorm (infiniteFisherOneCornerJoinedReporter e D psi) ^ 2 =
        hsNormSq (infiniteFisherOneCornerJoinedReporter e D psi) := by
    rw [hsNorm, Real.sq_sqrt (hsNormSq_nonneg _)]
  have hcsSq :
      ‖hsInner source
          (infiniteFisherOneCornerJoinedReporter e D psi)‖ ^ 2 ≤
        hsNorm source ^ 2 *
          hsNorm (infiniteFisherOneCornerJoinedReporter e D psi) ^ 2 := by
    nlinarith [norm_nonneg
      (hsInner source
        (infiniteFisherOneCornerJoinedReporter e D psi)),
      hsNorm_nonneg source,
      hsNorm_nonneg
        (infiniteFisherOneCornerJoinedReporter e D psi)]
  rw [hsourceSq, hreporterSq] at hcsSq
  calc
    ‖hsInner source
        (infiniteFisherOneCornerJoinedReporter e D psi)‖ ^ 2 ≤
        hsNormSq source *
          hsNormSq (infiniteFisherOneCornerJoinedReporter e D psi) :=
      hcsSq
    _ ≤ hsNormSq source * (1 / 2) :=
      mul_le_mul_of_nonneg_left hreporterBound
        (hsNormSq_nonneg source)
    _ = (1 / 2 : ℝ) * hsNormSq source := by ring

end GaloisForLFunctions.HTGeometry
