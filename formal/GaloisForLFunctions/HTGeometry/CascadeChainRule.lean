import GaloisForLFunctions.HTGeometry.FreeCoordinateChainRule
import GaloisForLFunctions.HTGeometry.TopCoordinateDegree
import GaloisForLFunctions.HTGeometry.MvPolynomialPDerivDegree

/-!
# The chain rule of the cascade model, and the degree of a derivative

The cascade model is the corpus's free rational coordinate field, and its coordinate derivations are
the corpus's free coordinate derivations.  Identifying them makes the general chain rule available:
on the subfield generated by the coordinates up to `m`, the product law is the finite sum

`δ f = ∑_(l ≤ m) (δ X_l) · ∂_l f`.

Degrees then behave as the peel needs.  Differentiating at a lower coordinate leaves the `m`-degree
alone, differentiating at `m` itself drops it by one, and since the newest jet has `m`-degree
`deg v_m ≤ 1` the product law does not raise the `m`-degree at all.

Everything runs on the polynomial witness: differentiating `D·f = N` gives
`D²·∂ f = D·∂N − (∂D)·N`, so no division is created.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-! ## The model's coordinate derivations are the free ones -/

/-- **The model's coordinate derivation is the corpus's free-coordinate derivation.** -/
theorem fpderiv_eq_freeCoordinateDerivation (k : ℕ) :
    fpderiv k = freeCoordinateDerivation ℂ ℕ k := by
  have hext : (MvPolynomial.mkDerivation ℂ
        (fun j => if j = k then (1 : CascadeField) else 0)
        : Derivation ℂ (MvPolynomial ℕ ℂ) CascadeField)
      = (Algebra.linearMap (MvPolynomial ℕ ℂ) CascadeField).compDer
          (MvPolynomial.pderiv k) := by
    refine MvPolynomial.derivation_ext fun i => ?_
    rw [MvPolynomial.mkDerivation_X]
    by_cases hik : i = k
    · subst hik
      simp
    · rw [if_neg hik]
      simp [MvPolynomial.pderiv_X_of_ne hik]
  rw [fpderiv, hext, freeCoordinateDerivation, extendFreeCoordinatePolynomialDerivation]

/-- **The coordinate derivation of a polynomial is the partial derivative.** -/
theorem fpderiv_algebraMap (k : ℕ) (N : MvPolynomial ℕ ℂ) :
    fpderiv k (algebraMap (MvPolynomial ℕ ℂ) CascadeField N)
      = algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.pderiv k N) := by
  rw [fpderiv_eq_freeCoordinateDerivation, freeCoordinateDerivation_algebraMap]

/-! ## The low subalgebra sits in a finitely generated subfield -/

theorem fact_mem_freeCoordinateField {j : ℕ} {S : Set ℕ} (h : j ∈ S) (p : Polynomial ℂ) :
    fact p j ∈ freeCoordinateField ℂ ℕ S := by
  have hx : fx j ∈ freeCoordinateField ℂ ℕ S :=
    IntermediateField.subset_adjoin _ _ ⟨j, h, rfl⟩
  rw [fact_eq_aeval]
  induction p using Polynomial.induction_on with
  | C a =>
      rw [Polynomial.aeval_C]
      exact (freeCoordinateField ℂ ℕ S).algebraMap_mem a
  | add p q hp hq =>
      rw [map_add]
      exact add_mem hp hq
  | monomial n a _ =>
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      exact mul_mem ((freeCoordinateField ℂ ℕ S).algebraMap_mem a) (pow_mem hx _)

/-- **The low subalgebra lies in the subfield generated by the coordinates up to `m`.** -/
theorem lowSub_le_freeCoordinateField (Q v : ℕ → Polynomial ℂ) (m : ℕ) {f : CascadeField}
    (h : f ∈ lowSub Q v m) :
    f ∈ freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ) := by
  have hle : lowSub Q v m
      ≤ (freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ)).toSubalgebra := by
    rw [lowSub]
    refine Algebra.adjoin_le ?_
    rintro x ((⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩)
    · have hm : fx j ∈ freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ) :=
        IntermediateField.subset_adjoin _ _
          ⟨j, by simp only [Finset.coe_range, Set.mem_Iio]; omega, rfl⟩
      simpa using hm
    · have hm : (fact (Q j) j)⁻¹ ∈ freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ) :=
        inv_mem (fact_mem_freeCoordinateField
          (by simp only [Finset.coe_range, Set.mem_Iio]; omega) (Q j))
      simpa using hm
    · have hm : (fact (v j) j)⁻¹ ∈ freeCoordinateField ℂ ℕ (↑(Finset.range (m + 1)) : Set ℕ) :=
        inv_mem (fact_mem_freeCoordinateField
          (by simp only [Finset.coe_range, Set.mem_Iio]; omega) (v j))
      simpa using hm
  exact hle h

/-- **The chain rule of the product law.**  On the low subalgebra the law is the finite sum of the
coordinate derivatives against the jets. -/
theorem prodDerivation_eq_sum {Q v : ℕ → Polynomial ℂ} {m : ℕ} {f : CascadeField}
    (h : f ∈ lowSub Q v m) :
    prodDerivation Q v f
      = ∑ l ∈ Finset.range (m + 1), prodJet Q v l * fpderiv l f := by
  have hmem := lowSub_le_freeCoordinateField Q v m h
  have hchain := freeCoordinate_chainRule (Finset.range (m + 1)) (prodDerivation Q v) hmem
  rw [hchain]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [fpderiv_eq_freeCoordinateDerivation]
  congr 1
  exact prodDerivation_fx Q v l

/-! ## Degrees under differentiation -/

/-- Differentiating at another coordinate does not raise the degree. -/
theorem degreeOf_pderiv_le_of_ne {i l : ℕ} (h : l ≠ i) (N : MvPolynomial ℕ ℂ) :
    degreeOf i (MvPolynomial.pderiv l N) ≤ degreeOf i N := by
  classical
  refine MvPolynomial.degreeOf_le_iff.mpr fun μ hμ => ?_
  have hne : MvPolynomial.coeff μ (MvPolynomial.pderiv l N) ≠ 0 :=
    MvPolynomial.mem_support_iff.mp hμ
  rw [MvPolynomial.coeff_pderiv] at hne
  have hc : MvPolynomial.coeff (μ + Finsupp.single l 1) N ≠ 0 := fun hc0 => hne (by simp [hc0])
  have hmem : (μ + Finsupp.single l 1) ∈ N.support := MvPolynomial.mem_support_iff.mpr hc
  have hle : (μ + Finsupp.single l 1 : ℕ →₀ ℕ) i ≤ degreeOf i N := by
    rw [MvPolynomial.degreeOf_eq_sup]
    exact Finset.le_sup (f := fun d : ℕ →₀ ℕ => d i) hmem
  simpa [Finsupp.single_apply, h] using hle

/-- The polynomial witness of a coordinate derivative: no division is created. -/
theorem algebraMap_sq_mul_fpderiv {l : ℕ} {N D : MvPolynomial ℕ ℂ} {f : CascadeField}
    (hf : algebraMap (MvPolynomial ℕ ℂ) CascadeField D * f
      = algebraMap (MvPolynomial ℕ ℂ) CascadeField N) :
    algebraMap (MvPolynomial ℕ ℂ) CascadeField (D * D) * fpderiv l f
      = algebraMap (MvPolynomial ℕ ℂ) CascadeField
          (D * MvPolynomial.pderiv l N - MvPolynomial.pderiv l D * N) := by
  have hd : algebraMap (MvPolynomial ℕ ℂ) CascadeField D * fpderiv l f
      + f * algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.pderiv l D)
      = algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.pderiv l N) := by
    have hcong := congrArg (fun z => fpderiv l z) hf
    simp only [Derivation.leibniz, smul_eq_mul, fpderiv_algebraMap] at hcong
    linear_combination hcong
  rw [map_mul, map_sub, map_mul, map_mul]
  linear_combination (algebraMap (MvPolynomial ℕ ℂ) CascadeField D) * hd
    - (algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.pderiv l D)) * hf

/-- **Differentiating at a lower coordinate keeps the degree.** -/
theorem TopDegLE.fpderiv_of_ne {m l : ℕ} (hlm : l ≠ m) {d : ℤ} {f : CascadeField}
    (hf : TopDegLE m d f) : TopDegLE m d (fpderiv l f) := by
  obtain ⟨N, D, hD, hfND, hdeg⟩ := hf
  refine ⟨D * MvPolynomial.pderiv l N - MvPolynomial.pderiv l D * N, D * D,
    mul_ne_zero hD hD, algebraMap_sq_mul_fpderiv hfND, ?_⟩
  have hDD : degreeOf m (D * D) = degreeOf m D + degreeOf m D := degreeOf_mul_eq hD hD
  have h1 : degreeOf m (D * MvPolynomial.pderiv l N - MvPolynomial.pderiv l D * N)
      ≤ max (degreeOf m (D * MvPolynomial.pderiv l N))
        (degreeOf m (MvPolynomial.pderiv l D * N)) := by
    rw [sub_eq_add_neg]
    refine le_trans (degreeOf_add_le _ _ _) ?_
    rw [degreeOf_neg]
  have h2 : degreeOf m (D * MvPolynomial.pderiv l N) ≤ degreeOf m D + degreeOf m N := by
    refine le_trans (degreeOf_mul_le _ _ _) ?_
    have := degreeOf_pderiv_le_of_ne (i := m) hlm N
    omega
  have h3 : degreeOf m (MvPolynomial.pderiv l D * N) ≤ degreeOf m D + degreeOf m N := by
    refine le_trans (degreeOf_mul_le _ _ _) ?_
    have := degreeOf_pderiv_le_of_ne (i := m) hlm D
    omega
  rw [hDD]
  push_cast
  omega

/-- **Differentiating at the coordinate itself drops the degree.** -/
theorem TopDegLE.fpderiv_top {m : ℕ} {d : ℤ} {f : CascadeField} (hf : TopDegLE m d f) :
    TopDegLE m (d - 1) (fpderiv m f) := by
  obtain ⟨N, D, hD, hfND, hdeg⟩ := hf
  rcases eq_or_ne (fpderiv m f) 0 with h0 | h0
  · rw [h0]
    exact topDegLE_zero m (d - 1)
  refine ⟨D * MvPolynomial.pderiv m N - MvPolynomial.pderiv m D * N, D * D,
    mul_ne_zero hD hD, algebraMap_sq_mul_fpderiv hfND, ?_⟩
  have hDD : degreeOf m (D * D) = degreeOf m D + degreeOf m D := degreeOf_mul_eq hD hD
  -- at least one of the two derivatives is nonzero, else the derivative would vanish
  have hnz : MvPolynomial.pderiv m N ≠ 0 ∨ MvPolynomial.pderiv m D ≠ 0 := by
    by_contra hc
    rw [not_or, not_not, not_not] at hc
    refine h0 ?_
    have hwit := algebraMap_sq_mul_fpderiv (l := m) hfND
    rw [hc.1, hc.2] at hwit
    simp only [mul_zero, zero_mul, sub_zero, map_zero] at hwit
    have hDD0 : algebraMap (MvPolynomial ℕ ℂ) CascadeField (D * D) ≠ 0 := by
      simpa using (IsFractionRing.injective (MvPolynomial ℕ ℂ) CascadeField).ne_iff.mpr
        (mul_ne_zero hD hD)
    exact (mul_eq_zero.mp hwit).resolve_left hDD0
  have hpos : 1 ≤ degreeOf m N + degreeOf m D := by
    rcases hnz with h | h
    · have := degreeOf_pderiv_lt (i := m) (p := N) h
      omega
    · have := degreeOf_pderiv_lt (i := m) (p := D) h
      omega
  have h2 : degreeOf m (D * MvPolynomial.pderiv m N) + 1 ≤ degreeOf m D + degreeOf m N := by
    rcases eq_or_ne (MvPolynomial.pderiv m N) 0 with hz | hz
    · rw [hz, mul_zero]
      simp only [MvPolynomial.degreeOf_zero]
      omega
    · have hlt := degreeOf_pderiv_lt (i := m) (p := N) hz
      have := degreeOf_mul_le m D (MvPolynomial.pderiv m N)
      omega
  have h3 : degreeOf m (MvPolynomial.pderiv m D * N) + 1 ≤ degreeOf m D + degreeOf m N := by
    rcases eq_or_ne (MvPolynomial.pderiv m D) 0 with hz | hz
    · rw [hz, zero_mul]
      simp only [MvPolynomial.degreeOf_zero]
      omega
    · have hlt := degreeOf_pderiv_lt (i := m) (p := D) hz
      have := degreeOf_mul_le m (MvPolynomial.pderiv m D) N
      omega
  have h1 : degreeOf m (D * MvPolynomial.pderiv m N - MvPolynomial.pderiv m D * N)
      ≤ max (degreeOf m (D * MvPolynomial.pderiv m N))
        (degreeOf m (MvPolynomial.pderiv m D * N)) := by
    rw [sub_eq_add_neg]
    refine le_trans (degreeOf_add_le _ _ _) ?_
    rw [degreeOf_neg]
  rw [hDD]
  push_cast
  omega

/-! ## The product law does not raise the degree -/

theorem topDegLE_sum {m : ℕ} {d : ℤ} {ι : Type*} (s : Finset ι) (F : ι → CascadeField)
    (h : ∀ i ∈ s, TopDegLE m d (F i)) : TopDegLE m d (∑ i ∈ s, F i) := by
  classical
  induction s using Finset.induction with
  | empty => simpa using topDegLE_zero m d
  | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact TopDegLE.add (h a (Finset.mem_insert_self a s))
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- **The product law does not raise the degree in the newest coordinate**, provided its terminal
factor there is at most linear. -/
theorem TopDegLE.prodDerivation {Q v : ℕ → Polynomial ℂ} {m : ℕ} {d : ℤ} {f : CascadeField}
    (hv : (v m).natDegree ≤ 1) (hmem : f ∈ lowSub Q v m) (hf : TopDegLE m d f) :
    TopDegLE m d (prodDerivation Q v f) := by
  rw [prodDerivation_eq_sum hmem]
  refine topDegLE_sum _ _ fun l hl => ?_
  have hlm : l ≤ m := by
    have := Finset.mem_range.mp hl
    omega
  rcases eq_or_lt_of_le hlm with rfl | hlt
  · -- the newest coordinate: the jet has degree at most one, the derivative drops one
    have hjet : TopDegLE l (1 : ℤ) (prodJet Q v l) := by
      rw [prodJet_eq]
      have hhead : TopDegLE l 0 (prodHead Q l) := TopFree.topDegLE (topFree_prodHead (le_refl l))
      have hfac : TopDegLE l ((v l).natDegree : ℤ) (fact (v l) l) := topDegLE_fact l (v l)
      have hmul := TopDegLE.mul hhead hfac
      refine TopDegLE.mono ?_ hmul
      have : ((v l).natDegree : ℤ) ≤ 1 := by exact_mod_cast hv
      omega
    have hder : TopDegLE l (d - 1) (fpderiv l f) := TopDegLE.fpderiv_top hf
    have hmul := TopDegLE.mul hjet hder
    refine TopDegLE.mono ?_ hmul
    omega
  · -- a lower coordinate: the jet is free of the newest one
    have hjet : TopFree m (prodJet Q v l) := by
      rw [prodJet_eq]
      exact TopFree.mul (topFree_prodHead (le_of_lt hlt)) (topFree_fact (by omega) (v l))
    have hder : TopDegLE m d (fpderiv l f) := TopDegLE.fpderiv_of_ne (by omega) hf
    have hmul := TopDegLE.mul (TopFree.topDegLE hjet) hder
    refine TopDegLE.mono ?_ hmul
    omega

end GaloisForLFunctions.HTGeometry
