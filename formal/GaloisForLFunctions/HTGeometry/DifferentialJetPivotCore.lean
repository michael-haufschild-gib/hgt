import GaloisForLFunctions.HTGeometry.DifferentialPolynomial

/-!
# Pivot elimination for an arbitrary jet family

A *pivot presentation* replaces every dependent jet `X (inr r, n)` of
`DifferentialPolynomial (B ⊕ R) F` by a prescribed expression `J r n` in the pivot variables
alone.  Nothing about the elimination, the displayed relations, the kernel description, the PBW
normal form or the evaluation factorisation depends on the shape of `J`, so all of it is proved
here once for an arbitrary jet family

`J : R → ℕ → DifferentialPolynomial B F`.

The presentations used in the corpus — an affine combination over a finite pivot set, a finitely
supported affine combination over an arbitrary pivot set, and a scalar multiple of a single
shifted pivot jet — are this development at three choices of `J`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Eliminate every dependent jet by the prescribed pivot expression. -/
def differentialJetPivotElimination
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) :
    DifferentialPolynomial (B ⊕ R) F →ₐ[F] DifferentialPolynomial B F :=
  MvPolynomial.bind₁ fun q ↦
    match q.1 with
    | Sum.inl b => MvPolynomial.X (b, q.2)
    | Sum.inr r => J r q.2

/-- Include pivot differential polynomials into the left variables of the full jet ring. -/
def differentialJetPivotInclusion
    {F B R : Type*} [Field F] :
    DifferentialPolynomial B F →ₐ[F] DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.rename fun q ↦ (Sum.inl q.1, q.2)

@[simp]
theorem differentialJetPivotElimination_X_inl
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) (b : B) (n : ℕ) :
    differentialJetPivotElimination J
        (MvPolynomial.X (Sum.inl b, n)) = MvPolynomial.X (b, n) := by
  simp [differentialJetPivotElimination]

@[simp]
theorem differentialJetPivotElimination_X_inr
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) (r : R) (n : ℕ) :
    differentialJetPivotElimination J (MvPolynomial.X (Sum.inr r, n)) = J r n := by
  simp [differentialJetPivotElimination]

@[simp]
theorem differentialJetPivotInclusion_X
    {F B R : Type*} [Field F] (b : B) (n : ℕ) :
    differentialJetPivotInclusion (R := R) (MvPolynomial.X (b, n)) =
      (MvPolynomial.X (Sum.inl b, n) : DifferentialPolynomial (B ⊕ R) F) := by
  simp [differentialJetPivotInclusion]

/-- Elimination is a left inverse to pivot inclusion. -/
@[simp]
theorem differentialJetPivotElimination_inclusion
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F)
    (P : DifferentialPolynomial B F) :
    differentialJetPivotElimination J (differentialJetPivotInclusion P) = P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [differentialJetPivotElimination, differentialJetPivotInclusion]
  | add P Q hP hQ => simp [hP, hQ]
  | mul_X P q hP =>
      rcases q with ⟨b, n⟩
      simp only [map_mul, hP, differentialJetPivotInclusion_X,
        differentialJetPivotElimination_X_inl]

theorem differentialJetPivotElimination_surjective
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) :
    Function.Surjective (differentialJetPivotElimination J) := fun P =>
  ⟨differentialJetPivotInclusion P, differentialJetPivotElimination_inclusion J P⟩

/-- The displayed relation for one dependent jet. -/
def differentialJetPivotRelation
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) (r : R) (n : ℕ) :
    DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.X (Sum.inr r, n) - differentialJetPivotInclusion (J r n)

/-- The ideal generated by all displayed pivot jet relations. -/
def differentialJetPivotRelationIdeal
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) :
    Ideal (DifferentialPolynomial (B ⊕ R) F) :=
  Ideal.span (Set.range fun rn : R × ℕ ↦ differentialJetPivotRelation J rn.1 rn.2)

@[simp]
theorem differentialJetPivotElimination_relation
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) (r : R) (n : ℕ) :
    differentialJetPivotElimination J (differentialJetPivotRelation J r n) = 0 := by
  simp [differentialJetPivotRelation]

/-- Every polynomial differs from its eliminated pivot normal form by the displayed relations. -/
theorem sub_jetPivotInclusion_elimination_mem_relationIdeal
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F)
    (P : DifferentialPolynomial (B ⊕ R) F) :
    P - differentialJetPivotInclusion (differentialJetPivotElimination J P) ∈
      differentialJetPivotRelationIdeal J := by
  classical
  let I := differentialJetPivotRelationIdeal J
  induction P using MvPolynomial.induction_on with
  | C a =>
      change MvPolynomial.C a - differentialJetPivotInclusion
        (differentialJetPivotElimination J (MvPolynomial.C a)) ∈ I
      simp [differentialJetPivotElimination, differentialJetPivotInclusion]
  | add P Q hP hQ =>
      change P + Q - differentialJetPivotInclusion
        (differentialJetPivotElimination J (P + Q)) ∈ I
      have hadd := I.add_mem hP hQ
      convert hadd using 1; simp; ring
  | mul_X P q hP =>
      rcases q with ⟨i, n⟩
      cases i with
      | inl b =>
          have hmul := Ideal.mul_mem_right (MvPolynomial.X (Sum.inl b, n)) I hP
          convert hmul using 1; simp; ring
      | inr r =>
          have hgen : differentialJetPivotRelation J r n ∈ I :=
            Ideal.subset_span (Set.mem_range_self (r, n))
          have hmul₁ := Ideal.mul_mem_right (MvPolynomial.X (Sum.inr r, n)) I hP
          have hmul₂ := Ideal.mul_mem_left I
            (differentialJetPivotInclusion (differentialJetPivotElimination J P)) hgen
          have hsum := I.add_mem hmul₁ hmul₂
          convert hsum using 1; simp [differentialJetPivotRelation]; ring

/-- The pivot relation ideal is exactly the elimination kernel. -/
theorem differentialJetPivotRelationIdeal_eq_ker
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) :
    differentialJetPivotRelationIdeal J =
      RingHom.ker (differentialJetPivotElimination J).toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨r, n⟩, rfl⟩
    change differentialJetPivotElimination J (differentialJetPivotRelation J r n) = 0
    exact differentialJetPivotElimination_relation J r n
  · intro P hP
    have helim : differentialJetPivotElimination J P = 0 := RingHom.mem_ker.mp hP
    have hnormal := sub_jetPivotInclusion_elimination_mem_relationIdeal J P
    simpa [helim] using hnormal

/-- **PBW normal form.**  Quotienting the full jet polynomial algebra by the displayed relations
gives exactly the free polynomial algebra on the pivot jets. -/
noncomputable def differentialJetPivotQuotientEquiv
    {F B R : Type*} [Field F] (J : R → ℕ → DifferentialPolynomial B F) :
    (DifferentialPolynomial (B ⊕ R) F ⧸ differentialJetPivotRelationIdeal J) ≃ₐ[F]
      DifferentialPolynomial B F :=
  (Ideal.quotientEquivAlgOfEq F (differentialJetPivotRelationIdeal_eq_ker J)).trans
    (Ideal.quotientKerAlgEquivOfSurjective (differentialJetPivotElimination_surjective J))

/-- Evaluation of the combined family factors through pivot elimination. -/
theorem differentialPolynomialEval_sumElim_eq_jetPivotElimination
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (J : R → ℕ → DifferentialPolynomial B F)
    (hrel : ∀ r n, differentialJet n (y r) =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1)) (J r n))
    (P : DifferentialPolynomial (B ⊕ R) F) :
    differentialPolynomialEval (C := F) (Sum.elim x y) P =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))
        (differentialJetPivotElimination J P) := by
  let left := differentialPolynomialEval (C := F) (Sum.elim x y)
  let right := (MvPolynomial.aeval
    (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))).comp (differentialJetPivotElimination J)
  have heq : left = right := by
    apply MvPolynomial.algHom_ext
    rintro ⟨i, n⟩
    cases i with
    | inl b => simp [left, right, differentialPolynomialEval]
    | inr r =>
        simp only [left, right, differentialPolynomialEval_X, Sum.elim_inr,
          AlgHom.coe_comp, Function.comp_apply, differentialJetPivotElimination_X_inr]
        exact hrel r n
  exact AlgHom.congr_fun heq P

/-- **Complete pivot relation theorem.**  If the pivot family is differentially independent and
each dependent jet evaluates to the prescribed pivot expression, the displayed relations generate
every relation of the combined family. -/
theorem differentialRelationIdeal_sumElim_eq_jetPivot
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (J : R → ℕ → DifferentialPolynomial B F)
    (hx : DifferentialIndependent F x)
    (hrel : ∀ r n, differentialJet n (y r) =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1)) (J r n)) :
    differentialRelationIdeal (C := F) (Sum.elim x y) = differentialJetPivotRelationIdeal J := by
  rw [differentialJetPivotRelationIdeal_eq_ker]
  ext P
  rw [mem_differentialRelationIdeal_iff, RingHom.mem_ker]
  rw [differentialPolynomialEval_sumElim_eq_jetPivotElimination x y J hrel P]
  constructor
  · intro hzero
    unfold DifferentialIndependent at hx
    exact hx.eq_zero_of_aeval_eq_zero _ hzero
  · intro hzero
    change differentialJetPivotElimination J P = 0 at hzero
    rw [hzero]
    exact map_zero _

end

end GaloisForLFunctions.HTGeometry
