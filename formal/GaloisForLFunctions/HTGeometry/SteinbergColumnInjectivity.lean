import GaloisForLFunctions.HTGeometry.SteinbergElementaryGroup

/-!
# The column subgroup of the Steinberg group, in normal form

Milnor's centrality argument for `K_2` needs two facts about the abelian subgroup generated by the
generators with a fixed second index: that it is abelian, and that the map to the matrices is
injective on it.  The first is already proved.  This module supplies the second, by giving the
column subgroup an explicit normal form.

Every element of the column subgroup is a single product

```text
columnElt j b = ∏_k x_kj(b k)
```

over the commuting column generators, the product is additive in the coefficient vector, and its
image in the matrices is `1 + Σ_k b_k E_kj`.  Since a column sum vanishes only when all its
coefficients do, the map is injective on the column subgroup.
-/

noncomputable section

open Matrix

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n]

/-! ## The column element -/

/-- The column generator at an index, trivial at the column index itself. -/
def columnGen (j k : n) (a : R) : SteinbergGroup R n :=
  if h : k = j then 1 else steinbergX h a

theorem columnGen_self (j : n) (a : R) : columnGen j j a = 1 := by
  rw [columnGen, dif_pos rfl]

theorem columnGen_of_ne {j k : n} (h : k ≠ j) (a : R) : columnGen j k a = steinbergX h a := by
  rw [columnGen, dif_neg h]

theorem columnGen_zero (j k : n) : columnGen j k (0 : R) = 1 := by
  rw [columnGen]
  split_ifs with h
  · rfl
  · exact steinbergX_zero h

theorem columnGen_mul (j k : n) (a b : R) :
    columnGen j k (a + b) = columnGen j k a * columnGen j k b := by
  rw [columnGen, columnGen, columnGen]
  split_ifs with h
  · rw [one_mul]
  · exact (steinbergX_mul h a b).symm

theorem columnGen_commute (j k l : n) (a b : R) :
    Commute (columnGen j k a) (columnGen (R := R) j l b) := by
  rw [columnGen, columnGen]
  split_ifs with hk hl hl
  · exact Commute.one_left _
  · exact Commute.one_left _
  · exact Commute.one_right _
  · exact steinbergX_commute_col hk hl a b

theorem noncommProd_eq_one {G : Type*} [Group G] (s : Finset n) (f : n → G)
    (hf : ∀ l ∈ s, f l = 1)
    (comm : (↑s : Set n).Pairwise (Function.onFun Commute f)) :
    Finset.noncommProd s f comm = 1 := by
  classical
  induction s using Finset.cons_induction with
  | empty => simp
  | cons a t ha ih =>
      rw [Finset.noncommProd_cons, hf a (Finset.mem_cons_self a t),
        ih (fun l hl => hf l (Finset.mem_cons_of_mem hl))
          (fun x hx y hy hxy => comm (by simp [hx]) (by simp [hy]) hxy), one_mul]

variable [Fintype n]

/-- The column element with prescribed coefficients. -/
def columnElt (j : n) (b : n → R) : SteinbergGroup R n :=
  Finset.noncommProd Finset.univ (fun k => columnGen j k (b k))
    (fun k _ l _ _ => columnGen_commute j k l (b k) (b l))

theorem columnElt_zero (j : n) : columnElt j (0 : n → R) = 1 := by
  rw [columnElt]
  refine noncommProd_eq_one _ _ (fun k _ => ?_) _
  exact columnGen_zero j k

theorem columnElt_mul (j : n) (b c : n → R) :
    columnElt j (b + c) = columnElt j b * columnElt j c := by
  rw [columnElt, columnElt, columnElt]
  have hfun : (fun k => columnGen j k ((b + c) k))
      = (fun k => columnGen j k (b k)) * (fun k => columnGen j k (c k)) := by
    funext k
    exact columnGen_mul j k (b k) (c k)
  rw [Finset.noncommProd_congr rfl (fun k _ => congrFun hfun k)]
  refine Finset.noncommProd_mul_distrib _ _ _ _ ?_
  intro x _ y _ _
  exact columnGen_commute j x y (c x) (b y)

theorem columnElt_neg (j : n) (b : n → R) : columnElt j (-b) = (columnElt j b)⁻¹ := by
  have h := columnElt_mul j (-b) b
  rw [neg_add_cancel, columnElt_zero] at h
  exact eq_inv_of_mul_eq_one_left h.symm

/-! ## The image in the matrices -/

theorem steinbergToGL_columnGen (j k : n) (a : R) :
    ((steinbergToGL (columnGen j k a) : (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + Matrix.single k j (if k = j then 0 else a) := by
  rw [columnGen]
  split_ifs with h
  · subst h
    simp
  · rw [steinbergToGL_x h a, elemUnit_val, Matrix.transvection]

theorem steinbergToGL_noncommProd (j : n) (b : n → R) (s : Finset n)
    (comm : (↑s : Set n).Pairwise (Function.onFun Commute (fun k => columnGen j k (b k)))) :
    ((steinbergToGL (Finset.noncommProd s (fun k => columnGen j k (b k)) comm) :
        (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + ∑ k ∈ s, Matrix.single k j (if k = j then 0 else b k) := by
  classical
  induction s using Finset.cons_induction with
  | empty => simp
  | cons a s ha ih =>
      rw [Finset.noncommProd_cons]
      have hcomm : (↑s : Set n).Pairwise
          (Function.onFun Commute (fun k => columnGen j k (b k))) :=
        fun x hx y hy hxy => comm (by simp [hx]) (by simp [hy]) hxy
      rw [map_mul, Units.val_mul, steinbergToGL_columnGen, ih hcomm, Finset.sum_cons]
      have hzero : ∀ k ∈ s, (Matrix.single a j (if a = j then 0 else b a) : Matrix n n R)
          * Matrix.single k j (if k = j then 0 else b k) = 0 := by
        intro k hk
        by_cases hkj : k = j
        · subst hkj
          simp
        · simp [Ne.symm hkj]
      have hcross : (Matrix.single a j (if a = j then 0 else b a) : Matrix n n R)
          * ∑ k ∈ s, Matrix.single k j (if k = j then 0 else b k) = 0 := by
        rw [Finset.mul_sum]
        exact Finset.sum_eq_zero hzero
      rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one, hcross]
      simp only [Matrix.one_mul]
      abel

theorem steinbergToGL_columnElt (j : n) (b : n → R) :
    ((steinbergToGL (columnElt j b) : (Matrix n n R)ˣ) : Matrix n n R)
      = 1 + ∑ k, Matrix.single k j (if k = j then 0 else b k) :=
  steinbergToGL_noncommProd j b Finset.univ _

/-- **The column element is trivial exactly when its coefficients are.** -/
theorem columnElt_eq_one_of_image (j : n) (b : n → R)
    (h : steinbergToGL (columnElt j b) = 1) : columnElt j b = 1 := by
  have hval : ((steinbergToGL (columnElt j b) : (Matrix n n R)ˣ) : Matrix n n R) = 1 := by
    rw [h]
    rfl
  rw [steinbergToGL_columnElt] at hval
  have hsum : (∑ k, Matrix.single k j (if k = j then 0 else b k) : Matrix n n R) = 0 := by
    have h2 : (1 : Matrix n n R) + ∑ k, Matrix.single k j (if k = j then 0 else b k)
        = 1 + 0 := by
      rw [hval, add_zero]
    exact add_left_cancel h2
  have hzero := (sum_single_col_eq_zero_iff (j := j) (fun k => if k = j then 0 else b k)).1 hsum
  rw [columnElt]
  have hone : ∀ k ∈ Finset.univ, columnGen j k (b k) = (1 : SteinbergGroup R n) := by
    intro k _
    by_cases hk : k = j
    · rw [hk, columnGen_self]
    · have : b k = 0 := by
        have := hzero k
        rwa [if_neg hk] at this
      rw [this, columnGen_zero]
  exact noncommProd_eq_one _ _ hone _

/-! ## The column subgroup is the range -/

/-- The column elements form a subgroup. -/
def columnRange (j : n) : Subgroup (SteinbergGroup R n) where
  carrier := Set.range (columnElt j)
  mul_mem' := by
    rintro _ _ ⟨b, rfl⟩ ⟨c, rfl⟩
    exact ⟨b + c, columnElt_mul j b c⟩
  one_mem' := ⟨0, columnElt_zero j⟩
  inv_mem' := by
    rintro _ ⟨b, rfl⟩
    exact ⟨-b, columnElt_neg j b⟩

theorem steinbergX_mem_columnRange {k j : n} (hkj : k ≠ j) (a : R) :
    steinbergX hkj a ∈ columnRange (R := R) (n := n) j := by
  refine ⟨Pi.single k a, ?_⟩
  rw [columnElt]
  have hins : (Finset.univ : Finset n) = insert k (Finset.univ.erase k) :=
    (Finset.insert_erase (Finset.mem_univ k)).symm
  have hrest : ∀ l ∈ Finset.univ.erase k,
      columnGen (R := R) j l ((Pi.single k a : n → R) l) = 1 := by
    intro l hl
    have hlk : l ≠ k := Finset.ne_of_mem_erase hl
    rw [Pi.single_eq_of_ne hlk, columnGen_zero]
  rw [Finset.noncommProd_congr hins (fun l _ => rfl)]
  rw [Finset.noncommProd_insert_of_notMem _ _ _ _ (Finset.notMem_erase k _)]
  rw [noncommProd_eq_one _ _ hrest, mul_one, Pi.single_eq_same, columnGen_of_ne hkj]

omit [Fintype n] in
theorem noncommProd_mem_subgroup (s : Finset n) (f : n → SteinbergGroup R n)
    (H : Subgroup (SteinbergGroup R n)) (hf : ∀ l ∈ s, f l ∈ H)
    (comm : (↑s : Set n).Pairwise (Function.onFun Commute f)) :
    Finset.noncommProd s f comm ∈ H := by
  classical
  induction s using Finset.cons_induction with
  | empty =>
      rw [Finset.noncommProd_empty]
      exact H.one_mem
  | cons a t ha ih =>
      rw [Finset.noncommProd_cons]
      exact H.mul_mem (hf a (Finset.mem_cons_self a t))
        (ih (fun l hl => hf l (Finset.mem_cons_of_mem hl))
          (fun x hx y hy hxy => comm (by simp [hx]) (by simp [hy]) hxy))

omit [Fintype n] in
theorem columnGen_mem_columnSubgroup (j k : n) (a : R) :
    columnGen j k a ∈ columnSubgroup (R := R) (n := n) j := by
  by_cases hk : k = j
  · rw [hk, columnGen_self]
    exact Subgroup.one_mem _
  · rw [columnGen_of_ne hk]
    exact steinbergX_mem_columnSubgroup hk a

/-- **The column subgroup is exactly the set of column elements.** -/
theorem columnSubgroup_eq_columnRange (j : n) :
    columnSubgroup (R := R) (n := n) j = columnRange (R := R) (n := n) j := by
  refine le_antisymm ?_ ?_
  · rw [columnSubgroup]
    refine Subgroup.closure_le _ |>.2 ?_
    rintro x ⟨k, hkj, a, rfl⟩
    exact steinbergX_mem_columnRange hkj a
  · rintro _ ⟨b, rfl⟩
    rw [columnElt]
    exact noncommProd_mem_subgroup _ _ _ (fun l _ => columnGen_mem_columnSubgroup j l (b l)) _

/-- **The map to the matrices is injective on the column subgroup.**  This is the second of the two
facts Milnor's centrality argument turns on. -/
theorem steinbergToGL_injOn_columnSubgroup (j : n) :
    Set.InjOn (steinbergToGL (R := R) (n := n))
      (columnSubgroup (R := R) (n := n) j : Set (SteinbergGroup R n)) := by
  intro x hx y hy hxy
  have hmem : x * y⁻¹ ∈ columnSubgroup (R := R) (n := n) j :=
    Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hy)
  rw [columnSubgroup_eq_columnRange] at hmem
  obtain ⟨b, hb⟩ := hmem
  have himg : steinbergToGL (columnElt j b) = 1 := by
    rw [hb, map_mul, map_inv, hxy, mul_inv_cancel]
  have hone := columnElt_eq_one_of_image j b himg
  rw [hone] at hb
  exact (mul_inv_eq_one.1 hb.symm)

end GaloisForLFunctions.HTGeometry

end
