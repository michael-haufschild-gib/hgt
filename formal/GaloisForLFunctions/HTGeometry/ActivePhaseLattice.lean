import GaloisForLFunctions.HTGeometry.TorusOrbitPolyannulusUniqueness
import Mathlib.Analysis.Fourier.AddCircleMulti

/-!
# The active lattice of a phase observable and its stabilizer

The Laurent coefficients of a function holomorphic on a polyannulus are the
Fourier coefficients of its restriction to the product torus, so the *active
lattice* — the subgroup generated by the exponents actually present — can be
defined by torus Fourier analysis alone.

Two holomorphic functions on a polyannulus with the same active coefficients
agree: the multivariate Fourier monomials form a Hilbert basis of `L²` of the
torus, so their torus restrictions agree, and the torus is a uniqueness set for
the polyannulus.

Multiplicative translation by a torus point multiplies the `m`-th active
coefficient by the character `m`.  Consequently a torus point fixes the phase
observable exactly when every active character is trivial on it: the symmetry
group of a phase observable is the annihilator of its active lattice.
-/

open Complex Set Filter Topology MeasureTheory

attribute [local instance] instMeasureSpaceUnitAddCircle

local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

local instance : Measure.IsAddHaarMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (Measure.IsAddHaarMeasure AddCircle.haarAddCircle)

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {d : Type} [Fintype d] [DecidableEq d]

/-! ### Fourier uniqueness on the product torus -/

omit [DecidableEq d] in
/-- **Fourier uniqueness.**  Two continuous functions on the product torus with
the same Fourier coefficients are equal.  The multivariate monomials form a
Hilbert basis of `L²`, and a continuous function is determined by its class. -/
theorem eq_of_mFourierCoeff_eq {f g : C(UnitAddTorus d, ℂ)}
    (h : ∀ m, UnitAddTorus.mFourierCoeff (⇑f) m =
      UnitAddTorus.mFourierCoeff (⇑g) m) :
    ∀ x, f x = g x := by
  have hrepr : (UnitAddTorus.mFourierBasis (d := d)).repr
        (ContinuousMap.toLp 2 (volume : Measure (UnitAddTorus d)) ℂ f) =
      (UnitAddTorus.mFourierBasis (d := d)).repr
        (ContinuousMap.toLp 2 (volume : Measure (UnitAddTorus d)) ℂ g) := by
    ext i
    rw [UnitAddTorus.mFourierBasis_repr, UnitAddTorus.mFourierBasis_repr,
      UnitAddTorus.mFourierCoeff_toLp, UnitAddTorus.mFourierCoeff_toLp, h i]
  have hLp : ContinuousMap.toLp 2 (volume : Measure (UnitAddTorus d)) ℂ f =
      ContinuousMap.toLp 2 (volume : Measure (UnitAddTorus d)) ℂ g :=
    (UnitAddTorus.mFourierBasis (d := d)).repr.injective hrepr
  have hfg : f = g :=
    ContinuousMap.toLp_injective (E := ℂ) (volume : Measure (UnitAddTorus d))
      (p := 2) (𝕜 := ℂ) hLp
  intro x
  rw [hfg]

/-! ### Characters of the product torus -/

theorem fourier_neg_point (n : ℤ) (x : UnitAddCircle) :
    fourier n (-x) = fourier (-n) x := by
  rw [fourier_apply, fourier_apply, smul_neg, ← neg_smul]

theorem fourier_add_point (n : ℤ) (x y : UnitAddCircle) :
    fourier n (x + y) = fourier n x * fourier n y := by
  rw [fourier_apply, fourier_apply, fourier_apply, smul_add,
    AddCircle.toCircle_add, Circle.coe_mul]

omit [DecidableEq d] in
theorem mFourier_add_point (n : d → ℤ) (x y : UnitAddTorus d) :
    UnitAddTorus.mFourier n (x + y) =
      UnitAddTorus.mFourier n x * UnitAddTorus.mFourier n y := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Pi.add_apply]
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun j _ => fourier_add_point _ _ _

omit [DecidableEq d] in
theorem mFourier_apply_zero (n : d → ℤ) :
    UnitAddTorus.mFourier n (0 : UnitAddTorus d) = 1 := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Pi.zero_apply]
  simp

omit [DecidableEq d] in
theorem mFourier_neg_point (n : d → ℤ) (y : UnitAddTorus d) :
    UnitAddTorus.mFourier (-n) (-y) = UnitAddTorus.mFourier n y := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Pi.neg_apply]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [fourier_neg_point (-(n j)) (y j), neg_neg]

/-! ### The torus restriction of a phase observable -/

omit [Fintype d] [DecidableEq d] in
theorem circleCoords_mem_unitTorus (x : UnitAddTorus d) :
    circleCoords x ∈ unitTorus d := by
  intro j
  rw [circleCoords, fourier_apply]
  exact Circle.norm_coe _

/-- The restriction of a phase observable to the product torus. -/
def torusRestriction (F : (d → ℂ) → ℂ) : UnitAddTorus d → ℂ :=
  fun x => F (circleCoords x)

omit [DecidableEq d] in
theorem continuous_torusRestriction {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j)
    {F : (d → ℂ) → ℂ} (hF : AnalyticOnNhd ℂ F (polyannulus ρ)) :
    Continuous (torusRestriction F) := by
  refine continuous_iff_continuousAt.2 fun x => ?_
  have hmem : circleCoords x ∈ polyannulus ρ :=
    unitTorus_subset_polyannulus hρ (circleCoords_mem_unitTorus x)
  exact ((hF _ hmem).continuousAt).comp continuous_circleCoords.continuousAt

/-- The torus restriction as a bundled continuous map. -/
def torusRestrictionC {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j) (F : (d → ℂ) → ℂ)
    (hF : AnalyticOnNhd ℂ F (polyannulus ρ)) : C(UnitAddTorus d, ℂ) :=
  ⟨torusRestriction F, continuous_torusRestriction hρ hF⟩

/-! ### Active coefficients and the active lattice -/

/-- The `m`-th active coefficient of a phase observable: the Fourier
coefficient of its torus restriction.  For a function holomorphic on the
polyannulus this is its `m`-th Laurent coefficient. -/
def activeCoeff (F : (d → ℂ) → ℂ) (m : d → ℤ) : ℂ :=
  UnitAddTorus.mFourierCoeff (torusRestriction F) m

/-- The exponents actually present in a phase observable. -/
def activeSupport (F : (d → ℂ) → ℂ) : Set (d → ℤ) := {m | activeCoeff F m ≠ 0}

/-- The active lattice: the subgroup of exponents generated by the support. -/
def activeLattice (F : (d → ℂ) → ℂ) : Submodule ℤ (d → ℤ) :=
  Submodule.span ℤ (activeSupport F)

/-- **The active coefficients determine the phase observable.** -/
theorem eqOn_polyannulus_of_activeCoeff_eq {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j)
    {F G : (d → ℂ) → ℂ} (hF : AnalyticOnNhd ℂ F (polyannulus ρ))
    (hG : AnalyticOnNhd ℂ G (polyannulus ρ))
    (h : ∀ m, activeCoeff F m = activeCoeff G m) :
    ∀ z ∈ polyannulus ρ, F z = G z := by
  have htorus : ∀ x : UnitAddTorus d,
      torusRestrictionC hρ F hF x = torusRestrictionC hρ G hG x :=
    eq_of_mFourierCoeff_eq (f := torusRestrictionC hρ F hF)
      (g := torusRestrictionC hρ G hG) h
  refine eqOn_polyannulus_of_eqOn_unitTorus hρ hF hG fun z hz => ?_
  obtain ⟨x, hx⟩ := unitTorus_subset_range_circleCoords hz
  rw [← hx]
  exact htorus x

/-! ### Multiplicative translation -/

/-- Multiplicative translation of the polyannulus by a torus point. -/
def torusScale (h z : d → ℂ) : d → ℂ := fun j => h j * z j

omit [Fintype d] [DecidableEq d] in
theorem torusScale_mem_polyannulus {ρ : d → ℝ} {h : d → ℂ}
    (hh : h ∈ unitTorus d) {z : d → ℂ} (hz : z ∈ polyannulus ρ) :
    torusScale h z ∈ polyannulus ρ := by
  intro j
  have hnorm : ‖torusScale h z j‖ = ‖z j‖ := by
    rw [torusScale, norm_mul, hh j, one_mul]
  rw [mem_logAnnulus_iff, hnorm]
  exact hz j

omit [DecidableEq d] in
theorem analyticOnNhd_torusScale (h : d → ℂ) (s : Set (d → ℂ)) :
    AnalyticOnNhd ℂ (torusScale h) s := by
  refine analyticOnNhd_pi_iff.mpr fun j => ?_
  exact analyticOnNhd_const.mul
    ((ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : d => ℂ) j).analyticOnNhd s)

omit [DecidableEq d] in
theorem analyticOnNhd_comp_torusScale {ρ : d → ℝ} {h : d → ℂ}
    (hh : h ∈ unitTorus d) {F : (d → ℂ) → ℂ}
    (hF : AnalyticOnNhd ℂ F (polyannulus ρ)) :
    AnalyticOnNhd ℂ (fun z => F (torusScale h z)) (polyannulus ρ) :=
  hF.comp (analyticOnNhd_torusScale h _) fun _ hz => torusScale_mem_polyannulus hh hz

omit [Fintype d] [DecidableEq d] in
theorem circleCoords_add (x y : UnitAddTorus d) :
    circleCoords (x + y) = torusScale (circleCoords x) (circleCoords y) := by
  funext j
  exact fourier_add_point 1 (x j) (y j)

omit [Fintype d] [DecidableEq d] in
theorem torusRestriction_comp_torusScale (F : (d → ℂ) → ℂ) (y : UnitAddTorus d) :
    torusRestriction (fun z => F (torusScale (circleCoords y) z)) =
      fun x => torusRestriction F (y + x) := by
  funext x
  rw [torusRestriction, torusRestriction, circleCoords_add]

omit [DecidableEq d] in
/-- **Translation multiplies the `m`-th Fourier coefficient by the character
`m`.** -/
theorem mFourierCoeff_translate (g : UnitAddTorus d → ℂ) (y : UnitAddTorus d)
    (m : d → ℤ) :
    UnitAddTorus.mFourierCoeff (fun x => g (y + x)) m =
      UnitAddTorus.mFourier m y * UnitAddTorus.mFourierCoeff g m := by
  set c : ℂ := UnitAddTorus.mFourier (-m) (-y) with hc
  have hone : c * UnitAddTorus.mFourier (-m) y = 1 := by
    rw [hc, ← mFourier_add_point, neg_add_cancel, mFourier_apply_zero]
  have hint : ∀ x : UnitAddTorus d,
      c • (UnitAddTorus.mFourier (-m) (y + x) • g (y + x))
        = UnitAddTorus.mFourier (-m) x • g (y + x) := by
    intro x
    rw [mFourier_add_point, smul_eq_mul, smul_eq_mul, smul_eq_mul]
    calc c * (UnitAddTorus.mFourier (-m) y * UnitAddTorus.mFourier (-m) x * g (y + x))
        = (c * UnitAddTorus.mFourier (-m) y) *
            (UnitAddTorus.mFourier (-m) x * g (y + x)) := by ring
      _ = UnitAddTorus.mFourier (-m) x * g (y + x) := by rw [hone, one_mul]
  have hkey : UnitAddTorus.mFourierCoeff (fun x => g (y + x)) m
      = c * UnitAddTorus.mFourierCoeff g m := by
    rw [UnitAddTorus.mFourierCoeff, UnitAddTorus.mFourierCoeff]
    calc ∫ x, UnitAddTorus.mFourier (-m) x • g (y + x)
        = ∫ x, c • (UnitAddTorus.mFourier (-m) (y + x) • g (y + x)) :=
          integral_congr_ae (Filter.Eventually.of_forall fun x => (hint x).symm)
      _ = ∫ u, c • (UnitAddTorus.mFourier (-m) u • g u) :=
          integral_add_left_eq_self
            (fun u => c • (UnitAddTorus.mFourier (-m) u • g u)) y
      _ = c * ∫ u, UnitAddTorus.mFourier (-m) u • g u := by
          rw [integral_smul, smul_eq_mul]
  rw [hkey, hc, mFourier_neg_point]

omit [DecidableEq d] in
theorem activeCoeff_comp_torusScale (F : (d → ℂ) → ℂ) (y : UnitAddTorus d)
    (m : d → ℤ) :
    activeCoeff (fun z => F (torusScale (circleCoords y) z)) m =
      UnitAddTorus.mFourier m y * activeCoeff F m := by
  rw [activeCoeff, torusRestriction_comp_torusScale, mFourierCoeff_translate,
    activeCoeff]

/-! ### The stabilizer of a phase observable -/

/-- **Equation `(20)`: the annihilator of the active lattice fixes the phase
observable.** -/
theorem eqOn_comp_torusScale_of_mFourier_eq_one {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j)
    {F : (d → ℂ) → ℂ} (hF : AnalyticOnNhd ℂ F (polyannulus ρ))
    {y : UnitAddTorus d}
    (h : ∀ m ∈ activeSupport F, UnitAddTorus.mFourier m y = 1) :
    ∀ z ∈ polyannulus ρ, F (torusScale (circleCoords y) z) = F z := by
  refine eqOn_polyannulus_of_activeCoeff_eq hρ
    (analyticOnNhd_comp_torusScale (circleCoords_mem_unitTorus y) hF) hF fun m => ?_
  rw [activeCoeff_comp_torusScale]
  by_cases hm : activeCoeff F m = 0
  · rw [hm, mul_zero]
  · rw [h m hm, one_mul]

omit [DecidableEq d] in
/-- **Equation `(21)`: a torus point fixing the phase observable annihilates
every active character.** -/
theorem mFourier_eq_one_of_eqOn_comp_torusScale {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j)
    {F : (d → ℂ) → ℂ} {y : UnitAddTorus d}
    (h : ∀ z ∈ polyannulus ρ, F (torusScale (circleCoords y) z) = F z) :
    ∀ m ∈ activeSupport F, UnitAddTorus.mFourier m y = 1 := by
  have hcoeff : ∀ m, activeCoeff (fun z => F (torusScale (circleCoords y) z)) m
      = activeCoeff F m := by
    intro m
    have hres : torusRestriction (fun z => F (torusScale (circleCoords y) z))
        = torusRestriction F := by
      funext x
      exact h _ (unitTorus_subset_polyannulus hρ (circleCoords_mem_unitTorus x))
    rw [activeCoeff, activeCoeff, hres]
  intro m hm
  have hc := hcoeff m
  rw [activeCoeff_comp_torusScale] at hc
  have h1 : UnitAddTorus.mFourier m y * activeCoeff F m = 1 * activeCoeff F m := by
    rw [hc, one_mul]
  exact mul_right_cancel₀ hm h1

/-- **The symmetry group of a phase observable is the annihilator of its active
lattice.** -/
theorem eqOn_comp_torusScale_iff {ρ : d → ℝ} (hρ : ∀ j, 0 < ρ j)
    {F : (d → ℂ) → ℂ} (hF : AnalyticOnNhd ℂ F (polyannulus ρ))
    (y : UnitAddTorus d) :
    (∀ z ∈ polyannulus ρ, F (torusScale (circleCoords y) z) = F z) ↔
      ∀ m ∈ activeSupport F, UnitAddTorus.mFourier m y = 1 :=
  ⟨fun h => mFourier_eq_one_of_eqOn_comp_torusScale hρ h,
    fun h => eqOn_comp_torusScale_of_mFourier_eq_one hρ hF h⟩

end

end GaloisForLFunctions.HTGeometry
