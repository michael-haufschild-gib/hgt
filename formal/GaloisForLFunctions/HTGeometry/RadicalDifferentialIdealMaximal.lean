import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealZorn

/-!
# Maximal proper radical differential ideals are prime

A chain of proper radical differential ideals has a proper radical differential supremum, so Zorn
gives a maximal one above any proper radical differential ideal.  Such a maximal ideal is prime: if
`a b ∈ M` with `a, b ∉ M`, the radical differential ideals generated by `M ∪ {a}` and `M ∪ {b}` are
the whole ring, and the product law puts `1 = 1 · 1` inside `M`.

Consequently every proper radical differential ideal is contained in a prime differential ideal —
the first step of the differential Nullstellensatz, and the reason a consistent differential system
has a solution in a differential field extension.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {R : Type*} [CommRing R] [Differential R]

/-- **Existence of a maximal proper radical differential ideal above a proper one.** -/
theorem exists_maximal_proper_radicalDifferential {I₀ : Ideal R} (hrad : I₀.IsRadical)
    (hδ : ∀ x ∈ I₀, Differential.deriv x ∈ I₀) (hne : I₀ ≠ ⊤) :
    ∃ M : Ideal R, M.IsRadical ∧ (∀ x ∈ M, Differential.deriv x ∈ M) ∧ I₀ ≤ M ∧ M ≠ ⊤ ∧
      ∀ J : Ideal R, J.IsRadical → (∀ x ∈ J, Differential.deriv x ∈ J) → M ≤ J → J ≠ ⊤ →
        J = M := by
  classical
  set S : Set (Ideal R) :=
    {I : Ideal R | I.IsRadical ∧ (∀ x ∈ I, Differential.deriv x ∈ I) ∧ I₀ ≤ I ∧ I ≠ ⊤} with hS
  have hbound : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc
    rcases Set.eq_empty_or_nonempty c with rfl | hnec
    · exact ⟨I₀, ⟨hrad, hδ, le_rfl, hne⟩, by simp⟩
    refine ⟨sSup c, ⟨?_, ?_, ?_, ?_⟩, fun z hz => le_sSup hz⟩
    · intro y hy
      obtain ⟨n, hn⟩ := hy
      rw [Submodule.mem_sSup_of_directed hnec hc.directedOn] at hn ⊢
      obtain ⟨J, hJc, hJ⟩ := hn
      exact ⟨J, hJc, (hcS hJc).1 ⟨n, hJ⟩⟩
    · intro x hx
      rw [Submodule.mem_sSup_of_directed hnec hc.directedOn] at hx ⊢
      obtain ⟨J, hJc, hJ⟩ := hx
      exact ⟨J, hJc, (hcS hJc).2.1 x hJ⟩
    · obtain ⟨J, hJc⟩ := hnec
      exact le_trans (hcS hJc).2.2.1 (le_sSup hJc)
    · intro htop
      have hone : (1 : R) ∈ sSup c := by rw [htop]; trivial
      rw [Submodule.mem_sSup_of_directed hnec hc.directedOn] at hone
      obtain ⟨J, hJc, hJ⟩ := hone
      exact (hcS hJc).2.2.2 (Ideal.eq_top_of_isUnit_mem J hJ isUnit_one)
  obtain ⟨M, hM⟩ := zorn_le₀ S hbound
  refine ⟨M, hM.1.1, hM.1.2.1, hM.1.2.2.1, hM.1.2.2.2, ?_⟩
  intro J hJrad hJδ hle hJne
  have hJS : J ∈ S := ⟨hJrad, hJδ, le_trans hM.1.2.2.1 hle, hJne⟩
  have hJle : J ≤ M := hM.2 hJS hle
  exact le_antisymm hJle hle

/-- **A maximal proper radical differential ideal is prime.** -/
theorem isPrime_of_maximal_proper_radicalDifferential {M : Ideal R} (hrad : M.IsRadical)
    (hδ : ∀ x ∈ M, Differential.deriv x ∈ M) (hne : M ≠ ⊤)
    (hmax : ∀ J : Ideal R, J.IsRadical → (∀ x ∈ J, Differential.deriv x ∈ J) → M ≤ J → J ≠ ⊤ →
      J = M) : M.IsPrime := by
  classical
  refine ⟨hne, ?_⟩
  intro a b hab
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨ha, hb⟩ := hcon
  have hgen : ∀ x : R, x ∉ M →
      (1 : R) ∈ radicalDifferentialIdeal ((M : Set R) ∪ {x}) := by
    intro x hx
    have hle : M ≤ radicalDifferentialIdeal ((M : Set R) ∪ {x}) := by
      intro y hy
      exact subset_radicalDifferentialIdeal _ (Or.inl hy)
    have hxmem : x ∈ radicalDifferentialIdeal ((M : Set R) ∪ {x}) :=
      subset_radicalDifferentialIdeal _ (Or.inr rfl)
    by_contra htop
    have heq := hmax (radicalDifferentialIdeal ((M : Set R) ∪ {x}))
      (isRadical_radicalDifferentialIdeal _) (deriv_mem_radicalDifferentialIdeal _) hle
      (fun hc => htop (by rw [hc]; trivial))
    rw [heq] at hxmem
    exact hx hxmem
  have hone : (1 : R) ∈ M := by
    have hprod : ∀ s ∈ ((M : Set R) ∪ {a}), ∀ t ∈ ((M : Set R) ∪ {b}), s * t ∈ M := by
      rintro s (hs | rfl) t (ht | rfl)
      · exact Ideal.mul_mem_right _ _ hs
      · exact Ideal.mul_mem_right _ _ hs
      · exact Ideal.mul_mem_left _ _ ht
      · exact hab
    have := mul_mem_of_forall_mul_mem hrad hδ hprod (hgen a ha) (hgen b hb)
    simpa using this
  exact hne (Ideal.eq_top_of_isUnit_mem M hone isUnit_one)

/-- **Every proper radical differential ideal is contained in a prime differential ideal.** -/
theorem exists_isPrime_radicalDifferential {I₀ : Ideal R} (hrad : I₀.IsRadical)
    (hδ : ∀ x ∈ I₀, Differential.deriv x ∈ I₀) (hne : I₀ ≠ ⊤) :
    ∃ P : Ideal R, P.IsPrime ∧ (∀ x ∈ P, Differential.deriv x ∈ P) ∧ I₀ ≤ P := by
  obtain ⟨M, hMrad, hMδ, hIM, hMne, hMmax⟩ :=
    exists_maximal_proper_radicalDifferential hrad hδ hne
  exact ⟨M, isPrime_of_maximal_proper_radicalDifferential hMrad hMδ hMne hMmax, hMδ, hIM⟩

end

end GaloisForLFunctions.HTGeometry
