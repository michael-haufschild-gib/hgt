import GaloisForLFunctions.HTGeometry.ArithmeticFunctionGeneralJacobian

/-!
# Polynomial coordinates inside the native Dirichlet-convolution algebra

Delta functions at a finite set of primes have the identity prime-evaluation
Jacobian. The native independence theorem therefore identifies their literal
convolution subalgebra with a polynomial ring, with no independence premise.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The native prime-column realization of one prime variable. -/
def paperPrimeCoordinate (p : Nat.Primes) : ArithmeticFunction ℂ :=
  arithmeticOfPrimeColumn fun q => if q = p then 1 else 0

@[simp] theorem paperPrimeCoordinate_apply_prime (p q : Nat.Primes) :
    paperPrimeCoordinate p (q : ℕ) = if q = p then 1 else 0 :=
  arithmeticOfPrimeColumn_apply_prime _ q

/-- Every nonzero coefficient of a prime coordinate is prime-supported. -/
theorem paperPrimeCoordinate_support (p : Nat.Primes) {n : ℕ}
    (h : paperPrimeCoordinate p n ≠ 0) : n.Prime :=
  arithmeticOfPrimeColumn_support _ h

/-- Native prime differentiation gives the exact coordinate Kronecker law. -/
theorem paperPrimeCoordinate_primeDeriv (p q : Nat.Primes) :
    primeDeriv (p : ℕ) (paperPrimeCoordinate q) =
      if p = q then 1 else 0 := by
  rw [primeDeriv_prime_supported (p : ℕ) p.2 _
    (fun n h => paperPrimeCoordinate_support q h), paperPrimeCoordinate_apply_prime]
  split_ifs <;> simp

/-- Every finite set of literal prime coordinates is algebraically independent. -/
theorem paperPrimeCoordinates_algebraicIndependent (S : Finset Nat.Primes) :
    AlgebraicIndependent ℂ (fun p : S => paperPrimeCoordinate p.1) := by
  classical
  apply algebraicIndependent_arithmeticFunctions_of_primeEvaluation
    (fun p : S => paperPrimeCoordinate p.1) (fun p => p.1)
  have hM : (Matrix.of (fun i j : S => paperPrimeCoordinate j.1 (i.1 : ℕ)) :
      Matrix S S ℂ) = 1 := by
    ext i j
    simp [Matrix.one_apply]
  rw [hM]
  simp

/-- The actual subalgebra of arithmetic functions generated by the selected primes. -/
def paperPrimePolynomialAlgebra (S : Finset Nat.Primes) : Subalgebra ℂ (ArithmeticFunction ℂ) :=
  Algebra.adjoin ℂ (Set.range fun p : S => paperPrimeCoordinate p.1)

/-- The paid polynomial presentation of the finite-prime convolution subalgebra. -/
def paperPrimePolynomialEquiv (S : Finset Nat.Primes) :
    MvPolynomial S ℂ ≃ₐ[ℂ] paperPrimePolynomialAlgebra S :=
  (paperPrimeCoordinates_algebraicIndependent S).aevalEquiv

/-- The polynomial chart evaluates into the literal native arithmetic-function algebra. -/
theorem paperPrimePolynomialEquiv_coe (S : Finset Nat.Primes) (P : MvPolynomial S ℂ) :
    (paperPrimePolynomialEquiv S P : ArithmeticFunction ℂ) =
      MvPolynomial.aeval (fun p : S => paperPrimeCoordinate p.1) P :=
  (paperPrimeCoordinates_algebraicIndependent S).algebraMap_aevalEquiv P

/-- A prime coordinate regarded as an element of its finite polynomial subalgebra. -/
def paperPrimePolynomialGenerator (S : Finset Nat.Primes) (p : S) :
    paperPrimePolynomialAlgebra S := paperPrimePolynomialEquiv S (MvPolynomial.X p)

@[simp] theorem paperPrimePolynomialGenerator_coe (S : Finset Nat.Primes) (p : S) :
    (paperPrimePolynomialGenerator S p : ArithmeticFunction ℂ) = paperPrimeCoordinate p.1 := by
  rw [paperPrimePolynomialGenerator, paperPrimePolynomialEquiv_coe, MvPolynomial.aeval_X]

/-- Enlarging the prime set enlarges the literal convolution subalgebra. -/
theorem paperPrimePolynomialAlgebra_mono {S T : Finset Nat.Primes} (h : S ⊆ T) :
    paperPrimePolynomialAlgebra S ≤ paperPrimePolynomialAlgebra T := by
  apply Algebra.adjoin_mono
  rintro _ ⟨p, rfl⟩
  exact ⟨⟨p.1, h p.2⟩, rfl⟩

end

end GaloisForLFunctions.HTGeometry
