import GaloisForLFunctions.HTGeometry.GradedTwistedCech

/-!
# Slicing a graded ring by a degree-zero nonzerodivisor

For a degree-zero element `g` of a graded ring `M`, multiplication by `g` is an endomorphism of the
twisted Čech datum of `𝒪(-e)`, and the quotient map `M → M/(g)` gives the short exact sequence
`0 → 𝒪_M(-e) →g 𝒪_M(-e) → 𝒪_{M/(g)}(-e) → 0` on every nonempty subset, as soon as `g` is a
nonzerodivisor on the localizations `M[w_s⁻¹]`.  The snake chase then gives the Čech exactness of the
slice from that of `M`.

* `HTGeometry.twMul0` : multiplication by a degree-zero element.
* `HTGeometry.twMul0_injective`, `HTGeometry.twMap_twMul0`, `HTGeometry.twMap_exact0`.
* `HTGeometry.twCech_slice_exactAt`.
-/

namespace HTGeometry

open DirectSum

universe u

variable {K : Type*} {M : Type u} [CommRing K] [CommRing M] [Algebra K M] {𝒜 : ℕ → Submodule K M}
  [GradedAlgebra 𝒜] {ι : Type*} {w : ι → M}

section Mul0

variable [DecidableEq ι] (hw : ∀ i, w i ∈ 𝒜 1) {g : M} (hg : g ∈ 𝒜 0)

omit [DecidableEq ι] in
include hg in
theorem algebraMap_mul_mem_twPart0 {s : Finset ι} {e : ℕ} {y : LocAt w s}
    (hy : y ∈ twPart 𝒜 w s e) : algebraMap M (LocAt w s) g * y ∈ twPart 𝒜 w s e := by
  refine (AddSubgroup.closure_le ((twPart 𝒜 w s e).comap
    (AddMonoidHom.mulLeft (algebraMap M (LocAt w s) g)))).mpr ?_ hy
  rintro _ ⟨m, i, x, hx, hdeg, rfl⟩
  change algebraMap M (LocAt w s) g * frac w s m x ∈ twPart 𝒜 w s e
  rw [algebraMap_mul_frac]
  exact frac_mem_twPart (by simpa using SetLike.mul_mem_graded hg hx) hdeg

/-- Multiplication by `g` on the twisted parts over one subset. -/
noncomputable def twMul0App (e : ℕ) (s : Finset ι) : twPart 𝒜 w s e →+ twPart 𝒜 w s e :=
  ((AddMonoidHom.mulLeft (algebraMap M (LocAt w s) g)).comp
    (twPart 𝒜 w s e).subtype).codRestrict _ (fun y => algebraMap_mul_mem_twPart0 hg y.2)

/-- **Multiplication by a degree-zero element**, `𝒪(-e) → 𝒪(-e)`. -/
noncomputable def twMul0 (e : ℕ) : (twCech 𝒜 w hw e).Hom (twCech 𝒜 w hw e) where
  app s := twMul0App hg e s
  comm h y := by
    apply twVal_injective hw
    change resLoc w h (algebraMap M (LocAt w _) g * twVal hw y)
      = algebraMap M (LocAt w _) g * resLoc w h (twVal hw y)
    rw [map_mul, resLoc_algebraMap]

theorem twMul0_app_val (e : ℕ) (s : Finset ι) (y : (twCech 𝒜 w hw e).obj s) :
    twVal hw ((twMul0 hw hg e).app s y) = algebraMap M (LocAt w s) g * twVal hw y := rfl

/-- **Multiplication by a nonzerodivisor is injective.** -/
theorem twMul0_injective (e : ℕ) {s : Finset ι}
    (hreg : algebraMap M (LocAt w s) g ∈ nonZeroDivisors (LocAt w s)) :
    Function.Injective ((twMul0 hw hg e).app s) := by
  intro y y' h
  have h' := congrArg (twVal hw) h
  rw [twMul0_app_val, twMul0_app_val] at h'
  exact twVal_injective hw ((mul_cancel_left_mem_nonZeroDivisors hreg).mp h')

end Mul0

section Map0

variable [DecidableEq ι] {M' : Type u} [CommRing M'] [Algebra K M'] {𝒜' : ℕ → Submodule K M'}
  [GradedAlgebra 𝒜'] {w' : ι → M'} (f : M →+* M') (hfw : ∀ i, f (w i) = w' i)
  (hf : ∀ i x, x ∈ 𝒜 i → f x ∈ 𝒜' i) (hw : ∀ i, w i ∈ 𝒜 1) (hw' : ∀ i, w' i ∈ 𝒜' 1)

/-- The composite `𝒪_M(-e) →g 𝒪_M(-e) → 𝒪_{M'}(-e)` vanishes when `f` kills `g`. -/
theorem twMap_twMul0 {g : M} (hg : g ∈ 𝒜 0) (hfg : f g = 0) (e : ℕ) (s : Finset ι)
    (y : (twCech 𝒜 w hw e).obj s) :
    (twMap f hfw hf hw hw' e).app s ((twMul0 hw hg e).app s y) = 0 := by
  apply twVal_injective hw'
  rw [twMap_app_val, twMul0_app_val, map_mul, locMap_algebraMap, hfg, map_zero, zero_mul]
  rfl

/-- **Middle exactness**: over a nonempty subset, a section of `𝒪_M(-e)` killed in `M'` is `g`
times a section, as soon as the kernel of `f` is generated by `g`. -/
theorem twMap_exact0 {g : M} (hg : g ∈ 𝒜 0) (hker : ∀ x, f x = 0 → ∃ z, x = g * z) (e : ℕ)
    {s : Finset ι} (hs : s.Nonempty) (y : (twCech 𝒜 w hw e).obj s)
    (hy : (twMap f hfw hf hw hw' e).app s y = 0) : ∃ z, (twMul0 hw hg e).app s z = y := by
  obtain ⟨m, i, x, hx, hdeg, hyx⟩ := (mem_twPart_iff hw hs).mp (y : twPart 𝒜 w s e).2
  have hy' : frac w' s m (f x) = 0 := by
    have := congrArg (twVal hw') hy
    rw [twMap_app_val] at this
    change locMap f hfw s (twVal hw y) = 0 at this
    rwa [show twVal hw y = frac w s m x from hyx, locMap_frac] at this
  rw [frac, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hy'
  obtain ⟨⟨_, k, rfl⟩, hk⟩ := hy'
  have hfk : f (wProd w s ^ k * x) = 0 := by
    rw [map_mul, map_pow, map_wProd f hfw]
    exact hk
  obtain ⟨z, hz⟩ := hker _ hfk
  have hmem : wProd w s ^ k * x ∈ 𝒜 (k * s.card + i) :=
    SetLike.mul_mem_graded (wProd_pow_mem hw s k) hx
  set z' : M := (decompose 𝒜 z (k * s.card + i) : M) with hz'
  have hz'mem : z' ∈ 𝒜 (k * s.card + i) := SetLike.coe_mem _
  have hprod : wProd w s ^ k * x = g * z' := by
    rw [← DirectSum.decompose_of_mem_same 𝒜 hmem, hz, DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜 hg]
  refine ⟨⟨frac w s (m + k) z', frac_mem_twPart hz'mem (by rw [add_mul]; omega)⟩, ?_⟩
  apply twVal_injective hw
  rw [twMul0_app_val]
  change algebraMap M (LocAt w s) g * frac w s (m + k) z' = twVal hw y
  rw [show twVal hw y = frac w s m x from hyx, algebraMap_mul_frac, ← hprod, frac_mul_pow]

include hfw hf in
/-- **The slice is Čech-exact**: if `𝒪_M(-e)` is Čech-exact in degrees `p` and `p + 1`, `g ∈ 𝒜_0`
is a nonzerodivisor on every `M[w_s⁻¹]` (`s ≠ ∅`), and `M' = M/(g)` (kernel generated by `g`,
homogeneous lifts), then `𝒪_{M'}(-e)` is Čech-exact in degree `p`. -/
theorem twCech_slice_exactAt [LinearOrder ι] {g : M} (hg : g ∈ 𝒜 0) (hfg : f g = 0)
    (hker : ∀ x, f x = 0 → ∃ z, x = g * z) (hlift : ∀ i x', x' ∈ 𝒜' i → ∃ x ∈ 𝒜 i, f x = x')
    (hreg : ∀ s : Finset ι, s.Nonempty →
      algebraMap M (LocAt w s) g ∈ nonZeroDivisors (LocAt w s))
    (e p : ℕ) (h1 : (twCech 𝒜 w hw e).ExactAt (p + 1)) (h0 : (twCech 𝒜 w hw e).ExactAt p) :
    (twCech 𝒜' w' hw' e).ExactAt p :=
  FinsetCechDatum.exactAt_of_chase (twMul0 hw hg e) (twMap f hfw hf hw hw' e) p
    (fun s _ x => twMap_twMul0 f hfw hf hw hw' hg hfg e s x)
    (fun s hs => twMap_surjective f hfw hf hw hw' hlift e (Finset.card_pos.mp (by omega)))
    (fun s hs y hy => twMap_exact0 f hfw hf hw hw' hg hker e (Finset.card_pos.mp (by omega)) y hy)
    (fun s hs => twMul0_injective hw hg e (hreg s (Finset.card_pos.mp (by omega))))
    h1 h0

end Map0

end HTGeometry
