import GaloisForLFunctions.HTGeometry.JetSchwarzian
import GaloisForLFunctions.HTGeometry.JetTopPartialSubstitution

/-!
# The top-coordinate descent tower

Two structural laws of the substitution endomorphism.

The shift satisfies the one-step recursion

`σ_{M+1} = δ(σ_M) + δ(R'(y₀))·y_M`,

which in weight-zero coordinates reads `s_{k+1} = ∇s_k + k·z₂·s_k + R''(y₀)·z_k`: the shift tower is
generated from `s₂ = R''(y₀)` by the covariant derivative `∇ + k·z₂` together with the coordinate
term.

Dually, an inhomogeneous relation `R'^κ·Φ(g) = R'·g − D` with `g` and `D` of jet order at most `N`
descends along the operator `g ↦ y₁^N·∂_N g`: the descended pair satisfies the same shape with the
exponent lowered by `N − 1`.  Iterating gives a tower of relations whose exponents run through an
arithmetic progression, and the inhomogeneous terms are the corresponding descents of `D`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-! ## The recursion for the shift -/

/-- **The shift recursion.**  Differentiating the affine presentation of the substitution on the
top coordinate once produces the next shift. -/
theorem substitutionShift_succ (R : RatFunc C) (M : ℕ) :
    substitutionShift R (M + 1)
      = JetField.jetDerivation (substitutionShift R M)
        + JetField.jet ((), 1) * JetField.pd ((), 0) (substitutionDeriv R)
          * JetField.jet ((), M) := by
  have hsucc : substitutionJet R (M + 1) = JetField.jetDerivation (substitutionJet R M) :=
    substitutionJet_succ R M
  have haff : substitutionJet R M
      = substitutionDeriv R * JetField.jet ((), M) + substitutionShift R M :=
    substitutionJet_eq_affine R M
  have hδρ : JetField.jetDerivation (substitutionDeriv R)
      = JetField.jet ((), 1) * JetField.pd ((), 0) (substitutionDeriv R) :=
    jetDerivation_of_order_zero (fun k hk => pd_substitutionDeriv_eq_zero R hk)
  have hleib := (JetField.jetDerivation (C := C) (ι := Unit)).leibniz
    (substitutionDeriv R) (JetField.jet ((), M))
  simp only [smul_eq_mul] at hleib
  rw [show substitutionShift R (M + 1)
      = substitutionJet R (M + 1) - substitutionDeriv R * JetField.jet ((), M + 1) from rfl,
    hsucc, haff, map_add, hleib, hδρ, JetField.jetDerivation_jet]
  ring

/-- The weight-zero derivation on a power of the first jet coordinate. -/
theorem jetNabla_pow_jet_one (k : ℕ) :
    jetNabla ((JetField.jet ((), 1) : JetField C Unit) ^ k)
      = (k : JetField C Unit) * (jetRatio 2 : JetField C Unit)
        * (JetField.jet ((), 1) : JetField C Unit) ^ k := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hnab1 : jetNabla (JetField.jet ((), 1) : JetField C Unit)
      = (jetRatio 2 : JetField C Unit) * (JetField.jet ((), 1) : JetField C Unit) := by
    rw [jetNabla_apply, JetField.jetDerivation_jet, jetRatio]
    field_simp
  have h := (jetNabla (C := C)).leibniz_pow (JetField.jet ((), 1) : JetField C Unit) k
  simp only [smul_eq_mul, hnab1] at h
  rw [h]
  rcases k with _ | i
  · simp
  · have hs : (JetField.jet ((), 1) : JetField C Unit) ^ (i + 1)
        = (JetField.jet ((), 1) : JetField C Unit) ^ i
          * (JetField.jet ((), 1) : JetField C Unit) := by rw [pow_succ]
    simp only [Nat.add_sub_cancel]
    rw [hs]
    push_cast
    ring

/-- The weight-zero derivation of a product with a power of the first jet coordinate. -/
theorem jetNabla_mul_pow_jet_one (k : ℕ) (v : JetField C Unit) :
    jetNabla (v * (JetField.jet ((), 1) : JetField C Unit) ^ k)
      = (jetNabla v + (k : JetField C Unit) * (jetRatio 2 : JetField C Unit) * v)
        * (JetField.jet ((), 1) : JetField C Unit) ^ k := by
  have h := (jetNabla (C := C)).leibniz v ((JetField.jet ((), 1) : JetField C Unit) ^ k)
  simp only [smul_eq_mul, jetNabla_pow_jet_one] at h
  rw [h]
  ring

/-- **The shift recursion in weight-zero coordinates.**  The tower of shifts is generated by the
covariant derivative `∇ + k·z₂` together with the coordinate term `R''(y₀)·z_k`. -/
theorem substitutionShiftRatio_succ (R : RatFunc C) (k : ℕ) :
    substitutionShiftRatio R (k + 1)
      = jetNabla (substitutionShiftRatio R k)
        + (k : JetField C Unit) * (jetRatio 2 : JetField C Unit) * substitutionShiftRatio R k
        + JetField.pd ((), 0) (substitutionDeriv R) * (jetRatio k : JetField C Unit) := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hσ : substitutionShift R k
      = substitutionShiftRatio R k * (JetField.jet ((), 1) : JetField C Unit) ^ k := by
    rw [substitutionShiftRatio]
    field_simp
  have hrec := substitutionShift_succ R k
  rw [hσ] at hrec
  have hnab := jetNabla_mul_pow_jet_one (C := C) k (substitutionShiftRatio R k)
  have hδ : JetField.jetDerivation (substitutionShiftRatio R k
        * (JetField.jet ((), 1) : JetField C Unit) ^ k)
      = (JetField.jet ((), 1) : JetField C Unit)
        * jetNabla (substitutionShiftRatio R k
          * (JetField.jet ((), 1) : JetField C Unit) ^ k) := by
    rw [jetNabla_apply]
    field_simp
  rw [hδ, hnab] at hrec
  have hzk : (jetRatio k : JetField C Unit) * (JetField.jet ((), 1) : JetField C Unit) ^ k
      = (JetField.jet ((), k) : JetField C Unit) := by
    rw [jetRatio]
    field_simp
  have hsr : substitutionShiftRatio R (k + 1)
      = substitutionShift R (k + 1) / (JetField.jet ((), 1) : JetField C Unit) ^ (k + 1) := rfl
  rw [hsr, hrec]
  rw [pow_succ]
  field_simp
  linear_combination (-(JetField.pd ((), 0) (substitutionDeriv R))) * hzk

/-! ## The descent operator -/

theorem pd_zpow_eq_zero {j : ℕ} {v : JetField C Unit}
    (hv : JetField.pd ((), j) v = 0) (κ : ℤ) :
    JetField.pd ((), j) (v ^ κ) = 0 := by
  have hpow : ∀ n : ℕ, JetField.pd ((), j) (v ^ n) = 0 := by
    intro n
    have hl := (JetField.pd ((), j) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz_pow v n
    rw [hv] at hl
    simpa using hl
  rcases (by omega : (0:ℤ) ≤ κ ∨ κ < 0) with hk | hk
  · lift κ to ℕ using hk with n
    rw [zpow_natCast]
    exact hpow n
  · have hk' : 0 ≤ -κ := by omega
    lift (-κ) to ℕ using hk' with n hn
    have hκ : κ = -(n : ℤ) := by omega
    have hz : v ^ κ = (v ^ n)⁻¹ := by rw [hκ, zpow_neg, zpow_natCast]
    rw [hz]
    have hli := (JetField.pd ((), j) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz_inv (v ^ n)
    rw [hli, hpow n]
    simp

/-- The weight-zero descent operator on the top jet coordinate. -/
def topDescent (N : ℕ) (g : JetField C Unit) : JetField C Unit :=
  (JetField.jet ((), 1) : JetField C Unit) ^ N * JetField.pd ((), N) g

theorem topDescent_order {N : ℕ} (hN : 1 ≤ N) {g : JetField C Unit}
    (hg : ∀ j : ℕ, N < j → JetField.pd ((), j) g = 0) :
    ∀ j : ℕ, N < j → JetField.pd ((), j) (topDescent N g) = 0 := by
  intro j hj
  have hleib := (JetField.pd ((), j) :
    Derivation C (JetField C Unit) (JetField C Unit)).leibniz
      ((JetField.jet ((), 1) : JetField C Unit) ^ N) (JetField.pd ((), N) g)
  simp only [smul_eq_mul] at hleib
  have h1 : JetField.pd ((), j) ((JetField.jet ((), 1) : JetField C Unit) ^ N) = 0 := by
    have hl := (JetField.pd ((), j) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz_pow
        (JetField.jet ((), 1) : JetField C Unit) N
    rw [JetField.pd_jet_of_ne (by simp only [ne_eq, Prod.mk.injEq, true_and]; omega)] at hl
    simpa using hl
  have h2 : JetField.pd ((), j) (JetField.pd ((), N) g) = 0 := by
    rw [pd_comm, hg j hj, map_zero]
  rw [topDescent, hleib, h1, h2, mul_zero, mul_zero, add_zero]

theorem topDescent_iterate_order {N : ℕ} (hN : 1 ≤ N) {g : JetField C Unit}
    (hg : ∀ j : ℕ, N < j → JetField.pd ((), j) g = 0) (k : ℕ) :
    ∀ j : ℕ, N < j → JetField.pd ((), j) ((topDescent (C := C) N)^[k] g) = 0 := by
  induction k with
  | zero => simpa using hg
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      exact topDescent_order hN ih

/-- **One step of the top-coordinate descent.**  Differentiating an inhomogeneous relation in the
top coordinate lowers the exponent by `N − 1` and replaces both sides by their descents. -/
theorem jetSubstitution_topDescent (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) {N : ℕ}
    (hN : 1 ≤ N) {g D : JetField C Unit}
    (hg : ∀ j : ℕ, N < j → JetField.pd ((), j) g = 0) {κ : ℤ}
    (heq : substitutionDeriv R ^ κ * jetSubstitution R hR g = substitutionDeriv R * g - D) :
    substitutionDeriv R ^ (κ + 1 - (N : ℤ)) * jetSubstitution R hR (topDescent N g)
      = substitutionDeriv R * topDescent N g - topDescent N D := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  set ρ : JetField C Unit := substitutionDeriv R with hρdef
  have hρ0 : ρ ≠ 0 := hR
  have hρpd : JetField.pd ((), N) ρ = 0 := pd_substitutionDeriv_eq_zero R (by omega)
  have hΦ1 : jetSubstitution R hR (JetField.jet ((), 1) : JetField C Unit)
      = (JetField.jet ((), 1) : JetField C Unit) * ρ := by
    rw [jetSubstitution_jet, substitutionJet_one]
  -- differentiate the relation in the top coordinate
  have hL : JetField.pd ((), N) (ρ ^ κ * jetSubstitution R hR g)
      = ρ ^ κ * (ρ * jetSubstitution R hR (JetField.pd ((), N) g)) := by
    have hleib := (JetField.pd ((), N) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz
        (ρ ^ κ) (jetSubstitution R hR g)
    simp only [smul_eq_mul] at hleib
    rw [hleib, pd_zpow_eq_zero hρpd κ, pd_top_jetSubstitution R hR hN hg, mul_zero, add_zero]
  have hRr : JetField.pd ((), N) (ρ * g - D)
      = ρ * JetField.pd ((), N) g - JetField.pd ((), N) D := by
    have hleib := (JetField.pd ((), N) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz ρ g
    simp only [smul_eq_mul] at hleib
    rw [map_sub, hleib, hρpd, mul_zero, add_zero]
  have hkey : ρ ^ κ * (ρ * jetSubstitution R hR (JetField.pd ((), N) g))
      = ρ * JetField.pd ((), N) g - JetField.pd ((), N) D := by
    rw [← hL, ← hRr, heq]
  -- reassemble
  have hΦD : jetSubstitution R hR (topDescent N g)
      = ((JetField.jet ((), 1) : JetField C Unit) * ρ) ^ N
        * jetSubstitution R hR (JetField.pd ((), N) g) := by
    rw [topDescent, map_mul, map_pow, hΦ1]
  have hz : ρ ^ (κ + 1 - (N : ℤ)) * ρ ^ (N : ℕ) = ρ ^ κ * ρ := by
    rw [← zpow_natCast ρ N, ← zpow_add₀ hρ0,
      show κ + 1 - (N : ℤ) + (N : ℤ) = κ + 1 from by ring, zpow_add₀ hρ0, zpow_one]
  rw [hΦD, topDescent, topDescent, mul_pow]
  calc ρ ^ (κ + 1 - (N : ℤ))
        * ((JetField.jet ((), 1) : JetField C Unit) ^ N * ρ ^ N
          * jetSubstitution R hR (JetField.pd ((), N) g))
      = (JetField.jet ((), 1) : JetField C Unit) ^ N
          * ((ρ ^ (κ + 1 - (N : ℤ)) * ρ ^ N)
            * jetSubstitution R hR (JetField.pd ((), N) g)) := by ring
    _ = (JetField.jet ((), 1) : JetField C Unit) ^ N
          * (ρ ^ κ * (ρ * jetSubstitution R hR (JetField.pd ((), N) g))) := by
        rw [hz]; ring
    _ = (JetField.jet ((), 1) : JetField C Unit) ^ N
          * (ρ * JetField.pd ((), N) g - JetField.pd ((), N) D) := by rw [hkey]
    _ = ρ * ((JetField.jet ((), 1) : JetField C Unit) ^ N * JetField.pd ((), N) g)
          - (JetField.jet ((), 1) : JetField C Unit) ^ N * JetField.pd ((), N) D := by ring

/-- **The descent tower.**  Iterating the top-coordinate descent produces relations whose exponents
run through the arithmetic progression `κ + k·(1 − N)`. -/
theorem jetSubstitution_topDescent_iterate (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) {N : ℕ}
    (hN : 1 ≤ N) {g D : JetField C Unit}
    (hg : ∀ j : ℕ, N < j → JetField.pd ((), j) g = 0) {κ : ℤ}
    (heq : substitutionDeriv R ^ κ * jetSubstitution R hR g = substitutionDeriv R * g - D)
    (k : ℕ) :
    substitutionDeriv R ^ (κ + (k : ℤ) * (1 - (N : ℤ)))
        * jetSubstitution R hR ((topDescent (C := C) N)^[k] g)
      = substitutionDeriv R * (topDescent (C := C) N)^[k] g
        - (topDescent (C := C) N)^[k] D := by
  induction k with
  | zero => simpa using heq
  | succ n ih =>
      have hstep := jetSubstitution_topDescent R hR hN
        (topDescent_iterate_order (C := C) hN hg n) ih
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
      rw [show (κ + ((n + 1 : ℕ) : ℤ) * (1 - (N : ℤ)))
        = (κ + (n : ℤ) * (1 - (N : ℤ))) + 1 - (N : ℤ) from by push_cast; ring]
      exact hstep

end

end GaloisForLFunctions.HTGeometry
