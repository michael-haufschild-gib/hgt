import GaloisForLFunctions.HTGeometry.JacobiWeylAlternative
import GaloisForLFunctions.HTGeometry.DiscreteSturmLiouvilleGreen

/-!
# Constructing Jacobi solutions

A half-line Jacobi recurrence with nonvanishing off-diagonal entries propagates any pair of initial
values, so the solution space is exactly two-dimensional, and the boundary equation at `0` cuts out
a one-dimensional subspace spanned by the polynomials of the first kind.  This file constructs
those solutions, records the real-to-complex transfer, and identifies a real Jacobi solution with a
discrete Sturm--Liouville solution whose potential is `Q_n = a_n + a_{n-1} + b_n − z`.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K : Type*} [Field K]

/-- The pair `(u n, u (n+1))` generated by the Jacobi recurrence from initial data. -/
def jacobiPair (a b : ℕ → K) (z u0 u1 : K) : ℕ → K × K
  | 0 => (u0, u1)
  | (n + 1) =>
      ((jacobiPair a b z u0 u1 n).2,
        ((z - b (n + 1)) * (jacobiPair a b z u0 u1 n).2
          - a n * (jacobiPair a b z u0 u1 n).1) / a (n + 1))

/-- The Jacobi solution with prescribed initial values. -/
def jacobiSol (a b : ℕ → K) (z u0 u1 : K) (n : ℕ) : K := (jacobiPair a b z u0 u1 n).1

variable {a b : ℕ → K} {z u0 u1 : K}

@[simp] theorem jacobiSol_zero : jacobiSol a b z u0 u1 0 = u0 := rfl

@[simp] theorem jacobiSol_one : jacobiSol a b z u0 u1 1 = u1 := rfl

theorem jacobiPair_snd (n : ℕ) :
    (jacobiPair a b z u0 u1 n).2 = jacobiSol a b z u0 u1 (n + 1) := rfl

theorem jacobiSol_succ_succ (n : ℕ) (ha : a (n + 1) ≠ 0) :
    a (n + 1) * jacobiSol a b z u0 u1 (n + 2)
      = (z - b (n + 1)) * jacobiSol a b z u0 u1 (n + 1) - a n * jacobiSol a b z u0 u1 n := by
  have h : jacobiSol a b z u0 u1 (n + 2)
      = ((z - b (n + 1)) * jacobiSol a b z u0 u1 (n + 1)
          - a n * jacobiSol a b z u0 u1 n) / a (n + 1) := rfl
  rw [h, mul_div_cancel₀ _ ha]

/-- **The constructed sequence solves the recurrence.** -/
theorem jacobiSol_rec (ha : ∀ n, a n ≠ 0) (n : ℕ) :
    a n * jacobiSol a b z u0 u1 n + b (n + 1) * jacobiSol a b z u0 u1 (n + 1)
      + a (n + 1) * jacobiSol a b z u0 u1 (n + 2) = z * jacobiSol a b z u0 u1 (n + 1) := by
  have h := jacobiSol_succ_succ (a := a) (b := b) (z := z) (u0 := u0) (u1 := u1) n (ha (n + 1))
  linear_combination h

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

/-- The real half-line Jacobi recurrence, without the left boundary equation. -/
def IsJacobiRecR (a b : ℕ → ℝ) (z : ℝ) (u : ℕ → ℝ) : Prop :=
  ∀ n : ℕ, a n * u n + b (n + 1) * u (n + 1) + a (n + 1) * u (n + 2) = z * u (n + 1)

variable {a b : ℕ → ℝ} {z : ℝ} {u : ℕ → ℝ}

theorem isJacobiRecR_jacobiSol (ha : ∀ n, a n ≠ 0) (u0 u1 : ℝ) :
    IsJacobiRecR a b z (jacobiSol a b z u0 u1) := fun n => jacobiSol_rec ha n

/-- A real solution is a complex solution. -/
theorem isJacobiRec_ofReal (h : IsJacobiRecR a b z u) :
    IsJacobiRec a b (z : ℂ) (fun n => (u n : ℂ)) := by
  intro n
  have hn := h n
  simp only []
  exact_mod_cast congrArg (fun t : ℝ => (t : ℂ)) hn

/-- A real Jacobi solution is a discrete Sturm--Liouville solution with potential
`Q_n = a_n + a_{n-1} + b_n − z`. -/
theorem isSLGSolution_of_jacobi {Q : ℕ → ℝ}
    (hQ : ∀ n : ℕ, Q (n + 1) = a (n + 1) + a n + b (n + 1) - z)
    (h : IsJacobiRecR a b z u) : IsSLGSolution a Q u := by
  intro n
  have hr := h n
  simp only [slgFlux, hQ n]
  linear_combination hr

/-- The cross-Wronskian of the two standard real solutions is `-a 0`. -/
theorem crossWronskian_standard :
    crossWronskian a (fun n => ((jacobiSol a b z 1 0 n : ℝ) : ℂ))
      (fun n => ((jacobiSol a b z 0 1 n : ℝ) : ℂ)) 0 = -(a 0 : ℂ) := by
  simp [crossWronskian]

end GaloisForLFunctions.HTGeometry
