import GaloisForLFunctions.HTGeometry.LBitRecurrenceConstraintLaw

/-!
# Exact free-Fock bridge to the l-bit recurrence law

The occupation spectrum of finitely many free fermionic modes is exactly a
one-body l-bit spectrum, including the constant-energy gauge.  This file
proves the coefficient dictionary and transfers the exact temporal-rank and
recurrence-relation counts to that occupation spectrum.

The result applies to any finite one-particle energy family.  Spatial
Anderson localization concerns the corresponding orbitals; it is not assumed
or proved here.
-/

open Set
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

noncomputable local instance freeFockBridgeFintypeForallBool
    {I : Type*} [Fintype I] :
    Fintype (I → Bool) :=
  Fintype.ofFinite _

/-- Many-body occupation energy generated by a finite packet of
one-particle energies. -/
def fockOccupationEnergy
    {I : Type*} [Fintype I]
    (epsilon : I → ℝ) (x : I → Bool) : ℝ :=
  ∑ i, if x i then epsilon i else 0

/-- Complete Walsh coefficient family of the free occupation spectrum:
constant half-sum, singleton negative half-energies, and no higher-body
coefficients. -/
def fockLBitCoefficient
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) (S : Finset I) : ℝ :=
  (if S = ∅ then (1 / 2 : ℝ) * ∑ i, epsilon i else 0) +
    ∑ i, if S = {i} then -(1 / 2 : ℝ) * epsilon i else 0

theorem fockLBitCoefficient_empty
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) :
    fockLBitCoefficient epsilon ∅ =
      (1 / 2 : ℝ) * ∑ i, epsilon i := by
  classical
  simp [fockLBitCoefficient]

theorem fockLBitCoefficient_singleton
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) (i : I) :
    fockLBitCoefficient epsilon {i} =
      -(1 / 2 : ℝ) * epsilon i := by
  classical
  simp [fockLBitCoefficient]

/-- Every genuine interaction coefficient of the free occupation spectrum
vanishes. -/
theorem fockLBitCoefficient_higher
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) (S : Finset I)
    (hS : 1 < S.card) :
    fockLBitCoefficient epsilon S = 0 := by
  classical
  have hne : S ≠ ∅ := by
    intro h
    subst S
    simp at hS
  have hsingle : ∀ i, S ≠ {i} := by
    intro i h
    subst S
    simp at hS
  simp [fockLBitCoefficient, hne, hsingle]

/-- Exact occupation-to-Walsh dictionary, including the constant-energy
gauge. -/
theorem lbitEnergy_fockLBitCoefficient_eq
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) (x : I → Bool) :
    lbitEnergy (fockLBitCoefficient epsilon) x =
      fockOccupationEnergy epsilon x := by
  classical
  unfold lbitEnergy fockLBitCoefficient fockOccupationEnergy
  simp_rw [smul_add, Finset.sum_add_distrib]
  simp only [Finset.smul_sum]
  rw [Finset.sum_comm]
  simp [lbitWalshCharacter, lbitSign]
  rw [Finset.mul_sum, ← Finset.sum_neg_distrib,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  cases x i
  · simp
  · simp
    ring

theorem fockLBitSingletonPacket_eq
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ) :
    lbitSingletonCoefficientPacket (fockLBitCoefficient epsilon) =
      fun i => -(1 / 2 : ℝ) * epsilon i := by
  funext i
  exact fockLBitCoefficient_singleton epsilon i

/-- Rational independence of the one-particle energies is exactly preserved
by the singleton l-bit coefficient dictionary. -/
theorem fockLBitSingletonPacket_linearIndependent
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ)
    (hε : LinearIndependent ℚ epsilon) :
    LinearIndependent ℚ
      (lbitSingletonCoefficientPacket
        (fockLBitCoefficient epsilon)) := by
  rw [fockLBitSingletonPacket_eq]
  have hscaledLI :
      LinearIndependent ℚ
        (fun i => (-(1 / 2 : ℚ)) • epsilon i) := by
    rw [Fintype.linearIndependent_iff] at hε ⊢
    intro c hc i
    have hscaled :
        ∑ j, (c j * (-(1 / 2 : ℚ))) • epsilon j = 0 := by
      simpa [mul_smul] using hc
    have hi := hε (fun j => c j * (-(1 / 2 : ℚ))) hscaled i
    exact
      (mul_eq_zero.mp hi).resolve_right
        (by norm_num : (-(1 / 2 : ℚ)) ≠ 0)
  simpa [Rat.smul_def] using hscaledLI

/-- A free occupation spectrum with rationally independent one-particle
energies has one temporal direction per mode. -/
theorem fockOccupation_temporalRank_eq
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ)
    (hε : LinearIndependent ℚ epsilon) :
    lbitTemporalRank (fockLBitCoefficient epsilon) =
      Fintype.card I := by
  apply lbitNoninteracting_temporalRank_eq
  · exact fockLBitCoefficient_higher epsilon
  · exact fockLBitSingletonPacket_linearIndependent epsilon hε

/-- The same free occupation spectrum has exactly
`2 ^ |I| - 1 - |I|` independent balanced projective recurrence
relations. -/
theorem fockOccupation_relationRank_eq
    {I : Type*} [Fintype I] [DecidableEq I]
    (epsilon : I → ℝ)
    (hε : LinearIndependent ℚ epsilon) :
    Module.finrank ℚ
        (projectiveSpectralRelationRationalSpace
          (fockOccupationEnergy epsilon)) =
      2 ^ Fintype.card I - 1 - Fintype.card I := by
  have henergy :
      fockOccupationEnergy epsilon =
        lbitEnergy (fockLBitCoefficient epsilon) := by
    funext x
    exact (lbitEnergy_fockLBitCoefficient_eq epsilon x).symm
  rw [henergy]
  exact lbitNoninteracting_relationRank_eq
    (fockLBitCoefficient epsilon)
    (fockLBitCoefficient_higher epsilon)
    (fockLBitSingletonPacket_linearIndependent epsilon hε)

end

end GaloisForLFunctions.HTGeometry
