import GaloisForLFunctions.HTGeometry.PairProductLaw

/-!
# The low subalgebra of a two-coordinate product law

The flag the peel runs on transports to the two-coordinate law.  Its level-`m` subalgebra is
generated by the coordinates up to `m` and the inverses of the factors that fit below `m` — a factor
at `j` occupies the coordinates `j` and `j+1`, so it fits when `j + 1 ≤ m`.

The subalgebra is stable under the product law and under every coordinate derivation, and a
coordinate above the level annihilates it.  Those are exactly the three facts the commutator argument
consumes.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

variable {p : ℕ → MvPolynomial (Fin 2) ℂ}

/-! ## The law as a derivation -/

/-- The two-coordinate product law on the polynomial ring. -/
noncomputable def pairDerivationPoly (p : ℕ → MvPolynomial (Fin 2) ℂ) :
    Derivation ℂ (MvPolynomial ℕ ℂ) CascadeField :=
  MvPolynomial.mkDerivation ℂ fun k => pairJet p k

@[simp] theorem pairDerivationPoly_X (p : ℕ → MvPolynomial (Fin 2) ℂ) (k : ℕ) :
    pairDerivationPoly p (MvPolynomial.X k) = pairJet p k :=
  MvPolynomial.mkDerivation_X ℂ _ k

/-- **The two-coordinate product law on the rational model.** -/
noncomputable def pairDerivation (p : ℕ → MvPolynomial (Fin 2) ℂ) :
    Derivation ℂ CascadeField CascadeField :=
  fractionRingDerivation (pairDerivationPoly p)

@[simp] theorem pairDerivation_fx (p : ℕ → MvPolynomial (Fin 2) ℂ) (k : ℕ) :
    pairDerivation p (fx k) = pairJet p k := by
  rw [pairDerivation, fx, fractionRingDerivation_algebraMap, pairDerivationPoly_X]

/-! ## The low subalgebra -/

/-- The subalgebra generated by the coordinates up to `m` and the inverses of the factors that fit
below `m`. -/
noncomputable def pairLowSub (p : ℕ → MvPolynomial (Fin 2) ℂ) (m : ℕ) :
    Subalgebra ℂ CascadeField :=
  Algebra.adjoin ℂ
    ({z : CascadeField | ∃ j, j ≤ m ∧ z = fx j}
      ∪ {z : CascadeField | ∃ j, j + 1 ≤ m ∧ z = (pairFactor (p j) j)⁻¹})

theorem fx_mem_pairLowSub {j m : ℕ} (h : j ≤ m) : fx j ∈ pairLowSub p m :=
  Algebra.subset_adjoin (Or.inl ⟨j, h, rfl⟩)

theorem inv_pairFactor_mem_pairLowSub {j m : ℕ} (h : j + 1 ≤ m) :
    (pairFactor (p j) j)⁻¹ ∈ pairLowSub p m :=
  Algebra.subset_adjoin (Or.inr ⟨j, h, rfl⟩)

/-- Every two-coordinate factor that fits below the level is low. -/
theorem algebraMap_pairPoly_mem {j m : ℕ} (h : j + 1 ≤ m) (q : MvPolynomial (Fin 2) ℂ) :
    algebraMap (MvPolynomial ℕ ℂ) CascadeField (pairPoly q j) ∈ pairLowSub p m := by
  induction q using MvPolynomial.induction_on with
  | C a =>
      rw [pairPoly_C]
      exact Subalgebra.algebraMap_mem _ a
  | add q r hq hr =>
      rw [pairPoly_add, map_add]
      exact Subalgebra.add_mem _ hq hr
  | mul_X q i hq =>
      rw [pairPoly_mul_X, map_mul]
      refine Subalgebra.mul_mem _ hq ?_
      have hi : (i : ℕ) = 0 ∨ (i : ℕ) = 1 := by omega
      exact fx_mem_pairLowSub (by rcases hi with hi | hi <;> omega)

theorem pairFactor_mem_pairLowSub {j m : ℕ} (h : j + 1 ≤ m) :
    pairFactor (p j) j ∈ pairLowSub p m :=
  algebraMap_pairPoly_mem h (p j)

theorem pairJet_mem_pairLowSub {k m : ℕ} (h : k ≤ m) : pairJet p k ∈ pairLowSub p m := by
  refine Subalgebra.prod_mem _ fun j hj => ?_
  have hjk : j < k := Finset.mem_range.mp hj
  exact pairFactor_mem_pairLowSub (by omega)

theorem inv_pairJet_mem_pairLowSub {k m : ℕ} (h : k ≤ m) :
    (pairJet p k)⁻¹ ∈ pairLowSub p m := by
  rw [pairJet, ← Finset.prod_inv_distrib]
  refine Subalgebra.prod_mem _ fun j hj => ?_
  have hjk : j < k := Finset.mem_range.mp hj
  exact inv_pairFactor_mem_pairLowSub (by omega)

/-! ## Stability under the derivations -/

/-- The product law of a factor stays low. -/
theorem pairDerivation_algebraMap_pairPoly_mem {j m : ℕ} (h : j + 1 ≤ m)
    (q : MvPolynomial (Fin 2) ℂ) :
    pairDerivation p (algebraMap (MvPolynomial ℕ ℂ) CascadeField (pairPoly q j))
      ∈ pairLowSub p m := by
  induction q using MvPolynomial.induction_on with
  | C a =>
      rw [pairPoly_C]
      have hc : algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.C a)
          = algebraMap ℂ CascadeField a := rfl
      rw [hc, (pairDerivation p).map_algebraMap]
      exact Subalgebra.zero_mem _
  | add q r hq hr =>
      rw [pairPoly_add, map_add, map_add]
      exact Subalgebra.add_mem _ hq hr
  | mul_X q i hq =>
      rw [pairPoly_mul_X, map_mul]
      have hxi : algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.X (j + (i : ℕ)))
          = fx (j + (i : ℕ)) := rfl
      rw [hxi, Derivation.leibniz, pairDerivation_fx]
      simp only [smul_eq_mul]
      have hi : (i : ℕ) = 0 ∨ (i : ℕ) = 1 := by omega
      refine Subalgebra.add_mem _ ?_ (Subalgebra.mul_mem _
        (fx_mem_pairLowSub (by rcases hi with hi | hi <;> omega)) hq)
      exact Subalgebra.mul_mem _ (algebraMap_pairPoly_mem h q)
        (pairJet_mem_pairLowSub (by rcases hi with hi | hi <;> omega))

/-- The coordinate derivation of a factor stays low. -/
theorem fpderiv_algebraMap_pairPoly_mem {j m : ℕ} (h : j + 1 ≤ m) (k : ℕ)
    (q : MvPolynomial (Fin 2) ℂ) :
    fpderiv k (algebraMap (MvPolynomial ℕ ℂ) CascadeField (pairPoly q j))
      ∈ pairLowSub (p := p) m := by
  induction q using MvPolynomial.induction_on with
  | C a =>
      rw [pairPoly_C]
      have hc : algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.C a)
          = algebraMap ℂ CascadeField a := rfl
      rw [hc, (fpderiv k).map_algebraMap]
      exact Subalgebra.zero_mem _
  | add q r hq hr =>
      rw [pairPoly_add, map_add, map_add]
      exact Subalgebra.add_mem _ hq hr
  | mul_X q i hq =>
      rw [pairPoly_mul_X, map_mul]
      have hxi : algebraMap (MvPolynomial ℕ ℂ) CascadeField (MvPolynomial.X (j + (i : ℕ)))
          = fx (j + (i : ℕ)) := rfl
      rw [hxi, Derivation.leibniz]
      simp only [smul_eq_mul]
      have hi : (i : ℕ) = 0 ∨ (i : ℕ) = 1 := by omega
      refine Subalgebra.add_mem _ ?_ (Subalgebra.mul_mem _
        (fx_mem_pairLowSub (by rcases hi with hi | hi <;> omega)) hq)
      refine Subalgebra.mul_mem _ (algebraMap_pairPoly_mem h q) ?_
      by_cases hjk : j + (i : ℕ) = k
      · rw [hjk, fpderiv_fx_self]
        exact Subalgebra.one_mem _
      · rw [fpderiv_fx_of_ne hjk]
        exact Subalgebra.zero_mem _

/-- **The low subalgebra is stable under the product law.** -/
theorem pairDerivation_mem_pairLowSub {m : ℕ} {P : CascadeField} (h : P ∈ pairLowSub p m) :
    pairDerivation p P ∈ pairLowSub p m := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · rw [pairDerivation_fx]
        exact pairJet_mem_pairLowSub (by omega)
      · rw [Derivation.leibniz_inv]
        simp only [smul_eq_mul]
        refine Subalgebra.mul_mem _ (Subalgebra.neg_mem _ (Subalgebra.pow_mem _
          (inv_pairFactor_mem_pairLowSub hj) 2)) ?_
        exact pairDerivation_algebraMap_pairPoly_mem hj (p j)
  | algebraMap c =>
      rw [(pairDerivation p).map_algebraMap]
      exact Subalgebra.zero_mem _
  | add x y _ _ ihx ihy =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy =>
      rw [Derivation.leibniz]
      simp only [smul_eq_mul]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx ihy)
        (Subalgebra.mul_mem _ hy ihx)

/-- **The low subalgebra is stable under every coordinate derivation.** -/
theorem fpderiv_mem_pairLowSub {m : ℕ} (k : ℕ) {P : CascadeField} (h : P ∈ pairLowSub p m) :
    fpderiv k P ∈ pairLowSub (p := p) m := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · by_cases hjk : j = k
        · rw [hjk, fpderiv_fx_self]
          exact Subalgebra.one_mem _
        · rw [fpderiv_fx_of_ne hjk]
          exact Subalgebra.zero_mem _
      · rw [Derivation.leibniz_inv]
        simp only [smul_eq_mul]
        refine Subalgebra.mul_mem _ (Subalgebra.neg_mem _ (Subalgebra.pow_mem _
          (inv_pairFactor_mem_pairLowSub hj) 2)) ?_
        exact fpderiv_algebraMap_pairPoly_mem hj k (p j)
  | algebraMap c =>
      rw [(fpderiv k).map_algebraMap]
      exact Subalgebra.zero_mem _
  | add x y _ _ ihx ihy =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy =>
      rw [Derivation.leibniz]
      simp only [smul_eq_mul]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx ihy)
        (Subalgebra.mul_mem _ hy ihx)


/-- **A coordinate above the level annihilates the low subalgebra.** -/
theorem fpderiv_eq_zero_of_mem_pairLowSub {m k : ℕ} (hk : m < k) {P : CascadeField}
    (h : P ∈ pairLowSub p m) : fpderiv k P = 0 := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · exact fpderiv_fx_of_ne (by omega)
      · rw [Derivation.leibniz_inv,
          fpderiv_pairFactor_of_ne (k := k) (j := j) (by omega) (by omega)]
        simp
  | algebraMap c => exact (fpderiv k).map_algebraMap c
  | add x y _ _ ihx ihy => rw [map_add, ihx, ihy, add_zero]
  | mul x y _ _ ihx ihy =>
      rw [Derivation.leibniz, ihx, ihy]
      simp

/-! ## The response trichotomy, in the two-coordinate law -/

/-- The response of the jet at level `l` to the coordinate `k`. -/
noncomputable def pairResponse (p : ℕ → MvPolynomial (Fin 2) ℂ) (k l : ℕ) : CascadeField :=
  fpderiv k (pairJet p l)

theorem pairResponse_of_lt {k l : ℕ} (h : l < k) : pairResponse p k l = 0 :=
  fpderiv_pairJet_of_gt p h

theorem pairResponse_of_gt (hne : ∀ j, pairFactor (p j) j ≠ 0) {k l : ℕ} (h : k < l) :
    pairResponse p k l = pairLog p k * pairJet p l :=
  fpderiv_pairJet_of_lt hne h

theorem pairLog_mem_pairLowSub {k m : ℕ} (h : k + 1 ≤ m) : pairLog p k ∈ pairLowSub p m := by
  rw [pairLog, div_eq_mul_inv, div_eq_mul_inv]
  refine Subalgebra.add_mem _ ?_ ?_
  · exact Subalgebra.mul_mem _
      (fpderiv_mem_pairLowSub k (pairJet_mem_pairLowSub (by omega)))
      (inv_pairJet_mem_pairLowSub (by omega))
  · exact Subalgebra.mul_mem _
      (fpderiv_mem_pairLowSub k (pairFactor_mem_pairLowSub h))
      (inv_pairFactor_mem_pairLowSub h)

end GaloisForLFunctions.HTGeometry
