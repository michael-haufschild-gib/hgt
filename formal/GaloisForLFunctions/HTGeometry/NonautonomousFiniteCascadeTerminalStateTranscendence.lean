import GaloisForLFunctions.HTGeometry.NonautonomousFiniteCascadeValuationRetention
import GaloisForLFunctions.HTGeometry.NonautonomousFinitePuiseuxAnalyticComponent
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Terminal-state transcendence over the complete lower branch

The new state of a finite actual cascade remains transcendental after adjoining every algebraic
derivative branch from lower levels.  This supplies the free singleton-adjoin step required before
the new algebraic velocity is attached.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

attribute [local instance] cascadeUnitCostDomain cascadeUnitCostRatFuncAlgebra
  cascadeUnitCostComplexAlgebra cascadeUnitCostScalarTower cascadeUnitCostDifferential
  cascadeUnitCostCharZero

/-- Canonical complex-algebra embedding of the lower rational state field into the successor
finite branch field. -/
noncomputable def nonautonomousFiniteCascadeLowerStateAlgHomSucc
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) :
    NonautonomousRamifiedCascadeStateField hfan N →ₐ[ℂ]
      NonautonomousFiniteCascadeBranchField hfan (N + 1) where
  toRingHom := nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N
  commutes' c := by
    apply Subtype.ext
    rfl

/-- The lower-state embedding sends every generator to the same generator in the successor. -/
theorem nonautonomousFiniteCascadeLowerStateAlgHomSucc_state
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) (i : Fin (N + 1)) :
    nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N
        (nonautonomousCascadeStateFamilyInStateField hfan N i) =
      nonautonomousFiniteCascadeStateInBranchField hfan (N + 1) i.castSucc := by
  apply Subtype.ext
  rfl

/-- The image of the lower rational state field is exactly the field generated by the lower state
coordinates inside the successor branch field. -/
theorem nonautonomousFiniteCascadeLowerState_fieldRange_eq_adjoin
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) :
    (nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N).fieldRange =
      IntermediateField.adjoin ℂ
        ((nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)) ''
          Set.range (fun i : Fin (N + 1) => i.castSucc)) := by
  let e := nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N
  let y := nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)
  let L := IntermediateField.adjoin ℂ
    (y '' Set.range (fun i : Fin (N + 1) => i.castSucc))
  apply le_antisymm
  · intro z hz
    rcases hz with ⟨a, rfl⟩
    have ha : a ∈ IntermediateField.adjoin ℂ
        (Set.range (nonautonomousCascadeStateFamilyInStateField hfan N)) := by
      rw [adjoin_range_nonautonomousCascadeStateFamilyInStateField_eq_top]
      trivial
    apply IntermediateField.adjoin_induction ℂ
      (p := fun x _ => e x ∈ L) _ _ _ _ _ ha
    · intro x hx
      rcases hx with ⟨i, rfl⟩
      rw [nonautonomousFiniteCascadeLowerStateAlgHomSucc_state]
      exact IntermediateField.subset_adjoin ℂ _
        ⟨i.castSucc, ⟨i, rfl⟩, rfl⟩
    · intro c
      exact L.algebraMap_mem c
    · intro x y _ _ hx hy
      exact L.add_mem hx hy
    · intro x _ hx
      exact L.inv_mem hx
    · intro x y _ _ hx hy
      exact L.mul_mem hx hy
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨j, ⟨i, rfl⟩, rfl⟩
    exact ⟨nonautonomousCascadeStateFamilyInStateField hfan N i,
      nonautonomousFiniteCascadeLowerStateAlgHomSucc_state hfan N i⟩

/-- The new terminal state is transcendental over the complete lower rational state field. -/
theorem nonautonomousFiniteCascadeTerminalState_transcendental_lowerState
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    let e := nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N
    letI : Algebra (NonautonomousRamifiedCascadeStateField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)) :=
      e.toRingHom.toAlgebra
    Transcendental (NonautonomousRamifiedCascadeStateField hfan N)
      (nonautonomousFiniteCascadeTerminalStateSucc hfan N) := by
  let F := NonautonomousRamifiedCascadeStateField hfan N
  let B := NonautonomousFiniteCascadeBranchField hfan (N + 1)
  let e : F →ₐ[ℂ] B := nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N
  let E : IntermediateField ℂ B := e.fieldRange
  let y : Fin (N + 2) → B :=
    nonautonomousFiniteCascadeStateInBranchField hfan (N + 1)
  let s : Set (Fin (N + 2)) := Set.range (fun i : Fin (N + 1) => i.castSucc)
  let L : IntermediateField ℂ B := IntermediateField.adjoin ℂ (y '' s)
  have hEL : E = L := nonautonomousFiniteCascadeLowerState_fieldRange_eq_adjoin hfan N
  have hlast : (Fin.last (N + 1) : Fin (N + 2)) ∉ s := by
    rintro ⟨i, hi⟩
    have hv := congrArg Fin.val hi
    simp at hv
    omega
  have hAI : AlgebraicIndependent ℂ y :=
    algebraicIndependent_nonautonomousFiniteCascadeStateInBranchField
      hfan hall (N + 1)
  have htL : Transcendental L (y (Fin.last (N + 1))) := by
    change Transcendental (IntermediateField.adjoin ℂ (y '' s))
      (y (Fin.last (N + 1)))
    rw [IntermediateField.transcendental_adjoin_iff]
    exact hAI.transcendental_adjoin hlast
  have htE : Transcendental E (y (Fin.last (N + 1))) := by
    rwa [hEL]
  let eR : F →ₐ[ℂ] E :=
    { toRingHom := e.toRingHom.codRestrict E.toSubring fun x => ⟨x, rfl⟩
      commutes' := fun c => by
        apply Subtype.ext
        exact e.commutes c }
  have heRbij : Function.Bijective eR := by
    constructor
    · intro x z hxz
      apply e.injective
      exact congrArg Subtype.val hxz
    · intro z
      rcases z.2 with ⟨x, hx⟩
      exact ⟨x, Subtype.ext hx⟩
  letI : Algebra F E := eR.toRingHom.toAlgebra
  letI : Algebra F B := e.toRingHom.toAlgebra
  letI : IsScalarTower F E B := IsScalarTower.of_algebraMap_eq
      (R := F) (S := E) (A := B) fun x => by
    change e x = (eR x : B)
    rfl
  letI : Algebra.IsAlgebraic F E := by
    constructor
    intro z
    obtain ⟨x, rfl⟩ := heRbij.2 z
    exact isAlgebraic_algebraMap (R := F) (A := E) x
  have ht : Transcendental F (y (Fin.last (N + 1))) :=
    (Algebra.IsAlgebraic.transcendental_iff F E).mpr htE
  simpa [y, nonautonomousFiniteCascadeTerminalStateSucc] using ht

/-- The new terminal state remains transcendental after every algebraic lower derivative branch has
been adjoined. -/
theorem nonautonomousFiniteCascadeTerminalState_transcendental_lowerBranch
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ}
    (h1 : ∀ k, k < N → DifferentiallyAlgebraicOfOrder (f k) 1) :
    let e := nonautonomousFiniteCascadeBranchInclusionSucc hfan N
    letI : Algebra (NonautonomousFiniteCascadeBranchField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)) :=
      e.toRingHom.toAlgebra
    Transcendental (NonautonomousFiniteCascadeBranchField hfan N)
      (nonautonomousFiniteCascadeTerminalStateSucc hfan N) := by
  dsimp
  let F := NonautonomousRamifiedCascadeStateField hfan N
  let L := NonautonomousFiniteCascadeBranchField hfan N
  let K := NonautonomousFiniteCascadeBranchField hfan (N + 1)
  let e : F →+* L := nonautonomousFiniteCascadeStateToBranch hfan N
  let g : L →+* K :=
    (nonautonomousFiniteCascadeBranchInclusionSucc hfan N).toRingHom
  let q : F →+* K := nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N
  letI : Algebra F L := e.toAlgebra
  letI : Algebra L K := g.toAlgebra
  letI : Algebra F K := q.toAlgebra
  letI : IsScalarTower F L K := IsScalarTower.of_algebraMap_eq fun _ => rfl
  letI : FiniteDimensional F L :=
    finiteDimensional_nonautonomousFiniteCascadeBranchFieldOverState hfan hall h1
  letI : Algebra.IsAlgebraic F L := Algebra.IsAlgebraic.of_finite F L
  have hF : Transcendental F
      (nonautonomousFiniteCascadeTerminalStateSucc hfan N : K) :=
    nonautonomousFiniteCascadeTerminalState_transcendental_lowerState hfan hall N
  exact (Algebra.IsAlgebraic.transcendental_iff F L (A := K)).mp hF

end


end GaloisForLFunctions.HTGeometry
