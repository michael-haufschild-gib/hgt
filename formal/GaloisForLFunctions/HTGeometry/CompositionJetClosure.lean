import GaloisForLFunctions.HTGeometry.PrimeValuationProfileFieldClassification
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg
import GaloisForLFunctions.HTGeometry.AlgebraicWitness

/-!
# The jets of the outer function of a composition

In a differential field, the successive derivatives of the outer function of a composition are
obtained from the composite by repeatedly differentiating and dividing by the derivative of the
inner function: `compJet φ h j` is `g⁽ʲ⁾ ∘ φ` when `h = g ∘ φ`.  Every one of them lies in the
differential field generated by `φ` and `h`, because that field is closed under the derivation and
under division.

Consequently, if that field has transcendence degree at most `m` over the constants, then `φ`
together with the first `m` outer jets — `m+1` elements — satisfies a nonzero polynomial relation
with constant coefficients.  This is the algebraic half of the composition-decomposition law; the
analytic half, which turns such a relation into an algebraic differential equation for the outer
function, is `CompositionOrderTransfer.differentiallyAlgebraicOfOrder_of_relation_on_range`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

variable {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]

/-- The successive derivatives of the outer function of a composition, read through the inner one:
`compJet φ h j` is `g⁽ʲ⁾ ∘ φ` when `h = g ∘ φ`. -/
noncomputable def compJet (φ h : K) : ℕ → K
  | 0 => h
  | j + 1 => (compJet φ h j)′ / φ′

@[simp] theorem compJet_zero (φ h : K) : compJet φ h 0 = h := rfl

@[simp] theorem compJet_succ (φ h : K) (j : ℕ) :
    compJet φ h (j + 1) = (compJet φ h j)′ / φ′ := rfl

/-- **The chain-rule closure.**  Every jet of the outer function lies in the differential field
generated by the inner function and the composite.  Division by `φ′` never leaves the field, and the
differential adjunction is closed under the derivation. -/
theorem compJet_mem_differentialAdjoin (hconst : ∀ c : F, (algebraMap F K c)′ = 0)
    (φ h : K) (j : ℕ) :
    compJet φ h j ∈ differentialAdjoin F ({φ, h} : Set K) := by
  have hclosed := derivationClosed_differentialAdjoin_of_constants F hconst ({φ, h} : Set K)
  have hφ : φ ∈ differentialAdjoin F ({φ, h} : Set K) :=
    subset_differentialAdjoin F _ (by simp)
  have hh : h ∈ differentialAdjoin F ({φ, h} : Set K) :=
    subset_differentialAdjoin F _ (by simp)
  induction j with
  | zero => simpa using hh
  | succ j ih =>
      rw [compJet_succ]
      exact div_mem (hclosed ih) (hclosed hφ)

/-- **Bounded transcendence forces a relation among the outer jets.**  If the differential field
generated by the inner function and the composite has transcendence degree at most `m` over the
constants, then the inner function together with the first `m` jets of the outer function satisfies a
nonzero polynomial relation with constant coefficients. -/
theorem exists_relation_compJet {F K : Type} [Field F] [Field K] [Algebra F K] [Differential K]
    (hconst : ∀ c : F, (algebraMap F K c)′ = 0) (φ h : K) {m : ℕ}
    (htr : Algebra.trdeg F ↥(differentialAdjoin F ({φ, h} : Set K)) ≤ (m : Cardinal)) :
    ∃ P : MvPolynomial (Fin (m + 1)) F, P ≠ 0 ∧
      MvPolynomial.aeval (Fin.cons φ fun i : Fin m => compJet φ h (i : ℕ)) P = 0 := by
  classical
  by_contra hcon
  push Not at hcon
  set A : IntermediateField F K := differentialAdjoin F ({φ, h} : Set K) with hA
  have hmem : ∀ j : Fin (m + 1),
      (Fin.cons φ (fun i : Fin m => compJet φ h (i : ℕ)) : Fin (m + 1) → K) j ∈ A := by
    intro j
    refine Fin.cases ?_ ?_ j
    · simpa using subset_differentialAdjoin F ({φ, h} : Set K) (by simp)
    · intro i
      simpa using compJet_mem_differentialAdjoin hconst φ h (i : ℕ)
  set y : Fin (m + 1) → ↥A := fun j => ⟨_, hmem j⟩ with hy
  have hind : AlgebraicIndependent F
      (Fin.cons φ fun i : Fin m => compJet φ h (i : ℕ)) := by
    rw [algebraicIndependent_iff]
    intro P hP
    by_contra hP0
    exact hcon P hP0 hP
  have hindy : AlgebraicIndependent F y := by
    refine AlgebraicIndependent.of_comp (A.val) ?_
    exact hind
  have hcard := hindy.cardinalMk_le_trdeg
  rw [Cardinal.mk_fin] at hcard
  have : ((m + 1 : ℕ) : Cardinal) ≤ (m : Cardinal) := le_trans hcard htr
  have hlt : (m : Cardinal) < ((m + 1 : ℕ) : Cardinal) := by
    exact_mod_cast Nat.lt_succ_self m
  exact absurd this (not_le.mpr hlt)


/-- **The relation, in any intermediate field of bounded transcendence degree.**  Only two things
are needed: the inner function and all the outer jets lie in the field, and its transcendence degree
over the constants is at most `m`. -/
theorem exists_relation_compJet_of_mem {F K : Type} [Field F] [Field K] [Algebra F K]
    [Differential K] {A : IntermediateField F K} {φ h : K} {m : ℕ}
    (htr : Algebra.trdeg F ↥A ≤ (m : Cardinal))
    (hφ : φ ∈ A) (hj : ∀ j : ℕ, compJet φ h j ∈ A) :
    ∃ P : MvPolynomial (Fin (m + 1)) F, P ≠ 0 ∧
      MvPolynomial.aeval (Fin.cons φ fun i : Fin m => compJet φ h (i : ℕ)) P = 0 := by
  classical
  by_contra hcon
  push Not at hcon
  have hmem : ∀ j : Fin (m + 1),
      (Fin.cons φ (fun i : Fin m => compJet φ h (i : ℕ)) : Fin (m + 1) → K) j ∈ A := by
    intro j
    refine Fin.cases ?_ ?_ j
    · simpa using hφ
    · intro i
      simpa using hj (i : ℕ)
  set y : Fin (m + 1) → ↥A := fun j => ⟨_, hmem j⟩ with hy
  have hind : AlgebraicIndependent F
      (Fin.cons φ fun i : Fin m => compJet φ h (i : ℕ)) := by
    rw [algebraicIndependent_iff]
    intro P hP
    by_contra hP0
    exact hcon P hP0 hP
  have hindy : AlgebraicIndependent F y := AlgebraicIndependent.of_comp (A.val) hind
  have hcard := hindy.cardinalMk_le_trdeg
  rw [Cardinal.mk_fin] at hcard
  have hle : ((m + 1 : ℕ) : Cardinal) ≤ (m : Cardinal) := le_trans hcard htr
  have hlt : (m : Cardinal) < ((m + 1 : ℕ) : Cardinal) := by
    exact_mod_cast Nat.lt_succ_self m
  exact absurd hle (not_le.mpr hlt)


/-- **The composition-decomposition law, algebraic form.**  If every jet of the inner function and
of the composite is algebraic over a field generated by `#I` elements, then the inner function
together with the first `#I` jets of the outer function satisfies a nonzero polynomial relation with
constant coefficients. -/
theorem exists_relation_compJet_of_algebraic {F K I : Type} [Field F] [Field K] [Algebra F K]
    [Differential K] [Fintype I]
    (hconst : ∀ c : F, (algebraMap F K c)′ = 0) (φ h : K) (s : I → K)
    (hjets : ∀ x ∈ ({φ, h} : Set K), ∀ j : ℕ,
      differentialJet j x ∈ algebraicClosure (IntermediateField.adjoin F (Set.range s)) K) :
    ∃ P : MvPolynomial (Fin (Fintype.card I + 1)) F, P ≠ 0 ∧
      MvPolynomial.aeval
        (Fin.cons φ fun i : Fin (Fintype.card I) => compJet φ h (i : ℕ)) P = 0 := by
  classical
  set A : IntermediateField F K :=
    (algebraicClosure (IntermediateField.adjoin F (Set.range s)) K).restrictScalars F with hA
  have htr : Algebra.trdeg F ↥A ≤ ((Fintype.card I : ℕ) : Cardinal) := by
    have := trdeg_algebraicClosure_adjoin_range_le (K := F) (L := K) s
    rw [hA]
    refine this.trans (le_of_eq ?_)
    simp
  have hjetmem : ∀ y ∈ differentialJetSet ({φ, h} : Set K), y ∈ A := by
    rintro y ⟨x, hx, j, rfl⟩
    exact hjets x hx j
  have hle : differentialAdjoin F ({φ, h} : Set K) ≤ A := by
    rw [differentialAdjoin]
    exact IntermediateField.adjoin_le_iff.mpr hjetmem
  have hφ : φ ∈ A := by
    have hj0 := hjets φ (by simp) 0
    rw [differentialJet_zero] at hj0
    exact hj0
  refine exists_relation_compJet_of_mem htr hφ ?_
  intro j
  exact hle (compJet_mem_differentialAdjoin hconst φ h j)


/-- An algebraic witness places the element in the algebraic closure of the generated subfield. -/
theorem mem_algebraicClosure_of_algebraicWitness {F E σ : Type*} [Field F] [Field E] [Algebra F E]
    {b : σ → E} {y : E} (h : AlgebraicWitness F b y) :
    y ∈ algebraicClosure ↥(IntermediateField.adjoin F (Set.range b)) E :=
  mem_algebraicClosure_iff.mpr (isAlgebraic_of_algebraicWitness h)

/-- **The composition-decomposition law from algebraic witnesses.**  If every jet of the inner
function and of the composite has an algebraic witness over one finite family, then the inner
function together with that many outer jets satisfies a nonzero relation over the constants. -/
theorem exists_relation_compJet_of_witness {F K I : Type} [Field F] [Field K] [Algebra F K]
    [Differential K] [Fintype I]
    (hconst : ∀ c : F, (algebraMap F K c)′ = 0) (φ h : K) (s : I → K)
    (hwit : ∀ x ∈ ({φ, h} : Set K), ∀ j : ℕ, AlgebraicWitness F s (differentialJet j x)) :
    ∃ P : MvPolynomial (Fin (Fintype.card I + 1)) F, P ≠ 0 ∧
      MvPolynomial.aeval
        (Fin.cons φ fun i : Fin (Fintype.card I) => compJet φ h (i : ℕ)) P = 0 :=
  exists_relation_compJet_of_algebraic hconst φ h s
    fun x hx j => mem_algebraicClosure_of_algebraicWitness (hwit x hx j)


end GaloisForLFunctions.HTGeometry
