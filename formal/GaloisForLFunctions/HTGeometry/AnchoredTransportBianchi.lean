import GaloisForLFunctions.HTGeometry.ProjectiveSourceVisibilityParity

/-!
# Quadratic anchors and carrier transport obey one triangle law

The composition-curvature programme also requires a public causal anchor, not only a local
composition tensor.  This file models the first finite anchor layer.

Let a quadratic report be generated by a bilinear map `β` through `Γ(x) = β x x`.  A state
comparison `T` and public comparison `L` need not intertwine the two quadratic reports.  Their
anchor-transport defect is

```
Γ₁(T x) - L (Γ₀ x).
```

On every comparison triangle, the anchor defects are coupled exactly to both the state-comparison
path defect and the public-comparison path defect.  The state contribution contains linear cross
terms and a mandatory quadratic finite-holonomy term.

This is elementary parent algebra and proves no causal, gravitational, or physical claim.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {R V W : Type*}
variable [CommRing R]
variable [AddCommGroup V] [Module R V]
variable [AddCommGroup W] [Module R W]

/-- A bilinear form with state carrier `V` and public-report carrier `W`. -/
abbrev BilinearAnchor (R V W : Type*)
    [CommRing R]
    [AddCommGroup V] [Module R V]
    [AddCommGroup W] [Module R W] :=
  V →ₗ[R] V →ₗ[R] W

/-- Quadratic public report generated by a bilinear anchor. -/
def quadraticAnchor
    (β : BilinearAnchor R V W)
    (x : V) : W :=
  β x x

/-- Failure of state and public comparisons to intertwine two quadratic anchors. -/
def anchorTransportDefect
    (T : V →ₗ[R] V)
    (L : W →ₗ[R] W)
    (β γ : BilinearAnchor R V W)
    (x : V) : W :=
  quadraticAnchor γ (T x) - L (quadraticAnchor β x)

/-- Failure of a two-edge comparison path to equal the direct comparison on one carrier. -/
def anchorComparisonPathDefect
    {X : Type*} [AddCommGroup X] [Module R X]
    (T₀₁ T₁₂ T₀₂ : X →ₗ[R] X) : X →ₗ[R] X :=
  T₁₂.comp T₀₁ - T₀₂

/--
Exact triangle identity coupling anchor transport to state and public comparison holonomy.

The state-path defect enters through two cross terms and one quadratic term.  The independent
public-path defect acts directly on the initial quadratic report.
-/
theorem anchorTransportDefect_triangle_bianchi
    (β₀ β₁ β₂ : BilinearAnchor R V W)
    (T₀₁ T₁₂ T₀₂ : V →ₗ[R] V)
    (L₀₁ L₁₂ L₀₂ : W →ₗ[R] W)
    (x : V) :
    anchorTransportDefect T₁₂ L₁₂ β₁ β₂ (T₀₁ x) +
        L₁₂ (anchorTransportDefect T₀₁ L₀₁ β₀ β₁ x) -
        anchorTransportDefect T₀₂ L₀₂ β₀ β₂ x =
      β₂ (anchorComparisonPathDefect T₀₁ T₁₂ T₀₂ x) (T₀₂ x) +
        β₂ (T₀₂ x) (anchorComparisonPathDefect T₀₁ T₁₂ T₀₂ x) +
        β₂ (anchorComparisonPathDefect T₀₁ T₁₂ T₀₂ x)
          (anchorComparisonPathDefect T₀₁ T₁₂ T₀₂ x) -
        anchorComparisonPathDefect L₀₁ L₁₂ L₀₂ (quadraticAnchor β₀ x) := by
  simp only [anchorTransportDefect, quadraticAnchor, anchorComparisonPathDefect,
    LinearMap.sub_apply, LinearMap.comp_apply, map_sub]
  abel

/--
When both state and public comparison triangles are flat, anchor defects satisfy an exact cocycle
law.
-/
theorem anchorTransportDefect_flat_triangle
    (β₀ β₁ β₂ : BilinearAnchor R V W)
    (T₀₁ T₁₂ T₀₂ : V →ₗ[R] V)
    (L₀₁ L₁₂ L₀₂ : W →ₗ[R] W)
    (hTflat : T₁₂.comp T₀₁ = T₀₂)
    (hLflat : L₁₂.comp L₀₁ = L₀₂)
    (x : V) :
    anchorTransportDefect T₁₂ L₁₂ β₁ β₂ (T₀₁ x) +
        L₁₂ (anchorTransportDefect T₀₁ L₀₁ β₀ β₁ x) =
      anchorTransportDefect T₀₂ L₀₂ β₀ β₂ x := by
  have hKT : anchorComparisonPathDefect T₀₁ T₁₂ T₀₂ = 0 :=
    sub_eq_zero.mpr hTflat
  have hKL : anchorComparisonPathDefect L₀₁ L₁₂ L₀₂ = 0 :=
    sub_eq_zero.mpr hLflat
  have h := anchorTransportDefect_triangle_bianchi
    β₀ β₁ β₂ T₀₁ T₁₂ T₀₂ L₀₁ L₁₂ L₀₂ x
  simp [hKT, hKL] at h
  exact sub_eq_zero.mp h

end GaloisForLFunctions.HTGeometry
