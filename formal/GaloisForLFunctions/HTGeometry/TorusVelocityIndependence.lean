import GaloisForLFunctions.HTGeometry.TorusVelocityField
import GaloisForLFunctions.HTGeometry.DifferentialIndependentTransfer
import GaloisForLFunctions.HTGeometry.SourceLogarithmicBoundary
import GaloisForLFunctions.HTGeometry.HypertranscendentalPow

/-!
# The velocity coordinates of a palette are differentially independent

The logarithmic derivatives of a freely generating palette are pairwise distinct, because an
equality of two of them is a nonzero quadratic relation between four jets of the palette.  Each
palette coordinate solves the first-order equation `x' = ℓ x` over the field generated by the
logarithmic derivatives, so it is differentially algebraic there; a spanning family of the size of
an independent one is itself independent.

Consequently the velocity field of a rank-`r` palette has differential transcendence degree `r`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
include hx in
/-- **Distinct palette coordinates have distinct logarithmic derivatives.**  An equality of two of
them is the relation `x_i' x_j = x_j' x_i`, a nonzero quadratic polynomial in four distinct jets. -/
theorem logDeriv_injective_of_differentialIndependent :
    Function.Injective fun i ↦ Differential.logDeriv (x i) := by
  classical
  intro i j hij
  by_contra hne
  have hx0 : ∀ k, x k ≠ 0 := torus_palette_ne_zero hx
  have hrel : (x i)′ * x j = (x j)′ * x i := by
    have h : (x i)′ / x i = (x j)′ / x j := hij
    exact (div_eq_div_iff (hx0 i) (hx0 j)).mp h
  have hJ : AlgebraicIndependent C (fun p : Fin r × ℕ ↦ differentialJet p.2 (x p.1)) := hx
  set m₁ : (Fin r × ℕ) →₀ ℕ :=
    Finsupp.single ((i, 1) : Fin r × ℕ) 1 + Finsupp.single ((j, 0) : Fin r × ℕ) 1 with hm₁
  set m₂ : (Fin r × ℕ) →₀ ℕ :=
    Finsupp.single ((j, 1) : Fin r × ℕ) 1 + Finsupp.single ((i, 0) : Fin r × ℕ) 1 with hm₂
  have hm : m₂ ≠ m₁ := by
    intro h
    have hji : ¬ (j = i) := fun h' ↦ hne h'.symm
    have hval := congrArg (fun f : (Fin r × ℕ) →₀ ℕ ↦ f ((i, 1) : Fin r × ℕ)) h
    simp only [hm₁, hm₂, Finsupp.add_apply, Finsupp.single_apply, Prod.mk.injEq] at hval
    simp [hji] at hval
  have hXX : ∀ a b : Fin r × ℕ,
      (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin r × ℕ) C)
        = MvPolynomial.monomial (Finsupp.single a 1 + Finsupp.single b 1) 1 := by
    intro a b
    simp [MvPolynomial.X, MvPolynomial.monomial_mul]
  set p : MvPolynomial (Fin r × ℕ) C :=
    MvPolynomial.X ((i, 1) : Fin r × ℕ) * MvPolynomial.X ((j, 0) : Fin r × ℕ)
      - MvPolynomial.X ((j, 1) : Fin r × ℕ) * MvPolynomial.X ((i, 0) : Fin r × ℕ) with hp
  have hcoeff : MvPolynomial.coeff m₁ p = 1 := by
    rw [hp, MvPolynomial.coeff_sub, hXX, hXX, ← hm₁, ← hm₂, MvPolynomial.coeff_monomial,
      MvPolynomial.coeff_monomial, if_pos rfl, if_neg hm, sub_zero]
  have hpne : p ≠ 0 := by
    intro h
    rw [h, MvPolynomial.coeff_zero] at hcoeff
    exact zero_ne_one hcoeff
  have hpeval : MvPolynomial.aeval (fun q : Fin r × ℕ ↦ differentialJet q.2 (x q.1)) p = 0 := by
    rw [hp]
    simp only [map_sub, map_mul, MvPolynomial.aeval_X, differentialJet_zero, differentialJet_succ]
    rw [sub_eq_zero]
    simpa using hrel
  exact hpne (algebraicIndependent_iff.mp hJ p hpeval)

include hx in
/-- **The velocity coordinates of a palette are differentially independent.**  Each coordinate is
differentially algebraic over the field they generate, by the first-order equation `x' = ℓ x`, and a
spanning family of the size of an independent one is independent. -/
theorem differentialIndependent_logDeriv :
    DifferentialIndependent C (fun i ↦ Differential.logDeriv (x i)) := by
  classical
  refine differentialIndependent_of_range_subset_closure hx
    (logDeriv_injective_of_differentialIndependent hx) fun i ↦ ?_
  letI : DifferentialAlgebra
      (↥(differentialAdjoin C (Set.range fun k ↦ Differential.logDeriv (x k)))) E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C
        (Set.range fun k ↦ Differential.logDeriv (x k))) c⟩
  have hmem : Differential.logDeriv (x i)
      ∈ differentialAdjoin C (Set.range fun k ↦ Differential.logDeriv (x k)) :=
    subset_differentialAdjoin C _ (Set.mem_range_self i)
  have hDAlog : DifferentialAlgebraicOver
      (↥(differentialAdjoin C (Set.range fun k ↦ Differential.logDeriv (x k))))
      ((x i)′ / x i) := by
    refine differentialAlgebraicOver_of_isAlgebraic ?_
    have hcoe : (x i)′ / x i
        = algebraMap (↥(differentialAdjoin C (Set.range fun k ↦ Differential.logDeriv (x k)))) E
          ⟨Differential.logDeriv (x i), hmem⟩ := rfl
    rw [hcoe]
    exact isAlgebraic_algebraMap _
  exact (differentialAlgebraicOver_deriv_div_self_iff (x i)).mp hDAlog

end

end

end GaloisForLFunctions.HTGeometry
