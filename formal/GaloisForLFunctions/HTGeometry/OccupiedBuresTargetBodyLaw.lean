import GaloisForLFunctions.HTGeometry.CompactBuresTargetMinimaxLaw
import Mathlib.Analysis.Convex.TotallyBounded
import Mathlib.Analysis.Normed.Group.Bounded

/-!
# Occupied target body Bures law

This module forms the closed convex body generated by an arbitrary compact
occupied target image.  It identifies its reporter maximum with the supremum
over the actual occupied rays and proves complete and return-excised incidence
laws for finite, countably infinite, or continuously parameterized targets.
-/

open Filter MeasureTheory Matrix Set
open scoped BigOperators ComplexConjugate ComplexOrder MatrixOrder Matrix.Norms.L2Operator Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## Closed convex body generated by an occupied target image -/

def finiteBuresOccupiedTargetBody {n : ℕ}
    (V : Set (Fin n → ℂ)) : Set (Matrix (Fin n) (Fin n) ℂ) :=
  closedConvexHull ℝ (finiteBuresTargetRay '' V)

theorem continuous_finiteBuresTargetRay {n : ℕ} :
    Continuous (finiteBuresTargetRay : (Fin n → ℂ) →
      Matrix (Fin n) (Fin n) ℂ) := by
  unfold finiteBuresTargetRay Matrix.vecMulVec
  fun_prop

theorem finiteBuresTargetRay_mem_occupiedTargetBody
    {n : ℕ} {V : Set (Fin n → ℂ)} {v : Fin n → ℂ} (hv : v ∈ V) :
    finiteBuresTargetRay v ∈ finiteBuresOccupiedTargetBody V := by
  apply subset_closedConvexHull
  exact ⟨v, hv, rfl⟩

theorem finiteBuresOccupiedTargetBody_nonempty
    {n : ℕ} {V : Set (Fin n → ℂ)} (hVne : V.Nonempty) :
    (finiteBuresOccupiedTargetBody V).Nonempty := by
  obtain ⟨v, hv⟩ := hVne
  exact ⟨finiteBuresTargetRay v,
    finiteBuresTargetRay_mem_occupiedTargetBody hv⟩

theorem finiteBuresOccupiedTargetBody_convex
    {n : ℕ} (V : Set (Fin n → ℂ)) :
    Convex ℝ (finiteBuresOccupiedTargetBody V) := by
  exact convex_closedConvexHull

theorem finiteBuresOccupiedTargetBody_isClosed
    {n : ℕ} (V : Set (Fin n → ℂ)) :
    IsClosed (finiteBuresOccupiedTargetBody V) := by
  exact isClosed_closedConvexHull

theorem isClosed_finitePosSemidefMatrices {n : ℕ} :
    IsClosed {M : Matrix (Fin n) (Fin n) ℂ | M.PosSemidef} := by
  letI : CStarAlgebra (Matrix (Fin n) (Fin n) ℂ) := {}
  have hclosed : IsClosed
      {M : Matrix (Fin n) (Fin n) ℂ | (0 : Matrix (Fin n) (Fin n) ℂ) ≤ M} :=
    CStarAlgebra.isClosed_nonneg
  convert hclosed using 1
  ext M
  exact Matrix.nonneg_iff_posSemidef.symm

theorem convex_finitePosSemidefMatrices {n : ℕ} :
    Convex ℝ {M : Matrix (Fin n) (Fin n) ℂ | M.PosSemidef} := by
  rw [show {M : Matrix (Fin n) (Fin n) ℂ | M.PosSemidef} = Set.Ici 0 by
    ext M
    exact Matrix.nonneg_iff_posSemidef.symm]
  exact convex_Ici _

theorem finiteBuresOccupiedTargetBody_posSemidef
    {n : ℕ} (V : Set (Fin n → ℂ)) :
    finiteBuresOccupiedTargetBody V ⊆
      {M : Matrix (Fin n) (Fin n) ℂ | M.PosSemidef} := by
  apply closedConvexHull_min
  · rintro M ⟨v, hv, rfl⟩
    exact finiteBuresTargetRay_posSemidef v
  · exact convex_finitePosSemidefMatrices
  · exact isClosed_finitePosSemidefMatrices

theorem finiteBuresOccupiedTargetBody_isCompact
    {n : ℕ} {V : Set (Fin n → ℂ)} (hVcompact : IsCompact V) :
    IsCompact (finiteBuresOccupiedTargetBody V) := by
  rw [finiteBuresOccupiedTargetBody, closedConvexHull_eq_closure_convexHull]
  have hRayCompact : IsCompact (finiteBuresTargetRay '' V) :=
    hVcompact.image continuous_finiteBuresTargetRay
  have htb : TotallyBounded
      (convexHull ℝ (finiteBuresTargetRay '' V)) :=
    totallyBounded_convexHull _ hRayCompact.totallyBounded
  exact htb.closure.isCompact_of_isClosed isClosed_closure

def finiteBuresOccupiedLeverageValueSet {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℂ) (V : Set (Fin n → ℂ)) : Set ℝ :=
  {q | ∃ v ∈ V, q = finiteBuresTargetLeverage A v}

def finiteBuresOccupiedTargetMaximum {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℂ) (V : Set (Fin n → ℂ)) : ℝ :=
  sSup (finiteBuresOccupiedLeverageValueSet A V)

theorem continuous_finiteBuresTargetLeverage
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) :
    Continuous (finiteBuresTargetLeverage A) := by
  unfold finiteBuresTargetLeverage
  fun_prop

theorem finiteBuresOccupiedLeverageValueSet_nonempty
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty) :
    (finiteBuresOccupiedLeverageValueSet A V).Nonempty := by
  obtain ⟨v, hv⟩ := hVne
  exact ⟨finiteBuresTargetLeverage A v, v, hv, rfl⟩

theorem finiteBuresOccupiedLeverageValueSet_bddAbove
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVcompact : IsCompact V) :
    BddAbove (finiteBuresOccupiedLeverageValueSet A V) := by
  have himage := hVcompact.image (continuous_finiteBuresTargetLeverage A)
  obtain ⟨B, hB⟩ := himage.bddAbove
  refine ⟨B, ?_⟩
  rintro q ⟨v, hv, rfl⟩
  exact hB ⟨v, hv, rfl⟩

theorem finiteBuresTargetLeverage_le_occupiedTargetMaximum
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVcompact : IsCompact V)
    {v : Fin n → ℂ} (hv : v ∈ V) :
    finiteBuresTargetLeverage A v ≤ finiteBuresOccupiedTargetMaximum A V := by
  unfold finiteBuresOccupiedTargetMaximum
  exact le_csSup (finiteBuresOccupiedLeverageValueSet_bddAbove A hVcompact)
    ⟨v, hv, rfl⟩

theorem convex_finiteBuresTargetPairing_sublevel
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (B : ℝ) :
    Convex ℝ {M : Matrix (Fin n) (Fin n) ℂ |
      finiteBuresTargetPairing M A ≤ B} := by
  intro M hM N hN a b ha hb hab
  simp only [Set.mem_setOf_eq] at hM hN ⊢
  unfold finiteBuresTargetPairing at hM hN ⊢
  simp only [Matrix.add_mul, Matrix.smul_mul, Matrix.trace_add,
    Matrix.trace_smul, Complex.add_re, Complex.smul_re, smul_eq_mul]
  have hBcomb : a * B + b * B = B := by
    rw [← add_mul, hab, one_mul]
  nlinarith

theorem isClosed_finiteBuresTargetPairing_sublevel
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (B : ℝ) :
    IsClosed {M : Matrix (Fin n) (Fin n) ℂ |
      finiteBuresTargetPairing M A ≤ B} := by
  have hcont : Continuous (fun M => finiteBuresTargetPairing M A) := by
    unfold finiteBuresTargetPairing
    fun_prop
  exact isClosed_le hcont continuous_const

/-- A continuous affine target functional has the same maximum on the actual
occupied rays and on their closed convex hull. -/
theorem compactBuresTargetMaximum_occupiedBody_eq
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty)
    (hVcompact : IsCompact V) :
    compactBuresTargetMaximum A (finiteBuresOccupiedTargetBody V) =
      finiteBuresOccupiedTargetMaximum A V := by
  let K := finiteBuresOccupiedTargetBody V
  have hKcompact : IsCompact K := finiteBuresOccupiedTargetBody_isCompact hVcompact
  have hKne : K.Nonempty := finiteBuresOccupiedTargetBody_nonempty hVne
  apply le_antisymm
  · unfold compactBuresTargetMaximum
    apply csSup_le (compactBuresTargetPairingValueSet_nonempty A hKne)
    rintro q ⟨M, hM, rfl⟩
    have hrays : finiteBuresTargetRay '' V ⊆
        {N : Matrix (Fin n) (Fin n) ℂ |
          finiteBuresTargetPairing N A ≤ finiteBuresOccupiedTargetMaximum A V} := by
      rintro N ⟨v, hv, rfl⟩
      change finiteBuresTargetPairing (finiteBuresTargetRay v) A ≤
        finiteBuresOccupiedTargetMaximum A V
      rw [finiteBuresTargetRay_pairing_eq_leverage]
      exact finiteBuresTargetLeverage_le_occupiedTargetMaximum A hVcompact hv
    have hbody := closedConvexHull_min hrays
      (convex_finiteBuresTargetPairing_sublevel A
        (finiteBuresOccupiedTargetMaximum A V))
      (isClosed_finiteBuresTargetPairing_sublevel A
        (finiteBuresOccupiedTargetMaximum A V))
    exact hbody hM
  · unfold finiteBuresOccupiedTargetMaximum
    apply csSup_le (finiteBuresOccupiedLeverageValueSet_nonempty A hVne)
    rintro q ⟨v, hv, rfl⟩
    rw [← finiteBuresTargetRay_pairing_eq_leverage]
    unfold compactBuresTargetMaximum
    exact le_csSup (compactBuresTargetPairingValueSet_bddAbove A hKcompact)
      ⟨finiteBuresTargetRay v,
        finiteBuresTargetRay_mem_occupiedTargetBody hv, rfl⟩

/-- Explicit reporter form of the occupied-body product capacity. -/
theorem compactBuresProductCapacity_occupiedBody_eq_reporterInfimum
    {n : ℕ} (source : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty)
    (hVcompact : IsCompact V) :
    compactBuresProductCapacity source (finiteBuresOccupiedTargetBody V) =
      sInf {q : ℝ | ∃ A : Matrix (Fin n) (Fin n) ℂ, A.PosDef ∧
        q = finiteBuresSourcePairing source A *
          finiteBuresOccupiedTargetMaximum A V} := by
  unfold compactBuresProductCapacity compactBuresProductValueSet
  congr 2
  ext q
  constructor
  · rintro ⟨A, hA, rfl⟩
    exact ⟨A, hA, by
      rw [compactBuresTargetMaximum_occupiedBody_eq A hVne hVcompact]⟩
  · rintro ⟨A, hA, rfl⟩
    exact ⟨A, hA, by
      rw [compactBuresTargetMaximum_occupiedBody_eq A hVne hVcompact]⟩

/-- **Universal compact occupied-image Bures incidence law.**  Target labels
may be finite, countably infinite, or continuously parameterized. -/
theorem occupiedTargetBures_completeIncidence_minimax_bound
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (hTargetCompact : IsCompact (Set.range target))
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j)) mu) :
    threshold * mu.real
        (finitePositiveReporterCaptureEvent target state threshold) ≤
      compactBuresDualCapacity
        (finitePositiveReporterSourceCovariance mu state)
        (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 := by
  let V : Set (Fin n → ℂ) := Set.range target
  have hVne : V.Nonempty := Set.range_nonempty target
  exact compactBures_completeIncidence_minimax_bound
    mu target state threshold hthreshold
      (finiteBuresOccupiedTargetBody_nonempty hVne)
      (finiteBuresOccupiedTargetBody_isCompact hTargetCompact)
      (finiteBuresOccupiedTargetBody_convex V)
      (finiteBuresOccupiedTargetBody_posSemidef V)
      (fun c => finiteBuresTargetRay_mem_occupiedTargetBody
        (Set.mem_range_self c)) hprod

theorem occupiedTargetBures_returnExcisedIncidence_minimax_bound
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (returnSet : Set X) (hreturn : MeasurableSet returnSet)
    (hTargetCompact : IsCompact (Set.range target))
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j))
        (mu.restrict returnSetᶜ)) :
    mu.real (finitePositiveReporterCaptureEvent target state threshold) ≤
      mu.real returnSet +
        compactBuresDualCapacity
          (finitePositiveReporterSourceCovariance
            (mu.restrict returnSetᶜ) state)
          (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 / threshold := by
  let V : Set (Fin n → ℂ) := Set.range target
  have hVne : V.Nonempty := Set.range_nonempty target
  exact compactBures_returnExcisedIncidence_minimax_bound
    mu target state threshold hthreshold returnSet hreturn
      (finiteBuresOccupiedTargetBody_nonempty hVne)
      (finiteBuresOccupiedTargetBody_isCompact hTargetCompact)
      (finiteBuresOccupiedTargetBody_convex V)
      (finiteBuresOccupiedTargetBody_posSemidef V)
      (fun c => finiteBuresTargetRay_mem_occupiedTargetBody
        (Set.mem_range_self c)) hprod

end

end GaloisForLFunctions.HTGeometry


namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## Arbitrary bounded occupied target images -/

/-- In finite dimension, closing a bounded target set before taking occupied
rays does not alter its closed convex ray body. -/
theorem finiteBuresOccupiedTargetBody_closure_of_isBounded
    {n : ℕ} {V : Set (Fin n → ℂ)} (hVbounded : Bornology.IsBounded V) :
    finiteBuresOccupiedTargetBody (closure V) =
      finiteBuresOccupiedTargetBody V := by
  unfold finiteBuresOccupiedTargetBody
  have hVcompact : IsCompact (closure V) :=
    Metric.isCompact_iff_isClosed_bounded.mpr
      ⟨isClosed_closure, hVbounded.closure⟩
  rw [image_closure_of_isCompact hVcompact
    continuous_finiteBuresTargetRay.continuousOn]
  exact closedConvexHull_closure_eq_closedConvexHull

/-- Every bounded occupied target image has a compact closed convex ray body
in finite dimension. -/
theorem finiteBuresOccupiedTargetBody_isCompact_of_isBounded
    {n : ℕ} {V : Set (Fin n → ℂ)} (hVbounded : Bornology.IsBounded V) :
    IsCompact (finiteBuresOccupiedTargetBody V) := by
  have hVcompact : IsCompact (closure V) :=
    Metric.isCompact_iff_isClosed_bounded.mpr
      ⟨isClosed_closure, hVbounded.closure⟩
  rw [← finiteBuresOccupiedTargetBody_closure_of_isBounded hVbounded]
  exact finiteBuresOccupiedTargetBody_isCompact hVcompact

theorem finiteBuresOccupiedLeverageValueSet_bddAbove_of_isBounded
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVbounded : Bornology.IsBounded V) :
    BddAbove (finiteBuresOccupiedLeverageValueSet A V) := by
  have hVcompact : IsCompact (closure V) :=
    Metric.isCompact_iff_isClosed_bounded.mpr
      ⟨isClosed_closure, hVbounded.closure⟩
  exact (finiteBuresOccupiedLeverageValueSet_bddAbove A hVcompact).mono <| by
    rintro q ⟨v, hv, rfl⟩
    exact ⟨v, subset_closure hv, rfl⟩

theorem finiteBuresTargetLeverage_le_occupiedTargetMaximum_of_isBounded
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVbounded : Bornology.IsBounded V)
    {v : Fin n → ℂ} (hv : v ∈ V) :
    finiteBuresTargetLeverage A v ≤ finiteBuresOccupiedTargetMaximum A V := by
  unfold finiteBuresOccupiedTargetMaximum
  exact le_csSup
    (finiteBuresOccupiedLeverageValueSet_bddAbove_of_isBounded A hVbounded)
    ⟨v, hv, rfl⟩

/-- A continuous leverage functional has the same supremum on a nonempty
bounded set and its closure. -/
theorem finiteBuresOccupiedTargetMaximum_closure_eq
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty)
    (hVbounded : Bornology.IsBounded V) :
    finiteBuresOccupiedTargetMaximum A (closure V) =
      finiteBuresOccupiedTargetMaximum A V := by
  have hClosureBounded : Bornology.IsBounded (closure V) := hVbounded.closure
  have hClosureNe : (closure V).Nonempty := hVne.mono subset_closure
  apply le_antisymm
  · unfold finiteBuresOccupiedTargetMaximum
    apply csSup_le (finiteBuresOccupiedLeverageValueSet_nonempty A hClosureNe)
    rintro q ⟨v, hv, rfl⟩
    have hsub : V ⊆ {w : Fin n → ℂ |
        finiteBuresTargetLeverage A w ≤
          sSup (finiteBuresOccupiedLeverageValueSet A V)} := by
      intro w hw
      exact le_csSup
        (finiteBuresOccupiedLeverageValueSet_bddAbove_of_isBounded A hVbounded)
        ⟨w, hw, rfl⟩
    have hclosed : IsClosed {w : Fin n → ℂ |
        finiteBuresTargetLeverage A w ≤
          sSup (finiteBuresOccupiedLeverageValueSet A V)} :=
      isClosed_le (continuous_finiteBuresTargetLeverage A) continuous_const
    exact (closure_minimal hsub hclosed) hv
  · unfold finiteBuresOccupiedTargetMaximum
    apply csSup_le (finiteBuresOccupiedLeverageValueSet_nonempty A hVne)
    rintro q ⟨v, hv, rfl⟩
    exact le_csSup
      (finiteBuresOccupiedLeverageValueSet_bddAbove_of_isBounded A hClosureBounded)
      ⟨v, subset_closure hv, rfl⟩

/-- Reporter maximum over an arbitrary nonempty bounded occupied image equals
the supremum over its actual target rays. -/
theorem compactBuresTargetMaximum_occupiedBody_eq_of_isBounded
    {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty)
    (hVbounded : Bornology.IsBounded V) :
    compactBuresTargetMaximum A (finiteBuresOccupiedTargetBody V) =
      finiteBuresOccupiedTargetMaximum A V := by
  have hVcompact : IsCompact (closure V) :=
    Metric.isCompact_iff_isClosed_bounded.mpr
      ⟨isClosed_closure, hVbounded.closure⟩
  rw [← finiteBuresOccupiedTargetBody_closure_of_isBounded hVbounded,
    compactBuresTargetMaximum_occupiedBody_eq A
      (hVne.mono subset_closure) hVcompact,
    finiteBuresOccupiedTargetMaximum_closure_eq A hVne hVbounded]

/-- Explicit reporter minimax for every nonempty bounded occupied target
image, without a compactness assumption on the original parameter image. -/
theorem compactBuresProductCapacity_occupiedBody_eq_reporterInfimum_of_isBounded
    {n : ℕ} (source : Matrix (Fin n) (Fin n) ℂ)
    {V : Set (Fin n → ℂ)} (hVne : V.Nonempty)
    (hVbounded : Bornology.IsBounded V) :
    compactBuresProductCapacity source (finiteBuresOccupiedTargetBody V) =
      sInf {q : ℝ | ∃ A : Matrix (Fin n) (Fin n) ℂ, A.PosDef ∧
        q = finiteBuresSourcePairing source A *
          finiteBuresOccupiedTargetMaximum A V} := by
  unfold compactBuresProductCapacity compactBuresProductValueSet
  congr 2
  ext q
  constructor
  · rintro ⟨A, hA, rfl⟩
    exact ⟨A, hA, by
      rw [compactBuresTargetMaximum_occupiedBody_eq_of_isBounded
        A hVne hVbounded]⟩
  · rintro ⟨A, hA, rfl⟩
    exact ⟨A, hA, by
      rw [compactBuresTargetMaximum_occupiedBody_eq_of_isBounded
        A hVne hVbounded]⟩

/-- **Universal bounded occupied-image Bures incidence law.**  No topology or
enumerability assumption is imposed on target labels; boundedness alone is
enough in the finite-dimensional carrier. -/
theorem occupiedTargetBures_completeIncidence_minimax_bound_of_isBounded
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (hTargetBounded : Bornology.IsBounded (Set.range target))
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j)) mu) :
    threshold * mu.real
        (finitePositiveReporterCaptureEvent target state threshold) ≤
      compactBuresDualCapacity
        (finitePositiveReporterSourceCovariance mu state)
        (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 := by
  let V : Set (Fin n → ℂ) := Set.range target
  have hVne : V.Nonempty := Set.range_nonempty target
  exact compactBures_completeIncidence_minimax_bound
    mu target state threshold hthreshold
      (finiteBuresOccupiedTargetBody_nonempty hVne)
      (finiteBuresOccupiedTargetBody_isCompact_of_isBounded hTargetBounded)
      (finiteBuresOccupiedTargetBody_convex V)
      (finiteBuresOccupiedTargetBody_posSemidef V)
      (fun c => finiteBuresTargetRay_mem_occupiedTargetBody
        (Set.mem_range_self c)) hprod

theorem occupiedTargetBures_returnExcisedIncidence_minimax_bound_of_isBounded
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (returnSet : Set X) (hreturn : MeasurableSet returnSet)
    (hTargetBounded : Bornology.IsBounded (Set.range target))
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j))
        (mu.restrict returnSetᶜ)) :
    mu.real (finitePositiveReporterCaptureEvent target state threshold) ≤
      mu.real returnSet +
        compactBuresDualCapacity
          (finitePositiveReporterSourceCovariance
            (mu.restrict returnSetᶜ) state)
          (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 / threshold := by
  let V : Set (Fin n → ℂ) := Set.range target
  have hVne : V.Nonempty := Set.range_nonempty target
  exact compactBures_returnExcisedIncidence_minimax_bound
    mu target state threshold hthreshold returnSet hreturn
      (finiteBuresOccupiedTargetBody_nonempty hVne)
      (finiteBuresOccupiedTargetBody_isCompact_of_isBounded hTargetBounded)
      (finiteBuresOccupiedTargetBody_convex V)
      (finiteBuresOccupiedTargetBody_posSemidef V)
      (fun c => finiteBuresTargetRay_mem_occupiedTargetBody
        (Set.mem_range_self c)) hprod

/-- Closed-unit-ball specialization of the universal bounded-target law. -/
theorem occupiedTargetBures_completeIncidence_minimax_bound_of_norm_le_one
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (hTargetNorm : ∀ c, ‖target c‖ ≤ 1)
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j)) mu) :
    threshold * mu.real
        (finitePositiveReporterCaptureEvent target state threshold) ≤
      compactBuresDualCapacity
        (finitePositiveReporterSourceCovariance mu state)
        (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 := by
  apply occupiedTargetBures_completeIncidence_minimax_bound_of_isBounded
    mu target state threshold hthreshold
  · rw [isBounded_iff_forall_norm_le]
    exact ⟨1, by rintro v ⟨c, rfl⟩; exact hTargetNorm c⟩
  · exact hprod


/-- Closed-unit-ball specialization of the return-excised universal law. -/
theorem occupiedTargetBures_returnExcisedIncidence_minimax_bound_of_norm_le_one
    {X C : Type*} [MeasurableSpace X] [Nonempty C] {n : ℕ}
    (mu : Measure X) [IsFiniteMeasure mu]
    (target : C → Fin n → ℂ) (state : X → Fin n → ℂ)
    (threshold : ℝ) (hthreshold : 0 < threshold)
    (returnSet : Set X) (hreturn : MeasurableSet returnSet)
    (hTargetNorm : ∀ c, ‖target c‖ ≤ 1)
    (hprod : ∀ i j, Integrable
      (fun x ↦ state x i * star (state x j))
        (mu.restrict returnSetᶜ)) :
    mu.real (finitePositiveReporterCaptureEvent target state threshold) ≤
      mu.real returnSet +
        compactBuresDualCapacity
          (finitePositiveReporterSourceCovariance
            (mu.restrict returnSetᶜ) state)
          (finiteBuresOccupiedTargetBody (Set.range target)) ^ 2 / threshold := by
  apply occupiedTargetBures_returnExcisedIncidence_minimax_bound_of_isBounded
    mu target state threshold hthreshold returnSet hreturn
  · rw [isBounded_iff_forall_norm_le]
    exact ⟨1, by rintro v ⟨c, rfl⟩; exact hTargetNorm c⟩
  · exact hprod

end

end GaloisForLFunctions.HTGeometry
