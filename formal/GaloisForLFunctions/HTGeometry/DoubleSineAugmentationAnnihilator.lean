import GaloisForLFunctions.HTGeometry.BarnesScalarAnnihilator
import GaloisForLFunctions.HTGeometry.OrderTwoStructuralTranslateDecomposition

/-!
# The augmentation-ideal translation annihilator of a one-step source

Let `Ψ` be hypertranscendental over `ℂ(z)` and suppose each single translation defect
`T_j Ψ - Ψ` is already differentially algebraic — the double-sine situation, where
`S₂(z + ω_j)/S₂(z)` is an elementary trigonometric factor, so the logarithmic derivative satisfies
`(T_j - 1) L₂ = ± (π/ω_k) cot(π z/ω_k)`, which is differentially algebraic.

Then the annihilator of `Ψ` modulo the differentially algebraic sector is exactly the augmentation
ideal:

```text
Q Ψ  is DA over ℂ(z)   ↔   Q(1,…,1) = 0.
```

The structural translation module generated by `Ψ` modulo differentially algebraic functions is
therefore the one-dimensional module `ℂ[T₁^{±1},…,T_N^{±1}]/(T₁-1,…,T_N-1) ≅ ℂ`: every structural
translate carries the same nonzero hypertranscendence class, and a translation operator kills that
class exactly when its total coefficient sum vanishes.

This contrasts with the Barnes source, whose annihilator is the principal Stanley–Reisner boundary
ideal `(∏_j (T_j - 1))`; imposing the reflection collapses `R/(x₁⋯x_N)` to `R/(x₁,…,x_N)`.

Everything here is unconditional: the two hypotheses `hstep` and `hHT` are properties of the given
source, and the conclusion is an exact iff.
-/

open Filter Set Topology Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic zeroNomeScalarTower

variable {N : ℕ}

/-! ## The augmentation map and the augmentation ideal -/

/-- The augmentation of a translation operator: the sum of its coefficients, i.e. its value at
`T₁ = ⋯ = T_N = 1`. -/
def augMap (N : ℕ) : MvPolynomial (Fin N) ℂ →+* ℂ := MvPolynomial.eval fun _ => (1 : ℂ)

@[simp] theorem augMap_X (i : Fin N) : augMap N (MvPolynomial.X i) = 1 := by
  simp [augMap]

@[simp] theorem augMap_C (a : ℂ) : augMap N (MvPolynomial.C a) = a := by
  simp [augMap]

/-- The augmentation is the total exponent: the sum of all coefficients. -/
theorem augMap_eq_sum (Q : MvPolynomial (Fin N) ℂ) :
    augMap N Q = ∑ n ∈ Q.support, MvPolynomial.coeff n Q := by
  rw [augMap, MvPolynomial.eval_eq']
  refine Finset.sum_congr rfl fun n _ => ?_
  simp

/-- The augmentation ideal, generated by the structural differences `T_i - 1`. -/
def augIdeal (N : ℕ) : Ideal (MvPolynomial (Fin N) ℂ) :=
  Ideal.span (Set.range fun i : Fin N => (MvPolynomial.X i - 1 : MvPolynomial (Fin N) ℂ))

theorem X_sub_one_mem_augIdeal (i : Fin N) :
    (MvPolynomial.X i - 1 : MvPolynomial (Fin N) ℂ) ∈ augIdeal N :=
  Ideal.subset_span ⟨i, rfl⟩

/-- **The augmentation splitting.**  Every translation operator differs from its total exponent by
an element of the augmentation ideal. -/
theorem sub_C_augMap_mem_augIdeal (Q : MvPolynomial (Fin N) ℂ) :
    Q - MvPolynomial.C (augMap N Q) ∈ augIdeal N := by
  induction Q using MvPolynomial.induction_on with
  | C a => rw [augMap_C, sub_self]; exact Ideal.zero_mem _
  | add p q hp hq =>
      have hsplit : p + q - MvPolynomial.C (augMap N (p + q))
          = (p - MvPolynomial.C (augMap N p)) + (q - MvPolynomial.C (augMap N q)) := by
        rw [map_add, map_add]
        ring
      rw [hsplit]
      exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
      have hsplit : p * MvPolynomial.X i - MvPolynomial.C (augMap N (p * MvPolynomial.X i))
          = (p - MvPolynomial.C (augMap N p)) * MvPolynomial.X i
            + MvPolynomial.C (augMap N p) * (MvPolynomial.X i - 1) := by
        rw [map_mul, augMap_X, mul_one]
        ring
      rw [hsplit]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (X_sub_one_mem_augIdeal i))

theorem augMap_eq_zero_of_mem_augIdeal {Q : MvPolynomial (Fin N) ℂ} (hQ : Q ∈ augIdeal N) :
    augMap N Q = 0 := by
  refine Submodule.span_induction (p := fun x _ => augMap N x = 0) ?_ ?_ ?_ ?_ hQ
  · rintro x ⟨i, rfl⟩
    rw [map_sub, augMap_X, map_one, sub_self]
  · exact map_zero _
  · intro x y _ _ hx hy
    rw [map_add, hx, hy, add_zero]
  · intro a x _ hx
    rw [smul_eq_mul, map_mul, hx, mul_zero]

/-- **The augmentation ideal is the augmentation kernel.** -/
theorem mem_augIdeal_iff_augMap_eq_zero (Q : MvPolynomial (Fin N) ℂ) :
    Q ∈ augIdeal N ↔ augMap N Q = 0 := by
  refine ⟨augMap_eq_zero_of_mem_augIdeal, fun h => ?_⟩
  have := sub_C_augMap_mem_augIdeal Q
  rwa [h, map_zero, sub_zero] at this

/-! ## Elementary properties of the scalar translation action -/

theorem transApply_zero_op (ω : Fin N → ℂ) (y : meroField (Set.univ : Set ℂ)) :
    transApply ω 0 y = 0 := by
  rw [transApply_eq_diffTranslateApply, constEmbed, map_zero, diffTranslateApply_zero_op]

theorem transApply_add (ω : Fin N → ℂ) (Q R : MvPolynomial (Fin N) ℂ)
    (y : meroField (Set.univ : Set ℂ)) :
    transApply ω (Q + R) y = transApply ω Q y + transApply ω R y := by
  rw [transApply_eq_diffTranslateApply, transApply_eq_diffTranslateApply,
    transApply_eq_diffTranslateApply, constEmbed, map_add, ← constEmbed, ← constEmbed,
    diffTranslateApply_add]

theorem transApply_sub (ω : Fin N → ℂ) (Q R : MvPolynomial (Fin N) ℂ)
    (y : meroField (Set.univ : Set ℂ)) :
    transApply ω (Q - R) y = transApply ω Q y - transApply ω R y := by
  rw [transApply_eq_diffTranslateApply, transApply_eq_diffTranslateApply,
    transApply_eq_diffTranslateApply, constEmbed, map_sub, ← constEmbed, ← constEmbed,
    diffTranslateApply_sub]

theorem transApply_mul (ω : Fin N → ℂ) (Q R : MvPolynomial (Fin N) ℂ)
    (y : meroField (Set.univ : Set ℂ)) :
    transApply ω (Q * R) y = transApply ω Q (transApply ω R y) := by
  rw [transApply_eq_diffTranslateApply, transApply_eq_diffTranslateApply,
    transApply_eq_diffTranslateApply, constEmbed, map_mul, ← constEmbed, ← constEmbed,
    diffTranslateApply_mul]

/-- A constant operator acts by scalar multiplication. -/
theorem transApply_C (ω : Fin N → ℂ) (c : ℂ) (y : meroField (Set.univ : Set ℂ)) :
    transApply ω (MvPolynomial.C c) y = algebraMap ℂ (meroField (Set.univ : Set ℂ)) c * y := by
  rw [transApply_eq_diffTranslateApply, constEmbed, MvPolynomial.map_C,
    show (MvPolynomial.C (Polynomial.C c) : MvPolynomial (Fin N) (Polynomial ℂ))
      = MvPolynomial.monomial 0 (Polynomial.C c) from MvPolynomial.C_apply,
    diffTranslateApply_monomial, monomialShift]
  simp only [Finsupp.coe_zero, Pi.zero_apply, Nat.cast_zero, zero_mul, Finset.sum_const_zero]
  rw [addTranslationMeroEquiv_zero_apply, differentialOperatorApply_polynomialC]

/-- The structural translation defect of a single period. -/
theorem transApply_X_sub_one (ω : Fin N → ℂ) (j : Fin N) (y : meroField (Set.univ : Set ℂ)) :
    transApply ω (MvPolynomial.X j - 1) y = addTranslationMeroEquiv (ω j) y - y := by
  rw [transApply_eq_diffTranslateApply, constEmbed, map_sub, MvPolynomial.map_X, map_one,
    diffTranslateApply_X_sub_one]

theorem differentialAlgebraicOver_transApply (ω : Fin N → ℂ) (Q : MvPolynomial (Fin N) ℂ)
    {y : meroField (Set.univ : Set ℂ)} (hy : DifferentialAlgebraicOver (RatFunc ℂ) y) :
    DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω Q y) := by
  rw [transApply_eq_diffTranslateApply]
  exact differentialAlgebraicOver_diffTranslateApply ω (constEmbed Q) hy

/-! ## The exact annihilator -/

/-- Every element of the augmentation ideal sends a one-step source into the differentially
algebraic sector. -/
theorem differentialAlgebraicOver_transApply_of_mem_augIdeal (ω : Fin N → ℂ)
    (Ψ : meroField (Set.univ : Set ℂ))
    (hstep : ∀ j, DifferentialAlgebraicOver (RatFunc ℂ)
      (addTranslationMeroEquiv (ω j) Ψ - Ψ))
    {Q : MvPolynomial (Fin N) ℂ} (hQ : Q ∈ augIdeal N) :
    DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω Q Ψ) := by
  refine Submodule.span_induction
    (p := fun x _ => DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω x Ψ)) ?_ ?_ ?_ ?_ hQ
  · rintro x ⟨i, rfl⟩
    rw [transApply_X_sub_one]
    exact hstep i
  · rw [transApply_zero_op]
    exact differentialAlgebraicOver_zero
  · intro x y _ _ hx hy
    rw [transApply_add]
    exact differentialAlgebraicOver_add hx hy
  · intro a x _ hx
    rw [smul_eq_mul, transApply_mul]
    exact differentialAlgebraicOver_transApply ω a hx

/-- **The exact augmentation-ideal annihilator.**  If every single-period translation defect of `Ψ`
is differentially algebraic and `Ψ` itself is not, then a translation operator sends `Ψ` into the
differentially algebraic sector exactly when its total exponent vanishes. -/
theorem differentialAlgebraicOver_transApply_iff_augMap_eq_zero (ω : Fin N → ℂ)
    (Ψ : meroField (Set.univ : Set ℂ))
    (hstep : ∀ j, DifferentialAlgebraicOver (RatFunc ℂ)
      (addTranslationMeroEquiv (ω j) Ψ - Ψ))
    (hHT : ¬ DifferentialAlgebraicOver (RatFunc ℂ) Ψ) (Q : MvPolynomial (Fin N) ℂ) :
    DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω Q Ψ) ↔ augMap N Q = 0 := by
  constructor
  · intro hDA
    by_contra hne
    have hideal := differentialAlgebraicOver_transApply_of_mem_augIdeal ω Ψ hstep
      (sub_C_augMap_mem_augIdeal Q)
    rw [transApply_sub] at hideal
    have hC : DifferentialAlgebraicOver (RatFunc ℂ)
        (transApply ω (MvPolynomial.C (augMap N Q)) Ψ) := by
      have hsub := differentialAlgebraicOver_sub hDA hideal
      have hcancel : transApply ω Q Ψ
            - (transApply ω Q Ψ - transApply ω (MvPolynomial.C (augMap N Q)) Ψ)
          = transApply ω (MvPolynomial.C (augMap N Q)) Ψ := by ring
      rwa [hcancel] at hsub
    rw [transApply_C] at hC
    have hscaled := differentialAlgebraicOver_mul
      (differentialAlgebraicOver_algebraMap_complex (augMap N Q)⁻¹) hC
    rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hne, map_one, one_mul] at hscaled
    exact hHT hscaled
  · intro h0
    exact differentialAlgebraicOver_transApply_of_mem_augIdeal ω Ψ hstep
      ((mem_augIdeal_iff_augMap_eq_zero Q).mpr h0)

/-- The annihilator, as a set of translation operators, is exactly the augmentation ideal. -/
theorem daTranslationAnnihilator_eq_augIdeal (ω : Fin N → ℂ)
    (Ψ : meroField (Set.univ : Set ℂ))
    (hstep : ∀ j, DifferentialAlgebraicOver (RatFunc ℂ)
      (addTranslationMeroEquiv (ω j) Ψ - Ψ))
    (hHT : ¬ DifferentialAlgebraicOver (RatFunc ℂ) Ψ) :
    {Q : MvPolynomial (Fin N) ℂ |
        DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω Q Ψ)}
      = (augIdeal N : Set (MvPolynomial (Fin N) ℂ)) := by
  ext Q
  rw [Set.mem_setOf_eq, SetLike.mem_coe, mem_augIdeal_iff_augMap_eq_zero]
  exact differentialAlgebraicOver_transApply_iff_augMap_eq_zero ω Ψ hstep hHT Q

/-- **Total exponent is the complete invariant.**  A translation operator sends the source into the
differentially algebraic sector exactly when the sum of its coefficients vanishes. -/
theorem differentialAlgebraicOver_transApply_iff_sum_coeff_eq_zero (ω : Fin N → ℂ)
    (Ψ : meroField (Set.univ : Set ℂ))
    (hstep : ∀ j, DifferentialAlgebraicOver (RatFunc ℂ)
      (addTranslationMeroEquiv (ω j) Ψ - Ψ))
    (hHT : ¬ DifferentialAlgebraicOver (RatFunc ℂ) Ψ) (Q : MvPolynomial (Fin N) ℂ) :
    DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω Q Ψ)
      ↔ ∑ n ∈ Q.support, MvPolynomial.coeff n Q = 0 := by
  rw [differentialAlgebraicOver_transApply_iff_augMap_eq_zero ω Ψ hstep hHT, augMap_eq_sum]

/-- **Every structural translate carries the same nonzero class.**  A single translate of the
source is never differentially algebraic. -/
theorem not_differentialAlgebraicOver_transApply_monomial (ω : Fin N → ℂ)
    (Ψ : meroField (Set.univ : Set ℂ))
    (hstep : ∀ j, DifferentialAlgebraicOver (RatFunc ℂ)
      (addTranslationMeroEquiv (ω j) Ψ - Ψ))
    (hHT : ¬ DifferentialAlgebraicOver (RatFunc ℂ) Ψ) (n : Fin N →₀ ℕ) {c : ℂ} (hc : c ≠ 0) :
    ¬ DifferentialAlgebraicOver (RatFunc ℂ) (transApply ω (MvPolynomial.monomial n c) Ψ) := by
  rw [differentialAlgebraicOver_transApply_iff_augMap_eq_zero ω Ψ hstep hHT, augMap,
    MvPolynomial.eval_monomial]
  simpa using hc

end

end GaloisForLFunctions.HTGeometry
