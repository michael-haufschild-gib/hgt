import GaloisForLFunctions.HTGeometry.SquarefreeVeroneseIdeal

/-!
# Minimal constraint presentations and exterior gauge amplification

An underived constraint ideal does not determine the homology of a chosen Koszul presentation:
adjoining zero generators preserves the ideal but supplies an arbitrary independent family of
relations, with an exterior label set of cardinality `2^q`.  A derived HT invariant must therefore
discard this presentation gauge.

The normal-crossing coface presentation lies on the positive side of this no-go.  Every coface
monomial is absent from the ideal generated by the others, so its derived excess cannot be
explained by redundant generators.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions.VeroneseIdeal
open MvPolynomial Finset

noncomputable section

variable {R ι κ : Type*} [CommRing R]

/-- The classical ideal presented by a family of generators. -/
def presentedIdeal (a : ι → R) : Ideal R :=
  Ideal.span (Set.range a)

/-- Stabilize a presentation by adjoining a family of zero generators. -/
def appendZeroPresentation (a : ι → R) : ι ⊕ κ → R :=
  Sum.elim a (fun _ => 0)

/-- **Classical invisibility of presentation stabilization.**  Adjoining arbitrarily many zero
generators leaves the presented ideal, and hence its classical quotient, unchanged. -/
theorem presentedIdeal_appendZeroPresentation (a : ι → R) :
    presentedIdeal (appendZeroPresentation (κ := κ) a) = presentedIdeal a := by
  apply le_antisymm
  · rw [presentedIdeal]
    refine Ideal.span_le.2 ?_
    rintro x ⟨i, rfl⟩
    cases i with
    | inl i => exact Ideal.subset_span ⟨i, rfl⟩
    | inr k => simp [appendZeroPresentation]
  · rw [presentedIdeal]
    refine Ideal.span_le.2 ?_
    rintro x ⟨i, rfl⟩
    apply Ideal.subset_span
    exact ⟨Sum.inl i, rfl⟩

section ZeroDirections

variable [DecidableEq ι] [DecidableEq κ]

/-- The coordinate relation carried by one adjoined zero generator. -/
def zeroRelationDirection (k : κ) : ι ⊕ κ → R :=
  Pi.single (Sum.inr k) 1

/-- The redundant relation directions are linearly independent.  Thus presentation stabilization
can create arbitrary first-syzygy rank without changing the classical constraint ideal. -/
theorem zeroRelationDirection_linearIndependent :
    LinearIndependent R (zeroRelationDirection (R := R) (ι := ι) (κ := κ)) := by
  have h := Pi.linearIndependent_single_one (ι ⊕ κ) R
  exact h.comp (fun k : κ => Sum.inr k) Sum.inr_injective

end ZeroDirections

section FiniteRelations

variable [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- The first relation map of a finite generator presentation. -/
def presentationRelation (a : ι → R) (c : ι → R) : R :=
  ∑ i, c i * a i

/-- Every adjoined zero coordinate is a genuine presentation relation. -/
theorem zeroRelationDirection_is_relation (a : ι → R) (k : κ) :
    presentationRelation (appendZeroPresentation (κ := κ) a)
      (zeroRelationDirection (R := R) (ι := ι) k) = 0 := by
  simp [presentationRelation, appendZeroPresentation, zeroRelationDirection]

end FiniteRelations

section ExteriorCount

variable [Fintype κ]

/-- The exterior labels on `q` redundant relation directions have exact cardinality `2^q`. -/
theorem redundantExteriorLabel_count :
    Fintype.card (Finset κ) = 2 ^ Fintype.card κ := by
  exact Fintype.card_finset

end ExteriorCount

variable {F : Type*} [Field F]

/-- All coface generators except the one indexed by `i`. -/
def cofaceOthersGens (r : ℕ) (i : Fin (r + 1)) :
    Set (MvPolynomial (Fin (r + 1)) F) :=
  {P | ∃ j : Fin (r + 1), j ≠ i ∧ P = cofaceMonomial r j}

/-- The ideal generated by all cofaces other than `i`. -/
noncomputable def cofaceOthersIdeal (r : ℕ) (i : Fin (r + 1)) :
    Ideal (MvPolynomial (Fin (r + 1)) F) :=
  Ideal.span (cofaceOthersGens (F := F) r i)

/-- Every other coface is divisible by `X_i`, so their ideal lies in the coordinate hyperplane
ideal `(X_i)`. -/
theorem cofaceOthersIdeal_le_span_X (r : ℕ) (i : Fin (r + 1)) :
    cofaceOthersIdeal (F := F) r i ≤ Ideal.span {X i} := by
  rw [cofaceOthersIdeal]
  refine Ideal.span_le.2 ?_
  rintro P ⟨j, hji, rfl⟩
  apply Ideal.mem_span_singleton.mpr
  exact X_dvd_cofaceMonomial_of_ne r (Ne.symm hji)

/-- **Normal-crossing source minimality.**  No coface gradient component belongs to the ideal
generated by the remaining components.  Hence the exterior derived excess of the normal-crossing
gradient sequence is intrinsic to an irredundant source presentation, not manufactured by zero or
dependent generators. -/
theorem cofaceMonomial_not_mem_cofaceOthersIdeal (r : ℕ) (i : Fin (r + 1)) :
    cofaceMonomial (F := F) r i ∉ cofaceOthersIdeal r i := by
  intro hmem
  have hspan := cofaceOthersIdeal_le_span_X (F := F) r i hmem
  have hdvd : X i ∣ cofaceMonomial (F := F) r i :=
    Ideal.mem_span_singleton.mp hspan
  exact X_not_dvd_cofaceMonomial r i hdvd

end

end GaloisForLFunctions.HTGeometry
