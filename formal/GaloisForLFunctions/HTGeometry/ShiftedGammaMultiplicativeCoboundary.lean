import GaloisForLFunctions.HTGeometry.ShiftedDigammaFamilyIndependence
import GaloisForLFunctions.HTGeometry.JetTranslateLeadingTerm
import GaloisForLFunctions.HTGeometry.RationalMultiplicativeShiftOrbit

/-!
# The shifted digamma field carries no Gamma-type multiplicative coboundary

The Gamma translates satisfy `σ(Γ_i) = (X+λ_i)Γ_i`, so a monomial `∏Γ_i^{m_i}` would lie in the
field generated by the shifted digammas only if some element of that field satisfied the same
multiplicative shift equation.  It does not.

An element of the field is a quotient of polynomials in the digamma jets, and those jets are
algebraically independent over `ℂ(X)`; the unit shift acts on them by translation by rational
increments.  Passing the equation through that presentation and taking degree-lexicographic leading
coefficients produces a rational solution of `w(X+1) = w(X)·∏(X+λ_i)^{m_i}`, which the orbit
obstruction excludes.
-/

open Filter Set Topology Function MvPolynomial MonomialOrder

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions RationalIncrementHolder Bottcher

noncomputable section

local instance shiftedGammaDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance shiftedGammaIntAlgebraAnalytic :
    Algebra ℤ (analyticSubring (Set.univ : Set ℂ)) := Ring.toIntAlgebra _

local instance shiftedGammaIntAlgebraMero :
    Algebra ℤ (meroField (Set.univ : Set ℂ)) := Ring.toIntAlgebra _

local instance shiftedGammaIntAlgebraRatFunc :
    Algebra ℤ (RatFunc ℂ) := Ring.toIntAlgebra _

local instance shiftedGammaDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance shiftedGammaRatDifferential : Differential (RatFunc ℂ) :=
  ratFuncCoordinateDifferential

local instance shiftedGammaRatAlgebra : Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero Set.univ isOpen_univ isPreconnected_univ
    Set.univ_nonempty Set.infinite_univ).toAlgebra

variable {r : ℕ}

/-- A jet of one shifted digamma, indexed by translate and order. -/
def digammaJet (lam : Fin r → ℂ) (p : Fin r × ℕ) : meroField (Set.univ : Set ℂ) :=
  differentialJet p.2 (digammaShiftMero (lam p.1))

/-- The unit shift translates each digamma jet by its rational increment. -/
theorem addTranslationMeroEquiv_digammaJet (lam : Fin r → ℂ) (p : Fin r × ℕ) :
    addTranslationMeroEquiv 1 (digammaJet lam p)
      = digammaJet lam p
        + algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
            (familyIncrement lam p.1 p.2) := by
  have hjetMap : ∀ (n : ℕ) (q : RatFunc ℂ),
      differentialJet n (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) q)
        = algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) (differentialJet n q) := by
    intro n
    induction n with
    | zero => intro q; simp
    | succ n ih =>
        intro q
        rw [differentialJet_succ, ih, differentialJet_succ]
        exact meroField_deriv_ratfuncToMero (differentialJet n q)
  show addTranslationMeroEquiv 1 (differentialJet p.2 (digammaShiftMero (lam p.1)))
      = differentialJet p.2 (digammaShiftMero (lam p.1))
        + algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
            (familyIncrement lam p.1 p.2)
  rw [ringEquiv_differentialJet (fun _ : Unit => addTranslationMeroEquiv 1)
      (fun _ y => addTranslationMeroEquiv_deriv 1 y) () p.2 (digammaShiftMero (lam p.1)),
    addTranslationMeroEquiv_digammaShiftMero, differentialJet_additive]
  congr 1
  show differentialJet p.2 (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
      (1 / (RatFunc.X + RatFunc.C (lam p.1))))
    = algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) (familyIncrement lam p.1 p.2)
  rw [hjetMap, differentialJet_one_div_shift lam p.1 p.2]

/-- The digamma jets are algebraically independent over `ℂ(X)`. -/
theorem algebraicIndependent_digammaJet (lam : Fin r → ℂ)
    (hincong : ∀ i i', i ≠ i' → ∀ n : ℤ, lam i - lam i' ≠ (n : ℂ)) :
    AlgebraicIndependent (RatFunc ℂ) (digammaJet lam) :=
  differentialIndependent_digammaShiftMero lam hincong

/-- **No Gamma-type multiplicative coboundary in the shifted digamma field.**  A quotient of
polynomials in finitely many digamma jets cannot be multiplied by a nontrivial monomial in the shift
factors under the unit shift. -/
theorem no_multiplicative_coboundary_digammaJets (lam : Fin r → ℂ)
    (hincong : ∀ i i', i ≠ i' → ∀ n : ℤ, lam i - lam i' ≠ (n : ℂ))
    {M : ℕ} (idx : Fin M → Fin r × ℕ) (hinj : Function.Injective idx)
    {P Q : MvPolynomial (Fin M) (RatFunc ℂ)} (hP : P ≠ 0) (hQ : Q ≠ 0)
    (mm : Fin r → ℤ) (i₀ : Fin r) (hmm : mm i₀ ≠ 0)
    (heq : addTranslationMeroEquiv 1
        (MvPolynomial.aeval (fun k => digammaJet lam (idx k)) P /
          MvPolynomial.aeval (fun k => digammaJet lam (idx k)) Q)
      = algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
          (∏ i : Fin r, (RatFunc.X + RatFunc.C (lam i)) ^ (mm i)) *
        (MvPolynomial.aeval (fun k => digammaJet lam (idx k)) P /
          MvPolynomial.aeval (fun k => digammaJet lam (idx k)) Q)) :
    False := by
  classical
  set xj : Fin M → meroField (Set.univ : Set ℂ) := fun k => digammaJet lam (idx k) with hxj
  set rj : ℕ → RatFunc ℂ := fun n =>
    if h : n < M then familyIncrement lam (idx ⟨n, h⟩).1 (idx ⟨n, h⟩).2 else 0 with hrj
  have hrjk : ∀ k : Fin M, rj (k : ℕ) = familyIncrement lam (idx k).1 (idx k).2 := by
    intro k
    rw [hrj]
    simp only [k.isLt, dif_pos, Fin.eta]
  have hjet : ∀ k : Fin M, addTranslationMeroEquiv 1 (xj k)
      = xj k + algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) (rj (k : ℕ)) := by
    intro k
    rw [hxj, hrjk k]
    exact addTranslationMeroEquiv_digammaJet lam (idx k)
  -- the evaluation is injective
  have hindep : AlgebraicIndependent (RatFunc ℂ) xj :=
    (algebraicIndependent_digammaJet lam hincong).comp idx hinj
  have hinjEval : Function.Injective (MvPolynomial.aeval (R := RatFunc ℂ) xj) :=
    algebraicIndependent_iff_injective_aeval.mp hindep
  have hevalP : MvPolynomial.aeval xj P ≠ 0 := by
    intro h0
    exact hP (hinjEval (by rw [h0, map_zero]))
  have hevalQ : MvPolynomial.aeval xj Q ≠ 0 := by
    intro h0
    exact hQ (hinjEval (by rw [h0, map_zero]))
  -- the shift on the evaluation is the jet substitution
  have haevalT : ∀ R : MvPolynomial (Fin M) (RatFunc ℂ),
      MvPolynomial.aeval xj (jetTranslateWith rj M R)
        = addTranslationMeroEquiv 1 (MvPolynomial.aeval xj R) := by
    intro R
    have hbase : ∀ q : RatFunc ℂ,
        addTranslationMeroEquiv 1 (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) q)
          = algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) (ratShift q) :=
      fun q => addTranslationMeroEquiv_ratfuncToMero q
    have := eval₂_jetTranslateWith (addTranslationMeroEquiv 1) hbase rj xj hjet R
    simpa [MvPolynomial.aeval_def] using this
  -- the polynomial form of the multiplicative shift equation
  have hpoly : jetTranslateWith rj M P * Q
      = MvPolynomial.C (∏ i : Fin r, (RatFunc.X + RatFunc.C (lam i)) ^ (mm i))
        * (P * jetTranslateWith rj M Q) := by
    refine hinjEval ?_
    rw [map_mul, map_mul, map_mul, haevalT, haevalT, MvPolynomial.aeval_C]
    rw [map_div₀] at heq
    have hTQ : addTranslationMeroEquiv 1 (MvPolynomial.aeval xj Q) ≠ 0 := by
      intro h0
      exact hevalQ ((addTranslationMeroEquiv 1).injective (by rw [h0, map_zero]))
    field_simp at heq
    linear_combination heq
  -- the leading coefficients give a rational solution
  have hratio := ratShift_leadingCoeff_ratio rj hP hQ hpoly
  have hlcP : degLex.leadingCoeff P ≠ 0 := MonomialOrder.leadingCoeff_ne_zero_iff.mpr hP
  have hlcQ : degLex.leadingCoeff Q ≠ 0 := MonomialOrder.leadingCoeff_ne_zero_iff.mpr hQ
  exact ratShift_ne_mul_shiftMonomial lam hincong mm i₀ hmm
    (w := degLex.leadingCoeff P / degLex.leadingCoeff Q) (div_ne_zero hlcP hlcQ)
    (hratio.trans (mul_comm _ _))

end

end GaloisForLFunctions.HTGeometry
