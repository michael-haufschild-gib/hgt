import GaloisForLFunctions.HTGeometry.MeroExponentialGauge
import GaloisForLFunctions.HTGeometry.CompositionJetField
import GaloisForLFunctions.HTGeometry.DeltaStructureLinearOde

/-!
# The ring generated by the composed jets

The jets of a composition live in the ring generated by the composed jets `f⁽ⁱ⁾ ∘ g` of the outer
factor and the jets `g⁽ʲ⁾` of the inner one: differentiating a generator raises its index by one and
multiplies by `g′`, so the ring of generators of index at most `m` maps into the one of index at most
`m + 1` under the field derivation.

This replaces Faà di Bruno's formula — only the *membership* is needed, not the coefficients.
-/

namespace GaloisForLFunctions.HTGeometry

open Bottcher
open scoped Differential UnivMeroFieldInstances

noncomputable section

/-- The composed jet `f⁽ⁱ⁾ ∘ g`, as an entire function. -/
def compJetFun (f g : ℂ → ℂ) (i : ℕ) : ℂ → ℂ := fun z => iteratedDeriv i f (g z)

theorem analyticOnNhd_compJetFun {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (i : ℕ) :
    AnalyticOnNhd ℂ (compJetFun f g i) (Set.univ : Set ℂ) := by
  have hi : Differentiable ℂ (iteratedDeriv i f) := differentiable_iteratedDeriv_entire hf i
  have hcomp : Differentiable ℂ (compJetFun f g i) := fun z => (hi (g z)).comp z (hg z)
  exact hcomp.differentiableOn.analyticOnNhd isOpen_univ

/-- The composed jet as an element of the meromorphic field. -/
def compJetElem {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g) (i : ℕ) :
    meroField (Set.univ : Set ℂ) :=
  analyticMeroElement (compJetFun f g i) (analyticOnNhd_compJetFun hf hg i)

/-- **The chain rule for composed jets.** -/
theorem deriv_compJetElem {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (i : ℕ) :
    (compJetElem hf hg i)′ = compJetElem hf hg (i + 1) * jetElem hg 1 := by
  rw [compJetElem, deriv_analyticMeroElement]
  have hfun : deriv (compJetFun f g i) = fun z => compJetFun f g (i + 1) z * iteratedDeriv 1 g z := by
    funext z
    have hi : Differentiable ℂ (iteratedDeriv i f) := differentiable_iteratedDeriv_entire hf i
    have hchain : deriv (fun w => iteratedDeriv i f (g w)) z
        = deriv (iteratedDeriv i f) (g z) * deriv g z :=
      deriv_comp z (hi (g z)) (hg z)
    show deriv (fun w => iteratedDeriv i f (g w)) z
      = iteratedDeriv (i + 1) f (g z) * iteratedDeriv 1 g z
    rw [hchain, ← iteratedDeriv_succ, iteratedDeriv_one]
  rw [analyticMeroElement_congr _
    ((analyticOnNhd_compJetFun hf hg (i + 1)).mul
      ((differentiable_iteratedDeriv_entire hg 1).differentiableOn.analyticOnNhd isOpen_univ))
    hfun]
  rw [analyticMeroElement_mul]
  rfl

/-- **The jets of the inner function shift.** -/
theorem deriv_jetElem {g : ℂ → ℂ} (hg : Differentiable ℂ g) (j : ℕ) :
    (jetElem hg j)′ = jetElem hg (j + 1) := by
  rw [jetElem, deriv_analyticMeroElement]
  refine analyticMeroElement_congr _ _ ?_
  funext z
  rw [iteratedDeriv_succ]

/-- The subalgebra generated by the composed jets and the inner jets of index at most `m`. -/
def compJetRing {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g) (m : ℕ) :
    Subalgebra ℂ (meroField (Set.univ : Set ℂ)) :=
  Algebra.adjoin ℂ ((Set.range fun i : Fin (m + 1) => compJetElem hf hg (i : ℕ))
    ∪ (Set.range fun j : Fin (m + 1) => jetElem hg (j : ℕ)))

theorem compJetElem_mem_compJetRing {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) {m i : ℕ} (hi : i ≤ m) :
    compJetElem hf hg i ∈ compJetRing hf hg m :=
  Algebra.subset_adjoin (Or.inl ⟨⟨i, by omega⟩, rfl⟩)

theorem jetElem_mem_compJetRing {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) {m j : ℕ} (hj : j ≤ m) :
    jetElem hg j ∈ compJetRing hf hg m :=
  Algebra.subset_adjoin (Or.inr ⟨⟨j, by omega⟩, rfl⟩)

theorem compJetRing_mono {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    {m m' : ℕ} (h : m ≤ m') : compJetRing hf hg m ≤ compJetRing hf hg m' := by
  refine Algebra.adjoin_mono ?_
  rintro y (⟨i, rfl⟩ | ⟨j, rfl⟩)
  · exact Or.inl ⟨⟨(i : ℕ), by omega⟩, rfl⟩
  · exact Or.inr ⟨⟨(j : ℕ), by omega⟩, rfl⟩

/-- **One differentiation raises the index by one.**  The subalgebra of index at most `m` is carried
into the one of index at most `m + 1` by the field derivation. -/
theorem deriv_mem_compJetRing_succ {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (m : ℕ) {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ compJetRing hf hg m) : x′ ∈ compJetRing hf hg (m + 1) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      rcases hy with ⟨i, rfl⟩ | ⟨j, rfl⟩
      · rw [deriv_compJetElem]
        exact Subalgebra.mul_mem _
          (compJetElem_mem_compJetRing hf hg (by omega : (i : ℕ) + 1 ≤ m + 1))
          (jetElem_mem_compJetRing hf hg (by omega : 1 ≤ m + 1))
      · rw [deriv_jetElem]
        exact jetElem_mem_compJetRing hf hg (by omega : (j : ℕ) + 1 ≤ m + 1)
  | algebraMap c =>
      have hconst : (algebraMap ℂ (meroField (Set.univ : Set ℂ))) c
          = analyticMeroElement (fun _ : ℂ => c) analyticOnNhd_const :=
        (analyticMeroElement_const (Set.univ : Set ℂ) c).trans rfl
      have hderivfun : deriv (fun _ : ℂ => c) = fun _ : ℂ => (0 : ℂ) := by
        funext z
        simp
      rw [hconst, deriv_analyticMeroElement,
        analyticMeroElement_congr _ analyticOnNhd_const hderivfun,
        analyticMeroElement_zero]
      exact Subalgebra.zero_mem _
  | add a b ha hb iha ihb =>
      have h : (a + b)′ = a′ + b′ := deriv_add' a b
      rw [h]
      exact Subalgebra.add_mem _ iha ihb
  | mul a b ha hb iha ihb =>
      have hleib : (a * b)′ = a * b′ + b * a′ := deriv_mul' a b
      rw [hleib]
      refine Subalgebra.add_mem _ ?_ ?_
      · exact Subalgebra.mul_mem _ (compJetRing_mono hf hg (by omega) ha) ihb
      · exact Subalgebra.mul_mem _ (compJetRing_mono hf hg (by omega) hb) iha

/-- The zeroth composed jet is the composition itself. -/
theorem compJetElem_zero {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (hcomp : Differentiable ℂ (fun w => f (g w))) :
    compJetElem hf hg 0 = jetElem hcomp 0 := by
  refine analyticMeroElement_congr _ _ ?_
  funext z
  simp [compJetFun, iteratedDeriv_zero]

/-- **The jets of a composition lie in the ring generated by the composed jets.**  Each
differentiation raises the index by one, so the `k`-th jet of `f ∘ g` lies in the ring of index at
most `k`. -/
theorem jetElem_comp_mem_compJetRing {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g) (hcomp : Differentiable ℂ (fun w => f (g w))) (k : ℕ) :
    jetElem hcomp k ∈ compJetRing hf hg k := by
  induction k with
  | zero =>
      rw [← compJetElem_zero hf hg hcomp]
      exact compJetElem_mem_compJetRing hf hg (le_refl 0)
  | succ m ih =>
      have hd : (jetElem hcomp m)′ = jetElem hcomp (m + 1) := deriv_jetElem hcomp m
      rw [← hd]
      exact deriv_mem_compJetRing_succ hf hg m ih

end

end GaloisForLFunctions.HTGeometry
