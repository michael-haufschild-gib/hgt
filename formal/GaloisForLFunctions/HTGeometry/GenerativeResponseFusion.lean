import Mathlib
import GaloisForLFunctions.HTGeometry.ZeroEstimate
import GaloisForLFunctions.HTGeometry.MatrixRankSubadditive
import GaloisForLFunctions.HilbertMetric.DeterminantCurvatureJet

namespace GaloisForLFunctions.HTGeometry

open Finset Matrix

section FiniteFusion

variable {n d : ℕ}

/-- Total unnormalized source mass. -/
def interventionTotal (w : Fin n → ℝ) : ℝ := ∑ x, w x

/-- Normalization-centered coefficient tangent. -/
noncomputable def centeredIntervention (w h : Fin n → ℝ) (x : Fin n) : ℝ :=
  (h x * interventionTotal w - interventionTotal h * w x) / (interventionTotal w) ^ 2

/-- The finite phase/moment response of a centered tangent. -/
def interventionMoment (η lam : Fin n → ℝ) (k : ℕ) : ℂ :=
  ∑ x, (η x : ℂ) * (lam x : ℂ) ^ k

/-- Pairing of a test covector with a feature atom. -/
def featureOverlap (a : Fin d → ℝ) (φ : Fin n → Fin d → ℝ) (x : Fin n) : ℝ :=
  a ⬝ᵥ φ x

/-- Quadratic pushforward of a signed tangent through a feature packet. -/
def gramQuadraticResponse (η : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (a : Fin d → ℝ) : ℝ :=
  ∑ x, η x * featureOverlap a φ x ^ 2

/-- Positive base energy of a normalized source. -/
noncomputable def normalizedGramEnergy (w : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (a : Fin d → ℝ) : ℝ :=
  ∑ x, (w x / interventionTotal w) * featureOverlap a φ x ^ 2

/-- Off-support birth energy generated by an absolute intervention. -/
noncomputable def supportBirthEnergy (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (a : Fin d → ℝ) : ℝ :=
  ∑ x, if w x = 0 then (h x / interventionTotal w) * featureOverlap a φ x ^ 2 else 0

/-- The generative normal cone: a signed tangent may not remove mass from a currently absent
source atom. -/
def IsGenerativeTangent (w η : Fin n → ℝ) : Prop :=
  ∀ x, w x = 0 → 0 ≤ η x

/-- A legal normalized tangent conserves total mass and lies in the generative normal cone. -/
def IsLegalCenteredTangent (w η : Fin n → ℝ) : Prop :=
  (∑ x, η x = 0) ∧ IsGenerativeTangent w η

/-- Coordinate features form the universal diagonal positive reporter. -/
def sourceCoordinateFeature (x j : Fin n) : ℝ := if j = x then 1 else 0

/-- Centering conserves total probability mass. -/
theorem centeredIntervention_sum_eq_zero (w h : Fin n → ℝ)
    (hZ : interventionTotal w ≠ 0) :
    ∑ x, centeredIntervention w h x = 0 := by
  unfold centeredIntervention
  rw [← Finset.sum_div, Finset.sum_sub_distrib, ← Finset.sum_mul, ← Finset.mul_sum]
  rw [show ∑ x, h x = interventionTotal h by rfl,
    show ∑ x, w x = interventionTotal w by rfl]
  field_simp
  ring

/-- Distinct phase labels make the first `n` moments a faithful reporter. -/
theorem interventionMoment_injective {η ξ lam : Fin n → ℝ}
    (hlam : Function.Injective lam)
    (hmom : ∀ k : Fin n, interventionMoment η lam k = interventionMoment ξ lam k) :
    η = ξ := by
  have hcast : Function.Injective (fun x : Fin n => (lam x : ℂ)) := by
    intro i j hij
    exact hlam (Complex.ofReal_injective hij)
  have hzero : (fun x : Fin n => ((η x - ξ x : ℝ) : ℂ)) = 0 := by
    apply vandermonde_moments_eq_zero_of_injective hcast
    intro k
    have hk := sub_eq_zero.mpr (hmom k)
    simpa [interventionMoment, Finset.sum_sub_distrib, sub_mul] using hk
  funext x
  have hx := congrFun hzero x
  exact sub_eq_zero.mp (Complex.ofReal_eq_zero.mp (by simpa using hx))

/-- At a positive Gram null face, every occupied feature is pointwise annihilated. -/
theorem occupied_featureOverlap_eq_zero {w : Fin n → ℝ} {φ : Fin n → Fin d → ℝ}
    {a : Fin d → ℝ} (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hnull : normalizedGramEnergy w φ a = 0) :
    ∀ x, w x ≠ 0 → featureOverlap a φ x = 0 := by
  intro x hx
  have hterm := (Finset.sum_eq_zero_iff_of_nonneg
    (fun y (_ : y ∈ Finset.univ) => mul_nonneg (div_nonneg (hw y) hZ.le)
      (sq_nonneg (featureOverlap a φ y)))).mp hnull x (Finset.mem_univ x)
  have hdivpos : 0 < w x / interventionTotal w := div_pos (lt_of_le_of_ne (hw x) (Ne.symm hx)) hZ
  exact (sq_eq_zero_iff.mp ((mul_eq_zero.mp hterm).resolve_left (ne_of_gt hdivpos)))

/-- Any signed tangent, not only a normalized coefficient derivative, localizes to absent atoms on
a positive Gram null face. -/
theorem gramQuadraticResponse_eq_absentSupport {w η : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ} {a : Fin d → ℝ}
    (hocc : ∀ x, w x ≠ 0 → featureOverlap a φ x = 0) :
    gramQuadraticResponse η φ a =
      ∑ x, if w x = 0 then η x * featureOverlap a φ x ^ 2 else 0 := by
  unfold gramQuadraticResponse
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : w x = 0
  · simp [hx]
  · rw [if_neg hx, hocc x hx]
    simp

/-- Membership in the generative normal cone forces every positive Gram null response to point
inward. -/
theorem gramQuadraticResponse_nonneg_of_generativeTangent {w η : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ} {a : Fin d → ℝ}
    (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hgen : IsGenerativeTangent w η)
    (hnull : normalizedGramEnergy w φ a = 0) :
    0 ≤ gramQuadraticResponse η φ a := by
  rw [gramQuadraticResponse_eq_absentSupport
    (occupied_featureOverlap_eq_zero hZ hw hnull)]
  apply Finset.sum_nonneg
  intro x _
  by_cases hx : w x = 0
  · rw [if_pos hx]
    exact mul_nonneg (hgen x hx) (sq_nonneg _)
  · simp [hx]

theorem featureOverlap_sourceCoordinateFeature (x y : Fin n) :
    featureOverlap (sourceCoordinateFeature x) sourceCoordinateFeature y =
      if y = x then 1 else 0 := by
  classical
  unfold featureOverlap sourceCoordinateFeature dotProduct
  by_cases hxy : y = x
  · subst y
    simp
  · simp [hxy]

theorem normalizedGramEnergy_sourceCoordinateFeature {w : Fin n → ℝ} (x : Fin n) :
    normalizedGramEnergy w sourceCoordinateFeature (sourceCoordinateFeature x) =
      w x / interventionTotal w := by
  classical
  unfold normalizedGramEnergy
  simp [featureOverlap_sourceCoordinateFeature]

theorem gramQuadraticResponse_sourceCoordinateFeature {η : Fin n → ℝ} (x : Fin n) :
    gramQuadraticResponse η sourceCoordinateFeature (sourceCoordinateFeature x) = η x := by
  classical
  unfold gramQuadraticResponse
  simp [featureOverlap_sourceCoordinateFeature]

/-- Universal selection equivalence: off-support legality is exactly nonnegative first response
for every finite positive Gram reporter and every current null covector. -/
theorem generativeTangent_iff_universalNullResponse {w η : Fin n → ℝ}
    (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x) :
    IsGenerativeTangent w η ↔
      ∀ (d : ℕ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
        normalizedGramEnergy w φ a = 0 → 0 ≤ gramQuadraticResponse η φ a := by
  constructor
  · intro hgen d φ a hnull
    exact gramQuadraticResponse_nonneg_of_generativeTangent hZ hw hgen hnull
  · intro hall x hx
    have hnull :
        normalizedGramEnergy w sourceCoordinateFeature (sourceCoordinateFeature x) = 0 := by
      rw [normalizedGramEnergy_sourceCoordinateFeature, hx, zero_div]
    have hresponse := hall n sourceCoordinateFeature (sourceCoordinateFeature x) hnull
    rwa [gramQuadraticResponse_sourceCoordinateFeature] at hresponse

/-- Zeroth phase response is exactly the conservation law. -/
theorem interventionMoment_zero_eq_zero_iff (η lam : Fin n → ℝ) :
    interventionMoment η lam 0 = 0 ↔ ∑ x, η x = 0 := by
  unfold interventionMoment
  simp [← Complex.ofReal_sum]

/-- Full finite selection law: phase conservation plus universal positive-null response is exactly
legality of the centered source tangent. -/
theorem legalCenteredTangent_iff_phaseConservation_and_universalNullResponse
    {w η lam : Fin n → ℝ} (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x) :
    IsLegalCenteredTangent w η ↔
      interventionMoment η lam 0 = 0 ∧
        ∀ (d : ℕ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
          normalizedGramEnergy w φ a = 0 → 0 ≤ gramQuadraticResponse η φ a := by
  rw [IsLegalCenteredTangent, interventionMoment_zero_eq_zero_iff,
    generativeTangent_iff_universalNullResponse hZ hw]

/-- Every negative first crossing exposes a specific absent source atom whose tangent coefficient
is negative. -/
theorem negativeNullResponse_forces_negative_birth {w η : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ} {a : Fin d → ℝ}
    (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hnull : normalizedGramEnergy w φ a = 0)
    (hnegative : gramQuadraticResponse η φ a < 0) :
    ∃ x, w x = 0 ∧ η x < 0 := by
  by_contra hnone
  have hgen : IsGenerativeTangent w η := by
    intro x hx
    by_contra hneg
    exact hnone ⟨x, hx, lt_of_not_ge hneg⟩
  exact (not_lt_of_ge
    (gramQuadraticResponse_nonneg_of_generativeTangent hZ hw hgen hnull)) hnegative

/-- The null response is exactly the energy of mass born off the current support. -/
theorem gramQuadraticResponse_eq_supportBirthEnergy {w h : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ} {a : Fin d → ℝ}
    (hZ : interventionTotal w ≠ 0)
    (hocc : ∀ x, w x ≠ 0 → featureOverlap a φ x = 0) :
    gramQuadraticResponse (centeredIntervention w h) φ a = supportBirthEnergy w h φ a := by
  unfold gramQuadraticResponse supportBirthEnergy
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : w x = 0
  · simp only [hx, if_pos]
    simp only [centeredIntervention, hx, mul_zero, sub_zero]
    field_simp
  · rw [if_neg hx, hocc x hx]
    simp

/-- Positive one-sided births can only open a positive Gram null face. -/
theorem supportBirthEnergy_nonneg {w h : Fin n → ℝ} {φ : Fin n → Fin d → ℝ}
    {a : Fin d → ℝ} (hZ : 0 < interventionTotal w)
    (hbirth : ∀ x, w x = 0 → 0 ≤ h x) :
    0 ≤ supportBirthEnergy w h φ a := by
  unfold supportBirthEnergy
  apply Finset.sum_nonneg
  intro x _
  by_cases hx : w x = 0
  · rw [if_pos hx]
    exact mul_nonneg (div_nonneg (hbirth x hx) hZ.le) (sq_nonneg _)
  · simp [hx]

/-- Fixed-support interventions cannot open any positive Gram null face. -/
theorem hereditary_supportBirthEnergy_eq_zero (w r : Fin n → ℝ)
    (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ) :
    supportBirthEnergy w (fun x => w x * r x) φ a = 0 := by
  unfold supportBirthEnergy
  apply Finset.sum_eq_zero
  intro x _
  by_cases hx : w x = 0 <;> simp [hx]

/-- A positive null face responds only to newborn source atoms. -/
theorem positiveNullFace_generation {w h : Fin n → ℝ} {φ : Fin n → Fin d → ℝ}
    {a : Fin d → ℝ} (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hnull : normalizedGramEnergy w φ a = 0) :
    gramQuadraticResponse (centeredIntervention w h) φ a = supportBirthEnergy w h φ a :=
  gramQuadraticResponse_eq_supportBirthEnergy hZ.ne'
    (occupied_featureOverlap_eq_zero hZ hw hnull)

/-- Hankel specialization: a null polynomial is opened exactly by off-support evaluation energy. -/
theorem hankelNull_generation {R : ℕ} {w h lam : Fin n → ℝ} {a : Fin (R + 1) → ℝ}
    (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hnull : normalizedGramEnergy w (fun x j => lam x ^ (j : ℕ)) a = 0) :
    gramQuadraticResponse (centeredIntervention w h)
        (fun x j => lam x ^ (j : ℕ)) a
      = ∑ x, if w x = 0 then
          (h x / interventionTotal w) * (∑ j, a j * lam x ^ (j : ℕ)) ^ 2 else 0 := by
  rw [positiveNullFace_generation hZ hw hnull]
  rfl

/-- Matrix-valued quadratic pushforward of a centered source tangent. -/
noncomputable def gramResponseMatrix (η : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) :
    Matrix (Fin d) (Fin d) ℝ :=
  ∑ x, η x • Matrix.vecMulVec (φ x) (φ x)

/-- Matrix of the off-support birth response. -/
noncomputable def supportBirthMatrix (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) :
    Matrix (Fin d) (Fin d) ℝ :=
  ∑ x, (if w x = 0 then h x / interventionTotal w else 0) •
    Matrix.vecMulVec (φ x) (φ x)

/-- Operator-level localization: after restricting features to a current null space, only newborn
atoms survive the centered response. -/
theorem gramResponseMatrix_eq_supportBirthMatrix {w h : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ} (hZ : interventionTotal w ≠ 0)
    (hocc : ∀ x, w x ≠ 0 → φ x = 0) :
    gramResponseMatrix (centeredIntervention w h) φ = supportBirthMatrix w h φ := by
  classical
  unfold gramResponseMatrix supportBirthMatrix
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : w x = 0
  · simp only [hx, if_pos, centeredIntervention, mul_zero, sub_zero]
    congr 1
    field_simp
  · rw [if_neg hx, hocc x hx]
    simp

/-- Analysis matrix whose rows are the weighted newborn feature vectors. -/
noncomputable def birthAnalysisMatrix (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) :
    Matrix (Fin n) (Fin d) ℝ :=
  Matrix.of fun x j =>
    Real.sqrt (if w x = 0 then h x / interventionTotal w else 0) * φ x j

/-- A positive birth matrix is exactly the Gram matrix of its weighted newborn features. -/
theorem supportBirthMatrix_eq_transpose_mul_birthAnalysisMatrix
    {w h : Fin n → ℝ} {φ : Fin n → Fin d → ℝ}
    (hc : ∀ x, 0 ≤ if w x = 0 then h x / interventionTotal w else 0) :
    supportBirthMatrix w h φ =
      (birthAnalysisMatrix w h φ)ᵀ * birthAnalysisMatrix w h φ := by
  classical
  ext i j
  simp only [supportBirthMatrix, Matrix.mul_apply, Matrix.transpose_apply,
    birthAnalysisMatrix, Matrix.of_apply, Matrix.sum_apply]
  apply Finset.sum_congr rfl
  intro x _
  rw [Matrix.smul_apply, Matrix.vecMulVec_apply]
  simp only [smul_eq_mul]
  let c : ℝ := if w x = 0 then h x / interventionTotal w else 0
  have hc_eq : c = Real.sqrt c * Real.sqrt c := (Real.mul_self_sqrt (hc x)).symm
  change c * (φ x i * φ x j) =
    (Real.sqrt c * φ x i) * (Real.sqrt c * φ x j)
  calc
    c * (φ x i * φ x j) = (Real.sqrt c * Real.sqrt c) * (φ x i * φ x j) := by
      exact congrArg (fun z : ℝ => z * (φ x i * φ x j)) hc_eq
    _ = (Real.sqrt c * φ x i) * (Real.sqrt c * φ x j) := by ring

/-- Rank generated at first order equals the dimension of the span of weighted newborn features. -/
theorem rank_supportBirthMatrix_eq_finrank_span_birthFeatures
    {w h : Fin n → ℝ} {φ : Fin n → Fin d → ℝ}
    (hc : ∀ x, 0 ≤ if w x = 0 then h x / interventionTotal w else 0) :
    (supportBirthMatrix w h φ).rank =
      Module.finrank ℝ
        (Submodule.span ℝ (Set.range (birthAnalysisMatrix w h φ).row)) := by
  rw [supportBirthMatrix_eq_transpose_mul_birthAnalysisMatrix hc,
    Matrix.rank_transpose_mul_self, Matrix.rank_eq_finrank_span_row]

/-- Normalized positive Gram matrix of a finite feature packet. -/
noncomputable def normalizedGramMatrix (w : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) :
    Matrix (Fin d) (Fin d) ℝ :=
  ∑ x, (w x / interventionTotal w) • Matrix.vecMulVec (φ x) (φ x)

/-- Interior leverage of one source atom. -/
noncomputable def featureLeverage (w : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (x : Fin n) : ℝ :=
  φ x ⬝ᵥ (normalizedGramMatrix w φ)⁻¹.mulVec (φ x)

private theorem trace_mul_vecMulVec_eq_dotProduct {A : Matrix (Fin d) (Fin d) ℝ}
    (v : Fin d → ℝ) :
    (A * Matrix.vecMulVec v v).trace = v ⬝ᵥ A.mulVec v := by
  simp only [Matrix.trace, Matrix.diag_apply, Matrix.mul_apply, Matrix.vecMulVec_apply,
    dotProduct, Matrix.mulVec]
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- Conservation of interior leverage: normalized atomic leverages sum to ambient dimension. -/
theorem weighted_featureLeverage_sum_eq_finrank {w : Fin n → ℝ}
    {φ : Fin n → Fin d → ℝ}
    (hunit : IsUnit (normalizedGramMatrix w φ).det) :
    ∑ x, (w x / interventionTotal w) * featureLeverage w φ x = d := by
  let G := normalizedGramMatrix w φ
  calc
    ∑ x, (w x / interventionTotal w) * featureLeverage w φ x =
        ∑ x, ((G⁻¹) * ((w x / interventionTotal w) •
          Matrix.vecMulVec (φ x) (φ x))).trace := by
      apply Finset.sum_congr rfl
      intro x _
      change (w x / interventionTotal w) *
          (φ x ⬝ᵥ G⁻¹.mulVec (φ x)) =
        (G⁻¹ * ((w x / interventionTotal w) • Matrix.vecMulVec (φ x) (φ x))).trace
      rw [← trace_mul_vecMulVec_eq_dotProduct, Matrix.mul_smul, Matrix.trace_smul]
      rfl
    _ = (G⁻¹ * G).trace := by
      rw [← Matrix.trace_sum Finset.univ, ← Matrix.mul_sum Finset.univ]
      rfl
    _ = (1 : Matrix (Fin d) (Fin d) ℝ).trace := by rw [Matrix.nonsing_inv_mul G hunit]
    _ = d := by simp

/-- Trace contraction of any signed Gram response is its leverage-weighted source response. -/
theorem trace_inv_mul_gramResponseMatrix_eq_leverage_sum
    {w η : Fin n → ℝ} {φ : Fin n → Fin d → ℝ} :
    ((normalizedGramMatrix w φ)⁻¹ * gramResponseMatrix η φ).trace =
      ∑ x, η x * featureLeverage w φ x := by
  let G := normalizedGramMatrix w φ
  calc
    (G⁻¹ * gramResponseMatrix η φ).trace =
        ∑ x, (G⁻¹ * (η x • Matrix.vecMulVec (φ x) (φ x))).trace := by
      rw [gramResponseMatrix, ← Matrix.trace_sum Finset.univ, ← Matrix.mul_sum Finset.univ]
    _ = ∑ x, η x * featureLeverage w φ x := by
      apply Finset.sum_congr rfl
      intro x _
      change (G⁻¹ * (η x • Matrix.vecMulVec (φ x) (φ x))).trace =
        η x * (φ x ⬝ᵥ G⁻¹.mulVec (φ x))
      rw [Matrix.mul_smul, Matrix.trace_smul, trace_mul_vecMulVec_eq_dotProduct]
      rfl

/-- Literal normalized Gram family under an absolute coefficient intervention. -/
noncomputable def perturbedNormalizedGramMatrix (w h : Fin n → ℝ)
    (φ : Fin n → Fin d → ℝ) (t : ℝ) : Matrix (Fin d) (Fin d) ℝ :=
  Matrix.of fun i j =>
    ∑ x, ((w x + t * h x) /
      (interventionTotal w + t * interventionTotal h)) * (φ x i * φ x j)

@[simp] theorem perturbedNormalizedGramMatrix_zero (w h : Fin n → ℝ)
    (φ : Fin n → Fin d → ℝ) :
    perturbedNormalizedGramMatrix w h φ 0 = normalizedGramMatrix w φ := by
  classical
  ext i j
  simp only [perturbedNormalizedGramMatrix, Matrix.of_apply, zero_mul, add_zero,
    normalizedGramMatrix, Matrix.sum_apply]
  apply Finset.sum_congr rfl
  intro x _
  rw [Matrix.smul_apply, Matrix.vecMulVec_apply]
  simp [smul_eq_mul]

/-- Entrywise first derivative of the normalized Gram family is the centered Gram response. -/
theorem hasDerivAt_perturbedNormalizedGramMatrix_entry
    (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (i j : Fin d)
    (hZ : interventionTotal w ≠ 0) :
    HasDerivAt (fun t => perturbedNormalizedGramMatrix w h φ t i j)
      (gramResponseMatrix (centeredIntervention w h) φ i j) 0 := by
  classical
  rw [show (fun t => perturbedNormalizedGramMatrix w h φ t i j) =
      fun t => ∑ x, ((w x + t * h x) /
        (interventionTotal w + t * interventionTotal h)) * (φ x i * φ x j) by rfl]
  have hsum : HasDerivAt
      (fun t : ℝ => ∑ x, ((w x + t * h x) /
        (interventionTotal w + t * interventionTotal h)) * (φ x i * φ x j))
      (∑ x, centeredIntervention w h x * (φ x i * φ x j)) 0 := by
    apply HasDerivAt.fun_sum
    intro x _
    have hnum : HasDerivAt (fun t : ℝ => w x + t * h x) (h x) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).mul_const (h x)).const_add (w x)
    have hden : HasDerivAt
        (fun t : ℝ => interventionTotal w + t * interventionTotal h)
        (interventionTotal h) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).mul_const
        (interventionTotal h)).const_add (interventionTotal w)
    have hquot := hnum.div hden (by simpa using hZ)
    have hscaled := hquot.mul_const (φ x i * φ x j)
    refine hscaled.congr_deriv ?_
    simp only [zero_mul, add_zero]
    unfold centeredIntervention
    ring
  convert hsum using 1
  simp only [gramResponseMatrix, Matrix.sum_apply]
  apply Finset.sum_congr rfl
  intro x _
  rw [Matrix.smul_apply, Matrix.vecMulVec_apply]
  simp [smul_eq_mul]

/-- Literal log-determinant response of the normalized Gram family. -/
theorem hasDerivAt_logdet_perturbedNormalizedGramMatrix
    (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (hZ : interventionTotal w ≠ 0)
    (hdet : 0 < (normalizedGramMatrix w φ).det) :
    HasDerivAt
      (fun t => Real.log (perturbedNormalizedGramMatrix w h φ t).det)
      (∑ x, centeredIntervention w h x * featureLeverage w φ x) 0 := by
  have hmatrix := GaloisForLFunctions.HilbertMetric.hasDerivAt_matrixDet
    (perturbedNormalizedGramMatrix w h φ)
    (gramResponseMatrix (centeredIntervention w h) φ) 0
    (hasDerivAt_perturbedNormalizedGramMatrix_entry w h φ · · hZ)
  rw [perturbedNormalizedGramMatrix_zero] at hmatrix
  rw [GaloisForLFunctions.HilbertMetric.detFirstJet_eq_det_mul_trace_inv_mul _ _ hdet.ne']
    at hmatrix
  have hlog := hmatrix.log (by simpa using hdet.ne')
  rw [trace_inv_mul_gramResponseMatrix_eq_leverage_sum] at hlog
  rw [perturbedNormalizedGramMatrix_zero] at hlog
  convert hlog using 1
  field_simp

private theorem adjugate_updateRow_same_col_real
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (i j : ι) (v : ι → ℝ) :
    (A.updateRow i v).adjugate j i = A.adjugate j i := by
  rw [Matrix.adjugate_apply, Matrix.adjugate_apply]
  congr 1
  ext r c
  by_cases hr : r = i
  · subst r
    simp [Matrix.updateRow]
  · simp [Matrix.updateRow, hr]

private theorem adjugate_updateCol_same_row_real
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (i j : ι) (v : ι → ℝ) :
    (A.updateCol i v).adjugate i j = A.adjugate i j := by
  calc
    (A.updateCol i v).adjugate i j =
        ((A.updateCol i v).adjugate.transpose) j i := rfl
    _ = ((A.updateCol i v).transpose.adjugate) j i := by
      rw [Matrix.adjugate_transpose]
    _ = (A.transpose.updateRow i v).adjugate j i := by
      rw [← Matrix.updateRow_transpose]
    _ = A.transpose.adjugate j i :=
      adjugate_updateRow_same_col_real A.transpose i j v
    _ = A.adjugate i j := by
      rw [← Matrix.adjugate_transpose]
      rfl

private theorem det_updateCol_eq_sum_mul_adjugate_real
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℝ) (i : ι) (v : ι → ℝ) :
    (A.updateCol i v).det = ∑ j, v j * A.adjugate i j := by
  rw [Matrix.det_eq_sum_mul_adjugate_col (A.updateCol i v) i]
  congr 1
  ext j
  rw [adjugate_updateCol_same_row_real A i j v]
  simp [Matrix.updateCol]

/-- Jacobi's first determinant response in adjugate form, including singular matrices. -/
theorem detFirstJet_eq_adjugate_trace_real
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A B : Matrix ι ι ℝ) :
    GaloisForLFunctions.HilbertMetric.detFirstJet A B = (A.adjugate * B).trace := by
  have hcolumns :
      GaloisForLFunctions.HilbertMetric.detFirstJet A B =
        ∑ i, (A.updateCol i (fun j => B j i)).det := by
    unfold GaloisForLFunctions.HilbertMetric.detFirstJet
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Matrix.det_apply']
    apply Finset.sum_congr rfl
    intro σ _
    congr 1
    rw [← Finset.mul_prod_erase Finset.univ
      (fun j => (A.updateCol i (fun r => B r i)) (σ j) j)
      (Finset.mem_univ i)]
    rw [Matrix.updateCol_self, mul_comm]
    congr 1
    apply Finset.prod_congr rfl
    intro j hj
    rw [Matrix.updateCol_ne (Finset.ne_of_mem_erase hj)]
  rw [hcolumns, Matrix.trace]
  apply Finset.sum_congr rfl
  intro i _
  rw [det_updateCol_eq_sum_mul_adjugate_real]
  simp only [Matrix.diag_apply, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- At a diagonal simple null face only the null diagonal response contributes. -/
theorem detFirstJet_diagonal_single_zero_real
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (diag : ι → ℝ) (B : Matrix ι ι ℝ) (x : ι) (hx : diag x = 0) :
    GaloisForLFunctions.HilbertMetric.detFirstJet (Matrix.diagonal diag) B =
      (∏ j ∈ Finset.univ.erase x, diag j) * B x x := by
  rw [detFirstJet_eq_adjugate_trace_real,
    Matrix.adjugate_diagonal, Matrix.trace]
  simp only [Matrix.diag_apply, Matrix.mul_apply]
  rw [Finset.sum_eq_single x]
  · rw [Finset.sum_eq_single x]
    · rw [Matrix.diagonal_apply_eq]
    · intro j _ hjx
      rw [Matrix.diagonal_apply_ne _ hjx.symm]
      simp
    · intro hx'
      exact absurd (Finset.mem_univ x) hx'
  · intro i _ hix
    rw [Finset.sum_eq_single i]
    · rw [Matrix.diagonal_apply_eq]
      apply mul_eq_zero_of_left
      apply Finset.prod_eq_zero
        (Finset.mem_erase.mpr ⟨fun h => hix h.symm, Finset.mem_univ x⟩)
      exact hx
    · intro j _ hji
      rw [Matrix.diagonal_apply_ne _ hji.symm]
      simp
    · intro hi'
      exact absurd (Finset.mem_univ i) hi'
  · intro hx'
    exact absurd (Finset.mem_univ x) hx'

/-- Standard coordinate null covector. -/
def coordinateCovector (x : Fin d) : Fin d → ℝ := fun j => if j = x then 1 else 0

theorem coordinateCovector_dot_mulVec (B : Matrix (Fin d) (Fin d) ℝ) (x : Fin d) :
    coordinateCovector x ⬝ᵥ B.mulVec (coordinateCovector x) = B x x := by
  classical
  unfold coordinateCovector dotProduct Matrix.mulVec
  rw [Finset.sum_eq_single x]
  · simp only [if_pos, one_mul]
    unfold dotProduct
    rw [Finset.sum_eq_single x]
    · simp
    · intro j _ hjx
      simp [hjx]
    · intro hx'
      exact absurd (Finset.mem_univ x) hx'
  · intro i _ hix
    simp [hix]
  · intro hx'
    exact absurd (Finset.mem_univ x) hx'

/-- The feature quadratic of a Gram response is the source quadratic response. -/
theorem dotProduct_gramResponseMatrix_mulVec_eq
    (η : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ) :
    a ⬝ᵥ (gramResponseMatrix η φ).mulVec a = gramQuadraticResponse η φ a := by
  classical
  unfold gramResponseMatrix gramQuadraticResponse featureOverlap
  rw [Matrix.sum_mulVec Finset.univ, dotProduct_sum a Finset.univ]
  apply Finset.sum_congr rfl
  intro x _
  rw [Matrix.smul_mulVec, dotProduct_smul, vecMulVec_mulVec_self,
    dotProduct_smul]
  simp only [smul_eq_mul]
  rw [dotProduct_comm (φ x) a]
  ring

/-- Simple-null determinant orientation from an adjugate rank-one certificate. -/
theorem hasDerivAt_det_perturbedNormalizedGramMatrix_of_adjugate_certificate
    (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ) (κ : ℝ)
    (hZ : 0 < interventionTotal w) (hw : ∀ x, 0 ≤ w x)
    (hnull : normalizedGramEnergy w φ a = 0)
    (hadj : (normalizedGramMatrix w φ).adjugate =
      κ • Matrix.vecMulVec a a) :
    HasDerivAt (fun t => (perturbedNormalizedGramMatrix w h φ t).det)
      (κ * supportBirthEnergy w h φ a) 0 := by
  have hmatrix := GaloisForLFunctions.HilbertMetric.hasDerivAt_matrixDet
    (perturbedNormalizedGramMatrix w h φ)
    (gramResponseMatrix (centeredIntervention w h) φ) 0
    (hasDerivAt_perturbedNormalizedGramMatrix_entry w h φ · · hZ.ne')
  rw [perturbedNormalizedGramMatrix_zero,
    detFirstJet_eq_adjugate_trace_real, hadj] at hmatrix
  refine hmatrix.congr_deriv ?_
  rw [Matrix.smul_mul, Matrix.trace_smul, Matrix.trace_mul_comm,
    trace_mul_vecMulVec_eq_dotProduct,
    dotProduct_gramResponseMatrix_mulVec_eq,
    positiveNullFace_generation hZ hw hnull]
  rfl

/-- Diagonal-gauge form of the simple null-face orientation theorem. -/
theorem hasDerivAt_det_perturbedNormalizedGramMatrix_diagonal_simple_null
    (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
    (diag : Fin d → ℝ) (x : Fin d)
    (hZ : 0 < interventionTotal w) (hw : ∀ y, 0 ≤ w y)
    (hdiag : normalizedGramMatrix w φ = Matrix.diagonal diag)
    (hx : diag x = 0)
    (hnull : normalizedGramEnergy w φ (coordinateCovector x) = 0) :
    HasDerivAt (fun t => (perturbedNormalizedGramMatrix w h φ t).det)
      ((∏ j ∈ Finset.univ.erase x, diag j) *
        supportBirthEnergy w h φ (coordinateCovector x)) 0 := by
  have hmatrix := GaloisForLFunctions.HilbertMetric.hasDerivAt_matrixDet
    (perturbedNormalizedGramMatrix w h φ)
    (gramResponseMatrix (centeredIntervention w h) φ) 0
    (hasDerivAt_perturbedNormalizedGramMatrix_entry w h φ · · hZ.ne')
  rw [perturbedNormalizedGramMatrix_zero, hdiag,
    detFirstJet_diagonal_single_zero_real diag _ x hx] at hmatrix
  refine hmatrix.congr_deriv ?_
  have hentry :
      gramResponseMatrix (centeredIntervention w h) φ x x =
        coordinateCovector x ⬝ᵥ
          (gramResponseMatrix (centeredIntervention w h) φ).mulVec
            (coordinateCovector x) :=
    (coordinateCovector_dot_mulVec
      (gramResponseMatrix (centeredIntervention w h) φ) x).symm
  rw [hentry, dotProduct_gramResponseMatrix_mulVec_eq,
    positiveNullFace_generation hZ hw hnull]

/-- Closed selection capstone: a legal centered tangent is exactly a conserved phase tangent whose
response is inward on every positive Gram null face; any negative crossing exposes a negative
newborn source coordinate. -/
theorem generativeSelection_capstone :
    (∀ (n : ℕ) (w η lam : Fin n → ℝ),
      0 < interventionTotal w → (∀ x, 0 ≤ w x) →
      (IsLegalCenteredTangent w η ↔
        interventionMoment η lam 0 = 0 ∧
          ∀ (d : ℕ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
            normalizedGramEnergy w φ a = 0 → 0 ≤ gramQuadraticResponse η φ a)) ∧
    (∀ (n d : ℕ) (w η : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
      0 < interventionTotal w → (∀ x, 0 ≤ w x) →
      normalizedGramEnergy w φ a = 0 → gramQuadraticResponse η φ a < 0 →
      ∃ x, w x = 0 ∧ η x < 0) := by
  constructor
  · exact fun _ _ _ _ => legalCenteredTangent_iff_phaseConservation_and_universalNullResponse
  · intro _ _ w η φ a hZ hw hnull hnegative
    exact negativeNullResponse_forces_negative_birth hZ hw hnull hnegative

/-- Closed capstone: one mechanism simultaneously supplies conservation, phase reconstruction,
positive null localization, hereditary no-crossing, and the Hankel crossing formula. -/
theorem centeredIntervention_fusion_capstone :
    (∀ (n : ℕ) (w h : Fin n → ℝ), interventionTotal w ≠ 0 →
      ∑ x, centeredIntervention w h x = 0) ∧
    (∀ (n : ℕ) (η ξ lam : Fin n → ℝ), Function.Injective lam →
      (∀ k : Fin n, interventionMoment η lam k = interventionMoment ξ lam k) → η = ξ) ∧
    (∀ (n d : ℕ) (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
      0 < interventionTotal w → (∀ x, 0 ≤ w x) → normalizedGramEnergy w φ a = 0 →
      gramQuadraticResponse (centeredIntervention w h) φ a = supportBirthEnergy w h φ a) ∧
    (∀ (n d : ℕ) (w r : Fin n → ℝ) (φ : Fin n → Fin d → ℝ) (a : Fin d → ℝ),
      supportBirthEnergy w (fun x => w x * r x) φ a = 0) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact fun _ _ _ => centeredIntervention_sum_eq_zero _ _
  · exact fun _ _ _ _ => interventionMoment_injective
  · exact fun _ _ _ _ _ _ => positiveNullFace_generation
  · exact fun _ _ w r φ a => hereditary_supportBirthEnergy_eq_zero w r φ a

/-- Closed full capstone: three unlike organs share one reconstructed centered tangent, boundary
rank is generated by newborn feature span, interior leverage is conserved, and the same tangent
predicts Hankel and determinant response in a fourth organ. -/
theorem generativeResponse_full_capstone :
    (∀ (n R : ℕ) (w h lam : Fin n → ℝ) (a : Fin (R + 1) → ℝ),
      0 < interventionTotal w → (∀ x, 0 ≤ w x) →
      normalizedGramEnergy w (fun x j => lam x ^ (j : ℕ)) a = 0 →
      gramQuadraticResponse (centeredIntervention w h)
          (fun x j => lam x ^ (j : ℕ)) a =
        ∑ x, if w x = 0 then
          (h x / interventionTotal w) * (∑ j, a j * lam x ^ (j : ℕ)) ^ 2 else 0) ∧
    (∀ (n d : ℕ) (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ),
      interventionTotal w ≠ 0 → (∀ x, w x ≠ 0 → φ x = 0) →
      gramResponseMatrix (centeredIntervention w h) φ = supportBirthMatrix w h φ) ∧
    (∀ (n d : ℕ) (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ),
      (∀ x, 0 ≤ if w x = 0 then h x / interventionTotal w else 0) →
      (supportBirthMatrix w h φ).rank =
        Module.finrank ℝ
          (Submodule.span ℝ (Set.range (birthAnalysisMatrix w h φ).row))) ∧
    (∀ (n d : ℕ) (w : Fin n → ℝ) (φ : Fin n → Fin d → ℝ),
      IsUnit (normalizedGramMatrix w φ).det →
      ∑ x, (w x / interventionTotal w) * featureLeverage w φ x = d) ∧
    (∀ (n d : ℕ) (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ),
      interventionTotal w ≠ 0 → 0 < (normalizedGramMatrix w φ).det →
      HasDerivAt
        (fun t => Real.log (perturbedNormalizedGramMatrix w h φ t).det)
        (∑ x, centeredIntervention w h x * featureLeverage w φ x) 0) ∧
    (∀ (n d : ℕ) (w h : Fin n → ℝ) (φ : Fin n → Fin d → ℝ)
        (diag : Fin d → ℝ) (x : Fin d),
      0 < interventionTotal w → (∀ y, 0 ≤ w y) →
      normalizedGramMatrix w φ = Matrix.diagonal diag → diag x = 0 →
      normalizedGramEnergy w φ (coordinateCovector x) = 0 →
      HasDerivAt (fun t => (perturbedNormalizedGramMatrix w h φ t).det)
        ((∏ j ∈ Finset.univ.erase x, diag j) *
          supportBirthEnergy w h φ (coordinateCovector x)) 0) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun _ _ _ _ _ _ => hankelNull_generation
  · exact fun _ _ _ _ _ => gramResponseMatrix_eq_supportBirthMatrix
  · exact fun _ _ _ _ _ => rank_supportBirthMatrix_eq_finrank_span_birthFeatures
  · exact fun _ _ _ _ => weighted_featureLeverage_sum_eq_finrank
  · intro _ _ w h φ
    exact hasDerivAt_logdet_perturbedNormalizedGramMatrix w h φ
  · intro _ _ w h φ diag x
    exact hasDerivAt_det_perturbedNormalizedGramMatrix_diagonal_simple_null
      w h φ diag x

