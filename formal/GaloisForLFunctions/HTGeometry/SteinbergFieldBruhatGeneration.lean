import GaloisForLFunctions.HTGeometry.SteinbergElementaryGroup

/-!
# First Bruhat-generation reduction for a field Steinberg group

For a linearly ordered index type, write `T` for the subgroup generated by
positive-root generators and `W` for the subgroup generated by Weyl words.  A
negative-root generator has the exact rank-one factorization

```text
xᵢⱼ(b) = xⱼᵢ(−b⁻¹)⁻¹ · wⱼᵢ(−b⁻¹) · xⱼᵢ(−b⁻¹)⁻¹ .
```

This is the presentation-level first step of the field `TWT` (Bruhat) proof of
Matsumoto's theorem: all Steinberg generators reduce to positive roots and Weyl
words.  The subsequent `TWT` closure argument remains separate.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {F : Type*} [Field F] {n : Type*} [LinearOrder n]

/-- Positive-root generators for a chosen linear order on the indices. -/
def upperSteinbergGens : Set (SteinbergGroup F n) :=
  {x | ∃ (i j : n) (hij : i ≠ j) (a : F), i < j ∧ x = steinbergX hij a}

/-- Weyl words, with arbitrary oriented root and unit parameter. -/
def weylSteinbergGens : Set (SteinbergGroup F n) :=
  {x | ∃ (i j : n) (hij : i ≠ j) (u : Fˣ), x = steinbergWeyl hij u}

/-- The subgroup generated by positive roots and Weyl words. -/
def upperWeylSteinbergSubgroup : Subgroup (SteinbergGroup F n) :=
  Subgroup.closure (upperSteinbergGens (F := F) (n := n) ∪ weylSteinbergGens (F := F) (n := n))

omit [LinearOrder n] in
/-- A nonzero negative-root generator has an exact upper--Weyl--upper factorization. -/
theorem steinbergX_lower_eq_upper_weyl_upper {i j : n} (hij : i ≠ j) (b : Fˣ) :
    steinbergX hij (b : F)
      = (steinbergX (Ne.symm hij) ((-b⁻¹ : Fˣ) : F))⁻¹ * steinbergWeyl (Ne.symm hij) (-b⁻¹)
        * (steinbergX (Ne.symm hij) ((-b⁻¹ : Fˣ) : F))⁻¹ := by
  rw [steinbergWeyl]
  have hval : -((((-b⁻¹ : Fˣ)⁻¹ : Fˣ) : F)) = (b : F) := by simp
  rw [hval]
  group

/-- Over a field, positive-root generators and Weyl words generate the Steinberg group. -/
theorem steinbergGroup_generated_by_upper_and_weyl :
    upperWeylSteinbergSubgroup (F := F) (n := n) = ⊤ := by
  apply top_unique
  rw [show (⊤ : Subgroup (SteinbergGroup F n))
      = Subgroup.closure (Set.range (PresentedGroup.of : SteinbergGen F n → SteinbergGroup F n))
      from (PresentedGroup.closure_range_of (steinbergRels F n)).symm]
  apply (Subgroup.closure_le _).2
  rintro x ⟨g, rfl⟩
  change steinbergX g.hij g.a ∈ upperWeylSteinbergSubgroup (F := F) (n := n)
  rcases lt_or_gt_of_ne g.hij with hlt | hgt
  · exact Subgroup.subset_closure (Or.inl ⟨g.i, g.j, g.hij, g.a, hlt, rfl⟩)
  · rcases eq_or_ne g.a 0 with hzero | ha
    · rw [hzero, steinbergX_zero]
      exact Subgroup.one_mem _
    · let b : Fˣ := Units.mk0 g.a ha
      have hupper : steinbergX (Ne.symm g.hij) ((-b⁻¹ : Fˣ) : F)
          ∈ upperWeylSteinbergSubgroup (F := F) (n := n) :=
        Subgroup.subset_closure
          (Or.inl ⟨g.j, g.i, Ne.symm g.hij, ((-b⁻¹ : Fˣ) : F), hgt, rfl⟩)
      have hweyl : steinbergWeyl (Ne.symm g.hij) (-b⁻¹)
          ∈ upperWeylSteinbergSubgroup (F := F) (n := n) :=
        Subgroup.subset_closure (Or.inr ⟨g.j, g.i, Ne.symm g.hij, -b⁻¹, rfl⟩)
      have hfact := steinbergX_lower_eq_upper_weyl_upper g.hij b
      rw [← show (b : F) = g.a by simp [b], hfact]
      exact (upperWeylSteinbergSubgroup (F := F) (n := n)).mul_mem
        ((upperWeylSteinbergSubgroup (F := F) (n := n)).mul_mem
          ((upperWeylSteinbergSubgroup (F := F) (n := n)).inv_mem hupper) hweyl)
        ((upperWeylSteinbergSubgroup (F := F) (n := n)).inv_mem hupper)

end GaloisForLFunctions.HTGeometry
