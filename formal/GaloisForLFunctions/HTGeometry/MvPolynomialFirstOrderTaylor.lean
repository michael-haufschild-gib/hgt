import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.Ideal.Operations

/-!
# First-order Taylor expansion of a multivariate polynomial

Evaluating a polynomial at a perturbed point differs from the linearised value by a quantity in the
square of the ideal generated by the perturbation:

`P(S + L) − P(S) − ∑ⱼ (∂ⱼP)(S)·Lⱼ ∈ J²`   whenever every `Lⱼ ∈ J`.

The proof is the induction on `P` along constants, sums, and multiplication by a variable; the
multiplication step is the algebraic identity

`Δ(p·Xᵢ) = (Sᵢ + Lᵢ)·Δ(p) + Lᵢ·∑ⱼ (∂ⱼp)(S)·Lⱼ`,

whose two summands lie in `J²` for the two different reasons.

This is the exact form an endpoint expansion needs.  Splitting a power series into its low part `S`
(degrees `≤ N − R`) and high part `L` (degrees `> N − R`) makes `J = (X^{N-R+1})`, so `J²` is
invisible to the coefficient of `X^N` as soon as `N ≥ 2R`; the expansion is therefore an *exact*
identity for that coefficient, not an asymptotic one.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

/-- The first-order Taylor defect of a polynomial at a perturbed point. -/
noncomputable def taylorDefect {σ R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
    [Fintype σ] (S L : σ → A) (P : MvPolynomial σ R) : A :=
  aeval (S + L) P - aeval S P - ∑ j, (aeval S (pderiv j P)) * L j

theorem taylorDefect_C {σ R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
    [Fintype σ] (S L : σ → A) (r : R) : taylorDefect S L (C r) = 0 := by
  simp [taylorDefect]

theorem taylorDefect_add {σ R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
    [Fintype σ] (S L : σ → A) (p q : MvPolynomial σ R) :
    taylorDefect S L (p + q) = taylorDefect S L p + taylorDefect S L q := by
  simp only [taylorDefect, map_add, add_mul]
  rw [Finset.sum_add_distrib]
  ring

/-- The multiplication step of the Taylor induction. -/
theorem taylorDefect_mul_X {σ R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
    [Fintype σ] [DecidableEq σ] (S L : σ → A) (p : MvPolynomial σ R) (i : σ) :
    taylorDefect S L (p * X i)
      = (S i + L i) * taylorDefect S L p
        + L i * ∑ j, (aeval S (pderiv j p)) * L j := by
  classical
  have hpd_eq : pderiv i (p * X i) = X i * pderiv i p + p := by
    rw [(pderiv i).leibniz, pderiv_X_self]
    simp [smul_eq_mul]
    ring
  have hpd_ne : ∀ j : σ, j ≠ i → pderiv j (p * X i) = X i * pderiv j p := by
    intro j hji
    rw [(pderiv j).leibniz, pderiv_X_of_ne hji.symm]
    simp [smul_eq_mul]
  have hsum : ∑ j, (aeval S (pderiv j (p * X i))) * L j
      = (aeval S p) * L i + S i * ∑ j, (aeval S (pderiv j p)) * L j := by
    have hterm : ∀ j ∈ (Finset.univ : Finset σ),
        (aeval S (pderiv j (p * X i))) * L j
          = S i * ((aeval S (pderiv j p)) * L j) + (if j = i then (aeval S p) * L i else 0) := by
      intro j _
      by_cases hji : j = i
      · subst hji
        rw [hpd_eq, if_pos rfl]
        simp only [map_add, map_mul, aeval_X]
        ring
      · rw [hpd_ne j hji, if_neg hji]
        simp only [map_mul, aeval_X]
        ring
    rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib, ← Finset.mul_sum,
      Finset.sum_ite_eq' Finset.univ i (fun _ => (aeval S p) * L i), if_pos (Finset.mem_univ i)]
    ring
  have hSL : ((S + L) i) = S i + L i := rfl
  simp only [taylorDefect, map_mul, aeval_X, hSL, hsum]
  ring

/-- **First-order Taylor expansion.**  The defect lies in the square of the ideal generated by the
perturbation. -/
theorem taylorDefect_mem_sq {σ R A : Type*} [CommSemiring R] [CommRing A] [Algebra R A]
    [Fintype σ] [DecidableEq σ] (J : Ideal A) (S L : σ → A) (hL : ∀ i, L i ∈ J)
    (P : MvPolynomial σ R) : taylorDefect S L P ∈ J ^ 2 := by
  classical
  induction P using MvPolynomial.induction_on with
  | C r => rw [taylorDefect_C]; exact Submodule.zero_mem _
  | add p q hp hq => rw [taylorDefect_add]; exact Submodule.add_mem _ hp hq
  | mul_X p i hp =>
      rw [taylorDefect_mul_X]
      refine Submodule.add_mem _ (Submodule.smul_mem _ _ hp) ?_
      have hmem : (∑ j, (aeval S (pderiv j p)) * L j) ∈ J :=
        Submodule.sum_mem _ fun j _ => Ideal.mul_mem_left J _ (hL j)
      rw [pow_two]
      exact Ideal.mul_mem_mul (hL i) hmem

/-- **The linearised evaluation.**  Modulo `J²`, evaluating at a perturbed point is evaluating at
the base point plus the directional derivative. -/
theorem aeval_add_eq_add_sum_pderiv_mod_sq {σ R A : Type*} [CommSemiring R] [CommRing A]
    [Algebra R A] [Fintype σ] (S L : σ → A) (P : MvPolynomial σ R) :
    aeval (S + L) P
      = aeval S P + (∑ j, (aeval S (pderiv j P)) * L j) + taylorDefect S L P := by
  rw [taylorDefect]
  ring

end GaloisForLFunctions.HTGeometry
