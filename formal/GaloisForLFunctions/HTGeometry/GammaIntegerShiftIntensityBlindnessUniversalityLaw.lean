import GaloisForLFunctions.HTGeometry.WignerSmithLogClockObservability
import GaloisForLFunctions.HTGeometry.UnivMeroFieldInstances

/-!
# Gamma integer-shift intensity-blindness universality

For every opposite-orientation Gamma scattering pair whose two shifts differ by a nonnegative
integer, reflected-frequency intensity collapses to a differential-algebraic gauge.  The
orientation-sensitive phase and the Wigner--Smith logarithmic clock remain hypertranscendental.
Consequently neither can be reconstructed by any scalar-aware finite differential circuit from
the intensity.  Coulomb and type-I de Sitter sectors are specializations of this source law.
-/

open Filter Set Topology Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher Polynomial

noncomputable section

open scoped UnivMeroFieldInstances

/-- Complete phase/intensity/delay certificate at one integer-separated Gamma orbit. -/
def GammaIntegerShiftIntensityBlindnessCertificate (a : ℂ) (n : ℕ) : Prop :=
  gammaOppositeShiftIntensityMero a (a + (n : ℂ)) =
      gammaReflectionIntegerShiftGaugeMero a n ∧
  DifferentialAlgebraicOver (RatFunc ℂ)
    (gammaOppositeShiftIntensityMero a (a + (n : ℂ))) ∧
  HypertranscendentalOver (RatFunc ℂ)
    (gammaOppositeShiftPhaseMero a (a + (n : ℂ))) ∧
  HypertranscendentalOver (RatFunc ℂ)
    (gammaOppositeShiftWignerSmithLogMero a (a + (n : ℂ))) ∧
  gammaOppositeShiftPhaseMero a (a + (n : ℂ)) *
      gammaOppositeShiftIntensityMero a (a + (n : ℂ)) =
    (gammaOppositeShiftQuotientMero a (a + (n : ℂ))) ^ 2 ∧
  (¬ HTGeometry.FiniteDifferentialCircuit
    (HTGeometry.BaseScalarOrAtom (RatFunc ℂ) (meroField Set.univ)
      (fun x ↦ x = gammaOppositeShiftIntensityMero a (a + (n : ℂ))))
    (gammaOppositeShiftPhaseMero a (a + (n : ℂ)))) ∧
  ¬ HTGeometry.FiniteDifferentialCircuit
    (HTGeometry.BaseScalarOrAtom (RatFunc ℂ) (meroField Set.univ)
      (fun x ↦ x = gammaOppositeShiftIntensityMero a (a + (n : ℂ))))
    (gammaOppositeShiftWignerSmithLogMero a (a + (n : ℂ)))

/-- **Gamma integer-shift intensity-blindness universality law.**  At every integer separation,
intensity is DA but phase and logarithmic delay are HT, preserve the squared-amplitude relation,
and are inaccessible to finite differential circuits generated by intensity and rational clocks.
-/
theorem gammaIntegerShift_intensityBlindnessUniversality (a : ℂ) (n : ℕ) :
    GammaIntegerShiftIntensityBlindnessCertificate a n := by
  have hIntensity : DifferentialAlgebraicOver (RatFunc ℂ)
      (gammaOppositeShiftIntensityMero a (a + (n : ℂ))) :=
    differentialAlgebraicOver_gammaOppositeShiftIntensityMero_add_nat a n
  have hPhase : HypertranscendentalOver (RatFunc ℂ)
      (gammaOppositeShiftPhaseMero a (a + (n : ℂ))) :=
    hypertranscendentalOver_gammaOppositeShiftPhaseMero _ _
  have hPhaseCircuit : ¬ HTGeometry.FiniteDifferentialCircuit
      (HTGeometry.BaseScalarOrAtom (RatFunc ℂ) (meroField Set.univ)
        (fun x ↦ x = gammaOppositeShiftIntensityMero a (a + (n : ℂ))))
      (gammaOppositeShiftPhaseMero a (a + (n : ℂ))) := by
    intro hcircuit
    obtain ⟨x, hx, hHT⟩ :=
      HTGeometry.exists_hypertranscendental_atom_of_scalarAwareFiniteDifferentialCircuit
        hPhase hcircuit
    rw [hx] at hHT
    exact hHT hIntensity
  exact ⟨
    gammaOppositeShiftIntensityMero_eq_integerShiftGauge a n,
    hIntensity,
    hPhase,
    hypertranscendentalOver_gammaOppositeShiftWignerSmithLogMero _ _,
    gammaOppositeShiftPhase_mul_intensity _ _,
    hPhaseCircuit,
    no_scalarAwareFiniteDifferentialCircuit_gammaWignerSmith_from_integerShiftIntensity a n⟩

end

end GaloisForLFunctions
