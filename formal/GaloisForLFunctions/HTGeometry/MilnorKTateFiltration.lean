import GaloisForLFunctions.HTGeometry.SmoothRationalUnits
import GaloisForLFunctions.HTGeometry.MilnorKDegTwoSymbol
import GaloisForLFunctions.HTGeometry.MilnorKTameKernel

/-!
# Tate's filtration of `K_2^M(ℚ)` by the largest prime that occurs

`smoothK2 N` is the subgroup generated by the symbols of `N`-smooth rational units.  It is monotone,
exhausts `K_2^M(ℚ)` because every unit is smooth for some bound, and is killed by `2` at `N = 1`
because the `1`-smooth units are `±1`.

At a prime `p` the filtration step is controlled by a single decomposition: every `p`-smooth unit is
`a' p^i` with `a'` `(p−1)`-smooth, so modulo `smoothK2 (p−1)` the group `smoothK2 p` is generated by
the symbols `{u, p}` with `u` `(p−1)`-smooth — the collected exponents being absorbed into `u`,
using `{p, p} = {−1, p}`.

* `smoothK2`, `smoothK2_mono`, `smoothK2Union_eq_top`
* `two_zsmul_eq_zero_of_mem_smoothK2_one`
* `smoothK2_prime_decomp` : **`x = y + {u, p}` with `y` and `u` one level down.**
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

section Tate

/-! ## Two symbol identities -/

variable {F : Type*} [Field F]

/-- `{a, a} = {−1, a}`. -/
theorem milnorSym2_self (a : Fˣ) : milnorSym2 F a a = milnorSym2 F (-1) a := by
  have h := milnorSym2_neg_self (F := F) a
  have hneg : (-a : Fˣ) = (-1 : Fˣ) * a := by
    refine Units.ext ?_
    push_cast
    ring
  rw [hneg, milnorSym2_mul_right] at h
  have h2 : milnorSym2 F a (-1) = -milnorSym2 F (-1) a := milnorSym2_antisymm a (-1)
  rw [h2] at h
  have h4 : milnorSym2 F a a - milnorSym2 F (-1) a = 0 := by
    rw [← h]
    abel
  exact sub_eq_zero.mp h4

/-! ## The filtration -/

/-- A prime as a rational unit. -/
def primeRatUnit {p : ℕ} (hp : p.Prime) : ℚˣ := natRatUnit hp.ne_zero

theorem primeRatUnit_val {p : ℕ} (hp : p.Prime) : ((primeRatUnit hp : ℚˣ) : ℚ) = (p : ℚ) := rfl

/-- The subgroup of `K_2^M(ℚ)` generated by the symbols of `N`-smooth units. -/
def smoothK2 (N : ℕ) : AddSubgroup (MilnorKDeg ℚ 2) :=
  AddSubgroup.closure {x | ∃ a ∈ smoothUnits N, ∃ b ∈ smoothUnits N, x = milnorSym2 ℚ a b}

theorem milnorSym2_mem_smoothK2 {N : ℕ} {a b : ℚˣ} (ha : a ∈ smoothUnits N)
    (hb : b ∈ smoothUnits N) : milnorSym2 ℚ a b ∈ smoothK2 N :=
  AddSubgroup.subset_closure ⟨a, ha, b, hb, rfl⟩

theorem smoothK2_mono {M N : ℕ} (h : M ≤ N) : smoothK2 M ≤ smoothK2 N := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨a, ha, b, hb, rfl⟩
  exact milnorSym2_mem_smoothK2 (smoothUnits_mono h ha) (smoothUnits_mono h hb)

theorem smoothK2_succ_of_not_prime {N : ℕ} (hN : ¬ (N + 1).Prime) :
    smoothK2 (N + 1) = smoothK2 N := by
  rw [smoothK2, smoothK2, smoothUnits_succ_of_not_prime hN]

/-! ## The two ends -/

/-- The classes killed by `2`. -/
def twoTorsionK2 : AddSubgroup (MilnorKDeg ℚ 2) where
  carrier := {x : MilnorKDeg ℚ 2 | (2 : ℤ) • x = 0}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy
    have hx' : (2 : ℤ) • x = 0 := hx
    have hy' : (2 : ℤ) • y = 0 := hy
    show (2 : ℤ) • (x + y) = 0
    rw [smul_add, hx', hy', add_zero]
  neg_mem' := by
    intro x hx
    have hx' : (2 : ℤ) • x = 0 := hx
    show (2 : ℤ) • (-x) = 0
    rw [smul_neg, hx', neg_zero]

/-- **The bottom of the filtration is killed by `2`.** -/
theorem two_zsmul_eq_zero_of_mem_smoothK2_one {x : MilnorKDeg ℚ 2} (hx : x ∈ smoothK2 1) :
    (2 : ℤ) • x = 0 := by
  have hle : smoothK2 1 ≤ twoTorsionK2 := by
    refine (AddSubgroup.closure_le _).2 ?_
    rintro z ⟨a, ha, b, hb, rfl⟩
    have hsq : a * a = 1 := mul_self_eq_one_of_mem_smoothUnits_one ha
    show (2 : ℤ) • milnorSym2 ℚ a b = 0
    have h2 : (2 : ℤ) • milnorSym2 ℚ a b = milnorSym2 ℚ a b + milnorSym2 ℚ a b := by
      rw [two_smul]
    rw [h2, ← milnorSym2_mul_left, hsq, milnorSym2_one_left]
  exact hle hx

/-- The union of the filtration. -/
def smoothK2Union : AddSubgroup (MilnorKDeg ℚ 2) where
  carrier := {x : MilnorKDeg ℚ 2 | ∃ N : ℕ, x ∈ smoothK2 N}
  zero_mem' := ⟨0, zero_mem _⟩
  add_mem' := by
    rintro x y ⟨M, hM⟩ ⟨N, hN⟩
    exact ⟨max M N, add_mem (smoothK2_mono (le_max_left M N) hM)
      (smoothK2_mono (le_max_right M N) hN)⟩
  neg_mem' := by
    rintro x ⟨N, hN⟩
    exact ⟨N, neg_mem hN⟩

/-- **The filtration exhausts `K_2^M(ℚ)`.** -/
theorem exists_mem_smoothK2 (x : MilnorKDeg ℚ 2) : ∃ N : ℕ, x ∈ smoothK2 N := by
  have hle : (⊤ : AddSubgroup (MilnorKDeg ℚ 2)) ≤ smoothK2Union := by
    rw [← closure_range_milnorSym2 (F := ℚ)]
    refine (AddSubgroup.closure_le _).2 ?_
    rintro z ⟨⟨a, b⟩, rfl⟩
    obtain ⟨M, hM⟩ := exists_mem_smoothUnits a
    obtain ⟨N, hN⟩ := exists_mem_smoothUnits b
    exact ⟨max M N, milnorSym2_mem_smoothK2 (smoothUnits_mono (le_max_left M N) hM)
      (smoothUnits_mono (le_max_right M N) hN)⟩
  exact hle (AddSubgroup.mem_top x)

/-! ## The decomposition at a prime -/

/-- Every `p`-smooth unit is a `(p−1)`-smooth unit times a power of `p`. -/
theorem exists_smoothUnits_pred_decomp {p : ℕ} [Fact p.Prime] (hp : p.Prime) {a : ℚˣ}
    (ha : a ∈ smoothUnits p) :
    ∃ a' ∈ smoothUnits (p - 1),
      a = a' * (primeRatUnit hp) ^ (padicValRat p ((a : ℚˣ) : ℚ)) := by
  set i : ℤ := padicValRat p ((a : ℚˣ) : ℚ) with hi
  refine ⟨a * (primeRatUnit hp) ^ (-i), ?_, ?_⟩
  · intro q hq hqN
    haveI : Fact q.Prime := ⟨hq⟩
    have hple : p ≤ q := by
      have := hp.two_le
      omega
    rw [padicValRat_mul_units, padicValRat_zpow_units, primeRatUnit_val]
    rcases eq_or_lt_of_le hple with h | h
    · subst h
      rw [padicValRat_self_prime, ← hi]
      ring
    · have h1 : padicValRat q ((a : ℚˣ) : ℚ) = 0 := ha q hq h
      have h2 : padicValRat q ((p : ℚ)) = 0 := by
        have hnq : ¬ q ∣ p := by
          intro hdvd
          have := Nat.le_of_dvd hp.pos hdvd
          omega
        have hz : padicValRat q ((p : ℤ) : ℚ) = 0 := by
          rw [padicValRat.of_int, padicValInt]
          have hv : padicValNat q ((p : ℤ)).natAbs = 0 := by
            refine padicValNat.eq_zero_of_not_dvd ?_
            simpa using hnq
          rw [hv]
          rfl
        simpa using hz
      rw [h1, h2]
      ring
  · rw [mul_assoc, ← zpow_add, neg_add_cancel, zpow_zero, mul_one]

theorem exists_smoothUnits_pred_decomp' {p : ℕ} [Fact p.Prime] (hp : p.Prime) {a : ℚˣ}
    (ha : a ∈ smoothUnits p) :
    ∃ a' ∈ smoothUnits (p - 1), ∃ i : ℤ, a = a' * (primeRatUnit hp) ^ i := by
  obtain ⟨a', ha', hae⟩ := exists_smoothUnits_pred_decomp hp ha
  exact ⟨a', ha', _, hae⟩

/-- The classes of the shape `y + {u, p}` with `y` and `u` one level down. -/
def tateDecomp {p : ℕ} (hp : p.Prime) : AddSubgroup (MilnorKDeg ℚ 2) where
  carrier := {x : MilnorKDeg ℚ 2 | ∃ y ∈ smoothK2 (p - 1), ∃ u ∈ smoothUnits (p - 1),
      x = y + milnorSym2 ℚ u (primeRatUnit hp)}
  zero_mem' := ⟨0, zero_mem _, 1, one_mem _, by rw [milnorSym2_one_left, add_zero]⟩
  add_mem' := by
    rintro x1 x2 ⟨y1, hy1, u1, hu1, rfl⟩ ⟨y2, hy2, u2, hu2, rfl⟩
    refine ⟨y1 + y2, add_mem hy1 hy2, u1 * u2, mul_mem hu1 hu2, ?_⟩
    rw [milnorSym2_mul_left]
    abel
  neg_mem' := by
    rintro x ⟨y, hy, u, hu, rfl⟩
    refine ⟨-y, neg_mem hy, u⁻¹, inv_mem hu, ?_⟩
    rw [milnorSym2_inv_left]
    abel

/-- **The filtration step at a prime.**  Modulo one level down, `smoothK2 p` is generated by the
symbols `{u, p}` with `u` one level down. -/
theorem smoothK2_le_tateDecomp {p : ℕ} [Fact p.Prime] (hp : p.Prime) :
    smoothK2 p ≤ tateDecomp hp := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨a, ha, b, hb, rfl⟩
  obtain ⟨a', ha', i, rfl⟩ := exists_smoothUnits_pred_decomp' hp ha
  obtain ⟨b', hb', j, rfl⟩ := exists_smoothUnits_pred_decomp' hp hb
  set P : ℚˣ := primeRatUnit hp with hP
  set u : ℚˣ := a' ^ j * b' ^ (-i) * ((-1 : ℚˣ) ^ (i * j)) with hu
  have e1 : milnorSym2 ℚ (a' * P ^ i) (b' * P ^ j)
      = milnorSym2 ℚ a' (b' * P ^ j) + milnorSym2 ℚ (P ^ i) (b' * P ^ j) :=
    milnorSym2_mul_left _ _ _
  have e2 : milnorSym2 ℚ a' (b' * P ^ j) = milnorSym2 ℚ a' b' + milnorSym2 ℚ a' (P ^ j) :=
    milnorSym2_mul_right _ _ _
  have e3 : milnorSym2 ℚ a' (P ^ j) = j • milnorSym2 ℚ a' P := milnorSym2_zpow_right _ _ _
  have e4 : milnorSym2 ℚ (P ^ i) (b' * P ^ j)
      = milnorSym2 ℚ (P ^ i) b' + milnorSym2 ℚ (P ^ i) (P ^ j) := milnorSym2_mul_right _ _ _
  have e5 : milnorSym2 ℚ (P ^ i) b' = i • milnorSym2 ℚ P b' := milnorSym2_zpow_left _ _ _
  have e6 : milnorSym2 ℚ P b' = -milnorSym2 ℚ b' P := milnorSym2_antisymm _ _
  have e7 : milnorSym2 ℚ (P ^ i) (P ^ j) = i • milnorSym2 ℚ P (P ^ j) :=
    milnorSym2_zpow_left _ _ _
  have e8 : milnorSym2 ℚ P (P ^ j) = j • milnorSym2 ℚ P P := milnorSym2_zpow_right _ _ _
  have e9 : milnorSym2 ℚ P P = milnorSym2 ℚ (-1 : ℚˣ) P := milnorSym2_self P
  have eu : milnorSym2 ℚ u P
      = j • milnorSym2 ℚ a' P + (-i) • milnorSym2 ℚ b' P
        + (i * j) • milnorSym2 ℚ (-1 : ℚˣ) P := by
    rw [hu, milnorSym2_mul_left, milnorSym2_mul_left, milnorSym2_zpow_left,
      milnorSym2_zpow_left, milnorSym2_zpow_left]
  refine ⟨milnorSym2 ℚ a' b', milnorSym2_mem_smoothK2 ha' hb', u, ?_, ?_⟩
  · refine mul_mem (mul_mem (Subgroup.zpow_mem _ ha' j) (Subgroup.zpow_mem _ hb' (-i))) ?_
    exact Subgroup.zpow_mem _ (neg_one_mem_smoothUnits (p - 1)) (i * j)
  · rw [e1, e2, e3, e4, e5, e6, e7, e8, e9, eu, smul_smul, smul_neg, neg_smul]
    abel

end Tate

end

end GaloisForLFunctions.HTGeometry
