import GaloisForLFunctions.HTGeometry.LocalExtensionChartProbeContinuity

/-!
# Openness of physical observer support in a local-extension chart

Nonzero canonical bra--ket amplitudes persist under small changes of every
onsite and edge coordinate.  Hence a connected, nonbipartite finite
observer-support graph at one simple-spectrum point remains connected and
nonbipartite on a full chart neighborhood.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Filter Topology
open scoped Matrix.Norms.Elementwise

/-- Support graph generated by probes on the old-system factor at an
arbitrary point of the full local-extension chart. -/
def oldSystemLocalExtensionChartProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    SimpleGraph (I × ρ) where
  Adj x y :=
    x ≠ y ∧
      ∃ q,
        C.sesquilinearProbe energy shift attachment x y
            (layerMatrixCoupling (probe q)
              (1 : Matrix ρ ρ ℂ)) p ≠ 0 ∨
          C.sesquilinearProbe energy shift attachment y x
            (layerMatrixCoupling (probe q)
              (1 : Matrix ρ ρ ℂ)) p ≠ 0
  symm := by
    constructor
    intro x y hxy
    exact ⟨hxy.1.symm, by
      rcases hxy.2 with ⟨q, hq | hq⟩
      · exact ⟨q, Or.inr hq⟩
      · exact ⟨q, Or.inl hq⟩⟩
  loopless := by
    constructor
    intro x hxx
    exact hxx.1 rfl

/-- Support graph generated by probes on the new factor at an arbitrary
chart point. -/
def newLayerLocalExtensionChartProbeSupportGraph
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    SimpleGraph (I × ρ) where
  Adj x y :=
    x ≠ y ∧
      ∃ q,
        C.sesquilinearProbe energy shift attachment x y
            (layerMatrixCoupling (1 : Matrix I I ℂ)
              (probe q)) p ≠ 0 ∨
          C.sesquilinearProbe energy shift attachment y x
            (layerMatrixCoupling (1 : Matrix I I ℂ)
              (probe q)) p ≠ 0
  symm := by
    constructor
    intro x y hxy
    exact ⟨hxy.1.symm, by
      rcases hxy.2 with ⟨q, hq | hq⟩
      · exact ⟨q, Or.inr hq⟩
      · exact ⟨q, Or.inl hq⟩⟩
  loopless := by
    constructor
    intro x hxx
    exact hxx.1 rfl

/-- The full-chart old-system graph restricts exactly to the previous
anchor-star affine graph. -/
theorem oldSystemLocalExtensionChartProbeSupportGraph_anchorStar
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (anchor : ρ) (probe : η → Matrix I I ℂ) (t : ℂ) :
    oldSystemLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe
        (shift, t • anchorStarLayerEdge anchor) =
      oldSystemEigenbranchProbeSupportGraph
        (layeredEnergy energy shift)
        (layerMatrixCoupling attachment
          (anchorStarLayerEdge anchor))
        (C.anchorStarBranch
          energy shift attachment anchor)
        probe t := by
  ext x y
  simp only [oldSystemLocalExtensionChartProbeSupportGraph,
    oldSystemEigenbranchProbeSupportGraph]
  simp_rw [C.sesquilinearProbe_anchorStar
    energy shift attachment anchor]

/-- The same exact restriction holds for new-factor probes. -/
theorem newLayerLocalExtensionChartProbeSupportGraph_anchorStar
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (anchor : ρ) (probe : η → Matrix ρ ρ ℂ) (t : ℂ) :
    newLayerLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe
        (shift, t • anchorStarLayerEdge anchor) =
      newLayerEigenbranchProbeSupportGraph
        (layeredEnergy energy shift)
        (layerMatrixCoupling attachment
          (anchorStarLayerEdge anchor))
        (C.anchorStarBranch
          energy shift attachment anchor)
        probe t := by
  ext x y
  simp only [newLayerLocalExtensionChartProbeSupportGraph,
    newLayerEigenbranchProbeSupportGraph]
  simp_rw [C.sesquilinearProbe_anchorStar
    energy shift attachment anchor]

/-- Every old-system support edge present at one chart point persists on a
common neighborhood. -/
theorem eventually_oldSystemChartProbeSupportGraph_le
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (p₀ : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp₀ : p₀ ∈ C.U) :
    ∀ᶠ p in 𝓝 p₀,
      oldSystemLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p₀ ≤
        oldSystemLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p := by
  change ∀ᶠ p in 𝓝 p₀, ∀ x y,
    (oldSystemLocalExtensionChartProbeSupportGraph
      energy shift attachment C probe p₀).Adj x y →
    (oldSystemLocalExtensionChartProbeSupportGraph
      energy shift attachment C probe p).Adj x y
  apply Filter.eventually_all.mpr
  intro x
  apply Filter.eventually_all.mpr
  intro y
  by_cases hxy :
      (oldSystemLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).Adj x y
  · rcases hxy.2 with ⟨q, hq | hq⟩
    · have hev :=
        (C.sesquilinearProbe_continuousAt
          energy shift attachment x y
          (layerMatrixCoupling (probe q)
            (1 : Matrix ρ ρ ℂ)) p₀ hp₀).eventually_ne hq
      filter_upwards [hev] with p hp
      intro _
      exact ⟨hxy.1, ⟨q, Or.inl hp⟩⟩
    · have hev :=
        (C.sesquilinearProbe_continuousAt
          energy shift attachment y x
          (layerMatrixCoupling (probe q)
            (1 : Matrix ρ ρ ℂ)) p₀ hp₀).eventually_ne hq
      filter_upwards [hev] with p hp
      intro _
      exact ⟨hxy.1, ⟨q, Or.inr hp⟩⟩
  · filter_upwards [] with p
    exact fun h => (hxy h).elim

/-- Every new-factor support edge likewise persists. -/
theorem eventually_newLayerChartProbeSupportGraph_le
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (p₀ : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp₀ : p₀ ∈ C.U) :
    ∀ᶠ p in 𝓝 p₀,
      newLayerLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p₀ ≤
        newLayerLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p := by
  change ∀ᶠ p in 𝓝 p₀, ∀ x y,
    (newLayerLocalExtensionChartProbeSupportGraph
      energy shift attachment C probe p₀).Adj x y →
    (newLayerLocalExtensionChartProbeSupportGraph
      energy shift attachment C probe p).Adj x y
  apply Filter.eventually_all.mpr
  intro x
  apply Filter.eventually_all.mpr
  intro y
  by_cases hxy :
      (newLayerLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).Adj x y
  · rcases hxy.2 with ⟨q, hq | hq⟩
    · have hev :=
        (C.sesquilinearProbe_continuousAt
          energy shift attachment x y
          (layerMatrixCoupling (1 : Matrix I I ℂ)
            (probe q)) p₀ hp₀).eventually_ne hq
      filter_upwards [hev] with p hp
      intro _
      exact ⟨hxy.1, ⟨q, Or.inl hp⟩⟩
    · have hev :=
        (C.sesquilinearProbe_continuousAt
          energy shift attachment y x
          (layerMatrixCoupling (1 : Matrix I I ℂ)
            (probe q)) p₀ hp₀).eventually_ne hq
      filter_upwards [hev] with p hp
      intro _
      exact ⟨hxy.1, ⟨q, Or.inr hp⟩⟩
  · filter_upwards [] with p
    exact fun h => (hxy h).elim

/-- Connectedness and nonbipartiteness of an old-system observer graph are
open in the full physical chart. -/
theorem eventually_oldSystemChartProbeSupportGraph_good
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (p₀ : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp₀ : p₀ ∈ C.U)
    (hconnected :
      (oldSystemLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).Preconnected)
    (hnonbipartite :
      ¬ (oldSystemLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).IsBipartite) :
    ∀ᶠ p in 𝓝 p₀,
      (oldSystemLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p).Preconnected ∧
        ¬ (oldSystemLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p).IsBipartite := by
  filter_upwards
    [eventually_oldSystemChartProbeSupportGraph_le
      energy shift attachment C probe p₀ hp₀]
      with p hle
  exact ⟨hconnected.mono hle,
    fun hbip => hnonbipartite (hbip.mono_left hle)⟩

/-- The same openness theorem holds for the new factor. -/
theorem eventually_newLayerChartProbeSupportGraph_good
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (p₀ : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp₀ : p₀ ∈ C.U)
    (hconnected :
      (newLayerLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).Preconnected)
    (hnonbipartite :
      ¬ (newLayerLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p₀).IsBipartite) :
    ∀ᶠ p in 𝓝 p₀,
      (newLayerLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p).Preconnected ∧
        ¬ (newLayerLocalExtensionChartProbeSupportGraph
          energy shift attachment C probe p).IsBipartite := by
  filter_upwards
    [eventually_newLayerChartProbeSupportGraph_le
      energy shift attachment C probe p₀ hp₀]
      with p hle
  exact ⟨hconnected.mono hle,
    fun hbip => hnonbipartite (hbip.mono_left hle)⟩

end

end GaloisForLFunctions.HTGeometry
