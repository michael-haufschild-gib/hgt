import GaloisForLFunctions.HTGeometry.SpectralOrbitComplexityAssembly
import GaloisForLFunctions.HTGeometry.ComplexRootFamilyRigidity
import GaloisForLFunctions.HTGeometry.LinearIndependentBaseChange
import GaloisForLFunctions.HTGeometry.TwoLocalIntegerWitness
import Mathlib.Analysis.Matrix.Spectrum

/-!
# The exact-complexity law of an explicit integer two-local Hamiltonian

Every ingredient of the algebraic exact-complexity theorem is now available: an explicit traceless
integer two-local Hamiltonian whose characteristic polynomial has the full symmetric Galois group,
the rigidity of its spectrum, the cyclicity of the all-zero product state, and the transcendence
bound on a circuit.  They are assembled here.

## Main results

* `transverseFamilyHam_transpose` — the transverse family is symmetric.
* `zeroCubeState` — the all-zero product state of the Boolean hypercube.
* `exists_twoLocal_exact_complexity_law` — **the card's Theorem A**: there is a traceless integer
  two-local Hamiltonian whose spectrum is rationally rigid, whose all-zero product state overlaps
  every eigenvector, and whose orbit at every nonzero algebraic time needs at least `(D-1)/q` gates.
-/

open Matrix Polynomial
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

namespace TwoLocalWitness

set_option linter.unusedSectionVars false

noncomputable section

/-! ### Symmetry of the transverse family -/

theorem boolToggle_involutive {n : ℕ} (x : Fin n → Bool) (i : Fin n) :
    boolToggle (boolToggle x i) i = x := by
  funext j
  by_cases hj : j = i
  · subst hj
    simp [boolToggle]
  · simp [boolToggle, Function.update_of_ne hj]

theorem boolToggle_eq_comm {n : ℕ} (x y : Fin n → Bool) (i : Fin n) :
    y = boolToggle x i ↔ x = boolToggle y i := by
  constructor
  · rintro rfl
    exact (boolToggle_involutive x i).symm
  · rintro rfl
    exact (boolToggle_involutive y i).symm

theorem transverseFamilyHam_symm {R : Type*} [CommRing R] {n : ℕ}
    (d : (Fin n → Bool) → R) (u : Fin n → R) (x y : Fin n → Bool) :
    transverseFamilyHam d u x y = transverseFamilyHam d u y x := by
  classical
  rw [transverseFamilyHam, transverseFamilyHam]
  by_cases hxy : x = y
  · subst hxy
    rfl
  · rw [if_neg hxy, if_neg (fun h => hxy h.symm)]
    refine Finset.sum_congr rfl fun i _ => ?_
    by_cases h : y = boolToggle x i
    · rw [if_pos h, if_pos ((boolToggle_eq_comm x y i).mp h)]
    · rw [if_neg h, if_neg (fun hcon => h ((boolToggle_eq_comm y x i).mp hcon))]

/-! ### The all-zero product state -/

/-- The all-zero product state of the Boolean hypercube, over any base ring. -/
def zeroCubeState (R : Type*) [CommRing R] (n : ℕ) : (Fin n → Bool) → R :=
  fun x => if x = (fun _ => false) then 1 else 0

theorem zeroCubeState_ne_zero {R : Type*} [CommRing R] [Nontrivial R] (n : ℕ) :
    zeroCubeState R n ≠ 0 := by
  intro h
  have := congrFun h (fun _ => false)
  rw [zeroCubeState, if_pos rfl] at this
  exact one_ne_zero this

theorem map_zeroCubeState (n : ℕ) (i : Fin n → Bool) :
    algebraMap ℚ ℂ (zeroCubeState ℚ n i) = zeroCubeState ℂ n i := by
  rw [zeroCubeState, zeroCubeState]
  by_cases h : i = fun _ => false
  · rw [if_pos h, if_pos h, map_one]
  · rw [if_neg h, if_neg h, map_zero]

/-! ### The exact-complexity law -/

variable {m : ℕ}

/-- **The card's Theorem A.**  There is a traceless integer two-local Hamiltonian on `m+1` qubits
whose eigenvalues are pairwise distinct and carry no rational relation other than the trace
relation, whose all-zero product state overlaps every eigenvector, and whose Schrödinger orbit at
every nonzero algebraic time cannot be prepared from that state by fewer than `(2^{m+1}-1)/q` gates
each generated by `q` algebraic numbers. -/
theorem exists_twoLocal_exact_complexity_law (m : ℕ) (q : ℕ) :
    ∃ (u : Fin (m + 1) → ℚ) (N : ℕ)
      (Hz : Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℤ)
      (hH : (Hz.map (Int.castRingHom ℂ)).IsHermitian),
      0 < N ∧ Hz.trace = 0 ∧
      Hz.map (Int.castRingHom ℚ)
        = (N : ℚ) • twoLocalHam (witnessConstant m) 0 witnessCoupling u ∧
      Function.Injective hH.eigenvalues ∧
      LinearMap.ker (SpectralExp.relationForm fun i => ((hH.eigenvalues i : ℝ) : ℂ))
        = PermSubspace.constLine (K := ℚ) (ι := (Fin (m + 1) → Bool)) ∧
      (∀ j, finiteComplexInner
          (hermitianEigenBasis (Hz.map (Int.castRingHom ℂ)) hH j)
          (zeroCubeState ℂ (m + 1)) ≠ 0) ∧
      (∀ t : ℝ, t ≠ 0 → IsAlgebraic ℚ ((t : ℝ) : ℂ) →
        ∀ l : List (Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℂ),
          (∀ M ∈ l, CircuitAdjoin.GeneratedBy (L := ℂ) (↥AlgebraicOrbit.algNum) q M) →
          l.prod *ᵥ zeroCubeState ℂ (m + 1)
            = unitaryEvolution (Hz.map (Int.castRingHom ℂ)) t *ᵥ zeroCubeState ℂ (m + 1) →
          2 ^ (m + 1) - 1 ≤ l.length * q) := by
  classical
  obtain ⟨u, N, Hz, -, hN, hA, hgal, hirr, hcycQ⟩ :=
    exists_integer_twoLocal_symmetric_gal (m := m) (witnessConstant m)
      (g := (1 : MvPolynomial (Fin (m + 1)) ℚ)) one_ne_zero
  set Hq : Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℚ := Hz.map (Int.castRingHom ℚ) with hHq
  set H : Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℂ := Hz.map (Int.castRingHom ℂ) with hHdef
  have hcardcube : Fintype.card (Fin (m + 1) → Bool) = 2 ^ (m + 1) := by simp
  have hHmapQ : Hq.map (algebraMap ℚ ℂ) = H := by
    ext x y
    rw [Matrix.map_apply, hHq, Matrix.map_apply, hHdef, Matrix.map_apply]
    rfl
  -- symmetry of the integer matrix
  have hZsymm : ∀ x y, Hz x y = Hz y x := by
    intro x y
    have hxy := congrArg
      (fun A : Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℚ => A x y) hA
    have hyx := congrArg
      (fun A : Matrix (Fin (m + 1) → Bool) (Fin (m + 1) → Bool) ℚ => A y x) hA
    simp only [Matrix.smul_apply, twoLocalHam] at hxy hyx
    have hsym := transverseFamilyHam_symm
      (twoLocalDiagonal (witnessConstant m) 0 witnessCoupling) u x y
    have hcq : ((Hz x y : ℤ) : ℚ) = ((Hz y x : ℤ) : ℚ) := by
      show Hq x y = Hq y x
      rw [hxy, hyx, hsym]
    exact_mod_cast hcq
  have hHerm : H.IsHermitian := by
    rw [Matrix.IsHermitian]
    ext x y
    rw [Matrix.conjTranspose_apply]
    show (starRingEnd ℂ) (H y x) = H x y
    rw [hHdef, Matrix.map_apply, Matrix.map_apply]
    show (starRingEnd ℂ) ((Hz y x : ℤ) : ℂ) = ((Hz x y : ℤ) : ℂ)
    rw [map_intCast, hZsymm y x]
  set lam : (Fin (m + 1) → Bool) → ℝ := hHerm.eigenvalues with hlam
  set E : (Fin (m + 1) → Bool) → ℂ := fun i => ((lam i : ℝ) : ℂ) with hE
  -- the characteristic polynomial over `ℚ`
  set p : Polynomial ℚ := Hq.charpoly with hp
  have hpmap : p = Hz.charpoly.map (Int.castRingHom ℚ) := by
    rw [hp, hHq, Matrix.charpoly_map]
  have hirrp : Irreducible p := by rw [hpmap]; exact hirr
  have hgalp : Nat.card p.Gal = (2 ^ (m + 1)).factorial := by rw [hpmap]; exact hgal
  have hmonicp : p.Monic := Matrix.charpoly_monic _
  have hdegp : p.natDegree = 2 ^ (m + 1) := by
    rw [hp, Matrix.charpoly_natDegree_eq_dim, hcardcube]
  have hD1 : 1 < 2 ^ (m + 1) := Nat.one_lt_two_pow (by omega)
  -- tracelessness
  have htraceQ : Hq.trace = 0 := by
    rw [hA, Matrix.trace_smul, twoLocalHam, trace_transverseFamilyHam]
    have hsw := sum_witnessDiagonal m
    rw [witnessDiagonal] at hsw
    rw [hsw, smul_zero]
  have htraceZ : Hz.trace = 0 := by
    have hcast : (Int.castRingHom ℚ) Hz.trace = Hq.trace := by
      show (Int.castRingHom ℚ) (∑ i, Hz.diag i) = ∑ i, Hq.diag i
      rw [map_sum]
      rfl
    rw [htraceQ] at hcast
    have hz : ((Hz.trace : ℤ) : ℚ) = 0 := hcast
    exact_mod_cast hz
  have hcoeffp : p.coeff (2 ^ (m + 1) - 1) = 0 := by
    have htr := Matrix.trace_eq_neg_charpoly_coeff Hq
    rw [hcardcube, htraceQ] at htr
    rw [hp]
    linarith
  -- the complex root family
  have hEprod : p.map (algebraMap ℚ ℂ) = ∏ i, (X - C (E i)) := by
    have h1 : p.map (algebraMap ℚ ℂ) = H.charpoly := by
      rw [hp, ← Matrix.charpoly_map, hHmapQ]
    rw [h1, hHerm.charpoly_eq]
    rfl
  have hEinj : Function.Injective E := by
    refine Polynomial.separable_prod_X_sub_C_iff.mp ?_
    rw [← hEprod]
    exact (Polynomial.separable_map _).mpr hirrp.separable
  have hlaminj : Function.Injective lam := fun x y hxy =>
    hEinj (by rw [hE]; exact congrArg (fun r : ℝ => ((r : ℝ) : ℂ)) hxy)
  have hEalg : ∀ i, IsAlgebraic ℚ (E i) := by
    intro i
    refine ⟨p, hmonicp.ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, hEprod]
    rw [Polynomial.eval_prod, Finset.prod_eq_zero (Finset.mem_univ i)]
    simp
  have hHalg : ∀ i j, IsAlgebraic ℚ (H i j) := by
    intro i j
    rw [← hHmapQ, Matrix.map_apply]
    exact isAlgebraic_algebraMap _
  -- cyclicity of the all-zero product state
  have hΩrat : ∀ i, ∃ a : ℚ, zeroCubeState ℂ (m + 1) i = algebraMap ℚ ℂ a := fun i =>
    ⟨zeroCubeState ℚ (m + 1) i, (map_zeroCubeState (m + 1) i).symm⟩
  have hcyc : LinearIndependent ℂ
      (fun k : Fin (Fintype.card (Fin (m + 1) → Bool)) => H ^ (k : ℕ) *ᵥ zeroCubeState ℂ (m + 1)) := by
    have hq := hcycQ (zeroCubeState ℚ (m + 1)) (zeroCubeState_ne_zero (m + 1))
    have hbase := BaseChange.linearIndependent_krylov_map (L := ℂ) hq
    rw [hHmapQ] at hbase
    have heq : (fun i => algebraMap ℚ ℂ (zeroCubeState ℚ (m + 1) i)) = zeroCubeState ℂ (m + 1) :=
      funext (map_zeroCubeState (m + 1))
    rwa [heq] at hbase
  have heb : IsOrthoEigenBasis H (hermitianEigenBasis H hHerm) lam :=
    isOrthoEigenBasis_hermitian H hHerm
  have hc : ∀ j, finiteComplexInner (hermitianEigenBasis H hHerm j)
      (zeroCubeState ℂ (m + 1)) ≠ 0 := fun j =>
    AlgebraicOrbit.finiteComplexInner_ne_zero_of_linearIndependent heb hcyc j
  -- rigidity of the spectrum
  have hrigid : LinearMap.ker (SpectralExp.relationForm E)
      = PermSubspace.constLine (K := ℚ) (ι := (Fin (m + 1) → Bool)) :=
    ker_relationForm_eq_constLine_of_gal hmonicp hirrp hdegp hD1 hcoeffp hgalp hEinj hEprod
  refine ⟨u, N, Hz, hHerm, hN, htraceZ, hA, hlaminj, hrigid, hc, ?_⟩
  intro t ht htalg l hl hprep
  have hmain := AlgebraicOrbit.card_sub_one_le_length_mul_orbit heb hlaminj hHalg hEalg
    hΩrat hcyc ht htalg (fun _ => false) hrigid l hl hprep
  rwa [hcardcube] at hmain

end

end TwoLocalWitness

end GaloisForLFunctions.HTGeometry
