import GaloisForLFunctions.HTGeometry.DifferentExponentTame
import GaloisForLFunctions.HTGeometry.EisensteinRootUniformizer

/-!
# A different of divisorial order one is a simple fold

`DifferentExponentTame.differentIdeal_eq_span_pow` computes the tame different of a finite extension
of discrete valuation rings with trivial residue extension as the `(e−1)`-st power of the maximal
ideal.  Comparing valuations of two generators of the same principal ideal turns that into a
statement about the ramification index:

```text
ramificationIndex_eq_two_of_different_addVal_one :
    differentIdeal A B = span {J}  →  addVal B J = 1  →  e = 2
```

This is the sharp form of "the branch is a simple fold": a Jacobian that is a uniformizer of the
upper valuation ring forces the ramification index to be exactly two, hence — through
`natCard_criticalSchurIdealInertiaGroup_eq_ramificationIdxIn` — an inertia group of order two.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsDiscreteValuationRing

set_option maxHeartbeats 1600000

variable (A K : Type*) {L : Type*} {B : Type*}
variable [CommRing A] [Field K] [CommRing B] [Field L]
variable [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
variable [IsScalarTower A K L] [IsScalarTower A B L]
variable [IsDomain A] [IsFractionRing A K] [FiniteDimensional K L] [Algebra.IsSeparable K L]
variable [IsIntegrallyClosed A] [IsIntegralClosure B A L] [IsFractionRing B L]
variable [IsDedekindDomain B] [Module.IsTorsionFree A B]
variable [IsDiscreteValuationRing A] [IsDiscreteValuationRing B] [Module.Finite A B]

/-- **A different of divisorial order one forces ramification index two.**  If the tame different
of a finite extension of discrete valuation rings with trivial residue extension is generated by an
element of valuation one, the ramification index is exactly two — a simple fold. -/
theorem ramificationIndex_eq_two_of_different_addVal_one
    {πA : A} (hπA : Irreducible πA) (e : ℕ) (he : 0 < e)
    (hram : addVal B (algebraMap A B πA) = (e : ℕ∞)) {x : B} (hx : addVal B x = 1)
    (hres : ∀ b : B, ∃ a : A, addVal B (b - algebraMap A B a) ≠ 0)
    (hdvd : algebraMap A B πA ∣ x ^ e) (htame : addVal B ((e : ℕ) : B) = 0)
    {g : A[X]} (hmonic : g.Monic) (hdeg : g.natDegree = e) (hroot : aeval x g = 0)
    (halg : IsAlgebraic K (algebraMap B L x))
    {J : B} (hJ : differentIdeal A B = Ideal.span {J}) (hJval : addVal B J = 1) :
    e = 2 := by
  have hspan : Ideal.span ({J} : Set B) = Ideal.span ({x ^ (e - 1)} : Set B) := by
    rw [← hJ]
    exact differentIdeal_eq_span_pow A K hπA e he hram hx hres hdvd htame hmonic hdeg hroot halg
  have hval := addVal_eq_of_span_singleton_eq hspan
  rw [hJval, addVal_pow, hx] at hval
  have h1 : ((1 : ℕ∞)) = ((e - 1 : ℕ) : ℕ∞) := by
    simpa using hval
  have h2 : (1 : ℕ) = e - 1 := by exact_mod_cast h1
  omega

end GaloisForLFunctions.HTGeometry
