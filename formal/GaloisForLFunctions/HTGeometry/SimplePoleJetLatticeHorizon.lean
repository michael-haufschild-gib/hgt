import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Tactic

/-!
# The simple-pole jet-lattice horizon

Write a simple-pole germ as `U(t) / t`, with `U` regular.  Its `j`th derivative is a finite
Laurent sum whose pole orders run from one to `j + 1`.  In the polynomial below the exponent of
`T` records pole order, while the coefficient variable `X k` records the regular jet `U⁽ᵏ⁾`.

The main theorem identifies an exact boundary trace.  If a constant-coefficient differential
polynomial is homogeneous of total jet degree `d`, then pole grade `d` of its universal simple-pole
profile is the original polynomial evaluated on the independent regular boundary jets.  Thus a
nonzero `d`-particle observable has an unavoidable nonzero pole-grade-`d` trace.  In particular,
once the regular jets are algebraically free, no nonlinear homogeneous sector (`d ≥ 2`) can lie
behind an at-most-simple-pole boundary.

This module proves the universal algebraic selection law.  Applying it to an analytic carrier
requires a separate theorem identifying its actual regular Laurent jets with a free boundary
family; no such analytic hypothesis is hidden here.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial Polynomial

noncomputable section

/-- The polynomial ring generated by the regular boundary jets of a simple-pole germ. -/
abbrev UniversalPoleBoundaryRing := MvPolynomial ℕ ℂ

/-- The regular factor in the pole profile of the `j`th derivative of `U / t`.
The variable `X k` records the regular jet `U⁽ᵏ⁾`. -/
def universalSimplePoleRegularProfile (j : ℕ) :
    Polynomial UniversalPoleBoundaryRing :=
  ∑ k ∈ Finset.range (j + 1),
    Polynomial.monomial (j - k)
      (MvPolynomial.C ((j.choose k : ℂ) * (-1 : ℂ) ^ (j - k) * ((j - k).factorial : ℂ)) *
        MvPolynomial.X k)

/-- Pole order is recorded as polynomial degree.  This is the exact pole profile of the
`j`th derivative of `U / t`. -/
def universalSimplePoleJetProfile (j : ℕ) :
    Polynomial UniversalPoleBoundaryRing :=
  Polynomial.X * universalSimplePoleRegularProfile j

/-- The grade-one boundary trace of the `j`th pole profile is the free regular jet `X j`. -/
theorem universalSimplePoleRegularProfile_eval_zero (j : ℕ) :
    (universalSimplePoleRegularProfile j).eval 0 = MvPolynomial.X j := by
  rw [universalSimplePoleRegularProfile, Polynomial.eval_finsetSum]
  rw [Finset.sum_eq_single j]
  · simp
  · intro k hk hkj
    have hkj' : k < j := by
      have hkle : k ≤ j := by simpa using (Finset.mem_range.mp hk)
      omega
    have hne : j - k ≠ 0 := (Nat.sub_pos_of_lt hkj').ne'
    simp [hne]
  · simp

/-- Evaluation of a constant-coefficient differential polynomial on the universal simple-pole
jet profile. -/
def universalSimplePoleProfileEval :
    MvPolynomial ℕ ℂ →+* Polynomial UniversalPoleBoundaryRing :=
  MvPolynomial.eval₂Hom
    (Polynomial.C.comp MvPolynomial.C)
    universalSimplePoleJetProfile

/-- Evaluation on the regular factors obtained after removing one pole grade from every jet. -/
def universalSimplePoleRegularEval :
    MvPolynomial ℕ ℂ →+* Polynomial UniversalPoleBoundaryRing :=
  MvPolynomial.eval₂Hom
    (Polynomial.C.comp MvPolynomial.C)
    universalSimplePoleRegularProfile

theorem isHomogeneous_eval₂_scale
    {σ : Type*} {e : ℕ} {P : MvPolynomial σ ℂ} (hP : P.IsHomogeneous e)
    {S : Type*} [CommSemiring S] (f : ℂ →+* S) (g : σ → S) (c : S) :
    MvPolynomial.eval₂ f (fun i => c * g i) P =
      c ^ e * MvPolynomial.eval₂ f g P := by
  rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg : ∑ i ∈ d.support, d i = e := by
    by_contra hne
    exact (MvPolynomial.mem_support_iff.mp hd)
      (hP.coeff_eq_zero (by simpa [Finsupp.degree] using hne))
  have hpow : ∏ i ∈ d.support, (c * g i) ^ d i =
      c ^ e * ∏ i ∈ d.support, g i ^ d i := by
    simp_rw [mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
  rw [hpow]
  ac_rfl

/-- A degree-`d` differential polynomial carries a common factor `T^d` in its pole profile. -/
theorem universalSimplePoleProfileEval_factor
    {d : ℕ} {P : MvPolynomial ℕ ℂ} (hP : P.IsHomogeneous d) :
    universalSimplePoleProfileEval P =
      Polynomial.X ^ d * universalSimplePoleRegularEval P := by
  change MvPolynomial.eval₂ _
      (fun j => Polynomial.X * universalSimplePoleRegularProfile j) P = _
  exact isHomogeneous_eval₂_scale hP _ _ _

/-- At grade zero the regular profile substitution is the identity on the boundary-jet ring. -/
theorem universalSimplePoleRegularEval_eval_zero (P : MvPolynomial ℕ ℂ) :
    (universalSimplePoleRegularEval P).eval 0 = P := by
  let lhs : MvPolynomial ℕ ℂ →+* UniversalPoleBoundaryRing :=
    (Polynomial.evalRingHom 0).comp universalSimplePoleRegularEval
  have hlhs : lhs = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [lhs, universalSimplePoleRegularEval]
    · intro j
      simpa [lhs, universalSimplePoleRegularEval] using
        universalSimplePoleRegularProfile_eval_zero j
  exact RingHom.congr_fun hlhs P

/-- **Simple-pole jet-lattice trace.**  On a homogeneous differential polynomial of total
degree `d`, the pole-grade-`d` coefficient is the original polynomial in the independent regular
boundary jets. -/
theorem universalSimplePoleProfileEval_coeff_particleNumber
    {d : ℕ} {P : MvPolynomial ℕ ℂ} (hP : P.IsHomogeneous d) :
    (universalSimplePoleProfileEval P).coeff d = P := by
  rw [universalSimplePoleProfileEval_factor hP]
  calc
    (Polynomial.X ^ d * universalSimplePoleRegularEval P).coeff d =
        (Polynomial.X ^ d * universalSimplePoleRegularEval P).coeff (0 + d) := by rw [zero_add]
    _ = (universalSimplePoleRegularEval P).coeff 0 :=
      Polynomial.coeff_X_pow_mul _ d 0
    _ = P := by
      rw [Polynomial.coeff_zero_eq_eval_zero,
        universalSimplePoleRegularEval_eval_zero]

/-- A nonzero `d`-particle differential observable has a nonzero pole-grade-`d` boundary trace. -/
theorem universalSimplePoleProfileEval_coeff_particleNumber_ne_zero
    {d : ℕ} {P : MvPolynomial ℕ ℂ} (hP : P.IsHomogeneous d) (hP0 : P ≠ 0) :
    (universalSimplePoleProfileEval P).coeff d ≠ 0 := by
  rw [universalSimplePoleProfileEval_coeff_particleNumber hP]
  exact hP0

/-- **Free-boundary selection law.**  Specializing the regular boundary coordinates to any
algebraically independent family preserves the nonzero particle-number trace.  This is the exact
interface used by analytic carriers whose Laurent boundary jets have already been proved free. -/
theorem universalSimplePoleProfileEval_coeff_particleNumber_ne_zero_of_algebraicIndependent
    {A : Type*} [CommRing A] [Algebra ℂ A]
    (a : ℕ → A) (ha : AlgebraicIndependent ℂ a)
    {d : ℕ} {P : MvPolynomial ℕ ℂ} (hP : P.IsHomogeneous d) (hP0 : P ≠ 0) :
    (Polynomial.map (MvPolynomial.aeval a).toRingHom
      (universalSimplePoleProfileEval P)).coeff d ≠ 0 := by
  rw [Polynomial.coeff_map,
    universalSimplePoleProfileEval_coeff_particleNumber hP]
  exact (algebraicIndependent_iff_injective_aeval.mp ha).ne hP0

end

end GaloisForLFunctions.HTGeometry
