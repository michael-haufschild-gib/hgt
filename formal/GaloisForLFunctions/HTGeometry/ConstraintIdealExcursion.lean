import GaloisForLFunctions.HTGeometry.ConstraintCodeCompression

/-!
# Full constraint-ideal sandwiches survive through unphysical excursions

The outer constraint relation `C * L + R * C` is killed by a compression `P` satisfying
`P * C = C * P = 0`.  It is not, in a noncommutative operator algebra, the full two-sided ideal
generated by `C`: a general ideal term has the form `L * C * R`.

This file gives the exact correction.  Compression of `L * C * R` factors through the complement
of the physical sector on both sides of `C`.  Thus the full ideal is invisible precisely when one
of the corresponding transition factors, or the complement compression of `C`, vanishes.  This is
a static code-subspace identity, not a temporal excursion.
-/

namespace HTGeometry

noncomputable section

variable {𝕜 E : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- A constraint annihilated on both physical sides is entirely supported in the complement
corner selected by `1 - P`. -/
theorem constraint_eq_complement_compression
    (P C : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0) :
    (1 - P) * C * (1 - P) = C := by
  noncomm_ring [hPC, hCP]

/-- **Full-ideal excursion identity.**  A general sandwich in the two-sided ideal generated by
`C` survives physical compression only through the complement corner of the constraint. -/
theorem constraintSandwich_compression_eq_complementExcursion
    (P C L R : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0) :
    P * (L * C * R) * P =
      (P * L) * ((1 - P) * C * (1 - P)) * (R * P) := by
  rw [constraint_eq_complement_compression P C hPC hCP]
  simp only [mul_assoc]

/-- The same survivor factors into the transition out of the physical sector, the constraint, and
the transition back into the physical sector. -/
theorem constraintSandwich_compression_eq_transitionExcursion
    (P C L R : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0) :
    P * (L * C * R) * P =
      (P * L * (1 - P)) * C * ((1 - P) * R * P) := by
  have hC := constraint_eq_complement_compression P C hPC hCP
  calc
    P * (L * C * R) * P =
        P * (L * ((1 - P) * C * (1 - P)) * R) * P := by rw [hC]
    _ = (P * L * (1 - P)) * C * ((1 - P) * R * P) := by
      simp only [mul_assoc]

/-- No return from the complement through `L` is sufficient to kill every sandwich with `L` on
the left of the constraint. -/
theorem constraintSandwich_compression_eq_zero_of_noReturn
    (P C L R : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0)
    (hreturn : P * L * (1 - P) = 0) :
    P * (L * C * R) * P = 0 := by
  rw [constraintSandwich_compression_eq_transitionExcursion P C L R hPC hCP,
    hreturn]
  simp

/-- No departure from the physical sector through `R` is sufficient to kill every sandwich with
`R` on the right of the constraint. -/
theorem constraintSandwich_compression_eq_zero_of_noDeparture
    (P C L R : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0)
    (hdepart : (1 - P) * R * P = 0) :
    P * (L * C * R) * P = 0 := by
  rw [constraintSandwich_compression_eq_transitionExcursion P C L R hPC hCP,
    hdepart]
  simp

/-- If the constraint itself vanishes on the unphysical complement, then the full two-sided ideal
is killed by physical compression. -/
theorem constraintSandwich_compression_eq_zero_of_complementConstraint
    (P C L R : E →L[𝕜] E) (hPC : P * C = 0) (hCP : C * P = 0)
    (hcomplement : (1 - P) * C * (1 - P) = 0) :
    P * (L * C * R) * P = 0 := by
  rw [constraintSandwich_compression_eq_complementExcursion P C L R hPC hCP,
    hcomplement, mul_zero, zero_mul]

end

end HTGeometry
