import GaloisForLFunctions.HTGeometry.PolynomialCoefficientLSeries
import Mathlib.NumberTheory.ArithmeticFunction.Misc

open scoped BigOperators

namespace GaloisForLFunctions

noncomputable section

/-- Ordered positive-factor data generated by the divisor antidiagonal recursion. -/
def DirichletFactorData : (q n : ℕ) → Type
  | 0, n => PLift (n = 1)
  | q + 1, n =>
      Σ de : {de : ℕ × ℕ // de ∈ n.divisorsAntidiagonal},
        DirichletFactorData q de.1.2

instance dirichletFactorDataFintype (q n : ℕ) : Fintype (DirichletFactorData q n) := by
  induction q generalizing n with
  | zero =>
      simp only [DirichletFactorData]
      infer_instance
  | succ q ih =>
      simp only [DirichletFactorData]
      letI (de : {de : ℕ × ℕ // de ∈ n.divisorsAntidiagonal}) :
          Fintype (DirichletFactorData q de.1.2) := ih de.1.2
      infer_instance

/-- The ordered factor vector carried by recursive divisor-antidiagonal data. -/
def DirichletFactorData.factors : {q n : ℕ} → DirichletFactorData q n → Fin q → ℕ
  | 0, _, _ => Fin.elim0
  | _ + 1, _, ⟨de, tail⟩ => Fin.cases de.1.1 (DirichletFactorData.factors tail)

theorem DirichletFactorData.prod_factors {q n : ℕ} (d : DirichletFactorData q n) :
    ∏ i, d.factors i = n := by
  induction q generalizing n with
  | zero =>
      rcases d with ⟨h⟩
      simpa [DirichletFactorData] using h.symm
  | succ q ih =>
      rcases d with ⟨de, tail⟩
      rw [Fin.prod_univ_succ]
      change de.1.1 * ∏ i, tail.factors i = n
      rw [ih tail]
      exact (Nat.mem_divisorsAntidiagonal.mp de.2).1

theorem DirichletFactorData.factor_pos {q n : ℕ} (d : DirichletFactorData q n)
    (hn : 0 < n) (i : Fin q) : 0 < d.factors i := by
  have hdvd : d.factors i ∣ ∏ j, d.factors j :=
    Finset.dvd_prod_of_mem d.factors (Finset.mem_univ i)
  rw [d.prod_factors] at hdvd
  exact Nat.pos_of_dvd_of_pos hdvd hn

theorem DirichletFactorData.factors_injective {q n : ℕ} (hn : 0 < n) :
    Function.Injective (DirichletFactorData.factors :
      DirichletFactorData q n → Fin q → ℕ) := by
  induction q generalizing n with
  | zero =>
      intro d e h
      rcases d with ⟨hd⟩
      rcases e with ⟨he⟩
      rfl
  | succ q ih =>
      intro d e h
      rcases d with ⟨de, dtail⟩
      rcases e with ⟨ee, etail⟩
      have hfst : de.1.1 = ee.1.1 := congrFun h 0
      have hdeprod := (Nat.mem_divisorsAntidiagonal.mp de.2).1
      have heprod := (Nat.mem_divisorsAntidiagonal.mp ee.2).1
      have hheadpos : 0 < de.1.1 := by
        have hdvd : de.1.1 ∣ n := ⟨de.1.2, hdeprod.symm⟩
        exact Nat.pos_of_dvd_of_pos hdvd hn
      have hsnd : de.1.2 = ee.1.2 := by
        apply Nat.eq_of_mul_eq_mul_left hheadpos
        calc
          de.1.1 * de.1.2 = n := hdeprod
          _ = ee.1.1 * ee.1.2 := heprod.symm
          _ = de.1.1 * ee.1.2 := by rw [hfst]
      have hde : de = ee := by
        apply Subtype.ext
        exact Prod.ext hfst hsnd
      subst ee
      have htail : dtail.factors = etail.factors := by
        funext i
        exact congrFun h i.succ
      have htailprodpos : 0 < de.1.2 := by
        have hdvd : de.1.2 ∣ n := ⟨de.1.1, by simpa [mul_comm] using hdeprod.symm⟩
        exact Nat.pos_of_dvd_of_pos hdvd hn
      have := ih htailprodpos htail
      subst etail
      rfl

/-- Distinct positive integers have product at least the factorial of their cardinality. -/
theorem factorial_le_fin_prod_of_injective {q : ℕ} (v : Fin q → ℕ)
    (hpos : ∀ i, 0 < v i) (hinj : Function.Injective v) :
    q.factorial ≤ ∏ i, v i := by
  let s : Finset ℕ := Finset.univ.image v
  have hcard : s.card = q := by
    change (Finset.univ.image v).card = q
    rw [Finset.card_image_iff.mpr]
    · simp
    · intro i hi j hj hij
      exact hinj hij
  let e : Fin q ≃o s := s.orderIsoOfFin hcard
  have hepos (i : Fin q) : 0 < (e i : ℕ) := by
    have hi : (e i : ℕ) ∈ s := (e i).2
    change (e i : ℕ) ∈ Finset.univ.image v at hi
    rw [Finset.mem_image] at hi
    obtain ⟨j, hj, hje⟩ := hi
    simpa [← hje] using hpos j
  have hpoint : ∀ i : Fin q, (i : ℕ) + 1 ≤ (e i : ℕ) := by
    intro i
    generalize hm : (i : ℕ) = m
    induction m generalizing i with
    | zero =>
        have := hepos i
        omega
    | succ m ih =>
        let j : Fin q := ⟨m, by omega⟩
        have hj : (j : ℕ) + 1 ≤ (e j : ℕ) := ih j rfl
        change m + 1 ≤ (e j : ℕ) at hj
        have hji : j < i := by
          rw [Fin.lt_def]
          simp [j, hm]
        have hlt : (e j : ℕ) < (e i : ℕ) := (e.lt_iff_lt).2 hji
        omega
  have hprodle : (∏ i : Fin q, ((i : ℕ) + 1)) ≤ ∏ i : Fin q, (e i : ℕ) := by
    exact Finset.prod_le_prod (s := (Finset.univ : Finset (Fin q)))
        (fun i hi => Nat.zero_le ((i : ℕ) + 1))
        (fun i hi => hpoint i)
  have hprodE : (∏ i : Fin q, (e i : ℕ)) = ∏ i : Fin q, v i := by
    calc
      (∏ i : Fin q, (e i : ℕ)) = ∏ x : s, (x : ℕ) := e.toEquiv.prod_comp _
      _ = ∏ x ∈ s, x := by simpa using (Finset.prod_attach s id)
      _ = ∏ i ∈ Finset.univ, v i :=
        Finset.prod_image (by
          intro i hi j hj hij
          exact hinj hij)
      _ = ∏ i : Fin q, v i := by simp
  rw [hprodE] at hprodle
  calc
    q.factorial = ∏ k ∈ Finset.range q, (k + 1) :=
      (Finset.prod_range_add_one_eq_factorial q).symm
    _ = (∏ i : Fin q, ((i : ℕ) + 1)) :=
      (Fin.prod_univ_eq_prod_range (fun k => k + 1) q).symm
    _ ≤ ∏ i : Fin q, v i := by exact hprodle

/-- Equality in the factorial product bound forces the initial packet, up to permutation. -/
theorem exists_perm_eq_add_one_of_fin_prod_eq_factorial {q : ℕ} (v : Fin q → ℕ)
    (hpos : ∀ i, 0 < v i) (hinj : Function.Injective v)
    (hprod : (∏ i, v i) = q.factorial) :
    ∃ σ : Equiv.Perm (Fin q), ∀ i, v i = (σ i : ℕ) + 1 := by
  let s : Finset ℕ := Finset.univ.image v
  have hcard : s.card = q := by
    change (Finset.univ.image v).card = q
    rw [Finset.card_image_iff.mpr]
    · simp
    · intro i hi j hj hij
      exact hinj hij
  let e : Fin q ≃o s := s.orderIsoOfFin hcard
  have hepos (i : Fin q) : 0 < (e i : ℕ) := by
    have hi : (e i : ℕ) ∈ s := (e i).2
    change (e i : ℕ) ∈ Finset.univ.image v at hi
    rw [Finset.mem_image] at hi
    obtain ⟨j, hj, hje⟩ := hi
    simpa [← hje] using hpos j
  have hpoint : ∀ i : Fin q, (i : ℕ) + 1 ≤ (e i : ℕ) := by
    intro i
    generalize hm : (i : ℕ) = m
    induction m generalizing i with
    | zero =>
        have := hepos i
        omega
    | succ m ih =>
        let j : Fin q := ⟨m, by omega⟩
        have hj : (j : ℕ) + 1 ≤ (e j : ℕ) := ih j rfl
        change m + 1 ≤ (e j : ℕ) at hj
        have hji : j < i := by
          rw [Fin.lt_def]
          simp [j, hm]
        have hlt : (e j : ℕ) < (e i : ℕ) := (e.lt_iff_lt).2 hji
        omega
  have hprodE : (∏ i : Fin q, (e i : ℕ)) = ∏ i : Fin q, v i := by
    calc
      (∏ i : Fin q, (e i : ℕ)) = ∏ x : s, (x : ℕ) := e.toEquiv.prod_comp _
      _ = ∏ x ∈ s, x := by simpa using (Finset.prod_attach s id)
      _ = ∏ i ∈ Finset.univ, v i :=
        Finset.prod_image (by
          intro i hi j hj hij
          exact hinj hij)
      _ = ∏ i : Fin q, v i := by simp
  have hbaseprod : (∏ i : Fin q, ((i : ℕ) + 1)) = q.factorial := by
    calc
      (∏ i : Fin q, ((i : ℕ) + 1)) = ∏ k ∈ Finset.range q, (k + 1) :=
        Fin.prod_univ_eq_prod_range (fun k => k + 1) q
      _ = q.factorial := Finset.prod_range_add_one_eq_factorial q
  have heqpoint (i : Fin q) : (e i : ℕ) = (i : ℕ) + 1 := by
    apply Nat.le_antisymm
    · by_contra hnot
      have hstrict : (i : ℕ) + 1 < (e i : ℕ) := Nat.lt_of_not_ge hnot
      have hprodlt : (∏ j : Fin q, ((j : ℕ) + 1)) < ∏ j : Fin q, (e j : ℕ) := by
        exact Finset.prod_lt_prod
          (fun j hj => by omega)
          (fun j hj => hpoint j)
          ⟨i, Finset.mem_univ i, hstrict⟩
      rw [hbaseprod, hprodE, hprod] at hprodlt
      exact (Nat.lt_irrefl q.factorial) hprodlt
    · exact hpoint i
  let f : Fin q → s := fun i => ⟨v i, by simp [s]⟩
  have hfinj : Function.Injective f := by
    intro i j hij
    exact hinj (congrArg Subtype.val hij)
  have hfcard : Fintype.card (Fin q) = Fintype.card s := by
    simp [hcard]
  have hfbij : Function.Bijective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hfinj, hfcard⟩
  let vf : Fin q ≃ s := Equiv.ofBijective f hfbij
  let σ : Equiv.Perm (Fin q) := vf.trans e.symm
  refine ⟨σ, fun i => ?_⟩
  have hecomp : e (σ i) = vf i := by
    simp [σ]
  change (vf i : ℕ) = (σ i : ℕ) + 1
  rw [← heqpoint (σ i)]
  exact congrArg Subtype.val hecomp.symm

theorem exists_dirichletFactorData_factors_eq {q n : ℕ} (v : Fin q → ℕ)
    (hpos : ∀ i, 0 < v i) (hprod : (∏ i, v i) = n) :
    ∃ d : DirichletFactorData q n, d.factors = v := by
  induction q generalizing n with
  | zero =>
      have hn : n = 1 := by simpa using hprod.symm
      refine ⟨⟨hn⟩, ?_⟩
      funext i
      exact Fin.elim0 i
  | succ q ih =>
      let tail : Fin q → ℕ := fun i => v i.succ
      let m : ℕ := ∏ i, tail i
      have hfactor : v 0 * m = n := by
        rw [← hprod, Fin.prod_univ_succ]
      have hn : n ≠ 0 := by
        rw [← hprod]
        exact Finset.prod_ne_zero_iff.mpr (fun i hi => (hpos i).ne')
      let de : {de : ℕ × ℕ // de ∈ n.divisorsAntidiagonal} :=
        ⟨(v 0, m), Nat.mem_divisorsAntidiagonal.mpr ⟨hfactor, hn⟩⟩
      have htailpos : ∀ i, 0 < tail i := fun i => hpos i.succ
      obtain ⟨d, hd⟩ := ih tail htailpos rfl
      refine ⟨⟨de, d⟩, ?_⟩
      funext i
      induction i using Fin.cases with
      | zero => rfl
      | succ i =>
          change d.factors i = tail i
          exact congrFun hd i

def initialDirichletFactorData (q : ℕ) (σ : Equiv.Perm (Fin q)) :
    DirichletFactorData q q.factorial :=
  Classical.choose (exists_dirichletFactorData_factors_eq
    (fun i => (σ i : ℕ) + 1) (fun i => Nat.succ_pos _) (by
      calc
        (∏ i : Fin q, ((σ i : ℕ) + 1)) = ∏ i : Fin q, ((i : ℕ) + 1) :=
          Equiv.prod_comp σ (fun i => (i : ℕ) + 1)
        _ = ∏ k ∈ Finset.range q, (k + 1) :=
          Fin.prod_univ_eq_prod_range (fun k => k + 1) q
        _ = q.factorial := Finset.prod_range_add_one_eq_factorial q))

@[simp] theorem initialDirichletFactorData_factors (q : ℕ)
    (σ : Equiv.Perm (Fin q)) :
    (initialDirichletFactorData q σ).factors = fun i => (σ i : ℕ) + 1 :=
  Classical.choose_spec (exists_dirichletFactorData_factors_eq
    (fun i => (σ i : ℕ) + 1) (fun i => Nat.succ_pos _) (by
      calc
        (∏ i : Fin q, ((σ i : ℕ) + 1)) = ∏ i : Fin q, ((i : ℕ) + 1) :=
          Equiv.prod_comp σ (fun i => (i : ℕ) + 1)
        _ = ∏ k ∈ Finset.range q, (k + 1) :=
          Fin.prod_univ_eq_prod_range (fun k => k + 1) q
        _ = q.factorial := Finset.prod_range_add_one_eq_factorial q))

/-- Ordered factorizations of `q!` with distinct factors are exactly permutations of
`1, ..., q`. -/
def initialDirichletFactorDataEquiv (q : ℕ) :
    Equiv.Perm (Fin q) ≃
      {d : DirichletFactorData q q.factorial // Function.Injective d.factors} :=
  Equiv.ofBijective
    (fun σ => ⟨initialDirichletFactorData q σ, by
      rw [initialDirichletFactorData_factors]
      intro i j hij
      apply σ.injective
      apply Fin.ext
      exact Nat.add_right_cancel hij⟩)
    ⟨by
      intro σ τ h
      apply Equiv.ext
      intro i
      have hf := congrFun (congrArg
        (fun d : {d : DirichletFactorData q q.factorial // Function.Injective d.factors} =>
          d.1.factors) h) i
      simp only [initialDirichletFactorData_factors] at hf
      exact Fin.ext (Nat.add_right_cancel hf), by
      intro d
      have hfacpos : ∀ i, 0 < d.1.factors i := fun i =>
        d.1.factor_pos (Nat.factorial_pos q) i
      obtain ⟨σ, hσ⟩ := exists_perm_eq_add_one_of_fin_prod_eq_factorial
        d.1.factors hfacpos d.2 d.1.prod_factors
      refine ⟨σ, Subtype.ext ?_⟩
      apply DirichletFactorData.factors_injective (Nat.factorial_pos q)
      rw [initialDirichletFactorData_factors]
      funext i
      exact (hσ i).symm⟩

/-- Coefficient of a finite Dirichlet-convolution product as an ordered factor sum. -/
theorem arithmeticFunction_fin_prod_apply {R : Type*} [CommRing R]
    (q n : ℕ) (f : Fin q → ArithmeticFunction R) :
    (∏ i, f i) n =
      ∑ d : DirichletFactorData q n, ∏ i, f i (d.factors i) := by
  induction q generalizing n with
  | zero =>
      by_cases hn : n = 1
      · subst n
        simp [DirichletFactorData, DirichletFactorData.factors]
      · haveI : IsEmpty (PLift (n = 1)) :=
          ⟨fun h => hn h.down⟩
        simp [DirichletFactorData, hn]
  | succ q ih =>
      rw [Fin.prod_univ_succ, ArithmeticFunction.mul_apply]
      change (∑ de ∈ n.divisorsAntidiagonal,
          f 0 de.1 * (∏ i : Fin q, f i.succ) de.2) =
        ∑ d : (Σ de : {de : ℕ × ℕ // de ∈ n.divisorsAntidiagonal},
          DirichletFactorData q de.1.2),
          ∏ i, f i
            (DirichletFactorData.factors (q := q + 1) (n := n) d i)
      rw [Fintype.sum_sigma]
      simp_rw [Fin.prod_univ_succ]
      simp_rw [DirichletFactorData.factors]
      simp_rw [Fin.cases_zero, Fin.cases_succ]
      rw [← Finset.sum_subtype n.divisorsAntidiagonal (fun _ => Iff.rfl)
        (fun de => ∑ tail : DirichletFactorData q de.2,
          f 0 de.1 * ∏ i, f i.succ (DirichletFactorData.factors tail i))]
      apply Finset.sum_congr rfl
      intro de hde
      rw [ih]
      rw [Finset.mul_sum]

/-- Dirichlet Cauchy--Binet coefficient formula for a square matrix of arithmetic functions. -/
theorem arithmeticFunction_det_apply {R : Type*} [CommRing R] (q n : ℕ)
    (M : Matrix (Fin q) (Fin q) (ArithmeticFunction R)) :
    M.det n =
      ∑ d : DirichletFactorData q n,
        Matrix.det (fun i j => M i j (d.factors j)) := by
  let ev : ArithmeticFunction R →+ R :=
    { toFun := fun f : ArithmeticFunction R => f n
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  change ev M.det = _
  rw [Matrix.det_apply, map_sum]
  calc
    (∑ σ, ev (Equiv.Perm.sign σ • ∏ i, M (σ i) i)) =
        ∑ σ, Equiv.Perm.sign σ • (∏ i, M (σ i) i) n := by
      apply Finset.sum_congr rfl
      intro σ hσ
      change ev (Equiv.Perm.sign σ • ∏ i, M (σ i) i) =
        Equiv.Perm.sign σ • ev (∏ i, M (σ i) i)
      exact ev.map_zsmul (Equiv.Perm.sign σ) (∏ i, M (σ i) i)
    _ = _ := by
      simp_rw [arithmeticFunction_fin_prod_apply]
      simp_rw [Finset.smul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro d hd
      rw [Matrix.det_apply]

end
