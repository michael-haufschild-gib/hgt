import GaloisForLFunctions.HTGeometry.MeromorphicPlaneAlgebra
import GaloisForLFunctions.HTGeometry.EllipticFunctionFieldWeierstrass

/-!
# The elliptic subfield of the meromorphic plane field is generated by `℘` and `℘'`

Inside the field of meromorphic functions on the plane, the elements invariant under every
translation by a period lattice form an intermediate field over the constants: the elliptic
functions of that lattice.  The structure theorem identifies it exactly:

`ellipticSubfield L = ℂ⟮℘[L], ℘'[L]⟯`.

Germ invariance is turned into pointwise periodicity by passing to the canonical meromorphic normal
form, which represents the same germ and is periodic on the nose.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

variable (L : PeriodPair)

/-- **Germ periodicity becomes pointwise periodicity in normal form.** -/
theorem periodic_toMeromorphicNFOn_of_eventuallyEq {f : ℂ → ℂ} (hf : ∀ z, MeromorphicAt f z)
    {p : ℂ} (hp : ∀ x : ℂ, (fun w => f (w + p)) =ᶠ[𝓝[≠] x] f) :
    Function.Periodic (toMeromorphicNFOn f Set.univ) p := by
  have hfOn : MeromorphicOn f Set.univ := fun z _ => hf z
  set F : ℂ → ℂ := toMeromorphicNFOn f Set.univ with hFdef
  have hFNF : MeromorphicNFOn F Set.univ := meromorphicNFOn_toMeromorphicNFOn f Set.univ
  have hFeq : ∀ z : ℂ, F =ᶠ[𝓝[≠] z] f := fun z =>
    hfOn.toMeromorphicNFOn_eq_self_on_nhdsNE (Set.mem_univ z)
  intro z
  have htrans : Tendsto (fun w : ℂ => w + p) (𝓝[≠] z) (𝓝[≠] (z + p)) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · exact ((by fun_prop : Continuous fun w : ℂ => w + p).tendsto z).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with w hw
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      intro hcon
      exact hw (by simpa using add_right_cancel hcon)
  have h1 : (fun w : ℂ => F (w + p)) =ᶠ[𝓝[≠] z] fun w : ℂ => f (w + p) :=
    htrans.eventually (hFeq (z + p))
  have h3 : (fun w : ℂ => F (w + p)) =ᶠ[𝓝[≠] z] F :=
    (h1.trans (hp z)).trans (hFeq z).symm
  have hNF1 : MeromorphicNFAt (fun w : ℂ => F (w + p)) z := by
    have hcomp : MeromorphicNFAt (F ∘ fun w : ℂ => w + p) z :=
      MeromorphicNFAt.comp_analyticAt (f := F) (g := fun w : ℂ => w + p)
        (hFNF (Set.mem_univ (z + p))) (by fun_prop)
    exact hcomp
  have hNF2 : MeromorphicNFAt F z := hFNF (Set.mem_univ z)
  exact ((hNF1.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds hNF2).mp h3).eq_of_nhds

theorem meromorphicAt_toMeromorphicNFOn {f : ℂ → ℂ} (_hf : ∀ z, MeromorphicAt f z) (z : ℂ) :
    MeromorphicAt (toMeromorphicNFOn f Set.univ) z :=
  (meromorphicNFOn_toMeromorphicNFOn f Set.univ (Set.mem_univ z)).meromorphicAt

theorem ofMeromorphic_toMeromorphicNFOn {f : ℂ → ℂ} (hf : ∀ z, MeromorphicAt f z) :
    ofMeromorphic (toMeromorphicNFOn f Set.univ) (meromorphicAt_toMeromorphicNFOn hf)
      = ofMeromorphic f hf := by
  have hfOn : MeromorphicOn f Set.univ := fun z _ => hf z
  refine (ofMeromorphic_eq_iff _ _).mpr fun x => ?_
  exact hfOn.toMeromorphicNFOn_eq_self_on_nhdsNE (Set.mem_univ x)

/-- The elliptic functions of a period lattice, as an intermediate field of the meromorphic plane
field over the constants. -/
noncomputable def ellipticSubfield : IntermediateField ℂ MeromorphicPlane where
  carrier := {x : MeromorphicPlane | ∀ p ∈ L.lattice, planeTranslate p x = x}
  zero_mem' := by
    intro p _
    have : (0 : MeromorphicPlane) = ofMeromorphic (0 : ℂ → ℂ) (fun z => MeromorphicAt.const 0 z) :=
      rfl
    rw [this, planeTranslate_ofMeromorphic]
    rfl
  one_mem' := fun p _ => planeTranslate_one p
  add_mem' := by
    intro x y hx hy p hp
    rw [planeTranslate_map_add, hx p hp, hy p hp]
  mul_mem' := by
    intro x y hx hy p hp
    rw [planeTranslate_map_mul, hx p hp, hy p hp]
  inv_mem' := by
    intro x hx p hp
    have hinv := map_inv₀ (planeTranslateEquiv p) x
    simp only [planeTranslateEquiv_apply] at hinv
    rw [hinv, hx p hp]
  algebraMap_mem' := by
    intro c p _
    rw [algebraMap_plane, planeTranslate_ofMeromorphic]

theorem mem_ellipticSubfield_iff {x : MeromorphicPlane} :
    x ∈ ellipticSubfield L ↔ ∀ p ∈ L.lattice, planeTranslate p x = x := Iff.rfl

theorem weierstrassPElement_mem : weierstrassPElement L ∈ ellipticSubfield L := by
  intro p hp
  rw [weierstrassPElement, planeTranslate_ofMeromorphic]
  refine (ofMeromorphic_eq_iff _ _).mpr fun x => ?_
  refine Filter.Eventually.of_forall fun z => ?_
  exact weierstrassP_periodic L hp z

theorem derivWeierstrassPElement_mem : derivWeierstrassPElement L ∈ ellipticSubfield L := by
  intro p hp
  rw [derivWeierstrassPElement, planeTranslate_ofMeromorphic]
  refine (ofMeromorphic_eq_iff _ _).mpr fun x => ?_
  refine Filter.Eventually.of_forall fun z => ?_
  exact L.periodic_derivWeierstrassP ⟨p, hp⟩ z

/-- **`℘` is transcendental over the constants.**  It is unbounded near a lattice point, while a
nonzero polynomial has only finitely many roots. -/
theorem eval_weierstrassP_ne_zero {P : Polynomial ℂ} (hP : P ≠ 0) :
    ofMeromorphic (fun z => P.eval (L.weierstrassP z))
      (meromorphicAt_polyEval L.meromorphic_weierstrassP P) ≠ 0 := by
  intro hzero
  have hev : ∀ᶠ z in 𝓝[≠] (0 : ℂ), P.eval (L.weierstrassP z) = 0 := by
    have := (ofMeromorphic_eq_iff (f := fun z => P.eval (L.weierstrassP z))
      (g := (0 : ℂ → ℂ)) (meromorphicAt_polyEval L.meromorphic_weierstrassP P)
      (fun z => MeromorphicAt.const 0 z)).mp hzero 0
    filter_upwards [this] with z hz using hz
  have hroots : {c : ℂ | P.eval c = 0}.Finite := by
    have hsub : {c : ℂ | P.eval c = 0} ⊆ ↑P.roots.toFinset := by
      intro c hc
      simp only [Finset.mem_coe, Multiset.mem_toFinset]
      exact Polynomial.mem_roots'.mpr ⟨hP, hc⟩
    exact Set.Finite.subset (P.roots.toFinset).finite_toSet hsub
  obtain ⟨R, hR⟩ := hroots.isBounded.subset_closedBall 0
  have hpole : meromorphicOrderAt L.weierstrassP 0 < 0 := by
    rw [L.order_weierstrassP 0 (zero_mem_lattice L)]
    have h2 : ((-2 : ℤ) : WithTop ℤ) < ((0 : ℤ) : WithTop ℤ) := by
      exact_mod_cast (by norm_num : (-2 : ℤ) < 0)
    simpa using h2
  have htend := tendsto_cobounded_of_meromorphicOrderAt_neg (f := L.weierstrassP) (x := (0 : ℂ))
    hpole
  have hcompl : (Metric.closedBall (0 : ℂ) R)ᶜ ∈ Bornology.cobounded ℂ :=
    Bornology.IsBounded.compl Metric.isBounded_closedBall
  have hbig : ∀ᶠ z in 𝓝[≠] (0 : ℂ), L.weierstrassP z ∈ (Metric.closedBall (0 : ℂ) R)ᶜ :=
    htend hcompl
  obtain ⟨z, hz1, hz2⟩ := (hev.and hbig).exists
  exact hz2 (hR hz1)

/-- Polynomials in an element of an intermediate field stay inside it. -/
theorem aeval_mem_intermediateField {S : IntermediateField ℂ MeromorphicPlane}
    {x : MeromorphicPlane} (hx : x ∈ S) (P : Polynomial ℂ) : Polynomial.aeval x P ∈ S := by
  classical
  induction P using Polynomial.induction_on with
  | C a =>
      simp only [Polynomial.aeval_C]
      exact S.algebraMap_mem a
  | add p q hp hq =>
      simpa using add_mem hp hq
  | monomial n a _ =>
      simpa using mul_mem (S.algebraMap_mem a) (pow_mem hx (n + 1))

/-- **The elliptic functions of a lattice are exactly the rational functions of `℘` and `℘'`.** -/
theorem ellipticSubfield_eq_adjoin :
    ellipticSubfield L
      = IntermediateField.adjoin ℂ {weierstrassPElement L, derivWeierstrassPElement L} := by
  refine le_antisymm ?_ ?_
  · intro x hx
    obtain ⟨f, hf, rfl⟩ := x.exists_rep
    have hgerm : ∀ p ∈ L.lattice, ∀ y : ℂ, (fun w => f (w + p)) =ᶠ[𝓝[≠] y] f := by
      intro p hp
      have hxp := hx p hp
      rw [planeTranslate_ofMeromorphic] at hxp
      exact (ofMeromorphic_eq_iff _ _).mp hxp
    have hFmer := meromorphicAt_toMeromorphicNFOn hf
    have hFper : ∀ p ∈ L.lattice, Function.Periodic (toMeromorphicNFOn f Set.univ) p :=
      fun p hp => periodic_toMeromorphicNFOn_of_eventuallyEq hf (hgerm p hp)
    obtain ⟨A, B, C, hC, hrep⟩ :=
      exists_rational_weierstrass_representation L hFmer hFper
    have hCne : Polynomial.aeval (weierstrassPElement L) C ≠ 0 := by
      rw [weierstrassPElement, aeval_ofMeromorphic]
      exact eval_weierstrassP_ne_zero L hC.ne_zero
    have hid : ofMeromorphic (toMeromorphicNFOn f Set.univ) hFmer
          * Polynomial.aeval (weierstrassPElement L) C
        = Polynomial.aeval (weierstrassPElement L) A
          + derivWeierstrassPElement L * Polynomial.aeval (weierstrassPElement L) B := by
      rw [weierstrassPElement, aeval_ofMeromorphic, aeval_ofMeromorphic, aeval_ofMeromorphic,
        ofMeromorphic_mul, derivWeierstrassPElement, ofMeromorphic_mul, ofMeromorphic_add]
      exact (ofMeromorphic_eq_iff _ _).mpr hrep
    have hval : ofMeromorphic (toMeromorphicNFOn f Set.univ) hFmer
        = (Polynomial.aeval (weierstrassPElement L) A
            + derivWeierstrassPElement L * Polynomial.aeval (weierstrassPElement L) B)
          / Polynomial.aeval (weierstrassPElement L) C := by
      rw [eq_div_iff hCne]
      exact hid
    rw [← ofMeromorphic_toMeromorphicNFOn hf, hval]
    have hPmem : weierstrassPElement L
        ∈ IntermediateField.adjoin ℂ {weierstrassPElement L, derivWeierstrassPElement L} :=
      IntermediateField.subset_adjoin ℂ _ (by simp)
    have hQmem : derivWeierstrassPElement L
        ∈ IntermediateField.adjoin ℂ {weierstrassPElement L, derivWeierstrassPElement L} :=
      IntermediateField.subset_adjoin ℂ _ (by simp)
    exact div_mem (add_mem (aeval_mem_intermediateField hPmem A)
      (mul_mem hQmem (aeval_mem_intermediateField hPmem B)))
      (aeval_mem_intermediateField hPmem C)
  · rw [IntermediateField.adjoin_le_iff]
    intro y hy
    rcases hy with hy | hy
    · rw [hy]
      exact weierstrassPElement_mem L
    · rw [Set.mem_singleton_iff.mp hy]
      exact derivWeierstrassPElement_mem L

end GaloisForLFunctions.HTGeometry
