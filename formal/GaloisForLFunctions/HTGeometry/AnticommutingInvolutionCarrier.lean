import GaloisForLFunctions.HTGeometry.ScalarSquareExponential

/-!
# Real combinations of pairwise anticommuting involutions

A real combination of a finite family of pairwise anticommuting elements, each squaring to one,
squares to the sum of the squared coefficients.  The cross terms cancel in pairs: swapping the two
summation indices is an involution of the off-diagonal index set that negates every summand.

Consequently the one-parameter group generated by such a combination is an exact cosine–sine pair,
and every sphere of radius in `2πℤ` returns to the identity.  This is the exact refocusing carrier
of a pairwise anticommuting family.
-/

open scoped BigOperators

namespace HTGeometry

/-- The real combination of a family indexed by a finite set. -/
def anticommutingCombination {R : Type*} [Ring R] [Algebra ℂ R] {ι : Type*}
    (S : Finset ι) (P : ι → R) (a : ι → ℝ) : R :=
  ∑ p ∈ S, ((a p : ℝ) : ℂ) • P p

section Square

variable {R : Type*} [Ring R] [Algebra ℂ R] {ι : Type*}

/-- **The square of a real combination of pairwise anticommuting involutions is the squared
Euclidean length.**  Every cross term is cancelled by its transpose. -/
theorem anticommutingCombination_mul_self (S : Finset ι) (P : ι → R) (a : ι → ℝ)
    (hsq : ∀ p ∈ S, P p * P p = 1)
    (hanti : ∀ p ∈ S, ∀ r ∈ S, p ≠ r → P p * P r + P r * P p = 0) :
    anticommutingCombination S P a * anticommutingCombination S P a
      = (((∑ p ∈ S, a p ^ (2 : ℕ) : ℝ) : ℂ)) • (1 : R) := by
  classical
  set f : ι → ι → R := fun p r => (((a p : ℝ) : ℂ) * ((a r : ℝ) : ℂ)) • (P p * P r) with hf
  have hexpand : anticommutingCombination S P a * anticommutingCombination S P a
      = ∑ p ∈ S, ∑ r ∈ S, f p r := by
    rw [anticommutingCombination, Finset.sum_mul_sum]
    exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun r _ =>
      smul_mul_smul_comm _ _ _ _
  set T : R := ∑ p ∈ S, ∑ r ∈ S.erase p, f p r with hT
  have hTcomm : T = ∑ p ∈ S, ∑ r ∈ S.erase p, f r p := by
    rw [hT]
    refine Finset.sum_comm' ?_
    intro p r
    simp only [Finset.mem_erase]
    constructor
    · rintro ⟨hp, hrp, hr⟩
      exact ⟨⟨fun h => hrp h.symm, hp⟩, hr⟩
    · rintro ⟨⟨hpr, hp⟩, hr⟩
      exact ⟨hp, fun h => hpr h.symm, hr⟩
  have hTzero : T = 0 := by
    have h2 : T + T = 0 := by
      nth_rewrite 2 [hTcomm]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_eq_zero fun p hp => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_eq_zero fun r hr => ?_
      have hrS : r ∈ S := Finset.mem_of_mem_erase hr
      have hne : p ≠ r := fun h => (Finset.ne_of_mem_erase hr) h.symm
      rw [hf]
      simp only
      rw [mul_comm (((a r : ℝ) : ℂ)) (((a p : ℝ) : ℂ)), ← smul_add,
        hanti p hp r hrS hne, smul_zero]
    have hhalf := congrArg (fun x : R => ((2 : ℂ)⁻¹) • x) h2
    simpa [← two_smul ℂ T, smul_smul] using hhalf
  have hsplit : ∀ p ∈ S, ∑ r ∈ S, f p r
      = ((((a p : ℝ) : ℂ) * ((a p : ℝ) : ℂ)) • (1 : R)) + ∑ r ∈ S.erase p, f p r := by
    intro p hp
    rw [← Finset.add_sum_erase S (fun r => f p r) hp]
    congr 1
    rw [hf]
    simp only
    rw [hsq p hp]
  rw [hexpand, Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, ← hT, hTzero, add_zero,
    ← Finset.sum_smul]
  congr 1
  push_cast
  exact Finset.sum_congr rfl fun p _ => (sq ((a p : ℝ) : ℂ)).symm

end Square

section Exponential

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A] {ι : Type*}

/-- **The exact refocusing law of an anticommuting carrier.**  The unitary generated by a real
combination of pairwise anticommuting involutions is a cosine–sine pair in the combination, with the
Euclidean length of the coefficients as its angle. -/
theorem exp_neg_I_smul_anticommutingCombination (S : Finset ι) (P : ι → A) (a : ι → ℝ)
    (hsq : ∀ p ∈ S, P p * P p = 1)
    (hanti : ∀ p ∈ S, ∀ r ∈ S, p ≠ r → P p * P r + P r * P p = 0) :
    NormedSpace.exp ((-Complex.I) • anticommutingCombination S P a)
      = ((Real.cos (Real.sqrt (∑ p ∈ S, a p ^ (2 : ℕ))) : ℝ) : ℂ) • (1 : A)
        - (Complex.I * ((Real.sinc (Real.sqrt (∑ p ∈ S, a p ^ (2 : ℕ))) : ℝ) : ℂ))
            • anticommutingCombination S P a := by
  set K : A := anticommutingCombination S P a with hK
  set r : ℝ := Real.sqrt (∑ p ∈ S, a p ^ (2 : ℕ)) with hr
  have hnn : (0 : ℝ) ≤ ∑ p ∈ S, a p ^ (2 : ℕ) := Finset.sum_nonneg fun p _ => sq_nonneg _
  have hrsq : (r : ℝ) ^ (2 : ℕ) = ∑ p ∈ S, a p ^ (2 : ℕ) := Real.sq_sqrt hnn
  have hMsq : ((-Complex.I) • K) * ((-Complex.I) • K) = (-((r : ℂ) ^ (2 : ℕ))) • (1 : A) := by
    rw [smul_mul_smul_comm, hK, anticommutingCombination_mul_self S P a hsq hanti, smul_smul]
    congr 1
    rw [← hrsq]
    push_cast
    rw [neg_mul_neg, Complex.I_mul_I]
    ring
  rw [exp_of_mul_self_eq_neg_sq_smul_one ((-Complex.I) • K) r hMsq, smul_smul]
  rw [sub_eq_add_neg]
  congr 1
  rw [← neg_smul]
  congr 1
  ring

end Exponential

end HTGeometry
