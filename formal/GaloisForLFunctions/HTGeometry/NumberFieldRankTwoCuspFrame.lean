import GaloisForLFunctions.HTGeometry.NumberFieldRankTwoFiniteCuspNormalization
import GaloisForLFunctions.HTGeometry.FractionalIdealPrincipalMul

/-!
# Rank-two cusp frames over a number ring

For a nonzero vector `v = (v₀,v₁)`, its coordinate ideal `I` is invertible.  Expanding
`I I⁻¹ = 1` against the two displayed generators produces dual coordinates `p,q ∈ I⁻¹` with
`v₀p + v₁q = 1`.  The columns `(v₀,v₁)` and `(-q,p)` therefore form a determinant-one matrix over
the number field, with the two columns carrying the complementary fractional ideals `I` and
`I⁻¹`.  These pseudo-basis frames are the algebraic coordinates for finite cusp reduction.
-/

namespace GaloisForLFunctions.HTGeometry

open NumberField
open scoped Classical NumberField

noncomputable section

/-- Fractional-ideal multiplication distributes over a binary join.  The usual ordered-group
lemma does not apply directly because fractional ideals include zero, so this proof works on the
underlying submodules. -/
theorem fractionalIdeal_sup_mul
    {R F : Type*} [CommRing R] [Field F] [Algebra R F] [IsFractionRing R F]
    (A B C : FractionalIdeal (nonZeroDivisors R) F) :
    (A ⊔ B) * C = A * C ⊔ B * C := by
  apply le_antisymm
  · change (↑((A ⊔ B) * C) : Submodule R F) ≤
      (↑(A * C ⊔ B * C) : Submodule R F)
    rw [FractionalIdeal.coe_mul, FractionalIdeal.coe_sup, Submodule.mul_le]
    intro x hx y hy
    rw [Submodule.mem_sup] at hx
    obtain ⟨a, ha, b, hb, hab⟩ := hx
    rw [FractionalIdeal.coe_sup, Submodule.mem_sup]
    refine ⟨a * y, ?_, b * y, ?_, ?_⟩
    · rw [FractionalIdeal.coe_mul]
      exact Submodule.mul_mem_mul ha hy
    · rw [FractionalIdeal.coe_mul]
      exact Submodule.mul_mem_mul hb hy
    · rw [← add_mul, hab]
  · exact sup_le (mul_le_mul_left le_sup_left C)
      (mul_le_mul_left le_sup_right C)

variable (K : Type*) [Field K] [NumberField K]

/-- Each displayed coordinate belongs to the fractional ideal generated by the pair. -/
theorem numberFieldRankTwo_mem_coordinateIdeal
    (v : Fin 2 → K) (i : Fin 2) :
    v i ∈ numberFieldRankTwoCoordinateIdeal K v := by
  fin_cases i
  · exact (le_sup_left :
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ≤
        numberFieldRankTwoCoordinateIdeal K v) <| by
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨1, by simp⟩
  · exact (le_sup_right :
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1) ≤
        numberFieldRankTwoCoordinateIdeal K v) <| by
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨1, by simp⟩

/-- The two displayed generators of a nonzero rank-two coordinate ideal admit dual coordinates in
the inverse ideal whose pairing is one. -/
theorem exists_numberFieldRankTwoCuspDual
    (v : Fin 2 → K) (hv : v ≠ 0) :
    let Iu := numberFieldRankTwoCoordinateIdealUnit K v hv
    let J : FractionalIdeal (nonZeroDivisors (𝓞 K)) K := Iu⁻¹
    ∃ p q : K, p ∈ J ∧ q ∈ J ∧ v 0 * p + v 1 * q = 1 := by
  let Iu := numberFieldRankTwoCoordinateIdealUnit K v hv
  let I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K := Iu
  let J : FractionalIdeal (nonZeroDivisors (𝓞 K)) K := Iu⁻¹
  have hIJ : I * J = 1 := by
    dsimp [I, J, Iu]
    change (↑(numberFieldRankTwoCoordinateIdealUnit K v hv *
      (numberFieldRankTwoCoordinateIdealUnit K v hv)⁻¹) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K) = 1
    rw [mul_inv_cancel]
    rfl
  have hone : (1 : K) ∈ (↑(I * J) : Submodule (𝓞 K) K) := by
    rw [hIJ]
    simp
  rw [show I = numberFieldRankTwoCoordinateIdeal K v from rfl,
    numberFieldRankTwoCoordinateIdeal, fractionalIdeal_sup_mul,
    FractionalIdeal.coe_sup, Submodule.mem_sup] at hone
  obtain ⟨x, hx, y, hy, hxy⟩ := hone
  rw [coe_spanSingleton_mul_fractionalIdeal, Submodule.mem_map] at hx hy
  obtain ⟨p, hp, rfl⟩ := hx
  obtain ⟨q, hq, rfl⟩ := hy
  refine ⟨p, q, hp, hq, ?_⟩
  simpa using hxy

/-- Chosen dual coordinates of a nonzero rank-two vector. -/
def numberFieldRankTwoCuspDual
    (v : Fin 2 → K) (hv : v ≠ 0) : Fin 2 → K :=
  ![Classical.choose (exists_numberFieldRankTwoCuspDual K v hv),
    Classical.choose (Classical.choose_spec (exists_numberFieldRankTwoCuspDual K v hv))]

/-- Each chosen dual coordinate belongs to the inverse coordinate ideal. -/
theorem numberFieldRankTwoCuspDual_mem_inv
    (v : Fin 2 → K) (hv : v ≠ 0) (i : Fin 2) :
    numberFieldRankTwoCuspDual K v hv i ∈
      (↑((numberFieldRankTwoCoordinateIdealUnit K v hv)⁻¹) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
  fin_cases i
  · exact (Classical.choose_spec
      (Classical.choose_spec (exists_numberFieldRankTwoCuspDual K v hv))).1
  · exact (Classical.choose_spec
      (Classical.choose_spec (exists_numberFieldRankTwoCuspDual K v hv))).2.1

/-- The chosen cusp dual pairs with the original vector to one. -/
theorem numberFieldRankTwoCuspDual_pairing
    (v : Fin 2 → K) (hv : v ≠ 0) :
    v 0 * numberFieldRankTwoCuspDual K v hv 0 +
      v 1 * numberFieldRankTwoCuspDual K v hv 1 = 1 :=
  (Classical.choose_spec
    (Classical.choose_spec (exists_numberFieldRankTwoCuspDual K v hv))).2.2

/-- A product of one coordinate-ideal member and one inverse-ideal member is an algebraic
integer.  The result is returned as its literal element of the number ring. -/
theorem exists_ringOfIntegers_eq_mul_of_mem_coordinateIdeal_mul_inv
    (v : Fin 2 → K) (hv : v ≠ 0) {x y : K}
    (hx : x ∈ numberFieldRankTwoCoordinateIdeal K v)
    (hy : y ∈
      (↑((numberFieldRankTwoCoordinateIdealUnit K v hv)⁻¹) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) :
    ∃ a : 𝓞 K, (a : K) = x * y := by
  let Iu := numberFieldRankTwoCoordinateIdealUnit K v hv
  have hxy : x * y ∈
      (↑((↑Iu : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) *
        (↑(Iu⁻¹) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)) :
          Submodule (𝓞 K) K) := by
    rw [FractionalIdeal.coe_mul]
    exact Submodule.mul_mem_mul hx hy
  have hprod :
      (↑Iu : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) *
          (↑(Iu⁻¹) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) = 1 := by
    change (↑(Iu * Iu⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) = 1
    rw [mul_inv_cancel]
    rfl
  rw [hprod, FractionalIdeal.coe_one, Submodule.mem_one] at hxy
  obtain ⟨a, ha⟩ := hxy
  exact ⟨a, by simpa using ha⟩

/-- Determinant-one pseudo-basis frame attached to a nonzero rank-two vector. -/
def numberFieldRankTwoCuspFrame
    (v : Fin 2 → K) (hv : v ≠ 0) : Matrix (Fin 2) (Fin 2) K :=
  !![v 0, -numberFieldRankTwoCuspDual K v hv 1;
    v 1, numberFieldRankTwoCuspDual K v hv 0]

/-- The first cusp-frame column is the original vector. -/
@[simp]
theorem numberFieldRankTwoCuspFrame_apply_zero
    (v : Fin 2 → K) (hv : v ≠ 0) (i : Fin 2) :
    numberFieldRankTwoCuspFrame K v hv i 0 = v i := by
  fin_cases i <;> rfl

/-- Every cusp frame has determinant one. -/
@[simp]
theorem numberFieldRankTwoCuspFrame_det
    (v : Fin 2 → K) (hv : v ≠ 0) :
    (numberFieldRankTwoCuspFrame K v hv).det = 1 := by
  rw [Matrix.det_fin_two]
  dsimp [numberFieldRankTwoCuspFrame]
  calc
    v 0 * numberFieldRankTwoCuspDual K v hv 0 -
        -numberFieldRankTwoCuspDual K v hv 1 * v 1 =
      v 0 * numberFieldRankTwoCuspDual K v hv 0 +
        v 1 * numberFieldRankTwoCuspDual K v hv 1 := by ring
    _ = 1 := numberFieldRankTwoCuspDual_pairing K v hv

end

end GaloisForLFunctions.HTGeometry
