import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.RingTheory.EuclideanDomain

/-!
# Ideals of a polynomial quotient are generated by monic divisors

Every ideal of `K[t]/(f)` is generated by the image of a monic divisor of `f`: pull the ideal back
to `K[t]`, use that the polynomial ring is a principal ideal domain, and normalise the generator.

This is the correspondence that turns the invariant subspaces of the shift into the divisors of `f`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K : Type*} [Field K]

/-- **Every ideal of a polynomial quotient comes from a monic divisor.** -/
theorem exists_monic_dvd_of_ideal {f : K[X]} (hf : f ≠ 0)
    (I : Ideal (K[X] ⧸ Ideal.span ({f} : Set K[X]))) :
    ∃ g : K[X], g.Monic ∧ g ∣ f ∧
      I = Ideal.span ({Ideal.Quotient.mk (Ideal.span ({f} : Set K[X])) g} :
        Set (K[X] ⧸ Ideal.span ({f} : Set K[X]))) := by
  classical
  set J : Ideal K[X] := I.comap (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X]))) with hJ
  obtain ⟨h, hh⟩ := (IsPrincipalIdealRing.principal J)
  -- the generator divides `f`, because `f` lies in the pulled-back ideal
  have hfJ : f ∈ J := by
    rw [hJ, Ideal.mem_comap]
    have : (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X]))) f = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)
    rw [this]
    exact I.zero_mem
  have hdvd : h ∣ f := by
    rw [hh, Ideal.submodule_span_eq, Ideal.mem_span_singleton] at hfJ
    exact hfJ
  have hh0 : h ≠ 0 := by
    intro hcon
    rw [hcon] at hdvd
    exact hf (zero_dvd_iff.1 hdvd)
  -- normalise the generator
  have hunit : h * Polynomial.C (h.leadingCoeff)⁻¹ * Polynomial.C h.leadingCoeff = h := by
    rw [mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ (Polynomial.leadingCoeff_ne_zero.2 hh0),
      map_one, mul_one]
  refine ⟨h * Polynomial.C (h.leadingCoeff)⁻¹, Polynomial.monic_mul_leadingCoeff_inv hh0, ?_, ?_⟩
  · exact dvd_trans ⟨Polynomial.C h.leadingCoeff, hunit.symm⟩ hdvd
  · have hspan : Ideal.span ({h * Polynomial.C (h.leadingCoeff)⁻¹} : Set K[X])
        = Ideal.span ({h} : Set K[X]) := by
      refine le_antisymm ((Ideal.span_singleton_le_iff_mem _).2 ?_)
        ((Ideal.span_singleton_le_iff_mem _).2 ?_)
      · exact Ideal.mem_span_singleton.2 ⟨Polynomial.C (h.leadingCoeff)⁻¹, rfl⟩
      · exact Ideal.mem_span_singleton.2 ⟨Polynomial.C h.leadingCoeff, hunit.symm⟩
    have hIJ : I = J.map (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X]))) :=
      (Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective I).symm
    rw [hIJ, hh, Ideal.submodule_span_eq, ← hspan, Ideal.map_span]
    congr 1
    simp

end GaloisForLFunctions.HTGeometry
