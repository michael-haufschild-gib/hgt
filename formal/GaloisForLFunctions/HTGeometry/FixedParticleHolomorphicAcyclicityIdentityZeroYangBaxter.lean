import GaloisForLFunctions.HTGeometry.HolomorphicRightEvolution

open Set Filter MeasureTheory intervalIntegral
open scoped Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u v w

/-- A genuine unit-valued cocycle for a right action, with the action written as `act g z`. -/
structure RightUnitCocycle (G : Type u) (X : Type v) (A : Type w)
    [Group G] [Group A] where
  act : G → X → X
  act_one : ∀ z, act 1 z = z
  act_mul : ∀ g h z, act (g * h) z = act h (act g z)
  value : G → X → A
  value_one : ∀ z, value 1 z = 1
  value_mul : ∀ g h z, value (g * h) z = value g z * value h (act g z)

namespace RightUnitCocycle

variable {G : Type u} {X : Type v} {A : Type w} [Group G] [Group A]

/-- A frame trivializes the right cocycle exactly when it obeys this equivariance law. -/
def IsGauge (C : RightUnitCocycle G X A) (J : X → A) : Prop :=
  ∀ g z, J (C.act g z) = J z * C.value g z

theorem value_inv_at_act (C : RightUnitCocycle G X A) (g : G) (z : X) :
    C.value g⁻¹ (C.act g z) = (C.value g z)⁻¹ := by
  have h := C.value_mul g g⁻¹ z
  rw [mul_inv_cancel, C.value_one] at h
  exact eq_inv_of_mul_eq_one_right h.symm

/-- Elements fixing `z` and acting trivially on its fiber form a subgroup. -/
def trivialIsotropySubgroup (C : RightUnitCocycle G X A) (z : X) : Subgroup G where
  carrier := {g | C.act g z = z ∧ C.value g z = 1}
  one_mem' := ⟨C.act_one z, C.value_one z⟩
  mul_mem' := by
    rintro g h ⟨hgz, hgv⟩ ⟨hhz, hhv⟩
    constructor
    · rw [C.act_mul, hgz, hhz]
    · rw [C.value_mul, hgz, hgv, hhv, one_mul]
  inv_mem' := by
    rintro g ⟨hgz, hgv⟩
    constructor
    · have h := C.act_mul g g⁻¹ z
      rw [mul_inv_cancel, C.act_one, hgz] at h
      exact h.symm
    · have h := C.value_inv_at_act g z
      rw [hgz, hgv, inv_one] at h
      exact h

/-- If a family of collision generators fixes the point and has identity fiber action, every
element generated by it has identity fiber action. -/
theorem value_eq_one_of_mem_closure (C : RightUnitCocycle G X A) (z : X) (generators : Set G)
    (hgen : generators ⊆ C.trivialIsotropySubgroup z) {g : G}
    (hg : g ∈ Subgroup.closure generators) : C.value g z = 1 := by
  have hle : Subgroup.closure generators ≤ C.trivialIsotropySubgroup z :=
    (Subgroup.closure_le _).2 hgen
  exact (hle hg).2

/-- Conjugating a collision generator preserves trivial fiber isotropy at the corresponding
orbit point. This is equation `(7)` before passing to generated stabilizers. -/
theorem value_conjugate_eq_one
    (C : RightUnitCocycle G X A) (pi s : G) (z : X)
    (hfix : C.act s (C.act pi z) = C.act pi z)
    (hs : C.value s (C.act pi z) = 1) :
    C.value (pi * s * pi⁻¹) z = 1 := by
  rw [C.value_mul, C.value_mul, C.act_mul, hs, mul_one, hfix,
    C.value_inv_at_act, mul_inv_cancel]

end RightUnitCocycle

section Reynolds

variable {G : Type u} {X : Type v} {A : Type w}
  [Group G] [Fintype G] [NormedRing A] [NormedAlgebra ℂ A]

/-- Normalized infinitesimal Reynolds average for a finite-group cocycle. -/
def reynoldsGenerator (alpha : G → X → A) (z : X) : A :=
  -((Fintype.card G : ℂ)⁻¹) • ∑ g, alpha g z

/-- The Reynolds average solves the infinitesimal gauge equation. This is the algebraic
engine behind radial holomorphic acyclicity. -/
theorem conjugate_reynoldsGenerator
    (act : G → X → X) (a : G → X → Aˣ) (alpha : G → X → A)
    (halpha : ∀ g h z,
      alpha (g * h) z = alpha g z + (a g z : A) * alpha h (act g z) *
        (↑((a g z)⁻¹) : A))
    (g : G) (z : X) :
    (a g z : A) * reynoldsGenerator alpha (act g z) * (↑((a g z)⁻¹) : A) =
      reynoldsGenerator alpha z + alpha g z := by
  have hcard : (Fintype.card G : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hreindex : ∑ h, alpha (g * h) z = ∑ h, alpha h z := by
    exact Fintype.sum_equiv (Equiv.mulLeft g)
      (fun h => alpha (g * h) z) (fun h => alpha h z) (fun _ => rfl)
  have hterm (h : G) :
      (a g z : A) * alpha h (act g z) * (↑((a g z)⁻¹) : A) =
        alpha (g * h) z - alpha g z := by
    rw [eq_sub_iff_add_eq]
    simpa [add_comm] using (halpha g h z).symm
  rw [reynoldsGenerator, reynoldsGenerator]
  calc
    (a g z : A) * (-((Fintype.card G : ℂ)⁻¹) • ∑ h, alpha h (act g z)) *
          (↑((a g z)⁻¹) : A) =
        -((Fintype.card G : ℂ)⁻¹) •
          ∑ h, ((a g z : A) * alpha h (act g z) * (↑((a g z)⁻¹) : A)) := by
            simp only [Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc]
    _ = -((Fintype.card G : ℂ)⁻¹) •
          ∑ h, (alpha (g * h) z - alpha g z) := by
            congr 1
            exact Finset.sum_congr rfl (fun h _ => hterm h)
    _ = -((Fintype.card G : ℂ)⁻¹) •
          ((∑ h, alpha h z) - Fintype.card G • alpha g z) := by
            rw [Finset.sum_sub_distrib, hreindex, Finset.sum_const, Finset.card_univ]
    _ = -((Fintype.card G : ℂ)⁻¹) • ∑ h, alpha h z + alpha g z := by
            have hscale :
                -((Fintype.card G : ℂ)⁻¹) • (Fintype.card G • alpha g z) =
                  -alpha g z := by
              rw [← Nat.cast_smul_eq_nsmul ℂ, ← mul_smul]
              simp [hcard]
            rw [smul_sub]
            rw [hscale, sub_neg_eq_add]

end Reynolds

section LogarithmicDerivative

variable {G : Type u} {X : Type v} {A : Type w}
  [Group G] [NormedRing A]

/-- Left logarithmic derivative `ȧ a⁻¹` of a unit-valued family. -/
def leftLogDerivative (a : G → X → Aˣ) (da : G → X → A) (g : G) (z : X) : A :=
  da g z * (↑((a g z)⁻¹) : A)

/-- Differentiating a right cocycle turns its left logarithmic derivative into an affine
adjoint cocycle. -/
theorem leftLogDerivative_mul
    (act : G → X → X) (a : G → X → Aˣ) (da : G → X → A)
    (ha : ∀ g h z, a (g * h) z = a g z * a h (act g z))
    (hda : ∀ g h z, da (g * h) z =
      da g z * (a h (act g z) : A) + (a g z : A) * da h (act g z))
    (g h : G) (z : X) :
    leftLogDerivative a da (g * h) z =
      leftLogDerivative a da g z +
        (a g z : A) * leftLogDerivative a da h (act g z) * (↑((a g z)⁻¹) : A) := by
  have hinv : (↑((a (g * h) z)⁻¹) : A) =
      (↑((a h (act g z))⁻¹) : A) * (↑((a g z)⁻¹) : A) := by
    rw [ha]
    rfl
  rw [leftLogDerivative, leftLogDerivative, leftLogDerivative, hda, hinv]
  simp only [add_mul, mul_assoc]
  rw [← mul_assoc (a h (act g z) : A) (↑((a h (act g z))⁻¹) : A)
    (↑((a g z)⁻¹) : A), Units.mul_inv]
  simp

end LogarithmicDerivative

section RadialGeometry

variable {n : ℕ}

/-- Delete distinguished homotopy coordinate. -/
def radialTailCLM :
    (Fin (n + 1) → ℂ) →L[ℂ] (Fin n → ℂ) :=
  ContinuousLinearMap.pi fun i => ContinuousLinearMap.proj i.succ

@[simp]
theorem radialTailCLM_apply (q : Fin (n + 1) → ℂ) :
    radialTailCLM q = Fin.tail q := by
  rfl

/-- Radial point encoded by `(complex time, spatial endpoint)`. -/
def radialPoint (q : Fin (n + 1) → ℂ) : Fin n → ℂ :=
  q 0 • radialTailCLM q

theorem analyticOnNhd_radialPoint :
    AnalyticOnNhd ℂ (radialPoint (n := n)) univ := by
  have hhead : AnalyticOnNhd ℂ
      (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin (n + 1) => ℂ) 0) univ :=
    (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin (n + 1) => ℂ) 0).analyticOnNhd _
  have htail : AnalyticOnNhd ℂ (radialTailCLM (n := n)) univ :=
    (radialTailCLM (n := n)).analyticOnNhd _
  exact hhead.smul htail

theorem continuous_radialPoint : Continuous (radialPoint (n := n)) :=
  continuousOn_univ.mp analyticOnNhd_radialPoint.continuousOn

/-- Open radial pullback of a spatial domain. -/
def radialDomain (U : Set (Fin n → ℂ)) : Set (Fin (n + 1) → ℂ) :=
  radialPoint ⁻¹' U

theorem isOpen_radialDomain {U : Set (Fin n → ℂ)} (hU : IsOpen U) :
    IsOpen (radialDomain U) :=
  hU.preimage continuous_radialPoint

@[simp]
theorem radialPoint_firstCoordinateScale (s : ℝ) (q : Fin (n + 1) → ℂ) :
    radialPoint (firstCoordinateScale s q) = (s : ℂ) • radialPoint q := by
  ext i
  simp [radialPoint, radialTailCLM, firstCoordinateScale_apply_ne_zero,
    Fin.succ_ne_zero, mul_assoc]

theorem firstCoordinateScale_mem_radialDomain
    {U : Set (Fin n → ℂ)} (hconv : Convex ℝ U) (hzero : (0 : Fin n → ℂ) ∈ U)
    {q : Fin (n + 1) → ℂ} (hq : q ∈ radialDomain U)
    {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    firstCoordinateScale s q ∈ radialDomain U := by
  rw [radialDomain, mem_preimage, radialPoint_firstCoordinateScale]
  have hline := hconv.add_smul_sub_mem hzero hq hs
  simpa [smul_eq_mul] using hline

/-- Lift a spatial linear action while fixing complex homotopy time. -/
def radialLiftActionCLM (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) :
    (Fin (n + 1) → ℂ) →L[ℂ] (Fin (n + 1) → ℂ) :=
  ContinuousLinearMap.pi fun i => Fin.cases
    (ContinuousLinearMap.proj 0)
    (fun j => (ContinuousLinearMap.proj j).comp (L.comp radialTailCLM)) i

@[simp]
theorem radialLiftActionCLM_apply_zero
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (q : Fin (n + 1) → ℂ) :
    radialLiftActionCLM L q 0 = q 0 := by
  rfl

@[simp]
theorem radialLiftActionCLM_apply_succ
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (q : Fin (n + 1) → ℂ) (i : Fin n) :
    radialLiftActionCLM L q i.succ = L (Fin.tail q) i := by
  rfl

@[simp]
theorem radialTailCLM_radialLiftActionCLM
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (q : Fin (n + 1) → ℂ) :
    radialTailCLM (radialLiftActionCLM L q) = L (radialTailCLM q) := by
  ext i
  rfl

theorem radialPoint_radialLiftActionCLM
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (q : Fin (n + 1) → ℂ) :
    radialPoint (radialLiftActionCLM L q) = L (radialPoint q) := by
  rw [radialPoint, radialPoint, radialLiftActionCLM_apply_zero,
    radialTailCLM_radialLiftActionCLM, map_smul]

/-- Pure first-coordinate direction. -/
def radialTimeDirection : Fin (n + 1) → ℂ := fun i => if i = 0 then 1 else 0

@[simp]
theorem radialLiftActionCLM_timeDirection
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) :
    radialLiftActionCLM L (radialTimeDirection (n := n)) = radialTimeDirection := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp [radialTimeDirection]
  · rw [radialLiftActionCLM_apply_succ]
    have htail : Fin.tail (radialTimeDirection (n := n)) = 0 := by
      ext k
      change radialTimeDirection k.succ = 0
      simp [radialTimeDirection, Fin.succ_ne_zero]
    rw [htail, map_zero]
    simp [radialTimeDirection]

@[simp]
theorem radialPoint_cons (t : ℂ) (z : Fin n → ℂ) :
    radialPoint (Fin.cons t z) = t • z := by
  ext i
  simp [radialPoint, radialTailCLM]

@[simp]
theorem firstCoordinateScale_cons (s : ℝ) (t : ℂ) (z : Fin n → ℂ) :
    firstCoordinateScale s (Fin.cons t z) = Fin.cons ((s : ℂ) * t) z := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp [firstCoordinateScale_apply_ne_zero, Fin.succ_ne_zero]

@[simp]
theorem radialLiftActionCLM_cons
    (L : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (t : ℂ) (z : Fin n → ℂ) :
    radialLiftActionCLM L (Fin.cons t z) = Fin.cons t (L z) := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i <;> simp

/-- Real time embedded as the distinguished complex coordinate. -/
def radialRealTimeCLM : ℝ →L[ℝ] (Fin (n + 1) → ℂ) :=
  ContinuousLinearMap.pi fun i => Fin.cases Complex.ofRealCLM (fun _ => 0) i

@[simp]
theorem radialRealTimeCLM_apply_one :
    radialRealTimeCLM (n := n) 1 = radialTimeDirection := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp [radialRealTimeCLM, radialTimeDirection]
  · simp [radialRealTimeCLM, radialTimeDirection, Fin.succ_ne_zero]

theorem hasFDerivAt_radialRealPath (z : Fin n → ℂ) (t : ℝ) :
    HasFDerivAt (fun s : ℝ => Fin.cons (s : ℂ) z) radialRealTimeCLM t := by
  have hbase : HasFDerivAt
      (fun s : ℝ => radialRealTimeCLM (n := n) s + Fin.cons 0 z)
      radialRealTimeCLM t :=
    (radialRealTimeCLM (n := n)).hasFDerivAt.add_const (Fin.cons 0 z)
  have hevent : (fun s : ℝ => Fin.cons (s : ℂ) z) =ᶠ[𝓝 t]
      fun s => radialRealTimeCLM s + Fin.cons 0 z := by
    apply Filter.Eventually.of_forall
    intro s
    ext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [radialRealTimeCLM]
    · simp [radialRealTimeCLM]
  exact hbase.congr_of_eventuallyEq hevent

end RadialGeometry

section PermutationAction

variable {n : ℕ}

/-- Right coordinate-permutation action on a fixed-particle configuration. -/
def coordinateRightPermutation (π : Equiv.Perm (Fin n)) :
    (Fin n → ℂ) →L[ℂ] (Fin n → ℂ) :=
  ContinuousLinearMap.pi fun i => ContinuousLinearMap.proj (π i)

@[simp]
theorem coordinateRightPermutation_apply
    (π : Equiv.Perm (Fin n)) (z : Fin n → ℂ) (i : Fin n) :
    coordinateRightPermutation π z i = z (π i) := rfl

theorem coordinateRightPermutation_one :
    coordinateRightPermutation (1 : Equiv.Perm (Fin n)) =
      ContinuousLinearMap.id ℂ _ := by
  ext z i
  simp

theorem coordinateRightPermutation_mul (π σ : Equiv.Perm (Fin n)) :
    coordinateRightPermutation (π * σ) =
      (coordinateRightPermutation σ).comp (coordinateRightPermutation π) := by
  ext z i
  simp [coordinateRightPermutation]

end PermutationAction

section FiniteEndomorphism

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]
  [FiniteDimensional ℂ V]

/-- Endomorphisms of a finite-dimensional complex normed space are directly finite. -/
theorem continuousLinearEndIsDedekindFiniteMonoid :
    IsDedekindFiniteMonoid (V →L[ℂ] V) :=
  IsDedekindFiniteMonoid.mk fun {a b} hab => by
    have hab_apply : ∀ x : V, a (b x) = x := by
      intro x
      have h := congrArg (fun L : V →L[ℂ] V => L x) hab
      simpa using h
    have hsurj : Function.Surjective a := fun y => ⟨b y, hab_apply y⟩
    have hinj : Function.Injective a :=
      LinearMap.injective_iff_surjective.mpr hsurj
    ext x
    apply hinj
    simpa using hab_apply (a x)

end FiniteEndomorphism

section HolomorphicCocycle

variable {G : Type u} {n : ℕ} {B : Type w}
  [Group G] [Fintype G]
  [NormedRing B] [NormedAlgebra ℂ B] [CompleteSpace B]

/-- Finite linear right action equipped with a holomorphic unit-valued right cocycle on an
open convex radial domain. -/
structure FiniteHolomorphicRightCocycle (G : Type u) (n : ℕ) (B : Type w)
    [Group G] [Fintype G]
    [NormedRing B] [NormedAlgebra ℂ B] [CompleteSpace B] where
  action : G → (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)
  action_one : action 1 = ContinuousLinearMap.id ℂ _
  action_mul : ∀ g h, action (g * h) = (action h).comp (action g)
  domain : Set (Fin n → ℂ)
  isOpen_domain : IsOpen domain
  convex_domain : Convex ℝ domain
  zero_mem_domain : (0 : Fin n → ℂ) ∈ domain
  action_mem_domain : ∀ g z, z ∈ domain → action g z ∈ domain
  value : G → (Fin n → ℂ) → Bˣ
  value_one : ∀ z, value 1 z = 1
  value_mul : ∀ g h z,
    value (g * h) z = value g z * value h (action g z)
  analytic_value : ∀ g,
    AnalyticOnNhd ℂ (fun z => (value g z : B)) domain
  value_zero : ∀ g, value g 0 = 1

namespace FiniteHolomorphicRightCocycle

omit [Fintype G] [NormedAlgebra ℂ B] [CompleteSpace B] in
/-- Identity collision on a generating family forces identity fiber action at the radial
center for the whole group. -/
theorem value_zero_of_generators
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (action : G → E →L[ℂ] E)
    (action_one : action 1 = ContinuousLinearMap.id ℂ E)
    (action_mul : ∀ g h, action (g * h) = (action h).comp (action g))
    (value : G → E → Bˣ)
    (value_one : ∀ z, value 1 z = 1)
    (value_mul : ∀ g h z, value (g * h) z = value g z * value h (action g z))
    (generators : Set G)
    (hcollision : ∀ s ∈ generators, value s 0 = 1)
    (hgenerates : Subgroup.closure generators = ⊤) :
    ∀ g, value g 0 = 1 := by
  let R : RightUnitCocycle G E Bˣ :=
    { act := fun g z => action g z
      act_one := fun z => by rw [action_one]; rfl
      act_mul := fun g h z => by rw [action_mul]; rfl
      value := value
      value_one := value_one
      value_mul := value_mul }
  have hsubset : generators ⊆ R.trivialIsotropySubgroup 0 := by
    intro s hs
    exact ⟨map_zero (action s), hcollision s hs⟩
  intro g
  apply R.value_eq_one_of_mem_closure 0 generators hsubset
  rw [hgenerates]
  exact Subgroup.mem_top g

/-- Composition with ring inversion is analytic wherever an analytic Banach-algebra family is
unit-valued. -/
theorem analyticOnNhd_ringInverse_comp
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {f : E → B} {U : Set E} (hf : AnalyticOnNhd ℂ f U)
    (hu : ∀ x ∈ U, IsUnit (f x)) :
    AnalyticOnNhd ℂ (fun x => Ring.inverse (f x)) U := by
  intro x hx
  obtain ⟨v, hv⟩ := hu x hx
  have hinv : AnalyticAt ℂ Ring.inverse (f x) := by
    simpa only [hv] using (analyticAt_inverse (𝕜 := ℂ) v)
  change AnalyticAt ℂ (Ring.inverse ∘ f) x
  exact hinv.comp (hf x hx)

/-- Unit cocycle pulled back to complex radial time. -/
def radialValue (C : FiniteHolomorphicRightCocycle G n B)
    (g : G) (q : Fin (n + 1) → ℂ) : Bˣ :=
  C.value g (radialPoint q)

/-- Underlying Banach-algebra-valued radial cocycle. -/
def radialValueCoe (C : FiniteHolomorphicRightCocycle G n B)
    (g : G) (q : Fin (n + 1) → ℂ) : B :=
  C.radialValue g q

theorem analyticOnNhd_radialValueCoe
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) :
    AnalyticOnNhd ℂ (C.radialValueCoe g) (radialDomain C.domain) := by
  have hrad := analyticOnNhd_radialPoint (n := n)
  exact (C.analytic_value g).comp (hrad.mono (subset_univ _)) fun q hq => hq

theorem analyticOnNhd_radialValueInvCoe
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) :
    AnalyticOnNhd ℂ
      (fun q => (↑((C.radialValue g q)⁻¹) : B))
      (radialDomain C.domain) := by
  have hinv := analyticOnNhd_ringInverse_comp
    (C.analyticOnNhd_radialValueCoe g)
    (fun q _ => (C.radialValue g q).isUnit)
  have heq : (fun q => (↑((C.radialValue g q)⁻¹) : B)) =
      fun q => Ring.inverse (C.radialValueCoe g q) := by
    funext q
    exact (Ring.inverse_unit (C.radialValue g q)).symm
  rw [heq]
  exact hinv

/-- Derivative of the radial cocycle in complex homotopy time. -/
def radialDerivative (C : FiniteHolomorphicRightCocycle G n B)
    (g : G) (q : Fin (n + 1) → ℂ) : B :=
  fderiv ℂ (C.radialValueCoe g) q radialTimeDirection

theorem analyticOnNhd_radialDerivative
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) :
    AnalyticOnNhd ℂ (C.radialDerivative g) (radialDomain C.domain) := by
  have happly : AnalyticOnNhd ℂ
      (ContinuousLinearMap.apply ℂ B (radialTimeDirection (n := n)))
      (univ : Set ((Fin (n + 1) → ℂ) →L[ℂ] B)) :=
    (ContinuousLinearMap.apply ℂ B (radialTimeDirection (n := n))).analyticOnNhd _
  have hcomp := happly.comp (C.analyticOnNhd_radialValueCoe g).fderiv
    (fun _ _ => mem_univ _)
  change AnalyticOnNhd ℂ
    ((ContinuousLinearMap.apply ℂ B (radialTimeDirection (n := n))) ∘
      fderiv ℂ (C.radialValueCoe g)) (radialDomain C.domain)
  exact hcomp

/-- Left logarithmic radial derivative. -/
def radialAlpha (C : FiniteHolomorphicRightCocycle G n B)
    (g : G) (q : Fin (n + 1) → ℂ) : B :=
  leftLogDerivative C.radialValue C.radialDerivative g q

theorem analyticOnNhd_radialAlpha
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) :
    AnalyticOnNhd ℂ (C.radialAlpha g) (radialDomain C.domain) := by
  exact (C.analyticOnNhd_radialDerivative g).mul
    (C.analyticOnNhd_radialValueInvCoe g)

/-- Infinitesimal Reynolds gauge for the radial cocycle. -/
def radialGenerator (C : FiniteHolomorphicRightCocycle G n B)
    (q : Fin (n + 1) → ℂ) : B :=
  reynoldsGenerator C.radialAlpha q

theorem analyticOnNhd_radialGenerator
    (C : FiniteHolomorphicRightCocycle G n B) :
    AnalyticOnNhd ℂ C.radialGenerator (radialDomain C.domain) := by
  have hsum : AnalyticOnNhd ℂ
      (fun q => ∑ g : G, C.radialAlpha g q) (radialDomain C.domain) := by
    have hs := Finset.analyticOnNhd_sum Finset.univ
      (fun g _ => C.analyticOnNhd_radialAlpha g)
    convert hs using 1
    ext q
    simp
  have hscale := hsum.const_smul (c := (Fintype.card G : ℂ)⁻¹)
  convert hscale.neg using 1
  ext q
  simp [radialGenerator, reynoldsGenerator]

/-- Radial pullback preserves the right cocycle law. -/
theorem radialValue_mul
    (C : FiniteHolomorphicRightCocycle G n B) (g h : G)
    (q : Fin (n + 1) → ℂ) :
    C.radialValue (g * h) q =
      C.radialValue g q *
        C.radialValue h (radialLiftActionCLM (C.action g) q) := by
  rw [radialValue, radialValue, radialValue, C.value_mul,
    radialPoint_radialLiftActionCLM]

theorem radialLiftActionCLM_mem_domain
    (C : FiniteHolomorphicRightCocycle G n B) (g : G)
    {q : Fin (n + 1) → ℂ} (hq : q ∈ radialDomain C.domain) :
    radialLiftActionCLM (C.action g) q ∈ radialDomain C.domain := by
  change radialPoint (radialLiftActionCLM (C.action g) q) ∈ C.domain
  rw [radialPoint_radialLiftActionCLM]
  exact C.action_mem_domain g (radialPoint q) hq

/-- Differentiated radial cocycle law. -/
theorem radialDerivative_mul
    (C : FiniteHolomorphicRightCocycle G n B) (g h : G)
    {q : Fin (n + 1) → ℂ} (hq : q ∈ radialDomain C.domain) :
    C.radialDerivative (g * h) q =
      C.radialDerivative g q *
          (C.radialValue h (radialLiftActionCLM (C.action g) q) : B) +
        (C.radialValue g q : B) *
          C.radialDerivative h (radialLiftActionCLM (C.action g) q) := by
  let L := radialLiftActionCLM (C.action g)
  have hLq : L q ∈ radialDomain C.domain :=
    C.radialLiftActionCLM_mem_domain g hq
  have hgdiff : DifferentiableAt ℂ (C.radialValueCoe g) q :=
    (C.analyticOnNhd_radialValueCoe g q hq).differentiableAt
  have hhdiff : DifferentiableAt ℂ (C.radialValueCoe h) (L q) :=
    (C.analyticOnNhd_radialValueCoe h (L q) hLq).differentiableAt
  have hgderiv : HasFDerivAt (C.radialValueCoe g)
      (fderiv ℂ (C.radialValueCoe g) q) q := hgdiff.hasFDerivAt
  have hhderiv : HasFDerivAt (C.radialValueCoe h)
      (fderiv ℂ (C.radialValueCoe h) (L q)) (L q) := hhdiff.hasFDerivAt
  have hhcomp := hhderiv.comp q L.hasFDerivAt
  have hprod := hgderiv.mul' hhcomp
  have heq : C.radialValueCoe (g * h) =
      (C.radialValueCoe g) * (C.radialValueCoe h ∘ L) := by
    funext w
    exact congrArg (fun u : Bˣ => (u : B)) (C.radialValue_mul g h w)
  have hevent : C.radialValueCoe (g * h) =ᶠ[𝓝 q]
      (C.radialValueCoe g) * (C.radialValueCoe h ∘ L) :=
    Filter.Eventually.of_forall (congrFun heq)
  rw [radialDerivative, hevent.fderiv_eq, hprod.fderiv]
  simp only [add_apply, smul_apply,
    ContinuousLinearMap.comp_apply, Function.comp_apply, radialDerivative, L]
  rw [radialLiftActionCLM_timeDirection]
  ac_rfl

/-- Radial logarithmic derivative is an affine adjoint cocycle on its open radial domain. -/
theorem radialAlpha_mul
    (C : FiniteHolomorphicRightCocycle G n B) (g h : G)
    {q : Fin (n + 1) → ℂ} (hq : q ∈ radialDomain C.domain) :
    C.radialAlpha (g * h) q =
      C.radialAlpha g q +
        (C.radialValue g q : B) *
          C.radialAlpha h (radialLiftActionCLM (C.action g) q) *
            (↑((C.radialValue g q)⁻¹) : B) := by
  have hinv : (↑((C.radialValue (g * h) q)⁻¹) : B) =
      (↑((C.radialValue h (radialLiftActionCLM (C.action g) q))⁻¹) : B) *
        (↑((C.radialValue g q)⁻¹) : B) := by
    rw [C.radialValue_mul]
    rfl
  rw [radialAlpha, radialAlpha, radialAlpha, leftLogDerivative,
    C.radialDerivative_mul g h hq, hinv]
  simp only [add_mul, mul_assoc]
  rw [← mul_assoc
    (C.radialValue h (radialLiftActionCLM (C.action g) q) : B)
    (↑((C.radialValue h (radialLiftActionCLM (C.action g) q))⁻¹) : B)
    (↑((C.radialValue g q)⁻¹) : B), Units.mul_inv]
  simp [leftLogDerivative, mul_assoc]

/-- Lifted action on the open radial domain. -/
def radialDomainAction (C : FiniteHolomorphicRightCocycle G n B)
    (g : G) (q : radialDomain C.domain) : radialDomain C.domain :=
  ⟨radialLiftActionCLM (C.action g) q.1,
    C.radialLiftActionCLM_mem_domain g q.2⟩

/-- Reynolds generator satisfies the infinitesimal gauge covariance law. -/
theorem conjugate_radialGenerator
    (C : FiniteHolomorphicRightCocycle G n B) (g : G)
    {q : Fin (n + 1) → ℂ} (hq : q ∈ radialDomain C.domain) :
    (C.radialValue g q : B) *
        C.radialGenerator (radialLiftActionCLM (C.action g) q) *
          (↑((C.radialValue g q)⁻¹) : B) =
      C.radialGenerator q + C.radialAlpha g q := by
  let act : G → radialDomain C.domain → radialDomain C.domain := C.radialDomainAction
  let a : G → radialDomain C.domain → Bˣ := fun h w => C.radialValue h w.1
  let alpha : G → radialDomain C.domain → B := fun h w => C.radialAlpha h w.1
  have halpha : ∀ h k w,
      alpha (h * k) w = alpha h w +
        (a h w : B) * alpha k (act h w) * (↑((a h w)⁻¹) : B) := by
    intro h k w
    exact C.radialAlpha_mul h k w.2
  have hmain := conjugate_reynoldsGenerator act a alpha halpha g ⟨q, hq⟩
  simpa [act, a, alpha, radialDomainAction, radialGenerator,
    reynoldsGenerator] using hmain

@[simp]
theorem radialValue_cons_zero
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) (z : Fin n → ℂ) :
    C.radialValue g (Fin.cons 0 z) = 1 := by
  rw [radialValue, radialPoint_cons, zero_smul, C.value_zero]

theorem cons_real_mem_radialDomain
    (C : FiniteHolomorphicRightCocycle G n B) {z : Fin n → ℂ}
    (hz : z ∈ C.domain) {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) :
    Fin.cons (t : ℂ) z ∈ radialDomain C.domain := by
  have hq : Fin.cons (1 : ℂ) z ∈ radialDomain C.domain := by
    change radialPoint (Fin.cons (1 : ℂ) z) ∈ C.domain
    simpa using hz
  have hs := firstCoordinateScale_mem_radialDomain C.convex_domain
    C.zero_mem_domain hq ht
  simpa using hs

/-- Complex radial derivative restricts to the real homotopy path. -/
theorem hasDerivAt_radialValuePath
    (C : FiniteHolomorphicRightCocycle G n B) (g : G) (z : Fin n → ℂ)
    {t : ℝ} (ht : Fin.cons (t : ℂ) z ∈ radialDomain C.domain) :
    HasDerivAt (fun s : ℝ => C.radialValueCoe g (Fin.cons (s : ℂ) z))
      (C.radialDerivative g (Fin.cons (t : ℂ) z)) t := by
  let q : Fin (n + 1) → ℂ := Fin.cons (t : ℂ) z
  have hc : HasFDerivAt (C.radialValueCoe g)
      (fderiv ℂ (C.radialValueCoe g) q) q :=
    (C.analyticOnNhd_radialValueCoe g q ht).differentiableAt.hasFDerivAt
  have hr := hc.restrictScalars ℝ
  have hcomp := hr.comp t (hasFDerivAt_radialRealPath z t)
  convert hcomp.hasDerivAt using 1
  all_goals try rfl
  all_goals try simp [q, radialDerivative, ContinuousLinearMap.comp_apply]

theorem radialAlpha_mul_value
    (C : FiniteHolomorphicRightCocycle G n B) (g : G)
    (q : Fin (n + 1) → ℂ) :
    C.radialAlpha g q * (C.radialValue g q : B) =
      C.radialDerivative g q := by
  simp [radialAlpha, leftLogDerivative, mul_assoc]

theorem complexPathCoefficient_radialGenerator
    (C : FiniteHolomorphicRightCocycle G n B) (z : Fin n → ℂ)
    {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) :
    complexPathCoefficient C.radialGenerator (Fin.cons (1 : ℂ) z) t =
      C.radialGenerator (Fin.cons (t : ℂ) z) := by
  simp [complexPathCoefficient, Set.projIcc_of_mem zero_le_one ht]

theorem conjugate_radialGenerator_cons
    (C : FiniteHolomorphicRightCocycle G n B) (g : G)
    {z : Fin n → ℂ} (hz : z ∈ C.domain) {t : ℝ}
    (ht : t ∈ Icc (0 : ℝ) 1) :
    (C.radialValue g (Fin.cons (t : ℂ) z) : B) *
        C.radialGenerator (Fin.cons (t : ℂ) (C.action g z)) *
          (↑((C.radialValue g (Fin.cons (t : ℂ) z))⁻¹) : B) =
      C.radialGenerator (Fin.cons (t : ℂ) z) +
        C.radialAlpha g (Fin.cons (t : ℂ) z) := by
  have hq := C.cons_real_mem_radialDomain hz ht
  simpa using C.conjugate_radialGenerator g hq

/-- Spatial endpoint inserted at complex homotopy time one. -/
def radialEndpoint (z : Fin n → ℂ) : Fin (n + 1) → ℂ := Fin.cons 1 z

/-- Linear part of endpoint insertion. -/
def radialEndpointCLM : (Fin n → ℂ) →L[ℂ] (Fin (n + 1) → ℂ) :=
  ContinuousLinearMap.pi fun i => Fin.cases 0 (fun j => ContinuousLinearMap.proj j) i

theorem analyticOnNhd_radialEndpoint :
    AnalyticOnNhd ℂ (radialEndpoint (n := n)) univ := by
  have hlin : AnalyticOnNhd ℂ (radialEndpointCLM (n := n)) univ :=
    (radialEndpointCLM (n := n)).analyticOnNhd _
  have hconst : AnalyticOnNhd ℂ
      (fun _ : Fin n → ℂ => radialTimeDirection (n := n)) univ :=
    analyticOnNhd_const
  have hadd := hlin.add hconst
  convert hadd using 1
  ext z i
  refine Fin.cases ?_ (fun j => ?_) i <;>
    simp [radialEndpoint, radialEndpointCLM, radialTimeDirection]

/-- Canonical holomorphic radial gauge. -/
def radialGauge (C : FiniteHolomorphicRightCocycle G n B)
    (z : Fin n → ℂ) : B :=
  rightComplexEvolution C.radialGenerator (radialEndpoint z)

theorem analyticOnNhd_radialGauge
    (C : FiniteHolomorphicRightCocycle G n B) :
    AnalyticOnNhd ℂ C.radialGauge C.domain := by
  have hstar : ∀ q ∈ radialDomain C.domain, ∀ s ∈ Icc (0 : ℝ) 1,
      firstCoordinateScale s q ∈ radialDomain C.domain := by
    intro q hq s hs
    exact firstCoordinateScale_mem_radialDomain C.convex_domain
      C.zero_mem_domain hq hs
  have hevol := analyticOnNhd_rightComplexEvolution
    (isOpen_radialDomain C.isOpen_domain) hstar
    C.analyticOnNhd_radialGenerator.differentiableOn
  have hend := (analyticOnNhd_radialEndpoint (n := n)).mono (subset_univ C.domain)
  exact hevol.comp hend fun z hz => by
    change radialPoint (radialEndpoint z) ∈ C.domain
    simpa [radialEndpoint] using hz

theorem isUnit_radialGauge [IsDedekindFiniteMonoid B]
    (C : FiniteHolomorphicRightCocycle G n B)
    {z : Fin n → ℂ} (hz : z ∈ C.domain) :
    IsUnit (C.radialGauge z) := by
  have hstar : ∀ q ∈ radialDomain C.domain, ∀ s ∈ Icc (0 : ℝ) 1,
      firstCoordinateScale s q ∈ radialDomain C.domain := by
    intro q hq s hs
    exact firstCoordinateScale_mem_radialDomain C.convex_domain
      C.zero_mem_domain hq hs
  have hq : radialEndpoint z ∈ radialDomain C.domain := by
    change radialPoint (radialEndpoint z) ∈ C.domain
    simpa [radialEndpoint] using hz
  rw [radialGauge,
    rightComplexEvolution_eq_rightCaratheodoryEvolution_one hstar
      C.analyticOnNhd_radialGenerator.differentiableOn hq]
  exact isUnit_rightCaratheodoryEvolution
    (continuous_complexPathCoefficient hstar
      C.analyticOnNhd_radialGenerator.differentiableOn hq) 1

/-- Canonical radial gauge trivializes the holomorphic right cocycle. -/
theorem radialGauge_equivariant
    (C : FiniteHolomorphicRightCocycle G n B) (g : G)
    {z : Fin n → ℂ} (hz : z ∈ C.domain) :
    C.radialGauge (C.action g z) = C.radialGauge z * (C.value g z : B) := by
  have hgz : C.action g z ∈ C.domain := C.action_mem_domain g z hz
  have hstar : ∀ q ∈ radialDomain C.domain, ∀ s ∈ Icc (0 : ℝ) 1,
      firstCoordinateScale s q ∈ radialDomain C.domain := by
    intro q hq s hs
    exact firstCoordinateScale_mem_radialDomain C.convex_domain
      C.zero_mem_domain hq hs
  have hqz : radialEndpoint z ∈ radialDomain C.domain := by
    change radialPoint (radialEndpoint z) ∈ C.domain
    simpa [radialEndpoint] using hz
  have hqgz : radialEndpoint (C.action g z) ∈ radialDomain C.domain := by
    change radialPoint (radialEndpoint (C.action g z)) ∈ C.domain
    simpa [radialEndpoint] using hgz
  let Az : ℝ → B := complexPathCoefficient C.radialGenerator (radialEndpoint z)
  let Ag : ℝ → B :=
    complexPathCoefficient C.radialGenerator (radialEndpoint (C.action g z))
  let Rz : ℝ → B := rightCaratheodoryEvolution Az
  let Rg : ℝ → B := rightCaratheodoryEvolution Ag
  let a : ℝ → B := fun t => C.radialValueCoe g (Fin.cons (t : ℂ) z)
  let H : ℝ → B := fun t => Rz t * a t
  let Dlocal : ℝ → B := fun t => H t - Rg t
  have hAz : Continuous Az :=
    continuous_complexPathCoefficient hstar
      C.analyticOnNhd_radialGenerator.differentiableOn hqz
  have hAg : Continuous Ag :=
    continuous_complexPathCoefficient hstar
      C.analyticOnNhd_radialGenerator.differentiableOn hqgz
  have haDeriv : ∀ t ∈ Icc (0 : ℝ) 1,
      HasDerivAt a (C.radialDerivative g (Fin.cons (t : ℂ) z)) t := by
    intro t ht
    exact C.hasDerivAt_radialValuePath g z (C.cons_real_mem_radialDomain hz ht)
  have htransport : ∀ t ∈ Icc (0 : ℝ) 1,
      Az t * a t + C.radialDerivative g (Fin.cons (t : ℂ) z) =
        a t * Ag t := by
    intro t ht
    have hconj := C.conjugate_radialGenerator_cons g hz ht
    have hAzval := C.complexPathCoefficient_radialGenerator z ht
    have hAgval := C.complexPathCoefficient_radialGenerator (C.action g z) ht
    have hAzval' : Az t = C.radialGenerator (Fin.cons (t : ℂ) z) := by
      simpa [Az, radialEndpoint] using hAzval
    have hAgval' : Ag t =
        C.radialGenerator (Fin.cons (t : ℂ) (C.action g z)) := by
      simpa [Ag, radialEndpoint] using hAgval
    calc
      Az t * a t + C.radialDerivative g (Fin.cons (t : ℂ) z) =
          (C.radialGenerator (Fin.cons (t : ℂ) z) +
            C.radialAlpha g (Fin.cons (t : ℂ) z)) * a t := by
        rw [hAzval', ← C.radialAlpha_mul_value g]
        noncomm_ring
      _ = ((C.radialValue g (Fin.cons (t : ℂ) z) : B) *
            C.radialGenerator (Fin.cons (t : ℂ) (C.action g z)) *
              (↑((C.radialValue g (Fin.cons (t : ℂ) z))⁻¹) : B)) * a t := by
        rw [hconj]
      _ = a t * C.radialGenerator (Fin.cons (t : ℂ) (C.action g z)) := by
        dsimp only [a, radialValueCoe]
        simp [mul_assoc]
      _ = a t * Ag t := by rw [hAgval']
  have hHDeriv : ∀ t ∈ Icc (0 : ℝ) 1,
      HasDerivAt H (H t * Ag t) t := by
    intro t ht
    have hR := hasDerivAt_rightCaratheodoryEvolution hAz t
    have ha := haDeriv t ht
    have heq :
        (Rz t * Az t) * a t + Rz t *
            C.radialDerivative g (Fin.cons (t : ℂ) z) = H t * Ag t := by
      calc
        (Rz t * Az t) * a t + Rz t *
              C.radialDerivative g (Fin.cons (t : ℂ) z) =
            Rz t * (Az t * a t +
              C.radialDerivative g (Fin.cons (t : ℂ) z)) := by noncomm_ring
        _ = Rz t * (a t * Ag t) := by rw [htransport t ht]
        _ = H t * Ag t := by dsimp only [H]; noncomm_ring
    convert hR.mul ha using 1
    · rfl
    · exact heq.symm
  have hDDeriv : ∀ t ∈ Icc (0 : ℝ) 1,
      HasDerivAt Dlocal (Dlocal t * Ag t) t := by
    intro t ht
    have hH := hHDeriv t ht
    have hR := hasDerivAt_rightCaratheodoryEvolution hAg t
    have hsub := hH.sub hR
    have hevent : Dlocal =ᶠ[𝓝 t]
        H - rightCaratheodoryEvolution Ag := by
      apply Filter.Eventually.of_forall
      intro s
      rfl
    have hout := hsub.congr_of_eventuallyEq hevent
    convert hout using 1
    all_goals try rfl
    dsimp only [Dlocal]
    noncomm_ring
  have hDzero : Dlocal 0 = 0 := by
    dsimp only [Dlocal, H, Rz, Rg, a]
    rw [rightCaratheodoryEvolution_zero hAz,
      rightCaratheodoryEvolution_zero hAg]
    simp [radialValueCoe]
  have hDcont : ContinuousOn Dlocal (Icc (0 : ℝ) 1) := by
    intro t ht
    exact (hDDeriv t ht).continuousAt.continuousWithinAt
  have hvolterraLocal : ∀ t ∈ Icc (0 : ℝ) 1,
      Dlocal t = ∫ s in (0 : ℝ)..t, Dlocal s * Ag s := by
    intro t ht
    have hsub : uIcc (0 : ℝ) t ⊆ Icc (0 : ℝ) 1 := by
      rw [uIcc_of_le ht.1]
      intro s hs
      exact ⟨hs.1, hs.2.trans ht.2⟩
    have hint : IntervalIntegrable (fun s => Dlocal s * Ag s) volume 0 t :=
      ((hDcont.mul hAg.continuousOn).mono hsub).intervalIntegrable
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun s hs => hDDeriv s (hsub hs)) hint
    rw [hftc, hDzero, sub_zero]
  let clamp : ℝ → ℝ := fun t => (Set.projIcc (0 : ℝ) 1 zero_le_one t : ℝ)
  let D : ℝ → B := fun t => Dlocal (clamp t)
  have hclamp : Continuous clamp := continuous_subtype_val.comp continuous_projIcc
  have hD : Continuous D := by
    rw [← continuousOn_univ]
    exact hDcont.comp hclamp.continuousOn
      (fun t _ => (Set.projIcc (0 : ℝ) 1 zero_le_one t).property)
  have hD_eq (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) : D t = Dlocal t := by
    simp [D, clamp, Set.projIcc_of_mem zero_le_one ht]
  have hvolterra : ∀ t ∈ Icc (0 : ℝ) 1,
      D t = ∫ s in (0 : ℝ)..t, D s * Ag s := by
    intro t ht
    rw [hD_eq t ht, hvolterraLocal t ht]
    apply intervalIntegral.integral_congr
    intro s hs
    have hsI : s ∈ Icc (0 : ℝ) 1 := by
      rw [uIcc_of_le ht.1] at hs
      exact ⟨hs.1, hs.2.trans ht.2⟩
    change Dlocal s * Ag s = D s * Ag s
    rw [hD_eq s hsI]
  have hzero := eq_zero_of_continuous_right_volterra_on_Icc
    hAg hD zero_le_one hvolterra
  have hDone : Dlocal 1 = 0 := by
    have h := hzero 1 ⟨zero_le_one, le_rfl⟩
    simpa [hD_eq 1 ⟨zero_le_one, le_rfl⟩] using h
  have hframez : C.radialGauge z = Rz 1 := by
    rw [radialGauge,
      rightComplexEvolution_eq_rightCaratheodoryEvolution_one hstar
        C.analyticOnNhd_radialGenerator.differentiableOn hqz]
  have hframegz : C.radialGauge (C.action g z) = Rg 1 := by
    rw [radialGauge,
      rightComplexEvolution_eq_rightCaratheodoryEvolution_one hstar
        C.analyticOnNhd_radialGenerator.differentiableOn hqgz]
  have haone : a 1 = (C.value g z : B) := by
    simp [a, radialValueCoe, radialValue]
  rw [hframez, hframegz, ← haone]
  dsimp only [Dlocal, H] at hDone
  exact sub_eq_zero.mp hDone |>.symm

/-- Full fixed-particle holomorphic acyclicity conclusion: one analytic pointwise-invertible
frame trivializes the finite right cocycle. -/
theorem exists_holomorphic_invertible_gauge [IsDedekindFiniteMonoid B]
    (C : FiniteHolomorphicRightCocycle G n B) :
    ∃ J : (Fin n → ℂ) → B,
      AnalyticOnNhd ℂ J C.domain ∧
      (∀ z ∈ C.domain, IsUnit (J z)) ∧
      ∀ g z, z ∈ C.domain → J (C.action g z) = J z * (C.value g z : B) := by
  exact ⟨C.radialGauge, C.analyticOnNhd_radialGauge,
    (fun z hz => C.isUnit_radialGauge hz),
    fun g z hz => C.radialGauge_equivariant g hz⟩

/-- Fixed-particle identity-zero Yang--Baxter acyclicity for finite-dimensional operator fibers. Adjacent
collision identities enter through `generators`; once those permutations generate the symmetric
group, the resulting holomorphic right cocycle admits one global invertible frame. -/
theorem fixedParticleHolomorphicAcyclicityIdentityZeroYangBaxter
    {m : ℕ}
    (Ω : Set (Fin n → ℂ))
    (hΩopen : IsOpen Ω) (hΩconvex : Convex ℝ Ω)
    (hΩzero : (0 : Fin n → ℂ) ∈ Ω)
    (hΩperm : ∀ π z, z ∈ Ω → coordinateRightPermutation π z ∈ Ω)
    (A : Equiv.Perm (Fin n) → (Fin n → ℂ) →
      ((Fin m → ℂ) →L[ℂ] (Fin m → ℂ))ˣ)
    (A_one : ∀ z, A 1 z = 1)
    (A_mul : ∀ π σ z,
      A (π * σ) z = A π z * A σ (coordinateRightPermutation π z))
    (hA : ∀ π, AnalyticOnNhd ℂ
      (fun z => (A π z : (Fin m → ℂ) →L[ℂ] (Fin m → ℂ))) Ω)
    (generators : Set (Equiv.Perm (Fin n)))
    (hcollision : ∀ τ ∈ generators, A τ 0 = 1)
    (hgenerates : Subgroup.closure generators = ⊤) :
    ∃ J : (Fin n → ℂ) → ((Fin m → ℂ) →L[ℂ] (Fin m → ℂ)),
      AnalyticOnNhd ℂ J Ω ∧
      (∀ z ∈ Ω, IsUnit (J z)) ∧
      ∀ π z, z ∈ Ω →
        J (coordinateRightPermutation π z) =
          J z * (A π z : (Fin m → ℂ) →L[ℂ] (Fin m → ℂ)) := by
  letI : IsDedekindFiniteMonoid ((Fin m → ℂ) →L[ℂ] (Fin m → ℂ)) :=
    continuousLinearEndIsDedekindFiniteMonoid
  have hAzero : ∀ π, A π 0 = 1 :=
    value_zero_of_generators coordinateRightPermutation
      coordinateRightPermutation_one coordinateRightPermutation_mul
