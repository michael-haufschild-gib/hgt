import GaloisForLFunctions.HTGeometry.DifferentialChevalleyExtension

/-!
# Finite-generator differential Chevalley extension

This file turns the marked one-generator extension theorem into the finite-generator theorem.
The intermediate coefficient ring is the subalgebra generated by all jets of the initial
coordinates; its differential structure and its polynomial presentation are constructed here.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential

noncomputable section

universe u v

variable {A B : Type u} [CommRing A] [Differential A]
  [CommRing B] [Differential B] [Algebra A B] [DifferentialAlgebra A B]

/-- Subalgebra generated by every jet of a family. -/
def differentialGeneratorSubalgebra {ι : Type v} (y : ι → B) :
    Subalgebra A B :=
  Algebra.adjoin A
    (Set.range fun p : ι × ℕ => differentialJet p.2 (y p.1))

/-- Jet-generated subalgebra is exactly differential-polynomial evaluation range. -/
theorem differentialGeneratorSubalgebra_eq_range {ι : Type v} (y : ι → B) :
    differentialGeneratorSubalgebra (A := A) y =
      (differentialPolynomialEvalOver (K := A) y).range := by
  rw [differentialGeneratorSubalgebra, differentialPolynomialEvalOver,
    ← Algebra.adjoin_range_eq_range_aeval]

/-- Jet-generated subalgebra is stable under ambient derivation. -/
theorem differentialGeneratorSubalgebra_deriv_stable {ι : Type v} (y : ι → B) :
    ∀ b ∈ differentialGeneratorSubalgebra (A := A) y,
      Differential.deriv b ∈ differentialGeneratorSubalgebra (A := A) y := by
  intro b hb
  induction hb using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨⟨i, n⟩, rfl⟩ := hx
      rw [← differentialJet_succ]
      exact Algebra.subset_adjoin ⟨(i, n + 1), rfl⟩
  | algebraMap a =>
      rw [DifferentialAlgebra.deriv_algebraMap]
      exact Subalgebra.algebraMap_mem _ _
  | add x z _ _ hx hz =>
      rw [map_add]
      exact Subalgebra.add_mem _ hx hz
  | mul x z hxmem hzmem hx hz =>
      rw [Derivation.leibniz]
      simp only [smul_eq_mul]
      exact Subalgebra.add_mem _
        (Subalgebra.mul_mem _ hxmem hz) (Subalgebra.mul_mem _ hzmem hx)

/-- Differential structure inherited by a jet-generated subalgebra. -/
instance differentialGeneratorSubalgebraDifferential {ι : Type v} (y : ι → B) :
    Differential (differentialGeneratorSubalgebra (A := A) y) where
  deriv :=
    { toLinearMap :=
        { toFun := fun x =>
            ⟨Differential.deriv x.1,
              differentialGeneratorSubalgebra_deriv_stable y x.1 x.2⟩
          map_add' := fun x z => Subtype.ext (Differential.deriv.map_add x.1 z.1)
          map_smul' := fun n x => Subtype.ext (Differential.deriv.map_smul n x.1) }
      map_one_eq_zero' := Subtype.ext Differential.deriv.map_one_eq_zero
      leibniz' := fun x z => Subtype.ext (Differential.deriv.leibniz x.1 z.1) }

@[simp] theorem differentialGeneratorSubalgebra_deriv_coe {ι : Type v} (y : ι → B)
    (x : differentialGeneratorSubalgebra (A := A) y) :
    ((Differential.deriv x : differentialGeneratorSubalgebra (A := A) y) : B) =
      Differential.deriv (x : B) := rfl

/-- Coefficient derivation restricts to the jet-generated subalgebra. -/
instance differentialGeneratorSubalgebraDifferentialAlgebra {ι : Type v} (y : ι → B) :
    DifferentialAlgebra A (differentialGeneratorSubalgebra (A := A) y) where
  deriv_algebraMap a := by
    apply Subtype.ext
    exact DifferentialAlgebra.deriv_algebraMap a

/-- Original generators, corestricted to their jet-generated subalgebra. -/
def differentialGeneratorIn {ι : Type v} (y : ι → B) (i : ι) :
    differentialGeneratorSubalgebra (A := A) y :=
  ⟨y i, by
    rw [← differentialJet_zero (y i)]
    exact Algebra.subset_adjoin ⟨(i, 0), rfl⟩⟩

@[simp] theorem differentialGeneratorIn_coe {ι : Type v} (y : ι → B) (i : ι) :
    ((differentialGeneratorIn (A := A) y i :
      differentialGeneratorSubalgebra (A := A) y) : B) = y i := rfl

@[simp] theorem differentialJet_differentialGeneratorIn_coe {ι : Type v}
    (y : ι → B) (i : ι) (n : ℕ) :
    ((differentialJet n (differentialGeneratorIn (A := A) y i) :
      differentialGeneratorSubalgebra (A := A) y) : B) = differentialJet n (y i) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [differentialJet_succ, differentialJet_succ]
      change Differential.deriv
          (((differentialJet n (differentialGeneratorIn (A := A) y i)) :
            differentialGeneratorSubalgebra (A := A) y) : B) =
        Differential.deriv (differentialJet n (y i))
      rw [ih]

/-- Evaluation at the corestricted generators agrees with ambient evaluation. -/
theorem differentialPolynomialEvalOver_generatorIn_coe {ι : Type v}
    (y : ι → B) (Q : DifferentialPolynomial ι A) :
    ((differentialPolynomialEvalOver (K := A)
        (fun i => differentialGeneratorIn (A := A) y i) Q :
      differentialGeneratorSubalgebra (A := A) y) : B) =
      differentialPolynomialEvalOver (K := A) y Q := by
  induction Q using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simpa using congrArg₂ (· + ·) hP hQ
  | mul_X P p hP =>
      rw [map_mul, map_mul]
      change
        ((differentialPolynomialEvalOver (K := A)
            (fun i => differentialGeneratorIn (A := A) y i) P :
          differentialGeneratorSubalgebra (A := A) y) : B) *
            ((differentialPolynomialEvalOver (K := A)
              (fun i => differentialGeneratorIn (A := A) y i)
              (MvPolynomial.X p) :
            differentialGeneratorSubalgebra (A := A) y) : B) =
          differentialPolynomialEvalOver (K := A) y P *
            differentialPolynomialEvalOver (K := A) y (MvPolynomial.X p)
      rw [hP]
      rw [differentialPolynomialEvalOver_X, differentialPolynomialEvalOver_X]
      exact congrArg _ (differentialJet_differentialGeneratorIn_coe y p.1 p.2)

/-- The original family differentially generates its jet-generated subalgebra. -/
theorem differentialPolynomialEvalOver_generatorIn_surjective {ι : Type v} (y : ι → B) :
    Function.Surjective
      (differentialPolynomialEvalOver (K := A)
        (fun i => differentialGeneratorIn (A := A) y i)) := by
  intro e
  have he : (e : B) ∈
      (differentialPolynomialEvalOver (K := A) y).range := by
    rw [← differentialGeneratorSubalgebra_eq_range]
    exact e.2
  obtain ⟨Q, hQ⟩ := he
  refine ⟨Q, Subtype.ext ?_⟩
  exact (differentialPolynomialEvalOver_generatorIn_coe y Q).trans hQ

/-- Reinterpret a differential polynomial in an initial family and one last generator as a
one-variable differential polynomial over the initial jet-generated subalgebra. -/
def splitLastDifferentialPolynomial {n : ℕ} (y : Fin (n + 1) → B) :
    DifferentialPolynomial (Fin (n + 1)) A →+*
      DifferentialPolynomial Unit
        (differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc)) :=
  MvPolynomial.eval₂Hom
    ((MvPolynomial.C :
      differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc) →+*
        DifferentialPolynomial Unit
          (differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc))).comp
      (algebraMap A
        (differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc))))
    (fun p => Fin.lastCases
      (MvPolynomial.X ((), p.2))
      (fun i => MvPolynomial.C
        (differentialJet p.2
          (differentialGeneratorIn (A := A)
            (fun j : Fin n => y j.castSucc) i)))
      p.1)

@[simp] theorem splitLastDifferentialPolynomial_X_last {n : ℕ}
    (y : Fin (n + 1) → B) (j : ℕ) :
    splitLastDifferentialPolynomial (A := A) y
        (MvPolynomial.X (Fin.last n, j)) =
      MvPolynomial.X ((), j) := by
  simp [splitLastDifferentialPolynomial]

@[simp] theorem splitLastDifferentialPolynomial_X_castSucc {n : ℕ}
    (y : Fin (n + 1) → B) (i : Fin n) (j : ℕ) :
    splitLastDifferentialPolynomial (A := A) y
        (MvPolynomial.X (i.castSucc, j)) =
      MvPolynomial.C
        (differentialJet j
          (differentialGeneratorIn (A := A)
            (fun k : Fin n => y k.castSucc) i)) := by
  simp [splitLastDifferentialPolynomial]

/-- Splitting the last generator preserves differential-polynomial evaluation. -/
theorem differentialPolynomialEvalOver_splitLast {n : ℕ} (y : Fin (n + 1) → B)
    (Q : DifferentialPolynomial (Fin (n + 1)) A) :
    differentialPolynomialEvalOver
        (K := differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc))
        (fun _ : Unit => y (Fin.last n))
        (splitLastDifferentialPolynomial (A := A) y Q) =
      differentialPolynomialEvalOver (K := A) y Q := by
  induction Q using MvPolynomial.induction_on with
  | C a =>
      simp [splitLastDifferentialPolynomial]
  | add P Q hP hQ =>
      simpa using congrArg₂ (· + ·) hP hQ
  | mul_X P p hP =>
      rcases p with ⟨i, j⟩
      refine Fin.lastCases ?_ (fun k => ?_) i
      · simp only [map_mul]
        rw [hP]
        rw [splitLastDifferentialPolynomial_X_last]
        simp
      · simp only [map_mul]
        rw [hP]
        rw [splitLastDifferentialPolynomial_X_castSucc]
        simp

/-- Full finite differential generation makes the last coordinate a one-generator extension of
the initial jet-generated subalgebra. -/
theorem differentialPolynomialEvalOver_last_surjective {n : ℕ}
    (y : Fin (n + 1) → B)
    (hy : Function.Surjective (differentialPolynomialEvalOver (K := A) y)) :
    Function.Surjective
      (differentialPolynomialEvalOver
        (K := differentialGeneratorSubalgebra (A := A) (fun i : Fin n => y i.castSucc))
        (fun _ : Unit => y (Fin.last n))) := by
  intro b
  obtain ⟨Q, rfl⟩ := hy b
  exact ⟨splitLastDifferentialPolynomial (A := A) y Q,
    differentialPolynomialEvalOver_splitLast y Q⟩

end

end GaloisForLFunctions.HTGeometry
