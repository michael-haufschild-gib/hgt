import GaloisForLFunctions.HTGeometry.TopExteriorPowerDeterminant

/-!
# An invariant coframe has a nonzero eigenvolume

The top exterior power of a module with a finite basis is free of rank one, generated by the wedge
of the whole basis, which is therefore nonzero.  An automorphism acts on it by the determinant,
which is a unit.

Applied to a coframe this is the first step of the eigenvolume horizon theorem: the top wedge of an
invariant coframe is a nonzero volume form, and pulling it back multiplies it by a unit.  The
nonvanishing matters, since the order of the zero form is not defined.
-/

namespace GaloisForLFunctions.HTGeometry

variable {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]
variable [Fintype ι] [LinearOrder ι]

/-- **The wedge of a whole basis is nonzero.** -/
theorem topWedge_ne_zero [Nontrivial R] (b : Module.Basis ι R M) :
    (b.exteriorPower (Fintype.card ι)) default ≠ 0 :=
  Module.Basis.ne_zero _ _

/-- **An invariant coframe has a nonzero eigenvolume.**  The top wedge of the coframe is a nonzero
element of the top exterior power, and the induced map multiplies it by the determinant, a unit. -/
theorem exists_ne_zero_eigenvolume [Nontrivial R] (b : Module.Basis ι R M) (f : M ≃ₗ[R] M) :
    ∃ (Ω : ⋀[R]^(Fintype.card ι) M) (u : Rˣ), Ω ≠ 0 ∧
      exteriorPower.map (Fintype.card ι) (f : M →ₗ[R] M) Ω = (u : R) • Ω := by
  obtain ⟨u, hu⟩ := exteriorPower_map_card_eq_unit_smul b f
  exact ⟨(b.exteriorPower (Fintype.card ι)) default, u, topWedge_ne_zero b, hu _⟩

/-- **Every top form is a scalar multiple of the wedge of a basis.**  The top exterior power is
free of rank one, so its elements are determined by a single coordinate. -/
theorem eq_smul_topWedge (b : Module.Basis ι R M) (x : ⋀[R]^(Fintype.card ι) M) :
    x = ((b.exteriorPower (Fintype.card ι)).repr x default) •
      (b.exteriorPower (Fintype.card ι)) default := by
  have h := (b.exteriorPower (Fintype.card ι)).sum_repr x
  rw [Fintype.sum_unique] at h
  exact h.symm

/-- **The ratio of two nonzero top forms is a nonzero scalar.**  Over a field this is the statement
that a nonzero rational top form is a nonzero rational function times a fixed one, which is what
turns the divisor of a form into the divisor of a function. -/
theorem exists_ne_zero_smul_eq_of_ne_zero {K : Type*} [Field K] [Module K M]
    (b : Module.Basis ι K M) {x : ⋀[K]^(Fintype.card ι) M} (hx : x ≠ 0) :
    ∃ c : K, c ≠ 0 ∧ x = c • (b.exteriorPower (Fintype.card ι)) default := by
  refine ⟨(b.exteriorPower (Fintype.card ι)).repr x default, ?_, eq_smul_topWedge b x⟩
  intro hc
  exact hx (by rw [eq_smul_topWedge b x, hc, zero_smul])

end GaloisForLFunctions.HTGeometry
