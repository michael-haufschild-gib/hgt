import GaloisForLFunctions.HTGeometry.PlaceShiftIterate

/-!
# The class the peel stays in, at a place

In the coordinate model the peel never leaves `lowSub`, the algebra generated by the coordinates
and the inverses of the factors, and that closure is what lets the degree bound be iterated.  At a
place the corresponding class is the rational functions of the large element with coefficients in
the trivially valued subfield.

It is closed under the field operations and under the model's derivation, and on it the derivation
drops one degree — which is exactly the pair of hypotheses `placeDegLE_iterate_placeShift` consumes.

* `CoeffsIn.add`, `CoeffsIn.mul`, `CoeffsIn.C`, `CoeffsIn.X`;
* `RatIn`, `ratIn_add`, `ratIn_mul`, `ratIn_neg`, `ratIn_sub`, `ratIn_inv`, `ratIn_C`, `ratIn_X`;
* `ratIn_derivation` — **the class is stable under the derivation**;
* `valuation_derivation_mul_le_of_ratIn` — **the drop holds on the whole class**.
-/

namespace GaloisForLFunctions.HTGeometry

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum WithZero Polynomial

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
variable (v : HeightOneSpectrum R)

/-! ## Coefficients in a subfield -/

theorem CoeffsIn.add {F : Subfield K} {p q : Polynomial K} (hp : CoeffsIn F p)
    (hq : CoeffsIn F q) : CoeffsIn F (p + q) := by
  intro i
  rw [Polynomial.coeff_add]
  exact F.add_mem (hp i) (hq i)

theorem CoeffsIn.mul {F : Subfield K} {p q : Polynomial K} (hp : CoeffsIn F p)
    (hq : CoeffsIn F q) : CoeffsIn F (p * q) := by
  classical
  intro n
  rw [Polynomial.coeff_mul]
  exact Subfield.sum_mem _ fun t _ => F.mul_mem (hp t.1) (hq t.2)

theorem CoeffsIn.neg {F : Subfield K} {p : Polynomial K} (hp : CoeffsIn F p) :
    CoeffsIn F (-p) := by
  intro i
  rw [Polynomial.coeff_neg]
  exact F.neg_mem (hp i)

theorem CoeffsIn.C {F : Subfield K} {a : K} (ha : a ∈ F) :
    CoeffsIn F (Polynomial.C a) := by
  intro i
  rw [Polynomial.coeff_C]
  by_cases h : i = 0
  · rw [if_pos h]
    exact ha
  · rw [if_neg h]
    exact F.zero_mem

theorem CoeffsIn.X {F : Subfield K} : CoeffsIn F (Polynomial.X : Polynomial K) := by
  intro i
  rw [Polynomial.coeff_X]
  by_cases h : 1 = i
  · rw [if_pos h]
    exact F.one_mem
  · rw [if_neg h]
    exact F.zero_mem

theorem CoeffsIn.pow {F : Subfield K} {p : Polynomial K} (hp : CoeffsIn F p) (k : ℕ) :
    CoeffsIn F (p ^ k) := by
  induction k with
  | zero =>
      simpa using CoeffsIn.C (F := F) F.one_mem
  | succ k ih =>
      rw [pow_succ]
      exact CoeffsIn.mul ih hp

/-! ## The class -/

/-- The rational functions of `x` with coefficients in the subfield. -/
def RatIn (F : Subfield K) (x : K) : Set K :=
  {f | ∃ p q : Polynomial K,
    CoeffsIn F p ∧ CoeffsIn F q ∧ q.eval x ≠ 0 ∧ f = p.eval x / q.eval x}

theorem coeffsIn_one {F : Subfield K} : CoeffsIn F (1 : Polynomial K) := by
  simpa using CoeffsIn.C (F := F) F.one_mem

theorem ratIn_C {F : Subfield K} {x a : K} (ha : a ∈ F) : a ∈ RatIn F x :=
  ⟨Polynomial.C a, 1, CoeffsIn.C ha, coeffsIn_one, by simp, by simp⟩

theorem ratIn_X {F : Subfield K} {x : K} : x ∈ RatIn F x :=
  ⟨Polynomial.X, 1, CoeffsIn.X, coeffsIn_one, by simp, by simp⟩

theorem ratIn_poly {F : Subfield K} {x : K} {p : Polynomial K} (hp : CoeffsIn F p) :
    p.eval x ∈ RatIn F x :=
  ⟨p, 1, hp, coeffsIn_one, by simp, by simp⟩

theorem ratIn_add {F : Subfield K} {x f g : K} (hf : f ∈ RatIn F x) (hg : g ∈ RatIn F x) :
    f + g ∈ RatIn F x := by
  obtain ⟨p₁, q₁, hp₁, hq₁, hq₁0, rfl⟩ := hf
  obtain ⟨p₂, q₂, hp₂, hq₂, hq₂0, rfl⟩ := hg
  refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, CoeffsIn.add (CoeffsIn.mul hp₁ hq₂) (CoeffsIn.mul hp₂ hq₁),
    CoeffsIn.mul hq₁ hq₂, ?_, ?_⟩
  · simp only [Polynomial.eval_mul]
    exact mul_ne_zero hq₁0 hq₂0
  · simp only [Polynomial.eval_add, Polynomial.eval_mul]
    field_simp

theorem ratIn_mul {F : Subfield K} {x f g : K} (hf : f ∈ RatIn F x) (hg : g ∈ RatIn F x) :
    f * g ∈ RatIn F x := by
  obtain ⟨p₁, q₁, hp₁, hq₁, hq₁0, rfl⟩ := hf
  obtain ⟨p₂, q₂, hp₂, hq₂, hq₂0, rfl⟩ := hg
  refine ⟨p₁ * p₂, q₁ * q₂, CoeffsIn.mul hp₁ hp₂, CoeffsIn.mul hq₁ hq₂, ?_, ?_⟩
  · simp only [Polynomial.eval_mul]
    exact mul_ne_zero hq₁0 hq₂0
  · simp only [Polynomial.eval_mul]
    rw [div_mul_div_comm]

theorem ratIn_neg {F : Subfield K} {x f : K} (hf : f ∈ RatIn F x) : -f ∈ RatIn F x := by
  obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hf
  exact ⟨-p, q, hp.neg, hq, hq0, by simp [neg_div]⟩

theorem ratIn_sub {F : Subfield K} {x f g : K} (hf : f ∈ RatIn F x) (hg : g ∈ RatIn F x) :
    f - g ∈ RatIn F x := by
  rw [sub_eq_add_neg]
  exact ratIn_add hf (ratIn_neg hg)

theorem ratIn_inv {F : Subfield K} {x f : K} (hf : f ∈ RatIn F x) : f⁻¹ ∈ RatIn F x := by
  obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hf
  rcases eq_or_ne (p.eval x) 0 with hp0 | hp0
  · refine ⟨0, 1, by simpa using CoeffsIn.C (F := F) F.zero_mem, coeffsIn_one, by simp, ?_⟩
    rw [hp0, zero_div, inv_zero]
    simp
  · refine ⟨q, p, hq, hp, hp0, ?_⟩
    field_simp

/-! ## Stability under the derivation -/

/-- **The class is stable under a derivation that kills the subfield and keeps the coordinate in
the class.** -/
theorem ratIn_derivation {A : Type*} [CommRing A] [Algebra A K] (D : Derivation A K K)
    {F : Subfield K} (hDF : ∀ a ∈ F, D a = 0)
    {x : K} (hDx : D x ∈ RatIn F x)
    {f : K} (hf : f ∈ RatIn F x) : D f ∈ RatIn F x := by
  obtain ⟨p, q, hp, hq, hqx, rfl⟩ := hf
  have hDp : D (p.eval x) = (Polynomial.derivative p).eval x * D x :=
    derivation_eval_of_coeff D (fun i => hDF _ (hp i)) x
  have hDq : D (q.eval x) = (Polynomial.derivative q).eval x * D x :=
    derivation_eval_of_coeff D (fun i => hDF _ (hq i)) x
  have hquot : D (p.eval x / q.eval x)
      = ((Polynomial.derivative p).eval x * q.eval x
          - p.eval x * (Polynomial.derivative q).eval x) * D x / q.eval x ^ (2 : ℕ) := by
    rw [Derivation.leibniz_div D (p.eval x) (q.eval x), hDp, hDq]
    simp only [smul_eq_mul]
    field_simp
  rw [hquot, div_eq_mul_inv]
  refine ratIn_mul (ratIn_mul ?_ hDx) ?_
  · refine ratIn_sub ?_ ?_
    · have h := ratIn_poly (F := F) (x := x) (CoeffsIn.mul hp.derivative hq)
      simpa using h
    · have h := ratIn_poly (F := F) (x := x) (CoeffsIn.mul hp hq.derivative)
      simpa using h
  · refine ratIn_inv ?_
    have h := ratIn_poly (F := F) (x := x) (hq.pow 2)
    simpa using h

/-! ## The drop on the class -/

/-- **The derivation drops one degree on the whole class.**  This is the hypothesis
`placeDegLE_iterate_placeShift` consumes. -/
theorem valuation_derivation_mul_le_of_ratIn {A : Type*} [CommRing A] [Algebra A K]
    (D : Derivation A K K) {F : Subfield K} (hF : PlaceTrivialOn v F)
    (hDF : ∀ a ∈ F, D a = 0) {x : K} (hx : 1 < v.valuation K x)
    (hDx : v.valuation K (D x) ≤ 1) {f : K} (hf : f ∈ RatIn F x) :
    v.valuation K (D f) * v.valuation K x ≤ v.valuation K f := by
  obtain ⟨p, q, hp, hq, hq0, rfl⟩ := hf
  have hqne : q ≠ 0 := fun h => hq0 (by rw [h, Polynomial.eval_zero])
  rcases eq_or_ne p 0 with rfl | hp0
  · simp
  · exact valuation_derivation_mul_le v D hF hDF hx hDx hp hq hp0 hqne

end GaloisForLFunctions.HTGeometry
