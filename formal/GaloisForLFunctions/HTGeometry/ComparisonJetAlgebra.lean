import GaloisForLFunctions.HTGeometry.ParameterizedTensorTorsor
import GaloisForLFunctions.HTGeometry.DifferenceTensorGeneration
import GaloisForLFunctions.HTGeometry.DifferentialGaloisSeparation

/-!
# The constants algebra generated by the comparison matrix

The parameterized torsor comparison matrix has entries that are constants of the difference operator
on the tensor square, and so are all their derivatives.  The `C`-subalgebra they generate, together
with the inverse of the determinant, is therefore a derivation-stable subalgebra of constants, and
it generates the tensor square over the left copy — the two structural hypotheses `hEδ` and `hgen`
of the isomonodromy endgame.

* `comparisonJetAlgebra`;
* `comparisonJetAlgebra_deriv_stable`;
* `adjoin_comparisonJetAlgebra_eq_top`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped TensorProduct Differential

universe u

variable {K R C : Type u} [Field K] [CommRing R] [Algebra K R]
  [Field C] [Algebra C K] [Algebra C R] [IsScalarTower C K R]
  [Differential K] [Differential R] [DifferentialAlgebra K R]
  [Differential C] [DifferentialAlgebra C R]
  {n : ℕ}

/-- The iterated derivation of the tensor square. -/
def tensorJet : ℕ → (R ⊗[K] R) → (R ⊗[K] R)
  | 0, x => x
  | (k + 1), x => tensorSquareDerivation (K := K) (tensorJet k x)

@[simp] theorem tensorJet_zero (x : R ⊗[K] R) : tensorJet (K := K) 0 x = x := rfl

@[simp] theorem tensorJet_succ (k : ℕ) (x : R ⊗[K] R) :
    tensorJet (K := K) (k + 1) x = tensorSquareDerivation (K := K) (tensorJet (K := K) k x) := rfl

/-- The generators: all jets of the entries of the comparison matrix. -/
def comparisonJetGens (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) : Set (R ⊗[K] R) :=
  ⋃ k : ℕ, Set.range fun p : Fin n × Fin n => tensorJet (K := K) k (Z p.1 p.2)

theorem mem_comparisonJetGens (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (k : ℕ) (i j : Fin n) :
    tensorJet (K := K) k (Z i j) ∈ comparisonJetGens Z :=
  Set.mem_iUnion.mpr ⟨k, ⟨(i, j), rfl⟩⟩

/-- The subalgebra generated by the jets alone. -/
def comparisonJetCore (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) : Subalgebra C (R ⊗[K] R) :=
  Algebra.adjoin C (comparisonJetGens Z)

/-- The subalgebra generated by the jets together with the inverse determinant. -/
def comparisonJetAlgebra (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    Subalgebra C (R ⊗[K] R) :=
  Algebra.adjoin C (comparisonJetGens Z ∪ {w})

omit [Differential C] [DifferentialAlgebra C R] in
theorem comparisonJetCore_le (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    comparisonJetCore (C := C) Z ≤ comparisonJetAlgebra (C := C) Z w :=
  Algebra.adjoin_mono Set.subset_union_left

omit [Differential C] [DifferentialAlgebra C R] in
theorem mem_comparisonJetAlgebra_entry (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R)
    (i j : Fin n) : Z i j ∈ comparisonJetAlgebra (C := C) Z w := by
  exact Algebra.subset_adjoin (Set.mem_union_left _ (mem_comparisonJetGens Z 0 i j))

omit [Differential C] [DifferentialAlgebra C R] in
theorem mem_comparisonJetAlgebra_w (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R) :
    w ∈ comparisonJetAlgebra (C := C) Z w :=
  Algebra.subset_adjoin (Set.mem_union_right _ rfl)

/-- The core is stable under the derivation of the tensor square. -/
theorem comparisonJetCore_deriv_stable (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R))
    {e : R ⊗[K] R} (he : e ∈ comparisonJetCore (C := C) Z) :
    tensorSquareDerivation (K := K) e ∈ comparisonJetCore (C := C) Z := by
  have hpred : ∀ x ∈ comparisonJetCore (C := C) Z,
      tensorSquareDerivation (K := K) x ∈ comparisonJetCore (C := C) Z := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hy
        obtain ⟨p, hp⟩ := hk
        have hval : tensorSquareDerivation (K := K) y = tensorJet (K := K) (k + 1) (Z p.1 p.2) := by
          rw [← hp, tensorJet_succ]
        rw [hval]
        exact Algebra.subset_adjoin (mem_comparisonJetGens Z (k + 1) p.1 p.2)
    | algebraMap c =>
        rw [tensorSquareDerivation_algebraMap]
        exact (comparisonJetCore (C := C) Z).algebraMap_mem _
    | add p q _ _ hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
    | mul p q hpmem hqmem hp hq =>
        rw [Derivation.leibniz]
        simp only [smul_eq_mul]
        exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hpmem hq)
          (Subalgebra.mul_mem _ hqmem hp)
  exact hpred e he

omit [Differential C] [DifferentialAlgebra C R] in
theorem det_mem_comparisonJetCore (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) :
    Z.det ∈ comparisonJetCore (C := C) Z := by
  set A : Subalgebra C (R ⊗[K] R) := comparisonJetCore (C := C) Z with hA
  set Z' : Matrix (Fin n) (Fin n) A := Matrix.of fun i j =>
    (⟨Z i j, Algebra.subset_adjoin (mem_comparisonJetGens Z 0 i j)⟩ : A) with hZ'
  have hmap : Z = Z'.map (Subalgebra.val A) := by
    refine Matrix.ext fun i j => ?_
    rw [Matrix.map_apply, hZ']
    rfl
  have hdet : (Z'.map ⇑(Subalgebra.val A)).det = (Subalgebra.val A) Z'.det := by
    have hmd := RingHom.map_det ((Subalgebra.val A).toRingHom) Z'
    rw [RingHom.mapMatrix_apply] at hmd
    exact hmd.symm
  rw [hmap, hdet]
  exact Z'.det.2

/-- **The comparison-jet algebra is derivation-stable.** -/
theorem comparisonJetAlgebra_deriv_stable (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R))
    {w : R ⊗[K] R} (hw : Z.det * w = 1)
    {e : R ⊗[K] R} (he : e ∈ comparisonJetAlgebra (C := C) Z w) :
    tensorSquareDerivation (K := K) e ∈ comparisonJetAlgebra (C := C) Z w := by
  have hderivw : tensorSquareDerivation (K := K) w
      = -(tensorSquareDerivation (K := K) Z.det * w * w) := by
    have h := congrArg (tensorSquareDerivation (K := K)) hw
    rw [Derivation.leibniz, Derivation.map_one_eq_zero] at h
    simp only [smul_eq_mul] at h
    have h2 : Z.det * tensorSquareDerivation (K := K) w
        = -(w * tensorSquareDerivation (K := K) Z.det) := by linear_combination h
    calc tensorSquareDerivation (K := K) w
        = (Z.det * w) * tensorSquareDerivation (K := K) w := by rw [hw, one_mul]
      _ = w * (Z.det * tensorSquareDerivation (K := K) w) := by ring
      _ = w * (-(w * tensorSquareDerivation (K := K) Z.det)) := by rw [h2]
      _ = -(tensorSquareDerivation (K := K) Z.det * w * w) := by ring
  have hpred : ∀ x ∈ comparisonJetAlgebra (C := C) Z w,
      tensorSquareDerivation (K := K) x ∈ comparisonJetAlgebra (C := C) Z w := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
        rcases hy with hy | hy
        · obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hy
          obtain ⟨p, hp⟩ := hk
          have hval : tensorSquareDerivation (K := K) y
              = tensorJet (K := K) (k + 1) (Z p.1 p.2) := by
            rw [← hp, tensorJet_succ]
          rw [hval]
          exact Algebra.subset_adjoin (Set.mem_union_left _ (mem_comparisonJetGens Z (k + 1) p.1 p.2))
        · rw [Set.mem_singleton_iff] at hy
          rw [hy, hderivw]
          refine Subalgebra.neg_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ ?_ ?_) ?_)
          · exact comparisonJetCore_le Z w
              (comparisonJetCore_deriv_stable Z (det_mem_comparisonJetCore Z))
          · exact mem_comparisonJetAlgebra_w Z w
          · exact mem_comparisonJetAlgebra_w Z w
    | algebraMap c =>
        rw [tensorSquareDerivation_algebraMap]
        exact (comparisonJetAlgebra (C := C) Z w).algebraMap_mem _
    | add p q _ _ hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
    | mul p q hpmem hqmem hp hq =>
        rw [Derivation.leibniz]
        simp only [smul_eq_mul]
        exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hpmem hq)
          (Subalgebra.mul_mem _ hqmem hp)
  exact hpred e he

omit [Differential C] [DifferentialAlgebra C R] in
/-- **The comparison-jet algebra generates the tensor square over the left copy.** -/
theorem adjoin_comparisonJetAlgebra_eq_top
    (Y : Matrix (Fin n) (Fin n) R) (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) = ⊤)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y) (hw : Z.det * w = 1) :
    Algebra.adjoin C (Set.range (algebraMap R (R ⊗[K] R))
      ∪ (comparisonJetAlgebra (C := C) Z w : Set (R ⊗[K] R))) = ⊤ := by
  set T : Set (R ⊗[K] R) := Set.range (algebraMap R (R ⊗[K] R))
    ∪ (comparisonJetAlgebra (C := C) Z w : Set (R ⊗[K] R)) with hT
  have hK := adjoin_tensor_comparison_eq_top Y u hu htop Z w hZ hw
  have hmem : ∀ y : R ⊗[K] R,
      y ∈ Algebra.adjoin K ((Set.range (fun x : R => x ⊗ₜ[K] (1 : R))
          ∪ Set.range (fun p : Fin n × Fin n => Z p.1 p.2)) ∪ {w}) →
      y ∈ Algebra.adjoin C T := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem z hz =>
        rcases hz with (⟨r, hr⟩ | ⟨p, hp⟩) | hz
        · refine Algebra.subset_adjoin (Set.mem_union_left _ ⟨r, ?_⟩)
          rw [← hr]
          rfl
        · refine Algebra.subset_adjoin (Set.mem_union_right _ ?_)
          rw [← hp]
          exact mem_comparisonJetAlgebra_entry Z w p.1 p.2
        · rw [Set.mem_singleton_iff] at hz
          refine Algebra.subset_adjoin (Set.mem_union_right _ ?_)
          rw [hz]
          exact mem_comparisonJetAlgebra_w Z w
    | algebraMap k =>
        have halg : algebraMap K (R ⊗[K] R) k
            = algebraMap R (R ⊗[K] R) (algebraMap K R k) := by
          rw [← IsScalarTower.algebraMap_apply]
        rw [halg]
        exact Algebra.subset_adjoin (Set.mem_union_left _ ⟨_, rfl⟩)
    | add p q _ _ hp hq => exact Subalgebra.add_mem _ hp hq
    | mul p q _ _ hp hq => exact Subalgebra.mul_mem _ hp hq
  refine top_unique fun x _ => ?_
  refine hmem x ?_
  rw [hK]
  exact Algebra.mem_top

end

end GaloisForLFunctions.HTGeometry
