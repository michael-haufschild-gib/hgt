import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianElimination
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianTransport

/-!
# The depth-one meet is exactly the Schwarzian field

The translation equation kills the derivative along the base coordinate outright.  Substituting the
scaling relation into the inversion equation collapses it to the square of the first jet times the
derivative along the second, so that vanishes too, and then so does the remaining one.

With the transported support-kernel theorem this identifies the common kernel of the chart currents
with the differential field generated by the Schwarzian.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {C : Type*} [Field C] [CharZero C]

theorem sum_three_eq {M : Type*} [AddCommMonoid M] (F : ℕ → M) :
    ∑ p ∈ ({0, 1, 2} : Finset ℕ), F p = F 0 + (F 1 + F 2) := by
  rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_singleton]

/-- **The reverse inclusion.**  A jet observable annihilated by the translation and inversion
currents is a rational function of the Schwarzian and its jets. -/
theorem mem_schwarzianDifferentialField_of_currents {f : FreeScalarJetField C}
    (hE : freeCoordinateDerivation C ℕ 0 f = 0) (hF : freeJetFZero C f = 0) :
    f ∈ schwarzianDifferentialField C := by
  classical
  have hX1 : (schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 1) ≠ 0 := by
    intro hcon
    exact freeScalarJetCoordinate_ne_zero 1
      ((schwarzianBasisEquiv C).symm.injective (by rw [hcon, map_zero]))
  have hEeq := current_chain (freeCoordinateDerivation C ℕ 0)
    freeCoordinateDerivation_zero_schwarzianJet f
  rw [hE, map_zero, sum_three_eq, freeCoordinateDerivation_freeCoordinate_self,
    freeCoordinateDerivation_freeCoordinate_of_ne (by omega),
    freeCoordinateDerivation_freeCoordinate_of_ne (by omega), map_one, map_zero] at hEeq
  have ha : freeCoordinateDerivation C ℕ 0 ((schwarzianBasisEquiv C).symm f) = 0 := by
    simp only [one_mul, zero_mul, add_zero] at hEeq
    exact hEeq.symm
  have hH : jetH C f = 0 := jetH_eq_zero_of hE hF
  have hHeq := current_chain (jetH C) jetH_schwarzianJet f
  rw [hH, map_zero, sum_three_eq, jetH_freeCoordinate_zero, jetH_freeCoordinate_one,
    jetH_freeCoordinate_two] at hHeq
  have hFeq := current_chain (freeJetFZero C) freeJetFZero_schwarzianJet f
  rw [hF, map_zero, sum_three_eq, freeJetFZero_freeCoordinate', freeJetFZero_freeCoordinate',
    freeJetFZero_freeCoordinate', squareJet_zero, squareJet_one, squareJet_two] at hFeq
  simp only [map_neg, map_mul, map_add, map_pow, map_ofNat] at hHeq hFeq
  have hcc : (schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 1) ^ 2 *
      freeCoordinateDerivation C ℕ 2 ((schwarzianBasisEquiv C).symm f) = 0 := by
    linear_combination (-((schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 0)) / 2) * hHeq +
      ((1 : FreeCoordinateRationalField C ℕ) / 2) * hFeq +
      ((schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 0) ^ 2 / 2) * ha
  have hc0 : freeCoordinateDerivation C ℕ 2 ((schwarzianBasisEquiv C).symm f) = 0 := by
    rcases mul_eq_zero.1 hcc with h | h
    · exact absurd (pow_eq_zero_iff (n := 2) (by omega) |>.1 h) hX1
    · exact h
  have hb0 : freeCoordinateDerivation C ℕ 1 ((schwarzianBasisEquiv C).symm f) = 0 := by
    have h2 : (schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 1) *
        freeCoordinateDerivation C ℕ 1 ((schwarzianBasisEquiv C).symm f) = 0 := by
      linear_combination ((1 : FreeCoordinateRationalField C ℕ) / 2) * hHeq +
        (-((schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 0))) * ha +
        (-((schwarzianBasisEquiv C).symm (freeCoordinate C ℕ 2))) * hc0
    rcases mul_eq_zero.1 h2 with h | h
    · exact absurd h hX1
    · exact h
  refine mem_schwarzianDifferentialField_of_forall ?_
  intro m hm
  interval_cases m
  · exact ha
  · exact hb0
  · exact hc0

end

end GaloisForLFunctions.HTGeometry
