import GaloisForLFunctions.HTGeometry.GomesDerivativeReflectionGeneratedAlgebra

/-!
# The matrix boundary is exactly preservation of constant polynomials

An arbitrary second-derivative symmetry sends 1 to an affine polynomial. Its
linear coefficient is the constant term of the lower-left formal matrix entry.
Thus the generated-algebra obstruction has an exact meaning on actual inputs.
-/

noncomputable section
open Polynomial
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- A full formal matrix acts on one residue-chain basis vector through one matrix column. -/
theorem gomesPolynomialDerivativePowerCommutantEquiv_symm_residue_basis
    (m : ℕ) [NeZero m] (M : Matrix (Fin m) (Fin m) (PowerSeries K)) (n : ℕ) (r : Fin m) :
    ((gomesPolynomialDerivativePowerCommutantEquiv K m).symm M).val
      (gomesDividedMonomialBasis K (n * m + r.val)) =
        (gomesPolynomialResidueChainEquiv K m).symm
          (fun i => gomesFormalSeriesPolynomialOperator K (M i r) (gomesDividedMonomialBasis K n)) := by
  rw [gomesPolynomialDerivativePowerCommutantEquiv_symm_apply, gomesPolynomialResidueChainEquiv_basis]
  congr 1
  funext i
  simp [Pi.single_apply, apply_ite]

/-- The two-chain reconstruction sends the constant seed to an explicitly observed affine polynomial. -/
theorem gomesTwoChainMatrixOperator_one (M : Matrix (Fin 2) (Fin 2) (PowerSeries K)) :
    ((gomesPolynomialDerivativePowerCommutantEquiv K 2).symm M).val 1 =
      PowerSeries.coeff 0 (M 0 0) • (1 : K[X]) + PowerSeries.coeff 0 (M 1 0) • (X : K[X]) := by
  have hb1 : gomesDividedMonomialBasis K 1 = (X : K[X]) := by
    simp [gomesDividedMonomialBasis_apply]
  rw [← gomesDividedMonomialBasis_zero K, ← hb1]
  apply (gomesPolynomialResidueChainEquiv K 2).injective
  have hseed := gomesPolynomialDerivativePowerCommutantEquiv_symm_residue_basis K 2 M 0 0
  simp only [Nat.zero_mul, Nat.zero_add, Fin.val_zero] at hseed
  rw [hseed, LinearEquiv.apply_symm_apply, map_add, map_smul, map_smul]
  have h0 := gomesPolynomialResidueChainEquiv_basis K 2 0 0
  have h1 := gomesPolynomialResidueChainEquiv_basis K 2 0 1
  simp only [Nat.zero_mul, Nat.zero_add, Fin.val_zero, Fin.val_one] at h0 h1
  rw [h0, h1]
  funext i
  revert i
  simp [Fin.forall_fin_two, gomesFormalSeriesPolynomialOperator_basis, gomesFormalSeriesBasisImage_zero]

/-- Every actual second-derivative symmetry's constant input reveals its lower-left matrix constant. -/
theorem gomesPolynomialSecondDerivativeCommutant_apply_one
    (E : GomesPolynomialDerivativePowerCommutant K 2) :
    E.val 1 =
      PowerSeries.coeff 0 (gomesPolynomialDerivativePowerCommutantEquiv K 2 E 0 0) • (1 : K[X]) +
      PowerSeries.coeff 0 (gomesPolynomialDerivativePowerCommutantEquiv K 2 E 1 0) • (X : K[X]) := by
  have h := gomesTwoChainMatrixOperator_one K (gomesPolynomialDerivativePowerCommutantEquiv K 2 E)
  have he := congrArg (fun T : GomesPolynomialDerivativePowerCommutant K 2 => T.val 1)
    ((gomesPolynomialDerivativePowerCommutantEquiv K 2).symm_apply_apply E)
  exact he.symm.trans h

/-- The exact formal matrix boundary is the vanishing derivative of the constant input's output. -/
theorem gomesPolynomialSecondDerivativeCommutant_constantLine_iff
    (E : GomesPolynomialDerivativePowerCommutant K 2) :
    gomesPolynomialDerivativePowerCommutantEquiv K 2 E ∈ gomesFormalConstantLineOrder K ↔
      (E.val 1).derivative = 0 := by
  rw [gomesFormalConstantLineOrder_mem_iff, gomesPolynomialSecondDerivativeCommutant_apply_one]
  simp [Polynomial.smul_eq_C_mul, PowerSeries.coeff_zero_eq_constantCoeff_apply]

omit [CharZero K] in
/-- A linear polynomial endomorphism preserves every constant exactly when it preserves the constant seed. -/
theorem gomesPolynomialEnd_preserves_constants_iff (E : Module.End K K[X]) :
    (∀ c : K, (E (C c)).derivative = 0) ↔ (E 1).derivative = 0 := by
  constructor
  · intro h
    simpa only [map_one] using h 1
  · intro h c
    have hc : (C c : K[X]) = c • (1 : K[X]) := by simp [Polynomial.smul_eq_C_mul]
    rw [hc, map_smul, map_smul, h, smul_zero]

/-- Exact actual-input criterion for belonging to the algebra generated by D and any affine reflection. -/
theorem gomesPolynomialSecondDerivativeCommutant_generated_iff_preserves_constants
    (c : K) (E : GomesPolynomialDerivativePowerCommutant K 2) :
    gomesPolynomialDerivativePowerCommutantEquiv K 2 E ∈ gomesDerivativeReflectionGeneratedAlgebra K c ↔
      ∀ a : K, (E.val (C a)).derivative = 0 := by
  rw [gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine,
    gomesPolynomialSecondDerivativeCommutant_constantLine_iff, gomesPolynomialEnd_preserves_constants_iff]

end GaloisForLFunctions.HTGeometry
