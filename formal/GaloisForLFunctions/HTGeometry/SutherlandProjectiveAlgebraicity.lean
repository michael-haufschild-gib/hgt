import GaloisForLFunctions.HTGeometry.SutherlandLinearisation
import GaloisForLFunctions.HTGeometry.MatrixEntriesInSubfield
import GaloisForLFunctions.HTGeometry.FlipDiagonalScattering

/-!
# Projective differential algebraicity from the Sutherland identity

A matrix `Y` over a differential field which satisfies the Sutherland identity with a constant
`H`, is normalised at an anchor entry, and whose Sutherland endomorphism is invertible, has its
whole derivative determined rationally by its own entries.  The field generated by its entries is
therefore derivation closed and of finite transcendence degree, so every entry is differentially
algebraic over the coefficient field.

Nothing here is specific to a state dimension, and no classification of solutions is used: the
Sutherland identity plus invertibility of one explicit finite linear system is the whole input.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Matrix

open scoped Differential

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E]
variable {κ : Type*} [DecidableEq κ]

theorem EntriesIn.sutherlandSolve {S : IntermediateField F E} (u₀ : κ)
    {W : Matrix (TripleIndex κ) (TripleIndex κ) E} (hW : EntriesIn S W) :
    EntriesIn S (HTGeometry.sutherlandSolve u₀ W) := by
  intro q r
  rw [HTGeometry.sutherlandSolve, Matrix.of_apply]
  by_cases h1 : q.1 = r.1
  · by_cases h2 : q.2 = r.2 <;> simp only [h1, h2, if_true, if_false]
    · exact S.add_mem (hW _ _) (hW _ _)
    · exact hW _ _
  · simp only [h1, if_false]
    exact S.neg_mem (hW _ _)

variable [Fintype κ]

theorem EntriesIn.sutherlandOp {S : IntermediateField F E} (u₀ : κ)
    {X Z : Matrix (κ × κ) (κ × κ) E} (hX : EntriesIn S X) (hZ : EntriesIn S Z) :
    EntriesIn S (HTGeometry.sutherlandOp u₀ X Z) := by
  refine EntriesIn.add (EntriesIn.sutherlandSolve u₀ ?_)
    (EntriesIn.smul (hZ _ _) EntriesIn.one)
  exact EntriesIn.sub (EntriesIn.mul (EntriesIn.legLeft hX) (EntriesIn.legRight hZ))
    (EntriesIn.mul (EntriesIn.legLeft hZ) (EntriesIn.legRight hX))

/-- The Sutherland source term built from a matrix and a constant. -/
def sutherlandSource (X H : Matrix (κ × κ) (κ × κ) E) :
    Matrix (TripleIndex κ) (TripleIndex κ) E :=
  legRight H * (legLeft X * legRight X) - (legLeft X * legRight X) * legLeft H

theorem EntriesIn.sutherlandSource {S : IntermediateField F E}
    {X H : Matrix (κ × κ) (κ × κ) E} (hX : EntriesIn S X) (hH : EntriesIn S H) :
    EntriesIn S (HTGeometry.sutherlandSource X H) := by
  refine EntriesIn.sub ?_ ?_
  · exact EntriesIn.mul (EntriesIn.legRight hH)
      (EntriesIn.mul (EntriesIn.legLeft hX) (EntriesIn.legRight hX))
  · exact EntriesIn.mul (EntriesIn.mul (EntriesIn.legLeft hX) (EntriesIn.legRight hX))
      (EntriesIn.legLeft hH)

variable [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- **The Sutherland identity determines the derivative rationally.**  If `Y` is anchored at
`Y (u₀,u₀) (u₀,u₀) = 1`, satisfies the Sutherland identity with a constant `H`, and its Sutherland
endomorphism is invertible, then every entry of `Y′` lies in the field generated by the entries
of `Y`. -/
theorem entrywiseDeriv_mem_adjoin_of_sutherland (u₀ : κ)
    (Y : Matrix (κ × κ) (κ × κ) E) (H : Matrix (κ × κ) (κ × κ) F)
    (hpivot : Y (u₀, u₀) (u₀, u₀) = 1)
    (hsuth : legLeft Y * legRight (entrywiseDeriv Y) - legLeft (entrywiseDeriv Y) * legRight Y
      = sutherlandSource Y (H.map (algebraMap F E)))
    (hdet : (sutherlandMatrix u₀ Y).det ≠ 0)
    (q : (κ × κ) × (κ × κ)) :
    (Y q.1 q.2)′ ∈
      IntermediateField.adjoin F (Set.range fun r : (κ × κ) × (κ × κ) => Y r.1 r.2) := by
  classical
  set S : IntermediateField F E :=
    IntermediateField.adjoin F (Set.range fun r : (κ × κ) × (κ × κ) => Y r.1 r.2) with hS
  have hYS : EntriesIn S Y := by
    intro i j
    exact IntermediateField.subset_adjoin F _ ⟨(i, j), rfl⟩
  have hHS : EntriesIn S (H.map (algebraMap F E)) := EntriesIn.map_algebraMap H
  set D : Matrix (κ × κ) (κ × κ) E := entrywiseDeriv Y with hD
  have hDpivot : D (u₀, u₀) (u₀, u₀) = 0 := by
    show (Y (u₀, u₀) (u₀, u₀))′ = 0
    rw [hpivot]
    simp
  have hop : sutherlandOp u₀ Y D =
      HTGeometry.sutherlandSolve u₀ (sutherlandSource Y (H.map (algebraMap F E))) := by
    rw [sutherlandOp, hsuth, hDpivot, zero_smul, add_zero]
  have hvec : (sutherlandMatrix u₀ Y) *ᵥ (fun s => D s.1 s.2) =
      fun t => HTGeometry.sutherlandSolve u₀
        (sutherlandSource Y (H.map (algebraMap F E))) t.1 t.2 := by
    rw [sutherlandMatrix_mulVec, hop]
  have hunit : IsUnit (sutherlandMatrix u₀ Y).det := isUnit_iff_ne_zero.mpr hdet
  have hsolve : (fun s : (κ × κ) × (κ × κ) => D s.1 s.2) =
      (sutherlandMatrix u₀ Y)⁻¹ *ᵥ
        (fun t => HTGeometry.sutherlandSolve u₀
          (sutherlandSource Y (H.map (algebraMap F E))) t.1 t.2) := by
    rw [← hvec, Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hunit, Matrix.one_mulVec]
  have hMS : EntriesIn S (sutherlandMatrix u₀ Y) := by
    intro t s
    exact EntriesIn.sutherlandOp u₀ hYS (EntriesIn.single s.1 s.2) t.1 t.2
  have hbS : ∀ t : (κ × κ) × (κ × κ),
      HTGeometry.sutherlandSolve u₀
        (sutherlandSource Y (H.map (algebraMap F E))) t.1 t.2 ∈ S := fun t =>
    EntriesIn.sutherlandSolve u₀ (EntriesIn.sutherlandSource hYS hHS) t.1 t.2
  have hmem : D q.1 q.2 ∈ S := by
    have := congrFun hsolve q
    rw [this]
    exact EntriesIn.mulVec (EntriesIn.inv hMS) hbS q
  exact hmem

/-- **Projective differential algebraicity.**  Under the same hypotheses every entry of `Y` is
differentially algebraic over the coefficient field. -/
theorem differentialAlgebraicOver_entry_of_sutherland (u₀ : κ)
    (Y : Matrix (κ × κ) (κ × κ) E) (H : Matrix (κ × κ) (κ × κ) F)
    (hpivot : Y (u₀, u₀) (u₀, u₀) = 1)
    (hsuth : legLeft Y * legRight (entrywiseDeriv Y) - legLeft (entrywiseDeriv Y) * legRight Y
      = sutherlandSource Y (H.map (algebraMap F E)))
    (hdet : (sutherlandMatrix u₀ Y).det ≠ 0)
    (a b : κ × κ) :
    DifferentialAlgebraicOver F (Y a b) := by
  refine differentialAlgebraicOver_of_mem_finiteGeneratorState
    (fun r : (κ × κ) × (κ × κ) => Y r.1 r.2)
    (entrywiseDeriv_mem_adjoin_of_sutherland u₀ Y H hpivot hsuth hdet)
    (IntermediateField.subset_adjoin F _ ⟨(a, b), rfl⟩)

end

end GaloisForLFunctions.HTGeometry
