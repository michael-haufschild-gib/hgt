import GaloisForLFunctions.HTGeometry.ProjectiveHorizonOneSidedCurrentAlgebra
import Mathlib.Data.Matrix.Basis

/-!
# Arbitrary-rank one-sided projective horizon current generation

Let `ι` index the projective directions transverse to the two-dimensional quotient selected by
two distinct horizon normals. The generated finite algebra is

`sl₂ ⋉ Hom(K²,K^ι)`.

Two opposing constant chart radicals and one linear semisimple root mode generate every
polynomial current mode of this algebra. This formalizes the all-projective-dimension symmetry
engine of the one-sided horizon transition.
-/

open scoped Matrix Polynomial

namespace GaloisForLFunctions

noncomputable section

variable (K ι : Type*) [Field K] [Fintype ι] [DecidableEq ι]

/-- Matrix indices split into the two-dimensional normal quotient and arbitrary transverse
directions. -/
abbrev arCurrentIndex := Sum (Fin 2) ι

/-- The upper `sl₂` root current mode. -/
def arCurrentE (k : ℕ) : Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K) :=
  Matrix.single (Sum.inl 0) (Sum.inl 1) (Polynomial.X ^ k)

/-- The lower `sl₂` root current mode. -/
def arCurrentF (k : ℕ) : Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K) :=
  Matrix.single (Sum.inl 1) (Sum.inl 0) (Polynomial.X ^ k)

/-- A transverse shear from the first quotient coordinate. -/
def arCurrentU (w : ι) (k : ℕ) :
    Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K) :=
  Matrix.single (Sum.inr w) (Sum.inl 0) (Polynomial.X ^ k)

/-- A transverse shear from the second quotient coordinate. -/
def arCurrentV (w : ι) (k : ℕ) :
    Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K) :=
  Matrix.single (Sum.inr w) (Sum.inl 1) (Polynomial.X ^ k)

/-- The diagonal `sl₂` current mode. -/
def arCurrentH (k : ℕ) : Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K) :=
  Matrix.single (Sum.inl 0) (Sum.inl 0) (Polynomial.X ^ k) -
    Matrix.single (Sum.inl 1) (Sum.inl 1) (Polynomial.X ^ k)

/-- Root bracket producing the diagonal mode. -/
theorem arCurrent_lie_E_F (i j : ℕ) :
    ⁅arCurrentE K ι i, arCurrentF K ι j⁆ = arCurrentH K ι (i + j) := by
  simp [arCurrentE, arCurrentF, arCurrentH, LieRing.of_associative_ring_bracket,
    pow_add, mul_comm]

/-- Diagonal action on the upper root. -/
theorem arCurrent_lie_H_E (i j : ℕ) :
    ⁅arCurrentH K ι i, arCurrentE K ι j⁆ =
      (2 : K) • arCurrentE K ι (i + j) := by
  simp [arCurrentE, arCurrentH, LieRing.of_associative_ring_bracket,
    pow_add, mul_sub, sub_mul, mul_comm, two_smul]

/-- Diagonal action on the lower root. -/
theorem arCurrent_lie_H_F (i j : ℕ) :
    ⁅arCurrentH K ι i, arCurrentF K ι j⁆ =
      -(2 : K) • arCurrentF K ι (i + j) := by
  simp only [arCurrentF, arCurrentH, LieRing.of_associative_ring_bracket,
    mul_sub, sub_mul]
  simp [pow_add, mul_comm, two_smul, sub_eq_add_neg]

/-- Diagonal action on the first family of transverse shears. -/
theorem arCurrent_lie_H_U (w : ι) (i j : ℕ) :
    ⁅arCurrentH K ι i, arCurrentU K ι w j⁆ =
      -arCurrentU K ι w (i + j) := by
  simp [arCurrentH, arCurrentU, LieRing.of_associative_ring_bracket,
    pow_add, mul_sub, sub_mul, mul_comm]

/-- Diagonal action on the second family of transverse shears. -/
theorem arCurrent_lie_H_V (w : ι) (i j : ℕ) :
    ⁅arCurrentH K ι i, arCurrentV K ι w j⁆ =
      arCurrentV K ι w (i + j) := by
  simp [arCurrentH, arCurrentV, LieRing.of_associative_ring_bracket,
    pow_add, mul_sub, sub_mul, mul_comm]

/-- The two constant radicals and one one-sided linear semisimple root. -/
def arOneSidedCurrentGenerators :
    Set (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) :=
  {arCurrentE K ι 0, arCurrentF K ι 0, arCurrentF K ι 1} ∪
    Set.range (fun w => arCurrentU K ι w 0) ∪
    Set.range (fun w => arCurrentV K ι w 0)

/-- The arbitrary-rank Lie algebra generated by the minimal one-sided horizon modes. -/
def arOneSidedCurrentLie :
    LieSubalgebra K (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (arOneSidedCurrentGenerators K ι)

/-- Current modes annihilating a vector form a Lie subalgebra. -/
def arCurrentPointStabilizer
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) M]
    [LieModule K (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) M]
    (v : M) :
    LieSubalgebra K (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) where
  carrier := {A | ⁅A, v⁆ = 0}
  zero_mem' := by simp
  add_mem' := by
    intro A B hA hB
    change ⁅A, v⁆ = 0 at hA
    change ⁅B, v⁆ = 0 at hB
    change ⁅A + B, v⁆ = 0
    simp [hA, hB]
  smul_mem' := by
    intro c A hA
    change ⁅A, v⁆ = 0 at hA
    change ⁅c • A, v⁆ = 0
    simp [hA]
  lie_mem' := by
    intro A B hA hB
    change ⁅A, v⁆ = 0 at hA
    change ⁅B, v⁆ = 0 at hB
    change ⁅⁅A, B⁆, v⁆ = 0
    rw [lie_lie, hA, hB]
    simp

section Generation

variable [CharZero K]

/-- Every upper-root current mode is generated by the one-sided horizon modes. -/
theorem arCurrentE_mem_oneSidedCurrentLie (k : ℕ) :
    arCurrentE K ι k ∈ arOneSidedCurrentLie K ι := by
  have hE0 : arCurrentE K ι 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hF1 : arCurrentF K ι 1 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hH1 : arCurrentH K ι 1 ∈ arOneSidedCurrentLie K ι := by
    rw [← arCurrent_lie_E_F K ι 0 1]
    exact (arOneSidedCurrentLie K ι).lie_mem hE0 hF1
  induction k with
  | zero => exact hE0
  | succ k ih =>
      have hbr := (arOneSidedCurrentLie K ι).lie_mem hH1 ih
      rw [arCurrent_lie_H_E K ι 1 k] at hbr
      have hs := (arOneSidedCurrentLie K ι).smul_mem ((2 : K)⁻¹) hbr
      simpa [smul_smul, add_comm] using hs

/-- Every lower-root current mode is generated by the one-sided horizon modes. -/
theorem arCurrentF_mem_oneSidedCurrentLie (k : ℕ) :
    arCurrentF K ι k ∈ arOneSidedCurrentLie K ι := by
  have hE0 : arCurrentE K ι 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hF0 : arCurrentF K ι 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hF1 : arCurrentF K ι 1 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hH1 : arCurrentH K ι 1 ∈ arOneSidedCurrentLie K ι := by
    rw [← arCurrent_lie_E_F K ι 0 1]
    exact (arOneSidedCurrentLie K ι).lie_mem hE0 hF1
  induction k with
  | zero => exact hF0
  | succ k ih =>
      have hbr := (arOneSidedCurrentLie K ι).lie_mem hH1 ih
      rw [arCurrent_lie_H_F K ι 1 k] at hbr
      have hs := (arOneSidedCurrentLie K ι).smul_mem ((-(2 : K))⁻¹) hbr
      simpa [smul_smul, add_comm] using hs

omit [CharZero K] in
/-- Every first transverse-shear current mode is generated. -/
theorem arCurrentU_mem_oneSidedCurrentLie (w : ι) (k : ℕ) :
    arCurrentU K ι w k ∈ arOneSidedCurrentLie K ι := by
  have hU0 : arCurrentU K ι w 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hE0 : arCurrentE K ι 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hF1 : arCurrentF K ι 1 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hH1 : arCurrentH K ι 1 ∈ arOneSidedCurrentLie K ι := by
    rw [← arCurrent_lie_E_F K ι 0 1]
    exact (arOneSidedCurrentLie K ι).lie_mem hE0 hF1
  induction k with
  | zero => exact hU0
  | succ k ih =>
      have hbr := (arOneSidedCurrentLie K ι).lie_mem hH1 ih
      rw [arCurrent_lie_H_U K ι w 1 k] at hbr
      simpa [add_comm] using (arOneSidedCurrentLie K ι).neg_mem hbr

omit [CharZero K] in
/-- Every second transverse-shear current mode is generated. -/
theorem arCurrentV_mem_oneSidedCurrentLie (w : ι) (k : ℕ) :
    arCurrentV K ι w k ∈ arOneSidedCurrentLie K ι := by
  have hV0 : arCurrentV K ι w 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hE0 : arCurrentE K ι 0 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hF1 : arCurrentF K ι 1 ∈ arOneSidedCurrentLie K ι :=
    LieSubalgebra.subset_lieSpan (by simp [arOneSidedCurrentGenerators])
  have hH1 : arCurrentH K ι 1 ∈ arOneSidedCurrentLie K ι := by
    rw [← arCurrent_lie_E_F K ι 0 1]
    exact (arOneSidedCurrentLie K ι).lie_mem hE0 hF1
  induction k with
  | zero => exact hV0
  | succ k ih =>
      have hbr := (arOneSidedCurrentLie K ι).lie_mem hH1 ih
      rwa [arCurrent_lie_H_V K ι w 1 k, add_comm] at hbr

/-- Every diagonal current mode is generated. -/
theorem arCurrentH_mem_oneSidedCurrentLie (k : ℕ) :
    arCurrentH K ι k ∈ arOneSidedCurrentLie K ι := by
  have hbr := (arOneSidedCurrentLie K ι).lie_mem
    (arCurrentE_mem_oneSidedCurrentLie K ι 0)
    (arCurrentF_mem_oneSidedCurrentLie K ι k)
  rw [arCurrent_lie_E_F K ι 0 k] at hbr
  simpa using hbr

/-- **Arbitrary-rank one-sided current generation.** Every root, diagonal, and transverse-shear
polynomial mode belongs to the Lie span of the two constant horizon radicals and one linear root. -/
theorem arOneSidedCurrentLie_contains_all_modes (k : ℕ) :
    arCurrentE K ι k ∈ arOneSidedCurrentLie K ι ∧
    arCurrentF K ι k ∈ arOneSidedCurrentLie K ι ∧
    arCurrentH K ι k ∈ arOneSidedCurrentLie K ι ∧
    (∀ w, arCurrentU K ι w k ∈ arOneSidedCurrentLie K ι) ∧
    ∀ w, arCurrentV K ι w k ∈ arOneSidedCurrentLie K ι :=
  ⟨arCurrentE_mem_oneSidedCurrentLie K ι k,
    arCurrentF_mem_oneSidedCurrentLie K ι k,
    arCurrentH_mem_oneSidedCurrentLie K ι k,
    fun w => arCurrentU_mem_oneSidedCurrentLie K ι w k,
    fun w => arCurrentV_mem_oneSidedCurrentLie K ι w k⟩

/-- In any representation, annihilation by the arbitrary-rank minimal generator family propagates
to every polynomial root, diagonal, and transverse-shear mode. -/
theorem arOneSidedCurrent_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) M]
    [LieModule K (Matrix (arCurrentIndex ι) (arCurrentIndex ι) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅arCurrentE K ι 0, v⁆ = 0)
    (hF0 : ⁅arCurrentF K ι 0, v⁆ = 0)
    (hF1 : ⁅arCurrentF K ι 1, v⁆ = 0)
    (hU0 : ∀ w, ⁅arCurrentU K ι w 0, v⁆ = 0)
    (hV0 : ∀ w, ⁅arCurrentV K ι w 0, v⁆ = 0)
    (k : ℕ) :
    ⁅arCurrentE K ι k, v⁆ = 0 ∧ ⁅arCurrentF K ι k, v⁆ = 0 ∧
    ⁅arCurrentH K ι k, v⁆ = 0 ∧
    (∀ w, ⁅arCurrentU K ι w k, v⁆ = 0) ∧
    ∀ w, ⁅arCurrentV K ι w k, v⁆ = 0 := by
  have hgen : arOneSidedCurrentGenerators K ι ⊆
      (arCurrentPointStabilizer (K := K) (ι := ι) v : Set _) := by
    intro A hA
    simp only [arOneSidedCurrentGenerators, Set.mem_union, Set.mem_insert_iff,
      Set.mem_singleton_iff, Set.mem_range] at hA
    rcases hA with hbaseU | hV
    · rcases hbaseU with hbase | hU
      · rcases hbase with rfl | rfl | rfl
        · exact hE0
        · exact hF0
        · exact hF1
      · obtain ⟨w, rfl⟩ := hU
        exact hU0 w
    · obtain ⟨w, rfl⟩ := hV
      exact hV0 w
  have hle : arOneSidedCurrentLie K ι ≤
      arCurrentPointStabilizer (K := K) (ι := ι) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  have hall := arOneSidedCurrentLie_contains_all_modes K ι k
  exact ⟨hle hall.1, hle hall.2.1, hle hall.2.2.1,
    fun w => hle (hall.2.2.2.1 w), fun w => hle (hall.2.2.2.2 w)⟩

end Generation

end

end GaloisForLFunctions
