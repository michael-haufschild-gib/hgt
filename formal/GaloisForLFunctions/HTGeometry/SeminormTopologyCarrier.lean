import Mathlib.Analysis.LocallyConvex.WithSeminorms
import Mathlib.Analysis.Complex.Basic

/-!
# A carrier with topology generated by a chosen seminorm family

This type wrapper keeps the algebraic module fixed while replacing its topology by the projective
topology generated by an arbitrary family of seminorms.  Unlike a reducible type synonym, the
wrapper retains the seminorm family as a genuine type parameter, so distinct projective topologies
cannot collapse by definitional equality.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A module equipped with the topology generated by `p`. -/
structure SeminormTopologyCarrier {κ A : Type*} [AddCommGroup A] [Module ℂ A]
    (p : κ → Seminorm ℂ A) where
  val : A

namespace SeminormTopologyCarrier

variable {κ A : Type*} [AddCommGroup A] [Module ℂ A]
variable (p : κ → Seminorm ℂ A)

/-- Underlying set equivalence. -/
def equiv : SeminormTopologyCarrier p ≃ A where
  toFun := SeminormTopologyCarrier.val
  invFun := SeminormTopologyCarrier.mk
  left_inv x := by cases x; rfl
  right_inv _ := rfl

instance : AddCommGroup (SeminormTopologyCarrier p) := (equiv p).addCommGroup
instance : Module ℂ (SeminormTopologyCarrier p) := (equiv p).module ℂ

/-- Underlying linear equivalence. -/
def toBase : SeminormTopologyCarrier p ≃ₗ[ℂ] A := (equiv p).linearEquiv ℂ

/-- Seminorm family transported to the wrapped carrier. -/
def family : SeminormFamily ℂ (SeminormTopologyCarrier p) κ :=
  fun i ↦ (p i).comp (toBase p).toLinearMap

instance : TopologicalSpace (SeminormTopologyCarrier p) :=
  (family p).moduleFilterBasis.topology'

/-- The wrapper topology is definitionally generated by the transported seminorm family. -/
theorem withSeminorms : WithSeminorms (family p) := ⟨rfl⟩

@[simp] theorem family_apply (i : κ) (x : SeminormTopologyCarrier p) :
    family p i x = p i (toBase p x) := rfl

end SeminormTopologyCarrier

end
end GaloisForLFunctions.HTGeometry
