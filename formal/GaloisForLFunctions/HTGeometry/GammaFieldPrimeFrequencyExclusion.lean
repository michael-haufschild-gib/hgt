import GaloisForLFunctions.HTGeometry.GammaFieldRationalPhaseRank
import GaloisForLFunctions.HTGeometry.PrimeFrequencyInfiniteRank

/-!
# Prime frequencies exclude a Gamma-field relation

The finite phase law bounds the rational rank of the frequency module of a solution.  An object whose
frequency module is the full `ℚ`-span of the prime logarithms has infinite rational rank, so it
satisfies no relation with coefficients in the differential field generated by `Γ` over `ℂ(s)`.

This is eq. (32) of the card with its finite-phase input supplied: the corpus's
`prime_frequency_forces_transcendence` takes the finite-generation implication as a hypothesis, and
the implication is exactly what the law provides.
-/

open Filter Set Topology Function

open scoped Differential

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance primeExclDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance primeExclIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance primeExclDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance primeExclComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance primeExclRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

/-- A frequency module of finite rational rank is finitely generated. -/
theorem module_finite_bohrFrequencyModule_of_rank_le {f : ℝ → ℂ} {K : ℕ}
    (h : Module.rank ℚ (bohrFrequencyModule f) ≤ (K : Cardinal)) :
    Module.Finite ℚ (bohrFrequencyModule f) := by
  rw [← Module.rank_lt_aleph0_iff]
  exact lt_of_le_of_lt h (Cardinal.natCast_lt_aleph0 (n := K))

/-- A submodule of a frequency module of finite rational rank is finitely generated. -/
theorem module_finite_of_le_of_rank_le {M W : Submodule ℚ ℝ} (hle : W ≤ M) {K : ℕ}
    (h : Module.rank ℚ M ≤ (K : Cardinal)) : Module.Finite ℚ W := by
  rw [← Module.rank_lt_aleph0_iff]
  have hrank : Module.rank ℚ W ≤ Module.rank ℚ M :=
    LinearMap.rank_le_of_injective _ (Submodule.inclusion_injective hle)
  exact lt_of_le_of_lt (hrank.trans h) (Cardinal.natCast_lt_aleph0 (n := K))

/-- **Prime frequencies exclude a Gamma-field relation.**  A function holomorphic and almost periodic
on a vertical strip whose Bohr frequency module along the line contains the full prime-log span
satisfies no nontrivial relation whose coefficients lie in `ℂ(s)⟨Γ⟩`. -/
theorem no_gammaField_relation_of_primeLogFullSpan_le {σ R : ℝ} (hσ : 0 < σ) (hR : 0 < R)
    {Φ : ℂ → ℂ} (hΦ : DifferentiableOn ℂ Φ (verticalStrip σ R))
    (hap : IsStripAlmostPeriodic Φ σ R)
    (hmod : primeLogFullSpan
      ≤ bohrFrequencyModule (fun y : ℝ => Φ ((σ : ℂ) + (y : ℂ) * Complex.I)))
    {n N : ℕ} (hN : 0 < N) (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (Ψ : upperEndAnalyticSubring)
    (hΨ : upperEndAnalyticSubring.subtype Ψ = Germ.coeRingHom upperEndFilter Φ)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialAdjoin (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0) :
    ∑ α : Fin N, x α * ∏ i : Fin (n + 1),
        (differentialJet (i : ℕ)
          (algebraMap upperEndAnalyticSubring upperEndMeroField Ψ)) ^ (e α i)
      ≠ 0 := by
  intro hrel
  obtain ⟨K, hK⟩ := finite_rational_phase_rank_of_gammaField_relation_line hσ hN
    (show (0 : ℝ) < R / 4 by linarith) (show (0 : ℝ) < R / 4 by linarith)
    (show R / 4 + R / 4 < R by linarith) hR hΦ hap e he Ψ hΨ x hxmem hx0 hrel
  exact primeLogFullSpan_not_finite (module_finite_of_le_of_rank_le hmod hK)

/-- The equality form: the frequency module *is* the prime-log span. -/
theorem no_gammaField_relation_of_primeLog_frequencies {σ R : ℝ} (hσ : 0 < σ) (hR : 0 < R)
    {Φ : ℂ → ℂ} (hΦ : DifferentiableOn ℂ Φ (verticalStrip σ R))
    (hap : IsStripAlmostPeriodic Φ σ R)
    (hmod : bohrFrequencyModule (fun y : ℝ => Φ ((σ : ℂ) + (y : ℂ) * Complex.I))
      = primeLogFullSpan)
    {n N : ℕ} (hN : 0 < N) (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (Ψ : upperEndAnalyticSubring)
    (hΨ : upperEndAnalyticSubring.subtype Ψ = Germ.coeRingHom upperEndFilter Φ)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialAdjoin (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0) :
    ∑ α : Fin N, x α * ∏ i : Fin (n + 1),
        (differentialJet (i : ℕ)
          (algebraMap upperEndAnalyticSubring upperEndMeroField Ψ)) ^ (e α i)
      ≠ 0 :=
  no_gammaField_relation_of_primeLogFullSpan_le hσ hR hΦ hap (le_of_eq hmod.symm) hN e he Ψ hΨ x
    hxmem hx0

end

end GaloisForLFunctions.HTGeometry
