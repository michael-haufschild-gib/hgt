import GaloisForLFunctions.HTGeometry.DifferentialMatroidFiniteClosure
import GaloisForLFunctions.HTGeometry.FiniteDifferentialSystemAlgebraicity
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-!
# Wigner--Smith differential-matroid completeness

For an invertible finite matrix `S`, the logarithmic derivative

`Q = -ι S⁻¹ S'`, where `ι² = -1`,

has exactly the same differential-matroid rank as the entries of `S`.  The proof is unconditional:
the entries of `Q` belong to the differential field generated by `S`, while `S' = ι S Q` makes
every entry of `S` differentially algebraic over the differential field generated by `Q` through
the finite-system theorem.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Set

noncomputable section

universe u

/-- Entrywise derivative of a square matrix. -/
def matrixDifferential
    {E : Type u} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) E :=
  fun a b => (S a b)′

/-- Algebraic Wigner--Smith logarithmic derivative. -/
def matrixWignerSmith
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] {n : ℕ}
    (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) E :=
  (-algebraMap F E ι) • (S⁻¹ * matrixDifferential S)

/-- The entries of the inverse matrix lie in the differential field generated by the entries of
the original matrix. -/
theorem matrix_inv_entry_mem_differentialAdjoin
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (i j : Fin (n + 1)) :
    S⁻¹ i j ∈ differentialAdjoin F
      (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  let sSet : Set E :=
    Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2
  let B := differentialAdjoin F sSet
  let SB : Matrix (Fin (n + 1)) (Fin (n + 1)) B := fun a b =>
    ⟨S a b, subset_differentialAdjoin F sSet ⟨(a, b), rfl⟩⟩
  have hSB : SB.map (algebraMap B E) = S := by
    ext a b
    rfl
  have hmapInv : SB⁻¹.map (algebraMap B E) = S⁻¹ := by
    rw [← hSB]
    ext a b
    simp only [Matrix.inv_def, Matrix.map_apply]
    have hdet := (algebraMap B E).map_det SB
    have hadj := congrArg (fun M => M a b) ((algebraMap B E).map_adjugate SB)
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply] at hdet hadj
    rw [← hdet]
    simp only [Ring.inverse_eq_inv]
    change algebraMap B E ((SB.det)⁻¹ * SB.adjugate a b) =
      (algebraMap B E SB.det)⁻¹ * (SB.map (algebraMap B E)).adjugate a b
    rw [map_mul, map_inv₀, hadj]
  change S⁻¹ i j ∈ B
  have hb : ((SB⁻¹ i j : B) : E) ∈ B := (SB⁻¹ i j).property
  have h := congrArg (fun M => M i j) hmapInv
  simp only [Matrix.map_apply] at h
  have h' : ((SB⁻¹ i j : B) : E) = S⁻¹ i j := by simpa using h
  rwa [h'] at hb

/-- Every Wigner--Smith entry lies in the differential field generated by the scattering-matrix
entries. -/
theorem matrixWignerSmith_entry_mem_differentialAdjoin
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] {n : ℕ}
    (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (a b : Fin (n + 1)) :
    matrixWignerSmith ι S a b ∈ differentialAdjoin F
      (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  let sSet : Set E :=
    Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2
  let B := differentialAdjoin F sSet
  have hInv : ∀ k, S⁻¹ a k ∈ B := fun k =>
    matrix_inv_entry_mem_differentialAdjoin S a k
  have hDeriv : ∀ k, (S k b)′ ∈ B := by
    intro k
    have hjet := differentialJet_mem_differentialAdjoin F
      (s := sSet) (x := S k b) ⟨(k, b), rfl⟩ 1
    simpa [differentialJet] using hjet
  rw [matrixWignerSmith]
  apply B.mul_mem (B.neg_mem (B.algebraMap_mem ι))
  simpa [Matrix.mul_apply, matrixDifferential] using
    (B.sum_mem fun k _ => B.mul_mem (hInv k) (hDeriv k))

/-- The Wigner--Smith definition is equivalent to the finite linear system `S' = ι S Q`. -/
theorem matrixDifferential_eq_mul_matrixWignerSmith
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] {n : ℕ}
    (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0) :
    matrixDifferential S =
      (algebraMap F E ι) • (S * matrixWignerSmith ι S) := by
  have hunit : IsUnit S.det := isUnit_iff_ne_zero.mpr hdet
  have hιE : algebraMap F E ι * algebraMap F E ι = -1 := by
    rw [← map_mul, hι, map_neg, map_one]
  rw [matrixWignerSmith, Matrix.mul_smul, ← Matrix.mul_assoc,
    Matrix.mul_nonsing_inv S hunit, Matrix.one_mul]
  rw [smul_smul]
  have hscalar : algebraMap F E ι * -algebraMap F E ι = 1 := by
    rw [mul_neg, hιE, neg_neg]
  rw [hscalar, one_smul]

/-- Each scattering-matrix entry is differentially algebraic over the differential field generated
by the Wigner--Smith entries. -/
theorem differentialAlgebraicOver_matrixWignerSmith_entries
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0)
    (a b : Fin (n + 1)) :
    DifferentialAlgebraicOver
      (differentialAdjoin F
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) =>
          matrixWignerSmith ι S p.1 p.2))
      (S a b) := by
  let Q := matrixWignerSmith ι S
  let qSet : Set E :=
    Set.range fun p : Fin (n + 1) × Fin (n + 1) => Q p.1 p.2
  let BQ := differentialAdjoin F qSet
  letI : DifferentialAlgebra BQ E :=
    ⟨fun c => derivationClosedDifferential_apply BQ
      (derivationClosed_differentialAdjoin F qSet) c⟩
  let A : Fin (n + 1) → Fin (n + 1) → BQ := fun j k =>
    ⟨algebraMap F E ι * Q k j,
      BQ.mul_mem (BQ.algebraMap_mem ι)
        (subset_differentialAdjoin F qSet ⟨(k, j), rfl⟩)⟩
  have hmatrix := matrixDifferential_eq_mul_matrixWignerSmith ι hι S hdet
  have hsystem : ∀ j,
      (S a j)′ = ∑ k, algebraMap BQ E (A j k) * S a k := by
    intro j
    have h := congrArg (fun M => M a j) hmatrix
    calc
      (S a j)′ = algebraMap F E ι * ∑ k, S a k * Q k j := by
        simpa [matrixDifferential, Matrix.mul_apply, Q] using h
      _ = ∑ k, algebraMap BQ E (A j k) * S a k := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro k _
        simp [A, mul_assoc, mul_comm]
  exact differentialAlgebraicOver_finiteLinearSystem_coordinate A (fun j => S a j)
    hsystem b

/-- **Wigner--Smith Kolchin completeness.**  The finite scattering matrix and its Wigner--Smith
matrix have exactly the same extended rank in the genuine differential matroid. -/
theorem matrixWignerSmith_differentialMatroid_eRk_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0) :
    (differentialMatroid F E).eRk
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) =>
          matrixWignerSmith ι S p.1 p.2) =
      (differentialMatroid F E).eRk
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  let M := differentialMatroid F E
  let sFamily : Fin (n + 1) × Fin (n + 1) → E := fun p => S p.1 p.2
  let qFamily : Fin (n + 1) × Fin (n + 1) → E := fun p =>
    matrixWignerSmith ι S p.1 p.2
  have hQclose : Set.range qFamily ⊆ M.closure (Set.range sFamily) := by
    rintro _ ⟨p, rfl⟩
    apply (differentialMatroid_mem_closure_range_fintype_iff
      (F := F) (E := E) sFamily (qFamily p)).mpr
    let BS := differentialAdjoin F (Set.range sFamily)
    let qBS : BS :=
      ⟨qFamily p, matrixWignerSmith_entry_mem_differentialAdjoin ι S p.1 p.2⟩
    have hq : DifferentialAlgebraicOver BS (algebraMap BS E qBS) :=
      differentialAlgebraicOver_algebraMap qBS
    simpa [BS, qBS] using hq
  have hSclose : Set.range sFamily ⊆ M.closure (Set.range qFamily) := by
    rintro _ ⟨p, rfl⟩
    apply (differentialMatroid_mem_closure_range_fintype_iff
      (F := F) (E := E) qFamily (sFamily p)).mpr
    exact differentialAlgebraicOver_matrixWignerSmith_entries ι hι S hdet p.1 p.2
  apply le_antisymm
  · calc
      M.eRk (Set.range qFamily) ≤ M.eRk (M.closure (Set.range sFamily)) :=
        M.eRk_mono hQclose
      _ = M.eRk (Set.range sFamily) := M.eRk_closure_eq _
  · calc
      M.eRk (Set.range sFamily) ≤ M.eRk (M.closure (Set.range qFamily)) :=
        M.eRk_mono hSclose
      _ = M.eRk (Set.range qFamily) := M.eRk_closure_eq _

end

end GaloisForLFunctions.HTGeometry
