import GaloisForLFunctions.HTGeometry.ConstitutiveAdaptiveCost

/-!
# Prefix effectivity horizon, recurrent phase, and open action

The exhaustive history `range n` is one constitutive producer.  Finite prefix observers stabilize,
the complete profile converges pointwise to the non-effective all-true boundary, the one-step
production is a singleton, cardinal action grows exactly as `n`, parity recurs with period two, and
its positive square erases parity.  One closed theorem packages simultaneous observer closure,
phase return, and arbitrarily large source action.

No computation tactic, project postulate, or unproved premise is used.
-/

namespace GaloisForLFunctions.HTGeometry

/-- Effective source history after `n` production steps. -/
def constitutivePrefixHistory (n : ℕ) : Finset ℕ :=
  Finset.range n

/-- Finite observer of aperture `m` applied to source history `n`. -/
def constitutivePrefixObservation (m n : ℕ) : Finset ℕ :=
  constitutivePrefixHistory n ∩ constitutivePrefixHistory m

/-- Phase generated by cardinality of the source history. -/
def constitutivePrefixPhase (n : ℕ) : ℤ :=
  (-1 : ℤ) ^ (constitutivePrefixHistory n).card

/-- Positive scalar observer obtained by squaring the generated phase. -/
def constitutivePrefixPositiveShadow (n : ℕ) : ℤ :=
  constitutivePrefixPhase n * constitutivePrefixPhase n

/-- Source action is exactly history cardinality. -/
@[simp] theorem constitutivePrefixHistory_card (n : ℕ) :
    (constitutivePrefixHistory n).card = n := by
  simp [constitutivePrefixHistory]

/-- Prefix observation is the history at the smaller aperture. -/
theorem constitutivePrefixObservation_eq (m n : ℕ) :
    constitutivePrefixObservation m n = constitutivePrefixHistory (min n m) := by
  exact Finset.range_inter_range n m

/-- Every fixed finite observer stabilizes once source history passes its aperture. -/
theorem constitutivePrefixObservation_stable :
    ∀ m n : ℕ, m ≤ n →
      constitutivePrefixObservation m n = constitutivePrefixHistory m := by
  intro m n h
  rw [constitutivePrefixObservation_eq, min_eq_right h]

/-- The effective histories converge pointwise to the all-true experimental boundary. -/
theorem finiteLawProfile_constitutivePrefixHistory_eventually_allTrue :
    ∀ k : ℕ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      finiteLawProfile (constitutivePrefixHistory n) k = constitutiveAllTrueProfile k := by
  intro k
  refine ⟨k + 1, ?_⟩
  intro n hn
  simp [finiteLawProfile, constitutivePrefixHistory, constitutiveAllTrueProfile]
  omega

/-- Every production step adds exactly one new source coordinate. -/
theorem constitutivePrefixHistory_production (n : ℕ) :
    constitutivePrefixHistory (n + 1) \ constitutivePrefixHistory n = {n} := by
  ext k
  simp [constitutivePrefixHistory]
  omega

/-- Generated phase is ordinary parity. -/
@[simp] theorem constitutivePrefixPhase_eq (n : ℕ) :
    constitutivePrefixPhase n = (-1 : ℤ) ^ n := by
  simp [constitutivePrefixPhase]

/-- Generated phase recurs after two source steps. -/
theorem constitutivePrefixPhase_period_two (n : ℕ) :
    constitutivePrefixPhase (n + 2) = constitutivePrefixPhase n := by
  simp [constitutivePrefixPhase, pow_add]

/-- Positive scalarization erases every parity phase. -/
theorem constitutivePrefixPositiveShadow_eq_one (n : ℕ) :
    constitutivePrefixPositiveShadow n = 1 := by
  simp only [constitutivePrefixPositiveShadow, constitutivePrefixPhase_eq]
  rw [← pow_add]
  exact (show Even (n + n) from ⟨n, by omega⟩).neg_one_pow

/-- Every finite observer and action budget admits a phase-return time with closed observation and
strictly larger source action. -/
theorem constitutivePrefix_simultaneous_closedObservation_openAction :
    ∀ aperture budget : ℕ, ∃ N : ℕ,
      Even N ∧
        constitutivePrefixObservation aperture N = constitutivePrefixHistory aperture ∧
        constitutivePrefixPhase N = 1 ∧
        budget < (constitutivePrefixHistory N).card := by
  intro aperture budget
  let N := 2 * (aperture + budget + 1)
  have hEven : Even N := by
    exact even_two_mul (aperture + budget + 1)
  have hAperture : aperture ≤ N := by
    dsimp [N]
    omega
  have hBudget : budget < N := by
    dsimp [N]
    omega
  refine ⟨N, hEven, constitutivePrefixObservation_stable aperture N hAperture, ?_, ?_⟩
  · rw [constitutivePrefixPhase_eq, hEven.neg_one_pow]
  · simpa using hBudget

/-- Closed package of the prefix realization-boundary law: stabilization, non-effectivity,
production, action, phase recurrence, positive erasure, and simultaneous open lift. -/
theorem constitutivePrefix_effectivityHorizon_law :
    (∀ m n : ℕ, m ≤ n →
      constitutivePrefixObservation m n = constitutivePrefixHistory m) ∧
    (∀ k : ℕ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      finiteLawProfile (constitutivePrefixHistory n) k = constitutiveAllTrueProfile k) ∧
    ¬ ExperimentallyEffective constitutiveAllTrueProfile ∧
    (∀ n : ℕ,
      constitutivePrefixHistory (n + 1) \ constitutivePrefixHistory n = {n}) ∧
    (∀ n : ℕ, (constitutivePrefixHistory n).card = n) ∧
    (∀ n : ℕ, constitutivePrefixPhase (n + 2) = constitutivePrefixPhase n) ∧
    (∀ n : ℕ, constitutivePrefixPositiveShadow n = 1) ∧
    (∀ aperture budget : ℕ, ∃ N : ℕ,
      Even N ∧
        constitutivePrefixObservation aperture N = constitutivePrefixHistory aperture ∧
        constitutivePrefixPhase N = 1 ∧
        budget < (constitutivePrefixHistory N).card) := by
  exact ⟨constitutivePrefixObservation_stable,
    finiteLawProfile_constitutivePrefixHistory_eventually_allTrue,
    constitutiveAllTrueProfile_not_effective,
    constitutivePrefixHistory_production,
    constitutivePrefixHistory_card,
    constitutivePrefixPhase_period_two,
    constitutivePrefixPositiveShadow_eq_one,
    constitutivePrefix_simultaneous_closedObservation_openAction⟩

end GaloisForLFunctions.HTGeometry
