import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# The order of a repeated factor in the derivative

If `q = hᵉ·g` with `h` irreducible and `h ∤ g`, then in characteristic zero the derivative `q'` is
divisible by `h^(e−1)` and by no more:

`q' = h^(e−1)·(e·h'·g + h·g')`,

and `h` divides neither `e` (a nonzero constant), nor `h'` (nonzero of smaller degree), nor `g`.

This is the polynomial shadow of the tame different exponent: for a monogenic order the different is
generated by the derivative of the minimal polynomial, and its order at the prime attached to `h` is
exactly `e − 1`, the ramification index minus one.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {κ : Type*} [Field κ]

/-- The derivative of `hᵉ·g` factors through `h^(e−1)`. -/
theorem derivative_pow_mul_eq {h g : κ[X]} {e : ℕ} (he : 1 ≤ e) :
    derivative (h ^ e * g)
      = h ^ (e - 1) * ((e : κ[X]) * derivative h * g + h * derivative g) := by
  have hsplit : h ^ e = h ^ (e - 1) * h := by
    rw [← pow_succ]
    congr 1
    omega
  rw [derivative_mul, derivative_pow]
  have hcast : ((e : ℕ) : κ[X]) = C ((e : ℕ) : κ) := by
    simp
  rw [hcast, hsplit]
  ring

theorem pow_sub_one_dvd_derivative {h g : κ[X]} {e : ℕ} (he : 1 ≤ e) :
    h ^ (e - 1) ∣ derivative (h ^ e * g) :=
  ⟨_, derivative_pow_mul_eq he⟩

/-- **The derivative is divisible by no higher power.** -/
theorem not_pow_dvd_derivative [CharZero κ] {h g : κ[X]} (hirr : Irreducible h) {e : ℕ}
    (he : 1 ≤ e) (hg : ¬ h ∣ g) : ¬ h ^ e ∣ derivative (h ^ e * g) := by
  intro hdvd
  have hh0 : h ≠ 0 := hirr.ne_zero
  have hdeg : 0 < h.natDegree := by
    by_contra hc
    have h0 : h.natDegree = 0 := by omega
    obtain ⟨a, ha⟩ := Polynomial.natDegree_eq_zero.mp h0
    have ha0 : a ≠ 0 := by
      intro hz
      rw [hz, map_zero] at ha
      exact hh0 ha.symm
    refine hirr.not_isUnit ?_
    rw [← ha]
    exact (isUnit_iff_ne_zero.mpr ha0).map (Polynomial.C : κ →+* κ[X])
  have hd0 : derivative h ≠ 0 := by
    intro hc
    have hz := Polynomial.derivative_eq_zero.mp hc
    omega
  set W : κ[X] := (e : κ[X]) * derivative h * g + h * derivative h ^ 0 * derivative g with hWdef
  have hq := derivative_pow_mul_eq (h := h) (g := g) he
  have hsplit : h ^ e = h ^ (e - 1) * h := by
    rw [← pow_succ]
    congr 1
    omega
  rw [hq, hsplit] at hdvd
  have hcancel : h ∣ (e : κ[X]) * derivative h * g + h * derivative g := by
    obtain ⟨c, hc⟩ := hdvd
    refine ⟨c, ?_⟩
    have hpow : h ^ (e - 1) ≠ 0 := pow_ne_zero _ hh0
    exact mul_left_cancel₀ hpow (by rw [hc]; ring)
  have hmain : h ∣ (e : κ[X]) * derivative h * g := by
    have := dvd_sub hcancel (Dvd.intro (derivative g) rfl)
    simpa using this
  have hprime : Prime h := hirr.prime
  rcases hprime.2.2 _ _ hmain with hc | hc
  · rcases hprime.2.2 _ _ hc with hc' | hc'
    · -- `h` divides the nonzero constant `e`
      have hunit : IsUnit ((e : κ[X])) := by
        have hne : ((e : ℕ) : κ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
        have hcast : ((e : ℕ) : κ[X]) = C ((e : ℕ) : κ) := by simp
        rw [hcast]
        exact (isUnit_iff_ne_zero.mpr hne).map (Polynomial.C : κ →+* κ[X])
      exact hirr.not_isUnit (isUnit_of_dvd_unit hc' hunit)
    · -- `h` divides its own derivative
      have hlt : (derivative h).degree < h.degree := Polynomial.degree_derivative_lt hh0
      have hle : h.degree ≤ (derivative h).degree := Polynomial.degree_le_of_dvd hc' hd0
      exact absurd hlt (not_lt.mpr hle)
  · exact hg hc

end GaloisForLFunctions.HTGeometry
