import Mathlib.Analysis.Normed.Module.Basic
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.Topology.MetricSpace.Basic
import Mathlib.Algebra.Order.Floor.Ring
import Mathlib.Order.Filter.AtTopBot.Basic

/-!
# Division points of a cocompact lattice are dense

A finite family of periods spanning a complex space over the reals generates a cocompact subgroup:
every point of the space is within a fixed distance of it.  Dividing the lattice by a sequence of
scalars of unbounded norm therefore fills the space, and the accumulated division points of a
degree-expanding isogeny protocol on the complex torus `V / Λ` are dense.

This is the analytic input of the deck closure in every dimension: in one variable the elliptic
argument used arbitrarily small periods, which is unavailable for `n ≥ 2` because the period group
of a nonconstant function of several variables need not be discrete.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- A cocompact period family of a complex space: finitely many periods spanning it over the
reals.  Its `ℤ`-span is the period lattice of a compact complex torus. -/
structure PeriodLattice (V : Type*) [NormedAddCommGroup V] [NormedSpace ℂ V] where
  /-- The number of periods. -/
  rank : ℕ
  /-- The periods. -/
  period : Fin rank → V
  /-- The periods span the space over the reals, so the lattice they generate is cocompact. -/
  spanning : Submodule.span ℝ (Set.range period) = ⊤

namespace PeriodLattice

/-- The period lattice: the subgroup generated by the periods. -/
def lattice (L : PeriodLattice V) : AddSubgroup V :=
  AddSubgroup.closure (Set.range L.period)

theorem period_mem_lattice (L : PeriodLattice V) (i : Fin L.rank) :
    L.period i ∈ L.lattice :=
  AddSubgroup.subset_closure ⟨i, rfl⟩

/-- An integer combination of the periods lies in the lattice. -/
theorem sum_zsmul_mem_lattice (L : PeriodLattice V) (k : Fin L.rank → ℤ) :
    ∑ i, k i • L.period i ∈ L.lattice :=
  sum_mem fun i _ => zsmul_mem (L.period_mem_lattice i) (k i)

/-- Every point of the space is an integer combination of the periods up to an error controlled by
the sum of their norms. -/
theorem exists_sum_zsmul_dist_le (L : PeriodLattice V) (w : V) :
    ∃ k : Fin L.rank → ℤ,
      ‖w - ∑ i, k i • L.period i‖ ≤ ∑ i, ‖L.period i‖ := by
  classical
  have hmem : w ∈ Submodule.span ℝ (Set.range L.period) := by
    rw [L.spanning]
    exact Submodule.mem_top
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hmem
  refine ⟨fun i => ⌊d i⌋, ?_⟩
  have hcast : ∀ i : Fin L.rank,
      (⌊d i⌋ : ℤ) • L.period i = ((⌊d i⌋ : ℝ)) • L.period i := fun i =>
    (Int.cast_smul_eq_zsmul ℝ (⌊d i⌋) (L.period i)).symm
  have hdiff : w - ∑ i, (⌊d i⌋ : ℤ) • L.period i
      = ∑ i, (d i - (⌊d i⌋ : ℝ)) • L.period i := by
    simp only [hcast]
    rw [← hd, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun i _ => (sub_smul _ _ _).symm
  rw [hdiff]
  refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum fun i _ => ?_)
  rw [norm_smul]
  refine mul_le_of_le_one_left (norm_nonneg _) ?_
  rw [Real.norm_eq_abs, abs_le]
  constructor
  · have := Int.floor_le (d i)
    linarith
  · have := Int.lt_floor_add_one (d i)
    linarith

end PeriodLattice

/-- **The accumulated division points of a degree-expanding protocol are dense.**  For a cocompact
period lattice and scalars of unbounded norm, the points whose multiple by some scalar lies in the
lattice fill the space. -/
theorem dense_divisionPoints (L : PeriodLattice V) (M : ℕ → ℂ) (hM : ∀ n, M n ≠ 0)
    (hMinf : Tendsto (fun n => ‖M n‖) atTop atTop) :
    Dense {t : V | ∃ n : ℕ, M n • t ∈ L.lattice} := by
  classical
  set S : ℝ := ∑ i, ‖L.period i‖ with hS
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun i _ => norm_nonneg _
  rw [Metric.dense_iff]
  intro w r hr
  obtain ⟨n, hn⟩ : ∃ n : ℕ, (S + 1) / r < ‖M n‖ :=
    (hMinf.eventually_gt_atTop ((S + 1) / r)).exists
  have hMn0 : 0 < ‖M n‖ := lt_of_le_of_lt (by positivity) hn
  obtain ⟨k, hk⟩ := L.exists_sum_zsmul_dist_le (M n • w)
  refine ⟨(M n)⁻¹ • ∑ i, k i • L.period i, ?_, ⟨n, ?_⟩⟩
  · rw [Metric.mem_ball, dist_eq_norm]
    have hval : (M n)⁻¹ • ∑ i, k i • L.period i - w
        = (M n)⁻¹ • ((∑ i, k i • L.period i) - M n • w) := by
      rw [smul_sub, inv_smul_smul₀ (hM n)]
    rw [hval, norm_smul, norm_inv]
    have hnum : ‖(∑ i, k i • L.period i) - M n • w‖ ≤ S := by
      rw [← norm_neg]
      simpa using hk
    have hbound : ‖M n‖⁻¹ * ‖(∑ i, k i • L.period i) - M n • w‖ ≤ ‖M n‖⁻¹ * S :=
      mul_le_mul_of_nonneg_left hnum (by positivity)
    refine lt_of_le_of_lt hbound ?_
    rw [inv_mul_lt_iff₀ hMn0]
    have hlt : S + 1 < ‖M n‖ * r := by
      rw [div_lt_iff₀ hr] at hn
      linarith
    linarith
  · rw [smul_inv_smul₀ (hM n)]
    exact L.sum_zsmul_mem_lattice k

/-- A finite spanning family of periods indexed by any finite type gives a period lattice. -/
noncomputable def PeriodLattice.ofSpanning {ι : Type*} [Fintype ι] (p : ι → V)
    (hp : Submodule.span ℝ (Set.range p) = ⊤) : PeriodLattice V where
  rank := Fintype.card ι
  period := p ∘ (Fintype.equivFin ι).symm
  spanning := by
    rw [(Fintype.equivFin ι).symm.surjective.range_comp]
    exact hp

/-- **The standard period lattice of `ℂ ^ n`**: the Gaussian integer points, which span `ℂ ^ n`
over the reals, so the quotient is a compact complex torus of dimension `n`. -/
noncomputable def stdPeriodLattice (n : ℕ) : PeriodLattice (Fin n → ℂ) :=
  PeriodLattice.ofSpanning
    (fun i : Fin n ⊕ Fin n =>
      Sum.elim (fun j => (Pi.single j 1 : Fin n → ℂ))
        (fun j => (Pi.single j Complex.I : Fin n → ℂ)) i)
    (by
      classical
      rw [eq_top_iff]
      rintro w -
      have hw : w = ∑ j : Fin n, ((w j).re • (Pi.single j 1 : Fin n → ℂ)
          + (w j).im • (Pi.single j Complex.I : Fin n → ℂ)) := by
        funext k
        rw [Finset.sum_apply]
        have hterm : ∀ j : Fin n, ((w j).re • (Pi.single j 1 : Fin n → ℂ)
            + (w j).im • (Pi.single j Complex.I : Fin n → ℂ)) k
            = if k = j then w j else 0 := by
          intro j
          rw [Pi.add_apply, Pi.smul_apply, Pi.smul_apply, Pi.single_apply, Pi.single_apply]
          by_cases hkj : k = j
          · rw [if_pos hkj, if_pos hkj, if_pos hkj]
            show ((w j).re : ℂ) * 1 + ((w j).im : ℂ) * Complex.I = w j
            rw [mul_one]
            exact Complex.re_add_im (w j)
          · rw [if_neg hkj, if_neg hkj, if_neg hkj]
            show ((w j).re : ℂ) * 0 + ((w j).im : ℂ) * 0 = 0
            ring
        rw [Finset.sum_congr rfl fun j _ => hterm j, Finset.sum_ite_eq Finset.univ k w,
          if_pos (Finset.mem_univ k)]
      rw [hw]
      refine Submodule.sum_mem _ fun j _ => Submodule.add_mem _ ?_ ?_
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inl j, rfl⟩)
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr j, rfl⟩))

end GaloisForLFunctions.HTGeometry
