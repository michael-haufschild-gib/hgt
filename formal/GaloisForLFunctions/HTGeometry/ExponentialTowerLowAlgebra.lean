import GaloisForLFunctions.HTGeometry.ExponentialTowerModel
import Mathlib.Algebra.MvPolynomial.PDeriv

/-!
# The low-variable subalgebra of the tower model

Every tower object of index at most `m` lies in the subalgebra generated by the first `m` variables,
and that subalgebra is stable under the tower derivation — the derivative of a variable is a product
of variables no larger than it.  Consequently all jets of a low object are annihilated by the higher
partial derivatives.

This is the bookkeeping an induction on the height needs: at each step the newest variable appears
only through the newest monomial.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- The subalgebra generated by the variables of index at most `m`. -/
noncomputable def lowAlg (m : ℕ) : Subalgebra ℂ (MvPolynomial ℕ ℂ) :=
  Algebra.adjoin ℂ (MvPolynomial.X '' {k : ℕ | k ≤ m})

theorem X_mem_lowAlg {j m : ℕ} (h : j ≤ m) : (MvPolynomial.X j : MvPolynomial ℕ ℂ) ∈ lowAlg m :=
  Algebra.subset_adjoin ⟨j, h, rfl⟩

theorem towerMonomial_mem_lowAlg {j m : ℕ} (h : j ≤ m) : towerMonomial j ∈ lowAlg m := by
  induction j with
  | zero => simp
  | succ j ih =>
      rw [towerMonomial_succ]
      exact Subalgebra.mul_mem _ (ih (by omega)) (X_mem_lowAlg (by omega))

/-- **The low subalgebra is stable under the tower derivation.** -/
theorem towerDerivation_mem_lowAlg {m : ℕ} {P : MvPolynomial ℕ ℂ} (h : P ∈ lowAlg m) :
    towerDerivation P ∈ lowAlg m := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      rw [towerDerivation_X]
      exact towerMonomial_mem_lowAlg hj
  | algebraMap c =>
      have : (algebraMap ℂ (MvPolynomial ℕ ℂ)) c = MvPolynomial.C c := rfl
      rw [this, show (MvPolynomial.C c : MvPolynomial ℕ ℂ)
        = algebraMap ℂ (MvPolynomial ℕ ℂ) c from rfl, towerDerivation.map_algebraMap]
      exact Subalgebra.zero_mem _
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy =>
      simp only [Derivation.leibniz, smul_eq_mul]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx ihy) (Subalgebra.mul_mem _ hy ihx)

/-- **High partial derivatives kill low objects.** -/
theorem pderiv_eq_zero_of_mem_lowAlg {m k : ℕ} (hk : m < k) {P : MvPolynomial ℕ ℂ}
    (h : P ∈ lowAlg m) : (MvPolynomial.pderiv k) P = 0 := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      have hj' : j ≤ m := hj
      have hne : j ≠ k := by omega
      exact MvPolynomial.pderiv_X_of_ne hne
  | algebraMap c =>
      have : (algebraMap ℂ (MvPolynomial ℕ ℂ)) c = MvPolynomial.C c := rfl
      rw [this]
      simp
  | add x y hx hy ihx ihy =>
      rw [map_add, ihx, ihy, add_zero]
  | mul x y hx hy ihx ihy =>
      rw [Derivation.leibniz, ihx, ihy]
      simp

/-- All jets of a low object stay low. -/
theorem iterate_towerDerivation_mem_lowAlg {m : ℕ} {P : MvPolynomial ℕ ℂ}
    (h : P ∈ lowAlg m) (i : ℕ) :
    ((towerDerivation : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[i]) P ∈ lowAlg m := by
  induction i with
  | zero => simpa using h
  | succ i ih =>
      rw [Function.iterate_succ_apply']
      exact towerDerivation_mem_lowAlg ih

/-! ## The partial sums -/

/-- The sum of the tower monomials up to index `m`; the logarithmic derivative of the next one. -/
noncomputable def towerSum (m : ℕ) : MvPolynomial ℕ ℂ :=
  ∑ k ∈ Finset.range (m + 1), towerMonomial k

@[simp] theorem towerSum_zero : towerSum 0 = 1 := by
  simp [towerSum]

theorem towerSum_succ (m : ℕ) : towerSum (m + 1) = towerSum m + towerMonomial (m + 1) := by
  rw [towerSum, towerSum, Finset.sum_range_succ]

theorem towerSum_mem_lowAlg {j m : ℕ} (h : j ≤ m) : towerSum j ∈ lowAlg m := by
  refine Subalgebra.sum_mem _ ?_
  intro k hk
  refine towerMonomial_mem_lowAlg ?_
  have := Finset.mem_range.mp hk
  omega

/-- **The derivative law for the monomials.**  Each monomial's logarithmic derivative is the partial
sum below it. -/
theorem towerDerivation_towerMonomial (k : ℕ) :
    towerDerivation (towerMonomial (k + 1)) = towerMonomial (k + 1) * towerSum k := by
  induction k with
  | zero =>
      show towerDerivation (towerMonomial 1) = towerMonomial 1 * towerSum 0
      have h1 : towerMonomial 1 = MvPolynomial.X 1 := by
        rw [show (1 : ℕ) = 0 + 1 from rfl, towerMonomial_succ, towerMonomial_zero, one_mul]
      rw [h1, towerDerivation_X, towerSum_zero, mul_one]
      exact h1
  | succ k ih =>
      rw [towerMonomial_succ (k + 1), Derivation.leibniz, ih, towerDerivation_X,
        towerSum_succ, smul_eq_mul, smul_eq_mul, towerMonomial_succ (k + 1)]
      ring

/-- **The derivative law for the partial sums.** -/
theorem towerDerivation_towerSum (m : ℕ) :
    towerDerivation (towerSum (m + 1))
      = towerDerivation (towerSum m) + towerMonomial (m + 1) * towerSum m := by
  rw [towerSum_succ, map_add, towerDerivation_towerMonomial]

end GaloisForLFunctions.HTGeometry
