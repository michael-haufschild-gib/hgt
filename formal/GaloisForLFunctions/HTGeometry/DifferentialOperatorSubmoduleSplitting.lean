import GaloisForLFunctions.HTGeometry.DifferentialOperatorPrincipalIdeal

/-!
# Splitting a submodule along a coordinate

The image of a submodule of a finite power of the operator ring under a coordinate projection is a
left ideal, hence principal.  A preimage of its generator splits the submodule: every element
becomes, after subtracting an operator multiple of that preimage, an element whose chosen
coordinate vanishes.

This is the induction step of the structure theory of submodules of free modules over the operator
ring, and hence of the diagonal reduction.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K] {ι : Type*}

/-- The coordinate projection, as a linear map over the operator ring. -/
def projCoord (i₀ : ι) : (ι → DiffOp K) →ₗ[DiffOp K] DiffOp K where
  toFun y := y i₀
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem projCoord_apply (i₀ : ι) (y : ι → DiffOp K) : projCoord i₀ y = y i₀ := rfl

/-- **Coordinate splitting.**  Some element of the submodule generates all the values of the
chosen coordinate. -/
theorem exists_coord_generator (i₀ : ι) (N : Submodule (DiffOp K) (ι → DiffOp K)) :
    ∃ x ∈ N, ∀ y ∈ N, ∃ r : DiffOp K, (y - r • x) i₀ = 0 ∧ y - r • x ∈ N := by
  classical
  obtain ⟨b, hb⟩ := exists_generator (N.map (projCoord i₀))
  have hbmem : b ∈ N.map (projCoord i₀) := by
    rw [hb]
    exact Submodule.mem_span_singleton_self b
  obtain ⟨x, hxN, hxb⟩ := hbmem
  refine ⟨x, hxN, fun y hy => ?_⟩
  have hyimg : y i₀ ∈ N.map (projCoord i₀) := ⟨y, hy, rfl⟩
  rw [hb] at hyimg
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hyimg
  refine ⟨r, ?_, N.sub_mem hy (N.smul_mem r hxN)⟩
  show y i₀ - (r • x) i₀ = 0
  have hrx : (r • x) i₀ = r • (x i₀) := rfl
  have hxb' : x i₀ = b := hxb
  rw [hrx, hxb', hr, sub_self]

/-- If the generator of the coordinate image is nonzero, the splitting is direct. -/
theorem smul_eq_zero_of_coord_eq_zero {x : ι → DiffOp K} {i₀ : ι} (hx : x i₀ ≠ 0)
    {r : DiffOp K} (h : (r • x) i₀ = 0) : r = 0 := by
  have hr : r * x i₀ = 0 := h
  exact (mul_eq_zero.mp hr).resolve_right hx


variable [DecidableEq ι]

/-- The vectors supported on a finite set of coordinates. -/
def coordSupport (t : Finset ι) : Submodule (DiffOp K) (ι → DiffOp K) where
  carrier := {y | ∀ i ∉ t, y i = 0}
  add_mem' := by
    intro y z hy hz i hi
    show y i + z i = 0
    rw [hy i hi, hz i hi, add_zero]
  zero_mem' := by
    intro i _
    rfl
  smul_mem' := by
    intro r y hy i hi
    show r * y i = 0
    rw [hy i hi, mul_zero]

omit [DecidableEq ι] in
theorem mem_coordSupport {t : Finset ι} {y : ι → DiffOp K} :
    y ∈ coordSupport t ↔ ∀ i ∉ t, y i = 0 := Iff.rfl

/-- **Submodules of a free module need no more generators than the rank.**  Every submodule
supported on a finite set of coordinates is generated by at most that many elements. -/
theorem exists_generators_card_le (t : Finset ι) :
    ∀ N : Submodule (DiffOp K) (ι → DiffOp K), N ≤ coordSupport t →
      ∃ s : Finset (ι → DiffOp K), s.card ≤ t.card ∧
        Submodule.span (DiffOp K) (↑s : Set (ι → DiffOp K)) = N := by
  classical
  induction t using Finset.induction_on with
  | empty =>
    intro N hN
    refine ⟨∅, by simp, ?_⟩
    rw [Finset.coe_empty, Submodule.span_empty]
    refine (eq_bot_iff.mpr fun y hy => ?_).symm
    have hzero : y = 0 := by
      funext i
      exact (hN hy) i (by simp)
    rw [hzero]
    exact Submodule.zero_mem _
  | insert i₀ t hi₀ ih =>
    intro N hN
    obtain ⟨x, hxN, hsplit⟩ := exists_coord_generator i₀ N
    set N' : Submodule (DiffOp K) (ι → DiffOp K) := N ⊓ LinearMap.ker (projCoord i₀) with hN'
    have hN'le : N' ≤ coordSupport t := by
      intro y hy i hi
      by_cases hii₀ : i = i₀
      · subst hii₀
        exact hy.2
      · exact (hN hy.1) i (by
          intro hmem
          rcases Finset.mem_insert.mp hmem with h | h
          · exact hii₀ h
          · exact hi h)
    obtain ⟨s, hcard, hspan⟩ := ih N' hN'le
    refine ⟨insert x s, ?_, ?_⟩
    · refine le_trans (Finset.card_insert_le x s) ?_
      rw [Finset.card_insert_of_notMem hi₀]
      omega
    · refine le_antisymm ?_ ?_
      · refine Submodule.span_le.mpr ?_
        intro z hz
        rcases Finset.mem_insert.mp (Finset.mem_coe.mp hz) with rfl | hzs
        · exact hxN
        · have : z ∈ N' := by
            rw [← hspan]
            exact Submodule.subset_span (Finset.mem_coe.mpr hzs)
          exact this.1
      · intro y hy
        obtain ⟨r, hcoord, hmem⟩ := hsplit y hy
        have hy' : y - r • x ∈ N' := ⟨hmem, hcoord⟩
        have hsub : y - r • x ∈ Submodule.span (DiffOp K) (↑(insert x s) : Set (ι → DiffOp K)) := by
          rw [← hspan] at hy'
          refine Submodule.span_mono ?_ hy'
          intro z hz
          exact Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_coe.mp hz))
        have hx : x ∈ Submodule.span (DiffOp K) (↑(insert x s) : Set (ι → DiffOp K)) :=
          Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_self x s))
        have hsum := Submodule.add_mem _ (Submodule.smul_mem _ r hx) hsub
        rwa [add_sub_cancel] at hsum

end

end DiffOp

end GaloisForLFunctions.HTGeometry
