import GaloisForLFunctions.HTGeometry.DifferentialAdjoinFiniteTrdeg
import GaloisForLFunctions.HTGeometry.ProjectiveJetHorizon

/-!
# Finite algebraic state boundary for hypertranscendental clocks

Finite rational state-space systems can be expressed inside a derivation-closed intermediate
field generated by finitely many state coordinates.  Such a field has finite ordinary
transcendence degree over the coefficient field.  Differential elimination then forces every
observable in that field to be differentially algebraic over the coefficients.

This module isolates that exact algebraic interface.  It strictly extends the finite linear
Koopman and finite Hankel-rank boundaries: nonlinear rational state equations are allowed, and no
linear evolution or diagonalizable transfer operator is assumed.  It applies to finite rational
control systems, rational biochemical and gene-regulatory ODE models, finite polynomial neural
ODEs, and finite rational reductions of physical field models.

The positive theorem is the useful content: any derivation-closed state field containing a
hypertranscendental clock has transcendence degree at least `aleph0`.  Thus the obstruction is not
merely that one proposed evolution law fails.  The clock's complete observation structure cannot
fit inside any finite algebraic state budget.

Control/system-biology provenance: Y. Wang and E. D. Sontag, *Algebraic Differential Equations
and Rational Control Systems*, SIAM J. Control Optim. 30 (1992), 1126--1149, DOI
10.1137/0330060; H. A. Harrington, K. L. Ho, and N. Meshkat, *Differential Algebra for Model
Comparison*, arXiv:1603.09730.  ML provenance: C. Fronk and L. Petzold, *Interpretable Polynomial
Neural Ordinary Differential Equations*, Chaos 33 (2023), 043101, arXiv:2208.05072; M. Gonzalez,
M. Petreczky, and E. Toth, *Realization Theory of Recurrent Neural ODEs Using Polynomial System
Embeddings*, arXiv:2205.11989.  These sources supply the realization classes and elimination
interpretation; the statements below are the corresponding differential-field boundary.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A clock observable lies in a finite algebraic state model when it belongs to a
derivation-closed intermediate field of finite transcendence degree.  This is the invariant
differential-field content of a finite rational state-space realization. -/
def FiniteAlgebraicStateObservable
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (x : E) : Prop :=
  ∃ S : IntermediateField F E,
    DerivationClosed S ∧ Algebra.trdeg F S < Cardinal.aleph0 ∧ x ∈ S

/-- An observable contained in a derivation-closed finite-transcendence state field is
differentially algebraic over the base.  This is the reusable state-elimination interface. -/
theorem differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (S : IntermediateField F E) (hSclosed : DerivationClosed S)
    (hSfinite : Algebra.trdeg F S < Cardinal.aleph0)
    {x : E} (hxS : x ∈ S) :
    DifferentialAlgebraicOver F x := by
  apply differentialAlgebraicOver_of_intermediate_trdeg_lt_aleph0
    S hSclosed hSfinite
  unfold DifferentialAlgebraicOver
  intro hxind
  have htrans : Transcendental S x :=
    hxind.algebraicIndependent.transcendental Unit.unit
  exact htrans (by
    simpa using isAlgebraic_algebraMap
      (R := S) (A := E) (⟨x, hxS⟩ : S))

/-- Positive classification: every finite algebraic state observable is differentially
algebraic over the coefficient field. -/
theorem FiniteAlgebraicStateObservable.differentialAlgebraicOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : FiniteAlgebraicStateObservable F x) :
    DifferentialAlgebraicOver F x := by
  obtain ⟨S, hSclosed, hSfinite, hxS⟩ := hx
  exact differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    S hSclosed hSfinite hxS

/-- A hypertranscendental clock admits no finite algebraic state realization. -/
theorem not_finiteAlgebraicStateObservable_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : HypertranscendentalOver F x) :
    ¬ FiniteAlgebraicStateObservable F x := by
  intro hfinite
  exact hx hfinite.differentialAlgebraicOver

/-- **Positive state-complexity law.**  Every derivation-closed state field containing a
hypertranscendental clock has at least countable transcendence degree over the base. -/
theorem aleph0_le_trdeg_of_mem_derivationClosed_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (S : IntermediateField F E) (hSclosed : DerivationClosed S)
    {x : E} (hx : HypertranscendentalOver F x) (hxS : x ∈ S) :
    Cardinal.aleph0 ≤ Algebra.trdeg F S := by
  by_contra hnot
  have hfinite : Algebra.trdeg F S < Cardinal.aleph0 := lt_of_not_ge hnot
  exact hx (differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    S hSclosed hfinite hxS)

/-- The ambient algebraic state complexity of a hypertranscendental clock is at least countably
infinite, even without selecting a particular state subfield. -/
theorem aleph0_le_trdeg_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) :
    Cardinal.aleph0 ≤ Algebra.trdeg F E := by
  have hjets := algebraicIndependent_differentialJet_of_hypertranscendentalOver hx
  have h := hjets.lift_cardinalMk_le_trdeg
  simpa using h

end

end GaloisForLFunctions.HTGeometry
