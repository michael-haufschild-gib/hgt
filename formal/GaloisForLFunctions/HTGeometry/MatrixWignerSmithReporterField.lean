import GaloisForLFunctions.HTGeometry.MatrixWignerSmithDifferentialMatroid

/-!
# Generated field of the Wigner--Smith reporter panel

For any finite matrix over a characteristic-zero differential field containing an element
`ι` with `ι² = -1`, the diagonal, real-polarization, and imaginary-polarization reporters generate
exactly the same differential field as all matrix entries.  This is the field-level form of finite
Wigner--Smith tomography.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Set

noncomputable section

universe u

def matrixDelayDiagonalField
    {E : Type u} [Field E] {n : ℕ}
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j : Fin (n + 1)) : E :=
  Q j j

def matrixDelayPlusField
    {E : Type u} [Field E] {n : ℕ}
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j k : Fin (n + 1)) : E :=
  Q j j + Q j k + Q k j + Q k k

def matrixDelayImaginaryField
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (j k : Fin (n + 1)) : E :=
  Q j j + algebraMap F E ι * Q j k - algebraMap F E ι * Q k j + Q k k

/-- The nonredundant reporter panel, indexed by the same ordered pairs as the matrix entries. -/
def matrixDelayPanelField
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    Fin (n + 1) × Fin (n + 1) → E := fun p =>
  if p.1 = p.2 then
    matrixDelayDiagonalField Q p.1
  else if p.1 < p.2 then
    matrixDelayPlusField Q p.1 p.2
  else
    matrixDelayImaginaryField ι Q p.2 p.1

@[simp]
theorem matrixDelayPanelField_diagonal
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j : Fin (n + 1)) :
    matrixDelayPanelField ι Q (j, j) = Q j j := by
  simp [matrixDelayPanelField, matrixDelayDiagonalField]

theorem matrixDelayPanelField_plus
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (j k : Fin (n + 1)) (hjk : j < k) :
    matrixDelayPanelField ι Q (j, k) = matrixDelayPlusField Q j k := by
  simp [matrixDelayPanelField, ne_of_lt hjk, hjk]

theorem matrixDelayPanelField_imaginary
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (j k : Fin (n + 1)) (hjk : j < k) :
    matrixDelayPanelField ι Q (k, j) = matrixDelayImaginaryField ι Q j k := by
  simp [matrixDelayPanelField, ne_of_gt hjk, not_lt_of_ge hjk.le]

theorem matrixDelayField_offDiagonal_reconstruct
    {F E : Type u} [Field F] [Field E] [Algebra F E] [CharZero E] {n : ℕ}
    (ι : F) (hι : ι * ι = -1)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j k : Fin (n + 1)) :
    Q j k =
      ((matrixDelayPlusField Q j k - matrixDelayDiagonalField Q j -
          matrixDelayDiagonalField Q k) -
        algebraMap F E ι *
          (matrixDelayImaginaryField ι Q j k - matrixDelayDiagonalField Q j -
            matrixDelayDiagonalField Q k)) / 2 := by
  have hιE : algebraMap F E ι * algebraMap F E ι = -1 := by
    rw [← map_mul, hι, map_neg, map_one]
  rw [eq_div_iff (by norm_num : (2 : E) ≠ 0)]
  simp only [matrixDelayPlusField, matrixDelayDiagonalField, matrixDelayImaginaryField]
  ring_nf
  rw [show (algebraMap F E ι) ^ (2 : ℕ) = -1 by simpa [pow_two] using hιE]
  ring

theorem matrixDelayField_reverseOffDiagonal_reconstruct
    {F E : Type u} [Field F] [Field E] [Algebra F E] [CharZero E] {n : ℕ}
    (ι : F) (hι : ι * ι = -1)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j k : Fin (n + 1)) :
    Q k j =
      ((matrixDelayPlusField Q j k - matrixDelayDiagonalField Q j -
          matrixDelayDiagonalField Q k) +
        algebraMap F E ι *
          (matrixDelayImaginaryField ι Q j k - matrixDelayDiagonalField Q j -
            matrixDelayDiagonalField Q k)) / 2 := by
  have hιE : algebraMap F E ι * algebraMap F E ι = -1 := by
    rw [← map_mul, hι, map_neg, map_one]
  rw [eq_div_iff (by norm_num : (2 : E) ≠ 0)]
  simp only [matrixDelayPlusField, matrixDelayDiagonalField, matrixDelayImaginaryField]
  ring_nf
  rw [show (algebraMap F E ι) ^ (2 : ℕ) = -1 by simpa [pow_two] using hιE]
  ring

/-- Every panel reporter lies in the differential field generated by the matrix entries. -/
theorem matrixDelayPanelField_mem_entry_differentialAdjoin
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] {n : ℕ}
    (ι : F) (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (p : Fin (n + 1) × Fin (n + 1)) :
    matrixDelayPanelField ι Q p ∈ differentialAdjoin F
      (Set.range fun q : Fin (n + 1) × Fin (n + 1) => Q q.1 q.2) := by
  let qSet : Set E :=
    Set.range fun q : Fin (n + 1) × Fin (n + 1) => Q q.1 q.2
  let B := differentialAdjoin F qSet
  have hQ : ∀ j k, Q j k ∈ B := fun j k =>
    subset_differentialAdjoin F qSet ⟨(j, k), rfl⟩
  rcases p with ⟨j, k⟩
  rw [matrixDelayPanelField]
  split_ifs with heq hlt
  · exact hQ j j
  · exact B.add_mem (B.add_mem (B.add_mem (hQ j j) (hQ j k)) (hQ k j)) (hQ k k)
  · exact B.add_mem
      (B.sub_mem
        (B.add_mem (hQ k k) (B.mul_mem (B.algebraMap_mem ι) (hQ k j)))
        (B.mul_mem (B.algebraMap_mem ι) (hQ j k)))
      (hQ j j)

/-- Every matrix entry lies in the differential field generated by the reporter panel. -/
theorem matrixEntry_mem_delayPanelField_differentialAdjoin
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (j k : Fin (n + 1)) :
    Q j k ∈ differentialAdjoin F (Set.range (matrixDelayPanelField ι Q)) := by
  let B := differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
  have hdiag : ∀ a, Q a a ∈ B := by
    intro a
    have h := subset_differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
      ⟨(a, a), rfl⟩
    simpa using h
  by_cases heq : j = k
  · subst k
    exact hdiag j
  rcases lt_or_gt_of_ne heq with hjk | hkj
  · have hplus : matrixDelayPlusField Q j k ∈ B := by
      have h := subset_differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
        ⟨(j, k), rfl⟩
      rwa [matrixDelayPanelField_plus ι Q j k hjk] at h
    have himag : matrixDelayImaginaryField ι Q j k ∈ B := by
      have h := subset_differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
        ⟨(k, j), rfl⟩
      rwa [matrixDelayPanelField_imaginary ι Q j k hjk] at h
    rw [matrixDelayField_offDiagonal_reconstruct ι hι Q j k]
    exact B.div_mem
      (B.sub_mem
        (B.sub_mem (B.sub_mem hplus (hdiag j)) (hdiag k))
        (B.mul_mem (B.algebraMap_mem ι)
          (B.sub_mem (B.sub_mem himag (hdiag j)) (hdiag k))))
      (B.natCast_mem 2)
  · have hplus : matrixDelayPlusField Q k j ∈ B := by
      have h := subset_differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
        ⟨(k, j), rfl⟩
      rwa [matrixDelayPanelField_plus ι Q k j hkj] at h
    have himag : matrixDelayImaginaryField ι Q k j ∈ B := by
      have h := subset_differentialAdjoin F (Set.range (matrixDelayPanelField ι Q))
        ⟨(j, k), rfl⟩
      rwa [matrixDelayPanelField_imaginary ι Q k j hkj] at h
    rw [matrixDelayField_reverseOffDiagonal_reconstruct ι hι Q k j]
    exact B.div_mem
      (B.add_mem
        (B.sub_mem (B.sub_mem hplus (hdiag k)) (hdiag j))
        (B.mul_mem (B.algebraMap_mem ι)
          (B.sub_mem (B.sub_mem himag (hdiag k)) (hdiag j))))
      (B.natCast_mem 2)

/-- **Generated-field tomography.**  The `n²` scalar reporters generate exactly the differential
field generated by the `n²` matrix entries. -/
theorem differentialAdjoin_matrixDelayPanelField_eq_entries
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    differentialAdjoin F (Set.range (matrixDelayPanelField ι Q)) =
      differentialAdjoin F
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => Q p.1 p.2) := by
  apply le_antisymm
  · apply differentialAdjoin_le F
    · rintro _ ⟨p, rfl⟩
      exact matrixDelayPanelField_mem_entry_differentialAdjoin ι Q p
    · exact derivationClosed_differentialAdjoin F _
  · apply differentialAdjoin_le F
    · rintro _ ⟨p, rfl⟩
      exact matrixEntry_mem_delayPanelField_differentialAdjoin ι hι Q p.1 p.2
    · exact derivationClosed_differentialAdjoin F _

/-- The reporter panel and the matrix-entry family have equal rank in the genuine differential
matroid. -/
theorem matrixDelayPanelField_differentialMatroid_eRk_eq_entries
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    (differentialMatroid F E).eRk (Set.range (matrixDelayPanelField ι Q)) =
      (differentialMatroid F E).eRk
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => Q p.1 p.2) := by
  let M := differentialMatroid F E
  let qFamily : Fin (n + 1) × Fin (n + 1) → E := fun p => Q p.1 p.2
  let pFamily : Fin (n + 1) × Fin (n + 1) → E := matrixDelayPanelField ι Q
  have hPclose : Set.range pFamily ⊆ M.closure (Set.range qFamily) := by
    rintro _ ⟨p, rfl⟩
    apply (differentialMatroid_mem_closure_range_fintype_iff
      (F := F) (E := E) qFamily (pFamily p)).mpr
    let BQ := differentialAdjoin F (Set.range qFamily)
    let pBQ : BQ :=
      ⟨pFamily p, matrixDelayPanelField_mem_entry_differentialAdjoin ι Q p⟩
    have hp : DifferentialAlgebraicOver BQ (algebraMap BQ E pBQ) :=
      differentialAlgebraicOver_algebraMap pBQ
    simpa [BQ, pBQ] using hp
  have hQclose : Set.range qFamily ⊆ M.closure (Set.range pFamily) := by
    rintro _ ⟨p, rfl⟩
    apply (differentialMatroid_mem_closure_range_fintype_iff
      (F := F) (E := E) pFamily (qFamily p)).mpr
    let BP := differentialAdjoin F (Set.range pFamily)
    let qBP : BP :=
      ⟨qFamily p, matrixEntry_mem_delayPanelField_differentialAdjoin ι hι Q p.1 p.2⟩
    have hq : DifferentialAlgebraicOver BP (algebraMap BP E qBP) :=
      differentialAlgebraicOver_algebraMap qBP
    simpa [BP, qBP] using hq
  apply le_antisymm
  · calc
      M.eRk (Set.range pFamily) ≤ M.eRk (M.closure (Set.range qFamily)) :=
        M.eRk_mono hPclose
      _ = M.eRk (Set.range qFamily) := M.eRk_closure_eq _
  · calc
      M.eRk (Set.range qFamily) ≤ M.eRk (M.closure (Set.range pFamily)) :=
        M.eRk_mono hQclose
      _ = M.eRk (Set.range pFamily) := M.eRk_closure_eq _

/-- The fixed reporter panel of the Wigner--Smith matrix has exactly the same differential-matroid
rank as the original scattering matrix. -/
theorem matrixWignerSmith_delayPanel_differentialMatroid_eRk_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0) :
    (differentialMatroid F E).eRk
        (Set.range (matrixDelayPanelField ι (matrixWignerSmith ι S))) =
      (differentialMatroid F E).eRk
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  rw [matrixDelayPanelField_differentialMatroid_eRk_eq_entries ι hι,
    matrixWignerSmith_differentialMatroid_eRk_eq ι hι S hdet]

end

end GaloisForLFunctions.HTGeometry
