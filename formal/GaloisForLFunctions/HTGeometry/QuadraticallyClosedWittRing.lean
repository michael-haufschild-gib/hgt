import GaloisForLFunctions.HTGeometry.MilnorWittWittComparison

/-!
# The Witt ring of a quadratically closed field

Over a field in which every element is a square, all one-dimensional forms are isometric, so the
Witt ring is generated by a single class.  The consequences are that the fundamental ideal
vanishes, that the dimension modulo two is an isomorphism `W(F) ≅ ℤ/2`, and that the whole Pfister
filtration collapses.

The comparison between Milnor `K`-theory and the Witt ring therefore degenerates in every positive
degree: the `n`-fold Pfister form of a nonempty list is zero, so the degree-`n` comparison map
`K_n^M(F) → W(F)/I^{n+1}` is the zero map, and the image of a Milnor--Witt symbol in the Witt ring
is zero.

* `pfisterOne_eq_zero`, `fundamentalIdeal_eq_bot`, `fundamentalIdeal_pow_eq_bot` : the collapse of
  the Pfister filtration.
* `wittRingEquivZMod2` : the dimension modulo two is an isomorphism.
* `milnorPfisterMap_eq_zero`, `milnorWittToWitt_symbol_eq_zero` : the resulting degeneration of the
  comparison maps in positive degree.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

section QuadraticallyClosedWitt

variable (F : Type*) [Field F]

/-- In a field in which every element is a square, every unit is the square of a unit. -/
theorem exists_unit_sq (hsq : ∀ x : F, ∃ y : F, x = y * y) (a : Fˣ) : ∃ b : Fˣ, a = b ^ 2 := by
  obtain ⟨y, hy⟩ := hsq (a : F)
  have hy0 : y ≠ 0 := by
    intro h
    exact a.ne_zero (by rw [hy, h, mul_zero])
  refine ⟨Units.mk0 y hy0, Units.ext ?_⟩
  rw [Units.val_pow_eq_pow_val, pow_two]
  exact hy

/-- **All one-dimensional forms are isometric**: over a quadratically closed field every Witt class
of a unit is the unit of the ring. -/
theorem wittClass_eq_one (hsq : ∀ x : F, ∃ y : F, x = y * y) (a : Fˣ) :
    wittClass F a = 1 := by
  obtain ⟨b, rfl⟩ := exists_unit_sq F hsq a
  have h := wittClass_mul_sq (F := F) 1 b
  rw [one_mul] at h
  rw [h, wittClass_one]

/-- **Every one-fold Pfister form vanishes** over a quadratically closed field. -/
theorem pfisterOne_eq_zero (hsq : ∀ x : F, ∃ y : F, x = y * y) (a : Fˣ) :
    pfisterOne F a = 0 := by
  rw [pfisterOne, wittClass_eq_one F hsq, wittClass_eq_one F hsq, sub_self]

/-- **The fundamental ideal vanishes** over a quadratically closed field.  It is generated by the
one-fold Pfister forms, and those are all zero. -/
theorem fundamentalIdeal_eq_bot (hsq : ∀ x : F, ∃ y : F, x = y * y) :
    fundamentalIdeal F = ⊥ := by
  rw [fundamentalIdeal_eq_span]
  refine le_antisymm ?_ bot_le
  rw [Ideal.span_le]
  rintro _ ⟨a, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_bot]
  exact pfisterOne_eq_zero F hsq a

/-- **The whole Pfister filtration collapses**: every positive power of the fundamental ideal is
zero. -/
theorem fundamentalIdeal_pow_eq_bot (hsq : ∀ x : F, ∃ y : F, x = y * y) {n : ℕ} (hn : n ≠ 0) :
    fundamentalIdeal F ^ n = ⊥ :=
  le_antisymm (le_trans (Ideal.pow_le_self hn) (le_of_eq (fundamentalIdeal_eq_bot F hsq))) bot_le

/-- **The dimension modulo two is injective** over a quadratically closed field: its kernel is the
fundamental ideal, which is zero. -/
theorem wittDim_injective (hsq : ∀ x : F, ∃ y : F, x = y * y) :
    Function.Injective (wittDim F) := by
  intro x y h
  have hmem : x - y ∈ fundamentalIdeal F := by
    rw [mem_fundamentalIdeal, map_sub, h, sub_self]
  rw [fundamentalIdeal_eq_bot F hsq, Ideal.mem_bot, sub_eq_zero] at hmem
  exact hmem

/-- **The dimension modulo two is surjective**, for any field: the class of `1` has dimension
one. -/
theorem wittDim_surjective : Function.Surjective (wittDim F) := by
  intro y
  refine ⟨((y.val : ℕ) : WittRing F), ?_⟩
  rw [map_natCast]
  exact ZMod.natCast_rightInverse y

/-- **`W(F) ≅ ℤ/2` over a quadratically closed field**, with the dimension modulo two as the
isomorphism.  This is the Witt-ring form of the statement that rank is the only invariant of a
quadratic form once every unit is a square. -/
def wittRingEquivZMod2 (hsq : ∀ x : F, ∃ y : F, x = y * y) : WittRing F ≃+* ZMod 2 :=
  RingEquiv.ofBijective ((wittDim F : WittRing F →ₐ[ℤ] ZMod 2) : WittRing F →+* ZMod 2)
    ⟨wittDim_injective F hsq, wittDim_surjective F⟩

@[simp]
theorem wittRingEquivZMod2_apply (hsq : ∀ x : F, ∃ y : F, x = y * y) (x : WittRing F) :
    wittRingEquivZMod2 F hsq x = wittDim F x := rfl

/-- **Every Pfister form of positive fold vanishes** over a quadratically closed field. -/
theorem pfisterList_eq_zero (hsq : ∀ x : F, ∃ y : F, x = y * y) :
    ∀ {l : List Fˣ}, l ≠ [] → pfisterList F l = 0
  | [], h => absurd rfl h
  | a :: l, _ => by rw [pfisterList_cons, pfisterOne_eq_zero F hsq, zero_mul]

/-- **The Milnor--Witt symbols die in the Witt ring** over a quadratically closed field. -/
theorem milnorWittToWitt_symbol_eq_zero (hsq : ∀ x : F, ∃ y : F, x = y * y) (u : Fˣ) :
    milnorWittToWitt F (milnorWittSymbol u) = 0 := by
  rw [milnorWittToWitt_symbol]
  exact pfisterOne_eq_zero F hsq u

/-- **A product of Milnor--Witt symbols along a nonempty list dies in the Witt ring.** -/
theorem milnorWittToWitt_symbolList_eq_zero (hsq : ∀ x : F, ∃ y : F, x = y * y)
    {l : List Fˣ} (hl : l ≠ []) : milnorWittToWitt F (milnorWittSymbolList F l) = 0 := by
  rw [milnorWittToWitt_symbolList]
  exact pfisterList_eq_zero F hsq hl

/-- **The degree-`n` comparison map is zero for `n ≥ 1`** over a quadratically closed field: every
symbol of positive degree has a nonempty list, and its Pfister form already vanishes in the Witt
ring itself.  So the bottom edge of the fundamental cartesian square carries no information on a
quadratically closed chart. -/
theorem milnorPfisterMap_eq_zero (hsq : ∀ x : F, ∃ y : F, x = y * y) {n : ℕ} (hn : n ≠ 0)
    (x : MilnorKDeg F n) : milnorPfisterMap F n x = 0 := by
  refine QuotientAddGroup.induction_on x fun w => ?_
  induction w using FreeAbelianGroup.induction_on with
  | zero =>
    show milnorPfisterMap F n (0 : MilnorKDeg F n) = 0
    exact map_zero _
  | of s =>
    show milnorPfisterMap F n (milnorClassDeg F n s) = 0
    rw [milnorPfisterMap_class]
    have hne : s.val ≠ [] := by
      intro h
      exact hn (by rw [← s.property, h, List.length_nil])
    rw [pfisterList_eq_zero F hsq hne, map_zero]
  | neg s ih =>
    have hmk : (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) (-FreeAbelianGroup.of s)) =
        -(QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) (FreeAbelianGroup.of s)) := rfl
    have h1 : milnorPfisterMap F n (-(QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n)
          (FreeAbelianGroup.of s))) =
        -milnorPfisterMap F n (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n)
          (FreeAbelianGroup.of s)) := map_neg _ _
    rw [hmk, h1, ih, neg_zero]
  | add u v hu hv =>
    have hmk : (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) (u + v)) =
        QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) u +
          QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) v := rfl
    have h1 : milnorPfisterMap F n (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) u +
          QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) v) =
        milnorPfisterMap F n (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) u) +
          milnorPfisterMap F n (QuotientAddGroup.mk (s := milnorRelSubgroupDeg F n) v) :=
      map_add _ _ _
    rw [hmk, h1, hu, hv, add_zero]

end QuadraticallyClosedWitt

end

end GaloisForLFunctions.HTGeometry
