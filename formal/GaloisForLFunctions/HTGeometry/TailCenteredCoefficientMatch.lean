import GaloisForLFunctions.HTGeometry.TailCoefficientFixedField
import GaloisForLFunctions.HTGeometry.CenteredCoeffFieldRational
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

/-!
# The tail and centered coefficient models agree

The tail coefficients of the reciprocal jet and the coefficients of the centered generic polynomial
of one higher degree are two algebraically independent families of the same size over the same
constants.

So the fields they generate are both rational function fields in that many variables, and matching
the families identifies them.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K : Type*} [Field K] [CharZero K] {n : ℕ}

/-- The tail coefficients, read in the field of rational functions. -/
noncomputable def tailCoeffIn (K : Type*) [Field K] (n : ℕ) (j : Fin n) :
    FractionRing (MvPolynomial (Fin n) K) :=
  algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
    (tailCoeff K n j)

omit [CharZero K] in
theorem adjoin_range_tailCoeffIn :
    IntermediateField.adjoin K (Set.range (tailCoeffIn K n)) = tailCoeffField K n := rfl

/-- **The tail coefficients stay algebraically independent in the rational function field.** -/
theorem algebraicIndependent_tailCoeffIn :
    AlgebraicIndependent K (tailCoeffIn K n) := by
  have h := algebraicIndependent_tailCoeff (K := K) (n := n) |>.map'
    (f := IsScalarTower.toAlgHom K (MvPolynomial (Fin n) K)
      (FractionRing (MvPolynomial (Fin n) K)))
    (IsFractionRing.injective (MvPolynomial (Fin n) K)
      (FractionRing (MvPolynomial (Fin n) K)))
  have hfun : (⇑(IsScalarTower.toAlgHom K (MvPolynomial (Fin n) K)
      (FractionRing (MvPolynomial (Fin n) K))) ∘ tailCoeff K n) = tailCoeffIn K n :=
    _root_.funext fun _ => rfl
  rwa [hfun] at h

/-- **The tail coefficient field is a rational function field.** -/
noncomputable def tailCoeffFieldEquiv (K : Type*) [Field K] [CharZero K] (n : ℕ) :
    FractionRing (MvPolynomial (Fin n) K) ≃ₐ[K]
      ↥(IntermediateField.adjoin K (Set.range (tailCoeffIn K n))) :=
  (algebraicIndependent_tailCoeffIn (K := K) (n := n)).aevalEquivField

theorem coe_tailCoeffFieldEquiv_X (j : Fin n) :
    ((tailCoeffFieldEquiv K n
        (algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
          (MvPolynomial.X j)) :
        ↥(IntermediateField.adjoin K (Set.range (tailCoeffIn K n)))) :
      FractionRing (MvPolynomial (Fin n) K)) = tailCoeffIn K n j := by
  rw [tailCoeffFieldEquiv,
    (algebraicIndependent_tailCoeffIn (K := K) (n := n)).aevalEquivField_algebraMap_apply_coe,
    MvPolynomial.aeval_X]

/-- **The two coefficient models are isomorphic.**  Both are rational function fields on `n`
independent generators over the constants, so matching the generators identifies the field generated
by the tail coefficients with the field generated by the centered coefficients of the generic
polynomial of degree `n + 1`. -/
noncomputable def tailCenteredCoeffEquiv (K : Type*) [Field K] [CharZero K] (n : ℕ) :
    ↥(IntermediateField.adjoin K (Set.range (tailCoeffIn K n))) ≃ₐ[K]
      ↥(IntermediateField.adjoin K (Set.range (centeredLowCoeffIn K (n + 1)))) :=
  (tailCoeffFieldEquiv K n).symm.trans (centeredCoeffFieldEquiv K (n + 1) (by omega))

/-- **The identification matches the generators.** -/
theorem coe_tailCenteredCoeffEquiv (j : Fin n) :
    ((tailCenteredCoeffEquiv K n
        ⟨tailCoeffIn K n j,
          IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩⟩ :
        ↥(IntermediateField.adjoin K (Set.range (centeredLowCoeffIn K (n + 1))))) :
      centeredField K (n + 1)) = centeredLowCoeffIn K (n + 1) j := by
  have hsymm : (tailCoeffFieldEquiv K n).symm
      ⟨tailCoeffIn K n j, IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩⟩ =
      algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
        (MvPolynomial.X j) := by
    refine (AlgEquiv.symm_apply_eq _).2 ?_
    exact Subtype.ext (coe_tailCoeffFieldEquiv_X j).symm
  rw [tailCenteredCoeffEquiv, AlgEquiv.trans_apply, hsymm]
  exact coe_centeredCoeffFieldEquiv_X (K := K) (d := n + 1) (by omega) j

end GaloisForLFunctions.HTGeometry
