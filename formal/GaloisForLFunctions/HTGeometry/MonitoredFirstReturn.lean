import GaloisForLFunctions.HTGeometry.PrimeHodgeSteinGramian

/-!
# Monitored first return in finite dimension

Let `U` be an isometry of a finite-dimensional complex Hilbert space `H`, monitored on a
subspace `V` with orthogonal projection `P` and complement `Q = 1 - P`.  The first-return
amplitudes are `A_{k+1} = P U (QU)ᵏ P`, and the Haar-averaged first-return probabilities are
`p_{k+1} = ‖A_{k+1}‖²_F / dim V`.

* **Exit telescope.**  `∑_{k<N} ‖A_{k+1}‖²_F + ‖(QU)ᴺ P‖²_F = ‖P‖²_F = dim V`.
* **Finite-dimensional decay.**  If every state returns (`(QU)ᴺ P → 0`), the excursion `QU`
  restricted to the reachable space `R = span{(QU)ᵏ P x}` has `‖(QU|_R)ᴺ‖ → 0`, hence decays
  geometrically; `R` is the `U`-cyclic subspace generated by `V`.
* **Return quantization.**  For a unitary `U` with every state returning,
  `∑_k (k+1) ‖A_{k+1}‖²_F = dim R`: the mean return time is `K/d` with `K = dim R ∈ ℕ`.
  The proof dualizes the telescope: `R` reduces `QU`, and `∑_k ‖P (QU)*ᵏ y‖² = ‖y‖²` on `R`.
-/

open MeasureTheory Filter Topology Set ContinuousLinearMap
open scoped ENNReal NNReal ComplexConjugate InnerProductSpace

noncomputable section

namespace GaloisForLFunctions.HTGeometry

section Frobenius

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]

/-- The Frobenius norm squared `‖T‖²_F = Re tr(T*T)`. -/
def frobeniusSq (T : H →L[ℂ] H) : ℝ :=
  RCLike.re (LinearMap.trace ℂ H ((adjoint T ∘L T : H →L[ℂ] H) : H →ₗ[ℂ] H))

theorem frobeniusSq_eq_sum {ι : Type*} [Fintype ι] (b : OrthonormalBasis ι ℂ H) (T : H →L[ℂ] H) :
    frobeniusSq T = ∑ i, ‖T (b i)‖ ^ 2 := by
  rw [frobeniusSq, LinearMap.trace_eq_sum_inner _ b, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [ContinuousLinearMap.coe_coe, comp_apply, adjoint_inner_right]
  exact inner_self_eq_norm_sq (T (b i))

theorem frobeniusSq_nonneg (T : H →L[ℂ] H) : 0 ≤ frobeniusSq T := by
  rw [frobeniusSq_eq_sum (stdOrthonormalBasis ℂ H)]
  positivity

theorem isProj_starProjection (K : Submodule ℂ H) :
    LinearMap.IsProj K (K.starProjection : H →ₗ[ℂ] H) :=
  ⟨fun x => by
    rw [ContinuousLinearMap.coe_coe, Submodule.starProjection_apply]
    exact (K.orthogonalProjectionOnto x).2,
  fun x hx => by
    rw [ContinuousLinearMap.coe_coe]
    exact Submodule.starProjection_eq_self_iff.mpr hx⟩

theorem starProjection_mem (K : Submodule ℂ H) (v : H) : K.starProjection v ∈ K := by
  rw [Submodule.starProjection_apply]
  exact (K.orthogonalProjectionOnto v).2

theorem norm_starProjection_sq (K : Submodule ℂ H) (v : H) :
    ‖K.starProjection v‖ ^ 2 = RCLike.re ⟪v, K.starProjection v⟫_ℂ := by
  rw [← @inner_self_eq_norm_sq ℂ, Submodule.inner_starProjection_left_eq_right,
    Submodule.starProjection_eq_self_iff.mpr (starProjection_mem K v)]

/-- `‖P_K‖²_F = dim K`. -/
theorem frobeniusSq_starProjection (K : Submodule ℂ H) :
    frobeniusSq K.starProjection = Module.finrank ℂ K := by
  have htr := (isProj_starProjection K).trace
  rw [LinearMap.trace_eq_sum_inner _ (stdOrthonormalBasis ℂ H)] at htr
  rw [frobeniusSq_eq_sum (stdOrthonormalBasis ℂ H)]
  simp_rw [norm_starProjection_sq]
  rw [← map_sum]
  simp only [ContinuousLinearMap.coe_coe] at htr
  rw [htr]
  simp

/-- `‖T*‖²_F = ‖T‖²_F`. -/
theorem frobeniusSq_adjoint (T : H →L[ℂ] H) : frobeniusSq (adjoint T) = frobeniusSq T := by
  set b := stdOrthonormalBasis ℂ H
  rw [frobeniusSq_eq_sum b, frobeniusSq_eq_sum b]
  have h1 : ∀ i, ‖adjoint T (b i)‖ ^ 2 = ∑ j, ‖⟪b j, adjoint T (b i)⟫_ℂ‖ ^ 2 := fun i =>
    (b.sum_sq_norm_inner_right _).symm
  have h2 : ∀ j, ‖T (b j)‖ ^ 2 = ∑ i, ‖⟪b i, T (b j)⟫_ℂ‖ ^ 2 := fun j =>
    (b.sum_sq_norm_inner_right _).symm
  simp_rw [h1, h2]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
  rw [adjoint_inner_right, ← inner_conj_symm, RCLike.norm_conj]

end Frobenius

/-! ## The monitored system -/

section Monitored

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
  (U : H →L[ℂ] H) (V : Submodule ℂ H)

/-- The excursion step `M = Q U` with `Q = 1 - P`. -/
def excursionStep : H →L[ℂ] H := (ContinuousLinearMap.id ℂ H - V.starProjection) ∘L U

/-- The first-return amplitude `A_{k+1} = P U (QU)ᵏ P`. -/
def firstReturnAmplitude (k : ℕ) : H →L[ℂ] H :=
  V.starProjection ∘L U ∘L (excursionStep U V ^ k) ∘L V.starProjection

/-- The Haar-averaged first-return probability `p_{k+1} = ‖A_{k+1}‖²_F / dim V`. -/
def firstReturnProb (k : ℕ) : ℝ := frobeniusSq (firstReturnAmplitude U V k) / Module.finrank ℂ V

/-- The reachable space `R = span{(QU)ᵏ P x}`. -/
def reachableSpace : Submodule ℂ H :=
  Submodule.span ℂ {y | ∃ k : ℕ, ∃ x : H, y = (excursionStep U V ^ k) (V.starProjection x)}

theorem mem_reachableSpace (k : ℕ) (x : H) :
    (excursionStep U V ^ k) (V.starProjection x) ∈ reachableSpace U V :=
  Submodule.subset_span ⟨k, x, rfl⟩

theorem starProjection_mem_reachableSpace (x : H) : V.starProjection x ∈ reachableSpace U V := by
  simpa using mem_reachableSpace U V 0 x

theorem le_reachableSpace : V ≤ reachableSpace U V := fun x hx => by
  rw [← Submodule.starProjection_eq_self_iff.mpr hx]
  exact starProjection_mem_reachableSpace U V x

theorem excursionStep_mem_reachableSpace {y : H} (hy : y ∈ reachableSpace U V) :
    excursionStep U V y ∈ reachableSpace U V := by
  refine Submodule.span_induction (p := fun y _ => excursionStep U V y ∈ reachableSpace U V)
    ?_ (by simp) (fun a b _ _ ha hb => by rw [map_add]; exact add_mem ha hb)
    (fun c a _ ha => by rw [map_smul]; exact Submodule.smul_mem _ c ha) hy
  rintro _ ⟨k, x, rfl⟩
  have := mem_reachableSpace U V (k + 1) x
  rwa [pow_succ', mul_def, comp_apply] at this

theorem U_mem_reachableSpace {y : H} (hy : y ∈ reachableSpace U V) :
    U y ∈ reachableSpace U V := by
  have hsplit : U y = V.starProjection (U y) + excursionStep U V y := by
    rw [excursionStep, comp_apply, sub_apply, id_apply]
    abel
  rw [hsplit]
  exact add_mem (starProjection_mem_reachableSpace U V _) (excursionStep_mem_reachableSpace U V hy)

omit [FiniteDimensional ℂ H] in
theorem U_mem_iSup_map {y : H} (hy : y ∈ ⨆ k : ℕ, V.map ((U ^ k : H →L[ℂ] H) : H →ₗ[ℂ] H)) :
    U y ∈ ⨆ k : ℕ, V.map ((U ^ k : H →L[ℂ] H) : H →ₗ[ℂ] H) := by
  refine Submodule.iSup_induction (fun k : ℕ => V.map ((U ^ k : H →L[ℂ] H) : H →ₗ[ℂ] H))
    (motive := fun y => U y ∈ ⨆ k : ℕ, V.map ((U ^ k : H →L[ℂ] H) : H →ₗ[ℂ] H)) hy ?_ (by simp)
    (fun a b ha hb => by simp only [map_add]; exact add_mem ha hb)
  rintro k _ ⟨v, hv, rfl⟩
  refine Submodule.mem_iSup_of_mem (k + 1) ⟨v, hv, ?_⟩
  rw [ContinuousLinearMap.coe_coe, ContinuousLinearMap.coe_coe, pow_succ', mul_def, comp_apply]

/-- The reachable space is the `U`-cyclic subspace generated by `V`. -/
theorem reachableSpace_eq_iSup_map :
    reachableSpace U V = ⨆ k : ℕ, V.map ((U ^ k : H →L[ℂ] H) : H →ₗ[ℂ] H) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) (iSup_le fun k => ?_)
  · rintro _ ⟨k, x, rfl⟩
    induction k generalizing x with
    | zero =>
      refine Submodule.mem_iSup_of_mem 0 ⟨V.starProjection x, ?_, by simp⟩
      rw [Submodule.starProjection_apply]
      exact (V.orthogonalProjectionOnto x).2
    | succ k ih =>
      have hz := ih x
      set z := (excursionStep U V ^ k) (V.starProjection x)
      rw [pow_succ', mul_def, comp_apply]
      rw [show excursionStep U V z = U z - V.starProjection (U z) by
        rw [excursionStep, comp_apply, sub_apply, id_apply]]
      exact sub_mem (U_mem_iSup_map U V hz) (Submodule.mem_iSup_of_mem 0
        ⟨V.starProjection (U z), starProjection_mem V _, by simp⟩)
  · rintro _ ⟨v, hv, rfl⟩
    induction k generalizing v with
    | zero => simpa using le_reachableSpace U V hv
    | succ k ih =>
      rw [ContinuousLinearMap.coe_coe, pow_succ', mul_def, comp_apply]
      exact U_mem_reachableSpace U V (ih v hv)

/-! ### The exit telescope -/

theorem norm_sq_eq_starProjection_add (x : H) :
    ‖x‖ ^ 2 = ‖V.starProjection x‖ ^ 2 + ‖x - V.starProjection x‖ ^ 2 := by
  have h := Submodule.norm_sq_eq_add_norm_sq_projection x V
  have h1 : ‖V.starProjection x‖ = ‖V.orthogonalProjectionOnto x‖ := by
    rw [Submodule.starProjection_apply]
    rfl
  have h2 : ‖x - V.starProjection x‖ = ‖Vᗮ.orthogonalProjectionOnto x‖ := by
    rw [← Submodule.starProjection_orthogonal_val, Submodule.starProjection_apply]
    rfl
  rw [h1, h2]
  exact h

variable {U}

/-- One monitored step: `‖y‖² = ‖P U y‖² + ‖QU y‖²`. -/
theorem norm_sq_monitored_step (hU : ∀ x, ‖U x‖ = ‖x‖) (y : H) :
    ‖y‖ ^ 2 = ‖V.starProjection (U y)‖ ^ 2 + ‖excursionStep U V y‖ ^ 2 := by
  rw [← hU y, norm_sq_eq_starProjection_add V (U y), excursionStep, comp_apply, sub_apply, id_apply]

theorem norm_excursionStep_le (hU : ∀ x, ‖U x‖ = ‖x‖) (y : H) :
    ‖excursionStep U V y‖ ≤ ‖y‖ := by
  have h := norm_sq_monitored_step V hU y
  nlinarith [norm_nonneg (excursionStep U V y), norm_nonneg y,
    sq_nonneg ‖V.starProjection (U y)‖]

theorem norm_excursionStep_pow_le (hU : ∀ x, ‖U x‖ = ‖x‖) (N : ℕ) (y : H) :
    ‖(excursionStep U V ^ N) y‖ ≤ ‖y‖ := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [pow_succ', mul_def, comp_apply]
    exact (norm_excursionStep_le V hU _).trans ih

theorem firstReturnAmplitude_apply (k : ℕ) (x : H) :
    firstReturnAmplitude U V k x
      = V.starProjection (U ((excursionStep U V ^ k) (V.starProjection x))) := rfl

/-- **Exit telescope.**  `∑_{k<N} ‖A_{k+1} x‖² + ‖(QU)ᴺ P x‖² = ‖P x‖²`. -/
theorem firstReturn_telescope (hU : ∀ x, ‖U x‖ = ‖x‖) (x : H) (N : ℕ) :
    ∑ k ∈ Finset.range N, ‖firstReturnAmplitude U V k x‖ ^ 2
      + ‖(excursionStep U V ^ N) (V.starProjection x)‖ ^ 2 = ‖V.starProjection x‖ ^ 2 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, pow_succ' (excursionStep U V) N, mul_def, comp_apply,
      firstReturnAmplitude_apply]
    have h := norm_sq_monitored_step V hU ((excursionStep U V ^ N) (V.starProjection x))
    linarith

/-- **Exit telescope, Frobenius form.**  `∑_{k<N} ‖A_{k+1}‖²_F + ‖(QU)ᴺ P‖²_F = dim V`. -/
theorem firstReturn_frobenius_telescope (hU : ∀ x, ‖U x‖ = ‖x‖) (N : ℕ) :
    ∑ k ∈ Finset.range N, frobeniusSq (firstReturnAmplitude U V k)
      + frobeniusSq ((excursionStep U V ^ N) ∘L V.starProjection) = Module.finrank ℂ V := by
  set b := stdOrthonormalBasis ℂ H
  rw [← frobeniusSq_starProjection V, frobeniusSq_eq_sum b, frobeniusSq_eq_sum b]
  simp_rw [frobeniusSq_eq_sum b, comp_apply]
  rw [Finset.sum_comm, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => firstReturn_telescope V hU (b i) N

/-! ### Geometric decay on the reachable space -/

theorem tendsto_excursionStep_pow_of_mem
    (hrec : ∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop (𝓝 0))
    {y : H} (hy : y ∈ reachableSpace U V) :
    Tendsto (fun N => (excursionStep U V ^ N) y) atTop (𝓝 0) := by
  refine Submodule.span_induction
    (p := fun y _ => Tendsto (fun N => (excursionStep U V ^ N) y) atTop (𝓝 0)) ?_ (by simp)
    (fun a b _ _ ha hb => by simpa using ha.add hb)
    (fun c a _ ha => by simpa using ha.const_smul c) hy
  rintro _ ⟨k, x, rfl⟩
  have h := (hrec x).comp (tendsto_add_atTop_nat k)
  refine h.congr fun N => ?_
  simp only [Function.comp_apply]
  rw [pow_add, mul_def, comp_apply]

theorem excursionStep_pow_mem_reachableSpace (N : ℕ) {y : H} (hy : y ∈ reachableSpace U V) :
    (excursionStep U V ^ N) y ∈ reachableSpace U V := by
  induction N with
  | zero => simpa using hy
  | succ N ih =>
    rw [pow_succ', mul_def, comp_apply]
    exact excursionStep_mem_reachableSpace U V ih

/-- **Finite-dimensional decay.**  If every state returns, `QU` contracts the reachable space
geometrically: `‖(QU)ᴺ y‖ ≤ 2^{-⌊N/N₀⌋} ‖y‖`. -/
theorem exists_reachable_decay (hU : ∀ x, ‖U x‖ = ‖x‖)
    (hrec : ∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop (𝓝 0)) :
    ∃ N₀ : ℕ, 0 < N₀ ∧ ∀ N, ∀ y ∈ reachableSpace U V,
      ‖(excursionStep U V ^ N) y‖ ≤ (1 / 2) ^ (N / N₀) * ‖y‖ := by
  set R := reachableSpace U V
  set f := stdOrthonormalBasis ℂ R
  have hc : Tendsto (fun N => ∑ j, ‖(excursionStep U V ^ N) (f j : H)‖) atTop (𝓝 0) := by
    have := tendsto_finsetSum (Finset.univ : Finset (Fin (Module.finrank ℂ R)))
      fun j _ => (tendsto_excursionStep_pow_of_mem V hrec (f j).2).norm
    simpa using this
  have hbound : ∀ N, ∀ y ∈ R, ‖(excursionStep U V ^ N) y‖
      ≤ (∑ j, ‖(excursionStep U V ^ N) (f j : H)‖) * ‖y‖ := by
    intro N y hy
    set yR : R := ⟨y, hy⟩
    have hrep : y = ∑ j, ⟪f j, yR⟫_ℂ • (f j : H) := by
      have h := f.sum_repr' yR
      have h2 := congrArg (fun z : R => (z : H)) h
      simpa using h2.symm
    have hnorm : ‖yR‖ = ‖y‖ := rfl
    conv_lhs => rw [hrep]
    rw [map_sum, Finset.sum_mul]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    rw [map_smul, norm_smul, mul_comm]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    refine (norm_inner_le_norm _ _).trans ?_
    rw [OrthonormalBasis.norm_eq_one, one_mul, hnorm]
  obtain ⟨N₁, hN₁⟩ :=
    (hc.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))).exists_forall_of_atTop
  obtain ⟨N₀, hN₀, hhalf⟩ : ∃ N₀ : ℕ, 0 < N₀ ∧
      ∀ y ∈ R, ‖(excursionStep U V ^ N₀) y‖ ≤ 1 / 2 * ‖y‖ :=
    ⟨N₁ + 1, by omega, fun y hy => (hbound (N₁ + 1) y hy).trans
      (mul_le_mul_of_nonneg_right (hN₁ (N₁ + 1) (by omega)).le (norm_nonneg _))⟩
  have hiter : ∀ q, ∀ y ∈ R, ‖(excursionStep U V ^ (N₀ * q)) y‖ ≤ (1 / 2) ^ q * ‖y‖ := by
    intro q
    induction q with
    | zero => intro y _; simp
    | succ q ih =>
      intro y hy
      rw [Nat.mul_succ, pow_add, mul_def, comp_apply]
      refine (ih _ (excursionStep_pow_mem_reachableSpace V _ hy)).trans ?_
      rw [pow_succ, mul_assoc]
      exact mul_le_mul_of_nonneg_left (hhalf y hy) (by positivity)
  refine ⟨N₀, hN₀, fun N y hy => ?_⟩
  have hN : N = N₀ * (N / N₀) + N % N₀ := (Nat.div_add_mod N N₀).symm
  conv_lhs => rw [hN, pow_add, mul_def, comp_apply]
  refine (hiter _ _ (excursionStep_pow_mem_reachableSpace V _ hy)).trans ?_
  exact mul_le_mul_of_nonneg_left (norm_excursionStep_pow_le V hU _ _) (by positivity)

/-! ### No finite closed recurrence realizes the Hodge exit law -/

omit [FiniteDimensional ℂ H] in
theorem norm_le_sqrt_frobenius_basis {ι : Type*} [Fintype ι] (b : OrthonormalBasis ι ℂ H)
    (T : H →L[ℂ] H) (i : ι) : ‖T (b i)‖ ^ 2 ≤ ∑ j, ‖T (b j)‖ ^ 2 :=
  Finset.single_le_sum (f := fun j => ‖T (b j)‖ ^ 2) (fun _ _ => sq_nonneg _) (Finset.mem_univ i)

/-- Frobenius convergence to zero forces strong convergence to zero. -/
theorem tendsto_apply_of_frobeniusSq {T : ℕ → H →L[ℂ] H}
    (h : Tendsto (fun N => frobeniusSq (T N)) atTop (𝓝 0)) (x : H) :
    Tendsto (fun N => T N x) atTop (𝓝 0) := by
  set b := stdOrthonormalBasis ℂ H
  have hi : ∀ i, Tendsto (fun N => T N (b i)) atTop (𝓝 0) := by
    intro i
    rw [tendsto_zero_iff_norm_tendsto_zero]
    have hs := h.sqrt
    rw [Real.sqrt_zero] at hs
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hs (fun _ => norm_nonneg _)
      fun N => ?_
    rw [frobeniusSq_eq_sum b]
    exact Real.le_sqrt_of_sq_le (norm_le_sqrt_frobenius_basis b (T N) i)
  have hx : ∀ N, T N x = ∑ i, ⟪b i, x⟫_ℂ • T N (b i) := fun N => by
    conv_lhs => rw [← b.sum_repr' x]
    rw [map_sum]
    simp_rw [map_smul]
  simp_rw [hx]
  have := tendsto_finsetSum (Finset.univ : Finset (Fin (Module.finrank ℂ H)))
    fun i _ => (hi i).const_smul ⟪b i, x⟫_ℂ
  simpa using this

theorem m_ge_cube (n : ℕ) : 105 / (2 * (n : ℝ) + 7) ^ 3 ≤ PrimeHodgeHistory.m n := by
  rw [PrimeHodgeHistory.m]
  push_cast
  apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
  have h0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have h1 : 2 * (n : ℝ) + 3 ≤ 2 * n + 7 := by linarith
  have h2 : 2 * (n : ℝ) + 5 ≤ 2 * n + 7 := by linarith
  calc (2 * (n : ℝ) + 3) * (2 * n + 5) * (2 * n + 7) ≤ (2 * n + 7) * (2 * n + 7) * (2 * n + 7) := by
        gcongr
    _ = (2 * (n : ℝ) + 7) ^ 3 := by ring

/-- **Theorem PHRD-C.**  No finite-dimensional monitored isometry has Haar-averaged first-return
law `p_{k+1} = w_k`: the exact Hodge history has an `n⁻⁴` exit tail, while every finite closed
recurrence decays geometrically. -/
theorem not_forall_firstReturnProb_eq_w (hU : ∀ x, ‖U x‖ = ‖x‖)
    (hV : 0 < Module.finrank ℂ V) :
    ¬∀ k, firstReturnProb U V k = PrimeHodgeHistory.w k := by
  intro h
  set d : ℝ := (Module.finrank ℂ V : ℝ) with hd_def
  have hd : (0 : ℝ) < d := by rw [hd_def]; exact_mod_cast hV
  have hfrob : ∀ k, frobeniusSq (firstReturnAmplitude U V k) = d * PrimeHodgeHistory.w k :=
    fun k => by
      have := h k
      rw [firstReturnProb, div_eq_iff hd.ne'] at this
      rw [this]
      ring
  have htail : ∀ N, frobeniusSq ((excursionStep U V ^ N) ∘L V.starProjection)
      = d * PrimeHodgeHistory.m N := by
    intro N
    have h1 := firstReturn_frobenius_telescope V hU N
    simp_rw [hfrob] at h1
    rw [← Finset.mul_sum, PrimeHodgeHistory.sum_range_w] at h1
    linarith
  have hrec : ∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop
      (𝓝 0) := by
    intro x
    have h0 : Tendsto (fun N => frobeniusSq ((excursionStep U V ^ N) ∘L V.starProjection))
        atTop (𝓝 0) := by
      simp_rw [htail]
      simpa using PrimeHodgeHistory.m_tendsto_zero.const_mul d
    exact tendsto_apply_of_frobeniusSq h0 x
  obtain ⟨N₀, hN₀, hdecay⟩ := exists_reachable_decay V hU hrec
  set b := stdOrthonormalBasis ℂ H
  have hle : ∀ k, PrimeHodgeHistory.m (N₀ * k) ≤ (1 / 4) ^ k := by
    intro k
    have h1 : frobeniusSq ((excursionStep U V ^ (N₀ * k)) ∘L V.starProjection)
        ≤ (1 / 4) ^ k * d := by
      rw [frobeniusSq_eq_sum b, hd_def, ← frobeniusSq_starProjection V, frobeniusSq_eq_sum b,
        Finset.mul_sum]
      refine Finset.sum_le_sum fun i _ => ?_
      rw [comp_apply]
      have h2 := hdecay (N₀ * k) _ (starProjection_mem_reachableSpace U V (b i))
      rw [Nat.mul_div_cancel_left k hN₀] at h2
      calc ‖(excursionStep U V ^ (N₀ * k)) (V.starProjection (b i))‖ ^ 2
          ≤ ((1 / 2) ^ k * ‖V.starProjection (b i)‖) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) h2 2
        _ = (1 / 4) ^ k * ‖V.starProjection (b i)‖ ^ 2 := by
            rw [mul_pow, ← pow_mul, mul_comm k 2, pow_mul]
            norm_num
    rw [htail] at h1
    nlinarith
  have hbig : Tendsto (fun k : ℕ => (2 * ((N₀ * k : ℕ) : ℝ) + 7) ^ 3 * (1 / 4) ^ k) atTop
      (𝓝 0) := by
    have hlim := (tendsto_pow_const_mul_const_pow_of_abs_lt_one 3
      (show |(1 / 4 : ℝ)| < 1 by norm_num)).const_mul (729 * (N₀ : ℝ) ^ 3)
    rw [mul_zero] at hlim
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hlim
      (Eventually.of_forall fun k => by positivity) ?_
    filter_upwards [eventually_ge_atTop 1] with k hk
    have hk' : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have hN : (1 : ℝ) ≤ N₀ := by exact_mod_cast hN₀
    have hb : 2 * ((N₀ * k : ℕ) : ℝ) + 7 ≤ 9 * N₀ * k := by
      push_cast
      nlinarith
    calc (2 * ((N₀ * k : ℕ) : ℝ) + 7) ^ 3 * (1 / 4) ^ k ≤ (9 * N₀ * k) ^ 3 * (1 / 4) ^ k :=
          mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hb 3) (by positivity)
      _ = 729 * (N₀ : ℝ) ^ 3 * ((k : ℝ) ^ 3 * (1 / 4) ^ k) := by ring
  obtain ⟨k, hk⟩ := (hbig.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 105))).exists
  have h1 := (m_ge_cube (N₀ * k)).trans (hle k)
  have hpos : (0 : ℝ) < (2 * ((N₀ * k : ℕ) : ℝ) + 7) ^ 3 := by positivity
  rw [div_le_iff₀ hpos] at h1
  linarith [hk]

/-! ### Return quantization -/

section Unitary

variable (hU : adjoint U ∘L U = 1)
include hU

theorem norm_apply_of_adjoint_comp (x : H) : ‖U x‖ = ‖x‖ := by
  have h := congrArg (fun A : H →L[ℂ] H => RCLike.re ⟪x, A x⟫_ℂ) hU
  simp only [comp_apply, adjoint_inner_right, one_apply_eq_self] at h
  rw [inner_self_eq_norm_sq, inner_self_eq_norm_sq] at h
  exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h

theorem surjective_of_adjoint_comp : Function.Surjective U := by
  have hinj : Function.Injective (U : H →ₗ[ℂ] H) := fun x y hxy => by
    have h := congrArg (fun v => adjoint U v) hxy
    simp only [ContinuousLinearMap.coe_coe] at h
    have := congrArg (fun A : H →L[ℂ] H => A x) hU
    have := congrArg (fun A : H →L[ℂ] H => A y) hU
    simp only [comp_apply, one_apply_eq_self] at *
    rw [← ‹adjoint U (U x) = x›, ← ‹adjoint U (U y) = y›, h]
  exact LinearMap.injective_iff_surjective.mp hinj

theorem apply_adjoint_apply (y : H) : U (adjoint U y) = y := by
  obtain ⟨z, rfl⟩ := surjective_of_adjoint_comp hU y
  have := congrArg (fun A : H →L[ℂ] H => A z) hU
  simp only [comp_apply, one_apply_eq_self] at this
  rw [this]

theorem norm_adjoint_apply (y : H) : ‖adjoint U y‖ = ‖y‖ := by
  rw [← norm_apply_of_adjoint_comp hU, apply_adjoint_apply hU]

theorem adjoint_mem_reachableSpace {y : H} (hy : y ∈ reachableSpace U V) :
    adjoint U y ∈ reachableSpace U V := by
  set R := reachableSpace U V
  let UR : R →ₗ[ℂ] R := (U : H →ₗ[ℂ] H).restrict fun x hx => U_mem_reachableSpace U V hx
  have hinj : Function.Injective UR := fun a b hab => by
    have h := congrArg (fun z : R => (z : H)) hab
    simp only [UR, LinearMap.restrict_apply, ContinuousLinearMap.coe_coe] at h
    have h2 := congrArg (fun v => adjoint U v) h
    have ha := congrArg (fun A : H →L[ℂ] H => A a) hU
    have hb := congrArg (fun A : H →L[ℂ] H => A b) hU
    simp only [comp_apply, one_apply_eq_self] at ha hb h2
    exact Subtype.ext (by rw [← ha, ← hb, h2])
  obtain ⟨z, hz⟩ := (LinearMap.injective_iff_surjective.mp hinj) ⟨y, hy⟩
  have hz' : U z = y := congrArg Subtype.val hz
  have := congrArg (fun A : H →L[ℂ] H => A z) hU
  simp only [comp_apply, one_apply_eq_self] at this
  rw [← hz', this]
  exact z.2

omit hU in
theorem adjoint_excursionStep_apply (y : H) :
    adjoint (excursionStep U V) y = adjoint U (y - V.starProjection y) := by
  refine ext_inner_left ℂ fun v => ?_
  rw [adjoint_inner_right, adjoint_inner_right, excursionStep, comp_apply, sub_apply, id_apply,
    inner_sub_left, inner_sub_right, Submodule.inner_starProjection_left_eq_right]

theorem adjoint_excursionStep_mem {y : H} (hy : y ∈ reachableSpace U V) :
    adjoint (excursionStep U V) y ∈ reachableSpace U V := by
  rw [adjoint_excursionStep_apply]
  exact adjoint_mem_reachableSpace V hU
    (sub_mem hy (starProjection_mem_reachableSpace U V y))

/-- The dual monitored step `‖z‖² = ‖P z‖² + ‖(QU)* z‖²`. -/
theorem norm_sq_dual_step (z : H) :
    ‖z‖ ^ 2 = ‖V.starProjection z‖ ^ 2 + ‖adjoint (excursionStep U V) z‖ ^ 2 := by
  rw [adjoint_excursionStep_apply, norm_adjoint_apply hU, norm_sq_eq_starProjection_add V z]

omit hU in
theorem adjoint_pow_excursionStep (k : ℕ) :
    adjoint (excursionStep U V ^ k) = adjoint (excursionStep U V) ^ k := by
  rw [← ContinuousLinearMap.star_eq_adjoint, star_pow, ContinuousLinearMap.star_eq_adjoint]

theorem dual_telescope (y : H) (N : ℕ) :
    ∑ k ∈ Finset.range N, ‖V.starProjection ((adjoint (excursionStep U V) ^ k) y)‖ ^ 2
      + ‖(adjoint (excursionStep U V) ^ N) y‖ ^ 2 = ‖y‖ ^ 2 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, pow_succ' (adjoint (excursionStep U V)) N, mul_def, comp_apply]
    have h := norm_sq_dual_step V hU ((adjoint (excursionStep U V) ^ N) y)
    linarith

variable (hrec : ∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop (𝓝 0))
include hrec

theorem tendsto_adjoint_pow_of_mem {y : H} (hy : y ∈ reachableSpace U V) :
    Tendsto (fun N => (adjoint (excursionStep U V) ^ N) y) atTop (𝓝 0) := by
  obtain ⟨N₀, hN₀, hdecay⟩ := exists_reachable_decay V (norm_apply_of_adjoint_comp hU) hrec
  have hmem : ∀ N, (adjoint (excursionStep U V) ^ N) y ∈ reachableSpace U V := by
    intro N
    induction N with
    | zero => simpa using hy
    | succ N ih =>
      rw [pow_succ', mul_def, comp_apply]
      exact adjoint_excursionStep_mem V hU ih
  have hbound : ∀ N, ‖(adjoint (excursionStep U V) ^ N) y‖ ≤ (1 / 2) ^ (N / N₀) * ‖y‖ := by
    intro N
    set w := (adjoint (excursionStep U V) ^ N) y
    have h1 : ‖w‖ ^ 2 ≤ ‖y‖ * ((1 / 2) ^ (N / N₀) * ‖w‖) := by
      have hinner : ‖w‖ ^ 2 = RCLike.re ⟪y, (excursionStep U V ^ N) w⟫_ℂ := by
        rw [← adjoint_inner_left, adjoint_pow_excursionStep V]
        exact (inner_self_eq_norm_sq w).symm
      rw [hinner]
      refine (RCLike.re_le_norm _).trans ((norm_inner_le_norm _ _).trans ?_)
      exact mul_le_mul_of_nonneg_left (hdecay N w (hmem N)) (norm_nonneg _)
    rcases (norm_nonneg w).eq_or_lt with h0 | h0
    · rw [← h0]
      positivity
    · nlinarith
  rw [tendsto_zero_iff_norm_tendsto_zero]
  have hlim : Tendsto (fun N => (1 / 2 : ℝ) ^ (N / N₀) * ‖y‖) atTop (𝓝 0) := by
    have := ((tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (by norm_num)).comp (Nat.tendsto_div_const_atTop hN₀.ne')).mul_const ‖y‖
    simpa using this
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim
    (fun _ => norm_nonneg _) hbound

/-- **Dual observability.**  `∑_k ‖P (QU)*ᵏ y‖² = ‖Π_R y‖²` for every `y`. -/
theorem hasSum_dual_observability (y : H) :
    HasSum (fun k => ‖V.starProjection ((adjoint (excursionStep U V) ^ k)
      y)‖ ^ 2) (‖(reachableSpace U V).starProjection y‖ ^ 2) := by
  set R := reachableSpace U V
  set yR := R.starProjection y
  have hproj : ∀ k, V.starProjection ((adjoint (excursionStep U V) ^ k) y)
      = V.starProjection ((adjoint (excursionStep U V) ^ k) yR) := by
    intro k
    have hperp : y - yR ∈ Rᗮ := by
      rw [← Submodule.starProjection_orthogonal_val]
      exact starProjection_mem Rᗮ y
    have hzero : V.starProjection ((adjoint (excursionStep U V) ^ k) (y - yR)) = 0 := by
      refine ext_inner_left ℂ fun v => ?_
      rw [inner_zero_right, ← Submodule.inner_starProjection_left_eq_right,
        ← adjoint_pow_excursionStep V, adjoint_inner_right]
      exact Submodule.inner_right_of_mem_orthogonal
        (excursionStep_pow_mem_reachableSpace V k (starProjection_mem_reachableSpace U V v)) hperp
    rw [map_sub, map_sub, sub_eq_zero] at hzero
    exact hzero
  simp_rw [hproj]
  rw [hasSum_iff_tendsto_nat_of_nonneg (fun _ => sq_nonneg _)]
  have hmem : yR ∈ R := starProjection_mem R y
  have h := ((tendsto_adjoint_pow_of_mem V hU hrec hmem).norm.pow 2)
  simp only [norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow] at h
  have h2 := (tendsto_const_nhds (x := ‖yR‖ ^ 2)).sub h
  rw [sub_zero] at h2
  refine h2.congr fun N => ?_
  have := dual_telescope V hU yR N
  linarith

/-- `∑_k ‖(QU)ᵏ P‖²_F = dim R`. -/
theorem hasSum_frobeniusSq_excursion_starProjection :
    HasSum (fun k => frobeniusSq ((excursionStep U V ^ k) ∘L V.starProjection))
      (Module.finrank ℂ (reachableSpace U V)) := by
  set b := stdOrthonormalBasis ℂ H
  have hk : ∀ k, frobeniusSq ((excursionStep U V ^ k) ∘L V.starProjection)
      = ∑ j, ‖V.starProjection ((adjoint (excursionStep U V) ^ k) (b j))‖ ^ 2 := by
    intro k
    rw [← frobeniusSq_adjoint, frobeniusSq_eq_sum b, adjoint_comp, adjoint_pow_excursionStep V]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [comp_apply, show adjoint V.starProjection = V.starProjection from
      (Submodule.starProjection_isSymmetric V).isSelfAdjoint.adjoint_eq]
  simp_rw [hk]
  rw [← frobeniusSq_starProjection, frobeniusSq_eq_sum b]
  exact hasSum_sum fun j _ => hasSum_dual_observability V hU hrec (b j)

omit hrec in
theorem frobeniusSq_firstReturnAmplitude_eq (k : ℕ) :
    frobeniusSq (firstReturnAmplitude U V k)
      = frobeniusSq ((excursionStep U V ^ k) ∘L V.starProjection)
        - frobeniusSq ((excursionStep U V ^ (k + 1)) ∘L V.starProjection) := by
  have h1 := firstReturn_frobenius_telescope V (norm_apply_of_adjoint_comp hU) k
  have h2 := firstReturn_frobenius_telescope V (norm_apply_of_adjoint_comp hU) (k + 1)
  rw [Finset.sum_range_succ] at h2
  linarith

/-- **(PHRD.5), return quantization.**  For a unitary monitored system in which every state
returns, `∑_k (k+1) ‖A_{k+1}‖²_F = dim R`, the dimension of the `U`-cyclic subspace generated by
`V`; the mean return time is the rational `dim R / dim V`. -/
theorem hasSum_succ_mul_frobeniusSq_firstReturn :
    HasSum (fun k : ℕ => ((k : ℝ) + 1) * frobeniusSq (firstReturnAmplitude U V k))
      (Module.finrank ℂ (reachableSpace U V)) := by
  set f := fun k => frobeniusSq ((excursionStep U V ^ k) ∘L V.starProjection)
  have hf := hasSum_frobeniusSq_excursion_starProjection V hU hrec
  have hparts : ∀ N, ∑ k ∈ Finset.range N, ((k : ℝ) + 1) * frobeniusSq (firstReturnAmplitude U V k)
      = ∑ k ∈ Finset.range N, f k - N * f N := by
    intro N
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ, ih, Finset.sum_range_succ,
        frobeniusSq_firstReturnAmplitude_eq V hU N]
      push_cast
      ring
  obtain ⟨N₀, hN₀, hdecay⟩ := exists_reachable_decay V (norm_apply_of_adjoint_comp hU) hrec
  set b := stdOrthonormalBasis ℂ H
  set d : ℝ := (Module.finrank ℂ V : ℝ)
  have hfle : ∀ N, f N ≤ (1 / 4) ^ (N / N₀) * d := by
    intro N
    simp only [f]
    rw [frobeniusSq_eq_sum b, show d = frobeniusSq V.starProjection from
      (frobeniusSq_starProjection V).symm, frobeniusSq_eq_sum b, Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    rw [comp_apply]
    calc ‖(excursionStep U V ^ N) (V.starProjection (b i))‖ ^ 2
        ≤ ((1 / 2) ^ (N / N₀) * ‖V.starProjection (b i)‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _)
            (hdecay N _ (starProjection_mem_reachableSpace U V (b i))) 2
      _ = (1 / 4) ^ (N / N₀) * ‖V.starProjection (b i)‖ ^ 2 := by
          rw [mul_pow, ← pow_mul, mul_comm (N / N₀) 2, pow_mul]
          norm_num
  have hNf : Tendsto (fun N : ℕ => (N : ℝ) * f N) atTop (𝓝 0) := by
    have hq : Tendsto (fun N : ℕ => (N / N₀ : ℕ)) atTop atTop := Nat.tendsto_div_const_atTop hN₀.ne'
    have hg : Tendsto (fun q : ℕ => ((q : ℝ) + 1) * (1 / 4) ^ q) atTop (𝓝 0) := by
      have h1 := tendsto_self_mul_const_pow_of_abs_lt_one (show |(1 / 4 : ℝ)| < 1 by norm_num)
      have h2 := tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 4)
        (by norm_num)
      simpa [add_mul] using h1.add h2
    have hup := ((hg.comp hq).const_mul ((N₀ : ℝ) * d))
    rw [mul_zero] at hup
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hup
      (fun N => mul_nonneg (Nat.cast_nonneg N) (frobeniusSq_nonneg _)) fun N => ?_
    have hN : (N : ℝ) ≤ N₀ * ((N / N₀ : ℕ) + 1) := by
      have := Nat.lt_div_mul_add (a := N) hN₀
      have h' : N ≤ N₀ * (N / N₀ + 1) := by nlinarith [Nat.div_add_mod N N₀, Nat.mod_lt N hN₀]
      exact_mod_cast h'
    have hd0 : 0 ≤ d := Nat.cast_nonneg _
    calc (N : ℝ) * f N ≤ (N₀ * ((N / N₀ : ℕ) + 1)) * ((1 / 4) ^ (N / N₀) * d) :=
          mul_le_mul hN (hfle N) (frobeniusSq_nonneg _) (by positivity)
      _ = (N₀ : ℝ) * d * ((((N / N₀ : ℕ) : ℝ) + 1) * (1 / 4) ^ (N / N₀)) := by ring
  rw [hasSum_iff_tendsto_nat_of_nonneg (fun k => mul_nonneg (by positivity)
    (frobeniusSq_nonneg _))]
  simp_rw [hparts]
  have := hf.tendsto_sum_nat.sub hNf
  rw [sub_zero] at this
  exact this

/-- **Theorem PHRD-B.**  If a unitary monitored system in which every state returns has mean
return time `7/4`, then `4 ∣ dim V` and `7 ∣ dim R`. -/
theorem four_dvd_and_seven_dvd_of_mean (hV : 0 < Module.finrank ℂ V)
    (hmean : HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb U V k) (7 / 4)) :
    4 ∣ Module.finrank ℂ V ∧ 7 ∣ Module.finrank ℂ (reachableSpace U V) := by
  have hd : (0 : ℝ) < Module.finrank ℂ V := by exact_mod_cast hV
  have hK := (hasSum_succ_mul_frobeniusSq_firstReturn V hU hrec).div_const
    (Module.finrank ℂ V : ℝ)
  have hK' : HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb U V k)
      ((Module.finrank ℂ (reachableSpace U V) : ℝ) / Module.finrank ℂ V) := by
    refine hK.congr_fun fun k => ?_
    rw [firstReturnProb]
    ring
  have heq := hmean.unique hK'
  rw [eq_div_iff hd.ne'] at heq
  have hnat : 4 * Module.finrank ℂ (reachableSpace U V) = 7 * Module.finrank ℂ V := by
    have : ((4 * Module.finrank ℂ (reachableSpace U V) : ℕ) : ℝ)
        = ((7 * Module.finrank ℂ V : ℕ) : ℝ) := by
      push_cast
      linarith
    exact_mod_cast this
  constructor
  · have h4 : 4 ∣ 7 * Module.finrank ℂ V := ⟨_, hnat.symm⟩
    exact (Nat.Coprime.dvd_of_dvd_mul_left (by norm_num) h4)
  · have h7 : 7 ∣ 4 * Module.finrank ℂ (reachableSpace U V) := ⟨_, hnat⟩
    exact (Nat.Coprime.dvd_of_dvd_mul_left (by norm_num) h7)

end Unitary

end Monitored

/-! ## The minimal coarse realization `(d, K) = (4, 7)` -/

section MinimalRealization

/-- The involution `0 ↦ 0`, `j ↔ j + 3` (`j = 1, 2, 3`) of `Fin 7`. -/
def quarterSwap : Equiv.Perm (Fin 7) where
  toFun := ![0, 4, 5, 6, 1, 2, 3]
  invFun := ![0, 4, 5, 6, 1, 2, 3]
  left_inv := by decide
  right_inv := by decide

/-- The seven-dimensional space `V ⊕ W`, `V = span(e₀, e₁, e₂, e₃)`, `W = span(e₄, e₅, e₆)`. -/
abbrev QuarterSpace := EuclideanSpace ℂ (Fin 7)

/-- The unitary `U e₀ = e₀`, `U e_j = e_{j+3}`, `U e_{j+3} = e_j`. -/
def quarterUnitary : QuarterSpace →L[ℂ] QuarterSpace :=
  ((LinearIsometryEquiv.piLpCongrLeft 2 ℂ ℂ quarterSwap : QuarterSpace ≃ₗᵢ[ℂ] QuarterSpace) :
    QuarterSpace →L[ℂ] QuarterSpace)

theorem quarterUnitary_apply (f : QuarterSpace) (i : Fin 7) :
    (quarterUnitary f).ofLp i = f.ofLp (quarterSwap i) := by
  show (LinearIsometryEquiv.piLpCongrLeft 2 ℂ ℂ quarterSwap f).ofLp i = _
  rw [LinearIsometryEquiv.piLpCongrLeft_apply]
  rfl

theorem adjoint_quarterUnitary_comp : adjoint quarterUnitary ∘L quarterUnitary = 1 := by
  rw [quarterUnitary, LinearIsometryEquiv.adjoint_eq_symm]
  ext1 f
  exact (LinearIsometryEquiv.piLpCongrLeft 2 ℂ ℂ quarterSwap).symm_apply_apply f

/-- The monitored subspace `V = {f : f₄ = f₅ = f₆ = 0}`. -/
def quarterMonitor : Submodule ℂ QuarterSpace where
  carrier := {f | ∀ i : Fin 7, 4 ≤ (i : ℕ) → f.ofLp i = 0}
  add_mem' {f g} hf hg i hi := by
    simp only [WithLp.ofLp_add, Pi.add_apply, hf i hi, hg i hi, add_zero]
  zero_mem' i _ := by simp
  smul_mem' c f hf i hi := by
    simp only [WithLp.ofLp_smul, Pi.smul_apply, hf i hi, smul_zero]

theorem single_mem_quarterMonitor {i : Fin 7} (hi : (i : ℕ) < 4) :
    EuclideanSpace.single i (1 : ℂ) ∈ quarterMonitor := fun j hj => by
  rw [PiLp.single_apply, if_neg (by intro h; subst h; omega)]

theorem single_mem_quarterMonitor_orthogonal {i : Fin 7} (hi : 4 ≤ (i : ℕ)) :
    EuclideanSpace.single i (1 : ℂ) ∈ quarterMonitorᗮ := by
  rw [Submodule.mem_orthogonal]
  intro u hu
  rw [EuclideanSpace.inner_single_right, hu i hi]
  simp

theorem quarterProjection_coord (f : QuarterSpace) (i : Fin 7) :
    (quarterMonitor.starProjection f).ofLp i = if (i : ℕ) < 4 then f.ofLp i else 0 := by
  have h1 : (quarterMonitor.starProjection f).ofLp i
      = ⟪EuclideanSpace.single i (1 : ℂ), quarterMonitor.starProjection f⟫_ℂ := by
    rw [EuclideanSpace.inner_single_left]
    simp
  rw [h1, ← Submodule.inner_starProjection_left_eq_right]
  split_ifs with hi
  · rw [Submodule.starProjection_eq_self_iff.mpr (single_mem_quarterMonitor hi),
      EuclideanSpace.inner_single_left]
    simp
  · rw [(Submodule.starProjection_apply_eq_zero_iff quarterMonitor).mpr
      (single_mem_quarterMonitor_orthogonal (by omega)), inner_zero_left]

theorem quarterExcursion_coord (g : QuarterSpace) (i : Fin 7) :
    (excursionStep quarterUnitary quarterMonitor g).ofLp i
      = if (i : ℕ) < 4 then 0 else g.ofLp (quarterSwap i) := by
  rw [excursionStep, comp_apply, sub_apply, id_apply, WithLp.ofLp_sub, Pi.sub_apply,
    quarterProjection_coord, quarterUnitary_apply]
  split_ifs <;> simp

theorem quarterExcursion_projection_coord (f : QuarterSpace) (i : Fin 7) :
    (excursionStep quarterUnitary quarterMonitor (quarterMonitor.starProjection f)).ofLp i
      = if (i : ℕ) < 4 then 0 else f.ofLp (quarterSwap i) := by
  rw [quarterExcursion_coord, quarterProjection_coord]
  fin_cases i <;> simp [quarterSwap]

theorem quarterExcursion_sq_projection (f : QuarterSpace) :
    (excursionStep quarterUnitary quarterMonitor ^ 2) (quarterMonitor.starProjection f) = 0 := by
  ext i
  rw [pow_two, mul_def, comp_apply, quarterExcursion_coord, quarterExcursion_projection_coord]
  fin_cases i <;> simp [quarterSwap]

theorem quarterExcursion_pow_projection {N : ℕ} (hN : 2 ≤ N) (f : QuarterSpace) :
    (excursionStep quarterUnitary quarterMonitor ^ N) (quarterMonitor.starProjection f) = 0 := by
  obtain ⟨k, rfl⟩ : ∃ k, N = k + 2 := ⟨N - 2, by omega⟩
  rw [pow_add, mul_def, comp_apply, quarterExcursion_sq_projection, map_zero]

theorem quarterFirstReturn_zero_coord (f : QuarterSpace) (i : Fin 7) :
    (firstReturnAmplitude quarterUnitary quarterMonitor 0 f).ofLp i
      = if i = 0 then f.ofLp 0 else 0 := by
  rw [firstReturnAmplitude_apply, pow_zero, one_apply_eq_self, quarterProjection_coord,
    quarterUnitary_apply, quarterProjection_coord]
  fin_cases i <;> simp [quarterSwap]

theorem quarterFirstReturn_one_coord (f : QuarterSpace) (i : Fin 7) :
    (firstReturnAmplitude quarterUnitary quarterMonitor 1 f).ofLp i
      = if (i : ℕ) = 1 ∨ (i : ℕ) = 2 ∨ (i : ℕ) = 3 then f.ofLp i else 0 := by
  rw [firstReturnAmplitude_apply, pow_one, quarterProjection_coord, quarterUnitary_apply,
    quarterExcursion_projection_coord]
  fin_cases i <;> simp [quarterSwap]

theorem quarterFirstReturn_of_two_le {k : ℕ} (hk : 2 ≤ k) :
    firstReturnAmplitude quarterUnitary quarterMonitor k = 0 := by
  ext1 f
  rw [firstReturnAmplitude_apply, quarterExcursion_pow_projection hk, map_zero, map_zero,
    zero_apply]

theorem frobeniusSq_quarter_basis (T : QuarterSpace →L[ℂ] QuarterSpace) :
    frobeniusSq T = ∑ j, ∑ i, ‖(T (EuclideanSpace.single j (1 : ℂ))).ofLp i‖ ^ 2 := by
  rw [frobeniusSq_eq_sum (EuclideanSpace.basisFun (Fin 7) ℂ)]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [EuclideanSpace.basisFun_apply, EuclideanSpace.norm_sq_eq]

theorem finrank_quarterMonitor : Module.finrank ℂ quarterMonitor = 4 := by
  have h := frobeniusSq_starProjection quarterMonitor
  rw [frobeniusSq_quarter_basis] at h
  simp_rw [quarterProjection_coord, PiLp.single_apply] at h
  simp [Fin.sum_univ_seven] at h
  exact_mod_cast h.symm

theorem quarterFirstReturnProb_zero : firstReturnProb quarterUnitary quarterMonitor 0 = 1 / 4 := by
  rw [firstReturnProb, finrank_quarterMonitor, frobeniusSq_quarter_basis]
  simp_rw [quarterFirstReturn_zero_coord, PiLp.single_apply]
  simp [Fin.sum_univ_seven]

theorem quarterFirstReturnProb_one : firstReturnProb quarterUnitary quarterMonitor 1 = 3 / 4 := by
  rw [firstReturnProb, finrank_quarterMonitor, frobeniusSq_quarter_basis]
  simp_rw [quarterFirstReturn_one_coord, PiLp.single_apply]
  simp [Fin.sum_univ_seven]
  norm_num

theorem quarterFirstReturnProb_of_two_le {k : ℕ} (hk : 2 ≤ k) :
    firstReturnProb quarterUnitary quarterMonitor k = 0 := by
  rw [firstReturnProb, quarterFirstReturn_of_two_le hk, frobeniusSq_quarter_basis]
  simp

theorem quarter_recurrent (x : QuarterSpace) :
    Tendsto (fun N => (excursionStep quarterUnitary quarterMonitor ^ N)
      (quarterMonitor.starProjection x)) atTop (𝓝 0) :=
  tendsto_const_nhds.congr' (by
    filter_upwards [eventually_ge_atTop 2] with N hN
    exact (quarterExcursion_pow_projection hN x).symm)

theorem reachableSpace_quarter : reachableSpace quarterUnitary quarterMonitor = ⊤ := by
  have hsingle : ∀ j : Fin 7, EuclideanSpace.single j (1 : ℂ)
      ∈ reachableSpace quarterUnitary quarterMonitor := by
    intro j
    by_cases hj : (j : ℕ) < 4
    · exact le_reachableSpace quarterUnitary quarterMonitor (single_mem_quarterMonitor hj)
    · have h := mem_reachableSpace quarterUnitary quarterMonitor 1
        (EuclideanSpace.single (quarterSwap j) (1 : ℂ))
      have heq : (excursionStep quarterUnitary quarterMonitor ^ 1)
          (quarterMonitor.starProjection (EuclideanSpace.single (quarterSwap j) (1 : ℂ)))
          = EuclideanSpace.single j (1 : ℂ) := by
        ext i
        rw [pow_one, quarterExcursion_projection_coord, PiLp.single_apply,
          PiLp.single_apply]
        fin_cases j <;> fin_cases i <;> simp [quarterSwap] at hj ⊢
      rwa [heq] at h
  rw [eq_top_iff]
  intro x _
  rw [← (EuclideanSpace.basisFun (Fin 7) ℂ).sum_repr' x]
  refine Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ ?_
  rw [EuclideanSpace.basisFun_apply]
  exact hsingle j

theorem finrank_reachableSpace_quarter :
    Module.finrank ℂ (reachableSpace quarterUnitary quarterMonitor) = 7 := by
  rw [reachableSpace_quarter, finrank_top, finrank_euclideanSpace_fin]

theorem hasSum_quarter_mean :
    HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb quarterUnitary quarterMonitor k)
      (7 / 4) := by
  have h : HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb quarterUnitary quarterMonitor k)
      (∑ k ∈ Finset.range 2, ((k : ℝ) + 1) * firstReturnProb quarterUnitary quarterMonitor k) :=
    hasSum_sum_of_ne_finset_zero fun k hk => by
      rw [quarterFirstReturnProb_of_two_le (by simp at hk; omega), mul_zero]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, quarterFirstReturnProb_zero,
    quarterFirstReturnProb_one] at h
  convert h using 1
  norm_num

/-- **(PHRD.6).**  The first-return generating matrix on `V` is `diag(z, z², z², z²)`, with
determinant `z⁷`. -/
theorem det_quarterFirstReturn_generating (z : ℂ) :
    Matrix.det (Matrix.of fun i j : Fin 4 =>
      ∑ k ∈ Finset.range 2, z ^ (k + 1) *
        (firstReturnAmplitude quarterUnitary quarterMonitor k
          (EuclideanSpace.single (Fin.castLE (by norm_num) j) (1 : ℂ))).ofLp
            (Fin.castLE (by norm_num) i)) = z ^ 7 := by
  have hdiag : (Matrix.of fun i j : Fin 4 =>
      ∑ k ∈ Finset.range 2, z ^ (k + 1) *
        (firstReturnAmplitude quarterUnitary quarterMonitor k
          (EuclideanSpace.single (Fin.castLE (by norm_num) j) (1 : ℂ))).ofLp
            (Fin.castLE (by norm_num) i)) = Matrix.diagonal ![z, z ^ 2, z ^ 2, z ^ 2] := by
    ext i j
    simp only [Matrix.of_apply, Finset.sum_range_succ, Finset.sum_range_zero, zero_add,
      quarterFirstReturn_zero_coord, quarterFirstReturn_one_coord, PiLp.single_apply]
    fin_cases i <;> fin_cases j <;> simp [Matrix.diagonal]
  rw [hdiag, Matrix.det_diagonal, Fin.prod_univ_four]
  simp
  ring

/-- **Theorem PHRD-B, existence.**  The minimal pair `(d, K) = (4, 7)` occurs: the seven-dimensional
unitary above has `dim V = 4`, recurrent return, `p₁ = 1/4`, `p₂ = 3/4`, mean `7/4`, and
cyclic dimension `7`. -/
theorem quarter_minimal_realization :
    adjoint quarterUnitary ∘L quarterUnitary = 1 ∧
      Module.finrank ℂ quarterMonitor = 4 ∧
      (∀ x, Tendsto (fun N => (excursionStep quarterUnitary quarterMonitor ^ N)
        (quarterMonitor.starProjection x)) atTop (𝓝 0)) ∧
      firstReturnProb quarterUnitary quarterMonitor 0 = 1 / 4 ∧
      firstReturnProb quarterUnitary quarterMonitor 1 = 3 / 4 ∧
      HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb quarterUnitary quarterMonitor k)
        (7 / 4) ∧
      Module.finrank ℂ (reachableSpace quarterUnitary quarterMonitor) = 7 :=
  ⟨adjoint_quarterUnitary_comp, finrank_quarterMonitor, quarter_recurrent,
    quarterFirstReturnProb_zero, quarterFirstReturnProb_one, hasSum_quarter_mean,
    finrank_reachableSpace_quarter⟩

end MinimalRealization

/-! ## The prime–Hodge return denominator -/

/-- **(PHRD.9).**  `w_{n-1} ≥ 2/(3n⁴)` for `n ≥ 1`. -/
theorem w_pred_ge {n : ℕ} (hn : 1 ≤ n) :
    2 / (3 * (n : ℝ) ^ 4) ≤ PrimeHodgeHistory.w (n - 1) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Nat.add_sub_cancel, PrimeHodgeHistory.w_formula]
  push_cast
  have hk : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  have h1 : 2 * (k : ℝ) + 3 ≤ 3 * (k + 1) := by linarith
  have h2 : 2 * (k : ℝ) + 5 ≤ 5 * (k + 1) := by linarith
  have h3 : 2 * (k : ℝ) + 7 ≤ 7 * (k + 1) := by linarith
  have h4 : 2 * (k : ℝ) + 9 ≤ 9 * (k + 1) := by linarith
  have hprod : (2 * (k : ℝ) + 3) * (2 * k + 5) * (2 * k + 7) * (2 * k + 9)
      ≤ 3 * (k + 1) * (5 * (k + 1)) * (7 * (k + 1)) * (9 * (k + 1)) := by gcongr
  nlinarith [hprod]

theorem finrank_le_reachableSpace {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [FiniteDimensional ℂ H] (U : H →L[ℂ] H) (V : Submodule ℂ H) :
    Module.finrank ℂ V ≤ Module.finrank ℂ (reachableSpace U V) :=
  Submodule.finrank_mono (le_reachableSpace U V)

/-- **ULF-PHRD-001.**
* **(A)** the Hodge exit law has mean `∑ (n+1) w_n = ∑ m_n = 7/4`;
* **(B)** every finite-dimensional unitary monitored system in which every state returns has
  mean `K/d` with `K` the dimension of the cyclic subspace generated by the monitored subspace;
  mean `7/4` forces `4 ∣ d` and `7 ∣ K`, and the minimal pair `(4, 7)` occurs;
* **(C)** no finite-dimensional monitored isometry has first-return law `p_n = w_{n-1}`. -/
theorem prime_hodge_return_denominator :
    HasSum PrimeHodgeHistory.w 1 ∧ HasSum PrimeHodgeHistory.m (7 / 4) ∧
      HasSum (fun n : ℕ => ((n : ℝ) + 1) * PrimeHodgeHistory.w n) (7 / 4) ∧
      (∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
        (U : H →L[ℂ] H) (V : Submodule ℂ H), adjoint U ∘L U = 1 →
        (∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop (𝓝 0)) →
        HasSum (fun k : ℕ => ((k : ℝ) + 1) * frobeniusSq (firstReturnAmplitude U V k))
          (Module.finrank ℂ (reachableSpace U V))) ∧
      (∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
        (U : H →L[ℂ] H) (V : Submodule ℂ H), adjoint U ∘L U = 1 →
        (∀ x, Tendsto (fun N => (excursionStep U V ^ N) (V.starProjection x)) atTop (𝓝 0)) →
        0 < Module.finrank ℂ V →
        HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb U V k) (7 / 4) →
        4 ∣ Module.finrank ℂ V ∧ 7 ∣ Module.finrank ℂ (reachableSpace U V)) ∧
      (Module.finrank ℂ quarterMonitor = 4 ∧
        Module.finrank ℂ (reachableSpace quarterUnitary quarterMonitor) = 7 ∧
        HasSum (fun k : ℕ => ((k : ℝ) + 1) * firstReturnProb quarterUnitary quarterMonitor k)
          (7 / 4)) ∧
      (∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
        (U : H →L[ℂ] H) (V : Submodule ℂ H), (∀ x, ‖U x‖ = ‖x‖) → 0 < Module.finrank ℂ V →
        ¬∀ k, firstReturnProb U V k = PrimeHodgeHistory.w k) :=
  ⟨PrimeHodgeHistory.hasSum_w, hasSum_m, hasSum_succ_mul_w,
    fun _ V hU hrec => hasSum_succ_mul_frobeniusSq_firstReturn V hU hrec,
    fun _ V hU hrec hV hmean => four_dvd_and_seven_dvd_of_mean V hU hrec hV hmean,
    ⟨finrank_quarterMonitor, finrank_reachableSpace_quarter, hasSum_quarter_mean⟩,
    fun _ V hU hV => not_forall_firstReturnProb_eq_w V hU hV⟩

end GaloisForLFunctions.HTGeometry
