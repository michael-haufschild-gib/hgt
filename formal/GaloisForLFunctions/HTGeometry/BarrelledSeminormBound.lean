import Mathlib.Analysis.LocallyConvex.Barrelled

/-!
# Seminorm bounds from pointwise bounds on a barrelled space

On a barrelled space whose topology is generated by a family of seminorms — for instance any
Fréchet space — a pointwise bounded family of continuous linear functionals is uniformly bounded
by finitely many of those seminorms.  A functional dominated by such a family inherits the same
bound.

This is the mechanism that converts "each operator is trace class" into a seminorm estimate on
the trace functional: the finite-rank truncations of the trace are continuous and pointwise
bounded by the trace norm, so Banach--Steinhaus makes them equicontinuous, and the limit
functional obeys the resulting bound.

* `exists_seminorm_bound_of_bddAbove` : the uniform bound for the family.
* `exists_seminorm_bound_of_le_iSup` : the bound for a dominated functional.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Filter

section Barrelled

variable {ι kappa E : Type*} [AddCommGroup E] [Module ℝ E]
variable [UniformSpace E] [IsUniformAddGroup E] [ContinuousSMul ℝ E] [BarrelledSpace ℝ E]
variable {p : SeminormFamily ℝ E ι}

/-- **Banach--Steinhaus with an explicit seminorm bound.**  A pointwise bounded family of
continuous linear functionals on a barrelled space is uniformly bounded by a fixed finite
supremum of the defining seminorms. -/
theorem exists_seminorm_bound_of_bddAbove (hp : WithSeminorms p)
    (F : kappa → E →L[ℝ] ℝ)
    (H : ∀ x : E, BddAbove (Set.range fun k => ‖F k x‖)) :
    ∃ (s : Finset ι) (C : NNReal), ∀ (k : kappa) (x : E), ‖F k x‖ ≤ C * (s.sup p) x := by
  have hq : WithSeminorms (fun _ : Fin 1 => normSeminorm ℝ ℝ) := norm_withSeminorms ℝ ℝ
  have hbdd : ∀ (i : Fin 1) (x : E), BddAbove (Set.range fun k => normSeminorm ℝ ℝ (F k x)) := by
    intro _ x
    simpa using H x
  have hequi : UniformEquicontinuous ((↑) ∘ F) := hq.banach_steinhaus hbdd
  have htfae := (hq.equicontinuous_TFAE (fun k => (F k : E →ₗ[ℝ] ℝ))).out 2 3
  obtain ⟨q, hqcont, hqle⟩ := htfae.mp hequi 0
  obtain ⟨s, C, _, hqC⟩ := Seminorm.bound_of_continuous hp q hqcont
  refine ⟨s, C, fun k x => ?_⟩
  have h1 : ‖F k x‖ ≤ q x := hqle k x
  have h2 : q x ≤ (C • s.sup p) x := hqC x
  have h3 : (C • s.sup p) x = C * (s.sup p) x := rfl
  rw [h3] at h2
  exact le_trans h1 h2

/-- A functional dominated by a pointwise bounded family of continuous linear functionals obeys
the same seminorm bound. -/
theorem exists_seminorm_bound_of_le_iSup [Nonempty kappa] (hp : WithSeminorms p)
    (F : kappa → E →L[ℝ] ℝ) (T : E → ℝ)
    (H : ∀ x : E, BddAbove (Set.range fun k => ‖F k x‖))
    (hT : ∀ x : E, ‖T x‖ ≤ ⨆ k, ‖F k x‖) :
    ∃ (s : Finset ι) (C : NNReal), ∀ x : E, ‖T x‖ ≤ C * (s.sup p) x := by
  obtain ⟨s, C, hbound⟩ := exists_seminorm_bound_of_bddAbove hp F H
  refine ⟨s, C, fun x => ?_⟩
  refine le_trans (hT x) ?_
  exact ciSup_le fun k => hbound k x

end Barrelled

end GaloisForLFunctions.HTGeometry
