import GaloisForLFunctions.HTGeometry.ReesGrading
import GaloisForLFunctions.HTGeometry.HomogenizedMonoidBlowupChart
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic

/-!
# A single native Proj chart for the homogenized monoid source

For the vertex ideal `I` of `R + T*R[M][T]`, its Rees irrelevant ideal is generated by the
marked degree-one elements. Their quadratic relations force every projective prime into
`D_+(T*U)`. Thus the full native Proj scheme is isomorphic to the spectrum of its homogeneous
localization at `T*U`. No finite generation of `I` is assumed.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
variable (R M : Type*) [CommRing R] [AddCommMonoid M]

/-- The natural grading on the source vertex Rees algebra. -/
abbrev reesGrade := ReesGrading.grade (vertexIdeal R M)
/-- The ideal of the Rees algebra generated by the marked degree-one elements. -/
def degreeOneIdeal : Ideal (reesAlgebra (vertexIdeal R M)) :=
  Ideal.span (Set.range (reesGenerator R M))

/-- Every degree-one Rees monomial lies in the marked generator ideal. -/
theorem mono_one_mem_degreeOneIdeal {a : Q R M} (ha : a ∈ vertexIdeal R M) :
    ReesGrading.mono (vertexIdeal R M) 1 a (by simpa using ha) ∈ degreeOneIdeal R M := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    rcases ha with ⟨b,rfl⟩
    exact Ideal.subset_span ⟨b,rfl⟩
  | zero =>
    convert (degreeOneIdeal R M).zero_mem using 1
    apply Subtype.ext
    simp [ReesGrading.mono]
  | add a b ha hb ia ib =>
    convert (degreeOneIdeal R M).add_mem ia ib using 1
    apply Subtype.ext
    simp [ReesGrading.mono]
  | smul c a ha ih =>
    have haI : a ∈ vertexIdeal R M := ha
    have he : ReesGrading.mono (vertexIdeal R M) 1 (c*a) (by simpa using ((vertexIdeal R M).mul_mem_left c haI)) =
      algebraMap (Q R M) (reesAlgebra (vertexIdeal R M)) c *
        ReesGrading.mono (vertexIdeal R M) 1 a (by rw [Submodule.pow_one]; exact haI) := by
      apply Subtype.ext
      change Polynomial.monomial 1 (c*a) = Polynomial.C c * Polynomial.monomial 1 a
      exact Polynomial.C_mul_monomial.symm
    change ReesGrading.mono (vertexIdeal R M) 1 (c*a) _ ∈ _
    rw [he]
    exact (degreeOneIdeal R M).mul_mem_left _ ih

/-- Every Rees monomial of nonzero degree lies in the marked generator ideal. -/
theorem mono_succ_mem_degreeOneIdeal (n : ℕ) {a : Q R M}
    (ha : a ∈ (vertexIdeal R M)^(n+1)) :
    ReesGrading.mono (vertexIdeal R M) (n+1) a ha ∈ degreeOneIdeal R M := by
  have hh := ha
  rw [vertexIdeal_pow,Ideal.span_singleton_pow,Ideal.mem_span_singleton_mul] at hh
  obtain ⟨b,hb,rfl⟩ := hh
  have he : ReesGrading.mono (vertexIdeal R M) (n+1) (qVar R M 0 ^n*b) ha =
      reesGenerator R M 0 ^n *
        ReesGrading.mono (vertexIdeal R M) 1 b (by simpa using hb) := by
    apply Subtype.ext
    change Polynomial.monomial (n+1) (qVar R M 0 ^n*b) =
      (Polynomial.monomial 1 (qVar R M 0))^n * Polynomial.monomial 1 b
    simp [Polynomial.monomial_pow,Polynomial.monomial_mul_monomial]
  rw [he]
  exact (degreeOneIdeal R M).mul_mem_left _ (mono_one_mem_degreeOneIdeal R M hb)

/-- The marked generator ideal is exactly the native irrelevant ideal. -/
theorem irrelevant_eq_degreeOneIdeal :
    (HomogeneousIdeal.irrelevant (reesGrade R M)).toIdeal = degreeOneIdeal R M := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le (reesGrade R M)).2
    intro n hn f hf
    obtain ⟨k,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_zero_of_lt hn)
    have he : f = ReesGrading.mono (vertexIdeal R M) (k+1)
        ((f : Polynomial (Q R M)).coeff (k+1)) (f.2 (k+1)) :=
      Subtype.ext hf
    rw [he]
    exact mono_succ_mem_degreeOneIdeal R M k _
  · apply Ideal.span_le.2
    rintro _ ⟨a,rfl⟩
    apply HomogeneousIdeal.mem_irrelevant_of_mem (reesGrade R M) Nat.zero_lt_one
    exact ReesGrading.mono_mem_grade (vertexIdeal R M) 1 (qVar R M a)
      (by simpa using qVar_mem_vertexIdeal R M a)

/-- The single homogenizer basic open covers the full native Proj scheme. -/
theorem homogenizer_basicOpen_eq_top :
    AlgebraicGeometry.Proj.basicOpen (reesGrade R M) (reesGenerator R M 0) = ⊤ := by
  apply top_le_iff.mp
  intro x hx
  apply rees_prime_cover R M x.asHomogeneousIdeal.toIdeal
  intro h
  apply x.not_irrelevant_le
  change (HomogeneousIdeal.irrelevant (reesGrade R M)).toIdeal ≤ x.asHomogeneousIdeal.toIdeal
  rw [irrelevant_eq_degreeOneIdeal]
  exact h


open CategoryTheory

/-- The full native Proj scheme is its homogenizer homogeneous-localization chart. -/
def projIsoHomogeneousChart :
    AlgebraicGeometry.Proj (reesGrade R M) ≅ AlgebraicGeometry.Spec
      (.of (HomogeneousLocalization.Away (reesGrade R M) (reesGenerator R M 0))) :=
  (AlgebraicGeometry.Scheme.topIso _).symm ≪≫
    (AlgebraicGeometry.Scheme.isoOfEq _ (homogenizer_basicOpen_eq_top R M)).symm ≪≫
      AlgebraicGeometry.Proj.basicOpenIsoSpec (reesGrade R M) (reesGenerator R M 0)
        (ReesGrading.mono_mem_grade (vertexIdeal R M) 1 (qVar R M 0)
          (by simpa using qVar_mem_vertexIdeal R M 0)) Nat.zero_lt_one

end GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
