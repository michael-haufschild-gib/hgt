import GaloisForLFunctions.HTGeometry.DifferentialOperatorOreDiagonal
import GaloisForLFunctions.HTGeometry.DifferentialOperatorCyclicDimension

/-!
# The row lattice of a matrix and its elementary divisors

The left combinations of the rows of a matrix over `K[∂;δ]` form a `K`-subspace of the free module,
and the codimension of that subspace is a finite number attached to the matrix.

Elementary row operations do not change the row lattice, and an elementary column operation
transports it by an automorphism of the ambient module, so the codimension is invariant under the
reduction to diagonal form.  On a diagonal matrix with left independent rows the row lattice is the
product of the cyclic left ideals generated by the diagonal entries, whose codimension is the sum
of their orders.  The codimension of the row lattice is therefore the sum of the orders of the
elementary divisors.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K]
variable {ι κ : Type*} [Fintype ι]

/-- The row map of a matrix, as a map of coefficient spaces over the constants. -/
def vecMulLin (P : ι → κ → DiffOp K) : (ι → DiffOp K) →ₗ[K] (κ → DiffOp K) where
  toFun v := vecMul v P
  map_add' v w := by
    funext j
    show ∑ i, (v i + w i) * P i j = (∑ i, v i * P i j) + ∑ i, w i * P i j
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => add_mul' (v i) (w i) (P i j)
  map_smul' a v := by
    funext j
    show ∑ i, (a • v i) * P i j = a • ∑ i, v i * P i j
    rw [Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ => smul_mul' a (v i) (P i j)

@[simp] theorem vecMulLin_apply (P : ι → κ → DiffOp K) (v : ι → DiffOp K) :
    vecMulLin P v = vecMul v P := rfl

/-- The row lattice: the space of left combinations of the rows. -/
def rowSpace (P : ι → κ → DiffOp K) : Submodule K (κ → DiffOp K) :=
  LinearMap.range (vecMulLin P)

theorem mem_rowSpace {P : ι → κ → DiffOp K} {w : κ → DiffOp K} :
    w ∈ rowSpace P ↔ ∃ v, vecMul v P = w := LinearMap.mem_range

section RowInvariance

variable [DecidableEq ι]

/-- A row operation does not change the row lattice. -/
theorem rowSpace_rowAdd {i₀ k : ι} (h : i₀ ≠ k) (q : DiffOp K) (P : ι → κ → DiffOp K) :
    rowSpace (rowAdd i₀ k q P) = rowSpace P := by
  refine le_antisymm ?_ ?_
  · intro w hw
    obtain ⟨v, rfl⟩ := mem_rowSpace.mp hw
    exact mem_rowSpace.mpr ⟨rowAddVec i₀ k q v, (vecMul_rowAdd i₀ k q P v).symm⟩
  · intro w hw
    obtain ⟨v, rfl⟩ := mem_rowSpace.mp hw
    refine mem_rowSpace.mpr ⟨rowAddVec i₀ k (-q) v, ?_⟩
    rw [vecMul_rowAdd]
    have hcancel := rowAddVec_cancel h (-q) v
    rw [neg_neg] at hcancel
    rw [hcancel]

/-- Every row of a matrix with left independent rows carries a nonzero entry. -/
theorem exists_ne_zero_of_rowIndep {P : ι → κ → DiffOp K} (hindep : RowIndep P) (i : ι) :
    ∃ j, P i j ≠ 0 := by
  by_contra hall
  have hzero : ∀ j, P i j = 0 := by
    intro j
    by_contra hz
    exact hall ⟨j, hz⟩
  have hv : vecMul (fun a => if a = i then (1 : DiffOp K) else 0) P = 0 := by
    funext j
    refine Finset.sum_eq_zero fun a _ => ?_
    by_cases ha : a = i
    · subst ha
      show (if a = a then (1 : DiffOp K) else 0) * P a j = 0
      rw [if_pos rfl, one_mul, hzero j]
    · show (if a = i then (1 : DiffOp K) else 0) * P a j = 0
      rw [if_neg ha, zero_mul]
  have h0 := hindep _ hv
  have h1 : (if i = i then (1 : DiffOp K) else 0) = 0 := congrFun h0 i
  rw [if_pos rfl] at h1
  exact one_ne_zero h1

end RowInvariance

section ColumnInvariance

variable [DecidableEq κ]

/-- The transport of a coefficient vector under a column operation, as a linear map. -/
def colAddVecLin (j₀ k : κ) (q : DiffOp K) : (κ → DiffOp K) →ₗ[K] (κ → DiffOp K) where
  toFun w := colAddVec j₀ k q w
  map_add' w₁ w₂ := by
    funext j
    by_cases hj : j = j₀
    · subst hj
      show colAddVec j k q (w₁ + w₂) j = colAddVec j k q w₁ j + colAddVec j k q w₂ j
      rw [colAddVec_apply_self, colAddVec_apply_self, colAddVec_apply_self]
      show w₁ j + w₂ j + (w₁ k + w₂ k) * q = w₁ j + w₁ k * q + (w₂ j + w₂ k * q)
      rw [add_mul']
      abel
    · show colAddVec j₀ k q (w₁ + w₂) j = colAddVec j₀ k q w₁ j + colAddVec j₀ k q w₂ j
      rw [colAddVec_apply_of_ne _ _ _ _ hj, colAddVec_apply_of_ne _ _ _ _ hj,
        colAddVec_apply_of_ne _ _ _ _ hj]
      rfl
  map_smul' a w := by
    funext j
    by_cases hj : j = j₀
    · subst hj
      show colAddVec j k q (a • w) j = a • colAddVec j k q w j
      rw [colAddVec_apply_self, colAddVec_apply_self]
      show a • w j + (a • w k) * q = a • (w j + w k * q)
      rw [smul_add, smul_mul']
    · show colAddVec j₀ k q (a • w) j = a • colAddVec j₀ k q w j
      rw [colAddVec_apply_of_ne _ _ _ _ hj, colAddVec_apply_of_ne _ _ _ _ hj]
      rfl

@[simp] theorem colAddVecLin_apply (j₀ k : κ) (q : DiffOp K) (w : κ → DiffOp K) :
    colAddVecLin j₀ k q w = colAddVec j₀ k q w := rfl

/-- A column operation acts on coefficient vectors by an automorphism. -/
def colAddVecEquiv {j₀ k : κ} (h : j₀ ≠ k) (q : DiffOp K) :
    (κ → DiffOp K) ≃ₗ[K] (κ → DiffOp K) :=
  LinearEquiv.ofLinear (colAddVecLin j₀ k q) (colAddVecLin j₀ k (-q))
    (by
      refine LinearMap.ext fun w => ?_
      show colAddVec j₀ k q (colAddVec j₀ k (-q) w) = w
      have hcancel := colAddVec_cancel h (-q) w
      rwa [neg_neg] at hcancel)
    (by
      refine LinearMap.ext fun w => ?_
      show colAddVec j₀ k (-q) (colAddVec j₀ k q w) = w
      exact colAddVec_cancel h q w)

@[simp] theorem colAddVecEquiv_apply {j₀ k : κ} (h : j₀ ≠ k) (q : DiffOp K) (w : κ → DiffOp K) :
    colAddVecEquiv h q w = colAddVec j₀ k q w := rfl

/-- A column operation transports the row lattice by that automorphism. -/
theorem rowSpace_colAdd {j₀ k : κ} (h : j₀ ≠ k) (q : DiffOp K) (P : ι → κ → DiffOp K) :
    rowSpace (colAdd j₀ k q P)
      = Submodule.map (colAddVecEquiv (K := K) h q : (κ → DiffOp K) →ₗ[K] (κ → DiffOp K))
          (rowSpace P) := by
  refine le_antisymm ?_ ?_
  · intro w hw
    obtain ⟨v, rfl⟩ := mem_rowSpace.mp hw
    exact ⟨vecMul v P, mem_rowSpace.mpr ⟨v, rfl⟩, (vecMul_colAdd j₀ k q P v).symm⟩
  · rintro w ⟨w', hw', rfl⟩
    obtain ⟨v, rfl⟩ := mem_rowSpace.mp hw'
    exact mem_rowSpace.mpr ⟨v, vecMul_colAdd j₀ k q P v⟩

end ColumnInvariance

section Invariance

variable [DecidableEq ι] [DecidableEq κ]

/-- **The codimension of the row lattice is an invariant of the reduction.** -/
theorem finrank_quotient_rowSpace_congr {P Q : ι → κ → DiffOp K} (h : RowColEquiv P Q) :
    Module.finrank K ((κ → DiffOp K) ⧸ rowSpace Q)
      = Module.finrank K ((κ → DiffOp K) ⧸ rowSpace P) := by
  induction h with
  | refl => rfl
  | tail _ hstep ih =>
    refine Eq.trans ?_ ih
    rcases hstep with ⟨i₀, k, q, hne, rfl⟩ | ⟨j₀, k, q, hne, rfl⟩
    · rw [rowSpace_rowAdd hne]
    · exact (Submodule.Quotient.equiv _ _ (colAddVecEquiv hne q)
        (rowSpace_colAdd hne q _).symm).finrank_eq.symm

end Invariance

section Diagonal

/-- Reindexing the coefficient space along a bijection of index sets. -/
def coordEquiv (e : ι ≃ κ) : (κ → DiffOp K) ≃ₗ[K] (ι → DiffOp K) where
  toFun w := fun i => w (e i)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun u := fun j => u (e.symm j)
  left_inv w := by
    funext j
    show w (e (e.symm j)) = w j
    rw [Equiv.apply_symm_apply]
  right_inv u := by
    funext i
    show u (e.symm (e i)) = u i
    rw [Equiv.symm_apply_apply]

/-- On a diagonal matrix only the diagonal entry contributes to a row combination. -/
theorem vecMul_of_diagonalized {P : ι → κ → DiffOp K} (hdiag : Diagonalized P) {i : ι} {j : κ}
    (hij : P i j ≠ 0) (v : ι → DiffOp K) : vecMul v P j = v i * P i j := by
  show ∑ a, v a * P a j = v i * P i j
  refine Finset.sum_eq_single i (fun a _ ha => ?_) (fun hcon => absurd (Finset.mem_univ i) hcon)
  rw [(hdiag i j hij).1 a ha, mul_zero]

/-- **The row lattice of a diagonal matrix** is the product of the cyclic left ideals generated by
the diagonal entries. -/
theorem map_rowSpace_coordEquiv {P : ι → κ → DiffOp K} (hdiag : Diagonalized P) (e : ι ≃ κ)
    (he : ∀ i, P i (e i) ≠ 0) :
    Submodule.map (coordEquiv (K := K) e : (κ → DiffOp K) →ₗ[K] (ι → DiffOp K)) (rowSpace P)
      = Submodule.pi Set.univ fun i => leftMultiples (P i (e i)) := by
  refine le_antisymm ?_ ?_
  · rintro u ⟨w, hw, rfl⟩
    obtain ⟨v, rfl⟩ := mem_rowSpace.mp hw
    refine Submodule.mem_pi.mpr fun i _ => ?_
    refine mem_leftMultiples.mpr ⟨v i, ?_⟩
    show vecMul v P (e i) = v i * P i (e i)
    exact vecMul_of_diagonalized hdiag (he i) v
  · intro u hu
    have hq : ∀ i, ∃ q, u i = q * P i (e i) := fun i =>
      mem_leftMultiples.mp (Submodule.mem_pi.mp hu i (Set.mem_univ i))
    choose q hq using hq
    refine ⟨vecMul q P, mem_rowSpace.mpr ⟨q, rfl⟩, ?_⟩
    funext i
    show vecMul q P (e i) = u i
    rw [vecMul_of_diagonalized hdiag (he i) q, ← hq i]

/-- The codimension of the row lattice of a diagonalized matrix is the sum of the orders of its
pivots. -/
theorem finrank_quotient_rowSpace_of_diagonalized {P : ι → κ → DiffOp K} (hdiag : Diagonalized P)
    (e : ι ≃ κ) (he : ∀ i, P i (e i) ≠ 0) [DecidableEq ι] :
    Module.finrank K ((κ → DiffOp K) ⧸ rowSpace P) = ∑ i, degree (P i (e i)) := by
  rw [(Submodule.Quotient.equiv (rowSpace P) _ (coordEquiv e)
      (map_rowSpace_coordEquiv hdiag e he)).finrank_eq,
    finrank_quotient_pi_leftMultiples _ he]

variable [DecidableEq ι] [DecidableEq κ]

/-- **Elementary divisors.**  For a square matrix with left independent rows the row lattice has
finite codimension, equal to the sum of the orders of the diagonal entries of any diagonal form. -/
theorem exists_degree_sum_eq_finrank_quotient_rowSpace [Fintype κ] (P : ι → κ → DiffOp K)
    (hindep : RowIndep P) (hcard : Fintype.card ι = Fintype.card κ) :
    ∃ d : ι → DiffOp K, (∀ i, d i ≠ 0) ∧
      Module.finrank K ((κ → DiffOp K) ⧸ rowSpace P) = ∑ i, degree (d i) := by
  classical
  obtain ⟨P', hequiv, hdiag⟩ := exists_diagonalized P
  have hindep' : RowIndep P' := hequiv.rowIndep hindep
  choose f hf using fun i => exists_ne_zero_of_rowIndep hindep' i
  have hinj : Function.Injective f := by
    intro a b hab
    by_contra hne
    have h0 : P' b (f a) = 0 := (hdiag a (f a) (hf a)).1 b (Ne.symm hne)
    rw [hab] at h0
    exact hf b h0
  have hbij : Function.Bijective f := (Fintype.bijective_iff_injective_and_card f).mpr ⟨hinj, hcard⟩
  set e : ι ≃ κ := Equiv.ofBijective f hbij with hedef
  have he : ∀ i, P' i (e i) ≠ 0 := fun i => hf i
  refine ⟨fun i => P' i (e i), he, ?_⟩
  rw [← finrank_quotient_rowSpace_congr hequiv,
    (Submodule.Quotient.equiv (rowSpace P') _ (coordEquiv e)
      (map_rowSpace_coordEquiv hdiag e he)).finrank_eq,
    finrank_quotient_pi_leftMultiples (fun i => P' i (e i)) he]

end Diagonal

end

end DiffOp

