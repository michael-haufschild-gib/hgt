/-- The full determinant has a fixed positive reserve on the tightened compact chart. -/
theorem modularThetaCompactD1_lower_on_tight_box {S A W : ℝ}
    (hS0 : -1 ≤ S) (hS1 : S ≤ 0) (hA0 : 17 ≤ A) (hA1 : A ≤ 20)
    (hW0 : 0 ≤ W) (hW1 : W ≤ 1) :
    (1000000000 : ℝ) ≤ modularThetaCompactD1 S A W := by
  let u := -S
  let t := A-17
  have hu0 : 0 ≤ u := by dsimp [u]; linarith
  have hu1 : u ≤ 1 := by dsimp [u]; linarith
  have ht0 : 0 ≤ t := by dsimp [t]; linarith
  have ht1 : t ≤ 3 := by dsimp [t]; linarith
  have heq : modularThetaCompactD1 S A W = modularThetaCompactD1 (-u) (17+t) W := by
    congr 1 <;> dsimp [u,t] <;> ring
  rw [heq, compactD1_shift]
  have h0 := reserveCoefficient0_lower hu0 hu1 hW0 hW1
  have h1 := reserveCoefficient1_lower hu0 hu1 hW0 hW1
  have hp1 := mul_nonneg h1 (pow_nonneg ht0 1)
  have h2 := reserveCoefficient2_lower hu0 hu1 hW0 hW1
  have hp2 := mul_nonneg h2 (pow_nonneg ht0 2)
  have h3 := reserveCoefficient3_lower hu0 hu1 hW0 hW1
  have h4 := reserveCoefficient4_lower hu0 hu1 hW0 hW1
  have h5 := reserveCoefficient5_lower hu0 hu1 hW0 hW1
  have hp5 := mul_nonneg h5 (pow_nonneg ht0 5)
  have h6 := reserveCoefficient6_lower hu0 hu1 hW0 hW1
  have hp6 := mul_nonneg h6 (pow_nonneg ht0 6)
  have h7 := reserveCoefficient7_lower hu0 hu1 hW0 hW1
  have hp7 := mul_nonneg h7 (pow_nonneg ht0 7)
  have h8 := reserveCoefficient8_lower hu0 hu1 hW0 hW1
  have hp8 := mul_nonneg h8 (pow_nonneg ht0 8)
  have h9 := reserveCoefficient9_lower hu0 hu1 hW0 hW1
  have hp9 := mul_nonneg h9 (pow_nonneg ht0 9)
  have h10 := reserveCoefficient10_lower hu0 hu1 hW0 hW1
  have hp10 := mul_nonneg h10 (pow_nonneg ht0 10)
  have h11 := reserveCoefficient11_lower hu0 hu1 hW0 hW1
  have hp11 := mul_nonneg h11 (pow_nonneg ht0 11)
  have h12 := reserveCoefficient12_lower hu0 hu1 hW0 hW1
  have hp12 := mul_nonneg h12 (pow_nonneg ht0 12)
  have h3p := mul_le_mul_of_nonneg_right h3 (pow_nonneg ht0 3)
  have h4p := mul_le_mul_of_nonneg_right h4 (pow_nonneg ht0 4)
  have ht4 : t^4 ≤ 3*t^3 := by
    have h := mul_le_mul_of_nonneg_right ht1 (pow_nonneg ht0 3)
    nlinarith only [h]
  have h34 : 0 ≤ reserveCoefficient3 u W * t^3 + reserveCoefficient4 u W * t^4 := by
    nlinarith [pow_nonneg ht0 3]
  norm_num only [pow_zero, mul_one]
  linarith only [h0,hp1,hp2,h34,hp5,hp6,hp7,hp8,hp9,hp10,hp11,hp12]

end
