import GaloisForLFunctions.HTGeometry.PolynomialODEJetRankThreeCompactExpansion

/-!
# A strict polynomial reserve on the compact theta chart

After shifting the gap variable by seventeen, each coefficient is a sum of
nonnegative monomials and nonnegative unit-square monomial complements.
One fourth-degree loss is absorbed by the cubic coefficient on a gap window
of width three. All identities are proved in the real polynomial ring.
-/

namespace HTGeometry
noncomputable section
set_option maxHeartbeats 16000000
set_option maxRecDepth 100000

private theorem unit_monomial_slack_nonneg {u w : ℝ}
    (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (hw0 : 0 ≤ w) (hw1 : w ≤ 1)
    (i j : ℕ) : 0 ≤ 1 - u ^ i * w ^ j := by
  have hu := pow_le_one₀ hu0 hu1 (n := i)
  have hw := pow_le_one₀ hw0 hw1 (n := j)
  have h := mul_le_mul hu hw (pow_nonneg hw0 j) (by norm_num : (0 : ℝ) ≤ 1)
  norm_num only [one_mul] at h
  linarith

