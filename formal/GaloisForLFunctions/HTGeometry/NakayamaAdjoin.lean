import Mathlib.RingTheory.LocalRing.Etale

/-!
# Generating a finite algebra over a local ring from its residues

If `B` is a finite algebra over a local ring `S` and every element of `B` agrees with a polynomial in
`β` modulo `𝔪·B`, then `β` generates `B` outright.  This is Nakayama's lemma applied to the quotient
of `B` by the subalgebra generated by `β`; the hypothesis is stated element-wise so that no quotient
algebra structure has to be carried around.

This is the descent step for local monogenicity: the residue algebra `B/𝔪B` is Artinian, and once a
generator has been produced there, the same element generates `B`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsLocalRing

/-- **Residual generation implies generation.** -/
theorem adjoin_eq_top_of_sub_aeval_mem_map_maximalIdeal
    {S B : Type*} [CommRing S] [IsLocalRing S] [CommRing B] [Algebra S B] [Module.Finite S B]
    (β : B)
    (h : ∀ b : B, ∃ q : Polynomial S,
      b - Polynomial.aeval β q ∈ (maximalIdeal S).map (algebraMap S B)) :
    Algebra.adjoin S ({β} : Set B) = ⊤ := by
  refine eq_top_iff.mpr <| Submodule.le_of_le_smul_of_le_jacobson_bot
    (Module.finite_def.mp inferInstance) (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    (?_ : ⊤ ≤ (Algebra.adjoin S ({β} : Set B)).toSubmodule ⊔ maximalIdeal S • ⊤)
  intro b _
  obtain ⟨q, hq⟩ := h b
  rw [Ideal.smul_top_eq_map]
  refine Submodule.mem_sup.mpr ⟨Polynomial.aeval β q, ?_, b - Polynomial.aeval β q, ?_, by ring⟩
  · rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact ⟨q, rfl⟩
  · exact hq

end GaloisForLFunctions.HTGeometry
