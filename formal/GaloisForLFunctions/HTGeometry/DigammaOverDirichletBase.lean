import GaloisForLFunctions.HTGeometry.DirichletRealizationLead
import GaloisForLFunctions.HTGeometry.JetTowerFreeness
import Mathlib

/-!
# The digamma over the field generated by all convergent Dirichlet series

The field generated over `C` by the Dirichlet variable and every finite-abscissa Dirichlet germ is
the field of fractions of the realized Dirichlet polynomials.  It is stable under translation by
`I`, its translation invariants are the constants, and it has no nonzero rational shift defect —
the last two by the leading-term theory of Dirichlet series, with the pole obstruction supplying
the contradiction.

Feeding these into the jet-tower descent, together with the rotated digamma difference equation,
makes the digamma jets algebraically independent over that field: `psi` is hypertranscendental over
`C(s)` with *every* convergent Dirichlet series adjoined, in particular over `C(s)<zeta>`.
-/

open Polynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance dirZetaDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance dirZetaDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance dirZetaComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-- The image of the realization, as a `C`-subalgebra. -/
def dirRealizeRange : Subalgebra ℂ upperEndMeroField where
  carrier := Set.range dirRealize
  mul_mem' := by
    rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
    exact ⟨P * Q, map_mul _ _ _⟩
  one_mem' := ⟨1, map_one _⟩
  add_mem' := by
    rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
    exact ⟨P + Q, map_add _ _ _⟩
  zero_mem' := ⟨0, map_zero _⟩
  algebraMap_mem' := fun a => ⟨faEmb (Polynomial.C a), by
    rw [dirRealize_faEmb, Polynomial.aeval_C]⟩

/-- The base field: the constants with the Dirichlet variable and every convergent Dirichlet germ
adjoined. -/
def dirZetaBase : IntermediateField ℂ upperEndMeroField :=
  IntermediateField.adjoin ℂ
    ({dirCoordMero} ∪ Set.range finiteAbscissaLSeriesToUpperEndMero)

theorem dirCoordMero_mem_dirZetaBase : dirCoordMero ∈ dirZetaBase :=
  IntermediateField.subset_adjoin _ _ (Or.inl (Set.mem_singleton _))

theorem lseries_mem_dirZetaBase (f : finiteAbscissaArithmeticSubalgebra) :
    finiteAbscissaLSeriesToUpperEndMero f ∈ dirZetaBase :=
  IntermediateField.subset_adjoin _ _ (Or.inr ⟨f, rfl⟩)

theorem adjoin_le_dirRealizeRange :
    Algebra.adjoin ℂ ({dirCoordMero} ∪ Set.range finiteAbscissaLSeriesToUpperEndMero)
      ≤ dirRealizeRange := by
  refine Algebra.adjoin_le ?_
  rintro x (hx | ⟨f, rfl⟩)
  · rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨X, dirRealize_X⟩
  · exact ⟨Polynomial.C f, dirRealize_C f⟩

theorem dirRealize_ne_zero {Q : FAPoly} (hQ : Q ≠ 0) : dirRealize Q ≠ 0 := by
  intro h
  exact hQ (dirRealize_eq_zero Q h)

theorem faSigmaPoly_ne_zero {Q : FAPoly} (hQ : Q ≠ 0) : faSigmaPoly Q ≠ 0 := by
  intro h
  refine hQ (faToDirPoly_injective ?_)
  have hd : _root_.HTGeometry.DirPoly.sigmaDirPoly (faToDirPoly Q) = 0 := by
    rw [← faToDirPoly_sigma, h, map_zero]
  have hz : faToDirPoly Q = 0 := by
    have hs := congrArg _root_.HTGeometry.DirPoly.sigmaDirPoly.symm hd
    rwa [_root_.HTGeometry.DirPoly.sigmaDirPoly.symm_apply_apply, map_zero] at hs
  rw [hz, map_zero]

/-- **Every element of the base is a ratio of realized Dirichlet polynomials.** -/
theorem exists_dirRealize_ratio {u : upperEndMeroField} (hu : u ∈ dirZetaBase) :
    ∃ P Q : FAPoly, Q ≠ 0 ∧ u = dirRealize P / dirRealize Q := by
  obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hu
  obtain ⟨P, rfl⟩ := adjoin_le_dirRealizeRange hr
  obtain ⟨Q, rfl⟩ := adjoin_le_dirRealizeRange hs
  rcases eq_or_ne Q 0 with rfl | hQ
  · exact ⟨0, 1, one_ne_zero, by simp⟩
  · exact ⟨P, Q, hQ, rfl⟩

/-! ## Stability -/

theorem dirZetaBase_map_mem (phi : upperEndMeroField ≃+* upperEndMeroField)
    (hphiC : ∀ a : ℂ, phi (algebraMap ℂ upperEndMeroField a) = algebraMap ℂ upperEndMeroField a)
    (hphix : phi dirCoordMero ∈ dirZetaBase)
    (hphiL : ∀ f : finiteAbscissaArithmeticSubalgebra,
      phi (finiteAbscissaLSeriesToUpperEndMero f) ∈ dirZetaBase) :
    ∀ t ∈ dirZetaBase, phi t ∈ dirZetaBase := by
  intro t ht
  refine IntermediateField.adjoin_induction (F := ℂ)
    (p := fun z _ => phi z ∈ dirZetaBase) ?_ ?_ ?_ ?_ ?_ ht
  · rintro z (hz | ⟨f, rfl⟩)
    · rw [Set.mem_singleton_iff] at hz
      subst hz
      exact hphix
    · exact hphiL f
  · intro a
    rw [hphiC a]
    exact dirZetaBase.algebraMap_mem a
  · intro p q _ _ hp hq
    rw [phi.map_add]; exact add_mem hp hq
  · intro p _ hp
    rw [map_inv₀ phi]; exact inv_mem hp
  · intro p q _ _ hp hq
    rw [phi.map_mul]; exact mul_mem hp hq

theorem upperEndTranslate_lseries (f : finiteAbscissaArithmeticSubalgebra) :
    upperEndTranslationMeroEquiv Complex.I (finiteAbscissaLSeriesToUpperEndMero f)
      = finiteAbscissaLSeriesToUpperEndMero (finiteAbscissaDirichletShift 1 f) := by
  have h := finiteAbscissaLSeriesToUpperEndMero_dirichletShift 1 f
  rw [mul_one] at h
  rw [h]

theorem upperEndTranslate_symm_dirCoordMero :
    (upperEndTranslationMeroEquiv Complex.I).symm dirCoordMero = dirCoordMero - 1 := by
  have h : (upperEndTranslationMeroEquiv Complex.I).symm
      (upperEndTranslationMeroEquiv Complex.I dirCoordMero) = dirCoordMero :=
    (upperEndTranslationMeroEquiv Complex.I).symm_apply_apply dirCoordMero
  rw [upperEndTranslate_dirCoordMero,
    (upperEndTranslationMeroEquiv Complex.I).symm.map_add,
    (upperEndTranslationMeroEquiv Complex.I).symm.map_one] at h
  linear_combination h

/-- **The base is stable under translation by `I`.** -/
theorem dirZetaBase_stable (u : upperEndMeroField) :
    upperEndTranslationMeroEquiv Complex.I u ∈ dirZetaBase ↔ u ∈ dirZetaBase := by
  have hbwdL : ∀ f : finiteAbscissaArithmeticSubalgebra,
      (upperEndTranslationMeroEquiv Complex.I).symm (finiteAbscissaLSeriesToUpperEndMero f)
        ∈ dirZetaBase := by
    intro f
    have hround : upperEndTranslationMeroEquiv Complex.I
        (finiteAbscissaLSeriesToUpperEndMero (finiteAbscissaDirichletShift (-1) f))
        = finiteAbscissaLSeriesToUpperEndMero f := by
      rw [upperEndTranslate_lseries, finiteAbscissaDirichletShift_comp]
      norm_num
      rw [finiteAbscissaDirichletShift_zero]
    rw [← hround, (upperEndTranslationMeroEquiv Complex.I).symm_apply_apply]
    exact lseries_mem_dirZetaBase _
  constructor
  · intro hu
    have hbwd := dirZetaBase_map_mem (upperEndTranslationMeroEquiv Complex.I).symm
      (fun a => (RingEquiv.symm_apply_eq _).mpr
        (upperEndTranslate_algebraMap_complex_gen Complex.I a).symm)
      (by rw [upperEndTranslate_symm_dirCoordMero]
          exact sub_mem dirCoordMero_mem_dirZetaBase (one_mem _))
      hbwdL
    have hthis := hbwd _ hu
    rwa [(upperEndTranslationMeroEquiv Complex.I).symm_apply_apply] at hthis
  · intro hu
    refine dirZetaBase_map_mem (upperEndTranslationMeroEquiv Complex.I)
      (upperEndTranslate_algebraMap_complex_gen Complex.I)
      (by rw [upperEndTranslate_dirCoordMero]
          exact add_mem dirCoordMero_mem_dirZetaBase (one_mem _))
      (fun f => by rw [upperEndTranslate_lseries]; exact lseries_mem_dirZetaBase _) u hu

/-! ## The two descent hypotheses -/

theorem dirRealize_sigma_div (P Q : FAPoly) :
    upperEndTranslationMeroEquiv Complex.I (dirRealize P / dirRealize Q)
      = dirRealize (faSigmaPoly P) / dirRealize (faSigmaPoly Q) := by
  rw [map_div₀, dirRealize_sigma, dirRealize_sigma]

/-- **The translation invariants of the base are the constants.** -/
theorem dirZetaBase_fixed_const (u : upperEndMeroField) (hu : u ∈ dirZetaBase)
    (hfix : upperEndTranslationMeroEquiv Complex.I u = u) :
    ∃ a : ℂ, u = algebraMap ℂ upperEndMeroField a := by
  classical
  obtain ⟨P, Q, hQ, rfl⟩ := exists_dirRealize_ratio hu
  rcases eq_or_ne P 0 with rfl | hP
  · exact ⟨0, by simp⟩
  have hRQ : dirRealize Q ≠ 0 := dirRealize_ne_zero hQ
  have hsQ : faSigmaPoly Q ≠ 0 := faSigmaPoly_ne_zero hQ
  have hRsQ : dirRealize (faSigmaPoly Q) ≠ 0 := dirRealize_ne_zero hsQ
  rw [dirRealize_sigma_div] at hfix
  have hcross : dirRealize (faSigmaPoly P * Q) = dirRealize (P * faSigmaPoly Q) := by
    rw [map_mul, map_mul]
    field_simp at hfix
    linear_combination hfix
  have hpoly : faSigmaPoly P * Q = P * faSigmaPoly Q := dirRealize_injective hcross
  have hP' : faToDirPoly P ≠ 0 := fun h => hP (faToDirPoly_injective (by rw [h, map_zero]))
  have hQ' : faToDirPoly Q ≠ 0 := fun h => hQ (faToDirPoly_injective (by rw [h, map_zero]))
  have hrel : _root_.HTGeometry.DirPoly.dirichletLeadPoly.sigma (faToDirPoly P) * faToDirPoly Q
      = faToDirPoly P * _root_.HTGeometry.DirPoly.dirichletLeadPoly.sigma (faToDirPoly Q) := by
    rw [dirichletLeadPoly_sigma, ← faToDirPoly_sigma, ← faToDirPoly_sigma, ← map_mul, ← map_mul,
      hpoly]
  obtain ⟨a, ha⟩ := _root_.HTGeometry.DirichletLead.eq_const_mul_of_sigma_fixed
    _root_.HTGeometry.DirPoly.dirichletLeadPoly hP' hQ' hrel
  have hPa : P = faEmb (Polynomial.C a) * Q := by
    refine faToDirPoly_injective ?_
    rw [map_mul, faToDirPoly_emb]
    rw [dirichletLeadPoly_emb] at ha
    exact ha
  refine ⟨a, ?_⟩
  rw [hPa, map_mul, dirRealize_faEmb, Polynomial.aeval_C]
  field_simp

/-- **No nonzero defect is a translation defect of the base.** -/
theorem dirZetaBase_defect_eq_zero (u : upperEndMeroField) (hu : u ∈ dirZetaBase)
    (v : upperEndMeroField)
    (hv : v ∈ _root_.HTGeometry.defectSpanAll rotDefectJetMero)
    (hduv : upperEndTranslationMeroEquiv Complex.I u - u = v) : v = 0 := by
  classical
  obtain ⟨m, q, hqdeg, hvq⟩ :=
    _root_.HTGeometry.defectSpan_shape rotDefectJetMero_mul_dirCoordMero_pow hv
  have hcm : dirCoordMero ^ m ≠ 0 :=
    pow_ne_zero _ (_root_.HTGeometry.coord_ne_zero transcendental_dirCoordMero)
  obtain ⟨P, Q, hQ, rfl⟩ := exists_dirRealize_ratio hu
  rcases eq_or_ne P 0 with rfl | hP
  · rw [map_zero, zero_div, map_zero, sub_zero] at hduv
    exact hduv.symm
  have hRQ : dirRealize Q ≠ 0 := dirRealize_ne_zero hQ
  have hsQ : faSigmaPoly Q ≠ 0 := faSigmaPoly_ne_zero hQ
  have hRsQ : dirRealize (faSigmaPoly Q) ≠ 0 := dirRealize_ne_zero hsQ
  rw [dirRealize_sigma_div] at hduv
  have hv2 : (dirRealize (faSigmaPoly P) * dirRealize Q
        - dirRealize P * dirRealize (faSigmaPoly Q)) * dirCoordMero ^ m
      = Polynomial.aeval dirCoordMero q
        * (dirRealize (faSigmaPoly Q) * dirRealize Q) := by
    have hvv : v = (dirRealize (faSigmaPoly P) * dirRealize Q
        - dirRealize P * dirRealize (faSigmaPoly Q))
        / (dirRealize (faSigmaPoly Q) * dirRealize Q) := by
      rw [← hduv]; field_simp
    rw [hvv] at hvq
    field_simp at hvq
    linear_combination hvq
  have hkey : dirRealize (faEmb (Polynomial.X ^ m)
        * (faSigmaPoly P * Q - P * faSigmaPoly Q))
      = dirRealize (faEmb q * (faSigmaPoly Q * Q)) := by
    simp only [map_mul, map_sub]
    rw [dirRealize_faEmb, dirRealize_faEmb, map_pow, Polynomial.aeval_X]
    linear_combination hv2
  have hpoly : faEmb (Polynomial.X ^ m) * (faSigmaPoly P * Q - P * faSigmaPoly Q)
      = faEmb q * (faSigmaPoly Q * Q) := dirRealize_injective hkey
  have hP' : faToDirPoly P ≠ 0 := fun h => hP (faToDirPoly_injective (by rw [h, map_zero]))
  have hQ' : faToDirPoly Q ≠ 0 := fun h => hQ (faToDirPoly_injective (by rw [h, map_zero]))
  have hq0 : q = 0 := by
    by_contra hqne
    refine _root_.HTGeometry.DirichletLead.no_pole_defect
      _root_.HTGeometry.DirPoly.dirichletLeadPoly hP' hQ' hqne hqdeg ?_
    have himg := congrArg faToDirPoly hpoly
    simp only [map_mul, map_sub, faToDirPoly_emb, faToDirPoly_sigma] at himg
    simp only [dirichletLeadPoly_sigma, dirichletLeadPoly_emb]
    exact himg
  rw [hq0, map_zero] at hvq
  exact (mul_eq_zero.mp hvq).resolve_right hcm

/-! ## The digamma over the Dirichlet base -/

theorem rotDefectJetMero_mem_dirZetaBase (n : ℕ) : rotDefectJetMero n ∈ dirZetaBase := by
  have hmem := _root_.HTGeometry.defect_mem_coordBase transcendental_dirCoordMero
    rotDefectJetMero_mul_dirCoordMero_pow n
  have hle : _root_.HTGeometry.coordBase dirCoordMero ≤ dirZetaBase := by
    rw [_root_.HTGeometry.coordBase]
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact dirCoordMero_mem_dirZetaBase
  exact hle hmem

/-- **The digamma jets are free over every convergent Dirichlet series.**  Each rotated digamma
jet is transcendental over the field generated by `C(s)`, all finite-abscissa Dirichlet germs, and
the preceding jets. -/
theorem rot_digamma_jets_transcendental_over_dirichlet (n : ℕ) :
    Transcendental
      (_root_.HTGeometry.jetTower dirZetaBase rotDigammaJetMero n) (rotDigammaJetMero n) :=
  _root_.HTGeometry.jetTower_transcendental dirTranslationAlgEquiv dirZetaBase
    rotDigammaJetMero rotDefectJetMero
    dirZetaBase_stable rotDefectJetMero_mem_dirZetaBase
    upperEndTranslate_rotDigammaJetMero
    dirZetaBase_fixed_const dirZetaBase_defect_eq_zero
    (_root_.HTGeometry.defect_not_mem_span transcendental_dirCoordMero rotDefectConst_ne_zero
      rotDefectJetMero_mul_dirCoordMero_pow) n

theorem algebraicIndependent_rotDigammaJetMero :
    AlgebraicIndependent (dirZetaBase : Type _) rotDigammaJetMero :=
  _root_.HTGeometry.algebraicIndependent_of_jetTower_transcendental dirZetaBase
    rotDigammaJetMero rot_digamma_jets_transcendental_over_dirichlet

/-- **The digamma is hypertranscendental over the Dirichlet base.**  In particular it satisfies no
algebraic differential equation whose coefficients involve `zeta` and its derivatives. -/
theorem rotDigamma_hypertranscendentalOver_dirZetaBase :
    GaloisForLFunctions.HypertranscendentalOver (dirZetaBase : Type _) rotDigammaMero := by
  rw [GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton]
  have hinj : Function.Injective (fun p : Unit × ℕ => p.2) := by
    rintro ⟨u1, m⟩ ⟨u2, n⟩ h
    simp only at h
    subst h
    rfl
  exact algebraicIndependent_rotDigammaJetMero.comp (fun p : Unit × ℕ => p.2) hinj

end

end GaloisForLFunctions.HTGeometry
