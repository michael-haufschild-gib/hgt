import GaloisForLFunctions.HTGeometry.PrimeProfileSeparatedPacketExact
import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Intrinsic prime-clock completion correspondence

This module removes the pivot hypothesis from the exact prime-profile theorem.  The key is to
choose a complex Hamel basis of the complete old clock submodule, represent every basis vector by
a positive-prime-power arithmetic source, and apply the static tail matroid to that entire basis.
The resulting basis field is already differential because the submodule is clock-stable.

Consequently relative differential independence over an arbitrary generated old field is exactly
linear independence of all new clock jets in the quotient by the old clock submodule.  Singleton
failure is precisely polynomial saturation, giving the intrinsic pullback of differential-
algebraic closure.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

set_option maxHeartbeats 800000

/-- The ordinary complex span of the order-zero clock classes of a source family. -/
def primeProfileStaticSubmodule
    {I : Type*} (c : I -> ArithmeticFunction ℂ) :
    Submodule ℂ PrimeProfileClockQuotient :=
  Submodule.span ℂ (Set.range (fun i => primeProfileClockClass (c i)))

/-- The plain field generated by a source family over the intrinsic finite-prime field. -/
def primeProfileStaticField
    {I : Type*} (c : I -> ArithmeticFunction ℂ) :
    IntermediateField finitePrimeCoefficientField arithmeticFunctionFractionField :=
  IntermediateField.adjoin finitePrimeCoefficientField
    (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
      arithmeticFunctionFractionField (c i)))

/-- Static source-span membership gives membership in the plain generated field.  No clock
freeness is needed: this is the order-zero field-recovery half of the tail matroid. -/
theorem carrier_mem_primeProfileStaticField_of_clockClass_mem
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f)
    (hmem : primeProfileClockClass f ∈ primeProfileStaticSubmodule c) :
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f ∈
      primeProfileStaticField c := by
  classical
  change primeProfileClockClass f ∈
    Submodule.span ℂ (Set.range (fun i => primeProfileClockClass (c i))) at hmem
  rw [Finsupp.mem_span_range_iff_exists_finsupp] at hmem
  obtain ⟨a, ha⟩ := hmem
  let combo : ArithmeticFunction ℂ := Finsupp.linearCombination ℂ c a
  have hclassCombo : primeProfileClockClass combo = primeProfileClockClass f := by
    calc
      primeProfileClockClass combo =
          Finsupp.linearCombination ℂ (fun i => primeProfileClockClass (c i)) a := by
        dsimp only [combo]
        rw [Finsupp.linearCombination_apply,
          Finsupp.linearCombination_apply, map_finsuppSum]
        simp only [map_smul]
      _ = primeProfileClockClass f := ha
  let residual : ArithmeticFunction ℂ := f - combo
  have hresidualClass : primeProfileClockClass residual = 0 := by
    dsimp only [residual]
    rw [map_sub, hclassCombo, sub_self]
  have hresidualLocal : PrimePowerClockLocal
      (primePowerCoordinateProfile residual) := by
    unfold primeProfileClockClass at hresidualClass
    change primePowerCoordinateProfile residual ∈
      rayLocalSubmodule primePowerClockRay
    simpa only [LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] using hresidualClass
  have hcomboSupport : PrimeProfileSupportedOnPositivePrimePowers combo := by
    intro n hn
    by_contra hnone
    have hzero : ∀ i, c i n = 0 := by
      intro i
      by_contra hi
      exact hnone (hcsupport i hi)
    have hsum : ∀ s : Finset I,
        (∑ i ∈ s, a i • c i) n = 0 := by
      intro s
      induction s using Finset.induction_on with
      | empty => simp
      | @insert i s hi ih =>
          rw [Finset.sum_insert hi, ArithmeticFunction.add_apply,
            ArithmeticFunction.smul_map, hzero i, smul_zero, ih, zero_add]
    apply hn
    dsimp only [combo]
    rw [Finsupp.linearCombination_apply_of_mem_supported ℂ
      (Finsupp.mem_supported_support ℂ a)]
    exact hsum a.support
  have hresidualSupport : PrimeProfileSupportedOnPositivePrimePowers residual := by
    intro n hn
    by_contra hnone
    have hfzero : f n = 0 := by
      by_contra hfn
      exact hnone (hfsupport hfn)
    have hczero : combo n = 0 := by
      by_contra hcn
      exact hnone (hcomboSupport hcn)
    apply hn
    dsimp only [residual]
    change f n - combo n = 0
    rw [hfzero, hczero, sub_zero]
  have hresidualBase :
      algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField residual ∈
        finitePrimeCoefficientField :=
    algebraMap_primeProfile_mem_finitePrimeCoefficientField_of_local
      residual hresidualSupport hresidualLocal
  let K := primeProfileStaticField c
  have hcomboMem :
      algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField combo ∈ K := by
    dsimp only [combo]
    rw [Finsupp.linearCombination_apply, map_finsuppSum]
    unfold Finsupp.sum
    apply IntermediateField.sum_mem
    intro i hi
    change algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
      ((a i) • c i) ∈ K
    rw [Algebra.smul_def, map_mul]
    apply IntermediateField.mul_mem
    · have hscalar := IntermediateField.algebraMap_mem K
        (algebraMap ℂ finitePrimeCoefficientField (a i))
      rw [← IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
        arithmeticFunctionFractionField] at hscalar
      rw [← IsScalarTower.algebraMap_apply ℂ (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField]
      exact hscalar
    · unfold K primeProfileStaticField
      exact IntermediateField.subset_adjoin finitePrimeCoefficientField _
        (Set.mem_range_self i)
  let r : finitePrimeCoefficientField :=
    ⟨algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField residual,
      hresidualBase⟩
  have hresidualMem :
      algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField residual ∈ K := by
    have hr := IntermediateField.algebraMap_mem K r
    simpa only [r] using hr
  have hdecomp : f = combo + residual := by
    simp [residual]
  rw [hdecomp, map_add]
  exact IntermediateField.add_mem K hcomboMem hresidualMem

/-- Static field membership cannot create a source direction outside the source span. -/
theorem clockClass_mem_of_carrier_mem_primeProfileStaticField
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (hc : LinearIndependent ℂ (fun i => primeProfileClockClass (c i)))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f)
    (hfmem : algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f ∈
      primeProfileStaticField c) :
    primeProfileClockClass f ∈ primeProfileStaticSubmodule c := by
  classical
  by_contra hnot
  have hnewQuotient : LinearIndependent ℂ
      ((primeProfileStaticSubmodule c).mkQ ∘
        (fun _ : Unit => primeProfileClockClass f)) := by
    rw [linearIndependent_unique_iff]
    change (primeProfileStaticSubmodule c).mkQ (primeProfileClockClass f) ≠ 0
    rw [Submodule.mkQ_apply]
    exact mt (Submodule.Quotient.mk_eq_zero (primeProfileStaticSubmodule c)).mp hnot
  have hclassCombined : LinearIndependent ℂ
      (Sum.elim (fun i => primeProfileClockClass (c i))
        (fun _ : Unit => primeProfileClockClass f)) :=
    (linearIndependent_sumElim_iff_quotient
      (fun i => primeProfileClockClass (c i))
      (fun _ : Unit => primeProfileClockClass f)).mpr ⟨hc, hnewQuotient⟩
  let profile : I ⊕ Unit -> ArithmeticFunction ℂ :=
    Sum.elim c (fun _ : Unit => f)
  have hprofileSupport : ∀ z,
      PrimeProfileSupportedOnPositivePrimePowers (profile z) := by
    intro z
    rcases z with i | u
    · exact hcsupport i
    · exact hfsupport
  have hprofileClass :
      (fun z => primeProfileClockClass (profile z)) =
        Sum.elim (fun i => primeProfileClockClass (c i))
          (fun _ : Unit => primeProfileClockClass f) := by
    funext z
    rcases z with i | u <;> rfl
  have hAI : AlgebraicIndependent finitePrimeCoefficientField
      (fun z => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField (profile z)) := by
    apply (algebraicIndependent_fractionPrimeProfiles_iff_clockClassIndependent_arbitrary
      profile hprofileSupport).mpr
    rw [hprofileClass]
    exact hclassCombined
  let oldCarrier : I -> arithmeticFunctionFractionField := fun i =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (c i)
  let newCarrier : Unit -> arithmeticFunctionFractionField := fun _ =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f
  have hswap := hAI.comp (Equiv.sumComm Unit I)
    (Equiv.sumComm Unit I).injective
  have hswapFamily :
      ((fun z => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField (profile z)) ∘ (Equiv.sumComm Unit I)) =
        Sum.elim newCarrier oldCarrier := by
    funext z
    rcases z with u | i <;> rfl
  have hAIswap : AlgebraicIndependent finitePrimeCoefficientField
      (Sum.elim newCarrier oldCarrier) := by
    rw [hswapFamily] at hswap
    exact hswap
  have hAIoverAlg : AlgebraicIndependent
      (Algebra.adjoin finitePrimeCoefficientField (Set.range oldCarrier)) newCarrier :=
    (AlgebraicIndependent.sumElim_iff.mp hAIswap).2
  have hAIoverField : AlgebraicIndependent (primeProfileStaticField c) newCarrier := by
    apply IntermediateField.algebraicIndependent_adjoin_iff.mpr
    simpa only [primeProfileStaticField, oldCarrier] using hAIoverAlg
  have htrans : Transcendental (primeProfileStaticField c)
      (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f) := by
    simpa only [newCarrier] using hAIoverField.transcendental ()
  exact htrans (by
    simpa using isAlgebraic_algebraMap
      (R := primeProfileStaticField c)
      (A := arithmeticFunctionFractionField)
      (⟨algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f, hfmem⟩ :
        primeProfileStaticField c))

/-- Exact order-zero recovery for a static independent presentation. -/
theorem carrier_mem_primeProfileStaticField_iff_clockClass_mem
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (hc : LinearIndependent ℂ (fun i => primeProfileClockClass (c i)))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f) :
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f ∈
        primeProfileStaticField c ↔
      primeProfileClockClass f ∈ primeProfileStaticSubmodule c := by
  constructor
  · exact clockClass_mem_of_carrier_mem_primeProfileStaticField
      c hcsupport hc f hfsupport
  · exact carrier_mem_primeProfileStaticField_of_clockClass_mem
      c hcsupport f hfsupport

/-- Index of a Hamel basis of the complete old prime-clock submodule. -/
abbrev PrimeProfileClockBasisIndex
    {I : Type*} (c : I -> ArithmeticFunction ℂ) :=
  Module.Basis.ofVectorSpaceIndex ℂ (primeProfileClockSubmodule c)

/-- Canonical positive-prime-power representative of one intrinsic clock-basis vector. -/
def primeProfileClockBasisSource
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (i : PrimeProfileClockBasisIndex c) : ArithmeticFunction ℂ :=
  primeProfileClockRepresentative
    ((Module.Basis.ofVectorSpace ℂ (primeProfileClockSubmodule c) i :
      primeProfileClockSubmodule c) : PrimeProfileClockQuotient)

@[simp]
theorem primeProfileClockClass_basisSource
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (i : PrimeProfileClockBasisIndex c) :
    primeProfileClockClass (primeProfileClockBasisSource c i) =
      ((Module.Basis.ofVectorSpace ℂ (primeProfileClockSubmodule c) i :
        primeProfileClockSubmodule c) : PrimeProfileClockQuotient) := by
  exact primeProfileClockClass_representative _

theorem primeProfileClockBasisSource_supportedOnPositivePrimePowers
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (i : PrimeProfileClockBasisIndex c) :
    PrimeProfileSupportedOnPositivePrimePowers
      (primeProfileClockBasisSource c i) :=
  primeProfileClockRepresentative_supportedOnPositivePrimePowers _

/-- The represented Hamel basis spans exactly the complete old clock submodule. -/
theorem span_primeProfileClockClass_basisSource
    {I : Type*} (c : I -> ArithmeticFunction ℂ) :
    Submodule.span ℂ
        (Set.range (fun i : PrimeProfileClockBasisIndex c =>
          primeProfileClockClass (primeProfileClockBasisSource c i))) =
      primeProfileClockSubmodule c := by
  let b := Module.Basis.ofVectorSpace ℂ (primeProfileClockSubmodule c)
  rw [show Set.range (fun i : PrimeProfileClockBasisIndex c =>
      primeProfileClockClass (primeProfileClockBasisSource c i)) =
      (primeProfileClockSubmodule c).subtype '' Set.range b by
    ext q
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨b i, Set.mem_range_self i, by simp [b]⟩
    · rintro ⟨q, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, by simp [b]⟩,
    ← Submodule.map_span, b.span_eq, Submodule.map_top,
    Submodule.range_subtype]

/-- The intrinsic clock-basis classes are linearly independent in the ambient quotient. -/
theorem linearIndependent_primeProfileClockClass_basisSource
    {I : Type*} (c : I -> ArithmeticFunction ℂ) :
    LinearIndependent ℂ
      (fun i : PrimeProfileClockBasisIndex c =>
        primeProfileClockClass (primeProfileClockBasisSource c i)) := by
  let b := Module.Basis.ofVectorSpace ℂ (primeProfileClockSubmodule c)
  have hb := b.linearIndependent.map'
    (primeProfileClockSubmodule c).subtype
    (primeProfileClockSubmodule c).ker_subtype
  simpa only [b, primeProfileClockClass_basisSource] using hb

/-- A clock submodule's basis field is already closed under every jet and equals the
differential field generated by any source family presenting that submodule. -/
theorem differentialAdjoin_eq_primeProfileClockBasisStaticField
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i)) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (c i))) =
      primeProfileStaticField (primeProfileClockBasisSource c) := by
  apply le_antisymm
  · unfold GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨x, ⟨i, rfl⟩, n, rfl⟩
    rw [differentialJet_algebraMap_primeProfileRotatedLogJet]
    apply carrier_mem_primeProfileStaticField_of_clockClass_mem
      (primeProfileClockBasisSource c)
      (primeProfileClockBasisSource_supportedOnPositivePrimePowers c)
      (primeProfileRotatedLogJet n (c i))
      (primeProfileRotatedLogJet_supportedOnPositivePrimePowers
        (c i) (hcsupport i) n)
    rw [primeProfileStaticSubmodule,
      span_primeProfileClockClass_basisSource c]
    apply Submodule.subset_span
    exact ⟨(i, n), rfl⟩
  · unfold primeProfileStaticField
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨i, rfl⟩
    apply carrier_mem_differentialAdjoin_of_primeProfileClockClass_mem
      c hcsupport (primeProfileClockBasisSource c i)
      (primeProfileClockBasisSource_supportedOnPositivePrimePowers c i)
    rw [primeProfileClockClass_basisSource]
    exact (Module.Basis.ofVectorSpace ℂ (primeProfileClockSubmodule c) i).2

/-- **Intrinsic source recovery.**  For an arbitrary old presentation, actual field membership
is exactly membership in the complete old clock submodule. -/
theorem primeProfileCarrier_mem_differentialAdjoin_iff_intrinsicClockClass_mem
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f) :
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f ∈
        GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (c i))) ↔
      primeProfileClockClass f ∈ primeProfileClockSubmodule c := by
  let basisSource := primeProfileClockBasisSource c
  have hbasisSupport : ∀ i,
      PrimeProfileSupportedOnPositivePrimePowers (basisSource i) :=
    primeProfileClockBasisSource_supportedOnPositivePrimePowers c
  have hbasisIndependent : LinearIndependent ℂ
      (fun i => primeProfileClockClass (basisSource i)) := by
    simpa only [basisSource] using
      linearIndependent_primeProfileClockClass_basisSource c
  have hfield := differentialAdjoin_eq_primeProfileClockBasisStaticField c hcsupport
  rw [hfield,
    carrier_mem_primeProfileStaticField_iff_clockClass_mem
      basisSource hbasisSupport hbasisIndependent f hfsupport,
    primeProfileStaticSubmodule,
    show Submodule.span ℂ
        (Set.range (fun i => primeProfileClockClass (basisSource i))) =
          primeProfileClockSubmodule c by
      simpa only [basisSource] using span_primeProfileClockClass_basisSource c]

/-- Embedded differential-field inclusion is exactly inclusion of intrinsic clock submodules,
with no pivot or cardinality hypothesis on either presentation. -/
theorem primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
    {I J : Type*}
    (c : I -> ArithmeticFunction ℂ) (d : J -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (hdsupport : ∀ j, PrimeProfileSupportedOnPositivePrimePowers (d j)) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (c i))) ≤
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun j => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (d j))) ↔
      primeProfileClockSubmodule c ≤ primeProfileClockSubmodule d := by
  constructor
  · intro hfield
    rw [primeProfileClockSubmodule, Submodule.span_le]
    intro q hq
    obtain ⟨ik, rfl⟩ := hq
    apply (primeProfileCarrier_mem_differentialAdjoin_iff_intrinsicClockClass_mem
      d hdsupport
      (primeProfileRotatedLogJet ik.2 (c ik.1))
      (primeProfileRotatedLogJet_supportedOnPositivePrimePowers
        (c ik.1) (hcsupport ik.1) ik.2)).mp
    apply hfield
    have hjet :
        GaloisForLFunctions.differentialJet ik.2
            (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
              (c ik.1)) ∈
          GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
            (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
              arithmeticFunctionFractionField (c i))) :=
      GaloisForLFunctions.differentialJet_mem_differentialAdjoin
        finitePrimeCoefficientField (Set.mem_range_self ik.1) ik.2
    simpa only [differentialJet_algebraMap_primeProfileRotatedLogJet] using hjet
  · intro hmodule
    unfold GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨x, ⟨i, rfl⟩, n, rfl⟩
    rw [differentialJet_algebraMap_primeProfileRotatedLogJet]
    apply (primeProfileCarrier_mem_differentialAdjoin_iff_intrinsicClockClass_mem
      d hdsupport (primeProfileRotatedLogJet n (c i))
      (primeProfileRotatedLogJet_supportedOnPositivePrimePowers
        (c i) (hcsupport i) n)).mpr
    apply hmodule
    apply Submodule.subset_span
    exact ⟨(i, n), rfl⟩

/-- Two arbitrary prime-profile presentations generate the same embedded differential field if
and only if they generate the same intrinsic clock submodule. -/
theorem primeProfile_differentialAdjoin_eq_iff_intrinsicClockSubmodule_eq
    {I J : Type*}
    (c : I -> ArithmeticFunction ℂ) (d : J -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (hdsupport : ∀ j, PrimeProfileSupportedOnPositivePrimePowers (d j)) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (c i))) =
      GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun j => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (d j))) ↔
      primeProfileClockSubmodule c = primeProfileClockSubmodule d := by
  constructor
  · intro hfield
    apply le_antisymm
    · exact (primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
        c d hcsupport hdsupport).mp hfield.le
    · exact (primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
        d c hdsupport hcsupport).mp hfield.ge
  · intro hmodule
    apply le_antisymm
    · exact (primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
        c d hcsupport hdsupport).mpr hmodule.le
    · exact (primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
        d c hdsupport hcsupport).mpr hmodule.ge

/-- A nonzero affine linear polynomial cannot disappear through its constant term. -/
theorem primeClock_finsuppLinearPolynomial_sub_C_ne_zero
    {F J : Type*} [Field F] [Algebra ℂ F]
    (a : J →₀ ℂ) (ha : a ≠ 0) (b : F) :
    a.sum (fun j z => MvPolynomial.C (algebraMap ℂ F z) * MvPolynomial.X j) -
        MvPolynomial.C b ≠ 0 := by
  classical
  obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp ha
  intro hzero
  have hcoeff := congrArg (MvPolynomial.coeff (Finsupp.single j 1)) hzero
  have hjsupport : j ∈ a.support := Finsupp.mem_support_iff.mpr hj
  have hsingle : (Finsupp.single j 1 : J →₀ Nat) ≠ 0 :=
    Finsupp.single_ne_zero.mpr one_ne_zero
  have hzeroSingle : (0 : J →₀ Nat) ≠ Finsupp.single j 1 := hsingle.symm
  rw [Finsupp.sum, MvPolynomial.coeff_sub, MvPolynomial.coeff_sum] at hcoeff
  simp_rw [MvPolynomial.C_mul_X_eq_monomial,
    MvPolynomial.coeff_monomial] at hcoeff
  simp [Finsupp.single_eq_single_iff, hjsupport, hzeroSingle] at hcoeff
  exact hj ((FaithfulSMul.algebraMap_injective ℂ F) (by simpa using hcoeff))

/-- **Intrinsic relative prime-clock correspondence.**  No freeness or cardinality hypothesis is
placed on the old source family.  The complete old clock submodule, rather than a chosen pivot
presentation, is the exact relative invariant. -/
theorem differentialIndependent_fractionPrimeProfiles_relative_iff_clockQuotientIndependent_arbitrary
    {I H : Type*}
    (c : I -> ArithmeticFunction ℂ) (g : H -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (hgsupport : ∀ h, PrimeProfileSupportedOnPositivePrimePowers (g h)) :
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (c i))))
        (fun h => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (g h)) ↔
      PrimeProfileRelativeClockIndependent c g := by
  classical
  let Kc := GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
    (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
      arithmeticFunctionFractionField (c i)))
  let jetSource : H × Nat -> ArithmeticFunction ℂ := fun hn =>
    primeProfileRotatedLogJet hn.2 (g hn.1)
  let jetCarrier : H × Nat -> arithmeticFunctionFractionField := fun hn =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (jetSource hn)
  have hjetFamily :
      (fun hn : H × Nat => GaloisForLFunctions.differentialJet hn.2
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (g hn.1))) =
        jetCarrier := by
    funext hn
    exact differentialJet_algebraMap_primeProfileRotatedLogJet hn.2 (g hn.1)
  constructor
  · intro hdiff
    have hAI : AlgebraicIndependent Kc jetCarrier := by
      unfold GaloisForLFunctions.DifferentialIndependent at hdiff
      rw [hjetFamily] at hdiff
      exact hdiff
    unfold PrimeProfileRelativeClockIndependent
    rw [linearIndependent_iff_injective_finsuppLinearCombination]
    intro a d had
    let e : H × Nat →₀ ℂ := a - d
    have heqQ : Finsupp.linearCombination ℂ
        ((primeProfileClockSubmodule c).mkQ ∘ primeProfileClockJetFamily g) e = 0 := by
      calc
        Finsupp.linearCombination ℂ
            ((primeProfileClockSubmodule c).mkQ ∘ primeProfileClockJetFamily g) e =
          Finsupp.linearCombination ℂ
              ((primeProfileClockSubmodule c).mkQ ∘ primeProfileClockJetFamily g) a -
            Finsupp.linearCombination ℂ
              ((primeProfileClockSubmodule c).mkQ ∘ primeProfileClockJetFamily g) d := by
                exact map_sub _ _ _
        _ = 0 := sub_eq_zero.mpr had
    by_contra hneq
    have he : e ≠ 0 := by
      intro hezero
      apply hneq
      exact sub_eq_zero.mp hezero
    let combo : ArithmeticFunction ℂ :=
      Finsupp.linearCombination ℂ jetSource e
    have hcomboClass : primeProfileClockClass combo =
        Finsupp.linearCombination ℂ (primeProfileClockJetFamily g) e := by
      dsimp only [combo]
      rw [Finsupp.linearCombination_apply,
        Finsupp.linearCombination_apply, map_finsuppSum]
      simp only [map_smul, jetSource, primeProfileClockJetFamily]
    have hcomboMem : primeProfileClockClass combo ∈ primeProfileClockSubmodule c := by
      rw [← Submodule.Quotient.mk_eq_zero]
      rw [hcomboClass]
      exact (Finsupp.apply_linearCombination ℂ
        (primeProfileClockSubmodule c).mkQ (primeProfileClockJetFamily g) e).trans heqQ
    have hcomboSupport : PrimeProfileSupportedOnPositivePrimePowers combo := by
      intro n hn
      by_contra hnone
      have hzero : ∀ z, jetSource z n = 0 := by
        intro z
        by_contra hz
        exact hnone
          (primeProfileRotatedLogJet_supportedOnPositivePrimePowers
            (g z.1) (hgsupport z.1) z.2 hz)
      have hsum : ∀ s : Finset (H × Nat),
          (∑ z ∈ s, e z • jetSource z) n = 0 := by
        intro s
        induction s using Finset.induction_on with
        | empty => simp
        | @insert z s hz ih =>
            rw [Finset.sum_insert hz, ArithmeticFunction.add_apply,
              ArithmeticFunction.smul_map, hzero z, smul_zero, ih, zero_add]
      apply hn
      dsimp only [combo]
      rw [Finsupp.linearCombination_apply_of_mem_supported ℂ
        (Finsupp.mem_supported_support ℂ e)]
      exact hsum e.support
    have hcomboField :
        algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField combo ∈ Kc := by
      apply carrier_mem_differentialAdjoin_of_primeProfileClockClass_mem
        c hcsupport combo hcomboSupport hcomboMem
    let b : Kc :=
      ⟨algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField combo,
        hcomboField⟩
    let P : MvPolynomial (H × Nat) Kc :=
      e.sum (fun hn z =>
        MvPolynomial.C (algebraMap ℂ Kc z) * MvPolynomial.X hn) -
          MvPolynomial.C b
    have hPne : P ≠ 0 :=
      primeClock_finsuppLinearPolynomial_sub_C_ne_zero e he b
    have hcarrier :
        e.sum (fun hn z =>
          algebraMap ℂ arithmeticFunctionFractionField z * jetCarrier hn) =
        algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField combo := by
      dsimp only [combo, jetCarrier]
      rw [Finsupp.linearCombination_apply, map_finsuppSum]
      unfold Finsupp.sum
      apply Finset.sum_congr rfl
      intro hn hhn
      change algebraMap ℂ arithmeticFunctionFractionField (e hn) *
          algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
            (jetSource hn) =
        algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
          ((e hn) • jetSource hn)
      rw [Algebra.smul_def, map_mul,
        IsScalarTower.algebraMap_apply ℂ (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField]
    have hPzero : MvPolynomial.aeval jetCarrier P = 0 := by
      simp only [P, Finsupp.sum, map_sub, map_sum, map_mul,
        MvPolynomial.aeval_C, MvPolynomial.aeval_X]
      have hscalar : ∀ z : ℂ,
          algebraMap Kc arithmeticFunctionFractionField (algebraMap ℂ Kc z) =
            algebraMap ℂ arithmeticFunctionFractionField z := by
        intro z
        rw [IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField Kc]
        rw [← IsScalarTower.algebraMap_apply finitePrimeCoefficientField Kc
          arithmeticFunctionFractionField]
        rw [← IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
          arithmeticFunctionFractionField]
      simp_rw [hscalar]
      change e.sum (fun hn z =>
        algebraMap ℂ arithmeticFunctionFractionField z * jetCarrier hn) - b.1 = 0
      rw [hcarrier]
      simp [b]
    exact hPne (hAI.eq_zero_of_aeval_eq_zero P hPzero)
  · intro hquot
    let B := PrimeProfileClockBasisIndex c
    let basisSource : B -> ArithmeticFunction ℂ := primeProfileClockBasisSource c
    let oldCarrier : B -> arithmeticFunctionFractionField := fun i =>
      algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (basisSource i)
    have hbasis : LinearIndependent ℂ
        (fun i : B => primeProfileClockClass (basisSource i)) := by
      simpa only [B, basisSource] using
        linearIndependent_primeProfileClockClass_basisSource c
    have hspan : Submodule.span ℂ
        (Set.range (fun i : B => primeProfileClockClass (basisSource i))) =
        primeProfileClockSubmodule c := by
      simpa only [B, basisSource] using span_primeProfileClockClass_basisSource c
    have hcombinedClass : LinearIndependent ℂ
        (Sum.elim (fun i : B => primeProfileClockClass (basisSource i))
          (primeProfileClockJetFamily g)) := by
      apply (linearIndependent_sumElim_iff_quotient
        (fun i : B => primeProfileClockClass (basisSource i))
        (primeProfileClockJetFamily g)).mpr
      rw [hspan]
      exact ⟨hbasis, hquot⟩
    let profile : B ⊕ (H × Nat) -> ArithmeticFunction ℂ :=
      Sum.elim basisSource jetSource
    have hprofileSupport : ∀ z,
        PrimeProfileSupportedOnPositivePrimePowers (profile z) := by
      intro z
      rcases z with i | hn
      · exact primeProfileClockBasisSource_supportedOnPositivePrimePowers c i
      · exact primeProfileRotatedLogJet_supportedOnPositivePrimePowers
          (g hn.1) (hgsupport hn.1) hn.2
    have hprofileClass :
        (fun z => primeProfileClockClass (profile z)) =
          Sum.elim (fun i : B => primeProfileClockClass (basisSource i))
            (primeProfileClockJetFamily g) := by
      funext z
      rcases z with i | hn <;> rfl
    have hAIcombined : AlgebraicIndependent finitePrimeCoefficientField
        (fun z => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (profile z)) := by
      apply (algebraicIndependent_fractionPrimeProfiles_iff_clockClassIndependent_arbitrary
        profile hprofileSupport).mpr
      rw [hprofileClass]
      exact hcombinedClass
    have hswap := hAIcombined.comp (Equiv.sumComm (H × Nat) B)
      (Equiv.sumComm (H × Nat) B).injective
    have hswapFamily :
        ((fun z => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (profile z)) ∘
            (Equiv.sumComm (H × Nat) B)) =
          Sum.elim jetCarrier oldCarrier := by
      funext z
      rcases z with hn | i <;> rfl
    have hAIswap : AlgebraicIndependent finitePrimeCoefficientField
        (Sum.elim jetCarrier oldCarrier) := by
      rw [hswapFamily] at hswap
      exact hswap
    have hAIoverAlg : AlgebraicIndependent
        (Algebra.adjoin finitePrimeCoefficientField (Set.range oldCarrier)) jetCarrier :=
      (AlgebraicIndependent.sumElim_iff.mp hAIswap).2
    have hAIoverField : AlgebraicIndependent
        (primeProfileStaticField basisSource) jetCarrier := by
      apply IntermediateField.algebraicIndependent_adjoin_iff.mpr
      simpa only [primeProfileStaticField, oldCarrier] using hAIoverAlg
    have hfield := differentialAdjoin_eq_primeProfileClockBasisStaticField c hcsupport
    unfold GaloisForLFunctions.DifferentialIndependent
    rw [hjetFamily, hfield]
    simpa only [basisSource] using hAIoverField

/-- Intrinsic polynomial saturation for one source over an arbitrary old presentation. -/
def PrimeProfileIntrinsicClockSaturatedOver
    {I : Type*} (c : I -> ArithmeticFunction ℂ) (f : ArithmeticFunction ℂ) : Prop :=
  ∃ a : Unit × Nat →₀ ℂ, a ≠ 0 ∧
    a.sum (fun ik z => z •
        primeProfileClockJetFamily (fun _ : Unit => f) ik) ∈
      primeProfileClockSubmodule c

/-- **Pullback of Kolchin closure.**  Differential-algebraic closure over an arbitrary generated
prime-profile field is exactly polynomial saturation in the intrinsic prime-clock quotient. -/
theorem differentialAlgebraic_fractionPrimeProfile_iff_intrinsicClockSaturated
    {I : Type*} (c : I -> ArithmeticFunction ℂ)
    (hcsupport : ∀ i, PrimeProfileSupportedOnPositivePrimePowers (c i))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f) :
    GaloisForLFunctions.DifferentialAlgebraicOver
        (GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (c i))))
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f) ↔
      PrimeProfileIntrinsicClockSaturatedOver c f := by
  change GaloisForLFunctions.DifferentialAlgebraicOver
        (GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
          (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (c i))))
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f) ↔
      PrimeProfileClockPolynomialSaturatedOver c f
  rw [GaloisForLFunctions.DifferentialAlgebraicOver,
    primeProfileClockPolynomialSaturatedOver_iff_not_relativeClockIndependent]
  exact not_congr
    (differentialIndependent_fractionPrimeProfiles_relative_iff_clockQuotientIndependent_arbitrary
      c (fun _ : Unit => f) hcsupport (fun _ => hfsupport))

end

