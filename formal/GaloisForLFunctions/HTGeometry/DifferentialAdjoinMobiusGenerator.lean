import GaloisForLFunctions.HTGeometry.ScalarDifferentialRationalOrder

/-!
# Differential generators related by a Möbius transform generate the same field

If two elements are order-zero rational functions of each other, they generate the same differential
field.  In particular the diagonalizing coordinate `x = (u − p₁)/(u − p₂)` produced by the
fixed-point diagonalization of a clock element is again a differential generator of the core:
`differentialAdjoin C {x} = differentialAdjoin C {u}`.

This is the change-of-generator step that lets the diagonalized anchor coordinate serve as the
clock-character generator `q` (equation (2)).
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

variable {C K : Type*} [Field C] [Field K] [Differential C] [Differential K]
  [Algebra C K] [DifferentialAlgebra C K]

/-- If `x` lies in the differential field generated by `u`, then the differential field generated by
`x` is contained in it (all jets of `x` stay inside the derivation-closed field). -/
theorem differentialAdjoin_singleton_le_of_mem
    {x u : K} (hx : x ∈ differentialAdjoin C ({u} : Set K)) :
    differentialAdjoin C ({x} : Set K) ≤ differentialAdjoin C ({u} : Set K) := by
  have hclosed := derivationClosed_differentialAdjoin C ({u} : Set K)
  have hjet : ∀ n : ℕ, differentialJet n x ∈ differentialAdjoin C ({u} : Set K) := by
    intro n
    induction n with
    | zero => simpa using hx
    | succ n ih => rw [differentialJet_succ]; exact hclosed ih
  rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
  rintro _ ⟨z, rfl, n, rfl⟩
  exact hjet n

/-- Two elements that are order-zero rational functions of each other generate the same differential
field. -/
theorem differentialAdjoin_singleton_eq_of_mem_mem
    {x u : K} (hxu : x ∈ differentialAdjoin C ({u} : Set K))
    (hux : u ∈ differentialAdjoin C ({x} : Set K)) :
    differentialAdjoin C ({x} : Set K) = differentialAdjoin C ({u} : Set K) :=
  le_antisymm (differentialAdjoin_singleton_le_of_mem hxu)
    (differentialAdjoin_singleton_le_of_mem hux)

/-- **Change of generator by a Möbius transform.**  If `u` generates the whole field and
`p₁ ≠ p₂` with `u ≠ p₂`, then the Möbius coordinate `(u − p₁)/(u − p₂)` also generates the whole
field. -/
theorem differentialAdjoin_mobius_generator
    {u : K} {p₁ p₂ : C} (hp : p₁ ≠ p₂)
    (hu2 : u - algebraMap C K p₂ ≠ 0)
    (htop : differentialAdjoin C ({u} : Set K) = ⊤) :
    differentialAdjoin C
        ({(u - algebraMap C K p₁) / (u - algebraMap C K p₂)} : Set K) = ⊤ := by
  set x := (u - algebraMap C K p₁) / (u - algebraMap C K p₂) with hx_def
  have hu_mem : u ∈ differentialAdjoin C ({u} : Set K) :=
    subset_differentialAdjoin C _ rfl
  have hx_mem : x ∈ differentialAdjoin C ({u} : Set K) := by
    rw [hx_def]
    exact div_mem (sub_mem hu_mem (IntermediateField.algebraMap_mem _ p₁))
      (sub_mem hu_mem (IntermediateField.algebraMap_mem _ p₂))
  have hp2p1 : algebraMap C K p₂ - algebraMap C K p₁ ≠ 0 := by
    rw [← map_sub, ne_eq, map_eq_zero, sub_eq_zero]
    exact fun h => hp h.symm
  have hx1 : x - 1 ≠ 0 := by
    rw [sub_ne_zero]
    intro h
    rw [hx_def, div_eq_one_iff_eq hu2] at h
    apply hp2p1
    linear_combination h
  have hu_eq : u = (algebraMap C K p₂ * x - algebraMap C K p₁) / (x - 1) := by
    rw [eq_div_iff hx1, hx_def]
    field_simp
    ring
  have hx_mem_x : x ∈ differentialAdjoin C ({x} : Set K) :=
    subset_differentialAdjoin C _ rfl
  have hu_mem_x : u ∈ differentialAdjoin C ({x} : Set K) := by
    rw [hu_eq]
    exact div_mem
      (sub_mem (mul_mem (IntermediateField.algebraMap_mem _ p₂) hx_mem_x)
        (IntermediateField.algebraMap_mem _ p₁))
      (sub_mem hx_mem_x (one_mem _))
  rw [← htop]
  exact differentialAdjoin_singleton_eq_of_mem_mem hx_mem hu_mem_x

end GaloisForLFunctions.HTGeometry
