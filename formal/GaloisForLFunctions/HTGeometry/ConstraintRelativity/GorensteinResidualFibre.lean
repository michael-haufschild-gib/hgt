import GaloisForLFunctions.HTGeometry.ConstraintRelativity.GorensteinMonogenic
import GaloisForLFunctions.HTGeometry.QuotientPowerMonogenic

/-!
# The residual fibre of a split order and monogenicity

Let `R` be a local ring, `A` a module-finite `R`-algebra sitting inside a split étale algebra
`R^N`, and `B = A/𝔪A` the residual fibre.  This file proves the implication

`Ω[A⁄R]` cyclic  ⟹  `A = R[θ]`

by the classical route: base change identifies `Ω[B⁄k]` with `B ⊗_A Ω[A⁄R]`, so `Ω[B⁄k]` is cyclic;
the cotangent space of each local factor of `B` is a quotient of its Kähler module, hence at most
one-dimensional, so each maximal ideal is principal; the local factors are therefore monogenic and
the Chinese remainder theorem assembles them; Nakayama's lemma lifts the generator to `A`.
-/

namespace HTGeometry.ConstraintRelativity

open IsLocalRing TensorProduct Polynomial GaloisForLFunctions.HTGeometry

/-! ## Base change of Kähler differentials along a quotient of the base -/

section BaseChange

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] (I : Ideal R)

/-- Reducing an algebra modulo an extended ideal is a pushout square. -/
instance isPushout_quotientMap :
    Algebra.IsPushout R (R ⧸ I) A (A ⧸ I.map (algebraMap R A)) := by
  constructor
  refine IsBaseChange.of_equiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I).symm.toLinearEquiv ?_
  intro x
  exact (Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I).symm_apply_eq.mpr rfl

/-- **Card `(5)`.**  Base change of Kähler differentials along the reduction of the base:
`Ω[(A/IA)⁄(R/I)] ≅ (A/IA) ⊗_A Ω[A⁄R]`. -/
noncomputable def kaehlerQuotientBaseChange :
    (A ⧸ I.map (algebraMap R A)) ⊗[A] Ω[A⁄R]
      ≃ₗ[A ⧸ I.map (algebraMap R A)] Ω[(A ⧸ I.map (algebraMap R A))⁄(R ⧸ I)] :=
  KaehlerDifferential.tensorKaehlerEquiv R (R ⧸ I) A (A ⧸ I.map (algebraMap R A))

end BaseChange

/-! ## Transfer of cyclicity -/

section Transfer

/-- A surjective linear map carries a generator of a cyclic module to a generator. -/
theorem span_singleton_eq_top_of_surjective {R M N : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] (f : M →ₗ[R] N) (hf : Function.Surjective f)
    {x : M} (hx : Submodule.span R {x} = ⊤) : Submodule.span R {f x} = ⊤ := by
  have hmap := Submodule.map_span f ({x} : Set M)
  rw [Set.image_singleton] at hmap
  rw [← hmap, hx, Submodule.map_top, LinearMap.range_eq_top.2 hf]

/-- Generating over a subring generates over the larger ring. -/
theorem span_singleton_eq_top_of_tower {A B M : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] {x : M}
    (hx : Submodule.span A {x} = ⊤) : Submodule.span B {x} = ⊤ := by
  have hle : Submodule.span A {x} ≤ (Submodule.span B {x}).restrictScalars A :=
    Submodule.span_le.2 (by simp)
  rw [hx] at hle
  exact eq_top_iff.2 fun y _ => hle Submodule.mem_top

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A] (I : Ideal R)

/-- Cyclicity of the Kähler module passes to the reduction modulo an extended ideal. -/
theorem kaehler_cyclic_quotient {ω : Ω[A⁄R]} (hω : Submodule.span A {ω} = ⊤) :
    Submodule.span (A ⧸ I.map (algebraMap R A))
      {KaehlerDifferential.map R (R ⧸ I) A (A ⧸ I.map (algebraMap R A)) ω} = ⊤ :=
  span_singleton_eq_top_of_tower
    (span_singleton_eq_top_of_surjective _
      (KaehlerDifferential.map_surjective_of_surjective R (R ⧸ I) A _
        Ideal.Quotient.mk_surjective) hω)

/-- Cyclicity of the Kähler module passes to quotient algebras. -/
theorem kaehler_cyclic_quotient_algebra {k B : Type*} [Field k] [CommRing B] [Algebra k B]
    (J : Ideal B) {ω : Ω[B⁄k]} (hω : Submodule.span B {ω} = ⊤) :
    Submodule.span (B ⧸ J) {KaehlerDifferential.map k k B (B ⧸ J) ω} = ⊤ :=
  span_singleton_eq_top_of_tower
    (span_singleton_eq_top_of_surjective _
      (KaehlerDifferential.map_surjective_of_surjective k k B _ Ideal.Quotient.mk_surjective) hω)

end Transfer

/-! ## The residue section of a local algebra with residue field the base -/

section Residue

variable {k C : Type*} [Field k] [CommRing C] [IsLocalRing C] [Algebra k C]
  (hres : Function.Surjective (algebraMap k (ResidueField C)))

/-- A residue field generated by the base field is the base field. -/
noncomputable def resEquiv : k ≃+* ResidueField C :=
  RingEquiv.ofBijective (algebraMap k (ResidueField C))
    ⟨(algebraMap k (ResidueField C)).injective, hres⟩

/-- The ring-theoretic section of the residue map determined by `hres`. -/
noncomputable def resSection : C →+* k := (resEquiv hres).symm.toRingHom.comp (residue C)

theorem resSection_apply (c : C) : resSection hres c = (resEquiv hres).symm (residue C c) := rfl

theorem resSection_algebraMap (x : k) : resSection hres (algebraMap k C x) = x := by
  rw [resSection_apply, show residue C (algebraMap k C x) = resEquiv hres x from rfl,
    RingEquiv.symm_apply_apply]

theorem sub_resSection_mem (c : C) : c - algebraMap k C (resSection hres c) ∈ maximalIdeal C := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  show residue C _ = 0
  rw [map_sub, sub_eq_zero]
  show residue C c = resEquiv hres _
  rw [resSection_apply, RingEquiv.apply_symm_apply]

theorem resSection_eq_zero_of_mem {c : C} (hc : c ∈ maximalIdeal C) : resSection hres c = 0 := by
  rw [resSection_apply, show residue C c = 0 from Ideal.Quotient.eq_zero_iff_mem.2 hc, map_zero]

/-- The deviation `c − σ(c̄)` of an element from its residue, an element of the maximal ideal. -/
noncomputable def resShift (c : C) : maximalIdeal C :=
  ⟨c - algebraMap k C (resSection hres c), sub_resSection_mem hres c⟩

theorem resShift_coe (c : C) :
    (resShift hres c : C) = c - algebraMap k C (resSection hres c) := rfl

theorem resShift_of_mem {c : C} (hc : c ∈ maximalIdeal C) : resShift hres c = ⟨c, hc⟩ := by
  ext
  rw [resShift_coe, resSection_eq_zero_of_mem hres hc, map_zero, sub_zero]

/-- `c ↦ c − σ(c̄)` is `k`-linear. -/
noncomputable def resShiftLinear : C →ₗ[k] maximalIdeal C where
  toFun := resShift hres
  map_add' a b := by
    ext
    push_cast [resShift_coe]
    rw [map_add, map_add]
    ring
  map_smul' r a := by
    ext
    push_cast [resShift_coe]
    simp only [id_eq]
    rw [Algebra.smul_def, Algebra.smul_def, map_mul, resSection_algebraMap, map_mul, mul_sub]

/-- **Card `(6)`.**  The `k`-derivation `c ↦ c − σ(c̄)` from a local `k`-algebra with residue
field `k` onto its cotangent space. -/
noncomputable def residueDerivation : Derivation k C (maximalIdeal C).Cotangent :=
  Derivation.mk' ((maximalIdeal C).toCotangent.restrictScalars k ∘ₗ resShiftLinear hres) <| by
    intro a b
    show (maximalIdeal C).toCotangent (resShift hres (a * b))
      = a • (maximalIdeal C).toCotangent (resShift hres b)
        + b • (maximalIdeal C).toCotangent (resShift hres a)
    rw [← LinearMap.map_smul, ← LinearMap.map_smul, ← map_add, Ideal.toCotangent_eq]
    have hmem : (a - algebraMap k C (resSection hres a)) * (b - algebraMap k C (resSection hres b))
        ∈ maximalIdeal C ^ (2 : ℕ) := by
      rw [pow_two]
      exact Ideal.mul_mem_mul (sub_resSection_mem hres a) (sub_resSection_mem hres b)
    have hexp : (resShift hres (a * b) : C)
        - ((a • resShift hres b + b • resShift hres a : maximalIdeal C) : C)
        = -((a - algebraMap k C (resSection hres a))
              * (b - algebraMap k C (resSection hres b))) := by
      push_cast [resShift_coe]
      rw [map_mul, map_mul]
      ring
    rw [hexp]
    exact neg_mem hmem

theorem residueDerivation_apply_of_mem {c : C} (hc : c ∈ maximalIdeal C) :
    residueDerivation hres c = (maximalIdeal C).toCotangent ⟨c, hc⟩ := by
  show (maximalIdeal C).toCotangent (resShift hres c) = _
  rw [resShift_of_mem hres hc]

/-- The lift of the residue derivation to the Kähler module is surjective. -/
theorem surjective_liftKaehler :
    Function.Surjective (residueDerivation hres).liftKaehlerDifferential := by
  intro x
  obtain ⟨⟨c, hc⟩, rfl⟩ := (maximalIdeal C).toCotangent_surjective x
  exact ⟨KaehlerDifferential.D k C c, by
    rw [Derivation.liftKaehlerDifferential_comp_D, residueDerivation_apply_of_mem hres hc]⟩

end Residue

/-! ## Cyclic Kähler module forces a principal maximal ideal -/

section Principal

variable {k C : Type*} [Field k] [CommRing C] [IsLocalRing C] [Algebra k C]

/-- Residual splitting in elementary form. -/
theorem surjective_algebraMap_residueField_iff :
    Function.Surjective (algebraMap k (ResidueField C))
      ↔ ∀ b : C, ∃ c : k, b - algebraMap k C c ∈ maximalIdeal C := by
  constructor
  · intro h b
    obtain ⟨c, hc⟩ := h (residue C b)
    refine ⟨c, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    show residue C b - residue C (algebraMap k C c) = 0
    rw [sub_eq_zero, show residue C (algebraMap k C c) = algebraMap k (ResidueField C) c from rfl,
      hc]
  · intro h x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨c, hc⟩ := h b
    exact ⟨c, by
      rw [show algebraMap k (ResidueField C) c = residue C (algebraMap k C c) from rfl]
      exact (Ideal.Quotient.eq.2 hc).symm⟩

/-- **Card `(6)`, conclusion.**  Cyclicity of the Kähler module of a local `k`-algebra with
residue field `k` forces the maximal ideal to be principal. -/
theorem isPrincipal_maximalIdeal_of_kaehler_cyclic [IsNoetherianRing C]
    (hres : Function.Surjective (algebraMap k (ResidueField C))) {ω : Ω[C⁄k]}
    (hω : Submodule.span C {ω} = ⊤) : Submodule.IsPrincipal (maximalIdeal C) := by
  rw [← finrank_cotangentSpace_le_one_iff]
  set L := (residueDerivation hres).liftKaehlerDifferential with hL
  have htop : Submodule.span C {L ω} = ⊤ :=
    span_singleton_eq_top_of_surjective _ (surjective_liftKaehler hres) hω
  have hle : Submodule.span C {L ω}
      ≤ (Submodule.span (ResidueField C) {L ω}).restrictScalars C :=
    Submodule.span_le.2 (by simp)
  rw [htop] at hle
  have htop' : Submodule.span (ResidueField C) {L ω} = ⊤ :=
    eq_top_iff.2 fun x _ => hle Submodule.mem_top
  have hfr : Module.finrank (ResidueField C) (CotangentSpace C)
      = Module.finrank (ResidueField C) (Submodule.span (ResidueField C) {L ω}) := by
    rw [htop', finrank_top]
  rw [hfr]
  simpa using finrank_span_le_card (R := ResidueField C) ({L ω} : Set (CotangentSpace C))

end Principal

/-! ## Assembling the local factors -/

section Product

variable {ι k : Type*} [Fintype ι] [Field k]

/-- The product of algebra maps out of the polynomial ring is surjective as soon as the individual
maps are surjective with pairwise coprime kernels. -/
theorem piAlgHom_surjective {E : ι → Type*} [∀ i, CommRing (E i)] [∀ i, Algebra k (E i)]
    (f : ∀ i, Polynomial k →ₐ[k] E i) (hf : ∀ i, Function.Surjective (f i))
    (hcop : Pairwise fun i j => IsCoprime (RingHom.ker (f i : Polynomial k →+* E i))
      (RingHom.ker (f j : Polynomial k →+* E j))) :
    Function.Surjective (AlgHom.pi f) := by
  intro g
  choose q hq using fun i => hf i (g i)
  obtain ⟨y, hy⟩ := Ideal.quotientInfToPiQuotient_surj
    (I := fun i => RingHom.ker (f i : Polynomial k →+* E i)) hcop
    (fun i => Ideal.Quotient.mk _ (q i))
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  refine ⟨r, ?_⟩
  funext i
  have hxi : Ideal.Quotient.mk (RingHom.ker (f i : Polynomial k →+* E i)) r
      = Ideal.Quotient.mk _ (q i) := by
    rw [← congrFun hy i, Ideal.quotientInfToPiQuotient_mk']
  have hsub : r - q i ∈ RingHom.ker (f i : Polynomial k →+* E i) := Ideal.Quotient.eq.mp hxi
  have hzero : f i r - f i (q i) = 0 := by rw [← map_sub]; exact hsub
  show f i r = g i
  rw [← hq i, ← sub_eq_zero]
  exact hzero

/-- **Cards `(7)`–`(8)`.**  A finite product of local algebras with residue field `k` and principal
nilpotent maximal ideal is generated by a single element: translate the generators to distinct
centres, then apply the Chinese remainder theorem in `k[X]`. -/
theorem exists_adjoin_pi_eq_top_of_local [Infinite k] {E : ι → Type*} [∀ i, CommRing (E i)]
    [∀ i, Algebra k (E i)] (t : ∀ i, E i) (N : ι → ℕ)
    (hres : ∀ i (b : E i), ∃ c : k, b - algebraMap k (E i) c ∈ Ideal.span {t i})
    (hnil : ∀ i, t i ^ N i = 0) :
    ∃ α : (∀ i, E i), Algebra.adjoin k ({α} : Set (∀ i, E i)) = ⊤ := by
  classical
  have hlam : Function.Injective
      (fun i : ι => Infinite.natEmbedding k ((Fintype.equivFin ι i : ℕ))) := by
    intro i j h
    exact (Fintype.equivFin ι).injective
      (Fin.val_injective ((Infinite.natEmbedding k).injective h))
  set lam : ι → k := fun i => Infinite.natEmbedding k ((Fintype.equivFin ι i : ℕ)) with hlamdef
  set x : ∀ i, E i := fun i => t i + algebraMap k (E i) (lam i) with hxdef
  have hgen : ∀ i, Algebra.adjoin k ({x i} : Set (E i)) = ⊤ := by
    intro i
    rw [hxdef, adjoin_add_algebraMap]
    exact adjoin_eq_top_of_isPrincipal_nilpotent (t i) (hres i) (hnil i)
  set f : ∀ i, Polynomial k →ₐ[k] E i := fun i => Polynomial.aeval (x i) with hfdef
  have hfsurj : ∀ i, Function.Surjective (f i) := by
    intro i
    have := hgen i
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at this
    exact this
  have hmem : ∀ i, (X - C (lam i)) ^ N i ∈ RingHom.ker (f i : Polynomial k →+* E i) := by
    intro i
    have hval : (f i) (X - C (lam i)) = t i := by
      simp [hfdef, hxdef]
    rw [RingHom.mem_ker]
    show (f i) ((X - C (lam i)) ^ N i) = 0
    rw [map_pow, hval, hnil i]
  have hcop : Pairwise fun i j => IsCoprime (RingHom.ker (f i : Polynomial k →+* E i))
      (RingHom.ker (f j : Polynomial k →+* E j)) := by
    intro i j hij
    have hspan : IsCoprime (Ideal.span {(X - C (lam i)) ^ N i})
        (Ideal.span {(X - C (lam j)) ^ N j}) := isCoprime_shift_pow hlam N hij
    rw [Ideal.isCoprime_iff_sup_eq] at hspan ⊢
    refine top_le_iff.mp ?_
    rw [← hspan]
    exact sup_le_sup ((Ideal.span_singleton_le_iff_mem _).2 (hmem i))
      ((Ideal.span_singleton_le_iff_mem _).2 (hmem j))
  exact ⟨AlgHom.pi f X,
    adjoin_image_singleton_eq_top _ (piAlgHom_surjective f hfsurj hcop) Polynomial.adjoin_X⟩

end Product

/-! ## The residue fields of a split order -/

section SplitOrder

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- **Card `(1)` ⇒ residue fields.**  If a family of `R`-points separates the elements of `A`, then
every prime of `A` has residue ring generated by the image of `R`. -/
theorem exists_sub_algebraMap_mem_of_isPrime {ι : Type*} [Fintype ι] (φ : ι → (A →ₐ[R] R))
    (hφ : ∀ x : A, (∀ i, φ i x = 0) → x = 0) (p : Ideal A) [p.IsPrime] (a : A) :
    ∃ r : R, a - algebraMap R A r ∈ p := by
  classical
  have hinf : (Finset.univ.inf fun i => RingHom.ker (φ i : A →+* R)) ≤ p := by
    intro y hy
    rw [Finset.inf_eq_iInf] at hy
    simp only [Submodule.mem_iInf] at hy
    have : y = 0 := hφ y fun i => hy i (Finset.mem_univ i)
    rw [this]
    exact Submodule.zero_mem p
  obtain ⟨i, -, hi⟩ := (Ideal.IsPrime.inf_le' inferInstance).1 hinf
  refine ⟨φ i a, hi ?_⟩
  rw [RingHom.mem_ker]
  show φ i (a - algebraMap R A (φ i a)) = 0
  rw [map_sub, AlgHom.commutes]
  simp

end SplitOrder

/-! ## Theorem 1, `(2) ⇒ (3)` -/

section Monogenic

variable {R A : Type*} [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [Module.Finite R A]

/-- **Card `(9)`.**  Nakayama: an element generating the residual fibre generates the order. -/
theorem adjoin_eq_top_of_adjoin_residual {θ : A}
    (h : ∀ a : A, ∃ p : Polynomial R,
      a - Polynomial.aeval θ p ∈ (maximalIdeal R).map (algebraMap R A)) :
    Algebra.adjoin R ({θ} : Set A) = ⊤ := by
  set Nsub : Submodule R A := Subalgebra.toSubmodule (Algebra.adjoin R ({θ} : Set A)) with hN
  have hstep : (⊤ : Submodule R A) ≤ Nsub ⊔ maximalIdeal R • (⊤ : Submodule R A) := by
    intro a _
    obtain ⟨p, hp⟩ := h a
    have h1 : Polynomial.aeval θ p ∈ Nsub := by
      rw [hN, Subalgebra.mem_toSubmodule, Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨p, rfl⟩
    have h2 : a - Polynomial.aeval θ p ∈ maximalIdeal R • (⊤ : Submodule R A) := by
      rw [Ideal.smul_top_eq_map]
      exact hp
    have := Submodule.add_mem_sup h1 h2
    simpa using this
  have hjac : maximalIdeal R ≤ Ideal.jacobson ⊥ :=
    le_of_eq (jacobson_eq_maximalIdeal (⊥ : Ideal R) bot_ne_top).symm
  have hnak := Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson
    (N := Nsub) (N' := (⊤ : Submodule R A)) (I := maximalIdeal R) (J := ⊥)
    (Module.Finite.fg_top) hjac hstep
  rw [Submodule.bot_smul, sup_bot_eq, sup_top_eq] at hnak
  rw [hN] at hnak
  refine Subalgebra.toSubmodule_injective ?_
  rw [← hnak]
  simp

end Monogenic

/-! ## The residual fibre is monogenic -/

section Fibre

/-- **Cards `(6)`–`(8)`.**  A finite-dimensional algebra over an infinite field, all of whose
residue fields are the base field and whose Kähler module is cyclic, is generated by one element. -/
theorem exists_adjoin_eq_top_of_kaehler_cyclic_fibre {k B : Type*} [Field k] [Infinite k]
    [CommRing B] [Algebra k B] [Module.Finite k B]
    (hres : ∀ J : Ideal B, J.IsMaximal → ∀ b : B, ∃ c : k, b - algebraMap k B c ∈ J)
    {ω : Ω[B⁄k]} (hω : Submodule.span B {ω} = ⊤) :
    ∃ β : B, Algebra.adjoin k ({β} : Set B) = ⊤ := by
  classical
  haveI hart : IsArtinianRing B := isArtinian_of_tower k inferInstance
  haveI : Fintype (MaximalSpectrum B) := Fintype.ofFinite _
  obtain ⟨n₀, hn₀⟩ := IsArtinianRing.isNilpotent_nilradical (R := B)
  set n : ℕ := n₀ + 1 with hndef
  have hnil : nilradical B ^ n = ⊥ := by
    refine le_antisymm ?_ bot_le
    calc nilradical B ^ n ≤ nilradical B ^ n₀ := Ideal.pow_le_pow_right (by omega)
      _ = ⊥ := by rw [hn₀]; rfl
  have hnpos : 0 < n := Nat.succ_pos n₀
  haveI hloc : ∀ I : MaximalSpectrum B, IsLocalRing (B ⧸ I.asIdeal ^ n) := fun I =>
    isLocalRing_quotientPow I.asIdeal hnpos
  haveI hfin : ∀ I : MaximalSpectrum B, Module.Finite k (B ⧸ I.asIdeal ^ n) := fun I =>
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ k (I.asIdeal ^ n)).toLinearMap
      Ideal.Quotient.mk_surjective
  haveI hnoeth : ∀ I : MaximalSpectrum B, IsNoetherianRing (B ⧸ I.asIdeal ^ n) := fun I =>
    isNoetherian_of_tower k inferInstance
  have hresQ : ∀ I : MaximalSpectrum B, ∀ b : B ⧸ I.asIdeal ^ n,
      ∃ c : k, b - algebraMap k (B ⧸ I.asIdeal ^ n) c ∈ maximalIdeal (B ⧸ I.asIdeal ^ n) := by
    intro I b
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨c, hc⟩ := hres I.asIdeal I.isMaximal a
    refine ⟨c, ?_⟩
    rw [maximalIdeal_quotientPow I.asIdeal hnpos]
    have hmapped : (Ideal.Quotient.mk (I.asIdeal ^ n)) (a - algebraMap k B c)
        ∈ Ideal.map (Ideal.Quotient.mk (I.asIdeal ^ n)) I.asIdeal := Ideal.mem_map_of_mem _ hc
    rw [map_sub] at hmapped
    exact hmapped
  have hprin : ∀ I : MaximalSpectrum B,
      Submodule.IsPrincipal (maximalIdeal (B ⧸ I.asIdeal ^ n)) := fun I =>
    isPrincipal_maximalIdeal_of_kaehler_cyclic
      (surjective_algebraMap_residueField_iff.2 (hresQ I))
      (kaehler_cyclic_quotient_algebra (I.asIdeal ^ n) hω)
  choose t ht using fun I : MaximalSpectrum B => (hprin I).principal
  have htnil : ∀ I : MaximalSpectrum B, t I ^ n = 0 := by
    intro I
    have h1 : t I ∈ maximalIdeal (B ⧸ I.asIdeal ^ n) := by
      rw [ht I]; exact Ideal.subset_span rfl
    have h2 := Ideal.pow_mem_pow h1 n
    rw [maximalIdeal_quotientPow_pow I.asIdeal hnpos, Ideal.mem_bot] at h2
    exact h2
  have hresT : ∀ (I : MaximalSpectrum B) (b : B ⧸ I.asIdeal ^ n),
      ∃ c : k, b - algebraMap k (B ⧸ I.asIdeal ^ n) c ∈ Ideal.span {t I} := by
    intro I b
    obtain ⟨c, hc⟩ := hresQ I b
    have hspan : Ideal.span {t I} = maximalIdeal (B ⧸ I.asIdeal ^ n) := (ht I).symm
    exact ⟨c, by rw [hspan]; exact hc⟩
  obtain ⟨α, hα⟩ := exists_adjoin_pi_eq_top_of_local t (fun _ => n) hresT htnil
  refine exists_adjoin_eq_top_of_algEquiv ?_ ⟨α, hα⟩
  exact AlgEquiv.restrictScalars k
    (((AlgEquiv.quotientBot B B).symm.trans (Ideal.quotientEquivAlgOfEq B hnil.symm)).trans
      (IsArtinianRing.quotNilradicalPowEquivPi B n))

end Fibre

section Main

variable {R A : Type*} [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [Module.Finite R A]

/-- **Theorem 1, `(2) ⇒ (3)`.**  A module-finite algebra over a local ring with infinite residue
field, separated by a finite family of `R`-points, is monogenic as soon as its Kähler module is
cyclic. -/
theorem exists_adjoin_eq_top_of_kaehler_cyclic [Infinite (R ⧸ maximalIdeal R)]
    {ι : Type*} [Fintype ι] (φ : ι → (A →ₐ[R] R)) (hφ : ∀ x : A, (∀ i, φ i x = 0) → x = 0)
    {ω : Ω[A⁄R]} (hω : Submodule.span A {ω} = ⊤) :
    ∃ θ : A, Algebra.adjoin R ({θ} : Set A) = ⊤ := by
  classical
  letI : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  haveI hfinB : Module.Finite (R ⧸ maximalIdeal R)
      (A ⧸ (maximalIdeal R).map (algebraMap R A)) := by
    haveI : Module.Finite R (A ⧸ (maximalIdeal R).map (algebraMap R A)) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ R _).toLinearMap Ideal.Quotient.mk_surjective
    exact Module.Finite.of_restrictScalars_finite R _ _
  have hresB : ∀ J : Ideal (A ⧸ (maximalIdeal R).map (algebraMap R A)), J.IsMaximal →
      ∀ b, ∃ c : R ⧸ maximalIdeal R,
        b - algebraMap (R ⧸ maximalIdeal R) (A ⧸ (maximalIdeal R).map (algebraMap R A)) c ∈ J := by
    intro J hJ b
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    haveI hJp : J.IsPrime := hJ.isPrime
    haveI : (J.comap (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R A)))).IsPrime :=
      Ideal.IsPrime.comap (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R A)))
    obtain ⟨r, hr⟩ := exists_sub_algebraMap_mem_of_isPrime φ hφ
      (J.comap (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R A)))) a
    refine ⟨algebraMap R (R ⧸ maximalIdeal R) r, ?_⟩
    have hcomm : algebraMap (R ⧸ maximalIdeal R) (A ⧸ (maximalIdeal R).map (algebraMap R A))
        (algebraMap R (R ⧸ maximalIdeal R) r)
          = Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R A)) (algebraMap R A r) := by
      rw [← IsScalarTower.algebraMap_apply R (R ⧸ maximalIdeal R) _]
      rw [IsScalarTower.algebraMap_apply R A (A ⧸ (maximalIdeal R).map (algebraMap R A))]
      rfl
    rw [hcomm, ← map_sub]
    exact hr
  obtain ⟨β, hβ⟩ := exists_adjoin_eq_top_of_kaehler_cyclic_fibre hresB
    (kaehler_cyclic_quotient (maximalIdeal R) hω)
  obtain ⟨θ, rfl⟩ := Ideal.Quotient.mk_surjective β
  refine ⟨θ, adjoin_eq_top_of_adjoin_residual ?_⟩
  intro a
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at hβ
  obtain ⟨q, hq⟩ := hβ (Ideal.Quotient.mk _ a)
  obtain ⟨p, rfl⟩ := Polynomial.map_surjective (algebraMap R (R ⧸ maximalIdeal R))
    Ideal.Quotient.mk_surjective q
  refine ⟨p, ?_⟩
  rw [← Ideal.mk_ker (I := (maximalIdeal R).map (algebraMap R A)), RingHom.mem_ker, map_sub,
    sub_eq_zero]
  rw [Polynomial.aeval_map_algebraMap] at hq
  rw [← hq]
  exact Polynomial.aeval_algHom_apply
    (Ideal.Quotient.mkₐ R ((maximalIdeal R).map (algebraMap R A))) θ p

end Main

