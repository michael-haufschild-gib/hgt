import GaloisForLFunctions.HTGeometry.ConstraintRelativity.FactorFramedTensorJacobian
import GaloisForLFunctions.HTGeometry.DerivedSelectionGeometry.FittingEnergy

/-!
# Exact factor-framed Fitting identity over the tensor order
-/

namespace HTGeometry.ConstraintRelativity

open scoped BigOperators

open GaloisForLFunctions.HTGeometry.DerivedSelection

def factorCyclicPiGen {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    (Fin d → A) →ₗ[A] (∀ i : Fin d, A ⧸ Ideal.span {f i}) where
  toFun x i := Submodule.Quotient.mk (x i)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem factorCyclicPiGen_surjective
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    Function.Surjective (factorCyclicPiGen f) := by
  intro y
  choose x hx using fun i => Submodule.Quotient.mk_surjective _ (y i)
  exact ⟨x, funext hx⟩

theorem factorCyclicPiGen_isRelMatrix_iff
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A)
    (M : Matrix (Fin d) (Fin d) A) :
    IsRelMatrix (factorCyclicPiGen f) M ↔
      ∀ i j, M i j ∈ Ideal.span {f i} := by
  constructor
  · intro h i j
    have hij := congrFun (h j) i
    change Submodule.Quotient.mk (M i j) = 0 at hij
    rwa [Submodule.Quotient.mk_eq_zero] at hij
  · intro h j
    funext i
    change Submodule.Quotient.mk (M i j) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    exact h i j

theorem factorCyclicPiGen_det_mem_prod
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A)
    (M : Matrix (Fin d) (Fin d) A)
    (hM : IsRelMatrix (factorCyclicPiGen f) M) :
    M.det ∈ ∏ i, Ideal.span {f i} := by
  rw [Matrix.det_apply']
  apply Ideal.sum_mem
  intro σ _
  apply Ideal.mul_mem_left
  have hprod : (∏ j, M (σ j) j) ∈ ∏ j, Ideal.span {f (σ j)} := by
    apply Ideal.prod_mem_prod
    intro j _
    exact (factorCyclicPiGen_isRelMatrix_iff f M).mp hM (σ j) j
  have hperm : (∏ j, Ideal.span {f (σ j)}) = ∏ j, Ideal.span {f j} :=
    Equiv.prod_comp (σ : Fin d ≃ Fin d) (fun j => Ideal.span {f j})
  rwa [hperm] at hprod

theorem factorCyclicPiGen_presDetIdeal_eq_prod
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    presDetIdeal (factorCyclicPiGen f) = ∏ i, Ideal.span {f i} := by
  apply le_antisymm
  · exact presDetIdeal_le fun M hM => factorCyclicPiGen_det_mem_prod f M hM
  · rw [Ideal.prod_span]
    apply Ideal.span_le.mpr
    intro x hx
    rw [Set.mem_fintype_prod] at hx
    obtain ⟨g, hg, rfl⟩ := hx
    have hgf : g = f := by
      funext i
      simpa using hg i
    subst g
    let D : Matrix (Fin d) (Fin d) A := Matrix.diagonal f
    have hD : IsRelMatrix (factorCyclicPiGen f) D := by
      rw [factorCyclicPiGen_isRelMatrix_iff]
      intro i j
      by_cases hij : i = j
      · subst j
        simp [D]
      · simp [D, hij]
    simpa [D] using det_mem_presDetIdeal hD

theorem fittingIdealZero_factorCyclicPi
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    fittingIdealZero A (∀ i : Fin d, A ⧸ Ideal.span {f i}) =
      ∏ i, Ideal.span {f i} := by
  rw [fittingIdealZero_eq_presDetIdeal (factorCyclicPiGen_surjective f),
    factorCyclicPiGen_presDetIdeal_eq_prod]

theorem prod_span_singleton_eq_span_prod
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    (∏ i, Ideal.span {f i}) = Ideal.span {∏ i, f i} := by
  rw [Ideal.prod_span]
  apply congrArg Ideal.span
  ext x
  simp only [Set.mem_fintype_prod, Set.mem_singleton_iff]
  constructor
  · rintro ⟨g, hg, rfl⟩
    congr 1
    funext i
    simpa using hg i
  · rintro rfl
    exact ⟨f, fun _ => rfl, rfl⟩

/-- Card `(17)`, heterogeneous form: the factor-cotangent presentation and trace-quotient
presentation have the same zeroth Fitting ideal over the tensor order. -/
theorem factorFramed_fittingIdealZero_source_eq_target
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    fittingIdealZero A (∀ i : Fin d, A ⧸ Ideal.span {f i}) =
      fittingIdealZero A (A ⧸ Ideal.span {∏ i, f i}) := by
  rw [fittingIdealZero_factorCyclicPi, prod_span_singleton_eq_span_prod,
    fittingIdealZero_quotient]

/-- Both exact Fitting ideals are the principal ideal generated by the multiplicative trace
different `F = ∏_i f_i`. -/
theorem factorFramed_fittingIdealZero_eq_span_product
    {A : Type*} [CommRing A] {d : ℕ} (f : Fin d → A) :
    fittingIdealZero A (∀ i : Fin d, A ⧸ Ideal.span {f i}) =
        Ideal.span {∏ i, f i} ∧
      fittingIdealZero A (A ⧸ Ideal.span {∏ i, f i}) =
        Ideal.span {∏ i, f i} := by
  constructor
  · rw [fittingIdealZero_factorCyclicPi, prod_span_singleton_eq_span_prod]
  · exact fittingIdealZero_quotient _

end HTGeometry.ConstraintRelativity
