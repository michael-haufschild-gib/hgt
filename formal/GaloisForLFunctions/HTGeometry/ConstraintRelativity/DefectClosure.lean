import Mathlib

/-!
# Fixed-transformation defect closure does not promote a law

For a monoid `M` of unital algebra endomorphisms of `F` and a unital subalgebra `A ⊆ F`, adjoining
all defects `T f - f` produces exactly the orbit algebra generated by all `T f`:

`Def_M(A) = Orb_M(A)`.

The orbit algebra is the smallest `M`-invariant unital subalgebra containing `A`, so the defect
recursion `A_{α+1} = Def_M(A_α)` stabilizes at the first successor: every transfinite stage from
stage one on equals `Orb_M(A)`.  Taking topological closures changes nothing, because the two
generating families already generate the same subalgebra.

Thus transfinite defect closure can encode resolution length but not the birth of a new operation.
-/

namespace HTGeometry.ConstraintRelativity

variable {k F : Type*} [CommRing k] [Ring F] [Algebra k F]

/-! ## Defect and orbit closures -/

/-- The set of defects `T f - f` for `T` in the monoid and `f` in the subalgebra. -/
def defectSet (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F) : Set F :=
  {x | ∃ T ∈ M, ∃ f ∈ A, x = T f - f}

/-- The set of transported observables `T f`. -/
def orbitSet (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F) : Set F :=
  {x | ∃ T ∈ M, ∃ f ∈ A, x = T f}

/-- The defect closure `Def_M(A)`: the subalgebra generated by `A` together with all defects. -/
def defectClosure (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F) : Subalgebra k F :=
  Algebra.adjoin k ((A : Set F) ∪ defectSet M A)

/-- The orbit closure `Orb_M(A)`: the subalgebra generated by all transported observables. -/
def orbitClosure (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F) : Subalgebra k F :=
  Algebra.adjoin k (orbitSet M A)

variable (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F)

theorem subset_orbitSet : (A : Set F) ⊆ orbitSet M A := fun f hf =>
  ⟨1, M.one_mem, f, hf, rfl⟩

theorem le_orbitClosure : A ≤ orbitClosure M A :=
  le_trans (Algebra.subset_adjoin.trans (Algebra.adjoin_mono (subset_orbitSet M A)) :
      (A : Set F) ⊆ (orbitClosure M A : Set F))
    (le_refl _)

theorem le_defectClosure : A ≤ defectClosure M A := fun _ hf =>
  Algebra.subset_adjoin (Or.inl hf)

/-- **Defect closure equals orbit closure.**  Over an algebra containing `f`, the elements
`T f - f` and `T f` generate the same subalgebra. -/
theorem defectClosure_eq_orbitClosure : defectClosure M A = orbitClosure M A := by
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro x (hx | ⟨T, hT, f, hf, rfl⟩)
    · exact Algebra.subset_adjoin (subset_orbitSet M A hx)
    · exact Subalgebra.sub_mem _ (Algebra.subset_adjoin ⟨T, hT, f, hf, rfl⟩)
        (Algebra.subset_adjoin (subset_orbitSet M A hf))
  · rintro x ⟨T, hT, f, hf, rfl⟩
    have hd : T f - f ∈ defectClosure M A := Algebra.subset_adjoin (Or.inr ⟨T, hT, f, hf, rfl⟩)
    have hf' : f ∈ defectClosure M A := le_defectClosure M A hf
    have : T f = f + (T f - f) := by abel
    rw [this]
    exact Subalgebra.add_mem _ hf' hd

/-! ## Invariance, minimality, idempotence -/

/-- The orbit closure is invariant under the acting monoid. -/
theorem orbitClosure_invariant {T : F →ₐ[k] F} (hT : T ∈ M) {x : F}
    (hx : x ∈ orbitClosure M A) : T x ∈ orbitClosure M A := by
  have hle : orbitClosure M A ≤ Subalgebra.comap T (orbitClosure M A) := by
    refine Algebra.adjoin_le ?_
    rintro y ⟨S, hS, f, hf, rfl⟩
    exact Algebra.subset_adjoin ⟨T * S, M.mul_mem hT hS, f, hf, rfl⟩
  exact hle hx

/-- **Minimality.**  Every `M`-invariant subalgebra containing `A` contains the orbit closure. -/
theorem orbitClosure_le {B : Subalgebra k F} (hAB : A ≤ B)
    (hB : ∀ T ∈ M, ∀ x ∈ B, T x ∈ B) : orbitClosure M A ≤ B := by
  refine Algebra.adjoin_le ?_
  rintro x ⟨T, hT, f, hf, rfl⟩
  exact hB T hT f (hAB hf)

/-- An invariant subalgebra is its own orbit closure. -/
theorem orbitClosure_self_of_invariant {B : Subalgebra k F}
    (hB : ∀ T ∈ M, ∀ x ∈ B, T x ∈ B) : orbitClosure M B = B :=
  le_antisymm (orbitClosure_le M B le_rfl hB) (le_orbitClosure M B)

/-- **Idempotence.**  One defect step applied to the orbit closure changes nothing. -/
theorem defectClosure_orbitClosure :
    defectClosure M (orbitClosure M A) = orbitClosure M A := by
  rw [defectClosure_eq_orbitClosure]
  exact orbitClosure_self_of_invariant M (fun T hT x hx => orbitClosure_invariant M A hT hx)

/-! ## The defect recursion stabilizes at the first successor -/

/-- Finite iteration of the defect closure. -/
def defectIter (M : Submonoid (F →ₐ[k] F)) (A : Subalgebra k F) : ℕ → Subalgebra k F
  | 0 => A
  | n + 1 => defectClosure M (defectIter M A n)

theorem defectIter_succ_eq (n : ℕ) : defectIter M A (n + 1) = orbitClosure M A := by
  induction n with
  | zero => exact defectClosure_eq_orbitClosure M A
  | succ n ih =>
      rw [defectIter, ih]
      exact defectClosure_orbitClosure M A

/-- **Transfinite stabilization.**  Any family satisfying the defect recursion — successor stages
by one defect closure, limit stages by union — is constant from stage one on, with value the orbit
closure. -/
theorem eq_orbitClosure_of_defectRecursion (chain : Ordinal → Subalgebra k F)
    (h0 : chain 0 = A)
    (hsucc : ∀ β, chain (β + 1) = defectClosure M (chain β))
    (hlim : ∀ β, Order.IsSuccLimit β → chain β = ⨆ γ : Set.Iio β, chain γ) :
    ∀ α : Ordinal, 1 ≤ α → chain α = orbitClosure M A := by
  intro α
  induction α using Ordinal.limitRecOn with
  | zero => intro h; exact absurd h (by simp)
  | add_one β ih =>
      intro _
      rcases eq_or_ne β 0 with hβ | hβ
      · subst hβ
        rw [hsucc, h0]
        exact defectClosure_eq_orbitClosure M A
      · rw [hsucc, ih (Order.one_le_iff_ne_zero.2 hβ)]
        exact defectClosure_orbitClosure M A
  | limit β hβ ih =>
      intro _
      have hβ0 : (0 : Ordinal) < β := by
        have hb := bot_lt_iff_ne_bot.2 hβ.ne_bot
        simpa using hb
      have hβ1 : (1 : Ordinal) < β := by
        have hs := hβ.isSuccPrelimit.succ_lt hβ0
        simpa using hs
      rw [hlim β hβ]
      refine le_antisymm (iSup_le ?_) ?_
      · rintro ⟨γ, hγ⟩
        rcases eq_or_ne γ 0 with hγ0 | hγ0
        · subst hγ0
          rw [h0]
          exact le_orbitClosure M A
        · exact le_of_eq (ih γ hγ (Order.one_le_iff_ne_zero.2 hγ0))
      · exact le_trans (le_of_eq (ih 1 hβ1 le_rfl).symm) (le_iSup (fun γ : Set.Iio β => chain γ)
          ⟨1, hβ1⟩)

/-! ## The topological variant -/

/-- **Closures do not change the conclusion.**  If the ambient algebra is topological, the closed
subalgebras generated by the two families still agree, because the underlying subalgebras do. -/
theorem defectClosure_topologicalClosure_eq [TopologicalSpace F] [IsTopologicalSemiring F]
    [ContinuousConstSMul k F] :
    (defectClosure M A).topologicalClosure = (orbitClosure M A).topologicalClosure := by
  rw [defectClosure_eq_orbitClosure]

end HTGeometry.ConstraintRelativity
