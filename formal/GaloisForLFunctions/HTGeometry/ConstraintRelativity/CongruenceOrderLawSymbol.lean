import Mathlib
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.CongruenceOrderFirstOrder
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.SolderingTransportSymbol

/-!
# The law symbol of the diagonal congruence order over a coefficient field

The abstract first-order law symbol is stated for a local algebra over a coefficient field.  The
diagonal congruence order acquires such a field as soon as its base ring does: the sheet algebra is
then a tower over the field, both the cotangent module and the trace-law defect are `𝔪²`-torsion,
and the abstract head layers agree with the closed fibres used in coordinates.

Over a base ring that splits as coefficient field plus the ideal generated by the modulus — the
formal power series `k[[X]]` with modulus `X` is the case the model is built for — every
`k`-linear map of closed fibres is automatically source linear, so the abstract obstruction space
is the matrix algebra on the observer directions over the coefficient field itself.
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

namespace HTGeometry.ConstraintRelativity

open MvPolynomial

/-! ## Restriction of scalars does not change a quotient -/

section RestrictQuotient

variable {k A M : Type*} [Field k] [CommRing A] [Algebra k A]
  [AddCommGroup M] [Module A M] [Module k M] [IsScalarTower k A M]

/-- The quotient by a submodule and by its restriction of scalars are the same `k`-space. -/
def quotientRestrictScalarsEquiv (P : Submodule A M) :
    (M ⧸ P.restrictScalars k) ≃ₗ[k] (M ⧸ P) where
  toFun := id
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl

@[simp] theorem quotientRestrictScalarsEquiv_mk (P : Submodule A M) (x : M) :
    quotientRestrictScalarsEquiv (k := k) P (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk x := rfl

end RestrictQuotient

/-! ## The head layer over a coefficient field -/

section HeadLayerField

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A] (m : Ideal A)
variable {M : Type*} [AddCommGroup M] [Module A M] [Module k M] [IsScalarTower k A M]
variable {N : Type*} [AddCommGroup N] [Module A N] [Module k N] [IsScalarTower k A N]

/-- The abstract head layer is the closed fibre. -/
def headLayerEquiv :
    headLayer (k := k) m M ≃ₗ[k] (M ⧸ (m • (⊤ : Submodule A M))) :=
  quotientRestrictScalarsEquiv _

/-- The maximal ideal kills the closed fibre. -/
theorem smul_quotient_eq_zero {u : A} (hu : u ∈ m)
    (x : M ⧸ (m • (⊤ : Submodule A M))) : u • x = 0 := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  exact Submodule.smul_mem_smul hu Submodule.mem_top

/-- **Coefficient splitting.**  On modules killed by the maximal ideal a `k`-linear map is
automatically `A`-linear: the coefficient field carries the whole action. -/
def toSourceLinear (hsplit : ∀ c : A, ∃ r : k, c - algebraMap k A r ∈ m)
    (f : (M ⧸ (m • (⊤ : Submodule A M))) →ₗ[k] (N ⧸ (m • (⊤ : Submodule A N)))) :
    (M ⧸ (m • (⊤ : Submodule A M))) →ₗ[A] (N ⧸ (m • (⊤ : Submodule A N))) where
  toFun := f
  map_add' := f.map_add
  map_smul' c x := by
    obtain ⟨r, hr⟩ := hsplit c
    have hx : c • x = algebraMap k A r • x := by
      have h0 : (c - algebraMap k A r) • x = 0 := smul_quotient_eq_zero m hr x
      rw [sub_smul, sub_eq_zero] at h0
      exact h0
    have hfx : c • f x = algebraMap k A r • f x := by
      have h0 : (c - algebraMap k A r) • f x = 0 := smul_quotient_eq_zero m hr (f x)
      rw [sub_smul, sub_eq_zero] at h0
      exact h0
    rw [RingHom.id_apply, hx, hfx, algebraMap_smul, algebraMap_smul, map_smul]

/-- **Coefficient splitting.**  Source-linear and `k`-linear maps of closed fibres agree. -/
def homFibreEquiv (hsplit : ∀ c : A, ∃ r : k, c - algebraMap k A r ∈ m) :
    ((M ⧸ (m • (⊤ : Submodule A M))) →ₗ[k] (N ⧸ (m • (⊤ : Submodule A N))))
      ≃ₗ[k] ((M ⧸ (m • (⊤ : Submodule A M))) →ₗ[A] (N ⧸ (m • (⊤ : Submodule A N)))) where
  toFun f := toSourceLinear m hsplit f
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun φ := φ.restrictScalars k
  left_inv _ := rfl
  right_inv _ := rfl

end HeadLayerField

/-! ## The congruence order over a coefficient field -/

section CongruenceField

variable {k R : Type*} [Field k] [CommRing R] [Algebra k R] {a : R} {m : ℕ}

/-- The sheet algebra is a tower over the coefficient field. -/
instance congruencePiFieldTower :
    IsScalarTower k (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) :=
  IsScalarTower.to₁₃₄ k R (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)

variable [IsDomain R] [Invertible (2 : R)] [Invertible ((m : R) + 1)] [Invertible ((m : R) - 1)]

omit [Invertible ((m : R) + 1)] [Invertible ((m : R) - 1)] in
/-- **Card `(9)` for the concrete model.**  The cotangent module of the congruence order is
`𝔪²`-torsion in the pointwise form the symbol needs. -/
theorem kaehler_sq_smul (ha : a ≠ 0)
    (u v : MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
    (hu : u ∈ maximalIdealA a m) (hv : v ∈ maximalIdealA a m)
    (x : Ω[(MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)⁄R]) : u • v • x = 0 := by
  have hmem : u • v • x ∈ (maximalIdealA a m) • ((maximalIdealA a m) •
      (⊤ : Submodule (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
        Ω[(MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)⁄R])) :=
    Submodule.smul_mem_smul hu (Submodule.smul_mem_smul hv Submodule.mem_top)
  rwa [maximalIdealSq_smul_kaehler ha, Submodule.mem_bot] at hmem

omit [IsDomain R] [Invertible (2 : R)] [Invertible ((m : R) - 1)] in
/-- **Card `(9)` for the concrete model.**  The trace-law defect is `𝔪²`-torsion in the pointwise
form the symbol needs. -/
theorem traceDefect_sq_smul
    (u v : MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
    (hu : u ∈ maximalIdealA a m) (hv : v ∈ maximalIdealA a m)
    (x : traceDefect a m) : u • v • x = 0 := by
  have hmem : u • v • x ∈ (maximalIdealA a m) • ((maximalIdealA a m) •
      (⊤ : Submodule (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (traceDefect a m))) :=
    Submodule.smul_mem_smul hu (Submodule.smul_mem_smul hv Submodule.mem_top)
  rwa [maximalIdealSq_smul_traceDefect, Submodule.mem_bot] at hmem

end CongruenceField

end HTGeometry.ConstraintRelativity
