import Mathlib
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.CongruenceOrderResidueHom

/-!
# The Kähler different of the diagonal congruence order

The cotangent module of the diagonal congruence order is presented by the `m` differentials
`dxᵢ` subject to the differentiated relations, so its zeroth Fitting ideal is generated by the
`m × m` minors of the relation matrix.  Every entry of a relation lies in `a·O`, so every minor
lies in `aᵐ·O`; conversely explicit minors produce all of `aᵐ·O`.
-/

namespace HTGeometry.ConstraintRelativity

open MvPolynomial

section Sheets

variable {R : Type*} [CommRing R] (a : R) (m : ℕ)

/-- The ideal `aⁿ·O` of the congruence order, described through the presentation. -/
noncomputable def sheetPow (a : R) (m : ℕ) (n : ℕ) :
    Ideal (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) where
  carrier := {c | ∃ z : Fin (m + 1) → R,
    algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) c = a ^ n • z}
  add_mem' := by
    rintro x y ⟨z, hz⟩ ⟨w, hw⟩
    exact ⟨z + w, by rw [map_add, hz, hw, smul_add]⟩
  zero_mem' := ⟨0, by rw [map_zero, smul_zero]⟩
  smul_mem' c x := by
    rintro ⟨z, hz⟩
    refine ⟨algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) c * z, ?_⟩
    rw [smul_eq_mul, map_mul, hz, mul_smul_comm]

variable {a m}

theorem mem_sheetPow {n : ℕ} {c : MvPolynomial (Fin m) R ⧸ congruenceIdeal a m} :
    c ∈ sheetPow a m n ↔ ∃ z : Fin (m + 1) → R,
      algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) c
        = a ^ n • z := Iff.rfl

theorem mul_mem_sheetPow {p q : ℕ} {x y : MvPolynomial (Fin m) R ⧸ congruenceIdeal a m}
    (hx : x ∈ sheetPow a m p) (hy : y ∈ sheetPow a m q) :
    x * y ∈ sheetPow a m (p + q) := by
  obtain ⟨z, hz⟩ := hx
  obtain ⟨w, hw⟩ := hy
  refine ⟨z * w, ?_⟩
  rw [map_mul, hz, hw]
  funext l
  show a ^ p * z l * (a ^ q * w l) = a ^ (p + q) * (z l * w l)
  ring

theorem one_mem_sheetPow_zero : (1 : MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
    ∈ sheetPow a m 0 := ⟨1, by rw [map_one, pow_zero, one_smul]⟩

theorem prod_mem_sheetPow {ι : Type*} (s : Finset ι)
    (f : ι → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
    (hf : ∀ i ∈ s, f i ∈ sheetPow a m 1) : (∏ i ∈ s, f i) ∈ sheetPow a m s.card := by
  classical
  induction s using Finset.induction with
  | empty => simpa using (one_mem_sheetPow_zero (a := a) (m := m))
  | insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.card_insert_of_notMem hi, add_comm s.card 1]
    exact mul_mem_sheetPow (hf i (Finset.mem_insert_self i s))
      (ih fun j hj => hf j (Finset.mem_insert_of_mem hj))

theorem det_mem_sheetPow (M : Matrix (Fin m) (Fin m) (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m))
    (hM : ∀ l k, M l k ∈ sheetPow a m 1) : M.det ∈ sheetPow a m m := by
  classical
  rw [Matrix.det_apply']
  refine Ideal.sum_mem _ fun σ _ => Ideal.mul_mem_left _ _ ?_
  have h := prod_mem_sheetPow (a := a) (m := m) Finset.univ (fun l => M (σ l) l)
    fun l _ => hM _ _
  rwa [Finset.card_univ, Fintype.card_fin] at h

theorem congruenceX_mem_sheetPow_one (i : Fin m) : congruenceX a m i ∈ sheetPow a m 1 := by
  refine ⟨Pi.single i.castSucc 1, ?_⟩
  rw [algebraMap_congruenceX, congruenceGen, pow_one]

theorem algebraMap_a_mem_sheetPow_one :
    algebraMap R (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) a ∈ sheetPow a m 1 := by
  refine ⟨1, ?_⟩
  rw [← IsScalarTower.algebraMap_apply, pow_one, Algebra.algebraMap_eq_smul_one]

theorem kaehlerRelations_entry_mem
    {w : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m}
    (hw : w ∈ kaehlerRelations a m) (l : Fin m) : w l ∈ sheetPow a m 1 := by
  classical
  rw [kaehlerRelations] at hw
  induction hw using Submodule.span_induction with
  | mem y hy =>
    rcases hy with ⟨i, rfl⟩ | ⟨i, j, _, rfl⟩
    · by_cases h : l = i
      · rw [h, Pi.single_eq_same]
        exact sub_mem (add_mem (congruenceX_mem_sheetPow_one i) (congruenceX_mem_sheetPow_one i))
          algebraMap_a_mem_sheetPow_one
      · rw [Pi.single_eq_of_ne h]
        exact zero_mem _
    · show (Pi.single i (congruenceX a m j) + Pi.single j (congruenceX a m i)
        : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) l ∈ _
      refine add_mem ?_ ?_
      · by_cases h : l = i
        · rw [h, Pi.single_eq_same]; exact congruenceX_mem_sheetPow_one j
        · rw [Pi.single_eq_of_ne h]; exact zero_mem _
      · by_cases h : l = j
        · rw [h, Pi.single_eq_same]; exact congruenceX_mem_sheetPow_one i
        · rw [Pi.single_eq_of_ne h]; exact zero_mem _
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | smul c x _ hx => exact Ideal.mul_mem_left _ _ hx

variable (a m)

/-- The zeroth Fitting ideal of the cotangent module, computed from the canonical presentation
by the differentials of the source generators. -/
noncomputable def kaehlerFittingIdeal (a : R) (m : ℕ) :
    Ideal (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) :=
  Ideal.span {d | ∃ w : Fin m → ↥(kaehlerRelations a m),
    d = Matrix.det (Matrix.of fun l k => ((w k : Fin m → _) l))}

variable {a m}

/-- **Card `(26l)`, upper bound.**  Every maximal minor of the relation matrix lies in `aᵐ·O`. -/
theorem kaehlerFittingIdeal_le_sheetPow :
    kaehlerFittingIdeal a m ≤ sheetPow a m m := by
  rw [kaehlerFittingIdeal, Ideal.span_le]
  rintro d ⟨w, rfl⟩
  exact det_mem_sheetPow _ fun l k => kaehlerRelations_entry_mem (w k).2 l

/-! ## The two explicit minors -/

/-- The coefficient of the differentiated square relation. -/
noncomputable def sqCoeff (a : R) (m : ℕ) (k : Fin m) :
    MvPolynomial (Fin m) R ⧸ congruenceIdeal a m :=
  congruenceX a m k + congruenceX a m k
    - algebraMap R (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) a

theorem sqRelation_eq_single (k : Fin m) :
    sqRelation a m k = Pi.single k (sqCoeff a m k) := rfl

theorem sqRelation_apply (k l : Fin m) :
    (sqRelation a m k : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) l
      = Matrix.diagonal (sqCoeff a m) l k := by
  classical
  rw [sqRelation_eq_single, Matrix.diagonal_apply, Pi.single_apply]
  by_cases h : l = k
  · rw [if_pos h, if_pos h, h]
  · rw [if_neg h, if_neg h]

/-- The all-square family of relations. -/
noncomputable def sqFamily (a : R) (m : ℕ) (k : Fin m) : ↥(kaehlerRelations a m) :=
  ⟨sqRelation a m k, Submodule.subset_span (sqRelation_mem k)⟩

/-- The family of relations giving the mixed minor. -/
noncomputable def mixedFamily {i j : Fin m} (hij : i ≠ j) (k : Fin m) :
    ↥(kaehlerRelations a m) :=
  if k = i then ⟨crossRelation a m i j, Submodule.subset_span (crossRelation_mem hij)⟩
    else ⟨sqRelation a m k, Submodule.subset_span (sqRelation_mem k)⟩

theorem mixedFamily_coe {i j : Fin m} (hij : i ≠ j) (k : Fin m) :
    ((mixedFamily hij k : ↥(kaehlerRelations a m))
        : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
      = if k = i then crossRelation a m i j else sqRelation a m k := by
  rw [mixedFamily]
  exact apply_ite (fun v : ↥(kaehlerRelations a m) =>
    (v : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)) (k = i) _ _

/-- **Card `(26o)`.**  The all-square minor of the relation matrix. -/
theorem prod_sqCoeff_mem_fitting :
    (∏ k : Fin m, sqCoeff a m k) ∈ kaehlerFittingIdeal a m := by
  classical
  refine Ideal.subset_span ⟨sqFamily a m, ?_⟩
  have hmat : (Matrix.of fun l k => ((sqFamily a m k :
      ↥(kaehlerRelations a m)) : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) l)
      = Matrix.diagonal (sqCoeff a m) := by
    funext l k
    exact sqRelation_apply k l
  rw [hmat, Matrix.det_diagonal]

/-- **Card `(26n)`.**  The mixed minor of the relation matrix. -/
theorem mixed_mem_fitting {i j : Fin m} (hij : i ≠ j) :
    congruenceX a m j * (∏ k ∈ Finset.univ.erase i, sqCoeff a m k)
      ∈ kaehlerFittingIdeal a m := by
  classical
  refine Ideal.subset_span ⟨mixedFamily hij, ?_⟩
  have hmat : (Matrix.of fun l k => ((mixedFamily hij k :
      ↥(kaehlerRelations a m)) : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) l)
      = Matrix.updateCol (Matrix.diagonal (sqCoeff a m)) i
          ((Pi.single i (congruenceX a m j) + Pi.single j (congruenceX a m i)
            : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)) := by
    funext l k
    show ((mixedFamily hij k : ↥(kaehlerRelations a m))
      : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) l = _
    rw [mixedFamily_coe, Matrix.updateCol_apply]
    by_cases h : k = i
    · rw [if_pos h, if_pos h]
      rfl
    · rw [if_neg h, if_neg h]
      exact sqRelation_apply k l
  rw [hmat, Matrix.det_updateCol_add]
  have hzero : (Matrix.updateCol (Matrix.diagonal (sqCoeff a m)) i
      (Pi.single j (congruenceX a m i)
        : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)).det = 0 := by
    refine Matrix.det_eq_zero_of_row_eq_zero i fun k => ?_
    rw [Matrix.updateCol_apply]
    by_cases h : k = i
    · rw [if_pos h, Pi.single_eq_of_ne hij]
    · rw [if_neg h, Matrix.diagonal_apply, if_neg (Ne.symm h)]
  have hdiag : Matrix.updateCol (Matrix.diagonal (sqCoeff a m)) i
      (Pi.single i (congruenceX a m j)
        : Fin m → MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
      = Matrix.diagonal (Function.update (sqCoeff a m) i (congruenceX a m j)) := by
    funext l k
    simp only [Matrix.updateCol_apply, Matrix.diagonal_apply, Pi.single_apply]
    by_cases h : k = i
    · subst h
      rw [if_pos rfl]
      by_cases h2 : l = k
      · rw [if_pos h2, if_pos h2, h2, Function.update_self]
      · rw [if_neg h2, if_neg h2]
    · rw [if_neg h]
      by_cases h2 : l = k
      · rw [if_pos h2, if_pos h2, h2, Function.update_of_ne h]
      · rw [if_neg h2, if_neg h2]
  rw [hzero, hdiag, Matrix.det_diagonal, add_zero,
    Finset.prod_update_of_mem (Finset.mem_univ i), Finset.erase_eq]

/-! ## Images of the minors in the sheet algebra -/

theorem algebraMap_congruenceX_apply (j : Fin m) (l : Fin (m + 1)) :
    algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (congruenceX a m j) l
      = a * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) l := by
  rw [algebraMap_congruenceX]
  rfl

theorem algebraMap_sqCoeff (k : Fin m) (l : Fin (m + 1)) :
    algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (sqCoeff a m k) l
      = a * (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l - 1) := by
  rw [sqCoeff, map_sub, map_add]
  show algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
      (congruenceX a m k) l
      + algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (congruenceX a m k) l
      - algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (algebraMap R _ a) l = _
  rw [algebraMap_congruenceX_apply, ← IsScalarTower.algebraMap_apply]
  show a * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l
    + a * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l - a = _
  ring

theorem algebraMap_prod_sqCoeff (s : Finset (Fin m)) (l : Fin (m + 1)) :
    algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (∏ k ∈ s, sqCoeff a m k) l
      = a ^ s.card * ∏ k ∈ s, (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l - 1) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.prod_insert hi, Finset.card_insert_of_notMem hi, map_mul]
    show algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (sqCoeff a m i) l
      * algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
        (∏ k ∈ s, sqCoeff a m k) l = _
    rw [algebraMap_sqCoeff, ih, pow_succ]
    ring

theorem prod_delta_castSucc (s : Finset (Fin m)) (j : Fin m) (hj : j ∈ s) :
    (∏ k ∈ s, (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) j.castSucc - 1))
      = (-1 : R) ^ (s.erase j).card := by
  classical
  rw [← Finset.mul_prod_erase s _ hj]
  have hj1 : (2 * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) j.castSucc - 1) = 1 := by
    rw [Pi.single_eq_same]
    ring
  rw [hj1, one_mul]
  refine (Finset.prod_congr rfl fun k hk => ?_).trans (Finset.prod_const _)
  have hkj : k ≠ j := (Finset.mem_erase.1 hk).1
  rw [Pi.single_eq_of_ne (fun hc => hkj (Fin.castSucc_injective m hc).symm)]
  ring

theorem prod_delta_last (s : Finset (Fin m)) :
    (∏ k ∈ s, (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) (Fin.last m) - 1))
      = (-1 : R) ^ s.card := by
  refine (Finset.prod_congr rfl fun k _ => ?_).trans (Finset.prod_const _)
  rw [Pi.single_eq_of_ne (Fin.castSucc_lt_last k).ne']
  ring

theorem neg_one_pow_mul_self (c : ℕ) : ((-1 : R) ^ c) * ((-1 : R) ^ c) = 1 := by
  rw [← pow_add, ← two_mul, pow_mul]
  norm_num

/-! ## The Kähler different -/

variable [IsDomain R]

theorem congruenceEvalQuot_injective (ha : a ≠ 0) :
    Function.Injective (algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m)
      (Fin (m + 1) → R)) := by
  rw [injective_iff_map_eq_zero]
  intro c hc
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective c
  rw [algebraMap_congruencePi_mk] at hc
  have hp : p ∈ RingHom.ker (congruenceEval a m) := hc
  rw [ker_congruenceEval ha] at hp
  exact Ideal.Quotient.eq_zero_iff_mem.2 hp

omit [IsDomain R] in
theorem exists_sheet_basis_castSucc (hm : 2 ≤ m) (j : Fin m) :
    ∃ E ∈ kaehlerFittingIdeal a m,
      algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) E
        = a ^ m • (Pi.single j.castSucc 1 : Fin (m + 1) → R) := by
  classical
  haveI : Nontrivial (Fin m) := ⟨⟨⟨0, by omega⟩, ⟨1, by omega⟩, by simp [Fin.ext_iff]⟩⟩
  obtain ⟨i, hi⟩ := exists_ne j
  set c : ℕ := ((Finset.univ.erase i).erase j).card with hcdef
  have hcard : (Finset.univ.erase i : Finset (Fin m)).card = m - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ i), Finset.card_univ, Fintype.card_fin]
  have hjmem : j ∈ (Finset.univ.erase i : Finset (Fin m)) :=
    Finset.mem_erase.2 ⟨Ne.symm hi, Finset.mem_univ j⟩
  refine ⟨algebraMap R _ ((-1 : R) ^ c) * (congruenceX a m j
      * ∏ k ∈ Finset.univ.erase i, sqCoeff a m k),
    Ideal.mul_mem_left _ _ (mixed_mem_fitting hi), ?_⟩
  funext l
  have hlhs : algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
      (algebraMap R _ ((-1 : R) ^ c)
        * (congruenceX a m j * ∏ k ∈ Finset.univ.erase i, sqCoeff a m k)) l
      = (-1 : R) ^ c * (a * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) l
        * (a ^ (Finset.univ.erase i : Finset (Fin m)).card
          * ∏ k ∈ Finset.univ.erase i,
            (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l - 1))) := by
    rw [map_mul, map_mul, ← IsScalarTower.algebraMap_apply]
    show algebraMap R (Fin (m + 1) → R) ((-1 : R) ^ c) l
      * (algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
          (congruenceX a m j) l
        * algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
          (∏ k ∈ Finset.univ.erase i, sqCoeff a m k) l) = _
    rw [algebraMap_congruenceX_apply, algebraMap_prod_sqCoeff]
    rfl
  rw [hlhs]
  show _ = a ^ m * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) l
  by_cases hl : l = j.castSucc
  · rw [hl, Pi.single_eq_same, prod_delta_castSucc _ j hjmem, hcard, ← hcdef]
    have hpow : a * a ^ (m - 1) = a ^ m := by
      rw [← pow_succ']
      congr 1
      omega
    have hsq := neg_one_pow_mul_self (R := R) c
    calc (-1 : R) ^ c * (a * 1 * (a ^ (m - 1) * (-1) ^ c))
        = ((-1 : R) ^ c * (-1) ^ c) * (a * a ^ (m - 1)) := by ring
      _ = 1 * a ^ m := by rw [hsq, hpow]
      _ = a ^ m * 1 := by ring
  · rw [Pi.single_eq_of_ne hl]
    ring

omit [IsDomain R] in
theorem exists_sheet_basis_last (hm : 2 ≤ m) :
    ∃ E ∈ kaehlerFittingIdeal a m,
      algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) E
        = a ^ m • (Pi.single (Fin.last m) 1 : Fin (m + 1) → R) := by
  classical
  choose E hE hEval using fun j : Fin m => exists_sheet_basis_castSucc (a := a) (m := m) hm j
  refine ⟨algebraMap R _ ((-1 : R) ^ m) * (∏ k : Fin m, sqCoeff a m k) + ∑ j, E j,
    add_mem (Ideal.mul_mem_left _ _ prod_sqCoeff_mem_fitting)
      (Ideal.sum_mem _ fun j _ => hE j), ?_⟩
  funext l
  have hlhs : algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
      (algebraMap R _ ((-1 : R) ^ m) * (∏ k : Fin m, sqCoeff a m k) + ∑ j, E j) l
      = (-1 : R) ^ m * (a ^ (Finset.univ : Finset (Fin m)).card
          * ∏ k : Fin m, (2 * (Pi.single k.castSucc (1 : R) : Fin (m + 1) → R) l - 1))
        + ∑ j : Fin m, a ^ m * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) l := by
    rw [map_add, map_mul, map_sum, ← IsScalarTower.algebraMap_apply]
    show algebraMap R (Fin (m + 1) → R) ((-1 : R) ^ m) l
        * algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
          (∏ k : Fin m, sqCoeff a m k) l
        + (∑ j, algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
          (E j)) l = _
    rw [algebraMap_prod_sqCoeff, Finset.sum_apply]
    refine congrArg₂ (· + ·) rfl (Finset.sum_congr rfl fun j _ => ?_)
    rw [hEval j]
    rfl
  rw [hlhs]
  show _ = a ^ m * (Pi.single (Fin.last m) (1 : R) : Fin (m + 1) → R) l
  have hcardu : (Finset.univ : Finset (Fin m)).card = m := by
    rw [Finset.card_univ, Fintype.card_fin]
  induction l using Fin.lastCases with
  | last =>
    rw [prod_delta_last, hcardu, Pi.single_eq_same]
    have hzero : ∑ j : Fin m,
        a ^ m * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) (Fin.last m) = 0 := by
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [Pi.single_eq_of_ne (Fin.castSucc_lt_last j).ne', mul_zero]
    rw [hzero, add_zero]
    have hsq := neg_one_pow_mul_self (R := R) m
    calc (-1 : R) ^ m * (a ^ m * (-1) ^ m)
        = ((-1 : R) ^ m * (-1) ^ m) * a ^ m := by ring
      _ = a ^ m * 1 := by rw [hsq]; ring
  | cast j₀ =>
    rw [prod_delta_castSucc _ j₀ (Finset.mem_univ j₀), hcardu,
      Pi.single_eq_of_ne (Fin.castSucc_lt_last j₀).ne]
    have hone : ∑ j : Fin m,
        a ^ m * (Pi.single j.castSucc (1 : R) : Fin (m + 1) → R) j₀.castSucc = a ^ m := by
      rw [Finset.sum_eq_single j₀]
      · rw [Pi.single_eq_same, mul_one]
      · intro j _ hj
        rw [Pi.single_eq_of_ne (fun hc => hj (Fin.castSucc_injective m hc).symm), mul_zero]
      · intro h
        exact absurd (Finset.mem_univ j₀) h
    have hcarderase : (Finset.univ.erase j₀ : Finset (Fin m)).card = m - 1 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ j₀), Finset.card_univ, Fintype.card_fin]
    rw [hone, hcarderase]
    have hmsucc : (m - 1) + 1 = m := by omega
    have hpow : (-1 : R) ^ m * (-1) ^ (m - 1) = -1 := by
      rw [← hmsucc, pow_succ]
      have := neg_one_pow_mul_self (R := R) (m - 1)
      calc (-1 : R) ^ (m - 1) * (-1) * (-1) ^ (m - 1)
          = ((-1 : R) ^ (m - 1) * (-1) ^ (m - 1)) * (-1) := by ring
        _ = -1 := by rw [this]; ring
    calc (-1 : R) ^ m * (a ^ m * (-1) ^ (m - 1)) + a ^ m
        = ((-1 : R) ^ m * (-1) ^ (m - 1)) * a ^ m + a ^ m := by ring
      _ = (-1 : R) * a ^ m + a ^ m := by rw [hpow]
      _ = a ^ m * 0 := by ring

omit [IsDomain R] in
theorem exists_sheet_basis (hm : 2 ≤ m) (l : Fin (m + 1)) :
    ∃ E ∈ kaehlerFittingIdeal a m,
      algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) E
        = a ^ m • (Pi.single l 1 : Fin (m + 1) → R) := by
  induction l using Fin.lastCases with
  | last => exact exists_sheet_basis_last hm
  | cast j => exact exists_sheet_basis_castSucc hm j

theorem sheetPow_le_kaehlerFittingIdeal (ha : a ≠ 0) (hm : 2 ≤ m) :
    sheetPow a m m ≤ kaehlerFittingIdeal a m := by
  classical
  choose E hE hEval using fun l : Fin (m + 1) =>
    exists_sheet_basis (a := a) (m := m) hm l
  intro c hc
  obtain ⟨z, hz⟩ := hc
  have hceq : c = ∑ l, algebraMap R (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (z l) * E l := by
    refine congruenceEvalQuot_injective ha ?_
    rw [hz, map_sum]
    funext x
    rw [Finset.sum_apply]
    have hterm : ∀ l : Fin (m + 1),
        algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R)
          (algebraMap R _ (z l) * E l) x
        = z l * (a ^ m * (Pi.single l (1 : R) : Fin (m + 1) → R) x) := by
      intro l
      rw [map_mul, ← IsScalarTower.algebraMap_apply]
      show algebraMap R (Fin (m + 1) → R) (z l) x
        * algebraMap (MvPolynomial (Fin m) R ⧸ congruenceIdeal a m) (Fin (m + 1) → R) (E l) x = _
      rw [hEval l]
      rfl
    rw [Finset.sum_congr rfl fun l (_ : l ∈ Finset.univ) => hterm l]
    show a ^ m * z x = _
    rw [Finset.sum_eq_single x]
    · rw [Pi.single_eq_same]
      ring
    · intro l _ hl
      rw [Pi.single_eq_of_ne (Ne.symm hl)]
      ring
    · intro h
      exact absurd (Finset.mem_univ x) h
  rw [hceq]
  exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (hE l)

/-- **Card `(26l)`.**  The Kähler different of the diagonal congruence order, that is the zeroth
Fitting ideal of its cotangent module, is `aᵐ·O`. -/
theorem kaehlerFittingIdeal_eq (ha : a ≠ 0) (hm : 2 ≤ m) :
    kaehlerFittingIdeal a m = sheetPow a m m :=
  le_antisymm kaehlerFittingIdeal_le_sheetPow (sheetPow_le_kaehlerFittingIdeal ha hm)

