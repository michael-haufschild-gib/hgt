import Mathlib

/-!
# Kähler differentials of a monogenic algebra

For a commutative ring `R` and `f : R[X]`, the module of relative differentials of
`S = R[X]/(f)` is the cyclic `S`-module generated by `dα` with the single relation `f'(α) dα = 0`:

`Ω[S⁄R] ≅ S / (f'(α))`.

The construction is the universal property: the assignment `g(α) ↦ g'(α) mod f'(α)` is a
well-defined `R`-derivation, and it is initial among derivations because every derivation `D`
satisfies `D(g(α)) = g'(α) D(α)`.

This is the local normal form used by every law-discriminant card: the annihilator of `Ω[S⁄R]` is
the different ideal `(f'(α))`, whose norm is the discriminant.
-/

namespace HTGeometry.ConstraintRelativity

open Polynomial

variable {R : Type*} [CommRing R] (f : R[X])

/-! ## The different element and the candidate module -/

/-- The different element `f'(α)` of the monogenic algebra `R[X]/(f)`. -/
noncomputable def rootDifferent : AdjoinRoot f := AdjoinRoot.mk f (derivative f)

theorem rootDifferent_eq_aeval :
    rootDifferent f = aeval (AdjoinRoot.root f) (derivative f) :=
  (AdjoinRoot.aeval_eq _).symm

/-- The module structure on the cyclic quotient is multiplication. -/
theorem quot_smul (s t : AdjoinRoot f) :
    s • (Ideal.Quotient.mk (Ideal.span {rootDifferent f}) t)
      = Ideal.Quotient.mk (Ideal.span {rootDifferent f}) (s * t) := rfl

/-- The candidate module `S/(f'(α))`. -/
abbrev MonogenicOmega : Type _ := AdjoinRoot f ⧸ Ideal.span {rootDifferent f}

/-! ## The canonical derivation -/

theorem monogenicDeriv_wd {a b : R[X]} (hab : a - b ∈ Ideal.span {f}) :
    (Ideal.Quotient.mk (Ideal.span {rootDifferent f}) (AdjoinRoot.mk f (derivative a)))
      = Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative b)) := by
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.1 hab
  rw [Ideal.Quotient.eq, ← map_sub, ← derivative_sub, ← hq]
  refine Ideal.mem_span_singleton'.2 ⟨AdjoinRoot.mk f q, ?_⟩
  rw [derivative_mul, map_add, map_mul, map_mul, AdjoinRoot.mk_self, mul_zero, zero_add,
    rootDifferent]

/-- The canonical `R`-derivation `S → S/(f'(α))`, `g(α) ↦ g'(α)`. -/
noncomputable def monogenicDeriv : Derivation R (AdjoinRoot f) (MonogenicOmega f) where
  toFun s := Quotient.liftOn' s
    (fun p : R[X] => Ideal.Quotient.mk (Ideal.span {rootDifferent f})
      (AdjoinRoot.mk f (derivative p)))
    (fun _ _ hab => monogenicDeriv_wd f (by simpa [Submodule.quotientRel_def] using hab))
  map_add' := by
    intro x y
    induction x using AdjoinRoot.induction_on with
    | ih p =>
      induction y using AdjoinRoot.induction_on with
      | ih q =>
        show Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative (p + q))) = _
        rw [derivative_add, map_add, map_add]
        rfl
  map_smul' := by
    intro r x
    induction x using AdjoinRoot.induction_on with
    | ih p =>
      have hsmul : r • AdjoinRoot.mk f p = AdjoinRoot.mk f (C r * p) := by
        rw [Algebra.smul_def, AdjoinRoot.algebraMap_eq, map_mul, AdjoinRoot.mk_C]
      rw [hsmul]
      show Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative (C r * p))) = _
      rw [derivative_C_mul, map_mul, AdjoinRoot.mk_C]
      show _ = r • Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative p))
      rw [Algebra.smul_def]
      rfl
  map_one_eq_zero' := by
    show Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative 1)) = 0
    simp
  leibniz' := by
    intro x y
    induction x using AdjoinRoot.induction_on with
    | ih p =>
      induction y using AdjoinRoot.induction_on with
      | ih q =>
        show Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative (p * q))) = _
        rw [derivative_mul, map_add, map_mul, map_mul, map_add]
        show _ = AdjoinRoot.mk f p • Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative q))
          + AdjoinRoot.mk f q • Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative p))
        rw [quot_smul, quot_smul, add_comm, mul_comm (AdjoinRoot.mk f q)]

@[simp]
theorem monogenicDeriv_mk (p : R[X]) :
    monogenicDeriv f (AdjoinRoot.mk f p)
      = Ideal.Quotient.mk (Ideal.span {rootDifferent f}) (AdjoinRoot.mk f (derivative p)) := rfl

@[simp]
theorem monogenicDeriv_root :
    monogenicDeriv f (AdjoinRoot.root f) = Ideal.Quotient.mk _ 1 := by
  have hroot : AdjoinRoot.root f = AdjoinRoot.mk f X := rfl
  rw [hroot, monogenicDeriv_mk]
  simp

/-! ## The different kills the differential of the generator -/

theorem rootDifferent_smul_D :
    rootDifferent f • KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.root f) = 0 := by
  have hzero : KaehlerDifferential.D R (AdjoinRoot f) (aeval (AdjoinRoot.root f) f) = 0 := by
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
  rw [rootDifferent_eq_aeval, ← Derivation.map_aeval]
  exact hzero

/-- The map `S/(f'(α)) → Ω[S⁄R]` sending the class of `1` to `dα`. -/
noncomputable def monogenicToKaehler :
    MonogenicOmega f →ₗ[AdjoinRoot f] Ω[AdjoinRoot f⁄R] :=
  Submodule.liftQ _
    (LinearMap.toSpanSingleton (AdjoinRoot f) _
      (KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.root f)))
    (by
      rw [Ideal.span_le]
      rintro _ rfl
      simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      exact rootDifferent_smul_D f)

@[simp]
theorem monogenicToKaehler_mk (s : AdjoinRoot f) :
    monogenicToKaehler f (Ideal.Quotient.mk _ s)
      = s • KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.root f) := rfl

/-! ## The two maps are mutually inverse -/

theorem kaehler_comp_monogenic :
    (monogenicDeriv f).liftKaehlerDifferential.comp (monogenicToKaehler f)
      = LinearMap.id := by
  refine LinearMap.ext fun x => ?_
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [LinearMap.comp_apply, monogenicToKaehler_mk, map_smul,
    Derivation.liftKaehlerDifferential_comp_D, monogenicDeriv_root, LinearMap.id_apply]
  show s • Ideal.Quotient.mk (Ideal.span {rootDifferent f}) 1 = _
  rw [Algebra.smul_def]
  simp

theorem monogenic_comp_kaehler :
    (monogenicToKaehler f).comp (monogenicDeriv f).liftKaehlerDifferential
      = LinearMap.id := by
  refine Derivation.liftKaehlerDifferential_unique _ _ ?_
  refine Derivation.ext fun s => ?_
  induction s using AdjoinRoot.induction_on with
  | ih p =>
    show monogenicToKaehler f ((monogenicDeriv f).liftKaehlerDifferential
      (KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.mk f p)))
      = KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.mk f p)
    rw [Derivation.liftKaehlerDifferential_comp_D, monogenicDeriv_mk, monogenicToKaehler_mk]
    have hp : AdjoinRoot.mk f p = aeval (AdjoinRoot.root f) p := (AdjoinRoot.aeval_eq p).symm
    have hdp : AdjoinRoot.mk f (derivative p) = aeval (AdjoinRoot.root f) (derivative p) :=
      (AdjoinRoot.aeval_eq _).symm
    rw [hp, hdp, ← Derivation.map_aeval]

/-- **Kähler differentials of a monogenic algebra.**  `Ω[R[X]/(f) ⁄ R] ≅ R[X]/(f, f'(α))`, the
cyclic module generated by `dα` with the single relation `f'(α) dα = 0`. -/
noncomputable def kaehlerEquivMonogenic :
    Ω[AdjoinRoot f⁄R] ≃ₗ[AdjoinRoot f] MonogenicOmega f :=
  LinearEquiv.ofLinear (monogenicDeriv f).liftKaehlerDifferential (monogenicToKaehler f)
    (kaehler_comp_monogenic f) (monogenic_comp_kaehler f)

@[simp]
theorem kaehlerEquivMonogenic_D (p : R[X]) :
    kaehlerEquivMonogenic f (KaehlerDifferential.D R (AdjoinRoot f) (AdjoinRoot.mk f p))
      = Ideal.Quotient.mk _ (AdjoinRoot.mk f (derivative p)) := by
  show (monogenicDeriv f).liftKaehlerDifferential _ = _
  rw [Derivation.liftKaehlerDifferential_comp_D, monogenicDeriv_mk]

/-! ## The annihilator is the different ideal -/

/-- The annihilator of a cyclic quotient is the defining ideal. -/
theorem annihilator_monogenicOmega :
    Module.annihilator (AdjoinRoot f) (MonogenicOmega f) = Ideal.span {rootDifferent f} := by
  refine le_antisymm ?_ ?_
  · intro s hs
    have := Module.mem_annihilator.1 hs (Ideal.Quotient.mk _ 1)
    have hz : Ideal.Quotient.mk (Ideal.span {rootDifferent f}) s = 0 := by
      rw [← this]
      show _ = s • Ideal.Quotient.mk (Ideal.span {rootDifferent f}) 1
      rw [Algebra.smul_def]
      simp
    exact (Ideal.Quotient.eq_zero_iff_mem).1 hz
  · intro s hs
    refine Module.mem_annihilator.2 fun x => ?_
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
    show s • Ideal.Quotient.mk (Ideal.span {rootDifferent f}) t = 0
    rw [Algebra.smul_def]
    have : (algebraMap (AdjoinRoot f) (MonogenicOmega f)) s
        = Ideal.Quotient.mk (Ideal.span {rootDifferent f}) s := rfl
    rw [this, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_right _ _ hs

/-- **The annihilator of the differentials is the different ideal.** -/
theorem annihilator_kaehler :
    Module.annihilator (AdjoinRoot f) (Ω[AdjoinRoot f⁄R]) = Ideal.span {rootDifferent f} := by
  rw [← annihilator_monogenicOmega f]
  exact (kaehlerEquivMonogenic f).annihilator_eq

end HTGeometry.ConstraintRelativity
