import Mathlib
import GaloisForLFunctions.HTGeometry.AlternantVandermondeDivisibility
import GaloisForLFunctions.HTGeometry.DVRFiniteSpan
import GaloisForLFunctions.HTGeometry.SmithNormalFormDVR

/-!
# Ultrametric collision energy and determinantal divisors

For pairwise distinct sheets `x₁, …, x_N` in a discrete valuation ring, the sheet-evaluation
observer `g ↦ (g(x₁), …, g(x_N))` has Vandermonde matrix `V`.  Every `k × k` minor of `V` is
divisible by the Vandermonde product of the rows it uses, so its valuation is at least the
ultrametric collision energy of that configuration; and the minor built from the first `k` columns
is exactly that Vandermonde product.  Hence the `k`-th determinantal ideal of `V` is generated by
the uniformizer power recording the minimum collision energy of a `k`-element configuration.
-/

namespace HTGeometry.ConstraintRelativity

open GaloisForLFunctions.HTGeometry IsDiscreteValuationRing

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-! ## Collision energy -/

/-- **Card `(5)`.**  The ultrametric collision energy of a finite sheet configuration. -/
noncomputable def collisionEnergy {N k : ℕ} (x : Fin N → R) (I : Fin k → Fin N) : ℕ∞ :=
  ∑ α : Fin k, ∑ β ∈ Finset.Ioi α, addVal R (x (I β) - x (I α))

/-- The collision energy is the valuation of the Vandermonde product of the configuration. -/
theorem collisionEnergy_eq_addVal {N k : ℕ} (x : Fin N → R) (I : Fin k → Fin N) :
    collisionEnergy x I = addVal R (vandermondeProd (x ∘ I)) := by
  rw [collisionEnergy, vandermondeProd, addVal_prod]
  exact Finset.sum_congr rfl fun α _ => (addVal_prod _ _).symm

/-- The configurations of size `k` that use `k` distinct sheets. -/
def injMaps (k N : ℕ) : Finset (Fin k → Fin N) :=
  Finset.univ.filter Function.Injective

theorem mem_injMaps {k N : ℕ} {I : Fin k → Fin N} :
    I ∈ injMaps k N ↔ Function.Injective I := by
  simp [injMaps]

/-- **Card `(6)`.**  The minimum collision energy of a `k`-element configuration. -/
noncomputable def minCollisionEnergy {N : ℕ} (x : Fin N → R) (k : ℕ) : ℕ∞ :=
  (injMaps k N).inf fun I => collisionEnergy x I

/-! ## Determinantal ideals of the sheet-evaluation matrix -/

/-- The set of `k × k` minors of the sheet-evaluation matrix. -/
def minorSet {N : ℕ} (x : Fin N → R) (k : ℕ) : Set R :=
  Set.range fun p : (Fin k → Fin N) × (Fin k → Fin N) =>
    ((Matrix.vandermonde x).submatrix p.1 p.2).det

/-- **Card `(7)`, left side.**  The `k`-th determinantal ideal of the sheet-evaluation matrix. -/
def determinantalIdeal {N : ℕ} (x : Fin N → R) (k : ℕ) : Ideal R :=
  Ideal.span (minorSet x k)

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- A minor of the Vandermonde matrix is an alternant in the selected sheets. -/
theorem submatrix_vandermonde_eq {N k : ℕ} (x : Fin N → R) (I m : Fin k → Fin N) :
    (Matrix.vandermonde x).submatrix I m = Matrix.of fun α β => (x ∘ I) α ^ ((m β : ℕ)) := by
  ext α β
  rw [Matrix.submatrix_apply, Matrix.vandermonde_apply]
  rfl

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- **Card `(12)`.**  Every minor is divisible by the Vandermonde product of the rows it uses. -/
theorem vandermondeProd_dvd_minor {N k : ℕ} (x : Fin N → R) (I m : Fin k → Fin N) :
    vandermondeProd (x ∘ I) ∣ ((Matrix.vandermonde x).submatrix I m).det := by
  rw [submatrix_vandermonde_eq]
  exact vandermondeProd_dvd_det_pow (x ∘ I) fun β => ((m β : ℕ))

/-- **Card `(12)`.**  Every minor has valuation at least the minimum collision energy. -/
theorem minCollisionEnergy_le_addVal_minor {N k : ℕ} (x : Fin N → R) (I m : Fin k → Fin N) :
    minCollisionEnergy x k ≤ addVal R (((Matrix.vandermonde x).submatrix I m).det) := by
  classical
  by_cases hI : Function.Injective I
  · refine le_trans (Finset.inf_le (mem_injMaps.mpr hI)) ?_
    rw [collisionEnergy_eq_addVal]
    exact addVal_le_iff_dvd.mpr (vandermondeProd_dvd_minor x I m)
  · have hdet : ((Matrix.vandermonde x).submatrix I m).det = 0 := by
      obtain ⟨α, β, hab, hne⟩ : ∃ α β, I α = I β ∧ α ≠ β := by
        by_contra hcon
        push Not at hcon
        exact hI fun a b h => hcon a b h
      refine Matrix.det_zero_of_row_eq hne ?_
      funext γ
      rw [Matrix.submatrix_apply, Matrix.submatrix_apply, hab]
    rw [hdet, (addVal R).map_zero]
    exact le_top

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- The minor built from the first `k` columns of a row selection is the Vandermonde product of
the selected sheets. -/
theorem minor_firstColumns {N k : ℕ} (x : Fin N → R) (hk : k ≤ N) (I : Fin k → Fin N) :
    ((Matrix.vandermonde x).submatrix I (Fin.castLE hk)).det = vandermondeProd (x ∘ I) := by
  have h : (Matrix.vandermonde x).submatrix I (Fin.castLE hk) = Matrix.vandermonde (x ∘ I) := by
    ext α β
    rw [Matrix.submatrix_apply, Matrix.vandermonde_apply, Matrix.vandermonde_apply]
    rfl
  rw [h, det_vandermonde_eq_vandermondeProd]

theorem injMaps_nonempty {k N : ℕ} (hk : k ≤ N) : (injMaps k N).Nonempty :=
  ⟨Fin.castLE hk, mem_injMaps.mpr (Fin.castLE_injective hk)⟩

/-- **Card `(7)`.**  The `k`-th determinantal ideal is generated by the Vandermonde product of an
energy-minimizing configuration. -/
theorem exists_determinantalIdeal_eq_span_vandermondeProd {N : ℕ} (x : Fin N → R) {k : ℕ}
    (hk : k ≤ N) :
    ∃ I : Fin k → Fin N, Function.Injective I ∧
      collisionEnergy x I = minCollisionEnergy x k ∧
      determinantalIdeal x k = Ideal.span {vandermondeProd (x ∘ I)} := by
  classical
  obtain ⟨I, hImem, hI⟩ :=
    Finset.exists_mem_eq_inf' (injMaps_nonempty hk) fun I => collisionEnergy x I
  have hinf : minCollisionEnergy x k = collisionEnergy x I := by
    rw [minCollisionEnergy, ← Finset.inf'_eq_inf (injMaps_nonempty hk), hI]
  refine ⟨I, mem_injMaps.mp hImem, hinf.symm, le_antisymm ?_ ?_⟩
  · rw [determinantalIdeal, Ideal.span_le]
    rintro y ⟨⟨J, m⟩, rfl⟩
    refine Ideal.mem_span_singleton.mpr (addVal_le_iff_dvd.mp ?_)
    rw [← collisionEnergy_eq_addVal, ← hinf]
    exact minCollisionEnergy_le_addVal_minor x J m
  · rw [Ideal.span_le]
    rintro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    refine Ideal.subset_span ⟨(I, Fin.castLE hk), ?_⟩
    exact minor_firstColumns x hk I

/-- **Card `(7)`, boxed.**  The `k`-th determinantal ideal is the power of the uniformizer whose
exponent is the minimum collision energy. -/
theorem exists_determinantalIdeal_eq_span_pow {N : ℕ} (x : Fin N → R)
    (hx : Function.Injective x) {k : ℕ} (hk : k ≤ N) {ϖ : R} (hϖ : Irreducible ϖ) :
    ∃ d : ℕ, minCollisionEnergy x k = (d : ℕ∞) ∧
      determinantalIdeal x k = Ideal.span {ϖ ^ d} := by
  obtain ⟨I, hIinj, hIen, hIspan⟩ := exists_determinantalIdeal_eq_span_vandermondeProd x hk
  have hne : vandermondeProd (x ∘ I) ≠ 0 := vandermondeProd_ne_zero (hx.comp hIinj)
  obtain ⟨d, hd, hspan⟩ := exists_span_singleton_eq_span_pow hϖ hne
  refine ⟨d, ?_, by rw [hIspan, hspan]⟩
  rw [← hIen, collisionEnergy_eq_addVal, hd]


/-! ## Permutation invariance and the orientation -/

/-- Collision energy does not see the order in which a configuration is listed. -/
theorem collisionEnergy_comp_perm {N k : ℕ} (x : Fin N → R) (I : Fin k → Fin N)
    (σ : Equiv.Perm (Fin k)) :
    collisionEnergy x (I ∘ σ) = collisionEnergy x I := by
  rw [collisionEnergy_eq_addVal, collisionEnergy_eq_addVal]
  have h : vandermondeProd ((x ∘ I) ∘ σ) = (Equiv.Perm.sign σ : ℤ) • vandermondeProd (x ∘ I) :=
    vandermondeProd_comp (x ∘ I) σ
  have hxc : x ∘ (I ∘ σ) = (x ∘ I) ∘ σ := rfl
  rw [hxc, h]
  rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hs | hs <;> rw [hs]
  · simp
  · simp [(addVal R).map_neg]

/-- Every configuration of distinct sheets can be listed in increasing order without changing its
collision energy. -/
theorem exists_strictMono_collisionEnergy {N k : ℕ} (x : Fin N → R) (I : Fin k → Fin N)
    (hI : Function.Injective I) :
    ∃ J : Fin k → Fin N, StrictMono J ∧ collisionEnergy x J = collisionEnergy x I := by
  refine ⟨I ∘ Tuple.sort I, ?_, collisionEnergy_comp_perm x I (Tuple.sort I)⟩
  exact (Tuple.monotone_sort I).strictMono_of_injective (hI.comp (Equiv.injective _))

/-- **Card `(14)`.**  The valuation of the orientation is the total collision energy. -/
theorem addVal_det_vandermonde {N : ℕ} (x : Fin N → R) :
    addVal R ((Matrix.vandermonde x).det) = collisionEnergy x id := by
  rw [det_vandermonde_eq_vandermondeProd, collisionEnergy_eq_addVal]
  rfl

/-- The minimum energy at full size is the total collision energy. -/
theorem minCollisionEnergy_self {N : ℕ} (x : Fin N → R) :
    minCollisionEnergy x N = collisionEnergy x id := by
  refine le_antisymm (Finset.inf_le (mem_injMaps.mpr Function.injective_id)) (Finset.le_inf ?_)
  intro I hI
  have hbij : Function.Bijective I := (Finite.injective_iff_bijective).mp (mem_injMaps.mp hI)
  have hcomp : I = id ∘ (Equiv.ofBijective I hbij) := rfl
  rw [hcomp, collisionEnergy_comp_perm x id (Equiv.ofBijective I hbij)]

/-- **Card `(14)`.**  The sheet discriminant, the square of the orientation. -/
noncomputable def sheetDiscriminant {N : ℕ} (x : Fin N → R) : R := (vandermondeProd x) ^ 2

/-- **Card `(14)`, boxed.**  The discriminant carries exactly twice the total collision energy. -/
theorem addVal_sheetDiscriminant {N : ℕ} (x : Fin N → R) :
    addVal R (sheetDiscriminant x) = collisionEnergy x id + collisionEnergy x id := by
  rw [sheetDiscriminant, sq, (addVal R).map_mul, collisionEnergy_eq_addVal]
  rfl

omit [IsDiscreteValuationRing R] in
/-- **Corollary 2.**  Distinct sheets make the sheet-evaluation observer injective. -/
theorem vandermonde_mulVec_injective {N : ℕ} (x : Fin N → R) (hx : Function.Injective x) :
    Function.Injective (Matrix.vandermonde x).mulVec := by
  classical
  intro u w h
  have hdet : (Matrix.vandermonde x).det ≠ 0 := by
    rw [det_vandermonde_eq_vandermondeProd]
    exact vandermondeProd_ne_zero hx
  have h0 : (Matrix.vandermonde x).mulVec (u - w) = 0 := by
    rw [Matrix.mulVec_sub, h, sub_self]
  have := Matrix.eq_zero_of_mulVec_eq_zero hdet h0
  exact sub_eq_zero.mp this

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- **Card `(15)`, first half.**  The zeroth Fitting ideal of the cokernel of the observer is
generated by the orientation. -/
theorem span_det_eq_span_vandermondeProd {N : ℕ} (x : Fin N → R) :
    Ideal.span {(Matrix.vandermonde x).det} = Ideal.span {vandermondeProd x} := by
  rw [det_vandermonde_eq_vandermondeProd]

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- **Card `(15)`, boxed.**  The discriminant ideal is the square of the orientation ideal. -/
theorem span_sheetDiscriminant_eq_sq {N : ℕ} (x : Fin N → R) :
    Ideal.span {sheetDiscriminant x} = Ideal.span {vandermondeProd x} ^ 2 := by
  rw [sheetDiscriminant, sq, sq, Ideal.span_singleton_mul_span_singleton]


/-! ## The ultrametrically separated mixed-order profile -/

/-- **Cards `(16)`, `(17)`.**  A separated profile: the sheet orders increase, and the valuation of
a difference is the shallower of the two orders. -/
structure SeparatedProfile {N : ℕ} (x : Fin N → R) (r : Fin N → ℕ) : Prop where
  /-- The orders are the valuations of the sheets. -/
  ord : ∀ i, addVal R (x i) = (r i : ℕ∞)
  /-- The orders increase. -/
  mono : Monotone r
  /-- A difference has the valuation of the shallower sheet. -/
  sep : ∀ i j : Fin N, i < j → addVal R (x j - x i) = (r i : ℕ∞)

/-- **Card `(23)`.**  In a separated profile the energy of an increasing configuration is an
explicit weighted sum of the selected orders. -/
theorem collisionEnergy_of_separated {N k : ℕ} {x : Fin N → R} {r : Fin N → ℕ}
    (h : SeparatedProfile x r) {I : Fin k → Fin N} (hI : StrictMono I) :
    collisionEnergy x I = ∑ α : Fin k, (((k - 1 - (α : ℕ)) * r (I α) : ℕ) : ℕ∞) := by
  rw [collisionEnergy]
  refine Finset.sum_congr rfl fun α _ => ?_
  have hval : ∀ β ∈ Finset.Ioi α, addVal R (x (I β) - x (I α)) = ((r (I α) : ℕ) : ℕ∞) :=
    fun β hβ => h.sep _ _ (hI (Finset.mem_Ioi.mp hβ))
  rw [Finset.sum_congr rfl hval, Finset.sum_const, Fin.card_Ioi, nsmul_eq_mul]
  push_cast
  ring

/-- **Card `(18)`, boxed.**  In a separated profile the minimum `k`-energy is attained on the
shallowest `k` sheets. -/
theorem minCollisionEnergy_of_separated {N : ℕ} {x : Fin N → R} {r : Fin N → ℕ}
    (h : SeparatedProfile x r) {k : ℕ} (hk : k ≤ N) :
    minCollisionEnergy x k
      = ∑ α : Fin k, (((k - 1 - (α : ℕ)) * r (Fin.castLE hk α) : ℕ) : ℕ∞) := by
  refine le_antisymm ?_ (Finset.le_inf ?_)
  · calc minCollisionEnergy x k ≤ collisionEnergy x (Fin.castLE hk) :=
          Finset.inf_le (mem_injMaps.mpr (Fin.castLE_injective hk))
      _ = _ := collisionEnergy_of_separated h (fun _ _ hab => hab)
  · intro I hI
    obtain ⟨J, hJmono, hJ⟩ := exists_strictMono_collisionEnergy x I (mem_injMaps.mp hI)
    rw [← hJ, collisionEnergy_of_separated h hJmono]
    refine Finset.sum_le_sum fun α _ => ?_
    have hidx : Fin.castLE hk α ≤ J α := by
      rw [Fin.le_def]
      simpa using val_le_val_of_strictMono hJmono α
    have hle : r (Fin.castLE hk α) ≤ r (J α) := h.mono hidx
    exact_mod_cast Nat.mul_le_mul_left _ hle

/-- **Card `(20)`.**  The underived ideal of the sheets sees only the shallowest order. -/
theorem span_sheets_eq_span_pow {N : ℕ} {x : Fin N → R} {r : Fin N → ℕ}
    (h : SeparatedProfile x r) (hN : 0 < N) {ϖ : R} (hϖ : Irreducible ϖ) :
    Ideal.span (Set.range x) = Ideal.span {ϖ ^ r ⟨0, hN⟩} := by
  classical
  have hdvd : ∀ i : Fin N, x ⟨0, hN⟩ ∣ x i := by
    intro i
    refine addVal_le_iff_dvd.mp ?_
    rw [h.ord, h.ord]
    refine Nat.cast_le.mpr (h.mono ?_)
    rw [Fin.le_def]
    exact Nat.zero_le _
  have hspan : Ideal.span (Set.range x) = Ideal.span {x ⟨0, hN⟩} := by
    refine le_antisymm ?_ ?_
    · rw [Ideal.span_le]
      rintro y ⟨i, rfl⟩
      exact Ideal.mem_span_singleton.mpr (hdvd i)
    · rw [Ideal.span_le]
      rintro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact Ideal.subset_span ⟨⟨0, hN⟩, rfl⟩
  have hne : x ⟨0, hN⟩ ≠ 0 := by
    intro hzero
    have := h.ord ⟨0, hN⟩
    rw [hzero, (addVal R).map_zero] at this
    exact (WithTop.top_ne_coe this)
  obtain ⟨d, hd, hpow⟩ := exists_span_singleton_eq_span_pow hϖ hne
  have hdr : d = r ⟨0, hN⟩ := by
    have h1 : ((d : ℕ) : ℕ∞) = ((r ⟨0, hN⟩ : ℕ) : ℕ∞) := by rw [← hd, h.ord]
    exact_mod_cast h1
  rw [hspan, hpow, hdr]



/-- **Cards `(18)`, `(19)`, `(21)`, `(22)`.**  In a separated profile the invariant-factor
valuation at level `k` is the accumulated history of the shallower sheets, independently of the
sheet just added. -/
theorem minCollisionEnergy_succ_of_separated {N : ℕ} {x : Fin N → R} {r : Fin N → ℕ}
    (h : SeparatedProfile x r) {k : ℕ} (hk : k + 1 ≤ N) :
    minCollisionEnergy x (k + 1)
      = minCollisionEnergy x k
        + ((∑ α : Fin k, r (Fin.castLE (Nat.le_of_succ_le hk) α) : ℕ) : ℕ∞) := by
  have hk' : k ≤ N := Nat.le_of_succ_le hk
  have hnat : (∑ α : Fin (k + 1), (k + 1 - 1 - (α : ℕ)) * r (Fin.castLE hk α))
      = (∑ α : Fin k, (k - 1 - (α : ℕ)) * r (Fin.castLE hk' α))
        + ∑ α : Fin k, r (Fin.castLE hk' α) := by
    rw [Fin.sum_univ_castSucc, ← Finset.sum_add_distrib]
    have hlast : (k + 1 - 1 - ((Fin.last k : Fin (k + 1)) : ℕ))
        * r (Fin.castLE hk (Fin.last k)) = 0 := by simp
    rw [hlast, add_zero]
    refine Finset.sum_congr rfl fun α _ => ?_
    have hc : Fin.castLE hk α.castSucc = Fin.castLE hk' α := Fin.ext rfl
    have hv : ((α.castSucc : Fin (k + 1)) : ℕ) = (α : ℕ) := rfl
    rw [hc, hv]
    have hstep : k + 1 - 1 - (α : ℕ) = (k - 1 - (α : ℕ)) + 1 := by
      have := α.isLt
      omega
    rw [hstep]
    ring
  rw [minCollisionEnergy_of_separated h hk, minCollisionEnergy_of_separated h hk',
    ← Nat.cast_sum, ← Nat.cast_sum, ← Nat.cast_add, hnat]


/-! ## The cotangent square -/

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- The Vandermonde product read with the lower index inside. -/
theorem prod_Iio_eq_vandermondeProd {N : ℕ} (x : Fin N → R) :
    ∏ i : Fin N, ∏ j ∈ Finset.Iio i, (x i - x j) = vandermondeProd x := by
  rw [vandermondeProd]
  refine Finset.prod_comm' ?_
  intro i j
  simp [Finset.mem_Iio, Finset.mem_Ioi]

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- The product of all off-diagonal differences. -/
theorem prod_offDiag_eq {N : ℕ} (x : Fin N → R) :
    ∏ i : Fin N, ∏ j ∈ Finset.univ.erase i, (x i - x j)
      = (-1 : R) ^ (∑ i : Fin N, (Finset.Ioi i).card) * (vandermondeProd x) ^ 2 := by
  classical
  have hsplit : ∀ i : Fin N,
      ∏ j ∈ Finset.univ.erase i, (x i - x j)
        = (∏ j ∈ Finset.Iio i, (x i - x j)) * ∏ j ∈ Finset.Ioi i, (x i - x j) := by
    intro i
    have hset : Finset.univ.erase i = Finset.Iio i ∪ Finset.Ioi i := by
      ext j
      simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_union, Finset.mem_Iio,
        Finset.mem_Ioi]
      exact ⟨fun h => (lt_or_gt_of_ne h).imp id id, fun h => by
        rcases h with h | h
        · exact ne_of_lt h
        · exact ne_of_gt h⟩
    rw [hset, Finset.prod_union]
    rw [Finset.disjoint_left]
    intro a ha hb
    rw [Finset.mem_Iio] at ha
    rw [Finset.mem_Ioi] at hb
    exact absurd (ha.trans hb) (lt_irrefl a)
  have hneg : ∀ i : Fin N,
      ∏ j ∈ Finset.Ioi i, (x i - x j)
        = (-1 : R) ^ (Finset.Ioi i).card * ∏ j ∈ Finset.Ioi i, (x j - x i) := by
    intro i
    rw [← Finset.prod_const, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun j _ => by ring
  rw [Finset.prod_congr rfl fun i _ => hsplit i, Finset.prod_mul_distrib,
    Finset.prod_congr rfl fun i _ => hneg i, Finset.prod_mul_distrib, ← Finset.prod_pow_eq_pow_sum,
    prod_Iio_eq_vandermondeProd, ← vandermondeProd]
  ring

omit [IsDiscreteValuationRing R] in
/-- **Card `(15)`.**  The product of all off-diagonal differences generates the discriminant
ideal. -/
theorem span_prod_offDiag {N : ℕ} (x : Fin N → R) :
    Ideal.span {∏ i : Fin N, ∏ j ∈ Finset.univ.erase i, (x i - x j)}
      = Ideal.span {sheetDiscriminant x} := by
  rw [prod_offDiag_eq, sheetDiscriminant]
  refine Ideal.span_singleton_eq_span_singleton.mpr ⟨(-1 : Rˣ) ^ (∑ i : Fin N, (Finset.Ioi i).card),
    ?_⟩
  rw [Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one, mul_comm, ← mul_assoc,
    ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]

omit [IsDomain R] [IsDiscreteValuationRing R] in
/-- The derivative of the sheet polynomial at a sheet is the product of its distances to the other
sheets. -/
theorem derivative_sheetPoly_eval {N : ℕ} (x : Fin N → R) (i : Fin N) :
    (Polynomial.derivative (∏ j : Fin N, (Polynomial.X - Polynomial.C (x j)))).eval (x i)
      = ∏ j ∈ Finset.univ.erase i, (x i - x j) := by
  classical
  rw [Polynomial.derivative_prod_finset, Polynomial.eval_finsetSum]
  rw [Finset.sum_eq_single i]
  · simp [Polynomial.eval_prod]
  · intro b _ hb
    have hmem : i ∈ Finset.univ.erase b := Finset.mem_erase.mpr ⟨fun h => hb h.symm, Finset.mem_univ i⟩
    have hzero : ∏ a ∈ Finset.univ.erase b, (x i - x a) = 0 :=
      Finset.prod_eq_zero hmem (sub_self _)
    simp [Polynomial.eval_prod, hzero]
  · intro h
    exact absurd (Finset.mem_univ i) h

omit [IsDiscreteValuationRing R] in
/-- **Card `(15)`, boxed.**  Any operator intertwining the sheet-evaluation observer with
multiplication by the sheet values of a function has determinant the product of those values.
Applied to the derivative of the sheet polynomial this identifies the determinant of the
presentation of the relative differentials with the discriminant. -/
theorem det_of_intertwine {N : ℕ} (x : Fin N → R) (hx : Function.Injective x)
    (u : Fin N → R) (W : Matrix (Fin N) (Fin N) R)
    (h : Matrix.vandermonde x * W = Matrix.diagonal u * Matrix.vandermonde x) :
    W.det = ∏ i, u i := by
  have hV : (Matrix.vandermonde x).det ≠ 0 := by
    rw [det_vandermonde_eq_vandermondeProd]
    exact vandermondeProd_ne_zero hx
  have hdet := congrArg Matrix.det h
  rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal] at hdet
  exact mul_left_cancel₀ hV (by rw [hdet, mul_comm])

omit [IsDiscreteValuationRing R] in
/-- **Card `(15)`, boxed.**  The determinant of the presentation of the relative differentials
generates the discriminant ideal, which is the square of the orientation ideal. -/
theorem span_det_intertwine_eq_discriminant {N : ℕ} (x : Fin N → R) (hx : Function.Injective x)
    (W : Matrix (Fin N) (Fin N) R)
    (h : Matrix.vandermonde x * W
      = Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, (x i - x j)) * Matrix.vandermonde x) :
    Ideal.span {W.det} = Ideal.span {vandermondeProd x} ^ 2 := by
  rw [det_of_intertwine x hx _ W h, span_prod_offDiag, span_sheetDiscriminant_eq_sq]

/-- **Card `(15)`, boxed.**  Its valuation is twice the total collision energy. -/
theorem addVal_det_intertwine {N : ℕ} (x : Fin N → R) (hx : Function.Injective x)
    (W : Matrix (Fin N) (Fin N) R)
    (h : Matrix.vandermonde x * W
      = Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, (x i - x j)) * Matrix.vandermonde x) :
    addVal R W.det = collisionEnergy x id + collisionEnergy x id := by
  rw [det_of_intertwine x hx _ W h,
    addVal_eq_of_span_eq (span_prod_offDiag x), addVal_sheetDiscriminant]

/-! ## The observer barcode -/

omit [IsDomain R] [IsDiscreteValuationRing R] in
theorem determinantalIdeal_eq_detIdeal {N : ℕ} (x : Fin N → R) (k : ℕ) :
    determinantalIdeal x k = detIdeal (Matrix.vandermonde x) k := rfl

/-- **Cards `(8)`, `(9)`, `(13)`.**  The sheet-evaluation observer has invariant factors whose
valuations accumulate to the minimum collision energies, and its cokernel is the product of the
cyclic quotients by those invariant factors. -/
theorem exists_sheetBarcode {N : ℕ} (x : Fin N → R) :
    ∃ d : Fin N → R, (∀ i j : Fin N, i ≤ j → d i ∣ d j) ∧
      (∀ (k : ℕ) (hk : k ≤ N),
        minCollisionEnergy x k = ∑ α : Fin k, addVal R (d (Fin.castLE hk α))) ∧
      Nonempty (((Fin N → R) ⧸ LinearMap.range (Matrix.vandermonde x).mulVecLin)
        ≃ₗ[R] ∀ i : Fin N, R ⧸ (Ideal.span {d i} : Submodule R R)) := by
  obtain ⟨d, hchain, hdet, hcoker⟩ := exists_cokernel_equiv_pi (Matrix.vandermonde x)
  refine ⟨d, hchain, fun k hk => ?_, hcoker⟩
  obtain ⟨I, _, hIen, hIspan⟩ := exists_determinantalIdeal_eq_span_vandermondeProd x hk
  have hspan : Ideal.span {vandermondeProd (x ∘ I)}
      = Ideal.span {∏ α : Fin k, d (Fin.castLE hk α)} := by
    rw [← hIspan, determinantalIdeal_eq_detIdeal]
    exact hdet k hk
  rw [← hIen, collisionEnergy_eq_addVal, addVal_eq_of_span_eq hspan, addVal_prod]

/-- **Card `(9)`, boxed.**  The invariant-factor valuations are the discrete derivative of the
minimum collision energy profile. -/
theorem minCollisionEnergy_succ {N : ℕ} (x : Fin N → R) (d : Fin N → R)
    (hd : ∀ (k : ℕ) (hk : k ≤ N),
      minCollisionEnergy x k = ∑ α : Fin k, addVal R (d (Fin.castLE hk α)))
    {k : ℕ} (hk : k + 1 ≤ N) :
    minCollisionEnergy x (k + 1)
      = minCollisionEnergy x k + addVal R (d ⟨k, hk⟩) := by
  have hk' : k ≤ N := Nat.le_of_succ_le hk
  have h1 : ∀ α : Fin k, Fin.castLE hk α.castSucc = Fin.castLE hk' α := fun _ => Fin.ext rfl
  have h2 : Fin.castLE hk (Fin.last k) = (⟨k, hk⟩ : Fin N) := Fin.ext rfl
  rw [hd (k + 1) hk, hd k hk', Fin.sum_univ_castSucc, h2,
    Finset.sum_congr rfl fun α _ => congrArg (fun i => addVal R (d i)) (h1 α)]

/-- **Card `(26)`.**  The invariant-factor valuations increase, so the minimum collision energy
profile is convex. -/
theorem addVal_invariantFactor_mono {N : ℕ} (d : Fin N → R)
    (hchain : ∀ i j : Fin N, i ≤ j → d i ∣ d j) {i j : Fin N} (hij : i ≤ j) :
    addVal R (d i) ≤ addVal R (d j) :=
  addVal_le_iff_dvd.mpr (hchain i j hij)

