import GaloisForLFunctions.HTGeometry.ConstraintRelativity.TruncatedHardCoreFock
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.FactorFramedTensorClosedFibre
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.PowerSeriesResidue

/-!
# Literal factor-Jacobian closed fibre to hard-core Fock bridge

For every `d = n + 2`, this file proves that the actual polynomial quotient by the square
relations and all complementary `(d - 1)`-fold products is algebra-isomorphic to the full algebra
generated by compressed hard-core creators. The proof establishes a squarefree-face spanning
theorem for the quotient, proves the creator relations, and closes injectivity by exact finite-rank
comparison; it does not replace the quotient by a coordinate proxy.
-/

namespace HTGeometry.ConstraintRelativity

open scoped BigOperators

noncomputable section

abbrev ComplexFactorSquarefreeFaceAlgebra (n : ℕ) :=
  FactorTensorPolynomial ℂ (n + 2) ⧸
    ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ⊔
      factorComplementIdeal)

def factorFaceMonomial {d : ℕ} (T : TensorFace d) : FactorTensorPolynomial ℂ d :=
  ∏ i ∈ T, MvPolynomial.X i

def complexFactorFaceClass {n : ℕ} (T : ClosedHorizonFace (n + 2)) :
    ComplexFactorSquarefreeFaceAlgebra n :=
  Ideal.Quotient.mk _ (factorFaceMonomial T.1)

theorem factorFaceMonomial_empty {d : ℕ} :
    factorFaceMonomial (∅ : TensorFace d) = 1 := by
  simp [factorFaceMonomial]

theorem factorFaceMonomial_insert {d : ℕ} {i : Fin d} {T : TensorFace d}
    (hi : i ∉ T) :
    factorFaceMonomial (insert i T) = MvPolynomial.X i * factorFaceMonomial T := by
  rw [factorFaceMonomial, Finset.prod_insert hi, factorFaceMonomial]

theorem factorFaceMonomial_mul_X_of_mem {d : ℕ} {i : Fin d} {T : TensorFace d}
    (hi : i ∈ T) :
    factorFaceMonomial T * MvPolynomial.X i =
      (∏ j ∈ T.erase i, MvPolynomial.X j) * MvPolynomial.X i ^ (2 : ℕ) := by
  rw [factorFaceMonomial]
  rw [← Finset.prod_erase_mul T (fun j => MvPolynomial.X j) hi]
  ring

theorem complexFactorFaceClass_mul_generator_mem_span
    {n : ℕ} (T : ClosedHorizonFace (n + 2)) (i : Fin (n + 2)) :
    complexFactorFaceClass T *
        (Ideal.Quotient.mk _ (MvPolynomial.X i) : ComplexFactorSquarefreeFaceAlgebra n) ∈
      Submodule.span ℂ (Set.range (complexFactorFaceClass (n := n))) := by
  classical
  by_cases hi : i ∈ T.1
  · have hsquare : MvPolynomial.X i ^ (2 : ℕ) ∈
        (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) := by
      apply Ideal.subset_span
      exact ⟨i, rfl⟩
    have hprod : factorFaceMonomial T.1 * MvPolynomial.X i ∈
        ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ⊔
          factorComplementIdeal) := by
      rw [factorFaceMonomial_mul_X_of_mem hi]
      apply (show (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ≤
          factorSquareRelationIdeal ⊔ factorComplementIdeal from le_sup_left)
      exact Ideal.mul_mem_left _ _ hsquare
    change Ideal.Quotient.mk _ (factorFaceMonomial T.1 * MvPolynomial.X i) ∈ _
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hprod]
    exact Submodule.zero_mem _
  · by_cases hcard : (insert i T.1).card ≤ n
    · let U : ClosedHorizonFace (n + 2) := ⟨insert i T.1, by simpa using hcard⟩
      have heq : complexFactorFaceClass T *
          (Ideal.Quotient.mk _ (MvPolynomial.X i) : ComplexFactorSquarefreeFaceAlgebra n) =
          complexFactorFaceClass U := by
        change Ideal.Quotient.mk _ (factorFaceMonomial T.1 * MvPolynomial.X i) =
          Ideal.Quotient.mk _ (factorFaceMonomial (insert i T.1))
        rw [factorFaceMonomial_insert hi]
        congr 1
        ring
      rw [heq]
      exact Submodule.subset_span (Set.mem_range_self U)
    · have hUcard : (insert i T.1).card = n + 1 := by
        have hins : (insert i T.1).card = T.1.card + 1 := Finset.card_insert_of_notMem hi
        have hTle : T.1.card ≤ n := by simpa using T.2
        have hlo : n < (insert i T.1).card := Nat.lt_of_not_ge hcard
        omega
      let U : TensorFace (n + 2) := insert i T.1
      have hUne : U ≠ Finset.univ := by
        intro h
        have hc := congrArg Finset.card h
        simp [U, hUcard] at hc
      have hnotSubset : ¬Finset.univ ⊆ U := by
        intro h
        exact hUne (Finset.Subset.antisymm (Finset.subset_univ U) h)
      obtain ⟨j, hj⟩ := Finset.sdiff_nonempty.mpr hnotSubset
      have hjuniv : j ∈ Finset.univ := (Finset.mem_sdiff.mp hj).1
      have hjU : j ∉ U := (Finset.mem_sdiff.mp hj).2
      have hUsub : U ⊆ Finset.univ.erase j := by
        intro k hk
        simp only [Finset.mem_erase, Finset.mem_univ, and_true]
        exact fun hkj => hjU (hkj ▸ hk)
      have hUeq : U = Finset.univ.erase j := by
        apply Finset.eq_of_subset_of_card_le hUsub
        rw [Finset.card_erase_of_mem hjuniv, Finset.card_univ,
          Fintype.card_fin, hUcard]
        omega
      have hcomp : factorFaceMonomial T.1 * MvPolynomial.X i =
          factorTensorComplement (R := ℂ) j := by
        rw [factorTensorComplement, ← hUeq]
        change factorFaceMonomial T.1 * MvPolynomial.X i = factorFaceMonomial U
        rw [factorFaceMonomial_insert hi]
        ring
      have hmem : factorFaceMonomial T.1 * MvPolynomial.X i ∈
          ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ⊔
            factorComplementIdeal) := by
        rw [hcomp]
        apply (show (factorComplementIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ≤
            factorSquareRelationIdeal ⊔ factorComplementIdeal from le_sup_right)
        apply Ideal.subset_span
        exact ⟨j, rfl⟩
      change Ideal.Quotient.mk _ (factorFaceMonomial T.1 * MvPolynomial.X i) ∈ _
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
      exact Submodule.zero_mem _

def complexFactorFaceClassSpan (n : ℕ) :
    Submodule ℂ (ComplexFactorSquarefreeFaceAlgebra n) :=
  Submodule.span ℂ (Set.range (complexFactorFaceClass (n := n)))

theorem complexFactorFaceClassSpan_mul_generator
    {n : ℕ} {x : ComplexFactorSquarefreeFaceAlgebra n}
    (hx : x ∈ complexFactorFaceClassSpan n) (i : Fin (n + 2)) :
    x * (Ideal.Quotient.mk _ (MvPolynomial.X i) : ComplexFactorSquarefreeFaceAlgebra n) ∈
      complexFactorFaceClassSpan n := by
  refine Submodule.span_induction
    (p := fun x _ => x * (Ideal.Quotient.mk _ (MvPolynomial.X i) :
      ComplexFactorSquarefreeFaceAlgebra n) ∈ complexFactorFaceClassSpan n)
    ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨T, rfl⟩
    exact complexFactorFaceClass_mul_generator_mem_span T i
  · simpa using (complexFactorFaceClassSpan n).zero_mem
  · intro x y _ _ hx hy
    simpa [add_mul] using (complexFactorFaceClassSpan n).add_mem hx hy
  · intro c x _ hx
    simpa [smul_mul_assoc] using (complexFactorFaceClassSpan n).smul_mem c hx

theorem complexFactorFaceClassSpan_eq_top (n : ℕ) :
    complexFactorFaceClassSpan n = ⊤ := by
  apply top_unique
  intro x hx
  clear hx
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C c =>
      have hempty : complexFactorFaceClass
          (⟨∅, by simp⟩ : ClosedHorizonFace (n + 2)) = 1 := by
        change Ideal.Quotient.mk _ (factorFaceMonomial ∅) = 1
        rw [factorFaceMonomial_empty, map_one]
      rw [show Ideal.Quotient.mk _ (MvPolynomial.C c) =
          c • complexFactorFaceClass
            (⟨∅, by simp⟩ : ClosedHorizonFace (n + 2)) by
        rw [hempty]
        change algebraMap ℂ (ComplexFactorSquarefreeFaceAlgebra n) c = c • 1
        rw [Algebra.smul_def, mul_one]]
      exact (complexFactorFaceClassSpan n).smul_mem c
        (Submodule.subset_span (Set.mem_range_self _))
  | add p q hp hq =>
      rw [map_add]
      exact (complexFactorFaceClassSpan n).add_mem hp hq
  | mul_X p i hp =>
      rw [map_mul]
      exact complexFactorFaceClassSpan_mul_generator hp i

def complexFactorFaceSynthesis (n : ℕ) :
    (ClosedHorizonFace (n + 2) → ℂ) →ₗ[ℂ] ComplexFactorSquarefreeFaceAlgebra n where
  toFun x := ∑ T, x T • complexFactorFaceClass T
  map_add' x y := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c x := by
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro T _
    rw [Pi.smul_apply, smul_smul, RingHom.id_apply]
    change (c * x T) • complexFactorFaceClass T = _
    rfl

theorem complexFactorFaceSynthesis_range_eq_span (n : ℕ) :
    LinearMap.range (complexFactorFaceSynthesis n) = complexFactorFaceClassSpan n := by
  apply le_antisymm
  · rintro y ⟨x, rfl⟩
    change (∑ T, x T • complexFactorFaceClass T) ∈ complexFactorFaceClassSpan n
    exact Submodule.sum_mem _ fun T _ =>
      (complexFactorFaceClassSpan n).smul_mem (x T)
        (Submodule.subset_span (Set.mem_range_self T))
  · rw [complexFactorFaceClassSpan, Submodule.span_le]
    rintro _ ⟨T, rfl⟩
    classical
    let e : ClosedHorizonFace (n + 2) → ℂ := fun U => if U = T then 1 else 0
    refine ⟨e, ?_⟩
    change (∑ U, e U • complexFactorFaceClass U) = _
    simp [e]

theorem complexFactorFaceSynthesis_surjective (n : ℕ) :
    Function.Surjective (complexFactorFaceSynthesis n) := by
  rw [← LinearMap.range_eq_top, complexFactorFaceSynthesis_range_eq_span,
    complexFactorFaceClassSpan_eq_top]

def truncatedCreatorElement {d : ℕ} (i : Fin d) : truncatedFaceCreatorAlgebra d :=
  ⟨truncatedCreator i, truncatedCreator_mem_faceCreatorAlgebra i⟩

theorem truncatedFaceCreator_mul_comm
    {d : ℕ} (T S : TensorFace d) :
    truncatedFaceCreator T * truncatedFaceCreator S =
      truncatedFaceCreator S * truncatedFaceCreator T := by
  classical
  apply LinearMap.ext
  intro x
  by_cases hTS : Disjoint T S
  · rw [show (truncatedFaceCreator T * truncatedFaceCreator S) x =
        truncatedFaceCreator (T ∪ S) x from
          truncatedFaceCreator_comp_of_disjoint hTS x,
      show (truncatedFaceCreator S * truncatedFaceCreator T) x =
        truncatedFaceCreator (S ∪ T) x from
          truncatedFaceCreator_comp_of_disjoint hTS.symm x,
      Finset.union_comm]
  · rw [show (truncatedFaceCreator T * truncatedFaceCreator S) x = 0 from
        truncatedFaceCreator_comp_eq_zero_of_not_disjoint hTS x,
      show (truncatedFaceCreator S * truncatedFaceCreator T) x = 0 from
        truncatedFaceCreator_comp_eq_zero_of_not_disjoint
          (fun h => hTS h.symm) x]

theorem truncatedFaceCreatorAlgebra_mul_comm
    {d : ℕ} (A B : truncatedFaceCreatorAlgebra d) : A * B = B * A := by
  apply Subtype.ext
  change A.1 * B.1 = B.1 * A.1
  have hA : A.1 ∈ truncatedFaceCreatorSpan d := A.2
  have hB : B.1 ∈ truncatedFaceCreatorSpan d := B.2
  refine Submodule.span_induction₂
    (p := fun X Y _ _ => X * Y = Y * X) ?_ ?_ ?_ ?_ ?_ ?_ ?_ hA hB
  · rintro _ _ ⟨T, rfl⟩ ⟨S, rfl⟩
    exact truncatedFaceCreator_mul_comm T.1 S.1
  · intro Y _
    simp
  · intro X _
    simp
  · intro X Y Z _ _ _ hX hY
    simp only [add_mul, mul_add]
    rw [hX, hY]
  · intro X Y Z _ _ _ hX hY
    simp only [mul_add, add_mul]
    rw [hX, hY]
  · intro c X Y _ _ hXY
    rw [smul_mul_assoc, mul_smul_comm, hXY]
  · intro c X Y _ _ hXY
    rw [mul_smul_comm, smul_mul_assoc, hXY]

noncomputable instance truncatedFaceCreatorAlgebraCommRing (d : ℕ) :
    CommRing (truncatedFaceCreatorAlgebra d) :=
  { (inferInstance : Ring (truncatedFaceCreatorAlgebra d)) with
    mul_comm := truncatedFaceCreatorAlgebra_mul_comm }

theorem truncatedFaceCreator_mem_faceCreatorAlgebra_all
    {d : ℕ} (T : TensorFace d) :
    truncatedFaceCreator T ∈ truncatedFaceCreatorAlgebra d := by
  classical
  by_cases hT : T.card ≤ d - 2
  · exact truncatedFaceCreator_mem_span ⟨T, hT⟩
  · rw [truncatedFaceCreator_eq_zero_of_large T (Nat.lt_of_not_ge hT)]
    exact (truncatedFaceCreatorAlgebra d).zero_mem

theorem prod_truncatedCreatorElement_eq_faceCreator
    {d : ℕ} (T : TensorFace d) :
    (∏ i ∈ T, truncatedCreatorElement i) =
      (⟨truncatedFaceCreator T,
        truncatedFaceCreator_mem_faceCreatorAlgebra_all T⟩ :
          truncatedFaceCreatorAlgebra d) := by
  classical
  induction T using Finset.induction_on with
  | empty =>
      apply Subtype.ext
      change (1 : Module.End ℂ (TruncatedFaceFock d)) = truncatedFaceCreator ∅
      exact truncatedFaceCreator_empty.symm
  | @insert i T hi ih =>
      rw [Finset.prod_insert hi, ih]
      apply Subtype.ext
      apply LinearMap.ext
      intro x
      exact truncatedFaceCreator_comp_of_disjoint (by simp [hi]) x

def factorFaceCreatorPolynomialHom (n : ℕ) :
    FactorTensorPolynomial ℂ (n + 2) →ₐ[ℂ] truncatedFaceCreatorAlgebra (n + 2) :=
  MvPolynomial.aeval (R := ℂ) (S₁ := truncatedFaceCreatorAlgebra (n + 2))
    truncatedCreatorElement

@[simp] theorem factorFaceCreatorPolynomialHom_X
    {n : ℕ} (i : Fin (n + 2)) :
    factorFaceCreatorPolynomialHom n (MvPolynomial.X i) = truncatedCreatorElement i := by
  rw [factorFaceCreatorPolynomialHom, MvPolynomial.aeval_X]

theorem factorFaceCreatorPolynomialHom_faceMonomial
    {n : ℕ} (T : TensorFace (n + 2)) :
    factorFaceCreatorPolynomialHom n (factorFaceMonomial T) =
      (⟨truncatedFaceCreator T,
        truncatedFaceCreator_mem_faceCreatorAlgebra_all T⟩ :
          truncatedFaceCreatorAlgebra (n + 2)) := by
  rw [factorFaceMonomial, map_prod]
  simp only [factorFaceCreatorPolynomialHom_X]
  exact prod_truncatedCreatorElement_eq_faceCreator T

theorem factorSquareRelationIdeal_le_creatorPolynomialHom_ker (n : ℕ) :
    (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ≤
      RingHom.ker (factorFaceCreatorPolynomialHom n).toRingHom := by
  rw [factorSquareRelationIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  change factorFaceCreatorPolynomialHom n (factorSquareRelation i) = 0
  rw [factorSquareRelation, map_pow,
    factorFaceCreatorPolynomialHom_X]
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  exact truncatedCreator_sq_zero i x

theorem factorComplementIdeal_le_creatorPolynomialHom_ker (n : ℕ) :
    (factorComplementIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ≤
      RingHom.ker (factorFaceCreatorPolynomialHom n).toRingHom := by
  rw [factorComplementIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  change factorFaceCreatorPolynomialHom n (factorTensorComplement i) = 0
  rw [factorTensorComplement]
  change factorFaceCreatorPolynomialHom n
      (factorFaceMonomial (Finset.univ.erase i)) = 0
  rw [factorFaceCreatorPolynomialHom_faceMonomial]
  apply Subtype.ext
  change truncatedFaceCreator (Finset.univ.erase i) = 0
  apply truncatedFaceCreator_eq_zero_of_large
  rw [Finset.card_erase_of_mem (Finset.mem_univ i), Finset.card_univ,
    Fintype.card_fin]
  omega

theorem factorFaceRelationIdeal_le_creatorPolynomialHom_ker (n : ℕ) :
    ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ (n + 2))) ⊔
      factorComplementIdeal) ≤
      RingHom.ker (factorFaceCreatorPolynomialHom n).toRingHom := by
  rw [sup_le_iff]
  exact ⟨factorSquareRelationIdeal_le_creatorPolynomialHom_ker n,
    factorComplementIdeal_le_creatorPolynomialHom_ker n⟩

def complexFactorFaceToCreatorHom (n : ℕ) :
    ComplexFactorSquarefreeFaceAlgebra n →ₐ[ℂ]
      truncatedFaceCreatorAlgebra (n + 2) :=
  Ideal.Quotient.liftₐ _ (factorFaceCreatorPolynomialHom n) (by
    intro p hp
    change p ∈ RingHom.ker (factorFaceCreatorPolynomialHom n).toRingHom
    exact factorFaceRelationIdeal_le_creatorPolynomialHom_ker n hp)

@[simp] theorem complexFactorFaceToCreatorHom_faceClass
    {n : ℕ} (T : ClosedHorizonFace (n + 2)) :
    complexFactorFaceToCreatorHom n (complexFactorFaceClass T) =
      (⟨truncatedFaceCreator T.1,
        truncatedFaceCreator_mem_faceCreatorAlgebra_all T.1⟩ :
          truncatedFaceCreatorAlgebra (n + 2)) := by
  exact factorFaceCreatorPolynomialHom_faceMonomial T.1

theorem complexFactorFaceToCreatorHom_synthesis
    (n : ℕ) (x : TruncatedFaceFock (n + 2)) :
    complexFactorFaceToCreatorHom n (complexFactorFaceSynthesis n x) =
      closedHorizonFaceEquivCreatorAlgebra (n + 2) x := by
  change complexFactorFaceToCreatorHom n
      (∑ T, x T • complexFactorFaceClass T) = _
  rw [map_sum]
  simp only [map_smul, complexFactorFaceToCreatorHom_faceClass]
  apply Subtype.ext
  rw [Submodule.coe_sum (truncatedFaceCreatorAlgebra (n + 2)).toSubmodule]
  simp only [Subalgebra.coe_smul]
  change (∑ T, x T • truncatedFaceCreator T.1) = faceCoefficientOperator (n + 2) x
  rfl

theorem complexFactorFaceToCreatorHom_surjective (n : ℕ) :
    Function.Surjective (complexFactorFaceToCreatorHom n) := by
  intro y
  let x := (closedHorizonFaceEquivCreatorAlgebra (n + 2)).symm y
  refine ⟨complexFactorFaceSynthesis n x, ?_⟩
  rw [complexFactorFaceToCreatorHom_synthesis]
  exact (closedHorizonFaceEquivCreatorAlgebra (n + 2)).apply_symm_apply y

theorem complexFactorFaceToCreatorHom_injective (n : ℕ) :
    Function.Injective (complexFactorFaceToCreatorHom n) := by
  letI : Module.Finite ℂ (ComplexFactorSquarefreeFaceAlgebra n) :=
    Module.Finite.of_surjective (complexFactorFaceSynthesis n)
      (complexFactorFaceSynthesis_surjective n)
  have hsource_le : Module.finrank ℂ (ComplexFactorSquarefreeFaceAlgebra n) ≤
      Module.finrank ℂ (TruncatedFaceFock (n + 2)) :=
    LinearMap.finrank_le_finrank_of_surjective
      (complexFactorFaceSynthesis_surjective n)
  have htarget_eq : Module.finrank ℂ (truncatedFaceCreatorAlgebra (n + 2)) =
      Module.finrank ℂ (TruncatedFaceFock (n + 2)) :=
    (closedHorizonFaceEquivCreatorAlgebra (n + 2)).finrank_eq.symm
  have htarget_le : Module.finrank ℂ (truncatedFaceCreatorAlgebra (n + 2)) ≤
      Module.finrank ℂ (ComplexFactorSquarefreeFaceAlgebra n) :=
    LinearMap.finrank_le_finrank_of_surjective
      (f := (complexFactorFaceToCreatorHom n).toLinearMap)
      (complexFactorFaceToCreatorHom_surjective n)
  have heq : Module.finrank ℂ (ComplexFactorSquarefreeFaceAlgebra n) =
      Module.finrank ℂ (truncatedFaceCreatorAlgebra (n + 2)) := by
    omega
  let f := (complexFactorFaceToCreatorHom n).toLinearMap
  have hrange : LinearMap.range f = ⊤ :=
    LinearMap.range_eq_top.mpr (complexFactorFaceToCreatorHom_surjective n)
  have hrank := LinearMap.finrank_range_add_finrank_ker f
  have hfrange : Module.finrank ℂ (LinearMap.range f) =
      Module.finrank ℂ (truncatedFaceCreatorAlgebra (n + 2)) :=
    (LinearEquiv.ofTop (LinearMap.range f) hrange).finrank_eq
  rw [hfrange, ← heq] at hrank
  have hkerRank : Module.finrank ℂ (LinearMap.ker f) = 0 := by omega
  have hker : LinearMap.ker f = ⊥ := Submodule.finrank_eq_zero.mp hkerRank
  exact LinearMap.ker_eq_bot.mp hker

/-- **Card `(27)`, literal quotient form.** The polynomial closed-horizon face algebra with
relations `fᵢ² = 0` and all `(d-1)`-fold complementary products zero is exactly the complete
compressed hard-core creator algebra, for every `d = n + 2`. -/
def complexFactorSquarefreeFaceAlgEquivCreatorAlgebra (n : ℕ) :
    ComplexFactorSquarefreeFaceAlgebra n ≃ₐ[ℂ]
      truncatedFaceCreatorAlgebra (n + 2) :=
  AlgEquiv.ofBijective (complexFactorFaceToCreatorHom n)
    ⟨complexFactorFaceToCreatorHom_injective n,
      complexFactorFaceToCreatorHom_surjective n⟩

/-! ## Literal `ℂ[[X]]` closed-horizon specialization -/

def powerSeriesFactorResiduePolynomialEquiv (d : ℕ) :
    FactorTensorPolynomial
        (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d ≃+*
      FactorTensorPolynomial ℂ d :=
  MvPolynomial.mapEquiv _ (powerSeriesResidueEquiv (k := ℂ)).toRingEquiv

@[simp] theorem powerSeriesFactorResiduePolynomialEquiv_X
    {d : ℕ} (i : Fin d) :
    powerSeriesFactorResiduePolynomialEquiv d (MvPolynomial.X i) =
      MvPolynomial.X i := by
  simp [powerSeriesFactorResiduePolynomialEquiv]

theorem powerSeriesFactorFaceRelations_forward (d : ℕ) :
    ((factorSquareRelationIdeal :
        Ideal (FactorTensorPolynomial
          (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ⊔
      factorComplementIdeal) ≤
      Ideal.comap (powerSeriesFactorResiduePolynomialEquiv d).toRingHom
        ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
          factorComplementIdeal) := by
  rw [sup_le_iff]
  constructor
  · rw [factorSquareRelationIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change powerSeriesFactorResiduePolynomialEquiv d
      (factorSquareRelation
        (k := FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) i) ∈
      ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
        factorComplementIdeal)
    have hs : factorSquareRelation (k := ℂ) i ∈
        (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) := by
      apply Ideal.subset_span
      exact ⟨i, rfl⟩
    have hle : (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ≤
        factorSquareRelationIdeal ⊔ factorComplementIdeal := le_sup_left
    simpa [factorSquareRelation] using hle hs
  · rw [factorComplementIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change powerSeriesFactorResiduePolynomialEquiv d
      (factorTensorComplement
        (R := FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) i) ∈
      ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
        factorComplementIdeal)
    have hc : factorTensorComplement (R := ℂ) i ∈
        (factorComplementIdeal : Ideal (FactorTensorPolynomial ℂ d)) := by
      apply Ideal.subset_span
      exact ⟨i, rfl⟩
    have hle : (factorComplementIdeal : Ideal (FactorTensorPolynomial ℂ d)) ≤
        factorSquareRelationIdeal ⊔ factorComplementIdeal := le_sup_right
    simpa [factorTensorComplement] using hle hc

theorem powerSeriesFactorFaceRelations_backward (d : ℕ) :
    ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
      factorComplementIdeal) ≤
      Ideal.comap (powerSeriesFactorResiduePolynomialEquiv d).symm.toRingHom
        ((factorSquareRelationIdeal :
            Ideal (FactorTensorPolynomial
              (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ⊔
          factorComplementIdeal) := by
  rw [sup_le_iff]
  constructor
  · rw [factorSquareRelationIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change (powerSeriesFactorResiduePolynomialEquiv d).symm
      (factorSquareRelation (k := ℂ) i) ∈
      ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial
        (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ⊔
        factorComplementIdeal)
    have hs : factorSquareRelation
          (k := FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) i ∈
        (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial
          (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) := by
      apply Ideal.subset_span
      exact ⟨i, rfl⟩
    have hle : (factorSquareRelationIdeal : Ideal (FactorTensorPolynomial
          (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ≤
        factorSquareRelationIdeal ⊔ factorComplementIdeal := le_sup_left
    simpa [factorSquareRelation, powerSeriesFactorResiduePolynomialEquiv] using hle hs
  · rw [factorComplementIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change (powerSeriesFactorResiduePolynomialEquiv d).symm
      (factorTensorComplement (R := ℂ) i) ∈
      ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial
        (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ⊔
        factorComplementIdeal)
    have hc : factorTensorComplement
          (R := FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) i ∈
        (factorComplementIdeal : Ideal (FactorTensorPolynomial
          (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) := by
      apply Ideal.subset_span
      exact ⟨i, rfl⟩
    have hle : (factorComplementIdeal : Ideal (FactorTensorPolynomial
          (FactorResidueRing (PowerSeries.X : PowerSeries ℂ)) d)) ≤
        factorSquareRelationIdeal ⊔ factorComplementIdeal := le_sup_right
    simpa [factorTensorComplement, powerSeriesFactorResiduePolynomialEquiv] using hle hc

def powerSeriesFactorFaceForward (d : ℕ) :
    FactorSquarefreeFaceAlgebra (d := d)
        (PowerSeries.X : PowerSeries ℂ) →+*
      (FactorTensorPolynomial ℂ d ⧸
        ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
          factorComplementIdeal)) :=
  Ideal.quotientMap _ (powerSeriesFactorResiduePolynomialEquiv d).toRingHom
    (powerSeriesFactorFaceRelations_forward d)

def powerSeriesFactorFaceBackward (d : ℕ) :
    (FactorTensorPolynomial ℂ d ⧸
        ((factorSquareRelationIdeal : Ideal (FactorTensorPolynomial ℂ d)) ⊔
          factorComplementIdeal)) →+*
      FactorSquarefreeFaceAlgebra (d := d)
        (PowerSeries.X : PowerSeries ℂ) :=
  Ideal.quotientMap _ (powerSeriesFactorResiduePolynomialEquiv d).symm.toRingHom
    (powerSeriesFactorFaceRelations_backward d)

/-- Exact coefficient transport from the residue algebra of `ℂ[[X]]` to the complex
squarefree-face algebra. Both quotient ideals are transported generator by generator. -/
def powerSeriesFactorSquarefreeFaceRingEquiv (n : ℕ) :
    FactorSquarefreeFaceAlgebra (d := n + 2)
        (PowerSeries.X : PowerSeries ℂ) ≃+*
      ComplexFactorSquarefreeFaceAlgebra n where
  toFun := powerSeriesFactorFaceForward (n + 2)
  invFun := powerSeriesFactorFaceBackward (n + 2)
  left_inv x := by
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [powerSeriesFactorFaceForward, powerSeriesFactorFaceBackward]
  right_inv x := by
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [powerSeriesFactorFaceForward, powerSeriesFactorFaceBackward]
  map_mul' := map_mul (powerSeriesFactorFaceForward (n + 2))
  map_add' := map_add (powerSeriesFactorFaceForward (n + 2))

abbrev ComplexPowerSeriesFactorJacobianClosedFibre (n : ℕ) :=
  FactorJacobianClosedFibre (PowerSeries.X : PowerSeries ℂ)
    (fun _ : Fin (n + 2) => 1)

/-- **Card `(27)`, literal `ℂ[[X]]` specialization.** For every `n`, the actual depth-one
factor-Jacobian algebra, reduced at the closed horizon `X = 0`, is exactly the full algebra of
compressed hard-core creation operators on faces of size at most `n`. No presentation proxy or
conditional identification occurs in the statement. -/
def complexPowerSeriesFactorJacobianClosedFibreEquivCreatorAlgebra (n : ℕ) :
    ComplexPowerSeriesFactorJacobianClosedFibre n ≃+*
      truncatedFaceCreatorAlgebra (n + 2) :=
  (factorJacobianClosedFibreEquivSquarefreeFace
      (PowerSeries.X : PowerSeries ℂ) (fun _ : Fin (n + 2) => 1) (by simp)).trans
    ((powerSeriesFactorSquarefreeFaceRingEquiv n).trans
      (complexFactorSquarefreeFaceAlgEquivCreatorAlgebra n).toRingEquiv)

end

