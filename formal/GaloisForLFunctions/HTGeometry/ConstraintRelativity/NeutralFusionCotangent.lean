import Mathlib
import GaloisForLFunctions.HTGeometry.DifferentialIndependentFieldUniversality
import GaloisForLFunctions.HTGeometry.DifferentialSubfieldTransfer

/-!
# Neutral fusion and the unobstructed relative cotangent

A differentially independent family generates a differential field which, as an ordinary field, is
the fraction field of a polynomial ring on the jets.  Such an extension is formally smooth, so its
first cotangent homology vanishes, while its module of Kähler differentials is free on the jets.
Creation of new differential degrees of freedom therefore carries no cotangent obstruction.

The transport of a Kähler basis along an algebra isomorphism is built here; mathlib has the
polynomial basis and the localization base change but not the isomorphism transport.
-/

open scoped Differential TensorProduct

open GaloisForLFunctions

namespace HTGeometry.ConstraintRelativity

universe u

/-! ## Transport of Kähler differentials along an algebra isomorphism -/

section Transport

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]

/-- The `S`-algebra structure on `T` carried by an isomorphism. -/
@[reducible] noncomputable def algebraOfAlgEquiv (e : S ≃ₐ[R] T) : Algebra S T :=
  (e : S →+* T).toAlgebra

/-- The Kähler differentials of isomorphic algebras have bases of the same index type. -/
noncomputable def kaehlerBasisOfAlgEquiv (e : S ≃ₐ[R] T) {ι : Type*}
    (b : Module.Basis ι S (Ω[S⁄R])) : Module.Basis ι T (Ω[T⁄R]) := by
  letI : Algebra S T := algebraOfAlgEquiv e
  haveI : IsScalarTower R S T := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    show algebraMap R T r = e (algebraMap R S r)
    rw [AlgEquiv.commutes]
  letI eS : S ≃ₐ[S] T :=
    { e with commutes' := fun _ => rfl }
  haveI : Algebra.FormallyEtale S T := Algebra.FormallyEtale.of_equiv eS
  have hbc : IsBaseChange T (KaehlerDifferential.map R R S T) :=
    KaehlerDifferential.isBaseChange_of_formallyEtale R S T
  exact (b.baseChange T).map hbc.equiv

end Transport

/-! ## The jet field of a differentially independent family -/

section NeutralFusion

variable {C K ι : Type u} [Field C] [Field K] [Algebra C K] [Differential K]

/-- The jet polynomial ring of a family. -/
abbrev jetPolynomial (C ι : Type*) [Field C] : Type _ := MvPolynomial (ι × ℕ) C

/-- **Card `(3)`.**  The differential field generated by a differentially independent family is,
as an ordinary field, the fraction field of the jet polynomial ring. -/
noncomputable def fusionJetParametrization (x : ι → K) (hx : DifferentialIndependent C x) :
    FractionRing (jetPolynomial C ι) ≃ₐ[C] differentialAdjoin C (Set.range x) :=
  differentialIndependentAdjoinParametrization x hx

/-- The jet field is formally smooth: it is a localization of a polynomial algebra. -/
instance formallySmooth_fractionRing_jetPolynomial :
    Algebra.FormallySmooth C (FractionRing (jetPolynomial C ι)) := by
  haveI : Algebra.FormallySmooth (jetPolynomial C ι) (FractionRing (jetPolynomial C ι)) :=
    Algebra.FormallySmooth.of_isLocalization (nonZeroDivisors (jetPolynomial C ι))
  exact Algebra.FormallySmooth.comp C (jetPolynomial C ι) _

/-- The generated differential field is formally smooth over the coefficient field. -/
theorem formallySmooth_fusionField (x : ι → K) (hx : DifferentialIndependent C x) :
    Algebra.FormallySmooth C (differentialAdjoin C (Set.range x)) :=
  Algebra.FormallySmooth.of_equiv (fusionJetParametrization x hx)

/-- **Card `(4)`.**  The relative cotangent complex of a neutral fusion extension has no
positive-degree homology: creation of differential freedom is unobstructed. -/
theorem subsingleton_h1Cotangent_fusionField (x : ι → K) (hx : DifferentialIndependent C x) :
    Subsingleton (Algebra.H1Cotangent C (differentialAdjoin C (Set.range x))) := by
  haveI := formallySmooth_fusionField x hx
  infer_instance

/-- The Kähler differentials of the jet field are free on the jet variables. -/
noncomputable def jetFieldKaehlerBasis (C ι : Type*) [Field C] :
    Module.Basis (ι × ℕ) (FractionRing (jetPolynomial C ι))
      (Ω[FractionRing (jetPolynomial C ι)⁄C]) := by
  have hbc : IsBaseChange (FractionRing (jetPolynomial C ι))
      (KaehlerDifferential.map C C (jetPolynomial C ι) (FractionRing (jetPolynomial C ι))) :=
    (isLocalizedModule_iff_isBaseChange (nonZeroDivisors (jetPolynomial C ι)) _ _).mp
      inferInstance
  exact ((KaehlerDifferential.mvPolynomialBasis C (ι × ℕ)).baseChange
    (FractionRing (jetPolynomial C ι))).map hbc.equiv

/-- **Card `(5)`.**  The module of Kähler differentials of a neutral fusion extension is free with
one basis vector for every jet of every member of the family. -/
noncomputable def fusionKaehlerBasis (x : ι → K) (hx : DifferentialIndependent C x) :
    Module.Basis (ι × ℕ) (differentialAdjoin C (Set.range x))
      (Ω[differentialAdjoin C (Set.range x)⁄C]) :=
  kaehlerBasisOfAlgEquiv (fusionJetParametrization x hx) (jetFieldKaehlerBasis C ι)

/-- The Kähler module of a neutral fusion extension is free. -/
theorem free_kaehler_fusionField (x : ι → K) (hx : DifferentialIndependent C x) :
    Module.Free (differentialAdjoin C (Set.range x))
      (Ω[differentialAdjoin C (Set.range x)⁄C]) :=
  Module.Free.of_basis (fusionKaehlerBasis x hx)

/-- The rank of the relative Kähler module is the number of jets. -/
theorem rank_kaehler_fusionField (x : ι → K) (hx : DifferentialIndependent C x) :
    Module.rank (differentialAdjoin C (Set.range x))
      (Ω[differentialAdjoin C (Set.range x)⁄C]) = Cardinal.mk (ι × ℕ) :=
  (fusionKaehlerBasis x hx).mk_eq_rank''.symm

/-- **Card `(6)`.**  The differential transcendence degree of a neutral fusion extension is the
size of the fused family: the extension is genuinely creative. -/
theorem differentialTranscendenceDegree_fusionField [Differential C] [DifferentialAlgebra C K]
    [CharZero K] (x : ι → K) (hx : DifferentialIndependent C x) :
    letI := derivationClosedDifferential (differentialAdjoin C (Set.range x))
      (derivationClosed_differentialAdjoin C (Set.range x))
    differentialTranscendenceDegree C (differentialAdjoin C (Set.range x)) = Cardinal.mk ι := by
  letI := derivationClosedDifferential (differentialAdjoin C (Set.range x))
    (derivationClosed_differentialAdjoin C (Set.range x))
  haveI : CharZero ↥(differentialAdjoin C (Set.range x)) :=
    RingHom.charZero (algebraMap ↥(differentialAdjoin C (Set.range x)) K)
  have hlift : DifferentialIndependent C (adjoinLift C x) :=
    differentialIndependent_subfield (differentialAdjoin C (Set.range x))
      (derivationClosed_differentialAdjoin C (Set.range x)) (adjoinLift C x) (by simpa using hx)
  exact differentialTranscendenceDegree_eq_cardinalMk_of_differentialIndependent_of_adjoin_eq_top
    (adjoinLift C x) hlift (differentialAdjoin_adjoinLift_eq_top x)

/-- The jet shift is injective on the index set of the basis: `d(∂^j x_z)` for `j ≥ 0` is an
infinite tower over each `dx_z`, and the derivation of `Ω` moves each basis vector one step up
that tower. -/
theorem jet_shift_injective (i : ι) : Function.Injective (fun n : ℕ => (i, n + 1)) := by
  intro m n h
  simpa using h

/-- **Consequence: creation and obstruction are independent.**  A neutral fusion extension is
genuinely creative — its differential transcendence degree is the size of the fused family — while
its relative cotangent complex has no positive-degree homology.  Both hold at once, so the
universal equation "obstruction ≃ successor law" is false when *obstruction* means a
relation/anomaly class: a nonzero relative law object coexists with a vanishing positive-degree
cotangent obstruction. -/
theorem creation_without_obstruction [Differential C] [DifferentialAlgebra C K] [CharZero K]
    (x : ι → K) (hx : DifferentialIndependent C x) :
    (letI := derivationClosedDifferential (differentialAdjoin C (Set.range x))
      (derivationClosed_differentialAdjoin C (Set.range x))
     differentialTranscendenceDegree C (differentialAdjoin C (Set.range x)) = Cardinal.mk ι)
    ∧ Subsingleton (Algebra.H1Cotangent C (differentialAdjoin C (Set.range x))) :=
  ⟨differentialTranscendenceDegree_fusionField x hx, subsingleton_h1Cotangent_fusionField x hx⟩

end NeutralFusion

end HTGeometry.ConstraintRelativity
