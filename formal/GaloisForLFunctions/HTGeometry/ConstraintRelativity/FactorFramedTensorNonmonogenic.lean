import GaloisForLFunctions.HTGeometry.ConstraintRelativity.FactorFramedTensorGradient
import GaloisForLFunctions.HTGeometry.TameInertiaRigidity

/-!
# The factor tensor order is nonmonogenic

The positive-depth factor tensor order has a canonical quotient onto the trivial square-zero
extension by its full `d`-dimensional cotangent space.  A trivial square-zero extension with at
least two tangent directions cannot be generated by one element: every polynomial in one element
has tangent component on the single line through that element.  Surjectivity therefore proves the
literal tensor order nonmonogenic for every `d ≥ 2`.
-/

namespace HTGeometry.ConstraintRelativity

open scoped BigOperators

noncomputable section

abbrev FactorSquareZeroFibre (k : Type*) [Field k] (d : ℕ) :=
  TrivSqZeroExt k (Fin d → k)

def factorSquareZeroLineSubalgebra
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (x : FactorSquareZeroFibre k d) : Subalgebra R (FactorSquareZeroFibre k d) where
  carrier := {y | y.snd ∈ Submodule.span k {x.snd}}
  zero_mem' := by simp
  add_mem' := by
    intro y z hy hz
    rw [Set.mem_setOf_eq, TrivSqZeroExt.snd_add]
    exact (Submodule.span k {x.snd}).add_mem hy hz
  mul_mem' := by
    intro y z hy hz
    rw [Set.mem_setOf_eq, TrivSqZeroExt.snd_mul]
    exact (Submodule.span k {x.snd}).add_mem
      ((Submodule.span k {x.snd}).smul_mem y.fst hz)
      (by simpa using ((Submodule.span k {x.snd}).smul_mem z.fst hy))
  one_mem' := by simp
  algebraMap_mem' := by
    intro _
    change (0 : Fin d → k) ∈ Submodule.span k {x.snd}
    exact (Submodule.span k {x.snd}).zero_mem

/-- A square-zero algebra with two independent tangent directions is not monogenic. -/
theorem factorSquareZeroFibre_not_monogenic
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (hd : 2 ≤ d) (x : FactorSquareZeroFibre k d) :
    Algebra.adjoin R ({x} : Set (FactorSquareZeroFibre k d)) ≠ ⊤ := by
  intro hx
  have hle : Algebra.adjoin R ({x} : Set (FactorSquareZeroFibre k d)) ≤
      factorSquareZeroLineSubalgebra (R := R) x := by
    apply Algebra.adjoin_le
    intro y hy
    have hyx : y = x := Set.mem_singleton_iff.mp hy
    subst y
    change x.snd ∈ Submodule.span k {x.snd}
    exact Submodule.mem_span_singleton_self x.snd
  have hall (y : FactorSquareZeroFibre k d) :
      y.snd ∈ Submodule.span k {x.snd} := by
    apply hle
    rw [hx]
    trivial
  let i : Fin d := ⟨0, by omega⟩
  let j : Fin d := ⟨1, by omega⟩
  have hij : i ≠ j := by simp [i, j]
  have hi := hall (TrivSqZeroExt.inr (Pi.single i (1 : k)))
  have hj := hall (TrivSqZeroExt.inr (Pi.single j (1 : k)))
  change Pi.single i (1 : k) ∈ Submodule.span k {x.snd} at hi
  change Pi.single j (1 : k) ∈ Submodule.span k {x.snd} at hj
  obtain ⟨ci, hci⟩ := Submodule.mem_span_singleton.mp hi
  obtain ⟨cj, hcj⟩ := Submodule.mem_span_singleton.mp hj
  have hcii := congrFun hci i
  have hcji := congrFun hcj i
  have hcjj := congrFun hcj j
  simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply, if_pos] at hcii hcjj
  simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply, if_neg hij] at hcji
  have hv : x.snd i ≠ 0 := by
    intro hv
    rw [hv, mul_zero] at hcii
    exact zero_ne_one hcii
  have hcj0 : cj = 0 := (mul_eq_zero.mp hcji).resolve_right hv
  rw [hcj0, zero_mul] at hcjj
  exact zero_ne_one hcjj

noncomputable def factorSquareZeroPolynomialMap
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ} :
    FactorTensorPolynomial R d →ₐ[R] FactorSquareZeroFibre k d :=
  MvPolynomial.aeval fun i => TrivSqZeroExt.inr (Pi.single i (1 : k))

theorem factorSquareZeroPolynomialMap_relation
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (a : R) (r : Fin d → ℕ) (hr : ∀ i, 0 < r i)
    (ha : algebraMap R k a = 0) (i : Fin d) :
    factorSquareZeroPolynomialMap (R := R) (k := k) (factorTensorRelation a r i) = 0 := by
  have hab : (algebraMap R (FactorSquareZeroFibre k d)) a = 0 := by
    change TrivSqZeroExt.inl (algebraMap R k a) = 0
    rw [ha]
    rfl
  have hexp : 2 * r i ≠ 0 := mul_ne_zero (by norm_num) (Nat.ne_of_gt (hr i))
  simp [factorSquareZeroPolynomialMap, factorTensorRelation, pow_two, hab,
    hexp, TrivSqZeroExt.inr_mul_inr]

/-- Canonical first-order closed-fibre quotient of the literal factor tensor order. -/
noncomputable def factorSquareZeroMap
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (a : R) (r : Fin d → ℕ) (hr : ∀ i, 0 < r i)
    (ha : algebraMap R k a = 0) :
    FactorTensorOrder a r →ₐ[R] FactorSquareZeroFibre k d :=
  Ideal.Quotient.liftₐ (factorTensorRelationIdeal a r)
    factorSquareZeroPolynomialMap (by
      intro p hp
      refine Submodule.span_induction
        (p := fun q _ => factorSquareZeroPolynomialMap (R := R) (k := k) q = 0)
        ?_ ?_ ?_ ?_ hp
      · intro q hq
        obtain ⟨i, rfl⟩ := hq
        exact factorSquareZeroPolynomialMap_relation a r hr ha i
      · exact map_zero _
      · intro x y _ _ hx hy
        rw [map_add, hx, hy, add_zero]
      · intro c x _ hx
        change factorSquareZeroPolynomialMap (R := R) (k := k) (c * x) = 0
        rw [map_mul, hx, mul_zero])

theorem factorSquareZeroPolynomialMap_surjective
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (hres : Function.Surjective (algebraMap R k)) :
    Function.Surjective
      (factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)) := by
  intro y
  obtain ⟨c, hc⟩ := hres y.fst
  choose v hv using fun i : Fin d => hres (y.snd i)
  let p : FactorTensorPolynomial R d :=
    MvPolynomial.C c + ∑ i : Fin d, MvPolynomial.C (v i) * MvPolynomial.X i
  refine ⟨p, ?_⟩
  have hc' : factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
      (MvPolynomial.C c) =
        (TrivSqZeroExt.inl y.fst : FactorSquareZeroFibre k d) := by
    have hC : factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
        (MvPolynomial.C c) =
          (TrivSqZeroExt.inl (algebraMap R k c) : FactorSquareZeroFibre k d) := by
      change factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
        (algebraMap R (FactorTensorPolynomial R d) c) = _
      rw [(factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)).commutes]
      rfl
    rw [hC, hc]
  have hv' (i : Fin d) : factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
      (MvPolynomial.C (v i) * MvPolynomial.X i) =
        TrivSqZeroExt.inr ((y.snd i) • Pi.single i (1 : k)) := by
    rw [map_mul]
    have hC : factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
        (MvPolynomial.C (v i)) =
          (TrivSqZeroExt.inl (algebraMap R k (v i)) : FactorSquareZeroFibre k d) := by
      change factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
        (algebraMap R (FactorTensorPolynomial R d) (v i)) = _
      rw [(factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)).commutes]
      rfl
    have hX : factorSquareZeroPolynomialMap (R := R) (k := k) (d := d)
        (MvPolynomial.X i) =
          (TrivSqZeroExt.inr (Pi.single i (1 : k)) : FactorSquareZeroFibre k d) := by
      exact MvPolynomial.aeval_X _ _
    rw [hC, hX, hv i, TrivSqZeroExt.inl_mul_inr]
  rw [show factorSquareZeroPolynomialMap (R := R) (k := k) (d := d) p =
      factorSquareZeroPolynomialMap (d := d) (MvPolynomial.C c) +
        ∑ i : Fin d, factorSquareZeroPolynomialMap (d := d)
          (MvPolynomial.C (v i) * MvPolynomial.X i) by simp [p], hc']
  simp_rw [hv']
  let inrAddHom : (Fin d → k) →+ FactorSquareZeroFibre k d :=
    { toFun := TrivSqZeroExt.inr
      map_zero' := rfl
      map_add' := by
        intro x z
        apply TrivSqZeroExt.ext <;> simp }
  have hsum : (∑ i : Fin d,
      TrivSqZeroExt.inr (y.snd i • Pi.single i (1 : k)) : FactorSquareZeroFibre k d) =
      TrivSqZeroExt.inr y.snd := by
    change (∑ i : Fin d, inrAddHom (y.snd i • Pi.single i (1 : k))) =
      inrAddHom y.snd
    rw [← map_sum inrAddHom]
    congr 1
    ext j
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    change (∑ i : Fin d,
      y.snd i * (Pi.single i (1 : k) : Fin d → k) j) = y.snd j
    rw [Finset.sum_eq_single j]
    · simp
    · intro i _ hij
      rw [Pi.single_apply, if_neg (Ne.symm hij), mul_zero]
    · intro hj
      exact (hj (Finset.mem_univ j)).elim
  rw [hsum]
  apply TrivSqZeroExt.ext <;> simp

theorem factorSquareZeroMap_surjective
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (a : R) (r : Fin d → ℕ) (hr : ∀ i, 0 < r i)
    (ha : algebraMap R k a = 0)
    (hres : Function.Surjective (algebraMap R k)) :
    Function.Surjective (factorSquareZeroMap a r hr ha) := by
  intro y
  obtain ⟨p, hp⟩ := factorSquareZeroPolynomialMap_surjective (d := d) hres y
  exact ⟨Ideal.Quotient.mk _ p, hp⟩

/-- **Card `(10z)`, nonmonogenic conclusion.** Every positive-depth factor tensor order with at
least two factors is not generated by one element over the base. -/
theorem factorTensorOrder_not_monogenic
    {R k : Type*} [CommRing R] [Field k] [Algebra R k] {d : ℕ}
    (hd : 2 ≤ d) (a : R) (r : Fin d → ℕ) (hr : ∀ i, 0 < r i)
    (ha : algebraMap R k a = 0)
    (hres : Function.Surjective (algebraMap R k)) :
    ¬ ∃ x : FactorTensorOrder a r,
      Algebra.adjoin R ({x} : Set (FactorTensorOrder a r)) = ⊤ := by
  rintro ⟨x, hx⟩
  have himage := adjoin_image_singleton_eq_top
    (factorSquareZeroMap a r hr ha)
    (factorSquareZeroMap_surjective a r hr ha hres) hx
  exact factorSquareZeroFibre_not_monogenic hd
    (factorSquareZeroMap a r hr ha x) himage

/-- **Card `(10z)`, canonical residue specialization.** No residue-field map is assumed: the
literal factor tensor order maps to the square-zero extension over `R/(a)`, so every
positive-depth order with at least two factors is nonmonogenic. -/
theorem factorTensorOrder_not_monogenic_mod_uniformizer
    {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {d : ℕ}
    (hd : 2 ≤ d) (a : R) (ha : Irreducible a)
    (r : Fin d → ℕ) (hr : ∀ i, 0 < r i) :
    ¬ ∃ x : FactorTensorOrder a r,
      Algebra.adjoin R ({x} : Set (FactorTensorOrder a r)) = ⊤ := by
  have hspan : Ideal.span {a} = IsLocalRing.maximalIdeal R := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst x
      by_contra hmem
      exact ha.not_isUnit (IsLocalRing.notMem_maximalIdeal.mp hmem)
    · intro x hx
      obtain ⟨c, rfl⟩ :=
        GaloisForLFunctions.HTGeometry.dvd_of_mem_maximalIdeal ha hx
      rw [Ideal.mem_span_singleton]
      exact ⟨c, rfl⟩
  letI : (Ideal.span {a}).IsMaximal := by
    rw [hspan]
    exact IsLocalRing.maximalIdeal.isMaximal R
  letI : Field (R ⧸ Ideal.span {a}) := Ideal.Quotient.field _
  apply factorTensorOrder_not_monogenic
    (k := R ⧸ Ideal.span {a}) hd a r hr
  · rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_singleton a)
  · exact Ideal.Quotient.mk_surjective

end

end HTGeometry.ConstraintRelativity
