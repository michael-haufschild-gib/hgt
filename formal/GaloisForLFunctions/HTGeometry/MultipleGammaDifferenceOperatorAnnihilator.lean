import GaloisForLFunctions.HTGeometry.MultipleGammaTransverseDepthNecessity
import GaloisForLFunctions.HTGeometry.SquarefreeVeroneseIdeal
import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaStructuralSpanDecomposition

/-!
# Difference-operator action and the squarefree annihilator

Operators in the structural difference variables `x_j = T_{τ_j} - 1` act on the multiple elliptic
gamma logarithmic derivative through the iterated difference of the corresponding multidegree.  A
monomial uses exactly the directions in its support, so the transverse-depth law reads off its
differential algebraicity from the number of distinct variables it contains.

Consequently every operator lying in the squarefree Veronese ideal generated by the `r`-fold
squarefree products annihilates the source modulo differentially algebraic functions, where `r` is
one less than the number of periods: that is the inclusion `I_r ⊆ Ann_DA(Ψ_r)`.
-/

open Filter Set Topology Function Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions

open Bottcher HTGeometry VeroneseIdeal

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## The multidegree list of a monomial -/

/-- A list containing every direction with its monomial multiplicity. -/
def multiDegreeList (d : ι →₀ ℕ) : List ι :=
  d.support.toList.flatMap fun i => List.replicate (d i) i

omit [Fintype ι] in
theorem multiDegreeList_toFinset (d : ι →₀ ℕ) : (multiDegreeList d).toFinset = d.support := by
  classical
  ext a
  simp only [multiDegreeList, List.mem_toFinset, List.mem_flatMap, List.mem_replicate,
    Finset.mem_toList]
  constructor
  · rintro ⟨i, hi, hne, rfl⟩
    exact hi
  · intro ha
    exact ⟨a, ha, ⟨Finsupp.mem_support_iff.mp ha, rfl⟩⟩

/-! ## The difference-operator action -/

/-- The action of a difference monomial on a germ. -/
def xMonomialApply (τ : ι → ℂ) (d : ι →₀ ℕ) (y : meroField (Set.univ : Set ℂ)) :
    meroField (Set.univ : Set ℂ) :=
  listShiftDiff τ (multiDegreeList d) y

/-- The action of a difference operator on a germ. -/
def xApply (τ : ι → ℂ) (P : MvPolynomial ι ℂ) (y : meroField (Set.univ : Set ℂ)) :
    meroField (Set.univ : Set ℂ) :=
  ∑ d ∈ P.support,
    algebraMap ℂ (meroField (Set.univ : Set ℂ)) (MvPolynomial.coeff d P) * xMonomialApply τ d y

/-! ## Monomials with many distinct directions are differentially algebraic -/

/-- A difference monomial whose support leaves at most one surviving period is differentially
algebraic on the source. -/
theorem differentialAlgebraicOver_xMonomialApply
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (d : ι →₀ ℕ)
    (hd : ∀ i j : ι, i ∉ d.support → j ∉ d.support → i = j) :
    DifferentialAlgebraicOver (RatFunc ℂ)
      (xMonomialApply τ d (multipleEllipticGammaLogDerivMero τ hτ)) := by
  refine differentialAlgebraicOver_listShiftDiff_multipleEllipticGammaLogDerivMero
    τ hτ (multiDegreeList d) d.support ?_ hd
  rw [multiDegreeList_toFinset]

theorem differentialAlgebraicOver_complexMul (a : ℂ) {y : meroField (Set.univ : Set ℂ)}
    (hy : DifferentialAlgebraicOver (RatFunc ℂ) y) :
    DifferentialAlgebraicOver (RatFunc ℂ)
      (algebraMap ℂ (meroField (Set.univ : Set ℂ)) a * y) :=
  differentialAlgebraicOver_mul (differentialAlgebraicOver_algebraMap_complex a) hy

/-! ## The squarefree ideal annihilates the source modulo differentially algebraic functions -/

/-- **`I_r ⊆ Ann_DA(Ψ_r)`.**  If every monomial of a difference operator uses at least `r` distinct
directions, and `r` distinct directions already leave at most one surviving period, then the
operator sends the source into the differentially algebraic locus. -/
theorem differentialAlgebraicOver_xApply_of_mem_veroneseIdeal
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (r : ℕ)
    (hr : ∀ S : Finset ι, r ≤ S.card → ∀ i j : ι, i ∉ S → j ∉ S → i = j)
    {P : MvPolynomial ι ℂ} (hP : P ∈ veroneseIdeal ℂ ι r) :
    DifferentialAlgebraicOver (RatFunc ℂ)
      (xApply τ P (multipleEllipticGammaLogDerivMero τ hτ)) := by
  classical
  rw [xApply]
  refine differentialAlgebraicOver_finset_sum _ fun d hd => ?_
  refine differentialAlgebraicOver_complexMul _ ?_
  exact differentialAlgebraicOver_xMonomialApply τ hτ d
    (hr d.support ((mem_veroneseIdeal_iff P).mp hP d (MvPolynomial.mem_support_iff.mp hd)))

/-- On a period family with `r + 1` members, `r` distinct directions always leave at most one
surviving period. -/
theorem card_le_one_compl_of_card_le (r : ℕ) (hcard : Fintype.card ι = r + 1)
    (S : Finset ι) (hS : r ≤ S.card) (i j : ι) (hi : i ∉ S) (hj : j ∉ S) : i = j := by
  classical
  have htotal := Finset.card_add_card_compl S
  rw [hcard] at htotal
  have hcompl : (Sᶜ).card ≤ 1 := by omega
  exact Finset.card_le_one.mp hcompl i (Finset.mem_compl.mpr hi) j (Finset.mem_compl.mpr hj)

/-- **Order-`r` form of the inclusion.**  For a family of `r + 1` periods, every element of the
squarefree Veronese ideal `I_r` annihilates the order-`r` source modulo differentially algebraic
functions. -/
theorem differentialAlgebraicOver_xApply_of_mem_veroneseIdeal_of_card
    (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (r : ℕ) (hcard : Fintype.card ι = r + 1)
    {P : MvPolynomial ι ℂ} (hP : P ∈ veroneseIdeal ℂ ι r) :
    DifferentialAlgebraicOver (RatFunc ℂ)
      (xApply τ P (multipleEllipticGammaLogDerivMero τ hτ)) :=
  differentialAlgebraicOver_xApply_of_mem_veroneseIdeal τ hτ r
    (card_le_one_compl_of_card_le r hcard) hP

end

end GaloisForLFunctions
