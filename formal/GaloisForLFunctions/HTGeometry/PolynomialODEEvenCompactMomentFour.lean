  unfold oddCompactReflectedScalar8
  rw [evenCompactUnitGap_pow_two, evenCompactUnitGap_pow_three, evenCompactUnitGap_pow_four, evenCompactUnitGap_pow_five, evenCompactUnitGap_pow_six]
