import GaloisForLFunctions.HTGeometry.GaussianPrimitiveTranscendence
import GaloisForLFunctions.HTGeometry.CompositionShadowLawConsequences
import GaloisForLFunctions.HTGeometry.MeroTranscendentalConstants
import GaloisForLFunctions.HTGeometry.TranscendenceDegreeOneVariable
import GaloisForLFunctions.HTGeometry.TrdegMutuallyAlgebraic
import GaloisForLFunctions.HTGeometry.DifferentialFieldLocus

/-!
# The Gaussian primitive has differential rank three and shadow rank two

The coordinate, the Gaussian exponential `exp(-z²)` and a primitive `G` of it are algebraically
independent over `ℂ`, and every jet of `G` lies in the field they generate: the second derivative of
`G` is `-2z·exp(-z²)` and the derivation never leaves the three-generator field.  Hence the jet field
of `G` is exactly `ℂ(z, exp(-z²), G)`, of transcendence degree three, while the shadow field — the
field of the derivatives of positive order — is `ℂ(z, exp(-z²))`, of transcendence degree two.

The primitive defect of `G` is therefore one: a primitive of a rank-two function can have rank
three, and the two ranks of an entire differentially algebraic function genuinely differ.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open scoped Differential

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

/-! ### Jets are iterated derivatives -/

theorem jetElem_succ_eq_deriv {f : ℂ → ℂ} (hf : Differentiable ℂ f) (k : ℕ) :
    jetElem hf (k + 1) = (jetElem hf k)′ := by
  rw [jetElem, jetElem, deriv_analyticMeroElement']
  exact analyticMeroElement_congr _ _ (iteratedDeriv_succ (n := k) (f := f))

theorem jetElem_gaussPrimitive_zero :
    jetElem differentiable_gaussPrimitive 0 = gaussPrimElem := by
  rw [jetElem, gaussPrimElem]
  exact analyticMeroElement_congr _ _ (iteratedDeriv_zero (f := gaussPrimitive))

theorem jetElem_gaussPrimitive_one :
    jetElem differentiable_gaussPrimitive 1 = gaussElem := by
  rw [jetElem, gaussElem]
  refine analyticMeroElement_congr _ _ ?_
  rw [iteratedDeriv_one, deriv_gaussPrimitive]

/-! ### The coordinate -/

theorem deriv_coordElem : coordElem′ = 1 := by
  rw [coordElem, deriv_analyticMeroElement']
  have h : (1 : meroField (Set.univ : Set ℂ))
      = analyticMeroElement (fun _ : ℂ => (1 : ℂ)) analyticOnNhd_const := by
    rw [analyticMeroElement_const]
    exact (map_one _).symm
  rw [h]
  exact analyticMeroElement_congr _ _ (by funext z; simp)

/-- **The coordinate is transcendental over the constants.** -/
theorem transcendental_coordElem : Transcendental ℂ coordElem := by
  refine transcendental_analyticMeroElement_of_nonconstant differentiable_id
    analyticOnNhd_coord ?_
  rintro ⟨c, hc⟩
  have h0 : (0 : ℂ) = c := hc 0
  have h1 : (1 : ℂ) = c := hc 1
  rw [← h0] at h1
  exact one_ne_zero h1

/-- The coordinate is a rational function. -/
theorem coordElem_mem_ratField : coordElem ∈ ratField := by
  refine ⟨algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X, ?_⟩
  rw [← analyticMeroElement_polyGerm Polynomial.X, coordElem]
  exact analyticMeroElement_congr _ _ (by funext z; simp)

/-! ### The three generators and their field -/

/-- The coordinate, the Gaussian exponential and the Gaussian primitive. -/
def gaussTriple : Set (meroField (Set.univ : Set ℂ)) :=
  insert gaussPrimElem (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))

theorem algebraMap_gaussLogDeriv_eq :
    algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) gaussLogDeriv
      = algebraMap ℂ (meroField (Set.univ : Set ℂ)) (-2 : ℂ) * coordElem := by
  rw [algebraMap_gaussLogDeriv, algebraMap_complex_eq_analyticMeroElement, coordElem,
    ← analyticMeroElement_mul analyticOnNhd_const analyticOnNhd_coord]

theorem coordElem_mem_gaussTripleField :
    coordElem ∈ IntermediateField.adjoin ℂ gaussTriple :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))

theorem gaussElem_mem_gaussTripleField :
    gaussElem ∈ IntermediateField.adjoin ℂ gaussTriple :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem gaussPrimElem_mem_gaussTripleField :
    gaussPrimElem ∈ IntermediateField.adjoin ℂ gaussTriple :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

/-- The field generated by the three states is closed under the derivation. -/
theorem derivationClosed_gaussTripleField :
    DerivationClosed (IntermediateField.adjoin ℂ gaussTriple) := by
  have hbase : ∀ c : ℂ, (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)′
      ∈ IntermediateField.adjoin ℂ gaussTriple := by
    intro c
    rw [deriv_complexConst]
    exact zero_mem _
  have hgen : ∀ x ∈ gaussTriple, x ∈ IntermediateField.adjoin ℂ gaussTriple
      ∧ x′ ∈ IntermediateField.adjoin ℂ gaussTriple := by
    rintro x (rfl | rfl | rfl)
    · exact ⟨gaussPrimElem_mem_gaussTripleField, by
        rw [deriv_gaussPrimElem]; exact gaussElem_mem_gaussTripleField⟩
    · refine ⟨gaussElem_mem_gaussTripleField, ?_⟩
      rw [deriv_gaussElem, algebraMap_gaussLogDeriv_eq]
      exact IntermediateField.mul_mem _
        (IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _)
          coordElem_mem_gaussTripleField) gaussElem_mem_gaussTripleField
    · exact ⟨coordElem_mem_gaussTripleField, by rw [deriv_coordElem]; exact one_mem _⟩
  intro x hx
  have hle := adjoin_le_derivStableField (C := ℂ)
    (L := IntermediateField.adjoin ℂ gaussTriple) (hbase := hbase) hgen
  exact (mem_derivStableField_iff.mp (hle hx)).2

/-- Every jet of the Gaussian primitive lies in the field of the three states. -/
theorem jetElem_gaussPrimitive_mem (k : ℕ) :
    jetElem differentiable_gaussPrimitive k ∈ IntermediateField.adjoin ℂ gaussTriple := by
  induction k with
  | zero =>
      rw [jetElem_gaussPrimitive_zero]
      exact gaussPrimElem_mem_gaussTripleField
  | succ k ih =>
      rw [jetElem_succ_eq_deriv]
      exact derivationClosed_gaussTripleField ih

/-- The jet field of the Gaussian primitive is the field of the three states. -/
theorem adjoin_jetSet_gaussPrimitive :
    IntermediateField.adjoin ℂ
        (insert coordElem (Set.range fun k : ℕ => jetElem differentiable_gaussPrimitive k))
      = IntermediateField.adjoin ℂ gaussTriple := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | ⟨k, rfl⟩)
    · exact coordElem_mem_gaussTripleField
    · exact jetElem_gaussPrimitive_mem k
  · rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | rfl | rfl)
    · refine IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨0, ?_⟩)
      exact jetElem_gaussPrimitive_zero
    · refine IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨1, ?_⟩)
      exact jetElem_gaussPrimitive_one
    · exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

/-- The shadow field of the Gaussian primitive is the field of the coordinate and the
exponential. -/
theorem adjoin_shadowSet_gaussPrimitive :
    IntermediateField.adjoin ℂ
        (insert coordElem (Set.range fun j : ℕ => jetElem differentiable_gaussPrimitive (j + 1)))
      = IntermediateField.adjoin ℂ
        (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) := by
  have hcoord : coordElem ∈ IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) :=
    IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ rfl)
  have hgauss : gaussElem ∈ IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) :=
    IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)
  have hclosed : DerivationClosed (IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))) := by
    have hbase : ∀ c : ℂ, (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)′
        ∈ IntermediateField.adjoin ℂ
          (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) := by
      intro c
      rw [deriv_complexConst]
      exact zero_mem _
    have hgen : ∀ x ∈ insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))),
        x ∈ IntermediateField.adjoin ℂ
            (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))
          ∧ x′ ∈ IntermediateField.adjoin ℂ
            (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) := by
      rintro x (rfl | rfl)
      · refine ⟨hgauss, ?_⟩
        rw [deriv_gaussElem, algebraMap_gaussLogDeriv_eq]
        exact IntermediateField.mul_mem _
          (IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _) hcoord) hgauss
      · exact ⟨hcoord, by rw [deriv_coordElem]; exact one_mem _⟩
    intro x hx
    have hle := adjoin_le_derivStableField (C := ℂ)
      (L := IntermediateField.adjoin ℂ
        (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))))
      (hbase := hbase) hgen
    exact (mem_derivStableField_iff.mp (hle hx)).2
  have hjet : ∀ j : ℕ, jetElem differentiable_gaussPrimitive (j + 1)
      ∈ IntermediateField.adjoin ℂ
        (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) := by
    intro j
    induction j with
    | zero =>
        rw [jetElem_gaussPrimitive_one]
        exact hgauss
    | succ j ih =>
        rw [jetElem_succ_eq_deriv]
        exact hclosed ih
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | ⟨j, rfl⟩)
    · exact hcoord
    · exact hjet j
  · rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | rfl)
    · refine IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨0, ?_⟩)
      exact jetElem_gaussPrimitive_one
    · exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

/-! ### The three transcendence steps -/

theorem trdeg_adjoin_coordElem :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
      ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) = 1 :=
  trdeg_adjoin_simple_eq_one transcendental_coordElem

theorem trdeg_adjoin_coordElem_gaussElem :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))) = 2 := by
  have hle : IntermediateField.adjoin ℂ ({coordElem} : Set (meroField (Set.univ : Set ℂ)))
      ≤ ratField := by
    rw [IntermediateField.adjoin_le_iff]
    rintro y rfl
    exact coordElem_mem_ratField
  have htr : ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ
      ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) gaussElem := fun h =>
    transcendental_gaussElem (isAlgebraic_of_le hle h)
  have h1 := trdeg_adjoin_insert_eq_add_one htr
  exact h1.trans
    ((congrArg (fun c : Cardinal => c + 1) trdeg_adjoin_coordElem).trans (by norm_num))

theorem trdeg_adjoin_gaussTriple :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ gaussTriple) = 3 := by
  have hle : IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ)))) ≤ gaussField := by
    rw [IntermediateField.adjoin_le_iff]
    rintro y (rfl | rfl)
    · exact gaussElem_mem_gaussField
    · exact ratField_le_gaussField coordElem_mem_ratField
  have htr : ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ
      (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))) gaussPrimElem :=
    fun h => not_isAlgebraic_gaussPrimElem (isAlgebraic_of_le hle h)
  have h1 : Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ gaussTriple)
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
          (insert gaussElem ({coordElem} : Set (meroField (Set.univ : Set ℂ))))) + 1 :=
    trdeg_adjoin_insert_eq_add_one htr
  exact h1.trans
    ((congrArg (fun c : Cardinal => c + 1) trdeg_adjoin_coordElem_gaussElem).trans (by norm_num))

/-! ### The two ranks of the Gaussian primitive -/

/-- **The Gaussian primitive has differential rank three.** -/
theorem daRank_gaussPrimitive : daRank differentiable_gaussPrimitive = 3 := by
  rw [daRank, adjoin_jetSet_gaussPrimitive]
  exact trdeg_adjoin_gaussTriple

/-- **The Gaussian primitive has shadow rank two.** -/
theorem shadowRank_gaussPrimitive : shadowRank' differentiable_gaussPrimitive = 2 := by
  rw [shadowRank', adjoin_shadowSet_gaussPrimitive]
  exact trdeg_adjoin_coordElem_gaussElem

/-- **The primitive defect of the Gaussian primitive is one.** -/
theorem daRank_eq_shadowRank_add_one_gaussPrimitive :
    daRank differentiable_gaussPrimitive = shadowRank' differentiable_gaussPrimitive + 1 := by
  rw [daRank_gaussPrimitive, shadowRank_gaussPrimitive]
  norm_num

end

end GaloisForLFunctions.HTGeometry
