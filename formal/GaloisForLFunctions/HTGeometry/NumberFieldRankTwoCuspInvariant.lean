import GaloisForLFunctions.HTGeometry.NumberFieldRankTwoSteinitz

/-!
# The rank-two cusp invariant over a number ring

The ideal generated by the two coordinates of a number-field vector can only shrink under an
integral matrix.  Applying this observation to a special-linear matrix and its integral inverse
proves exact invariance.  Consequently the ideal class is an invariant of the `SL₂(𝓞 K)` orbit,
and only finitely many cusp types occur.
-/

namespace GaloisForLFunctions.HTGeometry

open NumberField
open scoped Classical NumberField

noncomputable section

variable (K : Type*) [Field K] [NumberField K]

/-- Entrywise scalar extension of a rank-two number-ring matrix to the number field. -/
def numberFieldRankTwoMatrixBaseChange
    (A : Matrix (Fin 2) (Fin 2) (𝓞 K)) : Matrix (Fin 2) (Fin 2) K :=
  fun i j => (A i j : K)

/-- An integral rank-two matrix sends the coordinate ideal into the original coordinate ideal. -/
theorem numberFieldRankTwoCoordinateIdeal_mulVec_le
    (A : Matrix (Fin 2) (Fin 2) (𝓞 K)) (v : Fin 2 → K) :
    numberFieldRankTwoCoordinateIdeal K
        ((numberFieldRankTwoMatrixBaseChange K A).mulVec v) ≤
      numberFieldRankTwoCoordinateIdeal K v := by
  rw [numberFieldRankTwoCoordinateIdeal]
  apply sup_le
  · rw [FractionalIdeal.spanSingleton_le_iff_mem]
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two,
      numberFieldRankTwoMatrixBaseChange]
    change (A 0 0 : K) * v 0 + (A 0 1 : K) * v 1 ∈
      numberFieldRankTwoCoordinateIdeal K v
    apply Submodule.add_mem _
    · rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ (A 0 0) <| by
        exact (le_sup_left :
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ≤
            numberFieldRankTwoCoordinateIdeal K v) <| by
          rw [FractionalIdeal.mem_spanSingleton]
          exact ⟨1, by simp⟩
    · rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ (A 0 1) <| by
        exact (le_sup_right :
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1) ≤
            numberFieldRankTwoCoordinateIdeal K v) <| by
          rw [FractionalIdeal.mem_spanSingleton]
          exact ⟨1, by simp⟩
  · rw [FractionalIdeal.spanSingleton_le_iff_mem]
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two,
      numberFieldRankTwoMatrixBaseChange]
    change (A 1 0 : K) * v 0 + (A 1 1 : K) * v 1 ∈
      numberFieldRankTwoCoordinateIdeal K v
    apply Submodule.add_mem _
    · rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ (A 1 0) <| by
        exact (le_sup_left :
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ≤
            numberFieldRankTwoCoordinateIdeal K v) <| by
          rw [FractionalIdeal.mem_spanSingleton]
          exact ⟨1, by simp⟩
    · rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ (A 1 1) <| by
        exact (le_sup_right :
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1) ≤
            numberFieldRankTwoCoordinateIdeal K v) <| by
          rw [FractionalIdeal.mem_spanSingleton]
          exact ⟨1, by simp⟩

omit [NumberField K] in
/-- Entrywise scalar extension commutes with rank-two matrix multiplication. -/
theorem numberFieldRankTwoMatrixBaseChange_mul
    (A B : Matrix (Fin 2) (Fin 2) (𝓞 K)) :
    numberFieldRankTwoMatrixBaseChange K (A * B) =
      numberFieldRankTwoMatrixBaseChange K A *
        numberFieldRankTwoMatrixBaseChange K B := by
  ext i j
  simp [numberFieldRankTwoMatrixBaseChange, Matrix.mul_apply]

/-- A number-ring special-linear matrix preserves the coordinate ideal exactly. -/
theorem numberFieldRankTwoCoordinateIdeal_specialLinear_mulVec
    (g : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K)) (v : Fin 2 → K) :
    numberFieldRankTwoCoordinateIdeal K
        ((numberFieldRankTwoMatrixBaseChange K
          (g : Matrix (Fin 2) (Fin 2) (𝓞 K))).mulVec v) =
      numberFieldRankTwoCoordinateIdeal K v := by
  apply le_antisymm
  · exact numberFieldRankTwoCoordinateIdeal_mulVec_le K
      (g : Matrix (Fin 2) (Fin 2) (𝓞 K)) v
  · let w :=
      (numberFieldRankTwoMatrixBaseChange K
        (g : Matrix (Fin 2) (Fin 2) (𝓞 K))).mulVec v
    have hrecover :
        (numberFieldRankTwoMatrixBaseChange K
          (g⁻¹ : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K))).mulVec w = v := by
      rw [show w =
        (numberFieldRankTwoMatrixBaseChange K
          (g : Matrix (Fin 2) (Fin 2) (𝓞 K))).mulVec v from rfl]
      rw [Matrix.mulVec_mulVec, ← numberFieldRankTwoMatrixBaseChange_mul]
      rw [← Matrix.SpecialLinearGroup.coe_mul]
      have hgg : g⁻¹ * g = 1 := inv_mul_eq_one.mpr rfl
      rw [hgg, Matrix.SpecialLinearGroup.coe_one]
      have hone : numberFieldRankTwoMatrixBaseChange K
          (1 : Matrix (Fin 2) (Fin 2) (𝓞 K)) = 1 := by
        ext i j
        by_cases hij : i = j
        · subst j
          simp [numberFieldRankTwoMatrixBaseChange]
        · simp [numberFieldRankTwoMatrixBaseChange, hij]
      rw [hone, Matrix.one_mulVec]
    have hle := numberFieldRankTwoCoordinateIdeal_mulVec_le K
      (g⁻¹ : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K)) w
    rw [hrecover] at hle
    exact hle

/-- Special-linear scalar extension sends a nonzero rank-two vector to a nonzero vector. -/
theorem numberFieldRankTwoSpecialLinear_mulVec_ne_zero
    (g : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K))
    {v : Fin 2 → K} (hv : v ≠ 0) :
    (numberFieldRankTwoMatrixBaseChange K
      (g : Matrix (Fin 2) (Fin 2) (𝓞 K))).mulVec v ≠ 0 := by
  intro hzero
  have hideal := numberFieldRankTwoCoordinateIdeal_specialLinear_mulVec K g v
  have hsource : numberFieldRankTwoCoordinateIdeal K v ≠ 0 :=
    numberFieldRankTwoCoordinateIdeal_ne_zero K hv
  apply hsource
  rw [← hideal, hzero]
  simp [numberFieldRankTwoCoordinateIdeal]

/-- Nonzero number-field rank-two vectors, the affine representatives of projective cusps. -/
def numberFieldRankTwoNonzeroVector := {v : Fin 2 → K // v ≠ 0}

/-- The action of an integral special-linear matrix on nonzero rank-two field vectors. -/
def numberFieldRankTwoSpecialLinearAction
    (g : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K))
    (v : numberFieldRankTwoNonzeroVector K) :
    numberFieldRankTwoNonzeroVector K :=
  ⟨(numberFieldRankTwoMatrixBaseChange K
      (g : Matrix (Fin 2) (Fin 2) (𝓞 K))).mulVec v.1,
    numberFieldRankTwoSpecialLinear_mulVec_ne_zero K g v.2⟩

/-- Ideal-class label of a projective number-field cusp. -/
def numberFieldRankTwoCuspClass (v : numberFieldRankTwoNonzeroVector K) :
    ClassGroup (𝓞 K) :=
  ClassGroup.mk K (numberFieldRankTwoCoordinateIdealUnit K v.1 v.2)

/-- The cusp ideal class is invariant under the number-ring special-linear action. -/
theorem numberFieldRankTwoCuspClass_specialLinearAction
    (g : Matrix.SpecialLinearGroup (Fin 2) (𝓞 K))
    (v : numberFieldRankTwoNonzeroVector K) :
    numberFieldRankTwoCuspClass K
        (numberFieldRankTwoSpecialLinearAction K g v) =
      numberFieldRankTwoCuspClass K v := by
  unfold numberFieldRankTwoCuspClass numberFieldRankTwoSpecialLinearAction
    numberFieldRankTwoCoordinateIdealUnit
  congr 1
  apply Units.ext
  exact numberFieldRankTwoCoordinateIdeal_specialLinear_mulVec K g v.1

/-- Only finitely many ideal-class cusp labels occur. -/
theorem finite_range_numberFieldRankTwoCuspClass :
    Set.Finite (Set.range (numberFieldRankTwoCuspClass K)) :=
  Set.finite_univ.subset (Set.subset_univ _)

end

end GaloisForLFunctions.HTGeometry
