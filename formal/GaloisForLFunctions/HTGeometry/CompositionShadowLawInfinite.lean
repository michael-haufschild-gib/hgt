import GaloisForLFunctions.HTGeometry.CompositionShadowLaw
import GaloisForLFunctions.HTGeometry.AdjoinDirectedUnion

/-!
# The shadow law for the full jet field

Passing from the finite-jet fields to the fields generated by *all* jets, the transcendence degree
of the field generated by the coordinate and the complete jet family of `f ∘ g` is one more than
that of the coordinate together with all positive derivatives of `g`.  This is the differential
order law: composing with an autonomous first-order outer factor adds exactly one state and forgets
the primitive state of the inner function.

The passage to the limit uses that algebraicity over the field generated by an increasing union is
witnessed at a finite stage.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open scoped Differential

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic

theorem analyticOnNhd_coord : AnalyticOnNhd ℂ (fun z : ℂ => z) (Set.univ : Set ℂ) :=
  analyticOnNhd_id

/-- The coordinate function as an element of the meromorphic field of the plane. -/
def coordElem : meroField (Set.univ : Set ℂ) :=
  analyticMeroElement (fun z : ℂ => z) analyticOnNhd_coord

/-- The zeroth generator of the jet family is the coordinate. -/
theorem jetGen_zero_eq_coordElem {g : ℂ → ℂ} (hg : Differentiable ℂ g) (n : ℕ) :
    jetGen hg n 0 = coordElem := by
  refine analyticMeroElement_congr _ _ ?_
  funext z
  simp [jetGenFun]

set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **The shadow law for the full jet field.**  For a transcendental entire `f` satisfying an
autonomous first-order relation and a transcendental entire `g`, the coordinate together with the
complete jet family of `f ∘ g` generates a field of transcendence degree one more than the
coordinate together with all derivatives of `g` of positive order. -/
theorem trdeg_shadow_law_infinite {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (haut : AutonomousFirstOrder f) (hcomp : Differentiable ℂ (fun w => f (g w)))
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z)
    (hncomp : ¬ ∃ c : ℂ, ∀ z : ℂ, f (g z) = c)
    (hncg : ¬ ∃ c : ℂ, ∀ z : ℂ, g z = c) :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
        (insert coordElem (Set.range fun k : ℕ => jetElem hcomp k)))
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
        (insert coordElem (Set.range fun j : ℕ => jetElem hg (j + 1)))) + 1 := by
  classical
  have hcompan : AnalyticOnNhd ℂ (fun w => f (g w)) (Set.univ : Set ℂ) :=
    hcomp.differentiableOn.analyticOnNhd isOpen_univ
  set Sg : Set (meroField (Set.univ : Set ℂ)) :=
    insert coordElem (Set.range fun j : ℕ => jetElem hg (j + 1)) with hSg
  set Sh : Set (meroField (Set.univ : Set ℂ)) :=
    insert coordElem (Set.range fun k : ℕ => jetElem hcomp k) with hSh
  set C : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ Sg with hC
  set A : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ Sh with hA
  have hheq : jetElem hcomp 0 = analyticMeroElement (fun w => f (g w)) hcompan := by
    rw [jetElem]
    exact analyticMeroElement_congr _ _ (by funext z; simp [iteratedDeriv_zero])
  -- the finite stages of the shadow generating set
  set St : ℕ → Set (meroField (Set.univ : Set ℂ)) :=
    fun n => insert coordElem (Set.range fun j : Fin n => jetElem hg ((j : ℕ) + 1)) with hSt
  have hmono : Monotone St := by
    intro m n hmn y hy
    rcases hy with rfl | ⟨j, rfl⟩
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ ⟨⟨(j : ℕ), lt_of_lt_of_le j.2 hmn⟩, rfl⟩
  have hunion : (⋃ n, St n) = Sg := by
    ext y
    constructor
    · intro hy
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hy
      rcases hn with rfl | ⟨j, rfl⟩
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ ⟨(j : ℕ), rfl⟩
    · rintro (rfl | ⟨j, rfl⟩)
      · exact Set.mem_iUnion.mpr ⟨0, Set.mem_insert _ _⟩
      · exact Set.mem_iUnion.mpr ⟨j + 1, Set.mem_insert_of_mem _ ⟨⟨j, by omega⟩, rfl⟩⟩
  -- the composition is transcendental over the full shadow field
  have htrC : ¬ IsAlgebraic ↥C (jetElem hcomp 0) := by
    intro halg
    rw [hC, ← hunion] at halg
    obtain ⟨n, hn⟩ := exists_isAlgebraic_stage hmono halg
    have hle : IntermediateField.adjoin ℂ (St n)
        ≤ IntermediateField.adjoin ℂ (Set.range (jetGen hg n)) := by
      rw [IntermediateField.adjoin_le_iff]
      rintro y (rfl | ⟨j, rfl⟩)
      · exact IntermediateField.subset_adjoin ℂ _ ⟨0, jetGen_zero_eq_coordElem hg n⟩
      · refine IntermediateField.subset_adjoin ℂ _
          ⟨(⟨(j : ℕ) + 1, by omega⟩ : Fin (n + 1)).succ, ?_⟩
        rw [jetGen_succ]
    rw [hheq] at hn
    exact not_isAlgebraic_comp_over_jetGen hf hg hfnp hgnp n hcompan (isAlgebraic_of_le hle hn)
  -- step one: adjoining the composition costs one degree
  have hstep1 : Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg))
      = Algebra.trdeg ℂ ↥C + 1 := trdeg_adjoin_insert_eq_add_one htrC
  -- the composed jets are algebraic over the enlarged shadow field
  have hcjB : ∀ i : ℕ, IsAlgebraic ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg))
      (compJetElem hf hg i) := by
    intro i
    have halg := isAlgebraic_compJetElem_of_autonomous hf hg haut hcomp hncomp hncg i
    refine isAlgebraic_of_le ?_ halg
    rw [IntermediateField.adjoin_le_iff]
    rintro y rfl
    exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)
  -- step two: the two fields are mutually algebraic
  have hAB : ∀ y : meroField (Set.univ : Set ℂ), y ∈ A →
      IsAlgebraic ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg)) y := by
    intro y hy
    rw [hA] at hy
    refine isAlgebraic_of_adjoin_of_generators _ Sh ?_ hy
    rintro w (rfl | ⟨k, rfl⟩)
    · refine isAlgebraic_algebraMap
        (⟨coordElem, ?_⟩ : ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg)))
      exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    · refine isAlgebraic_of_gradedJetRing hf hg _ k hcjB ?_
        (jetElem_comp_mem_gradedJetRing hf hg hcomp k)
      intro j hj1 hjk
      refine isAlgebraic_algebraMap
        (⟨jetElem hg j, ?_⟩ : ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg)))
      refine IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ?_)
      refine Set.mem_insert_of_mem _ ⟨j - 1, ?_⟩
      show jetElem hg ((j - 1) + 1) = jetElem hg j
      congr 1
      omega
  have hBA : ∀ y : meroField (Set.univ : Set ℂ),
      y ∈ IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg) → IsAlgebraic ↥A y := by
    intro y hy
    refine isAlgebraic_of_adjoin_of_generators _ (insert (jetElem hcomp 0) Sg) ?_ hy
    rintro w (rfl | rfl | ⟨j, rfl⟩)
    · refine isAlgebraic_algebraMap (⟨jetElem hcomp 0, ?_⟩ : ↥A)
      rw [hA]
      exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨0, rfl⟩)
    · refine isAlgebraic_algebraMap (⟨coordElem, ?_⟩ : ↥A)
      rw [hA]
      exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)
    · refine isAlgebraic_of_le ?_
        (isAlgebraic_jetElem_over_compJets hf hg haut hcomp hfnp hgnp hncomp hncg (j + 1)
          (j + 1) (by omega) (by omega))
      rw [hA, IntermediateField.adjoin_le_iff]
      rintro y ⟨k, rfl⟩
      exact IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ ⟨(k : ℕ), rfl⟩)
  have hstep2 : Algebra.trdeg ℂ ↥A
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ (insert (jetElem hcomp 0) Sg)) :=
    trdeg_eq_of_mutually_algebraic hAB hBA
  rw [hstep2, hstep1]

end

end GaloisForLFunctions.HTGeometry
