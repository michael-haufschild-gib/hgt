import Mathlib.RingTheory.Polynomial.RationalRoot
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Localization.FractionRing

/-!
# The field of rational functions is generated by the variable

Every polynomial lies in the algebra generated by the variable, so its image lies in the field
generated by the variable, and every rational function is a quotient of two such images.

So the field of rational functions is a simple extension of the constants, generated by a
transcendental.
-/

namespace GaloisForLFunctions.HTGeometry

variable {E : Type*} [Field E]

/-- The variable, read as a rational function. -/
noncomputable def fracX (E : Type*) [Field E] : FractionRing (Polynomial E) :=
  algebraMap (Polynomial E) (FractionRing (Polynomial E)) Polynomial.X

/-- **Every polynomial lands in the field generated by the variable.** -/
theorem algebraMap_mem_adjoin_fracX (f : Polynomial E) :
    algebraMap (Polynomial E) (FractionRing (Polynomial E)) f ∈
      IntermediateField.adjoin E {fracX E} := by
  have hX : Polynomial.X ∈
      Subalgebra.comap
        (IsScalarTower.toAlgHom E (Polynomial E) (FractionRing (Polynomial E)))
        (IntermediateField.adjoin E {fracX E}).toSubalgebra := by
    show algebraMap (Polynomial E) (FractionRing (Polynomial E)) Polynomial.X ∈
      IntermediateField.adjoin E {fracX E}
    exact IntermediateField.subset_adjoin _ _ rfl
  have hle : Algebra.adjoin E ({Polynomial.X} : Set (Polynomial E)) ≤
      Subalgebra.comap
        (IsScalarTower.toAlgHom E (Polynomial E) (FractionRing (Polynomial E)))
        (IntermediateField.adjoin E {fracX E}).toSubalgebra :=
    Algebra.adjoin_le (by rintro _ rfl; exact hX)
  have hmem : f ∈ Algebra.adjoin E ({Polynomial.X} : Set (Polynomial E)) := by
    rw [Polynomial.adjoin_X]
    exact Algebra.mem_top
  exact hle hmem

/-- **The field of rational functions is generated by the variable.** -/
theorem adjoin_fracX_eq_top :
    IntermediateField.adjoin E {fracX E} =
      (⊤ : IntermediateField E (FractionRing (Polynomial E))) := by
  refine le_antisymm le_top fun x _ => ?_
  obtain ⟨f, g, -, rfl⟩ := IsFractionRing.div_surjective (A := Polynomial E) x
  exact div_mem (algebraMap_mem_adjoin_fracX f) (algebraMap_mem_adjoin_fracX g)

end GaloisForLFunctions.HTGeometry
