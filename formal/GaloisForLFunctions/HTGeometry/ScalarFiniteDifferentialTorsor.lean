import GaloisForLFunctions.HTGeometry.ScalarDifferentialTorsor

/-!
# The finite scalar differential torsor

For a nonzero hypertranscendental generator `q` and a positive integer `N`, this file identifies
the full derivation-preserving automorphism group over `F⟨q^N⟩`.  Every such automorphism is a
unique rescaling of `q` by an `N`-th root of unity in the constant field, and every root-of-unity
rescaling occurs.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F T : Type*} [Field F] [Field T] [Algebra F T]
  [Differential F] [Differential T] [DifferentialAlgebra F T]
  [CharZero T]

/-- The logarithmic-current field lies in every positive power-coordinate differential field. -/
theorem scalarLogCurrentField_le_differentialAdjoin_pow
    (q : T) (hq0 : q ≠ 0) {N : ℕ} (hN : 0 < N) :
    scalarLogCurrentField F q ≤ differentialAdjoin F ({q ^ N} : Set T) := by
  intro z hz
  rw [differentialAdjoin_pow_eq_logCurrentOrdinaryExtension hq0 hN]
  exact IntermediateField.subset_adjoin F _ (Set.mem_union_left _ hz)

/-- Scaling by an `N`-th root of unity fixes the differential field generated by `q ^ N`. -/
theorem scalarDifferentialScaleEquiv_fixed_on_powerField
    (q : T) (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (ζ : rootsOfUnity N F)
    (z : differentialAdjoin F ({q ^ N} : Set T)) :
    scalarDifferentialScaleEquiv q hq hgen ζ.1 z.1 = z.1 := by
  let sigma := scalarDifferentialScaleEquiv q hq hgen ζ.1
  have hζpow : (((ζ.1 : Fˣ) : F) ^ N) = 1 :=
    (mem_rootsOfUnity' N ζ.1).mp ζ.2
  have hpow : sigma (q ^ N) = q ^ N := by
    rw [map_pow, scalarDifferentialScaleEquiv_apply_q, mul_pow,
      ← map_pow, hζpow, map_one, mul_one]
  have hjet : ∀ n : ℕ,
      sigma (differentialJet n (q ^ N)) = differentialJet n (q ^ N) := by
    intro n
    induction n with
    | zero => simpa using hpow
    | succ n ih =>
        rw [differentialJet_succ, scalarDifferentialScaleEquiv_deriv]
        exact congrArg Differential.deriv ih
  change sigma z.1 = z.1
  rw [differentialAdjoin] at z
  apply IntermediateField.adjoin_induction F
    (s := differentialJetSet ({q ^ N} : Set T))
    (p := fun w _ => sigma w = w)
  · rintro w ⟨v, hv, n, rfl⟩
    have hvpow : v = q ^ N := Set.mem_singleton_iff.mp hv
    simpa [hvpow] using hjet n
  · intro c
    exact sigma.commutes c
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]
  · simp

/-- The canonical root-of-unity scaling, rebased over the power-coordinate differential field. -/
def scalarDifferentialScaleEquivPower
    (q : T) (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (ζ : rootsOfUnity N F) :
    T ≃ₐ[differentialAdjoin F ({q ^ N} : Set T)] T where
  toRingEquiv := (scalarDifferentialScaleEquiv q hq hgen ζ.1).toRingEquiv
  commutes' z := scalarDifferentialScaleEquiv_fixed_on_powerField q hq hgen ζ z

@[simp]
theorem scalarDifferentialScaleEquivPower_apply_q
    (q : T) (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (ζ : rootsOfUnity N F) :
    scalarDifferentialScaleEquivPower q hq hgen ζ q =
      q * algebraMap F T (((ζ.1 : Fˣ) : F)) :=
  scalarDifferentialScaleEquiv_apply_q q hq hgen ζ.1

/-- Forgetting from the power-coordinate field to the current field preserves a
derivation-preserving automorphism. -/
def powerDerivationPreservingAutToCurrent
    (q : T) (hq0 : q ≠ 0) {N : ℕ} (hN : 0 < N)
    (sigma : derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T) :
    derivationPreservingAut (scalarLogCurrentField F q) T :=
  ⟨{ toRingEquiv := sigma.1.toRingEquiv
     commutes' := fun z => sigma.1.commutes
       ⟨z.1, scalarLogCurrentField_le_differentialAdjoin_pow q hq0 hN z.2⟩ },
    sigma.2⟩

/-- Power-field differential automorphisms are determined by their value on the amplitude. -/
theorem powerDerivationPreservingAut_ext
    (q : T) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (hN : 0 < N)
    {sigma tau : derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T}
    (hqeq : sigma.1 q = tau.1 q) : sigma = tau := by
  apply Subtype.ext
  apply AlgEquiv.ext
  intro z
  have hrest :
      (powerDerivationPreservingAutToCurrent q hq0 hN sigma).1 =
        (powerDerivationPreservingAutToCurrent q hq0 hN tau).1 :=
    scalarCurrentAlgEquiv_ext q hq0 hgen hqeq
  exact congrArg (fun e : T ≃ₐ[scalarLogCurrentField F q] T => e z) hrest

/-- The finite scalar action by roots of unity on the power-coordinate differential torsor. -/
def scalarFiniteDifferentialScaleAction
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (hN : 0 < N) :
    rootsOfUnity N F →* derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T where
  toFun ζ := ⟨scalarDifferentialScaleEquivPower q hq hgen ζ,
    scalarDifferentialScaleEquiv_deriv q hq hgen ζ.1⟩
  map_one' := by
    apply powerDerivationPreservingAut_ext q hq0 hgen hN
    simp
  map_mul' ζ η := by
    apply powerDerivationPreservingAut_ext q hq0 hgen hN
    simp only [AlgEquiv.mul_apply, scalarDifferentialScaleEquivPower_apply_q,
      Subgroup.coe_mul, Units.val_mul]
    change q * algebraMap F T ((((ζ * η).1 : Fˣ) : F)) =
      scalarDifferentialScaleEquiv q hq hgen ζ.1
        (q * algebraMap F T (((η.1 : Fˣ) : F)))
    calc
      q * algebraMap F T ((((ζ * η).1 : Fˣ) : F)) =
          q * algebraMap F T (((ζ.1 : Fˣ) : F)) *
            algebraMap F T (((η.1 : Fˣ) : F)) := by
        simp only [Subgroup.coe_mul, Units.val_mul, map_mul]
        ring
      _ = scalarDifferentialScaleEquiv q hq hgen ζ.1 q *
          scalarDifferentialScaleEquiv q hq hgen ζ.1
            (algebraMap F T (((η.1 : Fˣ) : F))) := by
        rw [scalarDifferentialScaleEquiv_apply_q,
          (scalarDifferentialScaleEquiv q hq hgen ζ.1).commutes]
      _ = scalarDifferentialScaleEquiv q hq hgen ζ.1
          (q * algebraMap F T (((η.1 : Fˣ) : F))) := by rw [map_mul]

@[simp]
theorem scalarFiniteDifferentialScaleAction_apply_q
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (hN : 0 < N) (ζ : rootsOfUnity N F) :
    (scalarFiniteDifferentialScaleAction q hq hq0 hgen hN ζ).1 q =
      q * algebraMap F T (((ζ.1 : Fˣ) : F)) :=
  scalarDifferentialScaleEquivPower_apply_q q hq hgen ζ

/-- The finite scalar action is faithful. -/
theorem scalarFiniteDifferentialScaleAction_injective
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (hN : 0 < N) :
    Function.Injective (scalarFiniteDifferentialScaleAction q hq hq0 hgen hN) := by
  intro ζ η hζη
  have hqeq := congrArg
    (fun sigma : derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T => sigma.1 q) hζη
  have hcoeff : algebraMap F T (((ζ.1 : Fˣ) : F)) =
      algebraMap F T (((η.1 : Fˣ) : F)) := by
    apply mul_left_cancel₀ hq0
    simpa using hqeq
  apply Subtype.ext
  apply Units.ext
  exact (algebraMap F T).injective hcoeff

/-- A power-field differential automorphism with specified root-of-unity multiplier is the
canonical finite scalar action. -/
theorem powerDerivationPreservingAut_eq_finiteScaleAction_of_apply_q
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {N : ℕ} (hN : 0 < N)
    (sigma : derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T)
    (ζ : rootsOfUnity N F)
    (hsigma : sigma.1 q = q * algebraMap F T (((ζ.1 : Fˣ) : F))) :
    sigma = scalarFiniteDifferentialScaleAction q hq hq0 hgen hN ζ := by
  apply powerDerivationPreservingAut_ext q hq0 hgen hN
  rw [hsigma, scalarFiniteDifferentialScaleAction_apply_q]

/-- Every derivation-preserving automorphism over the positive power field is a unique
root-of-unity rescaling. -/
theorem scalarFiniteDifferentialScaleAction_surjective
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T]
    {N : ℕ} (hN : 0 < N) :
    Function.Surjective (scalarFiniteDifferentialScaleAction q hq hq0 hgen hN) := by
  intro sigma
  let sigmaL := powerDerivationPreservingAutToCurrent q hq0 hN sigma
  obtain ⟨u, hu⟩ :=
    scalarDifferentialScaleAction_surjective q hq hq0 hgen hconst sigmaL
  have hsigmaq : sigma.1 q = q * algebraMap F T (u : F) := by
    have hqeq := congrArg
      (fun tau : derivationPreservingAut (scalarLogCurrentField F q) T => tau.1 q) hu
    simpa [sigmaL, scalarDifferentialScaleAction_apply,
      scalarDifferentialScaleEquivCurrent_apply_q] using! hqeq.symm
  have hfixpow : sigma.1 (q ^ N) = q ^ N :=
    sigma.1.commutes
      ⟨q ^ N, subset_differentialAdjoin F ({q ^ N} : Set T) rfl⟩
  have hscaledPow : q ^ N * (algebraMap F T (u : F)) ^ N = q ^ N := by
    calc
      q ^ N * (algebraMap F T (u : F)) ^ N =
          (q * algebraMap F T (u : F)) ^ N := by rw [mul_pow]
      _ = (sigma.1 q) ^ N := by rw [hsigmaq]
      _ = sigma.1 (q ^ N) := by rw [map_pow]
      _ = q ^ N := hfixpow
  have huPowT : (algebraMap F T (u : F)) ^ N = 1 := by
    apply mul_left_cancel₀ (pow_ne_zero N hq0)
    simpa using hscaledPow
  have huPowF : (u : F) ^ N = 1 := by
    apply (algebraMap F T).injective
    simpa using huPowT
  have huUnits : u ^ N = 1 := by
    apply Units.ext
    simpa using huPowF
  let ζ : rootsOfUnity N F := ⟨u, huUnits⟩
  refine ⟨ζ, ?_⟩
  symm
  apply powerDerivationPreservingAut_eq_finiteScaleAction_of_apply_q
    q hq hq0 hgen hN sigma ζ
  simpa [ζ] using hsigmaq

/-- Every derivation-preserving automorphism over `F⟨q^N⟩` has a unique root-of-unity scalar
representative. -/
theorem existsUnique_rootOfUnity_for_powerDerivationPreservingAut
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T]
    {N : ℕ} (hN : 0 < N)
    (sigma : derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T) :
    ∃! ζ : rootsOfUnity N F,
      scalarFiniteDifferentialScaleAction q hq hq0 hgen hN ζ = sigma := by
  obtain ⟨ζ, hζ⟩ :=
    scalarFiniteDifferentialScaleAction_surjective q hq hq0 hgen hconst hN sigma
  refine ⟨ζ, hζ, ?_⟩
  intro η hη
  apply scalarFiniteDifferentialScaleAction_injective q hq hq0 hgen hN
  exact hη.trans hζ.symm

/-- **Finite scalar differential Galois group.**  The derivation-preserving automorphism group
over `F⟨q^N⟩` is exactly the group of `N`-th roots of unity in `F`. -/
def scalarFiniteDifferentialGaloisGroupEquiv
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T]
    {N : ℕ} (hN : 0 < N) :
    rootsOfUnity N F ≃* derivationPreservingAut
      (differentialAdjoin F ({q ^ N} : Set T)) T :=
  MulEquiv.ofBijective (scalarFiniteDifferentialScaleAction q hq hq0 hgen hN)
    ⟨scalarFiniteDifferentialScaleAction_injective q hq hq0 hgen hN,
      scalarFiniteDifferentialScaleAction_surjective q hq hq0 hgen hconst hN⟩

@[simp]
theorem scalarFiniteDifferentialGaloisGroupEquiv_apply_q
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T]
    {N : ℕ} (hN : 0 < N) (ζ : rootsOfUnity N F) :
    (scalarFiniteDifferentialGaloisGroupEquiv
      q hq hq0 hgen hconst hN ζ).1 q =
        q * algebraMap F T (((ζ.1 : Fˣ) : F)) :=
  scalarFiniteDifferentialScaleAction_apply_q q hq hq0 hgen hN ζ

end

end GaloisForLFunctions.HTGeometry
