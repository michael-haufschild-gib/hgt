import GaloisForLFunctions.HTGeometry.SourceStableDifferentialAdjoin
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Differential independence is additive along a tower

A family which is differentially independent over the base, together with a second family which is
differentially independent over the differential field the first one generates, is differentially
independent as a whole.  This is transcendence-degree additivity in the differential setting, and
it is what turns the block-by-block criteria of a triangular source datum into a statement about
the whole family.

The proof is the algebraic tower law for algebraic independence applied to the jet families, using
that the field generated by a set and the algebra generated by it have the same independent
families.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The jets of a family are exactly the jet set of its range. -/
theorem differentialJetSet_range {ι E : Type*} [CommRing E] [Differential E] (x : ι → E) :
    GaloisForLFunctions.differentialJetSet (Set.range x)
      = Set.range fun p : ι × ℕ => differentialJet p.2 (x p.1) := by
  ext z
  constructor
  · rintro ⟨w, ⟨i, rfl⟩, n, rfl⟩
    exact ⟨(i, n), rfl⟩
  · rintro ⟨⟨i, n⟩, rfl⟩
    exact ⟨x i, ⟨i, rfl⟩, n, rfl⟩

universe u

/-- **Differential independence is additive along a tower.**  A base-independent family and a
family independent over the differential field it generates are jointly independent over the
base. -/
theorem differentialIndependent_sumElim
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E]
    {ι ι' : Type u} {x : ι → E} {y : ι' → E}
    (hx : DifferentialIndependent F x)
    (hy : DifferentialIndependent ↥(differentialAdjoin F (Set.range x)) y) :
    DifferentialIndependent F (Sum.elim y x) := by
  unfold DifferentialIndependent at hx hy ⊢
  rw [differentialAdjoin, IntermediateField.algebraicIndependent_adjoin_iff,
    differentialJetSet_range] at hy
  have h := hx.sumElim hy
  have hg : Function.Injective
      (fun p : (ι' ⊕ ι) × ℕ =>
        match p.1 with
        | Sum.inl a => (Sum.inl (a, p.2) : ι' × ℕ ⊕ ι × ℕ)
        | Sum.inr b => Sum.inr (b, p.2)) := by
    rintro ⟨s, n⟩ ⟨t, m⟩ hst
    cases s <;> cases t <;> simp_all
  have hcomp := h.comp _ hg
  convert hcomp using 1
  funext p
  obtain ⟨s, n⟩ := p
  cases s <;> rfl

end

end GaloisForLFunctions.HTGeometry
