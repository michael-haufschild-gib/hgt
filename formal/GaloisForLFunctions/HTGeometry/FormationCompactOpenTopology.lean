import GaloisForLFunctions.HTGeometry.PoissonDustCompactification

/-!
# The compact-open weak topology on formations

Measure-valued functions `F : ℂ → M(K)` carry the compact-open weak uniformity: `F_n → F` when,
for every `f ∈ C(K)`, `z ↦ ∫ f dF_n(z)` converges uniformly on every disc.

**Corollary 5.2 (exact properness repair).**  For every `C`, the closure of the formations of
positive finite packets of mass `≤ C` is exactly the set of decorated formations
`Exp_⋆(zγ) ⋆ Π_j (δ_1 + zα_j)` with positive `γ, α_j` and `‖γ‖ + Σ_j ‖α_j‖ ≤ C`, and this set is
compact.  Decorated formations obey `‖F(z)‖ ≤ e^{|z| C}`; on such a bounded family the uniformity
is generated by a dense sequence of test functions, so the family is pseudo-metrizable and its
sequential compactness (Theorems 4.1 and 5.1) is compactness.  The space is Hausdorff, so the
compact set of decorated formations is closed and contains the closure of the finite formations.
-/

open Filter Topology NormedSpace Set Uniformity UniformConvergence

noncomputable section

namespace GaloisForLFunctions.HTGeometry.FormationDust

open MeasureAlgebra

/-- The discs `|z| ≤ n`, `n ∈ ℕ`. -/
def discs : Set (Set ℂ) := Set.range fun n : ℕ => Metric.closedBall (0 : ℂ) n

theorem closedBall_mem_discs (n : ℕ) : Metric.closedBall (0 : ℂ) n ∈ discs := ⟨n, rfl⟩

theorem discs_nonempty : discs.Nonempty := ⟨_, closedBall_mem_discs 0⟩

theorem discs_directedOn : DirectedOn (· ⊆ ·) discs := by
  rintro _ ⟨n, rfl⟩ _ ⟨k, rfl⟩
  refine ⟨_, closedBall_mem_discs (max n k), Metric.closedBall_subset_closedBall ?_,
    Metric.closedBall_subset_closedBall ?_⟩ <;> exact_mod_cast (by omega)

instance : IsCountablyGenerated (𝓤 (ℂ →ᵤ[discs] ℂ)) :=
  UniformOnFun.isCountablyGenerated_uniformity discs (t := fun n : ℕ => Metric.closedBall 0 n)
    closedBall_mem_discs (fun _ _ h => Metric.closedBall_subset_closedBall (by exact_mod_cast h))
    fun _ ⟨n, hn⟩ => ⟨n, hn.symm.subset⟩

/-- Measure-valued functions of `z ∈ ℂ`, carrying the compact-open weak uniformity. -/
def FormSpace (K : Type*) [TopologicalSpace K] : Type _ := ℂ → MeasureAlgebra K

variable {K : Type*} [TopologicalSpace K]

/-- A set of measure-valued functions, viewed in the compact-open weak space. -/
def inFormSpace (s : Set (ℂ → MeasureAlgebra K)) : Set (FormSpace K) := s

/-- Testing against `f`, as a function in the topology of uniform convergence on discs. -/
def testMap (f : C(K, ℂ)) (F : FormSpace K) : ℂ →ᵤ[discs] ℂ :=
  UniformOnFun.ofFun discs fun z => F z f

instance : UniformSpace (FormSpace K) :=
  ⨅ f : C(K, ℂ), UniformSpace.comap (testMap f) inferInstance

theorem uniformContinuous_testMap (f : C(K, ℂ)) : UniformContinuous (testMap (K := K) f) :=
  uniformContinuous_iInf_dom (u₁ := fun f => UniformSpace.comap (testMap f) inferInstance) (i := f)
    uniformContinuous_comap

theorem uniformity_formSpace : 𝓤 (FormSpace K) =
    ⨅ f : C(K, ℂ), comap (Prod.map (testMap f) (testMap f)) (𝓤 (ℂ →ᵤ[discs] ℂ)) := by
  refine iInf_uniformity.trans (iInf_congr fun f => ?_)
  exact uniformity_comap _

theorem continuous_eval (z : ℂ) (f : C(K, ℂ)) : Continuous fun F : FormSpace K => F z f :=
  ((UniformOnFun.uniformContinuous_eval_of_mem ℂ discs (x := z)
    (mem_closedBall_zero_iff.2 (Nat.le_ceil ‖z‖)) (closedBall_mem_discs ⌈‖z‖⌉₊)).comp
      (uniformContinuous_testMap f)).continuous

instance : T2Space (FormSpace K) := by
  refine ⟨fun F G hFG => ?_⟩
  obtain ⟨z, f, h⟩ : ∃ z f, F z f ≠ G z f := by
    by_contra! h
    exact hFG (funext fun z => MeasureAlgebra.ext (h z))
  obtain ⟨u, v, hu, hv, hFu, hGv, huv⟩ := t2_separation h
  exact ⟨_, _, hu.preimage (continuous_eval z f), hv.preimage (continuous_eval z f), hFu, hGv,
    huv.preimage _⟩

theorem tendsto_formSpace_iff {ι : Type*} {l : Filter ι} {F : ι → FormSpace K} {G : FormSpace K} :
    Tendsto F l (𝓝 G) ↔ ∀ f, Tendsto (fun n => testMap f (F n)) l (𝓝 (testMap f G)) := by
  rw [Uniform.tendsto_nhds_right, uniformity_formSpace, tendsto_iInf]
  refine forall_congr' fun f => ?_
  rw [tendsto_comap_iff, Uniform.tendsto_nhds_right]
  exact Iff.rfl

/-- Convergence in the compact-open weak topology is compact-open weak convergence. -/
theorem tendsto_formSpace_iff_formConv {F : ℕ → FormSpace K} {G : FormSpace K} :
    Tendsto F atTop (𝓝 G) ↔ FormConv F G := by
  rw [tendsto_formSpace_iff]
  constructor
  · intro h R f
    exact (UniformOnFun.tendsto_iff_tendstoUniformlyOn.1 (h f) _ (closedBall_mem_discs ⌈R⌉₊)).mono
      (Metric.closedBall_subset_closedBall (Nat.le_ceil R))
  · intro h f
    refine UniformOnFun.tendsto_iff_tendstoUniformlyOn.2 ?_
    rintro _ ⟨n, rfl⟩
    exact h n f

variable [CompactSpace K] [T2Space K] [SecondCountableTopology K] [CommMonoid K] [ContinuousMul K]
  [MeasurableSpace K] [BorelSpace K]

attribute [local instance] ratAlgebra

omit [SecondCountableTopology K] [MeasurableSpace K] [BorelSpace K] in
/-- Decorated formations obey `‖F(z)‖ ≤ e^{RC}` for `‖z‖ ≤ R`. -/
theorem norm_decorated_le {γ : MeasureAlgebra K} {α : ℕ → MeasureAlgebra K}
    (hα : Summable fun j => ‖α j‖) {R C : ℝ} (hR : 0 ≤ R) (hmass : ‖γ‖ + ∑' j, ‖α j‖ ≤ C)
    {z : ℂ} (hz : ‖z‖ ≤ R) : ‖decorated γ α z‖ ≤ Real.exp (R * C) := by
  have hP : ‖∏' j, (1 + z • α j)‖ ≤ Real.exp (R * ∑' j, ‖α j‖) :=
    le_of_tendsto' (multipliable_formation hα z).tendsto_prod_tprod_nat.norm fun N =>
      (norm_prod_one_add_le _ _ hz).trans (Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left
        (hα.sum_le_tsum _ fun j _ => norm_nonneg _) hR))
  have hE : ‖exp (z • γ)‖ ≤ Real.exp (R * ‖γ‖) := (norm_exp_le _).trans (Real.exp_le_exp.2 (by
    rw [norm_smul]; exact mul_le_mul_of_nonneg_right hz (norm_nonneg _)))
  calc ‖decorated γ α z‖ ≤ Real.exp (R * ‖γ‖) * Real.exp (R * ∑' j, ‖α j‖) :=
        (norm_mul_le _ _).trans (mul_le_mul hE hP (norm_nonneg _) (Real.exp_pos _).le)
    _ = Real.exp (R * (‖γ‖ + ∑' j, ‖α j‖)) := by rw [← Real.exp_add, mul_add]
    _ ≤ Real.exp (R * C) := Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left hmass hR)

omit [SecondCountableTopology K] [MeasurableSpace K] [BorelSpace K] in
/-- A finite formation is the decorated formation with zero dust and the ordered packet. -/
theorem formation_eq_decorated {m : ℕ} (A : Fin m → MeasureAlgebra K) :
    formation A = decorated 0 (padded A) := by
  funext z
  rw [decorated, smul_zero, exp_zero, one_mul, tprod_eq_prod (s := Finset.range m) fun j hj => by
    rw [padded_of_le A (not_lt.1 fun h => hj (Finset.mem_range.2 h)), smul_zero, add_zero],
    prod_range_padded A z le_rfl]

omit [SecondCountableTopology K] [MeasurableSpace K] [BorelSpace K] in
theorem packetFormationSet_subset_decoratedSet (C : ℝ) :
    packetFormationSet (K := K) C ⊆ decoratedSet C := by
  rintro _ ⟨m, A, hpos, hmass, rfl⟩
  have hfin : ∀ j ∉ Finset.range m, ‖padded A j‖ = 0 := fun j hj => by
    rw [padded_of_le A (not_lt.1 fun h => hj (Finset.mem_range.2 h)), norm_zero]
  refine ⟨0, padded A, isPositive_zero, isPositive_padded hpos, summable_of_ne_finset_zero hfin,
    ?_, formation_eq_decorated A⟩
  rw [norm_zero, zero_add, tsum_eq_sum hfin]
  exact (sum_range_norm_padded_le A m).trans hmass

/-- The decorated formations of mass `≤ C`, as a subspace of the compact-open weak space. -/
abbrev DecoratedSpace (K : Type*) [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [SecondCountableTopology K] [CommMonoid K] [ContinuousMul K] [MeasurableSpace K]
    [BorelSpace K] (C : ℝ) : Type _ :=
  ↥(inFormSpace (decoratedSet (K := K) C))

/-- On decorated formations of mass `≤ C`, testing against a dense sequence of functions generates
the compact-open weak uniformity: the test values are `e^{nC}`-Lipschitz in `f` on the disc of
radius `n`. -/
theorem uniformity_decoratedSpace_eq (C : ℝ) {g : ℕ → C(K, ℂ)} (hg : DenseRange g) :
    𝓤 (DecoratedSpace K C) = ⨅ i, comap (Prod.map (testMap (g i) ∘ Subtype.val)
      (testMap (g i) ∘ Subtype.val)) (𝓤 (ℂ →ᵤ[discs] ℂ)) := by
  refine le_antisymm (le_iInf fun i => ((uniformContinuous_testMap (g i)).comp
    uniformContinuous_subtype_val).le_comap) ?_
  rw [uniformity_subtype, uniformity_formSpace, comap_iInf]
  refine le_iInf fun f => ?_
  rw [comap_comap]
  refine ((UniformOnFun.hasBasis_uniformity_of_basis ℂ ℂ discs discs_nonempty discs_directedOn
    Metric.uniformity_basis_dist).comap _).ge_iff.2 ?_
  rintro ⟨_, ε⟩ ⟨⟨n, rfl⟩, hε⟩
  set B := Real.exp (n * C)
  obtain ⟨i, hi⟩ := hg.exists_dist_lt f (show 0 < ε / (3 * (B + 1)) by positivity)
  have hW : UniformOnFun.gen discs (Metric.closedBall 0 n) {p : ℂ × ℂ | dist p.1 p.2 < ε / 3} ∈
      𝓤 (ℂ →ᵤ[discs] ℂ) :=
    UniformOnFun.gen_mem_uniformity _ _ (closedBall_mem_discs n)
      (Metric.dist_mem_uniformity (by positivity))
  refine mem_of_superset (mem_iInf_of_mem i (preimage_mem_comap hW)) ?_
  rintro ⟨⟨F, hF⟩, ⟨G, hG⟩⟩ hFG z hz
  have hFG := hFG z hz
  simp only [mem_setOf_eq, Function.comp_apply, Prod.map_apply, testMap,
    UniformOnFun.toFun_ofFun] at hFG ⊢
  have hbound : ∀ H ∈ decoratedSet C, ‖(H : ℂ → MeasureAlgebra K) z‖ ≤ B := by
    rintro _ ⟨γ, α, -, -, hs, hm, rfl⟩
    exact norm_decorated_le hs (Nat.cast_nonneg n) hm (mem_closedBall_zero_iff.1 hz)
  have hd : ‖f - g i‖ < ε / (3 * (B + 1)) := by rw [← dist_eq_norm]; exact hi
  have hlip : ∀ H ∈ decoratedSet C, ‖(H : ℂ → MeasureAlgebra K) z f -
      (H : ℂ → MeasureAlgebra K) z (g i)‖ ≤ B * ‖f - g i‖ := fun H hH => by
    rw [← map_sub]
    exact (le_opNorm _ _).trans (mul_le_mul_of_nonneg_right (hbound H hH) (norm_nonneg _))
  have hB : B * ‖f - g i‖ ≤ ε / 3 := by
    have hB0 : 0 < B := Real.exp_pos _
    calc B * ‖f - g i‖ ≤ (B + 1) * (ε / (3 * (B + 1))) :=
          mul_le_mul (by linarith) hd.le (norm_nonneg _) (by linarith)
      _ = ε / 3 := by field_simp
  rw [dist_eq_norm] at hFG ⊢
  calc ‖F z f - G z f‖ ≤ ‖F z f - F z (g i)‖ + (‖F z (g i) - G z (g i)‖ +
        ‖G z (g i) - G z f‖) := (norm_sub_le_norm_sub_add_norm_sub _ _ _).trans
          (add_le_add le_rfl (norm_sub_le_norm_sub_add_norm_sub _ _ _))
    _ < ε / 3 + (ε / 3 + ε / 3) := by
        have h1 := hlip F hF
        have h2 := hlip G hG
        rw [norm_sub_rev] at h2
        linarith
    _ = ε := by ring

/-- **Corollary 5.2, compactness.**  The decorated formations obeying the mass law
`‖γ‖ + Σ_j ‖α_j‖ ≤ C` form a compact set in the compact-open weak topology. -/
theorem isCompact_decoratedSet (C : ℝ) : IsCompact (inFormSpace (decoratedSet (K := K) C)) := by
  obtain ⟨g, hg⟩ := TopologicalSpace.exists_dense_seq C(K, ℂ)
  haveI : IsCountablyGenerated (𝓤 (DecoratedSpace K C)) := by
    rw [uniformity_decoratedSpace_eq C hg]
    infer_instance
  rw [isCompact_iff_isCompact_univ, isCompact_iff_isSeqCompact]
  intro x _
  obtain ⟨φ, hφ, G, hG, hconv⟩ := decoratedSet_seqCompact fun n => (x n).2
  refine ⟨⟨G, hG⟩, mem_univ _, φ, hφ, ?_⟩
  rw [tendsto_subtype_rng]
  exact tendsto_formSpace_iff_formConv.2 hconv

/-- **Corollary 5.2, exact properness repair.**  In the compact-open weak topology the closure of
the formations of positive finite packets of mass `≤ C` is exactly the set of decorated
formations obeying the mass law. -/
theorem closure_packetFormationSet (C : ℝ) :
    closure (inFormSpace (packetFormationSet (K := K) C)) = inFormSpace (decoratedSet C) := by
  refine subset_antisymm ((isCompact_decoratedSet C).isClosed.closure_subset_iff.2
    (packetFormationSet_subset_decoratedSet C)) fun G hG => ?_
  obtain ⟨F, hF, hconv⟩ := mem_decoratedSet_iff.1 hG
  exact mem_closure_of_tendsto (tendsto_formSpace_iff_formConv.2 hconv) (Eventually.of_forall hF)

end GaloisForLFunctions.HTGeometry.FormationDust
