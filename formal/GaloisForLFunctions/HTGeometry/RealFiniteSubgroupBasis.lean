import GaloisForLFunctions.HTGeometry.RationalBasisIntegerCombination
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.LinearAlgebra.FreeModule.Finite.Basic
import Mathlib.Algebra.EuclideanDomain.Int
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# A rationally independent integral basis for a finitely generated subgroup of the line

The subgroup of `ℝ` generated by finitely many reals is a finitely generated torsion-free `ℤ`-module,
hence free of finite rank.  Any `ℤ`-basis of it is automatically `ℚ`-linearly independent: a rational
relation clears denominators to an integral one.

So a finite frequency packet always admits a rationally independent base generating *exactly* the
same group — the base the Bochner–Fejér kernel needs, without enlarging the frequency module.
-/

namespace GaloisForLFunctions

open scoped BigOperators

/-- **An integral basis of the group generated by a finite family of reals.**  The base is
`ℚ`-linearly independent and generates the same subgroup. -/
theorem exists_ratIndep_zBasis {n : ℕ} (lam : Fin n → ℝ) :
    ∃ (k : ℕ) (β : Fin k → ℝ), LinearIndependent ℚ β ∧
      Submodule.span ℤ (Set.range β) = Submodule.span ℤ (Set.range lam) := by
  classical
  set M : Submodule ℤ ℝ := Submodule.span ℤ (Set.range lam) with hM
  haveI : Module.Finite ℤ M := Module.Finite.iff_fg.mpr (Submodule.fg_span (Set.finite_range lam))
  haveI : Module.Free ℤ M := Module.free_of_finite_type_torsion_free'
  set b := Module.Free.chooseBasis ℤ M with hb
  set k : ℕ := Fintype.card (Module.Free.ChooseBasisIndex ℤ M) with hk
  set e : Fin k ≃ Module.Free.ChooseBasisIndex ℤ M := (Fintype.equivFin _).symm with he
  set β : Fin k → ℝ := fun i => ((b (e i) : M) : ℝ) with hβ
  have hbe : LinearIndependent ℤ fun i : Fin k => b (e i) :=
    b.linearIndependent.comp e e.injective
  refine ⟨k, β, ?_, ?_⟩
  · rw [linearIndependent_iff']
    intro s g hsum i hi
    set D : ℕ := ∏ j : Fin k, (g j).den with hD
    have hDpos : 0 < D := Finset.prod_pos fun j _ => (g j).pos
    have hDne : ((D : ℚ)) ≠ 0 := by
      have : (0 : ℚ) < D := by exact_mod_cast hDpos
      exact ne_of_gt this
    choose z hz using fun j : Fin k =>
      exists_int_nat_mul (g j) (Finset.dvd_prod_of_mem (fun j => (g j).den) (Finset.mem_univ j))
    rw [← hD] at hz
    -- the rational relation, cleared of denominators
    have hreal : ∑ j ∈ s, ((z j : ℤ) : ℝ) * β j = 0 := by
      have hscale : ∑ j ∈ s, ((D : ℝ)) * (((g j : ℚ) : ℝ) * β j) = 0 := by
        rw [← Finset.mul_sum]
        have : ∑ j ∈ s, ((g j : ℚ) : ℝ) * β j = 0 := by
          rw [← hsum]
          exact Finset.sum_congr rfl fun j _ => (Rat.smul_def (g j) (β j)).symm
        rw [this, mul_zero]
      refine Eq.trans ?_ hscale
      refine Finset.sum_congr rfl fun j _ => ?_
      have hcast : ((z j : ℤ) : ℝ) = (D : ℝ) * ((g j : ℚ) : ℝ) := by
        have := congrArg (fun q : ℚ => (q : ℝ)) (hz j)
        push_cast at this
        exact this.symm
      rw [hcast]
      ring
    -- transfer the relation into the module
    have hMzero : ∑ j ∈ s, z j • b (e j) = 0 := by
      refine Subtype.ext ?_
      have hcoe : ((∑ j ∈ s, z j • b (e j) : M) : ℝ) = ∑ j ∈ s, ((z j : ℤ) : ℝ) * β j := by
        rw [Submodule.coe_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Submodule.coe_smul, zsmul_eq_mul]
      rw [hcoe, hreal]
      rfl
    have hzj : z i = 0 := by
      rw [linearIndependent_iff'] at hbe
      exact hbe s z hMzero i hi
    have hq : (D : ℚ) * g i = 0 := by
      rw [hz i, hzj]
      norm_num
    exact (mul_eq_zero.mp hq).resolve_left hDne
  · have hrange : Set.range β = Set.range fun j => ((b j : M) : ℝ) :=
      EquivLike.range_comp (fun j => ((b j : M) : ℝ)) e
    have hmap : (Set.range fun j => ((b j : M) : ℝ))
        = M.subtype '' Set.range fun j => (b j : M) := by
      rw [← Set.range_comp]
      rfl
    rw [hrange, hmap, ← Submodule.map_span, b.span_eq, Submodule.map_top,
      Submodule.range_subtype]

/-- The members of the family are integral combinations of the base. -/
theorem mem_span_zBasis_of_span_eq {n k : ℕ} {lam : Fin n → ℝ} {β : Fin k → ℝ}
    (hspan : Submodule.span ℤ (Set.range β) = Submodule.span ℤ (Set.range lam)) (j : Fin n) :
    lam j ∈ Submodule.span ℤ (Set.range β) := by
  rw [hspan]
  exact Submodule.subset_span ⟨j, rfl⟩

end GaloisForLFunctions
