import GaloisForLFunctions.HTGeometry.FiniteDifferentialSystemAlgebraicity
import GaloisForLFunctions.HTGeometry.DifferentialSpanningBasis
import GaloisForLFunctions.HTGeometry.ProjectiveFrameCompanion
import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence

/-!
# The projective curvatures carry all the differential freedom

Each component of a homogeneous lift satisfying the normalized Wilczynski relation
`δ^N v = ∑_j q_j δ^j v` is a coordinate of the first-order companion system with coefficients in the
curvature field, hence differentially algebraic over it.  Consequently the whole lift field adds no
differential transcendence, and a curvature tuple of exactly the differential transcendence degree of
the source is differentially independent.
-/

open scoped Differential
open scoped Matrix

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The jet vector of one component of a lift. -/
def frameJet {F : Type*} [Field F] [Differential F] {N : ℕ} (v : Fin N → F) (i : Fin N) :
    Fin N → F := fun j => (vecDeriv^[(j : ℕ)] v) i

@[simp] theorem frameJet_apply {F : Type*} [Field F] [Differential F] {N : ℕ}
    (v : Fin N → F) (i j : Fin N) : frameJet v i j = (vecDeriv^[(j : ℕ)] v) i := rfl

/-- **The jets of one component satisfy the transposed companion system.** -/
theorem deriv_frameJet {I F : Type*} [Field I] [Field F] [Algebra I F]
    [Differential I] [Differential F] [DifferentialAlgebra I F] {N : ℕ}
    (v : Fin N → F) (q : Fin N → I)
    (hrel : ∀ i, (vecDeriv^[N] v) i = ∑ j, algebraMap I F (q j) * (vecDeriv^[(j : ℕ)] v) i)
    (i j : Fin N) :
    (frameJet v i j)′
      = ∑ k, algebraMap I F ((companionMatrix q)ᵀ j k) * frameJet v i k := by
  classical
  have hstep : (frameJet v i j)′ = (vecDeriv^[(j : ℕ) + 1] v) i := by
    rw [frameJet_apply, Function.iterate_succ_apply' vecDeriv]
    rfl
  rw [hstep]
  by_cases hj : (j : ℕ) + 1 < N
  · rw [Finset.sum_eq_single (⟨(j : ℕ) + 1, hj⟩ : Fin N)]
    · simp only [Matrix.transpose_apply, companionMatrix, Matrix.of_apply, frameJet_apply]
      rw [if_pos hj]
      simp
    · intro b _ hb
      simp only [Matrix.transpose_apply, companionMatrix, Matrix.of_apply]
      rw [if_pos hj, if_neg (fun h => hb (Fin.ext h)), map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ _) h
  · have hjN : (j : ℕ) + 1 = N := by omega
    have hcoef : ∀ k : Fin N, (companionMatrix q)ᵀ j k = q k := by
      intro k
      simp only [Matrix.transpose_apply, companionMatrix, Matrix.of_apply]
      exact if_neg hj
    simp only [hcoef, frameJet_apply]
    rw [hjN]
    exact hrel i

/-- **Every component of a normalized lift is differentially algebraic over the curvature
field.** -/
theorem differentialAlgebraicOver_lift_component {I F : Type*} [Field I] [Field F] [Algebra I F]
    [Differential I] [Differential F] [DifferentialAlgebra I F] {N : ℕ}
    (v : Fin N → F) (q : Fin N → I)
    (hrel : ∀ i, (vecDeriv^[N] v) i = ∑ j, algebraMap I F (q j) * (vecDeriv^[(j : ℕ)] v) i)
    (i : Fin N) : DifferentialAlgebraicOver I (v i) := by
  have hpos : 0 < N := i.pos
  have h := differentialAlgebraicOver_finiteLinearSystem_coordinate
    (fun j k => (companionMatrix q)ᵀ j k) (frameJet v i)
    (fun j => deriv_frameJet v q hrel i j) (⟨0, hpos⟩ : Fin N)
  have hzero : frameJet v i (⟨0, hpos⟩ : Fin N) = v i := rfl
  rwa [hzero] at h

/-- **The curvature tuple of a differential-generic source is differentially independent.**  A
family over which the source is differentially algebraic and whose size does not exceed the
differential transcendence degree of the source is a differential transcendence basis. -/
theorem curvature_differentialIndependent {C F : Type u} [Field C] [Field F] [Algebra C F]
    [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero F]
    {ι : Type u} [Finite ι] [Nonempty ι] (q : ι → F) (hinj : Function.Injective q)
    (hspan : ∀ y : F, DifferentialAlgebraicOver (differentialAdjoin C (Set.range q)) y)
    (hcard : Cardinal.mk ι ≤ differentialTranscendenceDegree C F) :
    DifferentialIndependent C q :=
  differentialIndependent_of_spanning_of_cardinalMk_le q hinj hspan hcard

/-! ### Transitivity, and the lift field adds nothing -/

/-- **Transitivity of differential algebraicity over a generated differential field.**  If every
member of `T` is differentially algebraic over the field generated by `S`, then so is everything
differentially algebraic over the field generated by `S ∪ T`. -/
theorem differentialAlgebraicOver_differentialAdjoin_union {C F : Type u} [Field C] [Field F]
    [Algebra C F] [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero F]
    {S T : Set F} (hT : ∀ y ∈ T, DifferentialAlgebraicOver (differentialAdjoin C S) y)
    {z : F} (hz : DifferentialAlgebraicOver (differentialAdjoin C (S ∪ T)) z) :
    DifferentialAlgebraicOver (differentialAdjoin C S) z := by
  rw [← differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin] at hz ⊢
  have hsub : S ∪ T ⊆ (differentialMatroid C F).closure S := by
    rintro x (hx | hx)
    · exact Matroid.subset_closure (differentialMatroid C F) S
        (by rw [differentialMatroid_ground]; exact Set.subset_univ S) hx
    · exact
        (differentialMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin).2
          (hT x hx)
  have hmono := Matroid.closure_subset_closure (differentialMatroid C F) hsub hz
  rwa [Matroid.closure_closure] at hmono

/-- **The normalized lift adds no differential transcendence over its curvature field.**  If the
source field is differentially algebraic over the curvatures together with the lift, it is already
differentially algebraic over the curvatures alone. -/
theorem forall_differentialAlgebraicOver_curvature {C F : Type u} [Field C] [Field F] [Algebra C F]
    [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero F] {N : ℕ}
    (v q : Fin N → F)
    (hrel : ∀ i, (vecDeriv^[N] v) i = ∑ j, q j * (vecDeriv^[(j : ℕ)] v) i)
    (hgen : ∀ z : F,
      DifferentialAlgebraicOver (differentialAdjoin C (Set.range q ∪ Set.range v)) z) :
    ∀ z : F, DifferentialAlgebraicOver (differentialAdjoin C (Set.range q)) z := by
  letI : Differential ↥(differentialAdjoin C (Set.range q)) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C (Set.range q))
  letI : DifferentialAlgebra ↥(differentialAdjoin C (Set.range q)) F :=
    ⟨fun c => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C (Set.range q)) c⟩
  set q' : Fin N → ↥(differentialAdjoin C (Set.range q)) := fun j =>
    ⟨q j, subset_differentialAdjoin C (Set.range q) (Set.mem_range_self j)⟩ with hq'
  have hrel' : ∀ i, (vecDeriv^[N] v) i
      = ∑ j, algebraMap ↥(differentialAdjoin C (Set.range q)) F (q' j)
          * (vecDeriv^[(j : ℕ)] v) i := hrel
  have hv : ∀ i, DifferentialAlgebraicOver (differentialAdjoin C (Set.range q)) (v i) := fun i =>
    differentialAlgebraicOver_lift_component v q' hrel' i
  intro z
  refine differentialAlgebraicOver_differentialAdjoin_union (C := C) (S := Set.range q)
    (T := Set.range v) ?_ (hgen z)
  rintro y ⟨i, rfl⟩
  exact hv i

/-- **The projective curvature tuple of a differential-generic source is jointly differentially
independent.**  The lift satisfies a linear system over the curvature field, so it adds no
differential transcendence; a curvature family of the size of the differential transcendence degree
of the source is therefore a differential transcendence basis. -/
theorem curvature_differentialIndependent_of_lift {C F : Type u} [Field C] [Field F] [Algebra C F]
    [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero F] {N : ℕ} (hN : 0 < N)
    (v q : Fin N → F) (hinj : Function.Injective q)
    (hrel : ∀ i, (vecDeriv^[N] v) i = ∑ j, q j * (vecDeriv^[(j : ℕ)] v) i)
    (hgen : ∀ z : F,
      DifferentialAlgebraicOver (differentialAdjoin C (Set.range q ∪ Set.range v)) z)
    (hcard : (N : Cardinal.{u}) ≤ differentialTranscendenceDegree C F) :
    DifferentialIndependent C q := by
  haveI : Nonempty (ULift.{u} (Fin N)) := ⟨ULift.up ⟨0, hN⟩⟩
  set q' : ULift.{u} (Fin N) → F := fun j => q j.down with hq'
  have hrange : Set.range q' = Set.range q := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩; exact ⟨j.down, rfl⟩
    · rintro ⟨j, rfl⟩; exact ⟨ULift.up j, rfl⟩
  have hinj' : Function.Injective q' := fun a b hab => by
    have := hinj hab
    exact ULift.ext _ _ this
  have hspan : ∀ y : F, DifferentialAlgebraicOver (differentialAdjoin C (Set.range q')) y := by
    rw [hrange]
    exact forall_differentialAlgebraicOver_curvature v q hrel hgen
  have hcard' : Cardinal.mk (ULift.{u} (Fin N)) ≤ differentialTranscendenceDegree C F := by
    simpa using hcard
  have hind : DifferentialIndependent C q' :=
    curvature_differentialIndependent q' hinj' hspan hcard'
  have := hind.comp (ULift.up : Fin N → ULift.{u} (Fin N)) (fun a b hab => by
    simpa using congrArg ULift.down hab)
  simpa [Function.comp_def, hq'] using this

/-- **General form: any derivation-closed generating set containing the curvatures absorbs the
lift.**  If every curvature lies in the differential field generated by `S`, then everything
differentially algebraic over `S` together with the lift is already differentially algebraic
over `S`. -/
theorem forall_differentialAlgebraicOver_of_curvature_mem {C F : Type u} [Field C] [Field F]
    [Algebra C F] [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero F] {N : ℕ}
    (v q : Fin N → F) (S : Set F) (hqS : ∀ j, q j ∈ differentialAdjoin C S)
    (hrel : ∀ i, (vecDeriv^[N] v) i = ∑ j, q j * (vecDeriv^[(j : ℕ)] v) i)
    (hgen : ∀ z : F, DifferentialAlgebraicOver (differentialAdjoin C (S ∪ Set.range v)) z) :
    ∀ z : F, DifferentialAlgebraicOver (differentialAdjoin C S) z := by
  letI : Differential ↥(differentialAdjoin C S) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C S)
  letI : DifferentialAlgebra ↥(differentialAdjoin C S) F :=
    ⟨fun c => derivationClosedDifferential_apply _ (derivationClosed_differentialAdjoin C S) c⟩
  have hrel' : ∀ i, (vecDeriv^[N] v) i
      = ∑ j, algebraMap ↥(differentialAdjoin C S) F ⟨q j, hqS j⟩
          * (vecDeriv^[(j : ℕ)] v) i := hrel
  have hv : ∀ i, DifferentialAlgebraicOver (differentialAdjoin C S) (v i) := fun i =>
    differentialAlgebraicOver_lift_component v (fun j => ⟨q j, hqS j⟩) hrel' i
  intro z
  refine differentialAlgebraicOver_differentialAdjoin_union (C := C) (S := S)
    (T := Set.range v) ?_ (hgen z)
  rintro y ⟨i, rfl⟩
  exact hv i

end

end GaloisForLFunctions.HTGeometry
