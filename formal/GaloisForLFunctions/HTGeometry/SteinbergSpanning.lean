import GaloisForLFunctions.HTGeometry.SolomonBaseCase
import GaloisForLFunctions.HTGeometry.BuildingAutomorphismAction

/-!
# The Steinberg module is generated by the apartment classes

Solomon's theorem is proved for a family of interval buildings at once; for a single vector space it
reads: the apartment classes of the frames of that space generate the top homology of its building,
which is the Steinberg module.

A frame of the whole space is a family of independent lines spanning it, and the class of its
apartment is the image of the fundamental class of the Coxeter sphere of the frame.
-/

namespace GaloisForLFunctions.HTGeometry

open CategoryTheory Limits Simplicial Opposite Module

universe v u c

section

variable {K V : Type u} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
variable {C : Type c} [Category.{v} C] [Abelian C] [Limits.HasCoproducts.{u} C]

/-- The apartment of a frame of the whole space, as a map of order complexes into the building. -/
noncomputable def buildingApartmentMap {ι : Type u}
    (D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι) :
    nerve (properPart (Set ι)) ⟶ nerveFunctor.obj (Cat.of (properPart (Submodule K V))) :=
  orderHomNerveMap D.vertices
    ≫ (orderIsoNerveIso (famBuildingPUnitOrderIso (L := Submodule K V))).hom

/-- **The apartment class of a frame of the whole space**, in the homology of its building. -/
noncomputable def buildingApartmentClass {n : ℕ} {ι : Type u} (e₀ : Fin (n + 3) ≃ ι)
    (D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι) (R : C) :
    R ⟶ (nerveFunctor.obj (Cat.of (properPart (Submodule K V)))).homology R (n + 1) :=
  apartmentClassIn e₀ (buildingApartmentMap D) R

/-- **Solomon's theorem for one space**: the apartment classes of the frames generate the top
homology of the building. -/
theorem epi_buildingApartmentClasses {n : ℕ} {ι : Type u} [Finite ι] (hN : Nat.card ι = n + 3)
    (e₀ : Fin (n + 3) ≃ ι) (hdim : finrank K V = n + 3) (R : C) :
    Epi (Limits.Sigma.desc (fun D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι =>
      buildingApartmentClass e₀ D R)) := by
  have hsol := epi_frameDatum_classes_solomon (K := K) (V := V) (C := C) n PUnit.{u + 1}
    ⟨PUnit.unit⟩ (fun _ => ⊤) ι inferInstance hN e₀
    (fun _ => by rw [finrank_top]; exact hdim) R
  have hpt : (fun D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι =>
        buildingApartmentClass e₀ D R)
      = fun D => apartmentClassIn e₀ (orderHomNerveMap D.vertices) R
        ≫ SSet.homologyMap
          (orderIsoNerveIso (famBuildingPUnitOrderIso (L := Submodule K V))).hom R (n + 1) :=
    funext fun D => (apartmentClassIn_comp_homologyMap _ _ _ _).symm
  rw [hpt]
  refine epi_sigmaDesc_comp_iso _ _
    ⟨SSet.homologyMap (orderIsoNerveIso (famBuildingPUnitOrderIso (L := Submodule K V))).inv R
      (n + 1), ?_, ?_⟩ hsol
  · rw [← SSet.homologyMap_comp, Iso.hom_inv_id, SSet.homologyMap_id]
  · rw [← SSet.homologyMap_comp, Iso.inv_hom_id, SSet.homologyMap_id]

/-- **The Steinberg module is generated by the apartment classes.** -/
theorem epi_steinbergApartmentClasses {n : ℕ} {ι : Type u} [Finite ι] (hN : Nat.card ι = n + 3)
    (e₀ : Fin (n + 3) ≃ ι) (hdim : finrank K V = n + 3) (R : C) :
    Epi (Limits.Sigma.desc (fun D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι =>
      (buildingApartmentClass e₀ D R
        ≫ eqToHom (congrArg
          (fun m => (nerveFunctor.obj (Cat.of (properPart (Submodule K V)))).homology R m)
          (show n + 1 = finrank K V - 2 by rw [hdim]; omega)) : R ⟶ steinbergModule K V R))) := by
  refine epi_sigmaDesc_comp_iso _ _ ?_ (epi_buildingApartmentClasses hN e₀ hdim R)
  exact (eqToIso (congrArg
    (fun m => (nerveFunctor.obj (Cat.of (properPart (Submodule K V)))).homology R m)
    (show n + 1 = finrank K V - 2 by rw [hdim]; omega))).isIso_hom

end

end GaloisForLFunctions.HTGeometry
