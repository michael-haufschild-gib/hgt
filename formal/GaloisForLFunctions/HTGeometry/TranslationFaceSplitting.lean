import Mathlib.Algebra.MvPolynomial.Monad
import Mathlib.Algebra.MvPolynomial.Variables
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Tactic

/-!
# Splitting a translation operator along one direction

Substituting `1` for one variable is the algebraic form of the evaluation `T_j = 1` that the
annihilator argument performs.  Two facts govern it.

*The splitting.*  For any two algebra homomorphisms out of a polynomial ring, the difference of the
values lies in the ideal generated by the differences on the variables.  With the identity and the
substitution `X_j ↦ 1` this says

```text
P - P|_{X_j = 1} ∈ (X_j - 1),
```

so `P = Q + (X_j - 1) S` with `Q = P|_{X_j = 1}`, and `Q` does not involve `X_j` at all.

*The divisibility criterion.*  Over a domain, if `P` vanishes under the substitution `X_j ↦ 1` for
every `j` in a finite set, then the product of the `X_j - 1` over that set divides `P`.  No
primality is needed: after factoring out one `X_i - 1`, the substitution in another direction fixes
that factor, and cancelling it in a domain propagates the vanishing to the cofactor.

Contrapositively, if the squarefree product does not divide `P`, some direction has a nonzero
restriction `P|_{X_j = 1}` — the distinguished index and the nonzero operator the reverse inclusion
of the annihilator theorem needs, produced at once.
-/

open scoped BigOperators

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

/-! ## Two algebra homomorphisms differ inside the ideal of variable differences -/

/-- **The difference of two algebra homomorphisms lies in the ideal generated by the differences on
the variables.** -/
theorem sub_mem_span_range_sub_of_algHom {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    {σ : Type*} (f g : MvPolynomial σ R →ₐ[R] B) (P : MvPolynomial σ R) :
    f P - g P ∈ Ideal.span (Set.range fun i => f (X i) - g (X i)) := by
  induction P using MvPolynomial.induction_on with
  | C a =>
    have hca : (C a : MvPolynomial σ R) = algebraMap R (MvPolynomial σ R) a := by
      rw [MvPolynomial.algebraMap_eq]
    rw [hca, AlgHom.commutes, AlgHom.commutes, sub_self]
    exact Ideal.zero_mem _
  | add p q hp hq =>
    have hpq : f (p + q) - g (p + q) = (f p - g p) + (f q - g q) := by
      rw [map_add, map_add]
      ring
    rw [hpq]
    exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
    have hsplit : f (p * X i) - g (p * X i)
        = (f p - g p) * f (X i) + g p * (f (X i) - g (X i)) := by
      rw [map_mul, map_mul]
      ring
    rw [hsplit]
    refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
    exact Ideal.subset_span ⟨i, rfl⟩

/-! ## Substituting one for a single variable -/

variable {R : Type*} [CommRing R] {σ : Type*} [DecidableEq σ]

/-- Substituting `1` for the variable `j`. -/
def evalOneAt (j : σ) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  MvPolynomial.bind₁ fun k => if k = j then 1 else X k

@[simp] theorem evalOneAt_X_self (j : σ) : evalOneAt (R := R) j (X j) = 1 := by
  rw [evalOneAt, MvPolynomial.bind₁_X_right, if_pos rfl]

@[simp] theorem evalOneAt_X_of_ne {j k : σ} (h : k ≠ j) :
    evalOneAt (R := R) j (X k) = X k := by
  rw [evalOneAt, MvPolynomial.bind₁_X_right, if_neg h]

theorem evalOneAt_X_sub_one (j : σ) :
    evalOneAt (R := R) j (X j - 1) = 0 := by
  rw [map_sub, evalOneAt_X_self, map_one, sub_self]

/-- **The splitting.**  `P` and its restriction at `X_j = 1` differ by a multiple of `X_j - 1`. -/
theorem sub_evalOneAt_mem_span (j : σ) (P : MvPolynomial σ R) :
    P - evalOneAt j P ∈ Ideal.span {(X j - 1 : MvPolynomial σ R)} := by
  have hgen := sub_mem_span_range_sub_of_algHom (AlgHom.id R (MvPolynomial σ R)) (evalOneAt j) P
  refine Ideal.span_le.mpr ?_ hgen
  rintro x ⟨i, rfl⟩
  simp only [AlgHom.id_apply]
  by_cases hi : i = j
  · subst hi
    rw [evalOneAt_X_self]
    exact Ideal.subset_span rfl
  · rw [evalOneAt_X_of_ne hi, sub_self]
    exact Ideal.zero_mem _

theorem dvd_of_evalOneAt_eq_zero {j : σ} {P : MvPolynomial σ R} (h : evalOneAt j P = 0) :
    (X j - 1 : MvPolynomial σ R) ∣ P := by
  have hmem := sub_evalOneAt_mem_span j P
  rw [h, sub_zero, Ideal.mem_span_singleton] at hmem
  exact hmem

theorem evalOneAt_eq_zero_of_dvd {j : σ} {P : MvPolynomial σ R}
    (h : (X j - 1 : MvPolynomial σ R) ∣ P) : evalOneAt j P = 0 := by
  obtain ⟨Q, rfl⟩ := h
  rw [map_mul, evalOneAt_X_sub_one, zero_mul]

/-! ## The restriction avoids its direction -/

/-- **The restriction at `X_j = 1` does not involve `X_j`.** -/
theorem support_evalOneAt_apply_eq_zero [Nontrivial R] (j : σ) (P : MvPolynomial σ R)
    {n : σ →₀ ℕ} (hn : n ∈ (evalOneAt j P).support) : n j = 0 := by
  classical
  have hvars : j ∉ (evalOneAt j P).vars := by
    intro hj
    have hsub := MvPolynomial.vars_bind₁ (fun k => if k = j then (1 : MvPolynomial σ R) else X k) P
    rw [evalOneAt] at hj
    obtain ⟨i, _, hi⟩ := Finset.mem_biUnion.mp (hsub hj)
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl, MvPolynomial.vars_one] at hi
      exact absurd hi (Finset.notMem_empty _)
    · rw [if_neg hij, MvPolynomial.vars_X] at hi
      exact hij (Finset.mem_singleton.mp hi).symm
  by_contra hnj
  exact hvars ((MvPolynomial.mem_vars_iff_mem_support j).mpr
    ⟨n, hn, Finsupp.mem_support_iff.mpr hnj⟩)

/-! ## The divisibility criterion -/

theorem X_sub_one_ne_zero [Nontrivial R] (i : σ) :
    (X i - 1 : MvPolynomial σ R) ≠ 0 := by
  intro h
  have h1 : (X i : MvPolynomial σ R) = 1 := by
    rw [← sub_eq_zero]
    exact h
  have hc := congrArg (MvPolynomial.coeff (Finsupp.single i 1)) h1
  rw [MvPolynomial.coeff_X, MvPolynomial.coeff_one, if_pos rfl, if_neg] at hc
  · exact one_ne_zero hc
  · intro hcon
    have := congrArg (fun t : σ →₀ ℕ => t i) hcon
    simp at this

/-- **The divisibility criterion.**  Over a domain, vanishing under every substitution `X_j ↦ 1`
forces the squarefree product to divide.  Cancelling one factor in a domain propagates the vanishing
to the cofactor, so no primality is needed. -/
theorem prod_X_sub_one_dvd_of_forall_evalOneAt_eq_zero [IsDomain R] :
    ∀ (S : Finset σ) (P : MvPolynomial σ R), (∀ j ∈ S, evalOneAt j P = 0) →
      (∏ j ∈ S, (X j - 1 : MvPolynomial σ R)) ∣ P := by
  classical
  intro S
  induction S using Finset.induction with
  | empty =>
      intro P _
      rw [Finset.prod_empty]
      exact one_dvd P
  | @insert i S hi ih =>
      intro P hP
      obtain ⟨Q, rfl⟩ := dvd_of_evalOneAt_eq_zero (hP i (Finset.mem_insert_self i S))
      have hQ : ∀ j ∈ S, evalOneAt j Q = 0 := by
        intro j hj
        have hji : j ≠ i := fun hcon => hi (hcon ▸ hj)
        have h0 := hP j (Finset.mem_insert_of_mem hj)
        rw [map_mul, map_sub, evalOneAt_X_of_ne hji.symm, map_one] at h0
        rcases mul_eq_zero.mp h0 with hcase | hcase
        · exact absurd hcase (X_sub_one_ne_zero i)
        · exact hcase
      obtain ⟨T, hT⟩ := ih Q hQ
      refine ⟨T, ?_⟩
      rw [Finset.prod_insert hi, hT]
      ring

/-- **The distinguished direction.**  If the squarefree product does not divide `P`, some direction
has a nonzero restriction at `X_j = 1`. -/
theorem exists_evalOneAt_ne_zero_of_not_dvd [IsDomain R] {S : Finset σ}
    {P : MvPolynomial σ R} (h : ¬ (∏ j ∈ S, (X j - 1 : MvPolynomial σ R)) ∣ P) :
    ∃ j ∈ S, evalOneAt j P ≠ 0 := by
  by_contra hcon
  push Not at hcon
  exact h (prod_X_sub_one_dvd_of_forall_evalOneAt_eq_zero S P hcon)

end

end GaloisForLFunctions
