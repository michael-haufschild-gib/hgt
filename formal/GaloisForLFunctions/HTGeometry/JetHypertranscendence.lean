import GaloisForLFunctions.HTGeometry.JetLevelAlgebraicallyClosed
import GaloisForLFunctions.HTGeometry.JetOrderDerivative

/-!
# Every element of positive order in the free differential rational field is hypertranscendental

Differentiation raises the jet order by exactly one, and a jet level is algebraically closed.  So the
next jet of an element of positive order is transcendental over the field generated by the previous
ones, and the whole jet family is algebraically independent.

That is hypertranscendence: a free differential field over a field of constants has no differentially
algebraic element except those already expressible in a single jet level of order zero.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open JetField

noncomputable section

variable {C ι : Type*} [Field C] [CharZero C] [Fintype ι]

omit [Fintype ι] in
/-- An element all of whose coordinate derivatives vanish is a constant. -/
theorem mem_bot_of_pd_eq_zero {u : JetField C ι} (hu : ∀ q : ι × ℕ, pd q u = 0) :
    u ∈ (⊥ : IntermediateField C (JetField C ι)) := by
  have hmem := mem_adjoin_of_pd_eq_zero (S := (∅ : Set (ι × ℕ))) (fun q _ => hu q)
  simpa using hmem

/-- **Differentiation raises the order by exactly one for every nonconstant element.**  The corpus's
version assumes positive order; the order-zero case is the one where the first coordinate
derivative of the element itself becomes the top coordinate derivative of its derivative. -/
theorem ordJet_deriv_eq_of_notMem_bot {u : JetField C ι}
    (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) :
    ordJet (u′) = ordJet u + 1 := by
  by_cases h0 : ordJet u = 0
  · refine le_antisymm (by simpa [h0] using ordJet_deriv_le u) ?_
    rw [h0]
    by_contra hcon
    have hzero : ordJet (u′) = 0 := by omega
    have hpd : ∀ j : ι, ∀ m : ℕ, 0 < m → pd (j, m) (u′) = 0 := by
      intro j m hm
      exact pd_eq_zero_of_ordJet_lt (u′) (by omega)
    refine hu (mem_bot_of_pd_eq_zero ?_)
    rintro ⟨j, m⟩
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · have hstep := pd_deriv_succ j 0 u
      have hone : pd ((j, 1) : ι × ℕ) (u′) = 0 := hpd j 1 (by omega)
      have hzero1 : pd ((j, 1) : ι × ℕ) u = 0 := pd_eq_zero_of_ordJet_lt u (by omega)
      rw [hone, hzero1, map_zero, zero_add] at hstep
      exact hstep.symm
    · exact pd_eq_zero_of_ordJet_lt u (by omega)
  · exact ordJet_deriv_eq h0

/-- A nonconstant element has nonconstant derivative. -/
theorem deriv_notMem_bot_of_notMem_bot {u : JetField C ι}
    (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) :
    (u′) ∉ (⊥ : IntermediateField C (JetField C ι)) := by
  intro hmem
  have hpd : ∀ q : ι × ℕ, pd q (u′) = 0 := by
    intro q
    have hle : (⊥ : IntermediateField C (JetField C ι)) ≤ IntermediateField.adjoin C
        ((fun p => (jet p : JetField C ι)) '' (∅ : Set (ι × ℕ))) := by
      simp
    exact pd_eq_zero_of_mem_adjoin (S := (∅ : Set (ι × ℕ))) (by simp) (hle hmem)
  have hord : ordJet (u′) = 0 := by
    refine Nat.le_zero.mp ((ordJet_le_iff _ 0).2 (mem_adjoin_of_pd_eq_zero fun q _ => hpd q))
  rw [ordJet_deriv_eq_of_notMem_bot hu] at hord
  omega

/-- **Iterated differentiation raises the order by exactly the number of derivatives**, for every
nonconstant element. -/
theorem ordJet_iterate_of_notMem_bot {u : JetField C ι}
    (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) (k : ℕ) :
    ordJet (differentialJet k u) = ordJet u + k := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hnot : differentialJet k u ∉ (⊥ : IntermediateField C (JetField C ι)) := by
        clear ih
        induction k with
        | zero => simpa using hu
        | succ k ihk => simpa [differentialJet_succ] using deriv_notMem_bot_of_notMem_bot ihk
      rw [differentialJet_succ, ordJet_deriv_eq_of_notMem_bot hnot, ih]
      omega

/-- The jets below a bound lie in the corresponding jet level. -/
theorem differentialJet_mem_jetLevel {u : JetField C ι} (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) {N k : ℕ}
    (hk : k < N) :
    differentialJet k u ∈ IntermediateField.adjoin C
      ((fun p => (jet p : JetField C ι)) '' {p : ι × ℕ | p.2 ≤ ordJet u + N - 1}) := by
  refine (ordJet_le_iff _ _).1 ?_
  rw [ordJet_iterate_of_notMem_bot hu]
  omega

omit [Fintype ι] [CharZero C] in
/-- Algebraicity over a subalgebra passes to any intermediate field containing it. -/
theorem isAlgebraic_of_adjoin_le {A : Subalgebra C (JetField C ι)}
    {K : IntermediateField C (JetField C ι)} (h : A ≤ K.toSubalgebra)
    {x : JetField C ι} (hx : IsAlgebraic A x) : IsAlgebraic K x := by
  classical
  obtain ⟨p, hp0, hp⟩ := hx
  refine ⟨p.map (Subalgebra.inclusion h).toRingHom, ?_, ?_⟩
  · intro h0
    refine hp0 (Polynomial.ext fun i => ?_)
    have hco := congrArg (fun q => Polynomial.coeff q i) h0
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at hco
    rw [Polynomial.coeff_zero]
    exact Subalgebra.inclusion_injective h (by simpa using hco)
  · rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    have hcomp : ((algebraMap K (JetField C ι)).comp
        (Subalgebra.inclusion h).toRingHom) = algebraMap A (JetField C ι) :=
      RingHom.ext fun z => rfl
    rw [hcomp, ← Polynomial.aeval_def]
    exact hp

omit [Fintype ι] [CharZero C] in
/-- The coordinate derivations annihilate the base field. -/
theorem pd_eq_zero_of_mem_bot {x : JetField C ι}
    (hx : x ∈ (⊥ : IntermediateField C (JetField C ι))) (q : ι × ℕ) : pd q x = 0 := by
  have hle : (⊥ : IntermediateField C (JetField C ι)) ≤ IntermediateField.adjoin C
      ((fun p => (jet p : JetField C ι)) '' (∅ : Set (ι × ℕ))) := by
    simp
  exact pd_eq_zero_of_mem_adjoin (S := (∅ : Set (ι × ℕ))) (by simp) (hle hx)

/-- **The next jet is transcendental over the previous ones.** -/
theorem transcendental_differentialJet {u : JetField C ι}
    (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) (N : ℕ) :
    Transcendental (Algebra.adjoin C
      (Set.range (fun k : Fin N => differentialJet (k : ℕ) u))) (differentialJet N u) := by
  classical
  intro halg
  by_cases hzero : ordJet u + N = 0
  · -- the degenerate corner: no previous jets and the element itself has order zero
    obtain ⟨hu0, hN0⟩ : ordJet u = 0 ∧ N = 0 := ⟨by omega, by omega⟩
    subst hN0
    have hsub : Algebra.adjoin C (Set.range (fun k : Fin 0 => differentialJet (k : ℕ) u)) ≤
        (⊥ : IntermediateField C (JetField C ι)).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨k, rfl⟩
      exact absurd k.2 (by omega)
    have halg' : IsAlgebraic (⊥ : IntermediateField C (JetField C ι)) u := by
      simpa using isAlgebraic_of_adjoin_le hsub halg
    refine hu (mem_bot_of_pd_eq_zero fun q => ?_)
    exact derivation_eq_zero_of_isAlgebraic _ ((pd q).restrictScalars ℤ)
      (fun x hx => by simpa using pd_eq_zero_of_mem_bot hx q) halg'
  · -- the generic case: the previous jets stay inside the level below the new jet
    have hsub : Algebra.adjoin C (Set.range (fun k : Fin N => differentialJet (k : ℕ) u)) ≤
        (IntermediateField.adjoin C
          ((fun p => (jet p : JetField C ι)) ''
            {p : ι × ℕ | p.2 ≤ ordJet u + N - 1})).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨k, rfl⟩
      exact differentialJet_mem_jetLevel hu k.2
    have hle := ordJet_le_of_isAlgebraic (isAlgebraic_of_adjoin_le hsub halg)
    rw [ordJet_iterate_of_notMem_bot hu] at hle
    omega

/-- The initial jet families of a nonconstant element are algebraically independent. -/
theorem algebraicIndependent_differentialJet_fin {u : JetField C ι} (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) (N : ℕ) :
    AlgebraicIndependent C (fun k : Fin N => differentialJet (k : ℕ) u) := by
  classical
  induction N with
  | zero =>
      refine algebraicIndependent_empty_type_iff.2 ?_
      exact (algebraMap C (JetField C ι)).injective
  | succ N ih =>
      have hopt := (ih.option_iff_transcendental (differentialJet N u)).2
        (transcendental_differentialJet hu N)
      have heq : (fun k : Fin (N + 1) ↦ differentialJet (k : ℕ) u) =
          (fun o : Option (Fin N) ↦ o.elim (differentialJet N u)
            (fun k : Fin N ↦ differentialJet (k : ℕ) u)) ∘ finSuccEquivLast := by
        funext k
        refine Fin.lastCases ?_ ?_ k
        · simp
        · intro j
          simp
      rw [heq]
      exact (algebraicIndependent_equiv finSuccEquivLast).2 hopt

/-- **Every nonconstant element of the free differential rational field is hypertranscendental.**
A field of constants has no differentially algebraic element in its free differential extension
except its own elements. -/
theorem hypertranscendentalOver_of_notMem_bot {u : JetField C ι}
    (hu : u ∉ (⊥ : IntermediateField C (JetField C ι))) :
    HypertranscendentalOver C u := by
  classical
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  refine algebraicIndependent_of_finite_type ?_
  intro s hs
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ p ∈ s, p.2 < N := by
    obtain ⟨M, hM⟩ := (hs.image Prod.snd).bddAbove
    exact ⟨M + 1, fun p hp => Nat.lt_succ_of_le (hM ⟨p, hp, rfl⟩)⟩
  have hinj : Function.Injective (fun p : s => (⟨p.1.2, hN p.1 p.2⟩ : Fin N)) := by
    rintro ⟨⟨a, m⟩, ha⟩ ⟨⟨b, n⟩, hb⟩ h
    obtain rfl : a = b := Subsingleton.elim _ _
    have hmn : m = n := by simpa using h
    subst hmn
    rfl
  have hcomp := (algebraicIndependent_differentialJet_fin hu N).comp
    (fun p : s => (⟨p.1.2, hN p.1 p.2⟩ : Fin N)) hinj
  have heq : ((fun k : Fin N ↦ differentialJet (k : ℕ) u) ∘
      fun p : s => (⟨p.1.2, hN p.1 p.2⟩ : Fin N)) =
      fun p : s => differentialJet ((p : Unit × ℕ).2) u := rfl
  rw [heq] at hcomp
  exact hcomp

end

end GaloisForLFunctions.HTGeometry
