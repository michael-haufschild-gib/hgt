import GaloisForLFunctions.HTGeometry.FreeCoordinateExponentialObstruction
import GaloisForLFunctions.HTGeometry.FreeCoordinateSupportKernel
import GaloisForLFunctions.HTGeometry.DerivationPrescription
import GaloisForLFunctions.HTGeometry.CoordinateDerivationCommute
import GaloisForLFunctions.HTGeometry.PolynomialTotalDerivative
import Mathlib.FieldTheory.Minpoly.Field

/-!
# Algebraic descent through free-coordinate constant fields

Let a derivation of a field extend to an algebraic field extension.  If an algebraic element is
horizontal upstairs, differentiating its minimal polynomial shows that every coefficient is
horizontal downstairs: the coefficient derivative polynomial has smaller degree than the monic
minimal polynomial and vanishes at the element.

For a free rational coordinate field, applying this argument to every coordinate derivation outside
a set `S` puts all minimal-polynomial coefficients in the rational subfield generated by `S`.
Consequently the horizontal algebraic element is algebraic over that smaller coordinate field.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

/-- **Horizontal minimal-polynomial coefficients.**  If `DL` extends `DK` and kills an element
algebraic over the base field, `DK` kills every coefficient of its minimal polynomial. -/
theorem minpoly_coeff_deriv_eq_zero
    {C K L : Type*} [Field C] [Field K] [Field L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
    (DK : Derivation C K K) (DL : Derivation C L L)
    (hmap : ∀ x : K, DL (algebraMap K L x) = algebraMap K L (DK x))
    {u : L} (hu : IsAlgebraic K u) (hDu : DL u = 0) :
    ∀ n, DK ((minpoly K u).coeff n) = 0 := by
  classical
  letI : Differential K := differentialOfDerivation DK
  letI : Differential L := differentialOfDerivation DL
  let p : Polynomial K := minpoly K u
  let P : Polynomial L := p.map (algebraMap K L)
  have hp0 : p ≠ 0 := minpoly.ne_zero hu.isIntegral
  have hpmonic : p.Monic := minpoly.monic hu.isIntegral
  have hPeval : Polynomial.eval u P = 0 := by
    simp only [P, Polynomial.eval_map, ← Polynomial.aeval_def]
    exact minpoly.aeval K u
  have hcoeffeval : Polynomial.eval u (coeffDeriv P) = 0 := by
    have hchain := deriv_eval P u
    have hDu' : u′ = 0 := hDu
    rw [hPeval, hDu'] at hchain
    simpa using hchain.symm
  let q : Polynomial K := coeffDeriv p
  have hqmap : q.map (algebraMap K L) = coeffDeriv P := by
    ext n
    rw [Polynomial.coeff_map, coeffDeriv_coeff, coeffDeriv_coeff,
      show P.coeff n = (p.map (algebraMap K L)).coeff n from rfl,
      Polynomial.coeff_map]
    exact (hmap _).symm
  have hqeval : Polynomial.aeval u q = 0 := by
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, hqmap]
    exact hcoeffeval
  have hq0 : q = 0 := by
    by_contra hqne
    have hle := minpoly.degree_le_of_ne_zero K u hqne hqeval
    have hlt : q.degree < (p.natDegree : WithBot ℕ) :=
      (Polynomial.degree_lt_iff_coeff_zero q p.natDegree).2 (by
        intro m hm
        change (coeffDeriv p).coeff m = 0
        rw [coeffDeriv_coeff]
        by_cases heq : m = p.natDegree
        · subst m
          rw [hpmonic.coeff_natDegree]
          simp
        · have hgt : p.natDegree < m := lt_of_le_of_ne hm (Ne.symm heq)
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt]
          exact map_zero _)
    rw [Polynomial.degree_eq_natDegree hp0] at hle
    exact (not_le_of_gt hlt) hle
  intro n
  have hcoeff : (p.coeff n)′ = 0 := by
    rw [← coeffDeriv_coeff, ← show q = coeffDeriv p from rfl, hq0,
      Polynomial.coeff_zero]
  simpa [p] using hcoeff

/-- A derivation of an algebraic extension that vanishes on the base field vanishes everywhere. -/
theorem derivation_eq_zero_of_isAlgebraic_extension
    {C K L : Type*} [Field C] [Field K] [CharZero K] [Field L] [CharZero L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
    (D : Derivation C L L)
    (hK : ∀ x : K, D (algebraMap K L x) = 0)
    {u : L} (hu : IsAlgebraic K u) : D u = 0 := by
  classical
  letI : Differential L := differentialOfDerivation D
  let p : Polynomial K := minpoly K u
  let P : Polynomial L := p.map (algebraMap K L)
  have hp0 : p ≠ 0 := minpoly.ne_zero hu.isIntegral
  have hPeval : Polynomial.eval u P = 0 := by
    simp only [P, Polynomial.eval_map, ← Polynomial.aeval_def]
    exact minpoly.aeval K u
  have hdp0 : Polynomial.derivative p ≠ 0 := by
    intro hcon
    have hnat := Polynomial.derivative_eq_zero.mp hcon
    have hpdeg : 0 < p.natDegree := minpoly.natDegree_pos hu.isIntegral
    omega
  have hBne : Polynomial.eval u (Polynomial.derivative P) ≠ 0 := by
    simp only [show P = p.map (algebraMap K L) from rfl,
      Polynomial.derivative_map, Polynomial.eval_map, ← Polynomial.aeval_def]
    intro hcon
    have hle := minpoly.degree_le_of_ne_zero K u hdp0 hcon
    have hlt := Polynomial.degree_derivative_lt hp0
    exact absurd hle (not_le.mpr hlt)
  have hcoeff : coeffDeriv P = 0 := by
    ext n
    rw [coeffDeriv_coeff, Polynomial.coeff_zero,
      show P.coeff n = (p.map (algebraMap K L)).coeff n from rfl,
      Polynomial.coeff_map]
    exact hK _
  have hchain := deriv_eval P u
  rw [hPeval, hcoeff] at hchain
  simp only [map_zero, Polynomial.eval_zero, zero_add] at hchain
  have hzero : Polynomial.eval u (Polynomial.derivative P) * D u = 0 := hchain.symm
  exact (mul_eq_zero.mp hzero).resolve_left hBne

/-- Commuting derivations remain commuting after extension through an algebraic field extension. -/
theorem derivation_commute_of_algebraic_extension
    {C K L : Type*} [Field C] [Field K] [CharZero K] [Field L] [CharZero L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
    [Algebra.IsAlgebraic K L]
    (DK₁ DK₂ : Derivation C K K) (DL₁ DL₂ : Derivation C L L)
    (hmap₁ : ∀ x : K, DL₁ (algebraMap K L x) = algebraMap K L (DK₁ x))
    (hmap₂ : ∀ x : K, DL₂ (algebraMap K L x) = algebraMap K L (DK₂ x))
    (hcomm : ∀ x, DK₁ (DK₂ x) = DK₂ (DK₁ x)) :
    ∀ u, DL₁ (DL₂ u) = DL₂ (DL₁ u) := by
  intro u
  have hz : ⁅DL₁, DL₂⁆ u = 0 := derivation_eq_zero_of_isAlgebraic_extension
    ⁅DL₁, DL₂⁆ (fun x => by
      rw [Derivation.commutator_apply, hmap₂, hmap₁, hmap₁, hmap₂,
        hcomm, sub_self]) (Algebra.IsAlgebraic.isAlgebraic u)
  rw [Derivation.commutator_apply] at hz
  exact sub_eq_zero.mp hz

/-- Free-coordinate derivations commute on the free rational coordinate field. -/
theorem freeCoordinateDerivation_commute
    {C σ : Type*} [Field C] (i j : σ) (x : FreeCoordinateRationalField C σ) :
    freeCoordinateDerivation C σ i (freeCoordinateDerivation C σ j x) =
      freeCoordinateDerivation C σ j (freeCoordinateDerivation C σ i x) := by
  have hp : ⁅(MvPolynomial.pderiv i : Derivation C (MvPolynomial σ C) (MvPolynomial σ C)),
      (MvPolynomial.pderiv j : Derivation C (MvPolynomial σ C) (MvPolynomial σ C))⁆ =
      (0 : Derivation C (MvPolynomial σ C) (MvPolynomial σ C)) := by
    ext p
    rw [Derivation.commutator_apply, GaloisForLFunctions.pderiv_comm, sub_self]
    rfl
  have hlie := extendFreeCoordinatePolynomialDerivation_lie (C := C) (σ := σ)
    (MvPolynomial.pderiv i) (MvPolynomial.pderiv j)
  rw [hp, extendFreeCoordinatePolynomialDerivation_zero] at hlie
  have h := congrArg (fun D : Derivation C (FreeCoordinateRationalField C σ)
      (FreeCoordinateRationalField C σ) => D x) hlie
  rw [Derivation.commutator_apply] at h
  exact sub_eq_zero.mp h

/-- If the coefficients of the minimal polynomial over `K` lie in an intermediate field `F`, then
the element is already algebraic over `F`. -/
theorem isAlgebraic_of_minpoly_coeff_mem_intermediateField
    {C K L : Type*} [Field C] [Field K] [Field L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
    (F : IntermediateField C K) {u : L} (hu : IsAlgebraic K u)
    (hcoeff : ∀ n, (minpoly K u).coeff n ∈ F) : IsAlgebraic F u := by
  classical
  let p : Polynomial K := minpoly K u
  let q : Polynomial F := ∑ n ∈ p.support,
    Polynomial.monomial n
      (⟨p.coeff n, by simpa [p] using hcoeff n⟩ : F)
  have hqmap : q.map (algebraMap F K) = p := by
    change Polynomial.map (algebraMap F K) (∑ n ∈ p.support,
      Polynomial.monomial n
        (⟨p.coeff n, by simpa [p] using hcoeff n⟩ : F)) = p
    rw [Polynomial.map_sum]
    simp only [Polynomial.map_monomial, IntermediateField.algebraMap_apply]
    change p.sum (fun n a => Polynomial.monomial n a) = p
    exact Polynomial.sum_monomial_eq p
  refine ⟨q, ?_, ?_⟩
  · intro hq0
    have : p = 0 := by rw [← hqmap, hq0, Polynomial.map_zero]
    exact (minpoly.ne_zero hu.isIntegral) this
  · have hmaptower : q.map (algebraMap F L) =
        p.map (algebraMap K L) := by
      rw [← hqmap, Polynomial.map_map]
      ext n
      simp only [Polynomial.coeff_map]
      exact IsScalarTower.algebraMap_apply F K L (q.coeff n)
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, hmaptower,
      Polynomial.eval_map, ← Polynomial.aeval_def]
    exact minpoly.aeval K u

/-- **Free-coordinate algebraic constant descent.**  An algebraic element killed by extensions of
every coordinate derivation outside `S` is algebraic over the rational subfield generated by `S`.
-/
theorem isAlgebraic_freeCoordinateField_of_coordinateDerivations_eq_zero
    {C σ L : Type*} [Field C] [CharZero C] [Field L]
    [Algebra C L]
    [Algebra (FreeCoordinateRationalField C σ) L]
    [IsScalarTower C (FreeCoordinateRationalField C σ) L]
    (S : Set σ)
    (DL : σ → Derivation C L L)
    (hmap : ∀ i x, DL i (algebraMap (FreeCoordinateRationalField C σ) L x) =
      algebraMap (FreeCoordinateRationalField C σ) L
        (freeCoordinateDerivation C σ i x))
    {u : L} (hu : IsAlgebraic (FreeCoordinateRationalField C σ) u)
    (hDu : ∀ i, i ∉ S → DL i u = 0) :
    IsAlgebraic (freeCoordinateField C σ S) u := by
  apply isAlgebraic_of_minpoly_coeff_mem_intermediateField
    (freeCoordinateField C σ S) hu
  intro n
  apply mem_freeCoordinateField_of_forall_freeCoordinateDerivation_eq_zero
  intro i hi
  exact minpoly_coeff_deriv_eq_zero
    (freeCoordinateDerivation C σ i) (DL i) (hmap i) hu (hDu i hi) n

/-- A fixed algebraic closure of the free rational coordinate field. -/
abbrev FreeCoordinateAlgebraicClosure (C σ : Type*) [Field C] :=
  AlgebraicClosure (FreeCoordinateRationalField C σ)

/-- The chosen extension of a free-coordinate derivation to the algebraic closure. -/
def freeCoordinateAlgebraicClosureDerivation
    {C σ : Type*} [Field C] [CharZero C] (i : σ) :
    Derivation C (FreeCoordinateAlgebraicClosure C σ)
      (FreeCoordinateAlgebraicClosure C σ) :=
  (exists_derivation_extension
    (K := C) (F := FreeCoordinateRationalField C σ)
    (L := FreeCoordinateAlgebraicClosure C σ)
    (freeCoordinateDerivation C σ i)).choose

@[simp]
theorem freeCoordinateAlgebraicClosureDerivation_algebraMap
    {C σ : Type*} [Field C] [CharZero C] (i : σ)
    (x : FreeCoordinateRationalField C σ) :
    freeCoordinateAlgebraicClosureDerivation i
        (algebraMap (FreeCoordinateRationalField C σ)
          (FreeCoordinateAlgebraicClosure C σ) x) =
      algebraMap (FreeCoordinateRationalField C σ)
        (FreeCoordinateAlgebraicClosure C σ)
        (freeCoordinateDerivation C σ i x) :=
  (exists_derivation_extension
    (K := C) (F := FreeCoordinateRationalField C σ)
    (L := FreeCoordinateAlgebraicClosure C σ)
    (freeCoordinateDerivation C σ i)).choose_spec x

/-- The chosen coordinate derivations commute throughout the algebraic closure. -/
theorem freeCoordinateAlgebraicClosureDerivation_commute
    {C σ : Type*} [Field C] [CharZero C] (i j : σ)
    (u : FreeCoordinateAlgebraicClosure C σ) :
    freeCoordinateAlgebraicClosureDerivation i
        (freeCoordinateAlgebraicClosureDerivation j u) =
      freeCoordinateAlgebraicClosureDerivation j
        (freeCoordinateAlgebraicClosureDerivation i u) := by
  exact derivation_commute_of_algebraic_extension
    (freeCoordinateDerivation C σ i) (freeCoordinateDerivation C σ j)
    (freeCoordinateAlgebraicClosureDerivation i)
    (freeCoordinateAlgebraicClosureDerivation j)
    (freeCoordinateAlgebraicClosureDerivation_algebraMap i)
    (freeCoordinateAlgebraicClosureDerivation_algebraMap j)
    (freeCoordinateDerivation_commute i j) u

/-- **Canonical algebraic-closure form.**  An element of the algebraic closure annihilated outside
`S` is algebraic over the free-coordinate subfield generated by `S`. -/
theorem isAlgebraic_freeCoordinateField_of_algebraicClosureDerivations_eq_zero
    {C σ : Type*} [Field C] [CharZero C] (S : Set σ)
    {u : FreeCoordinateAlgebraicClosure C σ}
    (hDu : ∀ i, i ∉ S → freeCoordinateAlgebraicClosureDerivation i u = 0) :
    IsAlgebraic (freeCoordinateField C σ S) u := by
  exact isAlgebraic_freeCoordinateField_of_coordinateDerivations_eq_zero S
    (fun i => freeCoordinateAlgebraicClosureDerivation i)
    (fun i => freeCoordinateAlgebraicClosureDerivation_algebraMap i)
    (Algebra.IsAlgebraic.isAlgebraic u) hDu

end

end GaloisForLFunctions.HTGeometry
