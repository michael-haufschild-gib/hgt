import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaInversion
import GaloisForLFunctions.HTGeometry.MultipleGammaTransverseDepthValue
import Mathlib.Analysis.Real.Pi.Irrational

/-!
# Multiple-Gamma period-action analytic shadows

This module isolates the analytic two-period family from the marked `Z^3` action presentation.
It proves, without hypotheses, the finite depth-one phase, boundary depth-zero phase, and normalized
even-rank reciprocal reflection law. Differential-field instances remain local to this module.
-/

open Set Topology Complex
open scoped BigOperators

namespace GaloisForLFunctions
namespace HTGeometry

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

/-- The two analytic periods underlying the finite marked presentation. The unit period is the
distinguished affine source coordinate. -/
def finiteMultipleGammaFunctionPeriods (m : ℕ+) : Fin 2 → ℂ :=
  ![Complex.I, 2 * Complex.I + (Real.pi / (m : ℝ) : ℝ)]

/-- The two analytic periods at the cofinal boundary. -/
def boundaryMultipleGammaFunctionPeriods : Fin 2 → ℂ :=
  ![Complex.I, 2 * Complex.I]

/-- Affine reflection center of the finite analytic family. -/
def finiteMultipleGammaAnalyticReflectionCenter (m : ℕ+) : ℂ :=
  finiteMultipleGammaFunctionPeriods m 0 + finiteMultipleGammaFunctionPeriods m 1

/-- Affine reflection center of the boundary analytic family. -/
def boundaryMultipleGammaAnalyticReflectionCenter : ℂ :=
  boundaryMultipleGammaFunctionPeriods 0 + boundaryMultipleGammaFunctionPeriods 1

/-- Every finite analytic period lies in the upper half-plane. -/
theorem finiteMultipleGammaFunctionPeriods_im_pos (m : ℕ+) :
    ∀ i, 0 < (finiteMultipleGammaFunctionPeriods m i).im := by
  intro i
  fin_cases i <;> norm_num [finiteMultipleGammaFunctionPeriods]

/-- Every boundary analytic period lies in the upper half-plane. -/
theorem boundaryMultipleGammaFunctionPeriods_im_pos :
    ∀ i, 0 < (boundaryMultipleGammaFunctionPeriods i).im := by
  intro i
  fin_cases i <;> norm_num [boundaryMultipleGammaFunctionPeriods]

/-- Irrationality of `pi` gives exact integral independence of the unit period and the two finite
analytic periods. -/
theorem finiteMultipleGammaFunctionPeriods_integrallyIndependent (m : ℕ+) :
    PeriodsIntegrallyIndependent (finiteMultipleGammaFunctionPeriods m) := by
  intro a n h
  have hre := congrArg Complex.re h
  have him := congrArg Complex.im h
  simp [finiteMultipleGammaFunctionPeriods, Fin.sum_univ_two] at hre him
  have hn1 : n 1 = 0 := by
    by_contra hn1
    have hm : ((m : ℕ) : ℝ) ≠ 0 := by positivity
    have hn1R : (n 1 : ℝ) ≠ 0 := by exact_mod_cast hn1
    have hscaled : (a : ℝ) * (m : ℕ) + (n 1 : ℝ) * Real.pi = 0 := by
      field_simp [hm] at hre
      linear_combination hre
    have hpi : Real.pi = ((-a * ((m : ℕ) : ℤ) : ℤ) : ℝ) / (n 1 : ℝ) := by
      rw [eq_div_iff hn1R]
      push_cast
      linear_combination hscaled
    exact (irrational_pi.ne_rational (-a * ((m : ℕ) : ℤ)) (n 1)) hpi
  have ha : a = 0 := by
    rw [hn1] at hre
    have haR : (a : ℝ) = 0 := by simpa using hre
    exact_mod_cast haR
  have hn0 : n 0 = 0 := by
    rw [hn1] at him
    have hn0R : (n 0 : ℝ) = 0 := by simpa using him
    exact_mod_cast hn0R
  refine ⟨ha, ?_⟩
  intro i
  fin_cases i <;> assumption

/-- The finite two-period multiple elliptic Gamma has transverse differential-algebraic depth
exactly one. -/
theorem finiteMultipleGammaTransverseDADepth (m : ℕ+) :
    multipleEllipticGammaTransverseDADepth
      (finiteMultipleGammaFunctionPeriods m) (finiteMultipleGammaFunctionPeriods_im_pos m) = 1 := by
  exact multipleEllipticGammaTransverseDADepth_eq_order
    (finiteMultipleGammaFunctionPeriods m) (finiteMultipleGammaFunctionPeriods_im_pos m)
    (finiteMultipleGammaFunctionPeriods_integrallyIndependent m) 1 (by omega) (by simp)

/-- Boundary periods lie on the rational ray generated by `i`, hence admit no rank-three minor. -/
theorem boundaryMultipleGammaFunctionPeriods_no_rankThreeMinor :
    ¬ MultipleEllipticGammaHasRankThreeMinor boundaryMultipleGammaFunctionPeriods := by
  apply (liesOnRationalAffineLine_iff_not_rankThreeMinor
    boundaryMultipleGammaFunctionPeriods boundaryMultipleGammaFunctionPeriods_im_pos).mp
  refine ⟨Complex.I, by norm_num, ![0, 0], ![1, 2], ?_, ?_⟩
  · intro i
    fin_cases i <;> norm_num
  · intro i
    fin_cases i <;> norm_num [boundaryMultipleGammaFunctionPeriods]

/-- The cofinal boundary multiple elliptic Gamma is differentially algebraic before any deletion,
so its transverse depth is exactly zero. -/
theorem boundaryMultipleGammaTransverseDADepth :
    multipleEllipticGammaTransverseDADepth
      boundaryMultipleGammaFunctionPeriods boundaryMultipleGammaFunctionPeriods_im_pos = 0 := by
  have hDA : DifferentialAlgebraicOver (RatFunc ℂ)
      (multipleEllipticGammaLogDerivMero boundaryMultipleGammaFunctionPeriods
        boundaryMultipleGammaFunctionPeriods_im_pos) :=
    (differentialAlgebraicOver_multipleEllipticGammaLogDerivMero_iff_not_rankThreeMinor
      boundaryMultipleGammaFunctionPeriods boundaryMultipleGammaFunctionPeriods_im_pos).mpr
        boundaryMultipleGammaFunctionPeriods_no_rankThreeMinor
  refine multipleEllipticGammaTransverseDADepth_eq_of_min
    boundaryMultipleGammaFunctionPeriods boundaryMultipleGammaFunctionPeriods_im_pos 0 ?_ ?_
  · refine ⟨∅, by simp, ?_⟩
    simpa only [multipleEllipticGammaLogDerivFaceMero_empty] using hDA
  · intro J hJ
    omega

/-- Even-rank Nishizawa parity gives reciprocal reflection for every two-period family. -/
theorem multipleGammaTwoPeriodProduct_reflection (τ : Fin 2 → ℂ) (z : ℂ) :
    multipleEllipticGammaProduct τ (τ 0 + τ 1 - z) =
      (multipleEllipticGammaProduct τ z)⁻¹ := by
  simpa [Fin.sum_univ_two] using multipleEllipticGammaProduct_reflection τ z

/-- Finite normalized-product reflection around its exact affine center. -/
theorem finiteMultipleGammaProduct_reflection (m : ℕ+) (z : ℂ) :
    multipleEllipticGammaProduct (finiteMultipleGammaFunctionPeriods m)
        (finiteMultipleGammaAnalyticReflectionCenter m - z) =
      (multipleEllipticGammaProduct (finiteMultipleGammaFunctionPeriods m) z)⁻¹ := by
  exact multipleGammaTwoPeriodProduct_reflection (finiteMultipleGammaFunctionPeriods m) z

/-- Boundary normalized-product reflection around its exact affine center. -/
theorem boundaryMultipleGammaProduct_reflection (z : ℂ) :
    multipleEllipticGammaProduct boundaryMultipleGammaFunctionPeriods
        (boundaryMultipleGammaAnalyticReflectionCenter - z) =
      (multipleEllipticGammaProduct boundaryMultipleGammaFunctionPeriods z)⁻¹ := by
  exact multipleGammaTwoPeriodProduct_reflection boundaryMultipleGammaFunctionPeriods z

end

end HTGeometry
end GaloisForLFunctions
