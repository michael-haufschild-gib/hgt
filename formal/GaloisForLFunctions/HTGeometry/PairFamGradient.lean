import GaloisForLFunctions.HTGeometry.PairFactorFamily

/-!
# The gradient recursion of an abstract two-coordinate law

The chain rule, the mixed commutation law and the gradient recursion use nothing about the factors
beyond the interface: the law and every coordinate derivation preserve the subfield generated by the
coordinates up to `m`, and the border row is a closed form.

The row the whole determinant grows from is the logarithmic gradient of a *head product* — the jet
of the level times an arbitrary nonzero element one level down.  The head is what the limit of the
border row creates, so the class must carry it.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

namespace PairFam

variable (F : PairFam)

/-! ## The chain rule -/

/-- **The chain rule on the subfield.** -/
theorem law_eq_sum_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m) :
    F.law f = ∑ l ∈ Finset.range (m + 1), F.jet l * fpderiv l f := by
  have hchain := freeCoordinate_chainRule (Finset.range (m + 1)) F.law h
  rw [hchain]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [fpderiv_eq_freeCoordinateDerivation]
  congr 1
  exact F.law_fx l

/-- **The subfield is stable under the law.** -/
theorem law_mem_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m) :
    F.law f ∈ coordField m := by
  rw [F.law_eq_sum_coordField h]
  refine sum_mem fun l hl => ?_
  have hlm : l < m + 1 := Finset.mem_range.mp hl
  exact mul_mem (F.jet_mem_coordField (by omega)) (fpderiv_mem_coordField l h)

theorem iterate_law_mem_coordField {m : ℕ} {f : CascadeField} (h : f ∈ coordField m) (r : ℕ) :
    ((F.law : CascadeField → CascadeField)^[r]) f ∈ coordField m := by
  induction r with
  | zero => simpa using h
  | succ r ih =>
      rw [Function.iterate_succ_apply']
      exact F.law_mem_coordField ih

/-! ## The mixed commutation law -/

/-- The first-order correction of the law. -/
noncomputable def jetMix (m k : ℕ) (G : CascadeField) : CascadeField :=
  ∑ l ∈ Finset.range (m + 1), F.response k l * fpderiv l G

theorem jetMix_add (m k : ℕ) (x y : CascadeField) :
    F.jetMix m k (x + y) = F.jetMix m k x + F.jetMix m k y := by
  rw [jetMix, jetMix, jetMix, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [map_add]
  ring

theorem jetMix_mul (m k : ℕ) (x y : CascadeField) :
    F.jetMix m k (x * y) = x * F.jetMix m k y + y * F.jetMix m k x := by
  rw [jetMix, jetMix, jetMix, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [Derivation.leibniz]
  simp only [smul_eq_mul]
  ring

/-- The corrected commutator of a coordinate derivation with the law. -/
noncomputable def mixCommutatorLin (m k : ℕ) : CascadeField →ₗ[ℂ] CascadeField where
  toFun G := fpderiv k (F.law G) - F.law (fpderiv k G) - F.jetMix m k G
  map_add' x y := by
    simp only [map_add, jetMix_add]
    ring
  map_smul' c x := by
    have hmix : F.jetMix m k (c • x) = c • F.jetMix m k x := by
      rw [jetMix, jetMix, Finset.smul_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [Derivation.map_smul, mul_smul_comm]
    simp only [Derivation.map_smul, hmix, RingHom.id_apply, smul_sub]

theorem mixCommutatorLin_apply (m k : ℕ) (G : CascadeField) :
    F.mixCommutatorLin m k G
      = fpderiv k (F.law G) - F.law (fpderiv k G) - F.jetMix m k G := rfl

/-- **The corrected commutator is a derivation.** -/
noncomputable def mixCommutator (m k : ℕ) : Derivation ℂ CascadeField CascadeField :=
  Derivation.mk' (F.mixCommutatorLin m k) (by
    intro x y
    simp only [mixCommutatorLin_apply, smul_eq_mul, Derivation.leibniz, map_add, jetMix_mul]
    ring)

theorem mixCommutator_apply (m k : ℕ) (G : CascadeField) :
    F.mixCommutator m k G
      = fpderiv k (F.law G) - F.law (fpderiv k G) - F.jetMix m k G := rfl

theorem mixCommutator_fx {m k j : ℕ} (hj : j ≤ m) : F.mixCommutator m k (fx j) = 0 := by
  classical
  have hD : F.law (fpderiv k (fx j)) = 0 := by
    by_cases hjk : j = k
    · rw [hjk, fpderiv_fx_self]
      simp
    · rw [fpderiv_fx_of_ne hjk]
      simp
  have hmix : F.jetMix m k (fx j) = F.response k j := by
    rw [jetMix, Finset.sum_eq_single j]
    · rw [fpderiv_fx_self, mul_one]
    · intro l _ hlj
      rw [fpderiv_fx_of_ne (fun h => hlj h.symm), mul_zero]
    · intro hnot
      exact absurd (Finset.mem_range.mpr (by omega : j < m + 1)) hnot
  rw [mixCommutator_apply, F.law_fx, hD, hmix, response]
  ring

theorem mixCommutator_eq_zero_coordField {m k : ℕ} {G : CascadeField} (h : G ∈ coordField m) :
    F.mixCommutator m k G = 0 := by
  have hgen : ∀ x ∈ freeCoordinate ℂ ℕ '' (↑(Finset.range (m + 1)) : Set ℕ),
      F.mixCommutator m k x = (0 : Derivation ℂ CascadeField CascadeField) x := by
    rintro _ ⟨j, hj, rfl⟩
    simp only [Finset.coe_range, Set.mem_Iio] at hj
    have hfx : freeCoordinate ℂ ℕ j = fx j := rfl
    rw [hfx]
    simpa using F.mixCommutator_fx (k := k) (by omega : j ≤ m)
  have hle := adjoin_le_derivationEqualizer hgen
  have hmem : G ∈ derivationEqualizer (F.mixCommutator m k)
      (0 : Derivation ℂ CascadeField CascadeField) := hle h
  rw [mem_derivationEqualizer_iff] at hmem
  simpa using hmem

/-- **The exact mixed commutation law.** -/
theorem fpderiv_law_mixed {m k : ℕ} {G : CascadeField} (h : G ∈ coordField m) :
    fpderiv k (F.law G) = F.law (fpderiv k G) + F.jetMix m k G := by
  have h0 := F.mixCommutator_eq_zero_coordField (k := k) h
  rw [mixCommutator_apply] at h0
  linear_combination h0

/-! ## The gradient recursion -/

/-- The operator the law induces on gradient vectors. -/
noncomputable def gradShift (m : ℕ) (u : ℕ → CascadeField) : ℕ → CascadeField :=
  fun k => F.law (u k) + ∑ l ∈ Finset.range (m + 1), F.response k l * u l

theorem gradient_law_eq {m : ℕ} {G : CascadeField} (h : G ∈ coordField m) :
    (fun l => fpderiv l (F.law G)) = F.gradShift m (fun l => fpderiv l G) := by
  funext k
  exact F.fpderiv_law_mixed h

theorem gradient_iterate_eq {m : ℕ} (r : ℕ) {G : CascadeField} (h : G ∈ coordField m) :
    (fun l => fpderiv l (((F.law : CascadeField → CascadeField)^[r]) G))
      = ((F.gradShift m)^[r]) (fun l => fpderiv l G) := by
  induction r generalizing G with
  | zero => simp
  | succ r ih =>
      rw [Function.iterate_succ_apply, ih (F.law_mem_coordField h),
        F.gradient_law_eq h, Function.iterate_succ_apply]

/-! ## The head product and its border row -/

/-- The border row at level `m` with a head `H`: the gradient of `∑_(j<m) log fac j + log H`. -/
noncomputable def headBorder (H : CascadeField) (m l : ℕ) : CascadeField :=
  F.logBorder m l + fpderiv l H / H

/-- The head product: the jet of the level times the head. -/
noncomputable def head (H : CascadeField) (m : ℕ) : CascadeField := F.jet m * H

theorem head_ne_zero {H : CascadeField} (hH : H ≠ 0) (m : ℕ) : F.head H m ≠ 0 :=
  mul_ne_zero (F.jet_ne_zero m) hH

theorem head_mem_coordField {H : CascadeField} {m : ℕ} (hH : H ∈ coordField m) :
    F.head H m ∈ coordField m :=
  mul_mem (F.jet_mem_coordField (le_refl m)) hH

/-- **The gradient of the head product is the border row, scaled.** -/
theorem fpderiv_head_eq {H : CascadeField} (hH : H ≠ 0) (m l : ℕ) :
    fpderiv l (F.head H m) = F.head H m * F.headBorder H m l := by
  rw [head, Derivation.leibniz, headBorder]
  simp only [smul_eq_mul]
  rw [show fpderiv l (F.jet m) = F.response l m from rfl, F.response_eq_logBorder l m]
  field_simp [hH]
  ring

theorem fpderiv_headBorder_symm (H : CascadeField) (m k l : ℕ) :
    fpderiv k (F.headBorder H m l) = fpderiv l (F.headBorder H m k) := by
  rw [headBorder, headBorder, map_add, map_add, F.fpderiv_logBorder_symm m k l,
    fpderiv_logDeriv_symm k l H]

theorem headBorder_mem_coordField {H : CascadeField} {m : ℕ} (hH : H ∈ coordField m) (l : ℕ) :
    F.headBorder H m l ∈ coordField m :=
  add_mem (F.logBorder_mem_coordField m l) (div_mem (fpderiv_mem_coordField l hH) hH)

theorem headBorder_of_ne {H : CascadeField} {m l : ℕ} (hH : H ∈ coordField m) (h : m < l) :
    F.headBorder H m l = 0 := by
  have hz : fpderiv l H = 0 := by
    rw [mem_coordField_iff] at hH
    exact hH l h
  rw [headBorder, hz, zero_div, add_zero, F.logBorder_eq_zero_of_gt h]

/-! ## The law's value on the head border row -/

/-- The law's value on the head border row. -/
noncomputable def headSum (H : CascadeField) (m : ℕ) : CascadeField :=
  ∑ l ∈ Finset.range (m + 1), F.headBorder H m l * F.jet l

theorem headSum_mem_coordField {H : CascadeField} {m : ℕ} (hH : H ∈ coordField m) :
    F.headSum H m ∈ coordField m := by
  refine sum_mem fun l hl => ?_
  have hlm : l < m + 1 := Finset.mem_range.mp hl
  exact mul_mem (F.headBorder_mem_coordField hH l) (F.jet_mem_coordField (by omega))

/-- **The head product's multiplier is the law's value on the border row.** -/
theorem law_head (m : ℕ) {H : CascadeField} (hH0 : H ≠ 0) (hH : H ∈ coordField m) :
    F.law (F.head H m) = F.headSum H m * F.head H m := by
  rw [F.law_eq_sum_coordField (F.head_mem_coordField hH), headSum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [F.fpderiv_head_eq hH0 m l]
  ring

/-- **The gradient of the law's value on the head border row is the shifted row.** -/
theorem gradient_headSum_eq (m : ℕ) {H : CascadeField} (hH : H ∈ coordField m) :
    (fun k => fpderiv k (F.headSum H m)) = F.gradShift m (F.headBorder H m) := by
  funext k
  simp only [gradShift]
  rw [headSum, map_sum]
  have hterm : ∀ l ∈ Finset.range (m + 1),
      fpderiv k (F.headBorder H m l * F.jet l)
        = F.jet l * fpderiv l (F.headBorder H m k)
          + F.response k l * F.headBorder H m l := by
    intro l _
    rw [Derivation.leibniz]
    simp only [smul_eq_mul]
    rw [F.fpderiv_headBorder_symm H m k l, response]
    ring
  rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib]
  congr 1
  exact (F.law_eq_sum_coordField (F.headBorder_mem_coordField hH k)).symm

/-- **The gradient of an iterate of the law is an iterate of the shifted operator on the head
border row.** -/
theorem gradient_iterate_headSum (m r : ℕ) {H : CascadeField} (hH : H ∈ coordField m) :
    (fun l => fpderiv l (((F.law : CascadeField → CascadeField)^[r]) (F.headSum H m)))
      = ((F.gradShift m)^[r + 1]) (F.headBorder H m) := by
  rw [F.gradient_iterate_eq r (F.headSum_mem_coordField hH), F.gradient_headSum_eq m hH,
    Function.iterate_succ_apply]

/-! ## The orbit matrix -/

/-- The orbit matrix of a starting vector under the shifted operator. -/
noncomputable def orbitMatrix (m k : ℕ) (u : ℕ → CascadeField) :
    Matrix (Fin k) (Fin k) CascadeField :=
  Matrix.of fun i j => ((F.gradShift m)^[(i : ℕ)]) u ((j : ℕ) + 1)

/-- The shifted operator at the newest coordinate. -/
noncomputable def topShift (m : ℕ) : CascadeField → CascadeField :=
  fun G => F.law G + F.response m m * G

/-- **At the newest coordinate the shifted operator is scalar.** -/
theorem gradShift_top (m : ℕ) (u : ℕ → CascadeField) :
    F.gradShift m u m = F.topShift m (u m) := by
  rw [gradShift, topShift, Finset.sum_range_succ]
  have hlow : ∀ l ∈ Finset.range m, F.response m l * u l = 0 := by
    intro l hl
    rw [F.response_of_lt (Finset.mem_range.mp hl), zero_mul]
  rw [Finset.sum_eq_zero hlow, zero_add]

theorem iterate_gradShift_top (m : ℕ) (u : ℕ → CascadeField) (i : ℕ) :
    ((F.gradShift m)^[i]) u m = ((F.topShift m)^[i]) (u m) := by
  induction i generalizing u with
  | zero => simp
  | succ i ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih, F.gradShift_top]

theorem topShift_add (m : ℕ) (x y : CascadeField) :
    F.topShift m (x + y) = F.topShift m x + F.topShift m y := by
  simp only [topShift, map_add]
  ring

theorem jetMix_top (m : ℕ) (Φ : CascadeField) :
    F.jetMix m m Φ = F.response m m * fpderiv m Φ := by
  rw [jetMix, Finset.sum_eq_single m]
  · intro l hl hlm
    have hlt : l < m := by
      have := Finset.mem_range.mp hl
      omega
    rw [F.response_of_lt hlt, zero_mul]
  · intro hnot
    exact absurd (Finset.mem_range.mpr (by omega : m < m + 1)) hnot

/-- **The scalar operator on a logarithmic derivative is a Wronskian over a square.** -/
theorem topShift_logDeriv {m : ℕ} {Φ : CascadeField} (hmem : Φ ∈ coordField m) (hΦ : Φ ≠ 0) :
    F.topShift m (fpderiv m Φ / Φ)
      = (fpderiv m (F.law Φ) * Φ - fpderiv m Φ * F.law Φ) / Φ ^ 2 := by
  have hmix := F.fpderiv_law_mixed (m := m) (k := m) hmem
  rw [F.jetMix_top] at hmix
  have hsub : F.law (fpderiv m Φ)
      = fpderiv m (F.law Φ) - F.response m m * fpderiv m Φ := by
    rw [hmix]
    ring
  rw [topShift, div_eq_mul_inv, Derivation.leibniz, Derivation.leibniz_inv, hsub]
  simp only [smul_eq_mul]
  field_simp
  ring

end PairFam

end GaloisForLFunctions.HTGeometry
