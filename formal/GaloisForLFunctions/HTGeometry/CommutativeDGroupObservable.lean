import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape
import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence

/-!
# Observables valued in a commutative algebraic `D`-group

A commutative algebraic `D`-group is presented here by its group of points together with a
coordinate map and its algebraic logarithmic derivative.  Two properties encode the `D`-structure:
the logarithmic coordinates are differential rational functions of the coordinates, and each
coordinate derivative is a rational function of the coordinates and of the jets of the logarithmic
coordinates.  The latter is the first-order system `ell(Y) = z` solved for `Y′`.

Consequently the coordinates of a finite family of points and their logarithmic coordinates
generate the same differential-algebraic closure, hence the same differential rank: logarithmic
linearization loses no differential rank.  In particular every point of the sharp kernel — the
kernel of the logarithmic derivative — has coordinates differentially algebraic over the base, so
the sharp kernel stores no hypertranscendental capacity.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

/-- Coordinate presentation of a commutative algebraic `D`-group over a differential base:
coordinates of the points, the algebraic logarithmic derivative into the Lie algebra, and the two
rationality laws of the `D`-structure. -/
structure DGroupPresentation (G : Type*) [CommGroup G] (K L : Type u) [Field K] [Field L]
    [Algebra K L] [Differential K] [Differential L] [DifferentialAlgebra K L]
    (n d : ℕ) where
  /-- Affine coordinates of a point. -/
  coords : G → Fin n → L
  /-- The algebraic logarithmic derivative, in a basis of the Lie algebra. -/
  ell : G → Fin d → L
  /-- The logarithmic derivative of a commutative `D`-group is a group homomorphism. -/
  ell_mul : ∀ g h : G, ell (g * h) = ell g + ell h
  /-- The logarithmic coordinates are differential rational in the coordinates. -/
  ell_mem_coordAdjoin : ∀ (g : G) (j : Fin d),
    ell g j ∈ differentialAdjoin K (Set.range (coords g))
  /-- The first-order system: each coordinate derivative is rational in the coordinates and the
  jets of the logarithmic coordinates. -/
  deriv_coords_mem : ∀ (g : G) (i : Fin n),
    (coords g i)′ ∈ IntermediateField.adjoin K
      (Set.range (coords g) ∪ differentialJetSet (Set.range (ell g)))

/-- Jet sets are monotone. -/
theorem differentialJetSet_mono {L : Type*} [Field L] [Differential L] {s t : Set L}
    (h : s ⊆ t) : differentialJetSet s ⊆ differentialJetSet t := by
  rintro x ⟨y, hy, m, rfl⟩
  exact ⟨y, h hy, m, rfl⟩

/-- An element of an intermediate field is differentially algebraic over it. -/
theorem differentialAlgebraicOver_of_mem_intermediateField {K L : Type u} [Field K] [Field L]
    [Algebra K L] [Differential L] (B : IntermediateField K L) {x : L} (hx : x ∈ B) :
    DifferentialAlgebraicOver B x := by
  intro hind
  have htrans : Transcendental B x :=
    hind.algebraicIndependent.transcendental Unit.unit
  exact htrans (by simpa using isAlgebraic_algebraMap (R := B) (A := L) (⟨x, hx⟩ : B))

namespace DGroupPresentation

variable {G : Type*} [CommGroup G] {K L : Type u} [Field K] [Field L] [Algebra K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L] {n d : ℕ}

/-- The full coordinate family of a family of points. -/
def coordFamily (P : DGroupPresentation G K L n d) {S : Type*} (g : S → G) :
    S × Fin n → L := fun p => P.coords (g p.1) p.2

/-- The full logarithmic-coordinate family of a family of points. -/
def ellFamily (P : DGroupPresentation G K L n d) {S : Type*} (g : S → G) :
    S × Fin d → L := fun p => P.ell (g p.1) p.2

theorem range_coords_subset (P : DGroupPresentation G K L n d) {S : Type*} (g : S → G) (a : S) :
    Set.range (P.coords (g a)) ⊆ Set.range (P.coordFamily g) := by
  rintro - ⟨i, rfl⟩
  exact ⟨(a, i), rfl⟩

theorem range_ell_subset (P : DGroupPresentation G K L n d) {S : Type*} (g : S → G) (a : S) :
    Set.range (P.ell (g a)) ⊆ Set.range (P.ellFamily g) := by
  rintro - ⟨j, rfl⟩
  exact ⟨(a, j), rfl⟩

/-! ### The logarithmic coordinates live in the coordinate field -/

theorem ell_mem_differentialAdjoin_coordFamily (P : DGroupPresentation G K L n d)
    {S : Type*} (g : S → G) (p : S × Fin d) :
    P.ellFamily g p ∈ differentialAdjoin K (Set.range (P.coordFamily g)) := by
  have h := P.ell_mem_coordAdjoin (g p.1) p.2
  refine IntermediateField.adjoin.mono K _ _ ?_ h
  exact differentialJetSet_mono (P.range_coords_subset g p.1)

/-! ### The coordinates are differentially algebraic over the logarithmic coordinates -/

/-- **Theorem A, the substantial half.**  Every coordinate of a point of the family is
differentially algebraic over the differential field generated by the logarithmic coordinates of
the family: the point solves the first-order system determined by its logarithmic derivative. -/
theorem differentialAlgebraicOver_coordFamily [CharZero L]
    (P : DGroupPresentation G K L n d) {S : Type*} [Fintype S] (g : S → G)
    (q : S × Fin n) :
    DifferentialAlgebraicOver (differentialAdjoin K (Set.range (P.ellFamily g)))
      (P.coordFamily g q) := by
  classical
  set E := differentialAdjoin K (Set.range (P.ellFamily g)) with hE
  letI : Differential E :=
    derivationClosedDifferential E (derivationClosed_differentialAdjoin K _)
  letI : DifferentialAlgebra E L :=
    ⟨fun c => derivationClosedDifferential_apply E
      (derivationClosed_differentialAdjoin K _) c⟩
  refine differentialAlgebraicOver_of_mem_finiteGeneratorState
    (F := E) (s := P.coordFamily g) ?_ ?_
  · intro p
    have h := P.deriv_coords_mem (g p.1) p.2
    have hle : IntermediateField.adjoin K
          (Set.range (P.coords (g p.1)) ∪
            differentialJetSet (Set.range (P.ell (g p.1))))
        ≤ (IntermediateField.adjoin E (Set.range (P.coordFamily g))).restrictScalars K := by
      rw [IntermediateField.adjoin_le_iff]
      rintro x (hx | hx)
      · exact IntermediateField.subset_adjoin E _ (P.range_coords_subset g p.1 hx)
      · have hxE : x ∈ E := by
          rw [hE, differentialAdjoin]
          exact IntermediateField.subset_adjoin K _
            (differentialJetSet_mono (P.range_ell_subset g p.1) hx)
        exact (IntermediateField.adjoin E (Set.range (P.coordFamily g))).algebraMap_mem
          (⟨x, hxE⟩ : E)
    exact hle h
  · exact IntermediateField.subset_adjoin E _ (Set.mem_range_self q)

/-! ### Theorem A: logarithmic linearization preserves all differential rank -/

/-- **Theorem A.**  The coordinates of a finite family of `D`-group points and their logarithmic
coordinates generate the same differential-algebraic closure. -/
theorem differentialClosure_coordFamily_eq_ellFamily [CharZero L]
    (P : DGroupPresentation G K L n d) {S : Type u} [Fintype S] (g : S → G) :
    differentialClosure K (Set.range (P.coordFamily g))
      = differentialClosure K (Set.range (P.ellFamily g)) := by
  have hcoord : Set.range (P.coordFamily g)
      ⊆ differentialClosure K (Set.range (P.ellFamily g)) := by
    rintro - ⟨q, rfl⟩
    exact P.differentialAlgebraicOver_coordFamily g q
  have hell : Set.range (P.ellFamily g)
      ⊆ differentialClosure K (Set.range (P.coordFamily g)) := by
    rintro - ⟨p, rfl⟩
    exact differentialAlgebraicOver_of_mem_intermediateField _
      (P.ell_mem_differentialAdjoin_coordFamily g p)
  refine subset_antisymm ?_ ?_
  · have := differentialClosure_mono (F := K) hcoord
    rwa [differentialClosure_idempotent] at this
  · have := differentialClosure_mono (F := K) hell
    rwa [differentialClosure_idempotent] at this

/-- **Rank form of Theorem A.**  The two families have the same differential rank. -/
theorem eRk_coordFamily_eq_ellFamily [CharZero L]
    (P : DGroupPresentation G K L n d) {S : Type u} [Fintype S] (g : S → G) :
    (differentialMatroid K L).eRk (Set.range (P.coordFamily g))
      = (differentialMatroid K L).eRk (Set.range (P.ellFamily g)) := by
  rw [← Matroid.eRk_closure_eq, ← Matroid.eRk_closure_eq
    (X := Set.range (P.ellFamily g)),
    differentialMatroid_closure_eq_differentialClosure,
    differentialMatroid_closure_eq_differentialClosure,
    P.differentialClosure_coordFamily_eq_ellFamily g]

/-! ### The sharp kernel carries no hypertranscendental rank -/

/-- **The sharp kernel is differentially algebraic.**  Every coordinate of a point killed by the
logarithmic derivative is differentially algebraic over the base field. -/
theorem differentialAlgebraicOver_coords_of_ell_eq_zero [CharZero L]
    (P : DGroupPresentation G K L n d) {x : G} (hx : P.ell x = 0) (i : Fin n) :
    DifferentialAlgebraicOver K (P.coords x i) := by
  classical
  refine differentialAlgebraicOver_of_mem_finiteGeneratorState
    (F := K) (s := P.coords x) ?_ (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
  intro j
  have h := P.deriv_coords_mem x j
  refine (IntermediateField.adjoin_le_iff (F := K) (S := Set.range (P.coords x) ∪
    differentialJetSet (Set.range (P.ell x)))).2 ?_ h
  rintro y (hy | hy)
  · exact IntermediateField.subset_adjoin K _ hy
  · obtain ⟨z, hz, m, rfl⟩ := hy
    obtain ⟨j', rfl⟩ := hz
    rw [hx]
    have hzero : differentialJet m (0 : L) = 0 := by
      induction m with
      | zero => rw [differentialJet_zero]
      | succ k ih =>
          rw [differentialJet_succ, ih, Differential.deriv.map_zero]
    show differentialJet m ((0 : Fin d → L) j') ∈ _
    rw [Pi.zero_apply, hzero]
    exact (IntermediateField.adjoin K (Set.range (P.coords x))).zero_mem

end DGroupPresentation

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {G : Type*} [CommGroup G] {K L : Type u} [Field K] [Field L] [Algebra K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L] {n d : ℕ}

/-- The logarithmic coordinates of a single point are the logarithmic family of the one-point
family. -/
theorem DGroupPresentation.range_ellFamily_unit (P : DGroupPresentation G K L n d) (x : G) :
    Set.range (P.ellFamily fun _ : Unit => x) = Set.range (P.ell x) := by
  ext y
  constructor
  · rintro ⟨p, rfl⟩
    exact ⟨p.2, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨((), j), rfl⟩

/-- **Every fibre of the logarithmic derivative has differential transcendence degree zero over
its image point.**  Each coordinate of a point is differentially algebraic over the differential
field generated by the logarithmic coordinates of that point alone, so the fibre through it — a
torsor under the sharp kernel — stores no differential rank. -/
theorem DGroupPresentation.differentialAlgebraicOver_coords_singleton [CharZero L]
    (P : DGroupPresentation G K L n d) (x : G) (i : Fin n) :
    DifferentialAlgebraicOver (differentialAdjoin K (Set.range (P.ell x))) (P.coords x i) := by
  have h := P.differentialAlgebraicOver_coordFamily (S := Unit) (fun _ => x) ((), i)
  rwa [P.range_ellFamily_unit x] at h

end

end GaloisForLFunctions.HTGeometry
