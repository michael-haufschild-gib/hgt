import GaloisForLFunctions.HTGeometry.FiniteJetConstraintSourceBoundary

/-!
# Scalar logarithmic-current reconstruction

For a nonzero hypertranscendental scalar `q`, its logarithmic current `q′ / q` is itself
hypertranscendental.  Moreover the full differential field generated by `q` is the ordinary field
generated by the differential current field and the single amplitude `q`.  Positive powers of the
amplitude generate the same current field, which is the algebraic reconstruction step needed for
finite scalar holonomy.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A nonzero hypertranscendental scalar has a hypertranscendental logarithmic current. -/
theorem logDeriv_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {q : E} (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0) :
    HypertranscendentalOver F (Differential.logDeriv q) := by
  let J : E := Differential.logDeriv q
  let L : IntermediateField F E := differentialAdjoin F ({J} : Set E)
  let jL : L := ⟨J, subset_differentialAdjoin F ({J} : Set E) rfl⟩
  let Q : MvPolynomial (Fin 2) L :=
    MvPolynomial.X 1 - MvPolynomial.C jL * MvPolynomial.X 0
  have hQ : Q ≠ 0 := by
    intro hzero
    have hcoeff := congrArg (MvPolynomial.coeff (Finsupp.single 1 1)) hzero
    have honezero : (1 : L) = 0 := by
      calc
        1 = MvPolynomial.coeff (Finsupp.single 1 1) Q := by simp [Q]
        _ = MvPolynomial.coeff (Finsupp.single 1 1) 0 := hcoeff
        _ = 0 := by simp
    exact one_ne_zero honezero
  have hann : MvPolynomial.aeval
      (fun j : Fin 2 => differentialJet (j : ℕ) q) Q = 0 := by
    simp only [Q, map_sub, MvPolynomial.aeval_X, map_mul, MvPolynomial.aeval_C]
    change q′ - J * q = 0
    simp only [J, Differential.logDeriv]
    field_simp [hq0]
    ring
  exact hypertranscendentalOver_input_of_finiteJetConstraint hq hQ hann

/-- In particular, the logarithmic current of a nonzero hypertranscendental scalar is not a base
constant. -/
theorem logDeriv_ne_algebraMap
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {q : E} (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0) (c : F) :
    Differential.logDeriv q ≠ algebraMap F E c := by
  intro heq
  have hc : DifferentialAlgebraicOver F (algebraMap F E c) := by
    unfold DifferentialAlgebraicOver
    intro hind
    have htrans : Transcendental F (algebraMap F E c) :=
      hind.algebraicIndependent.transcendental Unit.unit
    exact htrans (isAlgebraic_algebraMap c)
  exact logDeriv_hypertranscendentalOver hq hq0 (heq ▸ hc)

/-- The ordinary field generated by the differential current field and the amplitude. -/
def logCurrentOrdinaryExtension
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential E] (q : E) : IntermediateField F E :=
  IntermediateField.adjoin F
    (((differentialAdjoin F ({Differential.logDeriv q} : Set E) :
      IntermediateField F E) : Set E) ∪ {q})

/-- Exact scalar reconstruction: adjoining the full jet of `q` adds only the differential current
field and one ordinary amplitude coordinate. -/
theorem differentialAdjoin_eq_logCurrentOrdinaryExtension
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {q : E} (hq0 : q ≠ 0) :
    differentialAdjoin F ({q} : Set E) =
      logCurrentOrdinaryExtension F q := by
  let J : E := Differential.logDeriv q
  let L : IntermediateField F E := differentialAdjoin F ({J} : Set E)
  let T : IntermediateField F E := differentialAdjoin F ({q} : Set E)
  let A : IntermediateField F E := logCurrentOrdinaryExtension F q
  have hqT : q ∈ T := subset_differentialAdjoin F ({q} : Set E) rfl
  have hJT : J ∈ T := by
    have hq'T : q′ ∈ T :=
      derivationClosed_differentialAdjoin F ({q} : Set E) hqT
    exact T.div_mem hq'T hqT
  have hLleT : L ≤ T :=
    differentialAdjoin_le F (by simpa using hJT)
      (derivationClosed_differentialAdjoin F ({q} : Set E))
  have hAleT : A ≤ T := by
    apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    rcases hx with hx | hx
    · exact hLleT hx
    · subst x
      exact hqT
  have hqA : q ∈ A :=
    IntermediateField.subset_adjoin F _ (Set.mem_union_right _ (Set.mem_singleton q))
  have hJA : J ∈ A := by
    apply IntermediateField.subset_adjoin F _
    exact Set.mem_union_left _ (subset_differentialAdjoin F ({J} : Set E) rfl)
  have hqderiv : q′ = J * q := by
    simp only [J, Differential.logDeriv]
    field_simp [hq0]
  have hAclosed : DerivationClosed A := by
    intro x hx
    apply IntermediateField.adjoin_induction F
      (s := ((L : Set E) ∪ {q})) (p := fun y _ => y′ ∈ A)
    · intro y hy
      rcases hy with hyL | hyq
      · have hy' : y′ ∈ L := derivationClosed_differentialAdjoin F ({J} : Set E) hyL
        exact IntermediateField.subset_adjoin F _ (Set.mem_union_left _ hy')
      · have hyq' : y = q := Set.mem_singleton_iff.mp hyq
        subst y
        rw [hqderiv]
        exact A.mul_mem hJA hqA
    · intro c
      rw [deriv_algebraMap]
      exact IntermediateField.algebraMap_mem A _
    · intro a b ha hb hda hdb
      rw [map_add]
      exact A.add_mem hda hdb
    · intro a ha hda
      rw [Derivation.leibniz_inv]
      have hsq : a⁻¹ ^ (2 : ℕ) ∈ A := by
        simpa [pow_two] using A.mul_mem (A.inv_mem ha) (A.inv_mem ha)
      exact A.mul_mem (A.neg_mem hsq) hda
    · intro a b ha hb hda hdb
      rw [Derivation.leibniz]
      exact A.add_mem (A.mul_mem ha hdb) (A.mul_mem hb hda)
    · exact hx
  have hTleA : T ≤ A :=
    differentialAdjoin_le F (by simpa using hqA) hAclosed
  exact le_antisymm hTleA hAleT

/-- Algebraic logarithmic differentiation of a natural power. -/
theorem differential_logDeriv_pow
    {E : Type*} [Field E] [Differential E]
    (q : E) (hq0 : q ≠ 0) (N : ℕ) :
    Differential.logDeriv (q ^ N) =
      (N : E) * Differential.logDeriv q := by
  unfold Differential.logDeriv
  rw [Derivation.leibniz_pow]
  simp only [nsmul_eq_mul, smul_eq_mul]
  by_cases hN : N = 0
  · simp [hN]
  · have hpow : q ^ N ≠ 0 := pow_ne_zero N hq0
    have hsplit : q ^ N = q ^ (N - 1) * q := by
      calc
        q ^ N = q ^ ((N - 1) + 1) := by
          rw [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hN)]
        _ = q ^ (N - 1) * q := by rw [pow_succ]
    rw [hsplit]
    field_simp [hq0, hpow]

/-- A power whose exponent remains nonzero in the coefficient field has exactly the same
differential logarithmic-current field as the original amplitude. -/
theorem differentialAdjoin_logDeriv_pow_eq_of_cast_ne_zero
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {q : E} (hq0 : q ≠ 0) {N : ℕ} (hcast : (N : E) ≠ 0) :
    differentialAdjoin F ({Differential.logDeriv (q ^ N)} : Set E) =
      differentialAdjoin F ({Differential.logDeriv q} : Set E) := by
  have hNatL : (N : E) ∈ differentialAdjoin F
      ({Differential.logDeriv q} : Set E) := by
    rw [← map_natCast (algebraMap F E) N]
    exact (differentialAdjoin F
      ({Differential.logDeriv q} : Set E)).algebraMap_mem (N : F)
  have hJN_L : Differential.logDeriv (q ^ N) ∈ differentialAdjoin F
      ({Differential.logDeriv q} : Set E) := by
    rw [differential_logDeriv_pow q hq0 N]
    exact (differentialAdjoin F ({Differential.logDeriv q} : Set E)).mul_mem hNatL
      (subset_differentialAdjoin F ({Differential.logDeriv q} : Set E) rfl)
  have hNatLN : (N : E) ∈ differentialAdjoin F
      ({Differential.logDeriv (q ^ N)} : Set E) := by
    rw [← map_natCast (algebraMap F E) N]
    exact (differentialAdjoin F
      ({Differential.logDeriv (q ^ N)} : Set E)).algebraMap_mem (N : F)
  have hJ_LN : Differential.logDeriv q ∈ differentialAdjoin F
      ({Differential.logDeriv (q ^ N)} : Set E) := by
    have hJN_LN : Differential.logDeriv (q ^ N) ∈ differentialAdjoin F
        ({Differential.logDeriv (q ^ N)} : Set E) :=
      subset_differentialAdjoin F ({Differential.logDeriv (q ^ N)} : Set E) rfl
    have hscaled : (N : E) * Differential.logDeriv q ∈ differentialAdjoin F
        ({Differential.logDeriv (q ^ N)} : Set E) := by
      rw [← differential_logDeriv_pow q hq0 N]
      exact hJN_LN
    have hscalar : (N : E)⁻¹ ∈ differentialAdjoin F
        ({Differential.logDeriv (q ^ N)} : Set E) :=
      (differentialAdjoin F
        ({Differential.logDeriv (q ^ N)} : Set E)).inv_mem hNatLN
    have hmul := (differentialAdjoin F
      ({Differential.logDeriv (q ^ N)} : Set E)).mul_mem hscalar hscaled
    simpa [hcast] using hmul
  apply le_antisymm
  · exact differentialAdjoin_le F (by simpa using hJN_L)
      (derivationClosed_differentialAdjoin F ({Differential.logDeriv q} : Set E))
  · exact differentialAdjoin_le F (by simpa using hJ_LN)
      (derivationClosed_differentialAdjoin F
        ({Differential.logDeriv (q ^ N)} : Set E))

/-- In characteristic zero, every positive power has the same differential logarithmic-current
field as the original amplitude. -/
theorem differentialAdjoin_logDeriv_pow_eq
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    [CharZero E]
    {q : E} (hq0 : q ≠ 0) {N : ℕ} (hN : 0 < N) :
    differentialAdjoin F ({Differential.logDeriv (q ^ N)} : Set E) =
      differentialAdjoin F ({Differential.logDeriv q} : Set E) :=
  differentialAdjoin_logDeriv_pow_eq_of_cast_ne_zero hq0
    (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hN))

/-- Finite-cover reconstruction: the differential field generated by `q ^ N` is the ordinary
field obtained by adding `q ^ N` to the original logarithmic-current field. -/
theorem differentialAdjoin_pow_eq_logCurrentOrdinaryExtension
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    [CharZero E]
    {q : E} (hq0 : q ≠ 0) {N : ℕ} (hN : 0 < N) :
    differentialAdjoin F ({q ^ N} : Set E) =
      IntermediateField.adjoin F
        (((differentialAdjoin F ({Differential.logDeriv q} : Set E) :
          IntermediateField F E) : Set E) ∪ {q ^ N}) := by
  rw [differentialAdjoin_eq_logCurrentOrdinaryExtension (pow_ne_zero N hq0)]
  unfold logCurrentOrdinaryExtension
  rw [differentialAdjoin_logDeriv_pow_eq hq0 hN]

end

end GaloisForLFunctions.HTGeometry
