import GaloisForLFunctions.HTGeometry.DGroupSourceRankLaw

/-!
# The source-boundary law over an intermediate differential field

The master source-boundary law does not depend on the coefficient field being the original base:
it holds verbatim over any intermediate field which is closed under the derivation and stable
under every source automorphism.  The source automorphisms restrict to such a field, and all the
structural hypotheses of the law descend from the ambient field.

This is the base change a non-diagonalizable adjoint local system forces.  A triangular datum has
increments in the differential field generated by its invariant block rather than in the original
base; over that enlarged field the increments are again coefficients, and the flat criterion
applies with the enlarged constants.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

/-- An intermediate field of a scalar tower is again in the tower. -/
instance intermediateField.instIsScalarTower {C K L : Type*} [CommSemiring C] [Field K] [Field L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L] (B : IntermediateField K L) :
    IsScalarTower C ↥B L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

variable {C K L : Type u} [Field C] [Field K] [Field L]
  [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]
  {I : Type u} (sigma : I → L ≃+* L)

/-- The restriction of a source automorphism to a stable intermediate field. -/
def restrictSource (B : IntermediateField K L) (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B) (i : I) :
    ↥B ≃+* ↥B where
  toFun x := ⟨sigma i x, (hmem i x).2 x.2⟩
  invFun x := ⟨(sigma i).symm x,
    (hmem i ((sigma i).symm x)).1 (by rw [RingEquiv.apply_symm_apply]; exact x.2)⟩
  left_inv x := Subtype.ext ((sigma i).symm_apply_apply x)
  right_inv x := Subtype.ext ((sigma i).apply_symm_apply x)
  map_mul' x y := Subtype.ext (map_mul (sigma i) _ _)
  map_add' x y := Subtype.ext (map_add (sigma i) _ _)

omit [Differential K] [Differential L] [DifferentialAlgebra K L] in
@[simp]
theorem coe_restrictSource (B : IntermediateField K L) (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B)
    (i : I) (x : ↥B) : ((restrictSource sigma B hmem i x : ↥B) : L) = sigma i (x : L) := rfl

omit [Differential K] [Differential L] [DifferentialAlgebra K L] in
/-- The restricted source automorphism is compatible with the structure map. -/
theorem restrictSource_algebraMap (B : IntermediateField K L)
    (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B) (i : I) (x : ↥B) :
    sigma i (algebraMap ↥B L x) = algebraMap ↥B L (restrictSource sigma B hmem i x) := rfl

omit [Differential K] [Differential L] [DifferentialAlgebra K L] in
/-- The restricted source automorphism fixes the constants. -/
theorem restrictSource_fixesConstants (B : IntermediateField K L)
    (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c) (i : I) (c : C) :
    restrictSource sigma B hmem i (algebraMap C ↥B c) = algebraMap C ↥B c := by
  refine Subtype.ext ?_
  rw [coe_restrictSource]
  have h : ((algebraMap C ↥B c : ↥B) : L) = algebraMap C L c :=
    (IsScalarTower.algebraMap_apply C ↥B L c).symm
  rw [h, hCfixed]

omit [Differential K] [DifferentialAlgebra K L] in
/-- The restricted source automorphism commutes with the derivation. -/
theorem restrictSource_deriv (B : IntermediateField K L)
    (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B) [Differential ↥B] [DifferentialAlgebra ↥B L]
    (hderivL : ∀ i y, sigma i y′ = (sigma i y)′) (i : I) (x : ↥B) :
    restrictSource sigma B hmem i x′ = (restrictSource sigma B hmem i x)′ := by
  refine Subtype.ext ?_
  have hcoe : ∀ w : ↥B, ((w′ : ↥B) : L) = ((w : L))′ := fun w =>
    (DifferentialAlgebra.deriv_algebraMap (A := ↥B) (B := L) w).symm
  rw [coe_restrictSource, hcoe, hcoe, coe_restrictSource, hderivL]

omit [Differential K] [DifferentialAlgebra K L] in
/-- **The source-boundary law over an intermediate differential field.**  Over any derivation-closed
source-stable intermediate field, a family of observables shifting by increments of that field is
differentially independent exactly when the boundary classes of those increments are linearly
independent over the constant-coefficient differential operators. -/
theorem differentialIndependent_iff_linearIndependent_boundaryClass_baseChange
    (B : IntermediateField K L) (hmem : ∀ i x, sigma i x ∈ B ↔ x ∈ B)
    [Differential ↥B] [DifferentialAlgebra ↥B L] [CharZero ↥B]
    (hderivL : ∀ i y, sigma i y′ = (sigma i y)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ y : L, (∀ i, sigma i y = y) → ∃ c : C, algebraMap C L c = y)
    (hCB : ∀ c : C, (algebraMap C ↥B c)′ = 0)
    {κ : Type u} (z : κ → L) (omega : I → κ → ↥B)
    (hshift : ∀ i p, sigma i (z p) = z p + algebraMap ↥B L (omega i p)) :
    DifferentialIndependent ↥B z ↔
      LinearIndependent (Polynomial C)
        (fun p : κ => boundaryClass (restrictSource sigma B hmem) hCB
          (restrictSource_fixesConstants sigma B hmem hCfixed)
          (restrictSource_deriv sigma B hmem hderivL) fun i => omega i p) :=
  differentialIndependent_iff_linearIndependent_boundaryClass (restrictSource sigma B hmem) sigma
    (restrictSource_algebraMap sigma B hmem) hderivL hCfixed hfixed hCB
    (restrictSource_fixesConstants sigma B hmem hCfixed)
    (restrictSource_deriv sigma B hmem hderivL) z omega hshift

omit [Differential K] [DifferentialAlgebra K L] in
/-- The constants of the enlarged base are the constants of the original one, when the original
constants are already differential constants of the ambient field. -/
theorem algebraMap_C_deriv_eq_zero_of_base (B : IntermediateField K L)
    [Differential ↥B] [DifferentialAlgebra ↥B L]
    (hC : ∀ c : C, (algebraMap C L c)′ = 0) (c : C) :
    (algebraMap C ↥B c)′ = 0 := by
  apply (algebraMap (↥B) L).injective
  rw [← DifferentialAlgebra.deriv_algebraMap, ← IsScalarTower.algebraMap_apply, hC, map_zero]

end

end GaloisForLFunctions.HTGeometry
