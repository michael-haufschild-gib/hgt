import GaloisForLFunctions.HTGeometry.SquareRootObstruction
import GaloisForLFunctions.HTGeometry.CompleteTheSquare
import GaloisForLFunctions.HTGeometry.CyclicSqrtMem

/-!
# The even case of the Kummer obstruction

In an extension of even degree a square root of a base element need not be excluded by counting, so
it is excluded by its square class instead: if every quadratic subextension is the one generated by
a fixed square root, then a square root lying in the extension has its radicand in the same square
class as that fixed one.

Since the radicands here are the discriminant and the constant coefficient, and the constant
coefficient does not divide the discriminant, the classes differ and no such square root exists.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped IntermediateField

variable {F L : Type*} [Field F] [CharZero F] [Field L] [Algebra F L]

/-- **The even-degree obstruction.**  If every element of `M` whose square lies in the base and
which is not itself in the base already lies in the fixed square-root extension, and the two
radicands are in different square classes, then no such element exists in `M`. -/
theorem no_sqrt_of_square_class_ne {M : IntermediateField F L} {α : L} {c : F}
    (hsq : α * α = algebraMap F L c) (hα : α ∉ (⊥ : IntermediateField F L))
    (hquad : ∀ δ : L, δ ∈ M → (∃ e : F, δ * δ = algebraMap F L e) →
      δ ∉ (⊥ : IntermediateField F L) → δ ∈ F⟮α⟯)
    (hclass : ∀ e : F, (¬ ∃ t : F, e * c = t * t) ∨ ∀ δ : L,
      δ * δ = algebraMap F L e → δ ∈ (⊥ : IntermediateField F L)) :
    ∀ (δ : L) (e : F), δ * δ = algebraMap F L e →
      δ ∉ (⊥ : IntermediateField F L) → δ ∉ M := by
  intro δ e hδsq hδbot hδM
  have hmem : δ ∈ F⟮α⟯ := hquad δ hδM ⟨e, hδsq⟩ hδbot
  rcases hclass e with hns | hall
  · exact hns (sq_mul_eq_sq_of_mem_adjoin_sqrt hsq hα hmem hδsq hδbot)
  · exact hδbot (hall δ hδsq)

/-- **The even case, assembled.**  Inside a cyclic extension containing a square root of `c`, a
square root of `e` outside the base cannot occur once `e * c` is not a square: it would have to lie
in the one quadratic subextension, forcing the two radicands into the same square class. -/
theorem notMem_of_isCyclic_of_square_class {M : IntermediateField F L}
    [FiniteDimensional F M] [IsGalois F M] (hcyc : IsCyclic (M ≃ₐ[F] M))
    {α : L} {c : F} (hsq : α * α = algebraMap F L c) (hαM : α ∈ M)
    (hα : α ∉ (⊥ : IntermediateField F L))
    {δ : L} {e : F} (hδsq : δ * δ = algebraMap F L e)
    (hδbot : δ ∉ (⊥ : IntermediateField F L))
    (hclass : ¬ ∃ t : F, e * c = t * t) : δ ∉ M := by
  intro hδM
  refine hclass ?_
  have hmem : δ ∈ F⟮α⟯ :=
    mem_adjoin_of_sq_mem_of_isCyclic hcyc hsq hαM hα hδM hδsq hδbot
  exact sq_mul_eq_sq_of_mem_adjoin_sqrt hsq hα hmem hδsq hδbot

end GaloisForLFunctions.HTGeometry
