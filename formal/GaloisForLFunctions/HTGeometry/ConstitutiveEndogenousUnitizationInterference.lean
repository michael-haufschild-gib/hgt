import GaloisForLFunctions.HTGeometry.ConstitutiveIdentificationConflictInterference

namespace HTGeometry

noncomputable section

/-!
# Endogenous unitization and exchange self-erasure

Source operations generate unitization relations.  Joint unitization collapses every endpoint in
their formation-word orbit and therefore erases the operations' own exchange witness.  Two
idempotent retractions on `Fin 3` give a sharp source-generated critical triple: each unitization is
individually compatible with the canonical schedule reporter, while their join loses that reporter
strictly.
-/

/-- Execute a formation word from left to right. -/
def executeFormationWord {I X : Type*} (a : I → X → X) : List I → X → X
  | [], x => x
  | i :: w, x => executeFormationWord a w (a i x)

/-- Primitive identification generated by unitizing one operation from a family. -/
def operationUnitizationRelation {I X : Type*} (a : I → X → X) (x y : X) : Prop :=
  ∃ i, y = a i x

/-- Every formation-word endpoint belongs to the generated unitization class of its source. -/
theorem executeFormationWord_eqvGen
    {I X : Type*} (a : I → X → X) (w : List I) (x : X) :
    Relation.EqvGen (operationUnitizationRelation a) x
      (executeFormationWord a w x) := by
  induction w generalizing x with
  | nil => exact Relation.EqvGen.refl x
  | cons i w ih =>
      exact Relation.EqvGen.trans x (a i x) (executeFormationWord a w (a i x))
        (Relation.EqvGen.rel x (a i x) ⟨i, rfl⟩) (ih (a i x))

/-- Any two formation-word endpoints from one source become equivalent after joint unitization. -/
theorem executeFormationWord_endpoints_eqvGen
    {I X : Type*} (a : I → X → X) (v w : List I) (x : X) :
    Relation.EqvGen (operationUnitizationRelation a)
      (executeFormationWord a v x) (executeFormationWord a w x) := by
  exact Relation.EqvGen.trans _ x _
    (Relation.EqvGen.symm _ _ (executeFormationWord_eqvGen a v x))
    (executeFormationWord_eqvGen a w x)

/-- An observer unitizing every generator is constant on every generated formation word. -/
theorem executeFormationWord_observer_unitized
    {I X Y : Type*} (a : I → X → X) (q : X → Y)
    (hunit : ∀ i x, q (a i x) = q x) (w : List I) (x : X) :
    q (executeFormationWord a w x) = q x := by
  induction w generalizing x with
  | nil => rfl
  | cons i w ih =>
      exact (ih (a i x)).trans (hunit i x)

/-- Identification generated by requiring one operation to be observer-invisible. -/
def unaryOperationUnitization {X : Type*} (f : X → X) (x y : X) : Prop :=
  y = f x

/-- Joint unitization relation of two operations. -/
def joinedOperationUnitization {X : Type*} (f g : X → X) (x y : X) : Prop :=
  unaryOperationUnitization f x y ∨ unaryOperationUnitization g x y

/-- Joint unitization collapses the exchange pair generated by two competing schedules. -/
theorem joinedOperationUnitization_exchangePair
    {X : Type*} (f g : X → X) (x : X) :
    Relation.EqvGen (joinedOperationUnitization f g) (f (g x)) (g (f x)) := by
  have h₁ : Relation.EqvGen (joinedOperationUnitization f g) (f (g x)) (g x) :=
    Relation.EqvGen.symm _ _
      (Relation.EqvGen.rel (g x) (f (g x)) (Or.inl rfl))
  have h₂ : Relation.EqvGen (joinedOperationUnitization f g) (g x) x :=
    Relation.EqvGen.symm _ _
      (Relation.EqvGen.rel x (g x) (Or.inr rfl))
  have h₃ : Relation.EqvGen (joinedOperationUnitization f g) x (f x) :=
    Relation.EqvGen.rel x (f x) (Or.inl rfl)
  have h₄ : Relation.EqvGen (joinedOperationUnitization f g) (f x) (g (f x)) :=
    Relation.EqvGen.rel (f x) (g (f x)) (Or.inr rfl)
  exact Relation.EqvGen.trans _ (g x) _ h₁
    (Relation.EqvGen.trans _ x _ h₂
      (Relation.EqvGen.trans _ (f x) _ h₃ h₄))

/-- Every jointly unitizing observer erases the source exchange witness. -/
theorem jointlyUnitizingObserver_erases_exchange
    {X Y : Type*} (f g : X → X) (q : X → Y)
    (hf : ∀ x, q (f x) = q x) (hg : ∀ x, q (g x) = q x) (x : X) :
    q (f (g x)) = q (g (f x)) := by
  calc
    q (f (g x)) = q (g x) := hf (g x)
    _ = q x := hg x
    _ = q (f x) := (hf x).symm
    _ = q (g (f x)) := (hg (f x)).symm

/-- Canonical Dirac task generated by one schedule endpoint. -/
def endogenousDiracProfile {X : Type*} [DecidableEq X]
    (a : X) (_ : Unit) (x : X) : ℝ :=
  if x = a then 1 else 0

/-- Distinct schedule endpoints generate a canonical total-variation conflict. -/
theorem endogenousDiracProfiles_conflict
    {X : Type*} [DecidableEq X] {a b : X} (hab : a ≠ b) :
    finiteTaskConflict (endogenousDiracProfile a) (endogenousDiracProfile b) a b := by
  refine ⟨(), ?_⟩
  simp [endogenousDiracProfile, hab, Ne.symm hab]

/-- Distinct canonical Dirac profiles have exactly one unit of total variation. -/
theorem endogenousDiracProfiles_totalVariation
    {X : Type*} [Fintype X] [DecidableEq X] {a b : X} (hab : a ≠ b) :
    finiteProfileTotalVariation (endogenousDiracProfile a ())
      (endogenousDiracProfile b ()) = 1 := by
  rw [finiteProfileTotalVariation_eq]
  have hmeet : ∀ x : X,
      finiteProfileMeet (endogenousDiracProfile a ())
        (endogenousDiracProfile b ()) x = 0 := by
    intro x
    by_cases hxa : x = a
    · subst x
      simp [finiteProfileMeet, endogenousDiracProfile, hab]
    · by_cases hxb : x = b
      · subst x
        simp [finiteProfileMeet, endogenousDiracProfile, Ne.symm hab]
      · simp [finiteProfileMeet, endogenousDiracProfile, hxa, hxb]
  simp [endogenousDiracProfile, hmeet]

/-- Pushforward fibre mass of a canonical Dirac profile. -/
theorem finiteSignedFiberMass_endogenousDiracProfile
    {X K : Type*} [Fintype X] [DecidableEq X] [DecidableEq K]
    (q : X → K) (a : X) (k : K) :
    finiteSignedFiberMass (endogenousDiracProfile a ()) q k =
      if q a = k then 1 else 0 := by
  classical
  rw [finiteSignedFiberMass]
  by_cases hqa : q a = k
  · rw [if_pos hqa]
    calc
      (∑ p : X, if q p = k then endogenousDiracProfile a () p else 0) =
          (if q a = k then endogenousDiracProfile a () a else 0) := by
            apply Finset.sum_eq_single a
            · intro b hb hba
              simp [endogenousDiracProfile, hba]
            · simp [endogenousDiracProfile]
      _ = 1 := by simp [endogenousDiracProfile, hqa]
  · rw [if_neg hqa]
    calc
      (∑ p : X, if q p = k then endogenousDiracProfile a () p else 0) =
          (if q a = k then endogenousDiracProfile a () a else 0) := by
            apply Finset.sum_eq_single a
            · intro b hb hba
              simp [endogenousDiracProfile, hba]
            · simp [endogenousDiracProfile]
      _ = 0 := by simp [hqa]

/-- Identified Dirac endpoints have zero total variation after observer pushforward. -/
theorem endogenousDiracPushforward_totalVariation_zero
    {X K : Type*} [Fintype X] [Fintype K]
    [DecidableEq X] [DecidableEq K]
    (q : X → K) {a b : X} (hab : q a = q b) :
    finiteProfileTotalVariation
        (fun k => finiteSignedFiberMass (endogenousDiracProfile a ()) q k)
        (fun k => finiteSignedFiberMass (endogenousDiracProfile b ()) q k) = 0 := by
  have hprofiles :
      (fun k => finiteSignedFiberMass (endogenousDiracProfile a ()) q k) =
        fun k => finiteSignedFiberMass (endogenousDiracProfile b ()) q k := by
    funext k
    rw [finiteSignedFiberMass_endogenousDiracProfile q a k,
      finiteSignedFiberMass_endogenousDiracProfile q b k, hab]
  rw [hprofiles]
  simp [finiteProfileTotalVariation]

/-- Exact reporter balance: a noncommuting source schedule has TV one, while every observer
unitizing both operations sees TV zero. -/
theorem endogenousExchangeReporter_exact_loss
    {X K : Type*} [Fintype X] [Fintype K]
    [DecidableEq X] [DecidableEq K]
    (f g : X → X) (q : X → K) (x : X)
    (hf : finiteObserverRespects (unaryOperationUnitization f) q)
    (hg : finiteObserverRespects (unaryOperationUnitization g) q)
    (hne : f (g x) ≠ g (f x)) :
    finiteProfileTotalVariation
        (endogenousDiracProfile (f (g x)) ())
        (endogenousDiracProfile (g (f x)) ()) = 1 ∧
      finiteProfileTotalVariation
        (fun k => finiteSignedFiberMass (endogenousDiracProfile (f (g x)) ()) q k)
        (fun k => finiteSignedFiberMass (endogenousDiracProfile (g (f x)) ()) q k) = 0 := by
  have hfUnit : ∀ z, q (f z) = q z := fun z => (hf z (f z) rfl).symm
  have hgUnit : ∀ z, q (g z) = q z := fun z => (hg z (g z) rfl).symm
  exact ⟨endogenousDiracProfiles_totalVariation hne,
    endogenousDiracPushforward_totalVariation_zero q
      (jointlyUnitizingObserver_erases_exchange f g q hfUnit hgUnit x)⟩

/-- The canonical exchange reporter is lost strictly by every finite joint unitizing observer. -/
theorem endogenousExchangeReporter_strict_loss
    {X K : Type*} [Fintype X] [Fintype K]
    [DecidableEq X] [DecidableEq K]
    (f g : X → X) (q : X → K) (x : X)
    (hf : finiteObserverRespects (unaryOperationUnitization f) q)
    (hg : finiteObserverRespects (unaryOperationUnitization g) q)
    (hne : f (g x) ≠ g (f x)) :
    finiteProfileTotalVariation
        (fun k => finiteSignedFiberMass (endogenousDiracProfile (f (g x)) ()) q k)
        (fun k => finiteSignedFiberMass (endogenousDiracProfile (g (f x)) ()) q k) <
      finiteProfileTotalVariation
        (endogenousDiracProfile (f (g x)) ())
        (endogenousDiracProfile (g (f x)) ()) := by
  obtain ⟨j, hneg⟩ := endogenousDiracProfiles_conflict hne
  exact joinedIdentificationConflict_forces_strict_loss
    (unaryOperationUnitization f) (unaryOperationUnitization g)
    (endogenousDiracProfile (f (g x))) (endogenousDiracProfile (g (f x)))
    q hf hg (joinedOperationUnitization_exchangePair f g x) hneg

/-! ## Sharp source-generated three-state critical triple -/

/-- Left idempotent retraction: the middle state is sent to `0`. -/
def threePointLeftRetraction (x : Fin 3) : Fin 3 :=
  if x = 1 then 0 else x

/-- Right idempotent retraction: the middle state is sent to `2`. -/
def threePointRightRetraction (x : Fin 3) : Fin 3 :=
  if x = 1 then 2 else x

theorem threePointLeftRetraction_idempotent :
    ∀ x, threePointLeftRetraction (threePointLeftRetraction x) =
      threePointLeftRetraction x := by
  intro x
  fin_cases x <;> rfl

theorem threePointRightRetraction_idempotent :
    ∀ x, threePointRightRetraction (threePointRightRetraction x) =
      threePointRightRetraction x := by
  intro x
  fin_cases x <;> rfl

theorem threePoint_schedule_left :
    threePointLeftRetraction (threePointRightRetraction 1) = 2 := rfl

theorem threePoint_schedule_right :
    threePointRightRetraction (threePointLeftRetraction 1) = 0 := rfl

theorem threePoint_schedule_endpoints_ne :
    threePointLeftRetraction (threePointRightRetraction 1) ≠
      threePointRightRetraction (threePointLeftRetraction 1) := by
  rw [threePoint_schedule_left, threePoint_schedule_right]
  intro h
  exact Nat.noConfusion (congrArg Fin.val h)

/-- The left unitization quotient preserves the canonical schedule task. -/
theorem threePointLeftObserver_respects_unitization :
    finiteObserverRespects (unaryOperationUnitization threePointLeftRetraction)
      threePointLeftObserver := by
  intro x y hxy
  subst y
  fin_cases x <;> rfl

/-- The right unitization quotient preserves the canonical schedule task. -/
theorem threePointRightObserver_respects_unitization :
    finiteObserverRespects (unaryOperationUnitization threePointRightRetraction)
      threePointRightObserver := by
  intro x y hxy
  subst y
  fin_cases x <;> rfl

theorem threePoint_exchangeFirstProfile_eq :
    endogenousDiracProfile
        (threePointRightRetraction (threePointLeftRetraction 1)) =
      threePointLeftProfile := rfl

theorem threePoint_exchangeSecondProfile_eq :
    endogenousDiracProfile
        (threePointLeftRetraction (threePointRightRetraction 1)) =
      threePointRightProfile := rfl

/-- Each source-generated unitization is individually compatible with the schedule reporter. -/
theorem threePoint_sourceGenerated_pairwise_realizable :
    (finiteObserverRespects (unaryOperationUnitization threePointLeftRetraction)
        threePointLeftObserver ∧
      finiteTaskLossless
        (endogenousDiracProfile
          (threePointRightRetraction (threePointLeftRetraction 1)))
        (endogenousDiracProfile
          (threePointLeftRetraction (threePointRightRetraction 1)))
        threePointLeftObserver) ∧
    (finiteObserverRespects (unaryOperationUnitization threePointRightRetraction)
        threePointRightObserver ∧
      finiteTaskLossless
        (endogenousDiracProfile
          (threePointRightRetraction (threePointLeftRetraction 1)))
        (endogenousDiracProfile
          (threePointLeftRetraction (threePointRightRetraction 1)))
        threePointRightObserver) := by
  rw [threePoint_exchangeFirstProfile_eq, threePoint_exchangeSecondProfile_eq]
  exact ⟨⟨threePointLeftObserver_respects_unitization,
      threePointLeftObserver_lossless⟩,
    ⟨threePointRightObserver_respects_unitization,
      threePointRightObserver_lossless⟩⟩

/-- No finite observer can jointly unitize both source operations and retain their own schedule
reporter losslessly. -/
theorem threePoint_sourceGenerated_no_joint_observer
    {K : Type*} [Fintype K] [DecidableEq K] :
    ¬ ∃ q : Fin 3 → K,
        finiteObserverRespects (unaryOperationUnitization threePointLeftRetraction) q ∧
        finiteObserverRespects (unaryOperationUnitization threePointRightRetraction) q ∧
        finiteTaskLossless
          (endogenousDiracProfile
            (threePointRightRetraction (threePointLeftRetraction 1)))
          (endogenousDiracProfile
            (threePointLeftRetraction (threePointRightRetraction 1))) q := by
  rintro ⟨q, hf, hg, hlossless⟩
  have hstrict := endogenousExchangeReporter_strict_loss
    threePointRightRetraction threePointLeftRetraction q 1 hg hf
      (Ne.symm threePoint_schedule_endpoints_ne)
  exact (ne_of_lt hstrict) (hlossless ())

/-! ## Sharpness of the three-state calibration -/

/-- On two states, a relation whose generated equality avoids the only nontrivial pair contains
only diagonal edges. -/
theorem finTwo_relation_diagonal_of_compatible
    (R : Fin 2 → Fin 2 → Prop)
    (hcompatible : ¬ Relation.EqvGen R 0 1) :
    ∀ x y, R x y → x = y := by
  intro x y hxy
  fin_cases x <;> fin_cases y
  · rfl
  · exact False.elim (hcompatible (Relation.EqvGen.rel 0 1 hxy))
  · exact False.elim (hcompatible
      (Relation.EqvGen.symm 1 0 (Relation.EqvGen.rel 1 0 hxy)))
  · rfl

/-- Two individually compatible identification doctrines on `Fin 2` cannot become jointly
incompatible.  Hence the source-generated critical triple on `Fin 3` is state-minimal. -/
theorem finTwo_pairwiseCompatible_joinCompatible
    (R S : Fin 2 → Fin 2 → Prop)
    (hR : ¬ Relation.EqvGen R 0 1)
    (hS : ¬ Relation.EqvGen S 0 1) :
    ¬ Relation.EqvGen (finiteRelationUnion R S) 0 1 := by
  have hdiag : ∀ x y, finiteRelationUnion R S x y → x = y := by
    intro x y hxy
    exact hxy.elim
      (finTwo_relation_diagonal_of_compatible R hR x y)
      (finTwo_relation_diagonal_of_compatible S hS x y)
  intro hjoin
  have heqOf : ∀ {x y : Fin 2},
      Relation.EqvGen (finiteRelationUnion R S) x y → x = y := by
    intro x y hxy
    induction hxy with
    | rel x y hxy => exact hdiag x y hxy
    | refl x => rfl
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ hxy hyz => exact hxy.trans hyz
  have heq : (0 : Fin 2) = 1 := heqOf hjoin
  exact Nat.noConfusion (congrArg Fin.val heq)

/-- Capstone: two idempotent source operations generate pairwise-realizable unitizations and a
canonical exchange reporter that their joint execution necessarily erases. -/
theorem endogenousUnitizationInterference_threePoint_closed :
    (∀ x, threePointLeftRetraction (threePointLeftRetraction x) =
      threePointLeftRetraction x) ∧
    (∀ x, threePointRightRetraction (threePointRightRetraction x) =
      threePointRightRetraction x) ∧
    threePointLeftRetraction (threePointRightRetraction 1) ≠
      threePointRightRetraction (threePointLeftRetraction 1) ∧
    ((finiteObserverRespects (unaryOperationUnitization threePointLeftRetraction)
          threePointLeftObserver ∧
        finiteTaskLossless
          (endogenousDiracProfile
            (threePointRightRetraction (threePointLeftRetraction 1)))
          (endogenousDiracProfile
            (threePointLeftRetraction (threePointRightRetraction 1)))
          threePointLeftObserver) ∧
      (finiteObserverRespects (unaryOperationUnitization threePointRightRetraction)
          threePointRightObserver ∧
        finiteTaskLossless
          (endogenousDiracProfile
            (threePointRightRetraction (threePointLeftRetraction 1)))
          (endogenousDiracProfile
            (threePointLeftRetraction (threePointRightRetraction 1)))
          threePointRightObserver)) ∧
    (∀ {K : Type*} [Fintype K] [DecidableEq K],
      ¬ ∃ q : Fin 3 → K,
          finiteObserverRespects (unaryOperationUnitization threePointLeftRetraction) q ∧
          finiteObserverRespects (unaryOperationUnitization threePointRightRetraction) q ∧
          finiteTaskLossless
            (endogenousDiracProfile
              (threePointRightRetraction (threePointLeftRetraction 1)))
            (endogenousDiracProfile
              (threePointLeftRetraction (threePointRightRetraction 1))) q) := by
  refine ⟨threePointLeftRetraction_idempotent,
    threePointRightRetraction_idempotent,
    threePoint_schedule_endpoints_ne,
    threePoint_sourceGenerated_pairwise_realizable, ?_⟩
  intro K instFintype instDecidableEq
  exact threePoint_sourceGenerated_no_joint_observer

end

end HTGeometry
