import GaloisForLFunctions.HTGeometry.RationalPrefixDifferentialAdjoin
import GaloisForLFunctions.HTGeometry.DeckDegreeUpperBound

/-!
# Fixed-field descent along a rational prefix

The differential field generated by the image of a point under a noncritical rational map is finite
below the ambient field, of degree at most the degree of the map.  Artin's theorem supplies the
opposite inequality for any finite group of automorphisms fixing it, so as soon as such a group has
order at least the degree of the map the prefix image is exactly its fixed field.

No Galois descent for the map itself is used: the only geometric input is the degree bound, and the
group supplies the rest.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open IntermediateField Polynomial

noncomputable section

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E]

/-- **The prefix image of a rational map is the fixed field of its deck group.**  If the
differential field of the image point lies in the fixed field of a finite automorphism group whose
order is at least the degree of the map, the two coincide. -/
theorem differentialAdjoin_ratMapEval_eq_fixedField (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0)
    (htop : differentialAdjoin C ({g} : Set E) = ⊤)
    (Γ : Subgroup (E ≃ₐ[C] E)) [Fintype Γ]
    (hfix : differentialAdjoin C ({ratMapEval P Q g} : Set E) ≤ IntermediateField.fixedField Γ)
    (hcard : max P.natDegree Q.natDegree ≤ Nat.card Γ) :
    differentialAdjoin C ({ratMapEval P Q g} : Set E) = IntermediateField.fixedField Γ := by
  haveI : FiniteDimensional (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) E :=
    finiteDimensional_differentialAdjoin_ratMapEval hC hQ hW htop
  exact eq_fixedField_of_finrank_le Γ _ hfix
    (le_trans (finrank_differentialAdjoin_ratMapEval_le hC hQ hW htop) hcard)

/-- **The exact deck degree of a rational prefix.**  Under the same hypotheses the degree of the
ambient field over the prefix image is exactly the order of the deck group. -/
theorem finrank_differentialAdjoin_ratMapEval_eq_card (hC : ∀ c : C, (algebraMap C E c)′ = 0)
    {P Q : Polynomial C} {g : E} (hQ : Polynomial.aeval g Q ≠ 0)
    (hW : ratMapWronskian P Q g ≠ 0)
    (htop : differentialAdjoin C ({g} : Set E) = ⊤)
    (Γ : Subgroup (E ≃ₐ[C] E)) [Fintype Γ]
    (hfix : differentialAdjoin C ({ratMapEval P Q g} : Set E) ≤ IntermediateField.fixedField Γ)
    (hcard : max P.natDegree Q.natDegree ≤ Nat.card Γ) :
    Module.finrank (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) E = Nat.card Γ := by
  haveI : FiniteDimensional (↥(differentialAdjoin C ({ratMapEval P Q g} : Set E))) E :=
    finiteDimensional_differentialAdjoin_ratMapEval hC hQ hW htop
  exact finrank_eq_card_of_le_fixedField_of_finrank_le Γ _ hfix
    (le_trans (finrank_differentialAdjoin_ratMapEval_le hC hQ hW htop) hcard)

end

end GaloisForLFunctions.HTGeometry
