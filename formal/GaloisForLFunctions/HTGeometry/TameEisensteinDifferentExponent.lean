import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.RingTheory.Polynomial.Basic

/-!
# The tame ramification exponent is exactly `e - 1`

For a totally ramified extension of discrete valuation rings presented by an Eisenstein
polynomial of degree `e`, the different is generated by the derivative of that polynomial
evaluated at a uniformizer.  This module computes that valuation exactly in the tame case: it is
`e - 1`, no more and no less.

The mechanism is an ultrametric strict minimum.  The leading term `e * x ^ (e - 1)` has valuation
`e - 1` because `e` is a unit in the tame case, while every lower term carries a coefficient of
valuation at least `e`.  The sum therefore has the valuation of its strictly smallest term.

This is the exact arithmetic source of the shift by one in the ramification order law
`c + 1 = e * (c' + 1)`: the `e - 1` is the Jacobian contribution of ramification, not a
normalisation convention.  mathlib supplies only the divisibility `P ^ (e - 1) ∣ different`; the
matching upper bound proved here is what makes the exponent exact.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsDiscreteValuationRing

variable {B : Type*} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]

/-- A uniform lower bound on the valuation of the summands bounds the valuation of the sum. -/
theorem le_addVal_sum {ι : Type*} (s : Finset ι) (f : ι → B) (b : ℕ∞)
    (h : ∀ i ∈ s, b ≤ addVal B (f i)) :
    b ≤ addVal B (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction with
  | empty =>
    rw [Finset.sum_empty, AddValuation.map_zero]
    exact le_top
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    refine le_trans (le_min (h a (Finset.mem_insert_self a s))
      (ih fun i hi => h i (Finset.mem_insert_of_mem hi))) ?_
    exact AddValuation.map_add _ _ _

/-- The valuation of a power of a uniformizer is its exponent. -/
theorem addVal_pow_uniformizer {x : B} (hx : Irreducible x) (n : ℕ) :
    addVal B (x ^ n) = (n : ℕ∞) := by
  have hxval : addVal B x = 1 := addVal_uniformizer hx
  induction n with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, AddValuation.map_mul, ih, hxval]
    push_cast
    ring

/-- Monic polynomial of degree `e` with prescribed lower coefficients. -/
noncomputable def eisensteinPoly (e : ℕ) (c : ℕ → B) : B[X] :=
  X ^ e + ∑ i ∈ Finset.range e, C (c i) * X ^ i

omit [IsDomain B] [IsDiscreteValuationRing B] in
theorem derivative_eisensteinPoly (e : ℕ) (c : ℕ → B) :
    derivative (eisensteinPoly e c) =
      C (e : B) * X ^ (e - 1) +
        ∑ i ∈ Finset.range e, C (c i) * (C (i : B) * X ^ (i - 1)) := by
  rw [eisensteinPoly, map_add, derivative_X_pow, map_sum]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [derivative_C_mul, derivative_X_pow]

omit [IsDomain B] [IsDiscreteValuationRing B] in
theorem eval_derivative_eisensteinPoly (e : ℕ) (c : ℕ → B) (x : B) :
    eval x (derivative (eisensteinPoly e c)) =
      (e : B) * x ^ (e - 1) + ∑ i ∈ Finset.range e, c i * ((i : B) * x ^ (i - 1)) := by
  rw [derivative_eisensteinPoly, eval_add, eval_finsetSum]
  simp

/-- **Exact tame different exponent.**  For an Eisenstein-type polynomial of degree `e` whose
lower coefficients all have valuation at least `e`, and with `e` a unit at the place, the
derivative evaluated at a uniformizer has valuation exactly `e - 1`. -/
theorem addVal_eval_derivative_eisensteinPoly
    (e : ℕ) (he : 0 < e) (c : ℕ → B) (x : B) (hx : Irreducible x)
    (hcoef : ∀ i ∈ Finset.range e, (e : ℕ∞) ≤ addVal B (c i))
    (htame : addVal B (e : B) = 0) :
    addVal B (eval x (derivative (eisensteinPoly e c))) = ((e - 1 : ℕ) : ℕ∞) := by
  have hhead : addVal B ((e : B) * x ^ (e - 1)) = ((e - 1 : ℕ) : ℕ∞) := by
    rw [AddValuation.map_mul, htame, addVal_pow_uniformizer hx, zero_add]
  have htail : ((e : ℕ) : ℕ∞) ≤
      addVal B (∑ i ∈ Finset.range e, c i * ((i : B) * x ^ (i - 1))) := by
    refine le_addVal_sum _ _ _ fun i hi => ?_
    rw [AddValuation.map_mul]
    exact le_add_right (hcoef i hi)
  have hlt : ((e - 1 : ℕ) : ℕ∞) < ((e : ℕ) : ℕ∞) := by
    exact_mod_cast Nat.sub_lt he Nat.one_pos
  have hne : addVal B ((e : B) * x ^ (e - 1)) ≠
      addVal B (∑ i ∈ Finset.range e, c i * ((i : B) * x ^ (i - 1))) := by
    rw [hhead]
    exact ne_of_lt (lt_of_lt_of_le hlt htail)
  rw [eval_derivative_eisensteinPoly, AddValuation.map_add_of_distinct_val _ hne, hhead]
  exact min_eq_left (le_of_lt (lt_of_lt_of_le hlt htail))

/-- The tame ramification exponent shifted by one is the ramification index itself: this is the
`+ 1` of the ramification order law, produced by the Jacobian. -/
theorem addVal_eval_derivative_eisensteinPoly_succ
    (e : ℕ) (he : 0 < e) (c : ℕ → B) (x : B) (hx : Irreducible x)
    (hcoef : ∀ i ∈ Finset.range e, (e : ℕ∞) ≤ addVal B (c i))
    (htame : addVal B (e : B) = 0) :
    addVal B (eval x (derivative (eisensteinPoly e c))) + 1 = ((e : ℕ) : ℕ∞) := by
  rw [addVal_eval_derivative_eisensteinPoly e he c x hx hcoef htame]
  have : ((e - 1 : ℕ) : ℕ∞) + 1 = (((e - 1) + 1 : ℕ) : ℕ∞) := by push_cast; ring
  rw [this, Nat.sub_add_cancel he]

/-- **The local different is exactly the `(e-1)`-st power of the maximal ideal.**  In the tame
Eisenstein situation the ideal generated by the derivative at a uniformizer is the `(e-1)`-st
power of the uniformizer ideal, so the ramification divisor has coefficient exactly `e - 1`. -/
theorem span_eval_derivative_eisensteinPoly
    (e : ℕ) (he : 0 < e) (c : ℕ → B) (x : B) (hx : Irreducible x)
    (hcoef : ∀ i ∈ Finset.range e, (e : ℕ∞) ≤ addVal B (c i))
    (htame : addVal B (e : B) = 0) :
    Ideal.span {eval x (derivative (eisensteinPoly e c))} =
      Ideal.span {x ^ (e - 1)} := by
  have hpow : addVal B (x ^ (e - 1)) = ((e - 1 : ℕ) : ℕ∞) :=
    addVal_pow_uniformizer hx (e - 1)
  have hval := addVal_eval_derivative_eisensteinPoly e he c x hx hcoef htame
  have hdvd₁ : eval x (derivative (eisensteinPoly e c)) ∣ x ^ (e - 1) :=
    addVal_le_iff_dvd.mp (by rw [hval, hpow])
  have hdvd₂ : x ^ (e - 1) ∣ eval x (derivative (eisensteinPoly e c)) :=
    addVal_le_iff_dvd.mp (by rw [hval, hpow])
  exact Ideal.span_singleton_eq_span_singleton.mpr
    (associated_of_dvd_dvd hdvd₁ hdvd₂)

end GaloisForLFunctions.HTGeometry
