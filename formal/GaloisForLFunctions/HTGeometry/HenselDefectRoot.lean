import GaloisForLFunctions.HTGeometry.NewtonSlopeTransform
import Mathlib.Algebra.Polynomial.Taylor

/-!
# Newton's lemma without a simple root

Hensel's lemma lifts a root whose derivative is a unit.  When the derivative is not a unit the root
still lifts, provided the value is small compared with the *square* of the derivative — the exact
algebraic form of `|F(y₀)| < |F′(y₀)|²`.

The proof removes the degeneracy rather than iterating.  Substituting `y = y₀ + d·Z` with
`d = F′(y₀)` makes every term of the Taylor expansion beyond the linear one carry `d²`, so writing
`F(y₀) = d²·ε` the whole substituted polynomial is `d²` times

`H(Z) = ε + Z + (higher terms)`,

whose reduction modulo the ideal is `Z` — a simple root at the origin.  The ordinary Hensel
statement then applies to `H`, and the root of `F` is `y₀ + d·z` with `z` in the ideal.

`H` is never monic, which is why the *divisor* form of Hensel's lemma — which does not assume the
polynomial monic — is the right tool.

Specialised to `K⟦t⟧` with the ideal generated by the variable, this is Newton's lemma with defect
`r`: if `F′(y₀) = t^r · unit` and `F(y₀)` vanishes to order at least `2r + 1`, then `F` has a root
congruent to `y₀` modulo `t^{r+1}`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial PowerSeries

/-! ## Dividing the coefficients of a polynomial by a power of the variable -/

variable {R : Type*} [CommRing R]

@[simp]
theorem shiftPow_zero' (k : ℕ) : shiftPow k (0 : PowerSeries R) = 0 := by
  ext n
  rw [coeff_shiftPow, map_zero, map_zero]

theorem shiftPow_X_pow_mul (k : ℕ) (ψ : PowerSeries R) :
    shiftPow k ((PowerSeries.X : PowerSeries R) ^ k * ψ) = ψ := by
  ext n
  rw [coeff_shiftPow, PowerSeries.coeff_X_pow_mul]

/-- Divide every coefficient of a polynomial over a power-series ring by `X ^ k`. -/
noncomputable def polyShiftPow (k : ℕ) (G : (PowerSeries R)[X]) : (PowerSeries R)[X] :=
  ∑ i ∈ Finset.range (G.natDegree + 1), Polynomial.C (shiftPow k (G.coeff i)) * Polynomial.X ^ i

@[simp]
theorem coeff_polyShiftPow (k : ℕ) (G : (PowerSeries R)[X]) (i : ℕ) :
    (polyShiftPow k G).coeff i = shiftPow k (G.coeff i) := by
  classical
  rw [polyShiftPow, Polynomial.finsetSum_coeff]
  by_cases hi : i ≤ G.natDegree
  · rw [Finset.sum_eq_single i]
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    · intro b _ hb
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (Ne.symm hb), mul_zero]
    · intro hcon
      exact absurd (Finset.mem_range.2 (by omega)) hcon
  · have hzero : G.coeff i = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hzero, shiftPow_zero']
    refine Finset.sum_eq_zero fun b hb => ?_
    have hbd : b < G.natDegree + 1 := Finset.mem_range.1 hb
    have hne : i ≠ b := by omega
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hne, mul_zero]

theorem C_X_pow_mul_polyShiftPow {k : ℕ} {G : (PowerSeries R)[X]}
    (hdvd : ∀ i, (PowerSeries.X : PowerSeries R) ^ k ∣ G.coeff i) :
    Polynomial.C ((PowerSeries.X : PowerSeries R) ^ k) * polyShiftPow k G = G := by
  ext i
  rw [Polynomial.coeff_C_mul, coeff_polyShiftPow, X_pow_mul_shiftPow (hdvd i)]

/-! ## Substituting `y₀ + h · Z` -/

variable {S : Type*} [CommRing S]

/-- The polynomial `Z ↦ F (y₀ + h · Z)`. -/
noncomputable def shiftScale (F : S[X]) (y₀ h : S) : S[X] :=
  ∑ k ∈ Finset.range ((Polynomial.taylor y₀ F).natDegree + 1),
    Polynomial.C ((Polynomial.taylor y₀ F).coeff k * h ^ k) * Polynomial.X ^ k

theorem coeff_shiftScale (F : S[X]) (y₀ h : S) (k : ℕ) :
    (shiftScale F y₀ h).coeff k = (Polynomial.taylor y₀ F).coeff k * h ^ k := by
  classical
  rw [shiftScale, Polynomial.finsetSum_coeff]
  by_cases hk : k ≤ (Polynomial.taylor y₀ F).natDegree
  · rw [Finset.sum_eq_single k]
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    · intro b _ hb
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (Ne.symm hb), mul_zero]
    · intro hcon
      exact absurd (Finset.mem_range.2 (by omega)) hcon
  · have hzero : (Polynomial.taylor y₀ F).coeff k = 0 :=
      Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hzero, zero_mul]
    refine Finset.sum_eq_zero fun b hb => ?_
    have hbd : b < (Polynomial.taylor y₀ F).natDegree + 1 := Finset.mem_range.1 hb
    have hne : k ≠ b := by omega
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hne, mul_zero]

theorem eval_shiftScale (F : S[X]) (y₀ h z : S) :
    (shiftScale F y₀ h).eval z = F.eval (y₀ + h * z) := by
  have hT : (Polynomial.taylor y₀ F).eval (h * z) = F.eval (h * z + y₀) := by
    rw [Polynomial.taylor_apply, Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_C]
  have hsum : ∀ k ∈ Finset.range ((Polynomial.taylor y₀ F).natDegree + 1),
      (Polynomial.C ((Polynomial.taylor y₀ F).coeff k * h ^ k) * Polynomial.X ^ k).eval z
        = (Polynomial.taylor y₀ F).coeff k * (h * z) ^ k := by
    intro k _
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, mul_pow]
    ring
  rw [shiftScale, Polynomial.eval_finsetSum, Finset.sum_congr rfl hsum,
    ← Polynomial.eval_eq_sum_range, hT, add_comm]

/-! ## The derivative at a linear divisor -/

/-- The quotient by `X - a`, evaluated at `a`, is the derivative at `a`. -/
theorem eval_divByMonic_X_sub_C (p : S[X]) (a : S) :
    (p /ₘ ((X : S[X]) - Polynomial.C a)).eval a = (Polynomial.derivative p).eval a := by
  have hdecomp : p = ((X : S[X]) - Polynomial.C a) * (p /ₘ ((X : S[X]) - Polynomial.C a))
      + Polynomial.C (p.eval a) := by
    conv_lhs => rw [← Polynomial.modByMonic_add_div p ((X : S[X]) - Polynomial.C a)]
    rw [Polynomial.modByMonic_X_sub_C_eq_C_eval]
    ring
  have hderiv := congrArg Polynomial.derivative hdecomp
  rw [Polynomial.derivative_add, Polynomial.derivative_C, add_zero, Polynomial.derivative_mul,
    Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C, sub_zero,
    one_mul] at hderiv
  have heval := congrArg (Polynomial.eval a) hderiv
  simpa using heval.symm

/-! ## The quotient by the square of the derivative -/

/-- The substituted polynomial `F(y₀ + d Z)` divided by `d ^ 2`, when `F(y₀) = d ^ 2 ε` and
`d = F′(y₀)`.  Its reduction modulo an ideal containing `ε` is `Z`. -/
noncomputable def rychlikQuotient (F : S[X]) (y₀ d ε : S) : S[X] :=
  ∑ k ∈ Finset.range ((Polynomial.taylor y₀ F).natDegree + 2),
    Polynomial.C (if k = 0 then ε else if k = 1 then 1
      else (Polynomial.taylor y₀ F).coeff k * d ^ (k - 2)) * Polynomial.X ^ k

theorem coeff_rychlikQuotient (F : S[X]) (y₀ d ε : S) (k : ℕ) :
    (rychlikQuotient F y₀ d ε).coeff k
      = if k = 0 then ε else if k = 1 then 1
        else (Polynomial.taylor y₀ F).coeff k * d ^ (k - 2) := by
  classical
  rw [rychlikQuotient, Polynomial.finsetSum_coeff]
  by_cases hk : k < (Polynomial.taylor y₀ F).natDegree + 2
  · rw [Finset.sum_eq_single k]
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    · intro b _ hb
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (Ne.symm hb), mul_zero]
    · intro hcon
      exact absurd (Finset.mem_range.2 hk) hcon
  · have hzero : (Polynomial.taylor y₀ F).coeff k = 0 :=
      Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [if_neg (by omega), if_neg (by omega), hzero, zero_mul]
    refine Finset.sum_eq_zero fun b hb => ?_
    have hbd : b < (Polynomial.taylor y₀ F).natDegree + 2 := Finset.mem_range.1 hb
    have hne : k ≠ b := by omega
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hne, mul_zero]

theorem C_sq_mul_rychlikQuotient {F : S[X]} {y₀ d ε : S}
    (hval : F.eval y₀ = d ^ 2 * ε)
    (hderiv : (Polynomial.derivative F).eval y₀ = d) :
    Polynomial.C (d ^ 2) * rychlikQuotient F y₀ d ε = shiftScale F y₀ d := by
  ext k
  rw [Polynomial.coeff_C_mul, coeff_rychlikQuotient, coeff_shiftScale]
  match k with
  | 0 =>
      rw [if_pos rfl, Polynomial.taylor_coeff_zero, hval, pow_zero, mul_one]
  | 1 =>
      rw [if_neg one_ne_zero, if_pos rfl, Polynomial.taylor_coeff_one, hderiv, mul_one, pow_one,
        sq]
  | (k + 2) =>
      rw [if_neg (by omega), if_neg (by omega)]
      have hsub : (k + 2) - 2 = k := by omega
      rw [hsub]
      ring

/-! ## Newton's lemma -/

/-- **Newton's lemma (Hensel–Rychlik).**  Over a ring complete for an ideal `I`, if the value of `F`
at `y₀` is the square of the derivative there times an element of `I`, then `F` has a root
`y₀ + d z` with `z ∈ I`, where `d = F′(y₀)`.  No unit, no monicity, no simple root. -/
theorem exists_isRoot_of_sq_dvd [Nontrivial S] (I : Ideal S) [IsAdicComplete I S]
    {F : S[X]} {y₀ d ε : S}
    (hderiv : (Polynomial.derivative F).eval y₀ = d)
    (hval : F.eval y₀ = d ^ 2 * ε) (hε : ε ∈ I) :
    ∃ z : S, z ∈ I ∧ F.IsRoot (y₀ + d * z) := by
  classical
  set H : S[X] := rychlikQuotient F y₀ d ε with hHdef
  have hGH : Polynomial.C (d ^ 2) * H = shiftScale F y₀ d := C_sq_mul_rychlikQuotient hval hderiv
  have hmonic0 : ((X : S[X]) - Polynomial.C (0 : S)).Monic := monic_X_sub_C 0
  have hH0 : H.eval 0 = ε := by
    rw [← Polynomial.coeff_zero_eq_eval_zero, hHdef, coeff_rychlikQuotient, if_pos rfl]
  have hmod : CoeffMem I (H %ₘ ((X : S[X]) - Polynomial.C (0 : S))) := by
    rw [Polynomial.modByMonic_X_sub_C_eq_C_eval, hH0]
    intro i
    rw [Polynomial.coeff_C]
    split
    · exact hε
    · exact I.zero_mem
  have hQ1 : (H /ₘ ((X : S[X]) - Polynomial.C (0 : S))).eval 0 = 1 := by
    rw [eval_divByMonic_X_sub_C, ← Polynomial.coeff_zero_eq_eval_zero,
      Polynomial.coeff_derivative]
    have h1 : H.coeff (0 + 1) = 1 := by
      rw [hHdef, coeff_rychlikQuotient]
      norm_num
    rw [h1]
    norm_num
  obtain ⟨s, hs⟩ : ((X : S[X]) - Polynomial.C (0 : S)) ∣
      ((1 : S[X]) * (H /ₘ ((X : S[X]) - Polynomial.C (0 : S))) - 1) := by
    refine (Polynomial.dvd_iff_isRoot (a := (0 : S))).2 ?_
    rw [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_mul,
      Polynomial.eval_one, one_mul, hQ1, sub_self]
  have hbez : CoeffMem I ((1 : S[X]) * (H /ₘ ((X : S[X]) - Polynomial.C (0 : S)))
      + (-s) * ((X : S[X]) - Polynomial.C (0 : S)) - 1) := by
    have hz : (1 : S[X]) * (H /ₘ ((X : S[X]) - Polynomial.C (0 : S)))
        + (-s) * ((X : S[X]) - Polynomial.C (0 : S)) - 1 = 0 := by
      linear_combination hs
    rw [hz]
    exact coeffMem_zero
  obtain ⟨g, hgm, hgdeg, hgdvd, hgsub⟩ :=
    exists_monic_dvd_of_coeffMem_modByMonic I hmonic0 hmod hbez
  have hgnat : g.natDegree = 1 := by
    rw [Polynomial.natDegree_eq_of_degree_eq hgdeg, Polynomial.natDegree_X_sub_C]
  have hgz : g = (X : S[X]) - Polynomial.C (-(g.coeff 0)) := by
    rw [map_neg, sub_neg_eq_add]
    exact hgm.eq_X_add_C hgnat
  have hzI : -(g.coeff 0) ∈ I := by
    have h0 := hgsub 0
    have hrw : (g - ((X : S[X]) - Polynomial.C (0 : S))).coeff 0 = g.coeff 0 := by simp
    rw [hrw] at h0
    exact I.neg_mem h0
  refine ⟨-(g.coeff 0), hzI, ?_⟩
  have hHz : Polynomial.eval (-(g.coeff 0)) H = 0 := by
    have hroot : H.IsRoot (-(g.coeff 0)) := by
      rw [← Polynomial.dvd_iff_isRoot, ← hgz]
      exact hgdvd
    exact hroot
  rw [Polynomial.IsRoot, ← eval_shiftScale F y₀ d, ← hGH, Polynomial.eval_mul, Polynomial.eval_C,
    hHz, mul_zero]

/-- **Newton's lemma with defect `r`.**  If `F′(y₀) = X ^ r · unit` and `F(y₀)` vanishes to order at
least `2r + 1`, then `F` has a root congruent to `y₀` modulo `X ^ (r+1)`. -/
theorem exists_isRoot_of_defect [Nontrivial R] {F : (PowerSeries R)[X]} {y₀ u : PowerSeries R}
    {r : ℕ} (hu : IsUnit u)
    (hderiv : (Polynomial.derivative F).eval y₀ = (PowerSeries.X : PowerSeries R) ^ r * u)
    (hval : (PowerSeries.X : PowerSeries R) ^ (2 * r + 1) ∣ F.eval y₀) :
    ∃ y : PowerSeries R, F.IsRoot y ∧
      (PowerSeries.X : PowerSeries R) ^ (r + 1) ∣ (y - y₀) := by
  classical
  obtain ⟨c, hc⟩ := hval
  obtain ⟨w, hw⟩ := hu
  have huw : u * (↑w⁻¹ : PowerSeries R) = 1 := by
    rw [← hw]
    exact w.mul_inv
  have hval' : F.eval y₀ = ((PowerSeries.X : PowerSeries R) ^ r * u) ^ 2 *
      ((PowerSeries.X : PowerSeries R) * c * ((↑w⁻¹ : PowerSeries R) ^ 2)) := by
    have hXX : (PowerSeries.X : PowerSeries R) ^ (2 * r + 1)
        = ((PowerSeries.X : PowerSeries R) ^ r) ^ 2 * (PowerSeries.X : PowerSeries R) := by
      rw [← pow_mul, ← pow_succ]
      congr 1
      omega
    have hexp : ((PowerSeries.X : PowerSeries R) ^ r * u) ^ 2 *
        ((PowerSeries.X : PowerSeries R) * c * ((↑w⁻¹ : PowerSeries R) ^ 2))
        = ((PowerSeries.X : PowerSeries R) ^ r) ^ 2 * (PowerSeries.X : PowerSeries R) * c *
          (u * (↑w⁻¹ : PowerSeries R)) ^ 2 := by ring
    rw [hc, hXX, hexp, huw, one_pow, mul_one]
  have hεI : (PowerSeries.X : PowerSeries R) * c * ((↑w⁻¹ : PowerSeries R) ^ 2)
      ∈ Ideal.span {(PowerSeries.X : PowerSeries R)} :=
    Ideal.mem_span_singleton.2 ⟨c * ((↑w⁻¹ : PowerSeries R) ^ 2), by ring⟩
  obtain ⟨z, hzI, hroot⟩ :=
    exists_isRoot_of_sq_dvd (Ideal.span {(PowerSeries.X : PowerSeries R)}) hderiv hval' hεI
  refine ⟨y₀ + ((PowerSeries.X : PowerSeries R) ^ r * u) * z, hroot, ?_⟩
  obtain ⟨z', hz'⟩ := Ideal.mem_span_singleton.1 hzI
  refine ⟨u * z', ?_⟩
  rw [add_sub_cancel_left, hz', pow_succ]
  ring

end GaloisForLFunctions.HTGeometry
