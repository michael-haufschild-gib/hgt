import GaloisForLFunctions.HTGeometry.AdicCompletionTopology
import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic

/-!
# Open cosets in an adic completion

A set saturated for a continuous map into a discrete space is open.  In the adic completion the
projection to `R / I` factors through the first coordinate, which is continuous with discrete
target, so every coset of an ideal containing the kernel of that projection is open.
-/

namespace HTGeometry

universe u

/-- A set saturated for a continuous map into a discrete space is open. -/
theorem isOpen_of_saturated {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [DiscreteTopology Y] {f : X → Y} (hf : Continuous f) {S : Set X}
    (hS : ∀ x y, f x = f y → x ∈ S → y ∈ S) : IsOpen S := by
  have hpre : S = f ⁻¹' (f '' S) := by
    ext x
    refine ⟨fun hx => ⟨x, hx, rfl⟩, ?_⟩
    rintro ⟨y, hy, hxy⟩
    exact hS y x hxy hy
  rw [hpre]
  exact hf.isOpen_preimage _ (isOpen_discrete _)

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The projection of the adic completion onto `R / I` factors through the first coordinate. -/
theorem evalOne_eq_of_eval_eq (x y : AdicCompletion I R)
    (h : AdicCompletion.eval I R 1 x = AdicCompletion.eval I R 1 y) :
    AdicCompletion.evalOneₐ I x = AdicCompletion.evalOneₐ I y := by
  have hev : AdicCompletion.evalₐ I 1 x = AdicCompletion.evalₐ I 1 y := by
    rw [← AdicCompletion.factor_eval_eq_evalₐ I x (by simp),
      ← AdicCompletion.factor_eval_eq_evalₐ I y (by simp), h]
  rw [← AdicCompletion.factorₐ_evalₐ_one, ← AdicCompletion.factorₐ_evalₐ_one, hev]

/-- Every coset of an ideal of the adic completion containing the kernel of the projection onto
`R / I` is open. -/
theorem isOpen_coset_of_ker_evalOne_le (J : Ideal (AdicCompletion I R))
    (hJ : RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom ≤ J) (a : AdicCompletion I R) :
    IsOpen {b : AdicCompletion I R | b - a ∈ J} := by
  refine isOpen_of_saturated (f := AdicQuot.coord I 1) (continuous_adicCoord I 1) ?_
  intro x y hxy hx
  have h0 : AdicCompletion.evalOneₐ I (y - x) = 0 := by
    rw [map_sub, evalOne_eq_of_eval_eq I y x hxy.symm, sub_self]
  have h2 : y - x ∈ J := hJ (by rw [RingHom.mem_ker]; exact h0)
  have hsplit : y - a = (y - x) + (x - a) := by ring
  rw [Set.mem_setOf_eq, hsplit]
  exact J.add_mem h2 hx

/-- The kernel of the projection onto `R / I` consists of non-units when `R / I` is nontrivial. -/
theorem ker_evalOne_le_maximalIdeal [Nontrivial (R ⧸ I)]
    [IsLocalRing (AdicCompletion I R)] :
    RingHom.ker (AdicCompletion.evalOneₐ I).toRingHom
      ≤ IsLocalRing.maximalIdeal (AdicCompletion I R) := by
  intro z hz
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have hone : IsUnit (AdicCompletion.evalOneₐ I z) := hu.map (AdicCompletion.evalOneₐ I)
  rw [RingHom.mem_ker] at hz
  rw [show AdicCompletion.evalOneₐ I z = 0 from hz] at hone
  exact not_isUnit_zero hone

/-- **Every coset of the maximal ideal of an adic completion is open.** -/
theorem isOpen_maximalIdeal_coset_adicCompletion [Nontrivial (R ⧸ I)]
    [IsLocalRing (AdicCompletion I R)] (a : AdicCompletion I R) :
    IsOpen {b : AdicCompletion I R | b - a ∈ IsLocalRing.maximalIdeal (AdicCompletion I R)} :=
  isOpen_coset_of_ker_evalOne_le I _ (ker_evalOne_le_maximalIdeal I) a

/-- If the cosets of a principal ideal generated by an element of the maximal ideal are open, so
are the cosets of the maximal ideal. -/
theorem isOpen_maximalIdeal_coset_of_span {S : Type u} [CommRing S] [IsLocalRing S]
    [TopologicalSpace S] {q : S} (hq : q ∈ IsLocalRing.maximalIdeal S)
    (h : ∀ a : S, IsOpen {b : S | b - a ∈ Ideal.span {q}}) (a : S) :
    IsOpen {b : S | b - a ∈ IsLocalRing.maximalIdeal S} := by
  have hcover : {b : S | b - a ∈ IsLocalRing.maximalIdeal S}
      = ⋃ c ∈ IsLocalRing.maximalIdeal S, {b : S | b - (a + c) ∈ Ideal.span {q}} := by
    ext b
    constructor
    · intro hb
      refine Set.mem_iUnion₂.2 ⟨b - a, hb, ?_⟩
      have : b - (a + (b - a)) = 0 := by ring
      rw [Set.mem_setOf_eq, this]
      exact Submodule.zero_mem _
    · intro hb
      obtain ⟨c, hc, hbc⟩ := Set.mem_iUnion₂.1 hb
      have hq' : b - (a + c) ∈ IsLocalRing.maximalIdeal S :=
        (Ideal.span_le.2 (by simpa using hq)) hbc
      have hsplit : b - a = (b - (a + c)) + c := by ring
      rw [Set.mem_setOf_eq, hsplit]
      exact Submodule.add_mem _ hq' hc
  rw [hcover]
  exact isOpen_biUnion fun c _ => h (a + c)

end HTGeometry
