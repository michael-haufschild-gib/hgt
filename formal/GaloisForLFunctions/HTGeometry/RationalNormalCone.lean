import GaloisForLFunctions.HTGeometry.MonomialRegularity
import GaloisForLFunctions.HTGeometry.CohenMacaulayLifting

/-!
# The cone over the rational normal curve is Cohen–Macaulay

The `r = 1` stratum of the Hankel secant stratification is `C_{N-1}`, the affine cone over the
rational normal curve of degree `d = N - 1`.  Its coordinate ring is the monomial subalgebra of
`K[U, T]` on the exponent semigroup

```text
S = { (a, b) : b ≤ d · a } = {(0,0)} ∪ { (a,b) : a ≥ 1, 0 ≤ b ≤ d a } ,
```

spanned by the monomials `U ^ a T ^ b` with `(a,b) ∈ S`, i.e. generated by `U, U T, …, U T ^ d`.

The Cohen–Macaulay property is a semigroup computation.  For `(a,b) ∈ S`,

```text
(a, b) + (1, d) ∈ (1,0) + S   ⟺   b + d ≤ d a   ⟺   b ≤ d (a-1)   ⟺   (a,b) ∈ (1,0) + S ,
```

which by `monomial_regular_of_semigroup` says exactly that `U T ^ d` is a nonzerodivisor modulo `U`.
So `(U, U T ^ d)` is a ring-regular sequence of length two.

The dimension is two: the cone ring is integral over the polynomial ring on `U` and `U T ^ d`,
because `(U T ^ i) ^ d = U ^ (d - i) · (U T ^ d) ^ i`, and Krull dimension does not grow along an
integral extension.  Together:

```text
coneExp_refl_translate                    the semigroup identity
isRegularOn_coneTop                       U T ^ d is regular modulo U
isRingRegularSeq_cone                     (U, U T ^ d) is a regular sequence
isIntegral_cone                           the cone ring is integral over K[U, U T ^ d]
ringKrullDim_le_of_isIntegral             ** dimension does not grow along an integral extension **
ringKrullDim_rationalNormalCone           dim = 2
isCohenMacaulayRing_rationalNormalCone    ** the cone is Cohen–Macaulay **
```
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u
variable {K : Type u} [Field K]

/-- The exponent semigroup of the affine cone over the rational normal curve of degree `d`. -/
def coneExp (d : ℕ) : Set (Fin 2 →₀ ℕ) := {e | e 1 ≤ d * e 0}

theorem zero_mem_coneExp (d : ℕ) : (0 : Fin 2 →₀ ℕ) ∈ coneExp d := by
  simp [coneExp]

theorem add_mem_coneExp (d : ℕ) {a b : Fin 2 →₀ ℕ} (ha : a ∈ coneExp d) (hb : b ∈ coneExp d) :
    a + b ∈ coneExp d := by
  simp only [coneExp, Set.mem_setOf_eq, Finsupp.add_apply] at *
  calc a 1 + b 1 ≤ d * a 0 + d * b 0 := Nat.add_le_add ha hb
    _ = d * (a 0 + b 0) := (Nat.mul_add d (a 0) (b 0)).symm

/-- The coordinate ring of the cone over the rational normal curve of degree `d`, as the monomial
subalgebra of `K[U, T]` on the exponent semigroup `coneExp d`. -/
noncomputable def rationalNormalCone (K : Type u) [Field K] (d : ℕ) :
    Subalgebra K (MvPolynomial (Fin 2) K) where
  carrier := (monomialSpan K (coneExp d) : Set (MvPolynomial (Fin 2) K))
  mul_mem' := mul_mem_monomialSpan (fun _ ha _ hb => add_mem_coneExp d ha hb)
  one_mem' := one_mem_monomialSpan (zero_mem_coneExp d)
  add_mem' := Submodule.add_mem _
  zero_mem' := Submodule.zero_mem _
  algebraMap_mem' := fun r => by
    have h : algebraMap K (MvPolynomial (Fin 2) K) r = r • (1 : MvPolynomial (Fin 2) K) := by
      simp [Algebra.smul_def]
    rw [h]
    exact Submodule.smul_mem _ _ (one_mem_monomialSpan (zero_mem_coneExp d))

theorem mem_rationalNormalCone_iff {d : ℕ} {p : MvPolynomial (Fin 2) K} :
    p ∈ rationalNormalCone K d ↔ (↑p.support : Set (Fin 2 →₀ ℕ)) ⊆ coneExp d :=
  mem_monomialSpan_iff

/-- The apex coordinate `U` of the cone. -/
noncomputable def coneApexExp : Fin 2 →₀ ℕ := Finsupp.single 0 1

/-- The exponent of the top generator `U T ^ d`. -/
noncomputable def coneTopExp (d : ℕ) : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 d

theorem coneApexExp_mem (d : ℕ) : coneApexExp ∈ coneExp d := by
  simp [coneExp, coneApexExp]

theorem coneTopExp_mem (d : ℕ) : coneTopExp d ∈ coneExp d := by
  simp [coneExp, coneTopExp]

theorem finsupp_fin2_eq (e : Fin 2 →₀ ℕ) :
    e = Finsupp.single 0 (e 0) + Finsupp.single 1 (e 1) := by
  ext i
  fin_cases i <;> simp

/-- **The semigroup regularity identity.**  For `d ≥ 1`, if `e` and `e + (1, d)` both lie one apex
step inside the cone semigroup, then so does `e`.  This is exactly the injectivity of multiplication
by `U T ^ d` on the quotient of the cone ring by `U`. -/
theorem coneExp_refl_translate {d : ℕ} (hd : 0 < d) (e : Fin 2 →₀ ℕ) (_he : e ∈ coneExp d)
    (h : e + coneTopExp d ∈ (fun f => coneApexExp + f) '' coneExp d) :
    e ∈ (fun f => coneApexExp + f) '' coneExp d := by
  obtain ⟨f, hf, hfe⟩ := h
  have h0 : 1 + f 0 = e 0 + 1 := by
    have := congrArg (fun g : Fin 2 →₀ ℕ => g 0) hfe
    simpa [coneApexExp, coneTopExp] using this
  have h1 : f 1 = e 1 + d := by
    have := congrArg (fun g : Fin 2 →₀ ℕ => g 1) hfe
    simpa [coneApexExp, coneTopExp] using this
  have hfc : f 1 ≤ d * f 0 := hf
  have hf0 : f 0 = e 0 := by omega
  rw [hf0, h1] at hfc
  have he0 : 1 ≤ e 0 := by
    by_contra hcon
    have : e 0 = 0 := by omega
    rw [this] at hfc
    omega
  obtain ⟨c, hc⟩ : ∃ c, e 0 = c + 1 := ⟨e 0 - 1, by omega⟩
  rw [hc, Nat.mul_succ] at hfc
  refine ⟨Finsupp.single 0 c + Finsupp.single 1 (e 1), ?_, ?_⟩
  · have hcone : ((Finsupp.single (0 : Fin 2) c + Finsupp.single 1 (e 1) : Fin 2 →₀ ℕ)) 1
        ≤ d * ((Finsupp.single (0 : Fin 2) c + Finsupp.single 1 (e 1) : Fin 2 →₀ ℕ)) 0 := by
      simp only [Finsupp.add_apply]
      simp
      omega
    exact hcone
  · rw [finsupp_fin2_eq e, hc]
    ext i
    fin_cases i <;> first | (simp [coneApexExp]; omega) | simp [coneApexExp]


theorem monomial_mem_monomialSpan {σ : Type*} {s : Set (σ →₀ ℕ)} {e : σ →₀ ℕ} (he : e ∈ s) :
    (MvPolynomial.monomial e (1 : K)) ∈ monomialSpan K s :=
  Submodule.subset_span ⟨e, he, rfl⟩

/-- The apex generator `U` of the cone ring. -/
noncomputable def coneApex (K : Type u) [Field K] (d : ℕ) : rationalNormalCone K d :=
  ⟨MvPolynomial.monomial coneApexExp 1, monomial_mem_monomialSpan (coneApexExp_mem d)⟩

/-- The top generator `U T ^ d` of the cone ring. -/
noncomputable def coneTop (K : Type u) [Field K] (d : ℕ) : rationalNormalCone K d :=
  ⟨MvPolynomial.monomial (coneTopExp d) 1, monomial_mem_monomialSpan (coneTopExp_mem d)⟩

theorem coneApex_ne_zero (d : ℕ) : coneApex K d ≠ 0 := by
  intro h
  have := congrArg (fun x : rationalNormalCone K d => (x : MvPolynomial (Fin 2) K)) h
  simp only [coneApex, Subalgebra.coe_zero] at this
  exact one_ne_zero ((MvPolynomial.monomial_eq_zero).mp this)

/-- **`U` is a nonzerodivisor of the cone ring.** -/
theorem isRegularOn_bot_coneApex (d : ℕ) :
    IsRegularOn (⊥ : Ideal (rationalNormalCone K d)) (coneApex K d) := by
  haveI : (⊥ : Ideal (rationalNormalCone K d)).IsPrime := Ideal.isPrime_bot
  rw [IsRegularOn, mem_nonZeroDivisors_iff_ne_zero]
  simp only [ne_eq, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_bot]
  exact coneApex_ne_zero d

/-- **`U T ^ d` is a nonzerodivisor modulo `U`.**  This is the semigroup identity
`coneExp_refl_translate` read inside the cone ring. -/
theorem isRegularOn_coneTop {d : ℕ} (hd : 0 < d) :
    IsRegularOn (Ideal.span {coneApex K d}) (coneTop K d) := by
  have key : ∀ x : rationalNormalCone K d,
      (x * coneTop K d) ∈ Ideal.span {coneApex K d} → x ∈ Ideal.span {coneApex K d} := by
    intro x hx
    rw [Ideal.mem_span_singleton'] at hx ⊢
    obtain ⟨a, ha⟩ := hx
    have hpoly : (x : MvPolynomial (Fin 2) K) * MvPolynomial.monomial (coneTopExp d) 1
        = MvPolynomial.monomial coneApexExp 1 * (a : MvPolynomial (Fin 2) K) := by
      have := congrArg (fun y : rationalNormalCone K d => (y : MvPolynomial (Fin 2) K)) ha
      simpa [coneApex, coneTop, mul_comm] using this.symm
    obtain ⟨w, hw, hxw⟩ := monomial_regular_of_semigroup
      (s := coneExp d) (α := coneApexExp) (β := coneTopExp d)
      (fun e he h => coneExp_refl_translate hd e he h) x.2
      ⟨(a : MvPolynomial (Fin 2) K), a.2, hpoly⟩
    refine ⟨⟨w, hw⟩, ?_⟩
    apply Subtype.ext
    simpa [coneApex, mul_comm] using hxw.symm
  rw [IsRegularOn, mem_nonZeroDivisors_iff]
  constructor
  · intro z hz
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hz
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact key x (by rwa [mul_comm] at hz)
  · intro z hz
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hz
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact key x hz


/-! ## The regular sequence -/

/-- Evaluation of the constant coefficient on the cone ring. -/
noncomputable def coneConstantCoeff (K : Type u) [Field K] (d : ℕ) :
    rationalNormalCone K d →+* K :=
  (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) K →+* K).comp
    (rationalNormalCone K d).val.toRingHom

theorem coneApexExp_ne_zero : (coneApexExp : Fin 2 →₀ ℕ) ≠ 0 := by
  intro h
  have := congrArg (fun g : Fin 2 →₀ ℕ => g 0) h
  simp [coneApexExp] at this

theorem coneTopExp_ne_zero (d : ℕ) : (coneTopExp d : Fin 2 →₀ ℕ) ≠ 0 := by
  intro h
  have := congrArg (fun g : Fin 2 →₀ ℕ => g 0) h
  simp [coneTopExp] at this

theorem coneConstantCoeff_apex (d : ℕ) : coneConstantCoeff K d (coneApex K d) = 0 := by
  show MvPolynomial.constantCoeff (MvPolynomial.monomial coneApexExp (1 : K)) = 0
  rw [MvPolynomial.constantCoeff_monomial, if_neg coneApexExp_ne_zero]

theorem coneConstantCoeff_top (d : ℕ) : coneConstantCoeff K d (coneTop K d) = 0 := by
  show MvPolynomial.constantCoeff (MvPolynomial.monomial (coneTopExp d) (1 : K)) = 0
  rw [MvPolynomial.constantCoeff_monomial, if_neg (coneTopExp_ne_zero d)]

theorem ofList_cone_ne_top (d : ℕ) :
    Ideal.ofList [coneApex K d, coneTop K d] ≠ ⊤ := by
  intro htop
  have hle : Ideal.ofList [coneApex K d, coneTop K d] ≤ RingHom.ker (coneConstantCoeff K d) := by
    rw [Ideal.ofList, Ideal.span_le]
    rintro x hx
    simp only [Set.mem_setOf_eq, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    · exact coneConstantCoeff_apex d
    · exact coneConstantCoeff_top d
  rw [htop, top_le_iff] at hle
  have h1 : coneConstantCoeff K d 1 = 0 := by
    rw [← RingHom.mem_ker, hle]; trivial
  rw [map_one] at h1
  exact one_ne_zero h1

/-- **`(U, U T ^ d)` is a ring-regular sequence in the cone ring.** -/
theorem isRingRegularSeq_cone {d : ℕ} (hd : 0 < d) :
    IsRingRegularSeq [coneApex K d, coneTop K d] := by
  constructor
  · intro i hi
    have hi2 : i < 2 := by simpa using hi
    match i, hi2 with
    | 0, _ => simpa [ofList_nil] using isRegularOn_bot_coneApex (K := K) d
    | 1, _ => simpa [ofList_cons, ofList_nil] using isRegularOn_coneTop (K := K) hd
  · exact ofList_cone_ne_top d


/-! ## Integrality over the polynomial ring on the apex and the top generator -/

/-- The parameterizing map `K[x, y] → R`, `x ↦ U`, `y ↦ U T ^ d`. -/
noncomputable def coneParamHom (K : Type u) [Field K] (d : ℕ) :
    MvPolynomial (Fin 2) K →ₐ[K] rationalNormalCone K d :=
  MvPolynomial.aeval ![coneApex K d, coneTop K d]

noncomputable instance coneBaseAlgebra (K : Type u) [Field K] (d : ℕ) :
    Algebra (MvPolynomial (Fin 2) K) (rationalNormalCone K d) :=
  (coneParamHom K d).toRingHom.toAlgebra

theorem coneAlgebraMap_eq (d : ℕ) :
    algebraMap (MvPolynomial (Fin 2) K) (rationalNormalCone K d) = (coneParamHom K d).toRingHom :=
  rfl

theorem coneParamHom_X_zero (d : ℕ) : coneParamHom K d (MvPolynomial.X 0) = coneApex K d := by
  simp [coneParamHom]

theorem coneParamHom_X_one (d : ℕ) : coneParamHom K d (MvPolynomial.X 1) = coneTop K d := by
  simp [coneParamHom]

/-- **Every cone monomial is integral over `K[U, U T ^ d]`**, because its `d`-th power is the
monomial `U ^ (a d - b) · (U T ^ d) ^ b`. -/
theorem isIntegral_monomial_cone {d : ℕ} (hd : 0 < d) {e : Fin 2 →₀ ℕ} (he : e ∈ coneExp d)
    (h : (MvPolynomial.monomial e (1 : K)) ∈ rationalNormalCone K d) :
    IsIntegral (MvPolynomial (Fin 2) K)
      (⟨MvPolynomial.monomial e 1, h⟩ : rationalNormalCone K d) := by
  have hle : e 1 ≤ d * e 0 := he
  refine ⟨Polynomial.X ^ d - Polynomial.C
      (MvPolynomial.X 0 ^ (e 0 * d - e 1) * MvPolynomial.X 1 ^ (e 1)),
    Polynomial.monic_X_pow_sub_C _ (by omega), ?_⟩
  simp only [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
    sub_eq_zero]
  apply Subtype.ext
  show ((MvPolynomial.monomial e (1 : K)) ^ d : MvPolynomial (Fin 2) K)
    = ((coneParamHom K d (MvPolynomial.X 0 ^ (e 0 * d - e 1) * MvPolynomial.X 1 ^ e 1) :
        rationalNormalCone K d) : MvPolynomial (Fin 2) K)
  rw [map_mul, map_pow, map_pow, coneParamHom_X_zero, coneParamHom_X_one]
  show ((MvPolynomial.monomial e (1 : K)) ^ d : MvPolynomial (Fin 2) K)
    = ((MvPolynomial.monomial coneApexExp (1 : K)) ^ (e 0 * d - e 1)
      * (MvPolynomial.monomial (coneTopExp d) (1 : K)) ^ (e 1))
  have hc0 : d * e 0 = e 0 * d := Nat.mul_comm _ _
  have hc1 : d * e 1 = e 1 * d := Nat.mul_comm _ _
  have hexp : d • e = (e 0 * d - e 1) • coneApexExp + e 1 • coneTopExp d := by
    ext i
    fin_cases i <;>
      · simp only [Finsupp.smul_apply, Finsupp.add_apply, smul_eq_mul, coneApexExp, coneTopExp,
          Finsupp.single_apply]
        norm_num
        omega
  simp only [MvPolynomial.monomial_pow, MvPolynomial.monomial_mul, one_pow, mul_one, hexp]

theorem isIntegral_cone {d : ℕ} (hd : 0 < d) (p : rationalNormalCone K d) :
    IsIntegral (MvPolynomial (Fin 2) K) p := by
  have key : ∀ (q : MvPolynomial (Fin 2) K), ∀ hq : q ∈ monomialSpan K (coneExp d),
      ∀ h : q ∈ rationalNormalCone K d,
        IsIntegral (MvPolynomial (Fin 2) K) (⟨q, h⟩ : rationalNormalCone K d) := by
    intro q hq
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hq
    · rintro x ⟨e, he, rfl⟩ h
      exact isIntegral_monomial_cone hd he h
    · intro h
      have : (⟨0, h⟩ : rationalNormalCone K d) = 0 := rfl
      rw [this]
      exact isIntegral_zero
    · intro x y hx hy ihx ihy h
      have hxy : (⟨x + y, h⟩ : rationalNormalCone K d)
          = (⟨x, hx⟩ : rationalNormalCone K d) + ⟨y, hy⟩ := rfl
      rw [hxy]
      exact (ihx hx).add (ihy hy)
    · intro a x hx ihx h
      have hax : (⟨a • x, h⟩ : rationalNormalCone K d)
          = (algebraMap K (rationalNormalCone K d) a) * ⟨x, hx⟩ := by
        apply Subtype.ext
        show a • x = (algebraMap K (MvPolynomial (Fin 2) K) a) * x
        rw [Algebra.smul_def]
      rw [hax]
      refine IsIntegral.mul ?_ (ihx hx)
      have : algebraMap K (rationalNormalCone K d) a
          = algebraMap (MvPolynomial (Fin 2) K) (rationalNormalCone K d) (MvPolynomial.C a) := by
        rw [coneAlgebraMap_eq]
        exact ((coneParamHom K d).commutes a).symm
      rw [this]
      exact isIntegral_algebraMap
  simpa using key (p : MvPolynomial (Fin 2) K) p.2 p.2

instance coneIsIntegral (K : Type u) [Field K] {d : ℕ} [Fact (0 < d)] :
    Algebra.IsIntegral (MvPolynomial (Fin 2) K) (rationalNormalCone K d) :=
  ⟨fun p => isIntegral_cone (Fact.out : 0 < d) p⟩


/-! ## Dimension and the Cohen–Macaulay property -/

theorem strictMono_primeSpectrum_comap_of_isIntegral
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] :
    StrictMono (PrimeSpectrum.comap (algebraMap A B)) := by
  intro p q hpq
  exact Ideal.IsIntegral.comap_lt_comap (R := A) (A := B) (I := p.asIdeal) (J := q.asIdeal) hpq

/-- **Krull dimension does not grow along an integral extension.**  Comap of primes is strictly
monotone for an integral extension, so every chain upstairs contracts to a chain of the same
length. -/
theorem ringKrullDim_le_of_isIntegral
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] :
    ringKrullDim B ≤ ringKrullDim A :=
  Order.krullDim_le_of_strictMono _ strictMono_primeSpectrum_comap_of_isIntegral

theorem ringKrullDim_mvPolynomial_fin_two (K : Type u) [Field K] :
    ringKrullDim (MvPolynomial (Fin 2) K) = 2 := by
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field K]
  simp

/-- **The cone over the rational normal curve is two-dimensional.**  It is integral over the
polynomial ring on the apex and the top generator, which bounds the dimension by two, and it carries
a ring-regular sequence of length two, which bounds it below. -/
theorem ringKrullDim_rationalNormalCone {d : ℕ} (hd : 0 < d) :
    ringKrullDim (rationalNormalCone K d) = 2 := by
  haveI : Fact (0 < d) := ⟨hd⟩
  refine le_antisymm ?_ ?_
  · calc ringKrullDim (rationalNormalCone K d)
        ≤ ringKrullDim (MvPolynomial (Fin 2) K) := ringKrullDim_le_of_isIntegral
      _ = 2 := ringKrullDim_mvPolynomial_fin_two K
  · have h := length_le_ringKrullDim_of_isRingRegularSeq
      [coneApex K d, coneTop K d] (isRingRegularSeq_cone (K := K) hd)
    simpa using h

/-- **The cone over the rational normal curve is Cohen–Macaulay.**  `(U, U T ^ d)` is a ring-regular
sequence of length two and the dimension is two.

For the Hankel stratification this is the `r = 1` stratum: `C_{N-1}`, the cone over the rational
normal curve of degree `N - 1`, is Cohen–Macaulay. -/
theorem isCohenMacaulayRing_rationalNormalCone {d : ℕ} (hd : 0 < d) :
    IsCohenMacaulayRing (rationalNormalCone K d) :=
  ⟨[coneApex K d, coneTop K d], isRingRegularSeq_cone hd, by
    rw [ringKrullDim_rationalNormalCone hd]
    simp⟩


end GaloisForLFunctions.HTGeometry
