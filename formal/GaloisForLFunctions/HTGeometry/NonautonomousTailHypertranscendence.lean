import GaloisForLFunctions.HTGeometry.FreeDifferentialFieldPresentation
import GaloisForLFunctions.HTGeometry.NonautonomousTailGenerator

/-!
# The phase coordinate of a nontrivial nonautonomous tail is hypertranscendental

A nontrivial phase tail of a protocol of derivation-compatible injections is generated by one
element.  That element is not a constant, and inside a singly and freely differentially generated
field every nonconstant element is hypertranscendental over the base.

This is the phase coordinate in the exact form the projective time law uses: a differentially
transcendental generator at every phase.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {C F : Type*} [Field C] [Field F] [Differential C] [Differential F] [Algebra C F]
  [DifferentialAlgebra C F] [CharZero C] [CharZero F]

omit [CharZero C] [CharZero F] in
/-- A differentially generated field is the base field exactly when its generator is. -/
theorem differentialAdjoin_singleton_eq_bot_of_mem_bot {u : F}
    (hu : u ∈ (⊥ : IntermediateField C F)) :
    differentialAdjoin C ({u} : Set F) = ⊥ :=
  le_antisymm (differentialAdjoin_le C (by simpa using hu) derivationClosed_bot) bot_le

/-- **Each nontrivial phase tail is generated by a hypertranscendental element.** -/
theorem exists_nonautonomousTail_hypertranscendental_generator
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    (φ : ℕ → F →ₐ[C] F) (hφ : ∀ i x, φ i x′ = (φ i x)′) (i : ℕ)
    (hTne : nonautonomousTail φ i ≠ ⊥) :
    ∃ u : F, HypertranscendentalOver C u ∧
      differentialAdjoin C ({u} : Set F) = nonautonomousTail φ i := by
  obtain ⟨u, hu⟩ := exists_nonautonomousTail_generator hy hytop φ hφ i hTne
  have hu0 : u ∉ (⊥ : IntermediateField C F) := by
    intro hmem
    exact hTne (by rw [← hu, differentialAdjoin_singleton_eq_bot_of_mem_bot hmem])
  exact ⟨u, hypertranscendentalOver_of_notMem_bot_of_free hC hy hytop hu0, hu⟩

/-- **Every phase of a nontrivial protocol carries a hypertranscendental coordinate.** -/
theorem exists_nonautonomousTail_hypertranscendental_generator_forall
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    (φ : ℕ → F →ₐ[C] F) (hφ : ∀ i x, φ i x′ = (φ i x)′)
    (hne : ∀ i : ℕ, nonautonomousTail φ i ≠ ⊥) :
    ∀ i : ℕ, ∃ u : F, HypertranscendentalOver C u ∧
      differentialAdjoin C ({u} : Set F) = nonautonomousTail φ i :=
  fun i => exists_nonautonomousTail_hypertranscendental_generator hC hy hytop φ hφ i (hne i)

end

end GaloisForLFunctions.HTGeometry
