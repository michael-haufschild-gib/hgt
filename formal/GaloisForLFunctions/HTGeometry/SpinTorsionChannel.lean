import GaloisForLFunctions.HTGeometry.SuperPoincareSpinor
import GaloisForLFunctions.HTGeometry.SeibergWitten.FlatClifford

/-!
# Spin-torsion channel algebra

The three internal Cartan planes in a six-dimensional chiral spinor contribute the square of the
maximal imaginary bilinear, hence one negative copy of the external channel per plane.  This gives
the channel ratio `1 - 3 = -2`.  The same reduction identifies the one-particle Hartree term with
the Lorentz square of a Weyl-spinor current, so the existing spinor null-cone theorem makes it
vanish exactly.

The final theorem records the same negative Clifford sign in the flat chiral Clifford
representation already present in the corpus.
-/

open Matrix
open scoped ComplexOrder Matrix

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Maximal internal Cartan-plane bilinear on the chiral zero-mode line. -/
def cartanPlaneBilinear : ℂ := Complex.I

/-- Squaring one maximal internal Cartan-plane bilinear reverses the channel sign. -/
theorem cartanPlaneBilinear_sq : cartanPlaneBilinear * cartanPlaneBilinear = -1 := by
  unfold cartanPlaneBilinear
  rw [← pow_two]
  exact Complex.I_sq

/-- One external channel plus `planes` internal channels of the opposite sign. -/
def spinTorsionChannelTrace (external : ℂ) (planes : ℕ) : ℂ :=
  external + planes • (-external)

/-- Closed channel-count formula. -/
theorem spinTorsionChannelTrace_eq (external : ℂ) (planes : ℕ) :
    spinTorsionChannelTrace external planes = (1 - (planes : ℂ)) * external := by
  simp [spinTorsionChannelTrace]
  ring

/-- Three internal Cartan planes turn one external channel into minus twice that channel. -/
theorem spinTorsion_threePlaneChannelTrace (external : ℂ) :
    spinTorsionChannelTrace external 3 = -2 * external := by
  rw [spinTorsionChannelTrace_eq]
  norm_num

/-- Normalized three-plane channel trace.  Bundling the denominator as a unit removes premises. -/
def spinTorsionThreePlaneRatio (external : ℂˣ) : ℂ :=
  spinTorsionChannelTrace (external : ℂ) 3 / (external : ℂ)

/-- The three-plane channel factor is exactly `-2`. -/
theorem spinTorsionThreePlaneRatio_eq (external : ℂˣ) :
    spinTorsionThreePlaneRatio external = -2 := by
  rw [spinTorsionThreePlaneRatio, spinTorsion_threePlaneChannelTrace]
  field_simp

/-- Lorentz contraction of the current generated by one Weyl spinor. -/
def weylHartreeSelfContraction (psi : Fin 2 → ℂ) : ℝ :=
  higgsSpinorTime psi ^ 2 - higgsSpinorX psi ^ 2 -
    higgsSpinorY psi ^ 2 - higgsSpinorZ psi ^ 2

/-- A one-particle chiral Hartree current is lightlike, so its self-contraction vanishes. -/
theorem weylHartreeSelfContraction_eq_zero (psi : Fin 2 → ℂ) :
    weylHartreeSelfContraction psi = 0 := by
  exact (weylSuperMomentum_future_null psi).2

namespace SeibergWitten

/-- Same-direction chiral Clifford composition is minus the Euclidean norm square. -/
theorem flatClifford_sameDirection_positive (v : FourSpace) :
    (flatCliffordMinus v).comp (flatCliffordPlus v) =
      ((-inner ℝ v v : ℝ) : ℂ) • LinearMap.id := by
  have h := flatClifford_positive_relation v v
  apply LinearMap.ext
  intro psi
  have hp := LinearMap.congr_fun h psi
  ext i
  have hi := congrFun hp i
  simp only [LinearMap.add_apply, LinearMap.comp_apply, LinearMap.smul_apply,
    LinearMap.id_apply, Pi.add_apply, Pi.smul_apply] at hi ⊢
  simp only [smul_eq_mul] at hi ⊢
  push_cast at hi ⊢
  linear_combination (1 / 2 : ℂ) * hi

end SeibergWitten
end GaloisForLFunctions.HTGeometry
