/-- **A structural translation moves a generator inside the generated field.** -/
theorem sineFacePacketUnion_translate_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (q : ι) (hS : ∀ L ∈ S, q ∉ L → insert q L ∈ S)
    (hS2 : ∀ L ∈ S, 2 ≤ (Lᶜ : Finset ι).card)
    {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ sineFacePacketUnion ω hω S) :
    addTranslationMeroEquiv (ω q) y
      ∈ differentialAdjoin meromorphicRationalCoordinateField (sineFacePacketUnion ω hω S) := by
  classical
  obtain ⟨L, hL, hyL⟩ := Set.mem_iUnion₂.mp hy
  by_cases hq : q ∈ L
  · exact subset_differentialAdjoin meromorphicRationalCoordinateField _
      (Set.mem_iUnion₂.mpr ⟨L, hL, facePacket_translate_mem ω hω hq hyL⟩)
  · obtain ⟨d, hd, r, hr, hstep⟩ :=
      facePacket_offFace_translate_sub_mem ω hω hq (hS2 L hL) hyL
    have hyK : y ∈ differentialAdjoin meromorphicRationalCoordinateField
        (sineFacePacketUnion ω hω S) :=
      subset_differentialAdjoin meromorphicRationalCoordinateField _
        (Set.mem_iUnion₂.mpr ⟨L, hL, hyL⟩)
    have hdK : d ∈ differentialAdjoin meromorphicRationalCoordinateField
        (sineFacePacketUnion ω hω S) :=
      subset_differentialAdjoin meromorphicRationalCoordinateField _
        (Set.mem_iUnion₂.mpr ⟨insert q L, hS L hL hq, hd⟩)
    have hrK := mem_differentialAdjoin_rationalBase (sineFacePacketUnion ω hω S) hr
    have hval : addTranslationMeroEquiv (ω q) y = y + r - d := by
      linear_combination hstep
    rw [hval]
    exact (differentialAdjoin meromorphicRationalCoordinateField
      (sineFacePacketUnion ω hω S)).sub_mem
      ((differentialAdjoin meromorphicRationalCoordinateField
        (sineFacePacketUnion ω hω S)).add_mem hyK hrK) hdK

