noncomputable local instance msftDecidableEq :
    DecidableEq (meroField (Set.univ : Set ℂ)) := Classical.decEq _

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- A slice of a packet is part of the packet. -/
theorem facePacketSlice_subset_facePacket (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    (J : Finset ι) (q : ι) : facePacketSlice ω hω J q ⊆ facePacket ω hω J := by
  classical
  by_cases h : (Jᶜ : Finset ι).Nonempty
  · rw [facePacketSlice_eq ω hω q h, facePacket_eq ω hω h]
    rintro x ⟨α, -, rfl⟩
    exact ⟨α, rfl⟩
  · rw [facePacketSlice, dif_neg h]
    exact Set.empty_subset _

/-- **A surviving direction moves a packet element into the deeper field.**  The translation defect
of a packet element in a direction outside its face is its displacement into the next packet, up to
the rational coordinate field. -/
theorem facePacket_offFace_translate_sub_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {J : Finset ι} {q : ι} (hq : q ∉ J) (h2 : 2 ≤ (Jᶜ : Finset ι).card)
    {x : meroField (Set.univ : Set ℂ)} (hx : x ∈ facePacket ω hω J) :
    ∃ d ∈ facePacket ω hω (insert q J), ∃ r ∈ meromorphicRationalCoordinateField,
      addTranslationMeroEquiv (ω q) x - x = r - d := by
  classical
  have hne : (Jᶜ : Finset ι).Nonempty := Finset.card_pos.mp (by omega)
  have hne' : ((insert q J)ᶜ : Finset ι).Nonempty := by
    refine Finset.card_pos.mp ?_
    have hins := Finset.card_insert_of_notMem hq
    have h1 := Finset.card_add_card_compl J
    have h2' := Finset.card_add_card_compl (insert q J)
    omega
  rw [facePacket_eq ω hω hne] at hx
  obtain ⟨α, rfl⟩ := hx
  refine ⟨faceDisplacement ω hω J q hne' α,
    facePacketSlice_subset_facePacket ω hω (insert q J) q
      (faceDisplacement_mem_slice ω hω hq hne' α),
    addTranslationMeroEquiv (ω q)
        (addTranslationMeroEquiv (faceShift ω J α) (frameSourceMero ω hω (Jᶜ : Finset ι) hne))
      - addTranslationMeroEquiv (faceShift ω J α) (frameSourceMero ω hω (Jᶜ : Finset ι) hne)
      + faceDisplacement ω hω J q hne' α,
    faceDisplacement_primitive ω hω hq h2 hne hne' α, by ring⟩

/-- **A face direction maps the packet into itself, backwards as well.** -/
theorem facePacket_neg_translate_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) {J : Finset ι} {p : ι}
    (hp : p ∈ J) {x : meroField (Set.univ : Set ℂ)} (hx : x ∈ facePacket ω hω J) :
    addTranslationMeroEquiv (-(ω p)) x ∈ facePacket ω hω J := by
  classical
  by_cases h : (Jᶜ : Finset ι).Nonempty
  · rw [facePacket_eq ω hω h] at hx ⊢
    obtain ⟨α, rfl⟩ := hx
    refine ⟨α - unitExp hp, ?_⟩
    show addTranslationMeroEquiv (faceShift ω J (α - unitExp hp))
        (frameSourceMero ω hω (Jᶜ : Finset ι) h)
      = addTranslationMeroEquiv (-(ω p))
        (addTranslationMeroEquiv (faceShift ω J α) (frameSourceMero ω hω (Jᶜ : Finset ι) h))
    rw [addTranslationMeroEquiv_add]
    have hsum : faceShift ω J (α - unitExp hp) + ω p = faceShift ω J α := by
      rw [← faceShift_unitExp ω hp, ← faceShift_add]
      congr 1
      exact sub_add_cancel _ _
    have harg : faceShift ω J (α - unitExp hp) = -(ω p) + faceShift ω J α := by
      rw [← hsum]
      ring
    exact congrArg (fun t => addTranslationMeroEquiv t
      (frameSourceMero ω hω (Jᶜ : Finset ι) h)) harg
  · rw [facePacket, dif_neg h] at hx
    exact absurd hx (Set.notMem_empty _)

/-- **The backward defect in a surviving direction** also lands in the next packet, up to the
rational coordinate field. -/
theorem facePacket_offFace_neg_translate_sub_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {J : Finset ι} {q : ι} (hq : q ∉ J) (h2 : 2 ≤ (Jᶜ : Finset ι).card)
    {x : meroField (Set.univ : Set ℂ)} (hx : x ∈ facePacket ω hω J) :
    ∃ d ∈ facePacket ω hω (insert q J), ∃ r ∈ meromorphicRationalCoordinateField,
      addTranslationMeroEquiv (-(ω q)) x - x = d - r := by
  classical
  obtain ⟨d, hd, r, hr, hstep⟩ := facePacket_offFace_translate_sub_mem ω hω hq h2 hx
  refine ⟨addTranslationMeroEquiv (-(ω q)) d,
    facePacket_neg_translate_mem ω hω (Finset.mem_insert_self q J) hd,
    addTranslationMeroEquiv (-(ω q)) r,
    addTranslationMeroAlgEquiv_mem_rationalCoordinateField (-(ω q)) hr, ?_⟩
  have hback : addTranslationMeroEquiv (-(ω q))
      (addTranslationMeroEquiv (ω q) x - x) = x - addTranslationMeroEquiv (-(ω q)) x := by
    rw [map_sub, addTranslationMeroEquiv_add, neg_add_cancel, addTranslationMeroEquiv_zero_apply]
  rw [hstep, map_sub] at hback
  linear_combination hback

set_option synthInstance.maxHeartbeats 1000000 in
/-- **Stability from stability on generators, over the rational coordinate base.**  A translation
mapping every generator of a generated differential field into that field maps the whole field into
it. -/
theorem differentialAdjoin_rationalBase_translate_stable_of_generators
    (g : ℂ) (T : Set (meroField (Set.univ : Set ℂ)))
    (hgen : ∀ y ∈ T, addTranslationMeroEquiv g y
      ∈ differentialAdjoin meromorphicRationalCoordinateField T)
    {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin meromorphicRationalCoordinateField T) :
    addTranslationMeroEquiv g x ∈ differentialAdjoin meromorphicRationalCoordinateField T := by
  classical
  let K := differentialAdjoin meromorphicRationalCoordinateField T
  have hKclosed : DerivationClosed K :=
    derivationClosed_differentialAdjoin meromorphicRationalCoordinateField T
  let p : ∀ y : meroField (Set.univ : Set ℂ),
      y ∈ differentialAdjoin meromorphicRationalCoordinateField T → Prop :=
    fun y _ => addTranslationMeroEquiv g y ∈ K
  change p x hx
  refine IntermediateField.adjoin_induction (F := ↥meromorphicRationalCoordinateField)
    (p := p) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨y₀, hy₀, n, rfl⟩
    have hy₀' : addTranslationMeroEquiv g y₀ ∈ K := hgen y₀ hy₀
    have hjet : addTranslationMeroEquiv g (differentialJet n y₀) =
        differentialJet n (addTranslationMeroEquiv g y₀) := by
      simpa using! (addTranslationMeroDifferentialAlgEquiv g).map_differentialJet n y₀
    show addTranslationMeroEquiv g (differentialJet n y₀) ∈ K
    rw [hjet]
    exact hKclosed.differentialJet_mem hy₀' n
  · intro c
    show addTranslationMeroEquiv g _ ∈ K
    have hcF : addTranslationMeroEquiv g (c : meroField (Set.univ : Set ℂ))
        ∈ meromorphicRationalCoordinateField :=
      addTranslationMeroAlgEquiv_mem_rationalCoordinateField g c.2
    exact K.algebraMap_mem
      (⟨addTranslationMeroEquiv g (c : meroField (Set.univ : Set ℂ)), hcF⟩ :
        ↥meromorphicRationalCoordinateField)
  · intro y z _ _ hpy hpz
    show addTranslationMeroEquiv g (y + z) ∈ K
    rw [map_add]
    exact K.add_mem hpy hpz
  · intro y _ hpy
    show addTranslationMeroEquiv g y⁻¹ ∈ K
    rw [map_inv₀]
    exact K.inv_mem hpy
  · intro y z _ _ hpy hpz
    show addTranslationMeroEquiv g (y * z) ∈ K
    rw [map_mul]
    exact K.mul_mem hpy hpz

/-- Membership of the rational coordinate base inside a differential adjunction over it. -/
theorem mem_differentialAdjoin_rationalBase (T : Set (meroField (Set.univ : Set ℂ)))
    {x : meroField (Set.univ : Set ℂ)} (hx : x ∈ meromorphicRationalCoordinateField) :
    x ∈ differentialAdjoin meromorphicRationalCoordinateField T :=
  (differentialAdjoin meromorphicRationalCoordinateField T).algebraMap_mem
    (⟨x, hx⟩ : ↥meromorphicRationalCoordinateField)

