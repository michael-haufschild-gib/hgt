import Mathlib.Algebra.Ring.Basic

/-!
# Algebraic supertranslation certificates

These structures isolate dimensional reductions of the Super-Poincare algebra.  `D1N1` records
one odd generator whose square is translation.  `D1N2` records two odd generators with common
translation and zero mixed anticommutator.  `D1N2Split` allows the two squares to be distinct even
translations.  Associativity forces every recorded translation to commute with the relevant odd
generators; no commutation hypotheses are stored.
-/

namespace SuperPoincare

/-- Supertranslation sector of the one-dimensional `N = 1` Super-Poincare algebra. -/
structure D1N1 (R : Type*) [Monoid R] where
  supercharge : R
  momentum : R
  supercharge_sq : supercharge * supercharge = momentum

namespace D1N1

variable {R : Type*} [Monoid R] (S : D1N1 R)

/-- Translation is central with respect to its generating supercharge. -/
theorem momentum_commutes_supercharge :
    S.momentum * S.supercharge = S.supercharge * S.momentum := by
  rw [← S.supercharge_sq]
  simp only [mul_assoc]

end D1N1

/-- Supertranslation sector of the one-dimensional `N = 2` Super-Poincare algebra. -/
structure D1N2 (R : Type*) [Ring R] where
  supercharge0 : R
  supercharge1 : R
  momentum : R
  supercharge0_sq : supercharge0 * supercharge0 = momentum
  supercharge1_sq : supercharge1 * supercharge1 = momentum
  mixed_anticommutator :
    supercharge0 * supercharge1 + supercharge1 * supercharge0 = 0

namespace D1N2

variable {R : Type*} [Ring R] (S : D1N2 R)

/-- Common translation commutes with the first supercharge. -/
theorem momentum_commutes_supercharge0 :
    S.momentum * S.supercharge0 = S.supercharge0 * S.momentum := by
  rw [← S.supercharge0_sq]
  simp only [mul_assoc]

/-- Common translation commutes with the second supercharge. -/
theorem momentum_commutes_supercharge1 :
    S.momentum * S.supercharge1 = S.supercharge1 * S.momentum := by
  rw [← S.supercharge1_sq]
  simp only [mul_assoc]

end D1N2

/-- `N = 2` supertranslation sector whose two diagonal momenta may differ. -/
structure D1N2Split (R : Type*) [Ring R] where
  supercharge0 : R
  supercharge1 : R
  mixed_anticommutator :
    supercharge0 * supercharge1 + supercharge1 * supercharge0 = 0

namespace D1N2Split

variable {R : Type*} [Ring R] (S : D1N2Split R)

/-- Even translation generated by the first odd generator. -/
def momentum0 : R := S.supercharge0 * S.supercharge0

/-- Even translation generated by the second odd generator. -/
def momentum1 : R := S.supercharge1 * S.supercharge1

theorem momentum0_commutes_supercharge0 :
    S.momentum0 * S.supercharge0 = S.supercharge0 * S.momentum0 := by
  simp only [momentum0, mul_assoc]

theorem momentum1_commutes_supercharge1 :
    S.momentum1 * S.supercharge1 = S.supercharge1 * S.momentum1 := by
  simp only [momentum1, mul_assoc]

/-- Anticommutation makes the first even translation commute with the other supercharge. -/
theorem momentum0_commutes_supercharge1 :
    S.momentum0 * S.supercharge1 = S.supercharge1 * S.momentum0 := by
  dsimp only [momentum0]
  have h01 : S.supercharge0 * S.supercharge1 =
      -(S.supercharge1 * S.supercharge0) :=
    eq_neg_iff_add_eq_zero.mpr S.mixed_anticommutator
  calc
    (S.supercharge0 * S.supercharge0) * S.supercharge1 =
        S.supercharge0 * (S.supercharge0 * S.supercharge1) := mul_assoc _ _ _
    _ = S.supercharge0 * (-(S.supercharge1 * S.supercharge0)) := by rw [h01]
    _ = -(S.supercharge0 * (S.supercharge1 * S.supercharge0)) := mul_neg _ _
    _ = -((S.supercharge0 * S.supercharge1) * S.supercharge0) := by
      rw [mul_assoc]
    _ = -((-(S.supercharge1 * S.supercharge0)) * S.supercharge0) := by rw [h01]
    _ = (S.supercharge1 * S.supercharge0) * S.supercharge0 := by simp
    _ = S.supercharge1 * (S.supercharge0 * S.supercharge0) := mul_assoc _ _ _

/-- Anticommutation makes the second even translation commute with the other supercharge. -/
theorem momentum1_commutes_supercharge0 :
    S.momentum1 * S.supercharge0 = S.supercharge0 * S.momentum1 := by
  dsimp only [momentum1]
  have hmixed : S.supercharge1 * S.supercharge0 +
      S.supercharge0 * S.supercharge1 = 0 := by
    simpa only [add_comm] using S.mixed_anticommutator
  have h10 : S.supercharge1 * S.supercharge0 =
      -(S.supercharge0 * S.supercharge1) :=
    eq_neg_iff_add_eq_zero.mpr hmixed
  calc
    (S.supercharge1 * S.supercharge1) * S.supercharge0 =
        S.supercharge1 * (S.supercharge1 * S.supercharge0) := mul_assoc _ _ _
    _ = S.supercharge1 * (-(S.supercharge0 * S.supercharge1)) := by rw [h10]
    _ = -(S.supercharge1 * (S.supercharge0 * S.supercharge1)) := mul_neg _ _
    _ = -((S.supercharge1 * S.supercharge0) * S.supercharge1) := by
      rw [mul_assoc]
    _ = -((-(S.supercharge0 * S.supercharge1)) * S.supercharge1) := by rw [h10]
    _ = (S.supercharge0 * S.supercharge1) * S.supercharge1 := by simp
    _ = S.supercharge0 * (S.supercharge1 * S.supercharge1) := mul_assoc _ _ _

/-- Convert a multiplicative anticommutation equation into a split certificate. -/
def ofEqNeg (q0 q1 : R) (h : q0 * q1 = -(q1 * q0)) : D1N2Split R where
  supercharge0 := q0
  supercharge1 := q1
  mixed_anticommutator := by rw [h]; exact neg_add_cancel _

/-- Equal diagonal momenta collapse a split certificate to ordinary `N = 2`. -/
def toD1N2 (h : S.momentum0 = S.momentum1) : D1N2 R where
  supercharge0 := S.supercharge0
  supercharge1 := S.supercharge1
  momentum := S.momentum0
  supercharge0_sq := rfl
  supercharge1_sq := h.symm
  mixed_anticommutator := S.mixed_anticommutator

end D1N2Split

end SuperPoincare
