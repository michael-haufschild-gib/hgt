import GaloisForLFunctions.HTGeometry.DoubleSineRationalBaseMatroid

/-!
# The two-cylinder image is differentially algebraic over the constants

The two-cylinder function field embeds into the global meromorphic field as the subfield generated
by the two exponential gauges.  Each gauge is an eigenvector of differentiation, hence
differentially algebraic over `ℂ`, and the whole image lies in the field they generate.  So every
element of the image satisfies an algebraic differential equation with constant coefficients.

This is the fact that turns the one-sided orbit statement over `ℂ(z)` into a two-sided count:
translates whose shifts share a class differ by an element of the image, and are therefore
differentially dependent over any base containing the constants.
-/

open Filter Set Topology Complex
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

local instance tciDomain : IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance tciComplexAlgebra : Algebra ℂ (meroField (Set.univ : Set ℂ)) :=
  ((algebraMap (analyticSubring (Set.univ : Set ℂ)) (meroField Set.univ)).comp
    (constToAnalytic Set.univ)).toAlgebra

local instance tciMeroDifferential : Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance tciMeroCharZero : CharZero (meroField (Set.univ : Set ℂ)) :=
  charZero_of_injective_algebraMap
    (algebraMap ℂ (meroField (Set.univ : Set ℂ))).injective

local instance tciComplexDifferential : Differential ℂ where
  deriv := 0

local instance tciComplexDifferentialAlgebra :
    DifferentialAlgebra ℂ (meroField (Set.univ : Set ℂ)) :=
  ⟨fun c => by
    rw [deriv_algebraMap_complex_mero]
    change (0 : meroField (Set.univ : Set ℂ)) = algebraMap ℂ (meroField Set.univ) 0
    rw [map_zero]⟩

variable {l : Fin 2 → ℂ}

/-! ### The gauge field -/

/-- Every meromorphic exponential gauge is differentially algebraic over the constants. -/
theorem differentialAlgebraicOver_complex_physicalExponentialMero (lam : ℂ) :
    DifferentialAlgebraicOver ℂ (physicalExponentialMero lam) :=
  differentialAlgebraicOver_of_deriv_eq_base_mul lam (physicalExponentialMero_deriv lam)

/-- The subfield of the meromorphic field generated by the two exponential gauges. -/
def cylinderGaugeField (l : Fin 2 → ℂ) : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
  IntermediateField.adjoin ℂ
    {physicalExponentialMero (l 0), physicalExponentialMero (l 1)}

theorem physicalExponentialMero_zero_mem_cylinderGaugeField :
    physicalExponentialMero (l 0) ∈ cylinderGaugeField l :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

theorem physicalExponentialMero_one_mem_cylinderGaugeField :
    physicalExponentialMero (l 1) ∈ cylinderGaugeField l :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ rfl)

/-- Polynomial expressions in a gauge stay inside the gauge field. -/
theorem aeval_physicalExponentialMero_mem_cylinderGaugeField (i : Fin 2)
    (hmem : physicalExponentialMero (l i) ∈ cylinderGaugeField l) (p : Polynomial ℂ) :
    Polynomial.aeval (physicalExponentialMero (l i)) p ∈ cylinderGaugeField l := by
  have hle : Algebra.adjoin ℂ ({physicalExponentialMero (l i)} : Set (meroField Set.univ))
      ≤ (cylinderGaugeField l).toSubalgebra := by
    refine Algebra.adjoin_le ?_
    rintro x rfl
    exact hmem
  exact hle (Polynomial.aeval_mem_adjoin_singleton ℂ _)

/-- The first cylinder embedding lands in the gauge field. -/
theorem cylinderEmbed_zero_mem_cylinderGaugeField (hl : LinearIndependent ℚ l) (c : RatFunc ℂ) :
    cylinderEmbed hl 0 c ∈ cylinderGaugeField l := by
  refine RatFunc.induction_on (P := fun c => cylinderEmbed hl 0 c ∈ cylinderGaugeField l) c ?_
  intro p q _
  have hdiv : cylinderEmbed hl 0
      ((algebraMap (Polynomial ℂ) (RatFunc ℂ)) p / (algebraMap (Polynomial ℂ) (RatFunc ℂ)) q)
      = Polynomial.aeval (physicalExponentialMero (l 0)) p /
        Polynomial.aeval (physicalExponentialMero (l 0)) q := by
    simp only [cylinderEmbed, RatFunc.liftAlgHom_apply_div]
  rw [hdiv]
  exact div_mem
    (aeval_physicalExponentialMero_mem_cylinderGaugeField 0
      physicalExponentialMero_zero_mem_cylinderGaugeField p)
    (aeval_physicalExponentialMero_mem_cylinderGaugeField 0
      physicalExponentialMero_zero_mem_cylinderGaugeField q)

/-- Evaluation of a two-cylinder numerator lands in the gauge field. -/
theorem eval₂_twoCylinder_mem_cylinderGaugeField (hl : LinearIndependent ℚ l)
    (p : Polynomial (RatFunc ℂ)) :
    Polynomial.eval₂ (cylinderEmbed hl 0).toRingHom (physicalExponentialMero (l 1)) p
      ∈ cylinderGaugeField l := by
  refine Polynomial.induction_on' p ?_ ?_
  · intro f g hf hg
    rw [Polynomial.eval₂_add]
    exact add_mem hf hg
  · intro n a
    rw [Polynomial.eval₂_monomial]
    exact mul_mem (cylinderEmbed_zero_mem_cylinderGaugeField hl a)
      (pow_mem physicalExponentialMero_one_mem_cylinderGaugeField n)

/-- **The two-cylinder image lies in the gauge field.** -/
theorem twoCylinderEmbed_mem_cylinderGaugeField (hl : LinearIndependent ℚ l)
    (y : RatFunc (RatFunc ℂ)) :
    twoCylinderEmbed hl y ∈ cylinderGaugeField l := by
  refine RatFunc.induction_on
    (P := fun y => twoCylinderEmbed hl y ∈ cylinderGaugeField l) y ?_
  intro p q _
  rw [twoCylinderEmbed_div]
  exact div_mem (eval₂_twoCylinder_mem_cylinderGaugeField hl p)
    (eval₂_twoCylinder_mem_cylinderGaugeField hl q)

/-! ### Differential algebraicity over the constants -/

set_option synthInstance.maxHeartbeats 1000000 in
/-- **Every element of the two-cylinder image is differentially algebraic over `ℂ`.**  The image
sits in the field generated by two eigenvectors of differentiation, and differential algebraicity
is transitive across a finite family of differentially algebraic generators. -/
theorem differentialAlgebraicOver_complex_twoCylinderEmbed (hl : LinearIndependent ℚ l)
    (y : RatFunc (RatFunc ℂ)) :
    DifferentialAlgebraicOver ℂ (twoCylinderEmbed hl y) := by
  classical
  set u : Fin 2 → meroField (Set.univ : Set ℂ) :=
    ![physicalExponentialMero (l 0), physicalExponentialMero (l 1)] with hudef
  have hu0 : u 0 = physicalExponentialMero (l 0) := by simp [hudef]
  have hu1 : u 1 = physicalExponentialMero (l 1) := by simp [hudef]
  have hrange : Set.range u
      = ({physicalExponentialMero (l 0), physicalExponentialMero (l 1)} :
        Set (meroField (Set.univ : Set ℂ))) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      have : i = 0 ∨ i = 1 := by omega
      rcases this with h | h
      · exact Or.inl (by rw [h, hu0])
      · refine Or.inr ?_
        rw [h, hu1]
        exact Set.mem_singleton _
    · rintro (rfl | hx)
      · exact ⟨0, hu0⟩
      · rw [Set.mem_singleton_iff] at hx
        exact ⟨1, by rw [hu1, hx]⟩
  refine differentialAlgebraicOver_trans_finite_nonempty u ?_ _ ?_
  · intro i
    have : i = 0 ∨ i = 1 := by omega
    rcases this with h | h
    · rw [h, hu0]
      exact differentialAlgebraicOver_complex_physicalExponentialMero _
    · rw [h, hu1]
      exact differentialAlgebraicOver_complex_physicalExponentialMero _
  · have hle : cylinderGaugeField l ≤ differentialAdjoin ℂ (Set.range u) := by
      rw [cylinderGaugeField, hrange]
      exact IntermediateField.adjoin_le_iff.2 (subset_differentialAdjoin ℂ _)
    have hmem : twoCylinderEmbed hl y ∈ differentialAdjoin ℂ (Set.range u) :=
      hle (twoCylinderEmbed_mem_cylinderGaugeField hl y)
    exact differentialAlgebraicOver_algebraMap
      (F := ↥(differentialAdjoin ℂ (Set.range u)))
      (E := meroField (Set.univ : Set ℂ)) ⟨twoCylinderEmbed hl y, hmem⟩

end

end GaloisForLFunctions.HTGeometry
