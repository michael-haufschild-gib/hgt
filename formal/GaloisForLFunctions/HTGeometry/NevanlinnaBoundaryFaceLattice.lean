import GaloisForLFunctions.HTGeometry.NevanlinnaConstraintProjector
import GaloisForLFunctions.HTGeometry.ProjectiveSingularContinuousResidual

/-!
# The closed-face lattice of a separated Nevanlinna boundary

Closed subsets of the projective parameter line determine the probability laws carried by those
subsets.  Exact label recovery transports this lattice faithfully into the carrier simplex.  The
construction uses conull support, so it does not depend on a choice of density or coordinates.
-/

namespace GaloisForLFunctions.HTGeometry

open MeasureTheory OnePoint Set
open TopologicalSpace
open scoped OnePoint ENNReal

noncomputable section

/-- Probability laws carried by a parameter subset. -/
def probabilityLawsCarriedBy {X : Type*} [MeasurableSpace X]
    (K : Set X) : Set (ProbabilityMeasure X) :=
  {eta | (eta : Measure X) Kᶜ = 0}

theorem mem_probabilityLawsCarriedBy {X : Type*} [MeasurableSpace X]
    {K : Set X} {eta : ProbabilityMeasure X} :
    eta ∈ probabilityLawsCarriedBy K ↔ (eta : Measure X) Kᶜ = 0 :=
  Iff.rfl

/-- Laws carried by a closed set form a weakly closed subset of the probability space. -/
theorem probabilityLawsCarriedBy_isClosed
    {X : Type*} [MeasurableSpace X] [MetricSpace X] [OpensMeasurableSpace X]
    (K : Set X) (hK : IsClosed K) :
    IsClosed (probabilityLawsCarriedBy K) := by
  have hset : probabilityLawsCarriedBy K = (closedMassBelow K 1)ᶜ := by
    ext eta
    simp only [mem_probabilityLawsCarriedBy, mem_compl_iff]
    change ((eta : Measure X) Kᶜ = 0 ↔ ¬ (eta : Measure X) K < 1)
    constructor
    · intro hcarried hlt
      have hmass := measure_of_measure_compl_eq_zero hcarried
      rw [show (eta : Measure X) Set.univ = 1 from eta.prop.measure_univ] at hmass
      exact (not_lt_of_ge hmass.ge) hlt
    · intro hnot
      have hle : (eta : Measure X) K ≤ 1 := by
        rw [← eta.prop.measure_univ]
        exact measure_mono (subset_univ K : K ⊆ (Set.univ : Set X))
      have hone : (eta : Measure X) K = 1 :=
        le_antisymm hle (le_of_not_gt hnot)
      have huniv : (eta : Measure X) Set.univ = 1 := eta.prop.measure_univ
      rw [measure_compl hK.measurableSet (measure_ne_top _ _), huniv, hone]
      simp
  rw [hset]
  exact (closedMassBelow_isOpen K hK 1).isClosed_compl

/-- Carried-law sets are monotone in their carrier subset. -/
theorem probabilityLawsCarriedBy_mono {X : Type*} [MeasurableSpace X]
    {K L : Set X} (hKL : K ⊆ L) :
    probabilityLawsCarriedBy K ⊆ probabilityLawsCarriedBy L := by
  intro eta heta
  exact measure_mono_null (compl_subset_compl.mpr hKL) heta

/-- The carried-law construction preserves binary intersections exactly. -/
theorem probabilityLawsCarriedBy_inter {X : Type*} [MeasurableSpace X]
    (K L : Set X) :
    probabilityLawsCarriedBy (K ∩ L) =
      probabilityLawsCarriedBy K ∩ probabilityLawsCarriedBy L := by
  ext eta
  constructor
  · intro h
    constructor
    · exact measure_mono_null (by
        intro x hx
        simp only [mem_compl_iff, mem_inter_iff, not_and_or]
        exact Or.inl hx) h
    · exact measure_mono_null (by
        intro x hx
        simp only [mem_compl_iff, mem_inter_iff, not_and_or]
        exact Or.inr hx) h
  · rintro ⟨hK, hL⟩
    change (eta : Measure X) (K ∩ L)ᶜ = 0
    rw [compl_inter]
    exact measure_union_null hK hL

/-- On closed subsets, the carried-law construction reflects inclusion. -/
theorem probabilityLawsCarriedBy_subset_iff
    {X : Type*} [MeasurableSpace X] [TopologicalSpace X] [BorelSpace X]
    {K L : Set X} (_hK : IsClosed K) (hL : IsClosed L) :
    probabilityLawsCarriedBy K ⊆ probabilityLawsCarriedBy L ↔ K ⊆ L := by
  constructor
  · intro h x hxK
    let eta : ProbabilityMeasure X :=
      ⟨Measure.dirac x, Measure.dirac.isProbabilityMeasure⟩
    have hetaK : eta ∈ probabilityLawsCarriedBy K := by
      change Measure.dirac x Kᶜ = 0
      rw [Measure.dirac_apply' _ _hK.measurableSet.compl]
      simp [hxK]
    have hetaL := h hetaK
    change Measure.dirac x Lᶜ = 0 at hetaL
    by_contra hxL
    have hxLc : x ∈ Lᶜ := by simpa using hxL
    rw [Measure.dirac_apply' _ hL.measurableSet.compl] at hetaL
    simp [hxLc] at hetaL
  · exact probabilityLawsCarriedBy_mono

namespace NevanlinnaBoundaryFamily

variable {s : ℕ → ℝ} (F : NevanlinnaBoundaryFamily s)

local instance onePointRealMetrizableSpace : MetrizableSpace (OnePoint ℝ) :=
  onePointRealSphereHomeomorph.isEmbedding.metrizableSpace

local instance onePointRealMetricSpace : MetricSpace (OnePoint ℝ) :=
  TopologicalSpace.metrizableSpaceMetric (OnePoint ℝ)

/-- The carrier face generated by projective laws carried by `K`. -/
def boundaryCarrierFace (K : Set (OnePoint ℝ)) : Set (ProbabilityMeasure ℝ) :=
  F.barycenter '' probabilityLawsCarriedBy K

/-- Every closed projective subset produces a weakly closed carrier face. -/
theorem boundaryCarrierFace_isClosed (K : Set (OnePoint ℝ)) (hK : IsClosed K) :
    IsClosed (F.boundaryCarrierFace K) := by
  exact F.barycenter_isClosedEmbedding.isClosedMap _
    (probabilityLawsCarriedBy_isClosed K hK)

/-- The carrier-face construction is monotone. -/
theorem boundaryCarrierFace_mono {K L : Set (OnePoint ℝ)} (hKL : K ⊆ L) :
    F.boundaryCarrierFace K ⊆ F.boundaryCarrierFace L := by
  rintro _ ⟨eta, heta, rfl⟩
  exact ⟨eta, probabilityLawsCarriedBy_mono hKL heta, rfl⟩

/-- Exact projective label recovery makes the carrier-face construction preserve intersections. -/
theorem boundaryCarrierFace_inter (K L : Set (OnePoint ℝ)) :
    F.boundaryCarrierFace (K ∩ L) =
      F.boundaryCarrierFace K ∩ F.boundaryCarrierFace L := by
  ext nu
  constructor
  · rintro ⟨eta, heta, rfl⟩
    rw [probabilityLawsCarriedBy_inter] at heta
    exact ⟨⟨eta, heta.1, rfl⟩, ⟨eta, heta.2, rfl⟩⟩
  · rintro ⟨⟨eta, heta, hnu⟩, ⟨theta, htheta, hnu'⟩⟩
    have het : eta = theta := F.barycenter_isClosedEmbedding.injective (hnu.trans hnu'.symm)
    subst theta
    refine ⟨eta, ?_, hnu⟩
    rw [probabilityLawsCarriedBy_inter]
    exact ⟨heta, htheta⟩

/-- On closed projective subsets, carrier-face inclusion is equivalent to subset inclusion. -/
theorem boundaryCarrierFace_subset_iff
    {K L : Set (OnePoint ℝ)} (hK : IsClosed K) (hL : IsClosed L) :
    F.boundaryCarrierFace K ⊆ F.boundaryCarrierFace L ↔ K ⊆ L := by
  constructor
  · intro h
    rw [← probabilityLawsCarriedBy_subset_iff hK hL]
    intro eta heta
    have himage : F.barycenter eta ∈ F.boundaryCarrierFace L :=
      h ⟨eta, heta, rfl⟩
    rcases himage with ⟨theta, htheta, heq⟩
    have : eta = theta := F.barycenter_isClosedEmbedding.injective heq.symm
    simpa [this] using htheta
  · exact F.boundaryCarrierFace_mono

/-- Every carrier in every boundary face has the prescribed complete Hamburger moments. -/
theorem boundaryCarrierFace_hasHamburgerMoments
    {K : Set (OnePoint ℝ)} {nu : ProbabilityMeasure ℝ}
    (hnu : nu ∈ F.boundaryCarrierFace K) :
    HasHamburgerMoments s (nu : Measure ℝ) := by
  rcases hnu with ⟨eta, _, rfl⟩
  exact F.barycenter_hasHamburgerMoments eta

end NevanlinnaBoundaryFamily

end

end GaloisForLFunctions.HTGeometry
