import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianMeetEq
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianKernel
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonComplementarity

/-!
# The two opposite projective horizons meet exactly in the Schwarzian field

The horizon at infinity is the field generated by the positive jets of the base coordinate, and the
horizon at zero is the field generated by the positive jets of its reciprocal.  The translation
current annihilates the first and the inversion current annihilates the second, so an observable
seen by both is annihilated by both, hence is a rational function of the Schwarzian and its jets.

Conversely the Schwarzian is visible in each horizon: it is rational in the first three jets of the
base coordinate, and it is unchanged by inversion, so it is equally rational in the first three
jets of the reciprocal.  Both horizons are closed under the derivation, so every jet of the
Schwarzian is visible in both.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {C : Type*} [Field C] [CharZero C]

/-! ## Each horizon is annihilated by its current -/

omit [CharZero C] in
/-- **The translation current annihilates the horizon at infinity.** -/
theorem freeCoordinateDerivation_zero_eq_zero_of_mem_jetTail
    {f : FreeScalarJetField C} (hf : f ∈ jetTailField C (freeCoordinate C ℕ 0) 1) :
    freeCoordinateDerivation C ℕ 0 f = 0 := by
  have hle : jetTailField C (freeCoordinate C ℕ 0) 1 ≤
      derivationEqualizer (freeCoordinateDerivation C ℕ 0) 0 := by
    rw [jetTailField]
    refine adjoin_le_derivationEqualizer ?_
    rintro _ ⟨m, hm, rfl⟩
    simp only [Set.mem_Ici] at hm
    simp only [Derivation.zero_apply, differentialJet_freeCoordinate_zero]
    exact freeCoordinateDerivation_freeCoordinate_of_ne (by omega)
  have h := hle hf
  rwa [mem_derivationEqualizer_iff, Derivation.zero_apply] at h

omit [CharZero C] in
/-- **The inversion current annihilates the horizon at zero.** -/
theorem freeJetFZero_eq_zero_of_mem_jetTail_inv
    {f : FreeScalarJetField C} (hf : f ∈ jetTailField C (freeCoordinate C ℕ 0)⁻¹ 1) :
    freeJetFZero C f = 0 := by
  have hle : jetTailField C (freeCoordinate C ℕ 0)⁻¹ 1 ≤
      derivationEqualizer (freeJetFZero C) 0 := by
    rw [jetTailField]
    refine adjoin_le_derivationEqualizer ?_
    rintro _ ⟨m, hm, rfl⟩
    obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by simp only [Set.mem_Ici] at hm; omega⟩
    rw [Derivation.zero_apply, freeJetFZero_differentialJet_inv_succ]
  have h := hle hf
  rwa [mem_derivationEqualizer_iff, Derivation.zero_apply] at h

/-! ## The easy inclusion -/

omit [CharZero C] in
/-- A horizon is closed under the derivation. -/
theorem jetTailField_one_shift_mem (x : FreeScalarJetField C) {y : FreeScalarJetField C}
    (hy : y ∈ jetTailField C x 1) : freeJetShift C y ∈ jetTailField C x 1 := by
  have hle := adjoin_le_derivationStable (L' := C)
    (S := (fun m => differentialJet m x) '' Set.Ici 1) (D := freeJetShift C) ?_
  · exact (hle hy).2
  rintro _ ⟨m, hm, rfl⟩
  refine ⟨IntermediateField.subset_adjoin _ _ ⟨m, hm, rfl⟩, ?_⟩
  show freeJetShift C (differentialJet m x) ∈ _
  rw [← freeScalarJetField_deriv_apply, ← differentialJet_succ]
  exact IntermediateField.subset_adjoin _ _ ⟨m + 1, by simp only [Set.mem_Ici] at hm ⊢; omega, rfl⟩

omit [CharZero C] in
theorem differentialJet_mem_jetTailField_of_mem {x z : FreeScalarJetField C}
    (hz : z ∈ jetTailField C x 1) (k : ℕ) :
    differentialJet k z ∈ jetTailField C x 1 := by
  induction k with
  | zero => rwa [differentialJet_zero]
  | succ k ih =>
      rw [differentialJet_succ, freeScalarJetField_deriv_apply]
      exact jetTailField_one_shift_mem x ih

/-- **The Schwarzian field is visible in both horizons.** -/
theorem schwarzianDifferentialField_le_jetTail_inf :
    schwarzianDifferentialField C ≤
      jetTailField C (freeCoordinate C ℕ 0) 1 ⊓ jetTailField C (freeCoordinate C ℕ 0)⁻¹ 1 := by
  have hx0 : (freeCoordinate C ℕ 0) ≠ 0 := freeScalarJetCoordinate_ne_zero 0
  have hdx : (freeCoordinate C ℕ 0)′ ≠ 0 := by
    rw [freeScalarJetField_deriv_apply, freeJetShift_freeCoordinate]
    exact freeScalarJetCoordinate_ne_zero 1
  have hinf : freeJetSchwarzian C ∈ jetTailField C (freeCoordinate C ℕ 0) 1 :=
    schwarzian_mem_jetTailField_one C (freeCoordinate C ℕ 0)
  have hzero : freeJetSchwarzian C ∈ jetTailField C (freeCoordinate C ℕ 0)⁻¹ 1 := by
    rw [freeJetSchwarzian, freeJetBase, ← schwarzian_inv (freeCoordinate C ℕ 0) hx0 hdx]
    exact schwarzian_mem_jetTailField_one C (freeCoordinate C ℕ 0)⁻¹
  rw [schwarzianDifferentialField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨k, rfl⟩
  exact ⟨differentialJet_mem_jetTailField_of_mem hinf k,
    differentialJet_mem_jetTailField_of_mem hzero k⟩

/-! ## The exact meet -/

/-- **The exact pairwise meet.**  Two opposite projective horizons of the base jet coordinate meet
exactly in the differential field generated by its Schwarzian. -/
theorem jetTail_inf_eq_schwarzianDifferentialField :
    jetTailField C (freeCoordinate C ℕ 0) 1 ⊓ jetTailField C (freeCoordinate C ℕ 0)⁻¹ 1 =
      schwarzianDifferentialField C := by
  refine le_antisymm (fun f hf => ?_) schwarzianDifferentialField_le_jetTail_inf
  rw [IntermediateField.mem_inf] at hf
  exact mem_schwarzianDifferentialField_of_currents
    (freeCoordinateDerivation_zero_eq_zero_of_mem_jetTail hf.1)
    (freeJetFZero_eq_zero_of_mem_jetTail_inv hf.2)

end

end GaloisForLFunctions.HTGeometry
