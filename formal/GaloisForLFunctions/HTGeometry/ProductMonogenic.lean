import GaloisForLFunctions.HTGeometry.PolynomialShiftSeparation
import GaloisForLFunctions.HTGeometry.ArtinianLocalMonogenic
import Mathlib.RingTheory.Artinian.Ring
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# A finite product of monogenic local algebras is monogenic

Over a field of characteristic zero, a finite product of finite-dimensional **local** algebras, each
generated by one element, is again generated by one element.

The generators cannot simply be assembled: the minimal polynomial of a generator of a local algebra
is a power of one irreducible — the minimal polynomial of the residue — and if two factors have the
same irreducible, the assembled element satisfies a single polynomial of too small a degree.  The
remedy is a shift.  Replacing `γ_i` by `γ_i + n_i·t` changes the irreducible to `h_i(X − n_i·t)`, and
by `exists_shift_separating` a single `t` makes all of them distinct, hence pairwise coprime.  The
Chinese remainder theorem in `κ[X]` then produces, for any prescribed tuple, one polynomial hitting
all components at once.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial IsLocalRing

variable {κ : Type*} [Field κ] [CharZero κ]

/-! ## Shifting the variable is an automorphism -/

/-- Substituting `X − c` for `X` is an algebra automorphism of the polynomial ring. -/
noncomputable def shiftAlgEquiv (c : κ) : κ[X] ≃ₐ[κ] κ[X] :=
  AlgEquiv.ofAlgHom (Polynomial.aeval (X - C c)) (Polynomial.aeval (X + C c))
    (by apply Polynomial.algHom_ext; simp)
    (by apply Polynomial.algHom_ext; simp)

theorem shiftAlgEquiv_apply (c : κ) (p : κ[X]) : shiftAlgEquiv c p = p.comp (X - C c) := rfl

theorem irreducible_comp_sub_C {h : κ[X]} (hirr : Irreducible h) (c : κ) :
    Irreducible (h.comp (X - C c)) := by
  rw [← shiftAlgEquiv_apply c h]
  exact (MulEquiv.irreducible_iff (shiftAlgEquiv c).toMulEquiv).mpr hirr

/-! ## Translating a generator -/

theorem adjoin_add_algebraMap {A : Type*} [CommRing A] [Algebra κ A] (γ : A) (c : κ) :
    Algebra.adjoin κ ({γ + algebraMap κ A c} : Set A) = Algebra.adjoin κ ({γ} : Set A) := by
  have hback : γ ∈ Algebra.adjoin κ ({γ + algebraMap κ A c} : Set A) := by
    have hmem : (γ + algebraMap κ A c) - algebraMap κ A c
        ∈ Algebra.adjoin κ ({γ + algebraMap κ A c} : Set A) :=
      Subalgebra.sub_mem _ (Algebra.self_mem_adjoin_singleton κ _)
        (Subalgebra.algebraMap_mem _ c)
    simpa using hmem
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact Subalgebra.add_mem _ (Algebra.self_mem_adjoin_singleton κ γ)
      (Subalgebra.algebraMap_mem _ c)
  · rintro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact hback

/-! ## The product -/

/-- **A finite product of monogenic finite-dimensional local algebras is monogenic.** -/
theorem exists_adjoin_pi_eq_top {ι : Type*} [Fintype ι] (A : ι → Type*)
    [∀ i, CommRing (A i)] [∀ i, IsLocalRing (A i)] [∀ i, Algebra κ (A i)]
    [∀ i, FiniteDimensional κ (A i)]
    (hnilp : ∀ i, ∃ N : ℕ, (maximalIdeal (A i)) ^ N = ⊥)
    (hmono : ∀ i, ∃ γ : A i, Algebra.adjoin κ ({γ} : Set (A i)) = ⊤) :
    ∃ α : (∀ i, A i), Algebra.adjoin κ ({α} : Set (∀ i, A i)) = ⊤ := by
  classical
  choose γ hγ using hmono
  have hint : ∀ i, IsIntegral κ (γ i) := fun i => IsIntegral.of_finite κ (γ i)
  have hintθ : ∀ i, IsIntegral κ (residue (A i) (γ i)) := fun i =>
    (hint i).map (IsScalarTower.toAlgHom κ (A i) (ResidueField (A i)))
  set h : ι → κ[X] := fun i => minpoly κ (residue (A i) (γ i)) with hhdef
  have hirr : ∀ i, Irreducible (h i) := fun i => minpoly.irreducible (hintθ i)
  have hmonic : ∀ i, (h i).Monic := fun i => minpoly.monic (hintθ i)
  have hdeg : ∀ i, 0 < (h i).natDegree := fun i => minpoly.natDegree_pos (hintθ i)
  -- an injection of the index set into the field
  set n : ι → κ := fun i => ((Fintype.equivFin ι i : ℕ) : κ) with hndef
  have hn : Function.Injective n := by
    intro i j hij
    have h1 : ((Fintype.equivFin ι i : ℕ) : κ) = ((Fintype.equivFin ι j : ℕ) : κ) := hij
    have h2 : (Fintype.equivFin ι i : ℕ) = (Fintype.equivFin ι j : ℕ) := by exact_mod_cast h1
    exact (Fintype.equivFin ι).injective (Fin.val_injective h2)
  obtain ⟨t, hsep⟩ := exists_shift_separating h hdeg n hn
  set c : ι → κ := fun i => n i * t with hcdef
  set α : (∀ i, A i) := fun i => γ i + algebraMap κ (A i) (c i) with hαdef
  set H : ι → κ[X] := fun i => (h i).comp (X - C (c i)) with hHdef
  have hHirr : ∀ i, Irreducible (H i) := fun i => irreducible_comp_sub_C (hirr i) (c i)
  have hHmonic : ∀ i, (H i).Monic := fun i =>
    (hmonic i).comp (monic_X_sub_C _) (by simp)
  have hHcop : ∀ i j, i ≠ j → IsCoprime (H i) (H j) := by
    intro i j hij
    rw [Irreducible.coprime_iff_not_dvd (hHirr i)]
    intro hdvd
    exact hsep i j hij (Polynomial.eq_of_monic_of_associated (hHmonic i) (hHmonic j)
      ((Irreducible.dvd_irreducible_iff_associated (hHirr i) (hHirr j)).mp hdvd))
  -- the maximal ideals are nilpotent
  choose N hN using hnilp
  have hkill : ∀ i, Polynomial.aeval (α i) (H i ^ N i) = 0 := by
    intro i
    have hx : Polynomial.aeval (α i) (X - C (c i)) = γ i := by
      simp [hαdef]
    have h1 : Polynomial.aeval (α i) (H i) = Polynomial.aeval (γ i) (h i) := by
      rw [hHdef, Polynomial.aeval_comp, hx]
    have hmem : Polynomial.aeval (γ i) (h i) ∈ maximalIdeal (A i) := by
      refine mem_maximalIdeal_iff_residue_eq_zero.mpr ?_
      rw [residue_aeval, hhdef, minpoly.aeval]
    have hpow := Ideal.pow_mem_pow hmem (N i)
    rw [hN i, Ideal.mem_bot] at hpow
    rw [map_pow, h1, hpow]
  -- each component is reachable
  have hcomp : ∀ i (a : A i), ∃ q : κ[X], Polynomial.aeval (α i) q = a := by
    intro i a
    have htop : Algebra.adjoin κ ({α i} : Set (A i)) = ⊤ := by
      rw [hαdef, adjoin_add_algebraMap, hγ i]
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top] at htop
    exact htop a
  refine ⟨α, ?_⟩
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top]
  intro a
  choose q hq using fun i => hcomp i (a i)
  -- the Chinese remainder theorem
  set I : ι → Ideal κ[X] := fun i => Ideal.span {H i ^ N i} with hIdef
  have hIcop : Pairwise (Function.onFun IsCoprime I) := by
    intro i j hij
    rw [hIdef]
    exact (Ideal.isCoprime_span_singleton_iff _ _).mpr ((hHcop i j hij).pow)
  obtain ⟨x, hx⟩ := (Ideal.quotientInfRingEquivPiQuotient I hIcop).surjective
    (fun i => Ideal.Quotient.mk (I i) (q i))
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨r, ?_⟩
  funext i
  have hxi : Ideal.Quotient.mk (I i) r = Ideal.Quotient.mk (I i) (q i) :=
    congrFun hx i
  have hsub : r - q i ∈ I i := Ideal.Quotient.eq.mp hxi
  rw [hIdef, Ideal.mem_span_singleton] at hsub
  obtain ⟨s, hs⟩ := hsub
  have heval : Polynomial.aeval (α i) r = Polynomial.aeval (α i) (q i) := by
    have h0 : Polynomial.aeval (α i) (r - q i) = 0 := by
      rw [hs, map_mul, hkill i, zero_mul]
    rw [map_sub] at h0
    exact sub_eq_zero.mp h0
  have hpi : (Polynomial.aeval α r : ∀ j, A j) i = Polynomial.aeval (α i) r :=
    (Polynomial.aeval_algHom_apply (Pi.evalAlgHom κ A i) α r).symm
  rw [hpi, heval, hq i]

end GaloisForLFunctions.HTGeometry
