namespace GaloisForLFunctions.HTGeometry

namespace CircuitAdjoin

/-- **Universal finite-matrix generation bound.**  Every finite square matrix is generated by at
most one generator per entry. -/
theorem generatedBy_card_sq
    {K L n : Type} [Field K] [CommRing L] [Algebra K L]
    [Fintype n] [DecidableEq n] (M : Matrix n n L) :
    GeneratedBy K (Fintype.card n * Fintype.card n) M := by
  classical
  let e : Fin (Fintype.card (n × n)) ≃ n × n := (Fintype.equivFin (n × n)).symm
  have hcard : Fintype.card (n × n) = Fintype.card n * Fintype.card n :=
    Fintype.card_prod n n
  rw [← hcard]
  refine ⟨fun t => M (e t).1 (e t).2, ?_⟩
  intro i j
  apply Algebra.subset_adjoin
  refine ⟨(Fintype.equivFin (n × n)) (i, j), ?_⟩
  simp [e]

end CircuitAdjoin

namespace ControlledNaturalityMechanics

/-- Identity is an equivariant reporter for every action. -/
theorem equivariantReporter_id
    {G X : Type*} [Group G] [MulAction G X] :
    EquivariantReporter (G := G) (id : X → X) := by
  intro g x
  rfl

/-- A constant reporter is equivariant when its value is globally fixed. -/
theorem equivariantReporter_const_of_fixed
    {G X Z : Type*} [Group G] [MulAction G X] [MulAction G Z]
    {z : Z} (hz : ∀ g : G, g • z = z) :
    EquivariantReporter (G := G) (fun _ : X => z) := by
  intro g x
  exact (hz g).symm

/-- Equivariant reporters are closed under composition. -/
theorem EquivariantReporter.comp
    {G X Y Z : Type*} [Group G] [MulAction G X] [MulAction G Y] [MulAction G Z]
    {f : X → Y} {g : Y → Z}
    (hg : EquivariantReporter (G := G) g)
    (hf : EquivariantReporter (G := G) f) :
    EquivariantReporter (G := G) (g ∘ f) := by
  intro a x
  change g (f (a • x)) = a • g (f x)
  rw [hf a x, hg a (f x)]

end ControlledNaturalityMechanics

/-- The exact marginal-reset Pythagorean theorem directly realizes a KL repair step. -/
theorem marginalRepair_isKLRepairStep
    {X H : Type*} [MeasurableSpace X] [MeasurableSpace H]
    (μ ν : Measure X) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (κ η : Kernel X H) [IsMarkovKernel κ] [IsMarkovKernel η] :
    IsKLRepairStep (μ ⊗ₘ κ) (ν ⊗ₘ η) (marginalRepair μ η) :=
  klDiv_marginalRepair_pythagorean μ ν κ η

/-- Zero target has an exact positive lift through every linear fracture map. -/
theorem exactPolarizedIncidence_zero
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (C : ProperCone ℝ E) (f : E →L[ℝ] F) :
    ExactPolarizedIncidence C f 0 := by
  exact ⟨0, C.zero_mem, by simp⟩

namespace ComplexSesquilinearForm

/-- Zero operator is formally self-adjoint for every sesquilinear form. -/
theorem isFormallySelfAdjoint_zero
    {V : Type*} [AddCommGroup V] [Module ℂ V] (B : ComplexSesquilinearForm V) :
    B.IsFormallySelfAdjoint (0 : V →ₗ[ℂ] V) := by
  intro x y
  simp

/-- Identity is formally self-adjoint for every sesquilinear form. -/
theorem isFormallySelfAdjoint_id
    {V : Type*} [AddCommGroup V] [Module ℂ V] (B : ComplexSesquilinearForm V) :
    B.IsFormallySelfAdjoint LinearMap.id := by
  intro x y
  rfl

/-- Formally self-adjoint operators are closed under addition. -/
theorem IsFormallySelfAdjoint.add
    {V : Type*} [AddCommGroup V] [Module ℂ V] (B : ComplexSesquilinearForm V)
    {A D : V →ₗ[ℂ] V} (hA : B.IsFormallySelfAdjoint A) (hD : B.IsFormallySelfAdjoint D) :
    B.IsFormallySelfAdjoint (A + D) := by
  intro x y
  simp only [LinearMap.add_apply, map_add]
  rw [hA x y, hD x y]

end ComplexSesquilinearForm

