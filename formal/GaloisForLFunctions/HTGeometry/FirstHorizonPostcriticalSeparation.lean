import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The first postcritical reciprocal coefficient escapes the critical field, at the first horizon

At the first horizon `m = n = 1`, `L = 2`, the critical observation of a jet is the pair
`(x_1, y_1)`, and the new raw coefficient is `x_2`.  The sign flip of the constant term `x_0` fixes
`x_1`, fixes `y_1 = -x_1 x_0^{-2}` because that is even in `x_0`, and fixes `x_2`, but it reverses
the sign of the leading term of `y_2 = x_1^(2 : ℕ) x_0^{-3} - x_2 x_0^{-2}`.

So `y_2` is not a rational function of the critical observation and the new raw coefficient: one
postcritical reciprocal coefficient genuinely leaves the critical field.  This is the first
horizon's instance of the rigidity statement, and it is proved by an automorphism rather than by a
specialisation, which is available here because the critical fibre has exactly two points.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

section FixedField

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- **The fixed field of a single automorphism.** -/
def fixedIntermediateField (σ : E ≃ₐ[F] E) : IntermediateField F E where
  carrier := {x | σ x = x}
  mul_mem' ha hb := by
    simp only [Set.mem_setOf_eq] at *
    rw [map_mul, ha, hb]
  one_mem' := by simp
  add_mem' ha hb := by
    simp only [Set.mem_setOf_eq] at *
    rw [map_add, ha, hb]
  zero_mem' := by simp
  algebraMap_mem' r := by simp
  inv_mem' x hx := by
    simp only [Set.mem_setOf_eq] at *
    rw [map_inv₀, hx]

@[simp] theorem mem_fixedIntermediateField {σ : E ≃ₐ[F] E} {x : E} :
    x ∈ fixedIntermediateField σ ↔ σ x = x := Iff.rfl

/-- **An element moved by an automorphism is not in the field generated by fixed elements.** -/
theorem not_mem_adjoin_of_apply_ne (σ : E ≃ₐ[F] E) {S : Set E} (hS : ∀ s ∈ S, σ s = s) {v : E}
    (hv : σ v ≠ v) : v ∉ IntermediateField.adjoin F S := by
  intro hmem
  have hle : IntermediateField.adjoin F S ≤ fixedIntermediateField σ :=
    IntermediateField.adjoin_le_iff.2 (fun s hs => hS s hs)
  exact hv (hle hmem)

end FixedField

section FirstHorizon

variable (F : Type*) [Field F]

/-- The jet algebra of the first horizon: three free raw coefficients. -/
noncomputable abbrev firstHorizonRing : Type _ := MvPolynomial (Fin 3) F

/-- The field of the first horizon. -/
noncomputable abbrev firstHorizonField : Type _ := FractionRing (MvPolynomial (Fin 3) F)

/-- The raw jet coefficients `x_0, x_1, x_2`. -/
noncomputable def jetX (i : Fin 3) : firstHorizonField F :=
  algebraMap (firstHorizonRing F) (firstHorizonField F) (X i)

theorem jetX_zero_ne_zero : jetX F 0 ≠ 0 := fun hcon =>
  MvPolynomial.X_ne_zero (0 : Fin 3)
    (IsFractionRing.injective (firstHorizonRing F) (firstHorizonField F)
      (by rw [map_zero]; exact hcon))

theorem jetX_one_ne_zero : jetX F 1 ≠ 0 := fun hcon =>
  MvPolynomial.X_ne_zero (1 : Fin 3)
    (IsFractionRing.injective (firstHorizonRing F) (firstHorizonField F)
      (by rw [map_zero]; exact hcon))

/-! ### The reciprocal jet through the first postcritical order -/

/-- The constant coefficient of the reciprocal jet. -/
noncomputable def jetY0 : firstHorizonField F := (jetX F 0)⁻¹

/-- The critical coefficient of the reciprocal jet. -/
noncomputable def jetY1 : firstHorizonField F := -(jetX F 1) / (jetX F 0) ^ (2 : ℕ)

/-- The first postcritical coefficient of the reciprocal jet. -/
noncomputable def jetY2 : firstHorizonField F :=
  (jetX F 1) ^ (2 : ℕ) / (jetX F 0) ^ (3 : ℕ) - (jetX F 2) / (jetX F 0) ^ (2 : ℕ)

theorem jet_reciprocal_zero : jetX F 0 * jetY0 F = 1 := by
  rw [jetY0, mul_inv_cancel₀ (jetX_zero_ne_zero F)]

theorem jet_reciprocal_one : jetX F 0 * jetY1 F + jetX F 1 * jetY0 F = 0 := by
  rw [jetY0, jetY1]
  field_simp
  ring

theorem jet_reciprocal_two :
    jetX F 0 * jetY2 F + jetX F 1 * jetY1 F + jetX F 2 * jetY0 F = 0 := by
  rw [jetY0, jetY1, jetY2]
  field_simp
  ring

/-! ### The sign flip of the constant term -/

/-- The sign flip of the constant raw coefficient, on the jet algebra. -/
noncomputable def signFlipHom : firstHorizonRing F →ₐ[F] firstHorizonRing F :=
  MvPolynomial.aeval ![-(X 0), X 1, X 2]

/-- The sign flip is an involution, hence an automorphism of the jet algebra. -/
noncomputable def signFlipEquiv : firstHorizonRing F ≃ₐ[F] firstHorizonRing F :=
  AlgEquiv.ofAlgHom (signFlipHom F) (signFlipHom F)
    (by
      refine MvPolynomial.algHom_ext (fun i => ?_)
      fin_cases i <;> simp [signFlipHom])
    (by
      refine MvPolynomial.algHom_ext (fun i => ?_)
      fin_cases i <;> simp [signFlipHom])

/-- The sign flip of the constant raw coefficient, on the field of the first horizon. -/
noncomputable def signFlip : firstHorizonField F ≃ₐ[F] firstHorizonField F :=
  IsFractionRing.fieldEquivOfAlgEquiv F (firstHorizonField F) (firstHorizonField F)
    (signFlipEquiv F)

theorem signFlip_jetX (i : Fin 3) :
    signFlip F (jetX F i) =
      algebraMap (firstHorizonRing F) (firstHorizonField F) (![-(X 0), X 1, X 2] i) := by
  rw [jetX, signFlip, IsFractionRing.fieldEquivOfAlgEquiv_algebraMap]
  congr 1
  rw [signFlipEquiv, AlgEquiv.ofAlgHom_apply, signFlipHom, MvPolynomial.aeval_X]

@[simp] theorem signFlip_jetX_zero : signFlip F (jetX F 0) = -(jetX F 0) := by
  rw [signFlip_jetX]
  simp [jetX]

@[simp] theorem signFlip_jetX_one : signFlip F (jetX F 1) = jetX F 1 := by
  rw [signFlip_jetX]
  simp [jetX]

@[simp] theorem signFlip_jetX_two : signFlip F (jetX F 2) = jetX F 2 := by
  rw [signFlip_jetX]
  simp [jetX]

/-- **The critical observation is fixed by the sign flip.**  The critical reciprocal coefficient is
even in the constant term. -/
@[simp] theorem signFlip_jetY1 : signFlip F (jetY1 F) = jetY1 F := by
  rw [jetY1, map_div₀, map_neg, map_pow, signFlip_jetX_one, signFlip_jetX_zero, neg_pow]
  norm_num

/-- **The postcritical reciprocal coefficient is moved by the sign flip.** -/
theorem signFlip_jetY2 :
    signFlip F (jetY2 F) = -((jetX F 1) ^ (2 : ℕ) / (jetX F 0) ^ (3 : ℕ)) - (jetX F 2) / (jetX F 0) ^ (2 : ℕ) := by
  rw [jetY2, map_sub, map_div₀, map_div₀, map_pow, map_pow, map_pow, signFlip_jetX_zero,
    signFlip_jetX_one, signFlip_jetX_two,
    show (-(jetX F 0)) ^ (3 : ℕ) = -((jetX F 0) ^ (3 : ℕ)) by ring,
    show (-(jetX F 0)) ^ (2 : ℕ) = (jetX F 0) ^ (2 : ℕ) by ring, div_neg]

/-- The jet algebra has characteristic zero. -/
instance charZero_firstHorizonRing [CharZero F] : CharZero (firstHorizonRing F) :=
  ⟨fun a b hab => by
    rw [← map_natCast (MvPolynomial.C : F →+* firstHorizonRing F) a,
      ← map_natCast (MvPolynomial.C : F →+* firstHorizonRing F) b] at hab
    exact Nat.cast_injective (MvPolynomial.C_injective (Fin 3) F hab)⟩

/-- The field of the first horizon has characteristic zero. -/
instance charZero_firstHorizonField [CharZero F] : CharZero (firstHorizonField F) :=
  ⟨fun a b hab => by
    have h : ((a : ℕ) : firstHorizonRing F) = ((b : ℕ) : firstHorizonRing F) := by
      refine IsFractionRing.injective (firstHorizonRing F) (firstHorizonField F) ?_
      rw [map_natCast, map_natCast]
      exact hab
    exact Nat.cast_injective h⟩

theorem signFlip_jetY2_ne [CharZero F] : signFlip F (jetY2 F) ≠ jetY2 F := by
  rw [signFlip_jetY2, jetY2]
  intro hcon
  have hsq : (2 : firstHorizonField F) * ((jetX F 1) ^ (2 : ℕ) / (jetX F 0) ^ (3 : ℕ)) = 0 := by
    linear_combination -hcon
  have hne : ((jetX F 1) ^ (2 : ℕ) / (jetX F 0) ^ (3 : ℕ)) ≠ 0 :=
    div_ne_zero (pow_ne_zero _ (jetX_one_ne_zero F)) (pow_ne_zero _ (jetX_zero_ne_zero F))
  exact hne (by
    rcases mul_eq_zero.1 hsq with h | h
    · exact absurd h two_ne_zero
    · exact h)

/-! ### The separation -/

/-- **One postcritical reciprocal coefficient leaves the critical field.**  At the first horizon the
critical observation is `(x_1, y_1)` and the new raw coefficient is `x_2`; the first postcritical
reciprocal coefficient `y_2` is not a rational function of those three.

The witness is the sign flip of the constant raw coefficient, which fixes all three and reverses the
sign of the leading term of `y_2`.  So the critical extension is not resolved by the raw coefficient
alone, and the postcritical reciprocal coefficient is a genuinely new element. -/
theorem jetY2_not_mem_adjoin_critical [CharZero F] :
    jetY2 F ∉ IntermediateField.adjoin F
      ({jetX F 1, jetY1 F, jetX F 2} : Set (firstHorizonField F)) := by
  refine not_mem_adjoin_of_apply_ne (signFlip F) ?_ (signFlip_jetY2_ne F)
  rintro s (rfl | rfl | rfl)
  · exact signFlip_jetX_one F
  · exact signFlip_jetY1 F
  · exact signFlip_jetX_two F

end FirstHorizon

end GaloisForLFunctions.HTGeometry
