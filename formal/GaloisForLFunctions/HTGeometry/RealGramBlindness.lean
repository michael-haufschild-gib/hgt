import Mathlib

/-!
# The real Gram expansion of a weighted energy, and what it cannot see

Fix a finite index set with real weights `mu` and consider the weighted pairing
`⟪v, w⟫ = ∑ p, mu p * v p * conj (w p)` and the energy `E v = Re ⟪v, v⟫`.

For a pair of vectors `v, w` the *conjugate-closed integral span* is the set of vectors
`a • v + b • w + c • conj v + d • conj w` with `a b c d : ℤ`.  The energy of every such vector is an
integer-coefficient combination of exactly six real numbers,

`E v`, `E w`, `Re ⟪v, conj v⟫`, `Re ⟪w, conj w⟫`, `Re ⟪v, w⟫`, `Re ⟪v, conj w⟫`,

and of nothing else.  In particular the imaginary parts `Im ⟪v, w⟫` and `Im ⟪v, conj w⟫` never
occur: the energy functional, evaluated on the whole conjugate-closed integral span, is *blind* to
them.

The relevance is to the Selberg class.  On prime coefficients the multiplication of Dirichlet series
is addition, `a_{FG}(p) = a_F(p) + a_G(p)`, and conjugation of a Dirichlet series conjugates its
coefficients, so the vectors attached to the multiplicative monoid generated by `F`, `G` and their
conjugates are exactly the conjugate-closed integral span of `(a_F(p))_p` and `(a_G(p))_p`.  The
prime energy `∑_{p ≤ x} |a_F(p)|² / p` is the weighted energy with `mu p = 1/p`.  Hence: no identity
among prime energies of elements of the monoid generated by `F`, `G`, `conj F`, `conj G` can
determine `Im ∑_p a_F(p) conj (a_G(p)) / p`.  Any proof that this quantity vanishes — the full
strength of Selberg's orthogonality conjecture for the pair `(F, G)` — must use the analytic axioms,
not only the monoid structure together with the energy functional.

Everything is a finite algebraic identity; no analysis and no hypothesis on `mu` beyond being real.
-/

open Finset Complex

namespace HTGeometry

noncomputable section

/-- The weighted pairing of two coefficient vectors over a finite index set. -/
def wIP (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) : ℂ :=
  ∑ p ∈ s, (mu p : ℂ) * v p * (starRingEnd ℂ) (w p)

/-- The weighted energy of a coefficient vector: the real part of its self-pairing. -/
def wEnergy (mu : ℕ → ℝ) (s : Finset ℕ) (v : ℕ → ℂ) : ℝ := (wIP mu s v v).re

/-- The integer combination `a • v + b • w + c • conj v + d • conj w`. -/
def intComb (a b c d : ℤ) (v w : ℕ → ℂ) : ℕ → ℂ := fun p =>
  (a : ℂ) * v p + (b : ℂ) * w p + (c : ℂ) * (starRingEnd ℂ) (v p)
    + (d : ℂ) * (starRingEnd ℂ) (w p)

/-- Pointwise form of the expansion: the real part of the weighted square of an integer combination
of `x`, `y` and their conjugates involves only the six real quantities
`Re (m x conj x)`, `Re (m y conj y)`, `Re (m x x)`, `Re (m y y)`, `Re (m x conj y)`, `Re (m x y)`. -/
theorem intComb_sq_re (m : ℝ) (x y : ℂ) (a b c d : ℤ) :
    ((m : ℂ) * ((a : ℂ) * x + (b : ℂ) * y + (c : ℂ) * (starRingEnd ℂ) x
        + (d : ℂ) * (starRingEnd ℂ) y)
      * (starRingEnd ℂ) ((a : ℂ) * x + (b : ℂ) * y + (c : ℂ) * (starRingEnd ℂ) x
        + (d : ℂ) * (starRingEnd ℂ) y)).re
      = ((a : ℝ) ^ (2 : ℕ) + (c : ℝ) ^ (2 : ℕ)) * ((m : ℂ) * x * (starRingEnd ℂ) x).re
        + ((b : ℝ) ^ (2 : ℕ) + (d : ℝ) ^ (2 : ℕ)) * ((m : ℂ) * y * (starRingEnd ℂ) y).re
        + 2 * (a : ℝ) * (c : ℝ) * ((m : ℂ) * x * x).re
        + 2 * (b : ℝ) * (d : ℝ) * ((m : ℂ) * y * y).re
        + 2 * ((a : ℝ) * (b : ℝ) + (c : ℝ) * (d : ℝ)) * ((m : ℂ) * x * (starRingEnd ℂ) y).re
        + 2 * ((a : ℝ) * (d : ℝ) + (b : ℝ) * (c : ℝ)) * ((m : ℂ) * x * y).re := by
  simp [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im, Complex.conj_re,
    Complex.conj_im, Complex.ofReal_re, Complex.ofReal_im, Complex.intCast_re,
    Complex.intCast_im]
  ring

/-- **Real Gram expansion.**  The weighted energy of an integer combination of `v`, `w` and their
conjugates is the integer-coefficient combination
`(a²+c²) E v + (b²+d²) E w + 2ac Re⟪v, conj v⟫ + 2bd Re⟪w, conj w⟫
  + 2(ab+cd) Re⟪v, w⟫ + 2(ad+bc) Re⟪v, conj w⟫`
of six real numbers.  No imaginary part of any pairing occurs. -/
theorem wEnergy_intComb (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) (a b c d : ℤ) :
    wEnergy mu s (intComb a b c d v w)
      = ((a : ℝ) ^ (2 : ℕ) + (c : ℝ) ^ (2 : ℕ)) * wEnergy mu s v
        + ((b : ℝ) ^ (2 : ℕ) + (d : ℝ) ^ (2 : ℕ)) * wEnergy mu s w
        + 2 * (a : ℝ) * (c : ℝ) * (wIP mu s v ((starRingEnd ℂ) ∘ v)).re
        + 2 * (b : ℝ) * (d : ℝ) * (wIP mu s w ((starRingEnd ℂ) ∘ w)).re
        + 2 * ((a : ℝ) * (b : ℝ) + (c : ℝ) * (d : ℝ)) * (wIP mu s v w).re
        + 2 * ((a : ℝ) * (d : ℝ) + (b : ℝ) * (c : ℝ))
            * (wIP mu s v ((starRingEnd ℂ) ∘ w)).re := by
  simp only [wEnergy, wIP, intComb, Complex.re_sum, Function.comp_apply,
    Complex.conj_conj]
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [intComb_sq_re (mu p) (v p) (w p) a b c d]

/-- **Blindness of the energy functional.**  If two pairs of vectors have the same six real Gram
entries, then they have the same weighted energy on the *entire* conjugate-closed integral span,
even when the imaginary parts of their pairings differ.  Consequently no relation among the energies
of the span can detect `Im ⟪v, w⟫`. -/
theorem wEnergy_intComb_congr (mu : ℕ → ℝ) (s : Finset ℕ) (v w v' w' : ℕ → ℂ)
    (h1 : wEnergy mu s v = wEnergy mu s v')
    (h2 : wEnergy mu s w = wEnergy mu s w')
    (h3 : (wIP mu s v ((starRingEnd ℂ) ∘ v)).re = (wIP mu s v' ((starRingEnd ℂ) ∘ v')).re)
    (h4 : (wIP mu s w ((starRingEnd ℂ) ∘ w)).re = (wIP mu s w' ((starRingEnd ℂ) ∘ w')).re)
    (h5 : (wIP mu s v w).re = (wIP mu s v' w').re)
    (h6 : (wIP mu s v ((starRingEnd ℂ) ∘ w)).re = (wIP mu s v' ((starRingEnd ℂ) ∘ w')).re)
    (a b c d : ℤ) :
    wEnergy mu s (intComb a b c d v w) = wEnergy mu s (intComb a b c d v' w') := by
  rw [wEnergy_intComb, wEnergy_intComb, h1, h2, h3, h4, h5, h6]

/-- The alternating part of the weighted pairing. -/
def wOmega (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) : ℝ := (wIP mu s v w).im

/-- The weighted pairing is conjugate-symmetric, because the weights are real. -/
theorem wIP_swap (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) :
    wIP mu s w v = (starRingEnd ℂ) (wIP mu s v w) := by
  simp only [wIP, map_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  simp [mul_comm, mul_assoc]

/-- The alternating part is antisymmetric: `wOmega` is an alternating form. -/
theorem wOmega_swap (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) :
    wOmega mu s w v = -wOmega mu s v w := by
  unfold wOmega
  rw [wIP_swap]
  exact Complex.conj_im _

/-- The alternating part vanishes on the diagonal. -/
theorem wOmega_self (mu : ℕ → ℝ) (s : Finset ℕ) (v : ℕ → ℂ) : wOmega mu s v v = 0 := by
  have := wOmega_swap mu s v v
  linarith

/-- Conjugating both vectors reverses the sign of the alternating part: the conjugation involution
acts by `-1` on `wOmega`.  It acts trivially on the energy, which is why no identity among energies
can determine `wOmega`. -/
theorem wOmega_conj (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ) :
    wOmega mu s ((starRingEnd ℂ) ∘ v) ((starRingEnd ℂ) ∘ w) = -wOmega mu s v w := by
  have h : wIP mu s ((starRingEnd ℂ) ∘ v) ((starRingEnd ℂ) ∘ w)
      = (starRingEnd ℂ) (wIP mu s v w) := by
    simp only [wIP, map_sum, Function.comp_apply]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp [mul_comm, mul_assoc]
  unfold wOmega
  rw [h]
  exact Complex.conj_im _

/-- On self-dual data — vectors with real entries — the alternating part vanishes identically. -/
theorem wOmega_eq_zero_of_real (mu : ℕ → ℝ) (s : Finset ℕ) (v w : ℕ → ℂ)
    (hv : ∀ p ∈ s, (v p).im = 0) (hw : ∀ p ∈ s, (w p).im = 0) :
    wOmega mu s v w = 0 := by
  simp only [wOmega, wIP, Complex.im_sum]
  refine Finset.sum_eq_zero fun p hp => ?_
  simp [Complex.mul_im, Complex.mul_re, Complex.conj_re, Complex.conj_im, hv p hp, hw p hp]

end

end HTGeometry
