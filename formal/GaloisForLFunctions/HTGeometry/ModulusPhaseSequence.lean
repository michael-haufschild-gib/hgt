import GaloisForLFunctions.HTGeometry.PrescribedModulusPhases
import GaloisForLFunctions.HTGeometry.TrdegMutuallyAlgebraic
import GaloisForLFunctions.HTGeometry.AlgebraAdjoinAlgebraic

/-!
# A coefficient sequence with prescribed moduli and independent values

Choosing the phases one at a time, each new coefficient transcendental over the field generated by
all previously produced values, gives a sequence with the prescribed moduli whose members indexed by
the support are algebraically independent over `ℚ`.
-/

open Set

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- One step of the construction: a number of modulus `|ρ n|` transcendental over the field
generated by the values of `prev`. -/
private def phaseStep (ρ : ℕ → ℝ) (n : ℕ) (prev : ℕ → ℂ) : ℂ :=
  if h : ρ n = 0 then 0
  else (ρ n : ℂ) *
    Classical.choose (exists_transcendental_scaled h (Set.countable_range prev))

theorem norm_phaseStep (ρ : ℕ → ℝ) (n : ℕ) (prev : ℕ → ℂ) :
    ‖phaseStep ρ n prev‖ = |ρ n| := by
  rw [phaseStep]
  split_ifs with h
  · rw [h]
    simp
  · obtain ⟨hnorm, -⟩ :=
      Classical.choose_spec (exists_transcendental_scaled h (Set.countable_range prev))
    rw [norm_mul, hnorm, mul_one, Complex.norm_real, Real.norm_eq_abs]

theorem transcendental_phaseStep {ρ : ℕ → ℝ} {n : ℕ} (h : ρ n ≠ 0) (prev : ℕ → ℂ) :
    Transcendental ↥(IntermediateField.adjoin ℚ (Set.range prev)) (phaseStep ρ n prev) := by
  obtain ⟨-, htr⟩ :=
    Classical.choose_spec (exists_transcendental_scaled h (Set.countable_range prev))
  rw [phaseStep, dif_neg h]
  exact htr

/-- The prefix functions of the construction. -/
def phasePrefix (ρ : ℕ → ℝ) : ℕ → (ℕ → ℂ)
  | 0 => fun _ => 0
  | (n + 1) => Function.update (phasePrefix ρ n) n (phaseStep ρ n (phasePrefix ρ n))

/-- The constructed coefficient sequence. -/
def phaseSeq_modulusPhaseSequence (ρ : ℕ → ℝ) (i : ℕ) : ℂ := phasePrefix ρ (i + 1) i

theorem phasePrefix_succ_self (ρ : ℕ → ℝ) (n : ℕ) :
    phasePrefix ρ (n + 1) n = phaseStep ρ n (phasePrefix ρ n) := by
  rw [phasePrefix]
  simp

theorem phaseSeq_eq_step (ρ : ℕ → ℝ) (n : ℕ) :
    phaseSeq_modulusPhaseSequence ρ n = phaseStep ρ n (phasePrefix ρ n) := phasePrefix_succ_self ρ n

theorem phasePrefix_eq_phaseSeq (ρ : ℕ → ℝ) : ∀ {m i : ℕ}, i < m → phasePrefix ρ m i = phaseSeq_modulusPhaseSequence ρ i := by
  intro m
  induction m with
  | zero => intro i hi; omega
  | succ m ih =>
      intro i hi
      rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp hi) with hlt | rfl
      · rw [phasePrefix, Function.update_of_ne (by omega)]
        exact ih hlt
      · rw [phasePrefix_succ_self, phaseSeq_eq_step]

theorem norm_phaseSeq (ρ : ℕ → ℝ) (n : ℕ) : ‖phaseSeq_modulusPhaseSequence ρ n‖ = |ρ n| := by
  rw [phaseSeq_eq_step]
  exact norm_phaseStep ρ n _

/-- Every constructed coefficient in the support is transcendental over the field generated by the
earlier ones. -/
theorem transcendental_phaseSeq {ρ : ℕ → ℝ} {n : ℕ} (h : ρ n ≠ 0) :
    Transcendental ↥(IntermediateField.adjoin ℚ (phaseSeq_modulusPhaseSequence ρ '' Set.Iio n)) (phaseSeq_modulusPhaseSequence ρ n) := by
  have hstep := transcendental_phaseStep h (phasePrefix ρ n)
  rw [← phaseSeq_eq_step] at hstep
  intro halg
  refine hstep ?_
  have hle : IntermediateField.adjoin ℚ (phaseSeq_modulusPhaseSequence ρ '' Set.Iio n)
      ≤ IntermediateField.adjoin ℚ (Set.range (phasePrefix ρ n)) := by
    rw [IntermediateField.adjoin_le_iff]
    rintro y ⟨i, hi, rfl⟩
    refine IntermediateField.subset_adjoin ℚ _ ⟨i, ?_⟩
    exact phasePrefix_eq_phaseSeq ρ hi
  exact isAlgebraic_of_le hle halg

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Set

/-- **The constructed coefficients on the support are algebraically independent.** -/
theorem algebraicIndepOn_phaseSeq {ρ : ℕ → ℝ} (T : Finset ℕ) (hT : ∀ i ∈ T, ρ i ≠ 0) :
    AlgebraicIndepOn ℚ (phaseSeq_modulusPhaseSequence ρ) (↑T : Set ℕ) := by
  classical
  revert hT
  induction T using Finset.induction_on_max with
  | empty =>
      intro _
      have hempty : ((∅ : Finset ℕ) : Set ℕ) = (∅ : Set ℕ) := by simp
      rw [hempty]
      exact algebraicIndependent_empty_type_iff.mpr (algebraMap ℚ ℂ).injective
  | insert n T hlt ih =>
      intro hT
      have hTsub : ∀ i ∈ T, ρ i ≠ 0 := fun i hi => hT i (Finset.mem_insert_of_mem hi)
      have hn : ρ n ≠ 0 := hT n (Finset.mem_insert_self n T)
      have hind := ih hTsub
      have hcoe : ((insert n T : Finset ℕ) : Set ℕ) = insert n (↑T : Set ℕ) := by simp
      rw [hcoe]
      refine hind.insert ?_
      intro halg
      have h1 : IsAlgebraic ↥(IntermediateField.adjoin ℚ (phaseSeq_modulusPhaseSequence ρ '' (↑T : Set ℕ)))
          (phaseSeq_modulusPhaseSequence ρ n) :=
        GaloisForLFunctions.isAlgebraic_intermediateField_of_isAlgebraic_algebraAdjoin _ halg
      have hsub : phaseSeq_modulusPhaseSequence ρ '' (↑T : Set ℕ) ⊆ phaseSeq_modulusPhaseSequence ρ '' Set.Iio n :=
        Set.image_mono (fun i hi => hlt i hi)
      have hle : IntermediateField.adjoin ℚ (phaseSeq_modulusPhaseSequence ρ '' (↑T : Set ℕ))
          ≤ IntermediateField.adjoin ℚ (phaseSeq_modulusPhaseSequence ρ '' Set.Iio n) :=
        IntermediateField.adjoin.mono ℚ _ _ hsub
      exact transcendental_phaseSeq hn (isAlgebraic_of_le hle h1)

end

end GaloisForLFunctions.HTGeometry
