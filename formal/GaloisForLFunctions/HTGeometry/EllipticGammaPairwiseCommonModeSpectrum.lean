import GaloisForLFunctions.HTGeometry.EllipticGammaPeriodCosetMatroid
import GaloisForLFunctions.HTGeometry.DifferentialPairwiseCommonMode

/-!
# Pairwise common-mode spectrum of elliptic-gamma defects

The resonant rank-three period coset is exactly the phase boundary at which pairwise defect
differences cease to hide a hypertranscendental absolute mode.  This leaf is separated from the
full period-coset matroid to keep the heavy elliptic elaboration bounded.
-/

open Filter Set Topology Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher
open HTGeometry

noncomputable section

local instance ellipticGammaCommonModeDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance ellipticGammaCommonModeComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring Set.univ) := (constToAnalytic Set.univ).toAlgebra

local instance ellipticGammaCommonModeComplexAlgebraMero :
    Algebra ℂ (meroField Set.univ) :=
  meromorphicEllipticCompositumComplexAlgebraMero

local instance ellipticGammaCommonModeAmbientDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance ellipticGammaCommonModeMeroCharZero :
    CharZero (meroField Set.univ) :=
  charZero_of_injective_algebraMap
    (algebraMap ℂ (meroField Set.univ)).injective

local instance ellipticGammaCommonModeRestrictedDifferential
    (sigma tau : ℂ) :
    Differential (meromorphicEllipticCompositum sigma tau) :=
  meromorphicEllipticCompositumDifferential sigma tau

local instance ellipticGammaCommonModeDifferentialAlgebra
    (sigma tau : ℂ) :
    DifferentialAlgebra (meromorphicEllipticCompositum sigma tau)
      (meroField Set.univ) :=
  ⟨fun x ↦ derivationClosedDifferential_apply
    (meromorphicEllipticCompositum sigma tau)
    (meromorphicEllipticCompositum_derivationClosed sigma tau) x⟩

/-- **Arbitrary-observation elliptic-gamma DA spectrum.** A genuine additive defect is
differentially algebraic over the field generated by any selected defect subfamily exactly when
its period class is resonant or already represented among the selected observations. -/
theorem ellipticGammaExternalDefectFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_resonant_or_observed_periodClass
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) = 0 ∨
        ellipticGammaPeriodClass sigma tau (h anchor) ∈
          (ellipticGammaPeriodClass sigma tau ∘ h) '' I := by
  simpa [Function.comp_apply] using
    (differentialAlgebraicOver_differentialAdjoin_image_iff_loop_or_observedLabel_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0 I anchor
      (ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
        h sigma tau hsigma htau hindependent))

/-- **Arbitrary-observation elliptic-gamma HT spectrum.** The same defect is
hypertranscendental over a selected observation field exactly when its period class is nonzero and
absent from the selected period classes. -/
theorem ellipticGammaExternalDefectFamily_hypertranscendentalOver_differentialAdjoin_image_iff_nonresonant_unobserved_periodClass
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) ≠ 0 ∧
        ellipticGammaPeriodClass sigma tau (h anchor) ∉
          (ellipticGammaPeriodClass sigma tau ∘ h) '' I := by
  simpa [Function.comp_apply] using
    (hypertranscendentalOver_differentialAdjoin_image_iff_nonloop_unobservedLabel_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0 I anchor
      (ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
        h sigma tau hsigma htau hindependent))

/-- **Complete elliptic-gamma defect circuit spectrum.** Every minimal differential relation in
an arbitrary additive-defect packet is either one resonant singleton or two distinct shifts in the
same nonzero rank-three period class. There are no higher minimal relations. -/
theorem ellipticGammaExternalDefectFamily_differentialFamilyMatroid_isCircuit_iff
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (C : Set κ) :
    (differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)).IsCircuit C ↔
      (∃ i, C = {i} ∧ ellipticGammaPeriodClass sigma tau (h i) = 0) ∨
        ∃ i j, i ≠ j ∧ C = {i, j} ∧
          ellipticGammaPeriodClass sigma tau (h i) =
            ellipticGammaPeriodClass sigma tau (h j) ∧
          ellipticGammaPeriodClass sigma tau (h i) ≠ 0 := by
  rw [ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
      h sigma tau hsigma htau hindependent,
    affinePointedCollisionMatroid_isCircuit_iff]
  rfl

/-- **Relative defect reflection invariance.** Simultaneously reflecting every shift preserves
hypertranscendence of a marked genuine defect over the differential field generated by any
selected reflected observation packet. The two generated fields need not be identified. -/
theorem ellipticGammaExternalDefectFamily_hypertranscendentalOver_differentialAdjoin_image_reflection_iff
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily
            (fun j ↦ -h j) sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily
          (fun j ↦ -h j) sigma tau hsigma htau anchor) ↔
      HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) :=
  hypertranscendentalOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalDefectFamily
      (fun j ↦ -h j) sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily_differentialMatroid_reflection
      h sigma tau hsigma htau hindependent)
    I anchor

/-- Relative differential algebraicity over arbitrary selected defect observations is preserved
by the same simultaneous parameter reflection. -/
theorem ellipticGammaExternalDefectFamily_differentialAlgebraicOver_differentialAdjoin_image_reflection_iff
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily
            (fun j ↦ -h j) sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily
          (fun j ↦ -h j) sigma tau hsigma htau anchor) ↔
      DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) :=
  differentialAlgebraicOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalDefectFamily
      (fun j ↦ -h j) sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily_differentialMatroid_reflection
      h sigma tau hsigma htau hindependent)
    I anchor

/-- **Exact relative elliptic-gamma HT spectrum.** For an arbitrary shift family, a genuine
elliptic-gamma defect is hypertranscendental over the differential field generated by every other
family value exactly when its rank-three period class is nonzero and uniquely occupied. Repeated
and resonant classes are classified without any family-level injectivity hypothesis. -/
theorem ellipticGammaExternalDefectFamily_hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonresonant_periodClass
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau ''
            (Set.univ \ {anchor})))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) ≠ 0 ∧
        ∀ j, ellipticGammaPeriodClass sigma tau (h j) =
          ellipticGammaPeriodClass sigma tau (h anchor) → j = anchor := by
  simpa [Function.comp_apply] using
    (hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonloop_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0 anchor
      (ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
        h sigma tau hsigma htau hindependent))

/-- **Exact relative elliptic-gamma DA spectrum.** A defect is differentially algebraic over all
other family defects exactly when its period class is resonant or is repeated elsewhere in the
family. This is the exhaustive dual of the unique nonresonant relative-HT law. -/
theorem ellipticGammaExternalDefectFamily_differentialAlgebraicOver_differentialAdjoin_compl_iff_resonant_or_repeated_periodClass
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau ''
            (Set.univ \ {anchor})))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) = 0 ∨
        ∃ j, j ≠ anchor ∧ ellipticGammaPeriodClass sigma tau (h j) =
          ellipticGammaPeriodClass sigma tau (h anchor) := by
  simpa [Function.comp_apply] using
    (differentialAlgebraicOver_differentialAdjoin_compl_iff_loop_or_collision_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0 anchor
      (ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
        h sigma tau hsigma htau hindependent))

/-- **Elliptic-gamma common-mode phase transition.** For a family occupying distinct nonzero
rank-three period cosets, every genuine elliptic-gamma logarithmic defect is hypertranscendental over the
differential field generated by all ordered pairwise defect differences exactly when the family
avoids the resonant zero coset.

If the zero coset occurs, its defect is merely differentially algebraic—not generally zero—yet
that is already enough to make the absolute common mode DA over the pairwise reporter. Thus the
period-lattice resonance spectrum and the pairwise information-loss spectrum coincide. -/
theorem ellipticGammaExternalDefectFamily_hypertranscendentalOver_pairwiseDifferences_iff_zeroPeriodClass_not_mem_range
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (hclass : Set.InjOn (ellipticGammaPeriodClass sigma tau ∘ h)
      {i | ellipticGammaPeriodClass sigma tau (h i) ≠ 0}) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (Set.range fun p : κ × κ ↦
            ellipticGammaExternalDefectFamily h sigma tau hsigma htau p.1 -
              ellipticGammaExternalDefectFamily h sigma tau hsigma htau p.2))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
      0 ∉ Set.range (ellipticGammaPeriodClass sigma tau ∘ h) := by
  apply
    hypertranscendentalOver_anchor_pairwiseDifferences_iff_loop_not_mem_range_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      anchor (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0
  exact ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
    h sigma tau hsigma htau hindependent
  exact hclass

/-- **Elliptic-gamma contracted common-mode phase transition.** Contracting the complete
pairwise-defect reporter leaves an absolute elliptic-gamma defect as a nonloop exactly off the
resonant zero-period phase. This is the matroidal form of the exact common-mode HT spectrum. -/
theorem ellipticGammaExternalDefectFamily_contract_pairwiseDifferences_isNonloop_iff_zeroPeriodClass_not_mem_range
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (hclass : Set.InjOn (ellipticGammaPeriodClass sigma tau ∘ h)
      {i | ellipticGammaPeriodClass sigma tau (h i) ≠ 0}) :
    (Matroid.contract
        (differentialMatroid (meromorphicEllipticCompositum sigma tau)
          (meroField Set.univ))
        (Set.range fun p : κ × κ ↦
          ellipticGammaExternalDefectFamily h sigma tau hsigma htau p.1 -
            ellipticGammaExternalDefectFamily h sigma tau hsigma htau p.2)).IsNonloop
      (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) ↔
        0 ∉ Set.range (ellipticGammaPeriodClass sigma tau ∘ h) := by
  apply
    differentialMatroid_contract_pairwiseDifferences_isNonloop_iff_loop_not_mem_range_of_pointedCollisionMatroid
      (F := meromorphicEllipticCompositum sigma tau)
      anchor (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
      (ellipticGammaPeriodClass sigma tau ∘ h) 0
  exact ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
    h sigma tau hsigma htau hindependent
  exact hclass

end

end GaloisForLFunctions
