import GaloisForLFunctions.HTGeometry.JetRationalSubstitution
import GaloisForLFunctions.HTGeometry.TwistedScalingDescent
import GaloisForLFunctions.HTGeometry.FreeCoordinateSupportKernel
import GaloisForLFunctions.HTGeometry.FreeJetTranslationFixedField
import GaloisForLFunctions.HTGeometry.LogarithmicDerivativeFixedField

/-!
# Descending the order of an eigenvector of a rational substitution

The rational substitution endomorphism of the free jet field is *affine* in the top jet
coordinate: `Φ_R(y_M) = R'(y_0)·y_M + L` with `L` of order below `M`.  Slicing the field of
elements of order at most `M` as a simple transcendental extension of the field of order below `M`
turns an eigen-relation into a cross identity between two coprime polynomials in `y_M` over that
smaller field.  Coprimality splits the identity, and comparing leading coefficients produces an
eigen-relation for a single element of the smaller field, with the exponent on the derivative
factor shifted by the difference of the two degrees.

Iterating lowers the order to zero, where an eigen-relation is exactly an invariant differential.
At order one the substitution is a pure scaling, so every coefficient — not only the leading one —
produces an eigen-relation, and the descent cannot end on a trivial exponent unless the
eigenvector was a constant.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Polynomial

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-! ## The prefix fields of the jet coordinates -/

/-- Membership in a jet-coordinate subfield is annihilation by the outside partials. -/
theorem mem_adjoin_jet_iff (S : Set (Unit × ℕ)) (v : JetField C Unit) :
    v ∈ IntermediateField.adjoin C ((fun p : Unit × ℕ => (JetField.jet p : JetField C Unit)) '' S)
      ↔ ∀ i, i ∉ S → JetField.pd i v = 0 := by
  have hfun : (fun p : Unit × ℕ => (JetField.jet p : JetField C Unit))
      = freeCoordinate C (Unit × ℕ) := funext jet_eq_freeCoordinate
  rw [hfun]
  simp only [pd_eq_freeCoordinateDerivation]
  exact mem_freeCoordinateField_iff S v

/-- The subfield generated by the jet coordinates of order below `M`. -/
def jetPrefixField (C : Type*) [Field C] (M : ℕ) : IntermediateField C (JetField C Unit) :=
  IntermediateField.adjoin C
    ((fun p : Unit × ℕ => (JetField.jet p : JetField C Unit)) '' {p | p.2 < M})

theorem mem_jetPrefixField_iff (M : ℕ) (v : JetField C Unit) :
    v ∈ jetPrefixField C M ↔ ∀ j : ℕ, M ≤ j → JetField.pd ((), j) v = 0 := by
  rw [jetPrefixField, mem_adjoin_jet_iff]
  constructor
  · intro h j hj
    exact h ((), j) (by simpa using Nat.not_lt.mpr hj)
  · intro h i hi
    obtain ⟨u, j⟩ := i
    exact h j (Nat.not_lt.mp (by simpa using hi))

theorem jet_mem_jetPrefixField {M j : ℕ} (hj : j < M) :
    (JetField.jet ((), j) : JetField C Unit) ∈ jetPrefixField C M := by
  rw [mem_jetPrefixField_iff]
  intro k hk
  exact JetField.pd_jet_of_ne (by simp only [ne_eq, Prod.mk.injEq, true_and]; omega)

theorem jetPrefixField_mono {M N : ℕ} (h : M ≤ N) :
    jetPrefixField C M ≤ jetPrefixField C N := by
  intro v hv
  rw [mem_jetPrefixField_iff] at hv ⊢
  exact fun j hj => hv j (by omega)

theorem mem_jetPrefixField_succ_of_order {M : ℕ} {v : JetField C Unit}
    (hv : ∀ j : ℕ, M < j → JetField.pd ((), j) v = 0) : v ∈ jetPrefixField C (M + 1) := by
  rw [mem_jetPrefixField_iff]
  exact fun j hj => hv j (by omega)

omit [CharZero C] in
/-- The next jet coordinate is transcendental over the prefix field. -/
theorem transcendental_jet_over_jetPrefixField (M : ℕ) :
    Transcendental (jetPrefixField C M) (JetField.jet ((), M) : JetField C Unit) := by
  have hfun : (fun p : Unit × ℕ => (JetField.jet p : JetField C Unit))
      = freeCoordinate C (Unit × ℕ) := funext jet_eq_freeCoordinate
  have h := (algebraicIndependent_freeCoordinate C (Unit × ℕ)).transcendental_adjoin
    (s := {p : Unit × ℕ | p.2 < M}) (i := ((), M)) (by simp)
  rw [jetPrefixField, hfun]
  exact (IntermediateField.transcendental_adjoin_iff).2 h

omit [CharZero C] in
/-- Each prefix field is a simple transcendental extension of the previous one. -/
theorem jetPrefixField_succ (M : ℕ) :
    IntermediateField.restrictScalars C
        (IntermediateField.adjoin (jetPrefixField C M)
          ({JetField.jet ((), M)} : Set (JetField C Unit)))
      = jetPrefixField C (M + 1) := by
  have hset : ((fun p : Unit × ℕ => (JetField.jet p : JetField C Unit)) '' {p | p.2 < M})
      ∪ ({JetField.jet ((), M)} : Set (JetField C Unit))
      = (fun p : Unit × ℕ => (JetField.jet p : JetField C Unit)) '' {p | p.2 < M + 1} := by
    ext z
    constructor
    · rintro (⟨⟨u, j⟩, hj, rfl⟩ | rfl)
      · exact ⟨((), j), by simpa using Nat.lt_succ_of_lt hj, rfl⟩
      · exact ⟨((), M), by simp, rfl⟩
    · rintro ⟨⟨u, j⟩, hj, rfl⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp (by simpa using hj) with h | h
      · exact Or.inl ⟨((), j), h, rfl⟩
      · subst h
        exact Or.inr rfl
  rw [jetPrefixField, jetPrefixField, ← hset]
  exact IntermediateField.adjoin_adjoin_left C _ _

/-- An element of order at most `M` is a rational function of the top coordinate over the prefix
field. -/
theorem mem_adjoin_jet_of_order {M : ℕ} {v : JetField C Unit}
    (hv : ∀ j : ℕ, M < j → JetField.pd ((), j) v = 0) :
    v ∈ IntermediateField.adjoin (jetPrefixField C M)
      ({JetField.jet ((), M)} : Set (JetField C Unit)) := by
  have h : v ∈ jetPrefixField C (M + 1) := mem_jetPrefixField_succ_of_order hv
  rw [← jetPrefixField_succ] at h
  exact h

/-! ## The substitution restricted to a prefix field -/

theorem jetSubstitution_mem_jetPrefixField (R : RatFunc C) (hR : substitutionDeriv R ≠ 0)
    (M : ℕ) {v : JetField C Unit} (hv : v ∈ jetPrefixField C M) :
    jetSubstitution R hR v ∈ jetPrefixField C M := by
  have hle : jetPrefixField C M
      ≤ IntermediateField.comap (jetSubstitution R hR) (jetPrefixField C M) := by
    rw [jetPrefixField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨⟨u, j⟩, hj, rfl⟩
    show jetSubstitution R hR (JetField.jet ((), j)) ∈ jetPrefixField C M
    rw [jetSubstitution_jet, mem_jetPrefixField_iff]
    intro k hk
    exact pd_substitutionJet_eq_zero_of_lt R (by simp only [Set.mem_setOf_eq] at hj; omega)
  exact hle hv

/-- The substitution restricted to the prefix field it preserves. -/
def jetSubstitutionPrefix (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) (M : ℕ) :
    ↥(jetPrefixField C M) →ₐ[C] ↥(jetPrefixField C M) :=
  AlgHom.codRestrict ((jetSubstitution R hR).comp (jetPrefixField C M).val)
    (jetPrefixField C M).toSubalgebra
    (fun x => jetSubstitution_mem_jetPrefixField R hR M x.2)

@[simp]
theorem jetSubstitutionPrefix_coe (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) (M : ℕ)
    (x : ↥(jetPrefixField C M)) :
    ((jetSubstitutionPrefix R hR M x : ↥(jetPrefixField C M)) : JetField C Unit)
      = jetSubstitution R hR (x : JetField C Unit) := rfl

theorem jetSubstitution_algebraMap_prefix (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) (M : ℕ)
    (a : ↥(jetPrefixField C M)) :
    jetSubstitution R hR (algebraMap ↥(jetPrefixField C M) (JetField C Unit) a)
      = algebraMap ↥(jetPrefixField C M) (JetField C Unit) (jetSubstitutionPrefix R hR M a) := rfl

/-! ## The affine action on the top coordinate -/

theorem substitutionDeriv_mem_jetPrefixField (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) :
    substitutionDeriv R ∈ jetPrefixField C M := by
  rw [mem_jetPrefixField_iff]
  intro j hj
  exact pd_substitutionDeriv_eq_zero R (by omega)

/-- The lower-order remainder of the substitution on the top jet coordinate. -/
def substitutionShift (R : RatFunc C) (M : ℕ) : JetField C Unit :=
  substitutionJet R M - substitutionDeriv R * JetField.jet ((), M)

omit [CharZero C] in
theorem substitutionJet_eq_affine (R : RatFunc C) (M : ℕ) :
    substitutionJet R M
      = substitutionDeriv R * JetField.jet ((), M) + substitutionShift R M := by
  rw [substitutionShift]
  ring

theorem substitutionShift_mem_jetPrefixField (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) :
    substitutionShift R M ∈ jetPrefixField C M := by
  rw [mem_jetPrefixField_iff]
  intro j hj
  have hleib : JetField.pd ((), j) (substitutionDeriv R * JetField.jet ((), M))
      = substitutionDeriv R * JetField.pd ((), j) (JetField.jet ((), M))
        + JetField.jet ((), M) * JetField.pd ((), j) (substitutionDeriv R) := by
    have h := (JetField.pd ((), j) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz
        (substitutionDeriv R) (JetField.jet ((), M))
    simpa only [smul_eq_mul] using h
  rw [substitutionShift, map_sub, hleib, pd_substitutionDeriv_eq_zero R (by omega), mul_zero,
    add_zero]
  rcases eq_or_lt_of_le hj with heq | hlt
  · subst heq
    rw [pd_substitutionJet_self, JetField.pd_jet_self, mul_one, sub_self]
  · rw [pd_substitutionJet_eq_zero_of_lt R hlt,
      JetField.pd_jet_of_ne (by simp only [ne_eq, Prod.mk.injEq, true_and]; omega),
      mul_zero, sub_zero]

/-- The derivative factor as an element of the prefix field. -/
def substitutionDerivPrefix (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) : ↥(jetPrefixField C M) :=
  ⟨substitutionDeriv R, substitutionDeriv_mem_jetPrefixField R hM⟩

/-- The lower-order remainder as an element of the prefix field. -/
def substitutionShiftPrefix (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) : ↥(jetPrefixField C M) :=
  ⟨substitutionShift R M, substitutionShift_mem_jetPrefixField R hM⟩

/-- The affine polynomial through which the substitution acts on the top jet coordinate. -/
def substitutionAffine (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) :
    Polynomial ↥(jetPrefixField C M) :=
  Polynomial.C (substitutionDerivPrefix R hM) * Polynomial.X
    + Polynomial.C (substitutionShiftPrefix R hM)

theorem substitutionDerivPrefix_ne_zero (R : RatFunc C) (hR : substitutionDeriv R ≠ 0)
    {M : ℕ} (hM : 1 ≤ M) : substitutionDerivPrefix R hM ≠ 0 := by
  intro h
  exact hR (congrArg Subtype.val h)

theorem natDegree_substitutionAffine (R : RatFunc C) (hR : substitutionDeriv R ≠ 0)
    {M : ℕ} (hM : 1 ≤ M) : (substitutionAffine R hM).natDegree = 1 :=
  Polynomial.natDegree_linear (substitutionDerivPrefix_ne_zero R hR hM)

theorem leadingCoeff_substitutionAffine (R : RatFunc C) (hR : substitutionDeriv R ≠ 0)
    {M : ℕ} (hM : 1 ≤ M) :
    (substitutionAffine R hM).leadingCoeff = substitutionDerivPrefix R hM :=
  Polynomial.leadingCoeff_linear (substitutionDerivPrefix_ne_zero R hR hM)

theorem aeval_substitutionAffine (R : RatFunc C) {M : ℕ} (hM : 1 ≤ M) :
    Polynomial.aeval (JetField.jet ((), M) : JetField C Unit) (substitutionAffine R hM)
      = substitutionJet R M := by
  rw [substitutionAffine, map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_C,
    Polynomial.aeval_X]
  rw [substitutionJet_eq_affine]
  rfl

/-- **The substitution in the top coordinate.**  On a polynomial in the top jet coordinate the
substitution acts by twisting the coefficients and composing with the affine polynomial. -/
theorem jetSubstitution_aeval (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) {M : ℕ} (hM : 1 ≤ M)
    (P : Polynomial ↥(jetPrefixField C M)) :
    jetSubstitution R hR (Polynomial.aeval (JetField.jet ((), M) : JetField C Unit) P)
      = Polynomial.aeval (JetField.jet ((), M) : JetField C Unit)
          (twistComp (jetSubstitutionPrefix R hR M).toRingHom (substitutionAffine R hM) P) := by
  induction P using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add, map_add, twistComp_add, map_add, hp, hq]
  | monomial n a =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, Polynomial.aeval_C,
        Polynomial.aeval_X, map_mul, map_pow, twistComp_mul, twistComp_C]
      have hX : twistComp (jetSubstitutionPrefix R hR M).toRingHom (substitutionAffine R hM)
          (Polynomial.X ^ n) = (substitutionAffine R hM) ^ n := by
        rw [twistComp, Polynomial.map_pow, Polynomial.map_X, Polynomial.pow_comp,
          Polynomial.X_comp]
      rw [hX, map_mul, map_pow, Polynomial.aeval_C, aeval_substitutionAffine,
        jetSubstitution_jet, jetSubstitution_algebraMap_prefix]

end

end GaloisForLFunctions.HTGeometry
