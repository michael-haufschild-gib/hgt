import GaloisForLFunctions.HTGeometry.DirichletDefectInertness
import GaloisForLFunctions.HTGeometry.OrbitIsolatedShiftDefect
import GaloisForLFunctions.HTGeometry.UpperEndRationalGauge
import Mathlib

/-!
# Hypertranscendence at an orbit-isolated pole

A rational function `b = N / ((s - a) ^ e * W)` whose pole at `a` is the only pole in the shift
orbit `a + Z` has jets

`delta^n b = (-I)^n * M n / ((s - a) ^ (e + n) * W ^ (n + 1))`,

with `M n (a)` nonzero.  A nonzero combination of the jets therefore has a pole at `a` and none
elsewhere in the orbit, so by the extremal obstruction it is not a shift defect of `C(s)`; by
leading-term inertness it is not a shift defect of the whole Dirichlet tower either.

Every solution of `y (s + 1) - y (s) = b (s)` is consequently hypertranscendental over the field
generated by `C(s)` and every convergent Dirichlet series.
-/

open Polynomial Filter
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance orbitPoleDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance orbitPoleDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance orbitPoleComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-! ## The chain rule in the Dirichlet coordinate -/

theorem aeval_dirCoordMero_eq_polyToMero (P : ℂ[X]) :
    Polynomial.aeval dirCoordMero P
      = upperEndPolyToMero (P.comp (Polynomial.C (-Complex.I) * X)) := by
  rw [← aeval_coordMero_eq, Polynomial.aeval_comp]
  simp only [Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X]
  rw [dirCoordMero_eq]

/-- **The Dirichlet coordinate differentiates with the constant factor `-I`.** -/
theorem deriv_aeval_dirCoordMero (P : ℂ[X]) :
    (Polynomial.aeval dirCoordMero P)′
      = algebraMap ℂ upperEndMeroField (-Complex.I)
        * Polynomial.aeval dirCoordMero (Polynomial.derivative P) := by
  rw [aeval_dirCoordMero_eq_polyToMero, upperEndMero_deriv_polyEval,
    Polynomial.derivative_comp]
  simp only [Polynomial.derivative_mul, Polynomial.derivative_C, Polynomial.derivative_X,
    zero_mul, zero_add, mul_one]
  rw [aeval_dirCoordMero_eq_polyToMero (Polynomial.derivative P), map_mul]
  rfl

/-! ## The jet numerators of a rational function with a distinguished pole -/

variable (a : ℂ) (e' : ℕ) (N W : ℂ[X])

/-- The denominator of the `n`-th jet. -/
def poleDen (n : ℕ) : ℂ[X] := (X - Polynomial.C a) ^ (e' + 1 + n) * W ^ (n + 1)

/-- The numerator of the `n`-th jet. -/
def poleNum : ℕ → ℂ[X]
  | 0 => N
  | (n + 1) =>
      (poleNum n).derivative * ((X - Polynomial.C a) * W)
        - (poleNum n) * (Polynomial.C ((e' + 1 + n : ℕ) : ℂ) * W
            + Polynomial.C ((n + 1 : ℕ) : ℂ) * ((X - Polynomial.C a) * Polynomial.derivative W))

@[simp] theorem poleNum_zero : poleNum a e' N W 0 = N := rfl

theorem poleNum_succ (n : ℕ) :
    poleNum a e' N W (n + 1)
      = (poleNum a e' N W n).derivative * ((X - Polynomial.C a) * W)
        - (poleNum a e' N W n) * (Polynomial.C ((e' + 1 + n : ℕ) : ℂ) * W
            + Polynomial.C ((n + 1 : ℕ) : ℂ)
              * ((X - Polynomial.C a) * Polynomial.derivative W)) := rfl

/-- **The quotient-rule identity for the jet numerators.** -/
theorem poleNum_den_step (n : ℕ) :
    (poleNum a e' N W n).derivative * poleDen a e' W n
        - (poleNum a e' N W n) * Polynomial.derivative (poleDen a e' W n)
      = poleNum a e' N W (n + 1) * ((X - Polynomial.C a) ^ (e' + n) * W ^ n) := by
  have hu : Polynomial.derivative ((X - Polynomial.C a) ^ (e' + 1 + n))
      = (((e' + 1 + n : ℕ) : ℂ[X])) * (X - Polynomial.C a) ^ (e' + n) := by
    rw [Polynomial.derivative_pow]
    simp
  have hw : Polynomial.derivative (W ^ (n + 1))
      = (((n + 1 : ℕ) : ℂ[X])) * W ^ n * Polynomial.derivative W := by
    rw [Polynomial.derivative_pow]
    simp
  have hden : Polynomial.derivative (poleDen a e' W n)
      = (((e' + 1 + n : ℕ) : ℂ[X])) * (X - Polynomial.C a) ^ (e' + n) * W ^ (n + 1)
        + (X - Polynomial.C a) ^ (e' + 1 + n)
          * ((((n + 1 : ℕ) : ℂ[X])) * W ^ n * Polynomial.derivative W) := by
    rw [poleDen, Polynomial.derivative_mul, hu, hw]
  rw [poleNum_succ, hden, poleDen]
  have hsplit : (X - Polynomial.C a) ^ (e' + 1 + n)
      = (X - Polynomial.C a) ^ (e' + n) * (X - Polynomial.C a) := by
    rw [← pow_succ]
    congr 1
    omega
  have hwsplit : W ^ (n + 1) = W ^ n * W := by rw [pow_succ]
  rw [hsplit, hwsplit]
  simp only [Polynomial.C_eq_natCast]
  ring

theorem poleDen_sq (n : ℕ) :
    poleDen a e' W (n + 1) * ((X - Polynomial.C a) ^ (e' + n) * W ^ n)
      = poleDen a e' W n * poleDen a e' W n := by
  simp only [poleDen, pow_add, pow_succ]
  ring

theorem poleDen_ne_zero (hW : W ≠ 0) (n : ℕ) : poleDen a e' W n ≠ 0 := by
  refine mul_ne_zero (pow_ne_zero _ ?_) (pow_ne_zero _ hW)
  exact Polynomial.X_sub_C_ne_zero a

theorem poleNum_eval_ne_zero (hN : N.eval a ≠ 0) (hW : W.eval a ≠ 0) (n : ℕ) :
    (poleNum a e' N W n).eval a ≠ 0 := by
  induction n with
  | zero => simpa using hN
  | succ n ih =>
      rw [poleNum_succ]
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_add,
        Polynomial.eval_C, Polynomial.eval_X, sub_self, zero_mul, mul_zero, add_zero]
      rw [zero_sub, neg_ne_zero]
      exact mul_ne_zero ih (mul_ne_zero (Nat.cast_ne_zero.mpr (by omega)) hW)

/-! ## The jets of the germ -/

/-- The rational germ with a distinguished pole of order `e' + 1` at `a`. -/
def poleGerm : upperEndMeroField :=
  Polynomial.aeval dirCoordMero N
    / Polynomial.aeval dirCoordMero ((X - Polynomial.C a) ^ (e' + 1) * W)

theorem aeval_poleDen_ne_zero (hW : W ≠ 0) (n : ℕ) :
    Polynomial.aeval dirCoordMero (poleDen a e' W n) ≠ 0 :=
  aeval_dirCoordMero_ne_zero (poleDen_ne_zero a e' W hW n)

/-- **Closed form for the jets.** -/
theorem differentialJet_poleGerm (hW : W ≠ 0) (n : ℕ) :
    differentialJet n (poleGerm a e' N W)
        * Polynomial.aeval dirCoordMero (poleDen a e' W n)
      = algebraMap ℂ upperEndMeroField ((-Complex.I) ^ n)
        * Polynomial.aeval dirCoordMero (poleNum a e' N W n) := by
  induction n with
  | zero =>
      have hd : poleDen a e' W 0 = (X - Polynomial.C a) ^ (e' + 1) * W := by
        rw [poleDen]; simp
      rw [differentialJet_zero, poleGerm, hd, poleNum_zero, pow_zero, map_one, one_mul]
      exact div_mul_cancel₀ _ (aeval_dirCoordMero_ne_zero
        (by rw [← hd]; exact poleDen_ne_zero a e' W hW 0))
  | succ n ih =>
      have hDn := aeval_poleDen_ne_zero a e' W hW n
      have hG : Polynomial.aeval dirCoordMero
          ((X - Polynomial.C a) ^ (e' + n) * W ^ n) ≠ 0 :=
        aeval_dirCoordMero_ne_zero
          (mul_ne_zero (pow_ne_zero _ (Polynomial.X_sub_C_ne_zero a)) (pow_ne_zero _ hW))
      set c : upperEndMeroField := differentialJet n (poleGerm a e' N W) with hc
      set Mn : ℂ[X] := poleNum a e' N W n with hMn
      set Dn : ℂ[X] := poleDen a e' W n with hDnp
      -- differentiate the inductive identity
      have hderiv := congrArg (fun z : upperEndMeroField => z′) ih
      simp only [Derivation.leibniz, smul_eq_mul] at hderiv
      rw [upperEndMero_deriv_complexConstant ((-Complex.I) ^ n)] at hderiv
      rw [deriv_aeval_dirCoordMero, deriv_aeval_dirCoordMero] at hderiv
      have hstep : c′ * Polynomial.aeval dirCoordMero Dn
          = algebraMap ℂ upperEndMeroField ((-Complex.I) ^ (n + 1))
              * Polynomial.aeval dirCoordMero (Polynomial.derivative Mn)
            - c * (algebraMap ℂ upperEndMeroField (-Complex.I)
              * Polynomial.aeval dirCoordMero (Polynomial.derivative Dn)) := by
        rw [pow_succ, map_mul]
        linear_combination hderiv
      -- clear one power of the denominator
      have hkap : algebraMap ℂ upperEndMeroField ((-Complex.I) ^ (n + 1))
          = algebraMap ℂ upperEndMeroField ((-Complex.I) ^ n)
            * algebraMap ℂ upperEndMeroField (-Complex.I) := by
        rw [← map_mul, pow_succ]
      have hsq : Polynomial.aeval dirCoordMero (poleDen a e' W (n + 1))
          * Polynomial.aeval dirCoordMero ((X - Polynomial.C a) ^ (e' + n) * W ^ n)
          = Polynomial.aeval dirCoordMero Dn * Polynomial.aeval dirCoordMero Dn := by
        rw [← map_mul, ← map_mul, hDnp]
        exact congrArg _ (poleDen_sq a e' W n)
      have hnum : Polynomial.aeval dirCoordMero (poleNum a e' N W (n + 1))
          * Polynomial.aeval dirCoordMero ((X - Polynomial.C a) ^ (e' + n) * W ^ n)
          = Polynomial.aeval dirCoordMero (Polynomial.derivative Mn)
              * Polynomial.aeval dirCoordMero Dn
            - Polynomial.aeval dirCoordMero Mn
              * Polynomial.aeval dirCoordMero (Polynomial.derivative Dn) := by
        rw [← map_mul, ← map_mul, ← map_mul, ← map_sub, hMn, hDnp]
        exact congrArg _ (poleNum_den_step a e' N W n).symm
      have hmain : (c′ * Polynomial.aeval dirCoordMero (poleDen a e' W (n + 1)))
          * Polynomial.aeval dirCoordMero ((X - Polynomial.C a) ^ (e' + n) * W ^ n)
          = (algebraMap ℂ upperEndMeroField ((-Complex.I) ^ (n + 1))
              * Polynomial.aeval dirCoordMero (poleNum a e' N W (n + 1)))
            * Polynomial.aeval dirCoordMero ((X - Polynomial.C a) ^ (e' + n) * W ^ n) := by
        linear_combination c′ * hsq + (Polynomial.aeval dirCoordMero Dn) * hstep
          - (algebraMap ℂ upperEndMeroField (-Complex.I)
              * Polynomial.aeval dirCoordMero (Polynomial.derivative Dn)) * ih
          - (algebraMap ℂ upperEndMeroField ((-Complex.I) ^ (n + 1))) * hnum
          + (Polynomial.aeval dirCoordMero (Polynomial.derivative Dn)
              * Polynomial.aeval dirCoordMero Mn) * hkap
      rw [differentialJet_succ, ← hc]
      exact mul_right_cancel₀ hG hmain


/-! ## The span of the jets -/

theorem poleDen_split (i d : ℕ) :
    poleDen a e' W (i + d)
      = poleDen a e' W i * ((X - Polynomial.C a) ^ d * W ^ d) := by
  simp only [poleDen]
  rw [show e' + 1 + (i + d) = (e' + 1 + i) + d by omega,
    show i + d + 1 = (i + 1) + d by omega, pow_add, pow_add]
  ring

/-- The jet family of the germ. -/
def poleJet (n : ℕ) : upperEndMeroField := differentialJet n (poleGerm a e' N W)

theorem poleJet_mul_den (hW : W ≠ 0) {i n : ℕ} (hin : i ≤ n) :
    poleJet a e' N W i * Polynomial.aeval dirCoordMero (poleDen a e' W n)
      = Polynomial.aeval dirCoordMero
          (Polynomial.C ((-Complex.I) ^ i) * poleNum a e' N W i
            * ((X - Polynomial.C a) ^ (n - i) * W ^ (n - i))) := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hin
  rw [poleDen_split]
  have h := differentialJet_poleGerm a e' N W hW i
  simp only [map_mul, Polynomial.aeval_C]
  rw [← mul_assoc, poleJet, h]
  simp only [Nat.add_sub_cancel_left]

theorem poleJet_mem_dirRatBase (hW : W ≠ 0) (n : ℕ) :
    poleJet a e' N W n ∈ dirRatBase := by
  have h := differentialJet_poleGerm a e' N W hW n
  have hD := aeval_poleDen_ne_zero a e' W hW n
  have hval : poleJet a e' N W n
      = (algebraMap ℂ upperEndMeroField ((-Complex.I) ^ n)
          * Polynomial.aeval dirCoordMero (poleNum a e' N W n))
        / Polynomial.aeval dirCoordMero (poleDen a e' W n) := by
    rw [poleJet, eq_div_iff hD]
    exact h
  rw [hval]
  exact div_mem (mul_mem (dirRatBase.algebraMap_mem _) (aeval_mem_dirRatBase _))
    (aeval_mem_dirRatBase _)

/-- **No jet lies in the span of its predecessors.** -/
theorem poleJet_not_mem_defectSpan (hN : N.eval a ≠ 0) (hWa : W.eval a ≠ 0) (n : ℕ) :
    poleJet a e' N W n ∉ _root_.HTGeometry.defectSpan (poleJet a e' N W) n := by
  classical
  have hW : W ≠ 0 := fun h => hWa (by rw [h]; simp)
  intro hmem
  set Q : upperEndMeroField → Prop := fun z =>
    ∃ q : ℂ[X], q.eval a = 0 ∧
      z * Polynomial.aeval dirCoordMero (poleDen a e' W n) = Polynomial.aeval dirCoordMero q
    with hQ
  have hspan : Q (poleJet a e' N W n) := by
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
    · rintro z ⟨i, hi, rfl⟩
      simp only [Set.mem_Iio] at hi
      refine ⟨Polynomial.C ((-Complex.I) ^ i) * poleNum a e' N W i
        * ((X - Polynomial.C a) ^ (n - i) * W ^ (n - i)), ?_, ?_⟩
      · have hpos : 0 < n - i := by omega
        simp [Polynomial.eval_mul, Polynomial.eval_pow, zero_pow hpos.ne']
      · exact poleJet_mul_den a e' N W hW (le_of_lt hi)
    · exact ⟨0, by simp, by simp⟩
    · rintro z w - - ⟨qz, hqz0, hqz⟩ ⟨qw, hqw0, hqw⟩
      exact ⟨qz + qw, by simp [hqz0, hqw0], by rw [add_mul, hqz, hqw, map_add]⟩
    · rintro t z - ⟨qz, hqz0, hqz⟩
      refine ⟨Polynomial.C t * qz, by simp [hqz0], ?_⟩
      rw [Algebra.smul_def, mul_assoc, hqz, map_mul, Polynomial.aeval_C]
  obtain ⟨q, hq0, hq⟩ := hspan
  have htop := poleJet_mul_den a e' N W hW (le_refl n)
  simp only [Nat.sub_self, pow_zero, mul_one] at htop
  rw [hq] at htop
  have hpoly : q = Polynomial.C ((-Complex.I) ^ n) * poleNum a e' N W n :=
    _root_.HTGeometry.aeval_coord_injective transcendental_dirCoordMero (by simpa using htop)
  rw [hpoly] at hq0
  simp only [Polynomial.eval_mul, Polynomial.eval_C] at hq0
  rcases mul_eq_zero.mp hq0 with h | h
  · exact (pow_ne_zero n (by simp)) h
  · exact poleNum_eval_ne_zero a e' N W hN hWa n h

/-- Every nonzero element of the jet span has a pole at `a` of the expected shape. -/
theorem defectSpanAll_poleJet_shape (hN : N.eval a ≠ 0) (hWa : W.eval a ≠ 0)
    {v : upperEndMeroField} (hv : v ∈ _root_.HTGeometry.defectSpanAll (poleJet a e' N W))
    (hv0 : v ≠ 0) :
    ∃ (K : ℕ) (q : ℂ[X]), 0 < K ∧ q.eval a ≠ 0 ∧
      v * Polynomial.aeval dirCoordMero (((X - Polynomial.C a) * W) ^ K)
        = Polynomial.aeval dirCoordMero q := by
  classical
  have hW : W ≠ 0 := fun h => hWa (by rw [h]; simp)
  obtain ⟨l, hl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hv
  have hlne : l.support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    refine hv0 ?_
    rw [← hl, Finsupp.sum, h, Finset.sum_empty]
  set n : ℕ := l.support.max' hlne with hn
  set q0 : ℂ[X] := ∑ i ∈ l.support, Polynomial.C (l i) *
    (Polynomial.C ((-Complex.I) ^ i) * poleNum a e' N W i
      * ((X - Polynomial.C a) ^ (n - i) * W ^ (n - i))) with hq0
  have hvden : v * Polynomial.aeval dirCoordMero (poleDen a e' W n)
      = Polynomial.aeval dirCoordMero q0 := by
    rw [← hl, Finsupp.sum, Finset.sum_mul, hq0, map_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hin : i ≤ n := Finset.le_max' _ i hi
    rw [Algebra.smul_def, mul_assoc, poleJet_mul_den a e' N W hW hin]
    simp only [map_mul, Polynomial.aeval_C]
  have hq0a : q0.eval a ≠ 0 := by
    have hsplit : q0.eval a = l n * ((-Complex.I) ^ n * (poleNum a e' N W n).eval a) := by
      rw [hq0, Polynomial.eval_finsetSum]
      rw [Finset.sum_eq_single n]
      · simp [Polynomial.eval_mul, Polynomial.eval_pow]
      · intro i hi hine
        have hin : i < n := lt_of_le_of_ne (Finset.le_max' _ i hi) hine
        have hpos : 0 < n - i := by omega
        simp [Polynomial.eval_mul, Polynomial.eval_pow, zero_pow hpos.ne']
      · intro hnot
        exact absurd (Finset.max'_mem _ hlne) hnot
    rw [hsplit]
    refine mul_ne_zero ?_ (mul_ne_zero (pow_ne_zero n (by simp))
      (poleNum_eval_ne_zero a e' N W hN hWa n))
    intro h
    exact absurd (Finsupp.notMem_support_iff.mpr h) (by simpa using Finset.max'_mem _ hlne)
  refine ⟨e' + 1 + n, q0 * W ^ e', by omega, ?_, ?_⟩
  · simp only [Polynomial.eval_mul, Polynomial.eval_pow]
    exact mul_ne_zero hq0a (pow_ne_zero _ hWa)
  · have hEpow : ((X - Polynomial.C a) * W) ^ (e' + 1 + n)
        = poleDen a e' W n * W ^ e' := by
      simp only [poleDen, mul_pow]
      rw [show e' + 1 + n = (n + 1) + e' by omega, pow_add]
      ring_nf
    rw [hEpow, map_mul, ← mul_assoc, hvden, ← map_mul]

/-! ## The law -/

/-- **No nonzero element of the jet span is a translation defect of `C(s)`.** -/
theorem poleJet_defect_eq_zero (hN : N.eval a ≠ 0)
    (hWorb : ∀ k : ℤ, W.eval (a + (k : ℂ)) ≠ 0)
    (u : upperEndMeroField) (hu : u ∈ dirRatBase)
    (v : upperEndMeroField) (hv : v ∈ _root_.HTGeometry.defectSpanAll (poleJet a e' N W))
    (hduv : upperEndTranslationMeroEquiv Complex.I u - u = v) : v = 0 := by
  classical
  have hWa : W.eval a ≠ 0 := by simpa using hWorb 0
  by_contra hv0
  obtain ⟨K, q, hKpos, hqa, hshape⟩ := defectSpanAll_poleJet_shape a e' N W hN hWa hv hv0
  set E : ℂ[X] := (X - Polynomial.C a) * W with hE
  obtain ⟨A₀, B₀, hAB⟩ := (IntermediateField.mem_adjoin_simple_iff ℂ u).mp hu
  rcases eq_or_ne B₀ 0 with rfl | hB0
  · rw [show u = 0 by simpa using hAB] at hduv
    simp at hduv
    exact hv0 hduv.symm
  rcases eq_or_ne A₀ 0 with rfl | hA0
  · rw [show u = 0 by simpa using hAB] at hduv
    simp at hduv
    exact hv0 hduv.symm
  have hBK : Polynomial.aeval dirCoordMero B₀ ≠ 0 := aeval_dirCoordMero_ne_zero hB0
  have hB0s : B₀.comp (X + Polynomial.C 1) ≠ 0 := by
    intro h
    refine hB0 ?_
    have := congrArg (fun p : ℂ[X] => p.comp (X - Polynomial.C 1)) h
    simpa [Polynomial.comp_assoc, Polynomial.add_comp, Polynomial.sub_comp] using this
  have hBsK : Polynomial.aeval dirCoordMero (B₀.comp (X + Polynomial.C 1)) ≠ 0 :=
    aeval_dirCoordMero_ne_zero hB0s
  have hvv : v = (Polynomial.aeval dirCoordMero (A₀.comp (X + Polynomial.C 1))
        * Polynomial.aeval dirCoordMero B₀
      - Polynomial.aeval dirCoordMero A₀
        * Polynomial.aeval dirCoordMero (B₀.comp (X + Polynomial.C 1)))
      / (Polynomial.aeval dirCoordMero (B₀.comp (X + Polynomial.C 1))
        * Polynomial.aeval dirCoordMero B₀) := by
    rw [← hduv, hAB, map_div₀, sigma_aeval_dirCoordMero, sigma_aeval_dirCoordMero]
    field_simp
  rw [hvv] at hshape
  have hfield : Polynomial.aeval dirCoordMero
        ((A₀.comp (X + Polynomial.C 1) * B₀ - A₀ * B₀.comp (X + Polynomial.C 1)) * E ^ K)
      = Polynomial.aeval dirCoordMero
          (q * (B₀.comp (X + Polynomial.C 1) * B₀)) := by
    simp only [map_mul, map_sub, map_pow] at hshape ⊢
    rw [div_mul_eq_mul_div, div_eq_iff (mul_ne_zero hBsK hBK)] at hshape
    linear_combination hshape
  have hpoly : (A₀.comp (X + Polynomial.C 1) * B₀ - A₀ * B₀.comp (X + Polynomial.C 1)) * E ^ K
      = q * (B₀.comp (X + Polynomial.C 1) * B₀) :=
    _root_.HTGeometry.aeval_coord_injective transcendental_dirCoordMero (by simpa using hfield)
  simp only [Polynomial.C_1] at hpoly
  obtain ⟨A', B', hmon, hcop, hid⟩ :=
    _root_.HTGeometry.exists_coprime_monic_shift_identity (rd := E ^ K) (rn := q) hA0 hB0 hpoly
  refine _root_.HTGeometry.no_shift_defect_orbit_isolated hmon hcop hKpos ?_ ?_ hqa hid
  · simp [hE]
  · intro k hk
    simp only [hE, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
      Polynomial.eval_C]
    refine mul_ne_zero ?_ (hWorb k)
    intro h
    have : (k : ℂ) = 0 := by linear_combination h
    exact hk (by exact_mod_cast this)

/-- **The orbit-isolated pole law.**  If `b = N / ((s - a) ^ (e' + 1) * W)` has its only pole in
the shift orbit `a + Z` at `a`, then the jets of every solution of `y (s + 1) - y (s) = b (s)` are
algebraically independent over the field generated by `C(s)` and every convergent Dirichlet
series. -/
theorem orbitIsolatedPole_jets_transcendental (hN : N.eval a ≠ 0)
    (hWorb : ∀ k : ℤ, W.eval (a + (k : ℂ)) ≠ 0)
    {y : ℕ → upperEndMeroField}
    (hy : ∀ n, upperEndTranslationMeroEquiv Complex.I (y n) = y n + poleJet a e' N W n)
    (n : ℕ) :
    Transcendental (_root_.HTGeometry.jetTower dirZetaBase y n) (y n) := by
  have hWa : W.eval a ≠ 0 := by simpa using hWorb 0
  have hW : W ≠ 0 := fun h => hWa (by rw [h]; simp)
  refine dirichletTower_jetTower_transcendental
    (poleJet_mem_dirRatBase a e' N W hW)
    (_root_.HTGeometry.defectSpanAll_le_of_mem (poleJet_mem_dirRatBase a e' N W hW))
    (poleJet_not_mem_defectSpan a e' N W hN hWa)
    (poleJet_defect_eq_zero a e' N W hN hWorb) hy n

/-- **Hypertranscendence over the whole Dirichlet tower at an orbit-isolated pole.** -/
theorem orbitIsolatedPole_hypertranscendental (hN : N.eval a ≠ 0)
    (hWorb : ∀ k : ℤ, W.eval (a + (k : ℂ)) ≠ 0)
    {y : upperEndMeroField}
    (hy : upperEndTranslationMeroEquiv Complex.I y = y + poleGerm a e' N W) :
    GaloisForLFunctions.HypertranscendentalOver (dirZetaBase : Type _) y := by
  have hjet : ∀ n, upperEndTranslationMeroEquiv Complex.I (differentialJet n y)
      = differentialJet n y + poleJet a e' N W n := by
    intro n
    induction n with
    | zero => simpa [poleJet] using hy
    | succ n ih =>
        rw [differentialJet_succ, upperEndTranslationMeroEquiv_deriv, ih, map_add]
        simp only [poleJet, differentialJet_succ]
  have hfree := orbitIsolatedPole_jets_transcendental a e' N W hN hWorb
    (y := fun n => differentialJet n y) hjet
  have hind := _root_.HTGeometry.algebraicIndependent_of_jetTower_transcendental dirZetaBase
    (fun n => differentialJet n y) hfree
  rw [GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton]
  have hinj : Function.Injective (fun p : Unit × ℕ => p.2) := by
    rintro ⟨u1, m⟩ ⟨u2, k⟩ h
    simp only at h
    subst h
    rfl
  exact hind.comp (fun p : Unit × ℕ => p.2) hinj

end

end GaloisForLFunctions.HTGeometry
