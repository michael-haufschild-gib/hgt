import GaloisForLFunctions.HTGeometry.MatrixPrincipalSymbolDerivationLawHorizon

/-!
# Matrix principal-symbol flatness from commutator closure

A finite-rank observable grid acted on by a family of filtered derivation laws carries matrix
principal symbols between consecutive layers.  The two-layer coefficient of a composite law is the
row-order product of consecutive symbols, so the two-layer coefficient of a commutator is exactly
the matrix coefficient principal curvature.  If the law family closes under commutator inside the
same first-order filtered class, that curvature must vanish against an algebraically free grid:
coefficient flatness is not an assumption but a consequence of Lie closure.  Combined with the
determinant-horizon theorems, a commutator-closed finite-rank law system has either no jointly
independent direction or a dependence spectrum equal to one first-layer determinantal horizon.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Set

variable {k K L g ι : Type*} [Field k] [Field K] [Field L]
  [Algebra k K] [Algebra k L] [Algebra K L]
  [Fintype ι] [DecidableEq ι]

/-- The strict filtration generated by all packet layers below `n`. -/
def matrixPacketFiltration (u : ℕ → ι → L) (n : ℕ) : Submodule K L :=
  Submodule.span K (Set.range fun p : Fin n × ι ↦ u p.1 p.2)

omit [Fintype ι] [DecidableEq ι] in
theorem matrixPacketFiltration_mono (u : ℕ → ι → L) {m n : ℕ} (hmn : m ≤ n) :
    matrixPacketFiltration (K := K) u m ≤ matrixPacketFiltration (K := K) u n := by
  apply Submodule.span_mono (R := K) (M := L)
  rintro y ⟨⟨j, i⟩, rfl⟩
  exact ⟨(⟨(j : ℕ), lt_of_lt_of_le j.isLt hmn⟩, i), rfl⟩

omit [Fintype ι] [DecidableEq ι] in
theorem matrixPacketFiltration_source_mem (u : ℕ → ι → L) {j n : ℕ} (hj : j < n) (i : ι) :
    u j i ∈ matrixPacketFiltration (K := K) u n :=
  Submodule.subset_span ⟨(⟨j, hj⟩, i), rfl⟩

omit [DecidableEq ι] in
/-- Membership in the packet filtration kills any layer combination sitting on the boundary
layer: the boundary coefficients of an algebraically free grid must vanish. -/
theorem matrixPacket_layer_coefficients_eq_zero_of_mem_filtration
    (u : ℕ → ι → L)
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2))
    (n : ℕ) (c : ι → K)
    (hc : (∑ jj, c jj • u n jj) ∈ matrixPacketFiltration (K := K) u n) :
    ∀ jj, c jj = 0 := by
  classical
  have hli : LinearIndependent K (fun p : ℕ × ι ↦ u p.1 p.2) := hu.linearIndependent
  have hfil : matrixPacketFiltration (K := K) u n =
      Submodule.span K ((fun p : ℕ × ι ↦ u p.1 p.2) '' {p : ℕ × ι | p.1 < n}) := by
    unfold matrixPacketFiltration
    congr 1
    ext y
    constructor
    · rintro ⟨⟨j, i⟩, rfl⟩
      exact ⟨((j : ℕ), i), j.isLt, rfl⟩
    · rintro ⟨⟨j, i⟩, hj, rfl⟩
      exact ⟨(⟨j, hj⟩, i), rfl⟩
  have hlayer : (∑ jj, c jj • u n jj) ∈
      Submodule.span K ((fun p : ℕ × ι ↦ u p.1 p.2) '' {p : ℕ × ι | p.1 = n}) := by
    apply Submodule.sum_mem
    intro jj _
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(n, jj), rfl, rfl⟩)
  have hdisj : Disjoint {p : ℕ × ι | p.1 < n} {p : ℕ × ι | p.1 = n} := by
    rw [Set.disjoint_left]
    rintro ⟨m, i⟩ hm hn
    have h1 : m < n := hm
    have h2 : m = n := hn
    omega
  have hzero : (∑ jj, c jj • u n jj) = 0 :=
    Submodule.disjoint_def.mp (hli.disjoint_span_image hdisj) _ (hfil ▸ hc) hlayer
  have hinj : Function.Injective (fun i : ι ↦ ((n, i) : ℕ × ι)) :=
    fun i j h ↦ congrArg Prod.snd h
  have hlayerLI : LinearIndependent K (fun i : ι ↦ u n i) := by
    have := hli.comp (fun i : ι ↦ ((n, i) : ℕ × ι)) hinj
    simpa [Function.comp_def] using this
  exact Fintype.linearIndependent_iff.mp hlayerLI c hzero

omit [Fintype ι] [DecidableEq ι] in
/-- A derivation compatible with a coefficient derivation differentiates `K`-scalars by the
Leibniz rule. -/
theorem derivation_ksmul_eq
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (a : K) (x : L) :
    D (a • x) = D₀ a • x + a • D x := by
  rw [Algebra.smul_def, Derivation.leibniz, hcompat]
  simp only [smul_eq_mul, Algebra.smul_def]
  ring

omit [DecidableEq ι] in
/-- A compatible derivation with a strict-lower-layer matrix step law carries the packet
filtration at order `n` into the one at order `n+1`. -/
theorem derivation_matrixPacketFiltration_succ
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (u : ℕ → ι → L) (S : ℕ → Matrix ι ι K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n i,
      D (u n i) - ∑ j, S n i j • u (n + 1) j ∈ matrixPacketFiltration (K := K) u (n + 1))
    (n : ℕ) {y : L} (hy : y ∈ matrixPacketFiltration (K := K) u n) :
    D y ∈ matrixPacketFiltration (K := K) u (n + 1) := by
  refine Submodule.span_induction
    (R := K) (M := L) (s := Set.range fun p : Fin n × ι ↦ u p.1 p.2)
    (p := fun y _ ↦ D y ∈ matrixPacketFiltration (K := K) u (n + 1))
    ?_ ?_ ?_ ?_ (hx := hy)
  · rintro y ⟨⟨j, i⟩, rfl⟩
    have hjn : (j : ℕ) < n := j.isLt
    have hrem : D (u j i) - ∑ jj, S j i jj • u ((j : ℕ) + 1) jj ∈
        matrixPacketFiltration (K := K) u (n + 1) :=
      matrixPacketFiltration_mono (K := K) u
        (Nat.succ_le_succ (Nat.le_of_lt hjn)) (hstep j i)
    have hlead : (∑ jj, S j i jj • u ((j : ℕ) + 1) jj) ∈
        matrixPacketFiltration (K := K) u (n + 1) :=
      Submodule.sum_mem _ fun jj _ ↦
        (matrixPacketFiltration (K := K) u (n + 1)).smul_mem _
          (matrixPacketFiltration_source_mem (K := K) u (Nat.succ_lt_succ hjn) jj)
    simpa only [sub_add_cancel] using
      (matrixPacketFiltration (K := K) u (n + 1)).add_mem hrem hlead
  · simp
  · intro x y _ _ hxD hyD
    simpa using (matrixPacketFiltration (K := K) u (n + 1)).add_mem hxD hyD
  · intro a y hy' hyD
    rw [derivation_ksmul_eq D₀ D hcompat a y]
    exact (matrixPacketFiltration (K := K) u (n + 1)).add_mem
      ((matrixPacketFiltration (K := K) u (n + 1)).smul_mem _
        (matrixPacketFiltration_mono (K := K) u (Nat.le_succ n) hy'))
      ((matrixPacketFiltration (K := K) u (n + 1)).smul_mem _ hyD)

omit [DecidableEq ι] in
/-- One-step transport of a fixed `K`-row combination of one packet layer: the derivative is the
row-times-symbol combination of the next layer, modulo the filtration. -/
theorem derivation_rowCombination_sub_mem
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (u : ℕ → ι → L) (S : ℕ → Matrix ι ι K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n i,
      D (u n i) - ∑ j, S n i j • u (n + 1) j ∈ matrixPacketFiltration (K := K) u (n + 1))
    (n : ℕ) (c : ι → K) :
    D (∑ j, c j • u n j) -
        ∑ jj, (∑ j, c j * S n j jj) • u (n + 1) jj ∈
      matrixPacketFiltration (K := K) u (n + 1) := by
  have hmem : ((∑ j, D₀ (c j) • u n j) +
      ∑ j, c j • (D (u n j) - ∑ jj, S n j jj • u (n + 1) jj)) ∈
      matrixPacketFiltration (K := K) u (n + 1) :=
    Submodule.add_mem _
      (Submodule.sum_mem _ fun j _ ↦
        (matrixPacketFiltration (K := K) u (n + 1)).smul_mem _
          (matrixPacketFiltration_source_mem (K := K) u (Nat.lt_succ_self n) j))
      (Submodule.sum_mem _ fun j _ ↦
        (matrixPacketFiltration (K := K) u (n + 1)).smul_mem _ (hstep n j))
  convert hmem using 1
  rw [map_sum]
  simp only [derivation_ksmul_eq D₀ D hcompat, smul_sub, Finset.smul_sum, smul_smul]
  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_comm (γ := ι) (f := fun j jj ↦ (c j * S n j jj) • u (n + 1) jj)]
  simp only [← Finset.sum_smul]
  abel

omit [DecidableEq ι] in
/-- The two-layer coefficient of a composite law is the row-order product of consecutive matrix
symbols, modulo the filtration. -/
theorem law_comp_sub_matrixSymbolProduct_smul_mem
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (A B : g) (n : ℕ) (i : ι) :
    law A (law B (u n i)) -
        ∑ jj, (symbol n B * symbol (n + 1) A) i jj • u (n + 2) jj ∈
      matrixPacketFiltration (K := K) u (n + 2) := by
  have hr : law B (u n i) - ∑ j, symbol n B i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1) := hstep B n i
  have hAr : law A (law B (u n i) - ∑ j, symbol n B i j • u (n + 1) j) ∈
      matrixPacketFiltration (K := K) u (n + 2) :=
    derivation_matrixPacketFiltration_succ (coefficientLaw A) (law A) u
      (fun m ↦ symbol m A) (hcompat A) (fun m j ↦ hstep A m j) (n + 1) hr
  have hrow := derivation_rowCombination_sub_mem (coefficientLaw A) (law A) u
      (fun m ↦ symbol m A) (hcompat A) (fun m j ↦ hstep A m j) (n + 1)
      (fun j ↦ symbol n B i j)
  have hsum := Submodule.add_mem _ hAr hrow
  convert hsum using 1
  rw [map_sub]
  simp only [Matrix.mul_apply]
  abel

omit [DecidableEq ι] in
/-- **Curvature vanishing from commutator closure.**  If the filtered law family closes under
commutator, the matrix coefficient principal curvature of its symbols vanishes identically. -/
theorem matrixCoefficientPrincipalCurvature_eq_zero_of_commutatorClosure
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2))
    (bracket : g → g → g)
    (hclosure : ∀ A B : g, ∀ x : L,
      law A (law B x) - law B (law A x) = law (bracket A B) x) :
    ∀ n A B, matrixCoefficientPrincipalCurvature symbol n A B = 0 := by
  intro n A B
  ext i jj
  have hAB := law_comp_sub_matrixSymbolProduct_smul_mem
    law coefficientLaw symbol u hcompat hstep A B n i
  have hBA := law_comp_sub_matrixSymbolProduct_smul_mem
    law coefficientLaw symbol u hcompat hstep B A n i
  have hsub := (matrixPacketFiltration (K := K) u (n + 2)).sub_mem hAB hBA
  have hswap :
      law A (law B (u n i)) - ∑ q, (symbol n B * symbol (n + 1) A) i q • u (n + 2) q -
        (law B (law A (u n i)) - ∑ q, (symbol n A * symbol (n + 1) B) i q • u (n + 2) q) =
      law (bracket A B) (u n i) -
        ∑ q, matrixCoefficientPrincipalCurvature symbol n A B i q • u (n + 2) q := by
    rw [← hclosure A B (u n i)]
    simp only [matrixCoefficientPrincipalCurvature, Matrix.sub_apply, sub_smul,
      Finset.sum_sub_distrib]
    abel
  rw [hswap] at hsub
  have hlaw : law (bracket A B) (u n i) ∈ matrixPacketFiltration (K := K) u (n + 2) := by
    have h1 : law (bracket A B) (u n i) -
        ∑ j, symbol n (bracket A B) i j • u (n + 1) j ∈
        matrixPacketFiltration (K := K) u (n + 2) :=
      matrixPacketFiltration_mono (K := K) u (Nat.le_succ (n + 1))
        (hstep (bracket A B) n i)
    have h2 : (∑ j, symbol n (bracket A B) i j • u (n + 1) j) ∈
        matrixPacketFiltration (K := K) u (n + 2) :=
      Submodule.sum_mem _ fun j _ ↦
        (matrixPacketFiltration (K := K) u (n + 2)).smul_mem _
          (matrixPacketFiltration_source_mem (K := K) u (Nat.lt_succ_self (n + 1)) j)
    simpa only [sub_add_cancel] using
      (matrixPacketFiltration (K := K) u (n + 2)).add_mem h1 h2
  have hcomb : (∑ q, matrixCoefficientPrincipalCurvature symbol n A B i q • u (n + 2) q) ∈
      matrixPacketFiltration (K := K) u (n + 2) := by
    have := (matrixPacketFiltration (K := K) u (n + 2)).sub_mem hlaw hsub
    simpa only [sub_sub_cancel] using this
  have hzero := matrixPacket_layer_coefficients_eq_zero_of_mem_filtration
    u hu (n + 2) _ hcomb
  simpa using hzero jj

omit [DecidableEq ι] in
/-- Commutator closure forces coefficient flatness of the matrix symbol tower. -/
theorem matrixCoefficientPrincipalSymbolFlat_of_commutatorClosure
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2))
    (bracket : g → g → g)
    (hclosure : ∀ A B : g, ∀ x : L,
      law A (law B x) - law B (law A x) = law (bracket A B) x) :
    MatrixCoefficientPrincipalSymbolFlat symbol :=
  (matrixCoefficientPrincipalSymbolFlat_iff_curvature_zero symbol).mpr
    (matrixCoefficientPrincipalCurvature_eq_zero_of_commutatorClosure
      law coefficientLaw symbol u hcompat hstep hu bracket hclosure)

omit [DecidableEq ι] in
/-- A nonzero matrix coefficient curvature entry is an unconditional obstruction to closing the
candidate laws under commutator inside the same first-order filtered class. -/
theorem no_commutatorClosure_of_matrixCoefficientPrincipalCurvature_ne_zero
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2))
    (n : ℕ) (A B : g)
    (hcurv : matrixCoefficientPrincipalCurvature symbol n A B ≠ 0) :
    ¬ ∃ bracket : g → g → g, ∀ C D : g, ∀ x : L,
      law C (law D x) - law D (law C x) = law (bracket C D) x := by
  rintro ⟨bracket, hclosure⟩
  exact hcurv (matrixCoefficientPrincipalCurvature_eq_zero_of_commutatorClosure
    law coefficientLaw symbol u hcompat hstep hu bracket hclosure n A B)

/-! ## From the one-step law to the complete jet packet -/

/-- Ordered products of consecutive matrix principal symbols in coefficient-row order. -/
def matrixSymbolLayerProduct (S : ℕ → Matrix ι ι K) : ℕ → Matrix ι ι K
  | 0 => 1
  | n + 1 => matrixSymbolLayerProduct S n * S n

theorem matrixSymbolLayerProduct_det (S : ℕ → Matrix ι ι K) (n : ℕ) :
    (matrixSymbolLayerProduct S n).det = ∏ m ∈ Finset.range n, (S m).det := by
  induction n with
  | zero => simp [matrixSymbolLayerProduct]
  | succ n ih =>
      rw [matrixSymbolLayerProduct, Matrix.det_mul, ih, Finset.prod_range_succ]

theorem matrixSymbolLayerProduct_det_ne_zero_iff (S : ℕ → Matrix ι ι K) :
    (∀ n, (matrixSymbolLayerProduct S n).det ≠ 0) ↔ ∀ n, (S n).det ≠ 0 := by
  constructor
  · intro h n hzero
    apply h (n + 1)
    rw [matrixSymbolLayerProduct_det]
    exact Finset.prod_eq_zero (Finset.self_mem_range_succ n) hzero
  · intro h n
    rw [matrixSymbolLayerProduct_det]
    exact Finset.prod_ne_zero_iff.mpr fun m _ ↦ h m

/-- The complete jet of a 0-layer observable expands over the packet grid with diagonal blocks
equal to the ordered symbol products. -/
theorem selectedDerivationJet_sub_layerProduct_mem
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (u : ℕ → ι → L) (S : ℕ → Matrix ι ι K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n i,
      D (u n i) - ∑ j, S n i j • u (n + 1) j ∈ matrixPacketFiltration (K := K) u (n + 1))
    (i : ι) (n : ℕ) :
    selectedDerivationJet D n (u 0 i) -
        ∑ j, matrixSymbolLayerProduct S n i j • u n j ∈
      matrixPacketFiltration (K := K) u n := by
  induction n with
  | zero =>
      have hone : (∑ j, matrixSymbolLayerProduct S 0 i j • u 0 j) = u 0 i := by
        simp [matrixSymbolLayerProduct, Matrix.one_apply, ite_smul]
      simp [selectedDerivationJet, hone]
  | succ n ih =>
      have hDw : D (selectedDerivationJet D n (u 0 i) -
          ∑ j, matrixSymbolLayerProduct S n i j • u n j) ∈
          matrixPacketFiltration (K := K) u (n + 1) :=
        derivation_matrixPacketFiltration_succ D₀ D u S hcompat hstep n ih
      have hrow := derivation_rowCombination_sub_mem D₀ D u S hcompat hstep n
        (fun j ↦ matrixSymbolLayerProduct S n i j)
      have hsum := Submodule.add_mem _ hDw hrow
      have hiter : selectedDerivationJet D (n + 1) (u 0 i) =
          D (selectedDerivationJet D n (u 0 i)) := by
        simp only [selectedDerivationJet, Function.iterate_succ_apply']
      rw [hiter]
      convert hsum using 1
      rw [map_sub]
      have hprod : ∀ jj, matrixSymbolLayerProduct S (n + 1) i jj =
          ∑ j, matrixSymbolLayerProduct S n i j * S n j jj := by
        intro jj
        rw [matrixSymbolLayerProduct, Matrix.mul_apply]
      simp only [hprod]
      abel

/-- The one-step matrix filtration law generates the explicit strict-lower-layer packet law for
the complete jets, with the ordered symbol products as diagonal blocks. -/
theorem matrixPrincipalLowerLaw_of_filtrationStep
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (u : ℕ → ι → L) (S : ℕ → Matrix ι ι K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n i,
      D (u n i) - ∑ j, S n i j • u (n + 1) j ∈ matrixPacketFiltration (K := K) u (n + 1)) :
    MatrixPrincipalLowerLaw u
      (fun n i ↦ selectedDerivationJet D n (u 0 i))
      (matrixSymbolLayerProduct S) := by
  classical
  intro N
  choose d hd using fun (p : Fin N × ι) ↦
    (Submodule.mem_span_range_iff_exists_fun K).mp
      (selectedDerivationJet_sub_layerProduct_mem D₀ D u S hcompat hstep p.2 (p.1 : ℕ))
  refine ⟨fun p q ↦
    if h : (q.1 : ℕ) < (p.1 : ℕ) then d p (⟨(q.1 : ℕ), h⟩, q.2) else 0, ?_, ?_⟩
  · intro p q hpq
    have hnot : ¬ (q.1 : ℕ) < (p.1 : ℕ) := not_lt.mpr hpq
    simp [hnot]
  · funext p
    have hdp := hd p
    have hsplit :
        (∑ q : Fin N × ι,
            (if h : (q.1 : ℕ) < (p.1 : ℕ) then d p (⟨(q.1 : ℕ), h⟩, q.2) else 0) •
              u (q.1 : ℕ) q.2) =
          ∑ q : Fin (p.1 : ℕ) × ι, d p q • u (q.1 : ℕ) q.2 := by
      rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
      have hleft :
          (∑ a : Fin N, ∑ j : ι,
              (if h : (a : ℕ) < (p.1 : ℕ) then d p (⟨(a : ℕ), h⟩, j) else 0) •
                u (a : ℕ) j) =
            ∑ m ∈ Finset.range N, ∑ j : ι,
              (if h : m < (p.1 : ℕ) then d p (⟨m, h⟩, j) else 0) • u m j :=
        Fin.sum_univ_eq_sum_range
          (fun m ↦ ∑ j : ι,
            (if h : m < (p.1 : ℕ) then d p (⟨m, h⟩, j) else 0) • u m j) N
      have hright :
          (∑ b : Fin (p.1 : ℕ), ∑ j : ι, d p (b, j) • u (b : ℕ) j) =
            ∑ m ∈ Finset.range (p.1 : ℕ), ∑ j : ι,
              (if h : m < (p.1 : ℕ) then d p (⟨m, h⟩, j) else 0) • u m j := by
        rw [← Fin.sum_univ_eq_sum_range
          (fun m ↦ ∑ j : ι,
            (if h : m < (p.1 : ℕ) then d p (⟨m, h⟩, j) else 0) • u m j) (p.1 : ℕ)]
        apply Finset.sum_congr rfl
        intro b _
        apply Finset.sum_congr rfl
        intro j _
        rw [dif_pos b.isLt]
      rw [hleft, hright]
      symm
      apply Finset.sum_subset (Finset.range_subset_range.mpr (Nat.le_of_lt p.1.isLt))
      intro m _ hm
      have hnot : ¬ m < (p.1 : ℕ) := by
        simpa using hm
      simp [hnot]
    change selectedDerivationJet D (p.1 : ℕ) (u 0 p.2) = _
    rw [matrixLinearForms]
    simp only [Matrix.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    have hdiag :
        (∑ q : Fin N × ι,
            algebraMap K L
              (matrixPrincipalBlockDiagonal
                (fun m : Fin N ↦ matrixSymbolLayerProduct S (m : ℕ)) p q) *
              u (q.1 : ℕ) q.2) =
          ∑ j, matrixSymbolLayerProduct S (p.1 : ℕ) p.2 j • u (p.1 : ℕ) j := by
      rw [Fintype.sum_prod_type]
      have hterm : ∀ a : Fin N,
          (∑ j : ι,
              algebraMap K L
                (matrixPrincipalBlockDiagonal
                  (fun m : Fin N ↦ matrixSymbolLayerProduct S (m : ℕ)) p (a, j)) *
                u (a : ℕ) j) =
            if p.1 = a then
              ∑ j, matrixSymbolLayerProduct S (p.1 : ℕ) p.2 j • u (p.1 : ℕ) j
            else 0 := by
        intro a
        by_cases hpa : p.1 = a
        · subst hpa
          rw [if_pos rfl]
          apply Finset.sum_congr rfl
          intro j _
          rw [Algebra.smul_def]
          congr 1
          show algebraMap K L
            (matrixPrincipalBlockDiagonal
              (fun m : Fin N ↦ matrixSymbolLayerProduct S (m : ℕ)) p (p.1, j)) = _
          unfold matrixPrincipalBlockDiagonal
          rw [if_pos rfl]
        · rw [if_neg hpa]
          apply Finset.sum_eq_zero
          intro j _
          show algebraMap K L
            (matrixPrincipalBlockDiagonal
              (fun m : Fin N ↦ matrixSymbolLayerProduct S (m : ℕ)) p (a, j)) *
            u (a : ℕ) j = 0
          unfold matrixPrincipalBlockDiagonal
          rw [if_neg hpa]
          simp
      simp only [hterm]
      rw [Finset.sum_ite_eq]
      simp
    have hlower :
        (∑ q : Fin N × ι,
            algebraMap K L
              (if h : (q.1 : ℕ) < (p.1 : ℕ) then d p (⟨(q.1 : ℕ), h⟩, q.2) else 0) *
              u (q.1 : ℕ) q.2) =
          selectedDerivationJet D (p.1 : ℕ) (u 0 p.2) -
            ∑ j, matrixSymbolLayerProduct S (p.1 : ℕ) p.2 j • u (p.1 : ℕ) j := by
      calc
        (∑ q : Fin N × ι,
            algebraMap K L
              (if h : (q.1 : ℕ) < (p.1 : ℕ) then d p (⟨(q.1 : ℕ), h⟩, q.2) else 0) *
              u (q.1 : ℕ) q.2) =
            ∑ q : Fin N × ι,
              (if h : (q.1 : ℕ) < (p.1 : ℕ) then d p (⟨(q.1 : ℕ), h⟩, q.2) else 0) •
                u (q.1 : ℕ) q.2 := by
          apply Finset.sum_congr rfl
          intro q _
          rw [Algebra.smul_def]
        _ = ∑ q : Fin (p.1 : ℕ) × ι, d p q • u (q.1 : ℕ) q.2 := hsplit
        _ = _ := hdp
    rw [hdiag, hlower]
    abel

/-- **Exact complete-packet criterion from the one-step law.**  The complete jet packet of the
0-layer observables is differentially independent for the selected law exactly when every layer
symbol is invertible. -/
theorem filtrationStep_derivationIndependentOver_iff
    (D₀ : Derivation k K K) (D : Derivation k L L)
    (u : ℕ → ι → L) (S : ℕ → Matrix ι ι K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n i,
      D (u n i) - ∑ j, S n i j • u (n + 1) j ∈ matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2)) :
    DerivationIndependentOver K D (u 0) ↔ ∀ n, (S n).det ≠ 0 := by
  rw [derivationPrincipalLowerLaw_independent_iff u (u 0) D (matrixSymbolLayerProduct S)
    (matrixPrincipalLowerLaw_of_filtrationStep D₀ D u S hcompat hstep) hu]
  exact matrixSymbolLayerProduct_det_ne_zero_iff S

/-- The exact varying-law dependence spectrum of a filtered matrix law system is the determinant
characteristic set of its one-step symbols. -/
theorem filtrationStep_dependentSet_eq_characteristicSet
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2)) :
    derivationLawDependentSet (K := K) law (u 0) =
      matrixSymbolCharacteristicSet symbol := by
  ext A
  change (¬ DerivationIndependentOver K (law A) (u 0)) ↔ ∃ n, (symbol n A).det = 0
  rw [filtrationStep_derivationIndependentOver_iff (coefficientLaw A) (law A) u
    (fun n ↦ symbol n A) (hcompat A) (fun n i ↦ hstep A n i) hu]
  push Not
  rfl

/-- **Integrable holographic horizon.**  A commutator-closed finite-rank filtered law system has
either no jointly independent direction, or an exact dependence spectrum equal to the single
first-layer determinantal horizon.  Flatness is derived from Lie closure, not assumed. -/
theorem commutatorClosure_dependentSet_dichotomy
    (law : g → Derivation k L L) (coefficientLaw : g → Derivation k K K)
    (symbol : ℕ → g → Matrix ι ι K) (u : ℕ → ι → L)
    (hcompat : ∀ A a, law A (algebraMap K L a) = algebraMap K L (coefficientLaw A a))
    (hstep : ∀ A n i, law A (u n i) - ∑ j, symbol n A i j • u (n + 1) j ∈
      matrixPacketFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K (fun p : ℕ × ι ↦ u p.1 p.2))
    (bracket : g → g → g)
    (hclosure : ∀ A B : g, ∀ x : L,
      law A (law B x) - law B (law A x) = law (bracket A B) x) :
    derivationLawDependentSet (K := K) law (u 0) = Set.univ ∨
      ∃ A₀ : g, (∀ n, (symbol n A₀).det ≠ 0) ∧
        derivationLawDependentSet (K := K) law (u 0) =
          matrixSymbolSingularSet symbol 0 := by
  rw [filtrationStep_dependentSet_eq_characteristicSet
    law coefficientLaw symbol u hcompat hstep hu]
  exact matrixCoefficientPrincipalSymbolFlat_characteristicSet_dichotomy symbol
    (matrixCoefficientPrincipalSymbolFlat_of_commutatorClosure
      law coefficientLaw symbol u hcompat hstep hu bracket hclosure)

end

