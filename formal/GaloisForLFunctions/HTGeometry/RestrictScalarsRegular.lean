import GaloisForLFunctions.HTGeometry.GradeFiniteTransfer
import GaloisForLFunctions.HTGeometry.QuotientRegularSequence
import GaloisForLFunctions.HTGeometry.HomogIdealList
import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# A regular sequence over an algebra is regular over the base

```text
restrictScalars_map_smul_top   ** the extension of an ideal cuts the same submodule **
isWeaklyRegular_of_map         ** a sequence whose images are regular is regular over the base **
```

For a tower `A → D → N` the `D`-submodule generated by `I·N` and the `A`-submodule generated by
`I·N` have the same underlying set: the generators `r • n` already span a `D`-submodule, because
`d • (r • n) = r • (d • n)`.  So the two successive quotients along a regular sequence are the same
module with two scalar actions, and regularity of a scalar of `A` is the same statement on both.

This is what lets a depth computation carried out over `D` be used by an argument over `A` — a
projective-dimension count, say, which only sees the `A`-module structure.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Pointwise
open RingTheory.Sequence

universe u

variable {A D : Type u} [CommRing A] [CommRing D] [Algebra A D]
variable {N : Type u} [AddCommGroup N] [Module A N] [Module D N] [IsScalarTower A D N]

/-- **The extension of an ideal cuts the same submodule.** -/
theorem restrictScalars_map_smul_top (I : Ideal A) :
    Submodule.restrictScalars A ((Ideal.map (algebraMap A D) I) • (⊤ : Submodule D N))
      = I • (⊤ : Submodule A N) := by
  refine le_antisymm ?_ ?_
  · intro v hv
    have hv' : v ∈ (Ideal.map (algebraMap A D) I) • (⊤ : Submodule D N) := hv
    refine Submodule.smul_induction_on hv' ?_ ?_
    · intro d hd n _
      have hkey : ∀ (e : D), e ∈ Ideal.map (algebraMap A D) I →
          ∀ m : N, e • m ∈ I • (⊤ : Submodule A N) := by
        intro e he
        refine Submodule.span_induction (p := fun z _ => ∀ m : N, z • m ∈ I • (⊤ : Submodule A N))
          ?_ ?_ ?_ ?_ he
        · rintro _ ⟨r, hr, rfl⟩ m
          have : (algebraMap A D) r • m = r • m := algebraMap_smul D r m
          rw [this]
          exact Submodule.smul_mem_smul hr trivial
        · intro m
          simp
        · intro a b _ _ ha hb m
          rw [add_smul]
          exact Submodule.add_mem _ (ha m) (hb m)
        · intro a b _ hb m
          have : (a * b) • m = b • (a • m) := by
            rw [mul_comm, mul_smul]
          rw [smul_eq_mul, this]
          exact hb (a • m)
      exact hkey d hd n
    · intro y z hy hz
      exact Submodule.add_mem _ hy hz
  · refine Submodule.smul_le.2 fun r hr n _ => ?_
    have hmem : (algebraMap A D) r ∈ Ideal.map (algebraMap A D) I := Ideal.mem_map_of_mem _ hr
    have hv : (algebraMap A D) r • n ∈ (Ideal.map (algebraMap A D) I) • (⊤ : Submodule D N) :=
      Submodule.smul_mem_smul hmem trivial
    have : r • n = (algebraMap A D) r • n := (algebraMap_smul D r n).symm
    rw [this]
    exact hv

/-- **A sequence whose images are regular is regular over the base.** -/
theorem isWeaklyRegular_of_map {rs : List A}
    (h : IsWeaklyRegular N (rs.map (algebraMap A D))) : IsWeaklyRegular N rs := by
  refine ⟨fun i hi => ?_⟩
  have hi' : i < (rs.map (algebraMap A D)).length := by rwa [List.length_map]
  have hreg := h.regular_mod_prev i hi'
  rw [← List.map_take, List.getElem_map] at hreg
  have hsub : Submodule.restrictScalars A
      ((Ideal.ofList ((rs.take i).map (algebraMap A D))) • (⊤ : Submodule D N))
      = (Ideal.ofList (rs.take i)) • (⊤ : Submodule A N) := by
    rw [← map_ofList]
    exact restrictScalars_map_smul_top _
  have e1 := Submodule.Quotient.restrictScalarsEquiv (S := A)
    ((Ideal.ofList ((rs.take i).map (algebraMap A D))) • (⊤ : Submodule D N))
  have hreg' : IsSMulRegular (N ⧸ Submodule.restrictScalars A
      ((Ideal.ofList ((rs.take i).map (algebraMap A D))) • (⊤ : Submodule D N))) rs[i] := by
    rw [isSMulRegular_congr e1]
    intro a b hab
    exact hreg (by simpa [algebraMap_smul] using hab)
  rw [isSMulRegular_congr (Submodule.quotEquivOfEq _ _ hsub)] at hreg'
  exact hreg'

end GaloisForLFunctions.HTGeometry
