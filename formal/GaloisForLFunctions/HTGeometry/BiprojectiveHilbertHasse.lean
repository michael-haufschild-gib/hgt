import GaloisForLFunctions.HTGeometry.HasseExactSequence
import GaloisForLFunctions.HTGeometry.BiprojectiveHilbertBezout

/-!
# Hasse exactness for adjoining a bihomogeneous equation

Multiplication by a bihomogeneous equation, the old quotient piece, and the quotient after adjoining
that equation form an exact, right-surjective sequence.  Thus old local classes modulo classes
globally generated by the new equation are exactly classes in the new quotient piece.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable local instance biprojectiveHasseWeightedGradedAlgebra
    (K : Type*) [Field K] (m n : ℕ) :
    GradedAlgebra
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)) :=
  MvPolynomial.weightedGradedAlgebra K biprojectiveWeight

/-- Multiplication by a bihomogeneous equation and passage to the enlarged ideal form an exact pair. -/
theorem biprojectiveEquation_hasse_exact
    (K : Type*) [Field K] {m n : ℕ}
    (I : Ideal (BiprojRing K m n))
    (hI : I.IsHomogeneous
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)))
    (f : BiprojRing K m n) {a b : ℕ}
    (hf : f.IsWeightedHomogeneous biprojectiveWeight (a, b)) (p q : ℕ) :
    Function.Exact (biprojectiveQuotientMul K I f hf p q)
      (biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
        le_sup_left (a + p) (b + q)) :=
  LinearMap.exact_iff.mpr
    (range_biprojectiveQuotientMul_eq_ker_factor K I hI f hf p q).symm

/-- **Biprojective equation Hasse quotient.**  Old local classes modulo multiplication by the new
equation are exactly classes after adjoining that equation to the ideal. -/
noncomputable def biprojectiveEquationHasseQuotientEquiv
    (K : Type*) [Field K] {m n : ℕ}
    (I : Ideal (BiprojRing K m n))
    (hI : I.IsHomogeneous
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)))
    (f : BiprojRing K m n) {a b : ℕ}
    (hf : f.IsWeightedHomogeneous biprojectiveWeight (a, b)) (p q : ℕ) :
    (BiprojectiveQuotientPiece K I (a + p) (b + q) ⧸
      LinearMap.range (biprojectiveQuotientMul K I f hf p q)) ≃ₗ[K]
      BiprojectiveQuotientPiece K (I ⊔ Ideal.span {f}) (a + p) (b + q) :=
  linearHasseQuotientEquiv (biprojectiveQuotientMul K I f hf p q)
    (biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q))
    (biprojectiveEquation_hasse_exact K I hI f hf p q)
    (biprojectiveQuotientFactor_surjective K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q))

@[simp]
theorem biprojectiveEquationHasseQuotientEquiv_mk
    (K : Type*) [Field K] {m n : ℕ}
    (I : Ideal (BiprojRing K m n))
    (hI : I.IsHomogeneous
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)))
    (f : BiprojRing K m n) {a b : ℕ}
    (hf : f.IsWeightedHomogeneous biprojectiveWeight (a, b)) (p q : ℕ)
    (x : BiprojectiveQuotientPiece K I (a + p) (b + q)) :
    biprojectiveEquationHasseQuotientEquiv K I hI f hf p q
        (Submodule.Quotient.mk x) =
      biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
        le_sup_left (a + p) (b + q) x :=
  linearHasseQuotientEquiv_mk (biprojectiveQuotientMul K I f hf p q)
    (biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q))
    (biprojectiveEquation_hasse_exact K I hI f hf p q)
    (biprojectiveQuotientFactor_surjective K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q)) x

/-- An old quotient class is generated by the new equation exactly when it vanishes after adjoining
that equation. -/
theorem biprojectiveEquation_exists_mul_preimage_iff_factor_eq_zero
    (K : Type*) [Field K] {m n : ℕ}
    (I : Ideal (BiprojRing K m n))
    (hI : I.IsHomogeneous
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)))
    (f : BiprojRing K m n) {a b : ℕ}
    (hf : f.IsWeightedHomogeneous biprojectiveWeight (a, b)) (p q : ℕ)
    (x : BiprojectiveQuotientPiece K I (a + p) (b + q)) :
    (∃ y, biprojectiveQuotientMul K I f hf p q y = x) ↔
      biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
        le_sup_left (a + p) (b + q) x = 0 := by
  change x ∈ LinearMap.range (biprojectiveQuotientMul K I f hf p q) ↔
    x ∈ LinearMap.ker (biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q))
  rw [range_biprojectiveQuotientMul_eq_ker_factor K I hI f hf p q]

/-- Two old quotient classes differ by multiplication with the new equation exactly when their
images in the enlarged-ideal quotient agree. -/
theorem biprojectiveEquation_congr_hasse_iff
    (K : Type*) [Field K] {m n : ℕ}
    (I : Ideal (BiprojRing K m n))
    (hI : I.IsHomogeneous
      (weightedHomogeneousSubmodule K
        (biprojectiveWeight : BiprojVar m n → ℕ × ℕ)))
    (f : BiprojRing K m n) {a b : ℕ}
    (hf : f.IsWeightedHomogeneous biprojectiveWeight (a, b)) (p q : ℕ)
    (x y : BiprojectiveQuotientPiece K I (a + p) (b + q)) :
    x - y ∈ LinearMap.range (biprojectiveQuotientMul K I f hf p q) ↔
      biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
          le_sup_left (a + p) (b + q) x =
        biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
          le_sup_left (a + p) (b + q) y :=
  linearHasse_congr_iff (biprojectiveQuotientMul K I f hf p q)
    (biprojectiveQuotientFactor K I (I ⊔ Ideal.span {f})
      le_sup_left (a + p) (b + q))
    (biprojectiveEquation_hasse_exact K I hI f hf p q) x y

end GaloisForLFunctions.HTGeometry
