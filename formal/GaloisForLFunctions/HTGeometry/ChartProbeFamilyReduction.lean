import GaloisForLFunctions.HTGeometry.CoupledAllVertexMaximalLeafExtension
import GaloisForLFunctions.HTGeometry.HermitianTransitionFamilyReduction

/-!
# Physical chart probes as the next spectral-coordinate observer family

At a simple-spectrum point, every physical probe induces a matrix on the
labeled energy coordinates.  Hermitian probes induce Hermitian matrices,
and their family support is exactly the chart support graph.  This is the
coordinate bridge needed to iterate the coupled leaf-extension theorem.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Matrix of one physical observable in the labeled adjugate-column
eigenvectors of a local-extension chart. -/
def LocalExtensionEigenbranchChart.probeMatrix
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (O : Matrix (I × ρ) (I × ρ) ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    Matrix (I × ρ) (I × ρ) ℂ :=
  fun x y =>
    C.sesquilinearProbe energy shift attachment x y O p

/-- Matrix whose columns are the chart's labeled adjugate eigenvectors. -/
def LocalExtensionEigenbranchChart.eigenvectorMatrix
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    Matrix (I × ρ) (I × ρ) ℂ :=
  fun i x =>
    C.adjugateColumn energy shift attachment x p i

/-- The spectral-coordinate probe matrix is the exact Hermitian congruence
of the physical probe by the adjugate eigenvector matrix. -/
theorem LocalExtensionEigenbranchChart.probeMatrix_eq_congruence
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (O : Matrix (I × ρ) (I × ρ) ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    C.probeMatrix energy shift attachment O p =
      (C.eigenvectorMatrix energy shift attachment p).conjTranspose *
        O * C.eigenvectorMatrix energy shift attachment p := by
  ext x y
  simp only [LocalExtensionEigenbranchChart.probeMatrix,
    LocalExtensionEigenbranchChart.sesquilinearProbe,
    LocalExtensionEigenbranchChart.eigenvectorMatrix,
    Matrix.mul_apply, Matrix.conjTranspose_apply]
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]

/-- Hermiticity survives passage to labeled spectral coordinates. -/
theorem LocalExtensionEigenbranchChart.probeMatrix_isHermitian
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (O : Matrix (I × ρ) (I × ρ) ℂ)
    (hO : O.IsHermitian)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    (C.probeMatrix energy shift attachment O p).IsHermitian := by
  rw [C.probeMatrix_eq_congruence energy shift attachment O p]
  exact Matrix.isHermitian_conjTranspose_mul_mul _ hO

/-- For a Hermitian matrix, transition support is equivalent to one
oriented off-diagonal entry being nonzero. -/
theorem transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
    {α : Type*}
    (A : Matrix α α ℂ) (hA : A.IsHermitian)
    (x y : α) :
    (transitionSupportGraph A).Adj x y ↔
      x ≠ y ∧ A x y ≠ 0 := by
  constructor
  · intro h
    exact ⟨h.1, fun hzero => h.2 (by simp [hzero])⟩
  · rintro ⟨hxy, hentry⟩
    refine ⟨hxy, mul_ne_zero hentry ?_⟩
    rw [← hA.apply y x]
    simpa using hentry

/-- Spectral-coordinate family generated by probes on the old-system
factor. -/
def LocalExtensionEigenbranchChart.oldProbeMatrixFamily
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (q : η) :
    Matrix (I × ρ) (I × ρ) ℂ :=
  C.probeMatrix energy shift attachment
    (layerMatrixCoupling (probe q)
      (1 : Matrix ρ ρ ℂ)) p

/-- Spectral-coordinate family generated by probes on the new factor. -/
def LocalExtensionEigenbranchChart.newProbeMatrixFamily
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (q : η) :
    Matrix (I × ρ) (I × ρ) ℂ :=
  C.probeMatrix energy shift attachment
    (layerMatrixCoupling (1 : Matrix I I ℂ)
      (probe q)) p

theorem LocalExtensionEigenbranchChart.oldProbeMatrixFamily_isHermitian
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (hprobe : ∀ q, (probe q).IsHermitian)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (q : η) :
    (C.oldProbeMatrixFamily
      energy shift attachment probe p q).IsHermitian := by
  exact C.probeMatrix_isHermitian energy shift attachment _
    (layerMatrixCoupling_isHermitian
      (hprobe q) Matrix.isHermitian_one) p

theorem LocalExtensionEigenbranchChart.newProbeMatrixFamily_isHermitian
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (hprobe : ∀ q, (probe q).IsHermitian)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (q : η) :
    (C.newProbeMatrixFamily
      energy shift attachment probe p q).IsHermitian := by
  exact C.probeMatrix_isHermitian energy shift attachment _
    (layerMatrixCoupling_isHermitian
      Matrix.isHermitian_one (hprobe q)) p

/-- The union support of the old-factor spectral-coordinate probe matrices
is exactly the chart's old-observer support graph. -/
theorem transitionFamilySupportGraph_oldProbeMatrixFamily
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix I I ℂ)
    (hprobe : ∀ q, (probe q).IsHermitian)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    transitionFamilySupportGraph
        (C.oldProbeMatrixFamily
          energy shift attachment probe p) =
      oldSystemLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p := by
  ext x y
  constructor
  · rintro ⟨q, hq⟩
    have hqHermitian :=
      C.oldProbeMatrixFamily_isHermitian
        energy shift attachment probe hprobe p q
    obtain ⟨hxy, hentry⟩ :=
      (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
        _ hqHermitian x y).mp hq
    exact ⟨hxy, q, Or.inl hentry⟩
  · rintro ⟨hxy, q, hentry | hentry⟩
    · refine ⟨q,
        (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
          _ (C.oldProbeMatrixFamily_isHermitian
            energy shift attachment probe hprobe p q) x y).2
          ⟨hxy, hentry⟩⟩
    · have hyx :
          (transitionSupportGraph
            (C.oldProbeMatrixFamily
              energy shift attachment probe p q)).Adj y x :=
        (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
          _ (C.oldProbeMatrixFamily_isHermitian
            energy shift attachment probe hprobe p q) y x).2
          ⟨hxy.symm, hentry⟩
      exact ⟨q, hyx.symm⟩

/-- The union support of the new-factor spectral-coordinate probe matrices
is exactly the chart's new-observer support graph. -/
theorem transitionFamilySupportGraph_newProbeMatrixFamily
    {I ρ η : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (probe : η → Matrix ρ ρ ℂ)
    (hprobe : ∀ q, (probe q).IsHermitian)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ) :
    transitionFamilySupportGraph
        (C.newProbeMatrixFamily
          energy shift attachment probe p) =
      newLayerLocalExtensionChartProbeSupportGraph
        energy shift attachment C probe p := by
  ext x y
  constructor
  · rintro ⟨q, hq⟩
    have hqHermitian :=
      C.newProbeMatrixFamily_isHermitian
        energy shift attachment probe hprobe p q
    obtain ⟨hxy, hentry⟩ :=
      (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
        _ hqHermitian x y).mp hq
    exact ⟨hxy, q, Or.inl hentry⟩
  · rintro ⟨hxy, q, hentry | hentry⟩
    · refine ⟨q,
        (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
          _ (C.newProbeMatrixFamily_isHermitian
            energy shift attachment probe hprobe p q) x y).2
          ⟨hxy, hentry⟩⟩
    · have hyx :
          (transitionSupportGraph
            (C.newProbeMatrixFamily
              energy shift attachment probe p q)).Adj y x :=
        (transitionSupportGraph_adj_iff_entry_ne_zero_of_isHermitian
          _ (C.newProbeMatrixFamily_isHermitian
            energy shift attachment probe hprobe p q) y x).2
          ⟨hxy.symm, hentry⟩
      exact ⟨q, hyx.symm⟩

/-- Real energy label carried by one chart branch at a physical Hermitian
parameter. -/
def LocalExtensionEigenbranchChart.realBranchEnergy
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (i : I × ρ) : ℝ :=
  (C.branch i p).re

/-- Every labeled chart branch at a Hermitian point is exactly the
complexification of its real branch energy. -/
theorem LocalExtensionEigenbranchChart.branch_eq_realBranchEnergy
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp : p ∈ C.U)
    (hH :
      (localExtensionMatrix energy p.1 attachment p.2).IsHermitian)
    (i : I × ρ) :
    C.branch i p =
      (C.realBranchEnergy energy shift attachment p i : ℂ) := by
  apply Complex.ext
  · rfl
  · exact matrixCharpolyRelation_im_eq_zero_of_isHermitian
      _ hH _ (C.root p hp i)

/-- Maximal projective rank of the actual Hermitian spectrum transfers to
the chart's own labeled real branch packet.  Thus the chart labels, support
graphs, and next induction energy use one common coordinate system. -/
theorem LocalExtensionEigenbranchChart.realBranchEnergy_maximallyProjective
    {I ρ : Type*} [Fintype I] [Fintype ρ]
    [DecidableEq I] [DecidableEq ρ]
    (energy : I → ℂ) (shift : ρ → ℂ)
    (attachment : Matrix I I ℂ)
    (C : LocalExtensionEigenbranchChart energy shift attachment)
    (p : (ρ → ℂ) × Matrix ρ ρ ℂ)
    (hp : p ∈ C.U)
    (hH :
      (localExtensionMatrix energy p.1 attachment p.2).IsHermitian)
    (hmax :
      MaximallyProjectiveEnergy hH.eigenvalues) :
    MaximallyProjectiveEnergy
      (C.realBranchEnergy energy shift attachment p) := by
  have happears :
      ∀ i, ∃ j,
        C.realBranchEnergy energy shift attachment p i =
          hH.eigenvalues j := by
    intro i
    have hpoly :
        Polynomial.IsRoot
          (localExtensionMatrix energy p.1 attachment p.2).charpoly
          (C.branch i p) := by
      change
        (localExtensionMatrix energy p.1 attachment p.2).charpoly.eval
            (C.branch i p) = 0
      rw [Matrix.eval_charpoly]
      exact C.root p hp i
    have hspectrum :
        C.branch i p ∈
          spectrum ℂ
            (localExtensionMatrix energy p.1 attachment p.2) :=
      Matrix.mem_spectrum_iff_isRoot_charpoly.mpr hpoly
    rw [hH.spectrum_eq_image_range] at hspectrum
    obtain ⟨r, ⟨j, rfl⟩, hj⟩ := hspectrum
    refine ⟨j, ?_⟩
    have hbranch :
        C.branch i p = (hH.eigenvalues j : ℂ) :=
      hj.symm
    exact congrArg Complex.re hbranch
  choose σ hσ using happears
  have hσInjective : Function.Injective σ := by
    intro i j hij
    apply C.simple p hp
    change C.branch i p = C.branch j p
    rw [C.branch_eq_realBranchEnergy
      energy shift attachment p hp hH i]
    rw [C.branch_eq_realBranchEnergy
      energy shift attachment p hp hH j]
    rw [hσ i, hσ j, hij]
  let e : (I × ρ) ≃ (I × ρ) :=
    Equiv.ofBijective σ
      ⟨hσInjective,
        Finite.surjective_of_injective hσInjective⟩
  have heq :
      C.realBranchEnergy energy shift attachment p =
        fun i => hH.eigenvalues (e i) := by
    funext i
    exact hσ i
  rw [heq]
  exact maximallyProjectiveEnergy_equiv e hmax

end

end GaloisForLFunctions.HTGeometry
