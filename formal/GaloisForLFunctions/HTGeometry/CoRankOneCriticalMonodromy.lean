import GaloisForLFunctions.HTGeometry.CoRankOneCriticalCenteredPolynomial
import GaloisForLFunctions.HTGeometry.RankOneCriticalMonodromy

/-!
# Full actual monodromy in the right rank-one case

For `m > 0`, the actual extension
`criticalSourceField K m 1 / criticalObservationField K m 1` is generated by the negative
reciprocal constant coefficient.  Its minimal polynomial is centered generic after identifying
the actual observation field with the centered coefficient field plus one free parameter.  Thus
its normal closure has automorphism group `S_(m+1)`, and faithful action plus exact sheet count
forces literal full geometric monodromy.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Polynomial

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 4000000

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] {m : ℕ}

/-- Actual right-rank-one observation field as centered free-parameter base in the generic
splitting field. -/
noncomputable def coRankOneCriticalObservationToCenteredFracSubEquiv
    (hm : 0 < m) :
    criticalObservationField K m 1 ≃ₐ[K]
      fracSub (centeredCoeffField K m.succ) (centeredField K m.succ) := by
  let F := centeredCoeffField K m.succ
  let E := centeredField K m.succ
  let A := fracSub F E
  let gRing : FractionRing (Polynomial F) →+* A :=
    { toFun := fun x => ⟨fracEmbedRingHom F E x, by
        change ∃ y, fracEmbed F E y = fracEmbedRingHom F E x
        exact ⟨x, rfl⟩⟩
      map_one' := Subtype.ext (map_one (fracEmbedRingHom F E))
      map_mul' := fun x y => Subtype.ext (map_mul (fracEmbedRingHom F E) x y)
      map_zero' := Subtype.ext (map_zero (fracEmbedRingHom F E))
      map_add' := fun x y => Subtype.ext (map_add (fracEmbedRingHom F E) x y) }
  let g : FractionRing (Polynomial F) →ₐ[K] A :=
    { toRingHom := gRing
      commutes' := fun x => by
        apply Subtype.ext
        dsimp only [gRing]
        change fracEmbedRingHom F E
            (algebraMap K (FractionRing (Polynomial F)) x) =
          algebraMap K (FractionRing (Polynomial E)) x
        exact fracEmbedRingHom_algebraMap_base (k := K) (F := F) (E := E) x }
  have hg : Function.Bijective g := by
    constructor
    · intro x y hxy
      apply fracEmbedRingHom_injective (F := F) (E := E)
      dsimp only [g, gRing] at hxy
      exact congrArg Subtype.val hxy
    · intro y
      have hy := y.property
      change ∃ x, fracEmbed F E x = (y : FractionRing (Polynomial E)) at hy
      obtain ⟨x, hx⟩ := hy
      dsimp only [g, gRing]
      change ∃ x, (⟨fracEmbedRingHom F E x, _⟩ : A) = y
      exact ⟨x, Subtype.ext hx⟩
  simpa only [A] using
    (coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm).trans
      (AlgEquiv.ofBijective g hg)

theorem coRankOneCriticalObservationToCenteredFracSubEquiv_apply
    (hm : 0 < m) (x : criticalObservationField K m 1) :
    ((coRankOneCriticalObservationToCenteredFracSubEquiv (K := K) hm x :
        fracSub (centeredCoeffField K m.succ) (centeredField K m.succ)) :
      FractionRing (Polynomial (centeredField K m.succ))) =
      fracEmbedRingHom (centeredCoeffField K m.succ) (centeredField K m.succ)
        (coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm x) := by
  rfl

/-- Scalar action of actual co-rank-one observation field on centered generic splitting field. -/
@[reducible] noncomputable def coRankOneCriticalCenteredAmbientAlgebra
    (hm : 0 < m) :
    Algebra (criticalObservationField K m 1)
      (FractionRing (Polynomial (centeredField K m.succ))) := by
  let A := fracSub (centeredCoeffField K m.succ) (centeredField K m.succ)
  let ι : A →+* FractionRing (Polynomial (centeredField K m.succ)) :=
    { toFun := fun x => x.1
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  exact (ι.comp
    (coRankOneCriticalObservationToCenteredFracSubEquiv (K := K) hm).toRingHom).toAlgebra

/-- Centered generic field with one free parameter splits the actual right-rank-one polynomial. -/
theorem isSplittingField_coRankOneCriticalCenteredPolynomial
    (hm : 0 < m) :
    letI := coRankOneCriticalCenteredAmbientAlgebra (K := K) hm
    Polynomial.IsSplittingField
      (criticalObservationField K m 1)
      (FractionRing (Polynomial (centeredField K m.succ)))
      (coRankOneCriticalCenteredPolynomial (K := K) hm) := by
  let O := criticalObservationField K m 1
  let F := centeredCoeffField K m.succ
  let E := centeredField K m.succ
  let A := fracSub F E
  let Ω := FractionRing (Polynomial E)
  let p := coRankOneCriticalCenteredPolynomial (K := K) hm
  let q := centeredMonicE K m.succ
  let eB := coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm
  let eA := coRankOneCriticalObservationToCenteredFracSubEquiv (K := K) hm
  letI : Algebra F Ω := OreLocalization.instAlgebra
  letI : Algebra F A := A.algebra'
  letI : Algebra A Ω := A.toAlgebra
  have hsf : Polynomial.IsSplittingField A Ω
      (q.map (algebraMap F A)) :=
    isSplittingField_fracSub (F := F) (E := E)
      (p := q) centeredMonicE_ne_zero splits_centeredMonicE
        rootField_centeredMonicE_eq_top
  have hmapB : p.map eB.toRingHom =
      q.map (algebraMap F (FractionRing (Polynomial F))) :=
    map_coRankOneCriticalCenteredPolynomial_eq_centeredMonicE (K := K) hm
  have hmap : p.map eA.toRingHom = q.map (algebraMap F A) := by
    apply Polynomial.ext
    intro k
    apply Subtype.ext
    rw [Polynomial.coeff_map, Polynomial.coeff_map]
    change
      ((coRankOneCriticalObservationToCenteredFracSubEquiv (K := K) hm (p.coeff k) : A) : Ω) =
        ((algebraMap F A) (q.coeff k) : Ω)
    rw [coRankOneCriticalObservationToCenteredFracSubEquiv_apply]
    have hk := congrArg
      (fun r : Polynomial (FractionRing (Polynomial F)) => r.coeff k) hmapB
    simp only [Polynomial.coeff_map] at hk
    change coRankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hm (p.coeff k) =
      algebraMap F (FractionRing (Polynomial F)) (q.coeff k) at hk
    rw [hk]
    change fracEmbedRingHom F E
        (algebraMap F (FractionRing (Polynomial F)) (q.coeff k)) =
      algebraMap F Ω (q.coeff k)
    exact (fracEmbed F E).commutes (q.coeff k)
  letI : Algebra O Ω := coRankOneCriticalCenteredAmbientAlgebra (K := K) hm
  have hAlg : algebraMap O Ω = (algebraMap A Ω).comp eA.toRingHom := rfl
  haveI : Polynomial.IsSplittingField A Ω (p.map eA.toRingHom) := hmap ▸ hsf
  exact isSplittingField_map_algEquiv_of_algebraMap_eq eA.toRingEquiv hAlg p

/-- Actual normal closure splits the same right-rank-one centered polynomial. -/
theorem isSplittingField_criticalNormalClosure_coRankOneCenteredPolynomial
    (hm : 0 < m) :
    Polynomial.IsSplittingField
      (criticalObservationField K m 1)
      (criticalNormalClosure K m 1)
      (coRankOneCriticalCenteredPolynomial (K := K) hm) := by
  let O := criticalObservationField K m 1
  let S := criticalSourceField K m 1
  let N := criticalNormalClosure K m 1
  let y : S := -criticalSourceRecip K m 1 (⟨0, by omega⟩ : Fin (m + 1))
  letI : FiniteDimensional O S :=
    criticalSourceField_finiteDimensional_criticalObservationField K hm (by omega)
  letI : Algebra.IsSeparable O S := inferInstance
  letI : IsScalarTower O S (criticalSourceAlgebraicClosure K m 1) :=
    AlgebraicClosure.instIsScalarTower S
  letI : Algebra.IsAlgebraic O (criticalSourceAlgebraicClosure K m 1) :=
    Algebra.IsAlgebraic.trans O S (criticalSourceAlgebraicClosure K m 1)
  letI : Normal O (criticalSourceAlgebraicClosure K m 1) :=
    { splits' _ := IsAlgClosed.splits _ }
  letI : Normal O N :=
    normalClosure.normal O S (criticalSourceAlgebraicClosure K m 1)
  letI : Algebra.IsAlgebraic O S := inferInstance
  have hy : IsIntegral O y := IsIntegral.of_finite O y
  have hsf := isSplittingField_minpoly_of_isNormalClosure_of_adjoin_singleton_eq_top
    (F := O) (S := S) (L := N) y hy
      (coRankOneCriticalSourceField_adjoin_neg_recip_zero_eq_top (K := K) hm)
  rw [minpoly_neg_criticalSourceRecip_zero_eq_coRankOneCriticalCenteredPolynomial
    (K := K) hm] at hsf
  exact hsf

/-- Automorphisms of actual normal closure are full symmetric group on `m+1` letters. -/
noncomputable def coRankOneCriticalNormalClosurePermEquiv
    (hm : 0 < m) :
    (criticalNormalClosure K m 1 ≃ₐ[criticalObservationField K m 1]
      criticalNormalClosure K m 1) ≃* Equiv.Perm (Fin (m + 1)) := by
  let O := criticalObservationField K m 1
  let N := criticalNormalClosure K m 1
  let F := centeredCoeffField K m.succ
  let E := centeredField K m.succ
  let A := fracSub F E
  let Ω := FractionRing (Polynomial E)
  let p := coRankOneCriticalCenteredPolynomial (K := K) hm
  let eA := coRankOneCriticalObservationToCenteredFracSubEquiv (K := K) hm
  letI : Algebra O Ω := coRankOneCriticalCenteredAmbientAlgebra (K := K) hm
  letI : Algebra F Ω := OreLocalization.instAlgebra
  letI : Algebra A Ω := A.toAlgebra
  letI : Polynomial.IsSplittingField O N p :=
    isSplittingField_criticalNormalClosure_coRankOneCenteredPolynomial (K := K) hm
  letI : Polynomial.IsSplittingField O Ω p :=
    isSplittingField_coRankOneCriticalCenteredPolynomial (K := K) hm
  have hAlg : algebraMap O Ω = (algebraMap A Ω).comp eA.toRingHom := rfl
  exact (splittingFieldAutEquiv (F := O) (p := p) (L := N) (L' := Ω)).trans
    ((autEquivOfBaseEquiv eA.toRingEquiv hAlg).trans
      (centeredFreeParameterMonodromy K m.succ))

theorem natCard_criticalNormalClosureAut_coRankOne
    (hm : 0 < m) :
    Nat.card
        (criticalNormalClosure K m 1 ≃ₐ[criticalObservationField K m 1]
          criticalNormalClosure K m 1) =
      Nat.factorial (m + 1) := by
  calc
    Nat.card
        (criticalNormalClosure K m 1 ≃ₐ[criticalObservationField K m 1]
          criticalNormalClosure K m 1) =
        Nat.card (Equiv.Perm (Fin (m + 1))) :=
      Nat.card_congr (coRankOneCriticalNormalClosurePermEquiv (K := K) hm).toEquiv
    _ = Nat.factorial (m + 1) := by
      rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]

/-- Actual right-rank-one critical geometric monodromy is full symmetric group over every
algebraically closed characteristic-zero field. -/
theorem criticalGeometricMonodromy_one_right_eq_top
    (hm : 0 < m) :
    criticalGeometricMonodromy K m 1 = ⊤ := by
  classical
  let O := criticalObservationField K m 1
  let N := criticalNormalClosure K m 1
  let X := criticalGeometricSheet K m 1
  let G := N ≃ₐ[O] N
  letI : FiniteDimensional O N :=
    criticalNormalClosure_finiteDimensional K hm (by omega)
  letI : Fintype G := Fintype.ofFinite G
  letI : Finite (criticalGeometricSheet K m 1) :=
    finite_criticalGeometricSheet K hm (by omega)
  letI : Fintype X := Fintype.ofFinite X
  have hcardG : Fintype.card G = Nat.factorial (m + 1) := by
    rw [← Nat.card_eq_fintype_card]
    exact natCard_criticalNormalClosureAut_coRankOne (K := K) hm
  have hcardX : Fintype.card X = m + 1 := by
    rw [← Nat.card_eq_fintype_card,
      natCard_criticalGeometricSheet_eq_criticalHorizonMultiplicity K hm (by omega)]
    simp [criticalHorizonMultiplicity, Nat.add_comm]
  have hcard : Fintype.card G = Fintype.card (Equiv.Perm X) := by
    rw [hcardG, Fintype.card_perm, hcardX]
  have hbij : Function.Bijective (criticalNormalClosureAction K m 1) :=
    (Fintype.bijective_iff_injective_and_card (criticalNormalClosureAction K m 1)).2
      ⟨criticalNormalClosureAction_injective K hm (by omega), hcard⟩
  exact MonoidHom.range_eq_top.mpr hbij.surjective

end

end GaloisForLFunctions.HTGeometry
