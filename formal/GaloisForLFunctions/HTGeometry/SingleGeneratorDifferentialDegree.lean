import GaloisForLFunctions.HTGeometry.DifferentialSubfieldTransfer
import GaloisForLFunctions.HTGeometry.DifferentialTranscendenceDegree

/-!
# One hypertranscendental generator has differential transcendence degree one

The differential field generated by a single hypertranscendental element is a one-dimensional
differential extension: the generator is a differential transcendence basis of it.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

universe u

/-- **A single hypertranscendental generator spans exactly one differential dimension.** -/
theorem differentialTranscendenceDegree_differentialAdjoin_singleton_eq_one
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h : E} (hh : HypertranscendentalOver F h) :
    letI := derivationClosedDifferential (differentialAdjoin F ({h} : Set E))
      (derivationClosed_differentialAdjoin F ({h} : Set E))
    differentialTranscendenceDegree F (differentialAdjoin F ({h} : Set E)) = 1 := by
  classical
  have key : ∀ S : Set E, S = Set.range (fun _ : PUnit.{u + 1} => h) →
      letI := derivationClosedDifferential (differentialAdjoin F S)
        (derivationClosed_differentialAdjoin F S)
      differentialTranscendenceDegree F (differentialAdjoin F S) = 1 := by
    rintro S rfl
    have hind : DifferentialIndependent F (fun _ : PUnit.{u + 1} => h) := by
      have hUnit : DifferentialIndependent F (fun _ : Unit => h) :=
        (hypertranscendentalOver_iff_differentialIndependent_singleton F h).1 hh
      exact hUnit.comp (fun _ : PUnit.{u + 1} => (() : Unit))
        (fun a b _ => by cases a; cases b; rfl)
    letI := derivationClosedDifferential
      (differentialAdjoin F (Set.range fun _ : PUnit.{u + 1} => h))
      (derivationClosed_differentialAdjoin F _)
    have hlift : DifferentialIndependent F (adjoinLift F fun _ : PUnit.{u + 1} => h) :=
      differentialIndependent_subfield _ (derivationClosed_differentialAdjoin F _) _
        (by simpa using hind)
    have hdeg :=
      differentialTranscendenceDegree_eq_cardinalMk_of_differentialIndependent_of_adjoin_eq_top
        (adjoinLift F fun _ : PUnit.{u + 1} => h) hlift
        (differentialAdjoin_adjoinLift_eq_top fun _ : PUnit.{u + 1} => h)
    simpa using hdeg
  exact key {h} (by simp)

end

end GaloisForLFunctions.HTGeometry
