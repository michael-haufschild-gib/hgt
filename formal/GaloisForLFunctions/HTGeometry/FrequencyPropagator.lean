import GaloisForLFunctions.HTGeometry.GammaPhaseFactor
import GaloisForLFunctions.HTGeometry.BoundedResolventNeumann
import Mathlib.Analysis.CStarAlgebra.Basic

/-!
# The frequency propagator and its transport equation

The transport of the half-log scattering data along the frequency ray is carried by

`W_L(η) = exp (i η L + (i/2) ∫₀^η r) · exp (-i η T / 2)`,

a product of the scalar Gamma phase and the operator phase generated by `T`.  It solves the
transport equation

`W_L'(η) = i (L + r(η)/2 - T/2) W_L(η)`,

whose generator is exactly the shifted symbol operator.  When `T` is self-adjoint in a C⋆-algebra the
operator phase is unitary, so the propagator has norm one and the transport is lossless: the entire
Gamma phase is carried along the ray.
-/

open Complex NormedSpace

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℂ 𝔸] [CompleteSpace 𝔸]

/-- The operator phase `exp (-i η T / 2)`. -/
def opPhase (T : 𝔸) (η : ℝ) : 𝔸 := exp (η • ((-I / 2 : ℂ) • T))

omit [CompleteSpace 𝔸] in
theorem opPhase_zero (T : 𝔸) : opPhase T 0 = 1 := by
  simp [opPhase]

omit [CompleteSpace 𝔸] in
/-- The generator of the operator phase, written with a single complex scalar. -/
theorem opPhase_arg_eq (T : 𝔸) (η : ℝ) :
    η • ((-I / 2 : ℂ) • T) = (((η : ℂ)) * (-I / 2)) • T := by
  rw [← smul_assoc, Complex.real_smul]

omit [CompleteSpace 𝔸] in
theorem commute_opPhase (T : 𝔸) (η : ℝ) : Commute T (opPhase T η) := by
  refine Commute.exp_right ?_
  refine Commute.smul_right ?_ η
  exact Commute.smul_right (Commute.refl T) _

/-- The operator phase is generated by `-iT/2`. -/
theorem hasDerivAt_opPhase (T : 𝔸) (η : ℝ) :
    HasDerivAt (opPhase T) (opPhase T η * ((-I / 2 : ℂ) • T)) η :=
  hasDerivAt_exp_smul_const (𝕂 := ℝ) ((-I / 2 : ℂ) • T) η

/-- The frequency propagator: the scalar Gamma phase times the operator phase. -/
def freqPropagator (L : ℝ) (Rint : ℝ → ℝ) (T : 𝔸) (η : ℝ) : 𝔸 :=
  gammaPhase L Rint η • opPhase T η

omit [CompleteSpace 𝔸] in
theorem freqPropagator_zero {L : ℝ} {Rint : ℝ → ℝ} (T : 𝔸) (h : Rint 0 = 0) :
    freqPropagator L Rint T 0 = 1 := by
  rw [freqPropagator, opPhase_zero, gammaPhase, h]
  norm_num

/-- **The transport equation of the frequency propagator.** -/
theorem hasDerivAt_freqPropagator {Rint r : ℝ → ℝ} {L η : ℝ} (T : 𝔸)
    (hRint : HasDerivAt Rint (r η) η) :
    HasDerivAt (freqPropagator L Rint T)
      (I • (shiftedSymbolOp (L + r η / 2) T * freqPropagator L Rint T η)) η := by
  have hg := hasDerivAt_gammaPhase (L := L) (Rint := Rint) (r := r) (η := η) hRint
  have hw := hasDerivAt_opPhase T η
  have hprod := hg.smul hw
  have hcomm : opPhase T η * T = T * opPhase T η := (commute_opPhase T η).symm
  have e1 : opPhase T η * ((-I / 2 : ℂ) • T) = ((-I / 2 : ℂ)) • (T * opPhase T η) := by
    rw [mul_smul_comm, hcomm]
  have e2 : shiftedSymbolOp (L + r η / 2) T * freqPropagator L Rint T η
      = ((((L + r η / 2 : ℝ)) : ℂ) * gammaPhase L Rint η) • opPhase T η
        - ((2⁻¹ : ℂ) * gammaPhase L Rint η) • (T * opPhase T η) := by
    rw [shiftedSymbolOp, freqPropagator, sub_mul, smul_mul_assoc, smul_mul_assoc, one_mul,
      mul_smul_comm, smul_smul, smul_smul]
  have hval : gammaPhase L Rint η • (opPhase T η * ((-I / 2 : ℂ) • T))
      + ((((L + r η / 2 : ℝ)) * I) * gammaPhase L Rint η) • opPhase T η
      = I • (shiftedSymbolOp (L + r η / 2) T * freqPropagator L Rint T η) := by
    rw [e1, e2, smul_smul, smul_sub, smul_smul, smul_smul,
      show gammaPhase L Rint η * (-I / 2)
        = -(I * (2⁻¹ * gammaPhase L Rint η)) from by ring,
      show (((L + r η / 2 : ℝ)) : ℂ) * I * gammaPhase L Rint η
        = I * ((((L + r η / 2 : ℝ)) : ℂ) * gammaPhase L Rint η) from by ring, neg_smul]
    abel
  exact hval ▸ hprod

section CStar

variable {A : Type*} [NormedRing A] [StarRing A] [CStarRing A] [NormedAlgebra ℂ A]
  [CompleteSpace A] [Nontrivial A] [StarModule ℂ A] [ContinuousStar A]

omit [CStarRing A] [CompleteSpace A] [Nontrivial A] [ContinuousStar A] in
/-- The generator of the operator phase is skew-adjoint. -/
theorem opPhase_arg_mem_skewAdjoint {T : A} (hT : IsSelfAdjoint T) (η : ℝ) :
    η • ((-I / 2 : ℂ) • T) ∈ skewAdjoint A := by
  rw [skewAdjoint.mem_iff, opPhase_arg_eq, star_smul, hT.star_eq, ← neg_smul]
  congr 1
  have hrw : ((η : ℂ) * (-I / 2)) = -((((η / 2 : ℝ)) : ℂ) * I) := by push_cast; ring
  rw [hrw, star_neg, Complex.star_def, map_mul, Complex.conj_ofReal, Complex.conj_I, neg_neg]
  ring

omit [CStarRing A] [Nontrivial A] in
/-- **The operator phase of a self-adjoint generator is unitary.** -/
theorem opPhase_mem_unitary {T : A} (hT : IsSelfAdjoint T) (η : ℝ) :
    opPhase T η ∈ unitary A := by
  letI : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  exact exp_mem_unitary_of_mem_skewAdjoint (opPhase_arg_mem_skewAdjoint hT η)

theorem norm_opPhase {T : A} (hT : IsSelfAdjoint T) (η : ℝ) : ‖opPhase T η‖ = 1 :=
  CStarRing.norm_of_mem_unitary (opPhase_mem_unitary hT η)

/-- **The frequency transport is lossless.** -/
theorem norm_freqPropagator {T : A} (hT : IsSelfAdjoint T) (L : ℝ) (Rint : ℝ → ℝ) (η : ℝ) :
    ‖freqPropagator L Rint T η‖ = 1 := by
  rw [freqPropagator, norm_smul, norm_gammaPhase, norm_opPhase hT, mul_one]

end CStar

end

end GaloisForLFunctions.HTGeometry
