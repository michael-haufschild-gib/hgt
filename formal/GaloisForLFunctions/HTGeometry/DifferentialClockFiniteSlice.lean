import GaloisForLFunctions.HTGeometry.DifferentialClockEmbeddingCovariance

/-!
# Finite observable slices of a differential clock embedding

An ambient derivation-preserving field embedding need not be surjective.  Nevertheless, at every
finite jet resolution its restriction is an algebra equivalence from the source observable field
onto the target observable field generated by the embedded clock.  These equivalences are coherent
as the observational resolution increases.

This is a static finite-observable analogue of the time-slice principle in locally covariant QFT:
local observable data may be isomorphic even when the ambient presentations are not.  It does not
introduce a time evolution or assert the QFT time-slice axiom itself.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {F E L : Type*} [Field F] [Field E] [Field L]
  [Differential E] [Differential L] [Algebra F E] [Algebra F L]

/-- The restriction of a differential field embedding to a finite jet-observable field.  The
ambient map need not be onto `L`; it is onto the field generated there by the embedded clock. -/
noncomputable def jetObservableFieldEmbeddingEquiv
    (e : E →ₐ[F] L) (hderiv : ∀ z : E, e z′ = (e z)′)
    (x : E) (N : ℕ) :
    jetObservableField F x N ≃ₐ[F] jetObservableField F (e x) N :=
  (jetObservableField F x N).equivMap e |>.trans
    (IntermediateField.equivOfEq (jetObservableField_map_algHom e hderiv x N))

@[simp]
theorem coe_jetObservableFieldEmbeddingEquiv_apply
    (e : E →ₐ[F] L) (hderiv : ∀ z : E, e z′ = (e z)′)
    (x : E) (N : ℕ) (z : jetObservableField F x N) :
    ((jetObservableFieldEmbeddingEquiv e hderiv x N z :
      jetObservableField F (e x) N) : L) = e z := by
  rfl

/-- Every observable in the embedded finite clock field has a unique source observable.  Thus the
inverse needed at finite resolution is constructed locally and does not require a global inverse
`L → E`. -/
theorem jetObservableFieldEmbeddingEquiv_unique_preimage
    (e : E →ₐ[F] L) (hderiv : ∀ z : E, e z′ = (e z)′)
    (x : E) (N : ℕ) (y : jetObservableField F (e x) N) :
    ∃! z : jetObservableField F x N, e z = (y : L) := by
  let j := jetObservableFieldEmbeddingEquiv e hderiv x N
  refine ⟨j.symm y, ?_, ?_⟩
  · have h := j.apply_symm_apply y
    change j (j.symm y) = y at h
    exact Subtype.ext_iff.mp h
  · intro z hz
    apply j.injective
    rw [j.apply_symm_apply]
    apply Subtype.ext
    change e z = (y : L)
    exact hz

/-- The finite-slice equivalences commute with increasing observational resolution. -/
theorem jetObservableFieldEmbeddingEquiv_mono
    (e : E →ₐ[F] L) (hderiv : ∀ z : E, e z′ = (e z)′)
    (x : E) {M N : ℕ} (hMN : M ≤ N)
    (z : jetObservableField F x M) :
    ((jetObservableFieldEmbeddingEquiv e hderiv x N
        ⟨z, jetObservableField_mono x hMN z.2⟩ :
      jetObservableField F (e x) N) : L) =
      ((jetObservableFieldEmbeddingEquiv e hderiv x M z :
        jetObservableField F (e x) M) : L) := by
  simp only [coe_jetObservableFieldEmbeddingEquiv_apply]

end


end GaloisForLFunctions.HTGeometry
