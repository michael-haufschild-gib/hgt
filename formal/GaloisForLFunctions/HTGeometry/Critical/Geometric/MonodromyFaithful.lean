import GaloisForLFunctions.HTGeometry.Critical.Geometric.NormalClosureTower

/-!
# Faithfulness of the actual critical normal-closure action

The actual normal closure is generated by the images of all source-field embeddings.  Therefore an
automorphism acting trivially on every actual geometric sheet fixes every generator of the normal
closure and is the identity.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1600000

/-- The Galois action of the actual normal closure on the actual geometric sheets is faithful. -/
theorem criticalNormalClosureAction_injective
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    Function.Injective (criticalNormalClosureAction K m n) := by
  letI : FiniteDimensional (criticalObservationField K m n)
      (criticalSourceField K m n) :=
    criticalSourceField_finiteDimensional_criticalObservationField K hm hn
  letI := criticalNormalClosure_normal K hm hn
  letI : Algebra.IsAlgebraic (criticalObservationField K m n)
      (criticalSourceField K m n) := inferInstance
  intro σ τ hστ
  -- the subfield where the two automorphisms agree contains every sheet image, and the sheets
  -- generate the normal closure
  let M : IntermediateField (criticalObservationField K m n)
      (criticalNormalClosure K m n) :=
    { carrier := {x | σ x = τ x}
      zero_mem' := (map_zero σ).trans (map_zero τ).symm
      one_mem' := (map_one σ).trans (map_one τ).symm
      add_mem' := fun {x y} hx hy => by
        show σ (x + y) = τ (x + y)
        rw [map_add, map_add, hx, hy]
      mul_mem' := fun {x y} hx hy => by
        show σ (x * y) = τ (x * y)
        rw [map_mul, map_mul, hx, hy]
      inv_mem' := fun x hx => by
        show σ x⁻¹ = τ x⁻¹
        rw [map_inv₀, map_inv₀, hx]
      algebraMap_mem' := fun x => (σ.commutes x).trans (τ.commutes x).symm }
  have hle : IntermediateField.normalClosure (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalNormalClosure K m n) ≤ M := by
    rw [normalClosure_le_iff]
    intro f
    rintro _ ⟨x, rfl⟩
    exact DFunLike.congr_fun (DFunLike.congr_fun hστ f) x
  have htop : IntermediateField.normalClosure (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalNormalClosure K m n) = ⊤ :=
    (Algebra.IsAlgebraic.isNormalClosure_iff.mp
      (inferInstance : IsNormalClosure (criticalObservationField K m n)
        (criticalSourceField K m n) (criticalNormalClosure K m n))).2
  refine AlgEquiv.ext fun x => ?_
  have hx : x ∈ M := by
    apply hle
    rw [htop]
    exact Set.mem_univ x
  exact hx

end

end GaloisForLFunctions.HTGeometry
