import GaloisForLFunctions.HTGeometry.Critical.Schur.SourceIntegralClosure
import GaloisForLFunctions.HTGeometry.Critical.Geometric.NormalClosureTower
import GaloisForLFunctions.HTGeometry.Critical.Schur.CoordinateAdjoin
import GaloisForLFunctions.HTGeometry.Critical.Observation.ChartRing
import GaloisForLFunctions.HTGeometry.Critical.Schur.ObservationLocalization

/-!
# The Schur coordinate ring is integral over the observation Schur place

The horizon coordinates are integral over the observation chart ring, the Schur coordinates lie in
the algebra they generate, and the observation Schur place is a localization of the chart ring:

```text
criticalSourceAdjoin_isIntegral_chartRing
criticalSourceSchurCoordinates_isIntegral
criticalSchurSourceRing_isIntegral
    ** the whole Schur coordinate ring lands in the integral closure of the observation
       Schur place in the source field **
```

This is what makes every place of the source field over the observation Schur place have a centre
on the Schur coordinate model, which is the first step towards "only the Schur divisor ramifies".
Five scalar towers between the ground field, the coordinate ring, the chart ring, the observation
Schur place and the two fields are recorded along the way.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open IsLocalRing

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 1000000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}
variable [Fact (0 < m)] [Fact (0 < n)] [Fact (1 < m)] [Fact (1 < n)]

instance criticalChartSourceGroundTower :
    IsScalarTower K (criticalObservationChartRing K m n) (criticalSourceField K m n) := by
  refine IsScalarTower.of_algebraMap_eq fun c => ?_
  rw [IsScalarTower.algebraMap_apply K (criticalObservationRing K m n)
      (criticalSourceField K m n),
    IsScalarTower.algebraMap_apply (criticalObservationRing K m n)
      (criticalObservationChartRing K m n) (criticalSourceField K m n),
    ← IsScalarTower.algebraMap_apply K (criticalObservationRing K m n)
      (criticalObservationChartRing K m n)]

omit [Fact (1 < m)] [Fact (1 < n)] in
/-- Every element of the algebra generated by the horizon coordinates is integral over the
observation chart ring. -/
theorem criticalSourceAdjoin_isIntegral_chartRing
    (x : criticalSourceField K m n)
    (hx : x ∈ Algebra.adjoin K (criticalSourceCoordinateSet K m n)) :
    IsIntegral (criticalObservationChartRing K m n) x := by
  have hsub : Algebra.adjoin K (criticalSourceCoordinateSet K m n)
      ≤ (Algebra.adjoin (criticalObservationChartRing K m n)
          (criticalSourceCoordinateSet K m n)).restrictScalars K :=
    Algebra.adjoin_le (fun y hy => Algebra.subset_adjoin hy)
  have hmem : x ∈ criticalSourceChartAlgebra K (m := m) (n := n) := hsub hx
  have := (criticalSourceChartAlgebra_isIntegral K (m := m) (n := n)).isIntegral
    (⟨x, hmem⟩ : criticalSourceChartAlgebra K (m := m) (n := n))
  exact this.map (Subalgebra.val _)

instance criticalChartSchurObservationFieldTower :
    IsScalarTower (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

instance criticalChartSchurSourceTower :
    IsScalarTower (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalSourceField K m n) := by
  refine IsScalarTower.of_algebraMap_eq fun x => ?_
  rw [IsScalarTower.algebraMap_apply
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n) (criticalSourceField K m n),
    ← IsScalarTower.algebraMap_apply (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n),
    ← IsScalarTower.algebraMap_apply (criticalObservationChartRing K m n)
      (criticalObservationField K m n) (criticalSourceField K m n)]

/-- **Every Schur coordinate is integral over the observation Schur place.** -/
theorem criticalSourceSchurCoordinates_isIntegral (i : Fin (m + n - 1 + 1)) :
    IsIntegral (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n) i) := by
  refine IsIntegral.tower_top (R := criticalObservationChartRing K m n) ?_
  exact criticalSourceAdjoin_isIntegral_chartRing K _
    (criticalSourceSchurCoordinates_mem_adjoin K (Fact.out : 0 < m) (Fact.out : 0 < n) i)

instance criticalSchurObservationGroundFieldTower :
    IsScalarTower K
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

instance criticalSchurObservationGroundSourceTower :
    IsScalarTower K
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalSourceField K m n) := by
  refine IsScalarTower.of_algebraMap_eq fun c => ?_
  rw [IsScalarTower.algebraMap_apply
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n) (criticalSourceField K m n),
    ← IsScalarTower.algebraMap_apply K
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalObservationField K m n),
    ← IsScalarTower.algebraMap_apply K (criticalObservationField K m n)
      (criticalSourceField K m n)]

/-- **The Schur coordinate ring lands in the integral closure.** -/
theorem criticalSchurSourceRing_isIntegral (p : criticalSchurSourceRing K m n) :
    IsIntegral (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (MvPolynomial.aeval
        (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n)) p) := by
  have hmem : MvPolynomial.aeval
      (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n)) p
      ∈ Algebra.adjoin
        (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (Set.range
          (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n))) := by
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply K
        (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (criticalSourceField K m n)]
      exact Subalgebra.algebraMap_mem _ _
    | add q r hq hr =>
      rw [map_add]
      exact Subalgebra.add_mem _ hq hr
    | mul_X q i hq =>
      rw [map_mul, MvPolynomial.aeval_X]
      exact Subalgebra.mul_mem _ hq (Algebra.subset_adjoin ⟨i, rfl⟩)
  refine IsIntegral.of_mem_of_fg _ ?_ _ hmem
  refine fg_adjoin_of_finite (Set.finite_range _) ?_
  rintro _ ⟨i, rfl⟩
  exact criticalSourceSchurCoordinates_isIntegral K i

end

end GaloisForLFunctions.HTGeometry
