import GaloisForLFunctions.HTGeometry.Critical.Schur.ChartClearing
import GaloisForLFunctions.HTGeometry.SubalgebraClearingPrime
import GaloisForLFunctions.HTGeometry.Critical.Schur.FibreHeight
import GaloisForLFunctions.HTGeometry.Critical.Schur.Uniformizer

/-!
# The Schur place is the only ramified prime over the centre

The chart algebra clears denominators into the Schur coordinate ring, so the irreducible Schur
ramification polynomial stays prime there.  A height-one prime containing a prime element is
generated by it, so every prime of the chart algebra lying over the centre of the Schur place and
containing the ramification element *is* the centre of the Schur place.

This is obligation `(D-1)` of the full-symmetric-monodromy card: over the branch divisor there is
exactly one ramified point of the source.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial IsLocalRing

set_option synthInstance.maxHeartbeats 1000000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}
variable [Fact (0 < m)] [Fact (0 < n)] [Fact (1 < m)] [Fact (1 < n)]

/-- Schur-coordinate evaluation as a ring map into the source field. -/
noncomputable abbrev criticalSchurAeval :
    criticalSchurSourceRing K m n →+* criticalSourceField K m n :=
  (MvPolynomial.aeval
    (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n))).toRingHom

theorem criticalSchurAeval_injective :
    Function.Injective (criticalSchurAeval K (m := m) (n := n)) :=
  algebraicIndependent_criticalSourceSchurCoordinates K Fact.out Fact.out

theorem criticalSchurAeval_mem (p : criticalSchurSourceRing K m n) :
    criticalSchurAeval K p ∈ criticalSourceChartAlgebra K (m := m) (n := n) :=
  schurCoordinateAeval_mem_chartAlgebra K p

theorem exists_criticalSchurClearingPolynomial :
    ∃ W : criticalSchurSourceRing K m n,
      criticalSchurAeval K W = criticalSchurClearingElement K (m := m) (n := n) := by
  have h := criticalSchurClearingElement_mem K (m := m) (n := n)
  rw [criticalSchurCoordinateAlgebra, Algebra.adjoin_range_eq_range_aeval] at h
  obtain ⟨W, hW⟩ := h
  exact ⟨W, hW⟩

theorem criticalSourceScale_inv_mem_chartAlgebra :
    (criticalSourceScale K (Fact.out : 0 < m) (Fact.out : 0 < n))⁻¹
      ∈ criticalSourceChartAlgebra K (m := m) (n := n) := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  have h := criticalSourceRecip_zero_eq_inv K (by omega : 0 < m + n)
  rw [criticalSourceScale, show (⟨0, by omega⟩ : Fin (m + n)) = ⟨0, by omega⟩ from rfl, ← h]
  exact Algebra.subset_adjoin (Or.inr ⟨⟨0, by omega⟩, rfl⟩)

theorem criticalSourceMarked_inv_mem_chartAlgebra :
    (criticalSourceMarked K (m := m) (n := n))⁻¹
      ∈ criticalSourceChartAlgebra K (m := m) (n := n) := by
  have h : (criticalSourceMarked K (m := m) (n := n))⁻¹
      = algebraMap (criticalObservationChartRing K m n) (criticalSourceField K m n)
        (IsLocalization.Away.invSelf (criticalObservationMarked K (m := m) (n := n))) := by
    rw [algebraMap_chartRing_invSelf K, criticalSourceMarked_eq K]
  rw [h]
  exact Subalgebra.algebraMap_mem _ _

theorem criticalSchurClearingElement_inv_mem_chartAlgebra :
    (criticalSchurClearingElement K (m := m) (n := n))⁻¹
      ∈ criticalSourceChartAlgebra K (m := m) (n := n) := by
  rw [criticalSchurClearingElement, mul_inv, ← inv_pow]
  exact Subalgebra.mul_mem _
    (Subalgebra.pow_mem _ (criticalSourceScale_inv_mem_chartAlgebra K) _)
    (criticalSourceMarked_inv_mem_chartAlgebra K)

theorem criticalSchurClearingElement_ne_zero :
    criticalSchurClearingElement K (m := m) (n := n) ≠ 0 := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  rw [criticalSchurClearingElement, criticalSourceMarked_eq K]
  exact mul_ne_zero (pow_ne_zero _ (criticalSourceScale_ne_zero K hm hn))
    (mul_ne_zero (criticalSourceRaw_atMarkedIndex_ne_zero K hm hn)
      (criticalSourceRecip_atMarkedIndex_ne_zero K hm hn))

/-- A height-one prime containing a prime element is generated by it. -/
theorem eq_span_singleton_of_height_eq_one {R : Type*} [CommRing R] [IsDomain R] {s : R}
    (hs : Prime s) {Q : Ideal R} [Q.IsPrime] (hQh : Q.height = 1) (hsQ : s ∈ Q) :
    Q = Ideal.span {s} := by
  haveI hspan : (Ideal.span {s}).IsPrime := (Ideal.span_singleton_prime hs.ne_zero).mpr hs
  have hle : Ideal.span {s} ≤ Q := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hsQ)
  rcases eq_or_lt_of_le hle with h | h
  · exact h.symm
  · exfalso
    have hadd := Ideal.height_add_one_le_of_lt_of_isPrime h
    rw [hQh] at hadd
    have hzero : (Ideal.span {s}).height = 0 := by
      have h1 : (Ideal.span {s}).height + 1 ≤ 0 + 1 := by simpa using hadd
      have := (WithTop.add_le_add_iff_right (by simp : (1 : ℕ∞) ≠ ⊤)).mp h1
      exact le_antisymm this (by simp)
    rw [Ideal.height_eq_zero_iff_eq_bot, Ideal.span_singleton_eq_bot] at hzero
    exact hs.ne_zero hzero

/-- The evaluated Schur ramification polynomial, as an element of the chart algebra. -/
noncomputable def criticalSchurRamificationChartElement :
    criticalSourceChartAlgebra K (m := m) (n := n) :=
  ⟨criticalSchurAeval K (criticalSourceSchurRamificationPolynomial K m n),
    criticalSchurAeval_mem K _⟩

theorem criticalSchurRamificationChartElement_mem_chartPrime :
    criticalSchurRamificationChartElement K (m := m) (n := n)
      ∈ criticalSchurChartPrime K (m := m) (n := n) := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  rw [criticalSchurChartPrime, Ideal.mem_comap]
  have hval : (algebraMap (criticalSourceChartAlgebra K (m := m) (n := n))
      (criticalSchurSourceValuationSubring K hm hn))
      (criticalSchurRamificationChartElement K (m := m) (n := n))
      = criticalSchurSourceUniformizer K hm hn := by
    apply Subtype.ext
    exact (coe_criticalSchurSourceUniformizer K hm hn).symm
  rw [hval]
  exact (IsLocalRing.mem_maximalIdeal _).mpr
    (irreducible_criticalSchurSourceUniformizer K hm hn).not_isUnit

theorem criticalSchurRamificationChartElement_not_isUnit :
    ¬ IsUnit (criticalSchurRamificationChartElement K (m := m) (n := n)) := by
  intro hu
  exact (criticalSchurChartPrime_isPrime K (m := m) (n := n)).ne_top
    (Ideal.eq_top_of_isUnit_mem _
      (criticalSchurRamificationChartElement_mem_chartPrime K) hu)

/-- **The Schur ramification element is a prime of the chart algebra.** -/
theorem criticalSchurRamificationChartElement_prime :
    Prime (criticalSchurRamificationChartElement K (m := m) (n := n)) := by
  obtain ⟨W, hW⟩ := exists_criticalSchurClearingPolynomial K (m := m) (n := n)
  refine prime_subtype_of_clearing (criticalSchurAeval K) (criticalSchurAeval_injective K)
    (criticalSourceChartAlgebra K (m := m) (n := n)) (criticalSchurAeval_mem K)
    (W := W) (v := (criticalSchurClearingElement K (m := m) (n := n))⁻¹)
    (criticalSchurClearingElement_inv_mem_chartAlgebra K) ?_ ?_ ?_ ?_
  · rw [hW]
    exact inv_mul_cancel₀ (criticalSchurClearingElement_ne_zero K)
  · intro t
    obtain ⟨N, hN⟩ := criticalSourceChartAlgebra_mem_clearable K
      (t : criticalSourceField K m n) t.2
    rw [criticalSchurCoordinateAlgebra, Algebra.adjoin_range_eq_range_aeval] at hN
    obtain ⟨f, hf⟩ := hN
    exact ⟨N, f, by rw [hW]; exact hf.symm⟩
  · exact (irreducible_criticalSourceSchurRamificationPolynomial K
      (Fact.out : 0 < m) (Fact.out : 0 < n)).prime
  · exact criticalSchurRamificationChartElement_not_isUnit K

/-- **`(D-1)`.  The Schur place is the only ramified prime of the chart algebra over the centre.**
Every prime of the chart algebra that lies over the centre of the Schur place and contains the
ramification element is the centre of the Schur place itself. -/
theorem criticalSchurChartPrime_eq_of_mem
    (P : Ideal (criticalSourceChartAlgebra K (m := m) (n := n))) [P.IsPrime]
    [P.LiesOver (criticalSchurChartUnder K (m := m) (n := n))]
    (hP : criticalSchurRamificationChartElement K (m := m) (n := n) ∈ P) :
    P = criticalSchurChartPrime K (m := m) (n := n) := by
  have hprime := criticalSchurRamificationChartElement_prime K (m := m) (n := n)
  have h1 : P = Ideal.span {criticalSchurRamificationChartElement K (m := m) (n := n)} :=
    eq_span_singleton_of_height_eq_one hprime
      (criticalSchurChartOverPrime_height_eq_one K P) hP
  have h2 : criticalSchurChartPrime K (m := m) (n := n)
      = Ideal.span {criticalSchurRamificationChartElement K (m := m) (n := n)} :=
    eq_span_singleton_of_height_eq_one hprime
      (criticalSchurChartPrime_height K (m := m) (n := n))
      (criticalSchurRamificationChartElement_mem_chartPrime K)
  rw [h1, h2]

end

end GaloisForLFunctions.HTGeometry
