import GaloisForLFunctions.HTGeometry.Critical.Schur.JacobianDivisor
import GaloisForLFunctions.HTGeometry.Critical.Schur.TailIntegrality

/-!
# The Schur coordinates are polynomials in the raw and reciprocal coordinates

The Schur coordinate family is the source scale followed by the positive coefficients of the
normalized reciprocal square, and those differ from the actual reciprocal-square coefficients by
the square of the scale.  Hence every Schur coordinate lies in the algebra generated by the raw and
reciprocal coordinates of the horizon.

This is what makes the Schur local ring a localization of that algebra, which is the step that
turns the finiteness of the critical map into height one for the centre of the Schur place on the
observation chart.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

set_option synthInstance.maxHeartbeats 400000

variable (K : Type*) [Field K] [CharZero K] {m n : ℕ}

/-- The raw and reciprocal coordinates of the critical horizon. -/
noncomputable def criticalSourceCoordinateSet (m n : ℕ) : Set (criticalSourceField K m n) :=
  Set.range (criticalSourceRaw K m n) ∪ Set.range (criticalSourceRecip K m n)

omit [CharZero K] in
theorem criticalSourceScale_mem_adjoin (hm : 0 < m) (hn : 0 < n) :
    criticalSourceScale K hm hn ∈
      Algebra.adjoin K (criticalSourceCoordinateSet K m n) :=
  Algebra.subset_adjoin (Or.inl ⟨⟨0, by omega⟩, rfl⟩)

omit [CharZero K] in
theorem criticalSourceReciprocalPolynomial_coeff_mem_adjoin (k : ℕ) :
    (criticalSourceReciprocalPolynomial K m n).coeff k ∈
      Algebra.adjoin K (criticalSourceCoordinateSet K m n) := by
  by_cases hk : k < m + n
  · rw [criticalSourceReciprocalPolynomial_coeff K m n k hk]
    exact Algebra.subset_adjoin (Or.inr ⟨⟨k, hk⟩, rfl⟩)
  · rw [criticalSourceReciprocalPolynomial, Polynomial.finsetSum_coeff]
    refine Subalgebra.sum_mem _ fun j _ => ?_
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
    exact Subalgebra.zero_mem _

theorem criticalSourceReciprocalSquarePositive_mem_adjoin (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1)) :
    criticalSourceReciprocalSquarePositive K hm hn i ∈
      Algebra.adjoin K (criticalSourceCoordinateSet K m n) := by
  have hk : (i : ℕ) + 1 < m + n := by omega
  have h := unitConstantSeries_criticalSourceReciprocalSquarePositive_eq_scale K hm hn hk
  rw [unitConstantSeries_succ _ (by omega : (i : ℕ) < m + n - 1)] at h
  have hcast : (⟨(i : ℕ), by omega⟩ : Fin (m + n - 1)) = i := Fin.ext rfl
  rw [hcast] at h
  rw [h]
  refine Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (criticalSourceScale_mem_adjoin K hm hn) 2) ?_
  rw [pow_two, Polynomial.coeff_mul]
  refine Subalgebra.sum_mem _ fun p _ => ?_
  exact Subalgebra.mul_mem _ (criticalSourceReciprocalPolynomial_coeff_mem_adjoin K _)
    (criticalSourceReciprocalPolynomial_coeff_mem_adjoin K _)

theorem criticalSourceSchurCoordinates_mem_adjoin (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1 + 1)) :
    criticalSourceSchurCoordinates K hm hn i ∈
      Algebra.adjoin K (criticalSourceCoordinateSet K m n) := by
  refine Fin.cases ?_ ?_ i
  · have h0 := criticalSourceScale_eq_schurCoordinate_zero K hm hn
    rw [criticalSourceSchurCoordinates, Fin.cons_zero] at h0
    rw [criticalSourceSchurCoordinates, Fin.cons_zero, ← h0]
    exact criticalSourceScale_mem_adjoin K hm hn
  · intro j
    rw [criticalSourceSchurCoordinates, Fin.cons_succ]
    exact criticalSourceReciprocalSquarePositive_mem_adjoin K hm hn j.rev

end GaloisForLFunctions.HTGeometry
