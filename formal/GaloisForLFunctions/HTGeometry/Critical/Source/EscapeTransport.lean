import GaloisForLFunctions.HTGeometry.Critical.Source.PrimitiveGenerator
import GaloisForLFunctions.HTGeometry.Critical.Geometric.NormalClosureTower

/-!
# Carrying an escaping element into the normal closure

The canonical sheet is an algebra map over the observation field, and it is injective because its
source is a field.  So an element of the source that is not already observed stays unobserved after
being carried into the normal closure: if its image lay in the bottom intermediate field it would be
the image of an observed element, and injectivity would put it back in the bottom of the source.

Together with the primitivity step this turns "some element of the source escapes the observation
field" directly into "the source is generated by that element", given full monodromy.
-/

set_option synthInstance.maxHeartbeats 400000

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- **Escaping the observation field is preserved by the canonical sheet.** -/
theorem embedding_notMem_bot_of_notMem_bot (K : Type*) [Field K] (m n : ℕ)
    (y : criticalSourceField K m n)
    (hy : y ∉ (⊥ : IntermediateField (criticalObservationField K m n)
      (criticalSourceField K m n))) :
    (criticalSourceNormalClosureEmbedding K m n) y
      ∉ (⊥ : IntermediateField (criticalObservationField K m n)
        (criticalNormalClosure K m n)) := by
  intro hmem
  rw [IntermediateField.mem_bot] at hmem
  obtain ⟨o, ho⟩ := hmem
  apply hy
  rw [IntermediateField.mem_bot]
  refine ⟨o, ?_⟩
  have hcomm : (criticalSourceNormalClosureEmbedding K m n)
      (algebraMap (criticalObservationField K m n) (criticalSourceField K m n) o)
      = algebraMap (criticalObservationField K m n) (criticalNormalClosure K m n) o :=
    (criticalSourceNormalClosureEmbedding K m n).commutes o
  have hinj : Function.Injective (criticalSourceNormalClosureEmbedding K m n) :=
    (criticalSourceNormalClosureEmbedding K m n).toRingHom.injective
  exact hinj (by rw [hcomm, ho])

/-- **An escaping element of the source generates the source**, given full monodromy — stated for an
element of the source field itself. -/
theorem criticalSource_eq_adjoin_of_notMem_bot (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (hfull : criticalGeometricMonodromy K m n = ⊤)
    (y : criticalSourceField K m n)
    (hy : y ∉ (⊥ : IntermediateField (criticalObservationField K m n)
      (criticalSourceField K m n))) :
    IntermediateField.adjoin (criticalObservationField K m n)
        {(criticalSourceNormalClosureEmbedding K m n) y}
      = (criticalSourceNormalClosureEmbedding K m n).fieldRange :=
  criticalSourceNormalClosureFieldRange_eq_adjoin_of_full_monodromy K hm hn hfull
    ((criticalSourceNormalClosureEmbedding K m n) y) ⟨y, rfl⟩
    (embedding_notMem_bot_of_notMem_bot K m n y hy)

end GaloisForLFunctions.HTGeometry

end
