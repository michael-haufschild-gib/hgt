import GaloisForLFunctions.HTGeometry.Critical.Source.ChartJacobian

/-!
# The Schur prime in the explicit source-chart presentation

The presentation equivalence sends the Jacobian ramification factor to the prime Schur element in
the intrinsic chart algebra.  This identifies its principal ideal and proves that its contraction
to the observation chart is exactly the Schur divisor.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

set_option synthInstance.maxHeartbeats 2000000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}
variable [Fact (0 < m)] [Fact (0 < n)] [Fact (1 < m)] [Fact (1 < n)]

/-- The intrinsic source-chart Schur prime is generated by the Schur ramification element. -/
theorem criticalSchurChartPrime_eq_span_ramification :
    criticalSchurChartPrime K (m := m) (n := n) =
      Ideal.span {criticalSchurRamificationChartElement K (m := m) (n := n)} := by
  exact eq_span_singleton_of_height_eq_one
    (criticalSchurRamificationChartElement_prime K (m := m) (n := n))
    (criticalSchurChartPrime_height K (m := m) (n := n))
    (criticalSchurRamificationChartElement_mem_chartPrime K (m := m) (n := n))

/-- Schur prime transported to the explicit Laurent-polynomial source-chart presentation. -/
def criticalSourceChartSchurPrime : Ideal (criticalSourceChartRing K m n) :=
  Ideal.comap (criticalSourceChartRingAlgEquiv K (m := m) (n := n)).toRingHom
    (criticalSchurChartPrime K (m := m) (n := n))

instance criticalSourceChartSchurPrime_isPrime :
    (criticalSourceChartSchurPrime K (m := m) (n := n)).IsPrime :=
  Ideal.comap_isPrime _ _

/-- The explicit source-chart Schur prime is generated by the Jacobian ramification factor. -/
theorem criticalSourceChartSchurPrime_eq_span_ramification :
    criticalSourceChartSchurPrime K (m := m) (n := n) =
      Ideal.span {criticalSourceChartRamificationElement K (m := m) (n := n)} := by
  let e := (criticalSourceChartRingAlgEquiv K (m := m) (n := n)).toRingEquiv
  apply e.idealComapOrderIso.symm.injective
  rw [RingEquiv.idealComapOrderIso_symm_apply,
    RingEquiv.idealComapOrderIso_symm_apply]
  change Ideal.map e (Ideal.comap e
      (criticalSchurChartPrime K (m := m) (n := n))) =
    Ideal.map e (Ideal.span
      {criticalSourceChartRamificationElement K (m := m) (n := n)})
  rw [Ideal.map_comap_eq_self_of_equiv,
    Ideal.map_span, Set.image_singleton, criticalSourceChartRamificationElement]
  change criticalSchurChartPrime K (m := m) (n := n) = Ideal.span
    {(criticalSourceChartRingAlgEquiv K (m := m) (n := n))
      ((criticalSourceChartRingAlgEquiv K (m := m) (n := n)).symm
        (criticalSchurRamificationChartElement K (m := m) (n := n)))}
  rw [(criticalSourceChartRingAlgEquiv K (m := m) (n := n)).apply_symm_apply,
    criticalSchurChartPrime_eq_span_ramification]

/-- The explicit source-chart Schur prime contracts to the Schur divisor on the observation
chart. -/
theorem criticalSourceChartSchurPrime_under :
    (criticalSourceChartSchurPrime K (m := m) (n := n)).under
        (criticalObservationChartRing K m n) =
      criticalSchurChartUnder K (m := m) (n := n) := by
  ext x
  change (criticalSourceChartRingAlgEquiv K (m := m) (n := n))
      (algebraMap (criticalObservationChartRing K m n)
        (criticalSourceChartRing K m n) x) ∈
        criticalSchurChartPrime K (m := m) (n := n) ↔
    algebraMap (criticalObservationChartRing K m n)
      (criticalSourceChartAlgebra K (m := m) (n := n)) x ∈
        criticalSchurChartPrime K (m := m) (n := n)
  rw [(criticalSourceChartRingAlgEquiv K (m := m) (n := n)).commutes]

end
end GaloisForLFunctions.HTGeometry
