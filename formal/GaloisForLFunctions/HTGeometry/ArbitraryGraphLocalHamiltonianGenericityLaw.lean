/-!
# Arbitrary-graph local Hamiltonian genericity

This module retains the tensor-factor and interaction-graph provenance that
the spectral leaf-extension theorem deliberately packages away.  The
architecture is indexed by its physical carrier and observer type.  Its
local Hamiltonians are generated only by onsite terms and parent--leaf
two-factor terms; its one-site predicate records physical probe locality.
-/

open Set SimpleGraph MeasureTheory Topology Filter
open scoped Matrix Kronecker BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

/-- Typed rooted tensor-tree architecture.  `atom` is one site, `edge` is
the two-site seed, and `leaf` adds one new factor at a named old observer. -/
inductive RootedTensorTree : (Physical Observer : Type u) → Type (u + 1)
  | atom (Physical Observer : Type u)
      [Fintype Physical] [DecidableEq Physical]
      [Fintype Observer] [DecidableEq Observer] :
      RootedTensorTree Physical Observer
  | edge (left right Observer : Type u)
      [Fintype left] [DecidableEq left]
      [Fintype right] [DecidableEq right]
      [Fintype Observer] [DecidableEq Observer]
      (side : Observer ≃ Bool) :
      RootedTensorTree (left × right) Observer
  | leaf {Physical Observer : Type u}
      (old : RootedTensorTree Physical Observer)
      [Fintype Physical] [DecidableEq Physical]
      [Fintype Observer] [DecidableEq Observer]
      (newFactor : Type u) [Fintype newFactor] [DecidableEq newFactor]
      (parent : Observer) :
      RootedTensorTree (Physical × newFactor)
        (LeafExtendedObserver Observer)

namespace RootedTensorTree

/-- Canonical finite structure on an architecture's physical carrier. -/
@[reducible] def physicalFintype {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) : Fintype Physical := by
  induction T with
  | atom Physical Observer => infer_instance
  | edge left right Observer side => infer_instance
  | @leaf Physical Observer old _ _ _ _ newFactor _ _ parent ih =>
      letI : Fintype Physical := ih
      infer_instance

/-- Canonical decidable equality on an architecture's physical carrier. -/
@[reducible] def physicalDecidableEq {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) : DecidableEq Physical := by
  induction T with
  | atom Physical Observer => infer_instance
  | edge left right Observer side => infer_instance
  | @leaf Physical Observer old _ _ _ _ newFactor _ _ parent ih =>
      letI : DecidableEq Physical := ih
      infer_instance

/-- Canonical finite structure on architecture observers. -/
@[reducible] def observerFintype {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) : Fintype Observer := by
  induction T with
  | atom Physical Observer => infer_instance
  | edge left right Observer side => infer_instance
  | @leaf Physical Observer old _ _ _ _ newFactor _ _ parent ih =>
      letI : Fintype Observer := ih
      infer_instance

/-- Canonical decidable equality on architecture observers. -/
@[reducible] def observerDecidableEq {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) : DecidableEq Observer := by
  induction T with
  | atom Physical Observer => infer_instance
  | edge left right Observer side => infer_instance
  | @leaf Physical Observer old _ _ _ _ newFactor _ _ parent ih =>
      letI : DecidableEq Observer := ih
      infer_instance

/-- Interaction graph generated by the architecture. -/
def graph : {Physical Observer : Type u} →
    RootedTensorTree Physical Observer → SimpleGraph Observer
  | _, _, @RootedTensorTree.atom Physical Observer _ _ _ _ => ⊥
  | _, _, @RootedTensorTree.edge left right Observer
      _ _ _ _ _ _ _side => ⊤
  | _, _, @RootedTensorTree.leaf Physical Observer old _ _ _ _ newFactor _ _ parent =>
      SimpleGraph.fromRel fun a b =>
        match a, b with
        | Sum.inl x, Sum.inl y => old.graph.Adj x y
        | Sum.inl x, Sum.inr _ => x = parent
        | Sum.inr _, Sum.inl y => y = parent
        | Sum.inr _, Sum.inr _ => False

/-- A matrix acts on exactly one named tensor factor. -/
def IsOneSite : {Physical Observer : Type u} →
    (T : RootedTensorTree Physical Observer) →
    Observer → Matrix Physical Physical ℂ → Prop
  | _, _, @RootedTensorTree.atom Physical Observer _ _ _ _, _, _ => True
  | _, _, @RootedTensorTree.edge left right Observer
      _ _ _ _ _ _ side, s, A =>
      if side s = false then
        ∃ L : Matrix left left ℂ,
          A = layerMatrixCoupling L (1 : Matrix right right ℂ)
      else
        ∃ R : Matrix right right ℂ,
          A = layerMatrixCoupling (1 : Matrix left left ℂ) R
  | _, _, @RootedTensorTree.leaf Physical Observer old _ _ _ _ newFactor _ _ _parent,
      Sum.inl s, A =>
      ∃ L : Matrix _ _ ℂ,
        old.IsOneSite s L ∧
          A = layerMatrixCoupling L (1 : Matrix newFactor newFactor ℂ)
  | _, _, @RootedTensorTree.leaf Physical Observer _old _ _ _ _ newFactor _ _ _parent,
      Sum.inr _, A =>
      ∃ R : Matrix newFactor newFactor ℂ,
        A = layerMatrixCoupling
          (1 : Matrix _ _ ℂ) R

/-- Exact onsite-plus-edge local Hamiltonian class generated by an
architecture. -/
def IsLocalHamiltonian : {Physical Observer : Type u} →
    (T : RootedTensorTree Physical Observer) →
    Matrix Physical Physical ℂ → Prop
  | _, _, @RootedTensorTree.atom Physical Observer _ _ _ _, _ => True
  | _, _, @RootedTensorTree.edge left right Observer
      _ _ _ _ _ _ _side, _ => True
  | _, _, @RootedTensorTree.leaf Physical Observer old _ _ _ _ newFactor _ _ parent, H =>
      ∃ oldHamiltonian parentOperator shift edge,
        old.IsLocalHamiltonian oldHamiltonian ∧
        old.IsOneSite parent parentOperator ∧
        H = physicalLeafHamiltonian
          oldHamiltonian parentOperator shift edge

/-- Every real linear combination of probes localized at one site remains
localized at that site. -/
theorem isOneSite_realMatrixFamilyCombination
    {Physical Observer η : Type u}
    [Fintype η]
    (T : RootedTensorTree Physical Observer)
    (site : Observer)
    (probe : η → Matrix Physical Physical ℂ)
    (coefficient : η → ℝ)
    (hprobe : ∀ i, T.IsOneSite site (probe i)) :
    T.IsOneSite site
      (realMatrixFamilyCombination probe coefficient) := by
  induction T with
  | atom Physical Observer => simp [IsOneSite]
  | edge left right Observer side =>
      by_cases hs : side site = false
      · simp only [IsOneSite, if_pos hs] at hprobe ⊢
        choose localMatrix hlocal using hprobe
        refine ⟨realMatrixFamilyCombination localMatrix coefficient, ?_⟩
        unfold realMatrixFamilyCombination
        simp_rw [hlocal]
        ext x y
        simp [layerMatrixCoupling, Matrix.one_apply]
      · simp only [IsOneSite, if_neg hs] at hprobe ⊢
        choose localMatrix hlocal using hprobe
        refine ⟨realMatrixFamilyCombination localMatrix coefficient, ?_⟩
        unfold realMatrixFamilyCombination
        simp_rw [hlocal]
        ext x y
        simp [layerMatrixCoupling, Matrix.one_apply]
  | @leaf Physical Observer old _ _ _ _ newFactor _ _ parent ih =>
      cases site with
      | inl site =>
          simp only [IsOneSite] at hprobe ⊢
          choose localMatrix hlocalOld hlocalEq using hprobe
          have hcomb := ih site localMatrix hlocalOld
          refine ⟨realMatrixFamilyCombination localMatrix coefficient,
            hcomb, ?_⟩
          unfold realMatrixFamilyCombination
          simp_rw [hlocalEq]
          ext x y
          simp [layerMatrixCoupling, Matrix.one_apply]
      | inr _ =>
          simp only [IsOneSite] at hprobe ⊢
          choose localMatrix hlocal using hprobe
          refine ⟨realMatrixFamilyCombination localMatrix coefficient, ?_⟩
          unfold realMatrixFamilyCombination
          simp_rw [hlocal]
          ext x y
          simp [layerMatrixCoupling, Matrix.one_apply]

/-- The physical leaf Hamiltonian is local in the extended architecture
whenever the inherited Hamiltonian and parent operator have the recorded
locality. -/
theorem isLocalHamiltonian_physicalLeafHamiltonian
    {Physical Observer ρ : Type u}
    [Fintype Physical] [DecidableEq Physical]
    [Fintype Observer] [DecidableEq Observer]
    [Fintype ρ] [DecidableEq ρ]
    (T : RootedTensorTree Physical Observer)
    (parent : Observer)
    (oldHamiltonian parentOperator : Matrix Physical Physical ℂ)
    (shift : ρ → ℂ) (edge : Matrix ρ ρ ℂ)
    (hold : T.IsLocalHamiltonian oldHamiltonian)
    (hparent : T.IsOneSite parent parentOperator) :
    (RootedTensorTree.leaf T ρ parent).IsLocalHamiltonian
      (physicalLeafHamiltonian oldHamiltonian parentOperator shift edge) := by
  exact ⟨oldHamiltonian, parentOperator, shift, edge,
    hold, hparent, rfl⟩

/-- Exact real vector space generated by Hermitian onsite-plus-edge
Hamiltonians admitted by an architecture.  Taking the span closes the
simple-tensor edge presentation under arbitrary finite edge-term sums. -/
def hermitianLocalHamiltonianSubmodule
    {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) :
    Submodule ℝ (Matrix Physical Physical ℂ) :=
  Submodule.span ℝ
    {H | T.IsLocalHamiltonian H ∧ H.IsHermitian}

/-- Every element of the exact local Hamiltonian subspace is Hermitian. -/
theorem hermitianLocalHamiltonianSubmodule_le_selfAdjoint
    {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer) :
    T.hermitianLocalHamiltonianSubmodule ≤
      selfAdjoint.submodule ℝ (Matrix Physical Physical ℂ) := by
  apply Submodule.span_le.2
  intro H hH
  exact hH.2

/-- Every explicitly local Hermitian Hamiltonian belongs to the complete
local Hamiltonian subspace. -/
theorem mem_hermitianLocalHamiltonianSubmodule
    {Physical Observer : Type u}
    (T : RootedTensorTree Physical Observer)
    {H : Matrix Physical Physical ℂ}
    (hlocal : T.IsLocalHamiltonian H) (hH : H.IsHermitian) :
    H ∈ T.hermitianLocalHamiltonianSubmodule :=
  Submodule.subset_span ⟨hlocal, hH⟩

end RootedTensorTree

/-- Tensor-tree locality certificate for one fixed physical realization. -/
structure TensorTreeLocality
    (spectral : GoodObserverSpectralSystem.{u})
    [Fintype spectral.State] [DecidableEq spectral.State]
    (realization : spectral.PhysicalRealization) where
  tree : RootedTensorTree realization.PhysicalState spectral.Observer
  hamiltonian_local : tree.IsLocalHamiltonian realization.hamiltonian
  probe_local : ∀ s i, tree.IsOneSite s (realization.physicalProbe s i)

/-- Physically realized good spectral system together with exact tensor-tree
locality provenance for its Hamiltonian and every physical probe. -/
structure PhysicallyRealizedTensorTreeSystem where
  spectral : GoodObserverSpectralSystem.{u}
  realization :
    @GoodObserverSpectralSystem.PhysicalRealization
      spectral spectral.stateFintype spectral.stateDecidableEq
  locality :
    @TensorTreeLocality spectral spectral.stateFintype
      spectral.stateDecidableEq realization

/-- Physical carrier exposed through stored spectral instances. -/
@[reducible] def PhysicallyRealizedTensorTreeSystem.PhysicalState
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) : Type u := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.realization.PhysicalState

@[reducible] def PhysicallyRealizedTensorTreeSystem.physicalFintype
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) : Fintype Z.PhysicalState := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.realization.physicalFintype

@[reducible] def PhysicallyRealizedTensorTreeSystem.physicalDecidableEq
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) : DecidableEq Z.PhysicalState := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.realization.physicalDecidableEq

/-- Physical Hamiltonian exposed without requiring ambient instances. -/
def PhysicallyRealizedTensorTreeSystem.hamiltonian
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Matrix Z.PhysicalState Z.PhysicalState ℂ := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.realization.hamiltonian

/-- A physical spectral realization is Hermitian because its Hamiltonian
is unitarily diagonalized by real energies. -/
theorem GoodObserverSpectralSystem.PhysicalRealization.hamiltonian_isHermitian
    (X : GoodObserverSpectralSystem.{u})
    (R : @GoodObserverSpectralSystem.PhysicalRealization
      X X.stateFintype X.stateDecidableEq) :
    letI : Fintype X.State := X.stateFintype
    letI : DecidableEq X.State := X.stateDecidableEq
    letI : Fintype R.PhysicalState := R.physicalFintype
    letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
    R.hamiltonian.IsHermitian := by
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  have hD :
      (Matrix.diagonal
        (fun i => (X.energy i : ℂ))).IsHermitian := by
    rw [Matrix.isHermitian_diagonal_iff]
    intro i
    rw [isSelfAdjoint_iff]
    exact RCLike.conj_ofReal _
  rw [R.hamiltonian_eq_diagonal]
  simpa [Matrix.star_eq_conjTranspose] using
    Matrix.isHermitian_conjTranspose_mul_mul R.basisᴴ hD

/-- The rectangular physical eigenbasis is a genuine linear equivalence;
the two stored unitarity identities are its inverse laws. -/
def GoodObserverSpectralSystem.PhysicalRealization.spectralLinearEquiv
    (X : GoodObserverSpectralSystem.{u})
    (R : @GoodObserverSpectralSystem.PhysicalRealization
      X X.stateFintype X.stateDecidableEq) :
    letI : Fintype X.State := X.stateFintype
    letI : DecidableEq X.State := X.stateDecidableEq
    letI : Fintype R.PhysicalState := R.physicalFintype
    letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
    (X.State → ℂ) ≃ₗ[ℂ] (R.PhysicalState → ℂ) := by
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  refine
    { toLinearMap := Matrix.mulVecLin R.basis
      invFun := fun v => R.basisᴴ *ᵥ v
      left_inv := ?_
      right_inv := ?_ }
  · intro v
    change R.basisᴴ *ᵥ (R.basis *ᵥ v) = v
    rw [Matrix.mulVec_mulVec, R.star_basis_mul_basis]
    exact Matrix.one_mulVec v
  · intro v
    change R.basis *ᵥ (R.basisᴴ *ᵥ v) = v
    rw [Matrix.mulVec_mulVec, R.basis_mul_star_basis]
    exact Matrix.one_mulVec v

/-- Physical and spectral index types in a realization have equal finite
cardinality. -/
theorem GoodObserverSpectralSystem.PhysicalRealization.physicalCard_eq_stateCard
    (X : GoodObserverSpectralSystem.{u})
    (R : @GoodObserverSpectralSystem.PhysicalRealization
      X X.stateFintype X.stateDecidableEq) :
    letI : Fintype X.State := X.stateFintype
    letI : DecidableEq X.State := X.stateDecidableEq
    letI : Fintype R.PhysicalState := R.physicalFintype
    letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
    @Fintype.card R.PhysicalState R.physicalFintype =
      @Fintype.card X.State X.stateFintype := by
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  have hfin := R.spectralLinearEquiv.finrank_eq
  simpa [Module.finrank_pi] using hfin.symm

/-- The physical Hamiltonian and its displayed spectral diagonal have the
same characteristic polynomial. -/
theorem GoodObserverSpectralSystem.PhysicalRealization.hamiltonian_charpoly_eq_diagonal
    (X : GoodObserverSpectralSystem.{u})
    (R : @GoodObserverSpectralSystem.PhysicalRealization
      X X.stateFintype X.stateDecidableEq) :
    letI : Fintype X.State := X.stateFintype
    letI : DecidableEq X.State := X.stateDecidableEq
    letI : Fintype R.PhysicalState := R.physicalFintype
    letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
    R.hamiltonian.charpoly =
      (Matrix.diagonal
        (fun i => (X.energy i : ℂ))).charpoly := by
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  let D : Matrix X.State X.State ℂ :=
    Matrix.diagonal (fun i => (X.energy i : ℂ))
  let e := R.spectralLinearEquiv
  have hconj : e.conj D.mulVecLin = R.hamiltonian.mulVecLin := by
    apply LinearMap.ext
    intro v
    change R.basis *ᵥ (D *ᵥ (R.basisᴴ *ᵥ v)) =
      R.hamiltonian *ᵥ v
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
    rw [R.hamiltonian_eq_diagonal]
  calc
    R.hamiltonian.charpoly =
        R.hamiltonian.mulVecLin.charpoly :=
      (Matrix.charpoly_mulVecLin R.hamiltonian).symm
    _ = (e.conj D.mulVecLin).charpoly := by rw [hconj]
    _ = D.mulVecLin.charpoly := e.charpoly_conj D.mulVecLin
    _ = D.charpoly := Matrix.charpoly_mulVecLin D

/-- Canonical eigenvalues of the physical Hamiltonian inherit maximal
projective independence from the packaged spectral energy list. -/
theorem GoodObserverSpectralSystem.PhysicalRealization.hamiltonianEigenvalues_maximallyProjective
    (X : GoodObserverSpectralSystem.{u})
    (R : @GoodObserverSpectralSystem.PhysicalRealization
      X X.stateFintype X.stateDecidableEq) :
    letI : Fintype X.State := X.stateFintype
    letI : DecidableEq X.State := X.stateDecidableEq
    letI : Fintype R.PhysicalState := R.physicalFintype
    letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
    MaximallyProjectiveEnergy R.hamiltonian_isHermitian.eigenvalues := by
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  let e : R.PhysicalState ≃ X.State :=
    Fintype.equivOfCardEq R.physicalCard_eq_stateCard
  let energy : R.PhysicalState → ℝ := fun i => X.energy (e i)
  have hmax : MaximallyProjectiveEnergy energy :=
    maximallyProjectiveEnergy_equiv e X.energy_maximallyProjective
  have hroot : ∀ i,
      matrixCharpolyRelation
        (R.hamiltonian, (energy i : ℂ)) = 0 := by
    intro i
    change (Matrix.scalar R.PhysicalState (energy i : ℂ) -
      R.hamiltonian).det = 0
    rw [← Matrix.eval_charpoly, R.hamiltonian_charpoly_eq_diagonal,
      Matrix.charpoly_diagonal, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (Finset.mem_univ (e i))
    simp [energy]
  exact maximallyProjectiveEnergy_hermitianEigenvalues_of_rootPacket
    R.hamiltonian R.hamiltonian_isHermitian energy hmax hroot

/-- Canonical finite basis generators of a real matrix submodule. -/
def realMatrixSubmoduleGenerator
    {I : Type u} [Fintype I]
    (L : Submodule ℝ (Matrix I I ℂ)) :
    Fin (Module.finrank ℝ L) → Matrix I I ℂ :=
  fun i => (Module.finBasis ℝ L i).1

/-- A submodule contained in the self-adjoint submodule has Hermitian
canonical basis generators. -/
theorem realMatrixSubmoduleGenerator_isHermitian
    {I : Type u} [Fintype I]
    (L : Submodule ℝ (Matrix I I ℂ))
    (hL : L ≤ selfAdjoint.submodule ℝ (Matrix I I ℂ))
    (i : Fin (Module.finrank ℝ L)) :
    (realMatrixSubmoduleGenerator L i).IsHermitian := by
  exact hL (Module.finBasis ℝ L i).2

/-- The canonical affine coordinate family represents every element of
the submodule exactly. -/
theorem exists_realAffineMatrix_eq_of_mem_submodule
    {I : Type u} [Fintype I]
    (L : Submodule ℝ (Matrix I I ℂ))
    (H : Matrix I I ℂ) (hH : H ∈ L) :
    ∃ p : Fin (Module.finrank ℝ L) → ℝ,
      realAffineMatrix 0 (realMatrixSubmoduleGenerator L) p = H := by
  let x : L := ⟨H, hH⟩
  let p : Fin (Module.finrank ℝ L) → ℝ :=
    fun i => (Module.finBasis ℝ L).repr x i
  refine ⟨p, ?_⟩
  have hsum := (Module.finBasis ℝ L).sum_repr x
  have hsumValue := congrArg L.subtype hsum
  have hmatrix :
      (∑ i, p i • realMatrixSubmoduleGenerator L i) = H := by
    simpa only [map_sum, map_smul, Submodule.coe_subtype,
      realMatrixSubmoduleGenerator, p, x] using hsumValue
  calc
    realAffineMatrix 0 (realMatrixSubmoduleGenerator L) p =
        ∑ i, p i • realMatrixSubmoduleGenerator L i := by
      ext a b
      simp [realAffineMatrix, Matrix.sum_apply]
    _ = H := hmatrix

/-- Conversely every point of the canonical affine coordinate family
belongs to the represented submodule. -/
theorem realAffineMatrix_mem_submodule
    {I : Type u} [Fintype I]
    (L : Submodule ℝ (Matrix I I ℂ))
    (p : Fin (Module.finrank ℝ L) → ℝ) :
    realAffineMatrix 0 (realMatrixSubmoduleGenerator L) p ∈ L := by
  have heq :
      realAffineMatrix 0 (realMatrixSubmoduleGenerator L) p =
        ∑ i, p i • realMatrixSubmoduleGenerator L i := by
    ext a b
    simp [realAffineMatrix, Matrix.sum_apply]
  rw [heq]
  apply Submodule.sum_mem
  intro i _
  exact L.smul_mem (p i) (Module.finBasis ℝ L i).2

/-- Parameters giving maximal projective spectrum in the complete
canonical coordinate family of a Hermitian real matrix submodule. -/
def realHermitianSubmoduleMaximalSet
    {I : Type u} [Fintype I] [DecidableEq I]
    (L : Submodule ℝ (Matrix I I ℂ))
    (hL : L ≤ selfAdjoint.submodule ℝ (Matrix I I ℂ)) :
    Set (Fin (Module.finrank ℝ L) → ℝ) :=
  realAffineHermitianMaximalSet
    0 (realMatrixSubmoduleGenerator L)
    Matrix.isHermitian_zero
    (realMatrixSubmoduleGenerator_isHermitian L hL)

/-- **Finite Hermitian subspace genericity.** If a complete real
Hermitian matrix subspace contains one maximally projective Hamiltonian,
then maximal projective spectrum is dense, residual, and full Lebesgue
measure in its canonical basis coordinates. -/
theorem realHermitianSubmoduleMaximalSet_dense_residual_fullMeasure
    {I : Type u} [Fintype I] [DecidableEq I]
    (L : Submodule ℝ (Matrix I I ℂ))
    (hL : L ≤ selfAdjoint.submodule ℝ (Matrix I I ℂ))
    (H : Matrix I I ℂ) (hHmem : H ∈ L)
    (hH : H.IsHermitian)
    (hmax : MaximallyProjectiveEnergy hH.eigenvalues) :
    Dense (realHermitianSubmoduleMaximalSet L hL) ∧
      realHermitianSubmoduleMaximalSet L hL ∈
        residual (Fin (Module.finrank ℝ L) → ℝ) ∧
      volume (realHermitianSubmoduleMaximalSet L hL)ᶜ = 0 := by
  obtain ⟨p₀, hp₀⟩ :=
    exists_realAffineMatrix_eq_of_mem_submodule L H hHmem
  let hgenerator : ∀ i,
      (realMatrixSubmoduleGenerator L i).IsHermitian :=
    realMatrixSubmoduleGenerator_isHermitian L hL
  let hfamily := realAffineMatrix_isHermitian
    0 (realMatrixSubmoduleGenerator L)
    Matrix.isHermitian_zero hgenerator
  have heigenvalues :
      (hfamily p₀).eigenvalues = hH.eigenvalues := by
    apply (Matrix.IsHermitian.eigenvalues_eq_eigenvalues_iff
      (hfamily p₀) hH).2
    rw [hp₀]
  have hmax₀ : MaximallyProjectiveEnergy (hfamily p₀).eigenvalues := by
    rw [heigenvalues]
    exact hmax
  exact realAffineHermitianMaximalSet_dense_residual_fullMeasure
    0 (realMatrixSubmoduleGenerator L)
    Matrix.isHermitian_zero hgenerator p₀ hmax₀

/-- Interaction graph exposed with the spectral system's stored finite
instances, so it is usable in theorem statements without ambient instances. -/
def PhysicallyRealizedTensorTreeSystem.architectureGraph
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    SimpleGraph Z.spectral.Observer := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.locality.tree.graph

/-- Anchored temporal rank exposed through stored finite instances. -/
def PhysicallyRealizedTensorTreeSystem.anchoredRank
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (reference : Z.spectral.State) : ℕ :=
  @anchoredTemporalRank Z.spectral.State
    Z.spectral.stateFintype Z.spectral.energy reference

/-- Complete real Hermitian onsite-plus-edge Hamiltonian subspace of the
packaged tensor-tree architecture. -/
def PhysicallyRealizedTensorTreeSystem.localHamiltonianSubmodule
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Submodule ℝ
      (Matrix Z.PhysicalState Z.PhysicalState ℂ) := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.locality.tree.hermitianLocalHamiltonianSubmodule

/-- Canonical number of real coordinates in the full local Hamiltonian
subspace. -/
def PhysicallyRealizedTensorTreeSystem.localHamiltonianParameterCount
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) : ℕ := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  exact Module.finrank ℝ Z.localHamiltonianSubmodule

/-- Canonical Hermitian generator basis for all architecture-local
Hamiltonians. -/
def PhysicallyRealizedTensorTreeSystem.localHamiltonianGenerator
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Fin Z.localHamiltonianParameterCount →
      Matrix Z.PhysicalState Z.PhysicalState ℂ := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  exact realMatrixSubmoduleGenerator Z.localHamiltonianSubmodule

theorem PhysicallyRealizedTensorTreeSystem.localHamiltonianSubmodule_le_selfAdjoint
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Z.localHamiltonianSubmodule ≤
      selfAdjoint.submodule ℝ
        (Matrix Z.PhysicalState Z.PhysicalState ℂ) := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.locality.tree.hermitianLocalHamiltonianSubmodule_le_selfAdjoint

theorem PhysicallyRealizedTensorTreeSystem.localHamiltonianGenerator_isHermitian
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (i : Fin Z.localHamiltonianParameterCount) :
    (Z.localHamiltonianGenerator i).IsHermitian := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  change (realMatrixSubmoduleGenerator
    Z.localHamiltonianSubmodule i).IsHermitian
  exact realMatrixSubmoduleGenerator_isHermitian
    Z.localHamiltonianSubmodule
    Z.localHamiltonianSubmodule_le_selfAdjoint i

/-- The packaged physical Hamiltonian belongs to the complete local
Hamiltonian subspace, with no restriction to the single construction
ray. -/
theorem PhysicallyRealizedTensorTreeSystem.hamiltonian_mem_localHamiltonianSubmodule
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Z.hamiltonian ∈ Z.localHamiltonianSubmodule := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact Z.locality.tree.mem_hermitianLocalHamiltonianSubmodule
    Z.locality.hamiltonian_local
    Z.realization.hamiltonian_isHermitian

/-- Every local Hamiltonian has exact canonical real coordinates. -/
theorem PhysicallyRealizedTensorTreeSystem.exists_localHamiltonianCoordinates
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (H : Matrix Z.PhysicalState Z.PhysicalState ℂ)
    (hH : H ∈ Z.localHamiltonianSubmodule) :
    ∃ p : Fin Z.localHamiltonianParameterCount → ℝ,
      realAffineMatrix 0 Z.localHamiltonianGenerator p = H := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  exact exists_realAffineMatrix_eq_of_mem_submodule
    Z.localHamiltonianSubmodule H hH

/-- Actual maximal-rank parameter locus in the full canonical local
Hamiltonian coefficient space. -/
def PhysicallyRealizedTensorTreeSystem.localHamiltonianMaximalSet
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Set (Fin Z.localHamiltonianParameterCount → ℝ) := by
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  letI : DecidableEq Z.PhysicalState :=
    Z.physicalDecidableEq
  exact realAffineHermitianMaximalSet
    0 Z.localHamiltonianGenerator
    Matrix.isHermitian_zero
    Z.localHamiltonianGenerator_isHermitian

/-- **Exact tensor-tree local genericity.** In the entire real vector
space generated by arbitrary Hermitian onsite terms and arbitrary finite
sums of Hermitian parent--leaf edge terms, maximal projective rank is
dense, residual, and full Lebesgue measure. -/
theorem PhysicallyRealizedTensorTreeSystem.localHamiltonianMaximalSet_dense_residual_fullMeasure
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) :
    Dense Z.localHamiltonianMaximalSet ∧
      Z.localHamiltonianMaximalSet ∈
        residual (Fin Z.localHamiltonianParameterCount → ℝ) ∧
      volume Z.localHamiltonianMaximalSetᶜ = 0 := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState :=
    Z.physicalFintype
  letI : DecidableEq Z.PhysicalState :=
    Z.physicalDecidableEq
  obtain ⟨p₀, hp₀⟩ := Z.exists_localHamiltonianCoordinates
    Z.hamiltonian
    Z.hamiltonian_mem_localHamiltonianSubmodule
  let hfamily := realAffineMatrix_isHermitian
    0 Z.localHamiltonianGenerator Matrix.isHermitian_zero
    Z.localHamiltonianGenerator_isHermitian
  have heigenvalues :
      (hfamily p₀).eigenvalues =
        Z.realization.hamiltonian_isHermitian.eigenvalues := by
    apply (Matrix.IsHermitian.eigenvalues_eq_eigenvalues_iff
      (hfamily p₀) Z.realization.hamiltonian_isHermitian).2
    rw [hp₀]
    rfl
  have hmax₀ : MaximallyProjectiveEnergy (hfamily p₀).eigenvalues := by
    rw [heigenvalues]
    exact Z.realization.hamiltonianEigenvalues_maximallyProjective
  exact realAffineHermitianMaximalSet_dense_residual_fullMeasure
    0 Z.localHamiltonianGenerator Matrix.isHermitian_zero
    Z.localHamiltonianGenerator_isHermitian p₀ hmax₀

/-- **Spanning-subspace lift.** Any finite real Hermitian Hamiltonian
space containing the exact tensor-tree local subspace inherits dense,
residual, full-measure maximal projective spectrum.  This is the formal
spanning-tree-to-arbitrary-graph step: adding allowed edge directions
cannot make a nonzero spectral obstruction identically zero. -/
theorem PhysicallyRealizedTensorTreeSystem.hermitianSuperspaceMaximalSet_dense_residual_fullMeasure
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (L : Submodule ℝ (Matrix Z.PhysicalState Z.PhysicalState ℂ))
    (hL : L ≤ selfAdjoint.submodule ℝ
      (Matrix Z.PhysicalState Z.PhysicalState ℂ))
    (hcontains : Z.localHamiltonianSubmodule ≤ L) :
    letI : Fintype Z.PhysicalState := Z.physicalFintype
    letI : DecidableEq Z.PhysicalState := Z.physicalDecidableEq
    Dense (realHermitianSubmoduleMaximalSet L hL) ∧
      realHermitianSubmoduleMaximalSet L hL ∈
        residual (Fin (Module.finrank ℝ L) → ℝ) ∧
      volume (realHermitianSubmoduleMaximalSet L hL)ᶜ = 0 := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : Fintype Z.PhysicalState := Z.physicalFintype
  letI : DecidableEq Z.PhysicalState := Z.physicalDecidableEq
  have hHamiltonianEq :
      Z.hamiltonian = Z.realization.hamiltonian := rfl
  have hHermitian : Z.hamiltonian.IsHermitian := by
    rw [hHamiltonianEq]
    exact Z.realization.hamiltonian_isHermitian
  have hMaximal :
      MaximallyProjectiveEnergy hHermitian.eigenvalues := by
    let hRaw := Z.realization.hamiltonian_isHermitian
    have heigenvalues : hHermitian.eigenvalues = hRaw.eigenvalues := by
      apply (Matrix.IsHermitian.eigenvalues_eq_eigenvalues_iff
        hHermitian hRaw).2
      rw [hHamiltonianEq]
    rw [heigenvalues]
    exact Z.realization.hamiltonianEigenvalues_maximallyProjective
  exact realHermitianSubmoduleMaximalSet_dense_residual_fullMeasure
    L hL Z.hamiltonian
    (hcontains Z.hamiltonian_mem_localHamiltonianSubmodule)
    hHermitian hMaximal

/-- Add one named leaf to a supplied interaction graph. -/
def leafGraphExtension
    {S : Type u} (G : SimpleGraph S) (root : S) :
    SimpleGraph (LeafExtendedObserver S) :=
  SimpleGraph.fromRel fun a b =>
    match a, b with
    | Sum.inl x, Sum.inl y => G.Adj x y
    | Sum.inl x, Sum.inr _ => x = root
    | Sum.inr _, Sum.inl y => y = root
    | Sum.inr _, Sum.inr _ => False

/-- Adding one leaf at a vertex of a connected graph preserves
connectedness. -/
theorem leafGraphExtension_connected
    {S : Type u} (G : SimpleGraph S) (root : S)
    (hG : G.Connected) :
    (leafGraphExtension G root).Connected := by
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  refine ⟨Sum.inl root, ?_⟩
  intro w
  cases w with
  | inl w =>
      let inclusion : G →g leafGraphExtension G root :=
        { toFun := Sum.inl
          map_rel' := by
            intro a b hab
            simp only [leafGraphExtension, SimpleGraph.fromRel_adj]
            exact ⟨fun h => hab.ne (Sum.inl.inj h), Or.inl hab⟩ }
      exact (hG root w).map inclusion
  | inr w =>
      exact (by simp [leafGraphExtension] :
        (leafGraphExtension G root).Adj
          (Sum.inl root) (Sum.inr w)).reachable

/-- Exact architecture relation for one leaf extension. -/
def IsTensorTreeLeafExtension
    (Z Y : PhysicallyRealizedTensorTreeSystem.{u})
    (root : Z.spectral.Observer) (ρ : Type u)
    [Fintype ρ] [DecidableEq ρ] : Prop :=
  ∃ e : Y.spectral.Observer ≃ LeafExtendedObserver Z.spectral.Observer,
    Y.architectureGraph =
      SimpleGraph.comap e (leafGraphExtension Z.architectureGraph root)

/-- Exact physical provenance of one leaf extension.  The enlarged physical
carrier is the old carrier times the new local factor; under that
identification every enlarged one-site operator is an old one-site operator on
the old factor or an arbitrary operator on the new factor, and every enlarged
local Hamiltonian is an old local Hamiltonian plus one new onsite term and one
parent--leaf interaction. -/
def IsPhysicalLeafChart
    (Z Y : PhysicallyRealizedTensorTreeSystem.{u})
    (root : Z.spectral.Observer) (ρ : Type u)
    [Fintype ρ] [DecidableEq ρ] : Prop := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  letI : DecidableEq Z.PhysicalState := Z.physicalDecidableEq
  letI : Fintype Y.spectral.State := Y.spectral.stateFintype
  letI : DecidableEq Y.spectral.State := Y.spectral.stateDecidableEq
  exact
    ∃ eObs : Y.spectral.Observer ≃ LeafExtendedObserver Z.spectral.Observer,
    ∃ eP : Y.PhysicalState ≃ (Z.PhysicalState × ρ),
      (∀ (s : Y.spectral.Observer)
          (L : Matrix Y.PhysicalState Y.PhysicalState ℂ),
          Y.locality.tree.IsOneSite s L →
          (∀ t, eObs s = Sum.inl t →
              ∃ M : Matrix Z.PhysicalState Z.PhysicalState ℂ,
                Z.locality.tree.IsOneSite t M ∧
                  Matrix.reindex eP eP L = layerMatrixCoupling M 1) ∧
            ∀ u, eObs s = Sum.inr u →
              ∃ N : Matrix ρ ρ ℂ,
                Matrix.reindex eP eP L = layerMatrixCoupling 1 N) ∧
        ∀ H : Matrix Y.PhysicalState Y.PhysicalState ℂ,
          Y.locality.tree.IsLocalHamiltonian H →
          ∃ (oldHamiltonian parentOperator :
              Matrix Z.PhysicalState Z.PhysicalState ℂ)
            (shift : ρ → ℂ) (edge : Matrix ρ ρ ℂ),
            Z.locality.tree.IsLocalHamiltonian oldHamiltonian ∧
              Z.locality.tree.IsOneSite root parentOperator ∧
                Matrix.reindex eP eP H =
                  physicalLeafHamiltonian oldHamiltonian parentOperator
                    shift edge

/-- One exact physical leaf extension preserves the full tensor-tree
locality certificate while retaining maximal projective spectrum and all
observer-good transition graphs. -/
theorem exists_physicallyRealizedTensorTree_leafExtension
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (root : Z.spectral.Observer)
    (ρ : Type u) [Fintype ρ] [DecidableEq ρ]
    (anchor other : ρ) (hother : other ≠ anchor)
    (hcard : 2 ≤ Fintype.card ρ) :
    ∃ Y : PhysicallyRealizedTensorTreeSystem.{u},
      IsTensorTreeLeafExtension Z Y root ρ ∧
      Y.spectral.stateCard =
        Z.spectral.stateCard * Fintype.card ρ ∧
      Y.spectral.observerCard =
        Z.spectral.observerCard + 1 ∧
      IsPhysicalLeafChart Z Y root ρ := by
  let X := Z.spectral
  let R := Z.realization
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Nonempty X.State := X.stateNonempty
  letI : Nontrivial X.State := X.stateNontrivial
  letI : Fintype X.Observer := X.observerFintype
  letI : DecidableEq X.Observer := X.observerDecidableEq
  letI : Nonempty X.Observer := X.observerNonempty
  letI : ∀ s, Fintype (X.Probe s) := X.probeFintype
  letI : ∀ s, DecidableEq (X.Probe s) := X.probeDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  letI : Nonempty ρ :=
    Fintype.card_pos_iff.mp (lt_of_lt_of_le (by omega) hcard)
  letI : Nontrivial ρ :=
    Fintype.one_lt_card_iff_nontrivial.mp
      (lt_of_lt_of_le (by omega) hcard)
  obtain ⟨coefficient, attachment, hattachment,
      n, C, oldProbe, holdOrigin, newProbe, parameter,
      hH, e, he, hdiagonal, hmax, hgood,
      hbasisLeft, hbasisRight,
      hphysicalDiagonal, hprobeCoordinate⟩ :=
    exists_maximallyProjective_physicalLocalGoodObserverFamily_leafExtension
      X R root ρ anchor other hother hcard
  let parentPhysical :=
    realMatrixFamilyCombination
      (R.physicalProbe root) coefficient
  let shift : ρ → ℂ := fun r =>
    (codedIntegerLayerShift anchor n r : ℂ)
  let G : X.Observer → SimpleGraph X.State := fun s =>
    transitionFamilySupportGraph (X.transition s)
  let p : (ρ → ℂ) × Matrix ρ ρ ℂ :=
    realLocalExtensionParameter
      (localExtensionSliceParameter parameter)
  let nextEnergy : X.State × ρ → ℝ :=
    C.realBranchEnergy
      (fun i => (X.energy i : ℂ))
      shift attachment p
  let nextTransition :
      ∀ s : LeafExtendedObserver X.Observer,
        LeafExtendedProbeIndex G attachment anchor s →
          Matrix (X.State × ρ) (X.State × ρ) ℂ :=
    unitaryLeafExtendedProbeMatrixFamily
      G anchor C oldProbe newProbe hH e
  let V := C.unitaryEigenvectorMatrix hH e
  let basis := physicalLeafSpectralBasis R.basis V
  let physicalHamiltonian :=
    physicalLeafHamiltonian R.hamiltonian
      parentPhysical p.1 p.2
  let physicalProbe :=
    physicalLeafExtendedProbeFamily
      R G attachment anchor oldProbe holdOrigin newProbe
  let Y : GoodObserverSpectralSystem.{u} :=
    { State := X.State × ρ
      Observer := LeafExtendedObserver X.Observer
      Probe := LeafExtendedProbeIndex G attachment anchor
      stateFintype := inferInstance
      stateDecidableEq := inferInstance
      stateNonempty := inferInstance
      stateNontrivial := inferInstance
      observerFintype := inferInstance
      observerDecidableEq := inferInstance
      observerNonempty := inferInstance
      probeFintype := fun s =>
        leafExtendedProbeIndexFintype G attachment anchor s
      probeDecidableEq := fun s =>
        leafExtendedProbeIndexDecidableEq G attachment anchor s
      energy := nextEnergy
      energy_maximallyProjective := hmax
      transition := nextTransition
      observerFamily_good := hgood }
  let RY :
      @GoodObserverSpectralSystem.PhysicalRealization
        Y Y.stateFintype Y.stateDecidableEq :=
    { PhysicalState := R.PhysicalState × ρ
      physicalFintype := inferInstance
      physicalDecidableEq := inferInstance
      basis := basis
      star_basis_mul_basis := hbasisLeft
      basis_mul_star_basis := hbasisRight
      hamiltonian := physicalHamiltonian
      hamiltonian_eq_diagonal := hphysicalDiagonal
      physicalProbe := physicalProbe
      transition_eq_coordinate := hprobeCoordinate }
  have hparentLocal : Z.locality.tree.IsOneSite root parentPhysical := by
    exact Z.locality.tree.isOneSite_realMatrixFamilyCombination
      root (R.physicalProbe root) coefficient
      (fun i => Z.locality.probe_local root i)
  have hHamiltonianLocal :
      (RootedTensorTree.leaf Z.locality.tree ρ root).IsLocalHamiltonian
        physicalHamiltonian := by
    exact Z.locality.tree.isLocalHamiltonian_physicalLeafHamiltonian
      root R.hamiltonian parentPhysical p.1 p.2
      Z.locality.hamiltonian_local hparentLocal
  have hProbeLocal : ∀ s i,
      (RootedTensorTree.leaf Z.locality.tree ρ root).IsOneSite s
        (physicalProbe s i) := by
    intro s i
    cases s with
    | inl s =>
        refine ⟨R.physicalProbe s
            (Classical.choose (holdOrigin s i)),
          Z.locality.probe_local s _, rfl⟩
    | inr _ =>
        exact ⟨newProbe i, rfl⟩
  let result : PhysicallyRealizedTensorTreeSystem.{u} :=
    { spectral := Y
      realization := RY
      locality :=
        { tree := RootedTensorTree.leaf Z.locality.tree ρ root
          hamiltonian_local := hHamiltonianLocal
          probe_local := hProbeLocal } }
  refine ⟨result, ?_, ?_, ?_, ?_⟩
  · refine ⟨Equiv.refl _, ?_⟩
    ext a b
    cases a <;> cases b <;> rfl
  · simp [result, Y, X, GoodObserverSpectralSystem.stateCard]
  · simp [result, Y, X, GoodObserverSpectralSystem.observerCard]
  · refine ⟨Equiv.refl _, Equiv.refl _, ?_, ?_⟩
    · intro s L hL
      constructor
      · rintro t rfl
        obtain ⟨M, hM, hLeq⟩ := hL
        exact ⟨M, hM, hLeq⟩
      · rintro u rfl
        obtain ⟨N, hLeq⟩ := hL
        exact ⟨N, hLeq⟩
    · intro H hH
      obtain ⟨oldHamiltonian, parentOperator, shift, edge,
        hold, hparent, hHeq⟩ := hH
      exact ⟨oldHamiltonian, parentOperator, shift, edge,
        hold, hparent, hHeq⟩

/-- One local factor of dimension at least three supplies the exact atom
base for tensor-tree growth. -/
theorem exists_physicallyRealizedTensorTree_completeOneSiteSeed
    (I : Type u) [Fintype I] [DecidableEq I]
    (hcard : 3 ≤ Fintype.card I) :
    ∃ Z : PhysicallyRealizedTensorTreeSystem.{u},
      Z.spectral.stateCard = Fintype.card I ∧
      Z.spectral.observerCard = 1 ∧
      Z.architectureGraph = ⊥ := by
  obtain ⟨Z, hstate, hobserver⟩ :=
    exists_physicallyRealized_completeOneSiteSeed I hcard
  let X := Z.spectral
  let R := Z.realization
  letI : Fintype X.State := X.stateFintype
  letI : DecidableEq X.State := X.stateDecidableEq
  letI : Fintype X.Observer := X.observerFintype
  letI : DecidableEq X.Observer := X.observerDecidableEq
  letI : Fintype R.PhysicalState := R.physicalFintype
  letI : DecidableEq R.PhysicalState := R.physicalDecidableEq
  let T : RootedTensorTree R.PhysicalState X.Observer :=
    RootedTensorTree.atom R.PhysicalState X.Observer
  let result : PhysicallyRealizedTensorTreeSystem.{u} :=
    { spectral := X
      realization := R
      locality :=
        { tree := T
          hamiltonian_local := by
            simp [T, RootedTensorTree.IsLocalHamiltonian]
          probe_local := by
            intro s i
            simp [T, RootedTensorTree.IsOneSite] } }
  refine ⟨result, ?_, ?_, ?_⟩
  · simpa [result, X] using hstate
  · simpa [result, X] using hobserver
  · rfl

/-- Exact two-site provenance of the two-qubit seed: its carrier is the product
of the two local factors and its one-site operators are the operators of one
factor tensored with the identity on the other. -/
def IsTwoQubitSiteChart (Z : PhysicallyRealizedTensorTreeSystem.{0}) : Prop := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  exact
    ∃ eObs : Z.spectral.Observer ≃ Bool,
    ∃ eP : Z.PhysicalState ≃ (Bool × Bool),
      ∀ (s : Z.spectral.Observer)
        (L : Matrix Z.PhysicalState Z.PhysicalState ℂ),
        Z.locality.tree.IsOneSite s L →
        (eObs s = false → ∃ M : Matrix Bool Bool ℂ,
            Matrix.reindex eP eP L = layerMatrixCoupling M 1) ∧
          (eObs s = true → ∃ N : Matrix Bool Bool ℂ,
            Matrix.reindex eP eP L = layerMatrixCoupling 1 N)

/-- Explicit two-qubit graph-state seed with exact edge architecture and
endpoint-local physical probes. -/
theorem exists_physicallyRealizedTensorTree_twoQubitGraphSeed :
    ∃ Z : PhysicallyRealizedTensorTreeSystem.{0},
      Z.spectral.stateCard = 4 ∧
      Z.spectral.observerCard = 2 ∧
      Z.architectureGraph = ⊤ ∧
      IsTwoQubitSiteChart Z := by
  obtain ⟨energy, henergyMaximal, _⟩ :=
    exists_maximallyProjectiveEnergy_close_fintype
      (fun _ : Bool × Bool => 0) 1 (by norm_num)
  have hgood :
      HermitianObserverFamilyGood
        twoQubitEndpointTransition := by
    intro s
    refine ⟨?_, ?_, ?_⟩
    · intro q
      exact twoQubitEndpointTransition_isHermitian s q
    · rw [transitionFamilySupportGraph_twoQubitEndpointTransition]
      exact SimpleGraph.preconnected_top
    · rw [transitionFamilySupportGraph_twoQubitEndpointTransition]
      exact completeGraph_not_isBipartite_of_three_le_card
        (I := Bool × Bool) (by norm_num)
  let X : GoodObserverSpectralSystem.{0} :=
    { State := Bool × Bool
      Observer := Bool
      Probe := fun _ => Fin 3
      stateFintype := inferInstance
      stateDecidableEq := inferInstance
      stateNonempty := inferInstance
      stateNontrivial := inferInstance
      observerFintype := inferInstance
      observerDecidableEq := inferInstance
      observerNonempty := inferInstance
      probeFintype := fun _ => inferInstance
      probeDecidableEq := fun _ => inferInstance
      energy := energy
      energy_maximallyProjective := henergyMaximal
      transition := twoQubitEndpointTransition
      observerFamily_good := hgood }
  let hamiltonian : Matrix (Bool × Bool) (Bool × Bool) ℂ :=
    twoQubitGraphBasis *
      Matrix.diagonal (fun i => (energy i : ℂ)) *
      twoQubitGraphBasisᴴ
  let R :
      @GoodObserverSpectralSystem.PhysicalRealization
        X X.stateFintype X.stateDecidableEq :=
    { PhysicalState := Bool × Bool
      physicalFintype := inferInstance
      physicalDecidableEq := inferInstance
      basis := twoQubitGraphBasis
      star_basis_mul_basis :=
        twoQubitGraphBasis_conjTranspose_mul_self
      basis_mul_star_basis :=
        twoQubitGraphBasis_mul_conjTranspose_self
      hamiltonian := hamiltonian
      hamiltonian_eq_diagonal := rfl
      physicalProbe := twoQubitEndpointProbe
      transition_eq_coordinate := by
        intro s q
        rfl }
  let T : RootedTensorTree (Bool × Bool) Bool :=
    RootedTensorTree.edge Bool Bool Bool (Equiv.refl Bool)
  have hprobe : ∀ s q, T.IsOneSite s (twoQubitEndpointProbe s q) := by
    intro s q
    cases s with
    | false =>
        change ∃ L, twoQubitEndpointProbe false q =
          layerMatrixCoupling L (1 : Matrix Bool Bool ℂ)
        exact ⟨boolPauli q, by
          simp [twoQubitEndpointProbe]⟩
    | true =>
        change ∃ R, twoQubitEndpointProbe true q =
          layerMatrixCoupling (1 : Matrix Bool Bool ℂ) R
        exact ⟨boolPauli q, by
          simp [twoQubitEndpointProbe]⟩
  let result : PhysicallyRealizedTensorTreeSystem.{0} :=
    { spectral := X
      realization := R
      locality :=
        { tree := T
          hamiltonian_local := by
            change True
            trivial
          probe_local := hprobe } }
  refine ⟨result, ?_, ?_, ?_, ?_⟩
  · simp [result, X, GoodObserverSpectralSystem.stateCard]
  · simp [result, X, GoodObserverSpectralSystem.observerCard]
  · rfl
  · refine ⟨Equiv.refl _, Equiv.refl _, ?_⟩
    intro s L hL
    cases s with
    | false =>
        refine ⟨fun _ => ?_, fun h => absurd h (by simp)⟩
        exact hL
    | true =>
        refine ⟨fun h => absurd h (by simp), fun _ => ?_⟩
        exact hL

/-- Maximal projective independence gives the full anchored gap rank on
an arbitrary finite label type, without reindexing it by `Fin`. -/
theorem anchoredTemporalRank_eq_card_sub_one_of_maximallyProjective
    {I : Type u} [Fintype I] [DecidableEq I]
    (energy : I → ℝ) (hmax : MaximallyProjectiveEnergy energy)
    (reference : I) :
    anchoredTemporalRank energy reference = Fintype.card I - 1 := by
  let gap : {i : I // i ≠ reference} → ℝ :=
    projectiveFrequency energy reference
  have hindInt :
      ∀ n : {i : I // i ≠ reference} → ℤ,
        (∑ i, (n i : ℝ) * gap i) = 0 → n = 0 := by
    exact maximallyProjectiveEnergy_projectiveFrequency_independent
      energy hmax reference
  have hind : LinearIndependent ℚ gap := by
    rw [← LinearIndependent.iff_fractionRing ℤ ℚ]
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have hzero : (∑ i, (g i : ℝ) * gap i) = 0 := by
      simpa [zsmul_eq_mul] using hg
    have hz := hindInt g hzero
    exact fun i => congrFun hz i
  have hspan :
      anchoredGapSubspace energy reference =
        Submodule.span ℚ (Set.range gap) := by
    apply le_antisymm
    · apply Submodule.span_le.2
      rintro _ ⟨i, rfl⟩
      by_cases hi : i = reference
      · simp [hi]
      · exact Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩
    · apply Submodule.span_le.2
      rintro _ ⟨i, rfl⟩
      exact Submodule.subset_span ⟨i.1, rfl⟩
  unfold anchoredTemporalRank
  rw [hspan, finrank_span_eq_card hind]
  exact Set.card_ne_eq reference

/-- Every packaged maximal spectrum has full anchored rank, stated using
the package's stored finite-cardinality instance. -/
theorem PhysicallyRealizedTensorTreeSystem.anchoredRank_eq_stateCard_sub_one
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (reference : Z.spectral.State) :
    Z.anchoredRank reference = Z.spectral.stateCard - 1 := by
  letI : Fintype Z.spectral.State := Z.spectral.stateFintype
  letI : DecidableEq Z.spectral.State := Z.spectral.stateDecidableEq
  change anchoredTemporalRank Z.spectral.energy reference =
    @Fintype.card Z.spectral.State Z.spectral.stateFintype - 1
  exact anchoredTemporalRank_eq_card_sub_one_of_maximallyProjective
    Z.spectral.energy Z.spectral.energy_maximallyProjective reference

/-- Transport a complete parent schedule along an observer equivalence. -/
def observerLeafScheduleEquiv
    {S T : Type u} (e : S ≃ T) :
    (dimensions : List ℕ) →
      ObserverLeafSchedule S dimensions ≃
        ObserverLeafSchedule T dimensions
  | [] => Equiv.refl PUnit
  | _q :: tail =>
      Equiv.prodCongr e
        (observerLeafScheduleEquiv
          (Equiv.sumCongr e (Equiv.refl PUnit)) tail)

/-- Exact recursive certificate that a result was obtained from a supplied
parent schedule.  It records every observer relabelling, generated leaf
edge, and state/observer cardinality change. -/
def IsTensorTreeLeafScheduleExtension :
    (Z : PhysicallyRealizedTensorTreeSystem.{u}) →
    (dimensions : List ℕ) →
    ObserverLeafSchedule Z.spectral.Observer dimensions →
    PhysicallyRealizedTensorTreeSystem.{u} → Prop
  | Z, [], _schedule, Y => Y = Z
  | Z, q :: tail, schedule, Y =>
      ∃ W : PhysicallyRealizedTensorTreeSystem.{u},
      ∃ e : W.spectral.Observer ≃
          LeafExtendedObserver Z.spectral.Observer,
        W.architectureGraph =
            SimpleGraph.comap e
              (leafGraphExtension Z.architectureGraph schedule.1) ∧
        W.spectral.stateCard = Z.spectral.stateCard * q ∧
        W.spectral.observerCard = Z.spectral.observerCard + 1 ∧
        IsTensorTreeLeafScheduleExtension W tail
          (observerLeafScheduleEquiv e.symm tail schedule.2) Y

/-- Iterating exact physical leaf extensions preserves tensor-tree locality
and multiplies the state cardinality by every prescribed local dimension. -/
theorem exists_physicallyRealizedTensorTree_leafSchedule
    (Z : PhysicallyRealizedTensorTreeSystem.{u})
    (dimensions : List ℕ)
    (hdimensions : ∀ q ∈ dimensions, 2 ≤ q)
    (schedule :
      ObserverLeafSchedule Z.spectral.Observer dimensions) :
    ∃ Y : PhysicallyRealizedTensorTreeSystem.{u},
      Y.spectral.stateCard =
        Z.spectral.stateCard * dimensions.prod ∧
      Y.spectral.observerCard =
        Z.spectral.observerCard + dimensions.length ∧
      IsTensorTreeLeafScheduleExtension Z dimensions schedule Y := by
  cases dimensions with
  | nil =>
      exact ⟨Z, by simp, by simp, rfl⟩
  | cons q tailDimensions =>
      change
        Z.spectral.Observer ×
          ObserverLeafSchedule
            (LeafExtendedObserver Z.spectral.Observer)
              tailDimensions at schedule
      obtain ⟨root, tailSchedule⟩ := schedule
      have hq : 2 ≤ q :=
        hdimensions q (by simp)
      have htail : ∀ r ∈ tailDimensions, 2 ≤ r := by
        intro r hr
        exact hdimensions r (by simp [hr])
      let Local : Type u := ULift.{u} (Fin q)
      let anchorFin : Fin q :=
        ⟨0, lt_of_lt_of_le (by decide : 0 < 2) hq⟩
      let otherFin : Fin q := ⟨1, hq⟩
      let anchor : Local := ULift.up anchorFin
      let other : Local := ULift.up otherFin
      have hotherFin : otherFin ≠ anchorFin := by
        intro h
        have := congrArg Fin.val h
        simp [otherFin, anchorFin] at this
      have hother : other ≠ anchor := by
        intro h
        exact hotherFin (ULift.up_injective h)
      have hLocalCard : Fintype.card Local = q := by
        simp [Local]
      obtain ⟨W, hstep, hWstate, hWobserver, _⟩ :=
        exists_physicallyRealizedTensorTree_leafExtension
          Z root Local anchor other hother
            (by simpa [hLocalCard] using hq)
      obtain ⟨e, _hgraph⟩ := hstep
      let transportedTail :
          ObserverLeafSchedule W.spectral.Observer tailDimensions :=
        observerLeafScheduleEquiv e.symm tailDimensions tailSchedule
      obtain ⟨Y, hYstate, hYobserver, hYschedule⟩ :=
        exists_physicallyRealizedTensorTree_leafSchedule
          W tailDimensions htail transportedTail
      refine ⟨Y, ?_, ?_, ?_⟩
      · rw [hYstate, hWstate, hLocalCard]
        simp only [List.prod_cons]
        ac_rfl
      · rw [hYobserver, hWobserver]
        simp only [List.length_cons]
        omega
      · exact ⟨W, e, _hgraph, by simpa [hLocalCard] using hWstate,
          hWobserver, hYschedule⟩
termination_by dimensions.length

/-- Any rooted tensor tree whose initial local factor has dimension at
least three has an exact graph-local physical witness with maximal
projective rank. -/
theorem exists_completeOneSiteSeed_tensorTreeSchedule_maximal
    (I : Type u) [Fintype I] [DecidableEq I]
    (hcard : 3 ≤ Fintype.card I) :
    ∃ Base : PhysicallyRealizedTensorTreeSystem.{u},
      Base.spectral.stateCard = Fintype.card I ∧
      Base.spectral.observerCard = 1 ∧
      Base.architectureGraph = ⊥ ∧
      ∀ (dimensions : List ℕ)
        (_hdimensions : ∀ q ∈ dimensions, 2 ≤ q)
        (schedule :
          ObserverLeafSchedule Base.spectral.Observer dimensions),
        ∃ Y : PhysicallyRealizedTensorTreeSystem.{u},
          Y.spectral.stateCard =
            Fintype.card I * dimensions.prod ∧
          Y.spectral.observerCard =
            1 + dimensions.length ∧
          IsTensorTreeLeafScheduleExtension
            Base dimensions schedule Y ∧
          ∀ reference : Y.spectral.State,
            Y.anchoredRank reference =
              Fintype.card I * dimensions.prod - 1 := by
  obtain ⟨Base, hBaseState, hBaseObserver, hBaseGraph⟩ :=
    exists_physicallyRealizedTensorTree_completeOneSiteSeed I hcard
  refine ⟨Base, hBaseState, hBaseObserver, hBaseGraph, ?_⟩
  intro dimensions hdimensions schedule
  obtain ⟨Y, hYstate, hYobserver, hYschedule⟩ :=
    exists_physicallyRealizedTensorTree_leafSchedule
      Base dimensions hdimensions schedule
  refine ⟨Y, ?_, ?_, hYschedule, ?_⟩
  · simpa [hBaseState] using hYstate
  · simpa [hBaseObserver] using hYobserver
  · intro reference
    rw [Y.anchoredRank_eq_stateCard_sub_one,
      hYstate, hBaseState]

/-- All-local-dimension-two rooted tensor trees start from the exact
two-qubit edge seed and retain maximal projective rank through every later
leaf attachment. -/
theorem exists_twoQubitSeed_tensorTreeSchedule_maximal :
    ∃ Base : PhysicallyRealizedTensorTreeSystem.{0},
      Base.spectral.stateCard = 4 ∧
      Base.spectral.observerCard = 2 ∧
      Base.architectureGraph = ⊤ ∧
      ∀ (tailLength : ℕ)
        (schedule :
          ObserverLeafSchedule Base.spectral.Observer
            (List.replicate tailLength 2)),
        ∃ Y : PhysicallyRealizedTensorTreeSystem.{0},
          Y.spectral.stateCard = 2 ^ (tailLength + 2) ∧
          Y.spectral.observerCard = tailLength + 2 ∧
          IsTensorTreeLeafScheduleExtension Base
            (List.replicate tailLength 2) schedule Y ∧
          ∀ reference : Y.spectral.State,
            Y.anchoredRank reference =
              2 ^ (tailLength + 2) - 1 := by
  obtain ⟨Base, hBaseState, hBaseObserver, hBaseGraph, -⟩ :=
    exists_physicallyRealizedTensorTree_twoQubitGraphSeed
  refine ⟨Base, hBaseState, hBaseObserver, hBaseGraph, ?_⟩
  intro tailLength schedule
  have hdimensions :
      ∀ q ∈ List.replicate tailLength 2, 2 ≤ q := by
    intro q hq
    have hq2 : q = 2 := List.eq_of_mem_replicate hq
    omega
  obtain ⟨Y, hYstate, hYobserver, hYschedule⟩ :=
    exists_physicallyRealizedTensorTree_leafSchedule
      Base (List.replicate tailLength 2) hdimensions schedule
  have hstate : Y.spectral.stateCard = 2 ^ (tailLength + 2) := by
    rw [hYstate, hBaseState]
    simp [pow_add, pow_two, Nat.mul_comm]
  refine ⟨Y, hstate, ?_, hYschedule, ?_⟩
  · rw [hYobserver, hBaseObserver]
    simp
    omega
  · intro reference
    rw [Y.anchoredRank_eq_stateCard_sub_one, hstate]

end

