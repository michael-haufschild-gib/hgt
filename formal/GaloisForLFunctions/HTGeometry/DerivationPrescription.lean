import GaloisForLFunctions.HTGeometry.KaehlerKernel

/-!
# Derivations with prescribed values on an algebraically independent family

In characteristic zero the values of a derivation may be prescribed arbitrarily on an
algebraically independent family.

The construction has two steps.  On the rational function field generated by the family, the
coordinate derivation of the polynomial ring with the prescribed values extends to the fraction
field and transports through the canonical isomorphism.  The remaining extension is algebraic,
hence separable, hence formally etale, so Kähler base change lifts the derivation to the whole
field.
-/

open Set IntermediateField MvPolynomial TensorProduct

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- On the field generated by an algebraically independent family, a derivation may be prescribed
arbitrarily on the family. -/
theorem exists_derivation_adjoin
    {ι K L : Type*} [Field K] [Field L] [Algebra K L]
    {x : ι → L} (hx : AlgebraicIndependent K x) (val : ι → K) :
    ∃ D : Derivation K (IntermediateField.adjoin K (Set.range x))
        (IntermediateField.adjoin K (Set.range x)),
      ∀ i, D ⟨x i, IntermediateField.subset_adjoin K (Set.range x) ⟨i, rfl⟩⟩
        = algebraMap K _ (val i) := by
  classical
  let F := IntermediateField.adjoin K (Set.range x)
  let Q := FractionRing (MvPolynomial ι K)
  let dpoly : Derivation K (MvPolynomial ι K) Q :=
    MvPolynomial.mkDerivation K fun i => algebraMap K Q (val i)
  let dfrac : Derivation K Q Q := fractionRingDerivation dpoly
  let e : Q ≃ₐ[K] F := hx.aevalEquivField
  refine ⟨transportDerivation e dfrac, fun i => ?_⟩
  have heX : e.symm ⟨x i, IntermediateField.subset_adjoin K (Set.range x) ⟨i, rfl⟩⟩
      = algebraMap (MvPolynomial ι K) Q (MvPolynomial.X i) := by
    apply e.injective
    rw [e.apply_symm_apply]
    apply Subtype.ext
    change x i = (hx.aevalEquivField
      (algebraMap (MvPolynomial ι K) Q (MvPolynomial.X i)) : F)
    rw [hx.aevalEquivField_algebraMap_apply_coe]
    simp
  have hmk : dpoly (MvPolynomial.X i) = algebraMap K Q (val i) :=
    MvPolynomial.mkDerivation_X K (fun i => algebraMap K Q (val i)) i
  rw [transportDerivation_apply, heX, fractionRingDerivation_algebraMap, hmk]
  exact e.commutes (val i)

/-- A derivation of a subfield extends to any separable algebraic extension. -/
theorem exists_derivation_extension
    {K F L : Type*} [Field K] [Field F] [Field L]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    [Algebra.IsSeparable F L] (D : Derivation K F F) :
    ∃ D' : Derivation K L L, ∀ a : F, D' (algebraMap F L a) = algebraMap F L (D a) := by
  letI : Algebra.FormallyEtale F L := Algebra.FormallyEtale.of_isSeparable F L
  let dF : Derivation K F L := (Algebra.linearMap F L).compDer D
  let φ : Ω[F⁄K] →ₗ[F] L := dF.liftKaehlerDifferential
  let ψ : L ⊗[F] Ω[F⁄K] →ₗ[L] L := φ.liftBaseChange L
  let χ : Ω[L⁄K] →ₗ[L] L :=
    ψ ∘ₗ (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K F L).symm.toLinearMap
  refine ⟨χ.compDer (KaehlerDifferential.D K L), fun a => ?_⟩
  show ψ ((KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K F L).symm
    (KaehlerDifferential.D K L (algebraMap F L a))) = _
  rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap,
    LinearMap.liftBaseChange_tmul, one_smul, Derivation.liftKaehlerDifferential_comp_D]
  rfl

/-- **Prescription of a derivation.**  In characteristic zero, the values of a derivation on an
algebraically independent family may be prescribed arbitrarily in the base field. -/
theorem exists_derivation_prescribed
    {C L : Type*} [Field C] [Field L] [Algebra C L] [CharZero C]
    {κ : Type*} {z : κ → L} (hz : AlgebraicIndependent C z) (val : κ → C) :
    ∃ D : Derivation C L L, ∀ k, D (z k) = algebraMap C L (val k) := by
  classical
  have hinj : Function.Injective z := hz.injective
  have hindepOn : AlgebraicIndepOn C id (Set.range z) := hz.coe_range
  have hI : (AlgebraicIndependent.matroid C L).Indep (Set.range z) :=
    AlgebraicIndependent.matroid_indep_iff.mpr hindepOn
  obtain ⟨B, hBbase, hzB⟩ := hI.exists_isBase_superset
  have hB : IsTranscendenceBasis C ((↑) : B → L) :=
    AlgebraicIndependent.matroid_isBase_iff.mp hBbase
  let F := IntermediateField.adjoin C (Set.range ((↑) : B → L))
  -- prescribe the values on the basis
  set bval : B → C := fun b =>
    if h : ∃ k, z k = (b : L) then val h.choose else 0 with hbval
  obtain ⟨DF, hDF⟩ := exists_derivation_adjoin hB.1 bval
  -- extend along the algebraic part
  letI : Algebra.IsAlgebraic F L := hB.isAlgebraic_field
  letI : Algebra.IsIntegral F L := Algebra.IsAlgebraic.isIntegral
  letI : Algebra.IsSeparable F L := by infer_instance
  obtain ⟨D, hD⟩ := exists_derivation_extension (K := C) (F := F) (L := L) DF
  refine ⟨D, fun k => ?_⟩
  have hmemF : z k ∈ F :=
    IntermediateField.subset_adjoin C (Set.range ((↑) : B → L))
      ⟨(⟨z k, hzB ⟨k, rfl⟩⟩ : B), rfl⟩
  have hval : bval ⟨z k, hzB ⟨k, rfl⟩⟩ = val k := by
    have hex : ∃ j, z j = z k := ⟨k, rfl⟩
    simp only [hbval]
    rw [dif_pos hex]
    congr 1
    exact hinj hex.choose_spec
  have hbase : D (algebraMap F L ⟨z k, hmemF⟩) = algebraMap F L (DF ⟨z k, hmemF⟩) := hD _
  have hDFval : DF ⟨z k, hmemF⟩ = algebraMap C F (val k) := by
    have := hDF ⟨z k, hzB ⟨k, rfl⟩⟩
    rw [hval] at this
    exact this
  rw [show (algebraMap F L ⟨z k, hmemF⟩ : L) = z k from rfl] at hbase
  rw [hbase, hDFval]
  exact (IsScalarTower.algebraMap_apply C F L (val k)).symm

end

end GaloisForLFunctions.HTGeometry
