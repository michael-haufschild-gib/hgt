import GaloisForLFunctions.HTGeometry.SplittingFieldPermTransport
import GaloisForLFunctions.HTGeometry.CubeSwapGaloisAssembly

/-!
# Transporting a realized permutation to the field generated by a labelled family

A deformation realizes a permutation of a labelled root family inside an auxiliary field.  If the
two labelled families have the same image in a common overfield, the permutation is realized on the
field generated by the original family.

## Main results

* `exists_algEquiv_adjoin_of_matching` — the transport.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- **A permutation realized on a matching family is realized on the field generated by the
original family.** -/
theorem exists_algEquiv_adjoin_of_matching
    {K Ω₀ Ω₁ Ω₂ : Type*} [Field K] [Field Ω₀] [Field Ω₁] [Field Ω₂]
    [Algebra K Ω₀] [Algebra K Ω₁] [Algebra K Ω₂]
    (β : Ω₀ →ₐ[K] Ω₂) (γ : Ω₁ →ₐ[K] Ω₂)
    {ι : Type*} (Θ : ι → Ω₀) (Θ' : ι → Ω₁)
    (hmatch : ∀ x, β (Θ x) = γ (Θ' x))
    (σ' : Ω₁ ≃ₐ[K] Ω₁) {π : Equiv.Perm ι} (hσ' : ∀ x, σ' (Θ' x) = Θ' (π x)) :
    ∃ σ : ↥(IntermediateField.adjoin K (Set.range Θ)) ≃ₐ[K]
        ↥(IntermediateField.adjoin K (Set.range Θ)),
      ∀ x, σ ⟨Θ x, IntermediateField.subset_adjoin K _ ⟨x, rfl⟩⟩
        = ⟨Θ (π x), IntermediateField.subset_adjoin K _ ⟨π x, rfl⟩⟩ := by
  classical
  obtain ⟨e, he⟩ := exists_algEquiv_of_matching_embeddings
    (adjoin_range_corestrict_eq_top (K := K) Θ) (adjoin_range_corestrict_eq_top (K := K) Θ')
    (β.comp (IntermediateField.adjoin K (Set.range Θ)).val)
    (γ.comp (IntermediateField.adjoin K (Set.range Θ')).val)
    (fun x => hmatch x)
  obtain ⟨σ'', hσ''⟩ := exists_algEquiv_of_embedding
    (adjoin_range_corestrict_eq_top (K := K) Θ')
    (IntermediateField.adjoin K (Set.range Θ')).val σ' (fun x => hσ' x)
  exact realized_of_algEquiv_transport e he σ'' hσ''

end

end GaloisForLFunctions.HTGeometry
