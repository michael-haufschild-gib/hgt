import GaloisForLFunctions.HTGeometry.DifferentialConnectionModule
import GaloisForLFunctions.HTGeometry.HypertranscendentalKaehlerClockSymbol
import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import GaloisForLFunctions.HTGeometry.KaehlerDifferentialGeneration

/-!
# Relative Kähler differentials over a differential base

For a differential field extension `K/C`, the derivation of `K` preserves `C` rather than killing
it.  Relative differentials still carry the canonical connection because
`d_{K/C}(δ(c)) = 0`.  The generic connection-to-Ore-module construction then makes `Ω[K⁄C]` a
`K[∂;δ]`-module, generated by the differentials of every differential generating set.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {C K : Type*} [Field C] [Field K] [Differential C] [Differential K]
  [Algebra C K] [DifferentialAlgebra C K]

/-- The field derivation preserves the relative base modulo universal differentials. -/
theorem relativeKaehler_baseCondition (c : C) :
    KaehlerDifferential.D C K
      ((Differential.deriv : Derivation ℤ K K) (algebraMap C K c)) = 0 := by
  rw [DifferentialAlgebra.deriv_algebraMap]
  exact (KaehlerDifferential.D C K).map_algebraMap (Differential.deriv c)

/-- Canonical connection on relative Kähler differentials over a differential base. -/
noncomputable def relativeKaehlerConnection : Ω[K⁄C] →+ Ω[K⁄C] :=
  kaehlerConnectionDifferential
    (Differential.deriv : Derivation ℤ K K) relativeKaehler_baseCondition

@[simp] theorem relativeKaehlerConnection_D (x : K) :
    relativeKaehlerConnection (C := C) (K := K) (KaehlerDifferential.D C K x) =
      KaehlerDifferential.D C K (Differential.deriv x) :=
  kaehlerConnectionDifferential_D _ _ x

theorem relativeKaehlerConnection_smul (a : K) (ω : Ω[K⁄C]) :
    relativeKaehlerConnection (C := C) (K := K) (a • ω) =
      a • relativeKaehlerConnection (C := C) (K := K) ω +
        (Differential.deriv a) • ω := by
  rw [relativeKaehlerConnection, kaehlerConnectionDifferential_smul]
  abel

/-- Relative Kähler differentials as a module over the Ore ring of the upper field. -/
@[reducible] noncomputable def relativeKaehlerDiffOpModule :
    Module (DiffOp K) Ω[K⁄C] :=
  connectionDiffOpModule (relativeKaehlerConnection (C := C) (K := K))
    relativeKaehlerConnection_smul

/-- A connection-stable subspace containing a differential generating set is the full relative
Kähler module. -/
theorem relativeKaehler_eq_top_of_connection_stable
    (N : Submodule K Ω[K⁄C])
    (hstable : ∀ ω ∈ N, relativeKaehlerConnection (C := C) (K := K) ω ∈ N)
    {S : Set K} (hS : differentialAdjoin C S = ⊤)
    (hSN : ∀ s ∈ S, KaehlerDifferential.D C K s ∈ N) : N = ⊤ := by
  have hclosed : DerivationClosed (kaehlerMembershipField (C := C) (K := K) N) := by
    intro x hx
    show KaehlerDifferential.D C K (Differential.deriv x) ∈ N
    rw [← relativeKaehlerConnection_D]
    exact hstable _ hx
  have hle : differentialAdjoin C S ≤ kaehlerMembershipField (C := C) (K := K) N :=
    differentialAdjoin_le C (fun s hs => hSN s hs) hclosed
  rw [hS, top_le_iff] at hle
  have hall : ∀ x : K, KaehlerDifferential.D C K x ∈ N := by
    intro x
    have hx : x ∈ kaehlerMembershipField (C := C) (K := K) N := by
      rw [hle]
      exact IntermediateField.mem_top
    exact hx
  apply top_unique
  rw [← KaehlerDifferential.span_range_derivation C K]
  exact Submodule.span_le.mpr fun _ hω => by
    obtain ⟨x, rfl⟩ := hω
    exact hall x

/-- Differentials of a differential generating set generate relative Kähler differentials over the
upper-field Ore ring, with no constant-base hypothesis. -/
theorem relative_span_diffOp_D_eq_top {S : Set K} (hS : differentialAdjoin C S = ⊤) :
    letI : Module (DiffOp K) Ω[K⁄C] := relativeKaehlerDiffOpModule
    Submodule.span (DiffOp K) (KaehlerDifferential.D C K '' S) = ⊤ := by
  letI : Module (DiffOp K) Ω[K⁄C] := relativeKaehlerDiffOpModule
  letI : IsScalarTower K (DiffOp K) Ω[K⁄C] :=
    ⟨fun a p ω => by
      change connectionDiffOpSMul relativeKaehlerConnection (a • p) ω =
        a • connectionDiffOpSMul relativeKaehlerConnection p ω
      exact connectionDiffOpSMul_smul relativeKaehlerConnection a p ω⟩
  set N : Submodule (DiffOp K) Ω[K⁄C] :=
    Submodule.span (DiffOp K) (KaehlerDifferential.D C K '' S) with hN
  have hres : Submodule.restrictScalars K N = ⊤ := by
    refine relativeKaehler_eq_top_of_connection_stable
      (Submodule.restrictScalars K N) ?_ hS ?_
    · intro ω hω
      have hmem : (DiffOp.mono 1 1 : DiffOp K) • ω ∈ N := N.smul_mem _ hω
      change connectionDiffOpSMul relativeKaehlerConnection (DiffOp.mono 1 1) ω ∈ N at hmem
      rw [connectionDiffOpSMul_mono, one_smul] at hmem
      exact hmem
    · intro s hs
      exact Submodule.subset_span ⟨s, hs, rfl⟩
  rwa [Submodule.restrictScalars_eq_top_iff] at hres

end

end GaloisForLFunctions.HTGeometry
