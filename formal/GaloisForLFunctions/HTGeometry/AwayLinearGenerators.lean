import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization

/-!
# Charts of a graded ring generated in degree one

Let `B = ⊕ 𝒜_n` be generated over `𝒜_0` by finitely many elements `u_i` of degree one, and let `f`
be homogeneous of degree one.  Then the degree-zero part `B_{(f)}` of `B[f⁻¹]` is generated over
`𝒜_0` by the fractions `u_i / f`.  (Mathlib's `Away.adjoin_mk_prod_pow_eq_top` gives the monomials
`∏ u_i^{a_i} / f^{∑ a_i}`, which are products of the `u_i / f`.)

* `HTGeometry.away_mk_prod_pow` : `∏ u_i^{a_i} / f^{∑ a_i} = ∏ (u_i / f)^{a_i}`.
* `HTGeometry.away_adjoin_linear_eq_top`.
-/

namespace HTGeometry

open HomogeneousLocalization

variable {σ : Type*} {B : Type*} [CommRing B] [SetLike σ B] [AddSubgroupClass σ B]
  {𝒜 : ℕ → σ} [GradedRing 𝒜] {f : B} (hf : f ∈ 𝒜 1)

/-- The fraction `u / f` of a degree-one element. -/
noncomputable def linFrac {u : B} (hu : u ∈ 𝒜 1) : Away 𝒜 f :=
  Away.mk 𝒜 hf 1 u (by simpa using hu)

theorem val_linFrac {u : B} (hu : u ∈ 𝒜 1) :
    (linFrac hf hu).val = Localization.mk u ⟨f, Submonoid.mem_powers f⟩ := by
  rw [linFrac, Away.val_mk]
  congr 1
  exact Subtype.ext (pow_one f)

theorem val_fromZeroRingHom (x : 𝒜 0) :
    (fromZeroRingHom 𝒜 (Submonoid.powers f) x).val = algebraMap B (Localization.Away f) x := by
  change Localization.mk (x : B) 1 = _
  exact Localization.mk_one_eq_algebraMap _

theorem linFrac_add {u v : B} (hu : u ∈ 𝒜 1) (hv : v ∈ 𝒜 1) :
    linFrac hf (add_mem hu hv) = linFrac hf hu + linFrac hf hv := by
  apply val_injective
  rw [val_add, val_linFrac, val_linFrac, val_linFrac, Localization.add_mk_self]

theorem linFrac_neg {u : B} (hu : u ∈ 𝒜 1) : linFrac hf (neg_mem hu) = -linFrac hf hu := by
  apply val_injective
  rw [val_neg, val_linFrac, val_linFrac, Localization.neg_mk]

theorem linFrac_zero : linFrac hf (zero_mem (𝒜 1)) = 0 := by
  apply val_injective
  rw [val_linFrac, val_zero, Localization.mk_zero]

theorem linFrac_sum {ι' : Type*} (s : Finset ι') (u : ι' → B) (hu : ∀ i, u i ∈ 𝒜 1) :
    linFrac hf (sum_mem fun i _ => hu i : ∑ i ∈ s, u i ∈ 𝒜 1) = ∑ i ∈ s, linFrac hf (hu i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using linFrac_zero hf
  | insert a s ha ih =>
    simp only [Finset.sum_insert ha]
    rw [linFrac_add hf (hu a) (sum_mem fun i _ => hu i), ih]

theorem linFrac_congr {u v : B} (hu : u ∈ 𝒜 1) (h : u = v) :
    linFrac hf hu = linFrac hf (h ▸ hu) := by
  subst h
  rfl

theorem linFrac_self : linFrac hf hf = 1 := by
  apply val_injective
  rw [val_linFrac, val_one]
  exact Localization.mk_self ⟨f, Submonoid.mem_powers f⟩

theorem linFrac_of_eq {u : B} (hu : u ∈ 𝒜 1) (h : u = f) : linFrac hf hu = 1 := by
  subst h
  exact linFrac_self hf

/-- **A linear form times a degree-zero element.** -/
theorem linFrac_mul_zero {u w : B} (hu : u ∈ 𝒜 1) (hw : w ∈ 𝒜 0) (huw : u * w ∈ 𝒜 1) :
    linFrac hf huw = linFrac hf hu * fromZeroRingHom 𝒜 (Submonoid.powers f) ⟨w, hw⟩ := by
  apply val_injective
  rw [val_mul, val_linFrac, val_linFrac, val_fromZeroRingHom, ← Localization.mk_one_eq_algebraMap,
    Localization.mk_mul, mul_one]

/-- **Monomial fractions are products of linear fractions.** -/
theorem away_mk_prod_pow {ι' : Type*} [Fintype ι'] (u : ι' → B) (hu : ∀ i, u i ∈ 𝒜 1)
    (a : ℕ) (ai : ι' → ℕ) (hai : ∑ i, ai i • (1 : ℕ) = a • 1)
    (hmem : (∏ i, u i ^ ai i) ∈ 𝒜 (a • 1)) :
    Away.mk 𝒜 hf a (∏ i, u i ^ ai i) hmem = ∏ i, linFrac hf (hu i) ^ ai i := by
  apply val_injective
  have hR : (∏ i, linFrac hf (hu i) ^ ai i).val
      = ∏ i, Localization.mk (u i) ⟨f, Submonoid.mem_powers f⟩ ^ ai i := by
    change algebraMap (Away 𝒜 f) (Localization.Away f) _ = _
    rw [map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [map_pow]
    exact congrArg (· ^ ai i) (val_linFrac hf (hu i))
  rw [hR, Away.val_mk]
  simp only [Localization.mk_pow]
  rw [Localization.mk_prod]
  congr 1
  apply Subtype.ext
  simp only [smul_eq_mul, mul_one] at hai
  simp only [SubmonoidClass.coe_finsetProd, SubmonoidClass.mk_pow, Finset.prod_pow_eq_pow_sum, hai]

/-- **The chart is generated by the linear fractions.** -/
theorem away_adjoin_linear_eq_top {ι' : Type*} [Fintype ι'] (u : ι' → B) (hu : ∀ i, u i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range u) = ⊤) :
    Algebra.adjoin (𝒜 0) (Set.range fun i => linFrac hf (hu i)) = ⊤ := by
  rw [eq_top_iff, ← Away.adjoin_mk_prod_pow_eq_top hf ι' u hgen (fun _ => 1) hu,
    Algebra.adjoin_le_iff]
  rintro _ ⟨a, ai, hai, -, rfl⟩
  rw [away_mk_prod_pow hf u hu a ai hai]
  exact Subalgebra.prod_mem _ fun i _ => Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_range_self (f := fun i => linFrac hf (hu i)) i)) _

end HTGeometry
