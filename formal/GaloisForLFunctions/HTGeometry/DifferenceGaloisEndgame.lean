import GaloisForLFunctions.HTGeometry.DifferenceGaloisIrreducibility
import GaloisForLFunctions.HTGeometry.DifferentialCassidyClassification

/-!
# The Galois matrices of a rigid difference equation are constant after one conjugation

For a second-order difference equation whose Riccati equation has no solution over the base, the
Galois action leaves no line stable, so the monoid generated by the Galois matrices acts irreducibly
and — by Burnside — spans the matrix algebra.  If its scalar stabiliser is cut out by a linear
differential equation, the classification of matrix groups over the constants applies, and one
conjugation puts every Galois matrix over the differential constants.

The Galois correspondence comes from the same separation statement: an element fixed by every Galois
automorphism satisfies `x ⊗ 1 = 1 ⊗ x` in the tensor square, hence lies in the base field.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped TensorProduct Differential
open GaloisForLFunctions

variable {K R C : Type*} [Field K] [CommRing R] [Nontrivial R] [Algebra K R]
  [Field C] [IsAlgClosed C] [CharZero C] [Differential C]
  [Algebra C K] [Algebra C R] [IsScalarTower C K R]

/-- The Galois matrices of a difference system, and their multiplicative closure. -/
def galoisMonoid (E : Subalgebra C (R ⊗[K] R)) (Z : Matrix (Fin 2) (Fin 2) (R ⊗[K] R))
    (hZE : ∀ i j, Z i j ∈ E) (S : Set (E →ₐ[C] C)) : Set (Matrix (Fin 2) (Fin 2) C) :=
  (Submonoid.closure {g : Matrix (Fin 2) (Fin 2) C |
    ∃ χ ∈ S, galoisMatrixAt E Z hZE χ = g} : Submonoid (Matrix (Fin 2) (Fin 2) C))

omit [Nontrivial R] [IsAlgClosed C] [CharZero C] [Differential C] in
theorem galoisMatrixAt_mem_galoisMonoid (E : Subalgebra C (R ⊗[K] R))
    (Z : Matrix (Fin 2) (Fin 2) (R ⊗[K] R)) (hZE : ∀ i j, Z i j ∈ E) (S : Set (E →ₐ[C] C))
    {χ : E →ₐ[C] C} (hχ : χ ∈ S) :
    galoisMatrixAt E Z hZE χ ∈ galoisMonoid E Z hZE S :=
  Submonoid.subset_closure ⟨χ, hχ, rfl⟩

/-- **The Galois matrices become constant after one conjugation.**  For a second-order difference
equation without a Riccati solution over the base, whose Galois monoid has a differentially
constrained scalar stabiliser, a single conjugation puts every Galois matrix over the differential
constants. -/
theorem constant_conjugate_galoisMonoid_of_no_riccati
    [IsAlgClosed (differentialConstants C)]
    (E : Subalgebra C (R ⊗[K] R))
    {ι : Type*} (b : Module.Basis ι C E)
    (hgen : Algebra.adjoin C
      (Set.range (algebraMap R (R ⊗[K] R)) ∪ (E : Set (R ⊗[K] R))) = ⊤)
    (hindep : LinearIndependent R (fun i => ((b i : E) : R ⊗[K] R)))
    (S : Set (E →ₐ[C] C)) (hsep : ∀ e : E, (∀ χ ∈ S, χ e = 0) → e = 0)
    {σK : K ≃+* K} {σR : R ≃+* R}
    (hcompat : ∀ a : K, σR (algebraMap K R a) = algebraMap K R (σK a))
    (hconst : ∀ c : C, σR (algebraMap C R c) = algebraMap C R c)
    (hsimple : IsSigmaSimple σR)
    {a₁ a₀ : K} (hric : ∀ r : K, σK r * r ≠ a₁ * r + a₀)
    (Y : Matrix (Fin 2) (Fin 2) R) (hYdet : IsUnit Y.det)
    (hY1 : ∀ j, Y 1 j = σR (Y 0 j))
    (hYrec : ∀ j, σR (Y 1 j) = algebraMap K R a₁ * Y 1 j + algebraMap K R a₀ * Y 0 j)
    (Z : Matrix (Fin 2) (Fin 2) (R ⊗[K] R)) (hZE : ∀ i j, Z i j ∈ E)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y)
    {n : ℕ} (a : Fin n → C)
    (hsol : ∀ x : C, x • (1 : Matrix (Fin 2) (Fin 2) C) ∈
        Submodule.span (differentialConstants C) (galoisMonoid E Z hZE S) →
      differentialJet n x = ∑ i, a i * differentialJet (i : ℕ) x) :
    ∃ P Q : Matrix (Fin 2) (Fin 2) C, P * Q = 1 ∧ Q * P = 1 ∧
      ∀ g ∈ galoisMonoid E Z hZE S, ∀ i j, (P * g * Q) i j ∈ differentialConstants C := by
  have hone : (1 : Matrix (Fin 2) (Fin 2) C) ∈ galoisMonoid E Z hZE S :=
    (Submonoid.closure _).one_mem
  have hmulG : ∀ g ∈ galoisMonoid E Z hZE S, ∀ h ∈ galoisMonoid E Z hZE S,
      g * h ∈ galoisMonoid E Z hZE S := fun g hg h hh => (Submonoid.closure _).mul_mem hg hh
  have hns : ∀ c : Fin 2 → C, c ≠ 0 →
      ¬ ∀ g ∈ galoisMonoid E Z hZE S, ∃ lam : C, g.mulVec c = lam • c := by
    intro c hc hall
    refine not_semiInvariant_coordinate_of_no_riccati E b S hsep hgen hindep hcompat hconst
      hsimple hric Y hYdet hY1 hYrec Z hZE hZ c hc ?_
    intro χ hχ
    exact hall _ (galoisMatrixAt_mem_galoisMonoid E Z hZE S hχ)
  have hirr : ∀ v : Fin 2 → C, v ≠ 0 → ∀ u : Fin 2 → C,
      u ∈ Submodule.span C {x : Fin 2 → C | ∃ g ∈ galoisMonoid E Z hZE S, g.mulVec v = x} :=
    fun v hv u => span_orbit_eq_top_of_no_semiInvariant hone hns v hv u
  exact constant_conjugate_of_irreducible (galoisMonoid E Z hZE S) hone hmulG hirr a hsol

omit [IsAlgClosed C] [CharZero C] [Differential C] in
/-- **The Galois correspondence.**  An element of the Picard--Vessiot ring fixed by every Galois
automorphism lies in the base field. -/
theorem exists_eq_algebraMap_of_forall_galoisAutAt
    (E : Subalgebra C (R ⊗[K] R))
    {ι : Type*} (b : Module.Basis ι C E)
    (hgen : Algebra.adjoin C
      (Set.range (algebraMap R (R ⊗[K] R)) ∪ (E : Set (R ⊗[K] R))) = ⊤)
    (hindep : LinearIndependent R (fun i => ((b i : E) : R ⊗[K] R)))
    (S : Set (E →ₐ[C] C)) (hsep : ∀ e : E, (∀ χ ∈ S, χ e = 0) → e = 0)
    {x : R} (hx : ∀ χ ∈ S, galoisAutAt E b hgen hindep χ x = x) :
    ∃ c : K, x = algebraMap K R c := by
  have hzero : x ⊗ₜ[K] (1 : R) - (1 : R) ⊗ₜ[K] x = 0 := by
    refine eq_zero_of_forall_torsorSpecialization_subset_eq_zero E b hgen hindep S hsep ?_
    intro χ hχ
    rw [map_sub]
    have hleft : torsorSpecialization E b hgen hindep χ (x ⊗ₜ[K] (1 : R)) = x :=
      (torsorSpecialization E b hgen hindep χ).commutes x
    have hright : torsorSpecialization E b hgen hindep χ ((1 : R) ⊗ₜ[K] x) = x := by
      rw [← galoisAutAt_apply E b hgen hindep χ x]
      exact hx χ hχ
    rw [hleft, hright, sub_self]
  exact exists_eq_algebraMap_of_tmul_comm (sub_eq_zero.mp hzero)

end

end GaloisForLFunctions.HTGeometry
