import GaloisForLFunctions.HTGeometry.TranscendentalEntireOrderOne

/-!
# A first-order equation genuinely involves the derivative

For a transcendental entire solution, the equation `P(z, f, f') = 0` cannot be free of `f'`: dropping
that variable would leave an order-zero equation, which no transcendental entire function satisfies.
Reading `P` as a polynomial in `f'` therefore gives a relation of degree at least one with a nonzero
top coefficient.

This is the nondegeneracy that makes `f'` algebraic over the field generated by `z` and `f` — the
input to every transcendence-degree bound along a cascade.

The reading is `MvPolynomial.finSuccEquiv` after moving the derivative variable to the head.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

open MvPolynomial

/-- The renaming that moves the derivative variable of a first-order equation to the head. -/
def derivHead : Fin 3 → Fin 3 := ![1, 2, 0]

theorem derivHead_injective : Function.Injective derivHead := by decide

/-- **A first-order equation, read in the derivative.**  A transcendental entire solution of a
first-order algebraic differential equation satisfies a relation

`∑_{c ≤ e} B_c(z, f) (f')^c = 0`

of degree `e ≥ 1` in the derivative, with `B_e` a nonzero two-variable polynomial. -/
theorem exists_deriv_top_relation_of_order_one {f : ℂ → ℂ}
    (hf : TranscendentalEntire f) (h : DifferentiallyAlgebraicOfOrder f 1) :
    ∃ (e : ℕ) (B : ℕ → MvPolynomial (Fin 2) ℂ), 1 ≤ e ∧ B e ≠ 0 ∧
      ∀ z : ℂ, ∑ c ∈ Finset.range (e + 1),
        MvPolynomial.eval ![z, f z] (B c) * (deriv f z) ^ c = 0 := by
  obtain ⟨P, hP0, hPz⟩ := h
  set Q : MvPolynomial (Fin 3) ℂ := rename derivHead P with hQ
  have hQ0 : Q ≠ 0 := by
    rw [hQ]
    intro hc
    exact hP0 (rename_injective derivHead derivHead_injective (by rw [hc, map_zero]))
  set p : Polynomial (MvPolynomial (Fin 2) ℂ) := finSuccEquiv ℂ 2 Q with hp
  have hp0 : p ≠ 0 := by
    rw [hp]
    intro hc
    exact hQ0 ((finSuccEquiv ℂ 2).injective (by rw [hc, map_zero]))
  set e : ℕ := p.natDegree with he
  have hBe : p.coeff e ≠ 0 := by
    rw [he]
    exact Polynomial.leadingCoeff_ne_zero.mpr hp0
  have hrel : ∀ z : ℂ, ∑ c ∈ Finset.range (e + 1),
      MvPolynomial.eval ![z, f z] (p.coeff c) * (deriv f z) ^ c = 0 := by
    intro z
    have hvec : (Fin.cons z fun j : Fin 2 => iteratedDeriv (j : ℕ) f z)
        = fun i : Fin 3 => ![z, f z, deriv f z] i := by
      funext j
      refine Fin.cases ?_ (fun i => ?_) j
      · simp
      · rw [Fin.cons_succ]
        fin_cases i <;> simp [iteratedDeriv_zero, iteratedDeriv_one]
    have hbase := hPz z
    rw [hvec] at hbase
    have hshift : (Fin.cons (deriv f z) ![z, f z] : Fin 3 → ℂ) ∘ derivHead
        = fun i : Fin 3 => ![z, f z, deriv f z] i := by
      funext i
      fin_cases i <;> rfl
    have hQeval : MvPolynomial.eval (Fin.cons (deriv f z) ![z, f z]) Q = 0 := by
      rw [hQ, eval_rename, hshift]
      exact hbase
    have hev := MvPolynomial.eval_eq_eval_mv_eval' (R := ℂ) (n := 2) ![z, f z] (deriv f z) Q
    rw [← hp, hQeval] at hev
    have hdeg : (Polynomial.map (MvPolynomial.eval ![z, f z]) p).natDegree < e + 1 :=
      Nat.lt_succ_of_le (le_trans Polynomial.natDegree_map_le (le_of_eq he.symm))
    rw [Polynomial.eval_eq_sum_range' hdeg] at hev
    rw [← hev.symm]
    refine Finset.sum_congr rfl ?_
    intro c _
    rw [Polynomial.coeff_map]
  rcases Nat.eq_zero_or_pos e with he0 | he1
  · exfalso
    refine not_differentiallyAlgebraicOfOrder_zero_of_transcendental hf.1 hf.2 ⟨p.coeff 0, ?_, ?_⟩
    · rw [he0] at hBe
      exact hBe
    · intro z
      have hr := hrel z
      rw [he0] at hr
      simp only [zero_add, Finset.sum_range_one, pow_zero, mul_one] at hr
      have hvec : (Fin.cons z fun j : Fin 1 => iteratedDeriv (j : ℕ) f z) = ![z, f z] := by
        funext j
        refine Fin.cases ?_ (fun i => ?_) j
        · simp
        · rw [Fin.cons_succ]
          fin_cases i
          simp [iteratedDeriv_zero]
      rw [hvec]
      exact hr
  · exact ⟨e, fun c => p.coeff c, he1, hBe, hrel⟩

end GaloisForLFunctions.HTGeometry
