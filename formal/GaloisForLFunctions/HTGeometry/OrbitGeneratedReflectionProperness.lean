import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.InnerProductSpace.LinearMap
import Mathlib.Analysis.Normed.Lp.lpSpace
import Mathlib.Analysis.InnerProductSpace.l2Space

/-!
# Source-conjugate reflection orbits

One orthogonal projection conjugated by a unitary source evolution generates a whole atlas of
reversals.  Their joint defect energy is four times the orbit projection energy, their common odd
sector is the orthogonal complement of the generated orbit, and on a wandering orbit the joint
Gramian is exactly `4·I`.  In the finite cyclic model the reversal observer is periodic while the
accumulated lifted action grows by `4‖x‖²` per cycle, so bounded lifted action selects zero.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped InnerProductSpace

noncomputable section

/-! ## The generated reversal atlas -/

variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

theorem isometryZpow_add_one_apply {G : Type*} [NormedAddCommGroup G] [InnerProductSpace 𝕜 G]
    (V : G ≃ₗᵢ[𝕜] G) (k : ℤ) (z : G) : (V ^ (k + 1)) z = V ((V ^ k) z) := by
  rw [zpow_add_one V k, ← ((Commute.refl V).zpow_right k).eq]
  rfl

theorem isometryZpow_sub_one_apply {G : Type*} [NormedAddCommGroup G] [InnerProductSpace 𝕜 G]
    (V : G ≃ₗᵢ[𝕜] G) (k : ℤ) (z : G) : (V ^ (k - 1)) z = V.symm ((V ^ k) z) := by
  have hmul : (V ^ (k - 1)) = V.symm * (V ^ k) := by
    rw [show (V.symm : G ≃ₗᵢ[𝕜] G) = V⁻¹ from rfl, ← zpow_neg_one V, ← zpow_add V (-1) k]
    congr 1
    ring
  rw [hmul]
  rfl

theorem zpow_apply_zpow_neg (U : H ≃ₗᵢ[𝕜] H) (k : ℤ) (z : H) : (U ^ (-k)) ((U ^ k) z) = z := by
  have hmul : (U ^ (-k)) * (U ^ k) = 1 := by
    rw [← zpow_add]
    simp
  calc (U ^ (-k)) ((U ^ k) z) = ((U ^ (-k)) * (U ^ k)) z := rfl
    _ = z := by rw [hmul]; rfl

theorem zpow_neg_apply_zpow (U : H ≃ₗᵢ[𝕜] H) (k : ℤ) (z : H) : (U ^ k) ((U ^ (-k)) z) = z := by
  have hmul : (U ^ k) * (U ^ (-k)) = 1 := by
    rw [← zpow_add]
    simp
  calc (U ^ k) ((U ^ (-k)) z) = ((U ^ k) * (U ^ (-k))) z := rfl
    _ = z := by rw [hmul]; rfl

/-- The projection conjugated to orbit index `k` by the source evolution. -/
def orbitProjection (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) : H →ₗ[𝕜] H :=
  ((U ^ k).toLinearEquiv.toLinearMap).comp (P.comp ((U ^ (-k)).toLinearEquiv.toLinearMap))

@[simp] theorem orbitProjection_apply (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) (x : H) :
    orbitProjection U P k x = (U ^ k) (P ((U ^ (-k)) x)) := rfl

/-- The generated reversal at orbit index `k`. -/
def orbitReversal (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) : H →ₗ[𝕜] H :=
  (2 : 𝕜) • orbitProjection U P k - LinearMap.id

@[simp] theorem orbitReversal_apply (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) (x : H) :
    orbitReversal U P k x = (2 : 𝕜) • orbitProjection U P k x - x := rfl

/-- The reversal defect at orbit index `k`. -/
def orbitDefect (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) : H →ₗ[𝕜] H :=
  LinearMap.id + orbitReversal U P k

@[simp] theorem orbitDefect_apply (U : H ≃ₗᵢ[𝕜] H) (P : H →ₗ[𝕜] H) (k : ℤ) (x : H) :
    orbitDefect U P k x = x + orbitReversal U P k x := rfl

variable {U : H ≃ₗᵢ[𝕜] H} {P : H →ₗ[𝕜] H}

/-- **The conjugated projection is idempotent.** -/
theorem orbitProjection_idem (hPP : ∀ y, P (P y) = P y) (k : ℤ) (x : H) :
    orbitProjection U P k (orbitProjection U P k x) = orbitProjection U P k x := by
  simp only [orbitProjection_apply, zpow_apply_zpow_neg, hPP]

/-- **The conjugated projection is self-adjoint.** -/
theorem orbitProjection_selfAdjoint (hPsa : ∀ y z, ⟪P y, z⟫_𝕜 = ⟪y, P z⟫_𝕜) (k : ℤ) (x y : H) :
    ⟪orbitProjection U P k x, y⟫_𝕜 = ⟪x, orbitProjection U P k y⟫_𝕜 := by
  simp only [orbitProjection_apply]
  rw [← LinearIsometryEquiv.inner_map_map (U ^ (-k)) ((U ^ k) (P ((U ^ (-k)) x))) y,
    zpow_apply_zpow_neg, hPsa,
    ← LinearIsometryEquiv.inner_map_map (U ^ k) ((U ^ (-k)) x) (P ((U ^ (-k)) y)),
    zpow_neg_apply_zpow]

/-- **The generated reversal is an involution.** -/
theorem orbitReversal_involutive (hPP : ∀ y, P (P y) = P y) (k : ℤ) (x : H) :
    orbitReversal U P k (orbitReversal U P k x) = x := by
  have hidem := orbitProjection_idem (U := U) (P := P) hPP k x
  simp only [orbitReversal_apply, map_sub, map_smul, hidem]
  module

/-- **The reversal atlas is generated by conjugation.** -/
theorem orbitReversal_succ (k : ℤ) (x : H) :
    orbitReversal U P (k + 1) (U x) = U (orbitReversal U P k x) := by
  have hstep : ∀ z : H, (U ^ (-(k + 1))) (U z) = (U ^ (-k)) z := by
    intro z
    have hmul : (U ^ (-(k + 1))) * U = U ^ (-k) := by
      rw [← zpow_add_one U (-(k + 1))]
      congr 1
      ring
    calc (U ^ (-(k + 1))) (U z) = ((U ^ (-(k + 1))) * U) z := rfl
      _ = (U ^ (-k)) z := by rw [hmul]
  have hstep2 : ∀ z : H, (U ^ (k + 1)) z = U ((U ^ k) z) := isometryZpow_add_one_apply U k
  simp only [orbitReversal_apply, orbitProjection_apply, hstep, hstep2, map_sub, map_smul]

/-- **The defect is twice the conjugated projection.** -/
theorem orbitDefect_eq (k : ℤ) (x : H) :
    orbitDefect U P k x = (2 : 𝕜) • orbitProjection U P k x := by
  simp only [orbitDefect_apply, orbitReversal_apply]
  module

/-- **Exact defect energy.**  The reversal defect at orbit index `k` has four times the energy of
the source projection read at the shifted time. -/
theorem norm_orbitDefect_sq (k : ℤ) (x : H) :
    ‖orbitDefect U P k x‖ ^ 2 = 4 * ‖P ((U ^ (-k)) x)‖ ^ 2 := by
  rw [orbitDefect_eq, orbitProjection_apply, norm_smul, LinearIsometryEquiv.norm_map, mul_pow]
  norm_num

theorem norm_orbitProjection (k : ℤ) (x : H) :
    ‖orbitProjection U P k x‖ = ‖P ((U ^ (-k)) x)‖ := by
  rw [orbitProjection_apply, LinearIsometryEquiv.norm_map]

/-- **Joint defect energy.**  The defect Gramian is four times the orbit projection Gramian. -/
theorem norm_orbitDefect_sq_eq_four_mul (k : ℤ) (x : H) :
    ‖orbitDefect U P k x‖ ^ 2 = 4 * ‖orbitProjection U P k x‖ ^ 2 := by
  rw [norm_orbitDefect_sq, norm_orbitProjection]

/-- **Finite orbit defect energy** (card `(ORT.3)`). -/
theorem sum_norm_orbitDefect_sq {ι : Type*} (F : Finset ι) (f : ι → ℤ) (x : H) :
    ∑ i ∈ F, ‖orbitDefect U P (f i) x‖ ^ 2
      = 4 * ∑ i ∈ F, ‖P ((U ^ (-(f i))) x)‖ ^ 2 := by
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => norm_orbitDefect_sq (f i) x

/-- **Wandering-sector global properness** (card `(ORT.7)`).  On a Parseval orbit the joint
reversal Gramian is exactly `4·I`. -/
theorem hasSum_orbitDefect_of_parseval {ι : Type*} {g : ι → ℤ} {x : H}
    (h : HasSum (fun i : ι => ‖orbitProjection U P (g i) x‖ ^ 2) (‖x‖ ^ 2)) :
    HasSum (fun i : ι => ‖orbitDefect U P (g i) x‖ ^ 2) (4 * ‖x‖ ^ 2) := by
  refine (h.mul_left 4).congr_fun fun i => ?_
  rw [norm_orbitDefect_sq_eq_four_mul]

/-- **Common odd sector** (card `(ORT.4)`).  A vector is killed by every generated defect exactly
when it is orthogonal to the whole generated orbit of the source range. -/
theorem forall_orbitDefect_eq_zero_iff (hPP : ∀ y, P (P y) = P y)
    (hPsa : ∀ y z, ⟪P y, z⟫_𝕜 = ⟪y, P z⟫_𝕜) (x : H) :
    (∀ k : ℤ, orbitDefect U P k x = 0) ↔ ∀ (k : ℤ) (y : H), ⟪(U ^ k) (P y), x⟫_𝕜 = 0 := by
  have hker : ∀ z : H, P z = 0 ↔ ∀ y : H, ⟪P y, z⟫_𝕜 = 0 := by
    intro z
    constructor
    · intro hz y
      rw [hPsa, hz, inner_zero_right]
    · intro hz
      have h1 := hz z
      rw [hPsa] at h1
      have h2 : ⟪P z, P z⟫_𝕜 = 0 := by
        rw [hPsa, hPP]
        exact h1
      simpa using inner_self_eq_zero.1 h2
  constructor
  · intro h k y
    have hz : P ((U ^ (-k)) x) = 0 := by
      have hd := h k
      rw [orbitDefect_eq] at hd
      simp only [orbitProjection_apply] at hd
      have h2 : (2 : 𝕜) • (U ^ k) (P ((U ^ (-k)) x)) = 0 := hd
      have h3 : (U ^ k) (P ((U ^ (-k)) x)) = 0 := by
        have := smul_eq_zero.1 h2
        rcases this with hc | hv
        · exact absurd hc (two_ne_zero)
        · exact hv
      have := congrArg (U ^ (-k)) h3
      rwa [zpow_apply_zpow_neg, map_zero] at this
    have := (hker ((U ^ (-k)) x)).1 hz y
    rw [← LinearIsometryEquiv.inner_map_map (U ^ k) (P y) ((U ^ (-k)) x), zpow_neg_apply_zpow] at this
    exact this
  · intro h k
    have hz : ∀ y : H, ⟪P y, (U ^ (-k)) x⟫_𝕜 = 0 := by
      intro y
      have := h k y
      rw [← LinearIsometryEquiv.inner_map_map (U ^ k) (P y) ((U ^ (-k)) x), zpow_neg_apply_zpow]
      exact this
    have hP0 := (hker ((U ^ (-k)) x)).2 hz
    rw [orbitDefect_eq]
    simp only [orbitProjection_apply, hP0, map_zero, smul_zero]

/-! ## Common isometric recovery -/

theorem map_zpow_of_intertwine {K : Type*} [NormedAddCommGroup K] [InnerProductSpace 𝕜 K]
    (L : H →ₗᵢ[𝕜] K) (Ut : K ≃ₗᵢ[𝕜] K) (hLU : ∀ x, L (U x) = Ut (L x)) (k : ℤ) (x : H) :
    L ((U ^ k) x) = (Ut ^ k) (L x) := by
  have hinv : ∀ y : H, L ((U.symm) y) = (Ut.symm) (L y) := by
    intro y
    have := hLU (U.symm y)
    rw [LinearIsometryEquiv.apply_symm_apply] at this
    rw [this, LinearIsometryEquiv.symm_apply_apply]
  induction k using Int.induction_on with
  | zero => simp
  | succ j ih =>
      rw [isometryZpow_add_one_apply U (j : ℤ), isometryZpow_add_one_apply Ut (j : ℤ), hLU, ih]
  | pred j ih =>
      rw [isometryZpow_sub_one_apply U (-(j : ℤ)), isometryZpow_sub_one_apply Ut (-(j : ℤ)),
        hinv, ih]

/-- **Common recovery is neutral** (card `(ORT.16)`).  A common isometric recovery intertwines the
generated defects and preserves their energy. -/
theorem orbitDefect_intertwine {K : Type*} [NormedAddCommGroup K] [InnerProductSpace 𝕜 K]
    (L : H →ₗᵢ[𝕜] K) (Ut : K ≃ₗᵢ[𝕜] K) (Pt : K →ₗ[𝕜] K)
    (hLU : ∀ x, L (U x) = Ut (L x)) (hLP : ∀ x, L (P x) = Pt (L x)) (k : ℤ) (x : H) :
    L (orbitDefect U P k x) = orbitDefect Ut Pt k (L x) := by
  simp only [orbitDefect_apply, orbitReversal_apply, orbitProjection_apply, map_add, map_sub,
    map_smul]
  rw [map_zpow_of_intertwine L Ut hLU, hLP, map_zpow_of_intertwine L Ut hLU]

theorem norm_orbitDefect_intertwine {K : Type*} [NormedAddCommGroup K] [InnerProductSpace 𝕜 K]
    (L : H →ₗᵢ[𝕜] K) (Ut : K ≃ₗᵢ[𝕜] K) (Pt : K →ₗ[𝕜] K)
    (hLU : ∀ x, L (U x) = Ut (L x)) (hLP : ∀ x, L (P x) = Pt (L x)) (k : ℤ) (x : H) :
    ‖orbitDefect Ut Pt k (L x)‖ = ‖orbitDefect U P k x‖ := by
  rw [← orbitDefect_intertwine L Ut Pt hLU hLP, LinearIsometry.norm_map]

end

/-! ## The exact finite cyclic model -/

section Cyclic

variable {𝕜 : Type*} [RCLike 𝕜] {N : ℕ}

/-- The coordinate reversal fixing the `k`-th slot. -/
def cyclicReversal (k : Fin N) (x : Fin N → 𝕜) : Fin N → 𝕜 :=
  fun j => if j = k then x j else -x j

theorem cyclicReversal_involutive (k : Fin N) (x : Fin N → 𝕜) :
    cyclicReversal k (cyclicReversal k x) = x := by
  funext j
  by_cases h : j = k <;> simp [cyclicReversal, h]

theorem cyclicDefect_apply (k : Fin N) (x : Fin N → 𝕜) (j : Fin N) :
    x j + cyclicReversal k x j = if j = k then 2 * x j else 0 := by
  by_cases h : j = k
  · simp [cyclicReversal, h]
    ring
  · simp [cyclicReversal, h]

theorem sum_norm_cyclicDefect (k : Fin N) (x : Fin N → 𝕜) :
    ∑ j : Fin N, ‖x j + cyclicReversal k x j‖ ^ 2 = 4 * ‖x k‖ ^ 2 := by
  have hterm : ∀ j : Fin N, ‖x j + cyclicReversal k x j‖ ^ 2
      = if j = k then 4 * ‖x j‖ ^ 2 else 0 := by
    intro j
    rw [cyclicDefect_apply]
    by_cases h : j = k
    · rw [if_pos h, if_pos h, norm_mul, mul_pow]
      norm_num
    · rw [if_neg h, if_neg h, norm_zero]
      norm_num
  rw [Finset.sum_congr rfl fun j _ => hterm j, Finset.sum_ite_eq' Finset.univ k]
  simp

/-- **The tight cycle identity** (card `(ORT.10)`). -/
theorem sum_sum_norm_cyclicDefect (x : Fin N → 𝕜) :
    ∑ k : Fin N, ∑ j : Fin N, ‖x j + cyclicReversal k x j‖ ^ 2
      = 4 * ∑ j : Fin N, ‖x j‖ ^ 2 := by
  rw [Finset.sum_congr rfl fun k _ => sum_norm_cyclicDefect k x, ← Finset.mul_sum]

/-- **Joint selection** (card Corollary 4.1). -/
theorem eq_zero_of_forall_cyclicReversal_eq_neg (x : Fin N → 𝕜)
    (h : ∀ k : Fin N, cyclicReversal k x = -x) : x = 0 := by
  funext j
  have hj : (if j = j then x j else -x j) = -x j := congrFun (h j) j
  rw [if_pos rfl] at hj
  have h2 : (2 : 𝕜) * x j = 0 := by linear_combination hj
  simpa using h2

/-- **The reversal observer is periodic** (card `(ORT.11)`). -/
theorem cyclicReversal_periodic [NeZero N] (m : ℕ) (x : Fin N → 𝕜) :
    cyclicReversal (Fin.ofNat N (m + N)) x = cyclicReversal (Fin.ofNat N m) x := by
  congr 1
  apply Fin.ext
  simp

/-- Accumulated lifted action through `q` completed observer cycles. -/
def cyclicAction [NeZero N] (q : ℕ) (x : Fin N → 𝕜) : ℝ :=
  ∑ m ∈ Finset.range (q * N), ∑ j : Fin N, ‖x j + cyclicReversal (Fin.ofNat N m) x j‖ ^ 2

theorem sum_range_mul_ofNat [NeZero N] (q : ℕ) (f : Fin N → ℝ) :
    ∑ m ∈ Finset.range (q * N), f (Fin.ofNat N m) = q * ∑ k : Fin N, f k := by
  have hself : ∀ k : Fin N, Fin.ofNat N (k : ℕ) = k := by
    intro k
    apply Fin.ext
    simp
  have hshift : ∀ p i : ℕ, Fin.ofNat N (p * N + i) = Fin.ofNat N i := by
    intro p i
    apply Fin.ext
    simp
  induction q with
  | zero => simp
  | succ p ih =>
      have hsplit : (p + 1) * N = p * N + N := by ring
      rw [hsplit, Finset.sum_range_add, ih]
      have hblock : ∑ i ∈ Finset.range N, f (Fin.ofNat N (p * N + i)) = ∑ k : Fin N, f k := by
        rw [Finset.sum_congr rfl fun i _ => by rw [hshift p i]]
        rw [Finset.sum_range fun i => f (Fin.ofNat N i)]
        exact Finset.sum_congr rfl fun k _ => by rw [hself k]
      rw [hblock]
      push_cast
      ring

/-- **Lifted-action properness** (card `(ORT.13)`). -/
theorem cyclicAction_eq [NeZero N] (q : ℕ) (x : Fin N → 𝕜) :
    cyclicAction q x = 4 * q * ∑ j : Fin N, ‖x j‖ ^ 2 := by
  rw [cyclicAction,
    Finset.sum_congr rfl fun m _ => sum_norm_cyclicDefect (Fin.ofNat N m) x,
    sum_range_mul_ofNat q (fun k => 4 * ‖x k‖ ^ 2), ← Finset.mul_sum]
  ring

/-- **Bounded lifted action selects the neutral state** (card `(ORT.14)`). -/
theorem bddAbove_cyclicAction_iff [NeZero N] (x : Fin N → 𝕜) :
    (∃ C : ℝ, ∀ q : ℕ, cyclicAction q x ≤ C) ↔ x = 0 := by
  constructor
  · rintro ⟨C, hC⟩
    by_contra hne
    have hpos : 0 < ∑ j : Fin N, ‖x j‖ ^ 2 := by
      obtain ⟨j, hj⟩ := Function.ne_iff.1 hne
      refine Finset.sum_pos' (fun i _ => by positivity) ⟨j, Finset.mem_univ j, ?_⟩
      exact pow_pos (norm_pos_iff.2 hj) 2
    obtain ⟨q, hq⟩ := exists_nat_gt (C / (4 * ∑ j : Fin N, ‖x j‖ ^ 2))
    have hbig := hC q
    rw [cyclicAction_eq] at hbig
    rw [div_lt_iff₀ (by positivity)] at hq
    nlinarith [hbig, hq, hpos]
  · rintro rfl
    exact ⟨0, fun q => by simp [cyclicAction_eq]⟩

end Cyclic

/-! ## The sharp completeness/properness separation -/

section Separation

/-- **Completeness of the difference orbit.**  A square-summable bilateral family with vanishing
successive differences vanishes: the common odd sector of the difference orbit is zero. -/
theorem eq_zero_of_summable_of_forall_sub_succ {x : ℤ → ℝ}
    (hx : Summable fun k : ℤ => ‖x k‖ ^ 2) (h : ∀ k : ℤ, x k - x (k + 1) = 0) :
    ∀ k : ℤ, x k = 0 := by
  have hconst : ∀ k : ℤ, x k = x 0 := by
    intro k
    induction k using Int.induction_on with
    | zero => rfl
    | succ j ih =>
        have := h (j : ℤ)
        rw [ih] at this
        linarith
    | pred j ih =>
        have := h (-(j : ℤ) - 1)
        rw [show -(j : ℤ) - 1 + 1 = -(j : ℤ) from by ring, ih] at this
        linarith
  have hxc : (fun k : ℤ => ‖x k‖ ^ 2) = fun _ : ℤ => ‖x 0‖ ^ 2 := by
    funext k
    rw [hconst k]
  rw [hxc] at hx
  have hzero : ‖x 0‖ ^ 2 = 0 := by
    exact (summable_const_iff _).1 hx
  intro k
  rw [hconst k]
  have := pow_eq_zero_iff (n := 2) (by norm_num) |>.1 hzero
  simpa using this

/-- **No positive lower frame bound.**  For every window length `n ≥ 1` there is a unit bilateral
family whose successive-difference energy is `2/n`.  Completeness is therefore not properness. -/
theorem exists_unit_small_difference_energy (n : ℕ) (hn : 0 < n) :
    ∃ x : ℤ → ℝ, (∑' k : ℤ, ‖x k‖ ^ 2) = 1 ∧ (∑' k : ℤ, ‖x k - x (k + 1)‖ ^ 2) = 2 / n := by
  classical
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  set c : ℝ := 1 / Real.sqrt (n : ℝ) with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    positivity
  have hsq : c ^ 2 = 1 / (n : ℝ) := by
    rw [hc, div_pow, one_pow, Real.sq_sqrt hnR.le]
  set x : ℤ → ℝ := fun k => if 0 ≤ k ∧ k < (n : ℤ) then c else 0 with hx
  refine ⟨x, ?_, ?_⟩
  · have hsupp : ∀ k : ℤ, k ∉ Finset.Ico (0 : ℤ) (n : ℤ) → ‖x k‖ ^ 2 = 0 := by
      intro k hk
      rw [Finset.mem_Ico, not_and_or] at hk
      have : x k = 0 := by
        simp only [hx]
        refine if_neg ?_
        rintro ⟨h1, h2⟩
        rcases hk with h | h
        · exact h h1
        · exact h h2
      rw [this]
      simp
    rw [tsum_eq_sum hsupp]
    have hval : ∀ k ∈ Finset.Ico (0 : ℤ) (n : ℤ), ‖x k‖ ^ 2 = c ^ 2 := by
      intro k hk
      rw [Finset.mem_Ico] at hk
      simp only [hx]
      rw [if_pos ⟨hk.1, hk.2⟩, Real.norm_eq_abs, abs_of_nonneg hcnn]
    rw [Finset.sum_congr rfl hval, Finset.sum_const, Int.card_Ico, hsq]
    simp only [sub_zero, Int.toNat_natCast, nsmul_eq_mul]
    field_simp
  · have hne : (-1 : ℤ) ≠ (n : ℤ) - 1 := by omega
    have hsupp : ∀ k : ℤ, k ∉ ({(-1 : ℤ), (n : ℤ) - 1} : Finset ℤ) →
        ‖x k - x (k + 1)‖ ^ 2 = 0 := by
      intro k hk
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hk
      have hxk : x k = x (k + 1) := by
        simp only [hx]
        by_cases hin : 0 ≤ k ∧ k < (n : ℤ)
        · rw [if_pos hin, if_pos ⟨by omega, by omega⟩]
        · rw [if_neg hin, if_neg ?_]
          rintro ⟨h1, h2⟩
          exact hin ⟨by omega, by omega⟩
      rw [hxk, sub_self]
      simp
    rw [tsum_eq_sum hsupp, Finset.sum_pair hne]
    have hm1 : x (-1) - x (-1 + 1) = -c := by
      simp only [hx]
      rw [if_neg (by omega : ¬((0:ℤ) ≤ -1 ∧ (-1:ℤ) < (n:ℤ))),
        if_pos (show (0:ℤ) ≤ -1 + 1 ∧ (-1 + 1 : ℤ) < (n:ℤ) by omega)]
      ring
    have hn1 : x ((n : ℤ) - 1) - x ((n : ℤ) - 1 + 1) = c := by
      simp only [hx]
      rw [if_pos (show (0:ℤ) ≤ (n:ℤ) - 1 ∧ ((n:ℤ) - 1 : ℤ) < (n:ℤ) by omega),
        if_neg (by omega : ¬((0:ℤ) ≤ (n:ℤ) - 1 + 1 ∧ ((n:ℤ) - 1 + 1 : ℤ) < (n:ℤ)))]
      ring
    rw [hm1, hn1, norm_neg, Real.norm_eq_abs, abs_of_nonneg hcnn, hsq]
    ring

end Separation

end GaloisForLFunctions.HTGeometry
