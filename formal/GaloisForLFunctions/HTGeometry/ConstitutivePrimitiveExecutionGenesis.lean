import GaloisForLFunctions.HTGeometry.ConstitutiveSymbolicExecutionGap
import Mathlib

/-!
# Primitive execution genesis

Failure-kernel admission canonically determines its indecomposable positive laws.  These primitive
laws generate every positive locally admitted law.  A bounded primitive grammar is complete
exactly when primitive degrees are bounded; unbounded primitive degree defeats every bounded
grammar.  The triangle symbolic gap is generated by one degree-two primitive.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

universe u

/-- A positive binary decomposition whose two resource weights fit below the target weight. -/
def WeightedDominatedSplit {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (m : ℕ) (a : α → ℕ) : Prop :=
  ∃ m₁ m₂ : ℕ, ∃ a₁ a₂ : α → ℕ,
    0 < m₁ ∧ 0 < m₂ ∧ m = m₁ + m₂ ∧
      WeightedLocalRepair H m₁ a₁ ∧ WeightedLocalRepair H m₂ a₂ ∧
      ∀ i, a₁ i + a₂ i ≤ a i

/-- A source-canonical primitive is a positive locally admitted law with no dominated positive
split. -/
def WeightedPrimitiveRepair {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (m : ℕ) (a : α → ℕ) : Prop :=
  0 < m ∧ WeightedLocalRepair H m a ∧ ¬ WeightedDominatedSplit H m a

/-- Canonical execution grammar generated by every primitive admitted law. -/
inductive PrimitiveGeneratedRepair {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) : ℕ → (α → ℕ) → Prop where
  | atom {m : ℕ} {a : α → ℕ} :
      WeightedPrimitiveRepair H m a → PrimitiveGeneratedRepair H m a
  | combine {m₁ m₂ : ℕ} {a₁ a₂ a : α → ℕ} :
      PrimitiveGeneratedRepair H m₁ a₁ →
      PrimitiveGeneratedRepair H m₂ a₂ →
      (∀ i, a₁ i + a₂ i ≤ a i) →
      PrimitiveGeneratedRepair H (m₁ + m₂) a

/-- Primitive execution grammar whose admitted atoms have degree at most `D`. -/
inductive BoundedPrimitiveGeneratedRepair {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (D : ℕ) : ℕ → (α → ℕ) → Prop where
  | atom {m : ℕ} {a : α → ℕ} :
      WeightedPrimitiveRepair H m a → m ≤ D →
      BoundedPrimitiveGeneratedRepair H D m a
  | combine {m₁ m₂ : ℕ} {a₁ a₂ a : α → ℕ} :
      BoundedPrimitiveGeneratedRepair H D m₁ a₁ →
      BoundedPrimitiveGeneratedRepair H D m₂ a₂ →
      (∀ i, a₁ i + a₂ i ≤ a i) →
      BoundedPrimitiveGeneratedRepair H D (m₁ + m₂) a

/-- Every primitive admitted law has degree at most `D`. -/
def PrimitiveDegreeBound {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (D : ℕ) : Prop :=
  ∀ m a, WeightedPrimitiveRepair H m a → m ≤ D

/-- Local admission is closed under resource-dominated addition. -/
theorem weightedLocalRepair_add_of_dom {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) {m₁ m₂ : ℕ} {a₁ a₂ a : α → ℕ}
    (h₁ : WeightedLocalRepair H m₁ a₁)
    (h₂ : WeightedLocalRepair H m₂ a₂)
    (hdom : ∀ i, a₁ i + a₂ i ≤ a i) :
    WeightedLocalRepair H (m₁ + m₂) a := by
  intro K hKH
  calc
    m₁ + m₂ ≤ (∑ i ∈ K, a₁ i) + ∑ i ∈ K, a₂ i := Nat.add_le_add (h₁ K hKH) (h₂ K hKH)
    _ = ∑ i ∈ K, (a₁ i + a₂ i) := by rw [Finset.sum_add_distrib]
    _ ≤ ∑ i ∈ K, a i := Finset.sum_le_sum fun i _hi => hdom i

/-- Canonically generated laws remain positive and locally admitted. -/
theorem primitiveGeneratedRepair_positive_local {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) {m : ℕ} {a : α → ℕ}
    (h : PrimitiveGeneratedRepair H m a) :
    0 < m ∧ WeightedLocalRepair H m a := by
  induction h with
  | atom hp => exact ⟨hp.1, hp.2.1⟩
  | combine h₁ h₂ hdom ih₁ ih₂ =>
      exact ⟨by omega, weightedLocalRepair_add_of_dom H ih₁.2 ih₂.2 hdom⟩

/-- Bounded-grammar executions remain positive and locally admitted. -/
theorem boundedPrimitiveGeneratedRepair_positive_local {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (D : ℕ) {m : ℕ} {a : α → ℕ}
    (h : BoundedPrimitiveGeneratedRepair H D m a) :
    0 < m ∧ WeightedLocalRepair H m a := by
  induction h with
  | atom hp _hdegree => exact ⟨hp.1, hp.2.1⟩
  | combine h₁ h₂ hdom ih₁ ih₂ =>
      exact ⟨by omega, weightedLocalRepair_add_of_dom H ih₁.2 ih₂.2 hdom⟩

/-- Primitive-genesis theorem: every positive locally admitted law is generated by the canonical
primitive grammar. -/
theorem weightedLocalRepair_primitiveGenerated {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (m : ℕ) (a : α → ℕ)
    (hm : 0 < m) (hlocal : WeightedLocalRepair H m a) :
    PrimitiveGeneratedRepair H m a := by
  induction m using Nat.strong_induction_on generalizing a with
  | h m ih =>
      by_cases hsplit : WeightedDominatedSplit H m a
      · rcases hsplit with ⟨m₁, m₂, a₁, a₂, hm₁, hm₂, hgrade, hlocal₁, hlocal₂, hdom⟩
        have hm₁lt : m₁ < m := by omega
        have hm₂lt : m₂ < m := by omega
        rw [hgrade]
        exact PrimitiveGeneratedRepair.combine
          (ih m₁ hm₁lt a₁ hm₁ hlocal₁)
          (ih m₂ hm₂lt a₂ hm₂ hlocal₂) hdom
      · exact PrimitiveGeneratedRepair.atom ⟨hm, hlocal, hsplit⟩

/-- A bound on primitive degrees converts every canonical execution into a bounded execution. -/
theorem primitiveGeneratedRepair_to_bounded {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (D : ℕ)
    (hbound : PrimitiveDegreeBound H D)
    {m : ℕ} {a : α → ℕ} (h : PrimitiveGeneratedRepair H m a) :
    BoundedPrimitiveGeneratedRepair H D m a := by
  induction h with
  | atom hp => exact BoundedPrimitiveGeneratedRepair.atom hp (hbound _ _ hp)
  | combine h₁ h₂ hdom ih₁ ih₂ =>
      exact BoundedPrimitiveGeneratedRepair.combine ih₁ ih₂ hdom

/-- A primitive law admitting a `D`-bounded execution must itself have degree at most `D`. -/
theorem primitive_boundedGenerated_degree_le {α : Type u} [DecidableEq α]
    (H : Finset (Finset α)) (D m : ℕ) (a : α → ℕ)
    (hp : WeightedPrimitiveRepair H m a)
    (hgen : BoundedPrimitiveGeneratedRepair H D m a) :
    m ≤ D := by
  cases hgen with
  | atom _hp hdegree => exact hdegree
  | @combine m₁ m₂ a₁ a₂ _ h₁ h₂ hdom =>
      exfalso
      apply hp.2.2
      have hpl₁ := boundedPrimitiveGeneratedRepair_positive_local H D h₁
      have hpl₂ := boundedPrimitiveGeneratedRepair_positive_local H D h₂
      exact ⟨m₁, m₂, a₁, a₂, hpl₁.1, hpl₂.1, rfl, hpl₁.2, hpl₂.2, hdom⟩

/-- Exact finite-grammar classification: primitive degrees are bounded by `D` iff the
`D`-bounded primitive grammar generates every positive locally admitted law. -/
theorem primitiveDegreeBound_iff_all_local_boundedGenerated
    {α : Type u} [DecidableEq α] (H : Finset (Finset α)) (D : ℕ) :
    PrimitiveDegreeBound H D ↔
      ∀ m a, 0 < m → WeightedLocalRepair H m a →
        BoundedPrimitiveGeneratedRepair H D m a := by
  constructor
  · intro hbound m a hm hlocal
    exact primitiveGeneratedRepair_to_bounded H D hbound
      (weightedLocalRepair_primitiveGenerated H m a hm hlocal)
  · intro hall m a hp
    exact primitive_boundedGenerated_degree_le H D m a hp
      (hall m a hp.1 hp.2.1)

/-- Unbounded primitive degrees force every bounded grammar to miss a positive local law. -/
theorem unbounded_primitives_defeat_every_bounded_grammar
    {α : Type u} [DecidableEq α] (H : Finset (Finset α))
    (hunbounded : ∀ D, ∃ m a, WeightedPrimitiveRepair H m a ∧ D < m) :
    ∀ D, ∃ m a, 0 < m ∧ WeightedLocalRepair H m a ∧
      ¬ BoundedPrimitiveGeneratedRepair H D m a := by
  intro D
  obtain ⟨m, a, hp, hDm⟩ := hunbounded D
  exact ⟨m, a, hp.1, hp.2.1, fun hgen =>
    (Nat.not_le_of_gt hDm) (primitive_boundedGenerated_degree_le H D m a hp hgen)⟩

/-- The central triangle law `(2,(1,1,1))` is primitive. -/
theorem triangleCentralPrimitive :
    WeightedPrimitiveRepair triangleFailureFamily 2 (triangleSymbolicWeight 1) := by
  refine ⟨by omega, ?_, ?_⟩
  · simpa using triangleSymbolicWeight_local 1
  · rintro ⟨m₁, m₂, a₁, a₂, hm₁, hm₂, hgrade, hlocal₁, hlocal₂, hdom⟩
    have hm₁eq : m₁ = 1 := by omega
    have hm₂eq : m₂ = 1 := by omega
    subst m₁
    subst m₂
    have hlower₁ := triangle_gradeOne_total_ge_two a₁ hlocal₁
    have hlower₂ := triangle_gradeOne_total_ge_two a₂ hlocal₂
    have hupper : (∑ i : Fin 3, a₁ i) + ∑ i : Fin 3, a₂ i ≤ 3 := by
      calc
        (∑ i : Fin 3, a₁ i) + ∑ i : Fin 3, a₂ i =
            ∑ i : Fin 3, (a₁ i + a₂ i) := by rw [Finset.sum_add_distrib]
        _ ≤ ∑ i : Fin 3, triangleSymbolicWeight 1 i :=
          Finset.sum_le_sum fun i _hi => hdom i
        _ = 3 := by simp [triangleSymbolicWeight]
    omega

/-- The triangle primitive is admitted by the degree-two grammar. -/
theorem triangleCentralPrimitive_bounded :
    BoundedPrimitiveGeneratedRepair triangleFailureFamily 2 2
      (triangleSymbolicWeight 1) :=
  BoundedPrimitiveGeneratedRepair.atom triangleCentralPrimitive (by omega)

/-- Every positive central triangle ray is generated by repeated copies of the degree-two
primitive. -/
theorem triangleCentralRay_bounded_succ (n : ℕ) :
    BoundedPrimitiveGeneratedRepair triangleFailureFamily 2 (2 * (n + 1))
      (triangleSymbolicWeight (n + 1)) := by
  induction n with
  | zero => simpa using triangleCentralPrimitive_bounded
  | succ n ih =>
      have hcombine := BoundedPrimitiveGeneratedRepair.combine ih
        triangleCentralPrimitive_bounded
        (a := triangleSymbolicWeight (n + 2)) (by
          intro i
          simp [triangleSymbolicWeight])
      simpa [Nat.mul_add, Nat.add_assoc] using hcombine

/-- Positive-index form of the central-ray generation theorem. -/
theorem triangleCentralRay_bounded (n : ℕ) (hn : 0 < n) :
    BoundedPrimitiveGeneratedRepair triangleFailureFamily 2 (2 * n)
      (triangleSymbolicWeight n) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  simpa [Nat.succ_eq_add_one] using triangleCentralRay_bounded_succ k

/-- Closed capstone: universal primitive genesis, exact bounded-grammar classification, and the
degree-two explanation of the persistent triangle family. -/
theorem primitiveExecutionGenesisMechanism_closed :
    (∀ (α : Type) (_ : DecidableEq α) (H : Finset (Finset α))
      (m : ℕ) (a : α → ℕ), 0 < m → WeightedLocalRepair H m a →
        PrimitiveGeneratedRepair H m a) ∧
    (∀ (α : Type) (_ : DecidableEq α) (H : Finset (Finset α)) (D : ℕ),
      PrimitiveDegreeBound H D ↔
        ∀ m a, 0 < m → WeightedLocalRepair H m a →
          BoundedPrimitiveGeneratedRepair H D m a) ∧
    WeightedPrimitiveRepair triangleFailureFamily 2 (triangleSymbolicWeight 1) ∧
    (∀ n : ℕ, 0 < n →
      BoundedPrimitiveGeneratedRepair triangleFailureFamily 2 (2 * n)
        (triangleSymbolicWeight n)) := by
  refine ⟨?_, ?_, triangleCentralPrimitive, triangleCentralRay_bounded⟩
  · intro α inst H m a hm hlocal
    letI : DecidableEq α := inst
    exact weightedLocalRepair_primitiveGenerated H m a hm hlocal
  · intro α inst H D
    letI : DecidableEq α := inst
    exact primitiveDegreeBound_iff_all_local_boundedGenerated H D

end GaloisForLFunctions.HTGeometry
