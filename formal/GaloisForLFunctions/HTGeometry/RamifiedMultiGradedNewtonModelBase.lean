import GaloisForLFunctions.HTGeometry.RamifiedMultiGradedNewtonModel
import GaloisForLFunctions.HTGeometry.DerivationAlgebraicStability
import GaloisForLFunctions.HTGeometry.FiniteFieldGeneratorIndependence

/-!
# Ramified multigraded Newton calculus over a general coefficient field

The original ramified Hahn model is complex-linear.  Nonautonomous composition needs the same
calculus over a differential coefficient field containing the independent clock.  This module
provides the coefficient-generic coordinate derivations and their exact leading-term calculus over
any characteristic-zero field.  Degree combinatorics are shared with the complex specialization.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open HahnSeries

/-! ## Finite logarithmic-state recovery from raw jets -/

/-- Ordinary field generated by the first `N` iterates of a base-field derivation. -/
noncomputable def derivationJetPrefixField
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) (N : ℕ) : IntermediateField K E :=
  IntermediateField.adjoin K (Set.range fun i : Fin N ↦ ((D : E → E)^[(i : ℕ)]) x)

/-- Passing from an `N`-jet prefix to the successor prefix absorbs one derivation. -/
theorem derivationJetPrefixField_step
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x y : E) {N : ℕ}
    (hy : y ∈ derivationJetPrefixField D x N) :
    y ∈ derivationJetPrefixField D x (N + 1) ∧
      D y ∈ derivationJetPrefixField D x (N + 1) := by
  apply derivationBase_mem_of_mem_adjoin D _ hy
  rintro z ⟨i, rfl⟩
  constructor
  · apply IntermediateField.subset_adjoin K _
    exact ⟨⟨i, by omega⟩, rfl⟩
  · apply IntermediateField.subset_adjoin K _
    refine ⟨⟨(i : ℕ) + 1, by omega⟩, ?_⟩
    exact Function.iterate_succ_apply' (D : E → E) (i : ℕ) x

/-- Recursive logarithmic states of an arbitrary derivation. -/
noncomputable def derivationLogState
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) : ℕ → E
  | 0 => x
  | k + 1 => D (derivationLogState D x k) / derivationLogState D x k

@[simp] theorem derivationLogState_zero
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) : derivationLogState D x 0 = x := rfl

@[simp] theorem derivationLogState_succ
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) (k : ℕ) :
    derivationLogState D x (k + 1) =
      D (derivationLogState D x k) / derivationLogState D x k := rfl

/-- The `k`-th recursive logarithmic state is rational in raw jets through order `k`. -/
theorem derivationLogState_mem_derivationJetPrefixField
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) (k : ℕ) :
    derivationLogState D x k ∈ derivationJetPrefixField D x (k + 1) := by
  induction k with
  | zero =>
      apply IntermediateField.subset_adjoin K _
      exact ⟨⟨0, by omega⟩, rfl⟩
  | succ k ih =>
      rw [derivationLogState_succ]
      exact IntermediateField.div_mem _
        (derivationJetPrefixField_step D x _ ih).2
        (derivationJetPrefixField_step D x _ ih).1

/-- A smaller raw-jet prefix embeds in every larger prefix. -/
theorem derivationJetPrefixField_mono
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) {N M : ℕ} (hNM : N ≤ M) :
    derivationJetPrefixField D x N ≤ derivationJetPrefixField D x M := by
  rw [derivationJetPrefixField, IntermediateField.adjoin_le_iff]
  rintro y ⟨i, rfl⟩
  apply IntermediateField.subset_adjoin K _
  exact ⟨⟨i, lt_of_lt_of_le i.isLt hNM⟩, rfl⟩

/-- Every logarithmic state inside a fixed horizon belongs to that horizon's raw-jet field. -/
theorem derivationLogState_mem_fixedJetPrefixField
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (D : Derivation K E E) (x : E) {N : ℕ} (i : Fin N) :
    derivationLogState D x (i : ℕ) ∈ derivationJetPrefixField D x N := by
  exact derivationJetPrefixField_mono D x (Nat.succ_le_iff.mpr i.isLt)
    (derivationLogState_mem_derivationJetPrefixField D x (i : ℕ))

/-! ## Finite raw-jet recovery over a differential coefficient field -/

/-- Jet-prefix field over coefficients which the time derivation may act on nontrivially. -/
noncomputable def differentialCoefficientJetPrefixField
    (K : Type*) {C E : Type*} [Field K] [Field C] [Field E]
    [Algebra C E] [Algebra K E]
    (D : Derivation C E E) (x : E) (N : ℕ) : IntermediateField K E :=
  IntermediateField.adjoin K (Set.range fun i : Fin N ↦ ((D : E → E)^[(i : ℕ)]) x)

/-- A derivation preserving the coefficient field sends an `N`-jet prefix into its successor. -/
theorem differentialCoefficientJetPrefixField_step
    (K : Type*) {C E : Type*} [Field K] [Field C] [Field E]
    [Algebra C E] [Algebra K E]
    (D : Derivation C E E)
    (hstable : ∀ c : K, ∃ c' : K, D (algebraMap K E c) = algebraMap K E c')
    (x y : E) {N : ℕ}
    (hy : y ∈ differentialCoefficientJetPrefixField K D x N) :
    y ∈ differentialCoefficientJetPrefixField K D x (N + 1) ∧
      D y ∈ differentialCoefficientJetPrefixField K D x (N + 1) := by
  apply derivationInt_mem_of_mem_adjoin (D.restrictScalars ℤ)
    (fun c ↦ by
      obtain ⟨c', hc'⟩ := hstable c
      rw [show (D.restrictScalars ℤ) (algebraMap K E c) = D (algebraMap K E c) from rfl,
        hc']
      exact IntermediateField.algebraMap_mem _ c') _ hy
  rintro z ⟨i, rfl⟩
  constructor
  · apply IntermediateField.subset_adjoin K _
    exact ⟨⟨i, by omega⟩, rfl⟩
  · apply IntermediateField.subset_adjoin K _
    refine ⟨⟨(i : ℕ) + 1, by omega⟩, ?_⟩
    exact Function.iterate_succ_apply' (D : E → E) (i : ℕ) x

/-- Recursive logarithmic states remain rational in the raw jet prefix when time differentiates
the coefficient field. -/
theorem derivationLogState_mem_differentialCoefficientJetPrefixField
    (K : Type*) {C E : Type*} [Field K] [Field C] [Field E]
    [Algebra C E] [Algebra K E]
    (D : Derivation C E E)
    (hstable : ∀ c : K, ∃ c' : K, D (algebraMap K E c) = algebraMap K E c')
    (x : E) (k : ℕ) :
    derivationLogState D x k ∈ differentialCoefficientJetPrefixField K D x (k + 1) := by
  induction k with
  | zero =>
      apply IntermediateField.subset_adjoin K _
      exact ⟨⟨0, by omega⟩, rfl⟩
  | succ k ih =>
      rw [derivationLogState_succ]
      exact IntermediateField.div_mem _
        (differentialCoefficientJetPrefixField_step K D hstable x _ ih).2
        (differentialCoefficientJetPrefixField_step K D hstable x _ ih).1

/-- Monotonicity of finite jet prefixes over a differential coefficient field. -/
theorem differentialCoefficientJetPrefixField_mono
    (K : Type*) {C E : Type*} [Field K] [Field C] [Field E]
    [Algebra C E] [Algebra K E]
    (D : Derivation C E E) (x : E) {N M : ℕ} (hNM : N ≤ M) :
    differentialCoefficientJetPrefixField K D x N ≤
      differentialCoefficientJetPrefixField K D x M := by
  rw [differentialCoefficientJetPrefixField, IntermediateField.adjoin_le_iff]
  rintro y ⟨i, rfl⟩
  apply IntermediateField.subset_adjoin K _
  exact ⟨⟨i, lt_of_lt_of_le i.isLt hNM⟩, rfl⟩

/-- Every logarithmic state within a fixed horizon belongs to its raw-jet field over the preserved
coefficient field. -/
theorem derivationLogState_mem_fixedDifferentialCoefficientJetPrefixField
    (K : Type*) {C E : Type*} [Field K] [Field C] [Field E]
    [Algebra C E] [Algebra K E]
    (D : Derivation C E E)
    (hstable : ∀ c : K, ∃ c' : K, D (algebraMap K E c) = algebraMap K E c')
    (x : E) {N : ℕ} (i : Fin N) :
    derivationLogState D x (i : ℕ) ∈ differentialCoefficientJetPrefixField K D x N := by
  exact differentialCoefficientJetPrefixField_mono K D x (Nat.succ_le_iff.mpr i.isLt)
    (derivationLogState_mem_differentialCoefficientJetPrefixField K D hstable x (i : ℕ))

/-- Normalized ramified exponent character with values in coefficient field `K`. -/
def mgRamCompBase (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (j : Fin N) : mgDeg N →+ K where
  toFun γ := ((ofLex γ j : ℤ) : K) / (r j : K)
  map_zero' := by
    have hzero : ofLex (0 : mgDeg N) j = 0 := rfl
    rw [hzero]
    simpa only [Int.cast_zero] using (zero_div (r j : K))
  map_add' a b := by
    change (((ofLex a j + ofLex b j : ℤ) : K) / (r j : K)) = _
    push_cast
    ring

/-- Ramified degree-shifting monomial over coefficient field `K`. -/
noncomputable def mgRamShiftBase (K : Type*) [Field K] {N : ℕ}
    (r : Fin N → ℕ) (j : Fin N) : HahnSeries (mgDeg N) K :=
  HahnSeries.single (mgRamStep r j) 1

/-- Ramified coordinate derivative on the Hahn domain over `K`. -/
noncomputable def mgRamPartialBase (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (j : Fin N) :
    Derivation K (HahnSeries (mgDeg N) K) (HahnSeries (mgDeg N) K) :=
  (mgRamShiftBase K r j) • hahnDerivationBase (mgRamCompBase K r j)

theorem coeff_mgRamPartialBase {K : Type*} [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (j : Fin N) (f : HahnSeries (mgDeg N) K) (γ : mgDeg N) :
    (mgRamPartialBase K r j f).coeff (γ + mgRamStep r j) =
      (((ofLex γ j : ℤ) : K) / (r j : K)) * f.coeff γ := by
  have hd : mgRamPartialBase K r j f =
      mgRamShiftBase K r j * hahnGrade (mgRamCompBase K r j) f := by
    show ((mgRamShiftBase K r j) • hahnDerivationBase (mgRamCompBase K r j)) f = _
    simp only [Derivation.coe_smul, Pi.smul_apply, smul_eq_mul]
    rfl
  rw [hd, mgRamShiftBase, HahnSeries.coeff_single_mul, coeff_hahnGrade]
  have hidx : γ + mgRamStep r j - mgRamStep r j = γ := by abel
  rw [hidx]
  change 1 * ((((ofLex γ j : ℤ) : K) / (r j : K)) * f.coeff γ) = _
  ring

/-- Ramified coordinate derivative extended to the Hahn fraction field over `K`. -/
noncomputable def hahnFractionRamPartialBase (K : Type*) [Field K] [CharZero K]
    {N : ℕ} (r : Fin N → ℕ) (j : Fin N) :
    Derivation K (HahnFraction (mgDeg N) K) (HahnFraction (mgDeg N) K) :=
  GaloisForLFunctions.fractionRingDerivation
    ((Algebra.linearMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K)).compDer
      (mgRamPartialBase K r j))

@[simp] theorem hahnFractionRamPartialBase_algebraMap
    (K : Type*) [Field K] [CharZero K] {N : ℕ} (r : Fin N → ℕ)
    (j : Fin N) (f : HahnSeries (mgDeg N) K) :
    hahnFractionRamPartialBase K r j
        (algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K) f) =
      algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K)
        (mgRamPartialBase K r j f) := by
  exact GaloisForLFunctions.fractionRingDerivation_algebraMap
    ((Algebra.linearMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K)).compDer
      (mgRamPartialBase K r j)) f

/-- Exact leading coefficient of the ramified Hahn-domain derivative over `K`. -/
theorem hasLeadAt_mgRamPartialBase {K : Type*} [Field K] [CharZero K]
    {N : ℕ} {r : Fin N → ℕ} {j : Fin N}
    {f : HahnSeries (mgDeg N) K} {d : mgDeg N} {c : K}
    (h : HasLeadAt f d c) :
    HasLeadAt (mgRamPartialBase K r j f) (d + mgRamStep r j)
      ((((ofLex d j : ℤ) : K) / (r j : K)) * c) := by
  constructor
  · intro k hk
    have hd : mgRamPartialBase K r j f =
        mgRamShiftBase K r j * hahnGrade (mgRamCompBase K r j) f := by
      show ((mgRamShiftBase K r j) • hahnDerivationBase (mgRamCompBase K r j)) f = _
      simp only [Derivation.coe_smul, Pi.smul_apply, smul_eq_mul]
      rfl
    rw [hd, mgRamShiftBase, HahnSeries.coeff_single_mul, coeff_hahnGrade]
    have hlt : k - mgRamStep r j < d := by
      have hstep : k - mgRamStep r j + mgRamStep r j = k := by abel
      refine lt_of_add_lt_add_right (a := mgRamStep r j) ?_
      rw [hstep]
      exact hk
    rw [h.1 _ hlt]
    ring
  · rw [coeff_mgRamPartialBase, h.2]

/-- Targeted derivative vanishing for a nested lexicographic boundary over `K`. -/
theorem HasLeadAt.mgRamPartialBase_of_prefix_zero
    {K : Type*} [Field K] [CharZero K] {N : ℕ}
    {r : Fin N → ℕ} {j : Fin N} {f : HahnSeries (mgDeg N) K}
    {d t : mgDeg N} {c : K} (hf : HasLeadAt f d c)
    (hd : ∀ l, l ≤ j → ofLex d l = 0)
    (ht : ∀ l, l < j → ofLex t l = 0)
    (htj : ofLex t j = (r j : ℤ)) :
    HasLeadAt (mgRamPartialBase K r j f) t 0 := by
  constructor
  · intro k hkt
    by_contra hk
    let γ := k - mgRamStep r j
    have hidx : γ + mgRamStep r j = k := by
      dsimp [γ]
      abel
    have hcoeff := coeff_mgRamPartialBase r j f γ
    rw [hidx] at hcoeff
    have hprod : (((ofLex γ j : ℤ) : K) / (r j : K)) * f.coeff γ ≠ 0 := by
      rw [← hcoeff]
      exact hk
    have hfj : f.coeff γ ≠ 0 := (mul_ne_zero_iff.mp hprod).2
    have hγj : ofLex γ j ≠ 0 := by
      intro hz
      apply (mul_ne_zero_iff.mp hprod).1
      rw [hz]
      norm_num
    have hdγ : d ≤ γ := not_lt.mp fun hγd => hfj (hf.1 γ hγd)
    have htk : t < k := by
      rw [← hidx]
      exact lex_target_lt_add_ramStep_of_le_of_component_ne_zero hd ht htj hdγ hγj
    exact (not_lt_of_ge (le_of_lt hkt)) htk
  · by_contra hk
    let γ := t - mgRamStep r j
    have hidx : γ + mgRamStep r j = t := by
      dsimp [γ]
      abel
    have hcoeff := coeff_mgRamPartialBase r j f γ
    rw [hidx] at hcoeff
    have hprod : (((ofLex γ j : ℤ) : K) / (r j : K)) * f.coeff γ ≠ 0 := by
      rw [← hcoeff]
      exact hk
    have hfj : f.coeff γ ≠ 0 := (mul_ne_zero_iff.mp hprod).2
    have hγj : ofLex γ j ≠ 0 := by
      intro hz
      apply (mul_ne_zero_iff.mp hprod).1
      rw [hz]
      norm_num
    have hdγ : d ≤ γ := not_lt.mp fun hγd => hfj (hf.1 γ hγd)
    have htt :=
      lex_target_lt_add_ramStep_of_le_of_component_ne_zero hd ht htj hdγ hγj
    rw [hidx] at htt
    exact lt_irrefl t htt

/-- A leading fraction over `K` can be represented with denominator degree zero. -/
theorem FracHasLeadAt.normalizedBase {K : Type*} [Field K] {N : ℕ}
    {q : HahnFraction (mgDeg N) K} {d : mgDeg N} {c : K}
    (h : FracHasLeadAt q d c) :
    ∃ (f g : HahnSeries (mgDeg N) K) (a : K),
      HasLeadAt f d (c * a) ∧ HasLeadAt g 0 a ∧ a ≠ 0 ∧
        q = algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K) f /
          algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K) g := by
  obtain ⟨f, g, e, a, hf, hg, ha, hq⟩ := h
  let m : HahnSeries (mgDeg N) K := HahnSeries.single (-e) 1
  have hm : HasLeadAt m (-e) 1 := by
    constructor
    · intro k hk
      change (HahnSeries.single (-e) (1 : K)).coeff k = 0
      rw [HahnSeries.coeff_single_of_ne (ne_of_lt hk)]
    · change (HahnSeries.single (-e) (1 : K)).coeff (-e) = 1
      rw [HahnSeries.coeff_single_same]
  have hmf : HasLeadAt (m * f) d (c * a) := by
    convert hm.mul hf using 1
    · abel
    · ring
  have hmg : HasLeadAt (m * g) 0 a := by
    convert hm.mul hg using 1
    · abel
    · ring
  refine ⟨m * f, m * g, a, hmf, hmg, ha, ?_⟩
  rw [hq]
  have hm0 : algebraMap (HahnSeries (mgDeg N) K)
      (HahnFraction (mgDeg N) K) m ≠ 0 :=
    (map_ne_zero (algebraMap (HahnSeries (mgDeg N) K)
      (HahnFraction (mgDeg N) K))).mpr (hm.ne_zero one_ne_zero)
  simp only [map_mul]
  field_simp

/-- Exact leading coefficient of a ramified fraction-field derivative over `K`. -/
theorem FracHasLeadAt.hahnFractionRamPartialBase
    {K : Type*} [Field K] [CharZero K] {N : ℕ}
    {r : Fin N → ℕ} {j : Fin N} {q : HahnFraction (mgDeg N) K}
    {d : mgDeg N} {c : K} (hq : FracHasLeadAt q d c) :
    FracHasLeadAt (hahnFractionRamPartialBase K r j q) (d + mgRamStep r j)
      (((ofLex d j : ℤ) : K) / (r j : K) * c) := by
  obtain ⟨f, g, e, a, hf, hg, ha, rfl⟩ := hq
  have hdf := hasLeadAt_mgRamPartialBase (r := r) (j := j) hf
  have hdg := hasLeadAt_mgRamPartialBase (r := r) (j := j) hg
  have hleft : HasLeadAt (mgRamPartialBase K r j f * g)
      ((d + mgRamStep r j) + (e + e))
      (((((ofLex (d + e) j : ℤ) : K) / (r j : K)) * (c * a)) * a) := by
    convert hdf.mul hg using 1
    abel
  have hright : HasLeadAt (f * mgRamPartialBase K r j g)
      ((d + mgRamStep r j) + (e + e))
      ((c * a) * ((((ofLex e j : ℤ) : K) / (r j : K)) * a)) := by
    convert hf.mul hdg using 1
    all_goals first | rfl | abel
  have hnum : HasLeadAt
      (mgRamPartialBase K r j f * g - f * mgRamPartialBase K r j g)
      ((d + mgRamStep r j) + (e + e))
      (((((ofLex d j : ℤ) : K) / (r j : K)) * c) * (a * a)) := by
    convert hleft.sub hright using 1
    have hcomp : ((ofLex (d + e) j : ℤ) : K) =
        ((ofLex d j : ℤ) : K) + ((ofLex e j : ℤ) : K) := by
      change (((ofLex d j + ofLex e j : ℤ) : K)) = _
      push_cast
      rfl
    rw [hcomp]
    ring
  refine ⟨mgRamPartialBase K r j f * g - f * mgRamPartialBase K r j g, g * g,
    e + e, a * a, hnum, hg.mul hg, mul_ne_zero ha ha, ?_⟩
  have hg0 : algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K) g ≠ 0 :=
    (map_ne_zero (algebraMap (HahnSeries (mgDeg N) K)
      (HahnFraction (mgDeg N) K))).mpr (hg.ne_zero ha)
  rw [Derivation.leibniz_div]
  simp only [smul_eq_mul, hahnFractionRamPartialBase_algebraMap, map_sub, map_mul]
  field_simp

/-- In a zero-prefix coordinate, the generic fraction derivative vanishes through every compatible
target boundary. -/
theorem FracHasLeadAt.hahnFractionRamPartialBase_of_prefix_zero
    {K : Type*} [Field K] [CharZero K] {N : ℕ}
    {r : Fin N → ℕ} {j : Fin N} {q : HahnFraction (mgDeg N) K}
    {d t : mgDeg N} {c : K} (hq : FracHasLeadAt q d c)
    (hd : ∀ l, l ≤ j → ofLex d l = 0)
    (ht : ∀ l, l < j → ofLex t l = 0)
    (htj : ofLex t j = (r j : ℤ)) :
    FracHasLeadAt
      (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j q) t 0 := by
  obtain ⟨f, g, a, hf, hg, ha, rfl⟩ := hq.normalizedBase
  have hzero : ∀ l : Fin N, l ≤ j → ofLex (0 : mgDeg N) l = 0 := by
    intro l _
    rfl
  have htd : ∀ l, l < j → ofLex (t - d) l = 0 := by
    intro l hlj
    change ofLex t l - ofLex d l = 0
    rw [ht l hlj, hd l (le_trans (le_of_lt hlj) le_rfl)]
    omega
  have htdj : ofLex (t - d) j = (r j : ℤ) := by
    change ofLex t j - ofLex d j = (r j : ℤ)
    rw [htj, hd j le_rfl]
    omega
  have hdf : HasLeadAt (mgRamPartialBase K r j f) t 0 :=
    hf.mgRamPartialBase_of_prefix_zero hd ht htj
  have hdg : HasLeadAt (mgRamPartialBase K r j g) (t - d) 0 :=
    hg.mgRamPartialBase_of_prefix_zero hzero htd htdj
  have hleft : HasLeadAt (mgRamPartialBase K r j f * g) t 0 := by
    convert hdf.mul hg using 1
    · abel
    · ring
  have hright : HasLeadAt (f * mgRamPartialBase K r j g) t 0 := by
    convert hf.mul hdg using 1
    · abel
    · ring
  have hnum : HasLeadAt
      (mgRamPartialBase K r j f * g - f * mgRamPartialBase K r j g) t 0 := by
    simpa using hleft.sub hright
  refine ⟨mgRamPartialBase K r j f * g - f * mgRamPartialBase K r j g, g * g,
    0, a * a, ?_, ?_, mul_ne_zero ha ha, ?_⟩
  · simpa only [add_zero, zero_mul] using hnum
  · simpa only [zero_add] using hg.mul hg
  · have hg0 : algebraMap (HahnSeries (mgDeg N) K)
        (HahnFraction (mgDeg N) K) g ≠ 0 :=
      (map_ne_zero (algebraMap (HahnSeries (mgDeg N) K)
        (HahnFraction (mgDeg N) K))).mpr (hg.ne_zero ha)
    rw [Derivation.leibniz_div]
    simp only [smul_eq_mul, hahnFractionRamPartialBase_algebraMap, map_sub, map_mul]
    field_simp

/-! ## Coefficient-generic ramified product cascade -/

/-- Product of branch velocities from coordinate `k` through the last coordinate, over `K`. -/
def hahnFractionRamSuffixProductBase {K : Type*} [Field K] {N : ℕ}
    (A : Fin N → HahnFraction (mgDeg N) K) (k : ℕ) :
    HahnFraction (mgDeg N) K :=
  ∏ j ∈ Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ)), A j

/-- Boundary coefficient of the generic ramified suffix product. -/
def hahnFractionRamSuffixCoefficientBase {K : Type*} [Field K] {N : ℕ}
    (lambda : Fin N → K) (k : ℕ) : K :=
  ∏ j ∈ Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ)), lambda j

theorem hahnFractionRamSuffixProductBase_hasLeadAt
    {K : Type*} [Field K] {N : ℕ} {r : Fin N → ℕ}
    (A : Fin N → HahnFraction (mgDeg N) K) (lambda : Fin N → K)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) (k : ℕ) :
    FracHasLeadAt (hahnFractionRamSuffixProductBase A k) (mgRamSuffixDegree r k)
      (hahnFractionRamSuffixCoefficientBase lambda k) := by
  rw [hahnFractionRamSuffixCoefficientBase, mgRamSuffixDegree_eq_sum_units]
  exact FracHasLeadAt.prod A (mgRamUnit r) lambda
    (Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ)))
    (fun j _ => hA j)

theorem hahnFractionRamSuffixCoefficientBase_ne_zero
    {K : Type*} [Field K] {N : ℕ} {lambda : Fin N → K}
    (hlambda : ∀ j, lambda j ≠ 0) (k : ℕ) :
    hahnFractionRamSuffixCoefficientBase lambda k ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr fun j _ => hlambda j

/-- Product-cascade vector field over coefficient field `K`. -/
noncomputable def hahnFractionRamCascadeDerivationBase
    (K : Type*) [Field K] [CharZero K] {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K) :
    Derivation K (HahnFraction (mgDeg N) K) (HahnFraction (mgDeg N) K) :=
  ∑ j : Fin N, (-hahnFractionRamSuffixProductBase A (j : ℕ)) •
    GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j

@[simp] theorem hahnFractionRamCascadeDerivationBase_apply
    (K : Type*) [Field K] [CharZero K] {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K) (y : HahnFraction (mgDeg N) K) :
    hahnFractionRamCascadeDerivationBase K r A y =
      ∑ j : Fin N, (-hahnFractionRamSuffixProductBase A (j : ℕ)) *
        GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y := by
  classical
  rw [hahnFractionRamCascadeDerivationBase]
  let s : Finset (Fin N) := Finset.univ
  change (∑ j ∈ s, (-hahnFractionRamSuffixProductBase A (j : ℕ)) •
      GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j) y =
    ∑ j ∈ s, (-hahnFractionRamSuffixProductBase A (j : ℕ)) *
      GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      change (-hahnFractionRamSuffixProductBase A (a : ℕ)) *
          GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r a y +
          (∑ j ∈ s, (-hahnFractionRamSuffixProductBase A (j : ℕ)) •
            GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j) y = _
      rw [ih]

/-- Generic-coefficient ramified nested-cascade transition. -/
theorem hahnFractionRamCascade_logarithmicStep_hasLeadAtBase
    {K : Type*} [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j))
    (m : Fin (n + 1)) (y : HahnFraction (mgDeg (n + 1)) K) (c : K)
    (hc : c ≠ 0)
    (hy : FracHasLeadAt y (mgRamObservableDegree r m) c) :
    FracHasLeadAt (hahnFractionRamCascadeDerivationBase K r A y / y)
      (mgRamSuffixDegree r ((m : ℕ) + 1))
      (hahnFractionRamSuffixCoefficientBase lambda (m : ℕ)) := by
  classical
  let E := mgRamObservableDegree r m
  let U := fun k : ℕ => mgRamSuffixDegree r k
  let Q := fun j : Fin (n + 1) => hahnFractionRamSuffixProductBase A (j : ℕ)
  let q := fun j : Fin (n + 1) => hahnFractionRamSuffixCoefficientBase lambda (j : ℕ)
  let T := E + U ((m : ℕ) + 1)
  have hQ : ∀ j, FracHasLeadAt (Q j) (U (j : ℕ)) (q j) := by
    intro j
    exact hahnFractionRamSuffixProductBase_hasLeadAt A lambda hA (j : ℕ)
  have hterm : ∀ j : Fin (n + 1),
      FracHasLeadAt ((-Q j) *
        GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y) T
        (if j = m then q m * c else 0) := by
    intro j
    by_cases hjm : j = m
    · subst j
      have hrK : (r m : K) ≠ 0 := by
        exact_mod_cast (ne_of_gt (hr m))
      have hdy : FracHasLeadAt
          (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r m y)
          (E + mgRamStep r m) (-c) := by
        have h := hy.hahnFractionRamPartialBase (K := K) (r := r) (j := m)
        change FracHasLeadAt
          (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r m y)
          (E + mgRamStep r m) (-c)
        convert h using 1
        rw [ofLex_mgRamObservableDegree_self]
        push_cast
        field_simp
      have hmain := (hQ m).neg.mul hdy
      rw [if_pos rfl]
      convert hmain using 1
      · dsimp [T, E, U]
        exact (mgRam_main_degree r m).symm
      · ring
    · rcases lt_or_gt_of_ne hjm with hjm' | hmj
      · have hd : ∀ l, l ≤ j → ofLex E l = 0 := by
          intro l hlj
          exact ofLex_mgRamObservableDegree_eq_zero_of_lt r (lt_of_le_of_lt hlj hjm')
        let t := E + U ((m : ℕ) + 1) - U (j : ℕ)
        have htdata := mgRam_lower_derivative_target_prefix r hjm'
        change (∀ l, l < j → ofLex t l = 0) ∧ ofLex t j = (r j : ℤ) at htdata
        have hdy : FracHasLeadAt
            (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y) t 0 :=
          hy.hahnFractionRamPartialBase_of_prefix_zero hd htdata.1 htdata.2
        have hzero := (hQ j).neg.mul hdy
        rw [if_neg hjm]
        convert hzero using 1
        · dsimp [t, T]
          abel
        · ring
      · have hdy := hy.hahnFractionRamPartialBase (K := K) (r := r) (j := j)
        have hhigh := (hQ j).neg.mul hdy
        have hmjNat : (m : ℕ) + 1 < (j : ℕ) + 1 := by omega
        have hmN : (m : ℕ) + 1 < n + 1 := by
          have hjN : (j : ℕ) < n + 1 := j.isLt
          omega
        have hsuffix : U ((m : ℕ) + 1) < U ((j : ℕ) + 1) :=
          mgRamSuffixDegree_lt hr hmjNat hmN
        have hdegree : T < E + U ((j : ℕ) + 1) := by
          dsimp [T]
          simpa [add_comm] using add_lt_add_left hsuffix E
        have hhigh' : FracHasLeadAt ((-Q j) *
            GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y)
            (E + U ((j : ℕ) + 1))
            ((-q j) * ((((ofLex E j : ℤ) : K) / (r j : K)) * c)) := by
          convert hhigh using 1
          dsimp [E, U]
          exact (mgRam_higher_term_degree r m j).symm
        rw [if_neg hjm]
        exact hhigh'.mono hdegree
  have hsum : FracHasLeadAt
      (∑ j : Fin (n + 1), (-Q j) *
        GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y)
      T (q m * c) := by
    have h := FracHasLeadAt.sum
      (fun j : Fin (n + 1) => (-Q j) *
        GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j y)
      T (fun j => if j = m then q m * c else 0) Finset.univ
      (fun j _ => hterm j)
    simpa using h
  have hdelta : FracHasLeadAt (hahnFractionRamCascadeDerivationBase K r A y)
      T (q m * c) := by
    rw [hahnFractionRamCascadeDerivationBase_apply]
    exact hsum
  have hquot := hdelta.div hy hc
  convert hquot using 1
  · dsimp [T, E, U]
    abel
  · dsimp [q]
    field_simp

/-! ## Differential coefficient fields -/

/-- Nonautonomous ramified cascade derivation: coefficient derivation plus coordinate vector
field. -/
noncomputable def hahnFractionRamCascadeDifferentialDerivation
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K]
    {N : ℕ} (dK : Derivation C K K) (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K) :
    Derivation C (HahnFraction (mgDeg N) K) (HahnFraction (mgDeg N) K) :=
  hahnFractionCoefficientDerivation dK +
    (hahnFractionRamCascadeDerivationBase K r A).restrictScalars C

@[simp] theorem hahnFractionRamCascadeDifferentialDerivation_apply
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K]
    {N : ℕ} (dK : Derivation C K K) (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (y : HahnFraction (mgDeg N) K) :
    hahnFractionRamCascadeDifferentialDerivation C K dK r A y =
      hahnFractionCoefficientDerivation dK y +
        hahnFractionRamCascadeDerivationBase K r A y := rfl

@[simp] theorem hahnFractionRamCascadeDifferentialDerivation_coeffAlgebraMap
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K]
    {N : ℕ} (dK : Derivation C K K) (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K) (c : K) :
    hahnFractionRamCascadeDifferentialDerivation C K dK r A
        (algebraMap K (HahnFraction (mgDeg N) K) c) =
      algebraMap K (HahnFraction (mgDeg N) K) (dK c) := by
  rw [hahnFractionRamCascadeDifferentialDerivation_apply,
    hahnFractionCoefficientDerivation_coeffAlgebraMap]
  simp

/-- Coefficient differentiation preserves the current exponent, while the coordinate cascade
contributes at the strictly earlier output-dominant suffix exponent. -/
theorem hahnFractionRamCascadeDifferential_logarithmicStep_hasLeadAtBase
    {C K : Type*} [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K)
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j))
    (m : Fin (n + 1)) (hm : (m : ℕ) + 1 < n + 1)
    (y : HahnFraction (mgDeg (n + 1)) K) (c : K)
    (hc : c ≠ 0)
    (hy : FracHasLeadAt y (mgRamObservableDegree r m) c) :
    FracHasLeadAt
      (hahnFractionRamCascadeDifferentialDerivation C K dK r A y / y)
      (mgRamSuffixDegree r ((m : ℕ) + 1))
      (hahnFractionRamSuffixCoefficientBase lambda (m : ℕ)) := by
  have hzero : mgRamSuffixDegree r (n + 1) = 0 := by
    apply ofLex.injective
    funext j
    change (if n + 1 ≤ (j : ℕ) then -(r j : ℤ) else 0) = 0
    rw [if_neg (Nat.not_le.mpr j.isLt)]
  have hsuffix : mgRamSuffixDegree r ((m : ℕ) + 1) < 0 := by
    rw [← hzero]
    exact mgRamSuffixDegree_lt hr (by omega) hm
  have hcoeff := (hy.hahnFractionCoefficientDerivation dK).div hy hc
  have hcoeffZero :
      FracHasLeadAt (hahnFractionCoefficientDerivation dK y / y) 0 (dK c / c) := by
    convert hcoeff using 1
    abel
  have hcoeffLower :
      FracHasLeadAt (hahnFractionCoefficientDerivation dK y / y)
        (mgRamSuffixDegree r ((m : ℕ) + 1)) 0 :=
    hcoeffZero.mono hsuffix
  have hcascade := hahnFractionRamCascade_logarithmicStep_hasLeadAtBase
    r hr A lambda hA m y c hc hy
  rw [hahnFractionRamCascadeDifferentialDerivation_apply, add_div]
  simpa using hcoeffLower.add hcascade

/-- Original ramified coordinate over coefficient field `K`. -/
noncomputable def hahnFractionRamCoordinateBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) (j : Fin N) :
    HahnFraction (mgDeg N) K :=
  algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K)
    (HahnSeries.single (mgRamUnit r j) 1)

theorem hahnFractionRamCoordinateBase_hasLeadAt
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) (j : Fin N) :
    FracHasLeadAt (hahnFractionRamCoordinateBase K r j) (mgRamUnit r j) 1 := by
  apply FracHasLeadAt.of_hahn
  constructor
  · intro k hk
    rw [HahnSeries.coeff_single_of_ne (ne_of_lt hk)]
  · rw [HahnSeries.coeff_single_same]

/-- Generic ramified coordinate derivative is the negative Kronecker derivation. -/
theorem hahnFractionRamPartialBase_coordinate
    (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i) (j k : Fin N) :
    hahnFractionRamPartialBase K r j (hahnFractionRamCoordinateBase K r k) =
      algebraMap K (HahnFraction (mgDeg N) K) (if k = j then -1 else 0) := by
  rw [hahnFractionRamCoordinateBase, hahnFractionRamPartialBase_algebraMap]
  have hs : mgRamPartialBase K r j (HahnSeries.single (mgRamUnit r k) 1) =
      algebraMap K (HahnSeries (mgDeg N) K) (if k = j then -1 else 0) := by
    by_cases hkj : k = j
    · subst k
      ext d
      rw [show mgRamPartialBase K r j (HahnSeries.single (mgRamUnit r j) 1) =
          mgRamShiftBase K r j * hahnGrade (mgRamCompBase K r j)
            (HahnSeries.single (mgRamUnit r j) 1) by rfl]
      simp only [mgRamShiftBase, HahnSeries.coeff_single_mul, coeff_hahnGrade]
      have hrK : (r j : K) ≠ 0 := by exact_mod_cast (ne_of_gt (hr j))
      by_cases hd : d = 0
      · subst d
        rw [show (0 : mgDeg N) - mgRamStep r j = mgRamUnit r j by
          have hzero := mgRamUnit_add_step r j
          rw [eq_neg_of_add_eq_zero_left hzero]
          abel]
        have hcomp : mgRamCompBase K r j (mgRamUnit r j) = -1 := by
          change ((((ofLex (mgRamUnit r j) j : ℤ) : K) / (r j : K))) = -1
          rw [ofLex_mgRamUnit, if_pos rfl]
          push_cast
          field_simp
        rw [hcomp]
        simp
      · have hne : d - mgRamStep r j ≠ mgRamUnit r j := by
          intro h
          apply hd
          calc
            d = (d - mgRamStep r j) + mgRamStep r j := by abel
            _ = mgRamUnit r j + mgRamStep r j := by rw [h]
            _ = 0 := mgRamUnit_add_step r j
        rw [HahnSeries.coeff_single, if_neg hne]
        simp [hd]
    · ext d
      rw [show mgRamPartialBase K r j (HahnSeries.single (mgRamUnit r k) 1) =
          mgRamShiftBase K r j * hahnGrade (mgRamCompBase K r j)
            (HahnSeries.single (mgRamUnit r k) 1) by rfl]
      simp only [mgRamShiftBase, HahnSeries.coeff_single_mul, coeff_hahnGrade]
      have hkj' : j ≠ k := Ne.symm hkj
      simp only [if_neg hkj]
      by_cases hindex : d - mgRamStep r j = mgRamUnit r k
      · rw [HahnSeries.coeff_single, if_pos hindex, mul_one]
        have hcomp : mgRamCompBase K r j (d - mgRamStep r j) = 0 := by
          change ((((ofLex (d - mgRamStep r j) j : ℤ) : K) / (r j : K))) = 0
          rw [hindex, ofLex_mgRamUnit, if_neg hkj']
          norm_num
        rw [hcomp]
        simp
      · rw [HahnSeries.coeff_single, if_neg hindex]
        simp
  simpa only [IsScalarTower.algebraMap_apply K (HahnSeries (mgDeg N) K)
    (HahnFraction (mgDeg N) K)] using
    congrArg (algebraMap (HahnSeries (mgDeg N) K)
      (HahnFraction (mgDeg N) K)) hs

/-- Generic product-cascade vector field sends each coordinate to its suffix velocity product. -/
theorem hahnFractionRamCascadeDerivationBase_coordinate
    (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K) (k : Fin N) :
    hahnFractionRamCascadeDerivationBase K r A (hahnFractionRamCoordinateBase K r k) =
      hahnFractionRamSuffixProductBase A (k : ℕ) := by
  rw [hahnFractionRamCascadeDerivationBase_apply]
  simp_rw [hahnFractionRamPartialBase_coordinate K r hr]
  rw [Finset.sum_eq_single k]
  · simp
  · intro j _ hjk
    simp [Ne.symm hjk]
  · intro hk
    exact (hk (Finset.mem_univ k)).elim

/-- Coefficient differentiation kills every ramified coordinate monomial. -/
theorem hahnFractionCoefficientDerivation_coordinateBase
    {C K : Type*} [Field C] [Field K] [Algebra C K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (k : Fin N) :
    hahnFractionCoefficientDerivation dK (hahnFractionRamCoordinateBase K r k) = 0 := by
  rw [hahnFractionRamCoordinateBase, hahnFractionCoefficientDerivation_algebraMap]
  rw [← map_zero (algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K))]
  apply congrArg (algebraMap (HahnSeries (mgDeg N) K) (HahnFraction (mgDeg N) K))
  ext d
  rw [coeff_hahnCoefficientDerivation]
  by_cases hd : d = mgRamUnit r k
  · subst d
    rw [HahnSeries.coeff_single_same, dK.map_one_eq_zero, HahnSeries.coeff_zero]
  · rw [HahnSeries.coeff_single_of_ne hd, map_zero, HahnSeries.coeff_zero]

/-- Total nonautonomous cascade derivation has the exact suffix-product coordinate law. -/
theorem hahnFractionRamCascadeDifferentialDerivation_coordinate
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K) (k : Fin N) :
    hahnFractionRamCascadeDifferentialDerivation C K dK r A
        (hahnFractionRamCoordinateBase K r k) =
      hahnFractionRamSuffixProductBase A (k : ℕ) := by
  rw [hahnFractionRamCascadeDifferentialDerivation_apply,
    hahnFractionCoefficientDerivation_coordinateBase,
    zero_add, hahnFractionRamCascadeDerivationBase_coordinate K r hr]

/-- Terminal coordinate followed by logarithmic derivatives for the nonautonomous cascade. -/
noncomputable def hahnFractionRamDifferentialLogStateBase
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K) (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) :
    ℕ → HahnFraction (mgDeg (n + 1)) K
  | 0 => hahnFractionRamCoordinateBase K r 0
  | k + 1 =>
      hahnFractionRamCascadeDifferentialDerivation C K dK r A
          (hahnFractionRamDifferentialLogStateBase C K dK r A k) /
        hahnFractionRamDifferentialLogStateBase C K dK r A k

@[simp] theorem hahnFractionRamDifferentialLogStateBase_zero
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K) (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) :
    hahnFractionRamDifferentialLogStateBase C K dK r A 0 =
      hahnFractionRamCoordinateBase K r 0 := rfl

@[simp] theorem hahnFractionRamDifferentialLogStateBase_succ
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K) (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) (k : ℕ) :
    hahnFractionRamDifferentialLogStateBase C K dK r A (k + 1) =
      hahnFractionRamCascadeDifferentialDerivation C K dK r A
          (hahnFractionRamDifferentialLogStateBase C K dK r A k) /
        hahnFractionRamDifferentialLogStateBase C K dK r A k := rfl

/-- Every nonautonomous logarithmic state has the exact nested suffix boundary. -/
theorem hahnFractionRamDifferentialLogStateBase_exists_lead
    {C K : Type*} [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K)
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j))
    (m : Fin (n + 1)) :
    ∃ c : K, c ≠ 0 ∧
      FracHasLeadAt (hahnFractionRamDifferentialLogStateBase C K dK r A (m : ℕ))
        (mgRamObservableDegree r m) c := by
  have hnat : ∀ k : ℕ, (hk : k < n + 1) →
      ∃ c : K, c ≠ 0 ∧
        FracHasLeadAt (hahnFractionRamDifferentialLogStateBase C K dK r A k)
          (mgRamObservableDegree r ⟨k, hk⟩) c := by
    intro k
    induction k with
    | zero =>
        intro hk
        refine ⟨1, one_ne_zero, ?_⟩
        have hfin : (⟨0, hk⟩ : Fin (n + 1)) = 0 := Fin.ext rfl
        rw [mgRamObservableDegree, if_pos hfin]
        exact hahnFractionRamCoordinateBase_hasLeadAt K r 0
    | succ k ih =>
        intro hk
        have hk' : k < n + 1 := by omega
        obtain ⟨c, hc, hstate⟩ := ih hk'
        let km : Fin (n + 1) := ⟨k, hk'⟩
        have hnext := hahnFractionRamCascadeDifferential_logarithmicStep_hasLeadAtBase
          dK r hr A lambda hA km (by simpa [km] using hk)
          (hahnFractionRamDifferentialLogStateBase C K dK r A k) c hc hstate
        refine ⟨hahnFractionRamSuffixCoefficientBase lambda k,
          hahnFractionRamSuffixCoefficientBase_ne_zero hlambda k, ?_⟩
        rw [hahnFractionRamDifferentialLogStateBase_succ]
        have hne : (⟨k + 1, hk⟩ : Fin (n + 1)) ≠ 0 := by
          intro h
          have := Fin.ext_iff.mp h
          simp at this
        rw [mgRamObservableDegree, if_neg hne]
        exact hnext
  exact hnat (m : ℕ) m.isLt

/-- Terminal coordinate followed by iterated logarithmic derivatives over `K`. -/
noncomputable def hahnFractionRamLogStateBase
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) :
    ℕ → HahnFraction (mgDeg (n + 1)) K
  | 0 => hahnFractionRamCoordinateBase K r 0
  | k + 1 =>
      hahnFractionRamCascadeDerivationBase K r A (hahnFractionRamLogStateBase K r A k) /
        hahnFractionRamLogStateBase K r A k

@[simp] theorem hahnFractionRamLogStateBase_zero
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) :
    hahnFractionRamLogStateBase K r A 0 = hahnFractionRamCoordinateBase K r 0 := rfl

@[simp] theorem hahnFractionRamLogStateBase_succ
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) (k : ℕ) :
    hahnFractionRamLogStateBase K r A (k + 1) =
      hahnFractionRamCascadeDerivationBase K r A (hahnFractionRamLogStateBase K r A k) /
        hahnFractionRamLogStateBase K r A k := rfl

/-- Every generic-coefficient logarithmic state has its exact nested suffix boundary. -/
theorem hahnFractionRamLogStateBase_exists_lead
    {K : Type*} [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j))
    (m : Fin (n + 1)) :
    ∃ c : K, c ≠ 0 ∧
      FracHasLeadAt (hahnFractionRamLogStateBase K r A (m : ℕ))
        (mgRamObservableDegree r m) c := by
  have hnat : ∀ k : ℕ, (hk : k < n + 1) →
      ∃ c : K, c ≠ 0 ∧
        FracHasLeadAt (hahnFractionRamLogStateBase K r A k)
          (mgRamObservableDegree r ⟨k, hk⟩) c := by
    intro k
    induction k with
    | zero =>
        intro hk
        refine ⟨1, one_ne_zero, ?_⟩
        have hfin : (⟨0, hk⟩ : Fin (n + 1)) = 0 := Fin.ext rfl
        rw [mgRamObservableDegree, if_pos hfin]
        exact hahnFractionRamCoordinateBase_hasLeadAt K r 0
    | succ k ih =>
        intro hk
        have hk' : k < n + 1 := by omega
        obtain ⟨c, hc, hstate⟩ := ih hk'
        let km : Fin (n + 1) := ⟨k, hk'⟩
        have hnext := hahnFractionRamCascade_logarithmicStep_hasLeadAtBase
          r hr A lambda hA km (hahnFractionRamLogStateBase K r A k) c hc hstate
        refine ⟨hahnFractionRamSuffixCoefficientBase lambda k,
          hahnFractionRamSuffixCoefficientBase_ne_zero hlambda k, ?_⟩
        rw [hahnFractionRamLogStateBase_succ]
        have hne : (⟨k + 1, hk⟩ : Fin (n + 1)) ≠ 0 := by
          intro h
          have := Fin.ext_iff.mp h
          simp at this
        rw [mgRamObservableDegree, if_neg hne]
        exact hnext
  exact hnat (m : ℕ) m.isLt

/-! ## Generic gradient determinant -/

/-- Coefficient matrix of the nested-Puiseux gradient over `K`. -/
def hahnFractionNestedCascadeLeadMatrixBase
    (K : Type*) [Field K] {n : ℕ} (c : Fin (n + 1) → K) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) K :=
  fun i j => if i = 0 then (if j = 0 then -c i else 0)
    else if (i : ℕ) ≤ (j : ℕ) then -c i else 0

theorem hahnFractionNestedCascadeLeadMatrixBase_upper
    (K : Type*) [Field K] {n : ℕ} (c : Fin (n + 1) → K)
    (i j : Fin (n + 1)) (hji : j < i) :
    hahnFractionNestedCascadeLeadMatrixBase K c i j = 0 := by
  by_cases hi : i = 0
  · subst i
    exact (Fin.not_lt_zero j hji).elim
  · rw [hahnFractionNestedCascadeLeadMatrixBase, if_neg hi, if_neg]
    omega

theorem hahnFractionNestedCascadeLeadMatrixBase_diag
    (K : Type*) [Field K] {n : ℕ} (c : Fin (n + 1) → K) (i : Fin (n + 1)) :
    hahnFractionNestedCascadeLeadMatrixBase K c i i = -c i := by
  by_cases hi : i = 0
  · subst i
    simp [hahnFractionNestedCascadeLeadMatrixBase]
  · rw [hahnFractionNestedCascadeLeadMatrixBase, if_neg hi, if_pos le_rfl]

theorem hahnFractionNestedCascadeLeadMatrixBase_det_ne_zero
    (K : Type*) [Field K] {n : ℕ} (c : Fin (n + 1) → K) (hc : ∀ i, c i ≠ 0) :
    (hahnFractionNestedCascadeLeadMatrixBase K c).det ≠ 0 := by
  rw [Matrix.det_of_upperTriangular
    (hahnFractionNestedCascadeLeadMatrixBase_upper K c)]
  exact Finset.prod_ne_zero_iff.mpr fun i _ => by
    rw [hahnFractionNestedCascadeLeadMatrixBase_diag]
    exact neg_ne_zero.mpr (hc i)

/-- Coordinate-gradient matrix for generic ramified coordinate derivations. -/
def hahnFractionRamGradientMatrixBase
    (K : Type*) [Field K] [CharZero K] {N : ℕ} (r : Fin N → ℕ)
    (f : Fin N → HahnFraction (mgDeg N) K) :
    Matrix (Fin N) (Fin N) (HahnFraction (mgDeg N) K) :=
  fun i j => GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j (f i)

theorem mgRamObservable_derivativeCoefficientBase
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (c : Fin (n + 1) → K) (i j : Fin (n + 1)) :
    (((ofLex (mgRamObservableDegree r i) j : ℤ) : K) / (r j : K)) * c i =
      hahnFractionNestedCascadeLeadMatrixBase K c i j := by
  have hrK : (r j : K) ≠ 0 := by exact_mod_cast (ne_of_gt (hr j))
  by_cases hi : i = 0
  · subst i
    rw [mgRamObservableDegree, if_pos rfl]
    by_cases hj : j = 0
    · subst j
      rw [ofLex_mgRamUnit]
      simp only [hahnFractionNestedCascadeLeadMatrixBase]
      push_cast
      field_simp
    · rw [ofLex_mgRamUnit, if_neg hj]
      simp [hahnFractionNestedCascadeLeadMatrixBase, hj]
  · rw [mgRamObservableDegree, if_neg hi, ofLex_mgRamSuffixDegree]
    by_cases hij : (i : ℕ) ≤ (j : ℕ)
    · rw [if_pos hij]
      simp only [hahnFractionNestedCascadeLeadMatrixBase, if_neg hi, if_pos hij]
      push_cast
      field_simp
    · rw [if_neg hij]
      simp [hahnFractionNestedCascadeLeadMatrixBase, hi, hij]

theorem hahnFractionRamGradientMatrixBase_det_ne_zero_of_nestedCascade_leads
    {K : Type*} [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (f : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (c : Fin (n + 1) → K) (hc : ∀ i, c i ≠ 0)
    (hf : ∀ i, FracHasLeadAt (f i) (mgRamObservableDegree r i) (c i)) :
    (hahnFractionRamGradientMatrixBase K r f).det ≠ 0 := by
  refine fracDet_ne_zero_of_hasLeadAt (hahnFractionRamGradientMatrixBase K r f)
    (mgRamObservableDegree r) (mgRamStep r)
    (hahnFractionNestedCascadeLeadMatrixBase K c) ?_
    (hahnFractionNestedCascadeLeadMatrixBase_det_ne_zero K c hc)
  intro i j
  have h := (hf i).hahnFractionRamPartialBase (K := K) (r := r) (j := j)
  change FracHasLeadAt
    (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r j (f i))
    (mgRamObservableDegree r i + mgRamStep r j)
    (hahnFractionNestedCascadeLeadMatrixBase K c i j)
  convert h using 1
  exact (mgRamObservable_derivativeCoefficientBase K r hr c i j).symm

theorem algebraicIndependent_of_hahnFractionRamGradientMatrixBase_det_ne_zero
    {K : Type*} [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (f : Fin N → HahnFraction (mgDeg N) K)
    (hdet : (hahnFractionRamGradientMatrixBase K r f).det ≠ 0) :
    AlgebraicIndependent K f := by
  let M : Matrix (Fin N) (Fin N) (HahnFraction (mgDeg N) K) :=
    Matrix.transpose (hahnFractionRamGradientMatrixBase K r f)
  have hM : M.det ≠ 0 := by
    simpa [M, Matrix.det_transpose] using hdet
  refine algebraicIndependent_of_domain_jacobian f
    (fun i => GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r i)
    ?_ ?_ ?_ M hM ?_
  · intro i a b
    exact map_add (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r i) a b
  · intro i a b
    simpa only [smul_eq_mul, add_comm, mul_comm] using
      (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r i).leibniz a b
  · intro i z
    exact (GaloisForLFunctions.HTGeometry.hahnFractionRamPartialBase K r i).map_algebraMap z
  · intro i j
    rfl

/-- **Differential-coefficient ramified Puiseux observability.** The terminal output and all
successive logarithmic states remain algebraically independent over nonconstant coefficient field
`K`. -/
theorem algebraicIndependent_hahnFractionRamDifferentialLogStateBase
    {C K : Type*} [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K)
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent K
      (fun i : Fin (n + 1) ↦
        hahnFractionRamDifferentialLogStateBase C K dK r A (i : ℕ)) := by
  choose c hc hf using fun i =>
    hahnFractionRamDifferentialLogStateBase_exists_lead dK r hr A lambda hlambda hA i
  apply algebraicIndependent_of_hahnFractionRamGradientMatrixBase_det_ne_zero r
  exact hahnFractionRamGradientMatrixBase_det_ne_zero_of_nestedCascade_leads r hr _ c hc hf

/-- **Coefficient-generic ramified Puiseux observability.**  Nonzero output-linear branch leads
force algebraic independence of the terminal output and every logarithmic state over `K`. -/
theorem algebraicIndependent_hahnFractionRamLogStateBase
    {K : Type*} [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent K
      (fun i : Fin (n + 1) => hahnFractionRamLogStateBase K r A (i : ℕ)) := by
  choose c hc hf using fun i =>
    hahnFractionRamLogStateBase_exists_lead r hr A lambda hlambda hA i
  apply algebraicIndependent_of_hahnFractionRamGradientMatrixBase_det_ne_zero r
  exact hahnFractionRamGradientMatrixBase_det_ne_zero_of_nestedCascade_leads r hr _ c hc hf

/-- The specialized Hahn logarithmic chain is the generic recursive logarithmic chain. -/
theorem hahnFractionRamLogStateBase_eq_derivationLogState
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) (k : ℕ) :
    hahnFractionRamLogStateBase K r A k =
      derivationLogState (hahnFractionRamCascadeDerivationBase K r A)
        (hahnFractionRamCoordinateBase K r 0) k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [hahnFractionRamLogStateBase_succ, derivationLogState_succ, ih]

/-- Every finite Hahn logarithmic state belongs to the field generated by the corresponding raw
output-jet horizon. -/
theorem hahnFractionRamLogStateBase_mem_outputJetAdjoin
    (K : Type*) [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (i : Fin (n + 1)) :
    hahnFractionRamLogStateBase K r A (i : ℕ) ∈
      IntermediateField.adjoin K
        (Set.range fun j : Fin (n + 1) ↦
          ((hahnFractionRamCascadeDerivationBase K r A :
              HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
            (hahnFractionRamCoordinateBase K r 0)) := by
  rw [hahnFractionRamLogStateBase_eq_derivationLogState]
  exact derivationLogState_mem_fixedJetPrefixField
    (hahnFractionRamCascadeDerivationBase K r A)
      (hahnFractionRamCoordinateBase K r 0) i

/-- **Coefficient-generic raw-jet observability.**  The first `n+1` Lie derivatives of the terminal
coordinate are algebraically independent over `K`. -/
theorem algebraicIndependent_hahnFractionRamCascadeOutputJetsBase
    {K : Type*} [Field K] [CharZero K] {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent K
      (fun j : Fin (n + 1) ↦
        ((hahnFractionRamCascadeDerivationBase K r A :
            HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
          (hahnFractionRamCoordinateBase K r 0)) := by
  apply algebraicIndependent_of_independent_family_mem_adjoin
    (fun j : Fin (n + 1) ↦
      ((hahnFractionRamCascadeDerivationBase K r A :
          HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
        (hahnFractionRamCoordinateBase K r 0))
    (fun i : Fin (n + 1) ↦ hahnFractionRamLogStateBase K r A (i : ℕ))
    (algebraicIndependent_hahnFractionRamLogStateBase r hr A lambda hlambda hA)
    (hahnFractionRamLogStateBase_mem_outputJetAdjoin K r A)
    rfl

/-- Nonautonomous Hahn logarithmic chain equals generic recursive chain for total time
derivation. -/
theorem hahnFractionRamDifferentialLogStateBase_eq_derivationLogState
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K) (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K) (k : ℕ) :
    hahnFractionRamDifferentialLogStateBase C K dK r A k =
      derivationLogState (hahnFractionRamCascadeDifferentialDerivation C K dK r A)
        (hahnFractionRamCoordinateBase K r 0) k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [hahnFractionRamDifferentialLogStateBase_succ, derivationLogState_succ, ih]

/-- Every nonautonomous Hahn logarithmic state lies in the raw output-jet field over `K`. -/
theorem hahnFractionRamDifferentialLogStateBase_mem_outputJetAdjoin
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K) (r : Fin (n + 1) → ℕ)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (i : Fin (n + 1)) :
    hahnFractionRamDifferentialLogStateBase C K dK r A (i : ℕ) ∈
      IntermediateField.adjoin K
        (Set.range fun j : Fin (n + 1) ↦
          ((hahnFractionRamCascadeDifferentialDerivation C K dK r A :
              HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
            (hahnFractionRamCoordinateBase K r 0)) := by
  rw [hahnFractionRamDifferentialLogStateBase_eq_derivationLogState]
  exact derivationLogState_mem_fixedDifferentialCoefficientJetPrefixField K
    (hahnFractionRamCascadeDifferentialDerivation C K dK r A)
    (fun c ↦ ⟨dK c,
      hahnFractionRamCascadeDifferentialDerivation_coeffAlgebraMap C K dK r A c⟩)
    (hahnFractionRamCoordinateBase K r 0) i

/-- **Nonautonomous coefficient-field raw-jet observability.** The first `n+1` Lie derivatives of
the terminal coordinate are algebraically independent over `K`, even though time differentiates
the coefficients. -/
theorem algebraicIndependent_hahnFractionRamDifferentialCascadeOutputJetsBase
    {C K : Type*} [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K)
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent K
      (fun j : Fin (n + 1) ↦
        ((hahnFractionRamCascadeDifferentialDerivation C K dK r A :
            HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
          (hahnFractionRamCoordinateBase K r 0)) := by
  apply algebraicIndependent_of_independent_family_mem_adjoin
    (fun j : Fin (n + 1) ↦
      ((hahnFractionRamCascadeDifferentialDerivation C K dK r A :
          HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
        (hahnFractionRamCoordinateBase K r 0))
    (fun i : Fin (n + 1) ↦
      hahnFractionRamDifferentialLogStateBase C K dK r A (i : ℕ))
    (algebraicIndependent_hahnFractionRamDifferentialLogStateBase
      dK r hr A lambda hlambda hA)
    (hahnFractionRamDifferentialLogStateBase_mem_outputJetAdjoin C K dK r A)
    rfl

