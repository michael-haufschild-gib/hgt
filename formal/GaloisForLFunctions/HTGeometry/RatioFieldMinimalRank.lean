import GaloisForLFunctions.HTGeometry.CharacteristicRatioField
import GaloisForLFunctions.HTGeometry.DifferentialRelationBaseChange

/-!
# The ratio field carries the same minimal rank

The normalized characteristic descends to the field generated by its coefficient ratios without
changing its order, so the minimal relation rank over that field is no larger than over the whole
intermediate field.  The reverse inequality is monotonicity of the minimal rank in the coefficient
field.

Hence the two fields have the same minimal rank — Ritt's first equality, and the reason the terminal
step can compare them at all.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- Normalizing does not change the order. -/
theorem scalarDifferentialPolynomialOrder_C_mul {K : Type*} [Field K]
    {c : K} (hc : c ≠ 0) (P : DifferentialPolynomial Unit K) :
    scalarDifferentialPolynomialOrder (MvPolynomial.C c * P)
      = scalarDifferentialPolynomialOrder P := by
  rw [scalarDifferentialPolynomialOrder, scalarDifferentialPolynomialOrder,
    MvPolynomial.vars_C_mul c hc]

/-- **The descended normalized characteristic has the characteristic's order.** -/
theorem order_descend_normalized_eq (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    (P : DifferentialPolynomial Unit G) {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0) :
    scalarDifferentialPolynomialOrder
        (HTGeometry.descendCoefficients
          (characteristicDifferentialRatioField_le G hGclosed P n)
          (MvPolynomial.C (P.coeff n)⁻¹ * P)
          (coeff_normalized_mem_differentialRatioField G P n))
      = scalarDifferentialPolynomialOrder P := by
  have hmap := scalarDifferentialPolynomialOrder_map
    (f := (IntermediateField.inclusion
      (characteristicDifferentialRatioField_le G hGclosed P n) :
      characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom)
    (IntermediateField.inclusion
      (characteristicDifferentialRatioField_le G hGclosed P n)).injective
    (HTGeometry.descendCoefficients
      (characteristicDifferentialRatioField_le G hGclosed P n)
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n))
  rw [HTGeometry.map_descendCoefficients] at hmap
  rw [← hmap, scalarDifferentialPolynomialOrder_C_mul (inv_ne_zero hn)]

/-- **The minimal rank over the ratio field is at most the characteristic's.** -/
theorem minimalRank_ratioField_le (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    {y : E} {P : DifferentialPolynomial Unit G}
    (hP : P ∈ differentialIntermediateRelationIdeal G y)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0)
    {Q : DifferentialPolynomial Unit (characteristicDifferentialRatioField G P n)}
    (hQ : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal (characteristicDifferentialRatioField G P n) y :
        Set _) Q)
    (hne : HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n) ≠ 0)
    (hvars : (MvPolynomial.vars (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n))).Nonempty) :
    scalarDifferentialPolynomialOrder Q ≤ scalarDifferentialPolynomialOrder P := by
  have hmem := descend_normalized_mem_relationIdeal G hGclosed P hP n
  have hle := (hQ.2.2.2 hmem hne hvars).1
  rwa [order_descend_normalized_eq G hGclosed P hn] at hle

/-- Normalizing does not change the leader degree. -/
theorem scalarDifferentialPolynomialLeaderDegree_C_mul {K : Type*} [Field K]
    {c : K} (hc : c ≠ 0) (P : DifferentialPolynomial Unit K) :
    scalarDifferentialPolynomialLeaderDegree (MvPolynomial.C c * P)
      = scalarDifferentialPolynomialLeaderDegree P := by
  rw [scalarDifferentialPolynomialLeaderDegree, scalarDifferentialPolynomialLeaderDegree,
    scalarDifferentialPolynomialLeader, scalarDifferentialPolynomialLeader,
    scalarDifferentialPolynomialOrder_C_mul hc]
  exact MvPolynomial.degreeOf_C_mul _ c (mem_nonZeroDivisors_of_ne_zero hc)

/-- **The descended normalized characteristic has the characteristic's leader degree.** -/
theorem leaderDegree_descend_normalized_eq (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) (P : DifferentialPolynomial Unit G)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0) :
    scalarDifferentialPolynomialLeaderDegree
        (HTGeometry.descendCoefficients
          (characteristicDifferentialRatioField_le G hGclosed P n)
          (MvPolynomial.C (P.coeff n)⁻¹ * P)
          (coeff_normalized_mem_differentialRatioField G P n))
      = scalarDifferentialPolynomialLeaderDegree P := by
  have hmap := scalarDifferentialPolynomialLeaderDegree_map
    (f := (IntermediateField.inclusion
      (characteristicDifferentialRatioField_le G hGclosed P n) :
      characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom)
    (IntermediateField.inclusion
      (characteristicDifferentialRatioField_le G hGclosed P n)).injective
    (HTGeometry.descendCoefficients
      (characteristicDifferentialRatioField_le G hGclosed P n)
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n))
  rw [HTGeometry.map_descendCoefficients] at hmap
  rw [← hmap, scalarDifferentialPolynomialLeaderDegree_C_mul (inv_ne_zero hn)]

/-- **Ritt's first equality.**  The minimal relation rank over the ratio field equals the minimal
relation rank over the whole intermediate field. -/
theorem minimalRank_ratioField_eq (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    {y : E} {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0)
    {Q : DifferentialPolynomial Unit (characteristicDifferentialRatioField G P n)}
    (hQmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal (characteristicDifferentialRatioField G P n) y :
        Set _) Q)
    (hne : HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n) ≠ 0)
    (hvars : (MvPolynomial.vars (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n))).Nonempty) :
    scalarDifferentialPolynomialOrder Q = scalarDifferentialPolynomialOrder P := by
  refine le_antisymm (minimalRank_ratioField_le G hGclosed hPmin.1 hn hQmin hne hvars) ?_
  exact minimalRank_le_of_le (characteristicDifferentialRatioField_le G hGclosed P n) y
    hQmin.1 hQmin.2.1 hQmin.2.2.1 hPmin

/-- Normalizing preserves the support. -/
theorem support_C_mul_eq {K σ : Type*} [Field K] {c : K} (hc : c ≠ 0) (P : MvPolynomial σ K) :
    (MvPolynomial.C c * P).support = P.support := by
  classical
  ext m
  simp [MvPolynomial.coeff_C_mul, MvPolynomial.mem_support_iff, hc]

/-- Normalizing preserves the total degree. -/
theorem totalDegree_C_mul_eq {K σ : Type*} [Field K] {c : K} (hc : c ≠ 0)
    (P : MvPolynomial σ K) : (MvPolynomial.C c * P).totalDegree = P.totalDegree := by
  rw [MvPolynomial.totalDegree, MvPolynomial.totalDegree, support_C_mul_eq hc]

/-- An injective coefficient map preserves the total degree. -/
theorem totalDegree_map_eq {K L σ : Type*} [CommRing K] [CommRing L] {f : K →+* L}
    (hf : Function.Injective f) (P : MvPolynomial σ K) :
    (MvPolynomial.map f P).totalDegree = P.totalDegree := by
  rw [MvPolynomial.totalDegree, MvPolynomial.totalDegree,
    MvPolynomial.support_map_of_injective _ hf]

/-- **Ritt's first equality, second coordinate.**  The minimal leader degree over the ratio field
equals the minimal leader degree over the whole intermediate field. -/
theorem minimalLeaderDegree_ratioField_eq (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) {y : E} {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0)
    {Q : DifferentialPolynomial Unit (characteristicDifferentialRatioField G P n)}
    (hQmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal (characteristicDifferentialRatioField G P n) y :
        Set _) Q)
    (hne : HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n) ≠ 0)
    (hvars : (MvPolynomial.vars (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n))).Nonempty) :
    scalarDifferentialPolynomialLeaderDegree Q
      = scalarDifferentialPolynomialLeaderDegree P := by
  classical
  set hle := characteristicDifferentialRatioField_le G hGclosed P n with hleDef
  have hinj : Function.Injective
      ((IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom) :=
    (IntermediateField.inclusion hle).injective
  have horder : scalarDifferentialPolynomialOrder Q = scalarDifferentialPolynomialOrder P :=
    minimalRank_ratioField_eq G hGclosed hPmin hn hQmin hne hvars
  -- the ratio-field minimum is at most the descended normalized characteristic
  have hmem := descend_normalized_mem_relationIdeal G hGclosed P hPmin.1 n
  have hforward := (hQmin.2.2.2 hmem hne hvars).2.1
  have hle1 : scalarDifferentialPolynomialLeaderDegree Q
      ≤ scalarDifferentialPolynomialLeaderDegree P := by
    rw [← leaderDegree_descend_normalized_eq G hGclosed P hn]
    refine hforward ?_
    rw [horder, order_descend_normalized_eq G hGclosed P hn]
  -- and the ambient minimum is at most the pushed-forward ratio-field minimum
  have hmapmem := mem_differentialIntermediateRelationIdeal_map hle y hQmin.1
  have hmapne : MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q ≠ 0 := by
    intro h0
    exact hQmin.2.1 (MvPolynomial.map_injective _ hinj (by simpa using h0))
  have hmapvars : (MvPolynomial.vars (MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q)).Nonempty := by
    rw [MvPolynomial.vars_map_of_injective _ hinj]
    exact hQmin.2.2.1
  have hback := (hPmin.2.2.2 hmapmem hmapne hmapvars).2.1
  have hle2 : scalarDifferentialPolynomialLeaderDegree P
      ≤ scalarDifferentialPolynomialLeaderDegree Q := by
    rw [← scalarDifferentialPolynomialLeaderDegree_map hinj Q]
    refine hback ?_
    rw [scalarDifferentialPolynomialOrder_map hinj Q, horder]
  exact le_antisymm hle1 hle2

/-- **Ritt's first equality, third coordinate.**  The minimal total degree over the ratio field equals
the minimal total degree over the whole intermediate field, so the two minimal relations have the same
rank in every coordinate. -/
theorem minimalTotalDegree_ratioField_eq (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) {y : E} {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0)
    {Q : DifferentialPolynomial Unit (characteristicDifferentialRatioField G P n)}
    (hQmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal (characteristicDifferentialRatioField G P n) y :
        Set _) Q)
    (hne : HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n) ≠ 0)
    (hvars : (MvPolynomial.vars (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n))).Nonempty) :
    Q.totalDegree = P.totalDegree := by
  classical
  set hle := characteristicDifferentialRatioField_le G hGclosed P n with hleDef
  have hinj : Function.Injective
      ((IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom) :=
    (IntermediateField.inclusion hle).injective
  have horder : scalarDifferentialPolynomialOrder Q = scalarDifferentialPolynomialOrder P :=
    minimalRank_ratioField_eq G hGclosed hPmin hn hQmin hne hvars
  have hleader : scalarDifferentialPolynomialLeaderDegree Q
      = scalarDifferentialPolynomialLeaderDegree P :=
    minimalLeaderDegree_ratioField_eq G hGclosed hPmin hn hQmin hne hvars
  have hdescTotal : (HTGeometry.descendCoefficients hle
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n)).totalDegree = P.totalDegree := by
    have hmap := totalDegree_map_eq hinj (HTGeometry.descendCoefficients hle
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n))
    rw [HTGeometry.map_descendCoefficients] at hmap
    rw [← hmap, totalDegree_C_mul_eq (inv_ne_zero hn)]
  have hmem := descend_normalized_mem_relationIdeal G hGclosed P hPmin.1 n
  have hle1 : Q.totalDegree ≤ P.totalDegree := by
    rw [← hdescTotal]
    refine (hQmin.2.2.2 hmem hne hvars).2.2 ?_ ?_
    · rw [horder, order_descend_normalized_eq G hGclosed P hn]
    · rw [hleader, leaderDegree_descend_normalized_eq G hGclosed P hn]
  have hmapmem := mem_differentialIntermediateRelationIdeal_map hle y hQmin.1
  have hmapne : MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q ≠ 0 := by
    intro h0
    exact hQmin.2.1 (MvPolynomial.map_injective _ hinj (by simpa using h0))
  have hmapvars : (MvPolynomial.vars (MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q)).Nonempty := by
    rw [MvPolynomial.vars_map_of_injective _ hinj]
    exact hQmin.2.2.1
  have hle2 : P.totalDegree ≤ Q.totalDegree := by
    rw [← totalDegree_map_eq hinj Q]
    refine (hPmin.2.2.2 hmapmem hmapne hmapvars).2.2 ?_ ?_
    · rw [scalarDifferentialPolynomialOrder_map hinj Q, horder]
    · rw [scalarDifferentialPolynomialLeaderDegree_map hinj Q, hleader]
  exact le_antisymm hle1 hle2

end

end GaloisForLFunctions
