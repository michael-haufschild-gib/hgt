import GaloisForLFunctions.HTGeometry.TranscendentalProfileJointHypertranscendence
import GaloisForLFunctions.HTGeometry.TranscendentalBaseExistence
import GaloisForLFunctions.HTGeometry.ConfinedExponentProfile
import GaloisForLFunctions.HTGeometry.BoundedRelationProfileRealization

/-!
# An entire source whose dilates are jointly hypertranscendental, for arbitrary dilations

The Taylor coefficients `t ^ e n` of a power profile decay superexponentially when `0 < t < 1` and
`e` grows at least quadratically, so the series is entire and has full Taylor support.  Choosing the
base transcendental over the field generated by the algebraic numbers and the prescribed dilations
makes the whole dilate family jointly hypertranscendental, with no arithmetic hypothesis on the
dilations themselves.
-/

open Filter PowerSeries

namespace GaloisForLFunctions

noncomputable section

/-- The entire carrier of a power profile with real base `x`. -/
def transcendentalProfileFunction (x : ℝ) (e : ℕ → ℕ) : ℂ → ℂ :=
  boundedRelationExponentialFunction (fun n => (e n : ℝ) * (-Real.log x)) (fun _ => 1)

/-- Superlinear growth of the log-magnitudes of a quadratic profile with a positive scale. -/
theorem transcendentalProfile_growth {e : ℕ → ℕ} (he : ∀ n, n * n ≤ e n)
    {θ : ℝ} (hθ : 0 < θ) :
    Tendsto (fun n : ℕ => ((e n : ℝ) * θ) / (n : ℝ)) atTop atTop := by
  have hmono : ∀ n : ℕ, 1 ≤ n → (n : ℝ) * θ ≤ ((e n : ℝ) * θ) / (n : ℝ) := by
    intro n hn
    have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
    rw [le_div_iff₀ hnpos]
    have hsq : ((n : ℝ) * (n : ℝ)) ≤ (e n : ℝ) := by exact_mod_cast he n
    nlinarith [hθ.le, hsq, hnpos]
  refine tendsto_atTop_mono' atTop ?_ (Filter.Tendsto.atTop_mul_const hθ tendsto_natCast_atTop_atTop)
  filter_upwards [eventually_ge_atTop 1] with n hn using hmono n hn

/-- The power-profile carrier is entire. -/
theorem contDiff_transcendentalProfileFunction {x : ℝ} (hx0 : 0 < x) (hx1 : x < 1)
    {e : ℕ → ℕ} (he : ∀ n, n * n ≤ e n) :
    ContDiff ℂ (⊤ : ℕ∞) (transcendentalProfileFunction x e) := by
  have hθ : 0 < -Real.log x := by
    have := Real.log_neg hx0 hx1
    linarith
  exact contDiff_boundedRelationExponentialFunction
    (transcendentalProfile_growth he hθ) (fun _ => norm_one)

/-- The power-profile carrier has exactly the prescribed powers as Taylor coefficients. -/
theorem taylorPS_transcendentalProfileFunction {x : ℝ} (hx0 : 0 < x) (hx1 : x < 1)
    {e : ℕ → ℕ} (he : ∀ n, n * n ≤ e n) (n : ℕ) :
    PowerSeries.coeff n (taylorPS (transcendentalProfileFunction x e)) = ((x : ℂ)) ^ (e n) := by
  have hθ : 0 < -Real.log x := by
    have := Real.log_neg hx0 hx1
    linarith
  rw [transcendentalProfileFunction,
    taylorPS_boundedRelationExponentialFunction (transcendentalProfile_growth he hθ)
      (fun _ => norm_one) n,
    boundedRelationExponentialCoeff, one_mul]
  have hexp : Real.exp ((e n : ℝ) * Real.log x) = x ^ (e n) := by
    rw [mul_comm, Real.exp_mul, Real.exp_log hx0, Real.rpow_natCast]
  rw [show (-((((e n : ℝ) * (-Real.log x)) : ℝ) : ℂ)) = (((e n : ℝ) * Real.log x : ℝ) : ℂ) by
    push_cast; ring, ← Complex.ofReal_exp, hexp]
  push_cast
  ring

/-- The power-profile carrier has full Taylor support. -/
theorem taylorPS_transcendentalProfileFunction_ne_zero {x : ℝ} (hx0 : 0 < x) (hx1 : x < 1)
    {e : ℕ → ℕ} (he : ∀ n, n * n ≤ e n) (n : ℕ) :
    PowerSeries.coeff n (taylorPS (transcendentalProfileFunction x e)) ≠ 0 := by
  rw [taylorPS_transcendentalProfileFunction hx0 hx1 he n]
  exact pow_ne_zero _ (by exact_mod_cast hx0.ne')

variable {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]

/-- **An entire source whose dilates are jointly hypertranscendental.**  For every finite family of
distinct nonzero complex dilations — with no arithmetic hypothesis whatsoever — there is an entire
function with full Taylor support such that no algebraic differential equation with complex
coefficients relates the point to the jets of all the dilates. -/
theorem exists_entire_dilates_jointlyHypertranscendental (q : ι → ℂ)
    (hq0 : ∀ i, q i ≠ 0) (hqinj : Function.Injective q) :
    ∃ F : ℂ → ℂ, ContDiff ℂ (⊤ : ℕ∞) F ∧
      (∀ n, PowerSeries.coeff n (taylorPS F) ≠ 0) ∧
      JointlyHypertranscendental (fun (i : ι) (z : ℂ) => F (q i * z)) := by
  obtain ⟨K, x, hx0, hx1, hKalg, hqK, htr⟩ :=
    exists_transcendental_base q (ε := 1) one_pos
  refine ⟨transcendentalProfileFunction x confinedProfile,
    contDiff_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile,
    taylorPS_transcendentalProfileFunction_ne_zero hx0 hx1 sq_le_confinedProfile, ?_⟩
  exact jointlyHypertranscendental_dilates_of_transcendentalProfile
    (contDiff_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile) q
    (taylorPS_transcendentalProfileFunction hx0 hx1 sq_le_confinedProfile)
    htr hKalg boundedRelationConfinement_confinedProfile hq0 hqinj hqK

end

end GaloisForLFunctions
