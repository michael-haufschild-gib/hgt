import GaloisForLFunctions.HTGeometry.FiniteModalHankelRank
import Mathlib.LinearAlgebra.Matrix.ToLinearEquiv
import Mathlib.LinearAlgebra.QuadraticForm.Signature

/-!
# Exact inertia of signed atomic moment matrices

A square Hankel block generated by `d` distinct real nodes is congruent, through its Vandermonde
matrix, to the diagonal matrix of its `d` atomic weights.  Thus its positive, negative, and null
indices count the signs of those weights exactly.
-/

open scoped BigOperators Matrix

namespace HTGeometry

noncomputable section

/-- A full signed atomic Hankel block at distinct real nodes is equivalent to the weighted
sum-of-squares form carried by its atomic weights. -/
theorem algebraicHankelMatrix_finiteModalSequence_equivalent_weightedSumSquares
    {d : ℕ} {weight node : Fin d → ℝ}
    (hnode : Function.Injective node) :
    QuadraticMap.Equivalent
      (algebraicHankelMatrix (finiteModalSequence weight node) d).toQuadraticForm'
      (QuadraticMap.weightedSumSquares ℝ weight) := by
  let V : Matrix (Fin d) (Fin d) ℝ := Matrix.vandermonde node
  have hdet : V.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr hnode
  have hunit : IsUnit V.det := (isUnit_iff_ne_zero).mpr hdet
  let e : (Fin d → ℝ) ≃ₗ[ℝ] (Fin d → ℝ) :=
    V.toLinearEquiv (Pi.basisFun ℝ (Fin d)) hunit
  refine ⟨{ toLinearEquiv := e
            map_app' := ?_ }⟩
  intro x
  rw [algebraicHankelMatrix_finiteModalSequence_eq_vandermonde]
  simp only [QuadraticMap.weightedSumSquares_apply, smul_eq_mul,
    Matrix.toQuadraticForm', LinearMap.BilinMap.toQuadraticMap_apply,
    Matrix.toLinearMap₂'_apply]
  have heapply : e x = V *ᵥ x := by
    change
      Matrix.toLin (Pi.basisFun ℝ (Fin d)) (Pi.basisFun ℝ (Fin d)) V x =
        V *ᵥ x
    rw [Matrix.toLin_eq_toLin', Matrix.toLin'_apply]
  change (∑ i, weight i * (e x i * e x i)) = _
  rw [heapply]
  simp [V, Matrix.mulVec, Matrix.mul_apply, Matrix.transpose_apply,
    Matrix.diagonal_apply, dotProduct, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro k _
  ring

/-- **Signed atomic moment inertia law, negative index.** -/
theorem sigNeg_algebraicHankelMatrix_finiteModalSequence
    {d : ℕ} {weight node : Fin d → ℝ}
    (hnode : Function.Injective node) :
    sigNeg
        (algebraicHankelMatrix (finiteModalSequence weight node) d).toQuadraticForm' =
      {i | weight i < 0}.ncard := by
  exact QuadraticForm.sigNeg_of_equiv_weightedSumSquares
    (algebraicHankelMatrix_finiteModalSequence_equivalent_weightedSumSquares hnode)

/-- **Signed atomic moment inertia law, positive index.** -/
theorem sigPos_algebraicHankelMatrix_finiteModalSequence
    {d : ℕ} {weight node : Fin d → ℝ}
    (hnode : Function.Injective node) :
    sigPos
        (algebraicHankelMatrix (finiteModalSequence weight node) d).toQuadraticForm' =
      {i | 0 < weight i}.ncard := by
  exact QuadraticForm.sigPos_of_equiv_weightedSumSquares
    (algebraicHankelMatrix_finiteModalSequence_equivalent_weightedSumSquares hnode)

/-- **Signed atomic moment inertia law, null index.** -/
theorem finrank_radical_algebraicHankelMatrix_finiteModalSequence
    {d : ℕ} {weight node : Fin d → ℝ}
    (hnode : Function.Injective node) :
    Module.finrank ℝ
        (algebraicHankelMatrix
          (finiteModalSequence weight node) d).toQuadraticForm'.radical =
      {i | weight i = 0}.ncard := by
  exact QuadraticForm.finrank_radical_of_equiv_weightedSumSquares
    (algebraicHankelMatrix_finiteModalSequence_equivalent_weightedSumSquares hnode)

end

end HTGeometry
