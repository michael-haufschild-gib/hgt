import Mathlib

/-!
# Geometric cones and replacement bases for signed stellar subdivision

Lotz (arXiv:2609.09335, Lemma 3.5 and Proposition 3.6) considers a basis
and an additional ray in linear general position. Unit-valued coordinates
parameterize exactly all such rays. Every replacement family is constructed
as an actual basis, and each associated cone is its genuine conic hull.
These cones are salient and closed and are exposed as proper cones for
existing duality interfaces.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open scoped BigOperators
open Module
variable {ι E : Type*} [Fintype ι] [DecidableEq ι]
  [AddCommGroup E] [Module ℝ E]

/-- Nonnegative coordinates form the standard pointed cone. -/
def lotzOrthant : PointedCone ℝ (ι → ℝ) where
  carrier := {v | ∀ i, 0 ≤ v i}
  zero_mem' := fun _ => le_refl 0
  add_mem' := fun hv hw i => add_nonneg (hv i) (hw i)
  smul_mem' := by
    intro c v hv i
    exact mul_nonneg c.property (hv i)

/-- The geometric positive cone generated by a basis. -/
def lotzBasisCone (b : Basis ι ℝ E) : PointedCone ℝ E :=
  lotzOrthant.comap b.equivFun.toLinearMap

omit [DecidableEq ι] in
theorem lotzBasisCone_mem (b : Basis ι ℝ E) (y : E) :
    y ∈ lotzBasisCone b ↔ ∀ i, 0 ≤ b.equivFun y i := Iff.rfl

/-- Basis cones agree with the actual conic hull, including its boundary and vertex. -/
theorem lotzBasisCone_eq_hull (b : Basis ι ℝ E) :
    lotzBasisCone b = PointedCone.hull ℝ (Set.range b) := by
  apply le_antisymm
  · intro y hy
    rw [← b.sum_equivFun y]
    apply Submodule.sum_mem
    intro i _
    exact PointedCone.smul_mem _ (hy i) (PointedCone.subset_hull (Set.mem_range_self i))
  · apply Submodule.span_le.mpr
    rintro y ⟨i,rfl⟩ j
    change 0 ≤ b.equivFun (b i) j
    rw [b.equivFun_self]
    split_ifs <;> simp

/-- The inverse-coordinate chart when the jth generator is replaced by a vector with unit coordinates. -/
def lotzStellarChart (a : ι → ℝˣ) (j : ι) : (ι → ℝ) ≃ₗ[ℝ] (ι → ℝ) where
  toFun v k := if k=j then v j/(a j : ℝ) else v k-v j/(a j : ℝ)*(a k : ℝ)
  invFun v k := (a k : ℝ)*v j+if k=j then 0 else v k
  map_add' v w := by
    funext k
    by_cases hk : k=j <;> simp only [Pi.add_apply, hk, if_true, if_false] <;> ring
  map_smul' c v := by
    funext k
    by_cases hk : k=j <;>
      simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, hk, if_true, if_false] <;> ring
  left_inv v := by
    funext k
    have hj := (a j).ne_zero
    by_cases hk : k=j
    · subst k
      simp only [if_true, add_zero]
      field_simp
    · simp only [hk, if_false, if_true]
      field_simp
      ring
  right_inv v := by
    funext k
    have hj := (a j).ne_zero
    by_cases hk : k=j
    · subst k
      simp only [if_true, add_zero]
      field_simp
    · simp only [hk, if_false, if_true, add_zero]
      field_simp
      ring

/-- The extra stellar ray has arbitrary nonzero coordinates in the original basis. -/
def lotzStellarRay (b : Basis ι ℝ E) (a : ι → ℝˣ) : E :=
  b.equivFun.symm (fun i => (a i : ℝ))

/-- Every replaced family is a basis, so linear general position is built into the construction. -/
def lotzStellarBasis (b : Basis ι ℝ E) (a : ι → ℝˣ) (j : ι) : Basis ι ℝ E :=
  Basis.ofEquivFun (b.equivFun.trans (lotzStellarChart a j))

theorem lotzStellarBasis_equivFun (b : Basis ι ℝ E) (a : ι → ℝˣ) (j : ι) (y : E) (k : ι) :
    (lotzStellarBasis b a j).equivFun y k =
      if k=j then b.equivFun y j/(a j : ℝ)
      else b.equivFun y k-b.equivFun y j/(a j : ℝ)*(a k : ℝ) := by
  rw [lotzStellarBasis, Basis.equivFun_ofEquivFun]
  rfl

theorem lotzStellarBasis_apply (b : Basis ι ℝ E) (a : ι → ℝˣ) (j k : ι) :
    lotzStellarBasis b a j k = if k=j then lotzStellarRay b a else b k := by
  apply b.equivFun.injective
  funext i
  have h := congrArg (fun v : ι → ℝ => (lotzStellarChart a j).symm v i)
    (funext ((lotzStellarBasis b a j).equivFun_self k))
  simp only [lotzStellarBasis, Basis.equivFun_ofEquivFun, LinearEquiv.trans_apply,
    LinearEquiv.symm_apply_apply] at h
  unfold lotzStellarBasis
  rw [h]
  change (a i : ℝ)*(if k=j then 1 else 0)+(if i=j then 0 else if k=i then 1 else 0) =
    b.equivFun (if k=j then lotzStellarRay b a else b k) i
  by_cases hk : k=j
  · subst k
    simp only [if_true,mul_one,lotzStellarRay,LinearEquiv.apply_symm_apply]
    by_cases hi : i=j
    · simp [hi]
    · simp [hi,Ne.symm hi]
  · simp only [hk,if_false,mul_zero,zero_add,Basis.equivFun_self]
    by_cases hi : i=j
    · subst i
      simp [hk]
    · simp [hi]

/-- Every replaced cone is exactly the conic hull of the replaced generator family. -/
theorem lotzStellarCone_eq_hull (b : Basis ι ℝ E) (a : ι → ℝˣ) (j : ι) :
    lotzBasisCone (lotzStellarBasis b a j) =
      PointedCone.hull ℝ (Set.range (fun k => if k=j then lotzStellarRay b a else b k)) := by
  rw [lotzBasisCone_eq_hull]
  congr 2
  funext k
  exact lotzStellarBasis_apply b a j k

omit [DecidableEq ι] in
/-- The ray parameters cover every vector in linear general position with the given basis. -/
theorem lotzStellarRay_range (b : Basis ι ℝ E) :
    Set.range (lotzStellarRay b) = {y | ∀ i, b.equivFun y i ≠ 0} := by
  ext y
  constructor
  · rintro ⟨a,rfl⟩ i
    simpa only [lotzStellarRay,LinearEquiv.apply_symm_apply] using (a i).ne_zero
  · intro hy
    refine ⟨fun i => Units.mk0 (b.equivFun y i) (hy i), ?_⟩
    apply b.equivFun.injective
    simp [lotzStellarRay]

omit [DecidableEq ι] in
/-- These cones are pointed in the geometric sense: they contain no nonzero line. -/
theorem lotzBasisCone_salient (b : Basis ι ℝ E) :
    (lotzBasisCone b : ConvexCone ℝ E).Salient := by
  intro y hy hne hneg
  apply hne
  apply b.equivFun.injective
  funext i
  have hp : 0 ≤ b.equivFun y i := hy i
  have hn : 0 ≤ b.equivFun (-y) i := hneg i
  simp only [map_neg,Pi.neg_apply] at hn
  simp only [map_zero,Pi.zero_apply]
  exact le_antisymm (neg_nonneg.mp hn) hp

section Topology
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]

omit [DecidableEq ι] in
/-- Each basis cone is closed in the ambient finite-dimensional topology. -/
theorem isClosed_lotzBasisCone (b : Basis ι ℝ F) : IsClosed (lotzBasisCone b : Set F) := by
  change IsClosed {y : F | ∀ i, 0 ≤ b.repr y i}
  simp only [Set.setOf_forall]
  exact isClosed_iInter fun i => isClosed_le continuous_const (b.coord i).continuous_of_finiteDimensional

/-- The cone is available directly to the corpus's proper-cone duality interfaces. -/
def lotzProperBasisCone (b : Basis ι ℝ F) : ProperCone ℝ F :=
  ⟨lotzBasisCone b,isClosed_lotzBasisCone b⟩

end Topology

end GaloisForLFunctions.HTGeometry
