import GaloisForLFunctions.HTGeometry.PointedLorentzSpinFactor
import GaloisForLFunctions.HTGeometry.QuaternionicWeakSpacetimeFracture
import Mathlib.Analysis.Quaternion

/-!
# Exact radial-orbit decomposition on the quaternionic four-carrier

This file joins two unconditional results:

* a nonzero quaternionic point selects a radial line and an orthogonal three-plane;
* that three-plane is exactly the infinitesimal left-unit-quaternion orbit.

No identification with the Standard Model Higgs, time, space, gravity, or causal signalling is
assumed.
-/

open scoped Quaternion RealInnerProductSpace

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Every infinitesimal left-unit-quaternion orbit direction is orthogonal to its base point. -/
theorem quaternionLeftOrbitDirection_orthogonal
    (q a : EventQuaternion)
    (ha : a ∈ eventQuaternionImaginary) :
    inner ℝ q (a * q) = 0 := by
  rw [mem_eventQuaternionImaginary_iff] at ha
  rw [Quaternion.inner_def, star_mul, ← mul_assoc, Quaternion.self_mul_star]
  simp [ha]

/-- Every vector orthogonal to a nonzero quaternion is generated by infinitesimal left
multiplication by an imaginary quaternion. -/
theorem pointedSpatial_exists_quaternionLeftOrbitDirection
    (q x : EventQuaternion)
    (hq : q ≠ 0)
    (hx : inner ℝ q x = 0) :
    ∃ a ∈ eventQuaternionImaginary, a * q = x := by
  let a : EventQuaternion := (Quaternion.normSq q)⁻¹ • (x * star q)
  have hnorm : Quaternion.normSq q ≠ 0 :=
    Quaternion.normSq_ne_zero.mpr hq
  have hxa : (x * star q).re = 0 := by
    rw [← Quaternion.inner_def]
    simpa [real_inner_comm] using hx
  have ha : a ∈ eventQuaternionImaginary := by
    rw [mem_eventQuaternionImaginary_iff]
    simp [a, hxa]
  refine ⟨a, ha, ?_⟩
  dsimp [a]
  rw [Algebra.smul_mul_assoc, mul_assoc, Quaternion.star_mul_self]
  rw [Algebra.smul_def]
  change
    (((Quaternion.normSq q)⁻¹ : ℝ) : EventQuaternion) *
        (x * ((Quaternion.normSq q : ℝ) : EventQuaternion)) = x
  rw [← mul_assoc, Quaternion.coe_commutes, mul_assoc, ← Quaternion.coe_mul,
    inv_mul_cancel₀ hnorm]
  simp

/-- The orthogonal three-plane at a nonzero quaternion is exactly its infinitesimal left orbit. -/
theorem pointedSpatial_iff_quaternionLeftOrbitDirection
    (q x : EventQuaternion)
    (hq : q ≠ 0) :
    inner ℝ q x = 0 ↔
      ∃ a ∈ eventQuaternionImaginary, a * q = x := by
  constructor
  · exact pointedSpatial_exists_quaternionLeftOrbitDirection q x hq
  · rintro ⟨a, ha, rfl⟩
    exact quaternionLeftOrbitDirection_orthogonal q a ha

/-- The pointed spatial component is exactly one infinitesimal left-unit-quaternion orbit
direction. -/
theorem pointedSpace_existsUnique_quaternionLeftOrbitDirection
    (q x : EventQuaternion)
    (hq : inner ℝ q q = 1) :
    ∃! a : eventQuaternionImaginary, a.1 * q = pointedSpace q x := by
  have hq0 : q ≠ 0 := ne_zero_of_inner_self_eq_one q hq
  have hspace : inner ℝ q (pointedSpace q x) = 0 :=
    inner_pointedSpace_eq_zero q x hq
  obtain ⟨a, ha, hax⟩ :=
    pointedSpatial_exists_quaternionLeftOrbitDirection q (pointedSpace q x) hq0 hspace
  refine ⟨⟨a, ha⟩, hax, ?_⟩
  intro b hb
  apply Subtype.ext
  exact mul_right_cancel₀ hq0 (hb.trans hax.symm)

/--
Every quaternion has a unique decomposition into its selected radial component and a weak-orbit
direction.
-/
theorem pointedTime_smul_add_unique_quaternionLeftOrbitDirection
    (q x : EventQuaternion)
    (hq : inner ℝ q q = 1) :
    ∃! a : eventQuaternionImaginary,
      pointedTime q x • q + a.1 * q = x := by
  obtain ⟨a, ha, huniq⟩ :=
    pointedSpace_existsUnique_quaternionLeftOrbitDirection q x hq
  refine ⟨a, ?_, ?_⟩
  · change pointedTime q x • q + a.1 * q = x
    rw [ha]
    exact pointedTime_smul_add_pointedSpace q x
  · intro b hb
    apply huniq
    apply add_left_cancel (a := pointedTime q x • q)
    exact hb.trans (pointedTime_smul_add_pointedSpace q x).symm

end GaloisForLFunctions.HTGeometry
