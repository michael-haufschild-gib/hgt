import GaloisForLFunctions.HTGeometry.JetAdjoinField
import GaloisForLFunctions.HTGeometry.DifferentialCharacteristicPseudoReduction

/-!
# A minimal relation closes the jet prefix field under the derivation

Differentiating a relation of order `m` produces a relation of order `m + 1` which is *linear* in
the new top jet, with the separant as its coefficient.  Since the separant of a minimal-rank
relation does not vanish at the element, the new jet is a rational expression in the old ones.

Consequently the field generated by the jets of order at most `m` is closed under the derivation,
and therefore contains the whole differential field generated by the element.
-/

namespace GaloisForLFunctions

open MvPolynomial

open scoped Differential

noncomputable section

/-- **Linearity of the derived relation in the fresh top jet.**  The total derivative of a
nonconstant scalar differential polynomial is its separant times the fresh jet, plus a polynomial
whose variables all have order at most the original order. -/
theorem exists_differentialPolynomialOverDerivation_separant_decomposition
    {K : Type*} [Field K] [Differential K] [CharZero K]
    (P : DifferentialPolynomial Unit K) :
    ∃ T : DifferentialPolynomial Unit K,
      (∀ q ∈ T.vars, q.2 ≤ scalarDifferentialPolynomialOrder P) ∧
        differentialPolynomialOverDerivation Unit K P =
          scalarDifferentialPolynomialSeparant P *
              MvPolynomial.X ((), scalarDifferentialPolynomialOrder P + 1) + T := by
  classical
  set m := scalarDifferentialPolynomialOrder P with hm
  set S := scalarDifferentialPolynomialSeparant P with hS
  set DP := differentialPolynomialOverDerivation Unit K P with hDP
  refine ⟨DP - S * MvPolynomial.X ((), m + 1), ?_, by ring⟩
  have hfresh : ((), m + 1) ∉ P.vars := by
    intro hmem
    have hle : (((), m + 1) : Unit × ℕ).2 ≤ scalarDifferentialPolynomialOrder P :=
      scalarDifferentialPolynomial_var_order_le hmem
    simp only at hle
    omega
  have hSfresh : ((), m + 1) ∉ S.vars := fun hmem =>
    hfresh (scalarDifferentialPolynomialSeparant_vars_subset P hmem)
  -- the fresh partial derivative of the derived relation is the separant
  have hpderiv : MvPolynomial.pderiv ((), m + 1) DP = S := by
    rw [hDP, pderiv_succ_differentialPolynomialOverDerivation,
      MvPolynomial.pderiv_eq_zero_of_notMem_vars hfresh, map_zero, zero_add, hS,
      scalarDifferentialPolynomialSeparant, scalarDifferentialPolynomialLeader]
  have hpderivMul : MvPolynomial.pderiv ((), m + 1) (S * MvPolynomial.X ((), m + 1)) = S := by
    rw [Derivation.leibniz]
    rw [MvPolynomial.pderiv_eq_zero_of_notMem_vars hSfresh, MvPolynomial.pderiv_X_self]
    simp
  have hzero : MvPolynomial.pderiv ((), m + 1) (DP - S * MvPolynomial.X ((), m + 1)) = 0 := by
    rw [map_sub, hpderiv, hpderivMul, sub_self]
  have hnotmem : ((), m + 1) ∉ (DP - S * MvPolynomial.X ((), m + 1)).vars := by
    intro hmem
    exact mvPolynomial_pderiv_ne_zero_of_mem_vars_charZero hmem hzero
  -- every variable of the difference has order at most `m + 1`, and the fresh one is excluded
  have hboundDP : ScalarJetOrderBound (m + 1) DP := by
    rw [hDP, hm]
    exact (scalarJetOrderBound_order P).derivation
  have hboundMul : ∀ q ∈ (S * MvPolynomial.X ((), m + 1)).vars, q.2 ≤ m + 1 := by
    intro q hq
    rcases Finset.mem_union.1 (MvPolynomial.vars_mul _ _ hq) with hqS | hqX
    · have hle : q.2 ≤ scalarDifferentialPolynomialOrder P :=
        scalarDifferentialPolynomial_var_order_le
          (scalarDifferentialPolynomialSeparant_vars_subset P hqS)
      omega
    · rw [MvPolynomial.vars_X, Finset.mem_singleton] at hqX
      subst hqX
      simp
  intro q hq
  have hqle : q.2 ≤ m + 1 := by
    rcases Finset.mem_union.1 (MvPolynomial.vars_sub_subset (R := K) _ hq) with hqD | hqM
    · by_contra hcon
      refine hboundDP q.2 (by omega) ?_
      have : q = ((), q.2) := Prod.ext (Subsingleton.elim _ _) rfl
      rwa [← this]
    · exact hboundMul q hqM
  have hqne : q ≠ ((), m + 1) := by
    intro h
    exact hnotmem (h ▸ hq)
  have hq2 : q.2 ≠ m + 1 := by
    intro h
    exact hqne (Prod.ext (Subsingleton.elim _ _) h)
  omega

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E] [CharZero E]

/-- **The fresh jet is rational in the old ones.**  For a minimal-rank relation of order `m` over a
derivation-closed coefficient field, the jet of order `m + 1` already lies in the field generated by
the jets of order at most `m`. -/
theorem differentialJet_succ_mem_jetAdjoin (B : IntermediateField F E) (hB : DerivationClosed B)
    {y : E} {P : DifferentialPolynomial Unit B}
    (hmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal B y : Set _) P) :
    differentialJet (scalarDifferentialPolynomialOrder P + 1) y ∈
      jetAdjoin B y (scalarDifferentialPolynomialOrder P + 1) := by
  classical
  letI : Differential B := derivationClosedDifferential B hB
  letI : DifferentialAlgebra B E := ⟨fun c ↦ derivationClosedDifferential_apply B hB c⟩
  set m := scalarDifferentialPolynomialOrder P with hm
  obtain ⟨T, hT, hdecomp⟩ :=
    exists_differentialPolynomialOverDerivation_separant_decomposition P
  have hderiv : differentialPolynomialOverDerivation Unit B P ∈
      differentialIntermediateRelationIdeal B y :=
    differentialPolynomialOverDerivation_mem_relationIdeal (fun _ : Unit ↦ y) hmin.1
  rw [mem_differentialIntermediateRelationIdeal_iff] at hderiv
  rw [hdecomp] at hderiv
  simp only [map_add, map_mul, differentialPolynomialEvalOver_X] at hderiv
  -- the separant does not vanish at `y`
  have hsep : differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y)
      (scalarDifferentialPolynomialSeparant P) ≠ 0 := by
    intro h
    exact hmin.separant_not_mem (differentialIntermediateRelationIdeal_ne_top B y)
      ((mem_differentialIntermediateRelationIdeal_iff B y _).2 h)
  have hsepMem : differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y)
      (scalarDifferentialPolynomialSeparant P) ∈ jetAdjoin B y (m + 1) := by
    refine differentialPolynomialEvalOver_mem_jetAdjoin B y ?_
    intro q hq
    have hle : q.2 ≤ scalarDifferentialPolynomialOrder P :=
      scalarDifferentialPolynomial_var_order_le
        (scalarDifferentialPolynomialSeparant_vars_subset P hq)
    omega
  have hTMem : differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y) T ∈
      jetAdjoin B y (m + 1) := by
    refine differentialPolynomialEvalOver_mem_jetAdjoin B y ?_
    intro q hq
    have := hT q hq
    omega
  have hjet : differentialJet (m + 1) y =
      - differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y) T /
        differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y)
          (scalarDifferentialPolynomialSeparant P) := by
    rw [eq_div_iff hsep]
    linear_combination hderiv
  rw [hjet]
  exact IntermediateField.div_mem _ (IntermediateField.neg_mem _ hTMem) hsepMem

/-- **The jet prefix field is derivation-closed.**  Over a derivation-closed coefficient field, the
field generated by the jets up to the order of a minimal-rank relation is stable under the ambient
derivation. -/
theorem derivationClosed_jetAdjoin (B : IntermediateField F E) (hB : DerivationClosed B)
    {y : E} {P : DifferentialPolynomial Unit B}
    (hmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal B y : Set _) P) :
    DerivationClosed (jetAdjoin B y (scalarDifferentialPolynomialOrder P + 1)) := by
  classical
  letI : Differential B := derivationClosedDifferential B hB
  letI : DifferentialAlgebra B E := ⟨fun c ↦ derivationClosedDifferential_apply B hB c⟩
  set m := scalarDifferentialPolynomialOrder P with hm
  intro x hx
  apply IntermediateField.adjoin_induction (↥B)
    (s := Set.range fun i : Fin (m + 1) => differentialJet i y)
    (p := fun z _ => z′ ∈ jetAdjoin B y (m + 1))
  · rintro _ ⟨i, rfl⟩
    rw [← differentialJet_succ]
    rcases lt_or_eq_of_le (Nat.lt_succ_iff.1 i.2) with hlt | heq
    · exact differentialJet_mem_jetAdjoin B y (by omega)
    · rw [heq]
      exact differentialJet_succ_mem_jetAdjoin B hB hmin
  · intro c
    rw [deriv_algebraMap]
    exact (jetAdjoinOver B y (m + 1)).algebraMap_mem _
  · intro a b _ _ hda hdb
    rw [map_add]
    exact IntermediateField.add_mem _ hda hdb
  · intro a ha hda
    rw [Derivation.leibniz_inv]
    have hainv : a⁻¹ ∈ jetAdjoin B y (m + 1) := IntermediateField.inv_mem _ ha
    have hasq : a⁻¹ ^ (2 : ℕ) ∈ jetAdjoin B y (m + 1) := by
      simpa [pow_two] using IntermediateField.mul_mem _ hainv hainv
    exact IntermediateField.mul_mem _ (IntermediateField.neg_mem _ hasq) hda
  · intro a b ha hb hda hdb
    rw [Derivation.leibniz]
    exact IntermediateField.add_mem _
      (IntermediateField.mul_mem _ ha hdb) (IntermediateField.mul_mem _ hb hda)
  exact hx

/-- **The differential field generated by the element sits inside a finite jet prefix field.**  A
minimal-rank relation of order `m` over a derivation-closed field forces every jet of `y` into the
field generated by the jets of order at most `m`. -/
theorem differentialAdjoin_le_jetAdjoin (B : IntermediateField F E) (hB : DerivationClosed B)
    {y : E} {P : DifferentialPolynomial Unit B}
    (hmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal B y : Set _) P) :
    differentialAdjoin F ({y} : Set E) ≤
      jetAdjoin B y (scalarDifferentialPolynomialOrder P + 1) := by
  refine differentialAdjoin_le F ?_ (derivationClosed_jetAdjoin B hB hmin)
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  simpa using differentialJet_mem_jetAdjoin B x
    (i := 0) (m := scalarDifferentialPolynomialOrder P + 1) (Nat.succ_pos _)

end

end GaloisForLFunctions
