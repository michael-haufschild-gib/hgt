import GaloisForLFunctions.HTGeometry.Quantum.GaussianPath.CircuitCellAverage
import GaloisForLFunctions.HTGeometry.Quantum.CircuitSynthesis.LocalPatches.PauliTerm
import GaloisForLFunctions.HTGeometry.SpectralObservedOrbitDimension

/-! # Single-gate implementation of a centered physical observable in the energy basis -/
open Matrix NormedSpace
open scoped Matrix.Norms.L2Operator
namespace GaloisForLFunctions.HTGeometry.FirstGate
noncomputable section
private abbrev Reg (N : ℕ) := Matrix (Fin N → Bool) (Fin N → Bool) ℂ

/-- Every rotation generated by a physical path Pauli has a one-gate realization. -/
theorem pauli_rotation_word {n : ℕ} (l : PathLabel n) (t : ℝ) :
    ∃ z : ℂ, ‖z‖=1 ∧ ∃ C : TwoQubitCircuit (n+2), C.gateCount=1 ∧
      unitaryEvolution (finitePauliMatrix (pathWord l)) t=z • (C.eval : Reg (n+2)) := by
  let u : PathShell n := WithLp.toLp 2 (fun _ => (1:ℝ))
  obtain ⟨z,hz,C,hC,he⟩ := (LocalPatches.pathTerm_properties u l).2.2 t
  exact ⟨z,hz,C,hC,by simpa only [LocalPatches.pathTermGenerator,u,WithLp.ofLp_toLp,Complex.ofReal_one,
    one_smul,unitaryEvolution] using he⟩

/-- Centering a Hermitian generator changes only the common phase of its
rotation when the energy basis is conjugated back to the register. -/
theorem centered_eigenbasis_rotation {N : ℕ} (V : Reg N) (hV : V ∈ unitary (Reg N))
    (P : selfAdjoint (Reg N)) (q s t : ℝ) :
    let B := star V*P.val*V
    let A := (s:ℂ) • (B-(q:ℂ) • 1)
    ∃ z : ℂ, ‖z‖=1 ∧ V*exp (t • (Complex.I • A))*star V=z • unitaryEvolution P.val (-t*s) := by
  intro B A
  let Q := P.val-(q:ℂ) • (1:Reg N)
  have hv := Unitary.mem_iff.mp hV
  have hcenter : V*(B-(q:ℂ) • 1)*star V=Q := by
    dsimp only [B,Q]
    rw [Matrix.mul_sub,Matrix.sub_mul,Matrix.mul_smul,Matrix.mul_one,Matrix.smul_mul,hv.2]
    congr 1
    simp only [mul_assoc,hv.2,mul_one]
    rw [←mul_assoc,hv.2,one_mul]
  have htime : exp (t • (Complex.I • A))=unitaryEvolution (B-(q:ℂ) • 1) (-t*s) := by
    unfold unitaryEvolution
    dsimp only [A]
    rw [←Complex.coe_smul t,←Complex.coe_smul (-t*s)]
    simp only [smul_smul]
    congr 2
    push_cast
    ring
  have hu : IsUnit V := ⟨⟨V,star V,hv.2,hv.1⟩,rfl⟩
  have conjFlow := unitaryEvolution_conj V (B-(q:ℂ) • 1) hu (-t*s)
  rw [inv_eq_star_of_mem_unitary hV,hcenter] at conjFlow
  rw [htime,←conjFlow]
  let u := -t*s
  let z := Complex.exp (((-(u*q):ℝ):ℂ)*Complex.I)
  have hz : ‖z‖=1 := by simp [z,Complex.norm_exp]
  refine ⟨z⁻¹,by rw [norm_inv,hz,inv_one],?_⟩
  have he := unitaryEvolution_eq_phase_smul_scalarCentered P q u
  change unitaryEvolution P.val u=z • unitaryEvolution Q u at he
  change unitaryEvolution Q u=z⁻¹ • unitaryEvolution P.val u
  rw [he,smul_smul,inv_mul_cancel₀ (Complex.exp_ne_zero _),one_smul]

/-- A centered physical Pauli rotation in the energy basis costs one gate up
to a scalar phase. -/
theorem centered_eigenbasis_word {n : ℕ} (V : Reg (n+2)) (hV : V ∈ unitary (Reg (n+2)))
    (l : PathLabel n) (q s t : ℝ) :
    let B := star V*finitePauliMatrix (pathWord l)*V
    let A := (s:ℂ) • (B-(q:ℂ) • 1)
    ∃ z : ℂ, ‖z‖=1 ∧ ∃ C : TwoQubitCircuit (n+2), C.gateCount=1 ∧
      V*exp (t • (Complex.I • A))*star V=z • (C.eval : Reg (n+2)) := by
  let P : selfAdjoint (Reg (n+2)) := ⟨_,finitePauliMatrix_isHermitian (pathWord l)⟩
  obtain ⟨w,hw,hr⟩ := centered_eigenbasis_rotation V hV P q s t
  obtain ⟨z,hz,C,hC,he⟩ := pauli_rotation_word l (-t*s)
  exact ⟨w*z,by rw [norm_mul,hw,hz,mul_one],C,hC,hr.trans (by rw [←smul_smul,←he])⟩

#print axioms centered_eigenbasis_word
end
end GaloisForLFunctions.HTGeometry.FirstGate
