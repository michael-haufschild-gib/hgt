import GaloisForLFunctions.HTGeometry.Quantum.GaussianPath.SpectralJets.SelectedDates.RelativeMultiplicity.PrincipalMinor
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonAllRankQSystem
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-! # Phase-field transcendence degree bounds the relative rank -/

open Matrix Set
namespace GaloisForLFunctions.HTGeometry.SpectralJets.SelectedDates.RelativeMultiplicity
noncomputable section

/-- The field generated by the diagonal readings has transcendence degree
at most the rank remaining after subtracting any matrix over the base.
Select a transcendence basis from the readings themselves and retain its
principal submatrix. -/
theorem field_rank {F L I : Type} [Field F] [Field L] [Algebra F L] [Fintype I] [DecidableEq I]
    (p : I → L) (W : Matrix I I F) :
    Algebra.trdeg F (IntermediateField.adjoin F (range p))
      ≤ (diagonal p - (algebraMap F L).mapMatrix W).rank := by
  classical
  let A := IntermediateField.adjoin F (range p)
  let y (i : I) : A := ⟨p i,IntermediateField.subset_adjoin F _ (mem_range_self i)⟩
  have htop : IntermediateField.adjoin F (range y)=⊤ := adjoin_range_lift_eq_top p p rfl
  letI : Algebra.IsAlgebraic (Algebra.adjoin F (range y)) A :=
    isAlgebraic_adjoin_of_intermediate_adjoin_eq_top y htop
  obtain ⟨S,hS,hb⟩ := exists_isTranscendenceBasis_subset (R:=F) (range y)
  letI := ((Set.finite_range y).subset hS).fintype
  choose j hj using fun x : S => hS x.property
  have hinj : Function.Injective j := by
    intro x x' hh
    exact Subtype.ext ((hj x).symm.trans ((congrArg y hh).trans (hj x')))
  let e : S ↪ I := ⟨j,hinj⟩
  have hread : p ∘ e=A.val ∘ (Subtype.val : S → A) := by
    funext x
    exact congrArg Subtype.val (hj x)
  have hind : AlgebraicIndependent F (p ∘ e) := hread ▸ hb.1.map' (f:=A.val) Subtype.val_injective
  have hr := independent_diagonal_rank e p hind W
  rw [←hb.cardinalMk_eq_trdeg,Cardinal.mk_fintype]
  exact_mod_cast hr

#print axioms field_rank
end
end GaloisForLFunctions.HTGeometry.SpectralJets.SelectedDates.RelativeMultiplicity
