import GaloisForLFunctions.HTGeometry.Quantum.GaussianPath.SpectralJets.SelectedDates.AlgebraicTimes.PolynomialPhases
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-! # Phase independence over the field generated by the sampled coefficients -/

open MvPolynomial Set Filter MeasureTheory
namespace GaloisForLFunctions.HTGeometry.SpectralJets.SelectedDates.AlgebraicTimes
noncomputable section

abbrev complexParameterField {m : ℕ} (x : Fin m → ℝ) :=
  IntermediateField.adjoin ℚ (range fun i => (x i:ℂ))

private theorem eval_complex_parameters {m : ℕ} (x : Fin m → ℝ) :
    complexParameterEval x=(MvPolynomial.aeval (R:=ℚ) (fun i => (x i:ℂ))).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro r; simp [complexParameterEval,parameterEval]
  · intro i; simp [complexParameterEval,parameterEval]

/-- Clear denominators in all coefficients simultaneously, retaining
one scalar which is nonzero at the actual parameter vector. -/
private theorem clear_phase_denominators {m : ℕ} {I : Type*} (x : Fin m → ℝ)
    (p : MvPolynomial I (complexParameterField x)) :
    let φ := complexParameterEval x
    ∃ d : Parameters m, φ d≠0 ∧ ∃ q : MvPolynomial I (Parameters m),
      map φ q=C (φ d)*map (complexParameterField x).subtype p := by
  intro φ
  induction p using MvPolynomial.induction_on with
  | C c =>
    by_cases hc : c=0
    · subst c
      exact ⟨1,by simp,0,by simp⟩
    obtain ⟨a,b,hc'⟩ := (IntermediateField.mem_adjoin_range_iff ℚ _ _).mp c.property
    change (c:ℂ)=MvPolynomial.aeval (fun i => (x i:ℂ)) a / MvPolynomial.aeval (fun i => (x i:ℂ)) b at hc'
    have hcval : (c:ℂ)=φ a/φ b := by simpa only [φ,eval_complex_parameters,AlgHom.toRingHom_eq_coe, RingHom.coe_coe] using hc'
    have hb : φ b≠0 := by
      intro h
      exact hc (Subtype.ext (hcval.trans (by rw [h,div_zero])))
    refine ⟨b,hb,C a,?_⟩
    rw [map_C,map_C,←map_mul]
    exact congrArg C (((eq_div_iff hb).mp hcval).symm.trans (mul_comm ..))
  | add p q hp hq =>
    obtain ⟨a,ha,P,hP⟩ := hp
    obtain ⟨b,hb,Q,hQ⟩ := hq
    refine ⟨a*b,by rw [map_mul]; exact mul_ne_zero ha hb,C b*P+C a*Q,?_⟩
    simp only [map_add,map_mul,map_C,hP,hQ]
    ring
  | mul_X p i hp =>
    obtain ⟨a,ha,P,hP⟩ := hp
    exact ⟨a,ha,P*X i,by simp only [map_mul,map_X,hP,mul_assoc]⟩

theorem independent_of_parameter_polynomials {m : ℕ} {I : Type*} (x : Fin m → ℝ) (z : I → ℂ)
    (h : ∀ p : MvPolynomial I (Parameters m), (∃ j∈p.support, complexParameterEval x (p.coeff j)≠0) →
      MvPolynomial.eval₂ (complexParameterEval x) z p≠0) : AlgebraicIndependent (complexParameterField x) z := by
  classical
  let F := complexParameterField x
  let φ := complexParameterEval x
  apply algebraicIndependent_iff.mpr
  intro p hzero
  by_contra hp
  obtain ⟨d,hd,q,hq⟩ := clear_phase_denominators x p
  have hmap : map F.subtype p≠0 := (MvPolynomial.map_injective F.subtype Subtype.val_injective).ne
    (show p≠0 from hp) |>.trans_eq (map_zero _)
  have hQ : map φ q≠0 := hq.trans_ne (mul_ne_zero (MvPolynomial.C_ne_zero.mpr hd) hmap)
  have hcoeff : ∃ j∈q.support, φ (q.coeff j)≠0 := by
    by_contra! hz
    apply hQ
    ext j
    by_cases hj : j∈q.support
    · simpa only [coeff_map,coeff_zero] using hz j hj
    · rw [coeff_map,notMem_support_iff.mp hj,map_zero,coeff_zero]
  apply h q hcoeff
  have heq := congrArg (MvPolynomial.eval z) hq
  simp only [eval_map,map_mul,eval_C] at heq
  rw [heq]
  change φ d*MvPolynomial.aeval z p=0
  rw [hzero,mul_zero]

#print axioms independent_of_parameter_polynomials
end
end GaloisForLFunctions.HTGeometry.SpectralJets.SelectedDates.AlgebraicTimes
