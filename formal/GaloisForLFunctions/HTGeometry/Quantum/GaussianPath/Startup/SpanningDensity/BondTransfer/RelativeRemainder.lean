import GaloisForLFunctions.HTGeometry.Quantum.CircuitSynthesis.LocalPatches.InteractionPicture

/-! # First-order transfer with an error proportional to the erased interaction -/

open NormedSpace
namespace GaloisForLFunctions.HTGeometry.SpanningDensity.BondTransfer
open LocalPatches
noncomputable section
variable {A : Type*} [CStarAlgebra A]
local instance : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A

/-- Heisenberg evolution generated by a skew-adjoint element. -/
def transported (a : A) (s : ℝ) (x : A) := exp (s • (-a))*x*exp (s • a)

private theorem transported_norm (a : A) (ha : a∈skewAdjoint A) (s : ℝ) (x : A) :
    ‖transported a s x‖=‖x‖ := by
  rw [transported,CStarRing.norm_mul_mem_unitary _
    (exp_mem_unitary_of_mem_skewAdjoint (skewAdjoint.smul_mem s ha)),
    CStarRing.norm_mem_unitary_mul _
      (exp_mem_unitary_of_mem_skewAdjoint (skewAdjoint.smul_mem s ((skewAdjoint A).neg_mem ha)))]

private theorem transport_deriv (a x : A) (s : ℝ) :
    HasDerivAt (fun r => transported a r x) (transported a s (bracketStep a x)) s := by
  have h := ((hasDerivAt_exp_smul_const (-a) s).mul_const x).fun_mul (hasDerivAt_exp_smul_const' a s)
  change HasDerivAt (fun r : ℝ => exp (r • (-a))*x*exp (r • a))
    (exp (s • (-a))*(x*a-a*x)*exp (s • a)) s
  convert h using 1
  noncomm_ring

private theorem drift (a x : A) (ha : a∈skewAdjoint A) (s : ℝ) (hs : 0≤s) :
    ‖transported a s x-x‖≤‖bracketStep a x‖*s := by
  have h := norm_image_sub_le_of_norm_deriv_le_segment' (a:=0) (b:=s)
    (fun r _ => (transport_deriv a x r).hasDerivWithinAt)
    (fun r _ => (transported_norm a ha r (bracketStep a x)).le) s ⟨hs,le_rfl⟩
  simpa only [transported,zero_smul,exp_zero,one_mul,mul_one,sub_zero] using h

/-- In the difference of the full and erased evolutions, the linear term
is the commutator with the erased interaction j. The remainder uses only
commutators incident on x or its first transfer. -/
theorem relative_remainder (a j x : A) (ha : a∈skewAdjoint A) (hj : j∈skewAdjoint A)
    (t : ℝ) (ht : 0≤t) :
    ‖transported (a+j) t x-transported a t x-t • bracketStep j x‖ ≤
      t^2*(2*‖j‖*‖bracketStep a x‖+‖bracketStep (a+j) (bracketStep j x)‖) := by
  let b := a+j
  let p := bracketStep j x
  have hb : b∈skewAdjoint A := (skewAdjoint A).add_mem ha hj
  let X := fun s => transported a s x
  let F := fun s => transported b (t-s) (X s) + s • p
  let G := fun s => p-transported b (t-s) (bracketStep j (X s))
  have reverse_left (s : ℝ) : HasDerivAt (fun r : ℝ => exp ((t-r) • (-b)))
      (exp ((t-s) • (-b))*b) s := by
    simpa [Function.comp_def] using (hasDerivAt_exp_smul_const (-b) (t-s)).scomp s
      ((hasDerivAt_const s t).sub (hasDerivAt_id s))
  have reverse_right (s : ℝ) : HasDerivAt (fun r : ℝ => exp ((t-r) • b))
      (-(b*exp ((t-s) • b))) s := by
    simpa [Function.comp_def] using (hasDerivAt_exp_smul_const' b (t-s)).scomp s
      ((hasDerivAt_const s t).sub (hasDerivAt_id s))
  have hd (s : ℝ) : HasDerivAt F (G s) s := by
    have dh : HasDerivAt X (bracketStep a (X s)) s := by
      have h := ((hasDerivAt_exp_smul_const' (-a) s).mul_const x).fun_mul (hasDerivAt_exp_smul_const a s)
      change HasDerivAt (fun r : ℝ => exp (r • (-a))*x*exp (r • a))
        ((exp (s • (-a))*x*exp (s • a))*a-a*(exp (s • (-a))*x*exp (s • a))) s
      convert h using 1
      noncomm_ring
    have linear : HasDerivAt (fun r : ℝ => r • p) p s := by
      simpa only [id_eq,one_smul] using (hasDerivAt_id s).smul_const p
    have h := (((reverse_left s).fun_mul dh).fun_mul (reverse_right s)).add linear
    have h' : HasDerivAt F _ s := h
    convert h' using 1
    dsimp only [G,transported,bracketStep,b]
    noncomm_ring
  have bound (s : ℝ) (hs : s∈Set.Ico 0 t) :
      ‖G s‖≤(2*‖j‖*‖bracketStep a x‖+‖bracketStep b p‖)*t := by
    have hn := drift b p hb (t-s) (sub_nonneg.mpr hs.2.le)
    have hx := drift a x ha s hs.1
    change ‖X s-x‖≤‖bracketStep a x‖*s at hx
    have hsub : transported b (t-s) p-transported b (t-s) (bracketStep j (X s)) =
        transported b (t-s) (bracketStep j (x-X s)) := by
      dsimp only [transported,bracketStep,p]
      noncomm_ring
    have hcomm : ‖bracketStep j (x-X s)‖≤2*‖j‖*‖bracketStep a x‖*s := by
      change ‖(x-X s)*j-j*(x-X s)‖≤_
      apply ((norm_sub_le _ _).trans (add_le_add (norm_mul_le _ _) (norm_mul_le _ _))).trans
      rw [norm_sub_rev x]
      nlinarith only [mul_le_mul_of_nonneg_left hx (norm_nonneg j)]
    change ‖p-transported b (t-s) (bracketStep j (X s))‖≤_
    apply (norm_sub_le_norm_sub_add_norm_sub p (transported b (t-s) p) _).trans
    rw [norm_sub_rev p,hsub,transported_norm b hb]
    have h₁ := hn.trans (mul_le_mul_of_nonneg_left (sub_le_self t hs.1) (norm_nonneg _))
    have h₂ := hcomm.trans (mul_le_mul_of_nonneg_left hs.2.le (by positivity))
    linarith only [h₁,h₂]
  have h := norm_image_sub_le_of_norm_deriv_le_segment'
    (a:=0) (b:=t) (fun s _ => (hd s).hasDerivWithinAt) bound t ⟨ht,le_rfl⟩
  simp only [F,sub_self,sub_zero,X,transported,zero_smul,exp_zero,one_mul,mul_one,add_zero] at h
  rw [show transported (a+j) t x-transported a t x-t • bracketStep j x =
      -(transported a t x+t • p-transported b t x) by dsimp only [b,p]; abel,norm_neg]
  exact h.trans_eq (by ring)

#print axioms relative_remainder
end
end GaloisForLFunctions.HTGeometry.SpanningDensity.BondTransfer
