import GaloisForLFunctions.HTGeometry.Quantum.CircuitSynthesis.PauliRotations
import GaloisForLFunctions.HTGeometry.AnticommutingPauliObserverRankDominance
import GaloisForLFunctions.HTGeometry.PauliProductLaw
import GaloisForLFunctions.HTGeometry.ScalarSquareExponential
import Mathlib.Analysis.SpecialFunctions.Complex.Arg

/-!
# Exact circuits for anticommuting Pauli Hamiltonians

A rotation generated by the product of two anticommuting Pauli words
eliminates one coefficient. It fixes every word anticommuting with both.
Successive eliminations reduce evolution to a single Pauli rotation,
with gate count independent of time and of the coefficients.
-/

open Matrix NormedSpace
open scoped BigOperators Matrix.Norms.L2Operator

namespace GaloisForLFunctions.HTGeometry

noncomputable section

private abbrev Reg (n : ℕ) := Matrix (Fin n → Bool) (Fin n → Bool) ℂ
private abbrev Word (n : ℕ) := Fin n → Option (Fin 3)

private theorem skew_product_exponential {n : ℕ} {X : Reg n} (hX : X * X = -1) (θ : ℝ) :
    exp ((θ : ℂ) • X) = (Real.cos θ : ℂ) • (1 : Reg n) + (Real.sin θ : ℂ) • X := by
  have hsq : ((θ : ℂ) • X) * ((θ : ℂ) • X) = (-((θ : ℂ) ^ 2)) • (1 : Reg n) := by
    rw [smul_mul_smul_comm, hX, smul_neg, ← neg_smul, pow_two]
  rw [_root_.HTGeometry.exp_of_mul_self_eq_neg_sq_smul_one _ θ hsq, smul_smul]
  have hsin : Real.sinc θ * θ = Real.sin θ := by
    by_cases h : θ = 0
    · simp only [h, mul_zero, Real.sin_zero]
    · rw [Real.sinc_of_ne_zero h, div_mul_cancel₀ _ h]
  rw [← Complex.ofReal_mul, hsin]

private theorem plane_coefficients (a b : ℝ) :
    ∃ r θ : ℝ, 0 ≤ r ∧
      Real.cos θ * a + Real.sin θ * b = r * Real.cos θ ∧
      Real.cos θ * b - Real.sin θ * a = r * Real.sin θ := by
  let z : ℂ := ⟨a, b⟩
  let θ := z.arg / 2
  have hθ : 2 * θ = z.arg := by unfold θ; ring
  have hunit := Real.sin_sq_add_cos_sq θ
  have hc : Real.cos θ ^ 2 - Real.sin θ ^ 2 = Real.cos (2 * θ) := by
    rw [Real.cos_two_mul]
    linarith only [hunit]
  have ha : ‖z‖ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) = a := by
    rw [hc, hθ]
    exact Complex.norm_mul_cos_arg z
  have hb : ‖z‖ * (2 * Real.sin θ * Real.cos θ) = b := by
    rw [← Real.sin_two_mul, hθ]
    exact Complex.norm_mul_sin_arg z
  refine ⟨‖z‖, θ, norm_nonneg _, ?_, ?_⟩
  · rw [← ha, ← hb]
    linear_combination (‖z‖ * Real.cos θ) * hunit
  · rw [← ha, ← hb]
    linear_combination (‖z‖ * Real.sin θ) * hunit

/-- The exponential of the skew product of two anticommuting
involutions rotates their real linear combination onto the first axis. -/
theorem exists_exp_plane_alignment {n : ℕ} (A B : Reg n) (hA : A * A = 1) (hB : B * B = 1)
    (hanti : A * B = -(B * A)) (a b : ℝ) :
    ∃ r θ : ℝ, 0 ≤ r ∧ exp ((θ : ℂ) • (A * B)) * ((a : ℂ) • A + (b : ℂ) • B) =
      ((r : ℂ) • A) * exp ((θ : ℂ) • (A * B)) := by
  obtain ⟨r, θ, hr, ha, hb⟩ := plane_coefficients a b
  have hAX : A * (A * B) = B := by rw [← mul_assoc, hA, one_mul]
  have hXA : (A * B) * A = -B := by rw [hanti, neg_mul, mul_assoc, hA, mul_one]
  have hXB : (A * B) * B = A := by rw [mul_assoc, hB, mul_one]
  have hX : (A * B) * (A * B) = -1 := by rw [← mul_assoc, hXA, neg_mul, hB]
  refine ⟨r, θ, hr, ?_⟩
  rw [skew_product_exponential hX]
  let c : ℂ := Real.cos θ
  let s : ℂ := Real.sin θ
  have hca : c * (a : ℂ) + s * (b : ℂ) = (r : ℂ) * c := by
    dsimp only [c, s]
    exact_mod_cast ha
  have hcb : c * (b : ℂ) - s * (a : ℂ) = (r : ℂ) * s := by
    dsimp only [c, s]
    exact_mod_cast hb
  change (c • (1 : Reg n) + s • (A * B)) * ((a : ℂ) • A + (b : ℂ) • B) =
    ((r : ℂ) • A) * (c • (1 : Reg n) + s • (A * B))
  calc
    _ = (c * (a : ℂ) + s * (b : ℂ)) • A + (c * (b : ℂ) - s * (a : ℂ)) • B := by
      simp only [add_mul, mul_add, smul_mul_smul_comm, one_mul, hXA, hXB, smul_neg,
        add_smul, sub_smul]
      abel
    _ = _ := by
      rw [hca, hcb]
      simp only [mul_add, smul_mul_smul_comm, mul_one, hAX]

/-- The rotation axis of an anticommuting Pauli pair is one fixed Pauli
word, with one real rescaling valid for every angle. -/
theorem exists_pauli_product_rotation_axis {n : ℕ} (P Q : Word n)
    (hanti : finitePauliMatrix P * finitePauliMatrix Q = -(finitePauliMatrix Q * finitePauliMatrix P)) :
    ∃ (R : Word n) (c : ℝ), (∀ θ : ℝ,
      exp ((θ : ℂ) • (finitePauliMatrix P * finitePauliMatrix Q)) =
        unitaryEvolution (finitePauliMatrix R) (c * θ)) ∧
      ∀ M : Reg n, Commute M (finitePauliMatrix P * finitePauliMatrix Q) →
        Commute M (finitePauliMatrix R) := by
  let R (v : Fin n) := optMul (P v) (Q v)
  let z : ℂ := ∏ v, optPhase (P v) (Q v)
  have hprod : finitePauliMatrix P * finitePauliMatrix Q = z • finitePauliMatrix R :=
    finitePauliMatrix_mul P Q
  have hword (W : Word n) : star (finitePauliMatrix W) = finitePauliMatrix W :=
    finitePauliMatrix_isHermitian W
  have hstar : star (finitePauliMatrix P * finitePauliMatrix Q) =
      -(finitePauliMatrix P * finitePauliMatrix Q) := by
    rw [star_mul, hword Q, hword P, hanti]
    simp only [neg_neg]
  have hsum : (star z + z) • finitePauliMatrix R = 0 := by
    rw [hprod, star_smul, hword R] at hstar
    rw [add_smul, hstar, neg_add_cancel]
  have hR : finitePauliMatrix R ≠ 0 := by
    intro h
    have hs := finitePauliMatrix_mul_self R
    rw [h, zero_mul] at hs
    exact zero_ne_one hs
  have hzz := (smul_eq_zero.mp hsum).resolve_right hR
  have hzre : z.re = 0 := by
    have h := congrArg Complex.re hzz
    change (star z + z).re = 0 at h
    rw [Complex.add_re] at h
    change ((starRingEnd ℂ) z).re + z.re = 0 at h
    rw [Complex.conj_re] at h
    linarith only [h]
  have hz : z = (z.im : ℂ) * Complex.I := by
    apply Complex.ext
    · simp only [Complex.mul_re, Complex.ofReal_re, Complex.I_re, Complex.ofReal_im,
        Complex.I_im, mul_zero, zero_mul, sub_self, hzre]
    · simp only [Complex.mul_im, Complex.ofReal_re, Complex.I_re, Complex.ofReal_im,
        Complex.I_im, mul_one, zero_mul, add_zero]
  refine ⟨R, -z.im, fun θ => ?_, fun M hM => ?_⟩
  · unfold unitaryEvolution
    congr 1
    change (θ : ℂ) • (finitePauliMatrix P * finitePauliMatrix Q) =
      ((-z.im * θ : ℝ) : ℂ) • ((-Complex.I) • finitePauliMatrix R)
    have hs : (θ : ℂ) * z = ((-z.im * θ : ℝ) : ℂ) * -Complex.I := by
      calc
        _ = (θ : ℂ) * ((z.im : ℂ) * Complex.I) := congrArg ((θ : ℂ) * ·) hz
        _ = _ := by push_cast; ring
    simp only [hprod, smul_smul, hs]
  · have hzne : z ≠ 0 := by
      intro he
      have hp : finitePauliMatrix P * finitePauliMatrix Q = 0 := by rw [hprod, he, zero_smul]
      have h := congrArg (fun A : Reg n => A * finitePauliMatrix Q) hp
      change (finitePauliMatrix P * finitePauliMatrix Q) * finitePauliMatrix Q =
        0 * finitePauliMatrix Q at h
      rw [mul_assoc, finitePauliMatrix_mul_self, mul_one, zero_mul] at h
      have hsq := finitePauliMatrix_mul_self P
      rw [h, zero_mul] at hsq
      exact zero_ne_one hsq
    have h := hM.eq
    rw [hprod, Matrix.mul_smul, Matrix.smul_mul] at h
    exact smul_right_injective (Reg n) hzne h

/-- An operator that anticommutes with two factors commutes with their product. -/
theorem commute_product_of_anticommute {n : ℕ} {A B M : Reg n}
    (hA : A * M = -(M * A)) (hB : B * M = -(M * B)) : Commute (A * B) M := by
  change (A * B) * M = M * (A * B)
  rw [mul_assoc, hB, mul_neg, ← mul_assoc, hA, neg_mul, neg_neg, mul_assoc]

/-- One Pauli rotation removes one of two anticommuting coefficients.
The rotation commutes with any matrix commuting with their product. -/
theorem exists_pauli_plane_alignment {n : ℕ} (hn : 2 ≤ n) (P Q : Word n)
    (hanti : finitePauliMatrix P * finitePauliMatrix Q = -(finitePauliMatrix Q * finitePauliMatrix P))
    (a b : ℝ) :
    ∃ r : ℝ, 0 ≤ r ∧ ∃ C : TwoQubitCircuit n, C.gateCount ≤ 2 * n + 1 ∧
      (C.eval : Reg n) * ((a : ℂ) • finitePauliMatrix P + (b : ℂ) • finitePauliMatrix Q) =
        ((r : ℂ) • finitePauliMatrix P) * (C.eval : Reg n) ∧
      ∀ M : Reg n, Commute (finitePauliMatrix P * finitePauliMatrix Q) M → Commute (C.eval : Reg n) M := by
  obtain ⟨r, θ, hr, hrot⟩ := exists_exp_plane_alignment (finitePauliMatrix P) (finitePauliMatrix Q)
    (finitePauliMatrix_mul_self P) (finitePauliMatrix_mul_self Q) hanti a b
  obtain ⟨R, c, ht, _⟩ := exists_pauli_product_rotation_axis P Q hanti
  obtain ⟨z, hz, C, hC, he⟩ := exists_projective_pauli_rotation_circuit hn R (c * θ)
  have hw : pauliWeight R ≤ n := (Finset.card_le_univ _).trans (by simp)
  have hzne : z ≠ 0 := by
    intro h
    rw [h, norm_zero] at hz
    exact zero_ne_one hz
  refine ⟨r, hr, C, by omega, ?_, ?_⟩
  · rw [ht θ, he, Matrix.smul_mul, Matrix.mul_smul] at hrot
    exact smul_right_injective (Reg n) hzne hrot
  · intro M hM
    have hc := (hM.smul_left (θ : ℂ)).exp_left.eq
    rw [ht θ, he, Matrix.smul_mul, Matrix.mul_smul] at hc
    exact smul_right_injective (Reg n) hzne hc

/-- A circuit eliminates all nonpivot coefficients using one Pauli
rotation per eliminated word. The circuit is independent of evolution time. -/
theorem exists_anticommuting_pauli_alignment {n : ℕ} (hn : 2 ≤ n)
    (P : Word n) (S : Finset (Word n)) (a : ℝ) (b : Word n → ℝ)
    (hp : ∀ Q ∈ S, finitePauliMatrix P * finitePauliMatrix Q =
      -(finitePauliMatrix Q * finitePauliMatrix P))
    (ha : ∀ Q ∈ S, ∀ R ∈ S, Q ≠ R → finitePauliMatrix Q * finitePauliMatrix R =
      -(finitePauliMatrix R * finitePauliMatrix Q)) :
    ∃ r : ℝ, ∃ C : TwoQubitCircuit n, C.gateCount ≤ S.card * (2 * n + 1) ∧
      (C.eval : Reg n) * ((a : ℂ) • finitePauliMatrix P + ∑ Q ∈ S, (b Q : ℂ) • finitePauliMatrix Q) =
        ((r : ℂ) • finitePauliMatrix P) * (C.eval : Reg n) := by
  classical
  induction S using Finset.induction_on generalizing a with
  | empty =>
    exact ⟨a, TwoQubitCircuit.one n, Nat.zero_le _, by simp [TwoQubitCircuit.one_eval]⟩
  | @insert Q S hQ ih =>
    obtain ⟨r, _, U, hU, hplane, hcomm⟩ := exists_pauli_plane_alignment hn P Q
      (hp Q (Finset.mem_insert_self Q S)) a (b Q)
    have hp' R (hR : R ∈ S) := hp R (Finset.mem_insert_of_mem hR)
    have ha' R T (hR : R ∈ S) (hT : T ∈ S) (hne : R ≠ T) :=
      ha R (Finset.mem_insert_of_mem hR) T (Finset.mem_insert_of_mem hT) hne
    obtain ⟨r', V, hV, htail⟩ := ih r hp' (fun R hR T hT hne => ha' R T hR hT hne)
    let H : Reg n := ∑ R ∈ S, (b R : ℂ) • finitePauliMatrix R
    have hUH : (U.eval : Reg n) * H = H * (U.eval : Reg n) := by
      unfold H
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun R hR => ?_
      exact ((hcomm _ (commute_product_of_anticommute (hp' R hR)
        (ha Q (Finset.mem_insert_self Q S) R (Finset.mem_insert_of_mem hR)
          fun he => hQ (he ▸ hR)))).smul_right (b R : ℂ)).eq
    have hstep : (U.eval : Reg n) * ((a : ℂ) • finitePauliMatrix P +
        ∑ R ∈ insert Q S, (b R : ℂ) • finitePauliMatrix R) =
        ((r : ℂ) • finitePauliMatrix P + H) * (U.eval : Reg n) := by
      rw [Finset.sum_insert hQ, ← add_assoc]
      change (U.eval : Reg n) * (((a : ℂ) • finitePauliMatrix P + (b Q : ℂ) • finitePauliMatrix Q) + H) = _
      rw [mul_add, add_mul, hplane, hUH]
    refine ⟨r', V.mul U, ?_, ?_⟩
    · rw [TwoQubitCircuit.mul_gateCount, Finset.card_insert_of_notMem hQ, Nat.add_mul, Nat.one_mul]
      rw [Nat.add_comm U.gateCount V.gateCount]
      exact Nat.add_le_add hV hU
    · rw [TwoQubitCircuit.mul_eval]
      change ((V.eval : Reg n) * (U.eval : Reg n)) * ((a : ℂ) • finitePauliMatrix P +
          ∑ R ∈ insert Q S, (b R : ℂ) • finitePauliMatrix R) =
        ((r' : ℂ) • finitePauliMatrix P) * ((V.eval : Reg n) * (U.eval : Reg n))
      rw [mul_assoc, hstep, ← mul_assoc _ (((r : ℂ) • finitePauliMatrix P + H)), htail, mul_assoc]

/-- Every time on a pairwise anticommuting Pauli orbit has an exact
projective circuit. The bound is linear in support size and register size. -/
theorem exists_exact_anticommuting_pauli_evolution_circuit {n : ℕ} (hn : 2 ≤ n)
    (S : Finset (Word n)) (a : Word n → ℝ)
    (ha : ∀ P ∈ S, ∀ Q ∈ S, P ≠ Q → finitePauliMatrix P * finitePauliMatrix Q =
      -(finitePauliMatrix Q * finitePauliMatrix P)) (t : ℝ) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∃ C : TwoQubitCircuit n, C.gateCount ≤ (2 * S.card - 1) * (2 * n + 1) ∧
      unitaryEvolution (∑ P ∈ S, (a P : ℂ) • finitePauliMatrix P) t = z • (C.eval : Reg n) := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | ⟨P, hP⟩
  · exact ⟨1, norm_one, TwoQubitCircuit.one n, Nat.zero_le _,
      by simp [unitaryEvolution, TwoQubitCircuit.one_eval]⟩
  let H : Reg n := ∑ Q ∈ S, (a Q : ℂ) • finitePauliMatrix Q
  have hH : H = (a P : ℂ) • finitePauliMatrix P + ∑ Q ∈ S.erase P, (a Q : ℂ) • finitePauliMatrix Q :=
    (Finset.add_sum_erase S (fun Q => (a Q : ℂ) • finitePauliMatrix Q) hP).symm
  obtain ⟨r, C, hC, hA⟩ := exists_anticommuting_pauli_alignment hn P (S.erase P) (a P) a
    (fun Q hQ => ha P hP Q (Finset.mem_of_mem_erase hQ) (Finset.ne_of_mem_erase hQ).symm)
    (fun Q hQ R hR hne => ha Q (Finset.mem_of_mem_erase hQ) R (Finset.mem_of_mem_erase hR) hne)
  let V : Reg n := C.eval
  have hV : V ∈ unitary (Reg n) := C.eval.2
  have hconj : V * H * star V = (r : ℂ) • finitePauliMatrix P := by
    rw [hH]
    change (((C.eval : Reg n) * _) * star V) = _
    rw [hA, mul_assoc, (Unitary.mem_iff.mp hV).2, mul_one]
  have hs : unitaryEvolution ((r : ℂ) • finitePauliMatrix P) t =
      unitaryEvolution (finitePauliMatrix P) (r * t) := by
    unfold unitaryEvolution
    congr 1
    change (t : ℂ) • ((-Complex.I) • ((r : ℂ) • finitePauliMatrix P)) =
      ((r * t : ℝ) : ℂ) • ((-Complex.I) • finitePauliMatrix P)
    simp only [smul_smul, Complex.ofReal_mul]
    congr 1
    ring
  obtain ⟨z, hz, U, hU, hrot⟩ := exists_projective_pauli_rotation_circuit hn P (r * t)
  have hw : pauliWeight P ≤ n := (Finset.card_le_univ _).trans (by simp)
  have hUn : U.gateCount ≤ 2 * n + 1 := hU.trans (by omega)
  have h := unitaryEvolution_conj V H (Unitary.isUnit_coe (U := C.eval)) t
  rw [inv_eq_star_of_mem_unitary hV, hconj, hs, hrot] at h
  refine ⟨z, hz, C.adjoint.mul (U.mul C), ?_, ?_⟩
  · simp only [TwoQubitCircuit.mul_gateCount]
    change C.gateCount + U.gateCount + C.gateCount ≤ _
    refine (Nat.add_le_add (Nat.add_le_add hC hUn) hC).trans_eq ?_
    have hcard : 2 * (S.erase P).card + 1 = 2 * S.card - 1 := by
      have hp := Finset.card_pos.mpr (show S.Nonempty from ⟨P, hP⟩)
      rw [Finset.card_erase_of_mem hP]
      omega
    rw [← hcard]
    ring
  · rw [TwoQubitCircuit.mul_eval, TwoQubitCircuit.mul_eval, TwoQubitCircuit.adjoint_eval]
    change unitaryEvolution H t = z • (star V * ((U.eval : Reg n) * V))
    have hb := congrArg (fun A : Reg n => star V * A * V) h.symm
    have hv (A : Reg n) : star V * (V * A * star V) * V = A := by
      calc
        _ = (star V * V) * A * (star V * V) := by simp only [mul_assoc]
        _ = _ := by simp only [(Unitary.mem_iff.mp hV).1, one_mul, mul_one]
    change star V * (V * unitaryEvolution H t * star V) * V =
      star V * (z • (U.eval : Reg n)) * V at hb
    rw [hv] at hb
    simpa only [Matrix.mul_smul, Matrix.smul_mul, mul_assoc] using hb

private def pauliCode : Option (Fin 3) → Quantum.PauliOperator
  | none => .I
  | some a => if a = 0 then .X else if a = 1 then .Y else .Z

private theorem pauliCode_injective : Function.Injective pauliCode := by
  intro p q h
  fin_cases p <;> fin_cases q <;> simp [pauliCode] at h ⊢

private def wordToSymplecticPauli (n : ℕ) : Word n ↪ Quantum.NQubitPauliOperator n where
  toFun P i := pauliCode (P i)
  inj' := by
    intro P Q h
    exact funext fun i => pauliCode_injective (congrFun h i)

private def qubitRegisterEquiv (n : ℕ) : Quantum.NQubitBasis n ≃ (Fin n → Bool) :=
  Equiv.piCongrRight fun _ => finTwoEquiv

private def qubitMatrixEquiv (n : ℕ) : Matrix (Quantum.NQubitBasis n) (Quantum.NQubitBasis n) ℂ ≃ₐ[ℂ] Reg n :=
  Matrix.reindexAlgEquiv ℂ ℂ (qubitRegisterEquiv n)

private theorem reindex_coded_pauli {n : ℕ} (P : Word n) :
    qubitMatrixEquiv n (wordToSymplecticPauli n P).toMatrix = finitePauliMatrix P := by
  ext x y
  change (∏ i, (pauliCode (P i)).toMatrix (finTwoEquiv.symm (x i)) (finTwoEquiv.symm (y i))) =
    ∏ i, boolPauliOption (P i) (x i) (y i)
  refine Finset.prod_congr rfl fun i _ => ?_
  generalize P i = p
  generalize x i = a
  generalize y i = b
  fin_cases p <;> fin_cases a <;> fin_cases b <;>
    norm_num [pauliCode, finTwoEquiv, Quantum.PauliOperator.toMatrix, Quantum.Xmat,
      Quantum.Ymat, Quantum.Zmat, boolPauliOption, finiteQubitPauli, Matrix.one_apply]

private theorem symplecticInner_coded_pauli_eq_one {n : ℕ} (P Q : Word n)
    (hanti : finitePauliMatrix P * finitePauliMatrix Q = -(finitePauliMatrix Q * finitePauliMatrix P)) :
    Quantum.NQubitPauliOperator.symplecticInner (wordToSymplecticPauli n P) (wordToSymplecticPauli n Q) = 1 := by
  let p : Quantum.NQubitPauliGroupElement n := ⟨0, wordToSymplecticPauli n P⟩
  let q : Quantum.NQubitPauliGroupElement n := ⟨0, wordToSymplecticPauli n Q⟩
  change Quantum.NQubitPauliOperator.symplecticInner p.operators q.operators = 1
  by_contra hn
  let w := Quantum.NQubitPauliOperator.symplecticInner p.operators q.operators
  have hw : w = 0 := by
    by_contra hne
    apply hn
    have hval := ZMod.val_lt w
    have hpos : w.val ≠ 0 := fun h => hne ((ZMod.val_eq_zero w).mp h)
    apply ZMod.val_injective 2
    change w.val = 1
    omega
  have hcomm := (Quantum.NQubitPauliOperator.commutes_iff_symplectic_inner_zero p q).mpr hw
  have hm := congrArg (fun a : Quantum.NQubitPauliGroupElement n => qubitMatrixEquiv n a.toMatrix) hcomm
  have hp : qubitMatrixEquiv n p.toMatrix = finitePauliMatrix P := by
    rw [show p.toMatrix = (wordToSymplecticPauli n P).toMatrix by
      simp [p, Quantum.NQubitPauliGroupElement.toMatrix]]
    exact reindex_coded_pauli P
  have hq : qubitMatrixEquiv n q.toMatrix = finitePauliMatrix Q := by
    rw [show q.toMatrix = (wordToSymplecticPauli n Q).toMatrix by
      simp [q, Quantum.NQubitPauliGroupElement.toMatrix]]
    exact reindex_coded_pauli Q
  simp only [Quantum.NQubitPauliGroupElement.toMatrix_mul, map_mul, hp, hq] at hm
  rw [← hm] at hanti
  have hcancel : finitePauliMatrix P * finitePauliMatrix Q * finitePauliMatrix Q * finitePauliMatrix P = 1 := by
    rw [mul_assoc _ (finitePauliMatrix Q) (finitePauliMatrix Q), finitePauliMatrix_mul_self,
      mul_one, finitePauliMatrix_mul_self]
  have he := congrArg (fun A : Reg n => A * finitePauliMatrix Q * finitePauliMatrix P) hanti
  change finitePauliMatrix P * finitePauliMatrix Q * finitePauliMatrix Q * finitePauliMatrix P =
    -(finitePauliMatrix P * finitePauliMatrix Q) * finitePauliMatrix Q * finitePauliMatrix P at he
  rw [neg_mul, neg_mul, hcancel] at he
  let i : Fin n → Bool := fun _ => false
  have hz := congrArg (fun X : Reg n => X i i) he
  norm_num [Matrix.one_apply] at hz

/-- At most `2n+1` Pauli words on `n` qubits can mutually anticommute. -/
theorem card_anticommuting_finitePauliMatrix_le {n : ℕ} (S : Finset (Word n))
    (ha : ∀ P ∈ S, ∀ Q ∈ S, P ≠ Q → finitePauliMatrix P * finitePauliMatrix Q =
      -(finitePauliMatrix Q * finitePauliMatrix P)) : S.card ≤ 2 * n + 1 := by
  classical
  have h := Quantum.card_pairwiseAnticommutingPauli_le (S.map (wordToSymplecticPauli n)) (by
    intro p hp q hq hpq
    obtain ⟨P, hP, rfl⟩ := Finset.mem_map.mp hp
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact symplecticInner_coded_pauli_eq_one P Q (ha P hP Q hQ (fun h => hpq (congrArg _ h))))
  simpa only [Finset.card_map] using h

/-- Every pairwise anticommuting Pauli Hamiltonian has a zero-error
projective gate cap quadratic in register size, uniform over its orbit. -/
theorem anticommuting_pauli_uniform_gate_cap {n : ℕ} (hn : 2 ≤ n)
    (S : Finset (Word n)) (a : Word n → ℝ)
    (ha : ∀ P ∈ S, ∀ Q ∈ S, P ≠ Q → finitePauliMatrix P * finitePauliMatrix Q =
      -(finitePauliMatrix Q * finitePauliMatrix P)) (t : ℝ) :
    HasProjectiveCircuitApproximation n 0 ((4 * n + 1) * (2 * n + 1))
      (unitaryEvolution (∑ P ∈ S, (a P : ℂ) • finitePauliMatrix P) t) := by
  obtain ⟨z, hz, C, hC, he⟩ := exists_exact_anticommuting_pauli_evolution_circuit hn S a ha t
  have hs := card_anticommuting_finitePauliMatrix_le S ha
  refine ⟨z, hz, C, hC.trans (Nat.mul_le_mul_right _ (by omega)), ?_⟩
  rw [he, sub_self, norm_zero]

