import GaloisForLFunctions.HTGeometry.DifferentialIndependentOneSliceNonsummability
import GaloisForLFunctions.HTGeometry.KolchinExchangeGaugeObstruction

/-!
# The canonical palette shift is the ambient shift

The one-slice nonsummability obstruction is stated for the canonical unit translation
`differentialIndependentFreeShiftEquiv` of the field generated by a differentially independent
bilateral palette.  In applications the shift is a genuine ambient differential automorphism that
moves the palette one slice.  This file identifies the two: on the generated field they agree, so
the obstruction applies verbatim to the ambient automorphism.

* **`differentialIndependentFreeShiftEquiv_coe_eq`** — the identification;
* **`oneSlice_ne_coboundary_of_ambient_shift`** — hence no nonzero finite constant-coefficient
  one-slice jet form is a coboundary for the ambient automorphism.
-/

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

/-- **The canonical palette shift agrees with any ambient differential automorphism that moves the
palette one slice.**  Both are `C`-algebra maps commuting with the derivation which agree on the
jets generating the field, so they agree everywhere on it. -/
theorem differentialIndependentFreeShiftEquiv_coe_eq
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x)
    (Ψ : HTGeometry.DifferentialAlgEquiv C K)
    (hΨ : ∀ p : α × ℤ, Ψ.toAlgEquiv (x p) = x (p.1, p.2 + 1))
    (g : differentialAdjoin C (Set.range x)) :
    ((differentialIndependentFreeShiftEquiv x hx g :
        differentialAdjoin C (Set.range x)) : K) = Ψ.toAlgEquiv (g : K) := by
  classical
  let S := differentialAdjoin C (Set.range x)
  let p : ∀ y : K, y ∈ differentialAdjoin C (Set.range x) → Prop := fun y hy =>
    ((differentialIndependentFreeShiftEquiv x hx ⟨y, hy⟩ : S) : K) = Ψ.toAlgEquiv y
  change p (g : K) g.2
  refine IntermediateField.adjoin_induction C (p := p) ?_ ?_ ?_ ?_ ?_ g.2
  · rintro y ⟨y₀, ⟨⟨a, m⟩, rfl⟩, n, rfl⟩
    show ((differentialIndependentFreeShiftEquiv x hx
      ⟨differentialJet n (x (a, m)), _⟩ : S) : K) = _
    rw [differentialIndependentFreeShiftEquiv_jet]
    rw [Ψ.map_differentialJet, hΨ (a, m)]
  · intro c
    show ((differentialIndependentFreeShiftEquiv x hx (algebraMap C S c) : S) : K) =
      Ψ.toAlgEquiv (algebraMap C K c)
    rw [AlgEquiv.commutes, AlgEquiv.commutes]
    rfl
  · intro y z hy hz hpy hpz
    show ((differentialIndependentFreeShiftEquiv x hx (⟨y, hy⟩ + ⟨z, hz⟩ : S) : S) : K) = _
    rw [map_add, map_add]
    change ((differentialIndependentFreeShiftEquiv x hx ⟨y, hy⟩ : S) : K) +
      ((differentialIndependentFreeShiftEquiv x hx ⟨z, hz⟩ : S) : K) = _
    rw [hpy, hpz]
  · intro y hy hpy
    show ((differentialIndependentFreeShiftEquiv x hx (⟨y, hy⟩⁻¹ : S) : S) : K) = _
    rw [map_inv₀, map_inv₀]
    change ((differentialIndependentFreeShiftEquiv x hx ⟨y, hy⟩ : S) : K)⁻¹ = _
    rw [hpy]
  · intro y z hy hz hpy hpz
    show ((differentialIndependentFreeShiftEquiv x hx (⟨y, hy⟩ * ⟨z, hz⟩ : S) : S) : K) = _
    rw [map_mul, map_mul]
    change ((differentialIndependentFreeShiftEquiv x hx ⟨y, hy⟩ : S) : K) *
      ((differentialIndependentFreeShiftEquiv x hx ⟨z, hz⟩ : S) : K) = _
    rw [hpy, hpz]

/-- **One-slice nonsummability for an ambient shift.**  No nonzero finite constant-coefficient
linear form in the jets of one slice of a differentially independent bilateral palette is a
coboundary for an ambient differential automorphism that moves the palette one slice. -/
theorem oneSlice_ne_coboundary_of_ambient_shift
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x)
    (Ψ : HTGeometry.DifferentialAlgEquiv C K)
    (hΨ : ∀ p : α × ℤ, Ψ.toAlgEquiv (x p) = x (p.1, p.2 + 1))
    (c : (α × ℕ) →₀ C) (hc : c ≠ 0)
    (g : differentialAdjoin C (Set.range x)) :
    Ψ.toAlgEquiv (g : K) - (g : K) ≠
      ((c.sum (fun j a =>
        algebraMap C (differentialAdjoin C (Set.range x)) a *
          ⟨differentialJet j.2 (x (j.1, 0)),
            differentialJet_mem_differentialAdjoin C
              (Set.mem_range_self (j.1, 0)) j.2⟩) :
        differentialAdjoin C (Set.range x)) : K) := by
  intro hcob
  refine differentialIndependent_oneSlice_ne_coboundary x hx c hc g ?_
  apply Subtype.ext
  rw [AddSubgroupClass.coe_sub, differentialIndependentFreeShiftEquiv_coe_eq x hx Ψ hΨ g]
  exact hcob

end

end GaloisForLFunctions
