import GaloisForLFunctions.HTGeometry.MatrixPrincipalSymbolLowerLaw
import GaloisForLFunctions.HTGeometry.MatrixPrincipalSymbolCoefficientFlatness

/-!
# Matrix principal-symbol horizon for varying derivation laws

This is the law-space form of the general theorem.  The derivation is not fixed: every point of the
law space may select a different derivation.  Hypertranscendence relative to that selected law is
ordinary algebraic independence of its complete iterated-derivation jet packet.  An explicit
strict-lower principal law identifies the exact dependent-law spectrum with the determinant
characteristic set, and flatness collapses it to one holographic horizon or the whole law space.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Set

variable {k K L g ι : Type*} [Field k] [Field K] [Field L]
  [Algebra k L] [Algebra K L] [Fintype ι] [DecidableEq ι]

/-- The complete jet of `x` generated by an explicitly selected derivation law. -/
def selectedDerivationJet (D : Derivation k L L) (n : ℕ) (x : L) : L :=
  (D : L → L)^[n] x

/-- A finite observable family is differentially algebraically independent relative to the
explicitly selected derivation `D` when all of its `D`-jets are algebraically independent. -/
def DerivationIndependentOver
    (K : Type*) [Field K] [Algebra K L]
    (D : Derivation k L L) (x : ι → L) : Prop :=
  AlgebraicIndependent K
    (fun p : ι × ℕ ↦ selectedDerivationJet D p.2 (x p.1))

/-- One element is hypertranscendental relative to an explicitly selected derivation law. -/
def HypertranscendentalForDerivation
    (K : Type*) [Field K] [Algebra K L]
    (D : Derivation k L L) (x : L) : Prop :=
  DerivationIndependentOver K D (fun _ : Unit ↦ x)

/-- **General principal-symbol theorem for a selected derivation law.**  If the complete `D`-jet
packet satisfies an explicit strict-lower principal law over an algebraically independent source
packet, it is differentially independent exactly when every matrix symbol is nonsingular. -/
theorem derivationPrincipalLowerLaw_independent_iff
    (source : ℕ → ι → L) (observable : ι → L)
    (D : Derivation k L L) (symbol : ℕ → Matrix ι ι K)
    (hlaw : MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet D n (observable i)) symbol)
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    DerivationIndependentOver K D observable ↔
      ∀ n : ℕ, (symbol n).det ≠ 0 := by
  have hpacket := matrixPrincipalLowerLaw_algebraicIndependent_iff
    source (fun n i ↦ selectedDerivationJet D n (observable i))
    symbol hlaw hsource
  constructor
  · intro hD
    apply hpacket.mp
    unfold DerivationIndependentOver at hD
    let swap : ℕ × ι → ι × ℕ := fun p ↦ (p.2, p.1)
    have hswap : Function.Injective swap := by
      rintro ⟨n, i⟩ ⟨m, j⟩ h
      exact Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h)
    simpa [swap, Function.comp_def] using hD.comp swap hswap
  · intro hsymbols
    have hjet := hpacket.mpr hsymbols
    unfold DerivationIndependentOver
    let swap : ι × ℕ → ℕ × ι := fun p ↦ (p.2, p.1)
    have hswap : Function.Injective swap := by
      rintro ⟨i, n⟩ ⟨j, m⟩ h
      exact Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h)
    simpa [swap, Function.comp_def] using hjet.comp swap hswap

/-- Rank-one selected-law specialization: the observable is hypertranscendental for `D` exactly
off the scalar determinant horizon. -/
theorem derivationPrincipalLowerLaw_hypertranscendental_iff
    (source : ℕ → Unit → L) (observable : L)
    (D : Derivation k L L) (symbol : ℕ → Matrix Unit Unit K)
    (hlaw : MatrixPrincipalLowerLaw source
      (fun n _ ↦ selectedDerivationJet D n observable) symbol)
    (hsource : AlgebraicIndependent K (fun p : ℕ × Unit ↦ source p.1 p.2)) :
    HypertranscendentalForDerivation K D observable ↔
      ∀ n : ℕ, (symbol n).det ≠ 0 :=
  derivationPrincipalLowerLaw_independent_iff source (fun _ : Unit ↦ observable)
    D symbol hlaw hsource

/-- Candidate derivation laws for which the observable family is differentially algebraically
dependent. -/
def derivationLawDependentSet
    (law : g → Derivation k L L) (observable : ι → L) : Set g :=
  {A | ¬ DerivationIndependentOver K (law A) observable}

/-- **Exact varying-law spectrum.**  When every selected derivation satisfies the explicit
principal lower law, its differential-algebraic dependence spectrum is exactly the union of the
matrix-symbol determinant horizons. -/
theorem derivationLawDependentSet_eq_characteristicSet
    (source : ℕ → ι → L) (observable : ι → L)
    (law : g → Derivation k L L)
    (symbol : ℕ → g → Matrix ι ι K)
    (hlaw : ∀ A, MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet (law A) n (observable i))
      (fun n ↦ symbol n A))
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    derivationLawDependentSet (K := K) law observable =
      matrixSymbolCharacteristicSet symbol := by
  ext A
  change (¬ DerivationIndependentOver K (law A) observable) ↔
    ∃ n, (symbol n A).det = 0
  rw [derivationPrincipalLowerLaw_independent_iff
    source observable (law A) (fun n ↦ symbol n A) (hlaw A) hsource]
  push Not
  rfl

/-- **Before-time holographic horizon.**  With flat matrix symbols and one regular selected law,
the exact varying-derivation dependence spectrum is the first determinantal locus. -/
theorem derivationLawDependentSet_eq_firstSingularSet_of_flat
    (source : ℕ → ι → L) (observable : ι → L)
    (law : g → Derivation k L L)
    (symbol : ℕ → g → Matrix ι ι K)
    (hflat : MatrixPrincipalSymbolFlat symbol)
    (A₀ : g) (hA₀ : ∀ n, (symbol n A₀).det ≠ 0)
    (hlaw : ∀ A, MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet (law A) n (observable i))
      (fun n ↦ symbol n A))
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    derivationLawDependentSet (K := K) law observable =
      matrixSymbolSingularSet symbol 0 := by
  rw [derivationLawDependentSet_eq_characteristicSet
    source observable law symbol hlaw hsource]
  exact matrixSymbolCharacteristicSet_eq_firstSingularSet symbol hflat A₀ hA₀

/-- The exact all-laws/one-horizon dichotomy for a flat varying-derivation system. -/
theorem derivationPrincipalLowerLaw_flat_spectrum_dichotomy
    (source : ℕ → ι → L) (observable : ι → L)
    (law : g → Derivation k L L)
    (symbol : ℕ → g → Matrix ι ι K)
    (hflat : MatrixPrincipalSymbolFlat symbol)
    (hlaw : ∀ A, MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet (law A) n (observable i))
      (fun n ↦ symbol n A))
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    derivationLawDependentSet (K := K) law observable = Set.univ ∨
      ∃ A₀ : g, (∀ n, (symbol n A₀).det ≠ 0) ∧
        derivationLawDependentSet (K := K) law observable =
          matrixSymbolSingularSet symbol 0 := by
  rw [derivationLawDependentSet_eq_characteristicSet
    source observable law symbol hlaw hsource]
  exact matrixPrincipalSymbolFlat_characteristicSet_dichotomy symbol hflat

/-- **Coefficient-oriented before-time horizon.**  This is the orientation produced directly by
iterating derivations on a column of source elements: the exact dependence spectrum is the first
determinantal locus. -/
theorem derivationLawDependentSet_eq_firstSingularSet_of_coefficientFlat
    (source : ℕ → ι → L) (observable : ι → L)
    (law : g → Derivation k L L)
    (symbol : ℕ → g → Matrix ι ι K)
    (hflat : MatrixCoefficientPrincipalSymbolFlat symbol)
    (A₀ : g) (hA₀ : ∀ n, (symbol n A₀).det ≠ 0)
    (hlaw : ∀ A, MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet (law A) n (observable i))
      (fun n ↦ symbol n A))
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    derivationLawDependentSet (K := K) law observable =
      matrixSymbolSingularSet symbol 0 := by
  rw [derivationLawDependentSet_eq_characteristicSet
    source observable law symbol hlaw hsource]
  exact matrixSymbolCharacteristicSet_eq_firstSingularSet_of_coefficientFlat
    symbol hflat A₀ hA₀

/-- Exact all-laws/one-horizon dichotomy in the coefficient orientation of actual iterated
derivations. -/
theorem derivationPrincipalLowerLaw_coefficientFlat_spectrum_dichotomy
    (source : ℕ → ι → L) (observable : ι → L)
    (law : g → Derivation k L L)
    (symbol : ℕ → g → Matrix ι ι K)
    (hflat : MatrixCoefficientPrincipalSymbolFlat symbol)
    (hlaw : ∀ A, MatrixPrincipalLowerLaw source
      (fun n i ↦ selectedDerivationJet (law A) n (observable i))
      (fun n ↦ symbol n A))
    (hsource : AlgebraicIndependent K (fun p : ℕ × ι ↦ source p.1 p.2)) :
    derivationLawDependentSet (K := K) law observable = Set.univ ∨
      ∃ A₀ : g, (∀ n, (symbol n A₀).det ≠ 0) ∧
        derivationLawDependentSet (K := K) law observable =
          matrixSymbolSingularSet symbol 0 := by
  rw [derivationLawDependentSet_eq_characteristicSet
    source observable law symbol hlaw hsource]
  exact matrixCoefficientPrincipalSymbolFlat_characteristicSet_dichotomy symbol hflat

end

end GaloisForLFunctions.HTGeometry
