import GaloisForLFunctions.HTGeometry.UltraproductRank

/-!
# One autonomous equation for the iterates of an Abel equation

Let `Ω` be a field with a derivation `δ` vanishing on a base field `K`, let `σ_n` be injective
`K`-algebra endomorphisms of `Ω`, and let `v_j = δ^j v_0`.  Suppose elements `y_n` satisfy

`δ y_n = v_0 / σ_n(v_0)`,   `δ (σ_n v_j) = σ_n(v_{j+1}) · δ y_n`.

For an Abel function `A` of a self-map `g` (`A ∘ g = A + 1`) these are the identities
`A'(gⁿ)·(gⁿ)' = A'` and the chain rule, with `v_0 = A'`, `y_n = gⁿ` and `σ_n` the substitution of
`gⁿ`.  If every `v_j` is algebraic over the field generated by a fixed family `b` of `p` elements,
then one nonzero polynomial in `2p + 2` variables over `K` annihilates the jets
`(y_n, δ y_n, δ² y_n, …)` of **every** `y_n`.

In an ultraproduct the germs of `v_j`, of `σ_n v_j` and of `y_n` generate a field closed under the
coordinatewise derivation, and every generator is algebraic over the field generated by the
`2p + 1` germs of `b`, `σ_n b` and `y_n`.  The jets of the germ of `y_n` therefore have bounded
transcendence degree in every ultraproduct, and the compactness step gives one polynomial.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter

noncomputable section

variable {ι K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]

/-! ### The coordinatewise derivation of an ultraproduct -/

section GermDerivation

variable (u : Ultrafilter ι) (δ : Derivation ℤ Ω Ω)

/-- The coordinatewise derivation of germs along an ultrafilter. -/
def germDeriv : Germ (u : Filter ι) Ω → Germ (u : Filter ι) Ω := Germ.map δ

theorem germDeriv_coe (f : ι → Ω) :
    germDeriv u δ (f : Germ (u : Filter ι) Ω)
      = ((fun n => δ (f n) : ι → Ω) : Germ (u : Filter ι) Ω) :=
  rfl

theorem germDeriv_add (x y : Germ (u : Filter ι) Ω) :
    germDeriv u δ (x + y) = germDeriv u δ x + germDeriv u δ y := by
  refine Germ.inductionOn x fun f => Germ.inductionOn y fun g => ?_
  rw [← Germ.coe_add, germDeriv_coe, germDeriv_coe, germDeriv_coe, ← Germ.coe_add]
  congr 1
  funext n
  exact map_add δ (f n) (g n)

theorem germDeriv_mul (x y : Germ (u : Filter ι) Ω) :
    germDeriv u δ (x * y) = x * germDeriv u δ y + y * germDeriv u δ x := by
  refine Germ.inductionOn x fun f => Germ.inductionOn y fun g => ?_
  rw [← Germ.coe_mul, germDeriv_coe, germDeriv_coe, germDeriv_coe, ← Germ.coe_mul, ← Germ.coe_mul,
    ← Germ.coe_add]
  congr 1
  funext n
  show δ (f n * g n) = f n * δ (g n) + g n * δ (f n)
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]

theorem germDeriv_inv (x : Germ (u : Filter ι) Ω) :
    germDeriv u δ x⁻¹ = -x⁻¹ ^ 2 * germDeriv u δ x := by
  refine Germ.inductionOn x fun f => ?_
  rw [← Germ.coe_inv, germDeriv_coe, germDeriv_coe, ← Germ.coe_pow, ← Germ.coe_neg,
    ← Germ.coe_mul]
  congr 1
  funext n
  show δ (f n)⁻¹ = -(f n)⁻¹ ^ 2 * δ (f n)
  rw [Derivation.leibniz_inv, smul_eq_mul]

theorem germDeriv_algebraMap (hK : ∀ c : K, δ (algebraMap K Ω c) = 0) (c : K) :
    germDeriv u δ (algebraMap K (Germ (u : Filter ι) Ω) c) = 0 := by
  show germDeriv u δ ((fun _ => algebraMap K Ω c : ι → Ω) : Germ (u : Filter ι) Ω) = 0
  rw [germDeriv_coe]
  simp only [hK]
  rfl

theorem germDeriv_iterate_coe (f : ι → Ω) (k : ℕ) :
    (germDeriv u δ)^[k] (f : Germ (u : Filter ι) Ω)
      = ((fun n => (⇑δ)^[k] (f n) : ι → Ω) : Germ (u : Filter ι) Ω) := by
  induction k generalizing f with
  | zero => rfl
  | succ k ih =>
      rw [Function.iterate_succ_apply, germDeriv_coe, ih]
      rfl

/-- **A field generated by germs whose derivatives it contains is closed under the derivation.** -/
theorem germDeriv_mem_adjoin (hK : ∀ c : K, δ (algebraMap K Ω c) = 0) {σ : Type*}
    (s : σ → Germ (u : Filter ι) Ω)
    (hs : ∀ i, germDeriv u δ (s i) ∈ IntermediateField.adjoin K (Set.range s))
    {x : Germ (u : Filter ι) Ω} (hx : x ∈ IntermediateField.adjoin K (Set.range s)) :
    germDeriv u δ x ∈ IntermediateField.adjoin K (Set.range s) := by
  set E := IntermediateField.adjoin K (Set.range s) with hE
  refine IntermediateField.adjoin_induction K
    (p := fun y _ => germDeriv u δ y ∈ E) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨i, rfl⟩
    exact hs i
  · intro c
    rw [germDeriv_algebraMap u δ hK]
    exact zero_mem E
  · intro a b _ _ ha hb
    rw [germDeriv_add]
    exact add_mem ha hb
  · intro a haE ha
    rw [germDeriv_inv]
    exact mul_mem (neg_mem (pow_mem (inv_mem haE) 2)) ha
  · intro a b haE hbE ha hb
    rw [germDeriv_mul]
    exact add_mem (mul_mem haE hb) (mul_mem hbE ha)

end GermDerivation

/-! ### The Abel tower -/

/-- **One autonomous equation for the iterates of an Abel equation.**  If `δ y_n = v_0/σ_n(v_0)`,
the chain rule `δ (σ_n v_j) = σ_n(v_{j+1})·δ y_n` holds, and every jet `v_j` is algebraic over the
field generated by `p` fixed elements, then one nonzero polynomial in `2p + 2` variables annihilates
the jets of every `y_n`. -/
theorem exists_uniform_jet_relation_of_abel_tower (δ : Derivation ℤ Ω Ω)
    (hK : ∀ c : K, δ (algebraMap K Ω c) = 0) (σ : ι → Ω →ₐ[K] Ω)
    (hσ : ∀ n, Function.Injective (σ n)) (v : ℕ → Ω) (hv : ∀ j, δ (v j) = v (j + 1))
    (y : ι → Ω) (hy : ∀ n, δ (y n) = v 0 * (σ n (v 0))⁻¹)
    (hchain : ∀ n j, δ (σ n (v j)) = σ n (v (j + 1)) * δ (y n))
    {p : ℕ} (b : Fin p → Ω) (hb : ∀ j, AlgebraicWitness K b (v j)) :
    ∃ Q : MvPolynomial (Fin (p + p + 1 + 1)) K, Q ≠ 0 ∧
      ∀ n, MvPolynomial.aeval (fun k : Fin (p + p + 1 + 1) => (⇑δ)^[(k : ℕ)] (y n)) Q = 0 := by
  classical
  set basis : ι → Fin (p + p + 1) → Ω := fun n =>
    Fin.append (Fin.append b fun i => σ n (b i)) fun _ : Fin 1 => y n with hbasis
  have hbasisB : ∀ n i, basis n (Fin.castAdd 1 (Fin.castAdd p i)) = b i := by
    intro n i
    rw [hbasis]
    simp only [Fin.append_left]
  have hbasisS : ∀ n i, basis n (Fin.castAdd 1 (Fin.natAdd p i)) = σ n (b i) := by
    intro n i
    rw [hbasis]
    simp only [Fin.append_left, Fin.append_right]
  have hbasisY : ∀ n, basis n (Fin.natAdd (p + p) 0) = y n := by
    intro n
    rw [hbasis]
    simp only [Fin.append_right]
  refine exists_uniform_annihilator_of_ultraproduct_rank (fun n k => (⇑δ)^[(k : ℕ)] (y n)) basis
    fun u k => ?_
  set G := Germ (u : Filter ι) Ω
  set F := IntermediateField.adjoin K
    (Set.range fun j : Fin (p + p + 1) => ((fun n => basis n j : ι → Ω) : G)) with hF
  -- the generators: the jets `v_j`, their substitutions, and `y_n`
  set s : ℕ ⊕ ℕ ⊕ Unit → G := fun
    | Sum.inl j => ((fun _ => v j : ι → Ω) : G)
    | Sum.inr (Sum.inl j) => ((fun n => σ n (v j) : ι → Ω) : G)
    | Sum.inr (Sum.inr _) => ((y : ι → Ω) : G) with hs
  set E := IntermediateField.adjoin K (Set.range s) with hE
  have hmem : ∀ i, s i ∈ E := fun i => IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
  -- the derivative of `y_n` lies in the generated field
  have hdy : germDeriv u δ ((y : ι → Ω) : G)
      = s (Sum.inl 0) * (s (Sum.inr (Sum.inl 0)))⁻¹ := by
    rw [germDeriv_coe, hs, ← Germ.coe_inv, ← Germ.coe_mul]
    congr 1
    funext n
    exact hy n
  have hdyE : germDeriv u δ ((y : ι → Ω) : G) ∈ E := by
    rw [hdy]
    exact mul_mem (hmem (Sum.inl 0)) (inv_mem (hmem (Sum.inr (Sum.inl 0))))
  have hderiv : ∀ i, germDeriv u δ (s i) ∈ E := by
    rintro (j | j | _)
    · have : germDeriv u δ (s (Sum.inl j)) = s (Sum.inl (j + 1)) := by
        rw [hs, germDeriv_coe]
        congr 1
        funext n
        exact hv j
      rw [this]
      exact hmem (Sum.inl (j + 1))
    · have : germDeriv u δ (s (Sum.inr (Sum.inl j)))
          = s (Sum.inr (Sum.inl (j + 1))) * germDeriv u δ ((y : ι → Ω) : G) := by
        rw [hs, germDeriv_coe, germDeriv_coe, ← Germ.coe_mul]
        congr 1
        funext n
        exact hchain n j
      rw [this]
      exact mul_mem (hmem (Sum.inr (Sum.inl (j + 1)))) hdyE
    · exact hdyE
  -- every generator is algebraic over the basis field
  have hvalg : ∀ j, IsAlgebraic ↥F (s (Sum.inl j)) := by
    intro j
    obtain ⟨m, P, hlead, hrel⟩ := hb j
    have hcomp : ∀ n, (basis n ∘ fun i : Fin p => Fin.castAdd 1 (Fin.castAdd p i)) = b := by
      intro n
      funext i
      exact hbasisB n i
    refine isAlgebraic_of_algebraicWitness ?_
    refine algebraicWitness_germ u (m := m)
      (P := fun l => MvPolynomial.rename (fun i : Fin p => Fin.castAdd 1 (Fin.castAdd p i)) (P l))
      ?_ ?_
    · intro n
      rw [MvPolynomial.aeval_rename, hcomp n]
      exact hlead
    · intro n
      refine Eq.trans ?_ hrel
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [MvPolynomial.aeval_rename, hcomp n]
  have hsalg : ∀ j, IsAlgebraic ↥F (s (Sum.inr (Sum.inl j))) := by
    intro j
    obtain ⟨m, P, hlead, hrel⟩ := hb j
    have hcomp : ∀ n, (basis n ∘ fun i : Fin p => Fin.castAdd 1 (Fin.natAdd p i))
        = fun i => σ n (b i) := by
      intro n
      funext i
      exact hbasisS n i
    refine isAlgebraic_of_algebraicWitness ?_
    refine algebraicWitness_germ u (m := m)
      (P := fun l => MvPolynomial.rename (fun i : Fin p => Fin.castAdd 1 (Fin.natAdd p i)) (P l))
      ?_ ?_
    · intro n
      rw [MvPolynomial.aeval_rename, hcomp n, ← MvPolynomial.comp_aeval_apply b (σ n)]
      intro h0
      exact hlead (hσ n (by rw [h0, map_zero]))
    · intro n
      have hmapped := congrArg (σ n) hrel
      rw [map_zero, map_sum] at hmapped
      refine Eq.trans ?_ hmapped
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [MvPolynomial.aeval_rename, hcomp n, map_mul, map_pow,
        MvPolynomial.comp_aeval_apply b (σ n)]
  have hyF : ((y : ι → Ω) : G) ∈ F := by
    refine IntermediateField.subset_adjoin K _ ⟨Fin.natAdd (p + p) 0, ?_⟩
    show ((fun n => basis n (Fin.natAdd (p + p) 0) : ι → Ω) : G) = _
    congr 1
    funext n
    exact hbasisY n
  have halg : ∀ i, IsAlgebraic ↥F (s i) := by
    rintro (j | j | _)
    · exact hvalg j
    · exact hsalg j
    · exact isAlgebraic_algebraMap (R := ↥F) (⟨_, hyF⟩ : ↥F)
  -- the generated field is algebraic over the basis field
  have hEle : E ≤ (algebraicClosure (↥F) G).restrictScalars K := by
    rw [hE, IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact (IntermediateField.mem_restrictScalars K).mpr (mem_algebraicClosure_iff.mpr (halg i))
  -- the jets of the germ of `y_n` lie in the generated field
  have hjetE : ∀ k : ℕ, (germDeriv u δ)^[k] ((y : ι → Ω) : G) ∈ E := by
    intro k
    induction k with
    | zero => exact hmem (Sum.inr (Sum.inr ()))
    | succ k ih =>
        rw [Function.iterate_succ_apply']
        exact germDeriv_mem_adjoin u δ hK s hderiv ih
  have hk := hEle (hjetE k)
  rw [IntermediateField.mem_restrictScalars, mem_algebraicClosure_iff,
    germDeriv_iterate_coe] at hk
  exact hk

end

end GaloisForLFunctions.HTGeometry
