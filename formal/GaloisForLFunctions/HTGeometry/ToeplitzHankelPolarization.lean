import GaloisForLFunctions.HTGeometry.ReflectionPositiveHankel

/-!
# Toeplitz--Hankel polarization boundary

A unitary or isometric orbit has a shift-invariant Gram kernel: simultaneous translation of both
indices leaves every Gram value unchanged.  A reflection-positive orbit has a Hankel kernel,
depending on the sum of the indices.  If one scalar kernel has both structures, its moment
sequence is two-periodic, so every Hankel block of size at least three is singular.

Thus an all-order strictly positive reflection carrier cannot be only a unitary phase orbit.  It
must contain a radial/self-adjoint semigroup polarization transverse to its phase polarization.
-/

namespace HTGeometry

noncomputable section

/-- The Hankel kernel generated by `m` is invariant under simultaneous forward translation of
both indices.  This is precisely the Toeplitz diagonal-shift law imposed on a Hankel kernel. -/
def HankelShiftInvariant (m : ℕ → ℝ) : Prop :=
  ∀ i j, m ((i + 1) + (j + 1)) = m (i + j)

/-- The intersection of scalar Hankel and Toeplitz shift laws is exactly two-periodic. -/
theorem hankelShiftInvariant_iff_twoPeriodic (m : ℕ → ℝ) :
    HankelShiftInvariant m ↔ ∀ n, m (n + 2) = m n := by
  constructor
  · intro h n
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using h 0 n
  · intro h i j
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using h (i + j)

/-- A two-periodic moment sequence has equal rows zero and two in every Hankel block of size at
least three. -/
theorem det_momentHankelMatrix_add_three_eq_zero
    (m : ℕ → ℝ) (hperiodic : ∀ n, m (n + 2) = m n) (n : ℕ) :
    (momentHankelMatrix m (n + 3)).det = 0 := by
  let i₀ : Fin (n + 3) := ⟨0, by omega⟩
  let i₂ : Fin (n + 3) := ⟨2, by omega⟩
  apply Matrix.det_zero_of_row_eq (i := i₀) (j := i₂)
  · intro h
    have := congrArg Fin.val h
    simp [i₀, i₂] at this
  · funext j
    change m ((i₀ : ℕ) + (j : ℕ)) = m ((i₂ : ℕ) + (j : ℕ))
    simp only [i₀, i₂]
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using (hperiodic (j : ℕ)).symm

/-- **Toeplitz--Hankel rank boundary.**  A diagonally shift-invariant Hankel kernel cannot be
strictly positive definite in dimension three or higher. -/
theorem not_posDef_momentHankelMatrix_add_three_of_shiftInvariant
    (m : ℕ → ℝ) (hshift : HankelShiftInvariant m) (n : ℕ) :
    ¬(momentHankelMatrix m (n + 3)).PosDef := by
  intro hpos
  have hdetpos := hpos.det_pos
  rw [det_momentHankelMatrix_add_three_eq_zero m
    ((hankelShiftInvariant_iff_twoPeriodic m).mp hshift) n] at hdetpos
  exact (lt_irrefl 0) hdetpos

/-- A shift-invariant Gram orbit realizing a Hankel sequence forces that sequence into the
two-periodic Toeplitz--Hankel intersection. -/
theorem hankelShiftInvariant_of_shiftInvariantGram
    {E : Type*} [SeminormedAddCommGroup E] [InnerProductSpace ℝ E]
    (m : ℕ → ℝ) (v : ℕ → E)
    (hgram : ∀ i j, inner ℝ (v i) (v j) = m (i + j))
    (hshift : ∀ i j,
      inner ℝ (v (i + 1)) (v (j + 1)) = inner ℝ (v i) (v j)) :
    HankelShiftInvariant m := by
  intro i j
  rw [← hgram (i + 1) (j + 1), ← hgram i j]
  exact hshift i j

/-- **Phase--radial polarization law.**  A shift-invariant Gram orbit cannot at the same time
realize an all-order strictly positive Hankel moment tower.  Already every block of size at least
three fails strict positivity. -/
theorem not_posDef_momentHankelMatrix_add_three_of_shiftInvariantGram
    {E : Type*} [SeminormedAddCommGroup E] [InnerProductSpace ℝ E]
    (m : ℕ → ℝ) (v : ℕ → E)
    (hgram : ∀ i j, inner ℝ (v i) (v j) = m (i + j))
    (hshift : ∀ i j,
      inner ℝ (v (i + 1)) (v (j + 1)) = inner ℝ (v i) (v j))
    (n : ℕ) :
    ¬(momentHankelMatrix m (n + 3)).PosDef :=
  not_posDef_momentHankelMatrix_add_three_of_shiftInvariant m
    (hankelShiftInvariant_of_shiftInvariantGram m v hgram hshift) n

end

end HTGeometry
