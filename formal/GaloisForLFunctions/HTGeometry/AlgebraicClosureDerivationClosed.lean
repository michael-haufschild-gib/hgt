import GaloisForLFunctions.HTGeometry.PolynomialTotalDerivative
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.FieldTheory.Minpoly.Field

/-!
# The relative algebraic closure absorbs the derivation

If the derivative of every element of an intermediate field `E` lands in the relative algebraic
closure of `E`, then that closure is closed under the derivation.

Differentiating the minimal polynomial of an algebraic element `y` gives

`(coefficient part) + p'(y) · y′ = 0`,

and `p'(y) ≠ 0` because `p` is the minimal polynomial and, in characteristic zero, `p'` is a nonzero
polynomial of smaller degree.  So `y′` is a quotient of two elements of the closure.

The hypothesis is stated for `E` rather than assuming `E` itself derivation-closed: the state field of
a composition is generated by elements whose derivatives are only *algebraic* over it, never in it.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

/-- Evaluating a polynomial whose coefficients lie in an intermediate field, at a point of that
field, stays inside it. -/
theorem eval_mem_of_coeff_mem {E L : Type*} [Field E] [Field L] [Algebra E L]
    (M : IntermediateField E L) {q : Polynomial L} (hq : ∀ i, q.coeff i ∈ M)
    {y : L} (hy : y ∈ M) : Polynomial.eval y q ∈ M := by
  rw [Polynomial.eval_eq_sum_range]
  refine sum_mem ?_
  intro i _
  exact M.mul_mem (hq i) (pow_mem hy i)

/-- **The relative algebraic closure is derivation-closed.**  If every derivative of an element of
`E` is algebraic over `E`, then so is every derivative of an element algebraic over `E`. -/
theorem deriv_mem_algebraicClosure {E L : Type*} [Field E] [Field L] [Algebra E L]
    [Differential L] [CharZero L]
    (hE : ∀ y : L, y ∈ (⊥ : IntermediateField E L) → y′ ∈ algebraicClosure E L)
    {y : L} (hy : y ∈ algebraicClosure E L) :
    y′ ∈ algebraicClosure E L := by
  classical
  haveI : CharZero E := (algebraMap E L).charZero
  have hyalg : IsAlgebraic E y := mem_algebraicClosure_iff.mp hy
  have hyint : IsIntegral E y := hyalg.isIntegral
  set p : Polynomial E := minpoly E y with hp
  have hp0 : p ≠ 0 := minpoly.ne_zero hyint
  have hpdeg : 0 < p.natDegree := minpoly.natDegree_pos hyint
  set P : Polynomial L := p.map (algebraMap E L) with hP
  have hPeval : Polynomial.eval y P = 0 := by
    rw [hP, Polynomial.eval_map, ← Polynomial.aeval_def]
    exact minpoly.aeval E y
  -- the derivative of the minimal polynomial does not annihilate `y`
  have hdp0 : Polynomial.derivative p ≠ 0 := by
    intro hcon
    have := Polynomial.derivative_eq_zero.mp hcon
    omega
  have hBne : Polynomial.eval y (Polynomial.derivative P) ≠ 0 := by
    rw [hP, Polynomial.derivative_map, Polynomial.eval_map, ← Polynomial.aeval_def]
    intro hcon
    have hle := minpoly.degree_le_of_ne_zero E y hdp0 hcon
    have hlt := Polynomial.degree_derivative_lt hp0
    rw [← hp] at hle
    exact absurd hle (not_le.mpr hlt)
  -- both parts of the chain rule lie in the closure
  have hEmem : ∀ e : E, (algebraMap E L e)′ ∈ algebraicClosure E L := by
    intro e
    refine hE _ ?_
    exact IntermediateField.algebraMap_mem _ e
  have hAmem : Polynomial.eval y (coeffDeriv P) ∈ algebraicClosure E L := by
    refine eval_mem_of_coeff_mem _ (fun i => ?_) hy
    rw [coeffDeriv_coeff, hP, Polynomial.coeff_map]
    exact hEmem (p.coeff i)
  have hBmem : Polynomial.eval y (Polynomial.derivative P) ∈ algebraicClosure E L := by
    refine eval_mem_of_coeff_mem _ (fun i => ?_) hy
    rw [hP, Polynomial.derivative_map, Polynomial.coeff_map]
    exact IntermediateField.algebraMap_mem _ _
  -- solve the chain rule for the derivative
  have hchain := deriv_eval P y
  rw [hPeval, map_zero] at hchain
  have hsolve : y′ = -Polynomial.eval y (coeffDeriv P)
      / Polynomial.eval y (Polynomial.derivative P) := by
    rw [eq_div_iff hBne]
    linear_combination -hchain
  rw [hsolve]
  exact div_mem (neg_mem hAmem) hBmem

/-! ## The closure is relatively algebraically closed -/

/-- An element algebraic over the relative algebraic closure already lies in it. -/
theorem mem_algebraicClosure_of_isAlgebraic {E L : Type*} [Field E] [Field L] [Algebra E L]
    {y : L} (hy : IsAlgebraic (algebraicClosure E L) y) : y ∈ algebraicClosure E L := by
  rw [mem_algebraicClosure_iff']
  exact isIntegral_trans y hy.isIntegral

/-- **A root of a nonzero polynomial with coefficients in the closure lies in the closure.** -/
theorem mem_algebraicClosure_of_root {E L : Type*} [Field E] [Field L] [Algebra E L]
    {e : ℕ} {A : ℕ → L} {y : L}
    (hA : ∀ c, A c ∈ algebraicClosure E L) (hAe : A e ≠ 0)
    (hrel : ∑ c ∈ Finset.range (e + 1), A c * y ^ c = 0) :
    y ∈ algebraicClosure E L := by
  classical
  set p : Polynomial (algebraicClosure E L) :=
    ∑ c ∈ Finset.range (e + 1),
      Polynomial.C (⟨A c, hA c⟩ : algebraicClosure E L) * Polynomial.X ^ c with hp
  have hcoeff : p.coeff e = (⟨A e, hA e⟩ : algebraicClosure E L) := by
    rw [hp, Polynomial.finsetSum_coeff]
    rw [Finset.sum_eq_single e]
    · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
    · intro c _ hce
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (fun hc => hce hc.symm), mul_zero]
    · intro hmem
      exact absurd (Finset.self_mem_range_succ e) hmem
  have hp0 : p ≠ 0 := by
    intro hzero
    apply hAe
    have := hcoeff
    rw [hzero, Polynomial.coeff_zero] at this
    exact congrArg Subtype.val this.symm
  have hev : Polynomial.aeval y p = 0 := by
    rw [hp, map_sum, ← hrel]
    refine Finset.sum_congr rfl ?_
    intro c _
    rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
    rfl
  exact mem_algebraicClosure_of_isAlgebraic ⟨p, hp0, hev⟩

end GaloisForLFunctions.HTGeometry
