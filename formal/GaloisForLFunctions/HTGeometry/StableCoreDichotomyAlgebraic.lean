import GaloisForLFunctions.HTGeometry.StableCoreClockCharacter
import GaloisForLFunctions.HTGeometry.ClockCharacterSigmaMobius

/-!
# The clock-character dichotomy at the core from an algebraic clock

The tightest reduction of the charged clock-character law: on the persistent core `T = ∩ₙ Φⁿ(F)`,
given a differential generator `q` (the differential Lüroth output, `T = C⟨q⟩`) and a clock family
whose scaling character at `q` is a nonzero polynomial of positive degree (the algebraicity of the
cocharacter), the constraint `Φ|T` acts on `q` by a Möbius transform (equation (3)) and — because the
charge is positive — by multiplication by a single constant (equation (4)).

Everything except the two structural inputs (the differential Lüroth generator `q` and the polynomial
algebraicity of the clock character) is discharged: `Φ|T` is the corpus stable-core differential
automorphism, and the differential structure of `T` is induced from the ambient field.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

/-- **Charged clock-character dichotomy at the core, from algebraicity.**  With `C` carrying the zero
derivation, on the persistent core generated by a differential-transcendental `q`, an algebraic clock
character of positive charge forces `Φ|T` to act by a Möbius transform and, being charged, by a single
scaling constant. -/
theorem persistent_core_dichotomy_from_algebraic
    {C F : Type*} [Field C] [IsAlgClosed C] [Field F] [CharZero F] [Algebra C F]
    [Differential C] [Differential F] [DifferentialAlgebra C F]
    (φ : F →ₐ[C] F) (hφ : ∀ x : F, φ x′ = (φ x)′)
    (ρ : C → (F ≃ₐ[C] F)) (hcommφ : ∀ lam : C, ∀ x, φ (ρ lam x) = ρ lam (φ x)) :
    letI : Differential (stableRangeCore φ) :=
      derivationClosedDifferential _ (derivationClosed_stableRangeCore φ hφ)
    ∀ {q : stableRangeCore φ} {P : Polynomial C},
      HypertranscendentalOver C q →
      differentialAdjoin C ({q} : Set (stableRangeCore φ)) = ⊤ →
      0 < P.natDegree →
      (∀ lam : C, lam ≠ 0 →
        (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q
          = algebraMap C (stableRangeCore φ) (P.eval lam) * q) →
      (∀ lam mu : C, lam ≠ 0 → mu ≠ 0 →
        (stableRangeCoreClockFamily φ ρ hcommφ (lam * mu)).toAlgHom q
          = (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom
            ((stableRangeCoreClockFamily φ ρ hcommφ mu).toAlgHom q)) →
      (∀ lam : C, lam ≠ 0 →
        (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv.toAlgHom
            ((stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom q)
          = (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom
            ((stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv.toAlgHom q)) →
      (∃ a b c d : C, a * d - b * c ≠ 0 ∧
          (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv q
              * (algebraMap C (stableRangeCore φ) c * q + algebraMap C (stableRangeCore φ) d)
            = algebraMap C (stableRangeCore φ) a * q + algebraMap C (stableRangeCore φ) b)
        ∧ (∃ a : C,
            (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv q
              = algebraMap C (stableRangeCore φ) a * q) := by
  letI : Differential (stableRangeCore φ) :=
    derivationClosedDifferential _ (derivationClosed_stableRangeCore φ hφ)
  haveI : DifferentialAlgebra C (stableRangeCore φ) := by
    refine ⟨fun c => ?_⟩
    apply Subtype.ext
    rw [derivationClosedDifferential_apply]
    show ((algebraMap C F c))′ = ((algebraMap C F c′))
    exact DifferentialAlgebra.deriv_algebraMap c
  intro q P hq hqtop hPdeg halg hmul hcomm
  refine ⟨differentialAlgEquiv_generator_mobius (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv
      hq hqtop (stableRangeCoreDifferentialAlgEquiv φ hφ).map_deriv', ?_⟩
  exact charged_clock_polynomial_forces_multiplicative_of_nonzero
    (stableRangeCoreDifferentialAlgEquiv φ hφ).toAlgEquiv
    (fun lam => (stableRangeCoreClockFamily φ ρ hcommφ lam).toAlgHom)
    hq hqtop (stableRangeCoreDifferentialAlgEquiv φ hφ).map_deriv' hPdeg halg hmul hcomm

end GaloisForLFunctions.HTGeometry
