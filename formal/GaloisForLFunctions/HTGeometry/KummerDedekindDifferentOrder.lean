import GaloisForLFunctions.HTGeometry.IdealQuotientTransport
import Mathlib.NumberTheory.KummerDedekind

/-!
# The order of the different at a prime, for a monogenic order

For a monogenic extension `S = R[x]` of a Dedekind domain over an integrally closed base, the
Kummer–Dedekind theorem matches the primes of `S` above a maximal ideal `I` with the irreducible
factors of the reduced minimal polynomial, preserving multiplicities.  Combining that with the
polynomial computation — an irreducible factor of multiplicity `e` divides the derivative exactly
`e − 1` times in characteristic zero — gives

`aeval x (derivative (minpoly R x)) ∉ Qᵉ`,

which is the upper half of `ord_Q(𝔡) = e − 1`.  The lower half is mathlib's
`pow_sub_one_dvd_differentIdeal`, and for a monogenic order the different is generated by exactly
this element.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial UniqueFactorizationMonoid

/-- A finite multiplicity exhibits the cofactor. -/
theorem exists_factor_of_emultiplicity_eq {M : Type*} [CommSemiring M] {a b : M} {n : ℕ}
    (h : emultiplicity a b = (n : ℕ∞)) : ∃ g, b = a ^ n * g ∧ ¬ a ∣ g := by
  obtain ⟨hdvd, hndvd⟩ := emultiplicity_eq_coe.mp h
  obtain ⟨g, hg⟩ := hdvd
  refine ⟨g, hg, fun hc => hndvd ?_⟩
  obtain ⟨c, hc'⟩ := hc
  exact ⟨c, by rw [hg, hc']; ring⟩

attribute [local instance] Ideal.Quotient.field

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {x : S} {I : Ideal R}
variable [IsDomain R] [IsIntegrallyClosed R] [IsDedekindDomain S] [Module.IsTorsionFree R S]

set_option maxHeartbeats 1000000 in
/-- **The derivative of the minimal polynomial has order at most `e − 1` at a prime of
ramification index `e`.** -/
theorem not_mem_pow_aeval_derivative (hI : I.IsMaximal) (hI' : I ≠ ⊥)
    [CharZero (R ⧸ I)] (hgen : Algebra.adjoin R ({x} : Set S) = ⊤) (hx' : IsIntegral R x)
    {Q : Ideal S} (hQ : Q ∈ normalizedFactors (I.map (algebraMap R S)))
    {e : ℕ} (he : emultiplicity Q (I.map (algebraMap R S)) = (e : ℕ∞)) :
    Polynomial.aeval x (derivative (minpoly R x)) ∉ Q ^ e := by
  classical
  have hx : (conductor R x).comap (algebraMap R S) ⊔ I = ⊤ := by
    rw [conductor_eq_top_of_adjoin_eq_top hgen, Ideal.comap_top, top_sup_eq]
  -- the matching irreducible factor
  set hbar : (R ⧸ I)[X] :=
    ↑(KummerDedekind.normalizedFactorsMapEquivNormalizedFactorsMinPolyMk hI hI' hx hx' ⟨Q, hQ⟩)
    with hbardef
  have hbarmem : hbar ∈ normalizedFactors (Polynomial.map (Ideal.Quotient.mk I) (minpoly R x)) :=
    (KummerDedekind.normalizedFactorsMapEquivNormalizedFactorsMinPolyMk hI hI' hx hx'
      ⟨Q, hQ⟩).2
  have hirr : Irreducible hbar := irreducible_of_normalized_factor _ hbarmem
  -- multiplicities agree
  have hmul : emultiplicity hbar (Polynomial.map (Ideal.Quotient.mk I) (minpoly R x))
      = (e : ℕ∞) := by
    rw [← KummerDedekind.emultiplicity_factors_map_eq_emultiplicity hI hI' hx hx' hQ, he]
  obtain ⟨g, hgeq, hgn⟩ := exists_factor_of_emultiplicity_eq hmul
  -- a lift of the factor
  obtain ⟨P, hP⟩ := Polynomial.map_surjective (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective hbar
  have hPmem : Polynomial.map (Ideal.Quotient.mk I) P
      ∈ normalizedFactors (Polynomial.map (Ideal.Quotient.mk I) (minpoly R x)) := by
    rw [hP]
    exact hbarmem
  -- the prime is generated by the lift together with the extended ideal
  have hspan : Q = Ideal.span {Polynomial.aeval x P} ⊔ I.map (algebraMap R S) := by
    have hsymm := KummerDedekind.normalizedFactorsMapEquivNormalizedFactorsMinPolyMk_symm_apply_eq_span
      (x := x) hI hPmem hI' hx hx'
    have hsub : (⟨Polynomial.map (Ideal.Quotient.mk I) P, hPmem⟩ :
        {d | d ∈ normalizedFactors (Polynomial.map (Ideal.Quotient.mk I) (minpoly R x))})
        = KummerDedekind.normalizedFactorsMapEquivNormalizedFactorsMinPolyMk hI hI' hx hx' ⟨Q, hQ⟩ :=
      Subtype.ext (hP.trans hbardef)
    rw [hsub, Equiv.symm_apply_apply] at hsymm
    have hQeq : Q = Ideal.span (↑(I.map (algebraMap R S)) ∪ {Polynomial.aeval x P}) := hsymm
    rw [hQeq, Ideal.span_union, Ideal.span_eq, sup_comm]
  -- the two evaluation identities
  have hy : KummerDedekind.quotMapEquivQuotQuotMap hx hx'
      (Ideal.Quotient.mk (I.map (algebraMap R S)) (Polynomial.aeval x P))
      = Ideal.Quotient.mk
        (Ideal.span {Polynomial.map (Ideal.Quotient.mk I) (minpoly R x)}) hbar := by
    have h1 := KummerDedekind.quotMapEquivQuotQuotMap_symm_apply hx hx' P
    rw [← h1, RingEquiv.apply_symm_apply, hP]
  have hz : KummerDedekind.quotMapEquivQuotQuotMap hx hx'
      (Ideal.Quotient.mk (I.map (algebraMap R S))
        (Polynomial.aeval x (derivative (minpoly R x))))
      = Ideal.Quotient.mk (Ideal.span {Polynomial.map (Ideal.Quotient.mk I) (minpoly R x)})
        (derivative (Polynomial.map (Ideal.Quotient.mk I) (minpoly R x))) := by
    have h1 := KummerDedekind.quotMapEquivQuotQuotMap_symm_apply hx hx' (derivative (minpoly R x))
    rw [← h1, RingEquiv.apply_symm_apply, Polynomial.derivative_map]
  -- the extended ideal is inside the power
  have hle : I.map (algebraMap R S) ≤ Q ^ e :=
    Ideal.dvd_iff_le.mp (emultiplicity_eq_coe.mp he).1
  -- the multiplicity is at least one
  have he1 : 1 ≤ e := by
    by_contra hc
    have he0 : e = 0 := by omega
    rw [he0] at he
    have hdvd : Q ∣ I.map (algebraMap R S) := dvd_of_mem_normalizedFactors hQ
    have := (emultiplicity_eq_coe.mp he).2
    rw [zero_add, pow_one] at this
    exact this hdvd
  exact not_mem_pow_of_deriv (KummerDedekind.quotMapEquivQuotQuotMap hx hx') hspan hy hirr he1
    hgn hgeq hle hz

end GaloisForLFunctions.HTGeometry
