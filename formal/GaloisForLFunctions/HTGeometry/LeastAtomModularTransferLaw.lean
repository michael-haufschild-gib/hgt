import Mathlib.Analysis.SpecialFunctions.Pow.Complex
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
# Least-atom modular transfer law

A positive source whose least nontrivial atom has scale `q` and whose
marked source coordinate is `c` carries the half-density-normalized
character

`q^(c/2-s)`.

The character is unitary exactly on the self-dual line `Re s = c/2`.
Reflection about that line pairs arbitrary characters reciprocally, so
reflection symmetry alone is weaker than pointwise unitarity.
-/

open Complex
open scoped Real

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Half-density-normalized character generated by a least atom of
scale `q` and a real marked source coordinate `c`. -/
def leastAtomTransferCharacter (q c : ℝ) (s : ℂ) : ℂ :=
  (q : ℂ) ^ (((c / 2 : ℝ) : ℂ) - s)

/-- Reflection about the source-selected vertical line `Re s = c/2`. -/
def leastAtomSourceReflection (c : ℝ) (s : ℂ) : ℂ :=
  (c : ℂ) - star s

/-- The modulus of the least-atom character is its exact transverse
Lyapunov character. -/
theorem norm_leastAtomTransferCharacter
    {q : ℝ} (hq : 0 < q) (c : ℝ) (s : ℂ) :
    ‖leastAtomTransferCharacter q c s‖ =
      q ^ (c / 2 - s.re) := by
  rw [leastAtomTransferCharacter,
    Complex.norm_cpow_eq_rpow_re_of_pos hq,
    Complex.sub_re]
  norm_num

/-- For atom scale larger than one, the self-dual line is exactly the
ordinary unitary locus. -/
theorem norm_leastAtomTransferCharacter_eq_one_iff
    {q : ℝ} (hq : 1 < q) (c : ℝ) (s : ℂ) :
    ‖leastAtomTransferCharacter q c s‖ = 1 ↔
      s.re = c / 2 := by
  rw [norm_leastAtomTransferCharacter (lt_trans (by norm_num) hq) c s,
    ← Real.rpow_zero q,
    Real.rpow_right_inj (lt_trans (by norm_num) hq) hq.ne']
  constructor <;> intro h <;> linarith

/-- Points to the right of the self-dual line are exactly the strictly
contractive characters. -/
theorem norm_leastAtomTransferCharacter_lt_one_iff
    {q : ℝ} (hq : 1 < q) (c : ℝ) (s : ℂ) :
    ‖leastAtomTransferCharacter q c s‖ < 1 ↔
      c / 2 < s.re := by
  have hnlt : ¬ q < 1 := not_lt_of_ge hq.le
  rw [norm_leastAtomTransferCharacter (lt_trans (by norm_num) hq) c s,
    Real.rpow_lt_one_iff_of_pos (lt_trans (by norm_num) hq)]
  simp only [hq, true_and, hnlt, false_and, or_false]
  constructor <;> intro h <;> linarith

/-- Points to the left of the self-dual line are exactly the strictly
expansive characters. -/
theorem one_lt_norm_leastAtomTransferCharacter_iff
    {q : ℝ} (hq : 1 < q) (c : ℝ) (s : ℂ) :
    1 < ‖leastAtomTransferCharacter q c s‖ ↔
      s.re < c / 2 := by
  have hnlt : ¬ q < 1 := not_lt_of_ge hq.le
  rw [norm_leastAtomTransferCharacter (lt_trans (by norm_num) hq) c s,
    Real.one_lt_rpow_iff_of_pos (lt_trans (by norm_num) hq)]
  simp only [hq, true_and, hnlt, false_and, or_false]
  constructor <;> intro h <;> linarith

/-- Source reflection pairs least-atom characters reciprocally.  The
pair product is one at every spectral point, not only on the unitary
line. -/
theorem leastAtomTransferCharacter_reflection_pair
    {q : ℝ} (hq : 0 < q) (c : ℝ) (s : ℂ) :
    leastAtomTransferCharacter q c s *
        star (leastAtomTransferCharacter q c
          (leastAtomSourceReflection c s)) = 1 := by
  have harg : ((q : ℂ)).arg ≠ Real.pi := by
    rw [Complex.arg_ofReal_of_nonneg hq.le]
    exact Real.pi_ne_zero.symm
  have hstar (z : ℂ) :
      star ((q : ℂ) ^ z) =
        (q : ℂ) ^ (star z) := by
    rw [Complex.star_def]
    symm
    simpa only [Complex.conj_ofReal] using
      Complex.cpow_conj (q : ℂ) z harg
  rw [leastAtomTransferCharacter,
    leastAtomTransferCharacter, hstar,
    ← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr hq.ne')]
  convert Complex.cpow_zero (q : ℂ) using 2
  simp [leastAtomSourceReflection]
  ring

/-- Complete least-atom phase classification: every point belongs to
exactly one of the contractive, unitary, or expansive phases, with the
unitary phase equal to the self-dual line. -/
theorem leastAtomTransferCharacter_phase_trichotomy
    {q : ℝ} (hq : 1 < q) (c : ℝ) (s : ℂ) :
    (c / 2 < s.re ∧
        ‖leastAtomTransferCharacter q c s‖ < 1) ∨
      (s.re = c / 2 ∧
        ‖leastAtomTransferCharacter q c s‖ = 1) ∨
      (s.re < c / 2 ∧
        1 < ‖leastAtomTransferCharacter q c s‖) := by
  rcases lt_trichotomy (c / 2) s.re with hright | hline | hleft
  · exact Or.inl
      ⟨hright,
        (norm_leastAtomTransferCharacter_lt_one_iff hq c s).2 hright⟩
  · exact Or.inr (Or.inl
      ⟨hline.symm,
        (norm_leastAtomTransferCharacter_eq_one_iff hq c s).2 hline.symm⟩)
  · exact Or.inr (Or.inr
      ⟨hleft,
        (one_lt_norm_leastAtomTransferCharacter_iff hq c s).2 hleft⟩)

end

end GaloisForLFunctions.HTGeometry
