import GaloisForLFunctions.HTGeometry.DifferentialAdjoinPresentation
import GaloisForLFunctions.HTGeometry.UpperEndJetTransport
import GaloisForLFunctions.HTGeometry.UpperEndLiteralLinearIndependence
import GaloisForLFunctions.HTGeometry.DifferentialJetAlgebra
import GaloisForLFunctions.HTGeometry.JetOrderRegrouping

/-!
# Presentation of the digamma differential field

Every element of the differential field generated over `ℂ` by the digamma germ is a quotient of two
polynomials, with constant coefficients, in finitely many digamma jets.  Combined with the transport
of jets to iterated derivatives this says: an element of the field is a rational expression in
finitely many polygammas, which is exactly the object the asymptotic residue theorems consume.
-/

open Filter Set Topology Function
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance digammaPresentationDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance digammaPresentationDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance digammaPresentationComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-- **The digamma field is generated by the digamma jets.** -/
theorem differentialJetSet_digamma :
    differentialJetSet ({digammaMero} : Set upperEndMeroField)
      = Set.range digammaJetMero :=
  differentialJetSet_singleton digammaMero

/-- **Presentation of an element of the digamma field.**  Numerator and denominator are polynomials
with complex constant coefficients in finitely many digamma jets. -/
theorem exists_digamma_jetPoly_quotient {x : upperEndMeroField}
    (hx : x ∈ differentialAdjoin ℂ ({digammaMero} : Set upperEndMeroField)) :
    ∃ (M₁ N₁ M₂ N₂ : ℕ) (c₁ : Fin M₁ → ℂ) (e₁ : Fin M₁ → Fin N₁ → ℕ) (n₁ : Fin N₁ → ℕ)
      (c₂ : Fin M₂ → ℂ) (e₂ : Fin M₂ → Fin N₂ → ℕ) (n₂ : Fin N₂ → ℕ),
      x = (∑ α : Fin M₁, algebraMap ℂ upperEndMeroField (c₁ α)
              * ∏ i : Fin N₁, digammaJetMero (n₁ i) ^ e₁ α i)
          / (∑ α : Fin M₂, algebraMap ℂ upperEndMeroField (c₂ α)
              * ∏ i : Fin N₂, digammaJetMero (n₂ i) ^ e₂ α i) := by
  classical
  obtain ⟨M₁, N₁, M₂, N₂, a₁, e₁, h₁, a₂, e₂, h₂, ha₁, hh₁, ha₂, hh₂, hx'⟩ :=
    exists_fin_jetPoly_quotient_mem ℂ hx
  rw [differentialJetSet_digamma] at hh₁ hh₂
  choose c₁ hc₁ using ha₁
  choose c₂ hc₂ using ha₂
  choose n₁ hn₁ using hh₁
  choose n₂ hn₂ using hh₂
  refine ⟨M₁, N₁, M₂, N₂, c₁, e₁, n₁, c₂, e₂, n₂, ?_⟩
  rw [hx']
  congr 1
  · exact Finset.sum_congr rfl fun α _ => by
      rw [hc₁ α]
      exact congrArg _ (Finset.prod_congr rfl fun i _ => by rw [hn₁ i])
  · exact Finset.sum_congr rfl fun α _ => by
      rw [hc₂ α]
      exact congrArg _ (Finset.prod_congr rfl fun i _ => by rw [hn₂ i])

/-- **Each jet in the presentation is a germ of a polygamma.**  Together with the presentation this
puts every element of the digamma field on the analytic footing of the residue estimates. -/
theorem exists_digamma_jet_germ (n : ℕ) :
    ∃ a : upperEndAnalyticSubring,
      digammaJetMero n = algebraMap upperEndAnalyticSubring upperEndMeroField a
        ∧ ((a : upperEndAnalyticSubring) : Germ upperEndFilter ℂ)
            = (iteratedDeriv n Complex.digamma : Germ upperEndFilter ℂ) :=
  digammaJetMero_germ n

/-- The complex constants of the field come from constant analytic germs. -/
theorem algebraMap_complex_eq (c : ℂ) :
    algebraMap ℂ upperEndMeroField c
      = algebraMap upperEndAnalyticSubring upperEndMeroField
        (upperEndPolyToAnalytic (Polynomial.C c)) := rfl

/-- A constant analytic germ is the germ of the constant function. -/
theorem polyC_subtype (c : ℂ) :
    upperEndAnalyticSubring.subtype (upperEndPolyToAnalytic (Polynomial.C c))
      = Germ.coeRingHom upperEndFilter (Function.const ℂ c) := by
  change Germ.coeRingHom upperEndFilter (fun z : ℂ => (Polynomial.C c).eval z)
    = Germ.coeRingHom upperEndFilter (Function.const ℂ c)
  simp only [Polynomial.eval_C]
  rfl

/-- **Germ of a jet polynomial.**  A polynomial with constant coefficients in analytic germs is the
germ of the corresponding pointwise polynomial in their representatives. -/
theorem subtype_sum_prod {M N : ℕ} (c : Fin M → ℂ) (e : Fin M → Fin N → ℕ)
    (u : Fin N → ℂ → ℂ) (A : Fin N → upperEndAnalyticSubring)
    (hA : ∀ i, upperEndAnalyticSubring.subtype (A i) = Germ.coeRingHom upperEndFilter (u i)) :
    upperEndAnalyticSubring.subtype
        (∑ α : Fin M, upperEndPolyToAnalytic (Polynomial.C (c α)) * ∏ i : Fin N, A i ^ e α i)
      = Germ.coeRingHom upperEndFilter
          (fun z : ℂ => ∑ α : Fin M, c α * ∏ i : Fin N, u i z ^ e α i) := by
  have hfun : (fun z : ℂ => ∑ α : Fin M, c α * ∏ i : Fin N, u i z ^ e α i)
      = ∑ α : Fin M, (Function.const ℂ (c α)) * ∏ i : Fin N, (u i) ^ e α i := by
    funext z
    simp [Finset.sum_apply, Finset.prod_apply]
  rw [hfun, map_sum, map_sum]
  refine Finset.sum_congr rfl fun α _ => ?_
  rw [map_mul, map_mul, map_prod, map_prod, polyC_subtype]
  refine congrArg _ (Finset.prod_congr rfl fun i _ => ?_)
  rw [map_pow, map_pow, hA i]

/-- **A jet polynomial of the digamma field is an analytic germ of a polygamma polynomial.** -/
theorem exists_jetPoly_analytic {M N : ℕ} (c : Fin M → ℂ) (e : Fin M → Fin N → ℕ) (n : Fin N → ℕ) :
    ∃ a : upperEndAnalyticSubring,
      (∑ α : Fin M, algebraMap ℂ upperEndMeroField (c α)
          * ∏ i : Fin N, digammaJetMero (n i) ^ e α i)
        = algebraMap upperEndAnalyticSubring upperEndMeroField a
      ∧ upperEndAnalyticSubring.subtype a
        = Germ.coeRingHom upperEndFilter
          (fun z : ℂ => ∑ α : Fin M, c α
            * ∏ i : Fin N, iteratedDeriv (n i) Complex.digamma z ^ e α i) := by
  refine ⟨∑ α : Fin M, upperEndPolyToAnalytic (Polynomial.C (c α))
      * ∏ i : Fin N, (upperEndAnalyticDeriv^[n i] digammaAnalytic) ^ e α i, ?_, ?_⟩
  · rw [map_sum]
    refine Finset.sum_congr rfl fun α _ => ?_
    rw [map_mul, map_prod, ← algebraMap_complex_eq]
    refine congrArg _ (Finset.prod_congr rfl fun i _ => ?_)
    rw [map_pow, ← digammaJetMero_eq_algebraMap]
  · exact subtype_sum_prod c e (fun i => iteratedDeriv (n i) Complex.digamma) _
      (fun i => digammaJet_analytic_coe (n i))

/-- **An element of the digamma jet algebra is the germ of a polygamma polynomial.**  Collecting the
exponents by order turns the presentation into a polynomial in `psi, psi', …, psi^{(K)}` with complex
constant coefficients, and that polynomial is analytic on an upper half-plane. -/
theorem exists_digamma_algebra_analytic {y : upperEndMeroField}
    (hy : y ∈ differentialJetAlgebra ℂ ({digammaMero} : Set upperEndMeroField)) :
    ∃ (M K : ℕ) (c : Fin M → ℂ) (E : Fin M → Fin (K + 1) → ℕ) (a : upperEndAnalyticSubring),
      y = algebraMap upperEndAnalyticSubring upperEndMeroField a
        ∧ upperEndAnalyticSubring.subtype a
          = Germ.coeRingHom upperEndFilter
            (fun z : ℂ => ∑ α : Fin M, c α
              * ∏ j : Fin (K + 1), iteratedDeriv (j : ℕ) Complex.digamma z ^ E α j) := by
  classical
  obtain ⟨M, N, b, e, h, hb, hh, hy'⟩ := exists_fin_jetPoly_of_mem_algebra hy
  rw [differentialJetSet_digamma] at hh
  choose c hc using hb
  choose n hn using hh
  obtain ⟨K, E, hE⟩ :=
    exists_canonical_exponents_family (R := upperEndMeroField) digammaJetMero n e
  obtain ⟨a, ha, hgerm⟩ := exists_jetPoly_analytic c E (fun j : Fin (K + 1) => (j : ℕ))
  refine ⟨M, K, c, E, a, ?_, hgerm⟩
  rw [← ha, hy']
  refine Finset.sum_congr rfl fun α _ => ?_
  rw [hc α, ← hE α]
  exact congrArg _ (Finset.prod_congr rfl fun i _ => by rw [hn i])

end

end GaloisForLFunctions.HTGeometry
