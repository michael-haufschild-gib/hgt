import Mathlib.FieldTheory.SplittingField.Construction
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-!
# The splitting field of a product is the compositum of the two splitting fields

The roots of a product are the roots of the factors, so the field generated by all of them is the
compositum of the two fields generated separately.

This produces the ambient field in which a splitting field and a second extension both sit with
compositum everything, which is the setting of the base change step.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F : Type*} [Field F] {L : Type*} [Field L] [Algebra F L]

theorem rootSet_mul {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0) :
    (p * q).rootSet L = p.rootSet L ∪ q.rootSet L := by
  ext x
  simp only [Polynomial.mem_rootSet, Set.mem_union, map_mul, mul_eq_zero]
  constructor
  · rintro ⟨-, h⟩
    rcases h with h | h
    · exact Or.inl ⟨hp, h⟩
    · exact Or.inr ⟨hq, h⟩
  · rintro (⟨-, h⟩ | ⟨-, h⟩)
    · exact ⟨mul_ne_zero hp hq, Or.inl h⟩
    · exact ⟨mul_ne_zero hp hq, Or.inr h⟩

theorem adjoin_rootSet_eq_top (f : Polynomial F) [Polynomial.IsSplittingField F L f] :
    IntermediateField.adjoin F (f.rootSet L) = ⊤ := by
  refine le_antisymm le_top fun x _ => ?_
  have hx : x ∈ Algebra.adjoin F (f.rootSet L) := by
    rw [Polynomial.IsSplittingField.adjoin_rootSet L f]
    exact Algebra.mem_top
  exact IntermediateField.algebra_adjoin_le_adjoin F (f.rootSet L) hx

/-- **The splitting field of a product is the compositum.** -/
theorem sup_adjoin_rootSet_eq_top {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)] :
    IntermediateField.adjoin F (p.rootSet L) ⊔ IntermediateField.adjoin F (q.rootSet L) = ⊤ := by
  rw [← IntermediateField.adjoin_union, ← rootSet_mul hp hq]
  exact adjoin_rootSet_eq_top (p * q)

end GaloisForLFunctions.HTGeometry
