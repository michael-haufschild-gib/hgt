import GaloisForLFunctions.HTGeometry.SymmetricCoefficientNonSquare

/-!
# The coefficient field is a rational function field in the coefficients

Sending the `i`-th variable to the `(i+1)`-st elementary symmetric function embeds a polynomial ring
in `d` variables into the field of rational functions in the roots, injectively, so it extends to an
embedding of the whole rational function field in `d` variables.

Its image is the field generated by the coefficients of the generic polynomial.  So the coefficient
field is itself a rational function field, with the coefficients as its variables, and the
square-class computation carried out in that model transports to it.

This closes the square-class step of the even case on the coefficient field of the generic
polynomial itself: the discriminant times the constant coefficient is not a square there.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K : Type*} [Field K] {d : ℕ}

/-- The polynomial ring in `d` variables, mapped to the rational functions in the roots by sending
the variables to the elementary symmetric functions. -/
noncomputable def esymmEmbedding (K : Type*) [Field K] (d : ℕ) :
    MvPolynomial (Fin d) K →ₐ[K] SymmetricRationalField K d :=
  MvPolynomial.aeval (esymmGen K d)

theorem esymmEmbedding_apply (p : MvPolynomial (Fin d) K) :
    esymmEmbedding K d p =
      algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
        (MvPolynomial.aeval (fun i : Fin d => MvPolynomial.esymm (Fin d) K ((i : ℕ) + 1)) p) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      simp only [esymmEmbedding, MvPolynomial.aeval_C]
      exact IsScalarTower.algebraMap_apply K (MvPolynomial (Fin d) K)
        (SymmetricRationalField K d) a
  | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
  | mul_X p i hp =>
      rw [map_mul, map_mul, map_mul, hp]
      simp only [esymmEmbedding, MvPolynomial.aeval_X, esymmGen]

theorem esymmEmbedding_injective : Function.Injective (esymmEmbedding K d) := by
  intro p q hpq
  rw [esymmEmbedding_apply, esymmEmbedding_apply] at hpq
  have hfrac : Function.Injective
      (algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)) :=
    IsFractionRing.injective _ _
  have h := hfrac hpq
  have hval : ((esymmAlgEquiv K d p : MvPolynomial.symmetricSubalgebra (Fin d) K) :
      MvPolynomial (Fin d) K) =
      ((esymmAlgEquiv K d q : MvPolynomial.symmetricSubalgebra (Fin d) K) :
        MvPolynomial (Fin d) K) := by
    rw [esymmAlgEquiv_apply_coe, esymmAlgEquiv_apply_coe]
    exact h
  exact (esymmAlgEquiv K d).injective (Subtype.ext hval)

/-- **The coefficient field as a rational function field.**  The embedding of the polynomial ring in
the coefficients extends to the whole field of rational functions in them. -/
noncomputable def esymmFracEmbedding (K : Type*) [Field K] (d : ℕ) :
    FractionRing (MvPolynomial (Fin d) K) →+* SymmetricRationalField K d :=
  IsFractionRing.lift (g := (esymmEmbedding K d).toRingHom) esymmEmbedding_injective

theorem esymmFracEmbedding_algebraMap (p : MvPolynomial (Fin d) K) :
    esymmFracEmbedding K d
        (algebraMap (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K)) p) =
      esymmEmbedding K d p :=
  IsFractionRing.lift_algebraMap esymmEmbedding_injective p

theorem esymmFracEmbedding_injective :
    Function.Injective (esymmFracEmbedding K d) :=
  (esymmFracEmbedding K d).injective

/-- The image of the discriminant model is the discriminant. -/
theorem esymmFracEmbedding_discCoeffPoly :
    esymmFracEmbedding K d
        (algebraMap (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K))
          (discCoeffPoly K d)) =
      algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
        (vandermondePoly K d * vandermondePoly K d) := by
  rw [esymmFracEmbedding_algebraMap, esymmEmbedding_apply]
  congr 1
  rw [← esymmAlgEquiv_apply_coe]
  exact esymmAlgEquiv_discCoeffPoly

/-- The image of the top variable is the constant coefficient. -/
theorem esymmFracEmbedding_X_topIndex (hd : 0 < d) :
    esymmFracEmbedding K d
        (algebraMap (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K))
          (MvPolynomial.X (topIndex d hd))) =
      esymmGen K d (topIndex d hd) := by
  rw [esymmFracEmbedding_algebraMap, esymmEmbedding, MvPolynomial.aeval_X]

/-- **The discriminant times the constant coefficient is not a square in the coefficient field.**
This is the square-class step of the even case, on the coefficient field of the generic polynomial
itself. -/
theorem no_sqrt_disc_mul_esymmTop (hd : 0 < d) :
    ¬ ∃ t : SymmetricRationalField K d,
      t ∈ (esymmFracEmbedding K d).fieldRange ∧
        algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
            (vandermondePoly K d * vandermondePoly K d) *
          esymmGen K d (topIndex d hd) = t * t := by
  rintro ⟨t, ⟨u, rfl⟩, ht⟩
  refine SymmetricCoefficientNonSquare.no_sqrt_discCoeffPoly_mul_topIndex (K := K) hd ⟨u, ?_⟩
  refine esymmFracEmbedding_injective (K := K) (d := d) ?_
  rw [map_mul, map_mul, esymmFracEmbedding_discCoeffPoly, esymmFracEmbedding_X_topIndex hd]
  exact ht

/-- The image of the coefficient field, as an intermediate field. -/
noncomputable def esymmRangeField (K : Type*) [Field K] (d : ℕ) :
    IntermediateField K (SymmetricRationalField K d) :=
  Subfield.toIntermediateField (esymmFracEmbedding K d).fieldRange (by
    intro x
    refine ⟨algebraMap K (FractionRing (MvPolynomial (Fin d) K)) x, ?_⟩
    conv_lhs => rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin d) K)
      (FractionRing (MvPolynomial (Fin d) K))]
    rw [esymmFracEmbedding_algebraMap]
    simp only [esymmEmbedding, MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C])

theorem esymmGen_mem_esymmRangeField (i : Fin d) :
    esymmGen K d i ∈ esymmRangeField K d := by
  refine ⟨algebraMap (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K))
    (MvPolynomial.X i), ?_⟩
  rw [esymmFracEmbedding_algebraMap, esymmEmbedding, MvPolynomial.aeval_X]

/-- **The coefficient field lies in the image.**  Every rational function of the coefficients is a
rational function of the variables of the model. -/
theorem esymmField_le_esymmRangeField :
    esymmField K d ≤ esymmRangeField K d := by
  rw [esymmField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨i, rfl⟩
  exact esymmGen_mem_esymmRangeField i

/-- **The square-class step on the coefficient field of the generic polynomial.**  The discriminant
times the constant coefficient has no square root among the rational functions of the
coefficients. -/
theorem no_sqrt_disc_mul_esymmTop_of_mem_esymmField (hd : 0 < d) :
    ¬ ∃ t ∈ esymmField K d,
      algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
          (vandermondePoly K d * vandermondePoly K d) *
        esymmGen K d (topIndex d hd) = t * t := by
  rintro ⟨t, htmem, ht⟩
  exact no_sqrt_disc_mul_esymmTop hd ⟨t, esymmField_le_esymmRangeField htmem, ht⟩

/-- **The square-class step on the symmetric part.**  The symmetric part of the rational function
field is the coefficient field, so the same statement holds there. -/
theorem no_sqrt_disc_mul_esymmTop_of_mem_symmetricPartField (hd : 0 < d) :
    ¬ ∃ t ∈ symmetricPartField K d,
      algebraMap (MvPolynomial (Fin d) K) (SymmetricRationalField K d)
          (vandermondePoly K d * vandermondePoly K d) *
        esymmGen K d (topIndex d hd) = t * t := by
  rw [symmetricPartField_eq_esymmField]
  exact no_sqrt_disc_mul_esymmTop_of_mem_esymmField hd

end GaloisForLFunctions.HTGeometry
