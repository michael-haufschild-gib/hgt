import GaloisForLFunctions.HTGeometry.NormalClosureSheetAction

/-!
# Descent of the sheet action along an algebraic extension of constants

Let `F ⊆ K` be an algebraic extension of characteristic-zero fields and `β : E → E'` an `F`-algebra
map from an `F`-field to a `K`-field.  Let `O ⊆ S` be intermediate fields of `E/F` generated by
families `y` and `x`, and `O' ⊆ S'` the intermediate fields of `E'/K` generated by `β ∘ y` and
`β ∘ x`, with `β ∘ x` and `β ∘ y` algebraically independent over `K` and `#x ≤ #y`.

Then `[S:O] = [S':O']`, and a full symmetric sheet action for `S'/O'` descends to `S/O`.

The degree inequality `[S:O] ≤ [S':O']` is the substantial step.  An `O`-embedding `σ` of `S` into
an algebraic closure `Ω` of `S'` sends `x` to a family whose generated field over `K` contains the
images `σ(y) = β(y)`, which are independent over `K`; since `#x ≤ #y` the family `σ(x)` is itself
independent over `K`, so the rational field `S' = K(β x)` maps to `Ω` by `β x ↦ σ x`.  That map is
`O'`-linear because it agrees with the structure map on the generators `β y`, and it extends `σ`
because the two agree on the generators `x` of `S` over `O`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F K E E' : Type*} [Field F] [Field K] [Field E] [Field E']
  [Algebra F K] [Algebra F E] [Algebra K E'] [Algebra F E'] [IsScalarTower F K E']

/-- An `F`-algebra map carries the `F`-field generated by a family into the `K`-field generated by
its image. -/
theorem map_mem_adjoin_constants (β : E →ₐ[F] E') {ι : Type*} (x : ι → E) {z : E}
    (hz : z ∈ IntermediateField.adjoin F (Set.range x)) :
    β z ∈ IntermediateField.adjoin K (Set.range (β ∘ x)) := by
  have hmap : β z ∈ (IntermediateField.adjoin F (Set.range x)).map β := ⟨z, hz, rfl⟩
  rw [IntermediateField.adjoin_map, ← Set.range_comp] at hmap
  have hle : IntermediateField.adjoin F (Set.range (β ∘ x)) ≤
      (IntermediateField.adjoin K (Set.range (β ∘ x))).restrictScalars F := by
    rw [IntermediateField.adjoin_le_iff]
    exact IntermediateField.subset_adjoin K _
  exact hle hmap

variable (β : E →ₐ[F] E') {O S : IntermediateField F E} {O' S' : IntermediateField K E'}

/-- The restriction of `β` to intermediate fields it maps into each other. -/
def intermediateFieldRestrict {A : IntermediateField F E} {A' : IntermediateField K E'}
    (h : ∀ z ∈ A, β z ∈ A') : A →+* A' where
  toFun z := ⟨β z, h z z.2⟩
  map_one' := Subtype.ext (map_one β)
  map_mul' a b := Subtype.ext (map_mul β (a : E) b)
  map_zero' := Subtype.ext (map_zero β)
  map_add' a b := Subtype.ext (map_add β (a : E) b)

/-- A family generates, inside a field it generates, the whole field. -/
theorem adjoin_range_restrict_eq_top_of_eq {L Ω : Type*} [Field L] [Field Ω] [Algebra L Ω]
    {A : IntermediateField L Ω} {κ : Type*} (v : κ → Ω)
    (hA : A = IntermediateField.adjoin L (Set.range v)) (hv : ∀ k, v k ∈ A) :
    IntermediateField.adjoin L (Set.range (fun k => (⟨v k, hv k⟩ : A))) = ⊤ := by
  subst hA
  exact adjoin_range_restrict_eq_top v

/-- **Descent of the sheet action along an algebraic extension of constants.** -/
theorem sheetAction_descent_of_constantExtension [CharZero F] [Algebra.IsAlgebraic F K]
    {κ μ : Type*} [Finite κ] [Finite μ] (x : κ → E) (y : μ → E)
    (hS : S = IntermediateField.adjoin F (Set.range x))
    (hO : O = IntermediateField.adjoin F (Set.range y))
    (hS' : S' = IntermediateField.adjoin K (Set.range (β ∘ x)))
    (hO' : O' = IntermediateField.adjoin K (Set.range (β ∘ y)))
    (hindS' : AlgebraicIndependent K (β ∘ x))
    (hindO' : AlgebraicIndependent K (β ∘ y))
    (hcard : Nat.card κ ≤ Nat.card μ)
    [Algebra O S] [Algebra O' S']
    (hOS : ∀ z : O, ((algebraMap O S z : S) : E) = z)
    (hOS' : ∀ z : O', ((algebraMap O' S' z : S') : E') = z)
    [FiniteDimensional O S] [FiniteDimensional O' S'] :
    Module.finrank O S = Module.finrank O' S' ∧
      (Function.Bijective (sheetAction O' S') → Function.Bijective (sheetAction O S)) := by
  classical
  haveI : CharZero K := charZero_of_injective_algebraMap (algebraMap F K).injective
  haveI : CharZero O := charZero_of_injective_algebraMap (algebraMap F O).injective
  haveI : CharZero O' := charZero_of_injective_algebraMap (algebraMap K O').injective
  have hβS : ∀ z ∈ S, β z ∈ S' := fun z hz => by
    rw [hS']
    exact map_mem_adjoin_constants β x (hS ▸ hz)
  have hβO : ∀ z ∈ O, β z ∈ O' := fun z hz => by
    rw [hO']
    exact map_mem_adjoin_constants β y (hO ▸ hz)
  let ιO : O →+* O' := intermediateFieldRestrict β hβO
  let ιS : S →+* S' := intermediateFieldRestrict β hβS
  letI : Algebra O O' := ιO.toAlgebra
  letI : Algebra O S' := ((algebraMap O' S').comp ιO).toAlgebra
  haveI : IsScalarTower O O' S' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : IsScalarTower K O' S' := IsScalarTower.of_algebraMap_eq fun c => by
    apply Subtype.ext
    rw [hOS']
    rfl
  let ι : S →ₐ[O] S' :=
    { ιS with
      commutes' := fun o => by
        apply Subtype.ext
        change β ((algebraMap O S o : S) : E) = ((algebraMap O' S' (ιO o) : S') : E')
        rw [hOS, hOS']
        rfl }
  -- the generating families
  have hxS : ∀ k, x k ∈ S := fun k => hS ▸ IntermediateField.subset_adjoin F _ ⟨k, rfl⟩
  have hyO : ∀ j, y j ∈ O := fun j => hO ▸ IntermediateField.subset_adjoin F _ ⟨j, rfl⟩
  have hxS' : ∀ k, (β ∘ x) k ∈ S' := fun k => hS' ▸ IntermediateField.subset_adjoin K _ ⟨k, rfl⟩
  have hyO' : ∀ j, (β ∘ y) j ∈ O' := fun j => hO' ▸ IntermediateField.subset_adjoin K _ ⟨j, rfl⟩
  let xS : κ → S := fun k => ⟨x k, hxS k⟩
  let yO : μ → O := fun j => ⟨y j, hyO j⟩
  let xS' : κ → S' := fun k => ⟨(β ∘ x) k, hxS' k⟩
  let yO' : μ → O' := fun j => ⟨(β ∘ y) j, hyO' j⟩
  have htopS : IntermediateField.adjoin F (Set.range xS) = ⊤ :=
    adjoin_range_restrict_eq_top_of_eq x hS hxS
  have htopS' : IntermediateField.adjoin K (Set.range xS') = ⊤ :=
    adjoin_range_restrict_eq_top_of_eq (β ∘ x) hS' hxS'
  have htopO' : IntermediateField.adjoin K (Set.range yO') = ⊤ :=
    adjoin_range_restrict_eq_top_of_eq (β ∘ y) hO' hyO'
  have hιx : ∀ k, ι (xS k) = xS' k := fun _ => rfl
  -- generation over the enlarged observation field
  have hgen : IntermediateField.adjoin O' (Set.range ι) = ⊤ := by
    apply top_unique
    have hK : (⊤ : IntermediateField K S') ≤
        (IntermediateField.adjoin O' (Set.range ι)).restrictScalars K := by
      rw [← htopS', IntermediateField.adjoin_le_iff]
      rintro _ ⟨k, rfl⟩
      exact IntermediateField.subset_adjoin O' _ ⟨xS k, hιx k⟩
    intro z _
    exact hK (IntermediateField.mem_top (x := z))
  -- the enlarged observation field is algebraic over the original one
  haveI : IsScalarTower F O O' :=
    IsScalarTower.of_algebraMap_eq fun c => Subtype.ext (β.commutes c).symm
  haveI : IsScalarTower F O S := IsScalarTower.of_algebraMap_eq fun c => by
    apply Subtype.ext
    rw [hOS]
    rfl
  haveI : Algebra.IsAlgebraic O O' := by
    let A : IntermediateField O O' :=
      IntermediateField.adjoin O (Set.range (algebraMap K O'))
    haveI : Algebra.IsAlgebraic O A := IntermediateField.isAlgebraic_adjoin (by
      rintro _ ⟨c, rfl⟩
      have hc : IsIntegral F c := (Algebra.IsAlgebraic.isAlgebraic c).isIntegral
      exact (hc.map (IsScalarTower.toAlgHom F K O')).tower_top)
    have hA : ∀ z : O', z ∈ A := by
      let M : IntermediateField K O' := A.toSubfield.toIntermediateField
        (fun c => IntermediateField.subset_adjoin O _ ⟨c, rfl⟩)
      have hle : IntermediateField.adjoin K (Set.range yO') ≤ M := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨j, rfl⟩
        exact A.algebraMap_mem (yO j)
      intro z
      exact hle (htopO'.symm ▸ IntermediateField.mem_top)
    exact ⟨fun z => (Algebra.IsAlgebraic.isAlgebraic (⟨z, hA z⟩ : A)).algHom A.val⟩
  -- every embedding of the source extends
  have hext : ∀ σ : S →ₐ[O] AlgebraicClosure S',
      ∃ τ : S' →ₐ[O'] AlgebraicClosure S', (τ.restrictScalars O).comp ι = σ := by
    intro σ
    have hconst : ∀ c : F, algebraMap O S' (algebraMap F O c) =
        algebraMap K S' (algebraMap F K c) := by
      intro c
      apply Subtype.ext
      change ((algebraMap O' S' (ιO (algebraMap F O c)) : S') : E') = _
      rw [hOS']
      change β (algebraMap F E c) = algebraMap K E' (algebraMap F K c)
      rw [β.commutes, IsScalarTower.algebraMap_apply F K E']
    have hσF : ∀ c : F, σ (algebraMap F S c) =
        algebraMap K (AlgebraicClosure S') (algebraMap F K c) := by
      intro c
      rw [IsScalarTower.algebraMap_apply F O S c, σ.commutes,
        IsScalarTower.algebraMap_apply O S' (AlgebraicClosure S'),
        IsScalarTower.algebraMap_apply K S' (AlgebraicClosure S'), hconst]
    have hιF : ∀ c : F, ιS (algebraMap F S c) = algebraMap K S' (algebraMap F K c) := by
      intro c
      apply Subtype.ext
      change β (algebraMap F E c) = algebraMap K E' (algebraMap F K c)
      rw [β.commutes, IsScalarTower.algebraMap_apply F K E']
    let v : κ → AlgebraicClosure S' := fun k => σ (xS k)
    let w : μ → AlgebraicClosure S' := fun j => algebraMap O' (AlgebraicClosure S') (yO' j)
    have hyO'ind : AlgebraicIndependent K yO' :=
      AlgebraicIndependent.of_comp O'.val (by
        have hcomp : ⇑O'.val ∘ yO' = β ∘ y := funext fun _ => rfl
        rw [hcomp]
        exact hindO')
    have hw : AlgebraicIndependent K w :=
      hyO'ind.map' (f := IsScalarTower.toAlgHom K O' (AlgebraicClosure S'))
        (algebraMap O' (AlgebraicClosure S')).injective
    let T : IntermediateField K (AlgebraicClosure S') :=
      IntermediateField.adjoin K (Set.range v)
    have hσT : ∀ z : S, σ z ∈ T := by
      let M : IntermediateField F S := (T.toSubfield.comap σ.toRingHom).toIntermediateField
        (fun c => by
          change σ (algebraMap F S c) ∈ T
          rw [hσF]
          exact T.algebraMap_mem _)
      have hle : IntermediateField.adjoin F (Set.range xS) ≤ M := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨k, rfl⟩
        exact IntermediateField.subset_adjoin K _ ⟨k, rfl⟩
      intro z
      exact hle (htopS.symm ▸ IntermediateField.mem_top)
    have hwσ : ∀ j, w j = σ (algebraMap O S (yO j)) := by
      intro j
      show algebraMap O' (AlgebraicClosure S') (yO' j) = σ (algebraMap O S (yO j))
      rw [σ.commutes, IsScalarTower.algebraMap_apply O S' (AlgebraicClosure S'),
        IsScalarTower.algebraMap_apply O' S' (AlgebraicClosure S')]
      rfl
    have hmem : ∀ j, w j ∈ T := fun j => by
      rw [hwσ]
      exact hσT _
    have hv : AlgebraicIndependent K v :=
      algebraicIndependent_of_forall_mem_adjoin v w hw hmem hcard
    have hxS'ind : AlgebraicIndependent K xS' :=
      AlgebraicIndependent.of_comp S'.val (by
        have hcomp : ⇑S'.val ∘ xS' = β ∘ x := funext fun _ => rfl
        rw [hcomp]
        exact hindS')
    obtain ⟨τ₀, hτ₀⟩ := exists_algHom_eq_of_algebraicIndependent xS' hxS'ind htopS' v hv
    have hagree : ∀ z : S, τ₀ (ιS z) = σ z := by
      let M : IntermediateField F S :=
        (RingHom.eqLocusField (τ₀.toRingHom.comp ιS) σ.toRingHom).toIntermediateField
          (fun c => by
            change τ₀ (ιS (algebraMap F S c)) = σ (algebraMap F S c)
            rw [hσF, hιF, τ₀.commutes])
      have hle : IntermediateField.adjoin F (Set.range xS) ≤ M := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨k, rfl⟩
        exact hτ₀ k
      intro z
      exact hle (htopS.symm ▸ IntermediateField.mem_top)
    obtain ⟨τ, hτ⟩ := exists_algHom_restrictScalars_eq_of_generators τ₀ yO' htopO'
      (fun j => by
        have h1 : algebraMap O' S' (yO' j) = ιS (algebraMap O S (yO j)) := by
          apply Subtype.ext
          rw [hOS']
          change β (y j) = β ((algebraMap O S (yO j) : S) : E)
          rw [hOS]
        rw [h1, hagree, ← hwσ])
    refine ⟨τ, ?_⟩
    apply AlgHom.ext
    intro z
    change τ (ιS z) = σ z
    rw [← hagree z]
    exact DFunLike.congr_fun hτ (ιS z)
  have hdeg : Module.finrank O S ≤ Module.finrank O' S' :=
    finrank_le_of_forall_exists_extension ι hext
  exact ⟨le_antisymm hdeg (finrank_le_of_adjoin_range_eq_top ι hgen),
    sheetAction_bijective_of_descent ι hgen hdeg⟩

end

end GaloisForLFunctions.HTGeometry
