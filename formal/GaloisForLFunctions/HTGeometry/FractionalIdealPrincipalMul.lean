import Mathlib.NumberTheory.NumberField.ClassNumber

/-!
# Multiplication by a principal fractional ideal

Multiplying a fractional ideal by the principal ideal generated by `c` is the image of scalar
multiplication by `c`.  The singleton case gives the expected product law for principal fractional
ideals.  These elementary identities make ideal-class normalization usable at the vector level.
-/

namespace GaloisForLFunctions.HTGeometry

/-- Multiplication by a principal fractional ideal is scalar multiplication on its underlying
submodule. -/
theorem coe_spanSingleton_mul_fractionalIdeal
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    [IsFractionRing R K]
    (c : K) (J : FractionalIdeal (nonZeroDivisors R) K) :
    (↑(FractionalIdeal.spanSingleton (nonZeroDivisors R) c * J) : Submodule R K) =
      Submodule.map (LinearMap.mulLeft R c) (↑J : Submodule R K) := by
  apply le_antisymm
  · rw [FractionalIdeal.coe_mul]
    rw [Submodule.mul_le]
    intro x hx y hy
    change x ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) c at hx
    rw [FractionalIdeal.mem_spanSingleton] at hx
    obtain ⟨r, rfl⟩ := hx
    rw [Submodule.mem_map]
    refine ⟨r • y, Submodule.smul_mem _ r hy, ?_⟩
    simp [Algebra.smul_def]
    ring
  · intro x hx
    rw [Submodule.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rw [FractionalIdeal.coe_mul]
    apply Submodule.mul_mem_mul
    · change c ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) c
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨1, by simp⟩
    · exact hy

/-- Principal fractional ideals multiply by multiplying their generators. -/
theorem spanSingleton_mul_spanSingleton
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    [IsFractionRing R K] (c x : K) :
    FractionalIdeal.spanSingleton (nonZeroDivisors R) c *
        FractionalIdeal.spanSingleton (nonZeroDivisors R) x =
      FractionalIdeal.spanSingleton (nonZeroDivisors R) (c * x) := by
  apply FractionalIdeal.ext
  intro z
  change z ∈ (↑(FractionalIdeal.spanSingleton (nonZeroDivisors R) c *
      FractionalIdeal.spanSingleton (nonZeroDivisors R) x) : Submodule R K) ↔
    z ∈ (↑(FractionalIdeal.spanSingleton (nonZeroDivisors R) (c * x)) : Submodule R K)
  rw [coe_spanSingleton_mul_fractionalIdeal]
  constructor
  · intro hz
    rw [Submodule.mem_map] at hz
    obtain ⟨y, hy, rfl⟩ := hz
    change y ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) x at hy
    rw [FractionalIdeal.mem_spanSingleton] at hy
    obtain ⟨r, rfl⟩ := hy
    change c * (r • x) ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) (c * x)
    rw [FractionalIdeal.mem_spanSingleton]
    refine ⟨r, ?_⟩
    simp [Algebra.smul_def]
    ring
  · intro hz
    change z ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) (c * x) at hz
    rw [FractionalIdeal.mem_spanSingleton] at hz
    obtain ⟨r, rfl⟩ := hz
    rw [Submodule.mem_map]
    refine ⟨r • x, ?_, ?_⟩
    · change r • x ∈ FractionalIdeal.spanSingleton (nonZeroDivisors R) x
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨r, rfl⟩
    · simp [Algebra.smul_def]
      ring

/-- Multiplication by a principal fractional ideal distributes over joins, including when its
generator is zero. -/
theorem spanSingleton_mul_sup
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    [IsFractionRing R K] (c : K)
    (I J : FractionalIdeal (nonZeroDivisors R) K) :
    FractionalIdeal.spanSingleton (nonZeroDivisors R) c * (I ⊔ J) =
      FractionalIdeal.spanSingleton (nonZeroDivisors R) c * I ⊔
        FractionalIdeal.spanSingleton (nonZeroDivisors R) c * J := by
  apply FractionalIdeal.ext
  intro x
  change x ∈ (↑(FractionalIdeal.spanSingleton (nonZeroDivisors R) c * (I ⊔ J)) :
      Submodule R K) ↔
    x ∈ (↑(FractionalIdeal.spanSingleton (nonZeroDivisors R) c * I ⊔
      FractionalIdeal.spanSingleton (nonZeroDivisors R) c * J) : Submodule R K)
  rw [coe_spanSingleton_mul_fractionalIdeal]
  rw [FractionalIdeal.coe_sup I J]
  rw [FractionalIdeal.coe_sup]
  rw [coe_spanSingleton_mul_fractionalIdeal, coe_spanSingleton_mul_fractionalIdeal]
  rw [Submodule.map_sup]

end GaloisForLFunctions.HTGeometry
