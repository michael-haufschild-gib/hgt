import GaloisForLFunctions.HTGeometry.FreeCoordinateDerivativeHasse

/-!
# Coordinate-subfield Hasse quotients

For every set `S` of free coordinates, observations at all derivative places outside `S` have
exact common kernel equal to the rational subfield generated by `S`. This produces a lattice of
local--global quotients, generalizing the scalar-kernel case `S = ∅`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Simultaneous derivatives at every coordinate place outside `S`. -/
noncomputable def freeCoordinateOutsideDerivativeHasseProfile
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ) :
    FreeCoordinateRationalField C σ →ₗ[C]
      ({i : σ // i ∉ S} → FreeCoordinateRationalField C σ) :=
  LinearMap.pi fun i => (freeCoordinateDerivation C σ i.1).toLinearMap

@[simp] theorem freeCoordinateOutsideDerivativeHasseProfile_apply
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) (i : {i : σ // i ∉ S}) :
    freeCoordinateOutsideDerivativeHasseProfile C σ S f i =
      freeCoordinateDerivation C σ i.1 f := by
  rfl

/-- The common kernel outside `S` is exactly the rational subfield generated by `S`. -/
theorem freeCoordinateOutsideDerivativeHasseProfile_ker
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ) :
    LinearMap.ker (freeCoordinateOutsideDerivativeHasseProfile C σ S) =
      (freeCoordinateField C σ S).toSubmodule := by
  ext f
  rw [LinearMap.mem_ker]
  constructor
  · intro h
    apply (mem_freeCoordinateField_iff S f).2
    intro i hi
    exact congrFun h ⟨i, hi⟩
  · intro h
    have hd := (mem_freeCoordinateField_iff S f).1 h
    funext i
    exact hd i.1 i.2

/-- Rational functions modulo the subfield generated by `S`. -/
abbrev FreeCoordinateSubfieldHasseClass
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ) :=
  FreeCoordinateRationalField C σ ⧸
    (freeCoordinateField C σ S).toSubmodule

/-- The subfield quotient is exactly the space of realized outside-derivative profiles. -/
noncomputable def freeCoordinateSubfieldHasseEquivRealizedProfiles
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ) :
    FreeCoordinateSubfieldHasseClass C σ S ≃ₗ[C]
      LinearMap.range (freeCoordinateOutsideDerivativeHasseProfile C σ S) :=
  (Submodule.quotEquivOfEq _ _
    (freeCoordinateOutsideDerivativeHasseProfile_ker C σ S).symm).trans
      (LinearMap.quotKerEquivRange _)

@[simp] theorem freeCoordinateSubfieldHasseEquivRealizedProfiles_mk
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) :
    freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S
        (Submodule.Quotient.mk f) =
      ⟨freeCoordinateOutsideDerivativeHasseProfile C σ S f, ⟨f, rfl⟩⟩ := by
  rfl

/-- Outside derivatives determine a rational function modulo the `S`-coordinate subfield. -/
theorem freeCoordinateSubfield_congr_hasse_iff
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (f g : FreeCoordinateRationalField C σ) :
    f - g ∈ (freeCoordinateField C σ S).toSubmodule ↔
      ∀ i, i ∉ S →
        freeCoordinateDerivation C σ i f =
          freeCoordinateDerivation C σ i g := by
  rw [← freeCoordinateOutsideDerivativeHasseProfile_ker C σ S,
    LinearMap.mem_ker, map_sub, sub_eq_zero]
  constructor
  · intro h i hi
    exact congrFun h ⟨i, hi⟩
  · intro h
    funext i
    exact h i.1 i.2

/-- A class vanishes exactly when every derivative outside `S` vanishes. -/
theorem freeCoordinateSubfieldClass_eq_zero_hasse_iff
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) :
    Submodule.Quotient.mk f =
        (0 : FreeCoordinateSubfieldHasseClass C σ S) ↔
      ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0 := by
  rw [Submodule.Quotient.mk_eq_zero,
    ← freeCoordinateOutsideDerivativeHasseProfile_ker C σ S,
    LinearMap.mem_ker]
  constructor
  · intro h i hi
    exact congrFun h ⟨i, hi⟩
  · intro h
    funext i
    exact h i.1 i.2

/-- Every nonzero subfield-quotient class has an outside-coordinate witness. -/
theorem freeCoordinateSubfieldClass_ne_zero_iff_exists_outsideWitness
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (f : FreeCoordinateRationalField C σ) :
    Submodule.Quotient.mk f ≠
        (0 : FreeCoordinateSubfieldHasseClass C σ S) ↔
      ∃ i, i ∉ S ∧ freeCoordinateDerivation C σ i f ≠ 0 := by
  constructor
  · intro h
    by_contra hn
    have hall : ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0 := by
      intro i hi
      by_contra hderiv
      exact hn ⟨i, hi, hderiv⟩
    exact h (freeCoordinateSubfieldClass_eq_zero_hasse_iff C σ S f |>.2 hall)
  · rintro ⟨i, hi, hderiv⟩ hzero
    exact hderiv
      (freeCoordinateSubfieldClass_eq_zero_hasse_iff C σ S f |>.1 hzero i hi)

/-- Every realized outside-derivative packet has one unique global class modulo the subfield. -/
theorem freeCoordinateSubfieldRealizedProfile_existsUnique_global
    (C σ : Type*) [Field C] [CharZero C] (S : Set σ)
    (p : LinearMap.range (freeCoordinateOutsideDerivativeHasseProfile C σ S)) :
    ∃! x : FreeCoordinateSubfieldHasseClass C σ S,
      freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S x = p := by
  refine ⟨(freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S).symm p,
    (freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S).apply_symm_apply p, ?_⟩
  intro y hy
  apply (freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S).injective
  rw [hy, (freeCoordinateSubfieldHasseEquivRealizedProfiles C σ S).apply_symm_apply]

end

end GaloisForLFunctions.HTGeometry
