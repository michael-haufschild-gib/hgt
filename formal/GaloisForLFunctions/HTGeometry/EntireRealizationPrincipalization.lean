import GaloisForLFunctions.HTGeometry.EntireFacetRealizationCodimension
import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetIdeal

/-!
# Entire one-variable realizations force Stanley–Reisner principalization

The facet-codimension law is unconditional for entire carriers
(`facetComplementRankOne_of_entire`).  Feeding it to the combinatorial classification already in the
corpus gives the structural conclusion of the scalar Stanley–Reisner principalization argument, with
no analytic input left:

* `principalization_of_entire_realization` — a finite facet antichain admitting a one-variable
  realization with entire carriers is either the full simplex `{V}` or exactly the deletion family
  `{V ∖ {u} : u ∈ U}` for a nonempty block `U`
  (`facetAntichain_eq_singleton_or_deletionFacets`);
* **`stanleyReisnerIdeal_principal_of_entire_realization`** — in the non-simplex case its
  Stanley–Reisner ideal is the principal ideal generated by the single squarefree monomial
  `∏_{u ∈ U} X u` (`stanleyReisnerIdeal_deletionFacetFinset_eq_span_product`).

Every step of the chain — facet separator, transport of annihilation to periods, period-rank
exclusion at rank three and at real-dependent rank two, Liouville at the lattice, the combinatorial
classification and the ideal computation — is now formalized and unconditional for this class.
-/

open Finset MvPolynomial

namespace GaloisForLFunctions.HTGeometry

variable {α : Type*} [DecidableEq α]

/-- **Structural classification from an entire one-variable realization.**  Such a facet antichain is
the full simplex or a single-vertex deletion family. -/
theorem principalization_of_entire_realization {facets : Finset (Finset α)}
    (hanti : FacetAntichain (↑facets : Set (Finset α))) (R : ScalarSRRealization facets)
    (hentire : ∀ q, Differentiable ℂ (R.carrier q))
    {V : Finset α} (hsub : ∀ F ∈ facets, F ⊆ V) (hne : facets.Nonempty) :
    (↑facets : Set (Finset α)) = {V} ∨
      ∃ U : Finset α, U.Nonempty ∧ U ⊆ V ∧
        (↑facets : Set (Finset α)) = deletionFacets V U := by
  refine facetAntichain_eq_singleton_or_deletionFacets ?_ hanti
    (facetComplementRankOne_of_entire hanti R hentire hsub)
  obtain ⟨F, hF⟩ := hne
  exact ⟨F, Finset.mem_coe.mpr hF⟩

/-- **Principalization.**  On a finite ambient vertex type, a facet antichain that is not the full
simplex and admits a one-variable realization with entire carriers has principal Stanley–Reisner
ideal, generated by the squarefree monomial of its deleted block. -/
theorem stanleyReisnerIdeal_principal_of_entire_realization [Fintype α]
    {facets : Finset (Finset α)} (hanti : FacetAntichain (↑facets : Set (Finset α)))
    (R : ScalarSRRealization facets) (hentire : ∀ q, Differentiable ℂ (R.carrier q))
    (hne : facets.Nonempty)
    (hnotsimplex : (↑facets : Set (Finset α)) ≠ {(Finset.univ : Finset α)}) :
    ∃ U : Finset α, U.Nonempty ∧
      stanleyReisnerIdeal ℂ facets
        = Ideal.span ({∏ u ∈ U, X u} : Set (MvPolynomial α ℂ)) := by
  rcases principalization_of_entire_realization hanti R hentire
    (V := (Finset.univ : Finset α)) (fun F _ => Finset.subset_univ F) hne with hsimp | ⟨U, hUne, _, hUeq⟩
  · exact absurd hsimp hnotsimplex
  · refine ⟨U, hUne, ?_⟩
    have hfin : facets = deletionFacetFinset U := by
      apply Finset.coe_injective
      rw [hUeq, coe_deletionFacetFinset]
    rw [hfin, stanleyReisnerIdeal_deletionFacetFinset_eq_span_product]

end GaloisForLFunctions.HTGeometry
