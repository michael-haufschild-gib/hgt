import GaloisForLFunctions.HTGeometry.UpperEndGammaElement
import GaloisForLFunctions.HTGeometry.UpperEndRatfuncDifferentialAlgebra

/-!
# Equation (21): the Gamma differential field is generated by Gamma and the digamma jets

`K_Γ = ℂ(s)⟨Γ⟩` contains `ψ = Γ′/Γ`, hence — being closed under the derivation — every digamma jet;
conversely every jet of `Γ` is `Γ` times a polynomial in the digamma jets.  So the differential field
generated by `Γ` is the ordinary field generated by `Γ` together with the digamma jets: `K_Γ = L(Γ)`
with `L = ℂ(s)⟨ψ⟩`.
-/

open Filter Set Topology Function
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance gammaGenDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance gammaGenIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance gammaGenDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance gammaGenComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance gammaGenRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

local instance gammaGenRatFuncDifferential : Differential (RatFunc ℂ) :=
  ratFuncCoordinateDifferential

local instance gammaGenRatFuncDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncDifferentialAlgebra

/-- Gamma is not the zero germ at the upper end: it has no zeros at all. -/
theorem gammaUpperAnalytic_ne_zero : gammaUpperAnalytic ≠ 0 := by
  intro h
  have hgerm : (Germ.coeRingHom upperEndFilter Complex.Gamma : Germ upperEndFilter ℂ) = 0 :=
    congrArg Subtype.val h
  rw [← Germ.coe_zero] at hgerm
  have hev : ∀ᶠ z : ℂ in upperEndFilter, Complex.Gamma z = (0 : ℂ → ℂ) z :=
    Filter.Germ.coe_eq.mp hgerm
  rw [upperEndFilter_basis.eventually_iff] at hev
  obtain ⟨H, -, hH⟩ := hev
  have him : ((2 : ℂ) + ((|H| + 1 : ℝ) : ℂ) * Complex.I).im = |H| + 1 := by simp
  have hmem : ((2 : ℂ) + ((|H| + 1 : ℝ) : ℂ) * Complex.I) ∈ upperTail H := by
    show H < ((2 : ℂ) + ((|H| + 1 : ℝ) : ℂ) * Complex.I).im
    rw [him]
    have := le_abs_self H
    linarith
  have hmem0 : ((2 : ℂ) + ((|H| + 1 : ℝ) : ℂ) * Complex.I) ∈ upperTail 0 := by
    show (0 : ℝ) < ((2 : ℂ) + ((|H| + 1 : ℝ) : ℂ) * Complex.I).im
    rw [him]
    have := abs_nonneg H
    linarith
  exact Complex.Gamma_ne_zero (ne_negNat_of_mem_upperTail hmem0) (hH hmem)

/-- Gamma is a nonzero element of the meromorphic carrier. -/
theorem gammaUpperMero_ne_zero : gammaUpperMero ≠ 0 := by
  intro h
  refine gammaUpperAnalytic_ne_zero ?_
  refine IsFractionRing.injective upperEndAnalyticSubring upperEndMeroField ?_
  rw [← gammaUpperMero, h, map_zero]

/-- **The digamma element lies in the Gamma differential field**: it is `Γ′/Γ`. -/
theorem digammaMero_mem_gammaAdjoin :
    digammaMero ∈ differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField) := by
  have hΓ : gammaUpperMero
      ∈ differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField) :=
    subset_differentialAdjoin (RatFunc ℂ) _ (Set.mem_singleton _)
  have hΓ' : (gammaUpperMero)′
      ∈ differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField) :=
    derivationClosed_differentialAdjoin (RatFunc ℂ) _ hΓ
  have heq : digammaMero = (gammaUpperMero)′ / gammaUpperMero := by
    rw [deriv_gammaUpperMero, mul_comm, mul_div_assoc, div_self gammaUpperMero_ne_zero, mul_one]
  rw [heq]
  exact div_mem hΓ' hΓ

/-- Every digamma jet lies in the Gamma differential field. -/
theorem differentialJetSet_digamma_subset_gammaAdjoin :
    differentialJetSet ({digammaMero} : Set upperEndMeroField)
      ⊆ (differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField) :
        Set upperEndMeroField) := by
  rintro y ⟨x, hx, n, rfl⟩
  rw [Set.mem_singleton_iff] at hx
  subst hx
  induction n with
  | zero =>
      rw [differentialJet_zero]
      exact digammaMero_mem_gammaAdjoin
  | succ n ih =>
      rw [differentialJet_succ]
      exact derivationClosed_differentialAdjoin (RatFunc ℂ) _ ih

/-- **Equation (21).**  The differential field generated by `Γ` over `ℂ(s)` is the field generated by
`Γ` together with all digamma jets: `K_Γ = L(Γ)`. -/
theorem differentialAdjoin_gamma_eq_adjoin_gamma_digammaJets :
    differentialAdjoin (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField)
      = IntermediateField.adjoin (RatFunc ℂ)
        ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField)) := by
  refine le_antisymm ?_ ?_
  · -- every jet of `Γ` is `Γ` times a polynomial in the digamma jets
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro y ⟨x, hx, n, rfl⟩
    rw [Set.mem_singleton_iff] at hx
    subst hx
    have hmem := gammaJetAlgebra_le_ratAdjoin
      (Algebra.subset_adjoin ⟨gammaUpperMero, Set.mem_singleton _, n, rfl⟩)
    exact IntermediateField.algebra_adjoin_le_adjoin (RatFunc ℂ) _ hmem
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro y (hy | hy)
    · rw [Set.mem_singleton_iff] at hy
      subst hy
      exact subset_differentialAdjoin (RatFunc ℂ) _ (Set.mem_singleton _)
    · exact differentialJetSet_digamma_subset_gammaAdjoin hy

end

end GaloisForLFunctions.HTGeometry
