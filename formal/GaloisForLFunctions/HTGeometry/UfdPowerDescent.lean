import Mathlib.RingTheory.UniqueFactorizationDomain.Multiplicity
import GaloisForLFunctions.HTGeometry.TorusKummerExponents

/-!
# Elements whose prime multiplicities are all divisible

In a unique factorization monoid an element whose every prime multiplicity is divisible by `r` is a
unit times an `r`-th power, and conversely.  The factorization multiset then has all its
multiplicities divisible, so it is `r` times a smaller multiset, whose product is the required root.

This is the codimension-one condition of a radical extension: a radical extension `z ^ r = a` is
unramified at a prime exactly when that prime's multiplicity in `a` is divisible by `r`, so an
everywhere-unramified radical extension is generated by an `r`-th root of a **unit**.  Combined with
the description of the unit group of a two-dimensional torus times an affine space, the unramified
cyclic radical extensions are then classified by a pair of exponents modulo `r`.
-/

namespace GaloisForLFunctions.HTGeometry

open UniqueFactorizationMonoid

variable {R : Type*} [CommMonoidWithZero R] [UniqueFactorizationMonoid R]
  [NormalizationMonoid R]

/-! ## The descent -/

/-- **An element whose every prime multiplicity is divisible by `r` is associated to an `r`-th
power.** -/
theorem exists_associated_pow_of_forall_dvd_count [DecidableEq R] {a : R} (ha : a ≠ 0) {r : ℕ}
    (h : ∀ p ∈ normalizedFactors a, r ∣ Multiset.count p (normalizedFactors a)) :
    ∃ g : R, Associated a (g ^ r) := by
  obtain ⟨s, hs⟩ := Multiset.exists_smul_of_dvd_count (normalizedFactors a) h
  refine ⟨s.prod, ?_⟩
  have hprod := prod_normalizedFactors ha
  rw [hs, Multiset.prod_nsmul] at hprod
  exact hprod.symm

/-- **Conversely**, an element associated to an `r`-th power has all its prime multiplicities
divisible by `r`.  So the condition is exactly the right one. -/
theorem forall_dvd_count_of_associated_pow [DecidableEq R] {a g : R} {r : ℕ}
    (h : Associated a (g ^ r)) (p : R) :
    r ∣ Multiset.count p (normalizedFactors a) := by
  rw [h.normalizedFactors_eq, normalizedFactors_pow, Multiset.count_nsmul]
  exact dvd_mul_right _ _

/-- **The same stated through multiplicities at primes.** -/
theorem exists_associated_pow_of_forall_dvd_multiplicity [DecidableEq R] {a : R} (ha : a ≠ 0)
    {r : ℕ} (h : ∀ p : R, Prime p → r ∣ multiplicity p a) :
    ∃ g : R, Associated a (g ^ r) := by
  refine exists_associated_pow_of_forall_dvd_count ha fun p hp => ?_
  have hprime := prime_of_normalized_factor p hp
  have hcount := multiplicity_eq_count_normalizedFactors hprime.irreducible ha
  rw [normalize_normalized_factor p hp] at hcount
  rw [← hcount]
  exact h p hprime

/-- **An everywhere-unramified radicand is a unit times an `r`-th power.**  This is the step that
turns a radical extension unramified in codimension one into a radical extension of the unit
group. -/
theorem exists_unit_mul_pow_of_forall_dvd_count [DecidableEq R] {a : R} (ha : a ≠ 0) {r : ℕ}
    (h : ∀ p ∈ normalizedFactors a, r ∣ Multiset.count p (normalizedFactors a)) :
    ∃ (u : Rˣ) (g : R), a = u * g ^ r := by
  obtain ⟨g, w, hw⟩ := exists_associated_pow_of_forall_dvd_count ha h
  refine ⟨w⁻¹, g, ?_⟩
  rw [← hw, mul_comm a (w : R), ← mul_assoc, Units.inv_mul, one_mul]

/-! ## The classification of the cyclic covers -/

/-- **The unramified cyclic radical extensions are exactly the torus Kummer ones.**  If the units of
the base are a constant together with two monomial exponents, then an everywhere-unramified radicand
is a unit times an `r`-th power, and that unit is itself an `r`-th power exactly when both of its
exponents are divisible by `r`.  So the extension is trivial exactly on that condition, and the
nontrivial ones are classified by the exponent pair modulo `r`. -/
theorem exists_unit_mul_pow_torus_kummer [DecidableEq R] {K : Type*} [Field K] [IsAlgClosed K]
    (e : Rˣ ≃* TorusUnitGroup K) {a : R} (ha : a ≠ 0) {r : ℕ} (hr : 0 < r)
    (h : ∀ p ∈ normalizedFactors a, r ∣ Multiset.count p (normalizedFactors a)) :
    ∃ (u : Rˣ) (g : R), a = u * g ^ r ∧
      ((∃ w : Rˣ, w ^ r = u) ↔
        ((r : ℤ) ∣ (torusVal₁ K (e u)).toAdd ∧ (r : ℤ) ∣ (torusVal₂ K (e u)).toAdd)) := by
  obtain ⟨u, g, hug⟩ := exists_unit_mul_pow_of_forall_dvd_count ha h
  refine ⟨u, g, hug, ?_⟩
  rw [← exists_pow_eq_torusUnit_iff hr (e u)]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨e w, by rw [← map_pow, hw]⟩
  · rintro ⟨z, hz⟩
    refine ⟨e.symm z, ?_⟩
    rw [← map_pow, hz, e.symm_apply_apply]

end GaloisForLFunctions.HTGeometry
