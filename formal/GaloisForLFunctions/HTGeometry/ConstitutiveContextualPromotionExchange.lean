import Mathlib.Tactic

/-!
# Contextual promotion exchange

Three-step reversal of unary additive promotions is generated by binary order residuals evaluated
in later promotion contexts.  The resulting residual bracket satisfies Jacobi.  Initial pairwise
exchange is insufficient, and no fixed finite context depth certifies global exchange.
-/

namespace GaloisForLFunctions.HTGeometry

universe u

/-- Binary order residual of two additive promotion processes. -/
def promotionOrderResidual {A : Type u} [AddCommGroup A]
    (P Q : A →+ A) : A →+ A :=
  P.comp Q - Q.comp P

/-- Endpoint difference between a three-promotion schedule and its reversal. -/
def promotionReversalResidual {A : Type u} [AddCommGroup A]
    (P Q R : A →+ A) (x : A) : A :=
  P (Q (R x)) - R (Q (P x))

/-- Every three-promotion reversal is generated by binary residuals transported into the contexts
created by the other promotions. -/
theorem promotionReversalResidual_decompose {A : Type u} [AddCommGroup A]
    (P Q R : A →+ A) (x : A) :
    promotionReversalResidual P Q R x =
      promotionOrderResidual P Q (R x) +
        Q (promotionOrderResidual P R x) +
        promotionOrderResidual Q R (P x) := by
  simp only [promotionReversalResidual, promotionOrderResidual, AddMonoidHom.sub_apply,
    AddMonoidHom.comp_apply, map_sub]
  abel

/-- Nested binary promotion residuals obey their cyclic conservation law. -/
theorem promotionOrderResidual_jacobi {A : Type u} [AddCommGroup A]
    (P Q R : A →+ A) :
    promotionOrderResidual P (promotionOrderResidual Q R) +
        promotionOrderResidual Q (promotionOrderResidual R P) +
        promotionOrderResidual R (promotionOrderResidual P Q) = 0 := by
  ext x
  simp only [promotionOrderResidual, AddMonoidHom.add_apply, AddMonoidHom.sub_apply,
    AddMonoidHom.comp_apply, map_sub, AddMonoidHom.zero_apply]
  abel

/-- Arity certificate: a nonzero triple reversal in unary additive mechanics exposes at least one
nonzero contextual binary generator. -/
theorem promotionReversalResidual_contextual_arity {A : Type u} [AddCommGroup A]
    (P Q R : A →+ A) (x : A)
    (h : promotionReversalResidual P Q R x ≠ 0) :
    promotionOrderResidual P Q (R x) ≠ 0 ∨
      Q (promotionOrderResidual P R x) ≠ 0 ∨
      promotionOrderResidual Q R (P x) ≠ 0 := by
  by_contra hterms
  push Not at hterms
  apply h
  rw [promotionReversalResidual_decompose, hterms.1, hterms.2.1, hterms.2.2]
  simp

/-! ## Initial-flatness countermodel -/

abbrev PromotionTriple := ℤ × (ℤ × ℤ)

/-- Shift along the three-coordinate flag and kill its final coordinate. -/
def promotionP : PromotionTriple →+ PromotionTriple where
  toFun x := (0, (x.1, x.2.1))
  map_zero' := rfl
  map_add' x y := by ext <;> simp

/-- Cyclic shift of the three coordinates. -/
def promotionQ : PromotionTriple →+ PromotionTriple where
  toFun x := (x.2.2, (x.1, x.2.1))
  map_zero' := rfl
  map_add' x y := by ext <;> simp

/-- Shift whose final coordinate is fed back into the middle coordinate. -/
def promotionR : PromotionTriple →+ PromotionTriple where
  toFun x := (0, (x.1 + x.2.2, x.2.1))
  map_zero' := by simp
  map_add' x y := by
    ext <;> simp [add_comm, add_left_comm]

def promotionBase : PromotionTriple := (1, (0, 0))

/-- All three promotion pairs exchange at the declared initial state. -/
theorem promotionPairwiseFlatAtBase :
    promotionOrderResidual promotionP promotionQ promotionBase = 0 ∧
      promotionOrderResidual promotionP promotionR promotionBase = 0 ∧
      promotionOrderResidual promotionQ promotionR promotionBase = 0 := by
  simp [promotionOrderResidual, promotionP, promotionQ, promotionR, promotionBase]

/-- Initial pairwise flatness does not determine the length-three schedule. -/
theorem promotionTripleSchedulesDifferAtBase :
    promotionP (promotionQ (promotionR promotionBase)) ≠
      promotionR (promotionQ (promotionP promotionBase)) := by
  intro h
  have hcoord := congrArg (fun v : PromotionTriple => v.2.1) h
  change (0 : ℤ) = 1 at hcoord
  exact zero_ne_one hcoord

theorem promotionReversalResidual_nonzeroAtBase :
    promotionReversalResidual promotionP promotionQ promotionR promotionBase ≠ 0 := by
  rw [promotionReversalResidual]
  exact sub_ne_zero.mpr promotionTripleSchedulesDifferAtBase

/-! ## Unbounded contextual horizon -/

/-- A promotion whose unique displaced input is placed just beyond the declared inspection
horizon. -/
def delayedLeftPromotion (d n : ℕ) : ℕ :=
  if n = d + 1 then d + 3 else n

def delayedRightPromotion (n : ℕ) : ℕ := n + 1

/-- The delayed promotion pair exchanges throughout every context strictly before depth `d`. -/
theorem delayedPromotions_exchange_before_horizon (d k : ℕ) (hk : k < d) :
    delayedLeftPromotion d (delayedRightPromotion k) =
      delayedRightPromotion (delayedLeftPromotion d k) := by
  have hk0 : k ≠ d + 1 := by omega
  have hkd : k ≠ d := by omega
  simp [delayedLeftPromotion, delayedRightPromotion, hk0, hkd]

/-- The same pair fails to exchange exactly at the next declared context. -/
theorem delayedPromotions_fail_at_horizon (d : ℕ) :
    delayedLeftPromotion d (delayedRightPromotion d) ≠
      delayedRightPromotion (delayedLeftPromotion d d) := by
  simp [delayedLeftPromotion, delayedRightPromotion]

/-- Closed certificate for contextual generation, cyclic conservation, failure of initial
pairwise testing, and absence of a uniform finite contextual cutoff. -/
theorem constitutiveContextualPromotionExchangeMechanism_closed :
    (∀ (P Q R : PromotionTriple →+ PromotionTriple) (x : PromotionTriple),
      promotionReversalResidual P Q R x =
        promotionOrderResidual P Q (R x) +
          Q (promotionOrderResidual P R x) +
          promotionOrderResidual Q R (P x)) ∧
    (∀ P Q R : PromotionTriple →+ PromotionTriple,
      promotionOrderResidual P (promotionOrderResidual Q R) +
          promotionOrderResidual Q (promotionOrderResidual R P) +
          promotionOrderResidual R (promotionOrderResidual P Q) = 0) ∧
    (promotionOrderResidual promotionP promotionQ promotionBase = 0 ∧
      promotionOrderResidual promotionP promotionR promotionBase = 0 ∧
      promotionOrderResidual promotionQ promotionR promotionBase = 0) ∧
    promotionReversalResidual promotionP promotionQ promotionR promotionBase ≠ 0 ∧
    (∀ d : ℕ,
      (∀ k < d,
        delayedLeftPromotion d (delayedRightPromotion k) =
          delayedRightPromotion (delayedLeftPromotion d k)) ∧
      delayedLeftPromotion d (delayedRightPromotion d) ≠
        delayedRightPromotion (delayedLeftPromotion d d)) := by
  exact ⟨promotionReversalResidual_decompose,
    promotionOrderResidual_jacobi,
    promotionPairwiseFlatAtBase,
    promotionReversalResidual_nonzeroAtBase,
    fun d => ⟨delayedPromotions_exchange_before_horizon d,
      delayedPromotions_fail_at_horizon d⟩⟩

end GaloisForLFunctions.HTGeometry
