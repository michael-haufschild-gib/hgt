import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic.Ring

/-!
# Quadratic presentation of a homogenized monoid algebra

For an additive commutative monoid `M`, the map `X_a ↦ T*[a]` from `R[X_a | a in M]`
to `(R[M])[T]` has kernel generated by `X_a*X_b-X_0*X_(a+b)`. No finiteness or cancellation
assumption on `M` is needed, and `R` is any commutative ring.

The proof constructs the monoid of normal forms: a unit, and terms recording a positive degree
and a monoid label. Its monoid algebra is explicitly equivalent to the quadratic quotient and
embeds faithfully into `(R[M])[T]`. In particular, cancellation of `X_0` is not assumed in the
quotient to establish the presentation.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra

/-- The unit and positive-degree monomial normal forms; `term n a` has degree `n+1`. -/
inductive Tag (M : Type*)
  | unit : Tag M
  | term : ℕ → M → Tag M

namespace Tag
variable {M : Type*} [AddCommMonoid M]

/-- Concatenation adds degrees and monoid labels. -/
def mul : Tag M → Tag M → Tag M
  | .unit, b => b
  | a, .unit => a
  | .term n a, .term k b => .term (n + k + 1) (a + b)

instance : CommMonoid (Tag M) where
  one := .unit
  mul := mul
  one_mul a := by cases a <;> rfl
  mul_one a := by cases a <;> rfl
  mul_assoc a b c := by
    cases a with
    | unit => rfl
    | term n a =>
      cases b with
      | unit => rfl
      | term k b =>
        cases c with
        | unit => rfl
        | term l c =>
          change Tag.term (n+k+1+l+1) ((a+b)+c) = Tag.term (n+(k+l+1)+1) (a+(b+c))
          congr 1
          · omega
          · exact add_assoc _ _ _
  mul_comm a b := by
    cases a with
    | unit => cases b <;> rfl
    | term n a =>
      cases b with
      | unit => rfl
      | term k b =>
        change Tag.term (n+k+1) (a+b) = Tag.term (k+n+1) (b+a)
        congr 1
        · omega
        · exact add_comm _ _

@[simp] theorem unit_eq_one : (Tag.unit : Tag M) = 1 := rfl
@[simp] theorem term_mul_term (n k : ℕ) (a b : M) :
    Tag.term n a * Tag.term k b = Tag.term (n + k + 1) (a + b) := rfl

/-- The basic degree-two relation between normal forms. -/
theorem quad (a b : M) :
    Tag.term 0 a * Tag.term 0 b = Tag.term 0 0 * Tag.term 0 (a + b) := by simp

/-- Every positive-degree normal form is a product of degree-one generators. -/
theorem term_normal (n : ℕ) (a : M) :
    Tag.term n a = Tag.term 0 (0 : M) ^ n * Tag.term 0 a := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ]
      calc
        Tag.term (n + 1) a = Tag.term n a * Tag.term 0 0 := by simp
        _ = (Tag.term 0 0 ^ n * Tag.term 0 a) * Tag.term 0 0 := by rw [ih]
        _ = (Tag.term 0 0 ^ n * Tag.term 0 0) * Tag.term 0 a := by ac_rfl
end Tag

variable (R M : Type*) [CommRing R] [AddCommMonoid M]

/-- The defining homogeneous quadratic relation. -/
def quadratic (a b : M) : MvPolynomial M R :=
  MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.X 0 * MvPolynomial.X (a + b)

/-- The ideal generated by all degree-two monoid relations. -/
def relationIdeal : Ideal (MvPolynomial M R) :=
  Ideal.span (Set.range (fun ab : M × M => quadratic R M ab.1 ab.2))

/-- Evaluate each variable at its degree-one monoid-algebra generator. -/
def evaluation : MvPolynomial M R →ₐ[R] MonoidAlgebra R (Tag M) :=
  MvPolynomial.aeval (fun a => MonoidAlgebra.of R (Tag M) (Tag.term 0 a))

/-- Every defining quadric vanishes under normal-form evaluation. -/
theorem relationIdeal_le_ker : relationIdeal R M ≤ RingHom.ker (evaluation R M).toRingHom := by
  apply Ideal.span_le.2
  rintro _ ⟨⟨a,b⟩, rfl⟩
  change evaluation R M (quadratic R M a b) = 0
  simp only [evaluation, quadratic, map_sub, map_mul, MvPolynomial.aeval_X, sub_eq_zero]
  rw [← map_mul, ← map_mul, Tag.quad]

/-- The quadratic quotient algebra. -/
abbrev Q := MvPolynomial M R ⧸ relationIdeal R M

/-- A variable viewed in the quadratic quotient. -/
def qVar (a : M) : Q R M := Ideal.Quotient.mkₐ R (relationIdeal R M) (MvPolynomial.X a)

/-- The defining relation holds between quotient variables. -/
theorem qVar_relation (a b : M) : qVar R M a * qVar R M b = qVar R M 0 * qVar R M (a+b) := by
  have h : Ideal.Quotient.mk (relationIdeal R M) (quadratic R M a b) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨(a,b),rfl⟩)
  simpa [quadratic, qVar, map_sub, map_mul, sub_eq_zero] using h

/-- Normal forms multiply correctly in the quadratic quotient. -/
def tagToQuotient : Tag M →* Q R M where
  toFun t := match t with
    | .unit => 1
    | .term n a => qVar R M 0 ^ n * qVar R M a
  map_one' := rfl
  map_mul' x y := by
    cases x with
    | unit => cases y <;> simp
    | term n a =>
      cases y with
      | unit => simp
      | term k b =>
        change qVar R M 0 ^ (n+k+1) * qVar R M (a+b) =
          (qVar R M 0 ^ n * qVar R M a) * (qVar R M 0 ^ k * qVar R M b)
        calc
          _ = (qVar R M 0 ^ n * qVar R M 0 ^ k) *
              (qVar R M 0 * qVar R M (a+b)) := by
            rw [pow_add, pow_add, pow_one]
            ring
          _ = _ := by rw [← qVar_relation R M a b]; ring

/-- Evaluate the normal-form monoid algebra in the quadratic quotient. -/
def reverseMap : MonoidAlgebra R (Tag M) →ₐ[R] Q R M :=
  MonoidAlgebra.lift R (Q R M) (Tag M) (tagToQuotient R M)

/-- The quotient projection factors through normal-form evaluation. -/
theorem reverseMap_evaluation : (reverseMap R M).comp (evaluation R M) =
    Ideal.Quotient.mkₐ R (relationIdeal R M) := by
  apply MvPolynomial.algHom_ext
  intro a
  simp [evaluation, reverseMap, tagToQuotient, qVar]

/-- The normal-form evaluation kernel is exactly the quadratic ideal. -/
theorem evaluation_kernel : RingHom.ker (evaluation R M).toRingHom = relationIdeal R M := by
  apply le_antisymm
  · intro P hP
    apply Ideal.Quotient.eq_zero_iff_mem.1
    have he : evaluation R M P = 0 := hP
    have h : ((reverseMap R M).comp (evaluation R M)) P = 0 := by
      change reverseMap R M (evaluation R M P) = 0
      rw [he, map_zero]
    rw [reverseMap_evaluation] at h
    exact h
  · exact relationIdeal_le_ker R M

/-- Normal-form evaluation descends to the quadratic quotient. -/
def quotientEvaluation : Q R M →ₐ[R] MonoidAlgebra R (Tag M) :=
  Ideal.Quotient.liftₐ (relationIdeal R M) (evaluation R M)
    (fun _ h => relationIdeal_le_ker R M h)

/-- A quotient variable maps to the corresponding degree-one generator. -/
theorem quotientEvaluation_qVar (a : M) :
    quotientEvaluation R M (qVar R M a) = MonoidAlgebra.of R (Tag M) (Tag.term 0 a) := by
  simp [quotientEvaluation, qVar, Ideal.Quotient.liftₐ_apply, evaluation]

/-- The descended evaluation is a left inverse of the reverse map. -/
theorem quotientEvaluation_reverseMap : (quotientEvaluation R M).comp (reverseMap R M) =
    AlgHom.id R (MonoidAlgebra R (Tag M)) := by
  apply MonoidAlgebra.algHom_ext
  · intro t
    change quotientEvaluation R M (reverseMap R M (MonoidAlgebra.of R (Tag M) t)) =
      MonoidAlgebra.of R (Tag M) t
    simp only [reverseMap, MonoidAlgebra.lift_of]
    cases t with
    | unit =>
      change quotientEvaluation R M 1 = MonoidAlgebra.of R (Tag M) 1
      rw [map_one, map_one]
    | term n a =>
      change quotientEvaluation R M (qVar R M 0 ^ n * qVar R M a) = _
      rw [map_mul, map_pow, quotientEvaluation_qVar, quotientEvaluation_qVar,
        ← map_pow, ← map_mul, ← Tag.term_normal]
  · ext

/-- The reverse map is a left inverse of the descended evaluation. -/
theorem reverseMap_quotientEvaluation : (reverseMap R M).comp (quotientEvaluation R M) =
    AlgHom.id R (Q R M) := by
  apply Ideal.Quotient.algHom_ext
  rw [AlgHom.comp_assoc]
  change (reverseMap R M).comp
    ((Ideal.Quotient.liftₐ (relationIdeal R M) (evaluation R M) _).comp
      (Ideal.Quotient.mkₐ R (relationIdeal R M))) = _
  rw [Ideal.Quotient.liftₐ_comp, reverseMap_evaluation, AlgHom.id_comp]

/-- The quadratic quotient is the monoid algebra of normal forms. -/
def quotientEquiv : Q R M ≃ₐ[R] MonoidAlgebra R (Tag M) :=
  AlgEquiv.ofAlgHom (quotientEvaluation R M) (reverseMap R M)
    (quotientEvaluation_reverseMap R M) (reverseMap_quotientEvaluation R M)


/-- Degree and label of a normal form. -/
def tagKey : Tag M → ℕ × M
  | .unit => (0,0)
  | .term n a => (n+1,a)

/-- Degree and label distinguish every normal form, including the unit. -/
theorem tagKey_injective : Function.Injective (tagKey M) := by
  intro x y h
  cases x with
  | unit =>
    cases y with
    | unit => rfl
    | term n a =>
      have h0 := congrArg Prod.fst h
      change 0 = n+1 at h0
      omega
  | term n a =>
    cases y with
    | unit =>
      have h0 := congrArg Prod.fst h
      change n+1 = 0 at h0
      omega
    | term k b =>
      have hh : (n+1,a) = (k+1,b) := h
      exact congrArg₂ Tag.term (Nat.add_right_cancel (Prod.mk.inj hh).1) (Prod.mk.inj hh).2

/-- Normal forms embed multiplicatively into the additive degree-label monoid. -/
def tagEmbedding : Tag M →* Multiplicative (ℕ × M) where
  toFun t := Multiplicative.ofAdd (tagKey M t)
  map_one' := rfl
  map_mul' x y := by
    change tagKey M (x*y) = tagKey M x + tagKey M y
    cases x <;> cases y <;>
      simp [tagKey, add_assoc, add_comm, add_left_comm]

/-- The degree-label embedding is injective. -/
theorem tagEmbedding_injective : Function.Injective (tagEmbedding M) := by
  intro x y h
  exact tagKey_injective M (congrArg Multiplicative.toAdd h)

/-- Realize the normal-form algebra inside the polynomial ring over the monoid algebra. -/
def polynomialRealization : MonoidAlgebra R (Tag M) →ₐ[R] Polynomial (AddMonoidAlgebra R M) :=
  (((Polynomial.toFinsuppIsoAlg (AddMonoidAlgebra R M)).symm.restrictScalars R).toAlgHom).comp
    ((AddMonoidAlgebra.curryAlgEquiv R).toAlgHom.comp
      (((AddMonoidAlgebra.toMultiplicativeAlgEquiv (R := R) R (ℕ × M)).symm.toAlgHom).comp
        (MonoidAlgebra.mapDomainAlgHom R R (tagEmbedding M))))

/-- The polynomial realization is faithful. -/
theorem polynomialRealization_injective : Function.Injective (polynomialRealization R M) :=
  ((Polynomial.toFinsuppIsoAlg (AddMonoidAlgebra R M)).symm.injective).comp
    ((AddMonoidAlgebra.curryAlgEquiv R).injective.comp
      ((AddMonoidAlgebra.toMultiplicativeAlgEquiv (R := R) R (ℕ × M)).symm.injective.comp
        (MonoidAlgebra.mapDomain_injective (tagEmbedding_injective M))))

/-- A basis element has its exact degree-label polynomial realization. -/
theorem polynomialRealization_single (t : Tag M) (r : R) :
    polynomialRealization R M (MonoidAlgebra.single t r) =
      Polynomial.monomial (tagKey M t).1 (AddMonoidAlgebra.single (tagKey M t).2 r) := by
  rcases h : tagKey M t with ⟨d,a⟩
  simp [polynomialRealization, MonoidAlgebra.mapDomainAlgHom, tagEmbedding,
    AddMonoidAlgebra.toMultiplicativeAlgEquiv, AddMonoidAlgebra.toMultiplicative,
    Polynomial.toFinsuppIsoAlg, Polynomial.toFinsuppIso, h]

/-- The homogenizing map `X_a ↦ T*[a]`. -/
def normalForm : MvPolynomial M R →ₐ[R] Polynomial (AddMonoidAlgebra R M) :=
  MvPolynomial.aeval (fun a => Polynomial.monomial 1 (AddMonoidAlgebra.single a 1))

/-- Homogenization factors through the normal-form monoid algebra. -/
theorem normalForm_factorization : normalForm R M =
    (polynomialRealization R M).comp (evaluation R M) := by
  apply MvPolynomial.algHom_ext
  intro a
  simp [normalForm, evaluation, MonoidAlgebra.of_apply, polynomialRealization_single, tagKey]

/-- The complete quadratic presentation of the homogenizing map. -/
theorem normalForm_kernel : RingHom.ker (normalForm R M).toRingHom = relationIdeal R M := by
  rw [← evaluation_kernel]
  ext P
  change normalForm R M P = 0 ↔ evaluation R M P = 0
  rw [normalForm_factorization]
  exact map_eq_zero_iff _ (polynomialRealization_injective R M)


end GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
