/-!
# Dense arithmetic instability of finite temporal rank

For a finite real frequency packet, define its exact rational coordinate rank
as the `ℚ`-dimension of the span of its coordinates.  This file proves:

* every positive admissible exact rank is dense in frequency space;
* when at least two coordinates are available, exact rank is nowhere
  continuous;
* this arithmetic instability coexists with the dimension-free finite-time
  `C⋆`-algebra perturbation law.

The density theorem is constructive at theorem level but uses no numerical
computation.  It first chooses a nearby rationally independent basis by
avoiding a countable rational span, then approximates every remaining
coordinate inside the dense rational line generated by the first basis
element.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Filter
open NormedSpace

noncomputable section

/-- Exact rational rank of a finite real coordinate packet. -/
def rationalCoordinateRank {n : ℕ} (ω : Fin n → ℝ) : ℕ :=
  Module.finrank ℚ (Submodule.span ℚ (Set.range ω))

/-- **The rational temporal rank of an `n`-coordinate packet is at most `n`.**  This is the
codomain of `r_ℚ : ℝⁿ → {0, 1, …, n}`: the span is generated by the `n` coordinates. -/
theorem rationalCoordinateRank_le {n : ℕ} (ω : Fin n → ℝ) : rationalCoordinateRank ω ≤ n := by
  classical
  have hrange : Set.range ω = ((Finset.univ.image ω : Finset ℝ) : Set ℝ) := by
    ext x
    simp
  have hcard : (Finset.univ.image ω).card ≤ n := by
    refine le_trans Finset.card_image_le ?_
    simp
  rw [rationalCoordinateRank, hrange]
  exact le_trans (finrank_span_finset_le_card _) hcard

/-- **Powers of a transcendental are rationally independent.**  A vanishing rational combination of
powers is a rational polynomial vanishing at the number, hence the zero polynomial. -/
theorem linearIndependent_pow_of_transcendental {θ : ℝ} (h : Transcendental ℚ θ) (k : ℕ) :
    LinearIndependent ℚ (fun i : Fin k => θ ^ (i : ℕ)) := by
  classical
  rw [linearIndependent_iff']
  intro s c hsum i hi
  set p : Polynomial ℚ := ∑ j ∈ s, Polynomial.C (c j) * Polynomial.X ^ (j : ℕ) with hp
  have haeval : Polynomial.aeval θ p = 0 := by
    rw [hp, map_sum]
    simpa [Algebra.smul_def] using hsum
  have hzero : p = 0 := (transcendental_iff.mp h) p haeval
  have hcoeff : p.coeff (i : ℕ) = c i := by
    rw [hp, Polynomial.finsetSum_coeff, Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      have hne : (i : ℕ) ≠ (j : ℕ) := fun hcon => hji (Fin.ext hcon).symm
      simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hne]
    · intro hni
      exact absurd hi hni
  rw [hzero] at hcoeff
  simpa using hcoeff.symm

/-- **Theorem A's model space has exactly the prescribed rank.**  The span of `1, θ, …, θ^{k-1}`
for a transcendental `θ` has rational dimension `k`: this is the card's `V_k`. -/
theorem rationalCoordinateRank_pow_of_transcendental {θ : ℝ} (h : Transcendental ℚ θ) (k : ℕ) :
    rationalCoordinateRank (fun i : Fin k => θ ^ (i : ℕ)) = k := by
  rw [rationalCoordinateRank]
  simpa using finrank_span_eq_card (linearIndependent_pow_of_transcendental h k)

/-- Transcendental reals exist: the algebraic ones are countable. -/
theorem exists_transcendental_real : ∃ θ : ℝ, Transcendental ℚ θ := by
  by_contra hcon
  push Not at hcon
  have hall : {x : ℝ | IsAlgebraic ℚ x} = Set.univ := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    simpa [Transcendental] using hcon x
  have hcount : (Set.univ : Set ℝ).Countable := hall ▸ Algebraic.countable ℚ ℝ
  exact Cardinal.not_countable_real hcount

/-- **A rational subspace of the reals containing one is dense.**  This is the card's step
"since `ℚ ⊂ V_k` and `ℚ` is dense in `ℝ`, `V_k` is dense in `ℝ`". -/
theorem dense_of_one_mem {W : Submodule ℚ ℝ} (h1 : (1 : ℝ) ∈ W) : Dense (W : Set ℝ) := by
  refine Dense.mono ?_ Rat.denseRange_cast
  rintro _ ⟨q, rfl⟩
  have hq : ((q : ℝ)) = q • (1 : ℝ) := by
    simp [Rat.smul_def]
  rw [hq]
  exact W.smul_mem q h1

/-- **The card's model space is dense.**  `V_k = span_ℚ{1, θ, …, θ^{k-1}}` contains `1`, hence is
dense in the reals. -/
theorem dense_span_pow {θ : ℝ} {k : ℕ} (hk : 0 < k) :
    Dense ((Submodule.span ℚ (Set.range fun i : Fin k => θ ^ (i : ℕ)) : Submodule ℚ ℝ) : Set ℝ) := by
  refine dense_of_one_mem ?_
  have hmem : θ ^ ((⟨0, hk⟩ : Fin k) : ℕ) ∈ Set.range fun i : Fin k => θ ^ (i : ℕ) :=
    ⟨⟨0, hk⟩, rfl⟩
  have h1 : θ ^ ((⟨0, hk⟩ : Fin k) : ℕ) = 1 := by simp
  rw [h1] at hmem
  exact Submodule.subset_span hmem

/-! ### Escaping a proper subspace along a detected direction

These are the two case distinctions the card's basis construction makes when it forms `v = a + q b`
with `b` outside the span built so far.
-/

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- **From inside the subspace, every nonzero correction escapes.** -/
theorem add_smul_notMem_of_mem {W : Submodule K V} {a b : V} (ha : a ∈ W) (hb : b ∉ W) {q : K}
    (hq : q ≠ 0) : a + q • b ∉ W := by
  intro hmem
  have hqb : q • b ∈ W := by
    have := W.sub_mem hmem ha
    simpa using this
  exact hb (by simpa [smul_smul, inv_mul_cancel₀ hq] using W.smul_mem q⁻¹ hqb)

/-- **From outside the subspace, at most one correction falls back in.** -/
theorem eq_of_add_smul_mem_of_add_smul_mem {W : Submodule K V} {a b : V} (hb : b ∉ W) {q q' : K}
    (h : a + q • b ∈ W) (h' : a + q' • b ∈ W) : q = q' := by
  by_contra hne
  have hsub : (q - q') • b ∈ W := by
    have := W.sub_mem h h'
    simpa [sub_smul] using this
  have hq : q - q' ≠ 0 := sub_ne_zero.mpr hne
  exact hb (by simpa [smul_smul, inv_mul_cancel₀ hq] using W.smul_mem (q - q')⁻¹ hsub)

/-- **The card's selection step.**  Inside a dense rational subspace `W`, arbitrarily close to any
real point there is an element of `W` outside any prescribed proper subspace `U < W`: take a nearby
element of `W`, and if it happens to lie in `U`, correct it by a small nonzero rational multiple of
a vector of `W` outside `U`. -/
theorem exists_mem_notMem_close {W U : Submodule ℚ ℝ} (hW : Dense (W : Set ℝ)) (hU : U < W)
    (x : ℝ) {ε : ℝ} (hε : 0 < ε) : ∃ y ∈ W, y ∉ U ∧ dist y x < ε := by
  obtain ⟨b, hbW, hbU⟩ : ∃ b ∈ W, b ∉ U := by
    obtain ⟨b, hbW, hbU⟩ := SetLike.exists_of_lt hU
    exact ⟨b, hbW, hbU⟩
  obtain ⟨a, haW, haclose⟩ := hW.exists_dist_lt x (half_pos hε)
  rw [dist_comm] at haclose
  by_cases haU : a ∉ U
  · exact ⟨a, haW, haU, lt_trans haclose (by linarith)⟩
  · push Not at haU
    have hbne : b ≠ 0 := fun hcon => hbU (by rw [hcon]; exact U.zero_mem)
    obtain ⟨m, hm⟩ := exists_nat_gt (2 * |b| / ε)
    have hmpos : (0 : ℝ) < m := lt_of_le_of_lt (by positivity) hm
    have hmnat : 0 < m := by exact_mod_cast hmpos
    have hmne : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hmnat.ne'
    set q : ℚ := (m : ℚ)⁻¹ with hq
    have hqne : q ≠ 0 := inv_ne_zero hmne
    have hqval : ((q : ℝ)) = (m : ℝ)⁻¹ := by
      rw [hq]
      push_cast
      ring
    have hsmall : |(q : ℝ) * b| < ε / 2 := by
      have hb2 : 2 * |b| < (m : ℝ) * ε := by
        rw [div_lt_iff₀ hε] at hm
        linarith [hm]
      rw [abs_mul, hqval, abs_of_pos (by positivity : (0:ℝ) < (m:ℝ)⁻¹), inv_mul_eq_div,
        div_lt_iff₀ hmpos]
      nlinarith [hb2]
    refine ⟨a + (q : ℝ) * b, ?_, ?_, ?_⟩
    · have : (q : ℝ) * b = q • b := by
        simp [Rat.smul_def]
      rw [this]
      exact W.add_mem haW (W.smul_mem q hbW)
    · have hsm : a + (q : ℝ) * b = a + q • b := by
        simp [Rat.smul_def]
      rw [hsm]
      exact add_smul_notMem_of_mem haU hbU hqne
    · calc dist (a + (q : ℝ) * b) x ≤ dist (a + (q : ℝ) * b) a + dist a x := dist_triangle _ _ _
        _ < ε / 2 + ε / 2 := by
            refine add_lt_add ?_ haclose
            rw [Real.dist_eq]
            simpa using hsmall
        _ = ε := by ring

/-- **The card's inductive basis construction.**  Inside a dense rational subspace of rational
dimension `k`, any `m ≤ k` prescribed reals are approximated by `m` independent elements of the
subspace. -/
theorem exists_linearIndependent_mem_close {W : Submodule ℚ ℝ} (hW : Dense (W : Set ℝ))
    {k : ℕ} (hfin : Module.finrank ℚ W = k) :
    ∀ m : ℕ, m ≤ k → ∀ z : Fin m → ℝ, ∀ ε : ℝ, 0 < ε →
      ∃ v : Fin m → ℝ, LinearIndependent ℚ v ∧ (∀ i, v i ∈ W) ∧ ∀ i, dist (v i) (z i) < ε := by
  intro m
  induction m with
  | zero =>
      intro _ _ ε _
      exact ⟨fun i => Fin.elim0 i, linearIndependent_empty_type,
        fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  | succ m ih =>
      intro hmk z ε hε
      obtain ⟨v, hvind, hvmem, hvclose⟩ := ih (by omega) (fun j : Fin m => z j.succ) ε hε
      have hspanle : Submodule.span ℚ (Set.range v) ≤ W := by
        refine Submodule.span_le.mpr ?_
        rintro _ ⟨i, rfl⟩
        exact hvmem i
      have hspanrank : Module.finrank ℚ (Submodule.span ℚ (Set.range v)) = m := by
        simpa using finrank_span_eq_card hvind
      have hlt : Submodule.span ℚ (Set.range v) < W :=
        Submodule.lt_of_le_of_finrank_lt_finrank hspanle (by rw [hspanrank, hfin]; omega)
      obtain ⟨a, haW, haU, haclose⟩ := exists_mem_notMem_close hW hlt (z 0) hε
      refine ⟨Fin.cons a v, hvind.finCons haU, ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simpa using haW
        · simpa using hvmem j
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simpa using haclose
        · simpa using hvclose j

/-- **Theorem A's construction, as the card writes it.**  Every real packet has arbitrarily close
packets whose entries all lie in a prescribed dense rational subspace of dimension `k` and whose
rational span is exactly that subspace; in particular their exact rational rank is `k`. -/
theorem exists_close_span_eq_of_dense {W : Submodule ℚ ℝ} (hW : Dense (W : Set ℝ))
    {k n : ℕ} (hfin : Module.finrank ℚ W = k) (hk : 0 < k) (hkn : k ≤ n)
    (x : Fin n → ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∃ y : Fin n → ℝ, (∀ i, dist (y i) (x i) < ε) ∧ (∀ i, y i ∈ W) ∧
      Submodule.span ℚ (Set.range y) = W := by
  classical
  haveI : Module.Finite ℚ W := Module.finite_of_finrank_pos (by rw [hfin]; exact hk)
  obtain ⟨v, hvind, hvmem, hvclose⟩ :=
    exists_linearIndependent_mem_close hW hfin k (le_refl k)
      (fun j : Fin k => x (Fin.castLE hkn j)) ε hε
  have hchoose : ∀ i : Fin n, ∃ w : ℝ, w ∈ W ∧ dist w (x i) < ε := by
    intro i
    obtain ⟨w, hwW, hwclose⟩ := hW.exists_dist_lt (x i) hε
    exact ⟨w, hwW, by rwa [dist_comm]⟩
  choose w hwW hwclose using hchoose
  refine ⟨fun i => if h : (i : ℕ) < k then v ⟨i, h⟩ else w i, ?_, ?_, ?_⟩
  · intro i
    by_cases h : (i : ℕ) < k
    · simp only [dif_pos h]
      have hcast : Fin.castLE hkn ⟨(i : ℕ), h⟩ = i := Fin.ext rfl
      simpa [hcast] using hvclose ⟨(i : ℕ), h⟩
    · simp only [dif_neg h]
      exact hwclose i
  · intro i
    by_cases h : (i : ℕ) < k
    · simp only [dif_pos h]
      exact hvmem ⟨(i : ℕ), h⟩
    · simp only [dif_neg h]
      exact hwW i
  · have hle : Submodule.span ℚ (Set.range fun i : Fin n =>
        if h : (i : ℕ) < k then v ⟨i, h⟩ else w i) ≤ W := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      by_cases h : (i : ℕ) < k
      · simpa [h] using hvmem ⟨(i : ℕ), h⟩
      · simpa [h] using hwW i
    haveI : Module.Finite ℚ (Submodule.span ℚ (Set.range fun i : Fin n =>
        if h : (i : ℕ) < k then v ⟨i, h⟩ else w i)) := Submodule.finiteDimensional_of_le hle
    refine Submodule.eq_of_le_of_finrank_eq hle (le_antisymm (Submodule.finrank_mono hle) ?_)
    have hsub : Submodule.span ℚ (Set.range v)
        ≤ Submodule.span ℚ (Set.range fun i : Fin n =>
          if h : (i : ℕ) < k then v ⟨i, h⟩ else w i) := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      refine Submodule.subset_span ⟨Fin.castLE hkn j, ?_⟩
      have hjlt : ((Fin.castLE hkn j : Fin n) : ℕ) < k := by simp
      simp only [dif_pos hjlt]
      congr 1
    have hrank : Module.finrank ℚ (Submodule.span ℚ (Set.range v)) = k := by
      simpa using finrank_span_eq_card hvind
    calc Module.finrank ℚ W = k := hfin
      _ = Module.finrank ℚ (Submodule.span ℚ (Set.range v)) := hrank.symm
      _ ≤ _ := Submodule.finrank_mono hsub

/-- Every real packet can be perturbed coordinatewise to a rationally
independent packet of the same length. -/
theorem exists_linearIndependent_close :
    ∀ (n : ℕ) (x : Fin n → ℝ) (ε : ℝ), 0 < ε →
      ∃ y : Fin n → ℝ,
        LinearIndependent ℚ y ∧
        ∀ i, dist (y i) (x i) < ε := by
  intro n
  induction n with
  | zero =>
      intro x ε hε
      refine ⟨fun i => Fin.elim0 i, linearIndependent_empty_type, ?_⟩
      intro i
      exact Fin.elim0 i
  | succ n ih =>
      intro x ε hε
      obtain ⟨v, hv, hvclose⟩ := ih (Fin.tail x) ε hε
      let S : Submodule ℚ ℝ := Submodule.span ℚ (Set.range v)
      haveI : Countable S := inferInstance
      have hScount : (S : Set ℝ).Countable :=
        Set.countable_coe_iff.mp (by infer_instance)
      have hSdense : Dense (S : Set ℝ)ᶜ := hScount.dense_compl ℝ
      obtain ⟨a, haS, haclose⟩ := hSdense.exists_dist_lt (x 0) hε
      refine ⟨Fin.cons a v, hv.finCons haS, ?_⟩
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simpa [dist_comm] using haclose
      · change dist (v j) (Fin.tail x j) < ε
        exact hvclose j

/-- A nonzero real number generates a dense rational line. -/
theorem exists_rat_mul_close {b x ε : ℝ} (hb : b ≠ 0) (hε : 0 < ε) :
    ∃ q : ℚ, dist ((q : ℝ) * b) x < ε := by
  have habs : 0 < |b| := abs_pos.mpr hb
  obtain ⟨q, hq⟩ :=
    Rat.denseRange_cast.exists_dist_lt (x / b) (div_pos hε habs)
  refine ⟨q, ?_⟩
  rw [Real.dist_eq] at hq ⊢
  have hq' : |(q : ℝ) - x / b| < ε / |b| := by
    simpa [abs_sub_comm] using hq
  have hmul := mul_lt_mul_of_pos_right hq' habs
  calc
    |(q : ℝ) * b - x| = |((q : ℝ) - x / b) * b| := by
      congr 1
      field_simp
    _ = |(q : ℝ) - x / b| * |b| := abs_mul _ _
    _ < (ε / |b|) * |b| := hmul
    _ = ε := div_mul_cancel₀ ε (ne_of_gt habs)

/-- In `k + r` coordinates, every packet has an arbitrarily close packet of
exact rational rank `k`, provided `k` is positive. -/
theorem exists_exactRationalRank_close_add
    (k r : ℕ) (hk : 0 < k) (x : Fin (k + r) → ℝ) (ε : ℝ) (hε : 0 < ε) :
    ∃ y : Fin (k + r) → ℝ,
      rationalCoordinateRank y = k ∧
      ∀ i, dist (y i) (x i) < ε := by
  let xhead : Fin k → ℝ := fun i => x (Fin.castAdd r i)
  obtain ⟨b, hb, hbclose⟩ := exists_linearIndependent_close k xhead ε hε
  let i0 : Fin k := ⟨0, hk⟩
  have hb0 : b i0 ≠ 0 := hb.ne_zero i0
  have htail : ∀ j : Fin r, ∃ q : ℚ, dist ((q : ℝ) * b i0) (x (Fin.natAdd k j)) < ε :=
    fun j => exists_rat_mul_close hb0 hε
  choose q hq using htail
  let tail : Fin r → ℝ := fun j => (q j : ℝ) * b i0
  let y : Fin (k + r) → ℝ := Fin.append b tail
  have hspan :
      Submodule.span ℚ (Set.range y) =
        Submodule.span ℚ (Set.range b) := by
    apply le_antisymm
    · refine Submodule.span_le.2 ?_
      rintro z ⟨i, rfl⟩
      refine Fin.addCases (motive := fun i => y i ∈ Submodule.span ℚ (Set.range b))
        (fun j => ?_) (fun j => ?_) i
      · exact Submodule.subset_span ⟨j, by simp [y]⟩
      · simpa [y, tail, Rat.smul_def] using
          (Submodule.span ℚ (Set.range b)).smul_mem (q j)
            (Submodule.subset_span ⟨i0, rfl⟩)
    · refine Submodule.span_le.2 ?_
      rintro z ⟨i, rfl⟩
      exact Submodule.subset_span ⟨Fin.castAdd r i, by simp [y]⟩
  refine ⟨y, ?_, ?_⟩
  · rw [rationalCoordinateRank, hspan, finrank_span_eq_card hb, Fintype.card_fin]
  · intro i
    refine Fin.addCases (motive := fun i => dist (y i) (x i) < ε)
      (fun j => ?_) (fun j => ?_) i
    · simpa [y, xhead] using hbclose j
    · simpa [y, tail] using hq j

/-- Every positive exact rank `k` is dense in `(Fin (k + r) → ℝ)`. -/
theorem dense_exactRationalRank_add (k r : ℕ) (hk : 0 < k) :
    Dense {ω : Fin (k + r) → ℝ | rationalCoordinateRank ω = k} := by
  rw [Metric.dense_iff]
  intro x ε hε
  obtain ⟨y, hyrank, hyclose⟩ :=
    exists_exactRationalRank_close_add k r hk x ε hε
  refine ⟨y, ?_, hyrank⟩
  rw [Metric.mem_ball, dist_pi_lt_iff hε]
  exact hyclose

/-- Every admissible positive rational rank occurs densely in `n` real
coordinates. -/
theorem dense_exactRationalRank {n k : ℕ} (hk : 0 < k) (hkn : k ≤ n) :
    Dense {ω : Fin n → ℝ | rationalCoordinateRank ω = k} := by
  obtain ⟨r, rfl⟩ := exists_add_of_le hkn
  exact dense_exactRationalRank_add k r hk

/-- With at least two available coordinates, exact rational rank is nowhere
continuous as a natural-number-valued function. -/
theorem rationalCoordinateRank_nowhereContinuous
    {n : ℕ} (hn : 2 ≤ n) (x : Fin n → ℝ) :
    ¬ ContinuousAt rationalCoordinateRank x := by
  intro hcont
  let k : ℕ := if rationalCoordinateRank x = 1 then 2 else 1
  have hkpos : 0 < k := by
    dsimp [k]
    split <;> omega
  have hkle : k ≤ n := by
    dsimp [k]
    split <;> omega
  have hkne : k ≠ rationalCoordinateRank x := by
    dsimp [k]
    split
    · omega
    · omega
  have hev :
      {y : Fin n → ℝ | rationalCoordinateRank y = rationalCoordinateRank x} ∈
        nhds x := by
    have hnat :
        ∀ᶠ z : ℕ in nhds (rationalCoordinateRank x),
          z = rationalCoordinateRank x := by
      simp
    exact Filter.Tendsto.eventually hcont hnat
  obtain ⟨y, hyrank, hyeq⟩ :=
    (dense_exactRationalRank hkpos hkle).inter_nhds_nonempty hev
  exact hkne (hyrank.symm.trans hyeq)

/-- Rational frequency space visible to an observer. -/
def visibleGapSubspace {n : ℕ} (ω : Fin n → ℝ) : Submodule ℚ ℝ :=
  Submodule.span ℚ (Set.range ω)

/-- Observer temporal dimension obeys exact inclusion-exclusion: the
dimension available to the joined observers plus their shared dimension is
the sum of their separate dimensions. -/
theorem observerTemporalDimension_conservation
    {m n : ℕ} (ω : Fin m → ℝ) (η : Fin n → ℝ) :
    Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
        Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
      rationalCoordinateRank ω + rationalCoordinateRank η := by
  letI : FiniteDimensional ℚ (visibleGapSubspace ω) :=
    FiniteDimensional.span_of_finite ℚ (Set.finite_range ω)
  letI : FiniteDimensional ℚ (visibleGapSubspace η) :=
    FiniteDimensional.span_of_finite ℚ (Set.finite_range η)
  change
    Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
          Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
        Module.finrank ℚ ↥(visibleGapSubspace ω) +
          Module.finrank ℚ ↥(visibleGapSubspace η)
  exact
    Submodule.finrank_sup_add_finrank_inf_eq
      (visibleGapSubspace ω) (visibleGapSubspace η)

/-- Formal finite core of the temporal-completion instability law.  Exact
finite frequency rank has every admissible dense stratum and is nowhere
continuous from two coordinates onward; observer temporal dimension obeys
inclusion-exclusion; and every operator-norm observable history in every
unital `C⋆`-algebra obeys the dimension-free finite-time perturbation bound. -/
theorem finiteTemporalCompletion_instability_stability_core :
    (∀ {n k : ℕ}, 0 < k → k ≤ n →
      Dense {ω : Fin n → ℝ | rationalCoordinateRank ω = k}) ∧
    (∀ {n : ℕ}, 2 ≤ n → ∀ x : Fin n → ℝ,
      ¬ ContinuousAt rationalCoordinateRank x) ∧
    (∀ {m n : ℕ} (ω : Fin m → ℝ) (η : Fin n → ℝ),
      Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
          Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
        rationalCoordinateRank ω + rationalCoordinateRank η) ∧
    (∀ {A : Type*} [CStarAlgebra A]
      (H K O : A), IsSelfAdjoint H → IsSelfAdjoint K → ∀ t : ℝ,
      ‖exp (t • ((-Complex.I) • H)) * O *
            star (exp (t • ((-Complex.I) • H))) -
          exp (t • ((-Complex.I) • K)) * O *
            star (exp (t • ((-Complex.I) • K)))‖
        ≤ 2 * |t| * ‖H - K‖ * ‖O‖) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro n k hk hkn
    exact dense_exactRationalRank hk hkn
  · intro n hn x
    exact rationalCoordinateRank_nowhereContinuous hn x
  · intro m n ω η
    exact observerTemporalDimension_conservation ω η
  · intro A _ H K O hH hK t
    exact selfAdjoint_heisenbergEvolution_norm_sub_le H K O hH hK t

end

