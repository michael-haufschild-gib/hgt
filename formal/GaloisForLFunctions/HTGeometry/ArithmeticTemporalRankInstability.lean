import GaloisForLFunctions.HTGeometry.FiniteHorizonCStarPerturbationLaw
import Mathlib.LinearAlgebra.Countable
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.Topology.Algebra.Module.Cardinality
import Mathlib.Topology.MetricSpace.Pseudo.Pi
import Mathlib.Tactic

/-!
# Dense arithmetic instability of finite temporal rank

For a finite real frequency packet, define its exact rational coordinate rank
as the `ℚ`-dimension of the span of its coordinates.  This file proves:

* every positive admissible exact rank is dense in frequency space;
* when at least two coordinates are available, exact rank is nowhere
  continuous;
* this arithmetic instability coexists with the dimension-free finite-time
  `C⋆`-algebra perturbation law.

The density theorem is constructive at theorem level but uses no numerical
computation.  It first chooses a nearby rationally independent basis by
avoiding a countable rational span, then approximates every remaining
coordinate inside the dense rational line generated by the first basis
element.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Filter
open NormedSpace

noncomputable section

/-- Exact rational rank of a finite real coordinate packet. -/
def rationalCoordinateRank {n : ℕ} (ω : Fin n → ℝ) : ℕ :=
  Module.finrank ℚ (Submodule.span ℚ (Set.range ω))

/-- Every real packet can be perturbed coordinatewise to a rationally
independent packet of the same length. -/
theorem exists_linearIndependent_close :
    ∀ (n : ℕ) (x : Fin n → ℝ) (ε : ℝ), 0 < ε →
      ∃ y : Fin n → ℝ,
        LinearIndependent ℚ y ∧
        ∀ i, dist (y i) (x i) < ε := by
  intro n
  induction n with
  | zero =>
      intro x ε hε
      refine ⟨fun i => Fin.elim0 i, linearIndependent_empty_type, ?_⟩
      intro i
      exact Fin.elim0 i
  | succ n ih =>
      intro x ε hε
      obtain ⟨v, hv, hvclose⟩ := ih (Fin.tail x) ε hε
      let S : Submodule ℚ ℝ := Submodule.span ℚ (Set.range v)
      haveI : Countable S := inferInstance
      have hScount : (S : Set ℝ).Countable :=
        Set.countable_coe_iff.mp (by infer_instance)
      have hSdense : Dense (S : Set ℝ)ᶜ := hScount.dense_compl ℝ
      obtain ⟨a, haS, haclose⟩ := hSdense.exists_dist_lt (x 0) hε
      refine ⟨Fin.cons a v, hv.finCons haS, ?_⟩
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simpa [dist_comm] using haclose
      · change dist (v j) (Fin.tail x j) < ε
        exact hvclose j

/-- A nonzero real number generates a dense rational line. -/
theorem exists_rat_mul_close {b x ε : ℝ} (hb : b ≠ 0) (hε : 0 < ε) :
    ∃ q : ℚ, dist ((q : ℝ) * b) x < ε := by
  have habs : 0 < |b| := abs_pos.mpr hb
  obtain ⟨q, hq⟩ :=
    Rat.denseRange_cast.exists_dist_lt (x / b) (div_pos hε habs)
  refine ⟨q, ?_⟩
  rw [Real.dist_eq] at hq ⊢
  have hq' : |(q : ℝ) - x / b| < ε / |b| := by
    simpa [abs_sub_comm] using hq
  have hmul := mul_lt_mul_of_pos_right hq' habs
  calc
    |(q : ℝ) * b - x| = |((q : ℝ) - x / b) * b| := by
      congr 1
      field_simp
    _ = |(q : ℝ) - x / b| * |b| := abs_mul _ _
    _ < (ε / |b|) * |b| := hmul
    _ = ε := div_mul_cancel₀ ε (ne_of_gt habs)

/-- In `k + r` coordinates, every packet has an arbitrarily close packet of
exact rational rank `k`, provided `k` is positive. -/
theorem exists_exactRationalRank_close_add
    (k r : ℕ) (hk : 0 < k) (x : Fin (k + r) → ℝ) (ε : ℝ) (hε : 0 < ε) :
    ∃ y : Fin (k + r) → ℝ,
      rationalCoordinateRank y = k ∧
      ∀ i, dist (y i) (x i) < ε := by
  let xhead : Fin k → ℝ := fun i => x (Fin.castAdd r i)
  obtain ⟨b, hb, hbclose⟩ := exists_linearIndependent_close k xhead ε hε
  let i0 : Fin k := ⟨0, hk⟩
  have hb0 : b i0 ≠ 0 := hb.ne_zero i0
  have htail : ∀ j : Fin r, ∃ q : ℚ, dist ((q : ℝ) * b i0) (x (Fin.natAdd k j)) < ε :=
    fun j => exists_rat_mul_close hb0 hε
  choose q hq using htail
  let tail : Fin r → ℝ := fun j => (q j : ℝ) * b i0
  let y : Fin (k + r) → ℝ := Fin.append b tail
  have hspan :
      Submodule.span ℚ (Set.range y) =
        Submodule.span ℚ (Set.range b) := by
    apply le_antisymm
    · refine Submodule.span_le.2 ?_
      rintro z ⟨i, rfl⟩
      refine Fin.addCases (motive := fun i => y i ∈ Submodule.span ℚ (Set.range b))
        (fun j => ?_) (fun j => ?_) i
      · exact Submodule.subset_span ⟨j, by simp [y]⟩
      · simpa [y, tail, Rat.smul_def] using
          (Submodule.span ℚ (Set.range b)).smul_mem (q j)
            (Submodule.subset_span ⟨i0, rfl⟩)
    · refine Submodule.span_le.2 ?_
      rintro z ⟨i, rfl⟩
      exact Submodule.subset_span ⟨Fin.castAdd r i, by simp [y]⟩
  refine ⟨y, ?_, ?_⟩
  · rw [rationalCoordinateRank, hspan, finrank_span_eq_card hb, Fintype.card_fin]
  · intro i
    refine Fin.addCases (motive := fun i => dist (y i) (x i) < ε)
      (fun j => ?_) (fun j => ?_) i
    · simpa [y, xhead] using hbclose j
    · simpa [y, tail] using hq j

/-- Every positive exact rank `k` is dense in `(Fin (k + r) → ℝ)`. -/
theorem dense_exactRationalRank_add (k r : ℕ) (hk : 0 < k) :
    Dense {ω : Fin (k + r) → ℝ | rationalCoordinateRank ω = k} := by
  rw [Metric.dense_iff]
  intro x ε hε
  obtain ⟨y, hyrank, hyclose⟩ :=
    exists_exactRationalRank_close_add k r hk x ε hε
  refine ⟨y, ?_, hyrank⟩
  rw [Metric.mem_ball, dist_pi_lt_iff hε]
  exact hyclose

/-- Every admissible positive rational rank occurs densely in `n` real
coordinates. -/
theorem dense_exactRationalRank {n k : ℕ} (hk : 0 < k) (hkn : k ≤ n) :
    Dense {ω : Fin n → ℝ | rationalCoordinateRank ω = k} := by
  obtain ⟨r, rfl⟩ := exists_add_of_le hkn
  exact dense_exactRationalRank_add k r hk

/-- With at least two available coordinates, exact rational rank is nowhere
continuous as a natural-number-valued function. -/
theorem rationalCoordinateRank_nowhereContinuous
    {n : ℕ} (hn : 2 ≤ n) (x : Fin n → ℝ) :
    ¬ ContinuousAt rationalCoordinateRank x := by
  intro hcont
  let k : ℕ := if rationalCoordinateRank x = 1 then 2 else 1
  have hkpos : 0 < k := by
    dsimp [k]
    split <;> omega
  have hkle : k ≤ n := by
    dsimp [k]
    split <;> omega
  have hkne : k ≠ rationalCoordinateRank x := by
    dsimp [k]
    split
    · omega
    · omega
  have hev :
      {y : Fin n → ℝ | rationalCoordinateRank y = rationalCoordinateRank x} ∈
        nhds x := by
    have hnat :
        ∀ᶠ z : ℕ in nhds (rationalCoordinateRank x),
          z = rationalCoordinateRank x := by
      simp
    exact Filter.Tendsto.eventually hcont hnat
  obtain ⟨y, hyrank, hyeq⟩ :=
    (dense_exactRationalRank hkpos hkle).inter_nhds_nonempty hev
  exact hkne (hyrank.symm.trans hyeq)

/-- Rational frequency space visible to an observer. -/
def visibleGapSubspace {n : ℕ} (ω : Fin n → ℝ) : Submodule ℚ ℝ :=
  Submodule.span ℚ (Set.range ω)

/-- Observer temporal dimension obeys exact inclusion-exclusion: the
dimension available to the joined observers plus their shared dimension is
the sum of their separate dimensions. -/
theorem observerTemporalDimension_conservation
    {m n : ℕ} (ω : Fin m → ℝ) (η : Fin n → ℝ) :
    Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
        Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
      rationalCoordinateRank ω + rationalCoordinateRank η := by
  letI : FiniteDimensional ℚ (visibleGapSubspace ω) :=
    FiniteDimensional.span_of_finite ℚ (Set.finite_range ω)
  letI : FiniteDimensional ℚ (visibleGapSubspace η) :=
    FiniteDimensional.span_of_finite ℚ (Set.finite_range η)
  change
    Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
          Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
        Module.finrank ℚ ↥(visibleGapSubspace ω) +
          Module.finrank ℚ ↥(visibleGapSubspace η)
  exact
    Submodule.finrank_sup_add_finrank_inf_eq
      (visibleGapSubspace ω) (visibleGapSubspace η)

/-- Formal finite core of the temporal-completion instability law.  Exact
finite frequency rank has every admissible dense stratum and is nowhere
continuous from two coordinates onward; observer temporal dimension obeys
inclusion-exclusion; and every operator-norm observable history in every
unital `C⋆`-algebra obeys the dimension-free finite-time perturbation bound. -/
theorem finiteTemporalCompletion_instability_stability_core :
    (∀ {n k : ℕ}, 0 < k → k ≤ n →
      Dense {ω : Fin n → ℝ | rationalCoordinateRank ω = k}) ∧
    (∀ {n : ℕ}, 2 ≤ n → ∀ x : Fin n → ℝ,
      ¬ ContinuousAt rationalCoordinateRank x) ∧
    (∀ {m n : ℕ} (ω : Fin m → ℝ) (η : Fin n → ℝ),
      Module.finrank ℚ ↥((visibleGapSubspace ω) ⊔ (visibleGapSubspace η)) +
          Module.finrank ℚ ↥((visibleGapSubspace ω) ⊓ (visibleGapSubspace η)) =
        rationalCoordinateRank ω + rationalCoordinateRank η) ∧
    (∀ {A : Type*} [CStarAlgebra A]
      (H K O : A), IsSelfAdjoint H → IsSelfAdjoint K → ∀ t : ℝ,
      ‖exp (t • ((-Complex.I) • H)) * O *
            star (exp (t • ((-Complex.I) • H))) -
          exp (t • ((-Complex.I) • K)) * O *
            star (exp (t • ((-Complex.I) • K)))‖
        ≤ 2 * |t| * ‖H - K‖ * ‖O‖) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro n k hk hkn
    exact dense_exactRationalRank hk hkn
  · intro n hn x
    exact rationalCoordinateRank_nowhereContinuous hn x
  · intro m n ω η
    exact observerTemporalDimension_conservation ω η
  · intro A _ H K O hH hK t
    exact selfAdjoint_heisenbergEvolution_norm_sub_le H K O hH hK t

end

end GaloisForLFunctions.HTGeometry
