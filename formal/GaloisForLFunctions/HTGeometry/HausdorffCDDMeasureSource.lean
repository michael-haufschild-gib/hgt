import GaloisForLFunctions.HTGeometry.CompactMomentDeterminacy
import GaloisForLFunctions.HTGeometry.HausdorffCDDPhaseKernel
import GaloisForLFunctions.HTGeometry.HausdorffPositiveCddCone

/-!
# Finite Hausdorff measures as CDD phase sources

This module upgrades the finite atomic necessity theorem to every finite positive Borel measure on
the unit interval.  It proves the exact iterated-difference integral, complete monotonicity,
moment determinacy, the real-axis phase-kernel transform, additivity, and the literal point-mass
shell and zero-shell laws.
-/

open MeasureTheory Set
open scoped ENNReal NNReal

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Compact source space for Hausdorff moment sequences. -/
abbrev HausdorffSourceSpace := Set.Icc (0 : ℝ) 1

/-- Moment sequence of a finite positive source on `[0,1]`. -/
def hausdorffMoment (ν : Measure HausdorffSourceSpace) (m : ℕ) : ℝ :=
  ∫ y : HausdorffSourceSpace, (y : ℝ) ^ m ∂ν

/-- Complete monotonicity in the forward-difference convention of the CDD coupling card. -/
def HausdorffCompletelyMonotone (b : ℕ → ℝ) : Prop :=
  ∀ m k : ℕ, 0 ≤ (-1) ^ k * ((fwdDiff 1)^[k] b m)

theorem integrable_hausdorffDifferenceIntegrand (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] (k m : ℕ) :
    Integrable (fun y : HausdorffSourceSpace => ((y : ℝ) - 1) ^ k * (y : ℝ) ^ m) ν :=
  integrable_of_continuous ν (by fun_prop)

/-- Formula `(8)` before sign correction: every forward difference inserts one factor `y-1`. -/
theorem fwdDiff_iter_hausdorffMoment (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] (k : ℕ) :
    ∀ m : ℕ, (fwdDiff 1)^[k] (hausdorffMoment ν) m =
      ∫ y : HausdorffSourceSpace, ((y : ℝ) - 1) ^ k * (y : ℝ) ^ m ∂ν := by
  induction k with
  | zero =>
      intro m
      simp [hausdorffMoment]
  | succ k ih =>
      intro m
      rw [Function.iterate_succ_apply', fwdDiff, ih (m + 1), ih m,
        ← MeasureTheory.integral_sub
          (integrable_hausdorffDifferenceIntegrand ν k (m + 1))
          (integrable_hausdorffDifferenceIntegrand ν k m)]
      apply integral_congr_ae
      filter_upwards with y
      ring

/-- Exact signed Hausdorff finite-difference identity `(8)`. -/
theorem signed_fwdDiff_iter_hausdorffMoment (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] (m k : ℕ) :
    (-1) ^ k * ((fwdDiff 1)^[k] (hausdorffMoment ν) m) =
      ∫ y : HausdorffSourceSpace, (y : ℝ) ^ m * (1 - (y : ℝ)) ^ k ∂ν := by
  rw [fwdDiff_iter_hausdorffMoment, ← MeasureTheory.integral_const_mul]
  apply integral_congr_ae
  filter_upwards with y
  rw [show (1 - (y : ℝ)) ^ k = (-1 : ℝ) ^ k * ((y : ℝ) - 1) ^ k by
    rw [← neg_sub, neg_pow]]
  ring

/-- Every finite positive Hausdorff source has a completely monotone moment sequence. -/
theorem hausdorffMoment_completelyMonotone (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] (m k : ℕ) :
    0 ≤ (-1) ^ k * ((fwdDiff 1)^[k] (hausdorffMoment ν) m) := by
  rw [signed_fwdDiff_iter_hausdorffMoment]
  exact integral_nonneg fun y =>
    mul_nonneg (pow_nonneg y.property.1 m) (pow_nonneg (sub_nonneg.mpr y.property.2) k)

theorem hausdorffMoment_isCompletelyMonotone (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] :
    HausdorffCompletelyMonotone (hausdorffMoment ν) :=
  hausdorffMoment_completelyMonotone ν

/-- The full moment vector determines the finite source measure uniquely. -/
theorem hausdorffSource_eq_of_moments_eq {μ ν : Measure HausdorffSourceSpace}
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ m : ℕ, hausdorffMoment μ m = hausdorffMoment ν m) :
    μ = ν :=
  ext_of_forall_integral_pow_eq h

/-- Real-axis CDD phase generated by a finite positive Hausdorff source. -/
def hausdorffCDDPhase (ν : Measure HausdorffSourceSpace) (θ : ℝ) : ℝ :=
  ∫ y : HausdorffSourceSpace, cddPhaseKernel (y : ℝ) θ ∂ν

theorem integrable_cddPhaseKernel_hausdorffSource (ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure ν] (θ : ℝ) :
    Integrable (fun y : HausdorffSourceSpace => cddPhaseKernel (y : ℝ) θ) ν :=
  integrable_of_continuous ν ((continuous_cddPhaseKernel θ).comp continuous_subtype_val)

/-- Source addition is exactly phase addition. -/
theorem hausdorffCDDPhase_add (μ ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] (θ : ℝ) :
    hausdorffCDDPhase (μ + ν) θ = hausdorffCDDPhase μ θ + hausdorffCDDPhase ν θ := by
  exact MeasureTheory.integral_add_measure
    (integrable_cddPhaseKernel_hausdorffSource μ θ)
    (integrable_cddPhaseKernel_hausdorffSource ν θ)

/-- Addition of positive sources becomes multiplication of their unitary real-axis factors. -/
theorem exp_I_hausdorffCDDPhase_add (μ ν : Measure HausdorffSourceSpace)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] (θ : ℝ) :
    Complex.exp (Complex.I * (hausdorffCDDPhase (μ + ν) θ : ℂ)) =
      Complex.exp (Complex.I * (hausdorffCDDPhase μ θ : ℂ)) *
        Complex.exp (Complex.I * (hausdorffCDDPhase ν θ : ℂ)) := by
  rw [hausdorffCDDPhase_add, Complex.ofReal_add, mul_add, Complex.exp_add]

/-- Positive point source of weight `w` at `y`. -/
def hausdorffAtomSource (w : ℝ≥0) (y : HausdorffSourceSpace) :
    Measure HausdorffSourceSpace :=
  w • Measure.dirac y

instance (w : ℝ≥0) (y : HausdorffSourceSpace) :
    IsFiniteMeasure (hausdorffAtomSource w y) := by
  unfold hausdorffAtomSource
  infer_instance

theorem hausdorffMoment_atom (w : ℝ≥0) (y : HausdorffSourceSpace) (m : ℕ) :
    hausdorffMoment (hausdorffAtomSource w y) m = (w : ℝ) * (y : ℝ) ^ m := by
  simp [hausdorffMoment, hausdorffAtomSource, NNReal.smul_def]

theorem hausdorffCDDPhase_atom (w : ℝ≥0) (y : HausdorffSourceSpace) (θ : ℝ) :
    hausdorffCDDPhase (hausdorffAtomSource w y) θ =
      (w : ℝ) * cddPhaseKernel (y : ℝ) θ := by
  simp [hausdorffCDDPhase, hausdorffAtomSource, NNReal.smul_def]

/-- The zero-shell point source is exactly the flat-JT / ordinary `T bar T` phase ray. -/
theorem hausdorffCDDPhase_zero_atom (w : ℝ≥0) (θ : ℝ) :
    hausdorffCDDPhase
        (hausdorffAtomSource w (⟨0, by constructor <;> norm_num⟩ : HausdorffSourceSpace)) θ =
      8 * (w : ℝ) * Real.sinh θ := by
  rw [hausdorffCDDPhase_atom, cddPhaseKernel_zero]
  ring

/-- A point source of physical weight `r` at `y=r²` is exactly one paired CDD shell. -/
theorem hausdorffCDDPhase_shell_atom {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) (θ : ℝ) :
    hausdorffCDDPhase
        (hausdorffAtomSource ⟨r, hr.le⟩
          (⟨r ^ 2, by constructor <;> nlinarith [sq_nonneg r]⟩ : HausdorffSourceSpace)) θ =
      4 * Real.arctan (2 * r * Real.sinh θ / (1 + r ^ 2)) := by
  rw [hausdorffCDDPhase_atom]
  exact cddPhaseKernel_sq hr θ

end

end GaloisForLFunctions.HTGeometry
