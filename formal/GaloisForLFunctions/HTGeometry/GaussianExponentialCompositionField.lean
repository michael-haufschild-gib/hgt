import GaloisForLFunctions.HTGeometry.AutonomousCapCostComparison
import GaloisForLFunctions.HTGeometry.CompositionShadowLaw

/-!
# The four-generator field of the Gaussian primitive and its exponential

Clunie's composition-growth theorem makes `exp ∘ G` transcendental over the finite jet field of the
Gaussian primitive `G`, which is the field of the coordinate, the Gaussian exponential `E` and `G`
itself.  Hence the coordinate, `E`, `G` and `Y = exp G` span four transcendence degrees, and the
field they generate is closed under the derivation because

`z′ = 1`, `E′ = −2z E`, `G′ = E`, `Y′ = E Y`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open scoped Differential

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

/-! ### The exponential of the Gaussian primitive -/

theorem analyticOnNhd_expGauss :
    AnalyticOnNhd ℂ (fun w : ℂ => Complex.exp (gaussPrimitive w)) (Set.univ : Set ℂ) :=
  differentiable_expGauss.differentiableOn.analyticOnNhd isOpen_univ

/-- The exponential of the Gaussian primitive as an element of the meromorphic field. -/
def gaussExpElem : meroField (Set.univ : Set ℂ) :=
  analyticMeroElement (fun w : ℂ => Complex.exp (gaussPrimitive w)) analyticOnNhd_expGauss

theorem deriv_gaussExpElem : gaussExpElem′ = gaussElem * gaussExpElem := by
  rw [gaussExpElem, deriv_analyticMeroElement', gaussElem,
    ← analyticMeroElement_mul analyticOnNhd_gaussianExp analyticOnNhd_expGauss]
  refine analyticMeroElement_congr _ _ ?_
  funext z
  rw [((hasDerivAt_gaussPrimitive z).cexp).deriv]
  ring

theorem gaussExpElem_ne_zero : gaussExpElem ≠ 0 := by
  rw [gaussExpElem]
  intro h
  have := (analyticMeroElement_eq_zero_iff analyticOnNhd_expGauss).mp h 0 (Set.mem_univ 0)
  exact Complex.exp_ne_zero _ this

/-! ### The first jet family of the Gaussian primitive -/

theorem jetGen_one_apply_zero : jetGen differentiable_gaussPrimitive 1 0 = coordElem :=
  jetGen_zero_eq_coordElem _ 1

theorem jetGen_one_apply_one : jetGen differentiable_gaussPrimitive 1 1 = gaussPrimElem := by
  have h := jetGen_succ differentiable_gaussPrimitive 1 (0 : Fin 2)
  have h1 : jetGen differentiable_gaussPrimitive 1 1 = jetElem differentiable_gaussPrimitive 0 := h
  rw [h1, jetElem_gaussPrimitive_zero]

theorem jetGen_one_apply_two : jetGen differentiable_gaussPrimitive 1 2 = gaussElem := by
  have h := jetGen_succ differentiable_gaussPrimitive 1 (1 : Fin 2)
  have h1 : jetGen differentiable_gaussPrimitive 1 2 = jetElem differentiable_gaussPrimitive 1 := h
  rw [h1, jetElem_gaussPrimitive_one]

theorem range_jetGen_one :
    Set.range (jetGen differentiable_gaussPrimitive 1) = gaussTriple := by
  ext y
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · show jetGen differentiable_gaussPrimitive 1 0 ∈ gaussTriple
      rw [jetGen_one_apply_zero]
      exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)
    · show jetGen differentiable_gaussPrimitive 1 1 ∈ gaussTriple
      rw [jetGen_one_apply_one]
      exact Set.mem_insert _ _
    · show jetGen differentiable_gaussPrimitive 1 2 ∈ gaussTriple
      rw [jetGen_one_apply_two]
      exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
  · rintro (rfl | rfl | rfl)
    · exact ⟨1, jetGen_one_apply_one⟩
    · exact ⟨2, jetGen_one_apply_two⟩
    · exact ⟨0, jetGen_one_apply_zero⟩

/-- **Clunie growth makes the exponential of the Gaussian primitive transcendental over the jet
field of the primitive.** -/
theorem not_isAlgebraic_gaussExpElem :
    ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ gaussTriple) gaussExpElem := by
  have h := not_isAlgebraic_comp_over_jetGen Complex.differentiable_exp
    differentiable_gaussPrimitive not_poly_cexp not_poly_gaussPrimitive 1 analyticOnNhd_expGauss
  rw [range_jetGen_one] at h
  exact h

/-! ### The four-generator field -/

/-- The field generated by the coordinate, the Gaussian exponential, the Gaussian primitive and the
exponential of the primitive. -/
def quadField : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
  IntermediateField.adjoin ℂ (insert gaussExpElem gaussTriple)

theorem gaussExpElem_mem_quadField : gaussExpElem ∈ quadField :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert _ _)

theorem gaussPrimElem_mem_quadField : gaussPrimElem ∈ quadField :=
  IntermediateField.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem gaussElem_mem_quadField : gaussElem ∈ quadField :=
  IntermediateField.subset_adjoin ℂ _
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))

theorem coordElem_mem_quadField : coordElem ∈ quadField :=
  IntermediateField.subset_adjoin ℂ _
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)))

theorem derivationClosed_quadField : DerivationClosed quadField := by
  have hbase : ∀ c : ℂ, (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)′ ∈ quadField := by
    intro c
    rw [deriv_complexConst]
    exact zero_mem _
  have hgen : ∀ x ∈ insert gaussExpElem gaussTriple, x ∈ quadField ∧ x′ ∈ quadField := by
    rintro x (rfl | rfl | rfl | rfl)
    · refine ⟨gaussExpElem_mem_quadField, ?_⟩
      rw [deriv_gaussExpElem]
      exact IntermediateField.mul_mem _ gaussElem_mem_quadField gaussExpElem_mem_quadField
    · refine ⟨gaussPrimElem_mem_quadField, ?_⟩
      rw [deriv_gaussPrimElem]
      exact gaussElem_mem_quadField
    · refine ⟨gaussElem_mem_quadField, ?_⟩
      rw [deriv_gaussElem, algebraMap_gaussLogDeriv_eq]
      exact IntermediateField.mul_mem _
        (IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _)
          coordElem_mem_quadField) gaussElem_mem_quadField
    · exact ⟨coordElem_mem_quadField, by rw [deriv_coordElem]; exact one_mem _⟩
  intro x hx
  have hle := adjoin_le_derivStableField (C := ℂ) (L := quadField) (hbase := hbase) hgen
  exact (mem_derivStableField_iff.mp (hle hx)).2

/-- **The four states span four transcendence degrees.** -/
theorem trdeg_quadField : Algebra.trdeg ℂ ↥quadField = 4 := by
  have h1 := trdeg_adjoin_insert_eq_add_one not_isAlgebraic_gaussExpElem
  exact h1.trans
    ((congrArg (fun c : Cardinal => c + 1) trdeg_adjoin_gaussTriple).trans (by norm_num))

end

end GaloisForLFunctions.HTGeometry
