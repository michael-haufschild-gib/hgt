import GaloisForLFunctions.HTGeometry.HardyDiskMultiplier

/-!
# Cyclic vectors of the shift on `H²(D)`

`hardy-cyclicity-maximal-ht-field-blindness`, statement `1` and the first half of statement `4`.

The cyclic subspace of `f` is the closed span of its polynomial multiples.  If `φ` is analytic and
bounded on the disk together with an analytic bounded inverse, then multiplication by `φ` is a
topological isomorphism of `H²(D)`, so the element it produces from the constant `1` is a cyclic
vector:

```text
[O] = H²(D)   whenever   O, O⁻¹ ∈ H^∞(D).
```

No boundary theory and no Beurling factorization is needed for this direction.
-/

open Complex Filter Metric Real Topology

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-! ## The constant function -/

/-- The constant function `1`, as an element of `H²(D)`. -/
def hardyOne : HardyDisk := lp.single 2 0 (1 : ℂ)

theorem hardyFun_single (n : ℕ) {z : ℂ} (hz : ‖z‖ < 1) :
    hardyFun (lp.single 2 n (1 : ℂ) : HardyDisk) z = z ^ n := by
  set g : HardyDisk := lp.single 2 n (1 : ℂ) with hg
  rw [hardyFun]
  have hterm : ∀ m : ℕ, g m * z ^ m = if m = n then z ^ n else 0 := by
    intro m
    have hval : g m = if m = n then (1 : ℂ) else 0 := by
      rw [hg]
      simp [lp.single_apply, Pi.single_apply]
    rw [hval]
    by_cases h : m = n
    · subst h; simp
    · simp [h]
  rw [tsum_congr hterm, tsum_ite_eq]

@[simp] theorem hardyFun_hardyOne {z : ℂ} (hz : ‖z‖ < 1) : hardyFun hardyOne z = 1 := by
  rw [hardyOne, hardyFun_single 0 hz, pow_zero]

/-- The `H²` element determined by a bounded analytic function. -/
def hardyOf (φ : DiskMultiplier) : HardyDisk := hardyMul φ hardyOne

theorem hardyFun_hardyOf (φ : DiskMultiplier) {z : ℂ} (hz : ‖z‖ < 1) :
    hardyFun (hardyOf φ) z = φ.fn z := by
  rw [hardyOf, hardyFun_hardyMul φ hardyOne hz, hardyFun_hardyOne hz, mul_one]

/-! ## Polynomial multiples and cyclic subspaces -/

/-- The span of the polynomial multiples of `f`. -/
def polyMultiples (f : HardyDisk) : Submodule ℂ HardyDisk :=
  Submodule.span ℂ (Set.range fun n : ℕ => ((hardyMul diskShift) ^ n) f)

/-- The cyclic subspace generated by `f`. -/
def cyclicSubspace (f : HardyDisk) : Submodule ℂ HardyDisk :=
  (polyMultiples f).topologicalClosure

theorem hardyFun_shift_pow (n : ℕ) (f : HardyDisk) {z : ℂ} (hz : ‖z‖ < 1) :
    hardyFun (((hardyMul diskShift) ^ n) f) z = z ^ n * hardyFun f z := by
  induction n with
  | zero => simp
  | succ n ih =>
      have hstep : ((hardyMul diskShift) ^ (n + 1)) f
          = hardyMul diskShift (((hardyMul diskShift) ^ n) f) := by
        rw [pow_succ']
        rfl
      rw [hstep, hardyFun_hardyMul diskShift _ hz, ih]
      show z * (z ^ n * hardyFun f z) = z ^ (n + 1) * hardyFun f z
      ring

theorem shift_pow_hardyOne (n : ℕ) :
    ((hardyMul diskShift) ^ n) hardyOne = (lp.single 2 n (1 : ℂ) : HardyDisk) := by
  refine hardyDisk_ext fun z hz => ?_
  rw [hardyFun_shift_pow n hardyOne hz, hardyFun_hardyOne hz, mul_one, hardyFun_single n hz]

/-! ## The constant function is cyclic -/

theorem cyclicSubspace_hardyOne : cyclicSubspace hardyOne = ⊤ := by
  refine Submodule.eq_top_iff'.mpr fun x => ?_
  have hsum : HasSum (fun n : ℕ => (lp.single 2 n (x n) : HardyDisk)) x :=
    lp.hasSum_single (by norm_num) x
  have hmem : ∀ n : ℕ, (lp.single 2 n (x n) : HardyDisk) ∈ polyMultiples hardyOne := by
    intro n
    have hbase : (lp.single 2 n (1 : ℂ) : HardyDisk) ∈ polyMultiples hardyOne := by
      rw [polyMultiples, ← shift_pow_hardyOne n]
      exact Submodule.subset_span ⟨n, rfl⟩
    have hsm : (x n) • (lp.single 2 n (1 : ℂ) : HardyDisk)
        = (lp.single 2 n (x n) : HardyDisk) := by
      refine lp.ext (funext fun m => ?_)
      by_cases h : m = n
      · subst h; simp [lp.single_apply, Pi.single_apply]
      · simp [lp.single_apply, Pi.single_apply, h]
    rw [← hsm]
    exact Submodule.smul_mem _ _ hbase
  refine mem_closure_of_tendsto hsum ?_
  filter_upwards with s
  exact Submodule.sum_mem _ fun n _ => hmem n

/-! ## Invertible multipliers give cyclic vectors -/

theorem hardyMul_surjective {φ ψ : DiskMultiplier}
    (h : ∀ z ∈ Metric.ball (0:ℂ) 1, φ.fn z * ψ.fn z = 1) :
    Function.Surjective (hardyMul φ) := by
  intro g
  refine ⟨hardyMul ψ g, ?_⟩
  rw [hardyMul_mul]
  have hcong : hardyMul (φ.mul ψ) g = hardyMul DiskMultiplier.one g :=
    hardyMul_congr (fun z hz => h z hz) g
  rw [hcong, hardyMul_one]

theorem topologicalClosure_map_eq_top {T : HardyDisk →L[ℂ] HardyDisk}
    (hT : Function.Surjective T) {V : Submodule ℂ HardyDisk}
    (hV : V.topologicalClosure = ⊤) :
    (V.map (T : HardyDisk →ₗ[ℂ] HardyDisk)).topologicalClosure = ⊤ := by
  have hVc : closure (V : Set HardyDisk) = Set.univ := by
    have hcong := congrArg (fun W : Submodule ℂ HardyDisk => (W : Set HardyDisk)) hV
    rwa [Submodule.topologicalClosure_coe, Submodule.top_coe] at hcong
  refine Submodule.eq_top_iff'.mpr fun x => ?_
  obtain ⟨y, rfl⟩ := hT x
  have h1 : T y ∈ (T : HardyDisk → HardyDisk) '' (closure (V : Set HardyDisk)) := by
    refine ⟨y, ?_, rfl⟩
    rw [hVc]
    trivial
  have h2 : (T : HardyDisk → HardyDisk) '' (closure (V : Set HardyDisk))
      ⊆ closure ((T : HardyDisk → HardyDisk) '' (V : Set HardyDisk)) :=
    image_closure_subset_closure_image T.continuous
  have h3 : T y ∈ closure ((V.map (T : HardyDisk →ₗ[ℂ] HardyDisk)) : Set HardyDisk) := by
    rw [Submodule.map_coe]
    exact h2 h1
  exact h3

theorem polyMultiples_map (φ : DiskMultiplier) (f : HardyDisk) :
    polyMultiples (hardyMul φ f)
      = (polyMultiples f).map ((hardyMul φ : HardyDisk →L[ℂ] HardyDisk) :
          HardyDisk →ₗ[ℂ] HardyDisk) := by
  have hcomm : ∀ n : ℕ, ((hardyMul diskShift) ^ n) (hardyMul φ f)
      = hardyMul φ (((hardyMul diskShift) ^ n) f) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
        have hstep : ∀ g : HardyDisk, ((hardyMul diskShift) ^ (n + 1)) g
            = hardyMul diskShift (((hardyMul diskShift) ^ n) g) := by
          intro g
          rw [pow_succ']
          rfl
        rw [hstep, ih, hstep, hardyMul_comm]
  rw [polyMultiples, polyMultiples, ← Submodule.span_image]
  congr 1
  ext g
  constructor
  · rintro ⟨n, rfl⟩
    exact ⟨((hardyMul diskShift) ^ n) f, ⟨n, rfl⟩, (hcomm n).symm⟩
  · rintro ⟨u, ⟨n, rfl⟩, rfl⟩
    exact ⟨n, hcomm n⟩

/-- **Statement 1 / equation (16), first half.**  An invertible bounded analytic function is a
cyclic vector for the shift on `H²(D)`. -/
theorem cyclicSubspace_hardyOf_eq_top {φ ψ : DiskMultiplier}
    (h : ∀ z ∈ Metric.ball (0:ℂ) 1, φ.fn z * ψ.fn z = 1) :
    cyclicSubspace (hardyOf φ) = ⊤ := by
  rw [cyclicSubspace, hardyOf, polyMultiples_map]
  exact topologicalClosure_map_eq_top (hardyMul_surjective h) cyclicSubspace_hardyOne

end GaloisForLFunctions.HTGeometry
