import Mathlib

/-!
# Pole-unit formation mechanics

This module certifies the algebraic core of
`pole-unit-scale-cocycle-correction-jet-reconstruction-and-divisor-memory-law.md`.

A nonvanishing regular unit produces an exact relative-scale cocycle.  A finite logarithmic
packet linearizes that cocycle, one nonresonant scale reconstructs every retained coefficient,
and a late divisor factor proves that no fixed finite jet can determine a divisor.
-/

open Finset Polynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Regular-unit response between a base scale and a relative scale. -/
def correctedScaleResponse (U : ℂ → ℂ) (ε w : ℂ) : ℂ :=
  U (ε * w) / U ε

/-- Pole-retaining response of order `r`. -/
def polarScaleResponse (r : ℕ) (U : ℂ → ℂ) (ε w : ℂ) : ℂ :=
  (w ^ r)⁻¹ * correctedScaleResponse U ε w

/-- **Exact formation conservation.**  Direct and iterated regular-unit formation agree. -/
theorem correctedScaleResponse_cocycle (U : ℂ → ℂ) (ε u v : ℂ)
    (hε : U ε ≠ 0) (hεu : U (ε * u) ≠ 0) :
    correctedScaleResponse U ε (u * v) =
      correctedScaleResponse U ε u * correctedScaleResponse U (ε * u) v := by
  unfold correctedScaleResponse
  field_simp

/-- The pole-retaining response obeys the same transported scale cocycle. -/
theorem polarScaleResponse_cocycle (r : ℕ) (U : ℂ → ℂ) (ε u v : ℂ)
    (hu : u ≠ 0) (hv : v ≠ 0) (hε : U ε ≠ 0) (hεu : U (ε * u) ≠ 0) :
    polarScaleResponse r U ε (u * v) =
      polarScaleResponse r U ε u * polarScaleResponse r U (ε * u) v := by
  rw [polarScaleResponse, polarScaleResponse, polarScaleResponse,
    correctedScaleResponse_cocycle U ε u v hε hεu]
  field_simp [hu, hv] <;> ring_nf

/-- Multiplying the pole response by the universal pole factor recovers the regular response. -/
theorem polar_corrected_split (r : ℕ) (U : ℂ → ℂ) (ε w : ℂ) (hw : w ≠ 0) :
    w ^ r * polarScaleResponse r U ε w = correctedScaleResponse U ε w := by
  simp [polarScaleResponse, hw]

/-- Regular response is invariant under every nonzero scalar gauge. -/
theorem correctedScaleResponse_smul (U : ℂ → ℂ) (a ε w : ℂ)
    (ha : a ≠ 0) (hε : U ε ≠ 0) :
    correctedScaleResponse (fun z => a * U z) ε w = correctedScaleResponse U ε w := by
  unfold correctedScaleResponse
  field_simp

/-- Pole response inherits scalar-gauge invariance from its regular factor. -/
theorem polarScaleResponse_smul (r : ℕ) (U : ℂ → ℂ) (a ε w : ℂ)
    (ha : a ≠ 0) (hε : U ε ≠ 0) :
    polarScaleResponse r (fun z => a * U z) ε w = polarScaleResponse r U ε w := by
  rw [polarScaleResponse, polarScaleResponse,
    correctedScaleResponse_smul U a ε w ha hε]

/-- Truncated logarithmic correction generated by coefficients `ell`. -/
def finiteCorrectionExponent (ell : ℕ → ℂ) (N : ℕ) (ε w : ℂ) : ℂ :=
  ∑ k ∈ Finset.range (N + 1), ell k * ε ^ k * (w ^ k - 1)

/-- **Additive ghost law.**  The logarithmic packet linearizes scale composition exactly. -/
theorem finiteCorrectionExponent_cocycle (ell : ℕ → ℂ) (N : ℕ) (ε u v : ℂ) :
    finiteCorrectionExponent ell N ε (u * v) =
      finiteCorrectionExponent ell N ε u +
        finiteCorrectionExponent ell N (ε * u) v := by
  unfold finiteCorrectionExponent
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  rw [mul_pow, mul_pow]
  ring

/-- Finite regular unit obtained by exponentiating a logarithmic coefficient packet. -/
def finiteLogUnit (ell : ℕ → ℂ) (N : ℕ) (z : ℂ) : ℂ :=
  Complex.exp (∑ k ∈ Finset.range (N + 1), ell k * z ^ k)

/-- The relative response of a finite logarithmic unit is the exponential correction packet. -/
theorem finiteLogUnit_response (ell : ℕ → ℂ) (N : ℕ) (ε w : ℂ) :
    correctedScaleResponse (finiteLogUnit ell N) ε w =
      Complex.exp (finiteCorrectionExponent ell N ε w) := by
  rw [correctedScaleResponse, finiteLogUnit, finiteLogUnit, ← Complex.exp_sub]
  congr 1
  unfold finiteCorrectionExponent
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  rw [mul_pow]
  ring

/-- Polynomial storing every coefficient visible in a finite correction packet. -/
def correctionJetPolynomial (ell : ℕ → ℂ) (N : ℕ) (w : ℂ) : Polynomial ℂ :=
  ∑ k ∈ Finset.range (N + 1),
    Polynomial.monomial k (ell k * (w ^ k - 1))

/-- Coefficient readout of the finite correction packet. -/
theorem correctionJetPolynomial_coeff (ell : ℕ → ℂ) (N k : ℕ) (w : ℂ) (hk : k ≤ N) :
    (correctionJetPolynomial ell N w).coeff k = ell k * (w ^ k - 1) := by
  classical
  rw [correctionJetPolynomial, Polynomial.coeff_sum]
  rw [Finset.sum_eq_single k]
  · simp
  · intro b hb hbk
    simp [Polynomial.coeff_monomial, Ne.symm hbk]
  · exact Finset.mem_range.mpr (Nat.lt_succ_iff.mpr hk)

/-- **One-scale reconstruction.**  Every nonresonant scale recovers each retained coefficient. -/
theorem correctionJetPolynomial_reconstruct (ell : ℕ → ℂ) (N k : ℕ) (w : ℂ)
    (hk : k ≤ N) (hscale : w ^ k - 1 ≠ 0) :
    ell k = (correctionJetPolynomial ell N w).coeff k / (w ^ k - 1) := by
  rw [correctionJetPolynomial_coeff ell N k w hk]
  exact (eq_div_iff hscale).2 rfl

/-- Equality of one nonresonant correction packet reconstructs all retained coefficients. -/
theorem correctionJetPolynomial_injective (ell eta : ℕ → ℂ) (N : ℕ) (w : ℂ)
    (hpacket : correctionJetPolynomial ell N w = correctionJetPolynomial eta N w)
    (hscale : ∀ k, k ≤ N → w ^ k - 1 ≠ 0) :
    ∀ k, k ≤ N → ell k = eta k := by
  intro k hk
  rw [correctionJetPolynomial_reconstruct ell N k w hk (hscale k hk),
    correctionJetPolynomial_reconstruct eta N k w hk (hscale k hk), hpacket]

/-- A factor invisible through order `N` but carrying a new zero at the marked point `a`. -/
def lateDivisorFactor (N : ℕ) (a : ℂ) : Polynomial ℂ :=
  1 - Polynomial.C ((a ^ (N + 1))⁻¹) * Polynomial.X ^ (N + 1)

/-- Every Taylor coefficient through order `N` agrees with the constant unit. -/
theorem lateDivisorFactor_coeff_eq_one (N k : ℕ) (a : ℂ) (hk : k ≤ N) :
    (lateDivisorFactor N a).coeff k = (1 : Polynomial ℂ).coeff k := by
  have hne : k ≠ N + 1 := by omega
  simp [lateDivisorFactor, hne]

/-- The late factor nevertheless vanishes at `a`; finite jets do not determine divisor data. -/
theorem lateDivisorFactor_eval_self (N : ℕ) (a : ℂ) (ha : a ≠ 0) :
    (lateDivisorFactor N a).eval a = 0 := by
  simp [lateDivisorFactor, ha]

/-- The constant unit and the late divisor factor have identical depth-`N` jets but distinct
zero behavior at every nonzero marked point. -/
theorem finiteCorrectionDepth_divisorBlind (N : ℕ) (a : ℂ) (ha : a ≠ 0) :
    (∀ k, k ≤ N →
      (lateDivisorFactor N a).coeff k = (1 : Polynomial ℂ).coeff k) ∧
      (lateDivisorFactor N a).eval a = 0 ∧ (1 : Polynomial ℂ).eval a ≠ 0 := by
  exact ⟨fun k hk => lateDivisorFactor_coeff_eq_one N k a hk,
    lateDivisorFactor_eval_self N a ha, by simp⟩

end

end GaloisForLFunctions.HTGeometry
