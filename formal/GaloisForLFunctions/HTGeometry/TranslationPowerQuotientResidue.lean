import GaloisForLFunctions.HTGeometry.ArbitraryFamilyPowerQuotientResidue
import GaloisForLFunctions.HTGeometry.TranslationPowerProfield

/-!
# Translation power quotients and their logarithmic residue

For a maximally translation-hypertranscendental meromorphic carrier `f`, the intersection of any
strictly descending divisibility tower generated by the translates of `f ^ N` is exactly the
differential field generated by the translates of `f′/f`.  The residual translate family remains
differentially independent.  The final two theorems identify this literal meromorphic formulation
with the existing entire-function `translationPowerProfield` interface.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

local instance quotientResidueEntireDomain : IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

local instance quotientResidueRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).toAlgebra

local instance quotientResidueMeroDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential (U := (Set.univ : Set ℂ)) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

local instance quotientResidueRatFuncDifferential : Differential (RatFunc ℂ) :=
  ratFuncCoordinateDifferential

local instance quotientResidueRatFuncDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  meroFieldRatFuncDifferentialAlgebra isOpen_univ isPreconnected_univ
    Set.univ_nonempty Set.infinite_univ

local instance quotientResidueMeroCharZero : CharZero (meroField (Set.univ : Set ℂ)) :=
  charZero_of_injective_algebraMap
    (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))).injective

/-- The analytic translation-power generator is the corresponding power of the first level. -/
theorem translationPowerGen_eq_pow
    (E : ℂ → ℂ) (hE : AnalyticOnNhd ℂ E Set.univ) (N : ℕ) (h : ℂ) :
    translationPowerGen E hE N h = (translationPowerGen E hE 1 h) ^ N := by
  rw [translationPowerGen, translationPowerGen,
    ← analyticMeroElement_pow (analyticOnNhd_translationPower hE 1 h) N]
  apply analyticMeroElement_congr
  funext z
  simp [translationPower]

/-- Translation commutes with meromorphic logarithmic differentiation. -/
theorem meroTranslation_logDeriv (h : ℂ)
    (f : meroField (Set.univ : Set ℂ)) :
    Differential.logDeriv (addTranslationMeroEquiv h f) =
      addTranslationMeroEquiv h (Differential.logDeriv f) := by
  rw [Differential.logDeriv, Differential.logDeriv, map_div₀,
    addTranslationMeroEquiv_deriv]

/-- Differential field generated by every translate of `f ^ N`. -/
def meromorphicTranslationPowerProfield
    (f : meroField (Set.univ : Set ℂ)) (N : ℕ) :
    IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  differentialAdjoin (RatFunc ℂ)
    (Set.range fun h : ℂ => addTranslationMeroEquiv h (f ^ N))

/-- Differential field generated by every translate of the logarithmic derivative `f′/f`. -/
def meromorphicTranslationLogResidue
    (f : meroField (Set.univ : Set ℂ)) :
    IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  differentialAdjoin (RatFunc ℂ)
    (Set.range fun h : ℂ =>
      addTranslationMeroEquiv h (Differential.logDeriv f))

/-- The exact intersection of a strict meromorphic translation-power tower is the field generated
by all translates of `f′/f`. -/
theorem meromorphicTranslationPowerProfield_iInter_eq_logResidue
    (f : meroField (Set.univ : Set ℂ))
    (hf : DifferentialIndependent (RatFunc ℂ)
      (fun h : ℂ => addTranslationMeroEquiv h f))
    (D : ℕ → ℕ) (hD0 : 2 ≤ D 0)
    (hdiv : ∀ n, D n ∣ D (n + 1)) (hlt : ∀ n, D n < D (n + 1)) :
    {z : meroField (Set.univ : Set ℂ) |
        ∀ n, z ∈ meromorphicTranslationPowerProfield f (D n)} =
      (meromorphicTranslationLogResidue f :
        Set (meroField (Set.univ : Set ℂ))) := by
  simpa only [meromorphicTranslationPowerProfield,
      meromorphicTranslationLogResidue, map_pow,
      meroTranslation_logDeriv] using
    (arbitraryFamily_strictDivisibility_iInter_eq_logDeriv_embedded_of_roots
      (F := RatFunc ℂ) (E := meroField (Set.univ : Set ℂ))
      ratFunc_containsAllRootsOfUnity
      (fun h : ℂ => addTranslationMeroEquiv h f) hf D hD0 hdiv hlt)

/-- Maximal translation hypertranscendence survives in the logarithmic residue. -/
theorem meromorphicTranslationLogResidue_differentialIndependent
    (f : meroField (Set.univ : Set ℂ))
    (hf : DifferentialIndependent (RatFunc ℂ)
      (fun h : ℂ => addTranslationMeroEquiv h f)) :
    DifferentialIndependent (RatFunc ℂ)
      (fun h : ℂ =>
        addTranslationMeroEquiv h (Differential.logDeriv f)) := by
  simpa only [meroTranslation_logDeriv] using
    (arbitraryFamily_logDeriv_differentialIndependent
      (F := RatFunc ℂ) (E := meroField (Set.univ : Set ℂ))
      (fun h : ℂ => addTranslationMeroEquiv h f) hf)

/-- Logarithmic residue of the existing entire translation-power interface. -/
def translationLogResidue (E : ℂ → ℂ)
    (hE : AnalyticOnNhd ℂ E Set.univ) :
    IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  differentialAdjoin (RatFunc ℂ)
    (Set.range fun h : ℂ =>
      Differential.logDeriv (translationPowerGen E hE 1 h))

/-- Exact logarithmic residue for the existing entire-function `translationPowerProfield`. -/
theorem translationPowerProfield_iInter_eq_logResidue
    (E : ℂ → ℂ) (hE : AnalyticOnNhd ℂ E Set.univ)
    (hfree : DifferentialIndependent (RatFunc ℂ)
      (translationPowerGen E hE 1))
    (D : ℕ → ℕ) (hD0 : 2 ≤ D 0)
    (hdiv : ∀ n, D n ∣ D (n + 1)) (hlt : ∀ n, D n < D (n + 1)) :
    {z : meroField (Set.univ : Set ℂ) |
        ∀ n, z ∈ translationPowerProfield E hE (D n)} =
      (translationLogResidue E hE :
        Set (meroField (Set.univ : Set ℂ))) := by
  have hlevel : ∀ n,
      translationPowerProfield E hE (D n) =
        differentialAdjoin (RatFunc ℂ)
          (Set.range fun h : ℂ => (translationPowerGen E hE 1 h) ^ D n) := by
    intro n
    unfold translationPowerProfield
    congr 1
    ext y
    constructor
    · rintro ⟨h, rfl⟩
      exact ⟨h, (translationPowerGen_eq_pow E hE (D n) h).symm⟩
    · rintro ⟨h, rfl⟩
      exact ⟨h, translationPowerGen_eq_pow E hE (D n) h⟩
  have hgeneric :=
    arbitraryFamily_strictDivisibility_iInter_eq_logDeriv_embedded_of_roots
      (F := RatFunc ℂ) (E := meroField (Set.univ : Set ℂ))
      ratFunc_containsAllRootsOfUnity
      (translationPowerGen E hE 1) hfree D hD0 hdiv hlt
  rw [Set.ext_iff]
  intro z
  change (∀ n, z ∈ translationPowerProfield E hE (D n)) ↔
    z ∈ translationLogResidue E hE
  rw [show (∀ n, z ∈ translationPowerProfield E hE (D n)) ↔
      ∀ n, z ∈ differentialAdjoin (RatFunc ℂ)
        (Set.range fun h : ℂ => (translationPowerGen E hE 1 h) ^ D n) by
    apply forall_congr'
    intro n
    rw [hlevel n]]
  exact Set.ext_iff.mp hgeneric z

/-- The entire logarithmic-residue translate family remains differentially independent. -/
theorem translationLogResidue_differentialIndependent
    (E : ℂ → ℂ) (hE : AnalyticOnNhd ℂ E Set.univ)
    (hfree : DifferentialIndependent (RatFunc ℂ)
      (translationPowerGen E hE 1)) :
    DifferentialIndependent (RatFunc ℂ)
      (fun h : ℂ =>
        Differential.logDeriv (translationPowerGen E hE 1 h)) :=
  arbitraryFamily_logDeriv_differentialIndependent
    (translationPowerGen E hE 1) hfree

end

end GaloisForLFunctions.HTGeometry
