import GaloisForLFunctions.HTGeometry.TwoLocalUniversalPolynomialFamily
import GaloisForLFunctions.HTGeometry.BooleanHypercubeTranspositionLaw
import Mathlib.Data.Fin.Tuple.Basic
import Mathlib.Tactic

/-!
# One all-qubit polynomial family carrying exact edge monodromy

This file removes the distinguished-coordinate restriction from the
ambient family.  It defines the polynomial matrix family generated by:

* one constant term;
* arbitrary diagonal onsite terms;
* arbitrary diagonal pair interactions;
* one transverse flip coefficient per Boolean coordinate.

The exact selected-star loop embeds in this one family.  Under the natural
`Bool × environment` equivalence, its endpoint permutation is a literal
edge transposition of the full Boolean hypercube.  Any two such
coordinate-zero edge basepoints are joined through the simple-spectrum
locus of the same all-qubit polynomial family.
-/

open scoped BigOperators

open Topology unitInterval

namespace GaloisForLFunctions.HTGeometry

/-- Coefficients of an all-qubit diagonal-pair-plus-transverse two-local
Hamiltonian.  Ordered pair coordinates are intentionally redundant; this
keeps coordinate relabeling algebraic and exact. -/
inductive HypercubeTwoLocalParameter (n : ℕ)
  | constant
  | onsite (i : Fin n)
  | interaction (i j : Fin n)
  | transverse (i : Fin n)
  deriving DecidableEq, Fintype

/-- Evaluated all-qubit two-local Hamiltonian.  Off-diagonal matrix
elements connect only vertices differing in one Boolean coordinate. -/
def hypercubeTwoLocalHamiltonian {n : ℕ}
    (constant : ℂ) (onsite : Fin n → ℂ)
    (interaction : Fin n → Fin n → ℂ)
    (transverse : Fin n → ℂ) :
    Matrix (Fin n → Bool) (Fin n → Bool) ℂ :=
  fun x y =>
    if x = y then
      constant +
        ∑ i, onsite i * (boolOccupation (x i) : ℂ) +
        ∑ i, ∑ j, interaction i j *
          (boolOccupation (x i) : ℂ) *
          (boolOccupation (x j) : ℂ)
    else
      ∑ i, if y = boolToggle x i then transverse i else 0

/-- Universal polynomial all-qubit two-local matrix family. -/
noncomputable def universalHypercubeTwoLocalPolynomialMatrix (n : ℕ) :
    Matrix (Fin n → Bool) (Fin n → Bool)
      (MvPolynomial (HypercubeTwoLocalParameter n) ℂ) :=
  fun x y =>
    if x = y then
      MvPolynomial.X .constant +
        ∑ i, MvPolynomial.X (.onsite i) *
          MvPolynomial.C (boolOccupation (x i) : ℂ) +
        ∑ i, ∑ j, MvPolynomial.X (.interaction i j) *
          MvPolynomial.C (boolOccupation (x i) : ℂ) *
          MvPolynomial.C (boolOccupation (x j) : ℂ)
    else
      ∑ i, if y = boolToggle x i then
        MvPolynomial.X (.transverse i) else 0

theorem eval_universalHypercubeTwoLocalPolynomialMatrix
    (n : ℕ) (p : HypercubeTwoLocalParameter n → ℂ) :
    (universalHypercubeTwoLocalPolynomialMatrix n).map
        (MvPolynomial.eval₂Hom (RingHom.id ℂ) p) =
      hypercubeTwoLocalHamiltonian
        (p .constant) (fun i => p (.onsite i))
        (fun i j => p (.interaction i j))
        (fun i => p (.transverse i)) := by
  ext x y
  simp only [Matrix.map_apply,
    universalHypercubeTwoLocalPolynomialMatrix,
    hypercubeTwoLocalHamiltonian]
  split_ifs
  · simp
  · rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _hi
    split_ifs <;> simp

/-! ## Embedding the selected-star family -/

/-- Natural equivalence between one distinguished Boolean coordinate plus
its environment and the full Boolean cube. -/
def boolEnvironmentEquiv (m : ℕ) :
    (Bool × (Fin m → Bool)) ≃ (Fin (m + 1) → Bool) :=
  Fin.consEquiv (fun _ : Fin (m + 1) => Bool)

theorem boolEnvironmentEquiv_apply {m : ℕ}
    (b : Bool) (z : Fin m → Bool) :
    boolEnvironmentEquiv m (b, z) = Fin.cons b z :=
  rfl

def embeddedStarOnsite {m : ℕ}
    (longitudinal : ℂ) (onsite : Fin m → ℂ) :
    Fin (m + 1) → ℂ :=
  Fin.cases longitudinal onsite

def embeddedStarInteraction {m : ℕ}
    (interaction : Fin m → ℂ) :
    Fin (m + 1) → Fin (m + 1) → ℂ :=
  Fin.cases (Fin.cases 0 interaction) (fun _ _ => 0)

def embeddedStarTransverse {m : ℕ}
    (transverse : ℂ) : Fin (m + 1) → ℂ :=
  Fin.cases transverse (fun _ => 0)

theorem boolToggle_finCons_zero {m : ℕ}
    (b : Bool) (z : Fin m → Bool) :
    boolToggle (Fin.cons b z) 0 = Fin.cons (!b) z := by
  funext j
  refine Fin.cases ?_ (fun i => ?_) j
  · simp [boolToggle]
  · simp [boolToggle]

/-- Reindexing the corresponding all-qubit coefficient model gives
exactly the distinguished-star coefficient model. -/
theorem reindex_hypercubeTwoLocalHamiltonian_eq_distinguishedStar
    {m : ℕ}
    (constant longitudinal transverse : ℂ)
    (onsite interaction : Fin m → ℂ) :
    Matrix.reindex (boolEnvironmentEquiv m).symm
        (boolEnvironmentEquiv m).symm
        (hypercubeTwoLocalHamiltonian constant
          (embeddedStarOnsite longitudinal onsite)
          (embeddedStarInteraction interaction)
          (embeddedStarTransverse transverse)) =
      distinguishedStarTwoLocalHamiltonian
        constant longitudinal transverse onsite interaction := by
  ext ⟨b, z⟩ ⟨d, y⟩
  change
    hypercubeTwoLocalHamiltonian constant
        (embeddedStarOnsite longitudinal onsite)
        (embeddedStarInteraction interaction)
        (embeddedStarTransverse transverse)
        (Fin.cons b z) (Fin.cons d y) =
      distinguishedStarTwoLocalHamiltonian
        constant longitudinal transverse onsite interaction
        (b, z) (d, y)
  simp only [hypercubeTwoLocalHamiltonian,
    distinguishedStarTwoLocalHamiltonian]
  by_cases hpair : (b, z) = (d, y)
  · have hbd : b = d := congrArg Prod.fst hpair
    have hzy : z = y := congrArg Prod.snd hpair
    subst d
    subst y
    simp only [if_pos]
    simp [embeddedStarOnsite, embeddedStarInteraction,
      Fin.sum_univ_succ]
    ring
  · have hcons :
        (Fin.cons b z : Fin (m + 1) → Bool) ≠
          (Fin.cons d y : Fin (m + 1) → Bool) := by
      exact fun h => hpair ((boolEnvironmentEquiv m).injective h)
    rw [if_neg hcons, if_neg hpair]
    by_cases henv : z = y
    · have hbit : b ≠ d := by
        intro hbd
        exact hpair (Prod.ext hbd henv)
      subst y
      simp only
      rw [Fin.sum_univ_succ]
      simp [embeddedStarTransverse, boolToggle_finCons_zero]
      intro hdb
      exact (hbit hdb.symm).elim
    · simp only [henv]
      rw [Fin.sum_univ_succ]
      simp [embeddedStarTransverse, boolToggle_finCons_zero]
      intro _hdb hyz
      exact (henv hyz.symm).elim

/-- Every distinguished-star two-local Hamiltonian is an evaluation of the
one all-qubit polynomial family after the natural basis reindexing. -/
theorem exists_hypercubeTwoLocal_coordinates_of_distinguishedStar
    {m : ℕ}
    (H : Matrix (Bool × (Fin m → Bool))
      (Bool × (Fin m → Bool)) ℂ)
    (hH : IsComplexDistinguishedStarTwoLocalHamiltonian H) :
    ∃ p : HypercubeTwoLocalParameter (m + 1) → ℂ,
      (universalHypercubeTwoLocalPolynomialMatrix (m + 1)).map
          (MvPolynomial.eval₂Hom (RingHom.id ℂ) p) =
        Matrix.reindex (boolEnvironmentEquiv m)
          (boolEnvironmentEquiv m) H := by
  rcases hH with
    ⟨constant, longitudinal, transverse, onsite,
      interaction, rfl⟩
  let p : HypercubeTwoLocalParameter (m + 1) → ℂ
    | .constant => constant
    | .onsite i => embeddedStarOnsite longitudinal onsite i
    | .interaction i j => embeddedStarInteraction interaction i j
    | .transverse i => embeddedStarTransverse transverse i
  refine ⟨p, ?_⟩
  rw [eval_universalHypercubeTwoLocalPolynomialMatrix]
  change
    hypercubeTwoLocalHamiltonian constant
        (embeddedStarOnsite longitudinal onsite)
        (embeddedStarInteraction interaction)
        (embeddedStarTransverse transverse) =
      (Matrix.reindex (boolEnvironmentEquiv m).symm
        (boolEnvironmentEquiv m).symm).symm
        (distinguishedStarTwoLocalHamiltonian
          constant longitudinal transverse onsite interaction)
  apply
    (Equiv.eq_symm_apply
      (Matrix.reindex (boolEnvironmentEquiv m).symm
        (boolEnvironmentEquiv m).symm)).2
  exact
    reindex_hypercubeTwoLocalHamiltonian_eq_distinguishedStar
      constant longitudinal transverse onsite interaction

/-! ## Full-cube roots and edge permutation -/

noncomputable def twoLocalCubeEigenvalueLift {m : ℕ}
    (z₀ : Fin m → Bool) (x : Fin (m + 1) → Bool)
    (s : I) : ℂ :=
  twoLocalGlobalEigenvalueLift z₀
    ((boolEnvironmentEquiv m).symm x) s

theorem twoLocalCubeEigenvalueLift_root {m : ℕ}
    (z₀ : Fin m → Bool) (x : Fin (m + 1) → Bool)
    (s : I) :
    (Matrix.reindex (boolEnvironmentEquiv m)
      (boolEnvironmentEquiv m)
      (twoLocalStarHamiltonianMatrix z₀
        (twoLocalSelectedEdgeParameter s))).charpoly.eval
      (twoLocalCubeEigenvalueLift z₀ x s) = 0 := by
  rw [Matrix.charpoly_reindex]
  exact
    twoLocalGlobalEigenvalueLift_fullMatrix_root z₀
      ((boolEnvironmentEquiv m).symm x) s

theorem twoLocalCubeEigenvalueLift_injective {m : ℕ}
    (z₀ : Fin m → Bool) (s : I) :
    Function.Injective fun x =>
      twoLocalCubeEigenvalueLift z₀ x s := by
  intro x y h
  apply (boolEnvironmentEquiv m).symm.injective
  exact twoLocalGlobalEigenvalueLift_injective z₀ s h

theorem twoLocalSelectedEdgeSwap_eq_swap {m : ℕ}
    (z₀ : Fin m → Bool) :
    twoLocalSelectedEdgeSwap z₀ =
      Equiv.swap (false, z₀) (true, z₀) := by
  apply Equiv.ext
  rintro ⟨b, z⟩
  by_cases hz : z = z₀
  · subst z
    cases b <;>
      simp [twoLocalSelectedEdgeSwap, Equiv.swap_apply_def]
  · cases b <;>
      simp [twoLocalSelectedEdgeSwap, Equiv.swap_apply_def, hz]

def twoLocalCubeSelectedEdgeSwap {m : ℕ}
    (z₀ : Fin m → Bool) :
    Equiv.Perm (Fin (m + 1) → Bool) :=
  (boolEnvironmentEquiv m).symm.trans
    ((twoLocalSelectedEdgeSwap z₀).trans
      (boolEnvironmentEquiv m))

theorem twoLocalCubeSelectedEdgeSwap_eq_swap {m : ℕ}
    (z₀ : Fin m → Bool) :
    twoLocalCubeSelectedEdgeSwap z₀ =
      Equiv.swap (Fin.cons false z₀) (Fin.cons true z₀) := by
  rw [twoLocalCubeSelectedEdgeSwap,
    twoLocalSelectedEdgeSwap_eq_swap]
  exact Equiv.symm_trans_swap_trans _ _
    (boolEnvironmentEquiv m)

theorem twoLocalCubeEigenvalueLift_endpoint {m : ℕ}
    (z₀ : Fin m → Bool) (x : Fin (m + 1) → Bool) :
    twoLocalCubeEigenvalueLift z₀ x 1 =
      twoLocalCubeEigenvalueLift z₀
        (twoLocalCubeSelectedEdgeSwap z₀ x) 0 := by
  rw [twoLocalCubeEigenvalueLift,
    twoLocalGlobalEigenvalueLift_endpoint_permutation]
  rfl

theorem twoLocalCubeSelectedEdgeSwap_mem_hypercubeEdgeSwaps
    {m : ℕ} (z₀ : Fin m → Bool) :
    twoLocalCubeSelectedEdgeSwap z₀ ∈
      hypercubeEdgeSwaps (m + 1) := by
  rw [twoLocalCubeSelectedEdgeSwap_eq_swap]
  refine ⟨Fin.cons false z₀, 0, ?_⟩
  rw [boolToggle_finCons_zero]
  rfl

/-! ## Common-base transport in the all-qubit family -/

theorem exists_twoLocalSelectedEdge_hypercubeCoordinates {m : ℕ}
    (z₀ : Fin m → Bool) (w : ℂ) :
    ∃ p : HypercubeTwoLocalParameter (m + 1) → ℂ,
      (universalHypercubeTwoLocalPolynomialMatrix (m + 1)).map
          (MvPolynomial.eval₂Hom (RingHom.id ℂ) p) =
        Matrix.reindex (boolEnvironmentEquiv m)
          (boolEnvironmentEquiv m)
          (twoLocalStarHamiltonianMatrix z₀ w) :=
  exists_hypercubeTwoLocal_coordinates_of_distinguishedStar _
    (twoLocalStarHamiltonian_is_complex_twoLocal z₀ w)

/-- Any two coordinate-zero hypercube-edge loop basepoints belong to the
same component of the simple-spectrum locus of one all-qubit two-local
polynomial family. -/
theorem exists_twoLocalHypercubeEdges_commonBaseTransport {m : ℕ}
    (z₀ z₁ : Fin m → Bool) :
    ∃ (p₀ p₁ : HypercubeTwoLocalParameter (m + 1) → ℂ),
      (universalHypercubeTwoLocalPolynomialMatrix (m + 1)).map
          (MvPolynomial.eval₂Hom (RingHom.id ℂ) p₀) =
        Matrix.reindex (boolEnvironmentEquiv m)
          (boolEnvironmentEquiv m)
          (twoLocalStarHamiltonianMatrix z₀
            (twoLocalSelectedEdgeParameter 0)) ∧
      (universalHypercubeTwoLocalPolynomialMatrix (m + 1)).map
          (MvPolynomial.eval₂Hom (RingHom.id ℂ) p₁) =
        Matrix.reindex (boolEnvironmentEquiv m)
          (boolEnvironmentEquiv m)
          (twoLocalStarHamiltonianMatrix z₁
            (twoLocalSelectedEdgeParameter 0)) ∧
      ∃ path : Path p₀ p₁,
        ∀ s : I,
          MvPolynomial.eval (path s)
            (matrixCharacteristicResultantPolynomial
              (universalHypercubeTwoLocalPolynomialMatrix
                (m + 1))) ≠ 0 := by
  obtain ⟨p₀, hp₀⟩ :=
    exists_twoLocalSelectedEdge_hypercubeCoordinates z₀
      (twoLocalSelectedEdgeParameter 0)
  obtain ⟨p₁, hp₁⟩ :=
    exists_twoLocalSelectedEdge_hypercubeCoordinates z₁
      (twoLocalSelectedEdgeParameter 0)
  refine ⟨p₀, p₁, hp₀, hp₁, ?_⟩
  apply exists_parameterPath_of_complete_injective_rootPackets
    (universalHypercubeTwoLocalPolynomialMatrix (m + 1)) p₀ p₁
    (fun x => twoLocalCubeEigenvalueLift z₀ x 0)
    (fun x => twoLocalCubeEigenvalueLift z₁ x 0)
    (twoLocalCubeEigenvalueLift_injective z₀ 0)
    (twoLocalCubeEigenvalueLift_injective z₁ 0)
  · intro x
    rw [hp₀]
    exact twoLocalCubeEigenvalueLift_root z₀ x 0
  · intro x
    rw [hp₁]
    exact twoLocalCubeEigenvalueLift_root z₁ x 0

end GaloisForLFunctions.HTGeometry
