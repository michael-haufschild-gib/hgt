import GaloisForLFunctions.HTGeometry.AlgebraicMatroidRank
import GaloisForLFunctions.HTGeometry.DifferentialIndependentObservableNet
import GaloisForLFunctions.HTGeometry.MatroidNatRank
import GaloisForLFunctions.HTGeometry.MatrixWignerSmithDifferentialMatroid
import Mathlib.Analysis.SpecificLimits.Basic

/-!
# Finite-jet Wigner--Smith rank conservation

For `Q = -ι S⁻¹S'`, the order-`r` jets of `Q` lie in the order-`r+1` jet field
of `S`.  Conversely, the order-`r+1` jets of `S` lie in the compositum of the
order-`r` jet field of `Q` and the order-zero field of `S`.  The corresponding
ordinary algebraic-matroid ranks therefore differ by at most the `(n+1)^2`
initial matrix entries, and every convergent normalized Kolchin growth slope is
preserved.
-/

open scoped Differential IntermediateField.algebraAdjoinAdjoin

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Set
open GaloisForLFunctions.MatroidGluing

noncomputable section

universe u

/-- The finite packet of all matrix-entry jets through order `r`. -/
noncomputable def matrixFiniteJetPacket
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) : Finset E := by
  classical
  exact (Finset.univ ×ˢ Finset.range (r + 1)).image
    (fun p : (Fin (n + 1) × Fin (n + 1)) × ℕ =>
      differentialJet p.2 (S p.1.1 p.1.2))

/-- Membership in a finite matrix-jet packet is literal membership in one entry and one
derivative order at most `r`. -/
theorem mem_matrixFiniteJetPacket_iff
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) (z : E) :
    z ∈ matrixFiniteJetPacket S r ↔
      ∃ p : Fin (n + 1) × Fin (n + 1), ∃ k ≤ r,
        differentialJet k (S p.1 p.2) = z := by
  classical
  simp [matrixFiniteJetPacket]

/-- The exact order-`r` matrix-jet layer. -/
noncomputable def matrixJetLayerPacket
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) : Finset E := by
  classical
  exact Finset.univ.image (fun p : Fin (n + 1) × Fin (n + 1) =>
    differentialJet r (S p.1 p.2))

/-- Membership in an exact matrix-jet layer. -/
theorem mem_matrixJetLayerPacket_iff
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) (z : E) :
    z ∈ matrixJetLayerPacket S r ↔
      ∃ p : Fin (n + 1) × Fin (n + 1),
        differentialJet r (S p.1 p.2) = z := by
  classical
  simp [matrixJetLayerPacket]

/-- The order-`r` ordinary field generated by all matrix-entry jets through order `r`. -/
noncomputable def matrixFiniteJetField
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) :
    IntermediateField F E :=
  differentialFamilyObservableField F (fun p : Fin (n + 1) × Fin (n + 1) =>
    S p.1 p.2) (fun _ => r + 1)

/-- The finite packet is exactly the generator set used by the finite observable field. -/
theorem coe_matrixFiniteJetPacket
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) :
    (↑(matrixFiniteJetPacket S r) : Set E) =
      (fun p : (Fin (n + 1) × Fin (n + 1)) × ℕ =>
        differentialJet p.2 (S p.1.1 p.1.2)) ''
        differentialFamilyVisibleJetIndices
          (fun _ : Fin (n + 1) × Fin (n + 1) => r + 1) := by
  classical
  ext z
  constructor
  · intro hz
    rw [Finset.mem_coe, matrixFiniteJetPacket, Finset.mem_image] at hz
    obtain ⟨p, hp, rfl⟩ := hz
    simp only [Finset.mem_product, Finset.mem_univ, true_and, Finset.mem_range] at hp
    exact ⟨p, by simpa [differentialFamilyVisibleJetIndices] using hp, rfl⟩
  · rintro ⟨p, hp, rfl⟩
    change p.2 < r + 1 at hp
    rw [Finset.mem_coe, matrixFiniteJetPacket, Finset.mem_image]
    exact ⟨p, by simp [hp], rfl⟩

/-- The observable-field presentation agrees with ordinary intermediate-field adjunction of the
finite jet packet. -/
theorem matrixFiniteJetField_eq_adjoin_packet
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) :
    matrixFiniteJetField F S r =
      IntermediateField.adjoin F (↑(matrixFiniteJetPacket S r) : Set E) := by
  unfold matrixFiniteJetField differentialFamilyObservableField
  rw [coe_matrixFiniteJetPacket]

/-- Enlarging the jet order enlarges the finite jet field. -/
theorem matrixFiniteJetField_mono
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    {r s : ℕ} (hrs : r ≤ s) :
    matrixFiniteJetField F S r ≤ matrixFiniteJetField F S s := by
  unfold matrixFiniteJetField
  apply differentialFamilyObservableField_mono
  exact fun _ => Nat.add_le_add_right hrs 1

/-- Differentiation raises finite matrix-jet resolution by at most one. -/
theorem matrixFiniteJetField_deriv_mem_succ
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    {r : ℕ} {z : E} (hz : z ∈ matrixFiniteJetField F S r) :
    z′ ∈ matrixFiniteJetField F S (r + 1) := by
  exact differentialFamilyObservableField_deriv_mem_succ
    (fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2)
    (fun _ => r + 1) hz

/-- Applying `k` derivatives raises finite matrix-jet resolution by at most `k`. -/
theorem differentialJet_mem_matrixFiniteJetField_add
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    {r : ℕ} {z : E} (hz : z ∈ matrixFiniteJetField F S r) (k : ℕ) :
    differentialJet k z ∈ matrixFiniteJetField F S (r + k) := by
  induction k with
  | zero => simpa using hz
  | succ k ih =>
      rw [differentialJet_succ]
      simpa [Nat.add_assoc] using matrixFiniteJetField_deriv_mem_succ S ih

/-- Every order-zero matrix entry belongs to every nonnegative finite jet field. -/
theorem matrix_entry_mem_matrixFiniteJetField
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (r : ℕ) (a b : Fin (n + 1)) :
    S a b ∈ matrixFiniteJetField F S r := by
  apply IntermediateField.subset_adjoin F
  exact ⟨((a, b), 0), by simp [differentialFamilyVisibleJetIndices], by simp⟩

/-- Matrix inversion is already rational in the order-zero matrix-entry field. -/
theorem matrix_inv_entry_mem_matrixFiniteJetField
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (r : ℕ) (i j : Fin (n + 1)) :
    S⁻¹ i j ∈ matrixFiniteJetField F S r := by
  let B := matrixFiniteJetField F S r
  let SB : Matrix (Fin (n + 1)) (Fin (n + 1)) B := fun a b =>
    ⟨S a b, matrix_entry_mem_matrixFiniteJetField S r a b⟩
  have hSB : SB.map (algebraMap B E) = S := by
    ext a b
    rfl
  have hmapInv : SB⁻¹.map (algebraMap B E) = S⁻¹ := by
    rw [← hSB]
    ext a b
    simp only [Matrix.inv_def, Matrix.map_apply]
    have hdet := (algebraMap B E).map_det SB
    have hadj := congrArg (fun M => M a b) ((algebraMap B E).map_adjugate SB)
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply] at hdet hadj
    rw [← hdet]
    simp only [Ring.inverse_eq_inv]
    change algebraMap B E ((SB.det)⁻¹ * SB.adjugate a b) =
      (algebraMap B E SB.det)⁻¹ * (SB.map (algebraMap B E)).adjugate a b
    rw [map_mul, map_inv₀, hadj]
  change S⁻¹ i j ∈ B
  have hb : ((SB⁻¹ i j : B) : E) ∈ B := (SB⁻¹ i j).property
  have h := congrArg (fun M => M i j) hmapInv
  simp only [Matrix.map_apply] at h
  have h' : ((SB⁻¹ i j : B) : E) = S⁻¹ i j := by simpa using h
  rwa [h'] at hb

/-- Every Wigner--Smith entry is visible from the first jets of `S`. -/
theorem matrixWignerSmith_entry_mem_matrixFiniteJetField_one
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (a b : Fin (n + 1)) :
    matrixWignerSmith ι S a b ∈ matrixFiniteJetField F S 1 := by
  let B := matrixFiniteJetField F S 1
  have hInv : ∀ k, S⁻¹ a k ∈ B := fun k =>
    matrix_inv_entry_mem_matrixFiniteJetField S 1 a k
  have hDeriv : ∀ k, (S k b)′ ∈ B := by
    intro k
    have hjet := IntermediateField.subset_adjoin F
      (S := (fun p : (Fin (n + 1) × Fin (n + 1)) × ℕ =>
        differentialJet p.2 (S p.1.1 p.1.2)) ''
        differentialFamilyVisibleJetIndices
          (fun _ : Fin (n + 1) × Fin (n + 1) => 1 + 1))
      ⟨((k, b), 1), by simp [differentialFamilyVisibleJetIndices], rfl⟩
    simpa [differentialJet] using! hjet
  rw [matrixWignerSmith]
  apply B.mul_mem (B.neg_mem (B.algebraMap_mem ι))
  simpa [Matrix.mul_apply, matrixDifferential] using
    (B.sum_mem fun k _ => B.mul_mem (hInv k) (hDeriv k))

/-- The `k`th jet of a Wigner--Smith entry is visible from the `(k+1)`st jets of `S`. -/
theorem matrixWignerSmith_differentialJet_mem_matrixFiniteJetField
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (a b : Fin (n + 1)) (k : ℕ) :
    differentialJet k (matrixWignerSmith ι S a b) ∈
      matrixFiniteJetField F S (k + 1) := by
  simpa [Nat.add_comm] using differentialJet_mem_matrixFiniteJetField_add S
    (matrixWignerSmith_entry_mem_matrixFiniteJetField_one ι S a b) k

/-- **Forward finite-jet containment.**  Jets of `Q` through order `r` lie in the field of jets
of `S` through order `r+1`. -/
theorem matrixWignerSmith_finiteJetField_le
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (r : ℕ) :
    matrixFiniteJetField F (matrixWignerSmith ι S) r ≤
      matrixFiniteJetField F S (r + 1) := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro y ⟨p, hp, rfl⟩
  change p.2 < r + 1 at hp
  apply matrixFiniteJetField_mono S (Nat.succ_le_succ (Nat.le_of_lt_succ hp))
  exact matrixWignerSmith_differentialJet_mem_matrixFiniteJetField
    ι S p.1.1 p.1.2 p.2

/-- Natural algebraic-matroid rank of a finite packet. -/
noncomputable def finiteAlgebraicMatroidRank
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E]
    (packet : Finset E) : ℕ := by
  classical
  exact (transcendenceRank F E).ρ packet

/-- Membership in the ordinary intermediate field generated by a finite base packet cannot raise
algebraic-matroid rank. -/
theorem finiteAlgebraicMatroidRank_le_of_mem_intermediateAdjoin
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (base signal : Finset E)
    (hmem : ∀ x ∈ signal,
      x ∈ IntermediateField.adjoin F (↑base : Set E)) :
    finiteAlgebraicMatroidRank F signal ≤
      finiteAlgebraicMatroidRank F base := by
  classical
  let M := AlgebraicIndependent.matroid F E
  have hsignal : (↑signal : Set E) ⊆ M.closure (↑base : Set E) := by
    intro x hx
    rw [AlgebraicIndependent.matroid_closure_eq, SetLike.mem_coe,
      Subalgebra.mem_algebraicClosure]
    let B := IntermediateField.adjoin F (↑base : Set E)
    let xb : B := ⟨x, hmem x (by exact_mod_cast hx)⟩
    have hxb : IsAlgebraic (Algebra.adjoin F (↑base : Set E)) xb :=
      Algebra.IsAlgebraic.isAlgebraic xb
    have hmap := hxb.algHom
      (IsScalarTower.toAlgHom (Algebra.adjoin F (↑base : Set E)) B E)
    simpa [B, xb] using hmap
  have hle : M.eRk (↑signal : Set E) ≤ M.eRk (↑base : Set E) := by
    calc
      M.eRk (↑signal : Set E) ≤ M.eRk (M.closure (↑base : Set E)) :=
        M.eRk_mono hsignal
      _ = M.eRk (↑base : Set E) := M.eRk_closure_eq _
  unfold finiteAlgebraicMatroidRank
  change (M.eRk (↑signal : Set E)).toNat ≤
    (M.eRk (↑base : Set E)).toNat
  exact ENat.toNat_le_toNat hle
    (GaloisForLFunctions.MatroidGluing.matroid_eRk_ne_top M base)

/-- Ordinary finite-jet transcendence rank of a square matrix. -/
noncomputable def matrixFiniteJetRank
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) : ℕ :=
  finiteAlgebraicMatroidRank F (matrixFiniteJetPacket S r)

/-- Forward finite-jet rank inequality for the Wigner--Smith transform. -/
theorem matrixWignerSmith_finiteJetRank_le
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (r : ℕ) :
    matrixFiniteJetRank F (matrixWignerSmith ι S) r ≤
      matrixFiniteJetRank F S (r + 1) := by
  unfold matrixFiniteJetRank
  apply finiteAlgebraicMatroidRank_le_of_mem_intermediateAdjoin
  intro x hx
  rw [← matrixFiniteJetField_eq_adjoin_packet S (r + 1)]
  apply matrixWignerSmith_finiteJetField_le ι S r
  rw [matrixFiniteJetField_eq_adjoin_packet]
  exact IntermediateField.subset_adjoin F
    (S := (↑(matrixFiniteJetPacket (matrixWignerSmith ι S) r) : Set E))
    (by exact_mod_cast hx)

/-- Coefficient matrix of the row system `S' = ι S Q`. -/
def matrixWignerSmithSystemMatrix
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    {n : ℕ} (ι : F)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    Fin (n + 1) → Fin (n + 1) → E :=
  fun j k => algebraMap F E ι * Q k j

/-- The coefficient expressing the `(r+1)`st jet of a solution of `S'=ιSQ` uses only jets of
`Q` through order `r`. -/
theorem finiteLinearSystemJetCoefficients_matrixWignerSmithSystemMatrix_succ_mem
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F)
    (Q : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    ∀ r i j,
      finiteLinearSystemJetCoefficients
          (matrixWignerSmithSystemMatrix ι Q) (r + 1) i j ∈
        matrixFiniteJetField F Q r := by
  intro r
  induction r with
  | zero =>
      intro i j
      rw [finiteLinearSystemJetCoefficients]
      let B := matrixFiniteJetField F Q 0
      apply B.add_mem
      · by_cases h : i = j <;> simp [finiteLinearSystemJetCoefficients, h]
      · apply B.sum_mem
        intro k hk
        by_cases h : i = k
        · subst k
          simp only [finiteLinearSystemJetCoefficients, if_pos, one_mul]
          exact B.mul_mem (B.algebraMap_mem ι)
            (matrix_entry_mem_matrixFiniteJetField Q 0 j i)
        · simp [finiteLinearSystemJetCoefficients, h]
  | succ r ih =>
      intro i j
      rw [finiteLinearSystemJetCoefficients]
      let B := matrixFiniteJetField F Q (r + 1)
      apply B.add_mem
      · exact matrixFiniteJetField_deriv_mem_succ Q (ih i j)
      · apply B.sum_mem
        intro k hk
        apply B.mul_mem
        · exact matrixFiniteJetField_mono Q (Nat.le_succ r) (ih i k)
        · exact B.mul_mem (B.algebraMap_mem ι)
            (matrix_entry_mem_matrixFiniteJetField Q (r + 1) j k)

/-- Every positive-order jet of `S` belongs to the corresponding lower-order `Q` jet field after
adjoining only the order-zero entries of `S`. -/
theorem matrixWignerSmith_scattering_differentialJet_succ_mem
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0)
    (r : ℕ) (a b : Fin (n + 1)) :
    differentialJet (r + 1) (S a b) ∈
      matrixFiniteJetField F (matrixWignerSmith ι S) r ⊔
        matrixFiniteJetField F S 0 := by
  let Q := matrixWignerSmith ι S
  let A := matrixWignerSmithSystemMatrix ι Q
  have hmatrix := matrixDifferential_eq_mul_matrixWignerSmith ι hι S hdet
  have hsystem : ∀ j,
      (S a j)′ = ∑ k, A j k * S a k := by
    intro j
    have h := congrArg (fun M => M a j) hmatrix
    calc
      (S a j)′ = algebraMap F E ι * ∑ k, S a k * Q k j := by
        simpa [matrixDifferential, Matrix.mul_apply, Q] using h
      _ = ∑ k, A j k * S a k := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro k hk
        simp [A, matrixWignerSmithSystemMatrix, mul_assoc, mul_comm]
  have hjet := differentialJet_finiteLinearSystem
    (F := E) (E := E) A (fun j => S a j) hsystem (r + 1) b
  have hjet' :
      differentialJet (r + 1) (S a b) =
        ∑ j, finiteLinearSystemJetCoefficients A (r + 1) b j * S a j := by
    simpa using hjet
  rw [hjet']
  let B := matrixFiniteJetField F Q r ⊔ matrixFiniteJetField F S 0
  apply B.sum_mem
  intro j hj
  apply B.mul_mem
  · apply (le_sup_left : matrixFiniteJetField F Q r ≤ B)
    exact finiteLinearSystemJetCoefficients_matrixWignerSmithSystemMatrix_succ_mem
      ι Q r b j
  · apply (le_sup_right : matrixFiniteJetField F S 0 ≤ B)
    exact matrix_entry_mem_matrixFiniteJetField S 0 a j

/-- **Reverse finite-jet containment.**  Jets of `S` through order `r+1` lie in the compositum of
the order-`r` jet field of `Q` and the order-zero entry field of `S`. -/
theorem matrixWignerSmith_reverse_finiteJetField_le
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0)
    (r : ℕ) :
    matrixFiniteJetField F S (r + 1) ≤
      matrixFiniteJetField F (matrixWignerSmith ι S) r ⊔
        matrixFiniteJetField F S 0 := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro y ⟨p, hp, rfl⟩
  change p.2 < (r + 1) + 1 at hp
  change differentialJet p.2 (S p.1.1 p.1.2) ∈
    matrixFiniteJetField F (matrixWignerSmith ι S) r ⊔
      matrixFiniteJetField F S 0
  rcases p.2.eq_zero_or_pos with hzero | hpos
  · rw [hzero, differentialJet_zero]
    apply (le_sup_right : matrixFiniteJetField F S 0 ≤
      matrixFiniteJetField F (matrixWignerSmith ι S) r ⊔
        matrixFiniteJetField F S 0)
    exact matrix_entry_mem_matrixFiniteJetField S 0 p.1.1 p.1.2
  · obtain ⟨k, hk_eq⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
    rw [hk_eq]
    have hk : k ≤ r := by omega
    apply (sup_le_sup (matrixFiniteJetField_mono (matrixWignerSmith ι S) hk) le_rfl)
    exact matrixWignerSmith_scattering_differentialJet_succ_mem
      ι hι S hdet k p.1.1 p.1.2

/-- Union of two finite packets, hiding classical decidable equality. -/
noncomputable def matrixFinitePacketUnion {E : Type*}
    (left right : Finset E) : Finset E := by
  classical
  exact left ∪ right

/-- The finite matrix-jet packet has at most `(n+1)^2(r+1)` coordinates. -/
theorem matrixFiniteJetPacket_card_le
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) :
    (matrixFiniteJetPacket S r).card ≤ (n + 1) ^ 2 * (r + 1) := by
  classical
  calc
    (matrixFiniteJetPacket S r).card ≤
        ((Finset.univ : Finset (Fin (n + 1) × Fin (n + 1))) ×ˢ
          Finset.range (r + 1)).card := Finset.card_image_le
    _ = (n + 1) ^ 2 * (r + 1) := by simp [pow_two]

/-- **Reverse finite-jet rank inequality.**  The only possible rank excess of `S` over the
one-order-lower `Q` packet is its `(n+1)^2` order-zero initial layer. -/
theorem matrixWignerSmith_reverse_finiteJetRank_le
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0)
    (r : ℕ) :
    matrixFiniteJetRank F S (r + 1) ≤
      matrixFiniteJetRank F (matrixWignerSmith ι S) r + (n + 1) ^ 2 := by
  classical
  let Q := matrixWignerSmith ι S
  let qPacket := matrixFiniteJetPacket Q r
  let sZeroPacket := matrixFiniteJetPacket S 0
  let unionPacket := matrixFinitePacketUnion qPacket sZeroPacket
  have hfield : matrixFiniteJetField F S (r + 1) ≤
      matrixFiniteJetField F Q r ⊔ matrixFiniteJetField F S 0 :=
    matrixWignerSmith_reverse_finiteJetField_le ι hι S hdet r
  have hrank : finiteAlgebraicMatroidRank F (matrixFiniteJetPacket S (r + 1)) ≤
      finiteAlgebraicMatroidRank F unionPacket := by
    apply finiteAlgebraicMatroidRank_le_of_mem_intermediateAdjoin
    intro x hx
    change x ∈ IntermediateField.adjoin F
      (↑(matrixFinitePacketUnion qPacket sZeroPacket) : Set E)
    rw [matrixFinitePacketUnion, Finset.coe_union, IntermediateField.adjoin_union,
      ← matrixFiniteJetField_eq_adjoin_packet Q r,
      ← matrixFiniteJetField_eq_adjoin_packet S 0]
    apply hfield
    rw [matrixFiniteJetField_eq_adjoin_packet]
    exact IntermediateField.subset_adjoin F
      (S := (↑(matrixFiniteJetPacket S (r + 1)) : Set E)) (by exact_mod_cast hx)
  have hmarginal : finiteAlgebraicMatroidRank F unionPacket ≤
      finiteAlgebraicMatroidRank F qPacket + sZeroPacket.card := by
    let R := transcendenceRank F E
    have h := R.marginal_le_card qPacket sZeroPacket
    simpa [finiteAlgebraicMatroidRank, unionPacket, matrixFinitePacketUnion, R] using h
  have hcard : sZeroPacket.card ≤ (n + 1) ^ 2 := by
    simpa [sZeroPacket] using matrixFiniteJetPacket_card_le S 0
  change finiteAlgebraicMatroidRank F (matrixFiniteJetPacket S (r + 1)) ≤
    finiteAlgebraicMatroidRank F qPacket + (n + 1) ^ 2
  exact hrank.trans (hmarginal.trans (Nat.add_le_add_left hcard _))

/-- Normalization of a natural-valued rank profile by the number `r+1` of visible jet layers. -/
noncomputable def normalizedRankSequence (rank : ℕ → ℕ) (r : ℕ) : ℝ :=
  (rank r : ℝ) / ((r : ℝ) + 1)

/-- Two natural rank profiles at uniformly bounded additive distance have exactly the same
convergent normalized slopes. -/
theorem tendsto_normalizedRankSequence_iff_of_bounded_difference
    (a b : ℕ → ℕ) (C : ℕ)
    (hab : ∀ r, a r ≤ b r) (hba : ∀ r, b r ≤ a r + C) (σ : ℝ) :
    Filter.Tendsto (normalizedRankSequence a) Filter.atTop (nhds σ) ↔
      Filter.Tendsto (normalizedRankSequence b) Filter.atTop (nhds σ) := by
  have hC : Filter.Tendsto
      (fun r : ℕ => (C : ℝ) / ((r : ℝ) + 1)) Filter.atTop (nhds 0) := by
    simpa [div_eq_mul_inv] using
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (C : ℝ)
  have habR : ∀ r, normalizedRankSequence a r ≤ normalizedRankSequence b r := by
    intro r
    unfold normalizedRankSequence
    apply (div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < (r : ℝ) + 1)).mpr
    exact_mod_cast hab r
  have hbaR : ∀ r, normalizedRankSequence b r ≤
      normalizedRankSequence a r + (C : ℝ) / ((r : ℝ) + 1) := by
    intro r
    unfold normalizedRankSequence
    rw [← add_div]
    apply (div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < (r : ℝ) + 1)).mpr
    exact_mod_cast hba r
  constructor
  · intro ha
    have hu : Filter.Tendsto
        (fun r => normalizedRankSequence a r + (C : ℝ) / ((r : ℝ) + 1))
        Filter.atTop (nhds σ) := by
      simpa using ha.add hC
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' ha hu
      (Filter.Eventually.of_forall habR) (Filter.Eventually.of_forall hbaR)
  · intro hb
    have hl : Filter.Tendsto
        (fun r => normalizedRankSequence b r - (C : ℝ) / ((r : ℝ) + 1))
        Filter.atTop (nhds σ) := by
      simpa using hb.sub hC
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hl hb
    · apply Filter.Eventually.of_forall
      intro r
      have := hbaR r
      linarith
    · exact Filter.Eventually.of_forall habR

/-- Finite matrix-jet packets are monotone in the jet order. -/
theorem matrixFiniteJetPacket_mono
    {E : Type*} [Field E] [Differential E] {n : ℕ}
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    {r s : ℕ} (hrs : r ≤ s) :
    matrixFiniteJetPacket S r ⊆ matrixFiniteJetPacket S s := by
  classical
  intro z hz
  rw [mem_matrixFiniteJetPacket_iff] at hz ⊢
  obtain ⟨p, k, hk, rfl⟩ := hz
  exact ⟨p, k, hk.trans hrs, rfl⟩

/-- Finite matrix-jet rank is monotone in the jet order. -/
theorem matrixFiniteJetRank_mono
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    {r s : ℕ} (hrs : r ≤ s) :
    matrixFiniteJetRank F S r ≤ matrixFiniteJetRank F S s := by
  classical
  unfold matrixFiniteJetRank finiteAlgebraicMatroidRank
  exact (transcendenceRank F E).mono (matrixFiniteJetPacket_mono S hrs)

/-- Adding one jet layer raises matrix transcendence rank by at most the number of entries. -/
theorem matrixFiniteJetRank_succ_le
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) :
    matrixFiniteJetRank F S (r + 1) ≤
      matrixFiniteJetRank F S r + (n + 1) ^ 2 := by
  classical
  let layer := matrixJetLayerPacket S (r + 1)
  have hpacket :
      matrixFiniteJetPacket S (r + 1) = matrixFiniteJetPacket S r ∪ layer := by
    ext z
    rw [mem_matrixFiniteJetPacket_iff, Finset.mem_union,
      mem_matrixFiniteJetPacket_iff, mem_matrixJetLayerPacket_iff]
    constructor
    · rintro ⟨p, k, hk, hzk⟩
      rcases lt_or_eq_of_le hk with hlt | rfl
      · exact Or.inl ⟨p, k, Nat.lt_succ_iff.mp hlt, hzk⟩
      · exact Or.inr ⟨p, hzk⟩
    · rintro (⟨p, k, hk, hzk⟩ | ⟨p, hzk⟩)
      · exact ⟨p, k, hk.trans (Nat.le_succ r), hzk⟩
      · exact ⟨p, r + 1, by omega, hzk⟩
  let R := transcendenceRank F E
  have hmarginal := R.marginal_le_card (matrixFiniteJetPacket S r) layer
  have hcard : layer.card ≤ (n + 1) ^ 2 := by
    simpa [layer] using (show (matrixJetLayerPacket S (r + 1)).card ≤ (n + 1) ^ 2 from by
      calc
        (matrixJetLayerPacket S (r + 1)).card ≤ (Finset.univ :
          Finset (Fin (n + 1) × Fin (n + 1))).card := Finset.card_image_le
        _ = (n + 1) ^ 2 := by simp [pow_two])
  unfold matrixFiniteJetRank finiteAlgebraicMatroidRank
  rw [hpacket]
  exact hmarginal.trans (Nat.add_le_add_left hcard _)

/-- Normalized finite matrix-jet rank. -/
noncomputable def matrixNormalizedFiniteJetRank
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (r : ℕ) : ℝ :=
  normalizedRankSequence (matrixFiniteJetRank F S) r

/-- A real number is a matrix Kolchin slope when the normalized finite-jet ranks converge to it. -/
def HasMatrixKolchinSlope
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (σ : ℝ) : Prop :=
  Filter.Tendsto (matrixNormalizedFiniteJetRank F S) Filter.atTop (nhds σ)

/-- A one-order shift does not alter any convergent normalized matrix Kolchin slope. -/
theorem hasMatrixKolchinSlope_shift_iff
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (σ : ℝ) :
    HasMatrixKolchinSlope F S σ ↔
      Filter.Tendsto
        (normalizedRankSequence (fun r => matrixFiniteJetRank F S (r + 1)))
        Filter.atTop (nhds σ) := by
  unfold HasMatrixKolchinSlope matrixNormalizedFiniteJetRank
  apply tendsto_normalizedRankSequence_iff_of_bounded_difference
    (matrixFiniteJetRank F S) (fun r => matrixFiniteJetRank F S (r + 1))
    ((n + 1) ^ 2)
  · exact fun r => matrixFiniteJetRank_mono S (Nat.le_succ r)
  · exact matrixFiniteJetRank_succ_le S

/-- **Wigner--Smith Kolchin-slope conservation.**  Every convergent normalized ordinary finite-jet
rank slope of an invertible scattering matrix is exactly the corresponding slope of its
Wigner--Smith matrix, and conversely. -/
theorem matrixWignerSmith_hasMatrixKolchinSlope_iff
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F) (hι : ι * ι = -1)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) (hdet : S.det ≠ 0)
    (σ : ℝ) :
    HasMatrixKolchinSlope F S σ ↔
      HasMatrixKolchinSlope F (matrixWignerSmith ι S) σ := by
  let Q := matrixWignerSmith ι S
  have hcompare :
      Filter.Tendsto (normalizedRankSequence (matrixFiniteJetRank F Q))
          Filter.atTop (nhds σ) ↔
        Filter.Tendsto
          (normalizedRankSequence (fun r => matrixFiniteJetRank F S (r + 1)))
          Filter.atTop (nhds σ) := by
    apply tendsto_normalizedRankSequence_iff_of_bounded_difference
      (matrixFiniteJetRank F Q) (fun r => matrixFiniteJetRank F S (r + 1))
      ((n + 1) ^ 2)
    · exact matrixWignerSmith_finiteJetRank_le ι S
    · exact matrixWignerSmith_reverse_finiteJetRank_le ι hι S hdet
  rw [hasMatrixKolchinSlope_shift_iff S σ]
  exact hcompare.symm

end

