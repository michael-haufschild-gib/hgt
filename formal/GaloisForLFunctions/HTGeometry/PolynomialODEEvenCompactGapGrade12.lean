    (r^(1 : ℕ)*evenCompactRelativeGapGrade12Coeff1 v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactRelativeGapGrade12Coeff2 v) +
    (r^(3 : ℕ)*evenCompactRelativeGapGrade12Coeff3 v) : ℝ) : ℝ) +
    (((r^(4 : ℕ)*evenCompactRelativeGapGrade12Coeff4 v) +
    (r^(5 : ℕ)*evenCompactRelativeGapGrade12Coeff5 v) : ℝ) +
    ((r^(6 : ℕ)*evenCompactRelativeGapGrade12Coeff6 v) +
    ((r^(7 : ℕ)*evenCompactRelativeGapGrade12Coeff7 v) +
    (r^(8 : ℕ)*evenCompactRelativeGapGrade12Coeff8 v) : ℝ) : ℝ) : ℝ) : ℝ)

