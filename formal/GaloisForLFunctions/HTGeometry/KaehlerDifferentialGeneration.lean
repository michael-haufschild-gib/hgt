import GaloisForLFunctions.HTGeometry.KaehlerConnection
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Differential generators of the field generate the Kähler module over the operator ring

A `K`-submodule of `Ω[K⁄C]` which is stable under the canonical connection and contains `d s` for
every member of a differential generating set of `K/C` is everything.

The proof is the minimality of differential adjunction: the elements whose differential lies in the
submodule form an intermediate field — the Leibniz rule for a product, and `d(x⁻¹) = -x⁻² d x` for
an inverse — and it is derivation closed because `d (δ x) = ∇ (d x)`.  So it contains the
differential field generated by the generators, which is everything, and `Ω[K⁄C]` is spanned over
`K` by the image of `d`.

Consequently `Ω[K⁄C]` is generated over `K[∂;δ]` by finitely many elements whenever `K/C` is
finitely differentially generated: the `K[∂;δ]`-span of a set is a `K`-submodule stable under the
connection.

* `kaehlerMembershipField` — the intermediate field of elements whose differential lies in the
  submodule;
* `eq_top_of_connection_stable` — **the generation theorem**;
* `connectionOrbit`, `span_connectionOrbit_eq_top` — the module is spanned over `K` by the
  connection orbit of the generators, i.e. generated over `K[∂;δ]` by their differentials.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {C K : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
  (hC : ∀ c : C, Differential.deriv (algebraMap C K c) = 0)

/-- The elements whose differential lies in a given submodule. -/
def kaehlerMembershipField (N : Submodule K (Ω[K⁄C])) : IntermediateField C K where
  carrier := {x : K | KaehlerDifferential.D C K x ∈ N}
  mul_mem' := by
    intro x y hx hy
    show KaehlerDifferential.D C K (x * y) ∈ N
    rw [Derivation.leibniz]
    exact N.add_mem (N.smul_mem x hy) (N.smul_mem y hx)
  one_mem' := by
    show KaehlerDifferential.D C K 1 ∈ N
    rw [Derivation.map_one_eq_zero]
    exact N.zero_mem
  add_mem' := by
    intro x y hx hy
    show KaehlerDifferential.D C K (x + y) ∈ N
    rw [map_add]
    exact N.add_mem hx hy
  zero_mem' := by
    show KaehlerDifferential.D C K 0 ∈ N
    rw [map_zero]
    exact N.zero_mem
  algebraMap_mem' := by
    intro c
    show KaehlerDifferential.D C K (algebraMap C K c) ∈ N
    rw [Derivation.map_algebraMap]
    exact N.zero_mem
  inv_mem' := by
    intro x hx
    show KaehlerDifferential.D C K x⁻¹ ∈ N
    rcases eq_or_ne x 0 with rfl | hx0
    · rw [inv_zero, map_zero]
      exact N.zero_mem
    · have hprod : KaehlerDifferential.D C K (x * x⁻¹) = 0 := by
        rw [mul_inv_cancel₀ hx0, Derivation.map_one_eq_zero]
      rw [Derivation.leibniz] at hprod
      have hsolve : KaehlerDifferential.D C K x⁻¹
          = (-(x⁻¹ * x⁻¹)) • KaehlerDifferential.D C K x := by
        have hx' : x • KaehlerDifferential.D C K x⁻¹
            = -(x⁻¹ • KaehlerDifferential.D C K x) := by
          rw [← neg_eq_iff_add_eq_zero.mpr hprod]
          abel
        have := congrArg (fun ω => (x⁻¹ : K) • ω) hx'
        simp only [smul_smul, inv_mul_cancel₀ hx0, one_smul, smul_neg] at this
        rw [this, neg_smul]
      rw [hsolve]
      exact N.smul_mem _ hx

/-- **A connection-stable submodule containing the differentials of a differential generating set is
everything.** -/
theorem eq_top_of_connection_stable (N : Submodule K (Ω[K⁄C]))
    (hstable : ∀ ω ∈ N, kaehlerConnection hC ω ∈ N)
    {S : Set K} (hS : differentialAdjoin C S = ⊤)
    (hSN : ∀ s ∈ S, KaehlerDifferential.D C K s ∈ N) : N = ⊤ := by
  have hclosed : DerivationClosed (kaehlerMembershipField (C := C) (K := K) N) := by
    intro x hx
    show KaehlerDifferential.D C K (Differential.deriv x) ∈ N
    rw [← kaehlerConnection_D hC]
    exact hstable _ hx
  have hle : differentialAdjoin C S ≤ kaehlerMembershipField (C := C) (K := K) N :=
    differentialAdjoin_le C (fun s hs => hSN s hs) hclosed
  rw [hS, top_le_iff] at hle
  have hall : ∀ x : K, KaehlerDifferential.D C K x ∈ N := by
    intro x
    have : x ∈ kaehlerMembershipField (C := C) (K := K) N := by
      rw [hle]
      exact IntermediateField.mem_top
    exact this
  refine top_le_iff.mp ?_
  rw [← KaehlerDifferential.span_range_derivation C K]
  refine Submodule.span_le.mpr ?_
  rintro ω ⟨x, rfl⟩
  exact hall x

/-- The connection orbit of a set of differentials. -/
def connectionOrbit (S : Set K) : Set (Ω[K⁄C]) :=
  {ω | ∃ s ∈ S, ∃ n : ℕ,
    ω = (kaehlerConnection hC : Ω[K⁄C] → Ω[K⁄C])^[n] (KaehlerDifferential.D C K s)}

theorem mem_connectionOrbit_iterate {S : Set K} {s : K} (hs : s ∈ S) (n : ℕ) :
    (kaehlerConnection hC : Ω[K⁄C] → Ω[K⁄C])^[n] (KaehlerDifferential.D C K s)
      ∈ connectionOrbit hC S :=
  ⟨s, hs, n, rfl⟩

/-- **The Kähler module is spanned over `K` by the connection orbit of any differential generating
set** — that is, generated over `K[∂;δ]` by the differentials of the generators. -/
theorem span_connectionOrbit_eq_top {S : Set K} (hS : differentialAdjoin C S = ⊤) :
    Submodule.span K (connectionOrbit hC S) = ⊤ := by
  set N : Submodule K (Ω[K⁄C]) := Submodule.span K (connectionOrbit hC S) with hN
  have hgen : ∀ ω ∈ connectionOrbit hC S, kaehlerConnection hC ω ∈ N := by
    rintro ω ⟨s, hs, n, rfl⟩
    refine Submodule.subset_span ?_
    rw [← Function.iterate_succ_apply' (kaehlerConnection hC : Ω[K⁄C] → Ω[K⁄C]) n]
    exact mem_connectionOrbit_iterate hC hs (n + 1)
  have hstable : ∀ ω ∈ N, kaehlerConnection hC ω ∈ N := by
    intro ω hω
    induction hω using Submodule.span_induction with
    | mem x hx => exact hgen x hx
    | zero => rw [map_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact N.add_mem hx hy
    | smul a x hxmem hx =>
        rw [kaehlerConnection_smul]
        exact N.add_mem (N.smul_mem a hx) (N.smul_mem _ hxmem)
  refine eq_top_of_connection_stable hC N hstable hS fun s hs => ?_
  exact Submodule.subset_span (mem_connectionOrbit_iterate hC hs 0)


end

end GaloisForLFunctions.HTGeometry
