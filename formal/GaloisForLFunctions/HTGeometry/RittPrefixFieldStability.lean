import GaloisForLFunctions.HTGeometry.RittJetCollapse

/-!
# The jet prefix field of a linearizer is shift-stable, and its algebraic top jet collapses

The field `K(τ, d τ, …, d^[n−1] τ)` generated by the first `n` jets of a linearizer is stable under
the shift: jet triangularity writes `σ (d^[j] τ)` as a base multiple of `d^[j] τ` plus a base-linear
combination of strictly lower jets, all of which are generators.  Stability is proved by adjunction:
the preimage of an intermediate field under `σ` is again one, because `σ` is a ring endomorphism of
a field which maps the base into the base.

Combined with the collapse step this gives the statement the Galoisian proof of Ritt's theorem needs:
for `n ≥ 2`, a jet of a linearizer that is merely *algebraic* over the prefix field of the lower jets
in fact *lies* in it.  The differential field generated by a differentially algebraic linearizer is
therefore an ordinary finitely generated extension `K(τ, …, τ^{(n−1)})`.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

namespace RittFrame

variable (Fr : RittFrame K L)

/-- The field generated over the base by the first `n` jets of `τ`. -/
def jetPrefixField (τ : L) (n : ℕ) : IntermediateField K L :=
  IntermediateField.adjoin K {x | ∃ j < n, x = Fr.d^[j] τ}

theorem jet_mem_jetPrefixField {τ : L} {j n : ℕ} (h : j < n) :
    Fr.d^[j] τ ∈ Fr.jetPrefixField τ n :=
  IntermediateField.subset_adjoin K _ ⟨j, h, rfl⟩

/-- The span of the jets sits inside any intermediate field carrying them. -/
theorem jetSpan_le_intermediateField {τ : L} {E : IntermediateField K L} {m : ℕ}
    (h : ∀ j, j < m → Fr.d^[j + 1] τ ∈ E) : ∀ x ∈ Fr.jetSpan τ m, x ∈ E := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      exact h j hj
  | zero => exact zero_mem E
  | add a b _ _ ha hb => exact add_mem ha hb
  | smul c a _ ha =>
      rw [Algebra.smul_def]
      exact mul_mem (IntermediateField.algebraMap_mem E c) ha

/-- The preimage of an intermediate field under the shift is an intermediate field, so shift
stability on a generating set propagates to the field it generates. -/
theorem sigma_mem_of_mem_adjoin {S : Set L} {E : IntermediateField K L}
    (hS : ∀ x ∈ S, Fr.σ x ∈ E) :
    ∀ x ∈ IntermediateField.adjoin K S, Fr.σ x ∈ E := by
  have hle : IntermediateField.adjoin K S ≤
      { carrier := {x : L | Fr.σ x ∈ E}
        mul_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq, map_mul] at *
          exact mul_mem ha hb
        one_mem' := by simp
        add_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq, map_add] at *
          exact add_mem ha hb
        zero_mem' := by simp
        algebraMap_mem' := fun a => by
          simp only [Set.mem_setOf_eq, Fr.comp]
          exact IntermediateField.algebraMap_mem E _
        inv_mem' := fun a ha => by
          simp only [Set.mem_setOf_eq, map_inv₀] at *
          exact inv_mem ha } :=
    IntermediateField.adjoin_le_iff.mpr hS
  exact fun x hx => hle hx

/-- **Shift stability of the jet prefix field.** -/
theorem sigma_mem_jetPrefixField {τ : L} {q : K} (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ) (n : ℕ) :
    ∀ x ∈ Fr.jetPrefixField τ n, Fr.σ x ∈ Fr.jetPrefixField τ n := by
  refine Fr.sigma_mem_of_mem_adjoin ?_
  rintro x ⟨j, hj, rfl⟩
  match j, hj with
  | 0, hj =>
      simp only [Function.iterate_zero, id_eq]
      rw [hshift]
      exact mul_mem (IntermediateField.algebraMap_mem _ _) (Fr.jet_mem_jetPrefixField hj)
  | (i + 1), hj =>
      have hv := Fr.shift_jet_sub_mem_jetSpan hqconst hshift i
      have hvE : Fr.σ (Fr.d^[i + 1] τ)
          - algebraMap K L (q / Fr.ρ ^ (i + 1)) * Fr.d^[i + 1] τ ∈ Fr.jetPrefixField τ n :=
        Fr.jetSpan_le_intermediateField (fun j hjm => Fr.jet_mem_jetPrefixField (by omega)) _ hv
      have hsplit : Fr.σ (Fr.d^[i + 1] τ)
          = algebraMap K L (q / Fr.ρ ^ (i + 1)) * Fr.d^[i + 1] τ
            + (Fr.σ (Fr.d^[i + 1] τ)
              - algebraMap K L (q / Fr.ρ ^ (i + 1)) * Fr.d^[i + 1] τ) := by ring
      rw [hsplit]
      exact add_mem (mul_mem (IntermediateField.algebraMap_mem _ _)
        (Fr.jet_mem_jetPrefixField hj)) hvE

end RittFrame

/-- **An algebraic jet of a linearizer lies in the prefix field.**  For `n ≥ 2` the jet tower of a
linearizer acquires no algebraic layer: the first jet that is algebraic over its predecessors is
already a rational expression in them. -/
theorem jet_mem_jetPrefixField_of_isAlgebraic (Fr : RittFrame K L) [CharZero L]
    {τ : L} {q : K} (hτ : τ ≠ 0) (hdτ : Fr.d τ ≠ 0) (hq : q ≠ 0) (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ)
    {n : ℕ} (hn : 2 ≤ n)
    (halg : IsAlgebraic ↥(Fr.jetPrefixField τ n) (Fr.d^[n] τ)) :
    Fr.d^[n] τ ∈ Fr.jetPrefixField τ n := by
  obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = m + 1 := ⟨n - 1, by omega⟩
  refine jet_mem_of_isIntegral_of_lower_jets_mem Fr hτ hdτ hq hqconst hshift
    (Fr.sigma_mem_jetPrefixField hqconst hshift (m + 1))
    (fun y hy => by
      obtain ⟨a, ha⟩ := Fr.fixed y hy
      rw [← ha]
      exact IntermediateField.algebraMap_mem _ _)
    (by simpa using Fr.jet_mem_jetPrefixField (τ := τ) (j := 0) (n := m + 1) (by omega))
    (by omega)
    (fun j hj => Fr.jet_mem_jetPrefixField (by omega))
    halg.isIntegral

end GaloisForLFunctions.HTGeometry
