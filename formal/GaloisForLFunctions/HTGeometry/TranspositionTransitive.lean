import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.GroupTheory.Perm.Closure

/-!
# A transitive group generated by transpositions is the whole symmetric group

A subgroup generated by transpositions contains the transposition of two points exactly when they
lie in one of its orbits.  So if it has a single orbit it contains every transposition, and the
transpositions generate everything.

This is the last step of the monodromy argument for a branched cover whose branch inertia is
generated by simple folds: once the meridian subgroup is transitive, the geometric monodromy group
is the full symmetric group on the fiber.
-/

namespace GaloisForLFunctions.HTGeometry

open Equiv MulAction

variable {α : Type*} [DecidableEq α] [Finite α]

/-- **A transitive group generated by transpositions is the full symmetric group.** -/
theorem eq_top_of_isSwap_of_transitive {S : Set (Equiv.Perm α)} (hS : ∀ f ∈ S, f.IsSwap)
    (htrans : ∀ x y : α, x ∈ MulAction.orbit (Subgroup.closure S) y) :
    Subgroup.closure S = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← Equiv.Perm.closure_isSwap (α := α), Subgroup.closure_le]
  rintro f ⟨x, y, -, rfl⟩
  exact (swap_mem_closure_isSwap hS).2 (htrans x y)

/-- **One full orbit suffices.**  A group generated by transpositions with a single orbit on the
whole set is the full symmetric group. -/
theorem eq_top_of_isSwap_of_orbit_eq_univ {S : Set (Equiv.Perm α)} (hS : ∀ f ∈ S, f.IsSwap)
    {x : α} (hx : MulAction.orbit (Subgroup.closure S) x = Set.univ) :
    Subgroup.closure S = ⊤ := by
  refine eq_top_of_isSwap_of_transitive hS fun a b => ?_
  have ha : a ∈ MulAction.orbit (Subgroup.closure S) x := by
    rw [hx]
    exact Set.mem_univ a
  have hb : b ∈ MulAction.orbit (Subgroup.closure S) x := by
    rw [hx]
    exact Set.mem_univ b
  exact (MulAction.orbit_eq_iff.2 hb) ▸ ha

/-- **The monodromy conclusion for a branched cover with simple transitive branch inertia.**  If the
meridian subgroup of a permutation group is generated by transpositions and already has a single
orbit, the ambient group is the full symmetric group on the fiber. -/
theorem eq_top_of_meridian_isSwap_of_orbit_eq_univ {G : Subgroup (Equiv.Perm α)}
    {S : Set (Equiv.Perm α)} (hS : ∀ f ∈ S, f.IsSwap) (hSG : Subgroup.closure S ≤ G)
    {x : α} (hx : MulAction.orbit (Subgroup.closure S) x = Set.univ) :
    G = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← eq_top_of_isSwap_of_orbit_eq_univ hS hx]
  exact hSG

end GaloisForLFunctions.HTGeometry
