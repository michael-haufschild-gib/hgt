import GaloisForLFunctions.HTGeometry.BohrHullGroup
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic

/-!
# The Bohr hull carries its Borel structure canonically

Every measure-theoretic statement about the Bohr hull is written with a measurable structure and a
Borel compatibility as instance hypotheses, and nothing supplied them: each call site had to open
the Borel σ-algebra by hand.

The hull is a completion, hence a topological space, so its Borel σ-algebra is available with no
choice at all, and it is a Borel space for that σ-algebra by definition.  Registering the two as
instances discharges the hypotheses everywhere at once.
-/

open Filter Topology Metric MeasureTheory

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions

open HTGeometry

variable {E : Type*} [NormedAddCommGroup E]

/-- The Bohr hull carries the Borel σ-algebra of its completion topology. -/
noncomputable instance instMeasurableSpaceBohrHull (f : ℝ →ᵇ E) : MeasurableSpace (BohrHull f) :=
  borel (BohrHull f)

/-- **The Bohr hull is a Borel space for that σ-algebra**, by construction. -/
instance instBorelSpaceBohrHull (f : ℝ →ᵇ E) : BorelSpace (BohrHull f) := ⟨rfl⟩

/-- Existence form of the two structures, for consumers stated with them as data. -/
theorem exists_borelSpace_bohrHull (f : ℝ →ᵇ E) :
    ∃ _ : MeasurableSpace (BohrHull f), BorelSpace (BohrHull f) :=
  ⟨instMeasurableSpaceBohrHull f, instBorelSpaceBohrHull f⟩

/-- The Borel σ-algebra of the Bohr hull is generated by its open sets. -/
theorem measurableSpace_bohrHull_eq_borel (f : ℝ →ᵇ E) :
    (instMeasurableSpaceBohrHull f) = borel (BohrHull f) := rfl

end GaloisForLFunctions
