import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealZorn

/-!
# Ritt's basis theorem, reduced to the prime case

Combining the Zorn step with the primality step: if every prime radical differential ideal is
finitely generated as a radical differential ideal, then every radical differential ideal is.  A
maximal counterexample exists, is proper (the unit ideal is generated by `1`), and is prime, so it
is finitely generated after all.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

theorem radicalDifferentialIdeal_one : radicalDifferentialIdeal ({1} : Set R) = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr (subset_radicalDifferentialIdeal ({1} : Set R) rfl)

theorem isRadDiffFG_top : IsRadDiffFG (⊤ : Ideal R) :=
  ⟨{1}, by rw [← radicalDifferentialIdeal_one]; norm_num⟩

/-- **Ritt's basis theorem, reduced to the prime case.** -/
theorem radDiffFG_of_prime_radDiffFG
    (hprime : ∀ P : Ideal R, P.IsPrime → P.IsRadical →
      (∀ x ∈ P, Differential.deriv x ∈ P) → IsRadDiffFG P)
    (I : Ideal R) (hrad : I.IsRadical) (hδ : ∀ x ∈ I, Differential.deriv x ∈ I) :
    IsRadDiffFG I := by
  by_contra hI
  obtain ⟨M, hMrad, hMδ, hMfg, hMmax⟩ :=
    exists_maximal_not_radDiffFG ⟨I, hrad, hδ, hI⟩
  have hMtop : M ≠ ⊤ := by
    intro h
    exact hMfg (h ▸ isRadDiffFG_top)
  have hMprime : M.IsPrime :=
    ⟨hMtop, fun {x y} hxy => mem_or_mem_of_maximal_not_radDiffFG hMrad hMδ hMfg hMmax hxy⟩
  exact hMfg (hprime M hMprime hMrad hMδ)

end

end GaloisForLFunctions.HTGeometry
