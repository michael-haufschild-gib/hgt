import GaloisForLFunctions.HTGeometry.SpectralClusterTransfer

/-!
# Finite-depth observability in arbitrary generator universes

The interaction universe need not be finite. Every finite word still uses only finitely many
generator labels, and a Boolean Möbius probe extracts only terms that use every label it probes.
This module proves the resulting support-birth obstruction without a `Fintype` assumption on the
generator or site types.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

/-- Support of a finite word in an arbitrary, possibly infinite, generator universe. -/
def finiteInteractionWordSupport
    {E : Type*} [DecidableEq E] {n : ℕ}
    (word : Fin n → E) : Finset E :=
  Finset.univ.image word

/-- A word of length `n` uses at most `n` generator labels even when the ambient generator
universe is infinite. -/
theorem finiteInteractionWordSupport_card_le
    {E : Type*} [DecidableEq E] {n : ℕ}
    (word : Fin n → E) :
    (finiteInteractionWordSupport word).card ≤ n := by
  unfold finiteInteractionWordSupport
  exact Finset.card_image_le.trans_eq (Fintype.card_fin n)

/-- Zeta response of one finite generator word: the word contributes exactly when all labels in
its support are active. -/
def finiteWordZetaResponse
    {E R : Type*} [DecidableEq E] [CommRing R] {n : ℕ}
    (word : Fin n → E) (coefficient : R) (active : Finset E) : R :=
  if finiteInteractionWordSupport word ⊆ active then coefficient else 0

theorem finiteWordZetaResponse_insert_eq_of_not_mem_support
    {E R : Type*} [DecidableEq E] [CommRing R] {n : ℕ}
    (word : Fin n → E) (coefficient : R) {e : E}
    (he : e ∉ finiteInteractionWordSupport word) (active : Finset E) :
    finiteWordZetaResponse word coefficient (insert e active) =
      finiteWordZetaResponse word coefficient active := by
  unfold finiteWordZetaResponse
  have hsubset :
      finiteInteractionWordSupport word ⊆ insert e active ↔
        finiteInteractionWordSupport word ⊆ active := by
    constructor
    · intro h x hx
      have hxe : x ≠ e := by
        intro hxe
        exact he (hxe ▸ hx)
      have hxinsert := h hx
      simpa [hxe] using hxinsert
    · intro h x hx
      exact Finset.mem_insert_of_mem (h hx)
  simp only [hsubset]

/-- **Infinite-universe order obstruction for one word.** A probe containing more labels than a
word can use annihilates that word exactly. -/
theorem finsetMobiusResponse_finiteWordZetaResponse_eq_zero_of_lt_card
    {E R : Type*} [DecidableEq E] [CommRing R] {n : ℕ}
    (word : Fin n → E) (coefficient : R) (packet : Finset E)
    (hcard : n < packet.card) :
    finsetMobiusResponse packet
      (finiteWordZetaResponse word coefficient) = 0 := by
  have hnsubset :
      ¬packet ⊆ finiteInteractionWordSupport word := by
    intro hsubset
    have hle :
        packet.card ≤ n :=
      (Finset.card_le_card hsubset).trans
        (finiteInteractionWordSupport_card_le word)
    exact (not_lt_of_ge hle) hcard
  obtain ⟨e, hepacket, hesupport⟩ := Finset.not_subset.mp hnsubset
  apply finsetMobiusResponse_eq_zero_of_insert_invariant hepacket
  intro active
  exact finiteWordZetaResponse_insert_eq_of_not_mem_support
    word coefficient hesupport active

/-- A finite superposition of fixed-length generator words in an arbitrary ambient universe. -/
def finitelyWordGeneratedResponse
    {E R : Type*} [DecidableEq E] [CommRing R] {n : ℕ}
    (words : Finset (Fin n → E)) (coefficient : (Fin n → E) → R)
    (active : Finset E) : R :=
  ∑ word ∈ words, finiteWordZetaResponse word (coefficient word) active

/-- **Universal finite-depth support law.** In every generator universe, finite or infinite,
every finite response generated by length-`n` words is invisible to every irreducible packet
containing more than `n` labels. -/
theorem finsetMobiusResponse_finitelyWordGeneratedResponse_eq_zero_of_lt_card
    {E R : Type*} [DecidableEq E] [CommRing R] {n : ℕ}
    (words : Finset (Fin n → E)) (coefficient : (Fin n → E) → R)
    (packet : Finset E) (hcard : n < packet.card) :
    finsetMobiusResponse packet
      (finitelyWordGeneratedResponse words coefficient) = 0 := by
  classical
  induction words using Finset.induction_on with
  | empty =>
      simp [finitelyWordGeneratedResponse, finsetMobiusResponse]
  | @insert word words hword ih =>
      have hresponse :
          finitelyWordGeneratedResponse (insert word words) coefficient =
            finiteWordZetaResponse word (coefficient word) +
              finitelyWordGeneratedResponse words coefficient := by
        funext active
        simp [finitelyWordGeneratedResponse, hword]
      rw [hresponse, finsetMobiusResponse_add]
      rw [
        finsetMobiusResponse_finiteWordZetaResponse_eq_zero_of_lt_card
          word (coefficient word) packet hcard,
        ih,
        add_zero]

/-! ## Arbitrary site universes -/

/-- Site support reached by a finite generator word. -/
def finiteInteractionWordSiteSupport
    {E V : Type*} [DecidableEq V] {n : ℕ}
    (generatorSupport : E → Finset V) (word : Fin n → E) : Finset V :=
  Finset.univ.biUnion fun i => generatorSupport (word i)

/-- A finite site packet is reachable at depth `n` when one length-`n` generator word covers it. -/
def GeneratorReachableAtDepth
    {E V : Type*} [DecidableEq V]
    (generatorSupport : E → Finset V) (sites : Finset V) (n : ℕ) : Prop :=
  ∃ word : Fin n → E,
    sites ⊆ finiteInteractionWordSiteSupport generatorSupport word

/-- **Arbitrary-site support-birth law.** Let a degree-`n` response be any finite sum of terms,
each local on the union of sites touched by its generator word. If no length-`n` word can cover a
finite observer packet, that packet's higher Möbius contrast vanishes exactly. Both generator and
site universes may be infinite. -/
theorem higherCoordinateContrast_finiteWordSum_eq_zero_of_unreachable
    {E V A R : Type*} [DecidableEq E] [DecidableEq V] [CommRing R]
    {n : ℕ} (generatorSupport : E → Finset V)
    (words : Finset (Fin n → E))
    (term : (Fin n → E) → (V → A) → R)
    (hlocal : ∀ word ∈ words,
      CoordinateLocalOn
        (finiteInteractionWordSiteSupport generatorSupport word : Set V)
        (term word))
    (x alternative : V → A) (sites : Finset V)
    (hunreachable :
      ¬GeneratorReachableAtDepth generatorSupport sites n) :
    higherCoordinateContrast x alternative sites
      (∑ word ∈ words, term word) = 0 := by
  apply higherCoordinateContrast_sum_eq_zero_of_cluster_miss
    words
    (fun word =>
      (finiteInteractionWordSiteSupport generatorSupport word : Set V))
    term hlocal x alternative sites
  intro word hword
  have hnsubset :
      ¬sites ⊆ finiteInteractionWordSiteSupport generatorSupport word := by
    intro hsubset
    exact hunreachable ⟨word, hsubset⟩
  exact Finset.not_subset.mp hnsubset

end GaloisForLFunctions.HTGeometry
