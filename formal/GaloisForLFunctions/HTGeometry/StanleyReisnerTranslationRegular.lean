import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetCoordinates
import GaloisForLFunctions.HTGeometry.TranslationDenominatorLaurentShift

/-!
# Regularity of Stanley--Reisner translation denominators

Although the coordinate variables of a Stanley--Reisner ring may be zero divisors, every
translation `1 + x_v` is regular.  Facet restriction makes the reason transparent: on each facet
it is a polynomial with constant coefficient one.  Consequently the monoid generated by the
translations embeds into the non-zero-divisors and localization at that monoid is injective.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial
open scoped nonZeroDivisors

noncomputable section

/-- The translated vertex class `1 + x_v` in a Stanley--Reisner quotient. -/
def stanleyReisnerTranslationClass
    {R α : Type*} [CommRing R] [DecidableEq α]
    (facets : Finset (Finset α)) (v : α) :
    MvPolynomial α R ⧸ stanleyReisnerIdeal R facets :=
  Ideal.Quotient.mk (stanleyReisnerIdeal R facets) (1 + X v)

theorem facetPolynomialRestriction_one_add_X_ne_zero
    {R α : Type*} [CommRing R] [Nontrivial R]
    (F : Finset α) (v : α) :
    facetPolynomialRestriction (R := R) F (1 + X v) ≠ 0 := by
  intro hzero
  have hcoeff := congrArg (fun Q : MvPolynomial F R => Q.coeff 0) hzero
  change (facetPolynomialRestriction F (1 + X v)).coeff 0 = 0 at hcoeff
  rw [facetPolynomialRestriction_coeff] at hcoeff
  simp at hcoeff

/-- Multiplication by every translated vertex is injective in the Stanley--Reisner quotient. -/
theorem stanleyReisnerTranslationClass_mul_injective
    {R α : Type*} [CommRing R] [IsDomain R] [DecidableEq α]
    (facets : Finset (Finset α)) (v : α) :
    Function.Injective (fun P : MvPolynomial α R ⧸ stanleyReisnerIdeal R facets =>
      stanleyReisnerTranslationClass facets v * P) := by
  intro P Q hPQ
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective P
  obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective Q
  apply Ideal.Quotient.eq.mpr
  change Ideal.Quotient.mk (stanleyReisnerIdeal R facets) ((1 + X v) * P) =
    Ideal.Quotient.mk (stanleyReisnerIdeal R facets) ((1 + X v) * Q) at hPQ
  rw [Ideal.Quotient.eq] at hPQ
  have hprod : (1 + X v) * (P - Q) ∈ stanleyReisnerIdeal R facets := by
    simpa only [mul_sub] using hPQ
  rw [stanleyReisnerIdeal_eq_inf_facetIdeal, Finset.inf_eq_iInf] at hprod ⊢
  simp only [Ideal.mem_iInf] at hprod ⊢
  intro F hF
  have hprodF : (1 + X v) * (P - Q) ∈ facetIdeal R F := hprod F hF
  have hzero : facetPolynomialRestriction F ((1 + X v) * (P - Q)) = 0 :=
    RingHom.mem_ker.mp ((ker_facetPolynomialRestriction (R := R) F).symm ▸ hprodF)
  rw [map_mul] at hzero
  have hright : facetPolynomialRestriction F (P - Q) = 0 :=
    (mul_eq_zero.mp hzero).resolve_left
      (facetPolynomialRestriction_one_add_X_ne_zero (R := R) F v)
  exact (ker_facetPolynomialRestriction (R := R) F) ▸ RingHom.mem_ker.mpr hright

/-- Every translated vertex is a non-zero-divisor in the Stanley--Reisner quotient. -/
theorem stanleyReisnerTranslationClass_mem_nonZeroDivisors
    {R α : Type*} [CommRing R] [IsDomain R] [DecidableEq α]
    (facets : Finset (Finset α)) (v : α) :
    stanleyReisnerTranslationClass facets v ∈
      nonZeroDivisors (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) := by
  rw [mem_nonZeroDivisors_iff]
  constructor
  · intro P hP
    apply (stanleyReisnerTranslationClass_mul_injective (R := R) facets v)
    simpa using hP
  · intro P hP
    apply (stanleyReisnerTranslationClass_mul_injective (R := R) facets v)
    simpa [mul_comm] using hP

/-- Translation monomials after passage to the Stanley--Reisner quotient. -/
def stanleyReisnerTranslationMonomialHom
    {R α : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :
    TranslationExponent α →*
      (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) where
  toFun n := ∏ v, stanleyReisnerTranslationClass facets v ^
    (Multiplicative.toAdd n v)
  map_one' := by simp
  map_mul' n m := by
    simp only [toAdd_mul, Pi.add_apply, pow_add, Finset.prod_mul_distrib]

/-- The canonical denominator monoid inside the Stanley--Reisner quotient. -/
def stanleyReisnerTranslationSubmonoid
    (R α : Type*) [CommRing R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :
    Submonoid (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) :=
  MonoidHom.mrange (stanleyReisnerTranslationMonomialHom (R := R) facets)

/-- Every translation denominator is a non-zero-divisor. -/
theorem stanleyReisnerTranslationSubmonoid_le_nonZeroDivisors
    {R α : Type*} [CommRing R] [IsDomain R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :
    stanleyReisnerTranslationSubmonoid R α facets ≤
      nonZeroDivisors (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) := by
  rintro d ⟨n, rfl⟩
  apply Submonoid.prod_mem
  intro v _
  exact Submonoid.pow_mem _
    (stanleyReisnerTranslationClass_mem_nonZeroDivisors (R := R) facets v) _

/-- The canonical localization obtained by inverting every translated vertex. -/
abbrev StanleyReisnerTranslationLocalization
    (R α : Type*) [CommRing R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :=
  Localization (stanleyReisnerTranslationSubmonoid R α facets)

set_option maxHeartbeats 800000 in
/-- Localization at the translated vertices does not collapse any global Stanley--Reisner class. -/
theorem stanleyReisnerTranslationLocalization_algebraMap_injective
    {R α : Type*} [CommRing R] [IsDomain R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α)) :
    Function.Injective
      (algebraMap
        (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets)
        (StanleyReisnerTranslationLocalization R α facets)) :=
  IsLocalization.injective (StanleyReisnerTranslationLocalization R α facets)
    (stanleyReisnerTranslationSubmonoid_le_nonZeroDivisors facets)

set_option maxHeartbeats 800000 in
/-- **Representation-independent localization law.**  Two numerator--denominator pairs define the
same localized class exactly when their cross-products agree in the global Stanley--Reisner
quotient. -/
theorem stanleyReisnerTranslationLocalization_mk_eq_mk_iff
    {R α : Type*} [CommRing R] [IsDomain R] [Fintype α] [DecidableEq α]
    (facets : Finset (Finset α))
    (P Q : MvPolynomial α R ⧸ stanleyReisnerIdeal R facets)
    (d e : stanleyReisnerTranslationSubmonoid R α facets) :
    (Localization.mk P d : StanleyReisnerTranslationLocalization R α facets) =
        Localization.mk Q e ↔
      P * (e : MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) =
        (d : MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) * Q := by
  rw [Localization.mk_eq_mk_iff,
    Localization.r_iff_of_le_nonZeroDivisors
      (stanleyReisnerTranslationSubmonoid_le_nonZeroDivisors facets)]

/-- The canonical extension of any global row map that sends every translation denominator to a
unit.  Its construction on the localization makes the output independent of the chosen fraction
representation. -/
def stanleyReisnerTranslationLocalizationLift
    {R α T : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    [CommRing T] (facets : Finset (Finset α))
    (f : (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) →+* T)
    (hunit : ∀ d : stanleyReisnerTranslationSubmonoid R α facets,
      IsUnit (f d)) :
    StanleyReisnerTranslationLocalization R α facets →+* T :=
  IsLocalization.lift (S := StanleyReisnerTranslationLocalization R α facets) hunit

/-- The localization lift is the unique global map extending the original numerator map. -/
theorem stanleyReisnerTranslationLocalizationLift_unique
    {R α T : Type*} [CommRing R] [Fintype α] [DecidableEq α]
    [CommRing T] (facets : Finset (Finset α))
    (f : (MvPolynomial α R ⧸ stanleyReisnerIdeal R facets) →+* T)
    (hunit : ∀ d : stanleyReisnerTranslationSubmonoid R α facets,
      IsUnit (f d))
    (g : StanleyReisnerTranslationLocalization R α facets →+* T)
    (hg : g.comp (algebraMap _ _) = f) :
    g = stanleyReisnerTranslationLocalizationLift facets f hunit := by
  apply IsLocalization.ringHom_ext (S := StanleyReisnerTranslationLocalization R α facets)
    (stanleyReisnerTranslationSubmonoid R α facets)
  rw [hg]
  exact (IsLocalization.lift_comp hunit).symm

end

end GaloisForLFunctions.HTGeometry
