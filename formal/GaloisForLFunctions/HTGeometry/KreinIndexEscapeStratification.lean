import GaloisForLFunctions.HTGeometry.PoleLocalizedExactNegativeSquares
import GaloisForLFunctions.HTGeometry.RemotePairEscapeGauge
import GaloisForLFunctions.HTGeometry.FaithfulIndexFredholmObstruction
import GaloisForLFunctions.HTGeometry.AffineBaseJetGauge

/-!
# Faithful Krein-index escape stratification

`faithful-krein-index-escape-stratification`.

Three independent layers.

* **Index arithmetic.**  Appending `r` further distinct upper conjugate pairs to a carrier
  `B + multiPairCarrier tb` raises the exact number of negative squares from `k` to `k + r`
  (`escapeCarrier_exact_negativeSquares`).
* **Power-level gauge blindness.**  Multiplying every member of a family by a nonzero element of
  the differential base field leaves the differential field generated by the `N`-th powers
  unchanged, for every `N` (`differentialAdjoin_range_pow_baseGauge_eq`).  This is the card's
  equation `(4)` at every power level.
* **Escape.**  The normalized remote gauge tends to `1` with every derivative, so the higher-index
  carriers sit in every compact-open neighbourhood of the lower-index one.

The three combine into the stratification statement and, with
`no_faithful_continuous_index_of_unbounded_witness`, into the continuous-Fredholm obstruction.
-/

open Complex Filter Topology Matrix
open scoped ComplexOrder

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-! ## Power-level gauge blindness -/

/-- **Equation (4) at every power level.**  Multiplying each member of a family by a nonzero
element of the differential base field does not change the differential field generated by the
`N`-th powers. -/
theorem differentialAdjoin_range_pow_baseGauge_eq
    {F K ι : Type*} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K]
    (x : ι → K) (a : ι → F) (ha : ∀ i, a i ≠ 0) (N : ℕ) :
    differentialAdjoin F (Set.range fun i => (algebraMap F K (a i) * x i) ^ N) =
      differentialAdjoin F (Set.range fun i => (x i) ^ N) := by
  have hrw : (fun i => (algebraMap F K (a i) * x i) ^ N)
      = fun i => algebraMap F K (a i ^ N) * (x i) ^ N + algebraMap F K 0 := by
    funext i
    rw [mul_pow, map_pow, map_zero, add_zero]
  rw [hrw]
  exact differentialAdjoin_range_affineBase_eq (fun i => (x i) ^ N) (fun i => a i ^ N)
    (fun _ => 0) (fun i => pow_ne_zero N (ha i))

/-! ## Index arithmetic for appended conjugate pairs -/

theorem multiPairCarrier_append {k r : ℕ} (tb : Fin k → ℂ) (te : Fin r → ℂ) (z : ℂ) :
    multiPairCarrier (Fin.append tb te) z
      = multiPairCarrier tb z + multiPairCarrier te z := by
  rw [multiPairCarrier, multiPairCarrier, multiPairCarrier, Fin.sum_univ_add]
  congr 1
  · exact Finset.sum_congr rfl fun i _ => by rw [Fin.append_left]
  · exact Finset.sum_congr rfl fun i _ => by rw [Fin.append_right]

/-- The escape carrier: a positive Nevanlinna background, `k` fixed conjugate pairs, and `r`
further conjugate pairs which are free to move. -/
def escapeCarrier {k r : ℕ} (B : ℂ → ℂ) (tb : Fin k → ℂ) (te : Fin r → ℂ) (z : ℂ) : ℂ :=
  B z + multiPairCarrier (Fin.append tb te) z

theorem escapeCarrier_eq {k r : ℕ} (B : ℂ → ℂ) (tb : Fin k → ℂ) (te : Fin r → ℂ) (z : ℂ) :
    escapeCarrier B tb te z
      = (B z + multiPairCarrier tb z) + multiPairCarrier te z := by
  rw [escapeCarrier, multiPairCarrier_append]
  ring

/-- **Exact index `k + r`.**  Appending `r` further distinct upper conjugate pairs to a
positive-background carrier with `k` pairs gives a carrier with exactly `k + r` negative squares:
a universal bound `k + r` on every finite node packet avoiding the poles, and a pole-localized
node packet realizing `k + r` negative directions. -/
theorem escapeCarrier_exact_negativeSquares
    {k r : ℕ} (B : ℂ → ℂ) (tb : Fin k → ℂ) (te : Fin r → ℂ)
    (ht : ∀ i, 0 < (Fin.append tb te i).im)
    (htinj : Function.Injective (Fin.append tb te))
    (hBcont : ∀ i, ContinuousAt B (Fin.append tb te i))
    (hBpsd : ∀ {N : ℕ} (z : Fin N → ℂ),
      (∀ j, 0 < (z j).im) → (carrierPickMatrix B z).PosSemidef) :
    (∀ {N : ℕ} (z : Fin N → ℂ),
      (∀ j, 0 < (z j).im) →
      (∀ i j, z j ≠ Fin.append tb te i) →
      ∀ W : Submodule ℂ (Fin N → ℂ),
        (∀ x ∈ W, x ≠ 0 →
          (star x ⬝ᵥ (carrierPickMatrix (escapeCarrier B tb te) z).mulVec x).re < 0) →
        Module.finrank ℂ W ≤ k + r) ∧
      ∃ z : Fin (k + r) → ℂ,
        (∀ j, 0 < (z j).im) ∧
        (∀ i j, z j ≠ Fin.append tb te i) ∧
        Function.Injective z ∧
        ∀ x : Fin (k + r) → ℂ, x ≠ 0 →
          (star x ⬝ᵥ (carrierPickMatrix (escapeCarrier B tb te) z).mulVec x).re < 0 :=
  add_multiPairCarrier_exact_negativeSquares B (Fin.append tb te) ht htinj hBcont hBpsd

/-! ## Lower semicontinuity of the negative-square index -/

theorem continuous_quadForm_kreinIndexEscapeStratification (n : ℕ) (G : Matrix (Fin n) (Fin n) ℂ) :
    Continuous fun x : Fin n → ℂ => (star x ⬝ᵥ G.mulVec x).re := by
  have h : Continuous fun x : Fin n → ℂ => (star x ⬝ᵥ G.mulVec x) := by
    have hrw : (fun x : Fin n → ℂ => (star x ⬝ᵥ G.mulVec x))
        = fun x => ∑ i, (starRingEnd ℂ) (x i) * ∑ j, G i j * x j := by
      funext x
      simp [dotProduct, Matrix.mulVec, RCLike.star_def]
    rw [hrw]
    fun_prop
  exact Complex.continuous_re.comp h

theorem quadForm_smul_real {n : ℕ} (G : Matrix (Fin n) (Fin n) ℂ) (c : ℝ) (x : Fin n → ℂ) :
    (star ((c : ℂ) • x) ⬝ᵥ G.mulVec ((c : ℂ) • x)).re
      = c ^ (2 : ℕ) * (star x ⬝ᵥ G.mulVec x).re := by
  rw [Matrix.mulVec_smul, star_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul,
    smul_eq_mul, RCLike.star_def, Complex.conj_ofReal]
  rw [← mul_assoc]
  rw [show ((c : ℂ) * (c : ℂ)) = ((c ^ (2 : ℕ) : ℝ) : ℂ) by push_cast; ring]
  rw [Complex.re_ofReal_mul]

/-- On a subspace where the quadratic form of `G₀` is strictly negative it is uniformly
coercive. -/
theorem exists_coercive_bound_on_subspace
    {n : ℕ} (G₀ : Matrix (Fin n) (Fin n) ℂ) (W : Submodule ℂ (Fin n → ℂ))
    (hW : ∀ x ∈ W, x ≠ 0 → (star x ⬝ᵥ G₀.mulVec x).re < 0) :
    ∃ δ > 0, ∀ x ∈ W, (star x ⬝ᵥ G₀.mulVec x).re ≤ -δ * ‖x‖ ^ (2 : ℕ) := by
  classical
  set q : (Fin n → ℂ) → ℝ := fun x => (star x ⬝ᵥ G₀.mulVec x).re with hq
  have hqcont : Continuous q := continuous_quadForm_kreinIndexEscapeStratification n G₀
  set S : Set (Fin n → ℂ) := (W : Set (Fin n → ℂ)) ∩ Metric.sphere 0 1 with hS
  have hWclosed : IsClosed (W : Set (Fin n → ℂ)) := W.closed_of_finiteDimensional
  have hScompact : IsCompact S := (isCompact_sphere (0 : Fin n → ℂ) 1).inter_left hWclosed
  by_cases hSne : S.Nonempty
  · obtain ⟨x₀, hx₀S, hx₀max⟩ := hScompact.exists_isMaxOn hSne hqcont.continuousOn
    have hx₀W : x₀ ∈ W := hx₀S.1
    have hx₀norm : ‖x₀‖ = 1 := by simpa using hx₀S.2
    have hx₀ne : x₀ ≠ 0 := by
      intro h
      rw [h, norm_zero] at hx₀norm
      norm_num at hx₀norm
    have hqneg : q x₀ < 0 := hW x₀ hx₀W hx₀ne
    refine ⟨-q x₀, by linarith, fun x hxW => ?_⟩
    rcases eq_or_ne x 0 with rfl | hx0
    · simp
    · have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
      set u : Fin n → ℂ := ((‖x‖⁻¹ : ℝ) : ℂ) • x with hu
      have huW : u ∈ W := W.smul_mem _ hxW
      have hunorm : ‖u‖ = 1 := by
        rw [hu, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
        field_simp
      have huS : u ∈ S := ⟨huW, by simpa using hunorm⟩
      have hle : q u ≤ q x₀ := hx₀max huS
      have hscale : q u = (‖x‖⁻¹) ^ (2 : ℕ) * q x := by
        rw [hu, hq]
        exact quadForm_smul_real G₀ (‖x‖⁻¹) x
      have hxsq : (0 : ℝ) < ‖x‖ ^ (2 : ℕ) := by positivity
      have : (‖x‖⁻¹) ^ (2 : ℕ) * q x ≤ q x₀ := by rw [← hscale]; exact hle
      have hmul := mul_le_mul_of_nonneg_left this (le_of_lt hxsq)
      have hid : ‖x‖ ^ (2 : ℕ) * ((‖x‖⁻¹) ^ (2 : ℕ) * q x) = q x := by
        field_simp
      rw [hid] at hmul
      nlinarith [hmul]
  · refine ⟨1, one_pos, fun x hxW => ?_⟩
    rcases eq_or_ne x 0 with rfl | hx0
    · simp
    · exfalso
      have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
      refine hSne ⟨((‖x‖⁻¹ : ℝ) : ℂ) • x, W.smul_mem _ hxW, ?_⟩
      simp only [Metric.mem_sphere, dist_zero_right, norm_smul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos (by positivity : (0:ℝ) < ‖x‖⁻¹)]
      field_simp

/-- **Lower semicontinuity `(12)`.**  A negative-definite direction of the limit Pick matrix
survives every sufficiently close approximant: negative squares cannot appear spontaneously in a
compact-open limit, only disappear. -/
theorem eventually_negOn_subspace_of_entrywise_tendsto
    {n : ℕ} {ι : Type*} {l : Filter ι}
    (G : ι → Matrix (Fin n) (Fin n) ℂ) (G₀ : Matrix (Fin n) (Fin n) ℂ)
    (W : Submodule ℂ (Fin n → ℂ))
    (hW : ∀ x ∈ W, x ≠ 0 → (star x ⬝ᵥ G₀.mulVec x).re < 0)
    (hconv : ∀ p q, Tendsto (fun i => G i p q) l (𝓝 (G₀ p q))) :
    ∀ᶠ i in l, ∀ x ∈ W, x ≠ 0 → (star x ⬝ᵥ (G i).mulVec x).re < 0 := by
  obtain ⟨δ, hδ, hcoer⟩ := exists_coercive_bound_on_subspace G₀ W hW
  have hconv' : ∀ ε : ℝ, 0 < ε → ∀ᶠ i in l, ∀ p q, ‖G i p q - G₀ p q‖ ≤ ε := by
    intro ε hε
    rw [Filter.eventually_all]
    intro p
    rw [Filter.eventually_all]
    intro q
    filter_upwards [Metric.tendsto_nhds.mp (hconv p q) ε hε] with i hi
    rw [dist_eq_norm] at hi
    exact hi.le
  have hmod := eventually_quadForm_sub_matrix_le G G₀ hδ hconv'
  filter_upwards [hmod] with i hi x hxW hx0
  have h1 := hi x
  have h2 := hcoer x hxW
  have hxsq : (0 : ℝ) < ‖x‖ ^ (2 : ℕ) := by
    have : 0 < ‖x‖ := norm_pos_iff.mpr hx0
    positivity
  have habs := abs_le.mp h1
  nlinarith [habs.1, habs.2, h2, hxsq, hδ]

/-- Pick-matrix entries depend continuously on the carrier's values at the nodes. -/
theorem tendsto_carrierPickMatrix_entry
    {N : ℕ} {ι : Type*} {l : Filter ι} {f : ι → ℂ → ℂ} {f₀ : ℂ → ℂ} (z : Fin N → ℂ)
    (hconv : ∀ j, Tendsto (fun i => f i (z j)) l (𝓝 (f₀ (z j)))) (p q : Fin N) :
    Tendsto (fun i => carrierPickMatrix (f i) z p q) l (𝓝 (carrierPickMatrix f₀ z p q)) := by
  simp only [carrierPickMatrix, Matrix.of_apply]
  exact ((hconv p).sub (((continuous_star.tendsto _).comp (hconv q)))).div_const _

/-- **Lower semicontinuity at the carrier level.**  If the limit carrier has `k` negative squares
on a node packet, so does every sufficiently close approximant. -/
theorem eventually_carrier_negativeSquares_witness
    {N : ℕ} {ι : Type*} {l : Filter ι} {f : ι → ℂ → ℂ} {f₀ : ℂ → ℂ}
    (z : Fin N → ℂ) (W : Submodule ℂ (Fin N → ℂ))
    (hWneg : ∀ x ∈ W, x ≠ 0 → (star x ⬝ᵥ (carrierPickMatrix f₀ z).mulVec x).re < 0)
    (hconv : ∀ j, Tendsto (fun i => f i (z j)) l (𝓝 (f₀ (z j)))) :
    ∀ᶠ i in l, ∀ x ∈ W, x ≠ 0 →
      (star x ⬝ᵥ (carrierPickMatrix (f i) z).mulVec x).re < 0 :=
  eventually_negOn_subspace_of_entrywise_tendsto _ _ W hWneg
    (fun p q => tendsto_carrierPickMatrix_entry z hconv p q)

/-! ## The continuous-Fredholm obstruction on the escape stratification -/

/-- **The faithful-index escape law.**  A norm-continuous realization of the exact Krein index
cannot exist on a carrier class in which the index jumps by an arbitrary prescribed finite amount
inside every compact-open neighbourhood: the realization at the limit carrier is Fredholm at `0`
with negative and near-zero spectral part of dimension at most `d`, while the escaping carriers
have index `m > d` and eventually lie in the norm ball where the negative index is bounded by
`d`. -/
theorem no_continuous_faithful_krein_index
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    {ι : Type*} {l : Filter ι} [l.NeBot]
    {𝒜 : ι → (H →L[ℂ] H)} {A₀ : H →L[ℂ] H} {ε : ℝ} {d m : ℕ}
    (hA₀ : HasCoerciveComplement A₀ ε d)
    (hcont : Tendsto 𝒜 l (nhds A₀))
    (hm : d < m)
    (hfaithful : ∀ᶠ i in l, ∃ W : Submodule ℂ H, FiniteDimensional ℂ W ∧
      Module.finrank ℂ W = m ∧ ∀ x ∈ W, x ≠ 0 → (inner ℂ x (𝒜 i x) : ℂ).re < 0) :
    False := by
  refine no_faithful_continuous_index_of_unbounded_witness hA₀ hcont ?_
  filter_upwards [hfaithful] with i hi
  obtain ⟨W, hWfin, hWdim, hWneg⟩ := hi
  exact ⟨W, hWfin, by omega, hWneg⟩

end GaloisForLFunctions.HTGeometry
