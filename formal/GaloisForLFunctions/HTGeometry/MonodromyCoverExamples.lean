import GaloisForLFunctions.HTGeometry.OrbifoldMonodromyCover

/-!
# Monodromy covers from finite groups, and an explicit `(2,3,7)` cover

The regular action of a finite group generated by two elements `x`, `y` is a connected
monodromy cover of the `(a,b,c)` sphere orbifold, where `a`, `b`, `c` are the orders of `x`, `y`
and `x·y`.  Freeness is automatic: left translation by a nontrivial element has no fixed point.

Applying this to the two-generator subgroup generated by an explicit `(2,3,7)` triple of
permutations of `Fin 8` — the projective line over `ZMod 7`, on which `x` is `t ↦ −1/t`,
`x·y` is `t ↦ t+1`, so that the generated group is `PSL(2,7)` — produces an unramified connected
cover of the `(2,3,7)` orbifold.  Its degree is `42(2g−2)` by
`MonodromyCover.hurwitz_capacity_exact`; classically it is the Klein quartic, of degree `168`
and genus `3`.
-/

namespace GaloisForLFunctions.HTGeometry

open Equiv Equiv.Perm

section Regular

open scoped Classical

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {a b c : ℕ}

omit [Fintype G] [DecidableEq G] in
/-- Left translation by a group element, as a permutation. -/
theorem toPermHom_apply (g s : G) : (MulAction.toPermHom G G g) s = g * s := rfl

omit [Fintype G] [DecidableEq G] in
/-- Left translation by an element of order `a` is free of order `a`. -/
theorem isFreeOfOrder_toPermHom {x : G} {a : ℕ} (hx : orderOf x = a) :
    IsFreeOfOrder (MulAction.toPermHom G G x) a where
  pow_eq_one := by
    rw [← map_pow, ← hx, pow_orderOf_eq_one]
    exact map_one _
  free := by
    intro k hk0 hka s hs
    rw [← map_pow, toPermHom_apply] at hs
    have hxk : x ^ k ≠ 1 := pow_ne_one_of_lt_orderOf (by omega) (by omega)
    have hs' : x ^ k * s = 1 * s := by rw [one_mul]; exact hs
    exact hxk (mul_right_cancel hs')

/-- **The regular cover.**  A finite group generated by `x` and `y` gives a connected unramified
cover of the `(a,b,c)` sphere orbifold, of degree the order of the group. -/
noncomputable def regularCover (x y : G) (ha : orderOf x = a) (hb : orderOf y = b)
    (hc : orderOf (x * y) = c) (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) :
    MonodromyCover a b c G where
  X := MulAction.toPermHom G G x
  Y := MulAction.toPermHom G G y
  freeX := isFreeOfOrder_toPermHom ha
  freeY := isFreeOfOrder_toPermHom hb
  freeZ := by
    have : MulAction.toPermHom G G x * MulAction.toPermHom G G y
        = MulAction.toPermHom G G (x * y) := (map_mul _ _ _).symm
    rw [this]
    exact isFreeOfOrder_toPermHom hc
  transitive := by
    intro s t
    refine ⟨MulAction.toPermHom G G (t * s⁻¹), ?_, by simp [mul_assoc]⟩
    have hmem : t * s⁻¹ ∈ Subgroup.closure ({x, y} : Set G) := by rw [hgen]; trivial
    have himg : Subgroup.map (MulAction.toPermHom G G) (Subgroup.closure ({x, y} : Set G))
        = Subgroup.closure ((MulAction.toPermHom G G) '' ({x, y} : Set G)) :=
      MonoidHom.map_closure _ _
    have : MulAction.toPermHom G G (t * s⁻¹) ∈
        Subgroup.map (MulAction.toPermHom G G) (Subgroup.closure ({x, y} : Set G)) :=
      ⟨t * s⁻¹, hmem, rfl⟩
    rw [himg] at this
    refine Subgroup.closure_mono ?_ this
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with hg | hg
    · exact Or.inl (by rw [hg])
    · exact Or.inr (by simp at hg; rw [hg]; rfl)

end Regular

section Triple

variable {G : Type*} [Group G] [Fintype G] [DecidableEq G] {a b c : ℕ}

/-- The two-generator subgroup generated by a pair. -/
def pairSubgroup (x y : G) : Subgroup G := Subgroup.closure ({x, y} : Set G)

/-- The subgroup generated by two elements of a finite group is finite. -/
noncomputable instance pairSubgroupFintype (x y : G) : Fintype ↥(pairSubgroup x y) :=
  Fintype.ofFinite _

omit [Fintype G] [DecidableEq G] in
theorem mem_pairSubgroup_left (x y : G) : x ∈ pairSubgroup x y :=
  Subgroup.subset_closure (Or.inl rfl)

omit [Fintype G] [DecidableEq G] in
theorem mem_pairSubgroup_right (x y : G) : y ∈ pairSubgroup x y :=
  Subgroup.subset_closure (Or.inr rfl)

omit [Fintype G] [DecidableEq G] in
/-- Inside the subgroup they generate, the pair generates everything. -/
theorem closure_pair_coe_eq_top (x y : G) :
    Subgroup.closure ({⟨x, mem_pairSubgroup_left x y⟩, ⟨y, mem_pairSubgroup_right x y⟩} :
      Set ↥(pairSubgroup x y)) = ⊤ := by
  let K := pairSubgroup x y
  let T : Set ↥K := {⟨x, mem_pairSubgroup_left x y⟩, ⟨y, mem_pairSubgroup_right x y⟩}
  have himg : Subgroup.map K.subtype (Subgroup.closure T)
      = Subgroup.closure (K.subtype '' T) := MonoidHom.map_closure _ _
  have hset : K.subtype '' T = ({x, y} : Set G) := by
    ext z
    constructor
    · rintro ⟨w, hw, rfl⟩
      rcases hw with hw | hw
      · exact Or.inl (by rw [hw]; rfl)
      · simp only [Set.mem_singleton_iff] at hw
        exact Or.inr (by rw [hw]; rfl)
    · rintro (rfl | hz)
      · exact ⟨⟨z, mem_pairSubgroup_left z y⟩, Or.inl rfl, rfl⟩
      · simp only [Set.mem_singleton_iff] at hz
        exact ⟨⟨y, mem_pairSubgroup_right x y⟩, Or.inr rfl, by rw [hz]; rfl⟩
  have h1 : Subgroup.map K.subtype (Subgroup.closure T) = K := by
    rw [himg, hset]
    rfl
  have h2 : Subgroup.map K.subtype ⊤ = K := by
    rw [← MonoidHom.range_eq_map, K.range_subtype]
  have hinj : Function.Injective (Subgroup.map K.subtype) :=
    Subgroup.map_injective (Subgroup.subtype_injective K)
  exact hinj (h1.trans h2.symm)

/-- **Cover from a triple.**  Any pair `x`, `y` in a finite group with prescribed orders of
`x`, `y`, `x·y` produces a connected unramified cover of the `(a,b,c)` orbifold: the regular
action of the subgroup they generate. -/
noncomputable def coverOfTriple (x y : G) (ha : orderOf x = a) (hb : orderOf y = b)
    (hc : orderOf (x * y) = c) : MonodromyCover a b c ↥(pairSubgroup x y) := by
  classical
  refine regularCover (⟨x, mem_pairSubgroup_left x y⟩ : ↥(pairSubgroup x y))
    ⟨y, mem_pairSubgroup_right x y⟩ ?_ ?_ ?_ (closure_pair_coe_eq_top x y)
  · rw [← ha]
    exact (Subgroup.orderOf_coe (⟨x, mem_pairSubgroup_left x y⟩ : ↥(pairSubgroup x y))).symm
  · rw [← hb]
    exact (Subgroup.orderOf_coe (⟨y, mem_pairSubgroup_right x y⟩ : ↥(pairSubgroup x y))).symm
  · rw [← hc]
    have hxy : ((⟨x, mem_pairSubgroup_left x y⟩ : ↥(pairSubgroup x y)) *
        ⟨y, mem_pairSubgroup_right x y⟩ : ↥(pairSubgroup x y)) = ⟨x * y,
          Subgroup.mul_mem _ (mem_pairSubgroup_left x y) (mem_pairSubgroup_right x y)⟩ := rfl
    rw [hxy]
    exact (Subgroup.orderOf_coe (⟨x * y,
      Subgroup.mul_mem _ (mem_pairSubgroup_left x y)
        (mem_pairSubgroup_right x y)⟩ : ↥(pairSubgroup x y))).symm

end Triple

section Explicit237

/-- `t ↦ −1/t` on the projective line over `ZMod 7`, with `∞` labelled `7`. -/
def hurwitzX : Perm (Fin 8) :=
  c[(0 : Fin 8), 7] * c[(1 : Fin 8), 6] * c[(2 : Fin 8), 3] * c[(4 : Fin 8), 5]

/-- `t ↦ t + 1` on the projective line over `ZMod 7`. -/
def hurwitzZ : Perm (Fin 8) := c[(0 : Fin 8), 1, 2, 3, 4, 5, 6]

/-- The order-three factor of the `(2,3,7)` triple. -/
def hurwitzY : Perm (Fin 8) := hurwitzX * hurwitzZ

set_option maxRecDepth 40000 in
theorem hurwitzX_sq : hurwitzX ^ 2 = 1 := by decide

set_option maxRecDepth 40000 in
theorem hurwitzX_ne_one : hurwitzX ≠ 1 := by decide

set_option maxRecDepth 40000 in
theorem hurwitzY_cube : hurwitzY ^ 3 = 1 := by decide

set_option maxRecDepth 40000 in
theorem hurwitzY_ne_one : hurwitzY ≠ 1 := by decide

set_option maxRecDepth 40000 in
theorem hurwitzXY_pow : (hurwitzX * hurwitzY) ^ 7 = 1 := by decide

set_option maxRecDepth 40000 in
theorem hurwitzXY_ne_one : hurwitzX * hurwitzY ≠ 1 := by decide

theorem orderOf_hurwitzX : orderOf hurwitzX = 2 :=
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  orderOf_eq_prime hurwitzX_sq hurwitzX_ne_one

theorem orderOf_hurwitzY : orderOf hurwitzY = 3 :=
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  orderOf_eq_prime hurwitzY_cube hurwitzY_ne_one

theorem orderOf_hurwitzXY : orderOf (hurwitzX * hurwitzY) = 7 :=
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  orderOf_eq_prime hurwitzXY_pow hurwitzXY_ne_one

/-- **An explicit connected unramified cover of the `(2,3,7)` orbifold.** -/
noncomputable def hurwitzBaseCover :
    MonodromyCover 2 3 7 ↥(pairSubgroup hurwitzX hurwitzY) :=
  coverOfTriple hurwitzX hurwitzY orderOf_hurwitzX orderOf_hurwitzY orderOf_hurwitzXY

/-- The explicit cover saturates the Hurwitz capacity law with an integral genus. -/
theorem hurwitzBaseCover_capacity :
    ∃ g : ℤ, (hurwitzBaseCover.degree : ℤ) = 42 * (2 * g - 2) := by
  obtain ⟨g, _, h⟩ := hurwitzBaseCover.hurwitz_capacity_exact
  exact ⟨g, h⟩

end Explicit237

end GaloisForLFunctions.HTGeometry
