import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicBaseChange
import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape
import GaloisForLFunctions.HTGeometry.FiniteAbscissaRationalCoordinateIndependence
import GaloisForLFunctions.HTGeometry.UpperEndConstantField
import GaloisForLFunctions.HTGeometry.UpperEndRationalGauge

/-!
# The upper-end rational coordinate as a differential adjunction

The actual upper-end copy of `C(z)` is the differential field generated by its coordinate.  This
closes the base-change interface between upper-end Dirichlet hypertranscendence and differential
automorphism arguments over the constants.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Polynomial
open scoped Differential

noncomputable section

local instance upperEndRationalAdjoinDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance upperEndRationalAdjoinComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance upperEndRationalAdjoinDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance upperEndRationalAdjoinComplexDifferential : Differential ℂ where
  deriv := 0

local instance upperEndRationalAdjoinDifferentialAlgebra :
    DifferentialAlgebra ℂ upperEndMeroField :=
  ⟨fun c ↦ by
    rw [upperEndMero_deriv_complexConstant c]
    change (0 : upperEndMeroField) = algebraMap ℂ upperEndMeroField 0
    rw [map_zero]⟩

/-- The genuine upper-end coordinate satisfies the exact value-jet relation `z' = 1`. -/
theorem upperEndCoordinateMero_deriv :
    (upperEndCoordinateMero)′ = algebraMap ℂ upperEndMeroField 1 := by
  rw [upperEndCoordinateMero, upperEndMero_deriv_polyEval]
  simp

/-- The actual upper-end rational coordinate field is closed under differentiation. -/
theorem upperEndRationalCoordinateField_derivationClosed :
    DerivationClosed upperEndRationalCoordinateField := by
  change DerivationClosed
    (IntermediateField.adjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField))
  rw [show ({upperEndCoordinateMero} : Set upperEndMeroField) =
      Set.range (fun _ : Unit ↦ upperEndCoordinateMero) by ext x; simp]
  apply derivationClosed_adjoin_range_of_deriv_mem
  intro i
  cases i
  rw [upperEndCoordinateMero_deriv]
  exact IntermediateField.algebraMap_mem _ 1

/-- The upper-end coordinate is differentially algebraic over the complex constants. -/
theorem differentialAlgebraicOver_upperEndCoordinateMero :
    DifferentialAlgebraicOver ℂ upperEndCoordinateMero := by
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hindependent
  rw [algebraicIndependent_iff] at hindependent
  let P : MvPolynomial (Unit × ℕ) ℂ :=
    MvPolynomial.X ((), 1) - MvPolynomial.C 1
  have hrelation : MvPolynomial.aeval
      (fun p : Unit × ℕ ↦ differentialJet p.2 upperEndCoordinateMero) P = 0 := by
    simp [P, differentialJet_succ, upperEndCoordinateMero_deriv]
  have hzero : P = 0 := hindependent P hrelation
  have heval := congrArg
    (MvPolynomial.eval (fun _ : Unit × ℕ ↦ (0 : ℂ))) hzero
  simp [P] at heval

/-- The embedded upper-end rational function field is exactly the differential field generated by
the coordinate germ. -/
theorem differentialAdjoin_upperEndCoordinateMero_eq :
    differentialAdjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField) =
      upperEndRationalCoordinateField := by
  change differentialAdjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField) =
    IntermediateField.adjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField)
  apply le_antisymm
  · exact differentialAdjoin_le ℂ
      (IntermediateField.subset_adjoin ℂ _) upperEndRationalCoordinateField_derivationClosed
  · apply IntermediateField.adjoin_le_iff.mpr
    exact subset_differentialAdjoin ℂ _

/-- Every genuine upper-end rational coordinate gauge is differentially algebraic over `C`. -/
theorem differentialAlgebraicOver_upperEndRationalCoordinate
    (r : upperEndRationalCoordinateField) :
    DifferentialAlgebraicOver ℂ (r : upperEndMeroField) := by
  apply differentialAlgebraicOver_of_mem_finiteGeneratorState
    (s := fun _ : Unit ↦ upperEndCoordinateMero)
  · intro i
    cases i
    rw [upperEndCoordinateMero_deriv]
    exact IntermediateField.algebraMap_mem _ 1
  · simpa [upperEndRationalCoordinateField] using r.2

end

end GaloisForLFunctions.HTGeometry
