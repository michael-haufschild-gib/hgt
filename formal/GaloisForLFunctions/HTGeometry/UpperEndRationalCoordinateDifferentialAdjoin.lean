import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicBaseChange
import GaloisForLFunctions.HTGeometry.DifferentialSemilinearAutomorphism
import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape
import GaloisForLFunctions.HTGeometry.FiniteAbscissaRationalCoordinateIndependence
import GaloisForLFunctions.HTGeometry.UpperEndConstantField
import GaloisForLFunctions.HTGeometry.UpperEndRationalGauge
import Mathlib.Algebra.CharP.Algebra

/-!
# The upper-end rational coordinate as a differential adjunction

The actual upper-end copy of `C(z)` is the differential field generated by its coordinate.  This
closes the base-change interface between upper-end Dirichlet hypertranscendence and differential
automorphism arguments over the constants, and makes relative DA/HT over arbitrary translated
observation fields exactly covariant.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Polynomial
open scoped Differential

noncomputable section

local instance upperEndRationalAdjoinDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance upperEndRationalAdjoinComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance upperEndRationalAdjoinCharZero : CharZero upperEndMeroField :=
  charZero_of_injective_ringHom upperEndComplexToMero.injective

local instance upperEndRationalAdjoinDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance upperEndRationalAdjoinComplexDifferential : Differential ℂ where
  deriv := 0

local instance upperEndRationalAdjoinDifferentialAlgebra :
    DifferentialAlgebra ℂ upperEndMeroField :=
  ⟨fun c ↦ by
    rw [upperEndMero_deriv_complexConstant c]
    change (0 : upperEndMeroField) = algebraMap ℂ upperEndMeroField 0
    rw [map_zero]⟩

/-- Every upper-end translation is a differential automorphism over the complex constants. -/
noncomputable def upperEndTranslationMeroDifferentialAlgEquiv (h : ℂ) :
    DifferentialAlgEquiv ℂ upperEndMeroField where
  toAlgEquiv :=
    { toRingEquiv := upperEndTranslationMeroEquiv h
      commutes' := fun c ↦ by
        change upperEndTranslationMeroEquiv h (upperEndComplexToMero c) =
          upperEndComplexToMero c
        change upperEndTranslationMeroEquiv h
            (algebraMap upperEndAnalyticSubring upperEndMeroField
              (upperEndPolyToAnalytic (Polynomial.C c))) =
          algebraMap upperEndAnalyticSubring upperEndMeroField
            (upperEndPolyToAnalytic (Polynomial.C c))
        rw [upperEndTranslationMeroEquiv_algebraMap]
        congr 1
        apply Subtype.ext
        change upperEndTranslateGerm h
            ((fun z : ℂ => (Polynomial.C c).eval z) : Filter.Germ upperEndFilter ℂ) =
          ((fun z : ℂ => (Polynomial.C c).eval z) : Filter.Germ upperEndFilter ℂ)
        rw [upperEndTranslateGerm_coe]
        apply Filter.Germ.coe_eq.mpr
        exact Filter.Eventually.of_forall fun z ↦ by simp }
  map_deriv' x := by
    simpa using upperEndTranslationMeroEquiv_deriv h x

/-- The genuine upper-end coordinate satisfies the exact value-jet relation `z' = 1`. -/
theorem upperEndCoordinateMero_deriv :
    (upperEndCoordinateMero)′ = algebraMap ℂ upperEndMeroField 1 := by
  rw [upperEndCoordinateMero, upperEndMero_deriv_polyEval]
  simp

/-- Upper-end translation acts affinely on the genuine rational coordinate. -/
theorem upperEndTranslationMeroEquiv_coordinate (h : ℂ) :
    upperEndTranslationMeroEquiv h upperEndCoordinateMero =
      upperEndCoordinateMero + algebraMap ℂ upperEndMeroField h := by
  rw [upperEndCoordinateMero_eq_algebraMap,
    upperEndTranslationMeroEquiv_algebraMap]
  rw [show algebraMap ℂ upperEndMeroField h =
      algebraMap upperEndAnalyticSubring upperEndMeroField
        (upperEndPolyToAnalytic (Polynomial.C h)) by rfl, ← map_add]
  congr 1
  apply Subtype.ext
  rw [upperEndTranslationAnalyticEquiv_coe, upperEndCoordinateAnalytic_coe]
  change upperEndTranslateGerm h
      ((fun z : ℂ => z) : Filter.Germ upperEndFilter ℂ) =
    (upperEndCoordinateAnalytic : Filter.Germ upperEndFilter ℂ) +
      (upperEndPolyToAnalytic (Polynomial.C h) :
        Filter.Germ upperEndFilter ℂ)
  rw [upperEndCoordinateAnalytic_coe]
  have hpoly :
      (upperEndPolyToAnalytic (Polynomial.C h) :
          Filter.Germ upperEndFilter ℂ) =
        ((fun _ : ℂ => h) : Filter.Germ upperEndFilter ℂ) := by
    change ((fun z : ℂ => (Polynomial.C h).eval z) :
        Filter.Germ upperEndFilter ℂ) = _
    apply Filter.Germ.coe_eq.mpr
    exact Filter.Eventually.of_forall fun z => by simp
  rw [hpoly]
  change upperEndTranslateGerm h
      ((fun z : ℂ => z) : Filter.Germ upperEndFilter ℂ) =
    ((fun z : ℂ => z) : Filter.Germ upperEndFilter ℂ) +
      ((fun _ : ℂ => h) : Filter.Germ upperEndFilter ℂ)
  rw [upperEndTranslateGerm_coe]
  rfl

/-- Every upper-end translation maps the genuine rational-coordinate field onto itself. -/
theorem upperEndRationalCoordinateField_map_translation (h : ℂ) :
    upperEndRationalCoordinateField.map
        (upperEndTranslationMeroDifferentialAlgEquiv h).toAlgEquiv.toAlgHom =
      upperEndRationalCoordinateField := by
  change (IntermediateField.adjoin ℂ
      ({upperEndCoordinateMero} : Set upperEndMeroField)).map
        (upperEndTranslationMeroDifferentialAlgEquiv h).toAlgEquiv.toAlgHom =
    IntermediateField.adjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField)
  rw [IntermediateField.adjoin_map, Set.image_singleton]
  change IntermediateField.adjoin ℂ
      ({upperEndTranslationMeroEquiv h upperEndCoordinateMero} :
        Set upperEndMeroField) = _
  rw [upperEndTranslationMeroEquiv_coordinate]
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact (IntermediateField.adjoin ℂ
      ({upperEndCoordinateMero} : Set upperEndMeroField)).add_mem
        (IntermediateField.subset_adjoin ℂ _ (Set.mem_singleton _))
        (IntermediateField.algebraMap_mem _ h)
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    have hsum : upperEndCoordinateMero + algebraMap ℂ upperEndMeroField h ∈
        IntermediateField.adjoin ℂ
          ({upperEndCoordinateMero + algebraMap ℂ upperEndMeroField h} :
            Set upperEndMeroField) :=
      IntermediateField.subset_adjoin ℂ _ (Set.mem_singleton _)
    have hc : algebraMap ℂ upperEndMeroField h ∈
        IntermediateField.adjoin ℂ
          ({upperEndCoordinateMero + algebraMap ℂ upperEndMeroField h} :
            Set upperEndMeroField) :=
      IntermediateField.algebraMap_mem _ h
    simpa only [add_sub_cancel_right] using
      (IntermediateField.adjoin ℂ
        ({upperEndCoordinateMero + algebraMap ℂ upperEndMeroField h} :
          Set upperEndMeroField)).sub_mem hsum hc

/-- Translation restricted to the embedded upper-end rational-coordinate field. -/
noncomputable def upperEndRationalCoordinateTranslationAlgEquiv (h : ℂ) :
    upperEndRationalCoordinateField ≃ₐ[ℂ]
      upperEndRationalCoordinateField :=
  (IntermediateField.equivMap upperEndRationalCoordinateField
      (upperEndTranslationMeroDifferentialAlgEquiv h).toAlgEquiv).trans
    (IntermediateField.equivOfEq
      (upperEndRationalCoordinateField_map_translation h))

@[simp]
theorem upperEndRationalCoordinateTranslationAlgEquiv_apply (h : ℂ)
    (x : upperEndRationalCoordinateField) :
    ((upperEndRationalCoordinateTranslationAlgEquiv h x :
        upperEndRationalCoordinateField) : upperEndMeroField) =
      upperEndTranslationMeroEquiv h (x : upperEndMeroField) := by
  rfl

/-- Every embedded rational function belongs to the intermediate field generated by the actual
upper-end coordinate. -/
theorem upperEndRatfuncToMero_mem_rationalCoordinateField (r : RatFunc ℂ) :
    upperEndRatfuncToMero r ∈ upperEndRationalCoordinateField := by
  have hr : r ∈ IntermediateField.adjoin ℂ ({RatFunc.X} : Set (RatFunc ℂ)) := by
    rw [RatFunc.adjoin_X]
    trivial
  apply IntermediateField.adjoin_induction ℂ
    (s := ({RatFunc.X} : Set (RatFunc ℂ)))
    (p := fun q _ ↦ upperEndRatfuncToMero q ∈ upperEndRationalCoordinateField)
  · intro q hq
    simp only [Set.mem_singleton_iff] at hq
    subst q
    change upperEndRatfuncToMero
        (algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X) ∈ _
    rw [upperEndRatfuncToMero_algebraMap_polynomial]
    exact IntermediateField.subset_adjoin ℂ _ rfl
  · intro c
    rw [upperEnd_ratfunc_algebraMap_complex]
    exact IntermediateField.algebraMap_mem _ c
  · intro a b _ _ ha hb
    rw [map_add]
    exact upperEndRationalCoordinateField.add_mem ha hb
  · intro a _ ha
    rw [map_inv₀]
    exact upperEndRationalCoordinateField.inv_mem ha
  · intro a b _ _ ha hb
    rw [map_mul]
    exact upperEndRationalCoordinateField.mul_mem ha hb
  exact hr

/-- Faithful realization of the abstract rational-function field inside the concrete upper-end
rational-coordinate intermediate field. -/
noncomputable def upperEndRatfuncToRationalCoordinateField :
    RatFunc ℂ →+* upperEndRationalCoordinateField :=
  upperEndRatfuncToMero.codRestrict upperEndRationalCoordinateField
    upperEndRatfuncToMero_mem_rationalCoordinateField

@[simp]
theorem upperEndRatfuncToRationalCoordinateField_coe (r : RatFunc ℂ) :
    (upperEndRatfuncToRationalCoordinateField r : upperEndMeroField) =
      upperEndRatfuncToMero r :=
  rfl

/-- The actual upper-end rational coordinate field is closed under differentiation. -/
theorem upperEndRationalCoordinateField_derivationClosed :
    DerivationClosed upperEndRationalCoordinateField := by
  change DerivationClosed
    (IntermediateField.adjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField))
  rw [show ({upperEndCoordinateMero} : Set upperEndMeroField) =
      Set.range (fun _ : Unit ↦ upperEndCoordinateMero) by ext x; simp]
  apply derivationClosed_adjoin_range_of_deriv_mem
  intro i
  cases i
  rw [upperEndCoordinateMero_deriv]
  exact IntermediateField.algebraMap_mem _ 1

local instance upperEndRationalCoordinateDifferentialAdjoinBaseDifferential :
    Differential upperEndRationalCoordinateField :=
  derivationClosedDifferential _ upperEndRationalCoordinateField_derivationClosed

local instance upperEndRationalCoordinateDifferentialAdjoinBaseAlgebra :
    DifferentialAlgebra upperEndRationalCoordinateField upperEndMeroField :=
  ⟨fun x => derivationClosedDifferential_apply
    upperEndRationalCoordinateField
    upperEndRationalCoordinateField_derivationClosed x⟩

/-- Upper-end translation is a differential semilinear automorphism over the normalized
rational-coordinate field. -/
noncomputable def upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv
    (h : ℂ) :
    DifferentialSemilinearEquiv
      upperEndRationalCoordinateField upperEndMeroField where
  baseEquiv := (upperEndRationalCoordinateTranslationAlgEquiv h).toRingEquiv
  ambientEquiv := upperEndTranslationMeroEquiv h
  map_algebraMap' x :=
    (upperEndRationalCoordinateTranslationAlgEquiv_apply h x).symm
  map_base_deriv' x := by
    apply Subtype.ext
    change upperEndTranslationMeroEquiv h
        (Differential.deriv (x : upperEndMeroField)) =
      Differential.deriv
        (upperEndTranslationMeroEquiv h (x : upperEndMeroField))
    exact upperEndTranslationMeroEquiv_deriv h x
  map_ambient_deriv' x := upperEndTranslationMeroEquiv_deriv h x

/-- Upper-end translation transports every generated differential field exactly, even though it
acts nontrivially on the normalized rational-coordinate base. -/
theorem upperEndTranslationMeroEquiv_map_differentialAdjoin
    (h : ℂ) (s : Set upperEndMeroField) :
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h).mapIntermediateField
        (differentialAdjoin upperEndRationalCoordinateField s) =
      differentialAdjoin upperEndRationalCoordinateField
        (upperEndTranslationMeroEquiv h '' s) :=
  DifferentialSemilinearEquiv.mapIntermediateField_differentialAdjoin
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) s

/-- Common upper-end translation preserves the complete represented differential matroid over
the actual rational-coordinate base. -/
theorem upperEndTranslationMeroEquiv_differentialFamilyMatroid_eq
    {ι : Type*} (h : ℂ) (x : ι → upperEndMeroField) :
    differentialFamilyMatroid (F := upperEndRationalCoordinateField)
        (fun i => upperEndTranslationMeroEquiv h (x i)) =
      differentialFamilyMatroid (F := upperEndRationalCoordinateField) x :=
  DifferentialSemilinearEquiv.differentialFamilyMatroid_map_eq
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) x

/-- Upper-end translation preserves differential algebraicity exactly over the normalized
rational-coordinate base. -/
theorem differentialAlgebraicOver_upperEndTranslationMeroEquiv_iff
    (h : ℂ) (x : upperEndMeroField) :
    DifferentialAlgebraicOver upperEndRationalCoordinateField
        (upperEndTranslationMeroEquiv h x) ↔
      DifferentialAlgebraicOver upperEndRationalCoordinateField x :=
  DifferentialSemilinearEquiv.differentialAlgebraicOver_map_iff
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) x

/-- Upper-end translation preserves hypertranscendence exactly over the normalized rational
coordinate base. -/
theorem hypertranscendentalOver_upperEndTranslationMeroEquiv_iff
    (h : ℂ) (x : upperEndMeroField) :
    HypertranscendentalOver upperEndRationalCoordinateField
        (upperEndTranslationMeroEquiv h x) ↔
      HypertranscendentalOver upperEndRationalCoordinateField x :=
  DifferentialSemilinearEquiv.hypertranscendentalOver_map_iff
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) x

/-- **Relative upper-end translation covariance.** Translation preserves hypertranscendence over
an arbitrary generated observation field when both the observation set and tested value are
translated. The observation set need not be differentially independent. -/
theorem hypertranscendentalOver_upperEndTranslationMeroEquiv_differentialAdjoin_image_iff
    (h : ℂ) (s : Set upperEndMeroField) (x : upperEndMeroField) :
    HypertranscendentalOver
        (differentialAdjoin upperEndRationalCoordinateField
          (upperEndTranslationMeroEquiv h '' s))
        (upperEndTranslationMeroEquiv h x) ↔
      HypertranscendentalOver
        (differentialAdjoin upperEndRationalCoordinateField s) x :=
  DifferentialSemilinearEquiv.hypertranscendentalOver_differentialAdjoin_image_iff
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) s x

/-- Relative differential algebraicity over arbitrary upper-end observation fields is likewise
preserved by common translation. -/
theorem differentialAlgebraicOver_upperEndTranslationMeroEquiv_differentialAdjoin_image_iff
    (h : ℂ) (s : Set upperEndMeroField) (x : upperEndMeroField) :
    DifferentialAlgebraicOver
        (differentialAdjoin upperEndRationalCoordinateField
          (upperEndTranslationMeroEquiv h '' s))
        (upperEndTranslationMeroEquiv h x) ↔
      DifferentialAlgebraicOver
        (differentialAdjoin upperEndRationalCoordinateField s) x :=
  DifferentialSemilinearEquiv.differentialAlgebraicOver_differentialAdjoin_image_iff
    (upperEndRationalCoordinateTranslationDifferentialSemilinearEquiv h) s x

/-- The upper-end coordinate is differentially algebraic over the complex constants. -/
theorem differentialAlgebraicOver_upperEndCoordinateMero :
    DifferentialAlgebraicOver ℂ upperEndCoordinateMero := by
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hindependent
  rw [algebraicIndependent_iff] at hindependent
  let P : MvPolynomial (Unit × ℕ) ℂ :=
    MvPolynomial.X ((), 1) - MvPolynomial.C 1
  have hderivZero :
      (upperEndCoordinateMero)′ - algebraMap ℂ upperEndMeroField 1 = 0 :=
    sub_eq_zero.mpr upperEndCoordinateMero_deriv
  have hrelation : MvPolynomial.aeval
      (fun p : Unit × ℕ ↦ differentialJet p.2 upperEndCoordinateMero) P = 0 := by
    simpa [P, differentialJet_succ] using hderivZero
  have hzero : P = 0 := hindependent P hrelation
  have heval := congrArg
    (MvPolynomial.eval (fun _ : Unit × ℕ ↦ (0 : ℂ))) hzero
  simp [P] at heval

/-- The embedded upper-end rational function field is exactly the differential field generated by
the coordinate germ. -/
theorem differentialAdjoin_upperEndCoordinateMero_eq :
    differentialAdjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField) =
      upperEndRationalCoordinateField := by
  change differentialAdjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField) =
    IntermediateField.adjoin ℂ ({upperEndCoordinateMero} : Set upperEndMeroField)
  apply le_antisymm
  · exact differentialAdjoin_le ℂ
      (IntermediateField.subset_adjoin ℂ _) upperEndRationalCoordinateField_derivationClosed
  · apply IntermediateField.adjoin_le_iff.mpr
    exact subset_differentialAdjoin ℂ _

/-- Every genuine upper-end rational coordinate gauge is differentially algebraic over `C`. -/
theorem differentialAlgebraicOver_upperEndRationalCoordinate
    (r : upperEndRationalCoordinateField) :
    DifferentialAlgebraicOver ℂ (r : upperEndMeroField) := by
  apply differentialAlgebraicOver_of_mem_finiteGeneratorState
    (s := fun _ : Unit ↦ upperEndCoordinateMero)
  · intro i
    cases i
    rw [upperEndCoordinateMero_deriv]
    exact IntermediateField.algebraMap_mem _ 1
  · rw [show Set.range (fun _ : Unit ↦ upperEndCoordinateMero) =
        ({upperEndCoordinateMero} : Set upperEndMeroField) by
      ext x
      simp]
    exact r.2

end

end GaloisForLFunctions.HTGeometry
