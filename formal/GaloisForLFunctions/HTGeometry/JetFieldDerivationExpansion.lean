import GaloisForLFunctions.HTGeometry.FreeDifferentialJetField

/-!
# Coordinate expansion of derivations of the free differential field

Every derivation of the free differential rational field is determined by its values on the jet
coordinates, through the chain rule

`D u = ∑ₚ (∂u/∂xₚ) • D xₚ`,

the sum being finite: it may be taken over any finite set of coordinates outside of which all
partial derivatives of `u` vanish.

The proof compares `D` with the coordinate combination on the subalgebra generated by a finite
set of coordinates — two derivations agree on the subalgebra generated by a set on which they
agree — and then extends to fractions by the quotient rule.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace JetField

noncomputable section

universe w

variable {C : Type u} {ι : Type v} [Field C]
variable {M : Type w} [AddCommGroup M] [Module (JetField C ι) M] [Module C M]
  [IsScalarTower C (JetField C ι) M]

/-- The subalgebra on which two derivations agree. -/
def derivationEqualizer (D₁ D₂ : Derivation C (JetField C ι) M) :
    Subalgebra C (JetField C ι) where
  carrier := {a | D₁ a = D₂ a}
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [Derivation.leibniz, Derivation.leibniz, ha, hb]
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [map_add, map_add, ha, hb]
  algebraMap_mem' := by
    intro c
    simp only [Set.mem_setOf_eq]
    rw [Derivation.map_algebraMap, Derivation.map_algebraMap]

omit [IsScalarTower C (JetField C ι) M] in
theorem mem_derivationEqualizer {D₁ D₂ : Derivation C (JetField C ι) M} {u : JetField C ι} :
    u ∈ derivationEqualizer D₁ D₂ ↔ D₁ u = D₂ u := Iff.rfl

/-- The algebra map of the free differential field is evaluation at the jet coordinates. -/
theorem algebraMap_eq_aeval (a : JetPoly C ι) :
    algebraMap (JetPoly C ι) (JetField C ι) a
      = MvPolynomial.aeval (fun p : ι × ℕ => (jet p : JetField C ι)) a := by
  have h : (IsScalarTower.toAlgHom C (JetPoly C ι) (JetField C ι))
      = MvPolynomial.aeval (fun p : ι × ℕ => (jet p : JetField C ι)) := by
    refine MvPolynomial.algHom_ext fun p => ?_
    rw [MvPolynomial.aeval_X]
    rfl
  exact congrArg (fun f : JetPoly C ι →ₐ[C] JetField C ι => f a) h

omit [IsScalarTower C (JetField C ι) M] in
/-- Two derivations of the free differential field that agree on a set of coordinates agree on
every polynomial in those coordinates. -/
theorem eq_of_eqOn_coords {D₁ D₂ : Derivation C (JetField C ι) M} {s : Set (ι × ℕ)}
    (h : ∀ p ∈ s, D₁ (jet p) = D₂ (jet p)) {a : JetPoly C ι} (ha : ↑a.vars ⊆ s) :
    D₁ (algebraMap (JetPoly C ι) (JetField C ι) a)
      = D₂ (algebraMap (JetPoly C ι) (JetField C ι) a) := by
  have hmemsup : a ∈ MvPolynomial.supported C s := MvPolynomial.mem_supported.mpr ha
  rw [MvPolynomial.supported_eq_adjoin_X] at hmemsup
  have himg : MvPolynomial.aeval (fun p : ι × ℕ => (jet p : JetField C ι)) a
      ∈ derivationEqualizer D₁ D₂ := by
    have hsub : Algebra.adjoin C (MvPolynomial.X '' s) ≤
        (derivationEqualizer D₁ D₂).comap
          (MvPolynomial.aeval (fun p : ι × ℕ => (jet p : JetField C ι))) := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨p, hp, rfl⟩
      have hmem : MvPolynomial.aeval (fun q : ι × ℕ => (jet q : JetField C ι))
          (MvPolynomial.X p : JetPoly C ι) ∈ derivationEqualizer D₁ D₂ := by
        rw [MvPolynomial.aeval_X]
        exact mem_derivationEqualizer.mpr (h p hp)
      exact hmem
    exact hsub hmemsup
  rw [algebraMap_eq_aeval]
  exact himg

/-- The coordinate combination `a ↦ ∑ₚ (∂a/∂xₚ) • D xₚ` attached to a finite set of
coordinates. -/
def coordDerivation (D : Derivation C (JetField C ι) M) (s : Finset (ι × ℕ)) :
    Derivation C (JetField C ι) M :=
  ∑ p ∈ s, (LinearMap.toSpanSingleton (JetField C ι) M (D (jet p))).compDer (pd p)

theorem coordDerivation_apply (D : Derivation C (JetField C ι) M) (s : Finset (ι × ℕ))
    (u : JetField C ι) :
    coordDerivation D s u = ∑ p ∈ s, (pd p u) • D (jet p) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [coordDerivation]
  | insert p s hp ih =>
    rw [coordDerivation, Finset.sum_insert hp, Finset.sum_insert hp, ← ih]
    rfl

theorem coordDerivation_jet (D : Derivation C (JetField C ι) M) (s : Finset (ι × ℕ))
    {q : ι × ℕ} (hq : q ∈ s) : coordDerivation D s (jet q) = D (jet q) := by
  classical
  rw [coordDerivation_apply]
  refine (Finset.sum_eq_single q ?_ ?_).trans ?_
  · intro p _ hpq
    rw [pd_jet_of_ne hpq, zero_smul]
  · intro hcon
    exact absurd hq hcon
  · rw [pd_jet_self, one_smul]

/-- **Coordinate expansion of a derivation.**  Every derivation is the corresponding combination
of coordinate partials, the sum being over the coordinates occurring in a fractional
representation. -/
theorem exists_pd_expansion (D : Derivation C (JetField C ι) M) (u : JetField C ι) :
    ∃ s : Finset (ι × ℕ), (∀ p ∉ s, pd p u = 0) ∧ D u = ∑ p ∈ s, (pd p u) • D (jet p) := by
  classical
  obtain ⟨⟨a, b⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors (JetPoly C ι)) u
  set B := algebraMap (JetPoly C ι) (JetField C ι) (b : JetPoly C ι) with hB
  have hbne : B ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  set s := a.vars ∪ (b : JetPoly C ι).vars with hs
  have hvanish : ∀ p ∉ s, pd p u = 0 := by
    intro p hp
    have hpa : p ∉ a.vars := fun h => hp (Finset.mem_union.mpr (Or.inl h))
    have hpb : p ∉ (b : JetPoly C ι).vars := fun h => hp (Finset.mem_union.mpr (Or.inr h))
    have hda : pd p (algebraMap (JetPoly C ι) (JetField C ι) a) = 0 := by
      rw [pd_algebraMap, MvPolynomial.pderiv_eq_zero_of_notMem_vars hpa, map_zero]
    have hdb : pd p B = 0 := by
      rw [hB, pd_algebraMap, MvPolynomial.pderiv_eq_zero_of_notMem_vars hpb, map_zero]
    have hmul := congrArg (pd p) hb
    rw [Derivation.leibniz, hdb, hda, smul_zero, zero_add, smul_eq_mul] at hmul
    exact (mul_eq_zero.mp hmul).resolve_left hbne
  refine ⟨s, hvanish, ?_⟩
  have hvara : ↑a.vars ⊆ (s : Set (ι × ℕ)) := by
    intro p hp
    exact Finset.mem_coe.mpr (Finset.mem_union.mpr (Or.inl (Finset.mem_coe.mp hp)))
  have hvarb : ↑(b : JetPoly C ι).vars ⊆ (s : Set (ι × ℕ)) := by
    intro p hp
    exact Finset.mem_coe.mpr (Finset.mem_union.mpr (Or.inr (Finset.mem_coe.mp hp)))
  have hcoord : ∀ p ∈ (s : Set (ι × ℕ)), D (jet p) = coordDerivation D s (jet p) := by
    intro p hp
    exact (coordDerivation_jet D s (Finset.mem_coe.mp hp)).symm
  have hDA : D (algebraMap (JetPoly C ι) (JetField C ι) a)
      = coordDerivation D s (algebraMap (JetPoly C ι) (JetField C ι) a) :=
    eq_of_eqOn_coords hcoord hvara
  have hDB : D B = coordDerivation D s B := eq_of_eqOn_coords hcoord hvarb
  have hleib : D (algebraMap (JetPoly C ι) (JetField C ι) a) = u • D B + B • D u := by
    rw [← hb, Derivation.leibniz]
  have hleib' : coordDerivation D s (algebraMap (JetPoly C ι) (JetField C ι) a)
      = u • coordDerivation D s B + B • coordDerivation D s u := by
    rw [← hb, Derivation.leibniz]
  have hBu : B • D u = B • coordDerivation D s u := by
    have h1 : u • D B + B • D u = u • coordDerivation D s B + B • coordDerivation D s u := by
      rw [← hleib, ← hleib', hDA]
    rw [hDB] at h1
    exact add_left_cancel h1
  have hcancel : D u = coordDerivation D s u := by
    have hinv := congrArg (fun m : M => B⁻¹ • m) hBu
    simpa [smul_smul, inv_mul_cancel₀ hbne] using hinv
  rw [hcancel, coordDerivation_apply]

/-- The coordinate expansion holds for any finite set of coordinates outside of which the partial
derivatives of `u` vanish. -/
theorem pd_expansion (D : Derivation C (JetField C ι) M) (u : JetField C ι)
    (s : Finset (ι × ℕ)) (hs : ∀ p ∉ s, pd p u = 0) :
    D u = ∑ p ∈ s, (pd p u) • D (jet p) := by
  classical
  obtain ⟨s₀, hs₀, hexp⟩ := exists_pd_expansion D u
  have hunion₀ : ∑ p ∈ s₀, (pd p u) • D (jet p) = ∑ p ∈ s₀ ∪ s, (pd p u) • D (jet p) := by
    refine Finset.sum_subset Finset.subset_union_left ?_
    intro p _ hp
    rw [hs₀ p hp, zero_smul]
  have hunion : ∑ p ∈ s, (pd p u) • D (jet p) = ∑ p ∈ s₀ ∪ s, (pd p u) • D (jet p) := by
    refine Finset.sum_subset Finset.subset_union_right ?_
    intro p _ hp
    rw [hs p hp, zero_smul]
  rw [hexp, hunion₀, ← hunion]

end

end JetField

end GaloisForLFunctions.HTGeometry
