import GaloisForLFunctions.HTGeometry.MilnorGoodEntries
import GaloisForLFunctions.HTGeometry.MilnorReducedFiltration

/-!
# Bass and Tate's generators for the degree filtration

Milnor's degree filtration of the Milnor `K`-theory of a rational function field is generated, as a
module over the Milnor `K`-theory of the coefficient field, by the symbols whose non-constant
entries are monic irreducible polynomials of **pairwise distinct** degrees.

Two entries of the same positive degree are traded, by the division move, for symbols of strictly
smaller total degree; factoring an entry into monic irreducibles never raises the total degree.  An
induction on the total degree therefore reaches the stated generators.

* `DistinctDegrees` : no two non-constant entries share a degree.
* `incSpan` : the classes of such symbols.
* `degreeFiltration_le_incSpan` : **the degree filtration is generated by them.**
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {F : Type*} [Field F] {n : ℕ}

/-- Two entries are compatible when one is a constant or their degrees differ. -/
def DegCompat (p q : NZPoly F) : Prop :=
  p.1.natDegree = 0 ∨ q.1.natDegree = 0 ∨ p.1.natDegree ≠ q.1.natDegree

/-- No two non-constant entries of the list share a degree. -/
def DistinctDegrees (ps : List (NZPoly F)) : Prop := ps.Pairwise DegCompat

theorem DistinctDegrees.sublist {ps qs : List (NZPoly F)} (h : DistinctDegrees qs)
    (hs : ps.Sublist qs) : DistinctDegrees ps :=
  List.Pairwise.sublist hs h

/-- An earlier entry is compatible with a later one. -/
theorem distinctDegrees_apply {l₁ l₂ l₃ : List (NZPoly F)} {p q : NZPoly F}
    (h : DistinctDegrees (l₁ ++ p :: (l₂ ++ q :: l₃))) : DegCompat p q := by
  have h1 := (List.pairwise_append.1 h).2.1
  exact (List.pairwise_cons.1 h1).1 q (by simp)

/-- A list that is not pairwise compatible has an explicit incompatible pair. -/
theorem exists_pair_of_not_distinctDegrees :
    ∀ ps : List (NZPoly F), ¬ DistinctDegrees ps →
      ∃ (l₁ l₂ l₃ : List (NZPoly F)) (p q : NZPoly F),
        ps = l₁ ++ p :: (l₂ ++ q :: l₃) ∧ ¬ DegCompat p q := by
  intro ps
  induction ps with
  | nil => intro h; exact absurd List.Pairwise.nil h
  | cons a t ih =>
      intro h
      have h' : ¬ ((∀ b ∈ t, DegCompat a b) ∧ t.Pairwise DegCompat) := by
        intro hc
        exact h (List.pairwise_cons.2 hc)
      by_cases hA : ∀ b ∈ t, DegCompat a b
      · have hT : ¬ DistinctDegrees t := fun hc => h' ⟨hA, hc⟩
        obtain ⟨l₁, l₂, l₃, p, q, hteq, hR⟩ := ih hT
        exact ⟨a :: l₁, l₂, l₃, p, q, by rw [hteq]; rfl, hR⟩
      · push Not at hA
        obtain ⟨b, hb, hRab⟩ := hA
        obtain ⟨t₁, t₂, hteq⟩ := List.append_of_mem hb
        exact ⟨[], t₁, t₂, a, b, by rw [hteq]; rfl, hRab⟩

/-- The classes of symbols whose entries are constants or monic irreducibles of pairwise distinct
degrees, all of degree at most `d`. -/
noncomputable def incSpan (d n : ℕ) : AddSubgroup (MilnorKDeg (RatFunc F) n) :=
  AddSubgroup.closure {x | ∃ (ps : List (NZPoly F)) (h : (nzList ps).length = n),
    (∀ p ∈ ps, GoodEntry p) ∧ (∀ p ∈ ps, p.1.natDegree ≤ d) ∧ DistinctDegrees ps ∧
      x = milnorClassDeg (RatFunc F) n ⟨nzList ps, h⟩}

theorem mem_incSpan {d : ℕ} {ps : List (NZPoly F)} (h : (nzList ps).length = n)
    (hgood : ∀ p ∈ ps, GoodEntry p) (hdeg : ∀ p ∈ ps, p.1.natDegree ≤ d)
    (hdist : DistinctDegrees ps) :
    milnorClassDeg (RatFunc F) n ⟨nzList ps, h⟩ ∈ incSpan (F := F) d n :=
  AddSubgroup.subset_closure ⟨ps, h, hgood, hdeg, hdist, rfl⟩

/-- **Every symbol of polynomials of degree at most `d` is a combination of symbols whose
non-constant entries are monic irreducibles of pairwise distinct degrees.** -/
theorem nzList_class_mem_incSpan {d : ℕ} :
    ∀ N : ℕ, ∀ ps : List (NZPoly F), nzTotal ps ≤ N → (∀ p ∈ ps, p.1.natDegree ≤ d) →
      ∀ h : (nzList ps).length = n,
      milnorClassDeg (RatFunc F) n ⟨nzList ps, h⟩ ∈ incSpan (F := F) d n := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro ps htot hdeg h
    classical
    have hgoodmem : milnorClassDeg (RatFunc F) n ⟨nzList ps, h⟩ ∈ goodSpan (F := F) d N n := by
      have := nzList_class_mem_goodSpan (F := F) (n := n) (d := d) (N := N) ps []
        (by simp) (by simpa using hdeg) (by simpa using htot) (by simpa using h)
      simpa using this
    refine (AddSubgroup.closure_le _).2 ?_ hgoodmem
    rintro x ⟨qs, hqlen, hqgood, hqdeg, hqtot, rfl⟩
    by_cases hdist : DistinctDegrees qs
    · exact mem_incSpan hqlen hqgood hqdeg hdist
    · -- two non-constant entries of the same degree
      obtain ⟨l₁, l₂, l₃, p, q, hqs, hR⟩ := exists_pair_of_not_distinctDegrees qs hdist
      unfold DegCompat at hR
      push Not at hR
      obtain ⟨hp0, hq0, hpq⟩ := hR
      subst hqs
      have hpq' : p.1.natDegree = q.1.natDegree := hpq
      set e : ℕ := p.1.natDegree with he
      have he1 : 1 ≤ e := Nat.one_le_iff_ne_zero.2 hp0
      have hpdeg : p.1.natDegree ≤ d := hqdeg p (by simp)
      -- move `p` to the front
      have hmv : ([] ++ nzList l₁ ++ nzUnit p :: nzList (l₂ ++ q :: l₃)).length = n := by
        rw [← hqlen]; simp [nzList]
      have hlenA : (nzList (p :: (l₁ ++ (l₂ ++ q :: l₃)))).length = n := by
        rw [nzList_length]
        rw [nzList_length] at hqlen
        simp only [List.length_cons, List.length_append] at hqlen ⊢
        omega
      have hstep1 : milnorClassDeg (RatFunc F) n ⟨nzList (l₁ ++ p :: (l₂ ++ q :: l₃)), hqlen⟩
          = milnorClassDeg (RatFunc F) n
            ⟨[] ++ nzList l₁ ++ nzUnit p :: nzList (l₂ ++ q :: l₃), hmv⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList]))
      have hstep2 := milnorClassDeg_move (K := RatFunc F) (n := n) (nzList l₁) []
        (nzList (l₂ ++ q :: l₃)) (nzUnit p) hmv
      have hfront : milnorClassDeg (RatFunc F) n
            ⟨[] ++ nzUnit p :: (nzList l₁ ++ nzList (l₂ ++ q :: l₃)),
              length_move [] (nzList l₁) (nzList (l₂ ++ q :: l₃)) (nzUnit p) hmv⟩
          = milnorClassDeg (RatFunc F) n ⟨nzList (p :: (l₁ ++ (l₂ ++ q :: l₃))), hlenA⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList]))
      rw [SetLike.mem_coe, hstep1, hstep2, hfront]
      refine AddSubgroup.zsmul_mem _ ?_ _
      -- move `q` to the second slot
      have hsplit : l₁ ++ (l₂ ++ q :: l₃) = (l₁ ++ l₂) ++ q :: l₃ := by simp
      have hlenB : (nzList (p :: ((l₁ ++ l₂) ++ q :: l₃))).length = n := by
        rw [← hsplit]; exact hlenA
      have hcast : milnorClassDeg (RatFunc F) n ⟨nzList (p :: (l₁ ++ (l₂ ++ q :: l₃))), hlenA⟩
          = milnorClassDeg (RatFunc F) n ⟨nzList (p :: ((l₁ ++ l₂) ++ q :: l₃)), hlenB⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp only [hsplit]))
      rw [hcast]
      have hlen2 : ([nzUnit p] ++ nzList (l₁ ++ l₂) ++ nzUnit q :: nzList l₃).length = n := by
        rw [← hlenB]; simp [nzList]
      have hcast2 : milnorClassDeg (RatFunc F) n ⟨nzList (p :: ((l₁ ++ l₂) ++ q :: l₃)), hlenB⟩
          = milnorClassDeg (RatFunc F) n
            ⟨[nzUnit p] ++ nzList (l₁ ++ l₂) ++ nzUnit q :: nzList l₃, hlen2⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList]))
      rw [hcast2, milnorClassDeg_move (K := RatFunc F) (n := n) (nzList (l₁ ++ l₂)) [nzUnit p]
        (nzList l₃) (nzUnit q) hlen2]
      refine AddSubgroup.zsmul_mem _ ?_ _
      have hn2 : (([] : List (RatFunc F)ˣ) ++ nzList ((l₁ ++ l₂) ++ l₃)).length + 2 = n := by
        have hx := hlen2
        simp only [List.singleton_append, List.length_cons, List.length_append,
          List.nil_append, nzList_length, nzList_append] at hx ⊢
        omega
      have hcast3 : milnorClassDeg (RatFunc F) n
            ⟨[nzUnit p] ++ nzUnit q :: (nzList (l₁ ++ l₂) ++ nzList l₃),
              length_move [nzUnit p] (nzList (l₁ ++ l₂)) (nzList l₃) (nzUnit q) hlen2⟩
          = twoSlot [] (nzList ((l₁ ++ l₂) ++ l₃)) hn2 (nzUnit p) (nzUnit q) :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList]))
      rw [hcast3]
      have hred := twoSlot_polyUnit_reduce (F := F) (n := n) he1 []
        (nzList ((l₁ ++ l₂) ++ l₃)) hn2 p.2 q.2 he.symm hpq'.symm
      refine (AddSubgroup.closure_le _).2 ?_ hred
      rintro y ⟨a, b, ha, hb, hab, rfl⟩
      obtain ⟨pa, hpa, hpale, rfl⟩ := ha
      obtain ⟨pb, hpb, hpble, rfl⟩ := hb
      have hstrict : pa.natDegree + pb.natDegree < e + e := by
        rcases hab with hA | hB
        · have := natDegree_lt_of_polyDegLt hpa hA
          omega
        · have := natDegree_lt_of_polyDegLt hpb hB
          omega
      have hlistnew : twoSlot [] (nzList ((l₁ ++ l₂) ++ l₃)) hn2 (polyUnit hpa) (polyUnit hpb)
          = milnorClassDeg (RatFunc F) n
            ⟨nzList (⟨pa, hpa⟩ :: ⟨pb, hpb⟩ :: ((l₁ ++ l₂) ++ l₃)), by
              rw [nzList_length]
              have := hn2
              simp only [List.length_append, List.length_cons, nzList_length,
                List.nil_append] at this ⊢
              omega⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList, nzUnit]))
      rw [SetLike.mem_coe, hlistnew]
      have hrestdeg : ∀ r ∈ (l₁ ++ l₂) ++ l₃, r.1.natDegree ≤ d := by
        intro r hr
        rcases List.mem_append.1 hr with h1 | h2
        · rcases List.mem_append.1 h1 with hA | hB
          · exact hqdeg r (by simp [hA])
          · exact hqdeg r (by simp [hB])
        · exact hqdeg r (by simp [h2])
      have htotnew : nzTotal (⟨pa, hpa⟩ :: ⟨pb, hpb⟩ :: ((l₁ ++ l₂) ++ l₃)) < N := by
        have hrewrite : nzTotal (l₁ ++ p :: (l₂ ++ q :: l₃))
            = p.1.natDegree + q.1.natDegree + nzTotal ((l₁ ++ l₂) ++ l₃) := by
          simp only [nzTotal_append, nzTotal_cons]
          omega
        rw [hrewrite, ← he, ← hpq'] at hqtot
        simp only [nzTotal_cons]
        omega
      refine ih _ htotnew _ le_rfl ?_ _
      intro r hr
      rcases List.mem_cons.1 hr with rfl | hr1
      · show pa.natDegree ≤ d
        omega
      · rcases List.mem_cons.1 hr1 with rfl | hr2
        · show pb.natDegree ≤ d
          omega
        · exact hrestdeg r hr2

/-- **Milnor's degree filtration is generated by the symbols of Bass and Tate**: those whose
non-constant entries are monic irreducibles of pairwise distinct degrees. -/
theorem degreeFiltration_le_incSpan {d : ℕ} :
    degreeFiltration (F := F) d n ≤ incSpan (F := F) d n := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨s, hs, rfl⟩
  obtain ⟨ps, hps, hdeg⟩ := exists_nzList (d := d) s.val
    (fun a ha => by
      obtain ⟨p, hp, hle, hap⟩ := hs a ha
      exact ⟨p, hp, hle, hap⟩)
  have hlen : (nzList ps).length = n := by rw [hps]; exact s.property
  have hcast : milnorClassDeg (RatFunc F) n s
      = milnorClassDeg (RatFunc F) n ⟨nzList ps, hlen⟩ :=
    congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext hps.symm)
  rw [SetLike.mem_coe, hcast]
  exact nzList_class_mem_incSpan _ ps le_rfl hdeg hlen

end GaloisForLFunctions.HTGeometry
