import GaloisForLFunctions.HTGeometry.MilnorKTwoSteinbergMap
import GaloisForLFunctions.HTGeometry.SteinbergFinFourSimpleWeylCoxeter
import GaloisForLFunctions.HTGeometry.SteinbergTorusIndexTransport

/-!
# Surjectivity of the rank-four Milnor-to-Steinberg map

The existing Matsumoto map sends degree-two Milnor symbols to central Steinberg `K₂`. This module
proves its missing rank-four surjectivity. The key new input is exact index independence of the
Steinberg symbol: antisymmetry comes from the Milnor presentation, transverse commutators transport
the second index, and the exact reverse-edge torus law transports orientation. Since rank-four
Steinberg `K₂` is generated by symbols, the fixed `(0,1)` map is onto.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F : Type*} [Field F] {n : Type*} [DecidableEq n] [Fintype n]

/-- A Steinberg symbol is antisymmetric once two spare indices make the Milnor-to-Steinberg map
available. -/
theorem steinbergSymbol_antisymm_of_spare_index {i j k ℓ : n}
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (hℓi : ℓ ≠ i) (hℓj : ℓ ≠ j) (hℓk : ℓ ≠ k) (a b : Fˣ) :
    steinbergSymbol hij a b = (steinbergSymbol hij b a)⁻¹ := by
  let f := milnorKTwoToSteinbergKTwoCenter
    (F := F) hij hik hjk hℓi hℓj hℓk
  have h := congrArg f (milnorSym2_antisymm (F := F) a b)
  have h' := congrArg
    (fun z : Additive (steinbergKTwoCenter F n) =>
      (((Additive.toMul z).1 : Subgroup.center (SteinbergGroup F n)) :
        SteinbergGroup F n)) h
  simpa [f, milnorSym2, map_neg] using h'

/-- Steinberg symbols on two edges with the same initial index agree. -/
theorem steinbergSymbol_same_first_index {i j k ℓ : n}
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (hℓi : ℓ ≠ i) (hℓj : ℓ ≠ j) (hℓk : ℓ ≠ k) (a b : Fˣ) :
    steinbergSymbol hij a b = steinbergSymbol hik a b := by
  have hanti := steinbergSymbol_antisymm_of_spare_index
    hik hij (Ne.symm hjk) hℓi hℓk hℓj a b
  calc
    steinbergSymbol hij a b = torusCommutator hik hij a b :=
      (torusCommutator_eq_steinbergSymbol hij hik hjk a b).symm
    _ = (torusCommutator hij hik b a)⁻¹ := by
      unfold torusCommutator
      group
    _ = (steinbergSymbol hik b a)⁻¹ := by
      rw [torusCommutator_eq_steinbergSymbol hik hij (Ne.symm hjk)]
    _ = steinbergSymbol hik a b := hanti.symm

/-- Reversing a Steinberg root edge does not change its symbol. -/
theorem steinbergSymbol_reverse_index {i j k ℓ : n}
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (hℓi : ℓ ≠ i) (hℓj : ℓ ≠ j) (hℓk : ℓ ≠ k) (a b : Fˣ) :
    steinbergSymbol (Ne.symm hij) a b = steinbergSymbol hij a b := by
  let A := steinbergTorus hij a
  let B := steinbergTorus hij b
  let C := steinbergSymbol hij a b
  have hanti := steinbergSymbol_antisymm_of_spare_index
    hij hik hjk hℓi hℓj hℓk a b
  have hswap := steinbergSymbol_swap hij a b
  have hcomm : A * B * A⁻¹ * B⁻¹ = C * C := by
    dsimp [A, B, C]
    rw [← hanti] at hswap
    simpa using hswap.symm
  have hCA : C * A = A * C := by
    exact (Subgroup.mem_center_iff.1
      (steinbergSymbol_mem_center hij a b (Ne.symm hik) (Ne.symm hjk)) A).symm
  have hCB : C * B = B * C := by
    exact (Subgroup.mem_center_iff.1
      (steinbergSymbol_mem_center hij a b (Ne.symm hik) (Ne.symm hjk)) B).symm
  have hab : A * B = (C * C) * B * A := by
    calc
      A * B = (A * B * A⁻¹ * B⁻¹) * B * A := by group
      _ = (C * C) * B * A := by rw [hcomm]
  have hinvcomm : A⁻¹ * B⁻¹ * A * B = C * C := by
    calc
      A⁻¹ * B⁻¹ * A * B = A⁻¹ * B⁻¹ * (A * B) := by group
      _ = A⁻¹ * B⁻¹ * ((C * C) * B * A) := by rw [hab]
    have hAC : A⁻¹ * C = C * A⁻¹ := by
      exact (Commute.inv_right hCA).eq.symm
    have hBC : B⁻¹ * C = C * B⁻¹ := by
      exact (Commute.inv_right hCB).eq.symm
    simp only [mul_assoc]
    rw [← mul_assoc B⁻¹ C, hBC]
    simp only [mul_assoc]
    rw [← mul_assoc A⁻¹ C, hAC]
    simp only [mul_assoc]
    rw [← mul_assoc B⁻¹ C, hBC]
    simp only [mul_assoc]
    rw [← mul_assoc A⁻¹ C, hAC]
    group
  have hua := steinbergTorus_reverse_mul (Ne.symm hik) hij (Ne.symm hjk) a
  have hub := steinbergTorus_reverse_mul (Ne.symm hik) hij (Ne.symm hjk) b
  have huab := steinbergTorus_reverse_mul (Ne.symm hik) hij (Ne.symm hjk) (a * b)
  have hTA : steinbergTorus (Ne.symm hij) a = A⁻¹ := by
    calc
      steinbergTorus (Ne.symm hij) a =
          A⁻¹ * (A * steinbergTorus (Ne.symm hij) a) := by group
      _ = A⁻¹ := by rw [hua, mul_one]
  have hTB : steinbergTorus (Ne.symm hij) b = B⁻¹ := by
    calc
      steinbergTorus (Ne.symm hij) b =
          B⁻¹ * (B * steinbergTorus (Ne.symm hij) b) := by group
      _ = B⁻¹ := by rw [hub, mul_one]
  have hTAB : steinbergTorus (Ne.symm hij) (a * b) =
      (steinbergTorus hij (a * b))⁻¹ := by
    calc
      steinbergTorus (Ne.symm hij) (a * b) =
          (steinbergTorus hij (a * b))⁻¹ *
            (steinbergTorus hij (a * b) *
              steinbergTorus (Ne.symm hij) (a * b)) := by group
      _ = (steinbergTorus hij (a * b))⁻¹ := by rw [huab, mul_one]
  rw [steinbergSymbol, hTA, hTB, hTAB, steinbergTorus_mul]
  simp only [mul_inv_rev, inv_inv]
  change A⁻¹ * B⁻¹ * C⁻¹ * A * B = C
  have hACi : A⁻¹ * C⁻¹ = C⁻¹ * A⁻¹ := by
    exact (Commute.inv_right (Commute.inv_left hCA)).eq.symm
  have hBCi : B⁻¹ * C⁻¹ = C⁻¹ * B⁻¹ := by
    exact (Commute.inv_right (Commute.inv_left hCB)).eq.symm
  calc
    A⁻¹ * B⁻¹ * C⁻¹ * A * B = C⁻¹ * (A⁻¹ * B⁻¹ * A * B) := by
      simp only [mul_assoc]
      rw [← mul_assoc B⁻¹ C⁻¹, hBCi]
      simp only [mul_assoc]
      rw [← mul_assoc A⁻¹ C⁻¹, hACi]
      group
    _ = C⁻¹ * (C * C) := by rw [hinvcomm]
    _ = C := by group

/-- Three distinct indices in `Fin 4` have a fourth complement. -/
theorem exists_fin4_fourth {i j k : Fin 4}
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    ∃ ℓ : Fin 4, ℓ ≠ i ∧ ℓ ≠ j ∧ ℓ ≠ k := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> simp_all
  all_goals native_decide

/-- Two distinct indices in `Fin 4` have two mutually distinct complements. -/
theorem exists_fin4_two_complements {i j : Fin 4} (hij : i ≠ j) :
    ∃ k ℓ : Fin 4, i ≠ k ∧ j ≠ k ∧ ℓ ≠ i ∧ ℓ ≠ j ∧ ℓ ≠ k := by
  obtain ⟨k, hki, hkj⟩ := exists_third_index (by decide) i j
  obtain ⟨ℓ, hℓi, hℓj, hℓk⟩ :=
    exists_fin4_fourth hij (Ne.symm hki) (Ne.symm hkj)
  exact ⟨k, ℓ, Ne.symm hki, Ne.symm hkj, hℓi, hℓj, hℓk⟩

/-- Exact rank-four index independence of the Steinberg symbol. -/
theorem fin4_steinbergSymbol_index_independent
    {i j i' j' : Fin 4} (hij : i ≠ j) (hi'j' : i' ≠ j') (a b : Fˣ) :
    steinbergSymbol hij a b = steinbergSymbol hi'j' a b := by
  by_cases hii' : i = i'
  · subst i'
    by_cases hjj' : j = j'
    · subst j'
      rfl
    · obtain ⟨ℓ, hℓi, hℓj, hℓj'⟩ :=
        exists_fin4_fourth hij hi'j' hjj'
      exact steinbergSymbol_same_first_index hij hi'j' hjj' hℓi hℓj hℓj' a b
  · have h1 : steinbergSymbol hij a b = steinbergSymbol hii' a b := by
      by_cases hji' : j = i'
      · subst i'
        rfl
      · obtain ⟨ℓ, hℓi, hℓj, hℓi'⟩ :=
          exists_fin4_fourth hij hii' hji'
        exact steinbergSymbol_same_first_index hij hii' hji' hℓi hℓj hℓi' a b
    obtain ⟨k, ℓ, hik, hi'k, hℓi, hℓi', hℓk⟩ :=
      exists_fin4_two_complements hii'
    have h2 : steinbergSymbol hii' a b =
        steinbergSymbol (Ne.symm hii') a b :=
      (steinbergSymbol_reverse_index hii' hik hi'k hℓi hℓi' hℓk a b).symm
    have h3 : steinbergSymbol (Ne.symm hii') a b =
        steinbergSymbol hi'j' a b := by
      by_cases hij' : i = j'
      · subst j'
        rfl
      · obtain ⟨m, hmi', hmi, hmj'⟩ :=
          exists_fin4_fourth (Ne.symm hii') hi'j' hij'
        exact steinbergSymbol_same_first_index
          (Ne.symm hii') hi'j' hij' hmi' hmi hmj' a b
    exact h1.trans (h2.trans h3)

/-- Fixed-index rank-four Matsumoto map. -/
noncomputable def milnorKTwoToFin4SteinbergKTwoCenter :
    MilnorKDeg F 2 →+ Additive (steinbergKTwoCenter F (Fin 4)) :=
  milnorKTwoToSteinbergKTwoCenter
    (F := F) (n := Fin 4)
    (i := (0 : Fin 4)) (j := (1 : Fin 4)) (k := (2 : Fin 4)) (ℓ := (3 : Fin 4))
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)

@[simp]
theorem milnorKTwoToFin4SteinbergKTwoCenter_pair (a b : Fˣ) :
    milnorKTwoToFin4SteinbergKTwoCenter (milnorSym2 F a b) =
      Additive.ofMul
        ⟨⟨steinbergSymbol (by decide : (0 : Fin 4) ≠ 1) a b,
          steinbergSymbol_mem_center
            (R := F) (n := Fin 4) (i := 0) (j := 1)
            (by decide) a b (h := 2) (by decide) (by decide)⟩,
        steinbergSymbol_mem_KTwo
          (R := F) (n := Fin 4) (i := 0) (j := 1) (by decide) a b⟩ := by
  exact milnorKTwoToSteinbergKTwoCenter_pair
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) a b

/-- The fixed-index Milnor-to-Steinberg map is onto rank-four central `K₂`. -/
theorem milnorKTwoToFin4SteinbergKTwoCenter_surjective :
    Function.Surjective (milnorKTwoToFin4SteinbergKTwoCenter (F := F)) := by
  intro z
  let f := milnorKTwoToFin4SteinbergKTwoCenter (F := F)
  let P : ∀ x : SteinbergGroup F (Fin 4),
      x ∈ steinbergSymbolSubgroup F (Fin 4) → Prop := fun x hx =>
    ∃ m : MilnorKDeg F 2, f m = Additive.ofMul
      ⟨⟨x, fin4_steinbergSymbolSubgroup_le_center hx⟩,
        steinbergSymbolSubgroup_le_KTwo hx⟩
  have hzSymbol : (((z.1 : Subgroup.center (SteinbergGroup F (Fin 4))) :
      SteinbergGroup F (Fin 4))) ∈ steinbergSymbolSubgroup F (Fin 4) := by
    rw [← fin4_KTwo_eq_steinbergSymbolSubgroup]
    exact z.property
  have hp : P z.1.1 hzSymbol := by
    apply Subgroup.closure_induction (p := P) ?_ ?_ ?_ ?_ hzSymbol
    · rintro x ⟨i, j, hij, a, b, rfl⟩
      refine ⟨milnorSym2 F a b, ?_⟩
      rw [milnorKTwoToFin4SteinbergKTwoCenter_pair]
      apply Additive.toMul.injective
      apply Subtype.ext
      apply Subtype.ext
      exact fin4_steinbergSymbol_index_independent (by decide) hij a b
    · refine ⟨0, ?_⟩
      rw [map_zero]
      apply Additive.toMul.injective
      apply Subtype.ext
      apply Subtype.ext
      rfl
    · intro x y hx hy
      rintro ⟨mx, hmx⟩ ⟨my, hmy⟩
      refine ⟨mx + my, ?_⟩
      rw [map_add, hmx, hmy]
      rfl
    · intro x hx
      rintro ⟨mx, hmx⟩
      refine ⟨-mx, ?_⟩
      rw [map_neg, hmx]
      rfl
  obtain ⟨m, hm⟩ := hp
  refine ⟨m, hm.trans ?_⟩
  apply Additive.toMul.injective
  apply Subtype.ext
  apply Subtype.ext
  rfl

/-- Exact first-isomorphism survivor: rank-four central Steinberg `K₂` is degree-two Milnor
`K`-theory modulo the remaining Matsumoto kernel. -/
noncomputable def milnorKTwoQuotientKerEquivFin4SteinbergKTwoCenter :
    MilnorKDeg F 2 ⧸ (milnorKTwoToFin4SteinbergKTwoCenter (F := F)).ker ≃+
      Additive (steinbergKTwoCenter F (Fin 4)) :=
  (QuotientAddGroup.quotientKerEquivRange
    (milnorKTwoToFin4SteinbergKTwoCenter (F := F))).trans
    (AddEquiv.ofBijective
      (milnorKTwoToFin4SteinbergKTwoCenter (F := F)).range.subtype
      ⟨(fun _ _ h => Subtype.ext h),
        fun z => by
          obtain ⟨m, hm⟩ :=
            milnorKTwoToFin4SteinbergKTwoCenter_surjective (F := F) z
          exact ⟨⟨z, ⟨m, hm⟩⟩, rfl⟩⟩)

end

end GaloisForLFunctions.HTGeometry
