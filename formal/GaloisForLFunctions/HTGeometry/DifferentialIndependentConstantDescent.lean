import GaloisForLFunctions.HTGeometry.DifferentialAdjoinCommute
import GaloisForLFunctions.HTGeometry.DifferentialIndependentSplit
import GaloisForLFunctions.HTGeometry.DifferentialAdjoinFiniteTrdeg

/-!
# Enlarging the coefficient field by finitely many jets

Differential independence of a finite family is unaffected by enlarging the coefficient field to a
differential adjunction whose generators contribute only finitely many distinct jets.

The proof does not induct on the family.  If the family were dependent over the enlarged field, a
maximal independent subfamily isolates one member differentially algebraic over the enlarged field
generated by that subfamily; interchanging the two adjunctions and descending through the finite
transcendence degree makes that member differentially algebraic over the *original* field generated
by the subfamily, which the tower law forbids.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

/-- Differential independence of a one-element family does not depend on the singleton index
type. -/
theorem differentialIndependent_unique_iff {F K : Type*} [CommRing F] [CommRing K] [Algebra F K]
    [Differential K] {ι ι' : Type*} [Unique ι] [Unique ι'] (z : K) :
    DifferentialIndependent F (fun _ : ι => z) ↔ DifferentialIndependent F (fun _ : ι' => z) := by
  unfold DifferentialIndependent
  refine algebraicIndependent_equiv'
    ((Equiv.ofUnique (α := ι) (β := ι')).prodCongr (Equiv.refl ℕ)) ?_
  funext p
  rfl

/-- A subfamily of an independent family, together with one further member, is independent. -/
theorem differentialIndependent_sumElim_of_subset {F K : Type u} [Field F] [Field K] [Algebra F K]
    [Differential K] {s t : Set K} {z : K} (hts : t ⊆ s) (hzs : z ∈ s) (hzt : z ∉ t)
    (hind : DifferentialIndependent F ((↑) : ↥s → K)) :
    DifferentialIndependent F
      (Sum.elim (fun _ : PUnit.{u + 1} => z) ((↑) : ↥t → K)) := by
  have hg : Function.Injective
      (Sum.elim (fun _ : PUnit.{u + 1} => (⟨z, hzs⟩ : ↥s))
        (fun w : ↥t => (⟨(w : K), hts w.2⟩ : ↥s))) := by
    rintro (a | a) (b | b) hab
    · rfl
    · exfalso
      have h1 : z = (b : K) := by simpa using Subtype.ext_iff.mp hab
      exact hzt (by rw [h1]; exact b.2)
    · exfalso
      have h1 : (a : K) = z := by simpa using Subtype.ext_iff.mp hab
      exact hzt (by rw [← h1]; exact a.2)
    · have h1 : (a : K) = (b : K) := by simpa using Subtype.ext_iff.mp hab
      exact congrArg Sum.inr (Subtype.ext h1)
  have hcomp : Sum.elim (fun _ : PUnit.{u + 1} => z) ((↑) : ↥t → K)
      = ((↑) : ↥s → K) ∘ (Sum.elim (fun _ : PUnit.{u + 1} => (⟨z, hzs⟩ : ↥s))
        (fun w : ↥t => (⟨(w : K), hts w.2⟩ : ↥s))) := by
    funext w
    cases w <;> rfl
  rw [hcomp]
  exact hind.comp _ hg

/-- **Constant-field enlargement preserves differential independence.**  If the generators `S`
contribute only finitely many distinct jets, then every finite family independent over `k` stays
independent over the differential field they generate. -/
theorem differentialIndependent_differentialAdjoin_of_finite_jetSet
    {k K : Type u} [Field k] [Field K] [Algebra k K] [Differential k] [Differential K]
    [DifferentialAlgebra k K] [CharZero K]
    {S : Set K} (hS : (differentialJetSet S).Finite)
    {s : Set K} (hsfin : s.Finite)
    (hind : DifferentialIndependent k ((↑) : ↥s → K)) :
    DifferentialIndependent ↥(differentialAdjoin k S) ((↑) : ↥s → K) := by
  classical
  by_contra hdep
  obtain ⟨t, z, hts, hzs, hzt, -, hzdep⟩ :=
    exists_split_of_not_differentialIndependent hsfin hdep
  -- the isolated member is differentially algebraic over the enlarged field generated by `t`
  have hDA1 : DifferentialAlgebraicOver
      ↥(differentialAdjoin (↥(differentialAdjoin k S)) t) z := by
    intro hcon
    exact hzdep ((differentialIndependent_unique_iff (ι := Unit) (ι' := PUnit.{u + 1}) z).mp hcon)
  -- interchange the two adjunctions
  have hDA2 : DifferentialAlgebraicOver
      ↥(differentialAdjoin (↥(differentialAdjoin k t)) S) z :=
    differentialAlgebraicOver_of_coe_eq (coe_differentialAdjoin_comm S t) hDA1
  -- descend through the finite transcendence degree contributed by `S`
  letI : Differential ↥(differentialAdjoin k t) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin k t)
  letI : DifferentialAlgebra (↥(differentialAdjoin k t)) K :=
    ⟨fun c => derivationClosedDifferential_apply _ (derivationClosed_differentialAdjoin k t) c⟩
  have hDA3 : DifferentialAlgebraicOver (↥(differentialAdjoin k t)) z :=
    differentialAlgebraicOver_of_intermediate_trdeg_lt_aleph0
      (k := ↥(differentialAdjoin k t)) (K := K) (differentialAdjoin (↥(differentialAdjoin k t)) S)
      (derivationClosed_differentialAdjoin _ S)
      (differentialAdjoin_trdeg_lt_aleph0_of_finite_jetSet S hS) hDA2
  -- but the tower law makes it independent over that very field
  have hsum : DifferentialIndependent k
      (Sum.elim (fun _ : PUnit.{u + 1} => z) ((↑) : ↥t → K)) :=
    differentialIndependent_sumElim_of_subset hts hzs hzt hind
  have htower := differentialIndependent_sumElim_iff.mp hsum
  rw [Subtype.range_coe] at htower
  exact hDA3
    ((differentialIndependent_unique_iff (ι := PUnit.{u + 1}) (ι' := Unit) z).mp htower.2)

/-- Family form of constant-field enlargement: differential independence of a finite family is
preserved by adjoining generators of finite jet set to the coefficient field. -/
theorem differentialIndependent_family_differentialAdjoin_of_finite_jetSet
    {k K : Type u} [Field k] [Field K] [Algebra k K] [Differential k] [Differential K]
    [DifferentialAlgebra k K] [CharZero K]
    {S : Set K} (hS : (differentialJetSet S).Finite)
    {ι : Type*} [Finite ι] {y : ι → K} (hind : DifferentialIndependent k y) :
    DifferentialIndependent ↥(differentialAdjoin k S) y := by
  have hinj : Function.Injective y := by
    intro i j hij
    have h : (fun p : ι × ℕ => differentialJet p.2 (y p.1)) (i, 0)
        = (fun p : ι × ℕ => differentialJet p.2 (y p.1)) (j, 0) := hij
    have h2 := hind.injective h
    rw [Prod.mk.injEq] at h2
    exact h2.1
  set e : ι ≃ ↥(Set.range y) := Equiv.ofInjective y hinj with he
  have hprod : ((fun p : ↥(Set.range y) × ℕ => differentialJet p.2 ((p.1 : K)))
      ∘ (e.prodCongr (Equiv.refl ℕ))) = fun p : ι × ℕ => differentialJet p.2 (y p.1) := by
    funext p
    rfl
  have hiff := algebraicIndependent_equiv' (R := k) (e.prodCongr (Equiv.refl ℕ)) hprod
  exact hiff.mpr (differentialIndependent_differentialAdjoin_of_finite_jetSet hS
    (Set.finite_range y) (hiff.mp hind))

end

end GaloisForLFunctions.HTGeometry
