import GaloisForLFunctions.HTGeometry.AdjoinFractionTransport
import Mathlib.RingTheory.DedekindDomain.Different

/-!
# The different of a monogenic extension

When the conductor is the unit ideal the identity relating it to the derivative of a minimal
polynomial collapses: the different is exactly the ideal generated by that derivative at the
generator.  The conductor is the unit ideal precisely when the generator generates the extension,
which is the situation of a finite extension of discrete valuation rings with trivial residue
extension.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable (A K : Type*) {L : Type*} {B : Type*} [CommRing A] [Field K] [CommRing B] [Field L]
variable [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
variable [IsScalarTower A K L] [IsScalarTower A B L]
variable [IsDomain A] [IsFractionRing A K] [FiniteDimensional K L] [Algebra.IsSeparable K L]
variable [IsIntegrallyClosed A] [IsIntegralClosure B A L] [IsFractionRing B L]
variable [IsDedekindDomain B] [Module.IsTorsionFree A B]

omit [IsFractionRing B L] in
/-- **The different of a monogenic extension is generated by the derivative of the minimal
polynomial.**  With the conductor trivial, the general identity leaves only the derivative. -/
theorem differentIdeal_eq_span_aeval_derivative (x : B)
    (hx : Algebra.adjoin K ({algebraMap B L x} : Set L) = ⊤)
    (hcond : conductor A x = ⊤) :
    differentIdeal A B = Ideal.span {aeval x (derivative (minpoly A x))} := by
  have h := conductor_mul_differentIdeal A K L x hx
  rwa [hcond, Ideal.top_mul] at h

end GaloisForLFunctions.HTGeometry
