import GaloisForLFunctions.HTGeometry.RittTowerCapstone
import GaloisForLFunctions.HTGeometry.RittPrefixFieldStability
import GaloisForLFunctions.HTGeometry.RittDifferentialAlgebraicBridge

/-!
# The collapse at the minimal order, and the base relation it forces

Taking the *least* jet order at which the linearizer's jet lies in the field generated by its
predecessors makes every lower jet transcendental over its own prefix field: below order two because
the first two jets were assumed independent, and at order two or above because the collapse theorem
turns "algebraic over the prefix field" into "in the prefix field", which minimality forbids.

The tower capstone then applies at that order, so a differentially algebraic linearizer whose first
two jets are independent forces a base relation

`ψ(u) = c·u + g`,  `u ≠ 0`,  `c ≠ 0`,

with `g` zero or a nonzero base multiple of a Faà di Bruno coefficient of the shift.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- **The base relation forced by any collapse of the jet tower.** -/
theorem exists_base_relation_of_collapse (Fr : RittFrame K L) [CharZero L]
    {τ : L} {q : K} (hτ : τ ≠ 0) (hdτ : Fr.d τ ≠ 0) (hq : q ≠ 0) (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ)
    (htr0 : Transcendental ↥(Fr.jetPrefixField τ 0) τ)
    (htr1 : Transcendental ↥(Fr.jetPrefixField τ 1) (Fr.d τ))
    (hjets : ∀ m : ℕ, Fr.d^[m] τ ≠ 0)
    (hcollapse : ∃ n : ℕ, Fr.d^[n] τ ∈ Fr.jetPrefixField τ n) :
    ∃ (n : ℕ) (A : ℕ → K) (u c g : K), 2 ≤ n ∧ u ≠ 0 ∧ c ≠ 0 ∧
      (∃ i k : ℤ, c = q ^ i * Fr.ρ ^ k) ∧
      (Fr.σ (Fr.d^[n] τ) = algebraMap K L (q / Fr.ρ ^ n) * Fr.d^[n] τ
        + ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j] τ) ∧
      (g = 0 ∨ ∃ (j : ℕ) (z : K), z ≠ 0 ∧ g = z * A j) ∧
      Fr.ψ u = c * u + g := by
  classical
  set n : ℕ := Nat.find hcollapse with hn
  have hmem : Fr.d^[n] τ ∈ Fr.jetPrefixField τ n := Nat.find_spec hcollapse
  have hmin : ∀ k, k < n → Fr.d^[k] τ ∉ Fr.jetPrefixField τ k := fun k hk =>
    Nat.find_min hcollapse hk
  -- the minimal order is at least two
  have hn2 : 2 ≤ n := by
    by_contra hlt
    interval_cases n
    · exact htr0 (by
        have : τ ∈ Fr.jetPrefixField τ 0 := by simpa using hmem
        exact isAlgebraic_algebraMap (⟨τ, this⟩ : ↥(Fr.jetPrefixField τ 0)))
    · exact htr1 (by
        have : Fr.d τ ∈ Fr.jetPrefixField τ 1 := by simpa using hmem
        exact isAlgebraic_algebraMap (⟨Fr.d τ, this⟩ : ↥(Fr.jetPrefixField τ 1)))
  -- every lower jet is transcendental over its own prefix field
  have htr : ∀ k, k < n → Transcendental ↥(Fr.jetPrefixField τ k) (Fr.d^[k] τ) := by
    intro k hk halg
    rcases Nat.lt_or_ge k 2 with hk2 | hk2
    · interval_cases k
      · exact htr0 (by simpa using halg)
      · exact htr1 (by simpa using halg)
    · exact hmin k hk
        (jet_mem_jetPrefixField_of_isAlgebraic Fr hτ hdτ hq hqconst hshift hk2 halg)
  obtain ⟨A, hA, u, c, g, hu0, hc0, hcinv, hginv, hrel⟩ :=
    exists_base_relation_of_jet_mem Fr hq hqconst hshift htr (hjets n) hmem
  exact ⟨n, A, u, c, g, hn2, hu0, hc0, hcinv, hA, hginv, hrel⟩

open GaloisForLFunctions in
/-- **Ritt's implication, in the frame.**  A differentially algebraic linearizer either satisfies
Ritt's order-one relation `(d τ)^r = A·τ^j`, or forces on the base a relation `ψ(u) = c·u + g` whose
inhomogeneity is zero or a nonzero base multiple of a Faà di Bruno coefficient of the shift. -/
theorem rittForm_or_base_relation [Differential K] [Differential L] [DifferentialAlgebra K L]
    [CharZero K] [CharZero L] (Fr : RittFrame K L)
    (hd : Fr.d = ⇑(Differential.deriv : Derivation ℤ L L))
    {τ : L} {q : K} (hτ : τ ≠ 0) (hdτ : Fr.d τ ≠ 0) (hq : q ≠ 0) (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ)
    (htr0 : Transcendental ↥(Fr.jetPrefixField τ 0) τ)
    (htr1 : Transcendental ↥(Fr.jetPrefixField τ 1) (Fr.d τ))
    (hjets : ∀ m : ℕ, Fr.d^[m] τ ≠ 0)
    (hDA : DifferentialAlgebraicOver K τ) :
    (∃ (r j : ℤ) (A : K), r ≠ 0 ∧ A ≠ 0 ∧ (Fr.d τ) ^ r = algebraMap K L A * τ ^ j) ∨
      ∃ (n : ℕ) (A : ℕ → K) (u c g : K), 2 ≤ n ∧ u ≠ 0 ∧ c ≠ 0 ∧
        (∃ i k : ℤ, c = q ^ i * Fr.ρ ^ k) ∧
        (Fr.σ (Fr.d^[n] τ) = algebraMap K L (q / Fr.ρ ^ n) * Fr.d^[n] τ
          + ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j] τ) ∧
        (g = 0 ∨ ∃ (j : ℕ) (z : K), z ≠ 0 ∧ g = z * A j) ∧
        Fr.ψ u = c * u + g := by
  rcases rittForm_or_jet_mem_jetPrefixField Fr hd hτ hdτ hq hqconst hshift hDA with h | ⟨n, _, hmem⟩
  · exact Or.inl h
  · exact Or.inr (exists_base_relation_of_collapse Fr hτ hdτ hq hqconst hshift htr0 htr1 hjets
      ⟨n, hmem⟩)

end GaloisForLFunctions.HTGeometry
