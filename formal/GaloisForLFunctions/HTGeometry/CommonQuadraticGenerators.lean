import GaloisForLFunctions.HTGeometry.QuadraticRootFieldEquiv

/-!
# Fields generated by scaled roots of one square class

If a nonempty generating family consists of roots of `c*w_i^2`, with each
`w_i` a nonzero base scalar and `c` nonsquare, the generated field has degree
two and is isomorphic to the field of any square root of `c`.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open scoped IntermediateField
variable {F L M : Type*} [Field F] [Field L] [Field M] [Algebra F L] [Algebra F M]

/-- A nonempty generating family in a single nontrivial square class generates
exactly the corresponding quadratic field. -/
theorem common_quadratic_generators {ι : Type*} (r : ι → L) (w : ι → F) (i₀ : ι)
    {c : F} (hc : ¬ IsSquare c) (hw : ∀ i, w i ≠ 0)
    (hr : ∀ i, r i * r i = algebraMap F L (c * w i ^ 2))
    (hgen : IntermediateField.adjoin F (Set.range r) = ⊤)
    {s : M} (hs : s * s = algebraMap F M c) :
    Module.finrank F L = 2 ∧ Nonempty (L ≃ₐ[F] F⟮s⟯) := by
  let v := r i₀ / algebraMap F L (w i₀)
  have hv : v * v = algebraMap F L c := by
    have hn : algebraMap F L (w i₀) ≠ 0 := (map_ne_zero _).mpr (hw i₀)
    dsimp [v]
    rw [div_mul_div_comm, hr, map_mul, map_pow, ← pow_two]
    exact mul_div_cancel_right₀ _ (pow_ne_zero 2 hn)
  have hcsq : IsSquare (algebraMap F F⟮v⟯ c) :=
    (root_mem_iff_isSquare hv F⟮v⟯).mp (IntermediateField.mem_adjoin_simple_self F v)
  have ht : F⟮v⟯ = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨i, rfl⟩
    apply (root_mem_iff_isSquare (hr i) F⟮v⟯).mpr
    rw [map_mul, map_pow]
    exact hcsq.mul (IsSquare.sq _)
  have hd := finrank_adjoin_eq_two hv (root_not_mem_bot_of_not_isSquare hv hc)
  have he : F⟮v⟯ ≃ₐ[F] L :=
    (IntermediateField.equivOfEq ht).trans IntermediateField.topEquiv
  refine ⟨?_, ⟨he.symm.trans (quadraticRootFieldEquiv hv hs hc)⟩⟩
  exact he.toLinearEquiv.finrank_eq.symm.trans hd

end GaloisForLFunctions.HTGeometry
