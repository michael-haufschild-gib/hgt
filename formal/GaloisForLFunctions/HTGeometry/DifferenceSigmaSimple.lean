import Mathlib

/-!
# `σ`-ideals, `σ`-simple difference rings, and their constants

Difference Galois theory is built on Picard--Vessiot rings, and a Picard--Vessiot ring is by
definition a `σ`-simple difference ring: one whose only ideals stable under the distinguished
automorphism are the trivial ones.  This file supplies that layer, which neither mathlib nor this
repository had.

The three facts that make the theory work are all here:

* every proper `σ`-ideal is contained in a maximal one, so `σ`-simple quotients exist;
* a `σ`-simple ring is reduced, because its nilradical is a proper `σ`-ideal;
* the constants of a `σ`-simple ring form a field, because the ideal generated by a constant is a
  `σ`-ideal.

The last is the reason the solution space of a difference system is a vector space over a *field*
of constants rather than a module over a ring.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R]

/-! ### `σ`-ideals -/

/-- An ideal stable under the distinguished automorphism of a difference ring. -/
def IsSigmaIdeal (σ : R ≃+* R) (I : Ideal R) : Prop := ∀ x ∈ I, σ x ∈ I

theorem isSigmaIdeal_bot (σ : R ≃+* R) : IsSigmaIdeal σ (⊥ : Ideal R) := by
  intro x hx
  rw [Ideal.mem_bot] at hx ⊢
  rw [hx, map_zero]

theorem isSigmaIdeal_top (σ : R ≃+* R) : IsSigmaIdeal σ (⊤ : Ideal R) := fun _ _ => trivial

/-- The ideal generated by a constant is a `σ`-ideal. -/
theorem isSigmaIdeal_span_singleton_of_fixed {σ : R ≃+* R} {c : R} (hc : σ c = c) :
    IsSigmaIdeal σ (Ideal.span {c}) := by
  intro x hx
  rw [Ideal.mem_span_singleton] at hx ⊢
  obtain ⟨r, rfl⟩ := hx
  exact ⟨σ r, by rw [map_mul, hc]⟩

/-- The nilradical is a `σ`-ideal. -/
theorem isSigmaIdeal_nilradical (σ : R ≃+* R) : IsSigmaIdeal σ (nilradical R) := by
  intro x hx
  obtain ⟨n, hn⟩ := hx
  have hn' : x ^ n = 0 := by simpa using hn
  have hσ : (σ x) ^ n = 0 := by rw [← map_pow, hn', map_zero]
  exact ⟨n, by simpa using hσ⟩

/-- **Maximal `σ`-ideals exist.**  Every proper `σ`-ideal is contained in a `σ`-ideal maximal among
the proper `σ`-ideals. -/
theorem exists_maximal_isSigmaIdeal (σ : R ≃+* R) (I : Ideal R)
    (hI : IsSigmaIdeal σ I) (hne : I ≠ ⊤) :
    ∃ M : Ideal R, I ≤ M ∧ IsSigmaIdeal σ M ∧ M ≠ ⊤ ∧
      ∀ J : Ideal R, IsSigmaIdeal σ J → J ≠ ⊤ → M ≤ J → J = M := by
  classical
  set S : Set (Ideal R) := {J | I ≤ J ∧ IsSigmaIdeal σ J ∧ J ≠ ⊤} with hS
  have hIS : I ∈ S := ⟨le_rfl, hI, hne⟩
  have hchain : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc
    rcases c.eq_empty_or_nonempty with rfl | hne'
    · exact ⟨I, hIS, by simp⟩
    · refine ⟨sSup c, ⟨?_, ?_, ?_⟩, fun z hz => le_sSup hz⟩
      · obtain ⟨J, hJ⟩ := hne'
        exact le_trans (hcS hJ).1 (le_sSup hJ)
      · intro x hx
        rw [Submodule.mem_sSup_of_directed hne' hc.directedOn] at hx ⊢
        obtain ⟨J, hJc, hxJ⟩ := hx
        exact ⟨J, hJc, (hcS hJc).2.1 x hxJ⟩
      · intro htop
        have h1 : (1 : R) ∈ sSup c := by rw [htop]; trivial
        rw [Submodule.mem_sSup_of_directed hne' hc.directedOn] at h1
        obtain ⟨J, hJc, h1J⟩ := h1
        exact (hcS hJc).2.2 (Ideal.eq_top_of_isUnit_mem J h1J isUnit_one)
  obtain ⟨M, hM⟩ := zorn_le₀ S hchain
  obtain ⟨hMS, hmax⟩ := hM
  exact ⟨M, hMS.1, hMS.2.1, hMS.2.2, fun J hJ hJtop hle =>
    le_antisymm (hmax ⟨le_trans hMS.1 hle, hJ, hJtop⟩ hle) hle⟩

/-! ### `σ`-simple rings -/

/-- A difference ring is `σ`-simple when its only `σ`-ideals are the trivial ones. -/
def IsSigmaSimple (σ : R ≃+* R) : Prop :=
  ∀ I : Ideal R, IsSigmaIdeal σ I → I = ⊥ ∨ I = ⊤

/-- **A `σ`-simple ring is reduced.**  The nilradical is a `σ`-ideal, and it is proper. -/
theorem isReduced_of_isSigmaSimple [Nontrivial R] {σ : R ≃+* R} (h : IsSigmaSimple σ) :
    IsReduced R := by
  have hnil : nilradical R = ⊥ := by
    rcases h _ (isSigmaIdeal_nilradical σ) with hb | ht
    · exact hb
    · exfalso
      have : (1 : R) ∈ nilradical R := by rw [ht]; trivial
      obtain ⟨n, hn⟩ := this
      rw [one_pow] at hn
      exact one_ne_zero hn
  refine ⟨fun x hx => ?_⟩
  have hxn : x ∈ nilradical R := mem_nilradical.mpr hx
  rw [hnil] at hxn
  simpa using hxn

/-- **Nonzero constants of a `σ`-simple ring are units.** -/
theorem isUnit_of_isSigmaSimple_of_fixed [Nontrivial R] {σ : R ≃+* R}
    (h : IsSigmaSimple σ) {c : R} (hc : σ c = c) (hc0 : c ≠ 0) : IsUnit c := by
  rcases h _ (isSigmaIdeal_span_singleton_of_fixed hc) with hb | ht
  · exact absurd (Ideal.mem_bot.mp (hb ▸ Ideal.mem_span_singleton_self c)) hc0
  · exact Ideal.span_singleton_eq_top.mp ht

/-- The inverse of a fixed unit is fixed. -/
theorem fixed_inv_of_fixed {σ : R ≃+* R} {c u : R} (hc : σ c = c) (hcu : c * u = 1) :
    σ u = u := by
  have h1 : c * σ u = 1 := by
    have := congrArg σ hcu
    rw [map_mul, hc, map_one] at this
    exact this
  calc σ u = σ u * (c * u) := by rw [hcu, mul_one]
    _ = (c * σ u) * u := by ring
    _ = u := by rw [h1, one_mul]

/-- The constants of a difference ring. -/
def sigmaConstantsSubring (σ : R ≃+* R) : Subring R where
  carrier := {x | σ x = x}
  mul_mem' := by
    intro a b ha hb
    show σ (a * b) = a * b
    rw [map_mul]
    exact congrArg₂ (· * ·) ha hb
  one_mem' := by show σ 1 = 1; exact map_one σ
  add_mem' := by
    intro a b ha hb
    show σ (a + b) = a + b
    rw [map_add]
    exact congrArg₂ (· + ·) ha hb
  zero_mem' := by show σ 0 = 0; exact map_zero σ
  neg_mem' := by
    intro a ha
    show σ (-a) = -a
    rw [map_neg]
    exact congrArg Neg.neg ha

@[simp] theorem mem_sigmaConstantsSubring {σ : R ≃+* R} {x : R} :
    x ∈ sigmaConstantsSubring σ ↔ σ x = x := Iff.rfl

/-- **The constants of a `σ`-simple ring form a field.**  This is what makes the solution space of
a difference system a vector space, and it is the reason Picard--Vessiot rings are required to be
`σ`-simple. -/
theorem isField_sigmaConstantsSubring_of_isSigmaSimple [Nontrivial R] {σ : R ≃+* R}
    (h : IsSigmaSimple σ) : IsField (sigmaConstantsSubring σ) := by
  refine ⟨⟨0, 1, ?_⟩, fun {a b} => mul_comm a b, ?_⟩
  · intro h01
    exact zero_ne_one (congrArg Subtype.val h01)
  · rintro ⟨c, hc⟩ hc0
    have hcne : c ≠ 0 := fun hzero => hc0 (Subtype.ext hzero)
    obtain ⟨u, hu⟩ := isUnit_of_isSigmaSimple_of_fixed h hc hcne
    have hcu : c * (u.inv : R) = 1 := by
      rw [← hu]
      exact u.val_inv
    refine ⟨⟨(u.inv : R), fixed_inv_of_fixed hc hcu⟩, ?_⟩
    exact Subtype.ext hcu

end

end GaloisForLFunctions.HTGeometry
