import GaloisForLFunctions.HTGeometry.FreeCoordinateConstantKernel

/-!
# The common kernel of a family of coordinate derivations is the field it does not touch

A rational function of free coordinates killed by every coordinate derivation outside a set is a
rational function of the coordinates inside that set.  The minimal-degree denominator argument runs
unchanged: differentiating the denominator relation shows that the derivative of the denominator is
again a denominator, so the denominator, and then the numerator, has no variable outside the set.

Together with the reverse inclusion this identifies the common kernel exactly, which is the
statement that lets an annihilation hypothesis be read as a membership.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

variable {C σ : Type*} [Field C]

/-- In characteristic zero a polynomial whose partial derivatives outside a set all vanish has no
variable outside that set. -/
theorem vars_subset_of_forall_pderiv_eq_zero [CharZero C] {p : MvPolynomial σ C} {S : Set σ}
    (h : ∀ i, i ∉ S → MvPolynomial.pderiv i p = 0) : (↑p.vars : Set σ) ⊆ S := by
  intro i hi
  by_contra hiS
  exact mvPolynomial_pderiv_ne_zero_of_mem_vars (Finset.mem_coe.1 hi) (h i hiS)

/-- **The support-kernel theorem.**  A rational function of free coordinates killed by every
coordinate derivation outside a set lies in the subfield generated by the coordinates inside it. -/
theorem mem_freeCoordinateField_of_forall_freeCoordinateDerivation_eq_zero [CharZero C]
    {S : Set σ} {f : FreeCoordinateRationalField C σ}
    (hf : ∀ i, i ∉ S → freeCoordinateDerivation C σ i f = 0) :
    f ∈ freeCoordinateField C σ S := by
  classical
  have hinj : Function.Injective
      (algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)) :=
    IsFractionRing.injective _ _
  have hex : ∃ d : ℕ, ∃ B A : MvPolynomial σ C, B ≠ 0 ∧
      algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) A =
        algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) B * f ∧
      B.totalDegree = d := by
    obtain ⟨B, A, hB, hBA⟩ := exists_denominator f
    exact ⟨B.totalDegree, B, A, hB, hBA, rfl⟩
  obtain ⟨B, A, hB0, hBA, hBd⟩ := Nat.find_spec hex
  have hstep : ∀ i : σ, i ∉ S →
      algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)
          (MvPolynomial.pderiv i A) =
        algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ)
          (MvPolynomial.pderiv i B) * f := by
    intro i hi
    have h := congrArg (freeCoordinateDerivation C σ i) hBA
    rw [freeCoordinateDerivation_algebraMap, Derivation.leibniz,
      freeCoordinateDerivation_algebraMap, hf i hi, smul_zero, zero_add, smul_eq_mul] at h
    rw [h, mul_comm]
  have hBpd : ∀ i : σ, i ∉ S → MvPolynomial.pderiv i B = 0 := by
    intro i hi
    by_contra hne
    refine Nat.find_min hex (m := (MvPolynomial.pderiv i B).totalDegree) ?_
      ⟨MvPolynomial.pderiv i B, MvPolynomial.pderiv i A, hne, hstep i hi, rfl⟩
    rw [← hBd]
    exact GaloisForLFunctions.totalDegree_pderiv_lt B i hne
  have hApd : ∀ i : σ, i ∉ S → MvPolynomial.pderiv i A = 0 := by
    intro i hi
    refine hinj ?_
    rw [map_zero, hstep i hi, hBpd i hi, map_zero, zero_mul]
  have hBne : algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) B ≠ 0 := fun hcon =>
    hB0 ((map_eq_zero_iff _ hinj).1 hcon)
  have hfeq : algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) A /
      algebraMap (MvPolynomial σ C) (FreeCoordinateRationalField C σ) B = f := by
    rw [hBA]
    field_simp
  rw [← hfeq]
  exact div_mem
    (algebraMap_mem_freeCoordinateField_of_mem_supported
      (MvPolynomial.mem_supported.2 (vars_subset_of_forall_pderiv_eq_zero hApd)))
    (algebraMap_mem_freeCoordinateField_of_mem_supported
      (MvPolynomial.mem_supported.2 (vars_subset_of_forall_pderiv_eq_zero hBpd)))

/-- **The common kernel is exactly the field of the coordinates it does not touch.** -/
theorem freeCoordinateCommonKernelField_eq [CharZero C] (S : Set σ) :
    freeCoordinateCommonKernelField C σ S = freeCoordinateField C σ S :=
  le_antisymm
    (fun _ hf => mem_freeCoordinateField_of_forall_freeCoordinateDerivation_eq_zero hf)
    (freeCoordinateField_le_commonKernel S)

end

end GaloisForLFunctions.HTGeometry
