noncomputable section

namespace GaloisForLFunctions
namespace GradedSourceGenesis

open HTGeometry

/-- Parameter plane underlying the two-observable abelian zeta gas. -/
abbrev GasParameter := ℝ × ℝ

/-- Temperature translation. -/
def temperatureShift (u : ℝ) (x : GasParameter) : GasParameter :=
  (x.1 + u, x.2)

/-- Canonical socle/depth tilt. -/
def socleTilt (x : GasParameter) : GasParameter :=
  (x.1, x.2 + x.1)

/-- Pure fugacity translation generated by schedule exchange. -/
def fugacityShift (u : ℝ) (x : GasParameter) : GasParameter :=
  (x.1, x.2 + u)

/-- The exact affine exchange of the gas temperature and socle formations. -/
theorem gas_exchange (u : ℝ) (x : GasParameter) :
    socleTilt (temperatureShift u x) =
      fugacityShift u (temperatureShift u (socleTilt x)) := by
  ext <;> simp [socleTilt, temperatureShift, fugacityShift, add_assoc]

/-- The marked exchange is genuinely noncommutative. -/
theorem gas_marked_schedules_do_not_commute :
    ∃ x : GasParameter,
      socleTilt (temperatureShift 1 x) ≠ temperatureShift 1 (socleTilt x) := by
  refine ⟨(0, 0), ?_⟩
  intro h
  have h₂ := congrArg Prod.snd h
  simp only [socleTilt, temperatureShift, zero_add, add_zero] at h₂
  exact one_ne_zero h₂

/-- Unit temperature translation on the certified convergent abelian-zeta-gas chamber. -/
def sourceTemperatureStep (θ : AbelianZetaConvergentParameters) :
    AbelianZetaConvergentParameters where
  sigma := θ.sigma + 1
  tau := θ.tau
  sigma_pos := by linarith [θ.sigma_pos]
  tau_nonneg := θ.tau_nonneg
  firstDepth := by linarith [θ.firstDepth]

/-- Unit pure-fugacity translation on the certified gas chamber. -/
def sourceFugacityStep (θ : AbelianZetaConvergentParameters) :
    AbelianZetaConvergentParameters where
  sigma := θ.sigma
  tau := θ.tau + 1
  sigma_pos := θ.sigma_pos
  tau_nonneg := by linarith [θ.tau_nonneg]
  firstDepth := by linarith [θ.firstDepth]

/-- The abstract socle tilt is the parameter shadow of the certified source depth shift. -/
theorem depthShift_parameter_shadow (θ : AbelianZetaConvergentParameters) :
    (θ.depthShift.sigma, θ.depthShift.tau) = socleTilt (θ.sigma, θ.tau) := rfl

/-- The gas exchange holds on the actual certified convergence chamber. -/
theorem source_gas_exchange (θ : AbelianZetaConvergentParameters) :
    (sourceTemperatureStep θ).depthShift =
      sourceFugacityStep (sourceTemperatureStep θ.depthShift) := by
  cases θ with
  | mk toParameters firstDepth =>
      cases toParameters
      simp [sourceTemperatureStep, sourceFugacityStep,
        AbelianZetaConvergentParameters.depthShift, add_assoc]

/-- The two source formations fail to commute at every admitted gas state. -/
theorem source_gas_marked_schedules_do_not_commute (θ : AbelianZetaConvergentParameters) :
    (sourceTemperatureStep θ).depthShift ≠ sourceTemperatureStep θ.depthShift := by
  intro h
  have hτ := congrArg (fun ψ : AbelianZetaConvergentParameters => ψ.tau) h
  simp only [sourceTemperatureStep, AbelianZetaConvergentParameters.depthShift_tau] at hτ
  linarith

open GerbeCharacteristic

/-- Translation on the triptic source lattice. -/
def latticeShift (a x : TripticLattice) : TripticLattice := x + a

/-- Pure source translations commute endpointwise. -/
theorem latticeShift_commute (a b x : TripticLattice) :
    latticeShift a (latticeShift b x) = latticeShift b (latticeShift a x) := by
  simp only [latticeShift]
  ac_rfl

/-- **Two-source graded-genesis capstone.**

One marked source has a nonidentity endpoint exchange.  A second marked source has commuting
endpoint translations while its gamma-gerbe `3`-cocycle is not a coboundary.  Endpoint
commutativity therefore cannot classify source-generated higher law. -/
theorem graded_source_genesis_noncollapse :
    (∀ θ : AbelianZetaConvergentParameters,
      (sourceTemperatureStep θ).depthShift ≠ sourceTemperatureStep θ.depthShift) ∧
    (∀ a b x : TripticLattice,
      latticeShift a (latticeShift b x) = latticeShift b (latticeShift a x)) ∧
    ¬ ∃ g : TripticLattice → TripticLattice → ℤ,
      gammaGerbeDD = coboundary₂ g := by
  exact ⟨source_gas_marked_schedules_do_not_commute, latticeShift_commute,
    gammaGerbeDD_not_coboundary⟩

end GradedSourceGenesis
end GaloisForLFunctions
