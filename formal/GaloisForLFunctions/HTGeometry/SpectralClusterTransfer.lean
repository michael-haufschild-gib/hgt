import GaloisForLFunctions.HTGeometry.ParametricSpectralBranch
import GaloisForLFunctions.HTGeometry.SpectralCausality
import GaloisForLFunctions.HTGeometry.SteinerMobiusDuality
import Mathlib.Data.Finset.NAry

/-!
# Spectral cluster transfer

This module identifies the exact algebraic reason perturbative information is generated only on
connected clusters. An order-`n` term is a sum of words containing at most `n` interaction labels.
Boolean Möbius observation extracts only the words whose label support is the entire probed packet.
Consequently every packet with more than `n` labels is invisible at order `n`.
-/

open scoped BigOperators
open scoped Matrix.Norms.Elementwise
open IncidenceAlgebra
open Filter Topology Asymptotics

namespace GaloisForLFunctions.HTGeometry

/-- Support of a finite interaction word. -/
def interactionWordSupport
    {E : Type*} [Fintype E] [DecidableEq E] {n : ℕ}
    (word : Fin n → E) : Finset E :=
  Finset.univ.image word

/-- A response generated by words of a fixed length. Each word contributes precisely on edge
packets containing every interaction label used by that word. -/
def wordGeneratedResponse
    {E R : Type*} [Fintype E] [DecidableEq E] [CommRing R]
    (n : ℕ) (coefficient : (Fin n → E) → R) : Finset E → R :=
  fun packet =>
    ∑ word : Fin n → E,
      posetZetaFeature (R := R) (interactionWordSupport word) packet *
        coefficient word

/-- A word of length `n` uses at most `n` distinct interaction labels. -/
theorem interactionWordSupport_card_le
    {E : Type*} [Fintype E] [DecidableEq E] {n : ℕ}
    (word : Fin n → E) :
    (interactionWordSupport word).card ≤ n := by
  unfold interactionWordSupport
  exact Finset.card_image_le.trans_eq (Fintype.card_fin n)

/-- **Exact order-by-support law.** A Möbius probe on more than `n` interaction labels annihilates
every response generated by length-`n` words. No locality, probability, positivity, or
self-adjointness assumption is used. -/
theorem posetMobiusProbe_wordGeneratedResponse_eq_zero
    {E R : Type*} [Fintype E] [DecidableEq E] [CommRing R]
    {n : ℕ} (coefficient : (Fin n → E) → R) (packet : Finset E)
    (hcard : n < packet.card) :
    posetMobiusProbe (R := R) packet
      (wordGeneratedResponse n coefficient) = 0 := by
  have hresponse :
      wordGeneratedResponse n coefficient =
        ∑ word : Fin n → E,
          coefficient word •
            posetZetaFeature (R := R) (interactionWordSupport word) := by
    funext state
    simp [wordGeneratedResponse, smul_eq_mul, mul_comm]
  change posetMobiusProbeLinear (R := R) packet
    (wordGeneratedResponse n coefficient) = 0
  rw [hresponse]
  rw [map_sum]
  apply Finset.sum_eq_zero
  intro word hword
  rw [LinearMap.map_smul, posetMobiusProbeLinear_apply,
    posetMobiusProbe_posetZetaFeature]
  have hne : interactionWordSupport word ≠ packet := by
    intro heq
    have hle := interactionWordSupport_card_le word
    rw [heq] at hle
    omega
  simp [hne]

/-! ## Boolean cancellation and disconnected additivity -/

/-- A Boolean Möbius probe vanishes when its response is invariant under one probed interaction
coordinate. -/
theorem finsetMobiusResponse_eq_zero_of_insert_invariant
    {E R : Type*} [DecidableEq E] [CommRing R]
    {packet : Finset E} {e : E} (he : e ∈ packet)
    (response : Finset E → R)
    (hinvariant : ∀ active,
      response (insert e active) = response active) :
    finsetMobiusResponse packet response = 0 := by
  rw [← Finset.insert_erase he,
    finsetMobiusResponse_insert (Finset.notMem_erase e packet)]
  have heq :
      (fun active => response (insert e active)) = response := by
    funext active
    exact hinvariant active
  rw [heq, sub_self]

theorem finsetMobiusResponse_add
    {E R : Type*} [DecidableEq E] [CommRing R]
    (packet : Finset E) (f g : Finset E → R) :
    finsetMobiusResponse packet (f + g) =
      finsetMobiusResponse packet f + finsetMobiusResponse packet g := by
  unfold finsetMobiusResponse
  simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]

/-- The Möbius coefficient of a response additive across two nonempty disjoint packets is zero on
their union. This is the exact disconnected-cluster cancellation law. -/
theorem finsetMobiusResponse_union_eq_zero_of_disjoint_additive
    {E R : Type*} [DecidableEq E] [CommRing R]
    {left right : Finset E} (hdisjoint : Disjoint left right)
    (hleft : left.Nonempty) (hright : right.Nonempty)
    (f g : Finset E → R) :
    finsetMobiusResponse (left ∪ right)
      (fun active => f (active ∩ left) + g (active ∩ right)) = 0 := by
  let fleft : Finset E → R := fun active => f (active ∩ left)
  let gright : Finset E → R := fun active => g (active ∩ right)
  rw [show (fun active => f (active ∩ left) + g (active ∩ right)) =
      fleft + gright by rfl]
  rw [finsetMobiusResponse_add]
  have hfzero : finsetMobiusResponse (left ∪ right) fleft = 0 := by
    obtain ⟨e, he⟩ := hright
    apply finsetMobiusResponse_eq_zero_of_insert_invariant
      (Finset.mem_union_right left he)
    intro active
    unfold fleft
    have henot : e ∉ left := by
      exact fun hel => Finset.disjoint_left.mp hdisjoint hel he
    apply congrArg f
    ext x
    simp only [Finset.mem_inter, Finset.mem_insert]
    constructor
    · rintro ⟨hxe | hxa, hxl⟩
      · exact False.elim (henot (hxe ▸ hxl))
      · exact ⟨hxa, hxl⟩
    · rintro ⟨hxa, hxl⟩
      exact ⟨Or.inr hxa, hxl⟩
  have hgzero : finsetMobiusResponse (left ∪ right) gright = 0 := by
    obtain ⟨e, he⟩ := hleft
    apply finsetMobiusResponse_eq_zero_of_insert_invariant
      (Finset.mem_union_left right he)
    intro active
    unfold gright
    have henot : e ∉ right := by
      exact fun her => Finset.disjoint_left.mp hdisjoint he her
    apply congrArg g
    ext x
    simp only [Finset.mem_inter, Finset.mem_insert]
    constructor
    · rintro ⟨hxe | hxa, hxr⟩
      · exact False.elim (henot (hxe ▸ hxr))
      · exact ⟨hxa, hxr⟩
    · rintro ⟨hxa, hxr⟩
      exact ⟨Or.inr hxa, hxr⟩
  rw [hfzero, hgzero, add_zero]

/-! ## Homogeneous analytic coefficients are word-generated -/

/-- Keep precisely the interaction coordinates belonging to a packet. -/
def restrictInteractionPacket
    {E R : Type*} [DecidableEq E] [Zero R]
    (packet : Finset E) (z : E → R) : E → R :=
  fun e => if e ∈ packet then z e else 0

/-- One interaction coordinate, embedded in the full coupling space. -/
def interactionCoordinateAtom
    {E R : Type*} [DecidableEq E] [Zero R]
    (z : E → R) (e : E) : E → R :=
  Pi.single e (z e)

theorem restrictInteractionPacket_eq_sum_atoms
    {E R : Type*} [DecidableEq E] [AddCommMonoid R]
    (packet : Finset E) (z : E → R) :
    restrictInteractionPacket packet z =
      ∑ e ∈ packet, interactionCoordinateAtom z e := by
  funext i
  by_cases hi : i ∈ packet
  · rw [restrictInteractionPacket, if_pos hi]
    simp [interactionCoordinateAtom, hi]
  · rw [restrictInteractionPacket, if_neg hi]
    simp [interactionCoordinateAtom, hi]

/-- Restricting a homogeneous `n`-linear coefficient to an interaction packet produces exactly a
length-`n` word-generated response. -/
theorem continuousMultilinear_restriction_eq_wordGeneratedResponse
    {E : Type*} [Fintype E] [DecidableEq E] {n : ℕ}
    (p : ContinuousMultilinearMap ℂ (fun _ : Fin n => E → ℂ) ℂ)
    (z : E → ℂ) (packet : Finset E) :
    p (fun _ => restrictInteractionPacket packet z) =
      wordGeneratedResponse n
        (fun word => p (fun i => interactionCoordinateAtom z (word i))) packet := by
  rw [restrictInteractionPacket_eq_sum_atoms]
  rw [p.map_sum_finset
    (fun (_ : Fin n) e => interactionCoordinateAtom z e)
    (fun _ : Fin n => packet)]
  unfold wordGeneratedResponse posetZetaFeature interactionWordSupport
  simp only [zeta_apply]
  simp only [ite_mul, one_mul, zero_mul]
  rw [← Finset.sum_filter]
  apply Finset.sum_congr
  · ext word
    simp [Fintype.mem_piFinset, Finset.image_subset_iff]
  · intro word hword
    simp

/-- **Homogeneous order bound.** A Boolean interaction probe of cardinality greater than `n`
annihilates every restricted homogeneous coefficient of degree `n`. -/
theorem posetMobiusProbe_continuousMultilinear_restriction_eq_zero
    {E : Type*} [Fintype E] [DecidableEq E] {n : ℕ}
    (p : ContinuousMultilinearMap ℂ (fun _ : Fin n => E → ℂ) ℂ)
    (z : E → ℂ) (packet : Finset E) (hcard : n < packet.card) :
    posetMobiusProbe (R := ℂ) packet
      (fun active => p (fun _ => restrictInteractionPacket active z)) = 0 := by
  have hresponse :
      (fun active => p (fun _ => restrictInteractionPacket active z)) =
        wordGeneratedResponse n
          (fun word => p (fun i => interactionCoordinateAtom z (word i))) := by
    funext active
    exact continuousMultilinear_restriction_eq_wordGeneratedResponse p z active
  rw [hresponse]
  exact posetMobiusProbe_wordGeneratedResponse_eq_zero _ _ hcard

/-! ## Exact Taylor-depth filtration -/

/-- Möbius-visible part of the degree-`n` homogeneous coefficient on an interaction packet. -/
noncomputable def interactionMobiusTaylorCoefficient
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    (n : ℕ) (z : E → ℂ) (packet : Finset E) : ℂ :=
  posetMobiusProbe (R := ℂ) packet
    (fun active => series n (fun _ => restrictInteractionPacket active z))

/-- **Taylor depth cannot outrun interaction count.** In every formal analytic series on a finite
interaction space, the degree-`n` coefficient is invisible to every Möbius packet containing more
than `n` interaction labels. -/
theorem interactionMobiusTaylorCoefficient_eq_zero_of_lt_card
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    {n : ℕ} (z : E → ℂ) (packet : Finset E)
    (hcard : n < packet.card) :
    interactionMobiusTaylorCoefficient series n z packet = 0 := by
  exact posetMobiusProbe_continuousMultilinear_restriction_eq_zero
    (series n) z packet hcard

/-- Every homogeneous Taylor coefficient below the packet cardinality vanishes simultaneously. -/
theorem interactionMobiusTaylorCoefficient_eq_zero_below_depth
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    (z : E → ℂ) (packet : Finset E) :
    ∀ n < packet.card,
      interactionMobiusTaylorCoefficient series n z packet = 0 := by
  intro n hn
  exact interactionMobiusTaylorCoefficient_eq_zero_of_lt_card
    series z packet hn

/-- Every Taylor polynomial truncated at depth `r` is annihilated by packets of cardinality at
least `r`, along every scalar coupling ray. -/
theorem posetMobiusProbe_partialSum_eq_zero
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    (z : E → ℂ) (packet : Finset E) (r : ℕ)
    (hdepth : r ≤ packet.card) (g : ℂ) :
    posetMobiusProbe (R := ℂ) packet
      (fun active =>
        series.partialSum r (g • restrictInteractionPacket active z)) = 0 := by
  have hresponse :
      (fun active =>
        series.partialSum r (g • restrictInteractionPacket active z)) =
        ∑ n ∈ Finset.range r,
          g ^ n •
            (fun active =>
              series n (fun _ => restrictInteractionPacket active z)) := by
    funext active
    unfold FormalMultilinearSeries.partialSum
    simp only [Finset.sum_apply, Pi.smul_apply]
    apply Finset.sum_congr rfl
    intro n hn
    have hsmul := (series n).map_smul_univ
      (fun _ : Fin n => g)
      (fun _ : Fin n => restrictInteractionPacket active z)
    simpa [Finset.prod_const, Fintype.card_fin] using hsmul
  change posetMobiusProbeLinear (R := ℂ) packet
    (fun active =>
      series.partialSum r (g • restrictInteractionPacket active z)) = 0
  rw [hresponse, map_sum]
  apply Finset.sum_eq_zero
  intro n hn
  rw [map_smul, posetMobiusProbeLinear_apply]
  have hnlt : n < packet.card := by
    exact (Finset.mem_range.mp hn).trans_le hdepth
  rw [show posetMobiusProbe (R := ℂ) packet
      (fun active =>
        series n (fun _ => restrictInteractionPacket active z)) = 0 by
    exact posetMobiusProbe_continuousMultilinear_restriction_eq_zero
      (series n) z packet hnlt]
  simp

/-- **Sharp analytic onset bound.** If `f` has the formal series `series` at zero, then the
Möbius-visible response of an interaction packet is `O(|g|^|packet|)` along every scalar coupling
ray. This turns exact Taylor-depth cancellation into the observation-time exponent. -/
theorem HasFPowerSeriesAt.posetMobiusProbe_couplingRay_isBigO
    {E : Type*} [Fintype E] [DecidableEq E]
    {f : (E → ℂ) → ℂ}
    {series : FormalMultilinearSeries ℂ (E → ℂ) ℂ}
    (hf : HasFPowerSeriesAt f series 0)
    (z : E → ℂ) (packet : Finset E) :
    (fun g : ℂ =>
      posetMobiusProbe (R := ℂ) packet
        (fun active => f (g • restrictInteractionPacket active z)))
      =O[𝓝 0] fun g : ℂ => ‖g‖ ^ packet.card := by
  let r := packet.card
  let remainder (active : Finset E) (g : ℂ) : ℂ :=
    f (g • restrictInteractionPacket active z) -
      series.partialSum r (g • restrictInteractionPacket active z)
  have hremainder : ∀ active : Finset E,
      remainder active =O[𝓝 0] fun g : ℂ => ‖g‖ ^ r := by
    intro active
    let v : E → ℂ := restrictInteractionPacket active z
    have hk :
        Tendsto (fun g : ℂ => g • v) (𝓝 0) (𝓝 (0 : E → ℂ)) := by
      have hcont : Continuous (fun g : ℂ => g • v) :=
        continuous_id.smul continuous_const
      have hcont0 : ContinuousAt (fun g : ℂ => g • v) 0 :=
        hcont.continuousAt
      change Tendsto (fun g : ℂ => g • v) (𝓝 0) (𝓝 (0 • v)) at hcont0
      simpa using hcont0
    have hcomposed :=
      (hf.isBigO_sub_partialSum_pow r).comp_tendsto hk
    have hnorm :
        (fun g : ℂ => ‖g • v‖ ^ r)
          =O[𝓝 0] fun g : ℂ => ‖g‖ ^ r := by
      apply IsBigO.of_bound (‖v‖ ^ r)
      filter_upwards [] with g
      simp [norm_smul, mul_pow, mul_comm]
    have hfinal := hcomposed.trans hnorm
    simpa [remainder, v, zero_add] using hfinal
  have hsum :
      (fun g : ℂ =>
        ∑ active ∈ Finset.Iic packet,
          mu ℂ active packet * remainder active g)
        =O[𝓝 0] fun g : ℂ => ‖g‖ ^ r := by
    apply IsBigO.sum
    intro active hactive
    exact (hremainder active).const_mul_left (mu ℂ active packet)
  apply hsum.congr_left
  intro g
  symm
  have hpartial :=
    posetMobiusProbe_partialSum_eq_zero
      series z packet r le_rfl g
  calc
    posetMobiusProbe (R := ℂ) packet
        (fun active => f (g • restrictInteractionPacket active z)) =
        posetMobiusProbe (R := ℂ) packet
          (fun active => f (g • restrictInteractionPacket active z)) -
          posetMobiusProbe (R := ℂ) packet
            (fun active =>
              series.partialSum r
                (g • restrictInteractionPacket active z)) := by
      rw [hpartial, sub_zero]
    _ = posetMobiusProbe (R := ℂ) packet
          (fun active => remainder active g) := by
      exact (map_sub (posetMobiusProbeLinear (R := ℂ) packet)
        (fun active => f (g • restrictInteractionPacket active z))
        (fun active =>
          series.partialSum r
            (g • restrictInteractionPacket active z))).symm
    _ = ∑ active ∈ Finset.Iic packet,
          mu ℂ active packet * remainder active g := rfl

/-- Analytic-function form of the sharp packet-onset bound. -/
theorem AnalyticAt.posetMobiusProbe_couplingRay_isBigO
    {E : Type*} [Fintype E] [DecidableEq E]
    {f : (E → ℂ) → ℂ}
    (hf : AnalyticAt ℂ f 0)
    (z : E → ℂ) (packet : Finset E) :
    (fun g : ℂ =>
      posetMobiusProbe (R := ℂ) packet
        (fun active => f (g • restrictInteractionPacket active z)))
      =O[𝓝 0] fun g : ℂ => ‖g‖ ^ packet.card := by
  obtain ⟨series, hseries⟩ := hf
  exact HasFPowerSeriesAt.posetMobiusProbe_couplingRay_isBigO
    hseries z packet

/-! ## Actual affine matrix families -/

/-- Finite matrix family with one independent coupling coordinate for every interaction label. -/
noncomputable def affineMatrixFamily
    {E ι : Type*} [Fintype E]
    (H0 : Matrix ι ι ℂ) (interaction : E → Matrix ι ι ℂ)
    (coupling : E → ℂ) : Matrix ι ι ℂ :=
  H0 + ∑ e, coupling e • interaction e

/-- Every finite affine matrix family is entire in all interaction couplings. -/
theorem affineMatrixFamily_analyticAt
    {E ι : Type*} [Fintype E] [DecidableEq E]
    [Fintype ι] [DecidableEq ι]
    (H0 : Matrix ι ι ℂ) (interaction : E → Matrix ι ι ℂ)
    (coupling0 : E → ℂ) :
    AnalyticAt ℂ (affineMatrixFamily H0 interaction) coupling0 := by
  apply AnalyticAt.pi
  intro i
  apply AnalyticAt.pi
  intro j
  have hsum :
      AnalyticAt ℂ
        (fun coupling : E → ℂ =>
          ∑ e, coupling e * interaction e i j) coupling0 := by
    apply Finset.analyticAt_fun_sum
    intro e he
    have hcoord :
        AnalyticAt ℂ (fun coupling : E → ℂ => coupling e) coupling0 :=
      (ContinuousLinearMap.proj (R := ℂ) e).analyticAt coupling0
    exact hcoord.mul analyticAt_const
  have hconst :
      AnalyticAt ℂ (fun _ : E → ℂ => H0 i j) coupling0 :=
    analyticAt_const
  convert hconst.add hsum using 1
  funext coupling
  change H0 i j + (∑ e, coupling e • interaction e) i j =
    H0 i j + ∑ e, coupling e * interaction e i j
  have hmatrixSum :
      (∑ e, coupling e • interaction e) i j =
        ∑ e, (coupling e • interaction e) i j := by
    simpa using
      (Matrix.sum_apply i j (Finset.univ : Finset E)
        (fun e => coupling e • interaction e))
  rw [hmatrixSum]
  simp [Matrix.smul_apply]

/-- Every simple diagonal level of an affine finite matrix family has an analytic branch in all
interaction couplings. -/
theorem affineMatrixFamily_eigenvalueBranch
    {E ι : Type*} [Fintype E] [DecidableEq E]
    [Fintype ι] [DecidableEq ι]
    (energy : ι → ℂ) (hinj : Function.Injective energy)
    (interaction : E → Matrix ι ι ℂ) (x : ι) :
    ∃ branch : (E → ℂ) → ℂ,
      AnalyticAt ℂ branch 0 ∧ branch 0 = energy x ∧
      (∀ᶠ coupling in 𝓝 0,
        matrixCharpolyRelation
          (affineMatrixFamily (Matrix.diagonal energy) interaction coupling,
            branch coupling) = 0) := by
  apply analyticMatrixFamily_eigenvalueBranch
    (affineMatrixFamily_analyticAt
      (Matrix.diagonal energy) interaction 0)
    energy hinj
  · simp [affineMatrixFamily]

/-- **Universal multi-interaction onset for actual matrix spectra.** For every finite affine matrix
family with a simple uncoupled spectrum, one can label each eigenvalue analytically so that the
irreducible activation contrast of every interaction packet `packet` is
`O(|g| ^ packet.card)`. -/
theorem affineMatrixFamily_eigenvalueBranch_packet_isBigO
    {E ι : Type*} [Fintype E] [DecidableEq E]
    [Fintype ι] [DecidableEq ι]
    (energy : ι → ℂ) (hinj : Function.Injective energy)
    (interaction : E → Matrix ι ι ℂ) (x : ι) :
    ∃ branch : (E → ℂ) → ℂ,
      AnalyticAt ℂ branch 0 ∧ branch 0 = energy x ∧
      (∀ᶠ coupling in 𝓝 0,
        matrixCharpolyRelation
          (affineMatrixFamily (Matrix.diagonal energy) interaction coupling,
            branch coupling) = 0) ∧
      ∀ (z : E → ℂ) (packet : Finset E),
        (fun g : ℂ =>
          posetMobiusProbe (R := ℂ) packet
            (fun active =>
              branch (g • restrictInteractionPacket active z)))
          =O[𝓝 0] fun g : ℂ => ‖g‖ ^ packet.card := by
  obtain ⟨branch, hbranch, hbase, hroot⟩ :=
    affineMatrixFamily_eigenvalueBranch energy hinj interaction x
  refine ⟨branch, hbranch, hbase, hroot, ?_⟩
  intro z packet
  exact AnalyticAt.posetMobiusProbe_couplingRay_isBigO
    hbranch z packet

/-- Exact Möbius reconstruction of each homogeneous Taylor coefficient from its interaction
packets. -/
theorem interactionMobiusTaylorCoefficient_reconstruct
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    (n : ℕ) (z : E → ℂ) :
    series n (fun _ => z) =
      ∑ packet : Finset E,
        interactionMobiusTaylorCoefficient series n z packet := by
  let response : Finset E → ℂ :=
    fun active => series n (fun _ => restrictInteractionPacket active z)
  have hexpand :=
    (posetZetaBasis (P := Finset E) (R := ℂ)).sum_repr response
  have hvalue := congrFun hexpand (Finset.univ : Finset E)
  have hfull :
      response (Finset.univ : Finset E) = series n (fun _ => z) := by
    unfold response
    apply congrArg (series n)
    funext i e
    simp [restrictInteractionPacket]
  rw [hfull] at hvalue
  simp only [Finset.sum_apply, Pi.smul_apply] at hvalue
  rw [← hvalue]
  apply Finset.sum_congr rfl
  intro packet hpacket
  simp [posetZetaBasis_apply, posetZetaBasis_repr,
    interactionMobiusTaylorCoefficient, response,
    posetZetaFeature, zeta_apply]

/-- **Exact finite-depth cluster expansion.** The degree-`n` coefficient is the sum of precisely
the interaction packets containing at most `n` labels; every deeper packet vanishes identically. -/
theorem interactionMobiusTaylorCoefficient_reconstruct_bounded
    {E : Type*} [Fintype E] [DecidableEq E]
    (series : FormalMultilinearSeries ℂ (E → ℂ) ℂ)
    (n : ℕ) (z : E → ℂ) :
    series n (fun _ => z) =
      ∑ packet : Finset E with packet.card ≤ n,
        interactionMobiusTaylorCoefficient series n z packet := by
  rw [interactionMobiusTaylorCoefficient_reconstruct]
  symm
  apply Finset.sum_subset
  · intro packet hpacket
    simp
  · intro packet hpacket hnot
    simp at hnot
    exact interactionMobiusTaylorCoefficient_eq_zero_of_lt_card
      series z packet hnot

end GaloisForLFunctions.HTGeometry
