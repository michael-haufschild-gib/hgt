import GaloisForLFunctions.HTGeometry.DeckClosureStableCore
import GaloisForLFunctions.HTGeometry.TorusGeneralDeck
import GaloisForLFunctions.HTGeometry.TorusPrefixEndomorphism

/-!
# Stable tails of split-torus isogenies

A nonsingular integer matrix defines an actual differential endomorphism of a freely generated
split-torus field.  Its `n`-th iterate is monomial substitution by the matrix power `M ^ n`.
Combining that identity with the finite-depth torus deck theorem gives the full stable tail as the
fixed field of the union of all iterated torsion deck groups.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E] [CharZero C] [IsAlgClosed C]

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

omit [CharZero C] [IsAlgClosed C] in
/-- Iterating a split-torus monomial endomorphism raises its exponent matrix to the same power. -/
theorem torusEndo_pow {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (n : ℕ) :
    (torusEndo hx hgen hM) ^ n =
      torusEndo hx hgen (M := M ^ n) (by
        rw [Matrix.det_pow]
        exact pow_ne_zero n hM) := by
  induction n with
  | zero =>
      rw [pow_zero]
      exact (torusEndo_one hx hgen (by simp)).symm
  | succ n ih =>
      rw [pow_succ, ih]
      change (torusEndo hx hgen (M := M ^ n) _).comp
          (torusEndo hx hgen hM) = _
      rw [torusEndo_comp]
      apply torusEndo_congr hx hgen
      exact (pow_succ' M n).symm

/-- **Split-torus isogeny-tail deck theorem.**  The infinite stable tail of monomial substitution
by a nonsingular integer matrix is exactly the fixed field of the subgroup generated by the
kernels of all matrix-power isogenies acting through constant torus translations. -/
theorem torusIsogenyTail_eq_fixedField_iSup
    {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) :
    stableRangeCore (torusEndo hx hgen hM) =
      IntermediateField.fixedField
        (⨆ n : ℕ,
          ((torusMonomialHom C (M ^ n)).ker).map (torusScaleRep hx hgen)) := by
  apply stableRangeCore_eq_fixedField_iSup
  intro n
  rw [torusEndo_pow hx hgen hM n]
  rw [torusEndo_map_top]
  apply differentialAdjoin_monomialFamily_eq_fixedField hx hgen
  rw [Matrix.det_pow]
  exact pow_ne_zero n hM

/-- Pointwise form of the split-torus tail theorem: an observable survives every depth exactly
when every torsion deck translation at every matrix-power level fixes it. -/
theorem mem_torusIsogenyTail_iff_fixedBy_iteratedDeck
    {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (z : E) :
    z ∈ stableRangeCore (torusEndo hx hgen hM) ↔
      ∀ n, z ∈ IntermediateField.fixedField
        (((torusMonomialHom C (M ^ n)).ker).map (torusScaleRep hx hgen)) := by
  rw [torusIsogenyTail_eq_fixedField_iSup hx hgen hM,
    mem_fixedField_iSup_iff]

end

end GaloisForLFunctions.HTGeometry
