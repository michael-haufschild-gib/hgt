import GaloisForLFunctions.HTGeometry.TopDegreeValuation
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Localization.FractionRing

/-!
# The valuation ring of the degree at infinity

The elements of the coordinate field whose degree in the coordinate `m` is at most zero form a
subring `topInt m`, the valuation ring of `topOrd m`.  It is a discrete valuation ring with fraction
field the coordinate field itself: every ideal is generated by an element of least order, the
non-units are the elements of positive order and so are closed under addition, and the coordinate's
inverse is a nonzero non-unit.

This is the object an algebraic extension of the coordinate field has to be studied over: the places
of the extension above the degree at infinity are the maximal ideals of the integral closure of
`topInt m`, and each of them is an extension of `topOrd m` with a finite ramification index.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-! ## The order of a nonzero element, as an integer -/

theorem topOrdRep_one (m : ℕ) : topOrdRep m (1 : CascadeField) = 0 := by
  have h := topOrd_one m
  rw [topOrd_of_ne_zero (one_ne_zero (α := CascadeField)), WithTop.coe_eq_coe] at h
  exact h

theorem topOrdRep_mul {m : ℕ} {f g : CascadeField} (hf : f ≠ 0) (hg : g ≠ 0) :
    topOrdRep m (f * g) = topOrdRep m f + topOrdRep m g := by
  have h := topOrd_mul m f g
  rw [topOrd_of_ne_zero (mul_ne_zero hf hg), topOrd_of_ne_zero hf, topOrd_of_ne_zero hg,
    ← WithTop.coe_add, WithTop.coe_eq_coe] at h
  exact h

theorem topOrdRep_inv {m : ℕ} {f : CascadeField} (hf : f ≠ 0) :
    topOrdRep m f⁻¹ = -topOrdRep m f := by
  have h := topOrdRep_mul (m := m) hf (inv_ne_zero hf)
  rw [mul_inv_cancel₀ hf, topOrdRep_one] at h
  omega

theorem topOrdRep_fx (m : ℕ) : topOrdRep m (fx m) = -1 := by
  have h := topOrd_fx m
  rw [topOrd_of_ne_zero (fx_ne_zero m), WithTop.coe_eq_coe] at h
  exact h

/-! ## The valuation ring -/

/-- The valuation ring of the degree at infinity in the coordinate `m`. -/
def topInt (m : ℕ) : Subring CascadeField where
  carrier := {f | (0 : WithTop ℤ) ≤ topOrd m f}
  zero_mem' := by
    show (0 : WithTop ℤ) ≤ topOrd m 0
    rw [topOrd_zero]
    exact le_top
  one_mem' := by
    show (0 : WithTop ℤ) ≤ topOrd m 1
    rw [topOrd_one]
    exact le_of_eq (by norm_num)
  add_mem' := by
    intro a b ha hb
    show (0 : WithTop ℤ) ≤ topOrd m (a + b)
    exact le_trans (le_min ha hb) (topOrd_add m a b)
  mul_mem' := by
    intro a b ha hb
    show (0 : WithTop ℤ) ≤ topOrd m (a * b)
    rw [topOrd_mul]
    exact add_nonneg ha hb
  neg_mem' := by
    intro a ha
    show (0 : WithTop ℤ) ≤ topOrd m (-a)
    rwa [topOrd_neg]

theorem mem_topInt {m : ℕ} {f : CascadeField} :
    f ∈ topInt m ↔ (0 : WithTop ℤ) ≤ topOrd m f := Iff.rfl

theorem mem_topInt_iff_rep {m : ℕ} {f : CascadeField} (hf : f ≠ 0) :
    f ∈ topInt m ↔ 0 ≤ topOrdRep m f := by
  rw [mem_topInt, topOrd_of_ne_zero hf, show (0 : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) by norm_num,
    WithTop.coe_le_coe]

theorem topDegLE_zero_iff_mem_topInt {m : ℕ} {f : CascadeField} :
    TopDegLE m 0 f ↔ f ∈ topInt m := by
  rw [topDegLE_iff_le_topOrd, mem_topInt]
  norm_num

theorem topOrdRep_nonneg {m : ℕ} {f : CascadeField} (hmem : f ∈ topInt m) (hf : f ≠ 0) :
    0 ≤ topOrdRep m f := (mem_topInt_iff_rep hf).mp hmem

theorem coe_ne_zero_of_ne_zero {m : ℕ} {a : topInt m} (h : a ≠ 0) : (a : CascadeField) ≠ 0 :=
  fun hc => h (Subtype.ext hc)

/-! ## Units -/

theorem isUnit_topInt_iff {m : ℕ} {a : topInt m} :
    IsUnit a ↔ ∃ h : (a : CascadeField) ≠ 0, topOrdRep m (a : CascadeField) = 0 := by
  constructor
  · rintro ⟨u, rfl⟩
    have hval : ((u : topInt m) : CascadeField) * ((↑u⁻¹ : topInt m) : CascadeField)
        = (1 : CascadeField) := by
      have h := u.mul_inv
      exact congrArg (fun x : topInt m => (x : CascadeField)) h
    have h0 : ((u : topInt m) : CascadeField) ≠ 0 := by
      intro hc
      rw [hc, zero_mul] at hval
      exact zero_ne_one hval
    have h1 : ((↑u⁻¹ : topInt m) : CascadeField) ≠ 0 := by
      intro hc
      rw [hc, mul_zero] at hval
      exact zero_ne_one hval
    refine ⟨h0, ?_⟩
    have hsum := topOrdRep_mul (m := m) h0 h1
    rw [hval, topOrdRep_one] at hsum
    have ha := topOrdRep_nonneg (m := m) (u : topInt m).2 h0
    have hb := topOrdRep_nonneg (m := m) (↑u⁻¹ : topInt m).2 h1
    omega
  · rintro ⟨h0, hz⟩
    have hinv : (a : CascadeField)⁻¹ ∈ topInt m := by
      rw [mem_topInt_iff_rep (inv_ne_zero h0), topOrdRep_inv h0, hz]
      norm_num
    refine ⟨⟨a, ⟨(a : CascadeField)⁻¹, hinv⟩, ?_, ?_⟩, rfl⟩
    · ext
      exact mul_inv_cancel₀ h0
    · ext
      exact inv_mul_cancel₀ h0

theorem not_isUnit_of_pos {m : ℕ} {a : topInt m} (h : 0 < topOrdRep m (a : CascadeField)) :
    ¬ IsUnit a := by
  rw [isUnit_topInt_iff]
  rintro ⟨-, hz⟩
  omega

/-! ## Local -/

theorem pos_topOrdRep_of_not_isUnit {m : ℕ} {a : topInt m} (h : ¬ IsUnit a)
    (h0 : (a : CascadeField) ≠ 0) : 0 < topOrdRep m (a : CascadeField) := by
  have hn := topOrdRep_nonneg a.2 h0
  rcases eq_or_lt_of_le hn with he | hlt
  · exact absurd (isUnit_topInt_iff.mpr ⟨h0, he.symm⟩) h
  · exact hlt

instance topInt_isLocalRing (m : ℕ) : IsLocalRing (topInt m) := by
  refine IsLocalRing.of_nonunits_add ?_
  intro a b ha hb hab
  rw [mem_nonunits_iff] at ha hb
  obtain ⟨hab0, habz⟩ := isUnit_topInt_iff.mp hab
  have hab' : ((a + b : topInt m) : CascadeField) = (a : CascadeField) + (b : CascadeField) := rfl
  rcases eq_or_ne (a : CascadeField) 0 with ha0 | ha0
  · have hb' : ((a + b : topInt m) : CascadeField) = (b : CascadeField) := by
      rw [hab', ha0, zero_add]
    exact hb (isUnit_topInt_iff.mpr ⟨by rw [← hb']; exact hab0, by rw [← hb']; exact habz⟩)
  rcases eq_or_ne (b : CascadeField) 0 with hb0 | hb0
  · have ha' : ((a + b : topInt m) : CascadeField) = (a : CascadeField) := by
      rw [hab', hb0, add_zero]
    exact ha (isUnit_topInt_iff.mpr ⟨by rw [← ha']; exact hab0, by rw [← ha']; exact habz⟩)
  have hA := pos_topOrdRep_of_not_isUnit ha ha0
  have hB := pos_topOrdRep_of_not_isUnit hb hb0
  have hle : min (topOrd m (a : CascadeField)) (topOrd m (b : CascadeField))
      ≤ topOrd m ((a : CascadeField) + (b : CascadeField)) := topOrd_add m _ _
  have hsum0 : ((a : CascadeField) + (b : CascadeField)) ≠ 0 := by
    rw [← hab']
    exact hab0
  rw [topOrd_of_ne_zero ha0, topOrd_of_ne_zero hb0, topOrd_of_ne_zero hsum0,
    ← WithTop.coe_min, WithTop.coe_le_coe] at hle
  have habz' : topOrdRep m ((a : CascadeField) + (b : CascadeField)) = 0 := by
    rw [← hab']
    exact habz
  rw [habz'] at hle
  omega

/-! ## Principal ideals -/

theorem topInt_ideal_isPrincipal (m : ℕ) (I : Ideal (topInt m)) : Submodule.IsPrincipal I := by
  classical
  rcases eq_or_ne I ⊥ with rfl | hI
  · exact ⟨⟨0, by simp⟩⟩
  obtain ⟨a, haI, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  have hac : (a : CascadeField) ≠ 0 := coe_ne_zero_of_ne_zero ha0
  have hS : ∃ n : ℕ, ∃ b ∈ I, (b : CascadeField) ≠ 0 ∧
      topOrdRep m (b : CascadeField) = (n : ℤ) := by
    refine ⟨(topOrdRep m (a : CascadeField)).toNat, a, haI, hac, ?_⟩
    exact (Int.toNat_of_nonneg (topOrdRep_nonneg a.2 hac)).symm
  obtain ⟨g, hgI, hgc, hgd⟩ := Nat.find_spec hS
  refine ⟨⟨g, le_antisymm ?_ ?_⟩⟩
  · intro x hx
    rcases eq_or_ne (x : CascadeField) 0 with hx0 | hx0
    · have hxz : x = 0 := Subtype.ext hx0
      rw [hxz]
      exact Submodule.zero_mem _
    have hxn : Nat.find hS ≤ (topOrdRep m (x : CascadeField)).toNat :=
      Nat.find_le ⟨x, hx, hx0, (Int.toNat_of_nonneg (topOrdRep_nonneg x.2 hx0)).symm⟩
    have hxd : topOrdRep m (g : CascadeField) ≤ topOrdRep m (x : CascadeField) := by
      have h1 : topOrdRep m (x : CascadeField) = ((topOrdRep m (x : CascadeField)).toNat : ℤ) :=
        (Int.toNat_of_nonneg (topOrdRep_nonneg x.2 hx0)).symm
      rw [hgd, h1]
      exact_mod_cast hxn
    have hquot : (x : CascadeField) / (g : CascadeField) ∈ topInt m := by
      rw [mem_topInt_iff_rep (div_ne_zero hx0 hgc), div_eq_mul_inv,
        topOrdRep_mul hx0 (inv_ne_zero hgc), topOrdRep_inv hgc]
      omega
    refine Submodule.mem_span_singleton.mpr
      ⟨⟨(x : CascadeField) / (g : CascadeField), hquot⟩, ?_⟩
    ext
    show (x : CascadeField) / (g : CascadeField) * (g : CascadeField) = (x : CascadeField)
    field_simp
  · rw [Submodule.span_le, Set.singleton_subset_iff]
    exact hgI

instance topInt_isPrincipalIdealRing (m : ℕ) : IsPrincipalIdealRing (topInt m) :=
  ⟨topInt_ideal_isPrincipal m⟩

/-! ## The coordinate's inverse is a nonzero non-unit -/

theorem topOrdRep_inv_fx (m : ℕ) : topOrdRep m ((fx m)⁻¹) = 1 := by
  rw [topOrdRep_inv (fx_ne_zero m), topOrdRep_fx]
  norm_num

theorem inv_fx_mem_topInt (m : ℕ) : (fx m)⁻¹ ∈ topInt m := by
  rw [mem_topInt_iff_rep (inv_ne_zero (fx_ne_zero m)), topOrdRep_inv_fx]
  norm_num

theorem topInt_maximalIdeal_ne_bot (m : ℕ) : IsLocalRing.maximalIdeal (topInt m) ≠ ⊥ := by
  intro h
  have hnotunit : ¬ IsUnit (⟨(fx m)⁻¹, inv_fx_mem_topInt m⟩ : topInt m) := by
    refine not_isUnit_of_pos ?_
    show 0 < topOrdRep m ((fx m)⁻¹)
    rw [topOrdRep_inv_fx]
    norm_num
  have hin : (⟨(fx m)⁻¹, inv_fx_mem_topInt m⟩ : topInt m)
      ∈ IsLocalRing.maximalIdeal (topInt m) := hnotunit
  rw [h, Ideal.mem_bot] at hin
  exact (inv_ne_zero (fx_ne_zero m)) (congrArg (fun x : topInt m => (x : CascadeField)) hin)

instance topInt_isDiscreteValuationRing (m : ℕ) : IsDiscreteValuationRing (topInt m) :=
  ⟨topInt_maximalIdeal_ne_bot m⟩

/-! ## The coordinate field is the fraction field -/

instance topInt_isFractionRing (m : ℕ) : IsFractionRing (topInt m) CascadeField where
  map_units := by
    rintro ⟨y, hy⟩
    rw [mem_nonZeroDivisors_iff_ne_zero] at hy
    exact (isUnit_iff_ne_zero).mpr (coe_ne_zero_of_ne_zero hy)
  surj := by
    intro z
    rcases eq_or_ne z 0 with rfl | hz
    · exact ⟨⟨0, 1⟩, by simp⟩
    rcases le_or_gt (0 : WithTop ℤ) (topOrd m z) with h | h
    · refine ⟨⟨⟨z, h⟩, 1⟩, ?_⟩
      show z * ((1 : topInt m) : CascadeField) = ((⟨z, h⟩ : topInt m) : CascadeField)
      rw [OneMemClass.coe_one, mul_one]
    · have hinv : z⁻¹ ∈ topInt m := by
        rw [mem_topInt_iff_rep (inv_ne_zero hz), topOrdRep_inv hz]
        have hneg : topOrdRep m z < 0 := by
          rw [topOrd_of_ne_zero hz,
            show (0 : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) by norm_num,
            WithTop.coe_lt_coe] at h
          exact h
        omega
      have hinv0 : (⟨z⁻¹, hinv⟩ : topInt m) ∈ nonZeroDivisors (topInt m) := by
        rw [mem_nonZeroDivisors_iff_ne_zero]
        intro hc
        exact (inv_ne_zero hz) (congrArg (fun x : topInt m => (x : CascadeField)) hc)
      exact ⟨⟨1, ⟨⟨z⁻¹, hinv⟩, hinv0⟩⟩, by
        show z * z⁻¹ = ((1 : topInt m) : CascadeField)
        rw [mul_inv_cancel₀ hz]
        rfl⟩
  exists_of_eq := by
    intro x y h
    exact ⟨1, by rw [Subtype.ext h]⟩

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- **The maximal ideal of the valuation ring is generated by the coordinate's inverse.** -/
theorem topInt_maximalIdeal_eq_span (m : ℕ) :
    IsLocalRing.maximalIdeal (topInt m)
      = Ideal.span {(⟨(fx m)⁻¹, inv_fx_mem_topInt m⟩ : topInt m)} := by
  have hu0 : ((⟨(fx m)⁻¹, inv_fx_mem_topInt m⟩ : topInt m) : CascadeField) ≠ 0 :=
    inv_ne_zero (fx_ne_zero m)
  refine le_antisymm ?_ ?_
  · intro x hx
    rcases eq_or_ne (x : CascadeField) 0 with hx0 | hx0
    · have hxz : x = 0 := Subtype.ext hx0
      rw [hxz]
      exact Submodule.zero_mem _
    have hnu : ¬ IsUnit x := hx
    have hord : 0 < topOrdRep m (x : CascadeField) := pos_topOrdRep_of_not_isUnit hnu hx0
    have hquot : (x : CascadeField) / (fx m)⁻¹ ∈ topInt m := by
      rw [mem_topInt_iff_rep (div_ne_zero hx0 (inv_ne_zero (fx_ne_zero m))), div_eq_mul_inv,
        topOrdRep_mul hx0 (inv_ne_zero (inv_ne_zero (fx_ne_zero m))),
        topOrdRep_inv (inv_ne_zero (fx_ne_zero m)), topOrdRep_inv_fx]
      omega
    refine Submodule.mem_span_singleton.mpr
      ⟨⟨(x : CascadeField) / (fx m)⁻¹, hquot⟩, ?_⟩
    ext
    show (x : CascadeField) / (fx m)⁻¹ * (fx m)⁻¹ = (x : CascadeField)
    field_simp
    exact div_self (fx_ne_zero m)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine (IsLocalRing.mem_maximalIdeal _).mpr ?_
    refine not_isUnit_of_pos ?_
    rw [topOrdRep_inv_fx]
    norm_num

end GaloisForLFunctions.HTGeometry
