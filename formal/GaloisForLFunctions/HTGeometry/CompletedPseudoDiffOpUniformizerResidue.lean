import Mathlib.RingTheory.Length
import GaloisForLFunctions.HTGeometry.CompletedPseudoDiffOpResidue

/-!
# Uniformizer generation and residue length

The canonical inverse derivative is packaged inside the completed valuation ring.  It generates
the strict valuation ideal, and the corresponding residue quotient has module length one.  These
are the first exact-length inputs for the additive completed-lattice index.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry.DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K]

/-- The canonical uniformizer as an element of the completed valuation ring. -/
def completedPseudoDiffOpUniformizerInteger : CompletedPseudoDiffOpInteger (K := K) :=
  ⟨(completedPseudoDiffOpUniformizerUnit (K := K) : CompletedPseudoDiffOp K), by
    rw [mem_completedPseudoDiffOpInteger_iff_addValue_nonneg,
      completedPseudoDiffOpAddValue_uniformizer]
    norm_num⟩

@[simp]
theorem completedPseudoDiffOpUniformizerInteger_coe :
    (completedPseudoDiffOpUniformizerInteger (K := K) : CompletedPseudoDiffOp K) =
      completedPseudoDiffOpUniformizerUnit (K := K) := rfl

/-- The canonical uniformizer belongs to the strict valuation ideal. -/
theorem completedPseudoDiffOpUniformizerInteger_mem_maximalIdeal :
    completedPseudoDiffOpUniformizerInteger (K := K) ∈
      completedPseudoDiffOpMaximalIdeal (K := K) := by
  rw [mem_completedPseudoDiffOpMaximalIdeal_iff]
  change completedPseudoDiffOpValuation
    (completedPseudoDiffOpUniformizerUnit (K := K) : CompletedPseudoDiffOp K) < 1
  have h := completedPseudoDiffOpAddValue_uniformizer (K := K)
  change Multiplicative.toAdd
    (completedPseudoDiffOpValuation
      (completedPseudoDiffOpUniformizerUnit (K := K) : CompletedPseudoDiffOp K)) =
        (1 : WithTop ℤ) at h
  have hv : completedPseudoDiffOpValuation
      (completedPseudoDiffOpUniformizerUnit (K := K) : CompletedPseudoDiffOp K) =
        Multiplicative.ofAdd (1 : WithTop ℤ) := by
    exact congrArg Multiplicative.ofAdd h
  rw [hv]
  change (0 : WithTop ℤ) < 1
  norm_num

/-- The strict valuation ideal is the principal left module generated by `∂⁻¹`. -/
theorem completedPseudoDiffOpMaximalIdeal_eq_span_uniformizer :
    (completedPseudoDiffOpMaximalIdeal (K := K) :
      Submodule (CompletedPseudoDiffOpInteger (K := K))
        (CompletedPseudoDiffOpInteger (K := K))) =
      (CompletedPseudoDiffOpInteger (K := K)) ∙
        completedPseudoDiffOpUniformizerInteger (K := K) := by
  apply le_antisymm
  · intro x hx
    rw [Submodule.mem_span_singleton]
    have hxv : completedPseudoDiffOpAddValue
        (completedPseudoDiffOpUniformizerInteger (K := K) : CompletedPseudoDiffOp K) ≤
        completedPseudoDiffOpAddValue (x : CompletedPseudoDiffOp K) := by
      rw [completedPseudoDiffOpUniformizerInteger_coe,
        completedPseudoDiffOpAddValue_uniformizer]
      rw [mem_completedPseudoDiffOpMaximalIdeal_iff] at hx
      change (0 : WithTop ℤ) < completedPseudoDiffOpAddValue
        (x : CompletedPseudoDiffOp K) at hx
      by_cases hx0 : (x : CompletedPseudoDiffOp K) = 0
      · rw [hx0]
        unfold completedPseudoDiffOpAddValue
        rw [Valuation.map_zero]
        exact le_top
      · let xu : (CompletedPseudoDiffOp K)ˣ := Units.mk0 (x : CompletedPseudoDiffOp K) hx0
        have hxval : completedPseudoDiffOpAddValue (x : CompletedPseudoDiffOp K) =
            (completedPseudoDiffOpUnitAddValue xu : WithTop ℤ) := by
          simpa [xu] using completedPseudoDiffOpAddValue_unit_eq_coe xu
        rw [hxval] at hx ⊢
        norm_cast at hx ⊢
    obtain ⟨c, hc⟩ := exists_completedPseudoDiffOpInteger_left_factor
      (a := (completedPseudoDiffOpUniformizerInteger (K := K) : CompletedPseudoDiffOp K))
      (b := (x : CompletedPseudoDiffOp K)) (Units.ne_zero _) hxv
    exact ⟨c, Subtype.ext hc⟩
  · rw [Submodule.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact completedPseudoDiffOpUniformizerInteger_mem_maximalIdeal (K := K)

/-- The completed residue quotient is one simple composition factor over the valuation ring. -/
theorem completedPseudoDiffOpResidue_length_one :
    Module.length (CompletedPseudoDiffOpInteger (K := K))
      (CompletedPseudoDiffOpResidue K) = 1 := by
  exact Module.length_eq_one_iff.2
    (isSimpleModule_iff_isCoatom.2
      (completedPseudoDiffOpMaximalIdeal_isMaximal (K := K)).out)

end

end GaloisForLFunctions.HTGeometry.DiffOp
