import GaloisForLFunctions.HTGeometry.QuotientIdealDimension
import GaloisForLFunctions.HTGeometry.ShiftInvariantSubspace
import GaloisForLFunctions.HTGeometry.PureFibreOccupationBijection

/-!
# Invariant subspaces of the shift are subsets of the roots

An `m`-dimensional subspace of `K[t]/(1 + t^L)` invariant under multiplication by `t` is the ideal
generated by the product of `t - r` over an `n`-element set of roots, `n = L - m`.

Four steps, each already proved: the invariant subspace is an ideal; the ideal is generated by a
monic divisor; the dimension of that ideal fixes the degree of the divisor; and a monic divisor of
the separable split cyclic polynomial is a product over a subset of its roots.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K]

omit [CharZero K] [IsAlgClosed K] in
/-- The image of a polynomial in the quotient is its evaluation at the image of the variable. -/
theorem aeval_mk_X (f : K[X]) (p : K[X]) :
    Polynomial.aeval (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X])) X) p
      = Ideal.Quotient.mk (Ideal.span ({f} : Set K[X])) p := by
  have hext : (Polynomial.aeval (R := K)
        (Ideal.Quotient.mk (Ideal.span ({f} : Set K[X])) X) :
      K[X] →ₐ[K] K[X] ⧸ Ideal.span ({f} : Set K[X]))
      = Ideal.Quotient.mkₐ K (Ideal.span ({f} : Set K[X])) := by
    refine Polynomial.algHom_ext ?_
    rw [Polynomial.aeval_X]
    rfl
  exact congrArg (fun F : K[X] →ₐ[K] K[X] ⧸ Ideal.span ({f} : Set K[X]) => F p) hext

/-- **An `m`-dimensional shift-invariant subspace is cut out by an `n`-element set of roots.** -/
theorem exists_rootSubset_of_invariantSubspace {m n : ℕ} (hL : 0 < m + n)
    (V : Submodule K (K[X] ⧸ Ideal.span
      ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])))
    (hV : ∀ v ∈ V, (Ideal.Quotient.mk
      (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])) X) * v ∈ V)
    (hdim : Module.finrank K V = m) :
    ∃ S : Finset (Fin (m + n)), S.card = n ∧
      ∀ v, v ∈ V ↔ v ∈ Ideal.span ({Ideal.Quotient.mk
        (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X]))
        (∏ i ∈ S, (X - C (pureCriticalRootLabeling (K := K) hL i)))} :
          Set (K[X] ⧸ Ideal.span
            ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X]))) := by
  classical
  have hf0 : pureCriticalCyclicPolynomial (K := K) (m + n) ≠ 0 := by
    rw [pureCriticalCyclicPolynomial]
    exact one_add_X_pow_ne_zero hL
  have hgen : ∀ r : K[X] ⧸ Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X]), ∃ p : K[X],
      r = Polynomial.aeval (Ideal.Quotient.mk (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])) X) p := by
    intro r
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
    exact ⟨p, (aeval_mk_X (pureCriticalCyclicPolynomial (K := K) (m + n)) p).symm⟩
  obtain ⟨g, hgmonic, hgdvd, hIspan⟩ :=
    exists_monic_dvd_of_ideal hf0 (invariantIdeal hgen V hV)
  -- the dimension of the ideal fixes the degree of the generator
  have hVI : Submodule.restrictScalars K
      (Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])))
        (Ideal.span ({g} : Set K[X]))) = V := by
    refine SetLike.ext (fun v => ?_)
    have hmap : Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])))
        (Ideal.span ({g} : Set K[X]))
        = Ideal.span ({Ideal.Quotient.mk (Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X])) g} :
          Set (K[X] ⧸ Ideal.span ({pureCriticalCyclicPolynomial (K := K) (m + n)} : Set K[X]))) := by
      rw [Ideal.map_span]
      congr 1
      simp
    rw [Submodule.restrictScalars_mem, hmap, ← hIspan]
    exact mem_invariantIdeal hgen V hV
  have hdeg : g.natDegree = n := by
    have hsum := finrank_ideal_add_natDegree_of_dvd (K := K) hf0 hgdvd
    rw [hVI, hdim] at hsum
    have hfdeg : (pureCriticalCyclicPolynomial (K := K) (m + n)).natDegree = m + n := by
      rw [pureCriticalCyclicPolynomial, add_comm, ← C_1, natDegree_X_pow_add_C]
    rw [hfdeg] at hsum
    omega
  -- and the generator is a product over a subset of the roots
  obtain ⟨S, hScard, hSprod⟩ := exists_rootSubset_of_monic_dvd hL hgmonic hgdvd
  refine ⟨S, by rw [hScard, hdeg], fun v => ?_⟩
  rw [hSprod, ← hIspan]
  exact (mem_invariantIdeal hgen V hV).symm

end GaloisForLFunctions.HTGeometry
