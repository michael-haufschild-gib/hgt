import GaloisForLFunctions.HTGeometry.CompositionJetField
import GaloisForLFunctions.HTGeometry.AdjoinInsert
import GaloisForLFunctions.HTGeometry.TranscendenceDegreeOneVariable

/-!
# The outer state adds exactly one transcendence degree

Adjoining a composition of transcendental entire functions to the field generated by the coordinate
and the jets of the inner function raises the transcendence degree by exactly one: the composition is
transcendental over that field, and a simple transcendental extension costs one.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic

set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **A transcendental generator adds exactly one transcendence degree.** -/
theorem trdeg_adjoin_insert_eq_add_one
    {S : Set (meroField (Set.univ : Set ℂ))} {x : meroField (Set.univ : Set ℂ)}
    (htr : ¬ IsAlgebraic ↥(IntermediateField.adjoin ℂ S) x) :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ (insert x S))
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ S) + 1 := by
  classical
  set K : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ℂ S with hK
  set y : PUnit.{1} → meroField (Set.univ : Set ℂ) := fun _ => x with hy
  have hrange : Set.range y = ({x} : Set (meroField (Set.univ : Set ℂ))) := by
    rw [hy]
    simp
  have hLeq : (IntermediateField.adjoin ↥K (Set.range y)).restrictScalars ℂ
      = IntermediateField.adjoin ℂ (insert x S) := by
    rw [hrange]
    exact adjoin_insert_eq_restrictScalars S x
  rw [← hLeq]
  show Algebra.trdeg ℂ ↥(IntermediateField.adjoin ↥K (Set.range y))
    = Algebra.trdeg ℂ ↥K + 1
  set M : IntermediateField ↥K (meroField (Set.univ : Set ℂ)) :=
    IntermediateField.adjoin ↥K (Set.range y) with hM
  have hxM : x ∈ M := IntermediateField.subset_adjoin _ _ ⟨PUnit.unit, rfl⟩
  set τ : ↥M := ⟨x, hxM⟩ with hτdef
  have htop : IntermediateField.adjoin ↥K (Set.range (fun _ : PUnit.{1} => τ)) = ⊤ :=
    adjoin_range_lift_eq_top (F := ↥K) (E := meroField (Set.univ : Set ℂ)) y y rfl
  have hrangeτ : Set.range (fun _ : PUnit.{1} => τ) = ({τ} : Set ↥M) := by simp
  haveI : Algebra.IsAlgebraic ↥(Algebra.adjoin ↥K ({τ} : Set ↥M)) ↥M := by
    have h := isAlgebraic_adjoin_of_intermediate_adjoin_eq_top (fun _ : PUnit.{1} => τ) htop
    rwa [hrangeτ] at h
  have htrans : Transcendental ↥K τ := by
    intro halg
    refine htr ?_
    obtain ⟨p, hp0, hp⟩ := halg
    refine ⟨p, hp0, ?_⟩
    have hmap := congrArg (fun t : ↥M => (algebraMap ↥M (meroField (Set.univ : Set ℂ)) t)) hp
    simp only [map_zero] at hmap
    rw [← hmap]
    exact Polynomial.aeval_algebraMap_apply (meroField (Set.univ : Set ℂ)) τ p
  exact trdeg_eq_add_one_of_transcendental τ htrans

/-- **The outer state adds exactly one transcendence degree.** -/
theorem trdeg_adjoin_comp_eq_add_one {f g : ℂ → ℂ} (hf : Differentiable ℂ f)
    (hg : Differentiable ℂ g)
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z) (n : ℕ)
    (hcompan : AnalyticOnNhd ℂ (fun w => f (g w)) (Set.univ : Set ℂ)) :
    Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ
        (insert (analyticMeroElement (fun w => f (g w)) hcompan) (Set.range (jetGen hg n))))
      = Algebra.trdeg ℂ ↥(IntermediateField.adjoin ℂ (Set.range (jetGen hg n))) + 1 :=
  trdeg_adjoin_insert_eq_add_one (not_isAlgebraic_comp_over_jetGen hf hg hfnp hgnp n hcompan)

end

end GaloisForLFunctions.HTGeometry
