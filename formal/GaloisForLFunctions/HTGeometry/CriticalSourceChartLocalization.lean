import GaloisForLFunctions.HTGeometry.CriticalObservationField

/-!
# The critical source chart as a principal open of affine space

The critical source field is the rational function field on the raw coordinates
`x_0, …, x_(m+n-1)`.  This file exhibits the **source chart** — the locus where the constant term,
the marked raw coordinate and the marked reciprocal coordinate are all invertible — as the
principal open of one explicit polynomial

```text
G = X_0 · X_m · N_n,      N_n = the polynomial numerator of `x_0^(n+1) · y_n`.
```

The numerator exists because the inverse recursion only ever divides by the constant term
(`raw_zero_pow_mul_recip_mem`), and `G ≠ 0` because every reciprocal coordinate below the horizon is
nonzero — proved by specialising the generic jet at `1 - t`, whose inverse is the geometric series
(`criticalAmbientRecip_ne_zero`).

Being a principal open of affine space is what makes the complex points of the chart *path
connected*, which is the global connectivity input of the block/étale covering argument on the
critical horizon.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Polynomial

variable (K : Type*) [Field K] (m n : ℕ)

/-! ## The raw coordinate algebra and the numerators of the reciprocal coordinates -/

/-- The raw source coordinates below the critical horizon, indexed by `Fin (m+n)`. -/
def criticalSourceRawFamily : Fin (m + n) → genericJetField K (m + n) :=
  fun j => criticalAmbientRaw K m n (j : ℕ)

/-- The polynomial algebra generated by the raw source coordinates. -/
def criticalSourceRawAlgebra : Subalgebra K (genericJetField K (m + n)) :=
  Algebra.adjoin K (Set.range (criticalSourceRawFamily K m n))

theorem criticalAmbientRaw_mem_criticalSourceRawAlgebra {j : ℕ} (hj : j < m + n) :
    criticalAmbientRaw K m n j ∈ criticalSourceRawAlgebra K m n :=
  Algebra.subset_adjoin ⟨⟨j, hj⟩, rfl⟩

theorem criticalAmbientRaw_zero_mul_recip_zero :
    criticalAmbientRaw K m n 0 * criticalAmbientRecip K m n 0 = 1 := by
  have hmul := congrArg (genericJetFieldMap K (m + n)) (genericRaw_zero_mul_inv K (m + n))
  rw [map_mul, map_one] at hmul
  simpa [criticalAmbientRaw, criticalAmbientRecip, genericRecip] using hmul

theorem criticalAmbientRaw_zero_ne_zero : criticalAmbientRaw K m n 0 ≠ 0 := by
  intro h
  have hone := criticalAmbientRaw_zero_mul_recip_zero K m n
  rw [h, zero_mul] at hone
  exact zero_ne_one hone

theorem genericRecip_zero (N : ℕ) : genericRecip K N 0 = genericInv K N := by
  rw [genericRecip]

theorem criticalAmbientRecip_zero_eq :
    criticalAmbientRecip K m n 0 = genericJetFieldMap K (m + n) (genericInv K (m + n)) := by
  rw [criticalAmbientRecip, genericRecip_zero]

theorem criticalAmbientRecip_succ (k : ℕ) :
    criticalAmbientRecip K m n (k + 1) =
      -(criticalAmbientRecip K m n 0) *
        ∑ i ∈ Finset.range (k + 1),
          criticalAmbientRaw K m n (i + 1) * criticalAmbientRecip K m n (k - i) := by
  rw [criticalAmbientRecip, genericRecip, map_mul, map_neg, map_sum,
    criticalAmbientRecip_zero_eq]
  simp only [criticalAmbientRaw, criticalAmbientRecip, map_mul]

/-- **The reciprocal coordinates have polynomial numerators over powers of the constant term.** -/
theorem raw_zero_pow_mul_recip_mem :
    ∀ k : ℕ, k < m + n →
      criticalAmbientRaw K m n 0 ^ (k + 1) * criticalAmbientRecip K m n k ∈
        criticalSourceRawAlgebra K m n := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hk
    match k with
    | 0 =>
        rw [pow_one, criticalAmbientRaw_zero_mul_recip_zero]
        exact one_mem _
    | (j + 1) =>
        have h1 : criticalAmbientRaw K m n 0 * criticalAmbientRecip K m n 0 = 1 :=
          criticalAmbientRaw_zero_mul_recip_zero K m n
        have hsum : criticalAmbientRaw K m n 0 ^ (j + 1 + 1) *
            (-(criticalAmbientRecip K m n 0) *
              ∑ i ∈ Finset.range (j + 1),
                criticalAmbientRaw K m n (i + 1) * criticalAmbientRecip K m n (j - i))
            = ∑ i ∈ Finset.range (j + 1),
                -(criticalAmbientRaw K m n (i + 1) * criticalAmbientRaw K m n 0 ^ i *
                  (criticalAmbientRaw K m n 0 ^ (j - i + 1) *
                    criticalAmbientRecip K m n (j - i))) := by
          simp only [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i hi => ?_)
          have hi' : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hpow2 : criticalAmbientRaw K m n 0 ^ i *
              criticalAmbientRaw K m n 0 ^ (j - i + 1)
              = criticalAmbientRaw K m n 0 ^ (j + 1) := by
            rw [← pow_add]
            congr 1
            omega
          have hstep : criticalAmbientRaw K m n 0 ^ (j + 1 + 1) *
              (-(criticalAmbientRecip K m n 0) *
                (criticalAmbientRaw K m n (i + 1) * criticalAmbientRecip K m n (j - i)))
              = -((criticalAmbientRaw K m n 0 * criticalAmbientRecip K m n 0) *
                  (criticalAmbientRaw K m n 0 ^ (j + 1) *
                    (criticalAmbientRaw K m n (i + 1) *
                      criticalAmbientRecip K m n (j - i)))) := by
            ring
          rw [hstep, h1, one_mul, ← hpow2]
          ring
        rw [criticalAmbientRecip_succ, hsum]
        refine Subalgebra.sum_mem _ (fun i hi => ?_)
        have hi' : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        refine Subalgebra.neg_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ ?_ ?_) ?_)
        · exact criticalAmbientRaw_mem_criticalSourceRawAlgebra K m n (by omega)
        · exact pow_mem (criticalAmbientRaw_mem_criticalSourceRawAlgebra K m n (by omega)) i
        · exact ih (j - i) (by omega) (by omega)

theorem exists_recipNumerator {k : ℕ} (hk : k < m + n) :
    ∃ N : MvPolynomial (Fin (m + n)) K,
      MvPolynomial.aeval (criticalSourceRawFamily K m n) N =
        criticalAmbientRaw K m n 0 ^ (k + 1) * criticalAmbientRecip K m n k := by
  have h := raw_zero_pow_mul_recip_mem K m n k hk
  rwa [criticalSourceRawAlgebra, Algebra.adjoin_range_eq_range_aeval, AlgHom.mem_range] at h

/-- A polynomial numerator for the `k`-th reciprocal coordinate. -/
def criticalSourceRecipNumerator {k : ℕ} (hk : k < m + n) : MvPolynomial (Fin (m + n)) K :=
  (exists_recipNumerator K m n hk).choose

theorem criticalSourceRecipNumerator_spec {k : ℕ} (hk : k < m + n) :
    MvPolynomial.aeval (criticalSourceRawFamily K m n) (criticalSourceRecipNumerator K m n hk) =
      criticalAmbientRaw K m n 0 ^ (k + 1) * criticalAmbientRecip K m n k :=
  (exists_recipNumerator K m n hk).choose_spec

/-! ## Nonvanishing of the coordinates -/

/-- **Every reciprocal coordinate below the horizon is nonzero**, by specialising the generic jet
at the geometric-series jet `1 - t`, whose inverse has all coefficients equal to one. -/
theorem criticalAmbientRecip_ne_zero {k : ℕ} (hk : k ≤ m + n) :
    criticalAmbientRecip K m n k ≠ 0 := by
  intro h
  have hgen : genericRecip K (m + n) k = 0 := by
    apply genericJetFieldMap_injective K (m + n)
    rw [map_zero]
    exact h
  set Z : K[X] := 1 - Polynomial.X with hZ
  set W : K[X] := ∑ i ∈ Finset.range (m + n + 1), Polynomial.X ^ i with hW
  have hmulZW : Z * W = 1 - Polynomial.X ^ (m + n + 1) := by
    have hgeom := geom_sum_mul (Polynomial.X : K[X]) (m + n + 1)
    have hstep : (Polynomial.X - 1) * W = Polynomial.X ^ (m + n + 1) - 1 := by
      rw [hW, mul_comm]; exact hgeom
    have hneg : Z = -(Polynomial.X - 1) := by rw [hZ]; ring
    rw [hneg, neg_mul, hstep]
    ring
  have hZW : (Polynomial.X : K[X]) ^ (m + n + 1) ∣ Z * W - 1 := by
    rw [hmulZW]
    exact ⟨-1, by ring⟩
  have h0 : IsUnit ((Z : K[X]).coeff 0) := by
    have hc : (Z : K[X]).coeff 0 = 1 := by simp [hZ]
    rw [hc]; exact isUnit_one
  have hlift := jetLift_genericRecip (K := K) (N := m + n) hZW h0 k hk
  rw [hgen, map_zero] at hlift
  have hWk : (W : K[X]).coeff k = 1 := by
    rw [hW, Polynomial.finsetSum_coeff]
    rw [Finset.sum_eq_single k]
    · simp
    · intro b _ hb
      simp [Polynomial.coeff_X_pow, hb.symm]
    · intro hkc
      exact absurd (Finset.mem_range.2 (by omega)) hkc
  rw [hWk] at hlift
  exact zero_ne_one hlift

theorem criticalAmbientRaw_ne_zero {j : ℕ} (hj : j < m + n + 1) :
    criticalAmbientRaw K m n j ≠ 0 := by
  intro h
  have htr := (algebraicIndependent_genericAmbientRaw K (m + n)).transcendental
    (⟨j, hj⟩ : Fin (m + n + 1))
  apply htr
  show IsAlgebraic K (genericJetFieldMap K (m + n) (genericRaw K (m + n) j))
  rw [show genericJetFieldMap K (m + n) (genericRaw K (m + n) j) = criticalAmbientRaw K m n j from
    rfl, h]
  exact isAlgebraic_zero

/-! ## A general injectivity lemma for principal localizations -/

/-- Injectivity of a principal-localization lift of an injective map into a field. -/
theorem injective_awayLift_of_injective {R : Type*} [CommRing R] [IsDomain R]
    {F : Type*} [Field F] (G : R) {g : R →+* F} (hg : Function.Injective g) (hG : g G ≠ 0) :
    Function.Injective
      (IsLocalization.Away.lift (S := Localization.Away G) G (g := g)
        (isUnit_iff_ne_zero.2 hG)) := by
  rw [injective_iff_map_eq_zero]
  intro d hd
  obtain ⟨⟨p, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers G) d
  rw [IsLocalization.Away.lift, IsLocalization.lift_mk'] at hd
  have hp : g p = 0 := by
    rcases mul_eq_zero.1 hd with h | h
    · exact h
    · exact absurd h (Units.ne_zero _)
  have hp0 : p = 0 := hg (by rw [hp, map_zero])
  rw [hp0]
  show IsLocalization.mk' (Localization.Away G) (0 : R) s = 0
  exact IsLocalization.mk'_zero _

/-! ## The source chart ring -/

variable [Fact (0 < m)] [Fact (0 < n)]

/-- **The polynomial inverted by the critical source chart.**  Its zero locus is the union of the
constant-term divisor, the marked raw divisor and the marked reciprocal divisor. -/
def criticalSourceChartPoly : MvPolynomial (Fin (m + n)) K :=
  MvPolynomial.X (⟨0, by have := (Fact.out : 0 < m); omega⟩ : Fin (m + n)) *
    MvPolynomial.X (⟨m, by have := (Fact.out : 0 < n); omega⟩ : Fin (m + n)) *
      criticalSourceRecipNumerator K m n (k := n) (by have := (Fact.out : 0 < m); omega)

theorem criticalSourceChartPoly_eq :
    criticalSourceChartPoly K m n =
      MvPolynomial.X (⟨0, by have := (Fact.out : 0 < m); omega⟩ : Fin (m + n)) *
        MvPolynomial.X (⟨m, by have := (Fact.out : 0 < n); omega⟩ : Fin (m + n)) *
          criticalSourceRecipNumerator K m n (k := n)
            (by have := (Fact.out : 0 < m); omega) := rfl

theorem aeval_criticalSourceChartPoly :
    MvPolynomial.aeval (criticalSourceRawFamily K m n) (criticalSourceChartPoly K m n) =
      criticalAmbientRaw K m n 0 * criticalAmbientRaw K m n m *
        (criticalAmbientRaw K m n 0 ^ (n + 1) * criticalAmbientRecip K m n n) := by
  rw [criticalSourceChartPoly, map_mul, map_mul, criticalSourceRecipNumerator_spec,
    MvPolynomial.aeval_X, MvPolynomial.aeval_X]
  rfl

theorem aeval_criticalSourceChartPoly_ne_zero :
    MvPolynomial.aeval (criticalSourceRawFamily K m n) (criticalSourceChartPoly K m n) ≠ 0 := by
  have hm : 0 < m := Fact.out
  have hn : 0 < n := Fact.out
  rw [aeval_criticalSourceChartPoly]
  refine mul_ne_zero (mul_ne_zero (criticalAmbientRaw_ne_zero K m n (by omega))
    (criticalAmbientRaw_ne_zero K m n (by omega))) ?_
  exact mul_ne_zero (pow_ne_zero _ (criticalAmbientRaw_ne_zero K m n (by omega)))
    (criticalAmbientRecip_ne_zero K m n (by omega))

theorem criticalSourceChartPoly_ne_zero : criticalSourceChartPoly K m n ≠ 0 := by
  intro h
  apply aeval_criticalSourceChartPoly_ne_zero K m n
  rw [h, map_zero]

/-- **Coordinate ring of the critical source chart.** -/
abbrev criticalSourceChartRing : Type _ :=
  Localization.Away (criticalSourceChartPoly K m n)

omit [Fact (0 < m)] [Fact (0 < n)] in
theorem coe_criticalSourceRaw (j : Fin (m + n)) :
    (algebraMap (criticalSourceField K m n) (genericJetField K (m + n)))
        (criticalSourceRaw K m n j) = criticalSourceRawFamily K m n j := rfl

omit [Fact (0 < m)] [Fact (0 < n)] in
private theorem algebraicIndependent_criticalSourceRaw_chart :
    AlgebraicIndependent K (criticalSourceRaw K m n) := by
  have h : AlgebraicIndependent K
      (fun j : Fin (m + n) =>
        (IsScalarTower.toAlgHom K (criticalSourceField K m n) (genericJetField K (m + n)))
          (criticalSourceRaw K m n j)) := algebraicIndependent_criticalAmbientRaw K m n
  exact h.of_comp (IsScalarTower.toAlgHom K (criticalSourceField K m n)
    (genericJetField K (m + n)))

omit [Fact (0 < m)] [Fact (0 < n)] in
theorem aeval_criticalSourceRaw_injective :
    Function.Injective
      (MvPolynomial.aeval (criticalSourceRaw K m n) :
        MvPolynomial (Fin (m + n)) K →ₐ[K] criticalSourceField K m n) :=
  algebraicIndependent_criticalSourceRaw_chart K m n

omit [Fact (0 < m)] [Fact (0 < n)] in
theorem coe_aeval_criticalSourceRaw (p : MvPolynomial (Fin (m + n)) K) :
    (algebraMap (criticalSourceField K m n) (genericJetField K (m + n)))
        (MvPolynomial.aeval (criticalSourceRaw K m n) p) =
      MvPolynomial.aeval (criticalSourceRawFamily K m n) p := by
  have h := MvPolynomial.comp_aeval (R := K) (f := criticalSourceRaw K m n)
    (φ := IsScalarTower.toAlgHom K (criticalSourceField K m n) (genericJetField K (m + n)))
  exact DFunLike.congr_fun h p

theorem aeval_criticalSourceRaw_chartPoly_ne_zero :
    MvPolynomial.aeval (criticalSourceRaw K m n) (criticalSourceChartPoly K m n) ≠ 0 := by
  intro h
  apply aeval_criticalSourceChartPoly_ne_zero K m n
  rw [← coe_aeval_criticalSourceRaw, h, map_zero]

/-- The critical source chart sits inside the actual critical source field. -/
noncomputable instance criticalSourceChartRingAlgebra :
    Algebra (criticalSourceChartRing K m n) (criticalSourceField K m n) :=
  (IsLocalization.Away.lift (S := criticalSourceChartRing K m n)
    (criticalSourceChartPoly K m n)
    (g := (MvPolynomial.aeval (criticalSourceRaw K m n) :
      MvPolynomial (Fin (m + n)) K →ₐ[K] criticalSourceField K m n).toRingHom)
    (isUnit_iff_ne_zero.2 (aeval_criticalSourceRaw_chartPoly_ne_zero K m n))).toAlgebra

theorem algebraMap_criticalSourceChartRing_injective :
    Function.Injective
      (algebraMap (criticalSourceChartRing K m n) (criticalSourceField K m n)) :=
  injective_awayLift_of_injective (criticalSourceChartPoly K m n)
    (aeval_criticalSourceRaw_injective K m n)
    (aeval_criticalSourceRaw_chartPoly_ne_zero K m n)

theorem algebraMap_criticalSourceChartRing_apply (p : MvPolynomial (Fin (m + n)) K) :
    algebraMap (criticalSourceChartRing K m n) (criticalSourceField K m n)
        (algebraMap (MvPolynomial (Fin (m + n)) K) (criticalSourceChartRing K m n) p) =
      MvPolynomial.aeval (criticalSourceRaw K m n) p :=
  IsLocalization.Away.lift_eq _ _ p

instance criticalSourceChartRingGroundTower :
    IsScalarTower K (criticalSourceChartRing K m n) (criticalSourceField K m n) :=
  IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (m + n)) K)
      (criticalSourceChartRing K m n) c, algebraMap_criticalSourceChartRing_apply,
      MvPolynomial.algebraMap_eq, MvPolynomial.aeval_C]

instance criticalSourceChartRing_isIntegrallyClosed :
    IsIntegrallyClosed (criticalSourceChartRing K m n) :=
  isIntegrallyClosed_of_isLocalization _
    (Submonoid.powers (criticalSourceChartPoly K m n))
    (powers_le_nonZeroDivisors_of_noZeroDivisors (criticalSourceChartPoly_ne_zero K m n))

end

end GaloisForLFunctions.HTGeometry
