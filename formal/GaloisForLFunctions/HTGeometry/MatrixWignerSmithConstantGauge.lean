import GaloisForLFunctions.HTGeometry.MatrixWignerSmithFiniteJetRank

/-!
# Constant channel-gauge invariance for Wigner--Smith matrices

Invertible differential-constant left and right channel changes preserve the
differential field generated by a scattering matrix, every finite-jet field,
and every finite-jet algebraic-matroid rank.  The Wigner--Smith matrix is
unchanged by the left change and conjugated by the right change.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

universe u

/-- Entrywise scalar extension of a matrix over the coefficient field. -/
def mappedMatrix
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (U : Matrix (Fin (n + 1)) (Fin (n + 1)) F) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) E :=
  U.map (algebraMap F E)

/-- A matrix over the coefficient field with differential-constant entries
remains entrywise constant after scalar extension. -/
theorem matrixDifferential_mappedMatrix_eq_zero
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (U : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hU : ∀ a b, (U a b)′ = 0) :
    matrixDifferential (mappedMatrix U) =
      (0 : Matrix (Fin (n + 1)) (Fin (n + 1)) E) := by
  ext a b
  simp [matrixDifferential, mappedMatrix, DifferentialAlgebra.deriv_algebraMap, hU]

/-- The entrywise derivative obeys the product rule when the left factor is constant. -/
theorem matrixDifferential_mul_of_left_constant
    {E : Type u} [Field E] [Differential E] {n : ℕ}
    (U S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : matrixDifferential U = 0) :
    matrixDifferential (U * S) = U * matrixDifferential S := by
  have hUab : ∀ a b, (U a b)′ = 0 := by
    intro a b
    have h := congrArg (fun M => M a b) hU
    simpa [matrixDifferential] using h
  ext a b
  rw [matrixDifferential, Matrix.mul_apply, map_sum]
  simp_rw [Derivation.leibniz]
  simp [hUab, matrixDifferential, Matrix.mul_apply]

/-- The entrywise derivative obeys the product rule when the right factor is constant. -/
theorem matrixDifferential_mul_of_right_constant
    {E : Type u} [Field E] [Differential E] {n : ℕ}
    (S V : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hV : matrixDifferential V = 0) :
    matrixDifferential (S * V) = matrixDifferential S * V := by
  have hVab : ∀ a b, (V a b)′ = 0 := by
    intro a b
    have h := congrArg (fun M => M a b) hV
    simpa [matrixDifferential] using h
  ext a b
  rw [matrixDifferential, Matrix.mul_apply, map_sum]
  simp_rw [Derivation.leibniz]
  simp [hVab, matrixDifferential, Matrix.mul_apply, mul_comm]

/-- Entrywise differentiation commutes with a constant two-sided channel change. -/
theorem matrixDifferential_constant_gauge
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : ∀ a b, (U a b)′ = 0) (hV : ∀ a b, (V a b)′ = 0) :
    matrixDifferential (mappedMatrix U * S * mappedMatrix V) =
      mappedMatrix U * matrixDifferential S * mappedMatrix V := by
  rw [matrixDifferential_mul_of_right_constant]
  · rw [matrixDifferential_mul_of_left_constant]
    exact matrixDifferential_mappedMatrix_eq_zero U hU
  · exact matrixDifferential_mappedMatrix_eq_zero V hV

/-- A nonsingular coefficient matrix stays nonsingular after scalar extension. -/
theorem mappedMatrix_det_ne_zero
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (U : Matrix (Fin (n + 1)) (Fin (n + 1)) F) (hU : U.det ≠ 0) :
    (mappedMatrix U).det ≠ (0 : E) := by
  have hdet := (algebraMap F E).map_det U
  simp only [RingHom.mapMatrix_apply] at hdet
  rw [mappedMatrix, ← hdet]
  intro hm
  apply hU
  exact (algebraMap F E).injective (by simpa using hm)

/-- Scalar extension commutes with the adjugate-defined matrix inverse. -/
theorem mappedMatrix_inv_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E] {n : ℕ}
    (U : Matrix (Fin (n + 1)) (Fin (n + 1)) F) :
    (mappedMatrix (E := E) U)⁻¹ = mappedMatrix (E := E) U⁻¹ := by
  ext a b
  simp only [Matrix.inv_def, mappedMatrix, Matrix.map_apply]
  have hdet := (algebraMap F E).map_det U
  have hadj := congrArg (fun M => M a b) ((algebraMap F E).map_adjugate U)
  simp only [RingHom.mapMatrix_apply, Matrix.map_apply] at hdet hadj
  rw [← hdet]
  simp only [Ring.inverse_eq_inv]
  change (algebraMap F E U.det)⁻¹ * (U.map (algebraMap F E)).adjugate a b =
    algebraMap F E (U.det⁻¹ * U.adjugate a b)
  rw [map_mul, map_inv₀, hadj]

/-- A two-sided coefficient-field recombination of matrix entries belongs to
the differential field generated by the original entries. -/
theorem mappedMatrix_mul_mul_entry_mem_differentialAdjoin
    {F E : Type u} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (i j : Fin (n + 1)) :
    (mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) i j ∈
      differentialAdjoin F
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  let B := differentialAdjoin F
    (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2)
  change (mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) i j ∈ B
  rw [Matrix.mul_apply]
  apply B.sum_mem
  intro k _
  apply B.mul_mem
  · rw [Matrix.mul_apply]
    apply B.sum_mem
    intro l _
    exact B.mul_mem (B.algebraMap_mem (U i l))
      (subset_differentialAdjoin F _ ⟨(l, k), rfl⟩)
  · exact B.algebraMap_mem (V k j)

/-- Invertible constant two-sided channel changes preserve the full generated
differential field. -/
theorem differentialAdjoin_constant_gauge_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : U.det ≠ 0) (hV : V.det ≠ 0) :
    differentialAdjoin F
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) =>
          (mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) p.1 p.2) =
      differentialAdjoin F
        (Set.range fun p : Fin (n + 1) × Fin (n + 1) => S p.1 p.2) := by
  let UE := mappedMatrix (E := E) U
  let VE := mappedMatrix (E := E) V
  let T := UE * S * VE
  have hUE : IsUnit UE.det := isUnit_iff_ne_zero.mpr (mappedMatrix_det_ne_zero U hU)
  have hVE : IsUnit VE.det := isUnit_iff_ne_zero.mpr (mappedMatrix_det_ne_zero V hV)
  have hrec : UE⁻¹ * T * VE⁻¹ = S := by
    simp only [T, Matrix.mul_assoc]
    rw [← Matrix.mul_assoc UE⁻¹ UE, Matrix.nonsing_inv_mul UE hUE,
      Matrix.one_mul, Matrix.mul_nonsing_inv VE hVE, Matrix.mul_one]
  apply le_antisymm
  · apply differentialAdjoin_le F
    · rintro _ ⟨p, rfl⟩
      exact mappedMatrix_mul_mul_entry_mem_differentialAdjoin U V S p.1 p.2
    · exact derivationClosed_differentialAdjoin F _
  · apply differentialAdjoin_le F
    · rintro _ ⟨p, rfl⟩
      have hm := mappedMatrix_mul_mul_entry_mem_differentialAdjoin
        (E := E) U⁻¹ V⁻¹ T p.1 p.2
      rw [← mappedMatrix_inv_eq U, ← mappedMatrix_inv_eq V, hrec] at hm
      exact hm
    · exact derivationClosed_differentialAdjoin F _

/-- The matrix obtained by applying an entrywise jet at a fixed order. -/
def matrixDifferentialJet
    {E : Type u} [Field E] [Differential E] {n : ℕ}
    (r : ℕ) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) E :=
  fun a b => differentialJet r (S a b)

/-- Every jet order commutes with a constant two-sided channel change. -/
theorem matrixDifferentialJet_constant_gauge
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : ∀ a b, (U a b)′ = 0) (hV : ∀ a b, (V a b)′ = 0)
    (r : ℕ) :
    matrixDifferentialJet r (mappedMatrix U * S * mappedMatrix V) =
      mappedMatrix U * matrixDifferentialJet r S * mappedMatrix V := by
  induction r with
  | zero =>
      rw [show matrixDifferentialJet 0 S = S by
        ext a b
        exact differentialJet_zero (S a b)]
      ext a b
      exact differentialJet_zero
        ((mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) a b)
  | succ r ih =>
      calc
        matrixDifferentialJet (r + 1) (mappedMatrix U * S * mappedMatrix V) =
            matrixDifferential (matrixDifferentialJet r
              (mappedMatrix U * S * mappedMatrix V)) := by
              ext a b
              simp [matrixDifferentialJet, matrixDifferential, differentialJet_succ]
        _ = matrixDifferential
            (mappedMatrix U * matrixDifferentialJet r S * mappedMatrix V) := by
              rw [ih]
        _ = mappedMatrix U * matrixDifferential
            (matrixDifferentialJet r S) * mappedMatrix V :=
              matrixDifferential_constant_gauge U V (matrixDifferentialJet r S) hU hV
        _ = mappedMatrix U * matrixDifferentialJet (r + 1) S * mappedMatrix V := by
              have hjet : matrixDifferential (matrixDifferentialJet r S) =
                  matrixDifferentialJet (r + 1) S := by
                ext a b
                simp [matrixDifferentialJet, matrixDifferential, differentialJet_succ]
              rw [hjet]

/-- The inverse of a nonsingular differential-constant matrix is differential-constant. -/
theorem matrixDifferential_inv_eq_zero
    {E : Type u} [Field E] [Differential E] {n : ℕ}
    (U : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : U.det ≠ 0)
    (hUc : matrixDifferential U = 0) :
    matrixDifferential U⁻¹ = 0 := by
  have hunit : IsUnit U.det := isUnit_iff_ne_zero.mpr hU
  have hprod : matrixDifferential U⁻¹ * U = 0 := by
    rw [← matrixDifferential_mul_of_right_constant U⁻¹ U hUc]
    rw [Matrix.nonsing_inv_mul U hunit]
    ext a b
    by_cases h : a = b
    · subst b
      simp [matrixDifferential]
    · simp [matrixDifferential, h]
  calc
    matrixDifferential U⁻¹ = matrixDifferential U⁻¹ * 1 := by rw [Matrix.mul_one]
    _ = matrixDifferential U⁻¹ * (U * U⁻¹) := by
      rw [Matrix.mul_nonsing_inv U hunit]
    _ = (matrixDifferential U⁻¹ * U) * U⁻¹ := by rw [Matrix.mul_assoc]
    _ = 0 := by rw [hprod, Matrix.zero_mul]

/-- At every finite jet order, a constant channel change introduces no new field elements. -/
theorem matrixFiniteJetField_constant_gauge_le
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : ∀ a b, (U a b)′ = 0) (hV : ∀ a b, (V a b)′ = 0)
    (r : ℕ) :
    matrixFiniteJetField F (mappedMatrix U * S * mappedMatrix V) r ≤
      matrixFiniteJetField F S r := by
  rw [matrixFiniteJetField_eq_adjoin_packet]
  apply IntermediateField.adjoin_le_iff.mpr
  intro z hz
  change z ∈ matrixFiniteJetPacket
    (mappedMatrix U * S * mappedMatrix V) r at hz
  rw [mem_matrixFiniteJetPacket_iff] at hz
  obtain ⟨p, k, hk, rfl⟩ := hz
  have hjet := congrArg (fun M => M p.1 p.2)
    (matrixDifferentialJet_constant_gauge U V S hU hV k)
  have hjet' : differentialJet k
      ((mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) p.1 p.2) =
      (mappedMatrix (E := E) U * matrixDifferentialJet k S *
        mappedMatrix (E := E) V) p.1 p.2 := by
    simpa [matrixDifferentialJet] using hjet
  change differentialJet k
      ((mappedMatrix (E := E) U * S * mappedMatrix (E := E) V) p.1 p.2) ∈ _
  rw [hjet']
  rw [Matrix.mul_apply]
  apply IntermediateField.sum_mem
  intro j _
  apply IntermediateField.mul_mem
  · rw [Matrix.mul_apply]
    apply IntermediateField.sum_mem
    intro i _
    apply IntermediateField.mul_mem
    · exact IntermediateField.algebraMap_mem _ (U p.1 i)
    · rw [matrixFiniteJetField_eq_adjoin_packet]
      apply IntermediateField.subset_adjoin F
      change differentialJet k (S i j) ∈ matrixFiniteJetPacket S r
      exact (mem_matrixFiniteJetPacket_iff S r _).2
        ⟨(i, j), k, hk, rfl⟩
  · exact IntermediateField.algebraMap_mem _ (V j p.2)

/-- Invertible constant channel changes preserve every finite matrix-jet field exactly. -/
theorem matrixFiniteJetField_constant_gauge_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : U.det ≠ 0) (hV : V.det ≠ 0)
    (hUc : ∀ a b, (U a b)′ = 0) (hVc : ∀ a b, (V a b)′ = 0)
    (r : ℕ) :
    matrixFiniteJetField F (mappedMatrix U * S * mappedMatrix V) r =
      matrixFiniteJetField F S r := by
  let UE := mappedMatrix (E := E) U
  let VE := mappedMatrix (E := E) V
  let T := UE * S * VE
  have hUE : IsUnit UE.det := isUnit_iff_ne_zero.mpr (mappedMatrix_det_ne_zero U hU)
  have hVE : IsUnit VE.det := isUnit_iff_ne_zero.mpr (mappedMatrix_det_ne_zero V hV)
  have hrec : UE⁻¹ * T * VE⁻¹ = S := by
    simp only [T, Matrix.mul_assoc]
    rw [← Matrix.mul_assoc UE⁻¹ UE, Matrix.nonsing_inv_mul UE hUE,
      Matrix.one_mul, Matrix.mul_nonsing_inv VE hVE, Matrix.mul_one]
  have hUmat : matrixDifferential U = 0 := by
    ext a b
    simpa [matrixDifferential] using hUc a b
  have hVmat : matrixDifferential V = 0 := by
    ext a b
    simpa [matrixDifferential] using hVc a b
  have hUinvMat := matrixDifferential_inv_eq_zero U hU hUmat
  have hVinvMat := matrixDifferential_inv_eq_zero V hV hVmat
  have hUinv : ∀ a b, (U⁻¹ a b)′ = 0 := by
    intro a b
    have h := congrArg (fun M => M a b) hUinvMat
    simpa [matrixDifferential] using h
  have hVinv : ∀ a b, (V⁻¹ a b)′ = 0 := by
    intro a b
    have h := congrArg (fun M => M a b) hVinvMat
    simpa [matrixDifferential] using h
  apply le_antisymm
  · exact matrixFiniteJetField_constant_gauge_le U V S hUc hVc r
  · have h := matrixFiniteJetField_constant_gauge_le
      (E := E) U⁻¹ V⁻¹ T hUinv hVinv r
    rw [← mappedMatrix_inv_eq U, ← mappedMatrix_inv_eq V, hrec] at h
    exact h

/-- Consequently every finite-jet algebraic-matroid rank is a constant-channel-gauge invariant. -/
theorem matrixFiniteJetRank_constant_gauge_eq
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ}
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : U.det ≠ 0) (hV : V.det ≠ 0)
    (hUc : ∀ a b, (U a b)′ = 0) (hVc : ∀ a b, (V a b)′ = 0)
    (r : ℕ) :
    matrixFiniteJetRank F (mappedMatrix U * S * mappedMatrix V) r =
      matrixFiniteJetRank F S r := by
  apply Nat.le_antisymm
  · apply finiteAlgebraicMatroidRank_le_of_mem_intermediateAdjoin
    intro z hz
    rw [← matrixFiniteJetField_eq_adjoin_packet S r]
    rw [← matrixFiniteJetField_constant_gauge_eq U V S hU hV hUc hVc r]
    rw [matrixFiniteJetField_eq_adjoin_packet]
    apply IntermediateField.subset_adjoin F
    exact (show z ∈ (↑(matrixFiniteJetPacket
      (mappedMatrix U * S * mappedMatrix V) r) : Set E) by exact_mod_cast hz)
  · apply finiteAlgebraicMatroidRank_le_of_mem_intermediateAdjoin
    intro z hz
    rw [← matrixFiniteJetField_eq_adjoin_packet
      (mappedMatrix U * S * mappedMatrix V) r]
    rw [matrixFiniteJetField_constant_gauge_eq U V S hU hV hUc hVc r]
    rw [matrixFiniteJetField_eq_adjoin_packet]
    apply IntermediateField.subset_adjoin F
    exact (show z ∈ (↑(matrixFiniteJetPacket S r) : Set E) by exact_mod_cast hz)

/-- The Wigner--Smith matrix is left-gauge invariant and right-gauge covariant. -/
theorem matrixWignerSmith_constant_gauge
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {n : ℕ} (ι : F)
    (U V : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) E)
    (hU : U.det ≠ 0)
    (hUc : ∀ a b, (U a b)′ = 0) (hVc : ∀ a b, (V a b)′ = 0) :
    matrixWignerSmith ι (mappedMatrix U * S * mappedMatrix V) =
      (mappedMatrix V)⁻¹ * matrixWignerSmith ι S * mappedMatrix V := by
  let UE := mappedMatrix (E := E) U
  let VE := mappedMatrix (E := E) V
  have hUE : IsUnit UE.det := isUnit_iff_ne_zero.mpr (mappedMatrix_det_ne_zero U hU)
  have hcore :
      (VE⁻¹ * (S⁻¹ * UE⁻¹)) * (UE * matrixDifferential S * VE) =
        VE⁻¹ * (S⁻¹ * matrixDifferential S) * VE := by
    simp only [Matrix.mul_assoc]
    rw [← Matrix.mul_assoc UE⁻¹ UE, Matrix.nonsing_inv_mul UE hUE,
      Matrix.one_mul]
  rw [matrixWignerSmith, matrixDifferential_constant_gauge U V S hUc hVc]
  rw [Matrix.mul_inv_rev, Matrix.mul_inv_rev]
  change -(algebraMap F E ι) •
      ((VE⁻¹ * (S⁻¹ * UE⁻¹)) * (UE * matrixDifferential S * VE)) = _
  rw [hcore]
  change -(algebraMap F E ι) • (VE⁻¹ * (S⁻¹ * matrixDifferential S) * VE) =
    VE⁻¹ * (-(algebraMap F E ι) • (S⁻¹ * matrixDifferential S)) * VE
  rw [Matrix.mul_smul, Matrix.smul_mul]

end

end GaloisForLFunctions.HTGeometry
