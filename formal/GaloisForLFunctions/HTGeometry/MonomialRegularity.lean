import GaloisForLFunctions.HTGeometry.MonomialSpan

/-!
# Regular elements of a monomial algebra

Multiplying by a monomial with unit coefficient translates the support, so membership in the ideal
generated by one monomial inside a monomial algebra is again a support condition — the support must
lie in the translate of the exponent semigroup.  Regularity of a monomial modulo another is
therefore a purely combinatorial condition on the semigroup: translation by the second exponent must
reflect membership in the translate by the first.

This turns every "is this monomial a nonzerodivisor" question in a monomial algebra into a question
about the exponent semigroup, which is how the cone over a rational normal curve is shown to be
Cohen–Macaulay.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u

variable {σ : Type*} {K : Type u} [Field K]

/-- Multiplying by a monomial with unit coefficient translates the support. -/
theorem support_mul_monomial_one (p : MvPolynomial σ K) (b : σ →₀ ℕ) :
    (p * MvPolynomial.monomial b (1 : K)).support = p.support.map (addRightEmbedding b) := by
  classical
  ext m
  simp only [Finset.mem_map, MvPolynomial.mem_support_iff, addRightEmbedding_apply]
  rw [MvPolynomial.coeff_mul_monomial', mul_one]
  constructor
  · intro hm
    by_cases hle : b ≤ m
    · refine ⟨m - b, ?_, tsub_add_cancel_of_le hle⟩
      rwa [if_pos hle] at hm
    · rw [if_neg hle] at hm
      exact absurd rfl hm
  · rintro ⟨e, he, rfl⟩
    have hle : b ≤ e + b := le_add_self
    rw [if_pos hle]
    simpa using he

/-- The image of a monomial span under multiplication by a monomial is the translated span. -/
theorem mem_monomial_mul_monomialSpan_iff {s : Set (σ →₀ ℕ)} {α : σ →₀ ℕ}
    {p : MvPolynomial σ K} :
    (∃ x ∈ monomialSpan K s, p = MvPolynomial.monomial α (1 : K) * x)
      ↔ (↑p.support : Set (σ →₀ ℕ)) ⊆ (fun e => α + e) '' s := by
  classical
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [mem_monomialSpan_iff] at hx
    intro e he
    rw [mul_comm] at he
    rw [support_mul_monomial_one] at he
    simp only [Finset.coe_map, Set.mem_image, Finset.mem_coe, addRightEmbedding_apply] at he
    obtain ⟨f, hf, rfl⟩ := he
    exact ⟨f, hx (by simpa using hf), by rw [add_comm]⟩
  · intro hp
    refine ⟨∑ m ∈ p.support, MvPolynomial.monomial (m - α) (MvPolynomial.coeff m p), ?_, ?_⟩
    · rw [mem_monomialSpan_iff]
      intro e he
      have hsub : e ∈ (p.support.image fun m => m - α) := by
        have := MvPolynomial.support_sum (s := p.support)
          (f := fun m => MvPolynomial.monomial (m - α) (MvPolynomial.coeff m p))
        have hmem := this (by simpa using he)
        rw [Finset.mem_biUnion] at hmem
        obtain ⟨m, hm, hme⟩ := hmem
        have : e = m - α := by
          have hsm := MvPolynomial.support_monomial (a := MvPolynomial.coeff m p) (s := m - α)
          rw [hsm] at hme
          by_cases hz : MvPolynomial.coeff m p = 0
          · simp [hz] at hme
          · rw [if_neg hz] at hme
            simpa using hme
        exact this ▸ Finset.mem_image_of_mem _ hm
      rw [Finset.mem_image] at hsub
      obtain ⟨m, hm, rfl⟩ := hsub
      obtain ⟨f, hf, hfm⟩ := hp (by simpa using hm)
      have : m - α = f := by rw [← hfm]; simp
      exact this ▸ hf
    · rw [Finset.mul_sum]
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff p]
      refine Finset.sum_congr rfl fun m hm => ?_
      obtain ⟨f, _, hfm⟩ := hp (by simpa using hm)
      rw [MvPolynomial.monomial_mul, one_mul]
      congr 1
      rw [← hfm]
      simp

/-- **The regularity criterion for a monomial algebra.**  If, inside the exponent semigroup,
translation by `β` reflects membership in `α + s`, then the monomial of `β` is a nonzerodivisor
modulo the monomial of `α`. -/
theorem monomial_regular_of_semigroup {s : Set (σ →₀ ℕ)} {α β : σ →₀ ℕ}
    (hrefl : ∀ e ∈ s, e + β ∈ (fun f => α + f) '' s → e ∈ (fun f => α + f) '' s)
    {x : MvPolynomial σ K} (hx : x ∈ monomialSpan K s)
    (hmul : ∃ y ∈ monomialSpan K s,
      x * MvPolynomial.monomial β (1 : K) = MvPolynomial.monomial α (1 : K) * y) :
    ∃ z ∈ monomialSpan K s, x = MvPolynomial.monomial α (1 : K) * z := by
  classical
  rw [mem_monomialSpan_iff] at hx
  have hsupp : (↑(x * MvPolynomial.monomial β (1 : K)).support : Set (σ →₀ ℕ))
      ⊆ (fun f => α + f) '' s := by
    obtain ⟨y, hy, hxy⟩ := hmul
    exact mem_monomial_mul_monomialSpan_iff.mp ⟨y, hy, hxy⟩
  rw [support_mul_monomial_one] at hsupp
  refine mem_monomial_mul_monomialSpan_iff.mpr ?_
  intro e he
  have hes : e ∈ s := hx he
  refine hrefl e hes ?_
  refine hsupp ?_
  simp only [Finset.coe_map, Set.mem_image, Finset.mem_coe, addRightEmbedding_apply]
  exact ⟨e, by simpa using he, rfl⟩


end GaloisForLFunctions.HTGeometry
