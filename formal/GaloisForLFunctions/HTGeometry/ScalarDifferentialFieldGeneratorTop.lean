import GaloisForLFunctions.HTGeometry.ScalarDifferentialFieldGenerator

/-!
# The generator differentially generates `C⟨y⟩`

The differential field generated by `y = X_{(),0}` is all of `C⟨y⟩`: its jets are exactly the free
polynomial variables `X_{(),n}`, which generate the polynomial ring `A` as a `C`-algebra; hence the
differential adjoin contains `algebraMap '' A`, and being a subfield of `Frac A` it is everything.

`differentialAdjoin C {y} = ⊤` is the last structural hypothesis of the clock-character law for the
concrete free differential field.
-/

namespace GaloisForLFunctions

noncomputable section

open scoped Differential

variable {C : Type*} [Field C]

/-- **The generator differentially generates the whole field.** -/
theorem differentialAdjoin_scalarDifferentialGenerator_top :
    differentialAdjoin C ({scalarDifferentialGenerator C} : Set (ScalarDifferentialField C)) = ⊤ := by
  -- the free variables map into the differential adjoin (they are the jets of `y`)
  have hsub : (IsScalarTower.toAlgHom C (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        '' Set.range MvPolynomial.X)
      ⊆ (differentialAdjoin C ({scalarDifferentialGenerator C} : Set (ScalarDifferentialField C)) :
          Set (ScalarDifferentialField C)) := by
    rintro _ ⟨_, ⟨p, rfl⟩, rfl⟩
    obtain ⟨u, n⟩ := p
    cases u
    show algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        (MvPolynomial.X ((), n)) ∈ _
    rw [← differentialJet_scalarDifferentialGenerator n]
    exact IntermediateField.subset_adjoin C _ ⟨scalarDifferentialGenerator C, rfl, n, rfl⟩
  have hadjsub : Algebra.adjoin C (IsScalarTower.toAlgHom C (DifferentialPolynomial Unit C)
        (ScalarDifferentialField C) '' Set.range MvPolynomial.X)
      ≤ (differentialAdjoin C ({scalarDifferentialGenerator C} :
          Set (ScalarDifferentialField C))).toSubalgebra :=
    Algebra.adjoin_le hsub
  -- every polynomial value lies in the differential adjoin
  have hstep1 : ∀ a : DifferentialPolynomial Unit C,
      algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C) a
        ∈ differentialAdjoin C ({scalarDifferentialGenerator C} : Set (ScalarDifferentialField C)) := by
    intro a
    have hmem : algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C) a
        ∈ Algebra.adjoin C (IsScalarTower.toAlgHom C (DifferentialPolynomial Unit C)
          (ScalarDifferentialField C) '' Set.range MvPolynomial.X) := by
      rw [Algebra.adjoin_image, MvPolynomial.adjoin_range_X]
      exact ⟨a, Algebra.mem_top, rfl⟩
    rw [← IntermediateField.mem_toSubalgebra]
    exact hadjsub hmem
  -- fraction field: every element is a ratio of polynomial values
  rw [eq_top_iff]
  intro z _
  obtain ⟨x, y, _, hxy⟩ :=
    IsFractionRing.div_surjective (DifferentialPolynomial Unit C) z
  rw [← hxy, div_eq_mul_inv]
  exact mul_mem (hstep1 x) (inv_mem (hstep1 y))

end

end GaloisForLFunctions
