import GaloisForLFunctions.HTGeometry.ProjectiveHorizonHigherRankCurrentAlgebra

/-!
# One opposite horizon generates the `A₂` current algebra

The two-horizon projective-plane current algebra is the affine parabolic
`sl₂(K[t]) ⋉ (K[t]²)ᵛ`: it contains the roots `E₀₁,E₁₀,E₂₀,E₂₁` but not the
opposite transverse roots.  This file proves the minimal rank jump.  Adjoining the single constant
mode `E₀₂` generates every polynomial mode of both missing roots and a second Cartan direction.
Together with the existing five mode families, these are all Chevalley current modes of
`sl₃(K[t])`.

The representation theorem records the corresponding constraint propagation: annihilation by the
old eight depth-two generators and the one opposite-horizon mode forces annihilation by the full
`A₂` current algebra.
-/

open scoped Matrix Polynomial

namespace GaloisForLFunctions

noncomputable section

variable (K : Type*) [Field K]

/-! ## The missing `A₂` modes -/

/-- The opposite transverse-root mode `t^k E₀₂`. -/
def p2CurrentW (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, 0, Polynomial.X ^ k; 0, 0, 0; 0, 0, 0]

/-- The second opposite transverse-root mode `t^k E₁₂`. -/
def p2CurrentX (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, 0, 0; 0, 0, Polynomial.X ^ k; 0, 0, 0]

/-- The second Cartan mode `t^k(E₀₀-E₂₂)`. -/
def p2CurrentJ (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![Polynomial.X ^ k, 0, 0; 0, 0, 0; 0, 0, -(Polynomial.X ^ k)]

/-- The old Cartan current raises the degree of the adjoined opposite shear. -/
theorem p2Current_lie_H_W (i j : ℕ) :
    ⁅p2CurrentH K i, p2CurrentW K j⁆ = p2CurrentW K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentH, p2CurrentW, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm]

/-- Bracketing the old lower root with the opposite shear produces the sixth root family. -/
theorem p2Current_lie_F_W (i j : ℕ) :
    ⁅p2CurrentF K i, p2CurrentW K j⁆ = p2CurrentX K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentF, p2CurrentW, p2CurrentX,
      LieRing.of_associative_ring_bracket, pow_add, mul_comm]

/-- Opposite transverse roots produce the second Cartan direction. -/
theorem p2Current_lie_W_U (i j : ℕ) :
    ⁅p2CurrentW K i, p2CurrentU K j⁆ = p2CurrentJ K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentW, p2CurrentU, p2CurrentJ,
      LieRing.of_associative_ring_bracket, pow_add, mul_comm]

/-! ## Minimal generator and its Lie span -/

/-- The old two-horizon depth-two generators plus one constant opposite transverse shear. -/
def p2A2CurrentGenerators :
    Set (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  insert (p2CurrentW K 0) (p2DepthTwoCurrentGenerators K)

/-- The Lie algebra generated by the three-horizon `A₂` constraint packet. -/
def p2A2CurrentLie :
    LieSubalgebra K (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (p2A2CurrentGenerators K)

section Generation

variable [CharZero K]

omit [CharZero K] in
/-- The old affine-parabolic current algebra embeds in the one-shear enlargement. -/
theorem p2DepthTwoCurrentLie_le_A2CurrentLie :
    p2DepthTwoCurrentLie K ≤ p2A2CurrentLie K := by
  apply LieSubalgebra.lieSpan_le.mpr
  intro A hA
  exact LieSubalgebra.subset_lieSpan (by
    simp only [p2A2CurrentGenerators, Set.mem_insert_iff]
    exact Or.inr hA)

theorem p2CurrentE_mem_A2CurrentLie (k : ℕ) :
    p2CurrentE K k ∈ p2A2CurrentLie K :=
  p2DepthTwoCurrentLie_le_A2CurrentLie K
    (p2CurrentE_mem_depthTwoCurrentLie K k)

theorem p2CurrentF_mem_A2CurrentLie (k : ℕ) :
    p2CurrentF K k ∈ p2A2CurrentLie K :=
  p2DepthTwoCurrentLie_le_A2CurrentLie K
    (p2CurrentF_mem_depthTwoCurrentLie K k)

omit [CharZero K] in
theorem p2CurrentU_mem_A2CurrentLie (k : ℕ) :
    p2CurrentU K k ∈ p2A2CurrentLie K :=
  p2DepthTwoCurrentLie_le_A2CurrentLie K
    (p2CurrentU_mem_depthTwoCurrentLie K k)

omit [CharZero K] in
theorem p2CurrentV_mem_A2CurrentLie (k : ℕ) :
    p2CurrentV K k ∈ p2A2CurrentLie K :=
  p2DepthTwoCurrentLie_le_A2CurrentLie K
    (p2CurrentV_mem_depthTwoCurrentLie K k)

theorem p2CurrentH_mem_A2CurrentLie (k : ℕ) :
    p2CurrentH K k ∈ p2A2CurrentLie K :=
  p2DepthTwoCurrentLie_le_A2CurrentLie K
    (p2CurrentH_mem_depthTwoCurrentLie K k)

/-- The single adjoined constant mode and the old degree-one Cartan generate every `E₀₂` mode. -/
theorem p2CurrentW_mem_A2CurrentLie (k : ℕ) :
    p2CurrentW K k ∈ p2A2CurrentLie K := by
  have hW0 : p2CurrentW K 0 ∈ p2A2CurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2A2CurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2A2CurrentLie K :=
    p2CurrentH_mem_A2CurrentLie K 1
  induction k with
  | zero => exact hW0
  | succ k ih =>
      have hbr := (p2A2CurrentLie K).lie_mem hH1 ih
      rw [p2Current_lie_H_W K 1 k] at hbr
      simpa [Nat.add_comm] using hbr

/-- The old `E₁₀` root brackets with `E₀₂` to generate every `E₁₂` mode. -/
theorem p2CurrentX_mem_A2CurrentLie (k : ℕ) :
    p2CurrentX K k ∈ p2A2CurrentLie K := by
  have hbr := (p2A2CurrentLie K).lie_mem
    (p2CurrentF_mem_A2CurrentLie K 0)
    (p2CurrentW_mem_A2CurrentLie K k)
  rw [p2Current_lie_F_W K 0 k] at hbr
  simpa using hbr

/-- The opposite transverse pair generates every mode of the second Cartan direction. -/
theorem p2CurrentJ_mem_A2CurrentLie (k : ℕ) :
    p2CurrentJ K k ∈ p2A2CurrentLie K := by
  have hbr := (p2A2CurrentLie K).lie_mem
    (p2CurrentW_mem_A2CurrentLie K 0)
    (p2CurrentU_mem_A2CurrentLie K k)
  rw [p2Current_lie_W_U K 0 k] at hbr
  simpa using hbr

/-- **Minimal `A₂` rank jump.**  One opposite-horizon shear added to the two-horizon parabolic
packet generates all six root-current families and two independent Cartan-current families. -/
theorem p2A2CurrentLie_contains_chevalley_modes (k : ℕ) :
    p2CurrentE K k ∈ p2A2CurrentLie K ∧
    p2CurrentF K k ∈ p2A2CurrentLie K ∧
    p2CurrentU K k ∈ p2A2CurrentLie K ∧
    p2CurrentV K k ∈ p2A2CurrentLie K ∧
    p2CurrentW K k ∈ p2A2CurrentLie K ∧
    p2CurrentX K k ∈ p2A2CurrentLie K ∧
    p2CurrentH K k ∈ p2A2CurrentLie K ∧
    p2CurrentJ K k ∈ p2A2CurrentLie K :=
  ⟨p2CurrentE_mem_A2CurrentLie K k,
    p2CurrentF_mem_A2CurrentLie K k,
    p2CurrentU_mem_A2CurrentLie K k,
    p2CurrentV_mem_A2CurrentLie K k,
    p2CurrentW_mem_A2CurrentLie K k,
    p2CurrentX_mem_A2CurrentLie K k,
    p2CurrentH_mem_A2CurrentLie K k,
    p2CurrentJ_mem_A2CurrentLie K k⟩

/-! ## Representation-level propagation -/

/-- Annihilation by the old eight depth-two modes and the one opposite-horizon mode propagates to
all Chevalley current modes of `A₂`. -/
theorem p2A2Current_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅p2CurrentE K 0, v⁆ = 0) (hE1 : ⁅p2CurrentE K 1, v⁆ = 0)
    (hF0 : ⁅p2CurrentF K 0, v⁆ = 0) (hF1 : ⁅p2CurrentF K 1, v⁆ = 0)
    (hU0 : ⁅p2CurrentU K 0, v⁆ = 0) (hU1 : ⁅p2CurrentU K 1, v⁆ = 0)
    (hV0 : ⁅p2CurrentV K 0, v⁆ = 0) (hV1 : ⁅p2CurrentV K 1, v⁆ = 0)
    (hW0 : ⁅p2CurrentW K 0, v⁆ = 0)
    (k : ℕ) :
    ⁅p2CurrentE K k, v⁆ = 0 ∧ ⁅p2CurrentF K k, v⁆ = 0 ∧
    ⁅p2CurrentU K k, v⁆ = 0 ∧ ⁅p2CurrentV K k, v⁆ = 0 ∧
    ⁅p2CurrentW K k, v⁆ = 0 ∧ ⁅p2CurrentX K k, v⁆ = 0 ∧
    ⁅p2CurrentH K k, v⁆ = 0 ∧ ⁅p2CurrentJ K k, v⁆ = 0 := by
  have hgen : p2A2CurrentGenerators K ⊆
      (p2CurrentPointStabilizer (K := K) v : Set _) := by
    intro A hA
    simp only [p2A2CurrentGenerators, Set.mem_insert_iff] at hA
    rcases hA with rfl | hA
    · exact hW0
    · simp only [p2DepthTwoCurrentGenerators, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hA
      rcases hA with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact hE0
      · exact hE1
      · exact hF0
      · exact hF1
      · exact hU0
      · exact hU1
      · exact hV0
      · exact hV1
  have hle : p2A2CurrentLie K ≤ p2CurrentPointStabilizer (K := K) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  exact ⟨hle (p2CurrentE_mem_A2CurrentLie K k),
    hle (p2CurrentF_mem_A2CurrentLie K k),
    hle (p2CurrentU_mem_A2CurrentLie K k),
    hle (p2CurrentV_mem_A2CurrentLie K k),
    hle (p2CurrentW_mem_A2CurrentLie K k),
    hle (p2CurrentX_mem_A2CurrentLie K k),
    hle (p2CurrentH_mem_A2CurrentLie K k),
    hle (p2CurrentJ_mem_A2CurrentLie K k)⟩

end Generation

end

end GaloisForLFunctions
