import GaloisForLFunctions.HTGeometry.BoundedComplexCoefficientProbability
import GaloisForLFunctions.HTGeometry.EntireOrderTwoSeries
import GaloisForLFunctions.HTGeometry.MultivariateEntireCompactOpen
import GaloisForLFunctions.HTGeometry.PolynomialSpectralWeight

/-!
# A total bounded independent-coefficient entire series

Clamping every complex coordinate to a fixed square and dividing by `4 n!` gives a coefficient
sequence bounded by `1/n!` for every input sequence, not merely almost surely.  The standard
exponential-series estimate supplies the global order-two coefficient bound, hence an entire
function.  A one-dimensional wrapper embeds it into the compact-open multivariate source space.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A factorial coefficient bound implies the order-two bound with constant `2`. -/
theorem orderTwo_bound_of_factorial_bound {a : ℕ → ℂ}
    (ha : ∀ n, ‖a n‖ ≤ 1 / (Nat.factorial n : ℝ)) :
    ∀ R : ℝ, 0 < R → ∀ n,
      ‖a n‖ ≤ Real.exp (R ^ 2 * 2 / 2) / R ^ n := by
  intro R hR n
  have hfac : (0 : ℝ) < (Nat.factorial n : ℝ) := by positivity
  have hRpow : 0 < R ^ n := by positivity
  rw [show R ^ 2 * 2 / 2 = R ^ 2 by ring]
  rw [le_div_iff₀ hRpow]
  calc
    ‖a n‖ * R ^ n ≤ (1 / (Nat.factorial n : ℝ)) * R ^ n :=
      mul_le_mul_of_nonneg_right (ha n) hRpow.le
    _ ≤ Real.exp (R ^ 2) := by
      by_cases hR1 : R ≤ 1
      · have hpow : R ^ n ≤ 1 := pow_le_one₀ hR.le hR1
        have hfac1 : (1 : ℝ) ≤ (Nat.factorial n : ℝ) := by
          exact_mod_cast Nat.factorial_pos n
        have hdiv : (1 : ℝ) / (Nat.factorial n : ℝ) ≤ 1 := by
          rw [div_le_one hfac]
          exact hfac1
        calc
          (1 / (Nat.factorial n : ℝ)) * R ^ n ≤ 1 * 1 :=
            mul_le_mul hdiv hpow (pow_nonneg hR.le n) (by norm_num)
          _ ≤ Real.exp (R ^ 2) := by
            simpa using Real.one_le_exp (sq_nonneg R)
      · have hRge : 1 ≤ R := le_of_not_ge hR1
        have hpow := HTGeometry.pow_le_factorial_mul_exp_of_nonneg hR.le n
        have hdiv : R ^ n / (Nat.factorial n : ℝ) ≤ Real.exp R := by
          rw [div_le_iff₀ hfac]
          simpa [mul_comm] using hpow
        have hsq : R ≤ R ^ 2 := by nlinarith
        calc
          (1 / (Nat.factorial n : ℝ)) * R ^ n =
              R ^ n / (Nat.factorial n : ℝ) := by ring
          _ ≤ Real.exp R := hdiv
          _ ≤ Real.exp (R ^ 2) := Real.exp_le_exp.mpr hsq

/-- Total bounded random coefficient attached to one ambient sequence coordinate. -/
def boundedRandomEntireCoeff (x : ℕ → ℂ) (n : ℕ) : ℂ :=
  clampComplexSquare (x n) / ((4 : ℂ) * (Nat.factorial n : ℂ))

theorem norm_boundedRandomEntireCoeff_le (x : ℕ → ℂ) (n : ℕ) :
    ‖boundedRandomEntireCoeff x n‖ ≤ 1 / (Nat.factorial n : ℝ) := by
  rw [boundedRandomEntireCoeff, norm_div, norm_mul, norm_ofNat,
    Complex.norm_natCast]
  have hfac : (0 : ℝ) < (Nat.factorial n : ℝ) := by positivity
  have hden : (0 : ℝ) < 4 * (Nat.factorial n : ℝ) := by positivity
  rw [div_le_iff₀ hden]
  convert norm_clampComplexSquare_le_four (x n) using 1 <;> field_simp

theorem boundedRandomEntireCoeff_orderTwo (x : ℕ → ℂ) :
    ∀ R : ℝ, 0 < R → ∀ n,
      ‖boundedRandomEntireCoeff x n‖ ≤ Real.exp (R ^ 2 * 2 / 2) / R ^ n :=
  orderTwo_bound_of_factorial_bound (norm_boundedRandomEntireCoeff_le x)

/-- The total entire function generated by a clamped coefficient sequence. -/
def boundedRandomEntireFunction (x : ℕ → ℂ) : ℂ → ℂ :=
  entireOfCoeffs (boundedRandomEntireCoeff x)

theorem differentiable_boundedRandomEntireFunction (x : ℕ → ℂ) :
    Differentiable ℂ (boundedRandomEntireFunction x) :=
  differentiable_entireOfCoeffs (boundedRandomEntireCoeff_orderTwo x)

theorem boundedRandomEntireFunction_apply (x : ℕ → ℂ) (z : ℂ) :
    boundedRandomEntireFunction x z =
      ∑' n : ℕ, boundedRandomEntireCoeff x n * z ^ n := rfl

/-- Embed an ordinary entire function into the one-coordinate multivariate source model. -/
def oneDimMultivariateEntireOfDifferentiable (f : ℂ → ℂ) (hf : Differentiable ℂ f) :
    MultivariateEntire 1 :=
  ⟨⟨fun z => f (z 0), hf.continuous.comp (continuous_apply 0)⟩,
    lineEntire_of_differentiable _ (hf.comp (by fun_prop))⟩

@[simp]
theorem oneDimMultivariateEntireOfDifferentiable_apply
    (f : ℂ → ℂ) (hf : Differentiable ℂ f) (z : Fin 1 → ℂ) :
    (oneDimMultivariateEntireOfDifferentiable f hf).1 z = f (z 0) := rfl

/-- The bounded independent-coefficient series as a compact-open one-dimensional entire source. -/
def boundedRandomEntireSource (x : ℕ → ℂ) : MultivariateEntire 1 :=
  oneDimMultivariateEntireOfDifferentiable
    (boundedRandomEntireFunction x) (differentiable_boundedRandomEntireFunction x)

@[simp]
theorem boundedRandomEntireSource_apply (x : ℕ → ℂ) (z : Fin 1 → ℂ) :
    (boundedRandomEntireSource x).1 z =
      ∑' n : ℕ, boundedRandomEntireCoeff x n * (z 0) ^ n := rfl

end

end GaloisForLFunctions.HTGeometry
