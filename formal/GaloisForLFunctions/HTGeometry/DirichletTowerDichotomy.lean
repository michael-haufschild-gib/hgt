import GaloisForLFunctions.HTGeometry.DirichletDefectInertness
import GaloisForLFunctions.HTGeometry.PolarShiftClassification
import GaloisForLFunctions.HTGeometry.OrbitIsolatedPoleLaw
import GaloisForLFunctions.HTGeometry.FiniteDifferentialCircuitBoundary
import Mathlib

/-!
# The exact dichotomy over the Dirichlet tower

Leading-term inertness says that a rational function which is a translation defect of the field
generated by all convergent Dirichlet series is already a translation defect of `C(s)`.
Torsion freeness says that if some nonzero constant-coefficient differential operator sends `b` into
the translation defects of `C(s)` then `b` is one already.

Together they give an exact criterion: for `b` rational, every solution of `y (s+1) - y (s) = b (s)`
is hypertranscendental over the whole Dirichlet tower **iff** `b` is not a translation defect of
`C(s)`.
-/

open Polynomial
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance dichotomyDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance dichotomyDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance dichotomyComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

theorem dirCoordMero_deriv :
    (dirCoordMero)′ = algebraMap ℂ upperEndMeroField (-Complex.I) := by
  have h := deriv_aeval_dirCoordMero (X : ℂ[X])
  simp only [Polynomial.aeval_X, Polynomial.derivative_X, map_one, mul_one] at h
  exact h

theorem deriv_complexConstant (a : ℂ) :
    (algebraMap ℂ upperEndMeroField a)′ = 0 := by
  exact upperEndMero_deriv_complexConstant a

theorem differentialJet_eq_iterate (n : ℕ) (z : upperEndMeroField) :
    differentialJet n z = (fun w : upperEndMeroField => w′)^[n] z := by
  induction n with
  | zero => simp
  | succ n ih => rw [differentialJet_succ, ih, Function.iterate_succ_apply']

/-- **The defect-free hypothesis transfers to the whole Dirichlet tower.** -/
theorem dirZetaBase_defect_eq_zero_of_not_defect {b : upperEndMeroField}
    (hb : b ∈ dirRatBase)
    (hnodef : ¬ ∃ R ∈ dirRatBase,
      upperEndTranslationMeroEquiv Complex.I R - R = b)
    (u : upperEndMeroField) (hu : u ∈ dirZetaBase)
    (v : upperEndMeroField)
    (hv : v ∈ _root_.HTGeometry.defectSpanAll (fun n => differentialJet n b))
    (hduv : upperEndTranslationMeroEquiv Complex.I u - u = v) : v = 0 := by
  classical
  by_contra hv0
  -- the defect is rational, so inertness produces a rational witness
  have hcrat : ∀ w ∈ _root_.HTGeometry.defectSpanAll (fun n => differentialJet n b),
      w ∈ dirRatBase := by
    refine _root_.HTGeometry.defectSpanAll_le_of_mem fun n => ?_
    induction n with
    | zero => simpa using hb
    | succ n ih =>
        rw [differentialJet_succ]
        exact _root_.HTGeometry.coordBase_deriv_mem transcendental_dirCoordMero
          dirCoordMero_deriv deriv_complexConstant ih
  obtain ⟨R, hR, hRdef⟩ := rational_defect_inert hu (hcrat v hv) hduv
  -- write the element of the span with a top index
  obtain ⟨l, hl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hv
  have hlne : l.support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    exact hv0 (by rw [← hl, Finsupp.sum, h, Finset.sum_empty])
  set N : ℕ := l.support.max' hlne with hN
  have hsub : l.support ⊆ Finset.range (N + 1) := by
    intro i hi
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.le_max' _ i hi))
  have hzero : ∀ i ∈ Finset.range (N + 1), i ∉ l.support →
      algebraMap ℂ upperEndMeroField (l i) * (fun z : upperEndMeroField => z′)^[i] b = 0 := by
    intro i _ hnot
    rw [Finsupp.notMem_support_iff.mp hnot, map_zero, zero_mul]
  have hconv : ∀ i : ℕ, l i • (differentialJet i b)
      = algebraMap ℂ upperEndMeroField (l i) * (fun z : upperEndMeroField => z′)^[i] b := by
    intro i
    rw [Algebra.smul_def, differentialJet_eq_iterate]
  have hexpand : ∑ n ∈ Finset.range (N + 1),
      algebraMap ℂ upperEndMeroField (l n) * (fun z : upperEndMeroField => z′)^[n] b
      = upperEndTranslationMeroEquiv Complex.I R - R := by
    rw [hRdef, ← hl, Finsupp.sum]
    simp only [hconv]
    exact (Finset.sum_subset hsub hzero).symm
  exact hnodef (_root_.HTGeometry.defect_of_operator_defect
    (by simp : (-Complex.I) ≠ 0) transcendental_dirCoordMero dirTranslationAlgEquiv
    upperEndTranslate_dirCoordMero dirCoordMero_deriv deriv_complexConstant hb hR
    (Finsupp.mem_support_iff.mp (l.support.max'_mem hlne)) hexpand)


theorem jet_mem_dirRatBase {b : upperEndMeroField} (hb : b ∈ dirRatBase) (n : ℕ) :
    differentialJet n b ∈ dirRatBase := by
  induction n with
  | zero => simpa using hb
  | succ n ih =>
      rw [differentialJet_succ]
      exact _root_.HTGeometry.coordBase_deriv_mem transcendental_dirCoordMero
        dirCoordMero_deriv deriv_complexConstant ih

/-- **No jet lies in the span of its predecessors when `b` is not a defect.** -/
theorem jet_not_mem_defectSpan_of_not_defect {b : upperEndMeroField} (hb : b ∈ dirRatBase)
    (hnodef : ¬ ∃ R ∈ dirRatBase,
      upperEndTranslationMeroEquiv Complex.I R - R = b) (n : ℕ) :
    differentialJet n b ∉ _root_.HTGeometry.defectSpan (fun k => differentialJet k b) n := by
  classical
  intro hmem
  have hQ : ∃ a : ℕ → ℂ, differentialJet n b
      = ∑ i ∈ Finset.range n,
          algebraMap ℂ upperEndMeroField (a i) * differentialJet i b := by
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
    · rintro z ⟨i, hi, rfl⟩
      simp only [Set.mem_Iio] at hi
      refine ⟨fun k => if k = i then 1 else 0, ?_⟩
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj
        simp [hj]
      · intro hnot
        exact absurd (Finset.mem_range.mpr hi) hnot
    · exact ⟨fun _ => 0, by simp⟩
    · rintro z w - - ⟨az, hz⟩ ⟨aw, hw⟩
      refine ⟨fun k => az k + aw k, ?_⟩
      rw [hz, hw, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [map_add, add_mul]
    · rintro t z - ⟨az, hz⟩
      refine ⟨fun k => t * az k, ?_⟩
      rw [Algebra.smul_def, hz, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by rw [map_mul, mul_assoc]
  obtain ⟨a, ha⟩ := hQ
  set A : ℕ → ℂ := fun i => if i = n then -1 else a i with hA
  have hAn : A n = -1 := by simp [hA]
  have hsum : ∑ i ∈ Finset.range (n + 1),
      algebraMap ℂ upperEndMeroField (A i) * (fun z : upperEndMeroField => z′)^[i] b
      = upperEndTranslationMeroEquiv Complex.I 0 - 0 := by
    rw [map_zero, sub_zero, Finset.sum_range_succ, hAn]
    have hlow : ∀ i ∈ Finset.range n,
        algebraMap ℂ upperEndMeroField (A i) * (fun z : upperEndMeroField => z′)^[i] b
          = algebraMap ℂ upperEndMeroField (a i) * differentialJet i b := by
      intro i hi
      have hine : i ≠ n := by
        simp only [Finset.mem_range] at hi
        omega
      rw [differentialJet_eq_iterate, hA]
      simp [hine]
    rw [Finset.sum_congr rfl hlow, ← ha, ← differentialJet_eq_iterate]
    simp
  exact hnodef (_root_.HTGeometry.defect_of_operator_defect
    (by simp : (-Complex.I) ≠ 0) transcendental_dirCoordMero dirTranslationAlgEquiv
    upperEndTranslate_dirCoordMero dirCoordMero_deriv deriv_complexConstant hb
    (zero_mem _) (by rw [hAn]; norm_num) hsum)

/-- **The exact dichotomy over the Dirichlet tower.**  For a rational `b`, every solution of
`y (s + 1) - y (s) = b (s)` is hypertranscendental over the field generated by `C(s)` and every
convergent Dirichlet series **if and only if** `b` is not itself a translation defect of `C(s)`. -/
theorem dirichletTower_hypertranscendental_iff {b : upperEndMeroField} (hb : b ∈ dirRatBase) :
    (∀ y : upperEndMeroField,
        upperEndTranslationMeroEquiv Complex.I y = y + b →
          GaloisForLFunctions.HypertranscendentalOver (dirZetaBase : Type _) y)
      ↔ ¬ ∃ R ∈ dirRatBase,
          upperEndTranslationMeroEquiv Complex.I R - R = b := by
  constructor
  · intro hall hex
    obtain ⟨R, hR, hRdef⟩ := hex
    have hy : upperEndTranslationMeroEquiv Complex.I R = R + b := by
      linear_combination hRdef
    -- a rational solution is not hypertranscendental over the tower
    exact hall R hy (differentialAlgebraicOver_algebraMap
      (F := (dirZetaBase : Type _)) (E := upperEndMeroField)
      ⟨R, dirRatBase_le_dirZetaBase hR⟩)
  · intro hnodef y hy
    have hjet : ∀ n, upperEndTranslationMeroEquiv Complex.I (differentialJet n y)
        = differentialJet n y + differentialJet n b := by
      intro n
      induction n with
      | zero => simpa using hy
      | succ n ih =>
          rw [differentialJet_succ, upperEndTranslationMeroEquiv_deriv, ih, map_add,
            ← differentialJet_succ, ← differentialJet_succ]
    have hfree := dirichletTower_jetTower_transcendental
      (fun n => jet_mem_dirRatBase hb n)
      (_root_.HTGeometry.defectSpanAll_le_of_mem (fun n => jet_mem_dirRatBase hb n))
      (jet_not_mem_defectSpan_of_not_defect hb hnodef)
      (fun u hu v hv hduv =>
        dirZetaBase_defect_eq_zero_of_not_defect hb hnodef u
          (dirRatBase_le_dirZetaBase hu) v hv hduv)
      hjet
    have hind := _root_.HTGeometry.algebraicIndependent_of_jetTower_transcendental dirZetaBase
      (fun n => differentialJet n y) hfree
    rw [GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton]
    have hinj : Function.Injective (fun p : Unit × ℕ => p.2) := by
      rintro ⟨u1, m⟩ ⟨u2, k⟩ h
      simp only at h
      subst h
      rfl
    exact hind.comp (fun p : Unit × ℕ => p.2) hinj

end

end GaloisForLFunctions.HTGeometry
