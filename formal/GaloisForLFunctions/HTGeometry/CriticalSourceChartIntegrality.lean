import GaloisForLFunctions.HTGeometry.CriticalSourceLowValuativeIntegrality
import Mathlib.RingTheory.Valuation.LocalSubring

/-!
# Finiteness of the critical map over the marked observation chart

The integral closure of a subring of a field is the intersection of the valuation subrings
containing it (`iInf_valuationSubring_superset`).  Combined with valuative integrality of the low
blocks this gives the ring-theoretic form of §1's finiteness:

```text
criticalSourceLow_isIntegral_chart :
    every low raw and low reciprocal coordinate is INTEGRAL over the subring generated by the
    observation coordinates together with the inverses of the two marked ones
```

Consequently the source coordinate ring is a finite module over the marked observation chart, so
the critical map does not contract the Schur divisor.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 2000000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}

theorem criticalObservationRaw_ne_zero (hm : 0 < m) (hn : 0 < n) (i : Fin n) :
    criticalObservationRaw K m n i ≠ 0 := by
  intro h
  have hind := algebraicIndependent_criticalFieldObservation K hm hn
  have := hind.transcendental (Sum.inl i)
  apply this
  have hz : criticalFieldObservation K m n (Sum.inl i) = 0 := by
    have := congrArg (fun x : criticalObservationField K m n =>
      (x : genericJetField K (m + n))) h
    simpa [criticalObservationRaw, criticalFieldObservation] using this
  rw [hz]
  exact isAlgebraic_zero

theorem criticalObservationRecip_ne_zero (hm : 0 < m) (hn : 0 < n) (j : Fin m) :
    criticalObservationRecip K m n j ≠ 0 := by
  intro h
  have hind := algebraicIndependent_criticalFieldObservation K hm hn
  have := hind.transcendental (Sum.inr j)
  apply this
  have hz : criticalFieldObservation K m n (Sum.inr j) = 0 := by
    have := congrArg (fun x : criticalObservationField K m n =>
      (x : genericJetField K (m + n))) h
    simpa [criticalObservationRecip, criticalFieldObservation] using this
  rw [hz]
  exact isAlgebraic_zero

theorem criticalSourceRaw_atMarkedIndex_ne_zero (hm : 0 < m) (hn : 0 < n) :
    criticalSourceRaw K m n ⟨m, by omega⟩ ≠ 0 := by
  intro h
  apply criticalObservationRaw_ne_zero K hm hn ⟨0, hn⟩
  apply (algebraMap (criticalObservationField K m n) (criticalSourceField K m n)).injective
  rw [algebraMap_criticalObservationRaw, map_zero]
  convert h using 2
  simp

theorem criticalSourceRecip_atMarkedIndex_ne_zero (hm : 0 < m) (hn : 0 < n) :
    criticalSourceRecip K m n ⟨n, by omega⟩ ≠ 0 := by
  intro h
  apply criticalObservationRecip_ne_zero K hm hn ⟨0, hm⟩
  apply (algebraMap (criticalObservationField K m n) (criticalSourceField K m n)).injective
  rw [algebraMap_criticalObservationRecip, map_zero]
  convert h using 2
  simp

/-- The marked observation chart, as a subset of the source field. -/
noncomputable def criticalObservationChart (hm : 0 < m) (hn : 0 < n) :
    Set (criticalSourceField K m n) :=
  (Set.range fun i : Fin n => criticalSourceRaw K m n ⟨m + (i : ℕ), by omega⟩) ∪
    (Set.range fun j : Fin m => criticalSourceRecip K m n ⟨n + (j : ℕ), by omega⟩) ∪
    {(criticalSourceRaw K m n ⟨m, by omega⟩)⁻¹,
      (criticalSourceRecip K m n ⟨n, by omega⟩)⁻¹}

/-- **The critical low coordinates are integral over the marked observation chart.** -/
theorem criticalSourceLow_isIntegral_chart (hm : 0 < m) (hn : 0 < n) :
    (∀ i : Fin m, IsIntegral (Subring.closure (criticalObservationChart K hm hn))
        (criticalSourceRaw K m n ⟨(i : ℕ), by omega⟩)) ∧
      (∀ j : Fin n, IsIntegral (Subring.closure (criticalObservationChart K hm hn))
        (criticalSourceRecip K m n ⟨(j : ℕ), by omega⟩)) := by
  have hmem : ∀ x : criticalSourceField K m n,
      (∀ V : ValuationSubring (criticalSourceField K m n),
        criticalObservationChart K hm hn ⊆ V.toSubring → x ∈ V) →
      IsIntegral (Subring.closure (criticalObservationChart K hm hn)) x := by
    intro x hx
    rw [← mem_integralClosure_iff]
    show x ∈ (integralClosure (Subring.closure (criticalObservationChart K hm hn))
      (criticalSourceField K m n)).toSubring
    rw [← iInf_valuationSubring_superset]
    rw [Subring.mem_iInf]
    rintro ⟨V, hV⟩
    exact hx V hV
  constructor
  · intro i
    refine hmem _ fun V hV => ?_
    exact (criticalSourceLow_mem_valuationSubring K hm hn V
      (fun i' => hV (Or.inl (Or.inl ⟨i', rfl⟩)))
      (fun j' => hV (Or.inl (Or.inr ⟨j', rfl⟩)))
      (hV (Or.inr (by simp)))
      (hV (Or.inr (by simp)))
      (criticalSourceRaw_atMarkedIndex_ne_zero K hm hn)
      (criticalSourceRecip_atMarkedIndex_ne_zero K hm hn)).1 i
  · intro j
    refine hmem _ fun V hV => ?_
    exact (criticalSourceLow_mem_valuationSubring K hm hn V
      (fun i' => hV (Or.inl (Or.inl ⟨i', rfl⟩)))
      (fun j' => hV (Or.inl (Or.inr ⟨j', rfl⟩)))
      (hV (Or.inr (by simp)))
      (hV (Or.inr (by simp)))
      (criticalSourceRaw_atMarkedIndex_ne_zero K hm hn)
      (criticalSourceRecip_atMarkedIndex_ne_zero K hm hn)).2 j

end GaloisForLFunctions.HTGeometry
