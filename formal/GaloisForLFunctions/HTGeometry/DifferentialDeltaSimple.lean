import Mathlib

/-!
# `δ`-ideals, `δ`-simple differential rings, and their constants

Differential Galois theory is built on Picard--Vessiot rings, and a Picard--Vessiot ring is by
definition a `δ`-simple differential ring: one whose only ideals stable under the derivation are
the trivial ones.  This file supplies that layer for a bare derivation, with no difference operator
present; neither mathlib nor the difference-side development of this repository contains it.

The facts that make the theory work are all here:

* every proper `δ`-ideal is contained in a maximal one, so `δ`-simple quotients exist;
* over a `ℚ`-algebra the nilradical is a `δ`-ideal, so a `δ`-simple ring is reduced;
* the constants of a `δ`-simple ring form a field, because the ideal generated by a constant is a
  `δ`-ideal.

The last is the reason the solution space of a linear differential system is a vector space over a
*field* of constants rather than a module over a ring.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

/-! ### `δ`-ideals -/

/-- An ideal stable under the derivation of a differential ring. -/
def IsDeltaIdeal (I : Ideal R) : Prop := ∀ x ∈ I, x′ ∈ I

theorem isDeltaIdeal_bot : IsDeltaIdeal (⊥ : Ideal R) := by
  intro x hx
  rw [Ideal.mem_bot] at hx ⊢
  rw [hx, map_zero]

theorem isDeltaIdeal_top : IsDeltaIdeal (⊤ : Ideal R) := fun _ _ => trivial

/-- The ideal generated by a constant is a `δ`-ideal. -/
theorem isDeltaIdeal_span_singleton_of_const {c : R} (hc : c′ = 0) :
    IsDeltaIdeal (Ideal.span {c}) := by
  intro x hx
  rw [Ideal.mem_span_singleton] at hx ⊢
  obtain ⟨r, rfl⟩ := hx
  refine ⟨r′, ?_⟩
  rw [Derivation.leibniz, hc]
  simp [smul_eq_mul]

/-! ### The nilradical -/

omit [Differential R] in
/-- Every nonzero natural number is a unit in a `ℚ`-algebra. -/
theorem isUnit_natCast_of_ne_zero [Algebra ℚ R] {n : ℕ} (hn : n ≠ 0) : IsUnit ((n : R)) := by
  have hq : ((n : ℚ)) ≠ 0 := Nat.cast_ne_zero.mpr hn
  have hu : IsUnit ((n : ℚ)) := isUnit_iff_ne_zero.mpr hq
  simpa using hu.map (algebraMap ℚ R)

/-- **The derivative of a nilpotent element is nilpotent** in a `ℚ`-algebra.  If `x ^ n = 0` then
`x ^ (n - k) * (x′) ^ (2k+1) = 0` for every `k ≤ n`, by differentiating and multiplying by `x′`;
at `k = n` this reads `(x′) ^ (2n+1) = 0`. -/
theorem isNilpotent_deriv_of_pow_eq_zero [Algebra ℚ R] {x : R} {n : ℕ} (hx : x ^ n = 0) :
    IsNilpotent (x′) := by
  set y : R := x′ with hy
  have key : ∀ k : ℕ, k ≤ n → x ^ (n - k) * y ^ (2 * k + 1) = 0 := by
    intro k
    induction k with
    | zero => intro _; simp [hx]
    | succ k ih =>
      intro hk
      have hkn : k < n := hk
      have hklt : k ≤ n := le_of_lt hkn
      have h := ih hklt
      set m : ℕ := n - (k + 1) with hm
      have hnk : n - k = m + 1 := by omega
      rw [hnk] at h
      -- differentiate the relation, then multiply by `y`
      have hD : (x ^ (m + 1) * y ^ (2 * k + 1))′ = 0 := by rw [h, map_zero]
      rw [Derivation.leibniz, Derivation.leibniz_pow, Derivation.leibniz_pow] at hD
      simp only [smul_eq_mul, Nat.add_sub_cancel, ← hy, nsmul_eq_mul] at hD
      have hDy : x ^ (m + 1) * (((2 * k + 1 : ℕ) : R) * (y ^ (2 * k) * y′)) * y
          + y ^ (2 * k + 1) * (((m + 1 : ℕ) : R) * (x ^ m * y)) * y = 0 := by
        have hmul := congrArg (fun z : R => z * y) hD
        simpa [add_mul] using hmul
      have hA : x ^ (m + 1) * (((2 * k + 1 : ℕ) : R) * (y ^ (2 * k) * y′)) * y = 0 := by
        have hre : x ^ (m + 1) * (((2 * k + 1 : ℕ) : R) * (y ^ (2 * k) * y′)) * y
            = (((2 * k + 1 : ℕ) : R) * y′) * (x ^ (m + 1) * y ^ (2 * k + 1)) := by ring
        rw [hre, h, mul_zero]
      have hB : y ^ (2 * k + 1) * (((m + 1 : ℕ) : R) * (x ^ m * y)) * y
          = ((m : R) + 1) * (x ^ m * y ^ (2 * k + 3)) := by push_cast; ring
      rw [hA, zero_add, hB] at hDy
      have hunit : IsUnit ((m : R) + 1) := by
        have hcast : ((m + 1 : ℕ) : R) = (m : R) + 1 := by push_cast; ring
        rw [← hcast]
        exact isUnit_natCast_of_ne_zero (Nat.succ_ne_zero m)
      have hz : x ^ m * y ^ (2 * k + 3) = 0 := (hunit.mul_right_eq_zero).mp hDy
      have hkk : 2 * (k + 1) + 1 = 2 * k + 3 := by omega
      rw [hkk]
      exact hz
  have hfin := key n le_rfl
  refine ⟨2 * n + 1, ?_⟩
  simpa using hfin

/-- **The nilradical is a `δ`-ideal** over a `ℚ`-algebra. -/
theorem isDeltaIdeal_nilradical [Algebra ℚ R] : IsDeltaIdeal (nilradical R) := by
  intro x hx
  obtain ⟨n, hn⟩ := hx
  have hn' : x ^ n = 0 := by simpa using hn
  exact mem_nilradical.mpr (isNilpotent_deriv_of_pow_eq_zero hn')

/-! ### Maximal `δ`-ideals -/

/-- **Maximal `δ`-ideals exist.**  Every proper `δ`-ideal is contained in a `δ`-ideal maximal among
the proper `δ`-ideals. -/
theorem exists_maximal_isDeltaIdeal (I : Ideal R) (hI : IsDeltaIdeal I) (hne : I ≠ ⊤) :
    ∃ M : Ideal R, I ≤ M ∧ IsDeltaIdeal M ∧ M ≠ ⊤ ∧
      ∀ J : Ideal R, IsDeltaIdeal J → J ≠ ⊤ → M ≤ J → J = M := by
  classical
  set S : Set (Ideal R) := {J | I ≤ J ∧ IsDeltaIdeal J ∧ J ≠ ⊤} with hS
  have hIS : I ∈ S := ⟨le_rfl, hI, hne⟩
  have hchain : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
    intro c hcS hc
    rcases c.eq_empty_or_nonempty with rfl | hne'
    · exact ⟨I, hIS, by simp⟩
    · refine ⟨sSup c, ⟨?_, ?_, ?_⟩, fun z hz => le_sSup hz⟩
      · obtain ⟨J, hJ⟩ := hne'
        exact le_trans (hcS hJ).1 (le_sSup hJ)
      · intro x hx
        rw [Submodule.mem_sSup_of_directed hne' hc.directedOn] at hx ⊢
        obtain ⟨J, hJc, hxJ⟩ := hx
        exact ⟨J, hJc, (hcS hJc).2.1 x hxJ⟩
      · intro htop
        have h1 : (1 : R) ∈ sSup c := by rw [htop]; trivial
        rw [Submodule.mem_sSup_of_directed hne' hc.directedOn] at h1
        obtain ⟨J, hJc, h1J⟩ := h1
        exact (hcS hJc).2.2 (Ideal.eq_top_of_isUnit_mem J h1J isUnit_one)
  obtain ⟨M, hMS, hmax⟩ := zorn_le₀ S hchain
  exact ⟨M, hMS.1, hMS.2.1, hMS.2.2, fun J hJ hJtop hle =>
    le_antisymm (hmax ⟨le_trans hMS.1 hle, hJ, hJtop⟩ hle) hle⟩

/-! ### `δ`-simple rings -/

/-- A differential ring is `δ`-simple when its only `δ`-ideals are the trivial ones. -/
def IsDeltaSimple (R : Type*) [CommRing R] [Differential R] : Prop :=
  ∀ I : Ideal R, IsDeltaIdeal I → I = ⊥ ∨ I = ⊤

/-- **A `δ`-simple `ℚ`-algebra is reduced.**  The nilradical is a `δ`-ideal, and it is proper. -/
theorem isReduced_of_isDeltaSimple [Nontrivial R] [Algebra ℚ R] (h : IsDeltaSimple R) :
    IsReduced R := by
  have hnil : nilradical R = ⊥ := by
    rcases h _ isDeltaIdeal_nilradical with hb | ht
    · exact hb
    · exfalso
      have h1 : (1 : R) ∈ nilradical R := by rw [ht]; trivial
      obtain ⟨n, hn⟩ := h1
      rw [one_pow] at hn
      exact one_ne_zero hn
  refine ⟨fun x hx => ?_⟩
  have hxn : x ∈ nilradical R := mem_nilradical.mpr hx
  rw [hnil] at hxn
  simpa using hxn

/-- **Nonzero constants of a `δ`-simple ring are units.** -/
theorem isUnit_of_isDeltaSimple_of_const [Nontrivial R] (h : IsDeltaSimple R)
    {c : R} (hc : c′ = 0) (hc0 : c ≠ 0) : IsUnit c := by
  rcases h _ (isDeltaIdeal_span_singleton_of_const hc) with hb | ht
  · exact absurd (Ideal.mem_bot.mp (hb ▸ Ideal.mem_span_singleton_self c)) hc0
  · exact Ideal.span_singleton_eq_top.mp ht

/-- The inverse of a constant unit is constant. -/
theorem const_inv_of_const {c u : R} (hc : c′ = 0) (hcu : c * u = 1) : u′ = 0 := by
  have h1 : c * u′ = 0 := by
    have h := congrArg (Differential.deriv (R := R)) hcu
    rw [Derivation.leibniz, hc, Derivation.map_one_eq_zero] at h
    simpa [smul_eq_mul] using h
  calc u′ = (c * u) * u′ := by rw [hcu, one_mul]
    _ = u * (c * u′) := by ring
    _ = 0 := by rw [h1, mul_zero]

/-! ### The constants -/

/-- The constants of a differential ring. -/
def deltaConstantsSubring (R : Type*) [CommRing R] [Differential R] : Subring R where
  carrier := {x | x′ = 0}
  mul_mem' := by
    intro a b ha hb
    show (a * b)′ = 0
    rw [Derivation.leibniz]
    simp only [Set.mem_setOf_eq] at ha hb
    rw [ha, hb]
    simp
  one_mem' := by
    show (1 : R)′ = 0
    exact Derivation.map_one_eq_zero _
  add_mem' := by
    intro a b ha hb
    show (a + b)′ = 0
    simp only [Set.mem_setOf_eq] at ha hb
    rw [map_add, ha, hb, add_zero]
  zero_mem' := by
    show (0 : R)′ = 0
    exact map_zero _
  neg_mem' := by
    intro a ha
    show (-a)′ = 0
    simp only [Set.mem_setOf_eq] at ha
    rw [map_neg, ha, neg_zero]

@[simp] theorem mem_deltaConstantsSubring {x : R} :
    x ∈ deltaConstantsSubring R ↔ x′ = 0 := Iff.rfl

/-- **The constants of a `δ`-simple ring form a field.**  This is what makes the solution space of
a linear differential system a vector space, and it is the reason Picard--Vessiot rings are
required to be `δ`-simple. -/
theorem isField_deltaConstantsSubring_of_isDeltaSimple [Nontrivial R] (h : IsDeltaSimple R) :
    IsField (deltaConstantsSubring R) := by
  refine ⟨⟨0, 1, ?_⟩, fun {a b} => mul_comm a b, ?_⟩
  · intro h01
    exact zero_ne_one (congrArg Subtype.val h01)
  · rintro ⟨c, hc⟩ hc0
    have hcne : c ≠ 0 := fun hzero => hc0 (Subtype.ext hzero)
    obtain ⟨u, hu⟩ := isUnit_of_isDeltaSimple_of_const h hc hcne
    have hcu : c * (u.inv : R) = 1 := by
      rw [← hu]
      exact u.val_inv
    exact ⟨⟨(u.inv : R), const_inv_of_const hc hcu⟩, Subtype.ext hcu⟩

end

end GaloisForLFunctions.HTGeometry
