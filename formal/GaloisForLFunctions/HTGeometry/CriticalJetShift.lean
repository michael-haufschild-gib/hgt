import Mathlib.Analysis.Normed.Lp.lpSpace
import Mathlib.LinearAlgebra.LinearPMap
import Mathlib.Topology.Algebra.Module.LinearPMap

/-!
# The critical vertical jet derivative is closed, densely defined and unbounded

In normalized Taylor coordinates `(a_k)` the vertical derivative is the weighted shift

`D(a)_k = (k+1) a_{k+1}`.

This is the critical Gevrey-one normalization: the unnormalized jet is `k! a_k`, and the factor
`k+1` makes the operator genuinely unbounded.  This file constructs `D` as a partially defined
operator on `ℓ²(ℕ)`, on its natural domain, and proves the three structural facts the completed
descent complex needs:

* its graph is exactly the coordinate condition `b_k = (k+1) a_{k+1}`, hence **closed**;
* every coordinate single lies in the domain, so the domain is **dense**;
* on the unit vector in coordinate `N+1` the operator has norm `N+1`, so it is **unbounded**.

Unboundedness is therefore not inserted as a defect in descent, nor generated by an evolution
parameter: it is the closed vertical jet operator on the completed static object.
-/

noncomputable section

open scoped ENNReal

namespace GaloisForLFunctions.HTGeometry

/-- The normalized vertical jet space: square-summable Taylor coordinates. -/
abbrev JetSpace : Type := lp (fun _ : ℕ => ℂ) 2

/-- The critical (Gevrey-one) vertical jet shift on raw coordinate sequences. -/
def criticalJetShift (a : ℕ → ℂ) : ℕ → ℂ := fun k => ((k : ℂ) + 1) * a (k + 1)

@[simp] theorem criticalJetShift_apply (a : ℕ → ℂ) (k : ℕ) :
    criticalJetShift a k = ((k : ℂ) + 1) * a (k + 1) := rfl

theorem criticalJetShift_add (a b : ℕ → ℂ) :
    criticalJetShift (a + b) = criticalJetShift a + criticalJetShift b := by
  funext k
  simp [criticalJetShift, mul_add]

theorem criticalJetShift_smul (c : ℂ) (a : ℕ → ℂ) :
    criticalJetShift (c • a) = c • criticalJetShift a := by
  funext k
  simp only [criticalJetShift, Pi.smul_apply, smul_eq_mul]
  ring

theorem criticalJetShift_zero : criticalJetShift (0 : ℕ → ℂ) = 0 := by
  funext k
  simp [criticalJetShift]

/-- The natural domain of the critical jet derivative. -/
def criticalJetDomain : Submodule ℂ JetSpace where
  carrier := {a : JetSpace | Memℓp (criticalJetShift ((a : ℕ → ℂ))) 2}
  add_mem' := by
    intro a b ha hb
    show Memℓp (criticalJetShift (((a + b : JetSpace)) : ℕ → ℂ)) 2
    rw [lp.coeFn_add, criticalJetShift_add]
    exact ha.add hb
  zero_mem' := by
    show Memℓp (criticalJetShift (((0 : JetSpace)) : ℕ → ℂ)) 2
    rw [lp.coeFn_zero, criticalJetShift_zero]
    exact zero_memℓp
  smul_mem' := by
    intro c a ha
    show Memℓp (criticalJetShift (((c • a : JetSpace)) : ℕ → ℂ)) 2
    rw [lp.coeFn_smul, criticalJetShift_smul]
    exact ha.const_smul c

theorem mem_criticalJetDomain {a : JetSpace} :
    a ∈ criticalJetDomain ↔ Memℓp (criticalJetShift ((a : ℕ → ℂ))) 2 := Iff.rfl

/-- **The critical vertical jet derivative** as a partially defined operator on `ℓ²(ℕ)`. -/
def criticalJetDeriv : JetSpace →ₗ.[ℂ] JetSpace where
  domain := criticalJetDomain
  toFun :=
    { toFun := fun a => ⟨criticalJetShift ((a.1 : ℕ → ℂ)), a.2⟩
      map_add' := by
        intro a b
        apply lp.ext
        show criticalJetShift (((a.1 + b.1 : JetSpace)) : ℕ → ℂ)
          = ((⟨criticalJetShift ((a.1 : ℕ → ℂ)), a.2⟩ : JetSpace)
              + ⟨criticalJetShift ((b.1 : ℕ → ℂ)), b.2⟩ : JetSpace)
        rw [lp.coeFn_add, criticalJetShift_add, lp.coeFn_add]
      map_smul' := by
        intro c a
        apply lp.ext
        show criticalJetShift (((c • a.1 : JetSpace)) : ℕ → ℂ)
          = ((c • (⟨criticalJetShift ((a.1 : ℕ → ℂ)), a.2⟩ : JetSpace) : JetSpace) : ℕ → ℂ)
        rw [lp.coeFn_smul, criticalJetShift_smul, lp.coeFn_smul] }

theorem criticalJetDeriv_domain : criticalJetDeriv.domain = criticalJetDomain := rfl

theorem criticalJetDeriv_coe (a : criticalJetDomain) :
    ((criticalJetDeriv a : JetSpace) : ℕ → ℂ) = criticalJetShift ((a.1 : ℕ → ℂ)) := rfl

/-! ### The graph is the coordinate condition, hence closed -/

theorem criticalJetDeriv_graph_eq :
    (criticalJetDeriv.graph : Set (JetSpace × JetSpace))
      = {p : JetSpace × JetSpace |
          ∀ k : ℕ, ((p.2 : JetSpace) : ℕ → ℂ) k
            = ((k : ℂ) + 1) * ((p.1 : JetSpace) : ℕ → ℂ) (k + 1)} := by
  ext p
  constructor
  · intro hp
    obtain ⟨x, hx1, hx2⟩ := (LinearPMap.mem_graph_iff criticalJetDeriv).mp hp
    intro k
    rw [← hx1, ← hx2, criticalJetDeriv_coe]
    rfl
  · intro hp
    have hfun : criticalJetShift ((p.1 : ℕ → ℂ)) = ((p.2 : JetSpace) : ℕ → ℂ) := by
      funext k
      rw [criticalJetShift_apply, hp k]
    have hmem : p.1 ∈ criticalJetDomain := by
      rw [mem_criticalJetDomain, hfun]
      exact p.2.2
    refine (LinearPMap.mem_graph_iff criticalJetDeriv).mpr ⟨⟨p.1, hmem⟩, rfl, ?_⟩
    apply lp.ext
    rw [criticalJetDeriv_coe, hfun]

theorem continuous_jetCoord (k : ℕ) : Continuous fun f : JetSpace => (f : ℕ → ℂ) k := by
  refine LipschitzWith.continuous (K := 1) fun f g => ?_
  rw [edist_dist, edist_dist, dist_eq_norm, dist_eq_norm]
  have hle : ‖(f : ℕ → ℂ) k - (g : ℕ → ℂ) k‖ ≤ ‖f - g‖ := by
    have h := lp.norm_apply_le_norm (E := fun _ : ℕ => ℂ) (p := 2) (by norm_num) (f - g) k
    simpa using h
  simpa using ENNReal.ofReal_le_ofReal hle

/-- **The critical jet derivative is closed.** -/
theorem criticalJetDeriv_isClosed :
    IsClosed (criticalJetDeriv.graph : Set (JetSpace × JetSpace)) := by
  rw [criticalJetDeriv_graph_eq]
  have hset : {p : JetSpace × JetSpace |
      ∀ k : ℕ, ((p.2 : JetSpace) : ℕ → ℂ) k
        = ((k : ℂ) + 1) * ((p.1 : JetSpace) : ℕ → ℂ) (k + 1)}
      = ⋂ k : ℕ, {p : JetSpace × JetSpace |
          ((p.2 : JetSpace) : ℕ → ℂ) k
            = ((k : ℂ) + 1) * ((p.1 : JetSpace) : ℕ → ℂ) (k + 1)} := by
    ext p; simp
  rw [hset]
  refine isClosed_iInter fun k => ?_
  exact isClosed_eq ((continuous_jetCoord k).comp continuous_snd)
    (continuous_const.mul ((continuous_jetCoord (k + 1)).comp continuous_fst))

/-! ### The domain is dense -/

theorem single_mem_criticalJetDomain (i : ℕ) (c : ℂ) :
    lp.single (E := fun _ : ℕ => ℂ) 2 i c ∈ criticalJetDomain := by
  rw [mem_criticalJetDomain]
  match i with
  | 0 =>
      have hfun : criticalJetShift
          ((lp.single (E := fun _ : ℕ => ℂ) 2 0 c : JetSpace) : ℕ → ℂ) = 0 := by
        funext k
        rw [criticalJetShift_apply, lp.single_apply]
        simp
      rw [hfun]
      exact zero_memℓp
  | (j + 1) =>
      have hfun : criticalJetShift
            ((lp.single (E := fun _ : ℕ => ℂ) 2 (j + 1) c : JetSpace) : ℕ → ℂ)
          = ((lp.single (E := fun _ : ℕ => ℂ) 2 j (((j : ℂ) + 1) * c) : JetSpace) : ℕ → ℂ) := by
        funext k
        rw [criticalJetShift_apply, lp.single_apply, lp.single_apply]
        by_cases hk : k = j
        · subst hk
          simp
        · have hk1 : ¬ (k + 1 = j + 1) := by omega
          simp [hk]
      rw [hfun]
      exact (lp.single (E := fun _ : ℕ => ℂ) 2 j (((j : ℂ) + 1) * c)).2

/-- **The domain of the critical jet derivative is dense.** -/
theorem criticalJetDeriv_dense_domain : Dense (criticalJetDeriv.domain : Set JetSpace) := by
  rw [dense_iff_closure_eq]
  refine Set.eq_univ_of_univ_subset fun f _ => ?_
  have hsum := lp.hasSum_single (E := fun _ : ℕ => ℂ) (p := 2) (by norm_num) f
  refine mem_closure_of_tendsto hsum (Filter.Eventually.of_forall fun s => ?_)
  exact Submodule.sum_mem _ fun i _ => single_mem_criticalJetDomain i ((f : ℕ → ℂ) i)

/-! ### Unboundedness -/

/-- **The critical jet derivative is unbounded.**  On the unit vector in coordinate `N+1` it has
norm `N+1`. -/
theorem norm_criticalJetDeriv_single (N : ℕ) :
    ‖criticalJetDeriv ⟨lp.single (E := fun _ : ℕ => ℂ) 2 (N + 1) (1 : ℂ),
        single_mem_criticalJetDomain (N + 1) 1⟩‖ = (N : ℝ) + 1 := by
  have heq : criticalJetDeriv ⟨lp.single (E := fun _ : ℕ => ℂ) 2 (N + 1) (1 : ℂ),
        single_mem_criticalJetDomain (N + 1) 1⟩
      = lp.single (E := fun _ : ℕ => ℂ) 2 N ((N : ℂ) + 1) := by
    apply lp.ext
    rw [criticalJetDeriv_coe]
    funext k
    rw [criticalJetShift_apply, lp.single_apply, lp.single_apply]
    by_cases hk : k = N
    · subst hk
      simp
    · have hk1 : ¬ (k + 1 = N + 1) := by omega
      simp [hk]
  rw [heq, lp.norm_single (by norm_num)]
  have hcast : ((N : ℂ) + 1) = (((N : ℝ) + 1 : ℝ) : ℂ) := by push_cast; ring
  rw [hcast, Complex.norm_real, Real.norm_of_nonneg (by positivity)]

theorem norm_single_one (N : ℕ) :
    ‖(lp.single (E := fun _ : ℕ => ℂ) 2 (N + 1) (1 : ℂ) : JetSpace)‖ = 1 := by
  rw [lp.norm_single (by norm_num)]
  simp

end GaloisForLFunctions.HTGeometry
