import GaloisForLFunctions.HTGeometry.ComplexTorusIsogenyDeck

/-!
# The tautological point of a complex torus and its Maurer–Cartan velocity

The coordinates of `ℂ ^ n` are entire functions, so the identity map is a point of the torus
`ℂ ^ n / Λ` with coordinates in the entire fraction field.  On the generic reparametrisation its
Maurer–Cartan velocity is exactly the tuple of reparametrisation velocities: the Lie algebra of the
torus is read off the coordinates, with no group-scheme layer.

The isogeny `z ↦ m z` sends this point to `m` times itself and multiplies its velocity by `m`, which
is an automorphism of the velocity space when `m ≠ 0`.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

variable {n : ℕ}

/-- A coordinate of `ℂ ^ n` is entire. -/
private theorem analyticOnNhd_coord (n : ℕ) (j : Fin n) :
    AnalyticOnNhd ℂ (fun z : Fin n → ℂ => z j) Set.univ :=
  (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin n => ℂ) j).analyticOnNhd Set.univ

/-- The `j`-th coordinate of `ℂ ^ n`, as an entire function. -/
noncomputable def coordEntireRing (n : ℕ) (j : Fin n) : entireSubring (Fin n → ℂ) :=
  ⟨fun z => z j, analyticOnNhd_coord n j⟩

/-- The `j`-th coordinate of the tautological point of the torus `ℂ ^ n / Λ`. -/
noncomputable def coordEntire (n : ℕ) (j : Fin n) : EntireField (Fin n → ℂ) :=
  algebraMap (entireSubring (Fin n → ℂ)) (EntireField (Fin n → ℂ)) (coordEntireRing n j)

/-- The coordinate derivations of `ℂ ^ n` are the partial derivatives: the `k`-th derivation sends
the `j`-th coordinate to the Kronecker delta. -/
theorem torusDeriv_coordEntire (n : ℕ) (k j : Fin n) :
    torusDeriv n k (coordEntire n j)
      = constEntire (Fin n → ℂ) (if j = k then 1 else 0) := by
  classical
  have hring : entireDirDeriv (stdFrame n k) (coordEntireRing n j)
      = constEntireRing (Fin n → ℂ) (if j = k then 1 else 0) := by
    apply Subtype.ext
    funext z
    show fderiv ℂ (fun w : Fin n → ℂ => w j) z (stdFrame n k) = _
    have hfd : HasFDerivAt (fun w : Fin n → ℂ => w j)
        (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin n => ℂ) j) z :=
      (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin n => ℂ) j).hasFDerivAt
    rw [hfd.fderiv]
    show (Pi.single k 1 : Fin n → ℂ) j = _
    rw [Pi.single_apply]
    rfl
  show GaloisForLFunctions.fractionRingDerivation (entireDirDerivationField (stdFrame n k))
      (algebraMap (entireSubring (Fin n → ℂ)) (EntireField (Fin n → ℂ))
        (coordEntireRing n j)) = _
  rw [GaloisForLFunctions.fractionRingDerivation_algebraMap]
  show algebraMap (entireSubring (Fin n → ℂ)) (EntireField (Fin n → ℂ))
      (entireDirDeriv (stdFrame n k) (coordEntireRing n j)) = _
  rw [hring]
  rfl

/-- **The velocity of the tautological point is the reparametrisation velocity.**  On the generic
reparametrisation the Maurer–Cartan velocity of the `j`-th coordinate of the torus is the `j`-th
first jet. -/
theorem deriv_coordEntire (n : ℕ) (j : Fin n) :
    (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′
      = MultiReparamField.jet (j, 0) := by
  classical
  rw [torusField_deriv_algebraMap, Finset.sum_eq_single j]
  · rw [torusDeriv_coordEntire, if_pos rfl, map_one, map_one, one_mul]
  · intro k _ hk
    rw [torusDeriv_coordEntire, if_neg (Ne.symm hk), map_zero, map_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ j) h

/-- **The velocity field is generated by the Maurer–Cartan velocity of the point.** -/
theorem differentialAdjoin_coordVelocity_eq_torusVelocityField (n : ℕ) :
    differentialAdjoin ℂ (Set.range fun j : Fin n =>
        (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′)
      = complexTorusVelocityField n := by
  have h : (fun j : Fin n =>
      (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′)
      = fun j : Fin n => (MultiReparamField.jet (j, 0) : TorusField n) :=
    funext (deriv_coordEntire n)
  rw [h, complexTorusVelocityField]

/-- **The Maurer–Cartan velocity of the point is differentially independent.**  Its `n` components
are differentially transcendental over the constants, so the phase tail has differential
transcendence degree `n`, the dimension of the torus. -/
theorem differentialIndependent_coordVelocity (n : ℕ) :
    DifferentialIndependent ℂ (fun j : Fin n =>
      (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′) := by
  have h : (fun j : Fin n =>
      (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′)
      = fun j : Fin n => (MultiReparamField.jet (j, 0) : TorusField n) :=
    funext (deriv_coordEntire n)
  rw [h]
  exact differentialIndependent_torusVelocity

/-! ### The isogeny on the tautological point -/

/-- The isogeny `z ↦ m z` multiplies the tautological point by `m`. -/
theorem entireScale_coordEntireRing (n : ℕ) (m : ℂ) (j : Fin n) :
    entireScale m (coordEntireRing n j)
      = constEntireRing (Fin n → ℂ) m * coordEntireRing n j := by
  apply Subtype.ext
  funext z
  show (m • z) j = m * z j
  rfl

theorem fieldScaleEquiv_coordEntire (n : ℕ) {m : ℂ} (hm : m ≠ 0) (j : Fin n) :
    fieldScaleEquiv hm (coordEntire n j)
      = constEntire (Fin n → ℂ) m * coordEntire n j := by
  rw [coordEntire, fieldScaleEquiv_algebraMap, entireScale_coordEntireRing, map_mul]
  rfl

/-- **Flat velocity transport.**  The isogeny `z ↦ m z` multiplies the Maurer–Cartan velocity of the
tautological point by `m`. -/
theorem deriv_fieldScaleEquiv_coordEntire (n : ℕ) {m : ℂ} (hm : m ≠ 0) (j : Fin n) :
    (algebraMap (EntireField (Fin n → ℂ)) (TorusField n)
        (fieldScaleEquiv hm (coordEntire n j)))′
      = algebraMap ℂ (TorusField n) m
        * (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′ := by
  rw [fieldScaleEquiv_coordEntire, map_mul]
  have hconst : algebraMap (EntireField (Fin n → ℂ)) (TorusField n)
      (constEntire (Fin n → ℂ) m) = algebraMap ℂ (TorusField n) m :=
    (algebraMap_torusField m).symm
  rw [hconst, Derivation.leibniz, torusField_deriv_algebraMap_complex]
  simp

/-- **The differential of the isogeny is an automorphism of the velocity space.**  For `m ≠ 0`,
multiplication by `m` on the velocities is bijective. -/
theorem bijective_velocity_transport {m : ℂ} (hm : m ≠ 0) :
    Function.Bijective (fun v : TorusField n => algebraMap ℂ (TorusField n) m * v) := by
  have hm' : algebraMap ℂ (TorusField n) m ≠ 0 := by
    intro h
    exact hm ((algebraMap ℂ (TorusField n)).injective (by rw [h, map_zero]))
  constructor
  · intro u v huv
    exact mul_left_cancel₀ hm' huv
  · intro w
    refine ⟨(algebraMap ℂ (TorusField n) m)⁻¹ * w, ?_⟩
    show algebraMap ℂ (TorusField n) m * ((algebraMap ℂ (TorusField n) m)⁻¹ * w) = w
    rw [← mul_assoc, mul_inv_cancel₀ hm', one_mul]

/-! ### An unconditional protocol on the standard complex torus -/

theorem two_pow_ne_zero_complex (k : ℕ) : ((2 : ℂ) ^ k) ≠ 0 := pow_ne_zero k two_ne_zero

theorem tendsto_norm_two_pow_atTop :
    Tendsto (fun k : ℕ => ‖(2 : ℂ) ^ k‖) atTop atTop := by
  have hnorm : ∀ k : ℕ, ‖(2 : ℂ) ^ k‖ = (2 : ℝ) ^ k := by
    intro k
    rw [norm_pow]
    norm_num
  simp only [hnorm]
  exact tendsto_pow_atTop_atTop_of_one_lt (by norm_num)

/-- **The phase tail of a degree-expanding protocol on the standard complex torus.**  For the
Gaussian-integer lattice of `ℂ ^ n` and the accumulated degrees `2 ^ k`:

* the elements of the generic reparametrisation fixed by every deck translation of every depth are
  exactly the differential rational functions of the Maurer–Cartan velocity of the tautological
  point;
* that velocity is differentially independent, so the tail has differential transcendence degree
  `n`, the dimension of the torus;
* an element of the function field of the torus lying in the tail is a constant.

No hypothesis is carried: the lattice, the protocol and the point are all exhibited. -/
theorem stdTorus_phase_tail (n : ℕ) :
    torusDeckInvariantField (stdPeriodLattice n) (fun k : ℕ => (2 : ℂ) ^ k)
        = differentialAdjoin ℂ (Set.range fun j : Fin n =>
            (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′)
      ∧ DifferentialIndependent ℂ (fun j : Fin n =>
          (algebraMap (EntireField (Fin n → ℂ)) (TorusField n) (coordEntire n j))′)
      ∧ ∀ a : EntireField (Fin n → ℂ),
          algebraMap (EntireField (Fin n → ℂ)) (TorusField n) a
              ∈ torusDeckInvariantField (stdPeriodLattice n) (fun k : ℕ => (2 : ℂ) ^ k) →
            ∃ c : ℂ, a = constEntire (Fin n → ℂ) c := by
  have htail : torusDeckInvariantField (stdPeriodLattice n) (fun k : ℕ => (2 : ℂ) ^ k)
      = complexTorusVelocityField n :=
    torusDeckInvariantField_eq_torusVelocityField (stdPeriodLattice n) _
      two_pow_ne_zero_complex tendsto_norm_two_pow_atTop
  refine ⟨?_, differentialIndependent_coordVelocity n, ?_⟩
  · rw [htail, differentialAdjoin_coordVelocity_eq_torusVelocityField]
  · intro a ha
    rw [htail] at ha
    exact eq_constEntire_of_algebraMap_mem_torusVelocityField ha

end GaloisForLFunctions.HTGeometry
