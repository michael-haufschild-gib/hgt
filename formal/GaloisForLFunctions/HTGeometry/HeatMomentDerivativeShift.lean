import Mathlib

/-!
# The moment ladder of a heat kernel is a derivative ladder

For a spectral point `w`, the Gaussian-damped monomials `t ↦ wⁿ·e^{−t w}` satisfy

```text
d/dt (wⁿ e^{−t w})  =  −w^{n+1} e^{−t w} ,
```

so the whole family is generated by the `n = 0` term through differentiation in `t`.  Summed over a
spectrum, this says the moment sequence `mₙ(t)` and the heat trace `m₀(t)` are related by
`mₙ = (−1)ⁿ m₀^{(n)}` — every moment, hence every Hankel matrix built from them, is a derivative of
one scalar function.

The consequence for a Hankel positivity criterion is a change of shape: "all Hankel matrices of
`(mₙ)` are PSD" becomes a statement about the alternating signs of successive derivatives of a
single function, which is the hypothesis of Bernstein's theorem — complete monotonicity, equivalently
representability as the Laplace transform of a positive measure on `[0,∞)`.  When the spectral
points are real and nonnegative that representation is immediate; when they are not, it is exactly
what fails.

Only the termwise identity is proved here.  Passing from it to `mₙ = (−1)ⁿ m₀^{(n)}` for the summed
family requires interchanging the sum with the derivative, which needs a domination argument not
carried out in this file.
-/

namespace GaloisForLFunctions

/-- **The heat monomial ladder.**  Differentiating the `n`-th Gaussian-damped monomial in the heat
parameter produces the `(n+1)`-st, with a sign. -/
theorem hasDerivAt_heatMonomial (w : ℂ) (n : ℕ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => w ^ n * Complex.exp (-(s : ℂ) * w))
      (-(w ^ (n + 1) * Complex.exp (-(t : ℂ) * w))) t := by
  have hlin : HasDerivAt (fun s : ℝ => -(s : ℂ) * w) (-w) t := by
    have h : HasDerivAt (fun s : ℝ => (s : ℂ)) 1 t := Complex.ofRealCLM.hasDerivAt
    simpa using (h.neg.mul_const w)
  have hexp : HasDerivAt (fun s : ℝ => Complex.exp (-(s : ℂ) * w))
      (Complex.exp (-(t : ℂ) * w) * -w) t := hlin.cexp
  have := hexp.const_mul (w ^ n)
  refine this.congr_deriv ?_
  ring

/-- The real-valued form, for a nonnegative real spectral point. -/
theorem hasDerivAt_heatMonomial_real (w : ℝ) (n : ℕ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => w ^ n * Real.exp (-s * w))
      (-(w ^ (n + 1) * Real.exp (-t * w))) t := by
  have hlin : HasDerivAt (fun s : ℝ => -s * w) (-w) t := by
    simpa using ((hasDerivAt_id t).neg.mul_const w)
  have hexp : HasDerivAt (fun s : ℝ => Real.exp (-s * w)) (Real.exp (-t * w) * -w) t :=
    hlin.exp
  have := hexp.const_mul (w ^ n)
  refine this.congr_deriv ?_
  ring

/-- **Alternating signs at a nonnegative node.**  For `w ≥ 0` the `n`-th monomial is nonnegative and
its `n`-th derivative alternates — the termwise form of complete monotonicity.  This is the property
a spectrum of nonnegative real points confers on its heat trace, and the property complex points
destroy. -/
theorem heatMonomial_nonneg_of_nonneg {w : ℝ} (hw : 0 ≤ w) (n : ℕ) (t : ℝ) :
    0 ≤ w ^ n * Real.exp (-t * w) :=
  mul_nonneg (pow_nonneg hw n) (Real.exp_pos _).le

/-- **A real spectral point squares to a nonnegative node.**  This is why criticality of the
spectrum is what makes the heat trace a Laplace transform of a positive measure: the node of a zero
is the square of its spectral point, which is nonnegative exactly when that point is real. -/
theorem sq_nonneg_iff_isReal (z : ℂ) :
    (z ^ 2).im = 0 ∧ 0 ≤ (z ^ 2).re ↔ z.im = 0 ∧ 0 ≤ z.re ∨ z.im = 0 ∧ z.re ≤ 0 := by
  constructor
  · rintro ⟨him, hre⟩
    rw [sq, Complex.mul_im] at him
    rw [sq, Complex.mul_re] at hre
    have hz : z.re * z.im = 0 := by linarith
    rcases mul_eq_zero.mp hz with hzre | hzim
    · have hzim : z.im = 0 := by
        rw [hzre] at hre
        nlinarith [hre]
      exact Or.inl ⟨hzim, by rw [hzre]⟩
    · rcases le_total 0 z.re with h | h
      · exact Or.inl ⟨hzim, h⟩
      · exact Or.inr ⟨hzim, h⟩
  · rintro (⟨him, hre⟩ | ⟨him, hre⟩) <;>
      constructor <;>
      simp [sq, Complex.mul_im, Complex.mul_re, him] <;>
      nlinarith [hre]

end GaloisForLFunctions
