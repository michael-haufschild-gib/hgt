import GaloisForLFunctions.HTGeometry.FreeShiftOneSliceNonsummability
import GaloisForLFunctions.HTGeometry.DifferentialIndependentFieldUniversality

/-!
# One-slice nonsummability in a differentially independent shift field

The free bilateral rational shift obstruction is transported to the differential field generated
by any genuinely differentially independent bilateral palette.  Conjugating the free shift gives
an unconditional automorphism of the generated field.  No nonzero finite constant-coefficient
linear form in the jets of one translation slice is a coboundary for that automorphism.
-/

namespace GaloisForLFunctions

noncomputable section

open Set MvPolynomial HTGeometry

/-- Reassociate the free bilateral jet grid with the jet indexing used by
`differentialIndependentAdjoinParametrization`. -/
def freeShiftJetAssocPolynomialEquiv
    {C α : Type*} [Field C] :
    FreeShiftPolynomial C α ≃ₐ[C] MvPolynomial ((α × ℤ) × ℕ) C :=
  MvPolynomial.renameEquiv C (Equiv.prodAssoc α ℤ ℕ).symm

/-- The induced reassociation of rational function fields. -/
def freeShiftJetAssocFieldEquiv
    {C α : Type*} [Field C] :
    FreeShiftField C α ≃ₐ[C] FractionRing (MvPolynomial ((α × ℤ) × ℕ) C) :=
  IsFractionRing.algEquivOfAlgEquiv
    (freeShiftJetAssocPolynomialEquiv (C := C) (α := α))

/-- The free bilateral rational jet field is canonically the differential field generated by a
differentially independent bilateral palette. -/
def freeShiftDifferentialAdjoinParametrization
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x) :
    FreeShiftField C α ≃ₐ[C] differentialAdjoin C (Set.range x) :=
  (freeShiftJetAssocFieldEquiv (C := C) (α := α)).trans
    (differentialIndependentAdjoinParametrization x hx)

@[simp] theorem freeShiftDifferentialAdjoinParametrization_X
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x)
    (a : α) (m : ℤ) (n : ℕ) :
    freeShiftDifferentialAdjoinParametrization x hx
        (algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
          (MvPolynomial.X (a, (m, n)))) =
      ⟨differentialJet n (x (a, m)),
        differentialJet_mem_differentialAdjoin C (Set.mem_range_self (a, m)) n⟩ := by
  simp [freeShiftDifferentialAdjoinParametrization,
    freeShiftJetAssocFieldEquiv, freeShiftJetAssocPolynomialEquiv]

/-- The canonical unit translation on the field generated by a differentially independent
bilateral palette. -/
def differentialIndependentFreeShiftEquiv
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x) :
    differentialAdjoin C (Set.range x) ≃ₐ[C] differentialAdjoin C (Set.range x) :=
  (freeShiftDifferentialAdjoinParametrization x hx).symm.trans
    ((freeShiftFieldEquiv (K := C) (α := α) 1).trans
      (freeShiftDifferentialAdjoinParametrization x hx))

@[simp] theorem differentialIndependentFreeShiftEquiv_jet
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x)
    (a : α) (m : ℤ) (n : ℕ) :
    differentialIndependentFreeShiftEquiv x hx
        ⟨differentialJet n (x (a, m)),
          differentialJet_mem_differentialAdjoin C (Set.mem_range_self (a, m)) n⟩ =
      ⟨differentialJet n (x (a, m + 1)),
        differentialJet_mem_differentialAdjoin C (Set.mem_range_self (a, m + 1)) n⟩ := by
  let Φ := freeShiftDifferentialAdjoinParametrization x hx
  let q : FreeShiftField C α :=
    algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
      (MvPolynomial.X (a, (m, n)))
  have hpre : Φ.symm
      ⟨differentialJet n (x (a, m)),
        differentialJet_mem_differentialAdjoin C (Set.mem_range_self (a, m)) n⟩ = q := by
    apply Φ.injective
    simp [Φ, q]
  change Φ (HTGeometry.freeShiftFieldEquiv (K := C) 1 (Φ.symm _)) = _
  rw [hpre]
  simp [Φ, q, HTGeometry.freeShiftJetIndexEquiv]

/-- No nonzero finite constant-coefficient linear form in the jets of one slice of a genuinely
differentially independent bilateral palette is a rational shift coboundary in its generated
differential field. -/
theorem differentialIndependent_oneSlice_ne_coboundary
    {C K α : Type*} [Field C] [Field K] [Algebra C K] [Differential K]
    (x : (α × ℤ) → K) (hx : DifferentialIndependent C x)
    (c : (α × ℕ) →₀ C) (hc : c ≠ 0)
    (g : differentialAdjoin C (Set.range x)) :
    differentialIndependentFreeShiftEquiv x hx g - g ≠
      c.sum (fun j a =>
        algebraMap C (differentialAdjoin C (Set.range x)) a *
          ⟨differentialJet j.2 (x (j.1, 0)),
            differentialJet_mem_differentialAdjoin C
              (Set.mem_range_self (j.1, 0)) j.2⟩) := by
  classical
  let Φ := freeShiftDifferentialAdjoinParametrization x hx
  let g₀ : FreeShiftField C α := Φ.symm g
  have hΦg : Φ g₀ = g := by simp [g₀]
  intro h
  apply HTGeometry.freeShiftOneSlice_ne_coboundary c hc g₀
  apply Φ.injective
  calc
    Φ (HTGeometry.freeShiftFieldEquiv (K := C) 1 g₀ - g₀) =
        differentialIndependentFreeShiftEquiv x hx g - g := by
          simp [Φ, g₀, differentialIndependentFreeShiftEquiv]
    _ = c.sum (fun j a =>
          algebraMap C (differentialAdjoin C (Set.range x)) a *
            ⟨differentialJet j.2 (x (j.1, 0)),
              differentialJet_mem_differentialAdjoin C
                (Set.mem_range_self (j.1, 0)) j.2⟩) := h
    _ = Φ (algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
          (HTGeometry.freeShiftOneSlice c)) := by
            simp only [HTGeometry.freeShiftOneSlice, Finsupp.sum, map_sum]
            apply Finset.sum_congr rfl
            intro j hj
            calc
              algebraMap C (differentialAdjoin C (Set.range x)) (c j) *
                    ⟨differentialJet j.2 (x (j.1, 0)),
                      differentialJet_mem_differentialAdjoin C
                        (Set.mem_range_self (j.1, 0)) j.2⟩ =
                  Φ (algebraMap C (FreeShiftField C α) (c j)) *
                    Φ (algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
                      (MvPolynomial.X (j.1, ((0 : ℤ), j.2)))) := by
                        simp [Φ]
              _ = Φ (algebraMap C (FreeShiftField C α) (c j) *
                    algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
                      (MvPolynomial.X (j.1, ((0 : ℤ), j.2)))) := by
                        rw [map_mul]
              _ = Φ (algebraMap (FreeShiftPolynomial C α) (FreeShiftField C α)
                    (MvPolynomial.C (c j) *
                      MvPolynomial.X (j.1, ((0 : ℤ), j.2)))) := by
                        congr 1
                        rw [map_mul]
                        rfl

end

end GaloisForLFunctions
