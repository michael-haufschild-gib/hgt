import GaloisForLFunctions.HTGeometry.JetAdjoinDerivationClosed
import GaloisForLFunctions.HTGeometry.JetIndependenceDescent
import GaloisForLFunctions.HTGeometry.RatioFieldCharacteristicMinimal
import Mathlib.FieldTheory.Relrank

/-!
# The terminal reciprocity step of the differential Lüroth theorem

A subfield of an intermediate field over which the element has a characteristic of the *same* rank
cannot be proper.  The jets below the common order generate the same field over both, because both
extensions are generated by the top jet with the same minimal polynomial degree inside the field
generated by all jets up to the order; and a coefficient which lies in the smaller jet field, the
low jets being algebraically independent, lies in the smaller field itself.

Applied to the field generated by the coefficient ratios of a characteristic, this is Ritt's
statement that those ratios generate the whole intermediate field.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential F] [Differential E]
  [DifferentialAlgebra F E] [CharZero E]

omit [Differential F] [DifferentialAlgebra F E] in
/-- **A subfield carrying a characteristic of the same rank is the whole field.** -/
theorem eq_of_characteristic_rank_eq
    {R G : IntermediateField F E} (hRG : R ≤ G) (hRclosed : DerivationClosed R) {y : E}
    (hGy : G ≤ differentialAdjoin F ({y} : Set E))
    {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {P₁ : DifferentialPolynomial Unit R}
    (hP₁min : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal R y : Set _) P₁)
    (horder : scalarDifferentialPolynomialOrder P₁ = scalarDifferentialPolynomialOrder P)
    (hleader : scalarDifferentialPolynomialLeaderDegree P₁ =
      scalarDifferentialPolynomialLeaderDegree P) :
    G = R := by
  classical
  set m := scalarDifferentialPolynomialOrder P with hm
  set z := differentialJet m y with hz
  set WG := jetAdjoin G y m with hWG
  set WR := jetAdjoin R y m with hWR
  set N := jetAdjoin R y (m + 1) with hN
  have hWRG : WR ≤ WG := jetAdjoin_mono_left hRG
  have hdiffN : differentialAdjoin F ({y} : Set E) ≤ N := by
    have h := differentialAdjoin_le_jetAdjoin R hRclosed hP₁min
    rwa [horder] at h
  have hzN : z ∈ N := differentialJet_mem_jetAdjoin R y (Nat.lt_succ_self m)
  have hWRN : WR ≤ N := jetAdjoin_mono_right (Nat.le_succ m)
  have hWGN : WG ≤ N :=
    jetAdjoin_le (le_trans hGy hdiffN) fun i hi =>
      differentialJet_mem_jetAdjoin R y (by omega)
  -- both jet prefix fields generate the same field after adjoining the top jet
  have hWRsub : WR ≤ IntermediateField.adjoin F ((WR : Set E) ∪ {z}) := fun x hx =>
    IntermediateField.subset_adjoin F _ (Or.inl hx)
  have hzsub : z ∈ IntermediateField.adjoin F ((WR : Set E) ∪ {z}) :=
    IntermediateField.subset_adjoin F _ (Or.inr rfl)
  have hNR : N = IntermediateField.adjoin F ((WR : Set E) ∪ {z}) := by
    refine le_antisymm ?_ ?_
    · refine jetAdjoin_le (le_trans (le_jetAdjoin R y m) hWRsub) ?_
      intro i hi
      rcases lt_or_eq_of_le (Nat.lt_succ_iff.1 hi) with h | h
      · exact hWRsub (differentialJet_mem_jetAdjoin R y h)
      · rw [h]
        exact hzsub
    · refine IntermediateField.adjoin_le_iff.2 ?_
      rintro x (hx | hx)
      · exact hWRN hx
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact hzN
  have hNG : N = IntermediateField.adjoin F ((WG : Set E) ∪ {z}) := by
    refine le_antisymm ?_ ?_
    · rw [hNR]
      refine IntermediateField.adjoin_le_iff.2 ?_
      rintro x (hx | hx)
      · exact IntermediateField.subset_adjoin F _ (Or.inl (hWRG hx))
      · exact IntermediateField.subset_adjoin F _ (Or.inr hx)
    · refine IntermediateField.adjoin_le_iff.2 ?_
      rintro x (hx | hx)
      · exact hWGN hx
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact hzN
  have hextR : IntermediateField.extendScalars hWRN =
      IntermediateField.adjoin (WR) ({z} : Set E) := by
    refine IntermediateField.restrictScalars_injective F ?_
    rw [IntermediateField.extendScalars_restrictScalars, IntermediateField.restrictScalars_adjoin]
    exact hNR
  have hextG : IntermediateField.extendScalars hWGN =
      IntermediateField.adjoin (WG) ({z} : Set E) := by
    refine IntermediateField.restrictScalars_injective F ?_
    rw [IntermediateField.extendScalars_restrictScalars, IntermediateField.restrictScalars_adjoin]
    exact hNG
  -- the two relative degrees agree, because the two minimal polynomials of the top jet do
  have hintR : IsIntegral (WR) z := by
    have h := isIntegral_differentialJet_of_minimal hP₁min
    rwa [horder] at h
  have hintG : IsIntegral (WG) z := isIntegral_differentialJet_of_minimal hPmin
  have hrankR : WR.relfinrank N = scalarDifferentialPolynomialLeaderDegree P := by
    rw [IntermediateField.relfinrank_eq_finrank_of_le hWRN, hextR,
      IntermediateField.adjoin.finrank hintR]
    have h := minpoly_natDegree_eq_leaderDegree hP₁min
    rwa [horder, hleader] at h
  have hrankG : WG.relfinrank N = scalarDifferentialPolynomialLeaderDegree P := by
    rw [IntermediateField.relfinrank_eq_finrank_of_le hWGN, hextG,
      IntermediateField.adjoin.finrank hintG]
    exact minpoly_natDegree_eq_leaderDegree hPmin
  have hdpos : 0 < scalarDifferentialPolynomialLeaderDegree P :=
    scalarDifferentialPolynomialLeaderDegree_pos hPmin.2.2.1
  have htower := IntermediateField.relfinrank_mul_relfinrank hWRG hWGN
  rw [hrankG, hrankR] at htower
  have hone : WR.relfinrank WG = 1 := by
    refine Nat.eq_of_mul_eq_mul_right hdpos ?_
    rw [htower, one_mul]
  have hWGR : WG ≤ WR := IntermediateField.relfinrank_eq_one_iff.1 hone
  refine le_antisymm ?_ hRG
  intro g hg
  exact mem_of_mem_jetAdjoin hRG (algebraicIndependent_jets_of_minimal hPmin) hg
    (hWGR (le_jetAdjoin G y m hg))

/-- **The terminal reciprocity step.**  The differential field generated by the coefficient ratios
of a characteristic is the whole intermediate field. -/
theorem characteristicDifferentialRatioField_eq (G : IntermediateField F E)
    (hGclosed : DerivationClosed G) {y : E}
    (hGy : G ≤ differentialAdjoin F ({y} : Set E))
    {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0) :
    characteristicDifferentialRatioField G P n = G :=
  (eq_of_characteristic_rank_eq (characteristicDifferentialRatioField_le G hGclosed P n)
    (derivationClosed_differentialAdjoin F _) hGy hPmin
    (isMinimal_descend_normalized G hGclosed hPmin hn)
    (order_descend_normalized_eq G hGclosed P hn)
    (leaderDegree_descend_normalized_eq G hGclosed P hn)).symm

end

end GaloisForLFunctions
