import GaloisForLFunctions.HTGeometry.DeckClosureStableCore

/-!
# Power-isogeny cores and torsion conjugacies

The stable fixed field of all common positive-power stabilizers of a two-coordinate torus tuple is
exactly the fixed field of the subgroup generated by coordinatewise torsion conjugacies.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped BigOperators

/-- Positive natural exponents indexing nontrivial scalar power isogenies. -/
abbrev PositiveNat := {n : ℕ // 0 < n}

variable {F N : Type*} [Field F] [Field N] [Algebra F N]

/-- Automorphisms fixing every coordinate after one common positive power. -/
def powerTupleStabilizer (y : Fin 2 → N) (m : PositiveNat) :
    Subgroup (N ≃ₐ[F] N) where
  carrier := {σ | ∀ i, σ (y i ^ (m : ℕ)) = y i ^ (m : ℕ)}
  one_mem' := by
    intro i
    rfl
  mul_mem' := by
    intro σ τ hσ hτ i
    simp only [Set.mem_setOf_eq] at hσ hτ ⊢
    simp [hσ i, hτ i]
  inv_mem' := by
    intro σ hσ i
    simp only [Set.mem_setOf_eq] at hσ ⊢
    have h := congrArg (⇑(σ⁻¹)) (hσ i)
    simpa using h.symm

/-- Automorphisms whose coordinatewise conjugacy ratios are torsion. -/
def torsionRatioSet (y : Fin 2 → N) : Set (N ≃ₐ[F] N) :=
  {σ | ∀ i, IsOfFinOrder (σ (y i) / y i)}

theorem powerTupleStabilizer_le_torsionRatioClosure
    (y : Fin 2 → N) (hy : ∀ i, y i ≠ 0) (m : PositiveNat) :
    powerTupleStabilizer y m ≤
      Subgroup.closure (torsionRatioSet (F := F) y) := by
  intro σ hσ
  apply Subgroup.subset_closure
  intro i
  apply isOfFinOrder_iff_pow_eq_one.mpr
  refine ⟨m, m.property, ?_⟩
  rw [div_pow, ← map_pow, hσ i, div_self (pow_ne_zero _ (hy i))]

theorem torsionRatioSet_subset_iSup_powerTupleStabilizer
    (y : Fin 2 → N) (hy : ∀ i, y i ≠ 0) :
    torsionRatioSet (F := F) y ⊆
      (⨆ m : PositiveNat, powerTupleStabilizer y m : Subgroup (N ≃ₐ[F] N)) := by
  intro σ hσ
  rcases (hσ 0).exists_pow_eq_one with ⟨m₀, hm₀pos, hm₀⟩
  rcases (hσ 1).exists_pow_eq_one with ⟨m₁, hm₁pos, hm₁⟩
  let m : PositiveNat := ⟨m₀ * m₁, Nat.mul_pos hm₀pos hm₁pos⟩
  have hm : σ ∈ powerTupleStabilizer y m := by
    intro i
    fin_cases i
    · change σ (y 0 ^ (m₀ * m₁)) = y 0 ^ (m₀ * m₁)
      have hr : (σ (y 0) / y 0) ^ (m₀ * m₁) = 1 := by
        rw [pow_mul, hm₀, one_pow]
      have hr' : σ (y 0) ^ (m₀ * m₁) / y 0 ^ (m₀ * m₁) = 1 := by
        simpa only [div_pow] using hr
      have hp : σ (y 0) ^ (m₀ * m₁) = y 0 ^ (m₀ * m₁) :=
        (div_eq_one_iff_eq (pow_ne_zero _ (hy 0))).mp hr'
      simpa only [m, map_pow] using hp
    · change σ (y 1 ^ (m₀ * m₁)) = y 1 ^ (m₀ * m₁)
      have hr : (σ (y 1) / y 1) ^ (m₀ * m₁) = 1 := by
        rw [Nat.mul_comm, pow_mul, hm₁, one_pow]
      have hr' : σ (y 1) ^ (m₀ * m₁) / y 1 ^ (m₀ * m₁) = 1 := by
        simpa only [div_pow] using hr
      have hp : σ (y 1) ^ (m₀ * m₁) = y 1 ^ (m₀ * m₁) :=
        (div_eq_one_iff_eq (pow_ne_zero _ (hy 1))).mp hr'
      simpa only [m, map_pow] using hp
  exact (le_iSup (fun k : PositiveNat => powerTupleStabilizer y k) m) hm

/-- The group generated by all positive-power stabilizers is exactly the group generated by
coordinatewise torsion conjugacies. -/
theorem iSup_powerTupleStabilizer_eq_torsionRatioClosure
    (y : Fin 2 → N) (hy : ∀ i, y i ≠ 0) :
    (⨆ m : PositiveNat, powerTupleStabilizer y m) =
      Subgroup.closure (torsionRatioSet (F := F) y) := by
  apply le_antisymm
  · exact iSup_le (powerTupleStabilizer_le_torsionRatioClosure y hy)
  · exact (Subgroup.closure_le _).mpr
      (torsionRatioSet_subset_iSup_powerTupleStabilizer (F := F) y hy)

/-- Exact fixed-field classification of the scalar-power isogeny core. -/
theorem iInf_fixedField_powerTupleStabilizer_eq_torsionRatioClosure
    (y : Fin 2 → N) (hy : ∀ i, y i ≠ 0) :
    (⨅ m : PositiveNat,
        IntermediateField.fixedField (powerTupleStabilizer y m)) =
      IntermediateField.fixedField
        (Subgroup.closure (torsionRatioSet (F := F) y)) := by
  rw [← fixedField_iSup,
    iSup_powerTupleStabilizer_eq_torsionRatioClosure y hy]

/-- Increasing the common exponent by a positive factor can only enlarge its tuple stabilizer. -/
theorem powerTupleStabilizer_le_mul
    (y : Fin 2 → N) (m k : PositiveNat) :
    powerTupleStabilizer (F := F) y m ≤
      powerTupleStabilizer (F := F) y
        ⟨(m : ℕ) * (k : ℕ), Nat.mul_pos m.property k.property⟩ := by
  intro σ hσ i
  change σ (y i ^ ((m : ℕ) * (k : ℕ))) =
    y i ^ ((m : ℕ) * (k : ℕ))
  simp only [pow_mul, map_pow, hσ i]

/-- Union of all positive-power stabilizers; directedness under multiplication makes it a
subgroup without any root-of-unity hypothesis on the base field. -/
def powerTupleStabilizerUnion (y : Fin 2 → N) :
    Subgroup (N ≃ₐ[F] N) where
  carrier := {σ | ∃ m : PositiveNat, σ ∈ powerTupleStabilizer (F := F) y m}
  one_mem' := by
    exact ⟨⟨1, Nat.zero_lt_one⟩, Subgroup.one_mem _⟩
  mul_mem' := by
    rintro σ τ ⟨m, hσ⟩ ⟨k, hτ⟩
    let mk : PositiveNat :=
      ⟨(m : ℕ) * (k : ℕ), Nat.mul_pos m.property k.property⟩
    refine ⟨mk, Subgroup.mul_mem _
      (powerTupleStabilizer_le_mul (F := F) y m k hσ) ?_⟩
    have hτ' := powerTupleStabilizer_le_mul (F := F) y k m hτ
    simpa only [mk, Nat.mul_comm] using hτ'
  inv_mem' := by
    rintro σ ⟨m, hσ⟩
    exact ⟨m, Subgroup.inv_mem _ hσ⟩

theorem iSup_powerTupleStabilizer_eq_union (y : Fin 2 → N) :
    (⨆ m : PositiveNat, powerTupleStabilizer (F := F) y m) =
      powerTupleStabilizerUnion (F := F) y := by
  apply le_antisymm
  · exact iSup_le fun m σ hσ => ⟨m, hσ⟩
  · rintro σ ⟨m, hσ⟩
    exact (le_iSup (fun k : PositiveNat => powerTupleStabilizer (F := F) y k) m) hσ

/-- In a finite automorphism group, all positive-power stabilizers are already generated by one
common power. -/
theorem exists_powerTupleStabilizer_eq_iSup
    [Finite (N ≃ₐ[F] N)] (y : Fin 2 → N) :
    ∃ m : PositiveNat,
      powerTupleStabilizer (F := F) y m =
        ⨆ k : PositiveNat, powerTupleStabilizer (F := F) y k := by
  let U := powerTupleStabilizerUnion (F := F) y
  letI : Fintype U := Fintype.ofFinite U
  let witness : U → PositiveNat := fun σ => Classical.choose σ.property
  have hwitness : ∀ σ : U, σ.1 ∈ powerTupleStabilizer (F := F) y (witness σ) :=
    fun σ => Classical.choose_spec σ.property
  let Mnat : ℕ := ∏ σ : U, (witness σ : ℕ)
  have hMnat : 0 < Mnat := by
    exact Finset.prod_pos fun σ _ => (witness σ).property
  let M : PositiveNat := ⟨Mnat, hMnat⟩
  refine ⟨M, ?_⟩
  rw [iSup_powerTupleStabilizer_eq_union (F := F)]
  apply le_antisymm
  · intro σ hσ
    exact ⟨M, hσ⟩
  · intro σ hσ
    let σU : U := ⟨σ, hσ⟩
    have hdvd : (witness σU : ℕ) ∣ Mnat := by
      exact Finset.dvd_prod_of_mem (fun τ : U => (witness τ : ℕ))
        (Finset.mem_univ σU)
    rcases hdvd with ⟨d, hd⟩
    have hdpos : 0 < d := by
      by_contra hd0
      have : d = 0 := Nat.eq_zero_of_not_pos hd0
      subst d
      simp only [mul_zero] at hd
      exact (Nat.ne_of_gt hMnat) hd
    have hlift := powerTupleStabilizer_le_mul (F := F) y (witness σU) ⟨d, hdpos⟩
      (hwitness σU)
    simpa only [M, Mnat, hd] using hlift

/-- Power-primitive fixed-field normal form: after one positive power, every further positive
power has the same stabilizer and the same stable fixed field. -/
theorem exists_powerTupleStabilizer_primitive_core
    [Finite (N ≃ₐ[F] N)] (y : Fin 2 → N) :
    ∃ m : PositiveNat,
      (∀ k : PositiveNat,
        powerTupleStabilizer (F := F) y
            ⟨(m : ℕ) * (k : ℕ), Nat.mul_pos m.property k.property⟩ =
          powerTupleStabilizer (F := F) y m) ∧
      (⨅ k : PositiveNat,
          IntermediateField.fixedField (powerTupleStabilizer (F := F) y k)) =
        IntermediateField.fixedField (powerTupleStabilizer (F := F) y m) := by
  obtain ⟨m, hm⟩ := exists_powerTupleStabilizer_eq_iSup (F := F) y
  refine ⟨m, ?_, ?_⟩
  · intro k
    apply le_antisymm
    · rw [hm]
      exact le_iSup (fun j : PositiveNat => powerTupleStabilizer (F := F) y j)
        ⟨(m : ℕ) * (k : ℕ), Nat.mul_pos m.property k.property⟩
    · exact powerTupleStabilizer_le_mul (F := F) y m k
  · rw [← fixedField_iSup, ← hm]

end


end GaloisForLFunctions.HTGeometry
