import Mathlib.Algebra.Polynomial.Splits
import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.Algebra.Polynomial.UnitTrinomial
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Algebra.BigOperators.Ring.Finset

/-!
# Roots of an étale split polynomial differ by units

If a monic polynomial splits and its derivative is a unit at one root, then that root differs from
every other root by a unit — each difference is a factor of the derivative's value.  Over a
polynomial ring the units are the nonzero constants, so the differences are **constants**.

```text
isUnit_sub_of_isUnit_eval_derivative     r - a is a unit
exists_C_of_isUnit_sub                   over `F[u]`, r - a is a constant
exists_mem_add_mem_of_sum_mem            the characteristic-zero average puts a root in `B + C`
```

This is the mechanism behind the field form of algebraic simple connectedness of the affine line: an
unramified cover splits after base change to the algebraic closure, the roots then differ by
constants, and in characteristic zero averaging the roots exhibits the cover as a *constant*
extension.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial


/-- **Simple roots of a split polynomial with unit derivative differ by units.** -/
theorem isUnit_sub_of_isUnit_eval_derivative {R : Type*} [CommRing R] [DecidableEq R]
    {S : Multiset R} {r : R} (hr : r ∈ S)
    (h : IsUnit (Polynomial.eval r (Polynomial.derivative
      (Multiset.map (fun a => Polynomial.X - Polynomial.C a) S).prod)))
    {a : R} (ha : a ∈ S.erase r) : IsUnit (r - a) := by
  rw [Polynomial.eval_multiset_prod_X_sub_C_derivative hr] at h
  exact isUnit_of_dvd_unit (Multiset.dvd_prod (Multiset.mem_map_of_mem _ ha)) h

/-- **Over a polynomial ring, those differences are constants.** -/
theorem exists_C_of_isUnit_sub {F : Type*} [Field F] [DecidableEq (Polynomial F)]
    {S : Multiset (Polynomial F)} {r : Polynomial F} (hr : r ∈ S)
    (h : IsUnit (Polynomial.eval r (Polynomial.derivative
      (Multiset.map (fun a => Polynomial.X - Polynomial.C a) S).prod)))
    {a : Polynomial F} (ha : a ∈ S.erase r) :
    ∃ c : F, r - a = Polynomial.C c := by
  obtain ⟨c, -, hc⟩ := Polynomial.isUnit_iff.mp (isUnit_sub_of_isUnit_eval_derivative hr h ha)
  exact ⟨c, hc.symm⟩

/-- **Averaging a family whose sum lies in `B` and whose spread lies in `C`.**  In characteristic
zero a member of the family lies in `B + C`.  With `B` the base rational function field and `C` the
constants, this is the step that turns "the roots differ by constants" into "the extension is
generated by a constant". -/
theorem exists_mem_add_mem_of_sum_mem {A : Type*} [Field A] [CharZero A]
    (B C : Subfield A) {n : ℕ} (hn : 0 < n) (r : Fin n → A)
    (hsum : (∑ i, r i) ∈ B) (i₀ : Fin n) (hdiff : ∀ i, r i - r i₀ ∈ C) :
    ∃ b ∈ B, ∃ c ∈ C, r i₀ = b + c := by
  have hnA : (n : A) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have key : (n : A) * r i₀ = (∑ i, r i) - ∑ i, (r i - r i₀) := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin]
    simp [nsmul_eq_mul]
  refine ⟨(n : A)⁻¹ * (∑ i, r i), ?_, -((n : A)⁻¹ * ∑ i, (r i - r i₀)), ?_, ?_⟩
  · exact B.mul_mem (B.inv_mem (natCast_mem B n)) hsum
  · exact C.neg_mem (C.mul_mem (C.inv_mem (natCast_mem C n)) (C.sum_mem fun i _ => hdiff i))
  · field_simp
    linear_combination key

end GaloisForLFunctions.HTGeometry
