import GaloisForLFunctions.HTGeometry.CrossRelationCoefficientField
import GaloisForLFunctions.HTGeometry.DifferentialRelationBaseChange

/-!
# Two coefficients of the characteristic already carry a relation

The coefficient cross-relation of a characteristic is a relation of the free element over the
intermediate field, and all of its coefficients lie in the field generated by the two coefficients it
was built from.  Descending it there keeps it a relation, because evaluation does not change when the
coefficient field grows.

So a pair of characteristic coefficients carries a relation of the free element over the small field
they generate — the object a Lüroth argument compares with the characteristic itself.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- **The descended cross-relation is a relation over the field of its two coefficients.** -/
theorem descend_crossRelation_mem_relationIdeal (G : IntermediateField F E) (p q : G)
    (P Q : DifferentialPolynomial Unit F) {y : E}
    (hle : IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) ≤ G)
    (hmem : differentialCharacteristicCoefficientCrossRelation G p q P Q
      ∈ differentialIntermediateRelationIdeal G y) :
    HTGeometry.descendCoefficients hle
        (differentialCharacteristicCoefficientCrossRelation G p q P Q)
        (coeff_crossRelation_mem_adjoin G p q P Q)
      ∈ differentialIntermediateRelationIdeal
        (IntermediateField.adjoin F ({(p : E), (q : E)} : Set E)) y := by
  rw [mem_differentialIntermediateRelationIdeal_iff]
  have hmap := differentialPolynomialEvalOver_map_inclusion hle y
    (HTGeometry.descendCoefficients hle
      (differentialCharacteristicCoefficientCrossRelation G p q P Q)
      (coeff_crossRelation_mem_adjoin G p q P Q))
  rw [crossRelation_descends G p q P Q hle] at hmap
  rw [← hmap]
  exact hmem

end

end GaloisForLFunctions
