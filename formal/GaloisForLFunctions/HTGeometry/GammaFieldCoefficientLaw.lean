import GaloisForLFunctions.HTGeometry.GammaFieldRatDatum
import GaloisForLFunctions.HTGeometry.FinitePhaseLawFromRatios

/-!
# The finite phase law with coefficients from the Gamma field

The law consumes coefficients through their residues against Gamma-jet shapes.  For coefficients
drawn from the differential field generated by `Γ` over `ℂ(s)` those residues no longer have to be
assumed: a nonzero element has one, and any two meromorphic representatives of the same element agree
on the line far enough up, so the residue transfers to whichever representative appears in the
relation.
-/

open Filter Set Topology Function
open scoped Differential
open scoped BoundedContinuousFunction

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance gammaLawDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance gammaLawIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance gammaLawDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance gammaLawComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance gammaLawRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

/-- A nonzero polynomial has no zeros far up a vertical line. -/
theorem eventually_polyLine_ne_zero (σ : ℝ) {q : Polynomial ℂ} (hq : q ≠ 0) :
    ∀ᶠ t : ℝ in atTop, q.eval ((σ : ℂ) + (t : ℂ) * Complex.I) ≠ 0 := by
  have hpoly := tendsto_polynomial_mul_inv_pow σ q
  have hlead : q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hq
  filter_upwards [hpoly.eventually_ne hlead] with t ht h0
  rw [h0, zero_mul] at ht
  exact ht rfl

/-- **Two cleared representatives of the same element agree on the line.** -/
theorem eventually_line_eq_of_representatives (σ : ℝ) {x : upperEndMeroField}
    {q q' : Polynomial ℂ} {W W' : upperEndAnalyticSubring} {f f' : ℂ → ℂ}
    (hq : q ≠ 0) (hq' : q' ≠ 0)
    (hW : upperEndPolyToMero q * x = algebraMap upperEndAnalyticSubring upperEndMeroField W)
    (hW' : upperEndPolyToMero q' * x = algebraMap upperEndAnalyticSubring upperEndMeroField W')
    (hf : upperEndAnalyticSubring.subtype W = Germ.coeRingHom upperEndFilter f)
    (hf' : upperEndAnalyticSubring.subtype W' = Germ.coeRingHom upperEndFilter f') :
    ∀ᶠ t : ℝ in atTop,
      f ((σ : ℂ) + (t : ℂ) * Complex.I) / q.eval ((σ : ℂ) + (t : ℂ) * Complex.I)
        = f' ((σ : ℂ) + (t : ℂ) * Complex.I) / q'.eval ((σ : ℂ) + (t : ℂ) * Complex.I) := by
  classical
  -- the two cleared elements are proportional
  have hcross : algebraMap upperEndAnalyticSubring upperEndMeroField
      (upperEndPolyToAnalytic q' * W)
      = algebraMap upperEndAnalyticSubring upperEndMeroField (upperEndPolyToAnalytic q * W') := by
    rw [map_mul, map_mul, ← hW, ← hW']
    show upperEndPolyToMero q' * (upperEndPolyToMero q * x)
      = upperEndPolyToMero q * (upperEndPolyToMero q' * x)
    ring
  have hanal : upperEndPolyToAnalytic q' * W = upperEndPolyToAnalytic q * W' :=
    IsFractionRing.injective upperEndAnalyticSubring upperEndMeroField hcross
  have hgerm : Germ.coeRingHom upperEndFilter (fun z : ℂ => q'.eval z * f z)
      = Germ.coeRingHom upperEndFilter (fun z : ℂ => q.eval z * f' z) := by
    have h1 := congrArg upperEndAnalyticSubring.subtype hanal
    rw [map_mul, map_mul, polyToAnalytic_subtype, polyToAnalytic_subtype, hf, hf',
      ← map_mul, ← map_mul] at h1
    exact h1
  have hev : ∀ᶠ z : ℂ in upperEndFilter, q'.eval z * f z = q.eval z * f' z :=
    Filter.Germ.coe_eq.mp hgerm
  have hline := eventually_line_of_upperEnd hev σ
  filter_upwards [hline, eventually_polyLine_ne_zero σ hq, eventually_polyLine_ne_zero σ hq']
    with t ht hq0 hq'0
  field_simp
  linear_combination ht

/-- **The finite phase law with coefficients from the Gamma field.**  The residue hypothesis is
discharged: nonzero coefficients drawn from the differential field generated by `Γ` over `ℂ(s)` have
their Gamma-jet data automatically. -/
theorem finite_phase_law_of_gammaField_coefficients {n N : ℕ} {σ R rr ρ : ℝ} (hσ : 0 < σ)
    (hN : 0 < N) (hr : 0 < rr) (hρ : 0 < ρ) (hrρ : rr + ρ < R) (hR : 0 < R) {Φ : ℂ → ℂ}
    (hΦ : DifferentiableOn ℂ Φ (verticalStrip σ R)) (hap : IsStripAlmostPeriodic Φ σ R)
    (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialJetAlgebra (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0) (F : Fin N → ℂ → ℂ)
    (hFrep : ∀ α, ∃ (q : Polynomial ℂ) (W : upperEndAnalyticSubring), q ≠ 0
      ∧ upperEndPolyToMero q * x α = algebraMap upperEndAnalyticSubring upperEndMeroField W
      ∧ upperEndAnalyticSubring.subtype W
        = Germ.coeRingHom upperEndFilter (fun z : ℂ => q.eval z * F α z))
    (hrel : ∀ s : ℂ, ∑ α, F α s * ∏ i : Fin (n + 1), (iteratedDeriv (i : ℕ) Φ s) ^ (e α i) = 0)
    {f : ℝ →ᵇ ℂ} (hf : ∀ y : ℝ, f y = Φ ((σ : ℂ) + (y : ℂ) * Complex.I))
    (hfu : UniformContinuous (fun y => f y)) (hftb : HasTotallyBoundedOrbit (fun y => f y))
    [MeasurableSpace (BohrHull f)] [BorelSpace (BohrHull f)] :
    ∃ (β : Fin N) (d : Fin N → ℂ), d β = 1
      ∧ (∀ z ∈ verticalStrip σ R,
        jetPoly d e (fun i : Fin (n + 1) => iteratedDeriv (i : ℕ) Φ z) = 0)
      ∧ (∑ α : Fin N, MvPolynomial.C (d α)
          * ∏ i : Fin (n + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) ℂ) ^ (e α i)) ≠ 0
      ∧ ∃ K : ℕ, Module.rank ℤ (bohrHullFrequencies f) ≤ (K : Cardinal) := by
  classical
  have hdat : ∀ α : Fin N, ∃ (u a d b : ℕ) (c : ℂ), c ≠ 0 ∧
      Tendsto (fun t : ℝ => F α ((σ : ℂ) + (t : ℂ) * Complex.I)
        / gammaJetShape σ u a d b t) atTop (nhds c) := by
    intro α
    obtain ⟨q', W', G', u, a, d, b, c, hq', hc, hW', hG'germ, hlim⟩ :=
      exists_gammaAlgebra_line_datum hσ (hxmem α) (hx0 α)
    obtain ⟨q, W, hq, hW, hWgerm⟩ := hFrep α
    refine ⟨u, a, d, b, c, hc, hlim.congr' ?_⟩
    have hev := eventually_line_eq_of_representatives σ hq' hq hW' hW hG'germ hWgerm
    filter_upwards [hev, eventually_polyLine_ne_zero σ hq] with t ht hq0
    rw [ht, mul_comm, mul_div_assoc, div_self hq0, mul_one]
  choose u a d b c hc hFlim using hdat
  exact finite_phase_law_of_gammaJet_data hσ hN hr hρ hrρ hR hΦ hap e F u a d b c hc hFlim hrel
    he hf hfu hftb

end

end GaloisForLFunctions.HTGeometry
