import GaloisForLFunctions.HTGeometry.DifferenceTensorTorsor

/-!
# The tensor square is generated by the comparison matrix

The second half of the torsor property.  A Picard--Vessiot ring is generated over the base by the
entries of a fundamental matrix and the inverse of its determinant.  Inside the tensor square the
two copies of that matrix differ by the comparison matrix `Z`, so the whole tensor square is
generated over the left copy of the ring by the entries of `Z` and the inverse of `det Z`.

Together with `exists_tensor_comparison_matrix`, whose entries of `Z` are constants, this is the
statement that the Picard--Vessiot ring is a torsor: `R ⊗_K R` is `R` tensored with the coordinate
ring of a group over the constants.

Nothing here uses the difference structure; it is a statement about generation of tensor squares.
-/

open scoped TensorProduct

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K R : Type*} [Field K] [CommRing R] [Algebra K R] {n : ℕ}

theorem det_leftFundamental (Y : Matrix (Fin n) (Fin n) R) :
    (leftFundamental K Y).det = Y.det ⊗ₜ[K] (1 : R) := by
  have h := RingHom.map_det
    ((Algebra.TensorProduct.includeLeft : R →ₐ[K] (R ⊗[K] R)).toRingHom) Y
  rw [RingHom.mapMatrix_apply] at h
  exact h.symm

theorem det_rightFundamental (Y : Matrix (Fin n) (Fin n) R) :
    (rightFundamental K Y).det = (1 : R) ⊗ₜ[K] Y.det := by
  have h := RingHom.map_det
    ((Algebra.TensorProduct.includeRight : R →ₐ[K] (R ⊗[K] R)).toRingHom) Y
  rw [RingHom.mapMatrix_apply] at h
  exact h.symm

/-- **The tensor square is generated by the left copy together with the comparison matrix.** -/
theorem adjoin_tensor_comparison_eq_top
    (Y : Matrix (Fin n) (Fin n) R) (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) = ⊤)
    (Z : Matrix (Fin n) (Fin n) (R ⊗[K] R)) (w : R ⊗[K] R)
    (hZ : leftFundamental K Y * Z = rightFundamental K Y)
    (hw : Z.det * w = 1) :
    Algebra.adjoin K
      ((Set.range (fun x : R => x ⊗ₜ[K] (1 : R))
        ∪ Set.range (fun p : Fin n × Fin n => Z p.1 p.2)) ∪ {w}) = ⊤ := by
  classical
  set S : Set (R ⊗[K] R) :=
    (Set.range (fun x : R => x ⊗ₜ[K] (1 : R))
      ∪ Set.range (fun p : Fin n × Fin n => Z p.1 p.2)) ∪ {w} with hS
  set T : Subalgebra K (R ⊗[K] R) := Algebra.adjoin K S with hT
  have hLmem : ∀ x : R, (x ⊗ₜ[K] (1 : R)) ∈ T :=
    fun x => Algebra.subset_adjoin (Or.inl (Or.inl ⟨x, rfl⟩))
  have hZmem : ∀ i j : Fin n, Z i j ∈ T :=
    fun i j => Algebra.subset_adjoin (Or.inl (Or.inr ⟨(i, j), rfl⟩))
  have hwmem : w ∈ T := Algebra.subset_adjoin (Or.inr rfl)
  have hRY : ∀ i j : Fin n, ((1 : R) ⊗ₜ[K] Y i j) ∈ T := by
    intro i j
    have hval : ((1 : R) ⊗ₜ[K] Y i j) = ∑ k, (Y i k ⊗ₜ[K] (1 : R)) * Z k j := by
      have h := congrFun (congrFun hZ i) j
      simp only [Matrix.mul_apply, leftFundamental, rightFundamental, Matrix.map_apply] at h
      exact h.symm
    rw [hval]
    exact T.sum_mem fun k _ => T.mul_mem (hLmem (Y i k)) (hZmem k j)
  have hdetZ : ((1 : R) ⊗ₜ[K] Y.det) = (Y.det ⊗ₜ[K] (1 : R)) * Z.det := by
    have h := congrArg Matrix.det hZ
    rw [Matrix.det_mul, det_leftFundamental, det_rightFundamental] at h
    exact h.symm
  have hRu : ((1 : R) ⊗ₜ[K] u) = (u ⊗ₜ[K] (1 : R)) * w := by
    have h1 : ((1 : R) ⊗ₜ[K] u) * ((1 : R) ⊗ₜ[K] Y.det) = 1 := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_comm u Y.det, hu,
        ← Algebra.TensorProduct.one_def]
    have h2 : ((u ⊗ₜ[K] (1 : R)) * w) * ((1 : R) ⊗ₜ[K] Y.det) = 1 := by
      rw [hdetZ]
      calc (u ⊗ₜ[K] (1 : R)) * w * ((Y.det ⊗ₜ[K] (1 : R)) * Z.det)
          = ((u ⊗ₜ[K] (1 : R)) * (Y.det ⊗ₜ[K] (1 : R))) * (Z.det * w) := by ring
        _ = ((u * Y.det) ⊗ₜ[K] (1 : R)) * 1 := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hw]
        _ = 1 := by
              rw [mul_one, mul_comm u Y.det, hu, ← Algebra.TensorProduct.one_def]
    calc ((1 : R) ⊗ₜ[K] u)
        = ((1 : R) ⊗ₜ[K] u) * (((u ⊗ₜ[K] (1 : R)) * w) * ((1 : R) ⊗ₜ[K] Y.det)) := by
          rw [h2, mul_one]
      _ = (((1 : R) ⊗ₜ[K] u) * ((1 : R) ⊗ₜ[K] Y.det)) * ((u ⊗ₜ[K] (1 : R)) * w) := by ring
      _ = (u ⊗ₜ[K] (1 : R)) * w := by rw [h1, one_mul]
  have hRumem : ((1 : R) ⊗ₜ[K] u) ∈ T := by
    rw [hRu]
    exact T.mul_mem (hLmem u) hwmem
  have hRmem : ∀ x : R, ((1 : R) ⊗ₜ[K] x) ∈ T := by
    intro x
    have hx : x ∈ Algebra.adjoin K
        (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) := by rw [htop]; trivial
    refine Algebra.adjoin_induction
      (p := fun y _ => ((1 : R) ⊗ₜ[K] y) ∈ T) ?_ ?_ ?_ ?_ hx
    · rintro y (⟨p, rfl⟩ | hy)
      · exact hRY p.1 p.2
      · rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact hRumem
    · intro a
      have hcast : ((1 : R) ⊗ₜ[K] (algebraMap K R a))
          = algebraMap K (R ⊗[K] R) a :=
        (Algebra.TensorProduct.includeRight : R →ₐ[K] (R ⊗[K] R)).commutes a
      rw [hcast]
      exact T.algebraMap_mem a
    · intro y z _ _ hy hz
      rw [TensorProduct.tmul_add]
      exact T.add_mem hy hz
    · intro y z _ _ hy hz
      have hsplit : (1 : R) ⊗ₜ[K] (y * z) = ((1 : R) ⊗ₜ[K] y) * ((1 : R) ⊗ₜ[K] z) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rw [hsplit]
      exact T.mul_mem hy hz
  refine Algebra.eq_top_iff.mpr fun v => ?_
  induction v using TensorProduct.induction_on with
  | zero => exact T.zero_mem
  | tmul x y =>
      have hsplit : x ⊗ₜ[K] y = (x ⊗ₜ[K] (1 : R)) * ((1 : R) ⊗ₜ[K] y) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hsplit]
      exact T.mul_mem (hLmem x) (hRmem y)
  | add v₁ v₂ h₁ h₂ => exact T.add_mem h₁ h₂

end

end GaloisForLFunctions.HTGeometry
