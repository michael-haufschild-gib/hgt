import GaloisForLFunctions.HTGeometry.ProjectiveQuantumFisherValue

/-!
# Quantum-geometric metric--Berry gap as complex Gram energy

For two horizontal quantum-state tangent channels `u,v`, retain only their static inner-product
values.  The determinant of the real quantum metric and the Berry-curvature value are

```text
metricArea(u,v) = ‖u‖² ‖v‖² - Re⟨u,v⟩²,
berry(u,v)      = -2 Im⟨u,v⟩.
```

Their exact gap is

```text
metricArea(u,v) - berry(u,v)²/4
  = ‖u‖² ‖v‖² - |⟨u,v⟩|².
```

Thus the familiar metric--Berry inequality is Cauchy--Schwarz, while strictness is exactly
complex two-channel linear independence.  This is an observability identity: it uses neither a
Hamiltonian nor temporal evolution.  In a moment/Krylov realization the same gap is the first
nontrivial Hankel determinant, so a strict quantum-geometric inequality directly discharges that
determinant's positivity hypothesis.

The saturation theorems also make the no-go sharp.  Berry curvature can be nonzero on the single
complex line generated by `v`, because the phase tangent `i v` has nonzero Berry value but zero
complex Gram energy.  Curvature alone therefore cannot prove complex channel independence; the
positive replacement is strict *metric excess over curvature*.

Physics provenance: J. P. Provost and G. Vallee, *Riemannian structure on manifolds of quantum
states*, Commun. Math. Phys. 76 (1980), 289--301, DOI 10.1007/BF02193559; T. Ozawa and B. Mera,
*Relations between topology and the quantum metric for Chern insulators*, Phys. Rev. B 104
(2021), 045103, DOI 10.1103/PhysRevB.104.045103.  The latter derives the metric--Berry inequality
from positivity of the quantum geometric tensor and discusses its equality condition.
-/

open scoped InnerProductSpace

namespace HTGeometry

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Determinant of the real quantum metric of two horizontal tangent channels. -/
def quantumMetricAreaValue (u v : E) : ℝ :=
  ‖u‖ ^ 2 * ‖v‖ ^ 2 - (inner ℂ u v).re ^ 2

/-- Berry-curvature value in the convention `Omega = -2 Im Q`. -/
def berryCurvatureValue (u v : E) : ℝ :=
  -2 * (inner ℂ u v).im

/-- The metric area splits exactly into complex Gram energy and Berry-curvature area. -/
theorem quantumMetricAreaValue_eq_projectiveGram_add_berry
    (u v : E) :
    quantumMetricAreaValue u v =
      projectiveGramTangentEnergy (𝕜 := ℂ) u v +
        berryCurvatureValue u v ^ 2 / 4 := by
  unfold quantumMetricAreaValue projectiveGramTangentEnergy berryCurvatureValue
  rw [Complex.sq_norm, Complex.normSq_apply]
  ring

/-- The pointwise quantum-geometric metric--curvature inequality. -/
theorem berryCurvature_sq_div_four_le_quantumMetricAreaValue
    (u v : E) :
    berryCurvatureValue u v ^ 2 / 4 ≤ quantumMetricAreaValue u v := by
  rw [quantumMetricAreaValue_eq_projectiveGram_add_berry]
  exact le_add_of_nonneg_left (projectiveGramTangentEnergy_nonneg u v)

/-- Strict metric excess over Berry curvature is exactly positive complex Gram energy. -/
theorem quantumMetricArea_strict_iff_projectiveGram_pos
    (u v : E) :
    berryCurvatureValue u v ^ 2 / 4 < quantumMetricAreaValue u v ↔
      0 < projectiveGramTangentEnergy (𝕜 := ℂ) u v := by
  rw [quantumMetricAreaValue_eq_projectiveGram_add_berry]
  constructor <;> intro h <;> nlinarith

/-- The complex Gram determinant of a pair is its projective tangent energy. -/
theorem det_gram_pair_eq_projectiveGramTangentEnergy
    (u v : E) :
    (Matrix.gram ℂ ![u, v]).det =
      (projectiveGramTangentEnergy (𝕜 := ℂ) u v : ℂ) := by
  rw [Matrix.det_fin_two]
  simp only [Matrix.gram_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    inner_self_eq_norm_sq_to_K]
  rw [← inner_conj_symm u v, ← Complex.normSq_eq_conj_mul_self,
    Complex.normSq_eq_norm_sq]
  simp [projectiveGramTangentEnergy, norm_inner_symm]

/-- A strict quantum metric--Berry gap discharges complex two-channel linear independence. -/
theorem linearIndependent_pair_of_quantumMetricArea_strict
    {u v : E}
    (hstrict : berryCurvatureValue u v ^ 2 / 4 < quantumMetricAreaValue u v) :
    LinearIndependent ℂ ![u, v] := by
  apply Matrix.det_gram_ne_zero_iff_linearIndependent.mp
  rw [det_gram_pair_eq_projectiveGramTangentEnergy]
  exact_mod_cast (quantumMetricArea_strict_iff_projectiveGram_pos u v).mp hstrict |>.ne'

/-- The strict metric--curvature gap is equivalent to complex two-channel independence. -/
theorem quantumMetricArea_strict_iff_linearIndependent_pair
    (u v : E) :
    berryCurvatureValue u v ^ 2 / 4 < quantumMetricAreaValue u v ↔
      LinearIndependent ℂ ![u, v] := by
  constructor
  · exact linearIndependent_pair_of_quantumMetricArea_strict
  · intro hli
    rw [quantumMetricArea_strict_iff_projectiveGram_pos]
    have hdet : (Matrix.gram ℂ ![u, v]).det ≠ 0 :=
      Matrix.det_gram_ne_zero_iff_linearIndependent.mpr hli
    rw [det_gram_pair_eq_projectiveGramTangentEnergy] at hdet
    have henergy : projectiveGramTangentEnergy (𝕜 := ℂ) u v ≠ 0 := by
      exact_mod_cast hdet
    exact (projectiveGramTangentEnergy_nonneg u v).lt_of_ne henergy.symm

/-- Equality in the metric--curvature bound is exactly complex two-channel dependence. -/
theorem quantumMetricArea_eq_berry_iff_not_linearIndependent_pair
    (u v : E) :
    quantumMetricAreaValue u v = berryCurvatureValue u v ^ 2 / 4 ↔
      ¬ LinearIndependent ℂ ![u, v] := by
  constructor
  · intro heq hli
    have hstrict := (quantumMetricArea_strict_iff_linearIndependent_pair u v).mpr hli
    linarith
  · intro hnli
    apply le_antisymm
    · exact le_of_not_gt fun hstrict =>
        hnli ((quantumMetricArea_strict_iff_linearIndependent_pair u v).mp hstrict)
    · exact berryCurvature_sq_div_four_le_quantumMetricAreaValue u v

/-- A pure phase tangent can carry nonzero Berry curvature while staying in one complex line. -/
theorem berryCurvatureValue_I_smul_left (v : E) :
    berryCurvatureValue (Complex.I • v) v = 2 * ‖v‖ ^ 2 := by
  unfold berryCurvatureValue
  rw [inner_smul_left, inner_self_eq_norm_sq_to_K]
  norm_num [Complex.mul_im]
  rw [← Complex.ofReal_pow]
  exact Complex.ofReal_re _

/-- The pure phase tangent saturates the metric--curvature inequality. -/
theorem quantumMetricAreaValue_I_smul_left (v : E) :
    quantumMetricAreaValue (Complex.I • v) v =
      berryCurvatureValue (Complex.I • v) v ^ 2 / 4 := by
  rw [quantumMetricAreaValue_eq_projectiveGram_add_berry]
  have henergy :
      projectiveGramTangentEnergy (𝕜 := ℂ) (Complex.I • v) v = 0 := by
    unfold projectiveGramTangentEnergy
    rw [norm_smul, Complex.norm_I, one_mul, inner_smul_left,
      inner_self_eq_norm_sq_to_K]
    norm_num [Complex.mul_re]
    ring
  rw [henergy, zero_add]

/-- Thus Berry curvature alone cannot prove complex two-channel independence. -/
theorem berryCurvatureValue_I_smul_left_ne_zero
    {v : E} (hv : v ≠ 0) :
    berryCurvatureValue (Complex.I • v) v ≠ 0 := by
  rw [berryCurvatureValue_I_smul_left]
  positivity

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F]

/-- In a moment/Krylov realization, the metric--Berry excess is the first Hankel determinant. -/
theorem quantumMetricArea_sub_berry_eq_firstKrylovDeterminant
    (m : ℕ → ℝ) (v : ℕ → F)
    (hgram : ∀ i j, inner ℂ (v i) (v j) = (m (i + j) : ℂ)) :
    quantumMetricAreaValue (v 0) (v 1) -
        berryCurvatureValue (v 0) (v 1) ^ 2 / 4 =
      m 0 * m 2 - m 1 ^ 2 := by
  rw [quantumMetricAreaValue_eq_projectiveGram_add_berry]
  rw [add_sub_cancel_right]
  exact projectiveGramTangentEnergy_eq_firstKrylovDeterminant m v hgram

/-- The strict quantum-geometric gap is exactly positivity of the first Hankel determinant. -/
theorem quantumMetricArea_strict_iff_firstKrylovDeterminant_pos
    (m : ℕ → ℝ) (v : ℕ → F)
    (hgram : ∀ i j, inner ℂ (v i) (v j) = (m (i + j) : ℂ)) :
    berryCurvatureValue (v 0) (v 1) ^ 2 / 4 <
        quantumMetricAreaValue (v 0) (v 1) ↔
      0 < m 0 * m 2 - m 1 ^ 2 := by
  rw [quantumMetricArea_strict_iff_projectiveGram_pos]
  rw [projectiveGramTangentEnergy_eq_firstKrylovDeterminant m v hgram]

end

end HTGeometry
