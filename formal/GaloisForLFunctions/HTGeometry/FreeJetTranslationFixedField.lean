import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import GaloisForLFunctions.HTGeometry.FreeCoordinateField
import GaloisForLFunctions.HTGeometry.RatFuncTranslationFixedField
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Translation fixed fields of free rational jets

The free rational coordinate field carries the literal independent translation action obtained
by sending each polynomial variable `X i` to `X i + c i` and extending to the fraction field.
This file identifies the common fixed field of translations in all jet coordinates below a
chosen depth with the rational field generated by the remaining tail coordinates.

The reverse inclusion is unconditional.  For one coordinate, the ambient field is a simple
transcendental extension of the field generated by all other coordinates.  Conjugating unit
translation to a rational function field reduces fixedness to the characteristic-zero theorem
that a periodic rational function is constant.  Applying this one coordinate at a time and then
the free-coordinate partial-kernel theorem gives the exact low-jet/tail equality.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Polynomial

/-- Two algebra maps out of a rational function field agree when they agree on `X`. -/
private theorem ratFuncAlgHom_ext_X
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    {f g : RatFunc K →ₐ[K] E} (hX : f RatFunc.X = g RatFunc.X) :
    f = g := by
  apply AlgHom.ext
  intro z
  have hring : f.toRingHom = g.toRingHom := by
    apply IsFractionRing.ringHom_ext (A := K[X])
    intro p
    have hpoly :
        f.toRingHom.comp (algebraMap K[X] (RatFunc K)) =
          g.toRingHom.comp (algebraMap K[X] (RatFunc K)) := by
      apply Polynomial.ringHom_ext
      · intro c
        change f (algebraMap K (RatFunc K) c) =
          g (algebraMap K (RatFunc K) c)
        rw [f.commutes, g.commutes]
      · simpa [RatFunc.algebraMap_X] using hX
    exact DFunLike.congr_fun hpoly p
  exact DFunLike.congr_fun hring z

/-- A unit translation of a simple transcendental generator has no fixed elements outside the
base field. -/
theorem exists_eq_algebraMap_of_fixed_unit_translation
    {K E : Type*} [Field K] [Field E] [Algebra K E] [CharZero K]
    (x : E) (hx : Transcendental K x)
    (hgen : IntermediateField.adjoin K ({x} : Set E) = ⊤)
    (tau : E ≃ₐ[K] E)
    (htau : tau x = x + algebraMap K E 1)
    {z : E} (hz : tau z = z) :
    ∃ a : K, z = algebraMap K E a := by
  let e : RatFunc K ≃ₐ[K] E :=
    (RatFunc.algEquivOfTranscendental x hx).trans
      ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv)
  have heX : e RatFunc.X = x := by
    simp [e]
  let g : RatFunc K ≃ₐ[K] RatFunc K := e.trans (tau.trans e.symm)
  have hgX :
      g RatFunc.X = RatFunc.X + algebraMap K (RatFunc K) 1 := by
    apply e.injective
    simp [g, heX, htau]
  have hg : g =
      ratFuncTranslationAction (Multiplicative.ofAdd (1 : K)) := by
    have hhom : g.toAlgHom =
        (ratFuncTranslationAction
          (Multiplicative.ofAdd (1 : K))).toAlgHom :=
      ratFuncAlgHom_ext_X (f := g.toAlgHom)
        (g := (ratFuncTranslationAction
          (Multiplicative.ofAdd (1 : K))).toAlgHom) (by simpa using hgX)
    apply AlgEquiv.ext
    intro r
    exact DFunLike.congr_fun hhom r
  have hfixed :
      ratFuncTranslationAction (Multiplicative.ofAdd (1 : K)) (e.symm z) =
        e.symm z := by
    rw [← hg]
    change e.symm (tau (e (e.symm z))) = e.symm z
    rw [e.apply_symm_apply, hz]
  obtain ⟨a, ha⟩ :=
    ratFuncTranslation_fixed_eq_constant (1 : K) one_ne_zero hfixed
  refine ⟨a, ?_⟩
  calc
    z = e (e.symm z) := (e.apply_symm_apply z).symm
    _ = e (RatFunc.C a) := congrArg e ha
    _ = algebraMap K E a := by simpa using e.commutes a

/-- Independent translation by a coefficient family on the free rational coordinate field. -/
def freeCoordinateTranslationEquiv
    (C σ : Type*) [Field C] (c : σ → C) :
    FreeCoordinateRationalField C σ ≃ₐ[C] FreeCoordinateRationalField C σ :=
  IsFractionRing.algEquivOfAlgEquiv (mvPolynomialBaseTranslation c)

@[simp]
theorem freeCoordinateTranslationEquiv_freeCoordinate
    {C σ : Type*} [Field C] (c : σ → C) (i : σ) :
    freeCoordinateTranslationEquiv C σ c (freeCoordinate C σ i) =
      freeCoordinate C σ i +
        algebraMap C (FreeCoordinateRationalField C σ) (c i) := by
  rw [freeCoordinate, freeCoordinateTranslationEquiv,
    IsFractionRing.algEquivOfAlgEquiv_algebraMap,
    mvPolynomialBaseTranslation_X, map_add]
  rw [← MvPolynomial.algebraMap_eq,
    ← IsScalarTower.algebraMap_apply C (MvPolynomial σ C)
      (FreeCoordinateRationalField C σ)]

/-- A coordinate translation fixes every rational function generated by coordinates on which
its coefficient family vanishes. -/
theorem freeCoordinateTranslationEquiv_fixed_of_mem
    {C σ : Type*} [Field C] (c : σ → C) (S : Set σ)
    (hc : ∀ i ∈ S, c i = 0)
    {f : FreeCoordinateRationalField C σ}
    (hf : f ∈ freeCoordinateField C σ S) :
    freeCoordinateTranslationEquiv C σ c f = f := by
  rw [freeCoordinateField] at hf
  apply IntermediateField.adjoin_induction C
    (s := freeCoordinate C σ '' S)
    (p := fun z _ ↦ freeCoordinateTranslationEquiv C σ c z = z)
  · rintro _ ⟨i, hi, rfl⟩
    simp [hc i hi]
  · intro a
    exact (freeCoordinateTranslationEquiv C σ c).commutes a
  · intro x y _ _ hx hy
    rw [map_add, hx, hy]
  · intro x _ hx
    rw [map_inv₀, hx]
  · intro x y _ _ hx hy
    rw [map_mul, hx, hy]
  · exact hf

/-- Translation in one selected free coordinate. -/
def freeCoordinateTranslationAt
    (C σ : Type*) [Field C] (i : σ) (c : C) :
    FreeCoordinateRationalField C σ ≃ₐ[C] FreeCoordinateRationalField C σ :=
  by
    classical
    exact freeCoordinateTranslationEquiv C σ (fun j ↦ if j = i then c else 0)

@[simp]
theorem freeCoordinateTranslationAt_self
    {C σ : Type*} [Field C] (i : σ) (c : C) :
    freeCoordinateTranslationAt C σ i c (freeCoordinate C σ i) =
      freeCoordinate C σ i +
        algebraMap C (FreeCoordinateRationalField C σ) c := by
  classical
  simp [freeCoordinateTranslationAt]

theorem freeCoordinateTranslationAt_of_ne
    {C σ : Type*} [Field C] {i j : σ} (hji : j ≠ i) (c : C) :
    freeCoordinateTranslationAt C σ i c (freeCoordinate C σ j) =
      freeCoordinate C σ j := by
  classical
  simp [freeCoordinateTranslationAt, hji]

/-- The free coordinate family remains algebraically independent in its fraction field. -/
theorem algebraicIndependent_freeCoordinate
    (C σ : Type*) [Field C] :
    AlgebraicIndependent C (freeCoordinate C σ) := by
  let ι : MvPolynomial σ C →ₐ[C] FreeCoordinateRationalField C σ :=
    IsScalarTower.toAlgHom C (MvPolynomial σ C)
      (FreeCoordinateRationalField C σ)
  have hmap : AlgebraicIndependent C (ι ∘ MvPolynomial.X) :=
    (ι.algebraicIndependent_iff
      (IsFractionRing.injective (MvPolynomial σ C)
        (FreeCoordinateRationalField C σ))).2
      (MvPolynomial.algebraicIndependent_X σ C)
  simpa only [freeCoordinate, ι, Function.comp_apply] using hmap

/-- One free coordinate is transcendental over the field generated by all the others. -/
theorem freeCoordinate_transcendental_over_complement
    {C σ : Type*} [Field C] (i : σ) :
    Transcendental (freeCoordinateField C σ ({i}ᶜ))
      (freeCoordinate C σ i) := by
  have hsub :
      Transcendental
        (Algebra.adjoin C (freeCoordinate C σ '' ({i}ᶜ : Set σ)))
        (freeCoordinate C σ i) :=
    (algebraicIndependent_freeCoordinate C σ).transcendental_adjoin (by simp)
  exact (IntermediateField.transcendental_adjoin_iff).2 hsub

/-- Adjoining one coordinate to the field generated by all the others recovers the full free
rational coordinate field. -/
theorem freeCoordinate_complement_adjoin_eq_top
    {C σ : Type*} [Field C] [CharZero C] (i : σ) :
    IntermediateField.adjoin (freeCoordinateField C σ ({i}ᶜ))
      ({freeCoordinate C σ i} : Set (FreeCoordinateRationalField C σ)) = ⊤ := by
  rw [_root_.eq_top_iff]
  intro f _
  have hfull : f ∈ freeCoordinateField C σ Set.univ := by
    rw [freeCoordinateField_univ]
    trivial
  let L := IntermediateField.adjoin (freeCoordinateField C σ ({i}ᶜ))
    ({freeCoordinate C σ i} : Set (FreeCoordinateRationalField C σ))
  have hle : freeCoordinateField C σ Set.univ ≤ L.restrictScalars C := by
    rw [freeCoordinateField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨j, -, rfl⟩
    change freeCoordinate C σ j ∈ L
    by_cases hji : j = i
    · subst j
      exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)
    · let y : freeCoordinateField C σ ({i}ᶜ) :=
        ⟨freeCoordinate C σ j,
          IntermediateField.subset_adjoin C _ ⟨j, by simp [hji], rfl⟩⟩
      simpa [L, y] using L.algebraMap_mem y
  exact hle hfull

/-- Unit translation in `i`, regarded as an automorphism over the complementary coordinate
field. -/
def freeCoordinateUnitTranslationOverComplement
    (C σ : Type*) [Field C] (i : σ) :
    FreeCoordinateRationalField C σ ≃ₐ[freeCoordinateField C σ ({i}ᶜ)]
      FreeCoordinateRationalField C σ :=
  by
    classical
    exact AlgEquiv.ofRingEquiv
      (f := (freeCoordinateTranslationAt C σ i 1).toRingEquiv)
      (fun y ↦ by
        change freeCoordinateTranslationAt C σ i 1 y.1 = y.1
        apply freeCoordinateTranslationEquiv_fixed_of_mem
          (c := fun j ↦ if j = i then (1 : C) else 0) ({i}ᶜ : Set σ)
        · intro j hj
          simp only [Set.mem_compl_iff, Set.mem_singleton_iff] at hj
          simp [hj]
        · exact y.2)

@[simp]
theorem freeCoordinateUnitTranslationOverComplement_self
    {C σ : Type*} [Field C] (i : σ) :
    freeCoordinateUnitTranslationOverComplement C σ i
        (freeCoordinate C σ i) =
      freeCoordinate C σ i +
        algebraMap (freeCoordinateField C σ ({i}ᶜ))
          (FreeCoordinateRationalField C σ) 1 := by
  change freeCoordinateTranslationAt C σ i 1
      (freeCoordinate C σ i) = _
  simp

/-- A rational function fixed by unit translation in one coordinate belongs to the field
generated by all other coordinates. -/
theorem mem_freeCoordinateField_complement_of_unitTranslation_fixed
    {C σ : Type*} [Field C] [CharZero C] (i : σ)
    {f : FreeCoordinateRationalField C σ}
    (hf : freeCoordinateTranslationAt C σ i 1 f = f) :
    f ∈ freeCoordinateField C σ ({i}ᶜ) := by
  obtain ⟨a, ha⟩ := exists_eq_algebraMap_of_fixed_unit_translation
    (freeCoordinate C σ i)
    (freeCoordinate_transcendental_over_complement i)
    (freeCoordinate_complement_adjoin_eq_top i)
    (freeCoordinateUnitTranslationOverComplement C σ i)
    (freeCoordinateUnitTranslationOverComplement_self i)
    hf
  rw [ha]
  exact a.2

/-- The common fixed field of every independent coordinate translation. -/
def freeCoordinateTranslationFixedField
    (C σ : Type*) [Field C] :
    IntermediateField C (FreeCoordinateRationalField C σ) where
  carrier := {f | ∀ c : σ → C, freeCoordinateTranslationEquiv C σ c f = f}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy c
    rw [map_add, hx c, hy c]
  mul_mem' := by
    intro x y hx hy c
    rw [map_mul, hx c, hy c]
  algebraMap_mem' := by
    intro a c
    exact (freeCoordinateTranslationEquiv C σ c).commutes a
  inv_mem' := by
    intro x hx c
    rw [map_inv₀, hx c]

@[simp]
theorem mem_freeCoordinateTranslationFixedField_iff
    {C σ : Type*} [Field C]
    (f : FreeCoordinateRationalField C σ) :
    f ∈ freeCoordinateTranslationFixedField C σ ↔
      ∀ c : σ → C, freeCoordinateTranslationEquiv C σ c f = f :=
  Iff.rfl

/-- Being fixed by every independent coordinate translation is equivalent to being a scalar. -/
theorem all_freeCoordinateTranslations_fixed_iff
    {C σ : Type*} [Field C] [CharZero C]
    (f : FreeCoordinateRationalField C σ) :
    (∀ c : σ → C, freeCoordinateTranslationEquiv C σ c f = f) ↔
      ∃ a : C, f = algebraMap C (FreeCoordinateRationalField C σ) a := by
  classical
  constructor
  · intro hf
    apply (all_freeCoordinateDerivations_eq_zero_iff f).1
    intro i
    have hfixed : freeCoordinateTranslationAt C σ i 1 f = f := by
      simpa [freeCoordinateTranslationAt] using
        hf (fun j ↦ if j = i then (1 : C) else 0)
    have hmem :=
      mem_freeCoordinateField_complement_of_unitTranslation_fixed i hfixed
    exact ((mem_freeCoordinateField_iff ({i}ᶜ : Set σ) f).1 hmem) i (by simp)
  · rintro ⟨a, rfl⟩ c
    exact (freeCoordinateTranslationEquiv C σ c).commutes a

/-- The common fixed field of the full independent translation group is exactly the scalar
coefficient field. -/
@[simp]
theorem freeCoordinateTranslationFixedField_eq_bot
    {C σ : Type*} [Field C] [CharZero C] :
    freeCoordinateTranslationFixedField C σ = ⊥ := by
  apply le_antisymm
  · intro f hf
    obtain ⟨a, rfl⟩ :=
      (all_freeCoordinateTranslations_fixed_iff f).1 hf
    exact (⊥ : IntermediateField C (FreeCoordinateRationalField C σ)).algebraMap_mem a
  · exact bot_le

/-- The coordinate-current common kernel is the field generated by precisely the coordinates
whose currents were not imposed. -/
theorem freeCoordinateCommonKernelField_eq_freeCoordinateField
    {C σ : Type*} [Field C] [CharZero C] (S : Set σ) :
    freeCoordinateCommonKernelField C σ S = freeCoordinateField C σ S := by
  ext f
  rw [mem_freeCoordinateCommonKernelField_iff, mem_freeCoordinateField_iff]

/-- All coordinate currents have scalar common kernel. -/
@[simp]
theorem freeCoordinateCommonKernelField_empty
    {C σ : Type*} [Field C] [CharZero C] :
    freeCoordinateCommonKernelField C σ ∅ = ⊥ := by
  rw [freeCoordinateCommonKernelField_eq_freeCoordinateField,
    freeCoordinateField_empty]

/-- A translation coefficient family is supported strictly below jet depth `n`. -/
def FreeJetTranslationSupportedBelow
    {C ι : Type*} [Field C] (n : ℕ) (c : (ι × ℕ) → C) : Prop :=
  ∀ j, n ≤ j.2 → c j = 0

/-- The common fixed field of all independent translations supported strictly below depth `n`. -/
def freeJetLowTranslationFixedField
    (C ι : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C (ι × ℕ)) where
  carrier := {f | ∀ c : (ι × ℕ) → C,
    FreeJetTranslationSupportedBelow n c →
      freeCoordinateTranslationEquiv C (ι × ℕ) c f = f}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy c hc
    rw [map_add, hx c hc, hy c hc]
  mul_mem' := by
    intro x y hx hy c hc
    rw [map_mul, hx c hc, hy c hc]
  algebraMap_mem' := by
    intro a c hc
    exact (freeCoordinateTranslationEquiv C (ι × ℕ) c).commutes a
  inv_mem' := by
    intro x hx c hc
    rw [map_inv₀, hx c hc]

@[simp]
theorem mem_freeJetLowTranslationFixedField_iff
    {C ι : Type*} [Field C] (n : ℕ)
    (f : FreeCoordinateRationalField C (ι × ℕ)) :
    f ∈ freeJetLowTranslationFixedField C ι n ↔
      ∀ c : (ι × ℕ) → C,
        FreeJetTranslationSupportedBelow n c →
          freeCoordinateTranslationEquiv C (ι × ℕ) c f = f :=
  Iff.rfl

/-- The infinitesimal low-jet current-kernel field. -/
def freeJetLowCurrentKernelField
    (C ι : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C (ι × ℕ)) :=
  freeCoordinateCommonKernelField C (ι × ℕ) {j | n ≤ j.2}

/-- Exact infinitesimal statement: annihilation by every coordinate current of order below `n`
is membership in the depth-`n` tail field. -/
theorem freeJetLowCurrentKernelField_eq_tail
    {C ι : Type*} [Field C] [CharZero C] (n : ℕ) :
    freeJetLowCurrentKernelField C ι n = freeCoordinateTailField C ι n := by
  rw [freeJetLowCurrentKernelField,
    freeCoordinateCommonKernelField_eq_freeCoordinateField]
  rfl

/-- **Free-jet translation fixed-field theorem.** The depth-`n` tail field is exactly the common
fixed field of all independent translations of the jets of order strictly below `n`. -/
theorem freeJetLowTranslationFixedField_eq_tail
    {C ι : Type*} [Field C] [CharZero C] (n : ℕ) :
    freeJetLowTranslationFixedField C ι n = freeCoordinateTailField C ι n := by
  apply le_antisymm
  · intro f hf
    rw [mem_freeCoordinateTailField_iff]
    intro i k hk
    let j : ι × ℕ := (i, k)
    let c : (ι × ℕ) → C := fun q ↦ if q = j then 1 else 0
    have hc : FreeJetTranslationSupportedBelow n c := by
      intro q hq
      by_cases hqj : q = j
      · subst q
        exact (Nat.not_le_of_gt hk hq).elim
      · simp [c, hqj]
    have hfixed : freeCoordinateTranslationAt C (ι × ℕ) j 1 f = f := by
      simpa [freeCoordinateTranslationAt, c] using hf c hc
    have hmem :=
      mem_freeCoordinateField_complement_of_unitTranslation_fixed j hfixed
    exact ((mem_freeCoordinateField_iff ({j}ᶜ : Set (ι × ℕ)) f).1 hmem)
      j (by simp)
  · intro f hf c hc
    exact freeCoordinateTranslationEquiv_fixed_of_mem c {j | n ≤ j.2}
      (fun j hj ↦ hc j hj) hf

/-- Depth-two specialization used by the projective-horizon current transition. -/
theorem freeJetDepthTwoTranslationFixedField_eq_tail
    {C ι : Type*} [Field C] [CharZero C] :
    freeJetLowTranslationFixedField C ι 2 = freeCoordinateTailField C ι 2 :=
  freeJetLowTranslationFixedField_eq_tail 2

/-- Depth-two infinitesimal-current specialization. -/
theorem freeJetDepthTwoCurrentKernelField_eq_tail
    {C ι : Type*} [Field C] [CharZero C] :
    freeJetLowCurrentKernelField C ι 2 = freeCoordinateTailField C ι 2 :=
  freeJetLowCurrentKernelField_eq_tail 2

end

end GaloisForLFunctions.HTGeometry
