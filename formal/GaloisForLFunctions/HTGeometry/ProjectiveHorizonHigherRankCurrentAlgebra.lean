import GaloisForLFunctions.HTGeometry.ProjectiveHorizonCurrentAlgebra

/-!
# The first higher-rank projective horizon current algebra

For two distinct chart horizons in the projective plane, the constant gauge modes generate the
perfect affine-parabolic algebra `sl₂ ⋉ (K²)ᵛ`. Once the linear-in-arc modes are also present,
Lie brackets generate every polynomial current mode. This is the first higher-rank engine behind
the pairwise collapse of common depth-two projective-horizon invariants.

The file proves current-algebra generation and its representation-level annihilation consequence.
It does not postulate the separate rational fixed-field theorem.
-/

open scoped Matrix Polynomial

namespace GaloisForLFunctions

noncomputable section

variable (K : Type*) [Field K]

/-! The first two modes are the `sl₂` block. The `U,V` modes are the two lower-row shears. -/

/-- The polynomial upper-root mode `t^k E₀₁`. -/
def p2CurrentE (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, Polynomial.X ^ k, 0; 0, 0, 0; 0, 0, 0]

/-- The polynomial lower-root mode `t^k E₁₀`. -/
def p2CurrentF (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, 0, 0; Polynomial.X ^ k, 0, 0; 0, 0, 0]

/-- The first polynomial affine-shear mode `t^k E₂₀`. -/
def p2CurrentU (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, 0, 0; 0, 0, 0; Polynomial.X ^ k, 0, 0]

/-- The second polynomial affine-shear mode `t^k E₂₁`. -/
def p2CurrentV (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![0, 0, 0; 0, 0, 0; 0, Polynomial.X ^ k, 0]

/-- The polynomial diagonal mode `t^k(E₀₀-E₁₁)`. -/
def p2CurrentH (k : ℕ) : Matrix (Fin 3) (Fin 3) (Polynomial K) :=
  !![Polynomial.X ^ k, 0, 0; 0, -(Polynomial.X ^ k), 0; 0, 0, 0]

/-- The `sl₂` root bracket. -/
theorem p2Current_lie_E_F (i j : ℕ) :
    ⁅p2CurrentE K i, p2CurrentF K j⁆ = p2CurrentH K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentE, p2CurrentF, p2CurrentH,
      LieRing.of_associative_ring_bracket, pow_add, mul_comm]

/-- The diagonal action on the upper-root modes. -/
theorem p2Current_lie_H_E (i j : ℕ) :
    ⁅p2CurrentH K i, p2CurrentE K j⁆ = (2 : K) • p2CurrentE K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentE, p2CurrentH, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm, two_mul]

/-- The diagonal action on the lower-root modes. -/
theorem p2Current_lie_H_F (i j : ℕ) :
    ⁅p2CurrentH K i, p2CurrentF K j⁆ = -(2 : K) • p2CurrentF K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentF, p2CurrentH, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm, two_mul, sub_eq_add_neg]

/-- The first shear has diagonal weight `-1`. -/
theorem p2Current_lie_H_U (i j : ℕ) :
    ⁅p2CurrentH K i, p2CurrentU K j⁆ = -p2CurrentU K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentH, p2CurrentU, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm]

/-- The second shear has diagonal weight `1`. -/
theorem p2Current_lie_H_V (i j : ℕ) :
    ⁅p2CurrentH K i, p2CurrentV K j⁆ = p2CurrentV K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [p2CurrentH, p2CurrentV, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm]

/-- Constant and linear modes supplied by two distinct depth-two plane-chart gauges. -/
def p2DepthTwoCurrentGenerators :
    Set (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  {p2CurrentE K 0, p2CurrentE K 1,
    p2CurrentF K 0, p2CurrentF K 1,
    p2CurrentU K 0, p2CurrentU K 1,
    p2CurrentV K 0, p2CurrentV K 1}

/-- The Lie algebra generated by the two depth-two plane-chart radicals. -/
def p2DepthTwoCurrentLie :
    LieSubalgebra K (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (p2DepthTwoCurrentGenerators K)

/-- The current modes annihilating a vector form a Lie subalgebra. -/
def p2CurrentPointStabilizer
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    (v : M) : LieSubalgebra K (Matrix (Fin 3) (Fin 3) (Polynomial K)) where
  carrier := {A | ⁅A, v⁆ = 0}
  zero_mem' := by simp
  add_mem' := by
    intro A B hA hB
    change ⁅A, v⁆ = 0 at hA
    change ⁅B, v⁆ = 0 at hB
    change ⁅A + B, v⁆ = 0
    simp [hA, hB]
  smul_mem' := by
    intro c A hA
    change ⁅A, v⁆ = 0 at hA
    change ⁅c • A, v⁆ = 0
    simp [hA]
  lie_mem' := by
    intro A B hA hB
    change ⁅A, v⁆ = 0 at hA
    change ⁅B, v⁆ = 0 at hB
    change ⁅⁅A, B⁆, v⁆ = 0
    rw [lie_lie, hA, hB]
    simp

section Generation

variable [CharZero K]

/-- Every upper-root current mode is generated at depth two. -/
theorem p2CurrentE_mem_depthTwoCurrentLie (k : ℕ) :
    p2CurrentE K k ∈ p2DepthTwoCurrentLie K := by
  have hE0 : p2CurrentE K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hF1 : p2CurrentF K 1 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2DepthTwoCurrentLie K := by
    rw [← p2Current_lie_E_F K 0 1]
    exact (p2DepthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hE0
  | succ k ih =>
      have hbr := (p2DepthTwoCurrentLie K).lie_mem hH1 ih
      rw [p2Current_lie_H_E K 1 k] at hbr
      have hs := (p2DepthTwoCurrentLie K).smul_mem ((2 : K)⁻¹) hbr
      simpa [smul_smul, add_comm] using hs

/-- Every lower-root current mode is generated at depth two. -/
theorem p2CurrentF_mem_depthTwoCurrentLie (k : ℕ) :
    p2CurrentF K k ∈ p2DepthTwoCurrentLie K := by
  have hE0 : p2CurrentE K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hF0 : p2CurrentF K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hF1 : p2CurrentF K 1 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2DepthTwoCurrentLie K := by
    rw [← p2Current_lie_E_F K 0 1]
    exact (p2DepthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hF0
  | succ k ih =>
      have hbr := (p2DepthTwoCurrentLie K).lie_mem hH1 ih
      rw [p2Current_lie_H_F K 1 k] at hbr
      have hs := (p2DepthTwoCurrentLie K).smul_mem ((-(2 : K))⁻¹) hbr
      simpa [smul_smul, add_comm] using hs

omit [CharZero K] in
/-- Every first affine-shear current mode is generated at depth two. -/
theorem p2CurrentU_mem_depthTwoCurrentLie (k : ℕ) :
    p2CurrentU K k ∈ p2DepthTwoCurrentLie K := by
  have hU0 : p2CurrentU K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hE0 : p2CurrentE K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hF1 : p2CurrentF K 1 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2DepthTwoCurrentLie K := by
    rw [← p2Current_lie_E_F K 0 1]
    exact (p2DepthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hU0
  | succ k ih =>
      have hbr := (p2DepthTwoCurrentLie K).lie_mem hH1 ih
      rw [p2Current_lie_H_U K 1 k] at hbr
      simpa [add_comm] using (p2DepthTwoCurrentLie K).neg_mem hbr

omit [CharZero K] in
/-- Every second affine-shear current mode is generated at depth two. -/
theorem p2CurrentV_mem_depthTwoCurrentLie (k : ℕ) :
    p2CurrentV K k ∈ p2DepthTwoCurrentLie K := by
  have hV0 : p2CurrentV K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hE0 : p2CurrentE K 0 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hF1 : p2CurrentF K 1 ∈ p2DepthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2DepthTwoCurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2DepthTwoCurrentLie K := by
    rw [← p2Current_lie_E_F K 0 1]
    exact (p2DepthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hV0
  | succ k ih =>
      have hbr := (p2DepthTwoCurrentLie K).lie_mem hH1 ih
      rwa [p2Current_lie_H_V K 1 k, add_comm] at hbr

/-- Every diagonal current mode is generated at depth two. -/
theorem p2CurrentH_mem_depthTwoCurrentLie (k : ℕ) :
    p2CurrentH K k ∈ p2DepthTwoCurrentLie K := by
  have hbr := (p2DepthTwoCurrentLie K).lie_mem
    (p2CurrentE_mem_depthTwoCurrentLie K 0)
    (p2CurrentF_mem_depthTwoCurrentLie K k)
  rw [p2Current_lie_E_F K 0 k] at hbr
  simpa using hbr

/-- **Plane depth-two current generation.** The two chart radicals generate every polynomial
mode of `sl₂ ⋉ (K²)ᵛ`. -/
theorem p2DepthTwoCurrentLie_contains_all_modes (k : ℕ) :
    p2CurrentE K k ∈ p2DepthTwoCurrentLie K ∧
    p2CurrentF K k ∈ p2DepthTwoCurrentLie K ∧
    p2CurrentU K k ∈ p2DepthTwoCurrentLie K ∧
    p2CurrentV K k ∈ p2DepthTwoCurrentLie K ∧
    p2CurrentH K k ∈ p2DepthTwoCurrentLie K :=
  ⟨p2CurrentE_mem_depthTwoCurrentLie K k,
    p2CurrentF_mem_depthTwoCurrentLie K k,
    p2CurrentU_mem_depthTwoCurrentLie K k,
    p2CurrentV_mem_depthTwoCurrentLie K k,
    p2CurrentH_mem_depthTwoCurrentLie K k⟩

/-- In any representation, annihilation by the eight depth-two plane-chart modes propagates to
every polynomial mode of the generated affine-parabolic current algebra. -/
theorem p2DepthTwoCurrent_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅p2CurrentE K 0, v⁆ = 0) (hE1 : ⁅p2CurrentE K 1, v⁆ = 0)
    (hF0 : ⁅p2CurrentF K 0, v⁆ = 0) (hF1 : ⁅p2CurrentF K 1, v⁆ = 0)
    (hU0 : ⁅p2CurrentU K 0, v⁆ = 0) (hU1 : ⁅p2CurrentU K 1, v⁆ = 0)
    (hV0 : ⁅p2CurrentV K 0, v⁆ = 0) (hV1 : ⁅p2CurrentV K 1, v⁆ = 0)
    (k : ℕ) :
    ⁅p2CurrentE K k, v⁆ = 0 ∧ ⁅p2CurrentF K k, v⁆ = 0 ∧
    ⁅p2CurrentU K k, v⁆ = 0 ∧ ⁅p2CurrentV K k, v⁆ = 0 ∧
    ⁅p2CurrentH K k, v⁆ = 0 := by
  have hgen : p2DepthTwoCurrentGenerators K ⊆
      (p2CurrentPointStabilizer (K := K) v : Set _) := by
    intro A hA
    simp only [p2DepthTwoCurrentGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact hE0
    · exact hE1
    · exact hF0
    · exact hF1
    · exact hU0
    · exact hU1
    · exact hV0
    · exact hV1
  have hle : p2DepthTwoCurrentLie K ≤ p2CurrentPointStabilizer (K := K) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  exact ⟨hle (p2CurrentE_mem_depthTwoCurrentLie K k),
    hle (p2CurrentF_mem_depthTwoCurrentLie K k),
    hle (p2CurrentU_mem_depthTwoCurrentLie K k),
    hle (p2CurrentV_mem_depthTwoCurrentLie K k),
    hle (p2CurrentH_mem_depthTwoCurrentLie K k)⟩

end Generation

end

end GaloisForLFunctions
