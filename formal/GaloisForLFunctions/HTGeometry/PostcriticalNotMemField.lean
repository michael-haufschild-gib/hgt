import GaloisForLFunctions.HTGeometry.PostcriticalEscapeUnconditional
import GaloisForLFunctions.HTGeometry.MultiGeneratorDescent

/-!
# The postcritical coefficient is outside the critical field

The rational-function statement, transported into the field of the generic jet: the first
postcritical reciprocal coefficient does not lie in the subfield generated by the critical
observation and the new raw coefficient.

Membership in that subfield would exhibit the coefficient as a fraction of two elements of the
algebra the observation generates, hence as a polynomial fraction in the observation — which the
deformation argument excludes.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable (K : Type*) [Field K] (N : ℕ)

instance isDomain_genericJetAlgebra : IsDomain (genericJetAlgebra K N) :=
  IsLocalization.isDomain_of_le_nonZeroDivisors _
    (powers_le_nonZeroDivisors_of_noZeroDivisors
      (MvPolynomial.X_ne_zero (R := K) (0 : Fin (N + 1))))

/-- The field of the generic jet. -/
abbrev genericJetField : Type _ := FractionRing (genericJetAlgebra K N)

/-- The generic jet algebra as a subalgebra of its field. -/
noncomputable abbrev genericJetSubalgebra : Subalgebra K (genericJetField K N) :=
  (IsScalarTower.toAlgHom K (genericJetAlgebra K N) (genericJetField K N)).range

noncomputable def genericJetEquiv : genericJetAlgebra K N ≃ₐ[K] genericJetSubalgebra K N :=
  AlgEquiv.ofInjective _ (IsFractionRing.injective (genericJetAlgebra K N) (genericJetField K N))

variable {K N}

theorem genericJetEquiv_injective : Function.Injective (genericJetEquiv K N) :=
  (genericJetEquiv K N).injective

/-- **The postcritical reciprocal coefficient is not in the critical field.**  For the generic jet
of horizon `L = m + n`, the first postcritical reciprocal coefficient does not lie in the subfield
generated by the critical observation together with the new raw coefficient. -/
theorem postcritical_notMem_criticalField (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    ((genericJetEquiv K (m + n) (genericRecip K (m + n) (m + n)) :
        genericJetSubalgebra K (m + n)) : genericJetField K (m + n))
      ∉ IntermediateField.adjoin K
        (((↑) '' (Set.range (fun s => genericJetEquiv K (m + n) (genericObservation K m n s))) :
          Set (genericJetField K (m + n)))) := by
  classical
  intro hmem
  obtain ⟨a, b, ha, hb, hab⟩ :=
    exists_frac_of_mem_adjoin (genericJetSubalgebra K (m + n)) hmem
  -- the two members of the generated algebra are polynomial expressions in the observation
  have hrange : ∀ {c : genericJetSubalgebra K (m + n)},
      c ∈ Algebra.adjoin K
        (Set.range (fun s => genericJetEquiv K (m + n) (genericObservation K m n s))) →
      ∃ R : MvPolynomial (Fin (n + 1) ⊕ Fin m) K,
        c = genericJetEquiv K (m + n) (MvPolynomial.aeval (genericObservation K m n) R) := by
    intro c hc
    rw [Algebra.adjoin_range_eq_range_aeval] at hc
    obtain ⟨R, hR⟩ := hc
    exact ⟨R, by
      rw [← hR]
      exact (MvPolynomial.comp_aeval_apply (genericObservation K m n)
        (genericJetEquiv K (m + n)).toAlgHom R).symm⟩
  obtain ⟨P, hP⟩ := hrange ha
  obtain ⟨Q, hQ⟩ := hrange hb
  by_cases hb0 : b = 0
  · -- a vanishing denominator forces the coefficient itself to vanish
    rw [hb0, ZeroMemClass.coe_zero, div_zero] at hab
    have hsub : genericJetEquiv K (m + n) (genericRecip K (m + n) (m + n)) = 0 :=
      Subtype.ext (by rw [ZeroMemClass.coe_zero]; exact hab.symm)
    have hv0 : genericRecip K (m + n) (m + n) = 0 := by
      have hc := congrArg (genericJetEquiv K (m + n)).symm hsub
      simpa using hc
    exact postcritical_escapes_criticalField K hm hn 0 1 one_ne_zero
      (by rw [map_one, mul_one, hv0, map_zero])
  · have hQ0 : Q ≠ 0 := by
      intro hcon
      refine hb0 ?_
      rw [hQ, hcon, map_zero, map_zero]
    have hbne : ((b : genericJetSubalgebra K (m + n)) : genericJetField K (m + n)) ≠ 0 := by
      intro hcon
      exact hb0 (Subtype.ext hcon)
    have hmul : genericJetEquiv K (m + n) (genericRecip K (m + n) (m + n)) * b = a := by
      refine Subtype.ext ?_
      rw [Subalgebra.coe_mul, ← hab, div_mul_cancel₀ _ hbne]
    rw [hP, hQ, ← map_mul] at hmul
    exact postcritical_escapes_criticalField K hm hn P Q hQ0
      ((genericJetEquiv K (m + n)).injective hmul)

end GaloisForLFunctions.HTGeometry
