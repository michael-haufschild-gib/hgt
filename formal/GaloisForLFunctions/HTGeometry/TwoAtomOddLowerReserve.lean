/-- The lifted polynomial is exactly the determinant reserve times its positive denominator. -/
theorem twoAtomLowerLiftedReserve_eq (q z : ℝ) :
    twoAtomLowerLiftedReserve q (twoAtomLowerEnvelope q*z) =
      twoAtomLowerEnvelope q^(6 : ℕ)*(twoAtomOddDetNumerator q z-15000000000*(q^(3 : ℕ)*(2*q-3)^(6 : ℕ))) := by
  unfold twoAtomLowerLiftedReserve twoAtomOddDetNumerator
  ring

/-- The complete retained determinant has a fifteen-billion reserve throughout the lower middle regime. -/
theorem twoAtomOddDet_lower_middle {q z : ℝ} (hq0 : 37/10 ≤ q) (hq1 : q ≤ 5)
    (hz0 : 0 ≤ z) (hz1 : twoAtomLowerEnvelope q*z ≤ 1) :
    15000000000 ≤ twoAtomOddDet q z := by
  have hqp : 0 < q := by linarith
  have hdp : 0 < 2*q-3 := by linarith
  have henv : 0 < twoAtomLowerEnvelope q := by
    unfold twoAtomLowerEnvelope
    have : 0 ≤ q-37/10 := by linarith
    positivity
  have h := twoAtomLowerLiftedReserve_nonneg hq0 hq1 (mul_nonneg henv.le hz0) hz1
  rw [twoAtomLowerLiftedReserve_eq] at h
  have hr := (mul_nonneg_iff_of_pos_left (pow_pos henv 6)).mp h
  rw [twoAtomOddDet_eq_quotient hqp.ne' hdp.ne']
  apply (le_div_iff₀ (by positivity : 0 < q^(3 : ℕ)*(2*q-3)^(6 : ℕ))).mpr
  linarith only [hr]

