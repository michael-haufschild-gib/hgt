import GaloisForLFunctions.HTGeometry.CenteredFullMonodromy
import GaloisForLFunctions.HTGeometry.CenteredFullMonodromyOdd
import GaloisForLFunctions.HTGeometry.CenteredFreeParameter
import GaloisForLFunctions.HTGeometry.SplittingFieldOverRootField

/-!
# The centered equation over the parameter field

The splitting field of the centered polynomial together with the radical is a splitting field of the
centered polynomial alone over the root field of the radical, so the base change statement can be
read there.

Adjoining a free parameter to that base leaves the Galois group unchanged, so over the coefficient
field extended by a radical of the constant coefficient and by one independent transcendental — the
field the rank-one fiber equation is written over — the Galois group is still the full symmetric
group.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped IntermediateField

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 800000

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] {d : ℕ}

/-- Even radical polynomial over the centered coefficient field. -/
noncomputable abbrev centeredEvenRadicalPolynomial
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (m : ℕ) :
    Polynomial (centeredCoeffField K d) :=
  Polynomial.X ^ (2 * m) -
    Polynomial.C (centeredConstant K d (by omega))

/-- Composite splitting field for the centered polynomial and the even radical. -/
abbrev centeredEvenRadicalSplittingField
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (m : ℕ) :=
  (centeredMonicE K d * centeredEvenRadicalPolynomial K d hd m).SplittingField

/-- Root-field base generated by the even radical inside the composite splitting field. -/
noncomputable abbrev centeredEvenRadicalRootField
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (m : ℕ) :=
  rootField (centeredCoeffField K d)
    (L := centeredEvenRadicalSplittingField K d hd m)
    (centeredEvenRadicalPolynomial K d hd m)

/-- Odd radical polynomial over the centered coefficient field. -/
noncomputable abbrev centeredOddRadicalPolynomial
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (n : ℕ) :
    Polynomial (centeredCoeffField K d) :=
  Polynomial.X ^ n - Polynomial.C (centeredConstant K d (by omega))

/-- Composite splitting field for the centered polynomial and the odd radical. -/
abbrev centeredOddRadicalSplittingField
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (n : ℕ) :=
  (centeredMonicE K d * centeredOddRadicalPolynomial K d hd n).SplittingField

/-- Root-field base generated by the odd radical inside the composite splitting field. -/
noncomputable abbrev centeredOddRadicalRootField
    (K : Type*) [Field K] [CharZero K] (d : ℕ) (hd : 3 ≤ d) (n : ℕ) :=
  rootField (centeredCoeffField K d)
    (L := centeredOddRadicalSplittingField K d hd n)
    (centeredOddRadicalPolynomial K d hd n)

/-- **Full symmetric monodromy over the parameter field, at an even exponent.** -/
noncomputable def centeredParameterMonodromy (hd : 3 ≤ d) {m : ℕ} (hm : 0 < m) :
    (FractionRing (Polynomial (centeredEvenRadicalSplittingField K d hd m)) ≃ₐ[
        fracSub (centeredEvenRadicalRootField K d hd m)
          (centeredEvenRadicalSplittingField K d hd m)]
      FractionRing (Polynomial (centeredEvenRadicalSplittingField K d hd m))) ≃*
      Equiv.Perm (Fin d) := by
  have hq : centeredEvenRadicalPolynomial K d hd m ≠ 0 :=
    (Polynomial.monic_X_pow_sub_C
      (centeredConstant K d (show 0 < d by omega))
        (Nat.mul_ne_zero (by norm_num) hm.ne')).ne_zero
  haveI := isSplittingField_over_rootField
    (L := centeredEvenRadicalSplittingField K d hd m)
    centeredMonicE_ne_zero hq
  exact freeParameterPermEquiv
    (F := centeredEvenRadicalRootField K d hd m)
    (E := centeredEvenRadicalSplittingField K d hd m)
    (p := (centeredMonicE K d).map
      (algebraMap (centeredCoeffField K d)
        (centeredEvenRadicalRootField K d hd m)))
    (map_rootField_ne_zero
      (L := centeredEvenRadicalSplittingField K d hd m)
      centeredMonicE_ne_zero (centeredEvenRadicalPolynomial K d hd m))
    (separable_map_rootField
      (L := centeredEvenRadicalSplittingField K d hd m)
      separable_centeredMonicE (centeredEvenRadicalPolynomial K d hd m))
    (Polynomial.IsSplittingField.splits'
      (K := centeredEvenRadicalRootField K d hd m)
      (L := centeredEvenRadicalSplittingField K d hd m)
      (f := (centeredMonicE K d).map
        (algebraMap (centeredCoeffField K d)
          (centeredEvenRadicalRootField K d hd m))))
    (adjoin_rootSet_eq_top _)
    (centeredFullMonodromy hd hm)

/-- **Full symmetric monodromy over the parameter field, at an odd exponent.** -/
noncomputable def centeredParameterMonodromyOdd (hd : 3 ≤ d) {n : ℕ} (hn : 0 < n) (hodd : ¬ 2 ∣ n) :
    (FractionRing (Polynomial (centeredOddRadicalSplittingField K d hd n)) ≃ₐ[
        fracSub (centeredOddRadicalRootField K d hd n)
          (centeredOddRadicalSplittingField K d hd n)]
      FractionRing (Polynomial (centeredOddRadicalSplittingField K d hd n))) ≃*
      Equiv.Perm (Fin d) := by
  have hq : centeredOddRadicalPolynomial K d hd n ≠ 0 :=
    (Polynomial.monic_X_pow_sub_C
      (centeredConstant K d (show 0 < d by omega)) hn.ne').ne_zero
  haveI := isSplittingField_over_rootField
    (L := centeredOddRadicalSplittingField K d hd n)
    centeredMonicE_ne_zero hq
  exact freeParameterPermEquiv
    (F := centeredOddRadicalRootField K d hd n)
    (E := centeredOddRadicalSplittingField K d hd n)
    (p := (centeredMonicE K d).map
      (algebraMap (centeredCoeffField K d)
        (centeredOddRadicalRootField K d hd n)))
    (map_rootField_ne_zero
      (L := centeredOddRadicalSplittingField K d hd n)
      centeredMonicE_ne_zero (centeredOddRadicalPolynomial K d hd n))
    (separable_map_rootField
      (L := centeredOddRadicalSplittingField K d hd n)
      separable_centeredMonicE (centeredOddRadicalPolynomial K d hd n))
    (Polynomial.IsSplittingField.splits'
      (K := centeredOddRadicalRootField K d hd n)
      (L := centeredOddRadicalSplittingField K d hd n)
      (f := (centeredMonicE K d).map
        (algebraMap (centeredCoeffField K d)
          (centeredOddRadicalRootField K d hd n))))
    (adjoin_rootSet_eq_top _)
    (centeredFullMonodromyOdd hd hn hodd)

end GaloisForLFunctions.HTGeometry
