import GaloisForLFunctions.HTGeometry.MatrixPrincipalSymbolAncestralConservation

/-!
# An invertible linear change of coordinates generates the same algebra

Algebraic independence is already known to be invariant under an invertible square linear
transformation.  The underlying reason is stronger and is recorded here: the transformed family
generates *the same* subalgebra, and the same intermediate field, as the original one.

This is the coordinate-transfer step of a spectral argument.  When a state is read in an algebraic
eigenbasis, its computational coordinates are an invertible algebraic linear image of the spectral
ones, so every transcendence-theoretic invariant of the coordinates — not only full algebraic
independence — is the same on both sides.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- Each transformed coordinate lies in the algebra generated by the original ones. -/
theorem adjoin_matrixLinearForms_le {τ : Type*} [Fintype τ] (M : Matrix τ τ K) (x : τ → L) :
    Algebra.adjoin K (Set.range (matrixLinearForms M x))
      ≤ Algebra.adjoin K (Set.range x) := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨i, rfl⟩
  refine Subalgebra.sum_mem _ fun j _ => ?_
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
    (Algebra.subset_adjoin ⟨j, rfl⟩)

/-- **An invertible linear change of coordinates generates the same algebra.** -/
theorem adjoin_matrixLinearForms_eq_of_det_ne_zero {τ : Type*} [Fintype τ] [DecidableEq τ]
    (M : Matrix τ τ K) (x : τ → L) (hdet : M.det ≠ 0) :
    Algebra.adjoin K (Set.range (matrixLinearForms M x))
      = Algebra.adjoin K (Set.range x) := by
  have hunit : IsUnit M.det := isUnit_iff_ne_zero.mpr hdet
  refine le_antisymm (adjoin_matrixLinearForms_le M x) ?_
  have hback := adjoin_matrixLinearForms_le M⁻¹ (matrixLinearForms M x)
  rwa [matrixPrincipalLinearForms_mul, Matrix.nonsing_inv_mul M hunit,
    matrixPrincipalLinearForms_one] at hback

/-- The same statement for the generated intermediate field. -/
theorem adjoin_field_matrixLinearForms_eq_of_det_ne_zero {τ : Type*} [Fintype τ] [DecidableEq τ]
    (M : Matrix τ τ K) (x : τ → L) (hdet : M.det ≠ 0) :
    IntermediateField.adjoin K (Set.range (matrixLinearForms M x))
      = IntermediateField.adjoin K (Set.range x) := by
  have hunit : IsUnit M.det := isUnit_iff_ne_zero.mpr hdet
  have hle : ∀ (N : Matrix τ τ K) (y : τ → L),
      IntermediateField.adjoin K (Set.range (matrixLinearForms N y))
        ≤ IntermediateField.adjoin K (Set.range y) := by
    intro N y
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ ⟨i, rfl⟩
    refine Subalgebra.sum_mem _ fun j _ => ?_
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (IntermediateField.subset_adjoin K _ ⟨j, rfl⟩)
  refine le_antisymm (hle M x) ?_
  have hback := hle M⁻¹ (matrixLinearForms M x)
  rwa [matrixPrincipalLinearForms_mul, Matrix.nonsing_inv_mul M hunit,
    matrixPrincipalLinearForms_one] at hback

end

end GaloisForLFunctions.HTGeometry
