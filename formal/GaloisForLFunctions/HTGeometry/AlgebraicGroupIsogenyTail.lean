import GaloisForLFunctions.HTGeometry.AlgebraicGroupInvariantDerivations
import GaloisForLFunctions.HTGeometry.IsogenyFunctionFieldLevel
import GaloisForLFunctions.HTGeometry.MaurerCartanFixedFields

/-!
# Isogeny tails of algebraic groups: the deck-closure and position–velocity theorems

Let `C` be an algebraically closed field of characteristic zero, `G` an integral commutative
algebraic group over `C` with function field `F`, and `α : G → G` an isogeny.  Let `K = F(y_(i,k))`
be the differential function field of the infinite jet space of `G`, built on a transcendence
basis `t` of `F`, with its derivation `δ`; translations `σ_x` and the pullback `α*` extend
uniquely to differential endomorphisms of `K`.

* `Γ_n = ker(α^n)(C)`, and `H(C)` is the set of rational points of the Zariski closure `H` of
  `⋃_n Γ_n`.
* The **Maurer–Cartan velocity** `ℓ = (ℓ_1, …, ℓ_d)` is the coordinate vector of `δ|_F` in a basis
  `D_1, …, D_d` of translation-invariant derivations of `F`: `δ a = Σ_i ℓ_i D_i a`.

**Theorem A (deck closure).**  `⋂_n α^(n*) K = K^(H(C))`.

**Theorem B (position–velocity).**  `K^(H(C))` is the differential field generated by the
positions `F^(H(C))` and the velocity `ℓ`, and `α*` restricts to an automorphism of
`F^(H(C))`.
-/

open CategoryTheory Limits AlgebraicGeometry Opposite
open MonoidalCategory CartesianMonoidalCategory MonObj
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C : Type u} [Field C] (G : Over (Spec (.of C))) [IsIntegral G.left]
  [LocallyOfFiniteType G.hom]

/-! ### The jet field of `G` -/

/-- The dimension `d = trdeg_C C(G)`. -/
def groupDim : ℕ := (exists_fin_isTranscendenceBasis G).choose

/-- A transcendence basis `t` of `C(G)`. -/
def groupBasis : Fin (groupDim G) → G.left.functionField :=
  (exists_fin_isTranscendenceBasis G).choose_spec.choose

theorem groupBasis_isTranscendenceBasis : IsTranscendenceBasis C (groupBasis G) :=
  (exists_fin_isTranscendenceBasis G).choose_spec.choose_spec

/-- The differential function field `K = C(J^∞ G)` of the infinite jet space. -/
abbrev GroupJetField := FunctionJetField G.left.functionField (groupDim G)

variable [CharZero C]

/-- The derivation `δ` of `K`. -/
abbrev groupJetDerivation : Derivation C (GroupJetField G) (GroupJetField G) :=
  jetFieldDerivation (groupBasis_isTranscendenceBasis G)

variable [GrpObj G]

/-- Translation by a rational point, on the jet field. -/
def jetTranslation (x : 𝟙_ (Over (Spec (.of C))) ⟶ G) : GroupJetField G →+* GroupJetField G :=
  jetFieldExtension (groupBasis_isTranscendenceBasis G) (translationAlgEquiv G x).toAlgHom

/-! ### The isogeny and its iterated kernels -/

section Isogeny

/-- Pullback by the isogeny, on the jet field. -/
def jetIsogenyPullback (α : G ⟶ G) [IsIsogeny G α] : GroupJetField G →+* GroupJetField G :=
  jetFieldExtension (groupBasis_isTranscendenceBasis G) (overFunctionFieldPullback G α)

/-- The rational points `Γ_n = ker(α^n)(C)`. -/
def isogenyKernelPoints (α : G ⟶ G) (n : ℕ) : Set (𝟙_ (Over (Spec (.of C))) ⟶ G) :=
  {c | c ≫ isogenyPow α n = 1}

/-- The rational points `H(C)` of the Zariski closure `H` of `⋃_n Γ_n`. -/
def deckClosurePoints (α : G ⟶ G) : Set (𝟙_ (Over (Spec (.of C))) ⟶ G) :=
  {x | rationalPointHom G x default ∈
    closure (⋃ n, (fun c => rationalPointHom G c default) '' isogenyKernelPoints G α n)}

omit [IsIntegral G.left] [LocallyOfFiniteType G.hom] [CharZero C] in
theorem isogenyKernelPoints_subset_deckClosurePoints (α : G ⟶ G) (n : ℕ) :
    isogenyKernelPoints G α n ⊆ deckClosurePoints G α := fun c hc =>
  subset_closure (Set.mem_iUnion.mpr ⟨n, c, hc, rfl⟩)

omit [IsIntegral G.left] [LocallyOfFiniteType G.hom] [CharZero C] in
/-- Translations and the isogeny: `τ_x ≫ α = α ≫ τ_(xα)`. -/
theorem mulRight_hom_comp_isogeny (α : G ⟶ G) [IsIsogeny G α] (x : 𝟙_ (Over (Spec (.of C))) ⟶ G) :
    (GrpObj.mulRight x).hom ≫ α = α ≫ (GrpObj.mulRight (x ≫ α)).hom := by
  haveI := IsIsogeny.toIsMonHom (G := G) (α := α)
  rw [← Category.id_comp ((GrpObj.mulRight x).hom), comp_mulRight_hom_eq_mul, MonObj.mul_comp,
    Category.id_comp, comp_mulRight_hom_eq_mul, Category.assoc]

omit [LocallyOfFiniteType G.hom] [CharZero C] in
/-- **`α* ∘ σ_(xα) = σ_x ∘ α*`.** -/
theorem overFunctionFieldPullback_translation (α : G ⟶ G) [IsIsogeny G α] (x : 𝟙_ (Over (Spec (.of C))) ⟶ G)
    (f : G.left.functionField) :
    overFunctionFieldPullback G α (translationAlgEquiv G (x ≫ α) f) =
      translationAlgEquiv G x (overFunctionFieldPullback G α f) := by
  simp only [translationAlgEquiv_apply, overFunctionFieldPullback_apply]
  have h := Scheme.Hom.functionFieldPullback_congr ((GrpObj.mulRight x).hom.left ≫ α.left)
    (α.left ≫ (GrpObj.mulRight (x ≫ α)).hom.left)
    (congrArg CommaMorphism.left (mulRight_hom_comp_isogeny G α x))
  rw [Scheme.Hom.functionFieldPullback_comp, Scheme.Hom.functionFieldPullback_comp] at h
  exact (congrArg (fun q : G.left.functionField ⟶ G.left.functionField => q f) h).symm

end Isogeny

/-! ### Maurer–Cartan coordinates -/

variable [IsAlgClosed C] [IsCommMonObj G]

/-- A basis `D_1, …, D_d` of translation-invariant derivations of `C(G)`. -/
def mcDerivation : Fin (groupDim G) → Derivation C G.left.functionField G.left.functionField :=
  (exists_translationInvariant_derivationMatrix_det_ne_zero G
    (groupBasis_isTranscendenceBasis G)).choose

omit [IsAlgClosed C] in
theorem mcDerivation_invariant (i : Fin (groupDim G)) : IsTranslationInvariant G (mcDerivation G i) :=
  (exists_translationInvariant_derivationMatrix_det_ne_zero G
    (groupBasis_isTranscendenceBasis G)).choose_spec.1 i

omit [IsAlgClosed C] in
theorem mcDerivation_det_ne_zero : (derivationMatrix (mcDerivation G) (groupBasis G)).det ≠ 0 :=
  (exists_translationInvariant_derivationMatrix_det_ne_zero G
    (groupBasis_isTranscendenceBasis G)).choose_spec.2

/-- **The Maurer–Cartan velocity** `ℓ`: `δ a = Σ_i ℓ_i D_i a` for `a ∈ C(G)`. -/
def mcVelocity : Fin (groupDim G) → GroupJetField G :=
  maurerCartan (mcDerivation G) (groupBasis G)

omit [IsAlgClosed C] in
theorem groupJetDerivation_eq_sum_mcVelocity (a : G.left.functionField) :
    groupJetDerivation G (algebraMap _ (GroupJetField G) a) =
      ∑ i, mcVelocity G i * algebraMap _ (GroupJetField G) (mcDerivation G i a) :=
  jetFieldDerivation_eq_sum_maurerCartan _ (mcDerivation_det_ne_zero G) a

variable (α : G ⟶ G) [IsIsogeny G α]

omit [CharZero C] [IsIsogeny G α] in
/-- **The closure step.**  A rational function fixed by every iterated kernel is fixed by the
rational points of their Zariski closure, because its stabilizer is Zariski closed. -/
theorem fixed_isogenyKernelPoints_iff (a : G.left.functionField) :
    (∀ n, ∀ c ∈ isogenyKernelPoints G α n, translationAlgEquiv G c a = a) ↔
      ∀ x ∈ deckClosurePoints G α, translationAlgEquiv G x a = a := by
  constructor
  · intro h x hx
    obtain ⟨Z, hZ, hZa⟩ := exists_isClosed_translation_stabilizer G a
    have hsub : (⋃ n, (fun c => rationalPointHom G c default) '' isogenyKernelPoints G α n) ⊆ Z := by
      rintro _ ⟨_, ⟨n, rfl⟩, c, hc, rfl⟩
      exact (hZa c).mp (h n c hc)
    exact (hZa x).mpr (closure_minimal hsub hZ hx)
  · intro h n c hc
    exact h c (isogenyKernelPoints_subset_deckClosurePoints G α n hc)

/-- The chain-rule matrix of `α*` against the invariant derivations is a constant matrix. -/
theorem exists_const_mcDerivation_pullback :
    ∃ c : Matrix (Fin (groupDim G)) (Fin (groupDim G)) C,
      derivationPullbackMatrix (mcDerivation G) (groupBasis G) (overFunctionFieldPullback G α) =
        c.map (algebraMap C G.left.functionField) :=
  exists_const_derivationPullbackMatrix (groupBasis_isTranscendenceBasis G)
    (mcDerivation_det_ne_zero G) (translationAlgEquiv G) (fun x => x ≫ α)
    (fun x i f => mcDerivation_invariant G i x f) (overFunctionFieldPullback G α)
    (fun x f => overFunctionFieldPullback_translation G α x f)
    (mem_range_algebraMap_of_translation_fixed G)

/-- The constant matrix `dα` of the isogeny on the Maurer–Cartan velocity. -/
def isogenyTangentMatrix : Matrix (Fin (groupDim G)) (Fin (groupDim G)) C :=
  (exists_const_mcDerivation_pullback G α).choose

theorem isogenyTangentMatrix_spec :
    derivationPullbackMatrix (mcDerivation G) (groupBasis G) (overFunctionFieldPullback G α) =
      (isogenyTangentMatrix G α).map (algebraMap C G.left.functionField) :=
  (exists_const_mcDerivation_pullback G α).choose_spec

theorem mcDerivation_pullback (i : Fin (groupDim G)) (f : G.left.functionField) :
    mcDerivation G i (overFunctionFieldPullback G α f) =
      ∑ j, algebraMap C _ (isogenyTangentMatrix G α i j) *
        overFunctionFieldPullback G α (mcDerivation G j f) := by
  rw [derivation_comp_eq_sum (groupBasis_isTranscendenceBasis G) (mcDerivation_det_ne_zero G),
    isogenyTangentMatrix_spec]
  rfl

theorem isogenyTangentMatrix_det_ne_zero : (isogenyTangentMatrix G α).det ≠ 0 := by
  intro h0
  apply derivationPullbackMatrix_det_ne_zero (groupBasis_isTranscendenceBasis G)
    (mcDerivation_det_ne_zero G) (overFunctionFieldPullback G α)
  rw [isogenyTangentMatrix_spec, ← RingHom.mapMatrix_apply, ← RingHom.map_det, h0, map_zero]

/-- **The velocity transforms by `dα`**: `α* ℓ_j = Σ_i (dα)_ij ℓ_i`. -/
theorem jetIsogenyPullback_mcVelocity (j : Fin (groupDim G)) :
    jetIsogenyPullback G α (mcVelocity G j) =
      ∑ i, algebraMap C (GroupJetField G) (isogenyTangentMatrix G α i j) * mcVelocity G i := by
  have h := jetFieldExtension_maurerCartanJet (groupBasis_isTranscendenceBasis G)
    (mcDerivation_det_ne_zero G) (overFunctionFieldPullback G α) (isogenyTangentMatrix G α)
    (mcDerivation_pullback G α) 0 j
  simp only [maurerCartanJet, Function.iterate_zero, id_eq] at h
  exact h

/-! ### Theorem A -/

/-- **Theorem A (deck closure).**  The elements of the jet field lying in every image
`α^(n*) K` are exactly those fixed by the translations by the rational points of the Zariski
closure of all iterated kernels: `⋂_n α^(n*) K = K^(H(C))`. -/
theorem mem_isogenyTail_iff_deckClosure_fixed (u : GroupJetField G) :
    (∀ n, u ∈ Set.range ((⇑(jetIsogenyPullback G α))^[n])) ↔
      ∀ x ∈ deckClosurePoints G α, jetTranslation G x u = u :=
  mem_tail_iff_fixed (groupBasis_isTranscendenceBasis G) (mcDerivation_det_ne_zero G)
    (translationAlgEquiv G) (fun x i f => mcDerivation_invariant G i x f)
    (overFunctionFieldPullback G α) (isogenyTangentMatrix G α) (mcDerivation_pullback G α)
    (isogenyTangentMatrix_det_ne_zero G α) (isogenyKernelPoints G α) (deckClosurePoints G α)
    (fun n a => mem_range_isogenyPullback_pow_iff G α n a)
    (fixed_isogenyKernelPoints_iff G α) u

end

end GaloisForLFunctions.HTGeometry
