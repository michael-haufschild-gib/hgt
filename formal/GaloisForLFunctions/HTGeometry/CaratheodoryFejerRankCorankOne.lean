import GaloisForLFunctions.HTGeometry.CaratheodoryFejerPSDtoAtomicFactorization
import Mathlib.LinearAlgebra.Matrix.Rank

/-!
# Rank-sharp finite Carathéodory--Fejér root theorem

This is the finite corank-one conclusion used in Corollary 1.1 of
Connes--van Suijlekom.  Starting from the same-level positive semidefinite
Toeplitz factorization, it does not assume a rank-sized atomic support.

The active atoms are the distinct nodes carrying positive weight.  The row
span of the Vandermonde factor is contained in the span of their Vandermonde
rows.  Hence rank `N` forces at least `N` active distinct nodes.  Every such
node is a root of the kernel polynomial, whose degree is at most `N`; the
roots are consequently exactly the active nodes and lie on the unit circle.
-/

open scoped BigOperators ComplexOrder
open Matrix

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Distinct atoms that carry positive mass in a finite atomic
Carathéodory--Fejér factorization. -/
def caratheodoryFejerActiveNodeSet {r : ℕ} (node : Fin r → ℂ) (weight : Fin r → ℝ) :
    Finset ℂ :=
  (Finset.univ.filter fun i => 0 < weight i).image node

/-- The Vandermonde row attached to one candidate circle atom. -/
def caratheodoryFejerVandermondeRow {n : ℕ} (z : ℂ) : Fin (n + 1) → ℂ :=
  fun j => z ^ (j : ℕ)

/-- Each row of the square-root weighted Vandermonde factor belongs to the
span generated by its distinct positive-mass atom rows. -/
theorem caratheodoryFejerAtomicFactor_row_mem_span_active
    {n r : ℕ} (node : Fin r → ℂ) (weight : Fin r → ℝ)
    (hweight : ∀ i, 0 ≤ weight i) (i : Fin r) :
    (caratheodoryFejerAtomicFactor (n := n) node weight).row i ∈
      Submodule.span ℂ
        ((caratheodoryFejerActiveNodeSet node weight).image
          (caratheodoryFejerVandermondeRow (n := n)) : Set (Fin (n + 1) → ℂ)) := by
  have hrow : (caratheodoryFejerAtomicFactor (n := n) node weight).row i =
      (Real.sqrt (weight i) : ℂ) • caratheodoryFejerVandermondeRow (n := n) (node i) := by
    rfl
  by_cases hi : 0 < weight i
  · rw [hrow]
    apply Submodule.smul_mem
    apply Submodule.subset_span
    refine Finset.mem_image.mpr ⟨node i, ?_, rfl⟩
    exact Finset.mem_image.mpr ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩, rfl⟩
  · have hzero : weight i = 0 := le_antisymm (not_lt.mp hi) (hweight i)
    rw [hrow, hzero]
    simp

/-- Rank of an atomic Vandermonde factor is bounded by the number of its
distinct positive-mass nodes.  This is the support-extraction step absent
from a merely bounded-atom cubature. -/
theorem caratheodoryFejerAtomicFactor_rank_le_activeNodeCard
    {n r : ℕ} (node : Fin r → ℂ) (weight : Fin r → ℝ)
    (hweight : ∀ i, 0 ≤ weight i) :
    (caratheodoryFejerAtomicFactor (n := n) node weight).rank ≤
      (caratheodoryFejerActiveNodeSet node weight).card := by
  let B := caratheodoryFejerAtomicFactor (n := n) node weight
  let S := caratheodoryFejerActiveNodeSet node weight
  let V := caratheodoryFejerVandermondeRow (n := n)
  have hspan : Submodule.span ℂ (Set.range B.row) ≤
      Submodule.span ℂ ((S.image V : Finset (Fin (n + 1) → ℂ)) : Set (Fin (n + 1) → ℂ)) := by
    apply Submodule.span_le.mpr
    rintro x ⟨i, rfl⟩
    exact caratheodoryFejerAtomicFactor_row_mem_span_active node weight hweight i
  calc
    B.rank = Module.finrank ℂ (Submodule.span ℂ (Set.range B.row)) :=
      Matrix.rank_eq_finrank_span_row B
    _ ≤ Module.finrank ℂ
        (Submodule.span ℂ ((S.image V : Finset (Fin (n + 1) → ℂ)) : Set (Fin (n + 1) → ℂ))) :=
      Submodule.finrank_mono hspan
    _ ≤ (S.image V).card := finrank_span_finset_le_card (S.image V)
    _ ≤ S.card := Finset.card_image_le

/-- A kernel of an atomic Gram matrix annihilates any individual atom with
positive weight; zero-weight padding requires no strictness hypothesis on
the other atoms. -/
theorem caratheodoryFejerAtomicGram_kernel_eval_eq_zero_of_pos
    {n r : ℕ} (xi : Fin (n + 1) → ℂ) (node : Fin r → ℂ) (weight : Fin r → ℝ)
    (hker : caratheodoryFejerAtomicGram (n := n) node weight *ᵥ xi = 0)
    (i : Fin r) (hi : 0 < weight i) :
    (finiteToeplitzKernelPolynomial xi).eval (node i) = 0 := by
  let B := caratheodoryFejerAtomicFactor (n := n) node weight
  have hker' : (Bᴴ * B) *ᵥ xi = 0 := by
    simpa [B, caratheodoryFejerAtomicGram] using hker
  have hBzero : B *ᵥ xi = 0 :=
    (Matrix.conjTranspose_mul_self_mulVec_eq_zero B xi).mp hker'
  have hrow := congrFun hBzero i
  change (∑ j : Fin (n + 1),
    ((Real.sqrt (weight i) : ℂ) * node i ^ (j : ℕ)) * xi j) = 0 at hrow
  have hsum : (Real.sqrt (weight i) : ℂ) *
      (∑ j : Fin (n + 1), xi j * node i ^ (j : ℕ)) = 0 := by
    calc
      (Real.sqrt (weight i) : ℂ) *
          (∑ j : Fin (n + 1), xi j * node i ^ (j : ℕ)) =
          ∑ j : Fin (n + 1),
            ((Real.sqrt (weight i) : ℂ) * node i ^ (j : ℕ)) * xi j := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro j _
              ring
      _ = 0 := hrow
  rw [finiteToeplitzKernelPolynomial_eval]
  exact (mul_eq_zero.mp hsum).resolve_left
    (by exact_mod_cast (Real.sqrt_pos.2 hi).ne')

/-- Positive-mass atoms annihilate a kernel polynomial of their atomic Gram
matrix. -/
theorem caratheodoryFejerActiveNodeSet_subset_kernelRoots
    {n r : ℕ} (xi : Fin (n + 1) → ℂ) (node : Fin r → ℂ) (weight : Fin r → ℝ)
    (hker : caratheodoryFejerAtomicGram (n := n) node weight *ᵥ xi = 0) :
    ∀ z ∈ caratheodoryFejerActiveNodeSet node weight,
      (finiteToeplitzKernelPolynomial xi).eval z = 0 := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
  exact caratheodoryFejerAtomicGram_kernel_eval_eq_zero_of_pos xi node weight hker i
    (Finset.mem_filter.mp hi).2

/-- **Rank-sharp finite Carathéodory--Fejér theorem.** A normalized Hermitian
PSD Toeplitz section of size `N + 1` and rank `N` has every root of every
nonzero kernel polynomial on the unit circle. -/
theorem circleToeplitzGram_kernel_polynomial_roots_on_unitCircle_of_rank_eq
    {N : ℕ} (c : ℤ → ℂ) (hc : IsHermitianMoment c) (hc0 : c 0 = 1)
    (hG : (circleToeplitzGram N c).PosSemidef)
    (hRank : (circleToeplitzGram N c).rank = N)
    (xi : Fin (N + 1) → ℂ)
    (hker : circleToeplitzGram N c *ᵥ xi = 0)
    (hxi : finiteToeplitzKernelPolynomial xi ≠ 0)
    {w : ℂ} (hw : w ∈ (finiteToeplitzKernelPolynomial xi).roots) :
    ‖w‖ = 1 := by
  obtain ⟨weight, node, hweight, hcircle, hfactor⟩ :=
    exists_atomic_caratheodoryFejer_psd_factorization c hc hc0 hG
  let B := caratheodoryFejerAtomicFactor (n := N) node weight
  let S := caratheodoryFejerActiveNodeSet node weight
  have hB_rank : B.rank = N := by
    calc
      B.rank = (Bᴴ * B).rank := (Matrix.rank_conjTranspose_mul_self B).symm
      _ = (caratheodoryFejerAtomicGram (n := N) node weight).rank := rfl
      _ = (circleToeplitzGram N c).rank := by rw [hfactor]
      _ = N := hRank
  have hrank_le : N ≤ S.card := by
    rw [← hB_rank]
    exact caratheodoryFejerAtomicFactor_rank_le_activeNodeCard node weight hweight
  have hkernel : caratheodoryFejerAtomicGram (n := N) node weight *ᵥ xi = 0 := by
    rw [← hfactor]
    exact hker
  have hSroots : ∀ z ∈ S, (finiteToeplitzKernelPolynomial xi).eval z = 0 :=
    caratheodoryFejerActiveNodeSet_subset_kernelRoots xi node weight hkernel
  have hdegree_le : (finiteToeplitzKernelPolynomial xi).natDegree ≤ S.card := by
    exact (natDegree_finiteToeplitzKernelPolynomial_le xi).trans hrank_le
  have hroots : (finiteToeplitzKernelPolynomial xi).roots = S.val :=
    Polynomial.roots_eq_of_natDegree_le_card_of_ne_zero hSroots hdegree_le hxi
  rw [hroots] at hw
  have hwS : w ∈ S := by simpa using hw
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hwS
  exact hcircle i

end

end GaloisForLFunctions.HTGeometry
