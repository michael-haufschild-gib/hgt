import GaloisForLFunctions.HTGeometry.JetWeightAction

/-!
# The weight-zero coordinates of the free jet field

The invariants of the weighted torus action are generated by the free generator together with the
ratios

`z_j := y_j / y₁^j`,

and on them the substitution endomorphism becomes *triangular affine*:

`R'(y₀)^j · Φ(z_j) = R'(y₀) · z_j + s_j`,   `s_j := σ_j / y₁^j`.

The scalar attached to `z_j` is `R'(y₀)^{1−j}` — it depends on `j` — and the inhomogeneous term
`s_j` involves only the ratios of lower index, because `σ_j` is isobaric of weight `j` and polynomial
in `y₁, …, y_{j−1}`.  At `j = 2` the identity reads `R'^(2 : ℕ)·Φ(z₂) = R'·z₂ + R''`, whose linearization
is exactly the rational affine-connection equation.

This is the normal form in which the descent of a normalizing shift is a finite triangular
induction: each step removes one ratio, and the base of the tower is the field of rational functions
of the free generator, where the invariant-differential and affine-connection non-existence theorems
live.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- The weight-zero ratio attached to the jet coordinate of order `j`. -/
def jetRatio (j : ℕ) : JetField C Unit :=
  (JetField.jet ((), j) : JetField C Unit) / (JetField.jet ((), 1) : JetField C Unit) ^ j

/-- The weight-zero form of the shift term. -/
def substitutionShiftRatio (R : RatFunc C) (j : ℕ) : JetField C Unit :=
  substitutionShift R j / (JetField.jet ((), 1) : JetField C Unit) ^ j

omit [CharZero C] in
theorem jetRatio_one : (jetRatio 1 : JetField C Unit) = 1 := by
  rw [jetRatio, pow_one, div_self (jet_ne_zero _)]

omit [CharZero C] in
theorem substitutionShiftRatio_one (R : RatFunc C) : substitutionShiftRatio R 1 = 0 := by
  have h0 : substitutionShift R 1 = 0 := by
    rw [substitutionShift, substitutionJet_one]
    ring
  rw [substitutionShiftRatio, h0, zero_div]

/-- **The triangular affine action on the weight-zero coordinates.** -/
theorem jetSubstitution_jetRatio (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) (j : ℕ) :
    substitutionDeriv R ^ j * jetSubstitution R hR (jetRatio j)
      = substitutionDeriv R * jetRatio j + substitutionShiftRatio R j := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hone : jetSubstitution R hR (JetField.jet ((), 1) : JetField C Unit)
      = JetField.jet ((), 1) * substitutionDeriv R := jetSubstitution_jet_one R hR
  have hj : jetSubstitution R hR (JetField.jet ((), j) : JetField C Unit)
      = substitutionDeriv R * (JetField.jet ((), j) : JetField C Unit)
        + substitutionShift R j := by
    rw [jetSubstitution_jet, substitutionJet_eq_affine]
  simp only [jetRatio, substitutionShiftRatio]
  rw [map_div₀, map_pow, hone, hj]
  field_simp
  ring

omit [CharZero C] in
/-- The weight-zero coordinates are invariant under the weighted action. -/
theorem weightScale_jetRatio {lam : C} (h : lam ≠ 0) (j : ℕ) :
    weightScale h (jetRatio j : JetField C Unit) = jetRatio j := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hlam : algebraMap C (JetField C Unit) lam ≠ 0 := by
    intro hh
    exact h ((algebraMap C (JetField C Unit)).injective (by rw [hh, map_zero]))
  simp only [jetRatio]
  rw [map_div₀, map_pow, weightScale_jet, weightScale_jet, pow_one, mul_pow, ← map_pow]
  field_simp

/-- The weight-zero form of the shift term is invariant under the weighted action. -/
theorem weightScale_substitutionShiftRatio {lam : C} (h : lam ≠ 0) (R : RatFunc C) (j : ℕ) :
    weightScale h (substitutionShiftRatio R j) = substitutionShiftRatio R j := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hlam : algebraMap C (JetField C Unit) lam ≠ 0 := by
    intro hh
    exact h ((algebraMap C (JetField C Unit)).injective (by rw [hh, map_zero]))
  simp only [substitutionShiftRatio]
  rw [map_div₀, map_pow, weightScale_substitutionShift, weightScale_jet, pow_one, mul_pow,
    ← map_pow]
  field_simp

/-- **At order two the triangular action carries the second derivative.** -/
theorem substitutionShiftRatio_two (R : RatFunc C) :
    substitutionShiftRatio R 2 = JetField.pd ((), 0) (substitutionDeriv R) := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  rw [substitutionShiftRatio, substitutionShift_two]
  field_simp

end

end GaloisForLFunctions.HTGeometry
