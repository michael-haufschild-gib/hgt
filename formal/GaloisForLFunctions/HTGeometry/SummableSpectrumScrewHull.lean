import GaloisForLFunctions.HTGeometry.InfiniteTorusFourierWeakConvergenceLaw

/-!
# The compact hull of a countable-spectrum screw line

A countable family of real frequencies `omega : I → ℝ` generates the one-parameter
subgroup `t ↦ (omega i * t)_i` of the product torus `I → UnitAddCircle`. Its closure
is the *relation hull*: it is exactly the common kernel of the finite-support
characters whose detuning vanishes, i.e. of the integer relations among the
frequencies.

The proof is measure-theoretic rather than dual-group-theoretic. Uniform time
sampling on `[-A, A]` produces a probability law whose finite-support Fourier
coefficients are sinc kernels; letting `A → ∞` selects the unique law whose
coefficients are the indicator of the relation lattice. That law is concentrated on
the closure of the line and is invariant under translation by every point of the
annihilator, which forces the annihilator into the closure.
-/

open Filter MeasureTheory Set Topology
open scoped ENNReal NNReal

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {I : Type*}

/-! ## The screw line and its hull -/

/-- Phase point of the screw line generated by the frequencies `omega` at time `t`. -/
def screwPhase (omega : I → ℝ) (t : ℝ) : I → UnitAddCircle :=
  fun i => ((omega i * t / (2 * Real.pi) : ℝ) : UnitAddCircle)

theorem screwPhase_zero (omega : I → ℝ) : screwPhase omega 0 = 0 := by
  funext i
  simp [screwPhase]

theorem screwPhase_add (omega : I → ℝ) (s t : ℝ) :
    screwPhase omega (s + t) = screwPhase omega s + screwPhase omega t := by
  funext i
  show ((omega i * (s + t) / (2 * Real.pi) : ℝ) : UnitAddCircle) =
    ((omega i * s / (2 * Real.pi) : ℝ) : UnitAddCircle) +
      ((omega i * t / (2 * Real.pi) : ℝ) : UnitAddCircle)
  rw [← QuotientAddGroup.mk_add]
  congr 1
  ring

/-- The screw line as a one-parameter subgroup of the product torus. -/
def screwLineHom (omega : I → ℝ) : ℝ →+ (I → UnitAddCircle) where
  toFun := screwPhase omega
  map_zero' := screwPhase_zero omega
  map_add' := screwPhase_add omega

@[simp]
theorem screwLineHom_apply (omega : I → ℝ) (t : ℝ) :
    screwLineHom omega t = screwPhase omega t := rfl

theorem screwPhase_continuous (omega : I → ℝ) : Continuous (screwPhase omega) := by
  apply continuous_pi
  intro i
  exact (AddCircle.continuous_mk' (1 : ℝ)).comp (by fun_prop)

/-- The **relation hull**: the closure of the screw line in the product torus. -/
def screwHull (omega : I → ℝ) : Set (I → UnitAddCircle) :=
  closure (Set.range (screwPhase omega))

/-- The relation hull as a closed subgroup. -/
def screwHullSubgroup (omega : I → ℝ) : AddSubgroup (I → UnitAddCircle) :=
  (screwLineHom omega).range.topologicalClosure

theorem screwHull_eq_coe (omega : I → ℝ) :
    screwHull omega = (screwHullSubgroup omega : Set (I → UnitAddCircle)) := rfl

theorem screwPhase_mem_screwHull (omega : I → ℝ) (t : ℝ) :
    screwPhase omega t ∈ screwHull omega :=
  subset_closure ⟨t, rfl⟩

theorem isClosed_screwHull (omega : I → ℝ) : IsClosed (screwHull omega) :=
  isClosed_closure

theorem isCompact_screwHull (omega : I → ℝ) [Countable I] :
    IsCompact (screwHull omega) :=
  (isClosed_screwHull omega).isCompact

/-- The relation hull is connected: it is the closure of the continuous image of a
connected line. -/
theorem isConnected_screwHull (omega : I → ℝ) : IsConnected (screwHull omega) := by
  refine IsConnected.closure ?_
  exact isConnected_range (screwPhase_continuous omega)

theorem zero_mem_screwHull (omega : I → ℝ) : (0 : I → UnitAddCircle) ∈ screwHull omega := by
  simpa [screwPhase_zero] using screwPhase_mem_screwHull omega 0

theorem add_mem_screwHull {omega : I → ℝ} {x y : I → UnitAddCircle}
    (hx : x ∈ screwHull omega) (hy : y ∈ screwHull omega) :
    x + y ∈ screwHull omega :=
  (screwHullSubgroup omega).add_mem hx hy

theorem neg_mem_screwHull {omega : I → ℝ} {x : I → UnitAddCircle}
    (hx : x ∈ screwHull omega) : -x ∈ screwHull omega :=
  (screwHullSubgroup omega).neg_mem hx

theorem sub_mem_screwHull {omega : I → ℝ} {x y : I → UnitAddCircle}
    (hx : x ∈ screwHull omega) (hy : y ∈ screwHull omega) :
    x - y ∈ screwHull omega :=
  (screwHullSubgroup omega).sub_mem hx hy

/-! ## Characters and the relation lattice -/

/-- Finite-support characters are homomorphisms of the product torus. -/
theorem infiniteTorusFourier_add_point (n : I →₀ ℤ) (x y : I → UnitAddCircle) :
    infiniteTorusFourier n (x + y) =
      infiniteTorusFourier n x * infiniteTorusFourier n y := by
  classical
  simp only [infiniteTorusFourier, ContinuousMap.coe_mk, Finsupp.prod, Pi.add_apply]
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp [fourier_apply, smul_add, AddCircle.toCircle_add]

/-- Evaluation of a finite-support character on the screw line is the exponential of
the selected detuning. -/
theorem infiniteTorusFourier_screwPhase (n : I →₀ ℤ) (omega : I → ℝ) (t : ℝ) :
    infiniteTorusFourier n (screwPhase omega t) =
      Complex.exp (((t * infiniteTorusCharacterDetuning n omega : ℝ) : ℂ) * Complex.I) := by
  have hpt : infiniteTorusPhasePoint omega t 1 = screwPhase omega t := by
    funext i
    simp only [infiniteTorusPhasePoint, screwPhase]
    norm_num
    ring_nf
  rw [← hpt, infiniteTorusFourier_phasePoint]
  norm_num

/-- The relation lattice of the frequency family: finite integer relations. -/
def screwRelationLattice (omega : I → ℝ) : Set (I →₀ ℤ) :=
  {n | infiniteTorusCharacterDetuning n omega = 0}

/-- The annihilator of the relation lattice inside the product torus. -/
def screwAnnihilator (omega : I → ℝ) : Set (I → UnitAddCircle) :=
  {z | ∀ n : I →₀ ℤ, n ∈ screwRelationLattice omega → infiniteTorusFourier n z = 1}

theorem isClosed_screwAnnihilator (omega : I → ℝ) : IsClosed (screwAnnihilator omega) := by
  have : screwAnnihilator omega =
      ⋂ n ∈ screwRelationLattice omega, {z | infiniteTorusFourier n z = 1} := by
    ext z; simp [screwAnnihilator]
  rw [this]
  refine isClosed_biInter fun n _ => ?_
  exact isClosed_eq (infiniteTorusFourier n).continuous continuous_const

theorem zero_mem_screwAnnihilator (omega : I → ℝ) :
    (0 : I → UnitAddCircle) ∈ screwAnnihilator omega := by
  intro n _
  classical
  simp [infiniteTorusFourier, Finsupp.prod]

/-- The hull is contained in the annihilator: relations kill the whole line, hence its
closure. -/
theorem screwHull_subset_screwAnnihilator (omega : I → ℝ) :
    screwHull omega ⊆ screwAnnihilator omega := by
  intro z hz n hn
  have hline : ∀ t : ℝ, infiniteTorusFourier n (screwPhase omega t) = 1 := by
    intro t
    rw [infiniteTorusFourier_screwPhase]
    have : infiniteTorusCharacterDetuning n omega = 0 := hn
    simp [this]
  have hset : Set.range (screwPhase omega) ⊆ {w | infiniteTorusFourier n w = 1} := by
    rintro _ ⟨t, rfl⟩
    exact hline t
  have hclosed : IsClosed {w : I → UnitAddCircle | infiniteTorusFourier n w = 1} :=
    isClosed_eq (infiniteTorusFourier n).continuous continuous_const
  exact (closure_minimal hset hclosed) hz

/-! ## The limit law of uniform time sampling -/

private theorem tendsto_sinc_mul_atTop {d : ℝ} (hd : d ≠ 0) :
    Tendsto (fun A : ℝ => Real.sinc (A * d)) atTop (𝓝 0) := by
  have habs : ∀ᶠ A : ℝ in atTop, ‖Real.sinc (A * d)‖ ≤ 1 / (A * |d|) := by
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with A hA
    have hAd : A * d ≠ 0 := mul_ne_zero (ne_of_gt hA) hd
    rw [Real.sinc_of_ne_zero hAd]
    rw [Real.norm_eq_abs, abs_div]
    have hden : |A * d| = A * |d| := by
      rw [abs_mul, abs_of_pos hA]
    rw [hden]
    exact div_le_div_of_nonneg_right (Real.abs_sin_le_one _)
      (mul_nonneg hA.le (abs_nonneg d))
  have hlim : Tendsto (fun A : ℝ => 1 / (A * |d|)) atTop (𝓝 0) := by
    have hpos : 0 < |d| := abs_pos.mpr hd
    have hmul : Tendsto (fun A : ℝ => A * |d|) atTop atTop :=
      Filter.Tendsto.atTop_mul_const hpos tendsto_id
    simpa [Pi.inv_def, one_div] using hmul.inv_tendsto_atTop
  exact squeeze_zero_norm' habs hlim

private theorem tendsto_sinc_mul_atTop_indicator (omega : I → ℝ) (n : I →₀ ℤ) :
    Tendsto
      (fun A : ℝ =>
        ((Real.sinc (A * infiniteTorusCharacterDetuning n omega) : ℝ) : ℂ))
      atTop
      (𝓝 (if infiniteTorusCharacterDetuning n omega = 0 then (1 : ℂ) else 0)) := by
  by_cases hd : infiniteTorusCharacterDetuning n omega = 0
  · rw [if_pos hd]
    simp [hd]
  · rw [if_neg hd]
    simpa [Function.comp_def] using
      (Complex.continuous_ofReal.tendsto 0).comp (tendsto_sinc_mul_atTop hd)

variable [Countable I]

/-- Uniform time sampling on `[-A, A]` selects, as `A → ∞`, a unique probability law on
the product torus whose finite-support Fourier coefficients are the indicator of the
relation lattice. -/
theorem existsUnique_screwHaar (omega : I → ℝ) :
    ∃! mu : ProbabilityMeasure (I → UnitAddCircle),
      Tendsto (fun A : ℝ => infiniteTorusPhaseProbabilityMeasure omega A) atTop (𝓝 mu) ∧
        ∀ n : I →₀ ℤ,
          (∫ x, infiniteTorusFourier n x ∂(mu : Measure (I → UnitAddCircle))) =
            if infiniteTorusCharacterDetuning n omega = 0 then (1 : ℂ) else 0 := by
  refine existsUnique_probabilityMeasure_tendsto_of_infiniteTorusFourier_limit
    (fun A : ℝ => infiniteTorusPhaseProbabilityMeasure omega A) _ ?_
  intro n
  simpa only [infiniteTorusPhaseProbabilityMeasure_fourier_integral] using
    tendsto_sinc_mul_atTop_indicator omega n

/-- The canonical invariant law of the screw hull. -/
def screwHaar (omega : I → ℝ) : ProbabilityMeasure (I → UnitAddCircle) :=
  (existsUnique_screwHaar omega).exists.choose

theorem screwHaar_tendsto (omega : I → ℝ) :
    Tendsto (fun A : ℝ => infiniteTorusPhaseProbabilityMeasure omega A) atTop
      (𝓝 (screwHaar omega)) :=
  (existsUnique_screwHaar omega).exists.choose_spec.1

/-- Fourier coefficients of the invariant law are the indicator of the relation
lattice. -/
theorem screwHaar_fourier (omega : I → ℝ) (n : I →₀ ℤ) :
    (∫ x, infiniteTorusFourier n x ∂(screwHaar omega : Measure (I → UnitAddCircle))) =
      if infiniteTorusCharacterDetuning n omega = 0 then (1 : ℂ) else 0 :=
  (existsUnique_screwHaar omega).exists.choose_spec.2 n


/-! ## Concentration and invariance of the limit law -/

/-- Every uniformly sampled phase law is carried by the hull. -/
theorem infiniteTorusPhaseProbabilityMeasure_hull (omega : I → ℝ) (A : ℝ) :
    (infiniteTorusPhaseProbabilityMeasure omega A : Measure (I → UnitAddCircle))
        (screwHull omega) = 1 := by
  rw [infiniteTorusPhaseProbabilityMeasure, ProbabilityMeasure.toMeasure_map,
    Measure.map_apply (infiniteTorusPhasePoint_continuous omega A).measurable
      (isClosed_screwHull omega).measurableSet]
  have hpre : infiniteTorusPhasePoint omega A ⁻¹' screwHull omega = Set.univ := by
    ext u
    simp only [Set.mem_preimage, Set.mem_univ, iff_true]
    have : infiniteTorusPhasePoint omega A u = screwPhase omega (A * (2 * u - 1)) := by
      funext i
      simp only [infiniteTorusPhasePoint, screwPhase]
      ring_nf
    rw [this]
    exact screwPhase_mem_screwHull omega _
  rw [hpre]
  exact measure_univ

/-- The limit law is carried by the hull. -/
theorem screwHaar_measure_hull (omega : I → ℝ) :
    (screwHaar omega : Measure (I → UnitAddCircle)) (screwHull omega) = 1 := by
  have hport :=
    ProbabilityMeasure.limsup_measure_closed_le_of_tendsto (screwHaar_tendsto omega)
      (isClosed_screwHull omega)
  have hfun :
      (fun A : ℝ =>
        (infiniteTorusPhaseProbabilityMeasure omega A : Measure (I → UnitAddCircle))
          (screwHull omega)) = fun _ : ℝ => (1 : ℝ≥0∞) :=
    funext (infiniteTorusPhaseProbabilityMeasure_hull omega)
  rw [hfun, limsup_const] at hport
  refine le_antisymm ?_ hport
  simpa using
    measure_mono (μ := (screwHaar omega : Measure (I → UnitAddCircle)))
      (Set.subset_univ (screwHull omega))

/-- The limit law is invariant under translation by any annihilator point. -/
theorem screwHaar_map_add_self {omega : I → ℝ} {z : I → UnitAddCircle}
    (hz : z ∈ screwAnnihilator omega) :
    Measure.map (fun x : I → UnitAddCircle => x + z)
        (screwHaar omega : Measure (I → UnitAddCircle)) =
      (screwHaar omega : Measure (I → UnitAddCircle)) := by
  have hmeas : Measurable (fun x : I → UnitAddCircle => x + z) := by fun_prop
  set nu : ProbabilityMeasure (I → UnitAddCircle) :=
    ProbabilityMeasure.map (screwHaar omega) hmeas.aemeasurable with hnu
  have hnucoe : (nu : Measure (I → UnitAddCircle)) =
      Measure.map (fun x : I → UnitAddCircle => x + z)
        (screwHaar omega : Measure (I → UnitAddCircle)) := by
    rw [hnu, ProbabilityMeasure.toMeasure_map]
  have hcoeff : ∀ n : I →₀ ℤ,
      (∫ x, infiniteTorusFourier n x ∂(nu : Measure (I → UnitAddCircle))) =
        ∫ x, infiniteTorusFourier n x
          ∂(screwHaar omega : Measure (I → UnitAddCircle)) := by
    intro n
    rw [hnucoe, integral_map hmeas.aemeasurable
      (infiniteTorusFourier n).continuous.aestronglyMeasurable]
    simp only [infiniteTorusFourier_add_point]
    rw [integral_mul_const, screwHaar_fourier]
    by_cases hd : infiniteTorusCharacterDetuning n omega = 0
    · rw [if_pos hd, hz n hd, one_mul]
    · rw [if_neg hd, zero_mul]
  have : nu = screwHaar omega :=
    probabilityMeasure_ext_of_infiniteTorusFourier_integral_eq _ _ hcoeff
  rw [← hnucoe, this]

/-- **Relation hull law.** The closure of the screw line is exactly the annihilator of
the lattice of finite integer relations among the frequencies. -/
theorem screwHull_eq_screwAnnihilator (omega : I → ℝ) :
    screwHull omega = screwAnnihilator omega := by
  refine Set.Subset.antisymm (screwHull_subset_screwAnnihilator omega) ?_
  intro z hz
  set mu : Measure (I → UnitAddCircle) := (screwHaar omega : Measure (I → UnitAddCircle))
  have hmeas : Measurable (fun x : I → UnitAddCircle => x + z) := by fun_prop
  have hS : mu (screwHull omega) = 1 := screwHaar_measure_hull omega
  have hshift : mu {x : I → UnitAddCircle | x + z ∈ screwHull omega} = 1 := by
    have := screwHaar_map_add_self hz
    have h2 : Measure.map (fun x : I → UnitAddCircle => x + z) mu (screwHull omega) =
        mu (screwHull omega) := by rw [this]
    rw [Measure.map_apply hmeas (isClosed_screwHull omega).measurableSet] at h2
    rw [show {x : I → UnitAddCircle | x + z ∈ screwHull omega} =
      (fun x : I → UnitAddCircle => x + z) ⁻¹' screwHull omega from rfl, h2, hS]
  have hcompl1 : mu (screwHull omega)ᶜ = 0 := by
    have : IsProbabilityMeasure mu := inferInstance
    rw [measure_compl (isClosed_screwHull omega).measurableSet (measure_ne_top _ _), hS,
      measure_univ, tsub_self]
  have hcompl2 : mu {x : I → UnitAddCircle | x + z ∈ screwHull omega}ᶜ = 0 := by
    have hm : MeasurableSet {x : I → UnitAddCircle | x + z ∈ screwHull omega} :=
      hmeas (isClosed_screwHull omega).measurableSet
    rw [measure_compl hm (measure_ne_top _ _), hshift, measure_univ, tsub_self]
  have hinter : mu (screwHull omega ∩ {x : I → UnitAddCircle | x + z ∈ screwHull omega}) ≠ 0 := by
    intro hzero
    have hcup : mu ((screwHull omega)ᶜ ∪
        {x : I → UnitAddCircle | x + z ∈ screwHull omega}ᶜ) = 0 :=
      measure_union_null hcompl1 hcompl2
    have huniv : mu Set.univ ≤ 0 := by
      have hsub : (Set.univ : Set (I → UnitAddCircle)) ⊆
          (screwHull omega ∩ {x : I → UnitAddCircle | x + z ∈ screwHull omega}) ∪
            ((screwHull omega)ᶜ ∪ {x : I → UnitAddCircle | x + z ∈ screwHull omega}ᶜ) := by
        intro x _
        by_cases h1 : x ∈ screwHull omega
        · by_cases h2 : x + z ∈ screwHull omega
          · exact Or.inl ⟨h1, h2⟩
          · exact Or.inr (Or.inr h2)
        · exact Or.inr (Or.inl h1)
      calc mu Set.univ ≤ mu _ := measure_mono hsub
        _ ≤ mu (screwHull omega ∩ {x : I → UnitAddCircle | x + z ∈ screwHull omega}) +
              mu ((screwHull omega)ᶜ ∪
                {x : I → UnitAddCircle | x + z ∈ screwHull omega}ᶜ) := measure_union_le _ _
        _ = 0 := by rw [hzero, hcup, add_zero]
    rw [measure_univ] at huniv
    simp at huniv
  obtain ⟨x, hx1, hx2⟩ := nonempty_of_measure_ne_zero hinter
  have : z = (x + z) - x := by abel
  rw [this]
  exact sub_mem_screwHull hx2 hx1

end

end GaloisForLFunctions.HTGeometry
