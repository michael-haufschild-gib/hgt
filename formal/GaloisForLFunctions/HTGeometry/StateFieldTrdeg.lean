import GaloisForLFunctions.HTGeometry.AlgebraicClosureDerivationClosed
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonAllRankQSystem
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Transcendence degree of a state field and of its algebraic closure

A field generated by a family of elements has transcendence degree at most the size of the family,
and passing to the relative algebraic closure does not change it.

Together these say that the *state field* of a composition — generated by the states and closed under
whatever algebraic relations the constituents impose — is still bounded by the number of states.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

universe u

noncomputable section

/-- **A generated field has transcendence degree at most the number of generators.** -/
theorem trdeg_intermediateFieldAdjoin_range_le
    {F E I : Type u} [Field F] [Field E] [Algebra F E] (x : I → E) :
    Algebra.trdeg F (IntermediateField.adjoin F (Set.range x)) ≤ Cardinal.mk I := by
  let A := IntermediateField.adjoin F (Set.range x)
  let xA : I → A := fun i =>
    ⟨x i, IntermediateField.subset_adjoin F (Set.range x) (Set.mem_range_self i)⟩
  have hxTop : IntermediateField.adjoin F (Set.range xA) = ⊤ := by
    simpa [A, xA] using adjoin_range_lift_eq_top x x rfl
  letI : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range xA)) A :=
    isAlgebraic_adjoin_of_intermediate_adjoin_eq_top xA hxTop
  calc Algebra.trdeg F A ≤ Cardinal.mk (Set.range xA) :=
        Algebra.IsAlgebraic.trdeg_le_cardinalMk F (Set.range xA)
    _ ≤ Cardinal.mk I := Cardinal.mk_range_le

/-- **The relative algebraic closure has the same transcendence degree.** -/
theorem trdeg_algebraicClosure_restrictScalars_eq
    {K L : Type u} [Field K] [Field L] [Algebra K L] (E : IntermediateField K L) :
    Algebra.trdeg K ((algebraicClosure E L).restrictScalars K) = Algebra.trdeg K E := by
  letI : Algebra (E : Type u) ((algebraicClosure E L).restrictScalars K) :=
    inferInstanceAs (Algebra (E : Type u) (algebraicClosure (E : Type u) L))
  haveI : IsScalarTower K (E : Type u) ((algebraicClosure E L).restrictScalars K) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : Algebra.IsAlgebraic (E : Type u) ((algebraicClosure E L).restrictScalars K) :=
    inferInstanceAs (Algebra.IsAlgebraic (E : Type u) (algebraicClosure (E : Type u) L))
  have hsum := trdeg_add_eq K (E : Type u)
    (A := ((algebraicClosure E L).restrictScalars K : Type u))
  rw [trdeg_eq_zero (R := (E : Type u))
    (A := ((algebraicClosure E L).restrictScalars K : Type u)), add_zero] at hsum
  exact hsum.symm

/-- **The state field's closure is still bounded by the number of generators.** -/
theorem trdeg_algebraicClosure_adjoin_range_le
    {K L I : Type u} [Field K] [Field L] [Algebra K L] (x : I → L) :
    Algebra.trdeg K
        ((algebraicClosure (IntermediateField.adjoin K (Set.range x)) L).restrictScalars K)
      ≤ Cardinal.mk I := by
  rw [trdeg_algebraicClosure_restrictScalars_eq]
  exact trdeg_intermediateFieldAdjoin_range_le x

/-- Elements of an intermediate field lie in its relative algebraic closure. -/
theorem mem_algebraicClosure_restrictScalars_of_mem
    {K L : Type u} [Field K] [Field L] [Algebra K L] (E : IntermediateField K L)
    {y : L} (hy : y ∈ E) :
    y ∈ (algebraicClosure (E : Type u) L).restrictScalars K := by
  rw [IntermediateField.mem_restrictScalars]
  exact IntermediateField.algebraMap_mem _ (⟨y, hy⟩ : E)

/-- **Every jet stays in the closure.**  If the derivative of each element of `E` is algebraic over
`E`, the relative algebraic closure of `E` contains every jet of each of its elements. -/
theorem differentialJet_mem_algebraicClosure_restrictScalars
    {K L : Type u} [Field K] [Field L] [Algebra K L] [Differential L] [CharZero L]
    (E : IntermediateField K L)
    (hE : ∀ y : L, y ∈ E → y′ ∈ algebraicClosure (E : Type u) L)
    {x : L} (hx : x ∈ (algebraicClosure (E : Type u) L).restrictScalars K) (i : ℕ) :
    differentialJet i x ∈ (algebraicClosure (E : Type u) L).restrictScalars K := by
  have hE' : ∀ y : L, y ∈ (⊥ : IntermediateField (E : Type u) L) →
      y′ ∈ algebraicClosure (E : Type u) L := by
    intro y hy
    obtain ⟨e, rfl⟩ := IntermediateField.mem_bot.mp hy
    exact hE _ e.2
  rw [IntermediateField.mem_restrictScalars] at hx ⊢
  induction i with
  | zero => simpa using hx
  | succ i ih =>
      rw [differentialJet_succ]
      exact deriv_mem_algebraicClosure hE' ih

/-- **The generator test.**  If the derivatives of the generators and of the base field all land in
the relative algebraic closure of the generated field, then so does the derivative of every element
of that field.  This replaces a condition on infinitely many elements by finitely many checks. -/
theorem deriv_mem_algebraicClosure_adjoin_of_generators
    {K L : Type u} [Field K] [Field L] [Algebra K L] [Differential L] {s : Set L}
    (hbase : ∀ c : K, (algebraMap K L c)′ ∈
      algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L)
    (hgen : ∀ y ∈ s, y′ ∈
      algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L) :
    ∀ y : L, y ∈ IntermediateField.adjoin K s →
      y′ ∈ algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L := by
  have hEM : ∀ w : L, w ∈ IntermediateField.adjoin K s →
      w ∈ algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L :=
    fun w hw => IntermediateField.algebraMap_mem _
      (⟨w, hw⟩ : (IntermediateField.adjoin K s : IntermediateField K L))
  intro y hy
  refine IntermediateField.adjoin_induction K
    (p := fun w (_ : w ∈ IntermediateField.adjoin K s) =>
      w′ ∈ algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L)
    ?_ ?_ ?_ ?_ ?_ hy
  · intro w hw
    exact hgen w hw
  · intro c
    exact hbase c
  · intro u v hu hv ihu ihv
    rw [map_add]
    exact add_mem ihu ihv
  · intro u hu ihu
    rw [Derivation.leibniz_inv, smul_eq_mul]
    exact mul_mem (neg_mem (pow_mem (inv_mem (hEM u hu)) 2)) ihu
  · intro u v hu hv ihu ihv
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (mul_mem (hEM u hu) ihv) (mul_mem (hEM v hv) ihu)

/-- The derivative of a base-field element lies in the relative algebraic closure whenever the base
embedding is differential. -/
theorem deriv_algebraMap_mem_algebraicClosure_adjoin
    {K L : Type u} [Field K] [Field L] [Algebra K L] [Differential K] [Differential L]
    [DifferentialAlgebra K L] (s : Set L) (c : K) :
    (algebraMap K L c)′ ∈
      algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L := by
  rw [deriv_algebraMap]
  exact IntermediateField.algebraMap_mem _
    (⟨algebraMap K L c′, IntermediateField.algebraMap_mem _ c′⟩ :
      (IntermediateField.adjoin K s : IntermediateField K L))

/-- **The generator test over a differential base.**  With a differential base embedding, only the
generators need checking. -/
theorem deriv_mem_algebraicClosure_adjoin_of_gen
    {K L : Type u} [Field K] [Field L] [Algebra K L] [Differential K] [Differential L]
    [DifferentialAlgebra K L] {s : Set L}
    (hgen : ∀ y ∈ s, y′ ∈
      algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L) :
    ∀ y : L, y ∈ IntermediateField.adjoin K s →
      y′ ∈ algebraicClosure ((IntermediateField.adjoin K s : IntermediateField K L) : Type u) L :=
  deriv_mem_algebraicClosure_adjoin_of_generators
    (deriv_algebraMap_mem_algebraicClosure_adjoin s) hgen

end

end GaloisForLFunctions.HTGeometry
