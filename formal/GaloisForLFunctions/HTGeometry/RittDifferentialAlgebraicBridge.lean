import GaloisForLFunctions.HTGeometry.RittPrefixFieldStability
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity

/-!
# Differential algebraicity of a linearizer, in the frame

A frame whose derivation is the ambient one computes the corpus's jets, so the corpus's statement
that a differentially algebraic element has some jet algebraic over the field generated by its
predecessors is a statement about the frame's prefix fields.  Combined with the collapse it says:

*for a linearizer `τ` that is differentially algebraic over the base, either `τ` and `d τ` are
already algebraically dependent — an algebraic differential equation of order one, which by
`exists_rittForm_of_not_algebraicIndependent` yields Ritt's relation `(d τ)^r = A · τ^j` — or some
jet of order `n ≥ 2` lies in the field generated by its predecessors.*

The second alternative is what the Galoisian proof of Ritt's theorem must still exclude.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The frame's prefix field is the corpus's jet prefix field when the frame's derivation is the
ambient one. -/
theorem jetPrefixField_eq_differentialJetPrefixField [Differential L] (Fr : RittFrame K L)
    (hd : Fr.d = ⇑(Differential.deriv : Derivation ℤ L L)) (τ : L) (n : ℕ) :
    Fr.jetPrefixField τ n = differentialJetPrefixField K τ n := by
  have hset : {x : L | ∃ j < n, x = Fr.d^[j] τ}
      = (fun m => differentialJet m τ) '' Set.Iio n := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      exact ⟨j, hj, by simp [differentialJet, hd]⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨j, hj, by simp [differentialJet, hd]⟩
  rw [RittFrame.jetPrefixField, differentialJetPrefixField, hset]

/-- **Some jet of a differentially algebraic linearizer is algebraic over its predecessors.** -/
theorem exists_isAlgebraic_jet_over_jetPrefixField [Differential L] (Fr : RittFrame K L)
    (hd : Fr.d = ⇑(Differential.deriv : Derivation ℤ L L)) {τ : L}
    (hDA : DifferentialAlgebraicOver K τ) :
    ∃ n : ℕ, IsAlgebraic ↥(Fr.jetPrefixField τ n) (Fr.d^[n] τ) := by
  obtain ⟨n, hn⟩ := exists_algebraic_jet_over_prefix (k := K) hDA
  refine ⟨n, ?_⟩
  have hjet : Fr.d^[n] τ = differentialJet n τ := by simp [differentialJet, hd]
  rw [jetPrefixField_eq_differentialJetPrefixField Fr hd, hjet, differentialJetPrefixField]
  exact hn

/-- Algebraicity over an intermediate field passes to any larger one. -/
theorem isAlgebraic_of_intermediateField_le {E F : IntermediateField K L} (h : E ≤ F) {x : L}
    (hx : IsAlgebraic ↥E x) : IsAlgebraic ↥F x := by
  obtain ⟨p, hp0, hp⟩ := hx
  refine ⟨p.map (IntermediateField.inclusion h).toRingHom, ?_, ?_⟩
  · simpa [Polynomial.map_eq_zero_iff (IntermediateField.inclusion h).injective] using hp0
  · rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    rw [Polynomial.aeval_def] at hp
    exact hp

/-- **The Ritt alternative for a differentially algebraic linearizer.**  Either the linearizer
satisfies an algebraic differential equation of order one — and then Ritt's relation
`(d τ)^r = A · τ^j` — or some jet of order at least two lies in the field generated by the lower
jets. -/
theorem rittForm_or_jet_mem_jetPrefixField [Differential K] [Differential L]
    [DifferentialAlgebra K L] [CharZero K] [CharZero L]
    (Fr : RittFrame K L) (hd : Fr.d = ⇑(Differential.deriv : Derivation ℤ L L))
    {τ : L} {q : K} (hτ : τ ≠ 0) (hdτ : Fr.d τ ≠ 0) (hq : q ≠ 0) (hqconst : Fr.dK q = 0)
    (hshift : Fr.σ τ = algebraMap K L q * τ)
    (hDA : DifferentialAlgebraicOver K τ) :
    (∃ (r j : ℤ) (A : K), r ≠ 0 ∧ A ≠ 0 ∧ (Fr.d τ) ^ r = algebraMap K L A * τ ^ j) ∨
      ∃ n : ℕ, 2 ≤ n ∧ Fr.d^[n] τ ∈ Fr.jetPrefixField τ n := by
  by_cases hdep : AlgebraicIndependent K ![τ, Fr.d τ]
  · right
    obtain ⟨n, hn⟩ := exists_algebraic_jet_over_prefix (k := K) hDA
    set N : ℕ := max n 2 with hN
    have hjet : ∀ m : ℕ, Fr.d^[m] τ = differentialJet m τ := fun m => by
      simp [differentialJet, hd]
    have hall : IsAlgebraic ↥(differentialJetPrefixField K τ n) (differentialJet N τ) :=
      all_jets_algebraic_over_prefix (k := K) τ n hn N
    have hle : Fr.jetPrefixField τ n ≤ Fr.jetPrefixField τ N := by
      refine IntermediateField.adjoin.mono K _ _ ?_
      rintro x ⟨j, hj, rfl⟩
      exact ⟨j, lt_of_lt_of_le hj (le_max_left _ _), rfl⟩
    have hallFr : IsAlgebraic ↥(Fr.jetPrefixField τ n) (Fr.d^[N] τ) := by
      rw [jetPrefixField_eq_differentialJetPrefixField Fr hd, hjet N]
      exact hall
    exact ⟨N, le_max_right _ _,
      jet_mem_jetPrefixField_of_isAlgebraic Fr hτ hdτ hq hqconst hshift (le_max_right _ _)
        (isAlgebraic_of_intermediateField_le hle hallFr)⟩
  · exact Or.inl (exists_rittForm_of_not_algebraicIndependent Fr hτ hq hdτ hqconst hshift hdep)

end GaloisForLFunctions.HTGeometry
