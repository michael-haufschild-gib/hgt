import Mathlib.LinearAlgebra.Matrix.Transvection
import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup

/-!
# The special linear group is generated by elementary transvections

Pivot theory reduces an arbitrary square matrix over a field to a diagonal matrix by elementary
row and column operations, so every matrix is a product of transvections and one diagonal factor.
This file removes the diagonal factor in the unimodular case.

The mechanism is the four-term identity

`E_(ij)(1) · E_(ji)(a-1) · E_(ij)(-a⁻¹) · E_(ji)(a-a²) = diag(a at i, a⁻¹ at j, 1 elsewhere)`,

which realises every two-entry unimodular diagonal matrix as a product of transvections.  A
diagonal matrix of determinant one becomes a product of such two-entry factors by clearing one
nonunit entry at a time.  Consequently the elementary transvections generate the whole special
linear group over any field.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

variable {n : Type*} [Fintype n] [DecidableEq n] {K : Type*} [Field K]

/-! ## The elementary transvection subgroup -/

/-- The elementary transvection `1 + c E_(ij)`, `i ≠ j`, as a unimodular matrix. -/
def transvectionSL (i j : n) (hij : i ≠ j) (c : K) : SpecialLinearGroup n K :=
  ⟨Matrix.transvection i j c, Matrix.det_transvection_of_ne i j hij c⟩

@[simp]
theorem coe_transvectionSL (i j : n) (hij : i ≠ j) (c : K) :
    (transvectionSL i j hij c : Matrix n n K) = Matrix.transvection i j c := rfl

/-- The set of all elementary transvections inside the special linear group. -/
def transvectionSet (n : Type*) [Fintype n] [DecidableEq n] (K : Type*) [Field K] :
    Set (SpecialLinearGroup n K) :=
  {g | ∃ (i j : n) (hij : i ≠ j) (c : K), g = transvectionSL i j hij c}

/-- The subgroup generated by all elementary transvections. -/
def transvectionSubgroup (n : Type*) [Fintype n] [DecidableEq n] (K : Type*) [Field K] :
    Subgroup (SpecialLinearGroup n K) :=
  Subgroup.closure (transvectionSet n K)

theorem transvectionSL_mem_transvectionSubgroup (i j : n) (hij : i ≠ j) (c : K) :
    transvectionSL i j hij c ∈ transvectionSubgroup n K :=
  Subgroup.subset_closure ⟨i, j, hij, c, rfl⟩

/-- A square matrix is a *transvection product* when it underlies an element of the subgroup
generated by the elementary transvections. -/
def IsTransvectionProduct (M : Matrix n n K) : Prop :=
  ∃ g ∈ transvectionSubgroup n K, (g : Matrix n n K) = M

namespace IsTransvectionProduct

theorem one : IsTransvectionProduct (1 : Matrix n n K) :=
  ⟨1, one_mem _, rfl⟩

theorem mul {A B : Matrix n n K}
    (hA : IsTransvectionProduct A) (hB : IsTransvectionProduct B) :
    IsTransvectionProduct (A * B) := by
  obtain ⟨g, hg, rfl⟩ := hA
  obtain ⟨h, hh, rfl⟩ := hB
  exact ⟨g * h, mul_mem hg hh, rfl⟩

theorem transvection (i j : n) (hij : i ≠ j) (c : K) :
    IsTransvectionProduct (Matrix.transvection i j c) :=
  ⟨transvectionSL i j hij c, transvectionSL_mem_transvectionSubgroup i j hij c, rfl⟩

theorem toMatrix (t : Matrix.TransvectionStruct n K) :
    IsTransvectionProduct t.toMatrix :=
  IsTransvectionProduct.transvection t.i t.j t.hij t.c

theorem listProd (L : List (Matrix.TransvectionStruct n K)) :
    IsTransvectionProduct (L.map Matrix.TransvectionStruct.toMatrix).prod := by
  induction L with
  | nil => simpa using IsTransvectionProduct.one
  | cons t L ih =>
      simpa [List.prod_cons] using (IsTransvectionProduct.toMatrix t).mul ih

end IsTransvectionProduct

/-! ## The two-entry unimodular diagonal factor -/

/-- The diagonal weight carrying `a` at `i`, `a⁻¹` at `j`, and `1` elsewhere. -/
def elementaryWeight (i j : n) (a : K) : n → K :=
  Function.update (Function.update (fun _ => (1 : K)) j a⁻¹) i a

omit [Fintype n] in
@[simp]
theorem elementaryWeight_left (i j : n) (a : K) : elementaryWeight i j a i = a :=
  Function.update_self ..

omit [Fintype n] in
theorem elementaryWeight_right (i j : n) (a : K) (hij : i ≠ j) :
    elementaryWeight i j a j = a⁻¹ := by
  rw [elementaryWeight, Function.update_of_ne (Ne.symm hij), Function.update_self]

omit [Fintype n] in
theorem elementaryWeight_of_ne (i j : n) (a : K) {k : n} (hki : k ≠ i) (hkj : k ≠ j) :
    elementaryWeight i j a k = 1 := by
  rw [elementaryWeight, Function.update_of_ne hki, Function.update_of_ne hkj]

/-- The diagonal matrix carrying `a` at `i`, `a⁻¹` at `j`, and `1` elsewhere. -/
def elementaryDiagonal (i j : n) (a : K) : Matrix n n K :=
  Matrix.diagonal (elementaryWeight i j a)

/-- **Four-transvection factorisation of a two-entry unimodular diagonal matrix.**  The product of
four elementary transvections supported on the coordinates `i ≠ j` is the diagonal matrix with
entries `a` and `a⁻¹` at those coordinates. -/
theorem transvection_prod_eq_elementaryDiagonal
    (i j : n) (hij : i ≠ j) (a : K) (ha : a ≠ 0) :
    Matrix.transvection i j 1 * Matrix.transvection j i (a - 1) *
        Matrix.transvection i j (-a⁻¹) * Matrix.transvection j i (a - a ^ 2) =
      elementaryDiagonal i j a := by
  have hji : j ≠ i := hij.symm
  have hassoc :
      Matrix.transvection i j (1 : K) * Matrix.transvection j i (a - 1) *
          Matrix.transvection i j (-a⁻¹) * Matrix.transvection j i (a - a ^ 2) =
        Matrix.transvection i j (1 : K) * (Matrix.transvection j i (a - 1) *
          (Matrix.transvection i j (-a⁻¹) *
            (Matrix.transvection j i (a - a ^ 2) * (1 : Matrix n n K)))) := by
    rw [Matrix.mul_one, Matrix.mul_assoc, Matrix.mul_assoc]
  ext k l
  rw [hassoc]
  rcases eq_or_ne k i with rfl | hki
  · have hL : (Matrix.transvection k j (1 : K) * (Matrix.transvection j k (a - 1) *
        (Matrix.transvection k j (-a⁻¹) *
          (Matrix.transvection j k (a - a ^ 2) * (1 : Matrix n n K))))) k l =
        a * (1 : Matrix n n K) k l := by
      simp only [Matrix.transvection_mul_apply_same,
        Matrix.transvection_mul_apply_of_ne _ _ _ _ hij,
        Matrix.transvection_mul_apply_of_ne _ _ _ _ hji]
      field_simp
      ring
    rw [hL, elementaryDiagonal, Matrix.diagonal_apply, Matrix.one_apply, elementaryWeight_left]
    split_ifs <;> simp
  · rcases eq_or_ne k j with rfl | hkj
    · have hL : (Matrix.transvection i k (1 : K) * (Matrix.transvection k i (a - 1) *
          (Matrix.transvection i k (-a⁻¹) *
            (Matrix.transvection k i (a - a ^ 2) * (1 : Matrix n n K))))) k l =
          a⁻¹ * (1 : Matrix n n K) k l := by
        simp only [Matrix.transvection_mul_apply_same,
          Matrix.transvection_mul_apply_of_ne _ _ _ _ hij,
          Matrix.transvection_mul_apply_of_ne _ _ _ _ hji]
        field_simp
        ring
      rw [hL, elementaryDiagonal, Matrix.diagonal_apply, Matrix.one_apply,
        elementaryWeight_right i k a hij]
      split_ifs <;> simp
    · have hL : (Matrix.transvection i j (1 : K) * (Matrix.transvection j i (a - 1) *
          (Matrix.transvection i j (-a⁻¹) *
            (Matrix.transvection j i (a - a ^ 2) * (1 : Matrix n n K))))) k l =
          (1 : Matrix n n K) k l := by
        simp only [Matrix.transvection_mul_apply_of_ne _ _ _ _ hki,
          Matrix.transvection_mul_apply_of_ne _ _ _ _ hkj]
      rw [hL, elementaryDiagonal, Matrix.diagonal_apply, Matrix.one_apply,
        elementaryWeight_of_ne i j a hki hkj]

theorem IsTransvectionProduct.elementaryDiagonal
    (i j : n) (hij : i ≠ j) (a : K) (ha : a ≠ 0) :
    IsTransvectionProduct (elementaryDiagonal (K := K) i j a) := by
  rw [← transvection_prod_eq_elementaryDiagonal i j hij a ha]
  exact (((IsTransvectionProduct.transvection i j hij 1).mul
    (IsTransvectionProduct.transvection j i hij.symm (a - 1))).mul
    (IsTransvectionProduct.transvection i j hij (-a⁻¹))).mul
    (IsTransvectionProduct.transvection j i hij.symm (a - a ^ 2))

theorem det_elementaryDiagonal (i j : n) (hij : i ≠ j) (a : K) (ha : a ≠ 0) :
    (elementaryDiagonal (K := K) i j a).det = 1 := by
  rw [← transvection_prod_eq_elementaryDiagonal i j hij a ha]
  simp [Matrix.det_mul, Matrix.det_transvection_of_ne i j hij,
    Matrix.det_transvection_of_ne j i hij.symm]

/-! ## Unimodular diagonal matrices -/

/-- Clearing one nonunit diagonal entry at a time expresses every unimodular diagonal matrix as a
product of elementary transvections.  The auxiliary index set `s` bounds the support of the
nonunit entries and drives the induction. -/
theorem isTransvectionProduct_diagonal_aux :
    ∀ (m : ℕ) (D : n → K) (s : Finset n), (∀ i, D i ≠ 0) → (∏ i, D i = 1) →
      (∀ i ∉ s, D i = 1) → s.card ≤ m → IsTransvectionProduct (Matrix.diagonal D) := by
  intro m
  induction m with
  | zero =>
      intro D s _ _ hs hcard
      have hsempty : s = ∅ := Finset.card_eq_zero.1 (Nat.le_zero.1 hcard)
      subst hsempty
      have hD1 : D = fun _ => (1 : K) := funext fun i => hs i (by simp)
      subst hD1
      simpa using IsTransvectionProduct.one
  | succ m ih =>
      intro D s hD hprod hs hcard
      by_cases hall : ∀ i, D i = 1
      · have hD1 : D = fun _ => (1 : K) := funext hall
        subst hD1
        simpa using IsTransvectionProduct.one
      obtain ⟨i, hi⟩ := not_forall.1 hall
      have hiS : i ∈ s := by
        by_contra hnot
        exact hi (hs i hnot)
      have hex : ∃ j, j ≠ i ∧ D j ≠ 1 := by
        by_contra hcon
        have hcon' : ∀ b, b ≠ i → D b = 1 := by
          intro b hb
          by_contra hb1
          exact hcon ⟨b, hb, hb1⟩
        have hsingle : ∏ k, D k = D i :=
          Finset.prod_eq_single i (fun b _ hb => hcon' b hb) (by simp)
        exact hi (hsingle ▸ hprod)
      obtain ⟨j, hji, hj⟩ := hex
      have hij : i ≠ j := Ne.symm hji
      have hjS : j ∈ s := by
        by_contra hnot
        exact hj (hs j hnot)
      have ha : D i ≠ 0 := hD i
      set D' : n → K := Function.update (Function.update D j (D j * D i)) i 1 with hD'_def
      have hD'i : D' i = 1 := Function.update_self ..
      have hD'j : D' j = D j * D i := by
        rw [hD'_def, Function.update_of_ne hji, Function.update_self]
      have hD'ne_index : ∀ {k : n}, k ≠ i → k ≠ j → D' k = D k := by
        intro k hki hkj
        rw [hD'_def, Function.update_of_ne hki, Function.update_of_ne hkj]
      have hD'ne : ∀ k, D' k ≠ 0 := by
        intro k
        rcases eq_or_ne k i with rfl | hki
        · rw [hD'i]; exact one_ne_zero
        · rcases eq_or_ne k j with rfl | hkj
          · rw [hD'j]; exact mul_ne_zero (hD k) ha
          · rw [hD'ne_index hki hkj]; exact hD k
      have hsplit : Matrix.diagonal D =
          Matrix.diagonal D' * elementaryDiagonal i j (D i) := by
        rw [elementaryDiagonal, Matrix.diagonal_mul_diagonal]
        congr 1
        funext k
        rcases eq_or_ne k i with rfl | hki
        · rw [hD'i, elementaryWeight_left, one_mul]
        · rcases eq_or_ne k j with rfl | hkj
          · rw [hD'j, elementaryWeight_right i k (D i) hij, mul_assoc,
              mul_inv_cancel₀ ha, mul_one]
          · rw [hD'ne_index hki hkj, elementaryWeight_of_ne i j (D i) hki hkj, mul_one]
      have hprod' : ∏ k, D' k = 1 := by
        have hdetD : (Matrix.diagonal D).det = ∏ k, D k := Matrix.det_diagonal
        have hdetD' : (Matrix.diagonal D').det = ∏ k, D' k := Matrix.det_diagonal
        have hcong := congrArg Matrix.det hsplit
        rw [Matrix.det_mul, det_elementaryDiagonal i j hij (D i) ha, hdetD, hdetD',
          hprod, mul_one] at hcong
        exact hcong.symm
      have hs' : ∀ k ∉ s.erase i, D' k = 1 := by
        intro k hk
        rcases eq_or_ne k i with rfl | hki
        · exact hD'i
        · have hknot : k ∉ s := fun hks => hk (Finset.mem_erase.2 ⟨hki, hks⟩)
          have hkj : k ≠ j := fun h => hknot (h ▸ hjS)
          rw [hD'ne_index hki hkj]
          exact hs k hknot
      have hcard' : (s.erase i).card ≤ m := by
        have hcE := Finset.card_erase_of_mem hiS
        omega
      have hD'mem : IsTransvectionProduct (Matrix.diagonal D') :=
        ih D' (s.erase i) hD'ne hprod' hs' hcard'
      rw [hsplit]
      exact hD'mem.mul (IsTransvectionProduct.elementaryDiagonal i j hij (D i) ha)

/-- Every unimodular diagonal matrix over a field is a product of elementary transvections. -/
theorem isTransvectionProduct_diagonal (D : n → K) (hprod : ∏ i, D i = 1) :
    IsTransvectionProduct (Matrix.diagonal D) := by
  have hD : ∀ i, D i ≠ 0 := by
    intro i hi
    rw [Finset.prod_eq_zero (Finset.mem_univ i) hi] at hprod
    exact zero_ne_one hprod
  exact isTransvectionProduct_diagonal_aux (Finset.univ.card) D Finset.univ hD hprod
    (fun i hi => absurd (Finset.mem_univ i) hi) le_rfl

/-! ## Generation of the special linear group -/

/-- Every matrix of determinant one over a field is a product of elementary transvections. -/
theorem isTransvectionProduct_of_det_eq_one (M : Matrix n n K) (hM : M.det = 1) :
    IsTransvectionProduct M := by
  obtain ⟨L, L', D, hLD⟩ :=
    Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec M
  have hdetL : ((L.map Matrix.TransvectionStruct.toMatrix).prod).det = 1 :=
    Matrix.TransvectionStruct.det_toMatrix_prod L
  have hdetL' : ((L'.map Matrix.TransvectionStruct.toMatrix).prod).det = 1 :=
    Matrix.TransvectionStruct.det_toMatrix_prod L'
  have hprod : ∏ i, D i = 1 := by
    have hcong := congrArg Matrix.det hLD
    rw [hM, Matrix.det_mul, Matrix.det_mul, hdetL, hdetL', Matrix.det_diagonal,
      one_mul, mul_one] at hcong
    exact hcong.symm
  rw [hLD]
  exact ((IsTransvectionProduct.listProd L).mul
    (isTransvectionProduct_diagonal D hprod)).mul (IsTransvectionProduct.listProd L')

/-- **Transvection generation.**  Over any field, the elementary transvections generate the whole
special linear group. -/
theorem transvectionSubgroup_eq_top : transvectionSubgroup n K = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro g
  obtain ⟨h, hh, hcoe⟩ := isTransvectionProduct_of_det_eq_one (g : Matrix n n K) g.2
  have hgh : h = g := Matrix.SpecialLinearGroup.ext h g fun i j => by rw [hcoe]
  exact hgh ▸ hh

end GaloisForLFunctions.HTGeometry
