import GaloisForLFunctions.HTGeometry.MaurerCartanJetCoordinates
import GaloisForLFunctions.HTGeometry.FixedAdjoinIndependentDescent

/-!
# Fixed fields and images in Maurer–Cartan coordinates

Let `D` be a derivation basis of `F/C` and `ℓ` the Maurer–Cartan coordinates of the jet field
`K = F(ℓ^(k))`.  For a subset `T ⊆ F` put

`PV(T) = C(T, ℓ^(k) : k ≥ 0) ⊆ K`,

the field generated by the positions `T` and all velocity jets.

* **Fixed fields.**  For automorphisms `σ_i` of `F` commuting with every `D_j`, the fixed field of
  their differential extensions is `PV(F^σ)`: the extensions fix every `ℓ^(k)`, and an invariant
  quotient of polynomials in the independent `ℓ^(k)` has invariant coefficients.
* **Images.**  For a map `φ` whose chain-rule matrix is a constant invertible matrix `c`, the image
  of its differential extension is `PV(φ(F))`: `φ̃` acts on each `ℓ^(k)` by `c`.
* **Tails.**  If `φ^n(F)` is the fixed field of `Γ_n` for every `n` and the common fixed field of
  all `Γ_n` is that of `H`, then `⋂_n φ̃^n(K)` is the fixed field of `H` in `K`.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F : Type*} [Field F] {d : ℕ} {C : Type*} [Field C] [CharZero C] [Algebra C F]
variable {D : Fin d → Derivation C F F} {t : Fin d → F} (ht : IsTranscendenceBasis C t)

variable (D) in
/-- The position–velocity field `C(T, ℓ^(k))`. -/
def positionVelocityField (T : Set F) : IntermediateField C (FunctionJetField F d) :=
  IntermediateField.adjoin C
    (algebraMap F (FunctionJetField F d) '' T ∪ Set.range (maurerCartanJet (D := D) ht))

theorem maurerCartanJet_mem_positionVelocityField (T : Set F) (q : ℕ × Fin d) :
    maurerCartanJet (D := D) ht q ∈ positionVelocityField D ht T :=
  IntermediateField.subset_adjoin C _ (Or.inr ⟨q, rfl⟩)

theorem algebraMap_mem_positionVelocityField {T : Set F} {a : F} (ha : a ∈ T) :
    algebraMap F (FunctionJetField F d) a ∈ positionVelocityField D ht T :=
  IntermediateField.subset_adjoin C _ (Or.inl ⟨a, ha, rfl⟩)

theorem positionVelocityField_congr {T₁ T₂ : Set F} (h : T₁ = T₂) :
    positionVelocityField D ht T₁ = positionVelocityField D ht T₂ := by rw [h]

/-- A differential ring map of the jet field commutes with iterated derivatives. -/
theorem jetFieldExtension_iterate_deriv (φ : F →ₐ[C] F) (n : ℕ) (x : FunctionJetField F d) :
    jetFieldExtension ht φ (((jetFieldDerivation ht : FunctionJetField F d →
        FunctionJetField F d)^[n]) x) =
      ((jetFieldDerivation ht : FunctionJetField F d → FunctionJetField F d)^[n])
        (jetFieldExtension ht φ x) := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← ih,
        jetFieldExtension_deriv]

omit [CharZero C] in
/-- A polynomial in `y` whose coefficients lie in `T` evaluates into `C(T, y)`. -/
theorem aeval_mem_adjoin_of_coeff_mem {L : Type*} [Field L] [Algebra C L] [Algebra F L]
    [IsScalarTower C F L] {ι : Type*} (y : ι → L) (T : Set F) (P : MvPolynomial ι F)
    (hP : ∀ m, P.coeff m ∈ T) :
    aeval y P ∈ IntermediateField.adjoin C (algebraMap F L '' T ∪ Set.range y) := by
  rw [aeval_def, eval₂_eq]
  refine IntermediateField.sum_mem _ fun m _ => IntermediateField.mul_mem _ ?_ ?_
  · exact IntermediateField.subset_adjoin C _ (Or.inl ⟨_, hP m, rfl⟩)
  · exact IntermediateField.prod_mem _ fun i _ =>
      pow_mem (IntermediateField.subset_adjoin C (algebraMap F L '' T ∪ Set.range y)
        (Or.inr ⟨i, rfl⟩)) _

omit [CharZero C] in
/-- The chain-rule matrices multiply along powers. -/
theorem derivation_pow_eq_sum (φ : F →ₐ[C] F) (c : Matrix (Fin d) (Fin d) C)
    (hc : ∀ i f, D i (φ f) = ∑ j, algebraMap C F (c i j) * φ (D j f)) (n : ℕ) (i : Fin d)
    (f : F) : D i ((φ ^ n) f) = ∑ j, algebraMap C F ((c ^ n) i j) * (φ ^ n) (D j f) := by
  classical
  induction n generalizing f with
  | zero =>
      simp only [pow_zero, AlgHom.one_apply, Matrix.one_apply]
      simp
  | succ n ih =>
      rw [pow_succ, AlgHom.mul_apply, ih, pow_succ]
      simp only [hc, map_sum, map_mul, AlgHom.commutes, Matrix.mul_apply, Finset.mul_sum, map_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [Finset.sum_mul, AlgHom.mul_apply]
      exact Finset.sum_congr rfl fun j _ => by ring

variable (hD : (derivationMatrix D t).det ≠ 0)
include hD

/-- An automorphism commuting with the derivation basis fixes every velocity jet. -/
theorem jetFieldExtension_maurerCartanJet_of_commute (φ : F →ₐ[C] F)
    (hφ : ∀ i f, D i (φ f) = φ (D i f)) (q : ℕ × Fin d) :
    jetFieldExtension ht φ (maurerCartanJet (D := D) ht q) = maurerCartanJet (D := D) ht q := by
  rw [maurerCartanJet, jetFieldExtension_iterate_deriv,
    jetFieldExtension_maurerCartan_of_commute ht hD φ hφ]

/-- **Fixed fields in Maurer–Cartan coordinates.**  For automorphisms commuting with the
derivation basis, an element of `K` is fixed by all their extensions exactly when it lies in the
position–velocity field of the fixed field of `F`. -/
theorem fixed_iff_mem_positionVelocityField {I : Type*} (σ : I → F ≃ₐ[C] F)
    (hσ : ∀ x i f, D i (σ x f) = σ x (D i f)) (u : FunctionJetField F d) :
    (∀ x, jetFieldExtension ht (σ x).toAlgHom u = u) ↔
      u ∈ positionVelocityField D ht {a | ∀ x, σ x a = a} := by
  classical
  set K := FunctionJetField F d
  constructor
  · intro hu
    have hy := algebraicIndependent_maurerCartanJet ht hD
    obtain ⟨P, Q, hPfix, hQfix, -, rfl⟩ := exists_fixed_fraction_of_fixed
      (fun x => jetFieldExtensionEquiv ht (σ x)) (fun x => (σ x).toRingEquiv) hy
      (fun x a => jetFieldExtension_algebraMap ht _ a)
      (fun x q => jetFieldExtension_maurerCartanJet_of_commute ht hD _ (hσ x) q)
      (by rw [adjoin_maurerCartanJet_eq_top ht hD]; exact IntermediateField.mem_top) hu
    have hcoeff : ∀ (R : MvPolynomial (ℕ × Fin d) F),
        (∀ x, R.map ((σ x).toRingEquiv : F →+* F) = R) → ∀ m, R.coeff m ∈ {a | ∀ x, σ x a = a} := by
      intro R hR m x
      have h := congrArg (MvPolynomial.coeff m) (hR x)
      rw [MvPolynomial.coeff_map] at h
      exact h
    exact IntermediateField.div_mem _
      (aeval_mem_adjoin_of_coeff_mem _ _ P (hcoeff P hPfix))
      (aeval_mem_adjoin_of_coeff_mem _ _ Q (hcoeff Q hQfix))
  · intro hu x
    let S : IntermediateField C K :=
      { (jetFieldExtension ht (σ x).toAlgHom).eqLocusField (RingHom.id K) with
        algebraMap_mem' := fun c => jetFieldExtension_algebraMap_C ht _ c }
    have hle : positionVelocityField D ht {a | ∀ x, σ x a = a} ≤ S := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      rintro _ (⟨a, ha, rfl⟩ | ⟨q, rfl⟩)
      · change jetFieldExtension ht (σ x).toAlgHom (algebraMap F K a) = algebraMap F K a
        rw [jetFieldExtension_algebraMap]
        exact congrArg _ (ha x)
      · exact jetFieldExtension_maurerCartanJet_of_commute ht hD _ (hσ x) q
    exact hle hu

/-- A map with constant chain-rule matrix acts on every velocity jet by that matrix. -/
theorem jetFieldExtension_maurerCartanJet (φ : F →ₐ[C] F) (c : Matrix (Fin d) (Fin d) C)
    (hc : ∀ i f, D i (φ f) = ∑ j, algebraMap C F (c i j) * φ (D j f)) (k : ℕ) (j : Fin d) :
    jetFieldExtension ht φ (maurerCartanJet (D := D) ht (k, j)) =
      ∑ i, algebraMap C (FunctionJetField F d) (c i j) * maurerCartanJet (D := D) ht (k, i) := by
  rw [maurerCartanJet, jetFieldExtension_iterate_deriv,
    jetFieldExtension_maurerCartan ht hD φ (c.map (algebraMap C F)) hc]
  induction k with
  | zero =>
      simp only [Function.iterate_zero, id_eq, Matrix.map_apply, maurerCartanJet]
      exact Finset.sum_congr rfl fun i _ => by rw [← IsScalarTower.algebraMap_apply]
  | succ k ih =>
      rw [Function.iterate_succ_apply', ih, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Algebra.smul_def, Derivation.map_smul, Algebra.smul_def, maurerCartanJet,
        maurerCartanJet, Function.iterate_succ_apply']

include ht in
/-- The chain-rule matrix is unique. -/
theorem derivationPullbackMatrix_unique (φ : F →ₐ[C] F) (b : Matrix (Fin d) (Fin d) F)
    (hb : ∀ i f, D i (φ f) = ∑ j, b i j * φ (D j f)) : b = derivationPullbackMatrix D t φ := by
  ext i j
  have h := eq_zero_of_sum_mul_derivationMatrix hD φ.toRingHom
    (fun l => b i l - derivationPullbackMatrix D t φ i l) (fun k => by
      simp only [sub_mul, Finset.sum_sub_distrib, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [← hb, ← derivation_comp_eq_sum ht hD, sub_self])
  exact sub_eq_zero.mp (congrFun h j)

include ht in
/-- **Equivariance makes the chain-rule matrix constant.**  If `φ ∘ σ_(βx) = σ_x ∘ φ` for
automorphisms `σ_x` commuting with the derivation basis, the entries of the chain-rule matrix of
`φ` are fixed by every `σ_x`; when the common fixed field is `C` they are constants. -/
theorem exists_const_derivationPullbackMatrix {P : Type*} (σ : P → F ≃ₐ[C] F) (β : P → P)
    (hσ : ∀ x i f, D i (σ x f) = σ x (D i f)) (φ : F →ₐ[C] F)
    (hφσ : ∀ x f, φ (σ (β x) f) = σ x (φ f))
    (hconst : ∀ a, (∀ x, σ x a = a) → a ∈ Set.range (algebraMap C F)) :
    ∃ c : Matrix (Fin d) (Fin d) C, derivationPullbackMatrix D t φ = c.map (algebraMap C F) := by
  have hfix : ∀ x i j, σ x (derivationPullbackMatrix D t φ i j) =
      derivationPullbackMatrix D t φ i j := by
    intro x
    have h := derivationPullbackMatrix_unique ht hD φ ((derivationPullbackMatrix D t φ).map (σ x))
      (fun i f => by
        obtain ⟨g, rfl⟩ := (σ (β x)).surjective f
        rw [hφσ, hσ, derivation_comp_eq_sum ht hD φ i g, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, Matrix.map_apply, ← hφσ, ← hσ])
    intro i j
    exact congrFun (congrFun h i) j
  choose c hc using fun i j => hconst _ fun x => hfix x i j
  exact ⟨Matrix.of c, by ext i j; exact (hc i j).symm⟩

/-- **Images in Maurer–Cartan coordinates.**  If the chain-rule matrix of `φ` is a constant
invertible matrix, the image of its differential extension is the position–velocity field of
`φ(F)`. -/
theorem mem_range_iff_mem_positionVelocityField (φ : F →ₐ[C] F) (c : Matrix (Fin d) (Fin d) C)
    (hc : ∀ i f, D i (φ f) = ∑ j, algebraMap C F (c i j) * φ (D j f)) (hcdet : c.det ≠ 0)
    (u : FunctionJetField F d) :
    u ∈ Set.range (jetFieldExtension ht φ) ↔ u ∈ positionVelocityField D ht (Set.range φ) := by
  classical
  set V := positionVelocityField D ht (Set.range φ)
  constructor
  · rintro ⟨v, rfl⟩
    let W : IntermediateField F (FunctionJetField F d) :=
      (V.toSubfield.comap (jetFieldExtension ht φ)).toIntermediateField fun a => by
        change jetFieldExtension ht φ (algebraMap F (FunctionJetField F d) a) ∈ V
        rw [jetFieldExtension_algebraMap]
        exact algebraMap_mem_positionVelocityField ht ⟨a, rfl⟩
    have hle : IntermediateField.adjoin F (Set.range (maurerCartanJet (D := D) ht)) ≤ W := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨⟨k, j⟩, rfl⟩
      change jetFieldExtension ht φ (maurerCartanJet (D := D) ht (k, j)) ∈ V
      rw [jetFieldExtension_maurerCartanJet ht hD φ c hc]
      exact V.sum_mem fun i _ => V.mul_mem (V.algebraMap_mem _)
        (maurerCartanJet_mem_positionVelocityField ht _ _)
    rw [adjoin_maurerCartanJet_eq_top ht hD, top_le_iff] at hle
    have hv : v ∈ W := by rw [hle]; exact IntermediateField.mem_top
    exact hv
  · intro hu
    let R : IntermediateField C (FunctionJetField F d) :=
      { (jetFieldExtension ht φ).fieldRange with
        algebraMap_mem' := fun c' => ⟨algebraMap C (FunctionJetField F d) c', jetFieldExtension_algebraMap_C ht φ c'⟩ }
    have hinv : c * c⁻¹ = 1 := Matrix.mul_nonsing_inv c (isUnit_iff_ne_zero.mpr hcdet)
    have hle : V ≤ R := by
      refine IntermediateField.adjoin_le_iff.mpr ?_
      rintro _ (⟨_, ⟨a, rfl⟩, rfl⟩ | ⟨⟨k, i⟩, rfl⟩)
      · exact ⟨algebraMap F (FunctionJetField F d) a, jetFieldExtension_algebraMap ht φ a⟩
      · refine ⟨∑ j, algebraMap C (FunctionJetField F d) (c⁻¹ j i) * maurerCartanJet (D := D) ht (k, j), ?_⟩
        rw [map_sum]
        simp only [map_mul, jetFieldExtension_algebraMap_C, jetFieldExtension_maurerCartanJet ht hD
          φ c hc, Finset.mul_sum]
        rw [Finset.sum_comm]
        have hcol : ∀ l, ∑ j, algebraMap C (FunctionJetField F d) (c⁻¹ j i) * (algebraMap C (FunctionJetField F d) (c l j) *
            maurerCartanJet (D := D) ht (k, l)) =
            algebraMap C (FunctionJetField F d) ((c * c⁻¹) l i) * maurerCartanJet (D := D) ht (k, l) := by
          intro l
          rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
          exact Finset.sum_congr rfl fun j _ => by rw [map_mul]; ring
        rw [Finset.sum_congr rfl fun l _ => hcol l, hinv, Finset.sum_eq_single i]
        · rw [Matrix.one_apply_eq, map_one, one_mul]
        · intro l _ hl
          rw [Matrix.one_apply_ne hl, map_zero, zero_mul]
        · intro hi
          exact absurd (Finset.mem_univ i) hi
    obtain ⟨v, hv⟩ := hle hu
    exact ⟨v, hv⟩

/-- **The tail theorem in Maurer–Cartan coordinates.**  Let automorphisms `σ_x` of `F` commute
with the derivation basis, let `φ` have a constant invertible chain-rule matrix, and suppose that
`φ^n(F)` is the fixed field of `Γ_n` for every `n` and that the common fixed field of all `Γ_n`
is the fixed field of `H`.  Then the elements of `K` lying in every image `φ̃^n(K)` are exactly
the elements fixed by the extensions of all `σ_x`, `x ∈ H`. -/
theorem mem_tail_iff_fixed {P : Type*} (σ : P → F ≃ₐ[C] F)
    (hσ : ∀ x i f, D i (σ x f) = σ x (D i f)) (φ : F →ₐ[C] F) (c : Matrix (Fin d) (Fin d) C)
    (hc : ∀ i f, D i (φ f) = ∑ j, algebraMap C F (c i j) * φ (D j f)) (hcdet : c.det ≠ 0)
    (Γ : ℕ → Set P) (H : Set P)
    (hlevel : ∀ n a, a ∈ Set.range ⇑(φ ^ n) ↔ ∀ x ∈ Γ n, σ x a = a)
    (hclosure : ∀ a, (∀ n, ∀ x ∈ Γ n, σ x a = a) ↔ ∀ x ∈ H, σ x a = a)
    (u : FunctionJetField F d) :
    (∀ n, u ∈ Set.range ((⇑(jetFieldExtension ht φ))^[n])) ↔
      ∀ x ∈ H, jetFieldExtension ht (σ x).toAlgHom u = u := by
  have hpow : ∀ n, (c ^ n).det ≠ 0 := fun n => by rw [Matrix.det_pow]; exact pow_ne_zero n hcdet
  have hlevel' : ∀ n, u ∈ Set.range ((⇑(jetFieldExtension ht φ))^[n]) ↔
      ∀ x : Γ n, jetFieldExtension ht (σ x).toAlgHom u = u := by
    intro n
    have hr : Set.range ((⇑(jetFieldExtension ht φ))^[n]) =
        Set.range (jetFieldExtension ht (φ ^ n)) := by
      ext v
      simp only [Set.mem_range, jetFieldExtension_pow]
    rw [hr, mem_range_iff_mem_positionVelocityField ht hD (φ ^ n) (c ^ n)
      (derivation_pow_eq_sum φ c hc n) (hpow n),
      fixed_iff_mem_positionVelocityField ht hD (fun x : Γ n => σ x) (fun x => hσ x)]
    exact Iff.of_eq (congrArg (u ∈ ·) (positionVelocityField_congr ht
      (Set.ext fun a => (hlevel n a).trans ⟨fun h x => h x x.2, fun h x hx => h ⟨x, hx⟩⟩)))
  simp only [hlevel']
  have hall : (∀ n, ∀ x : Γ n, jetFieldExtension ht (σ x).toAlgHom u = u) ↔
      ∀ x : (Σ n, Γ n), jetFieldExtension ht (σ x.2).toAlgHom u = u :=
    ⟨fun h x => h x.1 x.2, fun h n x => h ⟨n, x⟩⟩
  rw [hall, fixed_iff_mem_positionVelocityField ht hD (fun x : (Σ n, Γ n) => σ x.2)
    (fun x => hσ x.2)]
  have hH : (∀ x ∈ H, jetFieldExtension ht (σ x).toAlgHom u = u) ↔
      ∀ x : H, jetFieldExtension ht (σ x).toAlgHom u = u :=
    ⟨fun h x => h x x.2, fun h x hx => h ⟨x, hx⟩⟩
  rw [hH, fixed_iff_mem_positionVelocityField ht hD (fun x : H => σ x) (fun x => hσ x)]
  refine Iff.of_eq (congrArg (u ∈ ·) (positionVelocityField_congr ht (Set.ext fun a => ?_)))
  change (∀ x : (Σ n, Γ n), σ x.2 a = a) ↔ ∀ x : H, σ x a = a
  rw [← (show (∀ x ∈ H, σ x a = a) ↔ ∀ x : H, σ x a = a from
    ⟨fun h x => h x x.2, fun h x hx => h ⟨x, hx⟩⟩), ← hclosure]
  exact ⟨fun h n x hx => h ⟨n, x, hx⟩, fun h x => h x.1 x.2 x.2.2⟩

end

end GaloisForLFunctions.HTGeometry
