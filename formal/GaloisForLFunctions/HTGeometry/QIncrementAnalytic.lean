import GaloisForLFunctions.HTGeometry.QIncrement
import GaloisForLFunctions.HTGeometry.QGammaBellSubstitution

/-!
# Closed form of the jets of the q-digamma shift law

The logarithmic derivative of Jackson's multiplier is `−(log q)·q^z/(1 − q^z)`, and every one of
its `z`-derivatives is again a rational function of `q^z`: the `j`-th one is `A_j(q^z)/(1−q^z)^{j+1}`
with `A_j` the polynomials generated by `A_0 = −(log q)·u`, `A_{j+1} = (log q)·u·(A_j'·(1−u) +
(j+1)·A_j)`.  Differentiating under `du/dz = (log q)·u` reproduces exactly that recursion, so the
analytic jets of the shift law are the images of the algebraic increments `δ_j = A_j(u)/(1−u)^{j+1}`
of `ℂ(z,u)` under `u ↦ q^z`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial Filter Topology

noncomputable section

/-- The closed form of the `j`-th jet of the shift increment: `A_j(q^z)/(1 − q^z)^{j+1}`. -/
def qIncrFun (q : RealEulerNome) (j : ℕ) (z : ℂ) : ℂ :=
  (qIncrNum q j).eval ((q.val : ℂ) ^ z) / (1 - (q.val : ℂ) ^ z) ^ (j + 1)

theorem qIncrFun_zero (q : RealEulerNome) (z : ℂ) :
    qIncrFun q 0 z = qShiftIncrement q z := by
  rw [qIncrFun, qIncrNum_zero, qShiftIncrement]
  simp only [Polynomial.eval_mul, Polynomial.eval_neg, Polynomial.eval_C, Polynomial.eval_X,
    qLog, neg_mul, zero_add, pow_one]

/-- Differentiating the closed form raises the index by one. -/
theorem hasDerivAt_qIncrFun (q : RealEulerNome) (j : ℕ) {z : ℂ} (hz : z ∈ qHalfPlane) :
    HasDerivAt (qIncrFun q j) (qIncrFun q (j + 1) z) z := by
  set u : ℂ := (q.val : ℂ) ^ z with hu_def
  have hv : (1 : ℂ) - u ≠ 0 := qcpow_ne_one q hz
  have hcp : HasDerivAt (fun w : ℂ => (q.val : ℂ) ^ w) (u * qLog q) z := by
    simpa [hu_def, qLog] using hasDerivAt_qcpow q z
  have hnum : HasDerivAt (fun w : ℂ => (qIncrNum q j).eval ((q.val : ℂ) ^ w))
      ((Polynomial.derivative (qIncrNum q j)).eval u * (u * qLog q)) z := by
    have hpoly : HasDerivAt (fun x : ℂ => (qIncrNum q j).eval x)
        ((Polynomial.derivative (qIncrNum q j)).eval u) u := (qIncrNum q j).hasDerivAt u
    exact hpoly.comp z hcp
  have hden : HasDerivAt (fun w : ℂ => (1 - (q.val : ℂ) ^ w) ^ (j + 1))
      (((j + 1 : ℕ) : ℂ) * (1 - u) ^ j * (-(u * qLog q))) z :=
    (hcp.const_sub (1 : ℂ)).pow (j + 1)
  have hval : ((Polynomial.derivative (qIncrNum q j)).eval u * (u * qLog q) * (1 - u) ^ (j + 1)
        - (qIncrNum q j).eval u * (((j + 1 : ℕ) : ℂ) * (1 - u) ^ j * (-(u * qLog q))))
        / ((1 - u) ^ (j + 1)) ^ (2 : ℕ)
      = qIncrFun q (j + 1) z := by
    rw [qIncrFun, qIncrNum_succ, ← hu_def]
    simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_C,
      Polynomial.eval_X, Polynomial.eval_one]
    rw [div_eq_div_iff (pow_ne_zero _ (pow_ne_zero _ hv)) (pow_ne_zero _ hv)]
    push_cast
    ring
  have hd := hnum.div hden (pow_ne_zero _ hv)
  rw [hval] at hd
  exact hd

/-- **The jets of the shift increment are the algebraic increments evaluated at `u = q^z`.** -/
theorem iteratedDeriv_qShiftIncrement (q : RealEulerNome) (j : ℕ) {z : ℂ}
    (hz : z ∈ qHalfPlane) :
    iteratedDeriv j (qShiftIncrement q) z = qIncrFun q j z := by
  induction j generalizing z with
  | zero => rw [iteratedDeriv_zero, qIncrFun_zero]
  | succ j ih =>
    have hev : iteratedDeriv j (qShiftIncrement q) =ᶠ[𝓝 z] qIncrFun q j := by
      filter_upwards [isOpen_qHalfPlane.mem_nhds hz] with w hw using ih hw
    rw [iteratedDeriv_succ, hev.deriv_eq, (hasDerivAt_qIncrFun q j hz).deriv]

/-- **The closed-form differentiated q-digamma shift law.** -/
theorem iteratedDeriv_qDigamma_shift_closed (q : RealEulerNome) (j : ℕ) {z : ℂ}
    (hz : z ∈ qHalfPlane) :
    iteratedDeriv j (qDigamma q) (z + 1)
      = iteratedDeriv j (qDigamma q) z
        + (qIncrNum q j).eval ((q.val : ℂ) ^ z) / (1 - (q.val : ℂ) ^ z) ^ (j + 1) := by
  rw [iteratedDeriv_qDigamma_shift q j hz, iteratedDeriv_qShiftIncrement q j hz, qIncrFun]

end

end GaloisForLFunctions.HTGeometry
