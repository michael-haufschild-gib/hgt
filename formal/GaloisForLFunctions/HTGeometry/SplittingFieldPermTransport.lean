import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.Tactic

/-!
# Transporting a realized permutation back to the splitting field

A deformation realizes a permutation of the roots inside an auxiliary field, one that depends on
which variable was kept in the base.  What the Galois statement needs is an automorphism of a single
field — the one generated by the roots.  Because that field is generated by them, an embedding and
its composite with the auxiliary automorphism have the same range, so the automorphism descends.

## Main results

* `exists_algEquiv_of_embedding` — the descended automorphism.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Classical

/-- **A permutation realized in an auxiliary field descends to the field generated by the roots.** -/
theorem exists_algEquiv_of_embedding
    {K E Ω : Type*} [Field K] [Field E] [Field Ω] [Algebra K E] [Algebra K Ω]
    {ι : Type*} {θ : ι → E} (hgen : IntermediateField.adjoin K (Set.range θ) = ⊤)
    (ψ : E →ₐ[K] Ω) (τ : Ω ≃ₐ[K] Ω) {π : Equiv.Perm ι}
    (hτ : ∀ x, τ (ψ (θ x)) = ψ (θ (π x))) :
    ∃ σ : E ≃ₐ[K] E, ∀ x, σ (θ x) = θ (π x) := by
  classical
  set χ : E →ₐ[K] Ω := (τ.toAlgHom.comp ψ) with hχ
  have hχapply : ∀ y, χ y = τ (ψ y) := fun y => rfl
  have himage : (⇑χ) '' Set.range θ = (⇑ψ) '' Set.range θ := by
    ext w
    constructor
    · rintro ⟨-, ⟨x, rfl⟩, rfl⟩
      exact ⟨θ (π x), ⟨π x, rfl⟩, by rw [hχapply, hτ x]⟩
    · rintro ⟨-, ⟨x, rfl⟩, rfl⟩
      refine ⟨θ (π.symm x), ⟨π.symm x, rfl⟩, ?_⟩
      rw [hχapply, hτ (π.symm x), Equiv.apply_symm_apply]
  have hfield : χ.fieldRange = ψ.fieldRange := by
    rw [AlgHom.fieldRange_eq_map, AlgHom.fieldRange_eq_map, ← hgen,
      IntermediateField.adjoin_map, IntermediateField.adjoin_map, himage]
  have hrange : χ.range = ψ.range := congrArg IntermediateField.toSubalgebra hfield
  refine ⟨((AlgEquiv.ofInjectiveField χ).trans
    (Subalgebra.equivOfEq _ _ hrange)).trans (AlgEquiv.ofInjectiveField ψ).symm, ?_⟩
  intro x
  have hval : ((AlgEquiv.ofInjectiveField χ).trans
      (Subalgebra.equivOfEq _ _ hrange)) (θ x)
      = (AlgEquiv.ofInjectiveField ψ) (θ (π x)) := by
    apply Subtype.ext
    show χ (θ x) = ψ (θ (π x))
    rw [hχapply, hτ x]
  show (AlgEquiv.ofInjectiveField ψ).symm
    (((AlgEquiv.ofInjectiveField χ).trans (Subalgebra.equivOfEq _ _ hrange)) (θ x)) = θ (π x)
  rw [hval, AlgEquiv.symm_apply_apply]

/-- **Two labelled generating families with the same image are isomorphic over the base.**  This
identifies the field generated by a canonical root family with the one generated by a deformation
picture of it. -/
theorem exists_algEquiv_of_matching_embeddings
    {K E E' Ω : Type*} [Field K] [Field E] [Field E'] [Field Ω]
    [Algebra K E] [Algebra K E'] [Algebra K Ω]
    {ι : Type*} {θ : ι → E} {θ' : ι → E'}
    (hgen : IntermediateField.adjoin K (Set.range θ) = ⊤)
    (hgen' : IntermediateField.adjoin K (Set.range θ') = ⊤)
    (ψ : E →ₐ[K] Ω) (ψ' : E' →ₐ[K] Ω)
    (hmatch : ∀ x, ψ (θ x) = ψ' (θ' x)) :
    ∃ e : E ≃ₐ[K] E', ∀ x, e (θ x) = θ' x := by
  classical
  have himage : (⇑ψ) '' Set.range θ = (⇑ψ') '' Set.range θ' := by
    ext w
    constructor
    · rintro ⟨-, ⟨x, rfl⟩, rfl⟩
      exact ⟨θ' x, ⟨x, rfl⟩, (hmatch x).symm⟩
    · rintro ⟨-, ⟨x, rfl⟩, rfl⟩
      exact ⟨θ x, ⟨x, rfl⟩, hmatch x⟩
  have hfield : ψ.fieldRange = ψ'.fieldRange := by
    rw [AlgHom.fieldRange_eq_map, AlgHom.fieldRange_eq_map, ← hgen, ← hgen',
      IntermediateField.adjoin_map, IntermediateField.adjoin_map, himage]
  have hrange : ψ.range = ψ'.range := congrArg IntermediateField.toSubalgebra hfield
  refine ⟨((AlgEquiv.ofInjectiveField ψ).trans
    (Subalgebra.equivOfEq _ _ hrange)).trans (AlgEquiv.ofInjectiveField ψ').symm, ?_⟩
  intro x
  have hval : ((AlgEquiv.ofInjectiveField ψ).trans
      (Subalgebra.equivOfEq _ _ hrange)) (θ x)
      = (AlgEquiv.ofInjectiveField ψ') (θ' x) := by
    apply Subtype.ext
    exact hmatch x
  show (AlgEquiv.ofInjectiveField ψ').symm
    (((AlgEquiv.ofInjectiveField ψ).trans (Subalgebra.equivOfEq _ _ hrange)) (θ x)) = θ' x
  rw [hval, AlgEquiv.symm_apply_apply]

/-- Transporting a realized permutation across a label-matching isomorphism. -/
theorem realized_of_algEquiv_transport
    {K E E' : Type*} [Field K] [Field E] [Field E'] [Algebra K E] [Algebra K E']
    {ι : Type*} {θ : ι → E} {θ' : ι → E'} {π : Equiv.Perm ι}
    (e : E ≃ₐ[K] E') (he : ∀ x, e (θ x) = θ' x)
    (σ' : E' ≃ₐ[K] E') (hσ' : ∀ x, σ' (θ' x) = θ' (π x)) :
    ∃ σ : E ≃ₐ[K] E, ∀ x, σ (θ x) = θ (π x) := by
  refine ⟨(e.trans σ').trans e.symm, fun x => ?_⟩
  show e.symm (σ' (e (θ x))) = θ (π x)
  rw [he x, hσ' x, ← he (π x), AlgEquiv.symm_apply_apply]

end GaloisForLFunctions.HTGeometry
