import GaloisForLFunctions.HTGeometry.QuotientIdealDivisor
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Ideal.Quotient.Nilpotent
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# The dimension of a polynomial quotient and of its ideals

The quotient by a nonzero polynomial has dimension its degree; the ideal generated by a divisor has
dimension the difference of the degrees, because the quotient by that ideal is the quotient by the
divisor.

This is the bookkeeping that selects, among the ideals of `K[t]/(f)`, the ones of a given dimension —
equivalently, among the shift-invariant subspaces, the ones of a given dimension.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K : Type*} [Field K]

/-- **The quotient by a nonzero polynomial has dimension its degree.** -/
theorem finrank_polynomialQuotient {f : K[X]} (hf : f ≠ 0) :
    Module.finrank K (K[X] ⧸ Ideal.span ({f} : Set K[X])) = f.natDegree := by
  show Module.finrank K (AdjoinRoot f) = f.natDegree
  rw [PowerBasis.finrank (AdjoinRoot.powerBasis hf), AdjoinRoot.powerBasis_dim]

theorem finiteDimensional_polynomialQuotient {f : K[X]} (hf : f ≠ 0) :
    FiniteDimensional K (K[X] ⧸ Ideal.span ({f} : Set K[X])) :=
  (AdjoinRoot.powerBasis hf).finite

/-- **The ideal generated by a divisor has the complementary dimension.** -/
theorem finrank_ideal_add_natDegree_of_dvd {f g : K[X]} (hf : f ≠ 0) (hg : g ∣ f) :
    Module.finrank K
        (Submodule.restrictScalars K
          (Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span ({f} : Set K[X])))
            (Ideal.span ({g} : Set K[X]))))
      + g.natDegree = f.natDegree := by
  classical
  haveI := finiteDimensional_polynomialQuotient hf
  have hg0 : g ≠ 0 := by
    intro hcon
    rw [hcon] at hg
    exact hf (zero_dvd_iff.1 hg)
  have hle : Ideal.span ({f} : Set K[X]) ≤ Ideal.span ({g} : Set K[X]) :=
    Ideal.span_singleton_le_span_singleton.2 hg
  set I : Ideal (K[X] ⧸ Ideal.span ({f} : Set K[X])) :=
    Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span ({f} : Set K[X]))) (Ideal.span ({g} : Set K[X]))
    with hI
  have hquot : Module.finrank K ((K[X] ⧸ Ideal.span ({f} : Set K[X])) ⧸ I) = g.natDegree := by
    have hequiv := DoubleQuot.quotQuotEquivQuotOfLEₐ K hle
    rw [(hequiv.toLinearEquiv).finrank_eq, finrank_polynomialQuotient hg0]
  have hsum := Submodule.finrank_quotient_add_finrank
    (R := K) (M := K[X] ⧸ Ideal.span ({f} : Set K[X])) (Submodule.restrictScalars K I)
  rw [finrank_polynomialQuotient hf] at hsum
  have hquot' : Module.finrank K
      ((K[X] ⧸ Ideal.span ({f} : Set K[X])) ⧸ Submodule.restrictScalars K I) = g.natDegree := hquot
  rw [hquot'] at hsum
  omega

end GaloisForLFunctions.HTGeometry
