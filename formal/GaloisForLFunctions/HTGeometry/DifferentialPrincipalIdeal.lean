import GaloisForLFunctions.HTGeometry.ParameterizedDifferenceGalois

/-!
# Differential principal ideals

The ideal generated by every iterated derivative of one element is the smallest
derivation-stable ideal containing that element.  A commuting automorphism fixing the generator
preserves this ideal, making it a canonical source of proper `σ`-`δ` ideals.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential

variable {R S : Type*} [CommRing R] [Differential R]

/-- Ideal generated by every iterated derivative of one element. -/
def derivationIterateIdeal (p : R) : Ideal R :=
  Ideal.span (Set.range fun n : ℕ => (Differential.deriv^[n]) p)

theorem iterate_deriv_mem_derivationIterateIdeal (p : R) (n : ℕ) :
    (Differential.deriv^[n]) p ∈ derivationIterateIdeal p :=
  Ideal.subset_span ⟨n, rfl⟩

/-- The differential principal ideal is stable under the derivation. -/
theorem deriv_mem_derivationIterateIdeal {p x : R}
    (hx : x ∈ derivationIterateIdeal p) :
    Differential.deriv x ∈ derivationIterateIdeal p := by
  change x ∈ Submodule.span R
    (Set.range fun n : ℕ => (Differential.deriv^[n]) p) at hx
  refine Submodule.span_induction (hx := hx) ?_ ?_ ?_ ?_
  · rintro _ ⟨n, rfl⟩
    simpa only [Function.iterate_succ_apply'] using
      iterate_deriv_mem_derivationIterateIdeal p (n + 1)
  · simp
  · intro a b _ _ ha hb
    simpa using (derivationIterateIdeal p).add_mem ha hb
  · intro a x hx hdx
    rw [show a • x = a * x by simp, Derivation.leibniz]
    simpa [smul_eq_mul] using
      (derivationIterateIdeal p).add_mem
        ((derivationIterateIdeal p).mul_mem_left a hdx)
        ((derivationIterateIdeal p).mul_mem_right (Differential.deriv a) hx)

/-- A commuting automorphism fixing the generator preserves its differential principal ideal. -/
theorem isSigmaDeltaIdeal_derivationIterateIdeal_of_fixed
    {σ : R ≃+* R} (hσ : CommutesDeriv σ) {p : R} (hp : σ p = p) :
    IsSigmaDeltaIdeal σ (derivationIterateIdeal p) := by
  have hiter : ∀ n : ℕ, σ ((Differential.deriv^[n]) p) =
      (Differential.deriv^[n]) p := by
    intro n
    induction n with
    | zero => simpa using hp
    | succ n hn =>
        rw [Function.iterate_succ_apply', hσ, hn]
  refine ⟨?_, fun x hx => deriv_mem_derivationIterateIdeal hx⟩
  intro x hx
  change x ∈ Submodule.span R
    (Set.range fun n : ℕ => (Differential.deriv^[n]) p) at hx
  refine Submodule.span_induction (hx := hx) ?_ ?_ ?_ ?_
  · rintro _ ⟨n, rfl⟩
    rw [hiter]
    exact iterate_deriv_mem_derivationIterateIdeal p n
  · simp
  · intro a b _ _ ha hb
    simpa using (derivationIterateIdeal p).add_mem ha hb
  · intro a x _ hσx
    simpa [smul_eq_mul] using
      (derivationIterateIdeal p).mul_mem_left (σ a) hσx

/-- The differential principal ideal lies in every derivation-stable ideal containing its
generator. -/
theorem derivationIterateIdeal_le_of_derivation_stable {p : R} {I : Ideal R}
    (hp : p ∈ I) (hstable : ∀ x ∈ I, Differential.deriv x ∈ I) :
    derivationIterateIdeal p ≤ I := by
  rw [derivationIterateIdeal, Ideal.span_le]
  rintro _ ⟨n, rfl⟩
  induction n with
  | zero => exact hp
  | succ n hn =>
      change ((Differential.deriv^[Nat.succ n]) p) ∈ I
      rw [Function.iterate_succ_apply']
      exact hstable _ hn

/-- A differential evaluation killing the generator proves the differential principal ideal
proper. -/
theorem derivationIterateIdeal_ne_top_of_ringHom
    [CommRing S] [Nontrivial S] [Differential S]
    (f : R →+* S) (hf : ∀ x : R,
      f (Differential.deriv x) = Differential.deriv (f x))
    {p : R} (hp : f p = 0) : derivationIterateIdeal p ≠ ⊤ := by
  have hle : derivationIterateIdeal p ≤ RingHom.ker f :=
    derivationIterateIdeal_le_of_derivation_stable hp (fun x hx => by
      change f (Differential.deriv x) = 0
      rw [hf, show f x = 0 from hx, map_zero])
  intro htop
  have h1 : (1 : R) ∈ RingHom.ker f := hle (by rw [htop]; trivial)
  change f 1 = 0 at h1
  rw [map_one] at h1
  exact one_ne_zero h1

end

end GaloisForLFunctions.HTGeometry
