import GaloisForLFunctions.HTGeometry.GomesFormalTwoChainLinearization

/-!
# Sharp generated-algebra classification for every affine reflection

Changing the reflection center adds a translation already available from the
formal differentiation calculus. Thus the exact generated algebra is independent
of the center and equals the constant-line subalgebra in all cases.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- Parity is recoverable inside the algebra generated by D and any affine reflection. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_parity_mem (c : K) :
    gomesPolynomialReflectionMatrix K 0 ∈ gomesDerivativeReflectionGeneratedAlgebra K c := by
  rw [← gomesPolynomialReflectionMatrix_mul_inverse_translation K c]
  exact (gomesDerivativeReflectionGeneratedAlgebra K c).mul_mem
    (gomesDerivativeReflectionGeneratedAlgebra_reflection_mem K c)
    (gomesFormalSeriesMatrix_mem_derivativeReflectionGeneratedAlgebra K c _)

/-- The zero-center algebra is contained in every affine-center generated algebra. -/
theorem gomesDerivativeParityGeneratedAlgebra_le (c : K) :
    gomesDerivativeReflectionGeneratedAlgebra K 0 ≤ gomesDerivativeReflectionGeneratedAlgebra K c := by
  apply Algebra.adjoin_le
  intro M hM
  rcases hM with rfl | hM
  · exact gomesDerivativeReflectionGeneratedAlgebra_derivative_mem K c
  · rcases hM with rfl
    exact gomesDerivativeReflectionGeneratedAlgebra_parity_mem K c

/-- For every center, D and reflection generate precisely the constant-line algebra over the scalar center. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine (c : K) :
    gomesDerivativeReflectionGeneratedAlgebra K c = gomesFormalConstantLineOrder K := by
  apply le_antisymm (gomesDerivativeReflectionGeneratedAlgebra_le_constantLine K c)
  rw [← gomesDerivativeParityGeneratedAlgebra_eq_constantLine]
  exact gomesDerivativeParityGeneratedAlgebra_le K c

/-- The entire generated algebra is independent of the reflection center. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_center_independent (c d : K) :
    gomesDerivativeReflectionGeneratedAlgebra K c = gomesDerivativeReflectionGeneratedAlgebra K d := by
  rw [gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine,
    gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine]

/-- Exact generated-algebra membership is the divisibility of the single lower-left entry. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_mem_iff_X_dvd
    (c : K) (M : Matrix (Fin 2) (Fin 2) (PowerSeries K)) :
    M ∈ gomesDerivativeReflectionGeneratedAlgebra K c ↔ (PowerSeries.X : PowerSeries K) ∣ M 1 0 := by
  rw [gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine,
    gomesFormalConstantLineOrder_mem_iff_X_dvd]

/-- Even with all scalar formal functions available, D and reflection do not generate the full commutant. -/
theorem gomesDerivativeReflectionGeneratedAlgebra_ne_top (c : K) :
    gomesDerivativeReflectionGeneratedAlgebra K c ≠ ⊤ := by
  rw [gomesDerivativeReflectionGeneratedAlgebra_eq_constantLine]
  exact gomesFormalConstantLineOrder_ne_top K

end GaloisForLFunctions.HTGeometry
