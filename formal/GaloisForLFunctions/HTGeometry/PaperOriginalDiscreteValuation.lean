import GaloisForLFunctions.HTGeometry.PaperOriginalValuation
import Mathlib.RingTheory.Valuation.Discrete.Basic

/-!+# A discrete valuation ring with the source polynomial as uniformizer

The actual degeneration valuation is nontrivial and has the full integer value
group. Its valuation ring is a DVR, and its maximal ideal is generated by the
literal source polynomial in the native four-variable rational function field.
-/

namespace GaloisForLFunctions.HTGeometry

open StableCoordinate

noncomputable section

instance paperRationalValuationNontrivial : paperRationalValuation.IsNontrivial := by
  refine ⟨algebraMap (R 4) (FreeCoordinateRationalField ℂ (Fin 4)) f, ?_, ?_⟩
  · rw [paperRationalValuation_algebraMap, paperOriginalValuation_f]
    exact WithZero.coe_ne_zero
  · rw [paperRationalValuation_algebraMap, paperOriginalValuation_f]
    intro h
    have hm : Multiplicative.ofAdd (-1 : ℤ) = (1 : Multiplicative ℤ) :=
      WithZero.coe_injective h
    exact (neg_ne_zero.mpr one_ne_zero : (-1 : ℤ) ≠ 0) (ofAdd_eq_one.mp hm)

instance paperRationalValuationDiscrete : paperRationalValuation.IsRankOneDiscrete :=
  inferInstance

/-- The constructed local subring is an actual discrete valuation ring. -/
instance paperOriginalDiscreteValuationRing : IsDiscreteValuationRing paperRationalValuationRing := by
  change IsDiscreteValuationRing paperRationalValuation.valuationSubring
  infer_instance

/-- The literal source polynomial is a uniformizer for the field valuation. -/
theorem paperOriginalPolynomial_isUniformizer :
    paperRationalValuation.IsUniformizer
      (algebraMap (R 4) (FreeCoordinateRationalField ℂ (Fin 4)) f) := by
  rw [Valuation.IsUniformizer.iff,
    Valuation.IsRankOneDiscrete.generator_eq_exp_neg_one_of_surjective
      paperRationalValuation_surjective,
    paperRationalValuation_algebraMap, paperOriginalValuation_f]
  rfl

/-- The source polynomial as an element of the constructed valuation ring. -/
def paperOriginalUniformizer : paperRationalValuationRing :=
  ⟨algebraMap (R 4) (FreeCoordinateRationalField ℂ (Fin 4)) f, by
    simpa using (paperRationalValuationRing_f_zpow_iff 1).mpr zero_le_one⟩

/-- The maximal ideal has the exact distinguished generator supplied by the paper. -/
theorem paperOriginalValuation_maximalIdeal :
    IsLocalRing.maximalIdeal paperRationalValuationRing =
      Ideal.span ({paperOriginalUniformizer} : Set paperRationalValuationRing) :=
  Valuation.IsUniformizer.is_generator (v := paperRationalValuation)
    (π := paperOriginalUniformizer) paperOriginalPolynomial_isUniformizer

/-- Every power of the maximal ideal is generated by the corresponding source-polynomial power. -/
theorem paperOriginalValuation_maximalIdeal_pow (n : ℕ) :
    IsLocalRing.maximalIdeal paperRationalValuationRing ^ n =
      Ideal.span ({paperOriginalUniformizer ^ n} : Set paperRationalValuationRing) := by
  rw [paperOriginalValuation_maximalIdeal, Ideal.span_singleton_pow]

end

end GaloisForLFunctions.HTGeometry
