import GaloisForLFunctions.HTGeometry.TorusChartConnectedCover

/-!
# Two-meridian rigidity for connected covers of a torus-affine chart

The fundamental group of `(ℂˣ)² × ℂᵏ` is generated by its two coordinate meridians.  Hence a
connected cover is trivial as soon as those meridians fix one sheet.  This is the topological
endgame needed by the critical block-cover argument: only two closed source lifts remain to be
constructed.
-/

namespace GaloisForLFunctions.HTGeometry

open Path

universe u

variable {E : Type u} [TopologicalSpace E] {k : ℕ}
  (p : E → ComplexTorusAffineChart k) (cov : IsCoveringMap p)

/-- If the two coordinate meridians fix one sheet, every torus-chart loop fixes that sheet. -/
theorem torusChartCover_monodromy_fixed_of_generators_fixed
    (e : p ⁻¹' {(1 : ComplexTorusAffineChart k)})
    (hfirst : cov.monodromy (torusChartFirstFundamentalGenerator k) e = e)
    (hsecond : cov.monodromy (torusChartSecondFundamentalGenerator k) e = e) :
    ∀ g : FundamentalGroup (ComplexTorusAffineChart k) 1,
      cov.monodromy g e = e := by
  intro g
  obtain ⟨a, b, rfl⟩ := exists_eq_zpow_torusChartFundamentalGenerators k g
  let ρ := cov.monodromyPerm (1 : ComplexTorusAffineChart k)
  have hfirst' : ρ (torusChartFirstFundamentalGenerator k) ∈
      MulAction.stabilizer (Equiv.Perm (p ⁻¹' {(1 : ComplexTorusAffineChart k)})) e := by
    simpa [ρ] using hfirst
  have hsecond' : ρ (torusChartSecondFundamentalGenerator k) ∈
      MulAction.stabilizer (Equiv.Perm (p ⁻¹' {(1 : ComplexTorusAffineChart k)})) e := by
    simpa [ρ] using hsecond
  have hmem :
      ρ (torusChartFirstFundamentalGenerator k ^ a *
        torusChartSecondFundamentalGenerator k ^ b) ∈
      MulAction.stabilizer (Equiv.Perm (p ⁻¹' {(1 : ComplexTorusAffineChart k)})) e := by
    rw [map_mul, map_zpow, map_zpow]
    exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ hfirst' a)
      (Subgroup.zpow_mem _ hsecond' b)
  simpa [ρ] using hmem

/-- **Two-meridian rigidity.**  A path-connected cover of the torus-affine chart has a singleton
fibre if both coordinate meridians fix one point of that fibre. -/
theorem subsingleton_torusChartCover_fiber_of_generators_fixed [PathConnectedSpace E]
    (e : p ⁻¹' {(1 : ComplexTorusAffineChart k)})
    (hfirst : cov.monodromy (torusChartFirstFundamentalGenerator k) e = e)
    (hsecond : cov.monodromy (torusChartSecondFundamentalGenerator k) e = e) :
    Subsingleton (p ⁻¹' {(1 : ComplexTorusAffineChart k)}) := by
  constructor
  intro x y
  have hpre := connectedCover_monodromy_isPretransitive p cov e
  obtain ⟨g, hg⟩ := hpre.exists_smul_eq e x
  obtain ⟨gamma, hgamma⟩ := g.property
  have hx : x = e := by
    rw [← hg]
    change (g : Equiv.Perm (p ⁻¹' {(1 : ComplexTorusAffineChart k)})) e = e
    rw [← hgamma]
    exact torusChartCover_monodromy_fixed_of_generators_fixed p cov e hfirst hsecond gamma
  obtain ⟨g, hg⟩ := hpre.exists_smul_eq e y
  obtain ⟨gamma, hgamma⟩ := g.property
  have hy : y = e := by
    rw [← hg]
    change (g : Equiv.Perm (p ⁻¹' {(1 : ComplexTorusAffineChart k)})) e = e
    rw [← hgamma]
    exact torusChartCover_monodromy_fixed_of_generators_fixed p cov e hfirst hsecond gamma
  exact hx.trans hy.symm

end GaloisForLFunctions.HTGeometry
