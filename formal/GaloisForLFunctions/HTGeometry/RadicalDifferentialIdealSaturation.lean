import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealPrime

/-!
# Saturation and finite exhaustion of radical differential ideals

Two facts that finish Ritt's basis theorem once the reduction algorithm is available.

The first is the saturation decomposition: an element that both lies in the radical differential
ideal generated by `J` together with `h`, and is annihilated into `J` by some power of `h`, already
lies in `J`.  It follows from the product law, because `(h v)^j = (h^j v) v^{j-1}`.

The second is finite exhaustion: the radical differential ideal generated by a set is the union of
those generated by its finite subsets, since that union is already a radical differential ideal.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

theorem radicalDifferentialIdeal_mono {S S' : Set R} (h : S ⊆ S') :
    radicalDifferentialIdeal S ≤ radicalDifferentialIdeal S' :=
  radicalDifferentialIdeal_le (fun _ hx => subset_radicalDifferentialIdeal S' (h hx))
    (isRadical_radicalDifferentialIdeal S') (deriv_mem_radicalDifferentialIdeal S')

/-! ### Saturation -/

/-- **The saturation decomposition.**  An element of `{J, h}` that some power of `h` pushes into the
radical differential ideal `J` already lies in `J`. -/
theorem mem_of_saturation_of_mem_adjoin {J : Ideal R} (hrad : J.IsRadical)
    (hδ : ∀ x ∈ J, Differential.deriv x ∈ J) {h x : R}
    (hsat : ∃ j : ℕ, h ^ j * x ∈ J)
    (hadj : x ∈ radicalDifferentialIdeal ((J : Set R) ∪ {h})) : x ∈ J := by
  classical
  set T : Set R := {y | ∃ j : ℕ, h ^ j * y ∈ J} with hT
  have hpair : ∀ u ∈ ((J : Set R) ∪ {h}), ∀ v ∈ T, u * v ∈ J := by
    rintro u (hu | hu) v hv
    · exact J.mul_mem_right _ hu
    · rw [Set.mem_singleton_iff] at hu
      subst hu
      obtain ⟨j, hj⟩ := hv
      refine hrad ⟨j + 1, ?_⟩
      have hrw : (u * v) ^ (j + 1) = (u ^ j * v) * (u * v ^ j) := by ring
      rw [hrw]
      exact J.mul_mem_right _ hj
  have hxT : x ∈ radicalDifferentialIdeal T := subset_radicalDifferentialIdeal T hsat
  have hsq : x * x ∈ J := mul_mem_of_forall_mul_mem hrad hδ hpair hadj hxT
  exact hrad ⟨2, by rw [pow_two]; exact hsq⟩

/-! ### Finite exhaustion -/

/-- The union of the radical differential ideals generated by the finite subsets of a set. -/
def finiteRadicalDifferentialIdeal (S : Set R) : Ideal R where
  carrier := {x | ∃ T : Finset R, ↑T ⊆ S ∧ x ∈ radicalDifferentialIdeal (T : Set R)}
  add_mem' := by
    classical
    rintro a b ⟨T₁, hT₁, ha⟩ ⟨T₂, hT₂, hb⟩
    refine ⟨T₁ ∪ T₂, ?_, ?_⟩
    · intro y hy
      rcases Finset.mem_union.mp (by exact_mod_cast hy) with h | h
      · exact hT₁ (by exact_mod_cast h)
      · exact hT₂ (by exact_mod_cast h)
    · refine Ideal.add_mem _ ?_ ?_
      · exact radicalDifferentialIdeal_mono
          (by intro y hy; exact_mod_cast Finset.mem_union_left T₂ (by exact_mod_cast hy)) ha
      · exact radicalDifferentialIdeal_mono
          (by intro y hy; exact_mod_cast Finset.mem_union_right T₁ (by exact_mod_cast hy)) hb
  zero_mem' := ⟨∅, by simp, Ideal.zero_mem _⟩
  smul_mem' := by
    rintro c a ⟨T, hT, ha⟩
    exact ⟨T, hT, Ideal.mul_mem_left _ _ ha⟩

theorem mem_finiteRadicalDifferentialIdeal {S : Set R} {x : R} :
    x ∈ finiteRadicalDifferentialIdeal S ↔
      ∃ T : Finset R, ↑T ⊆ S ∧ x ∈ radicalDifferentialIdeal (T : Set R) := Iff.rfl

/-- **Finite exhaustion.**  Membership in the radical differential ideal generated by a set is
witnessed by a finite subset. -/
theorem exists_finset_subset_mem_radicalDifferentialIdeal {S : Set R} {x : R}
    (hx : x ∈ radicalDifferentialIdeal S) :
    ∃ T : Finset R, ↑T ⊆ S ∧ x ∈ radicalDifferentialIdeal (T : Set R) := by
  classical
  have hle : radicalDifferentialIdeal S ≤ finiteRadicalDifferentialIdeal S := by
    refine radicalDifferentialIdeal_le ?_ ?_ ?_
    · intro y hy
      exact ⟨{y}, by simpa using hy, subset_radicalDifferentialIdeal _ (by simp)⟩
    · rintro y ⟨n, hn⟩
      obtain ⟨T, hT, hyn⟩ := hn
      exact ⟨T, hT, isRadical_radicalDifferentialIdeal _ ⟨n, hyn⟩⟩
    · rintro y ⟨T, hT, hy⟩
      exact ⟨T, hT, deriv_mem_radicalDifferentialIdeal _ y hy⟩
  exact hle hx

end

end GaloisForLFunctions.HTGeometry
