import GaloisForLFunctions.HTGeometry.DeckClosureReconstruction
import GaloisForLFunctions.HTGeometry.NonautonomousDeckClosure

/-!
# Reconstruction of the completed nonautonomous deck group

A nonautonomous phase tail is the fixed field of all finite-prefix deck groups.  In a Galois
ambient extension, fixed fields see precisely the topological closure of their automorphism
group.  Hence the tail does not merely carry prefix-deck invariants: its full fixing subgroup
reconstructs the completed group generated by every future depth.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

open InfiniteGalois

/-- A nonautonomous tail is the fixed field of the topologically completed total prefix-deck
group, not only of its algebraically generated dense subgroup. -/
theorem nonautonomousTail_eq_fixedField_topologicalClosure
    [IsGalois K F]
    (φ : ℕ → F →ₐ[K] F) (i : ℕ)
    (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (forwardPrefix φ i n) ⊤ =
      IntermediateField.fixedField (Γ n)) :
    nonautonomousTail φ i =
      IntermediateField.fixedField (⨆ n, Γ n).topologicalClosure := by
  rw [fixedField_topologicalClosure]
  exact nonautonomousTail_eq_fixedField_iSup φ i Γ hdeck

/-- **Nonautonomous deck reconstruction law.**  The full Galois fixing subgroup of the phase tail
is exactly the topological closure of the group generated by all finite-prefix deck groups. -/
theorem fixingSubgroup_nonautonomousTail_eq_deckClosure
    [IsGalois K F]
    (φ : ℕ → F →ₐ[K] F) (i : ℕ)
    (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (forwardPrefix φ i n) ⊤ =
      IntermediateField.fixedField (Γ n)) :
    (nonautonomousTail φ i).fixingSubgroup =
      (⨆ n, Γ n).topologicalClosure := by
  rw [nonautonomousTail_eq_fixedField_topologicalClosure φ i Γ hdeck]
  let H : ClosedSubgroup (F ≃ₐ[K] F) :=
    ⟨(⨆ n, Γ n).topologicalClosure,
      Subgroup.isClosed_topologicalClosure (⨆ n, Γ n)⟩
  exact InfiniteGalois.fixingSubgroup_fixedField H

/-- Tail membership can equivalently be tested against every element of the completed total deck
group. -/
theorem mem_nonautonomousTail_iff_fixedBy_completedDeckGroup
    [IsGalois K F]
    (φ : ℕ → F →ₐ[K] F) (i : ℕ)
    (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (forwardPrefix φ i n) ⊤ =
      IntermediateField.fixedField (Γ n)) (x : F) :
    x ∈ nonautonomousTail φ i ↔
      ∀ σ ∈ (⨆ n, Γ n).topologicalClosure, σ x = x := by
  rw [nonautonomousTail_eq_fixedField_topologicalClosure φ i Γ hdeck]
  rw [IntermediateField.mem_fixedField_iff]

end

end GaloisForLFunctions.HTGeometry
