import GaloisForLFunctions.HTGeometry.DifferentialSubfieldTransfer

/-!
# In differential transcendence degree one, one transcendental controls everything

A differential field of differential transcendence degree one over its base has no two differentially
independent elements.  So as soon as one element is differentially transcendental, every element is
differentially algebraic over the differential field it generates.

This is the first step of a differential Lüroth argument: an intermediate differential field which is
not the base already forces the whole extension to be differentially algebraic over it.
-/

namespace GaloisForLFunctions

open Set

noncomputable section

universe u

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
variable [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]

omit [Differential F] [DifferentialAlgebra F E] [CharZero E] in
/-- Independence of a singleton is hypertranscendence of its element. -/
theorem diffIndepOn_singleton_iff (w : E) :
    DiffIndepOn F ({w} : Set E) ↔ HypertranscendentalOver F w := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  constructor
  · intro h
    exact h.comp (fun _ : Unit => (⟨w, rfl⟩ : ({w} : Set E))) (fun _ _ _ => rfl)
  · intro h
    have hinj : Function.Injective (fun _ : ({w} : Set E) => (default : Unit)) := by
      intro a b _
      exact Subtype.ext (a.2.trans b.2.symm)
    have hcomp := h.comp (fun _ : ({w} : Set E) => (default : Unit)) hinj
    have hfun : ((fun _ : Unit => w) ∘ fun _ : ({w} : Set E) => (default : Unit))
        = (Subtype.val : ({w} : Set E) → E) := by
      funext z
      exact z.2.symm
    rwa [hfun] at hcomp

/-- **One transcendental controls a scalar differential field.**  If the differential transcendence
degree is one, every element is differentially algebraic over the differential field generated by any
differentially transcendental element. -/
theorem mem_differentialClosure_singleton_of_cRank_one {y w : E}
    (hrank : differentialTranscendenceDegree F E = 1)
    (hw : HypertranscendentalOver F w) :
    y ∈ differentialClosure F ({w} : Set E) := by
  classical
  by_cases hyw : y = w
  · subst hyw
    exact subset_differentialClosure ({y} : Set E) rfl
  by_contra hy
  have hwind : DiffIndepOn F ({w} : Set E) := (diffIndepOn_singleton_iff w).2 hw
  have hnot : y ∉ ({w} : Set E) := by simpa using hyw
  have hins : DiffIndepOn F (insert y ({w} : Set E)) :=
    (diffIndepOn_insert_iff hnot).2 ⟨hwind, hy⟩
  have hcard : Cardinal.mk (↥(insert y ({w} : Set E))) = 2 := by
    rw [Cardinal.mk_insert hnot]
    simp
    norm_num
  have hle : Cardinal.mk (↥(insert y ({w} : Set E))) ≤ differentialTranscendenceDegree F E :=
    (differentialMatroid_indep_iff.2 hins).cardinalMk_le_cRank
  rw [hcard, hrank] at hle
  exact absurd hle (by norm_num)

end

end GaloisForLFunctions
