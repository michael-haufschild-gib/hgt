import GaloisForLFunctions.HTGeometry.PaperHomogeneousNormalRelations

/-!
# Normal presentations for ideals of actual homogeneous generators

Build the missing ideal bridge directly from a specified native polynomial
family. Its common positive degree pays the source weight bound, so the
paper's complete relation-preservation theorem applies automatically.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

noncomputable section

variable {K σ ι : Type*} [CommRing K]

/-- The actual ideal generated by the specified polynomial family. -/
def paperHomogeneousGeneratorIdeal (g : ι → MvPolynomial σ K) : Ideal (MvPolynomial σ K) :=
  Ideal.span (Set.range g)

/-- Each specified native generator belongs to its generated ideal. -/
theorem paperHomogeneousGeneratorIdeal_mem (g : ι → MvPolynomial σ K) (i : ι) :
    g i ∈ paperHomogeneousGeneratorIdeal g := Ideal.subset_span ⟨i, rfl⟩

/-- The source nonnegative-weight bound is paid by the actual homogeneous generators. -/
theorem paperHomogeneousGeneratorIdeal_weightOrder
    (g : ι → MvPolynomial σ K) (q : ℕ) (hg : ∀ i, (g i).IsHomogeneous q) :
    paperHomogeneousGeneratorIdeal g ≤
      paperWeightOrderIdeal (fun _ : σ => (1 : ℤ)) (by intro _; exact zero_le_one) (q : ℤ) := by
  rw [paperHomogeneousGeneratorIdeal, Ideal.span_le]
  rintro p ⟨i, rfl⟩
  exact paperWeightOrderIdeal_mem_of_homogeneous _ _ (paperIsWeightedHomogeneous_int (hg i))

/-- A homogeneous native generator family supplies all normal-presentation prerequisites. -/
def paperHomogeneousGeneratorNormalPresentation
    (g : ι → MvPolynomial σ K) (q : ℕ) (hq : 0 < q) (hg : ∀ i, (g i).IsHomogeneous q) :
    PaperHomogeneousNormalPresentationData K σ ι (paperHomogeneousGeneratorIdeal g) where
  generator := g
  degree := q
  degree_pos := hq
  generator_mem := paperHomogeneousGeneratorIdeal_mem g
  homogeneous := hg
  order_bound := paperHomogeneousGeneratorIdeal_weightOrder g q hg

end

end GaloisForLFunctions.HTGeometry
