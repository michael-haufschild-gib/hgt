import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic

/-!
# The squarefree degree-`r` Veronese ideal

The exact translation annihilator of a generic order-`r` multiple elliptic gamma logarithmic
derivative is the squarefree degree-`r` monomial ideal `I_r` in the Laurent group ring of the
parameter translations, `x_j = t_j - 1`.  The special-function content (which combinations are
differentially algebraic) is separate; the purely combinatorial engine that "there are no hidden
annihilators beyond the face ideal" is the following characterization of `I_r`, formalized here
unconditionally:

> a polynomial lies in the ideal generated by the products of `r` distinct variables **iff** every
> monomial occurring in it uses at least `r` distinct variables.

Equivalently `I_r = ⋂_{|L|=2} (x_a, x_b)`: a polynomial is in `I_r` iff no monomial avoids a whole
pair of variables.  This is the exact statement used in the reverse inclusion of the annihilator
theorem, freed of its differential-algebraic hypotheses.
-/

namespace GaloisForLFunctions.VeroneseIdeal

open MvPolynomial Finset

variable {R σ : Type*} [CommRing R] [DecidableEq σ]

/-- Products of `X_j` over the `r`-element subsets of the variables. -/
def veroneseGens (R σ : Type*) [CommRing R] (r : ℕ) : Set (MvPolynomial σ R) :=
  {P | ∃ J : Finset σ, J.card = r ∧ P = ∏ j ∈ J, X j}

/-- The squarefree degree-`r` Veronese ideal, generated by all products of `r` distinct variables. -/
noncomputable def veroneseIdeal (R σ : Type*) [CommRing R] [DecidableEq σ] (r : ℕ) :
    Ideal (MvPolynomial σ R) :=
  Ideal.span (veroneseGens R σ r)

/-- A polynomial is monomial-wide of width `r` when every monomial occurring in it uses at least `r`
distinct variables. -/
def MonoWide (r : ℕ) (P : MvPolynomial σ R) : Prop :=
  ∀ d : σ →₀ ℕ, coeff d P ≠ 0 → r ≤ d.support.card

/-- A product of distinct variables is the squarefree monomial supported on that index set. -/
theorem prod_X_eq_monomial (J : Finset σ) :
    (∏ j ∈ J, (X j : MvPolynomial σ R)) = monomial (∑ j ∈ J, Finsupp.single j 1) 1 := by
  induction J using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, X, monomial_mul, one_mul]

/-- The support of the indicator exponent `∑_{j ∈ J} single j 1` is exactly `J`. -/
theorem support_sum_single (J : Finset σ) :
    (∑ j ∈ J, Finsupp.single j (1 : ℕ)).support = J := by
  induction J using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      have hsingle : (Finsupp.single a (1 : ℕ)).support = {a} :=
        Finsupp.support_single a one_ne_zero
      have hdisj : Disjoint (Finsupp.single a (1 : ℕ)).support (∑ j ∈ s, Finsupp.single j 1).support := by
        rw [hsingle, ih]; simpa using ha
      rw [Finset.sum_insert ha, Finsupp.support_add_eq hdisj, hsingle, ih, Finset.singleton_union]

/-- The value of the indicator exponent at `i` is `1` on `J` and `0` off it. -/
theorem sum_single_apply (J : Finset σ) (i : σ) :
    (∑ j ∈ J, Finsupp.single j (1 : ℕ)) i = if i ∈ J then 1 else 0 := by
  rw [Finsupp.finsetSum_apply]
  simp only [Finsupp.single_apply]
  rw [Finset.sum_ite_eq' J i (fun _ => (1 : ℕ))]

/-- Each generator is monomial-wide of width `r`. -/
theorem monoWide_of_mem_gens {r : ℕ} {P : MvPolynomial σ R} (hP : P ∈ veroneseGens R σ r) :
    MonoWide r P := by
  obtain ⟨J, hJ, rfl⟩ := hP
  intro d hd
  rw [prod_X_eq_monomial, coeff_monomial] at hd
  by_cases h : (∑ j ∈ J, Finsupp.single j 1) = d
  · subst h; rw [support_sum_single]; exact hJ.ge
  · rw [if_neg h] at hd; exact absurd rfl hd

/-- `MonoWide` is preserved by the ideal operations, so it holds throughout `I_r`. -/
theorem monoWide_of_mem_ideal {r : ℕ} {P : MvPolynomial σ R} (hP : P ∈ veroneseIdeal R σ r) :
    MonoWide r P := by
  refine Submodule.span_induction (p := fun x _ => MonoWide r x)
    (fun g hg => monoWide_of_mem_gens hg) ?_ ?_ ?_ hP
  · intro d hd; simp at hd
  · intro a b _ _ ha hb d hd
    rw [coeff_add] at hd
    rcases ne_or_eq (coeff d a) 0 with h | h
    · exact ha d h
    · exact hb d (by rw [h, zero_add] at hd; exact hd)
  · intro a x _ hx d hd
    rw [smul_eq_mul, coeff_mul] at hd
    obtain ⟨⟨da, db⟩, hmem, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
    have hdb : coeff db x ≠ 0 := fun h => hne (by rw [h, mul_zero])
    have hsub : db.support ⊆ d.support := by
      rw [Finset.mem_antidiagonal] at hmem
      intro i hi
      rw [Finsupp.mem_support_iff] at hi ⊢
      intro hzero
      apply hi
      have hsum : da i + db i = 0 := by rw [← Finsupp.add_apply, hmem]; exact hzero
      omega
    exact le_trans (hx db hdb) (Finset.card_le_card hsub)

/-- A single monomial whose exponent uses at least `r` variables lies in `I_r`. -/
theorem monomial_mem_ideal {r : ℕ} {d : σ →₀ ℕ} (c : R) (hd : r ≤ d.support.card) :
    monomial d c ∈ veroneseIdeal R σ r := by
  obtain ⟨J, hJsub, hJcard⟩ := Finset.exists_subset_card_eq hd
  set e : σ →₀ ℕ := ∑ j ∈ J, Finsupp.single j 1 with he
  have hle : e ≤ d := by
    intro i
    rw [he, sum_single_apply]
    split_ifs with h
    · have : d i ≠ 0 := by
        rw [← Finsupp.mem_support_iff]; exact hJsub h
      omega
    · exact Nat.zero_le _
  have hgen : (∏ j ∈ J, X j) ∈ veroneseIdeal R σ r :=
    Ideal.subset_span ⟨J, hJcard, rfl⟩
  have hfactor : monomial d c = (∏ j ∈ J, (X j : MvPolynomial σ R)) * monomial (d - e) c := by
    rw [prod_X_eq_monomial, monomial_mul, one_mul, ← he, add_tsub_cancel_of_le hle]
  rw [hfactor]
  exact Ideal.mul_mem_right _ _ hgen

/-- **Squarefree Veronese membership.**  A polynomial lies in the squarefree degree-`r` Veronese
ideal iff every monomial occurring in it uses at least `r` distinct variables. -/
theorem mem_veroneseIdeal_iff {r : ℕ} (P : MvPolynomial σ R) :
    P ∈ veroneseIdeal R σ r ↔ MonoWide r P := by
  constructor
  · exact monoWide_of_mem_ideal
  · intro hP
    rw [P.as_sum]
    refine Ideal.sum_mem _ ?_
    intro d hd
    exact monomial_mem_ideal _ (hP d (mem_support_iff.mp hd))

end GaloisForLFunctions.VeroneseIdeal
