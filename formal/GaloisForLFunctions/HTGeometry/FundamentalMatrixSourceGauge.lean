import GaloisForLFunctions.HTGeometry.SourceStableDifferentialAdjoin
import Mathlib.Data.Matrix.Mul

/-!
# Flattening an affine source datum by a fundamental matrix

An affine source local system is flat as soon as its homogeneous part has an invertible solution
matrix in the ambient field.  Multiplying the observables by the inverse of such a fundamental
matrix removes the adjoint action entirely, whatever that action is: no diagonalizability and no
triangular structure is needed.

```text
sigma_i(Y) = M_i Y   and   sigma_i(z) = M_i z + omega_i
  ==>  sigma_i(Y^(-1) z) = Y^(-1) z + Y^(-1) M_i^(-1) omega_i.
```

The increments of the flattened family are entries of the field generated by the fundamental
matrix, which is the coefficient field over which the flat source-boundary theory then runs.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {K L : Type u} [Field K] [Field L] [Algebra K L]
  {I : Type u} (tau : I → K ≃+* K) (sigma : I → L ≃+* L)
  {κ : Type u} [Fintype κ] [DecidableEq κ]

/-- The image in the ambient field of a matrix over the base. -/
def baseMat (A : Matrix κ κ K) : Matrix κ κ L := A.map (algebraMap K L)

omit [DecidableEq κ] in
theorem baseMat_mul (A B : Matrix κ κ K) :
    baseMat (A * B) = (baseMat A * baseMat B : Matrix κ κ L) :=
  Matrix.map_mul

omit [Fintype κ] in
theorem baseMat_one : baseMat (1 : Matrix κ κ K) = (1 : Matrix κ κ L) :=
  Matrix.map_one _ (map_zero _) (map_one _)

omit [DecidableEq κ] in
/-- The entrywise source action on matrices is multiplicative. -/
theorem map_sigma_mul (i : I) (A B : Matrix κ κ L) :
    (A * B).map (sigma i) = A.map (sigma i) * B.map (sigma i) :=
  Matrix.map_mul

omit [Fintype κ] in
theorem map_sigma_one (i : I) : (1 : Matrix κ κ L).map (sigma i) = 1 :=
  Matrix.map_one _ (map_zero _) (map_one _)

omit [DecidableEq κ] in
/-- The source action commutes with matrix-vector multiplication. -/
theorem sigma_mulVec (i : I) (A : Matrix κ κ L) (v : κ → L) (p : κ) :
    sigma i (Matrix.mulVec A v p)
      = Matrix.mulVec (A.map (sigma i)) (fun q => sigma i (v q)) p := by
  simpa [Function.comp_def] using RingHom.map_mulVec ((sigma i : L ≃+* L) : L →+* L) A v p

/-! ### The source transform of the inverse fundamental matrix -/

/-- **The inverse of a fundamental matrix transforms by the inverse local system.** -/
theorem map_sigma_fundamental_inv {Y Yinv : Matrix κ κ L} {M Minv : I → Matrix κ κ K}
    (hYY : Y * Yinv = 1) (hYY' : Yinv * Y = 1)
    (hMM : ∀ i, M i * Minv i = 1) (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y) (i : I) :
    Yinv.map (sigma i) = Yinv * baseMat (Minv i) := by
  have hMLl : (baseMat (Minv i) : Matrix κ κ L) * baseMat (M i) = 1 := by
    rw [← baseMat_mul, hMM' i, baseMat_one]
  have hMLr : (baseMat (M i) : Matrix κ κ L) * baseMat (Minv i) = 1 := by
    rw [← baseMat_mul, hMM i, baseMat_one]
  have hright : Y.map (sigma i) * Yinv.map (sigma i) = 1 := by
    rw [← map_sigma_mul sigma i, hYY, map_sigma_one sigma i]
  have hleft : (Yinv * baseMat (Minv i)) * Y.map (sigma i) = 1 := by
    rw [hfund i]
    calc Yinv * baseMat (Minv i) * (baseMat (M i) * Y)
        = Yinv * (baseMat (Minv i) * baseMat (M i)) * Y := by
          simp [mul_assoc]
      _ = 1 := by rw [hMLl, mul_one, hYY']
  calc Yinv.map (sigma i)
      = (Yinv * baseMat (Minv i)) * Y.map (sigma i) * Yinv.map (sigma i) := by
        rw [hleft, one_mul]
    _ = (Yinv * baseMat (Minv i)) * (Y.map (sigma i) * Yinv.map (sigma i)) := by
        rw [mul_assoc]
    _ = Yinv * baseMat (Minv i) := by rw [hright, mul_one]

/-! ### The flattening -/

/-- **Fundamental-matrix flattening.**  Multiplying an affine source family by the inverse of a
fundamental matrix of its homogeneous part turns it into a flat family, whose increments are the
inverse fundamental matrix applied to the inverse-twisted increments. -/
theorem fundamental_shift {Y Yinv : Matrix κ κ L} {M Minv : I → Matrix κ κ K}
    {om : I → κ → K} {z : κ → L}
    (hYY : Y * Yinv = 1) (hYY' : Yinv * Y = 1)
    (hMM : ∀ i, M i * Minv i = 1) (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y)
    (hshift : ∀ i p, sigma i (z p)
      = Matrix.mulVec (baseMat (M i) : Matrix κ κ L) z p + algebraMap K L (om i p))
    (i : I) (p : κ) :
    sigma i (Matrix.mulVec Yinv z p)
      = Matrix.mulVec Yinv z p
        + Matrix.mulVec (Yinv * baseMat (Minv i) : Matrix κ κ L)
            (fun q => algebraMap K L (om i q)) p := by
  have hz : (fun q => sigma i (z q))
      = Matrix.mulVec (baseMat (M i) : Matrix κ κ L) z
          + fun q => algebraMap K L (om i q) := by
    funext q
    exact hshift i q
  have hstep : sigma i (Matrix.mulVec Yinv z p)
      = Matrix.mulVec (Yinv * baseMat (Minv i) : Matrix κ κ L)
          (Matrix.mulVec (baseMat (M i) : Matrix κ κ L) z
            + fun q => algebraMap K L (om i q)) p := by
    rw [sigma_mulVec sigma i Yinv z p,
      map_sigma_fundamental_inv sigma hYY hYY' hMM hMM' hfund i, hz]
  rw [hstep, Matrix.mulVec_add, Pi.add_apply]
  congr 1
  rw [Matrix.mulVec_mulVec, mul_assoc, ← baseMat_mul, hMM' i, baseMat_one, mul_one]

/-! ### The inverse source direction -/

omit [Fintype κ] [DecidableEq κ] in
/-- The inverse source action on a base matrix is the inverse base action. -/
theorem map_baseMat_sigma_symm
    [Differential K] [Differential L] [DifferentialAlgebra K L]
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (i : I) (A : Matrix κ κ K) :
    (baseMat A : Matrix κ κ L).map (sigma i).symm = baseMat (A.map (tau i).symm) := by
  ext p q
  simpa [baseMat] using ringEquiv_symm_algebraMap tau sigma hcomp i (A p q)

omit [Fintype κ] [DecidableEq κ] in
/-- Applying a source automorphism and its inverse entrywise is the identity on matrices. -/
theorem map_sigma_symm_map_sigma (i : I) (A : Matrix κ κ L) :
    (A.map (sigma i)).map (sigma i).symm = A := by
  have hid : ((sigma i).symm : L → L) ∘ ((sigma i) : L → L) = id :=
    funext fun x => (sigma i).symm_apply_apply x
  rw [Matrix.map_map, hid, Matrix.map_id]

/-- **A fundamental matrix transforms by the inverse local system in the inverse source
direction.** -/
theorem map_sigma_symm_fundamental
    [Differential K] [Differential L] [DifferentialAlgebra K L]
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    {Y : Matrix κ κ L} {M Minv : I → Matrix κ κ K}
    (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y) (i : I) :
    Y.map (sigma i).symm = baseMat ((Minv i).map (tau i).symm) * Y := by
  have hinv : (baseMat ((Minv i).map (tau i).symm) : Matrix κ κ L)
      * baseMat ((M i).map (tau i).symm) = 1 := by
    rw [← baseMat_mul, ← Matrix.map_mul, hMM' i,
      Matrix.map_one _ (map_zero _) (map_one _), baseMat_one]
  have hstep : Y = baseMat ((M i).map (tau i).symm) * Y.map (sigma i).symm := by
    calc Y = (Y.map (sigma i)).map (sigma i).symm := (map_sigma_symm_map_sigma sigma i Y).symm
      _ = ((baseMat (M i) : Matrix κ κ L) * Y).map (sigma i).symm := by rw [hfund i]
      _ = (baseMat (M i) : Matrix κ κ L).map (sigma i).symm * Y.map (sigma i).symm :=
          Matrix.map_mul
      _ = baseMat ((M i).map (tau i).symm) * Y.map (sigma i).symm := by
          rw [map_baseMat_sigma_symm tau sigma hcomp i (M i)]
  calc Y.map (sigma i).symm
      = baseMat ((Minv i).map (tau i).symm)
          * (baseMat ((M i).map (tau i).symm) * Y.map (sigma i).symm) := by
        rw [← mul_assoc, hinv, one_mul]
    _ = baseMat ((Minv i).map (tau i).symm) * Y := by rw [← hstep]

/-- **The inverse fundamental matrix in the inverse source direction.** -/
theorem map_sigma_symm_fundamental_inv
    [Differential K] [Differential L] [DifferentialAlgebra K L]
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    {Y Yinv : Matrix κ κ L} {M Minv : I → Matrix κ κ K}
    (hYY : Y * Yinv = 1) (hYY' : Yinv * Y = 1)
    (hMM : ∀ i, M i * Minv i = 1) (hMM' : ∀ i, Minv i * M i = 1)
    (hfund : ∀ i, Y.map (sigma i) = baseMat (M i) * Y) (i : I) :
    Yinv.map (sigma i).symm = Yinv * baseMat ((M i).map (tau i).symm) := by
  have hinv : (baseMat ((Minv i).map (tau i).symm) : Matrix κ κ L)
      * baseMat ((M i).map (tau i).symm) = 1 := by
    rw [← baseMat_mul, ← Matrix.map_mul, hMM' i,
      Matrix.map_one _ (map_zero _) (map_one _), baseMat_one]
  have hstep : Yinv = Yinv.map (sigma i).symm * baseMat ((Minv i).map (tau i).symm) := by
    calc Yinv = (Yinv.map (sigma i)).map (sigma i).symm :=
          (map_sigma_symm_map_sigma sigma i Yinv).symm
      _ = (Yinv * (baseMat (Minv i) : Matrix κ κ L)).map (sigma i).symm := by
          rw [map_sigma_fundamental_inv sigma hYY hYY' hMM hMM' hfund i]
      _ = Yinv.map (sigma i).symm * (baseMat (Minv i) : Matrix κ κ L).map (sigma i).symm :=
          Matrix.map_mul
      _ = Yinv.map (sigma i).symm * baseMat ((Minv i).map (tau i).symm) := by
          rw [map_baseMat_sigma_symm tau sigma hcomp i (Minv i)]
  calc Yinv.map (sigma i).symm
      = Yinv.map (sigma i).symm
          * (baseMat ((Minv i).map (tau i).symm) * baseMat ((M i).map (tau i).symm)) := by
        rw [hinv, mul_one]
    _ = Yinv * baseMat ((M i).map (tau i).symm) := by rw [← mul_assoc, ← hstep]

end

end GaloisForLFunctions.HTGeometry
