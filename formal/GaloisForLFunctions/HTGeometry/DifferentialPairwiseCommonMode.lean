import GaloisForLFunctions.HTGeometry.DifferentialConstantLinearFamilyMatroid
import GaloisForLFunctions.HTGeometry.DifferentialPointedCollisionMatroid
import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence

/-!
# Exact common-mode loss of pairwise differential reporters

All pairwise differences are generated by the star rooted at any anchor. If the original family
is differentially independent, adjoining those differences does not recover the anchor:
the missing common-translation mode remains hypertranscendental over the pairwise field. This
turns the earlier anchor-membership criterion into a strict obstruction theorem.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Matrix Set
open scoped Differential

noncomputable section

universe u v w

/-- The occupied nonloop labels of an arbitrary labelled family, with no finiteness assumption. -/
abbrev pointedOccupiedLabelSupport
    {V L : Type u} (frame : V → L) (loop : L) : Type u :=
  ↑({q | q ∈ Set.range frame ∧ q ≠ loop} : Set L)

/-- Relabeling an arbitrary family by its occupied range does not change its value range. -/
theorem range_comp_eq_occupiedRange
    {V L K : Type u} (frame : V → L) (x : L → K) :
    Set.range (fun v ↦ x (frame v)) =
      Set.range (fun q : ↑(Set.range frame) ↦ x q) := by
  ext z
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨⟨frame v, Set.mem_range_self v⟩, rfl⟩
  · rintro ⟨q, rfl⟩
    rcases q.property with ⟨v, hv⟩
    refine ⟨v, ?_⟩
    change x (frame v) = x q
    rw [hv]

/-- Complete pairwise reporters of an arbitrary family likewise depend only on its occupied
label range. -/
theorem range_pairwiseComp_eq_occupiedRange
    {V L K : Type u} [Sub K] (frame : V → L) (x : L → K) :
    Set.range (fun p : V × V ↦ x (frame p.1) - x (frame p.2)) =
      Set.range (fun p : ↑(Set.range frame) × ↑(Set.range frame) ↦
        x p.1 - x p.2) := by
  ext z
  constructor
  · rintro ⟨⟨v, w⟩, rfl⟩
    exact ⟨
      (⟨frame v, Set.mem_range_self v⟩, ⟨frame w, Set.mem_range_self w⟩),
      rfl⟩
  · rintro ⟨⟨q, r⟩, rfl⟩
    rcases q.property with ⟨v, hv⟩
    rcases r.property with ⟨w, hw⟩
    refine ⟨(v, w), ?_⟩
    change x (frame v) - x (frame w) = x q - x r
    rw [hv, hw]

/-- Relabeling a finite family by its occupied labels does not change its value range, even when
the original labels repeat. -/
theorem range_comp_eq_occupiedLabels
    {V L K : Type u} [Fintype V] [DecidableEq L]
    (frame : V → L) (x : L → K) :
    Set.range (fun v ↦ x (frame v)) =
      Set.range (fun q : ↑(Finset.univ.image frame) ↦ x q) := by
  ext z
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨⟨frame v, Finset.mem_image.mpr ⟨v, Finset.mem_univ v, rfl⟩⟩, rfl⟩
  · rintro ⟨q, rfl⟩
    rcases Finset.mem_image.mp q.property with ⟨v, -, hv⟩
    refine ⟨v, ?_⟩
    change x (frame v) = x q
    rw [hv]

/-- Complete pairwise reporters likewise depend only on the finite occupied-label quotient. -/
theorem range_pairwiseComp_eq_occupiedLabels
    {V L K : Type u} [Fintype V] [DecidableEq L] [Sub K]
    (frame : V → L) (x : L → K) :
    Set.range (fun p : V × V ↦ x (frame p.1) - x (frame p.2)) =
      Set.range (fun p : ↑(Finset.univ.image frame) ×
          ↑(Finset.univ.image frame) ↦ x p.1 - x p.2) := by
  ext z
  constructor
  · rintro ⟨⟨v, w⟩, rfl⟩
    exact ⟨
      (⟨frame v, Finset.mem_image.mpr ⟨v, Finset.mem_univ v, rfl⟩⟩,
       ⟨frame w, Finset.mem_image.mpr ⟨w, Finset.mem_univ w, rfl⟩⟩),
      rfl⟩
  · rintro ⟨⟨q, r⟩, rfl⟩
    rcases Finset.mem_image.mp q.property with ⟨v, -, hv⟩
    rcases Finset.mem_image.mp r.property with ⟨w, -, hw⟩
    refine ⟨(v, w), ?_⟩
    change x (frame v) - x (frame w) = x q - x r
    rw [hv, hw]

/-- **Pairwise-to-star generated-field law.** Every complete pairwise-difference field is already
generated by the differences from one chosen anchor. No finiteness or independence hypothesis is
needed. -/
theorem differentialAdjoin_range_pairwiseDifferences_eq_rootedDifferences
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K]
    (root : V) (x : V → K) :
    differentialAdjoin F (Set.range fun p : V × V ↦ x p.1 - x p.2) =
      differentialAdjoin F
        (Set.range fun v : ↑({v | v ≠ root} : Set V) ↦ x v - x root) := by
  classical
  apply le_antisymm
  · apply differentialAdjoin_le F
    · rintro _ ⟨⟨v, w⟩, rfl⟩
      have hstar (q : V) : x q - x root ∈ differentialAdjoin F
          (Set.range fun z : ↑({z | z ≠ root} : Set V) ↦ x z - x root) := by
        by_cases hq : q = root
        · subst q
          rw [sub_self]
          exact IntermediateField.zero_mem _
        · exact subset_differentialAdjoin F _
            (Set.mem_range_self (⟨q, hq⟩ : ↑({z | z ≠ root} : Set V)))
      have h := IntermediateField.sub_mem _ (hstar v) (hstar w)
      convert h using 1
      ring
    · exact derivationClosed_differentialAdjoin F _
  · apply differentialAdjoin_le F
    · rintro _ ⟨v, rfl⟩
      exact subset_differentialAdjoin F _ (Set.mem_range_self ((v : V), root))
    · exact derivationClosed_differentialAdjoin F _

/-- Constant linear gauge retaining one anchor and replacing every other coordinate by its
difference from that anchor. -/
def anchorDifferenceGaugeMatrix
    {C : Type u} {V : Type v} [Field C] [Fintype V] [DecidableEq V]
    (root : V) : Matrix V V C :=
  fun i j ↦
    if i = root then
      if j = root then 1 else 0
    else
      (if i = j then 1 else 0) - (if j = root then 1 else 0)

/-- The anchor gauge matrix has the intended literal values. -/
theorem matrixLinearForms_anchorDifferenceGaugeMatrix
    {C K : Type u} {V : Type v} [Field C] [Field K] [Algebra C K]
    [Fintype V] [DecidableEq V]
    (root : V) (x : V → K) :
    matrixLinearForms (anchorDifferenceGaugeMatrix (C := C) root) x =
      fun i ↦ if i = root then x root else x i - x root := by
  have hsum (v0 : V) :
      ∑ j, algebraMap C K (if j = v0 then 1 else 0) * x j = x v0 := by
    calc
      (∑ j, algebraMap C K (if j = v0 then 1 else 0) * x j) =
          algebraMap C K (if v0 = v0 then 1 else 0) * x v0 := by
        apply Fintype.sum_eq_single v0
        intro j hj
        simp [hj]
      _ = x v0 := by simp
  funext i
  by_cases hi : i = root
  · subst i
    simp only [matrixLinearForms, anchorDifferenceGaugeMatrix, if_pos]
    rw [hsum]
  · simp only [matrixLinearForms, anchorDifferenceGaugeMatrix, hi, if_false,
      map_sub, sub_mul, Finset.sum_sub_distrib]
    have hiSum :
        (∑ j, algebraMap C K (if i = j then 1 else 0) * x j) = x i := by
      simpa only [eq_comm] using hsum i
    rw [hiSum, hsum]

/-- Every anchor-gauge coefficient is a differential constant. -/
theorem anchorDifferenceGaugeMatrix_coefficients_constant
    {C K : Type u} {V : Type v} [Field C] [Field K] [Algebra C K]
    [Differential K] [Fintype V] [DecidableEq V]
    (root : V) :
    ∀ i j,
      (algebraMap C K (anchorDifferenceGaugeMatrix (C := C) root i j))′ = 0 := by
  intro i j
  simp only [anchorDifferenceGaugeMatrix]
  split_ifs <;> simp

/-- The anchor gauge matrix is invertible at the level of rows. -/
theorem anchorDifferenceGaugeMatrix_rows_linearIndependent
    {C : Type u} {V : Type v} [Field C] [Fintype V] [DecidableEq V]
    (root : V) :
    LinearIndependent C (anchorDifferenceGaugeMatrix (C := C) root).row := by
  rw [Fintype.linearIndependent_iff]
  intro c hc
  have hnonroot (i : V) (hi : i ≠ root) : c i = 0 := by
    have hcoord := congrFun hc i
    simp only [Finset.sum_apply, Pi.smul_apply, Pi.zero_apply, smul_eq_mul,
      Matrix.row] at hcoord
    have hsingle :
        (∑ r, if r = root then 0 else if r = i then c r else 0) = c i := by
      calc
        (∑ r, if r = root then 0 else if r = i then c r else 0) =
            (if i = root then 0 else if i = i then c i else 0) := by
          apply Fintype.sum_eq_single i
          intro r hri
          by_cases hr : r = root <;> simp [hr, hri]
        _ = c i := by simp [hi]
    have hnormalized :
        (∑ r, if r = root then 0 else if r = i then c r else 0) = 0 := by
      simpa [anchorDifferenceGaugeMatrix, hi] using hcoord
    rw [hsingle] at hnormalized
    exact hnormalized
  intro i
  by_cases hi : i = root
  · subst i
    have hcoord := congrFun hc root
    simp only [Finset.sum_apply, Pi.smul_apply, Pi.zero_apply, smul_eq_mul,
      Matrix.row] at hcoord
    have hsingle :
        (∑ r, if r = root then c r
          else c r * ((if r = root then 1 else 0) - 1)) = c root := by
      calc
        (∑ r, if r = root then c r
          else c r * ((if r = root then 1 else 0) - 1)) =
            (if root = root then c root
              else c root * ((if root = root then 1 else 0) - 1)) := by
          apply Fintype.sum_eq_single root
          intro r hr
          rw [hnonroot r hr]
          simp [hr]
        _ = c root := by simp
    have hnormalized :
        (∑ r, if r = root then c r
          else c r * ((if r = root then 1 else 0) - 1)) = 0 := by
      simpa [anchorDifferenceGaugeMatrix] using hcoord
    rw [hsingle] at hnormalized
    exact hnormalized
  · exact hnonroot i hi

/-- Finite anchor-gauge independence, obtained from the explicit invertible constant matrix. -/
theorem differentialIndependent_anchorDifferenceGauge_finite
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    [Fintype V] [DecidableEq V]
    (root : V) (x : V → K) (hx : DifferentialIndependent F x) :
    DifferentialIndependent F
      (fun i ↦ if i = root then x root else x i - x root) := by
  rw [← matrixLinearForms_anchorDifferenceGaugeMatrix (C := F) root x]
  exact (differentialIndependent_matrixLinearForms_iff_rowIndependent
    (anchorDifferenceGaugeMatrix (C := F) root)
    (anchorDifferenceGaugeMatrix_coefficients_constant root) x hx).2
      (anchorDifferenceGaugeMatrix_rows_linearIndependent root)

/-- The anchor/difference gauge on an arbitrary index type. It is noncomputable only because
choosing the anchor branch uses classical equality; callers need no `DecidableEq` instance. -/
noncomputable def anchorDifferenceGaugeFamily
    {K V : Type*} [Field K] (root : V) (x : V → K) : V → K := by
  classical
  exact fun i ↦ if i = root then x root else x i - x root

/-- **Arbitrary anchor-gauge independence law.** Retaining one coordinate and replacing all others
by their differences from it preserves joint differential independence for an arbitrary index
type. This follows by adjoining the anchor to every finite subfamily and applying the finite
invertible gauge there. -/
theorem differentialIndependent_anchorDifferenceGauge
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (root : V) (x : V → K) (hx : DifferentialIndependent F x) :
    DifferentialIndependent F (anchorDifferenceGaugeFamily root x) := by
  classical
  apply differentialIndependent_of_forall_finite_subfamily
  intro I hIfinite
  let J : Set V := Set.insert root I
  have hJfinite : J.Finite := hIfinite.insert root
  letI : Fintype J := hJfinite.fintype
  let rootJ : J := ⟨root, Set.mem_insert root I⟩
  let xJ : J → K := fun j ↦ x j
  have hxJ : DifferentialIndependent F xJ :=
    hx.comp Subtype.val Subtype.val_injective
  have hyJ := differentialIndependent_anchorDifferenceGauge_finite rootJ xJ hxJ
  let embed : I → J := fun i ↦
    ⟨i, Set.mem_insert_iff.mpr (Or.inr i.property)⟩
  have hembed : Function.Injective embed := by
    intro i j hij
    apply Subtype.ext
    exact congrArg (fun z : J ↦ (z : V)) hij
  simpa [anchorDifferenceGaugeFamily, Function.comp_def, xJ, rootJ, embed,
    Subtype.ext_iff] using
    hyJ.comp embed hembed

/-- **Hypertranscendental common-mode law.** For an arbitrarily indexed differentially independent
family, every anchor is hypertranscendental over the differential field generated by all pairwise
differences. Thus a complete additive reporter loses exactly one genuinely differential-
transcendental common-translation mode, not merely one field element. -/
theorem hypertranscendentalOver_anchor_pairwiseDifferences
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (root : V) (x : V → K) (hx : DifferentialIndependent F x) :
    HypertranscendentalOver
      (differentialAdjoin F (Set.range fun p : V × V ↦ x p.1 - x p.2))
      (x root) := by
  classical
  rw [differentialAdjoin_range_pairwiseDifferences_eq_rootedDifferences root x]
  let y : V → K := fun i ↦ if i = root then x root else x i - x root
  have hy : DifferentialIndependent F y := by
    simpa [y, anchorDifferenceGaugeFamily] using
      differentialIndependent_anchorDifferenceGauge root x hx
  let left : Unit → K := fun _ ↦ x root
  let right : ↑({v | v ≠ root} : Set V) → K := fun v ↦ x v - x root
  let index : Sum Unit ↑({v | v ≠ root} : Set V) → V :=
    Sum.elim (fun _ ↦ root) (fun v ↦ (v : V))
  have hindex : Function.Injective index := by
    intro a b hab
    cases a with
    | inl a =>
        cases b with
        | inl b => simp
        | inr b => exact False.elim (b.property hab.symm)
    | inr a =>
        cases b with
        | inl b => exact False.elim (a.property hab)
        | inr b => exact congrArg Sum.inr (Subtype.ext hab)
  have hsum : DifferentialIndependent F (Sum.elim left right) := by
    have hcomp := hy.comp index hindex
    have hfamily : Sum.elim left right = y ∘ index := by
      funext s
      cases s with
      | inl a => simp [left, y, index]
      | inr v =>
          change x v - x root = if (v : V) = root then x root else x v - x root
          rw [if_neg v.property]
    rw [hfamily]
    exact hcomp
  have hleft := (differentialIndependent_sumElim_right_iff left right).mp hsum |>.2
  let S := differentialAdjoin F (Set.range right)
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  simpa [left, S] using hleft

/-- **Represented-family Kolchin closure law.** The closure of any indexed subfamily is exactly the
preimage of the differential-algebraic closure generated by its represented values. No injectivity
or independence hypothesis is needed. -/
theorem differentialFamilyMatroid_closure_eq_preimage_differentialClosure
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (I : Set V) :
    (differentialFamilyMatroid (F := F) x).closure I =
      x ⁻¹' differentialClosure F (x '' I) := by
  rw [differentialFamilyMatroid, Matroid.comap_closure_eq,
    differentialMatroid_closure_eq_differentialClosure]

/-- **Represented-family closure/DA Prop interface.** An index lies in the closure of an arbitrary
indexed subfamily exactly when its represented value is differentially algebraic over the
differential field generated by that subfamily's values. -/
theorem differentialFamilyMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin_image
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) {I : Set V} {i : V} :
    i ∈ (differentialFamilyMatroid (F := F) x).closure I ↔
      DifferentialAlgebraicOver (differentialAdjoin F (x '' I)) (x i) := by
  rw [differentialFamilyMatroid_closure_eq_preimage_differentialClosure]
  rfl

/-- **Relative DA transport across representations.** Equality of represented differential
matroids transports differential algebraicity over every indexed generated field, even when the
two representations use different coefficient and ambient fields. -/
theorem differentialAlgebraicOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    {F K : Type u} {F' K' : Type w} {V : Type v}
    [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    [Field F'] [Field K'] [Algebra F' K']
    [Differential F'] [Differential K'] [DifferentialAlgebra F' K'] [CharZero K']
    (x : V → K) (y : V → K')
    (hmatroid : differentialFamilyMatroid (F := F) x =
      differentialFamilyMatroid (F := F') y)
    (I : Set V) (i : V) :
    DifferentialAlgebraicOver (differentialAdjoin F (x '' I)) (x i) ↔
      DifferentialAlgebraicOver (differentialAdjoin F' (y '' I)) (y i) := by
  rw [← differentialFamilyMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin_image,
    ← differentialFamilyMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin_image,
    hmatroid]

/-- **Relative HT transport across representations.** The same represented-matroid equality
transports hypertranscendence over every indexed generated field. -/
theorem hypertranscendentalOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    {F K : Type u} {F' K' : Type w} {V : Type v}
    [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    [Field F'] [Field K'] [Algebra F' K']
    [Differential F'] [Differential K'] [DifferentialAlgebra F' K'] [CharZero K']
    (x : V → K) (y : V → K')
    (hmatroid : differentialFamilyMatroid (F := F) x =
      differentialFamilyMatroid (F := F') y)
    (I : Set V) (i : V) :
    HypertranscendentalOver (differentialAdjoin F (x '' I)) (x i) ↔
      HypertranscendentalOver (differentialAdjoin F' (y '' I)) (y i) :=
  not_congr
    (differentialAlgebraicOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
      x y hmatroid I i)

/-- **Loop/DA interface for represented differential matroids.** An index is a matroid loop
exactly when its represented value is differentially algebraic over the coefficient field. -/
theorem differentialFamilyMatroid_isLoop_iff_differentialAlgebraicOver
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (i : V) :
    (differentialFamilyMatroid (F := F) x).IsLoop i ↔
      DifferentialAlgebraicOver F (x i) := by
  rw [← Matroid.singleton_not_indep
      (M := differentialFamilyMatroid (F := F) x) (e := i)
      (by simp [differentialFamilyMatroid]),
    differentialFamilyMatroid_indep_iff]
  simp only [DifferentialAlgebraicOver]
  let e : Unit ≃ ↑({i} : Set V) :=
    { toFun := fun _ : Unit ↦ (⟨i, by simp⟩ : ↑({i} : Set V))
      invFun := fun _ : ↑({i} : Set V) ↦ ()
      left_inv := fun _ ↦ rfl
      right_inv := fun j ↦ by
        apply Subtype.ext
        exact (Set.mem_singleton_iff.mp j.property).symm }
  simpa [e, Function.comp_def] using
    not_congr (differentialIndependent_equiv e
      (fun j : ↑({i} : Set V) ↦ x j)).symm

/-- **Coloop/relative-HT interface for represented differential matroids.** An index is a coloop
exactly when its value is hypertranscendental over the differential field generated by every
other indexed value. No injectivity or independence of the complementary family is required. -/
theorem differentialFamilyMatroid_isColoop_iff_hypertranscendentalOver_differentialAdjoin_compl
    {F K : Type u} {V : Type v} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (i : V) :
    (differentialFamilyMatroid (F := F) x).IsColoop i ↔
      HypertranscendentalOver
        (differentialAdjoin F (x '' (Set.univ \ {i}))) (x i) := by
  rw [Matroid.isColoop_iff_notMem_closure_compl]
  have hground : (differentialFamilyMatroid (F := F) x).E = Set.univ := by
    simp [differentialFamilyMatroid]
  rw [hground,
    differentialFamilyMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin_image]
  rfl

/-- **Arbitrary pointed-collision relative-DA law.** In any represented pointed collision
family, a marked value is differentially algebraic over an arbitrary indexed observation field
exactly when it is a loop or its label is already observed. This removes both the complement-only
restriction and every injectivity hypothesis from the relative dependence classifier. -/
theorem differentialAlgebraicOver_differentialAdjoin_image_iff_loop_or_observedLabel_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (frame : V → L) (loop : L) (I : Set V) (i : V)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop) :
    DifferentialAlgebraicOver (differentialAdjoin F (x '' I)) (x i) ↔
      frame i = loop ∨ frame i ∈ frame '' I := by
  rw [← differentialFamilyMatroid_mem_closure_iff_differentialAlgebraicOver_differentialAdjoin_image,
    hmatroid, affinePointedCollisionMatroid_mem_closure_iff]

/-- **Arbitrary pointed-collision relative-HT law.** Dually, a marked value is
hypertranscendental over an arbitrary indexed observation field exactly when its label is nonloop
and absent from the observed label set. -/
theorem hypertranscendentalOver_differentialAdjoin_image_iff_nonloop_unobservedLabel_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (frame : V → L) (loop : L) (I : Set V) (i : V)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop) :
    HypertranscendentalOver (differentialAdjoin F (x '' I)) (x i) ↔
      frame i ≠ loop ∧ frame i ∉ frame '' I := by
  simpa [HypertranscendentalOver] using
    not_congr
      (differentialAlgebraicOver_differentialAdjoin_image_iff_loop_or_observedLabel_of_pointedCollisionMatroid
        x frame loop I i hmatroid)

/-- **Unique-label relative-HT spectrum.** If a represented family is a pointed collision
matroid, a value is hypertranscendental over the differential field generated by all other values
exactly when its label is nonloop and uniquely occupied. -/
theorem hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonloop_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (frame : V → L) (loop : L) (i : V)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop) :
    HypertranscendentalOver
        (differentialAdjoin F (x '' (Set.univ \ {i}))) (x i) ↔
      frame i ≠ loop ∧ ∀ j, frame j = frame i → j = i := by
  rw [← differentialFamilyMatroid_isColoop_iff_hypertranscendentalOver_differentialAdjoin_compl,
    hmatroid, affinePointedCollisionMatroid_isColoop_iff]

/-- **Exact loop-or-collision relative-DA spectrum.** In a represented pointed collision family,
a value is differentially algebraic over all the other values exactly when its label is the loop
label or another index carries the same label. -/
theorem differentialAlgebraicOver_differentialAdjoin_compl_iff_loop_or_collision_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (x : V → K) (frame : V → L) (loop : L) (i : V)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop) :
    DifferentialAlgebraicOver
        (differentialAdjoin F (x '' (Set.univ \ {i}))) (x i) ↔
      frame i = loop ∨ ∃ j, j ≠ i ∧ frame j = frame i := by
  simpa only [Set.mem_image, Set.mem_diff, Set.mem_univ, true_and,
    Set.mem_singleton_iff] using
    (differentialAlgebraicOver_differentialAdjoin_image_iff_loop_or_observedLabel_of_pointedCollisionMatroid
      x frame loop (Set.univ \ {i}) i hmatroid)

/-- **Differential-algebraic loop common-mode spectrum.** Suppose the subfamily away from one
distinguished label is differentially independent, while every entry carrying that label is
differentially algebraic. Then an anchor is hypertranscendental over the complete pairwise-
difference field exactly when the distinguished label is absent.

Unlike the zero-anchor generated-field law, the distinguished entries need not vanish or belong
to the coefficient field. Their differential algebraicity is exactly enough to make the common
mode DA when the label occurs, while absence leaves a genuinely hypertranscendental mode. -/
theorem hypertranscendentalOver_anchor_pairwiseDifferences_iff_loop_not_mem_range_of_nonloop_independent
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (x : V → K) (frame : V → L) (loop : L)
    (hnonloop : DifferentialIndependent F
      (fun i : ↑({i | frame i ≠ loop} : Set V) ↦ x i))
    (hloop : ∀ i, frame i = loop → DifferentialAlgebraicOver F (x i)) :
    HypertranscendentalOver
        (differentialAdjoin F
          (Set.range fun p : V × V ↦ x p.1 - x p.2))
        (x anchor) ↔
      loop ∉ Set.range frame := by
  constructor
  · intro hht hloopRange
    obtain ⟨root, hroot⟩ := hloopRange
    let S := differentialAdjoin F
      (Set.range fun p : V × V ↦ x p.1 - x p.2)
    letI : DifferentialAlgebra S K :=
      ⟨fun c ↦ derivationClosedDifferential_apply S
        (derivationClosed_differentialAdjoin F
          (Set.range fun p : V × V ↦ x p.1 - x p.2)) c⟩
    have hrootDA : DifferentialAlgebraicOver S (x root) :=
      differentialAlgebraicOver_mono (hloop root hroot)
    have hdiffMem : x anchor - x root ∈ S :=
      subset_differentialAdjoin F _ (Set.mem_range_self (anchor, root))
    have hdiffDA : DifferentialAlgebraicOver S (x anchor - x root) := by
      simpa using differentialAlgebraicOver_algebraMap
        (F := S) (E := K) (⟨x anchor - x root, hdiffMem⟩ : S)
    exact hht (by
      simpa only [sub_add_cancel] using differentialAlgebraicOver_add hdiffDA hrootDA)
  · intro hloopRange
    let embed : V → ↑({i | frame i ≠ loop} : Set V) := fun i ↦
      ⟨i, fun hi ↦ hloopRange (hi ▸ Set.mem_range_self i)⟩
    have hembed : Function.Injective embed := by
      intro i j hij
      exact congrArg Subtype.val hij
    have hx : DifferentialIndependent F x := by
      have hcomp := hnonloop.comp embed hembed
      simpa only [embed] using hcomp
    exact hypertranscendentalOver_anchor_pairwiseDifferences anchor x hx

/-- **Pointed-matroid common-mode spectrum.** If a represented differential family is exactly a
pointed collision matroid and its occupied nonloop labels are injective, then every anchor is
hypertranscendental over the complete pairwise reporter field exactly when the loop label is
absent. The matroid equality itself discharges both analytic hypotheses: nonloop independence and
differential algebraicity of loop entries. -/
theorem hypertranscendentalOver_anchor_pairwiseDifferences_iff_loop_not_mem_range_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (x : V → K) (frame : V → L) (loop : L)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop)
    (hframe : Set.InjOn frame {i | frame i ≠ loop}) :
    HypertranscendentalOver
        (differentialAdjoin F
          (Set.range fun p : V × V ↦ x p.1 - x p.2))
        (x anchor) ↔
      loop ∉ Set.range frame := by
  apply
    hypertranscendentalOver_anchor_pairwiseDifferences_iff_loop_not_mem_range_of_nonloop_independent
      anchor x frame loop
  · rw [← differentialFamilyMatroid_indep_iff, hmatroid,
      affinePointedCollisionMatroid_indep_iff]
    exact ⟨hframe, fun _ hi ↦ hi⟩
  · intro i hi
    apply
      (differentialFamilyMatroid_isLoop_iff_differentialAlgebraicOver x i).mp
    rw [hmatroid]
    simp [affinePointedCollisionMatroid, hi]

/-- **Contracted-matroid common-mode spectrum.** Under the pointed collision model, contracting
all pairwise differences leaves the absolute anchor as a nonloop exactly when the distinguished
loop label is absent. Thus the reporter's hidden hypertranscendental mode is literally its unique
surviving atomic direction in the ambient differential matroid. -/
theorem differentialMatroid_contract_pairwiseDifferences_isNonloop_iff_loop_not_mem_range_of_pointedCollisionMatroid
    {F K : Type u} {V : Type v} {L : Type w} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (x : V → K) (frame : V → L) (loop : L)
    (hmatroid : differentialFamilyMatroid (F := F) x =
      affinePointedCollisionMatroid frame loop)
    (hframe : Set.InjOn frame {i | frame i ≠ loop}) :
    (Matroid.contract (differentialMatroid F K)
        (Set.range (fun p : V × V ↦ x p.1 - x p.2))).IsNonloop (x anchor) ↔
      loop ∉ Set.range frame := by
  rw [differentialMatroid_contract_isNonloop_iff_hypertranscendentalOver]
  exact
    hypertranscendentalOver_anchor_pairwiseDifferences_iff_loop_not_mem_range_of_pointedCollisionMatroid
      anchor x frame loop hmatroid hframe

/-- No anchor of a differentially independent family belongs to its complete pairwise-difference
field. This is the field-membership shadow of the stronger hypertranscendental common-mode law. -/
theorem anchor_not_mem_differentialAdjoin_pairwiseDifferences
    {F K V : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (root : V) (x : V → K) (hx : DifferentialIndependent F x) :
    x root ∉ differentialAdjoin F
      (Set.range fun p : V × V ↦ x p.1 - x p.2) := by
  intro hmem
  exact (hypertranscendentalOver_anchor_pairwiseDifferences root x hx) <| by
    simpa using differentialAlgebraicOver_algebraMap
      (F := differentialAdjoin F
        (Set.range fun p : V × V ↦ x p.1 - x p.2))
      (E := K)
      (⟨x root, hmem⟩ : differentialAdjoin F
        (Set.range fun p : V × V ↦ x p.1 - x p.2))

/-- **Strict arbitrary pairwise field-loss law.** A differentially independent family over any
index type always generates a strictly larger differential field than its complete pairwise-
difference reporter. -/
theorem differentialAdjoin_range_pairwiseDifferences_ne_of_differentialIndependent
    {F K V : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (root : V) (x : V → K) (hx : DifferentialIndependent F x) :
    differentialAdjoin F (Set.range fun p : V × V ↦ x p.1 - x p.2) ≠
      differentialAdjoin F (Set.range x) := by
  intro h
  exact anchor_not_mem_differentialAdjoin_pairwiseDifferences root x hx
    ((differentialAdjoin_range_pairwiseDifferences_eq_iff_root_mem root x).1 h)

/-- **Graded common-mode hypertranscendence.** If a distinguished zero-valued label is absent from
an arbitrary labelled family and the occupied label values are differentially independent, then
every occupied value is hypertranscendental over the complete pairwise reporter field. Repeated
labels are harmless: the statement descends through the occupied-label quotient. -/
theorem hypertranscendentalOver_gradedPairwiseDifferences_of_loop_not_mem_range
    {F K V L : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (frame : V → L) (loop : L) (x : L → K)
    (hx : DifferentialIndependent F
      (fun q : pointedOccupiedLabelSupport frame loop ↦ x q))
    (hloop : loop ∉ Set.range frame) :
    HypertranscendentalOver
      (differentialAdjoin F
        (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)))
      (x (frame anchor)) := by
  let occupied : Set L := Set.range frame
  let support : Set L := {q | q ∈ Set.range frame ∧ q ≠ loop}
  let toSupport : ↑occupied → ↑support := fun q ↦
    ⟨q, q.property, fun hq ↦ hloop (hq ▸ q.property)⟩
  have htoSupport : Function.Injective toSupport := by
    intro q r hqr
    apply Subtype.ext
    exact congrArg (fun z : ↑support ↦ (z : L)) hqr
  have hxOccupied : DifferentialIndependent F
      (fun q : ↑occupied ↦ x q) := by
    have hcomp := hx.comp toSupport htoSupport
    simpa only [support, occupied, toSupport] using hcomp
  let occupiedAnchor : ↑occupied :=
    ⟨frame anchor, Set.mem_range_self anchor⟩
  have hht :=
    hypertranscendentalOver_anchor_pairwiseDifferences
      (F := F) occupiedAnchor (fun q : ↑occupied ↦ x q) hxOccupied
  rw [range_pairwiseComp_eq_occupiedRange frame x]
  simpa [occupiedAnchor, occupied] using hht

/-- **Arbitrary pointed occupied-label field classifier.** Suppose the distinguished label has
value zero and all occupied nonloop label values are jointly differentially independent. For an
arbitrarily indexed family, the complete pairwise reporter recovers the vertex differential field
exactly when the distinguished label is occupied. -/
theorem differentialAdjoin_range_gradedPairwiseDifferences_eq_iff_loop_mem_range_arbitrary
    {F K V L : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (frame : V → L) (loop : L) (x : L → K)
    (hx0 : x loop = 0)
    (hx : DifferentialIndependent F
      (fun q : pointedOccupiedLabelSupport frame loop ↦ x q)) :
    differentialAdjoin F
        (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)) =
      differentialAdjoin F (Set.range fun v ↦ x (frame v)) ↔
      loop ∈ Set.range frame := by
  constructor
  · intro hfield
    by_contra hloop
    let occupied : Set L := Set.range frame
    let support : Set L := {q | q ∈ Set.range frame ∧ q ≠ loop}
    let toSupport : ↑occupied → ↑support := fun q ↦
      ⟨q, q.property, fun hq ↦ hloop (hq ▸ q.property)⟩
    have htoSupport : Function.Injective toSupport := by
      intro q r hqr
      apply Subtype.ext
      exact congrArg (fun z : ↑support ↦ (z : L)) hqr
    have hxOccupied : DifferentialIndependent F
        (fun q : ↑occupied ↦ x q) := by
      have hcomp := hx.comp toSupport htoSupport
      simpa only [support, occupied, toSupport] using hcomp
    let occupiedAnchor : ↑occupied :=
      ⟨frame anchor, Set.mem_range_self anchor⟩
    have hstrict :=
      differentialAdjoin_range_pairwiseDifferences_ne_of_differentialIndependent
        (F := F) occupiedAnchor (fun q : ↑occupied ↦ x q) hxOccupied
    apply hstrict
    rw [← range_pairwiseComp_eq_occupiedRange frame x,
      ← range_comp_eq_occupiedRange frame x]
    exact hfield
  · rintro ⟨root, hroot⟩
    have hrootZero : x (frame root) = 0 := by rw [hroot, hx0]
    exact differentialAdjoin_range_pairwiseDifferences_eq_of_root_zero
      (F := F) (K := K) root (fun v ↦ x (frame v)) hrootZero

/-- **Exact graded common-mode spectrum.** Under pointed occupied-label independence, an occupied
value is hypertranscendental over the complete pairwise reporter field exactly when the
distinguished zero-valued label is absent. This upgrades the generated-field classifier to a
hypothesis-free hypertranscendence Prop interface. -/
theorem hypertranscendentalOver_gradedPairwiseDifferences_iff_loop_not_mem_range
    {F K V L : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    (anchor : V) (frame : V → L) (loop : L) (x : L → K)
    (hx0 : x loop = 0)
    (hx : DifferentialIndependent F
      (fun q : pointedOccupiedLabelSupport frame loop ↦ x q)) :
    HypertranscendentalOver
        (differentialAdjoin F
          (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)))
        (x (frame anchor)) ↔
      loop ∉ Set.range frame := by
  constructor
  · intro hht hloop
    have hfield :=
      (differentialAdjoin_range_gradedPairwiseDifferences_eq_iff_loop_mem_range_arbitrary
        (F := F) (K := K) anchor frame loop x hx0 hx).2 hloop
    have hmem : x (frame anchor) ∈
        differentialAdjoin F
          (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)) := by
      rw [hfield]
      exact subset_differentialAdjoin F _ (Set.mem_range_self anchor)
    exact hht <| by
      simpa using differentialAlgebraicOver_algebraMap
        (F := differentialAdjoin F
          (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)))
        (E := K)
        (⟨x (frame anchor), hmem⟩ : differentialAdjoin F
          (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)))
  · exact hypertranscendentalOver_gradedPairwiseDifferences_of_loop_not_mem_range
      anchor frame loop x hx

/-- **Pointed occupied-label field classifier.** Suppose the distinguished label has value zero
and the values at every occupied non-distinguished label are jointly differentially independent.
Then the complete pairwise reporter recovers the vertex differential field exactly when the
distinguished label is actually occupied. Repeated labels are allowed. -/
theorem differentialAdjoin_range_gradedPairwiseDifferences_eq_iff_loop_mem_range
    {F K V L : Type u} [Field F] [Field K] [Algebra F K]
    [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    [Fintype V] [DecidableEq L]
    (anchor : V) (frame : V → L) (loop : L) (x : L → K)
    (hx0 : x loop = 0)
    (hx : DifferentialIndependent F
      (fun q : ↑((Finset.univ.image frame).erase loop) ↦ x q)) :
    differentialAdjoin F
        (Set.range fun p : V × V ↦ x (frame p.1) - x (frame p.2)) =
      differentialAdjoin F (Set.range fun v ↦ x (frame v)) ↔
      loop ∈ Set.range frame := by
  constructor
  · intro hfield
    by_contra hloop
    have hloopImage : loop ∉ Finset.univ.image frame := by
      intro hmem
      rcases Finset.mem_image.mp hmem with ⟨v, -, hv⟩
      exact hloop ⟨v, hv⟩
    have herase :
        (Finset.univ.image frame).erase loop = Finset.univ.image frame :=
      Finset.erase_eq_self.mpr hloopImage
    have hxOccupied : DifferentialIndependent F
        (fun q : ↑(Finset.univ.image frame) ↦ x q) := by
      have hx' := hx
      rw [herase] at hx'
      exact hx'
    let occupiedAnchor : ↑(Finset.univ.image frame) :=
      ⟨frame anchor, Finset.mem_image.mpr
        ⟨anchor, Finset.mem_univ anchor, rfl⟩⟩
    have hstrict :=
      differentialAdjoin_range_pairwiseDifferences_ne_of_differentialIndependent
        (F := F) occupiedAnchor
          (fun q : ↑(Finset.univ.image frame) ↦ x q) hxOccupied
    apply hstrict
    rw [← range_pairwiseComp_eq_occupiedLabels frame x,
      ← range_comp_eq_occupiedLabels frame x]
    exact hfield
  · rintro ⟨root, hroot⟩
    have hrootZero : x (frame root) = 0 := by rw [hroot, hx0]
    exact differentialAdjoin_range_pairwiseDifferences_eq_of_root_zero
      (F := F) (K := K) root (fun v ↦ x (frame v)) hrootZero

end

