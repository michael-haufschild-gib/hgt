import GaloisForLFunctions.HTGeometry.HypoexponentialGreenFormation
import GaloisForLFunctions.HTGeometry.QuasiPolynomialDerivativeLaplace

/-!
# Hypoexponential laws of finitely many exponential phases

For rates `ρ_1, …, ρ_N > 0` the law `Exp(ρ_1) ∗ ⋯ ∗ Exp(ρ_N)` of the independent sum
`X_{ρ_1} + ⋯ + X_{ρ_N}` is carried by `[0, ∞)`.  Its distribution function is generated by the
causal recursion `K_{ρ :: ρs}(t) = ∫₀ᵗ ρ e^{-ρ(t-s)} K_{ρs}(s) ds`, `K_{[]} = 1`; it is the
quasi-polynomial `ρ_1 ⋯ ρ_N` times iterated exponential convolutions of the constant `1`, with
Laplace transform `𝓛K(q) = q⁻¹ Π ρ_i/(q + ρ_i)` for `Re q > 0`, and it vanishes to order `N` at
the origin.  Smaller rates give stochastically larger sums, so the distribution function is
monotone in every rate; with all rates equal to `λ` it is the Erlang distribution function
`G_{N,λ}(t) = 1 - e^{-λt} Σ_{j<N} (λt)^j/j!`, which is positive for `t > 0` and at most
`(λt)^N/N!`.
-/

open MeasureTheory Set Filter Topology ProbabilityTheory
open scoped ENNReal

noncomputable section

namespace GaloisForLFunctions.HTGeometry.PrimeShiftSource

/-! ### Convolution with an exponential law -/

/-- The causal exponential kernel transform `∫₀ᵗ r e^{-r(t-s)} F(s) ds`. -/
def expKernelConv (r : ℝ) (F : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..t, r * Real.exp (-(r * (t - s))) * F s

theorem expKernelConv_eq (r : ℝ) (F : ℝ → ℝ) (t : ℝ) :
    expKernelConv r F t = Real.exp (-(r * t)) * ∫ s in (0 : ℝ)..t, r * Real.exp (r * s) * F s := by
  rw [expKernelConv, ← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun s _ => ?_
  show r * Real.exp (-(r * (t - s))) * F s = Real.exp (-(r * t)) * (r * Real.exp (r * s) * F s)
  rw [show -(r * (t - s)) = -(r * t) + r * s by ring, Real.exp_add]
  ring

theorem continuous_expKernelConv (r : ℝ) {F : ℝ → ℝ} (hF : Continuous F) :
    Continuous (expKernelConv r F) := by
  have hc : Continuous fun s => r * Real.exp (r * s) * F s := by fun_prop
  rw [show expKernelConv r F = fun t =>
    Real.exp (-(r * t)) * ∫ s in (0 : ℝ)..t, r * Real.exp (r * s) * F s from
      funext (expKernelConv_eq r F)]
  exact (by fun_prop : Continuous fun t => Real.exp (-(r * t))).mul
    (intervalIntegral.continuous_primitive (fun a b => hc.intervalIntegrable a b) 0)

theorem hasDerivAt_exp_mul_expKernelConv (r : ℝ) {F : ℝ → ℝ} (hF : Continuous F) (s : ℝ) :
    HasDerivAt (fun s => Real.exp (r * s) * expKernelConv r F s)
      (r * Real.exp (r * s) * F s) s := by
  have hc : Continuous fun s => r * Real.exp (r * s) * F s := by fun_prop
  have hfun : (fun s => Real.exp (r * s) * expKernelConv r F s) =
      fun s => ∫ u in (0 : ℝ)..s, r * Real.exp (r * u) * F u := by
    funext s
    rw [expKernelConv_eq, ← mul_assoc, ← Real.exp_add, show r * s + -(r * s) = 0 by ring,
      Real.exp_zero, one_mul]
  rw [hfun]
  exact intervalIntegral.integral_hasDerivAt_right (hc.intervalIntegrable 0 s)
    hc.aestronglyMeasurable.stronglyMeasurableAtFilter hc.continuousAt

theorem expKernelConv_zero (r : ℝ) (F : ℝ → ℝ) : expKernelConv r F 0 = 0 := by
  simp [expKernelConv]

/-- Convolving a law carried by `[0, ∞)` with `Exp(r)` applies the causal kernel transform to its
distribution function. -/
theorem HasHalfLineCDF.expConvKernel {r : ℝ} (hr : 0 < r) {ν : Measure ℝ} [SFinite ν]
    {F : ℝ → ℝ} (hν : HasHalfLineCDF ν F) :
    HasHalfLineCDF (expMeasure r ∗ ν) (expKernelConv r F) :=
  hν.expConv hr (continuous_expKernelConv r hν.continuous) (expKernelConv_zero r F)
    (hasDerivAt_exp_mul_expKernelConv r hν.continuous)

theorem hasHalfLineCDF_dirac_zero : HasHalfLineCDF (Measure.dirac 0) fun _ => 1 := by
  refine ⟨continuous_const, fun _ _ => zero_le_one, fun s hs => ?_, fun s hs => ?_⟩
  · rw [Measure.dirac_apply' _ measurableSet_Iic, indicator_of_mem (show (0 : ℝ) ∈ Iic s from hs)]
    simp
  · rw [Measure.dirac_apply' _ measurableSet_Iic,
      indicator_of_notMem (show (0 : ℝ) ∉ Iic s from fun h => absurd h (not_le.mpr hs))]

/-! ### The hypoexponential law of a list of rates -/

/-- The law `Exp(ρ_1) ∗ ⋯ ∗ Exp(ρ_N)` of `X_{ρ_1} + ⋯ + X_{ρ_N}`. -/
def hypoMeasureList : List ℝ → Measure ℝ
  | [] => Measure.dirac 0
  | ρ :: ρs => expMeasure ρ ∗ hypoMeasureList ρs

/-- Its distribution function, by the causal recursion. -/
def hypoCDFList : List ℝ → ℝ → ℝ
  | [] => fun _ => 1
  | ρ :: ρs => expKernelConv ρ (hypoCDFList ρs)

theorem isProbabilityMeasure_hypoMeasureList :
    ∀ {ρs : List ℝ}, (∀ ρ ∈ ρs, 0 < ρ) → IsProbabilityMeasure (hypoMeasureList ρs)
  | [], _ => by rw [hypoMeasureList]; infer_instance
  | ρ :: ρs, h => by
    haveI := isProbabilityMeasure_expMeasure (h ρ List.mem_cons_self)
    haveI := isProbabilityMeasure_hypoMeasureList fun x hx => h x (List.mem_cons_of_mem ρ hx)
    rw [hypoMeasureList]
    infer_instance

/-- **`hypoCDFList ρs` is the distribution function of `X_{ρ_1} + ⋯ + X_{ρ_N}`.** -/
theorem hasHalfLineCDF_hypoMeasureList :
    ∀ {ρs : List ℝ}, (∀ ρ ∈ ρs, 0 < ρ) → HasHalfLineCDF (hypoMeasureList ρs) (hypoCDFList ρs)
  | [], _ => hasHalfLineCDF_dirac_zero
  | ρ :: ρs, h => by
    haveI := isProbabilityMeasure_hypoMeasureList fun x hx => h x (List.mem_cons_of_mem ρ hx)
    exact (hasHalfLineCDF_hypoMeasureList fun x hx => h x (List.mem_cons_of_mem ρ hx)).expConvKernel
      (h ρ List.mem_cons_self)

theorem continuous_hypoCDFList : ∀ ρs : List ℝ, Continuous (hypoCDFList ρs)
  | [] => continuous_const
  | ρ :: ρs => continuous_expKernelConv ρ (continuous_hypoCDFList ρs)

theorem cdf_hypoMeasureList {ρs : List ℝ} (h : ∀ ρ ∈ ρs, 0 < ρ) {t : ℝ} (ht : 0 ≤ t) :
    cdf (hypoMeasureList ρs) t = hypoCDFList ρs t := by
  haveI := isProbabilityMeasure_hypoMeasureList h
  have h1 := (hasHalfLineCDF_hypoMeasureList h).Iic_eq t ht
  rw [← ofReal_cdf] at h1
  exact (ENNReal.ofReal_eq_ofReal_iff (cdf_nonneg _ _)
    ((hasHalfLineCDF_hypoMeasureList h).nonneg t ht)).mp h1

theorem hypoCDFList_nonneg {ρs : List ℝ} (h : ∀ ρ ∈ ρs, 0 < ρ) {t : ℝ} (ht : 0 ≤ t) :
    0 ≤ hypoCDFList ρs t :=
  (hasHalfLineCDF_hypoMeasureList h).nonneg t ht

theorem hypoCDFList_le_one {ρs : List ℝ} (h : ∀ ρ ∈ ρs, 0 < ρ) {t : ℝ} (ht : 0 ≤ t) :
    hypoCDFList ρs t ≤ 1 := by
  rw [← cdf_hypoMeasureList h ht]
  exact cdf_le_one _ _

theorem monotoneOn_hypoCDFList {ρs : List ℝ} (h : ∀ ρ ∈ ρs, 0 < ρ) :
    MonotoneOn (hypoCDFList ρs) (Ici 0) := fun s hs t ht hst => by
  rw [← cdf_hypoMeasureList h hs, ← cdf_hypoMeasureList h ht]
  exact monotone_cdf _ hst

theorem tendsto_hypoCDFList_atTop {ρs : List ℝ} (h : ∀ ρ ∈ ρs, 0 < ρ) :
    Tendsto (hypoCDFList ρs) atTop (𝓝 1) := by
  haveI := isProbabilityMeasure_hypoMeasureList h
  refine (tendsto_cdf_atTop (hypoMeasureList ρs)).congr' ?_
  filter_upwards [eventually_ge_atTop 0] with t ht
  exact cdf_hypoMeasureList h ht

/-! ### Stochastic order in the rates -/

theorem forall₂_pos_right :
    ∀ {σs ρs : List ℝ}, List.Forall₂ (· ≤ ·) σs ρs → (∀ σ ∈ σs, 0 < σ) → ∀ ρ ∈ ρs, 0 < ρ
  | [], [], _, _, _, h => absurd h List.not_mem_nil
  | σ :: _, _ :: _, List.Forall₂.cons h1 h2, hp, x, hx => by
    rcases List.mem_cons.1 hx with rfl | hx
    · exact (hp σ List.mem_cons_self).trans_le h1
    · exact forall₂_pos_right h2 (fun y hy => hp y (List.mem_cons_of_mem σ hy)) x hx

/-- Smaller rates give stochastically larger sums. -/
theorem hypoMeasureList_Iic_mono :
    ∀ {σs ρs : List ℝ}, List.Forall₂ (· ≤ ·) σs ρs → (∀ σ ∈ σs, 0 < σ) → ∀ t : ℝ,
      hypoMeasureList σs (Iic t) ≤ hypoMeasureList ρs (Iic t)
  | [], [], _, _, _ => le_rfl
  | σ :: σs, ρ :: ρs, List.Forall₂.cons hσρ hrest, hpos, t => by
    have hσ := hpos σ List.mem_cons_self
    have hσs : ∀ x ∈ σs, 0 < x := fun x hx => hpos x (List.mem_cons_of_mem σ hx)
    have hρs : ∀ x ∈ ρs, 0 < x := forall₂_pos_right hrest hσs
    haveI := isProbabilityMeasure_expMeasure hσ
    haveI := isProbabilityMeasure_expMeasure (hσ.trans_le hσρ)
    haveI := isProbabilityMeasure_hypoMeasureList hσs
    haveI := isProbabilityMeasure_hypoMeasureList hρs
    calc hypoMeasureList (σ :: σs) (Iic t) = (expMeasure σ ∗ hypoMeasureList σs) (Iic t) := rfl
      _ ≤ (expMeasure ρ ∗ hypoMeasureList σs) (Iic t) :=
          conv_Iic_mono_left _ (expMeasure_Iic_mono hσ hσρ) t
      _ ≤ (expMeasure ρ ∗ hypoMeasureList ρs) (Iic t) :=
          conv_Iic_mono_right _ (hypoMeasureList_Iic_mono hrest hσs) t
      _ = hypoMeasureList (ρ :: ρs) (Iic t) := rfl

/-- The distribution function is monotone in every rate. -/
theorem hypoCDFList_mono {σs ρs : List ℝ} (h : List.Forall₂ (· ≤ ·) σs ρs)
    (hpos : ∀ σ ∈ σs, 0 < σ) {t : ℝ} (ht : 0 ≤ t) : hypoCDFList σs t ≤ hypoCDFList ρs t := by
  have hρs : ∀ x ∈ ρs, 0 < x := forall₂_pos_right h hpos
  have hle := hypoMeasureList_Iic_mono h hpos t
  rw [(hasHalfLineCDF_hypoMeasureList hpos).Iic_eq t ht,
    (hasHalfLineCDF_hypoMeasureList hρs).Iic_eq t ht,
    ENNReal.ofReal_le_ofReal_iff (hypoCDFList_nonneg hρs ht)] at hle
  exact hle

/-! ### The Erlang laws -/

/-- The Erlang distribution function `G_{N,λ}(t) = 1 - e^{-λt} Σ_{j<N} (λt)^j/j!`. -/
def erlangCDF (N : ℕ) (l t : ℝ) : ℝ :=
  1 - Real.exp (-(l * t)) * ∑ j ∈ Finset.range N, (l * t) ^ j / j.factorial

theorem hasDerivAt_exp_mul_erlangCDF (N : ℕ) (l s : ℝ) :
    HasDerivAt (fun s => Real.exp (l * s) * erlangCDF (N + 1) l s)
      (l * Real.exp (l * s) * erlangCDF N l s) s := by
  have hfun : (fun s => Real.exp (l * s) * erlangCDF (N + 1) l s) =
      fun s => Real.exp (l * s) - ∑ j ∈ Finset.range (N + 1), (l * s) ^ j / j.factorial := by
    funext s
    rw [erlangCDF, mul_sub, mul_one, ← mul_assoc, ← Real.exp_add, show l * s + -(l * s) = 0 by ring,
      Real.exp_zero, one_mul]
  have hsum : HasDerivAt (fun s => ∑ j ∈ Finset.range (N + 1), (l * s) ^ j / j.factorial)
      (∑ j ∈ Finset.range (N + 1), j * (l * s) ^ (j - 1) * l / j.factorial) s := by
    refine HasDerivAt.fun_sum fun j _ => ?_
    have := (((hasDerivAt_id s).const_mul l).pow j).div_const (j.factorial : ℝ)
    refine this.congr_deriv ?_
    simp only [id, mul_one]
  rw [hfun]
  refine ((hasDerivAt_exp_mul l s).sub hsum).congr_deriv ?_
  rw [erlangCDF, Finset.sum_range_succ', Nat.cast_zero, zero_mul, zero_mul, zero_div, add_zero]
  have hterm : ∀ j ∈ Finset.range N, ((j + 1 : ℕ) : ℝ) * (l * s) ^ (j + 1 - 1) * l /
      ((j + 1).factorial : ℝ) = l * ((l * s) ^ j / j.factorial) := fun j _ => by
    rw [Nat.add_sub_cancel, Nat.factorial_succ, Nat.cast_mul]
    field_simp
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
  have he : Real.exp (l * s) * Real.exp (-(l * s)) = 1 := by rw [← Real.exp_add]; simp
  linear_combination (l * ∑ j ∈ Finset.range N, (l * s) ^ j / (j.factorial : ℝ)) * he

/-- **With all rates equal, the hypoexponential law is Erlang.** -/
theorem hypoCDFList_replicate (N : ℕ) (l t : ℝ) :
    hypoCDFList (List.replicate N l) t = erlangCDF N l t := by
  induction N generalizing t with
  | zero => simp [hypoCDFList, erlangCDF]
  | succ N ih =>
    rw [List.replicate_succ, hypoCDFList, show hypoCDFList (List.replicate N l) =
      erlangCDF N l from funext ih, expKernelConv]
    exact integral_exp_kernel_eq (by unfold erlangCDF; fun_prop)
      (by simp [erlangCDF, Finset.sum_range_succ'])
      (hasDerivAt_exp_mul_erlangCDF N l) t

theorem erlangCDF_pos (N : ℕ) {l t : ℝ} (hl : 0 < l) (ht : 0 < t) :
    0 < erlangCDF N l t := by
  have hx : 0 < l * t := mul_pos hl ht
  have h1 := Real.sum_le_exp_of_nonneg hx.le (N + 1)
  rw [Finset.sum_range_succ] at h1
  have h2 : 0 < (l * t) ^ N / (N.factorial : ℝ) := by positivity
  have h3 : ∑ j ∈ Finset.range N, (l * t) ^ j / j.factorial < Real.exp (l * t) := by linarith
  rw [erlangCDF, sub_pos, Real.exp_neg, inv_mul_lt_one₀ (Real.exp_pos _)]
  exact h3

theorem erlangCDF_lt_one {N : ℕ} (hN : 0 < N) {l t : ℝ} (hlt : 0 ≤ l * t) :
    erlangCDF N l t < 1 := by
  rw [erlangCDF, sub_lt_self_iff]
  refine mul_pos (Real.exp_pos _) ?_
  obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
  rw [Finset.sum_range_succ']
  have : 0 ≤ ∑ j ∈ Finset.range M, (l * t) ^ (j + 1) / ((j + 1).factorial : ℝ) :=
    Finset.sum_nonneg fun j _ => by positivity
  simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one]
  linarith

/-- `G_{N,λ}(t) ≤ (λt)^N/N!` for `t ≥ 0`. -/
theorem hypoCDFList_replicate_le_pow (N : ℕ) {l : ℝ} (hl : 0 < l) {t : ℝ} (ht : 0 ≤ t) :
    hypoCDFList (List.replicate N l) t ≤ (l * t) ^ N / N.factorial := by
  induction N generalizing t with
  | zero => simp [hypoCDFList]
  | succ N ih =>
    have hpos : ∀ ρ ∈ List.replicate N l, 0 < ρ := fun ρ hρ => by
      rw [List.eq_of_mem_replicate hρ]; exact hl
    rw [List.replicate_succ, hypoCDFList, expKernelConv]
    have hc1 : Continuous fun s => l * Real.exp (-(l * (t - s))) *
        hypoCDFList (List.replicate N l) s :=
      (by fun_prop : Continuous fun s => l * Real.exp (-(l * (t - s)))).mul
        (continuous_hypoCDFList _)
    have hc2 : Continuous fun s : ℝ => l * ((l * s) ^ N / N.factorial) := by fun_prop
    calc ∫ s in (0 : ℝ)..t, l * Real.exp (-(l * (t - s))) * hypoCDFList (List.replicate N l) s
        ≤ ∫ s in (0 : ℝ)..t, l * ((l * s) ^ N / N.factorial) := by
          refine intervalIntegral.integral_mono_on ht (hc1.intervalIntegrable _ _)
            (hc2.intervalIntegrable _ _) fun s hs => ?_
          have h0 := hypoCDFList_nonneg hpos hs.1
          have he : Real.exp (-(l * (t - s))) ≤ 1 :=
            Real.exp_le_one_iff.mpr (by nlinarith [hs.2])
          calc l * Real.exp (-(l * (t - s))) * hypoCDFList (List.replicate N l) s
              ≤ l * 1 * hypoCDFList (List.replicate N l) s := by gcongr
            _ ≤ l * ((l * s) ^ N / N.factorial) := by
                rw [mul_one]; exact mul_le_mul_of_nonneg_left (ih hs.1) hl.le
      _ = (l * t) ^ (N + 1) / (N + 1).factorial := by
          simp_rw [mul_pow, mul_div_assoc]
          rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
            intervalIntegral.integral_div, integral_pow, Nat.factorial_succ, Nat.cast_mul]
          push_cast
          field_simp
          ring

/-! ### The quasi-polynomial form -/

/-- The quasi-polynomial `K_{ρs}`: `K_{[]} = 1`, `K_{ρ :: ρs} = ρ ∫₀^· e^{-ρ(·-u)} K_{ρs}(u) du`. -/
def hypoQP : List ℝ → QuasiPolynomial
  | [] => Finsupp.single 0 1
  | ρ :: ρs => (ρ : ℂ) • QuasiPolynomial.convExp (-(ρ : ℂ)) (hypoQP ρs)

theorem hypoCDFList_eq_eval : ∀ (ρs : List ℝ) (t : ℝ), (hypoCDFList ρs t : ℂ) = (hypoQP ρs).eval t
  | [], t => by simp [hypoCDFList, hypoQP, QuasiPolynomial.eval_single]
  | ρ :: ρs, t => by
    rw [hypoCDFList, hypoQP, QuasiPolynomial.eval_smul, QuasiPolynomial.eval_convExp,
      expKernelConv, ← intervalIntegral.integral_ofReal, ← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr fun s _ => ?_
    rw [← hypoCDFList_eq_eval ρs s]
    push_cast
    rw [show -((ρ : ℂ) * ((t : ℂ) - s)) = -(ρ : ℂ) * ((t : ℂ) - s) by ring]
    ring

theorem re_le_of_mem_support_hypoQP :
    ∀ {ρs : List ℝ}, (∀ ρ ∈ ρs, 0 < ρ) → ∀ μ ∈ (hypoQP ρs).support, μ.re ≤ 0
  | [], _, μ, hμ => by
    rw [hypoQP] at hμ
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hμ)]
    simp
  | ρ :: ρs, h, μ, hμ => by
    rw [hypoQP] at hμ
    have h1 := Finsupp.support_smul hμ
    rcases Finset.mem_insert.1 (QuasiPolynomial.support_convExp_subset _ _ h1) with h2 | h2
    · rw [h2]; simp [(h ρ List.mem_cons_self).le]
    · exact re_le_of_mem_support_hypoQP (fun x hx => h x (List.mem_cons_of_mem ρ hx)) μ h2

/-- **Laplace transform**: `𝓛K_{ρs}(q) = q⁻¹ Π ρ_i/(q + ρ_i)` for `Re q > 0`. -/
theorem laplace_hypoQP :
    ∀ {ρs : List ℝ}, (∀ ρ ∈ ρs, 0 < ρ) → ∀ {q : ℂ}, 0 < q.re →
      (hypoQP ρs).laplace q = (ρs.map fun ρ : ℝ => (ρ : ℂ) / (q + (ρ : ℂ))).prod / q
  | [], _, q, hq => by
    simp [hypoQP, QuasiPolynomial.laplace_single, QuasiPolynomial.laplaceTerm]
  | ρ :: ρs, h, q, hq => by
    have hρ := h ρ List.mem_cons_self
    have hρs : ∀ x ∈ ρs, 0 < x := fun x hx => h x (List.mem_cons_of_mem ρ hx)
    rw [hypoQP, QuasiPolynomial.laplace_smul, QuasiPolynomial.laplace_convExp _ _
      (fun μ hμ => (re_le_of_mem_support_hypoQP hρs μ hμ).trans_lt hq) (by simp; linarith),
      laplace_hypoQP hρs hq, List.map_cons, List.prod_cons]
    have hq0 : q ≠ 0 := fun h0 => by rw [h0] at hq; simp at hq
    have hqρ : q + ρ ≠ 0 := fun h0 => by
      have := congrArg Complex.re h0; simp at this; linarith
    rw [sub_neg_eq_add]
    field_simp

/-- The distribution function of `N` phases vanishes to order `N` at the origin. -/
theorem iterDeriv_hypoQP_eval_zero :
    ∀ (ρs : List ℝ), ∀ j < ρs.length, (QuasiPolynomial.iterDeriv j (hypoQP ρs)).eval 0 = 0
  | [], j, hj => absurd hj (Nat.not_lt_zero j)
  | ρ :: ρs, j, hj => by
    rw [hypoQP, map_smul, QuasiPolynomial.eval_smul,
      QuasiPolynomial.iterDeriv_convExp_eval_zero _ _ (iterDeriv_hypoQP_eval_zero ρs) j
        (by simpa using hj), mul_zero]

end GaloisForLFunctions.HTGeometry.PrimeShiftSource
