import GaloisForLFunctions.HTGeometry.AffineTopReduction

/-!
# The output-jet determinant of an affinely driven variable

For a variable driven by `δ X = A·X + B` with `A, B` free of `X`, the output-jet Jacobian is a column
pencil in `X` whose constant column is the sequence of homogeneous coefficients `A_i`.  Extracting the
top coefficient and expanding along the row `i = 0` (where `A_0 = 1`) leaves the Jacobian of the
positive coefficients `A_1, A_2, …` against the other variables.

So the observability of an affinely driven variable reduces to the observability of its driving
coefficient — one variable fewer, with no hypothesis beyond freeness.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- The subalgebra generated by all variables except one. -/
noncomputable def freeAlg (N : ℕ) : Subalgebra ℂ (MvPolynomial ℕ ℂ) :=
  Algebra.adjoin ℂ (MvPolynomial.X '' {k : ℕ | k ≠ N})

theorem X_mem_freeAlg {N k : ℕ} (h : k ≠ N) :
    (MvPolynomial.X k : MvPolynomial ℕ ℂ) ∈ freeAlg N :=
  Algebra.subset_adjoin ⟨k, h, rfl⟩

theorem pderiv_eq_zero_of_mem_freeAlg {N : ℕ} {P : MvPolynomial ℕ ℂ} (h : P ∈ freeAlg N) :
    (MvPolynomial.pderiv N) P = 0 := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact MvPolynomial.pderiv_X_of_ne hj
  | algebraMap c =>
      have hc : (algebraMap ℂ (MvPolynomial ℕ ℂ)) c = MvPolynomial.C c := rfl
      rw [hc]
      simp
  | add x y hx hy ihx ihy => rw [map_add, ihx, ihy, add_zero]
  | mul x y hx hy ihx ihy =>
      rw [Derivation.leibniz, ihx, ihy]
      simp

theorem pderiv_mem_freeAlg {N k : ℕ} {P : MvPolynomial ℕ ℂ} (h : P ∈ freeAlg N) :
    (MvPolynomial.pderiv k) P ∈ freeAlg N := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      by_cases hkj : k = j
      · rw [hkj, MvPolynomial.pderiv_X_self]
        exact Subalgebra.one_mem _
      · rw [MvPolynomial.pderiv_X_of_ne (by omega : j ≠ k)]
        exact Subalgebra.zero_mem _
  | algebraMap c =>
      have hc : (algebraMap ℂ (MvPolynomial ℕ ℂ)) c = MvPolynomial.C c := rfl
      rw [hc, MvPolynomial.pderiv_C]
      exact Subalgebra.zero_mem _
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy =>
      simp only [Derivation.leibniz, smul_eq_mul]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx ihy) (Subalgebra.mul_mem _ hy ihx)

/-- Substituting a fresh polynomial variable for the driven variable. -/
noncomputable def varSub (N : ℕ) : MvPolynomial ℕ ℂ →ₐ[ℂ] Polynomial (MvPolynomial ℕ ℂ) :=
  MvPolynomial.aeval fun k =>
    if k = N then Polynomial.X else Polynomial.C (MvPolynomial.X k)

@[simp] theorem varSub_X_self (N : ℕ) :
    varSub N (MvPolynomial.X N) = Polynomial.X := by
  simp [varSub]

theorem varSub_X_of_ne {N k : ℕ} (h : k ≠ N) :
    varSub N (MvPolynomial.X k) = Polynomial.C (MvPolynomial.X k) := by
  simp [varSub, h]

theorem varSub_eq_C_of_mem_freeAlg {N : ℕ} {P : MvPolynomial ℕ ℂ} (h : P ∈ freeAlg N) :
    varSub N P = Polynomial.C P := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact varSub_X_of_ne hj
  | algebraMap c =>
      have hc : (algebraMap ℂ (MvPolynomial ℕ ℂ)) c = MvPolynomial.C c := rfl
      rw [hc]
      simp [varSub]
  | add x y hx hy ihx ihy => rw [map_add, ihx, ihy, map_add]
  | mul x y hx hy ihx ihy => rw [map_mul, ihx, ihy, map_mul]

/-! ## The reduction -/

variable {δ : Derivation ℂ (MvPolynomial ℕ ℂ) (MvPolynomial ℕ ℂ)}

/-- **Observability of an affinely driven variable reduces to that of its driver.** -/
theorem det_ne_zero_of_affine_top {N n : ℕ} (c : Fin n → ℕ) (hc : ∀ j, c j ≠ N)
    {A B : MvPolynomial ℕ ℂ}
    (hlaw : δ (MvPolynomial.X N) = A * MvPolynomial.X N + B)
    (hδ : ∀ P ∈ freeAlg N, δ P ∈ freeAlg N)
    (hA : A ∈ freeAlg N) (hB : B ∈ freeAlg N)
    (hsub : (Matrix.of fun i j : Fin n =>
        (MvPolynomial.pderiv (c j)) (affineJetA δ A ((i : ℕ) + 1))).det ≠ 0) :
    (Matrix.of fun i j : Fin (n + 1) =>
        Fin.lastCases (motive := fun _ => MvPolynomial ℕ ℂ)
          ((MvPolynomial.pderiv N)
            (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N)))
          (fun j' : Fin n => (MvPolynomial.pderiv (c j'))
            (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N))) j).det
      ≠ 0 := by
  classical
  have hAmem : ∀ i, affineJetA δ A i ∈ freeAlg N := affineJetA_mem hδ hA
  have hBmem : ∀ i, affineJetB δ A B i ∈ freeAlg N := affineJetB_mem hδ hA hB
  have hAtop : ∀ i, (MvPolynomial.pderiv N) (affineJetA δ A i) = 0 :=
    fun i => pderiv_eq_zero_of_mem_freeAlg (hAmem i)
  have hBtop : ∀ i, (MvPolynomial.pderiv N) (affineJetB δ A B i) = 0 :=
    fun i => pderiv_eq_zero_of_mem_freeAlg (hBmem i)
  set a : Fin n → Fin (n + 1) → MvPolynomial ℕ ℂ :=
    fun j i => (MvPolynomial.pderiv (c j)) (affineJetB δ A B (i : ℕ)) with hadef
  set b : Fin n → Fin (n + 1) → MvPolynomial ℕ ℂ :=
    fun j i => (MvPolynomial.pderiv (c j)) (affineJetA δ A (i : ℕ)) with hbdef
  set w : Fin (n + 1) → MvPolynomial ℕ ℂ := fun i => affineJetA δ A (i : ℕ) with hwdef
  have hmap : (varSub N).toRingHom.mapMatrix
      (Matrix.of fun i j : Fin (n + 1) =>
        Fin.lastCases (motive := fun _ => MvPolynomial ℕ ℂ)
          ((MvPolynomial.pderiv N)
            (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N)))
          (fun j' : Fin n => (MvPolynomial.pderiv (c j'))
            (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N))) j)
      = columnPencil a b w := by
    funext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply]
    refine Fin.lastCases ?_ ?_ j
    · have h1 : (MvPolynomial.pderiv N)
          (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N)) = w i :=
        pderiv_top_iterate_of_affine hlaw hAtop hBtop (i : ℕ)
      simp only [Matrix.of_apply, Fin.lastCases_last, columnPencil]
      rw [h1, show (varSub N).toRingHom (w i) = varSub N (w i) from rfl,
        varSub_eq_C_of_mem_freeAlg (hAmem (i : ℕ))]
    · intro j'
      have h1 : (MvPolynomial.pderiv (c j'))
          (((δ : MvPolynomial ℕ ℂ → MvPolynomial ℕ ℂ)^[(i : ℕ)]) (MvPolynomial.X N))
          = a j' i + MvPolynomial.X N * b j' i :=
        pderiv_low_iterate_of_affine (hc j') hlaw (i : ℕ)
      simp only [Matrix.of_apply, Fin.lastCases_castSucc, columnPencil]
      rw [h1, show (varSub N).toRingHom (a j' i + MvPolynomial.X N * b j' i)
          = varSub N (a j' i + MvPolynomial.X N * b j' i) from rfl,
        map_add, map_mul, varSub_X_self,
        varSub_eq_C_of_mem_freeAlg (pderiv_mem_freeAlg (hBmem (i : ℕ))),
        varSub_eq_C_of_mem_freeAlg (pderiv_mem_freeAlg (hAmem (i : ℕ)))]
  intro hzero
  have hpencil : (columnPencil a b w).det = 0 := by
    rw [← hmap, ← RingHom.map_det, hzero, map_zero]
  have hlead : (columnLeading b w).det = 0 := by
    rw [← coeff_det_columnPencil a b w, hpencil, Polynomial.coeff_zero]
  have hw0 : w 0 = 1 := by simp [hwdef]
  have hb0 : ∀ j : Fin n, b j 0 = 0 := by
    intro j
    simp [hbdef]
  have hexp : (columnLeading b w).det
      = (-1) ^ n * (Matrix.of fun i j : Fin n => b j i.succ).det :=
    det_columnLeading_of_row_zero b w hw0 hb0
  have hminor : (Matrix.of fun i j : Fin n => b j i.succ).det = 0 := by
    rw [hexp] at hlead
    rcases mul_eq_zero.mp hlead with h | h
    · exact absurd h (pow_ne_zero _ (by norm_num : (-1 : MvPolynomial ℕ ℂ) ≠ 0))
    · exact h
  refine hsub ?_
  have hmat : (Matrix.of fun i j : Fin n =>
      (MvPolynomial.pderiv (c j)) (affineJetA δ A ((i : ℕ) + 1)))
      = Matrix.of fun i j : Fin n => b j i.succ := by
    funext i j
    simp [hbdef, Fin.val_succ]
  rw [hmat]
  exact hminor

end GaloisForLFunctions.HTGeometry
