import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicDerivGen
import GaloisForLFunctions.HTGeometry.DifferentialExchange
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonAllRankQSystem
import Mathlib.Algebra.CharZero.Infinite
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-!
# Differential-algebraic transitivity and rational tensor observables

This module proves the finite-transcendence-degree form of differential-algebraic
transitivity needed by persistent first-order hypertranscendental tails.  It then
uses that theorem to show that a nonzero rational coefficient times a nonzero
integer power of the first jet preserves hypertranscendence.
-/

open scoped Differential
open Set

namespace GaloisForLFunctions

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K]
  [Differential k] [Differential K] [DifferentialAlgebra k K]

set_option maxHeartbeats 400000 in
private theorem algebraicIndependent_nat_of_transcendental_prefix
    (j : ℕ → K)
    (h : ∀ n : ℕ, Transcendental
      (IntermediateField.adjoin k (j '' Set.Iio n)) (j n)) :
    AlgebraicIndependent k j := by
  have hprefix : ∀ n : ℕ, AlgebraicIndepOn k j (Set.Iio n) := by
    intro n
    induction n with
    | zero => simpa using (algebraicIndependent_empty_type :
        AlgebraicIndependent k (fun i : (∅ : Set ℕ) => j i))
    | succ n ih =>
        rw [show Set.Iio (n + 1) = insert n (Set.Iio n) by ext m; simp]
        exact ih.insert (IntermediateField.transcendental_adjoin_iff.mp (h n))
  have hjinj : Function.Injective j := by
    intro m n hmn
    let N := max m n + 1
    have hm : m ∈ Set.Iio N := by simp [N]
    have hn : n ∈ Set.Iio N := by simp [N]
    have hinj := (hprefix N).injective
    exact congrArg Subtype.val (hinj (a₁ := ⟨m, hm⟩) (a₂ := ⟨n, hn⟩) hmn)
  have hsets : (⋃ n : ℕ, j '' Set.Iio n) = Set.range j := by
    ext z
    constructor
    · rintro hz
      rw [Set.mem_iUnion] at hz
      obtain ⟨n, m, -, rfl⟩ := hz
      exact ⟨m, rfl⟩
    · rintro ⟨m, rfl⟩
      rw [Set.mem_iUnion]
      exact ⟨m + 1, m, Nat.lt_succ_self m, rfl⟩
  have hunion : AlgebraicIndependent k
      (fun z : (⋃ n : ℕ, j '' Set.Iio n) => (z : K)) := by
    apply algebraicIndependent_iUnion_of_directed
    · have hmono : Monotone (fun n : ℕ => j '' Set.Iio n) :=
        fun _ _ hmn => Set.image_mono (Set.Iio_subset_Iio hmn)
      exact hmono.directed_le
    · exact fun n => (hprefix n).image
  rw [hsets] at hunion
  exact (algebraicIndependent_subtype_range hjinj).mp hunion

private theorem differentialIndependent_singleton_of_jets (x : K)
    (h : AlgebraicIndependent k (fun n : ℕ => differentialJet n x)) :
    DifferentialIndependent k (fun _ : Unit => x) := by
  unfold DifferentialIndependent
  have h' := h.comp (fun p : Unit × ℕ => p.2) (by
    rintro ⟨u, m⟩ ⟨v, n⟩ hmn
    cases u; cases v
    exact Prod.ext rfl hmn)
  exact h'

set_option maxHeartbeats 100000 in
private theorem exists_algebraic_jet_over_prefix {x : K}
    (hx : DifferentialAlgebraicOver k x) :
    ∃ n : ℕ, IsAlgebraic
      (IntermediateField.adjoin k ((fun m => differentialJet m x) '' Set.Iio n))
      (differentialJet n x) := by
  by_contra h
  push Not at h
  apply hx
  exact differentialIndependent_singleton_of_jets x
    (algebraicIndependent_nat_of_transcendental_prefix
      (fun n => differentialJet n x) (fun n => h n))

/-- The ordinary field generated by the first `n` jets. -/
def differentialJetPrefixField (k : Type*) {K : Type*} [Field k] [Field K]
    [Algebra k K] [Differential K] (x : K) (n : ℕ) : IntermediateField k K :=
  IntermediateField.adjoin k ((fun m => differentialJet m x) '' Set.Iio n)

set_option maxHeartbeats 400000 in
private theorem deriv_prefix_mem_integralClosure
    (x : K) (n : ℕ)
    (hn : IsAlgebraic (differentialJetPrefixField k x n) (differentialJet n x))
    (a : differentialJetPrefixField k x n) :
    Differential.deriv (a : K) ∈
      integralClosure (differentialJetPrefixField k x n) K := by
  let B := differentialJetPrefixField k x n
  change Differential.deriv (a : K) ∈ integralClosure B K
  apply IntermediateField.adjoin_induction k
    (s := (fun m => differentialJet m x) '' Set.Iio n)
    (p := fun y _ => Differential.deriv y ∈ integralClosure B K)
  · rintro _ ⟨m, hm, rfl⟩
    rw [← differentialJet_succ]
    have hle : m + 1 ≤ n := Nat.succ_le_iff.mpr hm
    rcases lt_or_eq_of_le hle with hlt | heq
    · have hmem : differentialJet (m + 1) x ∈ B :=
        IntermediateField.subset_adjoin k _ ⟨m + 1, hlt, rfl⟩
      change IsIntegral B (differentialJet (m + 1) x)
      exact (isAlgebraic_algebraMap (R := B) (A := K)
        (⟨differentialJet (m + 1) x, hmem⟩ : B)).isIntegral
    · subst n
      exact hn.isIntegral
  · intro c
    rw [deriv_algebraMap]
    have hmem : algebraMap k K (Differential.deriv c) ∈ B :=
      IntermediateField.algebraMap_mem B (Differential.deriv c)
    change IsIntegral B (algebraMap k K (Differential.deriv c))
    exact (isAlgebraic_algebraMap (R := B) (A := K)
      (⟨algebraMap k K (Differential.deriv c), hmem⟩ : B)).isIntegral
  · intro u v hu hv hdu hdv
    rw [map_add]
    exact add_mem hdu hdv
  · intro u hu hdu
    rw [Derivation.leibniz_inv]
    have hui : u ∈ integralClosure B K := by
      change IsIntegral B u
      exact (isAlgebraic_algebraMap (R := B) (A := K) (⟨u, hu⟩ : B)).isIntegral
    have huinv : u⁻¹ ∈ integralClosure B K :=
      (show IsIntegral B u from hui).inv_mem hui
    exact mul_mem (neg_mem (pow_mem huinv 2)) hdu
  · intro u v hu hv hdu hdv
    rw [Derivation.leibniz]
    have hui : u ∈ integralClosure B K := by
      change IsIntegral B u
      exact (isAlgebraic_algebraMap (R := B) (A := K) (⟨u, hu⟩ : B)).isIntegral
    have hvi : v ∈ integralClosure B K := by
      change IsIntegral B v
      exact (isAlgebraic_algebraMap (R := B) (A := K) (⟨v, hv⟩ : B)).isIntegral
    exact add_mem (mul_mem hui hdv) (mul_mem hvi hdu)
  exact a.2

set_option maxHeartbeats 300000 in
private theorem all_jets_algebraic_over_prefix [CharZero K]
    (x : K) (n : ℕ)
    (hn : IsAlgebraic (differentialJetPrefixField k x n) (differentialJet n x)) :
    ∀ m : ℕ, IsAlgebraic (differentialJetPrefixField k x n) (differentialJet m x) := by
  intro m
  let B := differentialJetPrefixField k x n
  by_cases hm : m < n
  · have hmem : differentialJet m x ∈ B :=
      IntermediateField.subset_adjoin k _ ⟨m, hm, rfl⟩
    exact isAlgebraic_algebraMap (R := B) (A := K)
      (⟨differentialJet m x, hmem⟩ : B)
  · have hnm : n ≤ m := Nat.le_of_not_gt hm
    obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_le hnm
    have high : ∀ r : ℕ, IsAlgebraic B (differentialJet (n + r) x) := by
      intro s
      induction s with
      | zero => simpa using hn
      | succ s ihs =>
          have hz : differentialJet (n + s) x ∈ integralClosure B K := ihs.isIntegral
          have hnext := deriv_mem_integralClosure B
            (fun a => deriv_prefix_mem_integralClosure x n hn a) hz
          have hnextInt : IsIntegral B
              (Differential.deriv (differentialJet (n + s) x)) := hnext
          have hnextAlg := hnextInt.isAlgebraic
          simpa [← differentialJet_succ, Nat.add_assoc] using hnextAlg
    rw [hr]
    exact high r

set_option maxHeartbeats 300000 in
private theorem differentialAdjoin_element_integral_over_prefix [CharZero K]
    (x : K) (n : ℕ)
    (hn : IsAlgebraic (differentialJetPrefixField k x n) (differentialJet n x))
    (z : differentialAdjoin k ({x} : Set K)) :
    (z : K) ∈ integralClosure (differentialJetPrefixField k x n) K := by
  let B := differentialJetPrefixField k x n
  change (z : K) ∈ integralClosure B K
  apply IntermediateField.adjoin_induction k
    (s := differentialJetSet ({x} : Set K))
    (p := fun y _ => y ∈ integralClosure B K)
  · rintro _ ⟨y, hy, m, rfl⟩
    simp only [Set.mem_singleton_iff] at hy
    subst y
    exact (all_jets_algebraic_over_prefix x n hn m).isIntegral
  · intro c
    have hmem : algebraMap k K c ∈ B := IntermediateField.algebraMap_mem B c
    change IsIntegral B (algebraMap k K c)
    exact (isAlgebraic_algebraMap (R := B) (A := K)
      (⟨algebraMap k K c, hmem⟩ : B)).isIntegral
  · exact fun _ _ _ _ hu hv => add_mem hu hv
  · intro u hu huint
    exact (show IsIntegral B u from huint).inv_mem huint
  · exact fun _ _ _ _ hu hv => mul_mem hu hv
  exact z.2

set_option maxHeartbeats 500000 in
theorem differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic [CharZero K]
    {x : K} (hx : DifferentialAlgebraicOver k x) :
    Algebra.trdeg k (differentialAdjoin k ({x} : Set K)) < Cardinal.aleph0 := by
  obtain ⟨n, hn⟩ := exists_algebraic_jet_over_prefix hx
  let B := differentialJetPrefixField k x n
  let F := differentialAdjoin k ({x} : Set K)
  change Algebra.trdeg k F < Cardinal.aleph0
  have hBF : B ≤ F := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨m, hm, rfl⟩
    exact differentialJet_mem_differentialAdjoin k (s := ({x} : Set K)) rfl m
  letI : Algebra B F := (IntermediateField.inclusion hBF).toAlgebra
  haveI : IsScalarTower k B F := .of_algebraMap_eq fun _ => rfl
  haveI : IsScalarTower B F K := .of_algebraMap_eq fun _ => rfl
  letI : Algebra.IsAlgebraic B F := ⟨fun z => by
    apply (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom B F K)
      (algebraMap F K).injective).mp
    exact (differentialAdjoin_element_integral_over_prefix x n hn z).isAlgebraic⟩
  let jB : Fin n → B := fun i =>
    ⟨differentialJet i x, IntermediateField.subset_adjoin k _ ⟨i, i.isLt, rfl⟩⟩
  have hBtop : IntermediateField.adjoin k (Set.range jB) = ⊤ := by
    let J := IntermediateField.adjoin k (Set.range jB)
    apply top_unique
    intro b hb
    change b ∈ J
    let p : ∀ z, z ∈ B → Prop := fun z hz => (⟨z, hz⟩ : B) ∈ J
    change p (b : K) b.2
    refine IntermediateField.adjoin_induction k (p := p) ?_ ?_ ?_ ?_ ?_ b.2
    · intro z hz
      obtain ⟨m, hm, rfl⟩ := hz
      simpa [p, J, jB] using
        (IntermediateField.subset_adjoin k (Set.range jB)
          (Set.mem_range_self (⟨m, hm⟩ : Fin n)))
    · intro c
      change algebraMap k B c ∈ J
      exact IntermediateField.algebraMap_mem J c
    · intro u v hu hv huJ hvJ
      simpa only [p, Subtype.coe_eta] using J.add_mem huJ hvJ
    · intro u hu huJ
      simpa only [p, Subtype.coe_eta] using J.inv_mem huJ
    · intro u v hu hv huJ hvJ
      simpa only [p, Subtype.coe_eta] using J.mul_mem huJ hvJ
  letI : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range jB)) B :=
    HTGeometry.isAlgebraic_adjoin_of_intermediate_adjoin_eq_top jB hBtop
  have hBfinite : Algebra.trdeg k B < Cardinal.aleph0 := by
    calc
      Algebra.trdeg k B ≤ Cardinal.mk (Set.range jB) :=
        Algebra.IsAlgebraic.trdeg_le_cardinalMk k (Set.range jB)
      _ < Cardinal.aleph0 := Cardinal.mk_lt_aleph0
  have htr : Algebra.trdeg k B + Algebra.trdeg B F = Algebra.trdeg k F :=
    trdeg_add_eq k B (A := F)
  have hBFzero : Algebra.trdeg B F = 0 := trdeg_eq_zero
  rw [hBFzero, add_zero] at htr
  rw [← htr]
  exact hBfinite

set_option maxHeartbeats 600000 in
theorem differentialAlgebraicOver_trans [CharZero K] {x y : K}
    (hx : DifferentialAlgebraicOver k x)
    (hy : DifferentialAlgebraicOver (differentialAdjoin k ({x} : Set K)) y) :
    DifferentialAlgebraicOver k y := by
  let F := differentialAdjoin k ({x} : Set K)
  change DifferentialAlgebraicOver F y at hy
  letI : DifferentialAlgebra F K :=
    ⟨fun c => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin k ({x} : Set K)) c⟩
  have hFfinite : Algebra.trdeg k F < Cardinal.aleph0 :=
    differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hx
  let L := differentialAdjoin F ({y} : Set K)
  have hLrelfinite : Algebra.trdeg F L < Cardinal.aleph0 :=
    differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hy
  letI : Algebra k L := RingHom.toAlgebra
    ((algebraMap F L).comp (algebraMap k F))
  haveI : IsScalarTower k F L := .of_algebraMap_eq fun _ => rfl
  have htr : Algebra.trdeg k F + Algebra.trdeg F L = Algebra.trdeg k L :=
    trdeg_add_eq k F (A := L)
  have hLfinite : Algebra.trdeg k L < Cardinal.aleph0 := by
    rw [← htr]
    exact Cardinal.add_lt_aleph0 hFfinite hLrelfinite
  change ¬ DifferentialIndependent k (fun _ : Unit => y)
  intro hyind
  let yL : L := ⟨y, subset_differentialAdjoin F ({y} : Set K) rfl⟩
  haveI : IsScalarTower k L K := .of_algebraMap_eq fun _ => rfl
  letI : DifferentialAlgebra L K :=
    ⟨fun c => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin F ({y} : Set K)) c⟩
  have hyLind : DifferentialIndependent k (fun _ : Unit => yL) := by
    apply DifferentialIndependent.of_algebraMap (K' := K)
    simpa [yL] using hyind
  unfold DifferentialIndependent at hyLind
  have hjets : AlgebraicIndependent k (fun n : ℕ => differentialJet n yL) := by
    have h := hyLind.comp (fun n : ℕ => ((), n)) (by
      intro m n hmn
      exact congrArg Prod.snd hmn)
    simpa using h
  have haleph : Cardinal.aleph0 ≤ Algebra.trdeg k L := by
    have h := hjets.lift_cardinalMk_le_trdeg
    simpa using h
  exact (not_lt_of_ge haleph) hLfinite

/-- Embed an ordinary polynomial in the order-zero differential variable. -/
def differentialValuePolynomial
    {k F : Type*} [CommRing k] [CommRing F] [Algebra k F]
    (p : Polynomial k) : DifferentialPolynomial Unit F :=
  Polynomial.aeval (MvPolynomial.X ((), 0)) (p.map (algebraMap k F))

private theorem differentialPolynomialEval_valuePolynomial
    {F : Type*} [Field F] [Algebra k F] [Algebra F K]
    [IsScalarTower k F K] (y : K) (p : Polynomial k) :
    differentialPolynomialEval (C := F) (fun _ : Unit => y)
        (differentialValuePolynomial (F := F) p) = Polynomial.aeval y p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      unfold differentialValuePolynomial at hp hq ⊢
      simp only [Polynomial.map_add, map_add]
      exact congrArg₂ (· + ·) hp hq
  | monomial n c =>
      simp [differentialValuePolynomial, Polynomial.aeval_monomial,
        differentialPolynomialEval, IsScalarTower.algebraMap_apply k F K]

private theorem eval_differentialValuePolynomial
    {F : Type*} [Field F] [Algebra k F]
    (g : Unit × ℕ → F) (p : Polynomial k) :
    MvPolynomial.eval g (differentialValuePolynomial (F := F) p) =
      Polynomial.eval₂ (algebraMap k F) (g ((), 0)) p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      unfold differentialValuePolynomial at hp hq ⊢
      simp only [Polynomial.map_add, map_add]
      rw [Polynomial.eval₂_add]
      exact congrArg₂ (· + ·) hp hq
  | monomial n c =>
      simp [differentialValuePolynomial, Polynomial.aeval_monomial]

set_option maxHeartbeats 500000 in
private theorem differentialAlgebraicOver_positiveRationalTensor
    [Infinite k] {y : K} {p r : Polynomial k} (hp : p ≠ 0) (hr : r ≠ 0)
    {ell : ℕ} (hell : 0 < ell) (hy : Transcendental k y) :
    let Q := Polynomial.aeval y p / Polynomial.aeval y r *
      Differential.deriv y ^ ell
    DifferentialAlgebraicOver (differentialAdjoin k ({Q} : Set K)) y := by
  dsimp only
  let Q := Polynomial.aeval y p / Polynomial.aeval y r * Differential.deriv y ^ ell
  let F := differentialAdjoin k ({Q} : Set K)
  let qF : F := ⟨Q, subset_differentialAdjoin k ({Q} : Set K) rfl⟩
  let P : DifferentialPolynomial Unit F :=
    differentialValuePolynomial (F := F) r * MvPolynomial.C qF -
      differentialValuePolynomial (F := F) p * MvPolynomial.X ((), 1) ^ ell
  have hP : P ≠ 0 := by
    obtain ⟨a, ha⟩ : ∃ a : k, p.eval a ≠ 0 := by
      by_contra h
      push Not at h
      apply hp
      apply Polynomial.funext
      intro z
      simpa using h z
    let g0 : Unit × ℕ → F := fun i =>
      if i = ((), 0) then algebraMap k F a else 0
    let g1 : Unit × ℕ → F := fun i =>
      if i = ((), 0) then algebraMap k F a
      else if i = ((), 1) then 1 else 0
    intro hzero
    have h0 := congrArg (MvPolynomial.eval g0) hzero
    have h1 := congrArg (MvPolynomial.eval g1) hzero
    rw [map_zero] at h0 h1
    have hpmap : algebraMap k F (p.eval a) = 0 := by
      have hdiff := sub_eq_zero.mpr (h0.trans h1.symm)
      simpa [P, g0, g1, eval_differentialValuePolynomial, hell.ne'] using hdiff
    exact ha ((algebraMap k F).injective (by simpa using hpmap))
  have hry : Polynomial.aeval y r ≠ 0 := by
    intro hroot
    exact hy ⟨r, hr, hroot⟩
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hind
  apply hP
  apply hind.eq_zero_of_aeval_eq_zero
  change differentialPolynomialEval (C := F) (fun _ : Unit => y) P = 0
  rw [show P = differentialValuePolynomial (F := F) r * MvPolynomial.C qF -
      differentialValuePolynomial (F := F) p * MvPolynomial.X ((), 1) ^ ell from rfl]
  rw [map_sub, map_mul, map_mul, map_pow,
    differentialPolynomialEval_valuePolynomial y r,
    differentialPolynomialEval_valuePolynomial y p,
    differentialPolynomialEval_X]
  have hqF : differentialPolynomialEval (C := F) (fun _ : Unit => y)
      (MvPolynomial.C qF) = Q := by
    simp [differentialPolynomialEval, qF]
  rw [hqF]
  have hj1 : differentialJet 1 y = Differential.deriv y := by
    simpa using differentialJet_succ 0 y
  rw [hj1]
  change Polynomial.aeval y r * Q -
    Polynomial.aeval y p * Differential.deriv y ^ ell = 0
  dsimp only [Q]
  field_simp [hry]
  ring

set_option maxHeartbeats 500000 in
private theorem differentialAlgebraicOver_negativeRationalTensor
    [Infinite k] {y : K} {p r : Polynomial k} (hp : p ≠ 0) (hr : r ≠ 0)
    {ell : ℕ} (hell : 0 < ell) (hy : Transcendental k y)
    (hdy : Differential.deriv y ≠ 0) :
    let Q := (Polynomial.aeval y p / Polynomial.aeval y r) /
      Differential.deriv y ^ ell
    DifferentialAlgebraicOver (differentialAdjoin k ({Q} : Set K)) y := by
  dsimp only
  let Q := (Polynomial.aeval y p / Polynomial.aeval y r) / Differential.deriv y ^ ell
  let F := differentialAdjoin k ({Q} : Set K)
  let qF : F := ⟨Q, subset_differentialAdjoin k ({Q} : Set K) rfl⟩
  let P : DifferentialPolynomial Unit F :=
    differentialValuePolynomial (F := F) r * MvPolynomial.C qF *
        MvPolynomial.X ((), 1) ^ ell -
      differentialValuePolynomial (F := F) p
  have hP : P ≠ 0 := by
    obtain ⟨a, ha⟩ : ∃ a : k, p.eval a ≠ 0 := by
      by_contra h
      push Not at h
      apply hp
      apply Polynomial.funext
      intro z
      simpa using h z
    let g0 : Unit × ℕ → F := fun i =>
      if i = ((), 0) then algebraMap k F a else 0
    intro hzero
    have h0 := congrArg (MvPolynomial.eval g0) hzero
    rw [map_zero] at h0
    have hpmap : algebraMap k F (p.eval a) = 0 := by
      simpa [P, g0, eval_differentialValuePolynomial, hell.ne'] using h0
    exact ha ((algebraMap k F).injective (by simpa using hpmap))
  have hry : Polynomial.aeval y r ≠ 0 := by
    intro hroot
    exact hy ⟨r, hr, hroot⟩
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hind
  apply hP
  apply hind.eq_zero_of_aeval_eq_zero
  change differentialPolynomialEval (C := F) (fun _ : Unit => y) P = 0
  rw [show P = differentialValuePolynomial (F := F) r * MvPolynomial.C qF *
        MvPolynomial.X ((), 1) ^ ell -
      differentialValuePolynomial (F := F) p from rfl]
  rw [map_sub, map_mul, map_mul, map_pow,
    differentialPolynomialEval_valuePolynomial y r,
    differentialPolynomialEval_valuePolynomial y p,
    differentialPolynomialEval_X]
  have hqF : differentialPolynomialEval (C := F) (fun _ : Unit => y)
      (MvPolynomial.C qF) = Q := by
    simp [differentialPolynomialEval, qF]
  rw [hqF]
  have hj1 : differentialJet 1 y = Differential.deriv y := by
    simpa using differentialJet_succ 0 y
  rw [hj1]
  change Polynomial.aeval y r * Q * Differential.deriv y ^ ell -
    Polynomial.aeval y p = 0
  dsimp only [Q]
  field_simp [hry, hdy]
  ring

/-- A rational tensor coefficient evaluated on the first jet. -/
def rationalTensorJetObservable
    (p r : Polynomial k) (weight : ℤ) (y : K) : K :=
  Polynomial.aeval y p / Polynomial.aeval y r * Differential.deriv y ^ weight

set_option maxHeartbeats 400000 in
/-- A nonzero rational tensor observable of a hypertranscendental element is itself
hypertranscendental. -/
theorem hypertranscendentalOver_rationalTensorJetObservable
    [CharZero k] [CharZero K] {y : K} {p r : Polynomial k} (hp : p ≠ 0) (hr : r ≠ 0)
    {weight : ℤ} (hweight : weight ≠ 0) (hy : HypertranscendentalOver k y) :
    HypertranscendentalOver k (rationalTensorJetObservable p r weight y) := by
  have hytrans : Transcendental k y := by
    simpa using hypertranscendentalOver_jet_transcendental hy 0
  have hdy : Differential.deriv y ≠ 0 := by
    have hjet := hypertranscendentalOver_jet_transcendental hy 1
    have hj1 : differentialJet 1 y = Differential.deriv y := by
      simpa using differentialJet_succ 0 y
    intro hzero
    apply hjet
    rw [hj1, hzero]
    exact isAlgebraic_zero
  unfold HypertranscendentalOver
  intro hQ
  apply hy
  apply differentialAlgebraicOver_trans hQ
  cases weight with
  | ofNat n =>
      have hn : 0 < n := Nat.pos_of_ne_zero (by
        intro hn
        apply hweight
        simp [hn])
      have hpow : Differential.deriv y ^ (Int.ofNat n : ℤ) =
          Differential.deriv y ^ n := zpow_ofNat _ n
      rw [rationalTensorJetObservable, hpow]
      exact differentialAlgebraicOver_positiveRationalTensor hp hr hn hytrans
  | negSucc n =>
      have hpow : Differential.deriv y ^ Int.negSucc n =
          (Differential.deriv y ^ (n + 1))⁻¹ := zpow_negSucc _ n
      rw [rationalTensorJetObservable, hpow, ← div_eq_mul_inv]
      exact differentialAlgebraicOver_negativeRationalTensor hp hr
        (Nat.succ_pos n) hytrans hdy

end

end GaloisForLFunctions
