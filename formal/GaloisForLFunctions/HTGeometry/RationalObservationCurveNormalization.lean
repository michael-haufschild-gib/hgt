import GaloisForLFunctions.HTGeometry.JetPrincipalSymbolExtraction
import GaloisForLFunctions.HTGeometry.DerivationAlgebraicDescent

/-!
# Deep derivative horizons reconstruct the normalized observation curve

Fix the free generator `y` of the free scalar differential rational field and finitely or infinitely
many nonconstant rational views `S i` whose values `S i (y)` generate the whole ordinary rational
field `C(y)`.  For every positive depth `n`, the differential field generated by the `n`-th jets of
the views is either a proper jet tail — exactly when all the views are affine functions of one
common view — or the whole differential field generated by `y`.

The nonaffine half is proved here.  Principal-symbol extraction puts every slope ratio
`(S i)'(y) / (S j)'(y)` inside the generated field; one nonconstant slope ratio forces the Lüroth
generator of that field to have scalar differential order zero, so it is an ordinary rational
function `u` of `y`; extraction once more puts each `(S i)'(y) / u'(y)` in `C(u)`; and algebraic
descent along the derivation `u'(y)⁻¹ ∂/∂y`, whose constants inside `C(y)` are the coefficients,
then puts each `S i (y)` itself in `C(u)`.  Since those values generate `C(y)`, the ordinary field
`C(u)` is all of `C(y)`, and the differential field generated by `u` is everything.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential

noncomputable section

variable {C : Type*} [Field C] [CharZero C] [IsAlgClosed C]

local instance rationalObservationConstantDifferential : Differential C := ⟨0⟩

local instance rationalObservationDifferentialAlgebra :
    DifferentialAlgebra C (JetField C Unit) :=
  ⟨fun c ↦ by
    change (algebraMap C (JetField C Unit) c)′ = algebraMap C (JetField C Unit) 0
    rw [JetField.deriv_algebraMap, map_zero]⟩

/-! ## The order-zero layer -/

omit [IsAlgClosed C] in
/-- An ordinary rational function of the free generator with vanishing coordinate derivative is a
coefficient. -/
theorem mem_bot_of_pd_zero_eq_zero {v : JetField C Unit}
    (hv : v ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    (h0 : JetField.pd ((), 0) v = 0) :
    v ∈ (⊥ : IntermediateField C (JetField C Unit)) := by
  have hzero : ∀ i : Unit × ℕ,
      freeCoordinateDerivation C (Unit × ℕ) i (v : FreeCoordinateRationalField C (Unit × ℕ)) = 0 := by
    rintro ⟨j, k⟩
    obtain rfl : j = () := rfl
    have hpd : JetField.pd ((), k) v = 0 := by
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · exact h0
      · exact pd_eq_zero_of_mem_adjoin_freeGen hk hv
    exact hpd
  obtain ⟨c, hc⟩ := exists_algebraMap_of_forall_freeCoordinateDerivation_eq_zero hzero
  exact IntermediateField.mem_bot.mpr ⟨c, hc.symm⟩

omit [IsAlgClosed C] in
theorem pd_ne_zero_of_notMem_bot {v : JetField C Unit}
    (hv : v ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    (hbot : v ∉ (⊥ : IntermediateField C (JetField C Unit))) :
    JetField.pd ((), 0) v ≠ 0 := fun h => hbot (mem_bot_of_pd_zero_eq_zero hv h)

omit [IsAlgClosed C] in
/-- An order-zero observable of the free generator that lies in a one-generator differential field
of an order-zero generator lies in the ordinary field of that generator. -/
theorem mem_adjoin_of_mem_differentialAdjoin_of_order_zero
    {u z : JetField C Unit}
    (huo : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) u 0)
    (hz : z ∈ differentialAdjoin C ({u} : Set (JetField C Unit)))
    (hzy : z ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit))) :
    z ∈ IntermediateField.adjoin C ({u} : Set (JetField C Unit)) := by
  by_cases hzbot : z ∈ (⊥ : IntermediateField C (JetField C Unit))
  · obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hzbot
    rw [← hc]
    exact IntermediateField.algebraMap_mem _ c
  · have hzo : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) z 0 :=
      hasScalarDifferentialOrder_zero_iff.mpr ⟨hzy, hzbot⟩
    obtain ⟨s, hzs, -⟩ := existsUnique_hasScalarDifferentialOrder hz hzbot
    have hsum : s + 0 = 0 :=
      (HasScalarDifferentialOrder.comp hypertranscendentalOver_freeGen huo hzs).order_eq hzo
    have hs : s = 0 := by omega
    rw [hs] at hzs
    exact (hasScalarDifferentialOrder_zero_iff.mp hzs).1

/-! ## Algebraic descent along the normalized coordinate derivation -/

/-- The coordinate derivation of the free generator, renormalized so that it differentiates with
respect to a chosen ordinary rational function of it. -/
def normalizedCoordinateDerivation (u : JetField C Unit) :
    Derivation C (JetField C Unit) (JetField C Unit) :=
  (JetField.pd ((), 0) u)⁻¹ • JetField.pd ((), 0)

omit [CharZero C] [IsAlgClosed C] in
theorem normalizedCoordinateDerivation_apply (u v : JetField C Unit) :
    normalizedCoordinateDerivation u v =
      (JetField.pd ((), 0) u)⁻¹ * JetField.pd ((), 0) v := rfl

omit [IsAlgClosed C] in
/-- **Descent to the ordinary field of the Lüroth coordinate.**  An ordinary rational function of
the free generator whose coordinate derivative is, after normalization, an ordinary rational
function of `u`, is itself an ordinary rational function of `u`. -/
theorem mem_adjoin_of_pd_ratio_mem
    {u T : JetField C Unit}
    (huy : u ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    (hubot : u ∉ (⊥ : IntermediateField C (JetField C Unit)))
    (hTy : T ∈ IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    (hratio : JetField.pd ((), 0) T * (JetField.pd ((), 0) u)⁻¹ ∈
      IntermediateField.adjoin C ({u} : Set (JetField C Unit))) :
    T ∈ IntermediateField.adjoin C ({u} : Set (JetField C Unit)) := by
  classical
  set y : JetField C Unit := JetField.jet ((), 0) with hy
  set Y : IntermediateField C (JetField C Unit) :=
    IntermediateField.adjoin C ({y} : Set (JetField C Unit)) with hY
  set K : IntermediateField C (JetField C Unit) :=
    IntermediateField.adjoin C ({u} : Set (JetField C Unit)) with hK
  have hpdu : JetField.pd ((), 0) u ≠ 0 := pd_ne_zero_of_notMem_bot huy hubot
  set D : Derivation C (JetField C Unit) (JetField C Unit) :=
    normalizedCoordinateDerivation u with hD
  have hKY : K ≤ Y := by
    rw [hK, IntermediateField.adjoin_le_iff]
    rintro _ rfl
    exact huy
  have hDK : ∀ v ∈ K, D v ∈ K := by
    intro v hv
    obtain ⟨q, hq, hqv⟩ := exists_mem_mul_of_mem_adjoin (JetField.pd ((), 0))
      (JetField.pd ((), 0) u) ({u} : Set (JetField C Unit))
      (fun g hg => ⟨1, one_mem _, by
        rw [Set.mem_singleton_iff] at hg
        rw [hg, one_mul]⟩) hv
    rw [hD, normalizedCoordinateDerivation_apply, hqv]
    have : (JetField.pd ((), 0) u)⁻¹ * (q * JetField.pd ((), 0) u) = q := by
      field_simp
    rw [this]
    exact hq
  have hconst : ∀ z ∈ Y, D z = 0 → z ∈ K := by
    intro z hz hDz
    rw [hD, normalizedCoordinateDerivation_apply] at hDz
    have h0 : JetField.pd ((), 0) z = 0 := by
      rcases mul_eq_zero.mp hDz with h | h
      · exact absurd (inv_eq_zero.mp h) hpdu
      · exact h
    obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp (mem_bot_of_pd_zero_eq_zero hz h0)
    rw [← hc]
    exact IntermediateField.algebraMap_mem _ c
  -- `y` is algebraic over `K`
  obtain ⟨r, hr⟩ := exists_ratFuncEval_of_mem_adjoin transcendental_freeGen huy
  have hrnc : ¬ ∃ c : C, r = RatFunc.C c := by
    rintro ⟨c, rfl⟩
    exact hubot (by rw [← hr, ratFuncEval_C]; exact IntermediateField.mem_bot.mpr ⟨c, rfl⟩)
  have hyalg : IsAlgebraic K y := by
    have h := isAlgebraic_ratFuncEval_over_adjoin (C := C) transcendental_freeGen hrnc
    rw [hr] at h
    exact h
  have hTalg : IsAlgebraic K T := by
    set M : IntermediateField K (JetField C Unit) :=
      IntermediateField.adjoin K ({y} : Set (JetField C Unit)) with hM
    letI : Algebra.IsAlgebraic K M :=
      IntermediateField.isAlgebraic_adjoin_simple hyalg.isIntegral
    have hYM : Y ≤ M.restrictScalars C := by
      rw [hY, IntermediateField.adjoin_le_iff]
      rintro _ rfl
      exact IntermediateField.subset_adjoin K _ rfl
    have hTM : T ∈ M := hYM hTy
    have halg : IsAlgebraic K (⟨T, hTM⟩ : M) := Algebra.IsAlgebraic.isAlgebraic _
    exact (isAlgebraic_algHom_iff M.val Subtype.val_injective).mpr halg
  have hDT : D T ∈ K := by
    rw [hD, normalizedCoordinateDerivation_apply, mul_comm]
    exact hratio
  exact mem_of_isAlgebraic_of_derivation_mem D K Y hKY hDK hconst hTy hTalg hDT

/-! ## The main reconstruction theorem -/

omit [CharZero C] [IsAlgClosed C] in
theorem hasScalarDifferentialOrder_ratFuncEval_zero {r : RatFunc C}
    (hr : ¬ ∃ c : C, r = RatFunc.C c) :
    HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit)
      (ratFuncEval _ transcendental_freeGen r) 0 := by
  refine hasScalarDifferentialOrder_zero_iff.mpr ⟨ratFuncEval_mem_adjoin _ r, ?_⟩
  intro hbot
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hbot
  refine hr ⟨c, ?_⟩
  refine ratFuncEval_injective _ transcendental_freeGen ?_
  rw [ratFuncEval_C]
  exact hc.symm

omit [CharZero C] [IsAlgClosed C] in
/-- Every differential jet of a member of a derivation-closed field stays in that field. -/
private theorem differentialJet_mem_of_derivationClosed
    {K : IntermediateField C (JetField C Unit)} (hK : DerivationClosed K)
    {z : JetField C Unit} (hz : z ∈ K) (k : ℕ) : differentialJet k z ∈ K := by
  induction k with
  | zero => simpa using hz
  | succ k ih =>
      rw [differentialJet_succ]
      exact hK ih

omit [IsAlgClosed C] in
/-- **Deep horizons reconstruct the normalized observation curve.**  If finitely or infinitely many
nonconstant rational views of the free generator generate the ordinary rational field of one
element `T`, and some slope ratio of two of them is nonconstant, then the jets at any common depth
of the views generate exactly the differential field of `T`. -/
theorem differentialAdjoin_jetFamily_eq_differentialAdjoin
    {ι : Type*} (S : ι → RatFunc C)
    (hnc : ∀ i, ¬ ∃ c : C, S i = RatFunc.C c)
    {T : JetField C Unit}
    (hgen : IntermediateField.adjoin C
        (Set.range fun i => ratFuncEval _ transcendental_freeGen (S i))
      = IntermediateField.adjoin C ({T} : Set (JetField C Unit)))
    {n : ℕ} (i₀ i₁ : ι)
    (hslope : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₁))
        * (JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₀)))⁻¹
        ∉ (⊥ : IntermediateField C (JetField C Unit))) :
    differentialAdjoin C
        (Set.range fun i => differentialJet n (ratFuncEval _ transcendental_freeGen (S i)))
      = differentialAdjoin C ({T} : Set (JetField C Unit)) := by
  classical
  set y : JetField C Unit := JetField.jet ((), 0) with hy
  have hxHT : HypertranscendentalOver C y := hypertranscendentalOver_freeGen
  set sy : ι → JetField C Unit := fun i => ratFuncEval y transcendental_freeGen (S i) with hsy
  set v : ι → JetField C Unit := fun i => differentialJet n (sy i) with hv
  set K : IntermediateField C (JetField C Unit) :=
    differentialAdjoin C (Set.range v) with hK
  have hKclosed : DerivationClosed K := derivationClosed_differentialAdjoin C _
  have hvK : ∀ i, v i ∈ K :=
    fun i => IntermediateField.subset_adjoin C _ ⟨v i, ⟨i, rfl⟩, 0, differentialJet_zero _⟩
  have hsyo : ∀ i, HasScalarDifferentialOrder C y (sy i) 0 :=
    fun i => hasScalarDifferentialOrder_ratFuncEval_zero (hnc i)
  have hvo : ∀ i, HasScalarDifferentialOrder C y (v i) n := by
    intro i
    have h := (hsyo i).differentialJet_order hxHT n
    rwa [Nat.zero_add] at h
  have hsymem : ∀ i, sy i ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) :=
    fun i => ratFuncEval_mem_adjoin _ (S i)
  have hpd0 : ∀ i, JetField.pd ((), 0) (sy i) ≠ 0 := by
    intro i
    exact pd_ne_zero_of_notMem_bot (hsymem i)
      (freeGen_notMem_bot_of_hasScalarDifferentialOrder (hsyo i))
  have hpdv : ∀ i, JetField.pd ((), n) (v i) = JetField.pd ((), 0) (sy i) := by
    intro i
    have h := pd_differentialJet_top (m := 0)
      (fun k hk => pd_eq_zero_of_mem_adjoin_freeGen hk (hsymem i)) n
    rwa [Nat.zero_add] at h
  have hKbot : K ≠ ⊥ := by
    intro hbot
    exact freeGen_notMem_bot_of_hasScalarDifferentialOrder (hvo i₀) (hbot ▸ hvK i₀)
  -- the nonconstant slope ratio lies in `K`
  obtain ⟨q, hqK, hq⟩ := exists_mem_pd_ratio K hKclosed hKbot (hvK i₀) (hvK i₁)
    (hvo i₀) (hvo i₁) (by rw [hpdv i₀]; exact hpd0 i₀)
  have hqval : q = JetField.pd ((), 0) (sy i₁) * (JetField.pd ((), 0) (sy i₀))⁻¹ := by
    rw [hpdv i₀, hpdv i₁] at hq
    rw [hq, mul_assoc, mul_inv_cancel₀ (hpd0 i₀), mul_one]
  have hqbot : q ∉ (⊥ : IntermediateField C (JetField C Unit)) := by
    rw [hqval]
    exact hslope
  have hqy : q ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) := by
    rw [hqval]
    exact mul_mem (pd_zero_mem_adjoin_freeGen (hsymem i₁))
      (IntermediateField.inv_mem _ (pd_zero_mem_adjoin_freeGen (hsymem i₀)))
  have hqo : HasScalarDifferentialOrder C y q 0 :=
    hasScalarDifferentialOrder_zero_iff.mpr ⟨hqy, hqbot⟩
  -- the Lüroth generator of `K` has order zero
  obtain ⟨u, hu⟩ := differentialLuroth (F := C) (E := JetField C Unit) K hKclosed
    (y := y) (by rw [differentialAdjoin_jet_zero_eq_top]; exact le_top)
    JetField.differentialIndependent_jet hKbot
  have hubot : u ∉ (⊥ : IntermediateField C (JetField C Unit)) := by
    intro hbot
    refine hKbot (le_antisymm ?_ bot_le)
    rw [← hu]
    refine differentialAdjoin_le C ?_ derivationClosed_bot
    rintro z hz
    rw [Set.mem_singleton_iff] at hz
    exact hz ▸ hbot
  obtain ⟨r, huo, -⟩ := existsUnique_hasScalarDifferentialOrder
    (C := C) (E := JetField C Unit) (y := y) (z := u)
    (by rw [differentialAdjoin_jet_zero_eq_top]; trivial) hubot
  have hqmemu : q ∈ differentialAdjoin C ({u} : Set (JetField C Unit)) := by rw [hu]; exact hqK
  obtain ⟨s, hqs, -⟩ := existsUnique_hasScalarDifferentialOrder hqmemu hqbot
  have hsr : s + r = 0 :=
    (HasScalarDifferentialOrder.comp hxHT huo hqs).order_eq hqo
  have hr0 : r = 0 := by omega
  rw [hr0] at huo
  have huy : u ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) :=
    (hasScalarDifferentialOrder_zero_iff.mp huo).1
  have hpdu : JetField.pd ((), 0) u ≠ 0 := pd_ne_zero_of_notMem_bot huy hubot
  -- the deep jet of the Lüroth generator, and its principal symbol
  set w : JetField C Unit := differentialJet n u with hw
  have hwK : w ∈ K := by
    rw [← hu]
    exact IntermediateField.subset_adjoin C _ ⟨u, rfl, n, rfl⟩
  have hwo : HasScalarDifferentialOrder C y w n := by
    have h := huo.differentialJet_order hxHT n
    rwa [Nat.zero_add] at h
  have hpdw : JetField.pd ((), n) w = JetField.pd ((), 0) u := by
    have h := pd_differentialJet_top (m := 0)
      (fun k hk => pd_eq_zero_of_mem_adjoin_freeGen hk huy) n
    rwa [Nat.zero_add] at h
  -- every view descends to the ordinary field of the Lüroth generator
  have hdescend : ∀ i, sy i ∈ IntermediateField.adjoin C ({u} : Set (JetField C Unit)) := by
    intro i
    obtain ⟨g, hgK, hg⟩ := exists_mem_pd_ratio K hKclosed hKbot hwK (hvK i) hwo (hvo i)
      (by rw [hpdw]; exact hpdu)
    have hgval : JetField.pd ((), 0) (sy i) * (JetField.pd ((), 0) u)⁻¹ = g := by
      rw [hpdv i, hpdw] at hg
      rw [hg, mul_assoc, mul_inv_cancel₀ hpdu, mul_one]
    have hgy : g ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) := by
      rw [← hgval]
      exact mul_mem (pd_zero_mem_adjoin_freeGen (hsymem i))
        (IntermediateField.inv_mem _ (pd_zero_mem_adjoin_freeGen huy))
    refine mem_adjoin_of_pd_ratio_mem huy hubot (hsymem i) ?_
    rw [hgval]
    rw [← hu] at hgK
    exact mem_adjoin_of_mem_differentialAdjoin_of_order_zero huo hgK hgy
  -- hence the reference coordinate itself descends
  have hgenle : IntermediateField.adjoin C ({T} : Set (JetField C Unit)) ≤
      IntermediateField.adjoin C ({u} : Set (JetField C Unit)) := by
    rw [← hgen, IntermediateField.adjoin_le_iff]
    rintro z ⟨i, hzi⟩
    have hz : z = sy i := hzi.symm
    rw [hz]
    exact hdescend i
  have hTu : T ∈ IntermediateField.adjoin C ({u} : Set (JetField C Unit)) :=
    hgenle (IntermediateField.subset_adjoin C _ rfl)
  have hTK : T ∈ K := by
    rw [← hu]
    refine (IntermediateField.adjoin_le_iff.mpr ?_) hTu
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact IntermediateField.subset_adjoin C _ ⟨u, rfl, 0, differentialJet_zero u⟩
  refine le_antisymm ?_ ?_
  · refine differentialAdjoin_le C ?_ (derivationClosed_differentialAdjoin C _)
    rintro z ⟨i, hzi⟩
    have hz : z = differentialJet n (sy i) := hzi.symm
    rw [hz]
    refine differentialJet_mem_of_derivationClosed (derivationClosed_differentialAdjoin C _) ?_ n
    have hsyT : sy i ∈ IntermediateField.adjoin C ({T} : Set (JetField C Unit)) := by
      rw [← hgen]
      exact IntermediateField.subset_adjoin C _ ⟨i, rfl⟩
    refine (IntermediateField.adjoin_le_iff.mpr ?_) hsyT
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact IntermediateField.subset_adjoin C _ ⟨T, rfl, 0, differentialJet_zero T⟩
  · refine differentialAdjoin_le C ?_ hKclosed
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact hTK

omit [IsAlgClosed C] in
/-- Normalized form: when the views generate the ordinary rational field of the free generator
itself, their jets at any common depth generate the whole differential field. -/
theorem differentialAdjoin_jetFamily_eq_top
    {ι : Type*} (S : ι → RatFunc C)
    (hnc : ∀ i, ¬ ∃ c : C, S i = RatFunc.C c)
    (hgen : IntermediateField.adjoin C
        (Set.range fun i => ratFuncEval _ transcendental_freeGen (S i))
      = IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    {n : ℕ} (i₀ i₁ : ι)
    (hslope : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₁))
        * (JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₀)))⁻¹
        ∉ (⊥ : IntermediateField C (JetField C Unit))) :
    differentialAdjoin C
      (Set.range fun i => differentialJet n (ratFuncEval _ transcendental_freeGen (S i))) = ⊤ := by
  rw [differentialAdjoin_jetFamily_eq_differentialAdjoin S hnc hgen i₀ i₁ hslope]
  exact differentialAdjoin_jet_zero_eq_top

/-! ## The affine failure and the dichotomy -/

omit [IsAlgClosed C] in
/-- A single deep jet never generates the whole differential field. -/
theorem differentialAdjoin_deepJet_ne_top {g : JetField C Unit} {n : ℕ} (hn : 0 < n)
    (hg : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit) g n) :
    differentialAdjoin C ({g} : Set (JetField C Unit)) ≠ ⊤ := by
  intro htop
  set y : JetField C Unit := JetField.jet ((), 0) with hy
  have hymem : y ∈ differentialAdjoin C ({g} : Set (JetField C Unit)) := by
    rw [htop]; trivial
  have hybot : y ∉ (⊥ : IntermediateField C (JetField C Unit)) :=
    freeGen_notMem_bot_of_hasScalarDifferentialOrder
      (hasScalarDifferentialOrder_self hypertranscendentalOver_freeGen)
  obtain ⟨s, hys, -⟩ := existsUnique_hasScalarDifferentialOrder hymem hybot
  have hsum : s + n = 0 :=
    (HasScalarDifferentialOrder.comp hypertranscendentalOver_freeGen hg hys).order_eq
      (hasScalarDifferentialOrder_self hypertranscendentalOver_freeGen)
  omega

omit [IsAlgClosed C] in
/-- A constant slope ratio integrates: the view is an affine function of the reference view. -/
theorem exists_affine_of_pd_ratio_mem_bot {r s : RatFunc C}
    (hs : ¬ ∃ c : C, s = RatFunc.C c)
    (hbot : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen r)
        * (JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen s))⁻¹ ∈
      (⊥ : IntermediateField C (JetField C Unit))) :
    ∃ a b : C, r = RatFunc.C a * s + RatFunc.C b := by
  classical
  set y : JetField C Unit := JetField.jet ((), 0) with hy
  set ry : JetField C Unit := ratFuncEval y transcendental_freeGen r with hry
  set sy : JetField C Unit := ratFuncEval y transcendental_freeGen s with hsy
  have hsymem : sy ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) :=
    ratFuncEval_mem_adjoin _ s
  have hrymem : ry ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) :=
    ratFuncEval_mem_adjoin _ r
  have hsybot : sy ∉ (⊥ : IntermediateField C (JetField C Unit)) :=
    freeGen_notMem_bot_of_hasScalarDifferentialOrder
      (hasScalarDifferentialOrder_ratFuncEval_zero hs)
  have hpds : JetField.pd ((), 0) sy ≠ 0 := pd_ne_zero_of_notMem_bot hsymem hsybot
  obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp hbot
  have hpdr : JetField.pd ((), 0) ry = algebraMap C (JetField C Unit) a * JetField.pd ((), 0) sy := by
    rw [ha]
    field_simp
  set z : JetField C Unit := ry - algebraMap C (JetField C Unit) a * sy with hz
  have hzmem : z ∈ IntermediateField.adjoin C ({y} : Set (JetField C Unit)) :=
    sub_mem hrymem (mul_mem (IntermediateField.algebraMap_mem _ a) hsymem)
  have hpdz : JetField.pd ((), 0) z = 0 := by
    rw [hz, map_sub, Derivation.leibniz, Derivation.map_algebraMap, smul_zero,
      smul_eq_mul, add_zero, hpdr, sub_self]
  obtain ⟨b, hb⟩ := IntermediateField.mem_bot.mp (mem_bot_of_pd_zero_eq_zero hzmem hpdz)
  refine ⟨a, b, ?_⟩
  refine ratFuncEval_injective y transcendental_freeGen ?_
  rw [map_add, map_mul, ratFuncEval_C, ratFuncEval_C]
  have hval : ry = algebraMap C (JetField C Unit) a * sy + algebraMap C (JetField C Unit) b := by
    rw [hb, hz]
    ring
  exact hval

omit [IsAlgClosed C] in
/-- **The affine failure.**  If every view is an affine function of one reference view, the deep
jets generate only the differential field of a single deep jet, which is proper. -/
theorem differentialAdjoin_jetFamily_ne_top_of_affine
    {ι : Type*} (S : ι → RatFunc C) (i₀ : ι) (hnc : ∀ i, ¬ ∃ c : C, S i = RatFunc.C c)
    {a b : ι → C} (haff : ∀ i, S i = RatFunc.C (a i) * S i₀ + RatFunc.C (b i))
    {n : ℕ} (hn : 0 < n) :
    differentialAdjoin C
      (Set.range fun i => differentialJet n (ratFuncEval _ transcendental_freeGen (S i)))
        ≠ ⊤ := by
  classical
  have hgo : HasScalarDifferentialOrder C (JetField.jet ((), 0) : JetField C Unit)
      (differentialJet n (ratFuncEval _ transcendental_freeGen (S i₀))) n := by
    have h := (hasScalarDifferentialOrder_ratFuncEval_zero (hnc i₀)).differentialJet_order
      hypertranscendentalOver_freeGen n
    rwa [Nat.zero_add] at h
  have hjet : ∀ i, differentialJet n
        (ratFuncEval (JetField.jet ((), 0) : JetField C Unit) transcendental_freeGen (S i))
      = algebraMap C (JetField C Unit) (a i) *
        differentialJet n (ratFuncEval _ transcendental_freeGen (S i₀)) := by
    intro i
    have hval : ratFuncEval (JetField.jet ((), 0) : JetField C Unit) transcendental_freeGen (S i)
        = algebraMap C (JetField C Unit) (a i) *
            ratFuncEval _ transcendental_freeGen (S i₀)
          + algebraMap C (JetField C Unit) (b i) := by
      rw [haff i, map_add, map_mul, ratFuncEval_C, ratFuncEval_C]
    rw [hval, differentialJet_constSlopeAffine _ (a i) (b i) rfl n]
    have hb : differentialJet n (b i) = 0 := by
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      rw [differentialJet_succ]
      show (differentialJet m (b i))′ = 0
      rfl
    rw [hb, map_zero, add_zero]
  intro htop
  refine differentialAdjoin_deepJet_ne_top hn hgo (top_unique ?_)
  rw [← htop]
  refine differentialAdjoin_le C ?_ (derivationClosed_differentialAdjoin C _)
  rintro z ⟨i, hzi⟩
  have hz : z = differentialJet n
      (ratFuncEval (JetField.jet ((), 0) : JetField C Unit) transcendental_freeGen (S i)) :=
    hzi.symm
  rw [hz, hjet i]
  exact mul_mem (IntermediateField.algebraMap_mem _ (a i))
    (IntermediateField.subset_adjoin C _
      ⟨differentialJet n (ratFuncEval _ transcendental_freeGen (S i₀)), rfl, 0,
        differentialJet_zero _⟩)

omit [IsAlgClosed C] in
/-- **The normalization dichotomy.**  For nonconstant rational views generating the ordinary
rational field of the free generator, and every positive depth, the deep jets generate the whole
differential field exactly when the views are not all affine functions of one reference view. -/
theorem differentialAdjoin_jetFamily_eq_top_iff
    {ι : Type*} (S : ι → RatFunc C) (i₀ : ι)
    (hnc : ∀ i, ¬ ∃ c : C, S i = RatFunc.C c)
    (hgen : IntermediateField.adjoin C
        (Set.range fun i => ratFuncEval _ transcendental_freeGen (S i))
      = IntermediateField.adjoin C ({JetField.jet ((), 0)} : Set (JetField C Unit)))
    {n : ℕ} (hn : 0 < n) :
    differentialAdjoin C
        (Set.range fun i => differentialJet n (ratFuncEval _ transcendental_freeGen (S i)))
          = ⊤ ↔
      ¬ ∃ a b : ι → C, ∀ i, S i = RatFunc.C (a i) * S i₀ + RatFunc.C (b i) := by
  constructor
  · rintro htop ⟨a, b, haff⟩
    exact differentialAdjoin_jetFamily_ne_top_of_affine S i₀ hnc haff hn htop
  · intro hnaff
    by_contra hne
    refine hnaff ?_
    have hall : ∀ i, JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i))
        * (JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₀)))⁻¹ ∈
        (⊥ : IntermediateField C (JetField C Unit)) := by
      intro i
      by_contra hbot
      exact hne (differentialAdjoin_jetFamily_eq_top S hnc hgen i₀ i hbot)
    choose a b hab using fun i => exists_affine_of_pd_ratio_mem_bot (hnc i₀) (hall i)
    exact ⟨a, b, hab⟩

/-! ## Lüroth normalization of the observation curve -/

omit [CharZero C] [IsAlgClosed C] in
/-- **Ordinary Lüroth normalization.**  The ordinary rational field generated by any family of
rational views of the free generator is the ordinary rational field of a single element. -/
theorem exists_adjoin_range_ratFuncEval_eq_adjoin {ι : Type*} (S : ι → RatFunc C) :
    ∃ T : JetField C Unit,
      IntermediateField.adjoin C
          (Set.range fun i => ratFuncEval _ transcendental_freeGen (S i))
        = IntermediateField.adjoin C ({T} : Set (JetField C Unit)) := by
  classical
  set φ : RatFunc C →ₐ[C] JetField C Unit :=
    ratFuncEval (JetField.jet ((), 0) : JetField C Unit) transcendental_freeGen with hφ
  set E : IntermediateField C (RatFunc C) := IntermediateField.adjoin C (Set.range S) with hE
  refine ⟨φ (RatFunc.Luroth.generator E), ?_⟩
  have hmapE : E.map φ =
      IntermediateField.adjoin C (Set.range fun i => φ (S i)) := by
    rw [hE, IntermediateField.adjoin_map]
    congr 1
    ext z
    constructor
    · rintro ⟨w, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨S i, ⟨i, rfl⟩, rfl⟩
  have hmapG : E.map φ =
      IntermediateField.adjoin C ({φ (RatFunc.Luroth.generator E)} : Set (JetField C Unit)) := by
    conv_lhs => rw [RatFunc.Luroth.eq_adjoin_generator (E := E)]
    rw [show (IntermediateField.adjoin C ({RatFunc.Luroth.generator E} : Set (RatFunc C))).map φ =
        IntermediateField.adjoin C (φ '' ({RatFunc.Luroth.generator E} : Set (RatFunc C))) from
      IntermediateField.adjoin_map C _ φ]
    rw [Set.image_singleton]
  rw [← hmapE, hmapG]

omit [IsAlgClosed C] in
/-- **The observation-curve normalization theorem.**  For any family of nonconstant rational views
of the free generator with one nonconstant slope ratio, the deep jets of the views generate exactly
the differential field of the Lüroth normalization of their joint ordinary image. -/
theorem exists_differentialAdjoin_jetFamily_eq {ι : Type*} (S : ι → RatFunc C)
    (hnc : ∀ i, ¬ ∃ c : C, S i = RatFunc.C c) {n : ℕ} (i₀ i₁ : ι)
    (hslope : JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₁))
        * (JetField.pd ((), 0) (ratFuncEval _ transcendental_freeGen (S i₀)))⁻¹
        ∉ (⊥ : IntermediateField C (JetField C Unit))) :
    ∃ T : JetField C Unit,
      IntermediateField.adjoin C
          (Set.range fun i => ratFuncEval _ transcendental_freeGen (S i))
          = IntermediateField.adjoin C ({T} : Set (JetField C Unit)) ∧
      differentialAdjoin C
          (Set.range fun i => differentialJet n (ratFuncEval _ transcendental_freeGen (S i)))
        = differentialAdjoin C ({T} : Set (JetField C Unit)) := by
  obtain ⟨T, hT⟩ := exists_adjoin_range_ratFuncEval_eq_adjoin S
  exact ⟨T, hT, differentialAdjoin_jetFamily_eq_differentialAdjoin S hnc hT i₀ i₁ hslope⟩

end

