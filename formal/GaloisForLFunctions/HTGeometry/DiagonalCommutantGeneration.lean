import Mathlib

/-!
# Diagonal algebras with one full operator generate `B(E)`

Fix a Hilbert basis `b` of a complex Hilbert space `E`.  The operators that are diagonal in `b`
commute with an operator `T` exactly when `T` is itself diagonal, so the commutant of the diagonal
algebra is the diagonal algebra.  Adjoining a single operator `A` none of whose matrix entries
`⟪b m, A (b n)⟫` vanishes forces the diagonal of `T` to be constant, hence `T` scalar.  Therefore
the double commutant — the von Neumann algebra generated by the diagonal algebra together with
`A` — is all of `B(E)`.

The argument is elementary: it uses neither the double commutant theorem nor any density
statement, only the commutation relations against the rank-one basis projections.
-/

namespace GaloisForLFunctions.DiagonalCommutant

open scoped InnerProductSpace

variable {ι : Type*} {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- The set of bounded operators that are diagonal in a given Hilbert basis. -/
def diagonalOps (b : HilbertBasis ι ℂ E) : Set (E →L[ℂ] E) :=
  {T | ∀ i, ∃ c : ℂ, T (b i) = c • b i}

/-- The rank-one projection onto a basis vector. -/
noncomputable def basisProj (b : HilbertBasis ι ℂ E) (i : ι) : E →L[ℂ] E :=
  (innerSL ℂ (b i)).smulRight (b i)

@[simp] theorem basisProj_apply (b : HilbertBasis ι ℂ E) (i : ι) (x : E) :
    basisProj b i x = ⟪b i, x⟫_ℂ • b i := rfl

theorem inner_basis [DecidableEq ι] (b : HilbertBasis ι ℂ E) (i j : ι) :
    ⟪b i, b j⟫_ℂ = if i = j then 1 else 0 :=
  orthonormal_iff_ite.mp b.orthonormal i j

theorem basisProj_mem_diagonalOps [DecidableEq ι] (b : HilbertBasis ι ℂ E) (i : ι) :
    basisProj b i ∈ diagonalOps b := by
  intro j
  by_cases h : i = j
  · subst h
    exact ⟨1, by rw [basisProj_apply, inner_basis, if_pos rfl]⟩
  · refine ⟨0, ?_⟩
    rw [basisProj_apply, inner_basis, if_neg h, zero_smul, zero_smul]

/-- An operator commuting with every diagonal operator is itself diagonal. -/
theorem exists_diag_of_mem_centralizer [DecidableEq ι] (b : HilbertBasis ι ℂ E)
    {S : Set (E →L[ℂ] E)} (hS : ∀ i, basisProj b i ∈ S)
    {T : E →L[ℂ] E} (hT : T ∈ Set.centralizer S) (i : ι) :
    T (b i) = ⟪b i, T (b i)⟫_ℂ • b i := by
  have hcomm := hT _ (hS i)
  have h2 := congrArg (fun U : E →L[ℂ] E => U (b i)) hcomm
  simp only [mul_apply_eq_comp] at h2
  rw [basisProj_apply, basisProj_apply, inner_basis, if_pos rfl, one_smul] at h2
  exact h2.symm

/-- **The diagonal algebra together with one everywhere-nonzero operator has trivial commutant.**
If every matrix entry of `A` in the basis `b` is nonzero, then any operator commuting with all
diagonal operators and with `A` is a scalar. -/
theorem eq_scalar_of_mem_centralizer' [DecidableEq ι] [Nonempty ι] (b : HilbertBasis ι ℂ E)
    {S : Set (E →L[ℂ] E)} (hSproj : ∀ i, basisProj b i ∈ S)
    {A : E →L[ℂ] E} (hAS : A ∈ S) (hA : ∀ m n, ⟪b m, A (b n)⟫_ℂ ≠ 0)
    {T : E →L[ℂ] E} (hT : T ∈ Set.centralizer S) :
    ∃ c : ℂ, T = c • (1 : E →L[ℂ] E) := by
  set t : ι → ℂ := fun i => ⟪b i, T (b i)⟫_ℂ with ht
  have hdiag : ∀ i, T (b i) = t i • b i := fun i =>
    exists_diag_of_mem_centralizer b hSproj hT i
  have hA' : A * T = T * A := hT A hAS
  have hconst : ∀ m n : ι, t m = t n := by
    intro m n
    have hTA := congrArg (fun U : E →L[ℂ] E => U (b n)) hA'
    simp only [mul_apply_eq_comp] at hTA
    -- hTA : A (T (b n)) = T (A (b n))
    have hL : basisProj b m (A (T (b n))) = (t n * ⟪b m, A (b n)⟫_ℂ) • b m := by
      rw [hdiag n, map_smul, basisProj_apply, inner_smul_right, mul_smul]
    have hR : basisProj b m (T (A (b n))) = (t m * ⟪b m, A (b n)⟫_ℂ) • b m := by
      have hcomm := hT _ (hSproj m)
      have hstep := congrArg (fun U : E →L[ℂ] E => U (A (b n))) hcomm
      simp only [mul_apply_eq_comp] at hstep
      -- hstep : T (basisProj b m (A (b n))) = basisProj b m (T (A (b n)))
      rw [hstep, basisProj_apply, map_smul, hdiag m, smul_smul, mul_comm]
    rw [hTA] at hL
    rw [hR] at hL
    have hbm : b m ≠ 0 := by
      intro h
      have := b.orthonormal.1 m
      rw [h, norm_zero] at this
      norm_num at this
    have := smul_left_injective ℂ hbm hL
    exact mul_right_cancel₀ (hA m n) this
  obtain ⟨i₀⟩ := ‹Nonempty ι›
  refine ⟨t i₀, ?_⟩
  ext x
  have hsum := b.hasSum_repr x
  have h1 : HasSum (fun i => T (b.repr x i • b i)) (T x) := hsum.mapL T
  have h2 : HasSum (fun i => (t i₀ • (1 : E →L[ℂ] E)) (b.repr x i • b i))
      ((t i₀ • (1 : E →L[ℂ] E)) x) := hsum.mapL _
  refine HasSum.unique ?_ h2
  refine h1.congr_fun ?_
  intro i
  simp only [map_smul, hdiag i, hconst i i₀, smul_apply,
    one_apply_eq_self]

/-- **The diagonal algebra together with one everywhere-nonzero operator has trivial commutant.** -/
theorem eq_scalar_of_mem_centralizer [DecidableEq ι] [Nonempty ι] (b : HilbertBasis ι ℂ E)
    {A : E →L[ℂ] E} (hA : ∀ m n, ⟪b m, A (b n)⟫_ℂ ≠ 0)
    {T : E →L[ℂ] E} (hT : T ∈ Set.centralizer (diagonalOps b ∪ {A})) :
    ∃ c : ℂ, T = c • (1 : E →L[ℂ] E) :=
  eq_scalar_of_mem_centralizer' b
    (fun i => Or.inl (basisProj_mem_diagonalOps b i)) (Or.inr rfl) hA hT

/-- The von Neumann algebra generated by a set of operators: its double commutant. -/
def vonNeumannGen (S : Set (E →L[ℂ] E)) : Set (E →L[ℂ] E) :=
  Set.centralizer (Set.centralizer S)

/-- **A basis-diagonal algebra together with one operator whose matrix has no zero entry
generates all of `B(E)`.** -/
theorem vonNeumannGen_eq_univ' [DecidableEq ι] [Nonempty ι] (b : HilbertBasis ι ℂ E)
    {S : Set (E →L[ℂ] E)} (hSproj : ∀ i, basisProj b i ∈ S)
    {A : E →L[ℂ] E} (hAS : A ∈ S) (hA : ∀ m n, ⟪b m, A (b n)⟫_ℂ ≠ 0) :
    vonNeumannGen S = (Set.univ : Set (E →L[ℂ] E)) := by
  refine Set.eq_univ_of_forall (fun U => ?_)
  intro T hT
  obtain ⟨c, rfl⟩ := eq_scalar_of_mem_centralizer' b hSproj hAS hA hT
  rw [smul_mul_assoc, mul_smul_comm, one_mul, mul_one]

/-- The diagonal algebra of a Hilbert basis, together with an operator all of whose matrix
entries are nonzero, generates `B(E)` as a von Neumann algebra. -/
theorem vonNeumannGen_diagonalOps_eq_univ [DecidableEq ι] [Nonempty ι] (b : HilbertBasis ι ℂ E)
    {A : E →L[ℂ] E} (hA : ∀ m n, ⟪b m, A (b n)⟫_ℂ ≠ 0) :
    vonNeumannGen (diagonalOps b ∪ {A}) = (Set.univ : Set (E →L[ℂ] E)) :=
  vonNeumannGen_eq_univ' b (fun i => Or.inl (basisProj_mem_diagonalOps b i)) (Or.inr rfl) hA

end GaloisForLFunctions.DiagonalCommutant
