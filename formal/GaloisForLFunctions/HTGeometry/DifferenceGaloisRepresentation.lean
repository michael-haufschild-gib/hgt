import GaloisForLFunctions.HTGeometry.DifferenceGaloisMatrix
import GaloisForLFunctions.HTGeometry.DifferenceNoNewConstants

/-!
# The difference Galois representation

Once the extension has no new constants, the matrix by which a difference automorphism moves a
fundamental solution matrix depends multiplicatively on the automorphism, so the automorphism group
maps to the invertible matrices over the base.  The map is injective as soon as the extension is
generated by the entries of the fundamental matrix and the inverse of its determinant, which is the
case for a Picard--Vessiot ring.

This is the difference Galois representation: the linear algebraic group in which the Galois group
of a difference equation lives.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K R : Type*} [Field K] [CommRing R] [Algebra K R] {n : ℕ}

/-- A `K`-algebra automorphism fixes every constant, once the constants all come from the base. -/
theorem apply_eq_self_of_noNewConstants {σR : R ≃+* R}
    (hnc : ∀ x : R, σR x = x → ∃ a : K, x = algebraMap K R a)
    (φ : R ≃ₐ[K] R) {x : R} (hx : σR x = x) : φ x = x := by
  obtain ⟨a, rfl⟩ := hnc x hx
  exact φ.commutes a

/-- Two automorphisms agreeing on the entries of a fundamental matrix agree on the extension
generated by those entries and the inverse of the determinant. -/
theorem algEquiv_eq_of_eq_on_fundamental (Y : Matrix (Fin n) (Fin n) R)
    (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) = ⊤)
    {φ ψ : R ≃ₐ[K] R} (h : ∀ i j, φ (Y i j) = ψ (Y i j)) : φ = ψ := by
  classical
  have hmapeq : Y.map (φ : R → R) = Y.map (ψ : R → R) := Matrix.ext fun i j => h i j
  have hdet : φ Y.det = ψ Y.det := by
    have h1 : φ Y.det = (Y.map (φ : R → R)).det := by
      have hd := RingHom.map_det (φ.toAlgHom.toRingHom) Y
      rw [RingHom.mapMatrix_apply] at hd
      exact hd
    have h2 : ψ Y.det = (Y.map (ψ : R → R)).det := by
      have hd := RingHom.map_det (ψ.toAlgHom.toRingHom) Y
      rw [RingHom.mapMatrix_apply] at hd
      exact hd
    rw [h1, h2, hmapeq]
  have hφu : φ Y.det * φ u = 1 := by rw [← map_mul, hu, map_one]
  have hψu : ψ Y.det * ψ u = 1 := by rw [← map_mul, hu, map_one]
  have huu : φ u = ψ u := by
    calc φ u = φ u * (ψ Y.det * ψ u) := by rw [hψu, mul_one]
      _ = (φ Y.det * φ u) * ψ u := by rw [hdet]; ring
      _ = ψ u := by rw [hφu, one_mul]
  apply AlgEquiv.ext
  intro x
  have hx : x ∈ Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) := by rw [htop]; trivial
  refine Algebra.adjoin_induction (p := fun y _ => φ y = ψ y) ?_ ?_ ?_ ?_ hx
  · rintro y (⟨p, rfl⟩ | hy)
    · exact h p.1 p.2
    · rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact huu
  · intro a
    exact (φ.commutes a).trans (ψ.commutes a).symm
  · intro a b _ _ ha hb
    rw [map_add, map_add, ha, hb]
  · intro a b _ _ ha hb
    rw [map_mul, map_mul, ha, hb]

variable (σR : R ≃+* R) (B : Matrix (Fin n) (Fin n) K) (Y : Matrix (Fin n) (Fin n) R)

/-- **The difference Galois representation.**  With no new constants, the Galois matrix defines a
group homomorphism from the difference automorphism group to the invertible matrices. -/
def galoisRepresentation [Invertible Y]
    (hY : Y.map (σR : R → R) = (B.map (algebraMap K R)) * Y)
    (hnc : ∀ x : R, σR x = x → ∃ a : K, x = algebraMap K R a) :
    differenceAut (K := K) σR →* (Matrix (Fin n) (Fin n) R)ˣ where
  toFun φ :=
    { val := galoisMatrix Y φ.1
      inv := galoisMatrix Y (φ.1)⁻¹
      val_inv := by
        have hmul := galoisMatrix_mul σR B Y hY φ.1 (φ.1)⁻¹
          ((differenceAut (K := K) σR).inv_mem φ.2)
          (fun x hx => apply_eq_self_of_noNewConstants hnc φ.1 hx)
        rw [← hmul, mul_inv_cancel, galoisMatrix_one]
      inv_val := by
        have hmul := galoisMatrix_mul σR B Y hY (φ.1)⁻¹ φ.1 φ.2
          (fun x hx => apply_eq_self_of_noNewConstants hnc (φ.1)⁻¹ hx)
        rw [← hmul, inv_mul_cancel, galoisMatrix_one] }
  map_one' := by
    apply Units.ext
    show galoisMatrix Y (1 : R ≃ₐ[K] R) = 1
    exact galoisMatrix_one Y
  map_mul' φ ψ := by
    apply Units.ext
    show galoisMatrix Y (φ.1 * ψ.1) = galoisMatrix Y φ.1 * galoisMatrix Y ψ.1
    exact galoisMatrix_mul σR B Y hY φ.1 ψ.1 ψ.2
      (fun x hx => apply_eq_self_of_noNewConstants hnc φ.1 hx)

@[simp] theorem galoisRepresentation_val [Invertible Y]
    (hY : Y.map (σR : R → R) = (B.map (algebraMap K R)) * Y)
    (hnc : ∀ x : R, σR x = x → ∃ a : K, x = algebraMap K R a)
    (φ : differenceAut (K := K) σR) :
    ((galoisRepresentation σR B Y hY hnc φ : (Matrix (Fin n) (Fin n) R)ˣ) :
      Matrix (Fin n) (Fin n) R) = galoisMatrix Y φ.1 := rfl

/-- **The representation is faithful.**  For a Picard--Vessiot ring — generated by the entries of
the fundamental matrix and the inverse of its determinant — the difference Galois group embeds in
the invertible matrices. -/
theorem galoisRepresentation_injective [Invertible Y]
    (hY : Y.map (σR : R → R) = (B.map (algebraMap K R)) * Y)
    (hnc : ∀ x : R, σR x = x → ∃ a : K, x = algebraMap K R a)
    (u : R) (hu : Y.det * u = 1)
    (htop : Algebra.adjoin K
      (Set.range (fun p : Fin n × Fin n => Y p.1 p.2) ∪ {u}) = ⊤) :
    Function.Injective (galoisRepresentation σR B Y hY hnc) := by
  intro φ ψ hφψ
  apply Subtype.ext
  refine algEquiv_eq_of_eq_on_fundamental Y u hu htop ?_
  intro i j
  refine map_eq_of_galoisMatrix_eq Y ?_ i j
  have := congrArg (fun v : (Matrix (Fin n) (Fin n) R)ˣ => (v : Matrix (Fin n) (Fin n) R)) hφψ
  simpa using this

end

end GaloisForLFunctions.HTGeometry
