import GaloisForLFunctions.HTGeometry.TorusMonomialIndependence
import GaloisForLFunctions.HTGeometry.PaletteEndomorphism

/-!
# The prefix endomorphism of a torus protocol

A nonsingular integer matrix gives a differential endomorphism of a freely generated differential
field: it sends the generating palette to the monomial family of the matrix, which is again
differentially independent, and its image is the differential field generated by that family.

Composition of these endomorphisms multiplies the matrices, so they are the prefix maps of an
isogeny protocol on the split torus `G_m ^ r`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

include hx hgen in
/-- **The torus prefix endomorphism.**  The differential endomorphism sending the generating palette
to its monomial family under a nonsingular integer matrix. -/
def torusEndo {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) : E →ₐ[C] E :=
  paletteEndo hx (differentialIndependent_monomialFamily hx hM) hgen

/-- The torus endomorphism substitutes the monomial family into the palette. -/
theorem torusEndo_apply {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (i : Fin r) :
    torusEndo hx hgen hM (x i) = monomialFamily M x i :=
  paletteEndo_apply hx (differentialIndependent_monomialFamily hx hM) hgen i

/-- The torus endomorphism commutes with the derivation. -/
theorem torusEndo_deriv {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (z : E) :
    torusEndo hx hgen hM z′ = Differential.deriv (torusEndo hx hgen hM z) :=
  paletteEndo_deriv hx (differentialIndependent_monomialFamily hx hM) hgen z

/-- **The image of the torus endomorphism** is the differential field of the monomial family. -/
theorem torusEndo_map_top {M : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) :
    IntermediateField.map (torusEndo hx hgen hM) ⊤
      = differentialAdjoin C (Set.range (monomialFamily M x)) :=
  paletteEndo_map_top hx (differentialIndependent_monomialFamily hx hM) hgen

/-- Torus endomorphisms with equal matrices agree. -/
theorem torusEndo_congr {M N : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (hN : N.det ≠ 0)
    (h : M = N) : torusEndo hx hgen hM = torusEndo hx hgen hN := by
  subst h
  rfl

/-- **Torus endomorphisms compose by multiplying matrices.** -/
theorem torusEndo_comp {M N : Matrix (Fin r) (Fin r) ℤ} (hM : M.det ≠ 0) (hN : N.det ≠ 0) :
    (torusEndo hx hgen hM).comp (torusEndo hx hgen hN)
      = torusEndo hx hgen (M := N * M)
        (by rw [Matrix.det_mul]; exact mul_ne_zero hN hM) := by
  have hx0 : ∀ i, x i ≠ 0 := by
    intro i hi
    exact ((algebraicIndependent_of_differentialIndependent hx).transcendental i)
      (hi ▸ isAlgebraic_zero)
  refine differentialAlgHom_ext_of_differentialAdjoin_eq_top x hgen _ _ (fun z ↦ ?_) (fun z ↦ ?_)
    (fun i ↦ ?_)
  · change torusEndo hx hgen hM (torusEndo hx hgen hN z′)
      = Differential.deriv (torusEndo hx hgen hM (torusEndo hx hgen hN z))
    rw [torusEndo_deriv, torusEndo_deriv]
  · exact torusEndo_deriv hx hgen _ z
  · change torusEndo hx hgen hM (torusEndo hx hgen hN (x i)) = _
    rw [torusEndo_apply, monomialFamily_apply, map_prod]
    have hfac : ∀ j : Fin r, torusEndo hx hgen hM (x j ^ N i j)
        = (monomialFamily M x j) ^ N i j := by
      intro j
      rw [map_zpow₀, torusEndo_apply]
    rw [Finset.prod_congr rfl fun j _ ↦ hfac j, torusEndo_apply]
    exact (congrFun (monomialFamily_mul N M hx0) i).symm

/-- The identity matrix gives the identity endomorphism. -/
theorem torusEndo_one (h1 : (1 : Matrix (Fin r) (Fin r) ℤ).det ≠ 0) :
    torusEndo hx hgen h1 = AlgHom.id C E := by
  refine differentialAlgHom_ext_of_differentialAdjoin_eq_top x hgen _ _
    (fun z ↦ torusEndo_deriv hx hgen h1 z) (fun z ↦ rfl) (fun i ↦ ?_)
  change torusEndo hx hgen h1 (x i) = x i
  rw [torusEndo_apply, monomialFamily_one]

end

end

end GaloisForLFunctions.HTGeometry
