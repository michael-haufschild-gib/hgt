/-- Complete signed two-atom odd determinant. -/
def twoAtomOddDet (q z : ℝ) : ℝ :=
  HilbertMetric.signedEvenHankelThreeDet (twoAtomOddProfile1 q z) (twoAtomOddProfile2 q z)
    (twoAtomOddProfile3 q z) (twoAtomOddProfile4 q z) (twoAtomOddProfile5 q z)

/-- Complete leading odd two-atom minor. -/
def twoAtomOddHead (q z : ℝ) : ℝ :=
  twoAtomOddProfile1 q z*twoAtomOddProfile3 q z-twoAtomOddProfile2 q z^(2 : ℕ)

