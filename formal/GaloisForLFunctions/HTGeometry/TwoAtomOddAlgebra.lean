  (120 : ℝ) +
    (2400 : ℝ)*z^(1 : ℕ) +
    (7680 : ℝ)*z^(2 : ℕ) +
    (-96 : ℝ)*q^(1 : ℕ) +
    (-10848 : ℝ)*q^(1 : ℕ)*z^(1 : ℕ) +
    (-24576 : ℝ)*q^(1 : ℕ)*z^(2 : ℕ) +
