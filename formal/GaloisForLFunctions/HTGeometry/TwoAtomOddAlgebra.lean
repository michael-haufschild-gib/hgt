/-- The exact det numerator represents the full retained rational expression. -/
theorem twoAtomOddDet_eq_quotient {q z : ℝ} (hq : q ≠ 0) (hd : 2*q-3 ≠ 0) :
    twoAtomOddDet q z = twoAtomOddDetNumerator q z/(q^(3 : ℕ)*(2*q-3)^(6 : ℕ)) := by
  unfold twoAtomOddDet HilbertMetric.signedEvenHankelThreeDet
    twoAtomOddProfile1 twoAtomOddProfile2 twoAtomOddProfile3 twoAtomOddProfile4 twoAtomOddProfile5
    twoAtomOddNumerator1 twoAtomOddNumerator2 twoAtomOddNumerator3 twoAtomOddNumerator4 twoAtomOddNumerator5 twoAtomOddDetNumerator
  field_simp [hq, hd]
  <;> ring

/-- The exact head numerator represents the full retained rational expression. -/
