import GaloisForLFunctions.HTGeometry.FiniteAlgebraicStateBoundary

/-!
# Finite-generator differential escape boundary

A finite rational state field is an ordinary intermediate field generated by finitely many state
coordinates.  If the derivative of every generator belongs to that same field, the field axioms
and the derivation rules make the whole state field derivation-closed.  Its ordinary transcendence
degree is finite, so every observable in it is differentially algebraic over the base.

The contrapositive is the useful hypertranscendence boundary: a finite rational packet containing a
hypertranscendental observable must lose at least one generator derivative.  Finite presentations,
bounded per-depth growth, and strict compatible transitions do not replace this closure condition.

This is parent differential algebra rather than a new scientific result.  It is the exact positive
successor to research programme 5 in `docs/reports/rh-status-1707.md`.
-/

open scoped Differential
open Set

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The intermediate field generated by a finite family has finite ordinary transcendence degree
over the base field. -/
theorem adjoin_range_trdeg_lt_aleph0
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Fintype ι]
    (s : ι → E) :
    Algebra.trdeg F (IntermediateField.adjoin F (Set.range s)) < Cardinal.aleph0 := by
  let S := IntermediateField.adjoin F (Set.range s)
  let sS : ι → S := fun i =>
    ⟨s i, IntermediateField.subset_adjoin F (Set.range s) (Set.mem_range_self i)⟩
  have hStop : IntermediateField.adjoin F (Set.range sS) = ⊤ := by
    let J := IntermediateField.adjoin F (Set.range sS)
    apply top_unique
    intro z hz
    change z ∈ J
    let p : ∀ y, y ∈ S → Prop := fun y hy => (⟨y, hy⟩ : S) ∈ J
    change p (z : E) z.2
    refine IntermediateField.adjoin_induction F (p := p) ?_ ?_ ?_ ?_ ?_ z.2
    · rintro y ⟨i, rfl⟩
      change sS i ∈ J
      exact IntermediateField.subset_adjoin F (Set.range sS) (Set.mem_range_self i)
    · intro c
      change algebraMap F S c ∈ J
      exact IntermediateField.algebraMap_mem J c
    · intro u v hu hv huJ hvJ
      simpa only [p, Subtype.coe_eta] using! J.add_mem huJ hvJ
    · intro u hu huJ
      simpa only [p, Subtype.coe_eta] using! J.inv_mem huJ
    · intro u v hu hv huJ hvJ
      simpa only [p, Subtype.coe_eta] using! J.mul_mem huJ hvJ
  letI : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range sS)) S :=
    isAlgebraic_adjoin_of_intermediate_adjoin_eq_top sS hStop
  letI : Fintype (Set.range sS) := Set.finite_range sS |>.fintype
  calc
    Algebra.trdeg F S ≤ Cardinal.mk (Set.range sS) :=
      Algebra.IsAlgebraic.trdeg_le_cardinalMk F (Set.range sS)
    _ < Cardinal.aleph0 := Cardinal.mk_lt_aleph0

/-- If the derivative of every generator lies in the generated field, then the entire generated
field is closed under the derivation. -/
theorem derivationClosed_adjoin_range_of_deriv_mem
    {F E ι : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    (s : ι → E)
    (hs : ∀ i, (s i)′ ∈ IntermediateField.adjoin F (Set.range s)) :
    DerivationClosed (IntermediateField.adjoin F (Set.range s)) := by
  intro x hx
  apply IntermediateField.adjoin_induction F
    (s := Set.range s)
    (p := fun y _ => y′ ∈ IntermediateField.adjoin F (Set.range s))
  · rintro y ⟨i, rfl⟩
    exact hs i
  · intro c
    rw [deriv_algebraMap]
    exact IntermediateField.algebraMap_mem _ _
  · intro a b ha hb hda hdb
    rw [map_add]
    exact IntermediateField.add_mem _ hda hdb
  · intro a ha hda
    rw [Derivation.leibniz_inv]
    have hainv : a⁻¹ ∈ IntermediateField.adjoin F (Set.range s) :=
      IntermediateField.inv_mem _ ha
    have hasq : a⁻¹ ^ (2 : ℕ) ∈ IntermediateField.adjoin F (Set.range s) := by
      simpa [pow_two] using IntermediateField.mul_mem _ hainv hainv
    exact IntermediateField.mul_mem _ (IntermediateField.neg_mem _ hasq) hda
  · intro a b ha hb hda hdb
    rw [Derivation.leibniz]
    exact IntermediateField.add_mem _
      (IntermediateField.mul_mem _ ha hdb) (IntermediateField.mul_mem _ hb hda)
  exact hx

/-- **Finite-generator differential-state theorem.** Every observable in a finite rational state
field whose generators differentiate back into the state is differentially algebraic over the
base. -/
theorem differentialAlgebraicOver_of_mem_finiteGeneratorState
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Fintype ι]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (s : ι → E)
    (hs : ∀ i, (s i)′ ∈ IntermediateField.adjoin F (Set.range s))
    {x : E} (hx : x ∈ IntermediateField.adjoin F (Set.range s)) :
    DifferentialAlgebraicOver F x := by
  exact differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    (IntermediateField.adjoin F (Set.range s))
    (derivationClosed_adjoin_range_of_deriv_mem s hs)
    (adjoin_range_trdeg_lt_aleph0 s) hx

/-- **Positive HT escape law.** If a finite rational state field contains a
hypertranscendental observable, the derivative of at least one chosen generator escapes that
field. -/
theorem exists_generator_deriv_escape_of_hypertranscendentalOver
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Fintype ι]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (s : ι → E) {x : E} (hx : HypertranscendentalOver F x)
    (hxS : x ∈ IntermediateField.adjoin F (Set.range s)) :
    ∃ i, (s i)′ ∉ IntermediateField.adjoin F (Set.range s) := by
  classical
  by_contra hescape
  have hs : ∀ i, (s i)′ ∈ IntermediateField.adjoin F (Set.range s) := by
    intro i
    by_contra hi
    exact hescape ⟨i, hi⟩
  exact hx (differentialAlgebraicOver_of_mem_finiteGeneratorState s hs hxS)

end

end GaloisForLFunctions.HTGeometry
