import GaloisForLFunctions.HTGeometry.RittTowerDescentStep

/-!
# The jet tower of a differentially algebraic linearizer descends to a base relation

Feeding the explicit Faà di Bruno expansion of `σ (d^[n] τ)` into the tower descent: if the first
`n` jets of a linearizer are independent and the `n`-th lies in the field they generate, then the
base carries a nonzero solution of

`ψ(u) = c·u + g`,  `c ≠ 0`,

with `g` either zero — an invariant-differential relation — or a nonzero base multiple of one of the
Faà di Bruno coefficients of the shift.  For `n = 2` the coefficient is
`dK(q/ρ)/ρ = −(dK ρ)/ρ² · q/ρ`, and the relation is the rational affine connection; the general `n`
gives the same shape with the higher coefficients.

This is the form in which Ritt's remaining implication meets the corpus's obstruction theory: a map
admitting none of these relations has no differentially algebraic linearizer beyond the order-one
case.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- **The tower capstone.**  A jet of a linearizer lying in the field generated by its predecessors
produces a base relation `ψ(u) = c·u + g` whose inhomogeneity is a base multiple of a Faà di Bruno
coefficient of the shift. -/
theorem exists_base_relation_of_jet_mem (Fr : RittFrame K L) {τ : L} {q : K}
    (hq : q ≠ 0) (hqconst : Fr.dK q = 0) (hshift : Fr.σ τ = algebraMap K L q * τ)
    {n : ℕ} (htr : ∀ k, k < n → Transcendental ↥(Fr.jetPrefixField τ k) (Fr.d^[k] τ))
    (hjet0 : Fr.d^[n] τ ≠ 0) (hmem : Fr.d^[n] τ ∈ Fr.jetPrefixField τ n) :
    ∃ (A : ℕ → K), (Fr.σ (Fr.d^[n] τ)
        = algebraMap K L (q / Fr.ρ ^ n) * Fr.d^[n] τ
          + ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j] τ) ∧
      ∃ u c g : K, u ≠ 0 ∧ c ≠ 0 ∧ (∃ i k : ℤ, c = q ^ i * Fr.ρ ^ k) ∧
        (g = 0 ∨ ∃ (j : ℕ) (z : K), z ≠ 0 ∧ g = z * A j) ∧
        Fr.ψ u = c * u + g := by
  obtain ⟨A, hAsupp, hA⟩ := exists_shift_jet_coeffs Fr hshift n
  refine ⟨A, hA, ?_⟩
  have hc0 : q / Fr.ρ ^ n ≠ 0 := div_ne_zero hq (pow_ne_zero _ Fr.ρ_ne)
  obtain ⟨u, c, g, hu0, hc, hcinv, hginv, hrel⟩ :=
    exists_base_relation_of_tower Fr hq hqconst hshift 0 A n htr (Fr.d^[n] τ)
      (q / Fr.ρ ^ n) 0 A hjet0 hmem hc0
      ⟨1, -(n : ℤ), by rw [zpow_one, zpow_neg, zpow_natCast, div_eq_mul_inv]⟩ (Or.inl rfl)
      (fun j => Or.inr ⟨1, one_ne_zero, (one_mul (A j)).symm⟩)
      (by simpa using hA)
  refine ⟨u, c, g, hu0, hc, hcinv, ?_, hrel⟩
  rcases hginv with h0 | ⟨j, z, hz0, hz⟩
  · exact Or.inl h0
  · rcases hz with hz | hz
    · exact Or.inr ⟨j, z, hz0, hz⟩
    · exact Or.inl (by rw [hz, mul_zero])

end GaloisForLFunctions.HTGeometry
