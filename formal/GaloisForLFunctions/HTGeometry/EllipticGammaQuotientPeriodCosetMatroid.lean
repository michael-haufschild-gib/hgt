import GaloisForLFunctions.HTGeometry.CoordinatewiseDifferentialFamilyMatroid
import GaloisForLFunctions.HTGeometry.EllipticGammaPairwiseCommonModeSpectrum
import GaloisForLFunctions.HTGeometry.DifferentialPairwiseCommonMode
import GaloisForLFunctions.HTGeometry.DifferentialSemilinearAutomorphism
import GaloisForLFunctions.HTGeometry.EllipticGammaPeriodCosetMatroid
import GaloisForLFunctions.HTGeometry.MultiplicativeTranslationCharacter

/-!
# Period-coset matroid of elliptic-gamma shift quotients

The additive external defect is the algebraic logarithmic derivative of the corresponding
multiplicative elliptic-gamma shift quotient.  Coordinatewise logarithmic derivatives preserve
the entire represented differential matroid, so the exact pointed period-coset partition law
transfers without a finiteness hypothesis.
-/

open Filter Set Topology Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher
open HTGeometry

noncomputable section

local instance ellipticGammaQuotientPeriodCosetDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance ellipticGammaQuotientPeriodCosetComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring Set.univ) := (constToAnalytic Set.univ).toAlgebra

local instance ellipticGammaQuotientPeriodCosetComplexAlgebraMero :
    Algebra ℂ (meroField Set.univ) :=
  meromorphicEllipticCompositumComplexAlgebraMero

local instance ellipticGammaQuotientPeriodCosetAmbientDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance ellipticGammaQuotientPeriodCosetMeroCharZero :
    CharZero (meroField Set.univ) :=
  charZero_of_injective_algebraMap
    (algebraMap ℂ (meroField Set.univ)).injective

local instance ellipticGammaQuotientPeriodCosetRestrictedDifferential
    (sigma tau : ℂ) :
    Differential (meromorphicEllipticCompositum sigma tau) :=
  meromorphicEllipticCompositumDifferential sigma tau

local instance ellipticGammaQuotientPeriodCosetDifferentialAlgebra
    (sigma tau : ℂ) :
    DifferentialAlgebra (meromorphicEllipticCompositum sigma tau)
      (meroField Set.univ) :=
  ⟨fun x ↦ derivationClosedDifferential_apply
    (meromorphicEllipticCompositum sigma tau)
    (meromorphicEllipticCompositum_derivationClosed sigma tau) x⟩

/-- Every ambient translation is a differential semilinear automorphism over the paired elliptic
compositum: it acts nontrivially on that coefficient field but maps it onto itself. -/
noncomputable def meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv
    (sigma tau q : ℂ) :
    HTGeometry.DifferentialSemilinearEquiv
      (meromorphicEllipticCompositum sigma tau) (meroField Set.univ) where
  baseEquiv :=
    (meromorphicEllipticCompositumTranslationAlgEquiv sigma tau q).toRingEquiv
  ambientEquiv := addTranslationMeroAlgEquiv q
  map_algebraMap' x := by
    exact (meromorphicEllipticCompositumTranslationAlgEquiv_apply
      sigma tau q x).symm
  map_base_deriv' x :=
    meromorphicEllipticCompositumTranslation_deriv sigma tau q x
  map_ambient_deriv' x := by
    simpa using! addTranslationMeroEquiv_deriv q x

/-- Translation carries every differential field generated over the paired elliptic compositum
exactly to the field generated by the translated values. -/
theorem meromorphicEllipticCompositumTranslation_map_differentialAdjoin
    (sigma tau q : ℂ) (s : Set (meroField Set.univ)) :
    (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv
      sigma tau q).mapIntermediateField
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau) s) =
      differentialAdjoin (meromorphicEllipticCompositum sigma tau)
        (addTranslationMeroEquiv q '' s) :=
  DifferentialSemilinearEquiv.mapIntermediateField_differentialAdjoin
    (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv sigma tau q) s

/-- **Relative elliptic-compositum translation covariance.** Common translation preserves
hypertranscendence over every generated observation field, without requiring the observation set
to be independent. -/
theorem hypertranscendentalOver_meromorphicEllipticCompositumTranslation_differentialAdjoin_image_iff
    (sigma tau q : ℂ) (s : Set (meroField Set.univ)) (x : meroField Set.univ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (addTranslationMeroEquiv q '' s))
        (addTranslationMeroEquiv q x) ↔
      HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau) s) x :=
  DifferentialSemilinearEquiv.hypertranscendentalOver_differentialAdjoin_image_iff
    (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv sigma tau q) s x

/-- Relative differential algebraicity over arbitrary generated elliptic-compositum fields is
preserved by the same common translation. -/
theorem differentialAlgebraicOver_meromorphicEllipticCompositumTranslation_differentialAdjoin_image_iff
    (sigma tau q : ℂ) (s : Set (meroField Set.univ)) (x : meroField Set.univ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (addTranslationMeroEquiv q '' s))
        (addTranslationMeroEquiv q x) ↔
      DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau) s) x :=
  DifferentialSemilinearEquiv.differentialAlgebraicOver_differentialAdjoin_image_iff
    (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv sigma tau q) s x

/-- The genuine multiplicative shift quotient `Gamma(z+h)/Gamma(z)` in the global meromorphic
field. -/
def ellipticGammaExternalQuotientMero
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    meroField Set.univ :=
  addTranslationMeroEquiv h (ellipticGammaMero sigma tau hsigma htau) /
    ellipticGammaMero sigma tau hsigma htau

/-- Every genuine elliptic-gamma shift quotient is a nonzero meromorphic-field element. -/
theorem ellipticGammaExternalQuotientMero_ne_zero
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    ellipticGammaExternalQuotientMero h sigma tau hsigma htau ≠ 0 := by
  exact div_ne_zero
    ((addTranslationMeroEquiv h).map_ne_zero_iff.mpr
      (ellipticGammaMero_ne_zero sigma tau hsigma htau))
    (ellipticGammaMero_ne_zero sigma tau hsigma htau)

/-- **Multiplicative quotient reflection.** The quotient at the reflected shift is the inverse of
the original quotient translated back by that shift. -/
theorem ellipticGammaExternalQuotientMero_neg
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    ellipticGammaExternalQuotientMero (-h) sigma tau hsigma htau =
      (addTranslationMeroEquiv (-h)
        (ellipticGammaExternalQuotientMero h sigma tau hsigma htau))⁻¹ := by
  simpa [ellipticGammaExternalQuotientMero] using
    addTranslationMeroEquiv_div_self_neg h
      (ellipticGammaMero sigma tau hsigma htau)

/-- Genuine elliptic-gamma shift quotients instantiate the universal multiplicative translation
cocycle. -/
theorem ellipticGammaExternalQuotientMero_add
    (p q sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    ellipticGammaExternalQuotientMero (p + q) sigma tau hsigma htau =
      ellipticGammaExternalQuotientMero p sigma tau hsigma htau *
        addTranslationMeroEquiv p
          (ellipticGammaExternalQuotientMero q sigma tau hsigma htau) := by
  simpa [ellipticGammaExternalQuotientMero] using
    addTranslationMeroEquiv_div_self_add p q
      (ellipticGammaMero sigma tau hsigma htau)

/-- **Concrete elliptic-gamma cocycle character law.** Once a meromorphic-field automorphism
commutes with translations and scales the genuine quotient packet by translation-fixed units, its
scalars form a character. Nonvanishing and the cocycle hypotheses are discharged by the actual
elliptic-gamma quotient. -/
theorem ellipticGammaExternalQuotient_scalars_mul
    (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (gamma : meroField Set.univ ≃+* meroField Set.univ)
    (c : ℂ → (meroField Set.univ)ˣ)
    (hcomm : ∀ h x, gamma (addTranslationMeroEquiv h x) =
      addTranslationMeroEquiv h (gamma x))
    (hfixed : ∀ h k, addTranslationMeroEquiv h (c k : meroField Set.univ) = c k)
    (hscale : ∀ h, gamma
      (ellipticGammaExternalQuotientMero h sigma tau hsigma htau) =
        (c h : meroField Set.univ) *
          ellipticGammaExternalQuotientMero h sigma tau hsigma htau)
    (p q : ℂ) : c (p + q) = c p * c q := by
  have hchar := multiplicativeTranslationCocycle_scalars_mul_of_exists_ne_zero
    (fun h ↦ addTranslationMeroEquiv h)
    (fun h ↦ ellipticGammaExternalQuotientMero h sigma tau hsigma htau)
    gamma c
    (fun a b ↦ ellipticGammaExternalQuotientMero_add
      a b sigma tau hsigma htau)
    hcomm hfixed hscale
    ⟨0, ellipticGammaExternalQuotientMero_ne_zero 0 sigma tau hsigma htau⟩
  exact hchar p q

/-- Translation commutes with the algebraic logarithmic derivative of the genuine elliptic-gamma
field element. -/
theorem logDeriv_addTranslationMeroEquiv_ellipticGammaMero
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    Differential.logDeriv
        (addTranslationMeroEquiv h (ellipticGammaMero sigma tau hsigma htau)) =
      addTranslationMeroEquiv h
        (ellipticGammaLogDerivMero sigma tau hsigma htau) := by
  rw [Differential.logDeriv, ellipticGammaLogDerivMero,
    map_div₀, addTranslationMeroEquiv_deriv]

/-- The logarithmic derivative of a genuine shift quotient is exactly the external additive
defect. -/
theorem ellipticGammaExternalQuotientMero_logDeriv
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    (ellipticGammaExternalQuotientMero h sigma tau hsigma htau)′ /
        ellipticGammaExternalQuotientMero h sigma tau hsigma htau =
      ellipticGammaExternalLogDerivDefectMero h sigma tau hsigma htau := by
  change Differential.logDeriv
      (addTranslationMeroEquiv h (ellipticGammaMero sigma tau hsigma htau) /
        ellipticGammaMero sigma tau hsigma htau) = _
  rw [Differential.logDeriv_div]
  · rw [logDeriv_addTranslationMeroEquiv_ellipticGammaMero]
    rfl
  · exact (addTranslationMeroEquiv h).map_ne_zero_iff.mpr
      (ellipticGammaMero_ne_zero sigma tau hsigma htau)
  · exact ellipticGammaMero_ne_zero sigma tau hsigma htau

/-- **Exact DA spectrum of the genuine multiplicative quotient.** Over the paired elliptic
compositum, an elliptic-gamma shift quotient is differentially algebraic exactly on the rank-three
integer period group. -/
theorem differentialAlgebraicOver_ellipticGammaExternalQuotientMero_iff_resonant
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    DifferentialAlgebraicOver (meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientMero h sigma tau hsigma htau) ↔
      ∃ a b n : ℤ, h = a + b * tau + n * sigma := by
  rw [← differentialAlgebraicOver_deriv_div_self_iff]
  rw [ellipticGammaExternalQuotientMero_logDeriv]
  exact
    differentialAlgebraicOver_ellipticGammaExternalLogDerivDefectMero_iff_resonant
      h sigma tau hsigma htau hindependent

/-- Equivalently, every nonresonant genuine elliptic-gamma quotient is hypertranscendental over
the paired elliptic compositum. -/
theorem hypertranscendentalOver_ellipticGammaExternalQuotientMero_iff_nonresonant
    (h sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    HypertranscendentalOver (meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientMero h sigma tau hsigma htau) ↔
      ThetaTranslationNonresonant tau sigma h := by
  simpa [HypertranscendentalOver, ThetaTranslationNonresonant] using
    not_congr
      (differentialAlgebraicOver_ellipticGammaExternalQuotientMero_iff_resonant
        h sigma tau hsigma htau hindependent)

/-- **Natural-base logarithmic-source hypertranscendence.**  The exact off-spectrum additive
defect forces the genuine elliptic-gamma logarithmic derivative itself to be
hypertranscendental over the larger paired elliptic compositum.  The semilinear escape law is
essential because translation normalizes this base but does not fix it pointwise. -/
theorem hypertranscendentalOver_ellipticGammaLogDerivMero_ellipticCompositum
    (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    HypertranscendentalOver (meromorphicEllipticCompositum sigma tau)
      (ellipticGammaLogDerivMero sigma tau hsigma htau) := by
  obtain ⟨h, hnonres⟩ := exists_thetaTranslationNonresonant tau sigma
  apply (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv
    sigma tau h).hypertranscendentalOver_of_sub_self
  simpa [meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv,
    ellipticGammaExternalLogDerivDefectMero] using!
    (hypertranscendentalOver_ellipticGammaExternalLogDerivDefectMero_iff_nonresonant
      h sigma tau hsigma htau hindependent).2 hnonres

/-- **Natural-base elliptic-gamma hypertranscendence.**  The genuine meromorphic elliptic-gamma
product is hypertranscendental even over the paired elliptic compositum.  An off-spectrum
multiplicative quotient supplies the escaping differential source under a translation which
normalizes that base. -/
theorem hypertranscendentalOver_ellipticGammaMero_ellipticCompositum
    (sigma tau : ℂ) (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    HypertranscendentalOver (meromorphicEllipticCompositum sigma tau)
      (ellipticGammaMero sigma tau hsigma htau) := by
  obtain ⟨h, hnonres⟩ := exists_thetaTranslationNonresonant tau sigma
  apply (meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv
    sigma tau h).hypertranscendentalOver_of_div_self
  simpa [meromorphicEllipticCompositumTranslationDifferentialSemilinearEquiv,
    ellipticGammaExternalQuotientMero] using!
    (hypertranscendentalOver_ellipticGammaExternalQuotientMero_iff_nonresonant
      h sigma tau hsigma htau hindependent).2 hnonres

/-- A family of genuine multiplicative elliptic-gamma shift quotients. -/
def ellipticGammaExternalQuotientFamily
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    κ → meroField Set.univ := fun j ↦
  ellipticGammaExternalQuotientMero (h j) sigma tau hsigma htau

/-- The multiplicative quotient reflection law holds componentwise for every indexed packet. -/
theorem ellipticGammaExternalQuotientFamily_reflection
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    ellipticGammaExternalQuotientFamily
        (fun j ↦ -h j) sigma tau hsigma htau =
      fun j ↦ (addTranslationMeroEquiv (-h j)
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau j))⁻¹ := by
  funext j
  exact ellipticGammaExternalQuotientMero_neg
    (h j) sigma tau hsigma htau

/-- The quotient family and its additive external-defect family represent the same differential
matroid over the paired elliptic compositum. -/
theorem ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im) :
    differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau) =
      differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau) := by
  calc
    differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau) =
      differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (fun j ↦
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau j)′ /
            ellipticGammaExternalQuotientFamily h sigma tau hsigma htau j) :=
      HTGeometry.differentialFamilyMatroid_deriv_div_self_eq _
    _ = differentialFamilyMatroid
        (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau) := by
      congr 1
      funext j
      exact ellipticGammaExternalQuotientMero_logDeriv
        (h j) sigma tau hsigma htau

/-- **Relative logarithmic-derivative invariance.** Replacing every genuine multiplicative
elliptic-gamma quotient by its additive logarithmic defect preserves hypertranscendence of any
marked coordinate over the differential field generated by any indexed observation set. The two
generated fields need not coincide; equality of their represented differential matroids is the
exact invariant. -/
theorem ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_image_iff_defectFamily
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (I : Set κ) (anchor : κ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) :=
  hypertranscendentalOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily
      h sigma tau hsigma htau)
    I anchor

/-- The same logarithmic-derivative replacement preserves differential algebraicity over every
indexed generated field. -/
theorem ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_defectFamily
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (I : Set κ) (anchor : κ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalDefectFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalDefectFamily h sigma tau hsigma htau anchor) :=
  differentialAlgebraicOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)
    (ellipticGammaExternalDefectFamily h sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily
      h sigma tau hsigma htau)
    I anchor

/-- **Arbitrary-observation quotient HT spectrum.** A multiplicative elliptic-gamma quotient is
hypertranscendental over any selected quotient observation field exactly when its period class is
nonresonant and absent from the selected period classes. This is transported through the exact
logarithmic-derivative representation equivalence, although the quotient and defect generated
fields are not asserted equal. -/
theorem ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_image_iff_nonresonant_unobserved_periodClass
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) ≠ 0 ∧
        ellipticGammaPeriodClass sigma tau (h anchor) ∉
          (ellipticGammaPeriodClass sigma tau ∘ h) '' I := by
  have htransfer :=
    ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_image_iff_defectFamily
      h sigma tau hsigma htau I anchor
  have hspectrum :=
    ellipticGammaExternalDefectFamily_hypertranscendentalOver_differentialAdjoin_image_iff_nonresonant_unobserved_periodClass
      h sigma tau hsigma htau hindependent I anchor
  exact htransfer.trans hspectrum

/-- **Arbitrary-observation quotient DA spectrum.** Dually, a multiplicative quotient is
differentially algebraic over a selected quotient packet exactly on the resonant period class or
when its period class has already been observed. -/
theorem ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_resonant_or_observed_periodClass
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) = 0 ∨
        ellipticGammaPeriodClass sigma tau (h anchor) ∈
          (ellipticGammaPeriodClass sigma tau ∘ h) '' I := by
  have htransfer :=
    ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_defectFamily
      h sigma tau hsigma htau I anchor
  have hspectrum :=
    ellipticGammaExternalDefectFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_resonant_or_observed_periodClass
      h sigma tau hsigma htau hindependent I anchor
  exact htransfer.trans hspectrum

/-- **Complete multiplicative quotient circuit spectrum.** Minimal differential relations among
genuine elliptic-gamma quotients are exactly resonant singletons and pairs of distinct shifts in
one common nonzero period class. The logarithmic-derivative representation introduces no extra
circuits. -/
theorem ellipticGammaExternalQuotientFamily_differentialFamilyMatroid_isCircuit_iff
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (C : Set κ) :
    (differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)).IsCircuit C ↔
      (∃ i, C = {i} ∧ ellipticGammaPeriodClass sigma tau (h i) = 0) ∨
        ∃ i j, i ≠ j ∧ C = {i, j} ∧
          ellipticGammaPeriodClass sigma tau (h i) =
            ellipticGammaPeriodClass sigma tau (h j) ∧
          ellipticGammaPeriodClass sigma tau (h i) ≠ 0 := by
  rw [ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily]
  exact
    ellipticGammaExternalDefectFamily_differentialFamilyMatroid_isCircuit_iff
      h sigma tau hsigma htau hindependent C

/-- **Reflection invariance of the quotient-family matroid.** Every differential dependence among
genuine elliptic-gamma quotients is preserved when all shift parameters are negated. -/
theorem ellipticGammaExternalQuotientFamily_differentialMatroid_reflection
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientFamily
          (fun j ↦ -h j) sigma tau hsigma htau) =
      differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau) := by
  rw [ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily
      (fun j ↦ -h j) sigma tau hsigma htau,
    ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily
      h sigma tau hsigma htau]
  exact ellipticGammaExternalDefectFamily_differentialMatroid_reflection
    h sigma tau hsigma htau hindependent

/-- **Relative quotient reflection invariance.** Simultaneous shift reflection preserves
hypertranscendence of a marked multiplicative quotient over every selected reflected quotient
observation field. -/
theorem ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_image_reflection_iff
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily
            (fun j ↦ -h j) sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily
          (fun j ↦ -h j) sigma tau hsigma htau anchor) ↔
      HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) :=
  hypertranscendentalOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalQuotientFamily
      (fun j ↦ -h j) sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily_differentialMatroid_reflection
      h sigma tau hsigma htau hindependent)
    I anchor

/-- Relative differential algebraicity over arbitrary selected quotient observations is
preserved by the same simultaneous reflection. -/
theorem ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_image_reflection_iff
    {κ : Type*} (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) (anchor : κ) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily
            (fun j ↦ -h j) sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily
          (fun j ↦ -h j) sigma tau hsigma htau anchor) ↔
      DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau '' I))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) :=
  differentialAlgebraicOver_differentialAdjoin_image_iff_of_differentialFamilyMatroid_eq
    (ellipticGammaExternalQuotientFamily
      (fun j ↦ -h j) sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)
    (ellipticGammaExternalQuotientFamily_differentialMatroid_reflection
      h sigma tau hsigma htau hindependent)
    I anchor

/-- **Full quotient period-coset partition matroid.**  For arbitrary shifts, the differential
matroid of genuine elliptic-gamma quotients over the paired elliptic compositum has the zero
period class as its loop class and one rank-one parallel class for every nonzero period coset. -/
theorem ellipticGammaExternalQuotientFamily_differentialMatroid_eq_periodCosetPartitionMatroid
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau) =
      affinePointedCollisionMatroid
        (ellipticGammaPeriodClass sigma tau ∘ h) 0 := by
  rw [ellipticGammaExternalQuotientFamily_differentialMatroid_eq_defectFamily,
    ellipticGammaExternalDefectFamily_differentialMatroid_eq_periodCosetPartitionMatroid
      h sigma tau hsigma htau hindependent]

/-- **Exact relative quotient HT spectrum.** A genuine elliptic-gamma shift quotient is
hypertranscendental over the differential field generated by all other quotient values exactly
when its period class is nonzero and uniquely occupied. -/
theorem ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonresonant_periodClass
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    HypertranscendentalOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau ''
            (Set.univ \ {anchor})))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) ≠ 0 ∧
        ∀ j, ellipticGammaPeriodClass sigma tau (h j) =
          ellipticGammaPeriodClass sigma tau (h anchor) → j = anchor := by
  have htransfer :=
    ellipticGammaExternalQuotientFamily_hypertranscendentalOver_differentialAdjoin_image_iff_defectFamily
      h sigma tau hsigma htau (Set.univ \ {anchor}) anchor
  have hspectrum :=
    ellipticGammaExternalDefectFamily_hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonresonant_periodClass
      anchor h sigma tau hsigma htau hindependent
  exact htransfer.trans hspectrum

/-- **Exact relative quotient DA spectrum.** A genuine elliptic-gamma quotient is DA over all
other quotient values exactly when its period class is resonant or repeated elsewhere. -/
theorem ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_compl_iff_resonant_or_repeated_periodClass
    {κ : Type*}
    (anchor : κ) (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau)) :
    DifferentialAlgebraicOver
        (differentialAdjoin (meromorphicEllipticCompositum sigma tau)
          (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau ''
            (Set.univ \ {anchor})))
        (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau anchor) ↔
      ellipticGammaPeriodClass sigma tau (h anchor) = 0 ∨
        ∃ j, j ≠ anchor ∧ ellipticGammaPeriodClass sigma tau (h j) =
          ellipticGammaPeriodClass sigma tau (h anchor) := by
  have htransfer :=
    ellipticGammaExternalQuotientFamily_differentialAlgebraicOver_differentialAdjoin_image_iff_defectFamily
      h sigma tau hsigma htau (Set.univ \ {anchor}) anchor
  have hspectrum :=
    ellipticGammaExternalDefectFamily_differentialAlgebraicOver_differentialAdjoin_compl_iff_resonant_or_repeated_periodClass
      anchor h sigma tau hsigma htau hindependent
  exact htransfer.trans hspectrum

/-- **Exact quotient-family rank law.**  The extended differential rank of any genuine
elliptic-gamma quotient packet is the number of distinct nonzero period classes it meets. -/
theorem ellipticGammaExternalQuotientFamily_eRk_eq_nonzeroPeriodClass_encard
    {κ : Type*}
    (h : κ → ℂ) (sigma tau : ℂ)
    (hsigma : 0 < sigma.im) (htau : 0 < tau.im)
    (hindependent : LinearIndependent ℚ (ellipticGammaSourcePeriods sigma tau))
    (I : Set κ) :
    (differentialFamilyMatroid (F := meromorphicEllipticCompositum sigma tau)
      (ellipticGammaExternalQuotientFamily h sigma tau hsigma htau)).eRk I =
      (((ellipticGammaPeriodClass sigma tau ∘ h) '' I) ∩
        {q | q ≠ 0}).encard := by
  rw [ellipticGammaExternalQuotientFamily_differentialMatroid_eq_periodCosetPartitionMatroid
    h sigma tau hsigma htau hindependent,
    affinePointedCollisionMatroid_eRk]

end

