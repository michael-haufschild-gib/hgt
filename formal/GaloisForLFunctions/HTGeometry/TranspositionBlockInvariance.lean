import Mathlib.GroupTheory.GroupAction.Blocks
import Mathlib.GroupTheory.Perm.Support
import Mathlib.GroupTheory.GroupAction.Primitive

/-!
# A transposition preserves every block of size at least two

A block of a group action is either preserved by a group element or moved off itself.  An element
acting as a transposition can only move a block off itself by moving *every* point of that block,
and it moves only two points, so a block with at least two elements is the transposed pair — which
the transposition preserves.

```text
isBlock_smul_eq_of_swapLike, isBlock_smul_eq_of_isSwap
    ** a transposition fixes every block with two or more elements, setwise **
exists_block_of_not_isPreprimitive
```

Consequently the inertia generated by a meridian transposition acts trivially on any block system,
so the block field of a cover is unramified at the branch place: this is the group-theoretic half of
the step that turns a block system into an everywhere-unramified intermediate cover.
-/

namespace GaloisForLFunctions.HTGeometry

open MulAction
open scoped Pointwise


/-- **A group element acting as a transposition preserves every block with at least two
elements.**  If it did not, the block would be disjoint from its image, so the element would move
every point of the block; a transposition moves only two points, so the block is exactly the
transposed pair — which the transposition preserves. -/
theorem isBlock_smul_eq_of_swapLike {G X : Type*} [Group G] [MulAction G X]
    {B : Set X} (hB : MulAction.IsBlock G B) {g : G} {a b : X}
    (hga : g • a = b) (hfix : ∀ x : X, x ≠ a → x ≠ b → g • x = x)
    (hB2 : ∃ x ∈ B, ∃ y ∈ B, x ≠ y) :
    g • B = B := by
  rcases hB.smul_eq_or_disjoint g with h | h
  · exact h
  · exfalso
    obtain ⟨x, hx, y, hy, hxy⟩ := hB2
    have hsub : ∀ z ∈ B, z = a ∨ z = b := by
      intro z hz
      by_contra hcon
      push Not at hcon
      have hzz : g • z = z := hfix z hcon.1 hcon.2
      have hmem : g • z ∈ g • B := Set.smul_mem_smul_set hz
      rw [hzz] at hmem
      exact (Set.disjoint_left.mp h) hmem hz
    have haB : a ∈ B := by
      rcases hsub x hx with hxa | hxb
      · exact hxa ▸ hx
      · rcases hsub y hy with hya | hyb
        · exact hya ▸ hy
        · exact absurd (hxb.trans hyb.symm) hxy
    have hbB : b ∈ B := by
      rcases hsub x hx with hxa | hxb
      · rcases hsub y hy with hya | hyb
        · exact absurd (hxa.trans hya.symm) hxy
        · exact hyb ▸ hy
      · exact hxb ▸ hx
    have hmem : b ∈ g • B := by
      rw [← hga]
      exact Set.smul_mem_smul_set haB
    exact (Set.disjoint_left.mp h) hmem hbB

/-- **A transposition of a permutation subgroup preserves every block with at least two
elements.** -/
theorem isBlock_smul_eq_of_isSwap {X : Type*} [DecidableEq X] {G : Subgroup (Equiv.Perm X)}
    {B : Set X} (hB : MulAction.IsBlock G B) {t : G} (ht : (t : Equiv.Perm X).IsSwap)
    (hB2 : ∃ x ∈ B, ∃ y ∈ B, x ≠ y) : t • B = B := by
  obtain ⟨a, b, _hab, hswap⟩ := ht
  refine isBlock_smul_eq_of_swapLike hB (a := a) (b := b) ?_ ?_ hB2
  · show (t : Equiv.Perm X) a = b
    rw [hswap]
    exact Equiv.swap_apply_left a b
  · intro x hxa hxb
    show (t : Equiv.Perm X) x = x
    rw [hswap]
    exact Equiv.swap_apply_of_ne_of_ne hxa hxb

/-- A failure of primitivity produces a block with at least two elements that is not everything. -/
theorem exists_block_of_not_isPreprimitive {G X : Type*} [Group G] [MulAction G X]
    [MulAction.IsPretransitive G X] (h : ¬ MulAction.IsPreprimitive G X) :
    ∃ B : Set X, MulAction.IsBlock G B ∧ (∃ x ∈ B, ∃ y ∈ B, x ≠ y) ∧ B ≠ Set.univ := by
  by_contra hcon
  push Not at hcon
  refine h ⟨fun {B} hB => ?_⟩
  by_cases hsub : B.Subsingleton
  · exact Or.inl hsub
  · refine Or.inr ?_
    obtain ⟨x, hx, y, hy, hxy⟩ := Set.not_subsingleton_iff.mp hsub
    exact hcon B hB ⟨x, hx, y, hy, hxy⟩

/-- **An element of a permutation subgroup that is trivial or a transposition preserves every block
with at least two elements.** -/
theorem isBlock_smul_eq_of_eq_one_or_isSwap {X : Type*} [DecidableEq X]
    {G : Subgroup (Equiv.Perm X)} {B : Set X} (hB : MulAction.IsBlock G B) {t : G}
    (ht : (t : Equiv.Perm X) = 1 ∨ (t : Equiv.Perm X).IsSwap)
    (hB2 : ∃ x ∈ B, ∃ y ∈ B, x ≠ y) : t • B = B := by
  rcases ht with h | h
  · rw [show t = 1 from Subtype.ext h, one_smul]
  · exact isBlock_smul_eq_of_isSwap hB h hB2

/-- **The same for a permutation given with a membership proof.**  Stated so that the subtype of the
ambient group is built inside this lemma, where the types are small: constructing it in a context
carrying a large field tower is a defeq check the unifier cannot afford. -/
theorem isBlock_perm_smul_eq_of_eq_one_or_isSwap {X : Type*} [DecidableEq X]
    {G : Subgroup (Equiv.Perm X)} {B : Set X} (hB : MulAction.IsBlock G B)
    {t : Equiv.Perm X} (htG : t ∈ G) (ht : t = 1 ∨ t.IsSwap)
    (hB2 : ∃ x ∈ B, ∃ y ∈ B, x ≠ y) : t • B = B :=
  isBlock_smul_eq_of_eq_one_or_isSwap hB (t := ⟨t, htG⟩) ht hB2

end GaloisForLFunctions.HTGeometry
