import Mathlib

/-!
# Transcendence degree of a one-variable extension

A field extension generated by one transcendental element, up to algebraic extension, has
transcendence degree one: the singleton is algebraically independent, so the degree is at least one,
and the extension is algebraic over the singleton, so the degree is at most one.

In a tower this makes adjoining a transcendental element raise the transcendence degree by exactly
one, while an algebraic extension leaves it unchanged.  These are the two bookkeeping facts a
period-completion dichotomy needs: adjoining a transcendental period adds a transcendence direction,
adjoining an algebraic one does not.
-/

open Algebra Cardinal

namespace GaloisForLFunctions.HTGeometry

universe u

/-- **A one-variable extension has transcendence degree one.**  The singleton `{τ}` is algebraically
independent and the extension is algebraic over it. -/
theorem trdeg_eq_one_of_transcendental {K L : Type u} [Field K] [Field L] [Algebra K L]
    (τ : L) (hτ : Transcendental K τ)
    [Algebra.IsAlgebraic (Algebra.adjoin K ({τ} : Set L)) L] :
    Algebra.trdeg K L = 1 := by
  refine le_antisymm ?_ ?_
  · have h := Algebra.IsAlgebraic.trdeg_le_cardinalMk K ({τ} : Set L)
    simpa using h
  · have hind : AlgebraicIndependent K (fun _ : PUnit.{u + 1} => τ) :=
      algebraicIndependent_unique_type_iff.mpr hτ
    have h := hind.cardinalMk_le_trdeg
    simpa using h

/-- **Adjoining a transcendental element raises the degree by one.** -/
theorem trdeg_eq_add_one_of_transcendental {A K L : Type u} [Field A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (τ : L) (hτ : Transcendental K τ)
    [Algebra.IsAlgebraic (Algebra.adjoin K ({τ} : Set L)) L] :
    Algebra.trdeg A L = Algebra.trdeg A K + 1 := by
  rw [← _root_.trdeg_add_eq A K (A := L), trdeg_eq_one_of_transcendental τ hτ]

/-- **An algebraic extension leaves the degree unchanged.** -/
theorem trdeg_eq_of_isAlgebraic {A K L : Type u} [Field A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [Algebra.IsAlgebraic K L] :
    Algebra.trdeg A L = Algebra.trdeg A K := by
  rw [← _root_.trdeg_add_eq A K (A := L), _root_.trdeg_eq_zero (R := K) (A := L), add_zero]

/-- **The transcendental-period case reaches degree two.**  Over a base of degree one, adjoining a
transcendental period gives degree two. -/
theorem trdeg_eq_two_of_transcendental {A K L : Type u} [Field A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (hK : Algebra.trdeg A K = 1) (τ : L) (hτ : Transcendental K τ)
    [Algebra.IsAlgebraic (Algebra.adjoin K ({τ} : Set L)) L] :
    Algebra.trdeg A L = 2 := by
  rw [trdeg_eq_add_one_of_transcendental τ hτ, hK]
  norm_num

/-- **The algebraic-period case stays at degree one.** -/
theorem trdeg_eq_one_of_isAlgebraic {A K L : Type u} [Field A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (hK : Algebra.trdeg A K = 1) [Algebra.IsAlgebraic K L] :
    Algebra.trdeg A L = 1 := by
  rw [trdeg_eq_of_isAlgebraic (A := A) (K := K) (L := L), hK]

/-- **Degree one is forced below degree two by one transcendental element.**  A field with a
transcendental element and transcendence degree below two has degree exactly one. -/
theorem trdeg_eq_one_of_lt_two_of_transcendental {A K : Type u} [Field A] [Field K] [Algebra A K]
    {τ : K} (hτ : Transcendental A τ) (hlt : Algebra.trdeg A K < 2) :
    Algebra.trdeg A K = 1 := by
  have hone : 1 ≤ Algebra.trdeg A K := by
    have hind : AlgebraicIndependent A (fun _ : PUnit.{u + 1} => τ) :=
      algebraicIndependent_unique_type_iff.mpr hτ
    have h := hind.cardinalMk_le_trdeg
    simpa using h
  have hle : Algebra.trdeg A K ≤ 1 := by
    by_contra hc
    exact absurd (Cardinal.two_le_iff_one_lt.mpr (not_le.mp hc)) (not_le.mpr hlt)
  exact le_antisymm hle hone

end GaloisForLFunctions.HTGeometry
