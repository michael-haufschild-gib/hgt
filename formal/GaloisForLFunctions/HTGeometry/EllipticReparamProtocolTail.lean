import GaloisForLFunctions.HTGeometry.EllipticIsogenyTailPlane
import GaloisForLFunctions.HTGeometry.ReparametrizationDescent

/-!
# The phase tail of an elliptic protocol on the differential-generic carrier

On the generic reparametrisation of the meromorphic plane field, the deck translations of an
elliptic isogeny protocol act by `fieldEquiv`, fixing every jet.  An element invariant at every
depth therefore has jet coordinates only: its numerator and denominator have constant coefficients.

This is the position–velocity splitting of the elliptic column in its expanding branch: nothing of
the position survives, and what is left is generated by the Maurer–Cartan velocity, the first jet of
the reparametrisation.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

/-- Translation of the variable preserves the derivation of the meromorphic plane field. -/
theorem planeTranslateEquiv_deriv (t : ℂ) (a : MeromorphicPlane) :
    planeTranslateEquiv t (Differential.deriv a)
      = Differential.deriv (planeTranslateEquiv t a) := by
  simpa using planeTranslate_deriv t a

/-- **The phase tail of an elliptic protocol on the generic reparametrisation.**  Invariance under
every deck translation of every depth forces the numerator and denominator to have constant
coefficients: only the jets of the reparametrisation survive. -/
theorem exists_const_coeff_representation_of_forall_deck_fixed (L : PeriodPair) (M : ℕ → ℂ)
    (hM : ∀ n, M n ≠ 0) (hMinf : Tendsto (fun n => ‖M n‖) atTop atTop)
    (x : ReparamField MeromorphicPlane)
    (hx : ∀ n : ℕ, ∀ t : ℂ, M n * t ∈ L.lattice →
      ReparamField.fieldEquiv (planeTranslateEquiv t) x = x) :
    ∃ p q : ReparamPoly MeromorphicPlane, q ≠ 0 ∧
      (∀ mm, MvPolynomial.coeff mm p ∈ constPlane.fieldRange) ∧
      (∀ mm, MvPolynomial.coeff mm q ∈ constPlane.fieldRange) ∧
      algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) q * x
        = algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) p := by
  classical
  set G : Set (MeromorphicPlane ≃+* MeromorphicPlane) :=
    {e | ∃ t : ℂ, (∃ n : ℕ, M n * t ∈ L.lattice) ∧ e = planeTranslateEquiv t} with hG
  have hxG : ∀ e ∈ G, ReparamField.fieldEquiv e x = x := by
    rintro e ⟨t, ⟨n, hn⟩, rfl⟩
    exact hx n t hn
  have hS : ∀ a : MeromorphicPlane, (∀ e ∈ G, e a = a) → a ∈ constPlane.fieldRange := by
    intro a ha
    obtain ⟨hpne, hp0⟩ := tendsto_lattice_division_points L M hM hMinf
    have hfix : ∀ n : ℕ, planeTranslate (L.ω₁ / M n) a = a := by
      intro n
      have hmem : planeTranslateEquiv (L.ω₁ / M n) ∈ G := by
        refine ⟨L.ω₁ / M n, ⟨n, ?_⟩, rfl⟩
        rw [mul_comm, div_mul_cancel₀ _ (hM n)]
        exact L.ω₁_mem_lattice
      simpa using ha _ hmem
    obtain ⟨c, hc⟩ := eq_const_of_small_periods _ hpne hp0 hfix
    exact ⟨c, hc.symm⟩
  exact ReparamField.exists_representation_coeff_mem G constPlane.fieldRange hS x hxG

end GaloisForLFunctions.HTGeometry
