import GaloisForLFunctions.HTGeometry.HilbertSchmidtOperatorBound
import Mathlib.Topology.MetricSpace.CoveringNumbers
import Mathlib.Topology.MetricSpace.HausdorffDistance

/-!
# Finite-horizon stability of an observer's temporal profile

A finite family of weighted reporters, evolved by a Hamiltonian, traces an orbit in the weighted
Hilbert–Schmidt space of reporter tuples.  Two Hamiltonians at operator-norm distance `δ` produce
orbits which stay within `2|t| δ` times the reporter scale at every time, so their finite-horizon
orbit segments are within that Hausdorff distance, their covering numbers are sandwiched with a
resolution shift, and their return sets are sandwiched with a radius shift.

The information profile of an observer is therefore Lipschitz stable at finite horizon: an
arbitrarily small perturbation cannot change what is distinguishable at resolution `ε` before a
time of order `ε / δ`.
-/

open scoped Matrix Matrix.Norms.L2Operator NNReal ENNReal

namespace GaloisForLFunctions.HTGeometry

noncomputable section

section Covering

variable {X : Type*} [PseudoMetricSpace X] {ε r : ℝ≥0} {s t C : Set X}

/-- A cover transfers to a set whose points are close to the covered one, with the radius shifted
by the closeness. -/
theorem isCover_of_forall_exists_dist_le (hC : Metric.IsCover ε s C)
    (hclose : ∀ y ∈ t, ∃ x ∈ s, dist y x ≤ (r : ℝ)) : Metric.IsCover (ε + r) t C := by
  intro y hy
  obtain ⟨x, hx, hyx⟩ := hclose y hy
  obtain ⟨c, hc, hxc⟩ := hC hx
  refine ⟨c, hc, ?_⟩
  have hyx' : edist y x ≤ (r : ℝ≥0∞) := by
    rw [edist_dist]
    exact ENNReal.ofReal_le_of_le_toReal (by simpa using hyx)
  have htri : edist y c ≤ edist y x + edist x c := edist_triangle y x c
  refine le_trans htri ?_
  rw [ENNReal.coe_add, add_comm (ε : ℝ≥0∞) (r : ℝ≥0∞)]
  exact add_le_add hyx' hxc

/-- **Covering comparison.**  If every point of one set is within `r` of the other set, its covering
number at radius `ε + r` is at most the covering number of the other at radius `ε`. -/
theorem externalCoveringNumber_le_of_forall_exists_dist_le
    (hclose : ∀ y ∈ t, ∃ x ∈ s, dist y x ≤ (r : ℝ)) :
    Metric.externalCoveringNumber (ε + r) t ≤ Metric.externalCoveringNumber ε s := by
  refine le_iInf₂ fun C hC => ?_
  exact iInf₂_le_of_le C (isCover_of_forall_exists_dist_le hC hclose) le_rfl

end Covering

variable {d : Type*} [Fintype d] [DecidableEq d] [Nonempty d] {N : ℕ}

/-- The matrix algebra is a C⋆-algebra for the operator norm. -/
local instance instCStarAlgebraMatrixProfile : CStarAlgebra (Matrix d d ℂ) where

/-- The unitary evolution generated by a self-adjoint Hamiltonian. -/
def unitaryEvolution (H : Matrix d d ℂ) (t : ℝ) : Matrix d d ℂ :=
  NormedSpace.exp (t • ((-Complex.I) • H))

omit [Nonempty d] in
theorem unitaryEvolution_mem_unitary {H : Matrix d d ℂ} (hH : IsSelfAdjoint H) (t : ℝ) :
    unitaryEvolution H t ∈ unitary (Matrix d d ℂ) := by
  letI : NormedAlgebra ℚ (Matrix d d ℂ) := NormedAlgebra.restrictScalars ℚ ℂ (Matrix d d ℂ)
  have hbase : (-Complex.I) • H ∈ skewAdjoint (Matrix d d ℂ) := by
    rw [skewAdjoint.mem_iff, star_smul, hH.star_eq]
    simp
  exact NormedSpace.exp_mem_unitary_of_mem_skewAdjoint (skewAdjoint.smul_mem t hbase)

omit [Nonempty d] in
theorem norm_unitaryEvolution_sub_le (H K : Matrix d d ℂ) (hH : IsSelfAdjoint H)
    (hK : IsSelfAdjoint K) (t : ℝ) :
    ‖unitaryEvolution H t - unitaryEvolution K t‖ ≤ |t| * ‖H - K‖ :=
  selfAdjoint_unitaryEvolution_norm_sub_le (A := Matrix d d ℂ) H K hH hK t

/-- The weighted reporter tuple observed at time `t`. -/
def observedOrbit (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) (H : Matrix d d ℂ) (t : ℝ) :
    EuclideanSpace ℂ (Fin N × d × d) :=
  (EuclideanSpace.equiv _ ℂ).symm fun p =>
    (Real.sqrt (lam p.1) : ℂ) *
      (unitaryEvolution H t * B p.1 * star (unitaryEvolution H t)) p.2.1 p.2.2

/-- The reporter scale of a weighted family. -/
def reporterScale (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) : ℝ :=
  Real.sqrt (∑ a, lam a * hsNorm (B a) ^ 2)

omit [DecidableEq d] [Nonempty d] in
theorem reporterScale_nonneg (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) :
    0 ≤ reporterScale lam B := Real.sqrt_nonneg _

omit [DecidableEq d] [Nonempty d] in
theorem reporterScale_sq (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a) (B : Fin N → Matrix d d ℂ) :
    reporterScale lam B ^ 2 = ∑ a, lam a * hsNorm (B a) ^ 2 := by
  refine Real.sq_sqrt (Finset.sum_nonneg fun a _ => ?_)
  exact mul_nonneg (hlam a) (by positivity)

/-- **Pointwise perturbation bound.**  At every time the two observed orbits differ by at most
twice the elapsed time times the generator distance times the reporter scale. -/
theorem dist_observedOrbit_le (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a)
    (B : Fin N → Matrix d d ℂ) {H K : Matrix d d ℂ} (hH : IsSelfAdjoint H)
    (hK : IsSelfAdjoint K) (t : ℝ) :
    dist (observedOrbit lam B H t) (observedOrbit lam B K t)
      ≤ 2 * (|t| * ‖H - K‖) * reporterScale lam B := by
  have hU := unitaryEvolution_mem_unitary hH t
  have hV := unitaryEvolution_mem_unitary hK t
  set U := unitaryEvolution H t
  set V := unitaryEvolution K t
  set Δ := ‖U - V‖ with hΔ
  have hΔnonneg : 0 ≤ Δ := norm_nonneg _
  have hentry : ∀ a, hsNorm (U * B a * star U - V * B a * star V) ≤ 2 * Δ * hsNorm (B a) :=
    fun a => hsNorm_conjugation_sub_le hU hV (B a)
  have hsq : dist (observedOrbit lam B H t) (observedOrbit lam B K t) ^ 2
      ≤ (2 * Δ * reporterScale lam B) ^ 2 := by
    rw [dist_eq_norm]
    have hvec : observedOrbit lam B H t - observedOrbit lam B K t
        = (EuclideanSpace.equiv _ ℂ).symm fun p =>
            (Real.sqrt (lam p.1) : ℂ) *
              ((U * B p.1 * star U - V * B p.1 * star V) p.2.1 p.2.2) := by
      rw [observedOrbit, observedOrbit, ← map_sub]
      congr 1
      funext p
      show (Real.sqrt (lam p.1) : ℂ) * (U * B p.1 * star U) p.2.1 p.2.2
          - (Real.sqrt (lam p.1) : ℂ) * (V * B p.1 * star V) p.2.1 p.2.2 = _
      rw [Matrix.sub_apply]
      ring
    rw [hvec, norm_sq_euclideanOfFun, Fintype.sum_prod_type]
    have hrow : ∀ a : Fin N,
        (∑ q : d × d, ‖(Real.sqrt (lam a) : ℂ) *
            ((U * B a * star U - V * B a * star V) q.1 q.2)‖ ^ 2)
          = lam a * hsNorm (U * B a * star U - V * B a * star V) ^ 2 := by
      intro a
      rw [hsNorm_sq, Fintype.sum_prod_type, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt (hlam a)]
    rw [Finset.sum_congr rfl fun a (_ : a ∈ Finset.univ) => hrow a]
    have hle : ∀ a : Fin N, lam a * hsNorm (U * B a * star U - V * B a * star V) ^ 2
        ≤ (2 * Δ) ^ 2 * (lam a * hsNorm (B a) ^ 2) := by
      intro a
      have h1 : hsNorm (U * B a * star U - V * B a * star V) ^ 2
          ≤ (2 * Δ * hsNorm (B a)) ^ 2 :=
        pow_le_pow_left₀ (hsNorm_nonneg _) (hentry a) 2
      have h2 : (2 * Δ * hsNorm (B a)) ^ 2 = (2 * Δ) ^ 2 * hsNorm (B a) ^ 2 := by ring
      calc lam a * hsNorm (U * B a * star U - V * B a * star V) ^ 2
          ≤ lam a * ((2 * Δ) ^ 2 * hsNorm (B a) ^ 2) := by
            rw [← h2]
            exact mul_le_mul_of_nonneg_left h1 (hlam a)
        _ = (2 * Δ) ^ 2 * (lam a * hsNorm (B a) ^ 2) := by ring
    calc (∑ a, lam a * hsNorm (U * B a * star U - V * B a * star V) ^ 2)
        ≤ ∑ a, (2 * Δ) ^ 2 * (lam a * hsNorm (B a) ^ 2) := Finset.sum_le_sum fun a _ => hle a
      _ = (2 * Δ) ^ 2 * reporterScale lam B ^ 2 := by
          rw [← Finset.mul_sum, reporterScale_sq lam hlam B]
      _ = (2 * Δ * reporterScale lam B) ^ 2 := by ring
  have hsqrt := Real.sqrt_le_sqrt hsq
  rw [Real.sqrt_sq dist_nonneg,
    Real.sqrt_sq (mul_nonneg (by positivity) (reporterScale_nonneg lam B) :
      (0:ℝ) ≤ 2 * Δ * reporterScale lam B)] at hsqrt
  refine le_trans hsqrt ?_
  have hstep : Δ ≤ |t| * ‖H - K‖ := norm_unitaryEvolution_sub_le H K hH hK t
  have hscale := reporterScale_nonneg lam B
  nlinarith [hscale, hstep, hΔnonneg]

/-- The finite-horizon observed orbit segment. -/
def orbitSegment (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) (H : Matrix d d ℂ) (T : ℝ) :
    Set (EuclideanSpace ℂ (Fin N × d × d)) :=
  observedOrbit lam B H '' Set.Icc (-T) T

/-- **Theorem A, Hausdorff form.**  The finite-horizon orbit segments of two Hamiltonians are
within `2 T δ` times the reporter scale in Hausdorff distance. -/
theorem hausdorffDist_orbitSegment_le (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a)
    (B : Fin N → Matrix d d ℂ) {H K : Matrix d d ℂ} (hH : IsSelfAdjoint H)
    (hK : IsSelfAdjoint K) {T : ℝ} (hT : 0 ≤ T) :
    Metric.hausdorffDist (orbitSegment lam B H T) (orbitSegment lam B K T)
      ≤ 2 * (T * ‖H - K‖) * reporterScale lam B := by
  have hr : (0 : ℝ) ≤ 2 * (T * ‖H - K‖) * reporterScale lam B :=
    mul_nonneg (mul_nonneg (by norm_num) (mul_nonneg hT (norm_nonneg _)))
      (reporterScale_nonneg lam B)
  refine Metric.hausdorffDist_le_of_mem_dist hr ?_ ?_
  · rintro _ ⟨t, ht, rfl⟩
    refine ⟨observedOrbit lam B K t, ⟨t, ht, rfl⟩, ?_⟩
    refine le_trans (dist_observedOrbit_le lam hlam B hH hK t) ?_
    have habs : |t| ≤ T := abs_le.mpr ⟨ht.1, ht.2⟩
    have h1 : (0:ℝ) ≤ ‖H - K‖ := norm_nonneg _
    have h2 := reporterScale_nonneg lam B
    have hstep : |t| * ‖H - K‖ ≤ T * ‖H - K‖ := mul_le_mul_of_nonneg_right habs h1
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hstep (by norm_num : (0:ℝ) ≤ 2)) h2
  · rintro _ ⟨t, ht, rfl⟩
    refine ⟨observedOrbit lam B H t, ⟨t, ht, rfl⟩, ?_⟩
    rw [dist_comm]
    refine le_trans (dist_observedOrbit_le lam hlam B hH hK t) ?_
    have habs : |t| ≤ T := abs_le.mpr ⟨ht.1, ht.2⟩
    have h1 : (0:ℝ) ≤ ‖H - K‖ := norm_nonneg _
    have h2 := reporterScale_nonneg lam B
    have hstep : |t| * ‖H - K‖ ≤ T * ‖H - K‖ := mul_le_mul_of_nonneg_right habs h1
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hstep (by norm_num : (0:ℝ) ≤ 2)) h2

/-- **Theorem A, covering form.**  Shifting the resolution by the perturbation radius sandwiches
the covering numbers of the two finite-horizon profiles. -/
theorem externalCoveringNumber_orbitSegment_le (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a)
    (B : Fin N → Matrix d d ℂ) {H K : Matrix d d ℂ} (hH : IsSelfAdjoint H)
    (hK : IsSelfAdjoint K) {T : ℝ} (ε r : ℝ≥0)
    (hrad : 2 * (T * ‖H - K‖) * reporterScale lam B ≤ (r : ℝ)) :
    Metric.externalCoveringNumber (ε + r) (orbitSegment lam B K T)
      ≤ Metric.externalCoveringNumber ε (orbitSegment lam B H T) := by
  refine externalCoveringNumber_le_of_forall_exists_dist_le ?_
  rintro _ ⟨t, ht, rfl⟩
  refine ⟨observedOrbit lam B H t, ⟨t, ht, rfl⟩, ?_⟩
  rw [dist_comm]
  refine le_trans (dist_observedOrbit_le lam hlam B hH hK t) (le_trans ?_ hrad)
  have habs : |t| ≤ T := abs_le.mpr ⟨ht.1, ht.2⟩
  have h1 : (0:ℝ) ≤ ‖H - K‖ := norm_nonneg _
  have h2 := reporterScale_nonneg lam B
  have hstep : |t| * ‖H - K‖ ≤ T * ‖H - K‖ := mul_le_mul_of_nonneg_right habs h1
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hstep (by norm_num : (0:ℝ) ≤ 2)) h2

/-- The root displacement of the observed orbit. -/
def rootDisplacement (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) (H : Matrix d d ℂ) (t : ℝ) :
    ℝ := dist (observedOrbit lam B H t) (observedOrbit lam B H 0)

/-- **Corollary A, displacement form.**  The root displacements of two Hamiltonians differ by at
most twice the elapsed time times the generator distance times the reporter scale. -/
theorem abs_rootDisplacement_sub_le (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a)
    (B : Fin N → Matrix d d ℂ) {H K : Matrix d d ℂ} (hH : IsSelfAdjoint H)
    (hK : IsSelfAdjoint K) (t : ℝ) :
    |rootDisplacement lam B H t - rootDisplacement lam B K t|
      ≤ 2 * (|t| * ‖H - K‖) * reporterScale lam B := by
  have hzero : observedOrbit lam B H 0 = observedOrbit lam B K 0 := by
    have h0 : unitaryEvolution H 0 = unitaryEvolution K 0 := by
      show NormedSpace.exp ((0 : ℝ) • ((-Complex.I) • H))
        = NormedSpace.exp ((0 : ℝ) • ((-Complex.I) • K))
      rw [zero_smul, zero_smul]
    show (EuclideanSpace.equiv _ ℂ).symm _ = (EuclideanSpace.equiv _ ℂ).symm _
    rw [h0]
  have htri : |dist (observedOrbit lam B H t) (observedOrbit lam B H 0)
      - dist (observedOrbit lam B K t) (observedOrbit lam B K 0)|
      ≤ dist (observedOrbit lam B H t) (observedOrbit lam B K t) := by
    rw [hzero]
    exact abs_dist_sub_le _ _ _
  exact le_trans htri (dist_observedOrbit_le lam hlam B hH hK t)

/-- The finite-window return set of the observed orbit. -/
def returnSet (lam : Fin N → ℝ) (B : Fin N → Matrix d d ℂ) (H : Matrix d d ℂ) (T ε : ℝ) :
    Set ℝ := {t ∈ Set.Icc (-T) T | rootDisplacement lam B H t < ε}

/-- **Corollary A, return-set sandwich.**  Shrinking the return radius by the perturbation radius
embeds one return set in the other. -/
theorem returnSet_subset (lam : Fin N → ℝ) (hlam : ∀ a, 0 ≤ lam a) (B : Fin N → Matrix d d ℂ)
    {H K : Matrix d d ℂ} (hH : IsSelfAdjoint H) (hK : IsSelfAdjoint K) {T ε r : ℝ}
    (hrad : 2 * (T * ‖H - K‖) * reporterScale lam B ≤ r) :
    returnSet lam B K T (ε - r) ⊆ returnSet lam B H T ε := by
  rintro t ⟨ht, hlt⟩
  refine ⟨ht, ?_⟩
  have hbound := abs_rootDisplacement_sub_le lam hlam B hH hK t
  have habs : |t| ≤ T := abs_le.mpr ⟨ht.1, ht.2⟩
  have h1 : (0:ℝ) ≤ ‖H - K‖ := norm_nonneg _
  have h2 := reporterScale_nonneg lam B
  have hstep : 2 * (|t| * ‖H - K‖) * reporterScale lam B ≤ r := by
    refine le_trans ?_ hrad
    have hmul : |t| * ‖H - K‖ ≤ T * ‖H - K‖ := mul_le_mul_of_nonneg_right habs h1
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hmul (by norm_num : (0:ℝ) ≤ 2)) h2
  have hdiff : rootDisplacement lam B H t - rootDisplacement lam B K t ≤ r :=
    le_trans (le_abs_self _) (le_trans hbound hstep)
  linarith

end

end GaloisForLFunctions.HTGeometry
