import GaloisForLFunctions.HTGeometry.NumberFieldIdealClassRepresentatives
import GaloisForLFunctions.HTGeometry.FractionalIdealPrincipalMul

/-!
# Rank-two Steinitz normalization over a number ring

The two coordinates of a nonzero number-field vector generate a nonzero fractional ideal.  Its
ideal class selects one member of the fixed finite representative family, and the class normalizer
identifies the coordinate ideal with a principal scalar multiple of that representative.  This is
the exact projective-class reduction needed before applying a uniform Minkowski bound to an
adjacent two-coordinate frame.
-/

namespace GaloisForLFunctions.HTGeometry

open NumberField
open scoped Classical NumberField

noncomputable section

variable (K : Type*) [Field K] [NumberField K]

/-- Fractional ideal generated by the two coordinates of a vector. -/
def numberFieldRankTwoCoordinateIdeal (v : Fin 2 → K) :
    FractionalIdeal (nonZeroDivisors (𝓞 K)) K :=
  FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ⊔
    FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1)

/-- A nonzero rank-two vector generates a nonzero fractional ideal. -/
theorem numberFieldRankTwoCoordinateIdeal_ne_zero
    {v : Fin 2 → K} (hv : v ≠ 0) :
    numberFieldRankTwoCoordinateIdeal K v ≠ 0 := by
  intro hzero
  have h0mem : v 0 ∈ numberFieldRankTwoCoordinateIdeal K v := by
    have hx : v 0 ∈ FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) := by
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨1, by simp⟩
    exact (le_sup_left :
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ≤
        FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ⊔
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1)) hx
  have h1mem : v 1 ∈ numberFieldRankTwoCoordinateIdeal K v := by
    have hx : v 1 ∈ FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1) := by
      rw [FractionalIdeal.mem_spanSingleton]
      exact ⟨1, by simp⟩
    exact (le_sup_right :
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1) ≤
        FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 0) ⊔
          FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) (v 1)) hx
  have h0 : v 0 = 0 := by simpa [hzero] using h0mem
  have h1 : v 1 = 0 := by simpa [hzero] using h1mem
  apply hv
  funext i
  fin_cases i <;> assumption

/-- Scaling both coordinates multiplies their coordinate ideal by the corresponding principal
fractional ideal. -/
theorem numberFieldRankTwoCoordinateIdeal_mul
    (c : K) (v : Fin 2 → K) :
    numberFieldRankTwoCoordinateIdeal K (fun i => c * v i) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) c *
        numberFieldRankTwoCoordinateIdeal K v := by
  rw [numberFieldRankTwoCoordinateIdeal, numberFieldRankTwoCoordinateIdeal, spanSingleton_mul_sup,
    spanSingleton_mul_spanSingleton, spanSingleton_mul_spanSingleton]

/-- Nonzero rank-two coordinate ideals, viewed as units in the group-with-zero of fractional
ideals. -/
def numberFieldRankTwoCoordinateIdealUnit (v : Fin 2 → K) (hv : v ≠ 0) :
    (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ :=
  Units.mk0 (numberFieldRankTwoCoordinateIdeal K v)
    (numberFieldRankTwoCoordinateIdeal_ne_zero K hv)

/-- **Rank-two Steinitz comparison.**  Coordinates of every nonzero vector generate a principal
scalar multiple of one member of the fixed finite family of ideal-class representatives. -/
theorem numberFieldRankTwoCoordinateIdeal_eq_normalizer_mul_classRepresentative
    (v : Fin 2 → K) (hv : v ≠ 0) :
    numberFieldRankTwoCoordinateIdeal K v =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K))
          (numberFieldIdealClassNormalizer K
            (numberFieldRankTwoCoordinateIdealUnit K v hv)) *
        (↑(numberFieldIdealClassRepresentative K
          (ClassGroup.mk K (numberFieldRankTwoCoordinateIdealUnit K v hv))) :
          FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
  simpa [numberFieldRankTwoCoordinateIdealUnit] using
    numberFieldIdeal_eq_spanSingleton_mul_classRepresentative K
      (numberFieldRankTwoCoordinateIdealUnit K v hv)

/-- Divide a nonzero rank-two vector by the principal scalar in its Steinitz normalization. -/
def numberFieldRankTwoNormalizedVector (v : Fin 2 → K) (hv : v ≠ 0) : Fin 2 → K :=
  fun i => (numberFieldIdealClassNormalizer K
    (numberFieldRankTwoCoordinateIdealUnit K v hv))⁻¹ * v i

/-- Multiplying the normalized vector by its class normalizer recovers the original vector. -/
theorem numberFieldRankTwo_normalizer_mul_normalizedVector
    (v : Fin 2 → K) (hv : v ≠ 0) (i : Fin 2) :
    numberFieldIdealClassNormalizer K
        (numberFieldRankTwoCoordinateIdealUnit K v hv) *
      numberFieldRankTwoNormalizedVector K v hv i = v i := by
  rw [numberFieldRankTwoNormalizedVector]
  field_simp [numberFieldIdealClassNormalizer_ne_zero]

/-- **Exact vector-level Steinitz normalization.**  The normalized coordinates generate the fixed
representative of the original coordinate ideal's class. -/
theorem numberFieldRankTwoNormalizedVector_coordinateIdeal
    (v : Fin 2 → K) (hv : v ≠ 0) :
    numberFieldRankTwoCoordinateIdeal K
        (numberFieldRankTwoNormalizedVector K v hv) =
      (↑(numberFieldIdealClassRepresentative K
        (ClassGroup.mk K (numberFieldRankTwoCoordinateIdealUnit K v hv))) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
  let c := numberFieldIdealClassNormalizer K
    (numberFieldRankTwoCoordinateIdealUnit K v hv)
  let J := (↑(numberFieldIdealClassRepresentative K
    (ClassGroup.mk K (numberFieldRankTwoCoordinateIdealUnit K v hv))) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K)
  have hc : c ≠ 0 := numberFieldIdealClassNormalizer_ne_zero K _
  have hscaled := numberFieldRankTwoCoordinateIdeal_mul K c
    (numberFieldRankTwoNormalizedVector K v hv)
  have hfun : (fun i => c * numberFieldRankTwoNormalizedVector K v hv i) = v := by
    funext i
    exact numberFieldRankTwo_normalizer_mul_normalizedVector K v hv i
  rw [hfun] at hscaled
  have hclass : numberFieldRankTwoCoordinateIdeal K v =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) c * J := by
    exact numberFieldRankTwoCoordinateIdeal_eq_normalizer_mul_classRepresentative K v hv
  have hmul : FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) c *
      numberFieldRankTwoCoordinateIdeal K
        (numberFieldRankTwoNormalizedVector K v hv) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) c * J :=
    hscaled.symm.trans hclass
  apply mul_left_cancel₀ _ hmul
  intro hzero
  have hmem : c ∈ FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) c := by
    rw [FractionalIdeal.mem_spanSingleton]
    exact ⟨1, by simp⟩
  rw [hzero] at hmem
  exact hc (by simpa using hmem)

end

end GaloisForLFunctions.HTGeometry
