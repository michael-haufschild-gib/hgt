import GaloisForLFunctions.HTGeometry.PairPeelInduction
import GaloisForLFunctions.HTGeometry.ProductLawTranscendence
import GaloisForLFunctions.HTGeometry.AffineTopGeneral

/-!
# The head product of the two-coordinate law

The head product at level `m` is the jet of that level times the head factor,

`K = (∏_(j<m) p_j(X_j, X_(j+1)))·g(X_m)`,

and its logarithmic gradient is exactly the border row the peel runs on: `∂_l K = K·headBorder_l`.
Its multiplier is the law's value on that row, so its jets are the head product times the affine
Bell values of the multiplier.

The subfield generated by the coordinates up to `m` is the corpus's low field, so the newest
coordinate is transcendental over it — the input the affine-top reduction needs.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

variable {p : ℕ → MvPolynomial (Fin 2) ℂ}

/-! ## The coordinate subfield is the corpus's low field -/

theorem coordField_eq_lowFld (m : ℕ) : coordField m = lowFld m := by
  have hset : (↑(Finset.range (m + 1)) : Set ℕ) = {j : ℕ | j ≤ m} := by
    ext j
    simp only [Finset.coe_range, Set.mem_Iio, Set.mem_setOf_eq]
    omega
  rw [coordField, freeCoordinateField, lowFld, hset]
  rfl

theorem transcendental_fx_over_coordField (m : ℕ) :
    Transcendental (coordField m) (fx (m + 1)) := by
  rw [coordField_eq_lowFld]
  exact transcendental_fx_over_lowFld m

theorem injective_aeval_fx_coordField (m : ℕ) :
    Function.Injective
      (Polynomial.aeval (fx (m + 1)) :
        Polynomial (coordField m).toSubalgebra →ₐ[(coordField m).toSubalgebra] CascadeField) :=
  transcendental_iff_injective.mp (transcendental_fx_over_coordField m)

/-! ## The head product -/

/-- The head product at level `m`: the jet of that level times the head factor. -/
noncomputable def pairHead (p : ℕ → MvPolynomial (Fin 2) ℂ) (g : Polynomial ℂ) (m : ℕ) :
    CascadeField :=
  pairJet p m * fact g m

theorem pairHead_ne_zero (hne : ∀ j, pairFactor (p j) j ≠ 0) {g : Polynomial ℂ} (hg : g ≠ 0)
    (m : ℕ) : pairHead p g m ≠ 0 :=
  mul_ne_zero (pairJet_ne_zero hne m) (fact_ne_zero hg m)

theorem pairHead_mem_coordField (g : Polynomial ℂ) (m : ℕ) : pairHead p g m ∈ coordField m :=
  mul_mem (pairJet_mem_coordField (le_refl m)) (fact_mem_coordField (le_refl m) g)

/-- **The gradient of the head product is the border row, scaled.** -/
theorem fpderiv_pairHead_eq (hne : ∀ j, pairFactor (p j) j ≠ 0) {g : Polynomial ℂ} (hg : g ≠ 0)
    (m l : ℕ) : fpderiv l (pairHead p g m) = pairHead p g m * headBorder p g m l := by
  have hG : fact g m ≠ 0 := fact_ne_zero hg m
  rw [pairHead, Derivation.leibniz, headBorder]
  simp only [smul_eq_mul]
  rw [show fpderiv l (pairJet p m) = pairResponse p l m from rfl,
    pairResponse_eq_pairLogBorder hne l m]
  field_simp
  ring

/-- **The head product's multiplier is the law's value on the border row.** -/
theorem pairDerivation_pairHead (hne : ∀ j, pairFactor (p j) j ≠ 0) {g : Polynomial ℂ}
    (hg : g ≠ 0) (m : ℕ) :
    pairDerivation p (pairHead p g m) = headSum p g m * pairHead p g m := by
  rw [pairDerivation_eq_sum_coordField (pairHead_mem_coordField g m), headSum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [fpderiv_pairHead_eq hne hg m l]
  ring

/-- **The jets of the head product are the product times the affine Bell values.** -/
theorem iterate_pairDerivation_pairHead (hne : ∀ j, pairFactor (p j) j ≠ 0) {g : Polynomial ℂ}
    (hg : g ≠ 0) (m i : ℕ) :
    ((pairDerivation p : CascadeField → CascadeField)^[i]) (pairHead p g m)
      = pairHead p g m * genJetA (pairDerivation p) (headSum p g m) i := by
  induction i with
  | zero => simp
  | succ i ih =>
      rw [Function.iterate_succ_apply', ih, Derivation.leibniz, genJetA_succ,
        pairDerivation_pairHead hne hg m]
      simp only [smul_eq_mul]
      ring

end GaloisForLFunctions.HTGeometry
