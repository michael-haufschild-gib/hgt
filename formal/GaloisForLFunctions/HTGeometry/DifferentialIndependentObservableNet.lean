import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.Analysis.Subadditive
import Mathlib.Tactic

/-!
# Faithful observable nets of differentially independent clocks

A single hypertranscendental element has a strictly growing field of finite jet observables.
This file extends that statement to an arbitrary differentially independent family.

For a resolution vector `N : ι → ℕ`, the visible field is generated by the jets

`δ^n(x i),  n < N i`.

Differential independence makes the resulting observable net faithful: inclusion of visible
fields is equivalent to coordinatewise comparison of the resolution vectors.  The derivation is
used only to label observations.  No temporal flow or state propagation is introduced.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The labelled jets exposed by a multi-clock resolution vector. -/
def differentialFamilyVisibleJetIndices {ι : Type*} (N : ι → ℕ) : Set (ι × ℕ) :=
  {p | p.2 < N p.1}

/-- The field of rational observables visible at a multi-clock resolution vector. -/
def differentialFamilyObservableField
    (F : Type*) {E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : ι → E) (N : ι → ℕ) : IntermediateField F E :=
  IntermediateField.adjoin F
    ((fun p : ι × ℕ => differentialJet p.2 (x p.1)) ''
      differentialFamilyVisibleJetIndices N)

/-- Coordinatewise refinement of a resolution vector enlarges the observable field. -/
theorem differentialFamilyObservableField_mono
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : ι → E) {M N : ι → ℕ} (hMN : M ≤ N) :
    differentialFamilyObservableField F x M ≤
      differentialFamilyObservableField F x N := by
  apply IntermediateField.adjoin.mono F
  apply Set.image_mono
  intro p hp
  exact lt_of_lt_of_le hp (hMN p.1)

/-- A labelled jet of a differentially independent family is visible exactly when its order lies
below the assigned coordinate resolution. -/
theorem differentialJet_mem_differentialFamilyObservableField_iff
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : ι → E} (hx : DifferentialIndependent F x)
    (N : ι → ℕ) (i : ι) (n : ℕ) :
    differentialJet n (x i) ∈ differentialFamilyObservableField F x N ↔
      n < N i := by
  constructor
  · intro hmem
    by_contra hnot
    have hj : AlgebraicIndependent F
        (fun p : ι × ℕ => differentialJet p.2 (x p.1)) := hx
    have htrans : Transcendental (differentialFamilyObservableField F x N)
        (differentialJet n (x i)) := by
      apply (IntermediateField.transcendental_adjoin_iff).2
      exact hj.transcendental_adjoin
        (s := differentialFamilyVisibleJetIndices N)
        (i := (i, n)) (by
          simpa only [differentialFamilyVisibleJetIndices, Set.mem_setOf_eq] using hnot)
    apply htrans
    have halg := isAlgebraic_algebraMap
      (R := differentialFamilyObservableField F x N) (A := E)
      (⟨differentialJet n (x i), hmem⟩ : differentialFamilyObservableField F x N)
    simpa using halg
  · intro hn
    apply IntermediateField.subset_adjoin F
    exact ⟨(i, n), hn, rfl⟩

/-- **Faithful multi-clock observable net.**  For a differentially independent family, inclusion
of finite jet-observable fields reconstructs the complete coordinatewise resolution order. -/
theorem differentialIndependent_familyObservableField_le_iff
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : ι → E} (hx : DifferentialIndependent F x) (M N : ι → ℕ) :
    differentialFamilyObservableField F x M ≤
        differentialFamilyObservableField F x N ↔
      M ≤ N := by
  constructor
  · intro hfield i
    by_contra hnot
    have hNM : N i < M i := Nat.lt_of_not_ge hnot
    have hvisible : differentialJet (N i) (x i) ∈
        differentialFamilyObservableField F x M :=
      (differentialJet_mem_differentialFamilyObservableField_iff hx M i (N i)).2 hNM
    have hhidden : differentialJet (N i) (x i) ∉
        differentialFamilyObservableField F x N := by
      intro hmem
      exact Nat.lt_irrefl (N i)
        ((differentialJet_mem_differentialFamilyObservableField_iff hx N i (N i)).1 hmem)
    exact hhidden (hfield hvisible)
  · exact differentialFamilyObservableField_mono x

/-- Two resolution vectors expose the same observable field exactly when they agree. -/
theorem differentialIndependent_familyObservableField_eq_iff
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : ι → E} (hx : DifferentialIndependent F x) (M N : ι → ℕ) :
    differentialFamilyObservableField F x M =
        differentialFamilyObservableField F x N ↔
      M = N := by
  constructor
  · intro hfield
    apply le_antisymm
    · exact (differentialIndependent_familyObservableField_le_iff hx M N).1
        (le_of_eq hfield)
    · exact (differentialIndependent_familyObservableField_le_iff hx N M).1
        (le_of_eq hfield.symm)
  · rintro rfl
    rfl

/-- The observable-field assignment of a differentially independent family, as an order
embedding of the complete multi-resolution poset. -/
def differentialIndependentObservableNetOrderEmbedding
    {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : ι → E) (hx : DifferentialIndependent F x) :
    (ι → ℕ) ↪o IntermediateField F E where
  toFun := differentialFamilyObservableField F x
  inj' := fun M N h =>
    (differentialIndependent_familyObservableField_eq_iff hx M N).1 h
  map_rel_iff' := by
    intro M N
    exact differentialIndependent_familyObservableField_le_iff hx M N

/-!
## Asymptotic clock translation length

Differential order on a group of reversible substitutions is a nonnegative subadditive cost:
composition can expose at most the sum of the two input jet orders.  The following abstract kernel
isolates the consequence needed by the differential-birational clock theory.  Fekete's lemma gives
an actual asymptotic speed, and bounded coordinate changes disappear after normalization.  Thus
the speed is invariant under differential-birational conjugacy once the concrete differential-order
cost has been supplied.
-/

/-- A nonnegative subadditive cost on a group of reversible clock changes. -/
structure SubadditiveClockGauge (G : Type*) [Group G] where
  cost : G → ℝ
  cost_nonneg : ∀ g, 0 ≤ cost g
  cost_one : cost 1 = 0
  cost_mul_le : ∀ g h, cost (g * h) ≤ cost g + cost h

namespace SubadditiveClockGauge

open Filter Topology

variable {G : Type*} [Group G] (W : SubadditiveClockGauge G)

/-- Cost of the `n`-fold reversible clock change. -/
def orbitCost (g : G) (n : ℕ) : ℝ := W.cost (g ^ n)

/-- Iterated clock cost is a subadditive sequence. -/
theorem orbitCost_subadditive (g : G) : Subadditive (W.orbitCost g) := by
  intro m n
  rw [orbitCost, orbitCost, orbitCost, pow_add]
  exact W.cost_mul_le _ _

theorem normalizedOrbitCost_bddBelow (g : G) :
    BddBelow (Set.range fun n ↦ W.orbitCost g n / n) := by
  refine ⟨0, ?_⟩
  rintro y ⟨n, rfl⟩
  exact div_nonneg (W.cost_nonneg _) (Nat.cast_nonneg n)

/-- The asymptotic clock translation length. -/
noncomputable def translationLength (g : G) : ℝ :=
  (W.orbitCost_subadditive g).lim

/-- Fekete's lemma: normalized clock cost has an actual limit, not merely a limsup. -/
theorem tendsto_normalizedOrbitCost (g : G) :
    Tendsto (fun n ↦ W.orbitCost g n / n) atTop
      (nhds (W.translationLength g)) := by
  exact (W.orbitCost_subadditive g).tendsto_lim
    (W.normalizedOrbitCost_bddBelow g)

/-- Conjugation is a change of reversible clock coordinates. -/
def conjugate (h g : G) : G := h * g * h⁻¹

@[simp] theorem conjugate_pow (h g : G) (n : ℕ) :
    (conjugate h g) ^ n = h * g ^ n * h⁻¹ := by
  induction n with
  | zero => simp [conjugate]
  | succ n ih =>
      rw [pow_succ, ih, pow_succ]
      simp [conjugate, mul_assoc]

/-- A coordinate change alters every finite iterate cost by at most a fixed additive amount. -/
theorem orbitCost_conjugate_le (h g : G) (n : ℕ) :
    W.orbitCost (conjugate h g) n ≤
      W.orbitCost g n + (W.cost h + W.cost h⁻¹) := by
  rw [orbitCost, conjugate_pow]
  calc
    W.cost (h * g ^ n * h⁻¹) ≤ W.cost (h * g ^ n) + W.cost h⁻¹ :=
      W.cost_mul_le _ _
    _ ≤ (W.cost h + W.cost (g ^ n)) + W.cost h⁻¹ := by
      linarith [W.cost_mul_le h (g ^ n)]
    _ = W.orbitCost g n + (W.cost h + W.cost h⁻¹) := by
      rw [orbitCost]
      ring

theorem orbitCost_le_conjugate (h g : G) (n : ℕ) :
    W.orbitCost g n ≤
      W.orbitCost (conjugate h g) n + (W.cost h + W.cost h⁻¹) := by
  have hconj : conjugate h⁻¹ (conjugate h g) = g := by
    simp [conjugate, mul_assoc]
  have hle := W.orbitCost_conjugate_le h⁻¹ (conjugate h g) n
  rw [hconj] at hle
  simpa [add_comm] using hle

/-- **Coordinate-invariant clock speed.**  Every fixed reversible change of differential
coordinates contributes only a bounded finite-order overhead, so it does not alter asymptotic
translation length. -/
theorem translationLength_conjugate (h g : G) :
    W.translationLength (conjugate h g) = W.translationLength g := by
  let B : ℝ := W.cost h + W.cost h⁻¹
  have hB : Tendsto (fun n : ℕ ↦ B / n) atTop (nhds 0) :=
    tendsto_const_div_atTop_nhds_zero_nat B
  have hg := W.tendsto_normalizedOrbitCost g
  have hlower : Tendsto
      (fun n : ℕ ↦ W.orbitCost g n / n - B / n) atTop
      (nhds (W.translationLength g)) := by
    simpa using hg.sub hB
  have hupper : Tendsto
      (fun n : ℕ ↦ W.orbitCost g n / n + B / n) atTop
      (nhds (W.translationLength g)) := by
    simpa using hg.add hB
  have hsandwich : Tendsto
      (fun n : ℕ ↦ W.orbitCost (conjugate h g) n / n) atTop
      (nhds (W.translationLength g)) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlower hupper
    · exact Eventually.of_forall fun n ↦ by
        apply (sub_le_iff_le_add).2
        rw [← add_div]
        exact div_le_div_of_nonneg_right (W.orbitCost_le_conjugate h g n)
          (Nat.cast_nonneg n)
    · exact Eventually.of_forall fun n ↦ by
        rw [← add_div]
        exact div_le_div_of_nonneg_right (W.orbitCost_conjugate_le h g n)
          (Nat.cast_nonneg n)
  exact tendsto_nhds_unique
    (W.tendsto_normalizedOrbitCost (conjugate h g)) hsandwich

/-!
## Incompressibility under bounded clock comparison

The Frechet matrix of a finite-rank differential embedding has a rational pseudodifferential
right inverse.  The concrete consequence is a pair of uniform finite-order inequalities between
the intrinsic and ambient clock gauges.  The following abstract kernel isolates the asymptotic
content: any fixed encoding and decoding overhead disappears after normalization.
-/

/-- Two clock gauges differ by fixed coordinate-encoding and coordinate-decoding overheads. -/
structure BoundedComparison (W₁ W₂ : SubadditiveClockGauge G) where
  forwardOverhead : ℝ
  backwardOverhead : ℝ
  cost_le_forward : ∀ g, W₁.cost g ≤ W₂.cost g + forwardOverhead
  cost_le_backward : ∀ g, W₂.cost g ≤ W₁.cost g + backwardOverhead

/-- **Clock incompressibility kernel.**  Fixed two-sided finite-order overhead cannot change
asymptotic clock speed.  A differential embedding supplies such overheads from its Frechet matrix
and a pseudodifferential right inverse. -/
theorem BoundedComparison.translationLength_eq
    {W₁ W₂ : SubadditiveClockGauge G}
    (C : BoundedComparison W₁ W₂) (g : G) :
    W₁.translationLength g = W₂.translationLength g := by
  have hfzero : Tendsto (fun n : ℕ ↦ C.forwardOverhead / n) atTop (nhds 0) :=
    tendsto_const_div_atTop_nhds_zero_nat C.forwardOverhead
  have hbzero : Tendsto (fun n : ℕ ↦ C.backwardOverhead / n) atTop (nhds 0) :=
    tendsto_const_div_atTop_nhds_zero_nat C.backwardOverhead
  have htwo := W₂.tendsto_normalizedOrbitCost g
  have hlower : Tendsto
      (fun n : ℕ ↦ W₂.orbitCost g n / n - C.backwardOverhead / n) atTop
      (nhds (W₂.translationLength g)) := by
    simpa using htwo.sub hbzero
  have hupper : Tendsto
      (fun n : ℕ ↦ W₂.orbitCost g n / n + C.forwardOverhead / n) atTop
      (nhds (W₂.translationLength g)) := by
    simpa using htwo.add hfzero
  have hsandwich : Tendsto
      (fun n : ℕ ↦ W₁.orbitCost g n / n) atTop
      (nhds (W₂.translationLength g)) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlower hupper
    · exact Eventually.of_forall fun n ↦ by
        apply (sub_le_iff_le_add).2
        rw [← add_div]
        exact div_le_div_of_nonneg_right (C.cost_le_backward (g ^ n))
          (Nat.cast_nonneg n)
    · exact Eventually.of_forall fun n ↦ by
        rw [← add_div]
        exact div_le_div_of_nonneg_right (C.cost_le_forward (g ^ n))
          (Nat.cast_nonneg n)
  exact tendsto_nhds_unique (W₁.tendsto_normalizedOrbitCost g) hsandwich

end SubadditiveClockGauge

open Filter Topology

/-!
## Bounded comparison of finite clock vectors

The vector refinement uses fundamental-weight coordinates, which for a dominant finite vector are
its prefix sums.  A fixed bound on every prefix difference gives a fixed bound on every coordinate
difference, so normalization by the iterate number erases the discrepancy.  This is the finite
asymptotic-cone step after the valuation-lattice comparison has supplied the prefix bounds.
-/

/-- Sum of the coordinates whose index is strictly below `k`. -/
def finiteVectorPrefixSum {s : ℕ} (v : Fin s → ℝ) (k : ℕ) : ℝ :=
  ∑ j ∈ Finset.univ.filter (fun j : Fin s => (j : ℕ) < k), v j

theorem finiteVectorPrefixSum_succ {s : ℕ} (v : Fin s → ℝ) (i : Fin s) :
    finiteVectorPrefixSum v (i + 1) = finiteVectorPrefixSum v i + v i := by
  classical
  rw [finiteVectorPrefixSum, finiteVectorPrefixSum]
  have hi : i ∉ Finset.univ.filter (fun j : Fin s => (j : ℕ) < (i : ℕ)) := by simp
  rw [show Finset.univ.filter (fun j : Fin s => (j : ℕ) < (i : ℕ) + 1) =
      insert i (Finset.univ.filter (fun j : Fin s => (j : ℕ) < (i : ℕ))) by
        ext j
        simp
        omega]
  rw [Finset.sum_insert hi]
  abel

/-- Bounded differences of every prefix sum bound each coordinate difference. -/
theorem finiteVector_coordinate_sub_le_of_prefix_bound {s : ℕ}
    (μ ν : Fin s → ℝ) (K : ℕ → ℝ)
    (h : ∀ k, |finiteVectorPrefixSum μ k - finiteVectorPrefixSum ν k| ≤ K k)
    (i : Fin s) :
    |μ i - ν i| ≤ K (i + 1) + K i := by
  have hμ := finiteVectorPrefixSum_succ μ i
  have hν := finiteVectorPrefixSum_succ ν i
  calc
    |μ i - ν i| =
        |(finiteVectorPrefixSum μ (i + 1) - finiteVectorPrefixSum ν (i + 1)) -
          (finiteVectorPrefixSum μ i - finiteVectorPrefixSum ν i)| := by
      rw [hμ, hν]
      congr 1
      ring
    _ ≤ |finiteVectorPrefixSum μ (i + 1) - finiteVectorPrefixSum ν (i + 1)| +
        |finiteVectorPrefixSum μ i - finiteVectorPrefixSum ν i| := abs_sub _ _
    _ ≤ K (i + 1) + K i := add_le_add (h (i + 1)) (h i)

/-- **Finite Cartan-vector comparison.**  Uniform bounds on all fundamental-weight coordinates
(prefix sums) force two normalized finite vectors to have the same limit. -/
theorem tendsto_normalized_finiteVector_of_bounded_prefix
    {s : ℕ} (μ ν : ℕ → Fin s → ℝ) (K : ℕ → ℝ) (L : Fin s → ℝ)
    (h : ∀ n k,
      |finiteVectorPrefixSum (μ n) k - finiteVectorPrefixSum (ν n) k| ≤ K k)
    (hμ : Tendsto (fun n i => μ n i / n) atTop (nhds L)) :
    Tendsto (fun n i => ν n i / n) atTop (nhds L) := by
  rw [tendsto_pi_nhds] at hμ ⊢
  intro i
  let C : ℝ := K (i + 1) + K i
  have hCzero : Tendsto (fun n : ℕ => C / n) atTop (nhds 0) :=
    tendsto_const_div_atTop_nhds_zero_nat C
  have hCneg : Tendsto (fun n : ℕ => -(C / n)) atTop (nhds 0) := by
    simpa using hCzero.neg
  have hdiff : Tendsto (fun n : ℕ => (ν n i - μ n i) / n) atTop (nhds 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hCneg hCzero
    · exact Eventually.of_forall fun n => by
        have hcoord := finiteVector_coordinate_sub_le_of_prefix_bound
          (μ n) (ν n) K (h n) i
        have habs : |ν n i - μ n i| ≤ C := by
          simpa [C, abs_sub_comm] using hcoord
        have hlower : -C ≤ ν n i - μ n i := (abs_le.mp habs).1
        simpa only [neg_div] using
          (div_le_div_of_nonneg_right hlower (Nat.cast_nonneg n))
    · exact Eventually.of_forall fun n => by
        have hcoord := finiteVector_coordinate_sub_le_of_prefix_bound
          (μ n) (ν n) K (h n) i
        have habs : |ν n i - μ n i| ≤ C := by
          simpa [C, abs_sub_comm] using hcoord
        exact div_le_div_of_nonneg_right (abs_le.mp habs).2 (Nat.cast_nonneg n)
  have hsum := (hμ i).add hdiff
  simpa [sub_div] using hsum

/-!
## A reversible rank-two clock shear

The scalar observable filtration does not exhibit reconstruction drift under a reversible
differential substitution.  The following rank-two shear is the first elementary counterpoint:
the substitution and its inverse are local, but the first coordinate of the `n`-fold inverse has
exact jet order `n`.  Differential independence turns this leading-order calculation into an exact
finite-observable field theorem.
-/

/-- Differentiating a multi-clock observable raises every coordinate resolution by at most one. -/
theorem differentialFamilyObservableField_deriv_mem_succ
    {F E ι : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : ι → E) (N : ι → ℕ) {z : E}
    (hz : z ∈ differentialFamilyObservableField F x N) :
    z′ ∈ differentialFamilyObservableField F x (fun i => N i + 1) := by
  have hmono : differentialFamilyObservableField F x N ≤
      differentialFamilyObservableField F x (fun i => N i + 1) :=
    differentialFamilyObservableField_mono x (fun _ => Nat.le_succ _)
  apply IntermediateField.adjoin_induction F
    (s := (fun p : ι × ℕ => differentialJet p.2 (x p.1)) ''
      differentialFamilyVisibleJetIndices N)
    (p := fun y _ => y′ ∈ differentialFamilyObservableField F x (fun i => N i + 1))
  · rintro y ⟨p, hp, rfl⟩
    change p.2 < N p.1 at hp
    rw [← differentialJet_succ]
    apply IntermediateField.subset_adjoin F
    exact ⟨(p.1, p.2 + 1), Nat.add_lt_add_right hp 1, rfl⟩
  · intro c
    rw [deriv_algebraMap]
    exact IntermediateField.algebraMap_mem _ _
  · intro a b ha hb hda hdb
    rw [map_add]
    exact IntermediateField.add_mem _ hda hdb
  · intro a ha hda
    rw [Derivation.leibniz_inv]
    have hainv : a⁻¹ ∈ differentialFamilyObservableField F x (fun i => N i + 1) :=
      IntermediateField.inv_mem _ (hmono ha)
    have hasq : a⁻¹ ^ (2 : ℕ) ∈ differentialFamilyObservableField F x (fun i => N i + 1) :=
      (differentialFamilyObservableField F x (fun i => N i + 1)).toSubfield.pow_mem hainv 2
    exact IntermediateField.mul_mem _ (IntermediateField.neg_mem _ hasq) hda
  · intro a b ha hb hda hdb
    rw [Derivation.leibniz]
    exact IntermediateField.add_mem _
      (IntermediateField.mul_mem _ (hmono ha) hdb)
      (IntermediateField.mul_mem _ (hmono hb) hda)
  exact hz

/-- The forward rank-two clock shear `(x,y) ↦ (y,x+Dy)`. -/
def clockShearForward {E : Type*} [Field E] [Differential E] (p : E × E) : E × E :=
  (p.2, p.1 + p.2′)

/-- The backward rank-two clock shear `(x,y) ↦ (-Dx+y,x)`. -/
def clockShearBackward {E : Type*} [Field E] [Differential E] (p : E × E) : E × E :=
  (-p.1′ + p.2, p.1)

/-- The forward clock shear followed by the backward shear is the identity. -/
@[simp] theorem clockShearForward_backward
    {E : Type*} [Field E] [Differential E] (p : E × E) :
    clockShearForward (clockShearBackward p) = p := by
  rcases p with ⟨x, y⟩
  simp [clockShearForward, clockShearBackward]

/-- The backward clock shear followed by the forward shear is the identity. -/
@[simp] theorem clockShearBackward_forward
    {E : Type*} [Field E] [Differential E] (p : E × E) :
    clockShearBackward (clockShearForward p) = p := by
  rcases p with ⟨x, y⟩
  simp [clockShearForward, clockShearBackward]

/-- The first coordinate after `n` backward clock-shear steps. -/
def clockShearBackwardFirst {E : Type*} [Field E] [Differential E]
    (x y : E) (n : ℕ) : E :=
  ((clockShearBackward^[n]) (x, y)).1

/-- The zeroth backward first coordinate is the original first coordinate. -/
@[simp] theorem clockShearBackwardFirst_zero
    {E : Type*} [Field E] [Differential E] (x y : E) :
    clockShearBackwardFirst x y 0 = x := by
  simp [clockShearBackwardFirst]

/-- One backward step has first coordinate `-Dx+y`. -/
@[simp] theorem clockShearBackwardFirst_one
    {E : Type*} [Field E] [Differential E] (x y : E) :
    clockShearBackwardFirst x y 1 = -x′ + y := by
  simp [clockShearBackwardFirst, clockShearBackward]

/-- The backward first coordinates obey a second-order differential recurrence. -/
theorem clockShearBackwardFirst_add_two
    {E : Type*} [Field E] [Differential E] (x y : E) (n : ℕ) :
    clockShearBackwardFirst x y (n + 2) =
      -(clockShearBackwardFirst x y (n + 1))′ + clockShearBackwardFirst x y n := by
  simp only [clockShearBackwardFirst, Function.iterate_succ_apply', clockShearBackward]

/-- The common finite-jet field of a rank-two clock at resolution `n`. -/
def clockShearObservableField
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (v : Fin 2 → E) (n : ℕ) : IntermediateField F E :=
  differentialFamilyObservableField F v (fun _ => n)

/-- Increasing the common resolution enlarges the clock-shear observable field. -/
theorem clockShearObservableField_mono
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (v : Fin 2 → E) {m n : ℕ} (hmn : m ≤ n) :
    clockShearObservableField F v m ≤ clockShearObservableField F v n :=
  differentialFamilyObservableField_mono v (fun _ => hmn)

/-- The `n`-th backward first coordinate has leading term `(-1)^n D^n x`; everything
else is visible strictly below order `n`. -/
theorem clockShearBackwardFirst_sub_leading_mem
    {F E : Type*} [Field F] [Field E] [CharZero E]
    [Differential F] [Differential E] [Algebra F E] [DifferentialAlgebra F E]
    (v : Fin 2 → E) (hv : DifferentialIndependent F v) (n : ℕ) :
    clockShearBackwardFirst (v 0) (v 1) n -
        (-1 : E) ^ n * differentialJet n (v 0) ∈
      clockShearObservableField F v n := by
  induction n using Nat.twoStepInduction with
  | zero =>
      simp [clockShearObservableField]
  | one =>
      have hy : differentialJet 0 (v 1) ∈ clockShearObservableField F v 1 :=
        (differentialJet_mem_differentialFamilyObservableField_iff hv
          (fun _ : Fin 2 => 1) 1 0).2 (by simp)
      simpa [clockShearObservableField] using hy
  | more n ihn ihn1 =>
      let r : E := clockShearBackwardFirst (v 0) (v 1) (n + 1) -
        (-1 : E) ^ (n + 1) * differentialJet (n + 1) (v 0)
      have hr : r ∈ clockShearObservableField F v (n + 1) := ihn1
      have hr' : r′ ∈ clockShearObservableField F v (n + 2) := by
        simpa [clockShearObservableField, r] using
          differentialFamilyObservableField_deriv_mem_succ v (fun _ : Fin 2 => n + 1) hr
      have hxn : differentialJet n (v 0) ∈ clockShearObservableField F v (n + 1) :=
        (differentialJet_mem_differentialFamilyObservableField_iff hv
          (fun _ : Fin 2 => n + 1) 0 n).2 (by omega)
      have hbn : clockShearBackwardFirst (v 0) (v 1) n ∈
          clockShearObservableField F v (n + 1) := by
        have ihn' : clockShearBackwardFirst (v 0) (v 1) n -
              (-1 : E) ^ n * differentialJet n (v 0) ∈
            clockShearObservableField F v (n + 1) :=
          clockShearObservableField_mono v (by omega) ihn
        have hsign : (-1 : E) ^ n ∈ clockShearObservableField F v (n + 1) :=
          (clockShearObservableField F v (n + 1)).toSubfield.pow_mem
            (IntermediateField.neg_mem _ (IntermediateField.one_mem _)) n
        have hlead : (-1 : E) ^ n * differentialJet n (v 0) ∈
            clockShearObservableField F v (n + 1) :=
          IntermediateField.mul_mem _ hsign hxn
        have hadd := IntermediateField.add_mem _ ihn' hlead
        simpa only [sub_add_cancel] using hadd
      have hbn' : clockShearBackwardFirst (v 0) (v 1) n ∈
          clockShearObservableField F v (n + 2) :=
        clockShearObservableField_mono v (by omega) hbn
      have hsum : -r′ + clockShearBackwardFirst (v 0) (v 1) n ∈
          clockShearObservableField F v (n + 2) :=
        IntermediateField.add_mem _ (IntermediateField.neg_mem _ hr') hbn'
      convert hsum using 1
      rw [clockShearBackwardFirst_add_two]
      have hsignDeriv : ((-1 : E) ^ (n + 1))′ = 0 := by
        simp [Derivation.leibniz_pow]
      simp only [r, map_sub, Derivation.leibniz, hsignDeriv, differentialJet_succ]
      simp only [pow_succ]
      ring

/-- The `n`-th backward first coordinate is visible at resolution `n+1`. -/
theorem clockShearBackwardFirst_mem_succ
    {F E : Type*} [Field F] [Field E] [CharZero E]
    [Differential F] [Differential E] [Algebra F E] [DifferentialAlgebra F E]
    (v : Fin 2 → E) (hv : DifferentialIndependent F v) (n : ℕ) :
    clockShearBackwardFirst (v 0) (v 1) n ∈
      clockShearObservableField F v (n + 1) := by
  have hr := clockShearBackwardFirst_sub_leading_mem v hv n
  have hr' : clockShearBackwardFirst (v 0) (v 1) n -
        (-1 : E) ^ n * differentialJet n (v 0) ∈
      clockShearObservableField F v (n + 1) :=
    clockShearObservableField_mono v (Nat.le_succ n) hr
  have hxn : differentialJet n (v 0) ∈ clockShearObservableField F v (n + 1) :=
    (differentialJet_mem_differentialFamilyObservableField_iff hv
      (fun _ : Fin 2 => n + 1) 0 n).2 (by omega)
  have hsign : (-1 : E) ^ n ∈ clockShearObservableField F v (n + 1) :=
    (clockShearObservableField F v (n + 1)).toSubfield.pow_mem
      (IntermediateField.neg_mem _ (IntermediateField.one_mem _)) n
  have hlead := IntermediateField.mul_mem _ hsign hxn
  have hadd := IntermediateField.add_mem _ hr' hlead
  simpa only [sub_add_cancel] using hadd

/-- The `n`-th backward first coordinate is not visible strictly below its leading jet order. -/
theorem clockShearBackwardFirst_not_mem_self
    {F E : Type*} [Field F] [Field E] [CharZero E]
    [Differential F] [Differential E] [Algebra F E] [DifferentialAlgebra F E]
    (v : Fin 2 → E) (hv : DifferentialIndependent F v) (n : ℕ) :
    clockShearBackwardFirst (v 0) (v 1) n ∉ clockShearObservableField F v n := by
  intro hb
  have hr := clockShearBackwardFirst_sub_leading_mem v hv n
  have hlead : (-1 : E) ^ n * differentialJet n (v 0) ∈
      clockShearObservableField F v n := by
    have hsub := IntermediateField.sub_mem _ hb hr
    simpa only [sub_sub_cancel] using hsub
  have hsign : (-1 : E) ^ n ∈ clockShearObservableField F v n :=
    (clockShearObservableField F v n).toSubfield.pow_mem
      (IntermediateField.neg_mem _ (IntermediateField.one_mem _)) n
  have hsignInv : ((-1 : E) ^ n)⁻¹ ∈ clockShearObservableField F v n :=
    IntermediateField.inv_mem _ hsign
  have hxn' := IntermediateField.mul_mem _ hsignInv hlead
  have hsignne : (-1 : E) ^ n ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
  have hxn : differentialJet n (v 0) ∈ clockShearObservableField F v n := by
    convert hxn' using 1
    field_simp
  have := (differentialJet_mem_differentialFamilyObservableField_iff hv
    (fun _ : Fin 2 => n) 0 n).1 hxn
  exact (Nat.lt_irrefl n this)

/-- **Exact clock-shear reconstruction law.** The first coordinate after `n` backward steps is
visible at common resolution `m` exactly when `m` exceeds `n`. -/
theorem clockShearBackwardFirst_mem_iff
    {F E : Type*} [Field F] [Field E] [CharZero E]
    [Differential F] [Differential E] [Algebra F E] [DifferentialAlgebra F E]
    (v : Fin 2 → E) (hv : DifferentialIndependent F v) (n m : ℕ) :
    clockShearBackwardFirst (v 0) (v 1) n ∈ clockShearObservableField F v m ↔ n < m := by
  constructor
  · intro hmem
    by_contra hnot
    have hmn : m ≤ n := Nat.le_of_not_gt hnot
    exact clockShearBackwardFirst_not_mem_self v hv n
      (clockShearObservableField_mono v hmn hmem)
  · intro hnm
    exact clockShearObservableField_mono v (Nat.succ_le_iff.mpr hnm)
      (clockShearBackwardFirst_mem_succ v hv n)

end

