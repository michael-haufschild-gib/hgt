import Mathlib.FieldTheory.PolynomialGaloisGroup
import Mathlib.LinearAlgebra.Matrix.Charpoly.Coeff
import Mathlib.Tactic

/-!
# A symmetric Galois group makes every nonzero rational vector cyclic

A polynomial whose Galois group has order `D!` cannot factor: the Galois group of a product embeds
in the product of the Galois groups, and `a! · b! < (a+b)!`.  For a matrix this means the
characteristic polynomial is irreducible, and then the annihilator of any nonzero vector in the
polynomial ring is a nonzero proper ideal contained in a maximal one generated by an irreducible
polynomial — so it is generated by the characteristic polynomial itself, and the Krylov family of
that vector is a basis.  No Galois descent on eigenvectors is needed.

## Main results

* `card_gal_le_factorial` — the Galois group embeds in the symmetric group on the roots.
* `factorial_mul_factorial_lt` — `a! · b! < (a+b)!` for positive `a`, `b`.
* `irreducible_of_card_gal_eq_factorial` — **a symmetric Galois group forces irreducibility.**
* `linearIndependent_krylov_of_irreducible` — **an irreducible characteristic polynomial makes every
  nonzero vector cyclic.**
-/

open Polynomial Matrix
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

theorem card_gal_le_factorial {F : Type*} [Field F] (p : F[X]) :
    Nat.card p.Gal ≤ (p.natDegree).factorial := by
  classical
  haveI : Fact ((p.map (algebraMap F p.SplittingField)).Splits) :=
    ⟨Polynomial.IsSplittingField.splits p.SplittingField p⟩
  have h1 : Nat.card p.Gal ≤ Nat.card (Equiv.Perm (p.rootSet p.SplittingField)) :=
    Nat.card_le_card_of_injective _ (Polynomial.Gal.galActionHom_injective p p.SplittingField)
  have h2 : Fintype.card (p.rootSet p.SplittingField) ≤ p.natDegree := by
    rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq]
    exact Polynomial.ncard_rootSet_le p _
  have h3 : Nat.card (Equiv.Perm (p.rootSet p.SplittingField))
      = (Fintype.card (p.rootSet p.SplittingField)).factorial := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
  rw [h3] at h1
  exact le_trans h1 (Nat.factorial_le h2)

theorem factorial_mul_factorial_lt {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b) :
    a.factorial * b.factorial < (a + b).factorial := by
  obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
  obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
  have hkey := Nat.choose_mul_factorial_mul_factorial
    (n := (a' + 1) + (b' + 1)) (k := a' + 1) (by omega)
  have hsub : (a' + 1 + (b' + 1)) - (a' + 1) = b' + 1 := by omega
  rw [hsub] at hkey
  have hchoose : 2 ≤ (a' + 1 + (b' + 1)).choose (a' + 1) := by
    have h : (a' + 1 + (b' + 1)) = (a' + b' + 1) + 1 := by omega
    rw [h, Nat.choose_succ_succ]
    simp only [Nat.succ_eq_add_one]
    have h1 : 0 < (a' + b' + 1).choose a' := Nat.choose_pos (by omega)
    have h2 : 0 < (a' + b' + 1).choose (a' + 1) := Nat.choose_pos (by omega)
    omega
  have hpos : 0 < (a' + 1).factorial * (b' + 1).factorial :=
    Nat.mul_pos (Nat.factorial_pos _) (Nat.factorial_pos _)
  have hmul : 2 * ((a' + 1).factorial * (b' + 1).factorial)
      ≤ (a' + 1 + (b' + 1)).choose (a' + 1) * ((a' + 1).factorial * (b' + 1).factorial) :=
    Nat.mul_le_mul_right _ hchoose
  have heq : (a' + 1 + (b' + 1)).choose (a' + 1) * ((a' + 1).factorial * (b' + 1).factorial)
      = (a' + 1 + (b' + 1)).factorial := by
    rw [← hkey]
    ring
  calc (a' + 1).factorial * (b' + 1).factorial
      < 2 * ((a' + 1).factorial * (b' + 1).factorial) := by omega
    _ ≤ (a' + 1 + (b' + 1)).choose (a' + 1) * ((a' + 1).factorial * (b' + 1).factorial) := hmul
    _ = (a' + 1 + (b' + 1)).factorial := heq

/-- **A symmetric Galois group forces irreducibility.** -/
theorem irreducible_of_card_gal_eq_factorial {F : Type*} [Field F] {p : F[X]}
    (hp0 : p ≠ 0) (hdeg : 1 ≤ p.natDegree)
    (hgal : Nat.card p.Gal = (p.natDegree).factorial) : Irreducible p := by
  by_contra hirr
  have hpu : ¬ IsUnit p := by
    intro hu
    have := Polynomial.natDegree_eq_zero_of_isUnit hu
    omega
  obtain ⟨g, h, hgh, hgu, hhu⟩ : ∃ g h, p = g * h ∧ ¬ IsUnit g ∧ ¬ IsUnit h := by
    rw [irreducible_iff] at hirr
    push Not at hirr
    obtain ⟨g, h, hgh, hgu, hhu⟩ := hirr hpu
    exact ⟨g, h, hgh, hgu, hhu⟩
  subst hgh
  have hg0 : g ≠ 0 := fun h0 => hp0 (by rw [h0, zero_mul])
  have hh0 : h ≠ 0 := fun h0 => hp0 (by rw [h0, mul_zero])
  have hunit : ∀ q : F[X], q ≠ 0 → q.natDegree = 0 → IsUnit q := by
    intro q hq0 hq
    refine Polynomial.isUnit_iff_degree_eq_zero.mpr ?_
    rw [Polynomial.degree_eq_natDegree hq0, hq]
    rfl
  have hgdeg : 1 ≤ g.natDegree := by
    rcases Nat.eq_zero_or_pos g.natDegree with h0 | h0
    · exact absurd (hunit g hg0 h0) hgu
    · exact h0
  have hhdeg : 1 ≤ h.natDegree := by
    rcases Nat.eq_zero_or_pos h.natDegree with h0 | h0
    · exact absurd (hunit h hh0 h0) hhu
    · exact h0
  have hcard : Nat.card (g * h).Gal ≤ Nat.card g.Gal * Nat.card h.Gal := by
    have hinj := Nat.card_le_card_of_injective _ (Polynomial.Gal.restrictProd_injective g h)
    rwa [Nat.card_prod] at hinj
  have hle : Nat.card (g * h).Gal ≤ (g.natDegree).factorial * (h.natDegree).factorial :=
    le_trans hcard (Nat.mul_le_mul (card_gal_le_factorial g) (card_gal_le_factorial h))
  rw [hgal, Polynomial.natDegree_mul hg0 hh0] at hle
  exact absurd hle (not_le.mpr (factorial_mul_factorial_lt hgdeg hhdeg))

/-- **An irreducible characteristic polynomial makes every nonzero vector cyclic.** -/
theorem linearIndependent_krylov_of_irreducible {F : Type*} [Field F] {n : Type*} [Fintype n]
    [DecidableEq n] (M : Matrix n n F) (hirr : Irreducible M.charpoly)
    {v : n → F} (hv : v ≠ 0) :
    LinearIndependent F (fun k : Fin (Fintype.card n) => M ^ (k : ℕ) *ᵥ v) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c hc
  by_contra hne
  push Not at hne
  obtain ⟨k₀, hk₀⟩ := hne
  set f : F[X] := ∑ k : Fin (Fintype.card n), Polynomial.monomial (k : ℕ) (c k) with hf
  have hcoeff : ∀ k : Fin (Fintype.card n), f.coeff (k : ℕ) = c k := by
    intro k
    rw [hf, Polynomial.finsetSum_coeff, Finset.sum_eq_single k]
    · rw [Polynomial.coeff_monomial, if_pos rfl]
    · intro b _ hb
      rw [Polynomial.coeff_monomial, if_neg]
      intro hcon
      exact hb (Fin.ext hcon)
    · intro hmem
      exact absurd (Finset.mem_univ k) hmem
  have hfne : f ≠ 0 := by
    intro h0
    refine hk₀ ?_
    rw [← hcoeff k₀, h0, Polynomial.coeff_zero]
  have hdeg : f.degree < ((Fintype.card n : ℕ) : WithBot ℕ) := by
    refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
    refine (Finset.sup_lt_iff (by exact WithBot.bot_lt_coe (Fintype.card n))).mpr ?_
    intro k _
    refine lt_of_le_of_lt (Polynomial.degree_monomial_le _ _) ?_
    exact_mod_cast (Nat.cast_lt (α := WithBot ℕ)).mpr k.isLt
  have hfdeg : f.natDegree < Fintype.card n :=
    (Polynomial.natDegree_lt_iff_degree_lt hfne).mpr hdeg
  have hcharD : M.charpoly.natDegree = Fintype.card n := Matrix.charpoly_natDegree_eq_dim M
  have hndvd : ¬ M.charpoly ∣ f := by
    intro hdvd
    have := Polynomial.natDegree_le_of_dvd hdvd hfne
    omega
  have hfM : (Polynomial.aeval M f) *ᵥ v = 0 := by
    rw [hf, map_sum, Matrix.sum_mulVec]
    rw [← hc]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul,
      Matrix.smul_mulVec]
  obtain ⟨a, b, hab⟩ := (hirr.coprime_iff_not_dvd).mpr hndvd
  have hone : (Polynomial.aeval M (a * M.charpoly + b * f)) *ᵥ v = v := by
    rw [hab, map_one, Matrix.one_mulVec]
  rw [map_add, map_mul, map_mul, Matrix.aeval_self_charpoly, mul_zero, zero_add,
    ← Matrix.mulVec_mulVec, hfM, Matrix.mulVec_zero] at hone
  exact hv hone.symm

end

end GaloisForLFunctions.HTGeometry
