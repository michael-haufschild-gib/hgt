import GaloisForLFunctions.HTGeometry.AlgebraicIndependentLinearForms
import Mathlib.LinearAlgebra.Basis.Basic

/-!
# Principal-symbol hypertranscendence horizon

A derivation which raises an algebraically free filtration with principal coefficient `s` has
algebraically independent iterates exactly when `s` is nonzero.  The derivation is allowed to act
nontrivially on the coefficient field: only compatibility with the induced coefficient derivation
is required.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Module Set

variable {k K L : Type*} [Field k] [Field K] [Field L]
  [Algebra k K] [Algebra k L] [Algebra K L] [IsScalarTower k K L]

/-- The strict filtration generated by the first `n` source vectors. -/
def principalFiltration (u : ℕ → L) (n : ℕ) : Submodule K L :=
  Submodule.span K (Set.range fun j : Fin n ↦ u j)

theorem principalFiltration_mono (u : ℕ → L) {m n : ℕ} (hmn : m ≤ n) :
    principalFiltration (K := K) u m ≤ principalFiltration (K := K) u n := by
  apply Submodule.span_mono (R := K) (M := L)
  rintro y ⟨j, rfl⟩
  exact (show u j ∈ Set.range (fun i : Fin n ↦ u i) from
    ⟨⟨j, lt_of_lt_of_le j.isLt hmn⟩, rfl⟩)

theorem principalFiltration_source_mem (u : ℕ → L) {j n : ℕ} (hj : j < n) :
    u j ∈ principalFiltration (K := K) u n :=
  Submodule.subset_span (R := K) ⟨⟨j, hj⟩, rfl⟩

omit [IsScalarTower k K L] in
/-- A compatible derivation carries the strict source filtration at order `n` into the one at
order `n+1` whenever its action has one-step principal symbol `s`. -/
theorem derivation_principalFiltration_succ
    (D₀ : Derivation k K K) (D : Derivation k L L) (u : ℕ → L) (s : K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (n : ℕ) {y : L} (hy : y ∈ principalFiltration (K := K) u n) :
    D y ∈ principalFiltration (K := K) u (n + 1) := by
  refine Submodule.span_induction
    (R := K) (M := L) (s := Set.range fun j : Fin n ↦ u j)
    (p := fun y _ ↦ D y ∈ principalFiltration (K := K) u (n + 1))
    ?_ ?_ ?_ ?_ (hx := hy)
  · rintro y ⟨j, rfl⟩
    have hjn : (j : ℕ) < n := j.isLt
    have hrem : D (u j) - s • u ((j : ℕ) + 1) ∈
        principalFiltration (K := K) u (n + 1) :=
      principalFiltration_mono (K := K) u
        (Nat.succ_le_succ (Nat.le_of_lt hjn)) (hstep j)
    have hlead : s • u ((j : ℕ) + 1) ∈
        principalFiltration (K := K) u (n + 1) :=
      (principalFiltration (K := K) u (n + 1)).smul_mem s
        (principalFiltration_source_mem (K := K) u (Nat.succ_lt_succ hjn))
    simpa only [sub_add_cancel] using
      (principalFiltration (K := K) u (n + 1)).add_mem hrem hlead
  · simp
  · intro x y hx hy hxD hyD
    simpa using (principalFiltration (K := K) u (n + 1)).add_mem hxD hyD
  · intro a y hy hyD
    rw [Algebra.smul_def, Derivation.leibniz, hcompat]
    have haDy := (principalFiltration (K := K) u (n + 1)).smul_mem a hyD
    have hD₀y := (principalFiltration (K := K) u (n + 1)).smul_mem (D₀ a)
      (principalFiltration_mono (K := K) u (Nat.le_succ n) hy)
    simpa [Algebra.smul_def, mul_comm] using
      (principalFiltration (K := K) u (n + 1)).add_mem haDy hD₀y

omit [IsScalarTower k K L] in
/-- The `n`-th iterated law jet has principal term `s^n u_n`; every other term lies strictly
below it in the source filtration. -/
theorem principalJet_sub_pow_smul_mem
    (D₀ : Derivation k K K) (D : Derivation k L L) (u : ℕ → L) (s : K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1)) :
    ∀ n : ℕ,
      ((D : L → L)^[n] (u 0)) - (s ^ n) • u n ∈
        principalFiltration (K := K) u n := by
  intro n
  induction n with
  | zero => simp [principalFiltration]
  | succ n ih =>
      let r : L := ((D : L → L)^[n] (u 0)) - (s ^ n) • u n
      have hr : r ∈ principalFiltration (K := K) u n := ih
      have hDr : D r ∈ principalFiltration (K := K) u (n + 1) :=
        derivation_principalFiltration_succ D₀ D u s hcompat hstep n hr
      have hDn : D (u n) - s • u (n + 1) ∈
          principalFiltration (K := K) u (n + 1) := hstep n
      have hcoeff : (D₀ (s ^ n)) • u n ∈
          principalFiltration (K := K) u (n + 1) :=
        (principalFiltration (K := K) u (n + 1)).smul_mem _
          (principalFiltration_source_mem (K := K) u (Nat.lt_succ_self n))
      have hscaled : (s ^ n) • (D (u n) - s • u (n + 1)) ∈
          principalFiltration (K := K) u (n + 1) :=
        (principalFiltration (K := K) u (n + 1)).smul_mem _ hDn
      have hsum := (principalFiltration (K := K) u (n + 1)).add_mem
        ((principalFiltration (K := K) u (n + 1)).add_mem hDr hcoeff) hscaled
      rw [Function.iterate_succ_apply']
      have hrEq : ((D : L → L)^[n] (u 0)) = r + (s ^ n) • u n := by
        exact (sub_add_cancel _ _).symm
      rw [hrEq, map_add, Algebra.smul_def, Derivation.leibniz, hcompat]
      convert hsum using 1
      all_goals simp [Algebra.smul_def, map_pow, pow_succ]
      all_goals ring

omit [Algebra k K] [IsScalarTower k K L] in
/-- The principal raising coefficient is intrinsic to an algebraically free source filtration.
Two coefficients satisfying the same one-step law for the same derivation must coincide.  Thus the
characteristic horizon cannot be manufactured by choosing a symbol after the law action is fixed. -/
theorem principalSymbol_unique
    (D : Derivation k L L) (u : ℕ → L) (s t : K)
    (hs : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (ht : ∀ n : ℕ,
      D (u n) - t • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K u) :
    s = t := by
  have hdiff : (t - s) • u 1 ∈ principalFiltration (K := K) u 1 := by
    have h := (principalFiltration (K := K) u 1).sub_mem (hs 0) (ht 0)
    convert h using 1
    all_goals simp [sub_smul]
  obtain ⟨q, hq⟩ :=
    (Submodule.mem_span_range_iff_exists_fun K).mp hdiff
  have hrel : (t - s) • u 1 = q 0 • u 0 := by
    simpa [principalFiltration] using hq.symm
  let P : MvPolynomial ℕ K :=
    MvPolynomial.C (t - s) * MvPolynomial.X 1 -
      MvPolynomial.C (q 0) * MvPolynomial.X 0
  have hP_eval : MvPolynomial.aeval u P = 0 := by
    have hrel' :
        algebraMap K L (t - s) * u 1 - algebraMap K L (q 0) * u 0 = 0 := by
      rw [← Algebra.smul_def, ← Algebra.smul_def, hrel, sub_self]
    simpa [P] using hrel'
  have hPzero : P = 0 := hu.eq_zero_of_aeval_eq_zero P hP_eval
  have hcoeff := congrArg
    (fun Q : MvPolynomial ℕ K ↦ Q.coeff (Finsupp.single 1 1)) hPzero
  have hfirst : MvPolynomial.coeff (Finsupp.single 1 1)
      (MvPolynomial.C (t - s) * MvPolynomial.X 1) = t - s := by
    rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, if_pos rfl, mul_one]
  have hmonomial_ne :
      (Finsupp.single 0 1 : ℕ →₀ ℕ) ≠ Finsupp.single 1 1 := by
    intro h
    have h0 := congrArg (fun m : ℕ →₀ ℕ ↦ m 0) h
    simp at h0
  have hsecond : MvPolynomial.coeff (Finsupp.single 1 1)
      (MvPolynomial.C (q 0) * MvPolynomial.X 0) = 0 := by
    rw [MvPolynomial.coeff_C_mul]
    simp [MvPolynomial.coeff_X, hmonomial_ne]
  have hcoeffP : P.coeff (Finsupp.single 1 1) = t - s := by
    change MvPolynomial.coeff (Finsupp.single 1 1)
        (MvPolynomial.C (t - s) * MvPolynomial.X 1) -
      MvPolynomial.coeff (Finsupp.single 1 1)
        (MvPolynomial.C (q 0) * MvPolynomial.X 0) = t - s
    rw [hfirst, hsecond, sub_zero]
  have hts : t - s = 0 := by
    have hcoeff' : P.coeff (Finsupp.single 1 1) = 0 := by
      simpa using hcoeff
    exact hcoeffP.symm.trans hcoeff'
  exact (sub_eq_zero.mp hts).symm

/-- A lower-triangular change of a finite algebraically independent packet remains algebraically
independent when all diagonal coefficients are nonzero.  The hypothesis is coordinate-free: each
new vector differs from its diagonal source term by the span of the preceding source vectors. -/
theorem algebraicIndependent_of_lowerTriangularSpan
    {N : ℕ} (u y : Fin N → L) (d : Fin N → K)
    (hu : AlgebraicIndependent K u)
    (htri : ∀ i : Fin N,
      y i - d i • u i ∈
        Submodule.span K (Set.range fun j : Fin (i : ℕ) ↦ u ⟨j, lt_trans j.isLt i.isLt⟩))
    (hd : ∀ i, d i ≠ 0) :
    AlgebraicIndependent K y := by
  let S : Submodule K L := Submodule.span K (Set.range u)
  let b : Basis (Fin N) K S := Basis.span hu.linearIndependent
  have hlowS : ∀ i, y i - d i • u i ∈ S := by
    intro i
    apply (Submodule.span_mono (R := K) (M := L) ?_) (htri i)
    rintro z ⟨j, rfl⟩
    exact ⟨⟨j, lt_trans j.isLt i.isLt⟩, rfl⟩
  have hyS : ∀ i, y i ∈ S := by
    intro i
    have hdiag : d i • u i ∈ S :=
      (Submodule.span K (Set.range u)).smul_mem (d i)
        (Submodule.subset_span ⟨i, rfl⟩)
    have := (Submodule.span K (Set.range u)).add_mem (hlowS i) hdiag
    simpa only [sub_add_cancel] using this
  let M : Matrix (Fin N) (Fin N) K := fun i j ↦ b.repr ⟨y i, hyS i⟩ j
  have hrepr_lower : ∀ (i j : Fin N), i ≤ j →
      b.repr ⟨y i - d i • u i, hlowS i⟩ j = 0 := by
    intro i j hij
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp (htri i)
    have hsubtype : (⟨y i - d i • u i, hlowS i⟩ : S) =
        ∑ l : Fin (i : ℕ), c l •
          (⟨u ⟨l, lt_trans l.isLt i.isLt⟩,
            Submodule.subset_span ⟨⟨l, lt_trans l.isLt i.isLt⟩, rfl⟩⟩ : S) := by
      apply Subtype.ext
      simpa using hc.symm
    rw [hsubtype, map_sum]
    simp_rw [map_smul]
    have heval :
        ((∑ l : Fin (i : ℕ), c l •
            b.repr
              (⟨u ⟨l, lt_trans l.isLt i.isLt⟩,
                Submodule.subset_span
                  ⟨⟨l, lt_trans l.isLt i.isLt⟩, rfl⟩⟩ : S)) : Fin N →₀ K) j =
          ∑ l : Fin (i : ℕ),
            (c l • b.repr
              (⟨u ⟨l, lt_trans l.isLt i.isLt⟩,
                Submodule.subset_span
                  ⟨⟨l, lt_trans l.isLt i.isLt⟩, rfl⟩⟩ : S)) j := by
      exact map_sum (Finsupp.applyAddHom j)
        (fun l : Fin (i : ℕ) ↦ c l •
          b.repr
            (⟨u ⟨l, lt_trans l.isLt i.isLt⟩,
              Submodule.subset_span
                ⟨⟨l, lt_trans l.isLt i.isLt⟩, rfl⟩⟩ : S)) Finset.univ
    rw [heval]
    apply Finset.sum_eq_zero
    intro l hl
    have hne : (⟨l, lt_trans l.isLt i.isLt⟩ : Fin N) ≠ j := by
      intro h
      have hval : (l : ℕ) = (j : ℕ) := congrArg Fin.val h
      omega
    simp [b, S, hne]
  have hcoord_lower : ∀ (i j : Fin N), i < j → M i j = 0 := by
    intro i j hij
    have hzero := hrepr_lower i j (Nat.le_of_lt hij)
    have hbasis : b.repr
        ⟨u i, Submodule.subset_span ⟨i, rfl⟩⟩ j = 0 := by
      simp [b, S, ne_of_lt hij]
    change b.repr ⟨y i, hyS i⟩ j = 0
    have hsub : (⟨y i - d i • u i, hlowS i⟩ : S) =
        ⟨y i, hyS i⟩ - d i •
          ⟨u i, Submodule.subset_span ⟨i, rfl⟩⟩ := rfl
    rw [hsub, map_sub, map_smul] at hzero
    rw [← sub_eq_zero]
    simpa [hbasis] using hzero
  have hcoord_diag : ∀ i : Fin N, M i i = d i := by
    intro i
    have hzero := hrepr_lower i i le_rfl
    have hbasis : b.repr
        ⟨u i, Submodule.subset_span ⟨i, rfl⟩⟩ i = 1 := by
      simp [b, S]
    change b.repr ⟨y i, hyS i⟩ i = d i
    have hsub : (⟨y i - d i • u i, hlowS i⟩ : S) =
        ⟨y i, hyS i⟩ - d i •
          ⟨u i, Submodule.subset_span ⟨i, rfl⟩⟩ := rfl
    rw [hsub, map_sub, map_smul] at hzero
    have hzero' : b.repr ⟨y i, hyS i⟩ i - d i = 0 := by
      simpa [hbasis] using hzero
    exact sub_eq_zero.mp hzero'
  have hpacket : y = matrixLinearForms M u := by
    funext i
    have hrepr := congrArg ((↑) : S → L) (b.sum_repr ⟨y i, hyS i⟩)
    change y i = ∑ j, algebraMap K L (M i j) * u j
    simpa [M, b, S, Algebra.smul_def] using hrepr.symm
  have hlower : M.BlockTriangular (fun i : Fin N ↦ OrderDual.toDual i) := by
    intro i j hij
    exact hcoord_lower i j (OrderDual.toDual_lt_toDual.mp hij)
  have hdet : M.det ≠ 0 := by
    rw [Matrix.det_of_lowerTriangular _ hlower]
    apply Finset.prod_ne_zero_iff.mpr
    intro i hi
    rw [hcoord_diag]
    exact hd i
  have hrows : LinearIndependent K M.row :=
    Matrix.linearIndependent_rows_of_det_ne_zero hdet
  rw [hpacket]
  exact algebraicIndependent_matrixLinearForms_of_linearIndependent_rows M hrows u hu

omit [IsScalarTower k K L] in
/-- Every finite packet of principal-law jets is algebraically independent off the characteristic
horizon. -/
theorem principalJetPacket_algebraicIndependent
    (D₀ : Derivation k K K) (D : Derivation k L L) (u : ℕ → L) (s : K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (hs : s ≠ 0) (N : ℕ)
    (hu : AlgebraicIndependent K (fun i : Fin N ↦ u i)) :
    AlgebraicIndependent K (fun i : Fin N ↦ (D : L → L)^[(i : ℕ)] (u 0)) := by
  apply algebraicIndependent_of_lowerTriangularSpan
    (fun i : Fin N ↦ u i)
    (fun i : Fin N ↦ (D : L → L)^[(i : ℕ)] (u 0))
    (fun i : Fin N ↦ s ^ (i : ℕ)) hu
  · intro i
    simpa [principalFiltration] using
      principalJet_sub_pow_smul_mem D₀ D u s hcompat hstep (i : ℕ)
  · intro i
    exact pow_ne_zero _ hs

omit [IsScalarTower k K L] in
/-- Nonzero principal symbol propagates algebraic independence from the complete source filtration
to the complete iterated law jet. -/
theorem principalJet_algebraicIndependent
    (D₀ : Derivation k K K) (D : Derivation k L L) (u : ℕ → L) (s : K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (hs : s ≠ 0)
    (hu : AlgebraicIndependent K u) :
    AlgebraicIndependent K (fun n : ℕ ↦ (D : L → L)^[n] (u 0)) := by
  apply algebraicIndependent_of_finite_type
  intro t ht
  letI : Fintype t := ht.fintype
  let N : ℕ := t.toFinset.sup id + 1
  let e : t → Fin N := fun i ↦
    ⟨i.1, Nat.lt_succ_of_le (Finset.le_sup (f := id)
      (show i.1 ∈ t.toFinset by simp [i.2]))⟩
  have he : Function.Injective e := by
    intro i j hij
    apply Subtype.ext
    exact Fin.ext_iff.mp hij
  have huN : AlgebraicIndependent K (fun i : Fin N ↦ u i) :=
    hu.comp (fun i : Fin N ↦ (i : ℕ)) Fin.val_injective
  have hN := principalJetPacket_algebraicIndependent
    D₀ D u s hcompat hstep hs N huN
  simpa [e, Function.comp_def] using hN.comp e he

omit [IsScalarTower k K L] in
/-- Exact principal-symbol horizon.  A zero symbol gives a first-order linear relation, while a
nonzero symbol gives an algebraically independent complete jet tower. -/
theorem principalJet_algebraicIndependent_iff
    (D₀ : Derivation k K K) (D : Derivation k L L) (u : ℕ → L) (s : K)
    (hcompat : ∀ a : K, D (algebraMap K L a) = algebraMap K L (D₀ a))
    (hstep : ∀ n : ℕ,
      D (u n) - s • u (n + 1) ∈ principalFiltration (K := K) u (n + 1))
    (hu : AlgebraicIndependent K u) :
    AlgebraicIndependent K (fun n : ℕ ↦ (D : L → L)^[n] (u 0)) ↔ s ≠ 0 := by
  constructor
  · intro hjet hs0
    subst s
    have hrem : D (u 0) ∈ principalFiltration (K := K) u 1 := by
      simpa using hstep 0
    obtain ⟨q, hq⟩ :=
      (Submodule.mem_span_range_iff_exists_fun K).mp hrem
    have hrel : D (u 0) = q 0 • u 0 := by
      simpa [principalFiltration] using hq.symm
    let P : MvPolynomial ℕ K :=
      MvPolynomial.X 1 - MvPolynomial.C (q 0) * MvPolynomial.X 0
    have hP_eval : MvPolynomial.aeval
        (fun n : ℕ ↦ (D : L → L)^[n] (u 0)) P = 0 := by
      simp [P, hrel, Algebra.smul_def]
    have hPzero : P = 0 := hjet.eq_zero_of_aeval_eq_zero P hP_eval
    have hcoeff := congrArg
      (fun Q : MvPolynomial ℕ K ↦ Q.coeff (Finsupp.single 1 1)) hPzero
    simp [P] at hcoeff
  · intro hs
    exact principalJet_algebraicIndependent D₀ D u s hcompat hstep hs hu

end

end GaloisForLFunctions.HTGeometry
