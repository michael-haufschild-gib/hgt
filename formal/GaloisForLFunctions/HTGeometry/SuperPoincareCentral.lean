import GaloisForLFunctions.HTGeometry.SuperPoincareAlgebra
import Mathlib.LinearAlgebra.CliffordAlgebra.Basic

noncomputable section

namespace SuperPoincare

/-- One-dimensional `N = 2` supertranslations with a commuting mixed central charge. -/
structure D1N2Central (R : Type*) [Ring R] where
  supercharge0 : R
  supercharge1 : R
  centralCharge : R
  mixed_anticommutator :
    supercharge0 * supercharge1 + supercharge1 * supercharge0 = centralCharge
  centralCharge_commutes_supercharge0 :
    centralCharge * supercharge0 = supercharge0 * centralCharge
  centralCharge_commutes_supercharge1 :
    centralCharge * supercharge1 = supercharge1 * centralCharge

namespace D1N2Central

variable {R : Type*} [Ring R] (S : D1N2Central R)

/-- First diagonal momentum generated by the first charge. -/
def momentum0 : R := S.supercharge0 * S.supercharge0

/-- Second diagonal momentum generated by the second charge. -/
def momentum1 : R := S.supercharge1 * S.supercharge1

/-- Central charge commutes with first diagonal momentum. -/
theorem centralCharge_commutes_momentum0 :
    S.centralCharge * S.momentum0 = S.momentum0 * S.centralCharge := by
  unfold momentum0
  calc
    S.centralCharge * (S.supercharge0 * S.supercharge0) =
        (S.centralCharge * S.supercharge0) * S.supercharge0 :=
      (mul_assoc _ _ _).symm
    _ = (S.supercharge0 * S.centralCharge) * S.supercharge0 := by
      rw [S.centralCharge_commutes_supercharge0]
    _ = S.supercharge0 * (S.centralCharge * S.supercharge0) := mul_assoc _ _ _
    _ = S.supercharge0 * (S.supercharge0 * S.centralCharge) := by
      rw [S.centralCharge_commutes_supercharge0]
    _ = (S.supercharge0 * S.supercharge0) * S.centralCharge :=
      (mul_assoc _ _ _).symm

/-- Central charge commutes with second diagonal momentum. -/
theorem centralCharge_commutes_momentum1 :
    S.centralCharge * S.momentum1 = S.momentum1 * S.centralCharge := by
  unfold momentum1
  calc
    S.centralCharge * (S.supercharge1 * S.supercharge1) =
        (S.centralCharge * S.supercharge1) * S.supercharge1 :=
      (mul_assoc _ _ _).symm
    _ = (S.supercharge1 * S.centralCharge) * S.supercharge1 := by
      rw [S.centralCharge_commutes_supercharge1]
    _ = S.supercharge1 * (S.centralCharge * S.supercharge1) := mul_assoc _ _ _
    _ = S.supercharge1 * (S.supercharge1 * S.centralCharge) := by
      rw [S.centralCharge_commutes_supercharge1]
    _ = (S.supercharge1 * S.supercharge1) * S.centralCharge :=
      (mul_assoc _ _ _).symm

/-- A split zero-central-charge sector is a central extension with vanishing charge. -/
def ofSplit (T : D1N2Split R) : D1N2Central R where
  supercharge0 := T.supercharge0
  supercharge1 := T.supercharge1
  centralCharge := 0
  mixed_anticommutator := T.mixed_anticommutator
  centralCharge_commutes_supercharge0 := by simp
  centralCharge_commutes_supercharge1 := by simp

end D1N2Central

end SuperPoincare

namespace GaloisForLFunctions.HTGeometry

/-- Every pair in a quadratic module gives a Clifford central-charge supertranslation sector. -/
def cliffordPairD1N2Central
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (Q : QuadraticForm R M) (a b : M) :
    SuperPoincare.D1N2Central (CliffordAlgebra Q) where
  supercharge0 := CliffordAlgebra.ι Q a
  supercharge1 := CliffordAlgebra.ι Q b
  centralCharge := algebraMap R (CliffordAlgebra Q) (QuadraticMap.polar Q a b)
  mixed_anticommutator := CliffordAlgebra.ι_mul_ι_add_swap a b
  centralCharge_commutes_supercharge0 :=
    Algebra.commutes (QuadraticMap.polar Q a b) (CliffordAlgebra.ι Q a)
  centralCharge_commutes_supercharge1 :=
    Algebra.commutes (QuadraticMap.polar Q a b) (CliffordAlgebra.ι Q b)

/-- First Clifford momentum is the scalar quadratic norm. -/
theorem cliffordPair_momentum0
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (Q : QuadraticForm R M) (a b : M) :
    (cliffordPairD1N2Central Q a b).momentum0 =
      algebraMap R (CliffordAlgebra Q) (Q a) := by
  change CliffordAlgebra.ι Q a * CliffordAlgebra.ι Q a = _
  exact CliffordAlgebra.ι_sq_scalar Q a

/-- Second Clifford momentum is the scalar quadratic norm. -/
theorem cliffordPair_momentum1
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (Q : QuadraticForm R M) (a b : M) :
    (cliffordPairD1N2Central Q a b).momentum1 =
      algebraMap R (CliffordAlgebra Q) (Q b) := by
  change CliffordAlgebra.ι Q b * CliffordAlgebra.ι Q b = _
  exact CliffordAlgebra.ι_sq_scalar Q b

end GaloisForLFunctions.HTGeometry
