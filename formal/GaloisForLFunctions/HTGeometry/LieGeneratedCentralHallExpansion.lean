import GaloisForLFunctions.HTGeometry.CentralCasimirCommonKernelCorrection
import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.Algebra.Lie.OfAssociative

/-!
# Hall expansion from a Lie-generating local family

A target subspace that is invariant under local generators and contains their
images of a source subspace automatically contains the images of every element
in the generated Lie algebra.  Combining this transfer principle with a
central-Casimir family yields an exact dimension law modulo only the full
family's common kernel.
-/

open scoped BigOperators Matrix

namespace GaloisForLFunctions.HTGeometry

noncomputable section

local instance moduleEndLieRing
    {𝕜 E : Type*} [CommRing 𝕜]
    [AddCommGroup E] [Module 𝕜 E] :
    LieRing (Module.End 𝕜 E) :=
  LieRing.ofAssociativeRing

/-- Endomorphisms that preserve `V` and send `U` into `V` form a Lie
subalgebra.  The invariance clause is precisely what makes the transfer clause
closed under brackets. -/
def invariantTransferLieSubalgebra
    {𝕜 E : Type*} [CommRing 𝕜]
    [AddCommGroup E] [Module 𝕜 E]
    (U V : Submodule 𝕜 E) :
    LieSubalgebra 𝕜 (Module.End 𝕜 E) where
  carrier := {T |
    (∀ x, x ∈ V → T x ∈ V) ∧
    (∀ x, x ∈ U → T x ∈ V)}
  zero_mem' := by
    constructor <;> intro x hx <;> simp
  add_mem' := by
    intro F G hF hG
    constructor
    · intro x hx
      exact V.add_mem (hF.1 x hx) (hG.1 x hx)
    · intro x hx
      exact V.add_mem (hF.2 x hx) (hG.2 x hx)
  smul_mem' := by
    intro c F hF
    constructor
    · intro x hx
      exact V.smul_mem c (hF.1 x hx)
    · intro x hx
      exact V.smul_mem c (hF.2 x hx)
  lie_mem' := by
    intro F G hF hG
    constructor
    · intro x hx
      rw [Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply,
        Module.End.mul_apply]
      exact V.sub_mem
        (hF.1 (G x) (hG.1 x hx))
        (hG.1 (F x) (hF.1 x hx))
    · intro x hx
      rw [Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply,
        Module.End.mul_apply]
      exact V.sub_mem
        (hF.1 (G x) (hG.2 x hx))
        (hG.1 (F x) (hF.2 x hx))

/-- Every endomorphism in the Lie algebra generated by a local family sends
`U` into `V`, provided the local family preserves `V` and sends `U` into
`V`. -/
theorem lieSpan_maps_subspace_of_invariant
    {𝕜 E J : Type*} [CommRing 𝕜]
    [AddCommGroup E] [Module 𝕜 E]
    (L : J → Module.End 𝕜 E)
    (U V : Submodule 𝕜 E)
    (hLV : ∀ j x, x ∈ V → L j x ∈ V)
    (hLU : ∀ j x, x ∈ U → L j x ∈ V) :
    ∀ T ∈ LieSubalgebra.lieSpan 𝕜 (Module.End 𝕜 E) (Set.range L),
      ∀ x, x ∈ U → T x ∈ V := by
  intro T hT
  have hgen : Set.range L ⊆ invariantTransferLieSubalgebra U V := by
    rintro _ ⟨j, rfl⟩
    exact ⟨hLV j, hLU j⟩
  have hle : LieSubalgebra.lieSpan 𝕜 (Module.End 𝕜 E) (Set.range L) ≤
      invariantTransferLieSubalgebra U V :=
    LieSubalgebra.lieSpan_le.mpr hgen
  exact (hle hT).2

/-- A local family that Lie-generates a Hermitian central-Casimir family has
exact Hall expansion on every invariant target, modulo only the generated
family's simultaneous kernel.  This is a positive-length orbit law: no
one-step Hall premise is assumed. -/
theorem lieGeneratedCentralFamily_subspace_finrank_mod_commonKernel
    {𝕜 X J Q : Type*} [RCLike 𝕜]
    [Fintype X] [DecidableEq X] [Fintype Q]
    (L : J → Matrix X X 𝕜)
    (A : Q → Matrix X X 𝕜)
    (hsymm : ∀ q, (A q).conjTranspose = A q)
    (hcentral : ∀ q,
      (∑ r, A r * A r) * A q = A q * (∑ r, A r * A r))
    (hspan : ∀ q,
      (A q).toEuclideanLin ∈
        LieSubalgebra.lieSpan 𝕜
          (Module.End 𝕜 (EuclideanSpace 𝕜 X))
          (Set.range fun j => (L j).toEuclideanLin))
    (U V : Submodule 𝕜 (EuclideanSpace 𝕜 X))
    (hLV : ∀ j x, x ∈ V → (L j).toEuclideanLin x ∈ V)
    (hLU : ∀ j x, x ∈ U → (L j).toEuclideanLin x ∈ V) :
    Module.finrank 𝕜 U ≤ Module.finrank 𝕜 V +
      Module.finrank 𝕜 (hermitianMatrixFamilyCommonKernel A) := by
  apply centralHermitianMatrixFamily_subspace_finrank_mod_commonKernel
    A hsymm hcentral U V
  intro q x hx
  exact lieSpan_maps_subspace_of_invariant
    (fun j => (L j).toEuclideanLin) U V hLV hLU
    ((A q).toEuclideanLin) (hspan q) x hx

end

end GaloisForLFunctions.HTGeometry
