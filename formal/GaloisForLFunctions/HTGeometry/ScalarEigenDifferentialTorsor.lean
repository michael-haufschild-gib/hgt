import GaloisForLFunctions.HTGeometry.ScalarDifferentialTorsor
import GaloisForLFunctions.HTGeometry.KolchinExchangeGaugeObstruction
import GaloisForLFunctions.HTGeometry.StableCoreFunctoriality

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F T : Type*} [Field F] [Field T] [Algebra F T] [Differential T]

/-- A differential automorphism fixing the logarithmic current fixes the entire differential
field generated by that current. -/
theorem DifferentialAlgEquiv.fixed_on_scalarLogCurrentField_of_fixed_logDeriv
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hJ : sigma.toAlgEquiv (Differential.logDeriv q) = Differential.logDeriv q)
    (z : scalarLogCurrentField F q) :
    sigma.toAlgEquiv z.1 = z.1 := by
  have hjet : ∀ n : ℕ,
      sigma.toAlgEquiv (differentialJet n (Differential.logDeriv q)) =
        differentialJet n (Differential.logDeriv q) := by
    intro n
    rw [sigma.map_differentialJet, hJ]
  change sigma.toAlgEquiv z.1 = z.1
  rw [scalarLogCurrentField, differentialAdjoin] at z
  apply IntermediateField.adjoin_induction F
    (s := differentialJetSet ({Differential.logDeriv q} : Set T))
    (p := fun w _ => sigma.toAlgEquiv w = w)
  · rintro w ⟨v, hv, n, rfl⟩
    have hvJ : v = Differential.logDeriv q := Set.mem_singleton_iff.mp hv
    simpa [hvJ] using hjet n
  · intro c
    exact sigma.toAlgEquiv.commutes c
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]
  · simpa using z.2

/-- Rebase a differential automorphism over the logarithmic-current field once it fixes the
current. -/
def DifferentialAlgEquiv.restrictScalarsToLogCurrent
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hJ : sigma.toAlgEquiv (Differential.logDeriv q) = Differential.logDeriv q) :
    T ≃ₐ[scalarLogCurrentField F q] T where
  toRingEquiv := sigma.toAlgEquiv.toRingEquiv
  commutes' z := sigma.fixed_on_scalarLogCurrentField_of_fixed_logDeriv q hJ z

/-- Rebase a differential automorphism as a derivation-preserving automorphism of the
logarithmic-current extension. -/
def DifferentialAlgEquiv.toLogCurrentDerivationPreservingAut
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hJ : sigma.toAlgEquiv (Differential.logDeriv q) = Differential.logDeriv q) :
    derivationPreservingAut (scalarLogCurrentField F q) T :=
  ⟨sigma.restrictScalarsToLogCurrent q hJ, sigma.map_deriv'⟩

/-- The fixed field of an original-base differential automorphism is unchanged when the
automorphism is rebased over the logarithmic-current field and the resulting intermediate field
is restricted back to the original base. -/
theorem DifferentialAlgEquiv.fixedField_toLogCurrent_restrictScalars
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hJ : sigma.toAlgEquiv (Differential.logDeriv q) = Differential.logDeriv q) :
    (IntermediateField.fixedField
      (Subgroup.zpowers (sigma.restrictScalarsToLogCurrent q hJ))).restrictScalars F =
        IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) := by
  ext z
  rw [IntermediateField.mem_restrictScalars,
    mem_fixedField_zpowers_iff, mem_fixedField_zpowers_iff]
  rfl

variable [Differential F] [DifferentialAlgebra F T]

/-- An eigenvector multiplier from the differential constant field fixes the logarithmic current. -/
theorem DifferentialAlgEquiv.logDeriv_fixed_of_unit_eigenvector
    (sigma : DifferentialAlgEquiv F T) (q : T) (hq0 : q ≠ 0)
    (u : Fˣ) (hconst : ∀ c : F, c′ = 0)
    (hq : sigma.toAlgEquiv q = q * algebraMap F T (u : F)) :
    sigma.toAlgEquiv (Differential.logDeriv q) = Differential.logDeriv q := by
  have hu0 : algebraMap F T (u : F) ≠ 0 :=
    by simpa using (algebraMap F T).injective.ne u.ne_zero
  have hu' : (algebraMap F T (u : F))′ = 0 := by
    rw [deriv_algebraMap, hconst]
    exact map_zero (algebraMap F T)
  exact logDeriv_fixed_of_eigenvector (K := F) (F := T) sigma.toAlgEquiv
    (fun y : T ↦ sigma.map_deriv' y)
    q (algebraMap F T (u : F)) hq0 hu0 hu'
    (by simpa [mul_comm] using hq)

/-- The arbitrary differential eigen-automorphism, rebased over its current field, is the canonical
constant-scaling action. -/
theorem DifferentialAlgEquiv.toLogCurrentAut_eq_scalarDifferentialScaleAction
    [CharZero T]
    (sigma : DifferentialAlgEquiv F T)
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (u : Fˣ) (hconst : ∀ c : F, c′ = 0)
    (hsigma : sigma.toAlgEquiv q = q * algebraMap F T (u : F)) :
    sigma.toLogCurrentDerivationPreservingAut q
        (sigma.logDeriv_fixed_of_unit_eigenvector q hq0 u hconst hsigma) =
      scalarDifferentialScaleAction q hq hq0 hgen hconst u := by
  apply derivationPreservingAut_eq_scaleAction_of_apply_q
    q hq hq0 hgen hconst
  simpa using! hsigma

/-- Finite-order fixed field for an arbitrary original-base differential eigen-automorphism. -/
theorem DifferentialAlgEquiv.fixedField_zpowers_of_unit_eigenvector_of_finite_order
    [CharZero F] [CharZero T]
    (sigma : DifferentialAlgEquiv F T)
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (u : Fˣ) (hconst : ∀ c : F, c′ = 0)
    (hsigma : sigma.toAlgEquiv q = q * algebraMap F T (u : F))
    {N : ℕ} (hN : 0 < N) (hu : orderOf u = N) :
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
      differentialAdjoin F ({q ^ N} : Set T) := by
  let hJ := sigma.logDeriv_fixed_of_unit_eigenvector q hq0 u hconst hsigma
  let sigmaL := sigma.toLogCurrentDerivationPreservingAut q hJ
  have hfixed :
      IntermediateField.fixedField (Subgroup.zpowers sigmaL.1) =
        IntermediateField.adjoin (scalarLogCurrentField F q) ({q ^ N} : Set T) :=
    fixedField_zpowers_derivationPreservingAut_of_finite_order
      q hq hq0 hgen hconst sigmaL u hsigma hN hu
  calc
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
        (IntermediateField.fixedField (Subgroup.zpowers sigmaL.1)).restrictScalars F :=
      (sigma.fixedField_toLogCurrent_restrictScalars q hJ).symm
    _ = (IntermediateField.adjoin (scalarLogCurrentField F q)
        ({q ^ N} : Set T)).restrictScalars F := congrArg _ hfixed
    _ = differentialAdjoin F ({q ^ N} : Set T) :=
      scalarLogCurrentField_adjoin_power_restrictScalars q hq0 hN

/-- Infinite-order fixed field for an arbitrary original-base differential eigen-automorphism. -/
theorem DifferentialAlgEquiv.fixedField_zpowers_of_unit_eigenvector_of_infinite_order
    [CharZero F] [CharZero T]
    (sigma : DifferentialAlgEquiv F T)
    (q : T) (hq : HypertranscendentalOver F q) (hq0 : q ≠ 0)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (u : Fˣ) (hconst : ∀ c : F, c′ = 0)
    (hsigma : sigma.toAlgEquiv q = q * algebraMap F T (u : F))
    (hu : orderOf u = 0) :
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
      scalarLogCurrentField F q := by
  let hJ := sigma.logDeriv_fixed_of_unit_eigenvector q hq0 u hconst hsigma
  let sigmaL := sigma.toLogCurrentDerivationPreservingAut q hJ
  have hfixed :
      IntermediateField.fixedField (Subgroup.zpowers sigmaL.1) = ⊥ :=
    fixedField_zpowers_derivationPreservingAut_of_infinite_order
      q hq hq0 hgen hconst sigmaL u hsigma hu
  calc
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
        (IntermediateField.fixedField (Subgroup.zpowers sigmaL.1)).restrictScalars F :=
      (sigma.fixedField_toLogCurrent_restrictScalars q hJ).symm
    _ = (⊥ : IntermediateField (scalarLogCurrentField F q) T).restrictScalars F :=
      congrArg _ hfixed
    _ = scalarLogCurrentField F q :=
      IntermediateField.restrictScalars_bot_eq_self (scalarLogCurrentField F q)

end

end GaloisForLFunctions.HTGeometry
