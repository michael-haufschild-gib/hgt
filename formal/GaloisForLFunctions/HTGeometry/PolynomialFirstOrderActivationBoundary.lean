import GaloisForLFunctions.HTGeometry.FiniteJetConstraintSourceBoundary

/-!
# Polynomial first-order observation laws preserve differential algebraicity

Suppose an observed value `y` satisfies a first-order differential identity whose right-hand side
is polynomial in `y`, with coefficients in the differential field generated by an input `h`.
Then a differentially algebraic input forces a differentially algebraic output.  Consequently, a
hypertranscendental output forces the input channel itself to be hypertranscendental.

This is an observability statement, not an existence or propagation theorem for an ODE.  The
identity is treated as a static differential constraint on the reported clock value.  It covers
the algebraic core of polynomial-response neural activations, latent neural-ODE readouts, and
polynomial gene-regulatory response laws.  The coefficients may use every derivative already
visible in the differential field generated by `h`.

Parent theory: the field closure of differential-algebraic elements goes back to differential
algebra; a modern constructive treatment is R. Ait El Manssour, A.-L. Sattelberger, and
B. Teguia Tabuguia, *D-Algebraic Functions*, Journal of Symbolic Computation 125 (2025),
arXiv:2301.02512.  The observation-channel interpretation is motivated by differential-algebraic
identifiability in systems biology and symbolic recovery of differential equations in machine
learning.  The exact source-extraction interface below is what is used by this corpus.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

private theorem eval_polynomial_aeval_X_zero
    {R : Type*} [CommRing R] (P : Polynomial R) (v : Fin 2 → R) :
    MvPolynomial.eval v
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R) P) =
        P.eval (v 0) := by
  induction P using Polynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | monomial n a _ => simp

private theorem aeval_polynomial_aeval_X_zero
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (P : Polynomial R) (g : Fin 2 → A) :
    MvPolynomial.aeval g
      (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R) P) =
        Polynomial.eval₂ (algebraMap R A) (g 0) P := by
  induction P using Polynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | monomial n a _ => simp

/-- A polynomial first-order observation law over the differential field generated by `h`
cannot turn a differentially algebraic input into a hypertranscendental output. -/
theorem differentialAlgebraicOver_of_polynomial_firstOrder_over_singleton
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hh : DifferentialAlgebraicOver F h)
    (P : Polynomial (differentialAdjoin F ({h} : Set E)))
    (hrel : y′ = Polynomial.eval₂
      (algebraMap (differentialAdjoin F ({h} : Set E)) E) y P) :
    DifferentialAlgebraicOver F y := by
  let S := differentialAdjoin F ({h} : Set E)
  let Q : MvPolynomial (Fin 2) S :=
    MvPolynomial.X 1 - Polynomial.aeval (MvPolynomial.X 0) P
  have hQ : Q ≠ 0 := by
    let v : Fin 2 → S := fun i =>
      if i = 0 then 0 else P.eval 0 + 1
    have heval : MvPolynomial.eval v
        (Polynomial.aeval (MvPolynomial.X 0) P) = P.eval 0 := by
      simpa [v] using eval_polynomial_aeval_X_zero P v
    intro hzero
    have hev := congrArg (MvPolynomial.eval v) hzero
    simp only [Q, map_sub, MvPolynomial.eval_X, map_zero] at hev
    rw [heval] at hev
    simp [v] at hev
  apply differentialAlgebraicOver_of_finiteJetConstraint_over_singleton hh hQ
  change MvPolynomial.aeval
    (fun j : Fin 2 => differentialJet (j : ℕ) y) Q = 0
  rw [show Q = MvPolynomial.X 1 - Polynomial.aeval (MvPolynomial.X 0) P by rfl]
  rw [map_sub, MvPolynomial.aeval_X,
    aeval_polynomial_aeval_X_zero]
  change differentialJet 1 y - Polynomial.eval₂
    (algebraMap (differentialAdjoin F ({h} : Set E)) E)
    (differentialJet 0 y) P = 0
  have hy1 : differentialJet 1 y = y′ := by simp
  rw [hy1, differentialJet_zero, hrel, sub_self]

/-- **Positive source extraction.**  If a hypertranscendental observable satisfies a polynomial
first-order law over the differential field generated by `h`, then `h` is itself
hypertranscendental.  The observation architecture therefore locates an infinite differential
source instead of merely ruling out a finite model. -/
theorem hypertranscendentalOver_input_of_polynomial_firstOrder_output
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hy : HypertranscendentalOver F y)
    (P : Polynomial (differentialAdjoin F ({h} : Set E)))
    (hrel : y′ = Polynomial.eval₂
      (algebraMap (differentialAdjoin F ({h} : Set E)) E) y P) :
    HypertranscendentalOver F h := by
  intro hh
  exact hy (differentialAlgebraicOver_of_polynomial_firstOrder_over_singleton hh P hrel)

/-- The logistic/sigmoid chain identity cannot hide an HT output behind a DA preactivation.
This is also the polynomial response law underlying logistic gene-regulatory models. -/
theorem hypertranscendentalOver_input_of_logistic_chain_law
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hy : HypertranscendentalOver F y)
    (hrel : y′ = h′ * y * (1 - y)) :
    HypertranscendentalOver F h := by
  let S := differentialAdjoin F ({h} : Set E)
  have hdh : h′ ∈ S := by
    have hj := differentialJet_mem_differentialAdjoin F
      (s := ({h} : Set E)) (x := h) rfl 1
    simpa using hj
  let dh : S := ⟨h′, hdh⟩
  let P : Polynomial S := Polynomial.C dh * Polynomial.X * (1 - Polynomial.X)
  apply hypertranscendentalOver_input_of_polynomial_firstOrder_output hy P
  simpa [P, dh] using hrel

/-- The tanh chain identity cannot hide an HT output behind a DA preactivation. -/
theorem hypertranscendentalOver_input_of_tanh_chain_law
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hy : HypertranscendentalOver F y)
    (hrel : y′ = h′ * (1 - y ^ 2)) :
    HypertranscendentalOver F h := by
  let S := differentialAdjoin F ({h} : Set E)
  have hdh : h′ ∈ S := by
    have hj := differentialJet_mem_differentialAdjoin F
      (s := ({h} : Set E)) (x := h) rfl 1
    simpa using hj
  let dh : S := ⟨h′, hdh⟩
  let P : Polynomial S := Polynomial.C dh * (1 - Polynomial.X ^ 2)
  apply hypertranscendentalOver_input_of_polynomial_firstOrder_output hy P
  simpa [P, dh] using hrel

/-- The exponential chain identity cannot hide an HT output behind a DA input. -/
theorem hypertranscendentalOver_input_of_exponential_chain_law
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {h y : E} (hy : HypertranscendentalOver F y)
    (hrel : y′ = h′ * y) :
    HypertranscendentalOver F h := by
  let S := differentialAdjoin F ({h} : Set E)
  have hdh : h′ ∈ S := by
    have hj := differentialJet_mem_differentialAdjoin F
      (s := ({h} : Set E)) (x := h) rfl 1
    simpa using hj
  let dh : S := ⟨h′, hdh⟩
  let P : Polynomial S := Polynomial.C dh * Polynomial.X
  apply hypertranscendentalOver_input_of_polynomial_firstOrder_output hy P
  simpa [P, dh] using hrel

end

end GaloisForLFunctions.HTGeometry
