import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Finite linear differential systems are coordinatewise DA

For a system `y' = A y` of finite width `m`, every jet of every coordinate remains in the
`m`-dimensional span of the original coordinate vector.  The first `m+1` jets therefore satisfy a
nonzero scalar linear differential equation over the coefficient field.  In particular every
coordinate is differentially algebraic over that field.

This is the finite differential defect used by matrix logarithmic-derivative observables: solving
a finite linear system can add initial-condition data, but it cannot add differential
transcendence over the field generated by its coefficient matrix.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

private theorem not_algebraicIndependent_of_finsupp_linearCombination_eq_finiteSystem
    {κ C K L : Type*} [Field C] [Field K] [Field L]
    [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
    (x : κ → L) (c : κ →₀ C) (hc : c ≠ 0) (a : K)
    (hrel :
      Finsupp.linearCombination L x
        (Finsupp.mapRange (algebraMap C L)
          (map_zero (algebraMap C L)) c) = algebraMap K L a) :
    ¬ AlgebraicIndependent K x := by
  classical
  intro hAI
  let P : MvPolynomial κ K :=
    c.sum (fun j r => MvPolynomial.C (algebraMap C K r) * MvPolynomial.X j) -
      MvPolynomial.C a
  have hP : P ≠ 0 := by
    obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp hc
    have hjmem : j ∈ c.support := Finsupp.mem_support_iff.mpr hj
    let e0 : κ → K := fun _ => 0
    let e1 : κ → K := fun i => if i = j then 1 else 0
    intro hzero
    have h0 := congrArg (MvPolynomial.eval e0) hzero
    have h1 := congrArg (MvPolynomial.eval e1) hzero
    rw [map_zero] at h0 h1
    have h0' : -a = 0 := by
      simpa [P, e0, Finsupp.sum] using h0
    have h1' : algebraMap C K (c j) - a = 0 := by
      simpa [P, e1, Finsupp.sum, hj, hjmem] using h1
    have hjK : algebraMap C K (c j) ≠ 0 := by
      simpa using (algebraMap C K).injective.ne hj
    apply hjK
    linear_combination h1' - h0'
  apply hP
  apply hAI.eq_zero_of_aeval_eq_zero
  have hrel' := hrel
  rw [Finsupp.linearCombination_apply,
    Finsupp.sum_mapRange_index (fun _ => by simp)] at hrel'
  simpa [P, Finsupp.sum, IsScalarTower.algebraMap_apply C K L]
    using sub_eq_zero.mpr hrel'

/-- A nonzero linear relation among the first `m+1` jets is already an algebraic dependence of the
complete jet family. -/
theorem differentialAlgebraicOver_of_finite_jet_linearCombination_eq_zero
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {m : ℕ} (x : E) (c : Fin (m + 1) →₀ F) (hc : c ≠ 0)
    (hrel :
      Finsupp.linearCombination E
        (fun r : Fin (m + 1) => differentialJet r.1 x)
        (Finsupp.mapRange (algebraMap F E) (map_zero (algebraMap F E)) c) = 0) :
    DifferentialAlgebraicOver F x := by
  unfold DifferentialAlgebraicOver DifferentialIndependent
  intro hfull
  have hembed : Function.Injective
      (fun r : Fin (m + 1) => ((), r.1) : Fin (m + 1) → Unit × ℕ) := by
    intro r s hrs
    exact Fin.ext (congrArg Prod.snd hrs)
  have hfinite : AlgebraicIndependent F
      (fun r : Fin (m + 1) => differentialJet r.1 x) := by
    simpa [Function.comp_def] using
      hfull.comp (fun r : Fin (m + 1) => ((), r.1)) hembed
  exact (not_algebraicIndependent_of_finsupp_linearCombination_eq_finiteSystem
    (C := F) (K := F) (L := E)
    (fun r : Fin (m + 1) => differentialJet r.1 x) c hc 0 (by simpa using hrel)) hfinite

/-- If the first `m+1` jets of `x` are represented in an `m`-coordinate span, they admit a
nonzero linear relation over the coefficient field. -/
theorem exists_nonzero_finite_jet_linearCombination_eq_zero_of_coordinate_span
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {m : ℕ} (x : E) (y : Fin m → E)
    (C : Fin (m + 1) → Fin m → F)
    (hjet : ∀ r : Fin (m + 1),
      differentialJet r.1 x = ∑ j, algebraMap F E (C r j) * y j) :
    ∃ c : Fin (m + 1) →₀ F, c ≠ 0 ∧
      Finsupp.linearCombination E
        (fun r : Fin (m + 1) => differentialJet r.1 x)
        (Finsupp.mapRange (algebraMap F E) (map_zero (algebraMap F E)) c) = 0 := by
  classical
  have hnot : ¬ LinearIndependent F C := by
    intro hli
    have hcard := hli.fintype_card_le_finrank
    simp at hcard
  obtain ⟨g, hg, z, hgz⟩ := Fintype.not_linearIndependent_iff.mp hnot
  let c : Fin (m + 1) →₀ F := Finsupp.equivFunOnFinite.symm g
  have hc : c ≠ 0 := by
    intro hzero
    apply hgz
    have hz := congrArg (fun f : Fin (m + 1) →₀ F => f z) hzero
    simpa [c] using hz
  have hcoeff : ∀ j : Fin m, ∑ r, g r * C r j = 0 := by
    intro j
    have hj := congrFun hg j
    simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hj
  refine ⟨c, hc, ?_⟩
  rw [Finsupp.linearCombination_apply]
  rw [Finsupp.sum_fintype _ _ (by simp)]
  simp only [c, Finsupp.equivFunOnFinite_symm_apply_apply, Finsupp.mapRange_apply]
  simp only [smul_eq_mul]
  simp_rw [hjet]
  simp_rw [Finset.mul_sum]
  simp_rw [← mul_assoc, ← map_mul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_mul, ← map_sum]
  simp [hcoeff]

/-- Finite jet containment in a strictly smaller coordinate span forces differential
algebraicity. -/
theorem differentialAlgebraicOver_of_finite_jet_coordinate_span
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {m : ℕ} (x : E) (y : Fin m → E)
    (C : Fin (m + 1) → Fin m → F)
    (hjet : ∀ r : Fin (m + 1),
      differentialJet r.1 x = ∑ j, algebraMap F E (C r j) * y j) :
    DifferentialAlgebraicOver F x := by
  obtain ⟨c, hc, hrel⟩ :=
    exists_nonzero_finite_jet_linearCombination_eq_zero_of_coordinate_span
      x y C hjet
  exact differentialAlgebraicOver_of_finite_jet_linearCombination_eq_zero x c hc hrel

/-- Recursive coefficient matrix for the jets of the finite system `y' = A y`. -/
def finiteLinearSystemJetCoefficients
    {F : Type*} [Field F] [Differential F] {m : ℕ}
    (A : Fin m → Fin m → F) : ℕ → Fin m → Fin m → F
  | 0 => fun i j => if i = j then 1 else 0
  | r + 1 => fun i j =>
      (finiteLinearSystemJetCoefficients A r i j)′ +
        ∑ k, finiteLinearSystemJetCoefficients A r i k * A k j

/-- Every jet of a solution coordinate has the recursively predicted expression in the original
coordinate vector. -/
theorem differentialJet_finiteLinearSystem
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {m : ℕ} (A : Fin m → Fin m → F) (y : Fin m → E)
    (hy : ∀ i, (y i)′ = ∑ j, algebraMap F E (A i j) * y j) :
    ∀ (r : ℕ) (i : Fin m),
      differentialJet r (y i) =
        ∑ j, algebraMap F E (finiteLinearSystemJetCoefficients A r i j) * y j := by
  intro r
  induction r with
  | zero =>
      intro i
      simp [differentialJet_zero, finiteLinearSystemJetCoefficients]
  | succ r ih =>
      intro i
      rw [differentialJet_succ, ih i]
      rw [map_sum]
      simp_rw [Derivation.leibniz, DifferentialAlgebra.deriv_algebraMap, hy]
      rw [finiteLinearSystemJetCoefficients]
      simp_rw [map_add, map_sum]
      simp only [smul_eq_mul, Finset.mul_sum, add_mul,
        Finset.sum_add_distrib, Finset.sum_mul]
      simp_rw [← mul_assoc, ← map_mul]
      have hdouble :
          (∑ x, ∑ j,
            algebraMap F E
                (finiteLinearSystemJetCoefficients A r i x * A x j) * y j) =
            ∑ j, ∑ x,
              algebraMap F E
                  (finiteLinearSystemJetCoefficients A r i x * A x j) * y j :=
        Finset.sum_comm
      have hderiv :
          (∑ x, y x *
            algebraMap F E (finiteLinearSystemJetCoefficients A r i x)′) =
            ∑ x, algebraMap F E
              (finiteLinearSystemJetCoefficients A r i x)′ * y x := by
        apply Finset.sum_congr rfl
        intro x hx
        exact mul_comm _ _
      rw [hdouble, hderiv]
      exact add_comm _ _

/-- A coordinate of an `m`-dimensional linear differential system satisfies a nonzero scalar
linear differential equation involving only derivative orders `0,...,m`. -/
theorem exists_nonzero_finite_jet_linearCombination_eq_zero_finiteLinearSystem_coordinate
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {m : ℕ} (A : Fin m → Fin m → F) (y : Fin m → E)
    (hy : ∀ i, (y i)′ = ∑ j, algebraMap F E (A i j) * y j)
    (i : Fin m) :
    ∃ c : Fin (m + 1) →₀ F, c ≠ 0 ∧
      Finsupp.linearCombination E
        (fun r : Fin (m + 1) => differentialJet r.1 (y i))
        (Finsupp.mapRange (algebraMap F E) (map_zero (algebraMap F E)) c) = 0 := by
  apply exists_nonzero_finite_jet_linearCombination_eq_zero_of_coordinate_span
    (x := y i) (y := y)
    (C := fun r j => finiteLinearSystemJetCoefficients A r.1 i j)
  exact fun r => differentialJet_finiteLinearSystem A y hy r.1 i

/-- Every coordinate of a finite linear differential system is differentially algebraic over the
coefficient field. -/
theorem differentialAlgebraicOver_finiteLinearSystem_coordinate
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E]
    {m : ℕ} (A : Fin m → Fin m → F) (y : Fin m → E)
    (hy : ∀ i, (y i)′ = ∑ j, algebraMap F E (A i j) * y j)
    (i : Fin m) :
    DifferentialAlgebraicOver F (y i) := by
  apply differentialAlgebraicOver_of_finite_jet_coordinate_span
    (x := y i) (y := y)
    (C := fun r j => finiteLinearSystemJetCoefficients A r.1 i j)
  exact fun r => differentialJet_finiteLinearSystem A y hy r.1 i

end


end GaloisForLFunctions.HTGeometry
