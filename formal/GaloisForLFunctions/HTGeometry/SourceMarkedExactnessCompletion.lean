import GaloisForLFunctions.HTGeometry.CompletionDefectExactnessFlag

/-!
# Source-marked exactness completion

Ordinary vector convergence can hide a completion anomaly by moving the representative at every
stage.  A source-marked exactness state retains the literal source vector and varies only its
landing in a target exactness flag.  Thus one fixed pre-completion boundary can be followed through
finite truncations, regularizations, and the physical completion.

The topology below is generated by the source-marked survival tests
`landing x ∉ target.boundary`.  Because every landing is required to be a target cycle, these are
exactly framed homology-survival tests.  The construction proves:

* source-marked survival is open;
* exact landing of every vector in a fixed source-boundary space is closed;
* convergence has an explicit pointwise provenance criterion;
* a provenance limit of eventually escape-free source stages is escape-free.

This rules out the moving-generator loophole without imposing a norm on the target quotient.
-/

open Set Topology TopologicalSpace

namespace GaloisForLFunctions.HTGeometry
namespace BoundaryMigration

universe u v

variable (k : Type u) (V W : Type v) [Field k]
variable [AddCommGroup V] [Module k V]
variable [AddCommGroup W] [Module k W]

/-- A target exactness flag together with one source-marked linear landing into its cycle space. -/
structure SourceMarkedExFlag where
  /-- Target boundary/cycle presentation. -/
  target : ExFlag k W
  /-- Completion or specialization map retaining the source marker. -/
  landing : V →ₗ[k] W
  /-- Every landed source vector is an admissible target cycle. -/
  landing_mem_cycle : ∀ x : V, landing x ∈ target.cycle

namespace SourceMarkedExFlag

variable {k V W}

/-- One fixed source marker survives the target boundary after landing. -/
def survival (x : V) : Set (SourceMarkedExFlag k V W) :=
  {s | s.landing x ∉ s.target.boundary}

variable (k V W) in
/-- Subbasis of source-marked provenance tests. -/
def provSubbasis : Set (Set (SourceMarkedExFlag k V W)) :=
  {U | ∃ x : V, U = survival x}

/-- Coarsest topology retaining survival of every fixed source marker. -/
instance instTopologicalSpace : TopologicalSpace (SourceMarkedExFlag k V W) :=
  generateFrom (provSubbasis k V W)

/-- Source-marked survival is open by construction. -/
theorem isOpen_survival (x : V) : IsOpen (survival (k := k) (W := W) x) :=
  isOpen_generateFrom_of_mem ⟨x, rfl⟩

/-- Source-marked survival is literal survival in the target exactness flag. -/
theorem mem_survival_iff_target_survival
    (s : SourceMarkedExFlag k V W) (x : V) :
    s ∈ survival x ↔ s.target ∈ ExFlag.survival (s.landing x) := by
  exact ⟨fun h => ⟨s.landing_mem_cycle x, h⟩, fun h => h.2⟩

/-- States at which one fixed source marker lands as a target boundary. -/
def exactAt (x : V) : Set (SourceMarkedExFlag k V W) :=
  (survival (k := k) (W := W) x)ᶜ

/-- Exact landing of a fixed source marker is closed. -/
theorem isClosed_exactAt (x : V) : IsClosed (exactAt (k := k) (W := W) x) :=
  (isOpen_survival (k := k) (W := W) x).isClosed_compl

/-- Exact landing locus for every member of one fixed source-boundary submodule. -/
def sourceExactLocus (Jsource : Submodule k V) : Set (SourceMarkedExFlag k V W) :=
  ⋂ x : Jsource, exactAt (k := k) (W := W) (x : V)

/-- Membership in the source-exact locus is exactly boundary-migration escape-freedom. -/
theorem mem_sourceExactLocus_iff
    (s : SourceMarkedExFlag k V W) (Jsource : Submodule k V) :
    s ∈ sourceExactLocus Jsource ↔
      EscapeFree s.landing Jsource s.target.boundary := by
  rw [sourceExactLocus, Set.mem_iInter]
  constructor
  · intro h y hy
    obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hy
    have hexact := h ⟨x, hx⟩
    exact not_not.mp hexact
  · intro h x
    show s ∈ (survival (k := k) (W := W) (x : V))ᶜ
    exact not_not.mpr (h (Submodule.mem_map_of_mem x.property))

/-- Escape-freedom for a fixed source-boundary space is closed in marked provenance geometry. -/
theorem isClosed_sourceExactLocus (Jsource : Submodule k V) :
    IsClosed (sourceExactLocus (W := W) Jsource) :=
  isClosed_iInter fun x => isClosed_exactAt (k := k) (W := W) (x : V)

/-- Marked provenance convergence is exactly eventual preservation of every limiting survival
test. -/
theorem tendsto_iff_eventually_survival_tests
    {ι : Type*} {l : Filter ι}
    (stage : ι → SourceMarkedExFlag k V W)
    (physical : SourceMarkedExFlag k V W) :
    Filter.Tendsto stage l (nhds physical) ↔
      ∀ x : V, physical ∈ survival x →
        ∀ᶠ i in l, stage i ∈ survival x := by
  change Filter.Tendsto stage l
      (@nhds (SourceMarkedExFlag k V W) (generateFrom (provSubbasis k V W)) physical) ↔ _
  rw [TopologicalSpace.tendsto_nhds_generateFrom_iff]
  constructor
  · intro h x hx
    have hs := h (survival (k := k) (W := W) x) ⟨x, rfl⟩ hx
    exact hs
  · intro h U
    rintro ⟨x, rfl⟩ hx
    exact h x hx

/-- A marked provenance limit of eventually escape-free source stages is escape-free. -/
theorem escapeFree_of_tendsto
    {ι : Type*} {l : Filter ι} [l.NeBot]
    {stage : ι → SourceMarkedExFlag k V W}
    {physical : SourceMarkedExFlag k V W}
    (Jsource : Submodule k V)
    (hstage : Filter.Tendsto stage l (nhds physical))
    (hexact : ∀ᶠ i in l,
      EscapeFree (stage i).landing Jsource (stage i).target.boundary) :
    EscapeFree physical.landing Jsource physical.target.boundary := by
  apply (mem_sourceExactLocus_iff physical Jsource).1
  apply (isClosed_sourceExactLocus (W := W) Jsource).mem_of_tendsto hstage
  filter_upwards [hexact] with i hi
  exact (mem_sourceExactLocus_iff (stage i) Jsource).2 hi

/-- Moving-generator firewall: an escaping physical source marker forbids convergence from stages
that are eventually escape-free. -/
theorem not_tendsto_of_physical_escape
    {ι : Type*} {l : Filter ι} [l.NeBot]
    {stage : ι → SourceMarkedExFlag k V W}
    {physical : SourceMarkedExFlag k V W}
    (Jsource : Submodule k V)
    (hphysical : ¬EscapeFree physical.landing Jsource physical.target.boundary)
    (hexact : ∀ᶠ i in l,
      EscapeFree (stage i).landing Jsource (stage i).target.boundary) :
    ¬Filter.Tendsto stage l (nhds physical) := by
  intro hstage
  exact hphysical (escapeFree_of_tendsto Jsource hstage hexact)

end SourceMarkedExFlag
end BoundaryMigration
end GaloisForLFunctions.HTGeometry
