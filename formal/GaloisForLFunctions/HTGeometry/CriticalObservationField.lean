import GaloisForLFunctions.HTGeometry.PostcriticalNotMemField
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

/-!
# Actual critical observation and source function fields

The generic jet algebra at order `m+n` contains one postcritical raw coordinate.  Inside its
fraction field, the critical source field is generated by the raw coordinates through order
`m+n-1`; the critical observation field is generated by the raw tail from `m` and reciprocal tail
from `n`, both ending at `m+n-1`.

These are concrete intermediate fields, not abstract cover data.  The reciprocal recursion proves
that every critical reciprocal coordinate belongs to the critical source field, so the observation
field is an actual subfield of the rational source field.  This is the function-field surface on
which geometric monodromy and postcritical primitivity must be stated.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Canonical inclusion of the generic jet algebra into its fraction field. -/
noncomputable def genericJetFieldMap (K : Type*) [Field K] (N : ℕ) :
    genericJetAlgebra K N →ₐ[K] genericJetField K N :=
  IsScalarTower.toAlgHom K (genericJetAlgebra K N) (genericJetField K N)

theorem genericJetFieldMap_injective (K : Type*) [Field K] (N : ℕ) :
    Function.Injective (genericJetFieldMap K N) :=
  IsFractionRing.injective (genericJetAlgebra K N) (genericJetField K N)

/-- Raw coordinate of the order-`m+n` generic jet, viewed in its function field. -/
noncomputable def criticalAmbientRaw (K : Type*) [Field K] (m n j : ℕ) :
    genericJetField K (m + n) :=
  genericJetFieldMap K (m + n) (genericRaw K (m + n) j)

/-- Reciprocal coordinate of the order-`m+n` generic jet, viewed in its function field. -/
noncomputable def criticalAmbientRecip (K : Type*) [Field K] (m n j : ℕ) :
    genericJetField K (m + n) :=
  genericJetFieldMap K (m + n) (genericRecip K (m + n) j)

/-- Actual critical observation inside the generic jet function field. -/
noncomputable def criticalFieldObservation (K : Type*) [Field K] (m n : ℕ) :
    Fin n ⊕ Fin m → genericJetField K (m + n)
  | Sum.inl i => criticalAmbientRaw K m n (m + (i : ℕ))
  | Sum.inr j => criticalAmbientRecip K m n (n + (j : ℕ))

/-! ## The two actual function fields are rational -/

/-- The critical observation coordinates inside the augmented observation that also contains the
first postcritical raw coordinate. -/
def criticalObservationIndex (m n : ℕ) : Fin n ⊕ Fin m → Fin (n + 1) ⊕ Fin m
  | Sum.inl i => Sum.inl i.castSucc
  | Sum.inr j => Sum.inr j

theorem criticalObservationIndex_injective (m n : ℕ) :
    Function.Injective (criticalObservationIndex m n) := by
  rintro (i | j) (i' | j') h <;> simp only [criticalObservationIndex] at h
  · apply congrArg Sum.inl
    exact (Fin.castSucc_injective n) (Sum.inl_injective h)
  · simp at h
  · simp at h
  · exact congrArg Sum.inr (by simpa using h)

/-- **The augmented generic observation is algebraically independent.**  Any polynomial relation
would give a forbidden rational expression for the postcritical reciprocal coefficient: use that
relation as a nonzero denominator and zero as numerator in the unconditional escape theorem. -/
theorem algebraicIndependent_genericObservation
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    AlgebraicIndependent K (genericObservation K m n) := by
  rw [algebraicIndependent_iff_injective_aeval]
  intro P Q hPQ
  by_contra hne
  have hsub : P - Q ≠ 0 := sub_ne_zero.mpr hne
  have hzero : MvPolynomial.aeval (genericObservation K m n) (P - Q) = 0 := by
    rw [map_sub, hPQ, sub_self]
  have hescape := postcritical_escapes_criticalField K hm hn 0 (P - Q) hsub
  simp [hzero] at hescape

/-- **The actual critical observation coordinates are algebraically independent.**  They form the
critical subfamily of the augmented generic observation, and the canonical map to the generic jet
function field is injective. -/
theorem algebraicIndependent_criticalFieldObservation
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    AlgebraicIndependent K (criticalFieldObservation K m n) := by
  have hsub := (algebraicIndependent_genericObservation K hm hn).comp
    (criticalObservationIndex m n) (criticalObservationIndex_injective m n)
  have hmap := hsub.map' (genericJetFieldMap_injective K (m + n))
  convert hmap using 1
  funext s
  rcases s with i | j
  · simp [criticalFieldObservation, criticalObservationIndex, genericObservation,
      criticalAmbientRaw, Function.comp_def, i.isLt]
  · simp [criticalFieldObservation, criticalObservationIndex, genericObservation,
      criticalAmbientRecip, Function.comp_def]

/-- All raw coordinates of a generic jet, viewed in its fraction field, are algebraically
independent.  Inverting the nonzero constant coordinate and then passing to the fraction field does
not create a polynomial relation. -/
theorem algebraicIndependent_genericAmbientRaw
    (K : Type*) [Field K] (N : ℕ) :
    AlgebraicIndependent K
      (fun i : Fin (N + 1) => genericJetFieldMap K N (genericRaw K N (i : ℕ))) := by
  have hloc : Function.Injective
      (algebraMap (genericJetRing K N) (genericJetAlgebra K N)) :=
    IsLocalization.injective (genericJetAlgebra K N)
      (powers_le_nonZeroDivisors_of_noZeroDivisors
        (MvPolynomial.X_ne_zero (R := K) (0 : Fin (N + 1))))
  have hX := (MvPolynomial.algebraicIndependent_X (Fin (N + 1)) K).map'
    (f := IsScalarTower.toAlgHom K (genericJetRing K N) (genericJetAlgebra K N)) hloc
  have hfield := hX.map' (f := genericJetFieldMap K N) (genericJetFieldMap_injective K N)
  convert hfield using 1
  funext i
  rw [genericRaw, dif_pos i.isLt]

/-- **The actual critical source coordinates are algebraically independent.** -/
theorem algebraicIndependent_criticalAmbientRaw
    (K : Type*) [Field K] (m n : ℕ) :
    AlgebraicIndependent K
      (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ)) := by
  have h := (algebraicIndependent_genericAmbientRaw K (m + n)).comp
    (fun j : Fin (m + n) => j.castSucc) (Fin.castSucc_injective (m + n))
  simpa [criticalAmbientRaw, Function.comp_def] using h

/-- Function field generated by the critical raw/reciprocal observation. -/
noncomputable def criticalObservationField (K : Type*) [Field K] (m n : ℕ) :
    IntermediateField K (genericJetField K (m + n)) :=
  IntermediateField.adjoin K (Set.range (criticalFieldObservation K m n))

/-- Rational critical source field, excluding the one new raw coordinate at order `m+n`. -/
noncomputable def criticalSourceField (K : Type*) [Field K] (m n : ℕ) :
    IntermediateField K (genericJetField K (m + n)) :=
  IntermediateField.adjoin K
    (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ)))

/-- **Rational presentation of the actual critical observation field.** -/
noncomputable def criticalObservationFieldEquiv
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    FractionRing (MvPolynomial (Fin n ⊕ Fin m) K) ≃ₐ[K]
      criticalObservationField K m n := by
  exact (algebraicIndependent_criticalFieldObservation K hm hn).aevalEquivField.trans
    (IntermediateField.equivOfEq (by rfl))

/-- **Rational presentation of the actual critical source field.** -/
noncomputable def criticalSourceFieldEquiv
    (K : Type*) [Field K] (m n : ℕ) :
    FractionRing (MvPolynomial (Fin (m + n)) K) ≃ₐ[K]
      criticalSourceField K m n := by
  exact (algebraicIndependent_criticalAmbientRaw K m n).aevalEquivField.trans
    (IntermediateField.equivOfEq (by rfl))

/-- Every raw coordinate strictly below the postcritical order lies in the critical source field. -/
theorem criticalAmbientRaw_mem_criticalSourceField
    (K : Type*) [Field K] {m n j : ℕ} (hj : j < m + n) :
    criticalAmbientRaw K m n j ∈ criticalSourceField K m n := by
  apply IntermediateField.subset_adjoin K
  exact ⟨(⟨j, hj⟩ : Fin (m + n)), rfl⟩

/-- Every reciprocal coordinate strictly below the postcritical order lies in the critical source
field.  This is the inverse recurrence carried out inside the actual fraction field. -/
theorem criticalAmbientRecip_mem_criticalSourceField
    (K : Type*) [Field K] {m n : ℕ} :
    ∀ {j : ℕ}, j < m + n →
      criticalAmbientRecip K m n j ∈ criticalSourceField K m n := by
  intro j
  induction j using Nat.strong_induction_on with
  | h j ih =>
      intro hj
      match j with
      | 0 =>
          have hmul := congrArg (genericJetFieldMap K (m + n))
            (genericRaw_zero_mul_inv K (m + n))
          rw [map_mul, map_one] at hmul
          have hraw : criticalAmbientRaw K m n 0 ∈ criticalSourceField K m n :=
            criticalAmbientRaw_mem_criticalSourceField K hj
          have hinv : criticalAmbientRecip K m n 0 =
              (criticalAmbientRaw K m n 0)⁻¹ := by
            apply eq_inv_of_mul_eq_one_right
            simpa [criticalAmbientRaw, criticalAmbientRecip, genericRecip] using hmul
          rw [hinv]
          exact (criticalSourceField K m n).inv_mem hraw
      | k + 1 =>
          rw [criticalAmbientRecip, genericRecip, map_mul, map_neg, map_sum]
          refine (criticalSourceField K m n).mul_mem
            ((criticalSourceField K m n).neg_mem ?_) ?_
          · simpa [criticalAmbientRecip, genericRecip] using
              (ih 0 (by omega) (by omega : 0 < m + n))
          · refine (criticalSourceField K m n).sum_mem fun i hi => ?_
            rw [map_mul]
            refine (criticalSourceField K m n).mul_mem ?_ ?_
            · simpa [criticalAmbientRaw] using
                (criticalAmbientRaw_mem_criticalSourceField K
                  (j := i + 1) (by
                    have hi' := Finset.mem_range.1 hi
                    omega))
            · simpa [criticalAmbientRecip] using
                (ih (k - i) (by
                  have hi' := Finset.mem_range.1 hi
                  omega) (by omega))

/-- The critical observation field is contained in the actual critical source field. -/
theorem criticalObservationField_le_criticalSourceField
    (K : Type*) [Field K] {m n : ℕ} :
    criticalObservationField K m n ≤ criticalSourceField K m n := by
  rw [criticalObservationField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨s, rfl⟩
  rcases s with i | j
  · exact criticalAmbientRaw_mem_criticalSourceField K (by omega)
  · exact criticalAmbientRecip_mem_criticalSourceField K (by omega)

/-- The new raw and reciprocal coordinates at order `m+n`. -/
noncomputable def postcriticalRawFieldElement (K : Type*) [Field K] (m n : ℕ) :
    genericJetField K (m + n) := criticalAmbientRaw K m n (m + n)

noncomputable def postcriticalReciprocalFieldElement (K : Type*) [Field K] (m n : ℕ) :
    genericJetField K (m + n) := criticalAmbientRecip K m n (m + n)

/-- **The new raw coordinate is transcendental over the actual critical source field.**  The full
generic raw family is algebraically independent.  Removing its last coordinate gives exactly the
critical source generators, and adjoining their fraction field preserves transcendence of the last
coordinate. -/
theorem postcriticalRawFieldElement_transcendental_criticalSourceField
    (K : Type*) [Field K] (m n : ℕ) :
    Transcendental (criticalSourceField K m n) (postcriticalRawFieldElement K m n) := by
  classical
  let x : Fin (m + n + 1) → genericJetField K (m + n) := fun i =>
    genericJetFieldMap K (m + n) (genericRaw K (m + n) (i : ℕ))
  let s : Set (Fin (m + n + 1)) := Set.range (fun j : Fin (m + n) => j.castSucc)
  have hlast : Fin.last (m + n) ∉ s := by
    rintro ⟨j, hj⟩
    exact Fin.castSucc_ne_last j hj
  have htrans := (algebraicIndependent_genericAmbientRaw K (m + n)).transcendental_adjoin hlast
  have hset : x '' s =
      Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ)) := by
    ext z
    constructor
    · rintro ⟨i, ⟨j, rfl⟩, rfl⟩
      exact ⟨j, rfl⟩
    · rintro ⟨j, rfl⟩
      exact ⟨j.castSucc, ⟨j, rfl⟩, rfl⟩
  rw [hset] at htrans
  have htrans' : Transcendental
      (Algebra.adjoin K
        (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ))))
      (postcriticalRawFieldElement K m n) := by
    simpa [postcriticalRawFieldElement, criticalAmbientRaw] using htrans
  change Transcendental
    (IntermediateField.adjoin K
      (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ))))
    (postcriticalRawFieldElement K m n)
  open scoped IntermediateField.algebraAdjoinAdjoin in
    exact fun halg => htrans' ((IsFractionRing.isAlgebraic_iff
      (Algebra.adjoin K
        (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ))))
      (IntermediateField.adjoin K
        (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ))))
      (genericJetField K (m + n))).2 halg)

/-- The canonical fraction-field map is the underlying map of `genericJetEquiv`. -/
theorem genericJetFieldMap_eq_coe_genericJetEquiv
    (K : Type*) [Field K] (N : ℕ) (x : genericJetAlgebra K N) :
    genericJetFieldMap K N x =
      ((genericJetEquiv K N x : genericJetSubalgebra K N) : genericJetField K N) :=
  rfl

/-- The actual critical field together with the first new raw coordinate is contained in the
field generated by the augmented observation used by the unconditional deformation argument. -/
theorem criticalObservation_sup_postcriticalRaw_le_augmentedObservationField
    (K : Type*) [Field K] {m n : ℕ} :
    criticalObservationField K m n ⊔
        IntermediateField.adjoin K {postcriticalRawFieldElement K m n} ≤
      IntermediateField.adjoin K
        (((↑) '' (Set.range (fun s =>
          genericJetEquiv K (m + n) (genericObservation K m n s)))) :
          Set (genericJetField K (m + n))) := by
  classical
  apply sup_le
  · rw [criticalObservationField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨s, rfl⟩
    apply IntermediateField.subset_adjoin K
    rcases s with i | j
    · refine ⟨(genericJetEquiv K (m + n)
          (genericObservation K m n (Sum.inl i.castSucc)) :
          genericJetSubalgebra K (m + n)), ?_, ?_⟩
      · exact ⟨Sum.inl i.castSucc, rfl⟩
      · simp [criticalFieldObservation, criticalAmbientRaw,
          genericJetFieldMap_eq_coe_genericJetEquiv, genericObservation]
    · refine ⟨(genericJetEquiv K (m + n)
          (genericObservation K m n (Sum.inr j)) :
          genericJetSubalgebra K (m + n)), ?_, ?_⟩
      · exact ⟨Sum.inr j, rfl⟩
      · simp [criticalFieldObservation, criticalAmbientRecip,
          genericJetFieldMap_eq_coe_genericJetEquiv, genericObservation]
  · rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    apply IntermediateField.subset_adjoin K
    refine ⟨(genericJetEquiv K (m + n)
        (genericObservation K m n (Sum.inl (Fin.last n))) :
        genericJetSubalgebra K (m + n)), ?_, ?_⟩
    · exact ⟨Sum.inl (Fin.last n), rfl⟩
    · simp [postcriticalRawFieldElement, criticalAmbientRaw,
        genericJetFieldMap_eq_coe_genericJetEquiv, genericObservation]

/-- **Actual postcritical field escape.**  The first new reciprocal coefficient is outside the
field obtained by adjoining the actual critical observation and the first new raw coefficient. -/
theorem postcriticalReciprocalFieldElement_notMem_criticalObservation_sup_raw
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    postcriticalReciprocalFieldElement K m n ∉
      criticalObservationField K m n ⊔
        IntermediateField.adjoin K {postcriticalRawFieldElement K m n} := by
  intro hmem
  apply postcritical_notMem_criticalField K hm hn
  apply criticalObservation_sup_postcriticalRaw_le_augmentedObservationField K hmem

end

end GaloisForLFunctions.HTGeometry
