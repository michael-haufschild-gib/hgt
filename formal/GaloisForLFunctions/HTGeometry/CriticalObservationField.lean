import GaloisForLFunctions.HTGeometry.PostcriticalNotMemField

/-!
# Actual critical observation and source function fields

The generic jet algebra at order `m+n` contains one postcritical raw coordinate.  Inside its
fraction field, the critical source field is generated by the raw coordinates through order
`m+n-1`; the critical observation field is generated by the raw tail from `m` and reciprocal tail
from `n`, both ending at `m+n-1`.

These are concrete intermediate fields, not abstract cover data.  The reciprocal recursion proves
that every critical reciprocal coordinate belongs to the critical source field, so the observation
field is an actual subfield of the rational source field.  This is the function-field surface on
which geometric monodromy and postcritical primitivity must be stated.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Canonical inclusion of the generic jet algebra into its fraction field. -/
noncomputable def genericJetFieldMap (K : Type*) [Field K] (N : ℕ) :
    genericJetAlgebra K N →ₐ[K] genericJetField K N :=
  IsScalarTower.toAlgHom K (genericJetAlgebra K N) (genericJetField K N)

theorem genericJetFieldMap_injective (K : Type*) [Field K] (N : ℕ) :
    Function.Injective (genericJetFieldMap K N) :=
  IsFractionRing.injective (genericJetAlgebra K N) (genericJetField K N)

/-- Raw coordinate of the order-`m+n` generic jet, viewed in its function field. -/
noncomputable def criticalAmbientRaw (K : Type*) [Field K] (m n j : ℕ) :
    genericJetField K (m + n) :=
  genericJetFieldMap K (m + n) (genericRaw K (m + n) j)

/-- Reciprocal coordinate of the order-`m+n` generic jet, viewed in its function field. -/
noncomputable def criticalAmbientRecip (K : Type*) [Field K] (m n j : ℕ) :
    genericJetField K (m + n) :=
  genericJetFieldMap K (m + n) (genericRecip K (m + n) j)

/-- Actual critical observation inside the generic jet function field. -/
noncomputable def criticalFieldObservation (K : Type*) [Field K] (m n : ℕ) :
    Fin n ⊕ Fin m → genericJetField K (m + n)
  | Sum.inl i => criticalAmbientRaw K m n (m + (i : ℕ))
  | Sum.inr j => criticalAmbientRecip K m n (n + (j : ℕ))

/-- Function field generated by the critical raw/reciprocal observation. -/
noncomputable def criticalObservationField (K : Type*) [Field K] (m n : ℕ) :
    IntermediateField K (genericJetField K (m + n)) :=
  IntermediateField.adjoin K (Set.range (criticalFieldObservation K m n))

/-- Rational critical source field, excluding the one new raw coordinate at order `m+n`. -/
noncomputable def criticalSourceField (K : Type*) [Field K] (m n : ℕ) :
    IntermediateField K (genericJetField K (m + n)) :=
  IntermediateField.adjoin K
    (Set.range (fun j : Fin (m + n) => criticalAmbientRaw K m n (j : ℕ)))

/-- Every raw coordinate strictly below the postcritical order lies in the critical source field. -/
theorem criticalAmbientRaw_mem_criticalSourceField
    (K : Type*) [Field K] {m n j : ℕ} (hj : j < m + n) :
    criticalAmbientRaw K m n j ∈ criticalSourceField K m n := by
  apply IntermediateField.subset_adjoin K
  exact ⟨(⟨j, hj⟩ : Fin (m + n)), rfl⟩

/-- Every reciprocal coordinate strictly below the postcritical order lies in the critical source
field.  This is the inverse recurrence carried out inside the actual fraction field. -/
theorem criticalAmbientRecip_mem_criticalSourceField
    (K : Type*) [Field K] {m n : ℕ} :
    ∀ {j : ℕ}, j < m + n →
      criticalAmbientRecip K m n j ∈ criticalSourceField K m n := by
  intro j
  induction j using Nat.strong_induction_on with
  | h j ih =>
      intro hj
      match j with
      | 0 =>
          have hmul := congrArg (genericJetFieldMap K (m + n))
            (genericRaw_zero_mul_inv K (m + n))
          rw [map_mul, map_one] at hmul
          have hraw : criticalAmbientRaw K m n 0 ∈ criticalSourceField K m n :=
            criticalAmbientRaw_mem_criticalSourceField K hj
          have hinv : criticalAmbientRecip K m n 0 =
              (criticalAmbientRaw K m n 0)⁻¹ := by
            apply eq_inv_of_mul_eq_one_right
            simpa [criticalAmbientRaw, criticalAmbientRecip, genericRecip] using hmul
          rw [hinv]
          exact (criticalSourceField K m n).inv_mem hraw
      | k + 1 =>
          rw [criticalAmbientRecip, genericRecip, map_mul, map_neg, map_sum]
          refine (criticalSourceField K m n).mul_mem
            ((criticalSourceField K m n).neg_mem ?_) ?_
          · simpa [criticalAmbientRecip, genericRecip] using
              (ih 0 (by omega) (by omega : 0 < m + n))
          · refine (criticalSourceField K m n).sum_mem fun i hi => ?_
            rw [map_mul]
            refine (criticalSourceField K m n).mul_mem ?_ ?_
            · simpa [criticalAmbientRaw] using
                (criticalAmbientRaw_mem_criticalSourceField K
                  (j := i + 1) (by
                    have hi' := Finset.mem_range.1 hi
                    omega))
            · simpa [criticalAmbientRecip] using
                (ih (k - i) (by
                  have hi' := Finset.mem_range.1 hi
                  omega) (by omega))

/-- The critical observation field is contained in the actual critical source field. -/
theorem criticalObservationField_le_criticalSourceField
    (K : Type*) [Field K] {m n : ℕ} :
    criticalObservationField K m n ≤ criticalSourceField K m n := by
  rw [criticalObservationField, IntermediateField.adjoin_le_iff]
  rintro _ ⟨s, rfl⟩
  rcases s with i | j
  · exact criticalAmbientRaw_mem_criticalSourceField K (by omega)
  · exact criticalAmbientRecip_mem_criticalSourceField K (by omega)

/-- The new raw and reciprocal coordinates at order `m+n`. -/
noncomputable def postcriticalRawFieldElement (K : Type*) [Field K] (m n : ℕ) :
    genericJetField K (m + n) := criticalAmbientRaw K m n (m + n)

noncomputable def postcriticalReciprocalFieldElement (K : Type*) [Field K] (m n : ℕ) :
    genericJetField K (m + n) := criticalAmbientRecip K m n (m + n)

end

end GaloisForLFunctions.HTGeometry
