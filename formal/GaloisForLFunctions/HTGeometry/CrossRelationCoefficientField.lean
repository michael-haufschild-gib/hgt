import GaloisForLFunctions.HTGeometry.DifferentialLurothComponentTransfer
import GaloisForLFunctions.HTGeometry.MvPolynomialCoefficientDescent

/-!
# The coefficient cross-relation lives over two coefficients

The cross-relation built from two characteristic coefficients has, by construction, coefficients of
the form `q · a - p · b` with `a`, `b` in the base field.  So all of its coefficients lie in the field
generated by those two coefficients, and it therefore descends to that field.

This is the step which replaces an intermediate field by a field generated by finitely many explicit
elements — the move a Lüroth argument makes before comparing ranks.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- **The cross-relation has coefficients in the field generated by the two entries.** -/
theorem coeff_crossRelation_mem_adjoin (G : IntermediateField F E) (p q : G)
    (P Q : DifferentialPolynomial Unit F) (m : (Unit × ℕ) →₀ ℕ) :
    (((differentialCharacteristicCoefficientCrossRelation G p q P Q).coeff m : G) : E)
      ∈ IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) := by
  classical
  have hcoeff : ((differentialCharacteristicCoefficientCrossRelation G p q P Q).coeff m : G)
      = q * algebraMap F G (P.coeff m) - p * algebraMap F G (Q.coeff m) := by
    rw [differentialCharacteristicCoefficientCrossRelation, MvPolynomial.coeff_sub,
      MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map,
      MvPolynomial.coeff_map]
  rw [hcoeff]
  have hp : (p : E) ∈ IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) :=
    IntermediateField.subset_adjoin F _ (by simp)
  have hq : (q : E) ∈ IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) :=
    IntermediateField.subset_adjoin F _ (by simp)
  have hPm : (algebraMap F E (P.coeff m))
      ∈ IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) :=
    (IntermediateField.adjoin F ({(p : E), (q : E)} : Set E)).algebraMap_mem _
  have hQm : (algebraMap F E (Q.coeff m))
      ∈ IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) :=
    (IntermediateField.adjoin F ({(p : E), (q : E)} : Set E)).algebraMap_mem _
  have hpush : ((q * algebraMap F G (P.coeff m) - p * algebraMap F G (Q.coeff m) : G) : E)
      = (q : E) * algebraMap F E (P.coeff m) - (p : E) * algebraMap F E (Q.coeff m) := by
    push_cast
    rfl
  rw [hpush]
  exact sub_mem (mul_mem hq hPm) (mul_mem hp hQm)

/-- **The cross-relation descends to the field generated by the two entries.** -/
theorem crossRelation_descends (G : IntermediateField F E) (p q : G)
    (P Q : DifferentialPolynomial Unit F)
    (hle : IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) ≤ G) :
    MvPolynomial.map
        (IntermediateField.inclusion hle :
          IntermediateField.adjoin F ({(p : E), (q : E)} : Set E) →ₐ[F] G).toRingHom
        (HTGeometry.descendCoefficients hle
          (differentialCharacteristicCoefficientCrossRelation G p q P Q)
          (coeff_crossRelation_mem_adjoin G p q P Q))
      = differentialCharacteristicCoefficientCrossRelation G p q P Q :=
  HTGeometry.map_descendCoefficients _ _ _

end

end GaloisForLFunctions
