import GaloisForLFunctions.HTGeometry.PrimeClockUniformAnnihilatorInverseLimit

/-!
# Operational torsion at invariant prime-profile inverse limits

Complete Grassmann meets identify the field represented by an intersection of invariant
prime-profile sources.  The invariant-source differential-adjunction theorem identifies that same
field as an operationally generated differential field.  Consequently inverse-limit relative
differential algebraicity is exactly one finite clock annihilator valid at every stage.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

/-- Differential generation by the intersection source commutes with arbitrary nonempty
intersections of invariant represented prime-profile fields. -/
theorem differentialAdjoin_primeProfileInvariantIntersectionSource_eq_iInf
    {ι : Type*} [Nonempty ι]
    (W : ι → Submodule ℂ PrimeProfileClockQuotient)
    (hW : ∀ i, PrimeProfileClockInvariant (W i)) :
    GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
        (Set.range (fun j => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField
          (primeProfileGrassmannSource (⨅ i, W i) j))) =
      ⨅ i, primeProfileGrassmannField (W i) := by
  rw [differentialAdjoin_grassmannSource_eq_grassmannField
    (⨅ i, W i) (PrimeProfileClockInvariant.iInf W hW)]
  exact (primeProfileGrassmannField_iInf W).symm

/-- **Invariant inverse-limit operational-torsion law.**  The exact inverse-limit field is the
differential field generated by the intersection source, and an admissible prime profile is
differentially algebraic over it exactly when one nonzero finite clock certificate annihilates it
inside every stage source. -/
theorem primeProfileInvariantInverseLimit_operationalTorsionUniversality
    {ι : Type*} [Nonempty ι]
    (W : ι → Submodule ℂ PrimeProfileClockQuotient)
    (hW : ∀ i, PrimeProfileClockInvariant (W i))
    (f : ArithmeticFunction ℂ)
    (hfsupport : PrimeProfileSupportedOnPositivePrimePowers f) :
    let Flimit := GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
      (Set.range (fun j => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField
        (primeProfileGrassmannSource (⨅ i, W i) j)))
    Flimit = (⨅ i, primeProfileGrassmannField (W i)) ∧
      (GaloisForLFunctions.DifferentialAlgebraicOver
          ↥Flimit
          (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField f) ↔
        ∃ a : Unit × Nat →₀ ℂ, a ≠ 0 ∧
          ∀ i, a ∈ primeProfileClockCertificateSpace (W i) f) := by
  dsimp only
  have hfield :=
    differentialAdjoin_primeProfileInvariantIntersectionSource_eq_iInf W hW
  refine ⟨hfield, ?_⟩
  rw [hfield]
  exact differentialAlgebraic_over_primeProfileGrassmannField_iInf_iff_uniformCertificate
    W hW f hfsupport

end

end GaloisForLFunctions.HTGeometry
