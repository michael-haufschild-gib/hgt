import GaloisForLFunctions.HTGeometry.NonautonomousRamifiedPuiseuxCascadeActual

/-!
# Obstruction to a full-relative-closure Puiseux branch map

`NonautonomousRamifiedPuiseuxBranchSelection` asks one finitely ramified Hahn fraction field to
receive the full relative algebraic closure of the actual cascade state field.  This is too strong,
already for the one-layer exponential cascade.  That relative algebraic closure contains
`exp (z / m)` for every positive `m`, whereas a fixed coordinate `s ^ (-r)` in an integer-valued
Hahn field has an `m`-th root only when `m` divides `r`.

The closed theorem below proves that the current selection structure is uninhabited for the
exponential cascade.  It does not contradict the cascade order theorem (which is already known at
length one); it isolates why the full-relative-closure selection structure cannot serve as the
unconditional analytic-selection bridge.  A replacement must restrict the source to the finite
field generated by the selected velocity branches, or enlarge the target value group to its
divisible hull.
-/

open Filter Set Topology

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher HahnSeries

noncomputable section

local instance cascadeSelectionObstructionDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

noncomputable local instance cascadeSelectionObstructionRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).toAlgebra

noncomputable local instance cascadeSelectionObstructionComplexAlgebra :
    Algebra ℂ (meroField (Set.univ : Set ℂ)) :=
  ((ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).comp (algebraMap ℂ (RatFunc ℂ))).toAlgebra

/-- A fixed ramification index cannot absorb a root of the terminal state whose order is larger
than that index.  This is the integer-value-group obstruction used by the exponential example. -/
private theorem selection_no_root_above_ramification
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (sel : NonautonomousRamifiedPuiseuxBranchSelection hfan 1)
    {m : ℕ} (hm : sel.r 0 < m)
    (y : NonautonomousRamifiedCascadeBranchField hfan 1)
    (hy : y ^ m = nonautonomousRamifiedCascadeStateInBranchField hfan 0) : False := by
  have hm0 : 0 < m := lt_of_lt_of_le (sel.ramification_pos 0) (Nat.le_of_lt hm)
  have hpow : (sel.branchMap y) ^ m =
      hahnFractionRamCoordinateBase (RatFunc ℂ) sel.r 0 := by
    rw [← map_pow, hy, sel.branchMap_state]
  have hv := congrArg
    (hahnFractionAddValuation (Γ := mgDeg 1) (R := RatFunc ℂ)) hpow
  rw [AddValuation.map_pow, hahnFractionRamCoordinateBase,
    hahnFractionAddValuation_algebraMap] at hv
  have hsingle :
      (HahnSeries.addVal (mgDeg 1) (RatFunc ℂ))
          (HahnSeries.single (mgRamUnit sel.r 0) 1) =
        (mgRamUnit sel.r 0 : WithTop (mgDeg 1)) := by
    simp [HahnSeries.addVal_apply_of_ne]
  rw [hsingle] at hv
  rcases eq_or_ne
      (hahnFractionAddValuation (Γ := mgDeg 1) (R := RatFunc ℂ) (sel.branchMap y)) ⊤
      with htop | htop
  · rw [htop] at hv
    obtain ⟨q, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hm0)
    rw [succ_nsmul, add_top] at hv
    exact (WithTop.coe_ne_top :
      (mgRamUnit sel.r 0 : WithTop (mgDeg 1)) ≠ ⊤) hv.symm
  · obtain ⟨d, hd⟩ := WithTop.ne_top_iff_exists.mp htop
    rw [← hd] at hv
    have hdeg : m • d = mgRamUnit sel.r 0 := by
      exact_mod_cast hv
    have hcoord := congrArg (fun e : mgDeg 1 => ofLex e 0) hdeg
    change m • ofLex d 0 = -(sel.r 0 : ℤ) at hcoord
    rw [nsmul_eq_mul] at hcoord
    have hdvdInt : (m : ℤ) ∣ (sel.r 0 : ℤ) := by
      refine ⟨-(ofLex d 0), ?_⟩
      calc
        (sel.r 0 : ℤ) = -((m : ℤ) * ofLex d 0) := by rw [hcoord]; simp
        _ = (m : ℤ) * -(ofLex d 0) := by ring
    have hdvd : m ∣ sel.r 0 := by exact_mod_cast hdvdInt
    have hmle : m ≤ sel.r 0 := Nat.le_of_dvd (sel.ramification_pos 0) hdvd
    omega

/-- Canonical entire witness for the constant exponential family. -/
theorem exponentialCascade_analyticOnNhd :
    ∀ i : ℕ, AnalyticOnNhd ℂ ((fun _ : ℕ => Complex.exp) i) Set.univ :=
  fun _ => DifferentiableOn.analyticOnNhd
    (fun z _ => (Complex.differentiable_exp z).differentiableWithinAt) isOpen_univ

/-- **The current full-relative-closure Puiseux selection is uninhabited even for one
exponential layer.** -/
theorem not_nonempty_nonautonomousRamifiedPuiseuxBranchSelection_exp_one :
    ¬ Nonempty (NonautonomousRamifiedPuiseuxBranchSelection
      exponentialCascade_analyticOnNhd 1) := by
  rintro ⟨sel⟩
  let m : ℕ := sel.r 0 + 1
  have hm0 : 0 < m := by simp [m]
  have hm : sel.r 0 < m := by simp [m]
  let c : ℂ := (m : ℂ)⁻¹
  let P : ℂ → ℂ := fun z => c * z
  have hP : AnalyticOnNhd ℂ P Set.univ := analyticOnNhd_const.mul analyticOnNhd_id
  let g : ℂ → ℂ := fun z => Complex.exp (P z)
  have hg : AnalyticOnNhd ℂ g Set.univ := hP.cexp
  let gM : meroField (Set.univ : Set ℂ) := analyticMeroElement g hg
  have hgpow : gM ^ m = cascadeMero exponentialCascade_analyticOnNhd 1 := by
    rw [← analyticMeroElement_pow hg m]
    apply analyticMeroElement_congr
    funext z
    change Complex.exp (c * z) ^ m = Complex.exp z
    rw [← Complex.exp_nat_mul]
    congr 1
    dsimp [c]
    field_simp [Nat.cast_ne_zero.mpr (Nat.ne_of_gt hm0)]
  let E := NonautonomousRamifiedCascadeStateField exponentialCascade_analyticOnNhd 1
  let xE : E := ⟨cascadeMero exponentialCascade_analyticOnNhd 1,
    IntermediateField.subset_adjoin ℂ _
      (Set.mem_range_self (⟨1, by omega⟩ : Fin 2))⟩
  have hgIntegral : IsIntegral E gM := by
    refine ⟨Polynomial.X ^ m - Polynomial.C xE,
      Polynomial.monic_X_pow_sub_C xE (Nat.ne_of_gt hm0), ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C]
    change gM ^ m - cascadeMero exponentialCascade_analyticOnNhd 1 = 0
    rw [hgpow, sub_self]
  let y : NonautonomousRamifiedCascadeBranchField exponentialCascade_analyticOnNhd 1 :=
    ⟨gM, mem_algebraicClosure_iff.mpr hgIntegral.isAlgebraic⟩
  apply selection_no_root_above_ramification exponentialCascade_analyticOnNhd sel hm y
  apply Subtype.ext
  change gM ^ m = nonautonomousRamifiedCascadeState exponentialCascade_analyticOnNhd 0
  rw [nonautonomousRamifiedCascadeState_zero exponentialCascade_analyticOnNhd 0]
  exact hgpow

end

end GaloisForLFunctions.HTGeometry
