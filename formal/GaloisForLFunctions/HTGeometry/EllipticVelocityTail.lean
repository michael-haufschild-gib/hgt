import GaloisForLFunctions.HTGeometry.EllipticReparamProtocolTail
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# The elliptic phase tail is the Maurer–Cartan velocity field

On the generic reparametrisation of the meromorphic plane field, the invariants of every deck
translation of a degree-expanding elliptic isogeny protocol are exactly the differential rational
functions of the velocity `u′` — the first jet of the reparametrisation.

Nothing of the position survives the protocol, and what survives is generated by one element: the
Maurer–Cartan current of the covering group.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

local instance planeComplexDifferential : Differential ℂ where
  deriv := 0

/-- Constants of the plane are differential constants. -/
theorem deriv_constPlane (c : ℂ) : Differential.deriv (constPlane c) = 0 := by
  have hdef : constPlane c = ofMeromorphic (fun _ : ℂ => c) (fun z => MeromorphicAt.const c z) :=
    rfl
  rw [hdef]
  show meromorphicPlaneDeriv _ = 0
  rw [meromorphicPlaneDeriv_ofMeromorphic]
  refine MeromorphicPlane.germ_injective ?_
  rw [germ_ofMeromorphic, germ_zero]
  refine Germ.coe_eq.mpr (Filter.Eventually.of_forall fun z => ?_)
  simp

/-- Translation of the variable fixes the constants. -/
theorem planeTranslate_constPlane (t : ℂ) (c : ℂ) :
    planeTranslate t (constPlane c) = constPlane c := by
  have hdef : constPlane c = ofMeromorphic (fun _ : ℂ => c) (fun z => MeromorphicAt.const c z) :=
    rfl
  rw [hdef, planeTranslate_ofMeromorphic]

noncomputable instance planeReparamComplexAlgebra : Algebra ℂ (ReparamField MeromorphicPlane) :=
  inferInstanceAs (Algebra ℂ (FractionRing (ReparamPoly MeromorphicPlane)))

instance planeReparamComplexTower :
    IsScalarTower ℂ MeromorphicPlane (ReparamField MeromorphicPlane) :=
  inferInstanceAs (IsScalarTower ℂ MeromorphicPlane (FractionRing (ReparamPoly MeromorphicPlane)))

local instance planeReparamComplexDifferentialAlgebra :
    DifferentialAlgebra ℂ (ReparamField MeromorphicPlane) :=
  ⟨fun c => by
    have htower : algebraMap ℂ (ReparamField MeromorphicPlane) c
        = algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) (constPlane c) := by
      rw [IsScalarTower.algebraMap_apply ℂ MeromorphicPlane (ReparamField MeromorphicPlane)]
      rfl
    rw [htower]
    show ReparamField.fieldDerivation MeromorphicPlane _ = _
    rw [← ReparamField.deriv_eq, ReparamField.deriv_algebraMap, deriv_constPlane]
    show algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) 0 * _ = _
    rw [map_zero, zero_mul]
    show (0 : ReparamField MeromorphicPlane) = algebraMap ℂ (ReparamField MeromorphicPlane) 0
    rw [map_zero]⟩

/-- The jets of the reparametrisation are the derivatives of the velocity. -/
theorem differentialJet_jet_zero (n : ℕ) :
    differentialJet n (ReparamField.jet 0 : ReparamField MeromorphicPlane)
      = ReparamField.jet n := by
  induction n with
  | zero => simp [differentialJet_zero]
  | succ n ih =>
      rw [differentialJet_succ, ih, ReparamField.deriv_jet]

/-- The velocity field: the differential rational functions of the first jet. -/
noncomputable def velocityField : IntermediateField ℂ (ReparamField MeromorphicPlane) :=
  differentialAdjoin ℂ ({ReparamField.jet 0} : Set (ReparamField MeromorphicPlane))

/-- Every jet lies in the velocity field. -/
theorem jet_mem_velocityField (n : ℕ) :
    (ReparamField.jet n : ReparamField MeromorphicPlane) ∈ velocityField := by
  have hmem := differentialJet_mem_differentialAdjoin ℂ
    (s := ({ReparamField.jet 0} : Set (ReparamField MeromorphicPlane)))
    (x := ReparamField.jet 0) rfl n
  rwa [differentialJet_jet_zero] at hmem

/-- A jet polynomial with constant coefficients lies in the velocity field. -/
theorem algebraMap_mem_velocityField_of_const_coeff {p : ReparamPoly MeromorphicPlane}
    (hp : ∀ m, MvPolynomial.coeff m p ∈ constPlane.fieldRange) :
    algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) p
      ∈ velocityField := by
  classical
  have hsum : p = ∑ m ∈ p.support, MvPolynomial.monomial m (MvPolynomial.coeff m p) :=
    MvPolynomial.as_sum p
  rw [hsum, map_sum]
  refine sum_mem fun m _ => ?_
  rw [MvPolynomial.monomial_eq, map_mul]
  refine mul_mem ?_ ?_
  · obtain ⟨c, hc⟩ := hp m
    have hbase : algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)
          (MvPolynomial.C (MvPolynomial.coeff m p))
        = algebraMap ℂ (ReparamField MeromorphicPlane) c := by
      rw [IsScalarTower.algebraMap_apply ℂ MeromorphicPlane (ReparamField MeromorphicPlane), ← hc]
      rfl
    rw [hbase]
    exact IntermediateField.algebraMap_mem _ c
  · rw [Finsupp.prod, map_prod]
    refine prod_mem fun i _ => ?_
    rw [map_pow]
    exact pow_mem (jet_mem_velocityField i) _

/-- The jet coordinates are algebraically independent over the base. -/
theorem algebraicIndependent_jet :
    AlgebraicIndependent MeromorphicPlane
      (fun i : ℕ => (ReparamField.jet i : ReparamField MeromorphicPlane)) := by
  have hX : AlgebraicIndependent MeromorphicPlane
      (fun i : ℕ => (MvPolynomial.X i : ReparamPoly MeromorphicPlane)) :=
    MvPolynomial.algebraicIndependent_X ℕ MeromorphicPlane
  have hinj : Function.Injective (IsScalarTower.toAlgHom MeromorphicPlane
      (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)) :=
    IsFractionRing.injective (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)
  exact (AlgHom.algebraicIndependent_iff (IsScalarTower.toAlgHom MeromorphicPlane
    (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)) hinj).2 hX

/-- **The velocity is differentially transcendental over the constants.**  The reparametrisation
makes the Maurer–Cartan current a differentially independent source, so the phase tail has
differential transcendence degree one, the dimension of the elliptic curve. -/
theorem differentialIndependent_jet_zero :
    DifferentialIndependent ℂ
      (fun _ : Unit => (ReparamField.jet 0 : ReparamField MeromorphicPlane)) := by
  have hbase : AlgebraicIndependent ℂ
      (fun i : ℕ => (ReparamField.jet i : ReparamField MeromorphicPlane)) := by
    refine algebraicIndependent_jet.restrictScalars ?_
    exact (algebraMap ℂ MeromorphicPlane).injective
  have hcomp : AlgebraicIndependent ℂ
      (fun p : Unit × ℕ => (ReparamField.jet p.2 : ReparamField MeromorphicPlane)) := by
    refine hbase.comp (fun p : Unit × ℕ => p.2) ?_
    rintro ⟨_, a⟩ ⟨_, b⟩ h
    simpa using h
  show AlgebraicIndependent ℂ _
  have hfun : (fun p : Unit × ℕ =>
      differentialJet p.2 ((fun _ : Unit => (ReparamField.jet 0 : ReparamField MeromorphicPlane))
        p.1)) = fun p : Unit × ℕ => (ReparamField.jet p.2 : ReparamField MeromorphicPlane) := by
    funext p
    exact differentialJet_jet_zero p.2
  rw [hfun]
  exact hcomp

/-- The velocity field is generated by the jets. -/
theorem velocityField_eq_adjoin_range_jet :
    velocityField = IntermediateField.adjoin ℂ
      (Set.range (ReparamField.jet : ℕ → ReparamField MeromorphicPlane)) := by
  have hset : differentialJetSet ({ReparamField.jet 0} :
      Set (ReparamField MeromorphicPlane))
      = Set.range (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) := by
    ext y
    constructor
    · rintro ⟨z, hz, n, rfl⟩
      rw [Set.mem_singleton_iff] at hz
      subst hz
      exact ⟨n, (differentialJet_jet_zero n).symm⟩
    · rintro ⟨n, rfl⟩
      exact ⟨ReparamField.jet 0, rfl, n, differentialJet_jet_zero n⟩
  rw [velocityField, differentialAdjoin, hset]

/-- Evaluating a complex jet polynomial is the image of its constant-coefficient lift. -/
theorem aeval_jet_eq_algebraMap (P : MvPolynomial ℕ ℂ) :
    MvPolynomial.aeval (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) P
      = algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)
        (MvPolynomial.map constPlane P) := by
  classical
  induction P using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.aeval_C, MvPolynomial.map_C]
      rw [IsScalarTower.algebraMap_apply ℂ MeromorphicPlane (ReparamField MeromorphicPlane)]
      rfl
  | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
  | mul_X p i hp =>
      rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.map_X]
      rfl

/-- **The velocity carries no position.**  An element of the base that lies in the velocity field is
a constant. -/
theorem eq_constPlane_of_algebraMap_mem_velocityField {a : MeromorphicPlane}
    (ha : algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) a ∈ velocityField) :
    ∃ c : ℂ, a = constPlane c := by
  classical
  rw [velocityField_eq_adjoin_range_jet, IntermediateField.mem_adjoin_iff] at ha
  obtain ⟨r, s, hrs⟩ := ha
  obtain ⟨P, hP⟩ : ∃ P : MvPolynomial ℕ ℂ,
      MvPolynomial.aeval (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) P
        = MvPolynomial.aeval Subtype.val r := by
    have hfun : (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) ∘
        (fun t : ↥(Set.range (ReparamField.jet : ℕ → ReparamField MeromorphicPlane)) =>
          t.2.choose) = Subtype.val := by
      funext t
      exact t.2.choose_spec
    refine ⟨MvPolynomial.rename (fun t : ↥(Set.range
      (ReparamField.jet : ℕ → ReparamField MeromorphicPlane)) => t.2.choose) r, ?_⟩
    rw [MvPolynomial.aeval_rename, hfun]
  obtain ⟨Q, hQ⟩ : ∃ Q : MvPolynomial ℕ ℂ,
      MvPolynomial.aeval (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) Q
        = MvPolynomial.aeval Subtype.val s := by
    have hfun : (ReparamField.jet : ℕ → ReparamField MeromorphicPlane) ∘
        (fun t : ↥(Set.range (ReparamField.jet : ℕ → ReparamField MeromorphicPlane)) =>
          t.2.choose) = Subtype.val := by
      funext t
      exact t.2.choose_spec
    refine ⟨MvPolynomial.rename (fun t : ↥(Set.range
      (ReparamField.jet : ℕ → ReparamField MeromorphicPlane)) => t.2.choose) s, ?_⟩
    rw [MvPolynomial.aeval_rename, hfun]
  rw [← hP, ← hQ, aeval_jet_eq_algebraMap, aeval_jet_eq_algebraMap] at hrs
  by_cases hQ0 : MvPolynomial.map constPlane Q = 0
  · rw [hQ0, map_zero, div_zero] at hrs
    refine ⟨0, ?_⟩
    have : algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) a = 0 := hrs
    have ha0 : a = 0 := by
      have hinj : Function.Injective
          (algebraMap MeromorphicPlane (ReparamField MeromorphicPlane)) := by
        exact fun u v huv => by
          have := congrArg id huv
          exact (algebraMap MeromorphicPlane (ReparamField MeromorphicPlane)).injective huv
      exact hinj (by rw [this, map_zero])
    rw [ha0, map_zero]
  · have hQne : algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)
        (MvPolynomial.map constPlane Q) ≠ 0 := by
      intro h
      exact hQ0 (IsFractionRing.injective (ReparamPoly MeromorphicPlane)
        (ReparamField MeromorphicPlane) (by rw [h, map_zero]))
    rw [eq_div_iff hQne] at hrs
    have hbase : algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) a
        = algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane)
          (MvPolynomial.C a) := rfl
    rw [hbase, ← map_mul] at hrs
    have hpoly : MvPolynomial.C a * MvPolynomial.map constPlane Q
        = MvPolynomial.map constPlane P :=
      IsFractionRing.injective (ReparamPoly MeromorphicPlane)
        (ReparamField MeromorphicPlane) hrs
    obtain ⟨m, hm⟩ : ∃ m, MvPolynomial.coeff m (MvPolynomial.map constPlane Q) ≠ 0 := by
      by_contra hcon
      refine hQ0 (MvPolynomial.ext _ _ fun m => ?_)
      simp only [MvPolynomial.coeff_zero]
      by_contra hnem
      exact hcon ⟨m, hnem⟩
    have hcoeff := congrArg (MvPolynomial.coeff m) hpoly
    rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, MvPolynomial.coeff_map] at hcoeff
    refine ⟨MvPolynomial.coeff m P / MvPolynomial.coeff m Q, ?_⟩
    rw [MvPolynomial.coeff_map] at hm
    rw [map_div₀, eq_div_iff hm]
    exact hcoeff

/-- The deck-invariant field of an elliptic isogeny protocol on the generic reparametrisation. -/
noncomputable def deckInvariantField (L : PeriodPair) (M : ℕ → ℂ) :
    IntermediateField ℂ (ReparamField MeromorphicPlane) where
  carrier := {x : ReparamField MeromorphicPlane | ∀ n : ℕ, ∀ t : ℂ, M n * t ∈ L.lattice →
    ReparamField.fieldEquiv (planeTranslateEquiv t) x = x}
  zero_mem' := by intro n t _; simp
  one_mem' := by intro n t _; simp
  add_mem' := by
    intro x y hx hy n t ht
    rw [map_add, hx n t ht, hy n t ht]
  mul_mem' := by
    intro x y hx hy n t ht
    rw [map_mul, hx n t ht, hy n t ht]
  inv_mem' := by
    intro x hx n t ht
    rw [map_inv₀, hx n t ht]
  algebraMap_mem' := by
    intro c n t _
    have htower : algebraMap ℂ (ReparamField MeromorphicPlane) c
        = algebraMap MeromorphicPlane (ReparamField MeromorphicPlane) (constPlane c) := by
      rw [IsScalarTower.algebraMap_apply ℂ MeromorphicPlane (ReparamField MeromorphicPlane)]
      rfl
    rw [htower, ReparamField.fieldEquiv_base, planeTranslateEquiv_apply,
      planeTranslate_constPlane]

theorem mem_deckInvariantField_iff (L : PeriodPair) (M : ℕ → ℂ)
    {x : ReparamField MeromorphicPlane} :
    x ∈ deckInvariantField L M ↔ ∀ n : ℕ, ∀ t : ℂ, M n * t ∈ L.lattice →
      ReparamField.fieldEquiv (planeTranslateEquiv t) x = x := Iff.rfl

/-- The deck-invariant field is closed under the derivation. -/
theorem derivationClosed_deckInvariantField (L : PeriodPair) (M : ℕ → ℂ) :
    DerivationClosed (deckInvariantField L M) := by
  intro x hx n t ht
  rw [ReparamField.fieldEquiv_deriv (planeTranslateEquiv t) (planeTranslateEquiv_deriv t) x,
    hx n t ht]

/-- **The elliptic phase tail is the velocity field.**  On the generic reparametrisation, the
elements fixed by every deck translation of every depth of a degree-expanding elliptic protocol are
exactly the differential rational functions of the Maurer–Cartan velocity. -/
theorem deckInvariantField_eq_velocityField (L : PeriodPair) (M : ℕ → ℂ)
    (hM : ∀ n, M n ≠ 0) (hMinf : Tendsto (fun n => ‖M n‖) atTop atTop) :
    deckInvariantField L M = velocityField := by
  refine le_antisymm ?_ ?_
  · intro x hx
    obtain ⟨p, q, hq0, hpc, hqc, hrep⟩ :=
      exists_const_coeff_representation_of_forall_deck_fixed L M hM hMinf x hx
    have hqne : algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) q ≠ 0 := by
      intro h
      exact hq0 (IsFractionRing.injective (ReparamPoly MeromorphicPlane)
        (ReparamField MeromorphicPlane) (by rw [h, map_zero]))
    have hxval : x = algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) p
        / algebraMap (ReparamPoly MeromorphicPlane) (ReparamField MeromorphicPlane) q := by
      rw [eq_div_iff hqne, mul_comm]
      exact hrep
    rw [hxval]
    exact div_mem (algebraMap_mem_velocityField_of_const_coeff hpc)
      (algebraMap_mem_velocityField_of_const_coeff hqc)
  · refine differentialAdjoin_le ℂ ?_ (derivationClosed_deckInvariantField L M)
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    intro n t _
    exact ReparamField.fieldEquiv_jet (planeTranslateEquiv t) 0

end GaloisForLFunctions.HTGeometry
