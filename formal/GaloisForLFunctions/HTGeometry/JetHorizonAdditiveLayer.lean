import Mathlib
import GaloisForLFunctions.HTGeometry.KolchinExchangeGaugeObstruction
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Each layer of a derivative horizon is an additive torsor

Between two consecutive layers of a derivative horizon only one jet is forgotten, and its
derivative is already present.  A differential automorphism fixing the lower layer therefore moves
that jet by a constant, the displacement is additive under composition, and an automorphism with
zero displacement is the identity on the field the jet generates.

So the gauge group of a single layer embeds in the additive group of constants: the layer is an
additive torsor, which is the group-theoretic content of the successive-torsor law.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C T : Type*} [Field C] [Field T] [Algebra C T] [Differential T]

/-- **The displacement of a layer automorphism is a constant.**  An automorphism commuting with the
derivation and fixing the derivative of an element moves that element by a constant. -/
theorem deriv_displacement_eq_zero (σ : DifferentialAlgEquiv C T) {q : T}
    (hq : σ.toAlgEquiv (q′) = q′) : (σ.toAlgEquiv q - q)′ = 0 := by
  rw [map_sub, ← σ.map_deriv', hq, sub_self]

/-- **The displacement is additive.**  Composing two automorphisms adds their displacements, as
soon as the second fixes the first displacement. -/
theorem displacement_add (σ τ : DifferentialAlgEquiv C T) {q : T}
    (hτ : τ.toAlgEquiv (σ.toAlgEquiv q - q) = σ.toAlgEquiv q - q) :
    τ.toAlgEquiv (σ.toAlgEquiv q) - q
      = (τ.toAlgEquiv q - q) + (σ.toAlgEquiv q - q) := by
  have hsplit : σ.toAlgEquiv q = q + (σ.toAlgEquiv q - q) := by ring
  rw [hsplit, map_add, hτ]
  ring

/-- **Zero displacement means the identity on the generated layer.**  An automorphism fixing a
subfield and an element fixes the field they generate. -/
theorem eq_self_of_fixes_adjoin (L : IntermediateField C T) (σ : DifferentialAlgEquiv C T)
    (hL : ∀ x ∈ L, σ.toAlgEquiv x = x) {q : T} (hq : σ.toAlgEquiv q = q)
    {x : T} (hx : x ∈ IntermediateField.adjoin (↥L) ({q} : Set T)) :
    σ.toAlgEquiv x = x := by
  classical
  refine IntermediateField.adjoin_induction (↥L) (p := fun y _ => σ.toAlgEquiv y = y)
    ?_ ?_ ?_ ?_ ?_ hx
  · rintro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy, hq]
  · intro c
    exact hL _ c.2
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]

/-- **The layer gauge group embeds in the additive constants.**  If the whole field is generated by
one jet over the lower layer, an automorphism of the layer is determined by its displacement, and
that displacement is a constant. -/
theorem injective_displacement (L : IntermediateField C T)
    (σ τ : DifferentialAlgEquiv C T)
    (hσL : ∀ x ∈ L, σ.toAlgEquiv x = x) (hτL : ∀ x ∈ L, τ.toAlgEquiv x = x)
    {q : T} (htop : IntermediateField.adjoin (↥L) ({q} : Set T) = ⊤)
    (hdisp : σ.toAlgEquiv q = τ.toAlgEquiv q) (x : T) :
    σ.toAlgEquiv x = τ.toAlgEquiv x := by
  classical
  have hx : x ∈ IntermediateField.adjoin (↥L) ({q} : Set T) := by rw [htop]; trivial
  refine IntermediateField.adjoin_induction (↥L)
    (p := fun y _ => σ.toAlgEquiv y = τ.toAlgEquiv y) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy, hdisp]
  · intro c
    have hc : (algebraMap (↥L) T) c = (c : T) := rfl
    rw [hc, hσL _ c.2, hτL _ c.2]
  · intro a b _ _ ha hb
    rw [map_add, map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, map_mul, ha, hb]

end

end GaloisForLFunctions.HTGeometry
