import GaloisForLFunctions.HTGeometry.GeneralizedRiemannRelations
import GaloisForLFunctions.HTGeometry.PeriodSubgroupCyclic

/-!
# Generalized Riemann relations in the plane

In complex dimension one the generalized Riemann relations cost nothing: every subgroup of `ℂ`
generated by two elements carries a positive-definite Hermitian form with integral imaginary part.
The form is the scalar one, `H (x, y) = c x conj y`; its imaginary part is `c Im (x conj y)`, which
is `ℤ`-bilinear and vanishes on the diagonal, so a single normalisation of `c` against
`Im (w1 conj w2)` makes it integral on the whole subgroup.  A discrete subgroup of the plane has
rank at most two, so this covers every plane period lattice with no analytic input of
Capocasa--Catanese type.

For a hypertranscendental meromorphic normal-form function the corpus period law makes the period
group cyclic, which settles both remaining quasi-Abelian clauses at once: the period group spans
only a real line, so the period quotient is noncompact, and the relations hold on a cyclic group.
-/

open Module

namespace GaloisForLFunctions.HTGeometry

/-- The scalar Hermitian form of the plane. -/
noncomputable def planeHermitian (c : ℝ) (x y : ℂ) : ℂ := (c : ℂ) * x * star y

theorem planeHermitian_add_left (c : ℝ) (x y z : ℂ) :
    planeHermitian c (x + y) z = planeHermitian c x z + planeHermitian c y z := by
  simp only [planeHermitian]
  ring

theorem planeHermitian_smul_left (c : ℝ) (a x y : ℂ) :
    planeHermitian c (a • x) y = a * planeHermitian c x y := by
  simp only [planeHermitian, smul_eq_mul]
  ring

theorem planeHermitian_hermitian (c : ℝ) (x y : ℂ) :
    planeHermitian c y x = star (planeHermitian c x y) := by
  simp only [planeHermitian, star_mul, Complex.star_def, Complex.conj_conj, Complex.conj_ofReal]
  ring

theorem planeHermitian_self_re (c : ℝ) (x : ℂ) :
    (planeHermitian c x x).re = c * Complex.normSq x := by
  have h : planeHermitian c x x = ((c * Complex.normSq x : ℝ) : ℂ) := by
    rw [planeHermitian, mul_assoc, Complex.star_def, Complex.mul_conj]
    push_cast
    ring
  rw [h, Complex.ofReal_re]

theorem planeHermitian_pos {c : ℝ} (hc : 0 < c) {x : ℂ} (hx : x ≠ 0) :
    0 < (planeHermitian c x x).re := by
  rw [planeHermitian_self_re]
  exact mul_pos hc (Complex.normSq_pos.mpr hx)

theorem planeHermitian_im (c : ℝ) (x y : ℂ) :
    (planeHermitian c x y).im = c * (x * star y).im := by
  rw [planeHermitian, mul_assoc]
  simp

theorem im_mul_star_self (a : ℂ) : (a * star a).im = 0 := by
  rw [Complex.star_def, Complex.mul_conj]
  simp

theorem im_mul_star_swap (a b : ℂ) : (b * star a).im = -(a * star b).im := by
  have h : b * star a = star (a * star b) := by
    simp only [star_mul, star_star]
  rw [h, Complex.star_def, Complex.conj_im]

/-- Integrality of the imaginary part propagates from generators to the whole subgroup, by
`ℤ`-bilinearity in each slot separately. -/
theorem exists_int_im_planeHermitian_of_mem_closure {c : ℝ} {s : Set ℂ}
    (hgen : ∀ a ∈ s, ∀ b ∈ s, ∃ n : ℤ, (planeHermitian c a b).im = (n : ℝ))
    {x y : ℂ} (hx : x ∈ AddSubgroup.closure s) (hy : y ∈ AddSubgroup.closure s) :
    ∃ n : ℤ, (planeHermitian c x y).im = (n : ℝ) := by
  have hleft : ∀ u v w : ℂ, (planeHermitian c (u + v) w).im
      = (planeHermitian c u w).im + (planeHermitian c v w).im := by
    intro u v w
    rw [planeHermitian_add_left, Complex.add_im]
  have hlneg : ∀ u w : ℂ, (planeHermitian c (-u) w).im = -(planeHermitian c u w).im := by
    intro u w
    simp only [planeHermitian_im, neg_mul, Complex.neg_im]
    ring
  have hright : ∀ u v w : ℂ, (planeHermitian c u (v + w)).im
      = (planeHermitian c u v).im + (planeHermitian c u w).im := by
    intro u v w
    simp only [planeHermitian_im, star_add, mul_add, Complex.add_im]
  have hrneg : ∀ u w : ℂ, (planeHermitian c u (-w)).im = -(planeHermitian c u w).im := by
    intro u w
    simp only [planeHermitian_im, star_neg, mul_neg, Complex.neg_im]
  have step1 : ∀ b ∈ s, ∀ u ∈ AddSubgroup.closure s,
      ∃ n : ℤ, (planeHermitian c u b).im = (n : ℝ) := by
    intro b hb u hu
    induction hu using AddSubgroup.closure_induction with
    | mem a ha => exact hgen a ha b hb
    | zero => exact ⟨0, by simp [planeHermitian_im]⟩
    | add p q _ _ hp hq =>
        obtain ⟨n, hn⟩ := hp
        obtain ⟨m, hm⟩ := hq
        exact ⟨n + m, by rw [hleft, hn, hm]; push_cast; ring⟩
    | neg p _ hp =>
        obtain ⟨n, hn⟩ := hp
        exact ⟨-n, by rw [hlneg, hn]; push_cast; ring⟩
  induction hy using AddSubgroup.closure_induction with
  | mem b hb => exact step1 b hb x hx
  | zero => exact ⟨0, by simp [planeHermitian_im]⟩
  | add p q _ _ hp hq =>
      obtain ⟨n, hn⟩ := hp
      obtain ⟨m, hm⟩ := hq
      exact ⟨n + m, by rw [hright, hn, hm]; push_cast; ring⟩
  | neg p _ hp =>
      obtain ⟨n, hn⟩ := hp
      exact ⟨-n, by rw [hrneg, hn]; push_cast; ring⟩

/-- On the generating pair the imaginary part takes only three values. -/
theorem im_mul_star_pair_cases {ω₁ ω₂ a b : ℂ}
    (ha : a = ω₁ ∨ a = ω₂) (hb : b = ω₁ ∨ b = ω₂) :
    (a * star b).im = 0 ∨ (a * star b).im = (ω₁ * star ω₂).im
      ∨ (a * star b).im = -(ω₁ * star ω₂).im := by
  rcases ha with h1 | h1 <;> rcases hb with h2 | h2 <;> subst h1 <;> subst h2
  · exact Or.inl (im_mul_star_self _)
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (im_mul_star_swap _ _))
  · exact Or.inl (im_mul_star_self _)

/-- **Generalized Riemann relations for every two-generated subgroup of the plane.** -/
theorem exists_planeHermitian_pos_integral (ω₁ ω₂ : ℂ) :
    ∃ c : ℝ, 0 < c ∧ ∀ x ∈ AddSubgroup.closure ({ω₁, ω₂} : Set ℂ),
      ∀ y ∈ AddSubgroup.closure ({ω₁, ω₂} : Set ℂ),
        ∃ n : ℤ, (planeHermitian c x y).im = (n : ℝ) := by
  rcases eq_or_ne ((ω₁ * star ω₂).im) 0 with hD0 | hD0
  · refine ⟨1, one_pos, fun x hx y hy =>
      exists_int_im_planeHermitian_of_mem_closure ?_ hx hy⟩
    intro a ha b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    refine ⟨0, ?_⟩
    rw [planeHermitian_im]
    rcases im_mul_star_pair_cases ha hb with h | h | h
    · rw [h]; ring
    · rw [h, hD0]; ring
    · rw [h, hD0]; ring
  · refine ⟨|(ω₁ * star ω₂).im|⁻¹, by positivity, fun x hx y hy =>
      exists_int_im_planeHermitian_of_mem_closure ?_ hx hy⟩
    intro a ha b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rw [planeHermitian_im]
    rcases lt_or_gt_of_ne hD0 with hsign | hsign
    · rcases im_mul_star_pair_cases ha hb with h | h | h
      · exact ⟨0, by rw [h]; ring⟩
      · exact ⟨-1, by rw [h, abs_of_neg hsign]; push_cast; field_simp⟩
      · exact ⟨1, by rw [h, abs_of_neg hsign]; push_cast; field_simp⟩
    · rcases im_mul_star_pair_cases ha hb with h | h | h
      · exact ⟨0, by rw [h]; ring⟩
      · exact ⟨1, by rw [h, abs_of_pos hsign]; push_cast; field_simp⟩
      · exact ⟨-1, by rw [h, abs_of_pos hsign]; push_cast; field_simp⟩

/-- **The period quotient of a hypertranscendental function is noncompact.**  Its period group is
cyclic, hence spans only a real line of the plane. -/
theorem not_isCompact_univ_quotient_periodSubgroup_of_hypertranscendental
    {f : ℂ → ℂ} (hNF : MeromorphicNFOn f Set.univ) (hHT : Hypertranscendental f) :
    ¬ IsCompact (Set.univ : Set (ℂ ⧸ periodSubgroup f)) := by
  obtain ⟨ω, hω⟩ := exists_periodSubgroup_eq_closure_singleton hNF hHT
  refine not_isCompact_univ_quotient_of_span_ne_top _ ?_
  rw [hω]
  have hcard : ({ω} : Finset ℂ).card < finrank ℝ ℂ := by
    simp [Complex.finrank_real_complex]
  have h := span_closure_ne_top_of_card_lt_finrank hcard
  simpa using h

/-- **Generalized Riemann relations for the period group of a hypertranscendental function.** -/
theorem exists_planeHermitian_pos_integral_periodSubgroup
    {f : ℂ → ℂ} (hNF : MeromorphicNFOn f Set.univ) (hHT : Hypertranscendental f) :
    ∃ c : ℝ, 0 < c ∧ ∀ x ∈ periodSubgroup f, ∀ y ∈ periodSubgroup f,
      ∃ n : ℤ, (planeHermitian c x y).im = (n : ℝ) := by
  obtain ⟨ω, hω⟩ := exists_periodSubgroup_eq_closure_singleton hNF hHT
  obtain ⟨c, hc, hint⟩ := exists_planeHermitian_pos_integral ω ω
  have hpair : ({ω, ω} : Set ℂ) = {ω} := by simp
  refine ⟨c, hc, fun x hx y hy => hint x ?_ y ?_⟩
  · rw [hpair, ← hω]; exact hx
  · rw [hpair, ← hω]; exact hy

end GaloisForLFunctions.HTGeometry
