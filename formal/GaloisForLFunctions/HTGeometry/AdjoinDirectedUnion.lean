import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.RingTheory.Algebraic.Basic

/-!
# Algebraicity over an increasing union of generated fields

An element algebraic over the field generated by an increasing union of generating sets is already
algebraic over the field generated by one of the stages: the witnessing polynomial has finitely many
nonzero coefficients, each of them already lies at a finite stage, and the stages are directed.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The field generated by a union is the supremum of the fields generated by the pieces. -/
theorem adjoin_iUnion_eq_iSup (S : ℕ → Set L) :
    IntermediateField.adjoin K (⋃ n, S n) = ⨆ n, IntermediateField.adjoin K (S n) := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    intro y hy
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hy
    exact le_iSup (fun n => IntermediateField.adjoin K (S n)) n
      (IntermediateField.subset_adjoin K _ hn)
  · refine iSup_le fun n => ?_
    rw [IntermediateField.adjoin_le_iff]
    intro y hy
    exact IntermediateField.subset_adjoin K _ (Set.mem_iUnion.mpr ⟨n, hy⟩)

/-- The stage fields of an increasing family of generating sets are directed. -/
theorem directed_adjoin_of_monotone {S : ℕ → Set L} (hmono : Monotone S) :
    Directed (· ≤ ·) (fun n => IntermediateField.adjoin K (S n)) := by
  intro m n
  exact ⟨max m n, IntermediateField.adjoin.mono K _ _ (hmono (le_max_left m n)),
    IntermediateField.adjoin.mono K _ _ (hmono (le_max_right m n))⟩

/-- An element of the field generated by an increasing union already lies at a finite stage. -/
theorem exists_stage_mem {S : ℕ → Set L} (hmono : Monotone S) {y : L}
    (hy : y ∈ IntermediateField.adjoin K (⋃ n, S n)) :
    ∃ n, y ∈ IntermediateField.adjoin K (S n) := by
  rw [adjoin_iUnion_eq_iSup] at hy
  rw [← SetLike.mem_coe,
    IntermediateField.coe_iSup_of_directed (directed_adjoin_of_monotone (K := K) hmono)] at hy
  simp only [Set.mem_iUnion, SetLike.mem_coe] at hy
  exact hy

/-- **Finite-stage descent for algebraicity.**  An element algebraic over the field generated by an
increasing union of generating sets is algebraic over the field generated by one of the stages. -/
theorem exists_isAlgebraic_stage {S : ℕ → Set L} (hmono : Monotone S) {x : L}
    (h : IsAlgebraic ↥(IntermediateField.adjoin K (⋃ n, S n)) x) :
    ∃ n, IsAlgebraic ↥(IntermediateField.adjoin K (S n)) x := by
  classical
  obtain ⟨p, hp0, hp⟩ := h
  have hcoeff : ∀ i : ℕ, ∃ n : ℕ,
      ((p.coeff i : ↥(IntermediateField.adjoin K (⋃ n, S n))) : L)
        ∈ IntermediateField.adjoin K (S n) := fun i => exists_stage_mem hmono (p.coeff i).2
  choose c hc using hcoeff
  set N : ℕ := (Finset.range (p.natDegree + 1)).sup c with hN
  have hstage : ∀ i : ℕ, i ≤ p.natDegree →
      ((p.coeff i : ↥(IntermediateField.adjoin K (⋃ n, S n))) : L)
        ∈ IntermediateField.adjoin K (S N) := by
    intro i hi
    have hle : c i ≤ N := by
      rw [hN]
      exact Finset.le_sup (f := c) (Finset.mem_range.mpr (by omega))
    exact IntermediateField.adjoin.mono K _ _ (hmono hle) (hc i)
  refine ⟨N, ?_⟩
  have hleF : IntermediateField.adjoin K (S N) ≤ IntermediateField.adjoin K (⋃ n, S n) := by
    rw [IntermediateField.adjoin_le_iff]
    intro y hy
    exact IntermediateField.subset_adjoin K _ (Set.mem_iUnion.mpr ⟨N, hy⟩)
  letI : Algebra ↥(IntermediateField.adjoin K (S N))
      ↥(IntermediateField.adjoin K (⋃ n, S n)) :=
    (IntermediateField.inclusion hleF).toRingHom.toAlgebra
  haveI : IsScalarTower ↥(IntermediateField.adjoin K (S N))
      ↥(IntermediateField.adjoin K (⋃ n, S n)) L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hlifts : p ∈ Polynomial.lifts (algebraMap ↥(IntermediateField.adjoin K (S N))
      ↥(IntermediateField.adjoin K (⋃ n, S n))) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    by_cases hi : i ≤ p.natDegree
    · exact ⟨⟨((p.coeff i : ↥(IntermediateField.adjoin K (⋃ n, S n))) : L), hstage i hi⟩,
        Subtype.ext rfl⟩
    · have hz : p.coeff i = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      exact ⟨0, by rw [hz, map_zero]⟩
  obtain ⟨q, hq⟩ := (Polynomial.mem_lifts p).mp hlifts
  refine ⟨q, ?_, ?_⟩
  · intro hq0
    rw [hq0, Polynomial.map_zero] at hq
    exact hp0 hq.symm
  · have hmapeval := Polynomial.aeval_map_algebraMap
      (A := ↥(IntermediateField.adjoin K (⋃ n, S n))) (x := x) q
    rw [hq] at hmapeval
    rw [← hmapeval]
    exact hp

end GaloisForLFunctions.HTGeometry
