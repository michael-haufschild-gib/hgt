import GaloisForLFunctions.HTGeometry.MatrixWignerSmithFiniteJetRank
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity
import GaloisForLFunctions.HTGeometry.HypertranscendentalHorizonFunctionField

/-!
# The Kolchin slope dichotomy for one reporter

For one element `x` of a differential field extension of `F` the visible finite jet packet through
order `r` has an ordinary algebraic-matroid rank

`κ_x(r) = trdeg_F F(x, x', …, x^(r))`.

Hypertranscendence makes the whole jet sequence algebraically independent, so `κ_x(r) = r + 1`;
differential algebraicity produces one jet algebraic over its strict predecessors, and then every
jet is algebraic over that fixed finite prefix, so `κ_x` is bounded.  Consequently the normalized
Kolchin slope `κ_x(r)/(r+1)` always converges, and it is `1` exactly in the hypertranscendental
case and `0` exactly in the differentially algebraic case.
-/

open scoped Differential IntermediateField.algebraAdjoinAdjoin

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Set Filter Topology
open GaloisForLFunctions.MatroidGluing

noncomputable section

/-- The finite packet of all jets of one reporter through order `r`. -/
noncomputable def scalarFiniteJetPacket
    {E : Type*} [Field E] [Differential E] (x : E) (r : ℕ) : Finset E := by
  classical
  exact (Finset.range (r + 1)).image fun k => differentialJet k x

theorem mem_scalarFiniteJetPacket_iff
    {E : Type*} [Field E] [Differential E] (x : E) (r : ℕ) (z : E) :
    z ∈ scalarFiniteJetPacket x r ↔ ∃ k ≤ r, differentialJet k x = z := by
  classical
  simp [scalarFiniteJetPacket]

/-- The finite packet of jets of order strictly below `n`. -/
noncomputable def scalarJetPrefixPacket
    {E : Type*} [Field E] [Differential E] (x : E) (n : ℕ) : Finset E := by
  classical
  exact (Finset.range n).image fun k => differentialJet k x

theorem coe_scalarJetPrefixPacket
    {E : Type*} [Field E] [Differential E] (x : E) (n : ℕ) :
    (↑(scalarJetPrefixPacket x n) : Set E)
      = (fun m => differentialJet m x) '' Set.Iio n := by
  classical
  ext z
  simp [scalarJetPrefixPacket, Set.mem_image]

theorem card_scalarJetPrefixPacket_le
    {E : Type*} [Field E] [Differential E] (x : E) (n : ℕ) :
    (scalarJetPrefixPacket x n).card ≤ n := by
  classical
  calc (scalarJetPrefixPacket x n).card
      ≤ (Finset.range n).card := Finset.card_image_le
    _ = n := Finset.card_range n

/-- **(1)** The Kolchin jet rank of one reporter: the transcendence degree of the field generated
by its first `r + 1` jets. -/
noncomputable def kolchinJetRank
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : E) (r : ℕ) : ℕ :=
  finiteAlgebraicMatroidRank F (scalarFiniteJetPacket x r)

theorem finiteAlgebraicMatroidRank_eq_eRk_toNat
    {F E : Type*} [Field F] [Field E] [Algebra F E] (s : Finset E) :
    finiteAlgebraicMatroidRank F s
      = ((AlgebraicIndependent.matroid F E).eRk (↑s : Set E)).toNat := by
  classical
  rfl

/-- An algebraically independent finite packet has rank equal to its cardinality. -/
theorem finiteAlgebraicMatroidRank_eq_card_of_algebraicIndependent
    {F E : Type*} [Field F] [Field E] [Algebra F E] (s : Finset E)
    (h : AlgebraicIndependent F ((↑) : (↑s : Set E) → E)) :
    finiteAlgebraicMatroidRank F s = s.card := by
  classical
  have hindep : (AlgebraicIndependent.matroid F E).Indep (↑s : Set E) :=
    AlgebraicIndependent.matroid_indep_iff.mpr h
  rw [finiteAlgebraicMatroidRank_eq_eRk_toNat, hindep.eRk_eq_encard,
    Set.encard_coe_eq_coe_finsetCard]
  simp

/-- Rank never exceeds cardinality. -/
theorem finiteAlgebraicMatroidRank_le_card
    {F E : Type*} [Field F] [Field E] [Algebra F E] (s : Finset E) :
    finiteAlgebraicMatroidRank F s ≤ s.card := by
  classical
  rw [finiteAlgebraicMatroidRank_eq_eRk_toNat]
  have h := (AlgebraicIndependent.matroid F E).eRk_le_encard (↑s : Set E)
  rw [Set.encard_coe_eq_coe_finsetCard] at h
  exact ENat.toNat_le_toNat h (by simp)

/-- Being algebraic over the algebra generated by a finite base packet cannot raise rank. -/
theorem finiteAlgebraicMatroidRank_le_of_isAlgebraic_adjoin
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (base signal : Finset E)
    (halg : ∀ z ∈ signal, IsAlgebraic (Algebra.adjoin F (↑base : Set E)) z) :
    finiteAlgebraicMatroidRank F signal ≤ finiteAlgebraicMatroidRank F base := by
  classical
  let M := AlgebraicIndependent.matroid F E
  have hsignal : (↑signal : Set E) ⊆ M.closure (↑base : Set E) := by
    intro z hz
    rw [AlgebraicIndependent.matroid_closure_eq, SetLike.mem_coe,
      Subalgebra.mem_algebraicClosure]
    exact halg z (by exact_mod_cast hz)
  have hle : M.eRk (↑signal : Set E) ≤ M.eRk (↑base : Set E) := by
    calc
      M.eRk (↑signal : Set E) ≤ M.eRk (M.closure (↑base : Set E)) := M.eRk_mono hsignal
      _ = M.eRk (↑base : Set E) := M.eRk_closure_eq _
  rw [finiteAlgebraicMatroidRank_eq_eRk_toNat, finiteAlgebraicMatroidRank_eq_eRk_toNat]
  exact ENat.toNat_le_toNat hle
    (GaloisForLFunctions.MatroidGluing.matroid_eRk_ne_top M base)

/-- Algebraicity over the intermediate field generated by a set descends to the algebra generated
by that set: the intermediate field is the fraction field of the algebra. -/
theorem isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateAdjoin
    {F E : Type*} [Field F] [Field E] [Algebra F E] (s : Set E) {z : E}
    (h : IsAlgebraic (IntermediateField.adjoin F s) z) :
    IsAlgebraic (Algebra.adjoin F s) z := by
  exact h.restrictScalars (Algebra.adjoin F s)

/-- **(2), hypertranscendental half.**  Every finite jet packet of a hypertranscendental reporter is
algebraically independent, so its rank is exactly the number of visible jet layers. -/
theorem kolchinJetRank_eq_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) (r : ℕ) :
    kolchinJetRank F x r = r + 1 := by
  classical
  set j : ℕ → E := fun n => differentialJet n x with hjdef
  have hj : AlgebraicIndependent F j :=
    algebraicIndependent_differentialJet_of_hypertranscendentalOver hx
  have hinj : Function.Injective j := hj.injective
  have hcard : (scalarFiniteJetPacket x r).card = r + 1 := by
    have : scalarFiniteJetPacket x r = (Finset.range (r + 1)).image j := rfl
    rw [this, Finset.card_image_of_injective _ hinj, Finset.card_range]
  have hsub : (↑(scalarFiniteJetPacket x r) : Set E) ⊆ Set.range j := by
    intro z hz
    rw [Finset.mem_coe, mem_scalarFiniteJetPacket_iff] at hz
    obtain ⟨k, -, hk⟩ := hz
    exact ⟨k, hk⟩
  have hindep : AlgebraicIndependent F ((↑) : (↑(scalarFiniteJetPacket x r) : Set E) → E) :=
    AlgebraicIndependent.mono hsub hj.coe_range
  rw [kolchinJetRank,
    finiteAlgebraicMatroidRank_eq_card_of_algebraicIndependent _ hindep, hcard]

/-- **(2), differentially algebraic half.**  A differentially algebraic reporter has all of its
jets algebraic over one fixed finite prefix, so its jet rank is uniformly bounded. -/
theorem exists_kolchinJetRank_le_of_differentialAlgebraicOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) :
    ∃ n : ℕ, ∀ r : ℕ, kolchinJetRank F x r ≤ n := by
  classical
  obtain ⟨n, hn⟩ := exists_algebraic_jet_over_prefix (k := F) hx
  refine ⟨n, fun r => ?_⟩
  have hbase : ∀ z ∈ scalarFiniteJetPacket x r,
      IsAlgebraic (Algebra.adjoin F (↑(scalarJetPrefixPacket x n) : Set E)) z := by
    intro z hz
    rw [mem_scalarFiniteJetPacket_iff] at hz
    obtain ⟨k, -, rfl⟩ := hz
    have halg : IsAlgebraic (differentialJetPrefixField F x n) (differentialJet k x) :=
      all_jets_algebraic_over_prefix (k := F) x n hn k
    rw [coe_scalarJetPrefixPacket]
    exact isAlgebraic_algebraAdjoin_of_isAlgebraic_intermediateAdjoin _ halg
  calc kolchinJetRank F x r
      ≤ finiteAlgebraicMatroidRank F (scalarJetPrefixPacket x n) :=
        finiteAlgebraicMatroidRank_le_of_isAlgebraic_adjoin _ _ hbase
    _ ≤ (scalarJetPrefixPacket x n).card := finiteAlgebraicMatroidRank_le_card _
    _ ≤ n := card_scalarJetPrefixPacket_le x n

/-- **(3), hypertranscendental half.**  The normalized Kolchin slope of a hypertranscendental
reporter is `1`. -/
theorem tendsto_kolchinSlope_one_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) :
    Tendsto (normalizedRankSequence (kolchinJetRank F x)) atTop (nhds 1) := by
  have hconst : ∀ r : ℕ, normalizedRankSequence (kolchinJetRank F x) r = 1 := by
    intro r
    rw [normalizedRankSequence, kolchinJetRank_eq_of_hypertranscendentalOver hx r]
    have hpos : ((r : ℝ) + 1) ≠ 0 := by positivity
    push_cast
    field_simp
  have hfun : normalizedRankSequence (kolchinJetRank F x) = fun _ : ℕ => (1 : ℝ) :=
    funext hconst
  rw [hfun]
  exact tendsto_const_nhds

/-- **(3), differentially algebraic half.**  The normalized Kolchin slope of a differentially
algebraic reporter is `0`. -/
theorem tendsto_kolchinSlope_zero_of_differentialAlgebraicOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) :
    Tendsto (normalizedRankSequence (kolchinJetRank F x)) atTop (nhds 0) := by
  obtain ⟨n, hn⟩ := exists_kolchinJetRank_le_of_differentialAlgebraicOver hx
  have hC : Tendsto (fun r : ℕ => (n : ℝ) / ((r : ℝ) + 1)) atTop (nhds 0) := by
    simpa [div_eq_mul_inv] using
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (n : ℝ)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hC
    (Filter.Eventually.of_forall fun r => ?_) (Filter.Eventually.of_forall fun r => ?_)
  · exact div_nonneg (by positivity) (by positivity)
  · rw [normalizedRankSequence]
    apply (div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < (r : ℝ) + 1)).mpr
    exact_mod_cast hn r

/-- **The Kolchin slope dichotomy.**  The normalized jet-rank slope of one reporter always
converges, and its value is `1` exactly for hypertranscendental reporters and `0` exactly for
differentially algebraic ones. -/
theorem tendsto_kolchinSlope_one_iff_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x : E) :
    Tendsto (normalizedRankSequence (kolchinJetRank F x)) atTop (nhds 1)
      ↔ HypertranscendentalOver F x := by
  constructor
  · intro h
    by_contra hda
    have hzero := tendsto_kolchinSlope_zero_of_differentialAlgebraicOver
      (F := F) (x := x) (not_not.mp hda)
    have : (1 : ℝ) = 0 := tendsto_nhds_unique h hzero
    exact one_ne_zero this
  · exact tendsto_kolchinSlope_one_of_hypertranscendentalOver

/-- The complementary form: slope `0` characterizes differential algebraicity. -/
theorem tendsto_kolchinSlope_zero_iff_differentialAlgebraicOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (x : E) :
    Tendsto (normalizedRankSequence (kolchinJetRank F x)) atTop (nhds 0)
      ↔ DifferentialAlgebraicOver F x := by
  constructor
  · intro h
    by_contra hht
    have hone := tendsto_kolchinSlope_one_of_hypertranscendentalOver (F := F) (x := x) hht
    have : (0 : ℝ) = 1 := tendsto_nhds_unique h hone
    exact zero_ne_one this
  · exact tendsto_kolchinSlope_zero_of_differentialAlgebraicOver

end

end GaloisForLFunctions.HTGeometry
