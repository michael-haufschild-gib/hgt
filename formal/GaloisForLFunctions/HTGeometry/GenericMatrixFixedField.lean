import GaloisForLFunctions.HTGeometry.GenericMatrixDifferentialGalois
import GaloisForLFunctions.HTGeometry.SubfieldPointVanishing

/-!
# The fixed field of the constant left translations

The free differential rational field `E = K⟨x_{ij}⟩` carries the generic matrix `Y` and the constant
left translations `Y ↦ Z Y`, `Z ∈ GL_N(K)`, which fix the system matrix `A = Y⁻¹ δY` and hence the
slice coordinates `B_m = Y⁻¹ Y^{(m)}`.  This file proves the converse: an element of `E` fixed by
*every* constant left translation already lies in the subfield generated by `K` and the slice
coordinates.

The proof is a slice specialisation and uses no invariant theory.  Write `u = p/q` and introduce a
*generic* gauge matrix `z` of `N²` free variables.  Constant invariance says that the polynomial
`Δ = p(zY)·q − p·q(zY)` vanishes at every `K`-point of `GL_N`; multiplying by `det z` it vanishes at
every `K`-point of the full matrix space, so it vanishes identically because `K` is infinite.  Then
substitute `z ↦ w·Y⁻¹`, which turns `Y^{(m)}` into `w·B_m`: the identity becomes
`p(wB)·q = p·q(wB)` for a free `w`, and choosing a `K`-point `w` at which `q(wB) ≠ 0` — possible for
the same density reason — exhibits `u` as a ratio of two elements of the slice subfield.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {K : Type*} [Field K] {N : ℕ}

/-- The `r`-th jet matrix is the matrix of the `r`-th jet coordinates. -/
theorem genericJetPower_apply (r : ℕ) (i j : Fin N) :
    genericJetPower K N r i j = JetField.jet ((i, j), r) := by
  induction r with
  | zero => rfl
  | succ r ih =>
      rw [genericJetPower_succ, matDeriv_apply, ih]
      exact JetField.deriv_jet ((i, j), r)

/-- Polynomials in a generic gauge matrix over the free differential rational field. -/
abbrev GaugePoly (K : Type*) [Field K] (N : ℕ) : Type _ :=
  MvPolynomial (Fin N × Fin N) (JetField K (Fin N × Fin N))

/-- The generic gauge matrix of indeterminates. -/
def gaugeVarMatrix (K : Type*) [Field K] (N : ℕ) : Matrix (Fin N) (Fin N) (GaugePoly K N) :=
  Matrix.of fun i j => X (i, j)

/-- The `r`-th jet matrix, as constants of the gauge polynomial ring. -/
def jetMatrixConst (K : Type*) [Field K] (N : ℕ) (r : ℕ) :
    Matrix (Fin N) (Fin N) (GaugePoly K N) :=
  (genericJetPower K N r).map (MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N)

/-- The generic gauge substitution `x^{(m)} ↦ (z · Y^{(m)})`. -/
def gaugeGenHom (K : Type*) [Field K] (N : ℕ) :
    JetPoly K (Fin N × Fin N) →+* GaugePoly K N :=
  eval₂Hom ((MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N).comp
      (algebraMap K (JetField K (Fin N × Fin N))))
    (fun p : (Fin N × Fin N) × ℕ =>
      (gaugeVarMatrix K N * jetMatrixConst K N p.2) p.1.1 p.1.2)

/-- Evaluation of the gauge variables at a matrix of scalars. -/
def gaugeEvalPoint (Z : Fin N × Fin N → K) :
    GaugePoly K N →+* JetField K (Fin N × Fin N) :=
  eval₂Hom (RingHom.id (JetField K (Fin N × Fin N)))
    (fun p : Fin N × Fin N => algebraMap K (JetField K (Fin N × Fin N)) (Z p))

@[simp] theorem gaugeEvalPoint_C (Z : Fin N × Fin N → K) (a : JetField K (Fin N × Fin N)) :
    gaugeEvalPoint Z (MvPolynomial.C a) = a := by simp [gaugeEvalPoint]

@[simp] theorem gaugeEvalPoint_X (Z : Fin N × Fin N → K) (p : Fin N × Fin N) :
    gaugeEvalPoint Z (X p) = algebraMap K (JetField K (Fin N × Fin N)) (Z p) := by
  simp [gaugeEvalPoint]

theorem gaugeGenHom_X (a b : Fin N) (r : ℕ) :
    gaugeGenHom K N (X ((a, b), r))
      = (gaugeVarMatrix K N * jetMatrixConst K N r) a b := by
  simp [gaugeGenHom]

theorem leftTranslationPolyEquiv_C (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) (a : K) :
    leftTranslationPolyEquiv Z W hZW hWZ (MvPolynomial.C a) = MvPolynomial.C a := by
  simp [leftTranslationPolyEquiv, differentialJetLinearChangeAlgEquiv,
    differentialJetLinearChangeAlgHom]

/-- **The generic gauge specialises to the constant gauges.** -/
theorem gaugeEvalPoint_gaugeGenHom (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) (p : JetPoly K (Fin N × Fin N)) :
    gaugeEvalPoint (fun q : Fin N × Fin N => Z q.1 q.2) (gaugeGenHom K N p)
      = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
          (leftTranslationPolyEquiv Z W hZW hWZ p) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      have hgen : gaugeGenHom K N (MvPolynomial.C a)
          = MvPolynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
        simp [gaugeGenHom]
      rw [hgen, gaugeEvalPoint_C, leftTranslationPolyEquiv_C]
      rw [IsScalarTower.algebraMap_apply K (JetPoly K (Fin N × Fin N))
        (JetField K (Fin N × Fin N)), MvPolynomial.algebraMap_eq]
  | add p q hp hq => simp [hp, hq]
  | mul_X p q hp =>
      obtain ⟨⟨a, b⟩, r⟩ := q
      have hX : gaugeEvalPoint (fun q : Fin N × Fin N => Z q.1 q.2)
          (gaugeGenHom K N (X ((a, b), r)))
          = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
              (leftTranslationPolyEquiv Z W hZW hWZ (X ((a, b), r))) := by
        rw [gaugeGenHom_X, leftTranslationPolyEquiv_X, map_sum]
        rw [Matrix.mul_apply, map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [gaugeVarMatrix, jetMatrixConst]
        simp only [Matrix.of_apply, Matrix.map_apply, map_mul, gaugeEvalPoint_X,
          gaugeEvalPoint_C]
        rw [genericJetPower_apply]
        congr 1
      rw [map_mul (gaugeGenHom K N), map_mul (gaugeEvalPoint
        (fun q : Fin N × Fin N => Z q.1 q.2)), hp, hX,
        ← map_mul (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))),
        ← map_mul (leftTranslationPolyEquiv Z W hZW hWZ)]

/-! ### The slice substitution -/

/-- The inverse generic matrix, as constants of the gauge polynomial ring. -/
def invMatrixConst (K : Type*) [Field K] (N : ℕ) : Matrix (Fin N) (Fin N) (GaugePoly K N) :=
  ((genericJetMatrix K N)⁻¹).map (MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N)

/-- The `m`-th slice matrix, as constants of the gauge polynomial ring. -/
def sliceMatrixConst (K : Type*) [Field K] (N : ℕ) (m : ℕ) :
    Matrix (Fin N) (Fin N) (GaugePoly K N) :=
  (genericSliceMatrix K N m).map (MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N)

/-- The substitution `z ↦ w · Y⁻¹` of the gauge variables. -/
def gaugeSubstInv (K : Type*) [Field K] (N : ℕ) : GaugePoly K N →+* GaugePoly K N :=
  eval₂Hom (MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N)
    (fun p : Fin N × Fin N => (gaugeVarMatrix K N * invMatrixConst K N) p.1 p.2)

/-- The slice substitution `x^{(m)} ↦ w · B_m`. -/
def sliceGenHom (K : Type*) [Field K] (N : ℕ) :
    JetPoly K (Fin N × Fin N) →+* GaugePoly K N :=
  eval₂Hom ((MvPolynomial.C : JetField K (Fin N × Fin N) →+* GaugePoly K N).comp
      (algebraMap K (JetField K (Fin N × Fin N))))
    (fun p : (Fin N × Fin N) × ℕ =>
      (gaugeVarMatrix K N * sliceMatrixConst K N p.2) p.1.1 p.1.2)

theorem sliceGenHom_X (a b : Fin N) (r : ℕ) :
    sliceGenHom K N (X ((a, b), r))
      = (gaugeVarMatrix K N * sliceMatrixConst K N r) a b := by
  simp [sliceGenHom]

theorem gaugeSubstInv_C (a : JetField K (Fin N × Fin N)) :
    gaugeSubstInv K N (MvPolynomial.C a) = MvPolynomial.C a := by
  simp [gaugeSubstInv]

theorem gaugeSubstInv_X (p : Fin N × Fin N) :
    gaugeSubstInv K N (X p) = (gaugeVarMatrix K N * invMatrixConst K N) p.1 p.2 := by
  simp [gaugeSubstInv]

/-- **The slice substitution is the generic gauge specialised at `z = w·Y⁻¹`.** -/
theorem gaugeSubstInv_gaugeGenHom (p : JetPoly K (Fin N × Fin N)) :
    gaugeSubstInv K N (gaugeGenHom K N p) = sliceGenHom K N p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      have hgen : gaugeGenHom K N (MvPolynomial.C a)
          = MvPolynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
        simp [gaugeGenHom]
      have hsl : sliceGenHom K N (MvPolynomial.C a)
          = MvPolynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
        simp [sliceGenHom]
      rw [hgen, hsl, gaugeSubstInv_C]
  | add p q hp hq => simp [hp, hq]
  | mul_X p q hp =>
      obtain ⟨⟨a, b⟩, r⟩ := q
      have hX : gaugeSubstInv K N (gaugeGenHom K N (X ((a, b), r)))
          = sliceGenHom K N (X ((a, b), r)) := by
        rw [gaugeGenHom_X, sliceGenHom_X, Matrix.mul_apply, map_sum, Matrix.mul_apply]
        have hstep : ∀ k : Fin N,
            gaugeSubstInv K N (gaugeVarMatrix K N a k * jetMatrixConst K N r k b)
              = ∑ l : Fin N, (gaugeVarMatrix K N a l * invMatrixConst K N l k)
                  * jetMatrixConst K N r k b := by
          intro k
          rw [map_mul, gaugeVarMatrix]
          simp only [Matrix.of_apply]
          rw [gaugeSubstInv_X, jetMatrixConst]
          simp only [Matrix.map_apply, gaugeSubstInv_C, Matrix.mul_apply]
          rw [Finset.sum_mul]
          simp only [gaugeVarMatrix, Matrix.of_apply]
        rw [Finset.sum_congr rfl (fun k _ => hstep k), Finset.sum_comm]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [sliceMatrixConst, Matrix.map_apply, genericSliceMatrix, Matrix.mul_apply, map_sum,
          Finset.mul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [invMatrixConst, jetMatrixConst]
        simp only [Matrix.map_apply, map_mul]
        ring
      rw [map_mul, map_mul, hp, hX, map_mul]

/-! ### Evaluation at the generic point -/

/-- Evaluation of the gauge variables at the generic matrix itself. -/
def gaugeEvalGeneric (K : Type*) [Field K] (N : ℕ) :
    GaugePoly K N →+* JetField K (Fin N × Fin N) :=
  eval₂Hom (RingHom.id (JetField K (Fin N × Fin N)))
    (fun p : Fin N × Fin N => genericJetMatrix K N p.1 p.2)

@[simp] theorem gaugeEvalGeneric_C (a : JetField K (Fin N × Fin N)) :
    gaugeEvalGeneric K N (MvPolynomial.C a) = a := by simp [gaugeEvalGeneric]

@[simp] theorem gaugeEvalGeneric_X (p : Fin N × Fin N) :
    gaugeEvalGeneric K N (X p) = genericJetMatrix K N p.1 p.2 := by simp [gaugeEvalGeneric]

/-- **The slice substitution evaluated at the generic matrix is the identity.** -/
theorem gaugeEvalGeneric_sliceGenHom (p : JetPoly K (Fin N × Fin N)) :
    gaugeEvalGeneric K N (sliceGenHom K N p)
      = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      have hsl : sliceGenHom K N (MvPolynomial.C a)
          = MvPolynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
        simp [sliceGenHom]
      rw [hsl, gaugeEvalGeneric_C, IsScalarTower.algebraMap_apply K
        (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)), MvPolynomial.algebraMap_eq]
  | add p q hp hq => simp [hp, hq]
  | mul_X p q hp =>
      obtain ⟨⟨a, b⟩, r⟩ := q
      have hX : gaugeEvalGeneric K N (sliceGenHom K N (X ((a, b), r)))
          = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
              (X ((a, b), r)) := by
        rw [sliceGenHom_X, Matrix.mul_apply, map_sum]
        have hval : ∀ k : Fin N,
            gaugeEvalGeneric K N (gaugeVarMatrix K N a k * sliceMatrixConst K N r k b)
              = genericJetMatrix K N a k * genericSliceMatrix K N r k b := by
          intro k
          rw [map_mul, gaugeVarMatrix, sliceMatrixConst]
          simp only [Matrix.of_apply, Matrix.map_apply, gaugeEvalGeneric_X, gaugeEvalGeneric_C]
        rw [Finset.sum_congr rfl (fun k _ => hval k)]
        have hmul : (genericJetMatrix K N * genericSliceMatrix K N r) a b
            = genericJetPower K N r a b := by
          rw [genericSliceMatrix, ← Matrix.mul_assoc,
            Matrix.mul_nonsing_inv _ isUnit_det_genericJetMatrix, Matrix.one_mul]
        rw [← Matrix.mul_apply] at *
        rw [hmul, genericJetPower_apply]
        rfl
      rw [map_mul, map_mul, hp, hX, map_mul]

theorem det_gaugeVarMatrix_ne_zero : (gaugeVarMatrix K N).det ≠ 0 := by
  intro h
  have hev : gaugeEvalGeneric K N ((gaugeVarMatrix K N).det)
      = (genericJetMatrix K N).det := by
    have hmd := RingHom.map_det (gaugeEvalGeneric K N) (gaugeVarMatrix K N)
    rw [hmd, RingHom.mapMatrix_apply]
    congr 1
    apply Matrix.ext
    intro i j
    rw [Matrix.map_apply, gaugeVarMatrix]
    simp only [Matrix.of_apply]
    rw [gaugeEvalGeneric_X]
  rw [h, map_zero] at hev
  exact det_genericJetMatrix_ne_zero hev.symm

/-! ### The slice subfield -/

/-- The subfield generated by the base field and the slice coordinates. -/
def sliceSubfield (K : Type*) [Field K] (N : ℕ) : Subfield (JetField K (Fin N × Fin N)) :=
  Subfield.closure (Set.range (algebraMap K (JetField K (Fin N × Fin N)))
    ∪ {x | ∃ (m : ℕ) (i j : Fin N), x = genericSliceMatrix K N m i j})

theorem algebraMap_mem_sliceSubfield (a : K) :
    algebraMap K (JetField K (Fin N × Fin N)) a ∈ sliceSubfield K N :=
  Subfield.subset_closure (Or.inl ⟨a, rfl⟩)

theorem genericSliceMatrix_mem_sliceSubfield (m : ℕ) (i j : Fin N) :
    genericSliceMatrix K N m i j ∈ sliceSubfield K N :=
  Subfield.subset_closure (Or.inr ⟨m, i, j, rfl⟩)

theorem mem_sliceSubfield_gaugeEvalPoint (w : Fin N × Fin N → K)
    (p : JetPoly K (Fin N × Fin N)) :
    gaugeEvalPoint w (sliceGenHom K N p) ∈ sliceSubfield K N := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      have hsl : sliceGenHom K N (MvPolynomial.C a)
          = MvPolynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
        simp [sliceGenHom]
      rw [hsl, gaugeEvalPoint_C]
      exact algebraMap_mem_sliceSubfield a
  | add p q hp hq =>
      rw [map_add, map_add]
      exact add_mem hp hq
  | mul_X p q hp =>
      obtain ⟨⟨a, b⟩, r⟩ := q
      rw [map_mul, map_mul]
      refine mul_mem hp ?_
      rw [sliceGenHom_X, Matrix.mul_apply, map_sum]
      refine sum_mem fun k _ => ?_
      rw [map_mul, gaugeVarMatrix, sliceMatrixConst]
      simp only [Matrix.of_apply, Matrix.map_apply, gaugeEvalPoint_X, gaugeEvalPoint_C]
      exact mul_mem (algebraMap_mem_sliceSubfield _)
        (genericSliceMatrix_mem_sliceSubfield r k b)

theorem gaugeEvalPoint_det (Z : Fin N × Fin N → K) :
    gaugeEvalPoint Z ((gaugeVarMatrix K N).det)
      = algebraMap K (JetField K (Fin N × Fin N)) ((Matrix.of fun i j => Z (i, j)).det) := by
  have hmd := RingHom.map_det (gaugeEvalPoint Z) (gaugeVarMatrix K N)
  rw [hmd, RingHom.mapMatrix_apply]
  have hmap : (gaugeVarMatrix K N).map (gaugeEvalPoint Z)
      = (Matrix.of fun i j => Z (i, j)).map
          (algebraMap K (JetField K (Fin N × Fin N))) := by
    apply Matrix.ext
    intro i j
    rw [Matrix.map_apply, gaugeVarMatrix]
    simp only [Matrix.of_apply]
    rw [gaugeEvalPoint_X]
    rfl
  rw [hmap, ← RingHom.mapMatrix_apply,
    ← RingHom.map_det (algebraMap K (JetField K (Fin N × Fin N)))]

/-! ### The fixed field of the constant left translations -/

/-- **The fixed field of the constant left translations lies in the slice subfield.**  The proof
specialises the generic gauge at `z = w·Y⁻¹`: constant invariance upgrades to generic invariance by
Zariski density over an infinite base field, and the specialisation replaces every jet by a
`w`-combination of slice coordinates. -/
theorem mem_sliceSubfield_of_leftTranslation_invariant [Infinite K]
    (u : JetField K (Fin N × Fin N))
    (hu : ∀ (Z W : Matrix (Fin N) (Fin N) K) (hZW : Z * W = 1) (hWZ : W * Z = 1),
      leftTranslationFieldEquiv Z W hZW hWZ u = u) :
    u ∈ sliceSubfield K N := by
  classical
  obtain ⟨p, q, hqmem, hu'⟩ := IsFractionRing.div_surjective (JetPoly K (Fin N × Fin N)) u
  have hinj : Function.Injective
      (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))) :=
    IsFractionRing.injective _ _
  have hq0 : q ≠ 0 := fun h => by
    rw [h] at hqmem
    exact (zero_notMem_nonZeroDivisors) hqmem
  have hqne : algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) q ≠ 0 := by
    intro h
    exact hq0 (hinj (by simpa using h))
  set Δ : GaugePoly K N :=
    gaugeGenHom K N p * MvPolynomial.C
        (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) q)
      - MvPolynomial.C
          (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p)
        * gaugeGenHom K N q with hΔdef
  -- the constant gauges kill `Δ`
  have hpoint : ∀ Z : Fin N × Fin N → K,
      gaugeEvalPoint Z (Δ * (gaugeVarMatrix K N).det) = 0 := by
    intro Z
    set Zm : Matrix (Fin N) (Fin N) K := Matrix.of fun i j => Z (i, j) with hZm
    rw [map_mul, gaugeEvalPoint_det]
    by_cases hdet : Zm.det = 0
    · rw [hdet, map_zero, mul_zero]
    · have hunit : IsUnit Zm.det := isUnit_iff_ne_zero.mpr hdet
      have hZW : Zm * Zm⁻¹ = 1 := Matrix.mul_nonsing_inv Zm hunit
      have hWZ : Zm⁻¹ * Zm = 1 := Matrix.nonsing_inv_mul Zm hunit
      have hZfun : (fun r : Fin N × Fin N => Zm r.1 r.2) = Z := by
        funext r
        obtain ⟨i, j⟩ := r
        rfl
      have hgp := gaugeEvalPoint_gaugeGenHom Zm Zm⁻¹ hZW hWZ p
      have hgq := gaugeEvalPoint_gaugeGenHom Zm Zm⁻¹ hZW hWZ q
      rw [hZfun] at hgp hgq
      have hσq : algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
          (leftTranslationPolyEquiv Zm Zm⁻¹ hZW hWZ q) ≠ 0 := by
        intro h
        have := hinj (by simpa using h)
        exact hq0 ((leftTranslationPolyEquiv Zm Zm⁻¹ hZW hWZ).injective
          (by simpa using this))
      have hfix := hu Zm Zm⁻¹ hZW hWZ
      rw [← hu', map_div₀, leftTranslationFieldEquiv_algebraMap,
        leftTranslationFieldEquiv_algebraMap] at hfix
      rw [div_eq_div_iff hσq hqne] at hfix
      have hzero : gaugeEvalPoint Z Δ = 0 := by
        rw [hΔdef, map_sub, map_mul, map_mul, gaugeEvalPoint_C, gaugeEvalPoint_C, hgp, hgq]
        rw [sub_eq_zero]
        exact hfix
      rw [hzero, zero_mul]
  have hzero : Δ * (gaugeVarMatrix K N).det = 0 :=
    mvPolynomial_eq_zero_of_eval_subfield_eq_zero (C := K) hpoint
  have hΔ : Δ = 0 := by
    rcases mul_eq_zero.mp hzero with h | h
    · exact h
    · exact absurd h det_gaugeVarMatrix_ne_zero
  -- specialise the generic gauge at `z = w · Y⁻¹`
  have hslice : sliceGenHom K N p
        * MvPolynomial.C (algebraMap (JetPoly K (Fin N × Fin N))
            (JetField K (Fin N × Fin N)) q)
      = MvPolynomial.C (algebraMap (JetPoly K (Fin N × Fin N))
          (JetField K (Fin N × Fin N)) p) * sliceGenHom K N q := by
    have := congrArg (gaugeSubstInv K N) hΔ
    rw [hΔdef, map_sub, map_mul, map_mul, gaugeSubstInv_C, gaugeSubstInv_C,
      gaugeSubstInv_gaugeGenHom, gaugeSubstInv_gaugeGenHom, map_zero, sub_eq_zero] at this
    exact this
  -- the slice image of `q` is nonzero
  have hsq : sliceGenHom K N q ≠ 0 := by
    intro h
    have := gaugeEvalGeneric_sliceGenHom (K := K) (N := N) q
    rw [h, map_zero] at this
    exact hqne this.symm
  obtain ⟨w, hw⟩ : ∃ w : Fin N × Fin N → K, gaugeEvalPoint w (sliceGenHom K N q) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hsq (mvPolynomial_eq_zero_of_eval_subfield_eq_zero (C := K) hcon)
  have hfinal := congrArg (gaugeEvalPoint w) hslice
  rw [map_mul, map_mul, gaugeEvalPoint_C, gaugeEvalPoint_C] at hfinal
  have hdiv : u = gaugeEvalPoint w (sliceGenHom K N p) / gaugeEvalPoint w (sliceGenHom K N q) := by
    rw [← hu']
    rw [div_eq_div_iff hqne hw]
    exact hfinal.symm
  rw [hdiv]
  exact div_mem (mem_sliceSubfield_gaugeEvalPoint w p) (mem_sliceSubfield_gaugeEvalPoint w q)

end

end GaloisForLFunctions.HTGeometry
