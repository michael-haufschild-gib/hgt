import GaloisForLFunctions.HTGeometry.ProjectiveHorizonChartUnipotentGeneration
import Mathlib.Logic.Equiv.Set

/-!
# The lattice of projective observer groups

For a set `s` of coordinate directions, the projective observer group `G_S` attached to the
covector span `S = span(e_i^* : i ∈ s)` is the group of unimodular maps fixing the transverse
subspace `W = S^⊥ = span(e_k : k ∉ s)` pointwise.  Splitting the index type along `s` and
transporting the chart-unipotent generation theorem gives the subset form: `G_S` is generated by
the elementary transvections whose column index lies in `s`.

Because the generating sets are visibly monotone and additive in `s`, the subset form yields the
span-to-intersection law `G_(S+T) = ⟨G_S, G_T⟩` and the injectivity of `S ↦ G_S` at once.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

/-! ## Reindexing special linear groups -/

/-- Reindexing a matrix along an index equivalence commutes with an elementary transvection. -/
theorem reindex_transvection {n m : Type*} [DecidableEq n] [DecidableEq m]
    {K : Type*} [Field K] (e : n ≃ m) (p q : n) (c : K) :
    Matrix.reindex e e (Matrix.transvection p q c) =
      Matrix.transvection (e p) (e q) c := by
  ext x y
  show Matrix.transvection p q c (e.symm x) (e.symm y) = _
  simp [Matrix.transvection, Matrix.single_apply, Matrix.one_apply, Equiv.eq_symm_apply]

/-- Reindexing the coordinates is an isomorphism of special linear groups. -/
def slReindex {n m : Type*} [Fintype n] [Fintype m] [DecidableEq n] [DecidableEq m]
    (K : Type*) [Field K] (e : n ≃ m) :
    SpecialLinearGroup n K ≃* SpecialLinearGroup m K where
  toFun g := ⟨Matrix.reindex e e (g : Matrix n n K), by
    rw [Matrix.det_reindex_self]; exact g.2⟩
  invFun h := ⟨Matrix.reindex e.symm e.symm (h : Matrix m m K), by
    rw [Matrix.det_reindex_self]; exact h.2⟩
  left_inv g := Subtype.ext (by ext x y; simp)
  right_inv h := Subtype.ext (by ext x y; simp)
  map_mul' g h := Subtype.ext (map_mul (Matrix.reindexAlgEquiv K K e) _ _)

@[simp]
theorem slReindex_coe_apply {n m : Type*} [Fintype n] [Fintype m] [DecidableEq n] [DecidableEq m]
    {K : Type*} [Field K] (e : n ≃ m) (g : SpecialLinearGroup n K) (x y : m) :
    ((slReindex K e g : SpecialLinearGroup m K) : Matrix m m K) x y =
      (g : Matrix n n K) (e.symm x) (e.symm y) := rfl

@[simp]
theorem slReindex_symm_coe_apply {n m : Type*} [Fintype n] [Fintype m] [DecidableEq n]
    [DecidableEq m] {K : Type*} [Field K] (e : n ≃ m) (g : SpecialLinearGroup m K)
    (x y : n) :
    (((slReindex K e).symm g : SpecialLinearGroup n K) : Matrix n n K) x y =
      (g : Matrix m m K) (e x) (e y) := rfl

/-! ## Observer groups indexed by coordinate subsets -/

variable {n : Type*} [Fintype n] [DecidableEq n] {K : Type*} [Field K]

/-- The projective observer group of the covector span indexed by `s`: the unimodular maps fixing
pointwise the transverse subspace spanned by the standard vectors outside `s`. -/
def chartSubsetStabilizer (s : Set n) : Subgroup (SpecialLinearGroup n K) where
  carrier := {g | ∀ k ∉ s, ∀ x, (g : Matrix n n K) x k = (1 : Matrix n n K) x k}
  one_mem' := by
    intro k _ x
    rw [Matrix.SpecialLinearGroup.coe_one]
  mul_mem' := by
    intro a b ha hb k hk x
    rw [Matrix.SpecialLinearGroup.coe_mul a b, Matrix.mul_apply,
      Finset.sum_congr rfl fun y _ => by rw [hb k hk y], ← Matrix.mul_apply, Matrix.mul_one]
    exact ha k hk x
  inv_mem' := by
    intro a ha k hk x
    have hinv : ((a⁻¹ : SpecialLinearGroup n K) : Matrix n n K) * (a : Matrix n n K) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    have h1 : (1 : Matrix n n K) x k =
        ∑ y, ((a⁻¹ : SpecialLinearGroup n K) : Matrix n n K) x y *
          (a : Matrix n n K) y k := by
      rw [← Matrix.mul_apply, hinv]
    rw [h1, Finset.sum_congr rfl fun y _ => by rw [ha k hk y], ← Matrix.mul_apply, Matrix.mul_one]

theorem mem_chartSubsetStabilizer_iff {s : Set n} {g : SpecialLinearGroup n K} :
    g ∈ chartSubsetStabilizer s ↔
      ∀ k ∉ s, ∀ x, (g : Matrix n n K) x k = (1 : Matrix n n K) x k :=
  Iff.rfl

/-- The elementary transvections whose column index is one of the chart directions in `s`. -/
def chartSubsetTransvectionSet (s : Set n) (K : Type*) [Field K] :
    Set (SpecialLinearGroup n K) :=
  {g | ∃ (i : n) (_ : i ∈ s) (x : n) (hx : x ≠ i) (c : K), g = transvectionSL x i hx c}

theorem transvectionSL_mem_chartSubsetTransvectionSet {s : Set n} {i x : n} (hi : i ∈ s)
    (hx : x ≠ i) (c : K) :
    transvectionSL x i hx c ∈ chartSubsetTransvectionSet s K :=
  ⟨i, hi, x, hx, c, rfl⟩

theorem transvectionSL_mem_chartSubsetStabilizer {s : Set n} {i x : n} (hi : i ∈ s)
    (hx : x ≠ i) (c : K) :
    transvectionSL x i hx c ∈ chartSubsetStabilizer (K := K) s := by
  intro k hk y
  have hik : i ≠ k := fun h => hk (h ▸ hi)
  show Matrix.transvection x i c y k = _
  rw [Matrix.transvection]
  simp [hik]

/-! ## Transport along an index splitting -/

section Transport

variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]

/-- Under an index splitting adapted to `s`, the chart transvections of the split model are exactly
the elementary transvections with column index in `s`. -/
theorem image_chartTransvectionSet (e : (ι ⊕ κ) ≃ n) (s : Set n)
    (hsl : ∀ i : ι, e (Sum.inl i) ∈ s)
    (hsr : ∀ x ∈ s, ∃ i : ι, e (Sum.inl i) = x) :
    (slReindex K e : SpecialLinearGroup (ι ⊕ κ) K → SpecialLinearGroup n K) ''
        chartTransvectionSet ι κ K = chartSubsetTransvectionSet s K := by
  ext g
  constructor
  · rintro ⟨_, ⟨t, rfl⟩, rfl⟩
    refine ⟨e (Sum.inl t.col), hsl t.col, e t.row, ?_, t.coeff, ?_⟩
    · exact fun hcontra => t.hne (e.injective hcontra)
    · apply Subtype.ext
      show Matrix.reindex e e (Matrix.transvection t.row (Sum.inl t.col) t.coeff) = _
      rw [reindex_transvection]
  · rintro ⟨i, hi, x, hx, c, rfl⟩
    obtain ⟨i₀, rfl⟩ := hsr i hi
    have hne : e.symm x ≠ Sum.inl i₀ := by
      intro hcontra
      apply hx
      have hxi : e (e.symm x) = e (Sum.inl i₀) := congrArg e hcontra
      rwa [Equiv.apply_symm_apply] at hxi
    refine ⟨ChartTransvection.toSL ⟨e.symm x, i₀, hne, c⟩, ⟨_, rfl⟩, ?_⟩
    apply Subtype.ext
    show Matrix.reindex e e (Matrix.transvection (e.symm x) (Sum.inl i₀) c) = _
    rw [reindex_transvection, Equiv.apply_symm_apply]

/-- Under an index splitting adapted to `s`, the transverse stabiliser of the split model
corresponds to the observer group of `s`. -/
theorem mem_transverseStabilizer_symm_iff (e : (ι ⊕ κ) ≃ n) (s : Set n)
    (hnotin : ∀ k : κ, e (Sum.inr k) ∉ s)
    (hcover : ∀ x ∉ s, ∃ k : κ, e (Sum.inr k) = x)
    (g : SpecialLinearGroup n K) :
    (slReindex K e).symm g ∈ transverseStabilizer ι κ K ↔
      g ∈ chartSubsetStabilizer (K := K) s := by
  have hone : ∀ y z : ι ⊕ κ,
      (1 : Matrix n n K) (e y) (e z) = (1 : Matrix (ι ⊕ κ) (ι ⊕ κ) K) y z := by
    intro y z
    simp [Matrix.one_apply]
  constructor
  · intro hg k hk x
    obtain ⟨k₀, rfl⟩ := hcover k hk
    have hkey := hg k₀ (e.symm x)
    rw [slReindex_symm_coe_apply, ← hone, Equiv.apply_symm_apply] at hkey
    exact hkey
  · intro hg k y
    rw [slReindex_symm_coe_apply, ← hone]
    exact hg (e (Sum.inr k)) (hnotin k) (e y)

theorem map_transverseStabilizer (e : (ι ⊕ κ) ≃ n) (s : Set n)
    (hnotin : ∀ k : κ, e (Sum.inr k) ∉ s)
    (hcover : ∀ x ∉ s, ∃ k : κ, e (Sum.inr k) = x) :
    Subgroup.map
        ((slReindex K e : SpecialLinearGroup (ι ⊕ κ) K ≃* SpecialLinearGroup n K) :
          SpecialLinearGroup (ι ⊕ κ) K →* SpecialLinearGroup n K)
        (transverseStabilizer ι κ K) = chartSubsetStabilizer (K := K) s := by
  ext g
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨h, hh, rfl⟩
    refine (mem_transverseStabilizer_symm_iff e s hnotin hcover _).1 ?_
    show (slReindex K e).symm (slReindex K e h) ∈ _
    rwa [MulEquiv.symm_apply_apply]
  · intro hg
    exact ⟨(slReindex K e).symm g,
      (mem_transverseStabilizer_symm_iff e s hnotin hcover g).2 hg,
      (slReindex K e).apply_symm_apply g⟩

end Transport

/-! ## Subset generation -/

/-- **Chart-unipotent generation, subset form.**  The observer group of the covector span indexed
by `s` is generated by the elementary transvections whose column index lies in `s`. -/
theorem closure_chartSubsetTransvectionSet_eq_chartSubsetStabilizer (s : Set n) :
    Subgroup.closure (chartSubsetTransvectionSet s K) = chartSubsetStabilizer s := by
  classical
  have hsl : ∀ i : (s : Type _), Equiv.Set.sumCompl s (Sum.inl i) ∈ s := fun i => i.2
  have hsr : ∀ x ∈ s, ∃ i : (s : Type _), Equiv.Set.sumCompl s (Sum.inl i) = x :=
    fun x hx => ⟨⟨x, hx⟩, rfl⟩
  have hnotin : ∀ k : ((sᶜ : Set n) : Type _), Equiv.Set.sumCompl s (Sum.inr k) ∉ s := fun k => k.2
  have hcover : ∀ x ∉ s, ∃ k : ((sᶜ : Set n) : Type _),
      Equiv.Set.sumCompl s (Sum.inr k) = x := fun x hx => ⟨⟨x, hx⟩, rfl⟩
  calc Subgroup.closure (chartSubsetTransvectionSet s K)
      = Subgroup.closure
          ((slReindex K (Equiv.Set.sumCompl s) :
              SpecialLinearGroup ((s : Type _) ⊕ ((sᶜ : Set n) : Type _)) K →
                SpecialLinearGroup n K) ''
            chartTransvectionSet (s : Type _) ((sᶜ : Set n) : Type _) K) := by
        rw [image_chartTransvectionSet (K := K) (Equiv.Set.sumCompl s) s hsl hsr]
    _ = Subgroup.map
          ((slReindex K (Equiv.Set.sumCompl s) :
            SpecialLinearGroup ((s : Type _) ⊕ ((sᶜ : Set n) : Type _)) K ≃*
              SpecialLinearGroup n K) : _ →* _)
          (Subgroup.closure (chartTransvectionSet (s : Type _) ((sᶜ : Set n) : Type _) K)) :=
        (MonoidHom.map_closure _ _).symm
    _ = Subgroup.map
          ((slReindex K (Equiv.Set.sumCompl s) :
            SpecialLinearGroup ((s : Type _) ⊕ ((sᶜ : Set n) : Type _)) K ≃*
              SpecialLinearGroup n K) : _ →* _)
          (transverseStabilizer (s : Type _) ((sᶜ : Set n) : Type _) K) := by
        rw [closure_chartTransvectionSet_eq_transverseStabilizer]
    _ = chartSubsetStabilizer s :=
        map_transverseStabilizer (K := K) (Equiv.Set.sumCompl s) s hnotin hcover

/-! ## The observer-group lattice -/

theorem chartSubsetTransvectionSet_union (s t : Set n) :
    chartSubsetTransvectionSet (s ∪ t) K =
      chartSubsetTransvectionSet s K ∪ chartSubsetTransvectionSet t K := by
  ext g
  constructor
  · rintro ⟨i, hi, x, hx, c, rfl⟩
    rcases hi with hi | hi
    · exact Or.inl ⟨i, hi, x, hx, c, rfl⟩
    · exact Or.inr ⟨i, hi, x, hx, c, rfl⟩
  · rintro (⟨i, hi, x, hx, c, rfl⟩ | ⟨i, hi, x, hx, c, rfl⟩)
    · exact ⟨i, Or.inl hi, x, hx, c, rfl⟩
    · exact ⟨i, Or.inr hi, x, hx, c, rfl⟩

/-- **Span-to-join law.**  The observer group of a sum of covector spans is generated by the two
observer groups; dually, the horizon field of a sum is the intersection of the horizon fields. -/
theorem chartSubsetStabilizer_union (s t : Set n) :
    chartSubsetStabilizer (K := K) (s ∪ t) =
      chartSubsetStabilizer (K := K) s ⊔ chartSubsetStabilizer (K := K) t := by
  rw [← closure_chartSubsetTransvectionSet_eq_chartSubsetStabilizer,
    ← closure_chartSubsetTransvectionSet_eq_chartSubsetStabilizer,
    ← closure_chartSubsetTransvectionSet_eq_chartSubsetStabilizer,
    chartSubsetTransvectionSet_union, Subgroup.closure_union]

theorem chartSubsetStabilizer_mono {s t : Set n} (h : s ⊆ t) :
    chartSubsetStabilizer (K := K) s ≤ chartSubsetStabilizer (K := K) t :=
  fun _ hg k hk x => hg k (fun hks => hk (h hks)) x

/-- A direction lies in `s` exactly when some observer of `s` moves its coordinate column. -/
theorem mem_iff_exists_mem_chartSubsetStabilizer [Nontrivial n] (s : Set n) (i : n) :
    i ∈ s ↔ ∃ g ∈ chartSubsetStabilizer (K := K) s,
      ∃ x, (g : Matrix n n K) x i ≠ (1 : Matrix n n K) x i := by
  constructor
  · intro hi
    obtain ⟨x, hx⟩ := exists_ne i
    refine ⟨transvectionSL x i hx 1,
      transvectionSL_mem_chartSubsetStabilizer hi hx 1, x, ?_⟩
    show Matrix.transvection x i (1 : K) x i ≠ _
    rw [Matrix.transvection]
    simp [hx]
  · rintro ⟨g, hg, x, hgx⟩
    by_contra hi
    exact hgx (hg i hi x)

/-- **Faithfulness of the observer-group assignment.**  Distinct covector spans have distinct
observer groups. -/
theorem chartSubsetStabilizer_injective [Nontrivial n] :
    Function.Injective (chartSubsetStabilizer (n := n) (K := K)) := by
  intro s t hst
  ext i
  rw [mem_iff_exists_mem_chartSubsetStabilizer (K := K) s i,
    mem_iff_exists_mem_chartSubsetStabilizer (K := K) t i, hst]

end GaloisForLFunctions.HTGeometry
