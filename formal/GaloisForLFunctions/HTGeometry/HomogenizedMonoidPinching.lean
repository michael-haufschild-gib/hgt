import GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
import Mathlib.Algebra.Polynomial.Div
import Mathlib.RingTheory.ReesAlgebra

/-!
# The pinched image and its vertex ideal

The faithfully realized quadratic quotient is exactly `R + T*(R[M])[T]`. Its vertex ideal
satisfies `I^(n+1) = (T)^n * I`, and `T` is regular without any domain or finiteness assumption.
The degree-one Rees generators obey the same quadrics, so every prime avoiding their ideal
belongs to the distinguished `T*U` chart. The scheme-level identification with all of Proj is
not asserted in this file.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
variable (R M : Type*) [CommRing R] [AddCommMonoid M]

/-- Every polynomial divisible by the homogenizing variable belongs to the image. -/
theorem X_mul_mem_range (p : Polynomial (AddMonoidAlgebra R M)) :
    Polynomial.X * p ∈ (polynomialRealization R M).range := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    simpa [mul_add] using (polynomialRealization R M).range.add_mem hp hq
  | monomial n b =>
    induction b using AddMonoidAlgebra.induction_linear with
    | zero => simp
    | add b c hb hc =>
      simpa [map_add, mul_add] using (polynomialRealization R M).range.add_mem hb hc
    | single a r =>
      refine ⟨MonoidAlgebra.single (Tag.term n a) r, ?_⟩
      simp [polynomialRealization_single, tagKey, Polynomial.X_mul_monomial]

/-- Only the constant coefficient is restricted, and it must be a scalar. -/
theorem range_iff_constant_scalar (p : Polynomial (AddMonoidAlgebra R M)) :
    p ∈ (polynomialRealization R M).range ↔
      ∃ r : R, p.coeff 0 = AddMonoidAlgebra.single (0 : M) r := by
  constructor
  · rintro ⟨f,rfl⟩
    induction f using MonoidAlgebra.induction_linear with
    | zero => exact ⟨0, by simp⟩
    | add f g hf hg =>
      rcases hf with ⟨r,hr⟩
      rcases hg with ⟨s,hs⟩
      change (polynomialRealization R M f).coeff 0 = _ at hr
      change (polynomialRealization R M g).coeff 0 = _ at hs
      exact ⟨r+s, by simp [hr,hs]⟩
    | single t r =>
      cases t with
      | unit => exact ⟨r, by simp [polynomialRealization_single,tagKey]⟩
      | term n a => exact ⟨0, by simp [polynomialRealization_single,tagKey]⟩
  · rintro ⟨r,hr⟩
    have hC : Polynomial.C (p.coeff 0) ∈ (polynomialRealization R M).range := by
      refine ⟨MonoidAlgebra.single Tag.unit r, ?_⟩
      simp [polynomialRealization_single,tagKey,hr]
    have h := (polynomialRealization R M).range.add_mem (X_mul_mem_range R M p.divX) hC
    simpa only [Polynomial.X_mul_divX_add] using h

/-- The exact image consists of scalar constants plus all polynomials divisible by `X`. -/
theorem range_iff_pinched (p : Polynomial (AddMonoidAlgebra R M)) :
    p ∈ (polynomialRealization R M).range ↔
      ∃ (r : R) (q : Polynomial (AddMonoidAlgebra R M)),
        p = Polynomial.C (AddMonoidAlgebra.single (0 : M) r) + Polynomial.X*q := by
  rw [range_iff_constant_scalar]
  constructor
  · rintro ⟨r,hr⟩
    refine ⟨r,p.divX,?_⟩
    rw [← hr,add_comm,Polynomial.X_mul_divX_add]
  · rintro ⟨r,q,rfl⟩
    exact ⟨r,by simp⟩

/-- The vertex ideal, generated by all positive-degree variables. -/
def vertexIdeal : Ideal (Q R M) := Ideal.span (Set.range (qVar R M))

/-- Every quotient variable belongs to the vertex ideal. -/
theorem qVar_mem_vertexIdeal (a : M) : qVar R M a ∈ vertexIdeal R M :=
  Ideal.subset_span ⟨a,rfl⟩

/-- The vertex square is its product with the principal homogenizer ideal. -/
theorem vertexIdeal_sq : vertexIdeal R M * vertexIdeal R M =
    Ideal.span {qVar R M 0} * vertexIdeal R M := by
  apply le_antisymm
  · change Ideal.span (Set.range (qVar R M)) * Ideal.span (Set.range (qVar R M)) ≤ _
    rw [Ideal.span_mul_span]
    apply Ideal.span_le.2
    rintro x ⟨u,⟨a,rfl⟩,v,⟨b,rfl⟩,rfl⟩
    change qVar R M a * qVar R M b ∈ _
    rw [qVar_relation]
    exact Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_singleton _))
      (qVar_mem_vertexIdeal R M (a+b))
  · apply mul_le_mul_left
    exact Ideal.span_le.2 (by
      intro x hx
      rcases Set.mem_singleton_iff.1 hx with rfl
      exact qVar_mem_vertexIdeal R M 0)


/-- The quadratic quotient embeds into the polynomial ring of its monoid algebra. -/
def quotientPolynomial : Q R M →ₐ[R] Polynomial (AddMonoidAlgebra R M) :=
  (polynomialRealization R M).comp (quotientEvaluation R M)

/-- The polynomial realization of the quadratic quotient is faithful. -/
theorem quotientPolynomial_injective : Function.Injective (quotientPolynomial R M) :=
  (polynomialRealization_injective R M).comp (quotientEquiv R M).injective

/-- A quotient variable realizes as its marked degree-one monomial. -/
@[simp] theorem quotientPolynomial_qVar (a : M) :
    quotientPolynomial R M (qVar R M a) =
      Polynomial.monomial 1 (AddMonoidAlgebra.single a 1) := by
  simp [quotientPolynomial, quotientEvaluation_qVar, MonoidAlgebra.of_apply,
    polynomialRealization_single, tagKey]

/-- The neutral label realizes as the homogenizing variable. -/
@[simp] theorem quotientPolynomial_qVar_zero :
    quotientPolynomial R M (qVar R M 0) = Polynomial.X := by
  rw [quotientPolynomial_qVar]
  change Polynomial.monomial 1 (1 : AddMonoidAlgebra R M) = Polynomial.X
  exact Polynomial.monomial_one_one_eq_X

/-- Regularity follows from the faithful realization, rather than being assumed in the quotient. -/
theorem qVar_zero_regular : IsRegular (qVar R M 0) := by
  have hl : IsLeftRegular (qVar R M 0) := by
    intro a b h
    apply quotientPolynomial_injective R M
    apply Polynomial.isRegular_X.left
    simpa only [map_mul, quotientPolynomial_qVar_zero] using congrArg (quotientPolynomial R M) h
  exact ⟨hl, fun a b h => hl (by simpa only [mul_comm] using h)⟩

/-- Every power of the vertex ideal has an exact principal-factor description. -/
theorem vertexIdeal_pow (n : ℕ) : (vertexIdeal R M) ^ (n+1) =
    (Ideal.span {qVar R M 0}) ^ n * vertexIdeal R M := by
  induction n with
  | zero => simp only [Nat.zero_add, Submodule.pow_zero, Submodule.pow_one, Submodule.one_mul]
  | succ n ih =>
    rw [Submodule.pow_succ, ih, mul_assoc, vertexIdeal_sq, ← mul_assoc, ← Submodule.pow_succ]

/-- The degree-one Rees generator corresponding to a monoid label. -/
def reesGenerator (a : M) : reesAlgebra (vertexIdeal R M) :=
  ⟨Polynomial.monomial 1 (qVar R M a),
    reesAlgebra.monomial_mem.2 (by simpa using qVar_mem_vertexIdeal R M a)⟩

/-- The same quadratic relation holds in the Rees algebra. -/
theorem reesGenerator_relation (a b : M) :
    reesGenerator R M a * reesGenerator R M b =
      reesGenerator R M 0 * reesGenerator R M (a+b) := by
  apply Subtype.ext
  change Polynomial.monomial 1 (qVar R M a) * Polynomial.monomial 1 (qVar R M b) =
    Polynomial.monomial 1 (qVar R M 0) * Polynomial.monomial 1 (qVar R M (a+b))
  simp only [Polynomial.monomial_mul_monomial]
  rw [qVar_relation R M a b]

/-- Every prime avoiding the degree-one ideal lies in the distinguished homogenizer chart. -/
theorem rees_prime_cover (P : Ideal (reesAlgebra (vertexIdeal R M))) [P.IsPrime]
    (hP : ¬ Ideal.span (Set.range (reesGenerator R M)) ≤ P) :
    reesGenerator R M 0 ∉ P := by
  intro h0
  apply hP
  apply Ideal.span_le.2
  rintro _ ⟨a,rfl⟩
  have h : reesGenerator R M a * reesGenerator R M a ∈ P := by
    rw [reesGenerator_relation]
    exact P.mul_mem_right _ h0
  exact ((inferInstance : P.IsPrime).mem_or_mem h).elim id id

end GaloisForLFunctions.HTGeometry.HomogenizedMonoidAlgebra
