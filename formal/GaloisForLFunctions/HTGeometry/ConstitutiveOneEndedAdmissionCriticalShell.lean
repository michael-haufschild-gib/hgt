import GaloisForLFunctions.HTGeometry.ConstitutiveAnalyticAdmissionHull
import Mathlib.Topology.Compactification.OnePoint.Basic
import Mathlib.Order.Filter.TendstoCofinite

namespace HTGeometry

noncomputable section

open Filter Set
open scoped Topology

/-!
# One-ended analytic-admission critical shell

The one-point compactification of the natural ray is the smallest explicit cofinal witness needed
here.  Two continuous idempotent retractions alternately pair adjacent finite points.  Their
algebraic join connects every finite point but leaves infinity separate, so a set-valued reporter
survives algebraically.  Continuity and Hausdorff admission force the reporter to become constant:
finite reporters keep exact margin one, converge pointwise to the discontinuous algebraic reporter,
and the global reporter has exact distance one half from every best constant replacement.
-/

/-- Retraction base pairing `0~1`, `2~3`, and so on. -/
def lowerEven (n : ℕ) : ℕ := 2 * (n / 2)

/-- Retraction base pairing `1~2`, `3~4`, and so on, with `0` fixed. -/
def lowerOdd (n : ℕ) : ℕ := if n = 0 then 0 else 2 * ((n - 1) / 2) + 1

instance : Filter.TendstoCofinite lowerEven := by
  rw [Filter.tendstoCofinite_iff_finite_preimage_singleton]
  intro b
  apply (Set.finite_le_nat (b + 2)).subset
  intro n hn
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hn
  dsimp [lowerEven] at hn
  subst b
  have hmod : n % 2 ≤ 1 := by
    have := Nat.mod_lt n (by omega : 0 < 2)
    omega
  change n ≤ 2 * (n / 2) + 2
  calc
    n = n % 2 + 2 * (n / 2) := (Nat.mod_add_div n 2).symm
    _ ≤ 1 + 2 * (n / 2) := Nat.add_le_add_right hmod _
    _ ≤ 2 * (n / 2) + 2 := by omega

instance : Filter.TendstoCofinite lowerOdd := by
  rw [Filter.tendstoCofinite_iff_finite_preimage_singleton]
  intro b
  apply (Set.finite_le_nat (b + 2)).subset
  intro n hn
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hn
  dsimp [lowerOdd] at hn
  split at hn
  · subst n
    simp
  · rename_i hn0
    subst b
    have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
    have hmod : (n - 1) % 2 ≤ 1 := by
      have := Nat.mod_lt (n - 1) (by omega : 0 < 2)
      omega
    have hpred : n - 1 + 1 = n := Nat.sub_add_cancel hnpos
    change n ≤ 2 * ((n - 1) / 2) + 1 + 2
    calc
      n = n - 1 + 1 := hpred.symm
      _ = ((n - 1) % 2 + 2 * ((n - 1) / 2)) + 1 := by
        rw [Nat.mod_add_div]
      _ ≤ 1 + 2 * ((n - 1) / 2) + 1 :=
        Nat.add_le_add_right (Nat.add_le_add_right hmod _) _
      _ ≤ 2 * ((n - 1) / 2) + 1 + 2 := by omega

theorem tendsto_coe_lowerEven :
    Tendsto (fun n : ℕ => (lowerEven n : OnePoint ℕ)) cofinite (𝓝 OnePoint.infty) := by
  have hcoe : Tendsto (fun n : ℕ => (n : OnePoint ℕ)) cofinite (𝓝 OnePoint.infty) := by
    simpa [Nat.cofinite_eq_atTop] using (OnePoint.tendsto_coe_infty (X := ℕ))
  exact hcoe.comp (Filter.TendstoCofinite.tendsto_cofinite lowerEven)

theorem tendsto_coe_lowerOdd :
    Tendsto (fun n : ℕ => (lowerOdd n : OnePoint ℕ)) cofinite (𝓝 OnePoint.infty) := by
  have hcoe : Tendsto (fun n : ℕ => (n : OnePoint ℕ)) cofinite (𝓝 OnePoint.infty) := by
    simpa [Nat.cofinite_eq_atTop] using (OnePoint.tendsto_coe_infty (X := ℕ))
  exact hcoe.comp (Filter.TendstoCofinite.tendsto_cofinite lowerOdd)

/-- Continuous even-pair source retraction fixing infinity. -/
def evenRetraction : C(OnePoint ℕ, OnePoint ℕ) :=
  OnePoint.continuousMapMkDiscrete (fun n => (lowerEven n : OnePoint ℕ))
    OnePoint.infty tendsto_coe_lowerEven

/-- Continuous odd-pair source retraction fixing infinity. -/
def oddRetraction : C(OnePoint ℕ, OnePoint ℕ) :=
  OnePoint.continuousMapMkDiscrete (fun n => (lowerOdd n : OnePoint ℕ))
    OnePoint.infty tendsto_coe_lowerOdd

theorem evenRetraction_coe (n : ℕ) : evenRetraction n = (lowerEven n : OnePoint ℕ) := rfl
theorem oddRetraction_coe (n : ℕ) : oddRetraction n = (lowerOdd n : OnePoint ℕ) := rfl
theorem evenRetraction_infty : evenRetraction OnePoint.infty = OnePoint.infty := rfl
theorem oddRetraction_infty : oddRetraction OnePoint.infty = OnePoint.infty := rfl

theorem lowerEven_two_mul (k : ℕ) : lowerEven (2 * k) = 2 * k := by
  simp [lowerEven]

theorem lowerEven_two_mul_add_one (k : ℕ) : lowerEven (2 * k + 1) = 2 * k := by
  simp [lowerEven]
  omega

theorem lowerOdd_two_mul_add_one (k : ℕ) : lowerOdd (2 * k + 1) = 2 * k + 1 := by
  simp [lowerOdd]

theorem lowerOdd_two_mul_add_two (k : ℕ) : lowerOdd (2 * k + 2) = 2 * k + 1 := by
  simp [lowerOdd]
  omega

theorem lowerEven_le (n : ℕ) : lowerEven n ≤ n := by
  simpa [lowerEven, Nat.mul_comm] using Nat.div_mul_le_self n 2

theorem lowerOdd_le (n : ℕ) : lowerOdd n ≤ n := by
  by_cases hn : n = 0
  · subst n
    rfl
  · have h := Nat.div_mul_le_self (n - 1) 2
    have hnpos := Nat.pos_of_ne_zero hn
    simp only [lowerOdd, if_neg hn]
    omega

/-- Primitive relation generated by unitizing either source retraction. -/
def oneEndedJoinedUnitization (x y : OnePoint ℕ) : Prop :=
  y = evenRetraction x ∨ y = oddRetraction x

/-- A jointly unitizing observer identifies each adjacent pair of finite points. -/
theorem jointlyUnitizing_adjacent
    {Y : Type*} (q : OnePoint ℕ → Y)
    (he : ∀ x, q (evenRetraction x) = q x)
    (ho : ∀ x, q (oddRetraction x) = q x) (n : ℕ) :
    q (n : OnePoint ℕ) = q (n + 1 : ℕ) := by
  rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
  · simpa [evenRetraction_coe, lowerEven_two_mul_add_one] using
      he (show OnePoint ℕ from (2 * k + 1 : ℕ))
  · simpa [oddRetraction_coe, lowerOdd_two_mul_add_two] using
      ho (show OnePoint ℕ from (2 * k + 2 : ℕ))

/-- Algebraically, every finite point lies in one unitization class. -/
theorem jointlyUnitizing_nat_constant
    {Y : Type*} (q : OnePoint ℕ → Y)
    (he : ∀ x, q (evenRetraction x) = q x)
    (ho : ∀ x, q (oddRetraction x) = q x) (n : ℕ) :
    q (n : OnePoint ℕ) = q (0 : ℕ) := by
  induction n with
  | zero => rfl
  | succ n =>
      exact (jointlyUnitizing_adjacent q he ho n).symm.trans (by simpa using ‹_›)

/-- Analytic admission closes the cofinal seam: every continuous Hausdorff-valued jointly unitizing
observer is globally constant, including at infinity. -/
theorem continuous_jointlyUnitizing_constant
    {Y : Type*} [TopologicalSpace Y] [T2Space Y]
    (q : C(OnePoint ℕ, Y))
    (he : ∀ x, q (evenRetraction x) = q x)
    (ho : ∀ x, q (oddRetraction x) = q x) :
    ∀ x y, q x = q y := by
  have hlim : Tendsto (fun n : ℕ => q (n : OnePoint ℕ)) cofinite
      (𝓝 (q OnePoint.infty)) :=
    (OnePoint.continuous_iff_from_discrete q).mp q.continuous
  have hconst : Tendsto (fun n : ℕ => q (n : OnePoint ℕ)) cofinite
      (𝓝 (q (0 : ℕ))) := by
    apply tendsto_const_nhds.congr'
    filter_upwards with n
    exact (jointlyUnitizing_nat_constant q he ho n).symm
  have hinfty : q OnePoint.infty = q (0 : ℕ) :=
    tendsto_nhds_unique hlim hconst
  intro x y
  induction x using OnePoint.rec <;> induction y using OnePoint.rec
  · rfl
  · exact hinfty.trans (jointlyUnitizing_nat_constant q he ho _).symm
  · exact (jointlyUnitizing_nat_constant q he ho _).trans hinfty.symm
  · exact (jointlyUnitizing_nat_constant q he ho _).trans
      (jointlyUnitizing_nat_constant q he ho _).symm

/-- The analytic admission relation of the two source retractions is total. -/
theorem oneEnded_analyticAdmission_total (x y : OnePoint ℕ) :
    analyticAdmissionRel oneEndedJoinedUnitization x y := by
  rw [analyticAdmissionRel_iff_continuous_real_observers]
  intro f hf
  apply continuous_jointlyUnitizing_constant f
  · intro z
    exact (hf z (evenRetraction z) (Or.inl rfl)).symm
  · intro z
    exact (hf z (oddRetraction z) (Or.inr rfl)).symm

/-- Algebraic endpoint reporter: zero on every finite point and one at infinity. -/
def oneEndedSetReporter : OnePoint ℕ → ℝ
  | OnePoint.infty => 1
  | (_ : ℕ) => 0

theorem oneEndedSetReporter_even (x : OnePoint ℕ) :
    oneEndedSetReporter (evenRetraction x) = oneEndedSetReporter x := by
  induction x using OnePoint.rec <;> rfl

theorem oneEndedSetReporter_odd (x : OnePoint ℕ) :
    oneEndedSetReporter (oddRetraction x) = oneEndedSetReporter x := by
  induction x using OnePoint.rec <;> rfl

theorem oneEndedSetReporter_distinguishes_end :
    oneEndedSetReporter (0 : ℕ) ≠ oneEndedSetReporter OnePoint.infty := by
  norm_num [oneEndedSetReporter]

/-- The surviving algebraic reporter is exactly inadmissible analytically. -/
theorem oneEndedSetReporter_not_continuous :
    ¬ Continuous oneEndedSetReporter := by
  intro h
  let q : C(OnePoint ℕ, ℝ) := ⟨oneEndedSetReporter, h⟩
  have hconst := continuous_jointlyUnitizing_constant q
    oneEndedSetReporter_even oneEndedSetReporter_odd
  exact oneEndedSetReporter_distinguishes_end (hconst (0 : ℕ) OnePoint.infty)

/-- Finite-stage continuous reporter: zero through aperture `N`, one afterward and at infinity. -/
def finiteAdmissionReporter (N : ℕ) : C(OnePoint ℕ, ℝ) :=
  OnePoint.continuousMapMkDiscrete
    (fun n : ℕ => if n ≤ N then 0 else 1) 1 (by
      rw [Nat.cofinite_eq_atTop]
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_gt_atTop N] with n hn
      simp [Nat.not_le.mpr hn])

@[simp] theorem finiteAdmissionReporter_infty (N : ℕ) :
    finiteAdmissionReporter N OnePoint.infty = 1 := rfl

@[simp] theorem finiteAdmissionReporter_coe_of_le {N n : ℕ} (h : n ≤ N) :
    finiteAdmissionReporter N (n : OnePoint ℕ) = 0 := by
  change (if n ≤ N then 0 else 1) = 0
  simp [h]

/-- Every finite aperture has exact fixed-target separation margin one. -/
theorem finiteAdmissionReporter_exact_margin (N : ℕ) :
    finiteAdmissionReporter N OnePoint.infty - finiteAdmissionReporter N (0 : ℕ) = 1 := by
  simp

theorem finiteAdmissionReporter_eventually_equals_setReporter (n : ℕ) :
    ∀ N ≥ n,
      finiteAdmissionReporter N (n : OnePoint ℕ) =
        oneEndedSetReporter (n : OnePoint ℕ) := by
  intro N hN
  simp [finiteAdmissionReporter_coe_of_le hN, oneEndedSetReporter]

theorem finiteAdmissionReporter_equals_setReporter_at_infty (N : ℕ) :
    finiteAdmissionReporter N OnePoint.infty =
      oneEndedSetReporter OnePoint.infty := by
  rfl

theorem finiteAdmissionReporter_unitizes_even_on_aperture
    {N n : ℕ} (h : n ≤ N) :
    finiteAdmissionReporter N (evenRetraction (n : OnePoint ℕ)) =
      finiteAdmissionReporter N (n : OnePoint ℕ) := by
  rw [evenRetraction_coe, finiteAdmissionReporter_coe_of_le h]
  exact finiteAdmissionReporter_coe_of_le ((lowerEven_le n).trans h)

theorem finiteAdmissionReporter_unitizes_odd_on_aperture
    {N n : ℕ} (h : n ≤ N) :
    finiteAdmissionReporter N (oddRetraction (n : OnePoint ℕ)) =
      finiteAdmissionReporter N (n : OnePoint ℕ) := by
  rw [oddRetraction_coe, finiteAdmissionReporter_coe_of_le h]
  exact finiteAdmissionReporter_coe_of_le ((lowerOdd_le n).trans h)

/-- Every constant analytic replacement has uniform error at least one half on the algebraic
endpoint reporter. -/
theorem oneEndedSetReporter_constant_gap_lower (c : ℝ) :
    (1 / 2 : ℝ) ≤
      max |oneEndedSetReporter (0 : ℕ) - c|
        |oneEndedSetReporter OnePoint.infty - c| := by
  have htri : (1 : ℝ) ≤ |(0 : ℝ) - c| + |(1 : ℝ) - c| := by
    calc
      (1 : ℝ) = |((0 : ℝ) - c) + (c - 1)| := by
        ring_nf
        norm_num
      _ ≤ |(0 : ℝ) - c| + |c - 1| := abs_add_le _ _
      _ = |(0 : ℝ) - c| + |(1 : ℝ) - c| := by rw [abs_sub_comm c 1]
  simp only [oneEndedSetReporter]
  have h0 := le_max_left |(0 : ℝ) - c| |(1 : ℝ) - c|
  have h1 := le_max_right |(0 : ℝ) - c| |(1 : ℝ) - c|
  linarith

/-- The half-constant realizes the lower bound pointwise, so the global admission gap is exactly
one half. -/
theorem oneEndedSetReporter_half_constant_exact (x : OnePoint ℕ) :
    |oneEndedSetReporter x - (1 / 2 : ℝ)| = 1 / 2 := by
  induction x using OnePoint.rec <;> norm_num [oneEndedSetReporter]

/-- **Unconditional analytic critical-shell capstone.** Algebraic unitization retains a nonconstant
reporter, analytic admission is total, every finite aperture has exact margin one, and the best
constant global replacement has exact gap one half. -/
theorem oneEndedAdmissionCriticalShell :
    (∀ x, oneEndedSetReporter (evenRetraction x) = oneEndedSetReporter x) ∧
    (∀ x, oneEndedSetReporter (oddRetraction x) = oneEndedSetReporter x) ∧
    oneEndedSetReporter (0 : ℕ) ≠ oneEndedSetReporter OnePoint.infty ∧
    (∀ x y, analyticAdmissionRel oneEndedJoinedUnitization x y) ∧
    (∀ N, finiteAdmissionReporter N OnePoint.infty -
      finiteAdmissionReporter N (0 : ℕ) = 1) ∧
    (∀ c : ℝ, (1 / 2 : ℝ) ≤
      max |oneEndedSetReporter (0 : ℕ) - c|
        |oneEndedSetReporter OnePoint.infty - c|) ∧
    (∀ x, |oneEndedSetReporter x - (1 / 2 : ℝ)| = 1 / 2) := by
  exact ⟨oneEndedSetReporter_even, oneEndedSetReporter_odd,
    oneEndedSetReporter_distinguishes_end, oneEnded_analyticAdmission_total,
    finiteAdmissionReporter_exact_margin, oneEndedSetReporter_constant_gap_lower,
    oneEndedSetReporter_half_constant_exact⟩

end

end HTGeometry
