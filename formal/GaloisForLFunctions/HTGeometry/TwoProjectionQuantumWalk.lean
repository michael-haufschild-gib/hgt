import GaloisForLFunctions.HTGeometry.TwoProjectionSupersymmetry

/-!
# Two-projection quantum-walk polarization

Szegedy's discrete quantum walk is the product of the two reflections attached to a pair of
orthogonal projections.  For self-adjoint idempotents `P,Q`, put

`R_P = 2P - 1`, `R_Q = 2Q - 1`, and `W = R_P R_Q`.

The walk is automatically unitary.  Its Hermitian and anti-Hermitian defects retain both pieces
of the two-projection geometry exactly:

`(W-1)^*(W-1) = 4 (P-Q)^*(P-Q)`,

`W-W^* = 4 (PQ-QP)`.

Moreover its Hermitian phase signal is

`W+W^* = 2 - 4 (P-Q)^*(P-Q)`.

The denominator-free Chebyshev recurrence `C_0(X)=2`, `C_1(X)=X`,
`C_{n+2}(X)=X C_{n+1}(X)-C_n(X)` therefore gives

`C_n(2 - 4 (P-Q)^*(P-Q)) = W^n + (W^*)^n`.

Its odd companion `S_0(X)=0`, `S_1(X)=1`,
`S_{n+2}(X)=X S_{n+1}(X)-S_n(X)` gives

`W^n - (W^*)^n = S_n(2 - 4 (P-Q)^*(P-Q)) 4(PQ-QP)`.

Thus the walk phase does not introduce a new quadratic constraint.  It is an exact unitary
polarization of the projection-mismatch energy and projection commutator already present in the
corpus.  More strongly, every symmetric walk-phase power is already a polynomial in the mismatch
energy, while every antisymmetric power is the first commutator multiplied by such a polynomial.
The full Laurent phase hierarchy therefore has no further operator generator.  The relations are
static and use neither a time limit nor a spectral decomposition.
-/

namespace HTGeometry

noncomputable section

open ContinuousLinearMap

section CosineRecurrence

variable {R : Type*} [Ring R]

/-- The denominator-free cosine/Chebyshev recurrence.  On a unitary phase `U`, evaluating at
`U + U⁻¹` gives the symmetric phase power `Uⁿ + U⁻ⁿ`. -/
def unitaryCosineRecurrence (X : R) : ℕ → R
  | 0 => 1 + 1
  | 1 => X
  | n + 2 =>
      X * unitaryCosineRecurrence X (n + 1) -
        unitaryCosineRecurrence X n

/-- The denominator-free sine/Chebyshev recurrence paired with `unitaryCosineRecurrence`.
On an inverse pair it extracts the antisymmetric phase powers after multiplication by `U-V`. -/
def unitarySineRecurrence (X : R) : ℕ → R
  | 0 => 0
  | 1 => 1
  | n + 2 =>
      X * unitarySineRecurrence X (n + 1) -
        unitarySineRecurrence X n

/-- **Inverse-pair cosine law.**  If `U,V` are mutual two-sided inverses, every symmetric power
`Uⁿ+Vⁿ` is determined by the single Hermitian signal `U+V`.  This noncommutative-ring form avoids
division by two and requires no spectral theorem. -/
theorem unitaryCosineRecurrence_add_inversePair
    (U V : R) (hUV : U * V = 1) (hVU : V * U = 1) (n : ℕ) :
    unitaryCosineRecurrence (U + V) n = U ^ n + V ^ n := by
  induction n using Nat.twoStepInduction with
  | zero => simp [unitaryCosineRecurrence]
  | one => simp [unitaryCosineRecurrence]
  | more n ih0 ih1 =>
      rw [unitaryCosineRecurrence, ih1, ih0]
      have hUVpow : U * V ^ (n + 1) = V ^ n := by
        rw [pow_succ', ← mul_assoc, hUV, one_mul]
      have hVUpow : V * U ^ (n + 1) = U ^ n := by
        rw [pow_succ', ← mul_assoc, hVU, one_mul]
      have hUpow : U * U ^ (n + 1) = U ^ (n + 2) :=
        (pow_succ' U (n + 1)).symm
      have hVpow : V * V ^ (n + 1) = V ^ (n + 2) :=
        (pow_succ' V (n + 1)).symm
      calc
        (U + V) * (U ^ (n + 1) + V ^ (n + 1)) - (U ^ n + V ^ n) =
            U * U ^ (n + 1) + U * V ^ (n + 1) +
              V * U ^ (n + 1) + V * V ^ (n + 1) - U ^ n - V ^ n := by
              noncomm_ring
        _ = U * U ^ (n + 1) + V * V ^ (n + 1) := by
              rw [hUVpow, hVUpow]
              noncomm_ring
        _ = U ^ (n + 2) + V ^ (n + 2) := by rw [hUpow, hVpow]

/-- **Inverse-pair sine law.**  Every antisymmetric inverse-pair power factors through the first
phase difference.  Together with `unitaryCosineRecurrence_add_inversePair`, this shows that the
whole Laurent phase hierarchy is generated by `U+V` and `U-V`. -/
theorem unitarySineRecurrence_mul_sub_inversePair
    (U V : R) (hUV : U * V = 1) (hVU : V * U = 1) (n : ℕ) :
    unitarySineRecurrence (U + V) n * (U - V) = U ^ n - V ^ n := by
  induction n using Nat.twoStepInduction with
  | zero => simp [unitarySineRecurrence]
  | one => simp [unitarySineRecurrence]
  | more n ih0 ih1 =>
      rw [unitarySineRecurrence, sub_mul, mul_assoc, ih1, ih0]
      have hUVpow : U * V ^ (n + 1) = V ^ n := by
        rw [pow_succ', ← mul_assoc, hUV, one_mul]
      have hVUpow : V * U ^ (n + 1) = U ^ n := by
        rw [pow_succ', ← mul_assoc, hVU, one_mul]
      have hUpow : U * U ^ (n + 1) = U ^ (n + 2) :=
        (pow_succ' U (n + 1)).symm
      have hVpow : V * V ^ (n + 1) = V ^ (n + 2) :=
        (pow_succ' V (n + 1)).symm
      calc
        (U + V) * (U ^ (n + 1) - V ^ (n + 1)) - (U ^ n - V ^ n) =
            U * U ^ (n + 1) - U * V ^ (n + 1) +
              V * U ^ (n + 1) - V * V ^ (n + 1) - U ^ n + V ^ n := by
              noncomm_ring
        _ = U * U ^ (n + 1) - V * V ^ (n + 1) := by
              rw [hUVpow, hVUpow]
              noncomm_ring
        _ = U ^ (n + 2) - V ^ (n + 2) := by rw [hUpow, hVpow]

end CosineRecurrence

variable {k E : Type*} [RCLike k]
  [NormedAddCommGroup E] [InnerProductSpace k E] [CompleteSpace E]

/-- The self-adjoint reflection `2P-1` attached to a projection candidate `P`. -/
def projectionReflection (P : E →L[k] E) : E →L[k] E :=
  P + P - 1

/-- The discrete quantum walk generated by the reflections of two projection candidates. -/
def twoProjectionQuantumWalk (P Q : E →L[k] E) : E →L[k] E :=
  projectionReflection P * projectionReflection Q

omit [CompleteSpace E] in
/-- Idempotence is exactly what makes the associated reflection involutive. -/
theorem projectionReflection_sq_eq_one
    (P : E →L[k] E) (hP : IsIdempotentElem P) :
    projectionReflection P * projectionReflection P = 1 := by
  rw [projectionReflection]
  have hPP : P * P = P := hP
  noncomm_ring [hPP]

/-- A self-adjoint projection gives a self-adjoint reflection. -/
theorem adjoint_projectionReflection
    (P : E →L[k] E) (hPadj : adjoint P = P) :
    adjoint (projectionReflection P) = projectionReflection P := by
  simp [projectionReflection, hPadj]

/-- The adjoint of a two-reflection walk reverses the order of its reflections. -/
theorem adjoint_twoProjectionQuantumWalk
    (P Q : E →L[k] E)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    adjoint (twoProjectionQuantumWalk P Q) =
      projectionReflection Q * projectionReflection P := by
  rw [twoProjectionQuantumWalk]
  change adjoint (projectionReflection P ∘L projectionReflection Q) =
    projectionReflection Q ∘L projectionReflection P
  rw [adjoint_comp, adjoint_projectionReflection P hPadj,
    adjoint_projectionReflection Q hQadj]

/-- The product of two orthogonal reflections is automatically unitary.  Consumers need supply
only the projection laws; no separate norm-preservation hypothesis remains. -/
theorem twoProjectionQuantumWalk_adjoint_mul_self
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    adjoint (twoProjectionQuantumWalk P Q) * twoProjectionQuantumWalk P Q = 1 := by
  rw [adjoint_twoProjectionQuantumWalk P Q hPadj hQadj,
    twoProjectionQuantumWalk]
  calc
    (projectionReflection Q * projectionReflection P) *
        (projectionReflection P * projectionReflection Q) =
      projectionReflection Q *
        (projectionReflection P * projectionReflection P) *
          projectionReflection Q := by simp only [mul_assoc]
    _ = projectionReflection Q * projectionReflection Q := by
      rw [projectionReflection_sq_eq_one P hP, mul_one]
    _ = 1 := projectionReflection_sq_eq_one Q hQ

/-- The complementary unitarity orientation.  Keeping both multiplication orders available lets
the walk and its adjoint be consumed as an abstract inverse pair without another hypothesis. -/
theorem twoProjectionQuantumWalk_mul_adjoint
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    twoProjectionQuantumWalk P Q * adjoint (twoProjectionQuantumWalk P Q) = 1 := by
  rw [adjoint_twoProjectionQuantumWalk P Q hPadj hQadj,
    twoProjectionQuantumWalk]
  calc
    (projectionReflection P * projectionReflection Q) *
        (projectionReflection Q * projectionReflection P) =
      projectionReflection P *
        (projectionReflection Q * projectionReflection Q) *
          projectionReflection P := by simp only [mul_assoc]
    _ = projectionReflection P * projectionReflection P := by
      rw [projectionReflection_sq_eq_one Q hQ, mul_one]
    _ = 1 := projectionReflection_sq_eq_one P hP

omit [CompleteSpace E] in
/-- **Compressed-walk value law.**  Compressing the walk shifted by `+1` to its second
projection gives exactly twice the corresponding alternating compression.  This is the direct
operator bridge from the unitary walk coordinate to localization/prolate blocks already used by
the two-projection corpus. -/
theorem secondProjection_compress_twoProjectionQuantumWalk_add_one_eq_two_mul_compression
    (P Q : E →L[k] E) (hQ : IsIdempotentElem Q) :
    Q * (twoProjectionQuantumWalk P Q + 1) * Q =
      2 * (Q * P * Q) := by
  simp only [twoProjectionQuantumWalk, projectionReflection]
  have hQQ : Q * Q = Q := hQ
  noncomm_ring [hQQ]

/-- **Quantum-walk commutator polarization.**  The anti-Hermitian part of the two-reflection
walk is exactly four times the commutator of the underlying projections. -/
theorem twoProjectionQuantumWalk_sub_adjoint_eq_four_mul_commutator
    (P Q : E →L[k] E)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    twoProjectionQuantumWalk P Q - adjoint (twoProjectionQuantumWalk P Q) =
      4 * (P * Q - Q * P) := by
  rw [adjoint_twoProjectionQuantumWalk P Q hPadj hQadj]
  simp only [twoProjectionQuantumWalk, projectionReflection]
  noncomm_ring

/-- **Quantum-walk master-constraint law.**  The scattering-defect energy of the automatically
unitary two-reflection walk is exactly four times the projection-mismatch energy.  Hence a walk
master-constraint estimate and a projection-difference estimate are interchangeable without a
comparison loss or an additional unitarity premise. -/
theorem quantumMasterConstraint_twoProjectionQuantumWalk_sub_one_eq_four_mul_difference
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    quantumMasterConstraint (twoProjectionQuantumWalk P Q - 1) =
      4 * quantumMasterConstraint (P - Q) := by
  have hunitary := twoProjectionQuantumWalk_adjoint_mul_self
    P Q hP hQ hPadj hQadj
  have hdiffAdj : adjoint (P - Q) = P - Q := by
    simp [hPadj, hQadj]
  have hmasterDiff : quantumMasterConstraint (P - Q) = (P - Q) * (P - Q) := by
    simp only [quantumMasterConstraint, ContinuousLinearMap.mul_def, hdiffAdj]
  rw [quantumMasterConstraint_unitarySubOne_eq_two_sub_self_sub_adjoint
      (twoProjectionQuantumWalk P Q) hunitary,
    adjoint_twoProjectionQuantumWalk P Q hPadj hQadj,
    hmasterDiff]
  simp only [twoProjectionQuantumWalk, projectionReflection]
  have hPP : P * P = P := hP
  have hQQ : Q * Q = Q := hQ
  rw [show (2 : E →L[k] E) = 1 + 1 by norm_num]
  noncomm_ring [hPP, hQQ]

/-- **Qubitization signal law.**  The Hermitian phase signal of the reflection walk is exactly the
affine image of the projection-mismatch master constraint.  Thus its cosine phase is available
without choosing eigenvectors or introducing an inverse trigonometric function. -/
theorem twoProjectionQuantumWalk_add_adjoint_eq_two_sub_four_mul_difference
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) :
    twoProjectionQuantumWalk P Q + adjoint (twoProjectionQuantumWalk P Q) =
      2 - 4 * quantumMasterConstraint (P - Q) := by
  have hunitary := twoProjectionQuantumWalk_adjoint_mul_self
    P Q hP hQ hPadj hQadj
  have hdefect :=
    quantumMasterConstraint_twoProjectionQuantumWalk_sub_one_eq_four_mul_difference
      P Q hP hQ hPadj hQadj
  rw [quantumMasterConstraint_unitarySubOne_eq_two_sub_self_sub_adjoint
      (twoProjectionQuantumWalk P Q) hunitary] at hdefect
  rw [← hdefect]
  rw [show (2 : E →L[k] E) = 1 + 1 by norm_num]
  abel

/-- **All-order symmetric phase collapse.**  Every symmetric power of the two-reflection walk is
a fixed recurrence polynomial in the projection-mismatch energy.  Consequently symmetric
walk-phase moments cannot be used as an independent source hypothesis; antisymmetric powers are
handled by the companion factorization below. -/
theorem unitaryCosineRecurrence_twoProjectionQuantumWalk
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) (n : ℕ) :
    unitaryCosineRecurrence
        (2 - 4 * quantumMasterConstraint (P - Q)) n =
      twoProjectionQuantumWalk P Q ^ n +
        adjoint (twoProjectionQuantumWalk P Q) ^ n := by
  rw [← twoProjectionQuantumWalk_add_adjoint_eq_two_sub_four_mul_difference
    P Q hP hQ hPadj hQadj]
  exact unitaryCosineRecurrence_add_inversePair
    (twoProjectionQuantumWalk P Q)
    (adjoint (twoProjectionQuantumWalk P Q))
    (twoProjectionQuantumWalk_mul_adjoint P Q hP hQ hPadj hQadj)
    (twoProjectionQuantumWalk_adjoint_mul_self P Q hP hQ hPadj hQadj)
    n

/-- **All-order antisymmetric phase collapse.**  Every oriented phase power is the first
projection commutator multiplied by a fixed recurrence polynomial in mismatch energy.  Higher
raw walk powers therefore introduce no operator generator beyond the mismatch and commutator
channels already present at first order. -/
theorem twoProjectionQuantumWalk_pow_sub_adjoint_pow_eq_sineRecurrence_mul_commutator
    (P Q : E →L[k] E)
    (hP : IsIdempotentElem P) (hQ : IsIdempotentElem Q)
    (hPadj : adjoint P = P) (hQadj : adjoint Q = Q) (n : ℕ) :
    twoProjectionQuantumWalk P Q ^ n -
        adjoint (twoProjectionQuantumWalk P Q) ^ n =
      unitarySineRecurrence
          (2 - 4 * quantumMasterConstraint (P - Q)) n *
        (4 * (P * Q - Q * P)) := by
  rw [← twoProjectionQuantumWalk_add_adjoint_eq_two_sub_four_mul_difference
      P Q hP hQ hPadj hQadj,
    ← twoProjectionQuantumWalk_sub_adjoint_eq_four_mul_commutator
      P Q hPadj hQadj]
  exact (unitarySineRecurrence_mul_sub_inversePair
    (twoProjectionQuantumWalk P Q)
    (adjoint (twoProjectionQuantumWalk P Q))
    (twoProjectionQuantumWalk_mul_adjoint P Q hP hQ hPadj hQadj)
    (twoProjectionQuantumWalk_adjoint_mul_self P Q hP hQ hPadj hQadj)
    n).symm

end

end HTGeometry
