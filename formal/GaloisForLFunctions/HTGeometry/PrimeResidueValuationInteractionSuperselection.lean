import GaloisForLFunctions.HTGeometry.PrimeResidueInteractionSpectrum
import GaloisForLFunctions.HTGeometry.PrimeValuationVeroneseDifferentialBasis
import GaloisForLFunctions.HTGeometry.PrimeValuationFusion
import GaloisForLFunctions.HTGeometry.ZetaPrimeValuationFiniteWindow

/-!
# Prime-residue valuation--interaction superselection

A tail-complete finite product residue profile carries two independent gradings. Prime-power
valuation gives the vertical depth, while tensor support in the finite residue product gives the
horizontal interaction breadth. Every finite depth--breadth rectangle is jointly differentially
independent. More strongly, any selected support sector is relatively hypertranscendental over
the field generated by its complete complement, with an exact rectangular rank spectrum.

Prime-local valuation fusion adds vertical degrees but only unions horizontal coordinate
supports. Overlap therefore loses principal interaction degree. Arbitrary polynomial degree in a
fixed support never enlarges that support. More strongly, the differential fields generated by
complete finite depth prefixes form a strict infinite tower: the entire next layer is relatively
hypertranscendental over the complete prefix, even though exact prime-local fusion of two prefix
columns lands in that next layer. The formal zeta prime-power ghost is identified with the unique
empty-support vector of every such grid.
-/

namespace GaloisForLFunctions.HTGeometry

open Set Module

noncomputable section

universe u

set_option maxHeartbeats 400000
set_option synthInstance.maxHeartbeats 80000

def primeResidueInteractionCoefficient
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (z : ∀ i, A i) (p : Nat.Primes) : ℂ :=
  anchoredProductBasis A z (y p)

theorem primeResidueInteractionCoefficient_patternRangeFinite
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    (Set.range (coefficientPattern (primeResidueInteractionCoefficient A y))).Finite := by
  let F : (∀ i, A i) → ((∀ i, A i) → ℂ) := fun w z =>
    anchoredProductBasis A z w
  apply (Set.finite_range F).subset
  rintro _ ⟨p, rfl⟩
  exact ⟨y p, rfl⟩

theorem primeResidueInteractionCoefficient_tailIndependent
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [Fintype (∀ i, A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    TailCoefficientIndependent (primeResidueInteractionCoefficient A y) := by
  change TailCoefficientIndependent (fun z p => anchoredProductBasis A z (y p))
  rw [cofiniteTailDenseOn_tailCoefficientIndependent_iff y Set.univ hy
    (fun z => anchoredProductBasis A z)
    (fun _ => continuous_of_discreteTopology)]
  simpa [anchoredRestrictedProductBasis, fullValueFunctionLinearEquiv] using!
    (anchoredRestrictedProductBasis A).linearIndependent

def primeResidueValuationInteractionCarrier
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (e : ℕ) (z : ∀ i, A i) (a : ℂ) :
    arithmeticFunctionRationalCoordinateField :=
  primePowerCoefficientShiftCarrier e
    (primeResidueInteractionCoefficient A y z) a

/-- Every finite valuation-depth by residue-interaction rectangle is jointly differentially
independent. -/
theorem cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ)
    (B : Fin d → Type u) [∀ r, Fintype (B r)] [∀ r, DecidableEq (B r)]
    [∀ r, Nonempty (B r)]
    [Nonempty (Σ r : Fin d, (∀ i, A i) × B r)]
    (alpha : ∀ r, B r → ℂ)
    (hdistinct : ∀ r, Function.Injective (fun b => (alpha r b).re)) :
    GaloisForLFunctions.DifferentialIndependent
      finitePrimeRationalCoefficientField
      (fun x : Σ r : Fin d, (∀ i, A i) × B r =>
        primeResidueValuationInteractionCarrier A y x.1 x.2.1
          (alpha x.1 x.2.2)) := by
  letI : Fintype (∀ i, A i) := Fintype.ofFinite _
  letI : DecidableEq (∀ i, A i) := Classical.decEq _
  exact primePowerCoefficientShiftPalettes_differentialIndependent
    (fun _r : Fin d => ∀ i, A i) B
    (fun _r => primeResidueInteractionCoefficient A y) alpha hdistinct
    (fun _r => primeResidueInteractionCoefficient_patternRangeFinite A y)
    (fun _r => primeResidueInteractionCoefficient_tailIndependent A y hy)

abbrev PrimeResidueValuationInteractionGridIndex
    (d : ℕ) {ι : Type u} (A : ι → Type u) :=
  Σ _r : Fin d, ∀ i, A i

def primeResidueValuationInteractionGridCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (x : PrimeResidueValuationInteractionGridIndex d A) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionCarrier A y x.1 x.2 0

/-- Every finite depth rectangle contains a full copy of every residue interaction sector, and
all cells in the rectangle are jointly differentially independent. -/
theorem cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent_zeroShift
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d) :
    GaloisForLFunctions.DifferentialIndependent
      finitePrimeRationalCoefficientField
      (primeResidueValuationInteractionGridCarrier A y :
        PrimeResidueValuationInteractionGridIndex d A → _) := by
  letI : Fintype (∀ i, A i) := Fintype.ofFinite _
  letI : DecidableEq (∀ i, A i) := Classical.decEq _
  letI : Nonempty (Σ r : Fin d, (∀ i, A i) × ULift.{u} Unit) :=
    ⟨⟨⟨0, hd⟩, (fun _ => 1), ULift.up ()⟩⟩
  have h := cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent
    A y hy (fun _r : Fin d => ULift.{u} Unit) (fun _r _u => 0)
      (fun _r _a _b _h => Subsingleton.elim _ _)
  let embed : PrimeResidueValuationInteractionGridIndex d A →
      Σ r : Fin d, (∀ i, A i) × ULift.{u} Unit :=
    fun x => ⟨x.1, (x.2, ULift.up ())⟩
  have hembed : Function.Injective embed := by
    rintro ⟨r, z⟩ ⟨s, w⟩ h
    simp only [embed, Sigma.mk.injEq] at h
    rcases h with ⟨rfl, hzw⟩
    simp only [heq_eq_eq] at hzw
    cases hzw
    rfl
  have hsub := h.comp embed hembed
  change GaloisForLFunctions.DifferentialIndependent
    finitePrimeRationalCoefficientField
    (fun x : PrimeResidueValuationInteractionGridIndex d A =>
      primeResidueValuationInteractionCarrier A y x.1 x.2 0)
  simpa [Function.comp_def, embed,
    primeResidueValuationInteractionCarrier] using hsub

abbrev PrimeResidueValuationGridSectorIndex
    (d : ℕ) {ι : Type u} (A : ι → Type u)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop) :=
  {x : PrimeResidueValuationInteractionGridIndex d A // Q x}

abbrev PrimeResidueValuationGridSectorComplementIndex
    (d : ℕ) {ι : Type u} (A : ι → Type u)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop) :=
  {x : PrimeResidueValuationInteractionGridIndex d A // ¬ Q x}

def primeResidueValuationGridSectorCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop)
    (x : PrimeResidueValuationGridSectorIndex d A Q) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionGridCarrier A y x.1

def primeResidueValuationGridSectorComplementCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop)
    (x : PrimeResidueValuationGridSectorComplementIndex d A Q) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionGridCarrier A y x.1

/-- **Arbitrary grid-sector superselection.** Every selected set of cells in a positive finite
valuation--interaction grid is relatively hypertranscendental over the differential field
generated by its complete grid complement. The selection may couple valuation depth and residue
support in an arbitrary way. -/
theorem cofiniteTailDenseOn_primeResidueValuationGridSector_relativeHT
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d)
    (Q : PrimeResidueValuationInteractionGridIndex d A → Prop) :
    GaloisForLFunctions.DifferentialIndependent
      (GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationGridSectorComplementCarrier A y Q)))
      (primeResidueValuationGridSectorCarrier A y Q) := by
  let total := PrimeResidueValuationInteractionGridIndex d A
  let other := PrimeResidueValuationGridSectorComplementIndex d A Q
  let cell := PrimeResidueValuationGridSectorIndex d A Q
  let full : total → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationInteractionGridCarrier A y
  let left : other → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationGridSectorComplementCarrier A y Q
  let right : cell → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationGridSectorCarrier A y Q
  have hfull :=
    cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent_zeroShift
      A y hy hd
  let embed : other ⊕ cell → total
    | Sum.inl x => x.1
    | Sum.inr x => x.1
  have hembed : Function.Injective embed := by
    intro x z hxz
    rcases x with x | x <;> rcases z with z | z
    · exact congrArg Sum.inl (Subtype.ext hxz)
    · exfalso
      change x.1 = z.1 at hxz
      apply x.2
      rw [hxz]
      exact z.2
    · exfalso
      change x.1 = z.1 at hxz
      apply z.2
      rw [← hxz]
      exact x.2
    · exact congrArg Sum.inr (Subtype.ext hxz)
  have hjoint := hfull.comp embed hembed
  have hfamily : full ∘ embed = Sum.elim left right := by
    funext x
    rcases x with x | x <;> rfl
  have hjoint' : GaloisForLFunctions.DifferentialIndependent
      finitePrimeRationalCoefficientField (Sum.elim left right) := by
    rw [← hfamily]
    exact hjoint
  exact GaloisForLFunctions.differentialIndependent_sum_right_over_left_differentialAdjoin
    left right hjoint'

abbrev PrimeResidueValuationDepthPrefixIndex
    (n : ℕ) {ι : Type u} (A : ι → Type u) :=
  PrimeResidueValuationGridSectorComplementIndex (n + 2) A
    (fun x => x.1.1 = n + 1)

abbrev PrimeResidueValuationNextLayerIndex
    (n : ℕ) {ι : Type u} (A : ι → Type u) :=
  PrimeResidueValuationGridSectorIndex (n + 2) A
    (fun x => x.1.1 = n + 1)

abbrev primeResidueValuationDepthPrefixCarrier
    {n : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :=
  primeResidueValuationGridSectorComplementCarrier A y
    (fun x : PrimeResidueValuationInteractionGridIndex (n + 2) A =>
      x.1.1 = n + 1)

abbrev primeResidueValuationNextLayerCarrier
    {n : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :=
  primeResidueValuationGridSectorCarrier A y
    (fun x : PrimeResidueValuationInteractionGridIndex (n + 2) A =>
      x.1.1 = n + 1)

def primeResidueValuationDepthPrefixField
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) :
    IntermediateField finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  GaloisForLFunctions.differentialAdjoin
    finitePrimeRationalCoefficientField
    (Set.range (primeResidueValuationDepthPrefixCarrier (n := n) A y))

def primeResidueValuationNextLayerIndexEquiv
    (n : ℕ) {ι : Type u} (A : ι → Type u) :
    PrimeResidueValuationNextLayerIndex n A ≃ (∀ i, A i) where
  toFun x := x.1.2
  invFun z := ⟨⟨⟨n + 1, by omega⟩, z⟩, rfl⟩
  left_inv x := by
    apply Subtype.ext
    apply Sigma.ext
    · exact Fin.ext x.2.symm
    · rfl
  right_inv _ := rfl

theorem primeResidueValuationNextLayerIndex_card
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] :
    Nat.card (PrimeResidueValuationNextLayerIndex n A) =
      ∏ i, Fintype.card (A i) := by
  rw [Nat.card_congr (primeResidueValuationNextLayerIndexEquiv n A), Nat.card_pi]
  simp only [Nat.card_eq_fintype_card]

/-- **Strict layer creation.** The complete next valuation layer is relatively
hypertranscendental over the differential field generated by every residue cell in every earlier
layer. Its exact relative rank is the size of the complete residue state space. -/
theorem cofiniteTailDenseOn_primeResidueValuationNextLayer_relativeHT_over_completePrefix
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    GaloisForLFunctions.DifferentialIndependent
        (primeResidueValuationDepthPrefixField n A y)
        (primeResidueValuationNextLayerCarrier (n := n) A y) ∧
      Nat.card (PrimeResidueValuationNextLayerIndex n A) =
        ∏ i, Fintype.card (A i) := by
  constructor
  · simpa only [primeResidueValuationDepthPrefixField,
      primeResidueValuationDepthPrefixCarrier,
      primeResidueValuationNextLayerCarrier] using!
      (cofiniteTailDenseOn_primeResidueValuationGridSector_relativeHT
        A y hy (by omega)
          (fun x : PrimeResidueValuationInteractionGridIndex (n + 2) A =>
            x.1.1 = n + 1))
  · exact primeResidueValuationNextLayerIndex_card n A

/-- Every individual cell in the next valuation layer is absent from the differential field
generated by the complete earlier-depth prefix. -/
theorem cofiniteTailDenseOn_primeResidueValuationNextLayer_not_mem_completePrefix
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (z : ∀ i, A i) :
    primeResidueValuationInteractionCarrier A y (n + 1) z 0 ∉
      primeResidueValuationDepthPrefixField n A y := by
  let out : PrimeResidueValuationNextLayerIndex n A :=
    ⟨⟨⟨n + 1, by omega⟩, z⟩, rfl⟩
  have hrel :=
    (cofiniteTailDenseOn_primeResidueValuationNextLayer_relativeHT_over_completePrefix
      n A y hy).1
  unfold GaloisForLFunctions.DifferentialIndependent at hrel
  have hout :
      primeResidueValuationNextLayerCarrier (n := n) A y out =
        primeResidueValuationInteractionCarrier A y (n + 1) z 0 := by
    rfl
  have htrans : Transcendental (primeResidueValuationDepthPrefixField n A y)
      (primeResidueValuationInteractionCarrier A y (n + 1) z 0) := by
    rw [← hout]
    simpa using hrel.transcendental (out, 0)
  intro hmem
  apply htrans
  exact isAlgebraic_algebraMap
    (R := primeResidueValuationDepthPrefixField n A y)
    (A := arithmeticFunctionRationalCoordinateField)
    (⟨primeResidueValuationInteractionCarrier A y (n + 1) z 0, hmem⟩ :
      primeResidueValuationDepthPrefixField n A y)

/-- The complete depth-prefix fields form a strictly ascending infinite tower. At every step the
entire next residue layer is new, not merely one chosen coordinate. -/
theorem cofiniteTailDenseOn_primeResidueValuationDepthPrefixField_strictMono
    (n : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) :
    primeResidueValuationDepthPrefixField n A y <
      primeResidueValuationDepthPrefixField (n + 1) A y := by
  have hrange :
      Set.range (primeResidueValuationDepthPrefixCarrier (n := n) A y) ⊆
        Set.range (primeResidueValuationDepthPrefixCarrier (n := n + 1) A y) := by
    rintro _ ⟨q, rfl⟩
    let q' : PrimeResidueValuationDepthPrefixIndex (n + 1) A :=
      ⟨⟨⟨q.1.1.1, by omega⟩, q.1.2⟩, by
        change q.1.1.1 ≠ n + 1 + 1
        omega⟩
    exact ⟨q', rfl⟩
  have hle : primeResidueValuationDepthPrefixField n A y ≤
      primeResidueValuationDepthPrefixField (n + 1) A y := by
    unfold primeResidueValuationDepthPrefixField
    unfold GaloisForLFunctions.differentialAdjoin
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨x, hx, k, rfl⟩
    exact IntermediateField.subset_adjoin finitePrimeRationalCoefficientField _
      ⟨x, hrange hx, k, rfl⟩
  let vacuum : ∀ i, A i := fun _ => 1
  have hnot : primeResidueValuationInteractionCarrier A y (n + 1) vacuum 0 ∉
      primeResidueValuationDepthPrefixField n A y :=
    cofiniteTailDenseOn_primeResidueValuationNextLayer_not_mem_completePrefix
      n A y hy vacuum
  have hmem : primeResidueValuationInteractionCarrier A y (n + 1) vacuum 0 ∈
      primeResidueValuationDepthPrefixField (n + 1) A y := by
    let q : PrimeResidueValuationDepthPrefixIndex (n + 1) A :=
      ⟨⟨⟨n + 1, by omega⟩, vacuum⟩, by
        change n + 1 ≠ n + 1 + 1
        omega⟩
    change primeResidueValuationInteractionCarrier A y (n + 1) vacuum 0 ∈
      GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationDepthPrefixCarrier (n := n + 1) A y))
    exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨q, rfl⟩
  exact lt_of_le_of_ne hle fun heq => hnot (heq ▸ hmem)

abbrev PrimeResidueValuationInputPairIndex
    {d : ℕ} {ι : Type u} (A : ι → Type u)
    (x z : PrimeResidueValuationInteractionGridIndex d A) :=
  {q : PrimeResidueValuationInteractionGridIndex d A // q = x ∨ q = z}

def primeResidueValuationInputPairCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i)
    (x z : PrimeResidueValuationInteractionGridIndex d A)
    (q : PrimeResidueValuationInputPairIndex A x z) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionGridCarrier A y q.1

/-- A third cell of the valuation--interaction grid is not in the differential field generated
by any selected pair of other cells. The input pair may itself collapse to one cell. -/
theorem cofiniteTailDenseOn_primeResidueValuationGrid_third_not_mem_pairField
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d)
    (x z out : PrimeResidueValuationInteractionGridIndex d A)
    (houtx : out ≠ x) (houtz : out ≠ z) :
    primeResidueValuationInteractionGridCarrier A y out ∉
      GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationInputPairCarrier A y x z)) := by
  let pair := PrimeResidueValuationInputPairIndex A x z
  let left : pair → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationInputPairCarrier A y x z
  let right : Unit → arithmeticFunctionRationalCoordinateField :=
    fun _ => primeResidueValuationInteractionGridCarrier A y out
  have hfull :=
    cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent_zeroShift
      A y hy hd
  let embed : pair ⊕ Unit → PrimeResidueValuationInteractionGridIndex d A
    | Sum.inl q => q.1
    | Sum.inr _ => out
  have hembed : Function.Injective embed := by
    intro a b hab
    rcases a with q | q <;> rcases b with r | r
    · exact congrArg Sum.inl (Subtype.ext hab)
    · exfalso
      rcases q.2 with hqx | hqz
      · exact houtx (hab.symm.trans hqx)
      · exact houtz (hab.symm.trans hqz)
    · exfalso
      rcases r.2 with hrx | hrz
      · exact houtx (hab.trans hrx)
      · exact houtz (hab.trans hrz)
    · exact congrArg Sum.inr (Subsingleton.elim q r)
  have hjoint := hfull.comp embed hembed
  have hfamily :
      primeResidueValuationInteractionGridCarrier A y ∘ embed =
        Sum.elim left right := by
    funext q
    rcases q with q | q <;> rfl
  have hjoint' : GaloisForLFunctions.DifferentialIndependent
      finitePrimeRationalCoefficientField (Sum.elim left right) := by
    rw [← hfamily]
    exact hjoint
  exact GaloisForLFunctions.differentialIndependent_sum_right_not_mem_left_differentialAdjoin
    left right hjoint' ()

abbrev PrimeResidueValuationInteractionSectorIndex
    (d : ℕ) {ι : Type u} (A : ι → Type u)
    (P : (∀ i, A i) → Prop) :=
  Fin d × {z : ∀ i, A i // P z}

abbrev PrimeResidueValuationInteractionSectorComplementIndex
    (d : ℕ) {ι : Type u} (A : ι → Type u)
    (P : (∀ i, A i) → Prop) :=
  {x : PrimeResidueValuationInteractionGridIndex d A // ¬ P x.2}

def primeResidueValuationInteractionSectorCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (P : (∀ i, A i) → Prop)
    (x : PrimeResidueValuationInteractionSectorIndex d A P) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionGridCarrier A y ⟨x.1, x.2.1⟩

def primeResidueValuationInteractionSectorComplementCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (P : (∀ i, A i) → Prop)
    (x : PrimeResidueValuationInteractionSectorComplementIndex d A P) :
    arithmeticFunctionRationalCoordinateField :=
  primeResidueValuationInteractionGridCarrier A y x.1

/-- Any selected union of residue-interaction cells is relatively HT over the field generated by
its complete complement in a positive finite valuation rectangle. -/
theorem cofiniteTailDenseOn_primeResidueValuationInteractionSector_relativeHT
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d)
    (P : (∀ i, A i) → Prop) :
    GaloisForLFunctions.DifferentialIndependent
      (GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationInteractionSectorComplementCarrier
          (d := d) A y P)))
      (primeResidueValuationInteractionSectorCarrier (d := d) A y P) := by
  let total := PrimeResidueValuationInteractionGridIndex d A
  let other := PrimeResidueValuationInteractionSectorComplementIndex d A P
  let cell := PrimeResidueValuationInteractionSectorIndex d A P
  let full : total → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationInteractionGridCarrier A y
  let left : other → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationInteractionSectorComplementCarrier A y P
  let right : cell → arithmeticFunctionRationalCoordinateField :=
    primeResidueValuationInteractionSectorCarrier A y P
  have hfull :=
    cofiniteTailDenseOn_primeResidueValuationInteractionGrid_differentialIndependent_zeroShift
      A y hy hd
  let embed : other ⊕ cell → total
    | Sum.inl x => x.1
    | Sum.inr x => ⟨x.1, x.2.1⟩
  have hembed : Function.Injective embed := by
    intro x z hxz
    rcases x with x | x <;> rcases z with z | z
    · exact congrArg Sum.inl (Subtype.ext hxz)
    · exfalso
      have hval := congrArg (fun w : total => w.2) hxz
      change x.1.2 = z.2.1 at hval
      exact x.2 (hval.symm ▸ z.2.2)
    · exfalso
      have hval := congrArg (fun w : total => w.2) hxz
      change x.2.1 = z.1.2 at hval
      exact z.2 (hval ▸ x.2.2)
    · apply congrArg Sum.inr
      apply Prod.ext
      · exact congrArg Sigma.fst hxz
      · apply Subtype.ext
        exact congrArg (fun w : total => w.2) hxz
  have hjoint := hfull.comp embed hembed
  have hfamily : full ∘ embed = Sum.elim left right := by
    funext x
    rcases x with x | x <;> rfl
  have hjoint' : GaloisForLFunctions.DifferentialIndependent
      finitePrimeRationalCoefficientField (Sum.elim left right) := by
    rw [← hfamily]
    exact hjoint
  exact GaloisForLFunctions.differentialIndependent_sum_right_over_left_differentialAdjoin
    left right hjoint'

abbrev PrimeResidueValuationSupportCellIndex
    (d : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (S : Finset ι) :=
  PrimeResidueValuationInteractionSectorIndex d A
    (fun z => pointedSupport A z = S)

abbrev PrimeResidueValuationSupportComplementIndex
    (d : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (S : Finset ι) :=
  PrimeResidueValuationInteractionSectorComplementIndex d A
    (fun z => pointedSupport A z = S)

abbrev primeResidueValuationSupportCellCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (S : Finset ι) :=
  primeResidueValuationInteractionSectorCarrier (d := d) A y
    (fun z => pointedSupport A z = S)

abbrev primeResidueValuationSupportComplementCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (S : Finset ι) :=
  primeResidueValuationInteractionSectorComplementCarrier (d := d) A y
    (fun z => pointedSupport A z = S)

theorem primeResidueValuationSupportCellIndex_card
    {d : ℕ} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)] (S : Finset ι) :
    Nat.card (PrimeResidueValuationSupportCellIndex d A S) =
      d * ∏ i ∈ S, (Fintype.card (A i) - 1) := by
  rw [Nat.card_prod, Nat.card_fin, exactPointedSupport_card A S]

/-- **Support-sector superselection.** In every positive finite valuation window, the complete
sector with exact residue support `S` is differentially independent over the field generated by
every carrier in every other support sector. Its exact relative rank is valuation depth times the
product of the local contrast ranks. -/
theorem cofiniteTailDenseOn_primeResidueValuationSupportSector_relativeHT
    {d : ℕ} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d) (S : Finset ι) :
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationSupportComplementCarrier
            (d := d) A y S)))
        (primeResidueValuationSupportCellCarrier (d := d) A y S) ∧
      Nat.card (PrimeResidueValuationSupportCellIndex d A S) =
        d * ∏ i ∈ S, (Fintype.card (A i) - 1) := by
  constructor
  · exact cofiniteTailDenseOn_primeResidueValuationInteractionSector_relativeHT
      A y hy hd (fun z => pointedSupport A z = S)
  · exact primeResidueValuationSupportCellIndex_card A S

abbrev PrimeResidueValuationOrderCellIndex
    (d : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (k : ℕ) :=
  PrimeResidueValuationInteractionSectorIndex d A
    (fun z => (pointedSupport A z).card = k)

abbrev PrimeResidueValuationOrderComplementIndex
    (d : ℕ) {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (k : ℕ) :=
  PrimeResidueValuationInteractionSectorComplementIndex d A
    (fun z => (pointedSupport A z).card = k)

abbrev primeResidueValuationOrderCellCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (k : ℕ) :=
  primeResidueValuationInteractionSectorCarrier (d := d) A y
    (fun z => (pointedSupport A z).card = k)

abbrev primeResidueValuationOrderComplementCarrier
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (k : ℕ) :=
  primeResidueValuationInteractionSectorComplementCarrier (d := d) A y
    (fun z => (pointedSupport A z).card = k)

theorem primeResidueValuationOrderCellIndex_card
    {d : ℕ} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)] (k : ℕ) :
    Nat.card (PrimeResidueValuationOrderCellIndex d A k) =
      d * ∑ S : {S : Finset ι // S.card = k},
        ∏ i ∈ S.1, (Fintype.card (A i) - 1) := by
  rw [Nat.card_prod, Nat.card_fin, exactSupportOrder_card A k]

/-- Each complete interaction order is relatively HT over all other interaction orders across
the whole finite valuation window, with a rectangular exact rank spectrum. -/
theorem cofiniteTailDenseOn_primeResidueValuationOrderSector_relativeHT
    {d : ℕ} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d) (k : ℕ) :
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationOrderComplementCarrier
            (d := d) A y k)))
        (primeResidueValuationOrderCellCarrier (d := d) A y k) ∧
      Nat.card (PrimeResidueValuationOrderCellIndex d A k) =
        d * ∑ S : {S : Finset ι // S.card = k},
          ∏ i ∈ S.1, (Fintype.card (A i) - 1) := by
  constructor
  · exact cofiniteTailDenseOn_primeResidueValuationInteractionSector_relativeHT
      A y hy hd (fun z => (pointedSupport A z).card = k)
  · exact primeResidueValuationOrderCellIndex_card A k

def polynomialObservable
    {σ V : Type*} (f : σ → V → ℂ) (Q : MvPolynomial σ ℂ) : V → ℂ :=
  fun v => MvPolynomial.eval (fun j => f j v) Q

/-- Arbitrary polynomial degree cannot enlarge residue breadth: a polynomial in observables that
all depend only on `S` still depends only on `S`. -/
theorem polynomialObservable_mem_coordinateInvariant
    {σ : Type*} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) (S : Finset ι)
    (f : σ → FullValueSubtype (∀ i, A i) → ℂ)
    (hf : ∀ j, f j ∈ ClassInvariantRestricted (coordinateAgreementSetoid A S))
    (Q : MvPolynomial σ ℂ) :
    polynomialObservable f Q ∈
      ClassInvariantRestricted (coordinateAgreementSetoid A S) := by
  intro x y hxy
  have hvalues : (fun j => f j x) = (fun j => f j y) := by
    funext j
    exact hf j x y hxy
  simp only [polynomialObservable]
  rw [hvalues]

def pointedUnion
    {ι : Type*} (A : ι → Type*) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (z w : ∀ i, A i) : ∀ i, A i :=
  fun i => if z i = 1 then w i else z i

theorem pointedSupport_pointedUnion
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : ι → Type*) [∀ i, DecidableEq (A i)] [∀ i, One (A i)]
    (z w : ∀ i, A i) :
    pointedSupport A (pointedUnion A z w) =
      pointedSupport A z ∪ pointedSupport A w := by
  ext i
  simp only [pointedSupport, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_union, pointedUnion]
  by_cases hz : z i = 1 <;> simp [hz]

/-- Disjoint anchored interaction basis vectors multiply exactly to the basis vector on the union
support. -/
theorem anchoredRestrictedProductBasis_mul_of_disjoint
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (z w : ∀ i, A i)
    (hdis : Disjoint (pointedSupport A z) (pointedSupport A w)) :
    anchoredRestrictedProductBasis A z * anchoredRestrictedProductBasis A w =
      anchoredRestrictedProductBasis A (pointedUnion A z w) := by
  funext x
  rw [Pi.mul_apply, anchoredRestrictedProductBasis_apply,
    anchoredRestrictedProductBasis_apply,
    anchoredRestrictedProductBasis_apply, ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i _hi
  by_cases hz : z i = 1
  · simp [pointedUnion, hz]
  · have hzi : i ∈ pointedSupport A z := by
      simp [pointedSupport, hz]
    have hw : w i = 1 := by
      by_contra hw
      have hwi : i ∈ pointedSupport A w := by
        simp [pointedSupport, hw]
      exact (Finset.disjoint_left.mp hdis hzi hwi)
    simp [pointedUnion, hz, hw]

/-- A coordinate union is the exact support upper bound for multiplication, independently of the
chosen tensor coordinates. -/
theorem coordinateInvariant_mul_mem_interactionFiltration_union
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (S T : Finset ι) {f g : FullValueSubtype (∀ i, A i) → ℂ}
    (hf : f ∈ ClassInvariantRestricted (coordinateAgreementSetoid A S))
    (hg : g ∈ ClassInvariantRestricted (coordinateAgreementSetoid A T)) :
    f * g ∈ anchoredRestrictedInteractionFiltration A (S ∪ T).card := by
  rw [anchoredRestrictedInteractionFiltration_eq_intrinsic A (S ∪ T).card]
  let ST : {R : Finset ι // R.card ≤ (S ∪ T).card} := ⟨S ∪ T, le_rfl⟩
  exact (show ClassInvariantRestricted (coordinateAgreementSetoid A ST.1) ≤
      intrinsicCoordinateInteractionFiltration A (S ∪ T).card from
    le_iSup (fun R => ClassInvariantRestricted
      (coordinateAgreementSetoid A R.1)) ST)
    (coordinateInvariant_mul_mem_union A S T hf hg)

/-- Overlapping interaction supports strictly lose principal interaction degree under
multiplication. This is the hard-core collision law behind the associated graded algebra. -/
theorem coordinateInvariant_mul_interactionDegree_drop_of_overlap
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (S T : Finset ι) (hoverlap : ¬ Disjoint S T)
    {f g : FullValueSubtype (∀ i, A i) → ℂ}
    (hf : f ∈ ClassInvariantRestricted (coordinateAgreementSetoid A S))
    (hg : g ∈ ClassInvariantRestricted (coordinateAgreementSetoid A T)) :
    f * g ∈ anchoredRestrictedInteractionFiltration A (S ∪ T).card ∧
      (S ∪ T).card < S.card + T.card := by
  constructor
  · exact coordinateInvariant_mul_mem_interactionFiltration_union A S T hf hg
  · exact (Finset.card_union_le S T).lt_of_ne
      (fun h => hoverlap (Finset.card_union_eq_card_add_card.mp h))

def primeResidueValuationObservableColumn
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)]
    (y : Nat.Primes → ∀ i, A i) (e : ℕ)
    (f : FullValueSubtype (∀ i, A i) → ℂ) : ArithmeticFunction ℂ :=
  arithmeticOfPrimePowerColumn e fun p => f ⟨y p, Set.mem_univ _⟩

/-- Valuation depth adds while residue breadth unions: prime-local fusion is literally pointwise
observable multiplication on the next valuation layer. -/
theorem primeResidueValuationObservableColumn_fusion
    {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)]
    (y : Nat.Primes → ∀ i, A i) (e r : ℕ)
    (f g : FullValueSubtype (∀ i, A i) → ℂ) :
    primeValuationFusion e r
        (primeResidueValuationObservableColumn A y e f)
        (primeResidueValuationObservableColumn A y r g) =
      primeResidueValuationObservableColumn A y (e + r + 1) (f * g) := by
  exact primeValuationFusion_columns e r
    (fun p => f ⟨y p, Set.mem_univ _⟩)
    (fun p => g ⟨y p, Set.mem_univ _⟩)

/-- On disjoint pure interaction supports, fusion reaches the union sector exactly, with no lower
support leakage. -/
theorem primeResidueValuationAnchoredBasisColumn_fusion_of_disjoint
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (e r : ℕ) (z w : ∀ i, A i)
    (hdis : Disjoint (pointedSupport A z) (pointedSupport A w)) :
    primeValuationFusion e r
        (primeResidueValuationObservableColumn A y e
          (anchoredRestrictedProductBasis A z))
        (primeResidueValuationObservableColumn A y r
          (anchoredRestrictedProductBasis A w)) =
      primeResidueValuationObservableColumn A y (e + r + 1)
        (anchoredRestrictedProductBasis A (pointedUnion A z w)) := by
  rw [primeResidueValuationObservableColumn_fusion,
    anchoredRestrictedProductBasis_mul_of_disjoint A z w hdis]

/-- **Finite-prefix fusion escape.** Let `K_n` be the differential field generated by every
residue-interaction carrier in valuation layers `0,…,n`. Both input carriers below lie in `K_n`,
and their prime-local fusion is exactly the union-support carrier in layer `n+1`; nevertheless
that output carrier is not in `K_n`. Thus no finite complete source prefix is closed under the
fusion operation that its own prime-power coefficients obey. -/
theorem cofiniteTailDenseOn_primeResidueValuationFusion_escapes_completePrefix
    (n : ℕ) {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ)
    (z w : ∀ i, A i)
    (hdis : Disjoint (pointedSupport A z) (pointedSupport A w)) :
    primeResidueValuationInteractionCarrier A y n z 0 ∈
        primeResidueValuationDepthPrefixField n A y ∧
      primeResidueValuationInteractionCarrier A y 0 w 0 ∈
        primeResidueValuationDepthPrefixField n A y ∧
      primeValuationFusion n 0
          (primeResidueValuationObservableColumn A y n
            (anchoredRestrictedProductBasis A z))
          (primeResidueValuationObservableColumn A y 0
            (anchoredRestrictedProductBasis A w)) =
        primeResidueValuationObservableColumn A y (n + 1)
          (anchoredRestrictedProductBasis A (pointedUnion A z w)) ∧
      primeResidueValuationInteractionCarrier A y (n + 1)
          (pointedUnion A z w) 0 ∉
        primeResidueValuationDepthPrefixField n A y := by
  let inputN : PrimeResidueValuationDepthPrefixIndex n A :=
    ⟨⟨⟨n, by omega⟩, z⟩, by
      change n ≠ n + 1
      omega⟩
  let inputZero : PrimeResidueValuationDepthPrefixIndex n A :=
    ⟨⟨⟨0, by omega⟩, w⟩, by
      change 0 ≠ n + 1
      omega⟩
  constructor
  · change primeResidueValuationInteractionCarrier A y n z 0 ∈
      GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationDepthPrefixCarrier (n := n) A y))
    exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨inputN, rfl⟩
  constructor
  · change primeResidueValuationInteractionCarrier A y 0 w 0 ∈
      GaloisForLFunctions.differentialAdjoin
        finitePrimeRationalCoefficientField
        (Set.range (primeResidueValuationDepthPrefixCarrier (n := n) A y))
    exact GaloisForLFunctions.subset_differentialAdjoin _ _ ⟨inputZero, rfl⟩
  constructor
  · simpa only [Nat.add_zero] using
      (primeResidueValuationAnchoredBasisColumn_fusion_of_disjoint
        A y n 0 z w hdis)
  · exact cofiniteTailDenseOn_primeResidueValuationNextLayer_not_mem_completePrefix
      n A y hy (pointedUnion A z w)

/-- **External fusion / internal non-generation.** Disjoint source sectors fuse exactly to their
union on the arithmetic-function side, but the resulting carrier is not in the differential field
generated by the two input carriers. Thus prime-valuation fusion cannot be internalized by any
differential-rational expression in its inputs. -/
theorem cofiniteTailDenseOn_primeResidueValuationDisjointFusion_external_not_internal
    {d e r : ℕ} {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    [TopologicalSpace (∀ i, A i)] [DiscreteTopology (∀ i, A i)]
    (y : Nat.Primes → ∀ i, A i)
    (hy : CofiniteTailDenseOn y Set.univ) (hd : 0 < d)
    (he : e < d) (hr : r < d) (hout : e + r + 1 < d)
    (z w : ∀ i, A i)
    (hdis : Disjoint (pointedSupport A z) (pointedSupport A w)) :
    let input₁ : PrimeResidueValuationInteractionGridIndex d A := ⟨⟨e, he⟩, z⟩
    let input₂ : PrimeResidueValuationInteractionGridIndex d A := ⟨⟨r, hr⟩, w⟩
    let output : PrimeResidueValuationInteractionGridIndex d A :=
      ⟨⟨e + r + 1, hout⟩, pointedUnion A z w⟩
    primeValuationFusion e r
        (primeResidueValuationObservableColumn A y e
          (anchoredRestrictedProductBasis A z))
        (primeResidueValuationObservableColumn A y r
          (anchoredRestrictedProductBasis A w)) =
        primeResidueValuationObservableColumn A y (e + r + 1)
          (anchoredRestrictedProductBasis A (pointedUnion A z w)) ∧
      primeResidueValuationInteractionGridCarrier A y output ∉
        GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationInputPairCarrier A y input₁ input₂)) := by
  dsimp only
  constructor
  · exact primeResidueValuationAnchoredBasisColumn_fusion_of_disjoint
      A y e r z w hdis
  · apply cofiniteTailDenseOn_primeResidueValuationGrid_third_not_mem_pairField
      A y hy hd
    · intro hEq
      have hval := congrArg
        (fun q : PrimeResidueValuationInteractionGridIndex d A => q.1.1) hEq
      change e + r + 1 = e at hval
      omega
    · intro hEq
      have hval := congrArg
        (fun q : PrimeResidueValuationInteractionGridIndex d A => q.1.1) hEq
      change e + r + 1 = r at hval
      omega

/-- **Depth--breadth separation.** Fusion adds valuation depth, but its observable coefficient
remains confined to the union of the input coordinate supports; overlap strictly lowers the
principal interaction order. -/
theorem primeResidueValuationFusion_depth_breadth_separation
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (e r : ℕ)
    (S T : Finset ι) (hoverlap : ¬ Disjoint S T)
    (f g : FullValueSubtype (∀ i, A i) → ℂ)
    (hf : f ∈ ClassInvariantRestricted (coordinateAgreementSetoid A S))
    (hg : g ∈ ClassInvariantRestricted (coordinateAgreementSetoid A T)) :
    primeValuationFusion e r
        (primeResidueValuationObservableColumn A y e f)
        (primeResidueValuationObservableColumn A y r g) =
        primeResidueValuationObservableColumn A y (e + r + 1) (f * g) ∧
      f * g ∈ anchoredRestrictedInteractionFiltration A (S ∪ T).card ∧
      (S ∪ T).card < S.card + T.card := by
  exact ⟨primeResidueValuationObservableColumn_fusion A y e r f g,
    coordinateInvariant_mul_interactionDegree_drop_of_overlap A S T hoverlap hf hg⟩

/-- The formal zeta prime-power ghost is exactly the unique empty-support vector in every finite
prime-residue interaction grid. -/
theorem primeResidueValuationInteractionGridCarrier_vacuum_eq_zetaGhost
    {d : ℕ} {ι : Type u} [Fintype ι]
    (A : ι → Type u) [∀ i, Fintype (A i)] [∀ i, DecidableEq (A i)]
    [∀ i, One (A i)]
    (y : Nat.Primes → ∀ i, A i) (r : Fin d) :
    primeResidueValuationInteractionGridCarrier A y ⟨r, fun _ => 1⟩ =
      zetaPrimeValuationGhost ⟨r, ((), ())⟩ := by
  apply congrArg (fun c : Nat.Primes → ℂ =>
    primePowerCoefficientShiftCarrier r c 0)
  funext p
  simp [primeResidueInteractionCoefficient, anchoredProductBasis_apply,
    zetaPrimeValuationCoefficient]

/-- Actual prime residues give exact support-sector superselection in every finite prime-power
window, with the local ranks specialized to Euler totients. -/
theorem pairwiseCoprimePrimeResidueValuationSupportSectorSuperselection
    {d : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]
    (modulus : ι → ℕ) [∀ i, NeZero (modulus i)]
    [NeZero (∏ i, modulus i)]
    (h : Pairwise (Function.onFun Nat.Coprime modulus))
    (hd : 0 < d) (S : Finset ι) :
    let A := fun i => (ZMod (modulus i))ˣ
    let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationSupportComplementCarrier
            (d := d) A y S)))
        (primeResidueValuationSupportCellCarrier (d := d) A y S) ∧
      Nat.card (PrimeResidueValuationSupportCellIndex d A S) =
        d * ∏ i ∈ S, (Nat.totient (modulus i) - 1) := by
  dsimp only
  let A := fun i => (ZMod (modulus i))ˣ
  let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
  letI : TopologicalSpace (∀ i, A i) := ⊥
  letI : DiscreteTopology (∀ i, A i) := ⟨rfl⟩
  have hy : CofiniteTailDenseOn y Set.univ :=
    cofiniteTailDenseOn_univ_of_recurringValueSet_eq_univ y
      (recurringValueSet_pairwiseCoprimePrimeUnitResidueProfile modulus h)
  obtain ⟨hrel, hrank⟩ :=
    cofiniteTailDenseOn_primeResidueValuationSupportSector_relativeHT
      A y hy hd S
  exact ⟨hrel, by
    dsimp [A] at hrank ⊢
    simpa only [ZMod.card_units_eq_totient] using hrank⟩

/-- Actual prime residues give the rectangular valuation-depth by interaction-order spectrum,
and every complete order is relatively HT over all the other orders in that rectangle. -/
theorem pairwiseCoprimePrimeResidueValuationOrderSpectrum
    {d : ℕ} {ι : Type} [Fintype ι] [DecidableEq ι]
    (modulus : ι → ℕ) [∀ i, NeZero (modulus i)]
    [NeZero (∏ i, modulus i)]
    (h : Pairwise (Function.onFun Nat.Coprime modulus))
    (hd : 0 < d) (k : ℕ) :
    let A := fun i => (ZMod (modulus i))ˣ
    let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
    GaloisForLFunctions.DifferentialIndependent
        (GaloisForLFunctions.differentialAdjoin
          finitePrimeRationalCoefficientField
          (Set.range (primeResidueValuationOrderComplementCarrier
            (d := d) A y k)))
        (primeResidueValuationOrderCellCarrier (d := d) A y k) ∧
      Nat.card (PrimeResidueValuationOrderCellIndex d A k) =
        d * ∑ S : {S : Finset ι // S.card = k},
          ∏ i ∈ S.1, (Nat.totient (modulus i) - 1) := by
  dsimp only
  let A := fun i => (ZMod (modulus i))ˣ
  let y := pairwiseCoprimePrimeUnitResidueProfile modulus h
  letI : TopologicalSpace (∀ i, A i) := ⊥
  letI : DiscreteTopology (∀ i, A i) := ⟨rfl⟩
  have hy : CofiniteTailDenseOn y Set.univ :=
    cofiniteTailDenseOn_univ_of_recurringValueSet_eq_univ y
      (recurringValueSet_pairwiseCoprimePrimeUnitResidueProfile modulus h)
  obtain ⟨hrel, hrank⟩ :=
    cofiniteTailDenseOn_primeResidueValuationOrderSector_relativeHT
      A y hy hd k
  exact ⟨hrel, by
    dsimp [A] at hrank ⊢
    simpa only [ZMod.card_units_eq_totient] using hrank⟩

end

