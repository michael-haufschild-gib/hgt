import GaloisForLFunctions.HTGeometry.IndependentCoefficientHypertranscendence

/-!
# Phases with prescribed moduli and algebraically independent values

Given any sequence of moduli one can choose phases making the resulting complex numbers
algebraically independent over `ℚ`: at each step the field generated by the previously chosen
numbers is countable, so the numbers algebraic over it are countable, while the circle of the
prescribed radius is uncountable.

This is the coefficient input of the Newton-geometry blindness theorem: coefficient magnitudes carry
no differential-algebraic information.
-/

open Set

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-! ### Countability -/

theorem countable_mvPolynomialRat {σ : Type*} [Countable σ] : Countable (MvPolynomial σ ℚ) := by
  have hinj : Function.Injective (fun p : MvPolynomial σ ℚ => AddMonoidAlgebra.coeff p) := by
    intro p q h
    cases p
    cases q
    simpa using h
  exact hinj.countable

theorem countable_algebraAdjoin {B : Set ℂ} (hB : B.Countable) :
    (Algebra.adjoin ℚ B : Set ℂ).Countable := by
  haveI : Countable B := hB.to_subtype
  haveI : Countable (MvPolynomial ↥B ℚ) := countable_mvPolynomialRat
  rw [Algebra.adjoin_eq_range]
  exact Set.countable_range _

theorem countable_intermediateFieldAdjoin {B : Set ℂ} (hB : B.Countable) :
    (IntermediateField.adjoin ℚ B : Set ℂ).Countable := by
  have hsub := countable_algebraAdjoin hB
  have himg : (IntermediateField.adjoin ℚ B : Set ℂ)
      ⊆ (fun p : ℂ × ℂ => p.1 / p.2) ''
        ((Algebra.adjoin ℚ B : Set ℂ) ×ˢ (Algebra.adjoin ℚ B : Set ℂ)) := by
    intro x hx
    obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hx
    exact ⟨(r, s), ⟨hr, hs⟩, rfl⟩
  exact Set.Countable.mono himg (Set.Countable.image (hsub.prod hsub) _)

/-- The complex numbers algebraic over a countable subfield form a countable set. -/
theorem countable_isAlgebraic_of_countable {K : IntermediateField ℚ ℂ}
    (hK : (K : Set ℂ).Countable) : {x : ℂ | IsAlgebraic ↥K x}.Countable := by
  haveI : Countable ↥K := hK.to_subtype
  exact Algebraic.countable ↥K ℂ

/-! ### An uncountable supply of unit vectors -/

/-- A point of the unit circle with prescribed real part. -/
def circlePoint (t : ℝ) : ℂ := ⟨t, Real.sqrt (1 - t ^ 2)⟩

theorem norm_circlePoint {t : ℝ} (ht : |t| ≤ 1) : ‖circlePoint t‖ = 1 := by
  have ht2 : t ^ 2 ≤ 1 := by
    have := abs_le.mp ht
    nlinarith [this.1, this.2]
  have hnn : (0 : ℝ) ≤ 1 - t ^ 2 := by linarith
  rw [Complex.norm_def, Complex.normSq_apply]
  simp only [circlePoint]
  rw [Real.mul_self_sqrt hnn]
  have h1 : t * t + (1 - t ^ 2) = 1 := by ring
  rw [h1, Real.sqrt_one]

theorem circlePoint_injective : Function.Injective circlePoint := by
  intro s t hst
  have := congrArg Complex.re hst
  simpa [circlePoint] using this

theorem not_countable_circlePoint_image :
    ¬ (circlePoint '' Set.Ioo (-1 : ℝ) 1).Countable := by
  intro hc
  have hpre := hc.preimage_of_injOn circlePoint_injective.injOn
  have hsubpre : Set.Ioo (-1 : ℝ) 1 ⊆ circlePoint ⁻¹' (circlePoint '' Set.Ioo (-1 : ℝ) 1) := by
    intro x hx
    exact ⟨x, hx, rfl⟩
  have hIoo : (Set.Ioo (-1 : ℝ) 1).Countable := hpre.mono hsubpre
  have h := Cardinal.mk_Ioo_real (show (-1 : ℝ) < 1 by norm_num)
  have hle := hIoo.le_aleph0
  rw [h] at hle
  exact absurd hle (not_le.mpr Cardinal.aleph0_lt_continuum)

/-! ### The choice step -/

/-- **A prescribed modulus admits a transcendental phase.**  For a nonzero radius and a countable
set of previously used numbers there is a unit vector whose scaling is transcendental over the field
they generate. -/
theorem exists_transcendental_scaled {ρ : ℝ} (hρ : ρ ≠ 0) {B : Set ℂ} (hB : B.Countable) :
    ∃ u : ℂ, ‖u‖ = 1 ∧
      Transcendental ↥(IntermediateField.adjoin ℚ B) ((ρ : ℂ) * u) := by
  classical
  set K : IntermediateField ℚ ℂ := IntermediateField.adjoin ℚ B with hK
  have hKcount : (K : Set ℂ).Countable := countable_intermediateFieldAdjoin hB
  have halg : {x : ℂ | IsAlgebraic ↥K x}.Countable := countable_isAlgebraic_of_countable hKcount
  -- the scaled algebraic numbers form a countable set
  set bad : Set ℂ := (fun x : ℂ => x / (ρ : ℂ)) '' {x : ℂ | IsAlgebraic ↥K x} with hbad
  have hbadcount : bad.Countable := halg.image _
  by_contra hcon
  push Not at hcon
  have hsub : circlePoint '' Set.Ioo (-1 : ℝ) 1 ⊆ bad := by
    rintro u ⟨t, ht, rfl⟩
    have hnorm : ‖circlePoint t‖ = 1 := norm_circlePoint (le_of_lt (abs_lt.mpr ⟨ht.1, ht.2⟩))
    have halgu : IsAlgebraic ↥K ((ρ : ℂ) * circlePoint t) := by
      by_contra hcon'
      exact (hcon (circlePoint t) hnorm) hcon'
    refine ⟨(ρ : ℂ) * circlePoint t, halgu, ?_⟩
    have hρc : (ρ : ℂ) ≠ 0 := by exact_mod_cast hρ
    field_simp
  exact not_countable_circlePoint_image (hbadcount.mono hsub)

end

end GaloisForLFunctions.HTGeometry
