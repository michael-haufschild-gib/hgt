import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# A parameter count bounds algebraic independence

Coordinates that are polynomial in `m` parameters cannot contain more than `m` algebraically
independent numbers.  Formally, if every member of an algebraically independent family lies in the
subalgebra generated by `m` elements, the family has at most `m` members.

The proof is a transcendence-degree count: the generated subalgebra is a surjective image of the
polynomial ring in `m` variables, whose transcendence degree is `m`, and an algebraically
independent family never exceeds the transcendence degree.

This is the counting mechanism behind circuit lower bounds from transcendence: a state prepared by
`s` gates has coordinates polynomial in the finitely many gate parameters, so its coordinates carry
at most that many algebraically independent numbers.

The base field and the ambient domain are taken in `Type` so that every cardinal comparison happens
in one universe; that is the case of interest, `ℚ ⊆ ℂ`.
-/

namespace GaloisForLFunctions.HTGeometry

open Cardinal

variable {K L : Type} [Field K] [CommRing L] [IsDomain L] [Algebra K L]

omit [IsDomain L] in
/-- The transcendence degree of a subalgebra generated by `m` elements is at most `m`. -/
theorem trdeg_adjoin_range_le (m : ℕ) (x : Fin m → L) :
    Algebra.trdeg K (Algebra.adjoin K (Set.range x)) ≤ (m : Cardinal) := by
  have hrange : Algebra.adjoin K (Set.range x) = (MvPolynomial.aeval x).range :=
    Algebra.adjoin_range_eq_range_aeval K x
  have hsurj : Function.Surjective
      ((MvPolynomial.aeval x : MvPolynomial (Fin m) K →ₐ[K] L).rangeRestrict) :=
    AlgHom.rangeRestrict_surjective _
  have hle : Algebra.trdeg K ((MvPolynomial.aeval x).range)
      ≤ Algebra.trdeg K (MvPolynomial (Fin m) K) :=
    trdeg_le_of_surjective _ hsurj
  have hpoly : Algebra.trdeg K (MvPolynomial (Fin m) K) = (m : Cardinal) := by
    rw [MvPolynomial.trdeg_of_isDomain]
    simp
  rw [hrange]
  exact hle.trans_eq hpoly

omit [IsDomain L] in
/-- **A parameter count bounds algebraic independence.**  An algebraically independent family
inside the subalgebra generated by `m` elements has at most `m` members. -/
theorem card_le_of_algebraicIndependent_of_mem_adjoin {r m : ℕ} {y : Fin r → L} {x : Fin m → L}
    (hy : AlgebraicIndependent K y) (hmem : ∀ i, y i ∈ Algebra.adjoin K (Set.range x)) :
    r ≤ m := by
  set S : Subalgebra K L := Algebra.adjoin K (Set.range x) with hS
  set y' : Fin r → S := fun i => ⟨y i, hmem i⟩ with hy'
  have hcomp : (S.val : S →ₐ[K] L) ∘ y' = y := by
    funext i
    rfl
  have hy'ind : AlgebraicIndependent K y' :=
    AlgebraicIndependent.of_comp (S.val : S →ₐ[K] L) (by rw [hcomp]; exact hy)
  have hcard : (#(Fin r) : Cardinal) ≤ Algebra.trdeg K S := hy'ind.cardinalMk_le_trdeg
  have hbound : Algebra.trdeg K S ≤ (m : Cardinal) := trdeg_adjoin_range_le m x
  have : (r : Cardinal) ≤ (m : Cardinal) := by
    rw [← Cardinal.mk_fin r]
    exact hcard.trans hbound
  exact_mod_cast this

end GaloisForLFunctions.HTGeometry
