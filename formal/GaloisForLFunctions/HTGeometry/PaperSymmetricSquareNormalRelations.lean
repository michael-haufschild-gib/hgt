import GaloisForLFunctions.HTGeometry.PaperHomogeneousGeneratorIdeal
import GaloisForLFunctions.HTGeometry.PaperNativeReesHomogeneousInitial
import GaloisForLFunctions.HTGeometry.PaperNativeReesQuotient
import GaloisForLFunctions.HTGeometry.PaperGenericMinorWeights
import GaloisForLFunctions.HTGeometry.GenericDeterminantalSmooth
import GaloisForLFunctions.HTGeometry.SymmetricSquareMatrix

/-!
# Normal relations of the native symmetric-square matrix

Apply the source Rees kernel to all nine coefficients of the existing symmetric
square of the existing generic two-by-two matrix. Every scalar relation is
preserved. Its normal determinant is the actual degree-three initial class of
the original generic determinant cubed.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial Matrix

noncomputable section

variable (K : Type*) [CommRing K]

/-- All nine coefficients of the native symmetric square of the native generic matrix. -/
def paperSymmetricSquareGenerator (ij : Fin 3 × Fin 3) : MvPolynomial (Fin 2 × Fin 2) K :=
  symmetricSquareMatrix (genericVarMatrix K 2) ij.1 ij.2

/-- The actual native symmetric-square coefficients are quadratic. -/
theorem paperSymmetricSquareGenerator_homogeneous (ij : Fin 3 × Fin 3) :
    (paperSymmetricSquareGenerator K ij).IsHomogeneous 2 := by
  have hX (i j : Fin 2) : (genericVarMatrix K 2 i j).IsHomogeneous 1 :=
    isHomogeneous_X K (i, j)
  rcases ij with ⟨i, j⟩
  fin_cases i <;> fin_cases j
  · exact (hX 0 0).pow 2
  · exact (hX 0 0).mul (hX 0 1)
  · exact (hX 0 1).pow 2
  · simpa [paperSymmetricSquareGenerator, symmetricSquareMatrix, mul_assoc, map_ofNat] using
      ((hX 0 0).mul (hX 1 0)).C_mul 2
  · exact ((hX 0 0).mul (hX 1 1)).add ((hX 0 1).mul (hX 1 0))
  · simpa [paperSymmetricSquareGenerator, symmetricSquareMatrix, mul_assoc, map_ofNat] using
      ((hX 0 1).mul (hX 1 1)).C_mul 2
  · exact (hX 1 0).pow 2
  · exact (hX 1 0).mul (hX 1 1)
  · exact (hX 1 1).pow 2

/-- Ideal generated by the nine actual native representation coefficients. -/
def paperSymmetricSquareIdeal : Ideal (MvPolynomial (Fin 2 × Fin 2) K) :=
  paperHomogeneousGeneratorIdeal (paperSymmetricSquareGenerator K)

private abbrev paperSymmetricSquareNormalRing {R : Type*} [CommRing R] (I : Ideal R) :
    CommRing (PaperIdealAssociatedGraded I) := inferInstance

local instance : CommRing (PaperIdealAssociatedGraded (paperSymmetricSquareIdeal K)) :=
  paperSymmetricSquareNormalRing _

/-- The source normal-presentation data, with all requirements proved for the native ideal. -/
def paperSymmetricSquareNormalPresentation :
    PaperHomogeneousNormalPresentationData K (Fin 2 × Fin 2) (Fin 3 × Fin 3)
      (paperSymmetricSquareIdeal K) :=
  paperHomogeneousGeneratorNormalPresentation (paperSymmetricSquareGenerator K) 2
    (Nat.succ_pos 1) (paperSymmetricSquareGenerator_homogeneous K)

/-- Simultaneous substitution into all nine actual representation initial classes. -/
def paperSymmetricSquareNormalMap : MvPolynomial (Fin 3 × Fin 3) K →+*
    PaperIdealAssociatedGraded (paperSymmetricSquareIdeal K) :=
  (paperSymmetricSquareNormalPresentation K).polynomialMap

/-- The actual initial classes preserve exactly the scalar relations of the native representation. -/
theorem paperSymmetricSquareNormalMap_relations_iff (p : MvPolynomial (Fin 3 × Fin 3) K) :
    paperSymmetricSquareNormalMap K p = 0 ↔ aeval (paperSymmetricSquareGenerator K) p = 0 :=
  (paperSymmetricSquareNormalPresentation K).polynomialMap_eq_zero_iff p

/-- The original native representation coordinate ring embeds into the actual normal ring. -/
def paperSymmetricSquareGeneratorRingEmbedding :
    (aeval (R := K) (paperSymmetricSquareGenerator K)).toRingHom.range →+*
      PaperIdealAssociatedGraded (paperSymmetricSquareIdeal K) :=
  (paperSymmetricSquareNormalPresentation K).generatorRingEmbedding

/-- No element of the native representation coordinate ring is lost under specialization. -/
theorem paperSymmetricSquareGeneratorRingEmbedding_injective :
    Function.Injective (paperSymmetricSquareGeneratorRingEmbedding K) :=
  (paperSymmetricSquareNormalPresentation K).generatorRingEmbedding_injective

/-- The determinant polynomial in the nine coefficient coordinates. -/
def paperSymmetricSquareDeterminantPolynomial : MvPolynomial (Fin 3 × Fin 3) K :=
  (genericVarMatrix K 3).det

/-- The coefficient determinant is homogeneous of degree three. -/
theorem paperSymmetricSquareDeterminantPolynomial_homogeneous :
    (paperSymmetricSquareDeterminantPolynomial K).IsHomogeneous 3 :=
  paperVariableMinor_homogeneous K 3 (fun i : Fin 3 => i) (fun i : Fin 3 => i)

/-- Native determinant covariance identifies the evaluated coefficient determinant exactly. -/
theorem paperSymmetricSquareDeterminantPolynomial_eval :
    aeval (paperSymmetricSquareGenerator K) (paperSymmetricSquareDeterminantPolynomial K) =
      (genericVarMatrix K 2).det ^ 3 := by
  calc
    _ = (symmetricSquareMatrix (genericVarMatrix K 2)).det := by
      rw [paperSymmetricSquareDeterminantPolynomial, AlgHom.map_det]
      congr 1
      funext i j
      exact aeval_X (R := K) (paperSymmetricSquareGenerator K) (i, j)
    _ = _ := det_symmetricSquareMatrix (genericVarMatrix K 2)

/-- The generic determinant cubed belongs to the third power of the actual coefficient ideal. -/
theorem paperSymmetricSquareDeterminant_cube_mem :
    (genericVarMatrix K 2).det ^ 3 ∈ paperSymmetricSquareIdeal K ^ 3 := by
  have h := (paperSymmetricSquareNormalPresentation K).homogeneous_evaluation_mem
    (paperSymmetricSquareDeterminantPolynomial K) 3
    (paperSymmetricSquareDeterminantPolynomial_homogeneous K)
  change aeval (paperSymmetricSquareGenerator K) (paperSymmetricSquareDeterminantPolynomial K) ∈ _ at h
  rwa [paperSymmetricSquareDeterminantPolynomial_eval] at h

/-- The determinant of the matrix of actual normal coefficients. -/
def paperSymmetricSquareNormalDeterminant :
    PaperIdealAssociatedGraded (paperSymmetricSquareIdeal K) :=
  ((genericVarMatrix K 3).map (paperSymmetricSquareNormalMap K)).det

private theorem paperSymmetricSquare_det_map {R A : Type*} [CommRing R] [CommRing A]
    (f : R →+* A) (M : Matrix (Fin 3) (Fin 3) R) :
    (M.map f).det = f M.det := (f.map_det M).symm

/-- The normal determinant is the image of the original coefficient determinant. -/
theorem paperSymmetricSquareNormalDeterminant_eq_map :
    paperSymmetricSquareNormalDeterminant K =
      paperSymmetricSquareNormalMap K (paperSymmetricSquareDeterminantPolynomial K) :=
  paperSymmetricSquare_det_map (R := MvPolynomial (Fin 3 × Fin 3) K)
    (A := PaperIdealAssociatedGraded (paperSymmetricSquareIdeal K))
    (paperSymmetricSquareNormalMap K) (genericVarMatrix K 3)

/-- The native determinant-cube law survives as an exact actual normal-class identity. -/
theorem paperSymmetricSquareNormalDeterminant_eq_initial :
    paperSymmetricSquareNormalDeterminant K =
      paperNativeReesSpecialization (paperSymmetricSquareIdeal K)
        (ReesGrading.mono (paperSymmetricSquareIdeal K) 3 ((genericVarMatrix K 2).det ^ 3)
          (paperSymmetricSquareDeterminant_cube_mem K)) := by
  rw [paperSymmetricSquareNormalDeterminant_eq_map]
  change paperNativeReesSpecialization (paperSymmetricSquareIdeal K)
    (paperNativeReesMvPolynomialMap (paperSymmetricSquareIdeal K)
      (paperSymmetricSquareNormalPresentation K).idealElements
      (paperSymmetricSquareDeterminantPolynomial K)) = _
  apply congrArg (paperNativeReesSpecialization (paperSymmetricSquareIdeal K))
  apply Subtype.ext
  exact (paperNativeReesMvPolynomialMap_homogeneous (paperSymmetricSquareIdeal K)
    (paperSymmetricSquareNormalPresentation K).idealElements
    (paperSymmetricSquareDeterminantPolynomial K) 3
    (paperSymmetricSquareDeterminantPolynomial_homogeneous K)).trans
      (congrArg (Polynomial.monomial 3) (paperSymmetricSquareDeterminantPolynomial_eval K))

private theorem paperSymmetricSquare_det_identity :
    aeval (fun ij : Fin 2 × Fin 2 => (1 : Matrix (Fin 2) (Fin 2) K) ij.1 ij.2)
      (genericVarMatrix K 2).det = 1 := by
  rw [AlgHom.map_det]
  have hm : (aeval (R := K)
      (fun ij : Fin 2 × Fin 2 => (1 : Matrix (Fin 2) (Fin 2) K) ij.1 ij.2)).mapMatrix
        (genericVarMatrix K 2) = 1 := by
    funext i j
    exact aeval_X (R := K) _ (i, j)
  rw [hm, Matrix.det_one]

/-- Every power of the actual normal determinant survives over every nonzero base ring. -/
theorem paperSymmetricSquareNormalDeterminant_pow_eq_zero_iff (n : ℕ) :
    paperSymmetricSquareNormalDeterminant K ^ n = 0 ↔ (1 : K) = 0 := by
  rw [paperSymmetricSquareNormalDeterminant_eq_map, ← map_pow,
    paperSymmetricSquareNormalMap_relations_iff, map_pow,
    paperSymmetricSquareDeterminantPolynomial_eval]
  constructor
  · intro h
    have he := congrArg (aeval (R := K)
      (fun ij : Fin 2 × Fin 2 => (1 : Matrix (Fin 2) (Fin 2) K) ij.1 ij.2)) h
    simpa only [map_pow, paperSymmetricSquare_det_identity, one_pow, map_zero] using he
  · intro h
    have hone : (1 : MvPolynomial (Fin 2 × Fin 2) K) = 0 := by
      simpa only [map_one, map_zero] using congrArg (C (σ := Fin 2 × Fin 2)) h
    calc
      ((genericVarMatrix K 2).det ^ 3) ^ n = ((genericVarMatrix K 2).det ^ 3) ^ n * 1 :=
        (mul_one _).symm
      _ = 0 := by rw [hone, mul_zero]

/-- The normal determinant vanishes exactly over the zero coefficient ring. -/
theorem paperSymmetricSquareNormalDeterminant_eq_zero_iff :
    paperSymmetricSquareNormalDeterminant K = 0 ↔ (1 : K) = 0 := by
  simpa only [pow_one] using paperSymmetricSquareNormalDeterminant_pow_eq_zero_iff K 1

/-- The determinant cube has exact ideal order three over every nonzero coefficient ring. -/
theorem paperSymmetricSquareDeterminant_cube_mem_four_iff :
    (genericVarMatrix K 2).det ^ 3 ∈ paperSymmetricSquareIdeal K ^ 4 ↔ (1 : K) = 0 := by
  rw [← paperSymmetricSquareNormalDeterminant_eq_zero_iff,
    paperSymmetricSquareNormalDeterminant_eq_initial]
  exact (paperNativeReesSpecialization_mono_eq_zero_iff (paperSymmetricSquareIdeal K) 3
    ⟨(genericVarMatrix K 2).det ^ 3, paperSymmetricSquareDeterminant_cube_mem K⟩).symm

end

end GaloisForLFunctions.HTGeometry
