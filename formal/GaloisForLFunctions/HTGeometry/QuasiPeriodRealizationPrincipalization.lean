import GaloisForLFunctions.HTGeometry.QuasiPeriodLatticeNoZeros
import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetIdeal

/-!
# Constant-multiplier data force the same principal geometry

The facet-codimension law survives the replacement of invariance by quasi-invariance with constant
multipliers (`facetComplementRankOne_of_quasiPeriodRealization`).  Feeding it to the combinatorial
classification gives the structural conclusion for constant-multiplier data with no analytic input
left:

* `principalization_of_quasiPeriodRealization` — a finite facet antichain carrying entire
  nowhere-vanishing hypertranscendental facet carriers, each reproduced up to a nonzero constant by
  every omitted translation, is either the full simplex `{V}` or exactly the deletion family
  `{V ∖ {u} : u ∈ U}` for a nonempty block `U`;
* **`stanleyReisnerIdeal_principal_of_quasiPeriodRealization`** — in the non-simplex case its
  Stanley–Reisner ideal is the principal ideal generated by the squarefree monomial `∏_{u ∈ U} X u`.

So a scalar constant multiplier — the simplest internal state a channel can carry — buys no new
relation geometry: the principal pure stratum is still the only one available.
-/

open Finset MvPolynomial

namespace GaloisForLFunctions.HTGeometry

variable {α : Type*} [DecidableEq α]

/-- **Structural classification from a constant-multiplier datum.**  Such a facet antichain is the
full simplex or a single-vertex deletion family. -/
theorem principalization_of_quasiPeriodRealization {V : Finset α} {facets : Finset (Finset α)}
    (hanti : FacetAntichain (↑facets : Set (Finset α)))
    (R : QuasiPeriodFacetRealization V (↑facets : Set (Finset α)))
    (hsub : ∀ F ∈ facets, F ⊆ V) (hne : facets.Nonempty) :
    (↑facets : Set (Finset α)) = {V} ∨
      ∃ U : Finset α, U.Nonempty ∧ U ⊆ V ∧
        (↑facets : Set (Finset α)) = deletionFacets V U := by
  refine facetAntichain_eq_singleton_or_deletionFacets ?_ hanti
    (facetComplementRankOne_of_quasiPeriodRealization R
      (fun F hF => hsub F (Finset.mem_coe.mp hF)))
  obtain ⟨F, hF⟩ := hne
  exact ⟨F, Finset.mem_coe.mpr hF⟩

/-- **Principalization for constant-multiplier data.**  On a finite ambient vertex type, a facet
antichain that is not the full simplex and carries a constant-multiplier facet datum has principal
Stanley–Reisner ideal, generated by the squarefree monomial of its deleted block. -/
theorem stanleyReisnerIdeal_principal_of_quasiPeriodRealization [Fintype α]
    {facets : Finset (Finset α)} (hanti : FacetAntichain (↑facets : Set (Finset α)))
    (R : QuasiPeriodFacetRealization (Finset.univ : Finset α) (↑facets : Set (Finset α)))
    (hne : facets.Nonempty)
    (hnotsimplex : (↑facets : Set (Finset α)) ≠ {(Finset.univ : Finset α)}) :
    ∃ U : Finset α, U.Nonempty ∧
      stanleyReisnerIdeal ℂ facets
        = Ideal.span ({∏ u ∈ U, X u} : Set (MvPolynomial α ℂ)) := by
  rcases principalization_of_quasiPeriodRealization hanti R
    (fun F _ => Finset.subset_univ F) hne with hsimp | ⟨U, hUne, _, hUeq⟩
  · exact absurd hsimp hnotsimplex
  · refine ⟨U, hUne, ?_⟩
    have hfin : facets = deletionFacetFinset U := by
      apply Finset.coe_injective
      rw [hUeq, coe_deletionFacetFinset]
    rw [hfin, stanleyReisnerIdeal_deletionFacetFinset_eq_span_product]

end GaloisForLFunctions.HTGeometry
