import Mathlib
import GaloisForLFunctions.HTGeometry.PrimeValuationProfileFieldClassification

/-!
# The cylinder decomposition of a derivative horizon

Split a differentially generating family into an additive block and a transverse block.  If the
transverse block is recovered from its own `n`-th derivatives — which is what translation rigidity
of the transverse locus gives — then the depth-`n` horizon of the whole family is generated by the
`n`-th derivatives of the additive block together with the *undifferentiated* transverse block.

Only the coordinates along the flat additive directions lose their lower jets.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C F : Type*} [Field C] [Field F] [Algebra C F] [Differential F]

/-- Every jet of a generator lies in the generated differential field. -/
theorem differentialJet_mem_differentialAdjoin_range
    {ι : Type*} (z : ι → F) (i : ι) (n : ℕ) :
    differentialJet n (z i) ∈ differentialAdjoin C (Set.range z) :=
  differentialJet_mem_differentialAdjoin C (Set.mem_range_self i) n

/-- **The cylinder decomposition of a depth-`n` horizon.** -/
theorem differentialAdjoin_union_differentialJet_eq
    (hC : ∀ c : C, (algebraMap C F c)′ = 0)
    {ι ι' : Type*} (a : ι → F) (z : ι' → F) (n : ℕ)
    (hz : differentialAdjoin C (Set.range fun j => differentialJet n (z j))
        = differentialAdjoin C (Set.range z)) :
    differentialAdjoin C ((Set.range fun i => differentialJet n (a i))
        ∪ Set.range fun j => differentialJet n (z j))
      = differentialAdjoin C ((Set.range fun i => differentialJet n (a i)) ∪ Set.range z) := by
  classical
  refine le_antisymm ?_ ?_
  · refine differentialAdjoin_le C ?_
      (derivationClosed_differentialAdjoin_of_constants C hC _)
    rintro x (⟨i, rfl⟩ | ⟨j, rfl⟩)
    · exact subset_differentialAdjoin C _ (Or.inl ⟨i, rfl⟩)
    · have hmem : differentialJet n (z j) ∈ differentialAdjoin C (Set.range z) :=
        differentialJet_mem_differentialAdjoin_range z j n
      refine differentialAdjoin_le C ?_
        (derivationClosed_differentialAdjoin_of_constants C hC _) hmem
      rintro w ⟨k, rfl⟩
      exact subset_differentialAdjoin C _ (Or.inr ⟨k, rfl⟩)
  · refine differentialAdjoin_le C ?_
      (derivationClosed_differentialAdjoin_of_constants C hC _)
    rintro x (⟨i, rfl⟩ | ⟨j, rfl⟩)
    · exact subset_differentialAdjoin C _ (Or.inl ⟨i, rfl⟩)
    · have hzj : z j ∈ differentialAdjoin C (Set.range fun k => differentialJet n (z k)) := by
        rw [hz]
        exact subset_differentialAdjoin C _ ⟨j, rfl⟩
      refine differentialAdjoin_le C ?_
        (derivationClosed_differentialAdjoin_of_constants C hC _) hzj
      rintro w ⟨k, rfl⟩
      exact subset_differentialAdjoin C _ (Or.inr ⟨k, rfl⟩)

end

end GaloisForLFunctions.HTGeometry
