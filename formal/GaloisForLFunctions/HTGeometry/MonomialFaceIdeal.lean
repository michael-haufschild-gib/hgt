import GaloisForLFunctions.HTGeometry.SquarefreeVeroneseIdeal

/-!
# Face ideals of the coordinate normal crossing and their descent

The Barnes source boundary is the reduced union of the coordinate hyperplanes: the face of a set
`S` of structural directions is cut out by the ideal generated by the corresponding variables.
Membership in a face ideal is a monomial condition — every monomial occurring in the polynomial
must use some direction of `S` — and the whole face lattice is therefore governed by monomial
combinatorics.

Two consequences are recorded.  The intersection of the atomic faces is the principal ideal of the
squarefree product, so a class on the total boundary is determined by its restrictions to the
atomic faces.  And the pairwise faces satisfy the distributivity law
`⋂_j (X_n, X_j) = (X_n) + (∏_j X_j)`, which is exactly what makes compatible data on the atomic
faces glue.

Together these are the exactness of

```text
0 → A/(∏_j X_j) → ⊕_j A/(X_j) → ⊕_{j,k} A/(X_j, X_k)
```

that is, uniqueness and existence of the global boundary class.
-/

open scoped BigOperators

namespace GaloisForLFunctions.FaceIdeal

open MvPolynomial VeroneseIdeal

noncomputable section

variable {R σ : Type*} [CommRing R] [DecidableEq σ]

/-! ## Face ideals and their monomial description -/

/-- The face ideal of a set of structural directions. -/
def faceIdeal (R : Type*) [CommRing R] {σ : Type*} (S : Finset σ) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun j => (X j : MvPolynomial σ R)) '' S)

/-- A polynomial hits the face `S` when every monomial occurring in it uses some direction of
`S`. -/
def MonoHits (S : Finset σ) (P : MvPolynomial σ R) : Prop :=
  ∀ d : σ →₀ ℕ, coeff d P ≠ 0 → ∃ j ∈ S, d j ≠ 0

theorem monoHits_of_mem_faceIdeal {S : Finset σ} {P : MvPolynomial σ R}
    (hP : P ∈ faceIdeal R S) : MonoHits S P := by
  classical
  refine Submodule.span_induction (p := fun x _ => MonoHits S x) ?_ ?_ ?_ ?_ hP
  · rintro _ ⟨j, hj, rfl⟩ d hd
    refine ⟨j, hj, ?_⟩
    rw [coeff_X] at hd
    by_cases h : (Finsupp.single j 1 : σ →₀ ℕ) = d
    · rw [← h]
      simp
    · exact absurd (if_neg h) hd
  · intro d hd; simp at hd
  · intro a b _ _ ha hb d hd
    rw [coeff_add] at hd
    rcases ne_or_eq (coeff d a) 0 with h | h
    · exact ha d h
    · exact hb d (by rw [h, zero_add] at hd; exact hd)
  · intro a x _ hx d hd
    rw [smul_eq_mul, coeff_mul] at hd
    obtain ⟨⟨da, db⟩, hmem, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
    have hdb : coeff db x ≠ 0 := fun h => hne (by rw [h, mul_zero])
    obtain ⟨j, hj, hjne⟩ := hx db hdb
    refine ⟨j, hj, ?_⟩
    rw [Finset.mem_antidiagonal] at hmem
    intro hzero
    apply hjne
    have hsum : da j + db j = 0 := by rw [← Finsupp.add_apply, hmem]; exact hzero
    omega

/-- A monomial using a direction of `S` lies in the face ideal. -/
theorem monomial_mem_faceIdeal {S : Finset σ} {d : σ →₀ ℕ} (c : R)
    {j : σ} (hj : j ∈ S) (hdj : d j ≠ 0) : monomial d c ∈ faceIdeal R S := by
  classical
  have hle : (Finsupp.single j 1 : σ →₀ ℕ) ≤ d := by
    intro i
    rw [Finsupp.single_apply]
    split_ifs with h
    · subst h; omega
    · exact Nat.zero_le _
  have hfactor : monomial d c = (X j : MvPolynomial σ R) *
      monomial (d - Finsupp.single j 1) c := by
    rw [X, monomial_mul, one_mul, add_tsub_cancel_of_le hle]
  rw [hfactor]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, hj, rfl⟩)

/-- **Monomial description of a face ideal.** -/
theorem mem_faceIdeal_iff (S : Finset σ) (P : MvPolynomial σ R) :
    P ∈ faceIdeal R S ↔ MonoHits S P := by
  classical
  refine ⟨monoHits_of_mem_faceIdeal, fun hP => ?_⟩
  rw [P.as_sum]
  refine Ideal.sum_mem _ fun d hd => ?_
  obtain ⟨j, hj, hjne⟩ := hP d (mem_support_iff.mp hd)
  exact monomial_mem_faceIdeal _ hj hjne

theorem faceIdeal_mono {S T : Finset σ} (h : S ⊆ T) : faceIdeal R S ≤ faceIdeal R T := by
  intro P hP
  rw [mem_faceIdeal_iff] at hP ⊢
  intro d hd
  obtain ⟨j, hj, hjne⟩ := hP d hd
  exact ⟨j, h hj, hjne⟩

/-! ## Uniqueness: the atomic faces intersect in the squarefree product -/

/-- Membership in the principal ideal of a squarefree monomial is a monomial condition. -/
theorem mem_span_prod_X_iff (s : Finset σ) (P : MvPolynomial σ R) :
    P ∈ Ideal.span {∏ j ∈ s, (X j : MvPolynomial σ R)} ↔
      ∀ d : σ →₀ ℕ, coeff d P ≠ 0 → ∀ j ∈ s, d j ≠ 0 := by
  classical
  constructor
  · intro hP d hd j hj
    rw [Ideal.mem_span_singleton] at hP
    obtain ⟨Q, rfl⟩ := hP
    rw [prod_X_eq_monomial, coeff_monomial_mul'] at hd
    by_cases hle : (∑ k ∈ s, Finsupp.single k (1 : ℕ)) ≤ d
    · have hj' := hle j
      rw [sum_single_apply, if_pos hj] at hj'
      omega
    · exact absurd (if_neg hle) hd
  · intro hP
    rw [P.as_sum]
    refine Ideal.sum_mem _ fun d hd => ?_
    have hall := hP d (mem_support_iff.mp hd)
    have hle : (∑ j ∈ s, Finsupp.single j (1 : ℕ)) ≤ d := by
      intro i
      rw [sum_single_apply]
      split_ifs with h
      · exact Nat.one_le_iff_ne_zero.mpr (hall i h)
      · exact Nat.zero_le _
    rw [Ideal.mem_span_singleton, prod_X_eq_monomial]
    exact ⟨monomial (d - ∑ j ∈ s, Finsupp.single j 1) _, by
      rw [monomial_mul, one_mul, add_tsub_cancel_of_le hle]⟩

/-- **Uniqueness of the global boundary class.**  The atomic faces intersect in the principal ideal
of the squarefree product. -/
theorem iInf_faceIdeal_singleton (s : Finset σ) :
    (⨅ j ∈ s, faceIdeal R ({j} : Finset σ)) =
      Ideal.span {∏ j ∈ s, (X j : MvPolynomial σ R)} := by
  classical
  ext P
  simp only [Submodule.mem_iInf]
  rw [mem_span_prod_X_iff]
  constructor
  · intro h d hd j hj
    obtain ⟨k, hk, hkne⟩ := (mem_faceIdeal_iff _ P).mp (h j hj) d hd
    rw [Finset.mem_singleton] at hk
    exact hk ▸ hkne
  · intro h j hj
    rw [mem_faceIdeal_iff]
    exact fun d hd => ⟨j, Finset.mem_singleton_self j, h d hd j hj⟩

/-! ## Distributivity of the pairwise faces -/

/-- **The face lattice is distributive along a vertex.**  A polynomial each of whose monomials uses
`X_n` or uses `X_j`, for every `j` of `s`, splits as a multiple of `X_n` plus a multiple of the
squarefree product over `s`. -/
theorem iInf_faceIdeal_pair (n : σ) (s : Finset σ) :
    (⨅ j ∈ s, faceIdeal R ({n, j} : Finset σ)) =
      faceIdeal R ({n} : Finset σ) ⊔
        Ideal.span {∏ j ∈ s, (X j : MvPolynomial σ R)} := by
  classical
  refine le_antisymm ?_ ?_
  · intro P hP
    simp only [Submodule.mem_iInf] at hP
    have hhit : ∀ j ∈ s, MonoHits ({n, j} : Finset σ) P :=
      fun j hj => (mem_faceIdeal_iff _ P).mp (hP j hj)
    have hsplit : P = (∑ d ∈ P.support with d n ≠ 0, monomial d (coeff d P)) +
        ∑ d ∈ P.support with ¬ (d n ≠ 0), monomial d (coeff d P) := by
      rw [Finset.sum_filter_add_sum_filter_not]
      exact P.as_sum
    rw [hsplit]
    refine Submodule.add_mem_sup ?_ ?_
    · refine Ideal.sum_mem _ fun d hd => ?_
      rw [Finset.mem_filter] at hd
      exact monomial_mem_faceIdeal _ (Finset.mem_singleton_self n) hd.2
    · rw [mem_span_prod_X_iff]
      intro d hd j hj
      have hdmem : d ∈ P.support.filter (fun e => ¬ (e n ≠ 0)) := by
        by_contra hcon
        rw [coeff_sum] at hd
        refine hd (Finset.sum_eq_zero fun e he => ?_)
        rw [coeff_monomial]
        by_cases h : e = d
        · exact absurd (h ▸ he) hcon
        · exact if_neg h
      rw [Finset.mem_filter] at hdmem
      have hdn : d n = 0 := by omega
      obtain ⟨k, hk, hkne⟩ := hhit j hj d (mem_support_iff.mp hdmem.1)
      rcases Finset.mem_insert.mp hk with hkn | hkj
      · exact absurd (hkn ▸ hdn) hkne
      · rw [Finset.mem_singleton] at hkj
        exact hkj ▸ hkne
  · refine sup_le (le_iInf₂ fun j _ => faceIdeal_mono ?_) (le_iInf₂ fun j hj => ?_)
    · intro x hx
      rw [Finset.mem_singleton] at hx
      exact Finset.mem_insert.mpr (Or.inl hx)
    · intro P hP
      rw [mem_span_prod_X_iff] at hP
      rw [mem_faceIdeal_iff]
      exact fun d hd => ⟨j, Finset.mem_insert_of_mem (Finset.mem_singleton_self j), hP d hd j hj⟩

/-! ## Existence: compatible atomic data glue -/

/-- **Face descent.**  A family of local classes on the atomic faces that agree on every pairwise
face comes from a single global class. -/
theorem exists_glue (a : σ → MvPolynomial σ R) (s : Finset σ)
    (hcompat : ∀ i ∈ s, ∀ j ∈ s, a i - a j ∈ faceIdeal R ({i, j} : Finset σ)) :
    ∃ b : MvPolynomial σ R, ∀ i ∈ s, b - a i ∈ faceIdeal R ({i} : Finset σ) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert n t hn ih =>
      obtain ⟨b, hb⟩ := ih fun i hi j hj =>
        hcompat i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj)
      have hmem : a n - b ∈ ⨅ j ∈ t, faceIdeal R ({n, j} : Finset σ) := by
        simp only [Submodule.mem_iInf]
        intro j hj
        have h1 : a n - a j ∈ faceIdeal R ({n, j} : Finset σ) :=
          hcompat n (Finset.mem_insert_self n t) j (Finset.mem_insert_of_mem hj)
        have h2 : a j - b ∈ faceIdeal R ({n, j} : Finset σ) := by
          have hneg : a j - b ∈ faceIdeal R ({j} : Finset σ) := by
            have := neg_mem (hb j hj)
            simpa using this
          refine faceIdeal_mono ?_ hneg
          intro x hx
          rw [Finset.mem_singleton] at hx
          exact Finset.mem_insert_of_mem (Finset.mem_singleton.mpr hx)
        have := Ideal.add_mem _ h1 h2
        simpa using this
      rw [iInf_faceIdeal_pair] at hmem
      obtain ⟨c, hc, e, he, hce⟩ := Submodule.mem_sup.mp hmem
      refine ⟨b + e, fun i hi => ?_⟩
      rcases Finset.mem_insert.mp hi with rfl | hit
      · have : b + e - a i = -c := by
          have : a i - b = c + e := hce.symm
          linear_combination (norm := ring_nf) -this
        rw [this]
        exact neg_mem hc
      · have hei : e ∈ faceIdeal R ({i} : Finset σ) := by
          rw [mem_faceIdeal_iff]
          rw [mem_span_prod_X_iff] at he
          exact fun d hd => ⟨i, Finset.mem_singleton_self i, he d hd i hit⟩
        have : b + e - a i = (b - a i) + e := by ring
        rw [this]
        exact Ideal.add_mem _ (hb i hit) hei

end

end GaloisForLFunctions.FaceIdeal
