import GaloisForLFunctions.HTGeometry.CoerciveOperatorInverse
import Mathlib.Analysis.Normed.Algebra.Exponential
import Mathlib.Analysis.InnerProductSpace.Calculus
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.Deriv.MeanValue
import Mathlib.Analysis.SpecialFunctions.ExpDeriv

/-!
# A numerical-range floor makes the semigroup exponentially contractive

If `μ‖u‖² ≤ Re⟪B u, u⟫` then the energy `‖e^{-sB}u₀‖²` has derivative exactly
`−2 Re⟪B u(s), u(s)⟫`, hence logarithmic derivative at most `−2μ`.  Comparing with the exponential
gives

`‖e^{-sB}u₀‖ ≤ e^{-μ s}‖u₀‖`,   `s ≥ 0`.

No spectral theory and no self-adjointness enter: the floor is differentiated directly.  This is the
uniform decay that lets the resolvent of a shifted operator be read as the Laplace transform of the
semigroup, so that the shift contributes a decay rate rather than only a norm bound.
-/

open scoped InnerProductSpace

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X] [CompleteSpace X]

/-- The semigroup generated by `−B`. -/
def accretiveSemigroup (B : X →L[ℂ] X) (s : ℝ) : X →L[ℂ] X := NormedSpace.exp ((-s) • B)

omit [CompleteSpace X] in
@[simp]
theorem accretiveSemigroup_zero (B : X →L[ℂ] X) :
    accretiveSemigroup B 0 = ContinuousLinearMap.id ℂ X := by
  rw [accretiveSemigroup, neg_zero, zero_smul, NormedSpace.exp_zero]
  rfl

omit [CompleteSpace X] in
theorem accretiveSemigroup_eq (B : X →L[ℂ] X) (s : ℝ) :
    accretiveSemigroup B s = NormedSpace.exp (s • (-B)) := by
  rw [accretiveSemigroup, smul_neg, neg_smul]

omit [CompleteSpace X] in
theorem commute_accretiveSemigroup (B : X →L[ℂ] X) (s : ℝ) :
    Commute (accretiveSemigroup B s) B := by
  rw [accretiveSemigroup]
  exact ((Commute.refl B).smul_left (-s)).exp_left

/-- **The orbit solves the linear equation.** -/
theorem hasDerivAt_accretiveSemigroup_apply (B : X →L[ℂ] X) (u₀ : X) (s : ℝ) :
    HasDerivAt (fun t : ℝ => accretiveSemigroup B t u₀)
      (-(B (accretiveSemigroup B s u₀))) s := by
  have hbase : HasDerivAt (fun t : ℝ => NormedSpace.exp (t • (-B)))
      (NormedSpace.exp (s • (-B)) * (-B)) s := hasDerivAt_exp_smul_const (-B) s
  have hfun : (fun t : ℝ => NormedSpace.exp (t • (-B))) = fun t : ℝ => accretiveSemigroup B t := by
    funext t
    rw [accretiveSemigroup_eq]
  rw [hfun] at hbase
  have happ := (ContinuousLinearMap.hasFDerivAt
    (((ContinuousLinearMap.apply ℂ X u₀)).restrictScalars ℝ)).comp_hasDerivAt s hbase
  refine happ.congr_deriv ?_
  have hkey : (accretiveSemigroup B s) * B = B * (accretiveSemigroup B s) :=
    (commute_accretiveSemigroup B s).eq
  show (NormedSpace.exp (s • (-B)) * (-B)) u₀ = -(B (accretiveSemigroup B s u₀))
  rw [← accretiveSemigroup_eq, mul_neg]
  show -((accretiveSemigroup B s * B) u₀) = -(B (accretiveSemigroup B s u₀))
  rw [hkey]
  rfl

/-! ## The decay bound -/

/-- **The exponential contraction bound.**  A numerical floor `μ` gives the semigroup the uniform
decay rate `e^{-μs}` for `s ≥ 0`. -/
theorem norm_accretiveSemigroup_apply_le {B : X →L[ℂ] X} {μ : ℝ}
    (hB : ∀ u : X, μ * ‖u‖ ^ (2 : ℕ) ≤ (inner ℂ (B u) u).re) (u₀ : X) {s : ℝ} (hs : 0 ≤ s) :
    ‖accretiveSemigroup B s u₀‖ ≤ Real.exp (-(μ * s)) * ‖u₀‖ := by
  set u : ℝ → X := fun t => accretiveSemigroup B t u₀ with hu
  -- the energy and its derivative
  have hψderiv : ∀ t : ℝ, HasDerivAt (fun r : ℝ => ‖u r‖ ^ (2 : ℕ))
      (-(2 * (inner ℂ (B (u t)) (u t)).re)) t := by
    intro t
    have hd : HasDerivAt u (-(B (u t))) t := hasDerivAt_accretiveSemigroup_apply B u₀ t
    have hin : HasDerivAt (fun r : ℝ => (inner ℂ (u r) (u r) : ℂ))
        (inner ℂ (u t) (-(B (u t))) + inner ℂ (-(B (u t))) (u t)) t :=
      HasDerivAt.inner ℂ hd hd
    have hcomp := (Complex.reCLM.hasFDerivAt).comp_hasDerivAt t hin
    have hfun : (⇑Complex.reCLM ∘ fun r : ℝ => (inner ℂ (u r) (u r) : ℂ))
        = fun r : ℝ => ‖u r‖ ^ (2 : ℕ) := by
      funext r
      exact inner_self_eq_norm_sq (𝕜 := ℂ) (u r)
    rw [hfun] at hcomp
    refine hcomp.congr_deriv ?_
    have hsym : (inner ℂ (u t) (B (u t)) : ℂ).re = (inner ℂ (B (u t)) (u t) : ℂ).re := by
      rw [← inner_conj_symm (𝕜 := ℂ) (u t) (B (u t))]
      exact Complex.conj_re _
    simp only [Complex.reCLM_apply, inner_neg_left, inner_neg_right, Complex.add_re,
      Complex.neg_re]
    rw [hsym]
    ring
  -- the exponentially weighted energy is antitone
  set φ : ℝ → ℝ := fun t => Real.exp (2 * μ * t) * ‖u t‖ ^ (2 : ℕ) with hφ
  have hφderiv : ∀ t : ℝ, HasDerivAt φ
      (Real.exp (2 * μ * t) *
        (2 * μ * ‖u t‖ ^ (2 : ℕ) - 2 * (inner ℂ (B (u t)) (u t)).re)) t := by
    intro t
    have hexp : HasDerivAt (fun r : ℝ => Real.exp (2 * μ * r))
        (Real.exp (2 * μ * t) * (2 * μ)) t := by
      have h1 : HasDerivAt (fun r : ℝ => 2 * μ * r) (2 * μ) t := by
        simpa using (hasDerivAt_id t).const_mul (2 * μ)
      simpa [mul_comm] using h1.exp
    have hprod := hexp.mul (hψderiv t)
    refine hprod.congr_deriv ?_
    ring
  have hnonpos : ∀ t : ℝ,
      Real.exp (2 * μ * t) * (2 * μ * ‖u t‖ ^ (2 : ℕ) - 2 * (inner ℂ (B (u t)) (u t)).re) ≤ 0 := by
    intro t
    have hb := hB (u t)
    have hexp : (0 : ℝ) < Real.exp (2 * μ * t) := Real.exp_pos _
    nlinarith [hb, hexp]
  have hdiff : Differentiable ℝ φ := fun t => (hφderiv t).differentiableAt
  have hderiv : ∀ t : ℝ, deriv φ t ≤ 0 := by
    intro t
    rw [(hφderiv t).deriv]
    exact hnonpos t
  have hanti : Antitone φ := antitone_of_deriv_nonpos hdiff hderiv
  have hkey : φ s ≤ φ 0 := hanti hs
  -- unwind
  have hφ0 : φ 0 = ‖u₀‖ ^ (2 : ℕ) := by
    rw [hφ]
    simp [hu]
  have hsq : ‖u s‖ ^ (2 : ℕ) ≤ (Real.exp (-(μ * s)) * ‖u₀‖) ^ (2 : ℕ) := by
    have hexp : (0 : ℝ) < Real.exp (2 * μ * s) := Real.exp_pos _
    have hstep : Real.exp (2 * μ * s) * ‖u s‖ ^ (2 : ℕ) ≤ ‖u₀‖ ^ (2 : ℕ) := by
      rw [← hφ0]
      exact hkey
    have h2 : (Real.exp (-(μ * s))) ^ (2 : ℕ) = (Real.exp (2 * μ * s))⁻¹ := by
      rw [← Real.exp_neg, sq, ← Real.exp_add]
      congr 1
      ring
    have hval : (Real.exp (-(μ * s)) * ‖u₀‖) ^ (2 : ℕ)
        = (Real.exp (2 * μ * s))⁻¹ * ‖u₀‖ ^ (2 : ℕ) := by
      rw [mul_pow, h2]
    rw [hval]
    rw [← le_div_iff₀' hexp] at hstep
    calc ‖u s‖ ^ (2 : ℕ) ≤ ‖u₀‖ ^ (2 : ℕ) / Real.exp (2 * μ * s) := hstep
      _ = (Real.exp (2 * μ * s))⁻¹ * ‖u₀‖ ^ (2 : ℕ) := by ring
  have hnn : (0 : ℝ) ≤ Real.exp (-(μ * s)) * ‖u₀‖ := by positivity
  nlinarith [hsq, norm_nonneg (u s), hnn]

end GaloisForLFunctions.HTGeometry
