import GaloisForLFunctions.HTGeometry.ProjectiveHorizonBuilding
import Mathlib.Algebra.Lie.Matrix
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Tactic
import GaloisForLFunctions.HTGeometry.LieModulePointStabilizer

/-!
# The current-algebra engine of the depth-two projective horizon transition

The constant translation and inversion-conjugate translation modes form `sl₂`.  Once their
linear-in-time modes are also present, Lie brackets generate every polynomial current mode.  This
is the algebraic mechanism by which the common field of opposite HT derivative horizons collapses
after the velocity jet is removed.

This file formalizes the current-algebra generation theorem.  It does not postulate the separate
infinite rational fixed-field theorem.
-/

open scoped Matrix Polynomial

namespace GaloisForLFunctions

noncomputable section

variable (K : Type*) [Field K]

/-- The polynomial translation mode `t^k e` in `sl₂(K[t])`. -/
def sl2CurrentE (k : ℕ) : Matrix (Fin 2) (Fin 2) (Polynomial K) :=
  !![0, Polynomial.X ^ k; 0, 0]

/-- The inversion-conjugate polynomial mode `t^k f` in `sl₂(K[t])`. -/
def sl2CurrentF (k : ℕ) : Matrix (Fin 2) (Fin 2) (Polynomial K) :=
  !![0, 0; Polynomial.X ^ k, 0]

/-- The diagonal polynomial mode `t^k h` in `sl₂(K[t])`. -/
def sl2CurrentH (k : ℕ) : Matrix (Fin 2) (Fin 2) (Polynomial K) :=
  !![Polynomial.X ^ k, 0; 0, -(Polynomial.X ^ k)]

/-- Current-algebra relation `[t^i e,t^j f]=t^(i+j) h`. -/
theorem sl2Current_lie_E_F (i j : ℕ) :
    ⁅sl2CurrentE K i, sl2CurrentF K j⁆ = sl2CurrentH K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [sl2CurrentE, sl2CurrentF, sl2CurrentH,
      LieRing.of_associative_ring_bracket, pow_add, mul_comm]

/-- Current-algebra relation `[t^i h,t^j e]=2t^(i+j)e`. -/
theorem sl2Current_lie_H_E (i j : ℕ) :
    ⁅sl2CurrentH K i, sl2CurrentE K j⁆ =
      (2 : K) • sl2CurrentE K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [sl2CurrentE, sl2CurrentH, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm, two_mul]

/-- Current-algebra relation `[t^i h,t^j f]=-2t^(i+j)f`. -/
theorem sl2Current_lie_H_F (i j : ℕ) :
    ⁅sl2CurrentH K i, sl2CurrentF K j⁆ =
      -(2 : K) • sl2CurrentF K (i + j) := by
  ext a b
  fin_cases a <;> fin_cases b <;>
    simp [sl2CurrentF, sl2CurrentH, LieRing.of_associative_ring_bracket,
      pow_add, mul_comm, two_mul, sub_eq_add_neg]

/-- Constant and linear modes supplied by the two depth-two truncated-jet gauges. -/
def depthTwoCurrentGenerators :
    Set (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  {sl2CurrentE K 0, sl2CurrentE K 1, sl2CurrentF K 0, sl2CurrentF K 1}

/-- The Lie algebra generated by the four depth-two current modes. -/
def depthTwoCurrentLie :
    LieSubalgebra K (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (depthTwoCurrentGenerators K)

/-- The current modes annihilating a vector form a Lie subalgebra: the point stabiliser of
the Lie-module action, with no dependence on the matrix coefficients. -/
abbrev sl2CurrentPointStabilizer
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    (v : M) : LieSubalgebra K (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  _root_.HTGeometry.lieModulePointStabilizer K (Matrix (Fin 2) (Fin 2) (Polynomial K)) v

section Generation

variable [NeZero (2 : K)]

/-- The four depth-two modes generate every polynomial translation mode `t^k e`. -/
theorem sl2CurrentE_mem_depthTwoCurrentLie (k : ℕ) :
    sl2CurrentE K k ∈ depthTwoCurrentLie K := by
  have htwo : (2 : K) ≠ 0 := NeZero.ne 2
  have hE0 : sl2CurrentE K 0 ∈ depthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [depthTwoCurrentGenerators])
  have hF1 : sl2CurrentF K 1 ∈ depthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [depthTwoCurrentGenerators])
  have hH1 : sl2CurrentH K 1 ∈ depthTwoCurrentLie K := by
    rw [← sl2Current_lie_E_F K 0 1]
    exact (depthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hE0
  | succ k ih =>
      have hbr : ⁅sl2CurrentH K 1, sl2CurrentE K k⁆ ∈ depthTwoCurrentLie K :=
        (depthTwoCurrentLie K).lie_mem hH1 ih
      rw [sl2Current_lie_H_E K 1 k] at hbr
      have hs := (depthTwoCurrentLie K).smul_mem ((2 : K)⁻¹) hbr
      simpa [smul_smul, add_comm, htwo] using hs

/-- The four depth-two modes generate every inversion-conjugate mode `t^k f`. -/
theorem sl2CurrentF_mem_depthTwoCurrentLie (k : ℕ) :
    sl2CurrentF K k ∈ depthTwoCurrentLie K := by
  have htwo : (2 : K) ≠ 0 := NeZero.ne 2
  have hE0 : sl2CurrentE K 0 ∈ depthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [depthTwoCurrentGenerators])
  have hF0 : sl2CurrentF K 0 ∈ depthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [depthTwoCurrentGenerators])
  have hF1 : sl2CurrentF K 1 ∈ depthTwoCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [depthTwoCurrentGenerators])
  have hH1 : sl2CurrentH K 1 ∈ depthTwoCurrentLie K := by
    rw [← sl2Current_lie_E_F K 0 1]
    exact (depthTwoCurrentLie K).lie_mem hE0 hF1
  induction k with
  | zero => exact hF0
  | succ k ih =>
      have hbr : ⁅sl2CurrentH K 1, sl2CurrentF K k⁆ ∈ depthTwoCurrentLie K :=
        (depthTwoCurrentLie K).lie_mem hH1 ih
      rw [sl2Current_lie_H_F K 1 k] at hbr
      have hs := (depthTwoCurrentLie K).smul_mem ((-(2 : K))⁻¹) hbr
      simpa [smul_smul, add_comm, htwo] using hs

/-- The same depth-two modes generate every diagonal mode `t^k h`. -/
theorem sl2CurrentH_mem_depthTwoCurrentLie (k : ℕ) :
    sl2CurrentH K k ∈ depthTwoCurrentLie K := by
  have hbr := (depthTwoCurrentLie K).lie_mem
    (sl2CurrentE_mem_depthTwoCurrentLie K 0)
    (sl2CurrentF_mem_depthTwoCurrentLie K k)
  rw [sl2Current_lie_E_F K 0 k] at hbr
  simpa using hbr

/-- **Depth-two current-algebra generation.**  Position and velocity modes from two opposite
projective gauges generate all polynomial `sl₂` current modes. -/
theorem depthTwoCurrentLie_contains_all_modes (k : ℕ) :
    sl2CurrentE K k ∈ depthTwoCurrentLie K ∧
      sl2CurrentF K k ∈ depthTwoCurrentLie K ∧
      sl2CurrentH K k ∈ depthTwoCurrentLie K :=
  ⟨sl2CurrentE_mem_depthTwoCurrentLie K k,
    sl2CurrentF_mem_depthTwoCurrentLie K k,
    sl2CurrentH_mem_depthTwoCurrentLie K k⟩

/-- All monomial root and diagonal modes of the polynomial `sl₂` current algebra. -/
def sl2PolynomialCurrentGenerators :
    Set (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  Set.range (sl2CurrentE K) ∪
    (Set.range (sl2CurrentF K) ∪ Set.range (sl2CurrentH K))

/-- The polynomial `sl₂` current Lie algebra, defined from all of its monomial modes. -/
def sl2PolynomialCurrentLie :
    LieSubalgebra K (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (sl2PolynomialCurrentGenerators K)

/-- The four depth-two horizon modes generate exactly the polynomial `sl₂` current Lie algebra,
not merely each displayed family separately. -/
theorem depthTwoCurrentLie_eq_sl2PolynomialCurrentLie :
    depthTwoCurrentLie K = sl2PolynomialCurrentLie K := by
  apply le_antisymm
  · apply LieSubalgebra.lieSpan_le.mpr
    intro A hA
    apply LieSubalgebra.subset_lieSpan
    simp only [depthTwoCurrentGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl | rfl
    · exact Set.mem_union_left _ ⟨0, rfl⟩
    · exact Set.mem_union_left _ ⟨1, rfl⟩
    · exact Set.mem_union_right _ (Set.mem_union_left _ ⟨0, rfl⟩)
    · exact Set.mem_union_right _ (Set.mem_union_left _ ⟨1, rfl⟩)
  · apply LieSubalgebra.lieSpan_le.mpr
    intro A hA
    rcases hA with hE | hFH
    · obtain ⟨k, rfl⟩ := hE
      exact sl2CurrentE_mem_depthTwoCurrentLie K k
    · rcases hFH with hF | hH
      · obtain ⟨k, rfl⟩ := hF
        exact sl2CurrentF_mem_depthTwoCurrentLie K k
      · obtain ⟨k, rfl⟩ := hH
        exact sl2CurrentH_mem_depthTwoCurrentLie K k

/-- In any representation, annihilation by the four depth-two modes propagates to every
polynomial current mode. -/
theorem depthTwoCurrent_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅sl2CurrentE K 0, v⁆ = 0)
    (hE1 : ⁅sl2CurrentE K 1, v⁆ = 0)
    (hF0 : ⁅sl2CurrentF K 0, v⁆ = 0)
    (hF1 : ⁅sl2CurrentF K 1, v⁆ = 0) (k : ℕ) :
    ⁅sl2CurrentE K k, v⁆ = 0 ∧
      ⁅sl2CurrentF K k, v⁆ = 0 ∧
      ⁅sl2CurrentH K k, v⁆ = 0 := by
  have hgen : depthTwoCurrentGenerators K ⊆
      (sl2CurrentPointStabilizer (K := K) v : Set _) := by
    intro A hA
    simp only [depthTwoCurrentGenerators, Set.mem_insert_iff, Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl | rfl
    · exact hE0
    · exact hE1
    · exact hF0
    · exact hF1
  have hle : depthTwoCurrentLie K ≤ sl2CurrentPointStabilizer (K := K) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  exact ⟨hle (sl2CurrentE_mem_depthTwoCurrentLie K k),
    hle (sl2CurrentF_mem_depthTwoCurrentLie K k),
    hle (sl2CurrentH_mem_depthTwoCurrentLie K k)⟩

end Generation

end

end GaloisForLFunctions
