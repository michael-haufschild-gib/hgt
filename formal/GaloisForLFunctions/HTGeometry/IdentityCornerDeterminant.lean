import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-!
# A determinant with an identity corner

If the last `n` columns of a square matrix of size `m + n` are the first `n` standard basis vectors,
then splitting the rows into the lower `m` and the upper `n` exhibits the matrix — after a row
permutation — as

```text
fromBlocks Bbot 0 Btop 1
```

whose determinant is `det Bbot`.  The row permutation contributes only a sign, so

```text
associated_det_of_identity_columns
    ** det N is ASSOCIATED to the determinant of the lower-left m × m block **
```

which is all that is needed when only the ideal generated by the determinant matters.  This is the
last step of the reduction of the critical presentation differential: multiplying the Sylvester
block `[T(Y) | T(A)]` by `T(Y)` turns the `A`-columns into standard basis vectors, and this lemma
then extracts the rectangular Schur Toeplitz determinant of `Y²`.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

variable {C : Type*} [CommRing C] {m n : ℕ}

/-- The row splitting that puts the lower `m` rows first. -/
def rowSplit (m n : ℕ) : Fin m ⊕ Fin n ≃ Fin (m + n) :=
  (Equiv.sumComm (Fin m) (Fin n)).trans (finSumFinEquiv.trans (finCongr (Nat.add_comm n m)))

@[simp] theorem rowSplit_inl (r : Fin m) :
    ((rowSplit m n (Sum.inl r)) : ℕ) = n + (r : ℕ) := rfl

@[simp] theorem rowSplit_inr (j : Fin n) :
    ((rowSplit m n (Sum.inr j)) : ℕ) = (j : ℕ) := rfl

@[simp] theorem colSplit_inl (i : Fin m) :
    ((finSumFinEquiv (Sum.inl i) : Fin (m + n)) : ℕ) = (i : ℕ) := rfl

@[simp] theorem colSplit_inr (j : Fin n) :
    ((finSumFinEquiv (Sum.inr j) : Fin (m + n)) : ℕ) = m + (j : ℕ) := rfl

/-- **A matrix whose last `n` columns are the first `n` standard vectors.**  Its determinant is,
up to sign, the determinant of the lower-left `m × m` block. -/
theorem associated_det_of_identity_columns
    (N : Matrix (Fin (m + n)) (Fin (m + n)) C)
    (hcol : ∀ (j : Fin n) (k : Fin (m + n)),
      N k (finSumFinEquiv (Sum.inr j)) = if (k : ℕ) = (j : ℕ) then 1 else 0) :
    Associated N.det
      (Matrix.of fun r i : Fin m => N (rowSplit m n (Sum.inl r))
        (finSumFinEquiv (Sum.inl i))).det := by
  classical
  set e : Fin m ⊕ Fin n ≃ Fin (m + n) := finSumFinEquiv with he
  set f : Fin m ⊕ Fin n ≃ Fin (m + n) := rowSplit m n with hf
  set Bbot : Matrix (Fin m) (Fin m) C :=
    Matrix.of fun r i : Fin m => N (f (Sum.inl r)) (e (Sum.inl i)) with hBbot
  set Btop : Matrix (Fin n) (Fin m) C :=
    Matrix.of fun j i => N (f (Sum.inr j)) (e (Sum.inl i)) with hBtop
  have hblocks : N.submatrix f e
      = Matrix.fromBlocks Bbot 0 Btop (1 : Matrix (Fin n) (Fin n) C) := by
    ext x y
    cases x with
    | inl r =>
      cases y with
      | inl i => rfl
      | inr j =>
        rw [Matrix.submatrix_apply, hcol j (f (Sum.inl r)), if_neg (by simp [hf]; omega)]
        rfl
    | inr j' =>
      cases y with
      | inl i => rfl
      | inr j =>
        rw [Matrix.submatrix_apply, hcol j (f (Sum.inr j'))]
        rw [Matrix.fromBlocks_apply₂₂, Matrix.one_apply]
        by_cases hjj : j' = j
        · rw [if_pos (by simp [hf, hjj]), if_pos hjj]
        · rw [if_neg (by simp [hf]; intro hc; exact hjj (Fin.ext hc)), if_neg hjj]
  have hdetblocks : (N.submatrix f e).det = Bbot.det := by
    rw [hblocks, Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one]
  have hperm : N.submatrix f e = (N.submatrix e e).submatrix (f.trans e.symm) id := by
    ext x y
    simp [Matrix.submatrix_apply]
  have hsign : (N.submatrix f e).det = Equiv.Perm.sign (f.trans e.symm) * N.det := by
    rw [hperm, Matrix.det_permute, Matrix.det_submatrix_equiv_self]
  have hsq : (Equiv.Perm.sign (f.trans e.symm) : C) * (Equiv.Perm.sign (f.trans e.symm) : C) = 1 := by
    rcases Int.units_eq_one_or (Equiv.Perm.sign (f.trans e.symm)) with h | h <;> rw [h] <;> norm_num
  refine ⟨(Units.mk (Equiv.Perm.sign (f.trans e.symm) : C)
      (Equiv.Perm.sign (f.trans e.symm) : C) hsq hsq), ?_⟩
  rw [Units.val_mk, ← hdetblocks, hsign]
  ring

end GaloisForLFunctions.HTGeometry
