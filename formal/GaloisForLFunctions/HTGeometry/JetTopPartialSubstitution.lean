import GaloisForLFunctions.HTGeometry.JetOrderOneSlicing

/-!
# The top partial of a substituted jet

The substitution acts on the coordinate `y_i` by the affine map `y_i ↦ R'·y_i + σ_i` whose
coefficients involve only lower coordinates, and it maps the field generated by the coordinates
below `i` into itself.  On an element of order at most `i` the chain rule therefore collapses to a
single term:

`∂_i(Φ v) = R'·Φ(∂_i v)`.

Slicing `v` as a fraction in `y_i` over the lower field turns this into the polynomial chain rule:
the twisted composition by an affine substitution differentiates with the constant factor `R'`.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- The top coordinate partial of a polynomial expression in that coordinate is the derivative. -/
theorem pd_aeval_jet (i : ℕ) (P : Polynomial ↥(jetPrefixField C i)) :
    JetField.pd ((), i) (Polynomial.aeval (JetField.jet ((), i) : JetField C Unit) P)
      = Polynomial.aeval (JetField.jet ((), i) : JetField C Unit) (Polynomial.derivative P) := by
  have hx : JetField.pd ((), i) (JetField.jet ((), i) : JetField C Unit) = 1 :=
    JetField.pd_jet_self _
  induction P using Polynomial.induction_on with
  | C a =>
      have ha : JetField.pd ((), i)
          (algebraMap ↥(jetPrefixField C i) (JetField C Unit) a) = 0 :=
        (mem_jetPrefixField_iff i _).mp a.2 i (le_refl i)
      rw [Polynomial.aeval_C, Polynomial.derivative_C, map_zero, ha]
  | add p q hp hq =>
      rw [map_add, map_add, map_add, map_add, hp, hq]
  | monomial n a _ =>
      have hpow : JetField.pd ((), i)
          ((JetField.jet ((), i) : JetField C Unit) ^ (n + 1))
          = ((n : JetField C Unit) + 1) * (JetField.jet ((), i) : JetField C Unit) ^ n := by
        have h := (JetField.pd ((), i) :
          Derivation C (JetField C Unit) (JetField C Unit)).leibniz_pow
            (JetField.jet ((), i) : JetField C Unit) (n + 1)
        simp only [smul_eq_mul, hx, mul_one, Nat.add_sub_cancel] at h
        rw [h]
        ring
      have hleib := (JetField.pd ((), i) :
        Derivation C (JetField C Unit) (JetField C Unit)).leibniz
          (algebraMap ↥(jetPrefixField C i) (JetField C Unit) a)
          ((JetField.jet ((), i) : JetField C Unit) ^ (n + 1))
      simp only [smul_eq_mul] at hleib
      have ha : JetField.pd ((), i)
          (algebraMap ↥(jetPrefixField C i) (JetField C Unit) a) = 0 :=
        (mem_jetPrefixField_iff i _).mp a.2 i (le_refl i)
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X, hleib, ha, hpow,
        Polynomial.derivative_C_mul, Polynomial.derivative_X_pow]
      simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X,
        map_natCast, Nat.add_sub_cancel]
      push_cast
      ring

/-- The twisted composition by an affine substitution differentiates with a constant factor. -/
theorem derivative_twistComp_affine {K : Type*} [Field K] (Φ : K →+* K) (ρ s : K)
    (P : Polynomial K) :
    Polynomial.derivative
        (twistComp Φ (Polynomial.C ρ * Polynomial.X + Polynomial.C s) P)
      = Polynomial.C ρ
        * twistComp Φ (Polynomial.C ρ * Polynomial.X + Polynomial.C s)
            (Polynomial.derivative P) := by
  rw [twistComp, twistComp, Polynomial.derivative_comp, Polynomial.derivative_add,
    Polynomial.derivative_C_mul, Polynomial.derivative_X, Polynomial.derivative_C, mul_one,
    add_zero, Polynomial.derivative_map]

/-- **The top partial of a substituted jet.** -/
theorem pd_top_jetSubstitution (R : RatFunc C) (hR : substitutionDeriv R ≠ 0) {i : ℕ}
    (hi : 1 ≤ i) {v : JetField C Unit} (hv : ∀ j : ℕ, i < j → JetField.pd ((), j) v = 0) :
    JetField.pd ((), i) (jetSubstitution R hR v)
      = substitutionDeriv R * jetSubstitution R hR (JetField.pd ((), i) v) := by
  classical
  set x : JetField C Unit := JetField.jet ((), i) with hxdef
  have hxtr : Transcendental (jetPrefixField C i) x := transcendental_jet_over_jetPrefixField i
  have hinj : Function.Injective (Polynomial.aeval (R := ↥(jetPrefixField C i)) x) :=
    transcendental_iff_injective.mp hxtr
  set Φ : ↥(jetPrefixField C i) →+* ↥(jetPrefixField C i) :=
    (jetSubstitutionPrefix R hR i).toRingHom with hΦdef
  set ρF : ↥(jetPrefixField C i) := substitutionDerivPrefix R hi with hρFdef
  set sF : ↥(jetPrefixField C i) := substitutionShiftPrefix R hi with hsFdef
  have hρval : (algebraMap ↥(jetPrefixField C i) (JetField C Unit)) ρF = substitutionDeriv R := rfl
  set T : Polynomial ↥(jetPrefixField C i) :=
    Polynomial.C ρF * Polynomial.X + Polynomial.C sF with hTdef
  have hact : jetSubstitution R hR x = Polynomial.aeval x T := by
    rw [hxdef, jetSubstitution_jet, hTdef, map_add, map_mul, Polynomial.aeval_C,
      Polynomial.aeval_C, Polynomial.aeval_X, substitutionJet_eq_affine]
    rfl
  -- the polynomial case
  have hpoly : ∀ P : Polynomial ↥(jetPrefixField C i),
      JetField.pd ((), i) (jetSubstitution R hR (Polynomial.aeval x P))
        = substitutionDeriv R
          * jetSubstitution R hR (JetField.pd ((), i) (Polynomial.aeval x P)) := by
    intro P
    rw [jetSubstitution_aeval_of_act R hR hact, pd_aeval_jet, pd_aeval_jet,
      derivative_twistComp_affine, jetSubstitution_aeval_of_act R hR hact, map_mul,
      Polynomial.aeval_C, hρval]
  -- the general case, by the quotient rule
  have hmemadj : v ∈ IntermediateField.adjoin (jetPrefixField C i)
      ({x} : Set (JetField C Unit)) := mem_adjoin_jet_of_order hv
  set f : RatFunc ↥(jetPrefixField C i) :=
    (RatFunc.algEquivOfTranscendental x hxtr).symm ⟨v, hmemadj⟩ with hfdef
  have hxeval : ratFuncEval x hxtr f = v := by
    simp only [ratFuncEval, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, hfdef,
      AlgEquiv.apply_symm_apply]
    rfl
  set P : Polynomial ↥(jetPrefixField C i) := f.num with hPdef
  set Q : Polynomial ↥(jetPrefixField C i) := f.denom with hQdef
  have hQ0 : Q ≠ 0 := RatFunc.denom_ne_zero f
  have hQy : Polynomial.aeval x Q ≠ 0 := fun hh => hQ0 (hinj (by simpa using hh))
  have hvdiv : v = Polynomial.aeval x P / Polynomial.aeval x Q := by
    rw [← hxeval, ratFuncEval_eq_div]
  have hvQ : v * Polynomial.aeval x Q = Polynomial.aeval x P := by
    rw [hvdiv]
    field_simp
  have hΦQ : jetSubstitution R hR (Polynomial.aeval x Q) ≠ 0 := by
    intro hh
    exact hQy ((map_eq_zero_iff _ (jetSubstitution R hR).injective).mp hh)
  -- differentiate the two presentations
  have hpdv : JetField.pd ((), i) v * Polynomial.aeval x Q
      + v * JetField.pd ((), i) (Polynomial.aeval x Q)
      = JetField.pd ((), i) (Polynomial.aeval x P) := by
    have h := congrArg (JetField.pd ((), i) : JetField C Unit → JetField C Unit) hvQ
    have hleib := (JetField.pd ((), i) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz v (Polynomial.aeval x Q)
    simp only [smul_eq_mul] at hleib
    rw [hleib] at h
    linear_combination h
  have hΦeq : jetSubstitution R hR v * jetSubstitution R hR (Polynomial.aeval x Q)
      = jetSubstitution R hR (Polynomial.aeval x P) := by
    rw [← map_mul, hvQ]
  have hpdΦ : JetField.pd ((), i) (jetSubstitution R hR v)
        * jetSubstitution R hR (Polynomial.aeval x Q)
      + jetSubstitution R hR v
        * JetField.pd ((), i) (jetSubstitution R hR (Polynomial.aeval x Q))
      = JetField.pd ((), i) (jetSubstitution R hR (Polynomial.aeval x P)) := by
    have h := congrArg (JetField.pd ((), i) : JetField C Unit → JetField C Unit) hΦeq
    have hleib := (JetField.pd ((), i) :
      Derivation C (JetField C Unit) (JetField C Unit)).leibniz
        (jetSubstitution R hR v) (jetSubstitution R hR (Polynomial.aeval x Q))
    simp only [smul_eq_mul] at hleib
    rw [hleib] at h
    linear_combination h
  refine mul_right_cancel₀ hΦQ ?_
  have hstep := congrArg (fun z => jetSubstitution R hR z) hpdv
  simp only [map_add, map_mul] at hstep
  rw [hpoly P, hpoly Q] at hpdΦ
  linear_combination hpdΦ - substitutionDeriv R * hstep

end

end GaloisForLFunctions.HTGeometry
