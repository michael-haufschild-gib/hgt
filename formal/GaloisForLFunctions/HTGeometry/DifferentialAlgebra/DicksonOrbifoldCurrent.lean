import GaloisForLFunctions.HTGeometry.Polynomial.ChebyshevDifferential
import GaloisForLFunctions.HTGeometry.Polynomial.DicksonCoefficients
import GaloisForLFunctions.HTGeometry.QuadraticOrbifoldTail

/-!
# The Chebyshev quadratic current in the orbifold tail

The rational quadratic differential `dx²/(x²-4)` pulls back under the
normalized Chebyshev map of degree `n` to `n²` times itself. Its current
therefore generates a differential subfield of the map's orbifold tail.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry
open _root_.Polynomial

/-- A normalized Chebyshev polynomial viewed as a rational map. -/
def dicksonRatFunc (n : ℕ) : RatFunc ℂ :=
  algebraMap ℂ[X] (RatFunc ℂ) (dickson 1 1 n)

/-- The coefficient of the quadratic differential with poles at `2` and `-2`. -/
def chebyshevQuadraticCoefficient : RatFunc ℂ := (RatFunc.X ^ 2 - 4)⁻¹

private theorem chebyshev_endpoint_denominator_ne_zero :
    (RatFunc.X ^ 2 - 4 : RatFunc ℂ) ≠ 0 := by
  intro h
  have hp : (X ^ 2 - 4 : ℂ[X]) = 0 :=
    (RatFunc.algebraMap_injective ℂ) (by
      simpa only [map_sub, map_pow, map_ofNat, map_zero, RatFunc.algebraMap_X] using h)
  have hc := congrArg (fun P : ℂ[X] => P.coeff 2) hp
  norm_num at hc

/-- The quadratic differential is nonzero. -/
theorem chebyshevQuadraticCoefficient_ne_zero : chebyshevQuadraticCoefficient ≠ 0 :=
  inv_ne_zero chebyshev_endpoint_denominator_ne_zero

private theorem dickson_derivative_ne_zero (n : ℕ) :
    (dickson 1 (1 : ℂ) (n + 1)).derivative ≠ 0 := by
  intro h
  have hc := congrArg (fun P : ℂ[X] => P.coeff n) h
  rw [coeff_derivative, dickson_coeff_top, one_mul, coeff_zero] at hc
  exact Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n) (by simpa only [Nat.cast_add_one] using hc)

/-- Every positive-degree Dickson map defines the corpus's jet substitution. -/
theorem dicksonRatFunc_substitutionDeriv_ne_zero (n : ℕ) :
    substitutionDeriv (dicksonRatFunc (n + 1)) ≠ 0 :=
  substitutionDeriv_algebraMap_ne_zero (dickson_derivative_ne_zero n)

/-- The differential energy identity as an equality of rational functions. -/
theorem dicksonRatFunc_quadratic_energy (n : ℕ) :
    (ratFuncDeriv (dicksonRatFunc (n + 1))) ^ 2 /
        (dicksonRatFunc (n + 1) ^ 2 - 4) =
      ((n + 1 : ℕ) : RatFunc ℂ) ^ 2 / (RatFunc.X ^ 2 - 4) := by
  have henergy := congrArg (algebraMap ℂ[X] (RatFunc ℂ))
    (dickson_differential_energy (R := ℂ) (n + 1))
  have he : (RatFunc.X ^ 2 - 4) * ratFuncDeriv (dicksonRatFunc (n + 1)) ^ 2 =
      ((n + 1 : ℕ) : RatFunc ℂ) ^ 2 * (dicksonRatFunc (n + 1) ^ 2 - 4) := by
    simpa only [dicksonRatFunc, ratFuncDeriv_algebraMap, map_mul, map_sub,
      map_pow, map_ofNat, map_natCast, RatFunc.algebraMap_X] using henergy
  have hd : ratFuncDeriv (dicksonRatFunc (n + 1)) ≠ 0 :=
    ratFuncDeriv_ne_zero (dicksonRatFunc_substitutionDeriv_ne_zero n)
  have hp : dicksonRatFunc (n + 1) ^ 2 - 4 ≠ 0 := by
    intro h
    rw [h, mul_zero] at he
    exact (mul_ne_zero chebyshev_endpoint_denominator_ne_zero (pow_ne_zero 2 hd)) he
  apply (div_eq_div_iff hp chebyshev_endpoint_denominator_ne_zero).mpr
  simpa only [mul_comm] using he

/-- The Chebyshev quadratic differential has eigenvalue equal to the squared degree. -/
theorem dicksonRatFunc_isInvariantDifferential (n : ℕ) :
    IsInvariantDifferential (dicksonRatFunc (n + 1))
      (dicksonRatFunc_substitutionDeriv_ne_zero n) 2
      (ratFuncEval (JetField.jet ((), 0) : JetField ℂ Unit)
        transcendental_freeGen chebyshevQuadraticCoefficient) (((n + 1 : ℕ) : ℂ) ^ 2) := by
  apply isInvariantDifferential_of_ratFunc_relation _ _ chebyshevQuadraticCoefficient_ne_zero
  simp only [chebyshevQuadraticCoefficient, map_inv₀, map_sub, map_pow, map_ofNat,
    ratFuncSubstitutionAlgHom_X, zpow_ofNat, map_natCast]
  simpa only [div_eq_mul_inv, mul_comm] using dicksonRatFunc_quadratic_energy n

/-- The quadratic current is an explicit eigenvector of the free-jet substitution. -/
theorem dicksonRatFunc_current_eigen (n : ℕ) :
    jetSubstitution (dicksonRatFunc (n + 1)) (dicksonRatFunc_substitutionDeriv_ne_zero n)
        (invariantCurrent 2 (ratFuncEval (JetField.jet ((), 0) : JetField ℂ Unit)
          transcendental_freeGen chebyshevQuadraticCoefficient)) =
      algebraMap ℂ (JetField ℂ Unit) (((n + 1 : ℕ) : ℂ) ^ 2) *
        invariantCurrent 2 (ratFuncEval (JetField.jet ((), 0) : JetField ℂ Unit)
          transcendental_freeGen chebyshevQuadraticCoefficient) :=
  jetSubstitution_invariantCurrent _ _ (dicksonRatFunc_isInvariantDifferential n)

/-- The full differential field generated by the current survives every substitution depth. -/
theorem dicksonRatFunc_current_differentialAdjoin_le_tail (n : ℕ) :
    differentialAdjoin ℂ
      ({invariantCurrent 2 (ratFuncEval (JetField.jet ((), 0) : JetField ℂ Unit)
        transcendental_freeGen chebyshevQuadraticCoefficient)} : Set (JetField ℂ Unit)) ≤
      orbifoldTail (dicksonRatFunc (n + 1)) (dicksonRatFunc_substitutionDeriv_ne_zero n) := by
  apply differentialAdjoin_le_orbifoldTail_of_isInvariantDifferential
    _ _ (pow_ne_zero 2 (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)))
    (dicksonRatFunc_isInvariantDifferential n)

end GaloisForLFunctions.HTGeometry
