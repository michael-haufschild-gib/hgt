import GaloisForLFunctions.HTGeometry.UpperEndDifferentialField
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Jets of a germ are germs of jets

Differentiation on germs at the upper end is induced by differentiation of representatives, so
iterating it transports the analytic jets of a function to the abstract jets of its germ:

`(upperEndGermDeriv)^[n] ⟦f⟧ = ⟦iteratedDeriv n f⟧`.

This is the step that lets a presentation in the differential field generated by a germ be read as a
polynomial in the analytic jets on the line.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter Set Topology Function
open scoped Differential

/-- **Iterated germ differentiation is the germ of the iterated derivative.** -/
theorem upperEndGermDeriv_iterate_coe (n : ℕ) (f : ℂ → ℂ) :
    (upperEndGermDeriv^[n] (f : Germ upperEndFilter ℂ) : Germ upperEndFilter ℂ)
      = ((fun z : ℂ => iteratedDeriv n f z) : Germ upperEndFilter ℂ) := by
  induction n generalizing f with
  | zero =>
    simp [iteratedDeriv_zero]
  | succ n ih =>
    rw [Function.iterate_succ_apply, upperEndGermDeriv_coe, ih]
    congr 1
    funext z
    rw [iteratedDeriv_succ']

/-- **Jets in the meromorphic field are the iterated analytic derivatives.**  On the image of the
analytic subring the differential-field jets are computed by iterating `upperEndAnalyticDeriv`. -/
theorem differentialJet_algebraMap (n : ℕ) (a : upperEndAnalyticSubring) :
    letI := isDomain_upperEndAnalyticSubring
    letI := upperEndMeroFieldDifferential
    differentialJet n
        (algebraMap upperEndAnalyticSubring upperEndMeroField a)
      = algebraMap upperEndAnalyticSubring upperEndMeroField (upperEndAnalyticDeriv^[n] a) := by
  letI := isDomain_upperEndAnalyticSubring
  letI := upperEndMeroFieldDifferential
  induction n generalizing a with
  | zero => simp [differentialJet]
  | succ n ih =>
    have hstep : differentialJet (n + 1)
        (algebraMap upperEndAnalyticSubring upperEndMeroField a)
        = differentialJet n
          (Differential.deriv (algebraMap upperEndAnalyticSubring upperEndMeroField a)) := by
      rw [differentialJet, differentialJet,
        Function.iterate_succ_apply]
    rw [hstep, upperEndMeroFieldDifferential_algebraMap, ih, Function.iterate_succ_apply]

/-- Iterating the analytic derivative is iterating the germ derivative. -/
theorem upperEndAnalyticDeriv_iterate_coe (n : ℕ) (a : upperEndAnalyticSubring) :
    ((upperEndAnalyticDeriv^[n] a : upperEndAnalyticSubring) : Germ upperEndFilter ℂ)
      = upperEndGermDeriv^[n] ((a : upperEndAnalyticSubring) : Germ upperEndFilter ℂ) := by
  induction n generalizing a with
  | zero => simp
  | succ n ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih,
      upperEndAnalyticDeriv_coe]

/-- **The transport, end to end.**  If an analytic germ is represented by `f`, then its `n`-th jet is
represented by the `n`-th iterated derivative of `f`. -/
theorem upperEndAnalyticDeriv_iterate_repr (n : ℕ) (a : upperEndAnalyticSubring) (f : ℂ → ℂ)
    (hf : ((a : upperEndAnalyticSubring) : Germ upperEndFilter ℂ)
      = (f : Germ upperEndFilter ℂ)) :
    ((upperEndAnalyticDeriv^[n] a : upperEndAnalyticSubring) : Germ upperEndFilter ℂ)
      = (iteratedDeriv n f : Germ upperEndFilter ℂ) := by
  rw [upperEndAnalyticDeriv_iterate_coe, hf, upperEndGermDeriv_iterate_coe]

end GaloisForLFunctions.HTGeometry
