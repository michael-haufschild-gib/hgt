import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity
import GaloisForLFunctions.HTGeometry.ProjectiveHorizonJetTailTransition

/-!
# Hypertranscendence of the Schwarzian projective current

The Schwarzian of a hypertranscendental scalar is not merely nonconstant: it is itself
hypertranscendental.  Indeed, if the Schwarzian were differentially algebraic, then the cleared
third-order Schwarzian equation would make the source differentially algebraic over the field
generated by its Schwarzian, and differential-algebraic transitivity would contradict the source
hypothesis.

Combining this with projective-horizon complementarity shows that opposite first-jet horizons
share a genuinely hypertranscendental observable.
-/

open scoped Differential
open Set

namespace GaloisForLFunctions

noncomputable section

/-- The Schwarzian projective current of a hypertranscendental scalar is hypertranscendental. -/
theorem hypertranscendentalOver_schwarzian
    {C K : Type*} [Field C] [CharZero C] [Differential C]
    [Field K] [CharZero K] [Algebra C K] [Differential K]
    [DifferentialAlgebra C K]
    {x : K} (hx : HypertranscendentalOver C x) :
    HypertranscendentalOver C (schwarzian x) := by
  intro hsDA
  apply hx
  apply differentialAlgebraicOver_trans hsDA
  let S := differentialAdjoin C ({schwarzian x} : Set K)
  let c : S :=
    ⟨schwarzian x, subset_differentialAdjoin C ({schwarzian x} : Set K) rfl⟩
  change DifferentialAlgebraicOver S x
  intro hind
  have hdx : x′ ≠ 0 := by
    have hxind : DifferentialIndependent C (fun _ : Unit => x) :=
      (hypertranscendentalOver_iff_differentialIndependent_singleton C x).mp hx
    have hj : AlgebraicIndependent C
        (fun p : Unit × ℕ => differentialJet p.2 x) := hxind
    intro hzero
    have htr := hj.transcendental ((), 1)
    apply htr
    simpa [differentialJet_succ, hzero] using
      (isAlgebraic_zero : IsAlgebraic C (0 : K))
  have hcross :
      2 * x′ * x′′′ - 3 * x′′ ^ 2 - 2 * algebraMap S K c * x′ ^ 2 = 0 := by
    change 2 * x′ * x′′′ - 3 * x′′ ^ 2 - 2 * schwarzian x * x′ ^ 2 = 0
    unfold schwarzian
    field_simp [hdx]
    ring
  have hrel : schwarzianRelation c ∈
      differentialRelationIdeal (C := S) (fun _ : Unit => x) := by
    rw [mem_differentialRelationIdeal_iff,
      differentialPolynomialEval_schwarzianRelation]
    exact hcross
  have hbot : differentialRelationIdeal (C := S) (fun _ : Unit => x) = ⊥ :=
    (differentialIndependent_iff_relationIdeal_eq_bot _).mp hind
  rw [hbot, Ideal.mem_bot] at hrel
  exact schwarzianRelation_ne_zero c hrel

/-- Opposite first projective horizons share the hypertranscendental Schwarzian current. -/
theorem hypertranscendentalOver_projectiveHorizon_sharedSchwarzianProfile
    {C E : Type*} [Field C] [CharZero C] [Differential C]
    [Field E] [CharZero E] [Algebra C E] [Differential E]
    [DifferentialAlgebra C E]
    (x : E) (hx : HypertranscendentalOver C x) :
    HypertranscendentalOver C (schwarzian x) ∧
      schwarzian x ∈ jetTailField C x 1 ⊓ jetTailField C x⁻¹ 1 := by
  exact ⟨hypertranscendentalOver_schwarzian hx,
    hypertranscendentalOver_schwarzian_mem_inf_firstJetTail_inv x hx⟩

end

end GaloisForLFunctions
