import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Topology.Algebra.Module.FiniteDimension
import Mathlib.Topology.Connected.Basic

/-!
# Higher period and analytic Spencer generation

This file isolates the common finite-dimensional argument behind the twisted-module, strict
kernel, semistrict kernel, and leading-curvature Ambrose--Singer cards.  Based simplex integrals
generate an additive period subgroup.  Its closed identity component is supplied together with
its canonical real-vector-subspace structure; this is the lifted restricted period Lie algebra.
Continuous small-simplex curves and their leading asymptotics then recover every transported
curvature value.  The opposite inclusion follows because every simplex integral lies in the
finite-dimensional curvature span.

The analytic part records Taylor approximants, not an equality of spans: closedness of a
finite-dimensional jet span turns convergence of those approximants into the Spencer equality.
-/

namespace HTGeometry.NomologicalHomotopyGeometry.HigherPeriodSpencer

open Filter Set Topology

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [FiniteDimensional ℝ V]

/-- Finite-dimensional higher-period geometry generated by based simplex integrals.

`restricted_carrier` identifies the displayed submodule with the actual identity component of
the topological closure of the integral subgroup.  Thus scalar closure is typed explicitly and
is not silently imposed on the full (possibly disconnected) period closure.
-/
structure PeriodGeometry (ι σ : Type*) where
  arity : ℕ
  arity_ge_two : 2 ≤ arity
  curvatureValue : ι → V
  simplexIntegral : σ → V
  simplexIntegral_mem_span : ∀ s,
    simplexIntegral s ∈ Submodule.span ℝ (Set.range curvatureValue)
  restrictedAlgebra : Submodule ℝ V
  restricted_carrier : (restrictedAlgebra : Set V) =
    connectedComponentIn
      (closure (AddSubgroup.closure (Set.range simplexIntegral) : Set V)) 0
  smallSimplex : ι → ℝ → σ
  smallCell_zero : ∀ i, simplexIntegral (smallSimplex i 0) = 0
  smallCell_continuous : ∀ i, Continuous (fun t => simplexIntegral (smallSimplex i t))
  smallCell_limit : ∀ i,
    Tendsto
      (fun t => (t ^ arity)⁻¹ • simplexIntegral (smallSimplex i t))
      (𝓝[≠] 0) (𝓝 (curvatureValue i))

namespace PeriodGeometry

variable {ι σ : Type*} (P : PeriodGeometry (V := V) ι σ)

/-- Span of all parallel-transported pointwise curvature values. -/
def curvatureSpan : Submodule ℝ V :=
  Submodule.span ℝ (Set.range P.curvatureValue)

/-- Additive subgroup generated by all based simplex integrals. -/
def periodSubgroup : AddSubgroup V :=
  AddSubgroup.closure (Set.range P.simplexIntegral)

/-- Topological closure of the higher-period subgroup. -/
def periodClosure : Set V :=
  closure (P.periodSubgroup : Set V)

omit [FiniteDimensional ℝ V] in
/-- Every generated higher period lies in the transported curvature span. -/
theorem periodSubgroup_subset_curvatureSpan :
    (P.periodSubgroup : Set V) ⊆ P.curvatureSpan := by
  intro x hx
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
      rcases hx with ⟨s, rfl⟩
      exact P.simplexIntegral_mem_span s
  | zero => exact P.curvatureSpan.zero_mem
  | add x y _ _ hx hy => exact P.curvatureSpan.add_mem hx hy
  | neg x _ hx => exact P.curvatureSpan.neg_mem hx

/-- The entire topological period closure still lies in the curvature span. -/
theorem periodClosure_subset_curvatureSpan :
    P.periodClosure ⊆ P.curvatureSpan := by
  apply P.curvatureSpan.closed_of_finiteDimensional.closure_subset_iff.mpr
  exact P.periodSubgroup_subset_curvatureSpan

omit [FiniteDimensional ℝ V] in
/-- A small-simplex curve lies in the identity component of the period closure. -/
theorem smallCell_mem_restrictedAlgebra (i : ι) (t : ℝ) :
    P.simplexIntegral (P.smallSimplex i t) ∈ P.restrictedAlgebra := by
  change P.simplexIntegral (P.smallSimplex i t) ∈ (P.restrictedAlgebra : Set V)
  rw [P.restricted_carrier]
  exact (isPreconnected_range (P.smallCell_continuous i)).subset_connectedComponentIn
    ⟨0, P.smallCell_zero i⟩
    (fun _ ⟨t, ht⟩ => ht ▸ subset_closure
      (AddSubgroup.subset_closure ⟨P.smallSimplex i t, rfl⟩))
    (Set.mem_range_self t)

/-- The identity-component period algebra is contained in the curvature span. -/
theorem restrictedAlgebra_le_curvatureSpan :
    P.restrictedAlgebra ≤ P.curvatureSpan := by
  intro x hx
  apply P.periodClosure_subset_curvatureSpan
  apply connectedComponentIn_subset P.periodClosure 0
  change x ∈ connectedComponentIn
    (closure (AddSubgroup.closure (Set.range P.simplexIntegral) : Set V)) 0
  rw [← P.restricted_carrier]
  exact hx

/-- Small-cell asymptotics recover every transported curvature generator. -/
theorem curvatureValue_mem_restrictedAlgebra (i : ι) :
    P.curvatureValue i ∈ P.restrictedAlgebra := by
  apply P.restrictedAlgebra.closed_of_finiteDimensional.mem_of_tendsto
    (P.smallCell_limit i)
  exact Filter.Eventually.of_forall fun t =>
    P.restrictedAlgebra.smul_mem _ (P.smallCell_mem_restrictedAlgebra i t)

/-- Curvature values generate the lifted restricted higher-period Lie algebra. -/
theorem restrictedAlgebra_eq_curvatureSpan :
    P.restrictedAlgebra = P.curvatureSpan := by
  apply le_antisymm P.restrictedAlgebra_le_curvatureSpan
  rw [curvatureSpan, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  exact P.curvatureValue_mem_restrictedAlgebra i

/-- The universal higher Ambrose--Singer equality in pointwise-span notation. -/
theorem higher_ambroseSinger :
    P.restrictedAlgebra = Submodule.span ℝ (Set.range P.curvatureValue) :=
  P.restrictedAlgebra_eq_curvatureSpan

end PeriodGeometry

/-- Analytic Spencer data expressed through convergent finite Taylor approximants.

The two fields are exactly the two analytic-continuation inputs: covariant jets are limits of
transported values, while every transported value is a limit of finite combinations of jets.
-/
structure AnalyticSpencerGeometry (ι σ κ : Type*) extends PeriodGeometry (V := V) ι σ where
  jetValue : κ → V
  curvatureApproximation : κ → ℕ → V
  curvatureApproximation_mem : ∀ k n,
    curvatureApproximation k n ∈
      Submodule.span ℝ (Set.range toPeriodGeometry.curvatureValue)
  curvatureApproximation_tendsto : ∀ k,
    Tendsto (curvatureApproximation k) atTop (𝓝 (jetValue k))
  taylorApproximation : ι → ℕ → V
  taylorApproximation_mem : ∀ i n,
    taylorApproximation i n ∈ Submodule.span ℝ (Set.range jetValue)
  taylorApproximation_tendsto : ∀ i,
    Tendsto (taylorApproximation i) atTop
      (𝓝 (toPeriodGeometry.curvatureValue i))

namespace AnalyticSpencerGeometry

variable {ι σ κ : Type*} (A : AnalyticSpencerGeometry (V := V) ι σ κ)

/-- Span of all covariant Taylor coefficients at the base point. -/
def jetSpan : Submodule ℝ V :=
  Submodule.span ℝ (Set.range A.jetValue)

/-- Every covariant jet lies in the transported curvature span. -/
theorem jetValue_mem_curvatureSpan (k : κ) :
    A.jetValue k ∈ A.toPeriodGeometry.curvatureSpan := by
  apply A.toPeriodGeometry.curvatureSpan.closed_of_finiteDimensional.mem_of_tendsto
    (A.curvatureApproximation_tendsto k)
  exact Filter.Eventually.of_forall (A.curvatureApproximation_mem k)

/-- Every transported curvature value lies in the analytic jet span. -/
theorem curvatureValue_mem_jetSpan (i : ι) :
    A.toPeriodGeometry.curvatureValue i ∈ A.jetSpan := by
  apply A.jetSpan.closed_of_finiteDimensional.mem_of_tendsto
    (A.taylorApproximation_tendsto i)
  exact Filter.Eventually.of_forall (A.taylorApproximation_mem i)

/-- Analytic continuation identifies transported-curvature and covariant-jet spans. -/
theorem curvatureSpan_eq_jetSpan :
    A.toPeriodGeometry.curvatureSpan = A.jetSpan := by
  apply le_antisymm
  · rw [PeriodGeometry.curvatureSpan, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact A.curvatureValue_mem_jetSpan i
  · rw [jetSpan, Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    exact A.jetValue_mem_curvatureSpan k

/-- Analytic higher Ambrose--Singer--Spencer generation. -/
theorem higher_ambroseSinger_spencer :
    A.toPeriodGeometry.restrictedAlgebra = A.jetSpan := by
  rw [A.toPeriodGeometry.restrictedAlgebra_eq_curvatureSpan,
    A.curvatureSpan_eq_jetSpan]

end AnalyticSpencerGeometry

section NoUniformCutoff

/-- A one-dimensional analytic jet family whose first nonzero coefficient is delayed to `N`. -/
def delayedJet (N k : ℕ) : ℝ :=
  if k = N then 1 else 0

@[simp]
theorem delayedJet_self (N : ℕ) : delayedJet N N = 1 := by
  simp [delayedJet]

theorem delayedJet_eq_zero_of_lt {N k : ℕ} (hk : k < N) : delayedJet N k = 0 := by
  simp [delayedJet, ne_of_lt hk]

/-- All delayed jets span the coefficient line. -/
theorem delayedJet_full_span (N : ℕ) :
    Submodule.span ℝ (Set.range (delayedJet N)) = ⊤ := by
  apply top_unique
  intro x _
  have hOne : (1 : ℝ) ∈ Submodule.span ℝ (Set.range (delayedJet N)) := by
    apply Submodule.subset_span
    exact ⟨N, delayedJet_self N⟩
  simpa using (Submodule.span ℝ (Set.range (delayedJet N))).smul_mem x hOne

/-- Every jet below the delayed order vanishes. -/
theorem delayedJet_truncated_span (N : ℕ) :
    Submodule.span ℝ (delayedJet N '' Set.Iio N) = ⊥ := by
  rw [eq_bot_iff, Submodule.span_le]
  rintro _ ⟨k, hk, rfl⟩
  simpa using delayedJet_eq_zero_of_lt hk

/-- No proposed uniform finite jet order can detect every nonzero analytic curvature family. -/
theorem no_uniform_finite_jet_cutoff (N : ℕ) :
    Submodule.span ℝ (delayedJet N '' Set.Iio N) = ⊥ ∧
      Submodule.span ℝ (Set.range (delayedJet N)) = ⊤ :=
  ⟨delayedJet_truncated_span N, delayedJet_full_span N⟩

end NoUniformCutoff

end HTGeometry.NomologicalHomotopyGeometry.HigherPeriodSpencer
