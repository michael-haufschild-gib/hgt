/-- Factorized normal form for adjugate contribution 1 at gap degree eight. -/
def evenCompactGapCofactorTerm4Slice8 (u w : ℝ) : ℝ :=
  (evenCompactGapCofactorTerm4LeftSlice0Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice8Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice1Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice7Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice2Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice6Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice3Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice5Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice4Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice4Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice5Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice3Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice6Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice2Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice7Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice1Certificate u w).value +
    (evenCompactGapCofactorTerm4LeftSlice8Certificate u w).value *
      (evenCompactGapCofactorTerm4RightSlice0Certificate u w).value

theorem evenCompactGapCofactorTerm4_coeff_slice8 (u w : ℝ) :
    (evenCompactGapCofactorTerm4 u w).coeff 8 = evenCompactGapCofactorTerm4Slice8 u w := by
  unfold evenCompactGapCofactorTerm4 evenCompactGapCofactorTerm4Slice8
  rw [evenCompactGapCoeff_mul_8]
  simp only [
    (evenCompactGapCofactorTerm4LeftSlice0Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice1Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice2Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice3Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice4Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice5Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice6Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice7Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4LeftSlice8Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice0Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice1Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice2Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice3Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice4Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice5Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice6Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice7Certificate u w).eq_value,
    (evenCompactGapCofactorTerm4RightSlice8Certificate u w).eq_value]

end

