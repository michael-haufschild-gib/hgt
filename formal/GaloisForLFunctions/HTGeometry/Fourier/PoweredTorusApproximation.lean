import GaloisForLFunctions.HTGeometry.InfiniteTorusCharacter

/-!
# Uniform approximation from adjacent powered torus coordinates

The powered-generator question of Chi--Thien, arXiv:2611.14973,
has an exact answer on the corpus's product tori. The observations
`z^(n+1)` and `conj(z)^(n+2)` recover both orientations of each coordinate
by polynomial identities. Their ordinary complex algebra is therefore
self-adjoint and dense by Stone--Weierstrass.
-/

namespace GaloisForLFunctions.HTGeometry
noncomputable section
variable {ι : Type*} [DecidableEq ι]

/-- One coordinate Fourier mode, as a continuous function on the full torus. -/
def coordinateMode (i : ι) (a : ℤ) : C(UnitAddTorus ι, ℂ) :=
  torusCharacter (Finsupp.single i a)

omit [DecidableEq ι] in
theorem coordinateMode_add (i : ι) (a b : ℤ) :
    coordinateMode i (a + b) = coordinateMode i a * coordinateMode i b := by
  ext x
  exact (congrArg (fun v => torusCharacter v x) (Finsupp.single_add i a b)).trans
    (torusCharacter_add_index _ _ x)

theorem coordinateMode_nat_mul (i : ι) (k : ℕ) (a : ℤ) :
    coordinateMode i ((k : ℤ) * a) = coordinateMode i a ^ k := by
  induction k with
  | zero =>
    ext x
    simp only [Nat.cast_zero, zero_mul, coordinateMode, Finsupp.single_zero,
      torusCharacter_zero, pow_zero, ContinuousMap.one_apply]
  | succ k ih =>
    rw [Nat.cast_succ, add_mul, one_mul, coordinateMode_add, ih, pow_succ]

omit [DecidableEq ι] in
theorem coordinateMode_star (i : ι) (a : ℤ) :
    star (coordinateMode i a) = coordinateMode i (-a) := by
  ext x
  exact (torusCharacter_neg_index (Finsupp.single i a) x).symm.trans
    (congrArg (fun v => torusCharacter v x) (Finsupp.single_neg i a).symm)

/-- Polynomial reconstruction of the positive coordinate. -/
theorem adjacentPowers_recover_coordinate (i : ι) (n : ℕ) :
    coordinateMode i ((n : ℤ) + 1) ^ (n + 1) *
      coordinateMode i (-((n : ℤ) + 2)) ^ n = coordinateMode i 1 := by
  rw [← coordinateMode_nat_mul, ← coordinateMode_nat_mul, ← coordinateMode_add]
  congr 1
  push_cast
  ring

/-- A single product recovers the conjugate coordinate. -/
theorem adjacentPowers_recover_conjugate (i : ι) (n : ℕ) :
    coordinateMode i ((n : ℤ) + 1) * coordinateMode i (-((n : ℤ) + 2)) =
      coordinateMode i (-1) := by
  rw [← coordinateMode_add]
  congr 1
  ring

/-- The ordinary algebra generated by the two powered observations per coordinate. -/
def adjacentPowerTorusAlgebra (ι : Type*) [DecidableEq ι] (n : ℕ) :
    Subalgebra ℂ C(UnitAddTorus ι, ℂ) :=
  Algebra.adjoin ℂ {f | ∃ i : ι,
    f = coordinateMode i ((n : ℤ) + 1) ∨ f = coordinateMode i (-((n : ℤ) + 2))}

theorem coordinate_mem_adjacentPowerTorusAlgebra (n : ℕ) (i : ι) :
    coordinateMode i 1 ∈ adjacentPowerTorusAlgebra ι n ∧
      coordinateMode i (-1) ∈ adjacentPowerTorusAlgebra ι n := by
  have hp : coordinateMode i ((n : ℤ) + 1) ∈ adjacentPowerTorusAlgebra ι n :=
    Algebra.subset_adjoin ⟨i, Or.inl rfl⟩
  have hm : coordinateMode i (-((n : ℤ) + 2)) ∈ adjacentPowerTorusAlgebra ι n :=
    Algebra.subset_adjoin ⟨i, Or.inr rfl⟩
  constructor
  · rw [← adjacentPowers_recover_coordinate i n]
    exact (adjacentPowerTorusAlgebra ι n).mul_mem
      ((adjacentPowerTorusAlgebra ι n).pow_mem hp _) ((adjacentPowerTorusAlgebra ι n).pow_mem hm _)
  · rw [← adjacentPowers_recover_conjugate i n]
    exact (adjacentPowerTorusAlgebra ι n).mul_mem hp hm

/-- Polynomial reconstruction closes the ordinary algebra under conjugation. -/
theorem adjacentPowerTorusAlgebra_star_mem (n : ℕ) :
    adjacentPowerTorusAlgebra ι n ≤ star (adjacentPowerTorusAlgebra ι n) := by
    apply Algebra.adjoin_le
    rintro f ⟨i, rfl | rfl⟩
    · change star (coordinateMode i ((n : ℤ) + 1)) ∈ adjacentPowerTorusAlgebra ι n
      rw [coordinateMode_star]
      have he : -((n : ℤ) + 1) = ((n + 1 : ℕ) : ℤ) * (-1) := by push_cast; ring
      rw [he, coordinateMode_nat_mul]
      exact (adjacentPowerTorusAlgebra ι n).pow_mem
        (coordinate_mem_adjacentPowerTorusAlgebra n i).2 _
    · change star (coordinateMode i (-((n : ℤ) + 2))) ∈ adjacentPowerTorusAlgebra ι n
      rw [coordinateMode_star, neg_neg]
      have he : (n : ℤ) + 2 = ((n + 2 : ℕ) : ℤ) * 1 := by push_cast; ring
      rw [he, coordinateMode_nat_mul]
      exact (adjacentPowerTorusAlgebra ι n).pow_mem
        (coordinate_mem_adjacentPowerTorusAlgebra n i).1 _

/-- The same ordinary algebra, equipped with its proved self-adjointness. -/
def adjacentPowerTorusStarAlgebra (ι : Type*) [DecidableEq ι] (n : ℕ) :
    StarSubalgebra ℂ C(UnitAddTorus ι, ℂ) where
  toSubalgebra := adjacentPowerTorusAlgebra ι n
  star_mem' := adjacentPowerTorusAlgebra_star_mem n

/-- The recovered coordinates distinguish every pair of torus points. -/
theorem adjacentPowerTorusStarAlgebra_separatesPoints (n : ℕ) :
    (adjacentPowerTorusStarAlgebra ι n).SeparatesPoints := by
  intro x y hxy
  obtain ⟨i, hi⟩ : ∃ i, x i ≠ y i := Function.ne_iff.mp hxy
  refine ⟨_, ⟨coordinateMode i 1, (coordinate_mem_adjacentPowerTorusAlgebra n i).1,
    rfl⟩, ?_⟩
  have hv (z : UnitAddTorus ι) : coordinateMode i 1 z = fourier 1 (z i) := by
    rw [coordinateMode, torusCharacter_apply_of_subset
      (s := {i}) Finsupp.support_single_subset]
    rw [Finset.prod_singleton, Finsupp.single_eq_same]
  simp only [hv]
  rw [fourier_one, fourier_one]
  intro he
  rw [Subtype.coe_inj] at he
  exact hi (AddCircle.injective_toCircle one_ne_zero he)

/-- Powered observations uniformly approximate every continuous torus observable. -/
theorem adjacentPowerTorusAlgebra_closure_eq_top [Countable ι] (n : ℕ) :
    (adjacentPowerTorusAlgebra ι n).topologicalClosure = ⊤ := by
  exact congrArg StarSubalgebra.toSubalgebra
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints
      (adjacentPowerTorusStarAlgebra ι n) (adjacentPowerTorusStarAlgebra_separatesPoints n))

#print axioms adjacentPowers_recover_coordinate
#print axioms adjacentPowerTorusAlgebra_closure_eq_top

end
end GaloisForLFunctions.HTGeometry
