/-
# A symmetric function of a Hermitian spectrum is a polynomial in the traces of the powers

Combining the fundamental theorem of symmetric polynomials with Newton inversion, every symmetric
polynomial lies in the subalgebra generated by the power sums.  For the spectrum of a Hermitian
matrix the power sums are the traces of its powers, which are polynomials in the entries; so a
symmetric function of the spectrum of a linear matrix family is a polynomial in the coordinates.

Main results:
* `aeval_mem_adjoin_range`, `adjoin_range_le_range_aeval` — the adjoined subalgebra is the range of
  the substitution.
* `isSymmetric_mem_adjoin_psum`, `exists_aeval_psum_repr_of_isSymmetric` — **a symmetric polynomial
  is a polynomial in the power sums**.
* `exists_trace_repr_of_isSymmetric` — **a symmetric function of a Hermitian spectrum is a
  polynomial in the traces of the powers**.
-/
import GaloisForLFunctions.HTGeometry.EsymmAdjoinPsum
import GaloisForLFunctions.HTGeometry.SymmetricEsymmRepresentation
import GaloisForLFunctions.HTGeometry.RankEnergyPowerSum

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

variable {σ R : Type*} [Fintype σ] [CommRing R]

omit [Fintype σ] in
/-- A substituted polynomial lies in the subalgebra generated by the substituted values. -/
theorem aeval_mem_adjoin_range {ι : Type*} (f : ι → MvPolynomial σ R) (P : MvPolynomial ι R) :
    MvPolynomial.aeval f P ∈ Algebra.adjoin R (Set.range f) := by
  induction P using MvPolynomial.induction_on with
  | C r =>
      rw [MvPolynomial.aeval_C]
      exact Subalgebra.algebraMap_mem _ r
  | add p q hp hq =>
      rw [map_add]
      exact Subalgebra.add_mem _ hp hq
  | mul_X p i hp =>
      rw [map_mul, MvPolynomial.aeval_X]
      exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨i, rfl⟩)

omit [Fintype σ] in
/-- Conversely the subalgebra is contained in the range of the substitution. -/
theorem adjoin_range_le_range_aeval {ι : Type*} (f : ι → MvPolynomial σ R) :
    Algebra.adjoin R (Set.range f)
      ≤ (MvPolynomial.aeval f : MvPolynomial ι R →ₐ[R] MvPolynomial σ R).range := by
  refine Algebra.adjoin_le ?_
  rintro x ⟨i, rfl⟩
  exact ⟨MvPolynomial.X i, by simp⟩

variable [Algebra ℚ R]

/-- **A symmetric polynomial lies in the subalgebra generated by the power sums.** -/
theorem isSymmetric_mem_adjoin_psum (p : MvPolynomial σ R) (hp : p.IsSymmetric) :
    p ∈ Algebra.adjoin R (Set.range fun j : ℕ => MvPolynomial.psum σ R (j + 1)) := by
  obtain ⟨P, hP⟩ := exists_bind₁_esymm_of_isSymmetric p hp
  rw [← hP, ← MvPolynomial.aeval_eq_bind₁]
  have hle : Algebra.adjoin R
        (Set.range fun i : Fin (Fintype.card σ) => MvPolynomial.esymm σ R (i + 1))
      ≤ Algebra.adjoin R (Set.range fun j : ℕ => MvPolynomial.psum σ R (j + 1)) := by
    refine Algebra.adjoin_le ?_
    rintro x ⟨i, rfl⟩
    exact esymm_mem_adjoin_psum σ R ((i : ℕ) + 1)
  exact hle (aeval_mem_adjoin_range _ P)

/-- **A symmetric polynomial is a polynomial in the power sums.** -/
theorem exists_aeval_psum_repr_of_isSymmetric (p : MvPolynomial σ R) (hp : p.IsSymmetric) :
    ∃ W : MvPolynomial ℕ R,
      MvPolynomial.aeval (fun j : ℕ => MvPolynomial.psum σ R (j + 1)) W = p :=
  adjoin_range_le_range_aeval _ (isSymmetric_mem_adjoin_psum p hp)

/-- **A symmetric function of a Hermitian spectrum is a polynomial in the traces of its powers.**
The polynomial does not depend on the matrix. -/
theorem exists_trace_repr_of_isSymmetric {D : ℕ} (p : MvPolynomial (Fin D) ℂ)
    (hp : p.IsSymmetric) :
    ∃ W : MvPolynomial ℕ ℂ, ∀ (H : Matrix (Fin D) (Fin D) ℂ) (hH : H.IsHermitian),
      MvPolynomial.eval (fun i => ((hH.eigenvalues i : ℝ) : ℂ)) p
        = MvPolynomial.eval (fun j : ℕ => (H ^ (j + 1)).trace) W := by
  obtain ⟨W, hW⟩ := exists_aeval_psum_repr_of_isSymmetric p hp
  refine ⟨W, fun H hH => ?_⟩
  have hWb : MvPolynomial.bind₁ (fun j : ℕ => MvPolynomial.psum (Fin D) ℂ (j + 1)) W = p := by
    rw [← MvPolynomial.aeval_eq_bind₁]
    exact hW
  rw [← hWb]
  have hbind := MvPolynomial.eval₂Hom_bind₁ (RingHom.id ℂ)
    (fun i => ((hH.eigenvalues i : ℝ) : ℂ))
    (fun j : ℕ => MvPolynomial.psum (Fin D) ℂ (j + 1)) W
  have hpsum : ∀ j : ℕ,
      (MvPolynomial.eval₂Hom (RingHom.id ℂ) (fun i => ((hH.eigenvalues i : ℝ) : ℂ)))
          (MvPolynomial.psum (Fin D) ℂ (j + 1))
        = (H ^ (j + 1)).trace := by
    intro j
    rw [MvPolynomial.psum, map_sum, trace_pow_eq_sum_eigenvalues_pow hH]
    exact Finset.sum_congr rfl fun i _ => by simp
  refine Eq.trans hbind ?_
  rw [funext hpsum]
  rfl

end

end GaloisForLFunctions.HTGeometry
