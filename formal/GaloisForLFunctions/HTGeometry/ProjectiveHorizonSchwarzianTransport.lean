import GaloisForLFunctions.HTGeometry.ProjectiveHorizonSchwarzianEquiv
import GaloisForLFunctions.HTGeometry.FreeCoordinateSupportKernel

/-!
# Transport of the support-kernel theorem along the Schwarzian coordinates

Under the Schwarzian change of coordinates the subfield generated by the coordinates from index
three on becomes the differential field generated by the Schwarzian.  So a jet observable whose
pullback is killed by the first three coordinate derivations is a rational function of the
Schwarzian and its jets.

This is the support-kernel theorem read in the coordinate system where the projective gauge moves
only the first three coordinates.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- The differential field generated by the Schwarzian of the base jet coordinate. -/
def schwarzianDifferentialField (C : Type*) [Field C] :
    IntermediateField C (FreeScalarJetField C) :=
  IntermediateField.adjoin C (Set.range fun k : ℕ => differentialJet k (freeJetSchwarzian C))

/-- The Schwarzian change of coordinates carries the tail coordinate field onto the differential
field generated by the Schwarzian. -/
theorem schwarzianBasisEquiv_map_tailField :
    (freeCoordinateField C ℕ {m : ℕ | 3 ≤ m}).map (schwarzianBasisEquiv C).toAlgHom =
      schwarzianDifferentialField C := by
  rw [freeCoordinateField, IntermediateField.adjoin_map, schwarzianDifferentialField,
    Set.image_image]
  congr 1
  rw [show (fun m : ℕ => (schwarzianBasisEquiv C).toAlgHom (freeCoordinate C ℕ m)) =
      schwarzianSystem C from by
    funext m
    exact schwarzianBasisEquiv_freeCoordinate m]
  exact schwarzianBasisEquiv_image_tail

/-- **The transported support-kernel theorem.**  A jet observable whose pullback along the
Schwarzian coordinates is killed by the first three coordinate derivations lies in the differential
field generated by the Schwarzian. -/
theorem mem_schwarzianDifferentialField_of_forall {f : FreeScalarJetField C}
    (h : ∀ m : ℕ, m < 3 →
      freeCoordinateDerivation C ℕ m ((schwarzianBasisEquiv C).symm f) = 0) :
    f ∈ schwarzianDifferentialField C := by
  have hmem := mem_freeCoordinateField_of_forall_freeCoordinateDerivation_eq_zero
    (S := {m : ℕ | 3 ≤ m}) (f := (schwarzianBasisEquiv C).symm f)
    (fun i hi => h i (by simpa using hi))
  rw [← schwarzianBasisEquiv_map_tailField]
  exact ⟨(schwarzianBasisEquiv C).symm f, hmem, by simp⟩

end

end GaloisForLFunctions.HTGeometry
