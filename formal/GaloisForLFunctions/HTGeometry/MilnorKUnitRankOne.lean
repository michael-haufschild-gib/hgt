import GaloisForLFunctions.HTGeometry.MilnorKTateFiltration

/-!
# Degree-two Milnor symbols of a unit group of rank at most one

Tate's Euclidean descent reduces the degree-two tame kernel of a Euclidean domain to the subgroup
generated by the symbols of its *units*.  Over `ℤ` the unit group is `{±1}`, so that subgroup is
killed by two and the tame kernel is torsion.  The general mechanism behind that last step is not
finiteness of the unit group but the vanishing of `Λ²` in rank at most one:

> if every element of a subgroup `U ≤ Fˣ` has a nonzero power inside the cyclic group generated by a
> single `g`, then every symbol `{a, b}` with `a, b ∈ U` is torsion.

The proof is three lines of bilinearity: raising `a` and `b` to suitable powers lands both inside
`⟨g⟩`, and there the symbol collapses to a multiple of `{g, g} = {-1, g}`, which is killed by two.

This is exactly the input that makes the Euclidean descent conclusive for a number field of unit
rank at most one — `ℚ`, the imaginary quadratic fields, the real quadratic fields, the cubic fields
with one real place and the totally complex quartic fields — where `rank 𝒪_F^× = r₁ + r₂ − 1 ≤ 1`.

* `milnorSym2_two_nsmul_self` : **`2·{a, a} = 0`.**
* `milnorSym2_nsmul_eq_zero_of_isOfFinOrder_left` : a torsion entry makes the symbol torsion.
* `milnorSym2_isTorsion_of_rank_le_one` : **rank at most one makes every symbol torsion.**
-/

namespace GaloisForLFunctions.HTGeometry

variable (F : Type*) [Field F]

private theorem nsmul_of_zsmul {A : Type*} [AddCommGroup A] {n : ℕ} {x : A}
    (h : ((n : ℤ)) • x = 0) : n • x = 0 := by
  rwa [natCast_zsmul] at h

/-- `{a, a} = {-1, a}` is killed by two, because `{(-1)^(2 : ℕ), a} = {1, a} = 0`. -/
theorem milnorSym2_two_zsmul_self (a : Fˣ) : (2 : ℤ) • milnorSym2 F a a = 0 := by
  have hzpow : milnorSym2 F ((-1 : Fˣ) ^ (2 : ℤ)) a = (2 : ℤ) • milnorSym2 F (-1) a :=
    milnorSym2_zpow_left (-1) a 2
  have hsq : ((-1 : Fˣ) ^ (2 : ℤ)) = 1 := by
    rw [zpow_two, neg_one_mul, neg_neg]
  rw [hsq, milnorSym2_one_left] at hzpow
  rw [milnorSym2_self]
  exact hzpow.symm

theorem milnorSym2_two_nsmul_self (a : Fˣ) : (2 : ℕ) • milnorSym2 F a a = 0 :=
  nsmul_of_zsmul (by exact_mod_cast milnorSym2_two_zsmul_self F a)

/-- A torsion entry makes the symbol torsion. -/
theorem milnorSym2_nsmul_eq_zero_of_isOfFinOrder_left {a : Fˣ} (ha : IsOfFinOrder a) (b : Fˣ) :
    ∃ n : ℕ, n ≠ 0 ∧ n • milnorSym2 F a b = 0 := by
  refine ⟨orderOf a, ha.orderOf_pos.ne', nsmul_of_zsmul ?_⟩
  have hzpow : milnorSym2 F (a ^ ((orderOf a : ℕ) : ℤ)) b
      = ((orderOf a : ℕ) : ℤ) • milnorSym2 F a b :=
    milnorSym2_zpow_left a b _
  rw [zpow_natCast, pow_orderOf_eq_one, milnorSym2_one_left] at hzpow
  exact hzpow.symm

/-- **A unit group of rank at most one has torsion degree-two symbols.**  If every element of `U`
has a nonzero power inside `⟨g⟩`, then raising both entries of a symbol to suitable powers lands it
in the cyclic group generated by `g`, where it becomes a multiple of `{g, g}` and is killed by
two. -/
theorem milnorSym2_isTorsion_of_rank_le_one {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ n : ℕ, n ≠ 0 ∧ u ^ n ∈ Subgroup.zpowers g)
    {a b : Fˣ} (ha : a ∈ U) (hb : b ∈ U) :
    ∃ n : ℕ, n ≠ 0 ∧ n • milnorSym2 F a b = 0 := by
  obtain ⟨m, hm, i, hi⟩ := hU a ha
  obtain ⟨k, hk, j, hj⟩ := hU b hb
  refine ⟨2 * (m * k), by positivity, nsmul_of_zsmul ?_⟩
  have ha' : a ^ (m : ℤ) = g ^ i := by
    rw [zpow_natCast]
    exact hi.symm
  have hb' : b ^ (k : ℤ) = g ^ j := by
    rw [zpow_natCast]
    exact hj.symm
  have h1 : milnorSym2 F (a ^ (m : ℤ)) (b ^ (k : ℤ))
      = ((m : ℤ) * (k : ℤ)) • milnorSym2 F a b := by
    rw [milnorSym2_zpow_left, milnorSym2_zpow_right, smul_smul]
  have h2 : milnorSym2 F (g ^ i) (g ^ j) = (i * j) • milnorSym2 F g g := by
    rw [milnorSym2_zpow_left, milnorSym2_zpow_right, smul_smul]
  have hstep : ((m : ℤ) * (k : ℤ)) • milnorSym2 F a b = (i * j) • milnorSym2 F g g := by
    rw [← h1, ← h2, ha', hb']
  have hcast : ((2 * (m * k) : ℕ) : ℤ) • milnorSym2 F a b
      = (2 : ℤ) • (((m : ℤ) * (k : ℤ)) • milnorSym2 F a b) := by
    rw [smul_smul]
    push_cast
    ring_nf
  rw [hcast, hstep, smul_comm, milnorSym2_two_zsmul_self, smul_zero]

theorem milnorSym2_mem_torsion_of_rank_le_one {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ n : ℕ, n ≠ 0 ∧ u ^ n ∈ Subgroup.zpowers g)
    {a b : Fˣ} (ha : a ∈ U) (hb : b ∈ U) :
    milnorSym2 F a b ∈ torsionAddSubgroup (MilnorKDeg F 2) := by
  obtain ⟨n, hn, hnx⟩ := milnorSym2_isTorsion_of_rank_le_one F hU ha hb
  exact ⟨(n : ℤ), by exact_mod_cast hn, by rw [natCast_zsmul]; exact hnx⟩

/-- **Everything generated by the symbols of a rank-at-most-one unit group is torsion.**  This is
the last step of Tate's Euclidean descent, in the form it takes over a number field whose unit rank
is at most one: `ℚ`, the imaginary and real quadratic fields, the cubic fields with one real place,
and the totally complex quartic fields. -/
theorem closure_milnorSym2_le_torsion_of_rank_le_one {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ n : ℕ, n ≠ 0 ∧ u ^ n ∈ Subgroup.zpowers g) :
    AddSubgroup.closure {y : MilnorKDeg F 2 | ∃ a ∈ U, ∃ b ∈ U, y = milnorSym2 F a b}
      ≤ torsionAddSubgroup (MilnorKDeg F 2) := by
  refine AddSubgroup.closure_le _ |>.2 ?_
  rintro y ⟨a, ha, b, hb, rfl⟩
  exact milnorSym2_mem_torsion_of_rank_le_one F hU ha hb

/-- **Dirichlet in rank one is exactly the hypothesis of the rank-at-most-one theorem.**  If every
element of `U` is a root of unity times a power of a fixed `g` — which is what Dirichlet's unit
theorem says about `𝒪_F^×` when `r₁ + r₂ − 1 = 1`, and trivially when it is `0` — then every element
of `U` has a nonzero power in `⟨g⟩`. -/
theorem forall_pow_mem_zpowers_of_torsion_mul_zpow {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ (t : Fˣ) (k : ℤ), IsOfFinOrder t ∧ u = t * g ^ k) :
    ∀ u ∈ U, ∃ n : ℕ, n ≠ 0 ∧ u ^ n ∈ Subgroup.zpowers g := by
  intro u hu
  obtain ⟨t, k, ht, rfl⟩ := hU u hu
  refine ⟨orderOf t, ht.orderOf_pos.ne', ⟨k * (orderOf t : ℤ), ?_⟩⟩
  rw [mul_pow, ← zpow_natCast t (orderOf t), zpow_natCast, pow_orderOf_eq_one, one_mul,
    ← zpow_natCast (g ^ k) (orderOf t), ← zpow_mul]

/-- **The rank-at-most-one theorem in the form Dirichlet delivers.** -/
theorem milnorSym2_isTorsion_of_torsion_mul_zpow {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ (t : Fˣ) (k : ℤ), IsOfFinOrder t ∧ u = t * g ^ k)
    {a b : Fˣ} (ha : a ∈ U) (hb : b ∈ U) :
    ∃ n : ℕ, n ≠ 0 ∧ n • milnorSym2 F a b = 0 :=
  milnorSym2_isTorsion_of_rank_le_one F (forall_pow_mem_zpowers_of_torsion_mul_zpow F hU) ha hb

/-! ## The symbol subgroup of a unit group -/

/-- The subgroup of `K₂^M(F)` generated by the degree-two symbols of a subgroup of units. -/
def symbolSubgroup (U : Subgroup Fˣ) : AddSubgroup (MilnorKDeg F 2) :=
  AddSubgroup.closure {y | ∃ a ∈ U, ∃ b ∈ U, y = milnorSym2 F a b}

/-- **The units whose symbol against a fixed `b` lands in `T`** form a subgroup, because the left
slot of the symbol is a homomorphism. -/
def leftStab (T : AddSubgroup (MilnorKDeg F 2)) (b : Fˣ) : Subgroup Fˣ where
  carrier := {a | milnorSym2 F a b ∈ T}
  one_mem' := by
    show milnorSym2 F 1 b ∈ T
    rw [milnorSym2_one_left]
    exact T.zero_mem
  mul_mem' := by
    intro x y hx hy
    show milnorSym2 F (x * y) b ∈ T
    rw [milnorSym2_mul_left]
    exact T.add_mem hx hy
  inv_mem' := by
    intro x hx
    show milnorSym2 F x⁻¹ b ∈ T
    rw [milnorSym2_inv_left]
    exact T.neg_mem hx

/-- **The units whose symbol against a fixed `a` lands in `T`** form a subgroup, because the right
slot of the symbol is a homomorphism. -/
def rightStab (T : AddSubgroup (MilnorKDeg F 2)) (a : Fˣ) : Subgroup Fˣ where
  carrier := {b | milnorSym2 F a b ∈ T}
  one_mem' := by
    show milnorSym2 F a 1 ∈ T
    rw [milnorSym2_one_right]
    exact T.zero_mem
  mul_mem' := by
    intro x y hx hy
    show milnorSym2 F a (x * y) ∈ T
    rw [milnorSym2_mul_right]
    exact T.add_mem hx hy
  inv_mem' := by
    intro x hx
    show milnorSym2 F a x⁻¹ ∈ T
    rw [milnorSym2_inv_right]
    exact T.neg_mem hx

/-- **The symbols of a generated unit group are generated by the symbols of the generators.**  Both
slots are homomorphisms, so membership in a subgroup of `K₂^M(F)` propagates along the generation of
the unit group, one slot at a time. -/
theorem symbolSubgroup_closure_le (G : Set Fˣ) (T : AddSubgroup (MilnorKDeg F 2))
    (hG : ∀ a ∈ G, ∀ b ∈ G, milnorSym2 F a b ∈ T) :
    symbolSubgroup F (Subgroup.closure G) ≤ T := by
  have hstep : ∀ a ∈ G, ∀ b ∈ Subgroup.closure G, milnorSym2 F a b ∈ T := by
    intro a ha b hb
    have : Subgroup.closure G ≤ rightStab F T a :=
      Subgroup.closure_le _ |>.2 fun c hc => hG a ha c hc
    exact this hb
  refine AddSubgroup.closure_le _ |>.2 ?_
  rintro y ⟨a, ha, b, hb, rfl⟩
  have : Subgroup.closure G ≤ leftStab F T b :=
    Subgroup.closure_le _ |>.2 fun c hc => hstep c hc b hb
  exact this ha

/-- **The symbol subgroup of a finitely generated unit group is finitely generated.**  For a number
field this says that the symbols of the `S`-units span a finitely generated subgroup of `K₂^M(F)`,
by Dirichlet's unit theorem — and since `K₂^M(F)` is the directed union of these subgroups, finite
generation of the tame kernel is exactly the statement that it is contained in one of them. -/
theorem symbolSubgroup_fg_of_fg {U : Subgroup Fˣ} (hU : U.FG) :
    (symbolSubgroup F U).FG := by
  classical
  obtain ⟨G, hG⟩ := hU
  refine ⟨(G ×ˢ G).image fun p => milnorSym2 F p.1 p.2, ?_⟩
  refine le_antisymm ?_ ?_
  · refine AddSubgroup.closure_le _ |>.2 ?_
    intro y hy
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hy)
    obtain ⟨hp1, hp2⟩ := Finset.mem_product.1 hp
    refine AddSubgroup.subset_closure ⟨p.1, ?_, p.2, ?_, rfl⟩
    · rw [← hG]; exact Subgroup.subset_closure hp1
    · rw [← hG]; exact Subgroup.subset_closure hp2
  · rw [← hG]
    refine symbolSubgroup_closure_le F (G : Set Fˣ) _ fun a ha b hb => ?_
    refine AddSubgroup.subset_closure ?_
    exact Finset.mem_coe.2 (Finset.mem_image.2 ⟨(a, b), Finset.mem_product.2 ⟨ha, hb⟩, rfl⟩)

theorem symbolSubgroup_mono {U U' : Subgroup Fˣ} (h : U ≤ U') :
    symbolSubgroup F U ≤ symbolSubgroup F U' := by
  refine AddSubgroup.closure_mono ?_
  rintro y ⟨a, ha, b, hb, rfl⟩
  exact ⟨a, h ha, b, h hb, rfl⟩

/-- **`K₂^M(F)` is the directed union of the symbol subgroups of finitely generated unit groups.**
Every class is a finite combination of symbols, and the finitely many entries generate a finitely
generated subgroup of `Fˣ`.  Combined with `symbolSubgroup_fg_of_fg`, this exhibits `K₂^M(F)` as a
directed union of finitely generated abelian groups — which is why the divisibility firewall cannot
be broken without pinning the tame kernel inside a *single* stage. -/
theorem exists_finset_mem_symbolSubgroup (x : MilnorKDeg F 2) :
    ∃ G : Finset Fˣ, x ∈ symbolSubgroup F (Subgroup.closure (G : Set Fˣ)) := by
  classical
  set T : AddSubgroup (MilnorKDeg F 2) :=
    { carrier := {y | ∃ G : Finset Fˣ, y ∈ symbolSubgroup F (Subgroup.closure (G : Set Fˣ))}
      zero_mem' := ⟨∅, AddSubgroup.zero_mem _⟩
      add_mem' := by
        rintro y z ⟨G₁, hy⟩ ⟨G₂, hz⟩
        refine ⟨G₁ ∪ G₂, AddSubgroup.add_mem _ ?_ ?_⟩
        · exact symbolSubgroup_mono F (Subgroup.closure_mono (by
            intro g hg
            exact Finset.mem_coe.2 (Finset.mem_union_left _ (Finset.mem_coe.1 hg)))) hy
        · exact symbolSubgroup_mono F (Subgroup.closure_mono (by
            intro g hg
            exact Finset.mem_coe.2 (Finset.mem_union_right _ (Finset.mem_coe.1 hg)))) hz
      neg_mem' := by
        rintro y ⟨G, hy⟩
        exact ⟨G, AddSubgroup.neg_mem _ hy⟩ } with hT
  have hgen : AddSubgroup.closure (Set.range fun p : Fˣ × Fˣ => milnorSym2 F p.1 p.2) ≤ T := by
    refine AddSubgroup.closure_le _ |>.2 ?_
    rintro y ⟨p, rfl⟩
    refine ⟨{p.1, p.2}, AddSubgroup.subset_closure ⟨p.1, ?_, p.2, ?_, rfl⟩⟩
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.subset_closure (by simp)
  have hx : x ∈ T := by
    rw [closure_range_milnorSym2] at hgen
    exact hgen (AddSubgroup.mem_top x)
  exact hx

/-- **The symbol subgroup of a unit group of rank at most one is torsion**, with the hypothesis in
the shape Dirichlet's unit theorem provides. -/
theorem symbolSubgroup_le_torsion_of_torsion_mul_zpow {U : Subgroup Fˣ} {g : Fˣ}
    (hU : ∀ u ∈ U, ∃ (t : Fˣ) (k : ℤ), IsOfFinOrder t ∧ u = t * g ^ k) :
    symbolSubgroup F U ≤ torsionAddSubgroup (MilnorKDeg F 2) :=
  closure_milnorSym2_le_torsion_of_rank_le_one F
    (forall_pow_mem_zpowers_of_torsion_mul_zpow F hU)

@[simp]
theorem mem_leftStab {T : AddSubgroup (MilnorKDeg F 2)} {b a : Fˣ} :
    a ∈ leftStab F T b ↔ milnorSym2 F a b ∈ T := Iff.rfl

@[simp]
theorem mem_rightStab {T : AddSubgroup (MilnorKDeg F 2)} {a b : Fˣ} :
    b ∈ rightStab F T a ↔ milnorSym2 F a b ∈ T := Iff.rfl

end GaloisForLFunctions.HTGeometry
