import GaloisForLFunctions.HTGeometry.RittJetDenominator
import GaloisForLFunctions.HTGeometry.RittDifferentialAlgebraicBridge

/-!
# The logarithmic seed with a transcendental eigen-coordinate

Let `u` be an affine connection of a Ritt frame (`σ u = ρ⁻¹u + b`) and `v` an eigen-coordinate
(`σ v = ρ⁻¹v`, `d v = u·v`).  Suppose the jets `u, …, d^{n−1}u` are algebraically independent,
`d^n u` is algebraic over them, and `v` is transcendental over the jet field.

* **Collapse.**  `d^n u / v^{n+1}` moves by an increment of the field generated by the jets and `v`,
  so additive rigidity puts it there; `d^n u` is then an element of a simple transcendental
  extension of the jet field that is algebraic over the jet field, hence lies in the jet field.
  Its reduced denominator is `k·v^W`, and `W = 0` because `v` is transcendental: `d^n u` is a
  polynomial in the lower jets.
* **Order.**  The shift symmetry and the constant-defect residual give `n ≤ 1`.
* **Normal form.**  For `n = 0` the connection lies in the base; for `n = 1` its Schwarzian
  `d u − u²/2` lies in the base.
-/

open MvPolynomial
open scoped IntermediateField

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- **Algebraic elements of a simple transcendental extension lie in the base field.** -/
theorem exists_algebraMap_eq_of_mem_adjoin_simple_of_transcendental {F E : Type*} [Field F]
    [Field E] [Algebra F E] {v y : E} (hv : Transcendental F v) (hy : y ∈ F⟮v⟯)
    (hyalg : IsAlgebraic F y) : ∃ a : F, algebraMap F E a = y := by
  classical
  obtain ⟨r, s, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff F _).mp hy
  set y := Polynomial.aeval v r / Polynomial.aeval v s with hydef
  by_contra hne
  push Not at hne
  have hs : Polynomial.aeval v s ≠ 0 := by
    intro h0
    apply hne 0
    rw [map_zero, hydef, h0, div_zero]
  set E' := F⟮y⟯ with hE'
  have hyE : y ∈ E' := IntermediateField.mem_adjoin_simple_self F y
  let ι : F →+* E' := algebraMap F E'
  set P : Polynomial E' := r.map ι - Polynomial.C (⟨y, hyE⟩ : E') * s.map ι with hP
  have hP0 : P ≠ 0 := by
    intro h0
    have hs0 : s ≠ 0 := by
      rintro rfl
      exact hs (by simp)
    obtain ⟨i, hi⟩ : ∃ i, s.coeff i ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hs0 (Polynomial.ext fun i => by simpa using hall i)
    have hc := congrArg (fun p : Polynomial E' => ((p.coeff i : E') : E)) h0
    simp only [hP, Polynomial.coeff_sub, Polynomial.coeff_map, Polynomial.coeff_C_mul,
      Polynomial.coeff_zero] at hc
    push_cast at hc
    apply hne (r.coeff i / s.coeff i)
    have hsi : algebraMap F E (s.coeff i) ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap F E).injective).mpr hi
    rw [map_div₀, div_eq_iff hsi]
    have h1 : ((ι (r.coeff i) : E')  : E) = algebraMap F E (r.coeff i) := rfl
    have h2 : ((ι (s.coeff i) : E')  : E) = algebraMap F E (s.coeff i) := rfl
    rw [h1, h2] at hc
    linear_combination hc
  have hPv : Polynomial.aeval v P = 0 := by
    have hmap : ∀ q : Polynomial F, Polynomial.aeval v (q.map ι) = Polynomial.aeval v q := by
      intro q
      rw [Polynomial.aeval_map_algebraMap]
    rw [hP, map_sub, map_mul, hmap, hmap, Polynomial.aeval_C]
    show Polynomial.aeval v r - y * Polynomial.aeval v s = 0
    rw [hydef, div_mul_cancel₀ _ hs, sub_self]
  have hvE' : IsAlgebraic E' v := ⟨P, hP0, hPv⟩
  haveI : Algebra.IsAlgebraic F E' :=
    IntermediateField.isAlgebraic_adjoin_simple (isAlgebraic_iff_isIntegral.mp hyalg)
  exact hv (hvE'.restrictScalars F)

namespace RittFrame

variable {K L : Type*} [Field K] [Field L] [Algebra K L] (Fr : RittFrame K L) {n : ℕ}

/-- The field generated by the jets and the eigen-coordinate. -/
def jetEigenField (u v : L) (n : ℕ) : IntermediateField K L :=
  IntermediateField.adjoin K (insert v {x | ∃ j < n, x = Fr.d^[j] u})

theorem jetPrefixField_le_jetEigenField (u v : L) (n : ℕ) :
    Fr.jetPrefixField u n ≤ Fr.jetEigenField u v n :=
  IntermediateField.adjoin.mono _ _ _ (Set.subset_insert _ _)

theorem mem_jetEigenField_self (u v : L) (n : ℕ) : v ∈ Fr.jetEigenField u v n :=
  IntermediateField.subset_adjoin _ _ (Set.mem_insert _ _)

theorem sigma_mem_jetEigenField {u v : L} {b : K}
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b)
    (hv : Fr.σ v = algebraMap K L Fr.ρ⁻¹ * v) :
    ∀ x ∈ Fr.jetEigenField u v n, Fr.σ x ∈ Fr.jetEigenField u v n := by
  refine Fr.sigma_mem_of_mem_adjoin ?_
  intro x hx
  rcases Set.mem_insert_iff.mp hx with rfl | ⟨j, hj, rfl⟩
  · rw [hv]
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (Fr.mem_jetEigenField_self u x n)
  · exact Fr.jetPrefixField_le_jetEigenField u v n
      (Fr.sigma_mem_affineJetPrefixField hu n _ (Fr.jet_mem_jetPrefixField hj))

theorem jetEigenField_eq_adjoin (u v : L) (n : ℕ) :
    Fr.jetEigenField u v n
      = IntermediateField.restrictScalars K ((Fr.jetPrefixField u n)⟮v⟯) := by
  rw [jetEigenField, jetPrefixField, IntermediateField.adjoin_adjoin_left,
    Set.union_singleton]

/-- **The top jet lies in the jet field.** -/
theorem jet_mem_jetPrefixField_of_transcendental [CharZero K] {u v : L} {b : K}
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b)
    (hv : Fr.σ v = algebraMap K L Fr.ρ⁻¹ * v) (hv0 : v ≠ 0)
    (halg : IsAlgebraic ↥(Fr.jetPrefixField u n) (Fr.d^[n] u))
    (htr : Transcendental ↥(Fr.jetPrefixField u n) v) :
    Fr.d^[n] u ∈ Fr.jetPrefixField u n := by
  classical
  set E := Fr.jetEigenField u v n with hE
  have hEσ := Fr.sigma_mem_jetEigenField (n := n) hu hv
  have hvE : v ∈ E := Fr.mem_jetEigenField_self u v n
  have hle := Fr.jetPrefixField_le_jetEigenField u v n
  -- the shift increment
  set t := Fr.towerDefect u b n with ht
  have htE : t ∈ E := hle (Fr.towerDefect_mem u b n)
  have hvpow : v ^ (n + 1) ≠ 0 := pow_ne_zero _ hv0
  set w := Fr.d^[n] u / v ^ (n + 1) with hw
  set c := algebraMap K L (Fr.ρ ^ (n + 1)) * t / v ^ (n + 1) with hc
  have hcE : c ∈ E := div_mem (mul_mem (IntermediateField.algebraMap_mem _ _) htE)
    (pow_mem hvE _)
  have hσw : Fr.σ w = w + c := by
    have hσv : Fr.σ (v ^ (n + 1)) = algebraMap K L (Fr.ρ ^ (n + 1))⁻¹ * v ^ (n + 1) := by
      rw [map_pow, hv, mul_pow, ← map_pow, inv_pow]
    have hρ : algebraMap K L (Fr.ρ ^ (n + 1)) ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap K L).injective).mpr (pow_ne_zero _ Fr.ρ_ne)
    rw [hw, hc, map_div₀, Fr.sigma_jet_eq_defect hu n, hσv, map_inv₀]
    field_simp
    ring
  -- additive rigidity over the eigen field
  have hcomp : ∀ a : ↥E, Fr.σ (algebraMap ↥E L a) = algebraMap ↥E L
      (⟨Fr.σ (a : L), hEσ (a : L) a.2⟩ : ↥E) := fun _ => rfl
  have hfix : ∀ y : L, Fr.σ y = y → ∃ a : ↥E, algebraMap ↥E L a = y := by
    intro y hy
    obtain ⟨a, rfl⟩ := Fr.fixed y hy
    exact ⟨⟨algebraMap K L a, IntermediateField.algebraMap_mem _ _⟩, rfl⟩
  haveI : CharZero ↥E := charZero_of_injective_algebraMap (algebraMap K ↥E).injective
  have hint : IsIntegral ↥E w := by
    have hn : IsIntegral ↥E (Fr.d^[n] u) :=
      (isAlgebraic_of_intermediateField_le hle halg).isIntegral
    have hvinv : (v ^ (n + 1))⁻¹ = algebraMap ↥E L (⟨v ^ (n + 1), pow_mem hvE _⟩ : ↥E)⁻¹ := by
      rw [map_inv₀]
      rfl
    rw [hw, div_eq_mul_inv, hvinv]
    exact hn.mul isIntegral_algebraMap
  obtain ⟨a, ha⟩ :=
    exists_algebraMap_eq_of_isIntegral_of_shift_add Fr.σ
      ({ toFun := fun a : ↥E => ⟨Fr.σ (a : L), hEσ (a : L) a.2⟩
         map_one' := by ext; simp
         map_mul' := fun _ _ => by ext; simp
         map_zero' := by ext; simp
         map_add' := fun _ _ => by ext; simp } : ↥E →+* ↥E)
      hcomp hfix (c := (⟨c, hcE⟩ : ↥E)) hσw hint
  have hwE : w ∈ E := by rw [← ha]; exact (a : ↥E).2
  have hjetE : Fr.d^[n] u ∈ E := by
    have : Fr.d^[n] u = w * v ^ (n + 1) := by rw [hw, div_mul_cancel₀ _ hvpow]
    rw [this]
    exact mul_mem hwE (pow_mem hvE _)
  -- algebraic elements of the simple transcendental extension
  rw [hE, Fr.jetEigenField_eq_adjoin] at hjetE
  obtain ⟨y, hy⟩ := exists_algebraMap_eq_of_mem_adjoin_simple_of_transcendental htr hjetE halg
  rw [← hy]
  exact y.2

/-- **The top jet is a polynomial in the lower jets.** -/
theorem exists_polynomial_jet_of_transcendental [CharZero K] {u v : L} {b : K}
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b)
    (hv : Fr.σ v = algebraMap K L Fr.ρ⁻¹ * v) (hv0 : v ≠ 0)
    (hind : AlgebraicIndependent K (Fr.jetFamily u n))
    (halg : IsAlgebraic ↥(Fr.jetPrefixField u n) (Fr.d^[n] u))
    (htr : Transcendental ↥(Fr.jetPrefixField u n) v) :
    ∃ F : MvPolynomial (Fin n) K, Fr.d^[n] u = aeval (Fr.jetFamily u n) F := by
  classical
  have hmem := Fr.jet_mem_jetPrefixField_of_transcendental hu hv hv0 halg htr
  obtain ⟨A, B, hB, hrel, hAB⟩ := Fr.exists_reduced_fraction_of_mem_jetPrefixField hind hmem
  have hσ : Fr.σ (Fr.d^[n] u) = algebraMap K L (Fr.ρ ^ (n + 1))⁻¹ * Fr.d^[n] u
      + aeval (Fr.jetFamily u n) (Fr.defectPoly b n) := by
    rw [Fr.sigma_jet_eq_defect hu n, aeval_defectPoly]
  obtain ⟨μ', hμ'⟩ := Fr.towerShift_denominator hu hind hB hrel hAB
    (inv_ne_zero (pow_ne_zero _ Fr.ρ_ne)) hσ
  obtain ⟨k, W, hk, hBk⟩ := Fr.aeval_eq_of_towerShift_eigen hu hv hv0 hind hB hμ'
  have hW : W = 0 := by
    by_contra hW
    apply htr
    have hvW : v ^ W ∈ Fr.jetPrefixField u n := by
      have hBmem : aeval (Fr.jetFamily u n) B ∈ Fr.jetPrefixField u n := by
        have hring : aeval (Fr.jetFamily u n) B ∈ Fr.jetPrefixRing u n := by
          rw [Fr.jetPrefixRing_eq_adjoin_range u n, Algebra.adjoin_range_eq_range_aeval]
          exact ⟨B, rfl⟩
        exact Fr.jetPrefixRing_le_jetPrefixField u n _ hring
      have hkL : algebraMap K L k ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr hk
      have : v ^ W = algebraMap K L k⁻¹ * aeval (Fr.jetFamily u n) B := by
        rw [hBk, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hk, map_one, one_mul]
      rw [this]
      exact mul_mem (IntermediateField.algebraMap_mem _ _) hBmem
    refine ⟨Polynomial.X ^ W - Polynomial.C (⟨v ^ W, hvW⟩ : ↥(Fr.jetPrefixField u n)), ?_, ?_⟩
    · exact Polynomial.X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero hW) _
    · simp
  rw [hW, pow_zero, mul_one] at hBk
  refine ⟨C k⁻¹ * A, ?_⟩
  rw [map_mul, aeval_C, ← hAB, hBk]
  have hkL : algebraMap K L k ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr hk
  rw [map_inv₀]
  field_simp

/-- Transcendence over the jet field gives the algebraic independence of the jets together with
the eigen-coordinate. -/
theorem algebraicIndependent_cons_of_transcendental {u v : L}
    (hind : AlgebraicIndependent K (Fr.jetFamily u n))
    (htr : Transcendental ↥(Fr.jetPrefixField u n) v) :
    AlgebraicIndependent K (Fin.cons v (Fr.jetFamily u n) : Fin (n + 1) → L) := by
  have hopt : AlgebraicIndependent K (fun o : Option (Fin n) => o.elim v (Fr.jetFamily u n)) := by
    refine AlgebraicIndependent.option_iff.mpr ⟨hind, ?_⟩
    intro halg
    apply htr
    obtain ⟨p, hp0, hp⟩ := halg
    have hsub : Algebra.adjoin K (Set.range (Fr.jetFamily u n))
        ≤ (Fr.jetPrefixField u n).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨j, rfl⟩
      exact Fr.jet_mem_jetPrefixField j.isLt
    let ι : ↥(Algebra.adjoin K (Set.range (Fr.jetFamily u n))) →+* ↥(Fr.jetPrefixField u n) :=
      (Subalgebra.inclusion hsub).toRingHom
    have hι : Function.Injective ι := Subalgebra.inclusion_injective hsub
    refine ⟨p.map ι, (Polynomial.map_ne_zero_iff hι).mpr hp0, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    rw [Polynomial.aeval_def] at hp
    have hcomp : (algebraMap (↥(Fr.jetPrefixField u n)) L).comp ι
        = algebraMap (↥(Algebra.adjoin K (Set.range (Fr.jetFamily u n)))) L := by
      ext; rfl
    rw [hcomp]
    exact hp
  have hcomp := hopt.comp (_root_.finSuccEquiv n) (_root_.finSuccEquiv n).injective
  convert hcomp using 1
  funext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp

/-- **The collapse order with a transcendental eigen-coordinate is at most one.** -/
theorem le_one_of_transcendental_eigen [CharZero K] {u v : L} {b : K}
    (hb : b = -(Fr.dK Fr.ρ) / Fr.ρ ^ 2) (hb0 : b ≠ 0) (hS : Fr.logConst b 1 ≠ b ^ 2 / 2)
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b)
    (hv : Fr.σ v = algebraMap K L Fr.ρ⁻¹ * v) (hv0 : v ≠ 0) (hdv : Fr.d v = u * v)
    (hind : AlgebraicIndependent K (Fr.jetFamily u n))
    (halg : IsAlgebraic ↥(Fr.jetPrefixField u n) (Fr.d^[n] u))
    (htr : Transcendental ↥(Fr.jetPrefixField u n) v) :
    n ≤ 1 := by
  obtain ⟨F, hF⟩ := Fr.exists_polynomial_jet_of_transcendental hu hv hv0 hind halg htr
  exact Fr.le_one_of_collapse_of_independent_eigen hb hb0 hS hu hv hv0 hdv hind
    (Fr.algebraicIndependent_cons_of_transcendental hind htr) hF

end RittFrame

