import GaloisForLFunctions.HTGeometry.DifferentialKernelCharacteristic

/-!
# The ordinary field generated by a finite jet prefix

Over an intermediate field `B` of a differential field, the jets `y, y′, …, y^(m-1)` generate an
ordinary — not differentially closed — intermediate field.  This is the field over which a
differential relation of order `m` becomes a univariate polynomial equation for the top jet.

Evaluation of a differential polynomial whose variables all have order below `m` lands in that
field, because evaluation is a multivariable `aeval` and only its values on the occurring variables
matter.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- Two evaluations of a multivariable polynomial agree as soon as the evaluation points agree on
the variables which actually occur. -/
theorem MvPolynomial.aeval_congr_of_vars {R A σ : Type*} [CommSemiring R] [CommSemiring A]
    [Algebra R A] {g₁ g₂ : σ → A} {P : MvPolynomial σ R}
    (h : ∀ i ∈ P.vars, g₁ i = g₂ i) :
    MvPolynomial.aeval g₁ P = MvPolynomial.aeval g₂ P := by
  classical
  simp only [MvPolynomial.aeval_def]
  refine MvPolynomial.eval₂_congr _ _ _ ?_
  intro i c hic hc
  exact h i ((MvPolynomial.mem_vars_iff_mem_support i).2
    ⟨c, MvPolynomial.mem_support_iff.2 hc, hic⟩)

/-- Every variable of a scalar differential polynomial has order at most its declared order. -/
theorem scalarDifferentialPolynomial_var_order_le {K : Type*} [CommSemiring K]
    {P : DifferentialPolynomial Unit K} {q : Unit × ℕ} (hq : q ∈ P.vars) :
    q.2 ≤ scalarDifferentialPolynomialOrder P :=
  Finset.le_sup (f := fun j : Unit × ℕ ↦ j.2) hq

/-- The field generated over an intermediate field by the jets of `y` of order below `m`. -/
def jetAdjoinOver (B : IntermediateField F E) (y : E) (m : ℕ) : IntermediateField B E :=
  IntermediateField.adjoin B (Set.range fun i : Fin m => differentialJet i y)

/-- The finite jet prefix field, viewed over the base field. -/
def jetAdjoin (B : IntermediateField F E) (y : E) (m : ℕ) : IntermediateField F E :=
  (jetAdjoinOver B y m).restrictScalars F

theorem mem_jetAdjoin_iff {B : IntermediateField F E} {y x : E} {m : ℕ} :
    x ∈ jetAdjoin B y m ↔ x ∈ jetAdjoinOver B y m := Iff.rfl

/-- Each jet below the cutoff lies in the prefix field. -/
theorem differentialJet_mem_jetAdjoinOver (B : IntermediateField F E) (y : E) {i m : ℕ}
    (h : i < m) : differentialJet i y ∈ jetAdjoinOver B y m :=
  IntermediateField.subset_adjoin (↥B) (Set.range fun i : Fin m => differentialJet i y)
    ⟨⟨i, h⟩, rfl⟩

theorem differentialJet_mem_jetAdjoin (B : IntermediateField F E) (y : E) {i m : ℕ}
    (h : i < m) : differentialJet i y ∈ jetAdjoin B y m :=
  differentialJet_mem_jetAdjoinOver B y h

/-- The prefix field contains the coefficient field. -/
theorem le_jetAdjoin (B : IntermediateField F E) (y : E) (m : ℕ) : B ≤ jetAdjoin B y m := by
  intro x hx
  exact (jetAdjoinOver B y m).algebraMap_mem ⟨x, hx⟩

/-- Presentation of the prefix field as an adjunction over the base field. -/
theorem jetAdjoin_eq_adjoin (B : IntermediateField F E) (y : E) (m : ℕ) :
    jetAdjoin B y m =
      IntermediateField.adjoin F ((B : Set E) ∪ Set.range fun i : Fin m => differentialJet i y) :=
  IntermediateField.restrictScalars_adjoin F B _

/-- Minimality: any intermediate field containing the coefficient field and the low jets contains
the prefix field. -/
theorem jetAdjoin_le {B L : IntermediateField F E} {y : E} {m : ℕ} (hB : B ≤ L)
    (hj : ∀ i : ℕ, i < m → differentialJet i y ∈ L) : jetAdjoin B y m ≤ L := by
  rw [jetAdjoin_eq_adjoin]
  refine IntermediateField.adjoin_le_iff.2 ?_
  rintro x (hx | ⟨i, rfl⟩)
  · exact hB hx
  · exact hj i i.2

theorem jetAdjoin_mono_left {B C : IntermediateField F E} {y : E} {m : ℕ} (h : B ≤ C) :
    jetAdjoin B y m ≤ jetAdjoin C y m :=
  jetAdjoin_le (h.trans (le_jetAdjoin C y m))
    fun _ hi => differentialJet_mem_jetAdjoin C y hi

theorem jetAdjoin_mono_right {B : IntermediateField F E} {y : E} {m n : ℕ} (h : m ≤ n) :
    jetAdjoin B y m ≤ jetAdjoin B y n :=
  jetAdjoin_le (le_jetAdjoin B y n)
    fun _ hi => differentialJet_mem_jetAdjoin B y (lt_of_lt_of_le hi h)

/-- **Evaluation of a low-order relation lands in the prefix field.**  Only the variables occurring
in the polynomial matter for its evaluation, so replacing the higher jets by zero changes nothing;
the modified evaluation is an `aeval` whose range is the algebra generated by the low jets. -/
theorem differentialPolynomialEvalOver_mem_jetAdjoin (B : IntermediateField F E) (y : E) {m : ℕ}
    {Q : DifferentialPolynomial Unit B} (hQ : ∀ q ∈ Q.vars, q.2 < m) :
    differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y) Q ∈ jetAdjoin B y m := by
  classical
  set g : Unit × ℕ → E := fun q => if q.2 < m then differentialJet q.2 y else 0 with hg
  have hcongr : differentialPolynomialEvalOver (K := B) (fun _ : Unit ↦ y) Q
      = MvPolynomial.aeval g Q := by
    refine MvPolynomial.aeval_congr_of_vars ?_
    intro q hq
    simp only [hg, if_pos (hQ q hq)]
  have hrange : Set.range g ⊆ (jetAdjoinOver B y m : Set E) := by
    rintro x ⟨q, rfl⟩
    rw [SetLike.mem_coe]
    by_cases hqm : q.2 < m
    · rw [hg]
      simp only [if_pos hqm]
      exact differentialJet_mem_jetAdjoinOver B y hqm
    · rw [hg]
      simp only [if_neg hqm]
      exact (jetAdjoinOver B y m).zero_mem
  have hle : Algebra.adjoin B (Set.range g) ≤ (jetAdjoinOver B y m).toSubalgebra :=
    Algebra.adjoin_le hrange
  have hmem : MvPolynomial.aeval g Q ∈ Algebra.adjoin B (Set.range g) := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨Q, rfl⟩
  rw [hcongr]
  exact hle hmem

end

end GaloisForLFunctions
