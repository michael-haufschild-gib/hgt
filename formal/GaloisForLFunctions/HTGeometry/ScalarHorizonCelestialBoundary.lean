import GaloisForLFunctions.HTGeometry.ProjectiveHorizonCelestialSphere
import GaloisForLFunctions.HTGeometry.HyperbolicThreeSpaceBoundary

/-!
# The scalar hypertranscendental horizon family is the celestial sphere of hyperbolic three-space

Hyperbolic three-space is the space of unimodular positive-definite Hermitian complex `2 × 2`
matrices; its visual boundary is the set of future light rays, and each light ray is the rank-one
form of a complex line.  A hypertranscendental scalar over the complex constants carries one
projective derivative horizon for each such line.

This file combines the two descriptions.  Two light rays give the same horizon exactly when they
are positive multiples of each other, that is exactly when they are the same boundary point; and
two different boundary points — the two endpoints of an oriented geodesic — have horizons that
join to the whole differential field generated by the scalar and meet exactly in the differential
field generated by its Schwarzian.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions
open scoped Differential ComplexOrder LinearAlgebra.Projectivization

noncomputable section

variable {E : Type*} [Field E] [CharZero E] [Algebra ℂ E]
  [Differential ℂ] [Differential E] [DifferentialAlgebra ℂ E]

/-- The derivative horizon attached to a future light ray of hyperbolic three-space. -/
def lightRayHorizon (x : E) {v : Fin 2 → ℂ} (hv : v ≠ 0) : IntermediateField ℂ E :=
  celestialHorizon ℂ x (Projectivization.mk ℂ v hv)

/-- **Faithfulness on the visual boundary.**  Two light forms give the same derivative horizon
exactly when they are positive multiples of each other. -/
theorem lightRayHorizon_eq_iff (hconst : ∀ t : ℂ, t′ = 0) (x : E)
    (hx : HypertranscendentalOver ℂ x) {v w : Fin 2 → ℂ} (hv : v ≠ 0) (hw : w ≠ 0) :
    lightRayHorizon x hv = lightRayHorizon x hw ↔
      ∃ t : ℝ, 0 < t ∧ lightMatrix v = (t : ℂ) • lightMatrix w := by
  rw [lightRayHorizon, lightRayHorizon, lightMatrix_smul_iff hv hw]
  exact ⟨fun h => celestialHorizon_injective hconst x hx h, fun h => by rw [h]⟩

/-- **Boundary-pair reconstruction.**  Two light rays that are not positive multiples of each
other are the two endpoints of an oriented geodesic, and their horizons join to the whole
differential field generated by the scalar and meet exactly in the differential field generated by
its Schwarzian. -/
theorem lightRayHorizon_sup_inf (hconst : ∀ t : ℂ, t′ = 0) (x : E)
    (hx : HypertranscendentalOver ℂ x) {v w : Fin 2 → ℂ} (hv : v ≠ 0) (hw : w ≠ 0)
    (hne : ¬ ∃ t : ℝ, 0 < t ∧ lightMatrix v = (t : ℂ) • lightMatrix w) :
    lightRayHorizon x hv ⊔ lightRayHorizon x hw = jetTailField ℂ x 0 ∧
      lightRayHorizon x hv ⊓ lightRayHorizon x hw = actualSchwarzianDifferentialField ℂ x := by
  refine celestialHorizon_sup_inf hconst x hx ?_
  intro hEq
  exact hne ((lightMatrix_smul_iff hv hw).mpr hEq)

/-- **The celestial-sphere realization theorem.**  For a hypertranscendental scalar over the
complex constants, the derivative horizons of its nondegenerate fractional-linear coordinates are
indexed faithfully by the visual boundary of hyperbolic three-space; the indexing is
fractional-linearly equivariant; and every ordered pair of distinct boundary points — that is,
every oriented hyperbolic geodesic — reconstructs the whole differential field generated by the
scalar while all pairs share one common projective curvature. -/
theorem scalarHorizon_celestialSphere_realization (hconst : ∀ t : ℂ, t′ = 0) (x : E)
    (hx : HypertranscendentalOver ℂ x) :
    (∀ a b c d : ℂ, a * d - b * c ≠ 0 →
        jetTailField ℂ (mobiusObservable a b c d x) 1 = rowHorizon ℂ x c d) ∧
      (∀ {v w : Fin 2 → ℂ} (hv : v ≠ 0) (hw : w ≠ 0),
        lightRayHorizon x hv = lightRayHorizon x hw ↔
          ∃ t : ℝ, 0 < t ∧ lightMatrix v = (t : ℂ) • lightMatrix w) ∧
      (∀ {v w : Fin 2 → ℂ} (hv : v ≠ 0) (hw : w ≠ 0),
        ¬ (∃ t : ℝ, 0 < t ∧ lightMatrix v = (t : ℂ) • lightMatrix w) →
          lightRayHorizon x hv ⊔ lightRayHorizon x hw = jetTailField ℂ x 0 ∧
            lightRayHorizon x hv ⊓ lightRayHorizon x hw =
              actualSchwarzianDifferentialField ℂ x) ∧
      (∀ (α β γ δ : ℂ) (hdetG : α * δ - β * γ ≠ 0) (v : Fin 2 → ℂ) (hv : v ≠ 0),
        celestialHorizon ℂ (mobiusObservable α β γ δ x) (Projectivization.mk ℂ v hv)
          = celestialHorizon ℂ x
              (Projectivization.mk ℂ ![δ * v 0 - β * v 1, α * v 1 - γ * v 0]
                (inverseVector_ne_zero hdetG hv))) :=
  ⟨fun a b c d hdet => jetTailField_mobiusObservable_one_eq_rowHorizon hconst x hx a b c d hdet,
    fun hv hw => lightRayHorizon_eq_iff hconst x hx hv hw,
    fun hv hw hne => lightRayHorizon_sup_inf hconst x hx hv hw hne,
    fun α β γ δ hdetG v hv => celestialHorizon_mobiusObservable hconst x hx α β γ δ hdetG v hv⟩

end

end GaloisForLFunctions.HTGeometry
