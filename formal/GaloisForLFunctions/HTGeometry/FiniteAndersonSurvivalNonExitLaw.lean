import GaloisForLFunctions.HTGeometry.FiniteAndersonRecurrenceLocalitySeparationLaw

/-!
# Finite Anderson site-survival non-exit

For Hermitian finite Anderson dynamics, unitarity turns off-diagonal amplitude
control into an exact local survival-probability statement.  The loss at site
`i` is the sum of the squared transition amplitudes from `i` to all other
sites.  Thus uniform amplitude suppression by `ε` gives the sharp counting
bound `(n - 1) ε²`.

Composing this identity with finite-horizon Anderson locality and projective
spectral genericity proves a separation law.  For every finite horizon and
every positive survival tolerance, positive hopping and onsite potential can
be chosen so that every site-survival record stays inside that tolerance while
the global spectrum has maximal projective rational rank.

The theorem is finite-horizon and existential in the Hamiltonian parameters.
It does not claim infinite-time Anderson dynamical localization, nor does it
give an upper bound on the first local exit time of a fixed Hamiltonian.
-/

open Set
open NormedSpace
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

attribute [local instance] Matrix.linftyOpNormedRing
attribute [local instance] Matrix.linftyOpNormedAlgebra

/-- Real onsite potential and real hopping scale preserve Hermiticity of the
finite Anderson Hamiltonian. -/
theorem scaledFiniteAndersonHamiltonian_isHermitian
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) :
    (scaledFiniteAndersonHamiltonian T g p).IsHermitian := by
  rw [scaledFiniteAndersonHamiltonian_eq]
  exact finiteAndersonHamiltonian_isHermitian ((g : ℂ) • T)
    (hT.smul (by rw [isSelfAdjoint_iff]; simp)) p

/-- Schrödinger evolution generated by a Hermitian finite Anderson
Hamiltonian is unitary. -/
theorem finiteAndersonEvolution_conjTranspose_mul_self
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) (t : ℝ) :
    (finiteAndersonEvolution T g p t).conjTranspose *
        finiteAndersonEvolution T g p t = 1 := by
  let H := scaledFiniteAndersonHamiltonian T g p
  let A := (-(Complex.I * (t : ℂ))) • H
  have hH : H.IsHermitian :=
    scaledFiniteAndersonHamiltonian_isHermitian T hT g p
  have hskew : A.conjTranspose = -A := by
    dsimp only [A]
    rw [Matrix.conjTranspose_smul, hH.eq]
    ext i j
    simp
  have hstar :
      (exp A).conjTranspose = exp (-A) := by
    rw [← Matrix.exp_conjTranspose, hskew]
  rw [finiteAndersonEvolution]
  change (exp A).conjTranspose * exp A = 1
  rw [hstar, ← Matrix.exp_add_of_commute (-A) A
    (Commute.refl A).neg_left, neg_add_cancel, exp_zero]

/-- Every column of Hermitian finite Anderson evolution has total squared
modulus one. -/
theorem finiteAndersonEvolution_column_normSq_sum_eq_one
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) (t : ℝ)
    (i : Fin n) :
    ∑ j, Complex.normSq (finiteAndersonEvolution T g p t j i) = 1 := by
  have hunit :=
    congr_fun (congr_fun
      (finiteAndersonEvolution_conjTranspose_mul_self T hT g p t) i) i
  rw [Matrix.mul_apply, Matrix.one_apply, if_pos rfl] at hunit
  have hcast :
      ((∑ j, Complex.normSq
        (finiteAndersonEvolution T g p t j i) : ℝ) : ℂ) = 1 := by
    push_cast
    simpa [Matrix.conjTranspose_apply,
      Complex.normSq_eq_conj_mul_self] using hunit
  exact_mod_cast hcast

/-- Probability that an initially occupied site is found at that same site. -/
def finiteAndersonSiteSurvivalProbability
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (g : ℝ) (p : Fin n → ℝ) (t : ℝ) (i : Fin n) : ℝ :=
  Complex.normSq (finiteAndersonEvolution T g p t i i)

/-- Loss of site-survival probability from its initial value one. -/
def finiteAndersonSiteSurvivalLoss
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (g : ℝ) (p : Fin n → ℝ) (t : ℝ) (i : Fin n) : ℝ :=
  1 - finiteAndersonSiteSurvivalProbability T g p t i

/-- Absolute site-survival deviation from the initial value one. -/
def finiteAndersonSiteSurvivalDeviation
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (g : ℝ) (p : Fin n → ℝ) (t : ℝ) (i : Fin n) : ℝ :=
  |finiteAndersonSiteSurvivalProbability T g p t i - 1|

/-- Unitarity identifies site-survival loss with total transition probability
into every other site. -/
theorem finiteAndersonSiteSurvivalLoss_eq_offDiagonal_sum
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) (t : ℝ)
    (i : Fin n) :
    finiteAndersonSiteSurvivalLoss T g p t i =
      ∑ j ∈ Finset.univ.erase i,
        Complex.normSq (finiteAndersonEvolution T g p t j i) := by
  rw [finiteAndersonSiteSurvivalLoss,
    finiteAndersonSiteSurvivalProbability,
    ← finiteAndersonEvolution_column_normSq_sum_eq_one T hT g p t i]
  have herase :=
    Finset.sum_erase_add Finset.univ
      (fun j => Complex.normSq (finiteAndersonEvolution T g p t j i))
      (Finset.mem_univ i)
  linarith

theorem finiteAndersonSiteSurvivalLoss_nonneg
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) (t : ℝ)
    (i : Fin n) :
    0 ≤ finiteAndersonSiteSurvivalLoss T g p t i := by
  rw [finiteAndersonSiteSurvivalLoss_eq_offDiagonal_sum T hT]
  exact Finset.sum_nonneg fun _j _hj => Complex.normSq_nonneg _

/-- For Hermitian dynamics, absolute survival deviation is exactly survival
loss: probability cannot exceed one. -/
theorem finiteAndersonSiteSurvivalDeviation_eq_loss
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ) (t : ℝ)
    (i : Fin n) :
    finiteAndersonSiteSurvivalDeviation T g p t i =
      finiteAndersonSiteSurvivalLoss T g p t i := by
  rw [finiteAndersonSiteSurvivalDeviation,
    abs_of_nonpos]
  · unfold finiteAndersonSiteSurvivalLoss
    ring
  · have hloss :=
      finiteAndersonSiteSurvivalLoss_nonneg T hT g p t i
    unfold finiteAndersonSiteSurvivalLoss at hloss
    linarith

/-- Uniform off-diagonal amplitude suppression bounds every site-survival
loss by the exact number `n - 1` of other sites times `ε²`. -/
theorem finiteAndersonSiteSurvivalLoss_le
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ)
    (H ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : FiniteHorizonOffDiagonalSmall T g p H ε)
    (i : Fin n) (t : ℝ) (ht : t ∈ Set.Icc (-H) H) :
    finiteAndersonSiteSurvivalLoss T g p t i ≤
      ((n - 1 : ℕ) : ℝ) * ε ^ (2 : ℕ) := by
  rw [finiteAndersonSiteSurvivalLoss_eq_offDiagonal_sum T hT]
  calc
    (∑ j ∈ Finset.univ.erase i,
        Complex.normSq (finiteAndersonEvolution T g p t j i)) ≤
        ∑ _j ∈ Finset.univ.erase i, ε ^ (2 : ℕ) := by
      apply Finset.sum_le_sum
      intro j hj
      have hji : j ≠ i := Finset.ne_of_mem_erase hj
      have hamp := hsmall j i hji t ht
      rw [Complex.normSq_eq_norm_sq]
      nlinarith [norm_nonneg (finiteAndersonEvolution T g p t j i)]
    _ = ((n - 1 : ℕ) : ℝ) * ε ^ (2 : ℕ) := by
      rw [Finset.sum_const, nsmul_eq_mul,
        Finset.card_erase_of_mem (Finset.mem_univ i),
        Finset.card_univ, Fintype.card_fin]

theorem finiteAndersonSiteSurvivalDeviation_le
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (g : ℝ) (p : Fin n → ℝ)
    (H ε : ℝ) (hε : 0 ≤ ε)
    (hsmall : FiniteHorizonOffDiagonalSmall T g p H ε)
    (i : Fin n) (t : ℝ) (ht : t ∈ Set.Icc (-H) H) :
    finiteAndersonSiteSurvivalDeviation T g p t i ≤
      ((n - 1 : ℕ) : ℝ) * ε ^ (2 : ℕ) := by
  rw [finiteAndersonSiteSurvivalDeviation_eq_loss T hT]
  exact finiteAndersonSiteSurvivalLoss_le T hT g p H ε hε hsmall i t ht

/-- **Finite Anderson site-survival separation law.** For every finite
Hermitian hopping matrix, reference onsite potential, finite observation
horizon, and positive amplitude tolerance, one can choose positive hopping
and onsite potential so that the global spectrum has maximal projective
rational rank while every site-survival record remains within
`(n - 1) ε²` of its initial value throughout the whole horizon. -/
theorem exists_finiteAnderson_maximalProjective_finiteHorizon_survivalNonExit
    {n : ℕ} (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (p₀ : Fin n → ℝ) (H : ℝ)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ g : ℝ, ∃ p : Fin n → ℝ,
      0 < g ∧
      p ∈ scaledFiniteAndersonProjectiveMaximalSet T hT g ∧
      ∀ i : Fin n, ∀ t ∈ Set.Icc (-H) H,
        finiteAndersonSiteSurvivalDeviation T g p t i ≤
          ((n - 1 : ℕ) : ℝ) * ε ^ (2 : ℕ) := by
  obtain ⟨g, p, hg, hmax, hsmall⟩ :=
    exists_finiteAnderson_maximalProjective_finiteHorizonLocalized
      T hT p₀ H hε
  refine ⟨g, p, hg, hmax, ?_⟩
  intro i t ht
  exact finiteAndersonSiteSurvivalDeviation_le
    T hT g p H ε hε.le hsmall i t ht

/-- Arbitrarily long survival non-exit at any prescribed positive probability
tolerance is compatible with maximal global projective rank. -/
theorem exists_finiteAnderson_maximalProjective_finiteHorizon_survivalTarget
    {n : ℕ} (hn : 0 < n)
    (T : Matrix (Fin n) (Fin n) ℂ)
    (hT : T.IsHermitian) (p₀ : Fin n → ℝ) (H : ℝ)
    {δ : ℝ} (hδ : 0 < δ) :
    ∃ g : ℝ, ∃ p : Fin n → ℝ,
      0 < g ∧
      p ∈ scaledFiniteAndersonProjectiveMaximalSet T hT g ∧
      ∀ i : Fin n, ∀ t ∈ Set.Icc (-H) H,
        finiteAndersonSiteSurvivalDeviation T g p t i < δ := by
  have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
  let ε := Real.sqrt (δ / (n : ℝ))
  have hε : 0 < ε := by
    exact Real.sqrt_pos.2 (div_pos hδ hnR)
  obtain ⟨g, p, hg, hmax, hbound⟩ :=
    exists_finiteAnderson_maximalProjective_finiteHorizon_survivalNonExit
      T hT p₀ H hε
  refine ⟨g, p, hg, hmax, ?_⟩
  intro i t ht
  have hi := hbound i t ht
  have hsq : ε ^ (2 : ℕ) = δ / (n : ℝ) := by
    dsimp only [ε]
    exact Real.sq_sqrt (div_nonneg hδ.le hnR.le)
  rw [hsq, Nat.cast_pred hn] at hi
  apply hi.trans_lt
  have hrewrite :
      ((n : ℝ) - 1) * (δ / (n : ℝ)) =
        (((n : ℝ) - 1) * δ) / (n : ℝ) := by ring
  rw [hrewrite]
  apply (div_lt_iff₀ hnR).2
  nlinarith

end

end GaloisForLFunctions.HTGeometry
