import GaloisForLFunctions.HTGeometry.DifferentialLurothComponentTransfer

/-!
# The saturation premises are jointly realized

Over the differential field generated by a single differentially independent element the relation
ideal is nontrivial — the coordinate minus that element is a relation — so the corpus minimality
theorem produces a minimal-rank characteristic, and the corpus clearing theorem produces a primitive
two-block characteristic for it.  Together with derivation closedness of the generated field, all
structural premises of the cross-relation saturation theorem hold simultaneously.
-/

namespace GaloisForLFunctions

variable {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
  [Algebra F E] [DifferentialAlgebra F E]

omit [Differential F] [DifferentialAlgebra F E] in
/-- The generating element lies in the field it generates. -/
theorem self_mem_differentialAdjoin (y : E) :
    y ∈ differentialAdjoin F ({y} : Set E) := by
  have h := differentialJet_mem_differentialAdjoin F (Set.mem_singleton y) 0
  simpa using h

omit [Differential F] [DifferentialAlgebra F E] in
/-- The coordinate minus the generator is a nonzero nonconstant relation. -/
theorem exists_nonzero_relation_differentialAdjoin (y : E) :
    ∃ P : DifferentialPolynomial Unit (differentialAdjoin F ({y} : Set E)),
      P ∈ (differentialIntermediateRelationIdeal (differentialAdjoin F ({y} : Set E)) y :
        Set (DifferentialPolynomial Unit (differentialAdjoin F ({y} : Set E)))) ∧
        P ≠ 0 ∧ P.vars.Nonempty := by
  classical
  set G := differentialAdjoin F ({y} : Set E)
  refine ⟨MvPolynomial.X ((), 0) - MvPolynomial.C ⟨y, self_mem_differentialAdjoin y⟩, ?_, ?_, ?_⟩
  · show differentialPolynomialEvalOver (K := G) (fun _ : Unit ↦ y) _ = 0
    rw [map_sub, differentialPolynomialEvalOver_X, differentialPolynomialEvalOver_C]
    simp
  · intro hzero
    have hcoeff := congrArg (MvPolynomial.coeff (Finsupp.single ((), 0) 1)) hzero
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_X, MvPolynomial.coeff_C,
      if_neg (Ne.symm (Finsupp.single_ne_zero.mpr one_ne_zero))] at hcoeff
    simp at hcoeff
  · refine ⟨((), 0), ?_⟩
    rw [MvPolynomial.mem_vars_iff_mem_support]
    refine ⟨Finsupp.single ((), 0) 1, ?_, by simp⟩
    rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_X,
      MvPolynomial.coeff_C, if_neg (Ne.symm (Finsupp.single_ne_zero.mpr one_ne_zero))]
    simp

/-- **Joint realization of the saturation premises.**  For a differentially independent generator the
generated field is derivation closed, carries a minimal-rank relation, and that relation carries a
primitive two-block characteristic. -/
theorem exists_lurothSaturation_premises {y : E}
    (hy : DifferentialIndependent F (fun _ : Unit ↦ y)) :
    DerivationClosed (differentialAdjoin F ({y} : Set E)) ∧
      ∃ P : DifferentialPolynomial Unit (differentialAdjoin F ({y} : Set E)),
        IsMinimalScalarDifferentialPolynomialRank
          (differentialIntermediateRelationIdeal (differentialAdjoin F ({y} : Set E)) y :
            Set (DifferentialPolynomial Unit (differentialAdjoin F ({y} : Set E)))) P ∧
          Nonempty (PrimitiveTwoBlockDifferentialCharacteristic
            (differentialAdjoin F ({y} : Set E)) le_rfl hy P) := by
  refine ⟨derivationClosed_differentialAdjoin F _, ?_⟩
  obtain ⟨P, hP⟩ :=
    exists_minimalScalarDifferentialPolynomialRank
      (exists_nonzero_relation_differentialAdjoin (F := F) y)
  exact ⟨P, hP, exists_primitiveTwoBlockDifferentialCharacteristic _ le_rfl hy hP.2.1 hP.1⟩

end GaloisForLFunctions
