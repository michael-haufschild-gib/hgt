import GaloisForLFunctions.HTGeometry.JetEulerDerivation

/-!
# The universal tower of the substitution shift

The covariant recursion `T_1 = R''(y₀)`, `T_{r+1} = ∇T_r + r·z₂·T_r` generates a sequence of
weight-zero elements independent of the level, and the whole shift tower is a binomial combination
of it:

`M·s_M = ∑_{i=1}^{M−1} i·binom(M, i)·z_i·T_{M−i}`.

This is the weight-zero Faà di Bruno formula for the substitution: the level `M` enters only through
the binomial coefficients, while the differential content sits entirely in the universal tower.
The proof is the shift recursion `s_{M+1} = ∇s_M + M·z₂·s_M + R''(y₀)·z_M` together with
`∇z_k = z_{k+1} − k·z_k·z₂`; the two `z₂` terms cancel term by term, the two resulting sums are the
two halves of Pascal's rule, and the coordinate term `R''(y₀)·z_M` fills the boundary.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C : Type*} [Field C] [CharZero C]

/-- The universal tower generated by the covariant derivative from `R''(y₀)`. -/
def shiftTower (R : RatFunc C) : ℕ → JetField C Unit
  | 0 => 0
  | 1 => JetField.pd ((), 0) (substitutionDeriv R)
  | (r + 2) => jetNabla (shiftTower R (r + 1))
      + ((r + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
        * shiftTower R (r + 1)

omit [CharZero C] in
theorem shiftTower_add_two (R : RatFunc C) (r : ℕ) :
    shiftTower R (r + 2) = jetNabla (shiftTower R (r + 1))
      + ((r + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
        * shiftTower R (r + 1) := rfl

omit [CharZero C] in
theorem jetNabla_shiftTower (R : RatFunc C) (r : ℕ) :
    jetNabla (shiftTower R (r + 1))
      = shiftTower R (r + 1 + 1)
        - ((r + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
          * shiftTower R (r + 1) := by
  rw [show r + 1 + 1 = r + 2 from rfl, shiftTower_add_two]
  ring

omit [CharZero C] in
theorem jetNabla_natCast (n : ℕ) : jetNabla ((n : ℕ) : JetField C Unit) = 0 := by
  rw [show ((n : ℕ) : JetField C Unit) = algebraMap C (JetField C Unit) ((n : ℕ) : C) from
    (map_natCast (algebraMap C (JetField C Unit)) n).symm, Derivation.map_algebraMap]

/-- The covariant derivative of one term of the tower expansion. -/
theorem jetNabla_shiftTower_term (R : RatFunc C) {M i : ℕ} (hi : i < M)
    {c : JetField C Unit} (hc : jetNabla c = 0) :
    jetNabla (c * (jetRatio (i + 1) : JetField C Unit) * shiftTower R (M - i))
        + ((M + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
          * (c * (jetRatio (i + 1) : JetField C Unit) * shiftTower R (M - i))
      = c * ((jetRatio (i + 1 + 1) : JetField C Unit) * shiftTower R (M - i))
        + c * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i)) := by
  obtain ⟨r, hr⟩ : ∃ r, M - i = r + 1 := ⟨M - i - 1, by omega⟩
  have hr2 : M + 1 - i = r + 1 + 1 := by omega
  have hcast : ((i + 1 : ℕ) : JetField C Unit) + ((r + 1 : ℕ) : JetField C Unit)
      = ((M + 1 : ℕ) : JetField C Unit) := by
    have hnat : (i + 1) + (r + 1) = M + 1 := by omega
    rw [← Nat.cast_add, hnat]
  rw [hr, hr2]
  have hz := jetNabla_jetRatio (C := C) (i + 1)
  have hT := jetNabla_shiftTower R r
  have hl1 := (jetNabla (C := C)).leibniz (c * (jetRatio (i + 1) : JetField C Unit))
    (shiftTower R (r + 1))
  have hl2 := (jetNabla (C := C)).leibniz c (jetRatio (i + 1) : JetField C Unit)
  simp only [smul_eq_mul] at hl1 hl2
  rw [hl2, hc, mul_zero, add_zero] at hl1
  rw [hl1, hz, hT]
  linear_combination (-(c * (jetRatio (i + 1) : JetField C Unit)
    * (shiftTower R (r + 1)) * (jetRatio 2 : JetField C Unit))) * hcast

omit [CharZero C] in
theorem shiftTower_binom_identity (M i : ℕ) :
    ((M + 1 + 1 : ℕ) : JetField C Unit)
        * (((i : ℕ) : JetField C Unit) * ((((M + 1).choose i : ℕ)) : JetField C Unit)
          + ((i + 1 : ℕ) : JetField C Unit) * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit))
      = ((M + 1 : ℕ) : JetField C Unit) * (((i + 1 : ℕ) : JetField C Unit)
          * ((((M + 1 + 1).choose (i + 1) : ℕ)) : JetField C Unit)) := by
  have h1 : (M + 1 + 1) * (M + 1).choose i = (M + 1 + 1).choose (i + 1) * (i + 1) :=
    Nat.add_one_mul_choose_eq (M + 1) i
  have h2 : (M + 1 + 1).choose (i + 1) = (M + 1).choose i + (M + 1).choose (i + 1) :=
    Nat.choose_succ_succ (M + 1) i
  have h1J := congrArg (fun n : ℕ => ((n : ℕ) : JetField C Unit)) h1
  have h2J := congrArg (fun n : ℕ => ((n : ℕ) : JetField C Unit)) h2
  simp only [Nat.cast_mul, Nat.cast_add, Nat.cast_one] at h1J h2J
  push_cast at h1J h2J ⊢
  linear_combination (-1 : JetField C Unit) * h1J
    - (((M : ℕ) : JetField C Unit) + 2) * (((i : ℕ) : JetField C Unit) + 1) * h2J

/-- **The tower expansion of the shift.** -/
theorem substitutionShiftRatio_eq_shiftTower_sum (R : RatFunc C) (M : ℕ) :
    ((M + 1 : ℕ) : JetField C Unit) * substitutionShiftRatio R (M + 1)
      = ∑ i ∈ Finset.range M, ((i + 1 : ℕ) : JetField C Unit)
          * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
          * (jetRatio (i + 1) : JetField C Unit) * shiftTower R (M - i) := by
  induction M with
  | zero =>
      rw [substitutionShiftRatio_one]
      simp
  | succ M ih =>
      have hMne : ((M + 1 : ℕ) : JetField C Unit) ≠ 0 := by
        rw [show ((M + 1 : ℕ) : JetField C Unit)
            = algebraMap C (JetField C Unit) ((M + 1 : ℕ) : C) from
          (map_natCast (algebraMap C (JetField C Unit)) (M + 1)).symm]
        intro hh
        have : ((M + 1 : ℕ) : C) = 0 :=
          (algebraMap C (JetField C Unit)).injective (by rw [hh, map_zero])
        exact absurd this (Nat.cast_ne_zero.mpr (by omega))
      refine mul_left_cancel₀ hMne ?_
      have hrec := substitutionShiftRatio_succ R (M + 1)
      -- the covariant step applied to the inductive expansion
      have hkey : jetNabla (((M + 1 : ℕ) : JetField C Unit) * substitutionShiftRatio R (M + 1))
            + ((M + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
              * (((M + 1 : ℕ) : JetField C Unit) * substitutionShiftRatio R (M + 1))
          = ∑ i ∈ Finset.range M,
              (((i + 1 : ℕ) : JetField C Unit)
                  * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                * ((jetRatio (i + 1 + 1) : JetField C Unit) * shiftTower R (M - i))
              + ((i + 1 : ℕ) : JetField C Unit)
                  * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i))) := by
        rw [ih, map_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i hi => ?_
        have hc : jetNabla (((i + 1 : ℕ) : JetField C Unit)
            * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)) = 0 := by
          have hl := (jetNabla (C := C)).leibniz (((i + 1 : ℕ) : JetField C Unit))
            ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
          simp only [smul_eq_mul] at hl
          rw [hl, jetNabla_natCast, jetNabla_natCast, mul_zero, mul_zero, add_zero]
        exact jetNabla_shiftTower_term R (Finset.mem_range.mp hi) hc
      have hnab : jetNabla (((M + 1 : ℕ) : JetField C Unit) * substitutionShiftRatio R (M + 1))
          = ((M + 1 : ℕ) : JetField C Unit) * jetNabla (substitutionShiftRatio R (M + 1)) := by
        have hl := (jetNabla (C := C)).leibniz (((M + 1 : ℕ) : JetField C Unit))
          (substitutionShiftRatio R (M + 1))
        simp only [smul_eq_mul] at hl
        rw [hl, jetNabla_natCast, mul_zero, add_zero]
      have hA : ∑ i ∈ Finset.range M,
            ((i + 1 : ℕ) : JetField C Unit) * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
              * ((jetRatio (i + 1 + 1) : JetField C Unit) * shiftTower R (M - i))
          = ∑ k ∈ Finset.range (M + 1),
            ((k : ℕ) : JetField C Unit) * ((((M + 1).choose k : ℕ)) : JetField C Unit)
              * ((jetRatio (k + 1) : JetField C Unit) * shiftTower R (M + 1 - k)) := by
        rw [Finset.sum_range_succ' (fun k => ((k : ℕ) : JetField C Unit)
          * ((((M + 1).choose k : ℕ)) : JetField C Unit)
          * ((jetRatio (k + 1) : JetField C Unit) * shiftTower R (M + 1 - k))) M]
        simp only [Nat.cast_zero, zero_mul, add_zero]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [show M + 1 - (i + 1) = M - i from by omega]
      have hB : ∑ i ∈ Finset.range M,
            ((i + 1 : ℕ) : JetField C Unit) * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
              * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i))
          = (∑ i ∈ Finset.range (M + 1),
              ((i + 1 : ℕ) : JetField C Unit) * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i)))
            - ((M + 1 : ℕ) : JetField C Unit) * ((jetRatio (M + 1) : JetField C Unit)
              * shiftTower R 1) := by
        rw [Finset.sum_range_succ, show M + 1 - M = 1 from by omega, Nat.choose_self]
        push_cast
        ring
      have hsplit : (∑ i ∈ Finset.range M,
            (((i + 1 : ℕ) : JetField C Unit)
                * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                * ((jetRatio (i + 1 + 1) : JetField C Unit) * shiftTower R (M - i))
              + ((i + 1 : ℕ) : JetField C Unit)
                * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i))))
          = (∑ i ∈ Finset.range M, ((i + 1 : ℕ) : JetField C Unit)
              * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
              * ((jetRatio (i + 1 + 1) : JetField C Unit) * shiftTower R (M - i)))
            + ∑ i ∈ Finset.range M, ((i + 1 : ℕ) : JetField C Unit)
              * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
              * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i)) :=
        Finset.sum_add_distrib
      have hYZ : ((M + 1 : ℕ) : JetField C Unit)
            * ((jetRatio (M + 1) : JetField C Unit) * shiftTower R 1)
          = ((M + 1 : ℕ) : JetField C Unit)
            * (JetField.pd ((), 0) (substitutionDeriv R)
              * (jetRatio (M + 1) : JetField C Unit)) := by
        rw [show shiftTower R 1 = JetField.pd ((), 0) (substitutionDeriv R) from rfl]
        ring
      have hI : ((M + 1 : ℕ) : JetField C Unit)
            * (((M + 1 + 1 : ℕ) : JetField C Unit) * substitutionShiftRatio R (M + 1 + 1))
          = ((M + 1 + 1 : ℕ) : JetField C Unit) * (∑ i ∈ Finset.range (M + 1),
              (((i : ℕ) : JetField C Unit) * ((((M + 1).choose i : ℕ)) : JetField C Unit)
                  * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i))
                + ((i + 1 : ℕ) : JetField C Unit)
                  * ((((M + 1).choose (i + 1) : ℕ)) : JetField C Unit)
                  * ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i)))) := by
        rw [Finset.sum_add_distrib]
        linear_combination ((M + 1 : ℕ) : JetField C Unit)
            * ((M + 1 + 1 : ℕ) : JetField C Unit) * hrec
          - ((M + 1 + 1 : ℕ) : JetField C Unit) * hnab
          + ((M + 1 + 1 : ℕ) : JetField C Unit) * hkey
          + ((M + 1 + 1 : ℕ) : JetField C Unit) * hsplit
          + ((M + 1 + 1 : ℕ) : JetField C Unit) * hA
          + ((M + 1 + 1 : ℕ) : JetField C Unit) * hB
          - ((M + 1 + 1 : ℕ) : JetField C Unit) * hYZ
      rw [hI, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hid := shiftTower_binom_identity (C := C) M i
      linear_combination ((jetRatio (i + 1) : JetField C Unit) * shiftTower R (M + 1 - i)) * hid

/-! ## The tower is a derivative of the shift -/

theorem jetNabla_pd_zero (v : JetField C Unit) :
    jetNabla (JetField.pd ((), 0) v) = JetField.pd ((), 0) (jetNabla v) := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hcomm : JetField.pd ((), 0) (JetField.jetDerivation v)
      = JetField.jetDerivation (JetField.pd ((), 0) v) := by
    have h := JetField.pd_deriv_zero (C := C) (ι := Unit) () v
    rw [JetField.deriv_eq, JetField.deriv_eq] at h
    exact h
  have hinv : JetField.pd ((), 0) ((JetField.jet ((), 1) : JetField C Unit)⁻¹) = 0 :=
    pd_inv_eq_zero (JetField.pd_jet_of_ne (by simp))
  have hl := (JetField.pd ((), 0) : Derivation C (JetField C Unit) (JetField C Unit)).leibniz
    (JetField.jetDerivation v) ((JetField.jet ((), 1) : JetField C Unit)⁻¹)
  simp only [smul_eq_mul] at hl
  rw [jetNabla_apply, jetNabla_apply, div_eq_mul_inv, div_eq_mul_inv, hl, hinv, mul_zero,
    zero_add, hcomm]
  ring

/-- **The universal tower is the `y₀`-derivative of the shift, corrected by the coordinate.** -/
theorem shiftTower_eq (R : RatFunc C) {r : ℕ} (hr : 1 ≤ r) :
    shiftTower R r = JetField.pd ((), 0) (substitutionShiftRatio R r)
      + JetField.pd ((), 0) (substitutionDeriv R) * (jetRatio r : JetField C Unit) := by
  have hy1 : (JetField.jet ((), 1) : JetField C Unit) ≠ 0 := jet_ne_zero _
  have hz1 : (jetRatio 1 : JetField C Unit) = 1 := by
    rw [jetRatio, pow_one, div_self hy1]
  induction r, hr using Nat.le_induction with
  | base =>
      rw [substitutionShiftRatio_one, map_zero, zero_add, hz1, mul_one]
      rfl
  | succ r hr ih =>
      obtain ⟨q, rfl⟩ : ∃ q, r = q + 1 := ⟨r - 1, by omega⟩
      have hrec := substitutionShiftRatio_succ R (q + 1)
      have hz : JetField.pd ((), 0) (jetRatio (q + 1) : JetField C Unit) = 0 :=
        pd_jetRatio_of_ne (by omega) (by omega)
      have hz2 : JetField.pd ((), 0) (jetRatio 2 : JetField C Unit) = 0 :=
        pd_jetRatio_of_ne (by omega) (by omega)
      have hnabz := jetNabla_jetRatio (C := C) (q + 1)
      have hcast : JetField.pd ((), 0) (((q + 1 : ℕ) : JetField C Unit)) = 0 := by
        rw [show (((q + 1 : ℕ) : JetField C Unit))
            = algebraMap C (JetField C Unit) (((q + 1 : ℕ) : C)) from
          (map_natCast (algebraMap C (JetField C Unit)) (q + 1)).symm,
          Derivation.map_algebraMap]
      -- differentiate the shift recursion in the base coordinate
      have hd : JetField.pd ((), 0) (substitutionShiftRatio R (q + 1 + 1))
          = jetNabla (JetField.pd ((), 0) (substitutionShiftRatio R (q + 1)))
            + ((q + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit)
              * JetField.pd ((), 0) (substitutionShiftRatio R (q + 1))
            + JetField.pd ((), 0) (JetField.pd ((), 0) (substitutionDeriv R))
              * (jetRatio (q + 1) : JetField C Unit) := by
        rw [hrec, map_add, map_add, ← jetNabla_pd_zero]
        have hl1 := (JetField.pd ((), 0) :
          Derivation C (JetField C Unit) (JetField C Unit)).leibniz
            (((q + 1 : ℕ) : JetField C Unit) * (jetRatio 2 : JetField C Unit))
            (substitutionShiftRatio R (q + 1))
        have hl2 := (JetField.pd ((), 0) :
          Derivation C (JetField C Unit) (JetField C Unit)).leibniz
            (((q + 1 : ℕ) : JetField C Unit)) (jetRatio 2 : JetField C Unit)
        have hl3 := (JetField.pd ((), 0) :
          Derivation C (JetField C Unit) (JetField C Unit)).leibniz
            (JetField.pd ((), 0) (substitutionDeriv R)) (jetRatio (q + 1) : JetField C Unit)
        simp only [smul_eq_mul] at hl1 hl2 hl3
        rw [hl2, hcast, hz2, mul_zero, mul_zero, add_zero] at hl1
        rw [hl1, hl3, hz]
        ring
      have hl4 := (jetNabla (C := C)).leibniz
        (JetField.pd ((), 0) (substitutionDeriv R)) (jetRatio (q + 1) : JetField C Unit)
      simp only [smul_eq_mul] at hl4
      have hnabr : jetNabla (JetField.pd ((), 0) (substitutionDeriv R))
          = JetField.pd ((), 0) (JetField.pd ((), 0) (substitutionDeriv R)) := by
        rw [jetNabla_apply]
        have hord := jetDerivation_of_order_zero (C := C)
          (v := JetField.pd ((), 0) (substitutionDeriv R)) (fun k hk => by
            rw [pd_comm, pd_substitutionDeriv_eq_zero R hk, map_zero])
        rw [hord]
        field_simp
      rw [shiftTower_add_two, ih, hd, map_add, hl4, hnabz, hnabr]
      ring

end

end GaloisForLFunctions.HTGeometry
