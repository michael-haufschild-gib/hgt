import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Ring

/-! # Exact relative-shear substitution at one modular gap degree -/
namespace HTGeometry
noncomputable section
set_option maxHeartbeats 2000000
set_option maxRecDepth 100000
set_option pp.deepTerms false
set_option pp.maxSteps 1000

/-- Gap-degree 16 of the full corrected raw determinant, in fixed units. -/
def evenCompactRawGapGrade16 (u w : ℝ) : ℝ :=
  (((((-21683072191761/274877906944000000000000000000000000 : ℝ) +
    ((-6424447253139/549755813888000000000000000000000000 : ℝ)*w^(2 : ℕ) +
    (-493580573973/54975581388800000000000000000000000 : ℝ)*w^(4 : ℕ) : ℝ) : ℝ) +
    ((-4545368163/13743895347200000000000000000000000 : ℝ)*w^(6 : ℕ) +
    ((97069833/4294967296000000000000000000000000 : ℝ)*w^(8 : ℕ) +
    (1058895064629/27487790694400000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(1 : ℕ) : ℝ) : ℝ) : ℝ) +
    (((10193379215769/274877906944000000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(3 : ℕ) +
    ((162515320749/17179869184000000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(5 : ℕ) +
    (1944528219/6871947673600000000000000000000000 : ℝ)*u^(1 : ℕ)*w^(7 : ℕ) : ℝ) : ℝ) +
    ((4677325664337/137438953472000000000000000000000000 : ℝ)*u^(2 : ℕ) +
    ((-2363884866261/109951162777600000000000000000000000 : ℝ)*u^(2 : ℕ)*w^(2 : ℕ) +
    (-731880632841/274877906944000000000000000000000000 : ℝ)*u^(2 : ℕ)*w^(4 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ) +
    ((((-7797617799/17179869184000000000000000000000000 : ℝ)*u^(2 : ℕ)*w^(6 : ℕ) +
    ((455549281509/68719476736000000000000000000000000 : ℝ)*u^(3 : ℕ)*w^(1 : ℕ) +
    (462659649251/137438953472000000000000000000000000 : ℝ)*u^(3 : ℕ)*w^(3 : ℕ) : ℝ) : ℝ) +
    ((-9593055871/17179869184000000000000000000000000 : ℝ)*u^(3 : ℕ)*w^(5 : ℕ) +
    ((1051045908957/549755813888000000000000000000000000 : ℝ)*u^(4 : ℕ) +
    (-5317196405551/1649267441664000000000000000000000000 : ℝ)*u^(4 : ℕ)*w^(2 : ℕ) : ℝ) : ℝ) : ℝ) +
    (((-300593513161/412316860416000000000000000000000000 : ℝ)*u^(4 : ℕ)*w^(4 : ℕ) +
    ((473523275381/247390116249600000000000000000000000 : ℝ)*u^(5 : ℕ)*w^(1 : ℕ) +
    (-73919366593/164926744166400000000000000000000000 : ℝ)*u^(5 : ℕ)*w^(3 : ℕ) : ℝ) : ℝ) +
    (((1047844361323/7421703487488000000000000000000000000 : ℝ)*u^(6 : ℕ) +
    (-1476123801521/2968681394995200000000000000000000000 : ℝ)*u^(6 : ℕ)*w^(2 : ℕ) : ℝ) +
    ((-72747223073/463856467968000000000000000000000000 : ℝ)*u^(7 : ℕ)*w^(1 : ℕ) +
    (-4038388238939/133590662774784000000000000000000000000 : ℝ)*u^(8 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Exact drift-degree 0 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade16Coeff0 (_v : ℝ) : ℝ :=
  (-21683072191761/274877906944000000000000000000000000 : ℝ)

/-- Exact drift-degree 1 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade16Coeff1 (v : ℝ) : ℝ :=
  ((33462756696789/549755813888000000000000000000000000 : ℝ) +
    ((4164503393151/1099511627776000000000000000000000000 : ℝ)*v^(1 : ℕ) +
    (-6424447253139/8796093022208000000000000000000000000 : ℝ)*v^(2 : ℕ) : ℝ) : ℝ)

/-- Exact drift-degree 2 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade16Coeff2 (v : ℝ) : ℝ :=
  (((2081742130383/137438953472000000000000000000000000 : ℝ) +
    (5355649481289/549755813888000000000000000000000000 : ℝ)*v^(1 : ℕ) : ℝ) +
    ((19726016524929/8796093022208000000000000000000000000 : ℝ)*v^(2 : ℕ) +
    ((321767736309/17592186044416000000000000000000000000 : ℝ)*v^(3 : ℕ) +
    (-493580573973/14073748835532800000000000000000000000 : ℝ)*v^(4 : ℕ) : ℝ) : ℝ) : ℝ)

/-- Exact drift-degree 3 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade16Coeff3 (v : ℝ) : ℝ :=
  (((128602245052337/14843406974976000000000000000000000000 : ℝ) +
    ((3980863805507/395824185999360000000000000000000000 : ℝ)*v^(1 : ℕ) +
    (132823893410849/26388279066624000000000000000000000000 : ℝ)*v^(2 : ℕ) : ℝ) : ℝ) +
    (((11091050410889/8796093022208000000000000000000000000 : ℝ)*v^(3 : ℕ) +
    (10905734578179/70368744177664000000000000000000000000 : ℝ)*v^(4 : ℕ) : ℝ) +
    ((256850119053/35184372088832000000000000000000000000 : ℝ)*v^(5 : ℕ) +
    (-4545368163/56294995342131200000000000000000000000 : ℝ)*v^(6 : ℕ) : ℝ) : ℝ) : ℝ)

/-- Exact drift-degree 4 coefficient after relative-shear substitution. -/
def evenCompactRelativeGapGrade16Coeff4 (v : ℝ) : ℝ :=
  ((((-34309113455183/13359066277478400000000000000000000000 : ℝ) +
    (-1807120036771/824633720832000000000000000000000000 : ℝ)*v^(1 : ℕ) : ℝ) +
    ((-178611122617387/237494511599616000000000000000000000000 : ℝ)*v^(2 : ℕ) +
    (-5654011479157/52776558133248000000000000000000000000 : ℝ)*v^(3 : ℕ) : ℝ) : ℝ) +
    (((476915912339/105553116266496000000000000000000000000 : ℝ)*v^(4 : ℕ) +
    (134905222849/35184372088832000000000000000000000000 : ℝ)*v^(5 : ℕ) : ℝ) +
    ((74206894659/140737488355328000000000000000000000000 : ℝ)*v^(6 : ℕ) +
    ((15935110407/562949953421312000000000000000000000000 : ℝ)*v^(7 : ℕ) +
    (97069833/281474976710656000000000000000000000000 : ℝ)*v^(8 : ℕ) : ℝ) : ℝ) : ℝ) : ℝ)

/-- The relative-shear polynomial retains drift grading. -/
def evenCompactRelativeGapGrade16 (r v : ℝ) : ℝ :=
  ((evenCompactRelativeGapGrade16Coeff0 v +
    (r^(1 : ℕ)*evenCompactRelativeGapGrade16Coeff1 v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactRelativeGapGrade16Coeff2 v) +
    ((r^(3 : ℕ)*evenCompactRelativeGapGrade16Coeff3 v) +
    (r^(4 : ℕ)*evenCompactRelativeGapGrade16Coeff4 v) : ℝ) : ℝ) : ℝ)

/-- Exact symbolic relative-shear identity at this entire gap degree. -/
theorem evenCompactRawGapGrade16_relative_eq (u v : ℝ) :
    evenCompactRawGapGrade16 u (u*(1+v/4)) = evenCompactRelativeGapGrade16 (u^(2 : ℕ)) v := by
  unfold evenCompactRawGapGrade16 evenCompactRelativeGapGrade16 evenCompactRelativeGapGrade16Coeff0 evenCompactRelativeGapGrade16Coeff1 evenCompactRelativeGapGrade16Coeff2 evenCompactRelativeGapGrade16Coeff3 evenCompactRelativeGapGrade16Coeff4
  ring1

end
end HTGeometry
