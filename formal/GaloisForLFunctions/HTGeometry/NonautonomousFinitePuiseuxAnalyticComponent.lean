import GaloisForLFunctions.HTGeometry.FirstOrderAnalyticDerivativeComponent
import GaloisForLFunctions.HTGeometry.NonautonomousFinitePuiseuxVelocityFactorization
import GaloisForLFunctions.HTGeometry.EntireCompositionDecomposition

/-!
# Analytic irreducible components inside the finite cascade branch field

Every actual cascade state remains algebraically independent after corestriction to the finite
field generated by the actual derivative branches.  For each constituent, the quotient of two
successive state derivatives is exactly the composed analytic derivative.  Consequently this
actual velocity is a root of the irreducible Wiman derivative polynomial over the embedded
adjacent-state rational field.  All layer components therefore live in one actual finite field;
no tensor-product component or independent root choice is used.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher
open scoped Differential

noncomputable section

attribute [local instance] cascadeUnitCostDomain cascadeUnitCostRatFuncAlgebra
  cascadeUnitCostComplexAlgebra cascadeUnitCostScalarTower cascadeUnitCostDifferential
  cascadeUnitCostCharZero

/-- Corestricting the actual state family to the finite branch field preserves algebraic
independence. -/
theorem algebraicIndependent_nonautonomousFiniteCascadeStateInBranchField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    AlgebraicIndependent ℂ
      (nonautonomousFiniteCascadeStateInBranchField hfan N) := by
  let E := NonautonomousRamifiedCascadeStateField hfan N
  let B := NonautonomousFiniteCascadeBranchField hfan N
  have hEB : E ≤ B := by
    intro x hx
    change x ∈ NonautonomousFiniteCascadeBranchFieldOverState hfan N
    exact IntermediateField.algebraMap_mem
      (NonautonomousFiniteCascadeBranchFieldOverState hfan N) ⟨x, hx⟩
  let ι : E →ₐ[ℂ] B := IntermediateField.inclusion hEB
  have hE := algebraicIndependent_nonautonomousCascadeStateFamilyInStateField hfan hall N
  have hmap := hE.map (ι.injective.injOn)
  change AlgebraicIndependent ℂ (fun i ↦
    nonautonomousFiniteCascadeStateInBranchField hfan N i)
  convert hmap using 1
  funext i
  apply Subtype.ext
  rfl

/-- Clock, value, and constituent derivative after substitution by the `k`-th cascade state. -/
noncomputable def cascadeConstituentJetFunctions
    (f : ℕ → ℂ → ℂ) (k : ℕ) : Fin 3 → ℂ → ℂ :=
  fun i z ↦ firstOrderEntireJetFunctions (f k) i (entireCascade f k z)

theorem cascadeConstituentJetFunctions_analytic
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (k : ℕ) : ∀ i : Fin 3,
    AnalyticOnNhd ℂ (cascadeConstituentJetFunctions f k i) Set.univ := by
  have hfd : Differentiable ℂ (f k) :=
    Complex.analyticOnNhd_univ_iff_differentiable.mp (hfan k)
  have hFd : Differentiable ℂ (entireCascade f k) :=
    Complex.analyticOnNhd_univ_iff_differentiable.mp
      (analyticOnNhd_entireCascade hfan k)
  intro i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · change AnalyticOnNhd ℂ (entireCascade f k) Set.univ
    exact analyticOnNhd_entireCascade hfan k
  · fin_cases j
    · change AnalyticOnNhd ℂ
        (fun z ↦ iteratedDeriv 0 (f k) (entireCascade f k z)) Set.univ
      exact analyticOnNhd_iteratedDeriv_comp hfd hFd 0
    · change AnalyticOnNhd ℂ
        (fun z ↦ iteratedDeriv 1 (f k) (entireCascade f k z)) Set.univ
      exact analyticOnNhd_iteratedDeriv_comp hfd hFd 1

/-- The pointwise constituent relation survives substitution by the inner cascade state. -/
theorem cascadeConstituentJet_relation
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (k : ℕ) (data : EntireFirstOrderWimanInitialData (f k)) :
    MvPolynomial.eval₂ (constToMero Set.univ)
      (fun i ↦ analyticMeroElement (cascadeConstituentJetFunctions f k i)
        (cascadeConstituentJetFunctions_analytic hfan k i)) data.P = 0 := by
  have htransfer := analyticMeroElement_eval_mvPolynomial
    (cascadeConstituentJetFunctions f k)
    (cascadeConstituentJetFunctions_analytic hfan k) data.P
  have hfun :
      (fun z ↦ MvPolynomial.eval
        (fun i ↦ cascadeConstituentJetFunctions f k i z) data.P) =
        (fun _ ↦ (0 : ℂ)) := by
    funext z
    have hvec : (fun i ↦ cascadeConstituentJetFunctions f k i z) =
        Fin.cons (entireCascade f k z)
          (fun j : Fin 2 ↦ iteratedDeriv (j : ℕ) (f k) (entireCascade f k z)) := by
      funext i
      refine Fin.cases ?_ (fun j ↦ ?_) i <;> rfl
    rw [hvec, data.relation (entireCascade f k z)]
  have hleft :
      analyticMeroElement
          (fun z ↦ MvPolynomial.eval
            (fun i ↦ cascadeConstituentJetFunctions f k i z) data.P)
          (analyticOnNhd_eval_mvPolynomial
            (cascadeConstituentJetFunctions f k)
            (cascadeConstituentJetFunctions_analytic hfan k) data.P) = 0 := by
    rw [analyticMeroElement_congr _ analyticOnNhd_const hfun,
      analyticMeroElement_zero]
  rw [hleft] at htransfer
  exact htransfer.symm

@[simp] theorem analyticMeroElement_cascadeConstituentJetFunctions_zero
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (k : ℕ) :
    analyticMeroElement (cascadeConstituentJetFunctions f k 0)
        (cascadeConstituentJetFunctions_analytic hfan k 0) =
      cascadeMero hfan k := by
  rfl

@[simp] theorem analyticMeroElement_cascadeConstituentJetFunctions_one
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (k : ℕ) :
    analyticMeroElement (cascadeConstituentJetFunctions f k 1)
        (cascadeConstituentJetFunctions_analytic hfan k 1) =
      cascadeMero hfan (k + 1) := by
  rfl

/-- The composed constituent derivative is exactly the quotient of successive state
derivatives. -/
theorem analyticMeroElement_cascadeConstituentJetFunctions_two
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (k : ℕ) :
    analyticMeroElement (cascadeConstituentJetFunctions f k 2)
        (cascadeConstituentJetFunctions_analytic hfan k 2) =
      cascadeMeroDeriv hfan (k + 1) / cascadeMeroDeriv hfan k := by
  have hfd : Differentiable ℂ (f k) :=
    Complex.analyticOnNhd_univ_iff_differentiable.mp (hfan k)
  have hFd : Differentiable ℂ (entireCascade f k) :=
    Complex.analyticOnNhd_univ_iff_differentiable.mp
      (analyticOnNhd_entireCascade hfan k)
  have hnonzero : analyticMeroElement (deriv (entireCascade f k))
      (Complex.analyticOnNhd_univ_iff_differentiable.mpr hFd).deriv ≠ 0 := by
    simpa [cascadeMeroDeriv] using
      cascadeMeroDeriv_ne_zero_of_transcendental hfan hall k
  have hcomp := compJet_analyticMeroElement hfd hFd hnonzero 1
  rw [compJet_succ, compJet_zero] at hcomp
  change (cascadeMero hfan (k + 1))′ / (cascadeMero hfan k)′ =
    analyticMeroElement (cascadeConstituentJetFunctions f k 2)
      (cascadeConstituentJetFunctions_analytic hfan k 2) at hcomp
  have hk : (cascadeMero hfan k)′ = cascadeMeroDeriv hfan k := by
    rw [← differentialJet_zero (cascadeMero hfan k),
      ← differentialJet_succ, differentialJet_one_cascadeMero]
  have hks : (cascadeMero hfan (k + 1))′ = cascadeMeroDeriv hfan (k + 1) := by
    rw [← differentialJet_zero (cascadeMero hfan (k + 1)),
      ← differentialJet_succ, differentialJet_one_cascadeMero]
  rw [hk, hks] at hcomp
  exact hcomp.symm

/-- Multivariate evaluation is natural under any algebra homomorphism. -/
theorem map_mvPolynomial_aeval
    {K A B σ : Type*} [CommRing K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra K B] (f : A →ₐ[K] B) (g : σ → A)
    (P : MvPolynomial σ K) :
    f (MvPolynomial.aeval g P) = MvPolynomial.aeval (fun i ↦ f (g i)) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp
  | add P Q hP hQ => simpa using congrArg₂ (fun x y ↦ x + y) hP hQ
  | mul_X P i hP => simp [hP]

/-- Adjacent states and their actual constituent velocity, in direct cascade order. -/
noncomputable def nonautonomousFiniteCascadeLocalJet
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    {N : ℕ} (k : Fin N) :
    Fin 3 → NonautonomousFiniteCascadeBranchField hfan N :=
  Fin.cases
    (nonautonomousFiniteCascadeStateInBranchField hfan N k.castSucc)
    (fun i : Fin 2 ↦ Fin.cases
      (nonautonomousFiniteCascadeStateInBranchField hfan N k.succ)
      (fun _ : Fin 1 ↦ nonautonomousFiniteCascadeVelocityInBranchField hfan k.rev) i)

/-- The finite-field local jet is the corestriction of the composed analytic local jet. -/
theorem nonautonomousFiniteCascadeLocalJet_coe
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N)
    (i : Fin 3) :
    ((nonautonomousFiniteCascadeLocalJet hfan k i :
      NonautonomousFiniteCascadeBranchField hfan N) : meroField Set.univ) =
      analyticMeroElement (cascadeConstituentJetFunctions f k i)
        (cascadeConstituentJetFunctions_analytic hfan k i) := by
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · change cascadeMero hfan k = _
    exact (analyticMeroElement_cascadeConstituentJetFunctions_zero hfan k).symm
  · refine Fin.cases ?_ (fun l ↦ ?_) j
    · change cascadeMero hfan (k + 1) = _
      exact (analyticMeroElement_cascadeConstituentJetFunctions_one hfan k).symm
    · have hl : l = 0 := Subsingleton.elim _ _
      subst l
      change
        ((nonautonomousFiniteCascadeVelocityInBranchField hfan k.rev :
          NonautonomousFiniteCascadeBranchField hfan N) : meroField Set.univ) = _
      rw [nonautonomousFiniteCascadeVelocityInBranchField_coe]
      simpa using
        (analyticMeroElement_cascadeConstituentJetFunctions_two hfan hall k).symm

/-- The two state coordinates selected by one local derivative component. -/
noncomputable def firstOrderCascadeStateIndex {N : ℕ} (k : Fin N) :
    {j : Fin 3 // j ≠ (2 : Fin 3)} → Fin (N + 1) :=
  fun j ↦ ⟨k.val + j.1.val, by
    have hj : j.1.val < 2 := by
      have := j.1.isLt
      by_contra h
      have heq : j.1 = (2 : Fin 3) := Fin.ext (by omega)
      exact j.2 heq
    omega⟩

theorem firstOrderCascadeStateIndex_injective {N : ℕ} (k : Fin N) :
    Function.Injective (firstOrderCascadeStateIndex k) := by
  intro i j hij
  apply Subtype.ext
  apply Fin.ext
  have hval := congrArg (fun q : Fin (N + 1) ↦ q.val) hij
  change k.val + i.1.val = k.val + j.1.val at hval
  omega

/-- Every adjacent clock/value pair is algebraically independent inside the common finite branch
field. -/
theorem algebraicIndependent_nonautonomousFiniteCascadeLocalState
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N) :
    AlgebraicIndependent ℂ
      (fun j : {j : Fin 3 // j ≠ (2 : Fin 3)} ↦
        nonautonomousFiniteCascadeLocalJet hfan k j.1) := by
  have hfull :=
    algebraicIndependent_nonautonomousFiniteCascadeStateInBranchField hfan hall N
  have hsub := hfull.comp (firstOrderCascadeStateIndex k)
    (firstOrderCascadeStateIndex_injective k)
  convert hsub using 1
  funext j
  rcases j with ⟨j, hj⟩
  fin_cases j
  · rfl
  · rfl
  · exact (hj rfl).elim

/-- Adjacent-state evaluation in the common finite branch field is faithful. -/
theorem nonautonomousFiniteCascadeLocalStatePolynomialEval_injective
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N) :
    Function.Injective
      (firstOrderStatePolynomialEval
        (nonautonomousFiniteCascadeLocalJet hfan k)) :=
  firstOrderStatePolynomialEval_injective_of_algebraicIndependent _
    (algebraicIndependent_nonautonomousFiniteCascadeLocalState hfan hall k)

/-- Every exact constituent relation annihilates its actual local jet in the common finite branch
field. -/
theorem nonautonomousFiniteCascadeLocalJet_relation
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N)
    (data : EntireFirstOrderWimanInitialData (f k)) :
    MvPolynomial.aeval (nonautonomousFiniteCascadeLocalJet hfan k) data.P = 0 := by
  let B := NonautonomousFiniteCascadeBranchField hfan N
  let M := meroField (Set.univ : Set ℂ)
  let incl : B →ₐ[ℂ] M := IsScalarTower.toAlgHom ℂ B M
  apply incl.injective
  change incl (MvPolynomial.aeval
    (nonautonomousFiniteCascadeLocalJet hfan k) data.P) = incl 0
  rw [map_mvPolynomial_aeval, map_zero]
  have hfamily : (fun i ↦ incl (nonautonomousFiniteCascadeLocalJet hfan k i)) =
      (fun i ↦ analyticMeroElement (cascadeConstituentJetFunctions f k i)
        (cascadeConstituentJetFunctions_analytic hfan k i)) := by
    funext i
    exact nonautonomousFiniteCascadeLocalJet_coe hfan hall k i
  rw [hfamily]
  rw [MvPolynomial.aeval_def]
  have hconst : algebraMap ℂ M = constToMero Set.univ := by
    apply RingHom.ext
    intro c
    change ratfuncToMero Set.univ isOpen_univ isPreconnected_univ
        Set.univ_nonempty Set.infinite_univ (algebraMap ℂ (RatFunc ℂ) c) =
      constToMero Set.univ c
    exact ratfuncToMero_C_eq_constToMero c
  rw [hconst]
  exact cascadeConstituentJet_relation hfan k data

/-- Canonical embedding of one adjacent-state rational field into the common finite branch
field. -/
noncomputable def nonautonomousFiniteCascadeLocalRationalStateEval
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N) :
    FirstOrderRationalStateField →ₐ[ℂ]
      NonautonomousFiniteCascadeBranchField hfan N :=
  firstOrderRationalStateEval (nonautonomousFiniteCascadeLocalJet hfan k)
    (nonautonomousFiniteCascadeLocalStatePolynomialEval_injective hfan hall k)

/-- **Actual layer component in the common cascade field.**  Every actual constituent velocity is
a root of its irreducible Wiman derivative polynomial after the adjacent-state embedding. -/
theorem nonautonomousFiniteCascadeVelocity_component_root
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N)
    (data : EntireFirstOrderWimanInitialData (f k)) :
    ((firstOrderDerivativePolynomial data.P).map
      (nonautonomousFiniteCascadeLocalRationalStateEval hfan hall k).toRingHom).IsRoot
        (nonautonomousFiniteCascadeLocalJet hfan k 2) := by
  change Polynomial.eval (nonautonomousFiniteCascadeLocalJet hfan k 2)
      ((firstOrderDerivativePolynomial data.P).map
        (nonautonomousFiniteCascadeLocalRationalStateEval hfan hall k).toRingHom) = 0
  rw [Polynomial.eval_map]
  exact (firstOrderDerivativePolynomial_eval
    (nonautonomousFiniteCascadeLocalJet hfan k)
    (nonautonomousFiniteCascadeLocalStatePolynomialEval_injective hfan hall k)
    data.P).trans
      (nonautonomousFiniteCascadeLocalJet_relation hfan hall k data)

end

