import Mathlib
import GaloisForLFunctions.HTGeometry.AbelianZetaGas.Core

/-!
# The law commutator of the abelian zeta gas

Temperature translation `H_u(σ,τ) = (σ+u, τ)` and the canonical socle tilt `S(σ,τ) = (σ, τ+σ)`
are the marked source operations of the gas.  Their group commutator is the pure socle-fugacity
translation `V_u(σ,τ) = (σ, τ+u)`, which is therefore *generated*, not primitive: a temperature
displacement is transduced by schedule exchange into a socle intervention of the same magnitude.

Nonidentity of the commutator is invariant under any bijective change of parameter chart, because
conjugation is a group automorphism; it is destroyed only by forgetting which operations are
marked.
-/

namespace GaloisForLFunctions.HTGeometry.AbelianZetaGas

open scoped commutatorElement

/-- Temperature translation of the parameter chamber. -/
def tempTranslate (u : ℝ) : (ℝ × ℝ) ≃ (ℝ × ℝ) where
  toFun θ := (θ.1 + u, θ.2)
  invFun θ := (θ.1 - u, θ.2)
  left_inv θ := by simp
  right_inv θ := by simp

/-- The canonical socle tilt of the parameter chamber. -/
def socleTilt : (ℝ × ℝ) ≃ (ℝ × ℝ) where
  toFun θ := (θ.1, θ.2 + θ.1)
  invFun θ := (θ.1, θ.2 - θ.1)
  left_inv θ := by simp
  right_inv θ := by simp

/-- Pure socle-fugacity translation of the parameter chamber. -/
def fugacityTranslate (u : ℝ) : (ℝ × ℝ) ≃ (ℝ × ℝ) where
  toFun θ := (θ.1, θ.2 + u)
  invFun θ := (θ.1, θ.2 - u)
  left_inv θ := by simp
  right_inv θ := by simp

@[simp] theorem tempTranslate_apply (u : ℝ) (θ : ℝ × ℝ) :
    tempTranslate u θ = (θ.1 + u, θ.2) := rfl

@[simp] theorem socleTilt_apply (θ : ℝ × ℝ) : socleTilt θ = (θ.1, θ.2 + θ.1) := rfl

@[simp] theorem fugacityTranslate_apply (u : ℝ) (θ : ℝ × ℝ) :
    fugacityTranslate u θ = (θ.1, θ.2 + u) := rfl

@[simp] theorem tempTranslate_symm_apply (u : ℝ) (θ : ℝ × ℝ) :
    (tempTranslate u).symm θ = (θ.1 - u, θ.2) := rfl

@[simp] theorem socleTilt_symm_apply (θ : ℝ × ℝ) : socleTilt.symm θ = (θ.1, θ.2 - θ.1) := rfl

/-! ## The parameter chamber -/

/-- The absolute-convergence chamber of the gas. -/
def chamber : Set (ℝ × ℝ) := {θ | 0 < θ.1 ∧ 1 < θ.1 + θ.2}

theorem socleTilt_mapsTo_chamber : Set.MapsTo socleTilt chamber chamber := by
  rintro ⟨σ, τ⟩ ⟨h1, h2⟩
  exact ⟨h1, by simp only [socleTilt_apply]; linarith⟩

theorem fugacityTranslate_mapsTo_chamber {u : ℝ} (hu : 0 ≤ u) :
    Set.MapsTo (fugacityTranslate u) chamber chamber := by
  rintro ⟨σ, τ⟩ ⟨h1, h2⟩
  exact ⟨h1, by simp only [fugacityTranslate_apply]; linarith⟩

theorem tempTranslate_mapsTo_chamber {u : ℝ} (hu : 0 ≤ u) :
    Set.MapsTo (tempTranslate u) chamber chamber := by
  rintro ⟨σ, τ⟩ ⟨h1, h2⟩
  exact ⟨by simp only [tempTranslate_apply]; linarith,
    by simp only [tempTranslate_apply]; linarith⟩

/-! ## Exact exchange and central birth -/

/-- **(AZC.7).**  The socle tilt and a temperature translation exchange up to exactly one
fugacity translation of the same magnitude. -/
theorem socleTilt_comp_tempTranslate (u : ℝ) :
    socleTilt * tempTranslate u = fugacityTranslate u * (tempTranslate u * socleTilt) := by
  ext θ
  · simp [Equiv.Perm.mul_apply]
  · simp [Equiv.Perm.mul_apply]
    ring

/-- **(AZC.8).**  Fugacity translations form a one-parameter group. -/
theorem fugacityTranslate_mul (u v : ℝ) :
    fugacityTranslate u * fugacityTranslate v = fugacityTranslate (u + v) := by
  ext θ
  · simp [Equiv.Perm.mul_apply]
  · simp [Equiv.Perm.mul_apply]
    ring

@[simp] theorem fugacityTranslate_zero : fugacityTranslate 0 = 1 := by
  ext θ <;> simp

/-- Fugacity translations commute with temperature translations. -/
theorem fugacityTranslate_commute_tempTranslate (u v : ℝ) :
    Commute (fugacityTranslate u) (tempTranslate v) := by
  unfold Commute SemiconjBy
  ext θ <;> simp [Equiv.Perm.mul_apply]

/-- Fugacity translations commute with each other. -/
theorem fugacityTranslate_commute (u v : ℝ) :
    Commute (fugacityTranslate u) (fugacityTranslate v) := by
  unfold Commute SemiconjBy
  rw [fugacityTranslate_mul, fugacityTranslate_mul, add_comm]

/-- Fugacity translations commute with the socle tilt. -/
theorem fugacityTranslate_commute_socleTilt (u : ℝ) :
    Commute (fugacityTranslate u) socleTilt := by
  unfold Commute SemiconjBy
  ext θ
  · simp [Equiv.Perm.mul_apply]
  · simp [Equiv.Perm.mul_apply]
    ring

/-- **(AZC.9), central birth.**  The group commutator of the socle tilt with a temperature
translation is exactly the fugacity translation of the same magnitude.  The third formation is
generated by the two marked ones. -/
theorem commutator_socleTilt_tempTranslate (u : ℝ) :
    ⁅socleTilt, tempTranslate u⁆ = fugacityTranslate u := by
  ext θ
  · simp [commutatorElement_def, Equiv.Perm.mul_apply, Equiv.Perm.inv_def]
  · simp [commutatorElement_def, Equiv.Perm.mul_apply, Equiv.Perm.inv_def]
    ring

/-- The commutator is nonidentity for every nonzero displacement. -/
theorem commutator_ne_one {u : ℝ} (hu : u ≠ 0) :
    ⁅socleTilt, tempTranslate u⁆ ≠ 1 := by
  rw [commutator_socleTilt_tempTranslate]
  intro h
  have h0 := congrArg (fun e : (ℝ × ℝ) ≃ (ℝ × ℝ) => (e (0, 0)).2) h
  simp at h0
  exact hu h0

/-- **(AZC.10), coordinate invariance.**  Any bijective change of parameter chart conjugates the
whole exchange: the commutator of the transported marked operations is the transported fugacity
translation.  Nonidentity therefore survives every reparameterization that keeps the marking. -/
theorem commutator_conjugate (Φ : (ℝ × ℝ) ≃ (ℝ × ℝ)) (u : ℝ) :
    ⁅Φ * socleTilt * Φ⁻¹, Φ * tempTranslate u * Φ⁻¹⁆ =
      Φ * fugacityTranslate u * Φ⁻¹ := by
  have h := map_commutatorElement (MulAut.conj Φ) socleTilt (tempTranslate u)
  simp only [MulAut.conj_apply] at h
  rw [← h, commutator_socleTilt_tempTranslate]

end GaloisForLFunctions.HTGeometry.AbelianZetaGas
