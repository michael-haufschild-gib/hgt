import Mathlib

/-!
# Critical clock universality of a nonnegative Mellin source

A *critical clock source* is a nonnegative measure `dN` on `[1,∞)` whose Mellin transform
`Z(σ)=∫x^{-σ}dN(x)` has a simple pole at `σ=1`, i.e. `(σ-1)Z(σ) → K ≠ 0`.  Under the Gibbs
probability `p_σ(dx)=Z(σ)^{-1}x^{-σ}dN(x)` the *clock* `Y_σ=(σ-1)·log x` has Laplace transform
exactly `Z(σ+u(σ-1))/Z(σ)`.

`tendsto_criticalClockLaplace_of_simplePole` shows that this Laplace transform converges to
`1/(1+u)` — the unit-rate exponential transform — using nothing but the simple pole.  No Tauberian
input, no arithmetic, and no property of the measure beyond the pole is used.

The remaining results record the three truncated `Exp(1)` moments generated by the pointed Fisher
score `y ↦ 2(1-y)`, and show that the rank-two cutoff Ward Gram of those three moments is exactly
the closed critical Ward profile `4[(2+u²)e^{-u} - 2(1+2u²)e^{-2u}]`.

Consequently every critical invariant of a Möbius-type source package — cut mass, cut overlap, cut
energy, Ward profile, one-corner profile and its total — is a functional of the `Exp(1)` law alone,
hence a *class invariant* of all nonnegative Mellin sources with a simple pole at `σ=1`.

This is a source-independent statement and therefore lives in `HTGeometry`.
-/

open Filter Set intervalIntegral
open scoped Topology

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-! ## The critical clock Laplace transform -/

/-- Critical clock rescaling `σ ↦ σ + u(σ-1) = 1 + (1+u)(σ-1)`.  The ratio of the Mellin transform
at this point to its value at `σ` is the Laplace transform of the clock `(σ-1)·log x` at `u`. -/
def criticalClockShift (u σ : ℝ) : ℝ := σ + u * (σ - 1)

@[simp] theorem criticalClockShift_sub_one (u σ : ℝ) :
    criticalClockShift u σ - 1 = (1 + u) * (σ - 1) := by
  unfold criticalClockShift; ring

@[simp] theorem criticalClockShift_one (u : ℝ) : criticalClockShift u 1 = 1 := by
  unfold criticalClockShift; ring

/-- Clock Laplace transform of a Mellin source. -/
def criticalClockLaplace (Z : ℝ → ℝ) (u σ : ℝ) : ℝ :=
  Z (criticalClockShift u σ) / Z σ

theorem tendsto_criticalClockShift {u : ℝ} (hu : 0 ≤ u) :
    Tendsto (criticalClockShift u) (𝓝[>] 1) (𝓝[>] 1) := by
  have hcont : Continuous (criticalClockShift u) := by
    unfold criticalClockShift; fun_prop
  apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
  · have h := (hcont.continuousAt (x := (1 : ℝ))).tendsto
    rw [criticalClockShift_one] at h
    exact h.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with σ hσ
    have hσ1 : 0 < σ - 1 := sub_pos.mpr hσ
    have hpos : 0 < (1 + u) * (σ - 1) := mul_pos (by linarith) hσ1
    rw [← criticalClockShift_sub_one u σ] at hpos
    simp only [mem_Ioi]
    linarith

/-- **Critical clock universality.**  If the Mellin transform of a nonnegative source has a simple
pole at `σ = 1`, then its clock Laplace transform converges to the unit-rate exponential transform
`1/(1+u)`.  Only the pole is used: no Tauberian theorem, no arithmetic, and no further property of
the underlying measure. -/
theorem tendsto_criticalClockLaplace_of_simplePole
    {Z : ℝ → ℝ} {K : ℝ} (hK : K ≠ 0)
    (hZ : Tendsto (fun σ : ℝ => (σ - 1) * Z σ) (𝓝[>] 1) (𝓝 K))
    {u : ℝ} (hu : 0 ≤ u) :
    Tendsto (criticalClockLaplace Z u) (𝓝[>] 1) (𝓝 (1 / (1 + u))) := by
  have hu1 : (0 : ℝ) < 1 + u := by linarith
  have hne : (1 + u) * K ≠ 0 := mul_ne_zero (ne_of_gt hu1) hK
  have hcomp :
      Tendsto (fun σ : ℝ => (criticalClockShift u σ - 1) * Z (criticalClockShift u σ))
        (𝓝[>] 1) (𝓝 K) :=
    hZ.comp (tendsto_criticalClockShift hu)
  have hden : Tendsto (fun σ : ℝ => (1 + u) * ((σ - 1) * Z σ)) (𝓝[>] 1) (𝓝 ((1 + u) * K)) :=
    hZ.const_mul (1 + u)
  have hratio :
      Tendsto
        (fun σ : ℝ =>
          ((criticalClockShift u σ - 1) * Z (criticalClockShift u σ)) /
            ((1 + u) * ((σ - 1) * Z σ)))
        (𝓝[>] 1) (𝓝 (K / ((1 + u) * K))) := hcomp.div hden hne
  have hlim : K / ((1 + u) * K) = 1 / (1 + u) := by
    field_simp
  rw [hlim] at hratio
  apply hratio.congr'
  filter_upwards [self_mem_nhdsWithin] with σ hσ
  have hσ1 : σ - 1 ≠ 0 := ne_of_gt (sub_pos.mpr hσ)
  have hc : (1 + u) * (σ - 1) ≠ 0 := mul_ne_zero (ne_of_gt hu1) hσ1
  rw [criticalClockShift_sub_one]
  rw [criticalClockLaplace]
  rw [show (1 + u) * ((σ - 1) * Z σ) = ((1 + u) * (σ - 1)) * Z σ by ring]
  rw [mul_div_mul_left _ _ hc]

/-! ## The three truncated `Exp(1)` moments of the pointed Fisher score -/

/-- Truncated mass of the unit-rate exponential clock. -/
theorem integral_expNeg_cut (u : ℝ) :
    (∫ y in (0 : ℝ)..u, Real.exp (-y)) = 1 - Real.exp (-u) := by
  have hderiv : ∀ y ∈ uIcc (0 : ℝ) u,
      HasDerivAt (fun y : ℝ => -Real.exp (-y)) (Real.exp (-y)) y := by
    intro y _
    have h : HasDerivAt (fun y : ℝ => Real.exp (-y)) (Real.exp (-y) * (-1)) y :=
      (hasDerivAt_neg y).exp
    simpa using! h.neg
  have hint : IntervalIntegrable (fun y : ℝ => Real.exp (-y)) MeasureTheory.volume 0 u := by
    apply Continuous.intervalIntegrable
    fun_prop
  rw [integral_eq_sub_of_hasDerivAt hderiv hint]
  simp
  ring

/-- Truncated first score moment: `∫₀ᵘ (1-y)e^{-y} dy = u e^{-u}`. -/
theorem integral_score_cut (u : ℝ) :
    (∫ y in (0 : ℝ)..u, (1 - y) * Real.exp (-y)) = u * Real.exp (-u) := by
  have hderiv : ∀ y ∈ uIcc (0 : ℝ) u,
      HasDerivAt (fun y : ℝ => y * Real.exp (-y)) ((1 - y) * Real.exp (-y)) y := by
    intro y _
    have hexp : HasDerivAt (fun y : ℝ => Real.exp (-y)) (Real.exp (-y) * (-1)) y :=
      (hasDerivAt_neg y).exp
    have h := (hasDerivAt_id y).mul hexp
    convert h using 1
    · rfl
    · exact Module.ext' _ _ fun _ _ => rfl
    · funext x
      simp only [Pi.mul_apply, id_eq]
    · simp only [id_eq]
      ring
  have hint : IntervalIntegrable (fun y : ℝ => (1 - y) * Real.exp (-y))
      MeasureTheory.volume 0 u := by
    apply Continuous.intervalIntegrable
    fun_prop
  rw [integral_eq_sub_of_hasDerivAt hderiv hint]
  simp

/-- Truncated second score moment: `∫₀ᵘ (1-y)²e^{-y} dy = 1 - (1+u²)e^{-u}`. -/
theorem integral_scoreSq_cut (u : ℝ) :
    (∫ y in (0 : ℝ)..u, (1 - y) ^ 2 * Real.exp (-y)) = 1 - (1 + u ^ 2) * Real.exp (-u) := by
  have hderiv : ∀ y ∈ uIcc (0 : ℝ) u,
      HasDerivAt (fun y : ℝ => -((1 + y ^ 2) * Real.exp (-y)))
        ((1 - y) ^ 2 * Real.exp (-y)) y := by
    intro y _
    have hexp : HasDerivAt (fun y : ℝ => Real.exp (-y)) (Real.exp (-y) * (-1)) y :=
      (hasDerivAt_neg y).exp
    have hpoly : HasDerivAt (fun y : ℝ => 1 + y ^ 2) (2 * y) y := by
      have h2 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * y) y := by
        simpa using hasDerivAt_pow 2 y
      exact HasDerivAt.const_add (1 : ℝ) h2
    have h := (hpoly.mul hexp).neg
    convert h using 1
    · rfl
    · exact Module.ext' _ _ fun _ _ => rfl
    · funext x
      simp only [Pi.neg_apply, Pi.mul_apply]
    · ring
  have hint : IntervalIntegrable (fun y : ℝ => (1 - y) ^ 2 * Real.exp (-y))
      MeasureTheory.volume 0 u := by
    apply Continuous.intervalIntegrable
    fun_prop
  rw [integral_eq_sub_of_hasDerivAt hderiv hint]
  simp
  ring

/-! ## The rank-two cutoff Ward Gram of the exponential clock -/

/-- Rank-two cutoff Ward Gram: the closed quadratic expression in the truncated state/tangent Gram
entries `(a, b, c)` = (cut mass, cut energy, cut overlap) of a pointed Fisher connection of total
energy four. -/
def fisherCutoffWardGram (a b c : ℝ) : ℝ := (4 - b) * a + (1 - a) * b - 2 * c ^ 2

/-- Cut mass of the unit-rate exponential clock. -/
def exponentialCutMass (u : ℝ) : ℝ := 1 - Real.exp (-u)

/-- Cut overlap of the unit-rate exponential clock with the pointed Fisher score `2(1-y)`. -/
def exponentialCutOverlap (u : ℝ) : ℝ := 2 * (u * Real.exp (-u))

/-- Cut energy of the pointed Fisher score `2(1-y)` under the unit-rate exponential clock. -/
def exponentialCutEnergy (u : ℝ) : ℝ := 4 * (1 - (1 + u ^ 2) * Real.exp (-u))

theorem exponentialCutMass_eq_integral (u : ℝ) :
    exponentialCutMass u = ∫ y in (0 : ℝ)..u, Real.exp (-y) := by
  rw [integral_expNeg_cut]; rfl

theorem exponentialCutOverlap_eq_integral (u : ℝ) :
    exponentialCutOverlap u = ∫ y in (0 : ℝ)..u, 2 * (1 - y) * Real.exp (-y) := by
  have h : (fun y : ℝ => 2 * (1 - y) * Real.exp (-y))
      = fun y : ℝ => 2 * ((1 - y) * Real.exp (-y)) := by
    funext y; ring
  rw [h, intervalIntegral.integral_const_mul, integral_score_cut]
  rfl

theorem exponentialCutEnergy_eq_integral (u : ℝ) :
    exponentialCutEnergy u = ∫ y in (0 : ℝ)..u, (2 * (1 - y)) ^ 2 * Real.exp (-y) := by
  have h : (fun y : ℝ => (2 * (1 - y)) ^ 2 * Real.exp (-y))
      = fun y : ℝ => 4 * ((1 - y) ^ 2 * Real.exp (-y)) := by
    funext y; ring
  rw [h, intervalIntegral.integral_const_mul, integral_scoreSq_cut]
  rfl

/-- Closed critical Ward profile of the unit-rate exponential clock. -/
def exponentialClockWardProfile (u : ℝ) : ℝ :=
  4 * ((2 + u ^ 2) * Real.exp (-u) - 2 * (1 + 2 * u ^ 2) * Real.exp (-2 * u))

/-- **The Ward profile is a functional of the `Exp(1)` law.**  Feeding the three truncated
exponential moments into the rank-two cutoff Gram reproduces the closed critical Ward profile
exactly. -/
theorem fisherCutoffWardGram_exponentialClock (u : ℝ) :
    fisherCutoffWardGram (exponentialCutMass u) (exponentialCutEnergy u)
        (exponentialCutOverlap u) = exponentialClockWardProfile u := by
  have hexp : Real.exp (-2 * u) = Real.exp (-u) ^ 2 := by
    rw [pow_two, ← Real.exp_add]; congr 1; ring
  unfold fisherCutoffWardGram exponentialCutMass exponentialCutEnergy exponentialCutOverlap
    exponentialClockWardProfile
  rw [hexp]
  ring

end GaloisForLFunctions.HTGeometry
