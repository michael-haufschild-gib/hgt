import GaloisForLFunctions.HTGeometry.PrimeProfileInvariantGrassmannRepresentation
import GaloisForLFunctions.HTGeometry.PrimeValuationFusion
import GaloisForLFunctions.HTGeometry.FinitePrimeCoefficientDifferentialField
import Mathlib.Algebra.Algebra.NonUnitalSubalgebra
import Mathlib.RingTheory.PowerSeries.Order

/-!
# Prime-radial fusion-field correspondence

An arbitrary scalar valuation profile is a formal series with zero constant coefficient.  Its
same-prime Cauchy fusion is literal multiplication of formal series.  The recurrent prime-clock
theorem then shows that the differential field generated by an arbitrary profile subspace
remembers that subspace exactly.  Consequently radial carrier fields closed under fusion are
classified by nonunital subalgebras of the formal-series profile algebra.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction Set
open scoped Differential

noncomputable section

set_option maxHeartbeats 1200000

/-! ## The zero-constant formal profile algebra -/

/-- The nonunital algebra `X * ℂ⟦X⟧` of arbitrary valuation profiles. -/
def primeRadialProfileAlgebra : NonUnitalSubalgebra ℂ (PowerSeries ℂ) where
  carrier := {u | PowerSeries.coeff 0 u = 0}
  zero_mem' := by simp
  add_mem' := by
    intro u v hu hv
    change PowerSeries.coeff 0 u = 0 at hu
    change PowerSeries.coeff 0 v = 0 at hv
    change PowerSeries.coeff 0 (u + v) = 0
    rw [PowerSeries.coeff_zero_eq_constantCoeff_apply] at hu hv ⊢
    rw [map_add, hu, hv, add_zero]
  mul_mem' := by
    intro u v hu hv
    change PowerSeries.coeff 0 u = 0 at hu
    change PowerSeries.coeff 0 v = 0 at hv
    change PowerSeries.coeff 0 (u * v) = 0
    rw [PowerSeries.coeff_mul]
    simp [hu, hv]
  smul_mem' := by
    intro z u hu
    change PowerSeries.coeff 0 u = 0 at hu
    change PowerSeries.coeff 0 (z • u) = 0
    simp [hu]

/-- A complete prime-radial valuation profile. -/
abbrev PrimeRadialProfile := primeRadialProfileAlgebra

@[simp]
theorem primeRadialProfile_coeff_zero (u : PrimeRadialProfile) :
    PowerSeries.coeff 0 (u : PowerSeries ℂ) = 0 :=
  u.2

/-- Read the positive formal-series coefficients as a valuation-depth sequence. -/
def primeRadialCoefficientProfile :
    PrimeRadialProfile →ₗ[ℂ] (Nat → ℂ) where
  toFun u e := PowerSeries.coeff (e + 1) (u : PowerSeries ℂ)
  map_add' u v := by
    funext e
    simp
  map_smul' z u := by
    funext e
    simp

theorem primeRadialCoefficientProfile_injective :
    Function.Injective primeRadialCoefficientProfile := by
  intro u v huv
  apply Subtype.ext
  apply PowerSeries.ext
  intro n
  cases n with
  | zero => exact u.2.trans v.2.symm
  | succ e =>
      exact congrFun huv e

/-- Replicate a complete formal valuation profile on every prime ray. -/
def primeRadialSource :
    PrimeRadialProfile →ₗ[ℂ] ArithmeticFunction ℂ :=
  scalarReplicatedPrimeProfile.comp primeRadialCoefficientProfile

theorem primeRadialSource_supportedOnPositivePrimePowers
    (u : PrimeRadialProfile) :
    PrimeProfileSupportedOnPositivePrimePowers (primeRadialSource u) :=
  scalarReplicatedPrimeProfile_supportedOnPositivePrimePowers
    (primeRadialCoefficientProfile u)

@[simp]
theorem primePowerCoordinateProfile_primeRadialSource
    (u : PrimeRadialProfile) (x : PrimePowerClockIndex) :
    primePowerCoordinateProfile (primeRadialSource u) x =
      PowerSeries.coeff (x.2 + 1) (u : PowerSeries ℂ) := by
  exact primePowerCoordinateProfile_scalarReplicatedPrimeProfile
    (primeRadialCoefficientProfile u) x

/-! ## A genuine same-prime Cauchy fusion -/

/-- The zero-constant formal series read from one prime ray of an arithmetic source. -/
def primeRadialRaySeries
    (A : ArithmeticFunction ℂ) (p : Nat.Primes) : PowerSeries ℂ :=
  PowerSeries.mk fun n => if n = 0 then 0 else A ((p : Nat) ^ n)

@[simp]
theorem primeRadialRaySeries_primeRadialSource
    (u : PrimeRadialProfile) (p : Nat.Primes) :
    primeRadialRaySeries (primeRadialSource u) p = (u : PowerSeries ℂ) := by
  apply PowerSeries.ext
  intro n
  cases n with
  | zero => simp [primeRadialRaySeries]
  | succ e =>
      unfold primeRadialRaySeries
      rw [PowerSeries.coeff_mk]
      simp only [Nat.succ_ne_zero, if_false]
      exact primePowerCoordinateProfile_primeRadialSource u (p, e)

/-- Same-prime Cauchy fusion of arbitrary prime-power sources.  At each output valuation this
uses only the finite Cauchy coefficient of the two input ray series. -/
def primeRadialFusion
    (A B : ArithmeticFunction ℂ) : ArithmeticFunction ℂ :=
  arithmeticFunctionOfPrimePowerProfile fun x =>
    PowerSeries.coeff (x.2 + 1)
      (primeRadialRaySeries A x.1 * primeRadialRaySeries B x.1)

@[simp]
theorem primePowerCoordinateProfile_primeRadialFusion
    (A B : ArithmeticFunction ℂ) (x : PrimePowerClockIndex) :
    primePowerCoordinateProfile (primeRadialFusion A B) x =
      PowerSeries.coeff (x.2 + 1)
        (primeRadialRaySeries A x.1 * primeRadialRaySeries B x.1) :=
  primePowerCoordinateProfile_arithmeticFunctionOfPrimePowerProfile _ x

theorem primeRadialFusion_supportedOnPositivePrimePowers
    (A B : ArithmeticFunction ℂ) :
    PrimeProfileSupportedOnPositivePrimePowers (primeRadialFusion A B) :=
  arithmeticFunctionOfPrimePowerProfile_supportedOnPositivePrimePowers _

theorem arithmeticFunctionOfPrimePowerProfile_injective :
    Function.Injective arithmeticFunctionOfPrimePowerProfile := by
  intro u v huv
  funext x
  rw [← primePowerCoordinateProfile_arithmeticFunctionOfPrimePowerProfile u x,
    ← primePowerCoordinateProfile_arithmeticFunctionOfPrimePowerProfile v x, huv]

theorem primeRadialSource_eq_arithmeticFunctionOfPrimePowerProfile
    (u : PrimeRadialProfile) :
    primeRadialSource u = arithmeticFunctionOfPrimePowerProfile
      (fun x => PowerSeries.coeff (x.2 + 1) (u : PowerSeries ℂ)) := by
  rfl

/-- **Exact radial fusion law.**  Same-prime Cauchy fusion of replicated profiles is literal
multiplication in `X * ℂ⟦X⟧`. -/
theorem primeRadialFusion_source_mul
    (u v : PrimeRadialProfile) :
    primeRadialFusion (primeRadialSource u) (primeRadialSource v) =
      primeRadialSource (u * v) := by
  unfold primeRadialFusion
  rw [primeRadialSource_eq_arithmeticFunctionOfPrimePowerProfile (u * v)]
  apply congrArg (fun q : PrimePowerClockIndex → ℂ =>
    arithmeticFunctionOfPrimePowerProfile q)
  funext x
  rw [primeRadialRaySeries_primeRadialSource,
    primeRadialRaySeries_primeRadialSource]
  rfl

/-! ## Recurrent declocking for arbitrary source families -/

/-- Recurrent declocking has no cardinality restriction on the profile family. -/
theorem scalarReplicatedPrimeProfile_clockIndependent_iff_arbitrary
    {I : Type*} (u : I → Nat → ℂ) :
    PrimeProfileClockIndependent
        (fun i => scalarReplicatedPrimeProfile (u i)) ↔
      LinearIndependent ℂ u := by
  classical
  constructor
  · intro hclock
    rw [linearIndependent_iff_finset_linearIndependent]
    intro s
    by_cases hs : s = ∅
    · subst s
      simp
    · letI : Nonempty s := Finset.nonempty_coe_sort.mpr
        (Finset.nonempty_iff_ne_empty.mpr hs)
      have hsub : PrimeProfileClockIndependent
          (fun i : s => scalarReplicatedPrimeProfile (u i.1)) := by
        unfold PrimeProfileClockIndependent at hclock ⊢
        exact hclock.comp (fun z : s × Nat => (z.1.1, z.2)) (by
          rintro ⟨i, n⟩ ⟨j, m⟩ h
          have hi : (i.1 : I) = j.1 := congrArg Prod.fst h
          have hnm : n = m := congrArg Prod.snd h
          exact Prod.ext (Subtype.ext hi) hnm)
      exact (scalarReplicatedPrimeProfile_clockIndependent_iff
        (fun i : s => u i.1)).mp hsub
  · intro hu
    unfold PrimeProfileClockIndependent
    rw [linearIndependent_iff_finset_linearIndependent]
    intro s
    let t : Finset I := s.image Prod.fst
    by_cases ht : t = ∅
    · have hs : s = ∅ := by
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro z hz
        have : z.1 ∈ t := by
          exact Finset.mem_image.mpr ⟨z, hz, rfl⟩
        simp [ht] at this
      subst s
      simp
    · letI : Nonempty t := Finset.nonempty_coe_sort.mpr
        (Finset.nonempty_iff_ne_empty.mpr ht)
      have hut : LinearIndependent ℂ (fun i : t => u i.1) :=
        hu.comp Subtype.val Subtype.val_injective
      have hclock : PrimeProfileClockIndependent
          (fun i : t => scalarReplicatedPrimeProfile (u i.1)) :=
        (scalarReplicatedPrimeProfile_clockIndependent_iff
          (fun i : t => u i.1)).mpr hut
      let j : s → t × Nat := fun z =>
        (⟨z.1.1, Finset.mem_image.mpr ⟨z.1, z.2, rfl⟩⟩, z.1.2)
      have hj : Function.Injective j := by
        intro z w hzw
        apply Subtype.ext
        apply Prod.ext
        · exact congrArg (fun q : t × Nat => q.1.1) hzw
        · exact congrArg (fun q : t × Nat => q.2) hzw
      exact hclock.comp j hj

/-- Every linearly independent family of arbitrary formal profiles gives a jointly
differentially independent family of actual replicated prime-power carriers. -/
theorem differentialIndependent_primeRadialSource_of_linearIndependent
    {I : Type*} (u : I → PrimeRadialProfile)
    (hu : LinearIndependent ℂ u) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeCoefficientField
      (fun i => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField (primeRadialSource (u i))) := by
  have hcoeff : LinearIndependent ℂ
      (fun i => primeRadialCoefficientProfile (u i)) :=
    hu.map' primeRadialCoefficientProfile
      (LinearMap.ker_eq_bot.mpr primeRadialCoefficientProfile_injective)
  have hclock : PrimeProfileClockIndependent
      (fun i => primeRadialSource (u i)) := by
    have h := (scalarReplicatedPrimeProfile_clockIndependent_iff_arbitrary
      (fun i => primeRadialCoefficientProfile (u i))).mpr hcoeff
    simpa [primeRadialSource] using h
  let g : I × Nat → ArithmeticFunction ℂ := fun ik =>
    primeProfileRotatedLogJet ik.2 (primeRadialSource (u ik.1))
  have hsupport : ∀ ik,
      PrimeProfileSupportedOnPositivePrimePowers (g ik) := by
    intro ik
    exact primeProfileRotatedLogJet_supportedOnPositivePrimePowers
      (primeRadialSource (u ik.1))
      (primeRadialSource_supportedOnPositivePrimePowers (u ik.1)) ik.2
  have hAI : AlgebraicIndependent finitePrimeCoefficientField
      (fun ik => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField (g ik)) :=
    (algebraicIndependent_fractionPrimeProfiles_iff_clockClassIndependent_arbitrary
      g hsupport).mpr (by
        change LinearIndependent ℂ
          (primeProfileClockJetFamily (fun i => primeRadialSource (u i)))
        exact hclock)
  unfold GaloisForLFunctions.DifferentialIndependent
  simpa only [g, differentialJet_algebraMap_primeProfileRotatedLogJet] using hAI

/-! ## Arbitrary profile subspaces and their embedded fields -/

/-- Hamel-basis index of an arbitrary radial profile subspace. -/
abbrev PrimeRadialBasisIndex (W : Submodule ℂ PrimeRadialProfile) :=
  Module.Basis.ofVectorSpaceIndex ℂ W

/-- The ambient profile represented by one vector of the chosen Hamel basis of `W`. -/
def primeRadialBasisProfile
    (W : Submodule ℂ PrimeRadialProfile) (i : PrimeRadialBasisIndex W) :
    PrimeRadialProfile :=
  ((Module.Basis.ofVectorSpace ℂ W i : W) : PrimeRadialProfile)

theorem linearIndependent_primeRadialBasisProfile
    (W : Submodule ℂ PrimeRadialProfile) :
    LinearIndependent ℂ (primeRadialBasisProfile W) := by
  let b := Module.Basis.ofVectorSpace ℂ W
  have hb := b.linearIndependent.map' W.subtype W.ker_subtype
  simpa only [b, PrimeRadialBasisIndex, primeRadialBasisProfile] using! hb

theorem span_primeRadialBasisProfile
    (W : Submodule ℂ PrimeRadialProfile) :
    Submodule.span ℂ (Set.range (primeRadialBasisProfile W)) = W := by
  let b := Module.Basis.ofVectorSpace ℂ W
  unfold primeRadialBasisProfile
  rw [show Set.range (fun i : PrimeRadialBasisIndex W =>
      ((b i : W) : PrimeRadialProfile)) =
      W.subtype '' Set.range b by
    ext u
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨b i, Set.mem_range_self i, rfl⟩
    · rintro ⟨w, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩,
    ← Submodule.map_span, b.span_eq, Submodule.map_top,
    Submodule.range_subtype]

/-- Basis source family of a radial profile subspace. -/
def primeRadialBasisSource
    (W : Submodule ℂ PrimeRadialProfile) :
    PrimeRadialBasisIndex W → ArithmeticFunction ℂ :=
  fun i => primeRadialSource (primeRadialBasisProfile W i)

theorem primeRadialBasisSource_supportedOnPositivePrimePowers
    (W : Submodule ℂ PrimeRadialProfile) (i : PrimeRadialBasisIndex W) :
    PrimeProfileSupportedOnPositivePrimePowers (primeRadialBasisSource W i) :=
  primeRadialSource_supportedOnPositivePrimePowers _

/-- The differential field generated by all radial profiles in `W`. -/
def primeRadialDifferentialField
    (W : Submodule ℂ PrimeRadialProfile) :
    IntermediateField finitePrimeCoefficientField arithmeticFunctionFractionField :=
  GaloisForLFunctions.differentialAdjoin finitePrimeCoefficientField
    (Set.range (fun i => algebraMap (ArithmeticFunction ℂ)
      arithmeticFunctionFractionField (primeRadialBasisSource W i)))

/-- A radial source class belongs to the complete basis clock module exactly when its formal
profile belongs to the original profile subspace. -/
theorem primeRadialSource_clockClass_mem_basisClockSubmodule_iff
    (W : Submodule ℂ PrimeRadialProfile) (u : PrimeRadialProfile) :
    primeProfileClockClass (primeRadialSource u) ∈
        primeProfileClockSubmodule (primeRadialBasisSource W) ↔
      u ∈ W := by
  classical
  constructor
  · intro hclass
    by_contra hu
    let b : PrimeRadialBasisIndex W → PrimeRadialProfile := primeRadialBasisProfile W
    let z : Unit → PrimeRadialProfile := fun _ => u
    have hright : LinearIndependent ℂ z := by
      rw [linearIndependent_unique_iff]
      intro huzero
      apply hu
      simp [z, huzero]
    have hdis : Disjoint
        (Submodule.span ℂ (Set.range b))
        (Submodule.span ℂ (Set.range z)) := by
      have hWu : Disjoint W (ℂ ∙ u) :=
        Submodule.disjoint_span_singleton_of_notMem hu
      simpa [b, z, span_primeRadialBasisProfile W] using hWu
    have hprofiles : LinearIndependent ℂ (Sum.elim b z) :=
      linearIndependent_sum.mpr
        ⟨linearIndependent_primeRadialBasisProfile W, hright, hdis⟩
    have hcoeff : LinearIndependent ℂ
        (fun q => primeRadialCoefficientProfile (Sum.elim b z q)) :=
      hprofiles.map' primeRadialCoefficientProfile
        (LinearMap.ker_eq_bot.mpr primeRadialCoefficientProfile_injective)
    have hclock : PrimeProfileClockIndependent
        (Sum.elim (primeRadialBasisSource W)
          (fun _ : Unit => primeRadialSource u)) := by
      have h := (scalarReplicatedPrimeProfile_clockIndependent_iff_arbitrary
        (fun q => primeRadialCoefficientProfile (Sum.elim b z q))).mpr hcoeff
      have hfamily :
          (fun q => scalarReplicatedPrimeProfile
            (primeRadialCoefficientProfile (Sum.elim b z q))) =
          Sum.elim (primeRadialBasisSource W)
            (fun _ : Unit => primeRadialSource u) := by
        funext q
        rcases q with i | j <;>
          rfl
      rw [hfamily] at h
      exact h
    have hsplit :=
      (primeProfileClockIndependent_sumElim_iff
        (primeRadialBasisSource W) (fun _ : Unit => primeRadialSource u)).mp hclock
    have hquot :=
      (linearIndependent_sumElim_iff_quotient
        (primeProfileClockJetFamily (primeRadialBasisSource W))
        (primeProfileClockJetFamily (fun _ : Unit => primeRadialSource u))).mp hsplit
    have hne := hquot.2.ne_zero (Unit.unit, 0)
    apply hne
    simp only [Function.comp_apply, primeProfileClockJetFamily,
      primeProfileRotatedLogJet_zero]
    exact (Submodule.Quotient.mk_eq_zero _).2 hclass
  · intro hu
    rw [← span_primeRadialBasisProfile W] at hu
    refine Submodule.span_induction
      (p := fun v : PrimeRadialProfile => fun _ =>
        primeProfileClockClass (primeRadialSource v) ∈
          primeProfileClockSubmodule (primeRadialBasisSource W))
      (hx := hu) ?_ ?_ ?_ ?_
    · intro v hv
      obtain ⟨i, rfl⟩ := hv
      apply Submodule.subset_span
      exact ⟨(i, 0), by
        simp [primeRadialBasisSource, primeProfileClockJetFamily]⟩
    · simp
    · intro v w _hvspan _hwspan hv hw
      simpa using Submodule.add_mem _ hv hw
    · intro z v _hvspan hv
      simpa using Submodule.smul_mem _ z hv

/-- **Arbitrary radial source recovery.**  A replicated formal profile belongs to the generated
differential field exactly when the profile belongs to the generating subspace. -/
theorem primeRadialSource_mem_differentialField_iff
    (W : Submodule ℂ PrimeRadialProfile) (u : PrimeRadialProfile) :
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
        (primeRadialSource u) ∈ primeRadialDifferentialField W ↔
      u ∈ W := by
  unfold primeRadialDifferentialField
  rw [primeProfileCarrier_mem_differentialAdjoin_iff_intrinsicClockClass_mem
    (primeRadialBasisSource W)
    (primeRadialBasisSource_supportedOnPositivePrimePowers W)
    (primeRadialSource u)
    (primeRadialSource_supportedOnPositivePrimePowers u)]
  exact primeRadialSource_clockClass_mem_basisClockSubmodule_iff W u

/-- Inclusion of arbitrary radial differential fields is exactly inclusion of profile
subspaces. -/
theorem primeRadialDifferentialField_le_iff
    (U W : Submodule ℂ PrimeRadialProfile) :
    primeRadialDifferentialField U ≤ primeRadialDifferentialField W ↔ U ≤ W := by
  constructor
  · intro hfield u hu
    apply (primeRadialSource_mem_differentialField_iff W u).mp
    apply hfield
    exact (primeRadialSource_mem_differentialField_iff U u).mpr hu
  · intro hUW
    unfold primeRadialDifferentialField
    apply (primeProfile_differentialAdjoin_le_iff_intrinsicClockSubmodule_le
      (primeRadialBasisSource U) (primeRadialBasisSource W)
      (primeRadialBasisSource_supportedOnPositivePrimePowers U)
      (primeRadialBasisSource_supportedOnPositivePrimePowers W)).mpr
    rw [primeProfileClockSubmodule, Submodule.span_le]
    rintro _ ⟨⟨i, n⟩, rfl⟩
    apply (primeProfileClockSubmodule_invariant
      (primeRadialBasisSource W)).jet_mem
    apply (primeRadialSource_clockClass_mem_basisClockSubmodule_iff W
      (primeRadialBasisProfile U i)).mpr
    exact hUW (Module.Basis.ofVectorSpace ℂ U i).2

/-- Equality of arbitrary radial differential fields is exactly equality of their profile
subspaces. -/
theorem primeRadialDifferentialField_eq_iff
    (U W : Submodule ℂ PrimeRadialProfile) :
    primeRadialDifferentialField U = primeRadialDifferentialField W ↔ U = W := by
  constructor
  · intro h
    apply le_antisymm
    · exact (primeRadialDifferentialField_le_iff U W).mp h.le
    · exact (primeRadialDifferentialField_le_iff W U).mp h.ge
  · intro h
    exact congrArg primeRadialDifferentialField h

/-! ## Fusion closure and the exact subalgebra classifier -/

/-- Radial carrier fusion closure of the field represented by `W`. -/
def PrimeRadialCarrierFusionClosed
    (W : Submodule ℂ PrimeRadialProfile) : Prop :=
  ∀ u v : PrimeRadialProfile,
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
        (primeRadialSource u) ∈ primeRadialDifferentialField W →
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
        (primeRadialSource v) ∈ primeRadialDifferentialField W →
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
        (primeRadialFusion (primeRadialSource u) (primeRadialSource v)) ∈
      primeRadialDifferentialField W

/-- **Fusion closure classifier.**  A radial carrier field is closed under exact same-prime
Cauchy fusion if and only if its formal profile subspace is multiplicatively closed. -/
theorem primeRadialCarrierFusionClosed_iff_mul_mem
    (W : Submodule ℂ PrimeRadialProfile) :
    PrimeRadialCarrierFusionClosed W ↔
      ∀ u v : PrimeRadialProfile, u ∈ W → v ∈ W → u * v ∈ W := by
  constructor
  · intro hfusion u v hu hv
    have hout := hfusion u v
      ((primeRadialSource_mem_differentialField_iff W u).mpr hu)
      ((primeRadialSource_mem_differentialField_iff W v).mpr hv)
    rw [primeRadialFusion_source_mul] at hout
    exact (primeRadialSource_mem_differentialField_iff W (u * v)).mp hout
  · intro hmul u v hu hv
    rw [primeRadialFusion_source_mul]
    apply (primeRadialSource_mem_differentialField_iff W (u * v)).mpr
    exact hmul u v
      ((primeRadialSource_mem_differentialField_iff W u).mp hu)
      ((primeRadialSource_mem_differentialField_iff W v).mp hv)

/-- The embedded fusion field represented by a nonunital formal-profile subalgebra. -/
def primeRadialFusionField
    (A : NonUnitalSubalgebra ℂ PrimeRadialProfile) :
    IntermediateField finitePrimeCoefficientField arithmeticFunctionFractionField :=
  primeRadialDifferentialField A.toSubmodule

theorem primeRadialFusionField_fusionClosed
    (A : NonUnitalSubalgebra ℂ PrimeRadialProfile) :
    PrimeRadialCarrierFusionClosed A.toSubmodule := by
  rw [primeRadialCarrierFusionClosed_iff_mul_mem]
  exact fun u v hu hv => A.mul_mem hu hv

/-- The fusion-field construction is an exact order embedding. -/
def primeRadialFusionFieldOrderEmbedding :
    NonUnitalSubalgebra ℂ PrimeRadialProfile ↪o
      IntermediateField finitePrimeCoefficientField arithmeticFunctionFractionField where
  toFun := primeRadialFusionField
  inj' := by
    intro A B h
    apply NonUnitalSubalgebra.toSubmodule_injective
    exact (primeRadialDifferentialField_eq_iff A.toSubmodule B.toSubmodule).mp h
  map_rel_iff' := by
    intro A B
    exact (primeRadialDifferentialField_le_iff A.toSubmodule B.toSubmodule).trans
      NonUnitalSubalgebra.toSubmodule'.le_iff_le

end

end GaloisForLFunctions.HTGeometry
