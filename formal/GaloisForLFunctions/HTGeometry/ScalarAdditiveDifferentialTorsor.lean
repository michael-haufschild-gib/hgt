import GaloisForLFunctions.HTGeometry.RatFuncTranslationFixedField
import GaloisForLFunctions.HTGeometry.ScalarDifferentialTorsor
import GaloisForLFunctions.HTGeometry.ProjectiveJetHorizon
import GaloisForLFunctions.HTGeometry.KolchinExchangeGaugeObstruction

/-!
# The scalar additive differential torsor over its derivative field

For a freely generated differential scalar `q`, put `P = q'` and `L = F<P>`.
Then `T = L(q)`, the coordinate `q` is transcendental over `L`, and all
derivation-preserving `L`-automorphisms are the translations `q |-> q + c`
by constants `c` from `F`.  Unit translation has fixed field exactly `L`.
-/

open scoped Differential Polynomial

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F T : Type*} [Field F] [Field T] [Algebra F T]
  [Differential F] [Differential T] [DifferentialAlgebra F T]
  [CharZero T]

/-- The differential field generated by the derivative of an additive amplitude. -/
def scalarDerivativeField (F : Type*) {T : Type*} [Field F] [Field T]
    [Algebra F T] [Differential T] (q : T) : IntermediateField F T :=
  differentialAdjoin F ({q′} : Set T)

/-- The concrete coefficient `P = q′` of the additive rank-two triangular system, regarded as
an element of its derivative field. -/
def scalarDerivativeCoefficient (q : T) : scalarDerivativeField F q :=
  ⟨q′, subset_differentialAdjoin F ({q′} : Set T) rfl⟩

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
@[simp]
theorem scalarDerivativeCoefficient_coe (q : T) :
    (scalarDerivativeCoefficient (F := F) q : T) = q′ := rfl

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
/-- The primitive solves the concrete additive Picard--Vessiot equation `Dq = P`. -/
theorem scalar_amplitude_deriv_eq_coefficient (q : T) :
    q′ = algebraMap (scalarDerivativeField F q) T
      (scalarDerivativeCoefficient (F := F) q) := rfl

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
/-- The derivative field is the first strict jet-tail field. -/
theorem scalarDerivativeField_eq_jetTailField (q : T) :
    scalarDerivativeField F q = jetTailField F q 1 := by
  unfold scalarDerivativeField differentialAdjoin jetTailField
  congr 1
  ext z
  constructor
  · rintro ⟨x, hx, n, rfl⟩
    have hxq : x = q′ := Set.mem_singleton_iff.mp hx
    subst x
    refine ⟨n + 1, ?_, ?_⟩
    · show 1 ≤ n + 1
      omega
    simpa using differentialJet_add n 1 q
  · rintro ⟨m, hm, rfl⟩
    rcases m with _ | n
    · exact (Nat.not_succ_le_zero 0 hm).elim
    · refine ⟨q′, rfl, n, ?_⟩
      simpa using (differentialJet_add n 1 q).symm

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
/-- Exact additive reconstruction: the full differential field is generated ordinarily by its
derivative field and the single primitive coordinate. -/
theorem scalarDerivativeField_adjoin_amplitude_eq_top (q : T)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) :
    IntermediateField.adjoin (scalarDerivativeField F q) ({q} : Set T) = ⊤ := by
  let L : IntermediateField F T := scalarDerivativeField F q
  let A : IntermediateField L T := IntermediateField.adjoin L ({q} : Set T)
  have hqA : q ∈ A := IntermediateField.subset_adjoin L ({q} : Set T) rfl
  let B : IntermediateField F T := A.restrictScalars F
  have hle : differentialAdjoin F ({q} : Set T) ≤ B := by
    rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
    rintro z ⟨x, hx, n, rfl⟩
    have hxq : x = q := Set.mem_singleton_iff.mp hx
    subst x
    rcases n with _ | n
    · simpa using hqA
    · have hjet : differentialJet (n + 1) q ∈ L := by
        rw [show differentialJet (n + 1) q = differentialJet n q′ by
          simpa using differentialJet_add n 1 q]
        exact differentialJet_mem_differentialAdjoin F
          (s := ({q′} : Set T)) rfl n
      exact A.algebraMap_mem ⟨differentialJet (n + 1) q, hjet⟩
  apply top_unique
  intro z _
  exact hle (by rw [hgen]; trivial)

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
/-- The primitive coordinate is algebraically transcendental over its derivative field. -/
theorem scalar_amplitude_transcendental_over_derivativeField (q : T)
    (hq : HypertranscendentalOver F q) :
    Transcendental (scalarDerivativeField F q) q := by
  rw [scalarDerivativeField_eq_jetTailField]
  simpa using
    (hypertranscendentalOver_transcendental_over_strictJetTail hq 0)

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
/-- The pointwise-fixed derivative observable remains hypertranscendental over the constants. -/
theorem scalar_derivative_hypertranscendentalOver (q : T)
    (hq : HypertranscendentalOver F q) :
    HypertranscendentalOver F q′ :=
  hypertranscendentalOver_deriv hq

/-- The exact rational coordinate on the additive torsor: `X` is sent to the primitive `q`. -/
def scalarAdditiveTorsorRatFuncEquiv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) :
    RatFunc (scalarDerivativeField F q) ≃ₐ[scalarDerivativeField F q] T :=
  (RatFunc.algEquivOfTranscendental q
      (scalar_amplitude_transcendental_over_derivativeField q hq)).trans
    ((IntermediateField.equivOfEq
      (scalarDerivativeField_adjoin_amplitude_eq_top q hgen)).trans
        IntermediateField.topEquiv)

omit [Differential F] [DifferentialAlgebra F T] [CharZero T] in
@[simp]
theorem scalarAdditiveTorsorRatFuncEquiv_X (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) :
    scalarAdditiveTorsorRatFuncEquiv q hq hgen RatFunc.X = q := by
  simp [scalarAdditiveTorsorRatFuncEquiv]

private def scalarDifferentialTranslationEquivRaw (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) : T ≃ₐ[F] T := by
  let x : Unit → T := fun _ => q
  let y : Unit → T := fun _ => q + algebraMap F T c
  have hx : DifferentialIndependent F x := by
    simpa [x] using
      (GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton F q).mp hq
  have hy : DifferentialIndependent F y := by
    simpa [x, y] using hx.addBase (fun _ : Unit => c)
  have hxtop : differentialAdjoin F (Set.range x) = ⊤ := by
    simpa [x] using hgen
  have hytop : differentialAdjoin F (Set.range y) = ⊤ := by
    have heq := differentialAdjoin_addOfJetsInBase
      (F := F) x (fun _ : Unit => algebraMap F T c) (by
        intro _ n
        exact ⟨differentialJet n c,
          differentialJet_algebraMap_apply n c⟩)
    rw [show y = fun i => x i + algebraMap F T c by rfl, heq, hxtop]
  exact GaloisForLFunctions.differentialIndependentTopAlgEquiv
    x y hx hy hxtop hytop

omit [CharZero T] in
private theorem scalarDifferentialTranslationEquivRaw_apply_q (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) :
    scalarDifferentialTranslationEquivRaw q hq hgen c q =
      q + algebraMap F T c := by
  let x : Unit → T := fun _ => q
  let y : Unit → T := fun _ => q + algebraMap F T c
  have hx : DifferentialIndependent F x := by
    simpa [x] using
      (GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton F q).mp hq
  have hy : DifferentialIndependent F y := by
    simpa [x, y] using hx.addBase (fun _ : Unit => c)
  have hxtop : differentialAdjoin F (Set.range x) = ⊤ := by
    simpa [x] using hgen
  have hytop : differentialAdjoin F (Set.range y) = ⊤ := by
    have heq := differentialAdjoin_addOfJetsInBase
      (F := F) x (fun _ : Unit => algebraMap F T c) (by
        intro _ n
        exact ⟨differentialJet n c,
          differentialJet_algebraMap_apply n c⟩)
    rw [show y = fun i => x i + algebraMap F T c by rfl, heq, hxtop]
  exact GaloisForLFunctions.differentialIndependentTopAlgEquiv_apply
    x y hx hy hxtop hytop Unit.unit

omit [CharZero T] in
private theorem scalarDifferentialTranslationEquivRaw_deriv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) (z : T) :
    scalarDifferentialTranslationEquivRaw q hq hgen c z′ =
      (scalarDifferentialTranslationEquivRaw q hq hgen c z)′ := by
  let x : Unit → T := fun _ => q
  let y : Unit → T := fun _ => q + algebraMap F T c
  have hx : DifferentialIndependent F x := by
    simpa [x] using
      (GaloisForLFunctions.hypertranscendentalOver_iff_differentialIndependent_singleton F q).mp hq
  have hy : DifferentialIndependent F y := by
    simpa [x, y] using hx.addBase (fun _ : Unit => c)
  have hxtop : differentialAdjoin F (Set.range x) = ⊤ := by
    simpa [x] using hgen
  have hytop : differentialAdjoin F (Set.range y) = ⊤ := by
    have heq := differentialAdjoin_addOfJetsInBase
      (F := F) x (fun _ : Unit => algebraMap F T c) (by
        intro _ n
        exact ⟨differentialJet n c,
          differentialJet_algebraMap_apply n c⟩)
    rw [show y = fun i => x i + algebraMap F T c by rfl, heq, hxtop]
  exact GaloisForLFunctions.differentialIndependentTopAlgEquiv_deriv
    x y hx hy hxtop hytop z

omit [CharZero T] in
/-- A constant translation exists on a freely generated differential field and commutes with
the derivation.  The existential wrapper encapsulates the universal-property construction for
downstream group and fixed-field proofs. -/
theorem exists_scalarDifferentialTranslationEquiv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) :
    ∃ sigma : T ≃ₐ[F] T,
      sigma q = q + algebraMap F T c ∧
        ∀ z : T, sigma z′ = (sigma z)′ :=
  ⟨scalarDifferentialTranslationEquivRaw q hq hgen c,
    scalarDifferentialTranslationEquivRaw_apply_q q hq hgen c,
    scalarDifferentialTranslationEquivRaw_deriv q hq hgen c⟩

/-- Translation by a base scalar on a freely generated differential field. -/
def scalarDifferentialTranslationEquiv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) : T ≃ₐ[F] T :=
  (exists_scalarDifferentialTranslationEquiv q hq hgen c).choose

omit [CharZero T] in
@[simp]
theorem scalarDifferentialTranslationEquiv_apply_q (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) :
    scalarDifferentialTranslationEquiv q hq hgen c q =
      q + algebraMap F T c :=
  (exists_scalarDifferentialTranslationEquiv q hq hgen c).choose_spec.1

omit [CharZero T] in
/-- The canonical translation commutes with the derivation. -/
theorem scalarDifferentialTranslationEquiv_deriv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤) (c : F) (z : T) :
    scalarDifferentialTranslationEquiv q hq hgen c z′ =
      (scalarDifferentialTranslationEquiv q hq hgen c z)′ :=
  (exists_scalarDifferentialTranslationEquiv q hq hgen c).choose_spec.2 z

omit [CharZero T] in
/-- Translation by a differential constant fixes the derivative coordinate. -/
theorem scalarDifferentialTranslationEquiv_derivative (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : F) :
    scalarDifferentialTranslationEquiv q hq hgen c q′ = q′ := by
  rw [scalarDifferentialTranslationEquiv_deriv,
    scalarDifferentialTranslationEquiv_apply_q, map_add, deriv_algebraMap,
    hconst, map_zero, add_zero]

/-- Translation fixes the full differential field generated by the derivative coordinate. -/
theorem scalarDifferentialTranslationEquiv_fixed_on_derivativeField (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : F)
    (z : scalarDerivativeField F q) :
    scalarDifferentialTranslationEquiv q hq hgen c z.1 = z.1 := by
  let sigma := scalarDifferentialTranslationEquiv q hq hgen c
  have hP : sigma q′ = q′ :=
    scalarDifferentialTranslationEquiv_derivative q hq hgen hconst c
  have hjet : ∀ n : ℕ, sigma (differentialJet n q′) = differentialJet n q′ := by
    intro n
    induction n with
    | zero => simpa using hP
    | succ n ih =>
        rw [differentialJet_succ, scalarDifferentialTranslationEquiv_deriv]
        exact congrArg Differential.deriv ih
  change sigma z.1 = z.1
  have hz : z.1 ∈ IntermediateField.adjoin F
      (differentialJetSet ({q′} : Set T)) := by
    change z.1 ∈ scalarDerivativeField F q
    exact z.2
  apply IntermediateField.adjoin_induction F
    (s := differentialJetSet ({q′} : Set T))
    (p := fun w _ => sigma w = w)
  · rintro w ⟨v, hv, n, rfl⟩
    have hvP : v = q′ := Set.mem_singleton_iff.mp hv
    simpa [hvP] using hjet n
  · intro a
    exact sigma.commutes a
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]
  · exact hz

/-- Translation re-based over the derivative field. -/
def scalarDifferentialTranslationEquivDerivative (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : F) :
    T ≃ₐ[scalarDerivativeField F q] T where
  toRingEquiv := (scalarDifferentialTranslationEquiv q hq hgen c).toRingEquiv
  commutes' z := scalarDifferentialTranslationEquiv_fixed_on_derivativeField
    q hq hgen hconst c z

@[simp]
theorem scalarDifferentialTranslationEquivDerivative_apply_q (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : F) :
    scalarDifferentialTranslationEquivDerivative q hq hgen hconst c q =
      q + algebraMap F T c :=
  scalarDifferentialTranslationEquiv_apply_q q hq hgen c

omit [Differential F] [DifferentialAlgebra F T] in
/-- Automorphisms over the derivative field are determined by the primitive coordinate. -/
theorem scalarDerivativeAlgEquiv_ext (q : T)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    {sigma tau : T ≃ₐ[scalarDerivativeField F q] T}
    (hqeq : sigma q = tau q) : sigma = tau := by
  let L : IntermediateField F T := scalarDerivativeField F q
  have htop : IntermediateField.adjoin L ({q} : Set T) = ⊤ :=
    scalarDerivativeField_adjoin_amplitude_eq_top q hgen
  apply AlgEquiv.ext
  intro z
  have hz : z ∈ IntermediateField.adjoin L ({q} : Set T) := by
    rw [htop]
    trivial
  apply IntermediateField.adjoin_induction L
    (s := ({q} : Set T)) (p := fun w _ => sigma w = tau w)
  · intro w hw
    have hwq : w = q := Set.mem_singleton_iff.mp hw
    simpa [hwq] using hqeq
  · intro a
    exact (sigma.commutes a).trans (tau.commutes a).symm
  · intro a b _ _ ha hb
    rw [map_add, map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, map_mul, ha, hb]
  · exact hz

theorem scalarDifferentialTranslationEquivDerivative_zero (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) :
    scalarDifferentialTranslationEquivDerivative q hq hgen hconst 0 = 1 := by
  apply scalarDerivativeAlgEquiv_ext q hgen
  rw [scalarDifferentialTranslationEquivDerivative_apply_q]
  simp

theorem scalarDifferentialTranslationEquivDerivative_add (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c d : F) :
    scalarDifferentialTranslationEquivDerivative q hq hgen hconst (c + d) =
      scalarDifferentialTranslationEquivDerivative q hq hgen hconst c *
        scalarDifferentialTranslationEquivDerivative q hq hgen hconst d := by
  apply scalarDerivativeAlgEquiv_ext q hgen
  simp only [AlgEquiv.mul_apply,
    scalarDifferentialTranslationEquivDerivative_apply_q]
  have hdL : algebraMap F T d ∈ scalarDerivativeField F q :=
    (scalarDerivativeField F q).algebraMap_mem d
  have hfixd : scalarDifferentialTranslationEquivDerivative q hq hgen hconst c
      (algebraMap F T d) = algebraMap F T d := by
    exact (scalarDifferentialTranslationEquivDerivative q hq hgen hconst c).commutes
      ⟨algebraMap F T d, hdL⟩
  calc
    q + algebraMap F T (c + d) =
        (q + algebraMap F T c) + algebraMap F T d := by
          rw [map_add]
          abel
    _ = scalarDifferentialTranslationEquivDerivative q hq hgen hconst c q +
        scalarDifferentialTranslationEquivDerivative q hq hgen hconst c
          (algebraMap F T d) := by
          rw [scalarDifferentialTranslationEquivDerivative_apply_q, hfixd]
    _ = scalarDifferentialTranslationEquivDerivative q hq hgen hconst c
        (q + algebraMap F T d) := by rw [map_add]

/-- The additive constant action by derivation-preserving automorphisms. -/
def scalarDifferentialTranslationAction (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) :
    Multiplicative F →* derivationPreservingAut (scalarDerivativeField F q) T where
  toFun c := ⟨scalarDifferentialTranslationEquivDerivative
      q hq hgen hconst c.toAdd,
    scalarDifferentialTranslationEquiv_deriv q hq hgen c.toAdd⟩
  map_one' := Subtype.ext
    (scalarDifferentialTranslationEquivDerivative_zero q hq hgen hconst)
  map_mul' c d := Subtype.ext
    (scalarDifferentialTranslationEquivDerivative_add
      q hq hgen hconst c.toAdd d.toAdd)

@[simp]
theorem scalarDifferentialTranslationAction_apply_q (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : Multiplicative F) :
    (scalarDifferentialTranslationAction q hq hgen hconst c).1 q =
      q + algebraMap F T c.toAdd :=
  scalarDifferentialTranslationEquivDerivative_apply_q
    q hq hgen hconst c.toAdd

/-- The additive translation action is faithful. -/
theorem scalarDifferentialTranslationAction_injective (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) :
    Function.Injective
      (scalarDifferentialTranslationAction q hq hgen hconst) := by
  intro c d hcd
  have hqeq := congrArg
    (fun sigma : derivationPreservingAut (scalarDerivativeField F q) T => sigma.1 q) hcd
  have hcoeff : algebraMap F T c.toAdd = algebraMap F T d.toAdd := by
    apply add_left_cancel
    simpa only [scalarDifferentialTranslationAction_apply_q] using hqeq
  exact Multiplicative.toAdd.injective ((algebraMap F T).injective hcoeff)

/-- Every derivation-preserving derivative-field automorphism is one constant translation. -/
theorem scalarDifferentialTranslationAction_surjective (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T] :
    Function.Surjective
      (scalarDifferentialTranslationAction q hq hgen hconst) := by
  intro sigma
  have hPmem : q′ ∈ scalarDerivativeField F q :=
    subset_differentialAdjoin F ({q′} : Set T) rfl
  have hfixP : sigma.1 q′ = q′ := sigma.1.commutes ⟨q′, hPmem⟩
  have hdiffDeriv : (sigma.1 q - q)′ = 0 := by
    rw [map_sub, ← sigma.2 q, hfixP, sub_self]
  obtain ⟨c, hc⟩ := mem_range_of_deriv_eq_zero F hdiffDeriv
  refine ⟨Multiplicative.ofAdd c, ?_⟩
  apply Subtype.ext
  apply scalarDerivativeAlgEquiv_ext q hgen
  simp only [scalarDifferentialTranslationAction_apply_q]
  change q + algebraMap F T c = sigma.1 q
  rw [hc]
  ring

/-- **Full additive differential Galois group.**  The derivative-field automorphism group is the
additive constant group, represented multiplicatively by `Multiplicative F`. -/
def scalarAdditiveDifferentialGaloisGroupEquiv (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) [Differential.ContainConstants F T] :
    Multiplicative F ≃* derivationPreservingAut (scalarDerivativeField F q) T :=
  MulEquiv.ofBijective
    (scalarDifferentialTranslationAction q hq hgen hconst)
    ⟨scalarDifferentialTranslationAction_injective q hq hgen hconst,
      scalarDifferentialTranslationAction_surjective q hq hgen hconst⟩

/-- The rational translation and differential translation actions are conjugate through the
primitive-coordinate equivalence. -/
theorem scalarAdditiveTorsorRatFuncEquiv_translation (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) (c : F)
    (z : RatFunc (scalarDerivativeField F q)) :
    scalarAdditiveTorsorRatFuncEquiv q hq hgen (ratFuncTranslationAction
        (Multiplicative.ofAdd
          (algebraMap F (scalarDerivativeField F q) c)) z) =
      scalarDifferentialTranslationEquivDerivative q hq hgen hconst c
        (scalarAdditiveTorsorRatFuncEquiv q hq hgen z) := by
  let e := scalarAdditiveTorsorRatFuncEquiv q hq hgen
  let sigma := scalarDifferentialTranslationEquivDerivative q hq hgen hconst c
  have heq : e.toAlgHom.comp
      (ratFuncTranslationAction
        (Multiplicative.ofAdd
          (algebraMap F (scalarDerivativeField F q) c))).toAlgHom =
        sigma.toAlgHom.comp e.toAlgHom := by
    apply ratFunc_algHom_ext
    change e (ratFuncTranslationAction
        (Multiplicative.ofAdd
          (algebraMap F (scalarDerivativeField F q) c)) RatFunc.X) =
      sigma (e RatFunc.X)
    rw [ratFuncTranslationAction_apply_X, map_add,
      scalarAdditiveTorsorRatFuncEquiv_X,
      scalarDifferentialTranslationEquivDerivative_apply_q, e.commutes]
    simp only [toAdd_ofAdd]
    rw [IsScalarTower.algebraMap_apply F (scalarDerivativeField F q) T]
  exact DFunLike.congr_fun heq z

/-- Unit translation fixes exactly the derivative field. -/
theorem fixedField_zpowers_scalarDifferentialTranslation_one (q : T)
    (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0) :
    IntermediateField.fixedField
        (Subgroup.zpowers
          (scalarDifferentialTranslationEquivDerivative
            q hq hgen hconst 1)) = ⊥ := by
  let L : IntermediateField F T := scalarDerivativeField F q
  let e := scalarAdditiveTorsorRatFuncEquiv q hq hgen
  let sigmaX : RatFunc L ≃ₐ[L] RatFunc L :=
    ratFuncTranslationAction
      (Multiplicative.ofAdd (algebraMap F L (1 : F)))
  let sigmaT : T ≃ₐ[L] T :=
    scalarDifferentialTranslationEquivDerivative q hq hgen hconst 1
  have hfixedX : IntermediateField.fixedField (Subgroup.zpowers sigmaX) = ⊥ := by
    exact fixedField_zpowers_ratFuncTranslationAction
      (algebraMap F L (1 : F)) (by simp)
  have hmapBot : (⊥ : IntermediateField L (RatFunc L)).map e.toAlgHom = ⊥ := by
    simp
  ext z
  have hconj : sigmaT z = z ↔ sigmaX (e.symm z) = e.symm z := by
    have heq := scalarAdditiveTorsorRatFuncEquiv_translation
      q hq hgen hconst 1 (e.symm z)
    change e (sigmaX (e.symm z)) = sigmaT (e (e.symm z)) at heq
    rw [e.apply_symm_apply] at heq
    constructor
    · intro hz
      apply e.injective
      rw [heq, hz, e.apply_symm_apply]
    · intro hz
      rw [← heq, hz, e.apply_symm_apply]
  rw [mem_fixedField_zpowers_iff, hconj, ← mem_fixedField_zpowers_iff,
    hfixedX, ← hmapBot, mem_map_algEquiv_iff]

omit [Differential F] [DifferentialAlgebra F T] in
/-- A differential automorphism fixing `q′` fixes the whole derivative field pointwise. -/
theorem DifferentialAlgEquiv.fixed_on_scalarDerivativeField_of_fixed_deriv
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hP : sigma.toAlgEquiv q′ = q′)
    (z : scalarDerivativeField F q) :
    sigma.toAlgEquiv z.1 = z.1 := by
  have hjet : ∀ n : ℕ,
      sigma.toAlgEquiv (differentialJet n q′) = differentialJet n q′ := by
    intro n
    rw [sigma.map_differentialJet, hP]
  change sigma.toAlgEquiv z.1 = z.1
  have hz : z.1 ∈ IntermediateField.adjoin F
      (differentialJetSet ({q′} : Set T)) := by
    change z.1 ∈ scalarDerivativeField F q
    exact z.2
  apply IntermediateField.adjoin_induction F
    (s := differentialJetSet ({q′} : Set T))
    (p := fun w _ => sigma.toAlgEquiv w = w)
  · rintro w ⟨v, hv, n, rfl⟩
    have hvP : v = q′ := Set.mem_singleton_iff.mp hv
    simpa [hvP] using hjet n
  · intro c
    exact sigma.toAlgEquiv.commutes c
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]
  · exact hz

/-- Rebase a differential automorphism over the derivative field once it fixes `q′`. -/
def DifferentialAlgEquiv.restrictScalarsToDerivativeField
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hP : sigma.toAlgEquiv q′ = q′) :
    T ≃ₐ[scalarDerivativeField F q] T where
  toRingEquiv := sigma.toAlgEquiv.toRingEquiv
  commutes' z := sigma.fixed_on_scalarDerivativeField_of_fixed_deriv q hP z

/-- Rebase a differential automorphism as a derivation-preserving derivative-field
automorphism. -/
def DifferentialAlgEquiv.toDerivativeFieldDerivationPreservingAut
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hP : sigma.toAlgEquiv q′ = q′) :
    derivationPreservingAut (scalarDerivativeField F q) T :=
  ⟨sigma.restrictScalarsToDerivativeField q hP, sigma.map_deriv'⟩

omit [Differential F] [DifferentialAlgebra F T] in
/-- Re-basing over the derivative field and restricting back to `F` preserves the cyclic fixed
field exactly. -/
theorem DifferentialAlgEquiv.fixedField_toDerivativeField_restrictScalars
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hP : sigma.toAlgEquiv q′ = q′) :
    (IntermediateField.fixedField
      (Subgroup.zpowers
        (sigma.restrictScalarsToDerivativeField q hP))).restrictScalars F =
      IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) := by
  ext z
  rw [IntermediateField.mem_restrictScalars,
    mem_fixedField_zpowers_iff, mem_fixedField_zpowers_iff]
  rfl

omit [CharZero T] in
/-- Translation by one fixes the derivative coordinate of an arbitrary original-base
differential automorphism. -/
theorem DifferentialAlgEquiv.deriv_fixed_of_translate_one
    (sigma : DifferentialAlgEquiv F T) (q : T)
    (hsigma : sigma.toAlgEquiv q = q + algebraMap F T 1) :
    sigma.toAlgEquiv q′ = q′ := by
  calc
    sigma.toAlgEquiv q′ = (sigma.toAlgEquiv q)′ := sigma.map_deriv' q
    _ = (q + algebraMap F T 1)′ := by rw [hsigma]
    _ = q′ := by rw [map_add, deriv_algebraMap]; simp

/-- An arbitrary derivative-field differential automorphism sending `q` to `q+1` has derivative
field as its exact cyclic fixed field. -/
theorem fixedField_zpowers_derivationPreservingAut_of_translate_one
    (q : T) (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0)
    (sigma : derivationPreservingAut (scalarDerivativeField F q) T)
    (hsigma : sigma.1 q = q + algebraMap F T 1) :
    IntermediateField.fixedField (Subgroup.zpowers sigma.1) = ⊥ := by
  have hsigmaEq : sigma =
      scalarDifferentialTranslationAction q hq hgen hconst
        (Multiplicative.ofAdd 1) := by
    apply Subtype.ext
    apply scalarDerivativeAlgEquiv_ext q hgen
    simp [hsigma]
  rw [hsigmaEq]
  exact fixedField_zpowers_scalarDifferentialTranslation_one
    q hq hgen hconst

/-- The cyclic fixed field of an arbitrary original-base differential translation `q ↦ q+1`
is literally the derivative field `F⟨q′⟩`. -/
theorem DifferentialAlgEquiv.fixedField_zpowers_of_translate_one
    (sigma : DifferentialAlgEquiv F T)
    (q : T) (hq : HypertranscendentalOver F q)
    (hgen : differentialAdjoin F ({q} : Set T) = ⊤)
    (hconst : ∀ c : F, c′ = 0)
    (hsigma : sigma.toAlgEquiv q = q + algebraMap F T 1) :
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
      scalarDerivativeField F q := by
  let hP := sigma.deriv_fixed_of_translate_one q hsigma
  let sigmaL := sigma.toDerivativeFieldDerivationPreservingAut q hP
  have hfixed :
      IntermediateField.fixedField (Subgroup.zpowers sigmaL.1) = ⊥ := by
    apply fixedField_zpowers_derivationPreservingAut_of_translate_one
      q hq hgen hconst sigmaL
    exact hsigma
  calc
    IntermediateField.fixedField (Subgroup.zpowers sigma.toAlgEquiv) =
        (IntermediateField.fixedField
          (Subgroup.zpowers sigmaL.1)).restrictScalars F :=
      (sigma.fixedField_toDerivativeField_restrictScalars q hP).symm
    _ = (⊥ : IntermediateField (scalarDerivativeField F q) T).restrictScalars F :=
      congrArg _ hfixed
    _ = scalarDerivativeField F q :=
      IntermediateField.restrictScalars_bot_eq_self (scalarDerivativeField F q)

end

