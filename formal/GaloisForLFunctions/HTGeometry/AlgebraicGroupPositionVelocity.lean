import GaloisForLFunctions.HTGeometry.AlgebraicGroupIsogenyTail
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Theorem B: the position–velocity decomposition of the isogeny tail

With `K = C(J^∞ G)`, the Maurer–Cartan velocity `ℓ` and `H(C)` the rational points of the Zariski
closure of all iterated kernels of the isogeny `α`:

* **positions and velocities generate the invariants**: `K^(H(C)) = C⟨F^(H(C)), ℓ⟩`, the
  differential field generated by the `H(C)`-invariant rational functions and `ℓ`;
* **the isogeny is reversible on positions**: `α*` maps `F^(H(C))` bijectively onto itself.

The first statement is the fixed-field theorem in Maurer–Cartan coordinates: `K^(H(C))` is the
field generated by `F^(H(C))` and all jets of `ℓ`, and that field is closed under `δ` because
`δa = Σ ℓ_i D_i a` with `D_i a ∈ F^(H(C))` (the `D_i` are translation invariant).  The second uses
the level theorem `F^(Γ_1) = α* F`, surjectivity of `α` on rational points and the closure step.
-/

open CategoryTheory Limits AlgebraicGeometry Opposite
open MonoidalCategory CartesianMonoidalCategory MonObj
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C : Type u} [Field C] (G : Over (Spec (.of C))) [IsIntegral G.left]
  [LocallyOfFiniteType G.hom] [CharZero C]

/-- The jet field `K` as a differential field. -/
instance groupJetDifferential : Differential (GroupJetField G) :=
  ⟨Derivation.mk' (groupJetDerivation G).toLinearMap.toAddMonoidHom.toIntLinearMap
    fun a b => (groupJetDerivation G).leibniz a b⟩

theorem groupJetDifferential_deriv (x : GroupJetField G) :
    Differential.deriv x = groupJetDerivation G x := rfl

theorem differentialJet_eq_iterate (n : ℕ) (x : GroupJetField G) :
    differentialJet n x = ((groupJetDerivation G : GroupJetField G → GroupJetField G)^[n]) x := rfl

/-- An intermediate field whose generators are sent into it by `δ` is closed under `δ`. -/
theorem groupJetDerivation_mem_of_generators (L : IntermediateField C (GroupJetField G))
    (S : Set (GroupJetField G)) (hL : L = IntermediateField.adjoin C S)
    (hS : ∀ s ∈ S, groupJetDerivation G s ∈ L) {x : GroupJetField G} (hx : x ∈ L) :
    groupJetDerivation G x ∈ L := by
  let δ := groupJetDerivation G
  let L' : IntermediateField C (GroupJetField G) :=
    { carrier := {y | y ∈ L ∧ δ y ∈ L}
      mul_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        refine ⟨L.mul_mem ha hb, ?_⟩
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact L.add_mem (L.mul_mem ha hb') (L.mul_mem hb ha')
      one_mem' := ⟨L.one_mem, by rw [Derivation.map_one_eq_zero]; exact L.zero_mem⟩
      add_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        exact ⟨L.add_mem ha hb, by rw [map_add]; exact L.add_mem ha' hb'⟩
      zero_mem' := ⟨L.zero_mem, by rw [map_zero]; exact L.zero_mem⟩
      algebraMap_mem' := fun c => ⟨L.algebraMap_mem c, by
        rw [Derivation.map_algebraMap]; exact L.zero_mem⟩
      inv_mem' := by
        rintro a ⟨ha, ha'⟩
        refine ⟨L.inv_mem ha, ?_⟩
        rw [Derivation.leibniz_inv, smul_eq_mul]
        exact L.mul_mem (L.neg_mem (L.pow_mem (L.inv_mem ha) 2)) ha' }
  have hle : L ≤ L' := by
    rw [hL, IntermediateField.adjoin_le_iff]
    intro s hs
    exact ⟨hL ▸ IntermediateField.subset_adjoin C S hs, hS s hs⟩
  exact (hle hx).2

variable [GrpObj G] [IsAlgClosed C] [IsCommMonObj G]

/-- **The position–velocity field is the differential field generated by positions and
velocity.**  For a set of positions stable under the invariant derivations, the field generated by
the positions and all velocity jets is `C⟨T, ℓ⟩`. -/
theorem positionVelocityField_eq_differentialAdjoin (T : Set G.left.functionField)
    (hT : ∀ i, ∀ a ∈ T, mcDerivation G i a ∈ T) :
    positionVelocityField (mcDerivation G) (groupBasis_isTranscendenceBasis G) T =
      differentialAdjoin C (algebraMap _ (GroupJetField G) '' T ∪ Set.range (mcVelocity G)) := by
  set L := positionVelocityField (mcDerivation G) (groupBasis_isTranscendenceBasis G) T
  have hjet : ∀ q, maurerCartanJet (D := mcDerivation G) (groupBasis_isTranscendenceBasis G) q =
      differentialJet q.1 (mcVelocity G q.2) := fun q => rfl
  -- `L` is closed under `δ`
  have hstable : ∀ {x}, x ∈ L → groupJetDerivation G x ∈ L := by
    intro x hx
    refine groupJetDerivation_mem_of_generators G L _ rfl ?_ hx
    rintro _ (⟨a, ha, rfl⟩ | ⟨⟨k, i⟩, rfl⟩)
    · rw [groupJetDerivation_eq_sum_mcVelocity]
      refine L.sum_mem fun i _ => L.mul_mem ?_ ?_
      · exact maurerCartanJet_mem_positionVelocityField _ T (0, i)
      · exact algebraMap_mem_positionVelocityField _ (hT i a ha)
    · change groupJetDerivation G (((groupJetDerivation G : GroupJetField G → GroupJetField G)^[k])
        (mcVelocity G i)) ∈ L
      rw [← Function.iterate_succ_apply' (f := (groupJetDerivation G : GroupJetField G →
        GroupJetField G))]
      exact maurerCartanJet_mem_positionVelocityField _ T (k + 1, i)
  have hiter : ∀ n {x}, x ∈ L →
      ((groupJetDerivation G : GroupJetField G → GroupJetField G)^[n]) x ∈ L := by
    intro n
    induction n with
    | zero => intro x hx; exact hx
    | succ n ih => intro x hx; rw [Function.iterate_succ_apply']; exact hstable (ih hx)
  apply le_antisymm
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ (⟨a, ha, rfl⟩ | ⟨q, rfl⟩)
    · exact IntermediateField.subset_adjoin C _ ⟨_, Or.inl ⟨a, ha, rfl⟩, 0, rfl⟩
    · rw [hjet]
      exact IntermediateField.subset_adjoin C _ ⟨_, Or.inr ⟨q.2, rfl⟩, q.1, rfl⟩
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ ⟨y, hy, n, rfl⟩
    rw [differentialJet_eq_iterate]
    refine hiter n ?_
    rcases hy with ⟨a, ha, rfl⟩ | ⟨i, rfl⟩
    · exact algebraMap_mem_positionVelocityField _ ha
    · exact maurerCartanJet_mem_positionVelocityField _ T (0, i)

variable (α : G ⟶ G) [IsIsogeny G α]

/-- The positions `F^(H(C))`: rational functions invariant under the deck closure. -/
def deckClosurePositions : Set G.left.functionField :=
  {a | ∀ x ∈ deckClosurePoints G α, translationAlgEquiv G x a = a}

omit [IsAlgClosed C] [IsIsogeny G α] in
theorem mcDerivation_mem_deckClosurePositions (i : Fin (groupDim G)) {a : G.left.functionField}
    (ha : a ∈ deckClosurePositions G α) : mcDerivation G i a ∈ deckClosurePositions G α :=
  fun x hx => by rw [← mcDerivation_invariant G i x a, ha x hx]

/-- **Theorem B (position–velocity decomposition).**  An element of the jet field is fixed by the
deck closure exactly when it lies in the differential field generated by the invariant positions
`F^(H(C))` and the Maurer–Cartan velocity `ℓ`: `K^(H(C)) = C⟨F^(H(C)), ℓ⟩`. -/
theorem deckClosure_fixed_iff_mem_differentialAdjoin (u : GroupJetField G) :
    (∀ x ∈ deckClosurePoints G α, jetTranslation G x u = u) ↔
      u ∈ differentialAdjoin C (algebraMap _ (GroupJetField G) '' deckClosurePositions G α ∪
        Set.range (mcVelocity G)) := by
  rw [← positionVelocityField_eq_differentialAdjoin G _
    (fun i a ha => mcDerivation_mem_deckClosurePositions G α i ha)]
  have h := fixed_iff_mem_positionVelocityField (groupBasis_isTranscendenceBasis G)
    (mcDerivation_det_ne_zero G) (fun x : deckClosurePoints G α => translationAlgEquiv G x)
    (fun x i f => mcDerivation_invariant G i x f) u
  have hset : {a | ∀ x : deckClosurePoints G α, translationAlgEquiv G x a = a} =
      deckClosurePositions G α :=
    Set.ext fun a => ⟨fun h x hx => h ⟨x, hx⟩, fun h x => h x x.2⟩
  rw [hset] at h
  rw [← h]
  exact ⟨fun h' x => h' x x.2, fun h' x hx => h' ⟨x, hx⟩⟩

omit [IsAlgClosed C] [IsCommMonObj G] [IsIntegral G.left] [LocallyOfFiniteType G.hom]
  [CharZero C] in
theorem isogenyPow_succ' (n : ℕ) : isogenyPow α (n + 1) = α ≫ isogenyPow α n := by
  induction n with
  | zero => rw [isogenyPow_succ, isogenyPow_zero, Category.id_comp, Category.comp_id]
  | succ n ih =>
      calc isogenyPow α (n + 1 + 1) = isogenyPow α (n + 1) ≫ α := rfl
        _ = (α ≫ isogenyPow α n) ≫ α := by rw [ih]
        _ = α ≫ isogenyPow α (n + 1) := Category.assoc _ _ _

omit [IsAlgClosed C] [IsCommMonObj G] [IsIntegral G.left] [LocallyOfFiniteType G.hom]
  [CharZero C] in
theorem comp_isogeny_mem_isogenyKernelPoints {n : ℕ} {c : 𝟙_ (Over (Spec (.of C))) ⟶ G}
    (hc : c ∈ isogenyKernelPoints G α n) : c ≫ α ∈ isogenyKernelPoints G α n := by
  haveI := IsIsogeny.toIsMonHom (G := G) (α := α)
  change (c ≫ α) ≫ isogenyPow α n = 1
  have hc' : c ≫ isogenyPow α n = 1 := hc
  rw [Category.assoc, ← isogenyPow_succ', isogenyPow_succ, ← Category.assoc, hc',
    MonObj.one_comp]

/-- **The isogeny is reversible on positions**: `α*` maps `F^(H(C))` bijectively onto itself, so
`α` induces an automorphism of the quotient `G/H`. -/
theorem bijOn_overFunctionFieldPullback_deckClosurePositions :
    Set.BijOn (overFunctionFieldPullback G α) (deckClosurePositions G α)
      (deckClosurePositions G α) := by
  have hinj : Function.Injective (overFunctionFieldPullback G α) :=
    (overFunctionFieldPullback G α).toRingHom.injective
  refine ⟨fun f hf => ?_, hinj.injOn, fun g hg => ?_⟩
  · -- `α* f` is fixed by every iterated kernel
    refine (fixed_isogenyKernelPoints_iff G α _).mp fun n c hc => ?_
    rw [← overFunctionFieldPullback_translation,
      hf _ (isogenyKernelPoints_subset_deckClosurePoints G α n
        (comp_isogeny_mem_isogenyKernelPoints G α hc))]
  · -- `g` is a pullback, by the level theorem at `n = 1`
    have hg1 : g ∈ Set.range ⇑((overFunctionFieldPullback G α) ^ 1) :=
      (mem_range_isogenyPullback_pow_iff G α 1 g).mpr fun c hc =>
        hg c (isogenyKernelPoints_subset_deckClosurePoints G α 1 hc)
    rw [pow_one] at hg1
    obtain ⟨f, rfl⟩ := hg1
    refine ⟨f, (fixed_isogenyKernelPoints_iff G α f).mp fun n c hc => ?_, rfl⟩
    obtain ⟨x, rfl⟩ := exists_comp_isogeny_eq α c
    have hx : x ∈ deckClosurePoints G α := by
      refine isogenyKernelPoints_subset_deckClosurePoints G α (n + 1) ?_
      change x ≫ isogenyPow α (n + 1) = 1
      rw [isogenyPow_succ', ← Category.assoc]
      exact hc
    apply hinj
    rw [overFunctionFieldPullback_translation, hg x hx]

end

end GaloisForLFunctions.HTGeometry
