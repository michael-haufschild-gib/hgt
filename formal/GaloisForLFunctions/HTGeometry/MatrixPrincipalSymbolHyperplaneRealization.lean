import GaloisForLFunctions.HTGeometry.MatrixPrincipalSymbolHyperplaneHorizon

/-!
# Realization of every finite hyperplane horizon

The hyperplane-collapse theorem has an exact converse.  Any finite family of linear characters
with a common regular law is the determinant horizon of a static diagonal coefficient-flat
principal-symbol tower.  Consequently, over an algebraically closed field, the regular flat
finite-rank linear horizons are exactly finite central hyperplane arrangements, up to repeated or
redundant characters.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K h ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
  [AddCommGroup h] [Module K h]

/-- The diagonal principal symbol generated by a finite character family. -/
def diagonalCharacterPrincipalSymbol
    (characters : ι → h →ₗ[K] K) (A : h) : Matrix ι ι K :=
  Matrix.diagonal fun i ↦ characters i A

/-- The diagonal principal symbol is linear in law space. -/
def diagonalCharacterPrincipalSymbolLinear
    (characters : ι → h →ₗ[K] K) : h →ₗ[K] Matrix ι ι K where
  toFun := diagonalCharacterPrincipalSymbol characters
  map_add' A B := by
    ext i j
    by_cases hij : i = j
    · subst j
      simp [diagonalCharacterPrincipalSymbol]
    · simp [diagonalCharacterPrincipalSymbol, hij]
  map_smul' t A := by
    ext i j
    by_cases hij : i = j
    · subst j
      simp [diagonalCharacterPrincipalSymbol]
    · simp [diagonalCharacterPrincipalSymbol, hij]

omit [Fintype ι] in
@[simp]
theorem diagonalCharacterPrincipalSymbolLinear_apply
    (characters : ι → h →ₗ[K] K) (A : h) :
    diagonalCharacterPrincipalSymbolLinear characters A =
      diagonalCharacterPrincipalSymbol characters A :=
  rfl

/-- The static tower realizing a finite hyperplane arrangement. -/
def diagonalCharacterPrincipalSymbolTower
    (characters : ι → h →ₗ[K] K) : ℕ → h → Matrix ι ι K :=
  fun _ A ↦ diagonalCharacterPrincipalSymbol characters A

omit [Fintype ι] in
@[simp]
theorem diagonalCharacterPrincipalSymbolTower_apply
    (characters : ι → h →ₗ[K] K) (n : ℕ) (A : h) :
    diagonalCharacterPrincipalSymbolTower characters n A =
      diagonalCharacterPrincipalSymbol characters A :=
  rfl

/-- Every static diagonal character tower is coefficient-flat. -/
theorem diagonalCharacterPrincipalSymbolTower_flat
    (characters : ι → h →ₗ[K] K) :
    MatrixCoefficientPrincipalSymbolFlat
      (diagonalCharacterPrincipalSymbolTower characters) := by
  intro n A B
  simp only [diagonalCharacterPrincipalSymbolTower_apply,
    diagonalCharacterPrincipalSymbol, Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  exact mul_comm _ _

/-- The determinant of the diagonal realization is the product of its characters. -/
theorem diagonalCharacterPrincipalSymbolTower_det
    (characters : ι → h →ₗ[K] K) (n : ℕ) (A : h) :
    (diagonalCharacterPrincipalSymbolTower characters n A).det =
      ∏ i, characters i A := by
  simp [diagonalCharacterPrincipalSymbolTower,
    diagonalCharacterPrincipalSymbol, Matrix.det_diagonal]

/-- Its singular horizon is exactly the union of the prescribed character kernels. -/
theorem diagonalCharacterPrincipalSymbolTower_det_eq_zero_iff
    (characters : ι → h →ₗ[K] K) (n : ℕ) (A : h) :
    (diagonalCharacterPrincipalSymbolTower characters n A).det = 0 ↔
      ∃ i, characters i A = 0 := by
  rw [diagonalCharacterPrincipalSymbolTower_det]
  simp only [Finset.prod_eq_zero_iff, Finset.mem_univ, true_and]

/-- A common complement point is a regular law at every layer of the realization. -/
theorem diagonalCharacterPrincipalSymbolTower_regular
    (characters : ι → h →ₗ[K] K) (e : h)
    (he : ∀ i, characters i e ≠ 0) :
    ∀ n, (diagonalCharacterPrincipalSymbolTower characters n e).det ≠ 0 := by
  intro n
  rw [diagonalCharacterPrincipalSymbolTower_det]
  exact Finset.prod_ne_zero_iff.mpr fun i _ ↦ he i

/-- **Finite arrangement realization.**  Every finite central hyperplane arrangement possessing a
common complement point is realized exactly as a regular coefficient-flat linear
principal-symbol horizon. -/
theorem finiteHyperplaneArrangement_realized_by_regularFlatLinearPrincipalSymbol
    (characters : ι → h →ₗ[K] K) (e : h)
    (he : ∀ i, characters i e ≠ 0) :
    MatrixCoefficientPrincipalSymbolFlat
        (diagonalCharacterPrincipalSymbolTower characters) ∧
      (∀ n, (diagonalCharacterPrincipalSymbolTower characters n e).det ≠ 0) ∧
      (∀ n A,
        (diagonalCharacterPrincipalSymbolTower characters n A).det = 0 ↔
          ∃ i, characters i A = 0) ∧
      (∀ n A,
        diagonalCharacterPrincipalSymbolTower characters n A =
          diagonalCharacterPrincipalSymbolLinear characters A) := by
  exact ⟨diagonalCharacterPrincipalSymbolTower_flat characters,
    diagonalCharacterPrincipalSymbolTower_regular characters e he,
    diagonalCharacterPrincipalSymbolTower_det_eq_zero_iff characters,
    fun _ _ ↦ rfl⟩

end

end GaloisForLFunctions.HTGeometry
