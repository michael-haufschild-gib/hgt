import GaloisForLFunctions.HTGeometry.SimplePoleWeightedSecondSubprincipal
import GaloisForLFunctions.HTGeometry.GammaPoleWeightedFirstSubprincipalCofinal

/-!
# Cofinal discharge of the Gamma second-subprincipal reflection

The branchwise second-subprincipal order theorem needs principal cancellation, first-partial
cancellation, and a nonzero complete second boundary on one common Gamma pole branch.  This module
represents that complete three-term boundary in the existing faithful Laurent algebra generated by
the factorial scale and positive derivatives of the regular Gamma pole unit.

The symbols for `R₀'(0)` and `R₁(0)` both use the second positive unit derivative, with the exact
factor `1/2`; `R₁(0)` additionally carries one inverse physical scale.  Together with the existing
finite-part symbol for `R₀(0)`, they produce one symbolic source for the full second boundary.
Joint Laurent injectivity turns symbolic nonvanishing into a nonzero boundary germ.  Eventual
principal and first-partial cancellations can then be intersected with a nonzero boundary value
beyond any prescribed branch bound, yielding simultaneous exact order `-(W-2)` for covariant and
native affine Gamma packets.

Two specializations of the positive unit-derivative variables isolate the surviving `X₁` and
`X₀²` channels.  After first-partial cancellation this gives an exact classification: the complete
second symbol is nonzero precisely when the first-jet partial reflection or repeated-base Hessian
reflection is nonzero.  Thus the final cofinal theorem needs only intrinsic principal-reflection
conditions, not an opaque nonzero boundary combination.
-/

open Complex Filter Topology Finset MvPolynomial Polynomial LaurentPolynomial

namespace GaloisForLFunctions

noncomputable section

local instance gammaPoleWeightedSecondSubprincipalCofinalLocalInst1 : Algebra ℂ NatGerm := complexNatGerm.toAlgebra

/-- Laurent symbol for the center derivative `R₀'(0)` of the base Gamma regular remainder. -/
def gammaPoleBaseRemainderDerivativeSymbol :
    GammaPoleScaleDerivativeSymbolic :=
  -(gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹ *
    LaurentPolynomial.C
      (MvPolynomial.X 1 : MvPolynomial ℕ GammaPoleRationalBase))

/-- Laurent symbol for the first regular value `R₁(0)`; it carries one inverse factorial scale. -/
def gammaPoleFirstJetRemainderSymbol :
    GammaPoleScaleDerivativeSymbolic :=
  LaurentPolynomial.T (-1) *
    gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹ *
    LaurentPolynomial.C
      (MvPolynomial.X 1 : MvPolynomial ℕ GammaPoleRationalBase)

/-- The base-remainder derivative symbol evaluates to the first finite-part jet germ. -/
theorem eval_baseRemainderDerivativeSymbol :
    gammaPoleScaleAndUnitDerivativeLaurentEval
        gammaPoleBaseRemainderDerivativeSymbol =
      gammaPoleFinitePartJetGerm 1 := by
  rw [gammaPoleBaseRemainderDerivativeSymbol, map_neg, map_mul]
  have hscalar : gammaPoleScaleAndUnitDerivativeLaurentEval
      (gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹) =
      complexNatGerm (2 : ℂ)⁻¹ := by
    simp [gammaPoleComplexScaleDerivativeInclude, complexNatGerm]
  have hX : gammaPoleScaleAndUnitDerivativeLaurentEval
      (LaurentPolynomial.C
        (MvPolynomial.X 1 : MvPolynomial ℕ GammaPoleRationalBase)) =
      gammaPoleUnitPositiveDerivativeRationalGerm 1 := by
    simp [gammaPoleScaleAndUnitDerivativeLaurentEval,
      gammaPoleUnitDerivativeRationalEval]
  rw [hscalar, hX]
  rw [gammaPoleFinitePartJetGerm_eq_unitCoefficient]
  rw [gammaPoleUnitPositiveCoefficientGerm_eq_actualTaylorCoefficient]
  simp only [gammaPoleUnitPositiveDerivativeRationalGerm, Nat.factorial_one,
    Nat.cast_one, one_add_one_eq_two]
  simp_rw [complexNatGerm_eq_constGerm]
  change -((↑(fun _ : ℕ => (2 : ℂ)⁻¹) : NatGerm) *
      (↑(fun N : ℕ => iteratedDeriv 2
        (gammaPoleRegularUnit (N - 1)) 0) : NatGerm)) =
    (↑(fun _ : ℕ => -(1 : ℂ)) : NatGerm) *
      (↑(fun N : ℕ => (((2 : ℕ).factorial : ℂ)⁻¹) *
        iteratedDeriv 2 (gammaPoleRegularUnit (N - 1)) 0) : NatGerm)
  rw [← Filter.Germ.coe_mul, ← Filter.Germ.coe_neg,
    ← Filter.Germ.coe_mul, Filter.Germ.coe_eq]
  exact Filter.Eventually.of_forall fun _ => by norm_num

/-- Pole-index germ of the first Gamma-jet regular value `R₁(0)`. -/
def gammaPoleFirstJetRemainderGerm : NatGerm :=
  (fun N : ℕ => gammaPoleJetRegularRemainder (N - 1) 1 0 : NatGerm)

/-- Exact scale/unit-derivative factorization of the `R₁(0)` germ. -/
theorem firstJetRemainderGerm_eq :
    gammaPoleFirstJetRemainderGerm =
      -gammaPolePhysicalScaleGerm⁻¹ * complexNatGerm (2 : ℂ)⁻¹ *
        gammaPoleUnitPositiveDerivativeRationalGerm 1 := by
  rw [gammaPolePhysicalScaleGerm_eq_actual]
  simp_rw [complexNatGerm_eq_constGerm]
  change (↑(fun N : ℕ => gammaPoleJetRegularRemainder (N - 1) 1 0) : NatGerm) =
    -(↑(fun N : ℕ => reciprocalGammaFactorialScale (N - 1)) : NatGerm)⁻¹ *
      (↑(fun _ : ℕ => (2 : ℂ)⁻¹) : NatGerm) *
      (↑(fun N : ℕ => iteratedDeriv 2
        (gammaPoleRegularUnit (N - 1)) 0) : NatGerm)
  rw [← Filter.Germ.coe_inv, ← Filter.Germ.coe_neg,
    ← Filter.Germ.coe_mul, ← Filter.Germ.coe_mul, Filter.Germ.coe_eq]
  exact Filter.Eventually.of_forall fun N => by
    change gammaPoleJetRegularRemainder (N - 1) 1 0 =
      -(reciprocalGammaFactorialScale (N - 1))⁻¹ * (2 : ℂ)⁻¹ *
        iteratedDeriv 2 (gammaPoleRegularUnit (N - 1)) 0
    rw [show gammaPoleJetRegularRemainder (N - 1) 1 0 =
        iteratedDeriv 0 (gammaPoleJetRegularRemainder (N - 1) 1) 0 by
      simp [iteratedDeriv_zero],
      iteratedDeriv_gammaPoleJetRegularRemainder_zero]
    norm_num
    ring

/-- The inverse-scale Laurent symbol evaluates to the actual `R₁(0)` germ. -/
theorem eval_firstJetRemainderSymbol :
    gammaPoleScaleAndUnitDerivativeLaurentEval
        gammaPoleFirstJetRemainderSymbol =
      gammaPoleFirstJetRemainderGerm := by
  rw [gammaPoleFirstJetRemainderSymbol, map_mul, map_mul]
  have hT : gammaPoleScaleAndUnitDerivativeLaurentEval
      (LaurentPolynomial.T (-1) : GammaPoleScaleDerivativeSymbolic) =
      reciprocalSignedFactorialGerm⁻¹ := by
    simp [gammaPoleScaleAndUnitDerivativeLaurentEval]
  have hscalar : gammaPoleScaleAndUnitDerivativeLaurentEval
      (gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹) =
      complexNatGerm (2 : ℂ)⁻¹ := by
    simp [gammaPoleComplexScaleDerivativeInclude, complexNatGerm]
  have hX : gammaPoleScaleAndUnitDerivativeLaurentEval
      (LaurentPolynomial.C
        (MvPolynomial.X 1 : MvPolynomial ℕ GammaPoleRationalBase)) =
      gammaPoleUnitPositiveDerivativeRationalGerm 1 := by
    simp [gammaPoleScaleAndUnitDerivativeLaurentEval,
      gammaPoleUnitDerivativeRationalEval]
  rw [hT, hscalar, hX, firstJetRemainderGerm_eq]
  simp [gammaPolePhysicalScaleGerm]

/-- One symbolic source for the complete three-term Gamma second-subprincipal boundary. -/
def gammaPoleSecondSubprincipalBoundarySymbol
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) :
    GammaPoleScaleDerivativeSymbolic :=
  gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) *
      gammaPoleBaseRemainderDerivativeSymbol +
    gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (1 : Fin (n + 2)) P) *
      gammaPoleFirstJetRemainderSymbol +
    gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹ *
      gammaPolePrincipalReflectionSymbol (n + 1)
        (MvPolynomial.pderiv (0 : Fin (n + 2))
          (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) *
      (-LaurentPolynomial.C
        (MvPolynomial.X 0 : MvPolynomial ℕ GammaPoleRationalBase)) ^ (2 : ℕ)

/-- Actual pole-index germ obtained from the symbolic second boundary. -/
def gammaPoleSecondSubprincipalBoundaryGerm
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) : NatGerm :=
  gammaPoleScaleAndUnitDerivativeLaurentEval
    (gammaPoleSecondSubprincipalBoundarySymbol n P)

/-- The symbolic source evaluates exactly to the branchwise complete second boundary sequence. -/
theorem gammaPoleSecondSubprincipalBoundaryGerm_eq_sequence
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) :
    gammaPoleSecondSubprincipalBoundaryGerm n P =
      (fun N : ℕ => gammaPoleSecondSubprincipalBoundary (N - 1) n P : NatGerm) := by
  rw [gammaPoleSecondSubprincipalBoundaryGerm,
    gammaPoleSecondSubprincipalBoundarySymbol,
    map_add, map_add, map_mul, map_mul, map_mul, map_mul, map_pow,
    eval_baseRemainderDerivativeSymbol,
    eval_firstJetRemainderSymbol,
    gammaPoleScaleAndUnitDerivativeLaurentEval_finitePartSymbol]
  have hscalar : gammaPoleScaleAndUnitDerivativeLaurentEval
      (gammaPoleComplexScaleDerivativeInclude (2 : ℂ)⁻¹) =
      complexNatGerm (2 : ℂ)⁻¹ := by
    simp [gammaPoleComplexScaleDerivativeInclude, complexNatGerm]
  rw [hscalar]
  change
    gammaPolePrincipalReflectionGerm (n + 1)
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P) *
        gammaPoleFinitePartJetGerm 1 +
      gammaPolePrincipalReflectionGerm (n + 1)
        (MvPolynomial.pderiv (1 : Fin (n + 2)) P) *
        gammaPoleFirstJetRemainderGerm +
      complexNatGerm (2 : ℂ)⁻¹ *
        gammaPolePrincipalReflectionGerm (n + 1)
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) *
        gammaPoleFinitePartJetGerm 0 ^ (2 : ℕ) = _
  rw [gammaPolePrincipalReflectionGerm_eq_sequence,
    gammaPolePrincipalReflectionGerm_eq_sequence,
    gammaPolePrincipalReflectionGerm_eq_sequence]
  change
    (↑(fun N : ℕ => MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) : NatGerm) *
        gammaPoleFinitePartJetGerm 1 +
      (↑(fun N : ℕ => MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
        (MvPolynomial.pderiv (1 : Fin (n + 2)) P)) : NatGerm) *
        gammaPoleFirstJetRemainderGerm +
      complexNatGerm (2 : ℂ)⁻¹ *
        (↑(fun N : ℕ => MvPolynomial.eval
          (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P))) : NatGerm) *
        gammaPoleFinitePartJetGerm 0 ^ (2 : ℕ) = _
  simp_rw [complexNatGerm_eq_constGerm]
  change
    (↑(fun N : ℕ => MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) : NatGerm) *
        (↑(fun N : ℕ => iteratedDeriv 1
          (gammaPoleJetRegularRemainder (N - 1) 0) 0) : NatGerm) +
      (↑(fun N : ℕ => MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
        (MvPolynomial.pderiv (1 : Fin (n + 2)) P)) : NatGerm) *
        (↑(fun N : ℕ => gammaPoleJetRegularRemainder (N - 1) 1 0) : NatGerm) +
      (↑(fun _ : ℕ => (2 : ℂ)⁻¹) : NatGerm) *
        (↑(fun N : ℕ => MvPolynomial.eval
          (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P))) : NatGerm) *
        (↑(fun N : ℕ => gammaPoleJetRegularRemainder (N - 1) 0 0) : NatGerm) ^ (2 : ℕ) = _
  rw [← Filter.Germ.coe_mul, ← Filter.Germ.coe_mul,
    ← Filter.Germ.coe_mul, ← Filter.Germ.coe_pow, ← Filter.Germ.coe_mul,
    ← Filter.Germ.coe_add, ← Filter.Germ.coe_add, Filter.Germ.coe_eq]
  exact Filter.Eventually.of_forall fun N => by
    simp only [Pi.mul_apply, Pi.add_apply, Pi.pow_apply]
    simp [gammaPoleSecondSubprincipalBoundary, iteratedDeriv_one]

/-- Injective joint Laurent evaluation preserves nonvanishing of the second-boundary symbol. -/
theorem gammaPoleSecondSubprincipalBoundaryGerm_ne_zero
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hboundary : gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0) :
    gammaPoleSecondSubprincipalBoundaryGerm n P ≠ 0 := by
  simpa [gammaPoleSecondSubprincipalBoundaryGerm] using
    gammaPoleScaleAndUnitDerivativeLaurentEval_injective.ne hboundary

/-- Symbolic principal and first-partial cancellations plus nonzero symbolic second boundary occur
together on an arbitrarily remote actual Gamma branch. -/
theorem exists_cofinal_gammaPoleSecondSubprincipalBoundary
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hcancel : gammaPolePrincipalReflectionSymbol (n + 1) P = 0)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0)
    (hboundary : gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0)
    (B : ℕ) :
    ∃ branch : ℕ, B ≤ branch ∧
      MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient branch (j : ℕ)) P = 0 ∧
      MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient branch (j : ℕ))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0 ∧
      gammaPoleSecondSubprincipalBoundary branch n P ≠ 0 := by
  have hcancelGerm : gammaPolePrincipalReflectionGerm (n + 1) P = 0 := by
    change gammaPoleScaleAndUnitDerivativeLaurentEval
      (gammaPolePrincipalReflectionSymbol (n + 1) P) = 0
    rw [hcancel, map_zero]
  rw [gammaPolePrincipalReflectionGerm_eq_sequence] at hcancelGerm
  have hcancelEventually : ∀ᶠ N : ℕ in Filter.atTop,
      MvPolynomial.eval
        (fun j : Fin (n + 2) =>
          gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ)) P = 0 := by
    rw [← Filter.Germ.coe_zero, Filter.Germ.coe_eq] at hcancelGerm
    exact hcancelGerm
  have hpartialGerm : gammaPolePrincipalReflectionGerm (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0 := by
    change gammaPoleScaleAndUnitDerivativeLaurentEval
      (gammaPolePrincipalReflectionSymbol (n + 1)
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) = 0
    rw [hpartial, map_zero]
  rw [gammaPolePrincipalReflectionGerm_eq_sequence] at hpartialGerm
  have hpartialEventually : ∀ᶠ N : ℕ in Filter.atTop,
      MvPolynomial.eval
        (fun j : Fin (n + 2) =>
          gammaPoleJetPrincipalCoefficient (N - 1) (j : ℕ))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0 := by
    rw [← Filter.Germ.coe_zero, Filter.Germ.coe_eq] at hpartialGerm
    exact hpartialGerm
  obtain ⟨C0, hC0⟩ := Filter.eventually_atTop.1 hcancelEventually
  obtain ⟨C1, hC1⟩ := Filter.eventually_atTop.1 hpartialEventually
  have hboundaryGerm :=
    gammaPoleSecondSubprincipalBoundaryGerm_ne_zero n P hboundary
  let C := max (B + 1) (max C0 C1)
  have hdetect : ∃ N : ℕ, C ≤ N ∧
      gammaPoleSecondSubprincipalBoundary (N - 1) n P ≠ 0 := by
    by_contra hdetect
    simp only [not_exists, not_and, not_not] at hdetect
    apply hboundaryGerm
    rw [gammaPoleSecondSubprincipalBoundaryGerm_eq_sequence,
      ← Filter.Germ.coe_zero, Filter.Germ.coe_eq]
    exact Filter.eventually_atTop.2 ⟨C, fun N hN => hdetect N hN⟩
  obtain ⟨N, hN, hboundaryN⟩ := hdetect
  have hBN : B ≤ N - 1 := by
    have : B + 1 ≤ N := le_trans (le_max_left _ _) hN
    omega
  have hC0N : C0 ≤ N := by
    exact le_trans (le_trans (le_max_left C0 C1) (le_max_right (B + 1) _)) hN
  have hC1N : C1 ≤ N := by
    exact le_trans (le_trans (le_max_right C0 C1) (le_max_right (B + 1) _)) hN
  exact ⟨N - 1, hBN, hC0 N hC0N, hC1 N hC1N, hboundaryN⟩

/-- Cofinal exact second-subprincipal order, simultaneously for covariant and native Gamma
packets. -/
theorem exists_cofinal_meromorphicOrderAt_gammaWeightedJetEval_of_secondSubprincipal
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) {W : ℕ}
    (hP : P.IsWeightedHomogeneous (bellJetWeight (n + 2)) W)
    (hW : 2 ≤ W)
    (hcancel : gammaPolePrincipalReflectionSymbol (n + 1) P = 0)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0)
    (hboundary : gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0)
    (B : ℕ) :
    ∃ branch : ℕ, B ≤ branch ∧
      meromorphicOrderAt (gammaPoleWeightedJetEval branch (n + 1) P) 0 =
        ((-((W - 2 : ℕ) : ℤ) : ℤ) : WithTop ℤ) ∧
      meromorphicOrderAt (gammaAffineWeightedJetEval branch (n + 1) P) 0 =
        ((-((W - 2 : ℕ) : ℤ) : ℤ) : WithTop ℤ) := by
  obtain ⟨branch, hbranch, hcancelBranch, hpartialBranch, hboundaryBranch⟩ :=
    exists_cofinal_gammaPoleSecondSubprincipalBoundary
      n P hcancel hpartial hboundary B
  have hfirstBranch :
      MvPolynomial.eval
          (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient branch (j : ℕ))
          (MvPolynomial.pderiv (0 : Fin (n + 2)) P) *
        gammaPoleJetRegularRemainder branch 0 0 = 0 := by
    rw [hpartialBranch, zero_mul]
  exact ⟨branch, hbranch,
    meromorphicOrderAt_gammaPoleWeightedJetEval_of_secondSubprincipal
      branch n P hP hW hcancelBranch hfirstBranch hboundaryBranch,
    meromorphicOrderAt_gammaAffineWeightedJetEval_of_secondSubprincipal
      branch n P hP hW hcancelBranch hfirstBranch hboundaryBranch⟩

/-! ## Exact nonvanishing classification of the two surviving channels -/

/-- Laurent polynomials retaining only the physical-scale coordinate. -/
abbrev GammaPolePureScaleSymbolic := LaurentPolynomial GammaPoleRationalBase

/-- Specialize every positive unit-derivative variable while preserving the Laurent scale. -/
def gammaPoleUnitDerivativeSpecialize
    (g : ℕ → GammaPoleRationalBase) :
    GammaPoleScaleDerivativeSymbolic →+* GammaPolePureScaleSymbolic :=
  AddMonoidAlgebra.mapRingHom ℤ
    (MvPolynomial.eval₂Hom (RingHom.id GammaPoleRationalBase) g)

/-- Re-include a pure-scale Laurent polynomial as one with constant derivative coefficients. -/
def gammaPolePureScaleInclude :
    GammaPolePureScaleSymbolic →+* GammaPoleScaleDerivativeSymbolic :=
  AddMonoidAlgebra.mapRingHom ℤ MvPolynomial.C

@[simp] theorem gammaPoleUnitDerivativeSpecialize_C
    (g : ℕ → GammaPoleRationalBase)
    (p : MvPolynomial ℕ GammaPoleRationalBase) :
    gammaPoleUnitDerivativeSpecialize g (LaurentPolynomial.C p) =
      LaurentPolynomial.C
        (MvPolynomial.eval₂ (RingHom.id GammaPoleRationalBase) g p) := by
  change (AddMonoidAlgebra.mapRingHom ℤ
      (MvPolynomial.eval₂Hom (RingHom.id GammaPoleRationalBase) g))
      (AddMonoidAlgebra.single 0 p) = _
  rw [AddMonoidAlgebra.mapRingHom_single]
  rfl

@[simp] theorem gammaPolePureScaleInclude_C (r : GammaPoleRationalBase) :
    gammaPolePureScaleInclude (LaurentPolynomial.C r) =
      LaurentPolynomial.C (MvPolynomial.C r) := by
  change (AddMonoidAlgebra.mapRingHom ℤ MvPolynomial.C)
      (AddMonoidAlgebra.single 0 r) = _
  rw [AddMonoidAlgebra.mapRingHom_single]
  rfl

@[simp] theorem gammaPoleUnitDerivativeSpecialize_T
    (g : ℕ → GammaPoleRationalBase) (k : ℤ) :
    gammaPoleUnitDerivativeSpecialize g (LaurentPolynomial.T k) =
      LaurentPolynomial.T k := by
  change (AddMonoidAlgebra.mapRingHom ℤ
      (MvPolynomial.eval₂Hom (RingHom.id GammaPoleRationalBase) g))
      (AddMonoidAlgebra.single k 1) = AddMonoidAlgebra.single k 1
  rw [AddMonoidAlgebra.mapRingHom_single, map_one]

@[simp] theorem gammaPolePureScaleInclude_T (k : ℤ) :
    gammaPolePureScaleInclude (LaurentPolynomial.T k) =
      LaurentPolynomial.T k := by
  change (AddMonoidAlgebra.mapRingHom ℤ MvPolynomial.C)
      (AddMonoidAlgebra.single k 1) = AddMonoidAlgebra.single k 1
  rw [AddMonoidAlgebra.mapRingHom_single, map_one]

/-- Principal reflections contain no positive unit-derivative variables, so every derivative
specialization has the pure-scale inclusion as a left inverse on them. -/
theorem gammaPolePureScaleInclude_specialize_principalReflection
    (g : ℕ → GammaPoleRationalBase) (n : ℕ)
    (P : MvPolynomial (Fin (n + 1)) ℂ) :
    gammaPolePureScaleInclude
        (gammaPoleUnitDerivativeSpecialize g
          (gammaPolePrincipalReflectionSymbol n P)) =
      gammaPolePrincipalReflectionSymbol n P := by
  have hhom :
      gammaPolePureScaleInclude.comp
          ((gammaPoleUnitDerivativeSpecialize g).comp
            (gammaPolePrincipalReflectionSymbol n)) =
        gammaPolePrincipalReflectionSymbol n := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, gammaPolePrincipalReflectionSymbol,
        MvPolynomial.eval₂Hom_C]
      change gammaPolePureScaleInclude
          (gammaPoleUnitDerivativeSpecialize g
            (LaurentPolynomial.C (MvPolynomial.C (RatFunc.C c)))) = _
      rw [gammaPoleUnitDerivativeSpecialize_C, MvPolynomial.eval₂_C,
        RingHom.id_apply, gammaPolePureScaleInclude_C]
      rfl
    · intro j
      simp only [RingHom.comp_apply, gammaPolePrincipalReflectionSymbol,
        MvPolynomial.eval₂Hom_X']
      rw [gammaPoleSymbolicDerivativeLaurentProfile_coeff_top]
      simp only [gammaPoleSymbolicDerivativeScale,
        gammaPoleComplexScaleDerivativeInclude,
        gammaPoleRationalScaleDerivativeInclude, RingHom.comp_apply,
        map_mul, map_neg, map_pow, map_one,
        gammaPoleUnitDerivativeSpecialize_C,
        gammaPoleUnitDerivativeSpecialize_T,
        gammaPolePureScaleInclude_C, gammaPolePureScaleInclude_T,
        MvPolynomial.eval₂_C, RingHom.id_apply]
  exact RingHom.congr_fun hhom P

/-- Specializing positive derivative variables cannot kill a nonzero principal reflection. -/
theorem gammaPoleUnitDerivativeSpecialize_principalReflection_ne_zero
    (g : ℕ → GammaPoleRationalBase) (n : ℕ)
    (P : MvPolynomial (Fin (n + 1)) ℂ)
    (hP : gammaPolePrincipalReflectionSymbol n P ≠ 0) :
    gammaPoleUnitDerivativeSpecialize g
        (gammaPolePrincipalReflectionSymbol n P) ≠ 0 := by
  intro hzero
  apply hP
  rw [← gammaPolePureScaleInclude_specialize_principalReflection g n P,
    hzero, map_zero]

/-- Specialization selecting only the second positive derivative of the regular pole unit. -/
def gammaPoleFirstPositiveDerivativeSelector : ℕ → GammaPoleRationalBase :=
  fun k => if k = 1 then 1 else 0

/-- Specialization selecting only the first positive derivative, hence the finite-part channel. -/
def gammaPoleFinitePartSelector : ℕ → GammaPoleRationalBase :=
  fun k => if k = 0 then 1 else 0

/-- After first-partial cancellation, selecting `X₁` isolates the first-jet channel. -/
theorem specialize_gammaPoleSecondSubprincipalBoundarySymbol_firstJet
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0) :
    gammaPoleUnitDerivativeSpecialize gammaPoleFirstPositiveDerivativeSelector
        (gammaPoleSecondSubprincipalBoundarySymbol n P) =
      gammaPoleUnitDerivativeSpecialize gammaPoleFirstPositiveDerivativeSelector
          (gammaPolePrincipalReflectionSymbol (n + 1)
            (MvPolynomial.pderiv (1 : Fin (n + 2)) P)) *
        (LaurentPolynomial.T (-1) *
          LaurentPolynomial.C (RatFunc.C (2 : ℂ)⁻¹)) := by
  simp [gammaPoleSecondSubprincipalBoundarySymbol, hpartial,
    gammaPoleBaseRemainderDerivativeSymbol,
    gammaPoleFirstJetRemainderSymbol,
    gammaPoleFirstPositiveDerivativeSelector,
    gammaPoleComplexScaleDerivativeInclude,
    gammaPoleRationalScaleDerivativeInclude]

/-- Selecting `X₀` isolates the Hessian channel of the complete second boundary. -/
theorem specialize_gammaPoleSecondSubprincipalBoundarySymbol_hessian
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) :
    gammaPoleUnitDerivativeSpecialize gammaPoleFinitePartSelector
        (gammaPoleSecondSubprincipalBoundarySymbol n P) =
      LaurentPolynomial.C (RatFunc.C (2 : ℂ)⁻¹) *
        gammaPoleUnitDerivativeSpecialize gammaPoleFinitePartSelector
          (gammaPolePrincipalReflectionSymbol (n + 1)
            (MvPolynomial.pderiv (0 : Fin (n + 2))
              (MvPolynomial.pderiv (0 : Fin (n + 2)) P))) := by
  simp [gammaPoleSecondSubprincipalBoundarySymbol,
    gammaPoleBaseRemainderDerivativeSymbol,
    gammaPoleFirstJetRemainderSymbol,
    gammaPoleFinitePartSelector,
    gammaPoleComplexScaleDerivativeInclude,
    gammaPoleRationalScaleDerivativeInclude]

/-- A nonzero first-jet principal reflection forces a nonzero complete second boundary once the
first partial has canceled. -/
theorem gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_of_firstJet
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0)
    (hfirst : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (1 : Fin (n + 2)) P) ≠ 0) :
    gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0 := by
  intro hzero
  have hspecialized := congrArg
    (gammaPoleUnitDerivativeSpecialize gammaPoleFirstPositiveDerivativeSelector) hzero
  rw [specialize_gammaPoleSecondSubprincipalBoundarySymbol_firstJet n P hpartial,
    map_zero] at hspecialized
  have hfirstSpecialized :=
    gammaPoleUnitDerivativeSpecialize_principalReflection_ne_zero
      gammaPoleFirstPositiveDerivativeSelector (n + 1)
        (MvPolynomial.pderiv (1 : Fin (n + 2)) P) hfirst
  have hfactor :
      (LaurentPolynomial.T (-1) *
        LaurentPolynomial.C (RatFunc.C (2 : ℂ)⁻¹) :
          GammaPolePureScaleSymbolic) ≠ 0 :=
    mul_ne_zero (LaurentPolynomial.isUnit_T (-1)).ne_zero (by norm_num)
  exact (mul_ne_zero hfirstSpecialized hfactor) hspecialized

/-- A nonzero repeated-base partial reflection forces a nonzero complete second boundary. -/
theorem gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_of_hessian
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hhessian : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) ≠ 0) :
    gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0 := by
  intro hzero
  have hspecialized := congrArg
    (gammaPoleUnitDerivativeSpecialize gammaPoleFinitePartSelector) hzero
  rw [specialize_gammaPoleSecondSubprincipalBoundarySymbol_hessian n P,
    map_zero] at hspecialized
  have hhessianSpecialized :=
    gammaPoleUnitDerivativeSpecialize_principalReflection_ne_zero
      gammaPoleFinitePartSelector (n + 1)
        (MvPolynomial.pderiv (0 : Fin (n + 2))
          (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) hhessian
  exact (mul_ne_zero (by norm_num) hhessianSpecialized) hspecialized

/-- **Exact two-channel classification.**  After first-partial cancellation, the complete second
boundary is nonzero exactly when its first-jet or Hessian principal reflection survives. -/
theorem gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_iff_channels
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0) :
    gammaPoleSecondSubprincipalBoundarySymbol n P ≠ 0 ↔
      gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (1 : Fin (n + 2)) P) ≠ 0 ∨
        gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) ≠ 0 := by
  constructor
  · intro hboundary
    by_contra hchannels
    simp only [not_or, not_ne_iff] at hchannels
    apply hboundary
    simp [gammaPoleSecondSubprincipalBoundarySymbol, hpartial,
      hchannels.1, hchannels.2]
  · rintro (hfirst | hhessian)
    · exact gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_of_firstJet
        n P hpartial hfirst
    · exact gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_of_hessian
        n P hhessian

/-- Exact channel survival supplies the common cofinal second-subprincipal branch. -/
theorem exists_cofinal_gammaPoleSecondSubprincipalBoundary_of_channels
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ)
    (hcancel : gammaPolePrincipalReflectionSymbol (n + 1) P = 0)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0)
    (hchannels :
      gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (1 : Fin (n + 2)) P) ≠ 0 ∨
        gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) ≠ 0)
    (B : ℕ) :
    ∃ branch : ℕ, B ≤ branch ∧
      MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient branch (j : ℕ)) P = 0 ∧
      MvPolynomial.eval
        (fun j : Fin (n + 2) => gammaPoleJetPrincipalCoefficient branch (j : ℕ))
        (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0 ∧
      gammaPoleSecondSubprincipalBoundary branch n P ≠ 0 := by
  exact exists_cofinal_gammaPoleSecondSubprincipalBoundary n P hcancel hpartial
    ((gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_iff_channels n P hpartial).2
      hchannels) B

/-- Cofinal exact second-subprincipal order with the opaque boundary hypothesis replaced by the
two intrinsic principal-reflection channels. -/
theorem exists_cofinal_meromorphicOrderAt_gammaWeightedJetEval_of_secondSubprincipal_channels
    (n : ℕ) (P : MvPolynomial (Fin (n + 2)) ℂ) {W : ℕ}
    (hP : P.IsWeightedHomogeneous (bellJetWeight (n + 2)) W)
    (hW : 2 ≤ W)
    (hcancel : gammaPolePrincipalReflectionSymbol (n + 1) P = 0)
    (hpartial : gammaPolePrincipalReflectionSymbol (n + 1)
      (MvPolynomial.pderiv (0 : Fin (n + 2)) P) = 0)
    (hchannels :
      gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (1 : Fin (n + 2)) P) ≠ 0 ∨
        gammaPolePrincipalReflectionSymbol (n + 1)
          (MvPolynomial.pderiv (0 : Fin (n + 2))
            (MvPolynomial.pderiv (0 : Fin (n + 2)) P)) ≠ 0)
    (B : ℕ) :
    ∃ branch : ℕ, B ≤ branch ∧
      meromorphicOrderAt (gammaPoleWeightedJetEval branch (n + 1) P) 0 =
        ((-((W - 2 : ℕ) : ℤ) : ℤ) : WithTop ℤ) ∧
      meromorphicOrderAt (gammaAffineWeightedJetEval branch (n + 1) P) 0 =
        ((-((W - 2 : ℕ) : ℤ) : ℤ) : WithTop ℤ) := by
  exact exists_cofinal_meromorphicOrderAt_gammaWeightedJetEval_of_secondSubprincipal
    n P hP hW hcancel hpartial
      ((gammaPoleSecondSubprincipalBoundarySymbol_ne_zero_iff_channels n P hpartial).2
        hchannels) B

end

