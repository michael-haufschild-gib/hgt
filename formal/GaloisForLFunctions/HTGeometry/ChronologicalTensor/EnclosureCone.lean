import GaloisForLFunctions.HTGeometry.ChronologicalTensor.OneEnclosure
import GaloisForLFunctions.HTGeometry.ChronologicalTensor.DegreeSealing

/-!
# A coefficient cone with exact one-enclosure stabilization

The family A·separated − B·rainbow with 0 ≤ A ≤ 27B has monotone and
positive-depth enclosed capacity B. Parameters are generated by an absolute
scale and a clamped coefficient, so all statements are unconditional.
The corner 27·separated − rainbow has minimal enclosure depth exactly one.
-/

namespace GaloisForLFunctions.HTGeometry.ChronologicalTensor
noncomputable section

def reversalConeCoefficients (s B : ℝ) : Fin 2 → ℝ :=
  ![27*unitMagnitude s*|B|,-|B|]

theorem one_enclosure_cone_bound (s B a b c d e : ℝ) :
    |(a+b+c+d+e)*weightedSixResponse (27*unitMagnitude s*|B|) (-|B|) a b c d e| ≤
      |B| * sixCost a b c d e ^ (4 : ℕ) := by
  let S := a+b+c+d+e
  let T := sixCost a b c d e
  let q := unitMagnitude s
  have hq := unitMagnitude_bounds s
  have hq0 : 0 ≤ q := hq.1
  have hq1 : q ≤ 1 := hq.2
  have hT : 0 ≤ T := by dsimp [T,sixCost]; positivity
  have hS : |S| ≤ T := by
    have h1 := abs_add_le a b
    have h2 := abs_add_le (a+b) c
    have h3 := abs_add_le (a+b+c) d
    have h4 := abs_add_le (a+b+c+d) e
    dsimp [S,T,sixCost]
    linarith only [h1,h2,h3,h4]
  have hR : |S*rainbowThree a b c d e| ≤ T^(4 : ℕ) := by
    rw [abs_mul]
    calc
      |S| * |rainbowThree a b c d e| ≤ T*T^(3 : ℕ) :=
        mul_le_mul hS (rainbow_bound a b c d e) (abs_nonneg _) hT
      _ = T^(4 : ℕ) := by ring
  have hP : |S*reversalResponse a b c d e| ≤ T^(4 : ℕ) := one_enclosure_reversal_bound a b c d e
  have hid : S*weightedSixResponse (27*q*|B|) (-|B|) a b c d e =
      |B| * (q*(S*reversalResponse a b c d e) - (1-q)*(S*rainbowThree a b c d e)) := by
    unfold weightedSixResponse reversalResponse
    ring
  change |S*weightedSixResponse (27*q*|B|) (-|B|) a b c d e| ≤ |B| * T^(4 : ℕ)
  rw [hid,abs_mul,abs_abs]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg B)
  have ht := abs_sub_le (q*(S*reversalResponse a b c d e)) 0 ((1-q)*(S*rainbowThree a b c d e))
  simp only [sub_zero,zero_sub,abs_neg,abs_mul,abs_of_nonneg hq0,
    abs_of_nonneg (sub_nonneg.mpr hq1)] at ht
  have h1 := mul_le_mul_of_nonneg_left hP hq0
  have h2 := mul_le_mul_of_nonneg_left hR (sub_nonneg.mpr hq1)
  simp only [abs_mul] at h1 h2
  nlinarith only [ht,h1,h2]

theorem reversalCone_sealed_one_le (s B : ℝ) :
    sealedCapacity sixWindows (reversalConeCoefficients s B) 1 ≤ |B| := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨g,rfl⟩
  dsimp only
  rw [pow_one]
  unfold reversalConeCoefficients
  rw [sixWindows_value]
  have h := one_enclosure_cone_bound s B ((normalizeProbe g) 0) ((normalizeProbe g) 1)
    ((normalizeProbe g) 2) ((normalizeProbe g) 3) ((normalizeProbe g) 4)
  have hd : displacement (normalizeProbe g) =
      (normalizeProbe g) 0+(normalizeProbe g) 1+(normalizeProbe g) 2+
      (normalizeProbe g) 3+(normalizeProbe g) 4 := by
    simp only [displacement,Fin.sum_univ_five]
  rw [hd]
  have hv := normalizeProbe_budget g
  rw [variation_six] at hv
  have hn : 0 ≤ sixCost ((normalizeProbe g) 0) ((normalizeProbe g) 1)
      ((normalizeProbe g) 2) ((normalizeProbe g) 3) ((normalizeProbe g) 4) := by
    unfold sixCost; positivity
  have hp := pow_le_pow_left₀ hn hv 4
  rw [one_pow] at hp
  exact h.trans ((mul_le_mul_of_nonneg_left hp (abs_nonneg B)).trans_eq (mul_one _))

theorem reversalCone_monotone_capacity (s B : ℝ) :
    monotoneCapacity sixWindows (reversalConeCoefficients s B) = |B| := by
  apply le_antisymm
  · exact (monotoneCapacity_le_sealed sixWindows (reversalConeCoefficients s B) 1).trans
      (reversalCone_sealed_one_le s B)
  · let g : Fin 5 → ℝ := ![0,0,1,0,0]
    have h := monotoneCapacity_probe_bound sixWindows (reversalConeCoefficients s B) g
    unfold reversalConeCoefficients at h ⊢
    rw [sixWindows_value] at h
    simpa [monotoneProbe,normalizeProbe,variation,Fin.sum_univ_five,g,
      weightedSixResponse,separatedThree,rainbowThree] using h

theorem reversalCone_sealed_capacity (s B : ℝ) (k : ℕ) :
    sealedCapacity sixWindows (reversalConeCoefficients s B) (1+k) = |B| := by
  apply le_antisymm
  · exact (sealedCapacity_add_depth sixWindows (reversalConeCoefficients s B) 1 k).trans
      (reversalCone_sealed_one_le s B)
  · rw [← reversalCone_monotone_capacity s B]
    exact monotoneCapacity_le_sealed sixWindows (reversalConeCoefficients s B) (1+k)

theorem sixWindows_reversal_sealed_one (k : ℕ) :
    sealedCapacity sixWindows ![27,-1] (1+k) = 1 := by
  have h := reversalCone_sealed_capacity 1 1 k
  simpa [reversalConeCoefficients,unitMagnitude] using h

theorem sixWindows_reversal_capacity_gt_one : 1 < familyCapacity sixWindows ![27,-1] := by
  let g : Fin 5 → ℝ := ![1/3,0,-1/3,0,1/3]
  have hv : variation g = 1 := by
    rw [variation_six]
    exact reversal_advantage_witness.1
  have hn : normalizeProbe g = g := (normalizeProbe_fixed_iff g).mpr (le_of_eq hv)
  have hb := familyCapacity_probe_bound sixWindows (![27,-1] : Fin 2 → ℝ) g
  rw [hn,sixWindows_reversal_value] at hb
  exact reversal_advantage_witness.2.2.trans_le hb

theorem sixWindows_reversal_exact_depth (k : ℕ) :
    sealedCapacity sixWindows ![27,-1] k = 1 ↔ 1 ≤ k := by
  cases k with
  | zero =>
    have h := sixWindows_reversal_capacity_gt_one
    have he : sealedCapacity sixWindows ![27,-1] 0 = familyCapacity sixWindows ![27,-1] := by
      simp only [sealedCapacity,familyCapacity,pow_zero,one_mul]
    rw [he]
    constructor
    · intro hEq; linarith
    · intro hk; omega
  | succ k =>
    constructor
    · intro _; omega
    · intro _
      simpa only [Nat.add_comm 1 k] using sixWindows_reversal_sealed_one k

end
end GaloisForLFunctions.HTGeometry.ChronologicalTensor
