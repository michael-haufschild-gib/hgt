import GaloisForLFunctions.HTGeometry.ChronologicalTensor.CubicRepairPower
import GaloisForLFunctions.HTGeometry.ChronologicalTensor.CubicCuspFlow
import Mathlib.RingTheory.Ideal.MonicSpan

/-!
# A single half-retraction forces discrete repair ideals

Every ideal preserved by half-scaling is either zero or generated by a power
of the first-mode coordinate. A monic generator must be its own sole degree
component, because half-scaling has distinct weights on different powers.
Consequently preservation under one half-scaling implies preservation under
every real scaling. No sampling or computational certificate is used.
-/

namespace GaloisForLFunctions.HTGeometry.ChronologicalTensor
noncomputable section
open Set Polynomial


theorem cubicInnerPolynomialFlow_comp (q : ℝ) (p : Polynomial ℝ) :
    cubicInnerPolynomialFlow q p=p.comp (Polynomial.C q*Polynomial.X) := rfl

theorem cubicInnerPolynomialFlow_coefficient (q : ℝ) (p : Polynomial ℝ) (n : ℕ) :
    (cubicInnerPolynomialFlow q p).coeff n=p.coeff n*q^n := by
  rw [cubicInnerPolynomialFlow_comp,Polynomial.comp_C_mul_X_coeff]

theorem cubicInnerPolynomialFlow_degree (q : ℝ) (p : Polynomial ℝ) :
    (cubicInnerPolynomialFlow q p).natDegree ≤ p.natDegree := by
  rw [cubicInnerPolynomialFlow_comp]
  have hq : (Polynomial.C q*Polynomial.X : Polynomial ℝ).natDegree ≤ 1 := by
    simpa only [pow_one] using Polynomial.natDegree_C_mul_X_pow_le q 1
  exact Polynomial.natDegree_comp_le.trans ((Nat.mul_le_mul_left p.natDegree hq).trans_eq (mul_one _))

def cubicHalfStableIdeals : Set (Ideal (Polynomial ℝ)) :=
  {I | MapsTo (cubicInnerPolynomialFlow (1/2)) I I}

theorem cubicRepairPowerIdeal_flow (q : ℝ) (k : ℕ) :
    MapsTo (cubicInnerPolynomialFlow q) (cubicRepairPowerIdeal k) (cubicRepairPowerIdeal k) := by
  intro p hp
  change cubicInnerPolynomialFlow q p ∈ cubicRepairPowerIdeal k
  change p ∈ cubicRepairPowerIdeal k at hp
  rw [cubicRepairPowerIdeal_mem] at hp ⊢
  intro n hn
  rw [cubicInnerPolynomialFlow_coefficient,hp n hn,zero_mul]

theorem cubicHalfStableIdeals_classification (I : Ideal (Polynomial ℝ)) :
    I ∈ cubicHalfStableIdeals ↔ I=⊥ ∨ ∃ k : ℕ, I=cubicRepairPowerIdeal k := by
  constructor
  · intro hI
    by_cases hz : I=⊥
    · exact Or.inl hz
    right
    obtain ⟨p,hp,hspan⟩ := Polynomial.exists_monic_span I hz
    have hm : p ∈ I := by rw [hspan]; exact Ideal.mem_span_singleton_self p
    have hflow := hI hm
    change cubicInnerPolynomialFlow (1/2) p ∈ I at hflow
    rw [hspan,Ideal.mem_span_singleton] at hflow
    have he := Polynomial.eq_leadingCoeff_mul_of_monic_of_dvd_of_natDegree_le hp hflow
      (cubicInnerPolynomialFlow_degree (1/2) p)
    have hl := congrArg (fun r : Polynomial ℝ => r.coeff p.natDegree) he
    rw [cubicInnerPolynomialFlow_coefficient,Polynomial.coeff_C_mul,
      Polynomial.coeff_natDegree,hp.leadingCoeff,one_mul,mul_one] at hl
    have heigen : p=Polynomial.X^p.natDegree := by
      ext n
      by_cases hn : n=p.natDegree
      · subst n
        simp [Polynomial.coeff_natDegree,hp.leadingCoeff]
      have hc := congrArg (fun r : Polynomial ℝ => r.coeff n) he
      rw [cubicInnerPolynomialFlow_coefficient,Polynomial.coeff_C_mul,← hl] at hc
      have hpow : (1/2 : ℝ)^n ≠ (1/2 : ℝ)^p.natDegree := by
        intro heq
        exact hn (pow_right_injective₀ (by positivity : (0:ℝ)<1/2) (by linarith : (1/2:ℝ)≠1) heq)
      have hprod : p.coeff n*((1/2 : ℝ)^n-(1/2 : ℝ)^p.natDegree)=0 := by linear_combination hc
      have hc0 : p.coeff n=0 := (mul_eq_zero.mp hprod).resolve_right (sub_ne_zero.mpr hpow)
      simp [hc0,Polynomial.coeff_X_pow,hn]
    exact ⟨p.natDegree,hspan.trans (congrArg (fun r : Polynomial ℝ => Ideal.span {r}) heigen)⟩
  · rintro (rfl | ⟨k,rfl⟩)
    · intro p hp
      have hp0 : p=0 := hp
      simp [hp0]
    · exact cubicRepairPowerIdeal_flow (1/2) k

theorem cubicHalfStableIdeals_eq :
    cubicHalfStableIdeals={⊥} ∪ Set.range cubicRepairPowerIdeal := by
  ext I
  rw [cubicHalfStableIdeals_classification]
  simp only [Set.mem_union,Set.mem_singleton_iff,Set.mem_range]
  constructor
  · rintro (h | ⟨k,h⟩)
    · exact Or.inl h
    · exact Or.inr ⟨k,h.symm⟩
  · rintro (h | ⟨k,h⟩)
    · exact Or.inl h
    · exact Or.inr ⟨k,h.symm⟩

theorem cubicHalfStableIdeals_fullFlow :
    cubicHalfStableIdeals={I : Ideal (Polynomial ℝ) | ∀ q : ℝ, MapsTo (cubicInnerPolynomialFlow q) I I} := by
  ext I
  constructor
  · intro h
    rcases (cubicHalfStableIdeals_classification I).mp h with rfl | ⟨k,rfl⟩
    · intro q p hp
      have hp0 : p=0 := hp
      simp [hp0]
    · exact fun q => cubicRepairPowerIdeal_flow q k
  · intro h
    exact h (1/2)

end
end GaloisForLFunctions.HTGeometry.ChronologicalTensor
