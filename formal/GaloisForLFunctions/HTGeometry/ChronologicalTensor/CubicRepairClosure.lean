import GaloisForLFunctions.HTGeometry.ChronologicalTensor.CubicRepairClassification
import Mathlib.Algebra.Polynomial.Degree.TrailingDegree

/-!
# The least invariant repair generated by any polynomial observation

The repair is defined as the intersection of all half-stable intermediate
algebras containing the added observation. Its exact value depends only on the
first missing-gap coefficient and, when nonzero, its order of vanishing at zero.
The resulting algebra is invariant under the entire physical flow.
-/

namespace GaloisForLFunctions.HTGeometry.ChronologicalTensor
noncomputable section
open Set Polynomial


def cubicObservationRepairClosure (P : Polynomial (Polynomial ℝ)) :
    Subalgebra ℝ (Polynomial (Polynomial ℝ)) :=
  sInf {S | cubicCuspAlgebra ≤ S ∧ P ∈ S ∧ MapsTo (cubicPolynomialFlow (1/2)) S S}

theorem cubicObservationRepairClosure_eq (P : Polynomial (Polynomial ℝ)) :
    cubicObservationRepairClosure P=
      if P.coeff 1=0 then cubicCuspAlgebra
      else cubicFiniteRepairAlgebra (P.coeff 1).natTrailingDegree := by
  by_cases hz : P.coeff 1=0
  · rw [if_pos hz]
    apply le_antisymm
    · exact sInf_le ⟨le_rfl,hz,cubicPolynomialFlow_preservesCusp (1/2)⟩
    · apply le_sInf
      intro S hS
      exact hS.1
  · rw [if_neg hz]
    apply le_antisymm
    · apply sInf_le
      refine ⟨cubicFiniteRepairAlgebra_contains _,?_,cubicFiniteRepairAlgebra_flow (1/2) _⟩
      rw [cubicFiniteRepairAlgebra_mem]
      intro n hn
      exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hn
    · apply le_sInf
      rintro S ⟨hA,hP,hflow⟩
      have hstable : (⟨S,hA⟩ : Ici cubicCuspAlgebra) ∈ cubicHalfStableRepairAlgebras := hflow
      rcases (cubicHalfStableRepairAlgebras_classification ⟨S,hA⟩).mp hstable with hS | ⟨j,hj⟩
      · change S=cubicCuspAlgebra at hS
        rw [hS,cubicCuspAlgebra_mem] at hP
        exact False.elim (hz hP)
      · change S=cubicFiniteRepairAlgebra j at hj
        rw [hj,cubicFiniteRepairAlgebra_mem] at hP
        have hjle : j ≤ (P.coeff 1).natTrailingDegree := by
          by_contra h
          exact (Polynomial.coeff_natTrailingDegree_ne_zero.mpr hz)
            (hP _ (lt_of_not_ge h))
        rw [hj]
        exact cubicFiniteRepairAlgebra_antitone hjle

theorem cubicObservationRepairClosure_contains (P : Polynomial (Polynomial ℝ)) :
    cubicCuspAlgebra ≤ cubicObservationRepairClosure P := by
  apply le_sInf
  intro S hS
  exact hS.1

theorem cubicObservationRepairClosure_mem (P : Polynomial (Polynomial ℝ)) :
    P ∈ cubicObservationRepairClosure P := by
  rw [cubicObservationRepairClosure_eq]
  split_ifs with hz
  · exact hz
  · rw [cubicFiniteRepairAlgebra_mem]
    intro n hn
    exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hn

theorem cubicObservationRepairClosure_flow (P : Polynomial (Polynomial ℝ)) (q : ℝ) :
    MapsTo (cubicPolynomialFlow q) (cubicObservationRepairClosure P)
      (cubicObservationRepairClosure P) := by
  rw [cubicObservationRepairClosure_eq]
  split_ifs
  · exact cubicPolynomialFlow_preservesCusp q
  · exact cubicFiniteRepairAlgebra_flow q _

theorem cubicObservationRepairClosure_le_iff (P : Polynomial (Polynomial ℝ))
    (S : Ici cubicCuspAlgebra) :
    S ∈ cubicHalfStableRepairAlgebras →
      (cubicObservationRepairClosure P ≤ S.val ↔ P ∈ S.val) := by
  intro hS
  constructor
  · intro h
    exact h (cubicObservationRepairClosure_mem P)
  · intro hP
    exact sInf_le ⟨S.property,hP,hS⟩

theorem cubicObservationRepairClosure_remainder (P : Polynomial (Polynomial ℝ)) :
    cubicObservationRepairClosure P=
      cubicObservationRepairClosure (Polynomial.C (P.coeff 1)*Polynomial.X) := by
  rw [cubicObservationRepairClosure_eq,cubicObservationRepairClosure_eq,
    Polynomial.C_mul_X_eq_monomial,Polynomial.coeff_monomial_same]

end
end GaloisForLFunctions.HTGeometry.ChronologicalTensor
