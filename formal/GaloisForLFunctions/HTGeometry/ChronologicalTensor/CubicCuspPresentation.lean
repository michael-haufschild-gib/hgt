import GaloisForLFunctions.HTGeometry.ChronologicalTensor.CubicCuspNormalization

/-!
# The literal ideal presentation of the cusp observation algebra

The observation algebra `A = ℝ[u, c², c³]` is presented by the single relation `W² = V³` on
weighted generators of degrees 1, 2, 3. Concretely, the `ℝ`-algebra map

  `ℝ[U][V][W] → ℝ[u][c]`,  `U ↦ u`, `V ↦ c²`, `W ↦ c³`

has range exactly `cubicCuspAlgebra` and kernel exactly the principal ideal generated by
`W² − V³`, so it induces an isomorphism `ℝ[U][V][W]/(W²−V³) ≅ A`.

Injectivity is not the mere vanishing of a relation: division by the `W`-monic `W² − V³` leaves a
remainder `P(U,V) + W·Q(U,V)`, whose image has only even `c`-exponents in the first part and only
odd `c`-exponents at least three in the second, so both parts vanish separately.
-/

namespace GaloisForLFunctions.HTGeometry.ChronologicalTensor

noncomputable section
open Polynomial

/-! ### The two-generator evaluation `U ↦ u`, `V ↦ c²` -/

/-- Evaluation of `ℝ[U][V]` at `U ↦ u`, `V ↦ c²`. -/
def cuspMidHom : Polynomial (Polynomial ℝ) →ₐ[ℝ] Polynomial (Polynomial ℝ) :=
  Polynomial.aevalTower (IsScalarTower.toAlgHom ℝ (Polynomial ℝ) (Polynomial (Polynomial ℝ)))
    (Polynomial.X ^ 2)

theorem cuspMidHom_C (a : Polynomial ℝ) : cuspMidHom (Polynomial.C a) = Polynomial.C a := by
  have h := Polynomial.aevalTower_comp_C
    (IsScalarTower.toAlgHom ℝ (Polynomial ℝ) (Polynomial (Polynomial ℝ))) (Polynomial.X ^ 2)
  have h2 := RingHom.congr_fun h a
  simp [cuspMidHom, Polynomial.algebraMap_eq] at h2 ⊢

theorem cuspMidHom_X : cuspMidHom Polynomial.X = Polynomial.X ^ 2 :=
  Polynomial.aevalTower_X _ _

theorem cuspMidHom_monomial (n : ℕ) (a : Polynomial ℝ) :
    cuspMidHom (Polynomial.monomial n a) = Polynomial.C a * Polynomial.X ^ (2*n) := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, cuspMidHom_C, cuspMidHom_X,
    ← pow_mul]

theorem cuspMidHom_coeff (a : Polynomial (Polynomial ℝ)) (n : ℕ) :
    (cuspMidHom a).coeff n = if 2 ∣ n then a.coeff (n/2) else 0 := by
  induction a using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [map_add, Polynomial.coeff_add, hp, hq, Polynomial.coeff_add]
    split_ifs <;> ring
  | monomial m b =>
    rw [cuspMidHom_monomial, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_monomial]
    by_cases h2 : 2 ∣ n
    · obtain ⟨j, rfl⟩ := h2
      rw [if_pos (dvd_mul_right 2 j), show 2*j/2 = j from by omega]
      by_cases hj : m = j
      · rw [if_pos (by omega : 2*j = 2*m), if_pos hj, mul_one]
      · rw [if_neg (by omega : ¬ (2*j = 2*m)), if_neg hj, mul_zero]
    · rw [if_neg h2, if_neg (by omega : ¬ (n = 2*m)), mul_zero]

/-- The even and odd `c`-parts of an image cannot cancel. -/
theorem cuspMidHom_parity {a b : Polynomial (Polynomial ℝ)}
    (h : cuspMidHom a + cuspMidHom b * Polynomial.X ^ 3 = 0) : a = 0 ∧ b = 0 := by
  constructor
  · refine Polynomial.ext fun n => ?_
    have hc := congrArg (fun p : Polynomial (Polynomial ℝ) => p.coeff (2*n)) h
    simp only [Polynomial.coeff_add, Polynomial.coeff_zero, Polynomial.coeff_mul_X_pow',
      cuspMidHom_coeff] at hc
    rw [if_pos (dvd_mul_right 2 n), show 2*n/2 = n from by omega] at hc
    by_cases h3 : 3 ≤ 2*n
    · rw [if_pos h3, if_neg (by omega : ¬ (2 ∣ 2*n - 3))] at hc
      simpa using hc
    · rw [if_neg h3] at hc
      simpa using hc
  · refine Polynomial.ext fun n => ?_
    have hc := congrArg (fun p : Polynomial (Polynomial ℝ) => p.coeff (2*n+3)) h
    simp only [Polynomial.coeff_add, Polynomial.coeff_zero, Polynomial.coeff_mul_X_pow',
      cuspMidHom_coeff] at hc
    rw [if_neg (by omega : ¬ (2 ∣ 2*n+3)), if_pos (by omega : 3 ≤ 2*n+3),
      if_pos (by omega : 2 ∣ 2*n+3-3), show (2*n+3-3)/2 = n from by omega] at hc
    simpa using hc

/-! ### The three-generator evaluation and the cusp relation -/

/-- Evaluation of `ℝ[U][V][W]` at `U ↦ u`, `V ↦ c²`, `W ↦ c³`. -/
def cuspEvalHom : Polynomial (Polynomial (Polynomial ℝ)) →ₐ[ℝ] Polynomial (Polynomial ℝ) :=
  Polynomial.aevalTower cuspMidHom (Polynomial.X ^ 3)

theorem cuspEvalHom_C (a : Polynomial (Polynomial ℝ)) :
    cuspEvalHom (Polynomial.C a) = cuspMidHom a := by
  have h := Polynomial.aevalTower_comp_C cuspMidHom (Polynomial.X ^ 3)
  exact RingHom.congr_fun h a

theorem cuspEvalHom_X : cuspEvalHom Polynomial.X = Polynomial.X ^ 3 :=
  Polynomial.aevalTower_X _ _

theorem cuspEvalHom_monomial (n : ℕ) (a : Polynomial (Polynomial ℝ)) :
    cuspEvalHom (Polynomial.monomial n a) = cuspMidHom a * Polynomial.X ^ (3*n) := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, cuspEvalHom_C, cuspEvalHom_X,
    ← pow_mul]

/-- The cusp relation `W² − V³`. -/
def cuspRelation : Polynomial (Polynomial (Polynomial ℝ)) :=
  Polynomial.X ^ 2 - Polynomial.C (Polynomial.X ^ 3)

theorem cuspRelation_monic : cuspRelation.Monic :=
  Polynomial.monic_X_pow_sub_C _ (by norm_num)

theorem cuspRelation_degree : cuspRelation.degree = 2 := by
  rw [cuspRelation, Polynomial.degree_X_pow_sub_C (by norm_num)]
  norm_cast

theorem cuspEvalHom_relation : cuspEvalHom cuspRelation = 0 := by
  have h : cuspMidHom (Polynomial.X ^ 3) = (Polynomial.X : Polynomial (Polynomial ℝ)) ^ 6 := by
    rw [map_pow, cuspMidHom_X, ← pow_mul]
  unfold cuspRelation
  rw [map_sub cuspEvalHom, map_pow, cuspEvalHom_X, cuspEvalHom_C, h, ← pow_mul]
  norm_num

/-! ### The kernel is the principal ideal of the relation -/

theorem cuspEvalHom_ker :
    RingHom.ker cuspEvalHom.toRingHom = Ideal.span {cuspRelation} := by
  apply le_antisymm
  · intro p hp
    have hp0 : cuspEvalHom p = 0 := hp
    have hdiv : p %ₘ cuspRelation + cuspRelation * (p /ₘ cuspRelation) = p :=
      Polynomial.modByMonic_add_div p cuspRelation
    have hrdeg : (p %ₘ cuspRelation).degree < 2 := by
      have h := Polynomial.degree_modByMonic_lt p cuspRelation_monic
      rwa [cuspRelation_degree] at h
    have hr : (p %ₘ cuspRelation)
        = Polynomial.C ((p %ₘ cuspRelation).coeff 0)
          + Polynomial.C ((p %ₘ cuspRelation).coeff 1) * Polynomial.X := by
      refine Polynomial.ext fun n => ?_
      rcases n with _ | n
      · simp
      rcases n with _ | n
      · simp
      · have h1 : (p %ₘ cuspRelation).coeff (n+2) = 0 := by
          refine Polynomial.coeff_eq_zero_of_degree_lt (lt_of_lt_of_le hrdeg ?_)
          exact_mod_cast (by omega : (2:ℕ) ≤ n+2)
        rw [h1]
        simp
    have hev : cuspEvalHom (p %ₘ cuspRelation) = 0 := by
      have h := congrArg cuspEvalHom hdiv
      rw [map_add, map_mul, cuspEvalHom_relation, zero_mul, add_zero, hp0] at h
      exact h
    rw [hr, map_add, map_mul, cuspEvalHom_C, cuspEvalHom_C, cuspEvalHom_X] at hev
    obtain ⟨h0, h1⟩ := cuspMidHom_parity hev
    have hr0 : p %ₘ cuspRelation = 0 := by
      rw [hr, h0, h1]
      simp
    rw [hr0, zero_add] at hdiv
    rw [Ideal.mem_span_singleton']
    exact ⟨p /ₘ cuspRelation, by linear_combination hdiv⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact cuspEvalHom_relation

/-! ### The range is the cusp algebra -/

theorem cuspEvalHom_mem (p : Polynomial (Polynomial (Polynomial ℝ))) :
    cuspEvalHom p ∈ cubicCuspAlgebra := by
  rw [cubicCuspAlgebra_mem]
  induction p using Polynomial.induction_on' with
  | add q r hq hr => rw [map_add, Polynomial.coeff_add, hq, hr, add_zero]
  | monomial m a =>
    rw [cuspEvalHom_monomial, Polynomial.coeff_mul_X_pow']
    by_cases h : 3*m ≤ 1
    · have hm : m = 0 := by omega
      subst hm
      rw [if_pos (by omega), cuspMidHom_coeff, if_neg (by omega : ¬ (2 ∣ 1 - 3*0))]
    · rw [if_neg h]

/-- An explicit preimage of a monomial of admissible degree. -/
def cuspLift (b : Polynomial ℝ) (n : ℕ) : Polynomial (Polynomial (Polynomial ℝ)) :=
  Polynomial.C (Polynomial.C b) * Polynomial.C Polynomial.X ^ ((n - 3*(n % 2))/2)
    * Polynomial.X ^ (n % 2)

theorem cuspEvalHom_cuspLift (b : Polynomial ℝ) {n : ℕ} (hn : n ≠ 1) :
    cuspEvalHom (cuspLift b n) = Polynomial.C b * Polynomial.X ^ n := by
  have hkey : 2 * ((n - 3*(n % 2))/2) + 3*(n % 2) = n := by omega
  rw [cuspLift, map_mul, map_mul, map_pow, map_pow, cuspEvalHom_C, cuspEvalHom_C, cuspEvalHom_X,
    cuspMidHom_C, cuspMidHom_X, ← pow_mul, ← pow_mul, mul_assoc, ← pow_add, hkey]

theorem cuspEvalHom_surjective_onto (P : Polynomial (Polynomial ℝ)) (hP : P ∈ cubicCuspAlgebra) :
    ∃ p, cuspEvalHom p = P := by
  classical
  refine ⟨∑ n ∈ P.support, cuspLift (P.coeff n) n, ?_⟩
  rw [map_sum]
  have h : ∀ n ∈ P.support, cuspEvalHom (cuspLift (P.coeff n) n)
      = Polynomial.C (P.coeff n) * Polynomial.X ^ n := by
    intro n hn
    refine cuspEvalHom_cuspLift _ ?_
    intro h1
    subst h1
    rw [Polynomial.mem_support_iff] at hn
    exact hn ((cubicCuspAlgebra_mem P).mp hP)
  rw [Finset.sum_congr rfl h]
  exact (Polynomial.as_sum_support_C_mul_X_pow P).symm

/-- **The range of the three-generator evaluation is the cusp observation algebra.** -/
theorem cuspEvalHom_range : cuspEvalHom.range = cubicCuspAlgebra := by
  apply le_antisymm
  · rintro x ⟨p, rfl⟩
    exact cuspEvalHom_mem p
  · intro P hP
    obtain ⟨p, hp⟩ := cuspEvalHom_surjective_onto P hP
    exact ⟨p, hp⟩

/-! ### The presentation -/

/-- The evaluation corestricted to the cusp observation algebra. -/
def cuspEvalRestrict : Polynomial (Polynomial (Polynomial ℝ)) →ₐ[ℝ] cubicCuspAlgebra :=
  cuspEvalHom.codRestrict cubicCuspAlgebra cuspEvalHom_mem

theorem cuspEvalRestrict_surjective : Function.Surjective cuspEvalRestrict := by
  intro y
  obtain ⟨p, hp⟩ := cuspEvalHom_surjective_onto y.val y.property
  exact ⟨p, Subtype.ext hp⟩

theorem cuspEvalRestrict_ker : RingHom.ker cuspEvalRestrict = Ideal.span {cuspRelation} := by
  rw [← cuspEvalHom_ker]
  ext p
  simp only [RingHom.mem_ker]
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

/-- **No further relations.** A remainder in normal form `P(U,V) + W·Q(U,V)` maps to zero only if
both parts vanish: the relation `W² = V³` generates every relation. -/
theorem cuspEvalHom_normalForm_injective (a b : Polynomial (Polynomial ℝ))
    (h : cuspEvalHom (Polynomial.C a + Polynomial.C b * Polynomial.X) = 0) : a = 0 ∧ b = 0 := by
  rw [map_add, map_mul, cuspEvalHom_C, cuspEvalHom_C, cuspEvalHom_X] at h
  exact cuspMidHom_parity h

/-- **The literal ideal presentation**, in first-isomorphism form: the weighted evaluation of the
three-generator ring `ℝ[U][V][W]` is surjective onto the cusp observation algebra `ℝ[u, c², c³]`
and its kernel is exactly the principal ideal generated by `W² − V³`. -/
theorem cuspPresentation :
    Function.Surjective cuspEvalRestrict ∧
      RingHom.ker cuspEvalRestrict = Ideal.span {cuspRelation} :=
  ⟨cuspEvalRestrict_surjective, cuspEvalRestrict_ker⟩

end
end GaloisForLFunctions.HTGeometry.ChronologicalTensor
