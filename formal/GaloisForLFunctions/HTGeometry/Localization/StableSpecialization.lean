import GaloisForLFunctions.HTGeometry.LocalizationQuotient
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Polynomial.Quotient

/-!
# Specialization commutes with principal localization

Imposing `x = 1` makes every power of `x` a unit. Thus the canonical map
`R/(x-1) → R[x⁻¹]/(x-1)` is an isomorphism for every commutative ring, including
rings with zero divisors. For a polynomial variable, this identifies the localized
specialization with evaluation at one on the coefficient ring.
-/

namespace GaloisForLFunctions.HTGeometry

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- Specialization to one makes the inverted denominator trivial in the original quotient. -/
theorem stableSpecialization_denominator (x : R) :
    Ideal.Quotient.mk (Ideal.span ({x - 1} : Set R)) x = 1 := by
  rw [← map_one (Ideal.Quotient.mk (Ideal.span ({x - 1} : Set R)))]
  apply Ideal.Quotient.eq.mpr
  exact Ideal.subset_span (Set.mem_singleton (x - 1))

/-- Localizing at `x` and then setting `x = 1` is equivalent to setting `x = 1` directly. -/
noncomputable def stableSpecializationEquiv (x : R) [IsLocalization.Away x S] :
    (R ⧸ Ideal.span ({x - 1} : Set R)) ≃+*
      S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({x - 1} : Set R)) := by
  let J : Ideal R := Ideal.span ({x - 1} : Set R)
  letI := (localizationQuotientMap (S := S) J).toAlgebra
  letI : IsLocalization ((Submonoid.powers x).map (Ideal.Quotient.mk J))
      (S ⧸ Ideal.map (algebraMap R S) J) :=
    isLocalization_localizationQuotientMap (Submonoid.powers x) J
  apply (IsLocalization.atUnits (R := R ⧸ J)
    (M := (Submonoid.powers x).map (Ideal.Quotient.mk J))
    (S := S ⧸ Ideal.map (algebraMap R S) J) ?_).toRingEquiv
  rintro y ⟨z, hz, rfl⟩
  obtain ⟨n, rfl⟩ := hz
  rw [map_pow, stableSpecialization_denominator, one_pow]
  exact isUnit_one

/-- The equivalence is induced by the canonical localization map on representatives. -/
theorem stableSpecializationEquiv_mk (x r : R) [IsLocalization.Away x S] :
    stableSpecializationEquiv (S := S) x
        (Ideal.Quotient.mk (Ideal.span ({x - 1} : Set R)) r) =
      Ideal.Quotient.mk (Ideal.map (algebraMap R S) (Ideal.span ({x - 1} : Set R)))
        (algebraMap R S r) := by
  rfl

/-- The extended specialization ideal is generated by the same relation in the localization. -/
theorem stableSpecialization_ideal (x : R) :
    Ideal.map (algebraMap R S) (Ideal.span ({x - 1} : Set R)) =
      Ideal.span ({algebraMap R S x - 1} : Set S) := by
  rw [Ideal.map_span]
  simp only [Set.image_singleton, map_sub, map_one]

/-- The polynomial quotient at `X = 1`, with the relation written without the constant map. -/
noncomputable def polynomialSpecializationOne (R : Type*) [CommRing R] :
    (Polynomial R ⧸ Ideal.span ({Polynomial.X - 1} : Set (Polynomial R))) ≃+* R := by
  simpa only [map_one] using (Polynomial.quotientSpanXSubCAlgEquiv (1 : R)).toRingEquiv

/-- Polynomial representatives are sent to their value at one. -/
theorem polynomialSpecializationOne_mk (p : Polynomial R) :
    polynomialSpecializationOne R
      (Ideal.Quotient.mk (Ideal.span ({Polynomial.X - 1} : Set (Polynomial R))) p) = p.eval 1 := by
  simpa only [polynomialSpecializationOne, map_one] using
    Polynomial.quotientSpanXSubCAlgEquiv_mk (1 : R) p

/-- Evaluation at one is unchanged when the polynomial variable has first been inverted. -/
noncomputable def localizedPolynomialSpecializationOne (R : Type*) [CommRing R] :
    (Localization.Away (Polynomial.X : Polynomial R) ⧸
      Ideal.map (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)))
        (Ideal.span ({Polynomial.X - 1} : Set (Polynomial R)))) ≃+* R :=
  (stableSpecializationEquiv (S := Localization.Away (Polynomial.X : Polynomial R))
    Polynomial.X).symm.trans (polynomialSpecializationOne R)

/-- The localized equivalence still evaluates each polynomial representative at one. -/
theorem localizedPolynomialSpecializationOne_mk (p : Polynomial R) :
    localizedPolynomialSpecializationOne R
      (Ideal.Quotient.mk
        (Ideal.map (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)))
          (Ideal.span ({Polynomial.X - 1} : Set (Polynomial R))))
        (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)) p)) =
      p.eval 1 := by
  rw [← stableSpecializationEquiv_mk (S := Localization.Away (Polynomial.X : Polynomial R))
    Polynomial.X p]
  change polynomialSpecializationOne R
    ((stableSpecializationEquiv (S := Localization.Away (Polynomial.X : Polynomial R))
      Polynomial.X).symm ((stableSpecializationEquiv
        (S := Localization.Away (Polynomial.X : Polynomial R)) Polynomial.X) _)) = _
  rw [RingEquiv.symm_apply_apply, polynomialSpecializationOne_mk]

end GaloisForLFunctions.HTGeometry
#print axioms GaloisForLFunctions.HTGeometry.stableSpecializationEquiv

#print axioms GaloisForLFunctions.HTGeometry.localizedPolynomialSpecializationOne

#print axioms GaloisForLFunctions.HTGeometry.localizedPolynomialSpecializationOne_mk
