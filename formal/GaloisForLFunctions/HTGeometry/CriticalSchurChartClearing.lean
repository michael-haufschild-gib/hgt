import GaloisForLFunctions.HTGeometry.CriticalSchurCoordinateGeneration
import GaloisForLFunctions.HTGeometry.CriticalSchurCoordinateAdjoin
import GaloisForLFunctions.HTGeometry.CriticalObservationChartRing
import GaloisForLFunctions.HTGeometry.CriticalSchurChartInclusion

/-!
# The chart algebra clears denominators into the Schur coordinate ring

Every element of the critical chart algebra becomes a polynomial in the Schur coordinates after
multiplication by a power of one explicit element — the scale to a fixed power times the marked
observation product.  Since that element is a unit of the chart algebra, this exhibits the chart
algebra as a localization of the Schur coordinate ring.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}
variable [Fact (0 < m)] [Fact (0 < n)]

/-- The subalgebra of the source field generated by the Schur coordinates. -/
abbrev criticalSchurCoordinateAlgebra : Subalgebra K (criticalSourceField K m n) :=
  Algebra.adjoin K
    (Set.range (criticalSourceSchurCoordinates K (Fact.out : 0 < m) (Fact.out : 0 < n)))

/-- The marked product, read in the source field. -/
abbrev criticalSourceMarked : criticalSourceField K m n :=
  algebraMap (criticalObservationRing K m n) (criticalSourceField K m n)
    (criticalObservationMarked K (m := m) (n := n))

/-- The denominator that the chart algebra inverts, expressed in Schur coordinates. -/
noncomputable def criticalSchurClearingElement : criticalSourceField K m n :=
  criticalSourceScale K (Fact.out : 0 < m) (Fact.out : 0 < n) ^ (n + 2)
    * criticalSourceMarked K (m := m) (n := n)

theorem criticalSourceMarked_eq :
    criticalSourceMarked K (m := m) (n := n)
      = criticalSourceRaw K m n ⟨m, by have := (Fact.out : 0 < n); omega⟩ *
          criticalSourceRecip K m n ⟨n, by have := (Fact.out : 0 < m); omega⟩ :=
  algebraMap_criticalObservationMarked K

theorem criticalSchurClearingElement_mem :
    criticalSchurClearingElement K (m := m) (n := n)
      ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n) := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  set i : Fin (m + n) := ⟨n, by omega⟩ with hi
  have hrecip : criticalSourceScale K hm hn ^ ((i : ℕ) + 1) * criticalSourceRecip K m n i
      ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n) :=
    criticalSourceScale_pow_mul_recip_mem_adjoin_schur K hm hn i
  have hraw : criticalSourceRaw K m n ⟨m, by omega⟩
      ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n) :=
    criticalSourceRaw_mem_adjoin_schur K hm hn _
  have hscale : criticalSourceScale K hm hn
      ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n) := by
    rw [criticalSourceScale]
    exact criticalSourceRaw_mem_adjoin_schur K hm hn _
  have hfactor : criticalSchurClearingElement K (m := m) (n := n)
      = criticalSourceScale K hm hn *
          (criticalSourceRaw K m n ⟨m, by omega⟩ *
            (criticalSourceScale K hm hn ^ ((i : ℕ) + 1) * criticalSourceRecip K m n i)) := by
    rw [criticalSchurClearingElement, criticalSourceMarked_eq, hi]
    ring
  rw [hfactor]
  exact Subalgebra.mul_mem _ hscale (Subalgebra.mul_mem _ hraw hrecip)

/-- Elements of the source field that become Schur-coordinate polynomials after clearing a power
of the chart denominator. -/
def criticalSchurClearable : Subalgebra K (criticalSourceField K m n) where
  carrier := {x | ∃ N : ℕ, criticalSchurClearingElement K (m := m) (n := n) ^ N * x
    ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n)}
  mul_mem' := by
    rintro x y ⟨Nx, hx⟩ ⟨Ny, hy⟩
    refine ⟨Nx + Ny, ?_⟩
    have : criticalSchurClearingElement K (m := m) (n := n) ^ (Nx + Ny) * (x * y)
        = (criticalSchurClearingElement K (m := m) (n := n) ^ Nx * x) *
          (criticalSchurClearingElement K (m := m) (n := n) ^ Ny * y) := by
      rw [pow_add]; ring
    rw [this]
    exact Subalgebra.mul_mem _ hx hy
  add_mem' := by
    rintro x y ⟨Nx, hx⟩ ⟨Ny, hy⟩
    refine ⟨Nx + Ny, ?_⟩
    have : criticalSchurClearingElement K (m := m) (n := n) ^ (Nx + Ny) * (x + y)
        = criticalSchurClearingElement K (m := m) (n := n) ^ Ny *
            (criticalSchurClearingElement K (m := m) (n := n) ^ Nx * x) +
          criticalSchurClearingElement K (m := m) (n := n) ^ Nx *
            (criticalSchurClearingElement K (m := m) (n := n) ^ Ny * y) := by
      rw [pow_add]; ring
    rw [this]
    exact Subalgebra.add_mem _
      (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (criticalSchurClearingElement_mem K) _) hx)
      (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (criticalSchurClearingElement_mem K) _) hy)
  zero_mem' := ⟨0, by simpa using Subalgebra.zero_mem _⟩
  one_mem' := ⟨0, by simpa using Subalgebra.one_mem _⟩
  algebraMap_mem' := fun r => ⟨0, by
    simpa using Subalgebra.algebraMap_mem (criticalSchurCoordinateAlgebra K (m := m) (n := n)) r⟩

theorem mem_criticalSchurClearable_iff (x : criticalSourceField K m n) :
    x ∈ criticalSchurClearable K (m := m) (n := n)
      ↔ ∃ N : ℕ, criticalSchurClearingElement K (m := m) (n := n) ^ N * x
          ∈ criticalSchurCoordinateAlgebra K (m := m) (n := n) := Iff.rfl

theorem criticalSchurCoordinateAlgebra_le_clearable :
    criticalSchurCoordinateAlgebra K (m := m) (n := n)
      ≤ criticalSchurClearable K (m := m) (n := n) := by
  intro x hx
  exact ⟨0, by simpa using hx⟩

theorem criticalSourceRaw_mem_clearable (j : Fin (m + n)) :
    criticalSourceRaw K m n j ∈ criticalSchurClearable K (m := m) (n := n) :=
  ⟨0, by
    simpa using criticalSourceRaw_mem_adjoin_schur K (Fact.out : 0 < m) (Fact.out : 0 < n) j⟩

theorem criticalSourceRecip_mem_clearable (j : Fin (m + n)) :
    criticalSourceRecip K m n j ∈ criticalSchurClearable K (m := m) (n := n) := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  refine ⟨(j : ℕ) + 1, ?_⟩
  have hkey := criticalSourceScale_pow_mul_recip_mem_adjoin_schur K hm hn j
  have hfac : criticalSchurClearingElement K (m := m) (n := n) ^ ((j : ℕ) + 1)
        * criticalSourceRecip K m n j
      = (criticalSourceScale K hm hn ^ ((n + 1) * ((j : ℕ) + 1))
          * criticalSourceMarked K (m := m) (n := n) ^ ((j : ℕ) + 1))
        * (criticalSourceScale K hm hn ^ ((j : ℕ) + 1) * criticalSourceRecip K m n j) := by
    have hexp : (n + 2) * ((j : ℕ) + 1) = (n + 1) * ((j : ℕ) + 1) + ((j : ℕ) + 1) := by ring
    rw [criticalSchurClearingElement, mul_pow, ← pow_mul, hexp, pow_add]
    ring
  rw [hfac]
  refine Subalgebra.mul_mem _ ?_ hkey
  have hw : criticalSourceScale K hm hn ^ ((n + 1) * ((j : ℕ) + 1))
        * criticalSourceMarked K (m := m) (n := n) ^ ((j : ℕ) + 1)
      = (criticalSourceScale K hm hn ^ (n + 1)
          * criticalSourceMarked K (m := m) (n := n)) ^ ((j : ℕ) + 1) := by
    rw [mul_pow, ← pow_mul]
  rw [hw]
  refine Subalgebra.pow_mem _ ?_ _
  set i : Fin (m + n) := ⟨n, by omega⟩ with hi
  have hrecip := criticalSourceScale_pow_mul_recip_mem_adjoin_schur K hm hn i
  have hraw := criticalSourceRaw_mem_adjoin_schur K hm hn (⟨m, by omega⟩ : Fin (m + n))
  have hfac2 : criticalSourceScale K hm hn ^ (n + 1)
        * criticalSourceMarked K (m := m) (n := n)
      = criticalSourceRaw K m n ⟨m, by omega⟩ *
          (criticalSourceScale K hm hn ^ ((i : ℕ) + 1) * criticalSourceRecip K m n i) := by
    rw [criticalSourceMarked_eq, hi]
    ring
  rw [hfac2]
  exact Subalgebra.mul_mem _ hraw hrecip

theorem algebraMap_criticalObservationRing_mem_clearable (p : criticalObservationRing K m n) :
    algebraMap (criticalObservationRing K m n) (criticalSourceField K m n) p
      ∈ criticalSchurClearable K (m := m) (n := n) := by
  induction p using MvPolynomial.induction_on with
  | C r =>
      have h : algebraMap (criticalObservationRing K m n) (criticalSourceField K m n)
          (MvPolynomial.C r) = algebraMap K (criticalSourceField K m n) r := by
        rw [show (MvPolynomial.C r : criticalObservationRing K m n)
            = algebraMap K (criticalObservationRing K m n) r from rfl]
        exact (IsScalarTower.algebraMap_apply K (criticalObservationRing K m n)
          (criticalSourceField K m n) r).symm
      rw [h]
      exact Subalgebra.algebraMap_mem _ r
  | add p q hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | mul_X p i hp =>
      rw [map_mul]
      refine Subalgebra.mul_mem _ hp ?_
      rcases i with i | i
      · rw [algebraMap_criticalObservationRing_X_inl K]
        exact criticalSourceRaw_mem_clearable K _
      · rw [algebraMap_criticalObservationRing_X_inr K]
        exact criticalSourceRecip_mem_clearable K _

theorem criticalSourceMarked_inv_mem_clearable :
    (criticalSourceMarked K (m := m) (n := n))⁻¹
      ∈ criticalSchurClearable K (m := m) (n := n) := by
  have hm : (0 : ℕ) < m := Fact.out
  have hn : (0 : ℕ) < n := Fact.out
  have hne : criticalSourceMarked K (m := m) (n := n) ≠ 0 := by
    rw [criticalSourceMarked_eq K]
    exact mul_ne_zero (criticalSourceRaw_atMarkedIndex_ne_zero K hm hn)
      (criticalSourceRecip_atMarkedIndex_ne_zero K hm hn)
  refine ⟨1, ?_⟩
  have : criticalSchurClearingElement K (m := m) (n := n) ^ 1
      * (criticalSourceMarked K (m := m) (n := n))⁻¹
      = criticalSourceScale K hm hn ^ (n + 2) := by
    rw [pow_one, criticalSchurClearingElement, mul_assoc, mul_inv_cancel₀ hne, mul_one]
  rw [this]
  refine Subalgebra.pow_mem _ ?_ _
  rw [criticalSourceScale]
  exact criticalSourceRaw_mem_adjoin_schur K hm hn _

theorem algebraMap_criticalObservationChartRing_mem_clearable
    (c : criticalObservationChartRing K m n) :
    algebraMap (criticalObservationChartRing K m n) (criticalSourceField K m n) c
      ∈ criticalSchurClearable K (m := m) (n := n) := by
  obtain ⟨⟨p, s⟩, hs⟩ := IsLocalization.surj
    (M := Submonoid.powers (criticalObservationMarked K (m := m) (n := n)))
    (S := criticalObservationChartRing K m n) c
  obtain ⟨k, hk⟩ := s.2
  have himg := congrArg (algebraMap (criticalObservationChartRing K m n)
    (criticalSourceField K m n)) hs
  rw [map_mul, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply] at himg
  have hsval : algebraMap (criticalObservationRing K m n) (criticalSourceField K m n) (s : _)
      = criticalSourceMarked K (m := m) (n := n) ^ k := by
    rw [← hk, map_pow]
  rw [hsval] at himg
  have hne : criticalSourceMarked K (m := m) (n := n) ≠ 0 := by
    have hm : (0 : ℕ) < m := Fact.out
    have hn : (0 : ℕ) < n := Fact.out
    rw [criticalSourceMarked_eq K]
    exact mul_ne_zero (criticalSourceRaw_atMarkedIndex_ne_zero K hm hn)
      (criticalSourceRecip_atMarkedIndex_ne_zero K hm hn)
  have hsolve : algebraMap (criticalObservationChartRing K m n)
        (criticalSourceField K m n) c
      = algebraMap (criticalObservationRing K m n) (criticalSourceField K m n) p *
        ((criticalSourceMarked K (m := m) (n := n))⁻¹) ^ k := by
    rw [← himg, mul_assoc, ← mul_pow, mul_inv_cancel₀ hne, one_pow, mul_one]
  rw [hsolve]
  exact Subalgebra.mul_mem _ (algebraMap_criticalObservationRing_mem_clearable K p)
    (Subalgebra.pow_mem _ (criticalSourceMarked_inv_mem_clearable K) _)

/-- **Every element of the chart algebra becomes a Schur-coordinate polynomial after clearing a
power of the chart denominator.** -/
theorem criticalSourceChartAlgebra_mem_clearable
    (t : criticalSourceField K m n)
    (ht : t ∈ criticalSourceChartAlgebra K (m := m) (n := n)) :
    t ∈ criticalSchurClearable K (m := m) (n := n) := by
  induction ht using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with ⟨j, rfl⟩ | ⟨j, rfl⟩
      · exact criticalSourceRaw_mem_clearable K j
      · exact criticalSourceRecip_mem_clearable K j
  | algebraMap c => exact algebraMap_criticalObservationChartRing_mem_clearable K c
  | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy

end

end GaloisForLFunctions.HTGeometry
