import GaloisForLFunctions.HTGeometry.DifferentialOperatorFieldCogenerator
import GaloisForLFunctions.HTGeometry.CassidyTangentDichotomy

/-!
# Zero matrix tangent forces complete linearized operator span

Each linearization at the identity is encoded as one row over the Ore differential-operator ring.
Over a differentially closed field, the field cogenerator theorem says a proper row span would have
a nonzero common solution, hence a nonzero tangent matrix.  Therefore zero tangent makes the
linearized rows span the whole finite free operator module.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open GaloisForLFunctions

variable {C : Type*} [Field C] [Algebra ℚ C] [Differential C]
variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- The Ore-operator row representing the linearization of `P` at `p`. -/
def linearisationDiffOpRow (p : κ → C) (P : DifferentialPolynomial κ C) :
    κ → DiffOp C :=
  fun i => ∑ v ∈ P.vars, if v.1 = i then
    DiffOp.mono v.2
      (differentialPolynomialEvalOver (K := C) p (MvPolynomial.pderiv v P)) else 0

/-- Evaluation of the encoded operator row is exactly the differential linearization. -/
theorem fieldPairing_linearisationDiffOpRow (p : κ → C)
    (P : DifferentialPolynomial κ C) (X : κ → C) :
    DiffOp.fieldPairing X (linearisationDiffOpRow p P) =
      linearisationForm p P P.vars X := by
  classical
  rw [DiffOp.fieldPairing_apply, linearisationForm]
  simp_rw [linearisationDiffOpRow, DiffOp.fieldApply_finset_sum_op]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun v hv => ?_
  rw [Finset.sum_eq_single v.1]
  · simp [DiffOp.fieldApply_mono]
  · intro i _ hi
    simp [Ne.symm hi, DiffOp.fieldApply_zero_op]
  · simp

/-- Operator submodule generated by all linearized defining equations. -/
def linearisationDiffOpSpan (p : κ → C) (S : Set (DifferentialPolynomial κ C)) :
    Submodule (DiffOp C) (κ → DiffOp C) :=
  Submodule.span (DiffOp C) (Set.range fun P : S => linearisationDiffOpRow p P.1)

theorem linearisationDiffOpRow_mem_span (p : κ → C)
    (S : Set (DifferentialPolynomial κ C)) {P : DifferentialPolynomial κ C} (hP : P ∈ S) :
    linearisationDiffOpRow p P ∈ linearisationDiffOpSpan p S :=
  Submodule.subset_span ⟨⟨P, hP⟩, rfl⟩

/-- **Zero matrix tangent forces the linearized operator rows to span every operator row.** -/
theorem linearisationDiffOpSpan_eq_top_of_matrixTangentM_eq_bot
    [IsDifferentiallyClosed C]
    (S : Set (DifferentialPolynomial (Fin 2 × Fin 2) C))
    (hone : (1 : Matrix (Fin 2) (Fin 2) C) ∈ matrixZeroSet (C := C) (A := C) S)
    (hzero : matrixTangentM S hone = ⊥) :
    linearisationDiffOpSpan
      (fun q : Fin 2 × Fin 2 => (1 : Matrix (Fin 2) (Fin 2) C) q.1 q.2) S = ⊤ := by
  classical
  let p : Fin 2 × Fin 2 → C :=
    fun q => (1 : Matrix (Fin 2) (Fin 2) C) q.1 q.2
  let N := linearisationDiffOpSpan p S
  by_contra hNtop
  have hN : N ≠ ⊤ := hNtop
  obtain ⟨x, hx, hxN⟩ := DiffOp.exists_ne_zero_commonKernel_of_ne_top N hN
  let A : Matrix (Fin 2) (Fin 2) C := Matrix.of fun i j => x (i, j)
  have hA : A ∈ matrixTangentM S hone := by
    rw [mem_matrixTangentM_iff_linearisation S hone]
    intro P hP
    rw [← fieldPairing_linearisationDiffOpRow p P]
    exact hxN _ (linearisationDiffOpRow_mem_span p S hP)
  have hAzero : A = 0 := by
    rw [hzero] at hA
    simpa using hA
  apply hx
  funext q
  have hentry := congrFun (congrFun hAzero q.1) q.2
  simpa [A] using hentry

/-- Constant-field span zero already means the tangent module itself is zero. -/
theorem matrixTangentM_eq_bot_of_scalarSpan_eq_bot
    (S : Set (DifferentialPolynomial (Fin 2 × Fin 2) C))
    (hone : (1 : Matrix (Fin 2) (Fin 2) C) ∈ matrixZeroSet (C := C) (A := C) S)
    (hspan : Submodule.span C
      (((matrixTangentM S hone : Submodule _ _) : Set (Matrix (Fin 2) (Fin 2) C))) = ⊥) :
    matrixTangentM S hone = ⊥ := by
  apply le_antisymm ?_ bot_le
  intro A hA
  have hmem : A ∈ Submodule.span C
      (((matrixTangentM S hone : Submodule _ _) : Set (Matrix (Fin 2) (Fin 2) C))) :=
    Submodule.subset_span hA
  rw [hspan] at hmem
  simpa using hmem

end

end GaloisForLFunctions.HTGeometry
