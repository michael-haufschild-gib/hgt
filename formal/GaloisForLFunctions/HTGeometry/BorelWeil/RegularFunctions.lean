import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.LinearAlgebra.Matrix.Block

/-!
# Regular functions on the special linear group

The Borel–Weil theorem realizes an irreducible representation as a space of sections of a line
bundle over the flag variety `G/B`.  In the associated-bundle description those sections are
exactly the regular functions on `G` that transform by a character of `B` under right translation.
This file builds the first ingredient: the algebra `regularFun n k` of *regular* (i.e. polynomial
in the matrix entries) functions on `SL(n,k)`, and the fact that it is stable under left and right
translation by group elements.

## Main definitions

* `GaloisForLFunctions.HTGeometry.BorelWeil.coordFun i j` — the `(i,j)` matrix-entry function.
* `GaloisForLFunctions.HTGeometry.BorelWeil.coordEval` — evaluation of a polynomial in the matrix
  entries as a function on `SL(n,k)`.
* `GaloisForLFunctions.HTGeometry.BorelWeil.regularFun` — the image of `coordEval`, a `k`-subalgebra
  of `SL(n,k) → k`.
* `GaloisForLFunctions.HTGeometry.BorelWeil.leftTransl`, `rightTransl` — translation as algebra
  endomorphisms of the algebra of all functions.

## Main results

* `regularFun_eq_adjoin` — `regularFun` is the subalgebra generated by the coordinate functions.
* `regularFun_leftTransl`, `regularFun_rightTransl` — regularity is preserved by translation.
-/

namespace GaloisForLFunctions.HTGeometry.BorelWeil

open Matrix MvPolynomial

variable {n : Type*} [Fintype n] [DecidableEq n] {k : Type*} [CommRing k]

/-- The `(i,j)` matrix-entry function on `SL(n,k)`. -/
def coordFun (i j : n) : SpecialLinearGroup n k → k := fun g => (g : Matrix n n k) i j

@[simp] theorem coordFun_apply (i j : n) (g : SpecialLinearGroup n k) :
    coordFun i j g = (g : Matrix n n k) i j := rfl

variable (n k) in
/-- Evaluating a polynomial in the matrix entries gives a function on `SL(n,k)`. -/
noncomputable def coordEval :
    MvPolynomial (n × n) k →ₐ[k] (SpecialLinearGroup n k → k) :=
  MvPolynomial.aeval (fun p : n × n => (coordFun p.1 p.2 : SpecialLinearGroup n k → k))

variable (n k) in
/-- The algebra of **regular functions** on `SL(n,k)`: functions given by a polynomial in the
matrix entries. -/
noncomputable def regularFun : Subalgebra k (SpecialLinearGroup n k → k) := (coordEval n k).range

theorem coordFun_mem_regularFun (i j : n) :
    (coordFun i j : SpecialLinearGroup n k → k) ∈ regularFun n k :=
  ⟨MvPolynomial.X (i, j), by simp [coordEval]⟩

variable (n k) in
/-- `regularFun` is the `k`-subalgebra generated by the coordinate functions. -/
theorem regularFun_eq_adjoin :
    regularFun n k =
      Algebra.adjoin k
        (Set.range fun p : n × n => (coordFun p.1 p.2 : SpecialLinearGroup n k → k)) := by
  rw [regularFun, ← Algebra.map_top, ← MvPolynomial.adjoin_range_X, AlgHom.map_adjoin]
  congr 1
  rw [← Set.range_comp]
  exact congrArg Set.range (funext fun p => by simp [coordEval])

/-- Left translation by `x`, as a `k`-algebra endomorphism of the functions on `SL(n,k)`. -/
def leftTransl (x : SpecialLinearGroup n k) :
    (SpecialLinearGroup n k → k) →ₐ[k] (SpecialLinearGroup n k → k) where
  toFun f := fun g => f (x * g)
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Right translation by `x`, as a `k`-algebra endomorphism of the functions on `SL(n,k)`. -/
def rightTransl (x : SpecialLinearGroup n k) :
    (SpecialLinearGroup n k → k) →ₐ[k] (SpecialLinearGroup n k → k) where
  toFun f := fun g => f (g * x)
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

@[simp] theorem leftTransl_apply (x : SpecialLinearGroup n k)
    (f : SpecialLinearGroup n k → k) (g : SpecialLinearGroup n k) :
    leftTransl x f g = f (x * g) := rfl

@[simp] theorem rightTransl_apply (x : SpecialLinearGroup n k)
    (f : SpecialLinearGroup n k → k) (g : SpecialLinearGroup n k) :
    rightTransl x f g = f (g * x) := rfl

theorem leftTransl_coordFun (x : SpecialLinearGroup n k) (i j : n) :
    leftTransl x (coordFun i j) =
      ∑ r : n, (x : Matrix n n k) i r • (coordFun r j : SpecialLinearGroup n k → k) := by
  funext g
  simp [leftTransl, coordFun, Matrix.mul_apply, Finset.sum_apply]

theorem rightTransl_coordFun (x : SpecialLinearGroup n k) (i j : n) :
    rightTransl x (coordFun i j) =
      ∑ r : n, (x : Matrix n n k) r j • (coordFun i r : SpecialLinearGroup n k → k) := by
  funext g
  simp [rightTransl, coordFun, Matrix.mul_apply, Finset.sum_apply, mul_comm]

/-- Regular functions are stable under left translation. -/
theorem regularFun_leftTransl (x : SpecialLinearGroup n k)
    {f : SpecialLinearGroup n k → k} (hf : f ∈ regularFun n k) :
    leftTransl x f ∈ regularFun n k := by
  have key : Subalgebra.map (leftTransl x) (regularFun n k) ≤ regularFun n k := by
    conv_lhs => rw [regularFun_eq_adjoin]
    rw [AlgHom.map_adjoin]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨_, ⟨p, rfl⟩, rfl⟩
    rw [leftTransl_coordFun]
    exact Subalgebra.sum_mem _ fun r _ =>
      Subalgebra.smul_mem _ (coordFun_mem_regularFun r p.2) _
  exact key ⟨f, hf, rfl⟩

/-- Regular functions are stable under right translation. -/
theorem regularFun_rightTransl (x : SpecialLinearGroup n k)
    {f : SpecialLinearGroup n k → k} (hf : f ∈ regularFun n k) :
    rightTransl x f ∈ regularFun n k := by
  have key : Subalgebra.map (rightTransl x) (regularFun n k) ≤ regularFun n k := by
    conv_lhs => rw [regularFun_eq_adjoin]
    rw [AlgHom.map_adjoin]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨_, ⟨p, rfl⟩, rfl⟩
    rw [rightTransl_coordFun]
    exact Subalgebra.sum_mem _ fun r _ =>
      Subalgebra.smul_mem _ (coordFun_mem_regularFun p.1 r) _
  exact key ⟨f, hf, rfl⟩

end GaloisForLFunctions.HTGeometry.BorelWeil
