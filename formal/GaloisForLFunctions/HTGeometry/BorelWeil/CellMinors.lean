import GaloisForLFunctions.HTGeometry.BorelWeil.BruhatCover
import GaloisForLFunctions.HTGeometry.BorelWeil.DetTwist

/-!
# The equations of the Bruhat cells

The cell of the flag variety attached to a Weyl group element `σ` is the locus where the leading
principal minors of the `σ`-permuted matrix are all nonzero; `BruhatCover` says these cells cover.
This file records the minors as polynomials, shows they are nonzero, and — the point of the file —
computes how they transform under right translation by the Borel:

`minorPolyAt σ j (g · B) = (∏_{i < j} B i i) · minorPolyAt σ j g`.

So the multiplicative set generated by the cell equations is stable under the Borel action up to
units.  That is what will let the `B`-action extend to the localizations at the cell equations,
i.e. to the sections of `L_λ` over the cells and over their intersections.

## Main definitions

* `GaloisForLFunctions.HTGeometry.BorelWeil.minorPolyAt`
* `GaloisForLFunctions.HTGeometry.BorelWeil.cellDenomPoly`

## Main results

* `minorPolyAt_ne_zero`, `cellDenomPoly_ne_zero`
* `substRight_minorPolyAt` — Borel semi-invariance of the cell equations.
-/

set_option linter.unusedSectionVars false

namespace GaloisForLFunctions.HTGeometry.BorelWeil

open Matrix MvPolynomial

variable {N : ℕ} {k : Type*} [Field k]

/-- The `j`-th leading principal minor of the `σ`-row-permuted generic matrix. -/
noncomputable def minorPolyAt (N : ℕ) (k : Type*) [Field k] (σ : Equiv.Perm (Fin N)) (j : ℕ) :
    MvPolynomial (Fin N × Fin N) k :=
  (truncate j ((genericMatrix N k).submatrix (⇑σ) id)).det

theorem matEval_minorPolyAt (σ : Equiv.Perm (Fin N)) (j : ℕ) (g : Matrix (Fin N) (Fin N) k) :
    matEval g (minorPolyAt N k σ j) = leadingMinorMat j (g.submatrix (⇑σ) id) := by
  have hmap : (truncate j ((genericMatrix N k).submatrix (⇑σ) id)).map
      (MvPolynomial.eval (fun ij : Fin N × Fin N => g ij.1 ij.2))
      = truncate j (g.submatrix (⇑σ) id) := by
    ext i i'
    by_cases h1 : (i : ℕ) < j
    · by_cases h2 : (i' : ℕ) < j
      · simp [Matrix.map_apply, truncate_apply_of_both h1 h2, genericMatrix]
      · rw [Matrix.map_apply, truncate_apply_of_not_right h2, truncate_apply_of_not_right h2]
        by_cases h3 : i = i' <;> simp [h3]
    · rw [Matrix.map_apply, truncate_apply_of_not_left h1, truncate_apply_of_not_left h1]
      by_cases h3 : i = i' <;> simp [h3]
  rw [minorPolyAt, leadingMinorMat, matEval, ← hmap, RingHom.map_det]
  rfl

/-- The matrix whose `σ`-permutation is the identity. -/
def permWitness (σ : Equiv.Perm (Fin N)) (k : Type*) [Field k] : Matrix (Fin N) (Fin N) k :=
  Matrix.of fun r l => if r = σ l then 1 else 0

theorem permWitness_submatrix (σ : Equiv.Perm (Fin N)) :
    (permWitness σ k).submatrix (⇑σ) id = 1 := by
  ext i l
  rw [Matrix.submatrix_apply, id_eq, permWitness, Matrix.of_apply, Matrix.one_apply]
  by_cases h : i = l
  · rw [if_pos (by rw [h]), if_pos h]
  · rw [if_neg (fun hc => h (σ.injective hc)), if_neg h]

theorem minorPolyAt_ne_zero (σ : Equiv.Perm (Fin N)) (j : ℕ) : minorPolyAt N k σ j ≠ 0 := by
  intro hzero
  have hval := congrArg (matEval (permWitness σ k)) hzero
  rw [matEval_minorPolyAt, permWitness_submatrix, matEval_zero, leadingMinorMat,
    truncate_one, Matrix.det_one] at hval
  exact one_ne_zero hval

/-- The product of the cell equations for `σ`: its nonvanishing locus is the `σ`-cell. -/
noncomputable def cellDenomPoly (N : ℕ) (k : Type*) [Field k] (σ : Equiv.Perm (Fin N)) :
    MvPolynomial (Fin N × Fin N) k :=
  ∏ j : Fin N, minorPolyAt N k σ ((j : ℕ) + 1)

theorem cellDenomPoly_ne_zero (σ : Equiv.Perm (Fin N)) : cellDenomPoly N k σ ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun j _ => minorPolyAt_ne_zero σ ((j : ℕ) + 1)

theorem submatrix_mul (g B : Matrix (Fin N) (Fin N) k) (σ : Equiv.Perm (Fin N)) :
    (g * B).submatrix (⇑σ) id = (g.submatrix (⇑σ) id) * B := by
  ext i l
  simp [Matrix.mul_apply]

/-- **Borel semi-invariance of the cell equations.** -/
theorem substRight_minorPolyAt [Infinite k] (σ : Equiv.Perm (Fin N)) (j : ℕ)
    {B : Matrix (Fin N) (Fin N) k} (hB : B.BlockTriangular id) :
    substRight B (minorPolyAt N k σ j)
      = MvPolynomial.C (∏ i : Fin N, (if (i : ℕ) < j then B i i else 1)) * minorPolyAt N k σ j := by
  refine matEval_injective fun g => ?_
  have hC : matEval g (MvPolynomial.C (∏ i : Fin N, (if (i : ℕ) < j then B i i else 1)))
      = ∏ i : Fin N, (if (i : ℕ) < j then B i i else 1) := by simp [matEval]
  rw [matEval_substRight, matEval_minorPolyAt, matEval_mul, hC, matEval_minorPolyAt,
    submatrix_mul, leadingMinorMat_mul_borel j _ hB, mul_comm]

end GaloisForLFunctions.HTGeometry.BorelWeil

namespace GaloisForLFunctions.HTGeometry.BorelWeil

open Matrix MvPolynomial

variable {N : ℕ} {k : Type*} [Field k]

/-- **The cells cover.**  Every invertible matrix lies in the cell of some Weyl group element:
the polynomial form of the Bruhat covering, as the Čech complex will use it. -/
theorem exists_cellDenomPoly_ne_zero {g : Matrix (Fin N) (Fin N) k} (hg : g.det ≠ 0) :
    ∃ σ : Equiv.Perm (Fin N), matEval g (cellDenomPoly N k σ) ≠ 0 := by
  obtain ⟨σ, hσ⟩ := exists_perm_leadingMinor_ne_zero hg
  refine ⟨σ, ?_⟩
  rw [cellDenomPoly, matEval_prod]
  refine Finset.prod_ne_zero_iff.mpr fun j _ => ?_
  rw [matEval_minorPolyAt]
  exact hσ j

end GaloisForLFunctions.HTGeometry.BorelWeil
