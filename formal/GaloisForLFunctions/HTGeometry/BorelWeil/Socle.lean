import GaloisForLFunctions.HTGeometry.BorelWeil.RowFiltration
import GaloisForLFunctions.HTGeometry.BorelWeil.HighestWeight

/-!
# The Borel–Weil module: irreducibility

Every nonzero subspace of the polynomial ring stable under left translation by the lower
unitriangular group contains a nonzero fixed vector — this follows from the row-weight filtration,
with no appeal to Kolchin's theorem.  Combined with the uniqueness of the highest weight vector,
this shows that every nonzero `GL`-stable subspace of the Borel–Weil sections contains the minor
product `bwPoly`, hence contains the `GL`-submodule it generates.  That submodule is therefore the
unique minimal one: it is an **irreducible** representation of `GL(N,k)` with highest weight `lam`.

## Main definitions

* `GaloisForLFunctions.HTGeometry.BorelWeil.IsGStable`
* `GaloisForLFunctions.HTGeometry.BorelWeil.bwSocle` — the module generated by the minor product.

## Main results

* `exists_lowerUni_fixed` — existence of a lower unitriangular fixed vector.
* `bwPoly_mem_of_ne_bot` — every nonzero stable subspace of the sections contains `bwPoly`.
* `bwSocle_irreducible` — irreducibility of `bwSocle`.
-/

set_option linter.unusedSectionVars false

namespace GaloisForLFunctions.HTGeometry.BorelWeil

open Matrix MvPolynomial

variable {N : ℕ} {k : Type*} [Field k]

/-- The largest row weight occurring in a polynomial. -/
noncomputable def rowDeg (p : MvPolynomial (Fin N × Fin N) k) : ℕ := p.support.sup rowWeight

theorem mem_Fle_rowDeg (p : MvPolynomial (Fin N × Fin N) k) : p ∈ Fle k (rowDeg p) :=
  fun d hd => Finset.le_sup hd

/-- **Existence of a lower unitriangular fixed vector.**  Any nonzero subspace stable under left
translation by the lower unitriangular group contains a nonzero fixed vector. -/
theorem exists_lowerUni_fixed {M : Submodule k (MvPolynomial (Fin N × Fin N) k)} (hM : M ≠ ⊥)
    (hstab : ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L → ∀ p ∈ M, substLeft L p ∈ M) :
    ∃ v ∈ M, v ≠ 0 ∧ ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L → substLeft L v = v := by
  classical
  have hex : ∃ a : ℕ, ∃ p ∈ M, p ≠ 0 ∧ p ∈ Fle k a := by
    obtain ⟨p, hpM, hp0⟩ := (Submodule.ne_bot_iff M).mp hM
    exact ⟨rowDeg p, p, hpM, hp0, mem_Fle_rowDeg p⟩
  obtain ⟨p, hpM, hp0, hpF⟩ := Nat.find_spec hex
  refine ⟨p, hpM, hp0, fun L hL => ?_⟩
  have hdiff : substLeft L p - p ∈ Flt k (Nat.find hex) := substLeft_sub_mem_Flt hL hpF
  have hdiffM : substLeft L p - p ∈ M := M.sub_mem (hstab L hL p hpM) hpM
  by_contra hne
  have hne0 : substLeft L p - p ≠ 0 := sub_ne_zero.mpr hne
  rcases Nat.eq_zero_or_pos (Nat.find hex) with hz | hpos
  · rw [hz] at hdiff
    exact hne0 (by
      refine MvPolynomial.ext _ _ fun d => ?_
      by_cases hd : d ∈ (substLeft L p - p).support
      · exact absurd (hdiff d hd) (by omega)
      · simpa using (MvPolynomial.notMem_support_iff.mp hd))
  · have hsmall : substLeft L p - p ∈ Fle k (Nat.find hex - 1) := by
      intro d hd
      have := hdiff d hd
      omega
    have := Nat.find_min hex (m := Nat.find hex - 1) (by omega)
    exact this ⟨substLeft L p - p, hdiffM, hne0, hsmall⟩

/-- A subspace stable under left translation by the invertible matrices. -/
def IsGStable (M : Submodule k (MvPolynomial (Fin N × Fin N) k)) : Prop :=
  ∀ x : Matrix (Fin N) (Fin N) k, IsUnit x.det → ∀ p ∈ M, substLeft x p ∈ M

theorem substLeft_one (p : MvPolynomial (Fin N × Fin N) k) : substLeft 1 p = p := by
  have hfun : (fun ij : Fin N × Fin N => ∑ r : Fin N,
      MvPolynomial.C ((1 : Matrix (Fin N) (Fin N) k) ij.1 r) * MvPolynomial.X (r, ij.2))
      = fun ij : Fin N × Fin N => MvPolynomial.X ij := by
    funext ij
    rw [Finset.sum_eq_single ij.1]
    · simp
    · intro r _ hr
      rw [Matrix.one_apply_ne (Ne.symm hr)]
      simp
    · intro h; exact absurd (Finset.mem_univ ij.1) h
  rw [substLeft, hfun, MvPolynomial.aeval_X_left]
  rfl

theorem substLeft_substLeft [Infinite k] (x y : Matrix (Fin N) (Fin N) k)
    (p : MvPolynomial (Fin N × Fin N) k) :
    substLeft x (substLeft y p) = substLeft (y * x) p := by
  refine matEval_injective fun g => ?_
  rw [matEval_substLeft, matEval_substLeft, matEval_substLeft, Matrix.mul_assoc]

/-- **Every nonzero stable subspace of the sections contains the minor product.** -/
theorem bwPoly_mem_of_ne_bot [Infinite k] {lam : Fin N → ℕ} (hlam : Antitone lam)
    {M : Submodule k (MvPolynomial (Fin N × Fin N) k)} (hle : M ≤ polySections lam)
    (hM : M ≠ ⊥)
    (hstab : ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L → ∀ p ∈ M, substLeft L p ∈ M) :
    bwPoly (multOfWeight lam) k ∈ M := by
  obtain ⟨v, hvM, hv0, hvfix⟩ := exists_lowerUni_fixed hM hstab
  have hinv : ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L →
      ∀ g : Matrix (Fin N) (Fin N) k, matEval (L * g) v = matEval g v := by
    intro L hL g
    rw [← matEval_substLeft L g v, hvfix L hL]
  have hrep := polySections_eq_smul_bwPoly hlam (hle hvM) hinv
  set c := matEval (1 : Matrix (Fin N) (Fin N) k) v with hcdef
  have hc : c ≠ 0 := by
    intro hzero
    rw [hzero, zero_smul] at hrep
    exact hv0 hrep
  have hbw : bwPoly (multOfWeight lam) k = c⁻¹ • v := by
    rw [hrep, smul_smul, inv_mul_cancel₀ hc, one_smul]
  rw [hbw]
  exact M.smul_mem _ hvM

/-- The `GL`-submodule of the Borel–Weil sections generated by the minor product. -/
noncomputable def bwSocle (lam : Fin N → ℕ) (k : Type*) [Field k] :
    Submodule k (MvPolynomial (Fin N × Fin N) k) :=
  Submodule.span k {q | ∃ x : Matrix (Fin N) (Fin N) k, IsUnit x.det ∧
    q = substLeft x (bwPoly (multOfWeight lam) k)}

theorem bwPoly_mem_bwSocle (lam : Fin N → ℕ) :
    bwPoly (multOfWeight lam) k ∈ bwSocle lam k :=
  Submodule.subset_span ⟨1, by simp, (substLeft_one _).symm⟩

theorem bwSocle_le_polySections {lam : Fin N → ℕ} (hlam : Antitone lam) :
    bwSocle lam k ≤ polySections lam := by
  rw [bwSocle, Submodule.span_le]
  rintro q ⟨x, -, rfl⟩
  refine polySections_substLeft x ?_
  have h := bwPoly_mem_polySections (k := k) (multOfWeight lam)
  rwa [weightOfMult_multOfWeight hlam] at h

theorem bwSocle_isGStable [Infinite k] (lam : Fin N → ℕ) : IsGStable (bwSocle lam k) := by
  intro x hx p hp
  have key : bwSocle lam k ≤ Submodule.comap (substLeft x).toLinearMap (bwSocle lam k) := by
    simp only [bwSocle, Submodule.span_le]
    rintro q ⟨y, hy, rfl⟩
    simp only [SetLike.mem_coe, Submodule.mem_comap, AlgHom.toLinearMap_apply]
    rw [substLeft_substLeft]
    exact Submodule.subset_span ⟨y * x, by rw [Matrix.det_mul]; exact hy.mul hx, rfl⟩
  exact key hp

theorem bwSocle_ne_bot [Infinite k] (lam : Fin N → ℕ) : bwSocle lam k ≠ ⊥ := by
  intro hbot
  have := bwPoly_mem_bwSocle (k := k) lam
  rw [hbot, Submodule.mem_bot] at this
  exact bwPoly_ne_zero _ this

/-- **Irreducibility of the Borel–Weil module.**  Every nonzero `GL`-stable subspace of
`bwSocle lam` is all of it. -/
theorem bwSocle_irreducible [Infinite k] {lam : Fin N → ℕ} (hlam : Antitone lam)
    {M : Submodule k (MvPolynomial (Fin N × Fin N) k)} (hle : M ≤ bwSocle lam k)
    (hstab : IsGStable M) (hM : M ≠ ⊥) : M = bwSocle lam k := by
  refine le_antisymm hle ?_
  have hlow : ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L → ∀ p ∈ M, substLeft L p ∈ M := by
    intro L hL p hp
    refine hstab L ?_ p hp
    rw [hL.det_eq_one]
    exact isUnit_one
  have hb : bwPoly (multOfWeight lam) k ∈ M :=
    bwPoly_mem_of_ne_bot hlam (le_trans hle (bwSocle_le_polySections hlam)) hM hlow
  rw [bwSocle, Submodule.span_le]
  rintro q ⟨x, hx, rfl⟩
  exact hstab x hx _ hb

end GaloisForLFunctions.HTGeometry.BorelWeil
