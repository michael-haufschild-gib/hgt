import GaloisForLFunctions.HTGeometry.BorelWeil.Contravariance
import GaloisForLFunctions.HTGeometry.BorelWeil.ApolarPositivity
import GaloisForLFunctions.HTGeometry.BorelWeil.Socle
import Mathlib.Algebra.CharZero.Infinite

/-!
# The Borel–Weil theorem in characteristic zero

In characteristic zero the whole space of Borel–Weil sections coincides with the irreducible
submodule generated by the minor product.  The proof is the contravariant form argument: the
apolarity pairing is contravariant for the transpose, its radical on `H⁰(λ)` is a `GL`-submodule,
and the self-pairing of the minor product is a positive integer, so the radical vanishes; the
orthogonal of the socle is then a `GL`-submodule meeting the socle trivially, hence zero, and a
rank count forces the socle to be everything.

## Main results

* `polySections_eq_bwSocle` — `H⁰(λ) = L(λ)` in characteristic zero.
* `polySections_irreducible` — **Borel–Weil**: `H⁰(λ)` is an irreducible `GL(N,k)`-module.
-/

set_option linter.unusedSectionVars false

namespace GaloisForLFunctions.HTGeometry.BorelWeil

open Matrix MvPolynomial

variable {N : ℕ} {k : Type*} [Field k]

/-- The orthogonal complement of a subspace for the apolarity pairing. -/
def apolarPerp (W : Submodule k (MvPolynomial (Fin N × Fin N) k)) :
    Submodule k (MvPolynomial (Fin N × Fin N) k) where
  carrier := {p | ∀ w ∈ W, apolar p w = 0}
  add_mem' hp hq w hw := by rw [apolar_add_left, hp w hw, hq w hw, add_zero]
  zero_mem' := by intro w _; simp
  smul_mem' c p hp w hw := by rw [apolar_smul_left, hp w hw, mul_zero]

theorem mem_apolarPerp {W : Submodule k (MvPolynomial (Fin N × Fin N) k)}
    {p : MvPolynomial (Fin N × Fin N) k} :
    p ∈ apolarPerp W ↔ ∀ w ∈ W, apolar p w = 0 := Iff.rfl

/-- The perp of a `GL`-stable subspace, intersected with the sections, is `GL`-stable. -/
theorem inf_apolarPerp_isGStable {lam : Fin N → ℕ}
    {W : Submodule k (MvPolynomial (Fin N × Fin N) k)} (hW : IsGStable W) :
    IsGStable (polySections lam ⊓ apolarPerp W) := by
  rintro x hx p ⟨hpV, hpW⟩
  refine ⟨polySections_substLeft x hpV, ?_⟩
  intro w hw
  rw [apolar_substLeft]
  refine hpW _ (hW xᵀ ?_ w hw)
  rwa [Matrix.det_transpose]

/-- **The Borel–Weil theorem in characteristic zero.**  The space of sections of the line bundle
attached to a dominant weight is generated by the minor product. -/
theorem polySections_eq_bwSocle [CharZero k] {lam : Fin N → ℕ} (hlam : Antitone lam) :
    polySections (k := k) lam = bwSocle lam k := by
  classical
  have hbwV : bwPoly (multOfWeight lam) k ∈ polySections (k := k) lam := by
    have h := bwPoly_mem_polySections (k := k) (multOfWeight lam)
    rwa [weightOfMult_multOfWeight hlam] at h
  have hself := apolar_bwPoly_self_ne_zero (k := k) (multOfWeight lam)
  have hWle : bwSocle lam k ≤ polySections (k := k) lam := bwSocle_le_polySections hlam
  -- the orthogonal of the socle inside the sections is trivial
  have hperp : polySections (k := k) lam ⊓ apolarPerp (bwSocle lam k) = ⊥ := by
    by_contra hne
    have hstab : IsGStable (polySections (k := k) lam ⊓ apolarPerp (bwSocle lam k)) :=
      inf_apolarPerp_isGStable (bwSocle_isGStable lam)
    have hlow : ∀ L : Matrix (Fin N) (Fin N) k, IsLowerUni L →
        ∀ p ∈ polySections (k := k) lam ⊓ apolarPerp (bwSocle lam k),
          substLeft L p ∈ polySections (k := k) lam ⊓ apolarPerp (bwSocle lam k) := by
      intro L hL p hp
      refine hstab L ?_ p hp
      rw [hL.det_eq_one]
      exact isUnit_one
    have hb := bwPoly_mem_of_ne_bot hlam inf_le_left hne hlow
    have hb2 : bwPoly (multOfWeight lam) k ∈ apolarPerp (bwSocle lam k) := hb.2
    exact hself (mem_apolarPerp.mp hb2 _ (bwPoly_mem_bwSocle lam))
  -- a rank count now forces the socle to be everything
  haveI : FiniteDimensional k (polySections (k := k) lam) := finiteDimensional_polySections lam
  haveI : FiniteDimensional k (bwSocle lam k) :=
    Submodule.finiteDimensional_of_le hWle
  set Ψ : (polySections (k := k) lam) →ₗ[k] ((bwSocle lam k) →ₗ[k] k) :=
    { toFun := fun v =>
        { toFun := fun w => apolar (v : MvPolynomial (Fin N × Fin N) k)
            (w : MvPolynomial (Fin N × Fin N) k)
          map_add' := fun w₁ w₂ => by simpa using apolar_add_right _ _ _
          map_smul' := fun c w => by simpa using apolar_smul_right c _ _ }
      map_add' := fun v₁ v₂ => by
        ext w
        simpa using apolar_add_left _ _ _
      map_smul' := fun c v => by
        ext w
        simpa using apolar_smul_left c _ _ } with hΨ
  have hker : LinearMap.ker Ψ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro ⟨v, hv⟩ hvk
    have hv0 : v ∈ polySections (k := k) lam ⊓ apolarPerp (bwSocle lam k) := by
      refine ⟨hv, fun w hw => ?_⟩
      have := congrFun (congrArg (fun f : (bwSocle lam k) →ₗ[k] k => (f : _ → k))
        (LinearMap.mem_ker.mp hvk)) ⟨w, hw⟩
      simpa [hΨ] using this
    rw [hperp, Submodule.mem_bot] at hv0
    exact Subtype.ext hv0
  have hinj : Function.Injective Ψ := LinearMap.ker_eq_bot.mp hker
  have h1 : Module.finrank k (polySections (k := k) lam)
      ≤ Module.finrank k ((bwSocle lam k) →ₗ[k] k) :=
    LinearMap.finrank_le_finrank_of_injective hinj
  have h2 : Module.finrank k ((bwSocle lam k) →ₗ[k] k) = Module.finrank k (bwSocle lam k) :=
    Subspace.dual_finrank_eq
  have h3 : Module.finrank k (bwSocle lam k) ≤ Module.finrank k (polySections (k := k) lam) :=
    Submodule.finrank_mono hWle
  exact (Submodule.eq_of_le_of_finrank_le hWle (by omega)).symm

/-- **Borel–Weil.**  In characteristic zero every nonzero `GL`-stable subspace of the section space
`H⁰(λ)` is the whole space: `H⁰(λ)` is irreducible. -/
theorem polySections_irreducible [CharZero k] {lam : Fin N → ℕ} (hlam : Antitone lam)
    {M : Submodule k (MvPolynomial (Fin N × Fin N) k)} (hle : M ≤ polySections lam)
    (hstab : IsGStable M) (hM : M ≠ ⊥) : M = polySections (k := k) lam := by
  rw [polySections_eq_bwSocle hlam] at hle ⊢
  exact bwSocle_irreducible hlam hle hstab hM

end GaloisForLFunctions.HTGeometry.BorelWeil
