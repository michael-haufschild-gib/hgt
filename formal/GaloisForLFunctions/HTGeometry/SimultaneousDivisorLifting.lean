import GaloisForLFunctions.HTGeometry.TelescopeIdeal

/-!
# Simultaneous lifting of a compatible family of residues

A family of prescribed residues `D i` modulo elements `x i`, pairwise compatible modulo the pairs
`(x i, x j)`, is realized by a single element.  The induction adds one index at a time: the new
residue differs from the current lift by something lying in every earlier pair ideal, hence — by the
transverse coprimality of the `x i` modulo the new one — by a multiple of the product of the earlier
elements plus a multiple of the new one.  Adding that multiple of the product corrects the new
index without disturbing the earlier ones.

This is the exactness of `R → ⨁ᵢ R/(xᵢ)` at the equalizer of the pairwise reductions, which is what
turns a family of face divisors agreeing on every overlap into one divisor on the whole.
-/

namespace GaloisForLFunctions.HTGeometry

open Finset

variable {R : Type*} [CommRing R] {ι : Type*} [DecidableEq ι]

/-- Transverse coprimality: modulo any one of the elements, the intersection of the ideals generated
by the others is generated by their product. -/
def TransverseCoprime (s : Finset ι) (x : ι → R) : Prop :=
  ∀ j ∈ s, ∀ t : Finset ι, t ⊆ s.erase j →
    (⨅ i ∈ t, Ideal.span {x i, x j}) ≤ Ideal.span {∏ i ∈ t, x i, x j}

theorem TransverseCoprime.subset {s s' : Finset ι} {x : ι → R} (h : TransverseCoprime s x)
    (hss : s' ⊆ s) : TransverseCoprime s' x := by
  intro j hj t ht
  exact h j (hss hj) t (ht.trans (Finset.erase_subset_erase j hss))

/-- **Simultaneous lifting.**  A pairwise compatible family of prescribed residues is realized by a
single element. -/
theorem exists_forall_sub_mem_span_singleton (x D : ι → R) {s : Finset ι}
    (hcop : TransverseCoprime s x)
    (hcompat : ∀ i ∈ s, ∀ j ∈ s, D i - D j ∈ Ideal.span {x i, x j}) :
    ∃ b : R, ∀ i ∈ s, b - D i ∈ Ideal.span ({x i} : Set R) := by
  classical
  induction s using Finset.induction with
  | empty => exact ⟨0, by simp⟩
  | insert a s ha ih =>
      have hsub : s ⊆ insert a s := Finset.subset_insert a s
      obtain ⟨b, hb⟩ := ih (hcop.subset hsub)
        (fun i hi j hj => hcompat i (hsub hi) j (hsub hj))
      -- the new residue differs from the current lift inside every earlier pair ideal
      have hmem : ∀ i ∈ s, D a - b ∈ Ideal.span {x i, x a} := by
        intro i hi
        have h₁ : D a - D i ∈ Ideal.span {x a, x i} :=
          hcompat a (Finset.mem_insert_self a s) i (hsub hi)
        have h₁' : D a - D i ∈ Ideal.span {x i, x a} := by
          rwa [Set.pair_comm (x a) (x i)] at h₁
        have h₂ : D i - b ∈ Ideal.span {x i, x a} := by
          have : b - D i ∈ Ideal.span ({x i} : Set R) := hb i hi
          have hle : Ideal.span ({x i} : Set R) ≤ Ideal.span {x i, x a} :=
            Ideal.span_mono (by intro y hy; simp at hy; simp [hy])
          have := hle this
          simpa using (Ideal.neg_mem_iff _).mpr this
        have := Ideal.add_mem _ h₁' h₂
        simpa using this
      have hinf : D a - b ∈ ⨅ i ∈ s, Ideal.span {x i, x a} :=
        Submodule.mem_iInf _ |>.mpr fun i =>
          Submodule.mem_iInf _ |>.mpr fun hi => hmem i hi
      have hprod : D a - b ∈ Ideal.span {∏ i ∈ s, x i, x a} :=
        hcop a (Finset.mem_insert_self a s) s
          (by intro i hi; exact Finset.mem_erase.mpr ⟨fun h => ha (h ▸ hi), hsub hi⟩) hinf
      obtain ⟨r, q, hrq⟩ := Ideal.mem_span_pair.mp hprod
      refine ⟨b + r * ∏ i ∈ s, x i, ?_⟩
      intro i hi
      rcases Finset.mem_insert.mp hi with rfl | hi
      · have : b + r * ∏ k ∈ s, x k - D i = -(q * x i) := by
          linear_combination hrq
        rw [this]
        exact Submodule.neg_mem _ (Ideal.mem_span_singleton.mpr ⟨q, mul_comm _ _⟩)
      · have hdvd : x i ∣ ∏ k ∈ s, x k := Finset.dvd_prod_of_mem x hi
        have hmul : r * ∏ k ∈ s, x k ∈ Ideal.span ({x i} : Set R) :=
          Ideal.mem_span_singleton.mpr (Dvd.dvd.mul_left hdvd r)
        have hrw : b + r * ∏ k ∈ s, x k - D i = (b - D i) + r * ∏ k ∈ s, x k := by ring
        rw [hrw]
        exact Ideal.add_mem _ (hb i hi) hmul


/-! ### Transverse coprimality from the quotients -/

theorem span_pair_eq_comap (a b : R) :
    Ideal.span ({a, b} : Set R)
      = Ideal.comap (Ideal.Quotient.mk (Ideal.span ({b} : Set R)))
          (Ideal.span {Ideal.Quotient.mk (Ideal.span ({b} : Set R)) a}) := by
  have hmap : Ideal.span {Ideal.Quotient.mk (Ideal.span ({b} : Set R)) a}
      = Ideal.map (Ideal.Quotient.mk (Ideal.span ({b} : Set R))) (Ideal.span ({a} : Set R)) := by
    rw [Ideal.map_span]
    congr 1
    simp
  rw [hmap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, ← Ideal.span_insert]

/-- Transverse coprimality is a statement in the quotients by the individual elements. -/
theorem transverseCoprime_of_quotient (s : Finset ι) (x : ι → R)
    (h : ∀ j ∈ s, ∀ t : Finset ι, t ⊆ s.erase j →
      (⨅ i ∈ t, Ideal.span {Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i)})
        ≤ Ideal.span {Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (∏ i ∈ t, x i)}) :
    TransverseCoprime s x := by
  intro j hj t ht y hy
  rw [span_pair_eq_comap, Ideal.mem_comap]
  refine h j hj t ht ?_
  refine Submodule.mem_iInf _ |>.mpr fun i => Submodule.mem_iInf _ |>.mpr fun hi => ?_
  have hy' : y ∈ Ideal.span ({x i, x j} : Set R) := by
    have := Submodule.mem_iInf _ |>.mp hy i
    exact Submodule.mem_iInf _ |>.mp this hi
  rw [span_pair_eq_comap, Ideal.mem_comap] at hy'
  exact hy'

/-- The concrete criterion: modulo each element the remaining ones are pairwise relatively prime. -/
theorem transverseCoprime_of_isRelPrime_quotient (s : Finset ι) (x : ι → R)
    [inst : ∀ j : ι, DecompositionMonoid (R ⧸ Ideal.span ({x j} : Set R))]
    (h : ∀ j ∈ s, ((s.erase j : Finset ι) : Set ι).Pairwise fun i i' =>
      IsRelPrime (Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i))
        (Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i'))) :
    TransverseCoprime s x := by
  classical
  refine transverseCoprime_of_quotient s x fun j hj t ht => ?_
  have hpair : ((t : Finset ι) : Set ι).Pairwise fun i i' =>
      IsRelPrime (Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i))
        (Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i')) :=
    Set.Pairwise.mono (by exact_mod_cast ht) (h j hj)
  have hkey := TelescopeIdeal.iInf_span_singleton_eq_span_prod
    (R := R ⧸ Ideal.span ({x j} : Set R)) t
    (fun i => Ideal.Quotient.mk (Ideal.span ({x j} : Set R)) (x i)) hpair
  rw [hkey, ← map_prod]

end GaloisForLFunctions.HTGeometry
