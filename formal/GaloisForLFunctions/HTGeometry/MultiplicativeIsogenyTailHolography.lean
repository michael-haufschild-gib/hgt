import GaloisForLFunctions.HTGeometry.AutonomousTailBridge
import GaloisForLFunctions.HTGeometry.MultiplicativeProtocolAlgClosed

/-!
# Multiplicative isogeny-tail holography

For a differentially generic point `g` of the rank-one split torus and the power isogeny
`g ↦ g ^ N`, `N > 1`, the entire autonomous stable tail is the differential field generated by
the Maurer--Cartan current `g'/g`.  Thus the position is erased, the current remains
hypertranscendental, and no nonconstant rational function of the original position survives.

Unlike a protocol-level reformulation, the theorem below identifies the card's autonomous
`stableRangeCore` directly.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

/-- Constant power protocols accumulate exponent `N ^ n` after `n` steps. -/
theorem prefixExponent_const (N i n : ℕ) :
    prefixExponent (fun _ => N) i n = N ^ n := by
  induction n generalizing i with
  | zero => simp
  | succ n ih =>
      rw [prefixExponent_succ, ih, pow_succ']

/-- A constant exponent strictly greater than one has unbounded accumulated exponents. -/
theorem prefixExponent_const_unbounded {N : ℕ} (hN : 1 < N) (i : ℕ) :
    ∀ B : ℕ, ∃ n : ℕ, B < prefixExponent (fun _ => N) i n := by
  intro B
  refine ⟨B, ?_⟩
  rw [prefixExponent_const]
  exact Nat.lt_pow_self hN

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E] [CharZero C] [IsAlgClosed C]

variable {g : E} (hg : DifferentialIndependent C (fun _ : Unit ↦ g))
  (hgen : differentialAdjoin C (Set.range fun _ : Unit ↦ g) = ⊤)

/-- **Purely expanding rank-one isogeny-tail theorem.**  The stable tail of `g ↦ g ^ N` is the
Maurer--Cartan current field when `N > 1`. -/
theorem multiplicativePowerIsogenyTail_eq_logCurrent
    (hconst : ∀ c : C, c′ = 0) {N : ℕ} (hN : 1 < N) :
    stableRangeCore (powerEndo hg hgen (Nat.zero_lt_of_lt hN)) =
      differentialAdjoin C ({Differential.logDeriv g} : Set E) := by
  let hm : ∀ _ : ℕ, 0 < N := fun _ => Nat.zero_lt_of_lt hN
  have hroot : ∀ n : ℕ, ∃ zeta : C,
      IsPrimitiveRoot zeta (prefixExponent (fun _ => N) 0 n) := fun n =>
    exists_primitiveRoot_of_isAlgClosed C (prefixExponent_pos hm 0 n)
  have htail := (multiplicativeProtocol_nonautonomousTail_velocity_only
    hg hgen (fun _ => N) hm 0 hconst hroot
      (prefixExponent_const_unbounded hN 0)).1
  rw [← nonautonomousTail_const_eq_stableRangeCore
    (powerEndo hg hgen (Nat.zero_lt_of_lt hN)) 0]
  convert htail using 1
  apply congrArg (fun protocol => nonautonomousTail protocol 0)
  funext j
  apply powerEndo_congr hg hgen
  rfl

/-- **Rank-one zeroth-to-first-jet transmutation.**  The same stable tail is a single
hypertranscendental velocity coordinate and meets the rational position field only in constants. -/
theorem multiplicativePowerIsogenyTail_velocity_only
    (hconst : ∀ c : C, c′ = 0) {N : ℕ} (hN : 1 < N) :
    stableRangeCore (powerEndo hg hgen (Nat.zero_lt_of_lt hN)) =
        differentialAdjoin C ({Differential.logDeriv g} : Set E) ∧
      HypertranscendentalOver C (Differential.logDeriv g) ∧
      stableRangeCore (powerEndo hg hgen (Nat.zero_lt_of_lt hN)) ⊓
        IntermediateField.adjoin C ({g} : Set E) = ⊥ := by
  have htail := multiplicativePowerIsogenyTail_eq_logCurrent hg hgen hconst hN
  refine ⟨htail,
    logDeriv_hypertranscendentalOver (hypertranscendentalOver_gen hg) (gen_ne_zero hg), ?_⟩
  rw [htail]
  exact scalarLogCurrentField_inf_adjoin_eq_bot g (hypertranscendentalOver_gen hg)
    (gen_ne_zero hg) (differentialAdjoin_singleton_eq_top hgen) hconst

end


end GaloisForLFunctions.HTGeometry
