import GaloisForLFunctions.HTGeometry.FiniteShadowCapacitySpectrum
import Mathlib.NumberTheory.Real.Irrational
import Mathlib.Topology.Instances.AddCircle.Defs

/-!
# The split model refutes ambient faithfulness

In a split model `B × Q`, with `B` the maximal compact complex factor, an element of infinite
order in `B` generates a lattice which is injective in the ambient group and yet dies in the active
quotient `Q`.  Every observable trapped over that compact factor has a finite constant-coefficient
source presentation, and no finite palette supports an infinite differentially free family.  So
ambient faithfulness of the lattice, together with noncompactness of the ambient group, does not
force a completely free orbit: the original ambient condition is not the correct necessary one.

The same model exhibits the capacity dichotomy.  For every `n` there is a palette of `n`
differentially independent sources whose invertible recombinations realize capacity exactly `n`,
while no complete cyclic orbit drawn from that palette is differentially free.  Capacity is
unbounded over observables and finite for each one.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open Matrix GaloisForLFunctions

noncomputable section

/-! ### A lattice faithful in the ambient group and trivial in the active quotient -/

/-- The cyclic lattice generated by one element of the compact factor of a split model. -/
def splitCompactLattice {B Q : Type*} [AddCommGroup B] [AddCommGroup Q] (p : B) : ℤ →+ B × Q where
  toFun n := (n • p, 0)
  map_zero' := by simp
  map_add' m n := by simp [add_smul]

@[simp]
theorem splitCompactLattice_apply {B Q : Type*} [AddCommGroup B] [AddCommGroup Q] (p : B) (n : ℤ) :
    splitCompactLattice (Q := Q) p n = (n • p, 0) := rfl

/-- An element of infinite order generates an ambient-faithful lattice. -/
theorem splitCompactLattice_injective {B Q : Type*} [AddCommGroup B] [AddCommGroup Q]
    {p : B} (hp : ∀ n : ℤ, n • p = 0 → n = 0) :
    Function.Injective (splitCompactLattice (Q := Q) p) := by
  intro m n hmn
  have h : m • p = n • p := congrArg Prod.fst hmn
  have hsub : (m - n) • p = 0 := by
    rw [sub_smul, h, sub_self]
  have := hp _ hsub
  omega

/-- That lattice is invisible in the active quotient. -/
@[simp]
theorem splitCompactLattice_snd {B Q : Type*} [AddCommGroup B] [AddCommGroup Q] (p : B) (n : ℤ) :
    (splitCompactLattice (Q := Q) p n).2 = 0 := rfl

/-! ### Ambient faithfulness is not the correct necessary condition -/

/-- **The ambient-faithfulness conjecture is false.**  In a split model the cyclic lattice of an
infinite-order element of the compact factor is injective in the ambient group, is annihilated by
the active quotient, and — whenever the observable orbit along it has a finite constant-coefficient
source presentation, which relative rationality over the compact fibre always supplies — is not
differentially free. -/
theorem ambientFaithful_not_activeFaithful_not_free
    {B Q : Type*} [AddCommGroup B] [AddCommGroup Q] {p : B} (hp : ∀ n : ℤ, n • p = 0 → n = 0)
    {C K : Type*} [Field C] [CommRing K] [Algebra C K] [Differential K] {n : ℕ}
    (x : Fin n → K) (hx : DifferentialIndependent C x)
    (obs : ℤ → K) (coeff : ℤ → Fin n → C)
    (hconst : ∀ (m : ℤ) (j : Fin n), (algebraMap C K (coeff m j))′ = 0)
    (hobs : ∀ m, obs m = ∑ j, algebraMap C K (coeff m j) * x j) :
    Function.Injective (splitCompactLattice (Q := Q) p) ∧
      (∀ m : ℤ, (splitCompactLattice (Q := Q) p m).2 = 0) ∧
      ¬ DifferentialIndependent C obs :=
  ⟨splitCompactLattice_injective hp, fun m => splitCompactLattice_snd p m,
    not_differentialIndependent_cyclicOrbit_of_finitePalette x hx obs coeff hconst hobs⟩

/-! ### A concrete split elliptic witness -/

/-- The compact group underlying a complex elliptic curve. -/
abbrev EllipticShadowGroup : Type := AddCircle (1 : ℝ) × AddCircle (1 : ℝ)

/-- The group underlying the noncompact factor `ℂ*` of the split model. -/
abbrev PunctedPlaneGroup : Type := AddCircle (1 : ℝ) × ℝ

/-- An irrational rotation class has infinite order on the circle. -/
theorem zsmul_irrationalCircleClass_eq_zero_iff (n : ℤ)
    (h : n • ((Real.sqrt 2 : ℝ) : AddCircle (1 : ℝ)) = 0) : n = 0 := by
  by_contra hn
  rw [← AddCircle.coe_zsmul, AddCircle.coe_eq_zero_iff] at h
  obtain ⟨k, hk⟩ := h
  have hirr : Irrational ((n : ℝ) * Real.sqrt 2) := irrational_sqrt_two.intCast_mul hn
  have hval : ((k : ℤ) : ℝ) = (n : ℝ) * Real.sqrt 2 := by
    have h1 : (k : ℝ) * (1 : ℝ) = (n : ℝ) * Real.sqrt 2 := by
      simpa [zsmul_eq_mul] using hk
    simpa using h1
  exact (Int.not_irrational k) (hval ▸ hirr)

/-- A non-torsion point of the compact factor of the split elliptic model. -/
def ellipticShadowPoint : EllipticShadowGroup :=
  (((Real.sqrt 2 : ℝ) : AddCircle (1 : ℝ)), 0)

theorem zsmul_ellipticShadowPoint_eq_zero_iff (n : ℤ) (h : n • ellipticShadowPoint = 0) :
    n = 0 := by
  have h1 : n • ((Real.sqrt 2 : ℝ) : AddCircle (1 : ℝ)) = 0 := congrArg Prod.fst h
  exact zsmul_irrationalCircleClass_eq_zero_iff n h1

/-- **The split elliptic counterexample.**  In the group underlying `E × ℂ*`, the cyclic lattice
generated by a non-torsion point of `E` is injective in the ambient group and is annihilated by
the active quotient.  Ambient faithfulness therefore does not imply active faithfulness. -/
theorem splitElliptic_ambientFaithful_activeTrivial :
    Function.Injective
        (splitCompactLattice (Q := PunctedPlaneGroup) ellipticShadowPoint) ∧
      ∀ n : ℤ,
        (splitCompactLattice (Q := PunctedPlaneGroup) ellipticShadowPoint n).2 = 0 :=
  ⟨splitCompactLattice_injective zsmul_ellipticShadowPoint_eq_zero_iff,
    fun n => splitCompactLattice_snd _ n⟩

/-! ### The capacity dichotomy in the split model -/

/-- **Every finite capacity occurs, and only finite ones.**  For every `n` there is a palette of
`n` differentially independent sources; every invertible recombination of it realizes capacity `n`,
no family of `n + 1` observations mixed from it is free, and no complete cyclic orbit drawn from it
is free. -/
theorem splitModel_capacity_spectrum (C : Type*) [Field C] (n : ℕ) :
    ∃ x : Fin n → JetField C ℕ, DifferentialIndependent C x ∧
      (∀ M : Matrix (Fin n) (Fin n) C, M.det ≠ 0 →
        DifferentialIndependent C (matrixLinearForms M x)) ∧
      (∀ M : Matrix (Fin (n + 1)) (Fin n) C,
        ¬ DifferentialIndependent C (matrixLinearForms M x)) ∧
      (∀ (y : ℤ → JetField C ℕ) (coeff : ℤ → Fin n → C),
        (∀ m, y m = ∑ j, algebraMap C (JetField C ℕ) (coeff m j) * x j) →
        ¬ DifferentialIndependent C y) := by
  obtain ⟨x, hx, hfull, hover⟩ := capacity_spectrum_free C n
  refine ⟨x, hx, hfull, hover, ?_⟩
  intro y coeff hy
  exact not_differentialIndependent_cyclicOrbit_of_finitePalette x hx y coeff
    (fun m j => JetField.deriv_algebraMap (coeff m j)) hy

end

end GaloisForLFunctions.HTGeometry
