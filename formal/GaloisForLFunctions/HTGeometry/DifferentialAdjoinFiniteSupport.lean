import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# Finite support in an arbitrarily generated differential field

Every field expression is finitary.  Since `differentialAdjoin` is ordinary field adjunction of
all jets, every one of its elements already lies in the differential field generated by a finite
subfamily.  This is the finite-coordinate reduction needed by arbitrary-rank inverse limits.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {F E ι : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- Differential adjunction is monotone in its generating set. -/
theorem differentialAdjoin_mono {s t : Set E} (hst : s ⊆ t) :
    differentialAdjoin F s ≤ differentialAdjoin F t := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro y ⟨x, hx, n, rfl⟩
  exact differentialJet_mem_differentialAdjoin F (hst hx) n

/-- Every element of a differential field generated by an arbitrary family uses only finitely
many members of that family. -/
theorem mem_differentialAdjoin_range_exists_finset
    (x : ι → E) {z : E} (hz : z ∈ differentialAdjoin F (Set.range x)) :
    ∃ s : Finset ι, z ∈ differentialAdjoin F (x '' (s : Set ι)) := by
  classical
  let p : ∀ y : E, y ∈ differentialAdjoin F (Set.range x) → Prop :=
    fun y _ ↦ ∃ s : Finset ι, y ∈ differentialAdjoin F (x '' (s : Set ι))
  change p z hz
  refine IntermediateField.adjoin_induction F (p := p) ?_ ?_ ?_ ?_ ?_ hz
  · rintro y ⟨w, ⟨i, rfl⟩, n, rfl⟩
    refine ⟨{i}, differentialJet_mem_differentialAdjoin F ?_ n⟩
    exact ⟨i, by simp, rfl⟩
  · intro c
    exact ⟨∅, IntermediateField.algebraMap_mem _ c⟩
  · intro a b ha hb
    rintro ⟨s, hs⟩ ⟨t, ht⟩
    refine ⟨s ∪ t, IntermediateField.add_mem _ ?_ ?_⟩
    · exact (differentialAdjoin_mono (F := F)
        (Set.image_mono (by intro i hi; simp [hi]))) hs
    · exact (differentialAdjoin_mono (F := F)
        (Set.image_mono (by intro i hi; simp [hi]))) ht
  · intro a ha
    rintro ⟨s, hs⟩
    exact ⟨s, IntermediateField.inv_mem _ hs⟩
  · intro a b ha hb
    rintro ⟨s, hs⟩ ⟨t, ht⟩
    refine ⟨s ∪ t, IntermediateField.mul_mem _ ?_ ?_⟩
    · exact (differentialAdjoin_mono (F := F)
        (Set.image_mono (by intro i hi; simp [hi]))) hs
    · exact (differentialAdjoin_mono (F := F)
        (Set.image_mono (by intro i hi; simp [hi]))) ht

end

end GaloisForLFunctions.HTGeometry
