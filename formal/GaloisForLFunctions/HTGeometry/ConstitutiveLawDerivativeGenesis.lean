import Mathlib.Data.Fin.Basic

/-!
# Differential law genesis from one-hole contexts

A source-marked failure site in a polynomial law execution canonically exposes a one-hole context.
For composite executions, repair factors through nested inner and outer contexts, restores the
original execution when supplied the original leaf, and leaves every unrelated outer branch fixed.
Two failure sites have an exact same-branch/split-branch ancestry dichotomy.  A smallest finite
countermodel shows that an ancestry-blind observer identifies these distinct interaction types.

This module is source-independent.  It uses no RH, arithmetic, analytic, or physical premise.
-/

namespace GaloisForLFunctions.HTGeometry

universe u

/-- A polynomial law signature: shapes of legal composites and input positions for each shape. -/
structure LawContainer where
  Shape : Type u
  Pos : Shape → Type u

namespace LawContainer

/-- One executed law: a shape with one input value at every source position. -/
def Extension (C : LawContainer.{u}) (X : Type u) :=
  Σ s : C.Shape, C.Pos s → X

/-- A law context with one marked input removed. -/
def OneHoleContext (C : LawContainer.{u}) (X : Type u) :=
  Σ s : C.Shape, Σ p : C.Pos s, ∀ q : C.Pos s, q ≠ p → X

/-- A marked failure site canonically exposes the surrounding one-hole context. -/
def contextOfMarked (C : LawContainer.{u}) {X : Type u}
    (e : Extension C X) (p : C.Pos e.1) : OneHoleContext C X :=
  ⟨e.1, p, fun q _ => e.2 q⟩

/-- Plug a replacement value into a one-hole law context. -/
noncomputable def plug (C : LawContainer.{u}) {X : Type u}
    (c : OneHoleContext C X) (x : X) : Extension C X := by
  classical
  exact ⟨c.1, fun q => if h : q = c.2.1 then x else c.2.2 q h⟩

@[simp] theorem plug_at_hole (C : LawContainer.{u}) {X : Type u}
    (c : OneHoleContext C X) (x : X) :
    (plug C c x).2 c.2.1 = x := by
  simp [plug]

theorem plug_away (C : LawContainer.{u}) {X : Type u}
    (c : OneHoleContext C X) (x : X) {q : C.Pos c.1} (hq : q ≠ c.2.1) :
    (plug C c x).2 q = c.2.2 q hq := by
  simp [plug, hq]

/-- Plugging the original value into the context generated by a marked execution restores it. -/
theorem plug_contextOfMarked_restore (C : LawContainer.{u}) {X : Type u}
    (e : Extension C X) (p : C.Pos e.1) :
    plug C (contextOfMarked C e p) (e.2 p) = e := by
  classical
  rcases e with ⟨s, f⟩
  change (⟨s, fun q => if h : q = p then f p else f q⟩ : Extension C X) = ⟨s, f⟩
  congr 1
  funext q
  by_cases hq : q = p
  · subst q
    simp
  · simp [hq]

/-- Execution of a composite polynomial law. -/
def CompositeExtension (P Q : LawContainer.{u}) (X : Type u) :=
  Σ s : P.Shape, ∀ _ : P.Pos s, Extension Q X

/-- Leaf positions at which a composite execution can fail. -/
def CompositeSite {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) :=
  Σ p : P.Pos e.1, Q.Pos (e.2 p).1

/-- Outer context canonically exposed by a marked composite failure. -/
def outerFailureContext {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e) :
    OneHoleContext P (Extension Q X) :=
  contextOfMarked P ⟨e.1, e.2⟩ z.1

/-- Inner context canonically exposed by a marked composite failure. -/
def innerFailureContext {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e) :
    OneHoleContext Q X :=
  contextOfMarked Q (e.2 z.1) z.2

/-- Repair a composite failure by plugging through its inner and then outer contexts. -/
noncomputable def nestedRepair {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e) (x : X) :
    CompositeExtension P Q X :=
  plug P (outerFailureContext e z) (plug Q (innerFailureContext e z) x)

/-- Nested repair leaves every unrelated outer branch unchanged. -/
theorem nestedRepair_outer_away
    {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e) (x : X)
    {p : P.Pos e.1} (hp : p ≠ z.1) :
    (nestedRepair e z x).2 p = e.2 p := by
  simp [nestedRepair, outerFailureContext, plug, contextOfMarked, hp]

/-- **Nested context chain law.** Plugging the original failed leaf restores the whole composite. -/
theorem nestedRepair_original
    {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e) :
    nestedRepair e z ((e.2 z.1).2 z.2) = e := by
  unfold nestedRepair innerFailureContext outerFailureContext
  rw [plug_contextOfMarked_restore, plug_contextOfMarked_restore]
  cases e
  rfl

/-- Two failures interact inside one outer branch. -/
def SameOuterPair {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) :=
  {z : CompositeSite e × CompositeSite e // z.1.1 = z.2.1}

/-- Two failures interact across distinct outer branches. -/
def SplitOuterPair {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) :=
  {z : CompositeSite e × CompositeSite e // z.1.1 ≠ z.2.1}

/-- **Binary interaction partition law.** Every ordered failure pair has exactly one of two source
ancestries: both sites lie in one outer branch, or they lie in distinct outer branches. -/
theorem failurePair_interaction_partition
    {P Q : LawContainer.{u}} {X : Type u}
    (e : CompositeExtension P Q X) (z : CompositeSite e × CompositeSite e) :
    (z.1.1 = z.2.1 ∨ z.1.1 ≠ z.2.1) ∧
      ¬(z.1.1 = z.2.1 ∧ z.1.1 ≠ z.2.1) := by
  exact ⟨eq_or_ne _ _, fun h => h.2 h.1⟩

/-- Coarse observation that forgets all failure ancestry. -/
def forgetFailureAncestry {P Q : LawContainer.{u}} {X : Type u}
    {e : CompositeExtension P Q X} (_ : CompositeSite e × CompositeSite e) : Unit := ()

/-- Two outer branches with one inner site each: the smallest ancestry-loss countermodel. -/
def binaryOuterContainer : LawContainer :=
  ⟨Unit, fun _ => Fin 2⟩

def unaryInnerContainer : LawContainer :=
  ⟨Unit, fun _ => Unit⟩

def binaryCompositeExecution :
    CompositeExtension binaryOuterContainer unaryInnerContainer Unit :=
  ⟨(), fun _ => ⟨(), fun _ => ()⟩⟩

def binaryCompositeSiteZero : CompositeSite binaryCompositeExecution := by
  change Σ _ : Fin 2, Unit
  exact ⟨0, ()⟩

def binaryCompositeSiteOne : CompositeSite binaryCompositeExecution := by
  change Σ _ : Fin 2, Unit
  exact ⟨1, ()⟩

def sameBranchFailurePair :
    CompositeSite binaryCompositeExecution × CompositeSite binaryCompositeExecution :=
  (binaryCompositeSiteZero, binaryCompositeSiteZero)

def splitBranchFailurePair :
    CompositeSite binaryCompositeExecution × CompositeSite binaryCompositeExecution :=
  (binaryCompositeSiteZero, binaryCompositeSiteOne)

theorem ancestry_blind_observer_identifies_interactions :
    forgetFailureAncestry sameBranchFailurePair =
      forgetFailureAncestry splitBranchFailurePair := by
  rfl

theorem sameBranchFailurePair_is_same :
    sameBranchFailurePair.1.1 = sameBranchFailurePair.2.1 := by
  rfl

theorem splitBranchFailurePair_is_split :
    splitBranchFailurePair.1.1 ≠ splitBranchFailurePair.2.1 := by
  exact Fin.zero_ne_one

/-- Closed route-independent mechanism package. -/
theorem constitutiveLawDerivativeGenesis_closed :
    (∀ (C : LawContainer.{u}) (X : Type u) (e : Extension C X) (p : C.Pos e.1),
      plug C (contextOfMarked C e p) (e.2 p) = e) ∧
    (∀ {P Q : LawContainer.{u}} {X : Type u}
      (e : CompositeExtension P Q X) (z : CompositeSite e),
      nestedRepair e z ((e.2 z.1).2 z.2) = e) ∧
    (∀ {P Q : LawContainer.{u}} {X : Type u}
      (e : CompositeExtension P Q X) (z : CompositeSite e) (x : X)
      {p : P.Pos e.1}, p ≠ z.1 → (nestedRepair e z x).2 p = e.2 p) ∧
    (sameBranchFailurePair.1.1 = sameBranchFailurePair.2.1) ∧
    (splitBranchFailurePair.1.1 ≠ splitBranchFailurePair.2.1) ∧
    (forgetFailureAncestry sameBranchFailurePair =
      forgetFailureAncestry splitBranchFailurePair) := by
  exact ⟨plug_contextOfMarked_restore, nestedRepair_original, nestedRepair_outer_away,
    sameBranchFailurePair_is_same, splitBranchFailurePair_is_split,
    ancestry_blind_observer_identifies_interactions⟩

end LawContainer

end GaloisForLFunctions.HTGeometry

