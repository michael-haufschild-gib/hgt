import GaloisForLFunctions.HTGeometry.RootFamilyGalois
import GaloisForLFunctions.HTGeometry.BooleanHypercubeTranspositionLaw
import GaloisForLFunctions.HTGeometry.SplittingFieldPermTransport

/-!
# From hypercube edge swaps to the full symmetric Galois group

Transpositions along a connected graph generate the whole symmetric group, and the hypercube is
connected, so realizing every edge swap of the cube on a labelled root family forces the Galois
group to be symmetric.  No primitivity and no monodromy are involved.

## Main results

* `card_gal_eq_factorial_of_cubeSwaps` — the Galois group is `S_{2^N}`.
* `adjoin_range_corestrict_eq_top` — the field generated by a family is generated by it.
-/

open Polynomial
open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- **The Galois group is the full symmetric group on the cube** once every hypercube edge swap is
realized on a labelled root family. -/
theorem card_gal_eq_factorial_of_cubeSwaps
    {K E : Type*} [Field K] [Field E] [Algebra K E] {N : ℕ}
    (f : Polynomial K) [Fact (f.map (algebraMap K E)).Splits]
    {θ : (Fin N → Bool) → E} (hinj : Function.Injective θ)
    (hsplit : f.map (algebraMap K E) = ∏ x, (X - C (θ x)))
    (hswap : ∀ (x : Fin N → Bool) (i : Fin N),
      ∃ σ : E ≃ₐ[K] E, ∀ y, σ (θ y) = θ (Equiv.swap x (boolToggle x i) y)) :
    Nat.card f.Gal = (2 ^ N).factorial := by
  classical
  have hcard : Fintype.card (Fin N → Bool) = 2 ^ N := by simp
  rw [← hcard]
  refine card_gal_eq_factorial_of_rootFamily f hinj hsplit
    (S := hypercubeEdgeSwaps N) (closure_hypercubeEdgeSwaps N) ?_
  rintro π ⟨x, i, rfl⟩
  exact hswap x i

/-- The field generated by a family is generated, inside itself, by the corestricted family. -/
theorem adjoin_range_corestrict_eq_top {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    {ι : Type*} (g : ι → Ω) :
    IntermediateField.adjoin K
      (Set.range (fun x => (⟨g x, IntermediateField.subset_adjoin K _ ⟨x, rfl⟩⟩ :
        IntermediateField.adjoin K (Set.range g)))) = ⊤ := by
  classical
  set E : IntermediateField K Ω := IntermediateField.adjoin K (Set.range g) with hE
  set θ : ι → E := fun x => ⟨g x, IntermediateField.subset_adjoin K _ ⟨x, rfl⟩⟩ with hθ
  refine IntermediateField.map_injective E.val ?_
  have himage : (⇑E.val) '' Set.range θ = Set.range g := by
    ext w
    constructor
    · rintro ⟨-, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, rfl⟩
    · rintro ⟨x, rfl⟩
      exact ⟨θ x, ⟨x, rfl⟩, rfl⟩
  have hleft : (IntermediateField.adjoin K (Set.range θ)).map E.val = E := by
    rw [IntermediateField.adjoin_map, himage, ← hE]
  have hright : (⊤ : IntermediateField K E).map E.val = E := by
    refine SetLike.coe_injective ?_
    ext w
    constructor
    · rintro ⟨z, -, rfl⟩
      exact z.2
    · intro hw
      exact ⟨⟨w, hw⟩, trivial, rfl⟩
  rw [hleft, hright]

end

end GaloisForLFunctions.HTGeometry
