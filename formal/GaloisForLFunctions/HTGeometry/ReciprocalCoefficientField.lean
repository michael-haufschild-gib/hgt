import Mathlib.RingTheory.PowerSeries.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic.LinearCombination
import Mathlib.Algebra.Field.Subfield.Basic

/-!
# The reciprocal coefficients lie in the field generated by the jet coefficients

The coefficient equation of an inverse pair expresses each coefficient of the inverse through the
constant term of the jet, the earlier coefficients of the inverse, and the coefficients of the jet.

So every coefficient of the reciprocal jet lies in any subfield containing the coefficients of the
jet: the reciprocal packet adds no new field elements.
-/

namespace GaloisForLFunctions.HTGeometry

variable {A : Type*} [CommRing A]

/-- **The coefficient recurrence of an inverse pair.** -/
theorem constantCoeff_mul_coeff_inverse {X Y : PowerSeries A} (h : X * Y = 1) {n : ℕ}
    (hn : 0 < n) :
    PowerSeries.constantCoeff X * PowerSeries.coeff n Y =
      -∑ i ∈ Finset.Ico 1 (n + 1),
        PowerSeries.coeff i X * PowerSeries.coeff (n - i) Y := by
  have hcoeff : PowerSeries.coeff n (X * Y) = 0 := by
    rw [h, PowerSeries.coeff_one, if_neg (by omega)]
  rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at hcoeff
  have hsplit : ∑ i ∈ Finset.range (n + 1),
      PowerSeries.coeff i X * PowerSeries.coeff (n - i) Y =
      PowerSeries.coeff 0 X * PowerSeries.coeff n Y +
        ∑ i ∈ Finset.Ico 1 (n + 1),
          PowerSeries.coeff i X * PowerSeries.coeff (n - i) Y := by
    rw [Finset.range_eq_Ico,
      ← Finset.sum_Ico_consecutive _ (by omega : 0 ≤ 1) (by omega : 1 ≤ n + 1)]
    congr 1
    rw [Finset.sum_Ico_succ_top (by omega), Finset.Ico_self, Finset.sum_empty, zero_add,
      Nat.sub_zero]
  rw [hsplit] at hcoeff
  rw [PowerSeries.coeff_zero_eq_constantCoeff] at hcoeff
  linear_combination hcoeff

/-! ## The reciprocal coefficients generate nothing new -/

variable {F : Type*} [Field F]

/-- **Every coefficient of the inverse lies in any subfield containing the coefficients of the
jet.** -/
theorem coeff_inverse_mem_subfield {X Y : PowerSeries F} (h : X * Y = 1) (S : Subfield F)
    (hX : ∀ i, PowerSeries.coeff i X ∈ S) (n : ℕ) :
    PowerSeries.coeff n Y ∈ S := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    have h0 : PowerSeries.constantCoeff X * PowerSeries.constantCoeff Y = 1 := by
      have hc := congrArg PowerSeries.constantCoeff h
      rwa [map_mul, map_one] at hc
    have hx0 : PowerSeries.constantCoeff X ≠ 0 := left_ne_zero_of_mul_eq_one h0
    have hx0S : PowerSeries.constantCoeff X ∈ S := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff]
      exact hX 0
    rcases Nat.eq_zero_or_pos n with hn0 | hn
    · subst hn0
      have hval : PowerSeries.coeff 0 Y = (PowerSeries.constantCoeff X)⁻¹ := by
        rw [PowerSeries.coeff_zero_eq_constantCoeff]
        have hcalc : (PowerSeries.constantCoeff X)⁻¹ *
            (PowerSeries.constantCoeff X * PowerSeries.constantCoeff Y) =
            (PowerSeries.constantCoeff X)⁻¹ * 1 := by rw [h0]
        rw [inv_mul_cancel_left₀ hx0, mul_one] at hcalc
        exact hcalc
      rw [hval]
      exact S.inv_mem hx0S
    · have hrec := constantCoeff_mul_coeff_inverse h hn
      have hval : PowerSeries.coeff n Y =
          (PowerSeries.constantCoeff X)⁻¹ *
            (-∑ i ∈ Finset.Ico 1 (n + 1),
              PowerSeries.coeff i X * PowerSeries.coeff (n - i) Y) := by
        rw [← hrec, inv_mul_cancel_left₀ hx0]
      rw [hval]
      refine S.mul_mem (S.inv_mem hx0S) (S.neg_mem (sum_mem fun i hi => ?_))
      rw [Finset.mem_Ico] at hi
      exact S.mul_mem (hX i) (ih (n - i) (by omega))

end GaloisForLFunctions.HTGeometry
