import GaloisForLFunctions.HTGeometry.DifferentialIndependentTower
import GaloisForLFunctions.HTGeometry.WickContractedMatroidPersistence

/-!
# Rank additivity along a differential tower

The differential rank of a union is the rank of the first part plus the rank of the second part
measured over the differential field the first part generates.  One basis of each stage assembles
into a basis of the union: independence is the tower law for differential independence, spanning is
idempotence of the differential closure, and the two bases are disjoint because an independent
element is transcendental over the field the first stage generates.

This is the cardinal companion of the block criteria for a triangular source datum: the rank of the
whole family is the rank of its invariant block plus the rank of the complement over the block
field.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

/-- An element of a differentially independent set is transcendental over the coefficient field. -/
theorem transcendental_of_diffIndepOn {B E : Type u} [Field B] [Field E] [Algebra B E]
    [Differential E] {I : Set E} (hI : DiffIndepOn B I) {w : E} (hw : w ∈ I) :
    Transcendental B w := by
  have h : AlgebraicIndependent B fun p : I × ℕ => differentialJet p.2 (p.1 : E) := hI
  simpa using h.transcendental (⟨⟨w, hw⟩, 0⟩ : I × ℕ)

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
  [Differential F] [Differential E] [DifferentialAlgebra F E]

omit [Differential F] [DifferentialAlgebra F E] in
/-- **The tower law for differential independence, in set form.**  A base-independent set together
with a set independent over the differential field it generates is independent over the base. -/
theorem diffIndepOn_union_of_diffIndepOn_adjoin {I J : Set E}
    (hI : DiffIndepOn F I) (hJ : DiffIndepOn ↥(differentialAdjoin F I) J) :
    DiffIndepOn F (I ∪ J) := by
  classical
  have hrange : Set.range (Subtype.val : I → E) = I := Subtype.range_val
  have hsum : DifferentialIndependent F
      (Sum.elim (Subtype.val : J → E) (Subtype.val : I → E)) := by
    refine differentialIndependent_sumElim hI ?_
    rwa [hrange]
  have hkey : ∀ w : ↥(I ∪ J), Sum.elim (Subtype.val : J → E) (Subtype.val : I → E)
      (if h : (w : E) ∈ J then Sum.inl ⟨(w : E), h⟩
        else Sum.inr ⟨(w : E), w.2.resolve_right h⟩) = (w : E) := by
    intro w
    by_cases h : (w : E) ∈ J
    · rw [dif_pos h]; rfl
    · rw [dif_neg h]; rfl
  have hinj : Function.Injective fun w : ↥(I ∪ J) =>
      if h : (w : E) ∈ J then (Sum.inl ⟨(w : E), h⟩ : J ⊕ I)
        else Sum.inr ⟨(w : E), w.2.resolve_right h⟩ := by
    intro a b hab
    have h := congrArg (Sum.elim (Subtype.val : J → E) (Subtype.val : I → E)) hab
    rw [hkey a, hkey b] at h
    exact Subtype.ext h
  have hcomp := hsum.comp _ hinj
  show DifferentialIndependent F (Subtype.val : ↥(I ∪ J) → E)
  convert hcomp using 1
  funext w
  exact (hkey w).symm

variable [CharZero E]

/-- The union of a basis of a set with a basis of a second set over the field generated by the
first is a basis of the union. -/
theorem isBasis_union_of_isBasis {X Y I J : Set E}
    (hI : (differentialMatroid F E).IsBasis I X)
    (hJ : (differentialMatroid ↥(differentialAdjoin F X) E).IsBasis J Y) :
    (differentialMatroid F E).IsBasis (I ∪ J) (X ∪ Y) := by
  classical
  have hle : differentialAdjoin F I ≤ differentialAdjoin F X :=
    differentialAdjoin_le F (hI.subset.trans (subset_differentialAdjoin F X))
      (derivationClosed_differentialAdjoin F X)
  have hIJ : DiffIndepOn ↥(differentialAdjoin F I) J := by
    letI : Algebra ↥(differentialAdjoin F I) ↥(differentialAdjoin F X) :=
      (IntermediateField.inclusion hle).toAlgebra
    haveI : IsScalarTower ↥(differentialAdjoin F I) ↥(differentialAdjoin F X) E :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact DifferentialIndependent.restrictScalarsTower hJ.indep
  have hindep : DiffIndepOn F (I ∪ J) :=
    diffIndepOn_union_of_diffIndepOn_adjoin hI.indep hIJ
  refine Matroid.Indep.isBasis_of_subset_of_subset_closure hindep
    (Set.union_subset_union hI.subset hJ.subset) ?_
  intro w hw
  rw [differentialMatroid_mem_closure_iff_of_indep hindep w]
  have hXclos : ∀ v ∈ X, v ∈ differentialClosure F (I ∪ J) := by
    intro v hv
    have hvI : v ∈ differentialClosure F I :=
      (differentialMatroid_mem_closure_iff_of_indep hI.indep v).1 (hI.subset_closure hv)
    exact differentialClosure_mono (F := F) Set.subset_union_left hvI
  rcases hw with hw | hw
  · exact hXclos w hw
  · have hwB : DifferentialAlgebraicOver
        (differentialAdjoin (differentialAdjoin F X) J) w :=
      (differentialMatroid_mem_closure_iff_of_indep hJ.indep w).1 (hJ.subset_closure hw)
    have hw2 : w ∈ differentialClosure F (X ∪ J) :=
      (differentialAlgebraicOver_union_iff_nested X J w).2 hwB
    have hXJ : X ∪ J ⊆ differentialClosure F (I ∪ J) := by
      rintro v (hv | hv)
      · exact hXclos v hv
      · exact subset_differentialClosure _ (Set.mem_union_right _ hv)
    have hmono := differentialClosure_mono (F := F) hXJ
    rw [differentialClosure_idempotent] at hmono
    exact hmono hw2

/-- Two such bases are disjoint: an element independent over the field generated by the first set
cannot belong to that set. -/
theorem disjoint_of_isBasis {X Y I J : Set E}
    (hI : (differentialMatroid F E).IsBasis I X)
    (hJ : (differentialMatroid ↥(differentialAdjoin F X) E).IsBasis J Y) :
    Disjoint I J := by
  rw [Set.disjoint_left]
  intro w hwI hwJ
  have hmem : w ∈ differentialAdjoin F X := subset_differentialAdjoin F X (hI.subset hwI)
  refine transcendental_of_diffIndepOn hJ.indep hwJ ?_
  simpa using isAlgebraic_algebraMap (R := ↥(differentialAdjoin F X)) (A := E) ⟨w, hmem⟩

/-- **Differential rank is additive along a tower.**  The rank of a union over the base is the rank
of the first part plus the rank of the second part over the differential field the first part
generates. -/
theorem eRk_union_eq_eRk_add_eRk (X Y : Set E) :
    (differentialMatroid F E).eRk (X ∪ Y)
      = (differentialMatroid F E).eRk X
        + (differentialMatroid ↥(differentialAdjoin F X) E).eRk Y := by
  obtain ⟨I, hI⟩ := (differentialMatroid F E).exists_isBasis X
  obtain ⟨J, hJ⟩ := (differentialMatroid ↥(differentialAdjoin F X) E).exists_isBasis Y
  rw [← hI.encard_eq_eRk, ← hJ.encard_eq_eRk,
    ← (isBasis_union_of_isBasis hI hJ).encard_eq_eRk,
    Set.encard_union_eq (disjoint_of_isBasis hI hJ)]

end

end GaloisForLFunctions.HTGeometry
