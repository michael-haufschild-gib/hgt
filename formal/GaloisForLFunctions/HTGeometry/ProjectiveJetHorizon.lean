import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.Tactic

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

/-- The static field generated by all jets at or beyond derivative order `n`. -/
def jetTailField
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : E) (n : ℕ) : IntermediateField F E :=
  IntermediateField.adjoin F ((fun m => differentialJet m x) '' Set.Ici n)

theorem differentialJet_mem_jetTailField
    (F : Type*) {E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (x : E) {n m : ℕ} (hnm : n ≤ m) :
    differentialJet m x ∈ jetTailField F x n :=
  IntermediateField.subset_adjoin F _ ⟨m, hnm, rfl⟩

/-- HT supplies ordinary algebraic independence of the full one-sided jet sequence. -/
theorem algebraicIndependent_differentialJet_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) :
    AlgebraicIndependent F (fun n : ℕ => differentialJet n x) := by
  have hfull : DifferentialIndependent F (fun _ : Unit => x) :=
    (hypertranscendentalOver_iff_differentialIndependent_singleton F x).mp hx
  unfold DifferentialIndependent at hfull
  have h := AlgebraicIndependent.comp hfull (fun n : ℕ => ((), n)) (by
    intro m n hmn
    exact congrArg Prod.snd hmn)
  simpa using h

/-- Every jet lies beyond a genuine transcendence horizon formed by all its strict successors. -/
theorem hypertranscendentalOver_transcendental_over_strictJetTail
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) (n : ℕ) :
    Transcendental (jetTailField F x (n + 1)) (differentialJet n x) := by
  let j : ℕ → E := fun m => differentialJet m x
  have hj : AlgebraicIndependent F j :=
    algebraicIndependent_differentialJet_of_hypertranscendentalOver hx
  have hsub : Transcendental (Algebra.adjoin F (j '' Set.Ici (n + 1))) (j n) :=
    hj.transcendental_adjoin (Nat.not_succ_le_self n)
  exact (IntermediateField.transcendental_adjoin_iff).2 hsub

/-- In particular every individual jet of an HT element is transcendental over the base. -/
theorem hypertranscendentalOver_jet_transcendental
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) (n : ℕ) :
    Transcendental F (differentialJet n x) :=
  (algebraicIndependent_differentialJet_of_hypertranscendentalOver hx).transcendental n

private theorem iInter_image_Ici_eq_empty
    {E : Type*} {j : ℕ → E} (hj : Function.Injective j) :
    (⋂ n : ℕ, j '' Set.Ici n) = ∅ := by
  ext y
  constructor
  · intro hy
    rw [Set.mem_iInter] at hy
    obtain ⟨m, -, hmy⟩ := hy 0
    obtain ⟨k, hmk, hky⟩ := hy (m + 1)
    have hmkEq : m = k := hj (hmy.trans hky.symm)
    subst k
    exact (Nat.not_succ_le_self m hmk).elim
  · simp

/-- The intersection of all tails generated by an algebraically independent sequence contains
no transcendental information over the base. -/
theorem algebraicIndependent_iInf_tail_adjoin_le_algebraicClosure
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    {j : ℕ → E} (hj : AlgebraicIndependent F j) :
    (⨅ n : ℕ, IntermediateField.adjoin F (j '' Set.Ici n)) ≤
      algebraicClosure F E := by
  intro y hy
  let M : Matroid E := AlgebraicIndependent.matroid F E
  have hM : M.Indep (Set.range j) := by
    apply AlgebraicIndependent.matroid_indep_iff.mpr
    exact hj.to_subtype_range
  have hsub : ∀ n : ℕ, j '' Set.Ici n ⊆ Set.range j := by
    intro n _ h
    obtain ⟨m, -, rfl⟩ := h
    exact ⟨m, rfl⟩
  have hclosures : y ∈ ⋂ n : ℕ, M.closure (j '' Set.Ici n) := by
    rw [Set.mem_iInter]
    intro n
    rw [AlgebraicIndependent.matroid_closure_eq]
    apply (Subalgebra.mem_algebraicClosure _ _).2
    rw [← IntermediateField.isAlgebraic_adjoin_iff]
    let yn : IntermediateField.adjoin F (j '' Set.Ici n) :=
      ⟨y, (iInf_le (fun m : ℕ ↦ IntermediateField.adjoin F (j '' Set.Ici m)) n) hy⟩
    simpa [yn] using isAlgebraic_algebraMap yn
  have hclosureEmpty : y ∈ M.closure ∅ := by
    rw [← hM.closure_iInter_eq_biInter_closure_of_forall_subset hsub,
      iInter_image_Ici_eq_empty hj.injective] at hclosures
    exact hclosures
  rw [AlgebraicIndependent.matroid_closure_eq] at hclosureEmpty
  rw [mem_algebraicClosure_iff]
  rw [Algebra.adjoin_empty] at hclosureEmpty
  let e := Algebra.botEquiv F E
  letI : Algebra.IsAlgebraic F (⊥ : Subalgebra F E) :=
    ⟨fun z ↦ by
      have hz := isAlgebraic_algebraMap (R := F) (A := (⊥ : Subalgebra F E)) (e z)
      convert hz using 1
      change z = e.symm (e z)
      exact (e.symm_apply_apply z).symm⟩
  exact hclosureEmpty.restrictScalars F

/-- Relative tail zero-one law: information surviving every HT derivative horizon is algebraic
over the base field. -/
theorem hypertranscendentalOver_iInf_jetTailField_le_algebraicClosure
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) :
    (⨅ n : ℕ, jetTailField F x n) ≤ algebraicClosure F E :=
  algebraicIndependent_iInf_tail_adjoin_le_algebraicClosure
    (algebraicIndependent_differentialJet_of_hypertranscendentalOver hx)

/-- If the base is relatively algebraically closed in the ambient field, the HT jet tail is
exactly trivial: no non-base datum survives every derivative horizon. -/
theorem hypertranscendentalOver_iInf_jetTailField_eq_bot
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x)
    (hrel : algebraicClosure F E = ⊥) :
    (⨅ n : ℕ, jetTailField F x n) = ⊥ := by
  apply le_antisymm
  · rw [← hrel]
    exact hypertranscendentalOver_iInf_jetTailField_le_algebraicClosure hx
  · exact bot_le

/-- The jet-tail filtration of an HT element is strictly descending at every order. -/
theorem hypertranscendentalOver_jetTailField_strictAnti
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {x : E} (hx : HypertranscendentalOver F x) (n : ℕ) :
    jetTailField F x (n + 1) < jetTailField F x n := by
  apply lt_of_le_of_ne
  · rw [jetTailField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨m, hnm, rfl⟩
    exact differentialJet_mem_jetTailField F x
      (Nat.le_trans (Nat.le_succ n) hnm)
  · intro heq
    have hmem : differentialJet n x ∈ jetTailField F x (n + 1) := by
      rw [heq]
      exact differentialJet_mem_jetTailField F x le_rfl
    apply hypertranscendentalOver_transcendental_over_strictJetTail hx n
    let y : jetTailField F x (n + 1) := ⟨differentialJet n x, hmem⟩
    change IsAlgebraic (jetTailField F x (n + 1)) (differentialJet n x)
    simpa [y] using isAlgebraic_algebraMap y

end


end GaloisForLFunctions

namespace GaloisForLFunctions

noncomputable section

open Polynomial

/-- Pure coefficient-separation core: a genuine projective denominator cannot cross a
transcendental horizon while its velocity remains transcendental over the base. -/
theorem denominator_eq_zero_of_mobiusVelocity_mem_horizon
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (T : IntermediateField F E)
    (x : E) (y q : T)
    (a2 a1 a0 det c d : F)
    (hx : Transcendental T x)
    (hy : Transcendental F (y : E))
    (hdet : det ≠ 0)
    (hEq : (q : E) * (algebraMap F E c * x + algebraMap F E d) ^ 2 =
      algebraMap F E a2 * x ^ 2 + algebraMap F E a1 * x + algebraMap F E a0 +
        algebraMap F E det * (y : E)) :
    c = 0 := by
  by_contra hc
  let cT : T := algebraMap F T c
  let dT : T := algebraMap F T d
  let a2T : T := algebraMap F T a2
  let a1T : T := algebraMap F T a1
  let a0T : T := algebraMap F T a0
  let detT : T := algebraMap F T det
  let P : T[X] :=
    monomial 2 (q * cT ^ 2 - a2T) +
      monomial 1 (2 * q * cT * dT - a1T) +
      C (q * dT ^ 2 - a0T - detT * y)
  have hP_eval : Polynomial.aeval x P = 0 := by
    have hcalc : ((q : E) * algebraMap F E c ^ 2 - algebraMap F E a2) * x ^ 2 +
        ((2 : E) * (q : E) * algebraMap F E c * algebraMap F E d -
          algebraMap F E a1) * x +
        ((q : E) * algebraMap F E d ^ 2 - algebraMap F E a0 -
          algebraMap F E det * (y : E)) = 0 := by
      calc
      _ = (q : E) * (algebraMap F E c * x + algebraMap F E d) ^ 2 -
          (algebraMap F E a2 * x ^ 2 + algebraMap F E a1 * x +
            algebraMap F E a0 + algebraMap F E det * (y : E)) := by ring
      _ = 0 := sub_eq_zero.mpr hEq
    simp only [P, map_add, aeval_monomial, aeval_C, map_sub, map_mul, map_pow,
      map_ofNat, pow_one]
    convert hcalc using 1
    all_goals simp [cT, dT, a2T, a1T, a0T, detT]
    all_goals ring
  have hP_ne : P ≠ 0 := by
    intro hP
    have h2 := congrArg (fun R : T[X] => R.coeff 2) hP
    have h0 := congrArg (fun R : T[X] => R.coeff 0) hP
    simp only [P, coeff_add, coeff_monomial, coeff_C] at h2 h0
    norm_num [coeff_monomial, coeff_C] at h2 h0
    have hcT : cT ≠ 0 := by
      simpa [cT] using (algebraMap F T).injective.ne hc
    have hq : q = algebraMap F T (a2 / c ^ 2) := by
      calc
        q = a2T / cT ^ 2 := (eq_div_iff (pow_ne_zero 2 hcT)).2 (sub_eq_zero.mp h2)
        _ = algebraMap F T (a2 / c ^ 2) := by
          simp [cT, a2T, map_div₀, map_pow]
    rw [hq] at h0
    have hdetT : detT ≠ 0 := by
      simpa [detT] using (algebraMap F T).injective.ne hdet
    have hyT : y = algebraMap F T
        (((a2 / c ^ 2) * d ^ 2 - a0) / det) := by
      rw [map_div₀]
      apply (eq_div_iff hdetT).2
      have h0eq :
          algebraMap F T (a2 / c ^ 2) * dT ^ 2 - a0T = detT * y :=
        sub_eq_zero.mp h0
      simpa [cT, dT, a2T, a0T, detT, map_div₀, map_mul, map_pow,
        mul_comm] using h0eq.symm
    apply hy
    refine ⟨Polynomial.X - Polynomial.C
      (((a2 / c ^ 2) * d ^ 2 - a0) / det), ?_, ?_⟩
    · exact Polynomial.X_sub_C_ne_zero _
    · simp [hyT]
  exact hx ⟨P, hP_ne, hP_eval⟩

/-- Once the projective denominator is gone, horizon membership forces the affine slope velocity
to vanish. -/
theorem slopeVelocity_eq_zero_of_affineVelocity_mem_horizon
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (T : IntermediateField F E)
    (x : E) (y q : T)
    (slope alpha beta : F)
    (hx : Transcendental T x)
    (hEq : (q : E) = algebraMap F E slope * x +
      algebraMap F E alpha * (y : E) + algebraMap F E beta) :
    slope = 0 := by
  by_contra hslope
  let slopeT : T := algebraMap F T slope
  let alphaT : T := algebraMap F T alpha
  let betaT : T := algebraMap F T beta
  let xT : T := (q - alphaT * y - betaT) / slopeT
  have hslopeT : slopeT ≠ 0 := by
    simpa [slopeT] using (algebraMap F T).injective.ne hslope
  have hslopeTE : algebraMap T E slopeT ≠ 0 := by
    simpa using (algebraMap T E).injective.ne hslopeT
  have hxEq : x = algebraMap T E xT := by
    apply (eq_div_iff hslopeTE).2
    change x * algebraMap T E slopeT =
      algebraMap T E q - algebraMap T E alphaT * algebraMap T E y -
        algebraMap T E betaT
    have hslopeMap : algebraMap T E slopeT = algebraMap F E slope := by
      simp [slopeT]
    have halphaMap : algebraMap T E alphaT = algebraMap F E alpha := by
      simp [alphaT]
    have hbetaMap : algebraMap T E betaT = algebraMap F E beta := by
      simp [betaT]
    rw [hslopeMap, halphaMap, hbetaMap]
    change x * algebraMap F E slope =
      (q : E) - algebraMap F E alpha * (y : E) - algebraMap F E beta
    linear_combination -hEq
  apply hx
  rw [hxEq]
  exact isAlgebraic_algebraMap xT


/-- A nondegenerate Möbius denominator cannot vanish at an HT element. -/
theorem mobiusDenominator_ne_zero_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Differential E]
    [Algebra F E]
    (x : E) (hx : HypertranscendentalOver F x)
    (a b c d : F) (hdet : a * d - b * c ≠ 0) :
    algebraMap F E c * x + algebraMap F E d ≠ 0 := by
  intro hzero
  by_cases hc : c = 0
  · have had : a * d ≠ 0 := by simpa [hc] using hdet
    have hd : d ≠ 0 := fun hd0 => had (by simp [hd0])
    have hdE : algebraMap F E d ≠ 0 := by
      simpa using (algebraMap F E).injective.ne hd
    rw [hc] at hzero
    exact hdE (by simpa using hzero)
  · have hcE : algebraMap F E c ≠ 0 := by
      simpa using (algebraMap F E).injective.ne hc
    have hcx : algebraMap F E c * x = -algebraMap F E d :=
      eq_neg_of_add_eq_zero_left hzero
    have hxEq : x = algebraMap F E (-d / c) := by
      apply (mul_left_cancel₀ hcE)
      calc
        algebraMap F E c * x = -algebraMap F E d := hcx
        _ = algebraMap F E c * algebraMap F E (-d / c) := by
          rw [map_div₀, map_neg]
          field_simp [hcE]
    exact (hypertranscendentalOver_jet_transcendental hx 0) (by
      rw [show differentialJet 0 x = x by rfl, hxEq]
      exact isAlgebraic_algebraMap _)

/-- HT specialization of the denominator-separation lemma. -/
theorem mobiusDenominator_eq_zero_of_deriv_mem_jetTail
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x)
    (a b c d : F) (hdet : a * d - b * c ≠ 0)
    (hdenom : algebraMap F E c * x + algebraMap F E d ≠ 0)
    (hmem : (((algebraMap F E a * x + algebraMap F E b) /
      (algebraMap F E c * x + algebraMap F E d))′) ∈ jetTailField F x 1) :
    c = 0 := by
  let T : IntermediateField F E := jetTailField F x 1
  let y : T := ⟨x′, by
    have h := differentialJet_mem_jetTailField F x (n := 1) (m := 1) le_rfl
    simpa [differentialJet_succ] using h⟩
  let q : T :=
    ⟨((algebraMap F E a * x + algebraMap F E b) /
      (algebraMap F E c * x + algebraMap F E d))′, hmem⟩
  have hxT : Transcendental T x := by
    simpa [T] using
      (hypertranscendentalOver_transcendental_over_strictJetTail hx 0)
  have hyF : Transcendental F (y : E) := by
    simpa [y, differentialJet_succ] using
      (hypertranscendentalOver_jet_transcendental hx 1)
  have hEq : (q : E) * (algebraMap F E c * x + algebraMap F E d) ^ 2 =
      algebraMap F E (a′ * c - a * c′) * x ^ 2 +
        algebraMap F E (a′ * d + b′ * c - a * d′ - b * c′) * x +
        algebraMap F E (b′ * d - b * d′) +
        algebraMap F E (a * d - b * c) * (y : E) := by
    dsimp only [q, y]
    rw [Derivation.leibniz_div]
    simp only [smul_eq_mul, map_add, map_sub, map_mul, Derivation.leibniz,
      DifferentialAlgebra.deriv_algebraMap]
    field_simp [hdenom]
    ring
  exact denominator_eq_zero_of_mobiusVelocity_mem_horizon T x y q
    (a′ * c - a * c′)
    (a′ * d + b′ * c - a * d′ - b * c′)
    (b′ * d - b * d′) (a * d - b * c) c d hxT hyF hdet hEq

/-- The affine residual: first-tail membership forces the slope to be a differential constant. -/
theorem affineSlope_deriv_eq_zero_of_deriv_mem_jetTail
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x) (alpha beta : F)
    (hmem : ((algebraMap F E alpha * x + algebraMap F E beta)′) ∈
      jetTailField F x 1) :
    alpha′ = 0 := by
  let T : IntermediateField F E := jetTailField F x 1
  let y : T := ⟨x′, by
    have h := differentialJet_mem_jetTailField F x (n := 1) (m := 1) le_rfl
    simpa [differentialJet_succ] using h⟩
  let q : T := ⟨(algebraMap F E alpha * x + algebraMap F E beta)′, hmem⟩
  have hxT : Transcendental T x := by
    simpa [T] using
      (hypertranscendentalOver_transcendental_over_strictJetTail hx 0)
  have hEq : (q : E) = algebraMap F E alpha′ * x +
      algebraMap F E alpha * (y : E) + algebraMap F E beta′ := by
    dsimp only [q, y]
    rw [map_add, Derivation.leibniz, DifferentialAlgebra.deriv_algebraMap,
      DifferentialAlgebra.deriv_algebraMap]
    ring
  exact slopeVelocity_eq_zero_of_affineVelocity_mem_horizon
    T x y q alpha′ alpha beta′ hxT hEq

/-- Iterating a differential-constant affine change never mixes derivative orders. -/
theorem differentialJet_constSlopeAffine
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (alpha beta : F) (halpha : alpha′ = 0) (n : ℕ) :
    differentialJet n (algebraMap F E alpha * x + algebraMap F E beta) =
      algebraMap F E alpha * differentialJet n x +
        algebraMap F E (differentialJet n beta) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [differentialJet_succ, differentialJet_succ, differentialJet_succ, ih,
        map_add, Derivation.leibniz, DifferentialAlgebra.deriv_algebraMap,
        DifferentialAlgebra.deriv_algebraMap, halpha]
      simp

/-- Every static jet tail is invariant under a nonzero differential-constant affine change. -/
theorem jetTailField_constSlopeAffine_eq
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (alpha beta : F) (halpha : alpha′ = 0) (halpha0 : alpha ≠ 0)
    (n : ℕ) :
    jetTailField F (algebraMap F E alpha * x + algebraMap F E beta) n =
      jetTailField F x n := by
  apply le_antisymm
  · rw [jetTailField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨m, hnm, rfl⟩
    change differentialJet m
      (algebraMap F E alpha * x + algebraMap F E beta) ∈ jetTailField F x n
    rw [differentialJet_constSlopeAffine x alpha beta halpha m]
    exact add_mem
      (mul_mem (IntermediateField.algebraMap_mem _ alpha)
        (differentialJet_mem_jetTailField F x hnm))
      (IntermediateField.algebraMap_mem _ (differentialJet m beta))
  · rw [jetTailField, IntermediateField.adjoin_le_iff]
    rintro _ ⟨m, hnm, rfl⟩
    change differentialJet m x ∈
      jetTailField F (algebraMap F E alpha * x + algebraMap F E beta) n
    have hz := differentialJet_mem_jetTailField F
      (algebraMap F E alpha * x + algebraMap F E beta) hnm
    rw [differentialJet_constSlopeAffine x alpha beta halpha m] at hz
    have halphaE : algebraMap F E alpha ≠ 0 := by
      simpa using (algebraMap F E).injective.ne halpha0
    have hsolve : differentialJet m x =
        algebraMap F E alpha⁻¹ *
          ((algebraMap F E alpha * differentialJet m x +
              algebraMap F E (differentialJet m beta)) -
            algebraMap F E (differentialJet m beta)) := by
      simp [map_inv₀, halphaE]
    rw [hsolve]
    exact mul_mem (IntermediateField.algebraMap_mem _ alpha⁻¹)
      (sub_mem hz (IntermediateField.algebraMap_mem _ (differentialJet m beta)))

/-- Necessity half of the projective jet-horizon stabilizer law. -/
theorem mobiusJetHorizon_stabilizer_necessity
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x)
    (a b c d : F) (hdet : a * d - b * c ≠ 0)
    (hdenom : algebraMap F E c * x + algebraMap F E d ≠ 0)
    (hmem : (((algebraMap F E a * x + algebraMap F E b) /
      (algebraMap F E c * x + algebraMap F E d))′) ∈ jetTailField F x 1) :
    c = 0 ∧ (a / d)′ = 0 := by
  have hc := mobiusDenominator_eq_zero_of_deriv_mem_jetTail
    x hx a b c d hdet hdenom hmem
  have had : a * d ≠ 0 := by simpa [hc] using hdet
  have hd : d ≠ 0 := fun hd0 => had (by simp [hd0])
  have hdE : algebraMap F E d ≠ 0 := by
    simpa using (algebraMap F E).injective.ne hd
  have hzEq :
      (algebraMap F E a * x + algebraMap F E b) /
          (algebraMap F E c * x + algebraMap F E d) =
        algebraMap F E (a / d) * x + algebraMap F E (b / d) := by
    rw [hc]
    simp only [map_zero, zero_mul, zero_add, map_div₀]
    field_simp [hdE]
  have hmemAffine :
      ((algebraMap F E (a / d) * x + algebraMap F E (b / d))′) ∈
        jetTailField F x 1 := by
    rw [← hzEq]
    exact hmem
  exact ⟨hc, affineSlope_deriv_eq_zero_of_deriv_mem_jetTail
    x hx (a / d) (b / d) hmemAffine⟩

/-- The surviving parabolic subgroup preserves every positive-order (and order-zero) jet tail. -/
theorem mobiusJetTailField_eq_of_stabilizer
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (a b c d : F) (hdet : a * d - b * c ≠ 0)
    (hc : c = 0) (hslope : (a / d)′ = 0) (n : ℕ) :
    jetTailField F
        ((algebraMap F E a * x + algebraMap F E b) /
          (algebraMap F E c * x + algebraMap F E d)) n =
      jetTailField F x n := by
  have had : a * d ≠ 0 := by simpa [hc] using hdet
  have ha : a ≠ 0 := fun ha0 => had (by simp [ha0])
  have hd : d ≠ 0 := fun hd0 => had (by simp [hd0])
  have hdE : algebraMap F E d ≠ 0 := by
    simpa using (algebraMap F E).injective.ne hd
  have hzEq :
      (algebraMap F E a * x + algebraMap F E b) /
          (algebraMap F E c * x + algebraMap F E d) =
        algebraMap F E (a / d) * x + algebraMap F E (b / d) := by
    rw [hc]
    simp only [map_zero, zero_mul, zero_add, map_div₀]
    field_simp [hdE]
  rw [hzEq]
  exact jetTailField_constSlopeAffine_eq x (a / d) (b / d) hslope
    (div_ne_zero ha hd) n

/-- **Projective jet-horizon stabilizer law.**  At an HT element, equality of the first
positive-order jet tail under a nondegenerate Möbius change occurs exactly for the affine
transformations whose slope is a differential constant. -/
theorem mobius_jetTailField_one_eq_iff
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x)
    (a b c d : F) (hdet : a * d - b * c ≠ 0) :
    jetTailField F
        ((algebraMap F E a * x + algebraMap F E b) /
          (algebraMap F E c * x + algebraMap F E d)) 1 =
        jetTailField F x 1 ↔
      c = 0 ∧ (a / d)′ = 0 := by
  constructor
  · intro htail
    let z : E := (algebraMap F E a * x + algebraMap F E b) /
      (algebraMap F E c * x + algebraMap F E d)
    have hzTail : z′ ∈ jetTailField F z 1 := by
      have hz := differentialJet_mem_jetTailField F z (n := 1) (m := 1) le_rfl
      simpa [differentialJet_succ] using hz
    have hzTailX : z′ ∈ jetTailField F x 1 := by
      rw [← htail]
      exact hzTail
    exact mobiusJetHorizon_stabilizer_necessity x hx a b c d hdet
      (mobiusDenominator_ne_zero_of_hypertranscendentalOver x hx a b c d hdet)
      (by simpa [z] using hzTailX)
  · rintro ⟨hc, hslope⟩
    exact mobiusJetTailField_eq_of_stabilizer x a b c d hdet hc hslope 1

/-- Preservation of the whole jet-tail flag is already detected at its first horizon. -/
theorem mobius_all_jetTailField_eq_iff
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x)
    (a b c d : F) (hdet : a * d - b * c ≠ 0) :
    (∀ n : ℕ,
      jetTailField F
          ((algebraMap F E a * x + algebraMap F E b) /
            (algebraMap F E c * x + algebraMap F E d)) n =
        jetTailField F x n) ↔
      c = 0 ∧ (a / d)′ = 0 := by
  constructor
  · intro hall
    exact (mobius_jetTailField_one_eq_iff x hx a b c d hdet).mp (hall 1)
  · rintro ⟨hc, hslope⟩ n
    exact mobiusJetTailField_eq_of_stabilizer x a b c d hdet hc hslope n

/-- Projective inversion preserves the generated differential field but necessarily changes the
first HT jet horizon. -/
theorem jetTailField_inv_ne_of_hypertranscendentalOver
    {F E : Type*} [Field F] [Field E] [Differential F] [Differential E]
    [Algebra F E] [DifferentialAlgebra F E]
    (x : E) (hx : HypertranscendentalOver F x) :
    jetTailField F x⁻¹ 1 ≠ jetTailField F x 1 := by
  intro htail
  have hdet : (0 : F) * 0 - 1 * 1 ≠ 0 := by simp
  have hstab := (mobius_jetTailField_one_eq_iff x hx 0 1 1 0 hdet).mp (by
    simpa using htail)
  exact one_ne_zero hstab.1

end

end GaloisForLFunctions
