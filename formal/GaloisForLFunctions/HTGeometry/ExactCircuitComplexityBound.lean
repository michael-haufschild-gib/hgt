import GaloisForLFunctions.HTGeometry.CircuitCoordinateAdjoin

/-!
# Exact circuit complexity and transcendence

`CircuitCoordinateAdjoin` bounds the algebraic independence carried by a state *given* a
factorisation into gates.  Here the factorisation is quantified away: exact complexity is the least
number of gates preparing the state, and the bound becomes a statement about that number.

If each allowed gate has entries generated by `q` elements — `q = 16` for a two-qubit gate, whose
`4 × 4` matrix has sixteen entries — then a state whose coordinates carry `r` algebraically
independent numbers has exact complexity at least `r / q`.
-/

namespace GaloisForLFunctions.HTGeometry

namespace CircuitAdjoin

open Matrix

variable {K L : Type} [Field K] [CommRing L] [Algebra K L]
variable {n : Type*} [Fintype n] [DecidableEq n]

/-- A matrix whose entries are generated by `q` elements. -/
def GeneratedBy (K : Type) [Field K] [Algebra K L] (q : ℕ) (M : Matrix n n L) : Prop :=
  ∃ g : Fin q → L, ∀ i j, M i j ∈ Algebra.adjoin K (Set.range g)

omit [Fintype n] [DecidableEq n] in
/-- A list of gates, each generated by `q` elements, is generated by `length * q` elements. -/
theorem exists_generators_of_list (q : ℕ) (l : List (Matrix n n L))
    (h : ∀ M ∈ l, GeneratedBy (L := L) K q M) :
    ∃ g : Fin (l.length * q) → L,
      ∀ M ∈ l, ∀ i j, M i j ∈ Algebra.adjoin K (Set.range g) := by
  classical
  have hget : ∀ k : Fin l.length, GeneratedBy (L := L) K q (l.get k) :=
    fun k => h _ (l.get_mem k)
  choose gfun hgfun using hget
  set e : Fin (l.length * q) ≃ Fin l.length × Fin q := finProdFinEquiv.symm with he
  refine ⟨fun t => gfun (e t).1 (e t).2, ?_⟩
  intro M hM i j
  obtain ⟨k, hk⟩ := List.mem_iff_get.mp hM
  subst hk
  refine Algebra.adjoin_mono ?_ (hgfun k i j)
  rintro _ ⟨a, rfl⟩
  exact ⟨e.symm (k, a), by simp [he]⟩

/-- **The bound for one factorisation.** -/
theorem card_le_length_mul {q r : ℕ} (l : List (Matrix n n L)) (v : n → L)
    (hl : ∀ M ∈ l, GeneratedBy (L := L) K q M)
    (hv : ∀ i, ∃ c : K, v i = algebraMap K L c)
    {c : Fin r → n} (hc : AlgebraicIndependent K fun k => (l.prod *ᵥ v) (c k)) :
    r ≤ l.length * q := by
  obtain ⟨g, hg⟩ := exists_generators_of_list (K := K) q l hl
  exact card_le_of_algebraicIndependent_mulVec_baseInput l v hg hv hc

/-- `w` is preparable from `v` by `s` gates drawn from `𝒢`. -/
def PreparableIn (𝒢 : Set (Matrix n n L)) (v w : n → L) (s : ℕ) : Prop :=
  ∃ l : List (Matrix n n L), l.length = s ∧ (∀ M ∈ l, M ∈ 𝒢) ∧ l.prod *ᵥ v = w

/-- Exact preparation complexity: the least number of gates preparing `w` from `v`. -/
noncomputable def exactComplexity (𝒢 : Set (Matrix n n L)) (v w : n → L) : ℕ :=
  sInf {s | PreparableIn 𝒢 v w s}

/-- **Transcendence bounds exact complexity.**  A state carrying `r` algebraically independent
coordinates needs at least `r / q` gates. -/
theorem card_le_exactComplexity_mul {q r : ℕ} {𝒢 : Set (Matrix n n L)} {v w : n → L}
    (hprep : ∃ s, PreparableIn 𝒢 v w s)
    (h𝒢 : ∀ M ∈ 𝒢, GeneratedBy (L := L) K q M)
    (hv : ∀ i, ∃ c : K, v i = algebraMap K L c)
    {c : Fin r → n} (hc : AlgebraicIndependent K fun k => w (c k)) :
    r ≤ exactComplexity 𝒢 v w * q := by
  have hmem : exactComplexity 𝒢 v w ∈ {s | PreparableIn 𝒢 v w s} :=
    Nat.sInf_mem hprep
  obtain ⟨l, hlen, hl𝒢, hlw⟩ := hmem
  have hgen : ∀ M ∈ l, GeneratedBy (L := L) K q M := fun M hM => h𝒢 M (hl𝒢 M hM)
  have hc' : AlgebraicIndependent K fun k => (l.prod *ᵥ v) (c k) := by
    rw [hlw]; exact hc
  have := card_le_length_mul l v hgen hv hc'
  rwa [hlen] at this

/-! ## The transcendence-degree form -/

omit [DecidableEq n] in
/-- The generated algebra is monotone in the generating set. -/
theorem adjoin_le_adjoin_of_subset {S T : Set L} (h : S ⊆ T) :
    Algebra.adjoin K S ≤ Algebra.adjoin K T := Algebra.adjoin_mono h

/-- **Transcendence-degree form of the circuit bound.**  The coordinates of a state prepared from a
base-field input by gates each generated by `q` elements generate an algebra of transcendence
degree at most `q` times the number of gates.

This form composes: an invertible algebraic change of coordinates does not change the generated
algebra, so the bound may be applied in whichever coordinates the transcendence is known. -/
theorem trdeg_adjoin_le_length_mul [IsDomain L] {q : ℕ} (l : List (Matrix n n L)) (v : n → L)
    (hl : ∀ M ∈ l, GeneratedBy (L := L) K q M)
    (hv : ∀ i, ∃ c : K, v i = algebraMap K L c) :
    Algebra.trdeg K (Algebra.adjoin K (Set.range (l.prod *ᵥ v)))
      ≤ ((l.length * q : ℕ) : Cardinal) := by
  obtain ⟨g, hg⟩ := exists_generators_of_list (K := K) q l hl
  have hsub : Set.range (l.prod *ᵥ v) ⊆ Algebra.adjoin K (Set.range g) := by
    rintro _ ⟨i, rfl⟩
    exact mulVec_mem l v hg (fun j => mem_adjoin_of_eq_algebraMap_or_mem (Or.inl (hv j))) i
  have hle : Algebra.adjoin K (Set.range (l.prod *ᵥ v)) ≤ Algebra.adjoin K (Set.range g) :=
    Algebra.adjoin_le hsub
  refine le_trans (trdeg_le_of_injective (Subalgebra.inclusion hle) ?_)
    (trdeg_adjoin_range_le _ g)
  exact Subalgebra.inclusion_injective hle

end CircuitAdjoin

end GaloisForLFunctions.HTGeometry
