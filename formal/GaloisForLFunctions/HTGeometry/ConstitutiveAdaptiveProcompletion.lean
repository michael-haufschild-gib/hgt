import Mathlib.Data.Finset.Basic
import Mathlib.Tactic

/-!
# Adaptive experimental procompletion and effectivity gap

Effective laws are finite subsets of `ℕ`; their complete response profiles are Boolean
characteristic functions.  The ambient experimental procompletion contains every Boolean profile.
Every virtual profile is exactly realized on each finite query aperture.  More strongly, every
finite adaptive decision tree run against a virtual profile is exactly mimicked by an effective
finite-support law.  Nevertheless the constant-one virtual profile is not effective, so no finite
adaptive decision tree can classify effectivity.

All exported theorems are closed.  No computation tactic or project postulate is used.
-/

namespace GaloisForLFunctions.HTGeometry

universe u

/-- Complete Boolean response profile of a constitutive law. -/
abbrev ConstitutiveBooleanProfile := ℕ → Bool

/-- Response profile generated by a finite-support effective law. -/
def finiteLawProfile (F : Finset ℕ) : ConstitutiveBooleanProfile :=
  fun n ↦ if n ∈ F then true else false

/-- A complete profile is effective when one finite-support law generates it. -/
def ExperimentallyEffective (b : ConstitutiveBooleanProfile) : Prop :=
  ∃ F : Finset ℕ, finiteLawProfile F = b

/-- Every finite query aperture has some effective realization of the profile. -/
def FinitelyExperimentallyApproximable (b : ConstitutiveBooleanProfile) : Prop :=
  ∀ Q : Finset ℕ, ∃ F : Finset ℕ, ∀ n ∈ Q, finiteLawProfile F n = b n

/-- The finite-support profile records membership exactly. -/
@[simp] theorem finiteLawProfile_eq_true_iff (F : Finset ℕ) (n : ℕ) :
    finiteLawProfile F n = true ↔ n ∈ F := by
  simp [finiteLawProfile]

/-- Complete profiles distinguish effective finite-support laws. -/
theorem finiteLawProfile_injective : Function.Injective finiteLawProfile := by
  intro F G h
  ext n
  have hn := congrArg (fun value : Bool ↦ value = true) (congrFun h n)
  simpa using hn

/-- Every coherent Boolean profile has an effective realization on every finite aperture. -/
theorem everyProfile_finitelyExperimentallyApproximable
    (b : ConstitutiveBooleanProfile) :
    FinitelyExperimentallyApproximable b := by
  intro Q
  refine ⟨Q.filter (fun n ↦ b n = true), ?_⟩
  intro n hn
  cases hbn : b n <;> simp [finiteLawProfile, hn, hbn]

/-- The coherent boundary profile that answers true at every coordinate. -/
def constitutiveAllTrueProfile : ConstitutiveBooleanProfile :=
  fun _ ↦ true

/-- The all-true coherent profile is not generated by any finite-support law. -/
theorem constitutiveAllTrueProfile_not_effective :
    ¬ ExperimentallyEffective constitutiveAllTrueProfile := by
  rintro ⟨F, hF⟩
  let n := F.sum id + 1
  have hn : n ∉ F := by
    intro hnF
    have hle : n ≤ F.sum id := by
      exact Finset.single_le_sum (f := id) (fun _ _ ↦ Nat.zero_le _) hnF
    omega
  have hbad := congrFun hF n
  simp [finiteLawProfile, constitutiveAllTrueProfile, hn] at hbad

/-- Experimental coherence is strictly weaker than global effectivity. -/
theorem constitutiveExperimentalEffectivity_gap :
    FinitelyExperimentallyApproximable constitutiveAllTrueProfile ∧
      ¬ ExperimentallyEffective constitutiveAllTrueProfile :=
  ⟨everyProfile_finitelyExperimentallyApproximable _,
    constitutiveAllTrueProfile_not_effective⟩

/-- Finite adaptive experiment: either return a result or branch on one Boolean response. -/
inductive ConstitutiveAdaptiveExperiment (Result : Type u) where
  | outcome (value : Result)
  | query (coordinate : ℕ)
      (onFalse onTrue : ConstitutiveAdaptiveExperiment Result)

namespace ConstitutiveAdaptiveExperiment

/-- Execute a finite adaptive experiment against a complete response profile. -/
def run {Result : Type u} :
    ConstitutiveAdaptiveExperiment Result → ConstitutiveBooleanProfile → Result
  | .outcome value, _ => value
  | .query coordinate onFalse onTrue, b =>
      if b coordinate = true then run onTrue b else run onFalse b

/-- Coordinates encountered along the branch selected by a fixed profile. -/
def queryTrace {Result : Type u} :
    ConstitutiveAdaptiveExperiment Result → ConstitutiveBooleanProfile → Finset ℕ
  | .outcome _, _ => ∅
  | .query coordinate onFalse onTrue, b =>
      insert coordinate <|
        if b coordinate = true then queryTrace onTrue b else queryTrace onFalse b

/-- Finite effective support that retains exactly the true answers along one adaptive run. -/
def mimickingSupport {Result : Type u}
    (T : ConstitutiveAdaptiveExperiment Result) (b : ConstitutiveBooleanProfile) : Finset ℕ :=
  (queryTrace T b).filter (fun n ↦ b n = true)

/-- The mimicking support agrees with the virtual profile at every coordinate actually queried. -/
theorem finiteLawProfile_mimickingSupport_eq {Result : Type u}
    (T : ConstitutiveAdaptiveExperiment Result) (b : ConstitutiveBooleanProfile)
    (n : ℕ) (hn : n ∈ queryTrace T b) :
    finiteLawProfile (mimickingSupport T b) n = b n := by
  cases hbn : b n <;> simp [mimickingSupport, finiteLawProfile, hn, hbn]

/-- A finite adaptive run depends only on answers along its selected query trace. -/
theorem run_eq_of_eq_on_queryTrace {Result : Type u}
    (T : ConstitutiveAdaptiveExperiment Result) (b c : ConstitutiveBooleanProfile)
    (h : ∀ n ∈ queryTrace T b, c n = b n) :
    run T c = run T b := by
  induction T generalizing b c with
  | outcome value => rfl
  | query coordinate onFalse onTrue ihFalse ihTrue =>
      have hcoordinate : c coordinate = b coordinate := by
        apply h coordinate
        simp [queryTrace]
      cases hb : b coordinate with
      | false =>
          have hc : c coordinate = false := by simpa [hb] using hcoordinate
          simp only [run, hb, hc, Bool.false_eq_true, if_false]
          apply ihFalse
          intro n hn
          apply h n
          simp [queryTrace, hb, hn]
      | true =>
          have hc : c coordinate = true := by simpa [hb] using hcoordinate
          simp only [run, hb, hc, if_true]
          apply ihTrue
          intro n hn
          apply h n
          simp [queryTrace, hb, hn]

/-- Every finite adaptive experiment on every virtual profile is exactly mimicked by an
effective finite-support law. -/
theorem run_finiteLawProfile_mimickingSupport {Result : Type u}
    (T : ConstitutiveAdaptiveExperiment Result) (b : ConstitutiveBooleanProfile) :
    run T (finiteLawProfile (mimickingSupport T b)) = run T b := by
  apply run_eq_of_eq_on_queryTrace T b
  intro n hn
  exact finiteLawProfile_mimickingSupport_eq T b n hn

/-- Existential form of adaptive mimicry: every virtual run has an effective realization. -/
theorem exists_effectiveLaw_same_run {Result : Type u}
    (T : ConstitutiveAdaptiveExperiment Result) (b : ConstitutiveBooleanProfile) :
    ∃ F : Finset ℕ, run T (finiteLawProfile F) = run T b :=
  ⟨mimickingSupport T b, run_finiteLawProfile_mimickingSupport T b⟩

/-- No finite adaptive Boolean experiment accepts exactly all effective profiles. -/
theorem no_finiteAdaptive_effectivityClassifier :
    ¬ ∃ T : ConstitutiveAdaptiveExperiment Bool,
      (∀ F : Finset ℕ, run T (finiteLawProfile F) = true) ∧
        ∀ b : ConstitutiveBooleanProfile, ¬ ExperimentallyEffective b → run T b = false := by
  rintro ⟨T, hEffective, hIneffective⟩
  obtain ⟨F, hrun⟩ := exists_effectiveLaw_same_run T constitutiveAllTrueProfile
  have htrue := hEffective F
  have hfalse := hIneffective constitutiveAllTrueProfile
    constitutiveAllTrueProfile_not_effective
  have hbad : (true : Bool) = false := htrue.symm.trans (hrun.trans hfalse)
  simp at hbad

end ConstitutiveAdaptiveExperiment

end GaloisForLFunctions.HTGeometry
