import GaloisForLFunctions.HTGeometry.KroneckerPhaseWitness
import GaloisForLFunctions.HTGeometry.RealFiniteSubgroupBasis
import GaloisForLFunctions.HTGeometry.BohrBochnerFejerApprox
import GaloisForLFunctions.HTGeometry.BohrHullFrequency

/-!
# Bohr's module theorem

The frequency group of the hull is exactly the group generated by the spectrum.

One inclusion is elementary: a frequency with a nonzero Bohr coefficient has a uniformly continuous
character.  The converse is the classical module theorem, and the proof here is the Kronecker one.
Suppose `μ` is a hull frequency outside the group generated by the spectrum.  Approximate `f`
uniformly by a trigonometric polynomial with frequencies *in the spectrum*; replace those frequencies
by a rationally independent integral base of the group they generate, which does not enlarge that
group, so `μ` stays outside it.  Kronecker's theorem then produces translation numbers `τ` at which
every base character is near `1` — hence `τ` is an almost period of `f` — while the character of `μ`
sits near a fixed phase `≠ 1`.  Passing to a bounded multiple of `τ` makes that phase detectable at a
universal tolerance, contradicting uniform continuity of `t ↦ e^{iμt}` for the translation distance.
-/

open Filter Topology

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions

open _root_.HTGeometry

open scoped BigOperators

/-- Scaling the argument of a character by a natural number is the corresponding power. -/
theorem expChar_arg_nat_mul (mu t : ℝ) (m : ℕ) :
    expChar mu ((m : ℝ) * t) = (expChar mu t) ^ m := by
  simp only [expChar]
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

/-- **An integral combination of frequencies at an almost period.**  If every base character is
within `δ` of one, the character of an integral combination is within `k·M·δ`. -/
theorem norm_expChar_intComb_sub_one_le {k : ℕ} (β : Fin k → ℝ) (c : Fin k → ℤ) (τ : ℝ)
    {δ : ℝ} (hδ : 0 ≤ δ) (h : ∀ i, ‖expChar (β i) τ - 1‖ ≤ δ) :
    ‖expChar (∑ i : Fin k, (c i : ℝ) * β i) τ - 1‖
      ≤ (k : ℝ) * ((∑ i : Fin k, ((c i).natAbs : ℝ)) * δ) := by
  classical
  set M : ℝ := ∑ i : Fin k, ((c i).natAbs : ℝ) with hM
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun i _ => by positivity
  have hprod : expChar (∑ i : Fin k, (c i : ℝ) * β i) τ
      = ∏ i : Fin k, (expChar (β i) τ) ^ (c i) := by
    rw [← prod_expChar]
    exact Finset.prod_congr rfl fun i _ => expChar_int_mul (β i) τ (c i)
  have hone : (1 : ℂ) = ∏ i : Fin k, (1 : ℂ) ^ (c i) := by
    simp
  have hnorm_a : ∀ i ∈ (Finset.univ : Finset (Fin k)), ‖(expChar (β i) τ) ^ (c i)‖ ≤ 1 := by
    intro i _
    rw [norm_zpow, norm_expChar, one_zpow]
  have hnorm_b : ∀ i ∈ (Finset.univ : Finset (Fin k)), ‖(1 : ℂ) ^ (c i)‖ ≤ 1 := by
    intro i _
    rw [one_zpow, norm_one]
  have hdiff : ∀ i ∈ (Finset.univ : Finset (Fin k)),
      ‖(expChar (β i) τ) ^ (c i) - (1 : ℂ) ^ (c i)‖ ≤ M * δ := by
    intro i _
    have hz : ‖expChar (β i) τ‖ = 1 := norm_expChar _ _
    have hw : ‖(1 : ℂ)‖ = 1 := norm_one
    have hstep := norm_zpow_sub_zpow_le_of_norm_one hz hw (c i)
    have hcM : ((c i).natAbs : ℝ) ≤ M := by
      rw [hM]
      exact Finset.single_le_sum (f := fun j : Fin k => ((c j).natAbs : ℝ))
        (fun j _ => by positivity) (Finset.mem_univ i)
    refine hstep.trans ?_
    have h1 : ‖expChar (β i) τ - (1 : ℂ)‖ ≤ δ := h i
    exact mul_le_mul hcM h1 (norm_nonneg _) hM0
  have hbound := norm_prod_sub_prod_le
    (fun i : Fin k => (expChar (β i) τ) ^ (c i))
    (fun i : Fin k => (1 : ℂ) ^ (c i))
    (le_refl (1 : ℝ)) (by positivity : (0:ℝ) ≤ M * δ) Finset.univ hnorm_a hnorm_b hdiff
  rw [hprod, hone]
  refine hbound.trans (le_of_eq ?_)
  rw [Finset.card_univ, Fintype.card_fin, one_pow, mul_one]

/-- **A translation number of the base frequencies is an almost period.**  For a function within `η`
of a trigonometric polynomial, the translate moves by at most `2η` plus the motion of the
polynomial's characters. -/
theorem norm_translate_sub_le_of_spectral_approx {f : ℝ →ᵇ ℂ} {S : Finset ℝ} {a : ℝ → ℂ} {η : ℝ}
    (hclose : ∀ t : ℝ, ‖f t - ∑ lamv ∈ S, a lamv * expChar lamv t‖ ≤ η) (τ x : ℝ) :
    ‖f (x + τ) - f x‖ ≤ 2 * η + ∑ lamv ∈ S, ‖a lamv‖ * ‖expChar lamv τ - 1‖ := by
  classical
  set P : ℝ → ℂ := fun t => ∑ lamv ∈ S, a lamv * expChar lamv t with hP
  have hsplit : (f (x + τ) : ℂ) - f x
      = (f (x + τ) - P (x + τ)) + (P (x + τ) - P x) + (P x - f x) := by ring
  have hPdiff : P (x + τ) - P x
      = ∑ lamv ∈ S, a lamv * expChar lamv x * (expChar lamv τ - 1) := by
    rw [hP]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun lamv _ => ?_
    rw [expChar_add_arg]
    ring
  have hPbound : ‖P (x + τ) - P x‖ ≤ ∑ lamv ∈ S, ‖a lamv‖ * ‖expChar lamv τ - 1‖ := by
    rw [hPdiff]
    refine le_trans (norm_sum_le _ _) ?_
    refine Finset.sum_le_sum fun lamv _ => ?_
    rw [norm_mul, norm_mul, norm_expChar, mul_one]
  have h1 : ‖(f (x + τ) : ℂ) - P (x + τ)‖ ≤ η := hclose (x + τ)
  have h2 : ‖P x - (f x : ℂ)‖ ≤ η := by
    rw [norm_sub_rev]
    exact hclose x
  calc ‖(f (x + τ) : ℂ) - f x‖
      ≤ ‖(f (x + τ) : ℂ) - P (x + τ)‖ + ‖P (x + τ) - P x‖ + ‖P x - (f x : ℂ)‖ := by
        rw [hsplit]
        exact norm_add₃_le
    _ ≤ η + (∑ lamv ∈ S, ‖a lamv‖ * ‖expChar lamv τ - 1‖) + η := by
        exact add_le_add (add_le_add h1 hPbound) h2
    _ = 2 * η + ∑ lamv ∈ S, ‖a lamv‖ * ‖expChar lamv τ - 1‖ := by ring

/-- **Bohr's module theorem.**  Every frequency of the hull lies in the group generated by the
spectrum. -/
theorem bohrHullFrequencies_le_closure_bohrSpectrum {f : ℝ →ᵇ ℂ}
    (hf : UniformContinuous fun x => f x) (htb : HasTotallyBoundedOrbit fun x => f x) :
    bohrHullFrequencies f ≤ AddSubgroup.closure (bohrSpectrum fun x => f x) := by
  classical
  intro μ hμmem
  by_contra hnot
  have hμfreq : IsBohrHullFrequency f μ := hμmem
  rw [IsBohrHullFrequency, Metric.uniformContinuous_iff] at hμfreq
  obtain ⟨δf, hδfpos, hδf⟩ := hμfreq (1 / 2) (by norm_num)
  -- the spectral approximation
  obtain ⟨S, a, hSspec, hSclose⟩ := exists_trigPoly_spectrum_approx hf htb
    (show (0 : ℝ) < δf / 8 by linarith)
  -- a rationally independent integral base of the frequencies used
  set n : ℕ := S.card with hn
  set lam : Fin n → ℝ := fun i => ((S.equivFin.symm i : {x // x ∈ S}) : ℝ) with hlam
  have hlamrange : Set.range lam = (S : Set ℝ) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (S.equivFin.symm i).2
    · intro hy
      exact ⟨S.equivFin ⟨y, hy⟩, by simp [hlam]⟩
  obtain ⟨k, β, hβind, hβspan⟩ := exists_ratIndep_zBasis lam
  -- the frequency `μ` is outside the integral span of the base
  have hμspan : μ ∉ Submodule.span ℤ (Set.range β) := by
    intro hmem
    rw [hβspan, hlamrange] at hmem
    have hmem' : μ ∈ AddSubgroup.closure (S : Set ℝ) := by
      have hbridge := Submodule.span_int_eq_addSubgroupClosure (S : Set ℝ)
      rw [← hbridge]
      exact hmem
    exact hnot (AddSubgroup.closure_mono hSspec hmem')
  -- the phase witness and the detectable multiple
  obtain ⟨φ, hφ, hwit⟩ := exists_phase_witness hβind hμspan
  obtain ⟨m, hmpos, hcos⟩ := exists_nat_cos_le_half hφ
  -- the integral coordinates of the frequencies actually used
  have hcoeff : ∀ lamv ∈ S, ∃ c : Fin k → ℤ, lamv = ∑ i : Fin k, (c i : ℝ) * β i := by
    intro lamv hlamv
    have hmem : lamv ∈ Submodule.span ℤ (Set.range β) := by
      rw [hβspan, hlamrange]
      exact Submodule.subset_span hlamv
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hmem
    refine ⟨c, ?_⟩
    rw [← hc]
    exact (Finset.sum_congr rfl fun i _ => by rw [zsmul_eq_mul]).symm
  choose! c hc using hcoeff
  -- the constants
  set A : ℝ := ∑ lamv ∈ S, ‖a lamv‖ with hA
  have hA0 : 0 ≤ A := Finset.sum_nonneg fun lamv _ => norm_nonneg _
  set Mtot : ℝ := ∑ lamv ∈ S, ∑ i : Fin k, ((c lamv i).natAbs : ℝ) with hMtot
  have hMtot0 : 0 ≤ Mtot :=
    Finset.sum_nonneg fun lamv _ => Finset.sum_nonneg fun i _ => by positivity
  set C : ℝ := (A + 1) * ((m : ℝ) + 1) * ((k : ℝ) + 1) * (Mtot + 1) with hC
  have hCpos : 0 < C := by
    have h1 : (0 : ℝ) < A + 1 := by linarith
    have h2 : (0 : ℝ) < (m : ℝ) + 1 := by positivity
    have h3 : (0 : ℝ) < (k : ℝ) + 1 := by positivity
    have h4 : (0 : ℝ) < Mtot + 1 := by linarith
    rw [hC]
    positivity
  set δ' : ℝ := min (δf / (4 * C)) (1 / (2 * ((m : ℝ) + 1))) with hδ'
  have hδ'pos : 0 < δ' := by
    refine lt_min ?_ ?_
    · positivity
    · positivity
  obtain ⟨τ, hτβ, hτμ⟩ := hwit δ' hδ'pos
  -- the multiple
  set T : ℝ := (m : ℝ) * τ with hT
  -- (i) the translate `T` is an almost period of `f`
  have hbase : ∀ i : Fin k, ‖expChar (β i) τ - 1‖ ≤ δ' := fun i => (hτβ i).le
  have hlamT : ∀ lamv ∈ S, ‖expChar lamv T - 1‖ ≤ (m : ℝ) * ((k : ℝ) * (Mtot * δ')) := by
    intro lamv hlamv
    have hcomb := norm_expChar_intComb_sub_one_le β (c lamv) τ hδ'pos.le hbase
    have hle : ‖expChar lamv τ - 1‖ ≤ (k : ℝ) * (Mtot * δ') := by
      rw [hc lamv hlamv]
      refine hcomb.trans ?_
      have hsub : (∑ i : Fin k, ((c lamv i).natAbs : ℝ)) ≤ Mtot := by
        rw [hMtot]
        exact Finset.single_le_sum
          (f := fun lv : ℝ => ∑ i : Fin k, ((c lv i).natAbs : ℝ))
          (fun lv _ => Finset.sum_nonneg fun i _ => by positivity) hlamv
      have hk0 : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg _
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hsub hδ'pos.le) hk0
    have hpow : expChar lamv T = (expChar lamv τ) ^ m := by
      rw [hT, expChar_arg_nat_mul]
    have hone : (1 : ℂ) = (1 : ℂ) ^ m := by simp
    have hstep := norm_pow_sub_pow_le_of_norm_one (norm_expChar lamv τ) (norm_one) m
    rw [hpow, hone]
    refine hstep.trans ?_
    exact mul_le_mul_of_nonneg_left hle (Nat.cast_nonneg _)
  have hdist : dist (translateBC T f) (translateBC 0 f) < δf := by
    have hbound : ∀ x : ℝ, dist (translateBC T f x) (translateBC 0 f x)
        ≤ 2 * (δf / 8) + A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ'))) := by
      intro x
      have hval : dist (translateBC T f x) (translateBC 0 f x) = ‖(f (x + T) : ℂ) - f x‖ := by
        rw [translateBC_apply, translateBC_apply, add_zero, Complex.dist_eq]
      rw [hval]
      refine (norm_translate_sub_le_of_spectral_approx hSclose T x).trans ?_
      have hsum : ∑ lamv ∈ S, ‖a lamv‖ * ‖expChar lamv T - 1‖
          ≤ A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ'))) := by
        rw [hA, Finset.sum_mul]
        refine Finset.sum_le_sum fun lamv hlamv => ?_
        exact mul_le_mul_of_nonneg_left (hlamT lamv hlamv) (norm_nonneg _)
      linarith
    have hle : dist (translateBC T f) (translateBC 0 f)
        ≤ 2 * (δf / 8) + A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ'))) := by
      refine (BoundedContinuousFunction.dist_le ?_).mpr hbound
      have h1 : (0 : ℝ) ≤ 2 * (δf / 8) := by linarith
      have h2 : (0 : ℝ) ≤ A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ'))) := by
        have : (0 : ℝ) ≤ (m : ℝ) * ((k : ℝ) * (Mtot * δ')) := by positivity
        exact mul_nonneg hA0 this
      linarith
    have hsmall : A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ'))) ≤ δf / 4 := by
      have hδ'le : δ' ≤ δf / (4 * C) := min_le_left _ _
      have hprod : A * ((m : ℝ) * ((k : ℝ) * Mtot)) ≤ C := by
        have hm0 : (0:ℝ) ≤ (m : ℝ) := Nat.cast_nonneg _
        have hk0 : (0:ℝ) ≤ (k : ℝ) := Nat.cast_nonneg _
        have hX0 : (0:ℝ) ≤ (k : ℝ) * Mtot := by positivity
        have h1 : (k : ℝ) * Mtot ≤ ((k : ℝ) + 1) * (Mtot + 1) := by nlinarith [hMtot0, hk0]
        have h2 : (m : ℝ) * ((k : ℝ) * Mtot) ≤ ((m : ℝ) + 1) * (((k : ℝ) + 1) * (Mtot + 1)) :=
          mul_le_mul (by linarith) h1 hX0 (by linarith)
        have hY0 : (0:ℝ) ≤ (m : ℝ) * ((k : ℝ) * Mtot) := by positivity
        have h3 : A * ((m : ℝ) * ((k : ℝ) * Mtot))
            ≤ (A + 1) * (((m : ℝ) + 1) * (((k : ℝ) + 1) * (Mtot + 1))) :=
          mul_le_mul (by linarith) h2 hY0 (by linarith)
        rw [hC]
        linarith [h3]
      have hnn : (0 : ℝ) ≤ A * ((m : ℝ) * ((k : ℝ) * Mtot)) := by positivity
      have hrw : A * ((m : ℝ) * ((k : ℝ) * (Mtot * δ')))
          = (A * ((m : ℝ) * ((k : ℝ) * Mtot))) * δ' := by ring
      rw [hrw]
      calc (A * ((m : ℝ) * ((k : ℝ) * Mtot))) * δ' ≤ C * δ' :=
            mul_le_mul_of_nonneg_right hprod hδ'pos.le
        _ ≤ C * (δf / (4 * C)) := mul_le_mul_of_nonneg_left hδ'le hCpos.le
        _ = δf / 4 := by field_simp
    linarith
  -- (ii) the character of `μ` moves by at least one half
  have hμmove : (1 : ℝ) / 2 ≤ ‖expChar μ T - 1‖ := by
    have hpow : expChar μ T = (expChar μ τ) ^ m := by
      rw [hT, expChar_arg_nat_mul]
    have htarget : ‖Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - 1‖ ≥ 1 := by
      have hsq := norm_expChar_sub_sq ((m : ℝ) * φ) 0
      have hzero : Complex.exp (((0 : ℝ) : ℝ) * Complex.I) = 1 := by
        rw [Complex.ofReal_zero, zero_mul, Complex.exp_zero]
      rw [hzero, sub_zero] at hsq
      have hge : 1 ≤ ‖Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - 1‖ ^ 2 := by
        rw [hsq]
        linarith [hcos]
      nlinarith [norm_nonneg (Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - 1), hge]
    have hclosepow : ‖(expChar μ τ) ^ m - (Complex.exp ((φ : ℝ) * Complex.I)) ^ m‖
        ≤ (m : ℝ) * δ' := by
      have hstep := norm_pow_sub_pow_le_of_norm_one (norm_expChar μ τ)
        (Complex.norm_exp_ofReal_mul_I φ) m
      refine hstep.trans ?_
      exact mul_le_mul_of_nonneg_left hτμ.le (Nat.cast_nonneg _)
    have hpowtarget : (Complex.exp ((φ : ℝ) * Complex.I)) ^ m
        = Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) := by
      rw [← Complex.exp_nat_mul]
      congr 1
      push_cast
      ring
    have hmδ : (m : ℝ) * δ' ≤ 1 / 2 := by
      have hδ'le : δ' ≤ 1 / (2 * ((m : ℝ) + 1)) := min_le_right _ _
      have hm0 : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg _
      have hm1 : (0 : ℝ) < 2 * ((m : ℝ) + 1) := by positivity
      calc (m : ℝ) * δ' ≤ (m : ℝ) * (1 / (2 * ((m : ℝ) + 1))) :=
            mul_le_mul_of_nonneg_left hδ'le hm0
        _ ≤ 1 / 2 := by
            rw [mul_one_div, div_le_div_iff₀ hm1 (by norm_num : (0:ℝ) < 2)]
            linarith
    rw [hpow]
    have htri : ‖Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - 1‖
        ≤ ‖Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - (expChar μ τ) ^ m‖
          + ‖(expChar μ τ) ^ m - 1‖ := by
      have hsplit2 : Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - 1
          = (Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - (expChar μ τ) ^ m)
            + ((expChar μ τ) ^ m - 1) := by ring
      rw [hsplit2]
      exact norm_add_le _ _
    have hswap : ‖Complex.exp (((m : ℝ) * φ : ℝ) * Complex.I) - (expChar μ τ) ^ m‖
        ≤ (m : ℝ) * δ' := by
      rw [norm_sub_rev, ← hpowtarget]
      exact hclosepow
    linarith [htarget, htri, hswap, hmδ]
  -- (iii) the contradiction
  have hcontra : ‖expChar μ T - expChar μ (0 : ℝ)‖ < 1 / 2 := by
    have hd : dist (BohrLine.of f T) (BohrLine.of f 0) < δf := by
      rw [BohrLine.dist_eq]
      simpa using hdist
    have := hδf (a := BohrLine.of f T) (b := BohrLine.of f 0) hd
    rw [Complex.dist_eq] at this
    simpa using this
  have hzero : expChar μ (0 : ℝ) = 1 := by
    simp [expChar]
  rw [hzero] at hcontra
  linarith [hμmove, hcontra]

/-- **The frequency group of the hull is the group generated by the spectrum.** -/
theorem bohrHullFrequencies_eq_closure_bohrSpectrum {f : ℝ →ᵇ ℂ}
    (hf : UniformContinuous fun x => f x) (htb : HasTotallyBoundedOrbit fun x => f x) :
    bohrHullFrequencies f = AddSubgroup.closure (bohrSpectrum fun x => f x) :=
  le_antisymm (bohrHullFrequencies_le_closure_bohrSpectrum hf htb)
    (closure_bohrSpectrum_le_bohrHullFrequencies
      (isBohrAlmostPeriodic_of_hasTotallyBoundedOrbit htb))

end GaloisForLFunctions

namespace GaloisForLFunctions

/-- The phase rank of the hull is the rank of the group generated by the spectrum, so every bound on
the hull frequency rank is a bound on the rank of the Bohr–Fourier frequencies. -/
theorem rank_closure_bohrSpectrum_eq {f : ℝ →ᵇ ℂ} (hf : UniformContinuous fun x => f x)
    (htb : HasTotallyBoundedOrbit fun x => f x) :
    Module.rank ℤ (AddSubgroup.closure (bohrSpectrum fun x => f x))
      = Module.rank ℤ (bohrHullFrequencies f) := by
  rw [bohrHullFrequencies_eq_closure_bohrSpectrum hf htb]

end GaloisForLFunctions
