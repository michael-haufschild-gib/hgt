import GaloisForLFunctions.HTGeometry.RationalBasisIntegerCombination
import Mathlib.LinearAlgebra.Dimension.Finite

/-!
# Rational rank from integral rank

A bound on the `ℤ`-rank of the group generated by a set of reals bounds the `ℚ`-rank of its rational
span.  Every element of the rational span becomes an element of the group after multiplication by a
positive integer, and that rescaling preserves independence, so an independent family in the span
transports to one of the same size in the group.

This is the bridge between the two ways of measuring a frequency packet: the rank of the frequency
*group* (the invariant the hull produces) and the rank of the frequency *module* (the rational
invariant of the Bohr–Fourier expansion).
-/

namespace GaloisForLFunctions

open scoped BigOperators

/-- An element of the rational span becomes integral after multiplication by a positive integer. -/
theorem exists_nat_mul_mem_span_int {S : Set ℝ} {x : ℝ} (hx : x ∈ Submodule.span ℚ S) :
    ∃ N : ℕ, 0 < N ∧ ((N : ℝ) * x) ∈ Submodule.span ℤ S := by
  classical
  obtain ⟨n, q, g, hsum⟩ := Submodule.mem_span_set'.mp hx
  set N : ℕ := ∏ i : Fin n, (q i).den with hN
  have hNpos : 0 < N := Finset.prod_pos fun i _ => (q i).pos
  choose c hc using fun i : Fin n =>
    exists_int_nat_mul (q i) (Finset.dvd_prod_of_mem (fun i => (q i).den) (Finset.mem_univ i))
  rw [← hN] at hc
  refine ⟨N, hNpos, ?_⟩
  have hval : ((N : ℝ) * x) = ∑ i : Fin n, (c i : ℤ) • ((g i : ℝ)) := by
    rw [← hsum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hci : ((c i : ℤ) : ℝ) = (N : ℝ) * ((q i : ℚ) : ℝ) := by
      have := congrArg (fun x : ℚ => (x : ℝ)) (hc i)
      push_cast at this
      exact this.symm
    rw [zsmul_eq_mul, hci, Rat.smul_def]
    ring
  rw [hval]
  refine Submodule.sum_mem _ fun i _ => ?_
  exact Submodule.smul_mem _ _ (Submodule.subset_span (g i).2)

/-- **Rational rank is bounded by integral rank.**  A bound on the rank of the group generated by
`S` bounds the rank of the rational span of `S`. -/
theorem rank_span_rat_le_of_rank_closure_le {S : Set ℝ} {K : ℕ}
    (h : Module.rank ℤ (AddSubgroup.closure S) ≤ (K : Cardinal)) :
    Module.rank ℚ (Submodule.span ℚ S) ≤ (K : Cardinal) := by
  classical
  refine rank_le fun s hs => ?_
  -- scale each member of the independent family into the group
  have hmem : ∀ i : {x // x ∈ s}, ∃ N : ℕ, 0 < N ∧
      ((N : ℝ) * (((i : {x // x ∈ s}) : ↥(Submodule.span ℚ S)) : ℝ))
        ∈ AddSubgroup.closure S := by
    intro i
    obtain ⟨N, hNpos, hN⟩ := exists_nat_mul_mem_span_int
      (((i : {x // x ∈ s}) : ↥(Submodule.span ℚ S)).2)
    refine ⟨N, hNpos, ?_⟩
    rw [← Submodule.span_int_eq_addSubgroupClosure]
    exact hN
  choose N hNpos hNmem using hmem
  set w : {x // x ∈ s} → ↥(AddSubgroup.closure S) :=
    fun i => ⟨((N i : ℝ) * (((i : {x // x ∈ s}) : ↥(Submodule.span ℚ S)) : ℝ)), hNmem i⟩ with hw
  have hwind : LinearIndependent ℤ w := by
    rw [linearIndependent_iff']
    intro t cz hzero i hi
    -- transport the relation to the rational span
    have hreal : ∑ j ∈ t, ((cz j : ℝ) * (N j : ℝ))
        * (((j : {x // x ∈ s}) : ↥(Submodule.span ℚ S)) : ℝ) = 0 := by
      have hcoe := congrArg (fun z : ↥(AddSubgroup.closure S) => (z : ℝ)) hzero
      simp only [AddSubgroup.coe_zero] at hcoe
      rw [← hcoe]
      rw [AddSubgroup.val_finsetSum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [AddSubgroup.coe_zsmul, hw, zsmul_eq_mul]
      push_cast
      ring
    have hrat : ∑ j ∈ t, (((cz j : ℚ) * (N j : ℚ)) : ℚ)
        • ((j : {x // x ∈ s}) : ↥(Submodule.span ℚ S)) = 0 := by
      refine Subtype.ext ?_
      rw [Submodule.coe_sum, Submodule.coe_zero, ← hreal]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Submodule.coe_smul, Rat.smul_def]
      push_cast
      ring
    rw [linearIndependent_iff'] at hs
    have hz := hs t (fun j => ((cz j : ℚ) * (N j : ℚ))) hrat i hi
    have hNne : ((N i : ℚ)) ≠ 0 := by
      have : (0 : ℚ) < (N i : ℚ) := by exact_mod_cast hNpos i
      exact ne_of_gt this
    have hcz : ((cz i : ℚ)) = 0 := by
      rcases mul_eq_zero.mp hz with h1 | h2
      · exact h1
      · exact absurd h2 hNne
    exact_mod_cast hcz
  have hcard : (Cardinal.mk {x // x ∈ s}) ≤ Module.rank ℤ (AddSubgroup.closure S) :=
    hwind.cardinal_le_rank
  have hle : (s.card : Cardinal) ≤ (K : Cardinal) := by
    rw [← Cardinal.mk_coe_finset]
    exact le_trans hcard h
  exact_mod_cast hle

end GaloisForLFunctions
