import GaloisForLFunctions.HTGeometry.ProductOccupancyDichotomy
import Mathlib.Probability.Independence.ZeroOne

/-!
# Kolmogorov's zero-one law for a product of laws on `ℕ`

The coordinate σ-algebras of a Kolmogorov product are independent, so every event in the tail σ-algebra
`⨅ n, ⨆ i ≥ n, σ(coordinate i)` has measure zero or one.  This subsumes the "no intermediate regime"
half of the hitting dichotomy and extends it to every tail event, including ones no hitting criterion
reaches — densities of the hit set, convergence of series along it, and so on.

The hitting event itself is tail-measurable: dropping finitely many coordinates changes neither the
infinitude of the hit set nor, by `Filter.limsup_nat_add`, the limsup that describes it.
-/

open MeasureTheory ProbabilityTheory Filter

namespace GaloisForLFunctions.HTGeometry

/-- The σ-algebra generated by the `i`-th coordinate. -/
@[reducible] def coordSigma {ι : Type*} (i : ι) : MeasurableSpace (∀ _ : ι, ℕ) :=
  MeasurableSpace.comap (fun k => k i) inferInstance

theorem coordSigma_le {ι : Type*} (i : ι) :
    coordSigma i ≤ (inferInstance : MeasurableSpace (∀ _ : ι, ℕ)) :=
  (measurable_pi_apply i).comap_le

theorem measurableSet_localEvent_coordSigma {ι : Type*} (t : ι → Set ℕ) (i : ι) :
    MeasurableSet[coordSigma i] (localEvent t i) :=
  ⟨t i, MeasurableSet.of_discrete, rfl⟩

/-- Shifting the enumeration does not change the limsup of the hitting events. -/
theorem limsup_localEvent_shift {ι : Type*} (t : ι → Set ℕ) (e : ℕ ≃ ι) (n : ℕ) :
    Filter.limsup (fun j : ℕ => localEvent t (e (j + n))) Filter.atTop =
      {k : ∀ _ : ι, ℕ | (localHitSet t k).Infinite} := by
  rw [Filter.limsup_nat_add (fun m : ℕ => localEvent t (e m)) n]
  exact limsup_localEvent t e

/-- **The hitting event is a tail event.** -/
theorem measurableSet_tail_infiniteHit {ι : Type*} (t : ι → Set ℕ) (e : ℕ ≃ ι) :
    MeasurableSet[Filter.limsup (fun n : ℕ => coordSigma (e n)) Filter.atTop]
      {k : ∀ _ : ι, ℕ | (localHitSet t k).Infinite} := by
  rw [Filter.limsup_eq_iInf_iSup_of_nat, MeasurableSpace.measurableSet_iInf]
  intro n
  rw [← limsup_localEvent_shift t e n]
  refine @MeasurableSet.measurableSet_limsup _ (⨆ i ≥ n, coordSigma (e i)) _ (fun j => ?_)
  have hle : coordSigma (e (j + n)) ≤ ⨆ i ≥ n, coordSigma (e i) :=
    le_iSup₂ (f := fun i (_ : n ≤ i) => coordSigma (e i)) (j + n) (by omega)
  exact hle _ (measurableSet_localEvent_coordSigma t (e (j + n)))

section

variable {ι : Type*} (μ : ι → Measure ℕ) [∀ i, IsProbabilityMeasure (μ i)]

theorem iIndep_coordSigma :
    ProbabilityTheory.iIndep (fun i : ι => coordSigma i) (Measure.infinitePi μ) :=
  ProbabilityTheory.iIndepFun_infinitePi (X := fun _ => id) fun _ => measurable_id

theorem iIndep_coordSigma_comp (e : ℕ ≃ ι) :
    ProbabilityTheory.iIndep (fun n : ℕ => coordSigma (e n)) (Measure.infinitePi μ) :=
  ProbabilityTheory.iIndep.precomp (m := fun i : ι => coordSigma i) (g := e)
    e.injective (iIndep_coordSigma μ)

/-- **Kolmogorov's zero-one law for the product.**  Every tail event is trivial. -/
theorem measure_zero_or_one_of_tail (e : ℕ ≃ ι) {A : Set (∀ _ : ι, ℕ)}
    (hA : MeasurableSet[Filter.limsup (fun n : ℕ => coordSigma (e n)) Filter.atTop] A) :
    Measure.infinitePi μ A = 0 ∨ Measure.infinitePi μ A = 1 :=
  ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
    (fun n => coordSigma_le (e n)) (iIndep_coordSigma_comp μ e) hA

/-- The hitting event is trivial — the qualitative half of the dichotomy, now as an instance of the
zero-one law. -/
theorem measure_infiniteHit_eq_zero_or_one (t : ι → Set ℕ) (e : ℕ ≃ ι) :
    Measure.infinitePi μ {k : ∀ _ : ι, ℕ | (localHitSet t k).Infinite} = 0 ∨
      Measure.infinitePi μ {k : ∀ _ : ι, ℕ | (localHitSet t k).Infinite} = 1 :=
  measure_zero_or_one_of_tail μ e (measurableSet_tail_infiniteHit t e)

end

end GaloisForLFunctions.HTGeometry
