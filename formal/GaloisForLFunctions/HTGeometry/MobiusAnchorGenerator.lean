import GaloisForLFunctions.HTGeometry.MobiusFixedPoint
import GaloisForLFunctions.HTGeometry.DifferentialAdjoinMobiusGenerator

/-!
# The diagonalizing anchor coordinate is a differential generator

Combining the fixed-point diagonalization of a non-parabolic Möbius map
(`mobius_nonparabolic_scaling`) with the Möbius change of differential generator
(`differentialAdjoin_mobius_generator`): a `C`-algebra automorphism acting by a non-parabolic Möbius
transform on a differential generator `u` of the field has a coordinate `x = (u − p₁)/(u − p₂)` which
is again a differential generator and on which the automorphism acts as a pure scaling `σ x = ν · x`.

This produces the anchor hypothesis of the family-diagonalization theorem
`stableRangeCoreSymmetry_family_character` (equation (2)): once the differential Lüroth theorem gives
a generator `u`, diagonalizing one clock element yields the diagonalized generator `q = x` with its
anchor scaling.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

/-- **Anchor coordinate.**  A non-parabolic Möbius automorphism of a differential field generated by
`u` admits a differential generator `x` on which it acts by a pure scaling `σ x = ν · x`. -/
theorem mobius_anchor_generator
    {C E : Type*} [Field C] [IsAlgClosed C] [CharZero C]
    [Field E] [Algebra C E] [Differential C] [Differential E] [DifferentialAlgebra C E]
    (σ : E ≃ₐ[C] E) {a b c d : C} {u : E}
    (hσu : σ u * (algebraMap C E c * u + algebraMap C E d)
      = algebraMap C E a * u + algebraMap C E b)
    (hc : c ≠ 0) (hdisc : (d - a) ^ 2 + 4 * c * b ≠ 0)
    (hu_ne : ∀ p : C, u - algebraMap C E p ≠ 0)
    (hden : algebraMap C E c * u + algebraMap C E d ≠ 0)
    (htop : differentialAdjoin C ({u} : Set E) = ⊤) :
    ∃ (x : E) (ν : C), differentialAdjoin C ({x} : Set E) = ⊤ ∧ σ x = algebraMap C E ν * x := by
  obtain ⟨p₁, p₂, hp, hscaling⟩ := mobius_nonparabolic_scaling σ hσu hc hdisc hden hu_ne
  exact ⟨(u - algebraMap C E p₁) / (u - algebraMap C E p₂), (a - c * p₁) / (a - c * p₂),
    differentialAdjoin_mobius_generator hp (hu_ne p₂) htop, hscaling⟩

end GaloisForLFunctions.HTGeometry
