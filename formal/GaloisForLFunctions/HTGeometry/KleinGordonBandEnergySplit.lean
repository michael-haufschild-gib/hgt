import GaloisForLFunctions.HTGeometry.KleinGordonSelfAdjointMultiplier

/-!
# The energy is the sum of the band energies

A self-adjoint projection splits the energy space orthogonally: what it fixes is orthogonal to what it
annihilates. The flow keeps the two pieces of a trajectory in those two subspaces for all time, so
Pythagoras applies at every instant and the energy is exactly the sum of the two.

For a frequency-diagonal background the low-pass operators are self-adjoint projections and symmetries,
so a clock's energy is the sum of its band energies — each of them the energy of the solution
generated by that band of the datum, each separately governed by the estimate, at every time.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open MeasureTheory Filter Topology

variable {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
  [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

section Orthogonality

/-- The energy norm in components. -/
theorem norm_kgEnergy_sq (v : KGEnergy E) : ‖v‖ ^ 2 = ‖v.fst‖ ^ 2 + ‖v.snd‖ ^ 2 := by
  have h := norm_kgPair_sq (E := E) v.fst v.snd
  rwa [kgPair_fst_snd] at h

variable {Λ : Lp ℂ 2 (volume : Measure E) →L[ℂ] Lp ℂ 2 (volume : Measure E)}

theorem kgDiagOp_fixed_fst {v : KGEnergy E} (h : kgDiagOp Λ v = v) : Λ v.fst = v.fst := by
  have hc := congrArg (fun z : KGEnergy E => z.fst) h
  simpa [kgDiagOp_apply] using hc

theorem kgDiagOp_fixed_snd {v : KGEnergy E} (h : kgDiagOp Λ v = v) : Λ v.snd = v.snd := by
  have hc := congrArg (fun z : KGEnergy E => z.snd) h
  simpa [kgDiagOp_apply] using hc

theorem kgDiagOp_zero_fst {w : KGEnergy E} (h : kgDiagOp Λ w = 0) : Λ w.fst = 0 := by
  have hc := congrArg (fun z : KGEnergy E => z.fst) h
  simpa [kgDiagOp_apply] using hc

theorem kgDiagOp_zero_snd {w : KGEnergy E} (h : kgDiagOp Λ w = 0) : Λ w.snd = 0 := by
  have hc := congrArg (fun z : KGEnergy E => z.snd) h
  simpa [kgDiagOp_apply] using hc

/-- **What a self-adjoint projection fixes is orthogonal to what it annihilates.** -/
theorem inner_eq_zero_of_proj
    (hsa : ∀ x y : Lp ℂ 2 (volume : Measure E), (inner ℂ (Λ x) y : ℂ) = inner ℂ x (Λ y))
    {u w : Lp ℂ 2 (volume : Measure E)} (hu : Λ u = u) (hw : Λ w = 0) :
    (inner ℂ u w : ℂ) = 0 := by
  calc (inner ℂ u w : ℂ) = inner ℂ (Λ u) w := by rw [hu]
    _ = inner ℂ u (Λ w) := hsa u w
    _ = inner ℂ u (0 : Lp ℂ 2 (volume : Measure E)) := by rw [hw]
    _ = 0 := inner_zero_right u

set_option maxHeartbeats 1000000 in
/-- **Pythagoras on the energy space**, across a self-adjoint projection. -/
theorem norm_kgEnergy_add_sq
    (hsa : ∀ x y : Lp ℂ 2 (volume : Measure E), (inner ℂ (Λ x) y : ℂ) = inner ℂ x (Λ y))
    {v w : KGEnergy E} (hv : kgDiagOp Λ v = v) (hw : kgDiagOp Λ w = 0) :
    ‖v + w‖ ^ 2 = ‖v‖ ^ 2 + ‖w‖ ^ 2 := by
  have h1 : (inner ℂ v.fst w.fst : ℂ) = 0 :=
    inner_eq_zero_of_proj hsa (kgDiagOp_fixed_fst hv) (kgDiagOp_zero_fst hw)
  have h2 : (inner ℂ v.snd w.snd : ℂ) = 0 :=
    inner_eq_zero_of_proj hsa (kgDiagOp_fixed_snd hv) (kgDiagOp_zero_snd hw)
  have p1 := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero v.fst w.fst h1
  have p2 := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero v.snd w.snd h2
  have q1 : ‖v.fst + w.fst‖ ^ 2 = ‖v.fst‖ ^ 2 + ‖w.fst‖ ^ 2 := by
    rw [pow_two, pow_two, pow_two]
    exact p1
  have q2 : ‖v.snd + w.snd‖ ^ 2 = ‖v.snd‖ ^ 2 + ‖w.snd‖ ^ 2 := by
    rw [pow_two, pow_two, pow_two]
    exact p2
  rw [norm_kgEnergy_sq, norm_kgEnergy_sq, norm_kgEnergy_sq, kgEnergy_fst_add, kgEnergy_snd_add,
    q1, q2]
  ring

end Orthogonality

section BandEnergySplit

variable {b : ℝ} {w : ℝ → E → ℂ}

set_option maxHeartbeats 1000000 in
/-- **The state splits orthogonally across every band, at every time.** -/
theorem norm_kgFieldStateT_band_split (hw : ∀ r : ℝ, Measurable (w r)) (hb0 : 0 ≤ b)
    (hwb : ∀ (r : ℝ) (ξ : E), ‖w r ξ‖ ≤ b)
    (hWs : ∀ x : Lp ℂ 2 (volume : Measure E),
      Continuous fun r : ℝ => (fourierMulCLM (hw r) hb0 (hwb r)) x)
    (R : ℝ) (g h : Lp ℂ 2 (volume : Measure E)) (t : ℝ) :
    ‖kgFieldStateT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r)) g h t‖ ^ 2
      = ‖kgFieldStateT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
            (kgLowPassOp R g) (kgLowPassOp R h) t‖ ^ 2
        + ‖kgFieldStateT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
            (g - kgLowPassOp R g) (h - kgLowPassOp R h) t‖ ^ 2 := by
  obtain ⟨hsum, hlow, hhigh⟩ := kgFieldStateT_band_decouple hw hb0 hwb hWs R g h t
  rw [hsum]
  exact norm_kgEnergy_add_sq (kgLowPassOp_inner R) hlow hhigh

set_option maxHeartbeats 1000000 in
/-- **A clock's energy is the sum of its band energies**, at every instant: each band evolves on its
own and contributes its own energy, and the two add up exactly. -/
theorem kgFieldEnergyT_band_split (hw : ∀ r : ℝ, Measurable (w r)) (hb0 : 0 ≤ b)
    (hwb : ∀ (r : ℝ) (ξ : E), ‖w r ξ‖ ≤ b)
    (hWs : ∀ x : Lp ℂ 2 (volume : Measure E),
      Continuous fun r : ℝ => (fourierMulCLM (hw r) hb0 (hwb r)) x)
    (R : ℝ) (g h : Lp ℂ 2 (volume : Measure E)) (t : ℝ) :
    ‖kgFieldGradT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r)) g h t‖ ^ 2
        + ‖kgFieldVelT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r)) g h t‖ ^ 2
      = (‖kgFieldGradT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
              (kgLowPassOp R g) (kgLowPassOp R h) t‖ ^ 2
          + ‖kgFieldVelT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
              (kgLowPassOp R g) (kgLowPassOp R h) t‖ ^ 2)
        + (‖kgFieldGradT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
              (g - kgLowPassOp R g) (h - kgLowPassOp R h) t‖ ^ 2
          + ‖kgFieldVelT (fun r : ℝ => fourierMulCLM (hw r) hb0 (hwb r))
              (g - kgLowPassOp R g) (h - kgLowPassOp R h) t‖ ^ 2) := by
  rw [kgFieldEnergyT_eq_norm_sq, kgFieldEnergyT_eq_norm_sq, kgFieldEnergyT_eq_norm_sq]
  exact norm_kgFieldStateT_band_split hw hb0 hwb hWs R g h t

end BandEnergySplit

end GaloisForLFunctions.HTGeometry
