import GaloisForLFunctions.HTGeometry.LoopEisenstein.ValuedSL2Iwasawa
import GaloisForLFunctions.HTGeometry.LoopEisenstein.VertexGeneration

/-!
# Existence of valued loop Iwasawa factors

The exact valued rank-one decomposition covers both vertex parabolics by
Borel and their integral simple subgroups. Vertex generation then gives
both left and right Iwasawa factorizations for every actual central loop.
-/

namespace GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2
open scoped WithZero WithZeroMulInt
noncomputable section
variable {F : Type*} [Field F] (v : Valuation F ℤᵐ⁰)

/-- Integral finite simple matrices inside the central loop group. -/
def finiteIntegralSimple : Subgroup (LoopSL2 F) :=
  (valuationIntegralSL2 v).map (finiteSL2Embedding F)

/-- Integral affine simple matrices inside the central loop group. -/
def affineIntegralSimple : Subgroup (LoopSL2 F) :=
  (valuationIntegralSL2 v).map (affineSimpleSL2Embedding F)

/-- The subgroup generated by the two actual integral rank-one subgroups. -/
def integralSimpleLoop : Subgroup (LoopSL2 F) :=
  finiteIntegralSimple v ⊔ affineIntegralSimple v

private theorem finiteSimple_valued_iwasawa (h : SL2 F) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v,
      b * k = finiteSL2Embedding F h := by
  obtain ⟨b, k, hb, hk, he, _⟩ := exists_valued_sl2_upper_integral v h
  refine ⟨finiteSL2Embedding F b, finiteSL2Embedding_upperTriangular F _ hb,
    finiteSL2Embedding F k, ?_, ?_⟩
  · exact Subgroup.mem_sup_left ⟨k, hk, rfl⟩
  · rw [← map_mul, he]

private theorem affineSimple_valued_iwasawa (h : SL2 F) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v,
      b * k = affineSimpleSL2Embedding F h := by
  obtain ⟨b, k, hb, hk, he, _⟩ := exists_valued_sl2_upper_integral v h
  refine ⟨affineSimpleSL2Embedding F b, affineSimpleSL2Embedding_upperTriangular F _ hb,
    affineSimpleSL2Embedding F k, ?_, ?_⟩
  · exact Subgroup.mem_sup_right ⟨k, hk, rfl⟩
  · rw [← map_mul, he]

private theorem positiveVertex_valued_iwasawa {g : LoopSL2 F} (hg : g ∈ positiveVertex F) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = g := by
  obtain ⟨b₀, hb₀, h, he₀⟩ := positiveVertex_borel_finite F hg
  obtain ⟨b, hb, k, hk, he⟩ := finiteSimple_valued_iwasawa v h
  refine ⟨b₀ * b, (positiveBorel F).mul_mem hb₀ hb, k, hk, ?_⟩
  rw [mul_assoc, he, he₀]

private theorem affineVertex_valued_iwasawa {g : LoopSL2 F} (hg : g ∈ affineVertex F) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = g := by
  obtain ⟨b₀, hb₀, h, he₀⟩ := affineVertex_borel_affine F hg
  obtain ⟨b, hb, k, hk, he⟩ := affineSimple_valued_iwasawa v h
  refine ⟨b₀ * b, (positiveBorel F).mul_mem hb₀ hb, k, hk, ?_⟩
  rw [mul_assoc, he, he₀]

private theorem vertex_left_mul_valued_iwasawa {x y : LoopSL2 F}
    (hx : x ∈ positiveVertex F ∨ x ∈ affineVertex F)
    (hy : ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = y) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = x * y := by
  obtain ⟨b, hb, k, hk, he⟩ := hy
  have hxb : ∃ b' ∈ positiveBorel F, ∃ k' ∈ integralSimpleLoop v, b' * k' = x * b := by
    rcases hx with hx | hx
    · exact positiveVertex_valued_iwasawa v
        ((positiveVertex F).mul_mem hx (positiveBorel_le_positiveVertex F hb))
    · exact affineVertex_valued_iwasawa v
        ((affineVertex F).mul_mem hx (positiveBorel_le_affineVertex F hb))
  obtain ⟨b', hb', k', hk', he'⟩ := hxb
  refine ⟨b', hb', k' * k, (integralSimpleLoop v).mul_mem hk' hk, ?_⟩
  rw [← mul_assoc, he', mul_assoc, he]

/-- Every actual loop is Borel times the subgroup generated by integral simple matrices. -/
theorem exists_valued_loop_borel_integral (g : LoopSL2 F) :
    ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = g := by
  have hclosure : Subgroup.closure
      ((positiveVertex F : Set (LoopSL2 F)) ∪ (affineVertex F : Set (LoopSL2 F))) = ⊤ := by
    rw [Subgroup.closure_union]
    simpa only [Subgroup.closure_eq] using vertex_sup_eq_top F
  have hg : g ∈ Subgroup.closure
      ((positiveVertex F : Set (LoopSL2 F)) ∪ (affineVertex F : Set (LoopSL2 F))) := by
    rw [hclosure]
    trivial
  refine Subgroup.closure_induction_left
    (p := fun x _ => ∃ b ∈ positiveBorel F, ∃ k ∈ integralSimpleLoop v, b * k = x)
    ?_ ?_ ?_ hg
  · exact ⟨1, (positiveBorel F).one_mem, 1, (integralSimpleLoop v).one_mem, one_mul 1⟩
  · intro x hx y _ hy
    exact vertex_left_mul_valued_iwasawa v hx hy
  · intro x hx y _ hy
    apply vertex_left_mul_valued_iwasawa v (y := y) _ hy
    rcases hx with hx | hx
    · exact Or.inl ((positiveVertex F).inv_mem hx)
    · exact Or.inr ((affineVertex F).inv_mem hx)

/-- The right-Borel convention follows by inversion of the actual factors. -/
theorem exists_valued_loop_integral_borel (g : LoopSL2 F) :
    ∃ k ∈ integralSimpleLoop v, ∃ b ∈ positiveBorel F, k * b = g := by
  obtain ⟨b, hb, k, hk, he⟩ := exists_valued_loop_borel_integral v g⁻¹
  refine ⟨k⁻¹, (integralSimpleLoop v).inv_mem hk, b⁻¹, (positiveBorel F).inv_mem hb, ?_⟩
  rw [← mul_inv_rev, he, inv_inv]

/-- Actual integral, central, finite-torus and completed-unipotent factors. -/
theorem exists_valued_loop_integral_torus_unipotent (g : LoopSL2 F) :
    ∃ k ∈ integralSimpleLoop v, ∃ c a : Fˣ, ∃ u : positiveUnipotentMatrices F,
      k * (centralEmbedding F c * finiteCoroot F a * positiveEmbedding F u) = g := by
  obtain ⟨k, hk, b, hb, he⟩ := exists_valued_loop_integral_borel v g
  obtain ⟨⟨c, a, u⟩, hp⟩ := (mem_positiveBorel_iff F b).mp hb
  refine ⟨k, hk, c, a, u, ?_⟩
  change k * borelCoordinateMap F (c, a, u) = g
  rw [hp, he]

end
end GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2

#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.exists_valued_loop_borel_integral
#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.exists_valued_loop_integral_borel
#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.exists_valued_loop_integral_torus_unipotent
