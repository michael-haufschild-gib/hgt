import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.Data.Int.Interval
import Mathlib.Tactic.Ring

/-!
# Real roots and inversion sets of affine A₁

The infinite dihedral group acts on the real roots `±α + nδ`. Integer intervals
describe exactly the positive roots sent to negative roots. Both affine simple
reflections generate this action; its translation subgroup is infinite.
-/

namespace GaloisForLFunctions.HTGeometry.LoopEisenstein.AffineA1

/-- The two real-root strings; the constructor records the finite root's sign. -/
inductive Root
  | plus (level : ℤ)
  | minus (level : ℤ)
  deriving DecidableEq

@[simp] theorem Root.plus_ne_minus (m n : ℤ) : Root.plus m ≠ Root.minus n := by
  intro h
  cases h

@[simp] theorem Root.minus_ne_plus (m n : ℤ) : Root.minus m ≠ Root.plus n := by
  intro h
  cases h

/-- The standard positive system with simple roots `α` and `δ - α`. -/
def Root.positive : Root → Prop
  | .plus n => 0 ≤ n
  | .minus n => 0 < n

/-- The affine Weyl group, including all integral translations. -/
abbrev Weyl := DihedralGroup 0

private def integerIndex : ZMod 0 ≃+* ℤ := RingEquiv.refl ℤ

/-- Translation by `mα∨`, and its composite with the finite reflection. -/
def act : Weyl → Root → Root
  | .r m, .plus n => .plus (n - 2 * integerIndex m)
  | .r m, .minus n => .minus (n + 2 * integerIndex m)
  | .sr m, .plus n => .minus (n - 2 * integerIndex m)
  | .sr m, .minus n => .plus (n + 2 * integerIndex m)

@[simp] theorem act_one (β : Root) : act 1 β = β := by
  cases β <;> simp only [DihedralGroup.one_def, act, map_zero, mul_zero, sub_zero, add_zero]

theorem act_mul (w v : Weyl) (β : Root) : act (w * v) β = act w (act v β) := by
  cases w <;> cases v <;> cases β <;>
    simp only [DihedralGroup.r_mul_r, DihedralGroup.r_mul_sr,
      DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr, act, map_add, map_sub] <;>
      congr 1 <;> ring

instance : MulAction Weyl Root where
  smul := act
  one_smul := act_one
  mul_smul := act_mul

/-- Even one root distinguishes all elements of this affine Weyl action. -/
theorem act_plus_zero_injective : Function.Injective (fun w : Weyl => act w (.plus 0)) := by
  intro w v h
  cases w with
  | r m =>
    cases v with
    | r n =>
      have he : (0 : ℤ) - 2 * integerIndex m = 0 - 2 * integerIndex n := Root.plus.inj h
      have : integerIndex m = integerIndex n := by omega
      exact congrArg DihedralGroup.r (integerIndex.injective this)
    | sr n => exact Root.noConfusion h
  | sr m =>
    cases v with
    | r n => exact Root.noConfusion h
    | sr n =>
      have he : (0 : ℤ) - 2 * integerIndex m = 0 - 2 * integerIndex n := Root.minus.inj h
      have : integerIndex m = integerIndex n := by omega
      exact congrArg DihedralGroup.sr (integerIndex.injective this)

/-- Reflection in the finite simple root `α`. -/
def finiteReflection : Weyl := .sr 0

/-- Reflection in the affine simple root `δ - α`. -/
def affineReflection : Weyl := .sr (-1)

theorem affine_mul_finite : affineReflection * finiteReflection = DihedralGroup.r 1 := by
  simp only [affineReflection, finiteReflection, DihedralGroup.sr_mul_sr, zero_sub, neg_neg]

/-- Every translation is generated by the two simple reflections. -/
theorem translation_eq_simple_zpow (m : ℤ) :
    DihedralGroup.r m = (affineReflection * finiteReflection) ^ m := by
  rw [affine_mul_finite, DihedralGroup.r_one_zpow]

/-- Every reflection is generated by the same two simple reflections. -/
theorem reflection_eq_simple_zpow (m : ℤ) :
    DihedralGroup.sr m = finiteReflection * (affineReflection * finiteReflection) ^ m := by
  rw [← translation_eq_simple_zpow]
  simp only [finiteReflection, DihedralGroup.sr_mul_r, zero_add]

/-- Positive roots made negative by `w`, as an explicit finite set. -/
noncomputable def inversions : Weyl → Finset Root
  | .r m => (Finset.Ico 0 (2 * integerIndex m)).image Root.plus ∪
      (Finset.Ioc 0 (-2 * integerIndex m)).image Root.minus
  | .sr m => (Finset.Icc 0 (2 * integerIndex m)).image Root.plus ∪
      (Finset.Ioo 0 (-2 * integerIndex m)).image Root.minus

/-- The interval description is exactly the Weyl inversion condition. -/
theorem mem_inversions (w : Weyl) (β : Root) :
    β ∈ inversions w ↔ β.positive ∧ ¬ (act w β).positive := by
  cases w <;> cases β <;>
    simp only [inversions, Finset.mem_union, Finset.mem_image, Root.plus.injEq,
      Root.minus.injEq, Root.plus_ne_minus, Root.minus_ne_plus, exists_eq_right,
      and_false, exists_false, or_false, false_or, Finset.mem_Ico, Finset.mem_Ioc,
      Finset.mem_Icc, Finset.mem_Ioo, Root.positive, act] <;> omega

@[simp] theorem inversions_one : inversions 1 = ∅ := by
  ext β
  simp [mem_inversions]

@[simp] theorem inversions_finiteReflection :
    inversions finiteReflection = {Root.plus 0} := by
  ext β
  cases β <;> simp [mem_inversions, finiteReflection, act, Root.positive] <;> omega

@[simp] theorem inversions_affineReflection :
    inversions affineReflection = {Root.minus 1} := by
  ext β
  cases β <;> simp [mem_inversions, affineReflection, act, Root.positive] <;> omega

/-- Coefficient of the affine simple coroot `h₀`. -/
def Root.corootZero : Root → ℤ
  | .plus n => n
  | .minus n => n

/-- Coefficient of the finite simple coroot `h₁`. -/
def Root.corootOne : Root → ℤ
  | .plus n => n + 1
  | .minus n => n - 1

/-- Positivity of a real root is positivity of its simple-coroot expansion. -/
theorem Root.positive_iff_coroot (β : Root) :
    β.positive ↔ 0 ≤ β.corootZero ∧ 0 ≤ β.corootOne := by
  cases β <;> simp only [Root.positive, Root.corootZero, Root.corootOne] <;> omega

/-- The simple-coroot coordinates of a real root never both vanish. -/
theorem Root.coroot_ne_zero (β : Root) : β.corootZero ≠ 0 ∨ β.corootOne ≠ 0 := by
  cases β <;> simp only [Root.corootZero, Root.corootOne] <;> omega

end GaloisForLFunctions.HTGeometry.LoopEisenstein.AffineA1
