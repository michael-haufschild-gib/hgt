import GaloisForLFunctions.HTGeometry.LoopEisenstein.VertexGeneration
import GaloisForLFunctions.RHTower.RealPrincipalSeriesCompactPicture

/-!
# Existence of real loop Iwasawa factors

Finite-dimensional Iwasawa decomposition covers both vertex parabolics by
the positive Borel and their simple rotation groups. Induction over the
parabolic generators gives the same factorization for every loop element.
No uniqueness of torus coordinates is asserted here.
-/

namespace GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2

open GaloisForLFunctions.RHTower

noncomputable section

/-- The finite simple rotation subgroup, using the actual stabilizer of `i`. -/
def finiteCompact : Subgroup (LoopSL2 ℝ) :=
  upperHalfPlaneStabilizer.map (finiteSL2Embedding ℝ)

/-- The affine simple rotation subgroup inside the central extension. -/
def affineCompact : Subgroup (LoopSL2 ℝ) :=
  upperHalfPlaneStabilizer.map (affineSimpleSL2Embedding ℝ)

/-- The subgroup generated by the two simple rotation groups and central signs. -/
def realCompact : Subgroup (LoopSL2 ℝ) :=
  (finiteCompact ⊔ affineCompact) ⊔ Subgroup.closure {centralEmbedding ℝ (-1)}

theorem finiteCompact_le_realCompact : finiteCompact ≤ realCompact :=
  le_trans le_sup_left le_sup_left

theorem affineCompact_le_realCompact : affineCompact ≤ realCompact :=
  le_trans le_sup_right le_sup_left

theorem finiteSL2_iwasawa (h : SL2 ℝ) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ finiteCompact, b * k = finiteSL2Embedding ℝ h := by
  refine ⟨finiteSL2Embedding ℝ (realIwasawaB h),
    finiteSL2Embedding_upperTriangular ℝ _
      ((realUpperBorel_mem_iff _).1 (realIwasawaB h).property),
    finiteSL2Embedding ℝ (realIwasawaK h), ?_, ?_⟩
  · exact ⟨(realIwasawaK h : SL2 ℝ), (realIwasawaK h).property, rfl⟩
  · rw [← map_mul, realIwasawaB_mul_realIwasawaK]

theorem affineSL2_iwasawa (h : SL2 ℝ) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ affineCompact, b * k = affineSimpleSL2Embedding ℝ h := by
  refine ⟨affineSimpleSL2Embedding ℝ (realIwasawaB h),
    affineSimpleSL2Embedding_upperTriangular ℝ _
      ((realUpperBorel_mem_iff _).1 (realIwasawaB h).property),
    affineSimpleSL2Embedding ℝ (realIwasawaK h), ?_, ?_⟩
  · exact ⟨(realIwasawaK h : SL2 ℝ), (realIwasawaK h).property, rfl⟩
  · rw [← map_mul, realIwasawaB_mul_realIwasawaK]

theorem positiveVertex_iwasawa {g : LoopSL2 ℝ} (hg : g ∈ positiveVertex ℝ) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = g := by
  obtain ⟨b₀, hb₀, h, he₀⟩ := positiveVertex_borel_finite ℝ hg
  obtain ⟨b, hb, k, hk, he⟩ := finiteSL2_iwasawa h
  refine ⟨b₀ * b, (positiveBorel ℝ).mul_mem hb₀ hb,
    k, finiteCompact_le_realCompact hk, ?_⟩
  rw [mul_assoc, he, he₀]

theorem affineVertex_iwasawa {g : LoopSL2 ℝ} (hg : g ∈ affineVertex ℝ) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = g := by
  obtain ⟨b₀, hb₀, h, he₀⟩ := affineVertex_borel_affine ℝ hg
  obtain ⟨b, hb, k, hk, he⟩ := affineSL2_iwasawa h
  refine ⟨b₀ * b, (positiveBorel ℝ).mul_mem hb₀ hb,
    k, affineCompact_le_realCompact hk, ?_⟩
  rw [mul_assoc, he, he₀]

private theorem vertex_left_mul_iwasawa {x y : LoopSL2 ℝ}
    (hx : x ∈ positiveVertex ℝ ∨ x ∈ affineVertex ℝ)
    (hy : ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = y) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = x * y := by
  obtain ⟨b, hb, k, hk, he⟩ := hy
  have hxb : ∃ b' ∈ positiveBorel ℝ, ∃ k' ∈ realCompact, b' * k' = x * b := by
    rcases hx with hx | hx
    · exact positiveVertex_iwasawa
        ((positiveVertex ℝ).mul_mem hx (positiveBorel_le_positiveVertex ℝ hb))
    · exact affineVertex_iwasawa
        ((affineVertex ℝ).mul_mem hx (positiveBorel_le_affineVertex ℝ hb))
  obtain ⟨b', hb', k', hk', he'⟩ := hxb
  refine ⟨b', hb', k' * k, realCompact.mul_mem hk' hk, ?_⟩
  rw [← mul_assoc, he', mul_assoc, he]

/-- Every actual real loop element is a positive-Borel factor times a generated rotation factor. -/
theorem exists_iwasawa (g : LoopSL2 ℝ) :
    ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = g := by
  have hclosure : Subgroup.closure
      ((positiveVertex ℝ : Set (LoopSL2 ℝ)) ∪ (affineVertex ℝ : Set (LoopSL2 ℝ))) = ⊤ := by
    rw [Subgroup.closure_union]
    simpa only [Subgroup.closure_eq] using vertex_sup_eq_top ℝ
  have hg : g ∈ Subgroup.closure
      ((positiveVertex ℝ : Set (LoopSL2 ℝ)) ∪ (affineVertex ℝ : Set (LoopSL2 ℝ))) := by
    rw [hclosure]
    trivial
  refine Subgroup.closure_induction_left
    (p := fun x _ => ∃ b ∈ positiveBorel ℝ, ∃ k ∈ realCompact, b * k = x)
    ?_ ?_ ?_ hg
  · exact ⟨1, (positiveBorel ℝ).one_mem, 1, realCompact.one_mem, one_mul 1⟩
  · intro x hx y _ hy
    exact vertex_left_mul_iwasawa hx hy
  · intro x hx y _ hy
    apply vertex_left_mul_iwasawa (y := y) _ hy
    rcases hx with hx | hx
    · exact Or.inl ((positiveVertex ℝ).inv_mem hx)
    · exact Or.inr ((affineVertex ℝ).inv_mem hx)

end

end GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2
