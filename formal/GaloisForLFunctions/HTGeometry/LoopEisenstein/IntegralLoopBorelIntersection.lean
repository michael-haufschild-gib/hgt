import GaloisForLFunctions.HTGeometry.LoopEisenstein.IntegralAdjacentVertex
import GaloisForLFunctions.HTGeometry.LoopEisenstein.SubgroupAlternatingWords
import GaloisForLFunctions.HTGeometry.LoopEisenstein.ValuedLoopIwasawa

/-!
# The exact integral loop–Borel intersection

The two coefficient-integral completed vertices have a common integral
Borel. Reduced alternating words have a nonzero Laurent boundary, so
their generated subgroup has the same Borel intersection. Both torus
valuations are consequently independent of the actual Iwasawa factors.
-/

namespace GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2
open scoped WithZero WithZeroMulInt
noncomputable section
variable {F : Type*} [Field F] (v : Valuation F ℤᵐ⁰)

/-- Central-positive coordinates at the two completed vertices. -/
def integralVertexEmbedding (i : Bool) : Fˣ × PowerSeriesSL2 F →* LoopSL2 F :=
  if i then (diagonalRescale F (laurentXUnit F)⁻¹).toMonoidHom.comp (centralPositiveEmbedding F)
  else centralPositiveEmbedding F

/-- The two actual coefficient-integral vertex subgroups. -/
def integralVertex (i : Bool) : Subgroup (LoopSL2 F) :=
  ((valuationUnitSubgroup v).prod (valuationIntegralPowerSeriesSL2 v)).map
    (integralVertexEmbedding i)

@[simp] theorem integralVertex_false : integralVertex v false = integralPositiveVertex v := rfl

@[simp] theorem integralVertex_true : integralVertex v true = integralAffineVertex v := by
  change _ = (((valuationUnitSubgroup v).prod (valuationIntegralPowerSeriesSL2 v)).map
    (centralPositiveEmbedding F)).map (diagonalRescale F (laurentXUnit F)⁻¹).toMonoidHom
  rw [Subgroup.map_map]
  rfl

/-- The integral subgroup generated by both completed vertices. -/
def integralLoop : Subgroup (LoopSL2 F) := integralVertex v false ⊔ integralVertex v true

theorem integralPositiveBorel_le_integralVertex (i : Bool) :
    integralPositiveBorel v ≤ integralVertex v i := by
  cases i
  · exact inf_le_left
  · rw [integralVertex_true]
    exact integralPositiveBorel_le_affineVertex v

theorem integralVertex_inf_positiveBorel (i : Bool) :
    integralVertex v i ⊓ positiveBorel F = integralPositiveBorel v := by
  cases i
  · rfl
  · rw [integralVertex_true, integralAffineVertex_inf_positiveBorel]

private def integralVertexFactors (i : Bool) (g : integralVertex v i) : Fˣ × PowerSeriesSL2 F :=
  Classical.choose g.property

private theorem integralVertexFactors_spec (i : Bool) (g : integralVertex v i) :
    integralVertexEmbedding i (integralVertexFactors v i g) = (g : LoopSL2 F) :=
  (Classical.choose_spec g.property).2

private def integralVertexSource (p : Σ i, integralVertex v i) : Bool × PowerSeriesSL2 F :=
  (p.1, (integralVertexFactors v p.1 p.2).2)

private theorem projection_integralVertexSource (p : Σ i, integralVertex v i) :
    projection F (p.2 : LoopSL2 F) =
      vertexMatrixEmbedding F (integralVertexSource v p).1 (integralVertexSource v p).2 := by
  rw [← integralVertexFactors_spec v p.1 p.2]
  rcases p with ⟨i, g⟩
  cases i
  · change projection F (centralEmbedding F _ * positiveEmbedding F _) = _
    rw [map_mul, projection_centralEmbedding, projection_positiveEmbedding, one_mul]
    rfl
  · change projection F (diagonalRescale F (laurentXUnit F)⁻¹
      (centralEmbedding F _ * positiveEmbedding F _)) = _
    rw [projection_diagonalRescale, map_mul, projection_centralEmbedding,
      projection_positiveEmbedding, one_mul]
    rfl

private theorem integralVertexSource_not_iwahori (p : Σ i, integralVertex v i)
    (hp : (p.2 : LoopSL2 F) ∉ integralPositiveBorel v) :
    vertexMatrixEmbedding F (integralVertexSource v p).1 (integralVertexSource v p).2
      ∉ laurentIwahori F := by
  intro hi
  rw [← projection_integralVertexSource v p] at hi
  have hb : (p.2 : LoopSL2 F) ∈ positiveBorel F :=
    (mem_positiveBorel_iff_projection F _).mpr hi
  apply hp
  rw [← integralVertex_inf_positiveBorel v p.1]
  exact ⟨p.2.property, hb⟩

private theorem integralVertexSource_chain (L : List (Σ i, integralVertex v i)) :
    List.IsChain (fun p q : Σ i, integralVertex v i => p.1 ≠ q.1) L →
      List.IsChain (fun p q : Bool × PowerSeriesSL2 F => p.1 ≠ q.1)
        (L.map (integralVertexSource v)) := by
  induction L with
  | nil => simp
  | cons p tail ih =>
    intro hl
    cases tail with
    | nil => simp
    | cons q rest =>
      have h := List.isChain_cons_cons.1 hl
      exact List.isChain_cons_cons.2 ⟨h.1, ih h.2⟩

private theorem projection_integralVertexWord (L : List (Σ i, integralVertex v i)) :
    projection F (L.map (fun p => (p.2 : LoopSL2 F))).prod =
      vertexMatrixWord F (L.map (integralVertexSource v)) := by
  rw [map_list_prod, vertexMatrixWord, List.map_map, List.map_map]
  apply congrArg (fun f : (Σ i, integralVertex v i) → SL2 (LaurentSeries F) => (L.map f).prod)
  funext p
  exact projection_integralVertexSource v p

/-- A nonempty reduced word in the completed integral vertices cannot lie in Borel. -/
theorem alternating_integralVertexWord_not_mem_borel
    (L : List (Σ i, integralVertex v i)) (hne : L ≠ [])
    (hred : ∀ p ∈ L, (p.2 : LoopSL2 F) ∉ integralPositiveBorel v)
    (halt : List.IsChain (fun p q : Σ i, integralVertex v i => p.1 ≠ q.1) L) :
    (L.map (fun p => (p.2 : LoopSL2 F))).prod ∉ positiveBorel F := by
  intro hb
  have hi := projection_mem_laurentIwahori F hb
  rw [projection_integralVertexWord] at hi
  apply alternating_full_vertex_word_not_mem_iwahori F (L.map (integralVertexSource v)) _ _
    (integralVertexSource_chain v L halt) hi
  · intro he
    exact hne (List.map_eq_nil_iff.mp he)
  · intro q hq
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hq
    exact integralVertexSource_not_iwahori v p (hred p hp)

/-- The generated completed integral loop group has exactly the expected integral Borel. -/
theorem integralLoop_inf_positiveBorel :
    integralLoop v ⊓ positiveBorel F = integralPositiveBorel v := by
  apply le_antisymm
  · intro g hg
    rcases subgroup_join_base_or_alternating (integralVertex v) (integralPositiveBorel v)
      (integralPositiveBorel_le_integralVertex v) hg.1 with hm | hw
    · exact hm
    · obtain ⟨L, hne, hred, halt, he⟩ := hw
      exact False.elim (alternating_integralVertexWord_not_mem_borel v L hne hred halt
        (he.symm ▸ hg.2))
  · exact le_inf (le_trans (integralPositiveBorel_le_integralVertex v false) le_sup_left) inf_le_right

/-- Integral membership of a completed unipotent is exactly coefficient integrality. -/
theorem positiveUnipotent_mem_integralLoop_iff (u : positiveUnipotentMatrices F) :
    positiveEmbedding F u ∈ integralLoop v ↔
      (u : PowerSeriesSL2 F) ∈ valuationIntegralPowerSeriesSL2 v := by
  constructor
  · intro hu
    have hb : positiveEmbedding F u ∈ positiveBorel F := by
      refine ⟨(1, ⟨u, positiveUnipotentMatrices_le_iwahori F u.property⟩), ?_⟩
      change centralEmbedding F 1 * positiveEmbedding F u = positiveEmbedding F u
      rw [map_one, one_mul]
    have hp : positiveEmbedding F u ∈ integralPositiveVertex v := by
      have h : positiveEmbedding F u ∈ integralPositiveBorel v := by
        rw [← integralLoop_inf_positiveBorel]
        exact ⟨hu, hb⟩
      exact h.1
    obtain ⟨⟨c, p⟩, ⟨_, hpi⟩, he⟩ := hp
    have hbase := congrArg (projection F) he
    change projection F (centralEmbedding F c * positiveEmbedding F p) =
      projection F (positiveEmbedding F u) at hbase
    rw [map_mul, projection_centralEmbedding, projection_positiveEmbedding,
      projection_positiveEmbedding, one_mul] at hbase
    exact powerSeriesSL2Map_injective F hbase ▸ hpi
  · intro hu
    apply (show integralPositiveVertex v ≤ integralLoop v from le_sup_left)
    refine ⟨(1, (u : PowerSeriesSL2 F)), ⟨(valuationUnitSubgroup v).one_mem, hu⟩, ?_⟩
    change centralEmbedding F 1 * positiveEmbedding F u = positiveEmbedding F u
    rw [map_one, one_mul]

private theorem constantPowerSeries_integral (g : SL2 F) (hg : g ∈ valuationIntegralSL2 v) :
    constantPowerSeriesSL2Map F g ∈ valuationIntegralPowerSeriesSL2 v := by
  intro i j n
  change v (PowerSeries.coeff n (PowerSeries.C (g i j))) ≤ 1
  rw [PowerSeries.coeff_C]
  split_ifs
  · exact hg i j
  · rw [map_zero]; exact zero_le_one

private theorem finiteIntegralSimple_le_positiveVertex :
    finiteIntegralSimple v ≤ integralPositiveVertex v := by
  rintro g ⟨h, hh, rfl⟩
  refine ⟨(1, constantPowerSeriesSL2Map F h),
    ⟨(valuationUnitSubgroup v).one_mem, constantPowerSeries_integral v h hh⟩, ?_⟩
  change centralEmbedding F 1 * positiveEmbedding F (constantPowerSeriesSL2Map F h) = _
  rw [map_one, one_mul]
  rfl

private theorem sl2Swap_integral (g : SL2 F) (hg : g ∈ valuationIntegralSL2 v) :
    sl2Swap F g ∈ valuationIntegralSL2 v := by
  intro i j
  rw [coe_sl2Swap]
  fin_cases i <;> fin_cases j
  · exact hg 1 1
  · exact hg 1 0
  · exact hg 0 1
  · exact hg 0 0

private theorem affineIntegralSimple_le_affineVertex :
    affineIntegralSimple v ≤ integralAffineVertex v := by
  rintro g ⟨h, hh, rfl⟩
  refine ⟨finiteSL2Embedding F (sl2Swap F h),
    finiteIntegralSimple_le_positiveVertex v ⟨sl2Swap F h, sl2Swap_integral v h hh, rfl⟩, ?_⟩
  exact diagonalRescale_finiteSL2Embedding F (sl2Swap F h)

theorem integralSimpleLoop_le_integralLoop : integralSimpleLoop v ≤ integralLoop v := by
  apply sup_le
  · exact le_trans (finiteIntegralSimple_le_positiveVertex v) le_sup_left
  · apply le_trans (affineIntegralSimple_le_affineVertex v)
    rw [← integralVertex_true]
    exact le_sup_right

/-- Every actual loop has integral and positive-Borel factors. -/
theorem exists_integralLoop_borel (g : LoopSL2 F) :
    ∃ k : integralLoop v, ∃ b : positiveBorel F, (k : LoopSL2 F) * b = g := by
  obtain ⟨k, hk, b, hb, he⟩ := exists_valued_loop_integral_borel v g
  exact ⟨⟨k, integralSimpleLoop_le_integralLoop v hk⟩, ⟨b, hb⟩, he⟩

/-- Every actual loop has integral, central, finite-torus and completed-unipotent factors. -/
theorem exists_integralLoop_torus_unipotent (g : LoopSL2 F) :
    ∃ k ∈ integralLoop v, ∃ c a : Fˣ, ∃ u : positiveUnipotentMatrices F,
      k * (centralEmbedding F c * finiteCoroot F a * positiveEmbedding F u) = g := by
  obtain ⟨k, hk, c, a, u, he⟩ := exists_valued_loop_integral_torus_unipotent v g
  exact ⟨k, integralSimpleLoop_le_integralLoop v hk, c, a, u, he⟩

/-- The two intrinsic Borel valuation coordinates. -/
def borelValuationHom : positiveBorel F →* (ℤᵐ⁰ × ℤᵐ⁰) where
  toFun b := (v (((borelTorusHom F b).1 : Fˣ) : F), v (((borelTorusHom F b).2 : Fˣ) : F))
  map_one' := by
    change (v (((borelTorusHom F 1).1 : Fˣ) : F),
      v (((borelTorusHom F 1).2 : Fˣ) : F)) = (1, 1)
    rw [map_one]
    simp only [Prod.fst_one, Prod.snd_one, Units.val_one, map_one]
  map_mul' a b := by
    change (v (((borelTorusHom F (a * b)).1 : Fˣ) : F),
      v (((borelTorusHom F (a * b)).2 : Fˣ) : F)) =
      (v (((borelTorusHom F a).1 : Fˣ) : F), v (((borelTorusHom F a).2 : Fˣ) : F)) *
      (v (((borelTorusHom F b).1 : Fˣ) : F), v (((borelTorusHom F b).2 : Fˣ) : F))
    rw [map_mul]
    simp only [Prod.fst_mul, Prod.snd_mul, Units.val_mul, map_mul, Prod.mk_mul_mk]

theorem borelValuationHom_integralLoop (b : positiveBorel F)
    (hb : (b : LoopSL2 F) ∈ integralLoop v) : borelValuationHom v b = 1 := by
  have hB : (b : LoopSL2 F) ∈ integralPositiveBorel v := by
    rw [← integralLoop_inf_positiveBorel]
    exact ⟨hb, b.property⟩
  exact Prod.ext (integralPositiveVertex_borel_torus_values v b hB.1).1
    (integralPositiveVertex_borel_torus_values v b hB.1).2

/-- Both torus valuations are independent of the actual integral–Borel factorization. -/
theorem borelValuationHom_iwasawa_unique (k₁ k₂ : integralLoop v) (b₁ b₂ : positiveBorel F)
    (he : (k₁ : LoopSL2 F) * b₁ = (k₂ : LoopSL2 F) * b₂) :
    borelValuationHom v b₁ = borelValuationHom v b₂ := by
  have hd : ((b₁ * b₂⁻¹ : positiveBorel F) : LoopSL2 F) =
      (k₁ : LoopSL2 F)⁻¹ * k₂ := by
    change (b₁ : LoopSL2 F) * (b₂ : LoopSL2 F)⁻¹ = _
    calc
      _ = (k₁ : LoopSL2 F)⁻¹ * ((k₁ : LoopSL2 F) * b₁) * (b₂ : LoopSL2 F)⁻¹ := by group
      _ = (k₁ : LoopSL2 F)⁻¹ * ((k₂ : LoopSL2 F) * b₂) * (b₂ : LoopSL2 F)⁻¹ := by rw [he]
      _ = _ := by group
  have hk : ((b₁ * b₂⁻¹ : positiveBorel F) : LoopSL2 F) ∈ integralLoop v := by
    rw [hd]
    exact (integralLoop v).mul_mem ((integralLoop v).inv_mem k₁.property) k₂.property
  have hv := borelValuationHom_integralLoop v (b₁ * b₂⁻¹) hk
  calc
    borelValuationHom v b₁ = borelValuationHom v ((b₁ * b₂⁻¹) * b₂) := by
      congr 1
      group
    _ = borelValuationHom v (b₁ * b₂⁻¹) * borelValuationHom v b₂ := map_mul _ _ _
    _ = borelValuationHom v b₂ := by rw [hv, one_mul]

end
end GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2

#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.integralLoop_inf_positiveBorel
#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.exists_integralLoop_torus_unipotent
#print axioms GaloisForLFunctions.HTGeometry.LoopEisenstein.LoopSL2.borelValuationHom_iwasawa_unique
