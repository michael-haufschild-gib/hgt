import GaloisForLFunctions.HTGeometry.DifferentialGaloisSeparation
import GaloisForLFunctions.HTGeometry.TensorProductDifferential
import GaloisForLFunctions.RHTower.FunctionTensorProduct

/-!
# Differential coordinate algebra of a matrix group

Let a group `G` be represented multiplicatively by determinant-one `2 × 2` matrices over a
differential field.  Its differential coordinate algebra is the subalgebra of scalar-valued
functions on `G` generated by every derivative of the four matrix entries.

This file proves two structural facts without a presentation by differential polynomials:

* the coordinate algebra is stable under pointwise differentiation;
* pullback along group multiplication is represented uniquely in the algebraic tensor square.

The second fact uses injectivity of the separated-function tensor map.  It is the coordinate-free
input for the Hopf structure and the generic-point translation argument.
-/

open scoped Differential TensorProduct

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open GaloisForLFunctions

universe u

variable {C G : Type u} [Field C] [Differential C] [Group G]

/-- Pointwise differential structure on a function ring. -/
@[reducible] def pointwiseFunctionDifferential (X : Type u) : Differential (X → C) where
  deriv :=
    { toLinearMap :=
        { toFun := fun f x => Differential.deriv (f x)
          map_add' := fun f g => by
            ext x
            exact Differential.deriv.map_add (f x) (g x)
          map_smul' := fun n f => by
            ext x
            simp }
      map_one_eq_zero' := by ext x; exact Derivation.map_one_eq_zero _
      leibniz' := fun f g => by ext x; exact Derivation.leibniz _ _ _ }

theorem pointwiseFunctionDifferential_apply (X : Type u) (f : X → C) (x : X) :
    letI : Differential (X → C) := pointwiseFunctionDifferential X
    Differential.deriv f x = Differential.deriv (f x) :=
  rfl

instance pointwiseFunctionDifferentialAlgebra (X : Type u) :
    letI : Differential (X → C) := pointwiseFunctionDifferential X
    DifferentialAlgebra C (X → C) := by
  letI : Differential (X → C) := pointwiseFunctionDifferential X
  constructor
  intro c
  rfl

/-- A multiplicative determinant-one matrix representation. -/
structure DifferentialMatrixGroupRepresentation where
  matrix : G →* Matrix (Fin 2) (Fin 2) C
  det_eq_one : ∀ g, (matrix g).det = 1

namespace DifferentialMatrixGroupRepresentation

variable (r : DifferentialMatrixGroupRepresentation (C := C) (G := G))

/-- One matrix-entry coordinate function. -/
def coordinate (q : Fin 2 × Fin 2) : G → C :=
  fun g => r.matrix g q.1 q.2

/-- Every derivative of one matrix-entry coordinate function. -/
def coordinateJet (q : Fin 2 × Fin 2) (n : ℕ) : G → C :=
  fun g => differentialJet n (r.coordinate q g)

/-- Differential coordinate algebra generated by the four represented matrix entries. -/
def coordinateAlgebra : Subalgebra C (G → C) :=
  Algebra.adjoin C (Set.range fun qn : (Fin 2 × Fin 2) × ℕ =>
    r.coordinateJet qn.1 qn.2)

local instance ambientFunctionDifferential : Differential (G → C) :=
  pointwiseFunctionDifferential G

local instance ambientFunctionDifferentialAlgebra : DifferentialAlgebra C (G → C) :=
  pointwiseFunctionDifferentialAlgebra G

theorem deriv_coordinateJet (q : Fin 2 × Fin 2) (n : ℕ) :
    Differential.deriv (r.coordinateJet q n) = r.coordinateJet q (n + 1) := by
  funext g
  rw [pointwiseFunctionDifferential_apply]
  exact (differentialJet_succ n (r.coordinate q g)).symm

/-- The generated coordinate algebra is stable under pointwise differentiation. -/
theorem deriv_mem_coordinateAlgebra (f : G → C) (hf : f ∈ r.coordinateAlgebra) :
    Differential.deriv f ∈ r.coordinateAlgebra := by
  refine Algebra.adjoin_induction (p := fun f _ =>
      Differential.deriv f ∈ r.coordinateAlgebra) ?_ ?_ ?_ ?_ hf
  · intro f hf
    obtain ⟨qn, rfl⟩ := hf
    rw [r.deriv_coordinateJet]
    exact Algebra.subset_adjoin ⟨(qn.1, qn.2 + 1), rfl⟩
  · intro c
    rw [DifferentialAlgebra.deriv_algebraMap]
    exact (r.coordinateAlgebra).algebraMap_mem (Differential.deriv c)
  · intro f g _ _ hf hg
    rw [map_add]
    exact (r.coordinateAlgebra).add_mem hf hg
  · intro f g hfmem hgmem hf hg
    rw [Derivation.leibniz]
    exact (r.coordinateAlgebra).add_mem
      ((r.coordinateAlgebra).mul_mem hfmem hg)
      ((r.coordinateAlgebra).mul_mem hgmem hf)

/-- Differential structure induced on the coordinate algebra. -/
@[reducible] def coordinateAlgebraDifferential : Differential r.coordinateAlgebra :=
  subalgebraDifferential r.coordinateAlgebra r.deriv_mem_coordinateAlgebra

local instance coordinateDifferential : Differential r.coordinateAlgebra :=
  r.coordinateAlgebraDifferential

instance coordinateDifferentialAlgebra : DifferentialAlgebra C r.coordinateAlgebra := by
  constructor
  intro c
  apply Subtype.ext
  change Differential.deriv (algebraMap C (G → C) c) =
    algebraMap C (G → C) (Differential.deriv c)
  exact DifferentialAlgebra.deriv_algebraMap c

@[simp] theorem coordinateAlgebra_deriv_coe (f : r.coordinateAlgebra) :
    ((Differential.deriv f : r.coordinateAlgebra) : G → C) =
      Differential.deriv (f : G → C) :=
  rfl

/-- Pullback of a scalar-valued function along group multiplication. -/
def multiplicationPullback
    (_r : DifferentialMatrixGroupRepresentation (C := C) (G := G)) :
    (G → C) →ₐ[C] (G × G → C) where
  toFun f z := f (z.1 * z.2)
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Left-factor inclusion into functions on the product. -/
def coordinateLeftFunction : r.coordinateAlgebra →ₐ[C] (G × G → C) where
  toFun f z := f.1 z.1
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Right-factor inclusion into functions on the product. -/
def coordinateRightFunction : r.coordinateAlgebra →ₐ[C] (G × G → C) where
  toFun f z := f.1 z.2
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- Evaluation of a tensor of coordinate functions as a separated function on `G × G`. -/
def coordinateTensorEval :
    r.coordinateAlgebra ⊗[C] r.coordinateAlgebra →ₐ[C] (G × G → C) :=
  Algebra.TensorProduct.lift r.coordinateLeftFunction r.coordinateRightFunction
    (fun _ _ => Commute.all _ _)

@[simp] theorem coordinateTensorEval_tmul
    (f g : r.coordinateAlgebra) (x y : G) :
    r.coordinateTensorEval (f ⊗ₜ[C] g) (x, y) = f.1 x * g.1 y :=
  rfl

/-- The coordinate tensor evaluation is injective. -/
theorem coordinateTensorEval_injective : Function.Injective r.coordinateTensorEval := by
  let ι : r.coordinateAlgebra →ₗ[C] (G → C) :=
    { toFun := fun f => f.1
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hι : Function.Injective ι := fun _ _ h => Subtype.ext h
  have hmap : Function.Injective (TensorProduct.map ι ι) :=
    TensorProduct.map_injective_of_flat_flat _ _ hι hι
  intro t u htu
  apply hmap
  apply GaloisForLFunctions.RHTower.functionTensorProductHom_injective C G G
  have heval (v : r.coordinateAlgebra ⊗[C] r.coordinateAlgebra) :
      GaloisForLFunctions.RHTower.functionTensorProductHom C G G
          (TensorProduct.map ι ι v) = r.coordinateTensorEval v := by
    induction v using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simp [hx, hy]
    | tmul f g =>
        ext z
        rfl
  rw [heval, heval]
  exact htu

/-- Functions whose multiplication pullback belongs to the separated coordinate tensor square. -/
def multiplicationRepresentable : Subalgebra C (G → C) where
  carrier := {f | ∃ t : r.coordinateAlgebra ⊗[C] r.coordinateAlgebra,
    r.coordinateTensorEval t = r.multiplicationPullback f}
  zero_mem' := ⟨0, by ext z; simp [coordinateTensorEval, multiplicationPullback]⟩
  add_mem' := by
    rintro f g ⟨tf, htf⟩ ⟨tg, htg⟩
    refine ⟨tf + tg, ?_⟩
    rw [map_add, htf, htg, map_add]
  mul_mem' := by
    rintro f g ⟨tf, htf⟩ ⟨tg, htg⟩
    refine ⟨tf * tg, ?_⟩
    rw [map_mul, htf, htg, map_mul]
  algebraMap_mem' := by
    intro c
    refine ⟨algebraMap C (r.coordinateAlgebra ⊗[C] r.coordinateAlgebra) c, ?_⟩
    ext z
    simp [coordinateTensorEval, coordinateLeftFunction,
      coordinateRightFunction, multiplicationPullback]

local instance productFunctionDifferential : Differential (G × G → C) :=
  pointwiseFunctionDifferential (G × G)

theorem coordinateTensorEval_deriv
    (t : r.coordinateAlgebra ⊗[C] r.coordinateAlgebra) :
    r.coordinateTensorEval (tensorProductDerivation (K := C) t) =
      Differential.deriv (r.coordinateTensorEval t) := by
  induction t using TensorProduct.induction_on with
  | zero => simp [coordinateTensorEval]
  | add x y hx hy => simp [hx, hy]
  | tmul f g =>
      ext z
      rw [tensorProductDerivation_tmul]
      rw [map_add, Pi.add_apply]
      rw [r.coordinateTensorEval_tmul (Differential.deriv f) g z.1 z.2,
        r.coordinateTensorEval_tmul f (Differential.deriv g) z.1 z.2]
      rw [pointwiseFunctionDifferential_apply,
        r.coordinateTensorEval_tmul f g z.1 z.2, Derivation.leibniz]
      change Differential.deriv (f.1 z.1) * g.1 z.2 +
          f.1 z.1 * Differential.deriv (g.1 z.2) =
        f.1 z.1 * Differential.deriv (g.1 z.2) +
          g.1 z.2 * Differential.deriv (f.1 z.1)
      rw [mul_comm (Differential.deriv (f.1 z.1)) (g.1 z.2), add_comm]

theorem multiplicationPullback_deriv (f : G → C) :
    r.multiplicationPullback (Differential.deriv f) =
      Differential.deriv (r.multiplicationPullback f) := by
  ext z
  rfl

/-- Representability under multiplication is stable under the differential. -/
theorem deriv_mem_multiplicationRepresentable
    (f : G → C) (hf : f ∈ r.multiplicationRepresentable) :
    Differential.deriv f ∈ r.multiplicationRepresentable := by
  obtain ⟨t, ht⟩ := hf
  refine ⟨tensorProductDerivation (K := C) t, ?_⟩
  rw [r.coordinateTensorEval_deriv, ht, ← r.multiplicationPullback_deriv]

theorem coordinate_mem_multiplicationRepresentable (q : Fin 2 × Fin 2) :
    r.coordinate q ∈ r.multiplicationRepresentable := by
  let a : Fin 2 → r.coordinateAlgebra := fun l =>
    ⟨r.coordinate (q.1, l), Algebra.subset_adjoin ⟨((q.1, l), 0), by
      funext g
      simp [coordinateJet, differentialJet_zero]⟩⟩
  let b : Fin 2 → r.coordinateAlgebra := fun l =>
    ⟨r.coordinate (l, q.2), Algebra.subset_adjoin ⟨((l, q.2), 0), by
      funext g
      simp [coordinateJet, differentialJet_zero]⟩⟩
  refine ⟨∑ l : Fin 2, a l ⊗ₜ[C] b l, ?_⟩
  ext z
  simp only [map_sum]
  change (∑ l : Fin 2, r.matrix z.1 q.1 l * r.matrix z.2 l q.2) =
    r.matrix (z.1 * z.2) q.1 q.2
  rw [r.matrix.map_mul, Matrix.mul_apply]

theorem coordinateJet_mem_multiplicationRepresentable
    (q : Fin 2 × Fin 2) (n : ℕ) :
    r.coordinateJet q n ∈ r.multiplicationRepresentable := by
  induction n with
  | zero =>
      have hzero : r.coordinateJet q 0 = r.coordinate q := by
        funext g
        exact differentialJet_zero _
      rw [hzero]
      exact r.coordinate_mem_multiplicationRepresentable q
  | succ n ih =>
      have h := r.deriv_mem_multiplicationRepresentable _ ih
      rw [r.deriv_coordinateJet] at h
      simpa only [Nat.add_comm] using h

/-- Every differential coordinate function has a unique tensor-square multiplication pullback. -/
theorem exists_unique_coordinateTensor_mulPullback (f : r.coordinateAlgebra) :
    ∃! t : r.coordinateAlgebra ⊗[C] r.coordinateAlgebra,
      r.coordinateTensorEval t = r.multiplicationPullback f.1 := by
  have hle : r.coordinateAlgebra ≤ r.multiplicationRepresentable := by
    apply Algebra.adjoin_le
    rintro _ ⟨qn, rfl⟩
    exact r.coordinateJet_mem_multiplicationRepresentable qn.1 qn.2
  obtain ⟨t, ht⟩ := hle f.2
  refine ⟨t, ht, fun u hu => r.coordinateTensorEval_injective (hu.trans ht.symm)⟩

end DifferentialMatrixGroupRepresentation

end

end GaloisForLFunctions.HTGeometry
