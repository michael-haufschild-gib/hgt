import GaloisForLFunctions.HTGeometry.GomesPolynomialGeneratedBicommutant

/-!
# A missing invertible symmetry, not only a missing endomorphism

The square-zero even-to-odd transfer gives an actual automorphism 1+N with
inverse 1-N. It commutes with the second derivative and sends 1 to 1+X, so it
cannot belong to the exact algebra generated by D, reflection, and all F(D²).
This realizes the off-diagonal shear mechanism of arXiv2607.24901v1 section4.2.
-/

noncomputable section
open Polynomial
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- The actual even-to-odd chain transfer is square-zero. -/
theorem gomesEvenToOddChainTransfer_square_zero :
    (gomesDerivativePowerChainTransfer K 2 1 0).val *
      (gomesDerivativePowerChainTransfer K 2 1 0).val = 0 := by
  have h : (1 : Fin 2) ≠ 0 := fun h => Nat.one_ne_zero (congrArg Fin.val h)
  exact congrArg Subtype.val ((gomesDerivativePowerChainTransfer_square_zero_iff K 2 1 0).mpr h)

/-- An actual invertible polynomial shear built from the corpus's square-zero chain transfer. -/
def gomesEvenToOddChainShearUnit : (Module.End K K[X])ˣ where
  val := 1 + (gomesDerivativePowerChainTransfer K 2 1 0).val
  inv := 1 - (gomesDerivativePowerChainTransfer K 2 1 0).val
  val_inv := by
    rw [mul_sub, mul_one, add_mul, one_mul, gomesEvenToOddChainTransfer_square_zero, add_zero,
      add_sub_cancel_right]
  inv_val := by
    rw [mul_add, mul_one, sub_mul, one_mul, gomesEvenToOddChainTransfer_square_zero, sub_zero,
      sub_add_cancel]

/-- The invertible shear visibly breaks preservation of the constant polynomial line. -/
theorem gomesEvenToOddChainShearUnit_one :
    (gomesEvenToOddChainShearUnit K).val 1 = (1 + X : K[X]) := by
  change 1 + (gomesDerivativePowerChainTransfer K 2 1 0).val 1 = _
  rw [gomesEvenToOddChainTransfer_one]

/-- The shear remains an actual symmetry of the second derivative. -/
theorem gomesEvenToOddChainShearUnit_commutes :
    Commute (gomesEvenToOddChainShearUnit K).val (Polynomial.derivative ^ 2 : Module.End K K[X]) := by
  have h := (gomesPolynomialDerivativePowerCommutantAlgebra K 2).add_mem
    (gomesPolynomialDerivativePowerCommutantAlgebra K 2).one_mem
    (gomesDerivativePowerChainTransfer K 2 1 0).property
  exact ((gomesCentralizerSingleton_mem_iff K _ _).mp h).symm

/-- The invertible shear is missing from the generated algebra for every reflection center. -/
theorem gomesEvenToOddChainShearUnit_not_mem (c : K) :
    (gomesEvenToOddChainShearUnit K).val ∉ gomesPolynomialDerivativeReflectionAdjoin K c := by
  intro h
  apply gomesEvenToOddChainTransfer_not_mem_adjoin K c
  have hn := (gomesPolynomialDerivativeReflectionAdjoin K c).sub_mem h
    (gomesPolynomialDerivativeReflectionAdjoin K c).one_mem
  change 1 + (gomesDerivativePowerChainTransfer K 2 1 0).val - 1 ∈
    gomesPolynomialDerivativeReflectionAdjoin K c at hn
  simpa only [add_sub_cancel_left] using hn

/-- A fully specified missing automorphism witnesses the strict symmetry-reconstruction boundary. -/
theorem gomesPolynomialReflectionGenerated_missing_automorphism (c : K) :
    ∃ U : (Module.End K K[X])ˣ,
      Commute U.val (Polynomial.derivative ^ 2 : Module.End K K[X]) ∧
        U.val ∉ gomesPolynomialDerivativeReflectionAdjoin K c ∧ U.val 1 = 1 + X :=
  ⟨gomesEvenToOddChainShearUnit K, gomesEvenToOddChainShearUnit_commutes K,
    gomesEvenToOddChainShearUnit_not_mem K c, gomesEvenToOddChainShearUnit_one K⟩

end GaloisForLFunctions.HTGeometry
