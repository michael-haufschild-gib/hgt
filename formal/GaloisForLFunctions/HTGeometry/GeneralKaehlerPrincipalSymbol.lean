import Mathlib.LinearAlgebra.ExteriorPower.Basis
import Mathlib.RingTheory.Kaehler.Polynomial
import Mathlib.RingTheory.Ideal.Maps

/-!
# General Kähler principal symbols

For an arbitrary polynomial packet, the Plücker coordinates of its top universal Kähler wedge
are exactly the maximal minors of its Jacobian matrix.  Thus the coefficient ideal of the wedge
is the maximal-Jacobian-minor ideal.

For a packet of universal linear jets whose coefficients lie in an arbitrary commutative ring,
the wedge coordinates are the scalar maximal minors embedded as constant polynomials.  Hence its
Kähler coefficient ideal is exactly the base change of the scalar determinantal ideal.  This is
the canonical bridge from a law-coordinate principal-symbol matrix to the intrinsic Kähler wedge;
no field, reducedness, rank, or genericity hypothesis is used.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open Module MvPolynomial

universe u v

variable {R : Type u} {G : Type v} [CommRing R] [LinearOrder G]

/-- The top universal Kähler wedge of a polynomial packet. -/
def polynomialKaehlerWedge {n : ℕ} (f : Fin n → MvPolynomial G R) :
    ⋀[MvPolynomial G R]^n Ω[MvPolynomial G R⁄R] :=
  exteriorPower.ιMulti (MvPolynomial G R) n
    (fun i => KaehlerDifferential.D R (MvPolynomial G R) (f i))

/-- A maximal Jacobian minor, with columns in the canonical order of a coordinate subset. -/
def polynomialJacobianMinor {n : ℕ} (f : Fin n → MvPolynomial G R)
    (s : Set.powersetCard G n) : MvPolynomial G R :=
  (Matrix.of fun i j => MvPolynomial.pderiv
    (Set.powersetCard.ofFinEmbEquiv.symm s j) (f i)).det

/-- **General Kähler principal-symbol coordinate theorem.**  Every canonical coordinate of the
top Kähler wedge is the corresponding maximal Jacobian minor. -/
theorem polynomialKaehlerWedge_coordinate
    {n : ℕ} (f : Fin n → MvPolynomial G R) (s : Set.powersetCard G n) :
    ((KaehlerDifferential.mvPolynomialBasis R G).exteriorPower n).repr
        (polynomialKaehlerWedge f) s =
      polynomialJacobianMinor f s := by
  rw [exteriorPower.basis_repr_apply]
  unfold polynomialKaehlerWedge polynomialJacobianMinor
  rw [exteriorPower.ιMultiDual_apply_ιMulti]
  congr 1
  ext i j
  simp

/-- The maximal-Jacobian-minor ideal of a polynomial packet. -/
def polynomialJacobianMinorIdeal {n : ℕ} (f : Fin n → MvPolynomial G R) :
    Ideal (MvPolynomial G R) :=
  Ideal.span (Set.range (polynomialJacobianMinor f))

/-- The ideal generated by all canonical coordinates of the top Kähler wedge. -/
def polynomialKaehlerCoefficientIdeal {n : ℕ} (f : Fin n → MvPolynomial G R) :
    Ideal (MvPolynomial G R) :=
  Ideal.span (Set.range fun s =>
    ((KaehlerDifferential.mvPolynomialBasis R G).exteriorPower n).repr
      (polynomialKaehlerWedge f) s)

/-- **General Kähler principal-symbol ideal theorem.**  The intrinsic coefficient ideal of the
top Kähler wedge is exactly the maximal-Jacobian-minor ideal. -/
theorem polynomialKaehlerCoefficientIdeal_eq_jacobianMinorIdeal
    {n : ℕ} (f : Fin n → MvPolynomial G R) :
    polynomialKaehlerCoefficientIdeal f = polynomialJacobianMinorIdeal f := by
  rw [polynomialKaehlerCoefficientIdeal, polynomialJacobianMinorIdeal]
  simp_rw [polynomialKaehlerWedge_coordinate]

variable [Fintype G]

/-- A universal linear jet packet over a scalar coefficient ring. -/
def universalLinearJetPolynomial {n : ℕ} (M : Fin n → G → R) (i : Fin n) :
    MvPolynomial G R :=
  ∑ g, MvPolynomial.C (M i g) * MvPolynomial.X g

/-- The top Kähler wedge of a universal linear jet packet. -/
def universalLinearJetKaehlerWedge {n : ℕ} (M : Fin n → G → R) :
    ⋀[MvPolynomial G R]^n Ω[MvPolynomial G R⁄R] :=
  exteriorPower.ιMulti (MvPolynomial G R) n
    (fun i => KaehlerDifferential.D R (MvPolynomial G R)
      (universalLinearJetPolynomial M i))

/-- A scalar maximal minor of a universal linear jet coefficient matrix. -/
def universalLinearJetMinor {n : ℕ} (M : Fin n → G → R)
    (s : Set.powersetCard G n) : R :=
  (Matrix.of fun i j => M i (Set.powersetCard.ofFinEmbEquiv.symm s j)).det

/-- Every Kähler coordinate of a universal linear jet packet is the constant-polynomial image of
the corresponding scalar maximal minor. -/
theorem universalLinearJetKaehlerWedge_coordinate
    {n : ℕ} (M : Fin n → G → R) (s : Set.powersetCard G n) :
    ((KaehlerDifferential.mvPolynomialBasis R G).exteriorPower n).repr
        (universalLinearJetKaehlerWedge M) s =
      MvPolynomial.C (universalLinearJetMinor M s) := by
  rw [exteriorPower.basis_repr_apply]
  unfold universalLinearJetKaehlerWedge
  rw [exteriorPower.ιMultiDual_apply_ιMulti]
  let N : Matrix (Fin n) (Fin n) R :=
    Matrix.of fun i j => M i (Set.powersetCard.ofFinEmbEquiv.symm s j)
  have hmatrix :
      Matrix.of (fun i j =>
        (KaehlerDifferential.mvPolynomialBasis R G).coord
          (Set.powersetCard.ofFinEmbEquiv.symm s j)
          (KaehlerDifferential.D R (MvPolynomial G R)
            (universalLinearJetPolynomial M i))) =
        (MvPolynomial.C : R →+* MvPolynomial G R).mapMatrix N := by
    apply Matrix.ext
    intro i j
    simp [N, universalLinearJetPolynomial, Basis.coord_apply,
      Finsupp.single_apply, Algebra.smul_def]
  rw [hmatrix, universalLinearJetMinor]
  exact (RingHom.map_det (MvPolynomial.C : R →+* MvPolynomial G R) N).symm

/-- The scalar maximal-minor ideal of a universal linear jet packet. -/
def universalLinearJetMinorIdeal {n : ℕ} (M : Fin n → G → R) : Ideal R :=
  Ideal.span (Set.range (universalLinearJetMinor M))

/-- The ambient polynomial ideal generated by all Kähler coordinates of a linear jet packet. -/
def universalLinearJetKaehlerCoefficientIdeal {n : ℕ} (M : Fin n → G → R) :
    Ideal (MvPolynomial G R) :=
  Ideal.span (Set.range fun s =>
    ((KaehlerDifferential.mvPolynomialBasis R G).exteriorPower n).repr
      (universalLinearJetKaehlerWedge M) s)

/-- **Linear Kähler principal-symbol base-change theorem.**  The Kähler coefficient ideal is
exactly the extension of the scalar maximal-minor ideal to the universal jet algebra. -/
theorem universalLinearJetKaehlerCoefficientIdeal_eq_map_minorIdeal
    {n : ℕ} (M : Fin n → G → R) :
    universalLinearJetKaehlerCoefficientIdeal M =
      Ideal.map (MvPolynomial.C : R →+* MvPolynomial G R)
        (universalLinearJetMinorIdeal M) := by
  rw [universalLinearJetKaehlerCoefficientIdeal, universalLinearJetMinorIdeal,
    Ideal.map_span]
  simp_rw [universalLinearJetKaehlerWedge_coordinate]
  congr 1
  ext p
  simp

end

end GaloisForLFunctions.HTGeometry
