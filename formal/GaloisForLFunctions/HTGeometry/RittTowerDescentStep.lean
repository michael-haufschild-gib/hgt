import GaloisForLFunctions.HTGeometry.RittAffineSliceResidue
import GaloisForLFunctions.HTGeometry.RittPrefixFieldStability

/-!
# One step of the jet-tower descent

In the jet tower of a linearizer the shift moves the `m`-th jet affinely over the field generated by
the lower ones, `σ y_m = (q/ρ^m)·y_m + v_m` with `v_m` a base combination of `y_1, …, y_{m−1}`.  So
an eigen-inhomogeneous relation

`σ W = c·W + g + Σ_{1 ≤ j ≤ m} A_j · y_j`,  `W ∈ K⟮y_0, …, y_m⟯`, `W ≠ 0`,

whose inhomogeneity is a base combination of the lower jets plus a base constant, is exactly the
situation of the affine slice: `y_m` is the transcendental generator, `A_m` is the linear
coefficient, and the rest is the constant one.  The slice returns a relation of the *same shape* one
level down, with residue `0`, `A_m` or the truncated combination — never a new element of the bigger
field.  The scalar is multiplied by a power of `q/ρ^m`, so it stays a monomial in `q` and `ρ`.

Iterating from the top of the tower to the base therefore leaves a relation
`ψ(u) = c₀·u + g₀` with `u` a nonzero base element, `c₀` a monomial in `q` and `ρ`, and `g₀` either
zero or a nonzero base multiple of one of the original coefficients `A_j`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The prefix field of the first `m + 1` jets is a simple extension of the previous one. -/
theorem jetPrefixField_succ_eq (Fr : RittFrame K L) (τ : L) (m : ℕ) :
    (IntermediateField.adjoin ↥(Fr.jetPrefixField τ m) ({Fr.d^[m] τ} : Set L)).restrictScalars K
      = Fr.jetPrefixField τ (m + 1) := by
  rw [RittFrame.jetPrefixField, IntermediateField.adjoin_adjoin_left, RittFrame.jetPrefixField]
  congr 1
  ext x
  constructor
  · rintro (⟨j, hj, rfl⟩ | hx)
    · exact ⟨j, by omega, rfl⟩
    · exact ⟨m, by omega, by simpa using hx⟩
  · rintro ⟨j, hj, rfl⟩
    rcases Nat.lt_or_ge j m with h | h
    · exact Or.inl ⟨j, h, rfl⟩
    · have : j = m := by omega
      exact Or.inr (by simp [this])

/-- **One descent step.**  An eigen-inhomogeneous relation over the first `m + 1` jets descends to
one of the same shape over the first `m`. -/
theorem exists_descent_step (Fr : RittFrame K L) {τ : L} {q : K}
    (hq : q ≠ 0) (hqconst : Fr.dK q = 0) (hshift : Fr.σ τ = algebraMap K L q * τ)
    {m : ℕ} (htr : Transcendental ↥(Fr.jetPrefixField τ m) (Fr.d^[m] τ))
    {W : L} (hW0 : W ≠ 0) (hWmem : W ∈ Fr.jetPrefixField τ (m + 1))
    {c g : K} (hc : c ≠ 0) {A : ℕ → K}
    (hrel : Fr.σ W = algebraMap K L c * W + algebraMap K L g
      + ∑ j ∈ Finset.range (m + 1), algebraMap K L (A j) * Fr.d^[j] τ) :
    ∃ (W' : L) (c' g' : K) (A' : ℕ → K), W' ≠ 0 ∧ W' ∈ Fr.jetPrefixField τ m ∧ c' ≠ 0 ∧
      (g' = 0 ∨ ∃ z : K, z ≠ 0 ∧ (g' = z * A m ∨ g' = z * g)) ∧
      (∀ j, A' j = 0 ∨ ∃ z : K, z ≠ 0 ∧ A' j = z * A j) ∧
      Fr.σ W' = algebraMap K L c' * W' + algebraMap K L g'
        + ∑ j ∈ Finset.range m, algebraMap K L (A' j) * Fr.d^[j] τ := by
  classical
  set E : IntermediateField K L := Fr.jetPrefixField τ m with hE
  have hEσ : ∀ x ∈ E, Fr.σ x ∈ E := Fr.sigma_mem_jetPrefixField hqconst hshift m
  set φ : ↥E →+* ↥E :=
    { toFun := fun x => ⟨Fr.σ (x : L), hEσ (x : L) x.2⟩
      map_one' := by ext; simp
      map_mul' := fun _ _ => by ext; simp
      map_zero' := by ext; simp
      map_add' := fun _ _ => by ext; simp } with hφ
  have hcompE : ∀ x : ↥E, Fr.σ (algebraMap ↥E L x) = algebraMap ↥E L (φ x) := fun _ => rfl
  -- the shift acts affinely on the top jet
  have hρ0 : Fr.ρ ≠ 0 := Fr.ρ_ne
  set aK : K := q / Fr.ρ ^ m with haK
  have haK0 : aK ≠ 0 := div_ne_zero hq (pow_ne_zero _ hρ0)
  set aE : ↥E := ⟨algebraMap K L aK, IntermediateField.algebraMap_mem _ _⟩ with haE
  have haE0 : aE ≠ 0 := by
    intro h
    exact ((map_ne_zero_iff _ (algebraMap K L).injective).mpr haK0) (congrArg Subtype.val h)
  set v : L := Fr.σ (Fr.d^[m] τ) - algebraMap K L aK * Fr.d^[m] τ with hv
  have hvE : v ∈ E := by
    rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    · have h0 : Fr.σ (Fr.d^[m] τ) = algebraMap K L aK * Fr.d^[m] τ := by
        subst hm0
        simp [haK, hshift]
      rw [hv, h0, sub_self]
      exact zero_mem E
    · obtain ⟨p, rfl⟩ : ∃ p : ℕ, m = p + 1 := ⟨m - 1, by omega⟩
      exact Fr.jetSpan_le_intermediateField
        (fun j hj => Fr.jet_mem_jetPrefixField (by omega)) _
        (Fr.shift_jet_sub_mem_jetSpan hqconst hshift p)
  set bE : ↥E := ⟨v, hvE⟩ with hbE
  have hσt : Fr.σ (Fr.d^[m] τ)
      = algebraMap ↥E L aE * Fr.d^[m] τ + algebraMap ↥E L bE := by
    show Fr.σ (Fr.d^[m] τ) = algebraMap K L aK * Fr.d^[m] τ + v
    rw [hv]; ring
  -- the inhomogeneity, split at the top jet
  set cE : ↥E := ⟨algebraMap K L c, IntermediateField.algebraMap_mem _ _⟩ with hcE
  have hcE0 : cE ≠ 0 := by
    intro h
    exact ((map_ne_zero_iff _ (algebraMap K L).injective).mpr hc) (congrArg Subtype.val h)
  set αK : K := A m with hαK
  set αE : ↥E := ⟨algebraMap K L αK, IntermediateField.algebraMap_mem _ _⟩ with hαE
  have hβmem : algebraMap K L g + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ ∈ E := by
    refine add_mem (IntermediateField.algebraMap_mem _ _) (sum_mem ?_)
    intro j hj
    rw [Finset.mem_range] at hj
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (Fr.jet_mem_jetPrefixField hj)
  set βE : ↥E := ⟨algebraMap K L g + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ,
    hβmem⟩ with hβE
  have hrel' : Fr.σ W = algebraMap ↥E L cE * W
      + (algebraMap ↥E L αE * Fr.d^[m] τ + algebraMap ↥E L βE) := by
    show Fr.σ W = algebraMap K L c * W
      + (algebraMap K L αK * Fr.d^[m] τ
        + (algebraMap K L g + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ))
    have hsplit : ∑ j ∈ Finset.range (m + 1), algebraMap K L (A j) * Fr.d^[j] τ
        = algebraMap K L αK * Fr.d^[m] τ
          + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ := by
      rw [Finset.sum_range_succ, hαK]
      ring
    rw [hrel, hsplit]
    ring
  have hWmem' : W ∈ IntermediateField.adjoin ↥E ({Fr.d^[m] τ} : Set L) := by
    have := (jetPrefixField_succ_eq Fr τ m) ▸ hWmem
    exact this
  obtain ⟨u, r, D, e, hu0, hr, hmain⟩ :=
    exists_eigen_relation_residue_of_affine_mem_adjoin Fr.σ φ hcompE htr haE0 hcE0 hσt hW0
      hWmem' hrel'
  -- read the descended relation back in `L`
  set z : K := aK ^ e / aK ^ D with hz
  have hz0 : z ≠ 0 := div_ne_zero (pow_ne_zero _ haK0) (pow_ne_zero _ haK0)
  have hmainL : Fr.σ (u : L) * algebraMap K L aK ^ D
      = algebraMap K L aK ^ e * (algebraMap K L c * (u : L) + (r : L)) := by
    have h := congrArg (algebraMap ↥E L) hmain
    simp only [map_mul, map_pow, map_add] at h
    exact h
  have haKL : algebraMap K L aK ≠ 0 := (map_ne_zero_iff _ (algebraMap K L).injective).mpr haK0
  have hsolve : Fr.σ (u : L)
      = algebraMap K L (c * z) * (u : L) + algebraMap K L z * (r : L) := by
    rw [hz, map_mul, map_div₀, map_pow, map_pow]
    field_simp
    linear_combination hmainL
  have huL : (u : L) ≠ 0 := fun h => hu0 (Subtype.ext (by simpa using h))
  rcases hr with hr0 | hrα | hrβ
  · refine ⟨(u : L), c * z, 0, fun _ => 0, huL, u.2, mul_ne_zero hc hz0, Or.inl rfl,
      fun _ => Or.inl rfl, ?_⟩
    rw [hsolve, hr0]
    simp
  · refine ⟨(u : L), c * z, z * αK, fun _ => 0, huL, u.2, mul_ne_zero hc hz0, ?_,
      fun _ => Or.inl rfl, ?_⟩
    · exact Or.inr ⟨z, hz0, Or.inl rfl⟩
    · rw [hsolve, hrα]
      have : ((αE : ↥E) : L) = algebraMap K L αK := rfl
      rw [this, ← map_mul]
      simp
  · refine ⟨(u : L), c * z, z * g, fun j => z * A j, huL, u.2, mul_ne_zero hc hz0,
      Or.inr ⟨z, hz0, Or.inr rfl⟩, fun _ => Or.inr ⟨z, hz0, rfl⟩, ?_⟩
    have hb : ((βE : ↥E) : L)
        = algebraMap K L g + ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ := rfl
    have hsum : ∑ j ∈ Finset.range m, algebraMap K L (z * A j) * Fr.d^[j] τ
        = algebraMap K L z * ∑ j ∈ Finset.range m, algebraMap K L (A j) * Fr.d^[j] τ := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, mul_assoc]
    rw [hsolve, hrβ, hb, hsum,
      show algebraMap K L (z * g) = algebraMap K L z * algebraMap K L g from map_mul _ _ _]
    ring

theorem dK_zero (Fr : RittFrame K L) : Fr.dK 0 = 0 := by
  refine (algebraMap K L).injective ?_
  rw [← Fr.d_base, map_zero]
  exact Fr.d_zero

theorem d_sum (Fr : RittFrame K L) {ι : Type*} (s : Finset ι) (f : ι → L) :
    Fr.d (∑ i ∈ s, f i) = ∑ i ∈ s, Fr.d (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp only [Finset.sum_empty]; exact Fr.d_zero
  | insert a s ha ih => rw [Finset.sum_insert ha, Fr.d_add, ih, Finset.sum_insert ha]

/-- **The shift of a jet, with explicit lower-order coefficients.**  Faà di Bruno in the form the
tower descent consumes. -/
theorem exists_shift_jet_coeffs (Fr : RittFrame K L) {τ : L} {q : K}
    (hshift : Fr.σ τ = algebraMap K L q * τ) :
    ∀ n : ℕ, ∃ A : ℕ → K, (∀ j, n ≤ j → A j = 0) ∧ Fr.σ (Fr.d^[n] τ)
      = algebraMap K L (q / Fr.ρ ^ n) * Fr.d^[n] τ
        + ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j] τ := by
  have hρ0 : Fr.ρ ≠ 0 := Fr.ρ_ne
  have hρL : algebraMap K L Fr.ρ ≠ 0 :=
    (map_ne_zero_iff _ (algebraMap K L).injective).mpr hρ0
  intro n
  induction n with
  | zero => exact ⟨fun _ => 0, fun _ _ => rfl, by simpa using hshift⟩
  | succ n ih =>
      obtain ⟨A, hAsupp, hA⟩ := ih
      classical
      refine ⟨fun j => (Fr.dK (A j) + (if j = 0 then 0 else A (j - 1))
        + (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0)) / Fr.ρ, ?_, ?_⟩
      · intro j hj
        dsimp only
        rw [hAsupp j (by omega), dK_zero Fr, if_neg (by omega : ¬ j = n)]
        rcases Nat.eq_zero_or_pos j with h0 | hpos
        · omega
        · rw [if_neg (by omega : ¬ j = 0), hAsupp (j - 1) (by omega)]
          simp
      · have hchain := Fr.chain (Fr.d^[n] τ)
        rw [hA, Fr.d_add, Fr.d_mul, Fr.d_base, d_sum Fr] at hchain
        rw [← Function.iterate_succ_apply' Fr.d] at hchain
        have hterm : ∀ j : ℕ, Fr.d (algebraMap K L (A j) * Fr.d^[j] τ)
            = algebraMap K L (Fr.dK (A j)) * Fr.d^[j] τ
              + algebraMap K L (A j) * Fr.d^[j + 1] τ := by
          intro j
          rw [Fr.d_mul, Fr.d_base, ← Function.iterate_succ_apply' Fr.d]
        rw [Finset.sum_congr rfl (fun j _ => hterm j), Finset.sum_add_distrib] at hchain
        -- reindex the shifted sum
        have hshiftsum : ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j + 1] τ
            = ∑ j ∈ Finset.range (n + 1),
                algebraMap K L (if j = 0 then 0 else A (j - 1)) * Fr.d^[j] τ := by
          rw [Finset.sum_range_succ' (fun j => algebraMap K L (if j = 0 then 0 else A (j - 1))
            * Fr.d^[j] τ) n]
          simp
        have hdKsum : ∑ j ∈ Finset.range n, algebraMap K L (Fr.dK (A j)) * Fr.d^[j] τ
            = ∑ j ∈ Finset.range (n + 1), algebraMap K L (Fr.dK (A j)) * Fr.d^[j] τ := by
          rw [Finset.sum_range_succ, hAsupp n (le_refl n), dK_zero Fr, map_zero, zero_mul,
            add_zero]
        have hlast : algebraMap K L (Fr.dK (q / Fr.ρ ^ n)) * Fr.d^[n] τ
            = ∑ j ∈ Finset.range (n + 1),
                algebraMap K L (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0) * Fr.d^[j] τ := by
          rw [Finset.sum_eq_single n]
          · rw [if_pos rfl]
          · intro j _ hjn
            rw [if_neg hjn, map_zero, zero_mul]
          · intro h
            exact absurd (Finset.self_mem_range_succ n) h
        simp only [Nat.succ_eq_add_one] at hchain
        have hcoef : algebraMap K L Fr.ρ * algebraMap K L (q / Fr.ρ ^ (n + 1))
            = algebraMap K L (q / Fr.ρ ^ n) := by
          rw [← map_mul]
          congr 1
          rw [pow_succ]
          field_simp
        refine mul_left_cancel₀ hρL ?_
        dsimp only
        rw [mul_add, ← mul_assoc, hcoef, Finset.mul_sum]
        have hsimp : ∀ j : ℕ, algebraMap K L Fr.ρ *
            (algebraMap K L ((Fr.dK (A j) + (if j = 0 then 0 else A (j - 1))
              + (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0)) / Fr.ρ) * Fr.d^[j] τ)
            = (algebraMap K L (Fr.dK (A j)) + algebraMap K L (if j = 0 then 0 else A (j - 1))
              + algebraMap K L (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0)) * Fr.d^[j] τ := by
          intro j
          rw [map_div₀, map_add, map_add]
          field_simp
        rw [Finset.sum_congr rfl (fun j _ => hsimp j)]
        have hdist : ∀ j : ℕ, (algebraMap K L (Fr.dK (A j))
            + algebraMap K L (if j = 0 then 0 else A (j - 1))
            + algebraMap K L (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0)) * Fr.d^[j] τ
            = algebraMap K L (Fr.dK (A j)) * Fr.d^[j] τ
              + algebraMap K L (if j = 0 then 0 else A (j - 1)) * Fr.d^[j] τ
              + algebraMap K L (if j = n then Fr.dK (q / Fr.ρ ^ n) else 0) * Fr.d^[j] τ := by
          intro j; ring
        rw [Finset.sum_congr rfl (fun j _ => hdist j)]
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
        rw [← hdKsum, ← hshiftsum, ← hlast]
        linear_combination -hchain

/-- **The tower descent.**  An eigen-inhomogeneous relation over the whole jet prefix field descends
all the way to the base, keeping the inhomogeneity a base multiple of one of the original
coefficients. -/
theorem exists_base_relation_of_tower (Fr : RittFrame K L) {τ : L} {q : K}
    (hq : q ≠ 0) (hqconst : Fr.dK q = 0) (hshift : Fr.σ τ = algebraMap K L q * τ)
    (g₀ : K) (A₀ : ℕ → K) :
    ∀ (n : ℕ), (∀ k, k < n → Transcendental ↥(Fr.jetPrefixField τ k) (Fr.d^[k] τ)) →
      ∀ (W : L) (c g : K) (A : ℕ → K), W ≠ 0 → W ∈ Fr.jetPrefixField τ n → c ≠ 0 →
        (g = 0 ∨ ∃ (j : ℕ) (z : K), z ≠ 0 ∧ (g = z * A₀ j ∨ g = z * g₀)) →
        (∀ j, A j = 0 ∨ ∃ z : K, z ≠ 0 ∧ A j = z * A₀ j) →
        Fr.σ W = algebraMap K L c * W + algebraMap K L g
          + ∑ j ∈ Finset.range n, algebraMap K L (A j) * Fr.d^[j] τ →
        ∃ u c' g' : K, u ≠ 0 ∧ c' ≠ 0 ∧
          (g' = 0 ∨ ∃ (j : ℕ) (z : K), z ≠ 0 ∧ (g' = z * A₀ j ∨ g' = z * g₀)) ∧
          Fr.ψ u = c' * u + g' := by
  intro n
  induction n with
  | zero =>
      intro _ W c g A hW0 hWmem hc hginv _ hrel
      have hbot : Fr.jetPrefixField τ 0 = (⊥ : IntermediateField K L) := by
        rw [RittFrame.jetPrefixField,
          show {x : L | ∃ j < 0, x = Fr.d^[j] τ} = (∅ : Set L) by ext x; simp]
        exact IntermediateField.adjoin_empty K L
      rw [hbot, IntermediateField.mem_bot] at hWmem
      obtain ⟨u, hu⟩ := hWmem
      refine ⟨u, c, g, ?_, hc, hginv, ?_⟩
      · intro h
        exact hW0 (by rw [← hu, h, map_zero])
      · refine (algebraMap K L).injective ?_
        rw [map_add, map_mul, ← Fr.comp, hu]
        simpa using hrel
  | succ m ih =>
      intro htr W c g A hW0 hWmem hc hginv hAinv hrel
      obtain ⟨W', c', g', A', hW'0, hW'mem, hc'0, hg'inv, hA'inv, hrel'⟩ :=
        exists_descent_step Fr hq hqconst hshift (htr m (by omega)) hW0 hWmem hc hrel
      refine ih (fun k hk => htr k (by omega)) W' c' g' A' hW'0 hW'mem hc'0 ?_ ?_ hrel'
      · rcases hg'inv with h0 | ⟨z, hz0, hz⟩
        · exact Or.inl h0
        · rcases hz with hz | hz
          · rcases hAinv m with hA0 | ⟨z', hz'0, hz'⟩
            · exact Or.inl (by rw [hz, hA0, mul_zero])
            · exact Or.inr ⟨m, z * z', mul_ne_zero hz0 hz'0, Or.inl (by rw [hz, hz']; ring)⟩
          · rcases hginv with hg0 | ⟨j, z₁, hz₁0, hz₁⟩
            · exact Or.inl (by rw [hz, hg0, mul_zero])
            · rcases hz₁ with hz₁ | hz₁
              · exact Or.inr ⟨j, z * z₁, mul_ne_zero hz0 hz₁0, Or.inl (by rw [hz, hz₁]; ring)⟩
              · exact Or.inr ⟨j, z * z₁, mul_ne_zero hz0 hz₁0, Or.inr (by rw [hz, hz₁]; ring)⟩
      · intro j
        rcases hA'inv j with h0 | ⟨z, hz0, hz⟩
        · exact Or.inl h0
        · rcases hAinv j with hA0 | ⟨z', hz'0, hz'⟩
          · exact Or.inl (by rw [hz, hA0, mul_zero])
          · exact Or.inr ⟨z * z', mul_ne_zero hz0 hz'0, by rw [hz, hz']; ring⟩

end GaloisForLFunctions.HTGeometry
