import GaloisForLFunctions.HTGeometry.CyclicQuadraticUnique
import GaloisForLFunctions.HTGeometry.IntermediateFieldComap
import GaloisForLFunctions.HTGeometry.QuadraticSubextension

/-!
# Every square root inside a cyclic extension lies in the fixed one

A square root of a base element generates a quadratic subextension, and a cyclic extension has only
one of those.  So inside a cyclic extension all square roots of base elements generate the same
field, and in particular lie in the one generated by any fixed such square root.

This is the hypothesis that lets the square class decide the even case of the Kummer step.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped IntermediateField

variable {F L : Type*} [Field F] [CharZero F] [Field L] [Algebra F L]

omit [CharZero F] in
/-- **All square roots of base elements in a cyclic extension lie in one square-root
subextension.** -/
theorem mem_adjoin_of_sq_mem_of_isCyclic {M : IntermediateField F L}
    [FiniteDimensional F M] [IsGalois F M] (hcyc : IsCyclic (M ≃ₐ[F] M))
    {α : L} {c : F} (hsq : α * α = algebraMap F L c) (hαM : α ∈ M)
    (hα : α ∉ (⊥ : IntermediateField F L))
    {δ : L} (hδM : δ ∈ M) {e : F} (hδsq : δ * δ = algebraMap F L e)
    (hδbot : δ ∉ (⊥ : IntermediateField F L)) : δ ∈ F⟮α⟯ := by
  have hleδ : F⟮δ⟯ ≤ M := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact hδM
  have hleα : F⟮α⟯ ≤ M := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact hαM
  have h1 : Module.finrank F (IntermediateField.comap M.val F⟮δ⟯) = 2 := by
    rw [finrank_comap_val hleδ]
    exact finrank_adjoin_eq_two hδsq hδbot
  have h2 : Module.finrank F (IntermediateField.comap M.val F⟮α⟯) = 2 := by
    rw [finrank_comap_val hleα]
    exact finrank_adjoin_eq_two hsq hα
  have hK : IntermediateField.comap M.val F⟮δ⟯ = IntermediateField.comap M.val F⟮α⟯ :=
    eq_of_finrank_eq_two_of_isCyclic hcyc h1 h2
  have hmem : (⟨δ, hδM⟩ : M) ∈ IntermediateField.comap M.val F⟮δ⟯ :=
    IntermediateField.mem_adjoin_simple_self F δ
  rw [hK] at hmem
  exact hmem

end GaloisForLFunctions.HTGeometry
