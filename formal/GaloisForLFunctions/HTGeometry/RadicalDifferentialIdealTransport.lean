import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdealGeneration

/-!
# Transporting a generated radical differential ideal along a differential map

The preimage of a radical differential ideal under a differential ring map is again a radical
differential ideal, so generation travels: the radical differential ideal generated by a set lands
inside the one generated by its image.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped Differential
open GaloisForLFunctions

variable {R : Type*} [CommRing R] [Differential R]

/-- A differential ring map carries the radical differential ideal generated by a set into the one
generated by the image. -/
theorem map_mem_radicalDifferentialIdeal {R' : Type*} [CommRing R'] [Differential R']
    (f : R →+* R') (hf : ∀ x, f (Differential.deriv x) = Differential.deriv (f x))
    (S : Set R) {x : R} (hx : x ∈ radicalDifferentialIdeal S) :
    f x ∈ radicalDifferentialIdeal (f '' S) := by
  set J : Ideal R := Ideal.comap f (radicalDifferentialIdeal (f '' S)) with hJ
  have hSJ : S ⊆ (J : Set R) := by
    intro z hz
    exact subset_radicalDifferentialIdeal _ ⟨z, hz, rfl⟩
  have hradJ : J.IsRadical := by
    intro y hy
    obtain ⟨n, hn⟩ := hy
    have hpow : f y ^ n ∈ radicalDifferentialIdeal (f '' S) := by
      rw [← map_pow]; exact hn
    exact isRadical_radicalDifferentialIdeal _ ⟨n, hpow⟩
  have hδJ : ∀ y ∈ J, Differential.deriv y ∈ J := by
    intro y hy
    have hcomm : f (Differential.deriv y) = Differential.deriv (f y) := hf y
    show f (Differential.deriv y) ∈ radicalDifferentialIdeal (f '' S)
    rw [hcomm]
    exact deriv_mem_radicalDifferentialIdeal _ _ hy
  exact radicalDifferentialIdeal_le hSJ hradJ hδJ hx

end

end GaloisForLFunctions.HTGeometry
