import GaloisForLFunctions.HTGeometry.NormalClosureSheetAction
import Mathlib.Combinatorics.Matroid.Rank.ENat

/-!
# The algebraic-matroid rank of a finite family is the transcendence degree of its field

For a finite family `v` in a field extension `E/F`, the rank of `range v` in the algebraic matroid
of `E/F` equals the transcendence degree of the field `F(v)` it generates.

A matroid basis `I` of `range v` is algebraically independent inside `F(v)`, so it bounds the
transcendence degree from below.  Conversely `F(v)` is algebraic over the subalgebra generated by
`v`, so it has a transcendence basis `t ⊆ range v`, and the image of `t` in `E` is an independent
subset of `range v`, of size at most the rank.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open scoped IntermediateField.algebraAdjoinAdjoin

/-- **Matroid rank equals the transcendence degree of the generated field.** -/
theorem trdeg_adjoin_range_eq_eRk_toNat {F E : Type*} [Field F] [Field E] [Algebra F E]
    {ι : Type*} [Finite ι] (v : ι → E) :
    Algebra.trdeg F (IntermediateField.adjoin F (Set.range v)) =
      (((AlgebraicIndependent.matroid F E).eRk (Set.range v)).toNat : Cardinal) := by
  classical
  set L := IntermediateField.adjoin F (Set.range v)
  set M := AlgebraicIndependent.matroid F E
  haveI : FaithfulSMul F L :=
    (faithfulSMul_iff_algebraMap_injective F L).mpr (algebraMap F L).injective
  obtain ⟨I, hI⟩ := M.exists_isBasis (Set.range v) (by simp [M])
  have hIfin : I.Finite := (Set.finite_range v).subset hI.subset
  haveI : Finite I := hIfin
  have hrk : (M.eRk (Set.range v)).toNat = Nat.card I := by
    rw [← hI.encard_eq_eRk, ← hIfin.cast_ncard_eq, ENat.toNat_coe, Nat.card_coe_set_eq]
  rw [hrk]
  apply le_antisymm
  · -- a transcendence basis of `L` inside the generators
    set v' : ι → L := fun k => ⟨v k, IntermediateField.subset_adjoin F _ ⟨k, rfl⟩⟩
    have htop : IntermediateField.adjoin F (Set.range v') = ⊤ := adjoin_range_restrict_eq_top v
    haveI : Algebra.IsAlgebraic (IntermediateField.adjoin F (Set.range v')) L :=
      ⟨fun a => by
        have ha : a ∈ IntermediateField.adjoin F (Set.range v') := by rw [htop]; trivial
        exact isAlgebraic_algebraMap (⟨a, ha⟩ : IntermediateField.adjoin F (Set.range v'))⟩
    haveI : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range v')) L :=
      Algebra.IsAlgebraic.trans _ (IntermediateField.adjoin F (Set.range v')) L
    obtain ⟨t, hts, htb⟩ := exists_isTranscendenceBasis_subset (R := F) (A := L) (Set.range v')
    have htfin : t.Finite := (Set.finite_range v').subset hts
    haveI : Finite t := htfin
    rw [← htb.cardinalMk_eq_trdeg, ← Nat.cast_card]
    -- its image in `E` is independent inside `range v`
    let T : Set E := Subtype.val '' t
    let e : t ≃ T := Equiv.Set.image Subtype.val t Subtype.val_injective
    have hTind : AlgebraicIndependent F (fun z : T => (z : E)) := by
      have hmap := htb.1.map' (f := L.val) L.val.injective
      have h := hmap.comp e.symm e.symm.injective
      convert h using 1
      funext z
      obtain ⟨y, rfl⟩ := e.surjective z
      change ((e y : T) : E) = L.val ((e.symm (e y) : t) : L)
      rw [e.symm_apply_apply]
      rfl
    have hTsub : T ⊆ Set.range v := by
      rintro _ ⟨y, hy, rfl⟩
      obtain ⟨k, hk⟩ := hts hy
      exact ⟨k, congrArg Subtype.val hk⟩
    have hle := (show M.Indep T from hTind).encard_le_eRk_of_subset hTsub
    rw [← hI.encard_eq_eRk] at hle
    have hTfin : T.Finite := htfin.image _
    have hcard : Nat.card t ≤ Nat.card I := by
      have h1 : Nat.card T ≤ Nat.card I := by
        rw [Nat.card_coe_set_eq, Nat.card_coe_set_eq]
        exact_mod_cast (hTfin.cast_ncard_eq.trans_le (hle.trans hIfin.cast_ncard_eq.ge))
      rwa [← Nat.card_congr e] at h1
    exact_mod_cast hcard
  · -- the basis is independent inside `L`
    let w : I → L := fun x => ⟨x, IntermediateField.subset_adjoin F _ (hI.subset x.2)⟩
    have hw : AlgebraicIndependent F w :=
      AlgebraicIndependent.of_comp L.val (show AlgebraicIndependent F (fun x : I => (x : E)) from
        hI.indep)
    have h := hw.lift_cardinalMk_le_trdeg
    rwa [← Nat.cast_card, Cardinal.lift_natCast, Cardinal.nat_le_lift_iff] at h

end

end GaloisForLFunctions.HTGeometry
