import GaloisForLFunctions.HTGeometry.EsymmRadicalIrreducible

/-!
# The symmetric part and the field generated by the elementary symmetric functions

The symmetric part of the rational function field and the field its elementary symmetric functions
generate are the same intermediate field, so the two carriers are isomorphic as rings.

Statements proved about one — in particular the irreducibility of a radical polynomial over an
elementary symmetric function — therefore hold for the other, which is the base field the generic
polynomial is written over.
-/

namespace GaloisForLFunctions.HTGeometry

variable {K : Type*} [Field K] {d : ℕ}

/-- **The two descriptions of the coefficient field agree as rings.** -/
noncomputable def symmetricPartEquivEsymmField (K : Type*) [Field K] (d : ℕ) :
    symmetricPartField K d ≃+* esymmField K d :=
  (IntermediateField.equivOfEq (symmetricPartField_eq_esymmField (K := K) (d := d))).toRingEquiv

theorem coe_symmetricPartEquivEsymmField_symm (x : esymmField K d) :
    (((symmetricPartEquivEsymmField K d).symm x : symmetricPartField K d) :
      SymmetricRationalField K d) = (x : SymmetricRationalField K d) := rfl

/-- The elementary symmetric function, read in the symmetric part. -/
noncomputable def esymmCoeffSymm (K : Type*) [Field K] (d : ℕ) (i : Fin d) :
    symmetricPartField K d :=
  (symmetricPartEquivEsymmField K d).symm (esymmCoeff K d i)

/-- **The radical polynomial over an elementary symmetric function is irreducible over the
symmetric part.** -/
theorem irreducible_X_pow_sub_C_esymmCoeffSymm (i : Fin d) {n : ℕ} (hn : 0 < n) :
    Irreducible (Polynomial.X ^ n - Polynomial.C (esymmCoeffSymm K d i) :
      Polynomial (symmetricPartField K d)) := by
  have h := irreducible_X_pow_sub_C_map (symmetricPartEquivEsymmField K d).symm
    (irreducible_X_pow_sub_C_esymmCoeff (K := K) (d := d) i hn)
  exact h

/-- **A root generates an extension of exactly that degree over the symmetric part.** -/
theorem finrank_adjoin_esymmCoeffSymm_root {L : Type*} [Field L]
    [Algebra (symmetricPartField K d) L] (i : Fin d) {n : ℕ} (hn : 0 < n) {α : L}
    (hα : α ^ n = algebraMap (symmetricPartField K d) L (esymmCoeffSymm K d i)) :
    Module.finrank (symmetricPartField K d)
      (IntermediateField.adjoin (symmetricPartField K d) {α}) = n :=
  finrank_adjoin_of_irreducible hn (irreducible_X_pow_sub_C_esymmCoeffSymm i hn) hα

end GaloisForLFunctions.HTGeometry
