import GaloisForLFunctions.HTGeometry.DirectionalWordPolynomialSurjectivity
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Topology
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# General principal-symbol horizon ideal

A disjoint lower principal packet of total law degree `T`, followed by a terminal family of law
equations `P`, has coefficient ideal exactly

`idealOfVars ^ T * span (range P)`.

The first factor is universal: it records that lower jets vanish at the affine cone vertex, before
a law direction has been selected.  It contributes no new zero at a nonzero law direction and,
more generally, disappears from the projective zero locus.  This isolates the external terminal
constraint ideal as the entire projective horizon.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial
open scoped Pointwise

universe u v

variable {K : Type u} {ι η : Type v} [Field K]

/-- All monic law monomials of one fixed total principal degree. -/
def homogeneousPrincipalMonomialSet (T : ℕ) : Set (MvPolynomial ι K) :=
  (fun s : ι →₀ ℕ ↦ MvPolynomial.monomial s 1) ''
    (Finsupp.degree ⁻¹' ({T} : Set ℕ))

/-- The homogeneous terminal constraint ideal supplied externally to a principal realization. -/
def lawEquationIdeal (P : η → MvPolynomial ι K) : Ideal (MvPolynomial ι K) :=
  Ideal.span (Set.range P)

/-- The ideal generated by every lower-principal monomial times every terminal law equation. -/
def generalPrincipalSymbolIdeal (P : η → MvPolynomial ι K) (T : ℕ) :
    Ideal (MvPolynomial ι K) :=
  Ideal.span (homogeneousPrincipalMonomialSet (K := K) (ι := ι) T * Set.range P)

/-- **General principal-symbol factorization.**  Every lower principal contribution is the
universal `T`-th power of the irrelevant ideal; every model-specific contribution is in the
terminal constraint ideal. -/
theorem generalPrincipalSymbolIdeal_eq_irrelevantPow_mul
    (P : η → MvPolynomial ι K) (T : ℕ) :
    generalPrincipalSymbolIdeal P T =
      MvPolynomial.idealOfVars ι K ^ T * lawEquationIdeal P := by
  rw [generalPrincipalSymbolIdeal, lawEquationIdeal, homogeneousPrincipalMonomialSet,
    ← Ideal.span_mul_span', ← MvPolynomial.pow_idealOfVars_eq_span]

/-- At a nonzero law direction, the general principal-symbol products vanish exactly when all
terminal law equations vanish.  Thus the universal pretemporal factor creates only the affine
cone vertex, not a projective horizon component. -/
theorem eval_principalSymbolProducts_zero_iff
    (P : η → MvPolynomial ι K) (T : ℕ) (c : ι → K)
    (hc : ∃ i, c i ≠ 0) :
    (∀ q ∈ homogeneousPrincipalMonomialSet (K := K) (ι := ι) T,
        ∀ j, MvPolynomial.eval c (q * P j) = 0) ↔
      ∀ j, MvPolynomial.eval c (P j) = 0 := by
  classical
  constructor
  · intro h j
    obtain ⟨i, hi⟩ := hc
    let q : MvPolynomial ι K := MvPolynomial.monomial (Finsupp.single i T) 1
    have hq : q ∈ homogeneousPrincipalMonomialSet (K := K) (ι := ι) T := by
      refine ⟨Finsupp.single i T, ?_, rfl⟩
      simp
    have hqeval : MvPolynomial.eval c q ≠ 0 := by
      dsimp [q]
      rw [MvPolynomial.eval_monomial, one_mul,
        Finsupp.prod_single_index (by simp)]
      exact pow_ne_zero T hi
    have hprod : MvPolynomial.eval c q * MvPolynomial.eval c (P j) = 0 := by
      simpa using h q hq j
    exact (mul_eq_zero.mp hprod).resolve_left hqeval
  · intro h q hq j
    simp [h j]

/-- **Projective removal of the pretemporal vacuum factor.**  In every graded commutative ring,
a positive power of the irrelevant ideal multiplied into an arbitrary ideal has exactly the same
projective zero locus as that ideal. -/
theorem projective_zeroLocus_irrelevantPow_mul
    {A σ : Type*} [CommRing A] [SetLike σ A] [AddSubmonoidClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (I : Ideal A) (T : ℕ) (hT : T ≠ 0) :
    ProjectiveSpectrum.zeroLocus 𝒜
        ((((HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ T) * I : Ideal A) : Set A) =
      ProjectiveSpectrum.zeroLocus 𝒜 (I : Set A) := by
  have hirrelevant : ProjectiveSpectrum.zeroLocus 𝒜
      ((((HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ T) : Ideal A) : Set A) = ∅ := by
    ext x
    simp only [ProjectiveSpectrum.mem_zeroLocus, Set.mem_empty_iff_false, iff_false]
    intro hx
    exact x.not_irrelevant_le (Ideal.IsPrime.pow_le_iff hT |>.mp hx)
  rw [ProjectiveSpectrum.zeroLocus_mul_ideal, hirrelevant, Set.empty_union]

end

end GaloisForLFunctions.HTGeometry
