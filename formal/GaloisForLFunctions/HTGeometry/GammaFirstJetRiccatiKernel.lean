import Mathlib.Algebra.Polynomial.Div
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Span

/-!
# The principal Riccati kernel of the reciprocal first jet

At the leading Gamma factorial boundary the value and first derivative are

`M(x) = -1/x`, `M'(x) = M(x)²`.

This file records the complete algebraic kernel of that boundary.  In nested-polynomial
coordinates `W = M`, `Z = M'`, substitution `Z ↦ W²` has principal kernel generated by
`Z - W²`.  The result is proved over an arbitrary commutative coefficient ring, so the
coefficients may themselves encode all earlier Gamma-iterate jets.

The final normal form also extracts the maximal multiplicity along the Riccati divisor and leaves
a quotient whose boundary substitution is nonzero.  This is the algebraic input required by the
harmonic transverse-residue descent.
-/

namespace GaloisForLFunctions

noncomputable section

open Polynomial

universe u

section

variable {R : Type u} [CommRing R]

/-- The reciprocal first-jet boundary equation `Z - W²`. -/
def riccatiBoundaryFactor : Polynomial (Polynomial R) :=
  Polynomial.X - Polynomial.C (Polynomial.X ^ (2 : ℕ))

/-- Substitute the reciprocal boundary relation `Z = W²`. -/
def riccatiBoundarySubstitution (P : Polynomial (Polynomial R)) : Polynomial R :=
  P.eval (Polynomial.X ^ (2 : ℕ))

/-- The boundary substitution as a ring homomorphism. -/
def riccatiBoundarySubstitutionHom :
    Polynomial (Polynomial R) →+* Polynomial R :=
  Polynomial.evalRingHom (Polynomial.X ^ (2 : ℕ))

@[simp] theorem riccatiBoundarySubstitutionHom_apply
    (P : Polynomial (Polynomial R)) :
    riccatiBoundarySubstitutionHom P = riccatiBoundarySubstitution P := rfl

/-- Vanishing after `Z = W²` is equivalent to divisibility by `Z - W²`. -/
theorem riccatiBoundaryFactor_dvd_iff (P : Polynomial (Polynomial R)) :
    riccatiBoundaryFactor ∣ P ↔ riccatiBoundarySubstitution P = 0 := by
  rw [riccatiBoundaryFactor, Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
  rfl

/-- **Principal reciprocal-jet kernel.**  The complete kernel of `Z ↦ W²` is the principal
ideal `(Z - W²)`. -/
theorem ker_riccatiBoundarySubstitutionHom :
    RingHom.ker (riccatiBoundarySubstitutionHom (R := R)) =
      Ideal.span ({riccatiBoundaryFactor (R := R)} :
        Set (Polynomial (Polynomial R))) := by
  ext P
  rw [RingHom.mem_ker, Ideal.mem_span_singleton,
    riccatiBoundarySubstitutionHom_apply]
  exact (riccatiBoundaryFactor_dvd_iff P).symm

/-- Exact division with the canonical boundary remainder `P(W,W²)`. -/
theorem exists_riccatiBoundary_remainder (P : Polynomial (Polynomial R)) :
    ∃ Q : Polynomial (Polynomial R),
      P = Polynomial.C (riccatiBoundarySubstitution P) + riccatiBoundaryFactor * Q := by
  have hdvd : riccatiBoundaryFactor ∣
      P - Polynomial.C (riccatiBoundarySubstitution P) := by
    rw [riccatiBoundaryFactor, riccatiBoundarySubstitution]
    exact Polynomial.X_sub_C_dvd_sub_C_eval
  rcases hdvd with ⟨Q, hQ⟩
  refine ⟨Q, ?_⟩
  rw [← hQ]
  ring

/-- Multiplicity along the reciprocal first-jet boundary. -/
def riccatiBoundaryMultiplicity (P : Polynomial (Polynomial R)) : ℕ :=
  P.rootMultiplicity (Polynomial.X ^ (2 : ℕ))

/-- Every nonzero relation has a unique maximal Riccati-factor layer in the sense that removing
that power leaves a quotient with nonzero boundary substitution. -/
theorem exists_riccatiBoundaryMultiplicity_normalForm
    (P : Polynomial (Polynomial R)) (hP : P ≠ 0) :
    ∃ Q : Polynomial (Polynomial R),
      P = riccatiBoundaryFactor ^ riccatiBoundaryMultiplicity P * Q ∧
        riccatiBoundarySubstitution Q ≠ 0 := by
  rcases Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd
      P hP (Polynomial.X ^ (2 : ℕ)) with ⟨Q, hPQ, hQ⟩
  refine ⟨Q, ?_, ?_⟩
  · simpa [riccatiBoundaryFactor, riccatiBoundaryMultiplicity] using hPQ
  · exact (riccatiBoundaryFactor_dvd_iff Q).not.mp hQ

/-- Evaluation form of the exact boundary remainder decomposition. -/
theorem eval₂_riccatiBoundary_remainder
    (P Q : Polynomial (Polynomial R)) (w z : R)
    (hQ : P = Polynomial.C (riccatiBoundarySubstitution P) +
      riccatiBoundaryFactor * Q) :
    P.eval₂ (Polynomial.evalRingHom w) z =
      (riccatiBoundarySubstitution P).eval w +
        (z - w ^ (2 : ℕ)) * Q.eval₂ (Polynomial.evalRingHom w) z := by
  have hfactor : riccatiBoundaryFactor.eval₂ (Polynomial.evalRingHom w) z =
      z - w ^ (2 : ℕ) := by
    rw [riccatiBoundaryFactor, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C]
    simp
  conv_lhs => rw [hQ]
  rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, hfactor]
  simp [riccatiBoundarySubstitution, Polynomial.eval₂_C]

end


end


end GaloisForLFunctions
