import GaloisForLFunctions.HTGeometry.DifferentialSemilinearAutomorphism
import GaloisForLFunctions.HTGeometry.DifferentialUniformFaceGluing

/-!
# The gluing engine for base-normalizing differential automorphisms

The orbit-gluing theorems only need the acting automorphisms to preserve the differential rank.
That holds already when the coefficient field is preserved *setwise*: a differential semilinear
automorphism transports differential independence exactly, hence is an automorphism of the
differential matroid and of its rank.  This is the form needed when the base field is generated by
deeper translation orbits, which the translations move.

* **`DifferentialSemilinearEquiv.mem_differentialRank_rankAutSubgroup`** — a base-normalizing
  differential automorphism preserves the genuine differential rank;
* **`differentialRank_uniformFace_nestedStar_diffIndepOn_semilinear`** and
  **`..._of_orbit_semilinear`** — the all-order uniform-face gluing theorems for such
  automorphisms.
-/

open scoped Classical Differential

namespace GaloisForLFunctions

open Set
open MatroidGluing MatroidGluing.Rank

noncomputable section

universe u

namespace HTGeometry.DifferentialSemilinearEquiv

/-- A base-normalizing differential automorphism carries every differentially independent set to a
differentially independent image. -/
theorem diffIndepOn_image
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E]
    (sigma : DifferentialSemilinearEquiv F E) {S : Set E} (hS : DiffIndepOn F S) :
    DiffIndepOn F (sigma.ambientEquiv '' S) := by
  let e : S ≃ sigma.ambientEquiv '' S :=
    Equiv.Set.imageOfInjOn sigma.ambientEquiv S sigma.ambientEquiv.injective.injOn
  have hmap := sigma.differentialIndependent_map hS
  apply (differentialIndependent_equiv e
    (Subtype.val : sigma.ambientEquiv '' S → E)).mp
  simpa [e, Equiv.Set.imageOfInjOn] using! hmap

/-- Differential independence is invariant under a base-normalizing differential automorphism. -/
theorem diffIndepOn_image_iff
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E]
    (sigma : DifferentialSemilinearEquiv F E) (S : Set E) :
    DiffIndepOn F (sigma.ambientEquiv '' S) ↔ DiffIndepOn F S := by
  constructor
  · intro h
    have hback := sigma.symm.diffIndepOn_image h
    have heq : sigma.symm.ambientEquiv '' (sigma.ambientEquiv '' S) = S := by
      ext x
      constructor
      · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
        simpa [DifferentialSemilinearEquiv.symm] using hz
      · intro hx
        exact ⟨sigma.ambientEquiv x, ⟨x, hx, rfl⟩, by
          simp [DifferentialSemilinearEquiv.symm]⟩
    rwa [heq] at hback
  · exact sigma.diffIndepOn_image

end HTGeometry.DifferentialSemilinearEquiv

/-- A base-normalizing differential automorphism is an automorphism of the differential
matroid. -/
theorem differentialMatroid_mapEquiv_differentialSemilinearEquiv
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    (sigma : HTGeometry.DifferentialSemilinearEquiv F E) :
    (differentialMatroid F E).mapEquiv sigma.ambientEquiv.toEquiv =
      differentialMatroid F E := by
  apply Matroid.ext_indep
  · simp
  · intro I _
    rw [Matroid.mapEquiv_indep_iff, differentialMatroid_indep_iff,
      differentialMatroid_indep_iff]
    simpa [HTGeometry.DifferentialSemilinearEquiv.symm] using
      (sigma.symm.diffIndepOn_image_iff I)

/-- **Every base-normalizing differential automorphism preserves the genuine differential
rank.** -/
theorem HTGeometry.DifferentialSemilinearEquiv.mem_differentialRank_rankAutSubgroup
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    [DecidableEq E] (sigma : HTGeometry.DifferentialSemilinearEquiv F E) :
    sigma.ambientEquiv.toEquiv ∈ (differentialRank F E).rankAutSubgroup := by
  apply matroidRank_mem_rankAutSubgroup_of_mapEquiv_eq
  exact differentialMatroid_mapEquiv_differentialSemilinearEquiv sigma

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
  [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
  {V : Type*} [DecidableEq V]

/-- **All-order uniform-face nested-star gluing for base-normalizing automorphisms.** -/
theorem differentialRank_uniformFace_nestedStar_diffIndepOn_semilinear
    (faces : Finset (Finset V)) (O : Finset V → Set E)
    (σ : V → HTGeometry.DifferentialSemilinearEquiv F E) (s : ℕ)
    (huniform : ∀ J ∈ faces, J.card = s)
    (hAtomic : ∀ J ∈ faces, DiffIndepOn F (O J))
    (height : V → E → ℤ)
    (hStarStable : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      ∀ x ∈ faceStar faces O (insert q A), ∀ n : ℤ,
        ((σ q).ambientEquiv.toEquiv ^ n) x ∈ faceStar faces O (insert q A))
    (hStarHeight : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      ∀ x ∈ faceStar faces O (insert q A), ∀ n : ℤ,
        height q (((σ q).ambientEquiv.toEquiv ^ n) x) = height q x + n)
    (hOffDA : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      ∀ t : Finset E, (↑t : Set E) ⊆
          (⋃ J ∈ (faces.filter (fun J => A ⊆ J)).filter (fun J => q ∉ J), O J) →
        ∀ n : ℤ, ∀ z, z ∈ (↑(t.image ⇑((σ q).ambientEquiv.toEquiv ^ n)) : Set E) →
          DifferentialAlgebraicOver (differentialAdjoin F (↑t : Set E)) z) :
    DiffIndepOn F (faceStar faces O ∅) := by
  rw [← differentialRank_indepSet_iff]
  refine Rank.uniformFace_nestedStar_indep (differentialRank F E) faces O
    (fun q => (σ q).ambientEquiv.toEquiv) s huniform
    (fun J hJ => (differentialRank_indepSet_iff).mpr (hAtomic J hJ))
    (fun q => (σ q).mem_differentialRank_rankAutSubgroup) ?_ ?_
  · intro A q hA hq
    exact Rank.hasFreeTranslates_of_intHeight _ _ (height q)
      (hStarStable A q hA hq) (hStarHeight A q hA hq)
  · intro A q hA hq
    exact differentialRank_crossNeutral_of_image_differentialAlgebraic _ _
      (hOffDA A q hA hq)

/-- **All-order uniform-face gluing from an orbit parametrization, for base-normalizing
automorphisms.** -/
theorem differentialRank_uniformFace_nestedStar_diffIndepOn_of_orbit_semilinear
    (faces : Finset (Finset V)) (O : Finset V → Set E)
    (σ : V → HTGeometry.DifferentialSemilinearEquiv F E) (s : ℕ)
    (huniform : ∀ J ∈ faces, J.card = s)
    (hAtomic : ∀ J ∈ faces, DiffIndepOn F (O J))
    (base : Finset V → V → Set E)
    (hStarOrbit : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      faceStar faces O (insert q A) =
        orbitUnion ((σ q).ambientEquiv.toEquiv) (base A q))
    (hStarInj : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      ∀ (m n : ℤ) (y z : E), y ∈ base A q → z ∈ base A q →
        ((σ q).ambientEquiv.toEquiv ^ m) y = ((σ q).ambientEquiv.toEquiv ^ n) z → m = n)
    (hOffDA : ∀ (A : Finset V) (q : V), A.card < s → q ∉ A →
      ∀ t : Finset E, (↑t : Set E) ⊆
          (⋃ J ∈ (faces.filter (fun J => A ⊆ J)).filter (fun J => q ∉ J), O J) →
        ∀ n : ℤ, ∀ z, z ∈ (↑(t.image ⇑((σ q).ambientEquiv.toEquiv ^ n)) : Set E) →
          DifferentialAlgebraicOver (differentialAdjoin F (↑t : Set E)) z) :
    DiffIndepOn F (faceStar faces O ∅) := by
  rw [← differentialRank_indepSet_iff]
  refine Rank.uniformFace_nestedStar_indep (differentialRank F E) faces O
    (fun q => (σ q).ambientEquiv.toEquiv) s huniform
    (fun J hJ => (differentialRank_indepSet_iff).mpr (hAtomic J hJ))
    (fun q => (σ q).mem_differentialRank_rankAutSubgroup) ?_ ?_
  · intro A q hA hq
    rw [hStarOrbit A q hA hq]
    exact hasFreeTranslates_orbitUnion _ _ (hStarInj A q hA hq)
  · intro A q hA hq
    exact differentialRank_crossNeutral_of_image_differentialAlgebraic _ _
      (hOffDA A q hA hq)

end

end GaloisForLFunctions
