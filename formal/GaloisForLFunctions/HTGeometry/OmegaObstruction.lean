import Mathlib.Tactic
import GaloisForLFunctions.HTGeometry.Resonance
import GaloisForLFunctions.HTGeometry.OmegaComplexStructure

/-!
# The T2 weld obstruction as a carrier-free 2-cocycle

This module records the first formal gate for the D4 weld route: `ω` is treated as an
obstruction class, not as a constructed carrier.  The surface is deliberately minimal:

* a candidate obstruction is a 2-cocycle for a left `G`-module `A`;
* section-defect data packages a concrete defect formula and its associativity/cocycle law;
* changing local choices is a 1-cochain gauge change;
* gauge changes add 2-coboundaries;
* the resulting obstruction class lives in the quotient of 2-cocycles by 2-coboundaries.
* log-integrality is represented by requiring the cocycle to land in an action-stable
  additive subgroup of `A`.
* prime-log integrality specializes that subgroup to the lattice generated by `Real.log p`
  for prime `p`.
* polarization is represented by an external relation from obstruction classes to candidate
  operators `J`, plus the requirement that the induced `J` satisfy the already-formalized
  complex-structure and FE-form constraints.

Later T2 gates can specialize `G` to the Galois/prime-archimedean constraint group and `A`
to a log-integral lattice.  This file does not build those carriers.
-/

noncomputable section

namespace GaloisForLFunctions
namespace RHTower

variable {G A : Type*} [Group G] [AddCommGroup A] [DistribMulAction G A]

/-- Additive group-cohomology 2-cocycle equation for a left `G`-module `A`. -/
def IsTwoCocycle (omega : G -> G -> A) : Prop :=
  forall g h k, g • omega h k + omega g (h * k) = omega (g * h) k + omega g h

/-- The additive 2-coboundary of a 1-cochain. -/
def twoCoboundary (b : G -> A) : G -> G -> A :=
  fun g h => g • b h - b (g * h) + b g

@[simp]
theorem isTwoCocycle_zero : IsTwoCocycle (0 : G -> G -> A) := by
  intro g h k
  simp

/-- 2-cocycles are closed under pointwise addition. -/
theorem IsTwoCocycle.add {omega eta : G -> G -> A}
    (homega : IsTwoCocycle omega) (heta : IsTwoCocycle eta) :
    IsTwoCocycle (omega + eta) := by
  intro g h k
  calc
    g • (omega h k + eta h k) + (omega g (h * k) + eta g (h * k))
        = (g • omega h k + omega g (h * k)) +
            (g • eta h k + eta g (h * k)) := by
          simp [smul_add]
          abel
    _ = (omega (g * h) k + omega g h) +
          (eta (g * h) k + eta g h) := by
          rw [homega g h k, heta g h k]
    _ = (omega (g * h) k + eta (g * h) k) +
          (omega g h + eta g h) := by
          abel

/-- 2-cocycles are closed under pointwise negation. -/
theorem IsTwoCocycle.neg {omega : G -> G -> A} (homega : IsTwoCocycle omega) :
    IsTwoCocycle (-omega) := by
  intro g h k
  calc
    g • (-omega h k) + -omega g (h * k)
        = -(g • omega h k + omega g (h * k)) := by
          simp
          abel
    _ = -(omega (g * h) k + omega g h) := by rw [homega g h k]
    _ = -omega (g * h) k + -omega g h := by abel

/-- Additive 2-cocycles as a subgroup of 2-cochains. -/
def twoCocycles : AddSubgroup (G -> G -> A) where
  carrier := IsTwoCocycle
  zero_mem' := isTwoCocycle_zero
  add_mem' := fun {_ _} => IsTwoCocycle.add
  neg_mem' := fun {_} => IsTwoCocycle.neg

@[simp]
theorem twoCoboundary_zero : twoCoboundary (G := G) (A := A) (0 : G -> A) = 0 := by
  ext g h
  simp [twoCoboundary]

/-- The 2-coboundary operator is additive. -/
theorem twoCoboundary_add (b c : G -> A) :
    twoCoboundary (G := G) (A := A) (b + c) = twoCoboundary b + twoCoboundary c := by
  ext g h
  simp [twoCoboundary, smul_add]
  abel

/-- The 2-coboundary operator commutes with negation. -/
theorem twoCoboundary_neg (b : G -> A) :
    twoCoboundary (G := G) (A := A) (-b) = -twoCoboundary b := by
  ext g h
  simp [twoCoboundary]
  abel

/-- Every 2-coboundary is a 2-cocycle: `d₂(d₁ b) = 0`. -/
theorem twoCoboundary_isTwoCocycle (b : G -> A) :
    IsTwoCocycle (twoCoboundary (G := G) (A := A) b) := by
  intro g h k
  dsimp [twoCoboundary]
  simp [mul_smul, smul_add, smul_sub, mul_assoc]
  abel

/-- A 2-coboundary regarded as a 2-cocycle. -/
def twoCoboundaryCocycle (b : G -> A) : twoCocycles (G := G) (A := A) :=
  ⟨twoCoboundary b, twoCoboundary_isTwoCocycle b⟩

@[simp]
theorem twoCoboundaryCocycle_zero :
    twoCoboundaryCocycle (G := G) (A := A) (0 : G -> A) = 0 := by
  ext g h
  simp [twoCoboundaryCocycle]

/-- Coboundary cocycles add according to their 1-cochains. -/
theorem twoCoboundaryCocycle_add (b c : G -> A) :
    twoCoboundaryCocycle (G := G) (A := A) (b + c) =
      twoCoboundaryCocycle b + twoCoboundaryCocycle c := by
  ext g h
  simp [twoCoboundaryCocycle, twoCoboundary, smul_add]
  abel

/-- Coboundary cocycles negate according to their 1-cochains. -/
theorem twoCoboundaryCocycle_neg (b : G -> A) :
    twoCoboundaryCocycle (G := G) (A := A) (-b) = -twoCoboundaryCocycle b := by
  ext g h
  simp [twoCoboundaryCocycle, twoCoboundary]
  abel

/-- 2-coboundaries form a subgroup of 2-cocycles: gauge changes of local sections. -/
def twoCoboundaries : AddSubgroup (twoCocycles (G := G) (A := A)) where
  carrier := fun omega => exists b : G -> A, omega = twoCoboundaryCocycle b
  zero_mem' := ⟨0, (twoCoboundaryCocycle_zero (G := G) (A := A)).symm⟩
  add_mem' := by
    rintro _ _ ⟨b, rfl⟩ ⟨c, rfl⟩
    exact ⟨b + c, (twoCoboundaryCocycle_add b c).symm⟩
  neg_mem' := by
    rintro _ ⟨b, rfl⟩
    exact ⟨-b, (twoCoboundaryCocycle_neg b).symm⟩

/-- Carrier-free second constraint cohomology skeleton: 2-cocycles modulo gauge. -/
abbrev secondConstraintCohomology : Type _ :=
  twoCocycles (G := G) (A := A) ⧸ twoCoboundaries (G := G) (A := A)

/-- The obstruction class of a closed 2-cochain. -/
def obstructionClass (omega : twoCocycles (G := G) (A := A)) :
    secondConstraintCohomology (G := G) (A := A) :=
  QuotientAddGroup.mk omega

@[simp]
theorem obstructionClass_mk (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega =
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) := rfl

/-- A cocycle class vanishes exactly when the cocycle is a 2-coboundary. -/
theorem obstructionClass_eq_zero_iff (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega = 0 <-> omega ∈ twoCoboundaries (G := G) (A := A) := by
  exact QuotientAddGroup.eq_zero_iff omega

/--
Expanded zero-class criterion: the obstruction class vanishes exactly when the cocycle has
a 1-cochain primitive.
-/
theorem obstructionClass_eq_zero_iff_exists_cochain
    (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega = 0 <-> exists b : G -> A, omega = twoCoboundaryCocycle b := by
  exact obstructionClass_eq_zero_iff omega

/-- Nontriviality criterion for the obstruction class. -/
theorem obstructionClass_ne_zero_iff_not_exists_cochain
    (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega ≠ 0 <-> ¬ exists b : G -> A, omega = twoCoboundaryCocycle b := by
  constructor
  · intro hne hprimitive
    exact hne ((obstructionClass_eq_zero_iff_exists_cochain omega).mpr hprimitive)
  · intro hnot hzero
    exact hnot ((obstructionClass_eq_zero_iff_exists_cochain omega).mp hzero)

/-- Package a raw closed 2-cochain as a cocycle. -/
def cocycleOf (omega : G -> G -> A) (homega : IsTwoCocycle omega) :
    twoCocycles (G := G) (A := A) :=
  ⟨omega, homega⟩

/-- The obstruction class attached to a raw closed 2-cochain. -/
def obstructionClassOf (omega : G -> G -> A) (homega : IsTwoCocycle omega) :
    secondConstraintCohomology (G := G) (A := A) :=
  obstructionClass (cocycleOf omega homega)

/--
Raw closed-cochain zero criterion: the obstruction dies exactly when the formula is a
2-coboundary.
-/
theorem obstructionClassOf_eq_zero_iff_exists_cochain {omega : G -> G -> A}
    (homega : IsTwoCocycle omega) :
    obstructionClassOf omega homega = 0 <-> exists b : G -> A, omega = twoCoboundary b := by
  constructor
  · intro hzero
    rcases (obstructionClass_eq_zero_iff_exists_cochain (cocycleOf omega homega)).mp hzero with
      ⟨b, hb⟩
    exact ⟨b, congrArg Subtype.val hb⟩
  · rintro ⟨b, hb⟩
    exact (obstructionClass_eq_zero_iff_exists_cochain (cocycleOf omega homega)).mpr
      ⟨b, Subtype.ext hb⟩

/-- Raw closed-cochain nontriviality criterion. -/
theorem obstructionClassOf_ne_zero_iff_not_exists_cochain {omega : G -> G -> A}
    (homega : IsTwoCocycle omega) :
    obstructionClassOf omega homega ≠ 0 <-> ¬ exists b : G -> A, omega = twoCoboundary b := by
  constructor
  · intro hne hprimitive
    exact hne ((obstructionClassOf_eq_zero_iff_exists_cochain homega).mpr hprimitive)
  · intro hnot hzero
    exact hnot ((obstructionClassOf_eq_zero_iff_exists_cochain homega).mp hzero)

/--
A finite integer 2-chain tests a 2-cochain by summing its values over finitely many
group-pair slots.
-/
def twoChainEval (chain : G × G →₀ ℤ) (omega : G -> G -> A) : A :=
  chain.sum fun gh n => n • omega gh.1 gh.2

/--
A finite 2-chain is a nontriviality detector when it annihilates every 2-coboundary.
This is the carrier-free dual witness for Gate 4.
-/
structure TwoCoboundaryAnnihilator (G A : Type*) [Group G] [AddCommGroup A]
    [DistribMulAction G A] where
  chain : G × G →₀ ℤ
  kills_coboundaries :
    forall b : G -> A, twoChainEval chain (twoCoboundary (G := G) (A := A) b) = 0

namespace TwoCoboundaryAnnihilator

/-- Evaluate the annihilator on a raw 2-cochain. -/
def eval (T : TwoCoboundaryAnnihilator G A) (omega : G -> G -> A) : A :=
  twoChainEval T.chain omega

/--
Fail-fast nontriviality gate: if a coboundary-annihilating finite test chain evaluates
nontrivially on a closed cochain, then the obstruction class is nonzero.
-/
theorem obstructionClassOf_ne_zero_of_eval_ne_zero
    (T : TwoCoboundaryAnnihilator G A) {omega : G -> G -> A}
    (homega : IsTwoCocycle omega) (hne : T.eval omega ≠ 0) :
    obstructionClassOf omega homega ≠ 0 := by
  rw [obstructionClassOf_ne_zero_iff_not_exists_cochain homega]
  rintro ⟨b, hb⟩
  apply hne
  rw [hb]
  simpa [eval] using T.kills_coboundaries b

end TwoCoboundaryAnnihilator

/-- The finite antisymmetry test chain on a pair of group elements. -/
def commutingPairChain (g h : G) : G × G →₀ ℤ :=
  Finsupp.single (g, h) (1 : ℤ) - Finsupp.single (h, g) (1 : ℤ)

omit [Group G] [DistribMulAction G A] in
/-- The antisymmetry test evaluates to `omega g h - omega h g`. -/
theorem twoChainEval_commutingPairChain (g h : G) (omega : G -> G -> A) :
    twoChainEval (commutingPairChain g h) omega = omega g h - omega h g := by
  rw [commutingPairChain, twoChainEval, Finsupp.sum_sub_index]
  · simp
  · intro gh a b
    simpa [sub_eq_add_neg] using sub_zsmul (omega gh.1 gh.2) a b

/--
For trivial coefficient action, a commuting pair gives a concrete coboundary
annihilator: every 2-coboundary is symmetric on that pair.
-/
def commutingPairAnnihilator (htriv : forall g : G, forall a : A, g • a = a)
    {g h : G} (hcomm : g * h = h * g) : TwoCoboundaryAnnihilator G A where
  chain := commutingPairChain g h
  kills_coboundaries := by
    intro b
    rw [twoChainEval_commutingPairChain]
    simp [twoCoboundary, htriv, hcomm]
    abel

/-- On a commuting pair with trivial coefficient action, every 2-coboundary has zero antisymmetry. -/
theorem twoCoboundary_commutingPair_asymm_eq_zero
    (htriv : forall g : G, forall a : A, g • a = a) {g h : G}
    (hcomm : g * h = h * g) (b : G -> A) :
    twoCoboundary b g h - twoCoboundary b h g = 0 := by
  have hkill := (commutingPairAnnihilator (G := G) (A := A) htriv hcomm).kills_coboundaries b
  change twoChainEval (commutingPairChain g h) (twoCoboundary b) = 0 at hkill
  simpa [twoChainEval_commutingPairChain] using hkill

/--
Concrete Gate 4 pass condition: under trivial coefficient action, a closed cochain with
nonzero antisymmetry on a commuting pair is not a 2-coboundary.
-/
theorem obstructionClassOf_ne_zero_of_commutingPair_asymm
    (htriv : forall g : G, forall a : A, g • a = a) {g h : G}
    (hcomm : g * h = h * g) {omega : G -> G -> A} (homega : IsTwoCocycle omega)
    (hasymm : omega g h - omega h g ≠ 0) :
    obstructionClassOf omega homega ≠ 0 := by
  apply (commutingPairAnnihilator htriv hcomm).obstructionClassOf_ne_zero_of_eval_ne_zero homega
  simpa [TwoCoboundaryAnnihilator.eval, commutingPairAnnihilator,
    twoChainEval_commutingPairChain] using hasymm

section PolarizationGate

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/--
An externally supplied relation saying that an obstruction class induces a candidate `J`.
This records the target of the polarization gate without constructing the carrier.
-/
abbrev ClassInducesJ (G A V : Type*) [Group G] [AddCommGroup A] [DistribMulAction G A]
    [AddCommGroup V] [Module ℝ V] : Type _ :=
  secondConstraintCohomology (G := G) (A := A) → (V →ₗ[ℝ] V) → Prop

/--
A candidate obstruction class passes the polarization gate for `Q` when an induced `J`
satisfies the complex-structure and preservation equations.
-/
structure PolarizedObstructionRealization
    (InducesJ : ClassInducesJ G A V)
    (cls : secondConstraintCohomology (G := G) (A := A))
    (Q : LinearMap.BilinForm ℝ V) where
  J : V →ₗ[ℝ] V
  induced : InducesJ cls J
  sq : J.comp J = -LinearMap.id
  preserves : PreservesBilin Q J

namespace PolarizedObstructionRealization

/-- The polarization gate produces the existing local polarized complex-structure object. -/
def toPolarizedOmegaComplexStructure {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) :
    PolarizedOmegaComplexStructure V Q where
  complex := { J := R.J, sq := R.sq }
  preserves := R.preserves

/-- The polarization gate also produces the underlying complex-structure object. -/
def toOmegaComplexStructure {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) : OmegaComplexStructure V where
  J := R.J
  sq := R.sq

/-- The induced operator is skew-adjoint for the preserved FE form. -/
theorem induced_J_isSkewAdjoint {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) :
    Q.IsSkewAdjoint R.J := by
  exact R.toPolarizedOmegaComplexStructure.J_isSkewAdjoint

/-- Under symmetric polarization, the mixed right-`J` form is skew-symmetric. -/
theorem induced_Q_right_J_skew_of_isSymm {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) (hQ : Q.IsSymm) (x y : V) :
    Q x (R.J y) = -Q y (R.J x) := by
  exact R.toPolarizedOmegaComplexStructure.Q_right_J_skew_of_isSymm hQ x y

/-- Under symmetric polarization, every vector is `Q`-orthogonal to its induced `J`-partner. -/
theorem induced_Q_self_J_eq_zero_of_isSymm {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) (hQ : Q.IsSymm) (x : V) :
    Q x (R.J x) = 0 := by
  exact R.toPolarizedOmegaComplexStructure.Q_self_J_eq_zero_of_isSymm hQ x

/-- The induced `J` has no nonzero real eigendirections. -/
theorem induced_eq_zero_of_apply_eq_smul {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : PolarizedObstructionRealization InducesJ cls Q) {a : ℝ} {x : V}
    (h : R.J x = a • x) : x = 0 := by
  exact R.toOmegaComplexStructure.eq_zero_of_apply_eq_smul h

/-- A nonzero `Q`-self pairing forces at least two dimensions for any polarized realization. -/
theorem two_le_finrank_of_Q_self_ne_zero {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    [FiniteDimensional ℝ V] (R : PolarizedObstructionRealization InducesJ cls Q)
    {x : V} (hxQ : Q x x ≠ 0) :
    2 ≤ Module.finrank ℝ V := by
  exact R.toPolarizedOmegaComplexStructure.two_le_finrank_of_Q_self_ne_zero hxQ

end PolarizedObstructionRealization

/-- A successful T2 polarization pass is explicitly nontrivial in cohomology. -/
structure NontrivialPolarizedObstructionRealization
    (InducesJ : ClassInducesJ G A V)
    (cls : secondConstraintCohomology (G := G) (A := A))
    (Q : LinearMap.BilinForm ℝ V) where
  class_ne_zero : cls ≠ 0
  realization : PolarizedObstructionRealization InducesJ cls Q

/-- A zero obstruction class cannot pass the nontrivial polarization gate. -/
theorem no_nontrivialPolarizedObstructionRealization_of_eq_zero
    {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (hzero : cls = 0) :
    IsEmpty (NontrivialPolarizedObstructionRealization InducesJ cls Q) := by
  refine ⟨?_⟩
  intro R
  exact R.class_ne_zero hzero

/-- If a raw cocycle is a coboundary, it cannot pass the nontrivial polarization gate. -/
theorem no_nontrivialPolarizedObstructionRealization_of_coboundary
    {InducesJ : ClassInducesJ G A V} {Q : LinearMap.BilinForm ℝ V}
    {omega : G → G → A} (homega : IsTwoCocycle omega)
    (hprimitive : exists b : G → A, omega = twoCoboundary b) :
    IsEmpty (NontrivialPolarizedObstructionRealization InducesJ
      (obstructionClassOf omega homega) Q) := by
  have hzero : obstructionClassOf omega homega = 0 :=
    (obstructionClassOf_eq_zero_iff_exists_cochain homega).mpr hprimitive
  exact no_nontrivialPolarizedObstructionRealization_of_eq_zero hzero

/-- Odd finite-dimensional targets cannot pass the polarization gate. -/
theorem no_polarizedObstructionRealization_of_odd_finrank
    {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    [FiniteDimensional ℝ V] (hodd : Odd (Module.finrank ℝ V)) :
    IsEmpty (PolarizedObstructionRealization InducesJ cls Q) := by
  refine ⟨?_⟩
  intro R
  have hEmpty : IsEmpty (PolarizedOmegaComplexStructure V Q) :=
    PolarizedOmegaComplexStructure.no_polarizedOmegaComplexStructure_of_odd_finrank hodd
  exact isEmptyElim R.toPolarizedOmegaComplexStructure

/-- Rank-one finite-dimensional targets cannot pass the polarization gate. -/
theorem no_polarizedObstructionRealization_of_finrank_eq_one
    {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    [FiniteDimensional ℝ V] (hfin : Module.finrank ℝ V = 1) :
    IsEmpty (PolarizedObstructionRealization InducesJ cls Q) := by
  refine ⟨?_⟩
  intro R
  have hEmpty : IsEmpty (PolarizedOmegaComplexStructure V Q) :=
    PolarizedOmegaComplexStructure.no_polarizedOmegaComplexStructure_of_finrank_eq_one hfin
  exact isEmptyElim R.toPolarizedOmegaComplexStructure

namespace NontrivialPolarizedObstructionRealization

/-- Forget the nontriviality witness and retain the polarization realization. -/
def toPolarizedObstructionRealization {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q) :
    PolarizedObstructionRealization InducesJ cls Q :=
  R.realization

/-- The local polarized complex structure produced by a nontrivial obstruction realization. -/
def toPolarizedOmegaComplexStructure {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q) :
    PolarizedOmegaComplexStructure V Q :=
  R.realization.toPolarizedOmegaComplexStructure

/-- D4 forced-pair constraint: every nonzero vector pairs with its induced `J`-partner. -/
theorem forced_pair_linearIndependent {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q) {x : V} (hx : x ≠ 0) :
    LinearIndependent ℝ ![x, R.realization.J x] := by
  exact R.realization.toOmegaComplexStructure.linearIndependent_pair hx

/-- D4 dimension constraint from any nonzero vector. -/
theorem two_le_finrank_of_ne_zero {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    [FiniteDimensional ℝ V]
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q) {x : V} (hx : x ≠ 0) :
    2 ≤ Module.finrank ℝ V := by
  exact R.realization.toOmegaComplexStructure.two_le_finrank_of_ne_zero hx

/-- D4 area block: the mixed `J`-slot form is determinant times `Q x x`. -/
theorem Q_compl2_J_apply_span_pair_of_isSymm {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q)
    (hQ : Q.IsSymm) (x : V) (a b c d : ℝ) :
    (Q.compl₂ R.realization.J) (a • x + b • R.realization.J x)
        (c • x + d • R.realization.J x) = (b * c - a * d) * Q x x := by
  exact R.toPolarizedOmegaComplexStructure.Q_compl2_J_apply_span_pair_of_isSymm hQ x a b c d

/-- D4 dot block: the symmetric form is dot product times `Q x x`. -/
theorem Q_apply_span_pair_of_isSymm {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q)
    (hQ : Q.IsSymm) (x : V) (a b c d : ℝ) :
    Q (a • x + b • R.realization.J x) (c • x + d • R.realization.J x) =
      (a * c + b * d) * Q x x := by
  exact R.toPolarizedOmegaComplexStructure.Q_apply_span_pair_of_isSymm hQ x a b c d

/--
D4 non-isotropy: on a nonisotropic forced pair, self-pairing vanishes only at zero
coefficients.
-/
theorem Q_apply_span_self_eq_zero_iff_of_isSymm {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q)
    (hQ : Q.IsSymm) {x : V} {a b : ℝ} (hxQ : Q x x ≠ 0) :
    Q (a • x + b • R.realization.J x) (a • x + b • R.realization.J x) = 0 ↔
      a = 0 ∧ b = 0 := by
  exact R.toPolarizedOmegaComplexStructure.Q_apply_span_self_eq_zero_iff_of_isSymm hQ hxQ

/--
D4 mixed-form zero criterion: area zero is exactly mixed-form zero on a nonisotropic forced
pair.
-/
theorem Q_compl2_J_apply_span_pair_eq_zero_iff_of_isSymm
    {InducesJ : ClassInducesJ G A V}
    {cls : secondConstraintCohomology (G := G) (A := A)} {Q : LinearMap.BilinForm ℝ V}
    (R : NontrivialPolarizedObstructionRealization InducesJ cls Q)
    (hQ : Q.IsSymm) {x : V} {a b c d : ℝ} (hxQ : Q x x ≠ 0) :
    (Q.compl₂ R.realization.J) (a • x + b • R.realization.J x)
        (c • x + d • R.realization.J x) = 0 ↔ b * c - a * d = 0 := by
  exact R.toPolarizedOmegaComplexStructure.Q_compl2_J_apply_span_pair_eq_zero_iff_of_isSymm
    hQ hxQ

end NontrivialPolarizedObstructionRealization

end PolarizationGate

/-- Gauge update of a 2-cochain by a 1-cochain. -/
def gaugeUpdate (omega : G -> G -> A) (b : G -> A) : G -> G -> A :=
  omega + twoCoboundary b

/-- Gauge-updating a 2-cocycle by any 1-cochain leaves it a 2-cocycle. -/
theorem gaugeUpdate_isTwoCocycle {omega : G -> G -> A} (homega : IsTwoCocycle omega)
    (b : G -> A) : IsTwoCocycle (gaugeUpdate omega b) := by
  exact homega.add (twoCoboundary_isTwoCocycle b)

/-- Gauge update internal to the subgroup of 2-cocycles. -/
def gaugeUpdateCocycle (omega : twoCocycles (G := G) (A := A)) (b : G -> A) :
    twoCocycles (G := G) (A := A) :=
  omega + twoCoboundaryCocycle b

/--
The obstruction class is gauge-invariant: changing local section data by a 1-cochain
does not change the class in 2-cocycles modulo 2-coboundaries.
-/
theorem gaugeUpdateCocycle_same_class (omega : twoCocycles (G := G) (A := A))
    (b : G -> A) :
    QuotientAddGroup.mk (gaugeUpdateCocycle omega b) =
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) := by
  rw [QuotientAddGroup.eq]
  change -(gaugeUpdateCocycle omega b) + omega ∈ twoCoboundaries (G := G) (A := A)
  refine ⟨-b, ?_⟩
  ext g h
  simp [gaugeUpdateCocycle, twoCoboundaryCocycle, twoCoboundary]
  abel

/--
The commuting-pair antisymmetry detector is gauge-invariant under resection by any
1-cochain, provided the coefficient action is trivial on a commuting pair.
-/
theorem gaugeUpdate_commutingPair_asymm_eq
    (htriv : forall g : G, forall a : A, g • a = a) {g h : G}
    (hcomm : g * h = h * g) (omega : G -> G -> A) (b : G -> A) :
    gaugeUpdate omega b g h - gaugeUpdate omega b h g = omega g h - omega h g := by
  have hzero : twoCoboundary b g h - twoCoboundary b h g = 0 :=
    twoCoboundary_commutingPair_asymm_eq_zero htriv hcomm b
  rw [gaugeUpdate]
  simp only [Pi.add_apply]
  calc
    omega g h + twoCoboundary b g h - (omega h g + twoCoboundary b h g)
        = (twoCoboundary b g h - twoCoboundary b h g) + (omega g h - omega h g) := by
          abel
    _ = omega g h - omega h g := by
          rw [hzero]
          simp

/--
Carrier-free section-defect data: a formula for the defect and the associativity law saying
that this formula is a 2-cocycle.
-/
structure SectionDefect (G A : Type*) [Group G] [AddCommGroup A] [DistribMulAction G A] where
  defect : G -> G -> A
  associative : IsTwoCocycle defect

namespace SectionDefect

/-- The cocycle packaged by section-defect data. -/
def cocycle (D : SectionDefect G A) : twoCocycles (G := G) (A := A) :=
  cocycleOf D.defect D.associative

/-- The obstruction class of section-defect data. -/
def obstruction (D : SectionDefect G A) : secondConstraintCohomology (G := G) (A := A) :=
  obstructionClass D.cocycle

/--
Resectioning by a 1-cochain changes the defect formula by the 2-coboundary of that
cochain.
-/
def resection (D : SectionDefect G A) (b : G -> A) : SectionDefect G A where
  defect := gaugeUpdate D.defect b
  associative := gaugeUpdate_isTwoCocycle D.associative b

@[simp]
theorem resection_defect_apply (D : SectionDefect G A) (b : G -> A) (g h : G) :
    (D.resection b).defect g h = D.defect g h + twoCoboundary b g h := rfl

/-- Resectioning is the cocycle-level gauge update. -/
theorem resection_cocycle_eq_gaugeUpdateCocycle (D : SectionDefect G A) (b : G -> A) :
    (D.resection b).cocycle = gaugeUpdateCocycle D.cocycle b := by
  ext g h
  rfl

/-- Resectioning changes the formula by a coboundary but preserves the obstruction class. -/
theorem resection_obstruction_eq (D : SectionDefect G A) (b : G -> A) :
    (D.resection b).obstruction = D.obstruction := by
  rw [obstruction, obstruction, resection_cocycle_eq_gaugeUpdateCocycle]
  exact gaugeUpdateCocycle_same_class D.cocycle b

/-- A defect produced by one global 1-cochain is a pure coboundary. -/
def globalChoiceDefect (b : G -> A) : SectionDefect G A where
  defect := twoCoboundary b
  associative := twoCoboundary_isTwoCocycle b

/-- A global-choice defect has zero obstruction class, so it cannot be the nontrivial weld. -/
theorem globalChoiceDefect_obstruction_eq_zero (b : G -> A) :
    (globalChoiceDefect (G := G) (A := A) b).obstruction = 0 := by
  exact (obstructionClass_eq_zero_iff_exists_cochain
    (globalChoiceDefect (G := G) (A := A) b).cocycle).mpr ⟨b, rfl⟩

/-- A section-defect obstruction is zero exactly when its formula is one global coboundary. -/
theorem obstruction_eq_zero_iff_exists_global_choice (D : SectionDefect G A) :
    D.obstruction = 0 <-> exists b : G -> A, D.defect = twoCoboundary b := by
  simpa [obstruction, obstructionClassOf, cocycle] using
    (obstructionClassOf_eq_zero_iff_exists_cochain D.associative)

/--
Nontriviality of section-defect data is exactly failure to be a global 1-cochain
coboundary.
-/
theorem obstruction_ne_zero_iff_not_exists_global_choice (D : SectionDefect G A) :
    D.obstruction ≠ 0 <-> ¬ exists b : G -> A, D.defect = twoCoboundary b := by
  exact obstructionClassOf_ne_zero_iff_not_exists_cochain D.associative

/--
Fail-fast nontriviality gate for section-defect data: a finite test chain that kills all
2-coboundaries but evaluates nontrivially on the defect proves that the obstruction is
not gauge.
-/
theorem obstruction_ne_zero_of_annihilator_eval_ne_zero (D : SectionDefect G A)
    (T : TwoCoboundaryAnnihilator G A) (hne : T.eval D.defect ≠ 0) :
    D.obstruction ≠ 0 := by
  rw [D.obstruction_ne_zero_iff_not_exists_global_choice]
  rintro ⟨b, hb⟩
  apply hne
  rw [hb]
  simpa [TwoCoboundaryAnnihilator.eval] using T.kills_coboundaries b

/--
Concrete Gate 4 pass condition for section defects: with trivial coefficient action,
nonzero antisymmetry on a commuting pair proves that the defect is not gauge.
-/
theorem obstruction_ne_zero_of_commutingPair_asymm (D : SectionDefect G A)
    (htriv : forall g : G, forall a : A, g • a = a) {g h : G}
    (hcomm : g * h = h * g) (hasymm : D.defect g h - D.defect h g ≠ 0) :
    D.obstruction ≠ 0 := by
  exact obstructionClassOf_ne_zero_of_commutingPair_asymm htriv hcomm D.associative hasymm

/--
The commuting-pair antisymmetry detector is invariant under changing local section data.
Thus this Gate-4 test is attached to the obstruction class, not to the chosen section.
-/
theorem resection_commutingPair_asymm_eq (D : SectionDefect G A)
    (htriv : forall g : G, forall a : A, g • a = a) {g h : G}
    (hcomm : g * h = h * g) (b : G -> A) :
    (D.resection b).defect g h - (D.resection b).defect h g =
      D.defect g h - D.defect h g := by
  simpa [resection] using gaugeUpdate_commutingPair_asymm_eq htriv hcomm D.defect b

section Polarization

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- A global-choice section defect cannot pass the nontrivial polarization gate. -/
theorem no_nontrivialPolarizedObstructionRealization_of_global_choice
    {InducesJ : ClassInducesJ G A V} {Q : LinearMap.BilinForm ℝ V}
    (D : SectionDefect G A) (hglobal : exists b : G -> A, D.defect = twoCoboundary b) :
    IsEmpty (NontrivialPolarizedObstructionRealization InducesJ D.obstruction Q) := by
  have hzero : D.obstruction = 0 := (D.obstruction_eq_zero_iff_exists_global_choice).mpr hglobal
  exact no_nontrivialPolarizedObstructionRealization_of_eq_zero hzero

end Polarization

end SectionDefect

/-- An additive subgroup is stable under the left `G`-action. -/
def IsActionStable (G : Type*) [Group G] [DistribMulAction G A]
    (Lambda : AddSubgroup A) : Prop :=
  forall (g : G) {x : A}, x ∈ Lambda -> g • x ∈ Lambda

/-- A 2-cochain is valued in the coefficient lattice/subgroup `Lambda`. -/
def IsLatticeValued (Lambda : AddSubgroup A) (omega : G -> G -> A) : Prop :=
  forall g h, omega g h ∈ Lambda

omit [Group G] [DistribMulAction G A] in
@[simp]
theorem isLatticeValued_zero (Lambda : AddSubgroup A) :
    IsLatticeValued (G := G) Lambda (0 : G -> G -> A) := by
  intro g h
  simp

omit [Group G] [DistribMulAction G A] in
/-- Lattice-valued cochains are closed under pointwise addition. -/
theorem IsLatticeValued.add {Lambda : AddSubgroup A} {omega eta : G -> G -> A}
    (homega : IsLatticeValued Lambda omega) (heta : IsLatticeValued Lambda eta) :
    IsLatticeValued Lambda (omega + eta) := by
  intro g h
  exact Lambda.add_mem (homega g h) (heta g h)

omit [Group G] [DistribMulAction G A] in
/-- Lattice-valued cochains are closed under pointwise negation. -/
theorem IsLatticeValued.neg {Lambda : AddSubgroup A} {omega : G -> G -> A}
    (homega : IsLatticeValued Lambda omega) : IsLatticeValued Lambda (-omega) := by
  intro g h
  exact Lambda.neg_mem (homega g h)

/-- 2-cocycles whose values land in the coefficient lattice/subgroup. -/
def latticeTwoCocycles (Lambda : AddSubgroup A) :
    AddSubgroup (twoCocycles (G := G) (A := A)) where
  carrier := fun omega => IsLatticeValued Lambda (omega : G -> G -> A)
  zero_mem' := isLatticeValued_zero Lambda
  add_mem' := fun {_ _} => IsLatticeValued.add
  neg_mem' := fun {_} => IsLatticeValued.neg

/-- Cohomology classes that admit a lattice-valued cocycle representative. -/
def IsLatticeClass (Lambda : AddSubgroup A)
    (cls : secondConstraintCohomology (G := G) (A := A)) : Prop :=
  exists omega : twoCocycles (G := G) (A := A),
    IsLatticeValued Lambda (omega : G -> G -> A) ∧ QuotientAddGroup.mk omega = cls

/-- A lattice-valued cocycle represents a lattice-valued obstruction class. -/
theorem isLatticeClass_mk {Lambda : AddSubgroup A}
    {omega : twoCocycles (G := G) (A := A)}
    (homega : IsLatticeValued Lambda (omega : G -> G -> A)) :
    IsLatticeClass Lambda
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) :=
  ⟨omega, homega, rfl⟩

/-- The 2-coboundary of a lattice-valued 1-cochain is lattice-valued. -/
theorem twoCoboundary_isLatticeValued {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) {b : G -> A}
    (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (twoCoboundary (G := G) (A := A) b) := by
  intro g h
  exact Lambda.add_mem (Lambda.sub_mem (hstable g (hb h)) (hb (g * h))) (hb g)

/-- Gauge-updating by a lattice-valued 1-cochain preserves lattice-valuedness. -/
theorem gaugeUpdate_isLatticeValued {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) {omega : G -> G -> A} {b : G -> A}
    (homega : IsLatticeValued Lambda omega) (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdate omega b) := by
  exact homega.add (twoCoboundary_isLatticeValued hstable hb)

/--
Log-integrality is a gauge-invariant gate under lattice-valued section changes:
after adding a lattice 2-coboundary, being valued in `Lambda` is equivalent to the
original cocycle being valued in `Lambda`.
-/
theorem gaugeUpdate_isLatticeValued_iff {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) (omega : G -> G -> A) {b : G -> A}
    (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdate omega b) <-> IsLatticeValued Lambda omega := by
  constructor
  · intro h g k
    have hboundary : twoCoboundary (G := G) (A := A) b g k ∈ Lambda :=
      twoCoboundary_isLatticeValued hstable hb g k
    have hsub : gaugeUpdate omega b g k - twoCoboundary b g k ∈ Lambda :=
      Lambda.sub_mem (h g k) hboundary
    simpa [gaugeUpdate] using hsub
  · intro homega
    exact gaugeUpdate_isLatticeValued hstable homega hb

/-- Subgroup-level form of lattice-gauge invariance for obstruction cocycles. -/
theorem gaugeUpdateCocycle_isLatticeValued_iff {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) (omega : twoCocycles (G := G) (A := A))
    {b : G -> A} (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdateCocycle omega b : G -> G -> A) <->
      IsLatticeValued Lambda (omega : G -> G -> A) := by
  simpa [gaugeUpdateCocycle, gaugeUpdate, twoCoboundaryCocycle] using
    (gaugeUpdate_isLatticeValued_iff (G := G) (A := A) hstable (omega : G -> G -> A) hb)

/-- The generating set `{log p | p prime}` for the prime-log lattice. -/
def primeLogSet : Set ℝ := {x | exists p : ℕ, p.Prime ∧ x = Real.log p}

/-- The additive subgroup generated by prime logarithms. -/
def primeLogLattice : AddSubgroup ℝ := AddSubgroup.closure primeLogSet

/-- Each prime logarithm lies in the prime-log lattice. -/
theorem primeLog_mem_primeLogLattice {p : ℕ} (hp : p.Prime) :
    Real.log p ∈ primeLogLattice := by
  exact AddSubgroup.subset_closure ⟨p, hp, rfl⟩

/-- A real number has a finite integer expansion in prime logarithms. -/
def PrimeLogExpansion (x : ℝ) : Prop :=
  exists coeff : ℕ →₀ ℤ,
    (forall p : ℕ, coeff p ≠ 0 -> p.Prime) ∧
      x = coeff.sum (fun p n => n • Real.log p)

/-- A finite integer prime-log expansion lands in the prime-log lattice. -/
theorem PrimeLogExpansion.mem_primeLogLattice {x : ℝ} (hx : PrimeLogExpansion x) :
    x ∈ primeLogLattice := by
  rcases hx with ⟨coeff, hprime, rfl⟩
  rw [Finsupp.sum]
  exact AddSubgroup.sum_mem primeLogLattice fun p hp =>
    primeLogLattice.zsmul_mem
      (primeLog_mem_primeLogLattice (hprime p (Finsupp.mem_support_iff.mp hp))) (coeff p)

variable {Greal : Type*}

/-- The T2 log-integrality predicate specialized to the prime-log lattice. -/
def IsPrimeLogIntegral (omega : Greal -> Greal -> ℝ) : Prop :=
  IsLatticeValued primeLogLattice omega

/-- Fail-fast rejection for the log-integrality gate. -/
theorem not_isPrimeLogIntegral_of_value_not_mem {omega : Greal -> Greal -> ℝ}
    {g h : Greal} (hnot : omega g h ∉ primeLogLattice) :
    ¬ IsPrimeLogIntegral omega := by
  intro homega
  exact hnot (homega g h)

/-- A concrete finite prime-log formula for every value of a 2-cochain. -/
structure PrimeLogCochainFormula (omega : Greal -> Greal -> ℝ) where
  coeff : Greal -> Greal -> ℕ →₀ ℤ
  prime_support : forall g h p, coeff g h p ≠ 0 -> p.Prime
  eval_eq : forall g h, omega g h = (coeff g h).sum (fun p n => n • Real.log p)

/-- A cochain with a prime-log formula is prime-log integral. -/
theorem PrimeLogCochainFormula.isPrimeLogIntegral {omega : Greal -> Greal -> ℝ}
    (formula : PrimeLogCochainFormula omega) : IsPrimeLogIntegral omega := by
  intro g h
  exact PrimeLogExpansion.mem_primeLogLattice
    ⟨formula.coeff g h, formula.prime_support g h, formula.eval_eq g h⟩

/-- A value outside the prime-log lattice rules out any finite prime-log formula. -/
theorem no_primeLogCochainFormula_of_value_not_mem {omega : Greal -> Greal -> ℝ}
    {g h : Greal} (hnot : omega g h ∉ primeLogLattice) :
    IsEmpty (PrimeLogCochainFormula omega) := by
  refine ⟨?_⟩
  intro formula
  exact (not_isPrimeLogIntegral_of_value_not_mem hnot) formula.isPrimeLogIntegral

variable [Group Greal] [DistribMulAction Greal ℝ]

/-- Gauge invariance of the prime-log integrality gate. -/
theorem gaugeUpdate_isPrimeLogIntegral_iff
    (hstable : IsActionStable Greal primeLogLattice) (omega : Greal -> Greal -> ℝ)
    {b : Greal -> ℝ} (hb : forall g, b g ∈ primeLogLattice) :
    IsPrimeLogIntegral (gaugeUpdate omega b) <-> IsPrimeLogIntegral omega := by
  exact gaugeUpdate_isLatticeValued_iff hstable omega hb

/-- A real number has a finite integer expansion indexed directly by prime numbers. -/
def PrimeIndexedLogExpansion (x : ℝ) : Prop :=
  exists coeff : Nat.Primes →₀ ℤ,
    x = coeff.sum (fun p n => n • Real.log (p : ℕ))

/-- A finite prime-indexed expansion lands in the prime-log lattice. -/
theorem PrimeIndexedLogExpansion.mem_primeLogLattice {x : ℝ}
    (hx : PrimeIndexedLogExpansion x) : x ∈ primeLogLattice := by
  rcases hx with ⟨coeff, rfl⟩
  rw [Finsupp.sum]
  exact AddSubgroup.sum_mem primeLogLattice fun p _hp =>
    primeLogLattice.zsmul_mem (primeLog_mem_primeLogLattice p.prop) (coeff p)

/-- Unique factorization kills every zero prime-log expansion. -/
theorem primeIndexedLogExpansion_coeff_eq_zero_of_sum_eq_zero {coeff : Nat.Primes →₀ ℤ}
    (hzero : coeff.sum (fun p n => n • Real.log (p : ℕ)) = 0) : coeff = 0 := by
  exact logPrime_diagonalResonant_eq_zero (by simpa [diagonalResonant] using hzero)

/-- Prime-indexed coefficient packets are uniquely determined by their real prime-log sum. -/
theorem primeIndexedLogExpansion_coeff_eq_of_sum_eq {coeff eta : Nat.Primes →₀ ℤ}
    (h : coeff.sum (fun p n => n • Real.log (p : ℕ)) =
      eta.sum (fun p n => n • Real.log (p : ℕ))) : coeff = eta := by
  apply sub_eq_zero.mp
  apply primeIndexedLogExpansion_coeff_eq_zero_of_sum_eq_zero
  rw [Finsupp.sum_sub_index]
  · rw [h, sub_self]
  · intro p a b
    rw [zsmul_eq_mul, zsmul_eq_mul, zsmul_eq_mul]
    norm_num
    ring

/-- A concrete finite prime-indexed formula for every value of a 2-cochain. -/
structure PrimeIndexedLogCochainFormula {G : Type*} (omega : G -> G -> ℝ) where
  coeff : G -> G -> Nat.Primes →₀ ℤ
  eval_eq : forall g h, omega g h = (coeff g h).sum (fun p n => n • Real.log (p : ℕ))

namespace PrimeIndexedLogCochainFormula

/-- Prime-indexed formulas imply prime-log integrality. -/
theorem isPrimeLogIntegral {G : Type*} {omega : G -> G -> ℝ}
    (formula : PrimeIndexedLogCochainFormula omega) : IsPrimeLogIntegral omega := by
  intro g h
  exact PrimeIndexedLogExpansion.mem_primeLogLattice ⟨formula.coeff g h, formula.eval_eq g h⟩

/-- If a formula value vanishes, all its prime-log coefficients vanish. -/
theorem coeff_eq_zero_of_eval_eq_zero {G : Type*} {omega : G -> G -> ℝ}
    (formula : PrimeIndexedLogCochainFormula omega) {g h : G} (hzero : omega g h = 0) :
    formula.coeff g h = 0 := by
  apply primeIndexedLogExpansion_coeff_eq_zero_of_sum_eq_zero
  rw [← formula.eval_eq g h, hzero]

/-- Nonzero prime-log coefficients force a nonzero value. -/
theorem eval_ne_zero_of_coeff_ne_zero {G : Type*} {omega : G -> G -> ℝ}
    (formula : PrimeIndexedLogCochainFormula omega) {g h : G}
    (hcoeff : formula.coeff g h ≠ 0) : omega g h ≠ 0 := by
  intro hzero
  exact hcoeff (formula.coeff_eq_zero_of_eval_eq_zero hzero)

/-- Equal cochain values have equal prime-indexed coefficient packets. -/
theorem coeff_eq_of_eval_eq {G : Type*} {omega eta : G -> G -> ℝ}
    (formula : PrimeIndexedLogCochainFormula omega)
    (formula' : PrimeIndexedLogCochainFormula eta) {g h : G}
    (heq : omega g h = eta g h) : formula.coeff g h = formula'.coeff g h := by
  apply primeIndexedLogExpansion_coeff_eq_of_sum_eq
  rw [← formula.eval_eq g h, ← formula'.eval_eq g h]
  exact heq

/-- Two prime-indexed formulas for the same cochain have equal coefficient packets. -/
theorem coeff_eq {G : Type*} {omega : G -> G -> ℝ}
    (formula formula' : PrimeIndexedLogCochainFormula omega) (g h : G) :
    formula.coeff g h = formula'.coeff g h :=
  formula.coeff_eq_of_eval_eq formula' rfl

end PrimeIndexedLogCochainFormula

/-- A value outside the prime-log lattice rules out any prime-indexed log formula. -/
theorem no_primeIndexedLogCochainFormula_of_value_not_mem {G : Type*}
    {omega : G -> G -> ℝ} {g h : G} (hnot : omega g h ∉ primeLogLattice) :
    IsEmpty (PrimeIndexedLogCochainFormula omega) := by
  refine ⟨?_⟩
  intro formula
  exact (not_isPrimeLogIntegral_of_value_not_mem hnot) formula.isPrimeLogIntegral

namespace SectionDefect

/-- A single defect value outside the prime-log lattice kills the finite prime-log gate. -/
theorem no_primeLogFormula_of_value_not_mem (D : SectionDefect Greal ℝ) {g h : Greal}
    (hnot : D.defect g h ∉ primeLogLattice) :
    IsEmpty (PrimeLogCochainFormula D.defect) :=
  no_primeLogCochainFormula_of_value_not_mem hnot

/-- A single defect value outside the prime-log lattice kills the prime-indexed log gate. -/
theorem no_primeIndexedFormula_of_value_not_mem (D : SectionDefect Greal ℝ) {g h : Greal}
    (hnot : D.defect g h ∉ primeLogLattice) :
    IsEmpty (PrimeIndexedLogCochainFormula D.defect) :=
  no_primeIndexedLogCochainFormula_of_value_not_mem hnot

/-- A section defect with a finite prime-log formula is prime-log integral. -/
theorem isPrimeLogIntegral_of_formula (D : SectionDefect Greal ℝ)
    (formula : PrimeLogCochainFormula D.defect) : IsPrimeLogIntegral D.defect :=
  formula.isPrimeLogIntegral

private theorem isLatticeClass_of_isPrimeLogIntegral (D : SectionDefect Greal ℝ)
    (hD : IsPrimeLogIntegral D.defect) :
    IsLatticeClass primeLogLattice D.obstruction := by
  have hval : IsLatticeValued primeLogLattice (D.cocycle : Greal -> Greal -> ℝ) := by
    rw [show (D.cocycle : Greal -> Greal -> ℝ) = D.defect by
      funext g h
      rfl]
    exact hD
  simpa [obstruction, obstructionClass] using isLatticeClass_mk (omega := D.cocycle) hval

/-- A section defect with a finite prime-log formula has a prime-log lattice-valued class. -/
theorem isLatticeClass_of_primeLogFormula (D : SectionDefect Greal ℝ)
    (formula : PrimeLogCochainFormula D.defect) :
    IsLatticeClass primeLogLattice D.obstruction :=
  isLatticeClass_of_isPrimeLogIntegral D formula.isPrimeLogIntegral

/-- Prime-log integrality of a section defect is invariant under prime-log-valued resection. -/
theorem resection_isPrimeLogIntegral_iff (D : SectionDefect Greal ℝ)
    (hstable : IsActionStable Greal primeLogLattice) {b : Greal -> ℝ}
    (hb : forall g, b g ∈ primeLogLattice) :
    IsPrimeLogIntegral (D.resection b).defect <-> IsPrimeLogIntegral D.defect := by
  simpa [resection, IsPrimeLogIntegral] using
    (gaugeUpdate_isPrimeLogIntegral_iff hstable D.defect hb)

/--
Resectioning a prime-log section defect by prime-log values preserves the lattice-class
gate.
-/
theorem resection_isLatticeClass_of_primeLogFormula (D : SectionDefect Greal ℝ)
    (hstable : IsActionStable Greal primeLogLattice) {b : Greal -> ℝ}
    (hb : forall g, b g ∈ primeLogLattice)
    (formula : PrimeLogCochainFormula D.defect) :
    IsLatticeClass primeLogLattice (D.resection b).obstruction := by
  have hD : IsPrimeLogIntegral D.defect := formula.isPrimeLogIntegral
  have hR : IsPrimeLogIntegral (D.resection b).defect :=
    (D.resection_isPrimeLogIntegral_iff hstable hb).mpr hD
  have hval : IsLatticeValued primeLogLattice ((D.resection b).cocycle : Greal -> Greal -> ℝ) := by
    rw [show ((D.resection b).cocycle : Greal -> Greal -> ℝ) =
        (D.resection b).defect by
      funext g h
      rfl]
    exact hR
  simpa [obstruction, obstructionClass] using
    isLatticeClass_mk (omega := (D.resection b).cocycle) hval

/-- A section defect with a prime-indexed formula is prime-log integral. -/
theorem isPrimeLogIntegral_of_primeIndexedFormula (D : SectionDefect Greal ℝ)
    (formula : PrimeIndexedLogCochainFormula D.defect) : IsPrimeLogIntegral D.defect :=
  formula.isPrimeLogIntegral

/-- A section defect with a prime-indexed formula has a prime-log lattice-valued class. -/
theorem isLatticeClass_of_primeIndexedFormula (D : SectionDefect Greal ℝ)
    (formula : PrimeIndexedLogCochainFormula D.defect) :
    IsLatticeClass primeLogLattice D.obstruction :=
  isLatticeClass_of_isPrimeLogIntegral D formula.isPrimeLogIntegral

/-- Zero defect values have zero prime-indexed coefficients. -/
theorem primeIndexedCoeff_eq_zero_of_defect_eq_zero (D : SectionDefect Greal ℝ)
    (formula : PrimeIndexedLogCochainFormula D.defect) {g h : Greal}
    (hzero : D.defect g h = 0) : formula.coeff g h = 0 :=
  formula.coeff_eq_zero_of_eval_eq_zero hzero

/-- Nonzero prime-indexed coefficients force nonzero defect values. -/
theorem defect_ne_zero_of_primeIndexedCoeff_ne_zero (D : SectionDefect Greal ℝ)
    (formula : PrimeIndexedLogCochainFormula D.defect) {g h : Greal}
    (hcoeff : formula.coeff g h ≠ 0) : D.defect g h ≠ 0 :=
  formula.eval_ne_zero_of_coeff_ne_zero hcoeff

/-- Prime-indexed formulas for the same section defect have equal coefficient packets. -/
theorem primeIndexedCoeff_eq (D : SectionDefect Greal ℝ)
    (formula formula' : PrimeIndexedLogCochainFormula D.defect) (g h : Greal) :
    formula.coeff g h = formula'.coeff g h :=
  formula.coeff_eq formula' g h

end SectionDefect

variable {Vreal : Type*} [AddCommGroup Vreal] [Module ℝ Vreal]

/--
Current carrier-free certificate for the T2 route: a section-defect formula that is
prime-log integral, nonzero modulo coboundaries, and polarized by an externally supplied
class-to-`J` relation.
-/
structure PrimeLogNontrivialPolarizedSectionDefect
    (D : SectionDefect Greal ℝ) (InducesJ : ClassInducesJ Greal ℝ Vreal)
    (Q : LinearMap.BilinForm ℝ Vreal) where
  formula : PrimeLogCochainFormula D.defect
  obstruction_ne_zero : D.obstruction ≠ 0
  realization : PolarizedObstructionRealization InducesJ D.obstruction Q

namespace PrimeLogNontrivialPolarizedSectionDefect

/-- Forget down to the nontrivial polarized obstruction realization. -/
def toNontrivialPolarizedObstructionRealization {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) :
    NontrivialPolarizedObstructionRealization InducesJ D.obstruction Q where
  class_ne_zero := C.obstruction_ne_zero
  realization := C.realization

/-- The certificate passes the prime-log lattice-class gate. -/
theorem isLatticeClass {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) :
    IsLatticeClass primeLogLattice D.obstruction :=
  D.isLatticeClass_of_primeLogFormula C.formula

/-- The certificate cannot come from one global choice. -/
theorem not_exists_global_choice {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) :
    ¬ exists b : Greal -> ℝ, D.defect = twoCoboundary b :=
  (D.obstruction_ne_zero_iff_not_exists_global_choice).mp C.obstruction_ne_zero

/-- The certificate inherits the D4 forced-pair constraint. -/
theorem forced_pair_linearIndependent {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) {x : Vreal} (hx : x ≠ 0) :
    LinearIndependent ℝ ![x, C.realization.J x] := by
  exact C.toNontrivialPolarizedObstructionRealization.forced_pair_linearIndependent hx

/-- The certificate inherits the D4 mixed-form area block. -/
theorem Q_compl2_J_apply_span_pair_of_isSymm {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q)
    (hQ : Q.IsSymm) (x : Vreal) (a b c d : ℝ) :
    (Q.compl₂ C.realization.J) (a • x + b • C.realization.J x)
        (c • x + d • C.realization.J x) = (b * c - a * d) * Q x x := by
  exact C.toNontrivialPolarizedObstructionRealization.Q_compl2_J_apply_span_pair_of_isSymm
    hQ x a b c d

/--
Transport a complete certificate across a resection, provided the resectioned defect has its
own finite prime-log formula.
-/
def resectionTransport {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) (b : Greal -> ℝ)
    (formula' : PrimeLogCochainFormula (D.resection b).defect) :
    PrimeLogNontrivialPolarizedSectionDefect (D.resection b) InducesJ Q where
  formula := formula'
  obstruction_ne_zero := by
    simpa [D.resection_obstruction_eq b] using C.obstruction_ne_zero
  realization := by
    rw [D.resection_obstruction_eq b]
    exact C.realization

/-- Resection transport preserves the no-global-choice gate. -/
theorem resectionTransport_not_exists_global_choice {D : SectionDefect Greal ℝ}
    {InducesJ : ClassInducesJ Greal ℝ Vreal} {Q : LinearMap.BilinForm ℝ Vreal}
    (C : PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) (b : Greal -> ℝ)
    (formula' : PrimeLogCochainFormula (D.resection b).defect) :
    ¬ exists c : Greal -> ℝ, (D.resection b).defect = twoCoboundary c := by
  exact (C.resectionTransport b formula').not_exists_global_choice

end PrimeLogNontrivialPolarizedSectionDefect

/-- A global-choice section defect cannot satisfy the current T2 certificate. -/
theorem no_primeLogNontrivialPolarizedSectionDefect_of_global_choice
    {D : SectionDefect Greal ℝ} {InducesJ : ClassInducesJ Greal ℝ Vreal}
    {Q : LinearMap.BilinForm ℝ Vreal}
    (hglobal : exists b : Greal -> ℝ, D.defect = twoCoboundary b) :
    IsEmpty (PrimeLogNontrivialPolarizedSectionDefect D InducesJ Q) := by
  refine ⟨?_⟩
  intro C
  exact C.not_exists_global_choice hglobal

end RHTower
end GaloisForLFunctions
