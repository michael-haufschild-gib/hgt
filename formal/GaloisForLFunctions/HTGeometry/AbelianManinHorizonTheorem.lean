import GaloisForLFunctions.HTGeometry.DifferentialHorizonInterface
import GaloisForLFunctions.HTGeometry.FiniteDeckFixedField
import GaloisForLFunctions.HTGeometry.AbelianManinHorizonNoHair

/-!
# The multiplication tail is the Manin quotient

The stable tail of an injective differential endomorphism whose finite-depth images are the fixed
fields of an increasing tower of deck groups equals the field fixed by the Kolchin closure of all
those deck points.  When the deck points are the primary torsion of one multiplication, that
closure is the Manin kernel: the torsion is already Zariski dense, and the Manin kernel is the
smallest Zariski-dense Kolchin-closed differential algebraic subgroup.  Its invariant field is
generated by the Manin coordinates.

Every step of that chain is proved here.  The inputs are exactly the classical geometric facts the
paper proof names: finite-depth Galois descriptions of each multiplication level, Kolchin
closedness of point stabilisers, the three defining properties of the Manin kernel, Zariski
density of the primary torsion, invariance of the Manin coordinates, and the differential rational
quotient theorem.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {K L ι κ : Type*} [Field K] [Field L] [Algebra K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]

/-- **The Manin-horizon theorem.**  With finite-depth deck descriptions of the tower, the stable
core is the field fixed by the Manin kernel, and that field is generated by the Manin
coordinates. -/
theorem stableRangeCore_eq_maninDeckFixedField_eq_maninCoordinates
    (φ : L →ₐ[K] L) (deck : ℕ → Subgroup (L ≃ₐ[K] L))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ = IntermediateField.fixedField (deck n))
    (translation : (κ → K) → DifferentialAlgEquiv K L)
    (torsionPoints : ℕ → Set (κ → K)) (maninPoints : Set (κ → K))
    (maninDeck : Subgroup (L ≃ₐ[K] L))
    (htorsionImage : (fun a => (translation a).toAlgEquiv) '' (⋃ n, torsionPoints n)
      = ((⨆ n, deck n : Subgroup (L ≃ₐ[K] L)) : Set (L ≃ₐ[K] L)))
    (hmaninImage : (fun a => (translation a).toAlgEquiv) '' maninPoints
      = (maninDeck : Set (L ≃ₐ[K] L)))
    (hstab : ∀ z : L, IsKolchinClosedOver K {a : κ → K | (translation a).toAlgEquiv z = z})
    (hmaninClosed : IsKolchinClosedOver K maninPoints)
    (htorsionSubset : ∀ n, torsionPoints n ⊆ maninPoints)
    (hmaninMinimal : ∀ H : Set (κ → K), IsKolchinClosedOver K H → ZariskiDenseOver K H →
      maninPoints ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, torsionPoints n))
    (mu : ι → L)
    (hinv : ∀ a ∈ maninPoints, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ maninPoints, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu)) :
    stableRangeCore φ = IntermediateField.fixedField maninDeck ∧
      stableRangeCore φ = differentialAdjoin K (Set.range mu) := by
  have hkolchin : kolchinClosureOver K (⋃ n, torsionPoints n) = maninPoints :=
    kolchinClosureOver_iUnion_eq_of_zariskiDense_of_minimal torsionPoints maninPoints
      hmaninClosed htorsionSubset hmaninMinimal hdense
  have hmaninFixed :
      differentialTranslationFixedField translation maninPoints
        = IntermediateField.fixedField maninDeck :=
    differentialTranslationFixedField_eq_fixedField_of_image_eq translation maninPoints
      maninDeck hmaninImage
  have hquotient :
      IntermediateField.fixedField maninDeck = differentialAdjoin K (Set.range mu) := by
    rw [← hmaninFixed]
    exact differentialTranslationFixedField_eq_maninCoordinateField translation maninPoints mu
      hinv hquot
  exact stableRangeCore_eq_kolchinClosedDeck_eq_differentialQuotient φ deck hdeck translation
    (⋃ n, torsionPoints n) maninPoints maninDeck htorsionImage hmaninImage hkolchin hstab mu
    hquotient

/-- The same theorem with the finite-depth Galois descriptions replaced by the finiteness and
degree data of the multiplication covers, which is the form the geometry of an isogeny
supplies. -/
theorem stableRangeCore_eq_maninCoordinates_of_finiteDeckDegree
    (φ : L →ₐ[K] L) (deck : ℕ → Subgroup (L ≃ₐ[K] L))
    (hfinite : ∀ n, Finite (deck n))
    (hfiniteDimensional : ∀ n, FiniteDimensional (IntermediateField.map (φ ^ n) ⊤) L)
    (hfixed : ∀ n (σ : L ≃ₐ[K] L), σ ∈ deck n → ∀ x : L, σ ((φ ^ n) x) = (φ ^ n) x)
    (hdegree : ∀ n, Module.finrank (IntermediateField.map (φ ^ n) ⊤) L = Nat.card (deck n))
    (translation : (κ → K) → DifferentialAlgEquiv K L)
    (torsionPoints : ℕ → Set (κ → K)) (maninPoints : Set (κ → K))
    (maninDeck : Subgroup (L ≃ₐ[K] L))
    (htorsionImage : (fun a => (translation a).toAlgEquiv) '' (⋃ n, torsionPoints n)
      = ((⨆ n, deck n : Subgroup (L ≃ₐ[K] L)) : Set (L ≃ₐ[K] L)))
    (hmaninImage : (fun a => (translation a).toAlgEquiv) '' maninPoints
      = (maninDeck : Set (L ≃ₐ[K] L)))
    (hstab : ∀ z : L, IsKolchinClosedOver K {a : κ → K | (translation a).toAlgEquiv z = z})
    (hmaninClosed : IsKolchinClosedOver K maninPoints)
    (htorsionSubset : ∀ n, torsionPoints n ⊆ maninPoints)
    (hmaninMinimal : ∀ H : Set (κ → K), IsKolchinClosedOver K H → ZariskiDenseOver K H →
      maninPoints ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, torsionPoints n))
    (mu : ι → L)
    (hinv : ∀ a ∈ maninPoints, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ maninPoints, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu)) :
    stableRangeCore φ = IntermediateField.fixedField maninDeck ∧
      stableRangeCore φ = differentialAdjoin K (Set.range mu) :=
  stableRangeCore_eq_maninDeckFixedField_eq_maninCoordinates φ deck
    (iterateImage_eq_fixedField_of_finiteDeckDegree φ deck hfinite hfiniteDimensional hfixed
      hdegree)
    translation torsionPoints maninPoints maninDeck htorsionImage hmaninImage hstab hmaninClosed
    htorsionSubset hmaninMinimal hdense mu hinv hquot

/-- **Theorems A and B together.**  Under the same hypotheses, if the Manin coordinates are
differentially independent the stable tail is a free differential field on them, and
multiplication by `m` acts on it as the scalar `m`. -/
theorem stableRangeCore_free_of_maninCoordinates
    (φ : L →ₐ[K] L) (deck : ℕ → Subgroup (L ≃ₐ[K] L))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ = IntermediateField.fixedField (deck n))
    (translation : (κ → K) → DifferentialAlgEquiv K L)
    (torsionPoints : ℕ → Set (κ → K)) (maninPoints : Set (κ → K))
    (maninDeck : Subgroup (L ≃ₐ[K] L))
    (htorsionImage : (fun a => (translation a).toAlgEquiv) '' (⋃ n, torsionPoints n)
      = ((⨆ n, deck n : Subgroup (L ≃ₐ[K] L)) : Set (L ≃ₐ[K] L)))
    (hmaninImage : (fun a => (translation a).toAlgEquiv) '' maninPoints
      = (maninDeck : Set (L ≃ₐ[K] L)))
    (hstab : ∀ z : L, IsKolchinClosedOver K {a : κ → K | (translation a).toAlgEquiv z = z})
    (hmaninClosed : IsKolchinClosedOver K maninPoints)
    (htorsionSubset : ∀ n, torsionPoints n ⊆ maninPoints)
    (hmaninMinimal : ∀ H : Set (κ → K), IsKolchinClosedOver K H → ZariskiDenseOver K H →
      maninPoints ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, torsionPoints n))
    (mu : ι → L)
    (hinv : ∀ a ∈ maninPoints, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : ∀ z : L, (∀ a ∈ maninPoints, (translation a).toAlgEquiv z = z) →
      z ∈ differentialAdjoin K (Set.range mu))
    (hfree : DifferentialIndependent K mu) (m : ℤ) (hm : (m : K) ≠ 0) :
    stableRangeCore φ = differentialAdjoin K (Set.range mu) ∧
      ∀ j, ((multiplicationTailScaling mu hfree m hm
          ⟨mu j, subset_differentialAdjoin K (Set.range mu) (Set.mem_range_self j)⟩ :
        differentialAdjoin K (Set.range mu)) : L) = m • mu j := by
  refine ⟨(stableRangeCore_eq_maninDeckFixedField_eq_maninCoordinates φ deck hdeck translation
    torsionPoints maninPoints maninDeck htorsionImage hmaninImage hstab hmaninClosed
    htorsionSubset hmaninMinimal hdense mu hinv hquot).2, ?_⟩
  intro j
  exact multiplicationTailScaling_source mu hfree m hm j

end

end GaloisForLFunctions.HTGeometry
