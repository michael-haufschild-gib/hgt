        (435136805707337652641731670 : ℝ)*u^(1 : ℕ)*(1-u)^(7 : ℕ) +
        (2932010683269712443127398830 : ℝ)*u^(2 : ℕ)*(1-u)^(6 : ℕ) +
        (9876447261641187423283366326 : ℝ)*u^(3 : ℕ)*(1-u)^(5 : ℕ) +
        (19310609827067281709711329224 : ℝ)*u^(4 : ℕ)*(1-u)^(4 : ℕ) +
        (23031988448599700501114618322 : ℝ)*u^(5 : ℕ)*(1-u)^(3 : ℕ) +
        (16592284217498835223888530082 : ℝ)*u^(6 : ℕ)*(1-u)^(2 : ℕ) +
        (6656555188234490659760931874 : ℝ)*u^(7 : ℕ)*(1-u)^(1 : ℕ) +
        (1145090031064202648429018791 : ℝ)*u^(8 : ℕ)*(1-u)^(0 : ℕ))*v^(4 : ℕ)*(1-v)^(0 : ℕ)) := by
    unfold twoAtomOddHeadNumerator
    dsimp [u,v]
    ring
  rw [heq]
  positivity

/-- The complete retained determinant has an eighty-five-billion normalized reserve. -/
theorem twoAtomOddDet_high_lower {q z : ℝ} (hq0 : 5 ≤ q) (hq1 : q ≤ 7)
    (hz0 : 0 ≤ z) (hz1 : z ≤ 1/3000000) :
    85000000000 ≤ twoAtomOddDet q z := by
  have hqp : 0 < q := by linarith
  have hdp : 0 < 2*q-3 := by linarith
  rw [twoAtomOddDet_eq_quotient hqp.ne' hdp.ne']
  apply (le_div_iff₀ (by positivity : 0 < q^(3 : ℕ)*(2*q-3)^(6 : ℕ))).mpr
  linarith only [twoAtomOdd_det_high_reserve hq0 hq1 hz0 hz1]

/-- The exact retained leading minor is at most thirty-three thousand. -/
theorem twoAtomOddHead_high_upper {q z : ℝ} (hq0 : 5 ≤ q) (hq1 : q ≤ 7)
    (hz0 : 0 ≤ z) (hz1 : z ≤ 1/3000000) :
    twoAtomOddHead q z ≤ 33000 := by
  have hqp : 0 < q := by linarith
  have hdp : 0 < 2*q-3 := by linarith
  rw [twoAtomOddHead_eq_quotient hqp.ne' hdp.ne']
  apply (div_le_iff₀ (by positivity : 0 < q*(2*q-3)^(4 : ℕ))).mpr
  linarith only [twoAtomOdd_head_high_reserve hq0 hq1 hz0 hz1]

end
