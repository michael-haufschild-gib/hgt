import GaloisForLFunctions.HTGeometry.DifferentialLurothSingleGenerator
import GaloisForLFunctions.HTGeometry.FreeDifferentialProtocolTimeLaw
import GaloisForLFunctions.HTGeometry.StableDifferentialCore

/-!
# Projective law for the scalar differential inversive core

The stable core of a derivation-preserving endomorphism of a singly free differential field has
an exact dichotomy.  It is either the base field, or unrestricted differential Lüroth supplies a
hypertranscendental generator.  The endomorphism maps the stable core onto itself, so the generator
and its image generate the same differential field; mutual-generator rigidity then makes the
action fractional-linear, with its coefficient matrix unique up to a nonzero scalar.

The final theorem specializes the result to the canonical free differential rational field and
discharges every source-side premise by construction.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

open GaloisForLFunctions JetField

noncomputable section

variable {C F : Type*} [Field C] [Field F] [Differential C] [Differential F]
  [Algebra C F] [DifferentialAlgebra C F] [CharZero C] [CharZero F]

/-- A nonconstant stable core together with its hypertranscendental generator and the unique
projective coefficient class of the induced automorphism. -/
def HasProjectiveStableCore (φ : F →ₐ[C] F) : Prop :=
  ∃ u : F,
    HypertranscendentalOver C u ∧
    differentialAdjoin C ({u} : Set F) = stableRangeCore φ ∧
    ∃ a b c d : C,
      a * d - b * c ≠ 0 ∧
      φ u * (algebraMap C F c * u + algebraMap C F d) =
        algebraMap C F a * u + algebraMap C F b ∧
      ∀ a' b' c' d' : C,
        a' * d' - b' * c' ≠ 0 →
        φ u * (algebraMap C F c' * u + algebraMap C F d') =
          algebraMap C F a' * u + algebraMap C F b' →
        ∃ t : C, t ≠ 0 ∧ a' = t * a ∧ b' = t * b ∧ c' = t * c ∧ d' = t * d

omit [Differential C] [Differential F] [DifferentialAlgebra C F] [CharZero C] [CharZero F] in
/-- A self-endomorphism maps its stable range core onto itself. -/
theorem map_stableRangeCore_self (φ : F →ₐ[C] F) :
    IntermediateField.map φ (stableRangeCore φ) = stableRangeCore φ := by
  apply le_antisymm
  · rintro x hx
    rw [IntermediateField.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact stableRangeCore_map_mem φ hy
  · intro x hx
    rw [IntermediateField.mem_map]
    obtain ⟨y, hy, hφy⟩ := stableRangeCore_exists_preimage φ hx
    exact ⟨y, hy, hφy⟩

/-- **Scalar differential inversive-core projective law.**  The stable core of a singly free
differential field over constants is exactly the base or is generated by a hypertranscendental
element on which the endomorphism acts through one unique projective coefficient class. -/
theorem scalarDifferentialInversiveCore_projectiveLaw
    (hC : ∀ a : C, (algebraMap C F a)′ = 0)
    {y : F} (hy : DifferentialIndependent C (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin C ({y} : Set F) = ⊤)
    (φ : F →ₐ[C] F) (hφ : ∀ x : F, φ x′ = (φ x)′) :
    Xor (stableRangeCore φ = ⊥) (HasProjectiveStableCore φ) := by
  classical
  by_cases hcore : stableRangeCore φ = ⊥
  · exact Or.inl ⟨hcore, by
      rintro ⟨u, huht, hugen, -⟩
      have htu : Transcendental C u := by
        simpa using hypertranscendentalOver_jet_transcendental huht 0
      have humem : u ∈ stableRangeCore φ := by
        rw [← hugen]
        exact subset_differentialAdjoin C ({u} : Set F) rfl
      have hubot : u ∈ (⊥ : IntermediateField C F) := hcore ▸ humem
      rw [IntermediateField.mem_bot] at hubot
      obtain ⟨t, ht⟩ := hubot
      apply htu
      rw [← ht]
      exact isAlgebraic_algebraMap t⟩
  · right
    refine ⟨?_, hcore⟩
    obtain ⟨u, hu⟩ := differentialLuroth (stableRangeCore φ)
      (derivationClosed_stableRangeCore φ hφ)
      (by simpa only [hytop] using
        (le_top : stableRangeCore φ ≤ (⊤ : IntermediateField C F)))
      hy hcore
    have huht : HypertranscendentalOver C u :=
      hypertranscendentalOver_of_generates_ne_bot hC hy hytop hcore hu
    have hmap := map_differentialAdjoin φ hφ ({u} : Set F)
    have hφu : differentialAdjoin C ({φ u} : Set F) = stableRangeCore φ := by
      rw [hu, map_stableRangeCore_self] at hmap
      simpa using hmap.symm
    have hφuht : HypertranscendentalOver C (φ u) :=
      (hypertranscendentalOver_algHom_iff φ hφ u).mpr huht
    obtain ⟨a, b, c, d, hdet, hmob⟩ := mutual_generator_mobius huht hφuht
      (by rw [hu, ← hφu]; exact subset_differentialAdjoin C _ rfl)
      (by rw [hφu, ← hu]; exact subset_differentialAdjoin C _ rfl)
    have htu : Transcendental C u := by
      simpa using hypertranscendentalOver_jet_transcendental huht 0
    refine ⟨u, huht, hu, a, b, c, d, hdet, hmob, ?_⟩
    intro a' b' c' d' hdet' hmob'
    exact mobius_coefficients_unique htu hdet hdet' hmob hmob'

end

section FreeField

variable {C : Type*} [Field C] [CharZero C]

/-- **Closed canonical form.**  Every derivation-preserving endomorphism of the canonical scalar
free differential rational field satisfies the constants-versus-projective stable-core
dichotomy.  Differential freeness, generation, and the constant-base law are all internal facts
of `JetField`; they are not theorem premises. -/
theorem freeScalarDifferentialInversiveCore_projectiveLaw
    (φ : JetField C Unit →ₐ[C] JetField C Unit)
    (hφ : ∀ x : JetField C Unit, φ x′ = (φ x)′) :
    Xor (stableRangeCore φ = ⊥) (HasProjectiveStableCore φ) := by
  letI : Differential C := ⟨0⟩
  haveI : DifferentialAlgebra C (JetField C Unit) :=
    ⟨fun a => by rw [deriv_algebraMap_jetField a]; exact (map_zero _).symm⟩
  exact scalarDifferentialInversiveCore_projectiveLaw deriv_algebraMap_jetField
    differentialIndependent_jet_zero differentialAdjoin_jet_zero_eq_top φ hφ

end FreeField

end GaloisForLFunctions.HTGeometry
