import GaloisForLFunctions.HTGeometry.UniversalPrimeOrientationLimit
import Mathlib.Topology.ContinuousMap.Algebra

/-!
# Compact-open invariance of the complete prime orientation fiber

Any two infinite prime sign carriers differ by a normally convergent series of rational Cauchy
atoms.  Finite subsets of this series give rational transitions from either carrier to the other.
Consequently the compact-open completion of the function ring generated by the carrier, complex
constants, and the common prime-pole atoms is independent of the sign sequence.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Topology Filter
open scoped BigOperators

noncomputable section

/-- The rational Cauchy atom changing one orientation carrier toward another. -/
def universalPrimeOrientationTransitionTerm
    (ε δ : Nat.Primes → Bool) (p : Nat.Primes) (z : ℂ) : ℂ :=
  ((universalPrimeOrientationWeight δ p - universalPrimeOrientationWeight ε p : ℝ) : ℂ) *
    ((primeLogSupport p : ℂ) - z)⁻¹

/-- The complete rational transition series converges locally uniformly to the exact difference
of the two orientation carriers. -/
theorem hasSumLocallyUniformlyOn_universalPrimeOrientationTransition
    (ε δ : Nat.Primes → Bool) :
    HasSumLocallyUniformlyOn
      (fun p : Nat.Primes => universalPrimeOrientationTransitionTerm ε δ p)
      (fun z => universalPrimeOrientationLimit δ z - universalPrimeOrientationLimit ε z)
      upperHalfPlane := by
  have hδ :=
    (summableLocallyUniformlyOn_discreteHerglotz primeLogSupport
      (universalPrimeOrientationWeight δ)
      (summable_norm_universalPrimeOrientationWeight δ)).hasSumLocallyUniformlyOn
  have hε :=
    (summableLocallyUniformlyOn_discreteHerglotz primeLogSupport
      (universalPrimeOrientationWeight ε)
      (summable_norm_universalPrimeOrientationWeight ε)).hasSumLocallyUniformlyOn
  have h := hδ.sub hε
  simpa only [HasSumLocallyUniformlyOn, universalPrimeOrientationTransitionTerm,
    universalPrimeOrientationLimit, discreteHerglotz, Finset.sum_sub_distrib,
    Pi.sub_apply, Complex.ofReal_sub, sub_mul] using! h

/-- A finite rational transition from the `ε` carrier toward the `δ` carrier. -/
def universalPrimeOrientationFiniteTransition
    (ε δ : Nat.Primes → Bool) (F : Finset Nat.Primes) (z : ℂ) : ℂ :=
  universalPrimeOrientationLimit ε z +
    ∑ p ∈ F, universalPrimeOrientationTransitionTerm ε δ p z

/-- The finite rational transitions converge locally uniformly to the target carrier. -/
theorem tendstoLocallyUniformlyOn_universalPrimeOrientationFiniteTransition
    (ε δ : Nat.Primes → Bool) :
    TendstoLocallyUniformlyOn
      (fun F => universalPrimeOrientationFiniteTransition ε δ F)
      (universalPrimeOrientationLimit δ) atTop upperHalfPlane := by
  have hcorr := hasSumLocallyUniformlyOn_universalPrimeOrientationTransition ε δ
  have hconst : TendstoLocallyUniformlyOn
      (fun _ : Finset Nat.Primes => universalPrimeOrientationLimit ε)
      (universalPrimeOrientationLimit ε) atTop upperHalfPlane := by
    apply TendstoUniformlyOn.tendstoLocallyUniformlyOn
    intro u hu
    exact Filter.Eventually.of_forall fun _ _ _ => refl_mem_uniformity hu
  have hadd := hconst.add hcorr
  have hshape : TendstoLocallyUniformlyOn
      (fun F => universalPrimeOrientationFiniteTransition ε δ F)
      (universalPrimeOrientationLimit ε + fun z =>
        universalPrimeOrientationLimit δ z - universalPrimeOrientationLimit ε z)
      atTop upperHalfPlane := by
    apply hadd.congr
    intro F z _
    rfl
  exact hshape.congr_right fun z _ => by simp

/-- The upper half-plane as the domain of the compact-open function rings. -/
abbrev PrimeOrientationDomain := {z : ℂ // z ∈ upperHalfPlane}

noncomputable instance : LocallyCompactSpace PrimeOrientationDomain :=
  isOpen_upperHalfPlane.locallyCompactSpace

/-- The prime-pole atom, restricted to the upper half-plane where it is continuous. -/
def primeOrientationCauchyAtom (p : Nat.Primes) : C(PrimeOrientationDomain, ℂ) where
  toFun z := ((primeLogSupport p : ℂ) - (z : ℂ))⁻¹
  continuous_toFun := continuousOn_iff_continuous_restrict.mp <|
    ((continuousOn_const.sub continuousOn_id).inv₀ fun z hz hzero => by
      have him : (((primeLogSupport p : ℂ) - z)).im = -z.im := by simp
      have hzIm : 0 < z.im := hz
      have hzero' : (primeLogSupport p : ℂ) - z = 0 := by simpa using hzero
      rw [hzero'] at him
      simp at him
      linarith)

/-- A carrier as a point of the compact-open function space on the upper half-plane. -/
def universalPrimeOrientationContinuous
    (ε : Nat.Primes → Bool) : C(PrimeOrientationDomain, ℂ) where
  toFun z := universalPrimeOrientationLimit ε z
  continuous_toFun := continuousOn_iff_continuous_restrict.mp
    (differentiableOn_universalPrimeOrientationLimit_upperHalfPlane ε).continuousOn

/-- The finite rational transition as a point of the compact-open function space. -/
def universalPrimeOrientationFiniteTransitionContinuous
    (ε δ : Nat.Primes → Bool) (F : Finset Nat.Primes) : C(PrimeOrientationDomain, ℂ) :=
  universalPrimeOrientationContinuous ε +
    ∑ p ∈ F, ContinuousMap.const PrimeOrientationDomain
      ((universalPrimeOrientationWeight δ p -
        universalPrimeOrientationWeight ε p : ℝ) : ℂ) *
      primeOrientationCauchyAtom p

theorem coe_universalPrimeOrientationFiniteTransitionContinuous
    (ε δ : Nat.Primes → Bool) (F : Finset Nat.Primes) (z : PrimeOrientationDomain) :
    universalPrimeOrientationFiniteTransitionContinuous ε δ F z =
      universalPrimeOrientationFiniteTransition ε δ F z := by
  simp [universalPrimeOrientationFiniteTransitionContinuous,
    universalPrimeOrientationFiniteTransition, universalPrimeOrientationTransitionTerm,
    universalPrimeOrientationContinuous, primeOrientationCauchyAtom]

/-- Finite rational transitions converge in the compact-open topology to the target carrier. -/
theorem tendsto_universalPrimeOrientationFiniteTransitionContinuous
    (ε δ : Nat.Primes → Bool) :
    Tendsto (universalPrimeOrientationFiniteTransitionContinuous ε δ)
      atTop (nhds (universalPrimeOrientationContinuous δ)) := by
  apply ContinuousMap.tendsto_of_tendstoLocallyUniformly
  have h := tendstoLocallyUniformlyOn_universalPrimeOrientationFiniteTransition ε δ
  rw [tendstoLocallyUniformlyOn_iff_tendstoLocallyUniformly_comp_coe] at h
  simpa [Function.comp_def,
    coe_universalPrimeOrientationFiniteTransitionContinuous] using! h

/-- Common rational generators: all complex constants and all prime-pole atoms. -/
def primeOrientationCommonGenerators : Set C(PrimeOrientationDomain, ℂ) :=
  Set.range (ContinuousMap.const PrimeOrientationDomain) ∪
    Set.range primeOrientationCauchyAtom

/-- The algebraic function ring generated by one carrier and the common rational atoms. -/
def primeOrientationAlgebraicRing
    (ε : Nat.Primes → Bool) : Subring C(PrimeOrientationDomain, ℂ) :=
  Subring.closure
    (insert (universalPrimeOrientationContinuous ε) primeOrientationCommonGenerators)

/-- The compact-open completion of one carrier and the common rational atoms. -/
def primeOrientationCompletedRing
    (ε : Nat.Primes → Bool) : Subring C(PrimeOrientationDomain, ℂ) :=
  (primeOrientationAlgebraicRing ε).topologicalClosure

theorem universalPrimeOrientationFiniteTransitionContinuous_mem_algebraicRing
    (ε δ : Nat.Primes → Bool) (F : Finset Nat.Primes) :
    universalPrimeOrientationFiniteTransitionContinuous ε δ F ∈
      primeOrientationAlgebraicRing ε := by
  apply Subring.add_mem
  · exact Subring.subset_closure (Set.mem_insert _ _)
  · apply Subring.sum_mem
    intro p hp
    apply Subring.mul_mem
    · apply Subring.subset_closure
      exact Set.mem_insert_iff.mpr <| Or.inr <| Or.inl ⟨_, rfl⟩
    · apply Subring.subset_closure
      exact Set.mem_insert_iff.mpr <| Or.inr <| Or.inr ⟨p, rfl⟩

/-- Every orientation carrier belongs to the compact-open completion generated by every other
orientation carrier and the common rational atoms. -/
theorem universalPrimeOrientationContinuous_mem_completedRing
    (ε δ : Nat.Primes → Bool) :
    universalPrimeOrientationContinuous δ ∈ primeOrientationCompletedRing ε := by
  show universalPrimeOrientationContinuous δ ∈
    closure (primeOrientationAlgebraicRing ε : Set C(PrimeOrientationDomain, ℂ))
  exact mem_closure_of_tendsto
    (tendsto_universalPrimeOrientationFiniteTransitionContinuous ε δ)
    (Filter.Eventually.of_forall fun F =>
      universalPrimeOrientationFiniteTransitionContinuous_mem_algebraicRing ε δ F)

/-- **Compact-open chamber invariance.** The completed common rational function ring is independent
of the chosen point of the full Cantor orientation fiber, including infinitely reversed
sequences. -/
theorem primeOrientationCompletedRing_eq
    (ε δ : Nat.Primes → Bool) :
    primeOrientationCompletedRing ε = primeOrientationCompletedRing δ := by
  apply le_antisymm
  · intro f hf
    change f ∈ closure (primeOrientationAlgebraicRing ε : Set C(PrimeOrientationDomain, ℂ)) at hf
    apply (closure_minimal _ (Subring.isClosed_topologicalClosure
      (primeOrientationAlgebraicRing δ))) hf
    apply Subring.closure_le.mpr
    intro g hg
    rcases hg with rfl | hg
    · exact universalPrimeOrientationContinuous_mem_completedRing δ ε
    · exact Subring.le_topologicalClosure (primeOrientationAlgebraicRing δ)
        (Subring.subset_closure (Set.mem_insert_iff.mpr (Or.inr hg)))
  · intro f hf
    change f ∈ closure (primeOrientationAlgebraicRing δ : Set C(PrimeOrientationDomain, ℂ)) at hf
    apply (closure_minimal _ (Subring.isClosed_topologicalClosure
      (primeOrientationAlgebraicRing ε))) hf
    apply Subring.closure_le.mpr
    intro g hg
    rcases hg with rfl | hg
    · exact universalPrimeOrientationContinuous_mem_completedRing ε δ
    · exact Subring.le_topologicalClosure (primeOrientationAlgebraicRing ε)
        (Subring.subset_closure (Set.mem_insert_iff.mpr (Or.inr hg)))

end

end GaloisForLFunctions.HTGeometry
