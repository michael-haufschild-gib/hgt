import GaloisForLFunctions.HTGeometry.MilnorReducedFiltration

/-!
# Milnor's degree filtration is generated by its reduced classes

The division move lowers the sum of the degrees of the entries of a symbol, so an induction on that
sum shows that every symbol of polynomials of degree at most `d` is a combination of symbols with a
single entry of degree `d` — the reduced classes.

* `nzList`, `nzTotal` : a symbol given by a list of nonzero polynomials, and the sum of the degrees.
* `nzList_class_mem_reducedFiltration` : **every symbol of polynomials of degree at most `d` is
  reduced.**
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {F : Type*} [Field F] {n : ℕ}

/-- A nonzero polynomial. -/
abbrev NZPoly (F : Type*) [Field F] := {p : Polynomial F // p ≠ 0}

/-- The unit of `F(t)` attached to a nonzero polynomial. -/
noncomputable def nzUnit (p : NZPoly F) : (RatFunc F)ˣ := polyUnit p.2

/-- The entry list of a symbol given by nonzero polynomials. -/
noncomputable def nzList (ps : List (NZPoly F)) : List (RatFunc F)ˣ := ps.map nzUnit

/-- The sum of the degrees of the entries. -/
def nzTotal (ps : List (NZPoly F)) : ℕ := (ps.map (fun p => p.1.natDegree)).sum

@[simp]
theorem nzList_append (ps qs : List (NZPoly F)) :
    nzList (ps ++ qs) = nzList ps ++ nzList qs := List.map_append

@[simp]
theorem nzList_cons (p : NZPoly F) (ps : List (NZPoly F)) :
    nzList (p :: ps) = nzUnit p :: nzList ps := rfl

@[simp]
theorem nzTotal_append (ps qs : List (NZPoly F)) :
    nzTotal (ps ++ qs) = nzTotal ps + nzTotal qs := by
  simp [nzTotal, List.map_append, List.sum_append]

@[simp]
theorem nzTotal_cons (p : NZPoly F) (ps : List (NZPoly F)) :
    nzTotal (p :: ps) = p.1.natDegree + nzTotal ps := rfl

theorem nzList_length (ps : List (NZPoly F)) : (nzList ps).length = ps.length := by
  simp [nzList]

theorem polyDegLt_nzUnit {d : ℕ} {p : NZPoly F} (h : p.1.natDegree < d) :
    polyDegLt (F := F) d (nzUnit p) := ⟨p.1, p.2, h, rfl⟩

theorem polyDegLe_nzUnit {d : ℕ} {p : NZPoly F} (h : p.1.natDegree ≤ d) :
    polyDegLe (F := F) d (nzUnit p) := ⟨p.1, p.2, h, rfl⟩

theorem polyUnit_injective {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    (h : polyUnit hp = polyUnit hq) : p = q := by
  have hval : algebraMap (Polynomial F) (RatFunc F) p = algebraMap (Polynomial F) (RatFunc F) q := by
    have := congrArg (fun u : (RatFunc F)ˣ => (u : RatFunc F)) h
    exact this
  exact IsFractionRing.injective (Polynomial F) (RatFunc F) hval

theorem natDegree_lt_of_polyDegLt {d : ℕ} {p : Polynomial F} (hp : p ≠ 0)
    (h : polyDegLt (F := F) d (polyUnit hp)) : p.natDegree < d := by
  obtain ⟨q, hq, hqd, hpq⟩ := h
  rw [polyUnit_injective hp hq hpq]
  exact hqd

theorem natDegree_le_of_polyDegLe {d : ℕ} {p : Polynomial F} (hp : p ≠ 0)
    (h : polyDegLe (F := F) d (polyUnit hp)) : p.natDegree ≤ d := by
  obtain ⟨q, hq, hqd, hpq⟩ := h
  rw [polyUnit_injective hp hq hpq]
  exact hqd

/-- **Every symbol of polynomials of degree at most `d` is reduced.** -/
theorem nzList_class_mem_reducedFiltration {d : ℕ} (hd : 1 ≤ d) (hn : 1 ≤ n) :
    ∀ N : ℕ, ∀ ps : List (NZPoly F), nzTotal ps ≤ N →
      (∀ p ∈ ps, p.1.natDegree ≤ d) → ∀ h : (nzList ps).length = n,
      milnorClassDeg (RatFunc F) n ⟨nzList ps, h⟩ ∈ reducedFiltration (F := F) d n := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro ps htot hdeg h
    by_cases hall : ∀ p ∈ ps, p.1.natDegree < d
    · refine mem_reducedFiltration_of_forall_lt h hn ?_
      intro a ha
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 ha
      exact polyDegLt_nzUnit (hall p hp)
    · push Not at hall
      obtain ⟨p, hpmem, hpd⟩ := hall
      have hpeq : p.1.natDegree = d := le_antisymm (hdeg p hpmem) hpd
      obtain ⟨l₁, l₂, hps⟩ := List.append_of_mem hpmem
      subst hps
      have hcount : (l₁ ++ p :: l₂).length = n := by
        rw [← nzList_length]; exact h
      have hlenA : (nzList (p :: (l₁ ++ l₂))).length = n := by
        rw [nzList_length]
        simp only [List.length_cons, List.length_append] at hcount ⊢
        omega
      have hmv : ([] ++ nzList l₁ ++ nzUnit p :: nzList l₂).length = n := by
        rw [← h]; simp
      have hstep1 : milnorClassDeg (RatFunc F) n ⟨nzList (l₁ ++ p :: l₂), h⟩
          = milnorClassDeg (RatFunc F) n ⟨[] ++ nzList l₁ ++ nzUnit p :: nzList l₂, hmv⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp))
      have hstep2 := milnorClassDeg_move (K := RatFunc F) (n := n) (nzList l₁) []
        (nzList l₂) (nzUnit p) hmv
      have hfront : milnorClassDeg (RatFunc F) n
            ⟨[] ++ nzUnit p :: (nzList l₁ ++ nzList l₂),
              length_move [] (nzList l₁) (nzList l₂) (nzUnit p) hmv⟩
          = milnorClassDeg (RatFunc F) n ⟨nzList (p :: (l₁ ++ l₂)), hlenA⟩ :=
        congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp))
      rw [hstep1, hstep2, hfront]
      refine AddSubgroup.zsmul_mem _ ?_ _
      have hrestdeg : ∀ q ∈ l₁ ++ l₂, q.1.natDegree ≤ d := by
        intro q hq
        rcases List.mem_append.1 hq with h1 | h2
        · exact hdeg q (by simp [h1])
        · exact hdeg q (by simp [h2])
      by_cases hrestlt : ∀ q ∈ l₁ ++ l₂, q.1.natDegree < d
      · refine mem_reducedFiltration _ (polyDegLe_nzUnit (le_of_eq hpeq)) ?_
        intro a ha
        obtain ⟨q, hq, rfl⟩ := List.mem_map.1 ha
        exact polyDegLt_nzUnit (hrestlt q hq)
      · push Not at hrestlt
        obtain ⟨q, hqmem, hqd⟩ := hrestlt
        have hqeq : q.1.natDegree = d := le_antisymm (hrestdeg q hqmem) hqd
        obtain ⟨m₁, m₂, hsplit⟩ := List.append_of_mem hqmem
        have hlenB : (nzList (p :: (m₁ ++ q :: m₂))).length = n := by
          rw [nzList_length]
          rw [nzList_length] at hlenA
          rw [← hsplit]
          exact hlenA
        have hcast : milnorClassDeg (RatFunc F) n ⟨nzList (p :: (l₁ ++ l₂)), hlenA⟩
            = milnorClassDeg (RatFunc F) n ⟨nzList (p :: (m₁ ++ q :: m₂)), hlenB⟩ :=
          congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp only [hsplit]))
        rw [hcast]
        have hlen2 : ([nzUnit p] ++ nzList m₁ ++ nzUnit q :: nzList m₂).length = n := by
          rw [← hlenB]; simp
        have hcast2 : milnorClassDeg (RatFunc F) n ⟨nzList (p :: (m₁ ++ q :: m₂)), hlenB⟩
            = milnorClassDeg (RatFunc F) n
              ⟨[nzUnit p] ++ nzList m₁ ++ nzUnit q :: nzList m₂, hlen2⟩ :=
          congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp))
        rw [hcast2, milnorClassDeg_move (K := RatFunc F) (n := n) (nzList m₁) [nzUnit p]
          (nzList m₂) (nzUnit q) hlen2]
        refine AddSubgroup.zsmul_mem _ ?_ _
        have hn2 : (([] : List (RatFunc F)ˣ) ++ nzList (m₁ ++ m₂)).length + 2 = n := by
          have hx := hlen2
          simp only [List.singleton_append, List.length_cons, List.length_append,
            List.nil_append, nzList_length, nzList_append] at hx ⊢
          omega
        have hcast3 : milnorClassDeg (RatFunc F) n
              ⟨[nzUnit p] ++ nzUnit q :: (nzList m₁ ++ nzList m₂),
                length_move [nzUnit p] (nzList m₁) (nzList m₂) (nzUnit q) hlen2⟩
            = twoSlot [] (nzList (m₁ ++ m₂)) hn2 (nzUnit p) (nzUnit q) :=
          congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp))
        rw [hcast3]
        have hred := twoSlot_polyUnit_reduce (F := F) (n := n) hd []
          (nzList (m₁ ++ m₂)) hn2 p.2 q.2 hpeq hqeq
        refine (AddSubgroup.closure_le _).2 ?_ hred
        rintro x ⟨a, b, ha, hb, hab, rfl⟩
        obtain ⟨pa, hpa, hpale, rfl⟩ := ha
        obtain ⟨pb, hpb, hpble, rfl⟩ := hb
        have hpalt : pa.natDegree ≤ d := hpale
        have hpblt : pb.natDegree ≤ d := hpble
        have hstrict : pa.natDegree + pb.natDegree < d + d := by
          rcases hab with hA | hB
          · have := natDegree_lt_of_polyDegLt hpa hA
            omega
          · have := natDegree_lt_of_polyDegLt hpb hB
            omega
        have hlist : twoSlot [] (nzList (m₁ ++ m₂)) hn2 (polyUnit hpa) (polyUnit hpb)
            = milnorClassDeg (RatFunc F) n
              ⟨nzList (⟨pa, hpa⟩ :: ⟨pb, hpb⟩ :: (m₁ ++ m₂)), by
                rw [nzList_length]
                have := hn2
                simp only [List.length_append, List.length_cons, nzList_length,
                  List.nil_append] at this ⊢
                omega⟩ :=
          congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext (by simp [nzList, nzUnit]))
        rw [hlist]
        have htotnew : nzTotal (⟨pa, hpa⟩ :: ⟨pb, hpb⟩ :: (m₁ ++ m₂)) < N := by
          have htot' : nzTotal (l₁ ++ p :: l₂) ≤ N := htot
          have hrewrite : nzTotal (l₁ ++ p :: l₂)
              = p.1.natDegree + nzTotal (l₁ ++ l₂) := by
            simp only [nzTotal_append, nzTotal_cons]
            omega
          have hrewrite2 : nzTotal (l₁ ++ l₂) = nzTotal (m₁ ++ q :: m₂) := by rw [hsplit]
          have hrewrite3 : nzTotal (m₁ ++ q :: m₂)
              = q.1.natDegree + nzTotal (m₁ ++ m₂) := by
            simp only [nzTotal_append, nzTotal_cons]
            omega
          simp only [nzTotal_cons]
          rw [hrewrite, hrewrite2, hrewrite3, hpeq, hqeq] at htot'
          omega
        refine ih _ htotnew _ le_rfl ?_ _
        intro r hr
        rcases List.mem_cons.1 hr with rfl | hr1
        · exact hpalt
        · rcases List.mem_cons.1 hr1 with rfl | hr2
          · exact hpblt
          · rcases List.mem_append.1 hr2 with h1 | h2
            · exact hrestdeg r (by rw [hsplit]; simp [h1])
            · exact hrestdeg r (by rw [hsplit]; simp [h2])

/-- The entries of a symbol of polynomial units can be given by an explicit list of polynomials. -/
theorem exists_nzList {d : ℕ} :
    ∀ l : List (RatFunc F)ˣ, (∀ a ∈ l, polyDegLe (F := F) d a) →
      ∃ ps : List (NZPoly F), nzList ps = l ∧ ∀ p ∈ ps, p.1.natDegree ≤ d := by
  intro l
  induction l with
  | nil => exact fun _ => ⟨[], rfl, by simp⟩
  | cons a t ih =>
      intro hl
      obtain ⟨ps, hps, hdeg⟩ := ih (fun b hb => hl b (by simp [hb]))
      obtain ⟨p, hp, hple, hap⟩ := hl a (by simp)
      refine ⟨⟨p, hp⟩ :: ps, ?_, ?_⟩
      · rw [nzList_cons, hps]
        exact congrArg (fun u => u :: t) hap.symm
      · intro r hr
        rcases List.mem_cons.1 hr with rfl | hr'
        · exact hple
        · exact hdeg r hr'

/-- **Milnor's degree filtration consists of reduced classes.** -/
theorem degreeFiltration_le_reducedFiltration {d : ℕ} (hd : 1 ≤ d) (hn : 1 ≤ n) :
    degreeFiltration (F := F) d n ≤ reducedFiltration (F := F) d n := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro x ⟨s, hs, rfl⟩
  obtain ⟨ps, hps, hdeg⟩ := exists_nzList (d := d) s.val
    (fun a ha => by
      obtain ⟨p, hp, hle, hap⟩ := hs a ha
      exact ⟨p, hp, hle, hap⟩)
  have hlen : (nzList ps).length = n := by rw [hps]; exact s.property
  have hcast : milnorClassDeg (RatFunc F) n s
      = milnorClassDeg (RatFunc F) n ⟨nzList ps, hlen⟩ :=
    congrArg (milnorClassDeg (RatFunc F) n) (Subtype.ext hps.symm)
  rw [SetLike.mem_coe, hcast]
  exact nzList_class_mem_reducedFiltration hd hn (nzTotal ps) ps le_rfl hdeg hlen

end GaloisForLFunctions.HTGeometry
