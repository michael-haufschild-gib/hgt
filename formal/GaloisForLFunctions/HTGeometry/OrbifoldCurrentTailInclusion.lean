import GaloisForLFunctions.HTGeometry.StableDifferentialCore
import GaloisForLFunctions.HTGeometry.DifferentialIndependence
import Mathlib.FieldTheory.Differential.Basic

/-!
# Orbifold currents survive every coarse-graining scale

A rational `k`-differential which the substitution pulls back to a nonzero multiple of itself
evaluates, on a free differential jet, to an eigenvector of the substitution endomorphism.  An
eigenvector with nonzero constant eigenvalue has an explicit preimage at every depth, and the
stable core is closed under the derivation, so the *whole* differential field generated by the
current lies in every iterated image field.

This is the elementary half of the coarse-graining tail law: an invariant orbifold tensor forces a
nonconstant tail.  The power maps are the first instance — the logarithmic current is their
`k = 1` orbifold current, with multiplier the degree.

* `GaloisForLFunctions.HTGeometry.tensorCurrent_transport`;
* `GaloisForLFunctions.HTGeometry.differentialAdjoin_le_stableRangeCore_of_algebraMap_eigenvector`;
* `GaloisForLFunctions.HTGeometry.differentialAdjoin_logDeriv_le_stableRangeCore_of_pow`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {K F : Type*} [Field K] [Field F] [Algebra K F] [Differential F]

/-! ### Evaluated tensor transport -/

/-- **Tensor transport.**  If the pullback of a rational `k`-differential along a substitution is
`lam` times the tensor itself, then the evaluated current is scaled by `lam`.  The chain rule
supplies the `k`-th power of the derivative factor, which is exactly what the tensor eigen-relation
consumes. -/
theorem tensorCurrent_transport {k : ℕ} (x Rx Rdx qx qRx lam : F)
    (hchain : Rx′ = Rdx * x′) (heig : qRx * Rdx ^ k = lam * qx) :
    qRx * Rx′ ^ k = lam * (qx * x′ ^ k) := by
  rw [hchain, mul_pow, ← mul_assoc, heig, mul_assoc]

/-! ### The whole differential field of an eigen-current survives -/

/-- **Eigen-current differential tail inclusion.**  If a constraint scales `q` by a nonzero base
constant and commutes with the derivation, then every jet of `q` — and hence the whole differential
field it generates — survives in every iterated image field. -/
theorem differentialAdjoin_le_stableRangeCore_of_algebraMap_eigenvector
    (phi : F →ₐ[K] F) (hphi : ∀ x : F, phi x′ = (phi x)′) (q : F) (a : K) (ha : a ≠ 0)
    (hq : phi q = algebraMap K F a * q) :
    differentialAdjoin K ({q} : Set F) ≤ stableRangeCore phi := by
  have hclosed : DerivationClosed (stableRangeCore phi) :=
    derivationClosed_stableRangeCore phi hphi
  have hmem : q ∈ stableRangeCore phi :=
    algebraMap_eigenvector_mem_stableRangeCore phi q a ha hq
  have hjet : ∀ n : ℕ, differentialJet n q ∈ stableRangeCore phi := by
    intro n
    induction n with
    | zero => simpa using hmem
    | succ n ih =>
        rw [differentialJet_succ]
        exact hclosed ih
  rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
  rintro x ⟨y, hy, n, rfl⟩
  have hyq : y = q := Set.mem_singleton_iff.mp hy
  subst hyq
  exact hjet n

/-! ### The power maps -/

/-- **The power-map orbifold current.**  A substitution raising the free jet to the `d`-th power
scales its logarithmic current by `d`, so the whole differential field generated by that current
lies in every iterated image field. -/
theorem differentialAdjoin_logDeriv_le_stableRangeCore_of_pow
    (phi : F →ₐ[K] F) (hphi : ∀ x : F, phi x′ = (phi x)′) (y : F) (d : ℕ)
    (hd : (d : K) ≠ 0) (hpow : phi y = y ^ d) :
    differentialAdjoin K ({Differential.logDeriv y} : Set F) ≤ stableRangeCore phi := by
  have h1 : phi (y′ / y) = (y ^ d)′ / y ^ d := by
    rw [map_div₀, hphi, hpow]
  have h2 : (y ^ d)′ / y ^ d = (d : F) * (y′ / y) := Differential.logDeriv_pow d y
  have h3 : algebraMap K F (d : K) = (d : F) := by
    rw [map_natCast]
  have hq : phi (Differential.logDeriv y)
      = algebraMap K F (d : K) * Differential.logDeriv y := by
    rw [Differential.logDeriv, h1, h2, h3]
  exact differentialAdjoin_le_stableRangeCore_of_algebraMap_eigenvector phi hphi _ (d : K) hd hq

/-- **The translated power maps.**  A substitution sending `y` to `c + (y - c)^d` scales the
logarithmic current of `y - c` by `d`, so the differential field of that translated current
survives at every scale.  This is the conjugated instance the alternating protocols use. -/
theorem differentialAdjoin_logDeriv_sub_le_stableRangeCore_of_pow
    (phi : F →ₐ[K] F) (hphi : ∀ x : F, phi x′ = (phi x)′) (y : F) (c : K) (d : ℕ)
    (hd : (d : K) ≠ 0)
    (hpow : phi y = algebraMap K F c + (y - algebraMap K F c) ^ d) :
    differentialAdjoin K ({Differential.logDeriv (y - algebraMap K F c)} : Set F)
      ≤ stableRangeCore phi := by
  set z : F := y - algebraMap K F c with hz
  have hphiz : phi z = z ^ d := by
    rw [hz, map_sub, phi.commutes, hpow]
    ring
  exact differentialAdjoin_logDeriv_le_stableRangeCore_of_pow phi hphi z d hd hphiz

end

end GaloisForLFunctions.HTGeometry
