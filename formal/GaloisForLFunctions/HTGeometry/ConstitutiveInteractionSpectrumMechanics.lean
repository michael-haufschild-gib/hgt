import Mathlib.NumberTheory.SumPrimeReciprocals

/-!
# Constitutive interaction-spectrum mechanics

A factorized source generates a product energy ledger on finite interaction supports.  Degree
truncation is passive, its defect is the exact hidden tail, and coherent phase information loses
four times that tail.  The literal prime formation has its summability wall exactly at exponent
one, so reflection across one preserves the formation phase only at the fixed point.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## Finite source formation -/

/-- Activation probability of one interaction channel generated by a Bernoulli source cell. -/
def interactionActivation (q : ℝ) : ℝ :=
  4 * q * (1 - q)

/-- Product work carried by one finite interaction support. -/
def interactionWorkWeight {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (S : Finset I) : ℝ :=
  (∏ i ∈ S, a i) * ∏ i ∈ Sᶜ, (1 - a i)

/-- The source-side squared parity coefficient before it is identified with the work ledger. -/
def directParityInteractionSq {I : Type*} [Fintype I] [DecidableEq I]
    (q : I → ℝ) (S : Finset I) : ℝ :=
  (∏ i ∈ S, 4 * q i * (1 - q i)) *
    ∏ i ∈ Sᶜ, (1 - 2 * q i) ^ 2

/-- Multiplicative parity generates exactly the product interaction-work law. -/
theorem directParityInteractionSq_eq_interactionWorkWeight
    {I : Type*} [Fintype I] [DecidableEq I]
    (q : I → ℝ) (S : Finset I) :
    directParityInteractionSq q S =
      interactionWorkWeight (fun i => interactionActivation (q i)) S := by
  unfold directParityInteractionSq interactionWorkWeight interactionActivation
  congr 1
  apply Finset.prod_congr rfl
  intro i hi
  ring

/-- The full interaction ledger has total work one. -/
theorem sum_interactionWorkWeight_eq_one
    {I : Type*} [Fintype I] [DecidableEq I] (a : I → ℝ) :
    ∑ S : Finset I, interactionWorkWeight a S = 1 := by
  calc
    ∑ S : Finset I, interactionWorkWeight a S =
        ∏ i, (a i + (1 - a i)) := by
      simpa [interactionWorkWeight] using (Fintype.prod_add a (fun i => 1 - a i)).symm
    _ = 1 := by simp

/-- One-coordinate marginal of the interaction-work law.  The complete ledger therefore
reconstructs every activation parameter. -/
theorem sum_interactionWorkWeight_of_mem_eq
    {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (i : I) :
    (∑ S : Finset I, if i ∈ S then interactionWorkWeight a S else 0) = a i := by
  classical
  let g : I → ℝ := fun j => if j = i then 0 else 1 - a j
  have hprod : (∏ j, (a j + g j)) = a i := by
    calc
      ∏ j, (a j + g j) = ∏ j, if j = i then a i else 1 := by
        apply Finset.prod_congr rfl
        intro j hj
        by_cases hji : j = i
        · subst j
          simp [g]
        · simp [g, hji]
      _ = a i := by simp
  have hsum := Fintype.prod_add a g
  rw [hprod] at hsum
  rw [hsum]
  apply Finset.sum_congr rfl
  intro S hS
  by_cases hiS : i ∈ S
  · rw [if_pos hiS]
    unfold interactionWorkWeight
    congr 1
    apply Finset.prod_congr rfl
    intro j hj
    have hji : j ≠ i := by
      intro h
      subst j
      exact (Finset.mem_compl.mp hj) hiS
    simp [g, hji]
  · rw [if_neg hiS]
    have hic : i ∈ Sᶜ := Finset.mem_compl.mpr hiS
    have hz : ∏ j ∈ Sᶜ, g j = 0 := by
      apply Finset.prod_eq_zero hic
      simp [g]
    rw [hz, mul_zero]

/-- Mean interaction degree of the work ledger. -/
def meanInteractionDegree {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) : ℝ :=
  ∑ S : Finset I, interactionWorkWeight a S * (S.card : ℝ)

/-- Mean degree is total local activation mass. -/
theorem meanInteractionDegree_eq_sum
    {I : Type*} [Fintype I] [DecidableEq I] (a : I → ℝ) :
    meanInteractionDegree a = ∑ i, a i := by
  classical
  unfold meanInteractionDegree
  calc
    ∑ S : Finset I, interactionWorkWeight a S * (S.card : ℝ) =
        ∑ S : Finset I, ∑ i : I,
          if i ∈ S then interactionWorkWeight a S else 0 := by
      apply Finset.sum_congr rfl
      intro S hS
      rw [show (S.card : ℝ) = ∑ i : I, if i ∈ S then 1 else 0 by simp]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hiS : i ∈ S <;> simp [hiS]
    _ = ∑ i : I, ∑ S : Finset I,
          if i ∈ S then interactionWorkWeight a S else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ i, a i := by
      apply Finset.sum_congr rfl
      intro i hi
      exact sum_interactionWorkWeight_of_mem_eq a i

/-- Work visible to an observer of interaction degree at most `D`. -/
def visibleInteractionWork {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (D : ℕ) : ℝ :=
  ∑ S : Finset I, if S.card ≤ D then interactionWorkWeight a S else 0

/-- Work hidden above interaction degree `D`. -/
def hiddenInteractionWork {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (D : ℕ) : ℝ :=
  ∑ S : Finset I, if D < S.card then interactionWorkWeight a S else 0

/-- Exact partition of work into visible and hidden interaction degrees. -/
theorem visibleInteractionWork_add_hiddenInteractionWork
    {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (D : ℕ) :
    visibleInteractionWork a D + hiddenInteractionWork a D = 1 := by
  rw [visibleInteractionWork, hiddenInteractionWork, ← Finset.sum_add_distrib]
  calc
    ∑ S : Finset I,
        ((if S.card ≤ D then interactionWorkWeight a S else 0) +
          if D < S.card then interactionWorkWeight a S else 0) =
        ∑ S : Finset I, interactionWorkWeight a S := by
      apply Finset.sum_congr rfl
      intro S hS
      by_cases h : S.card ≤ D
      · simp [h, Nat.not_lt_of_ge h]
      · have h' : D < S.card := Nat.lt_of_not_ge h
        simp [h, h']
    _ = 1 := sum_interactionWorkWeight_eq_one a

/-- Every interaction support has nonnegative work for probabilities `a_i ∈ [0,1]`. -/
theorem interactionWorkWeight_nonneg
    {I : Type*} [Fintype I] [DecidableEq I]
    {a : I → ℝ} (ha0 : ∀ i, 0 ≤ a i) (ha1 : ∀ i, a i ≤ 1)
    (S : Finset I) :
    0 ≤ interactionWorkWeight a S := by
  unfold interactionWorkWeight
  exact mul_nonneg
    (Finset.prod_nonneg fun i hi => ha0 i)
    (Finset.prod_nonneg fun i hi => sub_nonneg.mpr (ha1 i))

/-- Hidden work is nonnegative. -/
theorem hiddenInteractionWork_nonneg
    {I : Type*} [Fintype I] [DecidableEq I]
    {a : I → ℝ} (ha0 : ∀ i, 0 ≤ a i) (ha1 : ∀ i, a i ≤ 1)
    (D : ℕ) :
    0 ≤ hiddenInteractionWork a D := by
  unfold hiddenInteractionWork
  exact Finset.sum_nonneg fun S hS => by
    by_cases h : D < S.card
    · simp [h, interactionWorkWeight_nonneg ha0 ha1 S]
    · simp [h]

/-- Markov work bound: degree above `D` is controlled by total activation mass. -/
theorem natCast_succ_mul_hiddenInteractionWork_le_mean
    {I : Type*} [Fintype I] [DecidableEq I]
    {a : I → ℝ} (ha0 : ∀ i, 0 ≤ a i) (ha1 : ∀ i, a i ≤ 1)
    (D : ℕ) :
    ((D + 1 : ℕ) : ℝ) * hiddenInteractionWork a D ≤ meanInteractionDegree a := by
  rw [hiddenInteractionWork, meanInteractionDegree, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro S hS
  have hweight := interactionWorkWeight_nonneg ha0 ha1 S
  by_cases h : D < S.card
  · rw [if_pos h]
    have hcard : ((D + 1 : ℕ) : ℝ) ≤ (S.card : ℝ) := by
      exact_mod_cast (Nat.succ_le_iff.mpr h)
    nlinarith
  · rw [if_neg h, mul_zero]
    exact mul_nonneg hweight (Nat.cast_nonneg S.card)

/-- Degree truncation is passive: visible work cannot exceed full work. -/
theorem visibleInteractionWork_le_one
    {I : Type*} [Fintype I] [DecidableEq I]
    {a : I → ℝ} (ha0 : ∀ i, 0 ≤ a i) (ha1 : ∀ i, a i ≤ 1)
    (D : ℕ) :
    visibleInteractionWork a D ≤ 1 := by
  have hsplit := visibleInteractionWork_add_hiddenInteractionWork a D
  have hhidden := hiddenInteractionWork_nonneg ha0 ha1 D
  linarith

/-- Pure-state coherent QFI of the complete parity ledger. -/
def fullInteractionQFI {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) : ℝ :=
  4 * (1 - interactionWorkWeight a ∅)

/-- Pure-state coherent QFI visible through degree `D`. -/
def visibleInteractionQFI {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (D : ℕ) : ℝ :=
  4 * (visibleInteractionWork a D - interactionWorkWeight a ∅)

/-- **Work--information conservation.**  Lost QFI is four times hidden interaction work. -/
theorem fullInteractionQFI_sub_visibleInteractionQFI
    {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) (D : ℕ) :
    fullInteractionQFI a - visibleInteractionQFI a D =
      4 * hiddenInteractionWork a D := by
  have hsplit := visibleInteractionWork_add_hiddenInteractionWork a D
  unfold fullInteractionQFI visibleInteractionQFI
  linarith

/-- The marked lower Bernoulli chamber makes the activation packet source-faithful. -/
theorem interactionActivation_injective_on_lower_half
    {q r : ℝ} (hq1 : q ≤ 1 / 2) (hr1 : r ≤ 1 / 2)
    (h : interactionActivation q = interactionActivation r) :
    q = r := by
  unfold interactionActivation at h
  have hfactor : (q - r) * (1 - q - r) = 0 := by
    nlinarith
  rcases mul_eq_zero.mp hfactor with hqr | hsum
  · linarith
  · nlinarith

/-! ## Literal prime formation phase -/

/-- Prime interaction activation generated by the Euler-shell Bernoulli source. -/
def primeInteractionActivation (σ : ℝ) (p : Nat.Primes) : ℝ :=
  4 * ((p : ℝ) ^ (-σ)) / (1 + (p : ℝ) ^ (-σ)) ^ 2

private theorem prime_rpow_neg_pos (σ : ℝ) (p : Nat.Primes) :
    0 < (p : ℝ) ^ (-σ) := by
  exact Real.rpow_pos_of_pos (by exact_mod_cast p.2.pos) _

private theorem prime_rpow_neg_le_one {σ : ℝ} (hσ : 0 ≤ σ) (p : Nat.Primes) :
    (p : ℝ) ^ (-σ) ≤ 1 := by
  exact Real.rpow_le_one_of_one_le_of_nonpos
    (by exact_mod_cast p.2.one_lt.le) (by linarith)

/-- Exact comparison with the prime `p^{-σ}` model. -/
theorem prime_rpow_le_interactionActivation_le {σ : ℝ} (hσ : 0 ≤ σ)
    (p : Nat.Primes) :
    (p : ℝ) ^ (-σ) ≤ primeInteractionActivation σ p ∧
      primeInteractionActivation σ p ≤ 4 * (p : ℝ) ^ (-σ) := by
  let x : ℝ := (p : ℝ) ^ (-σ)
  have hx0 : 0 < x := prime_rpow_neg_pos σ p
  have hx1 : x ≤ 1 := prime_rpow_neg_le_one hσ p
  have hden : 0 < (1 + x) ^ 2 := sq_pos_of_pos (by linarith)
  have hlower : x * (1 + x) ^ 2 ≤ 4 * x := by
    have hfac : 4 * x - x * (1 + x) ^ 2 = x * (1 - x) * (3 + x) := by ring
    have hnonneg : 0 ≤ x * (1 - x) * (3 + x) := by positivity
    linarith
  have hden1 : 1 ≤ (1 + x) ^ 2 := by nlinarith [sq_nonneg x]
  constructor
  · rw [primeInteractionActivation]
    change x ≤ 4 * x / (1 + x) ^ 2
    exact (le_div_iff₀ hden).2 hlower
  · rw [primeInteractionActivation]
    change 4 * x / (1 + x) ^ 2 ≤ 4 * x
    rw [div_le_iff₀ hden]
    simpa only [mul_one] using
      (mul_le_mul_of_nonneg_left hden1 (show 0 ≤ 4 * x by positivity))

theorem primeInteractionActivation_nonneg (σ : ℝ) (p : Nat.Primes) :
    0 ≤ primeInteractionActivation σ p := by
  unfold primeInteractionActivation
  positivity

/-- The interaction formation is summable exactly above exponent one. -/
theorem summable_primeInteractionActivation_iff {σ : ℝ} (hσ : 0 ≤ σ) :
    Summable (primeInteractionActivation σ) ↔ 1 < σ := by
  constructor
  · intro hsum
    have hmodel : Summable (fun p : Nat.Primes => (p : ℝ) ^ (-σ)) :=
      Summable.of_nonneg_of_le
        (fun p => (prime_rpow_neg_pos σ p).le)
        (fun p => (prime_rpow_le_interactionActivation_le hσ p).1)
        hsum
    have hexp := Nat.Primes.summable_rpow.mp hmodel
    linarith
  · intro hσ1
    have hmodel : Summable (fun p : Nat.Primes => (p : ℝ) ^ (-σ)) :=
      Nat.Primes.summable_rpow.mpr (by linarith)
    refine Summable.of_nonneg_of_le
      (fun p => primeInteractionActivation_nonneg σ p)
      (fun p => (prime_rpow_le_interactionActivation_le hσ p).2)
      (hmodel.mul_left 4)

/-- **Reciprocal formation-phase classifier.**  Reflection `σ ↦ 2-σ` preserves the
summable/escaping phase only at its fixed point. -/
theorem primeInteractionFormationPhase_reflection_iff
    {σ : ℝ} (hσ0 : 0 < σ) (hσ2 : σ < 2) :
    (Summable (primeInteractionActivation σ) ↔
      Summable (primeInteractionActivation (2 - σ))) ↔ σ = 1 := by
  rw [summable_primeInteractionActivation_iff hσ0.le,
    summable_primeInteractionActivation_iff (by linarith : 0 ≤ 2 - σ)]
  constructor
  · intro hphase
    rcases lt_trichotomy σ 1 with hlt | heq | hgt
    · have hreflected : 1 < 2 - σ := by linarith
      have hsource : 1 < σ := hphase.mpr hreflected
      linarith
    · exact heq
    · have hsource : 1 < σ := hgt
      have hreflected : 1 < 2 - σ := hphase.mp hsource
      linarith
  · intro hσ
    subst σ
    constructor <;> intro h <;> linarith

end

end GaloisForLFunctions.HTGeometry
