import GaloisForLFunctions.HTGeometry.PowerEndomorphism
import GaloisForLFunctions.HTGeometry.RadicalDifferentialAdjoin
import GaloisForLFunctions.HTGeometry.DeckDegreeUpperBoundBridge
import GaloisForLFunctions.HTGeometry.FreeDifferentialLinearAction

/-!
# The multiplicative protocol and its phase tail

On a differential field freely generated by one hypertranscendental element the power endomorphisms
form a nonautonomous protocol whose prefix images are the differential fields generated by the
accumulated powers of the generator.  Its deck group is the group of roots of unity of the
coefficient field acting by scaling the generator, and the degree of a prefix image is bounded by
the accumulated exponent.

This makes the phase-tail identity unconditional for the multiplicative protocol: the tail is the
fixed field of the closed erased sector, with no descent theory and no hypothesis about degrees.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

/-- The exponent accumulated by the first `n` steps of a multiplicative protocol from phase `i`. -/
def prefixExponent (m : ℕ → ℕ) : ℕ → ℕ → ℕ
  | _, 0 => 1
  | i, n + 1 => m i * prefixExponent m (i + 1) n

@[simp] theorem prefixExponent_zero (m : ℕ → ℕ) (i : ℕ) : prefixExponent m i 0 = 1 := rfl

@[simp] theorem prefixExponent_succ (m : ℕ → ℕ) (i n : ℕ) :
    prefixExponent m i (n + 1) = m i * prefixExponent m (i + 1) n := rfl

theorem prefixExponent_pos {m : ℕ → ℕ} (hm : ∀ j, 0 < m j) (i n : ℕ) :
    0 < prefixExponent m i n := by
  induction n generalizing i with
  | zero => exact Nat.one_pos
  | succ n ih => exact Nat.mul_pos (hm i) (ih (i + 1))

section

variable {g : E} (hg : DifferentialIndependent C (fun _ : Unit ↦ g))
  (hgen : differentialAdjoin C (Set.range fun _ : Unit ↦ g) = ⊤)

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
include hg in
/-- A differentially independent generator is nonzero. -/
theorem gen_ne_zero : g ≠ 0 := by
  intro h
  have htr : Transcendental C g := transcendental_of_differentialIndependent hg
  exact htr (h ▸ isAlgebraic_zero)

omit [Differential C] [DifferentialAlgebra C E] [CharZero E] in
include hgen in
theorem differentialAdjoin_singleton_eq_top : differentialAdjoin C ({g} : Set E) = ⊤ := by
  have hset : (Set.range fun _ : Unit ↦ g) = ({g} : Set E) := by simp
  rwa [hset] at hgen

/-- **The multiplicative protocol.**  At phase `j` the constraint map raises the generator to the
`m j`-th power. -/
def powerProtocol (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) : ℕ → (E →ₐ[C] E) :=
  fun j ↦ powerEndo hg hgen (hm j)

/-- The prefix of a multiplicative protocol raises the generator to the accumulated exponent. -/
theorem forwardPrefix_powerProtocol (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) (i n : ℕ) :
    forwardPrefix (powerProtocol hg hgen m hm) i n
      = powerEndo hg hgen (prefixExponent_pos hm i n) := by
  induction n generalizing i with
  | zero =>
      rw [forwardPrefix]
      exact (powerEndo_one hg hgen (prefixExponent_pos hm i 0)).symm
  | succ n ih =>
      rw [forwardPrefix, ih (i + 1)]
      change (powerEndo hg hgen (hm i)).comp _ = _
      rw [powerEndo_comp]
      exact powerEndo_congr hg hgen _ _ (Nat.mul_comm _ _)

/-- The prefix image of a multiplicative protocol is the differential field generated by the
accumulated power of the generator. -/
theorem map_forwardPrefix_powerProtocol (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) (i n : ℕ) :
    IntermediateField.map (forwardPrefix (powerProtocol hg hgen m hm) i n) ⊤
      = differentialAdjoin C ({g ^ prefixExponent m i n} : Set E) := by
  rw [forwardPrefix_powerProtocol hg hgen m hm i n]
  exact powerEndo_map_top hg hgen (prefixExponent_pos hm i n)

/-- **The scaling automorphism.**  Multiplying the generator by a unit of the coefficient field. -/
def scaleEquiv (u : Cˣ) : E ≃ₐ[C] E :=
  differentialIndependentFamilyScaleEquiv (fun _ : Unit ↦ g) hg hgen u

omit [CharZero E] in
theorem scaleEquiv_gen (u : Cˣ) : scaleEquiv hg hgen u g = algebraMap C E (u : C) * g :=
  differentialIndependentFamilyScaleEquiv_apply (fun _ : Unit ↦ g) hg hgen u ()

omit [CharZero E] in
theorem scaleEquiv_deriv (u : Cˣ) (z : E) :
    scaleEquiv hg hgen u z′ = (scaleEquiv hg hgen u z)′ :=
  differentialIndependentFamilyScaleEquiv_deriv (fun _ : Unit ↦ g) hg hgen u z

omit [CharZero E] in
/-- The trivial scaling is the identity. -/
theorem scaleEquiv_one : scaleEquiv hg hgen (1 : Cˣ) = 1 := by
  refine tailEquiv_ext (fun _ : Unit ↦ g) hgen (fun z ↦ scaleEquiv_deriv hg hgen 1 z)
    (fun z ↦ ?_) (fun _ ↦ ?_)
  · rw [AlgEquiv.one_apply, AlgEquiv.one_apply]
  · rw [scaleEquiv_gen, AlgEquiv.one_apply]
    simp

omit [CharZero E] in
/-- Scalings compose by multiplying the scalars. -/
theorem scaleEquiv_mul (u v : Cˣ) :
    scaleEquiv hg hgen (u * v) = scaleEquiv hg hgen u * scaleEquiv hg hgen v := by
  refine tailEquiv_ext (fun _ : Unit ↦ g) hgen (fun z ↦ scaleEquiv_deriv hg hgen (u * v) z)
    (fun z ↦ ?_) (fun _ ↦ ?_)
  · rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, scaleEquiv_deriv, scaleEquiv_deriv]
  · rw [AlgEquiv.mul_apply, scaleEquiv_gen, scaleEquiv_gen, map_mul, AlgEquiv.commutes,
      scaleEquiv_gen, Units.val_mul, map_mul]
    ring

/-- **The deck representation of the multiplicative protocol.**  A unit of the coefficient field
acts by scaling the generator. -/
def scaleRep : Cˣ →* (E ≃ₐ[C] E) where
  toFun u := scaleEquiv hg hgen u
  map_one' := scaleEquiv_one hg hgen
  map_mul' := scaleEquiv_mul hg hgen

omit [CharZero E] in
@[simp] theorem scaleRep_eq (u : Cˣ) : scaleRep hg hgen u = scaleEquiv hg hgen u := rfl

omit [CharZero E] in
theorem scaleRep_gen (u : Cˣ) : scaleRep hg hgen u g = algebraMap C E (u : C) * g :=
  scaleEquiv_gen hg hgen u

omit [CharZero E] in
include hg in
/-- The deck representation is faithful: a scaling that fixes the generator is trivial. -/
theorem scaleRep_injective : Function.Injective (scaleRep hg hgen) := by
  intro u v huv
  have hg0 : g ≠ 0 := gen_ne_zero hg
  have h := congrArg (fun σ : E ≃ₐ[C] E ↦ σ g) huv
  simp only [scaleRep_gen] at h
  have hcast : algebraMap C E (u : C) = algebraMap C E (v : C) :=
    mul_right_cancel₀ hg0 h
  have : (u : C) = (v : C) := (algebraMap C E).injective hcast
  exact Units.ext this

omit [CharZero E] in
/-- **The deck action fixes the differential field of a power.**  Scaling by an `N`-th root of unity
fixes the differential field generated by the `N`-th power of the generator. -/
theorem differentialAdjoin_pow_le_fixedField {N : ℕ} :
    differentialAdjoin C ({g ^ N} : Set E) ≤
      IntermediateField.fixedField ((rootsOfUnity N C).map (scaleRep hg hgen)) := by
  refine differentialAdjoin_le C ?_ ?_
  · intro x hx
    have hxg : x = g ^ N := hx
    simp only [SetLike.mem_coe] at *
    rw [hxg, IntermediateField.mem_fixedField_iff]
    rintro σ ⟨u, hu, rfl⟩
    have hu' : (u : Cˣ) ^ N = 1 := by
      simpa [mem_rootsOfUnity] using hu
    have : scaleRep hg hgen u (g ^ N) = (algebraMap C E (u : C)) ^ N * g ^ N := by
      rw [map_pow, scaleRep_gen, mul_pow]
    rw [this, ← map_pow]
    have hone : ((u : Cˣ) : C) ^ N = 1 := by
      have := congrArg (fun w : Cˣ ↦ (w : C)) hu'
      simpa using this
    rw [hone, map_one, one_mul]
  · intro x hx
    rw [IntermediateField.mem_fixedField_iff] at hx ⊢
    rintro σ ⟨u, hu, rfl⟩
    have hfix := hx (scaleRep hg hgen u) ⟨u, hu, rfl⟩
    rw [scaleRep_eq] at hfix ⊢
    rw [scaleEquiv_deriv, hfix]

omit [CharZero E] in
include hg in
/-- The deck group at a given exponent has exactly that order when the coefficient field contains a
primitive root of unity. -/
theorem card_map_rootsOfUnity {N : ℕ} (hN : 0 < N) {ζ : C} (hζ : IsPrimitiveRoot ζ N) :
    Nat.card ((rootsOfUnity N C).map (scaleRep hg hgen)) = N := by
  haveI : NeZero N := ⟨hN.ne'⟩
  have hequiv := Subgroup.equivMapOfInjective (rootsOfUnity N C) (scaleRep hg hgen)
    (scaleRep_injective hg hgen)
  have hcard := Nat.card_congr hequiv.toEquiv
  rw [← hcard]
  simpa [Nat.card_eq_fintype_card] using hζ.card_rootsOfUnity

omit [CharZero E] in
include hg in
/-- The deck group at a given exponent is finite. -/
theorem finite_map_rootsOfUnity {N : ℕ} (hN : 0 < N) :
    Finite ((rootsOfUnity N C).map (scaleRep hg hgen)) := by
  haveI : NeZero N := ⟨hN.ne'⟩
  exact Finite.of_equiv _ (Subgroup.equivMapOfInjective (rootsOfUnity N C) (scaleRep hg hgen)
    (scaleRep_injective hg hgen)).toEquiv

end

/-- **The multiplicative protocol on the coefficient units.**  At phase `j` a unit is raised to the
`m j`-th power. -/
def powerProtocolGroup (C : Type*) [Field C] (m : ℕ → ℕ) : ∀ _ : ℕ, Cˣ →* Cˣ :=
  fun j ↦ powMonoidHom (m j)

theorem prefixHom_powerProtocolGroup (C : Type*) [Field C] (m : ℕ → ℕ) (i n : ℕ) :
    prefixHom (powerProtocolGroup C m) i n = powMonoidHom (prefixExponent m i n) := by
  induction n generalizing i with
  | zero =>
      refine MonoidHom.ext fun u ↦ ?_
      change u = u ^ (1 : ℕ)
      rw [pow_one]
  | succ n ih =>
      refine MonoidHom.ext fun u ↦ ?_
      change prefixHom (powerProtocolGroup C m) (i + 1) n (u ^ m i) = u ^ (m i * _)
      rw [ih (i + 1)]
      change (u ^ m i) ^ prefixExponent m (i + 1) n = u ^ (m i * prefixExponent m (i + 1) n)
      rw [← pow_mul]

theorem prefixKernel_powerProtocolGroup (C : Type*) [Field C] (m : ℕ → ℕ) (i n : ℕ) :
    prefixKernel (powerProtocolGroup C m) i n = rootsOfUnity (prefixExponent m i n) C := by
  rw [prefixKernel, prefixHom_powerProtocolGroup]
  ext u
  simp [mem_rootsOfUnity, MonoidHom.mem_ker]

section

variable {g : E} (hg : DifferentialIndependent C (fun _ : Unit ↦ g))
  (hgen : differentialAdjoin C (Set.range fun _ : Unit ↦ g) = ⊤)

include hg hgen in
/-- **The phase tail of the multiplicative protocol.**  For a protocol of positive exponents whose
accumulated exponents are all realized by primitive roots of unity in the coefficient field, the
tail of the protocol is the fixed field of the closed erased sector of the scaling action.

Every hypothesis of the deck-descent identity is discharged here: the prefix images are the
differential fields of the accumulated powers, the deck groups are the corresponding groups of roots
of unity, and the degree bound is the radical bound of the exponent. -/
theorem multiplicativeProtocol_nonautonomousTail_eq_fixedField
    [TopologicalSpace Cˣ] [IsTopologicalGroup Cˣ] [DiscreteTopology Cˣ]
    (m : ℕ → ℕ) (hm : ∀ j, 0 < m j) (i : ℕ)
    (hroot : ∀ n : ℕ, ∃ ζ : C, IsPrimitiveRoot ζ (prefixExponent m i n)) :
    nonautonomousTail (powerProtocol hg hgen m hm) i =
      IntermediateField.fixedField
        ((erasedClosure (powerProtocolGroup C m) i).map (scaleRep hg hgen)) := by
  have hg0 : g ≠ 0 := gen_ne_zero hg
  have htop : differentialAdjoin C ({g} : Set E) = ⊤ :=
    differentialAdjoin_singleton_eq_top hgen
  refine nonautonomousTail_eq_fixedField_erasedClosure_of_finrank_le
    (powerProtocol hg hgen m hm) i (powerProtocolGroup C m) (scaleRep hg hgen)
    (fun n ↦ ?_) (fun n ↦ ?_) (fun n ↦ ?_) (fun n ↦ ?_) (fun x ↦ ?_)
  · rw [prefixKernel_powerProtocolGroup]
    exact finite_map_rootsOfUnity hg hgen (prefixExponent_pos hm i n)
  · rw [map_forwardPrefix_powerProtocol]
    exact finiteDimensional_differentialAdjoin_pow g hg0 (prefixExponent_pos hm i n) htop
  · rw [map_forwardPrefix_powerProtocol, prefixKernel_powerProtocolGroup]
    exact differentialAdjoin_pow_le_fixedField hg hgen
  · obtain ⟨ζ, hζ⟩ := hroot n
    rw [map_forwardPrefix_powerProtocol, prefixKernel_powerProtocolGroup,
      card_map_rootsOfUnity hg hgen (prefixExponent_pos hm i n) hζ]
    exact finrank_differentialAdjoin_pow_le g hg0 (prefixExponent_pos hm i n) htop
  · exact isClosed_discrete _

end

end

end GaloisForLFunctions.HTGeometry
