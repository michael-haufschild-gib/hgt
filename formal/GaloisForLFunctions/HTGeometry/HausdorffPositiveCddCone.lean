import Mathlib

/-!
# Complete monotonicity of positive geometric coupling combinations

The sign-corrected odd higher-spin CDD couplings generated by positive paired shells have the form
`b_m = ∑_j w_j r_j^{2m}` with `w_j ≥ 0` and shell radii `r_j ∈ [0,1]`.  This module proves the
necessity direction of the Hausdorff characterisation of their positivity cone: every such coupling
sequence is **completely monotone**,

```
(-1)^k (Δ^k b)_m ≥ 0   for all m, k,
```

where `Δ = fwdDiff 1` is the forward difference.  The proof is the exact finite-difference identity
`Δ^k (y^·)_m = (y-1)^k y^m`, so `(-1)^k Δ^k (y^·)_m = (1-y)^k y^m ≥ 0` for `y ∈ [0,1]`, summed against
the nonnegative weights.

The converse (Hausdorff's moment theorem: a completely monotone sequence is the moment sequence of a
positive measure on `[0,1]`) is a classical result not present in mathlib and is not formalised here.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

/-- Iterated forward difference of a finite combination of geometric sequences:
`Δ^k (∑_j w_j y_j^·)_m = ∑_j w_j (y_j-1)^k y_j^m`. -/
theorem fwdDiff_iter_geometricCombination {ι : Type*} (s : Finset ι) (w y : ι → ℝ) (k : ℕ) :
    ∀ m : ℕ, (fwdDiff 1)^[k] (fun n : ℕ => ∑ j ∈ s, w j * (y j) ^ n) m
      = ∑ j ∈ s, w j * ((y j - 1) ^ k * (y j) ^ m) := by
  induction k with
  | zero => intro m; simp
  | succ k ih =>
      intro m
      rw [Function.iterate_succ_apply', fwdDiff, ih (m + 1), ih m, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro j _
      rw [pow_succ (y j - 1) k, pow_succ (y j) m]
      ring

/-- **Complete monotonicity of positive geometric combinations.**  A finite nonnegative combination
of geometric sequences with ratios in `[0,1]` is completely monotone. -/
theorem geometricCombination_completelyMonotone {ι : Type*} (s : Finset ι) (w y : ι → ℝ)
    (hw : ∀ j ∈ s, 0 ≤ w j) (hy0 : ∀ j ∈ s, 0 ≤ y j) (hy1 : ∀ j ∈ s, y j ≤ 1) (m k : ℕ) :
    0 ≤ (-1) ^ k * ((fwdDiff 1)^[k] (fun n : ℕ => ∑ j ∈ s, w j * (y j) ^ n) m) := by
  rw [fwdDiff_iter_geometricCombination s w y k m, Finset.mul_sum]
  apply Finset.sum_nonneg
  intro j hj
  have hsign : (-1 : ℝ) ^ k * (w j * ((y j - 1) ^ k * (y j) ^ m))
      = w j * ((1 - y j) ^ k * (y j) ^ m) := by
    rw [show (1 - y j) ^ k = (-1) ^ k * (y j - 1) ^ k from by rw [← neg_sub, neg_pow]]
    ring
  rw [hsign]
  exact mul_nonneg (hw j hj)
    (mul_nonneg (pow_nonneg (by linarith [hy1 j hj]) k) (pow_nonneg (hy0 j hj) m))

/-- **CDD coupling positivity cone (necessity).**  The paired-shell CDD couplings
`b_m = ∑_j w_j r_j^{2m}` with `w_j ≥ 0` and shell radii `r_j ∈ [0,1]` obey the infinite family of
finite-difference positivity inequalities `(-1)^k (Δ^k b)_m ≥ 0`. -/
theorem cddCoupling_completelyMonotone {ι : Type*} (s : Finset ι) (w r : ι → ℝ)
    (hw : ∀ j ∈ s, 0 ≤ w j) (hr0 : ∀ j ∈ s, 0 ≤ r j) (hr1 : ∀ j ∈ s, r j ≤ 1) (m k : ℕ) :
    0 ≤ (-1) ^ k * ((fwdDiff 1)^[k] (fun n : ℕ => ∑ j ∈ s, w j * (r j) ^ (2 * n)) m) := by
  have hrw : (fun n : ℕ => ∑ j ∈ s, w j * (r j) ^ (2 * n))
      = fun n : ℕ => ∑ j ∈ s, w j * ((r j) ^ (2 : ℕ)) ^ n := by
    funext n; apply Finset.sum_congr rfl; intro j _; rw [pow_mul]
  rw [hrw]
  exact geometricCombination_completelyMonotone s w (fun j => (r j) ^ (2 : ℕ)) hw
    (fun j _ => sq_nonneg _) (fun j hj => by nlinarith [hr0 j hj, hr1 j hj]) m k

end GaloisForLFunctions.HTGeometry
