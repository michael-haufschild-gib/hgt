import GaloisForLFunctions.HTGeometry.CoherenceEndReconstruction
import GaloisForLFunctions.HTGeometry.PrimeDirichletDifferentialField

/-!
# Prime-tail consequences of coherence-end reconstruction

This file joins the graph-theoretic finite-defect coherence theorem to the already formalized
projective prime-orientation tail line and to the exact differential-field classifier for complete
signed-prime natural-shift palettes.  No analytic field-identification hypothesis is hidden in the
statement.
-/

namespace GaloisForLFunctions.HTGeometry

universe u

variable {P : Type u}

/-- The embedded differential field generated by the complete nonnegative-integer shift palette
of one signed prime orientation. -/
noncomputable def signedPrimeNaturalShiftField (ε : Nat.Primes → Bool) :=
  GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
    (Set.range (signedPrimeNaturalShiftPalette ε))

/-- Equality of the actual embedded signed-prime differential fields is exactly projective
finite-tail equivalence of their Boolean orientations. -/
theorem signedPrimeNaturalShiftField_eq_iff_booleanProjectiveFiniteEquivalent
    (ε δ : Nat.Primes → Bool) :
    signedPrimeNaturalShiftField ε = signedPrimeNaturalShiftField δ ↔
      BooleanProjectiveFiniteEquivalent ε δ := by
  change
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (signedPrimeNaturalShiftPalette ε)) =
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (signedPrimeNaturalShiftPalette δ)) ↔ _
  rw [signedPrimeNaturalShiftPalette_differentialAdjoin_eq_iff]
  rfl

/-- The graph-native projective finite-tail relation is exactly the established projective
prime-orientation relation. -/
theorem booleanProjectiveFiniteEquivalent_iff_primeOrientationTailPairDependent
    (ε δ : P → Bool) :
    BooleanProjectiveFiniteEquivalent ε δ ↔
      PrimeOrientationTailPairDependent ε δ := by
  rw [primeOrientationTailPairDependent_iff]
  rfl

/-- **Prime coherence-tail law.**  Finite-boundary one-endedness is exactly faithfulness of
finite-defect graph coherence on the projective prime-orientation coefficient-tail line. -/
theorem finiteBoundaryOneEnded_iff_primeOrientationCoherenceTail_faithful
    (G : SimpleGraph P) :
    FiniteBoundaryOneEnded G ↔
      ∀ ε δ : P → Bool,
        BooleanEdgeTailEquivalent G ε δ →
          PrimeOrientationTailPairDependent ε δ := by
  rw [finiteBoundaryOneEnded_iff_booleanEdgeTail_faithful]
  constructor
  · intro h ε δ hedge
    exact (booleanProjectiveFiniteEquivalent_iff_primeOrientationTailPairDependent ε δ).mp
      (h ε δ hedge)
  · intro h ε δ hedge
    exact (booleanProjectiveFiniteEquivalent_iff_primeOrientationTailPairDependent ε δ).mpr
      (h ε δ hedge)

/-- **Differential-field coherence-end law.**  On a graph indexed by the rational primes,
finite-boundary one-endedness is exactly faithfulness of finite-defect edge coherence on the
embedded differential fields generated by complete signed-prime shift palettes. -/
theorem finiteBoundaryOneEnded_iff_signedPrimeNaturalShiftField_faithful
    (G : SimpleGraph Nat.Primes) :
    FiniteBoundaryOneEnded G ↔
      ∀ ε δ : Nat.Primes → Bool,
        BooleanEdgeTailEquivalent G ε δ →
          signedPrimeNaturalShiftField ε = signedPrimeNaturalShiftField δ := by
  constructor
  · intro hG ε δ hedge
    apply (signedPrimeNaturalShiftField_eq_iff_booleanProjectiveFiniteEquivalent ε δ).mpr
    exact (finiteBoundaryOneEnded_iff_booleanEdgeTail_faithful G).mp hG ε δ hedge
  · intro hfield
    apply (finiteBoundaryOneEnded_iff_booleanEdgeTail_faithful G).mpr
    intro ε δ hedge
    apply (signedPrimeNaturalShiftField_eq_iff_booleanProjectiveFiniteEquivalent ε δ).mp
    exact hfield ε δ hedge

/-- If the finite-boundary one-ended property fails, finitely defective edge data can hide two
genuinely independent projective prime-orientation tail directions. -/
theorem exists_coherenceTailEquivalent_not_primeOrientationTailPairDependent_of_not_oneEnded
    (G : SimpleGraph P) (hG : ¬FiniteBoundaryOneEnded G) :
    ∃ ε δ : P → Bool,
      BooleanEdgeTailEquivalent G ε δ ∧
        ¬PrimeOrientationTailPairDependent ε δ := by
  classical
  rw [finiteBoundaryOneEnded_iff_primeOrientationCoherenceTail_faithful] at hG
  push Not at hG
  exact hG

/-- If one-endedness fails, a finite edge defect can hide two unequal embedded differential fields
whose two unshifted signed-prime sources are jointly differentially independent. -/
theorem exists_coherenceTailEquivalent_unequal_signedPrimeFields_of_not_oneEnded
    (G : SimpleGraph Nat.Primes) (hG : ¬FiniteBoundaryOneEnded G) :
    ∃ ε δ : Nat.Primes → Bool,
      BooleanEdgeTailEquivalent G ε δ ∧
        signedPrimeNaturalShiftField ε ≠ signedPrimeNaturalShiftField δ ∧
        GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
          (Sum.elim (fun _ : Unit => signedPrimeNaturalShiftPalette ε 0)
            (fun _ : Unit => signedPrimeNaturalShiftPalette δ 0)) := by
  obtain ⟨ε, δ, hedge, hnotdep⟩ :=
    exists_coherenceTailEquivalent_not_primeOrientationTailPairDependent_of_not_oneEnded G hG
  have hrel : ¬(PrimeOrientationsEventuallyEqual ε δ ∨
      PrimeOrientationsEventuallyOpposite ε δ) := by
    intro h
    exact hnotdep ((primeOrientationTailPairDependent_iff ε δ).mpr h)
  refine ⟨ε, δ, hedge, ?_,
    signedPrimeUnshiftedPair_differentialIndependent_of_not_tailEquivalent ε δ hrel⟩
  exact (signedPrimeNaturalShiftField_eq_iff_booleanProjectiveFiniteEquivalent ε δ).not.mpr
    (by simpa [BooleanProjectiveFiniteEquivalent,
      PrimeOrientationsEventuallyEqual, PrimeOrientationsEventuallyOpposite] using hrel)

/-- Tensoring two infinite preconnected prime-indexing graphs removes every finite-defect
coherence ambiguity at the coefficient-tail-line level. -/
theorem primeOrientationCoherenceTail_faithful_boxProd
    {Q : Type*} [Infinite P] [Infinite Q]
    (G : SimpleGraph P) (H : SimpleGraph Q)
    (hG : G.Preconnected) (hH : H.Preconnected)
    (ε δ : P × Q → Bool)
    (hcoherence : BooleanEdgeTailEquivalent (G □ H) ε δ) :
    PrimeOrientationTailPairDependent ε δ := by
  apply
    (finiteBoundaryOneEnded_iff_primeOrientationCoherenceTail_faithful (G □ H)).mp
      (finiteBoundaryOneEnded_boxProd G H hG hH)
  exact hcoherence

end GaloisForLFunctions.HTGeometry
