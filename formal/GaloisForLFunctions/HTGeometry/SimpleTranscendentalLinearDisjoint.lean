import GaloisForLFunctions.HTGeometry.TranscendentalBaseChange

/-!
# Linear disjointness from one transcendental coordinate

A family in a coefficient field which is linearly independent over the constant field remains
linearly independent after adjoining an element transcendental over the whole coefficient field.
Applying this to a Hamel basis gives the concrete linear disjointness of the coefficient field and
the simple rational function field generated by that element.
-/

open Polynomial IntermediateField

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]

/-- The finite-family base-change lemma extends to an arbitrarily indexed linearly independent
family because every linear relation has finite support. -/
theorem linearIndependent_adjoin_transcendental_arbitrary
    (E : IntermediateField F Ω) (t : Ω) (ht : Transcendental E t)
    {ι : Type*} (b : ι → Ω) (hbE : ∀ i, b i ∈ E)
    (hind : LinearIndependent F b) :
    LinearIndependent (F⟮t⟯) b := by
  classical
  rw [linearIndependent_iff]
  intro l hl
  let s := l.support
  let b' : s → Ω := fun i => b i.1
  have hind' : LinearIndependent F b' := by
    exact hind.comp (fun i : s => i.1) Subtype.val_injective
  have hnew : LinearIndependent (F⟮t⟯) b' :=
    linearIndependent_adjoin_transcendental E t ht b'
      (fun i => hbE i.1) hind'
  have hsum : ∑ i : s, l i.1 • b' i = 0 := by
    change l.support.attach.sum (fun i => l i.1 • b i.1) = 0
    rw [Finset.sum_attach l.support (fun i => l i • b i)]
    change l.support.sum (fun i => l i • b i) = 0 at hl
    exact hl
  have hcoeff := Fintype.linearIndependent_iff.1 hnew
      (fun i : s => l i.1) hsum
  apply Finsupp.ext
  intro i
  by_cases hi : i ∈ l.support
  · exact hcoeff ⟨i, hi⟩
  · simpa [Finsupp.mem_support_iff] using hi

/-- If `t` is transcendental over `E`, then `E` and the simple rational field `F(t)` are linearly
disjoint over `F` inside the common overfield. -/
theorem linearDisjoint_adjoin_of_transcendental
    (E : IntermediateField F Ω) (t : Ω) (ht : Transcendental E t) :
    E.LinearDisjoint F⟮t⟯ := by
  let bas := Module.Free.chooseBasis F E
  apply IntermediateField.LinearDisjoint.of_basis_left bas
  exact linearIndependent_adjoin_transcendental_arbitrary E t ht
    (E.val ∘ bas) (fun i => (bas i).property) (by
      exact bas.linearIndependent.map' E.val.toLinearMap (by
        rw [LinearMap.ker_eq_bot]
        exact fun x y hxy => Subtype.ext hxy))

end

end GaloisForLFunctions.HTGeometry
