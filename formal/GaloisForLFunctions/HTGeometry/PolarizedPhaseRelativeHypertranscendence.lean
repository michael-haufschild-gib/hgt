import GaloisForLFunctions.HTGeometry.PrimeOccupationPolarizedGammaPhaseSurvival
import GaloisForLFunctions.HTGeometry.EvenPowerCanonicalProductDA
import GaloisForLFunctions.HTGeometry.AnalyticJetFieldBridge
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicBaseChange

/-!
# The polarized Gamma phase is hypertranscendental relative to the sine intensity

The unpolarized completion collapses to the Euler sine product, which is differentially algebraic.
Adjoining a differentially algebraic coefficient changes nothing about hypertranscendence, so the
polarized phase remains hypertranscendental over the differential field generated by the intensity —
the exact relative statement of the polarized-survival theorem.

* `HTGeometry.differentialAlgebraicOver_sincProductMero`;
* `HTGeometry.hypertranscendentalOver_polarizedPhase_over_sincProduct`.
-/

open Complex Set
open scoped Differential BigOperators

namespace GaloisForLFunctions

open Bottcher HTGeometry

noncomputable section

open scoped UnivMeroFieldInstances

namespace HTGeometry

/-- The Euler sine product as a global meromorphic element. -/
def sincProductMero : meroField (Set.univ : Set ℂ) :=
  analyticMeroElement _root_.HTGeometry.sincProduct _root_.HTGeometry.analyticOnNhd_sincProduct

/-- **The sine intensity is differentially algebraic in the meromorphic field.** -/
theorem differentialAlgebraicOver_sincProductMero :
    DifferentialAlgebraicOver (RatFunc ℂ) sincProductMero :=
  differentialAlgebraicOver_analyticMeroElement_of_differentiallyAlgebraic
    _root_.HTGeometry.analyticOnNhd_sincProduct _root_.HTGeometry.differentiallyAlgebraic_sincProduct

/-- **Relative hypertranscendence of the polarized phase.**  The completed polarized Gamma phase
stays hypertranscendental after the whole differential field generated by the sine intensity is
adjoined to the coefficients. -/
theorem hypertranscendentalOver_polarizedPhase_over_sincProduct :
    HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ) ({sincProductMero} : Set (meroField (Set.univ : Set ℂ))))
      primeOccupationPolarizedGammaPhaseMero :=
  (hypertranscendentalOver_differentialAdjoinSingleton_iff
    differentialAlgebraicOver_sincProductMero).2
    hypertranscendentalOver_primeOccupationPolarizedGammaPhaseMero

end HTGeometry

end

end GaloisForLFunctions
