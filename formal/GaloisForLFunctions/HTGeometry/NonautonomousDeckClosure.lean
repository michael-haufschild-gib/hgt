import GaloisForLFunctions.HTGeometry.DeckClosureStableCore
import GaloisForLFunctions.HTGeometry.NonautonomousStableCore

/-!
# Nonautonomous tails as total deck invariants

At a fixed phase of a time-dependent sequence, suppose each finite prefix image is the fixed
field of its finite-depth deck group.  The phase tail is then the fixed field of the subgroup
generated by all of those deck groups.

This is the formal field-theoretic core of the nonautonomous Maurer--Cartan time theorem.  Its
algebraic-group interpretation uses paper-level jet-quotient and logarithmic-derivative inputs.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- **Nonautonomous deck-closure theorem.**  If every finite prefix image at phase `i` is the
fixed field of its deck subgroup, the phase tail is fixed by the group generated over all
depths. -/
theorem nonautonomousTail_eq_fixedField_iSup
    (φ : ℕ → F →ₐ[K] F) (i : ℕ)
    (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (forwardPrefix φ i n) ⊤ =
      IntermediateField.fixedField (Γ n)) :
    nonautonomousTail φ i = IntermediateField.fixedField (⨆ n, Γ n) := by
  rw [nonautonomousTail, fixedField_iSup]
  exact iInf_congr hdeck

/-- Pointwise form: a phase observable survives every future depth exactly when every
finite-depth deck group fixes it. -/
theorem mem_nonautonomousTail_iff_fixedBy_prefixDeck
    (φ : ℕ → F →ₐ[K] F) (i : ℕ)
    (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (forwardPrefix φ i n) ⊤ =
      IntermediateField.fixedField (Γ n)) (x : F) :
    x ∈ nonautonomousTail φ i ↔
      ∀ n, x ∈ IntermediateField.fixedField (Γ n) := by
  rw [nonautonomousTail_eq_fixedField_iSup φ i Γ hdeck, mem_fixedField_iSup_iff]

end

end GaloisForLFunctions.HTGeometry
