import GaloisForLFunctions.HTGeometry.PrimeWalshDifferentialRank

/-!
# Finite-range prime-Dirichlet projective field moduli

This file upgrades the bounded finite-range prime carrier from a sufficient tail-rank criterion to
an exact one.  It then identifies the scalar tail relation that preserves the embedded differential
field generated by the complete natural-shift palette.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction
open scoped Differential

noncomputable section

set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000

local instance complexFinitePrimeRationalAmbientScalarTower :
    IsScalarTower ℂ finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  .of_algebraMap_eq fun c => by
    change algebraMap ℂ arithmeticFunctionRationalCoordinateField c =
      finitePrimeRationalCoefficientFieldToFormalRatFunc
        (algebraMap ℂ finitePrimeRationalCoefficientField c)
    rw [IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      finitePrimeRationalCoefficientField]
    rw [finitePrimeRationalCoefficientFieldToFormalRatFunc_algebraMap]
    rw [← IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      arithmeticFunctionFractionField]
    rw [IsScalarTower.algebraMap_apply ℂ arithmeticFunctionFractionField
      arithmeticFunctionRationalCoordinateField]

/-- The canonical complete natural-shift palette of a bounded prime coefficient column. -/
def boundedPrimeNaturalShiftPalette
    (c : Nat.Primes → ℂ) (hc : ∀ p, ‖c p‖ ≤ 1) (a : ℕ) :
    arithmeticFunctionRationalCoordinateField :=
  boundedPrimeShiftCarrier c hc (a : ℂ)

/-- Two coefficient columns represent the same projective prime tail when one nonzero complex
multiple differs from the other at only finitely many primes. -/
def PrimeCoefficientTailProjectivelyEquivalent
    (c d : Nat.Primes → ℂ) : Prop :=
  ∃ z : ℂ, z ≠ 0 ∧ {p | c p - z * d p ≠ 0}.Finite

/-- **Exact finite shifted-palette criterion.** For a bounded coefficient family with finite joint
range, differential independence of a finite palette of shifts is equivalent to linear
independence of the source columns modulo finite prime support. -/
theorem boundedPrimeShiftPalette_differentialIndependent_iff
    {J A : Type*} [Fintype J] [DecidableEq J] [Nonempty J]
    [Fintype A] [DecidableEq A] [Nonempty A]
    (c : J → Nat.Primes → ℂ) (hc : ∀ j p, ‖c j p‖ ≤ 1)
    (alpha : A → ℂ) (hdistinct : Function.Injective (fun a => (alpha a).re))
    (hrange : (Set.range (coefficientPattern c)).Finite) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
        (fun ja : J × A => boundedPrimeShiftCarrier
          (c ja.1) (hc ja.1) (alpha ja.2)) ↔
      TailCoefficientIndependent c := by
  constructor
  · intro hdiff
    unfold GaloisForLFunctions.DifferentialIndependent at hdiff
    let f : J × (A × Fin 1) → (J × A) × ℕ := fun jak =>
      ((jak.1, jak.2.1), jak.2.2)
    have hf : Function.Injective f := by
      rintro ⟨j, a, k⟩ ⟨j', a', k'⟩ h
      simp only [f, Prod.mk.injEq] at h ⊢
      exact ⟨h.1.1, h.1.2, Fin.ext h.2⟩
    have hzero := hdiff.comp f hf
    let coeff : J × (A × Fin 1) → Nat.Primes → ℂ := fun jak p =>
      c jak.1 p * primeShiftFactor (alpha jak.2.1) p *
        rotatedPrimeLogClock p ^ (jak.2.2 : ℕ)
    have hconst : AlgebraicIndependent finitePrimeRationalCoefficientField
        (fun jak : J × (A × Fin 1) =>
          algebraMap arithmeticFunctionFractionField
            arithmeticFunctionRationalCoordinateField
            (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
              (arithmeticOfPrimeColumn (coeff jak)))) := by
      simpa only [Function.comp_apply, f, coeff,
        differentialJet_boundedPrimeShiftCarrier,
        boundedPrimeShiftedRotatedJet_eq_arithmeticOfPrimeColumn] using hzero
    have hfrac : AlgebraicIndependent finitePrimeCoefficientField
        (fun jak : J × (A × Fin 1) =>
          algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
            (arithmeticOfPrimeColumn (coeff jak))) :=
      (algebraicIndependent_constants_over_finitePrimeRationalCoefficientField_iff _).mp hconst
    have htailCoeff : TailCoefficientIndependent coeff :=
      (algebraicIndependent_fractionPrimeColumns_over_finitePrimeCoefficientField_iff coeff).mp
        hfrac
    have hraw : TailCoefficientIndependent
        (coefficientShiftJet c
          (fun a p => primeShiftFactor (alpha a) p) primeLogClock 0) := by
      convert htailCoeff using 1
      funext jak p
      simp only [coefficientShiftJet, coeff, Fin.isValue, pow_zero, mul_one]
    exact tailCoefficientIndependent_of_coefficientShiftJet c
      (fun a p => primeShiftFactor (alpha a) p) primeLogClock 0
      (primeShiftFactor_hasNowhereZeroFactor alpha) hraw
  · exact boundedPrimeShiftPalette_differentialIndependent c hc alpha hdistinct hrange

/-- **Complete natural-shift criterion.** The complete nonnegative-integer shift palette of a
finite bounded finite-range family is differentially independent exactly when the coefficient
columns are independent modulo finite prime support. -/
theorem boundedPrimeNaturalShiftPalette_differentialIndependent_iff
    {J : Type*} [Fintype J] [DecidableEq J] [Nonempty J]
    (c : J → Nat.Primes → ℂ) (hc : ∀ j p, ‖c j p‖ ≤ 1)
    (hrange : (Set.range (coefficientPattern c)).Finite) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
        (fun ja : J × ℕ => boundedPrimeNaturalShiftPalette
          (c ja.1) (hc ja.1) ja.2) ↔
      TailCoefficientIndependent c := by
  constructor
  · intro hdiff
    unfold GaloisForLFunctions.DifferentialIndependent at hdiff
    let f : J × (Fin 1 × Fin 1) → (J × ℕ) × ℕ := fun jak =>
      ((jak.1, jak.2.1), jak.2.2)
    have hf : Function.Injective f := by
      rintro ⟨j, a, k⟩ ⟨j', a', k'⟩ h
      simp only [f, Prod.mk.injEq] at h ⊢
      exact ⟨h.1.1, Fin.ext h.1.2, Fin.ext h.2⟩
    have hzero := hdiff.comp f hf
    have hfinite : GaloisForLFunctions.DifferentialIndependent
        finitePrimeRationalCoefficientField
        (fun ja : J × Fin 1 => boundedPrimeShiftCarrier
          (c ja.1) (hc ja.1) ((ja.2 : ℕ) : ℂ)) := by
      unfold GaloisForLFunctions.DifferentialIndependent
      simpa only [Function.comp_apply, f, boundedPrimeNaturalShiftPalette] using hzero
    exact (boundedPrimeShiftPalette_differentialIndependent_iff c hc
      (fun a : Fin 1 => ((a : ℕ) : ℂ)) (by
        intro a b h
        apply Fin.ext
        exact natCastComplex_re_injective h) hrange).mp hfinite
  · intro htail
    unfold GaloisForLFunctions.DifferentialIndependent
    simp_rw [boundedPrimeNaturalShiftPalette, differentialJet_boundedPrimeShiftCarrier]
    apply algebraicIndependent_of_finite_type
    intro t ht
    obtain ⟨qa, hqa⟩ := Set.exists_upper_bound_image t (fun z => z.1.2) ht
    obtain ⟨qk, hqk⟩ := Set.exists_upper_bound_image t Prod.snd ht
    let f : t → J × (Fin (qa.1.2 + 1) × Fin (qk.2 + 1)) := fun z =>
      (z.1.1.1,
        (⟨z.1.1.2, Nat.lt_succ_of_le (hqa z.1 z.2)⟩,
          ⟨z.1.2, Nat.lt_succ_of_le (hqk z.1 z.2)⟩))
    have hf : Function.Injective f := by
      intro z w hzw
      apply Subtype.ext
      apply Prod.ext
      · apply Prod.ext
        · exact congrArg (fun u => u.1) hzw
        · exact congrArg (fun u => ((u.2.1 : Fin (qa.1.2 + 1)) : ℕ)) hzw
      · exact congrArg (fun u => ((u.2.2 : Fin (qk.2 + 1)) : ℕ)) hzw
    have hrect := boundedPrimeShiftedRotatedJets_algebraicIndependent c hc
      (fun a : Fin (qa.1.2 + 1) => ((a : ℕ) : ℂ)) (by
        intro a b h
        apply Fin.ext
        exact natCastComplex_re_injective h) hrange htail qk.2
    have hsub := hrect.comp f hf
    simpa only [Function.comp_apply, f] using hsub

end

end GaloisForLFunctions.HTGeometry
