import GaloisForLFunctions.HTGeometry.PrimeCoefficientDifferentialCarrier

/-!
# Finite-range prime-Dirichlet projective field moduli

This file constructs the general finite-range prime carrier directly from prime-supported
arithmetic columns.  It identifies its exact differential tail rank and then the scalar tail
relation that preserves the embedded differential field generated by the complete natural-shift
palette.
-/

namespace GaloisForLFunctions.HTGeometry

open ArithmeticFunction
open scoped Differential

noncomputable section

set_option maxHeartbeats 200000
set_option synthInstance.maxHeartbeats 50000

local instance complexFinitePrimeRationalAmbientScalarTower :
    IsScalarTower ℂ finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  .of_algebraMap_eq fun c => by
    change algebraMap ℂ arithmeticFunctionRationalCoordinateField c =
      finitePrimeRationalCoefficientFieldToFormalRatFunc
        (algebraMap ℂ finitePrimeRationalCoefficientField c)
    rw [IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      finitePrimeRationalCoefficientField]
    rw [finitePrimeRationalCoefficientFieldToFormalRatFunc_algebraMap]
    rw [← IsScalarTower.algebraMap_apply ℂ finitePrimeCoefficientField
      arithmeticFunctionFractionField]
    rw [IsScalarTower.algebraMap_apply ℂ arithmeticFunctionFractionField
      arithmeticFunctionRationalCoordinateField]

/-- Two coefficient columns represent the same projective prime tail when one nonzero complex
multiple differs from the other at only finitely many primes. -/
def PrimeCoefficientTailProjectivelyEquivalent
    (c d : Nat.Primes → ℂ) : Prop :=
  ∃ z : ℂ, z ≠ 0 ∧ {p | c p - z * d p ≠ 0}.Finite

/-- A coefficient column represents the zero tail class exactly when it is finitely supported. -/
def PrimeCoefficientTailZero (c : Nat.Primes → ℂ) : Prop :=
  {p | c p ≠ 0}.Finite

/-- The two-column family used to compare two prime sources. -/
def primeCoefficientPair (c d : Nat.Primes → ℂ) : Bool → Nat.Primes → ℂ :=
  fun b => if b then d else c

/-- Linear dependence of two coefficient columns modulo finite prime support. -/
def PrimeCoefficientTailPairDependent (c d : Nat.Primes → ℂ) : Prop :=
  ∃ a b : ℂ, (a ≠ 0 ∨ b ≠ 0) ∧
    {p | a * c p + b * d p ≠ 0}.Finite

theorem primeCoefficientPair_tailIndependent_iff_not_pairDependent
    (c d : Nat.Primes → ℂ) :
    TailCoefficientIndependent (primeCoefficientPair c d) ↔
      ¬ PrimeCoefficientTailPairDependent c d := by
  constructor
  · intro htail hdep
    obtain ⟨a, b, hab, hsupp⟩ := hdep
    let u : Bool → ℂ := fun q => if q then b else a
    have hu : u = 0 := htail u (by
      simpa [primeCoefficientPair, u, Fintype.sum_bool, add_comm] using hsupp)
    have ha : a = 0 := by
      have := congrFun hu false
      simpa [u] using this
    have hb : b = 0 := by
      have := congrFun hu true
      simpa [u] using this
    exact hab.elim (fun h => h ha) (fun h => h hb)
  · intro hnot u hsupp
    by_contra hu
    apply hnot
    refine ⟨u false, u true, ?_, ?_⟩
    · have hexists : ∃ q, u q ≠ 0 := by
        simpa only [Pi.zero_apply] using (Function.ne_iff.mp hu)
      obtain ⟨q, hq⟩ := hexists
      cases q
      · exact Or.inl hq
      · exact Or.inr hq
    · simpa only [primeCoefficientPair, Bool.if_false_right,
        Fintype.sum_bool, Bool.false_eq_true, ↓reduceIte, Bool.true_eq_false,
        not_false_eq_true, add_comm] using hsupp

/-- Away from the zero tail orbit, two columns are dependent modulo finite support exactly when
their tail classes lie on the same nonzero complex line. -/
theorem primeCoefficientTailPairDependent_iff_projectivelyEquivalent
    (c d : Nat.Primes → ℂ)
    (hc : ¬ PrimeCoefficientTailZero c) (hd : ¬ PrimeCoefficientTailZero d) :
    PrimeCoefficientTailPairDependent c d ↔
      PrimeCoefficientTailProjectivelyEquivalent c d := by
  constructor
  · rintro ⟨a, b, hab, hsupp⟩
    have ha : a ≠ 0 := by
      intro ha
      have hb : b ≠ 0 := hab.resolve_left (by simpa using ha)
      apply hd
      have hbd : {p | b * d p ≠ 0}.Finite := by
        simpa [ha] using hsupp
      simpa [hb] using hbd
    have hb : b ≠ 0 := by
      intro hb
      apply hc
      have hac : {p | a * c p ≠ 0}.Finite := by
        simpa [hb] using hsupp
      simpa [ha] using hac
    refine ⟨-(b / a), neg_ne_zero.mpr (div_ne_zero hb ha), ?_⟩
    apply hsupp.subset
    intro p hp
    simp only [Set.mem_setOf_eq] at hp ⊢
    intro hzero
    apply hp
    apply mul_left_cancel₀ ha
    calc
      a * (c p - (-(b / a)) * d p) = a * c p + b * d p := by
        field_simp [ha]
        ring
      _ = 0 := hzero
      _ = a * 0 := by ring
  · rintro ⟨z, hz, hsupp⟩
    refine ⟨1, -z, Or.inl one_ne_zero, ?_⟩
    simpa [sub_eq_add_neg] using hsupp

/-- A singleton coefficient family is tail-independent exactly when its column has nonzero tail
class. -/
theorem tailCoefficientIndependent_unit_iff (c : Nat.Primes → ℂ) :
    TailCoefficientIndependent (fun _ : Unit => c) ↔
      ¬ PrimeCoefficientTailZero c := by
  constructor
  · intro htail hzero
    let u : Unit → ℂ := fun _ => 1
    have hu : u = 0 := htail u (by simpa [u] using hzero)
    have := congrFun hu ()
    norm_num [u] at this
  · intro hnonzero u hsupp
    funext q
    rcases q with ⟨⟩
    by_contra hu
    apply hnonzero
    apply hsupp.subset
    intro p hp
    simp only [Set.mem_setOf_eq, Fintype.sum_unique] at hp ⊢
    exact mul_ne_zero hu hp

/-- The complete finite rotated shift--jet rectangle has tail rank exactly when its finite-range
source family has scalar tail rank. -/
theorem primeCoefficientShiftedRotatedJet_tailIndependent_iff
    {J A : Type*} [Fintype J] [Fintype A] [Nonempty A]
    (c : J → Nat.Primes → ℂ) (alpha : A → ℂ)
    (hdistinct : Function.Injective (fun a => (alpha a).re))
    (hrange : (Set.range (coefficientPattern c)).Finite) (m : ℕ) :
    TailCoefficientIndependent
        (fun jak : J × (A × Fin (m + 1)) => fun p =>
          c jak.1 p * primeShiftFactor (alpha jak.2.1) p *
            rotatedPrimeLogClock p ^ (jak.2.2 : ℕ)) ↔
      TailCoefficientIndependent c := by
  classical
  let raw := coefficientShiftJet c
    (fun a p => primeShiftFactor (alpha a) p) primeLogClock m
  let u : J × (A × Fin (m + 1)) → ℂ :=
    fun jak => Complex.I ^ (jak.2.2 : ℕ)
  have hu : ∀ jak, u jak ≠ 0 := fun jak => pow_ne_zero _ Complex.I_ne_zero
  have hscale :
      TailCoefficientIndependent (fun jak p => u jak * raw jak p) ↔
        TailCoefficientIndependent raw :=
    tailCoefficientIndependent_scale_columns_iff raw u hu
  have hraw : TailCoefficientIndependent raw ↔ TailCoefficientIndependent c :=
    coefficientShiftJet_tailIndependent_iff_of_finiteRange c
      (fun a p => primeShiftFactor (alpha a) p) primeLogClock hrange
      (primeShiftFactor_hasNowhereZeroFactor alpha) m
      (primeFactorClockFiberIndependent alpha hdistinct m)
  rw [← hraw, ← hscale]
  have hfun :
      (fun jak : J × (A × Fin (m + 1)) => fun p =>
        c jak.1 p * primeShiftFactor (alpha jak.2.1) p *
          rotatedPrimeLogClock p ^ (jak.2.2 : ℕ)) =
      (fun jak p => u jak * raw jak p) := by
    funext jak p
    simp only [raw, u, coefficientShiftJet, rotatedPrimeLogClock]
    rw [mul_pow]
    ring
  rw [hfun]

/-- **Exact finite shifted-jet matroid.** Every finite rectangle of shifted jets is algebraically
independent over the finite-prime rational coefficient field exactly when the source columns are
tail-independent. -/
theorem primeCoefficientShiftedRotatedJets_algebraicIndependent_iff
    {J A : Type*} [Fintype J] [DecidableEq J]
    [Fintype A] [DecidableEq A] [Nonempty A]
    (c : J → Nat.Primes → ℂ) (alpha : A → ℂ)
    (hdistinct : Function.Injective (fun a => (alpha a).re))
    (hrange : (Set.range (coefficientPattern c)).Finite) (m : ℕ) :
    AlgebraicIndependent finitePrimeRationalCoefficientField
        (fun jak : J × (A × Fin (m + 1)) =>
          algebraMap arithmeticFunctionFractionField
            arithmeticFunctionRationalCoordinateField
            (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
              (primeCoefficientShiftedRotatedJet
                (c jak.1) (alpha jak.2.1) jak.2.2))) ↔
      TailCoefficientIndependent c := by
  rw [algebraicIndependent_constants_over_finitePrimeRationalCoefficientField_iff]
  let coeff : J × (A × Fin (m + 1)) → Nat.Primes → ℂ := fun jak p =>
    c jak.1 p * primeShiftFactor (alpha jak.2.1) p *
      rotatedPrimeLogClock p ^ (jak.2.2 : ℕ)
  rw [← primeCoefficientShiftedRotatedJet_tailIndependent_iff
    c alpha hdistinct hrange m]
  simpa only [primeCoefficientShiftedRotatedJet, coeff] using
    (algebraicIndependent_fractionPrimeColumns_over_finitePrimeCoefficientField_iff coeff)

/-- **Exact finite shifted-palette criterion.** For a coefficient family with finite joint range,
differential independence of a finite palette of shifts is equivalent to linear independence of
the source columns modulo finite prime support. -/
theorem primeCoefficientShiftPalette_differentialIndependent_iff
    {J A : Type*} [Fintype J] [DecidableEq J] [Nonempty J]
    [Fintype A] [DecidableEq A] [Nonempty A]
    (c : J → Nat.Primes → ℂ) (alpha : A → ℂ)
    (hdistinct : Function.Injective (fun a => (alpha a).re))
    (hrange : (Set.range (coefficientPattern c)).Finite) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
        (fun ja : J × A => primeCoefficientShiftCarrier (c ja.1) (alpha ja.2)) ↔
      TailCoefficientIndependent c := by
  constructor
  · intro hdiff
    unfold GaloisForLFunctions.DifferentialIndependent at hdiff
    let f : J × (A × Fin 1) → (J × A) × ℕ := fun jak =>
      ((jak.1, jak.2.1), jak.2.2)
    have hf : Function.Injective f := by
      rintro ⟨j, a, k⟩ ⟨j', a', k'⟩ h
      simp only [f, Prod.mk.injEq] at h ⊢
      exact ⟨h.1.1, h.1.2, Fin.ext h.2⟩
    have hzero := hdiff.comp f hf
    have hjets : AlgebraicIndependent finitePrimeRationalCoefficientField
        (fun jak : J × (A × Fin 1) =>
          algebraMap arithmeticFunctionFractionField
            arithmeticFunctionRationalCoordinateField
            (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
              (primeCoefficientShiftedRotatedJet
                (c jak.1) (alpha jak.2.1) jak.2.2))) := by
      simpa only [Function.comp_apply, f,
        differentialJet_primeCoefficientShiftCarrier] using hzero
    exact (primeCoefficientShiftedRotatedJets_algebraicIndependent_iff
      c alpha hdistinct hrange 0).mp hjets
  · intro htail
    unfold GaloisForLFunctions.DifferentialIndependent
    simp_rw [differentialJet_primeCoefficientShiftCarrier]
    let x : (J × A) → ℕ → arithmeticFunctionRationalCoordinateField := fun ja k =>
      algebraMap arithmeticFunctionFractionField arithmeticFunctionRationalCoordinateField
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
          (primeCoefficientShiftedRotatedJet (c ja.1) (alpha ja.2) k))
    apply algebraicIndependent_prod_nat_of_fin x
    intro m
    let f : (J × A) × Fin (m + 1) → J × (A × Fin (m + 1)) := fun jak =>
      (jak.1.1, (jak.1.2, jak.2))
    have hf : Function.Injective f := by
      rintro ⟨⟨j, a⟩, k⟩ ⟨⟨j', a'⟩, k'⟩ h
      simp only [f, Prod.mk.injEq] at h ⊢
      exact ⟨⟨h.1, h.2.1⟩, h.2.2⟩
    have hrect := (primeCoefficientShiftedRotatedJets_algebraicIndependent_iff
      c alpha hdistinct hrange m).mpr htail
    have hsub := hrect.comp f hf
    simpa only [Function.comp_apply, f, x] using hsub

/-- **Complete natural-shift criterion.** The complete nonnegative-integer shift palette of a
finite bounded finite-range family is differentially independent exactly when the coefficient
columns are independent modulo finite prime support. -/
theorem primeCoefficientNaturalShiftPalette_differentialIndependent_iff
    {J : Type*} [Fintype J] [DecidableEq J] [Nonempty J]
    (c : J → Nat.Primes → ℂ)
    (hrange : (Set.range (coefficientPattern c)).Finite) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
        (fun ja : J × ℕ => primeCoefficientNaturalShiftPalette (c ja.1) ja.2) ↔
      TailCoefficientIndependent c := by
  constructor
  · intro hdiff
    unfold GaloisForLFunctions.DifferentialIndependent at hdiff
    let f : J × (Fin 1 × Fin 1) → (J × ℕ) × ℕ := fun jak =>
      ((jak.1, jak.2.1), jak.2.2)
    have hf : Function.Injective f := by
      rintro ⟨j, a, k⟩ ⟨j', a', k'⟩ h
      simp only [f, Prod.mk.injEq] at h ⊢
      exact ⟨h.1.1, Fin.ext h.1.2, Fin.ext h.2⟩
    have hzero := hdiff.comp f hf
    have hjets : AlgebraicIndependent finitePrimeRationalCoefficientField
        (fun jak : J × (Fin 1 × Fin 1) =>
          algebraMap arithmeticFunctionFractionField
            arithmeticFunctionRationalCoordinateField
            (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
              (primeCoefficientShiftedRotatedJet
                (c jak.1) ((jak.2.1 : ℕ) : ℂ) jak.2.2))) := by
      simpa only [Function.comp_apply, f, primeCoefficientNaturalShiftPalette,
        differentialJet_primeCoefficientShiftCarrier] using hzero
    exact (primeCoefficientShiftedRotatedJets_algebraicIndependent_iff c
      (fun a : Fin 1 => ((a : ℕ) : ℂ)) (by
        intro a b h
        apply Fin.ext
        exact natCastComplex_re_injective h) hrange 0).mp hjets
  · intro htail
    unfold GaloisForLFunctions.DifferentialIndependent
    simp_rw [primeCoefficientNaturalShiftPalette,
      differentialJet_primeCoefficientShiftCarrier]
    apply algebraicIndependent_of_finite_type
    intro t ht
    obtain ⟨qa, hqa⟩ := Set.exists_upper_bound_image t (fun z => z.1.2) ht
    obtain ⟨qk, hqk⟩ := Set.exists_upper_bound_image t Prod.snd ht
    let f : t → J × (Fin (qa.1.2 + 1) × Fin (qk.2 + 1)) := fun z =>
      (z.1.1.1,
        (⟨z.1.1.2, Nat.lt_succ_of_le (hqa z.1 z.2)⟩,
          ⟨z.1.2, Nat.lt_succ_of_le (hqk z.1 z.2)⟩))
    have hf : Function.Injective f := by
      intro z w hzw
      apply Subtype.ext
      apply Prod.ext
      · apply Prod.ext
        · exact congrArg (fun u => u.1) hzw
        · exact congrArg (fun u => ((u.2.1 : Fin (qa.1.2 + 1)) : ℕ)) hzw
      · exact congrArg (fun u => ((u.2.2 : Fin (qk.2 + 1)) : ℕ)) hzw
    have hrect := (primeCoefficientShiftedRotatedJets_algebraicIndependent_iff c
      (fun a : Fin (qa.1.2 + 1) => ((a : ℕ) : ℂ)) (by
        intro a b h
        apply Fin.ext
        exact natCastComplex_re_injective h) hrange qk.2).mpr htail
    have hsub := hrect.comp f hf
    simpa only [Function.comp_apply, f] using hsub

/-- The projective residual of two shifted jets is again a single prime-supported column. -/
theorem primeCoefficientShiftedRotatedJet_sub_smul_eq_arithmeticOfPrimeColumn
    (c d : Nat.Primes → ℂ) (z a : ℂ) (k : ℕ) :
    primeCoefficientShiftedRotatedJet c a k -
        algebraMap ℂ (ArithmeticFunction ℂ) z *
          primeCoefficientShiftedRotatedJet d a k =
      arithmeticOfPrimeColumn (fun p =>
        (c p - z * d p) * primeShiftFactor a p * rotatedPrimeLogClock p ^ k) := by
  rw [← Algebra.smul_def]
  ext n
  change primeCoefficientShiftedRotatedJet c a k n -
      z * primeCoefficientShiftedRotatedJet d a k n =
    arithmeticOfPrimeColumn (fun p =>
      (c p - z * d p) * primeShiftFactor a p * rotatedPrimeLogClock p ^ k) n
  by_cases hn : n.Prime
  · let p : Nat.Primes := ⟨n, hn⟩
    rw [show primeCoefficientShiftedRotatedJet c a k n =
        c p * primeShiftFactor a p * rotatedPrimeLogClock p ^ k by
      exact arithmeticOfPrimeColumn_apply_prime _ p]
    rw [show primeCoefficientShiftedRotatedJet d a k n =
        d p * primeShiftFactor a p * rotatedPrimeLogClock p ^ k by
      exact arithmeticOfPrimeColumn_apply_prime _ p]
    rw [arithmeticOfPrimeColumn_apply_prime _ p]
    ring
  · simp [primeCoefficientShiftedRotatedJet, arithmeticOfPrimeColumn, hn]

/-- A finite projective tail residual contributes only a base-field correction at every shifted
differential jet. -/
theorem primeCoefficientShiftCarrier_projectiveResidual_jet_mem_base
    (c d : Nat.Primes → ℂ) (z : ℂ)
    (hsupport : {p | c p - z * d p ≠ 0}.Finite) (a : ℂ) (k : ℕ) :
    ∃ b : finitePrimeRationalCoefficientField,
      GaloisForLFunctions.differentialJet k (primeCoefficientShiftCarrier c a) -
          algebraMap ℂ arithmeticFunctionRationalCoordinateField z *
            GaloisForLFunctions.differentialJet k (primeCoefficientShiftCarrier d a) =
        algebraMap finitePrimeRationalCoefficientField
          arithmeticFunctionRationalCoordinateField b := by
  let coeff : Nat.Primes → ℂ := fun p =>
    (c p - z * d p) * primeShiftFactor a p * rotatedPrimeLogClock p ^ k
  have hcoeff : {p | coeff p ≠ 0}.Finite := by
    apply hsupport.subset
    intro p hp
    simp only [Set.mem_setOf_eq, coeff] at hp ⊢
    intro hzero
    exact hp (by rw [hzero, zero_mul, zero_mul])
  let kF : finitePrimeCoefficientField :=
    ⟨algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField
      (arithmeticOfPrimeColumn coeff),
      (arithmeticOfPrimeColumn_mem_finitePrimeCoefficientField_iff coeff).2 hcoeff⟩
  let b : finitePrimeRationalCoefficientField :=
    algebraMap finitePrimeCoefficientField finitePrimeRationalCoefficientField kF
  refine ⟨b, ?_⟩
  rw [differentialJet_primeCoefficientShiftCarrier,
    differentialJet_primeCoefficientShiftCarrier,
    IsScalarTower.algebraMap_apply ℂ arithmeticFunctionFractionField
      arithmeticFunctionRationalCoordinateField,
    ← map_mul, ← map_sub,
    IsScalarTower.algebraMap_apply ℂ (ArithmeticFunction ℂ)
      arithmeticFunctionFractionField,
    ← map_mul, ← map_sub,
    primeCoefficientShiftedRotatedJet_sub_smul_eq_arithmeticOfPrimeColumn]
  change algebraMap arithmeticFunctionFractionField
      arithmeticFunctionRationalCoordinateField kF.1 =
    algebraMap finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField b
  exact (finitePrimeRationalCoefficientFieldToFormalRatFunc_algebraMap kF).symm

private theorem complexConstant_mem_primeCoefficientDifferentialAdjoin
    {ι : Type*} (x : ι → arithmeticFunctionRationalCoordinateField) (z : ℂ) :
    algebraMap ℂ arithmeticFunctionRationalCoordinateField z ∈
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range x) := by
  rw [IsScalarTower.algebraMap_apply ℂ finitePrimeRationalCoefficientField
    arithmeticFunctionRationalCoordinateField]
  exact IntermediateField.algebraMap_mem _
    (algebraMap ℂ finitePrimeRationalCoefficientField z)

theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_le_of_projectiveResidual
    (c d : Nat.Primes → ℂ) (z : ℂ)
    (hsupport : {p | c p - z * d p ≠ 0}.Finite) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) ≤
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette d)) := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro y ⟨x, ⟨a, rfl⟩, k, rfl⟩
  obtain ⟨b, hbase⟩ :=
    primeCoefficientShiftCarrier_projectiveResidual_jet_mem_base
      c d z hsupport (a : ℂ) k
  rw [show GaloisForLFunctions.differentialJet k
        (primeCoefficientNaturalShiftPalette c a) =
      (GaloisForLFunctions.differentialJet k
          (primeCoefficientNaturalShiftPalette c a) -
        algebraMap ℂ arithmeticFunctionRationalCoordinateField z *
          GaloisForLFunctions.differentialJet k
            (primeCoefficientNaturalShiftPalette d a)) +
        algebraMap ℂ arithmeticFunctionRationalCoordinateField z *
          GaloisForLFunctions.differentialJet k
            (primeCoefficientNaturalShiftPalette d a) by ring]
  change GaloisForLFunctions.differentialJet k
      (primeCoefficientShiftCarrier c (a : ℂ)) -
        algebraMap ℂ arithmeticFunctionRationalCoordinateField z *
          GaloisForLFunctions.differentialJet k
            (primeCoefficientShiftCarrier d (a : ℂ)) +
      algebraMap ℂ arithmeticFunctionRationalCoordinateField z *
        GaloisForLFunctions.differentialJet k
          (primeCoefficientShiftCarrier d (a : ℂ)) ∈ _
  rw [hbase]
  apply IntermediateField.add_mem
  · exact IntermediateField.algebraMap_mem _ b
  · apply IntermediateField.mul_mem
    · exact complexConstant_mem_primeCoefficientDifferentialAdjoin _ z
    · exact GaloisForLFunctions.differentialJet_mem_differentialAdjoin _
        (Set.mem_range_self a) k

/-- Projectively equal coefficient tails generate the same embedded differential field. -/
theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_of_projectivelyEquivalent
    {c d : Nat.Primes → ℂ}
    (h : PrimeCoefficientTailProjectivelyEquivalent c d) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) =
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette d)) := by
  obtain ⟨z, hz, hsupport⟩ := h
  apply le_antisymm
  · exact primeCoefficientNaturalShiftPalette_differentialAdjoin_le_of_projectiveResidual
      c d z hsupport
  · apply primeCoefficientNaturalShiftPalette_differentialAdjoin_le_of_projectiveResidual
      d c z⁻¹
    apply hsupport.subset
    intro p hp
    simp only [Set.mem_setOf_eq] at hp ⊢
    intro hzero
    apply hp
    apply mul_left_cancel₀ (neg_ne_zero.mpr hz)
    calc
      -z * (d p - z⁻¹ * c p) = c p - z * d p := by
        field_simp [hz]
        ring
      _ = 0 := hzero
      _ = -z * 0 := by ring

theorem primeCoefficientTailProjectivelyEquivalent_of_tailZero
    {c d : Nat.Primes → ℂ}
    (hc : PrimeCoefficientTailZero c) (hd : PrimeCoefficientTailZero d) :
    PrimeCoefficientTailProjectivelyEquivalent c d := by
  refine ⟨1, one_ne_zero, ?_⟩
  apply (hc.union hd).subset
  intro p hp
  simp only [Set.mem_setOf_eq, Set.mem_union] at hp ⊢
  by_contra hzero
  push Not at hzero
  apply hp
  rw [hzero.1, hzero.2]
  simp

/-- The zero coefficient palette generates only the coefficient field. -/
theorem zeroPrimeCoefficientNaturalShiftPalette_differentialAdjoin :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette (fun _ => 0))) = ⊥ := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro y ⟨x, ⟨a, rfl⟩, k, rfl⟩
    simp only [primeCoefficientNaturalShiftPalette]
    rw [differentialJet_primeCoefficientShiftCarrier]
    have hjet : primeCoefficientShiftedRotatedJet (fun _ => 0) (a : ℂ) k = 0 := by
      ext n
      simp [primeCoefficientShiftedRotatedJet, arithmeticOfPrimeColumn]
    rw [hjet]
    rw [_root_.map_zero
      (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField),
      _root_.map_zero
        (algebraMap arithmeticFunctionFractionField
          arithmeticFunctionRationalCoordinateField)]
    exact IntermediateField.zero_mem _
  · exact bot_le

theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_bot_of_tailZero
    {c : Nat.Primes → ℂ} (hc : PrimeCoefficientTailZero c) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) = ⊥ := by
  rw [← zeroPrimeCoefficientNaturalShiftPalette_differentialAdjoin]
  exact primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_of_projectivelyEquivalent
    (primeCoefficientTailProjectivelyEquivalent_of_tailZero hc (by simp [PrimeCoefficientTailZero]))

/-- A nonempty differentially independent family generates strictly more than the base field. -/
theorem differentialIndependent_differentialAdjoin_ne_bot
    {F K ι : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    [Nonempty ι] (x : ι → K)
    (hx : GaloisForLFunctions.DifferentialIndependent F x) :
    GaloisForLFunctions.differentialAdjoin F (Set.range x) ≠ ⊥ := by
  intro hbot
  let i := Classical.arbitrary ι
  have hi : x i ∈ GaloisForLFunctions.differentialAdjoin F (Set.range x) :=
    GaloisForLFunctions.subset_differentialAdjoin F _ (Set.mem_range_self i)
  rw [hbot, IntermediateField.mem_bot] at hi
  obtain ⟨b, hb⟩ := hi
  have ht := hx.algebraicIndependent.transcendental i
  apply ht
  rw [← hb]
  exact isAlgebraic_algebraMap b

theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_ne_bot
    (c : Nat.Primes → ℂ)
    (hrange : (Set.range (coefficientPattern (fun _ : Unit => c))).Finite)
    (hc : ¬ PrimeCoefficientTailZero c) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) ≠ ⊥ := by
  have htail : TailCoefficientIndependent (fun _ : Unit => c) :=
    (tailCoefficientIndependent_unit_iff c).mpr hc
  have hfamily :=
    (primeCoefficientNaturalShiftPalette_differentialIndependent_iff
      (fun _ : Unit => c) hrange).mpr htail
  have hsingle := hfamily.comp (fun n : ℕ => ((), n)) (by
    intro m n h
    exact congrArg Prod.snd h)
  apply differentialIndependent_differentialAdjoin_ne_bot
    (primeCoefficientNaturalShiftPalette c)
  simpa only using hsingle

theorem coefficientPattern_unit_range_finite_of_range_finite
    {c : Nat.Primes → ℂ} (hc : (Set.range c).Finite) :
    (Set.range (coefficientPattern (fun _ : Unit => c))).Finite := by
  have himage := hc.image (fun z : ℂ => fun _ : Unit => z)
  apply himage.subset
  rintro q ⟨p, rfl⟩
  refine ⟨c p, ⟨p, rfl⟩, ?_⟩
  funext u
  rcases u with ⟨⟩
  rfl

theorem coefficientPattern_pair_range_finite_of_ranges_finite
    {c d : Nat.Primes → ℂ}
    (hc : (Set.range c).Finite) (hd : (Set.range d).Finite) :
    (Set.range (coefficientPattern (primeCoefficientPair c d))).Finite := by
  have hprod : (Set.range c ×ˢ Set.range d).Finite := hc.prod hd
  have himage := hprod.image (fun z : ℂ × ℂ => fun b : Bool => if b then z.2 else z.1)
  apply himage.subset
  rintro q ⟨p, rfl⟩
  refine ⟨(c p, d p), ⟨⟨p, rfl⟩, ⟨p, rfl⟩⟩, ?_⟩
  funext b
  cases b <;> rfl

/-- **Exact projective field moduli.** For two finite-range prime coefficient columns, equality of
the embedded differential fields generated by their complete natural-shift palettes is equivalent
to equality of their tail classes up to one nonzero complex scalar.  The zero tail class forms its
own orbit. -/
theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_iff
    (c d : Nat.Primes → ℂ)
    (hcrange : (Set.range (coefficientPattern (fun _ : Unit => c))).Finite)
    (hdrange : (Set.range (coefficientPattern (fun _ : Unit => d))).Finite)
    (hpairrange : (Set.range (coefficientPattern (primeCoefficientPair c d))).Finite) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) =
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette d)) ↔
      PrimeCoefficientTailProjectivelyEquivalent c d := by
  constructor
  · intro heq
    by_contra hprojective
    by_cases hc : PrimeCoefficientTailZero c
    · have hd : ¬ PrimeCoefficientTailZero d := by
        intro hd
        exact hprojective
          (primeCoefficientTailProjectivelyEquivalent_of_tailZero hc hd)
      have hcbase :=
        primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_bot_of_tailZero hc
      have hdnonbase :=
        primeCoefficientNaturalShiftPalette_differentialAdjoin_ne_bot d hdrange hd
      apply hdnonbase
      rw [← heq, hcbase]
    · by_cases hd : PrimeCoefficientTailZero d
      · have hcbase :=
          primeCoefficientNaturalShiftPalette_differentialAdjoin_ne_bot c hcrange hc
        have hdbase :=
          primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_bot_of_tailZero hd
        apply hcbase
        rw [heq, hdbase]
      · have hnotdep : ¬ PrimeCoefficientTailPairDependent c d := by
          intro hdep
          exact hprojective
            ((primeCoefficientTailPairDependent_iff_projectivelyEquivalent c d hc hd).mp hdep)
        have htail : TailCoefficientIndependent (primeCoefficientPair c d) :=
          (primeCoefficientPair_tailIndependent_iff_not_pairDependent c d).mpr hnotdep
        have hpair :=
          (primeCoefficientNaturalShiftPalette_differentialIndependent_iff
            (primeCoefficientPair c d) hpairrange).mpr htail
        let x : ℕ → arithmeticFunctionRationalCoordinateField :=
          primeCoefficientNaturalShiftPalette c
        let y : ℕ → arithmeticFunctionRationalCoordinateField :=
          primeCoefficientNaturalShiftPalette d
        let f : ℕ ⊕ ℕ → Bool × ℕ := fun q =>
          Sum.elim (fun n => (false, n)) (fun n => (true, n)) q
        have hf : Function.Injective f := by
          intro u v huv
          rcases u with n | n <;> rcases v with m | m
          · exact congrArg Sum.inl (congrArg Prod.snd huv)
          · simp [f] at huv
          · simp [f] at huv
          · exact congrArg Sum.inr (congrArg Prod.snd huv)
        have hjoint := hpair.comp f hf
        have hfun :
            ((fun p : Bool × ℕ => primeCoefficientNaturalShiftPalette
              (primeCoefficientPair c d p.1) p.2) ∘ f) =
              Sum.elim x y := by
          funext q
          rcases q with n | n <;> rfl
        rw [hfun] at hjoint
        exact (GaloisForLFunctions.differentialIndependent_sum_unequal_differentialAdjoin
          (F := finitePrimeRationalCoefficientField) x y hjoint) heq
  · exact primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_of_projectivelyEquivalent

/-- The exact field classifier in its intrinsic finite-range form. -/
theorem primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_iff_of_finiteRange
    (c d : Nat.Primes → ℂ)
    (hc : (Set.range c).Finite) (hd : (Set.range d).Finite) :
    GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette c)) =
      GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
        (Set.range (primeCoefficientNaturalShiftPalette d)) ↔
      PrimeCoefficientTailProjectivelyEquivalent c d :=
  primeCoefficientNaturalShiftPalette_differentialAdjoin_eq_iff c d
    (coefficientPattern_unit_range_finite_of_range_finite hc)
    (coefficientPattern_unit_range_finite_of_range_finite hd)
    (coefficientPattern_pair_range_finite_of_ranges_finite hc hd)

end

