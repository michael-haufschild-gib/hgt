import GaloisForLFunctions.HTGeometry.AnalyticJetFieldBridge
import GaloisForLFunctions.HTGeometry.FiniteAlgebraicStateBoundary
import GaloisForLFunctions.HTGeometry.DigammaGammaLocalHypertranscendence
import GaloisForLFunctions.HTGeometry.FiniteJetIndistinguishability
import GaloisForLFunctions.HTGeometry.EntireJetEvaluation

/-!
# Local inversion and differential algebraicity

A germ and its local analytic inverse generate the same differential information.  Concretely, if
`F` and `G` are mutually inverse analytic maps between open sets and `G` satisfies an algebraic
differential equation, then so does `F`.

The mechanism is a transcendence count rather than an explicit elimination.  The composites
`F⁽ᵏ⁾ ∘ G` obey `(F⁽ᵏ⁾ ∘ G)′ = (F⁽ᵏ⁺¹⁾ ∘ G) · G′`, so they all lie in the differential field
generated by `G` over the rational coordinate field.  A differentially algebraic generator makes
that field of finite transcendence degree, while a hypertranscendental `F` would make the
composites algebraically independent over `ℂ`, an infinite independent family inside a
finite-degree field.

* `differentiallyAlgebraicOn_of_localInverse` — the inversion closure;
* `hypertranscendentalOn_localInverse_of_hypertranscendentalOn` — its contrapositive.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

variable {U : Set ℂ}

/-! ## Constant germs and pointwise polynomial relations -/

/-- The constants, as analytic germs on `U`. -/
def constToAnalytic (U : Set ℂ) : ℂ →+* analyticSubring U :=
  RingHom.codRestrict ((Germ.coeRingHom (Filter.principal U)).comp (Pi.constRingHom ℂ ℂ))
    (analyticSubring U) fun c => ⟨fun _ => c, analyticOnNhd_const, rfl⟩

@[simp]
theorem constToAnalytic_coe (c : ℂ) :
    ((constToAnalytic U c : analyticSubring U) : Germ (Filter.principal U) ℂ)
      = ((fun _ : ℂ => c : ℂ → ℂ) : Germ (Filter.principal U) ℂ) := rfl

@[simp]
theorem analyticFunctionElement_coe (f : ℂ → ℂ) (hf : AnalyticOnNhd ℂ f U) :
    ((analyticFunctionElement f hf : analyticSubring U) : Germ (Filter.principal U) ℂ)
      = ((f : ℂ → ℂ) : Germ (Filter.principal U) ℂ) := rfl

/-- Constant-coefficient evaluation on a family of analytic germs is the germ of the pointwise
evaluation. -/
theorem eval₂_analyticFunctionElement_coe {ι : Type*} (f : ι → ℂ → ℂ)
    (hf : ∀ i, AnalyticOnNhd ℂ (f i) U) (q : MvPolynomial ι ℂ) :
    ((MvPolynomial.eval₂ (constToAnalytic U)
        (fun i => analyticFunctionElement (f i) (hf i)) q : analyticSubring U) :
          Germ (Filter.principal U) ℂ)
      = ((fun z => MvPolynomial.eval (fun i => f i z) q : ℂ → ℂ) :
          Germ (Filter.principal U) ℂ) := by
  induction q using MvPolynomial.induction_on with
  | C c =>
      rw [MvPolynomial.eval₂_C, constToAnalytic_coe]
      apply Germ.coe_eq.mpr
      exact Filter.Eventually.of_forall fun z => by simp
  | add p q hp hq =>
      rw [MvPolynomial.eval₂_add]
      change
        ((MvPolynomial.eval₂ (constToAnalytic U)
          (fun i => analyticFunctionElement (f i) (hf i)) p : analyticSubring U) :
            Germ (Filter.principal U) ℂ) +
        ((MvPolynomial.eval₂ (constToAnalytic U)
          (fun i => analyticFunctionElement (f i) (hf i)) q : analyticSubring U) :
            Germ (Filter.principal U) ℂ) = _
      rw [hp, hq, ← Germ.coe_add]
      apply Germ.coe_eq.mpr
      exact Filter.Eventually.of_forall fun z => by simp
  | mul_X p i hp =>
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
      change
        ((MvPolynomial.eval₂ (constToAnalytic U)
          (fun i => analyticFunctionElement (f i) (hf i)) p : analyticSubring U) :
            Germ (Filter.principal U) ℂ) *
          ((analyticFunctionElement (f i) (hf i) : analyticSubring U) :
            Germ (Filter.principal U) ℂ) = _
      rw [hp, analyticFunctionElement_coe, ← Germ.coe_mul]
      apply Germ.coe_eq.mpr
      exact Filter.Eventually.of_forall fun z => by simp

/-- A constant-coefficient relation holds among analytic germs exactly when it holds pointwise. -/
theorem eval₂_analyticFunctionElement_eq_zero_iff {ι : Type*} (f : ι → ℂ → ℂ)
    (hf : ∀ i, AnalyticOnNhd ℂ (f i) U) (q : MvPolynomial ι ℂ) :
    MvPolynomial.eval₂ (constToAnalytic U) (fun i => analyticFunctionElement (f i) (hf i)) q = 0
      ↔ ∀ z ∈ U, MvPolynomial.eval (fun i => f i z) q = 0 := by
  constructor
  · intro h
    have hval := congrArg Subtype.val h
    rw [ZeroMemClass.coe_zero] at hval
    rw [show (Subtype.val (MvPolynomial.eval₂ (constToAnalytic U)
        (fun i => analyticFunctionElement (f i) (hf i)) q) :
          Germ (Filter.principal U) ℂ)
        = ((fun z => MvPolynomial.eval (fun i => f i z) q : ℂ → ℂ) :
            Germ (Filter.principal U) ℂ) from
      eval₂_analyticFunctionElement_coe f hf q, ← Germ.coe_zero, Germ.coe_eq] at hval
    intro z hz
    exact eventually_principal.mp hval z hz
  · intro h
    apply Subtype.ext
    rw [ZeroMemClass.coe_zero]
    rw [show (Subtype.val (MvPolynomial.eval₂ (constToAnalytic U)
        (fun i => analyticFunctionElement (f i) (hf i)) q) :
          Germ (Filter.principal U) ℂ)
        = ((fun z => MvPolynomial.eval (fun i => f i z) q : ℂ → ℂ) :
            Germ (Filter.principal U) ℂ) from
      eval₂_analyticFunctionElement_coe f hf q, ← Germ.coe_zero, Germ.coe_eq]
    exact eventually_principal.mpr fun z hz => h z hz

/-! ## Jets of a germ read along a local inverse -/

section InverseJets

variable {V : Set ℂ} {F G : ℂ → ℂ}

/-- The `k`-th derivative of `F`, read along `G`. -/
def inverseJet (F G : ℂ → ℂ) (k : ℕ) : ℂ → ℂ := fun w => iteratedDeriv k F (G w)

theorem analyticOnNhd_inverseJet (hF : AnalyticOnNhd ℂ F U) (hG : AnalyticOnNhd ℂ G V)
    (hGV : Set.MapsTo G V U) (k : ℕ) : AnalyticOnNhd ℂ (inverseJet F G k) V :=
  (analyticOnNhd_iteratedDeriv hF k).comp hG hGV

/-- The chain rule in jet form: differentiating a jet read along `G` advances the jet and
multiplies by `G′`. -/
theorem deriv_inverseJet (hF : AnalyticOnNhd ℂ F U) (hG : AnalyticOnNhd ℂ G V)
    (hGV : Set.MapsTo G V U) (k : ℕ) {w : ℂ} (hw : w ∈ V) :
    deriv (inverseJet F G k) w = inverseJet F G (k + 1) w * deriv G w := by
  have hd1 : DifferentiableAt ℂ (iteratedDeriv k F) (G w) :=
    ((analyticOnNhd_iteratedDeriv hF k) (G w) (hGV hw)).differentiableAt
  have hd2 : DifferentiableAt ℂ G w := (hG w hw).differentiableAt
  have h := deriv_comp (h₂ := iteratedDeriv k F) (h := G) w hd1 hd2
  rw [show inverseJet F G k = iteratedDeriv k F ∘ G from rfl, h]
  rw [inverseJet, iteratedDeriv_succ]

/-- A left inverse forces a nonvanishing derivative. -/
theorem deriv_ne_zero_of_leftInverse (hVo : IsOpen V) (hF : AnalyticOnNhd ℂ F U)
    (hG : AnalyticOnNhd ℂ G V) (hGV : Set.MapsTo G V U)
    (hFG : ∀ w ∈ V, F (G w) = w) {w : ℂ} (hw : w ∈ V) : deriv G w ≠ 0 := by
  intro hzero
  have hd1 : DifferentiableAt ℂ F (G w) := (hF (G w) (hGV hw)).differentiableAt
  have hd2 : DifferentiableAt ℂ G w := (hG w hw).differentiableAt
  have heq : (fun u => F (G u)) =ᶠ[nhds w] fun u : ℂ => u :=
    Filter.eventuallyEq_of_mem (hVo.mem_nhds hw) fun u hu => hFG u hu
  have hderiv : deriv (fun u => F (G u)) w = deriv (fun u : ℂ => u) w := heq.deriv_eq
  have hchain : deriv (fun u => F (G u)) w = deriv F (G w) * deriv G w :=
    deriv_comp (h₂ := F) (h := G) w hd1 hd2
  rw [hchain, hzero, mul_zero] at hderiv
  simp at hderiv

theorem inverseJet_zero_eqOn (hFG : ∀ w ∈ V, F (G w) = w) :
    Set.EqOn (inverseJet F G 0) (fun w : ℂ => w) V := by
  intro w hw
  rw [inverseJet, iteratedDeriv_zero]
  exact hFG w hw

end InverseJets

/-! ## Analytic functions inside the meromorphic differential field -/

section MeroLayer

variable {V : Set ℂ}

theorem analyticMeroElement_congr_inverseJet {f h : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f V)
    (hh : AnalyticOnNhd ℂ h V) (heq : Set.EqOn f h V) :
    analyticMeroElement f hf = analyticMeroElement h hh := by
  unfold analyticMeroElement
  congr 1
  apply Subtype.ext
  change ((f : ℂ → ℂ) : Germ (Filter.principal V) ℂ)
    = ((h : ℂ → ℂ) : Germ (Filter.principal V) ℂ)
  rw [Germ.coe_eq]
  exact eventually_principal.mpr fun z hz => heq hz

theorem analyticMeroElement_ne_zero (hVo : IsOpen V) (hVc : IsPreconnected V) (hVne : V.Nonempty)
    {f : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f V) {z : ℂ} (hz : z ∈ V) (hfz : f z ≠ 0) :
    letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
    analyticMeroElement f hf ≠ 0 := by
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  intro h0
  have hzero : analyticFunctionElement f hf = 0 := by
    apply IsFractionRing.injective (analyticSubring V) (meroField V)
    rw [← analyticMeroElement, h0, map_zero]
  have hgerm : ((f : ℂ → ℂ) : Germ (Filter.principal V) ℂ) = 0 := congrArg Subtype.val hzero
  rw [← Germ.coe_zero, Germ.coe_eq] at hgerm
  exact hfz (eventually_principal.mp hgerm z hz)

theorem deriv_analyticMeroElement_inverseJet (hVo : IsOpen V) (hVc : IsPreconnected V) (hVne : V.Nonempty)
    {f : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f V) :
    letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
    letI := meroFieldDifferential hVo hVc hVne
    (analyticMeroElement f hf)′ = analyticMeroElement (deriv f) hf.deriv := by
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  letI := meroFieldDifferential hVo hVc hVne
  unfold analyticMeroElement
  rw [meroFieldDifferential_algebraMap hVo hVc hVne]
  congr 1

/-- The coordinate function is the image of the rational coordinate. -/
theorem analyticMeroElement_id (hVo : IsOpen V) (hVc : IsPreconnected V) (hVne : V.Nonempty)
    (hVinf : V.Infinite) :
    letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
    analyticMeroElement (fun w : ℂ => w) (analyticOnNhd_id (𝕜 := ℂ) (s := V))
      = ratfuncToMero V hVo hVc hVne hVinf RatFunc.X := by
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  rw [← RatFunc.algebraMap_X, ratfuncToMero_algebraMap_polynomial V hVo hVc hVne hVinf,
    polyToMero, RingHom.comp_apply, analyticMeroElement]
  congr 1
  apply Subtype.ext
  change ((fun w : ℂ => w : ℂ → ℂ) : Germ (Filter.principal V) ℂ)
    = ((fun z => Polynomial.eval z (Polynomial.X : Polynomial ℂ) : ℂ → ℂ) :
        Germ (Filter.principal V) ℂ)
  rw [Germ.coe_eq]
  exact Filter.Eventually.of_forall fun z => by simp

/-- Constants embed as constant germs. -/
theorem algebraMap_complex_meroField (hVo : IsOpen V) (hVc : IsPreconnected V) (hVne : V.Nonempty)
    (hVinf : V.Infinite) (c : ℂ) :
    letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
    ratfuncToMero V hVo hVc hVne hVinf (algebraMap ℂ (RatFunc ℂ) c)
      = algebraMap (analyticSubring V) (meroField V) (constToAnalytic V c) := by
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  have hC : algebraMap ℂ (RatFunc ℂ) c
      = algebraMap (Polynomial ℂ) (RatFunc ℂ) (Polynomial.C c) := rfl
  rw [hC, ratfuncToMero_algebraMap_polynomial V hVo hVc hVne hVinf, polyToMero,
    RingHom.comp_apply]
  congr 1
  apply Subtype.ext
  change ((fun z => Polynomial.eval z (Polynomial.C c) : ℂ → ℂ) : Germ (Filter.principal V) ℂ)
    = ((fun _ : ℂ => c : ℂ → ℂ) : Germ (Filter.principal V) ℂ)
  rw [Germ.coe_eq]
  exact Filter.Eventually.of_forall fun z => by simp

end MeroLayer

/-! ## The inversion closure -/

section Inversion

variable {V : Set ℂ}

/-- A constant-coefficient relation among analytic functions holds in the meromorphic field
exactly when it holds pointwise. -/
theorem aeval_analyticMeroElement_eq_zero_iff {ι : Type*} (hVo : IsOpen V)
    (hVc : IsPreconnected V) (hVne : V.Nonempty) (hVinf : V.Infinite) (f : ι → ℂ → ℂ)
    (hf : ∀ i, AnalyticOnNhd ℂ (f i) V) (q : MvPolynomial ι ℂ) :
    letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
    letI : Algebra ℂ (meroField V) :=
      ((ratfuncToMero V hVo hVc hVne hVinf).comp (algebraMap ℂ (RatFunc ℂ))).toAlgebra
    (MvPolynomial.aeval (fun i => analyticMeroElement (f i) (hf i)) q = 0
      ↔ ∀ z ∈ V, MvPolynomial.eval (fun i => f i z) q = 0) := by
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  letI : Algebra ℂ (meroField V) :=
    ((ratfuncToMero V hVo hVc hVne hVinf).comp (algebraMap ℂ (RatFunc ℂ))).toAlgebra
  have hmap : (algebraMap ℂ (meroField V))
      = (algebraMap (analyticSubring V) (meroField V)).comp (constToAnalytic V) := by
    ext c
    exact algebraMap_complex_meroField hVo hVc hVne hVinf c
  have hkey : MvPolynomial.aeval (fun i => analyticMeroElement (f i) (hf i)) q
      = algebraMap (analyticSubring V) (meroField V)
          (MvPolynomial.eval₂ (constToAnalytic V)
            (fun i => analyticFunctionElement (f i) (hf i)) q) := by
    rw [MvPolynomial.aeval_def, hmap, MvPolynomial.hom_eval₂]
    rfl
  rw [hkey]
  constructor
  · intro h
    have h0 : MvPolynomial.eval₂ (constToAnalytic V)
        (fun i => analyticFunctionElement (f i) (hf i)) q = 0 := by
      apply IsFractionRing.injective (analyticSubring V) (meroField V)
      rw [h, map_zero]
    exact (eval₂_analyticFunctionElement_eq_zero_iff f hf q).mp h0
  · intro h
    rw [(eval₂_analyticFunctionElement_eq_zero_iff f hf q).mpr h, map_zero]

theorem trdeg_ratFunc_complex_lt_aleph0 :
    Algebra.trdeg ℂ (RatFunc ℂ) < Cardinal.aleph0 := by
  have halg : Algebra.IsAlgebraic (Polynomial ℂ) (RatFunc ℂ) := by
    constructor
    intro x
    refine ⟨Polynomial.C x.denom * Polynomial.X - Polynomial.C x.num, ?_, ?_⟩
    · intro h
      have hc := congrArg (fun p => Polynomial.coeff p 1) h
      simp at hc
      exact (RatFunc.denom_ne_zero x) hc
    · have hx := RatFunc.num_div_denom x
      have hden : algebraMap (Polynomial ℂ) (RatFunc ℂ) x.denom ≠ 0 := by
        simpa using RatFunc.denom_ne_zero x
      have hkey : algebraMap (Polynomial ℂ) (RatFunc ℂ) x.num
          = x * algebraMap (Polynomial ℂ) (RatFunc ℂ) x.denom := (div_eq_iff hden).mp hx
      simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, hkey]
      ring
  have h1 : Algebra.trdeg ℂ (Polynomial ℂ) = 1 := Polynomial.trdeg_of_isDomain
  have h2 : Algebra.trdeg (Polynomial ℂ) (RatFunc ℂ) = 0 := trdeg_eq_zero
  have h3 := trdeg_add_eq ℂ (Polynomial ℂ) (A := RatFunc ℂ)
  rw [← h3, h1, h2]
  simp

/-- **Differential algebraicity is inherited by a local analytic inverse.**  If `F` and `G` are
mutually inverse analytic maps between open sets and `G` satisfies an algebraic differential
equation on its domain, then `F` satisfies one on its own. -/
theorem differentiallyAlgebraicOn_of_localInverse {U V : Set ℂ}
    (hVo : IsOpen V) (hVc : IsPreconnected V) (hVne : V.Nonempty) (hVinf : V.Infinite)
    {F G : ℂ → ℂ} (hF : AnalyticOnNhd ℂ F U) (hG : AnalyticOnNhd ℂ G V)
    (hGV : Set.MapsTo G V U) (hFV : Set.MapsTo F U V)
    (hFG : ∀ w ∈ V, F (G w) = w) (hGF : ∀ z ∈ U, G (F z) = z)
    (hGDA : DifferentiallyAlgebraicOn G V) :
    DifferentiallyAlgebraicOn F U := by
  classical
  by_contra hFnot
  letI := Bottcher.isDomain_analyticSubring V hVo hVc hVne
  letI : Algebra (RatFunc ℂ) (meroField V) := (ratfuncToMero V hVo hVc hVne hVinf).toAlgebra
  letI : Differential (RatFunc ℂ) := GaloisForLFunctions.ratFuncCoordinateDifferential
  letI := meroFieldDifferential hVo hVc hVne
  letI : DifferentialAlgebra (RatFunc ℂ) (meroField V) :=
    meroFieldRatFuncDifferentialAlgebra hVo hVc hVne hVinf
  letI : CharZero (meroField V) :=
    charZero_of_injective_algebraMap (algebraMap (RatFunc ℂ) (meroField V)).injective
  letI : Algebra ℂ (meroField V) :=
    ((ratfuncToMero V hVo hVc hVne hVinf).comp (algebraMap ℂ (RatFunc ℂ))).toAlgebra
  haveI : IsScalarTower ℂ (RatFunc ℂ) (meroField V) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  -- the jet family read along `G`
  set yFun : ℕ → (ℂ → ℂ) := fun k => Nat.casesOn k G (fun j => inverseJet F G j) with hyFundef
  have hyA : ∀ k, AnalyticOnNhd ℂ (yFun k) V := by
    intro k
    cases k with
    | zero => exact hG
    | succ j => exact analyticOnNhd_inverseJet hF hG hGV j
  set y : ℕ → meroField V := fun k => analyticMeroElement (yFun k) (hyA k) with hydef
  -- the differential field generated by `G`
  set g : meroField V := analyticMeroElement G hG with hgdef
  set A : IntermediateField (RatFunc ℂ) (meroField V) :=
    differentialAdjoin (RatFunc ℂ) ({g} : Set (meroField V)) with hAdef
  have hgA : g ∈ A := subset_differentialAdjoin (RatFunc ℂ) _ rfl
  have hAclosed : DerivationClosed A := derivationClosed_differentialAdjoin (RatFunc ℂ) _
  set dG : meroField V := analyticMeroElement (deriv G) hG.deriv with hdGdef
  have hgderiv : g′ = dG := deriv_analyticMeroElement_inverseJet hVo hVc hVne hG
  have hdGA : dG ∈ A := hgderiv ▸ hAclosed hgA
  have hdGne : dG ≠ 0 := by
    obtain ⟨w, hw⟩ := id hVne
    exact analyticMeroElement_ne_zero hVo hVc hVne hG.deriv hw
      (deriv_ne_zero_of_leftInverse hVo hF hG hGV hFG hw)
  -- every jet read along `G` lies in that field
  have hsA : ∀ k, analyticMeroElement (inverseJet F G k)
      (analyticOnNhd_inverseJet hF hG hGV k) ∈ A := by
    intro k
    induction k with
    | zero =>
        have h0 : analyticMeroElement (inverseJet F G 0)
            (analyticOnNhd_inverseJet hF hG hGV 0)
            = ratfuncToMero V hVo hVc hVne hVinf RatFunc.X := by
          rw [analyticMeroElement_congr_inverseJet (analyticOnNhd_inverseJet hF hG hGV 0)
            (analyticOnNhd_id (𝕜 := ℂ) (s := V)) (inverseJet_zero_eqOn hFG)]
          exact analyticMeroElement_id hVo hVc hVne hVinf
        rw [h0]
        exact A.algebraMap_mem RatFunc.X
    | succ k ih =>
        have hderiv : (analyticMeroElement (inverseJet F G k)
              (analyticOnNhd_inverseJet hF hG hGV k))′
            = analyticMeroElement (inverseJet F G (k + 1))
                (analyticOnNhd_inverseJet hF hG hGV (k + 1)) * dG := by
          rw [deriv_analyticMeroElement_inverseJet hVo hVc hVne
            (analyticOnNhd_inverseJet hF hG hGV k)]
          rw [analyticMeroElement_congr_inverseJet (analyticOnNhd_inverseJet hF hG hGV k).deriv
            (((analyticOnNhd_inverseJet hF hG hGV (k + 1)).mul hG.deriv))
            (fun w hw => deriv_inverseJet hF hG hGV k hw)]
          exact analyticMeroElement_mul _ _
        have hstep : analyticMeroElement (inverseJet F G (k + 1))
            (analyticOnNhd_inverseJet hF hG hGV (k + 1))
            = (analyticMeroElement (inverseJet F G k)
                (analyticOnNhd_inverseJet hF hG hGV k))′ * dG⁻¹ := by
          rw [hderiv, mul_assoc, mul_inv_cancel₀ hdGne, mul_one]
        rw [hstep]
        exact A.mul_mem (hAclosed ih) (A.inv_mem hdGA)
  have hyAmem : ∀ k, y k ∈ A := by
    intro k
    cases k with
    | zero => exact hgA
    | succ j => exact hsA j
  -- a hypertranscendental `F` makes the family algebraically independent
  have hindep : AlgebraicIndependent ℂ y := by
    rw [algebraicIndependent_iff]
    intro p hp
    by_contra hp0
    have hpt : ∀ w ∈ V, MvPolynomial.eval (fun k => yFun k w) p = 0 :=
      (aeval_analyticMeroElement_eq_zero_iff hVo hVc hVne hVinf yFun hyA p).mp hp
    set n : ℕ := p.vars.sup id with hndef
    have hsub : ↑p.vars ⊆ Set.range (fun i : Fin (n + 2) => (i : ℕ)) := by
      intro v hv
      have hvn : v ≤ n := Finset.le_sup (f := id) (Finset.mem_coe.mp hv)
      exact ⟨⟨v, by omega⟩, rfl⟩
    obtain ⟨q, hq⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range p
      (fun i : Fin (n + 2) => (i : ℕ)) Fin.val_injective hsub
    have hq0 : q ≠ 0 := by
      intro h
      rw [h, map_zero] at hq
      exact hp0 hq.symm
    refine hFnot ⟨n, q, hq0, fun z hz => ?_⟩
    have hev := hpt (F z) (hFV hz)
    rw [← hq, MvPolynomial.eval_rename] at hev
    have hfun : ((fun k => yFun k (F z)) ∘ fun i : Fin (n + 2) => (i : ℕ))
        = Fin.cons z (fun j : Fin (n + 1) => iteratedDeriv (j : ℕ) F z) := by
      funext i
      induction i using Fin.cases with
      | zero => simpa [yFun] using hGF z hz
      | succ j => simp [yFun, inverseJet, hGF z hz]
    rw [hfun] at hev
    exact hev
  -- the independent family lives in a field of finite transcendence degree
  have hindep' : AlgebraicIndependent ℂ (fun k => (⟨y k, hyAmem k⟩ : A)) := by
    refine AlgebraicIndependent.of_comp ((IntermediateField.val A).restrictScalars ℂ) ?_
    exact hindep
  have hcard : Cardinal.aleph0 ≤ Algebra.trdeg ℂ A := by
    simpa using hindep'.lift_cardinalMk_le_trdeg
  have hGDAmero : DifferentialAlgebraicOver (RatFunc ℂ) g :=
    (differentialAlgebraicOver_analyticMeroElement_iff hVo hVc hVne hVinf hG).mpr hGDA
  have hfin : Algebra.trdeg (RatFunc ℂ) A < Cardinal.aleph0 :=
    differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hGDAmero
  haveI : FaithfulSMul ℂ (RatFunc ℂ) :=
    (faithfulSMul_iff_algebraMap_injective ℂ (RatFunc ℂ)).mpr
      (algebraMap ℂ (RatFunc ℂ)).injective
  haveI : FaithfulSMul (RatFunc ℂ) A :=
    (faithfulSMul_iff_algebraMap_injective (RatFunc ℂ) A).mpr
      (algebraMap (RatFunc ℂ) A).injective
  have htower : Algebra.trdeg ℂ (RatFunc ℂ) + Algebra.trdeg (RatFunc ℂ) A
      = Algebra.trdeg ℂ A := trdeg_add_eq ℂ (RatFunc ℂ) (A := A)
  rw [← htower] at hcard
  exact absurd hcard (not_le.mpr (Cardinal.add_lt_aleph0 trdeg_ratFunc_complex_lt_aleph0 hfin))

end Inversion

/-! ## A hypertranscendental pair composing to the identity -/

section Trivialization

/-- For an entire function a differential relation on one nonempty open set is a global
relation: the relation locus of a nonzero jet polynomial cannot accumulate. -/
theorem differentiallyAlgebraic_of_differentiallyAlgebraicOn {f : ℂ → ℂ}
    (hf : Differentiable ℂ f) {V : Set ℂ} (hVo : IsOpen V) (hVne : V.Nonempty)
    (h : DifferentiallyAlgebraicOn f V) : DifferentiallyAlgebraic f := by
  obtain ⟨n, P, hP, hrel⟩ := h
  refine ⟨n, P, hP, ?_⟩
  rcases GaloisForLFunctions.jetEval_identically_zero_or_isolated hf n P with hall | hiso
  · exact hall
  · exfalso
    obtain ⟨z₀, hz₀⟩ := hVne
    letI : Filter.NeBot (nhdsWithin z₀ {z₀}ᶜ) := NormedField.nhdsNE_neBot z₀
    refine hiso z₀ ?_
    have hlocal : ∀ᶠ z in nhds z₀, MvPolynomial.eval
        (Fin.cons z fun j : Fin (n + 1) => iteratedDeriv (j : ℕ) f z) P = 0 := by
      filter_upwards [hVo.mem_nhds hz₀] with z hz
      exact hrel z hz
    exact (hlocal.filter_mono nhdsWithin_le_nhds).frequently

/-- **Proposition 5.1, source-dependent trivialization.**  There are hypertranscendental analytic
germs with nonvanishing derivatives, mutually inverse on their domains.  A coordinate change that
is allowed to depend on the source can therefore use the source as its own clock and erase
hypertranscendence, so the covariance group of hypertranscendence cannot be enlarged to all local
analytic coordinates. -/
theorem exists_hypertranscendental_inverse_pair :
    ∃ (U V : Set ℂ) (F G : ℂ → ℂ),
      IsOpen U ∧ IsOpen V ∧ U.Nonempty ∧ V.Nonempty ∧
      AnalyticOnNhd ℂ F U ∧ AnalyticOnNhd ℂ G V ∧
      Set.MapsTo F U V ∧ Set.MapsTo G V U ∧
      (∀ z ∈ U, G (F z) = z) ∧ (∀ w ∈ V, F (G w) = w) ∧
      (∀ z ∈ U, deriv F z ≠ 0) ∧ (∀ w ∈ V, deriv G w ≠ 0) ∧
      ¬ DifferentiallyAlgebraicOn F U ∧ ¬ DifferentiallyAlgebraicOn G V := by
  classical
  set W : ℂ → ℂ := entireHypertranscendentalWitness with hWdef
  have hWht : Hypertranscendental W := hypertranscendental_entireHypertranscendentalWitness
  have hWd : Differentiable ℂ W := differentiable_entireHypertranscendentalWitness
  obtain ⟨a, hane⟩ : ∃ a : ℂ, deriv W a ≠ 0 := by
    by_contra hcon
    have hall : ∀ z : ℂ, deriv W z = 0 := fun z => by
      by_contra hz
      exact hcon ⟨z, hz⟩
    refine hWht (differentiallyAlgebraic_of_iteratedDeriv_eq_zero (m := 1) fun z => ?_)
    rw [iteratedDeriv_one]
    exact hall z
  have hWan : AnalyticAt ℂ W a :=
    analyticOnNhd_entireHypertranscendentalWitness a (Set.mem_univ a)
  have hstrict : HasStrictDerivAt W (deriv W a) a := hWan.hasStrictDerivAt
  set g : ℂ → ℂ := hstrict.localInverse W (deriv W a) a hane with hgdef
  have hgan : AnalyticAt ℂ g (W a) := hWan.analyticAt_localInverse hane
  have hleft : ∀ᶠ z in nhds a, g (W z) = z := by
    filter_upwards [hstrict.eventually_left_inverse hane] with z hz using hz
  have hright : ∀ᶠ w in nhds (W a), W (g w) = w := by
    filter_upwards [hstrict.eventually_right_inverse hane] with w hw using hw
  have hga : g (W a) = a := hleft.self_of_nhds
  -- the two germ domains
  obtain ⟨U₀, hU₀open, haU₀, hU₀mem⟩ :
      ∃ U₀ : Set ℂ, IsOpen U₀ ∧ a ∈ U₀ ∧ ∀ z ∈ U₀, g (W z) = z :=
    ⟨interior {z : ℂ | g (W z) = z}, isOpen_interior,
      mem_interior_iff_mem_nhds.mpr hleft,
      fun z hz => (interior_subset hz : z ∈ {z : ℂ | g (W z) = z})⟩
  have hTb : {w : ℂ | W (g w) = w ∧ AnalyticAt ℂ g w} ∈ nhds (W a) := by
    filter_upwards [hright, hgan.eventually_analyticAt] with w h1 h2 using ⟨h1, h2⟩
  have hpre : g ⁻¹' U₀ ∈ nhds (W a) :=
    hgan.continuousAt.preimage_mem_nhds (by rw [hga]; exact hU₀open.mem_nhds haU₀)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (Filter.inter_mem hTb hpre)
  set V : Set ℂ := Metric.ball (W a) ε with hVdef
  have hVopen : IsOpen V := Metric.isOpen_ball
  have hVbmem : W a ∈ V := Metric.mem_ball_self hε
  have hVne : V.Nonempty := ⟨W a, hVbmem⟩
  have hVT : ∀ w ∈ V, W (g w) = w ∧ AnalyticAt ℂ g w := fun w hw => (hball hw).1
  have hVpre : ∀ w ∈ V, g w ∈ U₀ := fun w hw => (hball hw).2
  set Uset : Set ℂ := U₀ ∩ W ⁻¹' V with hUsetdef
  have hUopen : IsOpen Uset := hU₀open.inter (hWd.continuous.isOpen_preimage _ hVopen)
  have haU : a ∈ Uset := ⟨haU₀, hVbmem⟩
  have hUne : Uset.Nonempty := ⟨a, haU⟩
  have hWanU : AnalyticOnNhd ℂ W Uset := fun z _ =>
    analyticOnNhd_entireHypertranscendentalWitness z (Set.mem_univ z)
  have hganV : AnalyticOnNhd ℂ g V := fun w hw => (hVT w hw).2
  have hWmaps : Set.MapsTo W Uset V := fun z hz => hz.2
  have hgmaps : Set.MapsTo g V Uset := fun w hw =>
    ⟨hVpre w hw, by rw [Set.mem_preimage, (hVT w hw).1]; exact hw⟩
  have hgW : ∀ z ∈ Uset, g (W z) = z := fun z hz => hU₀mem z hz.1
  have hWg : ∀ w ∈ V, W (g w) = w := fun w hw => (hVT w hw).1
  refine ⟨Uset, V, W, g, hUopen, hVopen, hUne, hVne, hWanU, hganV, hWmaps, hgmaps, hgW, hWg,
    fun z hz => ?_, fun w hw => ?_, ?_, ?_⟩
  · exact deriv_ne_zero_of_leftInverse hUopen hganV hWanU hWmaps hgW hz
  · exact deriv_ne_zero_of_leftInverse hVopen hWanU hganV hgmaps hWg hw
  · intro hDA
    exact hWht (differentiallyAlgebraic_of_differentiallyAlgebraicOn hWd hUopen hUne hDA)
  · intro hDA
    letI : Filter.NeBot (nhdsWithin (W a) {W a}ᶜ) := NormedField.nhdsNE_neBot (W a)
    have hVinf : V.Infinite := infinite_of_mem_nhds (W a) (hVopen.mem_nhds hVbmem)
    have hVc : IsPreconnected V := (convex_ball (W a) ε).isPreconnected
    have hWDA : DifferentiallyAlgebraicOn W Uset :=
      differentiallyAlgebraicOn_of_localInverse hVopen hVc hVne hVinf hWanU hganV hgmaps hWmaps
        hWg hgW hDA
    exact hWht (differentiallyAlgebraic_of_differentiallyAlgebraicOn hWd hUopen hUne hWDA)

end Trivialization

end

