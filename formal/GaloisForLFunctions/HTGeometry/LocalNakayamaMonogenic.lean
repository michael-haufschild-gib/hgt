import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap

/-!
# Monogenicity over a local ring by Nakayama

A finite algebra over a local ring is generated by a single element as soon as the residues of that
element generate the fibre.  This is the local input for the simple connectedness of affine space in
its general (non-monogenic) form: an étale algebra over a local ring with algebraically closed
residue field has a split fibre, hence a monogenic fibre, hence is itself monogenic.

Unlike `IsLocalRing.exists_adjoin_eq_top` in mathlib, no hypothesis is placed on the upper ring: it
need not be local, which is exactly the case of interest, where the fibre is a product of `n` copies
of the residue field.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

/-- **Nakayama monogenicity.**  A finite algebra over a local ring is generated by an element
whose residues generate the fibre. -/
theorem adjoin_eq_top_of_le_maximalIdeal_smul {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [IsLocalRing A] [Module.Finite A B] {θ : B}
    (h : (⊤ : Submodule A B) ≤
      (Algebra.adjoin A {θ}).toSubmodule ⊔ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A B)) :
    Algebra.adjoin A {θ} = ⊤ := by
  have hfg : (⊤ : Submodule A B).FG := Module.Finite.fg_top
  have hjac : IsLocalRing.maximalIdeal A ≤ Ideal.jacobson ⊥ := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  have hle := Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac h
  apply top_unique
  intro b _
  exact hle (Submodule.mem_top)

/-- The same criterion in elementwise form: if every element of `B` agrees with a polynomial in `θ`
modulo the maximal ideal, then `θ` generates. -/
theorem adjoin_eq_top_of_forall_sub_mem {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [IsLocalRing A] [Module.Finite A B] {θ : B}
    (h : ∀ b : B, ∃ p : Polynomial A,
      b - Polynomial.aeval θ p ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A B)) :
    Algebra.adjoin A {θ} = ⊤ := by
  refine adjoin_eq_top_of_le_maximalIdeal_smul ?_
  intro b _
  obtain ⟨p, hp⟩ := h b
  have hmem : Polynomial.aeval θ p ∈ (Algebra.adjoin A {θ}).toSubmodule := by
    simp only [Subalgebra.mem_toSubmodule]
    exact Algebra.adjoin_singleton_eq_range_aeval A θ ▸ ⟨p, rfl⟩
  have := Submodule.add_mem_sup hmem hp
  simpa using this

/-- Consequence: over a local ring, a finite algebra whose fibre is generated by the residue of `θ`
equals `A[θ]`, so it is monogenic. -/
theorem exists_adjoin_eq_top_of_forall_sub_mem {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [IsLocalRing A] [Module.Finite A B]
    (h : ∃ θ : B, ∀ b : B, ∃ p : Polynomial A,
      b - Polynomial.aeval θ p ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A B)) :
    ∃ θ : B, Algebra.adjoin A {θ} = ⊤ := by
  obtain ⟨θ, hθ⟩ := h
  exact ⟨θ, adjoin_eq_top_of_forall_sub_mem hθ⟩

end GaloisForLFunctions.HTGeometry
