import GaloisForLFunctions.HTGeometry.GenericCurvatureInvariantField

/-!
# The centre-fixed field is the projective field

The centre of the constant gauge group is the scalar matrices, and a scalar gauge multiplies every
jet coordinate by the same constant.  Its fixed field is therefore the *projective* field: the
subfield generated by the base field and the ratios `x_p / x_q` of jet coordinates.

The proof is the same specialisation trick as for the full gauge group, with the generic gauge
matrix replaced by a single free parameter.  Write `u = p/q` and substitute
`x_p ↦ (x_p / x_{p₀})·s` for a free `s`.  Scalar invariance says the resulting polynomial in `s`
vanishes at every point `c·x_{p₀}` with `c` in the base field, an infinite set, so the polynomial is
zero; evaluating it at any base-field point `c` at which the denominator survives exhibits `u` as a
ratio of two elements built from ratios of jets.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {K : Type*} [Field K] {N : ℕ}

/-- The scalar gauge matrix. -/
def scalarGauge (K : Type*) [Field K] (N : ℕ) (c : K) : Matrix (Fin N) (Fin N) K := c • 1

theorem scalarGauge_apply (c : K) (i j : Fin N) :
    scalarGauge K N c i j = if i = j then c else 0 := by
  classical
  rw [scalarGauge]
  by_cases h : i = j
  · subst h; simp [Matrix.one_apply_eq]
  · simp [Matrix.one_apply_ne h, h]

theorem scalarGauge_mul (c d : K) :
    scalarGauge K N c * scalarGauge K N d = scalarGauge K N (c * d) := by
  rw [scalarGauge, scalarGauge, scalarGauge, Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul,
    smul_smul]

theorem scalarGauge_one : scalarGauge K N (1 : K) = 1 := by
  rw [scalarGauge, one_smul]

theorem scalarGauge_mul_inv (c : K) (hc : c ≠ 0) :
    scalarGauge K N c * scalarGauge K N c⁻¹ = 1 := by
  rw [scalarGauge_mul, mul_inv_cancel₀ hc, scalarGauge_one]

theorem scalarGauge_inv_mul (c : K) (hc : c ≠ 0) :
    scalarGauge K N c⁻¹ * scalarGauge K N c = 1 := by
  rw [scalarGauge_mul, inv_mul_cancel₀ hc, scalarGauge_one]

/-- The scalar gauge scales every jet coordinate. -/
theorem leftTranslationFieldEquiv_scalarGauge_jet (c : K) (hc : c ≠ 0) (a b : Fin N) (r : ℕ) :
    leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) (JetField.jet ((a, b), r))
      = algebraMap K (JetField K (Fin N × Fin N)) c * JetField.jet ((a, b), r) := by
  classical
  rw [leftTranslationFieldEquiv_jet]
  rw [Finset.sum_eq_single a]
  · rw [scalarGauge_apply, if_pos rfl]
  · intro k _ hk
    rw [scalarGauge_apply, if_neg (Ne.symm hk), map_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ a) h

/-! ### The projective subfield -/

/-- The subfield generated by the base field and the ratios of jet coordinates. -/
def projectiveSubfield (K : Type*) [Field K] (N : ℕ) : Subfield (JetField K (Fin N × Fin N)) :=
  Subfield.closure (Set.range (algebraMap K (JetField K (Fin N × Fin N)))
    ∪ {x | ∃ p q : (Fin N × Fin N) × ℕ, x = JetField.jet p / JetField.jet q})

theorem algebraMap_mem_projectiveSubfield (a : K) :
    algebraMap K (JetField K (Fin N × Fin N)) a ∈ projectiveSubfield K N :=
  Subfield.subset_closure (Or.inl ⟨a, rfl⟩)

theorem jet_div_jet_mem_projectiveSubfield (p q : (Fin N × Fin N) × ℕ) :
    JetField.jet p / JetField.jet q ∈ projectiveSubfield K N :=
  Subfield.subset_closure (Or.inr ⟨p, q, rfl⟩)

private theorem jet_ne_zero (p : (Fin N × Fin N) × ℕ) : (JetField.jet p : JetField K (Fin N × Fin N)) ≠ 0 := by
  intro h
  have hinj : Function.Injective
      (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))) :=
    IsFractionRing.injective _ _
  have : (X p : JetPoly K (Fin N × Fin N)) = 0 := by
    apply hinj
    rw [map_zero]
    exact h
  exact (MvPolynomial.X_ne_zero p) this

/-- The rescaled generic substitution `x_p ↦ (jet p / jet p₀) · s`. -/
def projScaleHom (K : Type*) [Field K] (N : ℕ) (p₀ : (Fin N × Fin N) × ℕ) :
    JetPoly K (Fin N × Fin N) →+* Polynomial (JetField K (Fin N × Fin N)) :=
  eval₂Hom ((Polynomial.C : JetField K (Fin N × Fin N) →+* Polynomial (JetField K (Fin N × Fin N))).comp
      (algebraMap K (JetField K (Fin N × Fin N))))
    (fun p : (Fin N × Fin N) × ℕ =>
      Polynomial.C (JetField.jet p / JetField.jet p₀) * Polynomial.X)

@[simp] theorem projScaleHom_C (p₀ : (Fin N × Fin N) × ℕ) (a : K) :
    projScaleHom K N p₀ (MvPolynomial.C a)
      = Polynomial.C (algebraMap K (JetField K (Fin N × Fin N)) a) := by
  simp [projScaleHom]

@[simp] theorem projScaleHom_X (p₀ p : (Fin N × Fin N) × ℕ) :
    projScaleHom K N p₀ (X p)
      = Polynomial.C (JetField.jet p / JetField.jet p₀) * Polynomial.X := by
  simp [projScaleHom]

/-- Evaluating the rescaled substitution at `s = jet p₀` returns the original element. -/
theorem eval_projScaleHom_base (p₀ : (Fin N × Fin N) × ℕ) (p : JetPoly K (Fin N × Fin N)) :
    Polynomial.eval (JetField.jet p₀) (projScaleHom K N p₀ p)
      = algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      rw [projScaleHom_C, Polynomial.eval_C, IsScalarTower.algebraMap_apply K
        (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)), MvPolynomial.algebraMap_eq]
  | add p q hp hq => rw [map_add, map_add, Polynomial.eval_add, hp, hq]
  | mul_X p q hp =>
      rw [map_mul, map_mul, Polynomial.eval_mul, hp, projScaleHom_X]
      congr 1
      rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
        div_mul_cancel₀ _ (jet_ne_zero p₀)]
      rfl

/-- Evaluating the rescaled substitution at a scalar multiple of `jet p₀` is the scalar gauge. -/
theorem eval_projScaleHom_scalar (p₀ : (Fin N × Fin N) × ℕ) (c : K) (hc : c ≠ 0)
    (p : JetPoly K (Fin N × Fin N)) :
    Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c * JetField.jet p₀)
        (projScaleHom K N p₀ p)
      = leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
          (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc)
          (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p) := by
  set E := JetField K (Fin N × Fin N)
  set σ := leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
    (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) with hσ
  set v : E := algebraMap K E c * JetField.jet p₀ with hv
  set ι : JetPoly K (Fin N × Fin N) →+* E :=
    algebraMap (JetPoly K (Fin N × Fin N)) E with hι
  induction p using MvPolynomial.induction_on with
  | C a =>
      rw [projScaleHom_C, Polynomial.eval_C]
      have hb : ι (MvPolynomial.C a) = algebraMap K E a := by
        rw [hι, IsScalarTower.algebraMap_apply K (JetPoly K (Fin N × Fin N)) E,
          MvPolynomial.algebraMap_eq]
      rw [hb, hσ, leftTranslationFieldEquiv_algebraMap_base]
  | add p q hp hq =>
      rw [map_add, Polynomial.eval_add, hp, hq, map_add, map_add]
  | mul_X p q hp =>
      rw [map_mul, Polynomial.eval_mul, hp, map_mul, map_mul]
      congr 1
      obtain ⟨⟨a, b⟩, r⟩ := q
      have hmap : ι (X ((a, b), r)) = JetField.jet ((a, b), r) := rfl
      rw [projScaleHom_X, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, hmap,
        hσ, leftTranslationFieldEquiv_scalarGauge_jet c hc a b r, hv]
      have hne : (JetField.jet p₀ : JetField K (Fin N × Fin N)) ≠ 0 := jet_ne_zero p₀
      field_simp
      ring

theorem eval_projScaleHom_mem_projectiveSubfield (p₀ : (Fin N × Fin N) × ℕ) (c : K)
    (p : JetPoly K (Fin N × Fin N)) :
    Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c) (projScaleHom K N p₀ p)
      ∈ projectiveSubfield K N := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      rw [projScaleHom_C, Polynomial.eval_C]
      exact algebraMap_mem_projectiveSubfield a
  | add p q hp hq =>
      rw [map_add, Polynomial.eval_add]
      exact add_mem hp hq
  | mul_X p q hp =>
      rw [map_mul, Polynomial.eval_mul]
      refine mul_mem hp ?_
      rw [projScaleHom_X, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
      exact mul_mem (jet_div_jet_mem_projectiveSubfield q p₀)
        (algebraMap_mem_projectiveSubfield c)

/-- **Card 12, item (5): the fixed field of the scalar centre is the projective field.** -/
theorem mem_projectiveSubfield_of_scalarGauge_invariant [Infinite K]
    (p₀ : (Fin N × Fin N) × ℕ) (u : JetField K (Fin N × Fin N))
    (hu : ∀ c : K, ∀ hc : c ≠ 0,
      leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) u = u) :
    u ∈ projectiveSubfield K N := by
  classical
  set ι : JetPoly K (Fin N × Fin N) →+* JetField K (Fin N × Fin N) :=
    algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) with hι
  obtain ⟨p, q, hqmem, hu'⟩ := IsFractionRing.div_surjective (JetPoly K (Fin N × Fin N)) u
  have hinj : Function.Injective ι := IsFractionRing.injective _ _
  have hq0 : q ≠ 0 := fun h => by
    rw [h] at hqmem
    exact (zero_notMem_nonZeroDivisors) hqmem
  have hqne : ι q ≠ 0 := fun h => hq0 (hinj (by simpa using h))
  set P : Polynomial (JetField K (Fin N × Fin N)) :=
    projScaleHom K N p₀ p * Polynomial.C (ι q)
      - Polynomial.C (ι p) * projScaleHom K N p₀ q with hP
  have hroot : ∀ c : K, c ≠ 0 →
      P.IsRoot (algebraMap K (JetField K (Fin N × Fin N)) c * JetField.jet p₀) := by
    intro c hc
    set σ := leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
      (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) with hσ
    have hσq : σ (ι q) ≠ 0 := fun h => hqne (by
      have := σ.injective (a₁ := ι q) (a₂ := 0) (by rw [h, map_zero])
      exact this)
    have hfix := hu c hc
    rw [← hu', map_div₀] at hfix
    rw [div_eq_div_iff hσq hqne] at hfix
    rw [Polynomial.IsRoot, hP]
    simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C]
    rw [eval_projScaleHom_scalar p₀ c hc p, eval_projScaleHom_scalar p₀ c hc q]
    rw [sub_eq_zero]
    exact hfix
  have hPzero : P = 0 := by
    refine Polynomial.eq_zero_of_infinite_isRoot P ?_
    have hmapinj : Function.Injective
        (fun c : K => algebraMap K (JetField K (Fin N × Fin N)) c * JetField.jet p₀) := by
      intro c d hcd
      have hne : (JetField.jet p₀ : JetField K (Fin N × Fin N)) ≠ 0 := jet_ne_zero p₀
      have := mul_right_cancel₀ hne hcd
      exact (algebraMap K (JetField K (Fin N × Fin N))).injective this
    have hinf : ({c : K | c ≠ 0}).Infinite := Set.Finite.infinite_compl (Set.finite_singleton 0)
    refine Set.Infinite.mono ?_ (hinf.image (hmapinj.injOn))
    rintro x ⟨c, hc, rfl⟩
    exact hroot c hc
  have hqpoly : projScaleHom K N p₀ q ≠ 0 := by
    intro h
    have := eval_projScaleHom_base p₀ q
    rw [h, Polynomial.eval_zero] at this
    exact hqne this.symm
  obtain ⟨c, hc⟩ : ∃ c : K,
      Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c)
        (projScaleHom K N p₀ q) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    refine hqpoly (Polynomial.eq_zero_of_infinite_isRoot _ ?_)
    have hinf : (Set.range fun c : K => algebraMap K (JetField K (Fin N × Fin N)) c).Infinite :=
      Set.infinite_range_of_injective (algebraMap K (JetField K (Fin N × Fin N))).injective
    refine Set.Infinite.mono ?_ hinf
    rintro x ⟨c, rfl⟩
    exact hcon c
  have hval := congrArg
    (Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c)) hPzero
  rw [hP] at hval
  simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_zero, sub_eq_zero] at hval
  rw [← hu']
  have heq : ι p / ι q
      = Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c) (projScaleHom K N p₀ p)
        / Polynomial.eval (algebraMap K (JetField K (Fin N × Fin N)) c)
            (projScaleHom K N p₀ q) := by
    rw [div_eq_div_iff hqne hc]
    exact hval.symm
  rw [hι] at heq
  rw [heq]
  exact div_mem (eval_projScaleHom_mem_projectiveSubfield p₀ c p)
    (eval_projScaleHom_mem_projectiveSubfield p₀ c q)

/-- The scalar gauge fixes every ratio of jet coordinates. -/
theorem leftTranslationFieldEquiv_scalarGauge_jet_div (c : K) (hc : c ≠ 0)
    (p q : (Fin N × Fin N) × ℕ) :
    leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc)
        (JetField.jet p / JetField.jet q)
      = JetField.jet p / JetField.jet q := by
  obtain ⟨⟨a, b⟩, r⟩ := p
  obtain ⟨⟨a', b'⟩, r'⟩ := q
  rw [map_div₀, leftTranslationFieldEquiv_scalarGauge_jet c hc a b r,
    leftTranslationFieldEquiv_scalarGauge_jet c hc a' b' r']
  have hcne : algebraMap K (JetField K (Fin N × Fin N)) c ≠ 0 := by
    intro h
    exact hc ((algebraMap K (JetField K (Fin N × Fin N))).injective (by simpa using h))
  rw [mul_div_mul_left _ _ hcne]

/-- **The projective field is fixed by the scalar centre.** -/
theorem scalarGauge_fixes_projectiveSubfield (c : K) (hc : c ≠ 0)
    {u : JetField K (Fin N × Fin N)} (hu : u ∈ projectiveSubfield K N) :
    leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) u = u := by
  refine Subfield.closure_induction (p := fun y _ =>
    leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
      (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) y = y) ?_ ?_ ?_ ?_ ?_ ?_ hu
  · rintro x (⟨a, rfl⟩ | ⟨p, q, rfl⟩)
    · exact leftTranslationFieldEquiv_algebraMap_base _ _ _ _ a
    · exact leftTranslationFieldEquiv_scalarGauge_jet_div c hc p q
  · exact map_one _
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_neg, ha]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]

/-- **Card 12, item (5): the centre-fixed field is exactly the projective field.** -/
theorem scalarGaugeInvariants_eq_projectiveSubfield [Infinite K] (p₀ : (Fin N × Fin N) × ℕ) :
    {u : JetField K (Fin N × Fin N) | ∀ (c : K) (hc : c ≠ 0),
      leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) u = u}
      = (projectiveSubfield K N : Set (JetField K (Fin N × Fin N))) := by
  ext u
  constructor
  · intro hu
    exact mem_projectiveSubfield_of_scalarGauge_invariant p₀ u hu
  · intro hu c hc
    exact scalarGauge_fixes_projectiveSubfield c hc hu

end

end GaloisForLFunctions.HTGeometry
