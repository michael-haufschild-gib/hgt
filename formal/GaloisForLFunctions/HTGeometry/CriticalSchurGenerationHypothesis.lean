import GaloisForLFunctions.HTGeometry.CriticalSchurObservationLocalization
import GaloisForLFunctions.HTGeometry.KaehlerRelativeSpan

/-!
# The generation hypothesis at the Schur place

Every element of the observation Schur valuation ring is a ratio of chart-ring elements with
denominator a unit there, and the chart ring is in turn a localization of the observation
coordinate polynomial ring, which is generated by the observation coordinates.  Applying the two
localization steps and the algebra-generator step of `KaehlerRelativeSpan` in succession:

```text
criticalSchur_hgen :
    D (anything from the observation Schur place) lies in the span of the differentials of the
    observation coordinates
```

This is the hypothesis `hgen` of `map_maximalIdeal_le_sq_of_factorized_jacobian`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial IsLocalRing KaehlerDifferential

set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 2000000

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ}
variable [Fact (0 < m)] [Fact (0 < n)] [Fact (1 < m)] [Fact (1 < n)]

noncomputable instance observationRingObservationSchurAlgebra :
    Algebra (criticalObservationRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)) :=
  ((chartRingToObservationSchur K).comp
    (algebraMap (criticalObservationRing K m n) (criticalObservationChartRing K m n))).toAlgebra

instance observationRingChartObservationSchurTower :
    IsScalarTower (criticalObservationRing K m n) (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)) :=
  IsScalarTower.of_algebraMap_eq' rfl

instance observationRingObservationSchurSourceTower :
    IsScalarTower (criticalObservationRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)) := by
  refine IsScalarTower.of_algebraMap_eq fun p => ?_
  rw [IsScalarTower.algebraMap_apply (criticalObservationRing K m n)
      (criticalObservationChartRing K m n)
      (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)),
    IsScalarTower.algebraMap_apply (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)),
    ← IsScalarTower.algebraMap_apply (criticalObservationRing K m n)
      (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))]

instance chartRingObservationFieldGroundTower :
    IsScalarTower K (criticalObservationChartRing K m n)
      (criticalObservationField K m n) := by
  refine IsScalarTower.of_algebraMap_eq fun c => ?_
  rw [IsScalarTower.algebraMap_apply K (criticalObservationRing K m n)
      (criticalObservationChartRing K m n),
    ← IsScalarTower.algebraMap_apply (criticalObservationRing K m n)
      (criticalObservationChartRing K m n) (criticalObservationField K m n),
    ← IsScalarTower.algebraMap_apply K (criticalObservationRing K m n)
      (criticalObservationField K m n)]

instance chartRingObservationSchurGroundTower :
    IsScalarTower K (criticalObservationChartRing K m n)
      (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)) := by
  refine IsScalarTower.of_algebraMap_eq fun c => ?_
  apply Subtype.ext
  show algebraMap K (criticalObservationField K m n) c
    = algebraMap (criticalObservationChartRing K m n) (criticalObservationField K m n)
      (algebraMap K (criticalObservationChartRing K m n) c)
  rw [← IsScalarTower.algebraMap_apply]

/-- The observation coordinates as elements of the observation Schur valuation ring. -/
noncomputable def criticalObservationCoordSchur (s : Fin n ⊕ Fin m) :
    criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n) :=
  algebraMap (criticalObservationRing K m n) _ (MvPolynomial.X s)

/-- **The generation hypothesis.**  Every differential coming from the observation Schur place is a
combination of the differentials of the observation coordinates. -/
theorem criticalSchur_hgen
    (a : criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n)) :
    KaehlerDifferential.D K
        (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (algebraMap _ _ a) ∈
      Submodule.span (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (Set.range fun s : Fin n ⊕ Fin m =>
          KaehlerDifferential.D K
            (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
            (algebraMap _ _ (criticalObservationCoordSchur K s))) := by
  refine D_mem_of_isLocalization (criticalSchurChartUnder K (m := m) (n := n)).primeCompl _ ?_ a
  intro r
  rw [← IsScalarTower.algebraMap_apply]
  refine D_mem_of_isLocalization
    (Submonoid.powers (criticalObservationMarked K (m := m) (n := n))) _ ?_ r
  intro p
  rw [← IsScalarTower.algebraMap_apply]
  refine D_mem_of_adjoin_eq_top _ (G := Set.range (MvPolynomial.X :
    (Fin n ⊕ Fin m) → criticalObservationRing K m n)) MvPolynomial.adjoin_range_X ?_ p
  rintro _ ⟨s, rfl⟩
  refine Submodule.subset_span ⟨s, ?_⟩
  show KaehlerDifferential.D K
      (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
      (algebraMap
        (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (criticalSchurSourceValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
        (algebraMap (criticalObservationRing K m n)
          (criticalSchurObservationValuationSubring K (Fact.out : 0 < m) (Fact.out : 0 < n))
          (MvPolynomial.X s))) = _
  rw [← IsScalarTower.algebraMap_apply]

end

end GaloisForLFunctions.HTGeometry
