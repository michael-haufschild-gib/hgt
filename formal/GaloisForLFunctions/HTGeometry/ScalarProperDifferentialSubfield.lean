import GaloisForLFunctions.HTGeometry.ScalarDifferentialFieldGenerator
import GaloisForLFunctions.HTGeometry.DifferentialIndependence

/-!
# A concrete proper clock-invariant differential subfield

The persistent core of the clock-character law is a proper clock-invariant differential subfield of
`C⟨y⟩`.  This file exhibits a concrete one, witnessing that the object is non-vacuous in the *charged*
regime.

The first differential jet `y' = X_{(),1}` (a clock eigenvector of weight `1`) differentially generates
the subfield `C⟨y'⟩ = C(y', y'', y''', …) = C(X_{(),1}, X_{(),2}, …)`, which omits the free variable
`y = X_{(),0}`.  Since the jets `X_{(),n}` are algebraically independent, `y` is transcendental over
`C⟨y'⟩`, so

`differentialAdjoin C {y'} ≠ ⊤`.

Thus `C⟨y'⟩` is a proper differential subfield strictly between `C` and `C⟨y⟩`, with a charged
clock-eigenvector generator (`clockDilationFieldEquiv_differentialJet` gives `ρ_λ(y') = λ·y'`).
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {C : Type*} [Field C]

/-- The `m`-th jet of the first jet `y'` is the `(m+1)`-st jet of `y`: `(y')^(m) = y^(m+1)`. -/
theorem differentialJet_differentialJet_one (m : ℕ) (x : ScalarDifferentialField C) :
    differentialJet m (differentialJet 1 x) = differentialJet (m + 1) x := by
  simp only [differentialJet]
  rw [← Function.iterate_add_apply]

/-- **A concrete proper differential subfield.**  The first jet `y' = X_{(),1}` differentially
generates a subfield omitting `y = X_{(),0}`, so `differentialAdjoin C {y'} ≠ ⊤`. -/
theorem differentialAdjoin_differentialJet_one_ne_top :
    differentialAdjoin C {differentialJet 1 (scalarDifferentialGenerator C)} ≠ (⊤ : IntermediateField C (ScalarDifferentialField C)) := by
  -- the family of jets `y^(n) = X_{(),n}` is algebraically independent over `C`
  have hX : AlgebraicIndependent C
      (fun n : ℕ => (MvPolynomial.X ((), n) : DifferentialPolynomial Unit C)) :=
    (MvPolynomial.algebraicIndependent_X (Unit × ℕ) C).comp (fun n : ℕ => ((), n))
      (fun a b hab => by simpa using hab)
  have hinj : Function.Injective
      (algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)) :=
    IsFractionRing.injective _ _
  have hmap : AlgebraicIndependent C
      (fun n : ℕ => algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        (MvPolynomial.X ((), n))) :=
    hX.map (f := IsScalarTower.toAlgHom C (DifferentialPolynomial Unit C)
      (ScalarDifferentialField C)) hinj.injOn
  -- the jet set of `y'` is exactly the image of the nonzero indices
  have hset : (fun n : ℕ => algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        (MvPolynomial.X ((), n))) '' {n : ℕ | n ≠ 0}
      = differentialJetSet {differentialJet 1 (scalarDifferentialGenerator C)} := by
    ext z
    simp only [differentialJetSet, Set.mem_image, Set.mem_setOf_eq, Set.mem_singleton_iff]
    constructor
    · rintro ⟨n, hn, rfl⟩
      refine ⟨differentialJet 1 (scalarDifferentialGenerator C), rfl, n - 1, ?_⟩
      rw [differentialJet_differentialJet_one,
        Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn),
        differentialJet_scalarDifferentialGenerator]
    · rintro ⟨w, rfl, m, rfl⟩
      exact ⟨m + 1, Nat.succ_ne_zero m, by
        rw [differentialJet_differentialJet_one, differentialJet_scalarDifferentialGenerator]⟩
  -- `y = X_{(),0}` is transcendental over the subfield generated by the higher jets
  have hi : (0 : ℕ) ∉ {n : ℕ | n ≠ 0} := by simp
  have htr := hmap.transcendental_adjoin hi
  rw [hset] at htr
  have htrIF : Transcendental (IntermediateField.adjoin C
      (differentialJetSet {differentialJet 1 (scalarDifferentialGenerator C)}))
      ((fun n : ℕ => algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        (MvPolynomial.X ((), n))) 0) :=
    IntermediateField.transcendental_adjoin_iff.mpr htr
  -- so `y` cannot lie in the differential subfield, hence it is not all of `C⟨y⟩`
  intro htop
  have hmem : ((fun n : ℕ => algebraMap (DifferentialPolynomial Unit C) (ScalarDifferentialField C)
        (MvPolynomial.X ((), n))) 0)
      ∈ differentialAdjoin C {differentialJet 1 (scalarDifferentialGenerator C)} := by
    rw [htop]; exact IntermediateField.mem_top
  exact htrIF (isAlgebraic_algebraMap
    (⟨_, hmem⟩ : IntermediateField.adjoin C
      (differentialJetSet {differentialJet 1 (scalarDifferentialGenerator C)})))

end

end GaloisForLFunctions
