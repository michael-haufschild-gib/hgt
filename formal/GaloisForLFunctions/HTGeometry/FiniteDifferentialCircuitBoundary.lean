import GaloisForLFunctions.HTGeometry.FiniteAlgebraicStateBoundary
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity

/-!
# Finite differential-circuit boundary for hypertranscendental observables

A finite symbolic model may use arbitrary named atoms and repeatedly apply field operations and
the ambient derivation.  This covers the algebraic core of equation-learning networks, symbolic
regression expression trees, rational input-output formulae in systems biology, and finite
algebraic combinations of physical observables.  The architecture is static: it describes which
observables can be assembled, not an evolution law.

The positive source theorem below says that a hypertranscendental output of such a circuit forces
at least one hypertranscendental atom.  Finite composition can transport hypertranscendence but
cannot create it from differentially algebraic primitives.  Thus a learned, genomic, or physical
formula purporting to reproduce an HT clock must expose where the infinite differential source
enters its observable vocabulary.

ML/AI provenance: G. Martius and C. H. Lampert, *Extrapolation and learning equations*,
arXiv:1610.02995, introduce an end-to-end differentiable equation learner for analytical
expressions; S.-M. Udrescu and M. Tegmark, *AI Feynman: a Physics-Inspired Method for Symbolic
Regression*, arXiv:1905.11481, recursively searches compositional formulae using sums, products,
ratios, and other primitives.  Biology/genomics provenance: H. A. Harrington, K. L. Ho, and
N. Meshkat, *Differential Algebra for Model Comparison*, arXiv:1603.09730, eliminate hidden ODE
states to differential invariants in measurable variables; A. Ovchinnikov, G. Pogudin, and
P. Thompson, *Parameter identifiability and input-output equations*, arXiv:2007.14787, formulate
rational state and output models and their differential input-output fields.  The papers motivate
the model classes; the exact source-extraction boundary is the theorem proved here.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Differential independence over a larger coefficient field implies differential
independence over every faithfully embedded smaller coefficient field. -/
theorem DifferentialIndependent.restrictScalarsTower
    {F S E : Type*} [Field F] [Field S] [Field E]
    [Algebra F S] [Algebra S E] [Algebra F E] [IsScalarTower F S E]
    [Differential E] {ι : Type*} {x : ι → E}
    (hx : DifferentialIndependent S x) :
    DifferentialIndependent F x := by
  unfold DifferentialIndependent at hx ⊢
  exact AlgebraicIndependent.restrictScalars
    (FaithfulSMul.algebraMap_injective F S) hx

/-- Enlarging the coefficient field preserves differential algebraicity. -/
theorem differentialAlgebraicOver_mono
    {F S E : Type*} [Field F] [Field S] [Field E]
    [Algebra F S] [Algebra S E] [Algebra F E] [IsScalarTower F S E]
    [Differential E] {x : E} (hx : DifferentialAlgebraicOver F x) :
    DifferentialAlgebraicOver S x := by
  intro hind
  exact hx (DifferentialIndependent.restrictScalarsTower hind)

/-- Every element of the differential field generated by one differentially algebraic
element is differentially algebraic. -/
theorem differentialAlgebraicOver_of_mem_differentialAdjoin_singleton
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y : E} (hx : DifferentialAlgebraicOver F x)
    (hy : y ∈ differentialAdjoin F ({x} : Set E)) :
    DifferentialAlgebraicOver F y := by
  exact differentialAlgebraicOver_of_mem_derivationClosed_finiteTrdeg
    (differentialAdjoin F ({x} : Set E))
    (derivationClosed_differentialAdjoin F ({x} : Set E))
    (differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hx) hy

/-- Every embedded coefficient is differentially algebraic over its coefficient field. -/
theorem differentialAlgebraicOver_algebraMap
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    (c : F) : DifferentialAlgebraicOver F (algebraMap F E c) := by
  unfold DifferentialAlgebraicOver
  intro hind
  have htrans : Transcendental F (algebraMap F E c) :=
    hind.algebraicIndependent.transcendental Unit.unit
  exact htrans (isAlgebraic_algebraMap c)

/-- Every element obtained by adjoining two differentially algebraic elements in sequence is
differentially algebraic over the original base. -/
theorem differentialAlgebraicOver_of_mem_binary_differentialAdjoin
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y z : E} (hx : DifferentialAlgebraicOver F x)
    (hy : DifferentialAlgebraicOver F y)
    (hz : z ∈ differentialAdjoin (differentialAdjoin F ({x} : Set E))
      ({y} : Set E)) :
    DifferentialAlgebraicOver F z := by
  let S := differentialAdjoin F ({x} : Set E)
  letI : DifferentialAlgebra S E :=
    ⟨fun c => derivationClosedDifferential_apply S
      (derivationClosed_differentialAdjoin F ({x} : Set E)) c⟩
  have hyS : DifferentialAlgebraicOver S y :=
    differentialAlgebraicOver_mono hy
  have hzS : DifferentialAlgebraicOver S z :=
    differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hyS hz
  exact differentialAlgebraicOver_trans hx hzS

/-- Differential algebraicity is closed under addition. -/
theorem differentialAlgebraicOver_add
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y : E} (hx : DifferentialAlgebraicOver F x)
    (hy : DifferentialAlgebraicOver F y) :
    DifferentialAlgebraicOver F (x + y) := by
  apply differentialAlgebraicOver_of_mem_binary_differentialAdjoin hx hy
  let S := differentialAdjoin F ({x} : Set E)
  have hxS : x ∈ S := subset_differentialAdjoin F ({x} : Set E) rfl
  have hxbase : x ∈ differentialAdjoin S ({y} : Set E) := by
    simpa using IntermediateField.algebraMap_mem
      (differentialAdjoin S ({y} : Set E)) (⟨x, hxS⟩ : S)
  have hygen : y ∈ differentialAdjoin S ({y} : Set E) :=
    subset_differentialAdjoin S ({y} : Set E) rfl
  exact IntermediateField.add_mem _ hxbase hygen

/-- Differential algebraicity is closed under multiplication. -/
theorem differentialAlgebraicOver_mul
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y : E} (hx : DifferentialAlgebraicOver F x)
    (hy : DifferentialAlgebraicOver F y) :
    DifferentialAlgebraicOver F (x * y) := by
  apply differentialAlgebraicOver_of_mem_binary_differentialAdjoin hx hy
  let S := differentialAdjoin F ({x} : Set E)
  have hxS : x ∈ S := subset_differentialAdjoin F ({x} : Set E) rfl
  have hxbase : x ∈ differentialAdjoin S ({y} : Set E) := by
    simpa using IntermediateField.algebraMap_mem
      (differentialAdjoin S ({y} : Set E)) (⟨x, hxS⟩ : S)
  have hygen : y ∈ differentialAdjoin S ({y} : Set E) :=
    subset_differentialAdjoin S ({y} : Set E) rfl
  exact IntermediateField.mul_mem _ hxbase hygen

/-- Differential algebraicity is closed under additive inverse. -/
theorem differentialAlgebraicOver_neg
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) :
    DifferentialAlgebraicOver F (-x) := by
  apply differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hx
  exact IntermediateField.neg_mem _
    (subset_differentialAdjoin F ({x} : Set E) rfl)

/-- Differential algebraicity is closed under subtraction. -/
theorem differentialAlgebraicOver_sub
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y : E} (hx : DifferentialAlgebraicOver F x)
    (hy : DifferentialAlgebraicOver F y) :
    DifferentialAlgebraicOver F (x - y) := by
  simpa [sub_eq_add_neg] using
    differentialAlgebraicOver_add hx (differentialAlgebraicOver_neg hy)

/-- Differential algebraicity is closed under multiplicative inverse. -/
theorem differentialAlgebraicOver_inv
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) :
    DifferentialAlgebraicOver F x⁻¹ := by
  apply differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hx
  exact IntermediateField.inv_mem _
    (subset_differentialAdjoin F ({x} : Set E) rfl)

/-- Differential algebraicity is closed under division. -/
theorem differentialAlgebraicOver_div
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x y : E} (hx : DifferentialAlgebraicOver F x)
    (hy : DifferentialAlgebraicOver F y) :
    DifferentialAlgebraicOver F (x / y) := by
  simpa [div_eq_mul_inv] using
    differentialAlgebraicOver_mul hx (differentialAlgebraicOver_inv hy)

/-- Every natural power of a differentially algebraic element is differentially algebraic. -/
theorem differentialAlgebraicOver_pow
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) (n : ℕ) :
    DifferentialAlgebraicOver F (x ^ n) := by
  apply differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hx
  exact (differentialAdjoin F ({x} : Set E)).toSubalgebra.pow_mem
    (subset_differentialAdjoin F ({x} : Set E) rfl) n

/-- Differential algebraicity is closed under the ambient derivation. -/
theorem differentialAlgebraicOver_deriv
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} (hx : DifferentialAlgebraicOver F x) :
    DifferentialAlgebraicOver F x′ := by
  apply differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hx
  have h := differentialJet_mem_differentialAdjoin F
    (s := ({x} : Set E)) (x := x) rfl 1
  simpa using h

/-- A finite product of differentially algebraic elements is differentially algebraic.  This is
the general differential-field closure law behind finite one-loop determinants, finite sector
partition functions, and finite products of learned or biological observables. -/
theorem differentialAlgebraicOver_finset_prod
    {F E ι : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {s : Finset ι} {f : ι → E}
    (hf : ∀ i ∈ s, DifferentialAlgebraicOver F (f i)) :
    DifferentialAlgebraicOver F (∏ i ∈ s, f i) := by
  classical
  induction s using Finset.induction with
  | empty =>
      simpa using differentialAlgebraicOver_algebraMap (F := F) (E := E) 1
  | @insert i s hi ih =>
      rw [Finset.prod_insert hi]
      exact differentialAlgebraicOver_mul (hf i (by simp))
        (ih fun j hj => hf j (by simp [hj]))

/-- **Finite-product source extraction.**  A hypertranscendental finite product has at least one
hypertranscendental factor.  The converse is deliberately not asserted: two HT factors may cancel.
This localizes the source of an HT partition function or determinant without treating its product
presentation as a temporal evolution law. -/
theorem exists_hypertranscendental_factor_of_finset_prod
    {F E ι : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {s : Finset ι} {f : ι → E}
    (hprod : HypertranscendentalOver F (∏ i ∈ s, f i)) :
    ∃ i ∈ s, HypertranscendentalOver F (f i) := by
  classical
  by_contra hnone
  have hf : ∀ i ∈ s, DifferentialAlgebraicOver F (f i) := by
    intro i hi
    by_contra hDA
    exact hnone ⟨i, hi, hDA⟩
  exact hprod (differentialAlgebraicOver_finset_prod hf)

/-- Exact-factorization form of finite-product source extraction.  It applies directly when a
physical, arithmetic, learned, or biological observable is identified with a finite product. -/
theorem exists_hypertranscendental_factor_of_eq_finset_prod
    {F E ι : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {x : E} {s : Finset ι} {f : ι → E}
    (hx : HypertranscendentalOver F x) (hfactor : x = ∏ i ∈ s, f i) :
    ∃ i ∈ s, HypertranscendentalOver F (f i) := by
  rw [hfactor] at hx
  exact exists_hypertranscendental_factor_of_finset_prod hx

/-- A finite differential circuit is a finite expression tree assembled from named atoms by
field operations and differentiation. -/
inductive FiniteDifferentialCircuit {E : Type*} [Field E] [Differential E]
    (Atom : E → Prop) : E → Prop
  | atom {x : E} : Atom x → FiniteDifferentialCircuit Atom x
  | add {x y : E} : FiniteDifferentialCircuit Atom x →
      FiniteDifferentialCircuit Atom y → FiniteDifferentialCircuit Atom (x + y)
  | mul {x y : E} : FiniteDifferentialCircuit Atom x →
      FiniteDifferentialCircuit Atom y → FiniteDifferentialCircuit Atom (x * y)
  | neg {x : E} : FiniteDifferentialCircuit Atom x →
      FiniteDifferentialCircuit Atom (-x)
  | inv {x : E} : FiniteDifferentialCircuit Atom x →
      FiniteDifferentialCircuit Atom x⁻¹
  | deriv {x : E} : FiniteDifferentialCircuit Atom x →
      FiniteDifferentialCircuit Atom x′

/-- Leaves admitted by a scalar-aware circuit: either a genuine model atom or a freely available
coefficient from the base field.  This is the exact leaf class used by finite weighted genomic
clocks, symbolic regressors, and neural expression trees. -/
def BaseScalarOrAtom
    (F E : Type*) [Field F] [Field E] [Algebra F E]
    (Atom : E → Prop) (x : E) : Prop :=
  Atom x ∨ ∃ c : F, algebraMap F E c = x

/-- A finite differential circuit whose atoms are all differentially algebraic has a
differentially algebraic output. -/
theorem FiniteDifferentialCircuit.differentialAlgebraicOver
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {Atom : E → Prop} {x : E} (hx : FiniteDifferentialCircuit Atom x)
    (hAtom : ∀ {a : E}, Atom a → DifferentialAlgebraicOver F a) :
    DifferentialAlgebraicOver F x := by
  induction hx with
  | atom ha => exact hAtom ha
  | add _ _ ihx ihy => exact differentialAlgebraicOver_add ihx ihy
  | mul _ _ ihx ihy => exact differentialAlgebraicOver_mul ihx ihy
  | neg _ ih => exact differentialAlgebraicOver_neg ih
  | inv _ ih => exact differentialAlgebraicOver_inv ih
  | deriv _ ih => exact differentialAlgebraicOver_deriv ih

/-- Positive source-extraction law: if a finite differential circuit has a
hypertranscendental output, at least one of its atoms is already hypertranscendental. -/
theorem exists_hypertranscendental_atom_of_finiteDifferentialCircuit
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {Atom : E → Prop} {x : E} (hx : HypertranscendentalOver F x)
    (hcircuit : FiniteDifferentialCircuit Atom x) :
    ∃ a : E, Atom a ∧ HypertranscendentalOver F a := by
  classical
  by_contra hnone
  have hAtom : ∀ {a : E}, Atom a → DifferentialAlgebraicOver F a := by
    intro a ha
    by_contra hda
    exact hnone ⟨a, ha, hda⟩
  exact hx (hcircuit.differentialAlgebraicOver hAtom)

/-- **Scalar-aware positive source extraction.**  A finite differential circuit may use arbitrary
base-field coefficients for free.  If its output is hypertranscendental, some genuine non-scalar
model atom is nevertheless hypertranscendental.  Learned weights and affine offsets therefore do
not count as hidden sources. -/
theorem exists_hypertranscendental_atom_of_scalarAwareFiniteDifferentialCircuit
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]
    {Atom : E → Prop} {x : E} (hx : HypertranscendentalOver F x)
    (hcircuit : FiniteDifferentialCircuit (BaseScalarOrAtom F E Atom) x) :
    ∃ a : E, Atom a ∧ HypertranscendentalOver F a := by
  obtain ⟨a, ha, hHT⟩ :=
    exists_hypertranscendental_atom_of_finiteDifferentialCircuit hx hcircuit
  rcases ha with ha | ⟨c, rfl⟩
  · exact ⟨a, ha, hHT⟩
  · exact (hHT (differentialAlgebraicOver_algebraMap c)).elim

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open Set

noncomputable section

/-- Adjoining a nonempty finite family is adjoining its head and then its tail. -/
theorem differentialAdjoin_fin_succ
    {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]
    {n : ℕ} (x : Fin (n + 1) → E) :
    (differentialAdjoin (differentialAdjoin F ({x 0} : Set E))
      (Set.range fun i : Fin n => x i.succ)).restrictScalars F =
        differentialAdjoin F (Set.range x) := by
  rw [differentialAdjoin, differentialAdjoin,
    IntermediateField.adjoin_adjoin_left]
  congr 1
  ext z
  constructor
  · rintro (⟨w, hw, k, rfl⟩ | ⟨w, ⟨i, rfl⟩, k, rfl⟩)
    · simp only [Set.mem_singleton_iff] at hw
      subst w
      exact ⟨x 0, ⟨0, rfl⟩, k, rfl⟩
    · exact ⟨x i.succ, ⟨i.succ, rfl⟩, k, rfl⟩
  · rintro ⟨w, ⟨i, rfl⟩, k, rfl⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · exact Set.mem_union_left _ ⟨x 0, Set.mem_singleton _, k, rfl⟩
    · exact Set.mem_union_right _ ⟨x j.succ, ⟨j, rfl⟩, k, rfl⟩

end

end GaloisForLFunctions.HTGeometry
