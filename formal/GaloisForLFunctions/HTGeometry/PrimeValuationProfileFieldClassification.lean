/-- Joint differential independence remains differential independence of the right family over
the differential field generated by the left family. -/
theorem differentialIndependent_sum_right_over_left_differentialAdjoin
    {F K ι κ : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : ι → K) (y : κ → K)
    (hxy : DifferentialIndependent F (Sum.elim x y)) :
    DifferentialIndependent (differentialAdjoin F (Set.range x)) y := by
  unfold DifferentialIndependent at hxy
  let e := Equiv.sumProdDistrib ι κ ℕ
  have hsplit : AlgebraicIndependent F
      (Sum.elim
        (fun p : ι × ℕ => differentialJet p.2 (x p.1))
        (fun p : κ × ℕ => differentialJet p.2 (y p.1))) := by
    have h := AlgebraicIndependent.comp hxy e.symm e.symm.injective
    have hfun :
        ((fun p : (ι ⊕ κ) × ℕ => differentialJet p.2 (Sum.elim x y p.1)) ∘ e.symm) =
        Sum.elim
          (fun p : ι × ℕ => differentialJet p.2 (x p.1))
          (fun p : κ × ℕ => differentialJet p.2 (y p.1)) := by
      funext p
      rcases p with p | p
      · rcases p with ⟨i, n⟩
        simp [e]
      · rcases p with ⟨k, n⟩
        simp [e]
    rw [hfun] at h
    exact h
  have hsplitSwap : AlgebraicIndependent F
      (Sum.elim
        (fun p : κ × ℕ => differentialJet p.2 (y p.1))
        (fun p : ι × ℕ => differentialJet p.2 (x p.1))) := by
    have h := AlgebraicIndependent.comp hsplit
      (Equiv.sumComm (ι × ℕ) (κ × ℕ)).symm
      (Equiv.sumComm (ι × ℕ) (κ × ℕ)).symm.injective
    simpa using h
  have hyOverAlg : AlgebraicIndependent
      (Algebra.adjoin F
        (Set.range fun p : ι × ℕ => differentialJet p.2 (x p.1)))
      (fun p : κ × ℕ => differentialJet p.2 (y p.1)) :=
    (AlgebraicIndependent.sumElim_iff.mp hsplitSwap).2
  have hyOverField : AlgebraicIndependent
      (IntermediateField.adjoin F
        (Set.range fun p : ι × ℕ => differentialJet p.2 (x p.1)))
      (fun p : κ × ℕ => differentialJet p.2 (y p.1)) :=
    IntermediateField.algebraicIndependent_adjoin_iff.mpr hyOverAlg
  have hyOverDifferentialAdjoin : AlgebraicIndependent
      (differentialAdjoin F (Set.range x))
      (fun p : κ × ℕ => differentialJet p.2 (y p.1)) := by
    have hset : differentialJetSet (Set.range x) =
        Set.range (fun p : ι × ℕ => differentialJet p.2 (x p.1)) := by
      ext z
      constructor
      · rintro ⟨w, ⟨i, rfl⟩, n, rfl⟩
        exact ⟨(i, n), rfl⟩
      · rintro ⟨⟨i, n⟩, rfl⟩
        exact ⟨x i, ⟨i, rfl⟩, n, rfl⟩
    rw [differentialAdjoin, hset]
    exact hyOverField
  exact hyOverDifferentialAdjoin

/-- No member of the right family can lie in the differential field generated by the left family
when the combined family is differentially independent. -/
theorem differentialIndependent_sum_right_not_mem_left_differentialAdjoin
    {F K ι κ : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : ι → K) (y : κ → K)
    (hxy : DifferentialIndependent F (Sum.elim x y)) (j : κ) :
    y j ∉ differentialAdjoin F (Set.range x) := by
  have hy := differentialIndependent_sum_right_over_left_differentialAdjoin x y hxy
  unfold DifferentialIndependent at hy
  intro hjmem
  have htrans : Transcendental (differentialAdjoin F (Set.range x)) (y j) := by
    simpa using hy.transcendental (j, 0)
  exact htrans (by
    simpa using isAlgebraic_algebraMap
      (R := differentialAdjoin F (Set.range x)) (A := K)
      (⟨y j, hjmem⟩ : differentialAdjoin F (Set.range x)))

/-- Differential adjunction is derivation-closed whenever the ambient derivation kills the
chosen coefficient field. -/
theorem derivationClosed_differentialAdjoin_of_constants
    (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (hconst : ∀ c : F, (algebraMap F K c)′ = 0) (s : Set K) :
    DerivationClosed (differentialAdjoin F s) := by
  intro x hx
  apply IntermediateField.adjoin_induction F (s := differentialJetSet s)
    (p := fun y _ => y′ ∈ differentialAdjoin F s)
  · rintro y ⟨z, hz, n, rfl⟩
    rw [← differentialJet_succ]
    exact differentialJet_mem_differentialAdjoin F hz (n + 1)
  · intro c
    rw [hconst]
    exact IntermediateField.zero_mem _
  · intro a b ha hb hda hdb
    rw [map_add]
    exact IntermediateField.add_mem _ hda hdb
  · intro a ha hda
    rw [Derivation.leibniz_inv]
    have hainv : a⁻¹ ∈ differentialAdjoin F s := IntermediateField.inv_mem _ ha
    have hasq : a⁻¹ ^ (2 : ℕ) ∈ differentialAdjoin F s := by
      simpa [pow_two] using IntermediateField.mul_mem _ hainv hainv
    exact IntermediateField.mul_mem _ (IntermediateField.neg_mem _ hasq) hda
  · intro a b ha hb hda hdb
    rw [Derivation.leibniz]
    exact IntermediateField.add_mem _
      (IntermediateField.mul_mem _ ha hdb) (IntermediateField.mul_mem _ hb hda)
  exact hx

namespace HTGeometry

open ArithmeticFunction

/-- A prime-radial source belongs to the differential field generated by linearly independent
prime-radial pivots exactly when its valuation profile belongs to their ordinary linear span. -/
theorem primeValuationProfile_mem_differentialAdjoin_iff_mem_span
    {d : ℕ} [Nonempty (Fin d)]
    (u : Fin d → ℕ → ℂ) (v : ℕ → ℂ)
    (g : Fin d → ArithmeticFunction ℂ) (y : ArithmeticFunction ℂ)
    (hu : LinearIndependent ℂ u)
    (hgsupport : ∀ b, SupportedOnPositivePrimePowers (g b))
    (hysupport : SupportedOnPositivePrimePowers y)
    (hgprofile : ∀ b (p : Nat.Primes) n,
      g b ((p : ℕ) ^ (n + 1)) = u b n)
    (hyprofile : ∀ (p : Nat.Primes) n,
      y ((p : ℕ) ^ (n + 1)) = v n) :
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y ∈
        differentialAdjoin ℂ
          (Set.range (fun b => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (g b))) ↔
      v ∈ Submodule.span ℂ (Set.range u) := by
  let x : Fin d → arithmeticFunctionFractionField := fun b =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (g b)
  let z : Fin 1 → arithmeticFunctionFractionField := fun _ =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y
  constructor
  · intro hymem
    by_contra hvnot
    let U : Fin (d + 1) → ℕ → ℂ := Fin.snoc u v
    let G : Fin (d + 1) → ArithmeticFunction ℂ := Fin.snoc g y
    have hU : LinearIndependent ℂ U := by
      exact linearIndependent_finSnoc.mpr ⟨hu, hvnot⟩
    have hGsupport : ∀ r, SupportedOnPositivePrimePowers (G r) := by
      intro r
      refine Fin.lastCases ?_ (fun b => ?_) r
      · simpa [G] using hysupport
      · simpa [G] using hgsupport b
    have hGprofile : ∀ r (p : Nat.Primes) n,
        G r ((p : ℕ) ^ (n + 1)) = U r n := by
      intro r p n
      refine Fin.lastCases ?_ (fun b => ?_) r
      · simpa [G, U] using hyprofile p n
      · simpa [G, U] using hgprofile b p n
    have hDIext : DifferentialIndependent ℂ
        (fun r => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (G r)) :=
      (primeValuationProfile_differentialIndependent_iff
        U G hGsupport hGprofile).2 hU
    let e : Fin d ⊕ Fin 1 ≃ Fin (d + 1) := finSumFinEquiv
    have hDIsum : DifferentialIndependent ℂ (Sum.elim x z) := by
      have hcomp := hDIext.comp e e.injective
      have hfun :
          ((fun r => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (G r)) ∘ e) = Sum.elim x z := by
        funext q
        rcases q with b | j
        · change algebraMap (ArithmeticFunction ℂ)
              arithmeticFunctionFractionField
              ((Fin.snoc g y : Fin (d + 1) → ArithmeticFunction ℂ) b.castSucc) = x b
          rw [Fin.snoc_castSucc]
        · have hj : j = 0 := Subsingleton.elim _ _
          subst j
          change algebraMap (ArithmeticFunction ℂ)
              arithmeticFunctionFractionField
              ((Fin.snoc g y : Fin (d + 1) → ArithmeticFunction ℂ) (Fin.last d)) = z 0
          rw [Fin.snoc_last]
      rw [hfun] at hcomp
      exact hcomp
    exact differentialIndependent_sum_right_not_mem_left_differentialAdjoin
      x z hDIsum 0 hymem
  · intro hv
    rw [← Fintype.range_linearCombination] at hv
    obtain ⟨A, hA⟩ := hv
    have hvA : ∀ n, v n = ∑ b, A b * u b n := by
      intro n
      have hn := congrFun hA n
      simpa [Fintype.linearCombination_apply] using hn.symm
    have heq := primeValuationProfile_differentialAdjoin_eq_pivots
      u (fun _ : Fin 1 => v) g (fun _ : Fin 1 => y) (fun _ => A)
      hgsupport (fun _ => hysupport) hgprofile (fun _ => hyprofile)
      (fun _ => hvA)
    have hzmem : z 0 ∈
        differentialAdjoin ℂ (Set.range (Sum.elim x z)) :=
      subset_differentialAdjoin ℂ _ ⟨Sum.inr 0, rfl⟩
    rw [heq] at hzmem
    exact hzmem

/-- **Relative prime-valuation hypertranscendence law.**  A new prime-radial source is
differentially independent over the differential field generated by linearly independent pivots
exactly when its valuation profile lies outside their ordinary linear span. -/
theorem primeValuationProfile_relative_differentialIndependent_iff_not_mem_span
    {d : ℕ} [Nonempty (Fin d)]
    (u : Fin d → ℕ → ℂ) (v : ℕ → ℂ)
    (g : Fin d → ArithmeticFunction ℂ) (y : ArithmeticFunction ℂ)
    (hu : LinearIndependent ℂ u)
    (hgsupport : ∀ b, SupportedOnPositivePrimePowers (g b))
    (hysupport : SupportedOnPositivePrimePowers y)
    (hgprofile : ∀ b (p : Nat.Primes) n,
      g b ((p : ℕ) ^ (n + 1)) = u b n)
    (hyprofile : ∀ (p : Nat.Primes) n,
      y ((p : ℕ) ^ (n + 1)) = v n) :
    DifferentialIndependent
        (differentialAdjoin ℂ
          (Set.range (fun b => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (g b))))
        (fun _ : Unit => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField y) ↔
      v ∉ Submodule.span ℂ (Set.range u) := by
  let x : Fin d → arithmeticFunctionFractionField := fun b =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (g b)
  let z : Fin 1 → arithmeticFunctionFractionField := fun _ =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y
  constructor
  · intro hrel hv
    have hymem :=
      (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
        u v g y hu hgsupport hysupport hgprofile hyprofile).2 hv
    unfold DifferentialIndependent at hrel
    have htrans : Transcendental
        (differentialAdjoin ℂ (Set.range x))
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y) := by
      simpa [x] using hrel.transcendental ((), 0)
    exact htrans (by
      simpa [x] using isAlgebraic_algebraMap
        (R := differentialAdjoin ℂ (Set.range x))
        (A := arithmeticFunctionFractionField)
        (⟨algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y, hymem⟩ :
          differentialAdjoin ℂ (Set.range x)))
  · intro hvnot
    let U : Fin (d + 1) → ℕ → ℂ := Fin.snoc u v
    let G : Fin (d + 1) → ArithmeticFunction ℂ := Fin.snoc g y
    have hU : LinearIndependent ℂ U :=
      linearIndependent_finSnoc.mpr ⟨hu, hvnot⟩
    have hGsupport : ∀ r, SupportedOnPositivePrimePowers (G r) := by
      intro r
      refine Fin.lastCases ?_ (fun b => ?_) r
      · simpa [G] using hysupport
      · simpa [G] using hgsupport b
    have hGprofile : ∀ r (p : Nat.Primes) n,
        G r ((p : ℕ) ^ (n + 1)) = U r n := by
      intro r p n
      refine Fin.lastCases ?_ (fun b => ?_) r
      · simpa [G, U] using hyprofile p n
      · simpa [G, U] using hgprofile b p n
    have hDIext : DifferentialIndependent ℂ
        (fun r => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (G r)) :=
      (primeValuationProfile_differentialIndependent_iff
        U G hGsupport hGprofile).2 hU
    let e : Fin d ⊕ Fin 1 ≃ Fin (d + 1) := finSumFinEquiv
    have hDIsum : DifferentialIndependent ℂ (Sum.elim x z) := by
      have hcomp := hDIext.comp e e.injective
      have hfun :
          ((fun r => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (G r)) ∘ e) = Sum.elim x z := by
        funext q
        rcases q with b | j
        · change algebraMap (ArithmeticFunction ℂ)
              arithmeticFunctionFractionField
              ((Fin.snoc g y : Fin (d + 1) → ArithmeticFunction ℂ) b.castSucc) = x b
          rw [Fin.snoc_castSucc]
        · have hj : j = 0 := Subsingleton.elim _ _
          subst j
          change algebraMap (ArithmeticFunction ℂ)
              arithmeticFunctionFractionField
              ((Fin.snoc g y : Fin (d + 1) → ArithmeticFunction ℂ) (Fin.last d)) = z 0
          rw [Fin.snoc_last]
      rw [hfun] at hcomp
      exact hcomp
    have hzrel := differentialIndependent_sum_right_over_left_differentialAdjoin x z hDIsum
    have hunit : (fun _ : Unit => algebraMap (ArithmeticFunction ℂ)
        arithmeticFunctionFractionField y) = z ∘ (fun _ : Unit => (0 : Fin 1)) := by
      funext j
      rfl
    have hcomp := hzrel.comp (fun _ : Unit => (0 : Fin 1)) (fun _ _ _ => rfl)
    simpa [x, hunit, Function.comp_def] using hcomp
/-- Hypertranscendence over the pivot-generated differential field is exactly escape from the
pivot-profile span. -/
theorem primeValuationProfile_relative_hypertranscendentalOver_iff_not_mem_span
    {d : ℕ} [Nonempty (Fin d)]
    (u : Fin d → ℕ → ℂ) (v : ℕ → ℂ)
    (g : Fin d → ArithmeticFunction ℂ) (y : ArithmeticFunction ℂ)
    (hu : LinearIndependent ℂ u)
    (hgsupport : ∀ b, SupportedOnPositivePrimePowers (g b))
    (hysupport : SupportedOnPositivePrimePowers y)
    (hgprofile : ∀ b (p : Nat.Primes) n,
      g b ((p : ℕ) ^ (n + 1)) = u b n)
    (hyprofile : ∀ (p : Nat.Primes) n,
      y ((p : ℕ) ^ (n + 1)) = v n) :
    HypertranscendentalOver
        (differentialAdjoin ℂ
          (Set.range (fun b => algebraMap (ArithmeticFunction ℂ)
            arithmeticFunctionFractionField (g b))))
        (algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField y) ↔
      v ∉ Submodule.span ℂ (Set.range u) := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  exact primeValuationProfile_relative_differentialIndependent_iff_not_mem_span
    u v g y hu hgsupport hysupport hgprofile hyprofile
/-- **Prime-valuation profile field order law.**  A finite prime-radial source family is
contained in the differential field generated by linearly independent prime-radial pivots exactly
when its profile span is contained in the pivot-profile span. -/
theorem primeValuationProfile_differentialAdjoin_le_iff_span_le
    {d e : ℕ} [Nonempty (Fin e)]
    (u : Fin d → ℕ → ℂ) (v : Fin e → ℕ → ℂ)
    (g : Fin d → ArithmeticFunction ℂ) (y : Fin e → ArithmeticFunction ℂ)
    (hv : LinearIndependent ℂ v)
    (hgsupport : ∀ b, SupportedOnPositivePrimePowers (g b))
    (hysupport : ∀ c, SupportedOnPositivePrimePowers (y c))
    (hgprofile : ∀ b (p : Nat.Primes) n,
      g b ((p : ℕ) ^ (n + 1)) = u b n)
    (hyprofile : ∀ c (p : Nat.Primes) n,
      y c ((p : ℕ) ^ (n + 1)) = v c n) :
    differentialAdjoin ℂ
        (Set.range (fun b => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (g b))) ≤
      differentialAdjoin ℂ
        (Set.range (fun c => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (y c))) ↔
      Submodule.span ℂ (Set.range u) ≤ Submodule.span ℂ (Set.range v) := by
  constructor
  · intro hfield
    rw [Submodule.span_le]
    intro w hw
    obtain ⟨b, rfl⟩ := hw
    apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
      v (u b) y (g b) hv hysupport (hgsupport b)
      hyprofile (hgprofile b)).1
    apply hfield
    exact subset_differentialAdjoin ℂ _ (Set.mem_range_self b)
  · intro hspan
    apply differentialAdjoin_le ℂ
    · intro a ha
      obtain ⟨b, rfl⟩ := ha
      apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
        v (u b) y (g b) hv hysupport (hgsupport b)
        hyprofile (hgprofile b)).2
      apply hspan
      exact Submodule.subset_span (Set.mem_range_self b)
    · exact derivationClosed_differentialAdjoin_of_constants ℂ
        arithmeticFunctionFractionField_deriv_algebraMap_complex _


/-- **Prime-valuation profile field classification, basis form.**  Two finite linearly
independent prime-radial source families generate the same embedded differential field exactly
when their valuation-profile subspaces are equal. -/
theorem primeValuationProfile_differentialAdjoin_eq_iff_span_eq
    {d e : ℕ} [Nonempty (Fin d)] [Nonempty (Fin e)]
    (u : Fin d → ℕ → ℂ) (v : Fin e → ℕ → ℂ)
    (g : Fin d → ArithmeticFunction ℂ) (y : Fin e → ArithmeticFunction ℂ)
    (hu : LinearIndependent ℂ u) (hv : LinearIndependent ℂ v)
    (hgsupport : ∀ b, SupportedOnPositivePrimePowers (g b))
    (hysupport : ∀ c, SupportedOnPositivePrimePowers (y c))
    (hgprofile : ∀ b (p : Nat.Primes) n,
      g b ((p : ℕ) ^ (n + 1)) = u b n)
    (hyprofile : ∀ c (p : Nat.Primes) n,
      y c ((p : ℕ) ^ (n + 1)) = v c n) :
    differentialAdjoin ℂ
        (Set.range (fun b => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (g b))) =
      differentialAdjoin ℂ
        (Set.range (fun c => algebraMap (ArithmeticFunction ℂ)
          arithmeticFunctionFractionField (y c))) ↔
      Submodule.span ℂ (Set.range u) = Submodule.span ℂ (Set.range v) := by
  let x : Fin d → arithmeticFunctionFractionField := fun b =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (g b)
  let z : Fin e → arithmeticFunctionFractionField := fun c =>
    algebraMap (ArithmeticFunction ℂ) arithmeticFunctionFractionField (y c)
  constructor
  · intro hfield
    apply le_antisymm
    · rw [Submodule.span_le]
      intro w hw
      obtain ⟨b, rfl⟩ := hw
      apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
        v (u b) y (g b) hv hysupport (hgsupport b)
        hyprofile (hgprofile b)).1
      rw [← hfield]
      exact subset_differentialAdjoin ℂ _ (Set.mem_range_self b)
    · rw [Submodule.span_le]
      intro w hw
      obtain ⟨c, rfl⟩ := hw
      apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
        u (v c) g (y c) hu hgsupport (hysupport c)
        hgprofile (hyprofile c)).1
      rw [hfield]
      exact subset_differentialAdjoin ℂ _ (Set.mem_range_self c)
  · intro hspan
    apply le_antisymm
    · apply differentialAdjoin_le ℂ
      · intro a ha
        obtain ⟨b, rfl⟩ := ha
        apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
          v (u b) y (g b) hv hysupport (hgsupport b)
          hyprofile (hgprofile b)).2
        rw [← hspan]
        exact Submodule.subset_span (Set.mem_range_self b)
      · exact derivationClosed_differentialAdjoin_of_constants ℂ
          arithmeticFunctionFractionField_deriv_algebraMap_complex _
    · apply differentialAdjoin_le ℂ
      · intro a ha
        obtain ⟨c, rfl⟩ := ha
        apply (primeValuationProfile_mem_differentialAdjoin_iff_mem_span
          u (v c) g (y c) hu hgsupport (hysupport c)
          hgprofile (hyprofile c)).2
        rw [hspan]
        exact Submodule.subset_span (Set.mem_range_self c)
      · exact derivationClosed_differentialAdjoin_of_constants ℂ
          arithmeticFunctionFractionField_deriv_algebraMap_complex _

