import GaloisForLFunctions.HTGeometry.DifferentialSpanningBasis

/-!
# Differential independence is the same computed in a subfield

A derivation-closed intermediate field carries the restricted derivation, so its jets are the ambient
jets.  Independence of a family of its elements therefore does not depend on whether it is read in the
subfield or in the ambient field.

This is what lets a transcendence-degree statement about a generated differential subfield be proved
by working in the big field, where the matroid lives.
-/

namespace GaloisForLFunctions

noncomputable section

variable {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]

/-- **The jets of a derivation-closed subfield are the ambient jets.** -/
theorem differentialJet_coe (L : IntermediateField F K) (hL : DerivationClosed L) (x : L) (n : ℕ) :
    letI := derivationClosedDifferential L hL
    ((differentialJet n x : L) : K) = differentialJet n (x : K) := by
  letI := derivationClosedDifferential L hL
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [differentialJet_succ, differentialJet_succ, ← ih]
      exact derivationClosedDifferential_apply L hL _

/-- **Differential independence transfers to a derivation-closed subfield.**  A family of elements of
the subfield is independent there exactly when it is independent in the ambient field. -/
theorem differentialIndependent_subfield {ι : Type*} (L : IntermediateField F K)
    (hL : DerivationClosed L) (x : ι → L)
    (h : DifferentialIndependent F fun i => ((x i : K))) :
    letI := derivationClosedDifferential L hL
    DifferentialIndependent F x := by
  letI := derivationClosedDifferential L hL
  have hinj : Function.Injective (L.val : L →ₐ[F] K) := L.val.injective
  have hcomp : (fun p : ι × ℕ => differentialJet p.2 ((x p.1 : K)))
      = (L.val : L →ₐ[F] K) ∘ fun p : ι × ℕ => differentialJet p.2 (x p.1) := by
    funext p
    exact (differentialJet_coe L hL (x p.1) p.2).symm
  show AlgebraicIndependent F fun p : ι × ℕ => differentialJet p.2 (x p.1)
  refine (AlgHom.algebraicIndependent_iff (L.val : L →ₐ[F] K) hinj).1 ?_
  have h' : AlgebraicIndependent F fun p : ι × ℕ => differentialJet p.2 ((x p.1 : K)) := h
  rwa [hcomp] at h'

/-- The lift of a family into the differential field it generates. -/
def adjoinLift (F : Type*) {K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    {ι : Type*} (x : ι → K) (i : ι) : differentialAdjoin F (Set.range x) :=
  ⟨x i, subset_differentialAdjoin F _ ⟨i, rfl⟩⟩

@[simp]
theorem adjoinLift_coe {ι : Type*} (x : ι → K) (i : ι) :
    ((adjoinLift F x i : differentialAdjoin F (Set.range x)) : K) = x i := rfl

/-- **A family generates its own differential field.**  Inside the differential field generated by a
family, that family generates everything. -/
theorem differentialAdjoin_adjoinLift_eq_top [Differential F] [DifferentialAlgebra F K]
    {ι : Type*} (x : ι → K) :
    letI := derivationClosedDifferential (differentialAdjoin F (Set.range x))
      (derivationClosed_differentialAdjoin F (Set.range x))
    differentialAdjoin F (Set.range (adjoinLift F x)) = ⊤ := by
  classical
  letI := derivationClosedDifferential (differentialAdjoin F (Set.range x))
    (derivationClosed_differentialAdjoin F (Set.range x))
  have hjet : ((differentialAdjoin F (Set.range x)).val :
        differentialAdjoin F (Set.range x) →ₐ[F] K) ''
        differentialJetSet (Set.range (adjoinLift F x))
      = differentialJetSet (Set.range x) := by
    ext z
    constructor
    · rintro ⟨w, ⟨u, ⟨i, rfl⟩, n, rfl⟩, rfl⟩
      refine ⟨x i, ⟨i, rfl⟩, n, ?_⟩
      exact (differentialJet_coe (differentialAdjoin F (Set.range x))
        (derivationClosed_differentialAdjoin F (Set.range x)) (adjoinLift F x i) n).symm
    · rintro ⟨u, ⟨i, rfl⟩, n, rfl⟩
      refine ⟨differentialJet n (adjoinLift F x i), ⟨adjoinLift F x i, ⟨i, rfl⟩, n, rfl⟩, ?_⟩
      exact differentialJet_coe (differentialAdjoin F (Set.range x))
        (derivationClosed_differentialAdjoin F (Set.range x)) (adjoinLift F x i) n
  have hmap : IntermediateField.map ((differentialAdjoin F (Set.range x)).val :
        differentialAdjoin F (Set.range x) →ₐ[F] K)
      (differentialAdjoin F (Set.range (adjoinLift F x))) = differentialAdjoin F (Set.range x) := by
    show IntermediateField.map ((differentialAdjoin F (Set.range x)).val :
        differentialAdjoin F (Set.range x) →ₐ[F] K)
        (IntermediateField.adjoin F (differentialJetSet (Set.range (adjoinLift F x))))
      = IntermediateField.adjoin F (differentialJetSet (Set.range x))
    rw [IntermediateField.adjoin_map, hjet]
  refine eq_top_iff.2 fun t _ => ?_
  have ht : (t : K) ∈ IntermediateField.map ((differentialAdjoin F (Set.range x)).val :
      differentialAdjoin F (Set.range x) →ₐ[F] K)
      (differentialAdjoin F (Set.range (adjoinLift F x))) := by
    rw [hmap]
    exact t.2
  obtain ⟨s, hs, hst⟩ := (IntermediateField.mem_map _).1 ht
  have hts : s = t := Subtype.ext hst
  rwa [hts] at hs

/-- **The differential transcendence degree of a generated subfield.**  An injective family of at most
`dtrdeg`-many elements over which the whole field is differentially algebraic generates a subfield of
differential transcendence degree exactly its own size.

This is the dimension count for a persistent sector: the field generated by a spanning family carries
exactly as many differential degrees of freedom as the family has members. -/
theorem differentialTranscendenceDegree_differentialAdjoin_eq {F K : Type u} [Field F] [Field K]
    [Algebra F K] [Differential F] [Differential K] [DifferentialAlgebra F K] [CharZero K]
    {ι : Type u} [Finite ι] [Nonempty ι] (x : ι → K) (hinj : Function.Injective x)
    (hspan : ∀ y : K, DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y)
    (hcard : Cardinal.mk ι ≤ differentialTranscendenceDegree F K) :
    letI := derivationClosedDifferential (differentialAdjoin F (Set.range x))
      (derivationClosed_differentialAdjoin F (Set.range x))
    differentialTranscendenceDegree F (differentialAdjoin F (Set.range x)) = Cardinal.mk ι := by
  letI := derivationClosedDifferential (differentialAdjoin F (Set.range x))
    (derivationClosed_differentialAdjoin F (Set.range x))
  have hind : DifferentialIndependent F x :=
    differentialIndependent_of_spanning_of_cardinalMk_le x hinj hspan hcard
  have hlift : DifferentialIndependent F (adjoinLift F x) := by
    refine differentialIndependent_subfield (differentialAdjoin F (Set.range x))
      (derivationClosed_differentialAdjoin F (Set.range x)) (adjoinLift F x) ?_
    simpa using hind
  exact differentialTranscendenceDegree_eq_cardinalMk_of_differentialIndependent_of_adjoin_eq_top
    (adjoinLift F x) hlift (differentialAdjoin_adjoinLift_eq_top x)

end

end GaloisForLFunctions
