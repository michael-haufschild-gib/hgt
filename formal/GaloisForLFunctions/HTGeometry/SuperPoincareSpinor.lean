import GaloisForLFunctions.HTGeometry.HiggsSpinorNullCone
import GaloisForLFunctions.HTGeometry.SuperPoincareAlgebra

/-!
# Four-dimensional Weyl-spinor supertranslations

Polarization of the existing spinor outer square gives the symmetric odd-odd bracket.  On the
diagonal it closes onto twice the existing positive Lorentz-null Hermitian momentum.  This is the
translation sector of the four-dimensional `N = 1` Super-Poincare algebra; no Lorentz-action or
field equation is added.
-/

open Matrix
open scoped ComplexOrder Matrix

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Polarized Weyl-spinor odd-odd bracket. -/
def weylSuperTranslationBracket (psi chi : Fin 2 → ℂ) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.vecMulVec psi (star chi) + Matrix.vecMulVec chi (star psi)

/-- Momentum matrix generated by a Weyl spinor. -/
def weylSuperMomentum (psi : Fin 2 → ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  higgsSpinorEventMatrix psi

theorem weylSuperTranslationBracket_symm (psi chi : Fin 2 → ℂ) :
    weylSuperTranslationBracket psi chi = weylSuperTranslationBracket chi psi := by
  simp only [weylSuperTranslationBracket, add_comm]

/-- Mixed Weyl brackets are Hermitian momentum matrices. -/
theorem weylSuperTranslationBracket_isHermitian (psi chi : Fin 2 → ℂ) :
    (weylSuperTranslationBracket psi chi).IsHermitian := by
  ext i j
  simp [weylSuperTranslationBracket, Matrix.conjTranspose_apply,
    Matrix.vecMulVec_apply, mul_comm, add_comm]

/-- Super-Poincare closure `{Q(psi), Q(psi)} = 2 P(psi)`. -/
theorem weylSuperTranslationBracket_self (psi : Fin 2 → ℂ) :
    weylSuperTranslationBracket psi psi = (2 : ℂ) • weylSuperMomentum psi := by
  ext i j
  simp [weylSuperTranslationBracket, weylSuperMomentum, higgsSpinorEventMatrix,
    Matrix.vecMulVec_apply]
  ring

/-- Spinor-generated momentum lies in the closed future light cone, on its null boundary. -/
theorem weylSuperMomentum_future_null (psi : Fin 2 → ℂ) :
    0 ≤ higgsSpinorTime psi ∧
      higgsSpinorTime psi ^ (2 : ℕ) - higgsSpinorX psi ^ (2 : ℕ) -
        higgsSpinorY psi ^ (2 : ℕ) - higgsSpinorZ psi ^ (2 : ℕ) = 0 :=
  ⟨higgsSpinorTime_nonneg psi, higgsSpinor_lorentzQuadratic_eq_zero psi⟩

/-- Existing Higgs-spinor coordinates are exactly the supermomentum coordinates. -/
theorem weylSuperMomentum_eq_lorentzHermitianMatrix (psi : Fin 2 → ℂ) :
    weylSuperMomentum psi =
      lorentzHermitianMatrix
        (higgsSpinorTime psi) (higgsSpinorX psi) (higgsSpinorY psi) (higgsSpinorZ psi) :=
  higgsSpinorEventMatrix_eq_lorentzHermitianMatrix psi

end GaloisForLFunctions.HTGeometry
