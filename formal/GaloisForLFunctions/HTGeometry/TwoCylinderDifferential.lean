import GaloisForLFunctions.HTGeometry.PolynomialTotalDerivative
import GaloisForLFunctions.HTGeometry.CylinderDifferentialCharacter
import GaloisForLFunctions.HTGeometry.FractionRingDerivation

/-!
# The two-cylinder differential field

The second cylinder coordinate of a double-sine frame is an exponential over the function field of
the first, so the derivation of `K(X)` that models differentiation in `z` moves both the coefficient
field `K` and the coordinate `X`:

```text
D(f) = (coefficientwise derivation of K)(f) + lam * X * (d/dX) f.
```

It is built by extending the corresponding polynomial derivation across the fraction field.  On the
subfield generated by `X` over the differential constants the coefficient term drops out and `D`
reduces to the pure cylinder derivation, which is what makes the cotangent jets of the double-sine
increment computable in the one-variable model.
-/

open Polynomial
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

theorem coeffDeriv_mul (p q : Polynomial R) :
    coeffDeriv (p * q) = coeffDeriv p * q + p * coeffDeriv q := by
  classical
  refine Polynomial.ext fun n => ?_
  rw [coeffDeriv_coeff, Polynomial.coeff_add, Polynomial.coeff_mul, Polynomial.coeff_mul,
    Polynomial.coeff_mul, map_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Derivation.leibniz, coeffDeriv_coeff, coeffDeriv_coeff]
  simp only [smul_eq_mul]
  ring

@[simp] theorem coeffDeriv_one : coeffDeriv (1 : Polynomial R) = 0 := by
  refine Polynomial.ext fun n => ?_
  rw [coeffDeriv_coeff, Polynomial.coeff_zero, Polynomial.coeff_one]
  by_cases h : n = 0
  · rw [if_pos h]
    exact Derivation.map_one_eq_zero _
  · rw [if_neg h, map_zero]

/-- The coefficient derivation as an additive map. -/
def coeffDerivHom (R : Type*) [CommRing R] [Differential R] : Polynomial R →+ Polynomial R where
  toFun := coeffDeriv
  map_zero' := coeffDeriv_zero
  map_add' := coeffDeriv_add

@[simp] theorem coeffDerivHom_apply (p : Polynomial R) : coeffDerivHom R p = coeffDeriv p := rfl


/-- Two Leibniz operators that agree on a numerator and a denominator agree on the quotient. -/
theorem eq_of_leibniz_div {F : Type*} [Field F] (D₁ D₂ : F → F)
    (h₁ : ∀ x y : F, D₁ (x * y) = x * D₁ y + y * D₁ x)
    (h₂ : ∀ x y : F, D₂ (x * y) = x * D₂ y + y * D₂ x)
    {a b : F} (hb : b ≠ 0) (ha : D₁ a = D₂ a) (hbd : D₁ b = D₂ b) :
    D₁ (a / b) = D₂ (a / b) := by
  have hab : a = a / b * b := by field_simp
  have e₁ : D₁ a = a / b * D₁ b + b * D₁ (a / b) := by
    conv_lhs => rw [hab]
    rw [h₁]
  have e₂ : D₂ a = a / b * D₂ b + b * D₂ (a / b) := by
    conv_lhs => rw [hab]
    rw [h₂]
  have hmul : b * D₁ (a / b) = b * D₂ (a / b) := by
    rw [ha, hbd] at e₁
    linear_combination e₂ - e₁
  exact mul_left_cancel₀ hb hmul


/-- The quotient rule for any Leibniz operator on a field. -/
theorem leibniz_div {F : Type*} [Field F] (D : F → F)
    (h : ∀ x y : F, D (x * y) = x * D y + y * D x)
    {a b : F} (hb : b ≠ 0) : D (a / b) = (D a * b - a * D b) / b ^ (2 : ℕ) := by
  set c : F := a / b with hc
  have hab : a = c * b := by
    rw [hc]
    field_simp
  have e : D a = c * D b + b * D c := by
    conv_lhs => rw [hab]
    rw [h]
  rw [eq_div_iff (pow_ne_zero 2 hb)]
  linear_combination (-b) * e + (D b) * hab

variable {C K : Type*} [Field C] [Field K] [Algebra C K]

/-- Extension of the coefficient field of a rational function field. -/
def coeffExtend : RatFunc C →+* RatFunc K :=
  RatFunc.mapRingHom (Polynomial.mapRingHom (algebraMap C K))
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
      (Polynomial.map_injective _ (algebraMap C K).injective))

theorem coeffExtend_div (p s : Polynomial C) :
    coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) p /
        algebraMap (Polynomial C) (RatFunc C) s)
      = algebraMap (Polynomial K) (RatFunc K) (p.map (algebraMap C K)) /
        algebraMap (Polynomial K) (RatFunc K) (s.map (algebraMap C K)) := by
  show RatFunc.mapRingHom (Polynomial.mapRingHom (algebraMap C K)) _ _ = _
  rw [show ((RatFunc.mapRingHom (Polynomial.mapRingHom (algebraMap C K))
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
        (Polynomial.map_injective _ (algebraMap C K).injective)) :
        RatFunc C →+* RatFunc K) : RatFunc C → RatFunc K)
      = RatFunc.map (Polynomial.mapRingHom (algebraMap C K)) _ from
    RatFunc.coe_mapRingHom_eq_coe_map _ _]
  exact RatFunc.map_apply_div _ _ p s

@[simp] theorem coeffExtend_algebraMap (p : Polynomial C) :
    coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) p)
      = algebraMap (Polynomial K) (RatFunc K) (p.map (algebraMap C K)) := by
  have h := coeffExtend_div (K := K) p 1
  rwa [map_one, div_one, Polynomial.map_one, map_one, div_one] at h

@[simp] theorem coeffExtend_base (c : C) :
    coeffExtend (K := K) (algebraMap C (RatFunc C) c)
      = algebraMap K (RatFunc K) (algebraMap C K c) := by
  rw [algebraMap_ratFunc_eq_polynomialC, coeffExtend_algebraMap, Polynomial.map_C,
    algebraMap_ratFunc_eq_polynomialC]

@[simp] theorem coeffExtend_X :
    coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) Polynomial.X)
      = algebraMap (Polynomial K) (RatFunc K) Polynomial.X := by
  rw [coeffExtend_algebraMap, Polynomial.map_X]

/-- **The cylinder derivation commutes with coefficient extension.** -/
theorem cylDeriv_coeffExtend (lam : C) (y : RatFunc C) :
    cylDeriv (algebraMap C K lam) (coeffExtend y) = coeffExtend (cylDeriv lam y) := by
  refine RatFunc.induction_on
    (P := fun y => cylDeriv (algebraMap C K lam) (coeffExtend (K := K) y)
      = coeffExtend (cylDeriv lam y)) y ?_
  intro p s hs
  have hspoly : algebraMap (Polynomial C) (RatFunc C) s ≠ 0 := RatFunc.algebraMap_ne_zero hs
  have hsK : coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) s) ≠ 0 := by
    rw [coeffExtend_algebraMap]
    exact RatFunc.algebraMap_ne_zero fun hcon =>
      hs ((Polynomial.map_eq_zero_iff (algebraMap C K).injective).mp hcon)
  have hpoly : ∀ p : Polynomial C,
      cylDeriv (algebraMap C K lam) (coeffExtend (K := K)
          (algebraMap (Polynomial C) (RatFunc C) p))
        = coeffExtend (cylDeriv lam (algebraMap (Polynomial C) (RatFunc C) p)) := by
    intro p
    rw [coeffExtend_algebraMap, cylDeriv, cylDeriv, ratFuncEulerOp, ratFuncEulerOp,
      ratFuncDerivative_algebraMap, ratFuncDerivative_algebraMap, map_mul, map_mul,
      coeffExtend_base, coeffExtend_X, coeffExtend_algebraMap, Polynomial.derivative_map]
  rw [map_div₀, leibniz_div _ (cylDeriv_mul (algebraMap C K lam)) hsK,
    leibniz_div _ (cylDeriv_mul lam) hspoly, map_div₀, map_sub, map_mul, map_mul, map_pow,
    hpoly, hpoly]


variable {K : Type*} [Field K] [Differential K]

local instance tcIntAlgebraPoly : Algebra ℤ (Polynomial K) := Ring.toIntAlgebra _
local instance tcIntAlgebraRatFunc : Algebra ℤ (RatFunc K) := Ring.toIntAlgebra _

local instance tcIntTower : IsScalarTower ℤ (Polynomial K) (RatFunc K) :=
  IsScalarTower.of_algebraMap_eq fun n => by
    show ((n : ℤ) : RatFunc K) = algebraMap (Polynomial K) (RatFunc K) ((n : ℤ) : Polynomial K)
    rw [map_intCast]

/-- The total polynomial derivation of the second cylinder: the coefficients are differentiated by
the ambient derivation of `K`, and the variable is an exponential of logarithmic derivative
`lam`. -/
def twoCylPolyDerivation (lam : K) : Derivation ℤ (Polynomial K) (RatFunc K) where
  toFun p := algebraMap (Polynomial K) (RatFunc K) (coeffDeriv p)
      + algebraMap K (RatFunc K) lam * algebraMap (Polynomial K) (RatFunc K) Polynomial.X
        * algebraMap (Polynomial K) (RatFunc K) (Polynomial.derivative p)
  map_add' p q := by
    simp only [coeffDeriv_add, map_add]
    ring
  map_smul' n p := by
    simp only [RingHom.id_apply]
    rw [show coeffDeriv (n • p) = n • coeffDeriv p from map_zsmul (coeffDerivHom K) n p,
      show Polynomial.derivative (n • p) = n • Polynomial.derivative p from
        map_zsmul (Polynomial.derivative (R := K)) n p, map_zsmul, map_zsmul]
    rw [smul_add, mul_smul_comm]
  map_one_eq_zero' := by
    simp
  leibniz' p q := by
    simp only [LinearMap.coe_mk, AddHom.coe_mk, Algebra.smul_def, coeffDeriv_mul,
      Polynomial.derivative_mul, map_add, map_mul]
    ring

@[simp] theorem twoCylPolyDerivation_apply (lam : K) (p : Polynomial K) :
    twoCylPolyDerivation lam p
      = algebraMap (Polynomial K) (RatFunc K) (coeffDeriv p)
        + algebraMap K (RatFunc K) lam * algebraMap (Polynomial K) (RatFunc K) Polynomial.X
          * algebraMap (Polynomial K) (RatFunc K) (Polynomial.derivative p) := rfl

/-- The two-cylinder derivation of `K(X)`: the coefficient field moves with the ambient derivation
of `K` and the coordinate `X` is an exponential with logarithmic derivative `lam`. -/
def twoCylDerivation (lam : K) : Derivation ℤ (RatFunc K) (RatFunc K) :=
  GaloisForLFunctions.fractionRingDerivation (twoCylPolyDerivation lam)

@[simp] theorem twoCylDerivation_algebraMap (lam : K) (p : Polynomial K) :
    twoCylDerivation lam (algebraMap (Polynomial K) (RatFunc K) p)
      = algebraMap (Polynomial K) (RatFunc K) (coeffDeriv p)
        + algebraMap K (RatFunc K) lam * algebraMap (Polynomial K) (RatFunc K) Polynomial.X
          * algebraMap (Polynomial K) (RatFunc K) (Polynomial.derivative p) :=
  GaloisForLFunctions.fractionRingDerivation_algebraMap (twoCylPolyDerivation lam) p

/-- The differential structure on `K(X)` in which `K` keeps its own derivation and the coordinate
is an exponential of logarithmic derivative `lam`. -/
@[reducible] def twoCylinderDifferential (lam : K) : Differential (RatFunc K) where
  deriv := twoCylDerivation lam

theorem twoCylinderDifferential_deriv (lam : K) (y : RatFunc K) :
    letI := twoCylinderDifferential lam
    y′ = twoCylDerivation lam y := rfl

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {C K : Type*} [Field C] [Field K] [Algebra C K] [Differential K]

local instance tcJetIntAlgebraPoly : Algebra ℤ (Polynomial K) := Ring.toIntAlgebra _
local instance tcJetIntAlgebraRatFunc : Algebra ℤ (RatFunc K) := Ring.toIntAlgebra _

local instance tcJetIntTower : IsScalarTower ℤ (Polynomial K) (RatFunc K) :=
  IsScalarTower.of_algebraMap_eq fun n => by
    show ((n : ℤ) : RatFunc K) = algebraMap (Polynomial K) (RatFunc K) ((n : ℤ) : Polynomial K)
    rw [map_intCast]

/-- Coefficients pulled back from the differential constants are constant. -/
theorem coeffDeriv_map_algebraMap (hC : ∀ c : C, (algebraMap C K c)′ = 0) (p : Polynomial C) :
    coeffDeriv (p.map (algebraMap C K)) = 0 := by
  refine Polynomial.ext fun n => ?_
  rw [coeffDeriv_coeff, Polynomial.coeff_map, hC, Polynomial.coeff_zero]

theorem twoCylDerivation_leibniz (lam : K) (x y : RatFunc K) :
    twoCylDerivation lam (x * y) = x * twoCylDerivation lam y + y * twoCylDerivation lam x := by
  rw [Derivation.leibniz]
  simp only [smul_eq_mul]

/-- **On the subfield generated by the coordinate over the constants the two-cylinder derivation is
the pure cylinder derivation.** -/
theorem twoCylDerivation_coeffExtend (hC : ∀ c : C, (algebraMap C K c)′ = 0) (lam : K)
    (y : RatFunc C) :
    twoCylDerivation lam (coeffExtend (K := K) y) = cylDeriv lam (coeffExtend y) := by
  have hpoly : ∀ p : Polynomial C,
      twoCylDerivation lam (coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) p))
        = cylDeriv lam (coeffExtend (algebraMap (Polynomial C) (RatFunc C) p)) := by
    intro p
    rw [coeffExtend_algebraMap, twoCylDerivation_algebraMap, coeffDeriv_map_algebraMap hC,
      map_zero, zero_add, cylDeriv, ratFuncEulerOp, ratFuncDerivative_algebraMap]
    ring
  refine RatFunc.induction_on
    (P := fun y => twoCylDerivation lam (coeffExtend (K := K) y)
      = cylDeriv lam (coeffExtend y)) y ?_
  intro p s hs
  have hsK : coeffExtend (K := K) (algebraMap (Polynomial C) (RatFunc C) s) ≠ 0 := by
    rw [coeffExtend_algebraMap]
    exact RatFunc.algebraMap_ne_zero fun hcon =>
      hs ((Polynomial.map_eq_zero_iff (algebraMap C K).injective).mp hcon)
  rw [map_div₀]
  exact eq_of_leibniz_div _ _ (twoCylDerivation_leibniz lam) (cylDeriv_mul lam) hsK
    (hpoly p) (hpoly s)

omit [Differential K] in
theorem cylDeriv_iterate_coeffExtend (lam : C) (n : ℕ) (y : RatFunc C) :
    (cylDeriv (algebraMap C K lam))^[n] (coeffExtend y) = coeffExtend ((cylDeriv lam)^[n] y) := by
  induction n generalizing y with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, cylDeriv_coeffExtend, ih]

theorem twoCylDerivation_iterate_coeffExtend (hC : ∀ c : C, (algebraMap C K c)′ = 0) (lam : C)
    (n : ℕ) (y : RatFunc C) :
    (twoCylDerivation (algebraMap C K lam))^[n] (coeffExtend y)
      = coeffExtend ((cylDeriv lam)^[n] y) := by
  induction n generalizing y with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply,
        twoCylDerivation_coeffExtend hC, cylDeriv_coeffExtend, ih]

/-- **The differential jets of a constant-coefficient element are the one-variable cylinder
jets.** -/
theorem differentialJet_twoCylinder (hC : ∀ c : C, (algebraMap C K c)′ = 0) (lam : C) (n : ℕ)
    (y : RatFunc C) :
    letI := twoCylinderDifferential (algebraMap C K lam)
    differentialJet n (coeffExtend (K := K) y)
      = (cylDeriv (algebraMap C K lam))^[n] (coeffExtend y) := by
  letI := twoCylinderDifferential (algebraMap C K lam)
  have hiter : ∀ (m : ℕ) (z : RatFunc C),
      differentialJet m (coeffExtend (K := K) z)
        = (twoCylDerivation (algebraMap C K lam))^[m] (coeffExtend z) := by
    intro m
    induction m with
    | zero => intro z; simp [differentialJet]
    | succ m ih =>
        intro z
        rw [differentialJet_succ, ih, Function.iterate_succ_apply']
        rfl
  rw [hiter, twoCylDerivation_iterate_coeffExtend hC, cylDeriv_iterate_coeffExtend]

omit [Differential K] in
theorem coeffExtend_cotModel (c : C) :
    coeffExtend (K := K) (cotModel c) = cotModel (algebraMap C K c) := by
  rw [cotModel, cotModel, map_div₀, coeffExtend_algebraMap, coeffExtend_algebraMap]
  congr 2 <;> simp [linFac, Polynomial.map_mul, Polynomial.map_add, Polynomial.map_sub]

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K : Type*} [Field K] [Differential K]

local instance tcDivIntAlgebraPoly : Algebra ℤ (Polynomial K) := Ring.toIntAlgebra _
local instance tcDivIntAlgebraRatFunc : Algebra ℤ (RatFunc K) := Ring.toIntAlgebra _

local instance tcDivIntTower : IsScalarTower ℤ (Polynomial K) (RatFunc K) :=
  IsScalarTower.of_algebraMap_eq fun n => by
    show ((n : ℤ) : RatFunc K) = algebraMap (Polynomial K) (RatFunc K) ((n : ℤ) : Polynomial K)
    rw [map_intCast]

/-- The quotient rule for the two-cylinder derivation. -/
theorem twoCylDerivation_div (lam : K) (a b : RatFunc K) (hb : b ≠ 0) :
    twoCylDerivation lam (a / b)
      = (twoCylDerivation lam a * b - a * twoCylDerivation lam b) / b ^ (2 : ℕ) :=
  leibniz_div _ (twoCylDerivation_leibniz lam) hb

end

end GaloisForLFunctions.HTGeometry
