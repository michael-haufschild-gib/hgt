import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.FieldTheory.IntermediateField.Basic

/-!
# A polynomial descends to any subfield containing its coefficients

A multivariable polynomial whose coefficients all lie in a smaller coefficient field is the image of a
polynomial over that field, and the descended polynomial has the same support.

This is what lets a relation be replaced by a relation over the field generated by its own
coefficients, which is the move a Lüroth argument makes after choosing a minimal characteristic
relation.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

variable {F E : Type*} [Field F] [Field E] [Algebra F E] {σ : Type*}

/-- The descent of a polynomial to a subfield containing its coefficients. -/
def descendCoefficients {G₀ G : IntermediateField F E} (_h : G₀ ≤ G) (P : MvPolynomial σ G)
    (hc : ∀ m, ((P.coeff m : G) : E) ∈ G₀) : MvPolynomial σ G₀ :=
  ∑ m ∈ P.support, MvPolynomial.monomial m (⟨((P.coeff m : G) : E), hc m⟩ : G₀)

@[simp]
theorem coeff_descendCoefficients {G₀ G : IntermediateField F E} (h : G₀ ≤ G)
    (P : MvPolynomial σ G) (hc : ∀ m, ((P.coeff m : G) : E) ∈ G₀) (m : σ →₀ ℕ) :
    (((descendCoefficients h P hc).coeff m : G₀) : E) = ((P.coeff m : G) : E) := by
  classical
  rw [descendCoefficients, MvPolynomial.coeff_sum]
  by_cases hm : m ∈ P.support
  · rw [Finset.sum_eq_single_of_mem m hm]
    · rw [MvPolynomial.coeff_monomial, if_pos rfl]
    · intro n _ hnm
      rw [MvPolynomial.coeff_monomial, if_neg hnm]
  · have hzero : P.coeff m = 0 := by
      simpa using (MvPolynomial.notMem_support_iff).1 hm
    rw [Finset.sum_eq_zero, hzero]
    · rfl
    · intro n hn
      rw [MvPolynomial.coeff_monomial, if_neg]
      intro hnm
      exact hm (hnm ▸ hn)

/-- **A polynomial with coefficients in a subfield is the image of a polynomial over it.** -/
theorem map_descendCoefficients {G₀ G : IntermediateField F E} (h : G₀ ≤ G)
    (P : MvPolynomial σ G) (hc : ∀ m, ((P.coeff m : G) : E) ∈ G₀) :
    MvPolynomial.map (IntermediateField.inclusion h : G₀ →ₐ[F] G).toRingHom
        (descendCoefficients h P hc) = P := by
  classical
  refine MvPolynomial.ext _ _ fun m => ?_
  rw [MvPolynomial.coeff_map]
  refine Subtype.ext ?_
  exact coeff_descendCoefficients h P hc m

end

end GaloisForLFunctions.HTGeometry
