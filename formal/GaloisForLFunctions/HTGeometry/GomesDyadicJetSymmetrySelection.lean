import GaloisForLFunctions.HTGeometry.GomesTruncatedJetSymmetryDimension
import GaloisForLFunctions.HTGeometry.GomesTruncatedJetUnitSymmetries

/-!
# Exact surviving symmetries for the corpus's named dyadic phases

The existing Bottcher dyadic multiplier fixes the entire answer: coefficient
weights are multiples of 2^k, the joint algebra is generated by D^(2^k), and
its dimension and scalar-collapse horizon are explicit at every depth.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry.GammaFactorialFock

/-- The actual named dyadic phase retains precisely the coefficients at its integral weight lattice. -/
theorem gomesDyadicJetClock_formal_commute_iff (n k : ℕ) (F : PowerSeries ℂ) :
    Commute (gomesFiniteFockFormalHom (n + 1) F)
        (RHTower.truncatedJetClock n (Bottcher.dyadicRoot k)) ↔
      ∀ j : Fin (n + 1), PowerSeries.coeff j.val F = 0 ∨ 2 ^ k ∣ j.val := by
  rw [gomesTruncatedJetClock_formal_commute_iff_order, Bottcher.orderOf_dyadicRoot_named]

/-- The named depth-k geometric clock selects exactly the corresponding dyadic power algebra. -/
theorem gomesDyadicJetJointAlgebra_eq_adjoin (n k : ℕ) :
    gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot k) =
      Algebra.adjoin ℂ {fockShiftMatrix (n + 1) ^ (2 ^ k)} := by
  rw [gomesTruncatedJetJointAlgebra_eq_adjoin_orderPower, Bottcher.orderOf_dyadicRoot_named]

/-- The number of independent symmetries surviving the actual dyadic structure is exact at every horizon. -/
theorem gomesDyadicJetJointAlgebra_finrank (n k : ℕ) :
    Module.finrank ℂ (gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot k)) =
      n / (2 ^ k) + 1 := by
  rw [gomesTruncatedJetJointAlgebra_finrank, Bottcher.orderOf_dyadicRoot_named]

/-- The dyadic geometric structure reduces all joint symmetries to scalars exactly when its order reaches the horizon. -/
theorem gomesDyadicJetJointAlgebra_eq_bot_iff (n k : ℕ) :
    gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot k) = ⊥ ↔ n + 1 ≤ 2 ^ k := by
  rw [gomesTruncatedJetJointAlgebra_eq_bot_iff, Bottcher.orderOf_dyadicRoot_named,
    or_iff_right (pow_ne_zero k (Nat.ne_of_gt (Nat.succ_pos 1)))]

/-- Increasing actual dyadic depth can only remove joint matrix symmetries. -/
theorem gomesDyadicJetJointAlgebra_succ_le (n k : ℕ) :
    gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot (k + 1)) ≤
      gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot k) := by
  rw [gomesDyadicJetJointAlgebra_eq_adjoin, gomesDyadicJetJointAlgebra_eq_adjoin]
  apply Algebra.adjoin_singleton_le
  rw [pow_succ, pow_mul]
  exact (Algebra.adjoin ℂ {fockShiftMatrix (n + 1) ^ (2 ^ k)}).pow_mem
    (Algebra.subset_adjoin (Set.mem_singleton _)) 2

/-- The sharp dyadic survival boundary is realized by actual invertible, non-scalar symmetries. -/
theorem gomesDyadicJetJointAlgebra_exists_nonscalar_unit_iff (n k : ℕ) :
    (∃ M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ,
      IsUnit M ∧ M ∈ gomesTruncatedJetJointAlgebra n (Bottcher.dyadicRoot k) ∧
        M ∉ (⊥ : Subalgebra ℂ (Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ))) ↔
      2 ^ k < n + 1 := by
  rw [gomesTruncatedJetJointAlgebra_exists_nonscalar_unit_iff, Bottcher.orderOf_dyadicRoot_named,
    and_iff_right (Nat.pow_pos (Nat.succ_pos 1))]

end GaloisForLFunctions.HTGeometry.GammaFactorialFock
