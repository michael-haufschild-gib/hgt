import GaloisForLFunctions.HTGeometry.FacePacketFieldTranslation
import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaUnitPeriod
import GaloisForLFunctions.HTGeometry.MeromorphicRankThreeSourceBoundary
import GaloisForLFunctions.HTGeometry.ElementaryOstrowski

/-!
# The rank-three difference system of a face packet

The descending face-lifting argument runs the several-automorphism Ostrowski criterion on the
translation block of one face over the differential field generated by the deeper faces.  Its three
structural directions are the unit period and two surviving parameters `tau_q, tau_u`: the unit
period acts trivially on the whole hierarchy, and the two surviving directions displace a packet
element by a member of the next packet.  Their joint fixed field in the meromorphic field is exactly
the constants, because three periods with `1, tau_q, tau_u` rationally independent generate a
nondiscrete group.

* `meroTranslationRestrict` — a translation stabilizing an intermediate field in both directions
  restricts to a ring automorphism of it;
* **`facePacketDifferenceSystem`** — the three restricted translations as a commuting
  difference-differential structure on the deeper face field;
* **`facePacketBlock`**, **`facePacketDisplacement`** — the translation block of the face and its
  displacements, which lie in the deeper field;
* **`facePacket_differentialIndependent_of_no_telescoping`** — the descending face-lifting lemma,
  reduced to the exclusion of a simultaneous jet telescoper.
-/

open Filter Topology Set Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher HTGeometry

noncomputable section

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## Restricting a translation to a stable intermediate field -/

/-- A translation which stabilizes an intermediate field in both directions restricts to a ring
automorphism of it. -/
def meroTranslationRestrict (E : IntermediateField ℂ (meroField (Set.univ : Set ℂ))) (g : ℂ)
    (hfwd : ∀ x ∈ E, addTranslationMeroEquiv g x ∈ E)
    (hbwd : ∀ x ∈ E, addTranslationMeroEquiv (-g) x ∈ E) : E ≃+* E where
  toFun x := ⟨addTranslationMeroEquiv g (x : meroField (Set.univ : Set ℂ)), hfwd _ x.2⟩
  invFun x := ⟨addTranslationMeroEquiv (-g) (x : meroField (Set.univ : Set ℂ)), hbwd _ x.2⟩
  left_inv x := by
    apply Subtype.ext
    show addTranslationMeroEquiv (-g)
      (addTranslationMeroEquiv g (x : meroField (Set.univ : Set ℂ))) = _
    rw [addTranslationMeroEquiv_add, neg_add_cancel, addTranslationMeroEquiv_zero_apply]
  right_inv x := by
    apply Subtype.ext
    show addTranslationMeroEquiv g
      (addTranslationMeroEquiv (-g) (x : meroField (Set.univ : Set ℂ))) = _
    rw [addTranslationMeroEquiv_add, add_neg_cancel, addTranslationMeroEquiv_zero_apply]
  map_mul' x y := by
    apply Subtype.ext
    show addTranslationMeroEquiv g
      ((x : meroField (Set.univ : Set ℂ)) * (y : meroField (Set.univ : Set ℂ))) = _
    rw [map_mul]
    rfl
  map_add' x y := by
    apply Subtype.ext
    show addTranslationMeroEquiv g
      ((x : meroField (Set.univ : Set ℂ)) + (y : meroField (Set.univ : Set ℂ))) = _
    rw [map_add]
    rfl

@[simp]
theorem meroTranslationRestrict_coe (E : IntermediateField ℂ (meroField (Set.univ : Set ℂ)))
    (g : ℂ) (hfwd : ∀ x ∈ E, addTranslationMeroEquiv g x ∈ E)
    (hbwd : ∀ x ∈ E, addTranslationMeroEquiv (-g) x ∈ E) (x : E) :
    ((meroTranslationRestrict E g hfwd hbwd x : E) : meroField (Set.univ : Set ℂ)) =
      addTranslationMeroEquiv g (x : meroField (Set.univ : Set ℂ)) := rfl

set_option synthInstance.maxHeartbeats 400000 in
/-- A translation fixing every generator of a generated differential field fixes the whole
field. -/
theorem differentialAdjoin_fixed_of_generators (g : ℂ) (T : Set (meroField (Set.univ : Set ℂ)))
    (hgen : ∀ y ∈ T, addTranslationMeroEquiv g y = y)
    {x : meroField (Set.univ : Set ℂ)} (hx : x ∈ differentialAdjoin ℂ T) :
    addTranslationMeroEquiv g x = x := by
  classical
  let p : ∀ y : meroField (Set.univ : Set ℂ), y ∈ differentialAdjoin ℂ T → Prop :=
    fun y _ => addTranslationMeroEquiv g y = y
  change p x hx
  refine IntermediateField.adjoin_induction ℂ (p := p) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨y₀, hy₀, n, rfl⟩
    have hjet : addTranslationMeroEquiv g (differentialJet n y₀) =
        differentialJet n (addTranslationMeroEquiv g y₀) := by
      simpa using (addTranslationMeroDifferentialAlgEquiv g).map_differentialJet n y₀
    show addTranslationMeroEquiv g (differentialJet n y₀) = differentialJet n y₀
    rw [hjet, hgen y₀ hy₀]
  · intro c
    exact addTranslationMeroEquiv_algebraMap_complex g c
  · intro y z _ _ hy hz
    show addTranslationMeroEquiv g (y + z) = y + z
    rw [map_add, hy, hz]
  · intro y _ hy
    show addTranslationMeroEquiv g y⁻¹ = y⁻¹
    rw [map_inv₀, hy]
  · intro y z _ _ hy hz
    show addTranslationMeroEquiv g (y * z) = y * z
    rw [map_mul, hy, hz]

/-! ## The unit period acts trivially on the packets -/

/-- Every packet element has the unit period. -/
theorem facePacket_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι)
    {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ multipleEllipticGammaFacePacket τ hτ J) :
    addTranslationMeroEquiv 1 y = y := by
  obtain ⟨g, _, rfl⟩ := hy
  have hcomm : (1 : ℂ) + g = g + 1 := add_comm 1 g
  rw [addTranslationMeroEquiv_add, hcomm, ← addTranslationMeroEquiv_add,
    addTranslationMeroEquiv_one_multipleEllipticGammaLogDerivFaceMero]

theorem facePacket_neg_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι)
    {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ multipleEllipticGammaFacePacket τ hτ J) :
    addTranslationMeroEquiv (-1) y = y := by
  have h0 : (-1 : ℂ) + 1 = 0 := by ring
  conv_lhs => rw [← facePacket_one_translate_eq τ hτ J hy]
  rw [addTranslationMeroEquiv_add, h0, addTranslationMeroEquiv_zero_apply]

theorem facePacketUnion_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (S : Set (Finset ι))
    {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ facePacketUnion τ hτ S) :
    addTranslationMeroEquiv 1 y = y := by
  obtain ⟨L, _, hyL⟩ := Set.mem_iUnion₂.mp hy
  exact facePacket_one_translate_eq τ hτ L hyL

theorem facePacketUnion_neg_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (S : Set (Finset ι)) {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ facePacketUnion τ hτ S) :
    addTranslationMeroEquiv (-1) y = y := by
  obtain ⟨L, _, hyL⟩ := Set.mem_iUnion₂.mp hy
  exact facePacket_neg_one_translate_eq τ hτ L hyL

/-- The unit translation fixes the deeper face field pointwise. -/
theorem differentialAdjoin_facePacketUnion_one_fixed (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (S : Set (Finset ι)) {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)) :
    addTranslationMeroEquiv 1 x = x :=
  differentialAdjoin_fixed_of_generators 1 _
    (fun _ hy => facePacketUnion_one_translate_eq τ hτ S hy) hx

theorem differentialAdjoin_facePacketUnion_neg_one_fixed (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (S : Set (Finset ι)) {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)) :
    addTranslationMeroEquiv (-1) x = x :=
  differentialAdjoin_fixed_of_generators (-1) _
    (fun _ hy => facePacketUnion_neg_one_translate_eq τ hτ S hy) hx

/-! ## The three structural directions -/

/-- The three structural periods of the face-lifting argument. -/
def facePacketPeriods (τ : ι → ℂ) (q u : ι) : Fin 3 → ℂ := ![1, τ q, τ u]

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem facePacketPeriods_zero (τ : ι → ℂ) (q u : ι) :
    facePacketPeriods τ q u 0 = 1 := rfl

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem facePacketPeriods_one (τ : ι → ℂ) (q u : ι) :
    facePacketPeriods τ q u 1 = τ q := rfl

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem facePacketPeriods_two (τ : ι → ℂ) (q u : ι) :
    facePacketPeriods τ q u 2 = τ u := rfl

theorem facePacketUnion_period_translate_stable (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)) :
    addTranslationMeroEquiv (facePacketPeriods τ q u i) x ∈
      differentialAdjoin ℂ (facePacketUnion τ hτ S) := by
  fin_cases i
  · rw [show facePacketPeriods τ q u ⟨0, by omega⟩ = 1 from rfl,
      differentialAdjoin_facePacketUnion_one_fixed τ hτ S hx]
    exact hx
  · exact differentialAdjoin_facePacketUnion_translate_stable τ hτ q
      (fun L hL hq => hS L hL q hq) hx
  · exact differentialAdjoin_facePacketUnion_translate_stable τ hτ u
      (fun L hL hu => hS L hL u hu) hx

theorem facePacketUnion_period_neg_translate_stable (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)) :
    addTranslationMeroEquiv (-facePacketPeriods τ q u i) x ∈
      differentialAdjoin ℂ (facePacketUnion τ hτ S) := by
  fin_cases i
  · rw [show -facePacketPeriods τ q u ⟨0, by omega⟩ = -1 from rfl,
      differentialAdjoin_facePacketUnion_neg_one_fixed τ hτ S hx]
    exact hx
  · exact differentialAdjoin_facePacketUnion_neg_translate_stable τ hτ q
      (fun L hL hq => hS L hL q hq) hx
  · exact differentialAdjoin_facePacketUnion_neg_translate_stable τ hτ u
      (fun L hL hu => hS L hL u hu) hx

/-- **The three structural translations as a difference-differential structure on the deeper face
field.** -/
def facePacketDifferenceSystem (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) :
    CommutingDifferenceDifferentialField (Fin 3) ℂ
      ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)) where
  aut i := meroTranslationRestrict (differentialAdjoin ℂ (facePacketUnion τ hτ S))
    (facePacketPeriods τ q u i)
    (facePacketUnion_period_translate_stable τ hτ hS q u i)
    (facePacketUnion_period_neg_translate_stable τ hτ hS q u i)
  aut_comm i j x := by
    apply Subtype.ext
    show addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (addTranslationMeroEquiv (facePacketPeriods τ q u j)
        (x : meroField (Set.univ : Set ℂ))) = _
    show _ = addTranslationMeroEquiv (facePacketPeriods τ q u j)
      (addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (x : meroField (Set.univ : Set ℂ)))
    rw [addTranslationMeroEquiv_add, addTranslationMeroEquiv_add, add_comm]
  aut_deriv i x := by
    apply Subtype.ext
    exact addTranslationMeroEquiv_deriv (facePacketPeriods τ q u i)
      (x : meroField (Set.univ : Set ℂ))
  aut_algebraMap i c := by
    apply Subtype.ext
    show addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c) = _
    exact addTranslationMeroEquiv_algebraMap_complex _ c

@[simp]
theorem facePacketDifferenceSystem_aut_coe (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) :
    (((facePacketDifferenceSystem τ hτ hS q u).aut i x :
        ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) : meroField (Set.univ : Set ℂ)) =
      addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (x : meroField (Set.univ : Set ℂ)) := rfl

/-! ## The translation block of a face and its displacements -/

/-- The translation block of the face `J`, indexed by its packet. -/
def facePacketBlock (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι) :
    ↥(multipleEllipticGammaFacePacket τ hτ J) → meroField (Set.univ : Set ℂ) :=
  fun y => (y : meroField (Set.univ : Set ℂ))

theorem facePacketBlock_period_displacement_mem (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (i : Fin 3)
    (y : ↥(multipleEllipticGammaFacePacket τ hτ J)) :
    addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (facePacketBlock τ hτ J y) - facePacketBlock τ hτ J y ∈
      differentialAdjoin ℂ (facePacketUnion τ hτ S) := by
  fin_cases i
  · show addTranslationMeroEquiv 1 (y : meroField (Set.univ : Set ℂ)) -
      (y : meroField (Set.univ : Set ℂ)) ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S)
    rw [facePacket_one_translate_eq τ hτ J y.2, sub_self]
    exact (differentialAdjoin ℂ (facePacketUnion τ hτ S)).zero_mem
  · exact subset_differentialAdjoin ℂ _
      (Set.mem_iUnion₂.mpr ⟨insert q J, hqS,
        facePacket_translate_sub_mem τ hτ J hqJ y.2⟩)
  · exact subset_differentialAdjoin ℂ _
      (Set.mem_iUnion₂.mpr ⟨insert u J, huS,
        facePacket_translate_sub_mem τ hτ J huJ y.2⟩)

/-- The displacements of the translation block in the three structural directions.  They lie in the
deeper face field: the unit direction contributes zero, and each surviving direction contributes a
member of the next packet. -/
def facePacketDisplacement (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) :
    Fin 3 → ↥(multipleEllipticGammaFacePacket τ hτ J) →
      ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)) :=
  fun i y => ⟨addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (facePacketBlock τ hτ J y) - facePacketBlock τ hτ J y,
    facePacketBlock_period_displacement_mem τ hτ J hqJ huJ hqS huS i y⟩

/-! ## The descending face-lifting lemma -/

set_option synthInstance.maxHeartbeats 400000 in
/-- **Descending face-lifting.**  If no nonzero finite constant-coefficient jet form of the
displacements is a simultaneous coboundary in the deeper face field, then the translation block of
the face is differentially algebraically independent over that field. -/
theorem facePacket_differentialIndependent_of_no_telescoping (τ : ι → ℂ)
    (hτ : ∀ i, 0 < (τ i).im) {S : Set (Finset ι)}
    (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (J : Finset ι) {q u : ι}
    (hqJ : q ∉ J) (huJ : u ∉ J) (hqS : insert q J ∈ S) (huS : insert u J ∈ S)
    (hv : LinearIndependent ℚ (facePacketPeriods τ q u))
    (hnot : ∀ c : (↥(multipleEllipticGammaFacePacket τ hτ J) × ℕ) →₀ ℂ, c ≠ 0 →
      ∀ k : ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)), ∃ i,
        (facePacketDifferenceSystem τ hτ hS q u).defect i k ≠
          Finsupp.linearCombination ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
            (fun p ↦ differentialJet p.2
              (facePacketDisplacement τ hτ J hqJ huJ hqS huS i p.1))
            (Finsupp.mapRange
              (algebraMap ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))
              (map_zero (algebraMap ℂ
                ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))) c)) :
    DifferentialIndependent ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
      (facePacketBlock τ hτ J) := by
  classical
  haveI : DifferentialAlgebra ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
      (meroField (Set.univ : Set ℂ)) :=
    ⟨fun x => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin ℂ (facePacketUnion τ hτ S)) x⟩
  haveI : CharZero ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)) :=
    charZero_of_injective_algebraMap
      (algebraMap ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))).injective
  refine differentialIndependent_of_no_constant_simultaneous_jet_telescoping
    (facePacketDifferenceSystem τ hτ hS q u)
    (rankThreeGeneratorMeromorphicDifferenceDifferentialField (facePacketPeriods τ q u))
    (fun i k => rfl)
    (fun z hz => ?_)
    (facePacketBlock τ hτ J)
    (facePacketDisplacement τ hτ J hqJ huJ hqS huS)
    (fun i y => ?_) hnot
  · obtain ⟨c, hc⟩ :=
      (rankThree_generator_jointFixed_iff_constant (facePacketPeriods τ q u) hv z).mp hz
    exact ⟨c, by simpa [meromorphicConstantEmbedding] using hc⟩
  · show addTranslationMeroEquiv (facePacketPeriods τ q u i) (facePacketBlock τ hτ J y) =
      facePacketBlock τ hτ J y +
        (facePacketDisplacement τ hτ J hqJ huJ hqS huS i y : meroField (Set.univ : Set ℂ))
    show _ = facePacketBlock τ hτ J y +
      (addTranslationMeroEquiv (facePacketPeriods τ q u i) (facePacketBlock τ hτ J y) -
        facePacketBlock τ hτ J y)
    ring

end

end GaloisForLFunctions
