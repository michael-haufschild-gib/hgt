import GaloisForLFunctions.HTGeometry.GenericProjectiveCentreField
import GaloisForLFunctions.HTGeometry.SpecialLinearTransvectionGeneration

/-!
# The unipotent horizons of the generic matrix system meet in the curvature field

For the generic linear differential system over a field `K`, the gauge group `GL_N(K)` acts on the
free differential field of the generic fundamental matrix by left translation `Y ↦ Z · Y`.  The
subfield fixed by all of `GL_N(K)` is the curvature field generated by the system matrix and its
derivatives.

This file shows that the *elementary* gauges already cut out the curvature field: it is enough to
be fixed by every transvection `I + c·E_{ij}` (`i ≠ j`) and by every scalar `c·I`.  Over an
algebraically closed field an invertible matrix `Z` factors as `c·M` with `c^N = det Z` and
`det M = 1`, and `M` is a product of transvections; the gauge action is an anti-homomorphism, so
invariance propagates along the factorisation.

The main results are `gaugeAut_comp` (the composition law), `gaugeAut_listProd_invariant`
(invariance along a product of transvections) and
`mem_curvatureField_of_transvection_and_scalar_invariant`.
-/

open MvPolynomial

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

variable {K : Type*} [Field K] {N : ℕ}

/-- Two ring homomorphisms of the free differential rational field agreeing on the base field and
on every jet coordinate are equal. -/
theorem jetField_ringHom_ext {f g : JetField K (Fin N × Fin N) →+* JetField K (Fin N × Fin N)}
    (hbase : ∀ a : K, f (algebraMap K (JetField K (Fin N × Fin N)) a)
      = g (algebraMap K (JetField K (Fin N × Fin N)) a))
    (hjet : ∀ p, f (JetField.jet p) = g (JetField.jet p)) (u : JetField K (Fin N × Fin N)) :
    f u = g u := by
  have hpoly : ∀ p : JetPoly K (Fin N × Fin N),
      f (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p)
        = g (algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N)) p) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
        have hb : algebraMap (JetPoly K (Fin N × Fin N)) (JetField K (Fin N × Fin N))
            (MvPolynomial.C a) = algebraMap K (JetField K (Fin N × Fin N)) a := by
          rw [IsScalarTower.algebraMap_apply K (JetPoly K (Fin N × Fin N))
            (JetField K (Fin N × Fin N)), MvPolynomial.algebraMap_eq]
        rw [hb, hbase]
    | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
    | mul_X p q hp =>
        rw [map_mul, map_mul, map_mul, hp]
        congr 1
        exact hjet q
  obtain ⟨p, q, hqmem, hu⟩ := IsFractionRing.div_surjective (JetPoly K (Fin N × Fin N)) u
  rw [← hu, map_div₀, map_div₀, hpoly p, hpoly q]

/-- The gauge automorphism attached to an invertible constant matrix. -/
private def gaugeAut (Z : Matrix (Fin N) (Fin N) K) (hZ : IsUnit Z.det) :
    JetField K (Fin N × Fin N) ≃+* JetField K (Fin N × Fin N) :=
  leftTranslationFieldEquiv Z Z⁻¹ (Matrix.mul_nonsing_inv Z hZ) (Matrix.nonsing_inv_mul Z hZ)

theorem gaugeAut_jet (Z : Matrix (Fin N) (Fin N) K) (hZ : IsUnit Z.det) (a b : Fin N) (r : ℕ) :
    gaugeAut Z hZ (JetField.jet ((a, b), r))
      = ((Z.map (algebraMap K (JetField K (Fin N × Fin N)))) * genericJetPower K N r) a b := by
  rw [gaugeAut, leftTranslationFieldEquiv_jet, Matrix.mul_apply]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Matrix.map_apply, genericJetPower_apply]

private theorem gaugeAut_base (Z : Matrix (Fin N) (Fin N) K) (hZ : IsUnit Z.det) (a : K) :
    gaugeAut Z hZ (algebraMap K (JetField K (Fin N × Fin N)) a)
      = algebraMap K (JetField K (Fin N × Fin N)) a :=
  leftTranslationFieldEquiv_algebraMap_base _ _ _ _ a

theorem gaugeAut_one : gaugeAut (1 : Matrix (Fin N) (Fin N) K) (by simp) = RingEquiv.refl _ := by
  refine RingEquiv.ext fun u => ?_
  refine jetField_ringHom_ext (f := (gaugeAut (1 : Matrix (Fin N) (Fin N) K) (by simp) :
      JetField K (Fin N × Fin N) →+* JetField K (Fin N × Fin N)))
    (g := RingHom.id _) ?_ ?_ u
  · intro a
    exact gaugeAut_base _ _ a
  · intro p
    obtain ⟨⟨a, b⟩, r⟩ := p
    show gaugeAut (1 : Matrix (Fin N) (Fin N) K) (by simp) (JetField.jet ((a, b), r))
      = JetField.jet ((a, b), r)
    rw [gaugeAut_jet]
    simp [Matrix.map_one, genericJetPower_apply]

/-- **The gauge action is an anti-homomorphism.** -/
theorem gaugeAut_comp (Z W : Matrix (Fin N) (Fin N) K) (hZ : IsUnit Z.det) (hW : IsUnit W.det)
    (hZW : IsUnit (Z * W).det) (u : JetField K (Fin N × Fin N)) :
    gaugeAut W hW (gaugeAut Z hZ u) = gaugeAut (Z * W) hZW u := by
  refine jetField_ringHom_ext
    (f := ((gaugeAut W hW : JetField K (Fin N × Fin N) →+* JetField K (Fin N × Fin N)).comp
      (gaugeAut Z hZ : JetField K (Fin N × Fin N) →+* JetField K (Fin N × Fin N))))
    (g := (gaugeAut (Z * W) hZW : JetField K (Fin N × Fin N) →+* JetField K (Fin N × Fin N)))
    ?_ ?_ u
  · intro a
    show gaugeAut W hW (gaugeAut Z hZ (algebraMap K (JetField K (Fin N × Fin N)) a))
      = gaugeAut (Z * W) hZW (algebraMap K (JetField K (Fin N × Fin N)) a)
    rw [gaugeAut_base, gaugeAut_base, gaugeAut_base]
  · intro p
    obtain ⟨⟨a, b⟩, r⟩ := p
    show gaugeAut W hW (gaugeAut Z hZ (JetField.jet ((a, b), r)))
      = gaugeAut (Z * W) hZW (JetField.jet ((a, b), r))
    rw [gaugeAut_jet, gaugeAut_jet]
    rw [Matrix.mul_apply, map_sum]
    have hval : ∀ k : Fin N,
        gaugeAut W hW ((Z.map (algebraMap K (JetField K (Fin N × Fin N)))) a k
            * genericJetPower K N r k b)
          = algebraMap K (JetField K (Fin N × Fin N)) (Z a k)
            * ((W.map (algebraMap K (JetField K (Fin N × Fin N)))) * genericJetPower K N r) k b := by
      intro k
      rw [map_mul, Matrix.map_apply, gaugeAut_base]
      congr 1
      rw [genericJetPower_apply, gaugeAut_jet]
    rw [Finset.sum_congr rfl (fun k _ => hval k)]
    rw [Matrix.mul_apply]
    have hmapmul : (Z * W).map (algebraMap K (JetField K (Fin N × Fin N)))
        = Z.map (algebraMap K (JetField K (Fin N × Fin N)))
          * W.map (algebraMap K (JetField K (Fin N × Fin N))) := by
      have := map_mul ((algebraMap K (JetField K (Fin N × Fin N))).mapMatrix) Z W
      rw [RingHom.mapMatrix_apply, RingHom.mapMatrix_apply, RingHom.mapMatrix_apply] at this
      exact this
    rw [hmapmul]
    show (Z.map (algebraMap K (JetField K (Fin N × Fin N)))
        * (W.map (algebraMap K (JetField K (Fin N × Fin N))) * genericJetPower K N r)) a b
      = ((Z.map (algebraMap K (JetField K (Fin N × Fin N)))
        * W.map (algebraMap K (JetField K (Fin N × Fin N)))) * genericJetPower K N r) a b
    rw [Matrix.mul_assoc]

/-! ### Unipotent generation -/

theorem isUnit_det_transvectionStruct_prod (L : List (Matrix.TransvectionStruct (Fin N) K)) :
    IsUnit ((L.map Matrix.TransvectionStruct.toMatrix).prod).det := by
  rw [Matrix.TransvectionStruct.det_toMatrix_prod]
  exact isUnit_one

theorem gaugeAut_congr {Z Z' : Matrix (Fin N) (Fin N) K} (h : Z = Z')
    (hZ : IsUnit Z.det) (hZ' : IsUnit Z'.det) (u : JetField K (Fin N × Fin N)) :
    gaugeAut Z hZ u = gaugeAut Z' hZ' u := by
  subst h
  rfl

/-- Invariance under every transvection gauge propagates to any product of transvections. -/
theorem gaugeAut_listProd_invariant {u : JetField K (Fin N × Fin N)}
    (hu : ∀ (t : Matrix.TransvectionStruct (Fin N) K),
      gaugeAut t.toMatrix (by rw [Matrix.TransvectionStruct.det]; exact isUnit_one) u = u)
    (L : List (Matrix.TransvectionStruct (Fin N) K)) :
    gaugeAut ((L.map Matrix.TransvectionStruct.toMatrix).prod)
      (isUnit_det_transvectionStruct_prod L) u = u := by
  induction L with
  | nil =>
      have h1 : (([] : List (Matrix.TransvectionStruct (Fin N) K)).map
        Matrix.TransvectionStruct.toMatrix).prod = (1 : Matrix (Fin N) (Fin N) K) := by simp
      rw [gaugeAut_congr h1 (isUnit_det_transvectionStruct_prod []) (by simp) u]
      have h2 := congrArg
        (fun e : JetField K (Fin N × Fin N) ≃+* JetField K (Fin N × Fin N) => e u)
        (gaugeAut_one (K := K) (N := N))
      simpa using h2
  | cons t L ih =>
      have hprod : ((t :: L).map Matrix.TransvectionStruct.toMatrix).prod
          = t.toMatrix * (L.map Matrix.TransvectionStruct.toMatrix).prod := by simp
      have hunit2 : IsUnit (t.toMatrix
          * (L.map Matrix.TransvectionStruct.toMatrix).prod).det := by
        rw [← hprod]; exact isUnit_det_transvectionStruct_prod (t :: L)
      rw [gaugeAut_congr hprod (isUnit_det_transvectionStruct_prod (t :: L)) hunit2 u,
        ← gaugeAut_comp t.toMatrix _
          (by rw [Matrix.TransvectionStruct.det]; exact isUnit_one)
          (isUnit_det_transvectionStruct_prod L) hunit2 u,
        hu t, ih]

theorem isUnit_det_scalarGauge (c : K) (hc : c ≠ 0) : IsUnit (scalarGauge K N c).det := by
  rw [scalarGauge, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin]
  exact (isUnit_iff_ne_zero).mpr (pow_ne_zero N hc)

theorem leftTranslationFieldEquiv_eq_gaugeAut (Z W : Matrix (Fin N) (Fin N) K)
    (hZW : Z * W = 1) (hWZ : W * Z = 1) (hZ : IsUnit Z.det) (u : JetField K (Fin N × Fin N)) :
    leftTranslationFieldEquiv Z W hZW hWZ u = gaugeAut Z hZ u := by
  have hinv : Z⁻¹ = W := Matrix.inv_eq_right_inv hZW
  subst hinv
  rfl

/-- **Card 12, item (6): the unipotent horizons meet in the curvature field.**  An element fixed by
every transvection gauge and by every scalar gauge lies in the curvature field. -/
theorem mem_curvatureField_of_transvection_and_scalar_invariant
    [IsAlgClosed K] [Infinite K] {u : JetField K (Fin N × Fin N)}
    (htrans : ∀ t : Matrix.TransvectionStruct (Fin N) K,
      gaugeAut t.toMatrix (by rw [Matrix.TransvectionStruct.det]; exact isUnit_one) u = u)
    (hscal : ∀ (c : K) (hc : c ≠ 0), gaugeAut (scalarGauge K N c) (isUnit_det_scalarGauge c hc) u = u) :
    u ∈ differentialAdjoin K (systemEntries K N) := by
  classical
  have hall : ∀ (Z W : Matrix (Fin N) (Fin N) K) (hZW : Z * W = 1) (hWZ : W * Z = 1),
      leftTranslationFieldEquiv Z W hZW hWZ u = u := by
    intro Z W hZW hWZ
    have hZ : IsUnit Z.det := Matrix.isUnit_det_of_right_inverse hZW
    rw [leftTranslationFieldEquiv_eq_gaugeAut Z W hZW hWZ hZ]
    rcases Nat.eq_zero_or_pos N with hN | hN
    · subst hN
      have hZ1 : Z = 1 := Subsingleton.elim _ _
      rw [gaugeAut_congr hZ1 hZ (by simp) u]
      have h2 := congrArg
        (fun e : JetField K (Fin 0 × Fin 0) ≃+* JetField K (Fin 0 × Fin 0) => e u)
        (gaugeAut_one (K := K) (N := 0))
      simpa using h2
    · obtain ⟨c, hcpow⟩ := IsAlgClosed.exists_pow_nat_eq (Z.det) hN
      have hdetne : Z.det ≠ 0 := isUnit_iff_ne_zero.mp hZ
      have hc : c ≠ 0 := by
        intro h
        rw [h, zero_pow hN.ne'] at hcpow
        exact hdetne hcpow.symm
      set M : Matrix (Fin N) (Fin N) K := c⁻¹ • Z with hM
      have hdetM : M.det = 1 := by
        rw [hM, Matrix.det_smul, Fintype.card_fin, ← hcpow, inv_pow,
          inv_mul_cancel₀ (pow_ne_zero N hc)]
      obtain ⟨L, hL⟩ := isTransvectionProduct_of_det_eq_one M hdetM
      have hZfac : Z = scalarGauge K N c * M := by
        rw [hM, scalarGauge, Matrix.smul_mul, Matrix.one_mul, smul_smul,
          mul_inv_cancel₀ hc, one_smul]
      have hMunit : IsUnit M.det := by rw [hdetM]; exact isUnit_one
      have hMinv : gaugeAut M hMunit u = u := by
        rw [gaugeAut_congr hL hMunit (isUnit_det_transvectionStruct_prod L) u]
        exact gaugeAut_listProd_invariant htrans L
      have hcomp := gaugeAut_comp (scalarGauge K N c) M (isUnit_det_scalarGauge c hc) hMunit
        (by rw [← hZfac]; exact hZ) u
      rw [hscal c hc, hMinv] at hcomp
      rw [gaugeAut_congr hZfac hZ (by rw [← hZfac]; exact hZ) u]
      exact hcomp.symm
  have hset : u ∈ {v : JetField K (Fin N × Fin N) | ∀ (Z W : Matrix (Fin N) (Fin N) K)
      (hZW : Z * W = 1) (hWZ : W * Z = 1), leftTranslationFieldEquiv Z W hZW hWZ v = v} := hall
  rw [leftTranslationInvariants_eq_curvatureField] at hset
  exact hset


/-! ### The elementary horizons and the projective correspondence -/

/-- **The elementary horizons meet in the curvature field.**  An element of the free differential
field is fixed by every transvection gauge and every scalar gauge exactly when it lies in the
curvature field. -/
theorem transvection_scalar_invariants_eq_curvatureField [IsAlgClosed K] [Infinite K] :
    {u : JetField K (Fin N × Fin N) |
        (∀ t : Matrix.TransvectionStruct (Fin N) K,
          gaugeAut t.toMatrix (by rw [Matrix.TransvectionStruct.det]; exact isUnit_one) u = u)
        ∧ ∀ (c : K) (hc : c ≠ 0),
            gaugeAut (scalarGauge K N c) (isUnit_det_scalarGauge c hc) u = u}
      = (differentialAdjoin K (systemEntries K N) : Set (JetField K (Fin N × Fin N))) := by
  ext u
  constructor
  · rintro ⟨htrans, hscal⟩
    exact mem_curvatureField_of_transvection_and_scalar_invariant htrans hscal
  · intro hu
    refine ⟨fun t => ?_, fun c hc => ?_⟩
    · exact leftTranslationFieldEquiv_fixes_curvatureField _ _ _ _ hu
    · exact leftTranslationFieldEquiv_fixes_curvatureField _ _ _ _ hu

/-- The curvature field lies in the projective field: the system matrix is invariant under the
scalar centre. -/
theorem curvatureField_le_projectiveSubfield [Infinite K] (p₀ : (Fin N × Fin N) × ℕ)
    {u : JetField K (Fin N × Fin N)} (hu : u ∈ differentialAdjoin K (systemEntries K N)) :
    u ∈ projectiveSubfield K N := by
  have hfix : ∀ (c : K) (hc : c ≠ 0),
      leftTranslationFieldEquiv (scalarGauge K N c) (scalarGauge K N c⁻¹)
        (scalarGauge_mul_inv c hc) (scalarGauge_inv_mul c hc) u = u := by
    intro c hc
    exact leftTranslationFieldEquiv_fixes_curvatureField _ _ _ _ hu
  have := (scalarGaugeInvariants_eq_projectiveSubfield (K := K) (N := N) p₀).le hfix
  exact this

/-- **Card 12, item (2) in projective form.**  Inside the centre-fixed projective field, the
elements fixed by the whole constant gauge group are exactly the curvature field. -/
theorem projectiveGaugeInvariants_eq_curvatureField [Infinite K] (p₀ : (Fin N × Fin N) × ℕ) :
    {u : JetField K (Fin N × Fin N) | u ∈ projectiveSubfield K N ∧
        ∀ (Z W : Matrix (Fin N) (Fin N) K) (hZW : Z * W = 1) (hWZ : W * Z = 1),
          leftTranslationFieldEquiv Z W hZW hWZ u = u}
      = (differentialAdjoin K (systemEntries K N) : Set (JetField K (Fin N × Fin N))) := by
  ext u
  constructor
  · rintro ⟨-, hgauge⟩
    exact (leftTranslationInvariants_eq_curvatureField (K := K) (N := N)).le hgauge
  · intro hu
    refine ⟨curvatureField_le_projectiveSubfield p₀ hu, fun Z W hZW hWZ => ?_⟩
    exact leftTranslationFieldEquiv_fixes_curvatureField _ _ _ _ hu

end

end GaloisForLFunctions.HTGeometry
