import Mathlib.NumberTheory.NumberField.ClassNumber

/-!
# Finite representatives for number-field ideal classes

The class group is defined using a canonical fraction field, while reduction arguments use the
actual number field.  This file makes the quotient map onto from fractional ideals in that field,
then chooses one invertible fractional ideal in every class.  Number-field class-number finiteness
makes the resulting representative family finite.
-/

namespace GaloisForLFunctions.HTGeometry

open NumberField

/-- The class-group quotient map is onto when fractional ideals are formed in any fraction field. -/
theorem classGroup_mk_surjective
    {R K : Type*} [CommRing R] [Field K] [Algebra R K]
    [IsFractionRing R K] [IsDomain R] :
    Function.Surjective (ClassGroup.mk (R := R) K) := by
  intro c
  obtain ⟨J, rfl⟩ := QuotientGroup.mk'_surjective
    (toPrincipalIdeal R (FractionRing R)).range c
  let e := FractionalIdeal.canonicalEquiv (nonZeroDivisors R) K (FractionRing R)
  refine ⟨Units.map e.symm.toMonoidHom J, ?_⟩
  change QuotientGroup.mk' _
      (Units.map e.toMonoidHom (Units.map e.symm.toMonoidHom J)) =
    QuotientGroup.mk' _ J
  congr 1
  apply Units.ext
  exact e.apply_symm_apply
    (J : FractionalIdeal (nonZeroDivisors R) (FractionRing R))

/-- One invertible fractional ideal in the actual number field representing a prescribed ideal
class. -/
noncomputable def numberFieldIdealClassRepresentative
    (K : Type*) [Field K] [NumberField K] (c : ClassGroup (𝓞 K)) :
    (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ :=
  Classical.choose (classGroup_mk_surjective (R := 𝓞 K) (K := K) c)

/-- The chosen fractional ideal represents the requested ideal class. -/
theorem numberFieldIdealClassRepresentative_mk
    (K : Type*) [Field K] [NumberField K] (c : ClassGroup (𝓞 K)) :
    ClassGroup.mk K (numberFieldIdealClassRepresentative K c) = c :=
  Classical.choose_spec (classGroup_mk_surjective (R := 𝓞 K) (K := K) c)

/-- The chosen number-field ideal-class representatives form a finite family. -/
theorem finite_range_numberFieldIdealClassRepresentative
    (K : Type*) [Field K] [NumberField K] :
    Set.Finite (Set.range (numberFieldIdealClassRepresentative K)) :=
  Set.finite_range _

/-- Dividing an invertible fractional ideal by the chosen representative of its class leaves a
principal fractional ideal.  This is the exact ideal-class normalization used before applying a
uniform archimedean bound. -/
theorem numberFieldIdeal_mul_classRepresentative_inv_isPrincipal
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) :
    (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K).IsPrincipal := by
  rw [← ClassGroup.mk_eq_one_iff]
  rw [map_mul, map_inv, numberFieldIdealClassRepresentative_mk]
  exact mul_inv_cancel _

/-- A scalar generator for the principal ideal left after dividing by the chosen representative
of the ideal class. -/
noncomputable def numberFieldIdealClassNormalizer
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) : K := by
  let J : Submodule (𝓞 K) K :=
    (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K)
  letI : J.IsPrincipal :=
    numberFieldIdeal_mul_classRepresentative_inv_isPrincipal K I
  exact Classical.choose (Submodule.IsPrincipal.principal (S := J))

/-- The class-normalized fractional ideal is generated by its chosen scalar normalizer. -/
theorem numberFieldIdealClassNormalizer_span
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) :
    (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K) =
      (𝓞 K) ∙ numberFieldIdealClassNormalizer K I := by
  let J : Submodule (𝓞 K) K :=
    (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K)
  letI : J.IsPrincipal :=
    numberFieldIdeal_mul_classRepresentative_inv_isPrincipal K I
  exact Classical.choose_spec (Submodule.IsPrincipal.principal (S := J))

/-- The chosen class normalizer is nonzero. -/
theorem numberFieldIdealClassNormalizer_ne_zero
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) :
    numberFieldIdealClassNormalizer K I ≠ 0 := by
  intro h
  have hbot :
      (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K) = ⊥ := by
    rw [numberFieldIdealClassNormalizer_span, h]
    simp
  have hzero :
      (↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K) = 0 :=
    FractionalIdeal.coeToSubmodule_eq_bot.mp hbot
  exact Units.ne_zero
    (I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) hzero

/-- The class-normalized ideal is literally the principal fractional ideal generated by the chosen
normalizer.  This is the multiplicative form needed for Steinitz transport. -/
theorem numberFieldIdeal_mul_classRepresentative_inv_eq_spanSingleton
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) :
    (↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K))
        (numberFieldIdealClassNormalizer K I) := by
  apply FractionalIdeal.ext
  intro x
  change x ∈ (↑(↑(I * (numberFieldIdealClassRepresentative K (ClassGroup.mk K I))⁻¹) :
      FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : Submodule (𝓞 K) K) ↔
    x ∈ (↑(FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K))
      (numberFieldIdealClassNormalizer K I)) : Submodule (𝓞 K) K)
  rw [numberFieldIdealClassNormalizer_span, FractionalIdeal.coe_spanSingleton]

/-- **Steinitz class normalization.**  Every invertible fractional ideal is a principal scalar
multiple of the fixed representative of its ideal class. -/
theorem numberFieldIdeal_eq_spanSingleton_mul_classRepresentative
    (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) :
    (↑I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K))
          (numberFieldIdealClassNormalizer K I) *
        (↑(numberFieldIdealClassRepresentative K (ClassGroup.mk K I)) :
          FractionalIdeal (nonZeroDivisors (𝓞 K)) K) := by
  have h := congrArg
    (fun J : FractionalIdeal (nonZeroDivisors (𝓞 K)) K =>
      J * (↑(numberFieldIdealClassRepresentative K (ClassGroup.mk K I)) :
        FractionalIdeal (nonZeroDivisors (𝓞 K)) K))
    (numberFieldIdeal_mul_classRepresentative_inv_eq_spanSingleton K I)
  simpa [mul_assoc] using h

end GaloisForLFunctions.HTGeometry
