import GaloisForLFunctions.HTGeometry.TestFunctionSeminorm
import Mathlib.Analysis.LocallyConvex.WithSeminorms
import Mathlib.Analysis.LocallyConvex.Barrelled
import Mathlib.Topology.Sets.Compacts
import Mathlib.Topology.Algebra.UniformFilterBasis

/-!
# The seminorm topology on the test space

Giving the test space the topology generated by its derivative sup-norms makes `WithSeminorms`
hold by construction, and the standard filter-basis instances supply the uniform structure.  The
family is indexed by the natural numbers, so the topology is first countable, hence metrizable
once it is separated.

Barrelledness — the property the trace bound needs — then follows from the mathlib instance
`BaireSpace.instBarrelledSpace` as soon as the space is a Baire space.

* `DeningerTest J` : the test space attached to a compact set.
* `withSeminorms_deningerTest` : the topology is the seminorm topology.
* `deningerTest_barrelledSpace_of_baire` : Baire implies barrelled here.
-/

namespace GaloisForLFunctions.HTGeometry

open TopologicalSpace

section Topology

/-- The test space attached to a compact set: smooth functions supported in it. -/
abbrev DeningerTest (J : Compacts ℝ) : Type := deningerTestSpace (J : Set ℝ)

/-- The defining seminorm family of the test space. -/
noncomputable def deningerTestFamily (J : Compacts ℝ) :
    SeminormFamily ℝ (DeningerTest J) ℕ :=
  deningerTestSeminormFamily J.isCompact

noncomputable instance instTopologicalSpaceDeningerTest (J : Compacts ℝ) :
    TopologicalSpace (DeningerTest J) :=
  (deningerTestFamily J).moduleFilterBasis.topology'

/-- **The topology of the test space is its seminorm topology.** -/
theorem withSeminorms_deningerTest (J : Compacts ℝ) :
    WithSeminorms (deningerTestFamily J) := ⟨rfl⟩

instance instIsTopologicalAddGroupDeningerTest (J : Compacts ℝ) :
    IsTopologicalAddGroup (DeningerTest J) :=
  (deningerTestFamily J).addGroupFilterBasis.isTopologicalAddGroup

noncomputable instance instUniformSpaceDeningerTest (J : Compacts ℝ) :
    UniformSpace (DeningerTest J) :=
  (deningerTestFamily J).addGroupFilterBasis.uniformSpace

instance instIsUniformAddGroupDeningerTest (J : Compacts ℝ) :
    IsUniformAddGroup (DeningerTest J) :=
  (deningerTestFamily J).addGroupFilterBasis.isUniformAddGroup

instance instContinuousSMulDeningerTest (J : Compacts ℝ) :
    ContinuousSMul ℝ (DeningerTest J) := by
  rw [(withSeminorms_deningerTest J).withSeminorms_eq]
  exact (deningerTestFamily J).moduleFilterBasis.continuousSMul

instance instFirstCountableDeningerTest (J : Compacts ℝ) :
    FirstCountableTopology (DeningerTest J) :=
  (withSeminorms_deningerTest J).firstCountableTopology

instance instLocallyConvexDeningerTest (J : Compacts ℝ) :
    LocallyConvexSpace ℝ (DeningerTest J) :=
  (withSeminorms_deningerTest J).toLocallyConvexSpace

/-- **A Baire test space is barrelled.**  This is the mathlib instance, recorded here in the form
the trace bound consumes. -/
theorem deningerTest_barrelledSpace_of_baire (J : Compacts ℝ) [BaireSpace (DeningerTest J)] :
    BarrelledSpace ℝ (DeningerTest J) :=
  inferInstance

end Topology

end GaloisForLFunctions.HTGeometry
