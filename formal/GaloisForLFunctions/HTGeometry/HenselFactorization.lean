import GaloisForLFunctions.HTGeometry.NewtonFibreLift

/-!
# Hensel's lemma in factorisation form

Over a ring complete for an ideal `I`, an *approximate* monic divisor lifts to a genuine one.  If
`g₀` is monic, divides `f` modulo `I`, and the complementary quotient `f /ₘ g₀` is invertible
modulo the ideal generated by `g₀` and `I`, then `f` has a monic divisor `g` of the same degree
with `g ≡ g₀` modulo `I`.  Equivalently, an approximate factorisation `f ≡ g₀ h₀` into coprime
monic factors lifts to a genuine factorisation.

Only the divisor is iterated; the complementary factor is recovered as `f /ₘ g`.  That keeps the
degree bookkeeping exact — the correction `((f %ₘ g) · v) %ₘ g` has degree below `g` by
construction — and replaces the usual pair of congruences by the single identity

`f - (g + p)(h + T) = E · w₂ - p · T`,

whose right-hand side lies one power of `I` deeper than `E = f %ₘ g`.  Coefficientwise
completeness turns the resulting Cauchy sequence of divisors into a limit, and the Hausdorff
property kills the remaining error.

Nothing here needs `f` monic, and the ideal is arbitrary: only completeness at `I` is used.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {S : Type*} [CommRing S]

/-! ## Coefficientwise ideal membership and division -/

/-- Coefficientwise membership is vanishing of the reduction. -/
theorem coeffMem_iff_map_eq_zero {J : Ideal S} {p : S[X]} :
    CoeffMem J p ↔ p.map (Ideal.Quotient.mk J) = 0 := by
  constructor
  · intro h
    ext i
    rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact h i
  · intro h i
    have hi := congrArg (fun q => Polynomial.coeff q i) h
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at hi
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hi

theorem CoeffMem.sub {J : Ideal S} {p q : S[X]} (hp : CoeffMem J p) (hq : CoeffMem J q) :
    CoeffMem J (p - q) := fun i => by
  rw [Polynomial.coeff_sub]
  exact J.sub_mem (hp i) (hq i)

theorem CoeffMem.neg {J : Ideal S} {p : S[X]} (hp : CoeffMem J p) : CoeffMem J (-p) := fun i => by
  rw [Polynomial.coeff_neg]
  exact J.neg_mem (hp i)

theorem coeffMem_zero {J : Ideal S} : CoeffMem J (0 : S[X]) := fun _ => by
  rw [Polynomial.coeff_zero]; exact J.zero_mem

theorem coeffMem_top {p : S[X]} : CoeffMem (⊤ : Ideal S) p := fun _ => Submodule.mem_top

/-- Multiplying on the right by an arbitrary polynomial keeps the coefficients in the ideal. -/
theorem CoeffMem.mul_right {J : Ideal S} {p : S[X]} (hp : CoeffMem J p) (q : S[X]) :
    CoeffMem J (p * q) :=
  (hp.mul (coeffMem_top (p := q))).mono (le_of_eq (Ideal.mul_top J))

/-- Multiplying on the left by an arbitrary polynomial keeps the coefficients in the ideal. -/
theorem CoeffMem.mul_left {J : Ideal S} {p : S[X]} (hp : CoeffMem J p) (q : S[X]) :
    CoeffMem J (q * p) :=
  ((coeffMem_top (p := q)).mul hp).mono (le_of_eq (Ideal.top_mul J))

/-- Division with remainder by a monic polynomial preserves coefficient ideals. -/
theorem CoeffMem.modByMonic {J : Ideal S} {p q : S[X]} (hp : CoeffMem J p) (hq : q.Monic) :
    CoeffMem J (p %ₘ q) := by
  rw [coeffMem_iff_map_eq_zero] at hp ⊢
  rw [Polynomial.map_modByMonic _ hq, hp, Polynomial.zero_modByMonic]

/-- Division by a monic polynomial preserves coefficient ideals. -/
theorem CoeffMem.divByMonic {J : Ideal S} {p q : S[X]} (hp : CoeffMem J p) (hq : q.Monic) :
    CoeffMem J (p /ₘ q) := by
  rw [coeffMem_iff_map_eq_zero] at hp ⊢
  rw [Polynomial.map_divByMonic _ hq, hp, Polynomial.zero_divByMonic]

/-- **Congruent monic divisors give congruent quotients.** -/
theorem coeffMem_divByMonic_sub {J : Ideal S} {f g g' : S[X]} (hg : g.Monic) (hg' : g'.Monic)
    (h : CoeffMem J (g - g')) : CoeffMem J (f /ₘ g - f /ₘ g') := by
  rw [coeffMem_iff_map_eq_zero] at h ⊢
  rw [Polynomial.map_sub, sub_eq_zero] at h
  rw [Polynomial.map_sub, Polynomial.map_divByMonic _ hg, Polynomial.map_divByMonic _ hg', h,
    sub_self]

/-- **Congruent monic divisors give congruent remainders.** -/
theorem coeffMem_modByMonic_sub {J : Ideal S} {f g g' : S[X]} (hg : g.Monic) (hg' : g'.Monic)
    (h : CoeffMem J (g - g')) : CoeffMem J (f %ₘ g - f %ₘ g') := by
  rw [coeffMem_iff_map_eq_zero] at h ⊢
  rw [Polynomial.map_sub, sub_eq_zero] at h
  rw [Polynomial.map_sub, Polynomial.map_modByMonic _ hg, Polynomial.map_modByMonic _ hg', h,
    sub_self]

/-! ## One Newton step -/

/-- **One step of the divisor iteration.**  A monic `g` congruent to `g₀` whose remainder lies in
`I ^ (k+1)` is corrected, by a polynomial of degree below `g` with coefficients in `I ^ (k+1)`, to
one whose remainder lies in `I ^ (k+2)`.

The correction is `((f %ₘ g) * v) %ₘ g`, where `v` inverts the complementary quotient modulo the
ideal generated by `g₀` and `I`. -/
theorem hensel_step [Nontrivial S] {I : Ideal S} {f g g₀ v z : S[X]} (k : ℕ)
    (hg : g.Monic) (hg₀ : g₀.Monic) (hgg₀ : CoeffMem I (g - g₀))
    (hbez : CoeffMem I (v * (f /ₘ g₀) + z * g₀ - 1))
    (hE : CoeffMem (I ^ (k + 1)) (f %ₘ g)) :
    ∃ p : S[X], p.degree < g.degree ∧ CoeffMem (I ^ (k + 1)) p ∧
      CoeffMem (I ^ (k + 2)) (f %ₘ (g + p)) := by
  classical
  set A : S[X] := f /ₘ g₀ with hAdef
  set E : S[X] := f %ₘ g with hEdef
  set h : S[X] := f /ₘ g with hhdef
  set p : S[X] := (E * v) %ₘ g with hpdef
  set s : S[X] := (E * v) /ₘ g with hsdef
  have hpdeg : p.degree < g.degree := degree_modByMonic_lt _ hg
  have hpmem : CoeffMem (I ^ (k + 1)) p := (hE.mul_right v).modByMonic hg
  have hgp : (g + p).Monic := hg.add_of_left hpdeg
  refine ⟨p, hpdeg, hpmem, ?_⟩
  have hg₀g : CoeffMem I (g₀ - g) := by
    have hneg := hgg₀.neg
    rwa [neg_sub] at hneg
  have hδ : CoeffMem I (A - h) := coeffMem_divByMonic_sub hg₀ hg hg₀g
  set T : S[X] := E * z + s * h with hTdef
  have hTmem : CoeffMem (I ^ (k + 1)) T :=
    (hE.mul_right z).add (((hE.mul_right v).divByMonic hg).mul_right h)
  set w₂ : S[X] := z * (g₀ - g) - (v * A + z * g₀ - 1) + v * (A - h) with hw₂def
  have hw₂ : CoeffMem I w₂ := ((hg₀g.mul_left z).sub hbez).add (hδ.mul_left v)
  set ρ : S[X] := E * w₂ - p * T with hρdef
  have hρ : CoeffMem (I ^ (k + 2)) ρ := by
    refine CoeffMem.sub ?_ ?_
    · exact (hE.mul hw₂).mono (le_of_eq (pow_succ I (k + 1)).symm)
    · refine (hpmem.mul hTmem).mono ?_
      calc I ^ (k + 1) * I ^ (k + 1) = I ^ (k + 1 + (k + 1)) := (pow_add I (k + 1) (k + 1)).symm
        _ ≤ I ^ (k + 2) := Ideal.pow_le_pow_right (by omega)
  have hf : E + g * h = f := modByMonic_add_div f g
  have hEv : p + g * s = E * v := modByMonic_add_div (E * v) g
  have hp' : p = E * v - g * s := by rw [← hEv]; ring
  have hfact : f - (g + p) * (h + T) = ρ := by
    rw [hρdef, hTdef, hw₂def, hp', ← hf]
    ring
  have hdvd : (g + p) ∣ f - ρ := ⟨h + T, by rw [← hfact]; ring⟩
  rw [modByMonic_eq_of_dvd_sub hgp hdvd]
  exact hρ.modByMonic hgp

/-! ## The adic limit of a Cauchy sequence of polynomials -/

/-- Successive differences in `I ^ (k+1)` make each coefficient a Cauchy sequence. -/
theorem coeff_sub_mem_of_cauchy {I : Ideal S} (g : ℕ → S[X])
    (hg : ∀ k, CoeffMem (I ^ (k + 1)) (g (k + 1) - g k)) (i j k : ℕ) (hjk : j ≤ k) :
    (g j).coeff i - (g k).coeff i ∈ I ^ j := by
  induction k with
  | zero =>
      have hj : j = 0 := by omega
      subst hj
      rw [sub_self]
      exact Submodule.zero_mem _
  | succ k ih =>
      rcases Nat.lt_or_ge j (k + 1) with hlt | hge
      · have hstep : (g k).coeff i - (g (k + 1)).coeff i ∈ I ^ j := by
          have hmem := hg k i
          rw [Polynomial.coeff_sub] at hmem
          have hle : I ^ (k + 1) ≤ I ^ j := Ideal.pow_le_pow_right (by omega)
          rw [← neg_sub]
          exact neg_mem (hle hmem)
        have hprev := ih (by omega)
        have hsum := Submodule.add_mem _ hprev hstep
        have hrw : (g j).coeff i - (g k).coeff i + ((g k).coeff i - (g (k + 1)).coeff i)
            = (g j).coeff i - (g (k + 1)).coeff i := by ring
        rwa [hrw] at hsum
      · have hj : j = k + 1 := by omega
        subst hj
        rw [sub_self]
        exact Submodule.zero_mem _

/-- **A Cauchy sequence of polynomials whose high coefficients are frozen has a limit.** -/
theorem exists_adic_limit_polynomial (I : Ideal S) [IsAdicComplete I S] {N : ℕ} (g : ℕ → S[X])
    (hg : ∀ k, CoeffMem (I ^ (k + 1)) (g (k + 1) - g k))
    (hfix : ∀ k i, N ≤ i → (g k).coeff i = (g 0).coeff i) :
    ∃ G : S[X], (∀ i, N ≤ i → G.coeff i = (g 0).coeff i) ∧ ∀ k, CoeffMem (I ^ k) (G - g k) := by
  classical
  have hlim : ∀ i : ℕ, ∃ c : S, ∀ k, (g k).coeff i - c ∈ I ^ k := by
    intro i
    obtain ⟨c, hc⟩ := IsPrecomplete.prec' (I := I) (M := S) (fun k => (g k).coeff i)
      (fun {j k} hjk => smodEq_iff_sub_mem.2 (coeff_sub_mem_of_cauchy g hg i j k hjk))
    exact ⟨c, fun k => smodEq_iff_sub_mem.1 (hc k)⟩
  choose c hc using hlim
  have hcoeff : ∀ i : ℕ, (g 0 + ∑ j ∈ Finset.range N,
      Polynomial.C (c j - (g 0).coeff j) * X ^ j).coeff i
      = if i < N then c i else (g 0).coeff i := by
    intro i
    rw [Polynomial.coeff_add, Polynomial.finsetSum_coeff]
    by_cases hi : i < N
    · rw [if_pos hi, Finset.sum_eq_single i]
      · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
        ring
      · intro b _ hb
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (Ne.symm hb), mul_zero]
      · intro hcon
        exact absurd (Finset.mem_range.2 hi) hcon
    · have hzero : ∀ b ∈ Finset.range N,
          (Polynomial.C (c b - (g 0).coeff b) * X ^ b).coeff i = 0 := by
        intro b hb
        have hbN : b < N := Finset.mem_range.1 hb
        have hne : i ≠ b := by omega
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hne, mul_zero]
      rw [if_neg hi, Finset.sum_congr rfl hzero, Finset.sum_const_zero, add_zero]
  refine ⟨g 0 + ∑ j ∈ Finset.range N, Polynomial.C (c j - (g 0).coeff j) * X ^ j, ?_, ?_⟩
  · intro i hi
    rw [hcoeff i, if_neg (by omega)]
  · intro k i
    rw [Polynomial.coeff_sub, hcoeff i]
    by_cases hi : i < N
    · rw [if_pos hi]
      have hmem : -((g k).coeff i - c i) ∈ I ^ k := neg_mem (hc i k)
      rwa [neg_sub] at hmem
    · rw [if_neg hi, hfix k i (by omega), sub_self]
      exact Submodule.zero_mem _

/-! ## Hensel's lemma -/

/-- **Hensel's lemma, divisor form.**  Over a ring complete for `I`, a monic polynomial dividing
`f` modulo `I`, whose complementary quotient is invertible modulo the ideal generated by `g₀` and
`I`, lifts to a genuine monic divisor of `f` of the same degree. -/
theorem exists_monic_dvd_of_coeffMem_modByMonic [Nontrivial S] (I : Ideal S) [IsAdicComplete I S]
    {f g₀ v z : S[X]} (hg₀ : g₀.Monic)
    (hmod : CoeffMem I (f %ₘ g₀))
    (hbez : CoeffMem I (v * (f /ₘ g₀) + z * g₀ - 1)) :
    ∃ g : S[X], g.Monic ∧ g.degree = g₀.degree ∧ g ∣ f ∧ CoeffMem I (g - g₀) := by
  classical
  have hmonic : ∀ {g : S[X]}, (g - g₀).degree < g₀.degree → g.Monic := by
    intro g hsub
    have hrw : g = g₀ + (g - g₀) := by ring
    rw [hrw]
    exact hg₀.add_of_left hsub
  set Good : ℕ → S[X] → Prop := fun k g =>
    (g - g₀).degree < g₀.degree ∧ CoeffMem I (g - g₀) ∧ CoeffMem (I ^ (k + 1)) (f %ₘ g)
    with hGooddef
  have hstep : ∀ (k : ℕ) (g : S[X]), ∃ g' : S[X],
      Good k g → Good (k + 1) g' ∧ CoeffMem (I ^ (k + 1)) (g' - g) := by
    intro k g
    by_cases hgood : Good k g
    · obtain ⟨hsub, hgg₀, hE⟩ := hgood
      have hgm : g.Monic := hmonic hsub
      obtain ⟨p, hpdeg, hpmem, hnext⟩ :=
        hensel_step (I := I) (f := f) (g := g) (g₀ := g₀) (v := v) (z := z) k hgm hg₀ hgg₀ hbez hE
      have hgdeg : g.degree = g₀.degree := by
        have hrw : g = g₀ + (g - g₀) := by ring
        rw [hrw]
        exact Polynomial.degree_add_eq_left_of_degree_lt hsub
      refine ⟨g + p, fun _ => ⟨⟨?_, ?_, hnext⟩, ?_⟩⟩
      · have hrw : g + p - g₀ = (g - g₀) + p := by ring
        rw [hrw]
        refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt hsub ?_)
        rwa [hgdeg] at hpdeg
      · have hrw : g + p - g₀ = (g - g₀) + p := by ring
        rw [hrw]
        have hle : I ^ (k + 1) ≤ I := by
          have hp1 := Ideal.pow_le_pow_right (I := I) (show 1 ≤ k + 1 by omega)
          rwa [pow_one] at hp1
        exact hgg₀.add (hpmem.mono hle)
      · have hrw : g + p - g = p := by ring
        rw [hrw]
        exact hpmem
    · exact ⟨g, fun hc => absurd hc hgood⟩
  choose F hF using hstep
  set seq : ℕ → S[X] := fun k => Nat.rec g₀ (fun j s => F j s) k with hseqdef
  have hseq0 : seq 0 = g₀ := rfl
  have hgood : ∀ k, Good k (seq k) := by
    intro k
    induction k with
    | zero =>
        refine ⟨?_, ?_, ?_⟩
        · rw [hseq0, sub_self, Polynomial.degree_zero]
          exact bot_lt_iff_ne_bot.2 fun hc => hg₀.ne_zero (Polynomial.degree_eq_bot.1 hc)
        · rw [hseq0, sub_self]
          exact coeffMem_zero
        · rw [hseq0, pow_one]
          exact hmod
    | succ k ih => exact (hF k (seq k) ih).1
  have hdiff : ∀ k, CoeffMem (I ^ (k + 1)) (seq (k + 1) - seq k) :=
    fun k => (hF k (seq k) (hgood k)).2
  have hfix : ∀ k i, g₀.natDegree ≤ i → (seq k).coeff i = (seq 0).coeff i := by
    intro k i hi
    have hsub := (hgood k).1
    have hdlt : (seq k - g₀).degree < (i : WithBot ℕ) := by
      refine lt_of_lt_of_le hsub ?_
      rw [Polynomial.degree_eq_natDegree hg₀.ne_zero]
      exact_mod_cast hi
    have hzero : (seq k - g₀).coeff i = 0 := Polynomial.coeff_eq_zero_of_degree_lt hdlt
    rw [Polynomial.coeff_sub, sub_eq_zero] at hzero
    rw [hzero, hseq0]
  obtain ⟨G, hGfix, hGlim⟩ :=
    exists_adic_limit_polynomial (N := g₀.natDegree) I seq hdiff hfix
  have hGsub : CoeffMem I (G - g₀) := by
    have h1 : CoeffMem I (G - seq 1) := (hGlim 1).mono (le_of_eq (pow_one I))
    have h2 : CoeffMem I (seq 1 - g₀) := (hgood 1).2.1
    have hsum := h1.add h2
    have hrw : G - seq 1 + (seq 1 - g₀) = G - g₀ := by ring
    rwa [hrw] at hsum
  have hGdeg : (G - g₀).degree < g₀.degree := by
    have hdlt : (G - g₀).degree < (g₀.natDegree : WithBot ℕ) := by
      refine (Polynomial.degree_lt_iff_coeff_zero _ _).2 ?_
      intro m hm
      rw [Polynomial.coeff_sub, hGfix m hm, hseq0, sub_self]
    rwa [Polynomial.degree_eq_natDegree hg₀.ne_zero]
  have hGmonic : G.Monic := hmonic hGdeg
  have hGdegeq : G.degree = g₀.degree := by
    have hrw : G = g₀ + (G - g₀) := by ring
    rw [hrw]
    exact Polynomial.degree_add_eq_left_of_degree_lt hGdeg
  refine ⟨G, hGmonic, hGdegeq, ?_, hGsub⟩
  have hzero : f %ₘ G = 0 := by
    have hall : ∀ k, CoeffMem (I ^ k) (f %ₘ G) := by
      intro k
      have hseqmonic : (seq k).Monic := hmonic (hgood k).1
      have h1 : CoeffMem (I ^ k) (f %ₘ G - f %ₘ seq k) :=
        coeffMem_modByMonic_sub hGmonic hseqmonic (hGlim k)
      have h2 : CoeffMem (I ^ k) (f %ₘ seq k) :=
        ((hgood k).2.2).mono (Ideal.pow_le_pow_right (by omega))
      have hsum := h1.add h2
      have hrw : f %ₘ G - f %ₘ seq k + f %ₘ seq k = f %ₘ G := by ring
      rwa [hrw] at hsum
    ext i
    rw [Polynomial.coeff_zero]
    refine IsHausdorff.haus' (I := I) (M := S) ((f %ₘ G).coeff i) fun k => ?_
    refine smodEq_iff_sub_mem.2 ?_
    rw [sub_zero]
    exact hall k i
  exact (modByMonic_eq_zero_iff_dvd hGmonic).mp hzero

/-- **Hensel's lemma, factorisation form.**  An approximate factorisation into a monic factor and
a complementary factor invertible modulo `(g₀, I)` lifts to a genuine factorisation. -/
theorem exists_monic_factorization [Nontrivial S] (I : Ideal S) [IsAdicComplete I S]
    {f g₀ h₀ v z : S[X]} (hg₀ : g₀.Monic)
    (happrox : CoeffMem I (f - g₀ * h₀))
    (hbez : CoeffMem I (v * h₀ + z * g₀ - 1)) :
    ∃ g h : S[X], g.Monic ∧ g.degree = g₀.degree ∧ f = g * h ∧
      CoeffMem I (g - g₀) ∧ CoeffMem I (h - h₀) := by
  classical
  -- the quotient of `f` by `g₀` is `h₀` modulo `I`
  have hquot : CoeffMem I (f /ₘ g₀ - h₀) := by
    rw [coeffMem_iff_map_eq_zero] at happrox ⊢
    rw [Polynomial.map_sub, sub_eq_zero] at happrox
    rw [Polynomial.map_sub, Polynomial.map_divByMonic _ hg₀, happrox, Polynomial.map_mul,
      Polynomial.mul_divByMonic_cancel_left _ (hg₀.map _), sub_self]
  have hmod : CoeffMem I (f %ₘ g₀) := by
    rw [coeffMem_iff_map_eq_zero] at happrox ⊢
    rw [Polynomial.map_sub, sub_eq_zero] at happrox
    rw [Polynomial.map_modByMonic _ hg₀, happrox, Polynomial.map_mul]
    exact (Polynomial.modByMonic_eq_zero_iff_dvd (hg₀.map _)).2 ⟨_, rfl⟩
  have hbez' : CoeffMem I (v * (f /ₘ g₀) + z * g₀ - 1) := by
    have hrw : v * (f /ₘ g₀) + z * g₀ - 1
        = (v * h₀ + z * g₀ - 1) + v * (f /ₘ g₀ - h₀) := by ring
    rw [hrw]
    exact hbez.add (hquot.mul_left v)
  obtain ⟨g, hgm, hgdeg, ⟨h, hfh⟩, hgsub⟩ :=
    exists_monic_dvd_of_coeffMem_modByMonic I hg₀ hmod hbez'
  refine ⟨g, h, hgm, hgdeg, hfh, hgsub, ?_⟩
  -- the complementary factor is congruent to `h₀`
  have hgmap : g.map (Ideal.Quotient.mk I) = g₀.map (Ideal.Quotient.mk I) := by
    have := (coeffMem_iff_map_eq_zero (J := I)).1 hgsub
    rwa [Polynomial.map_sub, sub_eq_zero] at this
  have hquot' : h = f /ₘ g := by
    rw [hfh, Polynomial.mul_divByMonic_cancel_left _ hgm]
  rw [hquot']
  have hstep : CoeffMem I (f /ₘ g - f /ₘ g₀) := coeffMem_divByMonic_sub hgm hg₀ hgsub
  have hrw : f /ₘ g - h₀ = (f /ₘ g - f /ₘ g₀) + (f /ₘ g₀ - h₀) := by ring
  rw [hrw]
  exact hstep.add hquot

end GaloisForLFunctions.HTGeometry
