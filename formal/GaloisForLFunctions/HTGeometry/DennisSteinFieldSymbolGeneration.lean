import GaloisForLFunctions.HTGeometry.DennisSteinSymbolReduction
import GaloisForLFunctions.HTGeometry.DennisSteinTransportSymbol
import GaloisForLFunctions.HTGeometry.TriangleTorusDefectSymbol

/-!
# Field Dennis--Stein symbols reduce to torus symbols

The triangle correction in the Dennis--Stein right-one formula is itself the
inverse symbol `{v, −1}`.  Thus every right-one word is a product of two
Steinberg symbols.  The existing field normalization then removes the final
obstruction: every Dennis--Stein word over a field lies in the subgroup generated
by Steinberg symbols.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n] [Fintype n]

/-- The torus-triangle correction belongs to the subgroup generated by Steinberg symbols. -/
theorem torusTriangleDefect_mem_symbolSubgroup {i j k : n} (hij : i ≠ j) (hjk : j ≠ k)
    (hik : i ≠ k) (v : Rˣ) :
    torusTriangleDefect hij hjk hik v ∈ steinbergSymbolSubgroup R n := by
  rw [torusTriangleDefect_eq_symbol_inv hij hjk hik v]
  exact (steinbergSymbolSubgroup R n).inv_mem (steinbergSymbol_mem_symbolSubgroup hik v (-1))

/-- A right-one Dennis--Stein word is an explicit product of two torus symbols. -/
theorem dennisStein_right_one_eq_two_symbols {i j k : n} (hij : i ≠ j) (hjk : j ≠ k)
    (hik : i ≠ k) (a b : R) (v : Rˣ) (hv : (v : R) = 1 + a * b) :
    dennisStein hij (a * b) 1 v
      = (steinbergSymbol hjk (-1) v * (steinbergSymbol hij v (-1 : Rˣ))⁻¹)⁻¹ := by
  have hright : dennisStein hij (a * b) 1 v
      = (steinbergSymbol hjk (-1) v * torusTriangleDefect hik (Ne.symm hjk) hij v)⁻¹ := by
    simpa using dennisStein_right_one_eq_symbol_defect hik (Ne.symm hjk) hij a b v hv
  rw [hright, torusTriangleDefect_eq_symbol_inv hik (Ne.symm hjk) hij v]

/-- Every Dennis--Stein word over a field belongs to the Steinberg-symbol subgroup. -/
theorem dennisStein_mem_symbolSubgroup {F : Type*} [Field F]
    {n : Type*} [DecidableEq n] [Fintype n] {i j k : n} (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (a b : F) (w : Fˣ) (hw : (w : F) = 1 + a * b) :
    dennisStein hij a b w ∈ steinbergSymbolSubgroup F n := by
  apply (dennisStein_mem_symbolSubgroup_iff_right_one hij hik hjk a b w hw).2
  have hright : dennisStein hij (a * b) 1 w
      = (steinbergSymbol hjk (-1) w * (steinbergSymbol hij w (-1 : Fˣ))⁻¹)⁻¹ := by
    exact dennisStein_right_one_eq_two_symbols hij hjk hik a b w hw
  rw [hright]
  exact (steinbergSymbolSubgroup F n).inv_mem
    ((steinbergSymbolSubgroup F n).mul_mem
      (steinbergSymbol_mem_symbolSubgroup hjk (-1) w)
      ((steinbergSymbolSubgroup F n).inv_mem (steinbergSymbol_mem_symbolSubgroup hij w (-1))))

end GaloisForLFunctions.HTGeometry
