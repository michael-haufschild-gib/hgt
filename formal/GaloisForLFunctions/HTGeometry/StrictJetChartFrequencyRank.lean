import GaloisForLFunctions.HTGeometry.StrictHullFrequencyRank
import GaloisForLFunctions.HTGeometry.CarrierRepresentative
import GaloisForLFunctions.HTGeometry.StripSolutionPhaseRankSharp
import GaloisForLFunctions.HTGeometry.BohrBochnerEquivalence
import GaloisForLFunctions.HTGeometry.BohrHullFrequency

/-!
# The strict frequency-rank law for an autonomous strip solution

The jet-at-a-real-point map of the carrier representatives is continuous, and the card's uniqueness
hypothesis makes it injective.  Splitting the complex jet into real and imaginary parts turns it
into a globally injective chart of the phase carrier into `ℝ^{2n}`, so the strict chart bound gives
frequency rank at most `2n - 1`.
-/

open Metric Set Topology

namespace GaloisForLFunctions

open scoped BoundedContinuousFunction

/-- Splitting a complex jet into its real and imaginary coordinates. -/
def complexJetToReal (n : ℕ) (v : Fin n → ℂ) : EuclideanSpace ℝ (Fin (2 * n)) :=
  (WithLp.toLp 2) fun i : Fin (2 * n) =>
    if h : (i : ℕ) < n then (v ⟨(i : ℕ), h⟩).re
    else (v ⟨(i : ℕ) - n, by omega⟩).im

theorem continuous_complexJetToReal (n : ℕ) : Continuous (complexJetToReal n) := by
  refine continuous_induced_rng.mpr (continuous_pi fun i => ?_)
  by_cases h : (i : ℕ) < n
  · have hfun : (fun v : Fin n → ℂ => (complexJetToReal n v) i)
        = fun v : Fin n → ℂ => (v ⟨(i : ℕ), h⟩).re := by
      funext v
      simp only [complexJetToReal]
      rw [dif_pos h]
    simp only [Function.comp_apply]
    rw [hfun]
    fun_prop
  · have hfun : (fun v : Fin n → ℂ => (complexJetToReal n v) i)
        = fun v : Fin n → ℂ => (v ⟨(i : ℕ) - n, by omega⟩).im := by
      funext v
      simp only [complexJetToReal]
      rw [dif_neg h]
    simp only [Function.comp_apply]
    rw [hfun]
    fun_prop

theorem injective_complexJetToReal (n : ℕ) : Function.Injective (complexJetToReal n) := by
  intro v v' h
  funext k
  have hre : (v k).re = (v' k).re := by
    have hk : ((k : ℕ) : ℕ) < 2 * n := by omega
    have := congrFun (congrArg WithLp.ofLp h) (⟨(k : ℕ), hk⟩ : Fin (2 * n))
    simpa [complexJetToReal, Nat.lt_irrefl, k.isLt] using this
  have him : (v k).im = (v' k).im := by
    have hk : ((k : ℕ) + n : ℕ) < 2 * n := by omega
    have hnk : ¬ ((k : ℕ) + n < n) := by omega
    have := congrFun (congrArg WithLp.ofLp h) (⟨(k : ℕ) + n, hk⟩ : Fin (2 * n))
    simp only [complexJetToReal, dif_neg hnk] at this
    have hidx : ((k : ℕ) + n - n) = (k : ℕ) := by omega
    simpa [hidx] using this
  exact Complex.ext hre him

end GaloisForLFunctions

namespace GaloisForLFunctions

open Metric Set Topology

open scoped BoundedContinuousFunction

variable {σ r ρ : ℝ}

/-- **The strict frequency-rank law for an autonomous strip solution.**  If the jet-at-a-point map
of the carrier representatives is injective — the card's uniqueness hypothesis on the compact jet
hull — then the rational rank of the frequency group is at most `2n - 1`, strictly below the real
dimension `2n` of the complex jet space. -/
theorem rank_bohrHullFrequencies_le_pred_of_jet_injective
    (hρ : 0 < ρ) (hrpos : 0 < r) (hlt : r < r + ρ)
    {f : ℝ →ᵇ ℂ} {Gb : ℝ →ᵇ ((closedStrip σ (r + ρ)) →ᵇ ℂ)}
    {ν : BohrHull f → BohrHull Gb} (hν : Continuous ν)
    {rep : BohrHull f → (ℂ → ℂ)}
    (hrepdiff : ∀ x, DifferentiableOn ℂ (rep x) (verticalStrip σ (r + ρ)))
    (hrepval : ∀ (x : BohrHull f) (z : closedStrip σ (r + ρ)),
      rep x (z : ℂ) = bohrEval Gb (ν x) z)
    (hf : UniformContinuous (fun x => f x)) (htb : HasTotallyBoundedOrbit (fun x => f x))
    [MeasurableSpace (BohrHull f)] [BorelSpace (BohrHull f)]
    {n : ℕ} (hn : 0 < n)
    (hinj : Function.Injective fun x : BohrHull f =>
      (fun k : Fin n => iteratedDeriv (k : ℕ) (rep x) ((σ : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))) :
    Module.rank ℤ (bohrHullFrequencies f) ≤ ((2 * n - 1 : ℕ) : Cardinal) := by
  refine rank_bohrHullFrequencies_le_pred_of_global_chart hf htb (k := 2 * n) (by omega)
    (fun x => complexJetToReal n (fun k : Fin n =>
      iteratedDeriv (k : ℕ) (rep x) ((σ : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))) ?_ ?_
  · refine (continuous_complexJetToReal n).comp (continuous_pi fun k => ?_)
    exact continuous_jet_of_representatives hρ hrpos hlt hν hrepdiff hrepval (k : ℕ) 0
  · intro x y hxy
    exact hinj (injective_complexJetToReal n hxy)

end GaloisForLFunctions

namespace GaloisForLFunctions

open Metric Set Topology

open scoped BoundedContinuousFunction

variable {σ r ρ : ℝ}

/-- **The card's strict frequency law.**  The additive group generated by the Bohr frequencies of
the line restriction has rational rank at most `2n - 1`. -/
theorem rank_bohrSpectrum_le_pred_of_jet_injective
    (hρ : 0 < ρ) (hrpos : 0 < r) (hlt : r < r + ρ)
    {f : ℝ →ᵇ ℂ} {Gb : ℝ →ᵇ ((closedStrip σ (r + ρ)) →ᵇ ℂ)}
    {ν : BohrHull f → BohrHull Gb} (hν : Continuous ν)
    {rep : BohrHull f → (ℂ → ℂ)}
    (hrepdiff : ∀ x, DifferentiableOn ℂ (rep x) (verticalStrip σ (r + ρ)))
    (hrepval : ∀ (x : BohrHull f) (z : closedStrip σ (r + ρ)),
      rep x (z : ℂ) = bohrEval Gb (ν x) z)
    (hfap : HTGeometry.IsBohrAlmostPeriodic (fun x : ℝ => f x))
    [MeasurableSpace (BohrHull f)] [BorelSpace (BohrHull f)]
    {n : ℕ} (hn : 0 < n)
    (hinj : Function.Injective fun x : BohrHull f =>
      (fun k : Fin n => iteratedDeriv (k : ℕ) (rep x) ((σ : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))) :
    Module.rank ℤ (AddSubgroup.closure (bohrSpectrum (fun x => f x)))
      ≤ ((2 * n - 1 : ℕ) : Cardinal) := by
  have hfu : UniformContinuous (fun x : ℝ => f x) :=
    uniformContinuous_of_isBohrAlmostPeriodic f.continuous hfap
  have hftb : HasTotallyBoundedOrbit (fun x : ℝ => f x) :=
    hasTotallyBoundedOrbit_of_isBohrAlmostPeriodic f.continuous hfap
  refine le_trans (rank_le_of_addSubgroup_le (closure_bohrSpectrum_le_bohrHullFrequencies hfap)) ?_
  exact rank_bohrHullFrequencies_le_pred_of_jet_injective hρ hrpos hlt hν hrepdiff hrepval
    hfu hftb hn hinj

/-- **The observable form of the strict law.**  Every continuous observable of the carrier — in
particular every continuous translation-equivariant divisor observable — has frequency group of
rational rank at most `2n - 1`. -/
theorem rank_bohrSpectrum_observable_le_pred_of_jet_injective
    (hρ : 0 < ρ) (hrpos : 0 < r) (hlt : r < r + ρ)
    {f : ℝ →ᵇ ℂ} {Gb : ℝ →ᵇ ((closedStrip σ (r + ρ)) →ᵇ ℂ)}
    {ν : BohrHull f → BohrHull Gb} (hν : Continuous ν)
    {rep : BohrHull f → (ℂ → ℂ)}
    (hrepdiff : ∀ x, DifferentiableOn ℂ (rep x) (verticalStrip σ (r + ρ)))
    (hrepval : ∀ (x : BohrHull f) (z : closedStrip σ (r + ρ)),
      rep x (z : ℂ) = bohrEval Gb (ν x) z)
    (hfap : HTGeometry.IsBohrAlmostPeriodic (fun x : ℝ => f x))
    [MeasurableSpace (BohrHull f)] [BorelSpace (BohrHull f)]
    {n : ℕ} (hn : 0 < n)
    (hinj : Function.Injective fun x : BohrHull f =>
      (fun k : Fin n => iteratedDeriv (k : ℕ) (rep x) ((σ : ℂ) + ((0 : ℝ) : ℂ) * Complex.I)))
    (Ψ : BohrHull f → ℂ) (hΨ : Continuous Ψ) :
    Module.rank ℤ (AddSubgroup.closure (bohrSpectrum (fun t : ℝ => Ψ (bohrIota f t))))
      ≤ ((2 * n - 1 : ℕ) : Cardinal) := by
  have hfu : UniformContinuous (fun x : ℝ => f x) :=
    uniformContinuous_of_isBohrAlmostPeriodic f.continuous hfap
  have hftb : HasTotallyBoundedOrbit (fun x : ℝ => f x) :=
    hasTotallyBoundedOrbit_of_isBohrAlmostPeriodic f.continuous hfap
  have hsub : AddSubgroup.closure (bohrSpectrum (fun t : ℝ => Ψ (bohrIota f t)))
      ≤ bohrHullFrequencies f :=
    AddSubgroup.closure_le _ |>.mpr
      (bohrSpectrum_observable_subset_bohrHullFrequencies hfu hftb Ψ hΨ)
  refine le_trans (rank_le_of_addSubgroup_le hsub) ?_
  exact rank_bohrHullFrequencies_le_pred_of_jet_injective hρ hrpos hlt hν hrepdiff hrepval
    hfu hftb hn hinj

end GaloisForLFunctions
