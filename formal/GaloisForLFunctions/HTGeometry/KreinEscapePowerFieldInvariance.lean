import GaloisForLFunctions.HTGeometry.KreinEscapeAnalyticFamily
import GaloisForLFunctions.HTGeometry.MovingCanonicalSurgeryFieldInvariance

/-!
# The escape gauge is invisible at every power level

`faithful-krein-index-escape-stratification`, equations `(4)` and statement `3`.

The normalized remote-pair gauge is a polynomial, hence a unit of the rational differential base
field `ℂ(z)`.  Consequently, for every `N ≥ 1`, the differential field generated over `ℂ(z)` by the
`N`-th powers of the full complex translation orbit of `A_(r,T)·F` equals the one generated by the
`N`-th powers of the orbit of `F`, and differential independence of the orbit transfers in both
directions.
-/

open Complex Filter Polynomial

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-! ## The gauge as a polynomial -/

/-- One normalized remote pair factor as a polynomial. -/
def remotePairFactorPoly (t : ℂ) : Polynomial ℂ :=
  Polynomial.C ((Complex.normSq t : ℂ))⁻¹ *
    ((Polynomial.X - Polynomial.C t) * (Polynomial.X - Polynomial.C ((starRingEnd ℂ) t)))

/-- The whole gauge as a polynomial. -/
def remotePairGaugePoly {r : ℕ} (te : Fin r → ℂ) : Polynomial ℂ :=
  ∏ q, remotePairFactorPoly (te q)

@[simp] theorem eval_remotePairFactorPoly (t z : ℂ) :
    (remotePairFactorPoly t).eval z = remotePairFactor t z := by
  rw [remotePairFactorPoly, remotePairFactor]
  simp only [eval_mul, eval_C, eval_sub, eval_X]
  field_simp

@[simp] theorem eval_remotePairGaugePoly {r : ℕ} (te : Fin r → ℂ) (z : ℂ) :
    (remotePairGaugePoly te).eval z = remotePairGauge te z := by
  rw [remotePairGaugePoly, remotePairGauge, eval_prod]
  exact Finset.prod_congr rfl fun q _ => eval_remotePairFactorPoly (te q) z

theorem remotePairFactor_zero {t : ℂ} (ht : t ≠ 0) : remotePairFactor t 0 = 1 := by
  have hns : (Complex.normSq t : ℂ) ≠ 0 := normSq_ne_zero_of_ne_zero ht
  rw [remotePairFactor]
  have : (0 - t) * (0 - (starRingEnd ℂ) t) = (Complex.normSq t : ℂ) := by
    rw [show (0 - t) * (0 - (starRingEnd ℂ) t) = t * (starRingEnd ℂ) t by ring]
    exact Complex.mul_conj t
  rw [this, div_self hns]

theorem remotePairGauge_zero {r : ℕ} {te : Fin r → ℂ} (hte : ∀ q, te q ≠ 0) :
    remotePairGauge te 0 = 1 := by
  rw [remotePairGauge]
  exact Finset.prod_eq_one fun q _ => remotePairFactor_zero (hte q)

theorem remotePairGaugePoly_ne_zero {r : ℕ} {te : Fin r → ℂ} (hte : ∀ q, te q ≠ 0) :
    remotePairGaugePoly te ≠ 0 := by
  intro h
  have hev : (remotePairGaugePoly te).eval 0 = 1 := by
    rw [eval_remotePairGaugePoly, remotePairGauge_zero hte]
  rw [h, eval_zero] at hev
  exact zero_ne_one hev

/-! ## Translation orbits in the upper-end meromorphic field -/

theorem analyticOnNhd_translate_upperTail {f : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f Set.univ) (h : ℂ) :
    AnalyticOnNhd ℂ (fun z => f (z + h)) (upperTail 0) := by
  intro z _
  exact AnalyticAt.comp (x := z) (hf (z + h) (Set.mem_univ _))
    (analyticAt_id.add analyticAt_const)

/-- The full complex translation orbit of the ungauged carrier. -/
def surgeryProductTranslateFamily {k : ℕ} (θ : BoundedRealSequence)
    (aIdx bIdx : Fin k → ℕ) (tb : Fin k → ℂ) (h : ℂ) : upperEndMeroField :=
  analyticUpperEndMero (fun z => movingCanonicalSurgeryProduct θ aIdx bIdx tb (z + h)) 0
    (analyticOnNhd_translate_upperTail
      (movingCanonicalSurgeryProduct_analytic θ aIdx bIdx tb) h)

/-- The full complex translation orbit of the gauged carrier. -/
def kreinEscapeTranslateFamily {k r : ℕ} (θ : BoundedRealSequence)
    (aIdx bIdx : Fin k → ℕ) (tb : Fin k → ℂ) (te : Fin r → ℂ) (h : ℂ) : upperEndMeroField :=
  analyticUpperEndMero (fun z => kreinEscapeProduct θ aIdx bIdx tb te (z + h)) 0
    (analyticOnNhd_translate_upperTail
      (kreinEscapeProduct_analytic θ aIdx bIdx tb te) h)

theorem eval_polyTranslationEquiv (h : ℂ) (p : Polynomial ℂ) (z : ℂ) :
    (polyTranslationEquiv h p).eval z = p.eval (z + h) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp only [map_add, eval_add, hp, hq]
  | monomial n a =>
      simp [polyTranslationEquiv, Polynomial.aeval_def, Polynomial.eval_monomial]

/-- **The gauged orbit is the ungauged orbit times a polynomial unit of the base field.** -/
theorem kreinEscapeTranslateFamily_eq_mul {k r : ℕ} (θ : BoundedRealSequence)
    (aIdx bIdx : Fin k → ℕ) (tb : Fin k → ℂ) (te : Fin r → ℂ) (h : ℂ) :
    letI := isDomain_upperEndAnalyticSubring
    kreinEscapeTranslateFamily θ aIdx bIdx tb te h
      = upperEndPolyToMero (polyTranslationEquiv h (remotePairGaugePoly te))
        * surgeryProductTranslateFamily θ aIdx bIdx tb h := by
  letI := isDomain_upperEndAnalyticSubring
  rw [kreinEscapeTranslateFamily, surgeryProductTranslateFamily, analyticUpperEndMero,
    analyticUpperEndMero, upperEndPolyToMero]
  rw [← map_mul]
  congr 1
  apply Subtype.ext
  change (((fun z : ℂ => kreinEscapeProduct θ aIdx bIdx tb te (z + h))) :
      Germ upperEndFilter ℂ)
    = _
  rw [MulMemClass.coe_mul]
  change _ = ((fun z : ℂ => (polyTranslationEquiv h (remotePairGaugePoly te)).eval z) :
      Germ upperEndFilter ℂ)
      * ((fun z : ℂ => movingCanonicalSurgeryProduct θ aIdx bIdx tb (z + h)) :
        Germ upperEndFilter ℂ)
  rw [← Germ.coe_mul]
  apply Filter.Germ.coe_eq.mpr
  refine Filter.Eventually.of_forall fun z => ?_
  rw [eval_polyTranslationEquiv, eval_remotePairGaugePoly]
  rfl

/-! ## Power-level invariance -/

/-- **Equation (4).**  For every power `N`, the gauged translation orbit generates exactly the same
differential field over `ℂ(z)` as the ungauged one. -/
theorem kreinEscapeTranslateFamily_differentialAdjoin_pow_eq {k r : ℕ}
    (θ : BoundedRealSequence) (aIdx bIdx : Fin k → ℕ) (tb : Fin k → ℂ)
    {te : Fin r → ℂ} (hte : ∀ q, te q ≠ 0) (N : ℕ) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := ratFuncCoordinateDifferential
    letI := upperEndMeroFieldDifferential
    letI : DifferentialAlgebra (RatFunc ℂ) upperEndMeroField :=
      upperEndRatfuncDifferentialAlgebra
    differentialAdjoin (RatFunc ℂ)
        (Set.range fun h : ℂ => (kreinEscapeTranslateFamily θ aIdx bIdx tb te h) ^ N) =
      differentialAdjoin (RatFunc ℂ)
        (Set.range fun h : ℂ => (surgeryProductTranslateFamily θ aIdx bIdx tb h) ^ N) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI : Differential (RatFunc ℂ) := ratFuncCoordinateDifferential
  letI := upperEndMeroFieldDifferential
  letI : DifferentialAlgebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncDifferentialAlgebra
  have hgauge : ∀ h : ℂ,
      kreinEscapeTranslateFamily θ aIdx bIdx tb te h
        = algebraMap (RatFunc ℂ) upperEndMeroField
            (algebraMap (Polynomial ℂ) (RatFunc ℂ)
              (polyTranslationEquiv h (remotePairGaugePoly te)))
          * surgeryProductTranslateFamily θ aIdx bIdx tb h := by
    intro h
    rw [kreinEscapeTranslateFamily_eq_mul θ aIdx bIdx tb te h]
    congr 1
    exact (upperEndRatfuncToMero_algebraMap_polynomial _).symm
  have hne : ∀ h : ℂ,
      (algebraMap (Polynomial ℂ) (RatFunc ℂ)
        (polyTranslationEquiv h (remotePairGaugePoly te))) ≠ 0 := by
    intro h
    rw [Ne, RatFunc.algebraMap_eq_zero_iff]
    intro hcon
    exact remotePairGaugePoly_ne_zero hte
      ((polyTranslationEquiv h).injective (by simpa using hcon))
  rw [funext hgauge]
  exact differentialAdjoin_range_pow_baseGauge_eq
    (fun h : ℂ => surgeryProductTranslateFamily θ aIdx bIdx tb h)
    (fun h : ℂ => algebraMap (Polynomial ℂ) (RatFunc ℂ)
      (polyTranslationEquiv h (remotePairGaugePoly te))) hne N

/-- **Statement 3.**  Differential independence of the full translation orbit transfers in both
directions across the gauge. -/
theorem kreinEscapeTranslateFamily_differentialIndependent_iff {k r : ℕ}
    (θ : BoundedRealSequence) (aIdx bIdx : Fin k → ℕ) (tb : Fin k → ℂ)
    {te : Fin r → ℂ} (hte : ∀ q, te q ≠ 0) :
    letI := isDomain_upperEndAnalyticSubring
    letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
    letI := ratFuncCoordinateDifferential
    letI := upperEndMeroFieldDifferential
    letI : DifferentialAlgebra (RatFunc ℂ) upperEndMeroField :=
      upperEndRatfuncDifferentialAlgebra
    DifferentialIndependent (RatFunc ℂ) (kreinEscapeTranslateFamily θ aIdx bIdx tb te) ↔
      DifferentialIndependent (RatFunc ℂ) (surgeryProductTranslateFamily θ aIdx bIdx tb) := by
  letI := isDomain_upperEndAnalyticSubring
  letI : Algebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncToMero.toAlgebra
  letI : Differential (RatFunc ℂ) := ratFuncCoordinateDifferential
  letI := upperEndMeroFieldDifferential
  letI : DifferentialAlgebra (RatFunc ℂ) upperEndMeroField := upperEndRatfuncDifferentialAlgebra
  have hgauge : kreinEscapeTranslateFamily θ aIdx bIdx tb te
      = fun h : ℂ =>
        algebraMap (RatFunc ℂ) upperEndMeroField
            (algebraMap (Polynomial ℂ) (RatFunc ℂ)
              (polyTranslationEquiv h (remotePairGaugePoly te)))
          * surgeryProductTranslateFamily θ aIdx bIdx tb h
          + algebraMap (RatFunc ℂ) upperEndMeroField 0 := by
    funext h
    rw [map_zero, add_zero, kreinEscapeTranslateFamily_eq_mul θ aIdx bIdx tb te h]
    congr 1
    exact (upperEndRatfuncToMero_algebraMap_polynomial _).symm
  have hne : ∀ h : ℂ,
      (algebraMap (Polynomial ℂ) (RatFunc ℂ)
        (polyTranslationEquiv h (remotePairGaugePoly te))) ≠ 0 := by
    intro h
    rw [Ne, RatFunc.algebraMap_eq_zero_iff]
    intro hcon
    exact remotePairGaugePoly_ne_zero hte
      ((polyTranslationEquiv h).injective (by simpa using hcon))
  rw [hgauge]
  exact differentialIndependent_affineBase_iff
    (fun h : ℂ => surgeryProductTranslateFamily θ aIdx bIdx tb h)
    (fun h : ℂ => algebraMap (Polynomial ℂ) (RatFunc ℂ)
      (polyTranslationEquiv h (remotePairGaugePoly te)))
    (fun _ => 0) hne

end GaloisForLFunctions.HTGeometry
