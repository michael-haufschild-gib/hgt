import GaloisForLFunctions.HTGeometry.ParameterCountTranscendenceBound
import Mathlib.Data.Matrix.Mul

/-!
# Circuit coordinates live in the algebra generated by the gate entries

Applying a product of matrices to a vector is a polynomial operation in the matrix entries and the
vector coordinates.  So every coordinate of the output lies in the subalgebra generated by those
data, and the parameter count of `ParameterCountTranscendenceBound` applies.

The consequence is the transcendence half of a circuit lower bound: a state produced by a list of
gates cannot carry more algebraically independent coordinates than the number of generators of the
algebra containing all gate entries.  For two-qubit gates that number is `16` per gate, since a
`4 × 4` matrix has `16` entries.
-/

namespace GaloisForLFunctions.HTGeometry

namespace CircuitAdjoin

open Matrix

variable {K L : Type} [Field K] [CommRing L] [Algebra K L]
variable {n : Type*} [Fintype n] [DecidableEq n]

omit [DecidableEq n] in
/-- Matrix multiplication keeps entries inside a subalgebra. -/
theorem mul_entries_mem {S : Subalgebra K L} {M N : Matrix n n L}
    (hM : ∀ i j, M i j ∈ S) (hN : ∀ i j, N i j ∈ S) (i j : n) : (M * N) i j ∈ S := by
  rw [Matrix.mul_apply]
  exact Subalgebra.sum_mem _ fun k _ => Subalgebra.mul_mem _ (hM i k) (hN k j)

/-- A product of matrices keeps its entries inside a subalgebra. -/
theorem prod_entries_mem {S : Subalgebra K L} :
    ∀ (l : List (Matrix n n L)), (∀ M ∈ l, ∀ i j, M i j ∈ S) → ∀ i j, l.prod i j ∈ S := by
  intro l
  induction l with
  | nil =>
      intro _ i j
      rw [List.prod_nil]
      by_cases hij : i = j
      · subst hij
        rw [Matrix.one_apply_eq]
        exact S.one_mem
      · rw [Matrix.one_apply_ne hij]
        exact S.zero_mem
  | cons M l ih =>
      intro h i j
      rw [List.prod_cons]
      exact mul_entries_mem (fun a b => h M (List.mem_cons_self ..) a b)
        (ih (fun N hN => h N (List.mem_cons_of_mem _ hN))) i j

/-- **Circuit coordinates lie in the algebra generated by the gate entries and the input.** -/
theorem mulVec_mem {S : Subalgebra K L} (l : List (Matrix n n L)) (v : n → L)
    (hl : ∀ M ∈ l, ∀ i j, M i j ∈ S) (hv : ∀ i, v i ∈ S) (i : n) :
    (l.prod *ᵥ v) i ∈ S := by
  rw [Matrix.mulVec, dotProduct]
  exact Subalgebra.sum_mem _ fun k _ =>
    Subalgebra.mul_mem _ (prod_entries_mem l hl i k) (hv k)

/-- **The transcendence bound for a circuit.**  If every gate entry and every input coordinate lies
in the algebra generated by `m` elements, then no more than `m` output coordinates can be
algebraically independent. -/
theorem card_le_of_algebraicIndependent_mulVec {m r : ℕ} {g : Fin m → L}
    (l : List (Matrix n n L)) (v : n → L)
    (hl : ∀ M ∈ l, ∀ i j, M i j ∈ Algebra.adjoin K (Set.range g))
    (hv : ∀ i, v i ∈ Algebra.adjoin K (Set.range g))
    {c : Fin r → n} (hc : AlgebraicIndependent K fun k => (l.prod *ᵥ v) (c k)) :
    r ≤ m :=
  card_le_of_algebraicIndependent_of_mem_adjoin hc fun k => mulVec_mem l v hl hv (c k)

/-! ## Base-field inputs and gate enumeration -/

omit [DecidableEq n] in
/-- An entry that is a scalar, or an entry of a listed gate, lies in the generated algebra. -/
theorem mem_adjoin_of_eq_algebraMap_or_mem {m : ℕ} {g : Fin m → L} {a : L}
    (h : (∃ c : K, a = algebraMap K L c) ∨ a ∈ Set.range g) :
    a ∈ Algebra.adjoin K (Set.range g) := by
  rcases h with ⟨c, rfl⟩ | hmem
  · exact Subalgebra.algebraMap_mem _ c
  · exact Algebra.subset_adjoin hmem

/-- **The circuit bound for a base-field input.**  The computational basis vector has coordinates
`0` and `1`, so no generator is spent on the input. -/
theorem card_le_of_algebraicIndependent_mulVec_baseInput {m r : ℕ} {g : Fin m → L}
    (l : List (Matrix n n L)) (v : n → L)
    (hl : ∀ M ∈ l, ∀ i j, M i j ∈ Algebra.adjoin K (Set.range g))
    (hv : ∀ i, ∃ c : K, v i = algebraMap K L c)
    {c : Fin r → n} (hc : AlgebraicIndependent K fun k => (l.prod *ᵥ v) (c k)) :
    r ≤ m :=
  card_le_of_algebraicIndependent_mulVec l v hl
    (fun i => mem_adjoin_of_eq_algebraMap_or_mem (Or.inl (hv i))) hc

omit [CommRing L] [DecidableEq n] in
/-- **Sixteen generators per two-qubit gate.**  The entries of `s` gates of size `4 × 4` are
enumerated by `16 s` elements. -/
theorem exists_enumeration_of_gates (s : ℕ) (G : Fin s → Matrix (Fin 4) (Fin 4) L) :
    ∃ g : Fin (s * 16) → L, ∀ k i j, G k i j ∈ Set.range g := by
  classical
  set e : Fin (s * 16) ≃ Fin s × Fin 16 := finProdFinEquiv.symm with he
  set e' : Fin 16 ≃ Fin 4 × Fin 4 := (finProdFinEquiv (m := 4) (n := 4)).symm with he'
  refine ⟨fun t => G (e t).1 (e' (e t).2).1 (e' (e t).2).2, fun k i j => ?_⟩
  refine ⟨e.symm (k, e'.symm (i, j)), ?_⟩
  simp [he, he']

end CircuitAdjoin

end GaloisForLFunctions.HTGeometry
