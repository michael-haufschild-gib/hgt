import GaloisForLFunctions.HTGeometry.DeckClosureStableCore
import Mathlib.FieldTheory.Galois.Infinite

/-!
# Reconstructing the completed deck group from the stable core

In a Galois ambient field, passing from a subgroup of automorphisms to its fixed field forgets
only topological closure.  Consequently, when iterate images are deck fixed fields, the full
fixing subgroup of the stable core is exactly the topological closure of the group generated by
all finite-depth deck transformations.

This is the formal reconstruction counterpart of the deck-closure stable-core theorem.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

open InfiniteGalois

/-- Taking a fixed field is insensitive to topological closure in a Galois extension. -/
theorem fixedField_topologicalClosure [IsGalois K F]
    (H : Subgroup (F ≃ₐ[K] F)) :
    IntermediateField.fixedField H.topologicalClosure =
      IntermediateField.fixedField H := by
  apply le_antisymm
  · exact IntermediateField.fixedField_le (Subgroup.le_topologicalClosure H)
  · rw [IntermediateField.le_iff_le]
    apply Subgroup.topologicalClosure_minimal
    · exact (IntermediateField.le_iff_le H (IntermediateField.fixedField H)).mp le_rfl
    · exact InfiniteGalois.fixingSubgroup_isClosed (IntermediateField.fixedField H)

/-- **Deck-closure reconstruction theorem.**  In a Galois ambient field, the stable core
reconstructs the topological closure of the total iterated deck group as its full fixing
subgroup. -/
theorem fixingSubgroup_stableRangeCore_eq_deckClosure [IsGalois K F]
    (φ : F →ₐ[K] F) (Γ : ℕ → Subgroup (F ≃ₐ[K] F))
    (hdeck : ∀ n, IntermediateField.map (φ ^ n) ⊤ =
      IntermediateField.fixedField (Γ n)) :
    (stableRangeCore φ).fixingSubgroup = (⨆ n, Γ n).topologicalClosure := by
  rw [stableRangeCore_eq_fixedField_iSup φ Γ hdeck]
  rw [← fixedField_topologicalClosure (⨆ n, Γ n)]
  let H : ClosedSubgroup (F ≃ₐ[K] F) :=
    ⟨(⨆ n, Γ n).topologicalClosure,
      Subgroup.isClosed_topologicalClosure (⨆ n, Γ n)⟩
  exact InfiniteGalois.fixingSubgroup_fixedField H

end

end GaloisForLFunctions.HTGeometry
