import GaloisForLFunctions.HTGeometry.SourceBoundaryBaseChange
import GaloisForLFunctions.HTGeometry.AutomorphismFamilyOstrowski

/-!
# Source-stable differential subfields

The differential field generated by a family of observables is stable under a source automorphism
as soon as the automorphism preserves the base, commutes with the derivation, and carries every
generator into that field.  Stability in both directions makes the field a legitimate new base for
the source-boundary law.

The invariant block of a triangular datum satisfies exactly these conditions: its observables are
mapped into their own differential field by every source direction.  So the field it generates is
the base change over which the complementary block becomes flat.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The differential field generated by a set is a differential algebra inside the ambient
field. -/
instance differentialAdjoin.instDifferentialAlgebraAmbient
    (F : Type*) {K : Type*} [Field F] [Field K] [Differential F] [Differential K]
    [Algebra F K] [DifferentialAlgebra F K] (s : Set K) :
    DifferentialAlgebra (differentialAdjoin F s) K :=
  ⟨fun c =>
    (GaloisForLFunctions.derivationClosedDifferential_apply _
      (GaloisForLFunctions.derivationClosed_differentialAdjoin F s) c).symm⟩

universe u

variable {K L : Type u} [Field K] [Field L] [Algebra K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]

omit [Differential K] [DifferentialAlgebra K L] in
/-- Every jet of an element of a derivation-closed field stays inside it. -/
private theorem differentialJet_mem_of_derivationClosed {B : IntermediateField K L}
    (hB : DerivationClosed B) {w : L} (hw : w ∈ B) (n : ℕ) : differentialJet n w ∈ B := by
  induction n with
  | zero => simpa using hw
  | succ n ih => rw [differentialJet_succ]; exact hB ih

/-- **A source automorphism which fixes the base and moves every generator inside the generated
differential field maps that field into itself.** -/
theorem mapsTo_differentialAdjoin (sigma : L ≃+* L) (S : Set L)
    (hderiv : ∀ x : L, sigma x′ = (sigma x)′)
    (hbase : ∀ k : K, sigma (algebraMap K L k) ∈ differentialAdjoin K S)
    (hgen : ∀ x ∈ S, sigma x ∈ differentialAdjoin K S)
    {x : L} (hx : x ∈ differentialAdjoin K S) :
    sigma x ∈ differentialAdjoin K S := by
  refine IntermediateField.adjoin_induction K (s := GaloisForLFunctions.differentialJetSet S)
    (p := fun y _ => sigma y ∈ differentialAdjoin K S) ?_ ?_ ?_ ?_ ?_ hx
  · rintro y ⟨z, hz, n, rfl⟩
    rw [GaloisForLFunctions.ringEquiv_differentialJet (fun _ : Unit => sigma)
      (fun _ w => hderiv w) () n z]
    exact differentialJet_mem_of_derivationClosed
      (GaloisForLFunctions.derivationClosed_differentialAdjoin K S) (hgen z hz) n
  · intro c
    exact hbase c
  · intro a b _ _ ha hb
    rw [map_add]
    exact IntermediateField.add_mem _ ha hb
  · intro a _ ha
    rw [map_inv₀]
    exact IntermediateField.inv_mem _ ha
  · intro a b _ _ ha hb
    rw [map_mul]
    exact IntermediateField.mul_mem _ ha hb

/-- The inverse of a derivation-commuting automorphism commutes with the derivation. -/
private theorem ringEquiv_symm_deriv (sigma : L ≃+* L) (hderiv : ∀ x : L, sigma x′ = (sigma x)′) (x : L) :
    sigma.symm x′ = (sigma.symm x)′ := by
  apply sigma.injective
  rw [sigma.apply_symm_apply, hderiv, sigma.apply_symm_apply]

variable {I : Type u}

omit [Differential K] [Differential L] [DifferentialAlgebra K L] in
/-- The inverse of a base-preserving source automorphism preserves the base. -/
theorem ringEquiv_symm_algebraMap (tau : I → K ≃+* K) (sigma : I → L ≃+* L)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k)) (i : I) (k : K) :
    (sigma i).symm (algebraMap K L k) = algebraMap K L ((tau i).symm k) := by
  apply (sigma i).injective
  rw [(sigma i).apply_symm_apply, hcomp, RingEquiv.apply_symm_apply]

/-- **The differential field generated by a source-stable family is source-stable.**  Both
directions of stability hold as soon as every generator and its inverse image lie in the generated
field. -/
theorem sourceStable_mem_differentialAdjoin_iff (tau : I → K ≃+* K) (sigma : I → L ≃+* L)
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i (x : L), sigma i x′ = (sigma i x)′) (S : Set L)
    (hgen : ∀ i, ∀ x ∈ S, sigma i x ∈ differentialAdjoin K S)
    (hgenSymm : ∀ i, ∀ x ∈ S, (sigma i).symm x ∈ differentialAdjoin K S)
    (i : I) (x : L) :
    sigma i x ∈ differentialAdjoin K S ↔ x ∈ differentialAdjoin K S := by
  constructor
  · intro h
    have hmem := mapsTo_differentialAdjoin (sigma i).symm S
      (ringEquiv_symm_deriv (sigma i) (hderivL i))
      (fun k => by
        rw [ringEquiv_symm_algebraMap tau sigma hcomp i k]
        exact IntermediateField.algebraMap_mem _ _)
      (hgenSymm i) h
    rwa [RingEquiv.symm_apply_apply] at hmem
  · exact mapsTo_differentialAdjoin (sigma i) S (hderivL i)
      (fun k => by
        rw [hcomp]
        exact IntermediateField.algebraMap_mem _ _)
      (hgen i)

end

end GaloisForLFunctions.HTGeometry
