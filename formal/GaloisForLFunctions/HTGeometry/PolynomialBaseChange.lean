import GaloisForLFunctions.HTGeometry.KummerBaseChange
import GaloisForLFunctions.HTGeometry.SplittingFieldCompositum

/-!
# Base change of a polynomial's Galois group along a second polynomial

Inside the splitting field of a product, the field generated by the roots of the first factor and
the field generated by the roots of the second have compositum everything.  So the base change step
applies with its compositum hypothesis already discharged.

The conclusion is that the Galois group of the first factor is unchanged when the base is enlarged
by the roots of the second.
-/

namespace GaloisForLFunctions.HTGeometry

variable {F L : Type*} [Field F] [CharZero F] [Field L] [Algebra F L]

/-- The field generated by the roots of a polynomial. -/
noncomputable abbrev rootField (F : Type*) [Field F] {L : Type*} [Field L] [Algebra F L]
    (p : Polynomial F) : IntermediateField F L :=
  IntermediateField.adjoin F (p.rootSet L)

/-- **Base change along the roots of a second polynomial preserves the Galois group.** -/
noncomputable def polyBaseChangeEquiv {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)]
    [Normal F (rootField F (L := L) p)] [FiniteDimensional F (rootField F (L := L) p)]
    [IsGalois F (rootField F (L := L) p)]
    [FiniteDimensional (rootField F (L := L) q) L] [IsGalois (rootField F (L := L) q) L]
    {α : Type*} [Fintype α] [DecidableEq α] [Nontrivial α]
    (φ : (rootField F (L := L) p ≃ₐ[F] rootField F (L := L) p) ≃* Equiv.Perm α)
    (hnorm : (IntermediateField.comap (rootField F (L := L) p).val
      (rootField F (L := L) p ⊓ rootField F (L := L) q)).fixingSubgroup.Normal)
    (habel : ∀ x y : (rootField F (L := L) p ≃ₐ[F] rootField F (L := L) p) ⧸
      (IntermediateField.comap (rootField F (L := L) p).val
        (rootField F (L := L) p ⊓ rootField F (L := L) q)).fixingSubgroup, x * y = y * x)
    (hobs : ∀ (δ : L) (c : F), δ ∈ rootField F (L := L) p → δ * δ = algebraMap F L c →
      δ ∉ (⊥ : IntermediateField F L) → δ ∉ rootField F (L := L) q) :
    (L ≃ₐ[rootField F (L := L) q] L) ≃* Equiv.Perm α :=
  kummerBaseChangePermOfAbelian φ (sup_adjoin_rootSet_eq_top hp hq) hnorm habel hobs

/-- **The odd-degree case needs no square-root hypothesis.**  If the field generated by the second
factor's roots has odd degree over the base, no square root of a base element can lie in it, so the
Galois group of the first factor survives the base change unconditionally. -/
noncomputable def polyBaseChangeOddEquiv {p q : Polynomial F} (hp : p ≠ 0) (hq : q ≠ 0)
    [Polynomial.IsSplittingField F L (p * q)]
    [Normal F (rootField F (L := L) p)] [FiniteDimensional F (rootField F (L := L) p)]
    [IsGalois F (rootField F (L := L) p)]
    [FiniteDimensional F (rootField F (L := L) q)]
    [FiniteDimensional (rootField F (L := L) q) L] [IsGalois (rootField F (L := L) q) L]
    {α : Type*} [Fintype α] [DecidableEq α] [Nontrivial α]
    (φ : (rootField F (L := L) p ≃ₐ[F] rootField F (L := L) p) ≃* Equiv.Perm α)
    (hnorm : (IntermediateField.comap (rootField F (L := L) p).val
      (rootField F (L := L) p ⊓ rootField F (L := L) q)).fixingSubgroup.Normal)
    (habel : ∀ x y : (rootField F (L := L) p ≃ₐ[F] rootField F (L := L) p) ⧸
      (IntermediateField.comap (rootField F (L := L) p).val
        (rootField F (L := L) p ⊓ rootField F (L := L) q)).fixingSubgroup, x * y = y * x)
    (hodd : ¬ 2 ∣ Module.finrank F (rootField F (L := L) q)) :
    (L ≃ₐ[rootField F (L := L) q] L) ≃* Equiv.Perm α :=
  polyBaseChangeEquiv hp hq φ hnorm habel (no_sqrt_of_not_two_dvd_finrank hodd)

end GaloisForLFunctions.HTGeometry
