import GaloisForLFunctions.HTGeometry.SymmetricAlgebraSubmoduleQuotient
import GaloisForLFunctions.HTGeometry.HopfIdealKernel

/-!
# Classification of Hopf ideals in symmetric algebras

Over a characteristic-zero field, every Hopf ideal of `Sym(V)` is generated by its degree-one
part.  Equivalently, closed subgroup schemes of a vector group are linear subgroup schemes.
-/

open scoped TensorProduct
open Coalgebra Bialgebra HopfAlgebra

namespace GaloisForLFunctions.HTGeometry
namespace SymmetricHopfIdealClassification

noncomputable section

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]

def linearPart (I : Ideal (SymmetricAlgebra k V)) : Submodule k V :=
  (I.restrictScalars k).comap (SymmetricAlgebra.ι k V)

@[simp] theorem mem_linearPart (I : Ideal (SymmetricAlgebra k V)) (v : V) :
    v ∈ linearPart I ↔ SymmetricAlgebra.ι k V v ∈ I := Iff.rfl

theorem linearIdeal_linearPart_le (I : Ideal (SymmetricAlgebra k V)) :
    SymmetricAlgebraSubmoduleQuotient.linearIdeal (linearPart I) ≤ I := by
  rw [SymmetricAlgebraSubmoduleQuotient.linearIdeal, Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  exact hv

def quotientLinearMap (I : Ideal (SymmetricAlgebra k V)) :
    (V ⧸ linearPart I) →ₗ[k] (SymmetricAlgebra k V ⧸ I) :=
  (linearPart I).liftQ
    ((Ideal.Quotient.mkₐ k I).toLinearMap.comp (SymmetricAlgebra.ι k V))
    (by
      intro v hv
      rw [LinearMap.mem_ker]
      change Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hv)

@[simp] theorem quotientLinearMap_mkQ (I : Ideal (SymmetricAlgebra k V)) (v : V) :
    quotientLinearMap I ((linearPart I).mkQ v) =
      Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v) := by
  rfl

def quotientAlgHom (I : Ideal (SymmetricAlgebra k V)) :
    SymmetricAlgebra k (V ⧸ linearPart I) →ₐ[k]
      (SymmetricAlgebra k V ⧸ I) :=
  SymmetricAlgebra.lift (quotientLinearMap I)

@[simp] theorem quotientAlgHom_ι_mkQ
    (I : Ideal (SymmetricAlgebra k V)) (v : V) :
    quotientAlgHom I
        (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v)) =
      Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v) := by
  rw [quotientAlgHom, SymmetricAlgebra.lift_ι_apply]
  exact quotientLinearMap_mkQ I v

def quotientBialgHom (I : Ideal (SymmetricAlgebra k V)) [I.IsHopfIdeal k] :
    SymmetricAlgebra k (V ⧸ linearPart I) →ₐc[k]
      (SymmetricAlgebra k V ⧸ I) :=
  BialgHom.ofAlgHom (quotientAlgHom I) (by
    apply SymmetricAlgebra.algHom_ext
    apply LinearMap.ext
    intro qv
    obtain ⟨v, rfl⟩ := (linearPart I).mkQ_surjective qv
    change Coalgebra.counit (R := k)
        (quotientAlgHom I
          (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v))) =
      Coalgebra.counit (R := k)
        (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v))
    rw [quotientAlgHom_ι_mkQ]
    simp) (by
    apply DFunLike.ext _ _
    intro p
    induction p using SymmetricAlgebra.induction with
    | algebraMap r => simp
    | ι qv =>
        obtain ⟨v, rfl⟩ := (linearPart I).mkQ_surjective qv
        change Algebra.TensorProduct.map (quotientAlgHom I) (quotientAlgHom I)
            (Coalgebra.comul (R := k)
              (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v))) =
          Coalgebra.comul (R := k)
            (quotientAlgHom I
              (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v)))
        have hgen := quotientAlgHom_ι_mkQ I v
        rw [SymmetricAlgebra.comul_ι, map_add,
          Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul, map_one]
        rw [hgen]
        simp
    | mul p q hp hq => simp only [map_mul, hp, hq]
    | add p q hp hq => simp only [map_add, hp, hq])

@[simp] theorem quotientBialgHom_ι_mkQ
    (I : Ideal (SymmetricAlgebra k V)) [I.IsHopfIdeal k] (v : V) :
    quotientBialgHom I
        (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v)) =
      Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v) := by
  change quotientAlgHom I
      (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v)) =
    Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v)
  exact quotientAlgHom_ι_mkQ I v

theorem quotientBialgHom_comp_quotientMap
    (I : Ideal (SymmetricAlgebra k V)) [I.IsHopfIdeal k] :
    (quotientBialgHom I).toAlgHom.comp
        (SymmetricAlgebraSubmoduleQuotient.quotientMap (linearPart I)) =
      Ideal.Quotient.mkₐ k I := by
  apply SymmetricAlgebra.algHom_ext
  apply LinearMap.ext
  intro v
  change quotientBialgHom I
      (SymmetricAlgebraSubmoduleQuotient.quotientMap (linearPart I)
        (SymmetricAlgebra.ι k V v)) =
    Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v)
  rw [SymmetricAlgebraSubmoduleQuotient.quotientMap_ι]
  exact quotientBialgHom_ι_mkQ I v

/-- After quotienting the degree-one relations, the canonical map into a symmetric Hopf quotient
is injective in characteristic zero. -/
theorem quotientBialgHom_injective [CharZero k]
    (I : Ideal (SymmetricAlgebra k V)) [I.IsHopfIdeal k] :
    Function.Injective (quotientBialgHom I) := by
  let L := linearPart I
  let f := quotientBialgHom I
  rw [RingHom.injective_iff_ker_eq_bot]
  by_contra hker
  have hkerne : RingHom.ker f.toAlgHom.toRingHom ≠ ⊥ := hker
  letI : (RingHom.ker f.toAlgHom.toRingHom).IsHopfIdeal k :=
    HopfIdealKernel.ker_isHopfIdeal f
  let b := Module.Free.chooseBasis k (V ⧸ L)
  obtain ⟨qv, hqv0, hqvker⟩ :=
    SymmetricHopfIdealLinear.nonzero_exists_nonzero_generator b
      (RingHom.ker f.toAlgHom.toRingHom) hkerne
  obtain ⟨v, hv⟩ := L.mkQ_surjective qv
  subst qv
  have hzero : Ideal.Quotient.mk I (SymmetricAlgebra.ι k V v) = 0 := by
    change quotientBialgHom I
      (SymmetricAlgebra.ι k (V ⧸ linearPart I) ((linearPart I).mkQ v)) = 0 at hqvker
    rw [quotientBialgHom_ι_mkQ] at hqvker
    exact hqvker
  have hvI : SymmetricAlgebra.ι k V v ∈ I :=
    Ideal.Quotient.eq_zero_iff_mem.mp hzero
  have hvL : v ∈ L := by exact hvI
  exact hqv0 ((Submodule.Quotient.mk_eq_zero (p := L)).mpr hvL)

/-- Every Hopf ideal of a characteristic-zero symmetric algebra is generated by its
degree-one part. -/
theorem eq_linearIdeal_linearPart [CharZero k]
    (I : Ideal (SymmetricAlgebra k V)) [I.IsHopfIdeal k] :
    I = SymmetricAlgebraSubmoduleQuotient.linearIdeal (linearPart I) := by
  let L := linearPart I
  let K := SymmetricAlgebraSubmoduleQuotient.linearIdeal L
  let f := quotientBialgHom I
  have hfinj : Function.Injective f := quotientBialgHom_injective I
  apply le_antisymm
  · intro p hpI
    have hcomp := DFunLike.congr_fun (quotientBialgHom_comp_quotientMap I) p
    have hzero : f
        (SymmetricAlgebraSubmoduleQuotient.quotientMap L p) = 0 := by
      change f (SymmetricAlgebraSubmoduleQuotient.quotientMap (linearPart I) p) = 0
      calc
        f (SymmetricAlgebraSubmoduleQuotient.quotientMap (linearPart I) p) =
            Ideal.Quotient.mk I p := hcomp
        _ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hpI
    have hqzero : SymmetricAlgebraSubmoduleQuotient.quotientMap L p = 0 :=
      hfinj (hzero.trans (map_zero f).symm)
    have hpK : p ∈ K := by
      change p ∈ SymmetricAlgebraSubmoduleQuotient.linearIdeal L
      rw [← SymmetricAlgebraSubmoduleQuotient.ker_quotientMap L]
      exact hqzero
    exact hpK
  · exact linearIdeal_linearPart_le I

end
end SymmetricHopfIdealClassification
end GaloisForLFunctions.HTGeometry
