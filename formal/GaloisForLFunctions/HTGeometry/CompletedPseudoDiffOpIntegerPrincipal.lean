import GaloisForLFunctions.HTGeometry.DifferentialVariationalStandardApartment

/-!
# Principal finite left ideals in the completed pseudodifferential valuation ring

The completed pseudodifferential skew field has an integer-valued multiplicative valuation.  In
its valuation ring, an element of least valuation in a finite family divides every other member on
both the left and the right.  Consequently every finitely generated left ideal is generated by one
of a finite set of generators.

This is the noncommutative Bézout input needed for row and column reduction of arbitrary finite
valuation lattices.  No commutativity of the completed operator ring is used.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

namespace DiffOp

noncomputable section

variable {K : Type u} [Field K] [Differential K]

theorem completedPseudoDiffOpAddValue_inv (a : CompletedPseudoDiffOp K) :
    completedPseudoDiffOpAddValue a⁻¹ = -completedPseudoDiffOpAddValue a := by
  unfold completedPseudoDiffOpAddValue
  rw [Valuation.map_inv]
  rfl

/-- Smaller additive valuation is exactly left divisibility inside the valuation ring. -/
theorem exists_completedPseudoDiffOpInteger_left_factor
    {a b : CompletedPseudoDiffOp K} (ha : a ≠ 0)
    (hab : completedPseudoDiffOpAddValue a ≤ completedPseudoDiffOpAddValue b) :
    ∃ c : CompletedPseudoDiffOpInteger (K := K),
      (c : CompletedPseudoDiffOp K) * a = b := by
  by_cases hb : b = 0
  · subst b
    exact ⟨0, by simp⟩
  let c : CompletedPseudoDiffOp K := b * a⁻¹
  let za : ℤ := completedPseudoDiffOpUnitAddValue (Units.mk0 a ha)
  let zb : ℤ := completedPseudoDiffOpUnitAddValue (Units.mk0 b hb)
  have hva : completedPseudoDiffOpAddValue a = (za : WithTop ℤ) := by
    simpa [za] using completedPseudoDiffOpAddValue_unit_eq_coe (Units.mk0 a ha)
  have hvb : completedPseudoDiffOpAddValue b = (zb : WithTop ℤ) := by
    simpa [zb] using completedPseudoDiffOpAddValue_unit_eq_coe (Units.mk0 b hb)
  have hz : za ≤ zb := by
    rw [hva, hvb] at hab
    exact_mod_cast hab
  have hc : c ∈ CompletedPseudoDiffOpInteger (K := K) := by
    rw [mem_completedPseudoDiffOpInteger_iff_addValue_nonneg]
    change 0 ≤ completedPseudoDiffOpAddValue (b * a⁻¹)
    rw [completedPseudoDiffOpAddValue_mul, completedPseudoDiffOpAddValue_inv, hva, hvb]
    change (0 : WithTop ℤ) ≤ ((zb - za : ℤ) : WithTop ℤ)
    norm_cast
    omega
  refine ⟨⟨c, hc⟩, ?_⟩
  change (b * a⁻¹) * a = b
  rw [mul_assoc, inv_mul_cancel₀ ha, mul_one]

/-- Smaller additive valuation is also right divisibility inside the valuation ring. -/
theorem exists_completedPseudoDiffOpInteger_right_factor
    {a b : CompletedPseudoDiffOp K} (ha : a ≠ 0)
    (hab : completedPseudoDiffOpAddValue a ≤ completedPseudoDiffOpAddValue b) :
    ∃ c : CompletedPseudoDiffOpInteger (K := K),
      a * (c : CompletedPseudoDiffOp K) = b := by
  by_cases hb : b = 0
  · subst b
    exact ⟨0, by simp⟩
  let c : CompletedPseudoDiffOp K := a⁻¹ * b
  let za : ℤ := completedPseudoDiffOpUnitAddValue (Units.mk0 a ha)
  let zb : ℤ := completedPseudoDiffOpUnitAddValue (Units.mk0 b hb)
  have hva : completedPseudoDiffOpAddValue a = (za : WithTop ℤ) := by
    simpa [za] using completedPseudoDiffOpAddValue_unit_eq_coe (Units.mk0 a ha)
  have hvb : completedPseudoDiffOpAddValue b = (zb : WithTop ℤ) := by
    simpa [zb] using completedPseudoDiffOpAddValue_unit_eq_coe (Units.mk0 b hb)
  have hz : za ≤ zb := by
    rw [hva, hvb] at hab
    exact_mod_cast hab
  have hc : c ∈ CompletedPseudoDiffOpInteger (K := K) := by
    rw [mem_completedPseudoDiffOpInteger_iff_addValue_nonneg]
    change 0 ≤ completedPseudoDiffOpAddValue (a⁻¹ * b)
    rw [completedPseudoDiffOpAddValue_mul, completedPseudoDiffOpAddValue_inv, hva, hvb]
    change (0 : WithTop ℤ) ≤ ((-za + zb : ℤ) : WithTop ℤ)
    norm_cast
    omega
  refine ⟨⟨c, hc⟩, ?_⟩
  change a * (a⁻¹ * b) = b
  rw [← mul_assoc, mul_inv_cancel₀ ha, one_mul]

/-- A finite family in the completed skew field spans a principal fractional left ideal over the
valuation ring.  The generator is a least-valuation nonzero member of the family. -/
theorem exists_completedPseudoDiffOp_principal_span_finset
    (s : Finset (CompletedPseudoDiffOp K)) :
    ∃ a : CompletedPseudoDiffOp K,
      Submodule.span (CompletedPseudoDiffOpInteger (K := K)) (s : Set _) =
        (CompletedPseudoDiffOpInteger (K := K)) ∙ a := by
  classical
  by_cases hs : ∃ x ∈ s, x ≠ 0
  · let t : Finset (CompletedPseudoDiffOp K) := s.filter (· ≠ 0)
    have ht : t.Nonempty := by
      obtain ⟨x, hxs, hx0⟩ := hs
      exact ⟨x, Finset.mem_filter.mpr ⟨hxs, hx0⟩⟩
    obtain ⟨a, hat, hmin⟩ := Finset.exists_min_image t completedPseudoDiffOpAddValue ht
    refine ⟨a, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro b hb
      apply (Submodule.mem_span_singleton).2
      by_cases hb0 : b = 0
      · subst b
        exact ⟨0, by simp⟩
      · have hbt : b ∈ t := Finset.mem_filter.mpr ⟨hb, hb0⟩
        obtain ⟨c, hc⟩ := exists_completedPseudoDiffOpInteger_left_factor
          (a := a) (b := b) (Finset.mem_filter.mp hat).2 (hmin b hbt)
        exact ⟨c, hc⟩
    · rw [Submodule.span_le]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst b
      exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_filter.mp hat).1)
  · refine ⟨0, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro b hb
      have hb0 : b = 0 := by
        by_contra hb0
        exact hs ⟨b, hb, hb0⟩
      subst b
      exact Submodule.zero_mem _
    · rw [Submodule.span_le]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst b
      exact Submodule.zero_mem _

/-- Every finitely generated fractional left ideal of the completed skew valuation ring is
principal. -/
theorem fg_completedPseudoDiffOp_submodule_eq_span_singleton
    (I : Submodule (CompletedPseudoDiffOpInteger (K := K)) (CompletedPseudoDiffOp K))
    (hI : I.FG) :
    ∃ a : CompletedPseudoDiffOp K,
      I = (CompletedPseudoDiffOpInteger (K := K)) ∙ a := by
  classical
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  let s : Finset (CompletedPseudoDiffOp K) := Finset.univ.image g
  have hs : (s : Set (CompletedPseudoDiffOp K)) = Set.range g := by
    ext x
    simp [s]
  obtain ⟨a, ha⟩ := exists_completedPseudoDiffOp_principal_span_finset s
  refine ⟨a, ?_⟩
  rw [← hg, ← hs, ha]

/-- A finite family in the completed skew valuation ring spans a principal left ideal.  When the
family is nonzero, the chosen generator is one of its least-valuation members. -/
theorem exists_completedPseudoDiffOpInteger_principal_span_finset
    (s : Finset (CompletedPseudoDiffOpInteger (K := K))) :
    ∃ a : CompletedPseudoDiffOpInteger (K := K),
      Submodule.span (CompletedPseudoDiffOpInteger (K := K)) (s : Set _) =
        (CompletedPseudoDiffOpInteger (K := K)) ∙ a := by
  classical
  by_cases hs : ∃ x ∈ s, (x : CompletedPseudoDiffOp K) ≠ 0
  · let t : Finset (CompletedPseudoDiffOpInteger (K := K)) :=
      s.filter (fun x : CompletedPseudoDiffOpInteger (K := K) =>
        (x : CompletedPseudoDiffOp K) ≠ 0)
    have ht : t.Nonempty := by
      obtain ⟨x, hxs, hx0⟩ := hs
      exact ⟨x, Finset.mem_filter.mpr ⟨hxs, hx0⟩⟩
    obtain ⟨a, hat, hmin⟩ := Finset.exists_min_image t
      (fun x => completedPseudoDiffOpAddValue (x : CompletedPseudoDiffOp K)) ht
    refine ⟨a, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro b hb
      apply (Submodule.mem_span_singleton).2
      by_cases hb0 : (b : CompletedPseudoDiffOp K) = 0
      · refine ⟨0, ?_⟩
        apply Subtype.ext
        simpa using hb0.symm
      · have hbt : b ∈ t := Finset.mem_filter.mpr ⟨hb, hb0⟩
        obtain ⟨c, hc⟩ := exists_completedPseudoDiffOpInteger_left_factor
          (a := (a : CompletedPseudoDiffOp K))
          (b := (b : CompletedPseudoDiffOp K))
          (by exact_mod_cast (Finset.mem_filter.mp hat).2) (hmin b hbt)
        refine ⟨c, ?_⟩
        apply Subtype.ext
        exact hc
    · rw [Submodule.span_le]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst b
      exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_filter.mp hat).1)
  · refine ⟨0, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro b hb
      have hb0 : (b : CompletedPseudoDiffOp K) = 0 := by
        by_contra hb0
        exact hs ⟨b, hb, hb0⟩
      have hb0' : b = 0 := Subtype.ext hb0
      subst b
      exact Submodule.zero_mem _
    · rw [Submodule.span_le]
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst b
      exact Submodule.zero_mem _

/-- Every finitely generated left ideal of the completed pseudodifferential valuation ring is
principal. -/
theorem fg_completedPseudoDiffOpInteger_submodule_eq_span_singleton
    (I : Submodule (CompletedPseudoDiffOpInteger (K := K))
      (CompletedPseudoDiffOpInteger (K := K))) (hI : I.FG) :
    ∃ a : CompletedPseudoDiffOpInteger (K := K),
      I = (CompletedPseudoDiffOpInteger (K := K)) ∙ a := by
  classical
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  let s : Finset (CompletedPseudoDiffOpInteger (K := K)) := Finset.univ.image g
  have hs : (s : Set (CompletedPseudoDiffOpInteger (K := K))) = Set.range g := by
    ext x
    simp [s]
  obtain ⟨a, ha⟩ := exists_completedPseudoDiffOpInteger_principal_span_finset s
  refine ⟨a, ?_⟩
  rw [← hg, ← hs, ha]

end

end DiffOp

end GaloisForLFunctions.HTGeometry
