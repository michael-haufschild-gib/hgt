import GaloisForLFunctions.HTGeometry.InfiniteTorusFourierWeakConvergenceLaw

/-!
# Moment weak convergence on finite compact polydisks

Mixed holomorphic-antiholomorphic monomials are uniformly dense in all
continuous complex reporters on a finite product of closed unit disks.
Consequently convergence of every mixed moment forces weak convergence of
the complete probability law.  This is the contractive-semigroup analogue
of Fourier convergence on a phase torus.
-/

open Filter MeasureTheory Set Topology
open scoped BoundedContinuousFunction ComplexConjugate

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Closed complex unit disk. -/
abbrev ClosedComplexUnitDisk :=
  Metric.closedBall (0 : ℂ) 1

/-- Mixed coordinate monomial on a finite compact polydisk. -/
def finitePolydiskMoment
    {d : Type*} [Fintype d]
    (p q : d → ℕ) :
    C((d → ClosedComplexUnitDisk), ℂ) where
  toFun x :=
    ∏ i, (x i : ℂ) ^ p i * conj (x i : ℂ) ^ q i
  continuous_toFun := by
    fun_prop

@[simp]
theorem finitePolydiskMoment_zero
    {d : Type*} [Fintype d] :
    finitePolydiskMoment
      (fun _ : d => 0) (fun _ : d => 0) = 1 := by
  ext x
  simp [finitePolydiskMoment]

theorem finitePolydiskMoment_mul
    {d : Type*} [Fintype d]
    (p q r s : d → ℕ)
    (x : d → ClosedComplexUnitDisk) :
    finitePolydiskMoment (p + r) (q + s) x =
      finitePolydiskMoment p q x *
        finitePolydiskMoment r s x := by
  classical
  simp only [finitePolydiskMoment, ContinuousMap.coe_mk,
    Pi.add_apply, pow_add]
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro i hi
  ring

theorem finitePolydiskMoment_star
    {d : Type*} [Fintype d]
    (p q : d → ℕ)
    (x : d → ClosedComplexUnitDisk) :
    star (finitePolydiskMoment p q x) =
      finitePolydiskMoment q p x := by
  classical
  change
    (starRingEnd ℂ)
        (∏ i, (x i : ℂ) ^ p i * conj (x i : ℂ) ^ q i) =
      ∏ i, (x i : ℂ) ^ q i * conj (x i : ℂ) ^ p i
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro i hi
  simp [mul_comm]

/-- Star subalgebra generated by all mixed polydisk moments. -/
def finitePolydiskMomentSubalgebra
    (d : Type*) [Fintype d] :
    StarSubalgebra ℂ C((d → ClosedComplexUnitDisk), ℂ) where
  toSubalgebra :=
    Algebra.adjoin ℂ
      (Set.range
        (fun pq : (d → ℕ) × (d → ℕ) =>
          finitePolydiskMoment pq.1 pq.2))
  star_mem' := by
    change
      Algebra.adjoin ℂ
          (Set.range
            (fun pq : (d → ℕ) × (d → ℕ) =>
              finitePolydiskMoment pq.1 pq.2)) ≤
        star
          (Algebra.adjoin ℂ
            (Set.range
              (fun pq : (d → ℕ) × (d → ℕ) =>
                finitePolydiskMoment pq.1 pq.2)))
    refine Algebra.adjoin_le ?_
    rintro _ ⟨⟨p, q⟩, rfl⟩
    refine Algebra.subset_adjoin ⟨⟨q, p⟩, ?_⟩
    ext x
    simp only [ContinuousMap.star_apply]
    exact (finitePolydiskMoment_star p q x).symm

/-- The generated moment algebra is the linear span of mixed moments. -/
theorem finitePolydiskMomentSubalgebra_coe
    (d : Type*) [Fintype d] :
    (finitePolydiskMomentSubalgebra d).toSubalgebra.toSubmodule =
      Submodule.span ℂ
        (Set.range
          (fun pq : (d → ℕ) × (d → ℕ) =>
            finitePolydiskMoment pq.1 pq.2)) := by
  apply Algebra.adjoin_eq_span_of_subset
  refine .trans
    (fun f =>
      Submonoid.closure_induction (fun _ => id)
        ⟨⟨fun _ => 0, fun _ => 0⟩, ?_⟩ ?_)
    Submodule.subset_span
  · exact finitePolydiskMoment_zero
  · rintro _ _ _ _ ⟨⟨p, q⟩, rfl⟩ ⟨⟨r, s⟩, rfl⟩
    refine ⟨⟨p + r, q + s⟩, ?_⟩
    ext x
    exact finitePolydiskMoment_mul p q r s x

/-- Coordinate mixed moments separate every pair of polydisk points. -/
theorem finitePolydiskMomentSubalgebra_separatesPoints
    (d : Type*) [Fintype d] :
    (finitePolydiskMomentSubalgebra d).SeparatesPoints := by
  classical
  intro x y hxy
  rw [Ne, funext_iff, not_forall] at hxy
  obtain ⟨i, hi⟩ := hxy
  let p : d → ℕ := Pi.single i 1
  let q : d → ℕ := fun _ => 0
  refine
    ⟨_,
      ⟨finitePolydiskMoment p q,
        Algebra.subset_adjoin
          ⟨⟨p, q⟩, rfl⟩,
        rfl⟩,
      ?_⟩
  change
    finitePolydiskMoment p q x ≠
      finitePolydiskMoment p q y
  have hmoment (z : d → ClosedComplexUnitDisk) :
      finitePolydiskMoment p q z = (z i : ℂ) := by
    change
      (∏ j, (z j : ℂ) ^ p j * conj (z j : ℂ) ^ q j) =
        (z i : ℂ)
    calc
      _ = (z i : ℂ) ^ p i * conj (z i : ℂ) ^ q i := by
        apply Finset.prod_eq_single i
        · intro j hj hji
          simp [p, q, hji]
        · simp
      _ = (z i : ℂ) := by simp [p, q]
  rw [hmoment x, hmoment y]
  exact Subtype.coe_injective.ne hi

/-- **Finite-polydisk moment density.** Mixed moments are uniformly dense
in all continuous complex reporters. -/
theorem span_finitePolydiskMoment_closure_eq_top
    (d : Type*) [Fintype d] :
    (Submodule.span ℂ
      (Set.range
        (fun pq : (d → ℕ) × (d → ℕ) =>
          finitePolydiskMoment pq.1 pq.2))).topologicalClosure =
      ⊤ := by
  rw [← finitePolydiskMomentSubalgebra_coe]
  exact congr_arg
    (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints
      (finitePolydiskMomentSubalgebra d)
      (finitePolydiskMomentSubalgebra_separatesPoints d))

private def polydiskIntegralDifferenceLinearMap
    {d : Type*} [Fintype d]
    (μ ν :
      ProbabilityMeasure (d → ClosedComplexUnitDisk)) :
    C((d → ClosedComplexUnitDisk), ℂ) →ₗ[ℂ] ℂ where
  toFun f :=
    (∫ x, f x ∂(μ : Measure (d → ClosedComplexUnitDisk))) -
      ∫ x, f x ∂(ν : Measure (d → ClosedComplexUnitDisk))
  map_add' f g := by
    have hfμ : Integrable (fun x => f x)
        (μ : Measure (d → ClosedComplexUnitDisk)) :=
      f.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hgμ : Integrable (fun x => g x)
        (μ : Measure (d → ClosedComplexUnitDisk)) :=
      g.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hfν : Integrable (fun x => f x)
        (ν : Measure (d → ClosedComplexUnitDisk)) :=
      f.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hgν : Integrable (fun x => g x)
        (ν : Measure (d → ClosedComplexUnitDisk)) :=
      g.continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    simp only [ContinuousMap.add_apply]
    rw [integral_add hfμ hgμ, integral_add hfν hgν]
    ring
  map_smul' c f := by
    simp only [ContinuousMap.smul_apply]
    rw [integral_smul, integral_smul]
    simp only [RingHom.id_apply]
    ring

private theorem norm_polydiskIntegralDifferenceLinearMap_le
    {d : Type*} [Fintype d]
    (μ ν :
      ProbabilityMeasure (d → ClosedComplexUnitDisk))
    (f : C((d → ClosedComplexUnitDisk), ℂ)) :
    ‖polydiskIntegralDifferenceLinearMap μ ν f‖ ≤
      2 * ‖f‖ := by
  have hμ :
      ‖∫ x, f x
        ∂(μ : Measure (d → ClosedComplexUnitDisk))‖ ≤ ‖f‖ := by
    simpa using
      norm_integral_le_of_norm_le_const
        (μ := (μ : Measure (d → ClosedComplexUnitDisk)))
        (Filter.Eventually.of_forall
          fun x => f.norm_coe_le_norm x)
  have hν :
      ‖∫ x, f x
        ∂(ν : Measure (d → ClosedComplexUnitDisk))‖ ≤ ‖f‖ := by
    simpa using
      norm_integral_le_of_norm_le_const
        (μ := (ν : Measure (d → ClosedComplexUnitDisk)))
        (Filter.Eventually.of_forall
          fun x => f.norm_coe_le_norm x)
  change
    ‖(∫ x, f x ∂(μ : Measure (d → ClosedComplexUnitDisk))) -
        ∫ x, f x ∂(ν : Measure (d → ClosedComplexUnitDisk))‖ ≤
      2 * ‖f‖
  calc
    _ ≤ ‖∫ x, f x
        ∂(μ : Measure (d → ClosedComplexUnitDisk))‖ +
        ‖∫ x, f x
          ∂(ν : Measure (d → ClosedComplexUnitDisk))‖ :=
      norm_sub_le _ _
    _ ≤ ‖f‖ + ‖f‖ := add_le_add hμ hν
    _ = 2 * ‖f‖ := by ring

private def polydiskIntegralDifference
    {d : Type*} [Fintype d]
    (μ ν :
      ProbabilityMeasure (d → ClosedComplexUnitDisk)) :
    C((d → ClosedComplexUnitDisk), ℂ) →L[ℂ] ℂ :=
  (polydiskIntegralDifferenceLinearMap μ ν).mkContinuous 2
    (norm_polydiskIntegralDifferenceLinearMap_le μ ν)

/-- Probability measures on a finite compact polydisk are determined by
all mixed moments. -/
theorem probabilityMeasure_ext_of_finitePolydiskMoment_integral_eq
    {d : Type*} [Fintype d]
    (μ ν :
      ProbabilityMeasure (d → ClosedComplexUnitDisk))
    (h : ∀ p q : d → ℕ,
      (∫ x, finitePolydiskMoment p q x
        ∂(μ : Measure (d → ClosedComplexUnitDisk))) =
      ∫ x, finitePolydiskMoment p q x
        ∂(ν : Measure (d → ClosedComplexUnitDisk))) :
    μ = ν := by
  let L := polydiskIntegralDifference μ ν
  have hspan :
      Submodule.span ℂ
          (Set.range
            (fun pq : (d → ℕ) × (d → ℕ) =>
              finitePolydiskMoment pq.1 pq.2)) ≤
        L.toLinearMap.ker := by
    apply Submodule.span_le.mpr
    rintro f ⟨⟨p, q⟩, rfl⟩
    change
      (∫ x, finitePolydiskMoment p q x
        ∂(μ : Measure (d → ClosedComplexUnitDisk))) -
      ∫ x, finitePolydiskMoment p q x
        ∂(ν : Measure (d → ClosedComplexUnitDisk)) = 0
    rw [h p q, sub_self]
  have hclosure :
      (Submodule.span ℂ
        (Set.range
          (fun pq : (d → ℕ) × (d → ℕ) =>
            finitePolydiskMoment pq.1 pq.2))).topologicalClosure ≤
        L.toLinearMap.ker :=
    Submodule.topologicalClosure_minimal _
      hspan L.isClosed_ker
  rw [span_finitePolydiskMoment_closure_eq_top] at hclosure
  have hzero (f : C((d → ClosedComplexUnitDisk), ℂ)) :
      L f = 0 :=
    hclosure Submodule.mem_top
  apply ProbabilityMeasure.toMeasure_injective
  apply MeasureTheory.ext_of_forall_integral_eq_of_IsFiniteMeasure
  intro f
  let fc : C((d → ClosedComplexUnitDisk), ℂ) :=
    ⟨fun x => (f x : ℂ),
      Complex.continuous_ofReal.comp f.continuous⟩
  have hz := hzero fc
  have hfcμ : Integrable (fun x => (f x : ℂ))
      (μ : Measure (d → ClosedComplexUnitDisk)) :=
    fc.continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hfcν : Integrable (fun x => (f x : ℂ))
      (ν : Measure (d → ClosedComplexUnitDisk)) :=
    fc.continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  change
    (∫ x, (f x : ℂ)
      ∂(μ : Measure (d → ClosedComplexUnitDisk))) -
    ∫ x, (f x : ℂ)
      ∂(ν : Measure (d → ClosedComplexUnitDisk)) = 0 at hz
  have hre := congrArg Complex.re hz
  simp only [Complex.sub_re, Complex.zero_re] at hre
  have hμ :
      (∫ x, (f x : ℂ)
        ∂(μ : Measure (d → ClosedComplexUnitDisk))).re =
          ∫ x, f x
            ∂(μ : Measure (d → ClosedComplexUnitDisk)) := by
    simpa using (integral_re hfcμ).symm
  have hν :
      (∫ x, (f x : ℂ)
        ∂(ν : Measure (d → ClosedComplexUnitDisk))).re =
          ∫ x, f x
            ∂(ν : Measure (d → ClosedComplexUnitDisk)) := by
    simpa using (integral_re hfcν).symm
  rw [hμ, hν] at hre
  exact sub_eq_zero.mp hre

/-- Convergence of every mixed polydisk moment forces weak convergence of
the complete probability law. -/
theorem probabilityMeasure_tendsto_of_finitePolydiskMoment_tendsto
    {α d : Type*} [Fintype d]
    {l : Filter α}
    (μs : α → ProbabilityMeasure (d → ClosedComplexUnitDisk))
    (μ : ProbabilityMeasure (d → ClosedComplexUnitDisk))
    (h : ∀ p q : d → ℕ,
      Tendsto
        (fun a =>
          ∫ x, finitePolydiskMoment p q x
            ∂(μs a : Measure (d → ClosedComplexUnitDisk)))
        l
        (𝓝 (∫ x, finitePolydiskMoment p q x
          ∂(μ : Measure (d → ClosedComplexUnitDisk))))) :
    Tendsto μs l (𝓝 μ) := by
  apply tendsto_nhds_of_unique_mapClusterPt
  intro ν hν
  apply probabilityMeasure_ext_of_finitePolydiskMoment_integral_eq
  intro p q
  let F :
      ProbabilityMeasure (d → ClosedComplexUnitDisk) → ℂ :=
    fun ρ =>
      ∫ x, finitePolydiskMoment p q x
        ∂(ρ : Measure (d → ClosedComplexUnitDisk))
  have hcluster :
      MapClusterPt (F ν) l (F ∘ μs) :=
    hν.continuousAt_comp
      (continuous_integral_complex_continuousMap_infinite
        (finitePolydiskMoment p q)).continuousAt
  have ht :
      Tendsto (F ∘ μs) l (𝓝 (F μ)) := by
    simpa [F, Function.comp_def] using h p q
  exact eq_of_mapClusterPt_of_tendsto_infinite hcluster ht

/-- Complete mixed-moment-to-ensemble lift on finite compact polydisks. -/
theorem existsUnique_probabilityMeasure_tendsto_of_finitePolydiskMoment_limit
    {α d : Type*} [Fintype d]
    {l : Filter α} [l.NeBot]
    (μs : α → ProbabilityMeasure (d → ClosedComplexUnitDisk))
    (limit : (d → ℕ) → (d → ℕ) → ℂ)
    (h : ∀ p q : d → ℕ,
      Tendsto
        (fun a =>
          ∫ x, finitePolydiskMoment p q x
            ∂(μs a : Measure (d → ClosedComplexUnitDisk)))
        l (𝓝 (limit p q))) :
    ∃! μ : ProbabilityMeasure (d → ClosedComplexUnitDisk),
      Tendsto μs l (𝓝 μ) ∧
        ∀ p q : d → ℕ,
          (∫ x, finitePolydiskMoment p q x
            ∂(μ : Measure (d → ClosedComplexUnitDisk))) =
              limit p q := by
  obtain ⟨μ, hμcluster⟩ :=
    exists_clusterPt_of_compactSpace (map μs l)
  have hμmap : MapClusterPt μ l μs := hμcluster
  have hcoeff :
      ∀ p q : d → ℕ,
        (∫ x, finitePolydiskMoment p q x
          ∂(μ : Measure (d → ClosedComplexUnitDisk))) =
            limit p q := by
    intro p q
    let F :
        ProbabilityMeasure (d → ClosedComplexUnitDisk) → ℂ :=
      fun ρ =>
        ∫ x, finitePolydiskMoment p q x
          ∂(ρ : Measure (d → ClosedComplexUnitDisk))
    have hcluster :
        MapClusterPt (F μ) l (F ∘ μs) :=
      hμmap.continuousAt_comp
        (continuous_integral_complex_continuousMap_infinite
          (finitePolydiskMoment p q)).continuousAt
    have ht :
        Tendsto (F ∘ μs) l (𝓝 (limit p q)) := by
      simpa [F, Function.comp_def] using h p q
    exact eq_of_mapClusterPt_of_tendsto_infinite hcluster ht
  have hconv : Tendsto μs l (𝓝 μ) := by
    apply probabilityMeasure_tendsto_of_finitePolydiskMoment_tendsto
      μs μ
    intro p q
    simpa [hcoeff p q] using h p q
  refine ⟨μ, ⟨hconv, hcoeff⟩, ?_⟩
  intro ν hν
  exact tendsto_nhds_unique hν.1 hconv

end

