import GaloisForLFunctions.HTGeometry.DifferentialSubfieldTransfer
import GaloisForLFunctions.HTGeometry.ConstraintRelativity.CofinalRankTransfer

/-!
# The derivative-tail law for differential independence

If a prescribed jet is taken of each member of a finite family and the resulting family is
differentially independent over the base, then the original family is differentially independent.

The mechanism is a differential-transcendence-degree count inside the differential field `K`
generated by the original family: the shifted family lives in `K` and is independent there, so
`K` has differential transcendence degree at least the size of the index type, while the original
family generates `K`, so a spanning family of that size must be a differential transcendence basis.

This is the differential-algebra step that lets an independence statement proved for high jets be
transported back to the functions themselves.
-/

namespace GaloisForLFunctions

open Set

noncomputable section

universe u

/-- **Differential independence descends from a derivation-closed subfield.**  This is the
converse of `differentialIndependent_subfield`. -/
theorem differentialIndependent_coe_of_subfield
    {F K : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    {ι : Type*} (L : IntermediateField F K) (hL : DerivationClosed L) (x : ι → L)
    (h : letI := derivationClosedDifferential L hL; DifferentialIndependent F x) :
    DifferentialIndependent F fun i => ((x i : K)) := by
  letI := derivationClosedDifferential L hL
  have hinj : Function.Injective (L.val : L →ₐ[F] K) := L.val.injective
  have hcomp : (fun p : ι × ℕ => differentialJet p.2 ((x p.1 : K)))
      = (L.val : L →ₐ[F] K) ∘ fun p : ι × ℕ => differentialJet p.2 (x p.1) := by
    funext p
    exact (differentialJet_coe L hL (x p.1) p.2).symm
  show AlgebraicIndependent F fun p : ι × ℕ => differentialJet p.2 ((x p.1 : K))
  rw [hcomp]
  exact (AlgHom.algebraicIndependent_iff (L.val : L →ₐ[F] K) hinj).2 h

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
variable [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]

/-- A family whose prescribed jets are differentially independent is itself injective. -/
theorem injective_of_differentialIndependent_jetShift
    {ι : Type*} {x : ι → E} {m : ι → ℕ}
    (h : DifferentialIndependent F fun j => differentialJet (m j) (x j)) :
    Function.Injective x := by
  intro i j hij
  by_contra hne
  have hjinj : Function.Injective
      (fun p : ι × ℕ => differentialJet p.2 (differentialJet (m p.1) (x p.1))) :=
    AlgebraicIndependent.injective
      (show AlgebraicIndependent F
        (fun p : ι × ℕ => differentialJet p.2 (differentialJet (m p.1) (x p.1))) from h)
  have hval : (fun p : ι × ℕ => differentialJet p.2 (differentialJet (m p.1) (x p.1)))
        (i, m j)
      = (fun p : ι × ℕ => differentialJet p.2 (differentialJet (m p.1) (x p.1)))
        (j, m i) := by
    simp only []
    rw [← differentialJet_add, ← differentialJet_add, hij, Nat.add_comm]
  exact hne (congrArg Prod.fst (hjinj hval))

/-- **Derivative-tail law.**  Let `x : ι → E` be a finite family in a differential field of
characteristic zero and let `m : ι → ℕ` prescribe one jet order for each index.  If the shifted
family `j ↦ x_j^{(m_j)}` is differentially algebraically independent over `F`, then so is `x`
itself.

Differentiating a family can only lose differential degrees of freedom, never create them, so an
independence certificate obtained after differentiation is already a certificate for the original
family. -/
theorem differentialIndependent_of_jetShift
    {ι : Type u} [Finite ι] [Nonempty ι] (x : ι → E) (m : ι → ℕ)
    (h : DifferentialIndependent F fun j => differentialJet (m j) (x j)) :
    DifferentialIndependent F x := by
  classical
  have hinj : Function.Injective x := injective_of_differentialIndependent_jetShift h
  set K : IntermediateField F E := differentialAdjoin F (Set.range x) with hKdef
  have hKclosed : DerivationClosed K := derivationClosed_differentialAdjoin F (Set.range x)
  -- the original family, read inside the differential field it generates
  set x' : ι → K := adjoinLift F x with hx'def
  have hinj' : Function.Injective x' := fun a b hab => hinj (congrArg Subtype.val hab)
  -- the shifted family also lives inside that field
  have hymem : ∀ j, differentialJet (m j) (x j) ∈ K := fun j =>
    differentialJet_mem_differentialAdjoin F (Set.mem_range_self j) (m j)
  set y' : ι → K := fun j => ⟨differentialJet (m j) (x j), hymem j⟩ with hy'def
  have hy'ind : DifferentialIndependent F y' :=
    differentialIndependent_subfield K hKclosed y' (by simpa [hy'def] using h)
  -- hence the generated field has differential transcendence degree at least `#ι`
  have hcard : Cardinal.mk ι ≤ differentialTranscendenceDegree F K :=
    HTGeometry.ConstraintRelativity.cardinalMk_le_differentialTranscendenceDegree y' hy'ind
  -- and the original family generates it
  have hgen : differentialAdjoin F (Set.range x') = ⊤ :=
    differentialAdjoin_adjoinLift_eq_top x
  have hspan : ∀ z : K, DifferentialAlgebraicOver (differentialAdjoin F (Set.range x')) z := by
    intro z
    have hz : (z : K) ∈ differentialAdjoin F (Set.range x') := by
      rw [hgen]; trivial
    intro hdiff
    have htrans : Transcendental (differentialAdjoin F (Set.range x')) z :=
      hdiff.algebraicIndependent.transcendental Unit.unit
    exact htrans (by
      simpa using
        (isAlgebraic_algebraMap (R := differentialAdjoin F (Set.range x')) (A := K) ⟨z, hz⟩))
  have hx'ind : DifferentialIndependent F x' :=
    differentialIndependent_of_spanning_of_cardinalMk_le x' hinj' hspan hcard
  have := differentialIndependent_coe_of_subfield K hKclosed x' hx'ind
  simpa [hx'def] using this

end

end GaloisForLFunctions
