import GaloisForLFunctions.HTGeometry.SteinbergSpanning

/-!
# The Steinberg module is generated by one apartment class and the observer group

A frame of the whole space is a basis up to scalars, and the observer group acts transitively on
bases.  So all the apartments of a space are in one orbit, and Solomon's theorem sharpens: the top
homology of the building is generated by the orbit of a *single* apartment class under the observer
symmetry.

That is the precise form of the statement that the topological charge of the horizon complex is the
Steinberg representation generated by one complete observer frame.
-/

namespace GaloisForLFunctions.HTGeometry

open CategoryTheory Limits Simplicial Opposite Module

universe v u

section Frames

variable {K V : Type u} [Field K] [AddCommGroup V] [Module K V] {ι : Type u}

/-- A generator of an atom of the subspace lattice. -/
noncomputable def atomGen {x : Submodule K V} (hx : IsAtom x) : V :=
  (Submodule.exists_mem_ne_zero_of_ne_bot hx.1).choose

theorem atomGen_mem {x : Submodule K V} (hx : IsAtom x) : atomGen hx ∈ x :=
  (Submodule.exists_mem_ne_zero_of_ne_bot hx.1).choose_spec.1

theorem atomGen_ne_zero {x : Submodule K V} (hx : IsAtom x) : atomGen hx ≠ 0 :=
  (Submodule.exists_mem_ne_zero_of_ne_bot hx.1).choose_spec.2

/-- **An atom is the line of any of its nonzero vectors.** -/
theorem span_atomGen {x : Submodule K V} (hx : IsAtom x) : (K ∙ atomGen hx) = x := by
  refine ((IsAtom.le_iff hx).1 ?_).resolve_left ?_
  · exact (Submodule.span_singleton_le_iff_mem _ _).2 (atomGen_mem hx)
  · exact fun hcon => atomGen_ne_zero hx
      ((Submodule.span_singleton_eq_bot (R := K)).1 hcon)

/-- **A frame of the whole space is a basis**: its atoms are the lines of a basis. -/
noncomputable def LatticeFrame.basis (F : LatticeFrame (Submodule K V) ι ⊤) : Basis ι K V := by
  refine Basis.mk (v := fun i => atomGen (F.isAtom i)) ?_ ?_
  · refine (iSupIndep_iff_linearIndependent_of_ne_zero
      (fun i => atomGen_ne_zero (F.isAtom i))).1 ?_
    have h : (fun i => (K ∙ atomGen (F.isAtom i))) = F.atom :=
      funext fun i => span_atomGen (F.isAtom i)
    rw [h]
    exact F.indep
  · rw [Submodule.span_range_eq_iSup]
    have h : (⨆ i, (K ∙ atomGen (F.isAtom i))) = ⊤ := by
      have h2 : (⨆ i, (K ∙ atomGen (F.isAtom i))) = ⨆ i, F.atom i :=
        iSup_congr fun i => span_atomGen (F.isAtom i)
      rw [h2, F.sup_eq]
    rw [h]

@[simp] theorem LatticeFrame.coe_basis (F : LatticeFrame (Submodule K V) ι ⊤) (i : ι) :
    F.basis i = atomGen (F.isAtom i) := by
  rw [LatticeFrame.basis, Basis.mk_apply]

theorem LatticeFrame.span_basis (F : LatticeFrame (Submodule K V) ι ⊤) (i : ι) :
    (K ∙ (F.basis i)) = F.atom i := by
  rw [LatticeFrame.coe_basis]
  exact span_atomGen (F.isAtom i)

/-- **The observer group is transitive on frames of the whole space.** -/
theorem exists_linearEquiv_map_frame (F F' : LatticeFrame (Submodule K V) ι ⊤) :
    ∃ g : V ≃ₗ[K] V, ∀ i, Submodule.map (g : V →ₗ[K] V) (F.atom i) = F'.atom i := by
  refine ⟨F.basis.equiv F'.basis (Equiv.refl ι), fun i => ?_⟩
  rw [← F.span_basis i, Submodule.map_span, Set.image_singleton]
  show (K ∙ (F.basis.equiv F'.basis (Equiv.refl ι)) (F.basis i)) = F'.atom i
  rw [Basis.equiv_apply]
  exact F'.span_basis i

end Frames

section Orbit

variable {K V : Type u} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
variable {C : Type u} [Category.{v} C] [Abelian C] [Limits.HasCoproducts.{u} C]
variable {ι : Type u}

omit [FiniteDimensional K V] in
/-- The apartment of a frame, transported by an observer symmetry. -/
theorem buildingApartmentMap_map (D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι)
    (D' : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι) (g : V ≃ₗ[K] V)
    (hg : ∀ i, Submodule.map (g : V →ₗ[K] V) (D.frame.atom i) = D'.frame.atom i) :
    buildingApartmentMap D'
      = buildingApartmentMap D
        ≫ (properPartNerveIso (Submodule.orderIsoMapComap (g : V ≃ₗ[K] V))).hom := by
  ext m x
  refine nerve_simplex_ext (P := properPart (Submodule K V)) fun j => ?_
  refine Subtype.ext ?_
  show D'.frame.span _ = Submodule.map (g : V →ₗ[K] V) (D.frame.span _)
  show (⨆ i ∈ ((x.obj j : properPart (Set ι)) : Set ι), D'.frame.atom i)
    = Submodule.map (g : V →ₗ[K] V) (⨆ i ∈ ((x.obj j : properPart (Set ι)) : Set ι),
      D.frame.atom i)
  rw [Submodule.map_iSup]
  refine iSup_congr fun i => ?_
  rw [Submodule.map_iSup]
  exact iSup_congr fun _ => (hg i).symm

omit [FiniteDimensional K V] in
/-- **The apartment classes of a space are one orbit of the observer group.** -/
theorem buildingApartmentClass_map {n : ℕ} (e₀ : Fin (n + 3) ≃ ι)
    (D D' : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι) (g : V ≃ₗ[K] V)
    (hg : ∀ i, Submodule.map (g : V →ₗ[K] V) (D.frame.atom i) = D'.frame.atom i) (R : C) :
    buildingApartmentClass e₀ D' R
      = buildingApartmentClass e₀ D R
        ≫ SSet.homologyMap
          (properPartNerveIso (Submodule.orderIsoMapComap (g : V ≃ₗ[K] V))).hom R (n + 1) := by
  rw [buildingApartmentClass, buildingApartmentMap_map D D' g hg,
    ← apartmentClassIn_comp_homologyMap]
  rfl

/-- **Solomon's theorem in orbit form**: the top homology of the building is generated by the images
of a single apartment class under the observer group. -/
theorem epi_orbit_buildingApartmentClass {n : ℕ} [Finite ι] (hN : Nat.card ι = n + 3)
    (e₀ : Fin (n + 3) ≃ ι) (hdim : finrank K V = n + 3)
    (D₀ : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K V)) ι) (R : C) :
    Epi (Limits.Sigma.desc (fun g : V ≃ₗ[K] V =>
      buildingApartmentClass e₀ D₀ R
        ≫ SSet.homologyMap
          (properPartNerveIso (Submodule.orderIsoMapComap (g : V ≃ₗ[K] V))).hom R (n + 1))) := by
  refine epi_sigmaDesc_of_epi_of_exists _ (fun D => buildingApartmentClass e₀ D R) (𝟙 _)
    (IsIso.id _) 1 (by norm_num) (fun D => ?_) (epi_buildingApartmentClasses hN e₀ hdim R)
  obtain ⟨g, hg⟩ := exists_linearEquiv_map_frame D₀.frame D.frame
  exact ⟨g, by rw [Category.comp_id, one_smul, buildingApartmentClass_map e₀ D₀ D g hg]⟩

end Orbit

end GaloisForLFunctions.HTGeometry
