import GaloisForLFunctions.HTGeometry.MilnorIncreasingSpan
import GaloisForLFunctions.HTGeometry.MilnorGradedSurjectivity
import GaloisForLFunctions.HTGeometry.MilnorSectionMap

/-!
# Bass and Tate's generators for a simple extension

Every class of `K_m^M(F[X]/π)` is the residue at `π` of a class of Milnor's degree filtration
`L_{deg π}`, and that filtration is generated by symbols whose non-constant entries are monic
irreducibles of pairwise distinct degrees.  The residue of such a symbol vanishes unless one of its
entries is `π` itself, and then it is the symbol of the residues of the remaining entries — whose
degrees are all strictly below `deg π`.

So `K_m^M(F[X]/π)` is generated by symbols whose entries are residues of constants and of monic
irreducibles of **pairwise distinct degrees below `deg π`**.  At most `deg π − 1` entries are
therefore non-constant.

* `bassTateSpan` : the classes of those symbols.
* `mem_bassTateSpan` : **they generate.**
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {F : Type*} [Field F]

/-- The residue at `π` of a polynomial entry. -/
noncomputable def resEntry {π : Polynomial F} (hπ : Irreducible π) (p : NZPoly F) :
    (polyResidueField hπ)ˣ := (polyResidueData hπ).residueUnit (nzUnit p)

/-- The classes of symbols whose entries are residues of constants or of monic irreducibles of
pairwise distinct degrees below `deg π`. -/
noncomputable def bassTateSpan {π : Polynomial F} (hπ : Irreducible π) (m : ℕ) :
    AddSubgroup (MilnorKDeg (polyResidueField hπ) m) :=
  AddSubgroup.closure {x | ∃ (ps : List (NZPoly F)) (h : (ps.map (resEntry hπ)).length = m),
    (∀ p ∈ ps, GoodEntry p) ∧ (∀ p ∈ ps, p.1.natDegree < π.natDegree) ∧ DistinctDegrees ps ∧
      x = milnorClassDeg (polyResidueField hπ) m ⟨ps.map (resEntry hπ), h⟩}

theorem mem_bassTateSpan_gen {π : Polynomial F} {hπ : Irreducible π} {m : ℕ}
    {ps : List (NZPoly F)} (h : (ps.map (resEntry hπ)).length = m)
    (hgood : ∀ p ∈ ps, GoodEntry p) (hdeg : ∀ p ∈ ps, p.1.natDegree < π.natDegree)
    (hdist : DistinctDegrees ps) :
    milnorClassDeg (polyResidueField hπ) m ⟨ps.map (resEntry hπ), h⟩ ∈ bassTateSpan hπ m :=
  AddSubgroup.subset_closure ⟨ps, h, hgood, hdeg, hdist, rfl⟩

/-- A good entry of degree at most `deg π` which is not `π` itself is prime to `π`. -/
theorem notMem_span_of_good {π : Polynomial F} (hπ : Irreducible π) (hmπ : π.Monic)
    (hd : 1 ≤ π.natDegree) {r : NZPoly F} (hgood : GoodEntry r)
    (hdeg : r.1.natDegree ≤ π.natDegree) (hne : r.1 ≠ π) : r.1 ∉ Ideal.span {π} := by
  by_cases hlt : r.1.natDegree < π.natDegree
  · exact notMem_span_of_natDegree_lt r.2 hlt
  · have heq : r.1.natDegree = π.natDegree := le_antisymm hdeg (by omega)
    rcases hgood with h0 | ⟨hmr, _⟩
    · omega
    · intro hmem
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.1 hmem
      have hcne : c ≠ 0 := by
        intro hcon
        exact r.2 (by rw [hc, hcon, mul_zero])
      have hdegc : c.natDegree = 0 := by
        have := Polynomial.natDegree_mul hπ.ne_zero hcne
        rw [← hc] at this
        omega
      obtain ⟨a, ha⟩ := Polynomial.natDegree_eq_zero.1 hdegc
      have hane : a ≠ 0 := by
        intro hcon
        exact hcne (by rw [← ha, hcon, map_zero])
      have hlead : r.1.leadingCoeff = a * π.leadingCoeff := by
        rw [hc, ← ha, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
        ring
      have : a = 1 := by
        rw [hmr.leadingCoeff, hmπ.leadingCoeff, mul_one] at hlead
        exact hlead.symm
      apply hne
      rw [hc, ← ha, this, map_one, mul_one]

/-- **The residue of a Bass–Tate symbol lies in the span at `π`.** -/
theorem milnorResidue_nzList_mem_bassTateSpan {π : Polynomial F} (hπ : Irreducible π)
    (hmπ : π.Monic) (hd : 1 ≤ π.natDegree) {m : ℕ} (ps : List (NZPoly F))
    (h : (nzList ps).length = m + 1)
    (hgood : ∀ p ∈ ps, GoodEntry p) (hdeg : ∀ p ∈ ps, p.1.natDegree ≤ π.natDegree)
    (hdist : DistinctDegrees ps) :
    milnorResidue (polyResidueData hπ) (m + 1)
        (milnorClassDeg (RatFunc F) (m + 1) ⟨nzList ps, h⟩) ∈ bassTateSpan hπ m := by
  classical
  by_cases hex : ∃ p ∈ ps, p.1 = π
  · obtain ⟨p, hpmem, hpπ⟩ := hex
    obtain ⟨pv, hpv⟩ := p
    simp only at hpπ
    subst hpπ
    obtain ⟨A, B, hsplit⟩ := List.append_of_mem hpmem
    subst hsplit
    set p : NZPoly F := ⟨pv, hpv⟩ with hpdef
    -- every other entry has degree strictly below `deg pv`
    have hpdegeq : (p : Polynomial F).natDegree = pv.natDegree := rfl
    have hlt : ∀ r ∈ A ++ B, r.1.natDegree < pv.natDegree := by
      intro r hr
      have hcompat : DegCompat r p ∨ DegCompat p r := by
        rcases List.mem_append.1 hr with h1 | h2
        · obtain ⟨A₁, A₂, hA⟩ := List.append_of_mem h1
          left
          have : A ++ p :: B = A₁ ++ r :: (A₂ ++ p :: B) := by rw [hA]; simp
          exact distinctDegrees_apply (this ▸ hdist)
        · obtain ⟨B₁, B₂, hB⟩ := List.append_of_mem h2
          right
          have : A ++ p :: B = A ++ p :: (B₁ ++ r :: B₂) := by rw [hB]
          exact distinctDegrees_apply (this ▸ hdist)
      have hrdeg : r.1.natDegree ≤ pv.natDegree := by
        refine hdeg r ?_
        rcases List.mem_append.1 hr with h1 | h2
        · exact List.mem_append.2 (Or.inl h1)
        · exact List.mem_append.2 (Or.inr (by simp [h2]))
      have hp0 : pv.natDegree ≠ 0 := by omega
      rcases hcompat with hc | hc <;> rcases hc with h0 | h0 | h0
      · omega
      · exact absurd h0 hp0
      · omega
      · exact absurd h0 hp0
      · omega
      · omega
    -- move `p` to the last slot
    have hlenAB : (nzList (A ++ B)).length = m := by
      rw [nzList_length]
      rw [nzList_length] at h
      simp only [List.length_append, List.length_cons] at h ⊢
      omega
    have hmoveLen : (nzList A ++ nzList B ++ nzUnit p :: ([] : List (RatFunc F)ˣ)).length = m + 1 := by
      rw [← h]; simp [nzList]
    have hunif : nzUnit p = (polyResidueData hπ).unif := rfl
    have hlenEnd : (nzList (A ++ B) ++ [(polyResidueData hπ).unif]).length = m + 1 := by
      rw [List.length_append, List.length_singleton, hlenAB]
    have hmove := milnorClassDeg_move (K := RatFunc F) (n := m + 1) (nzList B) (nzList A)
      ([] : List (RatFunc F)ˣ) (nzUnit p) hmoveLen
    have hcastMid : milnorClassDeg (RatFunc F) (m + 1)
          ⟨nzList A ++ nzUnit p :: (nzList B ++ []),
            length_move (nzList A) (nzList B) [] (nzUnit p) hmoveLen⟩
        = milnorClassDeg (RatFunc F) (m + 1) ⟨nzList (A ++ p :: B), h⟩ :=
      congrArg (milnorClassDeg (RatFunc F) (m + 1)) (Subtype.ext (by simp [nzList]))
    have hcastEnd : milnorClassDeg (RatFunc F) (m + 1)
          ⟨nzList A ++ nzList B ++ nzUnit p :: ([] : List (RatFunc F)ˣ), hmoveLen⟩
        = milnorClassDeg (RatFunc F) (m + 1)
          ⟨nzList (A ++ B) ++ [(polyResidueData hπ).unif], hlenEnd⟩ :=
      congrArg (milnorClassDeg (RatFunc F) (m + 1)) (Subtype.ext (by simp [nzList, hunif]))
    rw [hcastMid, hcastEnd] at hmove
    have hkey : milnorClassDeg (RatFunc F) (m + 1) ⟨nzList (A ++ p :: B), h⟩
        = ((-1 : ℤ) ^ (nzList B).length) • milnorClassDeg (RatFunc F) (m + 1)
          ⟨nzList (A ++ B) ++ [(polyResidueData hπ).unif], hlenEnd⟩ := by
      rw [hmove, smul_smul, ← pow_add, ← two_mul, pow_mul]
      simp
    rw [hkey, map_zsmul]
    refine AddSubgroup.zsmul_mem _ ?_ _
    have hval : ∀ a ∈ nzList (A ++ B), (polyResidueData hπ).val' a = 0 := by
      intro a ha
      obtain ⟨r, hr, rfl⟩ := List.mem_map.1 ha
      exact polyResidueData_val'_eq_zero hπ r.2 (notMem_span_of_natDegree_lt r.2 (hlt r hr))
    have hmapLen : ((nzList (A ++ B)).map (polyResidueData hπ).residueUnit).length = m := by
      rw [List.length_map]; exact hlenAB
    rw [milnorResidue_append_unif' (polyResidueData hπ) (nzList (A ++ B)) hlenAB hval _ hmapLen]
    have hmapEq : (nzList (A ++ B)).map (polyResidueData hπ).residueUnit
        = (A ++ B).map (resEntry hπ) := List.map_map
    have hlen' : ((A ++ B).map (resEntry hπ)).length = m := by rw [← hmapEq]; exact hmapLen
    have hcast3 : milnorClassDeg (polyResidueField hπ) m
          ⟨(nzList (A ++ B)).map (polyResidueData hπ).residueUnit, hmapLen⟩
        = milnorClassDeg (polyResidueField hπ) m ⟨(A ++ B).map (resEntry hπ), hlen'⟩ :=
      congrArg (milnorClassDeg (polyResidueField hπ) m) (Subtype.ext hmapEq)
    rw [hcast3]
    refine mem_bassTateSpan_gen hlen' ?_ ?_ ?_
    · intro r hr
      refine hgood r ?_
      rcases List.mem_append.1 hr with h1 | h2
      · exact List.mem_append.2 (Or.inl h1)
      · exact List.mem_append.2 (Or.inr (by simp [h2]))
    · exact hlt
    · exact hdist.sublist (List.Sublist.append (List.Sublist.refl A) (List.sublist_cons_self p B))
  · push Not at hex
    have hzero : milnorResidue (polyResidueData hπ) (m + 1)
        (milnorClassDeg (RatFunc F) (m + 1) ⟨nzList ps, h⟩) = 0 := by
      refine milnorResidue_eq_zero_of_units _ (m + 1) _ ?_
      intro a ha
      obtain ⟨r, hr, rfl⟩ := List.mem_map.1 ha
      exact polyResidueData_val'_eq_zero hπ r.2
        (notMem_span_of_good hπ hmπ hd (hgood r hr) (hdeg r hr) (hex r hr))
    rw [hzero]
    exact AddSubgroup.zero_mem _

/-- **Bass and Tate's generators: `K_m^M(F[X]/π)` is generated by symbols whose entries are
residues of constants and of monic irreducibles of pairwise distinct degrees below `deg π`.** -/
theorem mem_bassTateSpan {π : Polynomial F} (hπ : Irreducible π) (hmπ : π.Monic)
    (hd : 1 ≤ π.natDegree) (m : ℕ) (y : MilnorKDeg (polyResidueField hπ) m) :
    y ∈ bassTateSpan hπ m := by
  obtain ⟨x, hx, hxy⟩ := exists_mem_degreeFiltrationOnlyAt_milnorResidue_eq hπ m y
  have hxinc : x ∈ incSpan (F := F) π.natDegree (m + 1) :=
    degreeFiltration_le_incSpan hx.1
  have hsub : incSpan (F := F) π.natDegree (m + 1)
      ≤ AddSubgroup.comap (milnorResidue (polyResidueData hπ) (m + 1)) (bassTateSpan hπ m) := by
    refine (AddSubgroup.closure_le _).2 ?_
    rintro z ⟨ps, hlen, hgood, hdeg, hdist, rfl⟩
    exact milnorResidue_nzList_mem_bassTateSpan hπ hmπ hd ps hlen hgood hdeg hdist
  have := hsub hxinc
  rw [← hxy]
  exact this

end GaloisForLFunctions.HTGeometry
