import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Transporting membership through a surjection

An ideal that contains the kernel of a surjection is detected in the image: `x ∈ I` iff
`f x ∈ I.map f`.  Powers and principal generators travel with it, so a statement about lying in
`Qᵉ` upstairs becomes a divisibility statement downstairs.

This is the bookkeeping the Kummer–Dedekind comparison needs: the different of a monogenic order is
generated by the derivative of the minimal polynomial, and its order at a prime is read off the
reduced minimal polynomial, one quotient away.
-/

namespace GaloisForLFunctions.HTGeometry

/-- **Membership is detected in the quotient when the kernel is contained in the ideal.** -/
theorem mem_iff_map_mem_of_ker_le {A C : Type*} [CommRing A] [CommRing C] (f : A →+* C)
    (hf : Function.Surjective f) {I : Ideal A} (hker : RingHom.ker f ≤ I) (x : A) :
    x ∈ I ↔ f x ∈ I.map f := by
  constructor
  · intro hx
    exact Ideal.mem_map_of_mem _ hx
  · intro hx
    have hcomap : (I.map f).comap f = I := by
      rw [Ideal.comap_map_of_surjective f hf, sup_eq_left]
      exact hker
    rw [← hcomap]
    exact hx

/-- The image of a power is the power of the image. -/
theorem map_pow_eq_pow_map {A C : Type*} [CommRing A] [CommRing C] (f : A →+* C) (I : Ideal A)
    (n : ℕ) : (I ^ n).map f = (I.map f) ^ n :=
  Ideal.map_pow f I n

/-- Membership in a power of an ideal, read in the quotient. -/
theorem mem_pow_iff_map_mem_pow {A C : Type*} [CommRing A] [CommRing C] (f : A →+* C)
    (hf : Function.Surjective f) {I : Ideal A} {n : ℕ} (hker : RingHom.ker f ≤ I ^ n) (x : A) :
    x ∈ I ^ n ↔ f x ∈ (I.map f) ^ n := by
  rw [mem_iff_map_mem_of_ker_le f hf hker x, map_pow_eq_pow_map]

/-- A principal ideal of the quotient pulls back to divisibility, when the kernel is generated by a
multiple of the generator. -/
theorem mem_span_singleton_map_iff {A : Type*} [CommRing A] {J : Ideal A} {a x : A}
    (hJ : J ≤ Ideal.span {a}) :
    (Ideal.Quotient.mk J) x ∈ (Ideal.span {a}).map (Ideal.Quotient.mk J) ↔ a ∣ x := by
  rw [← mem_iff_map_mem_of_ker_le (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    (by rwa [Ideal.mk_ker]) x, Ideal.mem_span_singleton]

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open Polynomial

/-- **The order of an element at a prime, read on the polynomial side.**  If the quotient by `J` is
isomorphic to `κ[X]/(q)` and the prime `Q` is `J` together with an element matching `h`, then lying
in `Qᵉ` is divisibility by `hᵉ`. -/
theorem mem_pow_iff_dvd_of_quotEquiv {A κ : Type*} [CommRing A] [Field κ]
    {J : Ideal A} {q : κ[X]} (Φ : (A ⧸ J) ≃+* (κ[X] ⧸ Ideal.span {q}))
    {Q : Ideal A} {y : A} (hQ : Q = Ideal.span {y} ⊔ J)
    {hbar : κ[X]} (hy : Φ (Ideal.Quotient.mk J y) = Ideal.Quotient.mk (Ideal.span {q}) hbar)
    {e : ℕ} (hdvd : hbar ^ e ∣ q) (hJQ : J ≤ Q ^ e)
    {z : A} {w : κ[X]} (hz : Φ (Ideal.Quotient.mk J z) = Ideal.Quotient.mk (Ideal.span {q}) w) :
    z ∈ Q ^ e ↔ hbar ^ e ∣ w := by
  classical
  set Ψ : A →+* (κ[X] ⧸ Ideal.span {q}) :=
    (Φ : (A ⧸ J) →+* (κ[X] ⧸ Ideal.span {q})).comp (Ideal.Quotient.mk J) with hΨ
  have hsurj : Function.Surjective Ψ :=
    Φ.surjective.comp Ideal.Quotient.mk_surjective
  have hkerle : RingHom.ker Ψ ≤ J := by
    intro a ha
    rw [RingHom.mem_ker, hΨ, RingHom.comp_apply] at ha
    have : Ideal.Quotient.mk J a = 0 := by
      have := congrArg Φ.symm ha
      rwa [Φ.symm_apply_apply, map_zero] at this
    rwa [Ideal.Quotient.eq_zero_iff_mem] at this
  have hJker : J ≤ RingHom.ker Ψ := by
    intro a ha
    rw [RingHom.mem_ker, hΨ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
  have hmapJ : J.map Ψ = ⊥ := Ideal.map_eq_bot_iff_le_ker.mpr hJker
  have hQmap : Q.map Ψ = Ideal.span {Ψ y} := by
    rw [hQ, Ideal.map_sup, Ideal.map_span, Set.image_singleton, hmapJ, sup_bot_eq]
  have hΨy : Ψ y = Ideal.Quotient.mk (Ideal.span {q}) hbar := hy
  have hΨz : Ψ z = Ideal.Quotient.mk (Ideal.span {q}) w := hz
  have hkerpow : RingHom.ker Ψ ≤ Q ^ e := le_trans hkerle hJQ
  rw [mem_pow_iff_map_mem_pow Ψ hsurj hkerpow z, hQmap, hΨy, hΨz]
  have hpow : (Ideal.span {Ideal.Quotient.mk (Ideal.span {q}) hbar}) ^ e
      = (Ideal.span {hbar ^ e}).map (Ideal.Quotient.mk (Ideal.span {q})) := by
    rw [Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton, map_pow]
  rw [hpow]
  refine mem_span_singleton_map_iff ?_
  rw [Ideal.span_le, Set.singleton_subset_iff, Ideal.mem_span_singleton]
  exact hdvd

end GaloisForLFunctions.HTGeometry
