import Mathlib

/-!
# Reciprocal-character real-form mechanics

One reciprocal exponential character has a split positive energy and a compact phase energy.
Its Euler derivative is the virial current.  This file certifies the route-independent scalar
mechanics.  The literal Gauss realization and cofinal admission theorem live in
`GaussReciprocalCharacterAdmission`; finite moment reconstruction is already formalized in
`PrimeBooleanMassHankelQuantumFusion`.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Split-real reciprocal-character energy. -/
def reciprocalCharacterSplitEnergy (a lambda t : ℝ) : ℝ :=
  2 * a * (Real.cosh (lambda * t) - 1)

/-- Compact-real phase energy of the same character. -/
def reciprocalCharacterPhaseEnergy (a lambda s : ℝ) : ℝ :=
  2 * a * (1 - Real.cos (lambda * s))

/-- Entire complexification whose split and compact restrictions are the two real-form
energies. -/
def reciprocalCharacterComplexEnergy (a lambda : ℝ) (z : ℂ) : ℂ :=
  a * (Complex.exp (lambda * z) + Complex.exp (-(lambda * z)) - 2)

/-- Restriction of the complexified character to the real axis is the split energy. -/
theorem reciprocalCharacterComplexEnergy_ofReal (a lambda t : ℝ) :
    reciprocalCharacterComplexEnergy a lambda t =
      reciprocalCharacterSplitEnergy a lambda t := by
  rw [reciprocalCharacterComplexEnergy, reciprocalCharacterSplitEnergy]
  have hmul : (lambda : ℂ) * (t : ℂ) = ((lambda * t : ℝ) : ℂ) :=
    Complex.ofReal_mul lambda t |>.symm
  rw [hmul]
  have hneg : -((lambda * t : ℝ) : ℂ) = ((-(lambda * t) : ℝ) : ℂ) :=
    Complex.ofReal_neg (lambda * t) |>.symm
  rw [hneg, ← Complex.ofReal_exp, ← Complex.ofReal_exp]
  norm_cast
  rw [Real.cosh_eq]
  ring

/-- Restriction to the imaginary axis is minus the compact phase energy. -/
theorem neg_reciprocalCharacterComplexEnergy_mul_I (a lambda s : ℝ) :
    -reciprocalCharacterComplexEnergy a lambda (Complex.I * s) =
      reciprocalCharacterPhaseEnergy a lambda s := by
  rw [reciprocalCharacterComplexEnergy, reciprocalCharacterPhaseEnergy]
  have hmul : (lambda : ℂ) * (Complex.I * (s : ℂ)) =
      ((lambda * s : ℝ) : ℂ) * Complex.I := by
    rw [Complex.ofReal_mul]
    ac_rfl
  rw [hmul]
  rw [show -(((lambda * s : ℝ) : ℂ) * Complex.I) =
      ((-(lambda * s) : ℝ) : ℂ) * Complex.I by
    rw [Complex.ofReal_neg]
    ring]
  rw [Complex.exp_ofReal_mul_I, Complex.exp_ofReal_mul_I]
  rw [Real.cos_neg, Real.sin_neg]
  simp only [Complex.ofReal_mul, Complex.ofReal_sub, Complex.ofReal_one,
    Complex.ofReal_ofNat, Complex.ofReal_neg]
  ring

/-- Euler/virial current generated by split energy. -/
def reciprocalCharacterVirialCurrent (a lambda t : ℝ) : ℝ :=
  2 * a * (lambda * t) * Real.sinh (lambda * t)

/-- The split energy has the expected infinitesimal response. -/
theorem hasDerivAt_reciprocalCharacterSplitEnergy (a lambda t : ℝ) :
    HasDerivAt (reciprocalCharacterSplitEnergy a lambda)
      (2 * a * lambda * Real.sinh (lambda * t)) t := by
  have hlin : HasDerivAt (fun x : ℝ => lambda * x) lambda t := by
    simpa using (hasDerivAt_id t).const_mul lambda
  have hcosh : HasDerivAt (fun x : ℝ => Real.cosh (lambda * x))
      (Real.sinh (lambda * t) * lambda) t :=
    (Real.hasDerivAt_cosh (lambda * t)).comp t hlin
  change HasDerivAt (fun x : ℝ => 2 * a * (Real.cosh (lambda * x) - 1))
    (2 * a * lambda * Real.sinh (lambda * t)) t
  have hmain := (hcosh.sub_const 1).const_mul (2 * a)
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hmain

/-- Exact conservation law: virial current is Euler differentiation of split energy. -/
theorem reciprocalCharacterVirial_eq_t_mul_deriv (a lambda t : ℝ) :
    reciprocalCharacterVirialCurrent a lambda t =
      t * deriv (reciprocalCharacterSplitEnergy a lambda) t := by
  rw [(hasDerivAt_reciprocalCharacterSplitEnergy a lambda t).deriv]
  simp [reciprocalCharacterVirialCurrent]
  ring

/-- The compact-real phase energy has the same clock and weight response. -/
theorem hasDerivAt_reciprocalCharacterPhaseEnergy (a lambda s : ℝ) :
    HasDerivAt (reciprocalCharacterPhaseEnergy a lambda)
      (2 * a * lambda * Real.sin (lambda * s)) s := by
  have hlin : HasDerivAt (fun x : ℝ => lambda * x) lambda s := by
    simpa using (hasDerivAt_id s).const_mul lambda
  have hcos : HasDerivAt (fun x : ℝ => Real.cos (lambda * x))
      (-Real.sin (lambda * s) * lambda) s :=
    (Real.hasDerivAt_cos (lambda * s)).comp s hlin
  change HasDerivAt (fun x : ℝ => 2 * a * (1 - Real.cos (lambda * x)))
    (2 * a * lambda * Real.sin (lambda * s)) s
  have hmain := (hcos.const_sub 1).const_mul (2 * a)
  simpa [mul_assoc, mul_left_comm, mul_comm] using hmain

/-- Split and compact real forms have one common positive quadratic jet. -/
theorem reciprocalCharacter_common_quadratic_jet (a lambda : ℝ) :
    deriv (fun t => deriv (reciprocalCharacterSplitEnergy a lambda) t) 0 =
        2 * a * lambda ^ 2 ∧
      deriv (fun s => deriv (reciprocalCharacterPhaseEnergy a lambda) s) 0 =
        2 * a * lambda ^ 2 := by
  have hsplitFun :
      (fun t => deriv (reciprocalCharacterSplitEnergy a lambda) t) =
        fun t => 2 * a * lambda * Real.sinh (lambda * t) := by
    funext t
    exact (hasDerivAt_reciprocalCharacterSplitEnergy a lambda t).deriv
  have hphaseFun :
      (fun s => deriv (reciprocalCharacterPhaseEnergy a lambda) s) =
        fun s => 2 * a * lambda * Real.sin (lambda * s) := by
    funext s
    exact (hasDerivAt_reciprocalCharacterPhaseEnergy a lambda s).deriv
  rw [hsplitFun, hphaseFun]
  constructor
  · have hlin : HasDerivAt (fun t : ℝ => lambda * t) lambda 0 := by
      exact hasDerivAt_const_mul lambda
    have hsinh := hlin.sinh
    simpa [pow_two, mul_assoc, mul_left_comm, mul_comm] using
      (hsinh.const_mul (2 * a * lambda)).deriv
  · have hlin : HasDerivAt (fun s : ℝ => lambda * s) lambda 0 := by
      exact hasDerivAt_const_mul lambda
    have hsin := hlin.sin
    simpa [pow_two, mul_assoc, mul_left_comm, mul_comm] using
      (hsin.const_mul (2 * a * lambda)).deriv

/-- Universal scalar hyperbolic coercivity. -/
theorem sq_le_mul_sinh (x : ℝ) : x ^ 2 ≤ x * Real.sinh x := by
  rcases le_total 0 x with hx | hx
  · have hs : x ≤ Real.sinh x := Real.self_le_sinh_iff.mpr hx
    nlinarith
  · have hs : -x ≤ Real.sinh (-x) := Real.self_le_sinh_iff.mpr (by linarith)
    rw [Real.sinh_neg] at hs
    nlinarith

/-- Split virial current dominates its common quadratic/Fisher jet. -/
theorem reciprocalCharacterVirial_quadratic_lower
    {a lambda t : ℝ} (ha : 0 ≤ a) :
    2 * a * (lambda * t) ^ 2 ≤ reciprocalCharacterVirialCurrent a lambda t := by
  have hs := sq_le_mul_sinh (lambda * t)
  rw [reciprocalCharacterVirialCurrent]
  calc
    2 * a * (lambda * t) ^ 2 ≤
        2 * a * ((lambda * t) * Real.sinh (lambda * t)) :=
      mul_le_mul_of_nonneg_left hs (by linarith)
    _ = 2 * a * (lambda * t) * Real.sinh (lambda * t) := by ring

/-- Positive split weights have exact neutral virial radical. -/
theorem reciprocalCharacterVirial_eq_zero_iff
    {a lambda t : ℝ} (ha : 0 < a) (hlambda : lambda ≠ 0) :
    reciprocalCharacterVirialCurrent a lambda t = 0 ↔ t = 0 := by
  constructor
  · intro h
    by_contra ht
    have hpos : 0 < 2 * a * (lambda * t) ^ 2 := by
      positivity
    have hlower := reciprocalCharacterVirial_quadratic_lower
      (a := a) (lambda := lambda) (t := t) ha.le
    rw [h] at hlower
    linarith
  · rintro rfl
    simp [reciprocalCharacterVirialCurrent]

/-! ## Finite multi-clock fusion -/

/-- Split energy of a finite reciprocal-character packet. -/
def reciprocalPacketSplitEnergy {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) : ℝ :=
  ∑ i ∈ I, reciprocalCharacterSplitEnergy (a i) (lambda i) t

/-- Virial current of the same finite packet. -/
def reciprocalPacketVirialCurrent {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) : ℝ :=
  ∑ i ∈ I, reciprocalCharacterVirialCurrent (a i) (lambda i) t

/-- Compact phase energy of the same finite packet. -/
def reciprocalPacketPhaseEnergy {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (s : ℝ) : ℝ :=
  ∑ i ∈ I, reciprocalCharacterPhaseEnergy (a i) (lambda i) s

/-- Entire complexification of a finite reciprocal-character packet. -/
def reciprocalPacketComplexEnergy {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (z : ℂ) : ℂ :=
  ∑ i ∈ I, reciprocalCharacterComplexEnergy (a i) (lambda i) z

/-- The finite complex packet restricts to its split real form. -/
theorem reciprocalPacketComplexEnergy_ofReal {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) :
    reciprocalPacketComplexEnergy I a lambda t =
      reciprocalPacketSplitEnergy I a lambda t := by
  rw [reciprocalPacketComplexEnergy, reciprocalPacketSplitEnergy]
  calc
    (∑ i ∈ I, reciprocalCharacterComplexEnergy (a i) (lambda i) t) =
        ∑ i ∈ I, (reciprocalCharacterSplitEnergy (a i) (lambda i) t : ℂ) :=
      Finset.sum_congr rfl fun i _ =>
        reciprocalCharacterComplexEnergy_ofReal (a i) (lambda i) t
    _ = (↑(∑ i ∈ I, reciprocalCharacterSplitEnergy (a i) (lambda i) t) : ℂ) := by
      simp

/-- The finite complex packet restricts on the imaginary axis to minus its compact real form. -/
theorem neg_reciprocalPacketComplexEnergy_mul_I {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (s : ℝ) :
    -reciprocalPacketComplexEnergy I a lambda (Complex.I * s) =
      reciprocalPacketPhaseEnergy I a lambda s := by
  rw [reciprocalPacketComplexEnergy, reciprocalPacketPhaseEnergy,
    ← Finset.sum_neg_distrib]
  calc
    (∑ i ∈ I, -reciprocalCharacterComplexEnergy (a i) (lambda i) (Complex.I * s)) =
        ∑ i ∈ I, (reciprocalCharacterPhaseEnergy (a i) (lambda i) s : ℂ) :=
      Finset.sum_congr rfl fun i _ =>
        neg_reciprocalCharacterComplexEnergy_mul_I (a i) (lambda i) s
    _ = (↑(∑ i ∈ I, reciprocalCharacterPhaseEnergy (a i) (lambda i) s) : ℂ) := by
      simp

/-- Finite-packet response is the sum of its local responses. -/
theorem hasDerivAt_reciprocalPacketSplitEnergy {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) :
    HasDerivAt (reciprocalPacketSplitEnergy I a lambda)
      (∑ i ∈ I, 2 * a i * lambda i * Real.sinh (lambda i * t)) t := by
  change HasDerivAt
    (fun x : ℝ => ∑ i ∈ I, reciprocalCharacterSplitEnergy (a i) (lambda i) x)
    (∑ i ∈ I, 2 * a i * lambda i * Real.sinh (lambda i * t)) t
  exact HasDerivAt.fun_sum fun i _ =>
    hasDerivAt_reciprocalCharacterSplitEnergy (a i) (lambda i) t

/-- The compact packet response is the sum of its local phase responses. -/
theorem hasDerivAt_reciprocalPacketPhaseEnergy {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (s : ℝ) :
    HasDerivAt (reciprocalPacketPhaseEnergy I a lambda)
      (∑ i ∈ I, 2 * a i * lambda i * Real.sin (lambda i * s)) s := by
  change HasDerivAt
    (fun x : ℝ => ∑ i ∈ I, reciprocalCharacterPhaseEnergy (a i) (lambda i) x)
    (∑ i ∈ I, 2 * a i * lambda i * Real.sin (lambda i * s)) s
  exact HasDerivAt.fun_sum fun i _ =>
    hasDerivAt_reciprocalCharacterPhaseEnergy (a i) (lambda i) s

/-- Split and compact finite packets have the same summed positive quadratic jet. -/
theorem reciprocalPacket_common_quadratic_jet {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) :
    deriv (fun t => deriv (reciprocalPacketSplitEnergy I a lambda) t) 0 =
        ∑ i ∈ I, 2 * a i * (lambda i) ^ 2 ∧
      deriv (fun s => deriv (reciprocalPacketPhaseEnergy I a lambda) s) 0 =
        ∑ i ∈ I, 2 * a i * (lambda i) ^ 2 := by
  have hsplitFun :
      (fun t => deriv (reciprocalPacketSplitEnergy I a lambda) t) =
        fun t => ∑ i ∈ I, 2 * a i * lambda i * Real.sinh (lambda i * t) := by
    funext t
    exact (hasDerivAt_reciprocalPacketSplitEnergy I a lambda t).deriv
  have hphaseFun :
      (fun s => deriv (reciprocalPacketPhaseEnergy I a lambda) s) =
        fun s => ∑ i ∈ I, 2 * a i * lambda i * Real.sin (lambda i * s) := by
    funext s
    exact (hasDerivAt_reciprocalPacketPhaseEnergy I a lambda s).deriv
  rw [hsplitFun, hphaseFun]
  constructor
  · apply HasDerivAt.deriv
    apply HasDerivAt.fun_sum
    intro i _
    have hlin : HasDerivAt (fun t : ℝ => lambda i * t) (lambda i) 0 :=
      hasDerivAt_const_mul (lambda i)
    simpa [pow_two, mul_assoc, mul_left_comm, mul_comm] using
      (hlin.sinh.const_mul (2 * a i * lambda i))
  · apply HasDerivAt.deriv
    apply HasDerivAt.fun_sum
    intro i _
    have hlin : HasDerivAt (fun s : ℝ => lambda i * s) (lambda i) 0 :=
      hasDerivAt_const_mul (lambda i)
    simpa [pow_two, mul_assoc, mul_left_comm, mul_comm] using
      (hlin.sin.const_mul (2 * a i * lambda i))

/-- Multi-clock conservation: fused virial equals Euler differentiation of fused split energy. -/
theorem reciprocalPacketVirial_eq_t_mul_deriv {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) :
    reciprocalPacketVirialCurrent I a lambda t =
      t * deriv (reciprocalPacketSplitEnergy I a lambda) t := by
  rw [(hasDerivAt_reciprocalPacketSplitEnergy I a lambda t).deriv,
    reciprocalPacketVirialCurrent, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  simp [reciprocalCharacterVirialCurrent]
  ring

/-- Fused virial retains the sum of all positive quadratic clock jets. -/
theorem reciprocalPacketVirial_quadratic_lower {ι : Type*} (I : Finset ι)
    (a lambda : ι → ℝ) (t : ℝ) (ha : ∀ i ∈ I, 0 ≤ a i) :
    (∑ i ∈ I, 2 * a i * (lambda i * t) ^ 2) ≤
      reciprocalPacketVirialCurrent I a lambda t := by
  rw [reciprocalPacketVirialCurrent]
  exact Finset.sum_le_sum fun i hi =>
    reciprocalCharacterVirial_quadratic_lower (ha i hi)

/-- A nonempty positive packet has exactly the neutral virial radical. -/
theorem reciprocalPacketVirial_eq_zero_iff {ι : Type*} {I : Finset ι}
    {a lambda : ι → ℝ} (hI : I.Nonempty)
    (ha : ∀ i ∈ I, 0 < a i) (hlambda : ∀ i ∈ I, 0 < lambda i) (t : ℝ) :
    reciprocalPacketVirialCurrent I a lambda t = 0 ↔ t = 0 := by
  constructor
  · intro hzero
    by_contra ht
    have hsum : 0 < ∑ i ∈ I, 2 * a i * (lambda i * t) ^ 2 := by
      apply Finset.sum_pos (fun i hi => ?_) hI
      have hlt : lambda i * t ≠ 0 := mul_ne_zero (hlambda i hi).ne' ht
      have hsquare : 0 < (lambda i * t) ^ 2 := sq_pos_of_ne_zero hlt
      exact mul_pos (mul_pos (by linarith) (ha i hi)) hsquare
    have hlower := reciprocalPacketVirial_quadratic_lower I a lambda t
      (fun i hi => (ha i hi).le)
    rw [hzero] at hlower
    linarith
  · rintro rfl
    simp [reciprocalPacketVirialCurrent, reciprocalCharacterVirialCurrent]

/-- The split energy of a nonempty positive packet has the same exact neutral radical. -/
theorem reciprocalPacketSplitEnergy_eq_zero_iff {ι : Type*} {I : Finset ι}
    {a lambda : ι → ℝ} (hI : I.Nonempty)
    (ha : ∀ i ∈ I, 0 < a i) (hlambda : ∀ i ∈ I, 0 < lambda i) (t : ℝ) :
    reciprocalPacketSplitEnergy I a lambda t = 0 ↔ t = 0 := by
  constructor
  · intro hzero
    by_contra ht
    have hpos : ∀ i ∈ I, 0 < reciprocalCharacterSplitEnergy (a i) (lambda i) t := by
      intro i hi
      rw [reciprocalCharacterSplitEnergy]
      have hcosh : 1 < Real.cosh (lambda i * t) :=
        Real.one_lt_cosh.mpr (mul_ne_zero (hlambda i hi).ne' ht)
      exact mul_pos (mul_pos (by linarith) (ha i hi)) (sub_pos.mpr hcosh)
    have hsum : 0 < ∑ i ∈ I, reciprocalCharacterSplitEnergy (a i) (lambda i) t :=
      Finset.sum_pos hpos hI
    rw [reciprocalPacketSplitEnergy] at hzero
    linarith
  · rintro rfl
    simp [reciprocalPacketSplitEnergy, reciprocalCharacterSplitEnergy]

/-- Real powers are the split real form of the logarithmic character. -/
theorem rpow_sub_rpow_neg_eq_two_sinh {s : ℝ} (hs : 0 < s) (t : ℝ) :
    s ^ t - s ^ (-t) = 2 * Real.sinh (Real.log s * t) := by
  rw [Real.rpow_def_of_pos hs, Real.rpow_def_of_pos hs, Real.sinh_eq]
  ring_nf

end

