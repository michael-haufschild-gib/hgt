import GaloisForLFunctions.HTGeometry.HilbertSchmidtTrace

/-!
# The trace ideal generated by Hilbert–Schmidt products

`hsTraceIdeal H` is the complex span of all products `A ∘ B` of two Hilbert–Schmidt operators on
`H`.  On it the diagonal sum `opTrace` is absolutely convergent and complex-linear, the ideal is
two-sided and closed under adjoints, and the trace is cyclic against every bounded operator:
`Tr(C T) = Tr(T C)`.  These are the algebraic rules used for traces of products of
Hilbert–Schmidt families.
-/

open scoped InnerProductSpace ComplexConjugate
open ContinuousLinearMap

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

variable (H) in
/-- The complex span of the products of two Hilbert–Schmidt operators. -/
def hsTraceIdeal : Submodule ℂ (H →L[ℂ] H) :=
  Submodule.span ℂ {T | ∃ A B : H →L[ℂ] H, IsHilbertSchmidt A ∧ IsHilbertSchmidt B ∧ T = A ∘L B}

theorem comp_mem_hsTraceIdeal {A B : H →L[ℂ] H} (hA : IsHilbertSchmidt A)
    (hB : IsHilbertSchmidt B) : A ∘L B ∈ hsTraceIdeal H :=
  Submodule.subset_span ⟨A, B, hA, hB, rfl⟩

theorem hsTraceIdeal_comp_left {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    C ∘L T ∈ hsTraceIdeal H := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    rw [← comp_assoc]
    exact comp_mem_hsTraceIdeal (hA.comp_left C) hB
  | zero => simp
  | add x y _ _ hx hy => rw [comp_add]; exact add_mem hx hy
  | smul c x _ hx => rw [comp_smul]; exact Submodule.smul_mem _ c hx

theorem hsTraceIdeal_comp_right {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    T ∘L C ∈ hsTraceIdeal H := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    rw [comp_assoc]
    exact comp_mem_hsTraceIdeal hA (hB.comp_right C)
  | zero => simp
  | add x y _ _ hx hy => rw [add_comp]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_comp]; exact Submodule.smul_mem _ c hx

theorem hsTraceIdeal_adjoint {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) :
    adjoint T ∈ hsTraceIdeal H := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    rw [adjoint_comp]
    exact comp_mem_hsTraceIdeal hB.adjoint hA.adjoint
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul c x _ hx => rw [map_smulₛₗ]; exact Submodule.smul_mem _ _ hx

/-- The diagonal of a trace-ideal operator is summable. -/
theorem summable_diag_of_mem_hsTraceIdeal {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) :
    Summable fun i => ⟪hsBasis ℂ H i, T (hsBasis ℂ H i)⟫_ℂ := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    exact summable_inner_diag_comp hA hB _
  | zero => simp
  | add x y _ _ hx hy => simpa [inner_add_right] using hx.add hy
  | smul c x _ hx => simpa [inner_smul_right] using hx.mul_left c

theorem opTrace_add_of_mem {S T : H →L[ℂ] H} (hS : S ∈ hsTraceIdeal H)
    (hT : T ∈ hsTraceIdeal H) : opTrace (S + T) = opTrace S + opTrace T := by
  simp only [opTrace, add_apply, inner_add_right]
  exact (summable_diag_of_mem_hsTraceIdeal hS).tsum_add (summable_diag_of_mem_hsTraceIdeal hT)

theorem opTrace_sub_of_mem {S T : H →L[ℂ] H} (hS : S ∈ hsTraceIdeal H)
    (hT : T ∈ hsTraceIdeal H) : opTrace (S - T) = opTrace S - opTrace T := by
  simp only [opTrace, sub_apply, inner_sub_right]
  exact (summable_diag_of_mem_hsTraceIdeal hS).tsum_sub (summable_diag_of_mem_hsTraceIdeal hT)

theorem opTrace_smul' (c : ℂ) (T : H →L[ℂ] H) : opTrace (c • T) = c * opTrace T := by
  simp only [opTrace, smul_apply, inner_smul_right]
  exact tsum_mul_left

theorem opTrace_neg' (T : H →L[ℂ] H) : opTrace (-T) = -opTrace T := by
  simpa using opTrace_smul' (-1) T

/-- The trace of the adjoint is the complex conjugate of the trace. -/
theorem opTrace_adjoint (T : H →L[ℂ] H) : opTrace (adjoint T) = conj (opTrace T) := by
  simp only [opTrace, adjoint_inner_right]
  rw [Complex.conj_tsum]
  congr 1
  funext i
  exact (inner_conj_symm _ _).symm

/-- **Cyclicity of the trace against bounded operators.** -/
theorem opTrace_comp_comm_of_mem {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    opTrace (C ∘L T) = opTrace (T ∘L C) := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    calc opTrace (C ∘L (A ∘L B)) = opTrace ((C ∘L A) ∘L B) := by rw [comp_assoc]
      _ = opTrace (B ∘L (C ∘L A)) := opTrace_comp_comm (hA.comp_left C) hB
      _ = opTrace ((B ∘L C) ∘L A) := by rw [comp_assoc]
      _ = opTrace (A ∘L (B ∘L C)) := opTrace_comp_comm (hB.comp_right C) hA
      _ = opTrace ((A ∘L B) ∘L C) := by rw [comp_assoc]
  | zero => simp
  | add x y hx' hy' hx hy =>
    rw [comp_add, add_comp, opTrace_add_of_mem (hsTraceIdeal_comp_left hx' C)
      (hsTraceIdeal_comp_left hy' C), opTrace_add_of_mem (hsTraceIdeal_comp_right hx' C)
      (hsTraceIdeal_comp_right hy' C), hx, hy]
  | smul c x _ hx => rw [comp_smul, smul_comp, opTrace_smul', opTrace_smul', hx]

/-! ## The same rules in the multiplicative notation of the operator algebra -/

theorem mul_mem_hsTraceIdeal {A B : H →L[ℂ] H} (hA : IsHilbertSchmidt A)
    (hB : IsHilbertSchmidt B) : A * B ∈ hsTraceIdeal H :=
  comp_mem_hsTraceIdeal hA hB

theorem hsTraceIdeal_mul_left {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    C * T ∈ hsTraceIdeal H :=
  hsTraceIdeal_comp_left hT C

theorem hsTraceIdeal_mul_right {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    T * C ∈ hsTraceIdeal H :=
  hsTraceIdeal_comp_right hT C

theorem opTrace_mul_comm_of_mem {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) (C : H →L[ℂ] H) :
    opTrace (C * T) = opTrace (T * C) :=
  opTrace_comp_comm_of_mem hT C

/-! ## Basis independence -/

theorem summable_diag_basis_of_mem {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) {ι : Type*}
    (b : HilbertBasis ι ℂ H) : Summable fun i => ⟪b i, T (b i)⟫_ℂ := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    exact summable_inner_diag_comp hA hB b
  | zero => simp
  | add x y _ _ hx hy => simpa [inner_add_right] using hx.add hy
  | smul c x _ hx => simpa [inner_smul_right] using hx.mul_left c

/-- On the trace ideal the trace is the diagonal sum over **every** Hilbert basis. -/
theorem opTrace_eq_tsum_basis_of_mem {T : H →L[ℂ] H} (hT : T ∈ hsTraceIdeal H) {ι : Type*}
    (b : HilbertBasis ι ℂ H) : opTrace T = ∑' i, ⟪b i, T (b i)⟫_ℂ := by
  induction hT using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, B, hA, hB, rfl⟩ := hx
    exact opTrace_comp_eq_tsum_basis hA hB b
  | zero => simp [opTrace]
  | add x y hx' hy' hx hy =>
    rw [opTrace_add_of_mem hx' hy', hx, hy]
    simp only [add_apply, inner_add_right]
    exact ((summable_diag_basis_of_mem hx' b).tsum_add (summable_diag_basis_of_mem hy' b)).symm
  | smul c x _ hx =>
    rw [opTrace_smul', hx]
    simp only [smul_apply, inner_smul_right]
    exact tsum_mul_left.symm

end

end GaloisForLFunctions.HTGeometry
