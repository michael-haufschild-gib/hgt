import GaloisForLFunctions.HTGeometry.DifferentialIndependentFieldUniversality

/-!
# Equivalences between freely generated differential fields

This file upgrades the canonical equivalence between two differential-adjoin subfields to an
equivalence of the ambient fields when both labelled differential families generate the top
field.  Keeping the transport here prevents every concrete torsor construction from repeating
the same subtype-to-top bookkeeping.
-/

open scoped Differential

namespace GaloisForLFunctions

noncomputable section

/-- The canonical differential equivalence between two ambient fields freely generated by
equally indexed differential palettes. -/
def differentialIndependentTopAlgEquiv
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra F L] [Differential K] [Differential L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (hxtop : differentialAdjoin F (Set.range x) = ⊤)
    (hytop : differentialAdjoin F (Set.range y) = ⊤) : K ≃ₐ[F] L :=
  let ex : differentialAdjoin F (Set.range x) ≃ₐ[F] K :=
    (IntermediateField.equivOfEq hxtop).trans IntermediateField.topEquiv
  let ey : differentialAdjoin F (Set.range y) ≃ₐ[F] L :=
    (IntermediateField.equivOfEq hytop).trans IntermediateField.topEquiv
  ex.symm.trans ((differentialIndependentAdjoinAlgEquiv x y hx hy).trans ey)

@[simp]
theorem differentialIndependentTopAlgEquiv_apply
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra F L] [Differential K] [Differential L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (hxtop : differentialAdjoin F (Set.range x) = ⊤)
    (hytop : differentialAdjoin F (Set.range y) = ⊤) (i : ι) :
    differentialIndependentTopAlgEquiv x y hx hy hxtop hytop (x i) = y i := by
  let ex : differentialAdjoin F (Set.range x) ≃ₐ[F] K :=
    (IntermediateField.equivOfEq hxtop).trans IntermediateField.topEquiv
  let ey : differentialAdjoin F (Set.range y) ≃ₐ[F] L :=
    (IntermediateField.equivOfEq hytop).trans IntermediateField.topEquiv
  have hxy := differentialIndependentAdjoinAlgEquiv_jet x y hx hy i 0
  change ey ((differentialIndependentAdjoinAlgEquiv x y hx hy) (ex.symm (x i))) = y i
  have hxpre : ex.symm (x i) =
      ⟨x i, subset_differentialAdjoin F (Set.mem_range_self i)⟩ := by
    apply ex.injective
    rfl
  rw [hxpre]
  exact congrArg Subtype.val hxy

/-- The canonical ambient-field equivalence commutes with the derivation. -/
theorem differentialIndependentTopAlgEquiv_deriv
    {F K L ι : Type*} [Field F] [Field K] [Field L]
    [Differential F] [Differential K] [Differential L]
    [Algebra F K] [Algebra F L]
    [DifferentialAlgebra F K] [DifferentialAlgebra F L]
    (x : ι → K) (y : ι → L)
    (hx : DifferentialIndependent F x) (hy : DifferentialIndependent F y)
    (hxtop : differentialAdjoin F (Set.range x) = ⊤)
    (hytop : differentialAdjoin F (Set.range y) = ⊤) (z : K) :
    differentialIndependentTopAlgEquiv x y hx hy hxtop hytop z′ =
      (differentialIndependentTopAlgEquiv x y hx hy hxtop hytop z)′ := by
  let ex : differentialAdjoin F (Set.range x) ≃ₐ[F] K :=
    (IntermediateField.equivOfEq hxtop).trans IntermediateField.topEquiv
  let ey : differentialAdjoin F (Set.range y) ≃ₐ[F] L :=
    (IntermediateField.equivOfEq hytop).trans IntermediateField.topEquiv
  let zx : differentialAdjoin F (Set.range x) := ex.symm z
  have hzx : ex.symm z′ = zx′ := by
    apply Subtype.ext
    rfl
  have hxy := differentialIndependentAdjoinAlgEquiv_deriv x y hx hy zx
  change ey ((differentialIndependentAdjoinAlgEquiv x y hx hy) (ex.symm z′)) =
    Differential.deriv (ey ((differentialIndependentAdjoinAlgEquiv x y hx hy) (ex.symm z)))
  rw [hzx]
  exact congrArg Subtype.val hxy

end

end GaloisForLFunctions
