import GaloisForLFunctions.HTGeometry.TwistedScalarLogDerivative

/-!
# Inhomogeneous diagonal source laws with a base particular solution

A diagonal affine source law `sigma_i(y_p) = m_(i,p) y_p + omega_(i,p)` is homogeneous as soon as
the same affine law has a solution `b_p` in the base field: the difference `y_p - b_p` transforms
purely multiplicatively.  Subtracting a base element changes neither the differential field
generated by the family nor its matroid rank, since all jets of a base element are base elements.

So an inhomogeneous diagonal curved datum whose affine part is a *base* solution of its own law is
carried into the homogeneous diagonal case, and from there into the flat theory by logarithmic
differentiation.  For the unit twist `m = 1` the base equation is exactly the flat coboundary
condition on the increments, so this contains the flat statement.
-/

open Set
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u

variable {C K L : Type u} [Field C] [Field K] [Field L]
  [Algebra C K] [Algebra C L] [Algebra K L] [IsScalarTower C K L]
  [Differential K] [Differential L] [DifferentialAlgebra K L]
  {I : Type u} (tau : I → K ≃+* K) (sigma : I → L ≃+* L)

variable {κ : Type u} [Fintype κ]

/-- The homogenization of an affine family by a base particular solution. -/
def baseTranslate (y : κ → L) (b : κ → K) (p : κ) : L := y p - algebraMap K L (b p)

/-! ### Translating by base elements is invisible to the differential rank -/

omit [Fintype κ] in
/-- Subtracting base elements does not change the generated differential field. -/
theorem differentialAdjoin_baseTranslate (y : κ → L) (b : κ → K) :
    differentialAdjoin K (Set.range (baseTranslate y b))
      = differentialAdjoin K (Set.range y) := by
  have hrange : (Set.range (baseTranslate y b))
      = Set.range fun p => y p + -algebraMap K L (b p) := by
    refine Set.ext fun z => ?_
    constructor
    · rintro ⟨p, rfl⟩; exact ⟨p, by rw [baseTranslate, sub_eq_add_neg]⟩
    · rintro ⟨p, rfl⟩; exact ⟨p, by rw [baseTranslate, sub_eq_add_neg]⟩
  rw [hrange]
  refine GaloisForLFunctions.differentialAdjoin_addOfJetsInBase y
    (fun p => -algebraMap K L (b p)) fun p n => ⟨differentialJet n (-(b p)), ?_⟩
  rw [← map_neg (algebraMap K L) (b p)]
  exact GaloisForLFunctions.differentialJet_algebraMap_of_differentialAlgebra n (-(b p))

omit [Fintype κ] in
/-- Subtracting base elements does not change the differential-algebraic closure. -/
theorem differentialClosure_baseTranslate (y : κ → L) (b : κ → K) :
    differentialClosure K (Set.range (baseTranslate y b))
      = differentialClosure K (Set.range y) := by
  unfold differentialClosure
  rw [differentialAdjoin_baseTranslate]

omit [Fintype κ] in
/-- Subtracting base elements does not change the differential matroid rank. -/
theorem eRk_baseTranslate [CharZero L] (y : κ → L) (b : κ → K) :
    (differentialMatroid K L).eRk (Set.range (baseTranslate y b))
      = (differentialMatroid K L).eRk (Set.range y) := by
  rw [← Matroid.eRk_closure_eq, ← Matroid.eRk_closure_eq (X := Set.range y),
    differentialMatroid_closure_eq_differentialClosure,
    differentialMatroid_closure_eq_differentialClosure,
    differentialClosure_baseTranslate]

/-! ### Homogenization -/

omit [Fintype κ] [Differential K] [Differential L] [DifferentialAlgebra K L] in
/-- **A base particular solution homogenizes a diagonal affine source law.**  If the base element
`b_p` satisfies the same affine law in the base field, the difference transforms purely
multiplicatively. -/
theorem baseTranslate_shift {y : κ → L} {m om : I → κ → K} {b : κ → K}
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hshift : ∀ i p, sigma i (y p)
      = algebraMap K L (m i p) * y p + algebraMap K L (om i p))
    (hbase : ∀ i p, tau i (b p) = m i p * b p + om i p) (i : I) (p : κ) :
    sigma i (baseTranslate y b p) = algebraMap K L (m i p) * baseTranslate y b p := by
  have hb : sigma i (algebraMap K L (b p))
      = algebraMap K L (m i p) * algebraMap K L (b p) + algebraMap K L (om i p) := by
    rw [hcomp, hbase, map_add, map_mul]
  simp only [baseTranslate]
  rw [map_sub, hshift, hb]
  ring

omit [Fintype κ] [Differential K] in
/-- The zero family solves a homogeneous law, so the homogeneous case is the case `omega = 0`. -/
theorem base_solution_zero {m : I → κ → K} (i : I) (p : κ) :
    tau i ((0 : κ → K) p) = m i p * (0 : κ → K) p + (0 : I → κ → K) i p := by
  simp

omit [Fintype κ] [Differential K] in
/-- For the unit twist the base equation is the flat coboundary condition on the increments. -/
theorem base_solution_one_iff {om : I → κ → K} {b : κ → K} :
    (∀ (i : I) (p : κ), tau i (b p) = (fun _ _ => (1 : K)) i p * b p + om i p)
      ↔ ∀ (i : I) (p : κ), tau i (b p) - b p = om i p := by
  refine ⟨fun h i p => by rw [h i p]; ring, fun h i p => ?_⟩
  rw [← h i p]; ring

/-! ### The curved laws for an inhomogeneous diagonal family with a base solution -/

omit [Fintype κ] in
/-- **The curved source-boundary criterion for an inhomogeneous diagonal family.**  Once the affine
part is removed by a base particular solution, differential independence of the logarithmic
derivatives is linear independence over `C[D]` of the boundary classes of the logarithmic
derivatives of the twists. -/
theorem twistedInhomogeneous_differentialIndependent_iff
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i w, sigma i w′ = (sigma i w)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ w : L, (∀ i, sigma i w = w) → ∃ c : C, algebraMap C L c = w)
    (hC : ∀ c : C, (algebraMap C K c)′ = 0)
    (hfix : ∀ i c, tau i (algebraMap C K c) = algebraMap C K c)
    (hderiv : ∀ i k, tau i k′ = (tau i k)′)
    [CharZero K] {y : κ → L} {m om : I → κ → K} {b : κ → K}
    (hshift : ∀ i p, sigma i (y p)
      = algebraMap K L (m i p) * y p + algebraMap K L (om i p))
    (hbase : ∀ i p, tau i (b p) = m i p * b p + om i p)
    (hy : ∀ p, baseTranslate y b p ≠ 0) (hm : ∀ i p, m i p ≠ 0) :
    DifferentialIndependent K (logDerivFamily (baseTranslate y b)) ↔
      LinearIndependent (Polynomial C)
        (fun p : κ => boundaryClass tau hC hfix hderiv fun i => logDerivTwist m i p) :=
  twistedDiagonal_differentialIndependent_iff tau sigma hcomp hderivL hCfixed hfixed hC hfix hderiv
    hy hm (baseTranslate_shift tau sigma hcomp hshift hbase)

/-- **The curved rank law for an inhomogeneous diagonal family.**  The differential rank of the
family itself is the `C[D]`-rank of the span of the boundary classes of the logarithmic
derivatives of the twists. -/
theorem twistedInhomogeneous_eRk_eq_rank_span_boundaryClass
    (hcomp : ∀ i k, sigma i (algebraMap K L k) = algebraMap K L (tau i k))
    (hderivL : ∀ i w, sigma i w′ = (sigma i w)′)
    (hCfixed : ∀ i c, sigma i (algebraMap C L c) = algebraMap C L c)
    (hfixed : ∀ w : L, (∀ i, sigma i w = w) → ∃ c : C, algebraMap C L c = w)
    (hC : ∀ c : C, (algebraMap C K c)′ = 0)
    (hfix : ∀ i c, tau i (algebraMap C K c) = algebraMap C K c)
    (hderiv : ∀ i k, tau i k′ = (tau i k)′)
    [CharZero K] [CharZero L] [DecidableEq κ] {y : κ → L} {m om : I → κ → K} {b : κ → K}
    (hshift : ∀ i p, sigma i (y p)
      = algebraMap K L (m i p) * y p + algebraMap K L (om i p))
    (hbase : ∀ i p, tau i (b p) = m i p * b p + om i p)
    (hy : ∀ p, baseTranslate y b p ≠ 0) (hm : ∀ i p, m i p ≠ 0) :
    ∃ r : ℕ,
      (differentialMatroid K L).eRk (Set.range y) = r ∧
      Module.rank (Polynomial C) (Submodule.span (Polynomial C)
        (Set.range fun p : κ =>
          boundaryClass tau hC hfix hderiv fun i => logDerivTwist m i p)) = r := by
  obtain ⟨r, hrk, hrank⟩ := twistedDiagonal_eRk_eq_rank_span_boundaryClass tau sigma hcomp hderivL
    hCfixed hfixed hC hfix hderiv hy hm (baseTranslate_shift tau sigma hcomp hshift hbase)
  exact ⟨r, (eRk_baseTranslate y b).symm.trans hrk, hrank⟩

end

end GaloisForLFunctions.HTGeometry
