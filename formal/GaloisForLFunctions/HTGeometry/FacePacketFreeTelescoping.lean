import GaloisForLFunctions.HTGeometry.FacePacketDifferenceSystem
import GaloisForLFunctions.HTGeometry.TwistedFreeShiftTransport
import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaFacePalette

/-!
# Excluding a simultaneous telescoper on a free deeper face field

The last input of the descending face-lifting lemma is the exclusion of a simultaneous jet
telescoper.  Split the deeper face field as `K_(s+1) = K_0<O_(J ∪ {q})>_delta`, where `K_0` is
generated by all the other deeper packets.  The removed packet is `T_q`-shifted one slice at a time
and `K_0` is `T_q`-stable, so under the free parametrization the translation is the `phi`-twisted
unit shift of the bilateral grid, with `phi` the restriction of the translation to `K_0`.  The
displacement of the block of `J` in the direction `q` is the coface element `T_J^a F_(J ∪ {q})`,
whose exponent in the direction `q` vanishes: a putative telescoper is therefore a nonzero linear
form supported on the single slice `0`, which the twisted obstruction forbids.

* `facePacketBaseFamily` — the deeper faces with the target one removed, still closed in the
  direction `q`;
* `facePacketDisplacementSlice` — the displacement labelling of the block by the zero slice;
* **`facePacket_no_telescoping_of_free`** — no simultaneous telescoper;
* **`facePacket_differentialIndependent_of_free`** — the descending face-lifting lemma.
-/

open Filter Topology Set Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher HTGeometry

noncomputable section

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## The complementary base family -/

/-- The deeper faces with the target face removed. -/
def facePacketBaseFamily (S : Set (Finset ι)) (J : Finset ι) (q : ι) : Set (Finset ι) :=
  S \ {insert q J}

omit [Fintype ι] in
/-- The complementary family is still closed in the direction `q`: a deeper face `L` with
`insert q L = insert q J` would be `J` itself. -/
theorem facePacketBaseFamily_closed {S : Set (Finset ι)}
    (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) {J : Finset ι} {q : ι}
    (hqJ : q ∉ J) (hJS : J ∉ S) :
    ∀ L ∈ facePacketBaseFamily S J q, q ∉ L →
      insert q L ∈ facePacketBaseFamily S J q := by
  rintro L ⟨hLS, _⟩ hqL
  refine ⟨hS L hLS q hqL, ?_⟩
  intro hmem
  have heq : insert q L = insert q J := hmem
  have hLJ : L = J := by
    have h1 : (insert q L).erase q = L := Finset.erase_insert hqL
    have h2 : (insert q J).erase q = J := Finset.erase_insert hqJ
    rw [← h1, heq, h2]
  exact hJS (hLJ ▸ hLS)

/-! ## The displacement labelling -/

/-- The displacement of a packet element in a surviving direction is the coface element, whose
exponent in that direction vanishes. -/
theorem facePacket_displacement_mem_slice (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι)
    {q : ι} (hq : q ∉ J) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ multipleEllipticGammaFacePacket τ hτ J) :
    addTranslationMeroEquiv (τ q) y - y ∈
      multipleEllipticGammaFacePacketSlice τ hτ (insert q J) q := by
  obtain ⟨g, hg, rfl⟩ := hy
  rw [facePacket_coface τ hτ J hq g]
  obtain ⟨n, hn, rfl⟩ := hg
  refine ⟨_, ⟨n, ?_, hn q hq, rfl⟩, rfl⟩
  intro i hi
  exact hn i fun hiJ => hi (Finset.mem_insert_of_mem hiJ)

/-- The displacement labelling of the translation block by the zero slice of the next packet. -/
def facePacketDisplacementSlice (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι)
    {q : ι} (hq : q ∉ J) :
    ↥(multipleEllipticGammaFacePacket τ hτ J) →
      ↥(multipleEllipticGammaFacePacketSlice τ hτ (insert q J) q) :=
  fun y => ⟨addTranslationMeroEquiv (τ q) (y : meroField (Set.univ : Set ℂ)) -
      (y : meroField (Set.univ : Set ℂ)),
    facePacket_displacement_mem_slice τ hτ J hq y.2⟩

theorem facePalette_zero (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (J : Finset ι) (q : ι)
    (a : ↥(multipleEllipticGammaFacePacketSlice τ hτ J q)) :
    facePalette τ hτ J q (a, 0) = (a : meroField (Set.univ : Set ℂ)) := by
  show addTranslationMeroEquiv (((0 : ℤ) : ℂ) * τ q) (a : meroField (Set.univ : Set ℂ)) = _
  rw [Int.cast_zero, zero_mul, addTranslationMeroEquiv_zero_apply]

/-- Jets of a generated differential field are computed in the ambient field. -/
theorem coe_differentialJet_differentialAdjoin (T : Set (meroField (Set.univ : Set ℂ)))
    (n : ℕ) (x : ↥(differentialAdjoin ℂ T)) :
    ((differentialJet n x : ↥(differentialAdjoin ℂ T)) : meroField (Set.univ : Set ℂ)) =
      differentialJet n (x : meroField (Set.univ : Set ℂ)) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [differentialJet_succ, differentialJet_succ, ← ih]
      rfl

/-! ## Excluding the telescoper -/

set_option synthInstance.maxHeartbeats 800000 in
set_option maxHeartbeats 1000000 in
/-- **No simultaneous telescoper on a free deeper face field.**  If the target packet is
differentially independent over the field generated by the other deeper packets and generates the
deeper face field over it, and if the displacement labelling is injective, then no nonzero finite
constant-coefficient jet form of the displacements is a coboundary in the surviving direction. -/
theorem facePacket_no_telescoping_of_free (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (hJS : J ∉ S)
    (hindep : DifferentialIndependent
      ↥(differentialAdjoin ℂ (facePacketUnion τ hτ (facePacketBaseFamily S J q)))
      (facePalette τ hτ (insert q J) q))
    (hgen : ∀ z : meroField (Set.univ : Set ℂ),
      z ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S) →
        z ∈ differentialAdjoin
          ↥(differentialAdjoin ℂ (facePacketUnion τ hτ (facePacketBaseFamily S J q)))
          (Set.range (facePalette τ hτ (insert q J) q)))
    (hinjD : Function.Injective (facePacketDisplacementSlice τ hτ J hqJ))
    (c : (↥(multipleEllipticGammaFacePacket τ hτ J) × ℕ) →₀ ℂ) (hc : c ≠ 0)
    (k : ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) :
    (facePacketDifferenceSystem τ hτ hS q u).defect 1 k ≠
      Finsupp.linearCombination ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
        (fun p ↦ differentialJet p.2
          (facePacketDisplacement τ hτ J hqJ huJ hqS huS 1 p.1))
        (Finsupp.mapRange
          (algebraMap ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))
          (map_zero (algebraMap ℂ
            ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))) c) := by
  classical
  intro hEq
  -- the base field and the twist
  have hS₀ : ∀ L ∈ facePacketBaseFamily S J q, q ∉ L →
      insert q L ∈ facePacketBaseFamily S J q :=
    facePacketBaseFamily_closed hS hqJ hJS
  set K₀ : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    differentialAdjoin ℂ (facePacketUnion τ hτ (facePacketBaseFamily S J q)) with hK₀
  set P : (↥(multipleEllipticGammaFacePacketSlice τ hτ (insert q J) q) × ℤ) →
      meroField (Set.univ : Set ℂ) := facePalette τ hτ (insert q J) q with hP
  let φ : ↥K₀ ≃+* ↥K₀ :=
    meroTranslationRestrict K₀ (τ q)
      (fun x hx => differentialAdjoin_facePacketUnion_translate_stable τ hτ q hS₀ hx)
      (fun x hx => differentialAdjoin_facePacketUnion_neg_translate_stable τ hτ q hS₀ hx)
  -- the transported index map and coefficients
  let e : ↥(multipleEllipticGammaFacePacket τ hτ J) × ℕ →
      ↥(multipleEllipticGammaFacePacketSlice τ hτ (insert q J) q) × ℕ :=
    fun p => (facePacketDisplacementSlice τ hτ J hqJ p.1, p.2)
  have he : Function.Injective e := by
    rintro ⟨a, m⟩ ⟨b, n⟩ h
    have h1 : facePacketDisplacementSlice τ hτ J hqJ a =
        facePacketDisplacementSlice τ hτ J hqJ b := congrArg Prod.fst h
    have h2 : m = n := congrArg Prod.snd h
    rw [hinjD h1, h2]
  set c' : (↥(multipleEllipticGammaFacePacketSlice τ hτ (insert q J) q) × ℕ) →₀ ↥K₀ :=
    Finsupp.mapRange (algebraMap ℂ ↥K₀) (map_zero (algebraMap ℂ ↥K₀))
      (Finsupp.mapDomain e c) with hc'def
  have hc' : c' ≠ 0 := by
    rw [hc'def]
    intro hzero
    have h1 : Finsupp.mapDomain e c = 0 :=
      Finsupp.mapRange_injective (algebraMap ℂ ↥K₀) (map_zero _)
        (algebraMap ℂ ↥K₀).injective (by simpa using hzero)
    exact hc (Finsupp.mapDomain_injective he (by simpa using h1))
  -- the element of the free extension
  have hkmem : (k : meroField (Set.univ : Set ℂ)) ∈
      differentialAdjoin ↥K₀ (Set.range P) := hgen _ k.2
  refine oneSlice_ne_coboundary_of_twisted_ambient_shift P hindep
    (addTranslationMeroEquiv (τ q)) φ
    (fun y => addTranslationMeroEquiv_deriv (τ q) y)
    (fun b => rfl)
    (fun p => facePalette_shift τ hτ (insert q J) q p)
    c' hc' ⟨(k : meroField (Set.univ : Set ℂ)), hkmem⟩ ?_
  -- both sides become the same finite sum in the ambient field
  have hRHS : ((c'.sum (fun j a =>
        algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P)) a *
          ⟨differentialJet j.2 (P (j.1, 0)),
            differentialJet_mem_differentialAdjoin ↥K₀
              (Set.mem_range_self (j.1, 0)) j.2⟩) :
        ↥(differentialAdjoin ↥K₀ (Set.range P))) : meroField (Set.univ : Set ℂ)) =
      c.sum (fun p a => algebraMap ℂ (meroField (Set.univ : Set ℂ)) a *
        differentialJet p.2
          (addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
            (p.1 : meroField (Set.univ : Set ℂ)))) := by
    rw [hc'def, Finsupp.sum_mapRange_index (by intro a; simp),
      Finsupp.sum_mapDomain_index_inj he]
    simp only [Finsupp.sum]
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have hPD : P (facePacketDisplacementSlice τ hτ J hqJ p.1, 0) =
        addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
          (p.1 : meroField (Set.univ : Set ℂ)) := by
      rw [hP, facePalette_zero]
      rfl
    rw [MulMemClass.coe_mul]
    show ((algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P))
        (algebraMap ℂ ↥K₀ (c p)) : ↥(differentialAdjoin ↥K₀ (Set.range P))) :
        meroField (Set.univ : Set ℂ)) *
        differentialJet p.2 (P (facePacketDisplacementSlice τ hτ J hqJ p.1, 0)) = _
    have hcoef : ((algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P))
          (algebraMap ℂ ↥K₀ (c p)) : ↥(differentialAdjoin ↥K₀ (Set.range P))) :
          meroField (Set.univ : Set ℂ)) =
        algebraMap ℂ (meroField (Set.univ : Set ℂ)) (c p) := by
      rw [IsScalarTower.algebraMap_apply ℂ ↥K₀ (meroField (Set.univ : Set ℂ))]
      rfl
    rw [hPD, hcoef]
  have hLHS : ((Finsupp.linearCombination ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
        (fun p ↦ differentialJet p.2
          (facePacketDisplacement τ hτ J hqJ huJ hqS huS 1 p.1))
        (Finsupp.mapRange
          (algebraMap ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))
          (map_zero (algebraMap ℂ
            ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)))) c) :
        ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) :
        meroField (Set.univ : Set ℂ)) =
      c.sum (fun p a => algebraMap ℂ (meroField (Set.univ : Set ℂ)) a *
        differentialJet p.2
          (addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
            (p.1 : meroField (Set.univ : Set ℂ)))) := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (by intro a; simp)]
    simp only [Finsupp.sum]
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have hcoefK : ((algebraMap ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)) (c p) :
        ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) : meroField (Set.univ : Set ℂ)) =
        algebraMap ℂ (meroField (Set.univ : Set ℂ)) (c p) :=
      (IsScalarTower.algebraMap_apply ℂ ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
        (meroField (Set.univ : Set ℂ)) (c p)).symm
    have hD : ((facePacketDisplacement τ hτ J hqJ huJ hqS huS 1 p.1 :
        ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))) : meroField (Set.univ : Set ℂ)) =
        addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
          (p.1 : meroField (Set.univ : Set ℂ)) := rfl
    rw [Algebra.smul_def, MulMemClass.coe_mul,
      coe_differentialJet_differentialAdjoin, Algebra.algebraMap_self_apply, hcoefK, hD]
  show addTranslationMeroEquiv (τ q) (k : meroField (Set.univ : Set ℂ)) -
      (k : meroField (Set.univ : Set ℂ)) = _
  rw [hRHS, ← hLHS]
  exact congrArg (fun w : ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S)) =>
    (w : meroField (Set.univ : Set ℂ))) hEq

/-! ## The descending face-lifting lemma -/

set_option synthInstance.maxHeartbeats 800000 in
/-- **Descending face-lifting on a free deeper field.**  The translation block of a face is
differentially algebraically independent over the differential field generated by the deeper
packets. -/
theorem facePacket_differentialIndependent_of_free (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (hJS : J ∉ S)
    (hv : LinearIndependent ℚ (facePacketPeriods τ q u))
    (hindep : DifferentialIndependent
      ↥(differentialAdjoin ℂ (facePacketUnion τ hτ (facePacketBaseFamily S J q)))
      (facePalette τ hτ (insert q J) q))
    (hgen : ∀ z : meroField (Set.univ : Set ℂ),
      z ∈ differentialAdjoin ℂ (facePacketUnion τ hτ S) →
        z ∈ differentialAdjoin
          ↥(differentialAdjoin ℂ (facePacketUnion τ hτ (facePacketBaseFamily S J q)))
          (Set.range (facePalette τ hτ (insert q J) q)))
    (hinjD : Function.Injective (facePacketDisplacementSlice τ hτ J hqJ)) :
    DifferentialIndependent ↥(differentialAdjoin ℂ (facePacketUnion τ hτ S))
      (facePacketBlock τ hτ J) :=
  facePacket_differentialIndependent_of_no_telescoping τ hτ hS J hqJ huJ hqS huS hv
    (fun c hc k => ⟨1, facePacket_no_telescoping_of_free τ hτ hS J hqJ huJ hqS huS hJS
      hindep hgen hinjD c hc k⟩)

end

end GaloisForLFunctions
