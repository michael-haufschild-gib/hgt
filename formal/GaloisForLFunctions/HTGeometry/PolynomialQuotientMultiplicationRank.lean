import GaloisForLFunctions.HTGeometry.QuotientIdealDimension
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Rank and nullity of multiplication on a polynomial quotient

For a nonzero `W` and any `R` in `K[X]`, multiplication by the class of `R` on `K[X]/(W)` has
image the ideal generated by `gcd W R` and therefore

`rank = deg W - deg gcd (W, R)`,  `nullity = deg gcd (W, R)`.

The image identification is Bezout in one direction and divisibility in the other; the nullity is
then rank-nullity on the finite-dimensional quotient.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K : Type*} [Field K] [DecidableEq K]

/-- The finite local algebra carrying a polynomial divisor. -/
abbrev polyQuot (W : K[X]) : Type _ := K[X] ⧸ Ideal.span ({W} : Set K[X])

/-- Multiplication by the class of `R` on `K[X]/(W)`, as a `K`-linear endomorphism. -/
noncomputable def polyQuotMul (W R : K[X]) : polyQuot W →ₗ[K] polyQuot W :=
  LinearMap.mulLeft K (Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])) R)

omit [DecidableEq K] in
theorem range_polyQuotMul (W R : K[X]) :
    LinearMap.range (polyQuotMul W R) =
      Submodule.restrictScalars K
        (Ideal.map (Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])))
          (Ideal.span ({R} : Set K[X]))) := by
  classical
  ext x
  simp only [LinearMap.mem_range, polyQuotMul, LinearMap.mulLeft_apply,
    Submodule.restrictScalars_mem, Ideal.map_span, Set.image_singleton,
    Ideal.mem_span_singleton']
  constructor
  · rintro ⟨y, rfl⟩; exact ⟨y, mul_comm _ _⟩
  · rintro ⟨y, rfl⟩; exact ⟨y, mul_comm _ _⟩

/-- The image of multiplication by `R` is the image of the ideal generated by `gcd W R`. -/
theorem map_span_gcd_eq_map_span (W R : K[X]) :
    Ideal.map (Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])))
        (Ideal.span ({EuclideanDomain.gcd W R} : Set K[X])) =
      Ideal.map (Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])))
        (Ideal.span ({R} : Set K[X])) := by
  classical
  set g := EuclideanDomain.gcd W R with hg
  set mk := Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])) with hmk
  apply le_antisymm
  · rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton,
      Ideal.span_singleton_le_span_singleton]
    have hbez : g = W * EuclideanDomain.gcdA W R + R * EuclideanDomain.gcdB W R :=
      EuclideanDomain.gcd_eq_gcd_ab W R
    refine ⟨mk (EuclideanDomain.gcdB W R), ?_⟩
    have hW : mk W = 0 := by
      rw [hmk, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    rw [hbez]
    simp [hW]
  · rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton,
      Ideal.span_singleton_le_span_singleton]
    exact map_dvd _ (EuclideanDomain.gcd_dvd_right W R)

/-- **Rank of multiplication on the finite local algebra.** -/
theorem finrank_range_polyQuotMul_add_natDegree_gcd (W R : K[X]) (hW : W ≠ 0) :
    Module.finrank K (LinearMap.range (polyQuotMul W R)) +
        (EuclideanDomain.gcd W R).natDegree = W.natDegree := by
  classical
  have h := finrank_ideal_add_natDegree_of_dvd (K := K) hW (EuclideanDomain.gcd_dvd_left W R)
  rw [range_polyQuotMul]
  have hmap : (Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span ({W} : Set K[X])))
        (Ideal.span ({EuclideanDomain.gcd W R} : Set K[X]))) =
      (Ideal.map (Ideal.Quotient.mk (Ideal.span ({W} : Set K[X])))
        (Ideal.span ({R} : Set K[X]))) := by
    rw [← map_span_gcd_eq_map_span W R]
    rfl
  rw [hmap] at h
  exact h

/-- **Nullity of multiplication on the finite local algebra.** -/
theorem finrank_ker_polyQuotMul (W R : K[X]) (hW : W ≠ 0) :
    Module.finrank K (LinearMap.ker (polyQuotMul W R)) =
      (EuclideanDomain.gcd W R).natDegree := by
  classical
  haveI := finiteDimensional_polynomialQuotient (K := K) hW
  have hrn := LinearMap.finrank_range_add_finrank_ker (polyQuotMul W R)
  have hdim : Module.finrank K (polyQuot W) = W.natDegree :=
    finrank_polynomialQuotient hW
  have hr := finrank_range_polyQuotMul_add_natDegree_gcd W R hW
  omega

end GaloisForLFunctions.HTGeometry
