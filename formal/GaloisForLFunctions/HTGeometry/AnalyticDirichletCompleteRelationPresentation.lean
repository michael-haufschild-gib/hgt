import GaloisForLFunctions.HTGeometry.AnalyticDirichletObservableGrassmannCorrespondence
import GaloisForLFunctions.HTGeometry.DifferentialFinsuppPivotRelationIdeal

/-!
# Complete differential-relation presentations for analytic Dirichlet observables

For a tail-dense independent source frame, choose an arbitrary source subspace and an arbitrary
family of source vectors inside it.  The basis carriers are differentially independent over the
actual embedded coordinate field.  Every other carrier has the same finitely supported basis
coordinates at every jet order.  Consequently the complete differential-polynomial relation ideal
is generated by precisely those prolonged source-linear relations, with no hidden nonlinear
relations.  Neither the source subspace nor the dependent family is assumed finite-dimensional.
-/

namespace GaloisForLFunctions.HTGeometry

open Set
open scoped Differential

noncomputable section

universe u v w

attribute [local instance]
  analyticObservableUpperEndAnalyticDomain
  analyticObservableUpperEndMeroComplexAlgebra
  analyticObservableUpperEndMeroDifferential

/-- The actual analytic carrier of one basis vector of a source subspace. -/
def analyticObservableGrassmannPivotCarrier
    {V : Type u} {J : Type v}
    (x : Nat.Primes → V) (f : J → V → ℂ)
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (W : Submodule ℂ (J →₀ ℂ))
    (q : analyticObservableGrassmannIndex W) : upperEndMeroField :=
  analyticPrimeObservableShiftCarrier
    (fun p ↦ analyticObservableGrassmannSource f W q (x p))
    (analyticObservableGrassmannBound M W q)
    (analyticObservableCoordinateSource_bound x f M hM
      (analyticObservableGrassmannCoordinate W q)) a

/-- The actual analytic carrier of an arbitrary vector in the source subspace. -/
def analyticObservableSubspaceCarrier
    {V : Type u} {J : Type v}
    (x : Nat.Primes → V) (f : J → V → ℂ)
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (W : Submodule ℂ (J →₀ ℂ)) (c : W) : upperEndMeroField :=
  analyticPrimeObservableShiftCarrier
    (fun p ↦ analyticObservableCoordinateSource f c.1 (x p))
    (analyticObservableCoordinateBound M c.1)
    (analyticObservableCoordinateSource_bound x f M hM c.1) a

/-- Finitely supported basis coordinates, transported to the embedded coordinate field. -/
def analyticObservableSubspacePivotRow
    {J : Type v} {R : Type w}
    (W : Submodule ℂ (J →₀ ℂ)) (c : R → W) (r : R) :
    analyticObservableGrassmannIndex W →₀ upperEndRationalCoordinateField :=
  Finsupp.mapRange (algebraMap ℂ upperEndRationalCoordinateField)
    (map_zero (algebraMap ℂ upperEndRationalCoordinateField))
    ((Module.Basis.ofVectorSpace ℂ W).repr (c r))

/-- A source-subspace basis gives an arbitrary-cardinality differentially independent analytic
carrier family over the genuine embedded coordinate field. -/
theorem cofiniteTailDenseOn_analyticObservableGrassmannPivotCarrier_differentialIndependent
    {V : Type u} {J : Type v} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j ↦ fun z : K ↦ f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (W : Submodule ℂ (J →₀ ℂ)) :
    GaloisForLFunctions.DifferentialIndependent upperEndRationalCoordinateField
      (analyticObservableGrassmannPivotCarrier x f M hM a W) := by
  exact cofiniteTailDenseOn_analyticObservableShiftCarrier_differentialIndependent_arbitrary
    x K hx (analyticObservableGrassmannSource f W)
    (fun q ↦ continuous_analyticObservableCoordinateSource f hf
      (analyticObservableGrassmannCoordinate W q))
    (analyticObservableGrassmannSource_linearIndependent f hlinear W)
    (analyticObservableGrassmannBound M W)
    (fun q p ↦ analyticObservableCoordinateSource_bound x f M hM
      (analyticObservableGrassmannCoordinate W q) p) a

/-- Every jet of a source-subspace carrier has the same finitely supported coordinates in the
basis-carrier jets. -/
theorem differentialJet_analyticObservableSubspaceCarrier_eq_pivotRow
    {V : Type u} {J : Type v} {R : Type w}
    (x : Nat.Primes → V) (f : J → V → ℂ)
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (W : Submodule ℂ (J →₀ ℂ)) (c : R → W)
    (r : R) (n : ℕ) :
    GaloisForLFunctions.differentialJet n
        (analyticObservableSubspaceCarrier x f M hM a W (c r)) =
      (analyticObservableSubspacePivotRow W c r).sum fun q z ↦
        algebraMap upperEndRationalCoordinateField upperEndMeroField z *
          GaloisForLFunctions.differentialJet n
            (analyticObservableGrassmannPivotCarrier x f M hM a W q) := by
  let b := Module.Basis.ofVectorSpace ℂ W
  let u : analyticObservableGrassmannIndex W →₀ ℂ := b.repr (c r)
  have hcoord : (c r).1 =
      u.sum fun q z ↦ z • (analyticObservableGrassmannCoordinate W q) := by
    have hrepr := b.linearCombination_repr (c r)
    have hrepr' := congrArg Subtype.val hrepr
    simpa [u, b, analyticObservableGrassmannCoordinate,
      Finsupp.linearCombination_apply, Finsupp.sum] using hrepr'.symm
  have hcoeff : ∀ p : Nat.Primes,
      analyticObservableCoordinateSource f (c r).1 (x p) =
        u.sum fun q z ↦ z * analyticObservableGrassmannSource f W q (x p) := by
    intro p
    rw [hcoord]
    classical
    simp [analyticObservableCoordinateSource, analyticObservableGrassmannSource,
      analyticObservableGrassmannCoordinate, Finsupp.linearCombination_apply,
      Finsupp.sum, Finset.sum_apply]
  have hjets :=
    differentialJet_analyticPrimeObservableShiftCarrier_finsuppLinearCombination
      (fun q p ↦ analyticObservableGrassmannSource f W q (x p))
      (analyticObservableGrassmannBound M W)
      (fun q p ↦ analyticObservableCoordinateSource_bound x f M hM
        (analyticObservableGrassmannCoordinate W q) p)
      u
      (fun p ↦ analyticObservableCoordinateSource f (c r).1 (x p))
      (analyticObservableCoordinateBound M (c r).1)
      (analyticObservableCoordinateSource_bound x f M hM (c r).1)
      hcoeff a n
  unfold analyticObservableSubspaceCarrier
  rw [hjets]
  classical
  have hsupp : (analyticObservableSubspacePivotRow W c r).support = u.support := by
    unfold analyticObservableSubspacePivotRow
    exact Finsupp.support_mapRange_of_injective
      (map_zero (algebraMap ℂ upperEndRationalCoordinateField)) _
      (FaithfulSMul.algebraMap_injective ℂ upperEndRationalCoordinateField)
  simp only [Finsupp.sum]
  rw [hsupp]
  apply Finset.sum_congr rfl
  intro q hq
  simp only [analyticObservableSubspacePivotRow, Finsupp.mapRange_apply,
    analyticObservableGrassmannPivotCarrier, u]
  rw [IsScalarTower.algebraMap_apply ℂ upperEndRationalCoordinateField
    upperEndMeroField]

/-- **Complete analytic linear-presentation law.**  For an arbitrary source subspace and an
arbitrary family of its vectors, every differential-polynomial relation among the basis carriers
and the additional carriers is generated by the jetwise prolongations of their source-linear
coordinate identities.  There are no further nonlinear relations. -/
theorem cofiniteTailDenseOn_analyticObservable_completeRelationPresentation
    {V : Type u} {J : Type v} {R : Type w} [TopologicalSpace V]
    (x : Nat.Primes → V) (K : Set V) (hx : CofiniteTailDenseOn x K)
    (f : J → V → ℂ) (hf : ∀ j, Continuous (f j))
    (hlinear : LinearIndependent ℂ (fun j ↦ fun z : K ↦ f j z.1))
    (M : J → ℝ) (hM : ∀ j p, ‖f j (x p)‖ ≤ M j)
    (a : ℂ) (W : Submodule ℂ (J →₀ ℂ)) (c : R → W) :
    GaloisForLFunctions.differentialRelationIdeal
        (C := upperEndRationalCoordinateField)
        (Sum.elim
          (analyticObservableGrassmannPivotCarrier x f M hM a W)
          (fun r ↦ analyticObservableSubspaceCarrier x f M hM a W (c r))) =
      differentialFinsuppPivotRelationIdeal
        (analyticObservableSubspacePivotRow W c) (fun _ _ ↦ 0) := by
  apply differentialRelationIdeal_sumElim_eq_finsuppPivot
  · exact
      cofiniteTailDenseOn_analyticObservableGrassmannPivotCarrier_differentialIndependent
        x K hx f hf hlinear M hM a W
  · intro r n
    rw [map_zero, zero_add]
    exact differentialJet_analyticObservableSubspaceCarrier_eq_pivotRow
      x f M hM a W c r n

end

end GaloisForLFunctions.HTGeometry
