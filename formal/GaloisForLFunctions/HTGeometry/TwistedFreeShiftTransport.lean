import GaloisForLFunctions.HTGeometry.TwistedFreeShiftNonsummability
import GaloisForLFunctions.HTGeometry.DifferentialIndependentOneSliceNonsummability

/-!
# One-slice nonsummability for an ambient shift that moves the base field

The differential field generated by a bilateral palette that is differentially independent over a
base field `F` is the free bilateral rational jet field over `F`.  An ambient differential
automorphism which moves the palette one slice and acts on `F` by a twist `φ` is, under that
parametrization, exactly the `φ`-twisted shift.  So the twisted one-slice obstruction applies to it:
no nonzero finite `F`-linear form in the jets of the zero slice is a coboundary for it.

This is the form the descending face-lifting argument needs, where the base field is generated by
the deeper translation orbits and is itself moved by the translation.

* **`twistedShift_parametrization_coe`** — the parametrization intertwines the twisted shift with
  the ambient automorphism;
* **`oneSlice_ne_coboundary_of_twisted_ambient_shift`** — the resulting obstruction.
-/

open scoped Differential

namespace GaloisForLFunctions

open HTGeometry

noncomputable section

variable {F L α : Type*} [Field F] [Field L] [Algebra F L] [Differential L]

/-- The canonical parametrization intertwines the `φ`-twisted shift of the free jet field with an
ambient differential automorphism that moves the palette one slice and acts on the base by `φ`. -/
theorem twistedShift_parametrization_coe
    (x : (α × ℤ) → L) (hx : DifferentialIndependent F x)
    (Ψ : L ≃+* L) (φ : F ≃+* F)
    (hderiv : ∀ y : L, Ψ (y′) = (Ψ y)′)
    (hbase : ∀ b : F, Ψ (algebraMap F L b) = algebraMap F L (φ b))
    (hshift : ∀ p : α × ℤ, Ψ (x p) = x (p.1, p.2 + 1))
    (G : FreeShiftField F α) :
    ((freeShiftDifferentialAdjoinParametrization x hx (twistedShiftFieldEquiv φ G) :
        differentialAdjoin F (Set.range x)) : L) =
      Ψ ((freeShiftDifferentialAdjoinParametrization x hx G :
        differentialAdjoin F (Set.range x)) : L) := by
  classical
  have hjet : ∀ (n : ℕ) (y : L), Ψ (differentialJet n y) = differentialJet n (Ψ y) := by
    intro n
    induction n with
    | zero => intro y; simp
    | succ n ih =>
        intro y
        rw [differentialJet_succ, differentialJet_succ, hderiv, ih]
  have hΦX : ∀ (a : α) (m : ℤ) (n : ℕ),
      ((freeShiftDifferentialAdjoinParametrization x hx
          (algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
            (MvPolynomial.X ((a, (m, n)) : FreeShiftJetIndex α))) :
        differentialAdjoin F (Set.range x)) : L) = differentialJet n (x (a, m)) := by
    intro a m n
    rw [freeShiftDifferentialAdjoinParametrization_X]
  have hpoly : ∀ p : FreeShiftPolynomial F α,
      ((freeShiftDifferentialAdjoinParametrization x hx
          (algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
            (twistedShiftPolyEquiv φ p)) : differentialAdjoin F (Set.range x)) : L) =
        Ψ ((freeShiftDifferentialAdjoinParametrization x hx
          (algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α) p) :
          differentialAdjoin F (Set.range x)) : L) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      have hCa : algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α) (MvPolynomial.C a) =
          algebraMap F (FreeShiftField F α) a := by
        rfl
      have hCφ : algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
          (MvPolynomial.C (φ a)) = algebraMap F (FreeShiftField F α) (φ a) := by
        rfl
      rw [twistedShiftPolyEquiv_C, hCa, hCφ, AlgEquiv.commutes, AlgEquiv.commutes]
      show algebraMap F L (φ a) = Ψ (algebraMap F L a)
      rw [hbase]
    | add p q hp hq =>
      simp only [map_add, AddMemClass.coe_add, hp, hq]
    | mul_X p i hp =>
      obtain ⟨a, m, n⟩ := i
      have hei : freeShiftJetIndexEquiv (α := α) 1 ((a, (m, n)) : FreeShiftJetIndex α) =
          ((a, (m + 1, n)) : FreeShiftJetIndex α) := rfl
      have hxjet : Ψ (differentialJet n (x (a, m))) = differentialJet n (x (a, m + 1)) := by
        rw [hjet, hshift (a, m)]
      simp only [map_mul, MulMemClass.coe_mul, twistedShiftPolyEquiv_X, hei, hΦX, hp, hxjet]
  have hcoediv : ∀ u v : differentialAdjoin F (Set.range x),
      ((u / v : differentialAdjoin F (Set.range x)) : L) = (u : L) / (v : L) :=
    fun u v => map_div₀ (differentialAdjoin F (Set.range x)).val u v
  obtain ⟨p, q, hq, rfl⟩ :=
    IsFractionRing.div_surjective (A := FreeShiftPolynomial F α) (K := FreeShiftField F α) G
  simp only [map_div₀, twistedShiftFieldEquiv_algebraMap, hcoediv, hpoly]

/-- **One-slice nonsummability for a base-moving ambient shift.**  If a bilateral palette is
differentially independent over `F` and an ambient differential automorphism moves it one slice
while acting on `F` by a twist, then no nonzero finite `F`-linear form in the jets of the zero slice
is a coboundary for that automorphism. -/
theorem oneSlice_ne_coboundary_of_twisted_ambient_shift
    (x : (α × ℤ) → L) (hx : DifferentialIndependent F x)
    (Ψ : L ≃+* L) (φ : F ≃+* F)
    (hderiv : ∀ y : L, Ψ (y′) = (Ψ y)′)
    (hbase : ∀ b : F, Ψ (algebraMap F L b) = algebraMap F L (φ b))
    (hshift : ∀ p : α × ℤ, Ψ (x p) = x (p.1, p.2 + 1))
    (c : (α × ℕ) →₀ F) (hc : c ≠ 0)
    (g : differentialAdjoin F (Set.range x)) :
    Ψ (g : L) - (g : L) ≠
      ((c.sum (fun j a =>
        algebraMap F (differentialAdjoin F (Set.range x)) a *
          ⟨differentialJet j.2 (x (j.1, 0)),
            differentialJet_mem_differentialAdjoin F
              (Set.mem_range_self (j.1, 0)) j.2⟩) :
        differentialAdjoin F (Set.range x)) : L) := by
  classical
  intro h
  have hform : freeShiftDifferentialAdjoinParametrization x hx
      (algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α) (freeShiftOneSlice c)) =
      c.sum (fun j a => algebraMap F (differentialAdjoin F (Set.range x)) a *
        ⟨differentialJet j.2 (x (j.1, 0)),
          differentialJet_mem_differentialAdjoin F (Set.mem_range_self (j.1, 0)) j.2⟩) := by
    simp only [HTGeometry.freeShiftOneSlice, Finsupp.sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hCcj : algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
        (MvPolynomial.C (c j)) = algebraMap F (FreeShiftField F α) (c j) := by
      rfl
    have h1 : algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
        ((MvPolynomial.C (c j) : FreeShiftPolynomial F α) *
          MvPolynomial.X ((j.1, ((0 : ℤ), j.2)) : FreeShiftJetIndex α)) =
        algebraMap F (FreeShiftField F α) (c j) *
          algebraMap (FreeShiftPolynomial F α) (FreeShiftField F α)
            (MvPolynomial.X ((j.1, ((0 : ℤ), j.2)) : FreeShiftJetIndex α)) := by
      rw [map_mul, hCcj]
    rw [h1, map_mul, AlgEquiv.commutes, freeShiftDifferentialAdjoinParametrization_X]
  refine twistedShiftOneSlice_ne_coboundary φ c hc
    ((freeShiftDifferentialAdjoinParametrization x hx).symm g) ?_
  apply (freeShiftDifferentialAdjoinParametrization x hx).injective
  rw [map_sub, AlgEquiv.apply_symm_apply, hform]
  apply Subtype.ext
  rw [AddSubgroupClass.coe_sub,
    twistedShift_parametrization_coe x hx Ψ φ hderiv hbase hshift
      ((freeShiftDifferentialAdjoinParametrization x hx).symm g),
    AlgEquiv.apply_symm_apply]
  exact h

end

end GaloisForLFunctions
