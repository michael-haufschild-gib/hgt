import Mathlib

/-!
# Forward-recurrence coefficient-field confinement

This file isolates the exact algebraic consequence of a Mahler--Sibuya--Sperber forward
recurrence.  If each next coefficient belongs to the field generated by finitely many fixed
recurrence constants and the preceding coefficients, then the whole algebraic coefficient
sequence lies in one number field.

The remaining analytic input for the coefficient-field cards is the extraction of this recurrence
from an algebraic differential equation; it is deliberately not replaced by an assumption about
differential algebraicity here.
-/

open scoped IntermediateField

namespace GaloisForLFunctions.HTGeometry

/-- Every next coefficient lies in the field generated by the fixed recurrence constants and all
preceding coefficients.  This is the field-theoretic content of an eventual forward recurrence. -/
def ForwardFieldRecursive {ι : Type*} (a : ℕ → ℂ) (c : ι → ℂ) (N : ℕ) : Prop :=
  ∀ n, N ≤ n →
    a (n + 1) ∈ IntermediateField.adjoin ℚ (Set.range c ∪ a '' Set.Iic n)

/-- Coefficients are confined to one concrete number field inside `ℂ`. -/
def CoefficientsConfinedToNumberField (a : ℕ → ℂ) : Prop :=
  ∃ K : IntermediateField ℚ ℂ,
    Nonempty (FiniteDimensional ℚ K) ∧ ∀ n, a n ∈ K

/-- A forward-field recurrence confines every coefficient to the field generated by its fixed
constants and finite initial segment. -/
theorem all_mem_recurrenceField_of_forwardFieldRecursive
    {ι : Type*} (a : ℕ → ℂ) (c : ι → ℂ) (N : ℕ)
    (hrec : ForwardFieldRecursive a c N) :
    ∀ n, a n ∈ IntermediateField.adjoin ℚ (Set.range c ∪ a '' Set.Iic N) := by
  let K : IntermediateField ℚ ℂ :=
    IntermediateField.adjoin ℚ (Set.range c ∪ a '' Set.Iic N)
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      by_cases hn : n ≤ N
      · exact IntermediateField.subset_adjoin ℚ _
          (Or.inr ⟨n, hn, rfl⟩)
      · cases n with
        | zero => exact (hn (Nat.zero_le N)).elim
        | succ m =>
            have hNm : N ≤ m := Nat.le_of_lt_succ (lt_of_not_ge hn)
            apply (IntermediateField.adjoin_le_iff.mpr ?_) (hrec m hNm)
            rintro x (hx | hx)
            · exact IntermediateField.subset_adjoin ℚ _ (Or.inl hx)
            · obtain ⟨j, hj, rfl⟩ := hx
              exact ih j (Nat.lt_succ_of_le hj)

/-- **Forward-recurrence confinement.**  Algebraic recurrence constants and algebraic coefficients
in a forward-field recurrence generate one finite extension of `ℚ` containing every coefficient. -/
theorem coefficientsConfinedToNumberField_of_forwardFieldRecursive
    {ι : Type*} [Finite ι] (a : ℕ → ℂ) (c : ι → ℂ) (N : ℕ)
    (ha : ∀ n, IsAlgebraic ℚ (a n)) (hc : ∀ i, IsAlgebraic ℚ (c i))
    (hrec : ForwardFieldRecursive a c N) :
    CoefficientsConfinedToNumberField a := by
  let S : Set ℂ := Set.range c ∪ a '' Set.Iic N
  have hSfinite : S.Finite :=
    Set.finite_range c |>.union (Set.finite_Iic N |>.image a)
  letI : Finite S := hSfinite
  have hSint : ∀ x ∈ S, IsIntegral ℚ x := by
    rintro x (⟨i, rfl⟩ | ⟨n, _hn, rfl⟩)
    · exact isAlgebraic_iff_isIntegral.mp (hc i)
    · exact isAlgebraic_iff_isIntegral.mp (ha n)
  let K : IntermediateField ℚ ℂ := IntermediateField.adjoin ℚ S
  have hfinite : FiniteDimensional ℚ K :=
    IntermediateField.finiteDimensional_adjoin hSint
  refine ⟨K, ⟨hfinite⟩, ?_⟩
  exact all_mem_recurrenceField_of_forwardFieldRecursive a c N hrec

end GaloisForLFunctions.HTGeometry
