import GaloisForLFunctions.HTGeometry.IteratedDerivativeGrowth

/-!
# A composition outgrows every bound in the jet of the inner function

The second main theorem for `g` at `N` preimages of one value of `f`, the composition counting
bridge, and the negligibility of the error term along a common sequence of radii — the same sequence
along which every derivative `g⁽ʲ⁾` has characteristic at most `2ⁿ⁺¹·T(r,g)` up to an additive
constant — give: for every `c` and `d`,

```text
¬ ∀ᶠ r, T(r, f∘g) ≤ c·∑_{j ≤ n} T(r, g⁽ʲ⁾) + d·log r + d.
```

This is the growth statement that contradicts algebraicity of `f ∘ g` over a field generated by
finitely many derivatives of `g`.
-/

namespace GaloisForLFunctions.HTGeometry

open Complex Metric Real Set Filter ValueDistribution MeromorphicOn
open scoped Topology

/-- **The composition outgrows every linear bound in the jet of the inner function.** -/
theorem not_eventually_characteristic_comp_le_jet {f g : ℂ → ℂ}
    (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (hfnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, f z = p.eval z)
    (hgnp : ¬ ∃ p : Polynomial ℂ, ∀ z : ℂ, g z = p.eval z) (n : ℕ) (c d : ℝ)
    {Z : Set ℝ} (hZ : MeasureTheory.volume Z = 0) :
    ¬ (∀ᶠ r in atTop, r ∉ Z → characteristic (fun w => f (g w)) ⊤ r
        ≤ c * (∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ r)
          + d * Real.log r + d) := by
  classical
  intro hbound
  set M₀ : ℝ := |c| * ((n : ℝ) + 1) * 2 ^ (n + 1) with hM₀
  set N : ℕ := ⌈M₀⌉₊ + 4 with hN
  have hNge : M₀ + 1 ≤ (N : ℝ) - 3 := by
    have h := Nat.le_ceil M₀
    rw [hN]
    push_cast
    linarith
  -- `N` preimages of one value of `f`
  obtain ⟨a, hainf⟩ := exists_infinite_preimage_of_not_polynomial hf hfnp
  obtain ⟨B, hBsub, hBcard⟩ := hainf.exists_subset_card_eq N
  set A : Fin N → ℂ := fun j => ((B.equivFin.symm (finCongr hBcard.symm j) : B) : ℂ) with hA
  have hAmem : ∀ j, A j ∈ B := fun j => (B.equivFin.symm (finCongr hBcard.symm j)).2
  have hAinj : Function.Injective A := by
    intro i j hij
    have h1 : (B.equivFin.symm (finCongr hBcard.symm i))
        = (B.equivFin.symm (finCongr hBcard.symm j)) := Subtype.ext hij
    exact (finCongr hBcard.symm).injective (B.equivFin.symm.injective h1)
  have hfA : ∀ j, f (A j) = a := fun j => hBsub (Finset.mem_coe.mpr (hAmem j))
  -- separation
  set P : Finset (ℂ × ℂ) := (B ×ˢ B).filter (fun p => p.1 ≠ p.2) with hP
  set δ : ℝ := if h : P.Nonempty then P.inf' h (fun p => ‖p.1 - p.2‖) else 1 with hδdef
  have hδpos : 0 < δ := by
    rw [hδdef]
    split_ifs with h
    · rw [Finset.lt_inf'_iff]
      intro p hp
      exact norm_pos_iff.mpr (sub_ne_zero.mpr (Finset.mem_filter.mp hp).2)
    · norm_num
  have hsep : ∀ i j : Fin N, i ≠ j → δ ≤ ‖A i - A j‖ := by
    intro i j hij
    have hne : A i ≠ A j := fun hcon => hij (hAinj hcon)
    have hmem : (A i, A j) ∈ P := by
      rw [hP, Finset.mem_filter, Finset.mem_product]
      exact ⟨⟨hAmem i, hAmem j⟩, hne⟩
    rw [hδdef, dif_pos ⟨_, hmem⟩]
    exact Finset.inf'_le _ hmem
  -- nondegeneracy
  have hgo : ∀ j : Fin N, ∀ z, meromorphicOrderAt (fun w => g w - A j) z ≠ ⊤ :=
    fun j z => meromorphicOrderAt_sub_const_ne_top hg hgnp (A j) z
  have hg0 : ∀ z, meromorphicOrderAt g z ≠ ⊤ := by
    intro z
    have h := meromorphicOrderAt_sub_const_ne_top hg hgnp 0 z
    simpa using h
  have hco := meromorphicOrderAt_comp_sub_const_ne_top hf hg hfnp hgnp a
  have hgd : ∀ z, meromorphicOrderAt (deriv g) z ≠ ⊤ := by
    intro z
    have h := meromorphicOrderAt_iteratedDeriv_ne_top hg hgnp 1 z
    simpa [iteratedDeriv_one] using h
  have hcod : ∀ r : ℝ, ∀ᶠ z in codiscreteWithin (sphere (0 : ℂ) |r|), deriv g z ≠ 0 := by
    intro r
    have hgan : AnalyticOnNhd ℂ g Set.univ := hg.differentiableOn.analyticOnNhd isOpen_univ
    have hdan : AnalyticOnNhd ℂ (deriv g) Set.univ := hgan.deriv
    have hmero : MeromorphicOn (deriv g) (sphere (0 : ℂ) |r|) :=
      fun x _ => (hdan x (Set.mem_univ x)).meromorphicAt
    exact MeromorphicAt.MeromorphicOn.codiscreteWithin_setOf_ne_zero hmero fun u _ => hgd u
  -- the second main theorem and the common radii
  obtain ⟨Csmt, hsmt⟩ := exists_sub_two_characteristic_le_sum_logCounting hg A hδpos hsep hg0
  obtain ⟨rn, Cjet, hrntop, hrnZ, hCjet0, hjet, herr⟩ :=
    exists_radii_jet_bound_and_error hg hgnp n A hZ
  -- the first main theorem for the composite
  have hcomp : Differentiable ℂ fun w => f (g w) := fun x => (hf (g x)).comp x (hg x)
  have hmcomp : Meromorphic (fun w => f (g w)) := fun z => (hcomp.analyticAt z).meromorphicAt
  have hmsub : Meromorphic (((fun w => f (g w)) - fun _ : ℂ => a) : ℂ → ℂ) := by
    intro z
    exact (hmcomp z).sub (analyticAt_const.meromorphicAt)
  set Ka : ℝ := (Real.posLog ‖a‖ + Real.log 2)
      + max |Real.log ‖(((fun w => f (g w)) - fun _ : ℂ => a) : ℂ → ℂ) 0‖|
          |Real.log ‖meromorphicTrailingCoeffAt
            (((fun w => f (g w)) - fun _ : ℂ => a) : ℂ → ℂ) 0‖| with hKa
  have hfmt : ∀ r : ℝ, 1 ≤ r →
      logCounting (fun w => f (g w)) (a : WithTop ℂ) r
        ≤ characteristic (fun w => f (g w)) ⊤ r + Ka := by
    intro r hr
    have h2 : 0 ≤ proximity (fun w => f (g w)) (a : WithTop ℂ) r :=
      ValueDistribution.proximity_nonneg r
    have h3 := characteristic_coe_le_characteristic_top (f := fun w => f (g w)) (a₀ := a) (r := r)
      hmcomp hmsub
    have h1 : characteristic (fun w => f (g w)) (a : WithTop ℂ) r
        = proximity (fun w => f (g w)) (a : WithTop ℂ) r
          + logCounting (fun w => f (g w)) (a : WithTop ℂ) r := rfl
    rw [hKa]
    linarith
  -- the contradiction along the good radii
  have hdiv := tendsto_characteristic_div_log_atTop hg hgnp
  set D : ℝ := |d| + |Ka| + |Csmt| + |c| * ((n : ℝ) + 1) * Cjet + 1 with hD
  have hDpos : 0 < D := by
    rw [hD]
    positivity
  have hfinal : ∀ᶠ k in atTop, characteristic g ⊤ (rn k) ≤ 2 * D * Real.log (rn k) + 2 * D := by
    filter_upwards [hrntop.eventually hbound, hjet, herr 1 one_pos,
      hrntop.eventually_ge_atTop (1 : ℝ)] with k hb0 hj he hr1
    have hb := hb0 (hrnZ k)
    have hsmtk := hsmt (rn k) hr1 (hcod (rn k))
    have hbridge := sum_logCounting_le_logCounting_comp hf hg A hAinj hfA hgo hco hr1
    have hfmtk := hfmt (rn k) hr1
    have hT0 : 0 ≤ characteristic g ⊤ (rn k) := ValueDistribution.characteristic_nonneg hr1
    -- the jet sum is a fixed multiple of `T(r,g)`
    have hjetsum : ∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k)
        ≤ ((n : ℝ) + 1) * (2 ^ (n + 1) * characteristic g ⊤ (rn k) + Cjet) := by
      have hb' : ∀ j ∈ Finset.range (n + 1),
          characteristic (iteratedDeriv j g) ⊤ (rn k)
            ≤ 2 ^ (n + 1) * characteristic g ⊤ (rn k) + Cjet := by
        intro j hjmem
        exact hj j (Nat.lt_succ_iff.mp (Finset.mem_range.mp hjmem))
      have h := Finset.sum_le_sum hb'
      rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul] at h
      push_cast at h
      linarith
    have hjetnn : 0 ≤ ∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k) :=
      Finset.sum_nonneg fun j _ => ValueDistribution.characteristic_nonneg hr1
    have hcabs : c * (∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k))
        ≤ |c| * (((n : ℝ) + 1) * (2 ^ (n + 1) * characteristic g ⊤ (rn k) + Cjet)) := by
      have h1 : c * (∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k))
          ≤ |c| * (∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k)) :=
        mul_le_mul_of_nonneg_right (le_abs_self c) hjetnn
      have h2 : |c| * (∑ j ∈ Finset.range (n + 1), characteristic (iteratedDeriv j g) ⊤ (rn k))
          ≤ |c| * (((n : ℝ) + 1) * (2 ^ (n + 1) * characteristic g ⊤ (rn k) + Cjet)) :=
        mul_le_mul_of_nonneg_left hjetsum (abs_nonneg c)
      linarith
    have hlog0 : 0 ≤ Real.log (rn k) := Real.log_nonneg hr1
    have hdlog : d * Real.log (rn k) + d ≤ |d| * Real.log (rn k) + |d| := by
      have := le_abs_self d
      nlinarith [hlog0]
    have hKale : Ka ≤ |Ka| := le_abs_self Ka
    have hCsmtle : Csmt ≤ |Csmt| := le_abs_self Csmt
    have hM₀ge : M₀ + 1 ≤ (N : ℝ) - 3 := hNge
    have hexp : |c| * (((n : ℝ) + 1) * (2 ^ (n + 1) * characteristic g ⊤ (rn k) + Cjet))
        = M₀ * characteristic g ⊤ (rn k) + |c| * ((n : ℝ) + 1) * Cjet := by
      rw [hM₀]
      ring
    rw [hexp] at hcabs
    have hNsub : ((N : ℝ) - 2) * characteristic g ⊤ (rn k)
        ≤ characteristic (fun w => f (g w)) ⊤ (rn k) + Ka
          + characteristic g ⊤ (rn k) + Csmt := by
      linarith [hsmtk, hbridge, hfmtk, he]
    have hMle : (M₀ + 1) * characteristic g ⊤ (rn k)
        ≤ ((N : ℝ) - 3) * characteristic g ⊤ (rn k) :=
      mul_le_mul_of_nonneg_right hM₀ge hT0
    have hcj : (0 : ℝ) ≤ |c| * ((n : ℝ) + 1) * Cjet :=
      mul_nonneg (mul_nonneg (abs_nonneg c) (by positivity)) hCjet0
    have hdD : |d| ≤ D := by
      rw [hD]
      linarith [abs_nonneg Ka, abs_nonneg Csmt, hcj]
    have hlogD : |d| * Real.log (rn k) ≤ 2 * D * Real.log (rn k) :=
      mul_le_mul_of_nonneg_right (by linarith) hlog0
    linarith [hNsub, hb, hcabs, hdlog, hKale, hCsmtle, hMle, hT0, hlog0, hcj, hlogD,
      abs_nonneg d, abs_nonneg Ka, abs_nonneg Csmt]
  -- but the characteristic outgrows every logarithm
  have hcontra : ∀ᶠ k in atTop, 2 * D * Real.log (rn k) + 2 * D < characteristic g ⊤ (rn k) := by
    have hev := (hdiv.comp hrntop).eventually_ge_atTop (2 * D + 2 * D + 1)
    filter_upwards [hev, hrntop.eventually_ge_atTop (Real.exp 1)] with k hk hre
    have hr1 : (1 : ℝ) ≤ rn k := le_trans (le_trans (by norm_num) (Real.add_one_le_exp 1)) hre
    have hlog1 : (1 : ℝ) ≤ Real.log (rn k) := by
      rw [Real.le_log_iff_exp_le (by linarith)]
      exact hre
    have hk' : 2 * D + 2 * D + 1 ≤ characteristic g ⊤ (rn k) / Real.log (rn k) := hk
    rw [le_div_iff₀ (by linarith)] at hk'
    nlinarith [hk', hlog1, hDpos]
  obtain ⟨k, h1, h2⟩ := (hfinal.and hcontra).exists
  linarith

end GaloisForLFunctions.HTGeometry
