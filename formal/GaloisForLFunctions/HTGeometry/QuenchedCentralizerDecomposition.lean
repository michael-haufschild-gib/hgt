import GaloisForLFunctions.HTGeometry.EuclideanPackingBound

/-!
# The quenched centralizer decomposition

The zero spectral projection of a self-adjoint generator is fixed by its own flow, so the flow
splits as the projection plus its restriction to the orthogonal complement.  On that complement the
flow is unitary, so the difference `e^{-itL} - P` is a partial isometry: its Hilbert--Schmidt energy
is exactly the dimension of the complement, independently of `t`, and it moves some unit vector
without shrinking it.

No quenched norm contraction therefore exists at any time, even after exact removal of the zero
modes.  Only signed averaging of the oscillatory complement can decay.
-/

open Finset Matrix

namespace GaloisForLFunctions.HTGeometry

section Quenched

open _root_.Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The Hilbert--Schmidt energy of a diagonal matrix is the sum of its squared entries. -/
theorem hsSqRe_diagonal (d : n → ℂ) : hsSqRe (Matrix.diagonal d) = ∑ j, ‖d j‖ ^ 2 := by
  classical
  rw [hsSqRe_eq_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_eq_single a]
  · rw [Matrix.diagonal_apply_eq]
  · intro b _ hba
    rw [Matrix.diagonal_apply_ne _ hba, norm_zero]
    norm_num
  · intro h
    exact absurd (Finset.mem_univ a) h

/-- A real phase has modulus one. -/
theorem norm_exp_neg_ofReal_mul_I (r : ℝ) :
    ‖Complex.exp (-((r : ℝ) : ℂ) * Complex.I)‖ = 1 := by
  have hcast : (-((r : ℝ) : ℂ)) = ((-r : ℝ) : ℂ) := by push_cast; ring
  rw [hcast]
  exact Complex.norm_exp_ofReal_mul_I (-r)

/-- The zero spectral projection of a diagonal self-adjoint generator. -/
noncomputable def zeroSpectralProj (lam : n → ℝ) : Matrix n n ℂ :=
  Matrix.diagonal fun j => if lam j = 0 then (1 : ℂ) else 0

/-- The unitary flow generated by a diagonal self-adjoint operator. -/
noncomputable def liouvilleFlow (lam : n → ℝ) (t : ℝ) : Matrix n n ℂ :=
  Matrix.diagonal fun j => Complex.exp (-((t * lam j : ℝ) : ℂ) * Complex.I)

/-- The flow fixes the zero spectral projection. -/
theorem liouvilleFlow_mul_zeroSpectralProj (lam : n → ℝ) (t : ℝ) :
    liouvilleFlow lam t * zeroSpectralProj lam = zeroSpectralProj lam := by
  rw [liouvilleFlow, zeroSpectralProj, Matrix.diagonal_mul_diagonal]
  congr 1
  funext j
  by_cases hj : lam j = 0
  · rw [if_pos hj, hj]
    norm_num
  · rw [if_neg hj, mul_zero]

/-- **`(8)`: the quenched decomposition.** -/
theorem liouvilleFlow_decomposition (lam : n → ℝ) (t : ℝ) :
    liouvilleFlow lam t
      = zeroSpectralProj lam
        + liouvilleFlow lam t * (1 - zeroSpectralProj lam) := by
  rw [Matrix.mul_sub, Matrix.mul_one, liouvilleFlow_mul_zeroSpectralProj]
  abel

omit [Fintype n] in
/-- The flow minus the projection is supported on the nonzero spectrum. -/
theorem liouvilleFlow_sub_zeroSpectralProj (lam : n → ℝ) (t : ℝ) :
    liouvilleFlow lam t - zeroSpectralProj lam
      = Matrix.diagonal fun j =>
          if lam j = 0 then 0 else Complex.exp (-((t * lam j : ℝ) : ℂ) * Complex.I) := by
  rw [liouvilleFlow, zeroSpectralProj]
  ext i j
  by_cases hij : i = j
  · subst hij
    rw [Matrix.sub_apply, Matrix.diagonal_apply_eq, Matrix.diagonal_apply_eq,
      Matrix.diagonal_apply_eq]
    by_cases hj : lam i = 0
    · rw [if_pos hj, if_pos hj, hj]
      norm_num
    · rw [if_neg hj, if_neg hj, sub_zero]
  · rw [Matrix.sub_apply, Matrix.diagonal_apply_ne _ hij, Matrix.diagonal_apply_ne _ hij,
      Matrix.diagonal_apply_ne _ hij, sub_zero]

/-- **`(9)`, the Hilbert--Schmidt half.**  The energy of `e^{-itL} - P` is the number of nonzero
modes, at every time. -/
theorem hsSqRe_liouvilleFlow_sub_zeroSpectralProj (lam : n → ℝ) (t : ℝ) :
    hsSqRe (liouvilleFlow lam t - zeroSpectralProj lam)
      = ((Finset.univ.filter fun j => lam j ≠ 0).card : ℝ) := by
  classical
  rw [liouvilleFlow_sub_zeroSpectralProj, hsSqRe_diagonal]
  rw [Finset.sum_congr rfl fun j _ =>
    show ‖if lam j = 0 then (0 : ℂ)
        else Complex.exp (-((t * lam j : ℝ) : ℂ) * Complex.I)‖ ^ 2
      = if lam j ≠ 0 then (1 : ℝ) else 0 from by
      by_cases hj : lam j = 0
      · rw [if_pos hj, if_neg (by simpa using hj)]
        norm_num
      · rw [if_neg hj, if_pos hj, norm_exp_neg_ofReal_mul_I]
        norm_num]
  rw [Finset.sum_ite, Finset.sum_const, Finset.sum_const]
  simp

/-- **`(9)`, the operator half.**  A nonzero mode gives a unit vector that `e^{-itL} - P` moves
without shrinking, so the operator norm is one. -/
theorem exists_unit_vector_liouvilleFlow_sub (lam : n → ℝ) (t : ℝ) {j : n} (hj : lam j ≠ 0) :
    ∑ l, ‖((liouvilleFlow lam t - zeroSpectralProj lam) *ᵥ
      (fun i => if i = j then (1 : ℂ) else 0)) l‖ ^ 2 = 1 := by
  classical
  have hentry : ∀ l : n,
      ((liouvilleFlow lam t - zeroSpectralProj lam) *ᵥ
        (fun i => if i = j then (1 : ℂ) else 0)) l
        = (if lam l = 0 then 0 else Complex.exp (-((t * lam l : ℝ) : ℂ) * Complex.I))
          * (if l = j then 1 else 0) := by
    intro l
    rw [liouvilleFlow_sub_zeroSpectralProj, Matrix.mulVec_diagonal]
  rw [Finset.sum_congr rfl fun l _ => by rw [hentry l]]
  rw [Finset.sum_eq_single j]
  · rw [if_pos rfl, if_neg hj, mul_one, norm_exp_neg_ofReal_mul_I]
    norm_num
  · intro l _ hlj
    rw [if_neg hlj, mul_zero, norm_zero]
    norm_num
  · intro h
    exact absurd (Finset.mem_univ j) h

end Quenched

end GaloisForLFunctions.HTGeometry
