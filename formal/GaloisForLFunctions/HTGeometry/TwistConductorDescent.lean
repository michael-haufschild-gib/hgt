import Mathlib

/-!
# The twist conductor and its descent

A Dirichlet series of degree `2` and integer conductor `Q` admits two moves on the parameter `α` of an
additive twist: the translation `α ↦ α + 1`, under which the twist is invariant, and the involution
`α ↦ -1/(Qα)` coming from the functional equation.  On a rational `α = A/q` in lowest terms the second
move replaces the denominator `q` by

```text
q₁ = (Q / gcd q Q) * A .
```

Two quantities govern the resulting reduction.

*The conductor.*  `twistConductor Q q = (Q / gcd q Q) * q ^ 2` is the unique weight satisfying the exact
recursion `twistConductor Q q₁ * q ^ 2 = twistConductor Q q * (Q * A ^ 2)`, with `twistConductor Q 1 = Q`.
The recursion is independent of the representative `A` of the residue class, which is forced, since the
twist itself only depends on `α` modulo one.

*The descent.*  Choosing the representative with `2 * A ≤ q` and iterating twice contracts the
denominator by the factor `Q / 4`:

```text
4 * q₂ ≤ Q * q .
```

So the reduction terminates whenever `Q ≤ 3`, and the numerical threshold `Q < 4` produced here is the
same as the discreteness threshold `√Q < 2` for the group generated by the two moves.

The engine of both statements is `gcd ((Q / gcd q Q) * A) Q = Q / gcd q Q`, valid whenever `A` is
coprime to `q`.
-/

namespace HTGeometry

/-- The denominator produced by one application of `α ↦ -1/(Qα)` to `α = A/q` in lowest terms. -/
def dualDenom (Q q A : ℕ) : ℕ := (Q / Nat.gcd q Q) * A

/-- The conductor attached to a twist by `A / q` of a degree-two series of conductor `Q`. -/
def twistConductor (Q q : ℕ) : ℕ := (Q / Nat.gcd q Q) * q ^ 2

/-- Untwisted parameter: the conductor of the series itself. -/
theorem twistConductor_one (Q : ℕ) : twistConductor Q 1 = Q := by
  simp [twistConductor]

/-- Factorisation of the conductor along `gcd q Q`. -/
theorem gcd_mul_div_gcd (q Q : ℕ) : Nat.gcd q Q * (Q / Nat.gcd q Q) = Q := by
  exact Nat.mul_div_cancel' (Nat.gcd_dvd_right q Q)

/-- **The gcd of the dual denominator with the conductor.**  One step of the involution exchanges the
two factors of `Q = gcd q Q * (Q / gcd q Q)`. -/
theorem gcd_dualDenom (Q q A : ℕ) (hcop : Nat.Coprime A q) :
    Nat.gcd (dualDenom Q q A) Q = Q / Nat.gcd q Q := by
  set g := Nat.gcd q Q with hg
  set m := Q / g with hm
  have hgm : g * m = Q := gcd_mul_div_gcd q Q
  have hcopg : Nat.Coprime A g := Nat.Coprime.coprime_dvd_right (Nat.gcd_dvd_left q Q) hcop
  have hrw : Nat.gcd (m * A) Q = Nat.gcd (m * A) (m * g) := by
    rw [mul_comm m g, hgm]
  have hone : Nat.gcd A g = 1 := hcopg
  rw [dualDenom, ← hg, ← hm, hrw, Nat.gcd_mul_left, hone, mul_one]

/-- The dual denominator is positive when the data are. -/
theorem dualDenom_pos (Q q A : ℕ) (hQ : 0 < Q) (hA : 0 < A) : 0 < dualDenom Q q A := by
  have hg : 0 < Nat.gcd q Q := Nat.gcd_pos_of_pos_right q hQ
  have hm : 0 < Q / Nat.gcd q Q := Nat.div_pos (Nat.le_of_dvd hQ (Nat.gcd_dvd_right q Q)) hg
  exact Nat.mul_pos hm hA

/-- **Exact recursion for the twist conductor.**  Passing from `α = A/q` to `-1/(Qα)` multiplies the
conductor by `Q α²`; cleared of denominators this is the displayed identity, and it does not depend on
the choice of representative `A` of the class of `α` modulo one. -/
theorem twistConductor_dualDenom (Q q A : ℕ) (hQ : 0 < Q) (hcop : Nat.Coprime A q) :
    twistConductor Q (dualDenom Q q A) * q ^ 2 = twistConductor Q q * (Q * A ^ 2) := by
  set g := Nat.gcd q Q with hg
  set m := Q / g with hm
  have hgm : g * m = Q := gcd_mul_div_gcd q Q
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_right q hQ
  have hmpos : 0 < m := Nat.div_pos (Nat.le_of_dvd hQ (Nat.gcd_dvd_right q Q)) hgpos
  have hgcd : Nat.gcd (dualDenom Q q A) Q = m := gcd_dualDenom Q q A hcop
  have hQm : Q / m = g := by
    rw [← hgm]
    exact Nat.mul_div_cancel _ hmpos
  have hd : dualDenom Q q A = m * A := rfl
  rw [twistConductor, twistConductor, hgcd, hQm, hd, ← hg, ← hm, ← hgm]
  ring

/-- **Two-step contraction, sharp form.**  Two applications of the involution bound the denominator by
`Q` times the numerator of the first parameter. -/
theorem four_mul_dualDenom_two_le_two_mul (Q q A A₁ : ℕ) (hQ : 0 < Q)
    (hcop : Nat.Coprime A q) (hrep₁ : 2 * A₁ ≤ dualDenom Q q A) :
    4 * dualDenom Q (dualDenom Q q A) A₁ ≤ Q * (2 * A) := by
  set g := Nat.gcd q Q with hg
  set m := Q / g with hm
  have hgm : g * m = Q := gcd_mul_div_gcd q Q
  have hmpos : 0 < m :=
    Nat.div_pos (Nat.le_of_dvd hQ (Nat.gcd_dvd_right q Q)) (Nat.gcd_pos_of_pos_right q hQ)
  have hgcd : Nat.gcd (dualDenom Q q A) Q = m := gcd_dualDenom Q q A hcop
  have hQm : Q / m = g := by
    rw [← hgm]
    exact Nat.mul_div_cancel _ hmpos
  have hstep : dualDenom Q (dualDenom Q q A) A₁ = g * A₁ := by
    rw [dualDenom, hgcd, hQm]
  have h1 : 4 * (g * A₁) = 2 * g * (2 * A₁) := by ring
  have h2 : 2 * g * (2 * A₁) ≤ 2 * g * (m * A) := by
    have : dualDenom Q q A = m * A := rfl
    exact Nat.mul_le_mul_left _ (this ▸ hrep₁)
  have h3 : 2 * g * (m * A) = Q * (2 * A) := by
    rw [← hgm]; ring
  rw [hstep, h1]
  exact le_trans h2 (le_of_eq h3)

/-- **Two-step contraction.**  With nearest-integer representatives `2 * A ≤ q` and `2 * A₁ ≤ q₁`, two
applications of the involution contract the denominator by the factor `Q / 4`. -/
theorem four_mul_dualDenom_two_le (Q q A A₁ : ℕ) (hQ : 0 < Q)
    (hcop : Nat.Coprime A q) (hrep : 2 * A ≤ q)
    (hrep₁ : 2 * A₁ ≤ dualDenom Q q A) :
    4 * dualDenom Q (dualDenom Q q A) A₁ ≤ Q * q :=
  le_trans (four_mul_dualDenom_two_le_two_mul Q q A A₁ hQ hcop hrep₁)
    (Nat.mul_le_mul_left _ hrep)

/-- **Descent below the threshold.**  For `Q ≤ 3` the two-step contraction is strict, so the reduction
of a rational twist parameter terminates. -/
theorem dualDenom_two_lt (Q q A A₁ : ℕ) (hQ : 0 < Q) (hQ3 : Q ≤ 3) (hq : 0 < q)
    (hcop : Nat.Coprime A q) (hrep : 2 * A ≤ q)
    (hrep₁ : 2 * A₁ ≤ dualDenom Q q A) :
    dualDenom Q (dualDenom Q q A) A₁ < q := by
  have hmain := four_mul_dualDenom_two_le Q q A A₁ hQ hcop hrep hrep₁
  have hle : Q * q ≤ 3 * q := Nat.mul_le_mul_right q hQ3
  have h4 : 4 * dualDenom Q (dualDenom Q q A) A₁ ≤ 3 * q := le_trans hmain hle
  by_contra hcon
  have hge : q ≤ dualDenom Q (dualDenom Q q A) A₁ := Nat.le_of_not_lt hcon
  have : 4 * q ≤ 3 * q := le_trans (Nat.mul_le_mul_left 4 hge) h4
  omega

/-- **Descent at the threshold `Q = 4` for odd denominators.**  An odd `q` forces the strict inequality
`2 * A < q`, which restores the contraction. -/
theorem dualDenom_two_lt_four_of_odd (q A A₁ : ℕ) (hodd : ¬ 2 ∣ q)
    (hcop : Nat.Coprime A q) (hrep : 2 * A ≤ q)
    (hrep₁ : 2 * A₁ ≤ dualDenom 4 q A) :
    dualDenom 4 (dualDenom 4 q A) A₁ < q := by
  have hmain := four_mul_dualDenom_two_le_two_mul 4 q A A₁ (by norm_num) hcop hrep₁
  have hstrict : 2 * A < q := lt_of_le_of_ne hrep (fun h => hodd ⟨A, h.symm⟩)
  omega

/-- **No self-referential class at `Q = 2`.**  A class fixed by `α ↦ -1/(Qα)` modulo one satisfies
`Qα² - Qnα + 1 = 0`, so its rationality forces `Q(Qn² - 4)` to be a square.  At `Q = 2` this is
`4n² - 8 = m²`, which has no integral solution: modulo `16` the left side is `8` or `12`, and neither
is a square. -/
theorem no_fixed_class_two (n m : ℤ) : 4 * n ^ 2 - 8 ≠ m ^ 2 := by
  intro h
  have h16 : ((4 * n ^ 2 - 8 : ℤ) : ZMod 16) = ((m ^ 2 : ℤ) : ZMod 16) := by
    rw [h]
  push_cast at h16
  revert h16
  generalize ((n : ℤ) : ZMod 16) = a
  generalize ((m : ℤ) : ZMod 16) = b
  revert a b
  decide

/-- **No self-referential class at `Q = 3`.**  Here the equation is `9n² - 12 = m²`, excluded modulo
`9`: the left side is `6`, which is not a square. -/
theorem no_fixed_class_three (n m : ℤ) : 9 * n ^ 2 - 12 ≠ m ^ 2 := by
  intro h
  have h9 : ((9 * n ^ 2 - 12 : ℤ) : ZMod 9) = ((m ^ 2 : ℤ) : ZMod 9) := by
    rw [h]
  push_cast at h9
  revert h9
  generalize ((n : ℤ) : ZMod 9) = a
  generalize ((m : ℤ) : ZMod 9) = b
  revert a b
  decide

/-- At the threshold `Q = 4` the contraction is no longer strict: the class of `1/2` is fixed by the
involution, since `dualDenom 4 2 1 = 2`. -/
theorem dualDenom_four_two_one : dualDenom 4 2 1 = 2 := by
  norm_num [dualDenom]

end HTGeometry
