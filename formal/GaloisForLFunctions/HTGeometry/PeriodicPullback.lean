import GaloisForLFunctions.HTGeometry.PeriodicCohomology

/-!
# Pullback of periodic forms along a lattice map

A linear map of coordinate spaces carrying the period lattice into the period lattice is the lift of
a homomorphism of tori, and pullback of forms along it preserves periodicity, class `C^(1 : ℕ)`,
closedness and exactness.  So it induces a map of the periodic de Rham complexes and of their
cohomology, and on classes of constant forms it is composition with the linear map.  This is the
naturality that turns the comparison of the cohomology of a torus with the exterior power into a map
of directed systems.

* `periodLattice` : the lattice generated by the period vectors.
* `linearPullback` : the pullback of a form along a linear map.
* `linearPullback_extDeriv` : the pullback commutes with the exterior derivative.
* `periodicCohomologyMap` : the induced map on cohomology.
* `periodicCohomologyMap_constantClass` : it sends the class of a constant form to the class of its
  composition with the linear map.
-/

set_option maxSynthPendingDepth 3

namespace GaloisForLFunctions.HTGeometry

open ContinuousAlternatingMap

section PeriodLattice

variable {𝕜 : Type*} [RCLike 𝕜] {r : ℕ} {X : Type*} [NormedAddCommGroup X] [NormedSpace 𝕜 X]

/-- **The period lattice** of a coordinate space: the subgroup generated by the period vectors of
the coordinate directions. -/
def periodLattice (p : 𝕜) (r : ℕ) : AddSubgroup (Fin r → 𝕜) :=
  AddSubgroup.closure (Set.range fun i : Fin r => p • (Pi.single i (1 : 𝕜) : Fin r → 𝕜))

theorem periodVector_mem_periodLattice (p : 𝕜) (i : Fin r) :
    p • (Pi.single i (1 : 𝕜) : Fin r → 𝕜) ∈ periodLattice p r :=
  AddSubgroup.subset_closure ⟨i, rfl⟩

omit [NormedAddCommGroup X] [NormedSpace 𝕜 X] in
/-- **A map periodic in every coordinate is invariant under the whole period lattice.** -/
theorem periodic_of_mem_periodLattice {p : 𝕜} {β : (Fin r → 𝕜) → X}
    (hper : ∀ (l : Fin r) (w : Fin r → 𝕜), β (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = β w)
    {c : Fin r → 𝕜} (hc : c ∈ periodLattice p r) (w : Fin r → 𝕜) : β (w + c) = β w := by
  induction hc using AddSubgroup.closure_induction generalizing w with
  | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hper i w
  | zero => rw [add_zero]
  | add x y _ _ hx hy =>
      rw [← add_assoc, hy (w + x), hx w]
  | neg x _ hx =>
      have h := hx (w + -x)
      rw [add_assoc, neg_add_cancel, add_zero] at h
      exact h.symm

end PeriodLattice

section LinearPullback

variable {𝕜 : Type*} [RCLike 𝕜] {r s n : ℕ}

/-- **The pullback of a form along a linear map of coordinate spaces.** -/
noncomputable def linearPullback (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (ω : PeriodicFormSpace 𝕜 s n) : PeriodicFormSpace 𝕜 r n :=
  fun w => (ω (T w)).compContinuousLinearMap T

theorem linearPullback_apply (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜)) (ω : PeriodicFormSpace 𝕜 s n)
    (w : Fin r → 𝕜) :
    linearPullback T ω w = compContinuousLinearMapCLM (F := 𝕜) T (ω (T w)) := rfl

theorem linearPullback_add (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (ω₁ ω₂ : PeriodicFormSpace 𝕜 s n) :
    linearPullback T (ω₁ + ω₂) = linearPullback T ω₁ + linearPullback T ω₂ := by
  funext w
  show compContinuousLinearMapCLM (F := 𝕜) T (ω₁ (T w) + ω₂ (T w)) =
    compContinuousLinearMapCLM (F := 𝕜) T (ω₁ (T w)) + compContinuousLinearMapCLM (F := 𝕜) T (ω₂ (T w))
  rw [map_add]

theorem linearPullback_smul (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜)) (c : 𝕜)
    (ω : PeriodicFormSpace 𝕜 s n) :
    linearPullback T (c • ω) = c • linearPullback T ω := by
  funext w
  show compContinuousLinearMapCLM (F := 𝕜) T (c • ω (T w)) =
    c • compContinuousLinearMapCLM (F := 𝕜) T (ω (T w))
  rw [map_smul]

/-- The pullback of a differentiable form is differentiable. -/
theorem linearPullback_differentiable (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    {ω : PeriodicFormSpace 𝕜 s n} (hω : Differentiable 𝕜 ω) :
    Differentiable 𝕜 (linearPullback T ω) := by
  intro w
  have hinner : DifferentiableAt 𝕜 (fun y : Fin r → 𝕜 => ω (T y)) w :=
    ((hω (T w)).hasFDerivAt.comp w T.hasFDerivAt).differentiableAt
  have h : DifferentiableAt 𝕜
      (fun y : Fin r → 𝕜 => compContinuousLinearMapCLM (F := 𝕜) T (ω (T y))) w :=
    ((compContinuousLinearMapCLM (F := 𝕜) T).differentiableAt).comp w hinner
  exact h

/-- The derivative of the pullback is the pullback of the derivative. -/
theorem linearPullback_fderiv (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    {ω : PeriodicFormSpace 𝕜 s n} (hω : Differentiable 𝕜 ω) (w : Fin r → 𝕜) :
    fderiv 𝕜 (linearPullback T ω) w =
      (compContinuousLinearMapCLM (F := 𝕜) T).comp ((fderiv 𝕜 ω (T w)).comp T) := by
  have hinner : HasFDerivAt (fun y : Fin r → 𝕜 => ω (T y)) ((fderiv 𝕜 ω (T w)).comp T) w :=
    ((hω (T w)).hasFDerivAt).comp w (T.hasFDerivAt)
  exact (((compContinuousLinearMapCLM (F := 𝕜) T).hasFDerivAt).comp w hinner).fderiv

/-- The pullback of a form of class `C^(1 : ℕ)` is of class `C^(1 : ℕ)`. -/
theorem linearPullback_fderiv_continuous (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    {ω : PeriodicFormSpace 𝕜 s n} (hω : Differentiable 𝕜 ω) (hcont : Continuous (fderiv 𝕜 ω)) :
    Continuous (fderiv 𝕜 (linearPullback T ω)) := by
  have hfun : fderiv 𝕜 (linearPullback T ω) =
      fun w => (compContinuousLinearMapCLM (F := 𝕜) T).comp ((fderiv 𝕜 ω (T w)).comp T) := by
    funext w
    exact linearPullback_fderiv T hω w
  rw [hfun]
  have hstep : Continuous fun w : Fin r → 𝕜 => (fderiv 𝕜 ω (T w)).comp T :=
    isBoundedBilinearMap_comp.continuous.comp ((hcont.comp T.continuous).prodMk continuous_const)
  exact isBoundedBilinearMap_comp.continuous.comp (continuous_const.prodMk hstep)

/-- **The pullback along a linear map commutes with the exterior derivative.** -/
theorem linearPullback_extDeriv (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    {ω : PeriodicFormSpace 𝕜 s n} (hω : Differentiable 𝕜 ω) (w : Fin r → 𝕜) :
    extDeriv (linearPullback T ω) w = linearPullback T (extDeriv ω) w := by
  have hfd : ∀ x : Fin r → 𝕜, fderiv 𝕜 (fun y : Fin r → 𝕜 => T y) x = T := fun x => T.fderiv
  have hpull : (fun x : Fin r → 𝕜 =>
      (ω (T x)).compContinuousLinearMap (fderiv 𝕜 (fun y : Fin r → 𝕜 => T y) x)) =
      linearPullback T ω := by
    funext x
    rw [hfd x]
    rfl
  have h := extDeriv_pullback (𝕜 := 𝕜) (ω := ω) (f := fun y : Fin r → 𝕜 => T y) (x := w)
    (r := ⊤) (hω (T w)) (T.contDiff.contDiffAt) le_top
  rw [hpull, hfd w] at h
  exact h

/-- The pullback of a form periodic in every coordinate along a map of lattices is again periodic in
every coordinate. -/
theorem linearPullback_periodic {p : 𝕜} (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s)
    {ω : PeriodicFormSpace 𝕜 s n}
    (hper : ∀ (l : Fin s) (w : Fin s → 𝕜), ω (w + p • (Pi.single l (1 : 𝕜) : Fin s → 𝕜)) = ω w)
    (l : Fin r) (w : Fin r → 𝕜) :
    linearPullback T ω (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) = linearPullback T ω w := by
  show (ω (T (w + p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)))).compContinuousLinearMap T =
    (ω (T w)).compContinuousLinearMap T
  rw [map_add, periodic_of_mem_periodLattice hper (hT l) (T w)]

end LinearPullback

section CohomologyFunctor

variable {𝕜 : Type*} [RCLike 𝕜] {r s n : ℕ}

/-- The pullback of a closed periodic form of class `C^(1 : ℕ)` is one. -/
theorem linearPullback_mem_closed {p : 𝕜} (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s)
    {ω : PeriodicFormSpace 𝕜 s n} (hω : ω ∈ periodicClosedForms p s n) :
    linearPullback T ω ∈ periodicClosedForms p r n := by
  obtain ⟨hdiff, hcont, hper, hclosed⟩ := hω
  refine ⟨linearPullback_differentiable T hdiff,
    linearPullback_fderiv_continuous T hdiff hcont,
    linearPullback_periodic T hT hper, fun w => ?_⟩
  rw [linearPullback_extDeriv T hdiff]
  show (extDeriv ω (T w)).compContinuousLinearMap T = 0
  rw [hclosed (T w)]
  ext v
  rfl

/-- **The pullback of periodic closed forms along a map of lattices**, as a linear map. -/
noncomputable def periodicPullbackMap (p : 𝕜) (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s) (n : ℕ) :
    (periodicClosedForms p s n) →ₗ[𝕜] (periodicClosedForms p r n) where
  toFun ω := ⟨linearPullback T (ω : PeriodicFormSpace 𝕜 s n), linearPullback_mem_closed T hT ω.2⟩
  map_add' _ _ := Subtype.ext (linearPullback_add T _ _)
  map_smul' c _ := Subtype.ext (linearPullback_smul T c _)

/-- **The map induced on the cohomology of the torus by a map of lattices.** -/
noncomputable def periodicCohomologyMap (p : 𝕜) (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s) (n : ℕ) :
    periodicCohomology p s n →ₗ[𝕜] periodicCohomology p r n :=
  Submodule.mapQ _ _ (periodicPullbackMap p T hT (n + 1)) (by
    rintro ω ⟨θ, hθdiff, hθcont, hθper, hθeq⟩
    refine ⟨linearPullback T θ, linearPullback_differentiable T hθdiff,
      linearPullback_fderiv_continuous T hθdiff hθcont,
      linearPullback_periodic T hT hθper, fun w => ?_⟩
    rw [linearPullback_extDeriv T hθdiff]
    show ((ω : PeriodicFormSpace 𝕜 s (n + 1)) (T w)).compContinuousLinearMap T =
      (extDeriv θ (T w)).compContinuousLinearMap T
    rw [hθeq (T w)])

/-- **The induced map sends the class of a constant form to the class of its composition with the
linear map**: the comparison of the cohomology with the constant forms is natural. -/
theorem periodicCohomologyMap_constantClass {p : 𝕜} (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s) (n : ℕ)
    (α : (Fin s → 𝕜) [⋀^Fin (n + 1)]→L[𝕜] 𝕜) :
    periodicCohomologyMap p T hT n (constantClass p s n α) =
      constantClass p r n (α.compContinuousLinearMap T) := by
  refine congrArg Submodule.Quotient.mk (Subtype.ext ?_)
  funext w
  rfl

end CohomologyFunctor

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

section Functoriality

variable {𝕜 : Type*} [RCLike 𝕜] {r s t n : ℕ}

open ContinuousAlternatingMap

/-- A map of lattices carries the whole period lattice into the period lattice. -/
theorem map_periodLattice {p : 𝕜} (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s)
    {c : Fin r → 𝕜} (hc : c ∈ periodLattice p r) : T c ∈ periodLattice p s := by
  induction hc using AddSubgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hT i
  | zero => rw [_root_.map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | neg x _ hx => rw [map_neg]; exact neg_mem hx

/-- Pullback of forms is functorial. -/
theorem linearPullback_comp (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (T' : (Fin t → 𝕜) →L[𝕜] (Fin r → 𝕜)) (ω : PeriodicFormSpace 𝕜 s n) :
    linearPullback (T.comp T') ω = linearPullback T' (linearPullback T ω) := by
  funext w
  ext v
  rfl

theorem linearPullback_id (ω : PeriodicFormSpace 𝕜 r n) :
    linearPullback (ContinuousLinearMap.id 𝕜 (Fin r → 𝕜)) ω = ω := by
  funext w
  ext v
  rfl

/-- **The map induced on cohomology by the identity is the identity.** -/
theorem periodicCohomologyMap_id {p : 𝕜}
    (hT : ∀ l : Fin r, (ContinuousLinearMap.id 𝕜 (Fin r → 𝕜))
      (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p r) (n : ℕ) :
    periodicCohomologyMap p (ContinuousLinearMap.id 𝕜 (Fin r → 𝕜)) hT n = LinearMap.id := by
  refine LinearMap.ext fun ξ => ?_
  refine Quotient.inductionOn' ξ fun ω => ?_
  show Submodule.Quotient.mk _ = _
  refine congrArg Submodule.Quotient.mk (Subtype.ext ?_)
  exact linearPullback_id (ω : PeriodicFormSpace 𝕜 r (n + 1))

/-- **The maps induced on cohomology compose.** -/
theorem periodicCohomologyMap_comp {p : 𝕜} (T : (Fin r → 𝕜) →L[𝕜] (Fin s → 𝕜))
    (T' : (Fin t → 𝕜) →L[𝕜] (Fin r → 𝕜))
    (hT : ∀ l : Fin r, T (p • (Pi.single l (1 : 𝕜) : Fin r → 𝕜)) ∈ periodLattice p s)
    (hT' : ∀ l : Fin t, T' (p • (Pi.single l (1 : 𝕜) : Fin t → 𝕜)) ∈ periodLattice p r)
    (hTT' : ∀ l : Fin t, (T.comp T') (p • (Pi.single l (1 : 𝕜) : Fin t → 𝕜)) ∈
      periodLattice p s) (n : ℕ) :
    periodicCohomologyMap p (T.comp T') hTT' n =
      (periodicCohomologyMap p T' hT' n).comp (periodicCohomologyMap p T hT n) := by
  refine LinearMap.ext fun ξ => ?_
  refine Quotient.inductionOn' ξ fun ω => ?_
  show Submodule.Quotient.mk _ = _
  refine congrArg Submodule.Quotient.mk (Subtype.ext ?_)
  exact linearPullback_comp T T' (ω : PeriodicFormSpace 𝕜 s (n + 1))

end Functoriality

end GaloisForLFunctions.HTGeometry
