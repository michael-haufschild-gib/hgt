import GaloisForLFunctions.HTGeometry.GammaFieldLawInstanceFree
import GaloisForLFunctions.HTGeometry.BohrModuleTheorem
import GaloisForLFunctions.HTGeometry.RationalRankFromIntegralRank
import GaloisForLFunctions.HTGeometry.VerticalPhaseRank

/-!
# The finite phase law as a statement about the Bohr–Fourier frequencies

The law bounds the rank of the frequency group of the hull.  By the module theorem that group is the
group generated by the spectrum, and a bound on its rank bounds the rational rank of the frequency
module — the invariant the law is stated with on paper: the number of rationally independent
frequencies carried by the Bohr–Fourier expansion of the solution along the line.
-/

open Filter Set Topology Function

open scoped Differential

open scoped BoundedContinuousFunction

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance ratRankLawDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance ratRankLawIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance ratRankLawDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance ratRankLawComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance ratRankLawRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

/-- **The rational rank of the frequency module is bounded by the rank of the hull frequency
group.** -/
theorem rank_bohrFrequencyModule_le_of_hull_rank_le {f : ℝ →ᵇ ℂ}
    (hf : UniformContinuous fun x => f x) (htb : HasTotallyBoundedOrbit fun x => f x) {K : ℕ}
    (h : Module.rank ℤ (bohrHullFrequencies f) ≤ (K : Cardinal)) :
    Module.rank ℚ (bohrFrequencyModule fun x => f x) ≤ (K : Cardinal) := by
  rw [bohrFrequencyModule]
  refine rank_span_rat_le_of_rank_closure_le ?_
  rw [← bohrHullFrequencies_eq_closure_bohrSpectrum hf htb]
  exact h

/-- **The finite phase law, in frequency-module form.**  A relation with coefficients in the
differential field generated by `Γ` over `ℂ(s)` forces the Bohr–Fourier expansion of the solution
along the line to carry only finitely many rationally independent frequencies. -/
theorem finite_rational_phase_rank_of_gammaField_relation {n N : ℕ} {σ R rr ρ : ℝ} (hσ : 0 < σ)
    (hN : 0 < N) (hr : 0 < rr) (hρ : 0 < ρ) (hrρ : rr + ρ < R) (hR : 0 < R) {Φ : ℂ → ℂ}
    (hΦ : DifferentiableOn ℂ Φ (verticalStrip σ R)) (hap : IsStripAlmostPeriodic Φ σ R)
    (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (Ψ : upperEndAnalyticSubring)
    (hΨ : upperEndAnalyticSubring.subtype Ψ = Germ.coeRingHom upperEndFilter Φ)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialAdjoin (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0)
    (hrel : ∑ α : Fin N, x α * ∏ i : Fin (n + 1),
      (differentialJet (i : ℕ)
        (algebraMap upperEndAnalyticSubring upperEndMeroField Ψ)) ^ (e α i) = 0)
    {f : ℝ →ᵇ ℂ} (hf : ∀ y : ℝ, f y = Φ ((σ : ℂ) + (y : ℂ) * Complex.I))
    (hfu : UniformContinuous (fun y => f y)) (hftb : HasTotallyBoundedOrbit (fun y => f y)) :
    ∃ K : ℕ, Module.rank ℚ (bohrFrequencyModule fun y => f y) ≤ (K : Cardinal) := by
  obtain ⟨_, _, _, _, _, K, hK⟩ := finite_phase_law_of_gammaField_relation' hσ hN hr hρ hrρ hR hΦ hap
    e he Ψ hΨ x hxmem hx0 hrel hf hfu hftb
  exact ⟨K, rank_bohrFrequencyModule_le_of_hull_rank_le hfu hftb hK⟩

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance ratRankLineDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance ratRankLineIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance ratRankLineDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance ratRankLineComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance ratRankLineRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

/-- **The finite phase law for the line restriction itself.**  No hypothesis on the restriction is
assumed: strip almost periodicity gives its almost periodicity, hence its uniform continuity and
relatively compact orbit. -/
theorem finite_rational_phase_rank_of_gammaField_relation_line {n N : ℕ} {σ R rr ρ : ℝ}
    (hσ : 0 < σ) (hN : 0 < N) (hr : 0 < rr) (hρ : 0 < ρ) (hrρ : rr + ρ < R) (hR : 0 < R)
    {Φ : ℂ → ℂ}
    (hΦ : DifferentiableOn ℂ Φ (verticalStrip σ R)) (hap : IsStripAlmostPeriodic Φ σ R)
    (e : Fin N → Fin (n + 1) → ℕ) (he : Function.Injective e)
    (Ψ : upperEndAnalyticSubring)
    (hΨ : upperEndAnalyticSubring.subtype Ψ = Germ.coeRingHom upperEndFilter Φ)
    (x : Fin N → upperEndMeroField)
    (hxmem : ∀ α, x α ∈ differentialAdjoin (RatFunc ℂ)
      ({gammaUpperMero} : Set upperEndMeroField))
    (hx0 : ∀ α, x α ≠ 0)
    (hrel : ∑ α : Fin N, x α * ∏ i : Fin (n + 1),
      (differentialJet (i : ℕ)
        (algebraMap upperEndAnalyticSubring upperEndMeroField Ψ)) ^ (e α i) = 0) :
    ∃ K : ℕ, Module.rank ℚ
        (bohrFrequencyModule fun y : ℝ => Φ ((σ : ℂ) + (y : ℂ) * Complex.I))
      ≤ (K : Cardinal) := by
  classical
  have hf : ∀ y : ℝ, (verticalRestriction Φ hR hΦ hap) y
      = Φ ((σ : ℂ) + (y : ℂ) * Complex.I) := fun y => rfl
  set f : ℝ →ᵇ ℂ := verticalRestriction Φ hR hΦ hap with hfdef
  have hfun : (fun y : ℝ => (f y : ℂ))
      = fun t : ℝ => Φ ((σ : ℂ) + (t : ℂ) * Complex.I) := funext hf
  have hcont : Continuous fun y : ℝ => (f y : ℂ) := f.continuous
  have hapline : _root_.HTGeometry.IsBohrAlmostPeriodic fun y : ℝ => (f y : ℂ) := by
    rw [hfun]
    exact isBohrAlmostPeriodic_line hR hap
  have hfu : UniformContinuous fun y : ℝ => (f y : ℂ) :=
    uniformContinuous_of_isBohrAlmostPeriodic hcont hapline
  have hftb : HasTotallyBoundedOrbit fun y : ℝ => (f y : ℂ) :=
    hasTotallyBoundedOrbit_of_isBohrAlmostPeriodic hcont hapline
  obtain ⟨K, hK⟩ := finite_rational_phase_rank_of_gammaField_relation hσ hN hr hρ hrρ hR hΦ hap
    e he Ψ hΨ x hxmem hx0 hrel hf hfu hftb
  refine ⟨K, ?_⟩
  rw [← hfun]
  exact hK

end

end GaloisForLFunctions.HTGeometry
