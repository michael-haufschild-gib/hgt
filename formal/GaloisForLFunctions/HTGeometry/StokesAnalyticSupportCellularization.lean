import GaloisForLFunctions.HTGeometry.StokesAnalyticWallMicrostalkFunctor

/-!
# Cellularization of analytic zero-level exponential support

Canonical midpoints of the chambers between consecutive analytic Stokes walls detect the sign of
the intrinsic dominance phase. The zero-level compactified exponential epigraph therefore selects
exactly the active Boolean arcs of the cyclic cellular model. Lifting this support-indexed quiver
recovers the existing global exponential boundary, including for actual Puiseux branch pairs.
-/

open CategoryTheory Topology

namespace GaloisForLFunctions.IrregularStokes.AnalyticSupportCellularization

open AnalyticWall AnalyticMicrolocal CellularMicrolocal CellularStokesCategory
open EnhancedExponential

/-- Canonical midpoint of the chamber beginning at a labelled analytic Stokes wall. -/
noncomputable def labelledArcMidpoint (c : ℂ) {k : ℕ} (hk : 0 < k)
    (w : StokesWall k) : Real.Angle :=
  labelledWallAngle c hk w + (((Real.pi / (2 * k : ℝ) : ℝ)) : Real.Angle)

/-- Phase argument at a chamber midpoint is the wall target shifted by one quarter-turn. -/
theorem labelledArcMidpoint_phase_argument (c : ℂ) {k : ℕ} (hk : 0 < k)
    (w : StokesWall k) :
    (((Complex.arg c : ℝ) : Real.Angle) - k • labelledArcMidpoint c hk w) =
      ((branchTarget w.2 : ℝ) : Real.Angle) -
        (((Real.pi / 2 : ℝ)) : Real.Angle) := by
  have hk0 : (k : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
  have hhalf :
      k • (((Real.pi / (2 * k : ℝ) : ℝ)) : Real.Angle) =
        (((Real.pi / 2 : ℝ)) : Real.Angle) := by
    rw [← Real.Angle.coe_nsmul]
    apply congrArg ((↑) : ℝ → Real.Angle)
    simp only [nsmul_eq_mul]
    field_simp
  rw [labelledArcMidpoint, nsmul_add, hhalf,
    show (((Complex.arg c : ℝ) : Real.Angle) -
        (k • labelledWallAngle c hk w + (((Real.pi / 2 : ℝ)) : Real.Angle))) =
      ((((Complex.arg c : ℝ) : Real.Angle) - k • labelledWallAngle c hk w) -
        (((Real.pi / 2 : ℝ)) : Real.Angle)) by abel,
    labelledWallAngle_phase_argument]

/-- Chamber-midpoint phase is positive on inactive arcs and negative on active arcs. -/
theorem stokesPhase_labelledArcMidpoint (c : ℂ) {k : ℕ} (hk : 0 < k)
    (w : StokesWall k) :
    stokesPhase c k (labelledArcMidpoint c hk w) =
      if w.2 then -‖c‖ else ‖c‖ := by
  rw [stokesPhase, labelledArcMidpoint_phase_argument c hk w]
  cases w.2
  · rw [branchTarget, ← Real.Angle.coe_sub, Real.Angle.cos_coe]
    simp
  · rw [branchTarget, ← Real.Angle.coe_sub, Real.Angle.cos_coe]
    rw [show -Real.pi / 2 - Real.pi / 2 = -Real.pi by ring,
      Real.cos_neg, Real.cos_pi]
    simp

/-- A chamber midpoint belongs to zero-level epigraph support exactly when its arc is active. -/
theorem labelledArcMidpoint_mem_zeroLevel_iff (c : ℂ) {k : ℕ} (hk : 0 < k)
    (hc : c ≠ 0) (w : StokesWall k) :
    compactifiedExponentialEpigraph (stokesPhase c k)
        (labelledArcMidpoint c hk w, ((0 : ℝ) : EReal)) ↔ w.2 = true := by
  rw [compactifiedExponentialEpigraph_coe,
    stokesPhase_labelledArcMidpoint c hk w]
  cases w.2
  · simp only [Bool.false_eq_true, if_false, iff_false]
    exact not_le_of_gt (norm_pos_iff.mpr hc)
  · simp [norm_nonneg]

/-- Boolean activity read directly from zero-level compactified exponential support. -/
noncomputable def zeroLevelArcActive (c : ℂ) {k : ℕ} (hk : 0 < k)
    (w : StokesWall k) : Bool := by
  classical
  exact decide (compactifiedExponentialEpigraph (stokesPhase c k)
    (labelledArcMidpoint c hk w, ((0 : ℝ) : EReal)))

/-- Support-defined activity equals the analytic wall's alternating Boolean label. -/
@[simp]
theorem zeroLevelArcActive_eq (c : ℂ) {k : ℕ} (hk : 0 < k)
    (hc : c ≠ 0) (w : StokesWall k) :
    zeroLevelArcActive c hk w = w.2 := by
  classical
  cases h : w.2
  · have hn : ¬compactifiedExponentialEpigraph (stokesPhase c k)
        (labelledArcMidpoint c hk w, ((0 : ℝ) : EReal)) := by
      intro hm
      have := (labelledArcMidpoint_mem_zeroLevel_iff c hk hc w).mp hm
      simp [h] at this
    unfold zeroLevelArcActive
    rw [decide_eq_false_iff_not]
    simpa only [EReal.coe_zero] using hn
  · have hm : compactifiedExponentialEpigraph (stokesPhase c k)
        (labelledArcMidpoint c hk w, ((0 : ℝ) : EReal)) :=
      (labelledArcMidpoint_mem_zeroLevel_iff c hk hc w).mpr (by simp [h])
    unfold zeroLevelArcActive
    rw [decide_eq_true_eq]
    simpa only [EReal.coe_zero] using hm

/-- Cyclic boundary prefunctor generated by an arbitrary Boolean arc-activity function. -/
def activityBoundaryPrefunctor {k : ℕ} (hk : 0 < k) (d : ℕ)
    (active : StokesWall k → Bool) :
    BoundaryQuiver k hk ⥤q ModuleCat ℚ where
  obj
    | .arc w => ModuleCat.of ℚ (arcStalk d (active w))
    | .wall _ => ModuleCat.of ℚ (Fiber d)
  map := by
    intro X Y f
    change BoundaryArrow k hk X Y at f
    cases f with
    | initial w => exact ModuleCat.ofHom (restriction d (active w))
    | terminal w => exact ModuleCat.ofHom (restriction d (active w))

/-- Cyclic boundary prefunctor whose arc activity is read from analytic zero-level support. -/
noncomputable def zeroLevelSupportBoundaryPrefunctor
    (c : ℂ) {k : ℕ} (hk : 0 < k) (d : ℕ) :
    BoundaryQuiver k hk ⥤q ModuleCat ℚ :=
  activityBoundaryPrefunctor hk d (zeroLevelArcActive c hk)

/-- Analytic zero-level support recovers the standard alternating boundary prefunctor. -/
theorem zeroLevelSupportBoundaryPrefunctor_eq_boundaryPrefunctor
    (c : ℂ) {k : ℕ} (hk : 0 < k) (hc : c ≠ 0) (d : ℕ) :
    zeroLevelSupportBoundaryPrefunctor c hk d = boundaryPrefunctor k d hk := by
  have hactive : zeroLevelArcActive c hk = (fun w : StokesWall k => w.2) := by
    funext w
    exact zeroLevelArcActive_eq c hk hc w
  unfold zeroLevelSupportBoundaryPrefunctor
  rw [hactive]
  rfl

/-- Global cellular boundary obtained from analytic zero-level support activity. -/
noncomputable def zeroLevelSupportBoundary
    (c : ℂ) {k : ℕ} (hk : 0 < k) (d : ℕ) : BoundaryCategory k hk :=
  CategoryTheory.Paths.lift (zeroLevelSupportBoundaryPrefunctor c hk d)

/-- Analytic zero-level support cellularizes exactly to the global exponential boundary. -/
theorem zeroLevelSupportBoundary_eq_exponentialBoundary
    (c : ℂ) {k : ℕ} (hk : 0 < k) (hc : c ≠ 0) (d : ℕ) :
    zeroLevelSupportBoundary c hk d = exponentialBoundary k d hk := by
  unfold zeroLevelSupportBoundary exponentialBoundary
  rw [zeroLevelSupportBoundaryPrefunctor_eq_boundaryPrefunctor c hk hc d]

/-- An actual Puiseux branch pair has the support-cellularized exponential boundary of its contact
order. -/
theorem branchPairZeroLevelSupportBoundary_eq_exponentialBoundary
    {m K N : ℕ} (p : FinitePuiseuxFamily m K N)
    {i j : Fin m} (hij : i ≠ j) (d : ℕ) :
    zeroLevelSupportBoundary (branchPairLeadingCoefficient p hij)
        (p.contactNumerator_pos_of_ne hij) d =
      exponentialBoundary (p.contactNumerator i j) d
        (p.contactNumerator_pos_of_ne hij) :=
  zeroLevelSupportBoundary_eq_exponentialBoundary
    (branchPairLeadingCoefficient p hij) (p.contactNumerator_pos_of_ne hij)
      (branchPairLeadingCoefficient_ne_zero p hij) d

/-- Restriction of support-cellularized analytic data to a labelled wall is the corresponding
local exponential germ. -/
noncomputable def zeroLevelSupportBoundaryLocalGermIso
    (c : ℂ) {k : ℕ} (hk : 0 < k) (hc : c ≠ 0) (d : ℕ)
    (w : StokesWall k) :
    (localGermRestriction hk w).obj (zeroLevelSupportBoundary c hk d) ≅
      exponentialGerm d w.2 := by
  rw [zeroLevelSupportBoundary_eq_exponentialBoundary c hk hc d]
  exact localGermRestrictionExponentialIso k d hk w

/-- Wallwise microstalk of analytic zero-level support is the cellular vanishing-cycle module of
the corresponding local exponential germ. -/
noncomputable def zeroLevelSupportBoundaryWallMicrostalkIso
    (c : ℂ) {k : ℕ} (hk : 0 < k) (hc : c ≠ 0) (d : ℕ)
    (w : StokesWall k) (s : ConormalSide) :
    (wallMicrostalkFunctor hk w s).obj (zeroLevelSupportBoundary c hk d) ≅
      (microstalkFunctor s).obj (exponentialGerm d w.2) :=
  (microstalkFunctor s).mapIso
    (zeroLevelSupportBoundaryLocalGermIso c hk hc d w)

/-- Puiseux branch-pair zero-level support has the expected local wallwise vanishing-cycle
module. -/
noncomputable def branchPairZeroLevelSupportBoundaryWallMicrostalkIso
    {m K N : ℕ} (p : FinitePuiseuxFamily m K N)
    {i j : Fin m} (hij : i ≠ j) (d : ℕ)
    (w : StokesWall (p.contactNumerator i j)) (s : ConormalSide) :
    (wallMicrostalkFunctor (p.contactNumerator_pos_of_ne hij) w s).obj
        (zeroLevelSupportBoundary (branchPairLeadingCoefficient p hij)
          (p.contactNumerator_pos_of_ne hij) d) ≅
      (microstalkFunctor s).obj (exponentialGerm d w.2) :=
  zeroLevelSupportBoundaryWallMicrostalkIso
    (branchPairLeadingCoefficient p hij) (p.contactNumerator_pos_of_ne hij)
      (branchPairLeadingCoefficient_ne_zero p hij) d w s

/-- Analytic-wall microstalk ranks of the support-cellularized boundary realize the intrinsic
microlocal ranks. -/
theorem zeroLevelSupportBoundary_analyticWallMicrostalk_finrank
    (c : ℂ) {k : ℕ} (hk : 0 < k) (hc : c ≠ 0) (d : ℕ)
    (w : AnalyticStokesWall c k) (s : ConormalSide) :
    Module.finrank ℚ
        ((analyticWallMicrostalkFunctor c hk hc w s).obj
          (zeroLevelSupportBoundary c hk d)) =
      analyticMicroRank c hk hc d w s := by
  rw [zeroLevelSupportBoundary_eq_exponentialBoundary c hk hc d]
  exact exponentialBoundary_analyticWallMicrostalk_finrank c hk hc d w s

/-- For an actual Puiseux branch pair, microstalk ranks computed on its zero-level-support
cellularization equal its analytic characteristic multiplicities. -/
theorem branchPairZeroLevelSupportBoundary_analyticWallMicrostalk_finrank
    {m K N : ℕ} (p : FinitePuiseuxFamily m K N)
    {i j : Fin m} (hij : i ≠ j) (d : ℕ)
    (w : AnalyticStokesWall (branchPairLeadingCoefficient p hij)
      (p.contactNumerator i j)) (s : ConormalSide) :
    Module.finrank ℚ
        ((branchPairAnalyticWallMicrostalkFunctor p hij w s).obj
          (zeroLevelSupportBoundary (branchPairLeadingCoefficient p hij)
            (p.contactNumerator_pos_of_ne hij) d)) =
      analyticMicroRank (branchPairLeadingCoefficient p hij)
        (p.contactNumerator_pos_of_ne hij) (branchPairLeadingCoefficient_ne_zero p hij)
        d w s := by
  rw [branchPairZeroLevelSupportBoundary_eq_exponentialBoundary p hij d]
  exact branchPairAnalyticWallMicrostalk_finrank p hij d w s

end GaloisForLFunctions.IrregularStokes.AnalyticSupportCellularization
