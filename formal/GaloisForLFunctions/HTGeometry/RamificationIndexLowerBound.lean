import Mathlib.NumberTheory.RamificationInertia.Ramification
import Mathlib.RingTheory.UniqueFactorizationDomain.Basic

/-!
# A lower bound for the ramification index

mathlib's `Ideal.ramificationIdx'` carries the upper half of its defining property
(`le_pow_of_le_ramificationIdx'`) but not the lower half: that a power of the prime containing the
extended base place bounds the index from below.  Over a Dedekind domain that is the factorisation
count, and it is what an Eisenstein-type root needs.

```text
le_ramificationIdx'_of_map_le_pow           map p ≤ P^k  ⟹  k ≤ e
le_ramificationIdx'_of_map_le_span_pow      map p ≤ (z^k) with z ∈ P  ⟹  k ≤ e
isUnit_of_forall_notMem_isPrime             no nonzero prime contains it  ⟹  it is a unit
```

The last is the glue that turns "unramified at every height-one prime" into "unit discriminant":
over a unique factorisation domain a nonzero non-unit has an irreducible factor, and that factor
generates a nonzero prime containing it.

The second is the total-ramification criterion for a Kummer extension: if the base place is
generated by `c = z^k` and `z` lies in the prime above, the place is ramified to order at least `k`,
hence — when `k` is the degree — totally ramified.
-/

namespace GaloisForLFunctions.HTGeometry

open Ideal UniqueFactorizationMonoid


/-- **A power of a prime above a place bounds the ramification index from below.** -/
theorem le_ramificationIdx'_of_map_le_pow {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [IsDedekindDomain S] {p : Ideal R} {P : Ideal S} (hP : P.IsPrime) (hP0 : P ≠ ⊥)
    (hp0 : p.map (algebraMap R S) ≠ ⊥) {k : ℕ}
    (hk : p.map (algebraMap R S) ≤ P ^ k) :
    k ≤ Ideal.ramificationIdx' p P := by
  classical
  rw [Ideal.IsDedekindDomain.ramificationIdx'_eq_normalizedFactors_count hp0 hP hP0]
  have hPirr := (Ideal.prime_of_isPrime hP0 hP).irreducible
  have hdvd : P ^ k ∣ p.map (algebraMap R S) := Ideal.dvd_iff_le.mpr hk
  rw [dvd_iff_normalizedFactors_le_normalizedFactors (pow_ne_zero _ hP0) hp0,
    normalizedFactors_pow, normalizedFactors_irreducible hPirr, normalize_eq,
    Multiset.nsmul_singleton, ← Multiset.le_count_iff_replicate_le] at hdvd
  exact hdvd

/-- **An Eisenstein-type place is ramified to at least the root order.**  If the base place maps
into the ideal generated by `z ^ k` and `z` lies in the prime above, the ramification index is at
least `k`. -/
theorem le_ramificationIdx'_of_map_le_span_pow {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [IsDedekindDomain S] {p : Ideal R} {P : Ideal S} (hP : P.IsPrime) (hP0 : P ≠ ⊥)
    (hp0 : p.map (algebraMap R S) ≠ ⊥) {k : ℕ} {z : S} (hz : z ∈ P)
    (hk : p.map (algebraMap R S) ≤ Ideal.span {z ^ k}) :
    k ≤ Ideal.ramificationIdx' p P := by
  refine le_ramificationIdx'_of_map_le_pow hP hP0 hp0 (hk.trans ?_)
  rw [Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.pow_mem_pow hz k

/-- **In a unique factorisation domain, a nonzero element lying in no nonzero prime ideal is a
unit.**  A nonzero non-unit has an irreducible factor, and that factor generates a nonzero prime
containing it. -/
theorem isUnit_of_forall_notMem_isPrime {R : Type*} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] {d : R} (hd : d ≠ 0)
    (h : ∀ P : Ideal R, P.IsPrime → P ≠ ⊥ → d ∉ P) : IsUnit d := by
  by_contra hu
  obtain ⟨q, hq⟩ := UniqueFactorizationMonoid.exists_mem_factors hd hu
  have hqp : Prime q := UniqueFactorizationMonoid.prime_of_factor q hq
  have hqd : q ∣ d := UniqueFactorizationMonoid.dvd_of_mem_factors hq
  have hP : (Ideal.span {q}).IsPrime := (Ideal.span_singleton_prime hqp.ne_zero).mpr hqp
  have hPne : Ideal.span {q} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact hqp.ne_zero
  exact h _ hP hPne (Ideal.mem_span_singleton.mpr hqd)

end GaloisForLFunctions.HTGeometry
