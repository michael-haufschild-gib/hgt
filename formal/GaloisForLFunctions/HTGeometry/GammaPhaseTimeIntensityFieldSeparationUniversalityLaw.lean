import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicBaseChange
import GaloisForLFunctions.HTGeometry.ExponentialObservationHypertranscendence
import GaloisForLFunctions.HTGeometry.FiniteAlgebraicStateBoundary
import GaloisForLFunctions.HTGeometry.GammaReflectedIntensityExactCollapseUniversalityLaw
import GaloisForLFunctions.HTGeometry.WignerSmithLogClockObservability
import GaloisForLFunctions.HTGeometry.UnivMeroFieldInstances

/-!
# Gamma phase--time/intensity field-separation universality

For an arbitrary family of opposite-orientation Gamma scattering channels, suppose every
reflected-frequency intensity lies on its exact differential-algebraic collapse locus.  Adjoining
the entire, possibly infinite, intensity atlas to the rational coordinate field still leaves every
orientation-sensitive phase and every logarithmic Wigner--Smith current hypertranscendental.

This is stronger than a finite-expression no-go: the target satisfies no algebraic differential
equation over the full differential field generated by all collapsed intensities.
-/

open Filter Set Topology Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher Polynomial

noncomputable section

open scoped UnivMeroFieldInstances

/-- Exact arithmetic collapse condition for the reflected intensity of an opposite-orientation
Gamma channel. -/
def GammaOppositeShiftIntensityCollapse (a b : ℂ) : Prop :=
  (∃ k : ℤ, b - a = (k : ℂ)) ∨
    ((∃ k : ℤ, 1 - 2 * a = (k : ℂ)) ∧
      ∃ k : ℤ, 1 - 2 * b = (k : ℂ))

/-- Reflected intensities are differentially algebraic exactly on the arithmetic collapse locus. -/
theorem differentialAlgebraicOver_gammaOppositeShiftIntensityMero_iff_collapse
    (a b : ℂ) :
    DifferentialAlgebraicOver (RatFunc ℂ)
        (gammaOppositeShiftIntensityMero a b) ↔
      GammaOppositeShiftIntensityCollapse a b := by
  exact differentialAlgebraicOver_gammaOppositeShiftIntensityMero_iff_exactCollapse a b

/-- Reflected-intensity atlas of an arbitrary family of opposite-orientation Gamma channels. -/
def gammaOppositeShiftIntensityAtlas
    {ι : Type*} (a b : ι → ℂ) (i : ι) : meroField Set.univ :=
  gammaOppositeShiftIntensityMero (a i) (b i)

/-- Orientation-sensitive phase atlas of the same Gamma family. -/
def gammaOppositeShiftPhaseAtlas
    {ι : Type*} (a b : ι → ℂ) (i : ι) : meroField Set.univ :=
  gammaOppositeShiftPhaseMero (a i) (b i)

/-- Logarithmic Wigner--Smith-current atlas of the same Gamma family. -/
def gammaOppositeShiftWignerSmithAtlas
    {ι : Type*} (a b : ι → ℂ) (i : ι) : meroField Set.univ :=
  gammaOppositeShiftWignerSmithLogMero (a i) (b i)

/-- Full channel amplitude after an independently chosen elementary/DA prefactor is restored. -/
def gaugedGammaOppositeShiftAmplitudeAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge : ι → meroField Set.univ) (i : ι) : meroField Set.univ :=
  gauge i * gammaOppositeShiftQuotientMero (a i) (b i)

/-- Reflected-frequency channel after an independently chosen elementary/DA prefactor is
restored. -/
def gaugedGammaOppositeShiftReflectedAtlas
    {ι : Type*} (a b : ι → ℂ)
    (reflectedGauge : ι → meroField Set.univ) (i : ι) : meroField Set.univ :=
  reflectedGauge i * gammaOppositeShiftReflectedFrequencyMero (a i) (b i)

/-- Reflected-frequency intensity of the full, gauge-dressed channel. -/
def gaugedGammaOppositeShiftIntensityAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  gaugedGammaOppositeShiftAmplitudeAtlas a b gauge i *
    gaugedGammaOppositeShiftReflectedAtlas a b reflectedGauge i

/-- Orientation quotient of the full, gauge-dressed channel. -/
def gaugedGammaOppositeShiftPhaseAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  gaugedGammaOppositeShiftAmplitudeAtlas a b gauge i /
    gaugedGammaOppositeShiftReflectedAtlas a b reflectedGauge i

/-- Logarithmic Wigner--Smith current of the full, gauge-dressed amplitude. -/
def gaugedGammaOppositeShiftWignerSmithAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge : ι → meroField Set.univ) (i : ι) : meroField Set.univ :=
  HTGeometry.wignerSmithLogClock
    (gaugedGammaOppositeShiftAmplitudeAtlas a b gauge i)

/-- Logarithmic frequency slope of the full orientation quotient. -/
def gaugedGammaOppositeShiftPhaseSlopeAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (i : ι) : meroField Set.univ :=
  HTGeometry.wignerSmithLogClock
    (gaugedGammaOppositeShiftPhaseAtlas
      a b gauge reflectedGauge i)

/-- Full intensity is the bare Gamma intensity times the product of the two prefactors. -/
theorem gaugedGammaOppositeShiftIntensityAtlas_eq
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ) (i : ι) :
    gaugedGammaOppositeShiftIntensityAtlas a b gauge reflectedGauge i =
      (gauge i * reflectedGauge i) *
        gammaOppositeShiftIntensityAtlas a b i := by
  unfold gaugedGammaOppositeShiftIntensityAtlas
    gaugedGammaOppositeShiftAmplitudeAtlas
    gaugedGammaOppositeShiftReflectedAtlas
    gammaOppositeShiftIntensityAtlas
    gammaOppositeShiftIntensityMero
  ring

/-- Full orientation quotient is the bare Gamma phase times the quotient of the two prefactors. -/
theorem gaugedGammaOppositeShiftPhaseAtlas_eq
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hreflectedGauge : ∀ i, reflectedGauge i ≠ 0) (i : ι) :
    gaugedGammaOppositeShiftPhaseAtlas a b gauge reflectedGauge i =
      (gauge i / reflectedGauge i) *
        gammaOppositeShiftPhaseAtlas a b i := by
  unfold gaugedGammaOppositeShiftPhaseAtlas
    gaugedGammaOppositeShiftAmplitudeAtlas
    gaugedGammaOppositeShiftReflectedAtlas
    gammaOppositeShiftPhaseAtlas
    gammaOppositeShiftPhaseMero
  field_simp [hreflectedGauge i,
    gammaOppositeShiftReflectedFrequencyMero_ne_zero (a i) (b i)]

/-- Every intensity generator in a collapsed arbitrary atlas is differentially algebraic over the
rational coordinate field. -/
theorem differentialAlgebraicOver_gammaOppositeShiftIntensityAtlas
    {ι : Type*} (a b : ι → ℂ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i)) :
    ∀ i, DifferentialAlgebraicOver (RatFunc ℂ)
      (gammaOppositeShiftIntensityAtlas a b i) := by
  intro i
  exact
    (differentialAlgebraicOver_gammaOppositeShiftIntensityMero_iff_collapse
      (a i) (b i)).2 (hcollapse i)

/-- Every phase remains hypertranscendental after adjoining the full, possibly infinite, collapsed
intensity atlas. -/
theorem hypertranscendentalOver_gammaOppositeShiftPhaseAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (j : ι) :
    HypertranscendentalOver
        (differentialAdjoin (RatFunc ℂ)
          (Set.range (gammaOppositeShiftIntensityAtlas a b)))
        (gammaOppositeShiftPhaseAtlas a b j) := by
  have hIntensity :
      ∀ g ∈ Set.range (gammaOppositeShiftIntensityAtlas a b),
        DifferentialAlgebraicOver (RatFunc ℂ) g := by
    rintro g ⟨i, rfl⟩
    exact differentialAlgebraicOver_gammaOppositeShiftIntensityAtlas a b hcollapse i
  apply
    (HTGeometry.hypertranscendentalOver_differentialAdjoin_iff hIntensity).2
  exact hypertranscendentalOver_gammaOppositeShiftPhaseMero (a j) (b j)

/-- Every Wigner--Smith logarithmic current remains hypertranscendental after adjoining the full,
possibly infinite, collapsed intensity atlas. -/
theorem hypertranscendentalOver_gammaOppositeShiftWignerSmithAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (j : ι) :
    HypertranscendentalOver
        (differentialAdjoin (RatFunc ℂ)
          (Set.range (gammaOppositeShiftIntensityAtlas a b)))
        (gammaOppositeShiftWignerSmithAtlas a b j) := by
  have hIntensity :
      ∀ g ∈ Set.range (gammaOppositeShiftIntensityAtlas a b),
        DifferentialAlgebraicOver (RatFunc ℂ) g := by
    rintro g ⟨i, rfl⟩
    exact differentialAlgebraicOver_gammaOppositeShiftIntensityAtlas a b hcollapse i
  apply
    (HTGeometry.hypertranscendentalOver_differentialAdjoin_iff hIntensity).2
  exact hypertranscendentalOver_gammaOppositeShiftWignerSmithLogMero (a j) (b j)

/-- Nonzero DA prefactors do not change the exact arithmetic intensity-collapse locus. -/
theorem differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas_iff_collapse
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (i : ι) :
    DifferentialAlgebraicOver (RatFunc ℂ)
        (gaugedGammaOppositeShiftIntensityAtlas
          a b gauge reflectedGauge i) ↔
      GammaOppositeShiftIntensityCollapse (a i) (b i) := by
  rw [gaugedGammaOppositeShiftIntensityAtlas_eq]
  have hproductDA :
      DifferentialAlgebraicOver (RatFunc ℂ)
        (gauge i * reflectedGauge i) :=
    HTGeometry.differentialAlgebraicOver_mul
      (hgauge i) (hreflectedGauge i)
  have hproduct_ne : gauge i * reflectedGauge i ≠ 0 :=
    mul_ne_zero (hgauge_ne i) (hreflectedGauge_ne i)
  constructor
  · intro hfull
    by_contra hcollapse
    have hbareHT :
        HypertranscendentalOver (RatFunc ℂ)
          (gammaOppositeShiftIntensityAtlas a b i) := by
      intro hbareDA
      exact hcollapse
        ((differentialAlgebraicOver_gammaOppositeShiftIntensityMero_iff_collapse
          (a i) (b i)).1 hbareDA)
    have hfullHT :
        HypertranscendentalOver (RatFunc ℂ)
          ((gauge i * reflectedGauge i) *
            gammaOppositeShiftIntensityAtlas a b i) := by
      rw [mul_comm]
      exact
        (HTGeometry.hypertranscendentalOver_mul_differentialAlgebraic_iff
          hproductDA hproduct_ne).2 hbareHT
    exact hfullHT hfull
  · intro hcollapse
    exact HTGeometry.differentialAlgebraicOver_mul hproductDA
      ((differentialAlgebraicOver_gammaOppositeShiftIntensityMero_iff_collapse
        (a i) (b i)).2 hcollapse)

/-- A full amplitude remains HT after any nonzero DA prefactor is restored. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftAmplitudeAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (i : ι) :
    HypertranscendentalOver (RatFunc ℂ)
      (gaugedGammaOppositeShiftAmplitudeAtlas a b gauge i) := by
  rw [gaugedGammaOppositeShiftAmplitudeAtlas, mul_comm]
  exact
    (HTGeometry.hypertranscendentalOver_mul_differentialAlgebraic_iff
      (hgauge i) (hgauge_ne i)).2
      (hypertranscendentalOver_gammaOppositeShiftQuotientMero
        (a i) (b i))

/-- A full orientation quotient remains HT after independent nonzero DA prefactors are restored
in the two frequency orientations. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftPhaseAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (i : ι) :
    HypertranscendentalOver (RatFunc ℂ)
      (gaugedGammaOppositeShiftPhaseAtlas
        a b gauge reflectedGauge i) := by
  rw [gaugedGammaOppositeShiftPhaseAtlas_eq
    a b gauge reflectedGauge hreflectedGauge_ne, mul_comm]
  exact
    (HTGeometry.hypertranscendentalOver_mul_differentialAlgebraic_iff
      (HTGeometry.differentialAlgebraicOver_div
        (hgauge i) (hreflectedGauge i))
      (div_ne_zero (hgauge_ne i) (hreflectedGauge_ne i))).2
      (hypertranscendentalOver_gammaOppositeShiftPhaseMero
        (a i) (b i))

/-- A full logarithmic Wigner--Smith current remains HT after any nonzero DA prefactor is
restored. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftWignerSmithAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge : ι → meroField Set.univ)
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (i : ι) :
    HypertranscendentalOver (RatFunc ℂ)
      (gaugedGammaOppositeShiftWignerSmithAtlas a b gauge i) := by
  rw [gaugedGammaOppositeShiftWignerSmithAtlas,
    HTGeometry.hypertranscendentalOver_wignerSmithLogClock_iff]
  exact hypertranscendentalOver_gaugedGammaOppositeShiftAmplitudeAtlas
    a b gauge hgauge hgauge_ne i

/-- Every full intensity in a collapsed, arbitrarily gauge-dressed atlas is DA. -/
theorem differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0) :
    ∀ i, DifferentialAlgebraicOver (RatFunc ℂ)
      (gaugedGammaOppositeShiftIntensityAtlas
        a b gauge reflectedGauge i) := by
  intro i
  exact
    (differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas_iff_collapse
      a b gauge reflectedGauge hgauge hreflectedGauge
      hgauge_ne hreflectedGauge_ne i).2 (hcollapse i)

/-- No member of the full amplitude atlas satisfies an algebraic differential equation whose
coefficients are allowed to use the complete, possibly infinite, full intensity atlas. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftAmplitudeAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (j : ι) :
    HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftAmplitudeAtlas a b gauge j) := by
  have hIntensity :
      ∀ g ∈ Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge),
        DifferentialAlgebraicOver (RatFunc ℂ) g := by
    rintro g ⟨i, rfl⟩
    exact
      differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas
        a b gauge reflectedGauge hcollapse hgauge hreflectedGauge
        hgauge_ne hreflectedGauge_ne i
  apply
    (HTGeometry.hypertranscendentalOver_differentialAdjoin_iff
      hIntensity).2
  exact hypertranscendentalOver_gaugedGammaOppositeShiftAmplitudeAtlas
    a b gauge hgauge hgauge_ne j

/-- No member of the full phase atlas satisfies an algebraic differential equation over the
complete, possibly infinite, full intensity atlas. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftPhaseAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (j : ι) :
    HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftPhaseAtlas
        a b gauge reflectedGauge j) := by
  have hIntensity :
      ∀ g ∈ Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge),
        DifferentialAlgebraicOver (RatFunc ℂ) g := by
    rintro g ⟨i, rfl⟩
    exact
      differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas
        a b gauge reflectedGauge hcollapse hgauge hreflectedGauge
        hgauge_ne hreflectedGauge_ne i
  apply
    (HTGeometry.hypertranscendentalOver_differentialAdjoin_iff
      hIntensity).2
  exact hypertranscendentalOver_gaugedGammaOppositeShiftPhaseAtlas
    a b gauge reflectedGauge hgauge hreflectedGauge
    hgauge_ne hreflectedGauge_ne j

/-- No member of the full Wigner--Smith atlas satisfies an algebraic differential equation over
the complete, possibly infinite, full intensity atlas. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftWignerSmithAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (j : ι) :
    HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftWignerSmithAtlas a b gauge j) := by
  have hIntensity :
      ∀ g ∈ Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge),
        DifferentialAlgebraicOver (RatFunc ℂ) g := by
    rintro g ⟨i, rfl⟩
    exact
      differentialAlgebraicOver_gaugedGammaOppositeShiftIntensityAtlas
        a b gauge reflectedGauge hcollapse hgauge hreflectedGauge
        hgauge_ne hreflectedGauge_ne i
  apply
    (HTGeometry.hypertranscendentalOver_differentialAdjoin_iff
      hIntensity).2
  exact hypertranscendentalOver_gaugedGammaOppositeShiftWignerSmithAtlas
    a b gauge hgauge hgauge_ne j

/-- No member of the full phase-slope atlas satisfies an algebraic differential equation over
the complete, possibly infinite, full intensity atlas. -/
theorem hypertranscendentalOver_gaugedGammaOppositeShiftPhaseSlopeAtlas_intensityField
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i))
    (hgauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (gauge i))
    (hreflectedGauge :
      ∀ i, DifferentialAlgebraicOver (RatFunc ℂ) (reflectedGauge i))
    (hgauge_ne : ∀ i, gauge i ≠ 0)
    (hreflectedGauge_ne : ∀ i, reflectedGauge i ≠ 0)
    (j : ι) :
    HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftPhaseSlopeAtlas
        a b gauge reflectedGauge j) := by
  letI : Differential ↥(differentialAdjoin (RatFunc ℂ)
      (Set.range
        (gaugedGammaOppositeShiftIntensityAtlas
          a b gauge reflectedGauge))) :=
    derivationClosedDifferential _
      (derivationClosed_differentialAdjoin (RatFunc ℂ) _)
  letI : DifferentialAlgebra
      ↥(differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (meroField Set.univ) :=
    ⟨fun c => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin (RatFunc ℂ) _) c⟩
  rw [gaugedGammaOppositeShiftPhaseSlopeAtlas,
    HTGeometry.hypertranscendentalOver_wignerSmithLogClock_iff]
  exact
    hypertranscendentalOver_gaugedGammaOppositeShiftPhaseAtlas_intensityField
      a b gauge reflectedGauge hcollapse hgauge hreflectedGauge
      hgauge_ne hreflectedGauge_ne j

/-- Complete universal certificate: every collapsed intensity is DA, while every phase and delay
is HT both over the rational coordinate field and over the differential field generated by all
intensities jointly. -/
structure GammaPhaseTimeIntensityFieldSeparationCertificate
    {ι : Type*} (a b : ι → ℂ) : Prop where
  intensity_differentialAlgebraic :
    ∀ i, DifferentialAlgebraicOver (RatFunc ℂ)
      (gammaOppositeShiftIntensityAtlas a b i)
  phase_hypertranscendental :
    ∀ i, HypertranscendentalOver (RatFunc ℂ)
      (gammaOppositeShiftPhaseAtlas a b i)
  wignerSmith_hypertranscendental :
    ∀ i, HypertranscendentalOver (RatFunc ℂ)
      (gammaOppositeShiftWignerSmithAtlas a b i)
  phase_hypertranscendental_over_intensityField :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range (gammaOppositeShiftIntensityAtlas a b)))
      (gammaOppositeShiftPhaseAtlas a b i)
  wignerSmith_hypertranscendental_over_intensityField :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range (gammaOppositeShiftIntensityAtlas a b)))
      (gammaOppositeShiftWignerSmithAtlas a b i)

/-- **Gamma phase--time/intensity field-separation universality law.**  For every index type and
every family of shifts on the exact intensity-collapse locus, pooling all intensities does not
create any algebraic differential equation for any phase or Wigner--Smith current. -/
theorem gammaPhaseTimeIntensity_fieldSeparationUniversality
    {ι : Type*} (a b : ι → ℂ)
    (hcollapse : ∀ i, GammaOppositeShiftIntensityCollapse (a i) (b i)) :
    GammaPhaseTimeIntensityFieldSeparationCertificate a b := by
  exact
    ⟨differentialAlgebraicOver_gammaOppositeShiftIntensityAtlas a b hcollapse,
      fun i => hypertranscendentalOver_gammaOppositeShiftPhaseMero (a i) (b i),
      fun i => hypertranscendentalOver_gammaOppositeShiftWignerSmithLogMero (a i) (b i),
      hypertranscendentalOver_gammaOppositeShiftPhaseAtlas_intensityField a b hcollapse,
      hypertranscendentalOver_gammaOppositeShiftWignerSmithAtlas_intensityField
        a b hcollapse⟩

/-- Full-amplitude certificate, stable under arbitrary channelwise nonzero DA prefactors. -/
structure GaugedGammaPhaseTimeIntensityFieldSeparationCertificate
    {ι : Type*} (a b : ι → ℂ)
    (gauge reflectedGauge : ι → meroField Set.univ) : Prop where
  exact_intensity_collapse :
    ∀ i, DifferentialAlgebraicOver (RatFunc ℂ)
      (gaugedGammaOppositeShiftIntensityAtlas
        a b gauge reflectedGauge i) ↔
      GammaOppositeShiftIntensityCollapse (a i) (b i)
  amplitude_hypertranscendental_over_full_intensity_atlas :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftAmplitudeAtlas a b gauge i)
  phase_hypertranscendental_over_full_intensity_atlas :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftPhaseAtlas
        a b gauge reflectedGauge i)
  wignerSmith_hypertranscendental_over_full_intensity_atlas :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
      (gaugedGammaOppositeShiftWignerSmithAtlas a b gauge i)
  phaseSlope_hypertranscendental_over_full_intensity_atlas :
    ∀ i, HypertranscendentalOver
      (differentialAdjoin (RatFunc ℂ)
        (Set.range
          (gaugedGammaOppositeShiftIntensityAtlas
            a b gauge reflectedGauge)))
