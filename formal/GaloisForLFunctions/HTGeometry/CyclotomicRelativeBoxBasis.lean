import GaloisForLFunctions.HTGeometry.CyclotomicBoxBasis

/-!
# Relative finite cyclotomic tensor boxes

Disjoint tail power boxes remain linearly independent over the cyclotomic field generated by an
arbitrary finite prefix.  A rational tensor-box basis of the prefix expands every prefix-field
coefficient and reduces relative independence to the full rational box.
-/

open scoped IntermediateField

namespace GaloisForLFunctions.HTGeometry

noncomputable section

private theorem linearIndependent_right_of_basis_smul
    {R S A : Type*} [Field R] [Field S] [AddCommGroup A]
    [Module R S] [Module S A] [Module R A] [IsScalarTower R S A]
    {ι J : Type*} [Fintype ι] [Fintype J]
    (b : Module.Basis ι R S) (c : J → A)
    (hprod : LinearIndependent R (fun p : J × ι => b p.2 • c p.1)) :
    LinearIndependent S c := by
  rw [Fintype.linearIndependent_iff]
  intro g hrel
  have hdouble : ∑ p : J × ι,
      (b.repr (g p.1)) p.2 • (b p.2 • c p.1) = 0 := by
    rw [Fintype.sum_prod_type]
    calc
      ∑ j, ∑ i, (b.repr (g j)) i • (b i • c j) =
          ∑ j, (∑ i, (b.repr (g j)) i • b i) • c j := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [Finset.sum_smul]
            simp_rw [smul_assoc]
      _ = ∑ j, g j • c j := by simp [b.sum_repr]
      _ = 0 := hrel
  have hall := (Fintype.linearIndependent_iff.mp hprod)
    (fun p : J × ι => (b.repr (g p.1)) p.2) hdouble
  intro j
  apply b.repr.injective
  ext i
  simpa using hall (j, i)

theorem cyclotomicBox_card {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (q : ι → ℕ) :
    Fintype.card (CyclotomicBox s q) = ∏ i ∈ s, Nat.totient (q i) := by
  rw [Fintype.card_pi]
  simp only [Fintype.card_fin]
  exact Finset.prod_attach s (fun i => Nat.totient (q i))

theorem linearIndependent_cyclotomicBox_over_prefix
    {ι : Type*} [DecidableEq ι]
    (p t : Finset ι) (hdisj : Disjoint p t) (q : ι → ℕ) (u : ι → ℂ)
    (hq : ∀ i ∈ p ∪ t, 0 < q i)
    (hu : ∀ i ∈ p ∪ t, IsPrimitiveRoot (u i) (q i))
    (hcop : ∀ i ∈ p ∪ t, ∀ j ∈ p ∪ t,
      i ≠ j → Nat.Coprime (q i) (q j)) :
    LinearIndependent (cyclotomicAdjoin p u) (cyclotomicBoxMonomial t q u) := by
  let pre : CyclotomicBox p q → cyclotomicAdjoin p u := fun e =>
    ⟨cyclotomicBoxMonomial p q u e, cyclotomicBoxMonomial_mem p q u e⟩
  have hpq : ∀ i ∈ p, 0 < q i := fun i hi =>
    hq i (Finset.mem_union_left t hi)
  have hpu : ∀ i ∈ p, IsPrimitiveRoot (u i) (q i) := fun i hi =>
    hu i (Finset.mem_union_left t hi)
  have hpcop : ∀ i ∈ p, ∀ j ∈ p, i ≠ j → Nat.Coprime (q i) (q j) :=
    fun i hi j hj hij => hcop i (Finset.mem_union_left t hi)
      j (Finset.mem_union_left t hj) hij
  have hpreComplex := linearIndependent_cyclotomicBox p q u hpq hpu hpcop
  have hpre : LinearIndependent ℚ pre := by
    apply LinearIndependent.of_comp
      (cyclotomicAdjoin p u).toSubalgebra.toSubmodule.subtype
    change LinearIndependent ℚ (cyclotomicBoxMonomial p q u)
    exact hpreComplex
  letI : FiniteDimensional ℚ (cyclotomicAdjoin p u) :=
    cyclotomicAdjoin_finiteDimensional p q u hpq hpu
  letI : Nonempty (CyclotomicBox p q) := ⟨fun i =>
    ⟨0, Nat.totient_pos.mpr (hpq i.1 i.2)⟩⟩
  have hcard : Fintype.card (CyclotomicBox p q) =
      Module.finrank ℚ (cyclotomicAdjoin p u) := by
    rw [cyclotomicBox_card, cyclotomicAdjoin_finrank_eq p q u hpq hpu hpcop]
  let b : Module.Basis (CyclotomicBox p q) ℚ (cyclotomicAdjoin p u) :=
    basisOfLinearIndependentOfCardEqFinrank hpre hcard
  have hb (e : CyclotomicBox p q) : b e = pre e := by
    simp [b, basisOfLinearIndependentOfCardEqFinrank]
  have hall := linearIndependent_cyclotomicBox (p ∪ t) q u hq hu hcop
  let merge : CyclotomicBox t q × CyclotomicBox p q →
      CyclotomicBox (p ∪ t) q := fun e i =>
    if hit : i.1 ∈ t then e.1 ⟨i.1, hit⟩
    else e.2 ⟨i.1, (Finset.mem_union.mp i.2).resolve_right hit⟩
  have hmerge : Function.Injective merge := by
    intro e f hef
    apply Prod.ext
    · funext i
      have hi := congrFun hef
        (⟨i.1, Finset.mem_union_right p i.2⟩ : {i // i ∈ p ∪ t})
      simpa [merge, i.2] using hi
    · funext i
      have hit : i.1 ∉ t := fun hit => Finset.disjoint_left.mp hdisj i.2 hit
      have hi := congrFun hef
        (⟨i.1, Finset.mem_union_left t i.2⟩ : {i // i ∈ p ∪ t})
      simpa [merge, hit] using hi
  have hmerged := hall.comp merge hmerge
  change LinearIndependent ℚ
    (cyclotomicBoxMonomial (p ∪ t) q u ∘ merge) at hmerged
  have hfamily (e : CyclotomicBox t q × CyclotomicBox p q) :
      cyclotomicBoxMonomial (p ∪ t) q u (merge e) =
        (b e.2 : ℂ) * cyclotomicBoxMonomial t q u e.1 := by
    rw [hb]
    let unionEquiv : {i // i ∈ p} ⊕ {i // i ∈ t} ≃ {i // i ∈ p ∪ t} :=
      Equiv.Finset.union p t hdisj
    change (∏ i : {i // i ∈ p ∪ t}, u i.1 ^ ((merge e) i : ℕ)) =
      (∏ i : {i // i ∈ p}, u i.1 ^ (e.2 i : ℕ)) *
        ∏ i : {i // i ∈ t}, u i.1 ^ (e.1 i : ℕ)
    calc
      (∏ i : {i // i ∈ p ∪ t}, u i.1 ^ ((merge e) i : ℕ)) =
          ∏ z : {i // i ∈ p} ⊕ {i // i ∈ t},
            u (unionEquiv z).1 ^ ((merge e) (unionEquiv z) : ℕ) := by
              exact (unionEquiv.prod_comp
                (fun i => u i.1 ^ ((merge e) i : ℕ))).symm
      _ = (∏ i : {i // i ∈ p}, u i.1 ^ (e.2 i : ℕ)) *
          ∏ i : {i // i ∈ t}, u i.1 ^ (e.1 i : ℕ) := by
            rw [Fintype.prod_sum_type]
            apply congrArg₂ (· * ·)
            · apply Fintype.prod_congr
              intro i
              have hit : i.1 ∉ t := fun hit => Finset.disjoint_left.mp hdisj i.2 hit
              simp [merge, unionEquiv, hit]
            · apply Fintype.prod_congr
              intro i
              simp [merge, unionEquiv, i.2]
  have hfun : (cyclotomicBoxMonomial (p ∪ t) q u ∘ merge) =
      (fun e : CyclotomicBox t q × CyclotomicBox p q =>
        b e.2 • cyclotomicBoxMonomial t q u e.1) := by
    funext e
    exact hfamily e
  rw [hfun] at hmerged
  exact linearIndependent_right_of_basis_smul b
    (cyclotomicBoxMonomial t q u) hmerged

end

end GaloisForLFunctions.HTGeometry
