import Mathlib
import GaloisForLFunctions.HTGeometry.LinearVersusAlgebraicCollapse

/-!
# Symmetric blocks and free systems of multipliers

Two facts about the continuation block of a finite multiplier system.

First, the block is generated by the elementary symmetric functions of the multiplier logarithms,
and **elementary symmetric functions of an algebraically independent family are again algebraically
independent** — so the transcendence degree of the block equals the number of multipliers exactly
when the logarithms are algebraically independent.

Second, such a **free** system exists for every finite size: the reals contain algebraically
independent families of every finite cardinality, because a transcendence basis of `ℝ` over `ℚ`
cannot be finite (a real number field generated by finitely many elements is countable).

* `algebraicIndependent_esymm` — the symmetric functions of an algebraically independent family are
  algebraically independent.
* `exists_algebraicIndependent_fin_real` — free systems of every finite size exist in `ℝ`.
-/

namespace GaloisForLFunctions.HTGeometry

open Algebra Cardinal MvPolynomial

/-! ### Symmetric functions of an algebraically independent family -/

variable {K A : Type} [Field K] [CommRing A] [Algebra K A]

/-- The elementary symmetric functions of a family, evaluated in the ambient algebra. -/
noncomputable def esymmOf (K : Type) [Field K] {A : Type} [CommRing A] [Algebra K A]
    {r : ℕ} (x : Fin r → A) (k : Fin r) : A :=
  MvPolynomial.aeval x (MvPolynomial.esymm (Fin r) K ((k : ℕ) + 1))

/-- **Elementary symmetric functions of an algebraically independent family are algebraically
independent.**  The evaluation at the symmetric functions factors as the evaluation at the family
composed with the fundamental symmetric-function homomorphism, and both are injective. -/
theorem algebraicIndependent_esymm {r : ℕ} {x : Fin r → A}
    (hx : AlgebraicIndependent K x) : AlgebraicIndependent K (esymmOf K x) := by
  have hfactor : (MvPolynomial.aeval (esymmOf K x) : MvPolynomial (Fin r) K →ₐ[K] A)
      = (MvPolynomial.aeval x).comp
        ((Subalgebra.val _).comp (MvPolynomial.esymmAlgHom (Fin r) K r)) := by
    refine MvPolynomial.algHom_ext fun k => ?_
    simp [esymmOf, MvPolynomial.esymmAlgHom]
  rw [algebraicIndependent_iff_injective_aeval, hfactor, AlgHom.coe_comp, AlgHom.coe_comp]
  refine (algebraicIndependent_iff_injective_aeval.mp hx).comp ?_
  have hinj : Function.Injective (MvPolynomial.esymmAlgHom (Fin r) K r) :=
    MvPolynomial.esymmAlgHom_injective (R := K) (σ := Fin r) (n := r)
      (Fintype.card_fin r).ge
  refine Function.Injective.comp ?_ hinj
  intro a b hab
  exact Subtype.ext hab

/-! ### Free systems of multipliers exist in every finite size -/

/-- The subalgebra generated by a finite set of reals is countable. -/
theorem cardinalMk_adjoin_le_aleph0 {s : Set ℝ} (hs : s.Finite) :
    Cardinal.mk (Algebra.adjoin ℚ s : Set ℝ) ≤ Cardinal.aleph0 := by
  have : Finite s := hs
  have hrange : (Algebra.adjoin ℚ s : Set ℝ)
      = Set.range (fun p : MvPolynomial s ℚ => MvPolynomial.aeval ((↑) : s → ℝ) p) := by
    rw [Algebra.adjoin_eq_range]
    rfl
  have hle : Cardinal.mk (Algebra.adjoin ℚ s : Set ℝ)
      ≤ Cardinal.mk (MvPolynomial s ℚ) := by
    rw [hrange]
    exact Cardinal.mk_range_le
  refine hle.trans ?_
  refine MvPolynomial.cardinalMk_le_max.trans ?_
  have hs' : Cardinal.mk s ≤ Cardinal.aleph0 := (Cardinal.lt_aleph0_of_finite s).le
  have hq : Cardinal.mk ℚ ≤ Cardinal.aleph0 := Cardinal.mk_le_aleph0
  simp only [sup_le_iff]
  exact ⟨⟨hq, hs'⟩, le_rfl⟩

/-- **A transcendence basis of `ℝ` over `ℚ` is infinite.**  If it were finite the reals would be
algebraic over a countable subalgebra, hence countable. -/
theorem infinite_of_isTranscendenceBasis_real {s : Set ℝ}
    (hs : IsTranscendenceBasis ℚ ((↑) : s → ℝ)) : s.Infinite := by
  intro hfin
  have halg : Algebra.IsAlgebraic (Algebra.adjoin ℚ s) ℝ := by
    have h := hs.isAlgebraic
    rwa [Subtype.range_coe] at h
  have hmk : Cardinal.mk (Algebra.adjoin ℚ s : Set ℝ) ≤ Cardinal.aleph0 :=
    cardinalMk_adjoin_le_aleph0 hfin
  have hle : Cardinal.mk ℝ ≤ max (Cardinal.mk (Algebra.adjoin ℚ s : Set ℝ)) Cardinal.aleph0 :=
    Algebra.IsAlgebraic.cardinalMk_le_max (Algebra.adjoin ℚ s) ℝ
  have hle' : Cardinal.mk ℝ ≤ Cardinal.aleph0 := hle.trans (max_le hmk le_rfl)
  rw [Cardinal.mk_real] at hle'
  exact absurd hle' (not_le.mpr Cardinal.aleph0_lt_continuum)

/-- **Free systems of every finite size exist.**  For every `r` there is an algebraically
independent family of `r` real numbers: the unconditional witness for a free multiplier system of
rank `r`. -/
theorem exists_algebraicIndependent_fin_real (r : ℕ) :
    ∃ x : Fin r → ℝ, AlgebraicIndependent ℚ x := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℚ (A := ℝ)
  have hinf : s.Infinite := infinite_of_isTranscendenceBasis_real hs
  obtain ⟨f⟩ : Nonempty (Fin r ↪ s) := by
    have : Infinite s := hinf.to_subtype
    exact ⟨(Function.Embedding.trans (Fin.valEmbedding) (Infinite.natEmbedding s))⟩
  refine ⟨fun i => ((f i : s) : ℝ), ?_⟩
  exact hs.1.comp f f.injective

/-- **The free system has full transcendence degree in its symmetric block.**  The elementary
symmetric functions of a free family of size `r` are themselves algebraically independent, so the
block they generate has transcendence degree `r`. -/
theorem exists_algebraicIndependent_esymm_fin_real (r : ℕ) :
    ∃ x : Fin r → ℝ, AlgebraicIndependent ℚ x ∧ AlgebraicIndependent ℚ (esymmOf ℚ x) := by
  obtain ⟨x, hx⟩ := exists_algebraicIndependent_fin_real r
  exact ⟨x, hx, algebraicIndependent_esymm hx⟩

/-! ### The Laurent block of a finite Beurling system is symmetric -/

/-- One factor of the normalized Laurent block: a power series in the expansion variable whose
`k`-th coefficient is a fixed rational multiple of the `k`-th power of the `i`-th multiplier
logarithm. -/
noncomputable def scaledFactor (r : ℕ) (c : ℕ → ℚ) (i : Fin r) :
    PowerSeries (MvPolynomial (Fin r) ℚ) :=
  PowerSeries.mk fun k => MvPolynomial.C (c k) * (MvPolynomial.X i) ^ k

/-- The normalized Laurent block of a finite multiplier system: the product over the multipliers of
the scaled factors.  For the Beurling zeta function the scaling sequence is the Bernoulli sequence
`B⁺ₖ / k!`, coming from `sL / (1 - e^{-sL}) = ∑ₖ B⁺ₖ (sL)ᵏ / k!`. -/
noncomputable def symmetricBlock (r : ℕ) (c : ℕ → ℚ) : PowerSeries (MvPolynomial (Fin r) ℚ) :=
  ∏ i : Fin r, scaledFactor r c i

theorem map_rename_scaledFactor (r : ℕ) (c : ℕ → ℚ) (e : Equiv.Perm (Fin r)) (i : Fin r) :
    PowerSeries.map (MvPolynomial.rename e).toRingHom (scaledFactor r c i)
      = scaledFactor r c (e i) := by
  ext k
  simp [scaledFactor, PowerSeries.coeff_map]

/-- **The Laurent block of a finite Beurling system is symmetric.**  Every coefficient of the block
is a symmetric polynomial with rational coefficients in the multiplier logarithms. -/
theorem isSymmetric_coeff_symmetricBlock (r : ℕ) (c : ℕ → ℚ) (k : ℕ) :
    (PowerSeries.coeff k (symmetricBlock r c)).IsSymmetric := by
  intro e
  have hmap : PowerSeries.map (MvPolynomial.rename e).toRingHom (symmetricBlock r c)
      = symmetricBlock r c := by
    rw [symmetricBlock, map_prod]
    rw [← Equiv.prod_comp e (fun i => scaledFactor r c i)]
    exact Finset.prod_congr rfl fun i _ => map_rename_scaledFactor r c e i
  have hco := congrArg (PowerSeries.coeff k) hmap
  rwa [PowerSeries.coeff_map] at hco

/-- The Bernoulli-scaled Laurent block of a finite Beurling system. -/
noncomputable def beurlingBlock (r : ℕ) : PowerSeries (MvPolynomial (Fin r) ℚ) :=
  symmetricBlock r fun k => bernoulli' k / (k.factorial : ℚ)

theorem isSymmetric_coeff_beurlingBlock (r k : ℕ) :
    (PowerSeries.coeff k (beurlingBlock r)).IsSymmetric :=
  isSymmetric_coeff_symmetricBlock r _ k

/-- **The block is generated by the elementary symmetric functions.**  Every coefficient of the
Laurent block is a rational polynomial in the elementary symmetric functions of the multiplier
logarithms — the continuation block is `ℚ(e₁, …, e_r)`. -/
theorem exists_polynomial_in_esymm_coeff_beurlingBlock (r k : ℕ) :
    ∃ q : MvPolynomial (Fin r) ℚ,
      PowerSeries.coeff k (beurlingBlock r)
        = MvPolynomial.aeval (fun j : Fin r => MvPolynomial.esymm (Fin r) ℚ ((j : ℕ) + 1)) q := by
  obtain ⟨q, hq⟩ := MvPolynomial.esymmAlgHom_surjective (R := ℚ) (σ := Fin r) (n := r)
    (Fintype.card_fin r).le
    ⟨PowerSeries.coeff k (beurlingBlock r), isSymmetric_coeff_beurlingBlock r k⟩
  refine ⟨q, ?_⟩
  have := congrArg Subtype.val hq
  simpa [MvPolynomial.esymmAlgHom_apply] using this.symm

/-! ### The separation: the same rational corank, different transcendence degree -/

/-- An algebraically independent family is rationally linearly independent: a linear relation is in
particular a polynomial relation. -/
theorem linearIndependent_of_algebraicIndependent {r : ℕ} {x : Fin r → ℝ}
    (hx : AlgebraicIndependent ℚ x) : LinearIndependent ℚ x := by
  rw [linearIndependent_iff']
  intro s g hg i hi
  have hpoly : (MvPolynomial.aeval x) (∑ j ∈ s, MvPolynomial.C (g j) * MvPolynomial.X j) = 0 := by
    rw [map_sum]
    simpa [Rat.smul_def] using hg
  have hzero := (algebraicIndependent_iff.mp hx) _ hpoly
  have hco := congrArg (MvPolynomial.coeff (Finsupp.single i 1)) hzero
  rw [MvPolynomial.coeff_sum] at hco
  rw [Finset.sum_eq_single i] at hco
  · simpa [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X] using hco
  · intro j _ hji
    simp [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, Finsupp.single_eq_single_iff, hji]
  · intro h
    exact absurd hi h

/-- **The separation theorem.**  There are two real multiplier systems of rank two with the same
rational corank — both families are rationally linearly independent — of which one is algebraically
independent and the other is not.  Hence the transcendence degree of the continuation block is not
a function of the rational corank: no theorem of the form "corank hypotheses imply
`trdeg = corank`" can exist. -/
theorem exists_same_corank_different_trdeg :
    ∃ x y : Fin 2 → ℝ,
      LinearIndependent ℚ x ∧ LinearIndependent ℚ y ∧
        AlgebraicIndependent ℚ x ∧ ¬ AlgebraicIndependent ℚ y := by
  obtain ⟨x, hx⟩ := exists_algebraicIndependent_fin_real 2
  obtain ⟨t, ht⟩ := exists_transcendental_real
  refine ⟨x, ![t, t ^ 2], linearIndependent_of_algebraicIndependent hx, ?_, hx, ?_⟩
  · exact linearIndependent_pair_sq_of_irrational ht.irrational
  · exact not_algebraicIndependent_pair_sq t

end GaloisForLFunctions.HTGeometry
