import Mathlib

/-!
# Determinantal ideals

The `k`-th determinantal ideal of a square matrix is generated by all of its `k × k` minors.  It is
invariant under multiplication by an invertible matrix on either side: expanding the determinant of
a minor of a product by multilinearity in the rows writes it as a combination of minors of the
right factor, and transposing gives the same for the left factor.

Consequently determinantal ideals are invariants of the equivalence class of a matrix, hence of the
module it presents.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

variable {R : Type*} [CommRing R] {N : ℕ}


/-- A strictly monotone selection never moves an index down. -/
theorem val_le_val_of_strictMono {k n : ℕ} {f : Fin k → Fin n} (hf : StrictMono f) (α : Fin k) :
    (α : ℕ) ≤ (f α : ℕ) := by
  have key : ∀ (m : ℕ) (hm : m < k), m ≤ (f ⟨m, hm⟩ : ℕ) := by
    intro m
    induction m with
    | zero => intro _; exact Nat.zero_le _
    | succ t ih =>
      intro hm
      have ht : t < k := Nat.lt_of_succ_lt hm
      have hlt : f ⟨t, ht⟩ < f ⟨t + 1, hm⟩ := hf (by exact Fin.mk_lt_mk.mpr (Nat.lt_succ_self t))
      have h1 : ((f ⟨t, ht⟩ : Fin n) : ℕ) < ((f ⟨t + 1, hm⟩ : Fin n) : ℕ) := hlt
      have h2 := ih ht
      omega
  simpa using key (α : ℕ) α.isLt

/-- The `k`-th determinantal ideal: generated by all `k × k` minors. -/
def detIdeal (M : Matrix (Fin N) (Fin N) R) (k : ℕ) : Ideal R :=
  Ideal.span (Set.range fun p : (Fin k → Fin N) × (Fin k → Fin N) => (M.submatrix p.1 p.2).det)

theorem minor_mem_detIdeal (M : Matrix (Fin N) (Fin N) R) {k : ℕ} (I m : Fin k → Fin N) :
    (M.submatrix I m).det ∈ detIdeal M k :=
  Ideal.subset_span ⟨(I, m), rfl⟩

theorem detIdeal_le {M : Matrix (Fin N) (Fin N) R} {k : ℕ} {J : Ideal R}
    (h : ∀ I m : Fin k → Fin N, (M.submatrix I m).det ∈ J) : detIdeal M k ≤ J := by
  rw [detIdeal, Ideal.span_le]
  rintro y ⟨⟨I, m⟩, rfl⟩
  exact h I m

/-- Minors of a product lie in the determinantal ideal of the right factor. -/
theorem detIdeal_mul_le_right (A B : Matrix (Fin N) (Fin N) R) (k : ℕ) :
    detIdeal (A * B) k ≤ detIdeal B k := by
  classical
  refine detIdeal_le fun I m => ?_
  have hrows : ((A * B).submatrix I m : Fin k → Fin k → R)
      = fun α => ∑ s : Fin N, A (I α) s • (fun β => B s (m β)) := by
    funext α β
    simp [Matrix.submatrix_apply, Matrix.mul_apply, Finset.sum_apply]
  have hexp : ((A * B).submatrix I m).det
      = ∑ r : Fin k → Fin N, (∏ α, A (I α) (r α)) • (B.submatrix r m).det := by
    have h1 : ((A * B).submatrix I m).det
        = (Matrix.detRowAlternating (n := Fin k) (R := R)).toMultilinearMap
            (fun α => ∑ s : Fin N, A (I α) s • (fun β => B s (m β))) := by
      rw [← hrows]
      rfl
    rw [h1, MultilinearMap.map_sum]
    exact Finset.sum_congr rfl fun r _ => MultilinearMap.map_smul_univ _ _ _
  rw [hexp]
  refine Ideal.sum_mem _ fun r _ => ?_
  rw [smul_eq_mul]
  exact Ideal.mul_mem_left _ _ (minor_mem_detIdeal B r m)

theorem detIdeal_transpose (M : Matrix (Fin N) (Fin N) R) (k : ℕ) :
    detIdeal Mᵀ k = detIdeal M k := by
  refine le_antisymm (detIdeal_le fun I m => ?_) (detIdeal_le fun I m => ?_)
  · have h : Mᵀ.submatrix I m = (M.submatrix m I)ᵀ := rfl
    rw [h, Matrix.det_transpose]
    exact minor_mem_detIdeal M m I
  · have h : M.submatrix I m = (Mᵀ.submatrix m I)ᵀ := rfl
    rw [h, Matrix.det_transpose]
    exact minor_mem_detIdeal Mᵀ m I

/-- Minors of a product lie in the determinantal ideal of the left factor. -/
theorem detIdeal_mul_le_left (A B : Matrix (Fin N) (Fin N) R) (k : ℕ) :
    detIdeal (A * B) k ≤ detIdeal A k := by
  rw [← detIdeal_transpose (A * B) k, Matrix.transpose_mul, ← detIdeal_transpose A k]
  exact detIdeal_mul_le_right Bᵀ Aᵀ k

/-- **Left invariance.**  Multiplying by an invertible matrix does not change the determinantal
ideals. -/
theorem detIdeal_unit_mul {U : Matrix (Fin N) (Fin N) R} (hU : IsUnit U.det)
    (M : Matrix (Fin N) (Fin N) R) (k : ℕ) : detIdeal (U * M) k = detIdeal M k := by
  refine le_antisymm (detIdeal_mul_le_right U M k) ?_
  have hM : M = U⁻¹ * (U * M) := by
    rw [← Matrix.mul_assoc, Matrix.nonsing_inv_mul U hU, Matrix.one_mul]
  calc detIdeal M k = detIdeal (U⁻¹ * (U * M)) k := by rw [← hM]
    _ ≤ detIdeal (U * M) k := detIdeal_mul_le_right _ _ k

/-- **Right invariance.** -/
theorem detIdeal_mul_unit {V : Matrix (Fin N) (Fin N) R} (hV : IsUnit V.det)
    (M : Matrix (Fin N) (Fin N) R) (k : ℕ) : detIdeal (M * V) k = detIdeal M k := by
  refine le_antisymm (detIdeal_mul_le_left M V k) ?_
  have hM : M = (M * V) * V⁻¹ := by
    rw [Matrix.mul_assoc, Matrix.mul_nonsing_inv V hV, Matrix.mul_one]
  calc detIdeal M k = detIdeal ((M * V) * V⁻¹) k := by rw [← hM]
    _ ≤ detIdeal (M * V) k := detIdeal_mul_le_left _ _ k

/-- **Equivalence invariance.**  Determinantal ideals depend only on the equivalence class. -/
theorem detIdeal_equiv {U V : Matrix (Fin N) (Fin N) R} (hU : IsUnit U.det) (hV : IsUnit V.det)
    (M : Matrix (Fin N) (Fin N) R) (k : ℕ) : detIdeal (U * M * V) k = detIdeal M k := by
  rw [detIdeal_mul_unit hV, detIdeal_unit_mul hU]

end GaloisForLFunctions.HTGeometry
