import GaloisForLFunctions.HTGeometry.DedekindOrderMonogenic
import GaloisForLFunctions.HTGeometry.SplitFiniteAlgebraDiscriminant

/-!
# A finite algebra with split residue fibre is locally monogenic

Let `A` be a local ring and `B` a finite `A`-algebra.  If the fibre of `B` over the closed point is
a finite product of copies of the residue field, then `B` is generated by one element over `A`.

The proof first generates the split product by one element, transports that generator through the
given algebra equivalence, lifts it to `B`, and applies Nakayama monogenicity.  No locality, domain,
freeness, or presentation hypothesis is imposed on `B`.
-/

namespace GaloisForLFunctions.HTGeometry

open IsLocalRing


/-- **Split residue fibre implies local monogenicity.**  A finite algebra over a local ring is
generated by one element whenever its closed fibre is a finite product of copies of the residue
field. -/
theorem exists_adjoin_eq_top_of_split_residue_fibre
    {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [Algebra A B]
    [Module.Finite A B] [CharZero (ResidueField A)]
    {ι : Type*} [Fintype ι]
    (hsplit : Nonempty ((B ⧸ maxExt A B) ≃ₐ[ResidueField A] (ι → ResidueField A))) :
    ∃ θ : B, Algebra.adjoin A ({θ} : Set B) = ⊤ := by
  classical
  obtain ⟨e⟩ := hsplit
  have hpi : ∃ α : (ι → ResidueField A),
      Algebra.adjoin (ResidueField A) ({α} : Set (ι → ResidueField A)) = ⊤ := by
    apply exists_adjoin_pi_eq_top (A := fun _ : ι => ResidueField A)
    · intro i
      refine ⟨1, ?_⟩
      simpa using (Ideal.eq_bot_or_top (maximalIdeal (ResidueField A))).resolve_right
        ((IsLocalRing.maximalIdeal.isMaximal (ResidueField A)).ne_top)
    · intro i
      exact ⟨0, by simp⟩
  obtain ⟨γ, hγ⟩ := exists_adjoin_eq_top_of_algEquiv e hpi
  obtain ⟨θ, hθ⟩ := Ideal.Quotient.mk_surjective γ
  have hγA := adjoin_base_eq_top_of_adjoin_residue γ hγ
  rw [← hθ] at hγA
  exact ⟨θ, adjoin_eq_top_of_adjoin_quotient_eq_top θ hγA⟩

/-- **Nondegenerate residue trace implies local monogenicity.**  Over an algebraically closed
characteristic-zero residue field, nondegeneracy of the closed fibre's trace pairing splits that
fibre and hence supplies a generator of the finite algebra over the local base. -/
theorem exists_adjoin_eq_top_of_residue_traceForm_nondegenerate
    {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [Algebra A B]
    [Module.Finite A B] [CharZero (ResidueField A)] [IsAlgClosed (ResidueField A)]
    (h : (Algebra.traceForm (ResidueField A) (B ⧸ maxExt A B)).Nondegenerate) :
    ∃ θ : B, Algebra.adjoin A ({θ} : Set B) = ⊤ := by
  letI : Module.Finite A (B ⧸ maxExt A B) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ A (maxExt A B)).toLinearMap
      Ideal.Quotient.mk_surjective
  letI : Module.Finite (ResidueField A) (B ⧸ maxExt A B) :=
    Module.Finite.of_restrictScalars_finite A _ _
  letI : IsArtinianRing (B ⧸ maxExt A B) :=
    isArtinian_of_tower (ResidueField A) inferInstance
  letI : Fintype (MaximalSpectrum (B ⧸ maxExt A B)) := Fintype.ofFinite _
  exact exists_adjoin_eq_top_of_split_residue_fibre
    (nonempty_algEquiv_pi_of_traceForm_nondegenerate h)

end GaloisForLFunctions.HTGeometry
