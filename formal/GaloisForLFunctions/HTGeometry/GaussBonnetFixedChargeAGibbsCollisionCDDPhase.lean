import GaloisForLFunctions.HTGeometry.GaussBonnetFixedChargeAGibbsCollisionDifferences

/-!
# A CDD phase whose positive source is the collision history

The existing source-to-phase map converts the two temporal collision atoms
into a real phase and a unit-modulus factor. Its two shell radii are the
original amplitude rates 2/3 and 1/6. This is an algebraic scattering-phase
realization of the thermal-kernel data, not an assertion of black-hole dynamics.
-/

namespace GaloisForLFunctions.HTGeometry
noncomputable section

/-- Real CDD phase generated by the positive two-atom collision source. -/
def egbFixedChargeAGibbsCollisionCDDPhase (n o : ℕ) (β : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) (θ : ℝ) : ℝ :=
  hausdorffCDDPhase (egbFixedChargeAGibbsCollisionHausdorffSource n o β E) θ

/-- Real-axis scattering factor of the collision source. -/
def egbFixedChargeAGibbsCollisionCDDFactor (n o : ℕ) (β : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) (θ : ℝ) : ℂ :=
  Complex.exp (Complex.I * (egbFixedChargeAGibbsCollisionCDDPhase n o β E θ : ℂ))

/-- The collision-source phase is the weighted sum of its slow and fast shell kernels. -/
theorem egbFixedChargeAGibbsCollisionCDDPhase_formula (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    egbFixedChargeAGibbsCollisionCDDPhase n o β E θ =
      ((4 / 9 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsSlowModeEnergy n β E) *
        cddPhaseKernel (4 / 9) θ +
      ((1 / 36 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsFastModeEnergy n β E) *
        cddPhaseKernel (1 / 36) θ := by
  rw [egbFixedChargeAGibbsCollisionCDDPhase, egbFixedChargeAGibbsCollisionHausdorffSource,
    hausdorffCDDPhase_add, hausdorffCDDPhase_atom, hausdorffCDDPhase_atom]
  rfl

/-- The phase has an exact two-arctangent closed form at the amplitude radii 2/3 and 1/6. -/
theorem egbFixedChargeAGibbsCollisionCDDPhase_arctan (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    egbFixedChargeAGibbsCollisionCDDPhase n o β E θ =
      6 * (4 / 9 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsSlowModeEnergy n β E *
        Real.arctan ((12 / 13 : ℝ) * Real.sinh θ) +
      24 * (1 / 36 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsFastModeEnergy n β E *
        Real.arctan ((12 / 37 : ℝ) * Real.sinh θ) := by
  have hr := cddPhaseKernel_sq (by norm_num : (0 : ℝ) < 2 / 3) θ
  have hs := cddPhaseKernel_sq (by norm_num : (0 : ℝ) < 1 / 6) θ
  have hargR : 2 * (2 / 3 : ℝ) * Real.sinh θ / (1 + (2 / 3 : ℝ) ^ 2) =
      (12 / 13 : ℝ) * Real.sinh θ := by ring
  have hargS : 2 * (1 / 6 : ℝ) * Real.sinh θ / (1 + (1 / 6 : ℝ) ^ 2) =
      (12 / 37 : ℝ) * Real.sinh θ := by ring
  rw [hargR, show (2 / 3 : ℝ) ^ 2 = 4 / 9 by norm_num] at hr
  rw [hargS, show (1 / 6 : ℝ) ^ 2 = 1 / 36 by norm_num] at hs
  have hr' : cddPhaseKernel (4 / 9) θ = 6 * Real.arctan ((12 / 13 : ℝ) * Real.sinh θ) := by
    linarith
  have hs' : cddPhaseKernel (1 / 36) θ = 24 * Real.arctan ((12 / 37 : ℝ) * Real.sinh θ) := by
    linarith
  rw [egbFixedChargeAGibbsCollisionCDDPhase_formula, hr', hs']
  ring

/-- The collision-source phase is odd in real rapidity. -/
theorem egbFixedChargeAGibbsCollisionCDDPhase_odd (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    egbFixedChargeAGibbsCollisionCDDPhase n o β E (-θ) =
      -egbFixedChargeAGibbsCollisionCDDPhase n o β E θ := by
  rw [egbFixedChargeAGibbsCollisionCDDPhase_arctan, egbFixedChargeAGibbsCollisionCDDPhase_arctan]
  simp only [Real.sinh_neg, mul_neg, Real.arctan_neg]
  ring

/-- The real-axis factor has unit modulus for every input and every real rapidity. -/
theorem egbFixedChargeAGibbsCollisionCDDFactor_norm (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    ‖egbFixedChargeAGibbsCollisionCDDFactor n o β E θ‖ = 1 := by
  rw [egbFixedChargeAGibbsCollisionCDDFactor, Complex.norm_exp]
  simp

/-- Opposite rapidities produce reciprocal collision-source factors. -/
theorem egbFixedChargeAGibbsCollisionCDDFactor_reciprocal (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    egbFixedChargeAGibbsCollisionCDDFactor n o β E θ *
      egbFixedChargeAGibbsCollisionCDDFactor n o β E (-θ) = 1 := by
  rw [egbFixedChargeAGibbsCollisionCDDFactor, egbFixedChargeAGibbsCollisionCDDFactor,
    egbFixedChargeAGibbsCollisionCDDPhase_odd, ← Complex.exp_add]
  have he : Complex.I * (egbFixedChargeAGibbsCollisionCDDPhase n o β E θ : ℂ) +
      Complex.I * ((-egbFixedChargeAGibbsCollisionCDDPhase n o β E θ : ℝ) : ℂ) = 0 := by
    push_cast
    ring
  rw [he, Complex.exp_zero]

/-- The two positive collision atoms contribute multiplicatively to the real-axis factor. -/
theorem egbFixedChargeAGibbsCollisionCDDFactor_factorization (n o : ℕ) (β θ : ℝ)
    (E : Fin (2 ^ (n + 3)) → ℝ) :
    egbFixedChargeAGibbsCollisionCDDFactor n o β E θ =
      Complex.exp (Complex.I *
        ((((4 / 9 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsSlowModeEnergy n β E) *
          cddPhaseKernel (4 / 9) θ : ℝ) : ℂ)) *
      Complex.exp (Complex.I *
        ((((1 / 36 : ℝ) ^ (o + 1) * egbFixedChargeAGibbsFastModeEnergy n β E) *
          cddPhaseKernel (1 / 36) θ : ℝ) : ℂ)) := by
  rw [egbFixedChargeAGibbsCollisionCDDFactor, egbFixedChargeAGibbsCollisionCDDPhase_formula,
    Complex.ofReal_add, mul_add, Complex.exp_add]

end
end GaloisForLFunctions.HTGeometry
