import GaloisForLFunctions.HTGeometry.SymmetricHopfIdealLinear

/-!
# Symmetric algebras of module quotients

For a submodule `L ≤ V`, the quotient of `Sym(V)` by the ideal generated by `ι(L)` is explicitly
equivalent to `Sym(V/L)`.  In particular, the kernel of the canonical symmetric-algebra map is
exactly the ideal generated by `L`.
-/

open scoped TensorProduct

namespace GaloisForLFunctions.HTGeometry
namespace SymmetricAlgebraSubmoduleQuotient

noncomputable section

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]

def linearIdeal (L : Submodule k V) : Ideal (SymmetricAlgebra k V) :=
  Ideal.span (SymmetricAlgebra.ι k V '' (L : Set V))

theorem generator_mem_linearIdeal (L : Submodule k V) {v : V} (hv : v ∈ L) :
    SymmetricAlgebra.ι k V v ∈ linearIdeal L :=
  Ideal.subset_span ⟨v, hv, rfl⟩

def quotientMap (L : Submodule k V) :
    SymmetricAlgebra k V →ₐ[k] SymmetricAlgebra k (V ⧸ L) :=
  SymmetricAlgebra.lift ((SymmetricAlgebra.ι k (V ⧸ L)).comp L.mkQ)

@[simp] theorem quotientMap_ι (L : Submodule k V) (v : V) :
    quotientMap L (SymmetricAlgebra.ι k V v) =
      SymmetricAlgebra.ι k (V ⧸ L) (L.mkQ v) := by
  simp [quotientMap]

/-- The symmetric-algebra map induced by a module quotient is a bialgebra morphism. -/
noncomputable def quotientBialgHom (L : Submodule k V) :
    SymmetricAlgebra k V →ₐc[k] SymmetricAlgebra k (V ⧸ L) :=
  BialgHom.ofAlgHom (quotientMap L) (by
    apply SymmetricAlgebra.algHom_ext
    apply LinearMap.ext
    intro v
    change Coalgebra.counit (R := k)
        (quotientMap L (SymmetricAlgebra.ι k V v)) =
      Coalgebra.counit (R := k) (SymmetricAlgebra.ι k V v)
    rw [quotientMap_ι]
    simp) (by
    apply SymmetricAlgebra.algHom_ext
    apply LinearMap.ext
    intro v
    simp [quotientMap, SymmetricAlgebra.comul_ι])

@[simp] theorem quotientBialgHom_apply (L : Submodule k V)
    (p : SymmetricAlgebra k V) :
    quotientBialgHom L p = quotientMap L p := rfl

/-- The symmetric-algebra map induced by a quotient module is surjective. -/
theorem quotientBialgHom_surjective (L : Submodule k V) :
    Function.Surjective (quotientBialgHom L) := by
  intro p
  induction p using SymmetricAlgebra.induction with
  | algebraMap r =>
      exact ⟨(algebraMap k (SymmetricAlgebra k V)) r,
        by simp [quotientBialgHom]⟩
  | ι qv =>
      obtain ⟨v, rfl⟩ := L.mkQ_surjective qv
      exact ⟨SymmetricAlgebra.ι k V v, by
        simp [quotientBialgHom, quotientMap]⟩
  | mul p q hp hq =>
      obtain ⟨p', rfl⟩ := hp
      obtain ⟨q', rfl⟩ := hq
      exact ⟨p' * q', by simp⟩
  | add p q hp hq =>
      obtain ⟨p', rfl⟩ := hp
      obtain ⟨q', rfl⟩ := hq
      exact ⟨p' + q', by simp⟩

theorem linearIdeal_le_ker_quotientMap (L : Submodule k V) :
    linearIdeal L ≤ RingHom.ker (quotientMap L).toRingHom := by
  rw [linearIdeal, Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  change quotientMap L (SymmetricAlgebra.ι k V v) = 0
  rw [quotientMap_ι]
  have hq : L.mkQ v = 0 := by
    exact (Submodule.Quotient.mk_eq_zero (p := L)).mpr hv
  rw [hq, map_zero]

def quotientGenerator (L : Submodule k V) :
    (V ⧸ L) →ₗ[k] (SymmetricAlgebra k V ⧸ linearIdeal L) :=
  L.liftQ
    ((Ideal.Quotient.mkₐ k (linearIdeal L)).toLinearMap.comp
      (SymmetricAlgebra.ι k V))
    (by
      intro v hv
      rw [LinearMap.mem_ker]
      change Ideal.Quotient.mk (linearIdeal L) (SymmetricAlgebra.ι k V v) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (generator_mem_linearIdeal L hv))

@[simp] theorem quotientGenerator_mkQ (L : Submodule k V) (v : V) :
    quotientGenerator L (L.mkQ v) =
      Ideal.Quotient.mk (linearIdeal L) (SymmetricAlgebra.ι k V v) := by
  rfl

def quotientInverse (L : Submodule k V) :
    SymmetricAlgebra k (V ⧸ L) →ₐ[k]
      (SymmetricAlgebra k V ⧸ linearIdeal L) :=
  SymmetricAlgebra.lift (quotientGenerator L)

def quotientLift (L : Submodule k V) :
    (SymmetricAlgebra k V ⧸ linearIdeal L) →ₐ[k]
      SymmetricAlgebra k (V ⧸ L) :=
  Ideal.Quotient.liftₐ (linearIdeal L) (quotientMap L)
    (fun _ hp => RingHom.mem_ker.mp (linearIdeal_le_ker_quotientMap L hp))

theorem quotientLift_comp_mk (L : Submodule k V) :
    (quotientLift L).comp (Ideal.Quotient.mkₐ k (linearIdeal L)) = quotientMap L := by
  exact Ideal.Quotient.liftₐ_comp (linearIdeal L) (quotientMap L)
    (fun _ hp => RingHom.mem_ker.mp (linearIdeal_le_ker_quotientMap L hp))

theorem quotientLift_comp_quotientInverse (L : Submodule k V) :
    (quotientLift L).comp (quotientInverse L) =
      AlgHom.id k (SymmetricAlgebra k (V ⧸ L)) := by
  apply SymmetricAlgebra.algHom_ext
  apply LinearMap.ext
  intro qv
  obtain ⟨v, rfl⟩ := L.mkQ_surjective qv
  change quotientLift L
      (quotientInverse L (SymmetricAlgebra.ι k (V ⧸ L) (L.mkQ v))) =
    SymmetricAlgebra.ι k (V ⧸ L) (L.mkQ v)
  rw [quotientInverse, SymmetricAlgebra.lift_ι_apply, quotientGenerator_mkQ]
  have h := DFunLike.congr_fun (quotientLift_comp_mk L)
    (SymmetricAlgebra.ι k V v)
  change quotientLift L
      (Ideal.Quotient.mk (linearIdeal L) (SymmetricAlgebra.ι k V v)) =
    quotientMap L (SymmetricAlgebra.ι k V v) at h
  rw [h, quotientMap_ι]

theorem quotientInverse_comp_quotientLift (L : Submodule k V) :
    (quotientInverse L).comp (quotientLift L) =
      AlgHom.id k (SymmetricAlgebra k V ⧸ linearIdeal L) := by
  apply DFunLike.ext'
  funext q
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective k (linearIdeal L) q
  have hcomp : ((quotientInverse L).comp (quotientLift L)).comp
      (Ideal.Quotient.mkₐ k (linearIdeal L)) =
      (AlgHom.id k (SymmetricAlgebra k V ⧸ linearIdeal L)).comp
        (Ideal.Quotient.mkₐ k (linearIdeal L)) := by
    rw [AlgHom.comp_assoc, quotientLift_comp_mk]
    apply SymmetricAlgebra.algHom_ext
    apply LinearMap.ext
    intro v
    simp [quotientMap, quotientInverse, quotientGenerator]
  exact DFunLike.congr_fun hcomp p

def quotientEquiv (L : Submodule k V) :
    (SymmetricAlgebra k V ⧸ linearIdeal L) ≃ₐ[k]
      SymmetricAlgebra k (V ⧸ L) :=
  AlgEquiv.ofAlgHom (quotientLift L) (quotientInverse L)
    (quotientLift_comp_quotientInverse L)
    (quotientInverse_comp_quotientLift L)

theorem ker_quotientMap (L : Submodule k V) :
    RingHom.ker (quotientMap L).toRingHom = linearIdeal L := by
  apply le_antisymm
  · intro p hp
    have hzero : quotientLift L (Ideal.Quotient.mk (linearIdeal L) p) = 0 := by
      have hcomp := DFunLike.congr_fun (quotientLift_comp_mk L) p
      exact hcomp.trans (RingHom.mem_ker.mp hp)
    have hmk : Ideal.Quotient.mk (linearIdeal L) p = 0 :=
      (quotientEquiv L).injective (by simpa [quotientEquiv] using hzero)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
  · exact linearIdeal_le_ker_quotientMap L

end
end SymmetricAlgebraSubmoduleQuotient
end GaloisForLFunctions.HTGeometry
