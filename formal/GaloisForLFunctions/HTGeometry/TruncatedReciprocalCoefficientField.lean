import GaloisForLFunctions.HTGeometry.InverseJetNumerator
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Coefficient fields for truncated polynomial inverses

A polynomial inverse known only modulo `X ^ L` still has all reciprocal coefficients below the
horizon in the field generated by the original coefficients.  This is the field-theoretic form of
the triangular inverse recursion and is the bridge from critical-fibre points to source-field
specializations.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

/-- If `F * G = 1` modulo `X ^ L`, every coefficient of `G` below `L` belongs to any intermediate
field containing all coefficients of `F`. -/
theorem coeff_mem_intermediateField_of_dvd_truncated_inverse
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (S : IntermediateField K E) {L : ℕ} {F G : E[X]}
    (hdvd : (X : E[X]) ^ L ∣ F * G - 1)
    (hF : ∀ k : ℕ, F.coeff k ∈ S) :
    ∀ k : ℕ, k < L → G.coeff k ∈ S := by
  obtain ⟨hzero, hrec⟩ := coeff_recursion_of_dvd hdvd
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
      intro hk
      have hL : 0 < L := Nat.zero_lt_of_lt hk
      have hprod : F.coeff 0 * G.coeff 0 = 1 := hzero hL
      have hFzero : F.coeff 0 ≠ 0 := by
        intro hz
        rw [hz, zero_mul] at hprod
        exact zero_ne_one hprod
      match k with
      | 0 =>
          have heq : G.coeff 0 = (F.coeff 0)⁻¹ := by
            apply (mul_left_cancel₀ hFzero)
            rw [hprod, mul_inv_cancel₀ hFzero]
          rw [heq]
          exact S.inv_mem (hF 0)
      | j + 1 =>
          have hrhs :
              -∑ i ∈ Finset.range (j + 1), F.coeff (i + 1) * G.coeff (j - i) ∈ S := by
            apply S.neg_mem
            apply S.sum_mem
            intro i hi
            exact S.mul_mem (hF (i + 1)) (ih (j - i) (by omega) (by omega))
          have heq :
              G.coeff (j + 1) = (F.coeff 0)⁻¹ *
                (-∑ i ∈ Finset.range (j + 1),
                  F.coeff (i + 1) * G.coeff (j - i)) := by
            rw [← hrec j hk, ← mul_assoc, inv_mul_cancel₀ hFzero, one_mul]
          rw [heq]
          exact S.mul_mem (S.inv_mem (hF 0)) hrhs

end

end GaloisForLFunctions.HTGeometry
