import Mathlib

/-!
# Finite spans in a discrete valuation ring

An element of least additive valuation in a nonempty finite subset of a discrete valuation ring
divides every element of the subset, so the ideal generated by the subset is principal with that
element as generator, and is generated by the corresponding power of any uniformizer.
-/

namespace GaloisForLFunctions.HTGeometry

open IsDiscreteValuationRing

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- An element of least additive valuation in a nonempty finite set divides every element of the
set. -/
theorem exists_dvd_of_finset (S : Finset R) (hS : S.Nonempty) :
    ∃ s ∈ S, ∀ t ∈ S, s ∣ t := by
  obtain ⟨s, hsS, hs⟩ := S.exists_min_image (fun r => addVal R r) hS
  exact ⟨s, hsS, fun t ht => addVal_le_iff_dvd.mp (hs t ht)⟩

/-- The ideal generated by a nonempty finite set is generated by one of its elements. -/
theorem exists_span_finset_eq_span_singleton (S : Finset R) (hS : S.Nonempty) :
    ∃ s ∈ S, Ideal.span (S : Set R) = Ideal.span {s} := by
  obtain ⟨s, hsS, hs⟩ := exists_dvd_of_finset S hS
  refine ⟨s, hsS, le_antisymm ?_ ?_⟩
  · rw [Ideal.span_le]
    intro t ht
    exact Ideal.mem_span_singleton.mpr (hs t (Finset.mem_coe.mp ht))
  · rw [Ideal.span_le]
    rintro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    exact Ideal.subset_span (Finset.mem_coe.mpr hsS)

/-- A nonzero element generates the same ideal as the power of a uniformizer recorded by its
valuation. -/
theorem exists_span_singleton_eq_span_pow {ϖ : R} (hϖ : Irreducible ϖ) {y : R} (hy : y ≠ 0) :
    ∃ n : ℕ, addVal R y = (n : ℕ∞) ∧ Ideal.span {y} = Ideal.span {ϖ ^ n} := by
  obtain ⟨n, u, rfl⟩ := eq_unit_mul_pow_irreducible hy hϖ
  refine ⟨n, addVal_def _ u hϖ n rfl, ?_⟩
  refine Ideal.span_singleton_eq_span_singleton.mpr ⟨u⁻¹, ?_⟩
  rw [mul_comm ((u : R)) (ϖ ^ n), mul_assoc]
  simp

/-- Units have zero valuation. -/
theorem addVal_of_isUnit {u : R} (hu : IsUnit u) : addVal R u = 0 := by
  have h1 : addVal R u ≤ addVal R 1 := addVal_le_iff_dvd.mpr (hu.dvd)
  rw [(addVal R).map_one] at h1
  exact le_antisymm h1 (by simp)

/-- Associated elements have the same valuation. -/
theorem addVal_eq_of_associated {a b : R} (h : Associated a b) : addVal R a = addVal R b := by
  obtain ⟨u, rfl⟩ := h
  rw [(addVal R).map_mul, addVal_of_isUnit u.isUnit, add_zero]

/-- Two generators of the same principal ideal have the same valuation. -/
theorem addVal_eq_of_span_eq {a b : R} (h : Ideal.span {a} = Ideal.span {b}) :
    addVal R a = addVal R b :=
  addVal_eq_of_associated (Ideal.span_singleton_eq_span_singleton.mp h)

/-- The additive valuation of a finite product is the sum of the valuations. -/
theorem addVal_prod {ι : Type*} (s : Finset ι) (f : ι → R) :
    addVal R (∏ i ∈ s, f i) = ∑ i ∈ s, addVal R (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, (addVal R).map_mul, ih]

end GaloisForLFunctions.HTGeometry
