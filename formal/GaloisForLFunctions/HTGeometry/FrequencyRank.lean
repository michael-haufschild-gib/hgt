import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.Analysis.SpecialFunctions.Log.Basic

/-!
# Finite Bohr-frequency rank from finite generators (eq. 9, algebraic conclusion)

The finite-phase theorem concludes `rank_ℚ Γ_B(f) < ∞`: the additive group generated by the Bohr
frequencies of `f` has finite rational rank.  Its algebraic content, once the almost-periodic and
Gamma-differential structure has produced a *finite* set of frequency generators, is that the
`ℚ`-span of a finite set of real frequencies has finite `ℚ`-dimension, bounded by the number of
generators.  That is this file.

The still-open topological step feeding it is the finite jet-sample embedding of the hull into `ℂ^N`
(the covering-dimension / Pontryagin route), which supplies the finite generating set.
-/

namespace GaloisForLFunctions

open scoped BigOperators

/-- **Finite frequency rank.**  The `ℚ`-rank of the frequency module generated by a finite set `S` of
real Bohr frequencies is finite and at most `|S|`. -/
theorem frequencyRank_le_card (S : Finset ℝ) :
    Module.finrank ℚ (Submodule.span ℚ (S : Set ℝ)) ≤ S.card := by
  simpa [Set.finrank] using finrank_span_finset_le_card S

/-- Adjoining one more generator raises the rank by at most one: the finite-rank bound is stable
under enlarging the frequency set by a single frequency. -/
theorem frequencyRank_insert_le (S : Finset ℝ) (a : ℝ) :
    Module.finrank ℚ (Submodule.span ℚ ((insert a S : Finset ℝ) : Set ℝ)) ≤ S.card + 1 :=
  (frequencyRank_le_card (insert a S)).trans (by simpa using Finset.card_insert_le a S)

/-- The finite frequency-rank bound is sharp for a rationally independent frequency packet: its
frequency module has rank exactly the number of spectral lines. -/
theorem frequencyRank_eq_card_of_linearIndependent (S : Finset ℝ)
    (hS : LinearIndependent ℚ ((↑) : S → ℝ)) :
    Module.finrank ℚ (Submodule.span ℚ (S : Set ℝ)) = S.card := by
  rw [show (S : Set ℝ) = Set.range ((↑) : S → ℝ) by ext; simp]
  simpa using finrank_span_eq_card hS

end GaloisForLFunctions
