import Mathlib
import GaloisForLFunctions.HTGeometry.RationalOrderComposition
import GaloisForLFunctions.HTGeometry.RationalOrderValuation

/-!
# The σ-orbit-balance invariant: the abstract divisor core
-/

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp

variable {A : Type*} [DecidableEq A]

noncomputable section

/-- The shift-difference (coboundary) divisor `Δn(γ) = n(sh γ) − n(γ)`. -/
def shiftDiff (sh : Equiv.Perm A) (n : A →₀ ℤ) : A →₀ ℤ :=
  Finsupp.comapDomain sh n (sh.injective.injOn) - n

@[simp] theorem shiftDiff_apply (sh : Equiv.Perm A) (n : A →₀ ℤ) (γ : A) :
    shiftDiff sh n γ = n (sh γ) - n γ := by
  rw [shiftDiff, Finsupp.sub_apply, Finsupp.comapDomain_apply]

/-- A divisor is a shift coboundary when it is the shift-difference of some divisor. -/
def IsShiftCoboundary (sh : Equiv.Perm A) (D : A →₀ ℤ) : Prop :=
  ∃ n : A →₀ ℤ, D = shiftDiff sh n

theorem shiftDiff_zero (sh : Equiv.Perm A) : shiftDiff sh 0 = 0 := by
  ext γ; simp

theorem shiftDiff_add (sh : Equiv.Perm A) (n m : A →₀ ℤ) :
    shiftDiff sh (n + m) = shiftDiff sh n + shiftDiff sh m := by
  ext γ; simp; ring

theorem shiftDiff_neg (sh : Equiv.Perm A) (n : A →₀ ℤ) :
    shiftDiff sh (-n) = -shiftDiff sh n := by
  ext γ; simp; ring

theorem shiftDiff_sub (sh : Equiv.Perm A) (n m : A →₀ ℤ) :
    shiftDiff sh (n - m) = shiftDiff sh n - shiftDiff sh m := by
  ext γ; simp; ring

theorem shiftDiff_zsmul (sh : Equiv.Perm A) (c : ℤ) (n : A →₀ ℤ) :
    shiftDiff sh (c • n) = c • shiftDiff sh n := by
  ext γ; simp [mul_sub]

theorem isShiftCoboundary_zero (sh : Equiv.Perm A) : IsShiftCoboundary sh 0 :=
  ⟨0, (shiftDiff_zero sh).symm⟩

theorem IsShiftCoboundary.add {sh : Equiv.Perm A} {D E : A →₀ ℤ}
    (hD : IsShiftCoboundary sh D) (hE : IsShiftCoboundary sh E) :
    IsShiftCoboundary sh (D + E) := by
  obtain ⟨n, rfl⟩ := hD
  obtain ⟨m, rfl⟩ := hE
  exact ⟨n + m, (shiftDiff_add sh n m).symm⟩

theorem IsShiftCoboundary.sub {sh : Equiv.Perm A} {D E : A →₀ ℤ}
    (hD : IsShiftCoboundary sh D) (hE : IsShiftCoboundary sh E) :
    IsShiftCoboundary sh (D - E) := by
  obtain ⟨n, rfl⟩ := hD
  obtain ⟨m, rfl⟩ := hE
  exact ⟨n - m, (shiftDiff_sub sh n m).symm⟩

theorem IsShiftCoboundary.zsmul {sh : Equiv.Perm A} {D : A →₀ ℤ} (c : ℤ)
    (hD : IsShiftCoboundary sh D) : IsShiftCoboundary sh (c • D) := by
  obtain ⟨n, rfl⟩ := hD
  exact ⟨c • n, (shiftDiff_zsmul sh c n).symm⟩

/-- **The unit step is a coboundary.**  `[δ] − [sh δ] = Δ(single (sh δ) 1)`. -/
theorem shiftDiff_single_shift (sh : Equiv.Perm A) (δ : A) :
    shiftDiff sh (Finsupp.single (sh δ) 1)
      = Finsupp.single δ 1 - Finsupp.single (sh δ) (1 : ℤ) := by
  ext γ
  rw [shiftDiff_apply, Finsupp.sub_apply, Finsupp.single_apply, Finsupp.single_apply,
    Finsupp.single_apply]
  by_cases h : γ = δ
  · subst h
    simp
  · have h2 : sh δ ≠ sh γ := fun hc => h (sh.injective hc).symm
    simp [Ne.symm h, h2]

/-- **Any two points of one orbit differ by a coboundary.** -/
theorem isShiftCoboundary_pair (sh : Equiv.Perm A) (δ : A) (k : ℤ) :
    IsShiftCoboundary sh (Finsupp.single δ 1 - Finsupp.single ((sh ^ k) δ) (1 : ℤ)) := by
  induction k using Int.induction_on with
  | zero => simpa using isShiftCoboundary_zero sh
  | succ k ih =>
      have hstep : (sh ^ ((k : ℤ) + 1)) δ = sh ((sh ^ (k : ℤ)) δ) := by
        rw [show ((k : ℤ) + 1) = 1 + (k : ℤ) by ring, zpow_add, zpow_one,
          Equiv.Perm.mul_apply]
      have hsplit : (Finsupp.single δ 1 - Finsupp.single ((sh ^ ((k : ℤ) + 1)) δ) (1 : ℤ))
          = (Finsupp.single δ 1 - Finsupp.single ((sh ^ (k : ℤ)) δ) (1 : ℤ))
            + (Finsupp.single ((sh ^ (k : ℤ)) δ) 1
              - Finsupp.single (sh ((sh ^ (k : ℤ)) δ)) (1 : ℤ)) := by
        rw [hstep]; abel
      rw [hsplit]
      exact ih.add ⟨_, (shiftDiff_single_shift sh ((sh ^ (k : ℤ)) δ)).symm⟩
  | pred k ih =>
      have hstep : (sh ^ (-(k : ℤ))) δ = sh ((sh ^ (-(k : ℤ) - 1)) δ) := by
        have haux : sh ((sh ^ (-(k : ℤ) - 1)) δ) = (sh ^ (1 + (-(k : ℤ) - 1))) δ := by
          rw [zpow_add, zpow_one, Equiv.Perm.mul_apply]
        rw [haux, show (1 + (-(k : ℤ) - 1)) = -(k : ℤ) by ring]
      have hsplit : (Finsupp.single δ 1 - Finsupp.single ((sh ^ (-(k : ℤ) - 1)) δ) (1 : ℤ))
          = (Finsupp.single δ 1 - Finsupp.single ((sh ^ (-(k : ℤ))) δ) (1 : ℤ))
            - (Finsupp.single ((sh ^ (-(k : ℤ) - 1)) δ) 1
              - Finsupp.single (sh ((sh ^ (-(k : ℤ) - 1)) δ)) (1 : ℤ)) := by
        rw [← hstep]; abel
      rw [hsplit]
      exact ih.sub ⟨_, (shiftDiff_single_shift sh ((sh ^ (-(k : ℤ) - 1)) δ)).symm⟩

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp

variable {A : Type*} [DecidableEq A]

noncomputable section

/-- The `ℤ`-action generated by `sh` is free. -/
def IsFreeShift (sh : Equiv.Perm A) : Prop := ∀ (k : ℤ) (β : A), (sh ^ k) β = β → k = 0

theorem injective_orbitMap {sh : Equiv.Perm A} (hfree : IsFreeShift sh) (β : A) :
    Function.Injective fun k : ℤ => (sh ^ k) β := by
  intro k l h
  simp only at h
  have hsub : (sh ^ (k - l)) β = β := by
    have h1 : (sh ^ (k - l)) β = (sh ^ (-l)) ((sh ^ k) β) := by
      rw [← Equiv.Perm.mul_apply, ← zpow_add]
      congr 2
      ring
    rw [h1, h, ← Equiv.Perm.mul_apply, ← zpow_add]
    simp
  have := hfree _ _ hsub
  omega

theorem hasFiniteSupport_orbit {sh : Equiv.Perm A} (hfree : IsFreeShift sh)
    (D : A →₀ ℤ) (β : A) :
    Function.HasFiniteSupport (fun k : ℤ => D ((sh ^ k) β)) := by
  have hsub : Function.support (fun k : ℤ => D ((sh ^ k) β))
      ⊆ (fun k : ℤ => (sh ^ k) β) ⁻¹' (↑D.support : Set A) := by
    intro k hk
    exact Finsupp.mem_support_iff.mpr hk
  refine Set.Finite.subset ?_ hsub
  exact Set.Finite.preimage ((injective_orbitMap hfree β).injOn) D.support.finite_toSet

/-- The `σ`-orbit degree of a divisor at a base point. -/
def orbitSum (sh : Equiv.Perm A) (D : A →₀ ℤ) (β : A) : ℤ := ∑ᶠ k : ℤ, D ((sh ^ k) β)

theorem orbitSum_sub {sh : Equiv.Perm A} (hfree : IsFreeShift sh) (D E : A →₀ ℤ) (β : A) :
    orbitSum sh (D - E) β = orbitSum sh D β - orbitSum sh E β := by
  rw [orbitSum, orbitSum, orbitSum]
  have := finsum_sub_distrib (f := fun k : ℤ => D ((sh ^ k) β))
    (g := fun k : ℤ => E ((sh ^ k) β)) (hasFiniteSupport_orbit hfree D β)
    (hasFiniteSupport_orbit hfree E β)
  simpa using this

/-- **A shift coboundary is orbit-balanced.**  This is the `im(Δ) ⊆ ker(deg)` half. -/
theorem orbitSum_shiftDiff {sh : Equiv.Perm A} (hfree : IsFreeShift sh) (n : A →₀ ℤ) (β : A) :
    orbitSum sh (shiftDiff sh n) β = 0 := by
  classical
  set f : ℤ → ℤ := fun k => n ((sh ^ k) β) with hf
  have hfin : Function.HasFiniteSupport f := hasFiniteSupport_orbit hfree n β
  have hstep : ∀ k : ℤ, shiftDiff sh n ((sh ^ k) β) = f (k + 1) - f k := by
    intro k
    rw [shiftDiff_apply, hf]
    congr 2
    rw [show (k + 1 : ℤ) = 1 + k by ring, zpow_add, zpow_one, Equiv.Perm.mul_apply]
  have hshiftfin : Function.HasFiniteSupport (fun k : ℤ => f (k + 1)) := by
    have hsub : Function.support (fun k : ℤ => f (k + 1))
        ⊆ (fun k : ℤ => k + 1) ⁻¹' Function.support f := fun k hk => hk
    exact Set.Finite.subset
      (Set.Finite.preimage ((add_left_injective (1 : ℤ)).injOn) hfin) hsub
  have hreindex : ∑ᶠ k : ℤ, f (k + 1) = ∑ᶠ k : ℤ, f k :=
    finsum_comp_equiv (Equiv.addRight (1 : ℤ)) (f := f)
  rw [orbitSum]
  calc ∑ᶠ k : ℤ, shiftDiff sh n ((sh ^ k) β)
      = ∑ᶠ k : ℤ, (f (k + 1) - f k) := by
        exact finsum_congr hstep
    _ = (∑ᶠ k : ℤ, f (k + 1)) - ∑ᶠ k : ℤ, f k := finsum_sub_distrib hshiftfin hfin
    _ = 0 := by rw [hreindex, sub_self]

theorem orbitSum_of_isShiftCoboundary {sh : Equiv.Perm A} (hfree : IsFreeShift sh)
    {D : A →₀ ℤ} (hD : IsShiftCoboundary sh D) (β : A) : orbitSum sh D β = 0 := by
  obtain ⟨n, rfl⟩ := hD
  exact orbitSum_shiftDiff hfree n β

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp

variable {A : Type*} [DecidableEq A]

noncomputable section

/-- An orbit-balanced divisor with a nonzero coefficient has a second nonzero coefficient on the
same orbit. -/
theorem exists_partner {sh : Equiv.Perm A} {D : A →₀ ℤ} {γ₀ : A}
    (hbal : orbitSum sh D γ₀ = 0) (hne : D γ₀ ≠ 0) :
    ∃ k : ℤ, k ≠ 0 ∧ D ((sh ^ k) γ₀) ≠ 0 := by
  by_contra hcon
  have hcon' : ∀ k : ℤ, k ≠ 0 → D ((sh ^ k) γ₀) = 0 := by
    intro k hk
    by_contra hc
    exact hcon ⟨k, hk, hc⟩
  have hsingle : ∑ᶠ k : ℤ, D ((sh ^ k) γ₀) = D ((sh ^ (0 : ℤ)) γ₀) :=
    finsum_eq_single _ 0 (fun k hk => hcon' k hk)
  rw [orbitSum, hsingle] at hbal
  simp only [zpow_zero, Equiv.Perm.coe_one, id_eq] at hbal
  exact hne hbal

/-- **The complete σ-orbit-balance criterion, divisor form (`ker(deg) ⊆ im(Δ)`).**
Every orbit-balanced finitely supported integer divisor is a shift coboundary. -/
theorem isShiftCoboundary_of_orbitSum_eq_zero {sh : Equiv.Perm A} (hfree : IsFreeShift sh) :
    ∀ (N : ℕ) (D : A →₀ ℤ), D.support.card ≤ N → (∀ β : A, orbitSum sh D β = 0) →
      IsShiftCoboundary sh D := by
  intro N
  induction N with
  | zero =>
      intro D hcard _
      have hD : D = 0 := by
        rw [← Finsupp.support_eq_empty]
        exact Finset.card_eq_zero.mp (Nat.le_zero.mp hcard)
      rw [hD]
      exact isShiftCoboundary_zero sh
  | succ N ih =>
      intro D hcard hbal
      rcases eq_or_ne D 0 with rfl | hD
      · exact isShiftCoboundary_zero sh
      obtain ⟨γ₀, hγ₀⟩ := Finsupp.support_nonempty_iff.mpr hD
      have hne : D γ₀ ≠ 0 := Finsupp.mem_support_iff.mp hγ₀
      obtain ⟨k, hk0, hk⟩ := exists_partner (hbal γ₀) hne
      have hshne : (sh ^ k) γ₀ ≠ γ₀ := fun hc => hk0 (hfree k γ₀ hc)
      set E : A →₀ ℤ :=
        (D γ₀) • (Finsupp.single γ₀ 1 - Finsupp.single ((sh ^ k) γ₀) (1 : ℤ)) with hEdef
      have hEcob : IsShiftCoboundary sh E :=
        IsShiftCoboundary.zsmul (D γ₀) (isShiftCoboundary_pair sh γ₀ k)
      have hEapp : ∀ γ : A, E γ
          = (D γ₀) * ((Finsupp.single γ₀ (1 : ℤ)) γ - (Finsupp.single ((sh ^ k) γ₀) (1 : ℤ)) γ) := by
        intro γ
        rw [hEdef, Finsupp.smul_apply, Finsupp.sub_apply, smul_eq_mul]
      have hEbal : ∀ β : A, orbitSum sh E β = 0 :=
        fun β => orbitSum_of_isShiftCoboundary hfree hEcob β
      set D' : A →₀ ℤ := D - E with hD'def
      have hD'bal : ∀ β : A, orbitSum sh D' β = 0 := by
        intro β
        rw [hD'def, orbitSum_sub hfree, hbal β, hEbal β, sub_zero]
      have hzero : D' γ₀ = 0 := by
        rw [hD'def, Finsupp.sub_apply, hEapp γ₀, Finsupp.single_eq_same,
          Finsupp.single_eq_of_ne (Ne.symm hshne)]
        ring
      have hsupp : D'.support ⊆ D.support.erase γ₀ := by
        intro γ hγ
        have hγne : D' γ ≠ 0 := Finsupp.mem_support_iff.mp hγ
        have hγγ₀ : γ ≠ γ₀ := by
          rintro rfl
          exact hγne hzero
        refine Finset.mem_erase.mpr ⟨hγγ₀, ?_⟩
        by_contra hcon
        have hDγ : D γ = 0 := Finsupp.notMem_support_iff.mp hcon
        have hpartner : (sh ^ k) γ₀ ∈ D.support := Finsupp.mem_support_iff.mpr hk
        have hγpartner : γ ≠ (sh ^ k) γ₀ := by
          rintro rfl
          exact hcon hpartner
        apply hγne
        rw [hD'def, Finsupp.sub_apply, hDγ, hEapp γ, Finsupp.single_eq_of_ne hγγ₀,
          Finsupp.single_eq_of_ne hγpartner]
        ring
      have hcard' : D'.support.card ≤ N := by
        have h1 : D'.support.card ≤ (D.support.erase γ₀).card := Finset.card_le_card hsupp
        have h2 : (D.support.erase γ₀).card = D.support.card - 1 :=
          Finset.card_erase_of_mem hγ₀
        have h3 : 1 ≤ D.support.card := Finset.card_pos.mpr ⟨γ₀, hγ₀⟩
        omega
      have hD'cob : IsShiftCoboundary sh D' := ih D' hcard' hD'bal
      have hDeq : D = D' + E := by rw [hD'def]; abel
      rw [hDeq]
      exact hD'cob.add hEcob

/-- **The complete σ-orbit-balance criterion, divisor form.**  A finitely supported integer divisor
is a shift coboundary if and only if every `σ`-orbit degree vanishes. -/
theorem isShiftCoboundary_iff_orbitSum_eq_zero {sh : Equiv.Perm A} (hfree : IsFreeShift sh)
    (D : A →₀ ℤ) : IsShiftCoboundary sh D ↔ ∀ β : A, orbitSum sh D β = 0 :=
  ⟨fun h β => orbitSum_of_isShiftCoboundary hfree h β,
    fun h => isShiftCoboundary_of_orbitSum_eq_zero hfree D.support.card D le_rfl h⟩

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp Polynomial GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## The shift substitution on `ℂ(z)` -/

/-- The shift polynomial `z + 1`. -/
def shiftPoly : ℂ[X] := X + C 1

theorem shiftPoly_natDegree : shiftPoly.natDegree = 1 := by
  rw [shiftPoly, natDegree_X_add_C]

theorem shiftPoly_not_const :
    ¬ ∃ c : ℂ, (algebraMap ℂ[X] (RatFunc ℂ) shiftPoly) = RatFunc.C c := by
  rintro ⟨c, hc⟩
  have hpoly : shiftPoly = C c := by
    apply RatFunc.algebraMap_injective ℂ
    rw [hc, RatFunc.algebraMap_C]
  have hdeg : shiftPoly.natDegree = 0 := by rw [hpoly, natDegree_C]
  rw [shiftPoly_natDegree] at hdeg
  exact one_ne_zero hdeg

/-- The shift substitution `z ↦ z + 1` on `ℂ(z)`. -/
def shiftHom : RatFunc ℂ →ₐ[ℂ] RatFunc ℂ :=
  ratFuncSubstitutionAlgHom (algebraMap ℂ[X] (RatFunc ℂ) shiftPoly) shiftPoly_not_const

theorem shiftHom_ne_zero {Q : RatFunc ℂ} (hQ : Q ≠ 0) : shiftHom Q ≠ 0 := by
  intro h
  exact hQ ((shiftHom : RatFunc ℂ →ₐ[ℂ] RatFunc ℂ).toRingHom.injective (by simpa using h))

/-- **The order transports along the shift:** `ord_a(Q(z+1)) = ord_{a+1}(Q)`. -/
theorem ratOrder_shiftHom {Q : RatFunc ℂ} (hQ : Q ≠ 0) (a : ℂ) :
    ratOrder (shiftHom Q) a = ratOrder Q (a + 1) := by
  classical
  have hdeg : shiftPoly.natDegree ≠ 0 := by rw [shiftPoly_natDegree]; exact one_ne_zero
  have heval : shiftPoly.eval a = a + 1 := by simp [shiftPoly]
  have hsub : shiftPoly - C (shiftPoly.eval a) = X - C a := by
    rw [heval, shiftPoly]
    rw [show (C (a + 1) : ℂ[X]) = C a + C 1 by rw [map_add]]
    ring
  rw [shiftHom, ratOrder_ratFuncSubstitution hdeg shiftPoly_not_const hQ a, hsub,
    rootMultiplicity_X_sub_C_self, heval]
  simp

/-! ## The divisor of a rational function -/

theorem finite_support_ratOrder_all (Q : RatFunc ℂ) :
    (Function.support fun c : ℂ => ratOrder Q c).Finite := by
  rcases eq_or_ne Q 0 with rfl | hQ
  · have : (Function.support fun c : ℂ => ratOrder (0 : RatFunc ℂ) c) = ∅ := by
      ext c
      simp [ratOrder, RatFunc.num_zero, RatFunc.denom_zero]
    rw [this]
    exact Set.finite_empty
  · exact finite_support_ratOrder hQ

/-- The divisor of a rational function, as a finitely supported integer-valued function. -/
def ratDivisor (Q : RatFunc ℂ) : ℂ →₀ ℤ :=
  Finsupp.ofSupportFinite (fun c => ratOrder Q c) (finite_support_ratOrder_all Q)

@[simp] theorem ratDivisor_apply (Q : RatFunc ℂ) (c : ℂ) : ratDivisor Q c = ratOrder Q c := by
  rw [ratDivisor, Finsupp.ofSupportFinite_coe]

/-- The shift permutation `β ↦ β + 1` of the complex plane. -/
def cShift : Equiv.Perm ℂ := Equiv.addRight (1 : ℂ)

@[simp] theorem cShift_apply (β : ℂ) : cShift β = β + 1 := rfl

theorem cShift_zpow (k : ℤ) (β : ℂ) : (cShift ^ k) β = β + (k : ℂ) := by
  induction k using Int.induction_on with
  | zero => simp
  | succ k ih =>
      have hstep : (cShift ^ ((k : ℤ) + 1)) β = cShift ((cShift ^ (k : ℤ)) β) := by
        rw [show ((k : ℤ) + 1) = 1 + (k : ℤ) by ring, zpow_add, zpow_one, Equiv.Perm.mul_apply]
      rw [hstep, ih, cShift_apply]
      push_cast
      ring
  | pred k ih =>
      have hstep : (cShift ^ (-(k : ℤ))) β = cShift ((cShift ^ (-(k : ℤ) - 1)) β) := by
        have haux : cShift ((cShift ^ (-(k : ℤ) - 1)) β) = (cShift ^ (1 + (-(k : ℤ) - 1))) β := by
          rw [zpow_add, zpow_one, Equiv.Perm.mul_apply]
        rw [haux, show (1 + (-(k : ℤ) - 1)) = -(k : ℤ) by ring]
      have hval : (cShift ^ (-(k : ℤ) - 1)) β = (cShift ^ (-(k : ℤ))) β - 1 := by
        rw [hstep, cShift_apply]
        ring
      rw [hval, ih]
      push_cast
      ring

theorem isFreeShift_cShift : IsFreeShift cShift := by
  intro k β h
  rw [cShift_zpow] at h
  have : (k : ℂ) = 0 := by linear_combination h
  exact_mod_cast this

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp Polynomial GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## Prescribing a divisor -/

/-- The linear factor `z − γ` as a rational function. -/
def linFactor (γ : ℂ) : RatFunc ℂ := algebraMap ℂ[X] (RatFunc ℂ) (X - C γ)

theorem linFactor_ne_zero (γ : ℂ) : linFactor γ ≠ 0 := by
  rw [linFactor]
  intro h
  have := RatFunc.algebraMap_injective ℂ (by rw [h, map_zero] :
    algebraMap ℂ[X] (RatFunc ℂ) (X - C γ) = algebraMap ℂ[X] (RatFunc ℂ) 0)
  exact X_sub_C_ne_zero γ this

theorem ratOrder_linFactor (γ c : ℂ) :
    ratOrder (linFactor γ) c = if c = γ then 1 else 0 := by
  classical
  rw [linFactor, ratOrder_algebraMap, rootMultiplicity_X_sub_C]
  split_ifs <;> simp

theorem ratOrder_prod {ι : Type*} (s : Finset ι) (f : ι → RatFunc ℂ)
    (hf : ∀ i ∈ s, f i ≠ 0) (c : ℂ) :
    ratOrder (∏ i ∈ s, f i) c = ∑ i ∈ s, ratOrder (f i) c := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      have hprodne : (∏ i ∈ s, f i) ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun i hi => hf i (Finset.mem_insert_of_mem hi)
      rw [Finset.prod_insert ha, Finset.sum_insert ha,
        ratOrder_mul (hf a (Finset.mem_insert_self a s)) hprodne,
        ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))]

/-- The rational function with prescribed divisor `n`. -/
def divisorRat (n : ℂ →₀ ℤ) : RatFunc ℂ := n.prod fun γ k => (linFactor γ) ^ k

theorem divisorRat_ne_zero (n : ℂ →₀ ℤ) : divisorRat n ≠ 0 := by
  rw [divisorRat, Finsupp.prod]
  exact Finset.prod_ne_zero_iff.mpr fun γ _ => zpow_ne_zero _ (linFactor_ne_zero γ)

/-- **Every finitely supported integer divisor is realized.** -/
theorem ratOrder_divisorRat (n : ℂ →₀ ℤ) (c : ℂ) : ratOrder (divisorRat n) c = n c := by
  classical
  rw [divisorRat, Finsupp.prod,
    ratOrder_prod _ _ (fun γ _ => zpow_ne_zero _ (linFactor_ne_zero γ)) c]
  have hterm : ∀ γ ∈ n.support,
      ratOrder ((linFactor γ) ^ (n γ)) c = if γ = c then n γ else 0 := by
    intro γ _
    rw [ratOrder_zpow (linFactor_ne_zero γ), ratOrder_linFactor]
    by_cases h : c = γ
    · simp [h]
    · simp [h, Ne.symm h]
  rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq' n.support c (fun γ => n γ)]
  by_cases h : c ∈ n.support
  · rw [if_pos h]
  · rw [if_neg h]
    exact (Finsupp.notMem_support_iff.mp h).symm

@[simp] theorem ratDivisor_divisorRat (n : ℂ →₀ ℤ) : ratDivisor (divisorRat n) = n := by
  ext c
  rw [ratDivisor_apply, ratOrder_divisorRat]

/-! ## The divisor of a shift quotient -/

theorem ratDivisor_shiftQuotient {g : RatFunc ℂ} (hg : g ≠ 0) :
    ratDivisor (shiftHom g / g) = shiftDiff cShift (ratDivisor g) := by
  ext c
  rw [ratDivisor_apply, shiftDiff_apply, ratDivisor_apply, ratDivisor_apply, cShift_apply,
    div_eq_mul_inv, ratOrder_mul (shiftHom_ne_zero hg) (inv_ne_zero hg), ratOrder_inv hg,
    ratOrder_shiftHom hg]
  ring

/-- A rational function with everywhere vanishing order is a nonzero constant. -/
theorem eq_C_of_ratOrder_eq_zero {Q : RatFunc ℂ} (hQ : Q ≠ 0)
    (h : ∀ c : ℂ, ratOrder Q c = 0) : ∃ c : ℂ, c ≠ 0 ∧ Q = RatFunc.C c := by
  classical
  have hnum : Q.num ≠ 0 := RatFunc.num_ne_zero hQ
  have hden : Q.denom ≠ 0 := RatFunc.denom_ne_zero Q
  have hconst : ∀ p : ℂ[X], p ≠ 0 → (∀ c : ℂ, ¬ p.IsRoot c) → ∃ b : ℂ, b ≠ 0 ∧ p = C b := by
    intro p hp hroot
    have hdeg : ¬ (0 < p.degree) := by
      intro hd
      obtain ⟨z, hz⟩ := Complex.exists_root hd
      exact hroot z hz
    have hnat : p.natDegree = 0 := by
      rw [Polynomial.natDegree_eq_zero_iff_degree_le_zero]
      exact not_lt.mp hdeg
    refine ⟨p.coeff 0, ?_, eq_C_of_natDegree_eq_zero hnat⟩
    intro hc
    apply hp
    rw [eq_C_of_natDegree_eq_zero hnat, hc, map_zero]
  obtain ⟨a, ha, hnumeq⟩ := hconst Q.num hnum (fun c => ((ratOrder_eq_zero_iff hQ c).mp (h c)).1)
  obtain ⟨b, hb, hdeneq⟩ := hconst Q.denom hden (fun c => ((ratOrder_eq_zero_iff hQ c).mp (h c)).2)
  refine ⟨a / b, div_ne_zero ha hb, ?_⟩
  have hQeq : Q = algebraMap ℂ[X] (RatFunc ℂ) Q.num / algebraMap ℂ[X] (RatFunc ℂ) Q.denom :=
    (RatFunc.num_div_denom Q).symm
  rw [hQeq, hnumeq, hdeneq, RatFunc.algebraMap_C, RatFunc.algebraMap_C, ← map_div₀]

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp Polynomial GaloisForLFunctions.HTGeometry

noncomputable section

/-- **Constant-up-to-coboundary.**  The multiplier of a rank-one difference module is gauge-trivial
exactly when it has this shape. -/
def IsCC (a : RatFunc ℂ) : Prop :=
  ∃ (c : ℂ) (g : RatFunc ℂ), c ≠ 0 ∧ g ≠ 0 ∧ a = RatFunc.C c * (shiftHom g / g)

/-- The `σ`-orbit degree of `div(a)` at the base point `β`: `deg_O(a) = Σ_{k ∈ ℤ} ord_{β+k}(a)`. -/
def orbitDegree (a : RatFunc ℂ) (β : ℂ) : ℤ := ∑ᶠ k : ℤ, ratOrder a (β + (k : ℂ))

theorem orbitDegree_eq_orbitSum (a : RatFunc ℂ) (β : ℂ) :
    orbitDegree a β = orbitSum cShift (ratDivisor a) β := by
  rw [orbitDegree, orbitSum]
  exact finsum_congr fun k => by rw [cShift_zpow, ratDivisor_apply]

/-- **Theorem (σ-orbit-balance = the complete CC-invariant).**
A nonzero rational function is a constant times a shift coboundary if and only if its divisor has
degree zero on every `σ`-orbit. -/
theorem isCC_iff_orbitDegree_eq_zero {a : RatFunc ℂ} (ha : a ≠ 0) :
    IsCC a ↔ ∀ β : ℂ, orbitDegree a β = 0 := by
  constructor
  · rintro ⟨c, g, hc, hg, rfl⟩ β
    rw [orbitDegree_eq_orbitSum]
    have hCne : (RatFunc.C c : RatFunc ℂ) ≠ 0 := by
      simpa using hc
    have hquot : shiftHom g / g ≠ 0 := div_ne_zero (shiftHom_ne_zero hg) hg
    have hdiv : ratDivisor (RatFunc.C c * (shiftHom g / g)) = shiftDiff cShift (ratDivisor g) := by
      ext x
      rw [ratDivisor_apply, ratOrder_mul hCne hquot, ratOrder_C, zero_add, ← ratDivisor_apply,
        ratDivisor_shiftQuotient hg]
    rw [hdiv]
    exact orbitSum_shiftDiff isFreeShift_cShift _ β
  · intro hbal
    have hbal' : ∀ β : ℂ, orbitSum cShift (ratDivisor a) β = 0 := by
      intro β
      rw [← orbitDegree_eq_orbitSum]
      exact hbal β
    obtain ⟨n, hn⟩ :=
      (isShiftCoboundary_iff_orbitSum_eq_zero isFreeShift_cShift (ratDivisor a)).mpr hbal'
    have hg : divisorRat n ≠ 0 := divisorRat_ne_zero n
    have hquot : shiftHom (divisorRat n) / divisorRat n ≠ 0 :=
      div_ne_zero (shiftHom_ne_zero hg) hg
    have hu : a / (shiftHom (divisorRat n) / divisorRat n) ≠ 0 := div_ne_zero ha hquot
    have hord : ∀ x : ℂ, ratOrder (a / (shiftHom (divisorRat n) / divisorRat n)) x = 0 := by
      intro x
      rw [div_eq_mul_inv, ratOrder_mul ha (inv_ne_zero hquot), ratOrder_inv hquot,
        ← ratDivisor_apply, ← ratDivisor_apply, ratDivisor_shiftQuotient hg,
        ratDivisor_divisorRat, ← hn]
      ring
    obtain ⟨c, hc, huc⟩ := eq_C_of_ratOrder_eq_zero hu hord
    refine ⟨c, divisorRat n, hc, hg, ?_⟩
    rw [← huc, div_mul_cancel₀ _ hquot]

/-! ## Consequences -/

/-- **The degree-at-infinity test is the summed shadow.**  A CC multiplier has total divisor degree
zero on `ℂ`; equivalently `deg_∞(a) = 0`. -/
theorem total_degree_eq_zero_of_isCC {a : RatFunc ℂ} (h : IsCC a) :
    ∑ᶠ c : ℂ, ratOrder a c = 0 := by
  obtain ⟨c, g, hc, hg, rfl⟩ := h
  have hCne : (RatFunc.C c : RatFunc ℂ) ≠ 0 := by simpa using hc
  have hquot : shiftHom g / g ≠ 0 := div_ne_zero (shiftHom_ne_zero hg) hg
  have hdiv : ∀ x : ℂ, ratOrder (RatFunc.C c * (shiftHom g / g)) x
      = ratDivisor g (x + 1) - ratDivisor g x := by
    intro x
    rw [ratOrder_mul hCne hquot, ratOrder_C, zero_add, ← ratDivisor_apply,
      ratDivisor_shiftQuotient hg, shiftDiff_apply, cShift_apply]
  have hfin : Function.HasFiniteSupport (fun x : ℂ => ratDivisor g x) :=
    (ratDivisor g).hasFiniteSupport
  have hfin' : Function.HasFiniteSupport (fun x : ℂ => ratDivisor g (x + 1)) := by
    have hsub : Function.support (fun x : ℂ => ratDivisor g (x + 1))
        ⊆ (fun x : ℂ => x + 1) ⁻¹' Function.support (fun x : ℂ => ratDivisor g x) :=
      fun x hx => hx
    exact Set.Finite.subset
      (Set.Finite.preimage ((add_left_injective (1 : ℂ)).injOn) hfin) hsub
  calc ∑ᶠ x : ℂ, ratOrder (RatFunc.C c * (shiftHom g / g)) x
      = ∑ᶠ x : ℂ, (ratDivisor g (x + 1) - ratDivisor g x) := finsum_congr hdiv
    _ = (∑ᶠ x : ℂ, ratDivisor g (x + 1)) - ∑ᶠ x : ℂ, ratDivisor g x :=
        finsum_sub_distrib hfin' hfin
    _ = 0 := by
        have hre : ∑ᶠ x : ℂ, ratDivisor g (x + 1) = ∑ᶠ x : ℂ, ratDivisor g x :=
          finsum_comp_equiv (Equiv.addRight (1 : ℂ)) (f := fun x : ℂ => ratDivisor g x)
        rw [hre, sub_self]

theorem ratOrder_ratFuncX (c : ℂ) :
    ratOrder (RatFunc.X : RatFunc ℂ) c = if c = 0 then 1 else 0 := by
  classical
  rw [← RatFunc.algebraMap_X, ratOrder_algebraMap,
    show (X : ℂ[X]) = X - C 0 by simp, rootMultiplicity_X_sub_C]
  split_ifs <;> simp

/-- **The Γ-multiplier is orbit-unbalanced, and its imbalance is localized to the orbit `ℤ`.** -/
theorem orbitDegree_ratFuncX_zero : orbitDegree (RatFunc.X : RatFunc ℂ) 0 = 1 := by
  classical
  rw [orbitDegree]
  have hsingle : ∑ᶠ k : ℤ, ratOrder (RatFunc.X : RatFunc ℂ) ((0 : ℂ) + (k : ℂ))
      = ratOrder (RatFunc.X : RatFunc ℂ) ((0 : ℂ) + ((0 : ℤ) : ℂ)) := by
    refine finsum_eq_single _ 0 (fun k hk => ?_)
    rw [ratOrder_ratFuncX, if_neg]
    simpa using hk
  rw [hsingle, ratOrder_ratFuncX]
  simp

theorem not_isCC_ratFuncX : ¬ IsCC (RatFunc.X : RatFunc ℂ) := by
  intro h
  have hX : (RatFunc.X : RatFunc ℂ) ≠ 0 := RatFunc.X_ne_zero
  have := (isCC_iff_orbitDegree_eq_zero hX).mp h 0
  rw [orbitDegree_ratFuncX_zero] at this
  exact one_ne_zero this

/-- **Every constant multiplier is CC — the prime lanes are orbit-balanced.** -/
theorem isCC_ratFuncC {c : ℂ} (hc : c ≠ 0) : IsCC (RatFunc.C c : RatFunc ℂ) :=
  ⟨c, 1, hc, one_ne_zero, by rw [map_one, div_one, mul_one]⟩

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp Polynomial GaloisForLFunctions.HTGeometry

noncomputable section

/-! ## The `q`-orbit analog on the prime lanes -/

/-- The dilation polynomial `q·z`. -/
def qPoly (q : ℂ) : ℂ[X] := C q * X

theorem qPoly_natDegree {q : ℂ} (hq : q ≠ 0) : (qPoly q).natDegree = 1 := by
  rw [qPoly, natDegree_C_mul (by simpa using hq), natDegree_X]

theorem qPoly_not_const {q : ℂ} (hq : q ≠ 0) :
    ¬ ∃ c : ℂ, (algebraMap ℂ[X] (RatFunc ℂ) (qPoly q)) = RatFunc.C c := by
  rintro ⟨c, hc⟩
  have hpoly : qPoly q = C c := by
    apply RatFunc.algebraMap_injective ℂ
    rw [hc, RatFunc.algebraMap_C]
  have hdeg : (qPoly q).natDegree = 0 := by rw [hpoly, natDegree_C]
  rw [qPoly_natDegree hq] at hdeg
  exact one_ne_zero hdeg

/-- The `q`-dilation substitution `z ↦ q z` on `ℂ(z)`. -/
def qHom (q : ℂ) (hq : q ≠ 0) : RatFunc ℂ →ₐ[ℂ] RatFunc ℂ :=
  ratFuncSubstitutionAlgHom (algebraMap ℂ[X] (RatFunc ℂ) (qPoly q)) (qPoly_not_const hq)

theorem qHom_ne_zero {q : ℂ} (hq : q ≠ 0) {Q : RatFunc ℂ} (hQ : Q ≠ 0) : qHom q hq Q ≠ 0 := by
  intro h
  exact hQ ((qHom q hq).toRingHom.injective (by simpa using h))

/-- **The order transports along the dilation:** `ord_a(Q(qz)) = ord_{qa}(Q)`. -/
theorem ratOrder_qHom {q : ℂ} (hq : q ≠ 0) {Q : RatFunc ℂ} (hQ : Q ≠ 0) (a : ℂ) :
    ratOrder (qHom q hq Q) a = ratOrder Q (q * a) := by
  classical
  have hdeg : (qPoly q).natDegree ≠ 0 := by rw [qPoly_natDegree hq]; exact one_ne_zero
  have heval : (qPoly q).eval a = q * a := by simp [qPoly]
  have hsub : qPoly q - C ((qPoly q).eval a) = C q * (X - C a) := by
    rw [heval, qPoly, map_mul]
    ring
  have hCq : (C q : ℂ[X]) ≠ 0 := by simpa using hq
  have hmulne : (C q * (X - C a) : ℂ[X]) ≠ 0 := mul_ne_zero hCq (X_sub_C_ne_zero a)
  have hmult : rootMultiplicity a (qPoly q - C ((qPoly q).eval a)) = 1 := by
    rw [hsub, rootMultiplicity_mul hmulne, rootMultiplicity_X_sub_C_self,
      rootMultiplicity_eq_zero (by simpa using hq : ¬ (C q : ℂ[X]).IsRoot a)]
  rw [qHom, ratOrder_ratFuncSubstitution hdeg (qPoly_not_const hq) hQ a, hmult, heval]
  simp

/-- The dilation permutation of the nonzero complex numbers. -/
def qShift (q : ℂ) (hq : q ≠ 0) : Equiv.Perm ℂˣ := Equiv.mulRight (Units.mk0 q hq)

theorem qShift_zpow {q : ℂ} (hq : q ≠ 0) (k : ℤ) (β : ℂˣ) :
    ((qShift q hq) ^ k) β = β * (Units.mk0 q hq) ^ k := by
  induction k using Int.induction_on with
  | zero => simp
  | succ k ih =>
      have hstep : ((qShift q hq) ^ ((k : ℤ) + 1)) β
          = (qShift q hq) (((qShift q hq) ^ (k : ℤ)) β) := by
        rw [show ((k : ℤ) + 1) = 1 + (k : ℤ) by ring, zpow_add, zpow_one, Equiv.Perm.mul_apply]
      rw [hstep, ih, qShift, Equiv.coe_mulRight, zpow_add, zpow_one]
      simp [mul_assoc]
  | pred k ih =>
      have hstep : ((qShift q hq) ^ (-(k : ℤ))) β
          = (qShift q hq) (((qShift q hq) ^ (-(k : ℤ) - 1)) β) := by
        have haux : (qShift q hq) (((qShift q hq) ^ (-(k : ℤ) - 1)) β)
            = ((qShift q hq) ^ (1 + (-(k : ℤ) - 1))) β := by
          rw [zpow_add, zpow_one, Equiv.Perm.mul_apply]
        rw [haux, show (1 + (-(k : ℤ) - 1)) = -(k : ℤ) by ring]
      have hval : ((qShift q hq) ^ (-(k : ℤ) - 1)) β
          = ((qShift q hq) ^ (-(k : ℤ))) β * (Units.mk0 q hq)⁻¹ := by
        rw [hstep]
        simp [qShift, mul_assoc]
      rw [hval, ih, zpow_sub, zpow_one]
      exact mul_assoc _ _ _

theorem isFreeShift_qShift {q : ℂ} (hq : q ≠ 0) (hqroot : ∀ k : ℤ, k ≠ 0 → q ^ k ≠ 1) :
    IsFreeShift (qShift q hq) := by
  intro k β h
  rw [qShift_zpow hq] at h
  by_contra hk
  have hunit : (Units.mk0 q hq) ^ k = 1 := by
    have h2 : β * (Units.mk0 q hq) ^ k = β * 1 := by rw [mul_one]; exact h
    exact mul_left_cancel h2
  apply hqroot k hk
  have := congrArg (fun u : ℂˣ => (u : ℂ)) hunit
  simpa [Units.val_zpow_eq_zpow_val] using this

end

end GaloisForLFunctions.OrbitBalanceComplete

namespace GaloisForLFunctions.OrbitBalanceComplete

open Finsupp Polynomial GaloisForLFunctions.HTGeometry

noncomputable section

/-- The divisor of a rational function restricted to the nonzero points. -/
def unitDivisor (Q : RatFunc ℂ) : ℂˣ →₀ ℤ :=
  Finsupp.comapDomain (Units.val) (ratDivisor Q) (Units.val_injective.injOn)

@[simp] theorem unitDivisor_apply (Q : RatFunc ℂ) (β : ℂˣ) :
    unitDivisor Q β = ratOrder Q (β : ℂ) := by
  rw [unitDivisor, Finsupp.comapDomain_apply, ratDivisor_apply]

theorem unitDivisor_qQuotient {q : ℂ} (hq : q ≠ 0) {g : RatFunc ℂ} (hg : g ≠ 0) :
    unitDivisor (qHom q hq g / g) = shiftDiff (qShift q hq) (unitDivisor g) := by
  ext β
  rw [unitDivisor_apply, shiftDiff_apply, unitDivisor_apply, unitDivisor_apply,
    div_eq_mul_inv, ratOrder_mul (qHom_ne_zero hq hg) (inv_ne_zero hg), ratOrder_inv hg,
    ratOrder_qHom hq hg]
  congr 2
  rw [qShift, Equiv.coe_mulRight, Units.val_mul, Units.val_mk0]
  ring

/-- The rational function with prescribed divisor supported on the nonzero points. -/
def qDivisorRat (n : ℂˣ →₀ ℤ) : RatFunc ℂ := divisorRat (Finsupp.mapDomain Units.val n)

theorem qDivisorRat_ne_zero (n : ℂˣ →₀ ℤ) : qDivisorRat n ≠ 0 := divisorRat_ne_zero _

theorem ratOrder_qDivisorRat_zero (n : ℂˣ →₀ ℤ) : ratOrder (qDivisorRat n) 0 = 0 := by
  rw [qDivisorRat, ratOrder_divisorRat]
  refine Finsupp.mapDomain_notin_range n 0 ?_
  rintro ⟨u, hu⟩
  exact u.ne_zero hu

@[simp] theorem unitDivisor_qDivisorRat (n : ℂˣ →₀ ℤ) : unitDivisor (qDivisorRat n) = n := by
  ext β
  rw [unitDivisor_apply, qDivisorRat, ratOrder_divisorRat,
    Finsupp.mapDomain_apply Units.val_injective]

/-- **Constant-up-to-`q`-coboundary.** -/
def IsCCq (q : ℂ) (hq : q ≠ 0) (a : RatFunc ℂ) : Prop :=
  ∃ (c : ℂ) (g : RatFunc ℂ), c ≠ 0 ∧ g ≠ 0 ∧ a = RatFunc.C c * (qHom q hq g / g)

/-- The `q`-orbit degree of `div(a)` at a nonzero base point. -/
def qOrbitDegree (q : ℂ) (a : RatFunc ℂ) (β : ℂˣ) : ℤ :=
  ∑ᶠ k : ℤ, ratOrder a ((β : ℂ) * q ^ k)

theorem qOrbitDegree_eq_orbitSum {q : ℂ} (hq : q ≠ 0) (a : RatFunc ℂ) (β : ℂˣ) :
    qOrbitDegree q a β = orbitSum (qShift q hq) (unitDivisor a) β := by
  rw [qOrbitDegree, orbitSum]
  refine finsum_congr fun k => ?_
  rw [qShift_zpow hq, unitDivisor_apply, Units.val_mul, Units.val_zpow_eq_zpow_val,
    Units.val_mk0]

/-- **The `q`-orbit analog.**  For a dilation whose ratio is not a root of unity, a nonzero rational
multiplier is a constant times a `q`-shift coboundary if and only if its divisor is balanced on every
multiplicative `q`-orbit (the fixed orbit `{0}` included). -/
theorem isCCq_iff_qOrbitDegree_eq_zero {q : ℂ} (hq : q ≠ 0)
    (hqroot : ∀ k : ℤ, k ≠ 0 → q ^ k ≠ 1) {a : RatFunc ℂ} (ha : a ≠ 0) :
    IsCCq q hq a ↔ (ratOrder a 0 = 0 ∧ ∀ β : ℂˣ, qOrbitDegree q a β = 0) := by
  have hfree := isFreeShift_qShift hq hqroot
  constructor
  · rintro ⟨c, g, hc, hg, rfl⟩
    have hCne : (RatFunc.C c : RatFunc ℂ) ≠ 0 := by simpa using hc
    have hquot : qHom q hq g / g ≠ 0 := div_ne_zero (qHom_ne_zero hq hg) hg
    constructor
    · rw [ratOrder_mul hCne hquot, ratOrder_C, zero_add, div_eq_mul_inv,
        ratOrder_mul (qHom_ne_zero hq hg) (inv_ne_zero hg), ratOrder_inv hg,
        ratOrder_qHom hq hg, mul_zero]
      ring
    · intro β
      rw [qOrbitDegree_eq_orbitSum hq]
      have hdiv : unitDivisor (RatFunc.C c * (qHom q hq g / g))
          = shiftDiff (qShift q hq) (unitDivisor g) := by
        ext x
        rw [unitDivisor_apply, ratOrder_mul hCne hquot, ratOrder_C, zero_add,
          ← unitDivisor_apply, unitDivisor_qQuotient hq hg]
      rw [hdiv]
      exact orbitSum_shiftDiff hfree _ β
  · rintro ⟨hzero, hbal⟩
    have hbal' : ∀ β : ℂˣ, orbitSum (qShift q hq) (unitDivisor a) β = 0 := by
      intro β
      rw [← qOrbitDegree_eq_orbitSum hq]
      exact hbal β
    obtain ⟨n, hn⟩ :=
      (isShiftCoboundary_iff_orbitSum_eq_zero hfree (unitDivisor a)).mpr hbal'
    have hg : qDivisorRat n ≠ 0 := qDivisorRat_ne_zero n
    have hquot : qHom q hq (qDivisorRat n) / qDivisorRat n ≠ 0 :=
      div_ne_zero (qHom_ne_zero hq hg) hg
    have hu : a / (qHom q hq (qDivisorRat n) / qDivisorRat n) ≠ 0 := div_ne_zero ha hquot
    have hord : ∀ x : ℂ, ratOrder (a / (qHom q hq (qDivisorRat n) / qDivisorRat n)) x = 0 := by
      intro x
      rw [div_eq_mul_inv, ratOrder_mul ha (inv_ne_zero hquot), ratOrder_inv hquot]
      rcases eq_or_ne x 0 with rfl | hx
      · rw [hzero, div_eq_mul_inv,
          ratOrder_mul (qHom_ne_zero hq hg) (inv_ne_zero hg), ratOrder_inv hg,
          ratOrder_qHom hq hg, mul_zero]
        ring
      · have hxu : x = ((Units.mk0 x hx : ℂˣ) : ℂ) := by simp
        rw [hxu, ← unitDivisor_apply, ← unitDivisor_apply, unitDivisor_qQuotient hq hg,
          unitDivisor_qDivisorRat, ← hn]
        ring
    obtain ⟨c, hc, huc⟩ := eq_C_of_ratOrder_eq_zero hu hord
    refine ⟨c, qDivisorRat n, hc, hg, ?_⟩
    rw [← huc, div_mul_cancel₀ _ hquot]

end

end GaloisForLFunctions.OrbitBalanceComplete
