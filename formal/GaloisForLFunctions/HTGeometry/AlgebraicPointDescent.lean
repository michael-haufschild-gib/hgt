import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.Adjoin.FG
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Descent of a point, and of a polynomial-valued homomorphism, to an algebraically closed subfield

Two companion facts used to move data produced over `ℂ` back to an arbitrary algebraically closed
field of characteristic zero.

* `nonempty_algHom_of_finiteType` — **Zariski's lemma as a descent principle.**  A nontrivial
  finitely generated algebra over a field `E` admits an `E`-algebra map to any algebraically closed
  extension `K` of `E`: quotient by a maximal ideal, note that the residue field is finite over `E`
  because a field is a Jacobson ring, and lift.

* `exists_ringHom_descent` — **descent of a polynomial-valued ring homomorphism.**  If `A` is
  generated as an `E[X]`-module by finitely many elements and admits an `E[X]`-compatible ring
  homomorphism to `Ω[X]` for some field extension `Ω` of `E`, then it admits one to `K[X]`.  The
  finitely many coefficients of the images of the generators span a finitely generated `E`-subalgebra
  `R` of `Ω`; the homomorphism factors through `R[X]`, and the previous item transports `R` into `K`.

Together they say that `E` is existentially closed in `Ω` for this kind of datum, which is what
replaces a Lefschetz principle in the transfer of the complex simple-connectedness theorem.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

set_option maxHeartbeats 1600000

/-- **Zariski point descent.**  A nontrivial finitely generated algebra over a field maps to any
algebraically closed extension of that field. -/
theorem nonempty_algHom_of_finiteType (E K R : Type*) [Field E] [Field K] [IsAlgClosed K]
    [Algebra E K] [CommRing R] [Nontrivial R] [Algebra E R] [Algebra.FiniteType E R] :
    Nonempty (R →ₐ[E] K) := by
  obtain ⟨m, hm⟩ := Ideal.exists_maximal R
  haveI : m.IsMaximal := hm
  letI : Field (R ⧸ m) := Ideal.Quotient.field m
  haveI : Algebra.FiniteType E (R ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ E m) Ideal.Quotient.mk_surjective
  haveI : Module.Finite E (R ⧸ m) := finite_of_finite_type_of_isJacobsonRing E (R ⧸ m)
  haveI : Algebra.IsIntegral E (R ⧸ m) := Algebra.IsIntegral.of_finite E _
  haveI : Algebra.IsAlgebraic E (R ⧸ m) := Algebra.IsIntegral.isAlgebraic
  exact ⟨(IsAlgClosed.lift (R := E) (S := R ⧸ m) (M := K)).comp (Ideal.Quotient.mkₐ E m)⟩

/-- **Descent of a polynomial-valued ring homomorphism.**  A ring homomorphism into `Ω[X]` which is
compatible with `E[X]` descends to one into `K[X]`, for any algebraically closed extension `K` of
`E`, as soon as the source is generated by finitely many elements as an `E[X]`-module. -/
theorem exists_ringHom_descent
    {E K Ω A : Type*} [Field E] [Field K] [IsAlgClosed K] [Algebra E K] [Field Ω] [Algebra E Ω]
    [CommRing A] (α : E[X] →+* A) (ψ : A →+* Ω[X])
    (hcomm : ∀ q : E[X], ψ (α q) = q.map (algebraMap E Ω))
    {m : ℕ} (bb : Fin m → A)
    (hgen : ∀ a : A, ∃ c : Fin m → E[X], a = ∑ i, α (c i) * bb i) :
    ∃ Ψ : A →+* K[X], ∀ q : E[X], Ψ (α q) = q.map (algebraMap E K) := by
  classical
  set S : Finset Ω := Finset.univ.biUnion (fun i : Fin m => (ψ (bb i)).coeffs) with hS
  set R : Subalgebra E Ω := Algebra.adjoin E (↑S : Set Ω) with hR
  haveI : Algebra.FiniteType E R := Algebra.FiniteType.adjoin_of_finite S.finite_toSet
  obtain ⟨ρ⟩ := nonempty_algHom_of_finiteType E K R
  have hinj : Function.Injective (Polynomial.map (algebraMap R Ω)) :=
    Polynomial.map_injective _ (Subtype.val_injective)
  have hb : ∀ i, ψ (bb i) ∈ Polynomial.lifts (algebraMap R Ω) := by
    intro i
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro k
    by_cases hk : (ψ (bb i)).coeff k = 0
    · exact ⟨0, by simp [hk]⟩
    · refine ⟨⟨(ψ (bb i)).coeff k, ?_⟩, rfl⟩
      apply Algebra.subset_adjoin
      have hmem : (ψ (bb i)).coeff k ∈ S := by
        rw [hS]
        exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, Polynomial.coeff_mem_coeffs hk⟩
      exact_mod_cast hmem
  have hlift : ∀ a : A, ψ a ∈ Polynomial.lifts (algebraMap R Ω) := by
    intro a
    obtain ⟨c, hc⟩ := hgen a
    rw [hc, map_sum]
    refine Subsemiring.sum_mem _ (fun i _ => ?_)
    rw [map_mul, hcomm]
    refine Subsemiring.mul_mem _ ?_ (hb i)
    refine ⟨(c i).map (algebraMap E R), ?_⟩
    show ((c i).map (algebraMap E R)).map (algebraMap R Ω) = (c i).map (algebraMap E Ω)
    rw [Polynomial.map_map]
    congr 1
  choose g hg using hlift
  have hgmap : ∀ a : A, (g a).map (algebraMap R Ω) = ψ a := hg
  refine ⟨(Polynomial.mapRingHom (ρ : R →+* K)).comp
    { toFun := g
      map_one' := hinj (by rw [hgmap, map_one, Polynomial.map_one])
      map_mul' := fun x y => hinj (by rw [Polynomial.map_mul, hgmap, hgmap, hgmap, map_mul])
      map_zero' := hinj (by rw [hgmap, map_zero, Polynomial.map_zero])
      map_add' := fun x y => hinj (by rw [Polynomial.map_add, hgmap, hgmap, hgmap, map_add]) },
    ?_⟩
  intro q
  have hq : g (α q) = q.map (algebraMap E R) := by
    apply hinj
    rw [hgmap, hcomm, Polynomial.map_map]
    congr 1
  show ((g (α q)).map (ρ : R →+* K)) = q.map (algebraMap E K)
  rw [hq, Polynomial.map_map, ρ.comp_algebraMap]

end GaloisForLFunctions.HTGeometry
