import Mathlib
import GaloisForLFunctions.HTGeometry.CompositionResidueLaw

/-!
# Semigroup and rank-one Hankel laws of the inverse-Gamma polygamma tower

At an inverse-Gamma pole `z₀` with `Γ z₀ = -m` and `Γ' z₀ = d ≠ 0`, the leading principal-part
value of `ψ⁽�q⁾ ∘ Γ` is `q! · ρ^(q+1)` with `ρ = -1/d` (`polygamma_comp_Gamma_principalPart`).
This module records the two exact algebraic consequences of that factorial-power form:

* the **multiplicative semigroup law** `(p+q+1)! · C_p · C_q = p! · q! · C_{p+q+1}`, expressing that
  the whole tower is generated by the single residue `ρ`; and
* the **rank-one Hankel law** `det[C_{i+j}/(i+j)!] = 0` for any block of size `≥ 2`, because the
  normalized value `C_k/k! = ρ^{k+1}` makes the Hankel matrix an outer product `ρ · ρ^i · ρ^j`.
-/

namespace GaloisForLFunctions

open scoped Nat

/-- Outer-product / geometric Hankel matrix `ρ^{i+j+1}` is singular once it has at least two rows:
its second row is `ρ` times its first. -/
theorem geomOuter_det_zero (ρ : ℂ) {n : ℕ} (hn : 2 ≤ n) :
    (Matrix.of (fun i j : Fin n => ρ ^ ((i : ℕ) + (j : ℕ) + 1))).det = 0 := by
  have hn0 : 0 < n := by omega
  set M := Matrix.of (fun i j : Fin n => ρ ^ ((i : ℕ) + (j : ℕ) + 1)) with hM
  set i0 : Fin n := ⟨0, by omega⟩
  set i1 : Fin n := ⟨1, by omega⟩
  have hne : i0 ≠ i1 := by simp [i0, i1, Fin.ext_iff]
  have hrow : M i1 = ρ • M i0 := by
    funext j
    simp only [hM, Matrix.of_apply, Pi.smul_apply, smul_eq_mul, i0, i1]
    rw [show (1 : ℕ) + (j : ℕ) + 1 = ((0 : ℕ) + (j : ℕ) + 1) + 1 by omega, pow_succ]
    ring
  have h1 : M = M.updateRow i1 (ρ • M i0) := by
    rw [← hrow]; exact (Matrix.updateRow_eq_self M i1).symm
  rw [h1, Matrix.det_updateRow_smul, Matrix.det_zero_of_row_eq hne, mul_zero]
  rw [Matrix.updateRow_ne hne, Matrix.updateRow_self]

/-- The leading principal-part value of `ψ⁽�q⁾ ∘ Γ` at an inverse-Gamma pole with inner derivative
`d = Γ' z₀`, as identified by `polygamma_comp_Gamma_principalPart`: `q! · (-1/d)^(q+1)`. -/
noncomputable def polygammaTowerCoeff (d : ℂ) (q : ℕ) : ℂ :=
  (q.factorial : ℂ) * (-1 / d) ^ (q + 1)

/-- **Law 1 — multiplicative semigroup of principal parts.**  The factorial-power tower satisfies
`(p+q+1)! · C_p · C_q = p! · q! · C_{p+q+1}`; every all-order principal-part relation is generated
by the single residue value. -/
theorem polygammaTowerCoeff_semigroup (d : ℂ) (p q : ℕ) :
    ((p + q + 1).factorial : ℂ) * polygammaTowerCoeff d p * polygammaTowerCoeff d q
      = (p.factorial : ℂ) * (q.factorial : ℂ) * polygammaTowerCoeff d (p + q + 1) := by
  unfold polygammaTowerCoeff
  set ρ : ℂ := -1 / d with hρ
  have hpow : ρ ^ (p + 1) * ρ ^ (q + 1) = ρ ^ ((p + q + 1) + 1) := by
    rw [← pow_add]; congr 1; omega
  calc ((p + q + 1).factorial : ℂ) * ((p.factorial : ℂ) * ρ ^ (p + 1))
          * ((q.factorial : ℂ) * ρ ^ (q + 1))
      = ((p + q + 1).factorial : ℂ) * (p.factorial : ℂ) * (q.factorial : ℂ)
          * (ρ ^ (p + 1) * ρ ^ (q + 1)) := by ring
    _ = ((p + q + 1).factorial : ℂ) * (p.factorial : ℂ) * (q.factorial : ℂ)
          * ρ ^ ((p + q + 1) + 1) := by rw [hpow]
    _ = (p.factorial : ℂ) * (q.factorial : ℂ)
          * ((((p + q + 1).factorial : ℂ)) * ρ ^ ((p + q + 1) + 1)) := by ring

/-- **Law 2 — rank-one Hankel.**  The normalized principal-part values `C_k/k! = ρ^{k+1}` build a
Hankel matrix of rank one, so every block of size `≥ 2` has vanishing determinant.  This is the
differential-matroid boundary: leading-pole-order data alone lies on a rank-one Veronese locus. -/
theorem polygammaTowerCoeff_hankel_det_zero (d : ℂ) {r : ℕ} (hr : 1 ≤ r) :
    (Matrix.of (fun i j : Fin (r + 1) =>
        polygammaTowerCoeff d ((i : ℕ) + (j : ℕ)) / (((i : ℕ) + (j : ℕ)).factorial : ℂ))).det
      = 0 := by
  have hmatrix :
      (Matrix.of (fun i j : Fin (r + 1) =>
          polygammaTowerCoeff d ((i : ℕ) + (j : ℕ)) / (((i : ℕ) + (j : ℕ)).factorial : ℂ)))
        = Matrix.of (fun i j : Fin (r + 1) => (-1 / d) ^ ((i : ℕ) + (j : ℕ) + 1)) := by
    funext i j
    simp only [Matrix.of_apply, polygammaTowerCoeff]
    rw [mul_comm, mul_div_assoc]
    have hfac : (((i : ℕ) + (j : ℕ)).factorial : ℂ) ≠ 0 := by
      exact_mod_cast Nat.factorial_ne_zero _
    rw [div_self hfac, mul_one]
  rw [hmatrix]
  exact geomOuter_det_zero (-1 / d) (by omega)

end GaloisForLFunctions
