import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaCosetFaceField
import GaloisForLFunctions.HTGeometry.FacePacketDifferenceSystem

/-!
# The labelled three-direction difference system

The labelled analogue of `FacePacketDifferenceSystem`: the unit period and the two surviving
structural periods act on the differential field generated by an upward closed family of labelled
face packets, and the translation block of a labelled face has all three displacements inside that
field.  Hence the descending face-lifting lemma applies verbatim.

* `cosetFacePacketDifferenceSystem` — the commuting difference-differential structure;
* `cosetFacePacketBlock`, `cosetFacePacketDisplacement`;
* **`cosetFacePacket_differentialIndependent_of_no_telescoping`**.
-/

open Filter Topology Set Function Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions

open Bottcher MatroidGluing MatroidGluing.Rank MatroidGluing.Meromorphic

noncomputable section

attribute [local instance] facePacketMeroDecidableEq

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## The unit period acts trivially on the labelled packets -/

theorem cosetFacePacket_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (J : Finset ι) {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ cosetFacePacket τ hτ A J) :
    addTranslationMeroEquiv 1 y = y := by
  obtain ⟨g, _, rfl⟩ := hy
  have hcomm : (1 : ℂ) + g = g + 1 := add_comm 1 g
  rw [addTranslationMeroEquiv_add, hcomm, ← addTranslationMeroEquiv_add,
    addTranslationMeroEquiv_one_multipleEllipticGammaLogDerivFaceMero]

theorem cosetFacePacket_neg_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (J : Finset ι) {y : meroField (Set.univ : Set ℂ)} (hy : y ∈ cosetFacePacket τ hτ A J) :
    addTranslationMeroEquiv (-1) y = y := by
  have h0 : (-1 : ℂ) + 1 = 0 := by ring
  conv_lhs => rw [← cosetFacePacket_one_translate_eq τ hτ A J hy]
  rw [addTranslationMeroEquiv_add, h0, addTranslationMeroEquiv_zero_apply]

theorem cosetFacePacketUnion_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (S : Set (Finset ι)) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ cosetFacePacketUnion τ hτ A S) :
    addTranslationMeroEquiv 1 y = y := by
  obtain ⟨L, _, hyL⟩ := Set.mem_iUnion₂.mp hy
  exact cosetFacePacket_one_translate_eq τ hτ A L hyL

theorem cosetFacePacketUnion_neg_one_translate_eq (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) (S : Set (Finset ι)) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ cosetFacePacketUnion τ hτ A S) :
    addTranslationMeroEquiv (-1) y = y := by
  obtain ⟨L, _, hyL⟩ := Set.mem_iUnion₂.mp hy
  exact cosetFacePacket_neg_one_translate_eq τ hτ A L hyL

theorem differentialAdjoin_cosetFacePacketUnion_one_fixed (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) (S : Set (Finset ι)) {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :
    addTranslationMeroEquiv 1 x = x :=
  differentialAdjoin_fixed_of_generators 1 _
    (fun _ hy => cosetFacePacketUnion_one_translate_eq τ hτ A S hy) hx

theorem differentialAdjoin_cosetFacePacketUnion_neg_one_fixed (τ : ι → ℂ)
    (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ) (S : Set (Finset ι))
    {x : meroField (Set.univ : Set ℂ)}
    (hx : x ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :
    addTranslationMeroEquiv (-1) x = x :=
  differentialAdjoin_fixed_of_generators (-1) _
    (fun _ hy => cosetFacePacketUnion_neg_one_translate_eq τ hτ A S hy) hx

/-! ## The three structural directions -/

theorem cosetFacePacketUnion_period_translate_stable (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) {S : Set (Finset ι)}
    (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :
    addTranslationMeroEquiv (facePacketPeriods τ q u i) x ∈
      differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S) := by
  fin_cases i
  · rw [show facePacketPeriods τ q u ⟨0, by omega⟩ = 1 from rfl,
      differentialAdjoin_cosetFacePacketUnion_one_fixed τ hτ A S hx]
    exact hx
  · exact differentialAdjoin_cosetFacePacketUnion_translate_stable τ hτ A q
      (fun L hL hq => hS L hL q hq) hx
  · exact differentialAdjoin_cosetFacePacketUnion_translate_stable τ hτ A u
      (fun L hL hu => hS L hL u hu) hx

theorem cosetFacePacketUnion_period_neg_translate_stable (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) {S : Set (Finset ι)}
    (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :
    addTranslationMeroEquiv (-facePacketPeriods τ q u i) x ∈
      differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S) := by
  fin_cases i
  · rw [show -facePacketPeriods τ q u ⟨0, by omega⟩ = -1 from rfl,
      differentialAdjoin_cosetFacePacketUnion_neg_one_fixed τ hτ A S hx]
    exact hx
  · exact differentialAdjoin_cosetFacePacketUnion_neg_translate_stable τ hτ A q
      (fun L hL hq => hS L hL q hq) hx
  · exact differentialAdjoin_cosetFacePacketUnion_neg_translate_stable τ hτ A u
      (fun L hL hu => hS L hL u hu) hx

/-- **The three structural translations as a difference-differential structure on the labelled
deeper face field.** -/
def cosetFacePacketDifferenceSystem (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) :
    CommutingDifferenceDifferentialField (Fin 3) ℂ
      ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) where
  aut i := meroTranslationRestrict (differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
    (facePacketPeriods τ q u i)
    (cosetFacePacketUnion_period_translate_stable τ hτ A hS q u i)
    (cosetFacePacketUnion_period_neg_translate_stable τ hτ A hS q u i)
  aut_comm i j x := by
    apply Subtype.ext
    show addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (addTranslationMeroEquiv (facePacketPeriods τ q u j)
        (x : meroField (Set.univ : Set ℂ))) = _
    show _ = addTranslationMeroEquiv (facePacketPeriods τ q u j)
      (addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (x : meroField (Set.univ : Set ℂ)))
    rw [addTranslationMeroEquiv_add, addTranslationMeroEquiv_add, add_comm]
  aut_deriv i x := by
    apply Subtype.ext
    exact addTranslationMeroEquiv_deriv (facePacketPeriods τ q u i)
      (x : meroField (Set.univ : Set ℂ))
  aut_algebraMap i c := by
    apply Subtype.ext
    show addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c) = _
    exact addTranslationMeroEquiv_algebraMap_complex _ c

@[simp]
theorem cosetFacePacketDifferenceSystem_aut_coe (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (q u : ι) (i : Fin 3)
    (x : ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
    (((cosetFacePacketDifferenceSystem τ hτ A hS q u).aut i x :
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
        meroField (Set.univ : Set ℂ)) =
      addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (x : meroField (Set.univ : Set ℂ)) := rfl

/-! ## The labelled translation block and its displacements -/

/-- The labelled translation block of the face `J`. -/
def cosetFacePacketBlock (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ) (J : Finset ι) :
    ↥(cosetFacePacket τ hτ A J) → meroField (Set.univ : Set ℂ) :=
  fun y => (y : meroField (Set.univ : Set ℂ))

theorem cosetFacePacketBlock_period_displacement_mem (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (i : Fin 3)
    (y : ↥(cosetFacePacket τ hτ A J)) :
    addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (cosetFacePacketBlock τ hτ A J y) - cosetFacePacketBlock τ hτ A J y ∈
      differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S) := by
  fin_cases i
  · show addTranslationMeroEquiv 1 (y : meroField (Set.univ : Set ℂ)) -
      (y : meroField (Set.univ : Set ℂ)) ∈
        differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)
    rw [cosetFacePacket_one_translate_eq τ hτ A J y.2, sub_self]
    exact (differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)).zero_mem
  · exact subset_differentialAdjoin ℂ _
      (Set.mem_iUnion₂.mpr ⟨insert q J, hqS,
        cosetFacePacket_translate_sub_mem τ hτ A J hqJ y.2⟩)
  · exact subset_differentialAdjoin ℂ _
      (Set.mem_iUnion₂.mpr ⟨insert u J, huS,
        cosetFacePacket_translate_sub_mem τ hτ A J huJ y.2⟩)

/-- The displacements of the labelled translation block in the three structural directions. -/
def cosetFacePacketDisplacement (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) :
    Fin 3 → ↥(cosetFacePacket τ hτ A J) →
      ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :=
  fun i y => ⟨addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (cosetFacePacketBlock τ hτ A J y) - cosetFacePacketBlock τ hτ A J y,
    cosetFacePacketBlock_period_displacement_mem τ hτ A J hqJ huJ hqS huS i y⟩

set_option synthInstance.maxHeartbeats 400000 in
/-- **Labelled descending face-lifting.** -/
theorem cosetFacePacket_differentialIndependent_of_no_telescoping (τ : ι → ℂ)
    (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ) {S : Set (Finset ι)}
    (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S) (J : Finset ι) {q u : ι}
    (hqJ : q ∉ J) (huJ : u ∉ J) (hqS : insert q J ∈ S) (huS : insert u J ∈ S)
    (hv : LinearIndependent ℚ (facePacketPeriods τ q u))
    (hnot : ∀ c : (↥(cosetFacePacket τ hτ A J) × ℕ) →₀ ℂ, c ≠ 0 →
      ∀ k : ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)), ∃ i,
        (cosetFacePacketDifferenceSystem τ hτ A hS q u).defect i k ≠
          Finsupp.linearCombination ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
            (fun p ↦ differentialJet p.2
              (cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS i p.1))
            (Finsupp.mapRange
              (algebraMap ℂ ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))
              (map_zero (algebraMap ℂ
                ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))) c)) :
    DifferentialIndependent ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
      (cosetFacePacketBlock τ hτ A J) := by
  classical
  haveI : DifferentialAlgebra ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
      (meroField (Set.univ : Set ℂ)) :=
    ⟨fun x => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) x⟩
  haveI : CharZero ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :=
    charZero_of_injective_algebraMap
      (algebraMap ℂ ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))).injective
  refine differentialIndependent_of_no_constant_simultaneous_jet_telescoping
    (cosetFacePacketDifferenceSystem τ hτ A hS q u)
    (rankThreeGeneratorMeromorphicDifferenceDifferentialField (facePacketPeriods τ q u))
    (fun i k => rfl)
    (fun z hz => ?_)
    (cosetFacePacketBlock τ hτ A J)
    (cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS)
    (fun i y => ?_) hnot
  · obtain ⟨c, hc⟩ :=
      (rankThree_generator_jointFixed_iff_constant (facePacketPeriods τ q u) hv z).mp hz
    exact ⟨c, by simpa [meromorphicConstantEmbedding] using hc⟩
  · show addTranslationMeroEquiv (facePacketPeriods τ q u i)
      (cosetFacePacketBlock τ hτ A J y) =
      cosetFacePacketBlock τ hτ A J y +
        (cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS i y :
          meroField (Set.univ : Set ℂ))
    show _ = cosetFacePacketBlock τ hτ A J y +
      (addTranslationMeroEquiv (facePacketPeriods τ q u i)
        (cosetFacePacketBlock τ hτ A J y) - cosetFacePacketBlock τ hτ A J y)
    ring

end

end GaloisForLFunctions
