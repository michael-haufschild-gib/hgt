import GaloisForLFunctions.HTGeometry.ProjectiveHorizonLinearJetAction

/-!
# The affine chart field inside the homogeneous jet field

The homogeneous jet field carries the total-derivative jet shift, and the prolonged linear action
of the special linear group commutes with it, so unimodular matrices act by differential field
automorphisms.

Dividing the homogeneous lift by one of its coordinates produces the affine chart whose infinity
hyperplane is `ker e_i^*`.  The differential field generated by the resulting affine coordinates is
the projective jet field of that chart.  It is closed under the jet shift because the shift of an
affine jet is the next affine jet, and it is stable under the whole special linear group because a
linear substitution of the lift acts on affine coordinates by a fractional-linear change with
constant coefficients.
-/

namespace GaloisForLFunctions.HTGeometry

open Matrix

noncomputable section

variable {n : Type*} [Fintype n] [DecidableEq n] {K : Type*} [Field K]

/-! ## The total-derivative jet shift -/

/-- The total-derivative jet shift on the homogeneous jet field. -/
def homogeneousJetShift (n K : Type*) [Field K] :
    Derivation K (HomogeneousJetField n K) (HomogeneousJetField n K) :=
  extendFreeCoordinatePolynomialDerivation (differentialPolynomialDerivation n K)

omit [Fintype n] [DecidableEq n] in
@[simp]
theorem homogeneousJetShift_algebraMap (p : MvPolynomial (n × ℕ) K) :
    homogeneousJetShift n K
        (algebraMap (MvPolynomial (n × ℕ) K) (HomogeneousJetField n K) p) =
      algebraMap (MvPolynomial (n × ℕ) K) (HomogeneousJetField n K)
        (differentialPolynomialDerivation n K p) :=
  extendFreeCoordinatePolynomialDerivation_algebraMap _ p

omit [Fintype n] [DecidableEq n] in
@[simp]
theorem homogeneousJetShift_freeCoordinate (k : n) (l : ℕ) :
    homogeneousJetShift n K (freeCoordinate K (n × ℕ) (k, l)) =
      freeCoordinate K (n × ℕ) (k, l + 1) := by
  rw [freeCoordinate, homogeneousJetShift_algebraMap, differentialPolynomialDerivation_X]
  rfl

/-- The prolonged linear action commutes with the jet shift on the polynomial generators. -/
theorem linearJetFieldEquiv_shift_algebraMap (g : SpecialLinearGroup n K)
    (p : MvPolynomial (n × ℕ) K) :
    linearJetFieldEquiv g
        (homogeneousJetShift n K
          (algebraMap (MvPolynomial (n × ℕ) K) (HomogeneousJetField n K) p)) =
      homogeneousJetShift n K
        (linearJetFieldEquiv g
          (algebraMap (MvPolynomial (n × ℕ) K) (HomogeneousJetField n K) p)) := by
  rw [homogeneousJetShift_algebraMap, linearJetFieldEquiv_algebraMap,
    linearJetFieldEquiv_algebraMap, homogeneousJetShift_algebraMap,
    linearJetSubstPoly_deriv]

/-- **Differential automorphism.**  The prolonged linear action commutes with the total-derivative
jet shift, so the special linear group acts on the homogeneous jet field by differential field
automorphisms. -/
theorem linearJetFieldEquiv_shift (g : SpecialLinearGroup n K)
    (f : HomogeneousJetField n K) :
    linearJetFieldEquiv g (homogeneousJetShift n K f) =
      homogeneousJetShift n K (linearJetFieldEquiv g f) := by
  obtain ⟨x, y, _, rfl⟩ :=
    IsFractionRing.div_surjective (A := MvPolynomial (n × ℕ) K) f
  have hquot : ∀ a b : HomogeneousJetField n K,
      homogeneousJetShift n K (a / b) =
        (b⁻¹) ^ (2 : ℕ) * (b * homogeneousJetShift n K a - a * homogeneousJetShift n K b) := by
    intro a b
    rw [Derivation.leibniz_div]
    simp [smul_eq_mul]
  rw [hquot, map_div₀, hquot, map_mul, map_sub, map_mul, map_mul, map_pow, map_inv₀,
    linearJetFieldEquiv_shift_algebraMap, linearJetFieldEquiv_shift_algebraMap]

theorem linearJetAction_shift (g : SpecialLinearGroup n K) (f : HomogeneousJetField n K) :
    g • homogeneousJetShift n K f = homogeneousJetShift n K (g • f) :=
  linearJetFieldEquiv_shift g f

/-! ## Derivation-closed generated subfields -/

/-- A generated subfield is closed under a derivation as soon as its generators are. -/
theorem derivation_mem_adjoin {E : Type*} [Field E] [Algebra K E]
    (D : Derivation K E E) (S : Set E)
    (hS : ∀ x ∈ S, D x ∈ IntermediateField.adjoin K S) :
    ∀ x ∈ IntermediateField.adjoin K S, D x ∈ IntermediateField.adjoin K S := by
  intro x hx
  refine IntermediateField.adjoin_induction K (s := S)
    (p := fun z _ => D z ∈ IntermediateField.adjoin K S) ?_ ?_ ?_ ?_ ?_ hx
  · intro z hz
    exact hS z hz
  · intro a
    rw [Derivation.map_algebraMap]
    exact zero_mem _
  · intro z w _ _ hz hw
    rw [map_add]
    exact add_mem hz hw
  · intro z hzmem hz
    rw [Derivation.leibniz_inv, smul_eq_mul, neg_mul]
    exact neg_mem (mul_mem (pow_mem (inv_mem hzmem) 2) hz)
  · intro z w hzmem hwmem hz hw
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (mul_mem hzmem hw) (mul_mem hwmem hz)

/-! ## The affine chart -/

/-- The `k`-th affine coordinate of the chart whose infinity hyperplane is `ker e_i^*`. -/
def affineCoord (i k : n) : HomogeneousJetField n K :=
  freeCoordinate K (n × ℕ) (k, 0) / freeCoordinate K (n × ℕ) (i, 0)

/-- The `l`-th jet of an affine chart coordinate. -/
def affineJet (i k : n) : ℕ → HomogeneousJetField n K
  | 0 => affineCoord i k
  | l + 1 => homogeneousJetShift n K (affineJet i k l)

omit [Fintype n] [DecidableEq n] in
@[simp]
theorem affineJet_zero (i k : n) : affineJet (K := K) i k 0 = affineCoord i k := rfl

omit [Fintype n] [DecidableEq n] in
@[simp]
theorem affineJet_succ (i k : n) (l : ℕ) :
    affineJet (K := K) i k (l + 1) = homogeneousJetShift n K (affineJet i k l) := rfl

/-- The generating set of the projective jet field of the chart at `i`. -/
def affineJetGenerators (i : n) (K : Type*) [Field K] : Set (HomogeneousJetField n K) :=
  {f | ∃ (k : n) (l : ℕ), f = affineJet i k l}

/-- The projective jet field of the chart whose infinity hyperplane is `ker e_i^*`: the field
generated by the affine coordinates of that chart and all their jets. -/
def projectiveJetField (i : n) (K : Type*) [Field K] :
    IntermediateField K (HomogeneousJetField n K) :=
  IntermediateField.adjoin K (affineJetGenerators i K)

omit [Fintype n] [DecidableEq n] in
theorem affineJet_mem_projectiveJetField (i k : n) (l : ℕ) :
    affineJet (K := K) i k l ∈ projectiveJetField i K :=
  IntermediateField.subset_adjoin K _ ⟨k, l, rfl⟩

omit [Fintype n] [DecidableEq n] in
/-- The projective jet field is closed under the total-derivative jet shift. -/
theorem homogeneousJetShift_mem_projectiveJetField (i : n)
    {f : HomogeneousJetField n K} (hf : f ∈ projectiveJetField i K) :
    homogeneousJetShift n K f ∈ projectiveJetField i K := by
  refine derivation_mem_adjoin (homogeneousJetShift n K) (affineJetGenerators i K) ?_ f hf
  rintro _ ⟨k, l, rfl⟩
  exact IntermediateField.subset_adjoin K _ ⟨k, l + 1, rfl⟩

/-! ## Stability under the linear action -/

omit [Fintype n] [DecidableEq n] in
theorem freeCoordinate_ne_zero (k : n) (l : ℕ) :
    freeCoordinate K (n × ℕ) (k, l) ≠ 0 := by
  rw [freeCoordinate, Ne, map_eq_zero_iff _ (IsFractionRing.injective _ _)]
  exact MvPolynomial.X_ne_zero _

omit [Fintype n] [DecidableEq n] in
theorem affineCoord_self (i : n) : affineCoord (K := K) i i = 1 :=
  div_self (freeCoordinate_ne_zero i 0)

/-- The linear action on an affine coordinate is the fractional-linear change with constant
coefficients determined by the inverse matrix. -/
theorem linearJetAction_affineCoord (g : SpecialLinearGroup n K) (i k : n) :
    g • affineCoord (K := K) i k =
      (∑ m, algebraMap K (HomogeneousJetField n K)
            (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) k m) * affineCoord i m) /
        (∑ m, algebraMap K (HomogeneousJetField n K)
            (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) i m) * affineCoord i m) := by
  have hi : freeCoordinate K (n × ℕ) (i, 0) ≠ (0 : HomogeneousJetField n K) :=
    freeCoordinate_ne_zero i 0
  have hscale : ∀ j : n,
      ∑ m, algebraMap K (HomogeneousJetField n K)
          (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) j m) * affineCoord i m =
        (freeCoordinate K (n × ℕ) (i, 0))⁻¹ *
          ∑ m, algebraMap K (HomogeneousJetField n K)
            (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) j m) *
              freeCoordinate K (n × ℕ) (m, 0) := by
    intro j
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [affineCoord, div_eq_mul_inv]
    ring
  calc g • affineCoord (K := K) i k
      = (g • freeCoordinate K (n × ℕ) (k, 0)) / (g • freeCoordinate K (n × ℕ) (i, 0)) := by
        show linearJetFieldEquiv g
            (freeCoordinate K (n × ℕ) (k, 0) / freeCoordinate K (n × ℕ) (i, 0)) = _
        rw [map_div₀]
        rfl
    _ = (∑ m, algebraMap K (HomogeneousJetField n K)
            (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) k m) *
              freeCoordinate K (n × ℕ) (m, 0)) /
          (∑ m, algebraMap K (HomogeneousJetField n K)
            (((g⁻¹ : SpecialLinearGroup n K) : Matrix n n K) i m) *
              freeCoordinate K (n × ℕ) (m, 0)) := by
        rw [linearJetAction_freeCoordinate, linearJetAction_freeCoordinate]
    _ = _ := by
        rw [hscale k, hscale i, mul_div_mul_left _ _ (inv_ne_zero hi)]

theorem linearJetAction_affineCoord_mem (g : SpecialLinearGroup n K) (i k : n) :
    g • affineCoord (K := K) i k ∈ projectiveJetField i K := by
  rw [linearJetAction_affineCoord]
  refine div_mem ?_ ?_ <;>
    exact sum_mem fun m _ =>
      mul_mem ((projectiveJetField i K).algebraMap_mem _)
        (affineJet_mem_projectiveJetField i m 0)

theorem linearJetAction_affineJet_mem (g : SpecialLinearGroup n K) (i k : n) (l : ℕ) :
    g • affineJet (K := K) i k l ∈ projectiveJetField i K := by
  induction l with
  | zero => exact linearJetAction_affineCoord_mem g i k
  | succ l ih =>
      rw [affineJet_succ, linearJetAction_shift]
      exact homogeneousJetShift_mem_projectiveJetField i ih

/-- **Chart stability.**  The projective jet field of any chart is stable under the whole
prolonged linear action: a unimodular matrix moves the source point without leaving the field
generated by one affine chart. -/
theorem linearJetAction_mem_projectiveJetField (g : SpecialLinearGroup n K) (i : n)
    {f : HomogeneousJetField n K} (hf : f ∈ projectiveJetField i K) :
    g • f ∈ projectiveJetField i K := by
  refine IntermediateField.adjoin_induction K (s := affineJetGenerators i K)
    (p := fun z _ => g • z ∈ projectiveJetField i K) ?_ ?_ ?_ ?_ ?_ hf
  · rintro _ ⟨k, l, rfl⟩
    exact linearJetAction_affineJet_mem g i k l
  · intro a
    rw [linearJetAction_algebraMap]
    exact (projectiveJetField i K).algebraMap_mem a
  · intro z w _ _ hz hw
    rw [smul_add]
    exact add_mem hz hw
  · intro z _ hz
    rw [linearJetAction_inv]
    exact inv_mem hz
  · intro z w _ _ hz hw
    rw [smul_mul']
    exact mul_mem hz hw

end

end GaloisForLFunctions.HTGeometry
