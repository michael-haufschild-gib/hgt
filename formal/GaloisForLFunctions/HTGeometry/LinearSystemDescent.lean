import Mathlib

/-!
# Descent of nontrivial solutions of linear systems to subfields

A finite homogeneous linear system with coefficients in a field `K` that has a nontrivial
solution over an extension field `L` already has one over `K`: nontriviality of the kernel is
equivalent to linear dependence of the columns, and linear independence of vectors with
entries in `K` is insensitive to extension of scalars
(`linearIndependent_algebraMap_comp_iff`).

This is the linear-algebra mechanism behind coefficient-field normalization of algebraic
differential equations (Mahler normalization): the annihilation conditions on the unknown
coefficients of a differential polynomial of bounded degree are finitely many linear
equations over the field generated by the data, so the existence of a complex annihilator
forces one with coefficients in that field.
-/

open Matrix

namespace GaloisForLFunctions

/-- **Nontrivial solutions descend to subfields.**  If a homogeneous linear system with
matrix over `K` has a nonzero solution with entries in an extension `L`, it has a nonzero
solution with entries in `K`. -/
theorem matrix_mulVec_descent {K L : Type*} [Field K] [Field L] [Algebra K L]
    {m n : Type*} [Fintype m] [Fintype n] (M : Matrix m n K)
    (h : ∃ v : n → L, v ≠ 0 ∧ M.map (algebraMap K L) *ᵥ v = 0) :
    ∃ w : n → K, w ≠ 0 ∧ M *ᵥ w = 0 := by
  by_contra hK
  push Not at hK
  obtain ⟨v, hv0, hv⟩ := h
  have hindK : LinearIndependent K (fun j : n => fun i : m => M i j) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg j
    have hMg : M *ᵥ g = 0 := by
      funext i
      have hgi := congrFun hg i
      simpa [Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm] using hgi
    by_contra hj
    have hgne : g ≠ 0 := fun h0 => hj (congrFun h0 j)
    exact hK g hgne hMg
  have hindL : LinearIndependent L
      (fun j : n => algebraMap K L ∘ (fun i : m => M i j)) :=
    linearIndependent_algebraMap_comp_iff.mpr hindK
  rw [Fintype.linearIndependent_iff] at hindL
  have hv' : ∀ j, v j = 0 := by
    refine hindL v ?_
    funext i
    have hvi := congrFun hv i
    simpa [Matrix.mulVec, dotProduct, Matrix.map_apply, Finset.sum_apply, Function.comp,
      mul_comm] using hvi
  exact hv0 (funext hv')

/-- **Descent for arbitrary families of linear conditions.**  A homogeneous system in finitely
many unknowns given by an arbitrary (possibly infinite) family of linear conditions over `K`
that has a nontrivial solution over an extension `L` has one over `K`: the row span is
finite-dimensional, so by Noetherian compactness the family is equivalent to a finite
subfamily, and the finite case descends.  This is the form matching the countably many
Taylor-coefficient conditions of a differential-polynomial annihilator. -/
theorem matrix_mulVec_descent_family {K L : Type*} [Field K] [Field L] [Algebra K L]
    {n : Type*} [Fintype n] {ι : Type*} (M : ι → n → K)
    (h : ∃ v : n → L, v ≠ 0 ∧ ∀ i, ∑ j, algebraMap K L (M i j) * v j = 0) :
    ∃ w : n → K, w ≠ 0 ∧ ∀ i, ∑ j, M i j * w j = 0 := by
  obtain ⟨v, hv0, hv⟩ := h
  have hfg : (Submodule.span K (Set.range M)).FG := IsNoetherian.noetherian _
  have hcomp := (Submodule.fg_iff_compact _).mp hfg
  have hle : Submodule.span K (Set.range M) ≤ ⨆ i, K ∙ M i := by
    rw [Submodule.span_le]
    rintro x ⟨i, rfl⟩
    exact le_iSup (fun i => K ∙ M i) i (Submodule.mem_span_singleton_self (M i))
  obtain ⟨s, hs⟩ := CompleteLattice.IsCompactElement.exists_finset_of_le_iSup _ hcomp _ hle
  set Mat : Matrix {i // i ∈ s} n K := fun i j => M i.1 j with hMat
  have hsub : ∃ v' : n → L, v' ≠ 0 ∧ Mat.map (algebraMap K L) *ᵥ v' = 0 := by
    refine ⟨v, hv0, ?_⟩
    funext i
    have hvi := hv i.1
    simpa [Matrix.mulVec, dotProduct, Matrix.map_apply, hMat] using hvi
  obtain ⟨w, hw0, hw⟩ := matrix_mulVec_descent Mat hsub
  refine ⟨w, hw0, fun i₀ => ?_⟩
  let φ : (n → K) →ₗ[K] K :=
    { toFun := fun u => ∑ j, u j * w j
      map_add' := fun a b => by simp [add_mul, Finset.sum_add_distrib]
      map_smul' := fun c a => by simp [Finset.mul_sum, mul_assoc] }
  have hker : (⨆ i ∈ s, K ∙ M i) ≤ LinearMap.ker φ := by
    refine iSup_le fun i => iSup_le fun hi => ?_
    rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
    have hwi := congrFun hw ⟨i, hi⟩
    simpa [Matrix.mulVec, dotProduct, hMat, φ] using hwi
  have hmem : M i₀ ∈ LinearMap.ker φ :=
    hker (hs (Submodule.subset_span ⟨i₀, rfl⟩))
  simpa [φ, LinearMap.mem_ker] using hmem

end GaloisForLFunctions
