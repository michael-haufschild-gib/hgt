import GaloisForLFunctions.HTGeometry.RamifiedPuiseuxCascadeTransfer
import GaloisForLFunctions.HTGeometry.DerivationAlgebraicStability
import GaloisForLFunctions.HTGeometry.HyperexponentialPrimitive
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg
import GaloisForLFunctions.HTGeometry.AlgebraicDerivationMapUniqueness

/-!
# The intrinsic ramified Puiseux branch field

The multigraded Hahn calculation becomes a statement about an algebraic function field only after
the selected algebraic branches and the coordinate derivations coexist in one field.  This module
constructs that field intrinsically: take the rational coordinate field generated by the ramified
Hahn monomials, then its relative algebraic closure inside the Hahn fraction field.

Every selected branch algebraic over the coordinate field belongs to this relative closure.  The
ramified coordinate derivations preserve it, and so does the product-cascade derivation.  Their
restrictions give the exact differential specialization required by the observability transfer.
Thus branch algebraicity and the nonzero output-linear Puiseux leads directly imply independence of
the first full output-jet block; no separately postulated specialization remains.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open HahnSeries

/-! ## Exact action on the ramified coordinates -/

/-- The ramified coordinate derivative is the negative Kronecker coordinate derivation.  The sign
comes from the convention `X_k = s_k ^ (-r_k)`. -/
theorem hahnFractionRamPartial_coordinate {N : ℕ} (r : Fin N → ℕ)
    (hr : ∀ i, 0 < r i) (j k : Fin N) :
    hahnFractionRamPartial r j (hahnFractionRamCoordinate r k) =
      algebraMap ℂ (HahnFraction (mgDeg N) ℂ) (if k = j then -1 else 0) := by
  rw [hahnFractionRamCoordinate, hahnFractionRamPartial_algebraMap]
  have hs : mgRamPartialComplex r j (HahnSeries.single (mgRamUnit r k) 1) =
      algebraMap ℂ (HahnSeries (mgDeg N) ℂ) (if k = j then -1 else 0) := by
    by_cases hkj : k = j
    · subst k
      ext d
      rw [show mgRamPartialComplex r j (HahnSeries.single (mgRamUnit r j) 1) =
          mgRamShift r j * hahnGrade (mgRamComp r j)
            (HahnSeries.single (mgRamUnit r j) 1) by rfl]
      simp only [mgRamShift, HahnSeries.coeff_single_mul, coeff_hahnGrade]
      have hrC : (r j : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt (hr j))
      by_cases hd : d = 0
      · subst d
        rw [show (0 : mgDeg N) - mgRamStep r j = mgRamUnit r j by
          have hzero := mgRamUnit_add_step r j
          rw [eq_neg_of_add_eq_zero_left hzero]
          abel]
        have hcomp : mgRamComp r j (mgRamUnit r j) = -1 := by
          change ((((ofLex (mgRamUnit r j) j : ℤ) : ℂ) / (r j : ℂ))) = -1
          rw [ofLex_mgRamUnit, if_pos rfl]
          push_cast
          field_simp
        rw [hcomp]
        simp
      · have hne : d - mgRamStep r j ≠ mgRamUnit r j := by
          intro h
          apply hd
          calc
            d = (d - mgRamStep r j) + mgRamStep r j := by abel
            _ = mgRamUnit r j + mgRamStep r j := by rw [h]
            _ = 0 := mgRamUnit_add_step r j
        rw [HahnSeries.coeff_single, if_neg hne]
        simp [hd]
    · ext d
      rw [show mgRamPartialComplex r j (HahnSeries.single (mgRamUnit r k) 1) =
          mgRamShift r j * hahnGrade (mgRamComp r j)
            (HahnSeries.single (mgRamUnit r k) 1) by rfl]
      simp only [mgRamShift, HahnSeries.coeff_single_mul, coeff_hahnGrade]
      have hkj' : j ≠ k := Ne.symm hkj
      simp only [if_neg hkj]
      by_cases hindex : d - mgRamStep r j = mgRamUnit r k
      · rw [HahnSeries.coeff_single, if_pos hindex, mul_one]
        have hcomp : mgRamComp r j (d - mgRamStep r j) = 0 := by
          change ((((ofLex (d - mgRamStep r j) j : ℤ) : ℂ) / (r j : ℂ))) = 0
          rw [hindex, ofLex_mgRamUnit, if_neg hkj']
          norm_num
        rw [hcomp]
        simp
      · rw [HahnSeries.coeff_single, if_neg hindex]
        simp
  simpa only [IsScalarTower.algebraMap_apply ℂ (HahnSeries (mgDeg N) ℂ)
    (HahnFraction (mgDeg N) ℂ)] using
    congrArg (algebraMap (HahnSeries (mgDeg N) ℂ)
      (HahnFraction (mgDeg N) ℂ)) hs

/-- The product-cascade vector field sends a coordinate to the corresponding suffix product. -/
theorem hahnFractionRamCascadeDerivation_coordinate {N : ℕ} (r : Fin N → ℕ)
    (hr : ∀ i, 0 < r i) (A : Fin N → HahnFraction (mgDeg N) ℂ) (k : Fin N) :
    hahnFractionRamCascadeDerivation r A (hahnFractionRamCoordinate r k) =
      hahnFractionRamSuffixProduct A (k : ℕ) := by
  rw [hahnFractionRamCascadeDerivation_apply]
  simp_rw [hahnFractionRamPartial_coordinate r hr]
  rw [Finset.sum_eq_single k]
  · simp
  · intro j _ hjk
    simp [Ne.symm hjk]
  · intro hk
    exact (hk (Finset.mem_univ k)).elim

/-! ## Relative algebraic branch field -/

/-- Rational field generated by all original ramified coordinates. -/
abbrev RamifiedCoordinateField {N : ℕ} (r : Fin N → ℕ) :=
  IntermediateField.adjoin ℂ (Set.range (hahnFractionRamCoordinate r))

/-- Relative algebraic closure of the coordinate field inside the multigraded Hahn fraction field. -/
abbrev RamifiedPuiseuxBranchField {N : ℕ} (r : Fin N → ℕ) :=
  algebraicClosure (RamifiedCoordinateField r) (HahnFraction (mgDeg N) ℂ)

/-- Inclusion of the intrinsic branch field into its ambient Hahn fraction field. -/
noncomputable def ramifiedPuiseuxBranchEmbedding {N : ℕ} (r : Fin N → ℕ) :
    RamifiedPuiseuxBranchField r →ₐ[ℂ] HahnFraction (mgDeg N) ℂ :=
  (RamifiedPuiseuxBranchField r).restrictScalars ℂ |>.val

/-- A ramified coordinate as an element of the intrinsic branch field. -/
noncomputable def ramifiedCoordinateInBranchField {N : ℕ} (r : Fin N → ℕ) (k : Fin N) :
    RamifiedPuiseuxBranchField r :=
  ⟨hahnFractionRamCoordinate r k, by
    exact mem_algebraicClosure_restrictScalars_of_mem (RamifiedCoordinateField r)
      (IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self k))⟩

@[simp]
theorem ramifiedPuiseuxBranchEmbedding_coordinate {N : ℕ} (r : Fin N → ℕ) (k : Fin N) :
    ramifiedPuiseuxBranchEmbedding r (ramifiedCoordinateInBranchField r k) =
      hahnFractionRamCoordinate r k := rfl

/-- A selected algebraic velocity branch as an element of the intrinsic branch field. -/
noncomputable def ramifiedVelocityInBranchField {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) (j : Fin N) :
    RamifiedPuiseuxBranchField r :=
  ⟨A j, mem_algebraicClosure_iff.mpr (hAlg j)⟩

/-- Suffix product of selected velocities inside the intrinsic branch field. -/
noncomputable def ramifiedSuffixProductInBranchField {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) (k : ℕ) :
    RamifiedPuiseuxBranchField r :=
  ∏ j ∈ Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ)),
    ramifiedVelocityInBranchField r A hAlg j

@[simp]
theorem ramifiedSuffixProductInBranchField_coe {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) (k : ℕ) :
    ((ramifiedSuffixProductInBranchField r A hAlg k : RamifiedPuiseuxBranchField r) :
        HahnFraction (mgDeg N) ℂ) = hahnFractionRamSuffixProduct A k := by
  simp [ramifiedSuffixProductInBranchField, ramifiedVelocityInBranchField,
    hahnFractionRamSuffixProduct]

/-! ## Restricted coordinate frame -/

/-- Every ramified coordinate derivation preserves the intrinsic branch field. -/
theorem hahnFractionRamPartial_mem_ramifiedPuiseuxBranchField {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i) (j : Fin N)
    {y : HahnFraction (mgDeg N) ℂ} (hy : y ∈ RamifiedPuiseuxBranchField r) :
    hahnFractionRamPartial r j y ∈ RamifiedPuiseuxBranchField r := by
  letI : CharZero (HahnFraction (mgDeg N) ℂ) :=
    charZero_of_injective_algebraMap
      (algebraMap ℂ (HahnFraction (mgDeg N) ℂ)).injective
  apply derivationBase_mem_algebraicClosure_adjoin
    (hahnFractionRamPartial r j) (S := Set.range (hahnFractionRamCoordinate r))
  · intro x hx
    rcases hx with ⟨k, rfl⟩
    rw [hahnFractionRamPartial_coordinate r hr]
    exact IntermediateField.algebraMap_mem (RamifiedCoordinateField r) _
  · exact hy

/-- Coordinate derivation restricted to the intrinsic algebraic branch field. -/
noncomputable def ramifiedPuiseuxBranchPartial {N : ℕ} (r : Fin N → ℕ)
    (hr : ∀ i, 0 < r i) (j : Fin N) :
    Derivation ℂ (RamifiedPuiseuxBranchField r) (RamifiedPuiseuxBranchField r) :=
  restrictDerivation (hahnFractionRamPartial r j)
    ((RamifiedPuiseuxBranchField r).restrictScalars ℂ)
    (fun _ hy => hahnFractionRamPartial_mem_ramifiedPuiseuxBranchField r hr j hy)

@[simp]
theorem ramifiedPuiseuxBranchPartial_coe {N : ℕ} (r : Fin N → ℕ)
    (hr : ∀ i, 0 < r i) (j : Fin N) (y : RamifiedPuiseuxBranchField r) :
    ((ramifiedPuiseuxBranchPartial r hr j y : RamifiedPuiseuxBranchField r) :
        HahnFraction (mgDeg N) ℂ) =
      hahnFractionRamPartial r j (y : HahnFraction (mgDeg N) ℂ) := rfl

/-! ## Restricted cascade law -/

/-- If every selected velocity branch is algebraic over the coordinate field, the product-cascade
derivation preserves the intrinsic branch field. -/
theorem hahnFractionRamCascadeDerivation_mem_ramifiedPuiseuxBranchField {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j))
    {y : HahnFraction (mgDeg N) ℂ} (hy : y ∈ RamifiedPuiseuxBranchField r) :
    hahnFractionRamCascadeDerivation r A y ∈ RamifiedPuiseuxBranchField r := by
  classical
  letI : CharZero (HahnFraction (mgDeg N) ℂ) :=
    charZero_of_injective_algebraMap
      (algebraMap ℂ (HahnFraction (mgDeg N) ℂ)).injective
  let E := RamifiedCoordinateField r
  let B := RamifiedPuiseuxBranchField r
  let D := hahnFractionRamCascadeDerivation r A
  have hA : ∀ j, A j ∈ B := fun j => mem_algebraicClosure_iff.mpr (hAlg j)
  have hQ : ∀ k, hahnFractionRamSuffixProduct A k ∈ B := by
    intro k
    rw [hahnFractionRamSuffixProduct]
    induction (Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ))) using
        Finset.induction_on with
    | empty => exact one_mem B
    | @insert j s hjs ih =>
        rw [Finset.prod_insert hjs]
        exact mul_mem (hA j) ih
  have hE : ∀ z : HahnFraction (mgDeg N) ℂ, z ∈ E → D z ∈ B := by
    intro z hz
    exact (derivationBase_mem_of_mem_adjoin D
      (M := B.restrictScalars ℂ)
      (fun x hx => by
        rcases hx with ⟨k, rfl⟩
        constructor
        · exact mem_algebraicClosure_restrictScalars_of_mem E
            (IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self k))
        · rw [hahnFractionRamCascadeDerivation_coordinate r hr A k]
          exact hQ (k : ℕ)) hz).2
  exact derivationInt_mem_algebraicClosure E (toIntDerivation D) (fun z hz => by
    rw [IntermediateField.mem_bot] at hz
    obtain ⟨w, rfl⟩ := hz
    exact hE (w : HahnFraction (mgDeg N) ℂ) w.2) hy

/-- Product-cascade derivation restricted to the intrinsic algebraic branch field. -/
noncomputable def ramifiedPuiseuxBranchCascadeDerivation {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) :
    Derivation ℂ (RamifiedPuiseuxBranchField r) (RamifiedPuiseuxBranchField r) :=
  restrictDerivation (hahnFractionRamCascadeDerivation r A)
    ((RamifiedPuiseuxBranchField r).restrictScalars ℂ)
    (fun _ hy => hahnFractionRamCascadeDerivation_mem_ramifiedPuiseuxBranchField
      r hr A hAlg hy)

@[simp]
theorem ramifiedPuiseuxBranchCascadeDerivation_coe {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j))
    (y : RamifiedPuiseuxBranchField r) :
    ((ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg y :
        RamifiedPuiseuxBranchField r) : HahnFraction (mgDeg N) ℂ) =
      hahnFractionRamCascadeDerivation r A
        (y : HahnFraction (mgDeg N) ℂ) := rfl

/-- The restricted cascade law sends each branch-field coordinate to its selected suffix
velocity product. -/
theorem ramifiedPuiseuxBranchCascadeDerivation_coordinate {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) (k : Fin N) :
    ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg
        (ramifiedCoordinateInBranchField r k) =
      ramifiedSuffixProductInBranchField r A hAlg (k : ℕ) := by
  apply Subtype.ext
  simpa only [ramifiedPuiseuxBranchCascadeDerivation_coe,
    ramifiedSuffixProductInBranchField_coe, ramifiedCoordinateInBranchField] using
      hahnFractionRamCascadeDerivation_coordinate r hr A k

set_option maxHeartbeats 1000000 in
/-- **Selected branches determine the differential specialization.**  Let the intrinsic branch
field embed into any characteristic-zero target field.  If its coordinates map to a target state
and the target derivation realizes the selected suffix-product law on those coordinates, then the
embedding intertwines the cascade derivations on the entire algebraic branch field.  Agreement on
algebraic branch elements is forced by target-valued derivation uniqueness. -/
theorem ramifiedPuiseuxBranchCascadeDerivation_map {N : ℕ}
    {L : Type*} [Field L] [Algebra ℂ L]
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j))
    (rho : RamifiedPuiseuxBranchField r →ₐ[ℂ] L) (delta : Derivation ℂ L L)
    (x : Fin N → L)
    (hx : ∀ k, rho (ramifiedCoordinateInBranchField r k) = x k)
    (hlaw : ∀ k, delta (x k) =
      rho (ramifiedSuffixProductInBranchField r A hAlg (k : ℕ))) :
    ∀ y : RamifiedPuiseuxBranchField r,
      rho (ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg y) =
        delta (rho y) := by
  let H := HahnFraction (mgDeg N) ℂ
  let E := RamifiedCoordinateField r
  let B := RamifiedPuiseuxBranchField r
  let DB := ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg
  letI : CharZero H := charZero_of_injective_algebraMap (algebraMap ℂ H).injective
  letI : CharZero E := (IntermediateField.val E).toRingHom.charZero
  letI : CharZero B := (IntermediateField.val B).toRingHom.charZero
  apply derivation_map_eq_of_isAlgebraic (K := E) rho DB delta
  intro z
  let xE : Fin N → E := fun k =>
    ⟨hahnFractionRamCoordinate r k,
      IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self k)⟩
  have hxTop : IntermediateField.adjoin ℂ (Set.range xE) = ⊤ := by
    have h := adjoin_range_lift_eq_top
      (F := ℂ) (E := H) (I := Fin N)
      (hahnFractionRamCoordinate r) (hahnFractionRamCoordinate r) rfl
    exact h
  let eB : E →ₐ[ℂ] B := IsScalarTower.toAlgHom ℂ E B
  let rhoE : E →ₐ[ℂ] L := rho.comp eB
  letI : Algebra B L := rho.toAlgebra
  letI : IsScalarTower ℂ B L := IsScalarTower.of_algebraMap_eq fun c =>
    (rho.commutes c).symm
  letI : Algebra E L := rhoE.toAlgebra
  letI : IsScalarTower ℂ E L := IsScalarTower.of_algebraMap_eq fun c =>
    (rhoE.commutes c).symm
  letI : IsScalarTower E B L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let DmodelB : Derivation ℂ B L := derivationAlgebraMap ℂ B L DB
  let Dmodel : Derivation ℂ E L :=
    derivationCompAlgebraMapDomain ℂ E B L DmodelB
  let Dactual : Derivation ℂ E L := Derivation.mk'
    (delta.toLinearMap.comp rhoE.toLinearMap) (by
      intro u v
      change delta (rhoE (u * v)) = _
      rw [map_mul rhoE u v]
      rw [delta.leibniz]
      change rhoE u * delta (rhoE v) + rhoE v * delta (rhoE u) =
        rhoE u * delta (rhoE v) + rhoE v * delta (rhoE u)
      rfl)
  let gap : Derivation ℂ E L := Dactual - Dmodel
  have hgap : gap z = 0 := derivation_eq_zero_of_mem_adjoin_to_field gap
    (S := Set.range xE) (fun _ hu => by
      rcases hu with ⟨k, rfl⟩
      change delta (rhoE (xE k)) - rho (DB (eB (xE k))) = 0
      have hcoordE : eB (xE k) = ramifiedCoordinateInBranchField r k := by
        apply Subtype.ext
        rfl
      have hrhoE : rhoE (xE k) = rho (ramifiedCoordinateInBranchField r k) := by
        change rho (eB (xE k)) = _
        rw [hcoordE]
      rw [hrhoE, hx]
      change delta (x k) - rho
        (ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg (eB (xE k))) = 0
      rw [hcoordE, ramifiedPuiseuxBranchCascadeDerivation_coordinate r hr A hAlg k,
        ← hlaw k]
      exact sub_self _) (by rw [hxTop]; trivial)
  change delta (rho (algebraMap E B z)) -
      rho (DB (algebraMap E B z)) = 0 at hgap
  exact (sub_eq_zero.mp hgap).symm

/-! ## Exact branch-field specialization and observability -/

/-- The intrinsic relative algebraic closure supplies the selected ramified Puiseux differential
specialization; it is a theorem from branch algebraicity, not additional model data. -/
theorem isRamifiedPuiseuxCascadeSpecialization_branchField {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j)) :
    IsRamifiedPuiseuxCascadeSpecialization r A (ramifiedPuiseuxBranchEmbedding r)
      (ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg)
      (ramifiedPuiseuxBranchPartial r hr) (ramifiedCoordinateInBranchField r 0) := by
  exact ⟨rfl, fun _ => rfl, fun _ _ => rfl⟩

/-- **Intrinsic ramified Puiseux branch observability.**  Algebraicity over the full rational
coordinate field and nonzero output-linear Puiseux leads force algebraic independence of the
terminal coordinate's first full time-jet block in the selected algebraic branch field. -/
theorem algebraicIndependent_ramifiedPuiseuxBranchCascadeOutputJets {n : ℕ}
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j))
    (lambda : Fin (n + 1) → ℂ) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent ℂ (fun i : Fin (n + 1) =>
      (((ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg :
        RamifiedPuiseuxBranchField r → RamifiedPuiseuxBranchField r)^[(i : ℕ)]))
        (ramifiedCoordinateInBranchField r 0)) := by
  exact algebraicIndependent_cascadeOutputJets_of_ramifiedPuiseuxSpecialization
    r hr A lambda hlambda hA (ramifiedPuiseuxBranchEmbedding r)
    (ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg)
    (ramifiedPuiseuxBranchPartial r hr) (ramifiedCoordinateInBranchField r 0)
    (isRamifiedPuiseuxCascadeSpecialization_branchField r hr A hAlg)

set_option maxHeartbeats 1000000 in
/-- **Output-jet independence in every selected realization.**  Once a target field realizes the
selected Puiseux branch coordinates and their exact cascade law, its terminal coordinate and first
`N-1` derivatives are algebraically independent. -/
theorem algebraicIndependent_ramifiedPuiseuxBranchCascadeOutputJets_of_realization {n : ℕ}
    {L : Type*} [Field L] [Algebra ℂ L]
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) ℂ)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateField r) (A j))
    (lambda : Fin (n + 1) → ℂ) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j))
    (rho : RamifiedPuiseuxBranchField r →ₐ[ℂ] L) (delta : Derivation ℂ L L)
    (x : Fin (n + 1) → L)
    (hx : ∀ k, rho (ramifiedCoordinateInBranchField r k) = x k)
    (hlaw : ∀ k, delta (x k) =
      rho (ramifiedSuffixProductInBranchField r A hAlg (k : ℕ))) :
    AlgebraicIndependent ℂ (fun i : Fin (n + 1) =>
      ((delta : L → L)^[(i : ℕ)]) (x 0)) := by
  have hsource := algebraicIndependent_ramifiedPuiseuxBranchCascadeOutputJets
    r hr A hAlg lambda hlambda hA
  have himage : AlgebraicIndependent ℂ (fun i : Fin (n + 1) =>
      rho ((((ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg :
        RamifiedPuiseuxBranchField r → RamifiedPuiseuxBranchField r)^[(i : ℕ)]))
          (ramifiedCoordinateInBranchField r 0))) := by
    simpa only [Function.comp_def] using hsource.map' rho.injective
  have hmap := ramifiedPuiseuxBranchCascadeDerivation_map
    r hr A hAlg rho delta x hx hlaw
  have hiter : ∀ (m : ℕ) (y : RamifiedPuiseuxBranchField r),
      rho ((((ramifiedPuiseuxBranchCascadeDerivation r hr A hAlg :
        RamifiedPuiseuxBranchField r → RamifiedPuiseuxBranchField r)^[m])) y) =
        ((delta : L → L)^[m]) (rho y) := by
    intro m
    induction m with
    | zero => intro y; rfl
    | succ m ih =>
        intro y
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hmap, ih]
  simpa only [hiter, hx 0] using himage

end GaloisForLFunctions.HTGeometry
