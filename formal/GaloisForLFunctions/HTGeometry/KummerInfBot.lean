import GaloisForLFunctions.HTGeometry.CompleteTheSquare

/-!
# The intersection is trivial when no square root survives

If the intersection of two intermediate fields is either the base or a quadratic extension of it,
and no square root of a base element lands in the second field, then the intersection is the base.

A quadratic intersection would contain an element of degree two, which after completing the square
is a square root of a base element lying in the second field.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped IntermediateField

variable {F L : Type*} [Field F] [Field L] [Algebra F L]

/-- **A quadratic intersection produces a forbidden square root.** -/
theorem inf_eq_bot_of_no_sqrt [CharZero F] {E M : IntermediateField F L}
    (hdeg : Module.finrank F (E ⊓ M : IntermediateField F L) = 1 ∨
      Module.finrank F (E ⊓ M : IntermediateField F L) = 2)
    (hobs : ∀ (δ : L) (c : F), δ ∈ E → δ * δ = algebraMap F L c →
      δ ∉ (⊥ : IntermediateField F L) → δ ∉ M) :
    E ⊓ M = ⊥ := by
  rcases hdeg with h1 | h2
  · exact IntermediateField.finrank_eq_one_iff.mp h1
  · exfalso
    have hfd : FiniteDimensional F (E ⊓ M : IntermediateField F L) :=
      Module.finite_of_finrank_eq_succ h2
    have hne : (E ⊓ M : IntermediateField F L) ≠ ⊥ := by
      intro hcon
      rw [hcon] at h2
      rw [IntermediateField.finrank_bot] at h2
      exact absurd h2 (by norm_num)
    obtain ⟨x, hxmem, hxbot⟩ : ∃ x ∈ (E ⊓ M : IntermediateField F L),
        x ∉ (⊥ : IntermediateField F L) := by
      by_contra hcon
      refine hne (le_antisymm (fun z hz => ?_) bot_le)
      by_contra hzb
      exact hcon ⟨z, hz, hzb⟩
    have hle : F⟮x⟯ ≤ (E ⊓ M : IntermediateField F L) := by
      rw [IntermediateField.adjoin_simple_le_iff]
      exact hxmem
    have hxint : IsIntegral F x := by
      have h1 : IsIntegral F (⟨x, hxmem⟩ : (E ⊓ M : IntermediateField F L)) :=
        IsIntegral.of_finite F _
      have h2' := h1.map ((E ⊓ M : IntermediateField F L).val)
      simpa using h2'
    have hrank : Module.finrank F F⟮x⟯ = (minpoly F x).natDegree :=
      IntermediateField.adjoin.finrank hxint
    have hxne : F⟮x⟯ ≠ ⊥ := by
      intro hcon
      refine hxbot ?_
      rw [← hcon]
      exact IntermediateField.mem_adjoin_simple_self F x
    have hge : 2 ≤ Module.finrank F F⟮x⟯ := by
      have hpos : 0 < Module.finrank F F⟮x⟯ := by
        have : FiniteDimensional F F⟮x⟯ := IntermediateField.adjoin.finiteDimensional hxint
        exact Module.finrank_pos
      have hne1 : Module.finrank F F⟮x⟯ ≠ 1 := fun hcon =>
        hxne (IntermediateField.finrank_eq_one_iff.mp hcon)
      omega
    have hlerank : Module.finrank F F⟮x⟯ ≤ 2 := by
      rw [← h2]
      exact IntermediateField.finrank_le_of_le_right hle
    have hdeg2 : (minpoly F x).natDegree = 2 := by
      rw [← hrank]
      omega
    obtain ⟨δ, c, hδsq, hδadj, hδbot⟩ := exists_sqrt_adjoin_eq hxint hdeg2
    have hδmem : δ ∈ F⟮x⟯ := by
      rw [← hδadj]
      exact IntermediateField.mem_adjoin_simple_self F δ
    refine hobs δ c ((le_trans hle inf_le_left) hδmem) hδsq hδbot ?_
    exact (le_trans hle inf_le_right) hδmem

/-- **The dichotomy in root form.**  If the intersection is either the base or contains a square
root of a base element, and no such square root lies in the second factor, the intersection is the
base.  This is the form in which the concrete case supplies its data: there the quadratic
intersection is generated by an explicit square root. -/
theorem inf_eq_bot_of_no_sqrt_of_root {E M : IntermediateField F L}
    (hdich : (E ⊓ M : IntermediateField F L) = ⊥ ∨
      ∃ (δ : L) (c : F), δ ∈ (E ⊓ M : IntermediateField F L) ∧
        δ * δ = algebraMap F L c ∧ δ ∉ (⊥ : IntermediateField F L))
    (hobs : ∀ (δ : L) (c : F), δ ∈ E → δ * δ = algebraMap F L c →
      δ ∉ (⊥ : IntermediateField F L) → δ ∉ M) :
    E ⊓ M = ⊥ := by
  rcases hdich with h | ⟨δ, c, hmem, hsq, hbot⟩
  · exact h
  · refine absurd ?_ (hobs δ c ((inf_le_left : (E ⊓ M : IntermediateField F L) ≤ E) hmem) hsq hbot)
    exact (inf_le_right : (E ⊓ M : IntermediateField F L) ≤ M) hmem

end GaloisForLFunctions.HTGeometry
