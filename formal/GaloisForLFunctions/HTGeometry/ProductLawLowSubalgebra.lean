import GaloisForLFunctions.HTGeometry.ProductLawFractionModel

/-!
# The low-coordinate subalgebra of the rational model

Every object of the product law with index at most `m` — coordinates, factors, jets, logarithmic
sums — lies in the subalgebra generated by the first `m` coordinates together with the inverses of
their factors.  That subalgebra is stable under the product law, because the derivative of a low
coordinate is a product of low factors and the derivative of an inverse is again built from the same
data.  The higher coordinate derivations annihilate it.

This is the bookkeeping the height induction needs: at each step the newest coordinate enters only
through the newest jet.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-! ## Factors as evaluations -/

/-- A factor is the univariate polynomial evaluated at the coordinate. -/
theorem fact_eq_aeval (p : Polynomial ℂ) (j : ℕ) :
    fact p j = Polynomial.aeval (fx j) p := by
  rw [fact, univFactor, fx]
  exact (Polynomial.aeval_algHom_apply
    (IsScalarTower.toAlgHom ℂ (MvPolynomial ℕ ℂ) CascadeField) (MvPolynomial.X j) p).symm

@[simp] theorem fact_C (a : ℂ) (j : ℕ) :
    fact (Polynomial.C a) j = algebraMap ℂ CascadeField a := by
  rw [fact_eq_aeval, Polynomial.aeval_C]

@[simp] theorem fact_zero (j : ℕ) : fact (0 : Polynomial ℂ) j = 0 := by
  rw [fact_eq_aeval, map_zero]

theorem fact_add (p q : Polynomial ℂ) (j : ℕ) :
    fact (p + q) j = fact p j + fact q j := by
  rw [fact_eq_aeval, fact_eq_aeval, fact_eq_aeval, map_add]

theorem fact_monomial (a : ℂ) (n j : ℕ) :
    fact (Polynomial.C a * Polynomial.X ^ n) j
      = algebraMap ℂ CascadeField a * fx j ^ n := by
  rw [fact_eq_aeval]
  simp

/-- **The chain rule for a factor.**  Any derivation of the model differentiates a factor by the
derivative of its polynomial. -/
theorem derivation_fact (D : Derivation ℂ CascadeField CascadeField) (p : Polynomial ℂ) (j : ℕ) :
    D (fact p j) = fact p.derivative j * D (fx j) := by
  induction p using Polynomial.induction_on with
  | C a =>
      rw [fact_C, Polynomial.derivative_C, fact_zero, zero_mul]
      exact D.map_algebraMap a
  | add p q hp hq =>
      rw [fact_add, map_add, hp, hq, Polynomial.derivative_add, fact_add, add_mul]
  | monomial n a _ =>
      have hder : (Polynomial.C a * Polynomial.X ^ (n + 1)).derivative
          = Polynomial.C ((n : ℂ) + 1) * (Polynomial.C a * Polynomial.X ^ n) := by
        rw [Polynomial.derivative_C_mul, Polynomial.derivative_X_pow]
        simp only [Nat.add_sub_cancel]
        push_cast
        ring
      have hderval : fact (Polynomial.C ((n : ℂ) + 1) * (Polynomial.C a * Polynomial.X ^ n)) j
          = algebraMap ℂ CascadeField ((n : ℂ) + 1)
            * (algebraMap ℂ CascadeField a * fx j ^ n) := by
        rw [fact_eq_aeval]
        simp
      rw [fact_monomial, hder, hderval, Derivation.leibniz, D.map_algebraMap, smul_zero, add_zero,
        Derivation.leibniz_pow]
      simp only [Nat.add_sub_cancel, smul_eq_mul]
      have hcast : ((n + 1 : ℕ) : CascadeField) = algebraMap ℂ CascadeField ((n : ℂ) + 1) := by
        push_cast
        simp
      rw [← Nat.cast_smul_eq_nsmul CascadeField (n + 1) (fx j ^ n * D (fx j)), smul_eq_mul, hcast]
      ring

/-! ## The subalgebra -/

variable (Q v : ℕ → Polynomial ℂ)

/-- The subalgebra generated by the coordinates of index at most `m` and the inverses of their
factors. -/
noncomputable def lowSub (m : ℕ) : Subalgebra ℂ CascadeField :=
  Algebra.adjoin ℂ
    ({z : CascadeField | ∃ j, j ≤ m ∧ z = fx j}
      ∪ {z : CascadeField | ∃ j, j ≤ m ∧ z = (fact (Q j) j)⁻¹}
      ∪ {z : CascadeField | ∃ j, j ≤ m ∧ z = (fact (v j) j)⁻¹})

theorem fx_mem_lowSub {j m : ℕ} (h : j ≤ m) : fx j ∈ lowSub Q v m :=
  Algebra.subset_adjoin (Or.inl (Or.inl ⟨j, h, rfl⟩))

theorem invQ_mem_lowSub {j m : ℕ} (h : j ≤ m) : (fact (Q j) j)⁻¹ ∈ lowSub Q v m :=
  Algebra.subset_adjoin (Or.inl (Or.inr ⟨j, h, rfl⟩))

theorem invV_mem_lowSub {j m : ℕ} (h : j ≤ m) : (fact (v j) j)⁻¹ ∈ lowSub Q v m :=
  Algebra.subset_adjoin (Or.inr ⟨j, h, rfl⟩)

/-- Every factor at a low coordinate is low. -/
theorem fact_mem_lowSub {j m : ℕ} (h : j ≤ m) (p : Polynomial ℂ) :
    fact p j ∈ lowSub Q v m := by
  induction p using Polynomial.induction_on with
  | C a =>
      rw [fact_C]
      exact Subalgebra.algebraMap_mem _ a
  | add p q hp hq =>
      rw [fact_add]
      exact Subalgebra.add_mem _ hp hq
  | monomial n a _ =>
      rw [fact_monomial]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
        (Subalgebra.pow_mem _ (fx_mem_lowSub Q v h) _)

theorem prodHead_mem_lowSub {k m : ℕ} (h : k ≤ m) : prodHead Q k ∈ lowSub Q v m := by
  refine Subalgebra.prod_mem _ fun j hj => ?_
  have hjk : j < k := Finset.mem_range.mp hj
  exact fact_mem_lowSub Q v (by omega) (Q j)

theorem prodJet_mem_lowSub {k m : ℕ} (h : k ≤ m) : prodJet Q v k ∈ lowSub Q v m := by
  rw [prodJet_eq]
  exact Subalgebra.mul_mem _ (prodHead_mem_lowSub Q v h) (fact_mem_lowSub Q v h (v k))

theorem logFactorQ_mem_lowSub {j m : ℕ} (h : j ≤ m) :
    logFactor (Q j) j ∈ lowSub Q v m := by
  rw [logFactor, div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (fact_mem_lowSub Q v h _) (invQ_mem_lowSub Q v h)

theorem logFactorV_mem_lowSub {j m : ℕ} (h : j ≤ m) :
    logFactor (v j) j ∈ lowSub Q v m := by
  rw [logFactor, div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (fact_mem_lowSub Q v h _) (invV_mem_lowSub Q v h)

theorem logSum_mem_lowSub {k m : ℕ} (h : k ≤ m) : logSum Q v k ∈ lowSub Q v m := by
  refine Subalgebra.sum_mem _ fun j hj => ?_
  have hjk : j < k := Finset.mem_range.mp hj
  exact Subalgebra.mul_mem _ (logFactorQ_mem_lowSub Q v (by omega))
    (prodJet_mem_lowSub Q v (by omega))

/-! ## Stability and annihilation -/

/-- **The low subalgebra is stable under the product law.** -/
theorem prodDerivation_mem_lowSub {m : ℕ} {P : CascadeField} (h : P ∈ lowSub Q v m) :
    prodDerivation Q v P ∈ lowSub Q v m := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with (⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩
      · rw [prodDerivation_fx]
        exact prodJet_mem_lowSub Q v hj
      · rw [Derivation.leibniz_inv, derivation_fact, prodDerivation_fx, smul_eq_mul]
        exact Subalgebra.mul_mem _
          (Subalgebra.neg_mem _ (Subalgebra.pow_mem _ (invQ_mem_lowSub Q v hj) 2))
          (Subalgebra.mul_mem _ (fact_mem_lowSub Q v hj _) (prodJet_mem_lowSub Q v hj))
      · rw [Derivation.leibniz_inv, derivation_fact, prodDerivation_fx, smul_eq_mul]
        exact Subalgebra.mul_mem _
          (Subalgebra.neg_mem _ (Subalgebra.pow_mem _ (invV_mem_lowSub Q v hj) 2))
          (Subalgebra.mul_mem _ (fact_mem_lowSub Q v hj _) (prodJet_mem_lowSub Q v hj))
  | algebraMap c =>
      rw [(prodDerivation Q v).map_algebraMap]
      exact Subalgebra.zero_mem _
  | add x y _ _ ihx ihy =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy =>
      simp only [Derivation.leibniz, smul_eq_mul]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx ihy) (Subalgebra.mul_mem _ hy ihx)

/-- All jets of a low object stay low. -/
theorem iterate_prodDerivation_mem_lowSub {m : ℕ} {P : CascadeField}
    (h : P ∈ lowSub Q v m) (i : ℕ) :
    ((prodDerivation Q v : CascadeField → CascadeField)^[i]) P ∈ lowSub Q v m := by
  induction i with
  | zero => simpa using h
  | succ i ih =>
      rw [Function.iterate_succ_apply']
      exact prodDerivation_mem_lowSub Q v ih

/-- **High coordinate derivations kill low objects.** -/
theorem fpderiv_eq_zero_of_mem_lowSub {m k : ℕ} (hk : m < k) {P : CascadeField}
    (h : P ∈ lowSub Q v m) : fpderiv k P = 0 := by
  induction h using Algebra.adjoin_induction with
  | mem x hx =>
      rcases hx with (⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩
      · exact fpderiv_fx_of_ne (by omega)
      · rw [Derivation.leibniz_inv, derivation_fact, fpderiv_fx_of_ne (by omega), mul_zero,
          smul_zero]
      · rw [Derivation.leibniz_inv, derivation_fact, fpderiv_fx_of_ne (by omega), mul_zero,
          smul_zero]
  | algebraMap c => exact (fpderiv k).map_algebraMap c
  | add x y _ _ ihx ihy => rw [map_add, ihx, ihy, add_zero]
  | mul x y _ _ ihx ihy =>
      rw [Derivation.leibniz, ihx, ihy]
      simp

end GaloisForLFunctions.HTGeometry
