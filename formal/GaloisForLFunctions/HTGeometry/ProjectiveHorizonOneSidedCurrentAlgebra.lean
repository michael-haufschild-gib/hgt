import GaloisForLFunctions.HTGeometry.ProjectiveHorizonHigherRankCurrentAlgebra

/-!
# One-sided depth-two modes generate the full projective horizon current algebra

Two distinct depth-one chart horizons supply the two opposing constant radicals. This file proves
that only one additional linear root mode from either horizon is needed to generate every
polynomial current mode. Thus the symmetry transition is triggered when either one of the two
horizons deletes velocity; symmetric depth two is unnecessary.
-/

open scoped Matrix Polynomial

namespace GaloisForLFunctions

noncomputable section

variable (K : Type*) [Field K]

/-! ## Scalar projective source -/

/-- Two opposing constant modes and one one-sided linear mode. -/
def oneSidedCurrentGenerators :
    Set (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  {sl2CurrentE K 0, sl2CurrentF K 0, sl2CurrentF K 1}

/-- The scalar current Lie algebra generated by the minimal one-sided mode set. -/
def oneSidedCurrentLie :
    LieSubalgebra K (Matrix (Fin 2) (Fin 2) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (oneSidedCurrentGenerators K)

section Scalar

variable [CharZero K]

/-- The three one-sided modes already contain the four symmetric depth-two generators. -/
theorem depthTwoCurrentLie_le_oneSidedCurrentLie :
    depthTwoCurrentLie K ≤ oneSidedCurrentLie K := by
  have hE0 : sl2CurrentE K 0 ∈ oneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [oneSidedCurrentGenerators])
  have hF0 : sl2CurrentF K 0 ∈ oneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [oneSidedCurrentGenerators])
  have hF1 : sl2CurrentF K 1 ∈ oneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [oneSidedCurrentGenerators])
  have hH1 : sl2CurrentH K 1 ∈ oneSidedCurrentLie K := by
    rw [← sl2Current_lie_E_F K 0 1]
    exact (oneSidedCurrentLie K).lie_mem hE0 hF1
  have hE1 : sl2CurrentE K 1 ∈ oneSidedCurrentLie K := by
    have hbr := (oneSidedCurrentLie K).lie_mem hH1 hE0
    rw [sl2Current_lie_H_E K 1 0] at hbr
    have hs := (oneSidedCurrentLie K).smul_mem ((2 : K)⁻¹) hbr
    simpa [smul_smul] using hs
  apply LieSubalgebra.lieSpan_le.mpr
  intro A hA
  simp only [depthTwoCurrentGenerators, Set.mem_insert_iff, Set.mem_singleton_iff] at hA
  rcases hA with rfl | rfl | rfl | rfl
  · exact hE0
  · exact hE1
  · exact hF0
  · exact hF1

/-- The minimal three-mode one-sided generators produce exactly the same polynomial current Lie
algebra as the four symmetric depth-two generators. -/
theorem oneSidedCurrentLie_eq_depthTwoCurrentLie :
    oneSidedCurrentLie K = depthTwoCurrentLie K := by
  apply le_antisymm
  · apply LieSubalgebra.lieSpan_le.mpr
    intro A hA
    apply LieSubalgebra.subset_lieSpan
    simp only [oneSidedCurrentGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl <;> simp [depthTwoCurrentGenerators]
  · exact depthTwoCurrentLie_le_oneSidedCurrentLie K

/-- **Scalar one-sided current generation.** The three modes `E₀,F₀,F₁` generate every
polynomial `sl₂` current mode. -/
theorem oneSidedCurrentLie_contains_all_modes (k : ℕ) :
    sl2CurrentE K k ∈ oneSidedCurrentLie K ∧
    sl2CurrentF K k ∈ oneSidedCurrentLie K ∧
    sl2CurrentH K k ∈ oneSidedCurrentLie K :=
  ⟨depthTwoCurrentLie_le_oneSidedCurrentLie K
      (sl2CurrentE_mem_depthTwoCurrentLie K k),
    depthTwoCurrentLie_le_oneSidedCurrentLie K
      (sl2CurrentF_mem_depthTwoCurrentLie K k),
    depthTwoCurrentLie_le_oneSidedCurrentLie K
      (sl2CurrentH_mem_depthTwoCurrentLie K k)⟩

/-- In every representation, annihilation by `E₀,F₀,F₁` propagates to every polynomial current
mode. -/
theorem oneSidedCurrent_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 2) (Fin 2) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅sl2CurrentE K 0, v⁆ = 0)
    (hF0 : ⁅sl2CurrentF K 0, v⁆ = 0)
    (hF1 : ⁅sl2CurrentF K 1, v⁆ = 0) (k : ℕ) :
    ⁅sl2CurrentE K k, v⁆ = 0 ∧ ⁅sl2CurrentF K k, v⁆ = 0 ∧
      ⁅sl2CurrentH K k, v⁆ = 0 := by
  have hgen : oneSidedCurrentGenerators K ⊆
      (sl2CurrentPointStabilizer (K := K) v : Set _) := by
    intro A hA
    simp only [oneSidedCurrentGenerators, Set.mem_insert_iff, Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl
    · exact hE0
    · exact hF0
    · exact hF1
  have hle : oneSidedCurrentLie K ≤ sl2CurrentPointStabilizer (K := K) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  exact ⟨hle (oneSidedCurrentLie_contains_all_modes K k).1,
    hle (oneSidedCurrentLie_contains_all_modes K k).2.1,
    hle (oneSidedCurrentLie_contains_all_modes K k).2.2⟩

end Scalar

/-! ## First higher-rank projective source -/

/-- The four constant plane modes and one linear semisimple root mode. -/
def p2OneSidedCurrentGenerators :
    Set (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  {p2CurrentE K 0, p2CurrentF K 0, p2CurrentF K 1,
    p2CurrentU K 0, p2CurrentV K 0}

/-- The plane current Lie algebra generated by the minimal one-sided mode set. -/
def p2OneSidedCurrentLie :
    LieSubalgebra K (Matrix (Fin 3) (Fin 3) (Polynomial K)) :=
  LieSubalgebra.lieSpan K _ (p2OneSidedCurrentGenerators K)

section Plane

variable [CharZero K]

/-- The five one-sided plane modes already contain all eight symmetric depth-two generators. -/
theorem p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie :
    p2DepthTwoCurrentLie K ≤ p2OneSidedCurrentLie K := by
  have hE0 : p2CurrentE K 0 ∈ p2OneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2OneSidedCurrentGenerators])
  have hF0 : p2CurrentF K 0 ∈ p2OneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2OneSidedCurrentGenerators])
  have hF1 : p2CurrentF K 1 ∈ p2OneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2OneSidedCurrentGenerators])
  have hU0 : p2CurrentU K 0 ∈ p2OneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2OneSidedCurrentGenerators])
  have hV0 : p2CurrentV K 0 ∈ p2OneSidedCurrentLie K :=
    LieSubalgebra.subset_lieSpan (by simp [p2OneSidedCurrentGenerators])
  have hH1 : p2CurrentH K 1 ∈ p2OneSidedCurrentLie K := by
    rw [← p2Current_lie_E_F K 0 1]
    exact (p2OneSidedCurrentLie K).lie_mem hE0 hF1
  have hE1 : p2CurrentE K 1 ∈ p2OneSidedCurrentLie K := by
    have hbr := (p2OneSidedCurrentLie K).lie_mem hH1 hE0
    rw [p2Current_lie_H_E K 1 0] at hbr
    have hs := (p2OneSidedCurrentLie K).smul_mem ((2 : K)⁻¹) hbr
    simpa [smul_smul] using hs
  have hU1 : p2CurrentU K 1 ∈ p2OneSidedCurrentLie K := by
    have hbr := (p2OneSidedCurrentLie K).lie_mem hH1 hU0
    rw [p2Current_lie_H_U K 1 0] at hbr
    simpa using (p2OneSidedCurrentLie K).neg_mem hbr
  have hV1 : p2CurrentV K 1 ∈ p2OneSidedCurrentLie K := by
    have hbr := (p2OneSidedCurrentLie K).lie_mem hH1 hV0
    simpa using (show p2CurrentV K (1 + 0) ∈ p2OneSidedCurrentLie K by
      rwa [p2Current_lie_H_V K 1 0] at hbr)
  apply LieSubalgebra.lieSpan_le.mpr
  intro A hA
  simp only [p2DepthTwoCurrentGenerators, Set.mem_insert_iff,
    Set.mem_singleton_iff] at hA
  rcases hA with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact hE0
  · exact hE1
  · exact hF0
  · exact hF1
  · exact hU0
  · exact hU1
  · exact hV0
  · exact hV1

/-- The minimal five-mode one-sided plane generators produce exactly the same polynomial current
Lie algebra as the eight symmetric depth-two plane generators. -/
theorem p2OneSidedCurrentLie_eq_p2DepthTwoCurrentLie :
    p2OneSidedCurrentLie K = p2DepthTwoCurrentLie K := by
  apply le_antisymm
  · apply LieSubalgebra.lieSpan_le.mpr
    intro A hA
    apply LieSubalgebra.subset_lieSpan
    simp only [p2OneSidedCurrentGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl | rfl | rfl <;>
      simp [p2DepthTwoCurrentGenerators]
  · exact p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K

/-- **Plane one-sided current generation.** Four constant modes and one linear root mode generate
every polynomial mode of `sl₂ ⋉ (K²)ᵛ`. -/
theorem p2OneSidedCurrentLie_contains_all_modes (k : ℕ) :
    p2CurrentE K k ∈ p2OneSidedCurrentLie K ∧
    p2CurrentF K k ∈ p2OneSidedCurrentLie K ∧
    p2CurrentU K k ∈ p2OneSidedCurrentLie K ∧
    p2CurrentV K k ∈ p2OneSidedCurrentLie K ∧
    p2CurrentH K k ∈ p2OneSidedCurrentLie K :=
  ⟨p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K
      (p2CurrentE_mem_depthTwoCurrentLie K k),
    p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K
      (p2CurrentF_mem_depthTwoCurrentLie K k),
    p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K
      (p2CurrentU_mem_depthTwoCurrentLie K k),
    p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K
      (p2CurrentV_mem_depthTwoCurrentLie K k),
    p2DepthTwoCurrentLie_le_p2OneSidedCurrentLie K
      (p2CurrentH_mem_depthTwoCurrentLie K k)⟩

/-- In every representation, annihilation by the five one-sided plane modes propagates to every
polynomial affine-parabolic current mode. -/
theorem p2OneSidedCurrent_annihilation_propagates
    {M : Type*} [AddCommGroup M] [Module K M]
    [LieRingModule (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    [LieModule K (Matrix (Fin 3) (Fin 3) (Polynomial K)) M]
    (v : M)
    (hE0 : ⁅p2CurrentE K 0, v⁆ = 0)
    (hF0 : ⁅p2CurrentF K 0, v⁆ = 0)
    (hF1 : ⁅p2CurrentF K 1, v⁆ = 0)
    (hU0 : ⁅p2CurrentU K 0, v⁆ = 0)
    (hV0 : ⁅p2CurrentV K 0, v⁆ = 0) (k : ℕ) :
    ⁅p2CurrentE K k, v⁆ = 0 ∧ ⁅p2CurrentF K k, v⁆ = 0 ∧
    ⁅p2CurrentU K k, v⁆ = 0 ∧ ⁅p2CurrentV K k, v⁆ = 0 ∧
    ⁅p2CurrentH K k, v⁆ = 0 := by
  have hgen : p2OneSidedCurrentGenerators K ⊆
      (p2CurrentPointStabilizer (K := K) v : Set _) := by
    intro A hA
    simp only [p2OneSidedCurrentGenerators, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hA
    rcases hA with rfl | rfl | rfl | rfl | rfl
    · exact hE0
    · exact hF0
    · exact hF1
    · exact hU0
    · exact hV0
  have hle : p2OneSidedCurrentLie K ≤ p2CurrentPointStabilizer (K := K) v :=
    LieSubalgebra.lieSpan_le.mpr hgen
  have hall := p2OneSidedCurrentLie_contains_all_modes K k
  exact ⟨hle hall.1, hle hall.2.1, hle hall.2.2.1,
    hle hall.2.2.2.1, hle hall.2.2.2.2⟩

end Plane

end

end GaloisForLFunctions
