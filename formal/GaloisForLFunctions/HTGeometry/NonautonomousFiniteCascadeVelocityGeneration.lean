import GaloisForLFunctions.HTGeometry.CubeSwapGaloisAssembly
import GaloisForLFunctions.HTGeometry.NonautonomousFinitePuiseuxVelocityFactorization

/-!
# Actual cascade branch field is generated by constituent velocities

The finite actual branch field was defined by adjoining every state derivative.  Successive
nonzero derivative ratios are the constituent velocities, and their reversed suffix products
recover all nonconstant derivative generators.  Hence the same finite field is generated over the
state field by the actual velocities.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] cascadeUnitCostDomain cascadeUnitCostRatFuncAlgebra
  cascadeUnitCostComplexAlgebra cascadeUnitCostScalarTower cascadeUnitCostDifferential
  cascadeUnitCostCharZero

/-- Actual constituent velocity, kept over the state-field presentation of the finite branch
field. -/
noncomputable def nonautonomousFiniteCascadeVelocityOverState
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    {N : ℕ} (j : Fin N) : NonautonomousFiniteCascadeBranchFieldOverState hfan N :=
  ⟨cascadeMeroDeriv hfan (j.rev.val + 1) / cascadeMeroDeriv hfan j.rev.val,
    (NonautonomousFiniteCascadeBranchFieldOverState hfan N).div_mem
      (IntermediateField.subset_adjoin
        (NonautonomousRamifiedCascadeStateField hfan N) _
        (Set.mem_range_self (⟨j.rev.val + 1, by omega⟩ : Fin (N + 1))))
      (IntermediateField.subset_adjoin
        (NonautonomousRamifiedCascadeStateField hfan N) _
        (Set.mem_range_self (⟨j.rev.val, by omega⟩ : Fin (N + 1))))⟩

@[simp] theorem nonautonomousFiniteCascadeVelocityOverState_coe
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    {N : ℕ} (j : Fin N) :
    ((nonautonomousFiniteCascadeVelocityOverState hfan j :
      NonautonomousFiniteCascadeBranchFieldOverState hfan N) : meroField Set.univ) =
      cascadeMeroDeriv hfan (j.rev.val + 1) / cascadeMeroDeriv hfan j.rev.val := rfl

/-- Reversed suffix products of the state-field presentation of actual velocities recover the
corresponding actual derivative generators. -/
theorem nonautonomousFiniteCascadeVelocityOverState_suffix_product
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) {N : ℕ} (k : Fin N) :
    ∏ j ∈ Finset.univ.filter (fun j : Fin N => (k : ℕ) ≤ (j : ℕ)),
        nonautonomousFiniteCascadeVelocityOverState hfan j =
      (⟨cascadeMeroDeriv hfan (k.rev.val + 1),
        IntermediateField.subset_adjoin
          (NonautonomousRamifiedCascadeStateField hfan N) _
          (Set.mem_range_self (⟨k.rev.val + 1, by omega⟩ : Fin (N + 1)))⟩ :
        NonautonomousFiniteCascadeBranchFieldOverState hfan N) := by
  let B := NonautonomousFiniteCascadeBranchFieldOverState hfan N
  apply B.val.injective
  rw [map_prod]
  change (∏ j ∈ Finset.univ.filter (fun j : Fin N => (k : ℕ) ≤ (j : ℕ)),
      reversedSuccessiveRatio (fun q => cascadeMeroDeriv hfan q) j) = _
  rw [prod_reversedSuccessiveRatio_suffix
    (fun q => cascadeMeroDeriv hfan q)
    (fun q => cascadeMeroDeriv_ne_zero_of_transcendental hfan hall q) k]
  rw [cascadeMeroDeriv_zero, div_one]
  rfl

/-- The actual constituent velocities generate the entire finite branch field over the actual
state field. -/
theorem adjoin_range_nonautonomousFiniteCascadeVelocityInBranchField_eq_top
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    IntermediateField.adjoin (NonautonomousRamifiedCascadeStateField hfan N)
      (Set.range (fun j : Fin N =>
        nonautonomousFiniteCascadeVelocityOverState hfan j)) = ⊤ := by
  classical
  let E := NonautonomousRamifiedCascadeStateField hfan N
  let B := NonautonomousFiniteCascadeBranchFieldOverState hfan N
  let L : IntermediateField E B := IntermediateField.adjoin E
    (Set.range (fun j : Fin N =>
      (nonautonomousFiniteCascadeVelocityOverState hfan j : B)))
  refine IntermediateField.map_injective B.val ?_
  have hleft : L.map B.val = B := by
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      exact y.2
    · change IntermediateField.adjoin E
          (Set.range (fun i : Fin (N + 1) => cascadeMeroDeriv hfan i)) ≤ L.map B.val
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i.val = 0
      · have hi0 : i = (⟨0, by omega⟩ : Fin (N + 1)) := Fin.ext hi
        rw [hi0]
        change cascadeMeroDeriv hfan 0 ∈ L.map B.val
        rw [cascadeMeroDeriv_zero]
        exact (L.map B.val).one_mem
      · have hN : 0 < N := by omega
        let k : Fin N := ⟨N - i.val, by omega⟩
        have hk : k.rev.val + 1 = i.val := by
          dsimp [k, Fin.rev]
          omega
        have hprod :=
          nonautonomousFiniteCascadeVelocityOverState_suffix_product hfan hall k
        have hmem :
            (⟨cascadeMeroDeriv hfan (k.rev.val + 1),
              IntermediateField.subset_adjoin E _
                (Set.mem_range_self (⟨k.rev.val + 1, by omega⟩ : Fin (N + 1)))⟩ : B) ∈ L := by
          rw [← hprod]
          exact L.prod_mem fun j hj =>
            IntermediateField.subset_adjoin E _ (Set.mem_range_self j)
        exact ⟨⟨cascadeMeroDeriv hfan (k.rev.val + 1),
          IntermediateField.subset_adjoin E _
            (Set.mem_range_self (⟨k.rev.val + 1, by omega⟩ : Fin (N + 1)))⟩,
          hmem, by
            change cascadeMeroDeriv hfan (k.rev.val + 1) = cascadeMeroDeriv hfan i.val
            rw [hk]⟩
  have hright : (⊤ : IntermediateField E B).map B.val = B := by
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      exact y.2
    · intro x hx
      exact ⟨⟨x, hx⟩, trivial, rfl⟩
  change L.map B.val = (⊤ : IntermediateField E B).map B.val
  rw [hleft, hright]

end

end GaloisForLFunctions.HTGeometry
