import GaloisForLFunctions.HTGeometry.ProjectiveHorizonCurrentFixedField

/-!
# The exact depth-two transition for free projective jet currents

This file packages the free-jet field layer of the projective-horizon depth transition.  The
direct depth-`m` current field is the simultaneous kernel of `E₀,...,E_(m-1)`, while the inverse
depth-`n` current field is the simultaneous kernel of `F₀,...,F_(n-1)` for the actual projective
jet derivations constructed in `ProjectiveHorizonCurrentFixedField`.

The main theorem is the complete positive-depth current phase law: their intersection is the
scalar field whenever either depth is at least two.  It includes the symmetric depth-two theorem
and both minimal asymmetric triggers `(1,2)` and `(2,1)`.  On the direct side, the infinitesimal
kernel is also identified exactly with the fixed field of all finite translations supported below
the chosen depth and with the rational tail generated by the remaining coordinates.

These are statements about the literal free rational jet field and its projective current action.
They do not assume a comparison between these current fields and analytic horizons of a particular
meromorphic source.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

/-! ## Full `E-F` current relation -/

/-- Every coordinate partial derivative of the quadratic current coefficient is its reflected
linear coefficient, with multiplicity two. -/
theorem pderiv_projectiveJetSquareCoeff
    {C : Type*} [Field C] (i n : ℕ) :
    MvPolynomial.pderiv i (projectiveJetSquareCoeff C n) =
      if i ≤ n then (2 : C) • MvPolynomial.X (n - i) else 0 := by
  classical
  simp only [projectiveJetSquareCoeff, map_sum, Derivation.leibniz,
    MvPolynomial.pderiv_X, Finset.sum_add_distrib, Pi.single_apply, Algebra.smul_def]
  by_cases hi : i ≤ n
  · rw [if_pos hi]
    have hleft :
        ∑ x ∈ Finset.range (n + 1),
          X x * (if n - x = i then (1 : MvPolynomial ℕ C) else 0) =
            X (n - i) := by
      rw [Finset.sum_eq_single (n - i)]
      · have hsub : n - (n - i) = i := by omega
        simp [hsub]
      · intro b hb hbi
        have hble : b ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hb)
        have hsub : n - b ≠ i := by
          intro h
          apply hbi
          omega
        simp [hsub]
      · simp
    have hright :
        ∑ x ∈ Finset.range (n + 1),
          X (n - x) * (if x = i then (1 : MvPolynomial ℕ C) else 0) =
            X (n - i) := by
      rw [Finset.sum_eq_single i]
      · simp
      · intro b hb hbi
        simp [hbi]
      · simp [hi]
    simp only [Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.algebraMap_eq]
    rw [hleft, hright]
    rw [show MvPolynomial.C (2 : C) = (2 : MvPolynomial ℕ C) by
        exact map_ofNat (MvPolynomial.C : C →+* MvPolynomial ℕ C) 2,
      two_mul]
  · rw [if_neg hi]
    have hleft :
        ∑ x ∈ Finset.range (n + 1),
          X x * (if n - x = i then (1 : MvPolynomial ℕ C) else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro b hb
      have hble : b ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hb)
      have hsub : n - b ≠ i := by omega
      simp [hsub]
    have hright :
        ∑ x ∈ Finset.range (n + 1),
          X (n - x) * (if x = i then (1 : MvPolynomial ℕ C) else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro b hb
      have hble : b ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hb)
      have hne : b ≠ i := by omega
      simp [hne]
    simp only [Algebra.algebraMap_self, RingHom.id_apply]
    rw [hleft, hright]
    simp

/-- The polynomial projective jet action satisfies the full relation `[Eᵢ,Fⱼ]=H_(i+j)`. -/
theorem projectiveJetCurrentEPolynomial_lie_FPolynomial
    {C : Type*} [Field C] (i j : ℕ) :
    ⁅projectiveJetCurrentEPolynomial C i, projectiveJetCurrentFPolynomial C j⁆ =
      projectiveJetCurrentHPolynomial C (i + j) := by
  apply MvPolynomial.derivation_ext
  intro n
  rw [Derivation.commutator_apply]
  simp only [projectiveJetCurrentEPolynomial, projectiveJetCurrentFPolynomial,
    projectiveJetCurrentHPolynomial, MvPolynomial.mkDerivation_X,
    MvPolynomial.pderiv_X, Pi.single_apply]
  have hconst :
      (MvPolynomial.mkDerivation C fun q ↦
        if j ≤ q then -(projectiveJetSquareCoeff C (q - j)) else 0)
          (if n = i then 1 else 0) = 0 := by
    split_ifs <;> simp
  rw [hconst, sub_zero]
  by_cases hjn : j ≤ n
  · rw [if_pos hjn, map_neg, pderiv_projectiveJetSquareCoeff]
    by_cases hijn : i + j ≤ n
    · have hi : i ≤ n - j := by omega
      rw [if_pos hi, if_pos hijn]
      have hsub : n - j - i = n - (i + j) := by omega
      simp [hsub]
    · have hi : ¬i ≤ n - j := by omega
      rw [if_neg hi, if_neg hijn]
      simp
  · have hijn : ¬i + j ≤ n := by omega
    rw [if_neg hjn, if_neg hijn]
    simp

/-- The quotient-rule action on the free rational jet field preserves the full relation
`[Eᵢ,Fⱼ]=H_(i+j)`. -/
theorem projectiveJetCurrentE_lie_F
    {C : Type*} [Field C] (i j : ℕ) :
    ⁅projectiveJetCurrentE C i, projectiveJetCurrentF C j⁆ =
      projectiveJetCurrentH C (i + j) := by
  calc
    ⁅projectiveJetCurrentE C i, projectiveJetCurrentF C j⁆ =
        liftProjectiveJetPolynomialCurrent
          ⁅projectiveJetCurrentEPolynomial C i,
            projectiveJetCurrentFPolynomial C j⁆ :=
      liftProjectiveJetPolynomialCurrent_lie
        (projectiveJetCurrentEPolynomial C i)
        (projectiveJetCurrentFPolynomial C j)
    _ = liftProjectiveJetPolynomialCurrent
        (projectiveJetCurrentHPolynomial C (i + j)) :=
      congrArg liftProjectiveJetPolynomialCurrent
        (projectiveJetCurrentEPolynomial_lie_FPolynomial i j)
    _ = projectiveJetCurrentH C (i + j) := rfl

/-! ## Direct translations and direct/inverse current fields -/

/-- A scalar free-jet translation is supported strictly below depth `n`. -/
def ProjectiveJetTranslationSupportedBelow
    {C : Type*} [Field C] (n : ℕ) (c : ℕ → C) : Prop :=
  ∀ k, n ≤ k → c k = 0

/-- The fixed field of all scalar free-jet translations supported strictly below depth `n`. -/
def projectiveJetLowTranslationFixedField
    (C : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C ℕ) where
  carrier := {f | ∀ c : ℕ → C,
    ProjectiveJetTranslationSupportedBelow n c →
      freeCoordinateTranslationEquiv C ℕ c f = f}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy c hc
    rw [map_add, hx c hc, hy c hc]
  mul_mem' := by
    intro x y hx hy c hc
    rw [map_mul, hx c hc, hy c hc]
  algebraMap_mem' := by
    intro a c hc
    exact (freeCoordinateTranslationEquiv C ℕ c).commutes a
  inv_mem' := by
    intro x hx c hc
    rw [map_inv₀, hx c hc]

@[simp]
theorem mem_projectiveJetLowTranslationFixedField_iff
    {C : Type*} [Field C] (n : ℕ)
    (f : FreeCoordinateRationalField C ℕ) :
    f ∈ projectiveJetLowTranslationFixedField C n ↔
      ∀ c : ℕ → C, ProjectiveJetTranslationSupportedBelow n c →
        freeCoordinateTranslationEquiv C ℕ c f = f :=
  Iff.rfl

/-- The rational tail generated by the scalar jet coordinates of order at least `n`. -/
def projectiveJetTailField
    (C : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C ℕ) :=
  freeCoordinateField C ℕ {k | n ≤ k}

/-- The direct depth-`n` projective current field, killed by `E₀,...,E_(n-1)`. -/
def projectiveJetDirectLowCurrentKernelField
    (C : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C ℕ) :=
  freeCoordinateCommonKernelField C ℕ {k | n ≤ k}

@[simp]
theorem mem_projectiveJetDirectLowCurrentKernelField_iff
    {C : Type*} [Field C] (n : ℕ)
    (f : FreeCoordinateRationalField C ℕ) :
    f ∈ projectiveJetDirectLowCurrentKernelField C n ↔
      ∀ k < n, projectiveJetCurrentE C k f = 0 := by
  simp [projectiveJetDirectLowCurrentKernelField,
    projectiveJetCurrentE_eq_freeCoordinateDerivation]

/-- The inverse depth-`n` projective current field, killed by `F₀,...,F_(n-1)`. -/
def projectiveJetInverseLowCurrentKernelField
    (C : Type*) [Field C] (n : ℕ) :
    IntermediateField C (FreeCoordinateRationalField C ℕ) where
  carrier := {f | ∀ k < n, projectiveJetCurrentF C k f = 0}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy k hk
    simp [hx k hk, hy k hk]
  mul_mem' := by
    intro x y hx hy k hk
    simp [Derivation.leibniz, hx k hk, hy k hk]
  algebraMap_mem' := by
    intro a k hk
    exact (projectiveJetCurrentF C k).map_algebraMap a
  inv_mem' := by
    intro x hx k hk
    simp [(projectiveJetCurrentF C k).leibniz_inv, hx k hk]

@[simp]
theorem mem_projectiveJetInverseLowCurrentKernelField_iff
    {C : Type*} [Field C] (n : ℕ)
    (f : FreeCoordinateRationalField C ℕ) :
    f ∈ projectiveJetInverseLowCurrentKernelField C n ↔
      ∀ k < n, projectiveJetCurrentF C k f = 0 :=
  Iff.rfl

/-- The scalar low-translation fixed field is exactly the rational tail field. -/
theorem projectiveJetLowTranslationFixedField_eq_tail
    {C : Type*} [Field C] [CharZero C] (n : ℕ) :
    projectiveJetLowTranslationFixedField C n = projectiveJetTailField C n := by
  classical
  apply le_antisymm
  · intro f hf
    rw [projectiveJetTailField, mem_freeCoordinateField_iff]
    intro k hk
    have hkn : k < n := by simpa using hk
    let c : ℕ → C := freeCoordinateSingleTranslationCoefficient C ℕ k 1
    have hc : ProjectiveJetTranslationSupportedBelow n c := by
      intro q hq
      by_cases hqk : q = k
      · subst q
        exact (Nat.not_le_of_gt hkn hq).elim
      · simp [c, freeCoordinateSingleTranslationCoefficient, hqk]
    have hfixed : freeCoordinateTranslationAt C ℕ k 1 f = f := by
      simpa [freeCoordinateTranslationAt, c] using hf c hc
    have hmem :=
      mem_freeCoordinateField_complement_of_unitTranslation_fixed k hfixed
    exact ((mem_freeCoordinateField_iff ({k}ᶜ : Set ℕ) f).1 hmem) k (by simp)
  · intro f hf c hc
    exact freeCoordinateTranslationEquiv_fixed_of_mem c {k | n ≤ k}
      (fun k hk ↦ hc k hk) hf

/-- The direct low-current kernel is exactly the rational tail field. -/
theorem projectiveJetDirectLowCurrentKernelField_eq_tail
    {C : Type*} [Field C] [CharZero C] (n : ℕ) :
    projectiveJetDirectLowCurrentKernelField C n = projectiveJetTailField C n := by
  rw [projectiveJetDirectLowCurrentKernelField, projectiveJetTailField,
    freeCoordinateCommonKernelField_eq_freeCoordinateField]

/-- Finite direct translations and their infinitesimal `E` currents have the same exact field. -/
theorem projectiveJetLowTranslationFixedField_eq_directCurrentKernel
    {C : Type*} [Field C] [CharZero C] (n : ℕ) :
    projectiveJetLowTranslationFixedField C n =
      projectiveJetDirectLowCurrentKernelField C n := by
  rw [projectiveJetLowTranslationFixedField_eq_tail,
    projectiveJetDirectLowCurrentKernelField_eq_tail]

/-! ## The depth transition -/

/-- An observable killed by `E₀` and `H₁` is killed by every translation-current mode. -/
theorem projectiveJetCurrentE_annihilation_propagates_of_H_one
    {C : Type*} [Field C] [CharZero C]
    {f : FreeCoordinateRationalField C ℕ}
    (hE0 : projectiveJetCurrentE C 0 f = 0)
    (hH1 : projectiveJetCurrentH C 1 f = 0) :
    ∀ k, projectiveJetCurrentE C k f = 0 := by
  intro k
  induction k with
  | zero => exact hE0
  | succ k ih =>
      have hbracket :
          ⁅projectiveJetCurrentH C 1, projectiveJetCurrentE C k⁆ f = 0 := by
        rw [Derivation.commutator_apply, hH1, ih]
        simp
      rw [projectiveJetCurrentH_one_lie_E, Derivation.smul_apply] at hbracket
      have hscaled := congrArg
        (fun z : FreeCoordinateRationalField C ℕ ↦ (2 : C)⁻¹ • z) hbracket
      simpa [smul_smul] using hscaled

/-- If the inverse chart reaches depth two, its `F₁` mode and the direct `E₀` mode force the
intersection field to be scalar. -/
theorem projectiveJetLowCurrentKernel_inf_eq_bot_of_right_depth_two
    {C : Type*} [Field C] [CharZero C]
    {m n : ℕ} (hm : 1 ≤ m) (hn : 2 ≤ n) :
    projectiveJetDirectLowCurrentKernelField C m ⊓
        projectiveJetInverseLowCurrentKernelField C n = ⊥ := by
  apply le_antisymm
  · intro f hf
    rw [IntermediateField.mem_inf] at hf
    have hE0 :=
      (mem_projectiveJetDirectLowCurrentKernelField_iff m f).1 hf.1 0 (by omega)
    have hF1 :=
      (mem_projectiveJetInverseLowCurrentKernelField_iff n f).1 hf.2 1 (by omega)
    obtain ⟨a, rfl⟩ := (projectiveJetCurrent_fixed_iff_scalar f).1 ⟨hE0, hF1⟩
    exact (⊥ : IntermediateField C (FreeCoordinateRationalField C ℕ)).algebraMap_mem a
  · exact bot_le

/-- If the direct chart reaches depth two, `E₁,F₀` generate `H₁`; together with `E₀` this forces
the intersection field to be scalar. -/
theorem projectiveJetLowCurrentKernel_inf_eq_bot_of_left_depth_two
    {C : Type*} [Field C] [CharZero C]
    {m n : ℕ} (hm : 2 ≤ m) (hn : 1 ≤ n) :
    projectiveJetDirectLowCurrentKernelField C m ⊓
        projectiveJetInverseLowCurrentKernelField C n = ⊥ := by
  apply le_antisymm
  · intro f hf
    rw [IntermediateField.mem_inf] at hf
    have hE0 :=
      (mem_projectiveJetDirectLowCurrentKernelField_iff m f).1 hf.1 0 (by omega)
    have hE1 :=
      (mem_projectiveJetDirectLowCurrentKernelField_iff m f).1 hf.1 1 (by omega)
    have hF0 :=
      (mem_projectiveJetInverseLowCurrentKernelField_iff n f).1 hf.2 0 (by omega)
    have hH1 : projectiveJetCurrentH C 1 f = 0 := by
      rw [← projectiveJetCurrentE_lie_F 1 0,
        Derivation.commutator_apply, hF0, hE1]
      simp
    have hall := projectiveJetCurrentE_annihilation_propagates_of_H_one hE0 hH1
    obtain ⟨a, rfl⟩ := (all_freeCoordinateDerivations_eq_zero_iff f).1 (by
      intro k
      rw [← projectiveJetCurrentE_eq_freeCoordinateDerivation]
      exact hall k)
    exact (⊥ : IntermediateField C (FreeCoordinateRationalField C ℕ)).algebraMap_mem a
  · exact bot_le

/-- **Complete positive-depth projective current transition.**  The direct and inverse current
fields have scalar intersection as soon as either one reaches depth two. -/
theorem projectiveJetLowCurrentKernel_inf_eq_bot
    {C : Type*} [Field C] [CharZero C]
    {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) (hdeep : 2 ≤ m ∨ 2 ≤ n) :
    projectiveJetDirectLowCurrentKernelField C m ⊓
        projectiveJetInverseLowCurrentKernelField C n = ⊥ := by
  rcases hdeep with hm2 | hn2
  · exact projectiveJetLowCurrentKernel_inf_eq_bot_of_left_depth_two hm2 hn
  · exact projectiveJetLowCurrentKernel_inf_eq_bot_of_right_depth_two hm hn2

/-- Symmetric specialization: every common depth `n ≥ 2` has scalar current-field meet. -/
theorem projectiveJetEqualDepthCurrentKernel_inf_eq_bot
    {C : Type*} [Field C] [CharZero C]
    {n : ℕ} (hn : 2 ≤ n) :
    projectiveJetDirectLowCurrentKernelField C n ⊓
        projectiveJetInverseLowCurrentKernelField C n = ⊥ :=
  projectiveJetLowCurrentKernel_inf_eq_bot (by omega) (by omega) (Or.inl hn)

/-- The first minimal asymmetric trigger: direct depth one and inverse depth two. -/
theorem projectiveJetDepthOneTwoCurrentKernel_inf_eq_bot
    {C : Type*} [Field C] [CharZero C] :
    projectiveJetDirectLowCurrentKernelField C 1 ⊓
        projectiveJetInverseLowCurrentKernelField C 2 = ⊥ :=
  projectiveJetLowCurrentKernel_inf_eq_bot (by omega) (by omega) (Or.inr le_rfl)

/-- The opposite minimal asymmetric trigger: direct depth two and inverse depth one. -/
theorem projectiveJetDepthTwoOneCurrentKernel_inf_eq_bot
    {C : Type*} [Field C] [CharZero C] :
    projectiveJetDirectLowCurrentKernelField C 2 ⊓
        projectiveJetInverseLowCurrentKernelField C 1 = ⊥ :=
  projectiveJetLowCurrentKernel_inf_eq_bot (by omega) (by omega) (Or.inl le_rfl)

/-- At symmetric depth two, the direct translation chart and inverse current chart already have
scalar meet. -/
theorem projectiveJetDepthTwoTranslationInverseCurrent_inf_eq_bot
    {C : Type*} [Field C] [CharZero C] :
    projectiveJetLowTranslationFixedField C 2 ⊓
        projectiveJetInverseLowCurrentKernelField C 2 = ⊥ := by
  rw [projectiveJetLowTranslationFixedField_eq_directCurrentKernel]
  exact projectiveJetEqualDepthCurrentKernel_inf_eq_bot le_rfl

end

end GaloisForLFunctions.HTGeometry
