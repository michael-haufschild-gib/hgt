import GaloisForLFunctions.HTGeometry.GomesTruncatedJetJointSymbols
import GaloisForLFunctions.HTGeometry.GomesFiniteFockPowerCompression

/-!
# Every actual geometric phase selects one clock-power algebra

The full joint commutant is generated by the actual derivative clock raised
to the phase order. Order zero and the zero phase are retained: that power is
the identity and the selected algebra consists of scalars.
-/

noncomputable section
namespace GaloisForLFunctions.HTGeometry.GammaFactorialFock

/-- The full joint symmetry algebra is generated by the actual phase-order power of the clock. -/
theorem gomesTruncatedJetJointAlgebra_eq_adjoin_orderPower (n : ℕ) (z : ℂ) :
    gomesTruncatedJetJointAlgebra n z =
      Algebra.adjoin ℂ {fockShiftMatrix (n + 1) ^ orderOf z} := by
  apply le_antisymm
  · intro M hM
    obtain ⟨c, ⟨hc, hr⟩, _⟩ := (gomesTruncatedJetJointAlgebra_unique_symbol n z M).mp hM
    have hs : (fun k : Fin (n + 1) => if orderOf z ∣ k.val then c k else 0) = c := by
      funext k
      by_cases hk : orderOf z ∣ k.val
      · exact if_pos hk
      · rw [if_neg hk]
        exact ((hr k).resolve_right hk).symm
    have hm := gomesFiniteFock_sieved_symbol_mem_adjoin (n + 1) (orderOf z) c
    rwa [hs, hc] at hm
  · exact Algebra.adjoin_singleton_le (gomesTruncatedJetJointAlgebra_orderPower_mem n z)

/-- Every joint symmetry belongs to the original full derivative-clock symmetry algebra. -/
theorem gomesTruncatedJetJointAlgebra_le_clock (n : ℕ) (z : ℂ) :
    gomesTruncatedJetJointAlgebra n z ≤ gomesFiniteFockCommutant (n + 1) := by
  intro M hM
  exact (gomesFiniteFockCommutant_mem_iff (n + 1) M).mpr
    ((gomesTruncatedJetJointAlgebra_mem_iff n z M).mp hM).1

/-- All joint symmetries commute with each other, for every actual phase. -/
theorem gomesTruncatedJetJointAlgebra_commute (n : ℕ) (z : ℂ)
    (E F : gomesTruncatedJetJointAlgebra n z) : Commute E.val F.val :=
  gomesFiniteFockCommutant_commute (n + 1)
    ⟨E.val, gomesTruncatedJetJointAlgebra_le_clock n z E.property⟩
    ⟨F.val, gomesTruncatedJetJointAlgebra_le_clock n z F.property⟩

/-- Zero phase leaves exactly the scalar joint symmetries. -/
theorem gomesTruncatedJetJointAlgebra_zero (n : ℕ) :
    gomesTruncatedJetJointAlgebra n 0 = ⊥ := by
  rw [gomesTruncatedJetJointAlgebra_eq_adjoin_orderPower, orderOf_zero,
    pow_zero, Algebra.adjoin_singleton_one]

/-- Unit phase retains the entire actual derivative-clock symmetry algebra. -/
theorem gomesTruncatedJetJointAlgebra_one (n : ℕ) :
    gomesTruncatedJetJointAlgebra n 1 = gomesFiniteFockCommutant (n + 1) := by
  rw [gomesTruncatedJetJointAlgebra_eq_adjoin_orderPower, orderOf_one, pow_one,
    gomesFiniteFockCommutant_eq_adjoin]

end GaloisForLFunctions.HTGeometry.GammaFactorialFock
