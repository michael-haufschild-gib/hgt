import GaloisForLFunctions.HTGeometry.FiniteDifferentialCircuitBoundary

/-!
# Covariance of hypertranscendence under a change of differential generator

Two elements that generate the same differential field over a common base are differentially
algebraic together and hypertranscendental together.  The mechanism is the field structure of the
differentially algebraic elements: the differential field generated by one differentially
algebraic element consists of differentially algebraic elements, so any element of that field —
in particular any other generator of it — inherits the property.

* `differentialAlgebraicOver_of_differentialAdjoin_le` — differential algebraicity descends along
  an inclusion of generated differential fields;
* `hypertranscendentalOver_iff_of_differentialAdjoin_eq` — hypertranscendence is an invariant of
  the generated differential field, not of the chosen generator.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential F] [Differential E]
  [DifferentialAlgebra F E] [CharZero E]

/-- An element of the differential field generated by a differentially algebraic element is
differentially algebraic. -/
theorem differentialAlgebraicOver_of_differentialAdjoin_le {x y : E}
    (hx : DifferentialAlgebraicOver F x)
    (hle : differentialAdjoin F ({y} : Set E) ≤ differentialAdjoin F ({x} : Set E)) :
    DifferentialAlgebraicOver F y :=
  differentialAlgebraicOver_of_mem_differentialAdjoin_singleton hx
    (hle (subset_differentialAdjoin F ({y} : Set E) rfl))

/-- **Differential-birational generator covariance.**  Two generators of the same differential
field over `F` are differentially algebraic over `F` together. -/
theorem differentialAlgebraicOver_iff_of_differentialAdjoin_eq {x y : E}
    (h : differentialAdjoin F ({x} : Set E) = differentialAdjoin F ({y} : Set E)) :
    DifferentialAlgebraicOver F x ↔ DifferentialAlgebraicOver F y :=
  ⟨fun hx => differentialAlgebraicOver_of_differentialAdjoin_le hx h.ge,
   fun hy => differentialAlgebraicOver_of_differentialAdjoin_le hy h.le⟩

/-- **Hypertranscendence is a property of the generated differential field.**  A change of
generator inside a common differential extension is an admissible observer change. -/
theorem hypertranscendentalOver_iff_of_differentialAdjoin_eq {x y : E}
    (h : differentialAdjoin F ({x} : Set E) = differentialAdjoin F ({y} : Set E)) :
    HypertranscendentalOver F x ↔ HypertranscendentalOver F y :=
  not_congr (differentialAlgebraicOver_iff_of_differentialAdjoin_eq h)

end

end GaloisForLFunctions.HTGeometry
