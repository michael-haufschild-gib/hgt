import GaloisForLFunctions.HTGeometry.ShilovBoundaryMigrationDefect

/-!
# The algebraic deficit formula

For a surjective escape-free link the deficit `J_T / α(J_S)` is computed upstairs: it is the
preimage of the target boundary ideal, taken modulo the source boundary ideal together with the
kernel of the link,

```text
J_T / α(J_S)  ≅  α⁻¹(J_T) / (J_S + ker α).
```

The map is `α` itself.  It carries `α⁻¹(J_T)` onto `J_T` because `α` is onto, and an element lands
in `α(J_S)` exactly when it already lies in `J_S + ker α`, which is `α⁻¹(α(J_S))`.

This is the linear content of the card's deficit formula: the deficit is not measured by the
boundary ideals alone but by how far the link kernel falls short of the whole preimage, so the
envelope kernel can strictly exceed the ideal generated by the operator-system kernel.
-/

namespace GaloisForLFunctions.HTGeometry

namespace BoundaryMigration

universe u v

variable {𝕜 : Type u} [Field 𝕜]
variable {V W : Type v} [AddCommGroup V] [Module 𝕜 V] [AddCommGroup W] [Module 𝕜 W]

/-- A link restricted to the preimage of the target boundary ideal, landing in that ideal. -/
def preimageToTarget (f : V →ₗ[𝕜] W) (Jt : Submodule 𝕜 W) :
    ↥(Jt.comap f) →ₗ[𝕜] ↥Jt where
  toFun a := ⟨f (a : V), a.2⟩
  map_add' a b := by
    apply Subtype.ext
    simp
  map_smul' c a := by
    apply Subtype.ext
    simp

@[simp]
theorem preimageToTarget_coe (f : V →ₗ[𝕜] W) (Jt : Submodule 𝕜 W) (a : ↥(Jt.comap f)) :
    ((preimageToTarget f Jt a : ↥Jt) : W) = f (a : V) := rfl

theorem preimageToTarget_surjective (f : V →ₗ[𝕜] W) (hf : Function.Surjective f)
    (Jt : Submodule 𝕜 W) : Function.Surjective (preimageToTarget f Jt) := by
  intro t
  obtain ⟨a, ha⟩ := hf (t : W)
  have hmem : a ∈ Jt.comap f := by
    rw [Submodule.mem_comap, ha]
    exact t.2
  exact ⟨⟨a, hmem⟩, Subtype.ext (by simp [ha])⟩

/-- The deficit map upstairs: reduce the preimage of the target ideal into the deficit. -/
noncomputable def preimageToDeficit (f : V →ₗ[𝕜] W) (Js : Submodule 𝕜 V)
    (Jt : Submodule 𝕜 W) : ↥(Jt.comap f) →ₗ[𝕜] DeficitDefect f Js Jt :=
  (Submodule.mkQ _).comp (preimageToTarget f Jt)

theorem preimageToDeficit_surjective (f : V →ₗ[𝕜] W) (hf : Function.Surjective f)
    (Js : Submodule 𝕜 V) (Jt : Submodule 𝕜 W) :
    Function.Surjective (preimageToDeficit f Js Jt) :=
  (Submodule.mkQ_surjective _).comp (preimageToTarget_surjective f hf Jt)

/-- The kernel of the deficit map upstairs is the source boundary ideal joined with the link
kernel. -/
theorem ker_preimageToDeficit (f : V →ₗ[𝕜] W) (Js : Submodule 𝕜 V) (Jt : Submodule 𝕜 W) :
    LinearMap.ker (preimageToDeficit f Js Jt)
      = (Js ⊔ LinearMap.ker f).comap (Jt.comap f).subtype := by
  ext a
  simp only [LinearMap.mem_ker, preimageToDeficit, LinearMap.comp_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]
  constructor
  · intro h
    have hc : (a : V) ∈ Submodule.comap f (Js.map f) := h
    rwa [Submodule.comap_map_eq] at hc
  · intro h
    have hc : (a : V) ∈ Submodule.comap f (Js.map f) := by
      rwa [Submodule.comap_map_eq]
    exact hc

/-- **The algebraic deficit formula.**  For a surjective link the deficit is the preimage of the
target boundary ideal modulo the source boundary ideal joined with the link kernel.  Under zero
escape the left side is literally `J_T / α(J_S)`. -/
noncomputable def deficitPreimageEquiv (f : V →ₗ[𝕜] W) (hf : Function.Surjective f)
    (Js : Submodule 𝕜 V) (Jt : Submodule 𝕜 W) :
    RelativeQuotient (Js ⊔ LinearMap.ker f) (Jt.comap f) ≃ₗ[𝕜] DeficitDefect f Js Jt :=
  (Submodule.quotEquivOfEq _ _ (ker_preimageToDeficit f Js Jt).symm).trans
    (LinearMap.quotKerEquivOfSurjective _ (preimageToDeficit_surjective f hf Js Jt))

/-- Deficit freedom is exactly the statement that the preimage of the target boundary ideal adds
nothing to the source boundary ideal and the link kernel. -/
theorem deficitFree_iff_comap_le (f : V →ₗ[𝕜] W) (hf : Function.Surjective f)
    (Js : Submodule 𝕜 V) (Jt : Submodule 𝕜 W) :
    DeficitFree f Js Jt ↔ Jt.comap f ≤ Js ⊔ LinearMap.ker f := by
  constructor
  · intro h a ha
    have hmem : f a ∈ Js.map f := h ha
    have hc : a ∈ Submodule.comap f (Js.map f) := hmem
    rwa [Submodule.comap_map_eq] at hc
  · intro h t ht
    obtain ⟨a, ha⟩ := hf t
    have hmem : a ∈ Jt.comap f := by
      rw [Submodule.mem_comap, ha]
      exact ht
    have hc := h hmem
    rw [← Submodule.comap_map_eq] at hc
    rwa [Submodule.mem_comap, ha] at hc

end BoundaryMigration

end GaloisForLFunctions.HTGeometry
