import GaloisForLFunctions.HTGeometry.SteinbergColumnCentrality

/-!
# Every element of the Steinberg group uses only finitely many indices

Milnor's centrality argument needs one count: an element of the Steinberg group is a word in
finitely many generators, so as soon as the index type has one index to spare, some index is unused
by that word, and the element lies in the subgroup generated by the generators avoiding it.

The count is proved here without any list manipulation.  The elements admitting a finite index set
form a subgroup — the union of two finite sets is finite, and the generating sets are monotone in
the index set — and that subgroup contains every generator, hence is everything.

Combined with the centrality step, this gives: **an element of `K₂` centralizes the column subgroup
at any index its own word avoids.**
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

variable {R : Type*} [CommRing R] {n : Type*} [DecidableEq n]

/-- The generators whose two indices both lie in a given finite set. -/
def indexGens (T : Finset n) : Set (SteinbergGroup R n) :=
  {z : SteinbergGroup R n | ∃ (p q : n) (hpq : p ≠ q) (_ : p ∈ T) (_ : q ∈ T) (b : R),
    z = steinbergX hpq b}

/-- The generators whose first index avoids a given index. -/
def avoidGens (j : n) : Set (SteinbergGroup R n) :=
  {z : SteinbergGroup R n | ∃ (p q : n) (hpq : p ≠ q) (_ : p ≠ j) (b : R), z = steinbergX hpq b}

omit [DecidableEq n] in
theorem indexGens_mono {T T' : Finset n} (h : T ⊆ T') :
    indexGens (R := R) (n := n) T ⊆ indexGens (R := R) (n := n) T' := by
  rintro z ⟨p, q, hpq, hpT, hqT, b, rfl⟩
  exact ⟨p, q, hpq, h hpT, h hqT, b, rfl⟩

omit [DecidableEq n] in
/-- If an index is outside the finite set, the index generators avoid it. -/
theorem indexGens_subset_avoidGens {T : Finset n} {j : n} (hj : j ∉ T) :
    indexGens (R := R) (n := n) T ⊆ avoidGens (R := R) (n := n) j := by
  rintro z ⟨p, q, hpq, hpT, _, b, rfl⟩
  refine ⟨p, q, hpq, ?_, b, rfl⟩
  intro hcon
  exact hj (hcon ▸ hpT)

/-- The elements that are words in finitely many indices. -/
def finiteIndexSubgroup : Subgroup (SteinbergGroup R n) where
  carrier := {y | ∃ T : Finset n, y ∈ Subgroup.closure (indexGens (R := R) (n := n) T)}
  mul_mem' := by
    rintro a b ⟨T₁, hT₁⟩ ⟨T₂, hT₂⟩
    refine ⟨T₁ ∪ T₂, Subgroup.mul_mem _ ?_ ?_⟩
    · exact Subgroup.closure_mono (indexGens_mono Finset.subset_union_left) hT₁
    · exact Subgroup.closure_mono (indexGens_mono Finset.subset_union_right) hT₂
  one_mem' := ⟨∅, Subgroup.one_mem _⟩
  inv_mem' := by
    rintro a ⟨T, hT⟩
    exact ⟨T, Subgroup.inv_mem _ hT⟩

/-- **Every element of the Steinberg group uses only finitely many indices.** -/
theorem exists_finset_indices (y : SteinbergGroup R n) :
    ∃ T : Finset n, y ∈ Subgroup.closure (indexGens (R := R) (n := n) T) := by
  have htop : (⊤ : Subgroup (SteinbergGroup R n)) ≤ finiteIndexSubgroup (R := R) (n := n) := by
    have hgen : (⊤ : Subgroup (SteinbergGroup R n))
        = Subgroup.closure (Set.range (PresentedGroup.of : SteinbergGen R n → SteinbergGroup R n)) :=
      (PresentedGroup.closure_range_of (steinbergRels R n)).symm
    rw [hgen]
    refine (Subgroup.closure_le _).2 ?_
    rintro z ⟨g, rfl⟩
    refine ⟨{g.i, g.j}, ?_⟩
    refine Subgroup.subset_closure ?_
    refine ⟨g.i, g.j, g.hij, Finset.mem_insert_self _ _,
      Finset.mem_insert_of_mem (Finset.mem_singleton_self _), g.a, rfl⟩
  exact htop (Subgroup.mem_top y)

variable [Fintype n]

/-- **An element of `K₂` centralizes the column at any index its word avoids.** -/
theorem KTwo_commute_columnSubgroup_of_not_mem {y : SteinbergGroup R n} {T : Finset n} {j : n}
    (hy : y ∈ KTwo R n) (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hj : j ∉ T) :
    ∀ x ∈ columnSubgroup (R := R) (n := n) j, y * x = x * y := by
  refine KTwo_commute_columnSubgroup_of_avoid hy ?_
  exact Subgroup.closure_mono (indexGens_subset_avoidGens hj) hyT

/-- **Centrality on a spare column.**  As soon as the word of `y` does not exhaust the index type,
`y` centralizes the column at an index it misses. -/
theorem exists_column_centralized_of_card {y : SteinbergGroup R n} (hy : y ∈ KTwo R n)
    {T : Finset n} (hyT : y ∈ Subgroup.closure (indexGens (R := R) (n := n) T))
    (hcard : T.card < Fintype.card n) :
    ∃ j : n, ∀ x ∈ columnSubgroup (R := R) (n := n) j, y * x = x * y := by
  have hne : T ≠ Finset.univ := by
    intro h
    rw [h, Finset.card_univ] at hcard
    exact lt_irrefl _ hcard
  obtain ⟨j, hj⟩ : ∃ j : n, j ∉ T := by
    by_contra hcon
    push Not at hcon
    exact hne (Finset.eq_univ_iff_forall.2 hcon)
  exact ⟨j, KTwo_commute_columnSubgroup_of_not_mem hy hyT hj⟩

end GaloisForLFunctions.HTGeometry

end
