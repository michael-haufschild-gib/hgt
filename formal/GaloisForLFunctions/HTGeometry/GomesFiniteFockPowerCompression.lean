import GaloisForLFunctions.HTGeometry.GomesFiniteFockTaylorArc

/-!
# Exact finite clock-symbol compression at every natural period

Selecting coefficient positions divisible by a period gives a polynomial in
the corresponding clock power. Period zero is included: only the constant
coefficient survives, and the target clock power is the identity.
-/

noncomputable section
open Polynomial
namespace GaloisForLFunctions.HTGeometry.GammaFactorialFock

/-- Compress the coefficients at multiples of the period into a polynomial in that clock power. -/
def gomesFiniteFockCompressedPolynomial (N d : ℕ) (c : Fin N → ℂ) : Polynomial ℂ :=
  ∑ k : Fin N, Polynomial.monomial (k.val / d) (if d ∣ k.val then c k else 0)

/-- Compressed evaluation is exactly the finite divisor sieve, including period zero and dimension zero. -/
theorem gomesFiniteFockCompressedPolynomial_eval (N d : ℕ) (c : Fin N → ℂ) :
    Polynomial.aeval (fockShiftMatrix N ^ d) (gomesFiniteFockCompressedPolynomial N d c) =
      gomesFiniteFockPolynomialHom N
        (gomesFiniteFockCoefficientPolynomial N (fun k => if d ∣ k.val then c k else 0)) := by
  rw [gomesFiniteFockCompressedPolynomial, map_sum, gomesFiniteFockPolynomialHom_coefficients]
  apply Finset.sum_congr rfl
  intro k _
  rw [Polynomial.aeval_monomial, ← Algebra.smul_def]
  by_cases hk : d ∣ k.val
  · rw [if_pos hk, ← pow_mul, Nat.mul_div_cancel' hk]
  · rw [if_neg hk, zero_smul, zero_smul]

/-- Every divisor-sieved finite clock symbol lies in the algebra generated by the corresponding clock power. -/
theorem gomesFiniteFock_sieved_symbol_mem_adjoin (N d : ℕ) (c : Fin N → ℂ) :
    gomesFiniteFockPolynomialHom N
      (gomesFiniteFockCoefficientPolynomial N (fun k => if d ∣ k.val then c k else 0)) ∈
        Algebra.adjoin ℂ {fockShiftMatrix N ^ d} := by
  rw [← gomesFiniteFockCompressedPolynomial_eval]
  exact Polynomial.aeval_mem_adjoin_singleton ℂ _

end GaloisForLFunctions.HTGeometry.GammaFactorialFock
