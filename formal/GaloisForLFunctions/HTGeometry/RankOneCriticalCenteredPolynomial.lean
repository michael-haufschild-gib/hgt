import GaloisForLFunctions.HTGeometry.RankOneCenteredObservationCoordinates
import GaloisForLFunctions.HTGeometry.GenericJetReciprocalPowerSeries
import GaloisForLFunctions.HTGeometry.Critical.Geometric.DegreeExact

/-!
# The actual rank-one critical extension as a centered generic polynomial

For `n > 0`, this module identifies the actual critical source extension of
`criticalObservationField K 1 n` with the simple extension generated by the
root `-x₀` of an explicit centered monic polynomial of degree `n + 1`.  Under
the rank-one observation-coordinate equivalence, that polynomial is exactly
the centered generic polynomial.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

variable {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] {n : ℕ}

theorem rankOneCriticalSourceRecip_mul_raw_pow_eq_tailCoeff_sum
    (hn : 0 < n) :
    criticalSourceRecip K 1 n (⟨n, by omega⟩ : Fin (1 + n)) *
        criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n)) ^ (n + 1) =
      ∑ j : Fin n,
        (-1 : criticalSourceField K 1 n) ^ (n - (j : ℕ)) *
          algebraMap (criticalObservationField K 1 n) (criticalSourceField K 1 n)
            (MvPolynomial.aeval (criticalObservationRaw K 1 n) (tailCoeff K n j)) *
          criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n)) ^ (j : ℕ) := by
  let Z := criticalSourceRawPolynomial K 1 n
  let W := criticalSourceReciprocalPolynomial K 1 n
  have hZW : (X : (criticalSourceField K 1 n)[X]) ^ (n + 1) ∣ Z * W - 1 := by
    simpa [Z, W, Nat.add_comm] using
      X_pow_dvd_criticalSourceRaw_mul_reciprocal_sub_one K 1 n
  have hunit : IsUnit (Z.coeff 0) := by
    dsimp only [Z]
    rw [criticalSourceRawPolynomial_coeff K 1 n 0 (by omega)]
    apply isUnit_iff_ne_zero.2
    intro hzero
    have hambient : criticalAmbientRaw K 1 n 0 = 0 := congrArg Subtype.val hzero
    have hinj : Function.Injective
        (MvPolynomial.aeval
          (fun j : Fin (1 + n) => criticalAmbientRaw K 1 n (j : ℕ))) :=
      (algebraicIndependent_iff_injective_aeval.mp
        (algebraicIndependent_criticalAmbientRaw K 1 n))
    apply MvPolynomial.X_ne_zero (R := K) (0 : Fin (1 + n))
    apply hinj
    simpa using hambient
  have h := coeff_mul_pow_eq_aeval_tailCoeff_of_dvd
    (K := K) (M := criticalSourceField K 1 n) n hn hZW hunit
  have hZ0 : Z.coeff 0 = criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n)) := by
    dsimp only [Z]
    rw [criticalSourceRawPolynomial_coeff K 1 n 0 (by omega)]
  have hWn : W.coeff n = criticalSourceRecip K 1 n (⟨n, by omega⟩ : Fin (1 + n)) := by
    dsimp only [W]
    rw [criticalSourceReciprocalPolynomial_coeff K 1 n n (by omega)]
  have hZi (i : Fin n) :
      Z.coeff ((i : ℕ) + 1) =
        algebraMap (criticalObservationField K 1 n) (criticalSourceField K 1 n)
          (criticalObservationRaw K 1 n i) := by
    dsimp only [Z]
    rw [criticalSourceRawPolynomial_coeff K 1 n ((i : ℕ) + 1) (by omega)]
    apply Subtype.ext
    change criticalAmbientRaw K 1 n ((i : ℕ) + 1) =
      criticalAmbientRaw K 1 n (1 + (i : ℕ))
    congr 1
    omega
  have hhom :
      MvPolynomial.aeval (fun i : Fin n => Z.coeff ((i : ℕ) + 1)) =
        (IsScalarTower.toAlgHom K (criticalObservationField K 1 n)
          (criticalSourceField K 1 n)).comp
          (MvPolynomial.aeval (criticalObservationRaw K 1 n)) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, MvPolynomial.aeval_X, hZi]
    rfl
  have hscalar (x : criticalObservationField K 1 n) :
      IsScalarTower.toAlgHom K (criticalObservationField K 1 n)
          (criticalSourceField K 1 n) x =
        algebraMap (criticalObservationField K 1 n) (criticalSourceField K 1 n) x := rfl
  rw [hWn, hZ0] at h
  simpa only [DFunLike.congr_fun hhom, AlgHom.comp_apply, hscalar] using h

theorem neg_one_pow_succ_mul_neg_one_pow_sub
    {A : Type*} [CommRing A] {n j : ℕ} (hj : j ≤ n) :
    (-1 : A) ^ (n + 1) * (-1 : A) ^ (n - j) = -((-1 : A) ^ j) := by
  have hexp : (n + 1) + (n - j) = (j + 1) + 2 * (n - j) := by omega
  rw [← pow_add, hexp, pow_add]
  have heven : (-1 : A) ^ (2 * (n - j)) = 1 := by
    rw [pow_mul]
    simp
  rw [heven, mul_one, pow_succ]
  ring

/-- Monic centered polynomial cut out by the actual rank-one observation coordinates. -/
noncomputable def rankOneCriticalCenteredPolynomial (hn : 0 < n) :
    (criticalObservationField K 1 n)[X] :=
  X ^ (n + 1) +
    ∑ j : Fin n,
      C (rankOneCriticalCenteredCoeff (K := K) hn j) * X ^ (j : ℕ)

set_option maxHeartbeats 800000 in
theorem eval₂_rankOneCriticalCenteredPolynomial_neg_raw_zero
    (hn : 0 < n) :
    Polynomial.eval₂
        (algebraMap (criticalObservationField K 1 n) (criticalSourceField K 1 n))
        (-criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n)))
        (rankOneCriticalCenteredPolynomial (K := K) hn) = 0 := by
  let O := criticalObservationField K 1 n
  let S := criticalSourceField K 1 n
  let a : S := criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n))
  let qO : O := criticalObservationRecip K 1 n (0 : Fin 1)
  let q : S := algebraMap O S qO
  let t : Fin n → S := fun j =>
    algebraMap O S
      (MvPolynomial.aeval (criticalObservationRaw K 1 n) (tailCoeff K n j))
  have hq_eq :
      q = criticalSourceRecip K 1 n (⟨n, by omega⟩ : Fin (1 + n)) := by
    apply Subtype.ext
    change criticalAmbientRecip K 1 n (n + (0 : Fin 1)) =
      criticalAmbientRecip K 1 n n
    simp
  have hqO_ne : qO ≠ 0 := by
    intro hzero
    have hmap := congrArg (rankOneCriticalObservationFieldEquiv (K := K) hn) hzero
    rw [map_zero, rankOneCriticalObservationFieldEquiv_recip,
      iteratedRationalFamily_inr] at hmap
    exact fracX_tailRat_ne_zero hmap
  have hq_ne : q ≠ 0 := by
    exact (algebraMap O S).injective.ne hqO_ne
  have heq :
      q * a ^ (n + 1) =
        ∑ j : Fin n, (-1 : S) ^ (n - (j : ℕ)) * t j * a ^ (j : ℕ) := by
    rw [hq_eq]
    exact rankOneCriticalSourceRecip_mul_raw_pow_eq_tailCoeff_sum (K := K) hn
  have hcenter (j : Fin n) :
      algebraMap O S (rankOneCriticalCenteredCoeff (K := K) hn j) = t j / q := by
    rw [rankOneCriticalCenteredCoeff, map_div₀]
  rw [← mul_eq_zero_iff_left hq_ne]
  rw [rankOneCriticalCenteredPolynomial, Polynomial.eval₂_add,
    Polynomial.eval₂_pow, Polynomial.eval₂_X]
  have hevalsum :
      Polynomial.eval₂ (algebraMap O S) (-a)
          (∑ j : Fin n,
            Polynomial.C (rankOneCriticalCenteredCoeff (K := K) hn j) *
              Polynomial.X ^ (j : ℕ)) =
        ∑ j : Fin n,
          Polynomial.eval₂ (algebraMap O S) (-a)
            (Polynomial.C (rankOneCriticalCenteredCoeff (K := K) hn j) *
              Polynomial.X ^ (j : ℕ)) := by
    change (Polynomial.eval₂RingHom (algebraMap O S) (-a)) (∑ j : Fin n,
        Polynomial.C (rankOneCriticalCenteredCoeff (K := K) hn j) *
          Polynomial.X ^ (j : ℕ)) =
      ∑ j : Fin n,
        (Polynomial.eval₂RingHom (algebraMap O S) (-a))
          (Polynomial.C (rankOneCriticalCenteredCoeff (K := K) hn j) *
            Polynomial.X ^ (j : ℕ))
    rw [map_sum]
  rw [hevalsum]
  simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, hcenter,
    Polynomial.eval₂_pow, Polynomial.eval₂_X]
  rw [mul_add, Finset.mul_sum]
  have hterm (j : Fin n) :
      q * (t j / q * (-a) ^ (j : ℕ)) = t j * (-a) ^ (j : ℕ) := by
    have hcancel : q * (t j / q) = t j := by
      calc
        q * (t j / q) = (t j / q) * q := mul_comm _ _
        _ = t j := div_mul_cancel₀ _ hq_ne
    rw [← mul_assoc, hcancel]
  rw [Finset.sum_congr rfl (fun j _ => hterm j)]
  rw [neg_pow a (n + 1)]
  have hneg (j : Fin n) :
      (-a) ^ (j : ℕ) = (-1 : S) ^ (j : ℕ) * a ^ (j : ℕ) :=
    neg_pow a (j : ℕ)
  rw [Finset.sum_congr rfl (fun j _ => by rw [hneg j])]
  calc
    q * ((-1 : S) ^ (n + 1) * a ^ (n + 1)) +
        ∑ j : Fin n, t j * ((-1 : S) ^ (j : ℕ) * a ^ (j : ℕ))
        = (-1 : S) ^ (n + 1) * (q * a ^ (n + 1)) +
            ∑ j : Fin n, t j * ((-1 : S) ^ (j : ℕ) * a ^ (j : ℕ)) := by ac_rfl
    _ = (-1 : S) ^ (n + 1) *
          (∑ j : Fin n, (-1 : S) ^ (n - (j : ℕ)) * t j * a ^ (j : ℕ)) +
            ∑ j : Fin n, t j * ((-1 : S) ^ (j : ℕ) * a ^ (j : ℕ)) := by rw [heq]
    _ = ∑ j : Fin n,
          (((-1 : S) ^ (n + 1) * (-1 : S) ^ (n - (j : ℕ))) +
            (-1 : S) ^ (j : ℕ)) * t j * a ^ (j : ℕ) := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro j _
          ring
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro j _
      rw [neg_one_pow_succ_mul_neg_one_pow_sub (Nat.le_of_lt j.isLt)]
      ring

theorem coeff_fin_sum_C_mul_X_pow
    {R : Type*} [CommRing R] {N : ℕ} (c : Fin N → R) (k : ℕ) :
    (∑ j : Fin N, Polynomial.C (c j) * Polynomial.X ^ (j : ℕ)).coeff k =
      if h : k < N then c ⟨k, h⟩ else 0 := by
  classical
  rw [Polynomial.finsetSum_coeff]
  by_cases hk : k < N
  · rw [dif_pos hk, Finset.sum_eq_single (⟨k, hk⟩ : Fin N)]
    · simp
    · intro j _ hj
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg, mul_zero]
      exact fun h => hj (Fin.ext h.symm)
    · exact fun h => absurd (Finset.mem_univ _) h
  · rw [dif_neg hk]
    apply Finset.sum_eq_zero
    intro j _
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg, mul_zero]
    intro h
    exact hk (h ▸ j.isLt)

theorem coeff_rankOneCriticalCenteredPolynomial
    (hn : 0 < n) (k : ℕ) :
    (rankOneCriticalCenteredPolynomial (K := K) hn).coeff k =
      (if k = n + 1 then 1 else 0) +
        if h : k < n then rankOneCriticalCenteredCoeff (K := K) hn ⟨k, h⟩ else 0 := by
  rw [rankOneCriticalCenteredPolynomial, Polynomial.coeff_add,
    Polynomial.coeff_X_pow, coeff_fin_sum_C_mul_X_pow]

theorem coeff_centeredMonicE
    (k : ℕ) :
    (centeredMonicE K n.succ).coeff k =
      (if k = n.succ then 1 else 0) +
        if h : k < n.succ then centeredCoeffIn K n.succ ⟨k, h⟩ else 0 := by
  rw [centeredMonicE, Polynomial.coeff_add, Polynomial.coeff_X_pow,
    coeff_fin_sum_C_mul_X_pow]

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 800000 in
theorem map_rankOneCriticalCenteredPolynomial_eq_centeredMonicE
    (hn : 0 < n) :
    Polynomial.map
        (rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn).toRingHom
        (rankOneCriticalCenteredPolynomial (K := K) hn) =
      Polynomial.map
        (algebraMap (centeredCoeffField K n.succ)
          (FractionRing (Polynomial (centeredCoeffField K n.succ))))
        (centeredMonicE K n.succ) := by
  let e := rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn
  let F := centeredCoeffField K n.succ
  let B := FractionRing (Polynomial F)
  let ι : F →+* B := algebraMap F B
  have hcenter (j : Fin n) :
      e (rankOneCriticalCenteredCoeff (K := K) hn j) =
        ι (centeredCoeffIn K n.succ (rankOneCenteredIndex j)) := by
    rw [rankOneCriticalObservationToCenteredCoeffFreeEquiv_centered]
    change algebraMap (Polynomial F) B
        (Polynomial.C (centeredCoeffIn K n.succ (rankOneCenteredIndex j))) = _
    change algebraMap (Polynomial F) B
        (algebraMap F (Polynomial F)
          (centeredCoeffIn K n.succ (rankOneCenteredIndex j))) = _
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) B]
  have htop :
      centeredCoeffIn K n.succ (⟨n, by omega⟩ : Fin n.succ) = 0 :=
    Subtype.ext (centeredCoeff_top_eq_zero (K := K) (d := n.succ) (by omega))
  apply Polynomial.ext
  intro k
  rw [Polynomial.coeff_map, Polynomial.coeff_map,
    coeff_rankOneCriticalCenteredPolynomial (K := K) hn,
    coeff_centeredMonicE (K := K) (n := n)]
  by_cases hlead : k = n + 1
  · subst k
    simp
  by_cases hlow : k < n
  · have hsucc : k < n.succ := by omega
    simp only [if_neg hlead, dif_pos hlow, if_neg (by omega), dif_pos hsucc,
      zero_add]
    have hidx :
        rankOneCenteredIndex (⟨k, hlow⟩ : Fin n) =
          (⟨k, hsucc⟩ : Fin n.succ) := Fin.ext rfl
    change e (rankOneCriticalCenteredCoeff (K := K) hn ⟨k, hlow⟩) =
      ι (centeredCoeffIn K n.succ ⟨k, hsucc⟩)
    rw [hcenter, hidx]
  · have hnle : n ≤ k := Nat.le_of_not_gt hlow
    by_cases heq : k = n
    · subst k
      simp [htop]
    · have hsucc : ¬ k < n.succ := by omega
      simp only [if_neg hlead, dif_neg hlow, dif_neg hsucc,
        map_zero, add_zero]

theorem rankOneCriticalSourceField_adjoin_neg_raw_zero_eq_top
    (hn : 0 < n) :
    IntermediateField.adjoin (criticalObservationField K 1 n)
      { -criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n)) } = ⊤ := by
  let O := criticalObservationField K 1 n
  let S := criticalSourceField K 1 n
  let a : S := criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n))
  let C : IntermediateField O S := IntermediateField.adjoin O { -a }
  have hneg : -a ∈ C :=
    IntermediateField.subset_adjoin O { -a } (Set.mem_singleton (-a))
  have ha : a ∈ C := by
    have := C.neg_mem hneg
    simpa using this
  have hraw (j : Fin (1 + n)) : criticalSourceRaw K 1 n j ∈ C := by
    by_cases hj : (j : ℕ) = 0
    · have hj0 : j = (0 : Fin (1 + n)) := Fin.ext hj
      subst j
      exact ha
    · have hj1 : 1 ≤ (j : ℕ) := Nat.one_le_iff_ne_zero.mpr hj
      let i : Fin n := ⟨(j : ℕ) - 1, by omega⟩
      have hcoord :
          criticalSourceRaw K 1 n j =
            algebraMap O S (criticalObservationRaw K 1 n i) := by
        apply Subtype.ext
        change criticalAmbientRaw K 1 n (j : ℕ) =
          criticalAmbientRaw K 1 n (1 + (i : ℕ))
        congr 1
        dsimp only [i]
        omega
      rw [hcoord]
      exact C.algebraMap_mem _
  have hle :
      IntermediateField.adjoin O (Set.range (criticalSourceRaw K 1 n)) ≤ C := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    exact hraw j
  rw [criticalSourceRaw_adjoin_eq_top K 1 n] at hle
  exact top_unique hle

set_option synthInstance.maxHeartbeats 100000 in
theorem natDegree_rankOneCriticalCenteredPolynomial
    (hn : 0 < n) :
    (rankOneCriticalCenteredPolynomial (K := K) hn).natDegree = n + 1 := by
  have hmap := congrArg Polynomial.natDegree
    (map_rankOneCriticalCenteredPolynomial_eq_centeredMonicE (K := K) hn)
  rw [Polynomial.natDegree_map_eq_of_injective
      (rankOneCriticalObservationToCenteredCoeffFreeEquiv (K := K) hn).injective,
    Polynomial.natDegree_map_eq_of_injective
      (algebraMap (centeredCoeffField K n.succ)
        (FractionRing (Polynomial (centeredCoeffField K n.succ)))).injective,
    natDegree_centeredMonicE] at hmap
  exact hmap

theorem monic_rankOneCriticalCenteredPolynomial
    (hn : 0 < n) :
    (rankOneCriticalCenteredPolynomial (K := K) hn).Monic := by
  show (rankOneCriticalCenteredPolynomial (K := K) hn).leadingCoeff = 1
  rw [Polynomial.leadingCoeff, natDegree_rankOneCriticalCenteredPolynomial (K := K) hn,
    coeff_rankOneCriticalCenteredPolynomial (K := K) hn]
  simp

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 800000 in
theorem minpoly_neg_criticalSourceRaw_zero_eq_rankOneCriticalCenteredPolynomial
    (hn : 0 < n) :
    minpoly (criticalObservationField K 1 n)
        (-criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n))) =
      rankOneCriticalCenteredPolynomial (K := K) hn := by
  let O := criticalObservationField K 1 n
  let S := criticalSourceField K 1 n
  let a : S := -criticalSourceRaw K 1 n (⟨0, by omega⟩ : Fin (1 + n))
  letI : FiniteDimensional O S :=
    criticalSourceField_finiteDimensional_criticalObservationField K (by omega) hn
  have ha : IsIntegral O a := IsIntegral.of_finite O a
  have hroot : Polynomial.aeval a (rankOneCriticalCenteredPolynomial (K := K) hn) = 0 := by
    simpa [Polynomial.aeval_def, a] using
      eval₂_rankOneCriticalCenteredPolynomial_neg_raw_zero (K := K) hn
  have hdvd : minpoly O a ∣ rankOneCriticalCenteredPolynomial (K := K) hn :=
    minpoly.dvd O a hroot
  have hadjoin : IntermediateField.adjoin O {a} = ⊤ := by
    exact rankOneCriticalSourceField_adjoin_neg_raw_zero_eq_top (K := K) hn
  have hminDegree : (minpoly O a).natDegree = n + 1 := by
    calc
      (minpoly O a).natDegree = Module.finrank O ↥(IntermediateField.adjoin O {a}) :=
        (IntermediateField.adjoin.finrank ha).symm
      _ = Module.finrank O ↥(⊤ : IntermediateField O S) := by rw [hadjoin]
      _ = Module.finrank O S :=
        (IntermediateField.topEquiv (F := O) (E := S)).toLinearEquiv.finrank_eq
      _ = criticalHorizonMultiplicity 1 n :=
        finrank_criticalSourceField_eq_criticalHorizonMultiplicity K (by omega) hn
      _ = n + 1 := by simp [criticalHorizonMultiplicity, Nat.add_comm]
  apply Eq.symm
  apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le
    (minpoly.monic ha)
    (monic_rankOneCriticalCenteredPolynomial (K := K) hn)
    hdvd
  rw [natDegree_rankOneCriticalCenteredPolynomial (K := K) hn, hminDegree]

end

