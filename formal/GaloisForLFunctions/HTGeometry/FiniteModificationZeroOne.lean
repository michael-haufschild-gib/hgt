import Mathlib.Probability.Independence.ZeroOne
import Mathlib.Probability.Independence.InfinitePi

/-!
# The finite-modification zero–one law

This is the general-fibre companion of `ProductTailZeroOne`, which does the same for products of
`ℕ`-valued coordinates and hitting events; here the fibres are arbitrary measurable spaces and the
tail criterion is invariance under finite modification.

A subset of a countable product that is unchanged by modifying finitely many coordinates is a tail
event.  The proof is one line of measure theory once it is written correctly: replacing the first
`n` coordinates by those of a fixed reference point is a map measurable for the σ-algebra of the
coordinates beyond `n`, and invariance says the set is its own preimage under that map.  So the set
lies in every `σ(coordinates ≥ n)`, hence in the tail σ-algebra, and Kolmogorov's zero–one law
applies.

For a stratum of a compact product of phase circles this says: *if membership does not depend on any
finite set of coordinates, the stratum has probability zero or one.*  It reduces the measure-theoretic
half of a dense-null seam to a single strict inequality — the stratum is not almost everything —
instead of an asymptotic computation.
-/

open MeasureTheory ProbabilityTheory Filter Set MeasurableSpace

namespace GaloisForLFunctions.HTGeometry

variable {X : ℕ → Type*} [∀ n, MeasurableSpace (X n)]

/-- The σ-algebra generated by the `n`-th coordinate of a countable product. -/
@[reducible] def prodCoordSigma (n : ℕ) : MeasurableSpace (∀ m, X m) :=
  MeasurableSpace.comap (fun x : ∀ m, X m => x n) inferInstance

theorem prodCoordSigma_le (n : ℕ) :
    (prodCoordSigma (X := X) n) ≤ (inferInstance : MeasurableSpace (∀ m, X m)) := by
  rintro s ⟨t, ht, rfl⟩
  exact measurable_pi_apply n ht

/-- Replacing every coordinate below `n` by that of a fixed reference point. -/
def truncateBelow (a : ∀ m, X m) (n : ℕ) (x : ∀ m, X m) : ∀ m, X m :=
  fun m => if m < n then a m else x m

omit [∀ n, MeasurableSpace (X n)] in
theorem truncateBelow_agree (a : ∀ m, X m) (n : ℕ) (x : ∀ m, X m) :
    {m | truncateBelow a n x m ≠ x m}.Finite := by
  refine Set.Finite.subset (Set.finite_Iio n) ?_
  intro m hm
  by_contra hlt
  have hnlt : ¬ m < n := by simpa using hlt
  exact hm (by simp [truncateBelow, hnlt])

/-- The truncation is measurable for the σ-algebra of the coordinates beyond `n`. -/
theorem measurable_truncateBelow (a : ∀ m, X m) (n : ℕ) :
    Measurable[⨆ i, ⨆ (_ : i ≥ n), prodCoordSigma (X := X) i] (truncateBelow a n) := by
  refine @measurable_pi_lambda _ _ _ (⨆ i, ⨆ (_ : i ≥ n), prodCoordSigma (X := X) i) _
    (truncateBelow a n) (fun m => ?_)
  by_cases hm : m < n
  · have : (fun x : ∀ k, X k => truncateBelow a n x m) = fun _ => a m := by
      funext x
      simp [truncateBelow, hm]
    rw [this]
    exact measurable_const
  · have heq : (fun x : ∀ k, X k => truncateBelow a n x m) = fun x => x m := by
      funext x
      simp [truncateBelow, hm]
    rw [heq]
    have hle : prodCoordSigma (X := X) m ≤ ⨆ i, ⨆ (_ : i ≥ n), prodCoordSigma (X := X) i :=
      le_iSup_of_le m (le_iSup_of_le (by omega) le_rfl)
    intro s hs
    exact hle _ ⟨s, hs, rfl⟩

/-- A finite-modification-invariant set is measurable for the σ-algebra of the coordinates beyond
any fixed index. -/
theorem measurableSet_iSup_ge_of_invariant (a : ∀ m, X m) {S : Set (∀ m, X m)}
    (hS : MeasurableSet S)
    (hinv : ∀ x y : ∀ m, X m, {m | x m ≠ y m}.Finite → (x ∈ S ↔ y ∈ S)) (n : ℕ) :
    MeasurableSet[⨆ i, ⨆ (_ : i ≥ n), prodCoordSigma (X := X) i] S := by
  have hpre : truncateBelow a n ⁻¹' S = S := by
    ext x
    exact hinv (truncateBelow a n x) x (truncateBelow_agree a n x)
  have := measurable_truncateBelow (X := X) a n hS
  rwa [hpre] at this

/-- **A finite-modification-invariant set is a tail event.** -/
theorem measurableSet_limsup_of_invariant (a : ∀ m, X m) {S : Set (∀ m, X m)}
    (hS : MeasurableSet S)
    (hinv : ∀ x y : ∀ m, X m, {m | x m ≠ y m}.Finite → (x ∈ S ↔ y ∈ S)) :
    MeasurableSet[limsup (prodCoordSigma (X := X)) atTop] S := by
  rw [limsup_eq_iInf_iSup_of_nat]
  rw [measurableSet_iInf]
  intro n
  exact measurableSet_iSup_ge_of_invariant a hS hinv n

/-- **The finite-modification zero–one law.**  Under a measure making the coordinates independent, a
measurable set that does not depend on any finite set of coordinates has measure zero or one. -/
theorem measure_eq_zero_or_one_of_invariant
    (μ : Measure (∀ m, X m)) (hindep : iIndep (prodCoordSigma (X := X)) μ)
    (a : ∀ m, X m) {S : Set (∀ m, X m)} (hS : MeasurableSet S)
    (hinv : ∀ x y : ∀ m, X m, {m | x m ≠ y m}.Finite → (x ∈ S ↔ y ∈ S)) :
    μ S = 0 ∨ μ S = 1 :=
  measure_zero_or_one_of_measurableSet_limsup_atTop prodCoordSigma_le hindep
    (measurableSet_limsup_of_invariant a hS hinv)

/-- The coordinates of a countable product measure are independent. -/
theorem iIndep_prodCoordSigma_infinitePi (μ : ∀ n, Measure (X n))
    [∀ n, IsProbabilityMeasure (μ n)] :
    iIndep (prodCoordSigma (X := X)) (Measure.infinitePi μ) :=
  iIndepFun_infinitePi (X := fun _ ω => ω) (fun _ => measurable_id)

/-- **The finite-modification zero–one law for a countable product measure.** -/
theorem measure_infinitePi_eq_zero_or_one_of_invariant (μ : ∀ n, Measure (X n))
    [∀ n, IsProbabilityMeasure (μ n)]
    (a : ∀ m, X m) {S : Set (∀ m, X m)} (hS : MeasurableSet S)
    (hinv : ∀ x y : ∀ m, X m, {m | x m ≠ y m}.Finite → (x ∈ S ↔ y ∈ S)) :
    Measure.infinitePi μ S = 0 ∨ Measure.infinitePi μ S = 1 :=
  measure_eq_zero_or_one_of_invariant _ (iIndep_prodCoordSigma_infinitePi μ) a hS hinv

end GaloisForLFunctions.HTGeometry
