import Mathlib
import GaloisForLFunctions.HTGeometry.DerivedSelectionGeometry.LocalPort
import GaloisForLFunctions.HTGeometry.DerivedSelectionGeometry.IncompatDerived

/-!
# The normal cone of the identity wall

The associated graded ring of the `I`-adic filtration is `gr_I R = ⨁_j I^j ⧸ I^{j+1}` with the
multiplication induced by that of `R`.  This file builds the graded pieces and the graded
multiplication, and identifies them for a principal ideal generated by a regular element:

* `gradedPiece`, `inI`, `gradedMul` — the pieces, the initial-form classes, and the graded product;
* `pieceEquiv` — for `I = (t)` with `t` regular, each `I^j ⧸ I^{j+1}` is one copy of `R ⧸ I`,
  generated by the class of `t^j`;
* `pieceEquiv_mul` — the graded product is that of the polynomial ring `(R ⧸ I)[e]`.

Over the universal monodromy line `R ⧸ I` is the ground field `k`, so `gr_I R ≅ k[e]` with
`e = [q-1]`, and the initial normal forms of the card are computed:

* `inI_monodromyRefl_wall` — reflection acts by `-1` on the conormal coframe, `σ(e) = -e`;
* `inI_curvature` — `in_I(K) = 2e`;
* `inI_energy` — `in_I(E) = e²`;
* `inI_pow_sub_one` — `in_I(q^M - 1) = M e`;
* `inI_energyPow` — `in_I(E_M) = M² e²`;
* `inI_wall_ne_zero` — the coframe generator is nonzero, so these are genuine initial forms.
-/

namespace GaloisForLFunctions.HTGeometry.DerivedSelection

open LaurentPolynomial

universe u

section Pieces

variable {R : Type u} [CommRing R]

/-- The next step of the `I`-adic filtration, seen inside `I^j`. -/
def filtSub (I : Ideal R) (j : ℕ) : Submodule R ↥(I ^ j) :=
  Submodule.comap (I ^ j).subtype (I ^ (j + 1))

/-- The `j`-th graded piece `I^j ⧸ I^{j+1}` of the `I`-adic filtration. -/
abbrev gradedPiece (I : Ideal R) (j : ℕ) : Type u := ↥(I ^ j) ⧸ filtSub I j

/-- The initial-form class of an element of `I^j`. -/
def inI (I : Ideal R) (j : ℕ) (f : R) (hf : f ∈ I ^ j) : gradedPiece I j :=
  Submodule.Quotient.mk ⟨f, hf⟩

theorem inI_eq_iff {I : Ideal R} {j : ℕ} {f g : R} (hf : f ∈ I ^ j) (hg : g ∈ I ^ j) :
    inI I j f hf = inI I j g hg ↔ f - g ∈ I ^ (j + 1) := by
  rw [inI, inI, Submodule.Quotient.eq]
  exact Iff.rfl

theorem inI_eq_zero_iff {I : Ideal R} {j : ℕ} {f : R} (hf : f ∈ I ^ j) :
    inI I j f hf = 0 ↔ f ∈ I ^ (j + 1) := by
  have h0 : (0 : R) ∈ I ^ j := Submodule.zero_mem _
  have : inI I j (0 : R) h0 = 0 := rfl
  rw [← this, inI_eq_iff, sub_zero]

theorem inI_congr {I : Ideal R} {j : ℕ} {f g : R} (hf : f ∈ I ^ j) (hg : g ∈ I ^ j)
    (h : f = g) : inI I j f hf = inI I j g hg := by subst h; rfl

theorem inI_add {I : Ideal R} {j : ℕ} {f g : R} (hf : f ∈ I ^ j) (hg : g ∈ I ^ j) :
    inI I j (f + g) (Submodule.add_mem _ hf hg) = inI I j f hf + inI I j g hg := rfl

theorem inI_smul {I : Ideal R} {j : ℕ} {f : R} (r : R) (hf : f ∈ I ^ j) :
    inI I j (r * f) (Submodule.smul_mem _ r hf) = r • inI I j f hf := rfl

theorem mul_mem_pow_add {I : Ideal R} {i j : ℕ} {a b : R} (ha : a ∈ I ^ i) (hb : b ∈ I ^ j) :
    a * b ∈ I ^ (i + j) := by
  rw [pow_add]
  exact Ideal.mul_mem_mul ha hb

variable (I : Ideal R) (i j : ℕ)

/-- The graded product before passing to quotients. -/
def gradedMulPre : ↥(I ^ i) →ₗ[R] ↥(I ^ j) →ₗ[R] gradedPiece I (i + j) :=
  LinearMap.mk₂ R (fun a b => inI I (i + j) ((a : R) * (b : R)) (mul_mem_pow_add a.2 b.2))
    (by intro a b c; rw [← inI_add]; exact inI_congr _ _ (by push_cast; ring))
    (by intro r a b; rw [← inI_smul]; exact inI_congr _ _ (by push_cast; ring))
    (by intro a b c; rw [← inI_add]; exact inI_congr _ _ (by push_cast; ring))
    (by intro r a b; rw [← inI_smul]; exact inI_congr _ _ (by push_cast; ring))

theorem gradedMulPre_apply (a : ↥(I ^ i)) (b : ↥(I ^ j)) :
    gradedMulPre I i j a b = inI I (i + j) ((a : R) * (b : R)) (mul_mem_pow_add a.2 b.2) := rfl

theorem gradedMulPre_right_ann (a : ↥(I ^ i)) :
    filtSub I j ≤ LinearMap.ker (gradedMulPre I i j a) := by
  intro b hb
  rw [LinearMap.mem_ker, gradedMulPre_apply, inI_eq_zero_iff]
  have hb' : (b : R) ∈ I ^ (j + 1) := hb
  have := mul_mem_pow_add a.2 hb'
  rwa [show i + (j + 1) = i + j + 1 by ring] at this

/-- The graded product, linear in the second variable after passing to the quotient. -/
def gradedMulLeft : ↥(I ^ i) →ₗ[R] (gradedPiece I j →ₗ[R] gradedPiece I (i + j)) where
  toFun a := Submodule.liftQ _ (gradedMulPre I i j a) (gradedMulPre_right_ann I i j a)
  map_add' a b := by
    refine LinearMap.ext fun x => ?_
    obtain ⟨y, rfl⟩ := (filtSub I j).mkQ_surjective x
    simp only [LinearMap.add_apply, Submodule.mkQ_apply]
    change gradedMulPre I i j (a + b) y = gradedMulPre I i j a y + gradedMulPre I i j b y
    rw [map_add, LinearMap.add_apply]
  map_smul' r a := by
    refine LinearMap.ext fun x => ?_
    obtain ⟨y, rfl⟩ := (filtSub I j).mkQ_surjective x
    simp only [RingHom.id_apply, LinearMap.smul_apply, Submodule.mkQ_apply]
    change gradedMulPre I i j (r • a) y = r • gradedMulPre I i j a y
    rw [map_smul, LinearMap.smul_apply]

theorem gradedMulLeft_ann :
    filtSub I i ≤ LinearMap.ker (gradedMulLeft I i j) := by
  intro a ha
  rw [LinearMap.mem_ker]
  refine LinearMap.ext fun x => ?_
  obtain ⟨y, rfl⟩ := (filtSub I j).mkQ_surjective x
  show gradedMulPre I i j a y = 0
  rw [gradedMulPre_apply, inI_eq_zero_iff]
  have ha' : (a : R) ∈ I ^ (i + 1) := ha
  have := mul_mem_pow_add ha' y.2
  rwa [show i + 1 + j = i + j + 1 by ring] at this

/-- **The graded multiplication** `I^i ⧸ I^{i+1} × I^j ⧸ I^{j+1} → I^{i+j} ⧸ I^{i+j+1}`. -/
def gradedMul : gradedPiece I i →ₗ[R] (gradedPiece I j →ₗ[R] gradedPiece I (i + j)) :=
  Submodule.liftQ _ (gradedMulLeft I i j) (gradedMulLeft_ann I i j)

@[simp] theorem gradedMul_inI {f g : R} (hf : f ∈ I ^ i) (hg : g ∈ I ^ j) :
    gradedMul I i j (inI I i f hf) (inI I j g hg)
      = inI I (i + j) (f * g) (mul_mem_pow_add hf hg) := rfl

end Pieces

section PrincipalRegular

variable {R : Type u} [CommRing R] {t : R} (ht : IsSMulRegular R t)

theorem pow_mem_span_pow (j : ℕ) (r : R) :
    t ^ j * r ∈ (Ideal.span {t} : Ideal R) ^ j := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  exact Dvd.intro r rfl

/-- The generator of the `j`-th graded piece: `r ↦ [t^j r]`. -/
def pieceGen (t : R) (j : ℕ) : R →ₗ[R] gradedPiece (Ideal.span {t}) j where
  toFun r := inI _ j (t ^ j * r) (pow_mem_span_pow j r)
  map_add' a b := by rw [← inI_add]; exact inI_congr _ _ (by ring)
  map_smul' r a := by
    rw [← inI_smul]
    exact inI_congr _ _ (by simp only [RingHom.id_apply]; ring)

theorem pieceGen_surjective (j : ℕ) : Function.Surjective (pieceGen t j) := by
  intro x
  obtain ⟨⟨f, hf⟩, rfl⟩ := (filtSub (Ideal.span {t}) j).mkQ_surjective x
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hf
  obtain ⟨r, rfl⟩ := hf
  exact ⟨r, rfl⟩

include ht

theorem ker_pieceGen (j : ℕ) :
    LinearMap.ker (pieceGen t j) = (Ideal.span {t} : Ideal R) := by
  ext r
  rw [LinearMap.mem_ker, pieceGen, LinearMap.coe_mk, AddHom.coe_mk, inI_eq_zero_iff,
    Ideal.span_singleton_pow, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨s, hs⟩
    refine ⟨s, ?_⟩
    have hreg : IsSMulRegular R (t ^ j) := ht.pow j
    refine hreg ?_
    show t ^ j * r = t ^ j * (t * s)
    rw [hs, pow_succ]
    ring
  · rintro ⟨s, rfl⟩
    exact ⟨s, by rw [pow_succ]; ring⟩

/-- **Each graded piece of a principal regular filtration is one copy of the identity fibre.** -/
noncomputable def pieceEquiv (j : ℕ) :
    (R ⧸ (Ideal.span {t} : Ideal R)) ≃ₗ[R] gradedPiece (Ideal.span {t}) j :=
  (Submodule.quotEquivOfEq _ _ (ker_pieceGen ht j).symm).trans
    (LinearMap.quotKerEquivOfSurjective _ (pieceGen_surjective j))

theorem pieceEquiv_mk (j : ℕ) (r : R) :
    pieceEquiv ht j (Submodule.Quotient.mk r) = pieceGen t j r := rfl

/-- **The graded multiplication is that of the polynomial ring `(R ⧸ I)[e]`.**  Transported along
the identification of the graded pieces with the identity fibre, the graded product is the product
of the fibre. -/
theorem pieceEquiv_mul (i j : ℕ) (a b : R ⧸ (Ideal.span {t} : Ideal R)) :
    pieceEquiv ht (i + j) (a * b)
      = gradedMul _ i j (pieceEquiv ht i a) (pieceEquiv ht j b) := by
  obtain ⟨r, rfl⟩ := (Ideal.span {t} : Ideal R).mkQ_surjective a
  obtain ⟨s, rfl⟩ := (Ideal.span {t} : Ideal R).mkQ_surjective b
  have hmul : (Submodule.Quotient.mk r : R ⧸ (Ideal.span {t} : Ideal R))
      * Submodule.Quotient.mk s = Submodule.Quotient.mk (r * s) := rfl
  rw [Submodule.mkQ_apply, Submodule.mkQ_apply, hmul, pieceEquiv_mk, pieceEquiv_mk,
    pieceEquiv_mk]
  show inI _ (i + j) (t ^ (i + j) * (r * s)) _
      = gradedMul _ i j (inI _ i (t ^ i * r) _) (inI _ j (t ^ j * s) _)
  rw [gradedMul_inI, inI_eq_iff]
  have : t ^ (i + j) * (r * s) - t ^ i * r * (t ^ j * s) = 0 := by ring
  rw [this]
  exact Submodule.zero_mem _

end PrincipalRegular

section Monodromy

variable {k : Type u} [Field k]

theorem wallEquation_mem_pow_one : wallEquation k ∈ (identityIdeal k) ^ 1 := by
  rw [pow_one, identityIdeal]
  exact Ideal.mem_span_singleton_self _

/-- The oriented conormal coframe generator `e = [q-1] ∈ I ⧸ I²`. -/
noncomputable def conormalGen : gradedPiece (identityIdeal k) 1 :=
  inI (identityIdeal k) 1 (wallEquation k) wallEquation_mem_pow_one

theorem mem_pow_one_of_mem_identityIdeal {f : MonodromyRing k} (hf : f ∈ identityIdeal k) :
    f ∈ (identityIdeal k) ^ 1 := by rwa [pow_one]

theorem sub_mem_pow_two_iff {f g : MonodromyRing k}
    (hf : f ∈ (identityIdeal k) ^ 1) (hg : g ∈ (identityIdeal k) ^ 1) :
    inI (identityIdeal k) 1 f hf = inI (identityIdeal k) 1 g hg
      ↔ f - g ∈ (identityIdeal k) ^ 2 :=
  inI_eq_iff hf hg

/-- **Theorem 5.4 (5.11).**  Reflection reverses the conormal coframe: `σ(e) = -e`. -/
theorem inI_monodromyRefl_wall :
    inI (identityIdeal k) 1 ((monodromyRefl (k := k)) (wallEquation k))
        (mem_pow_one_of_mem_identityIdeal
          (monodromyRefl_mem_identityIdeal (Ideal.mem_span_singleton_self _)))
      = -conormalGen := by
  rw [eq_neg_iff_add_eq_zero, conormalGen, ← inI_add, inI_eq_zero_iff]
  exact monodromyRefl_wall_add_mem_sq

theorem monodromyCurvature_mem_pow_one :
    (monodromyCurvature : MonodromyRing k) ∈ (identityIdeal k) ^ 1 := by
  have h := monodromyCurvature_sub_two_wall_mem_sq (k := k)
  have h2 : (identityIdeal k) ^ 2 ≤ (identityIdeal k) ^ 1 :=
    Ideal.pow_le_pow_right (by omega)
  have hw : (2 : MonodromyRing k) * wallEquation k ∈ (identityIdeal k) ^ 1 :=
    Ideal.mul_mem_left _ 2 wallEquation_mem_pow_one
  have hsum := Submodule.add_mem _ (h2 h) hw
  have heq : monodromyCurvature - (2 : MonodromyRing k) * wallEquation k
      + (2 : MonodromyRing k) * wallEquation k = (monodromyCurvature : MonodromyRing k) := by
    ring
  rwa [heq] at hsum

/-- **Theorem 5.4 (5.12), coframe half.**  `in_I(K) = 2e`. -/
theorem inI_curvature :
    inI (identityIdeal k) 1 monodromyCurvature monodromyCurvature_mem_pow_one
      = (2 : MonodromyRing k) • conormalGen := by
  rw [conormalGen, ← inI_smul, inI_eq_iff]
  exact monodromyCurvature_sub_two_wall_mem_sq

theorem monodromyEnergy_mem_pow_two :
    (monodromyEnergy : MonodromyRing k) ∈ (identityIdeal k) ^ 2 := by
  rw [identityIdeal, wallEquation]
  exact reflEnergy_mem_sq monodromy_mul_inv

theorem wall_sq_mem_pow_two : (wallEquation k) * (wallEquation k) ∈ (identityIdeal k) ^ 2 :=
  mul_mem_pow_add wallEquation_mem_pow_one wallEquation_mem_pow_one

theorem monodromyInv_sub_one_mem :
    (monodromyInv : MonodromyRing k) - 1 ∈ identityIdeal k := by
  rw [← ker_evalOne, RingHom.mem_ker, map_sub, map_one, monodromyInv, evalOne_T, sub_self]

/-- **Theorem 5.4 (5.12), metric half.**  `in_I(E) = e²`. -/
theorem inI_energy :
    inI (identityIdeal k) 2 monodromyEnergy monodromyEnergy_mem_pow_two
      = gradedMul (identityIdeal k) 1 1 conormalGen conormalGen := by
  rw [conormalGen, gradedMul_inI, inI_eq_iff]
  have hfac : (monodromyEnergy : MonodromyRing k) - wallEquation k * wallEquation k
      = (wallEquation k * wallEquation k) * (monodromyInv - 1) := by
    have h := reflEnergy_eq (monodromy_mul_inv (k := k))
    rw [monodromyEnergy, h, wallEquation]
    ring
  rw [hfac, show (2 : ℕ) + 1 = 1 + 1 + 1 by ring, pow_succ]
  exact Ideal.mul_mem_mul wall_sq_mem_pow_two monodromyInv_sub_one_mem

theorem portCofactor_sub_cast_mem (M : ℕ) :
    (portCofactor M : MonodromyRing k) - (M : MonodromyRing k) ∈ identityIdeal k := by
  rw [← ker_evalOne, RingHom.mem_ker, map_sub, evalOne_portCofactor, map_natCast, sub_self]

theorem pow_sub_one_mem_pow_one (M : ℕ) :
    (monodromyParam k ^ M - 1) ∈ (identityIdeal k) ^ 1 := by
  rw [pow_one, ← wallEquation_mul_portCofactor M, identityIdeal]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- **Theorem 5.4 (5.13), coframe half.**  `in_I(q^M - 1) = M e`. -/
theorem inI_pow_sub_one (M : ℕ) :
    inI (identityIdeal k) 1 (monodromyParam k ^ M - 1) (pow_sub_one_mem_pow_one M)
      = (M : MonodromyRing k) • conormalGen := by
  rw [conormalGen, ← inI_smul, inI_eq_iff]
  have hfac : (monodromyParam k ^ M - 1) - (M : MonodromyRing k) * wallEquation k
      = wallEquation k * (portCofactor M - (M : MonodromyRing k)) := by
    rw [← wallEquation_mul_portCofactor M]
    ring
  rw [hfac, show (1 : ℕ) + 1 = 1 + 1 by ring, pow_succ, pow_one]
  exact Ideal.mul_mem_mul (by rw [identityIdeal]; exact Ideal.mem_span_singleton_self _)
    (portCofactor_sub_cast_mem M)

theorem energyPow_factor (M : ℕ) :
    (monodromyEnergyPow M : MonodromyRing k)
      = (wallEquation k * wallEquation k) * (portCofactor M ^ 2 * monodromyInv ^ M) := by
  have hmul : (monodromyParam k ^ M) * (monodromyInv ^ M : MonodromyRing k) = 1 := by
    rw [← mul_pow, monodromy_mul_inv, one_pow]
  have h := reflEnergy_eq hmul
  rw [monodromyEnergyPow, h, ← wallEquation_mul_portCofactor M]
  ring

theorem monodromyEnergyPow_mem_pow_two (M : ℕ) :
    (monodromyEnergyPow M : MonodromyRing k) ∈ (identityIdeal k) ^ 2 := by
  rw [energyPow_factor M]
  exact Ideal.mul_mem_right _ _ wall_sq_mem_pow_two

theorem portCofactorSq_sub_cast_mem (M : ℕ) :
    (portCofactor M ^ 2 * monodromyInv ^ M : MonodromyRing k) - ((M : MonodromyRing k) ^ 2)
      ∈ identityIdeal k := by
  rw [← ker_evalOne, RingHom.mem_ker, map_sub, map_mul, map_pow, map_pow,
    evalOne_portCofactor, monodromyInv, evalOne_T, one_pow, mul_one, map_pow, map_natCast,
    sub_self]

/-- **Theorem 5.4 (5.13), metric half.**  `in_I(E_M) = M² e²`. -/
theorem inI_energyPow (M : ℕ) :
    inI (identityIdeal k) 2 (monodromyEnergyPow M) (monodromyEnergyPow_mem_pow_two M)
      = ((M : MonodromyRing k) ^ 2) • gradedMul (identityIdeal k) 1 1 conormalGen conormalGen := by
  rw [conormalGen, gradedMul_inI, ← inI_smul, inI_eq_iff]
  have hfac : (monodromyEnergyPow M : MonodromyRing k)
      - (M : MonodromyRing k) ^ 2 * (wallEquation k * wallEquation k)
      = (wallEquation k * wallEquation k)
        * ((portCofactor M ^ 2 * monodromyInv ^ M) - (M : MonodromyRing k) ^ 2) := by
    rw [energyPow_factor M]
    ring
  rw [hfac, show (2 : ℕ) + 1 = 1 + 1 + 1 by ring, pow_succ]
  exact Ideal.mul_mem_mul wall_sq_mem_pow_two (portCofactorSq_sub_cast_mem M)

/-- The identity wall equation is not a unit, since it vanishes at the identity. -/
theorem not_isUnit_wallEquation : ¬ IsUnit (wallEquation k) := by
  intro hu
  obtain ⟨v, hv⟩ := hu.exists_right_inv
  have := congrArg (evalOne k) hv
  rw [map_mul, evalOne_wallEquation, zero_mul, map_one] at this
  exact zero_ne_one this

/-- **The conormal coframe generator is nonzero**, so the initial forms above are genuine. -/
theorem inI_wall_ne_zero : (conormalGen : gradedPiece (identityIdeal k) 1) ≠ 0 := by
  rw [conormalGen, Ne, inI_eq_zero_iff]
  intro hmem
  rw [show (1 : ℕ) + 1 = 2 by ring, identityIdeal, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton] at hmem
  obtain ⟨s, hs⟩ := hmem
  have h1 : wallEquation k * (1 - wallEquation k * s) = 0 := by
    have hsq : wallEquation k * (wallEquation k * s) = wallEquation k ^ 2 * s := by ring
    rw [mul_sub, mul_one, hsq, ← hs, sub_self]
  rcases mul_eq_zero.1 h1 with h | h
  · exact wallEquation_ne_zero h
  · exact not_isUnit_wallEquation
      ⟨⟨wallEquation k, s, by linear_combination -h, by linear_combination -h⟩, rfl⟩

/-- **Theorem 5.4 (5.10).**  Over the universal monodromy line each graded piece of the normal
cone is one copy of the identity fibre `k`, generated by the class of `(q-1)^j`; with
`pieceEquiv_mul` this identifies `gr_I R` with the polynomial ring `k[e]`. -/
noncomputable def normalConePieceEquiv (j : ℕ) :
    (MonodromyRing k ⧸ identityIdeal k) ≃ₗ[MonodromyRing k] gradedPiece (identityIdeal k) j :=
  pieceEquiv (monodromy_isSMulRegular k) j

end Monodromy

end GaloisForLFunctions.HTGeometry.DerivedSelection
