import Mathlib

/-!
# Determinant ideals of finite generating families

For a finite generating family `π : Rⁿ ↠ M` the *determinant ideal* `presDetIdeal π` is generated
by the determinants of the `n × n` matrices whose columns are relations, i.e. lie in `ker π`.  This
is the zeroth Fitting ideal computed from that presentation.

This file proves the elementary step of presentation independence: adjoining one more generator
does not change the determinant ideal.

* `presDetIdeal` — the determinant ideal of a generating family;
* `extendGen` — adjoin a generator `μ` to a family;
* `borderMat`, `det_borderMat` — the bordered relation matrix `[[D, -a],[0,1]]`;
* `liftMat`, `det_liftMat` — the unitriangular matrix clearing the extra generator;
* `presDetIdeal_extendGen` — `presDetIdeal (extendGen π μ) = presDetIdeal π` for surjective `π`.
-/

namespace GaloisForLFunctions.HTGeometry.DerivedSelection

universe u v

section PresDet

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- A square matrix all of whose columns are relations for the generating family `π`. -/
def IsRelMatrix {n : ℕ} (π : (Fin n → R) →ₗ[R] M) (A : Matrix (Fin n) (Fin n) R) : Prop :=
  ∀ j, π (fun i => A i j) = 0

/-- The determinant ideal of a finite generating family: the ideal generated by determinants of
relation matrices. -/
def presDetIdeal {n : ℕ} (π : (Fin n → R) →ₗ[R] M) : Ideal R :=
  Ideal.span {r | ∃ A : Matrix (Fin n) (Fin n) R, IsRelMatrix π A ∧ A.det = r}

theorem det_mem_presDetIdeal {n : ℕ} {π : (Fin n → R) →ₗ[R] M}
    {A : Matrix (Fin n) (Fin n) R} (hA : IsRelMatrix π A) : A.det ∈ presDetIdeal π :=
  Ideal.subset_span ⟨A, hA, rfl⟩

theorem presDetIdeal_le {n : ℕ} {π : (Fin n → R) →ₗ[R] M} {J : Ideal R}
    (h : ∀ A : Matrix (Fin n) (Fin n) R, IsRelMatrix π A → A.det ∈ J) :
    presDetIdeal π ≤ J := by
  rw [presDetIdeal, Ideal.span_le]
  rintro r ⟨A, hA, rfl⟩
  exact h A hA

end PresDet

section Extend

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {n : ℕ}

/-- Adjoin one more generator `μ` to the finite generating family `π`. -/
def extendGen (π : (Fin n → R) →ₗ[R] M) (μ : M) : (Fin (n + 1) → R) →ₗ[R] M :=
  π ∘ₗ LinearMap.funLeft R R Fin.castSucc +
    LinearMap.smulRight (LinearMap.proj (Fin.last n)) μ

@[simp] theorem extendGen_apply (π : (Fin n → R) →ₗ[R] M) (μ : M) (x : Fin (n + 1) → R) :
    extendGen π μ x = π (fun i => x i.castSucc) + x (Fin.last n) • μ := rfl

theorem extendGen_surjective {π : (Fin n → R) →ₗ[R] M} (hπ : Function.Surjective π) (μ : M) :
    Function.Surjective (extendGen π μ) := by
  intro m
  obtain ⟨x, hx⟩ := hπ m
  refine ⟨Fin.lastCases 0 x, ?_⟩
  simp [hx]

/-- The bordered relation matrix `[[D, -a], [0, 1]]`. -/
def borderMat (D : Matrix (Fin n) (Fin n) R) (a : Fin n → R) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  Matrix.of fun i j =>
    Fin.lastCases (Fin.lastCases (1 : R) (fun i' => -a i') i)
      (fun j' => Fin.lastCases (0 : R) (fun i' => D i' j') i) j

variable (D : Matrix (Fin n) (Fin n) R) (a : Fin n → R)

@[simp] theorem borderMat_last_last : borderMat D a (Fin.last n) (Fin.last n) = 1 := by
  simp [borderMat]

@[simp] theorem borderMat_castSucc_last (i : Fin n) :
    borderMat D a i.castSucc (Fin.last n) = -a i := by
  simp [borderMat]

@[simp] theorem borderMat_last_castSucc (j : Fin n) :
    borderMat D a (Fin.last n) j.castSucc = 0 := by
  simp [borderMat]

@[simp] theorem borderMat_castSucc_castSucc (i j : Fin n) :
    borderMat D a i.castSucc j.castSucc = D i j := by
  simp [borderMat]

theorem submatrix_borderMat :
    (borderMat D a).submatrix (Fin.last n).succAbove (Fin.last n).succAbove = D := by
  ext i j
  simp [Fin.succAbove_last]

theorem det_borderMat : (borderMat D a).det = D.det := by
  rw [Matrix.det_succ_row (borderMat D a) (Fin.last n)]
  rw [Finset.sum_eq_single (Fin.last n)]
  · rw [borderMat_last_last, submatrix_borderMat, Fin.val_last]
    have : ((-1 : R)) ^ (n + n) = 1 := Even.neg_one_pow ⟨n, rfl⟩
    rw [this]; ring
  · intro j _ hj
    induction j using Fin.lastCases with
    | last => exact absurd rfl hj
    | cast j' => rw [borderMat_last_castSucc]; simp
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem isRelMatrix_borderMat {π : (Fin n → R) →ₗ[R] M} {μ : M}
    (ha : π a = μ) (hD : IsRelMatrix π D) :
    IsRelMatrix (extendGen π μ) (borderMat D a) := by
  intro j
  induction j using Fin.lastCases with
  | last =>
      have h1 : (fun i => borderMat D a i (Fin.last n)) = Fin.lastCases 1 (fun i' => -a i') := by
        funext i
        induction i using Fin.lastCases with
        | last => simp
        | cast i' => simp
      rw [h1]
      simp only [extendGen_apply, Fin.lastCases_last, Fin.lastCases_castSucc]
      have : (fun i : Fin n => -a i) = -a := rfl
      rw [this, map_neg, ha, one_smul]
      abel
  | cast j' =>
      have h1 : (fun i => borderMat D a i j'.castSucc) = Fin.lastCases 0 (fun i' => D i' j') := by
        funext i
        induction i using Fin.lastCases with
        | last => simp
        | cast i' => simp
      rw [h1]
      simp only [extendGen_apply, Fin.lastCases_last, Fin.lastCases_castSucc]
      rw [hD j', zero_smul, add_zero]

/-- The unitriangular matrix `[[1, a],[0,1]]` used to clear the adjoined generator. -/
def liftMat (a : Fin n → R) : Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  Matrix.of fun i j =>
    if j = Fin.last n then Fin.lastCases (1 : R) a i else if i = j then 1 else 0

theorem liftMat_apply_of_ne {i j : Fin (n + 1)} (hj : j ≠ Fin.last n) :
    liftMat a i j = if i = j then 1 else 0 := by
  simp [liftMat, hj]

@[simp] theorem liftMat_apply_last (i : Fin (n + 1)) :
    liftMat a i (Fin.last n) = Fin.lastCases (1 : R) a i := by
  simp [liftMat]

theorem det_liftMat : (liftMat a).det = 1 := by
  have htri : (liftMat a).BlockTriangular id := by
    intro i j hij
    have hj : j ≠ Fin.last n := by
      intro h
      rw [h] at hij
      exact absurd (Fin.le_last i) (not_le.2 hij)
    rw [liftMat_apply_of_ne a hj, if_neg]
    exact fun h => absurd hij (by rw [h]; exact lt_irrefl _)
  rw [Matrix.det_of_upperTriangular htri]
  refine Finset.prod_eq_one fun i _ => ?_
  induction i using Fin.lastCases with
  | last => simp
  | cast i' =>
      rw [liftMat_apply_of_ne a (Fin.castSucc_lt_last i').ne, if_pos rfl]

theorem liftMat_mul_apply (B : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (i j : Fin (n + 1)) :
    (liftMat a * B) i j =
      (if i = Fin.last n then 0 else B i j) + (Fin.lastCases (1 : R) a i) * B (Fin.last n) j := by
  rw [Matrix.mul_apply, Fin.sum_univ_castSucc]
  congr 1
  · have : ∀ l : Fin n, liftMat a i l.castSucc * B l.castSucc j =
        if i = l.castSucc then B l.castSucc j else 0 := by
      intro l
      rw [liftMat_apply_of_ne a (Fin.castSucc_lt_last l).ne]
      split <;> simp
    rw [Finset.sum_congr rfl fun l _ => this l]
    induction i using Fin.lastCases with
    | last =>
        rw [if_pos rfl]
        refine Finset.sum_eq_zero fun l _ => ?_
        rw [if_neg]
        exact (Fin.castSucc_lt_last l).ne'
    | cast i' =>
        rw [if_neg (Fin.castSucc_lt_last i').ne]
        have hcond : ∀ l : Fin n, (if i'.castSucc = l.castSucc then B l.castSucc j else 0)
            = (if i' = l then B l.castSucc j else 0) := by
          intro l; by_cases h : i' = l <;> simp [h]
        rw [Finset.sum_congr rfl fun l (_ : l ∈ Finset.univ) => hcond l,
          Finset.sum_ite_eq Finset.univ i' fun l => B l.castSucc j]
        simp
  · rw [liftMat_apply_last]

end Extend

section StepA

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {n : ℕ}
  {π : (Fin n → R) →ₗ[R] M} {μ : M}

theorem presDetIdeal_le_extendGen (hπ : Function.Surjective π) :
    presDetIdeal π ≤ presDetIdeal (extendGen π μ) := by
  obtain ⟨a, ha⟩ := hπ μ
  refine presDetIdeal_le fun D hD => ?_
  rw [← det_borderMat D a]
  exact det_mem_presDetIdeal (isRelMatrix_borderMat D a ha hD)

theorem presDetIdeal_extendGen_le (hπ : Function.Surjective π) :
    presDetIdeal (extendGen π μ) ≤ presDetIdeal π := by
  obtain ⟨a, ha⟩ := hπ μ
  refine presDetIdeal_le fun B hB => ?_
  set B' := liftMat a * B with hB'
  have hdet : B'.det = B.det := by
    rw [hB', Matrix.det_mul, det_liftMat, one_mul]
  have hcol : ∀ j : Fin (n + 1), π (fun i : Fin n => B' i.castSucc j) = 0 := by
    intro j
    have h1 : (fun i : Fin n => B' i.castSucc j)
        = (fun i : Fin n => B i.castSucc j) + B (Fin.last n) j • a := by
      funext i
      rw [hB', liftMat_mul_apply a B i.castSucc j, if_neg (Fin.castSucc_lt_last i).ne,
        Fin.lastCases_castSucc]
      simp [mul_comm]
    rw [h1, map_add, map_smul, ha]
    have := hB j
    simp only [extendGen_apply] at this
    exact this
  rw [← hdet, Matrix.det_succ_row B' (Fin.last n)]
  refine Ideal.sum_mem _ fun j _ => ?_
  refine Ideal.mul_mem_left _ _ ?_
  refine det_mem_presDetIdeal (A := B'.submatrix (Fin.last n).succAbove j.succAbove) ?_
  intro l
  have : (fun i : Fin n => B'.submatrix (Fin.last n).succAbove j.succAbove i l)
      = fun i : Fin n => B' i.castSucc (j.succAbove l) := by
    funext i
    simp [Fin.succAbove_last]
  rw [this]
  exact hcol (j.succAbove l)

/-- **Adjoining a generator does not change the determinant ideal.** -/
theorem presDetIdeal_extendGen (hπ : Function.Surjective π) :
    presDetIdeal (extendGen π μ) = presDetIdeal π :=
  le_antisymm (presDetIdeal_extendGen_le hπ) (presDetIdeal_le_extendGen hπ)

end StepA

end GaloisForLFunctions.HTGeometry.DerivedSelection
