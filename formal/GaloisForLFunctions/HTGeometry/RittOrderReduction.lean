import GaloisForLFunctions.HTGeometry.DifferentialPseudoDivision

/-!
# Ritt's order reduction

Iterating the order-lowering step brings any differential polynomial, at the cost of a power of the
separant, into the differential ideal generated by `A` plus a remainder of order at most the order
of `A`.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial GaloisForLFunctions

noncomputable section

variable {K : Type*} [CommRing K] [Differential K]

/-- The ideal generated by a differential polynomial and all of its derivatives: the differential
ideal it generates. -/
def derivIdeal (A : DifferentialPolynomial Unit K) : Ideal (DifferentialPolynomial Unit K) :=
  Ideal.span (Set.range fun k : ℕ => (⇑(differentialPolynomialOverDerivation Unit K))^[k] A)

theorem iterate_deriv_mem_derivIdeal (A : DifferentialPolynomial Unit K) (k : ℕ) :
    (⇑(differentialPolynomialOverDerivation Unit K))^[k] A ∈ derivIdeal A :=
  Ideal.subset_span ⟨k, rfl⟩

/-- **Ritt's order reduction.**  Every differential polynomial reduces, at the cost of a power of
the separant of `A`, to one of order at most the order of `A`, modulo the differential ideal of
`A`. -/
theorem exists_order_reduced (A : DifferentialPolynomial Unit K) :
    ∀ (m : ℕ) (F : DifferentialPolynomial Unit K),
      scalarDifferentialPolynomialOrder F ≤ m →
      ∃ (e : ℕ) (R : DifferentialPolynomial Unit K),
        (∀ p ∈ R.vars, p.2 ≤ scalarDifferentialPolynomialOrder A) ∧
        scalarSeparant A ^ e * F - R ∈ derivIdeal A := by
  intro m
  induction m with
  | zero =>
      intro F hF
      refine ⟨0, F, ?_, ?_⟩
      · intro p hp
        have := vars_le_scalarOrder F p hp
        omega
      · simp
  | succ m ih =>
      intro F hF
      by_cases hle : scalarDifferentialPolynomialOrder F ≤ scalarDifferentialPolynomialOrder A
      · refine ⟨0, F, ?_, ?_⟩
        · intro p hp
          exact le_trans (vars_le_scalarOrder F p hp) hle
        · simp
      · rw [not_le] at hle
        obtain ⟨e₁, G, Rem, hRem, hEq⟩ :=
          exists_order_reduction (A := A) (F := F)
            (m := scalarDifferentialPolynomialOrder F) hle (vars_le_scalarOrder F)
        have hRemOrd : scalarDifferentialPolynomialOrder Rem ≤ m := by
          refine le_trans (scalarOrder_le (n := scalarDifferentialPolynomialOrder F - 1) ?_) ?_
          · intro p hp
            have := hRem p hp
            omega
          · omega
        obtain ⟨e₂, R, hR, hmem⟩ := ih Rem hRemOrd
        refine ⟨e₁ + e₂, R, hR, ?_⟩
        have hsplit : scalarSeparant A ^ (e₁ + e₂) * F - R
            = scalarSeparant A ^ e₂ * G
                * ((⇑(differentialPolynomialOverDerivation Unit K))^[
                    scalarDifferentialPolynomialOrder F
                      - scalarDifferentialPolynomialOrder A] A)
              + (scalarSeparant A ^ e₂ * Rem - R) := by
          have : scalarSeparant A ^ (e₁ + e₂) * F
              = scalarSeparant A ^ e₂ * (scalarSeparant A ^ e₁ * F) := by
            rw [← mul_assoc, ← pow_add]
            ring_nf
          rw [this, hEq]
          ring
        rw [hsplit]
        exact Ideal.add_mem _
          (Ideal.mul_mem_left _ _ (iterate_deriv_mem_derivIdeal A _)) hmem

end

end GaloisForLFunctions.HTGeometry
