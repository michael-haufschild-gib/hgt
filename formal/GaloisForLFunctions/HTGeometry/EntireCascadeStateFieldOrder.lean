import GaloisForLFunctions.HTGeometry.StateFieldTrdeg
import GaloisForLFunctions.HTGeometry.EntireOrderFromStateField

/-!
# The order bound from a finite set of states

Assembling the three ingredients: a field generated by `n` elements has transcendence degree at most
`n`, its relative algebraic closure has the same degree and absorbs the derivation, and `n+1` jets in
a field of degree `n` are algebraically dependent.

The hypothesis is exactly what a composition supplies — the derivative of every element of the state
field is *algebraic over* that field, never inside it.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

/-- **The order bound from finitely many states.**  If the derivative of every element of the field
generated by `s : Fin n → L` is algebraic over that field, then every element of it satisfies a
nonzero polynomial relation among its first `n+1` jets. -/
theorem exists_jet_relation_of_state_generators
    {K L : Type} [Field K] [Field L] [Algebra K L] [Differential L] [CharZero L]
    {n : ℕ} (s : Fin n → L)
    (hs : ∀ y : L, y ∈ IntermediateField.adjoin K (Set.range s) →
      y′ ∈ algebraicClosure ((IntermediateField.adjoin K (Set.range s) : Type)) L)
    {x : L} (hx : x ∈ IntermediateField.adjoin K (Set.range s)) :
    ∃ Q : MvPolynomial (Fin (n + 1)) K, Q ≠ 0 ∧
      MvPolynomial.aeval (fun i : Fin (n + 1) => differentialJet (i : ℕ) x) Q = 0 := by
  set E : IntermediateField K L := IntermediateField.adjoin K (Set.range s) with hEdef
  refine exists_jet_relation_of_trdeg_le
    ((algebraicClosure (E : Type) L).restrictScalars K) ?_ ?_
  · calc Algebra.trdeg K ((algebraicClosure (E : Type) L).restrictScalars K)
        ≤ Cardinal.mk (Fin n) := trdeg_algebraicClosure_adjoin_range_le s
      _ = (n : Cardinal) := by simp
  · intro i
    exact differentialJet_mem_algebraicClosure_restrictScalars E hs
      (mem_algebraicClosure_restrictScalars_of_mem E hx) i

/-! ## The entire-function form -/

/-- The domain of entire germs. -/
local instance entireAnalyticDomain' : IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

/-- The rational coordinate field inside the global meromorphic field. -/
local instance entireRatFuncAlgebra' : Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).toAlgebra

/-- The ordinary derivative as the differential structure on the global meromorphic field. -/
local instance entireMeroDifferential' : Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential (U := (Set.univ : Set ℂ)) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

/-- The global meromorphic field has characteristic zero. -/
local instance entireMeroCharZero : CharZero (meroField (Set.univ : Set ℂ)) :=
  charZero_of_injective_algebraMap
    (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))).injective

/-- **The composition order bound.**  An entire function whose meromorphic realization lies in the
field generated by `n` states, each element of which has an algebraic derivative, satisfies an
algebraic differential equation of order at most `n`. -/
theorem differentiallyAlgebraicOfOrder_of_state_generators {f : ℂ → ℂ}
    (hf : AnalyticOnNhd ℂ f (Set.univ : Set ℂ)) {n : ℕ}
    (s : Fin n → meroField (Set.univ : Set ℂ))
    (hs : ∀ y : meroField (Set.univ : Set ℂ),
      y ∈ IntermediateField.adjoin (RatFunc ℂ) (Set.range s) →
      y′ ∈ algebraicClosure
        ((IntermediateField.adjoin (RatFunc ℂ) (Set.range s) : Type))
        (meroField (Set.univ : Set ℂ)))
    (hx : analyticMeroElement f hf ∈ IntermediateField.adjoin (RatFunc ℂ) (Set.range s)) :
    DifferentiallyAlgebraicOfOrder f n := by
  obtain ⟨Q, hQ0, hQ⟩ := exists_jet_relation_of_state_generators s hs hx
  exact differentiallyAlgebraicOfOrder_of_jet_relation hf hQ0 hQ

/-- The rational coordinate field with its own derivation. -/
local instance entireRatFuncDifferential : Differential (RatFunc ℂ) :=
  ratFuncCoordinateDifferential

/-- The rational coordinate embedding is differential. -/
local instance entireRatFuncDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  meroFieldRatFuncDifferentialAlgebra isOpen_univ isPreconnected_univ
    Set.univ_nonempty Set.infinite_univ

/-- **The composition order bound, generator form.**  An entire function whose meromorphic
realization lies in the field generated over `ℂ(z)` by `n` states, each of whose derivatives is
algebraic over that field, satisfies an algebraic differential equation of order at most `n`.

Only the `n` generators need checking: the base field carries its own derivation, and sums, products
and inverses keep the derivative inside the closure. -/
theorem differentiallyAlgebraicOfOrder_of_algebraic_state_derivatives {f : ℂ → ℂ}
    (hf : AnalyticOnNhd ℂ f (Set.univ : Set ℂ)) {n : ℕ}
    (s : Fin n → meroField (Set.univ : Set ℂ))
    (hgen : ∀ y ∈ Set.range s, y′ ∈
      algebraicClosure
        ((IntermediateField.adjoin (RatFunc ℂ) (Set.range s) :
          IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ))) : Type)
        (meroField (Set.univ : Set ℂ)))
    (hx : analyticMeroElement f hf ∈ IntermediateField.adjoin (RatFunc ℂ) (Set.range s)) :
    DifferentiallyAlgebraicOfOrder f n :=
  differentiallyAlgebraicOfOrder_of_state_generators hf s
    (deriv_mem_algebraicClosure_adjoin_of_gen hgen) hx

end

end GaloisForLFunctions.HTGeometry
