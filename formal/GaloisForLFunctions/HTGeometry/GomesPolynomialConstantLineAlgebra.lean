import GaloisForLFunctions.HTGeometry.GomesTwoChainPolynomialAlgebra

/-!
# Exact generated symmetry algebra on actual polynomial endomorphisms

The formal matrix algebra generated by D and reflection is transported to actual
polynomial operators. Membership is exactly second-derivative commutation together
with preservation of all constant polynomials, independently of the center.
-/

noncomputable section
open Polynomial
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- Actual polynomial operators reconstructed from the full reflection-generated matrix algebra. -/
def gomesPolynomialConstantLineAlgebra (c : K) : Subalgebra K (Module.End K K[X]) :=
  ((gomesDerivativeReflectionGeneratedAlgebra K c).restrictScalars K).map
    (gomesTwoChainPolynomialAlgHom K)

/-- The full actual-image algebra is exactly the second-derivative symmetries preserving constants. -/
theorem gomesPolynomialConstantLineAlgebra_mem_iff (c : K) (E : Module.End K K[X]) :
    E ∈ gomesPolynomialConstantLineAlgebra K c ↔
      Commute E (Polynomial.derivative ^ 2 : Module.End K K[X]) ∧
        ∀ a : K, (E (C a)).derivative = 0 := by
  rw [gomesPolynomialConstantLineAlgebra, Subalgebra.mem_map]
  constructor
  · rintro ⟨M, hM, rfl⟩
    let e := (gomesPolynomialDerivativePowerCommutantEquiv K 2).symm M
    have he : gomesPolynomialDerivativePowerCommutantEquiv K 2 e = M :=
      (gomesPolynomialDerivativePowerCommutantEquiv K 2).apply_symm_apply M
    constructor
    · exact ((gomesCentralizerSingleton_mem_iff K _ _).mp e.property).symm
    · apply (gomesPolynomialSecondDerivativeCommutant_generated_iff_preserves_constants K c e).mp
      rw [he]
      exact hM
  · rintro ⟨hD, hC⟩
    let e : GomesPolynomialDerivativePowerCommutant K 2 :=
      ⟨E, (gomesCentralizerSingleton_mem_iff K _ _).mpr hD.eq.symm⟩
    refine ⟨gomesPolynomialDerivativePowerCommutantEquiv K 2 e, ?_, ?_⟩
    · exact (gomesPolynomialSecondDerivativeCommutant_generated_iff_preserves_constants K c e).mpr hC
    · exact gomesTwoChainPolynomialAlgHom_matrix K e

/-- The exact algebra of actual polynomial operators is independent of the reflection center. -/
theorem gomesPolynomialConstantLineAlgebra_center_independent (c d : K) :
    gomesPolynomialConstantLineAlgebra K c = gomesPolynomialConstantLineAlgebra K d := by
  ext E
  rw [gomesPolynomialConstantLineAlgebra_mem_iff, gomesPolynomialConstantLineAlgebra_mem_iff]

end GaloisForLFunctions.HTGeometry
