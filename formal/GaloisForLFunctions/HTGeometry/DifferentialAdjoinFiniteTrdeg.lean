import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicIntegerRelation

/-!
# Finite-jet differential adjunction and finite-transcendence descent

This file isolates the exact finiteness principle needed by Mahler normalization.

If a set of generators has only finitely many distinct differential jets, its differential
adjunction is an ordinary finitely generated field and therefore has finite transcendence degree.
Conversely, differential algebraicity over any derivation-closed intermediate field of finite
transcendence degree descends to the original base field.

The second statement strictly generalizes the finite-transcendence part of one-generator
differential-algebraic transitivity: the intermediate field need not be presented by one
generator, only proved finite-dimensional in the transcendence sense.
-/

open scoped Differential
open Set

namespace GaloisForLFunctions

noncomputable section

/-- A differential field generated by only finitely many distinct jets has finite transcendence
degree over its base. -/
theorem differentialAdjoin_trdeg_lt_aleph0_of_finite_jetSet
    {k K : Type*} [Field k] [Field K] [Algebra k K] [Differential K]
    (s : Set K) (hs : (differentialJetSet s).Finite) :
    Algebra.trdeg k (differentialAdjoin k s) < Cardinal.aleph0 := by
  let F := differentialAdjoin k s
  let T := differentialJetSet s
  let jT : T → F := fun t =>
    ⟨t.1, IntermediateField.subset_adjoin k T t.2⟩
  have hFtop : IntermediateField.adjoin k (Set.range jT) = ⊤ := by
    let J := IntermediateField.adjoin k (Set.range jT)
    apply top_unique
    intro z hz
    change z ∈ J
    let p : ∀ y, y ∈ F → Prop := fun y hy => (⟨y, hy⟩ : F) ∈ J
    change p (z : K) z.2
    refine IntermediateField.adjoin_induction k (p := p) ?_ ?_ ?_ ?_ ?_ z.2
    · intro y hy
      have hFy : y ∈ F := IntermediateField.subset_adjoin k T hy
      change (⟨y, hFy⟩ : F) ∈ J
      simpa [jT] using IntermediateField.subset_adjoin k (Set.range jT)
        (Set.mem_range_self (⟨y, hy⟩ : T))
    · intro c
      change algebraMap k F c ∈ J
      exact IntermediateField.algebraMap_mem J c
    · intro u v hu hv huJ hvJ
      change (⟨u + v, F.add_mem hu hv⟩ : F) ∈ J
      rw [show (⟨u + v, F.add_mem hu hv⟩ : F) =
          (⟨u, hu⟩ : F) + ⟨v, hv⟩ by
        apply Subtype.ext
        rfl]
      exact J.add_mem huJ hvJ
    · intro u hu huJ
      change (⟨u⁻¹, F.inv_mem hu⟩ : F) ∈ J
      rw [show (⟨u⁻¹, F.inv_mem hu⟩ : F) = (⟨u, hu⟩ : F)⁻¹ by
        apply Subtype.ext
        rfl]
      exact J.inv_mem huJ
    · intro u v hu hv huJ hvJ
      change (⟨u * v, F.mul_mem hu hv⟩ : F) ∈ J
      rw [show (⟨u * v, F.mul_mem hu hv⟩ : F) =
          (⟨u, hu⟩ : F) * ⟨v, hv⟩ by
        apply Subtype.ext
        rfl]
      exact J.mul_mem huJ hvJ
  letI : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range jT)) F :=
    HTGeometry.isAlgebraic_adjoin_of_intermediate_adjoin_eq_top jT hFtop
  calc
    Algebra.trdeg k F ≤ Cardinal.mk (Set.range jT) :=
      Algebra.IsAlgebraic.trdeg_le_cardinalMk k (Set.range jT)
    _ ≤ Cardinal.mk T := Cardinal.mk_range_le
    _ < Cardinal.aleph0 := by
      letI : Fintype T := hs.fintype
      exact Cardinal.mk_lt_aleph0

set_option maxHeartbeats 600000 in
/-- **Finite-transcendence differential descent.**  If a derivation-closed intermediate field has
finite transcendence degree over `k`, then every element differentially algebraic over that
intermediate field is already differentially algebraic over `k`. -/
theorem differentialAlgebraicOver_of_intermediate_trdeg_lt_aleph0
    {k K : Type*} [Field k] [Field K] [Algebra k K]
    [Differential k] [Differential K] [DifferentialAlgebra k K] [CharZero K]
    (F : IntermediateField k K) (hFclosed : DerivationClosed F)
    (hFfinite : Algebra.trdeg k F < Cardinal.aleph0) {y : K}
    (hy : DifferentialAlgebraicOver F y) :
    DifferentialAlgebraicOver k y := by
  letI : Differential F := derivationClosedDifferential F hFclosed
  letI : DifferentialAlgebra k F := ⟨fun c => by
    apply Subtype.ext
    exact deriv_algebraMap c⟩
  letI : DifferentialAlgebra F K :=
    ⟨fun c => derivationClosedDifferential_apply F hFclosed c⟩
  let L := differentialAdjoin F ({y} : Set K)
  have hLrelfinite : Algebra.trdeg F L < Cardinal.aleph0 :=
    differentialAdjoin_trdeg_lt_aleph0_of_differentialAlgebraic hy
  letI : Algebra k L := RingHom.toAlgebra
    ((algebraMap F L).comp (algebraMap k F))
  haveI : IsScalarTower k F L := .of_algebraMap_eq fun _ => rfl
  have htr : Algebra.trdeg k F + Algebra.trdeg F L = Algebra.trdeg k L :=
    trdeg_add_eq k F (A := L)
  have hLfinite : Algebra.trdeg k L < Cardinal.aleph0 := by
    rw [← htr]
    exact Cardinal.add_lt_aleph0 hFfinite hLrelfinite
  change ¬ DifferentialIndependent k (fun _ : Unit => y)
  intro hyind
  let yL : L := ⟨y, subset_differentialAdjoin F ({y} : Set K) rfl⟩
  haveI : IsScalarTower k L K := .of_algebraMap_eq fun _ => rfl
  letI : DifferentialAlgebra L K :=
    ⟨fun c => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin F ({y} : Set K)) c⟩
  have hyLind : DifferentialIndependent k (fun _ : Unit => yL) := by
    apply DifferentialIndependent.of_algebraMap (K' := K)
    simpa [yL] using hyind
  unfold DifferentialIndependent at hyLind
  have hjets : AlgebraicIndependent k (fun n : ℕ => differentialJet n yL) := by
    have h := hyLind.comp (fun n : ℕ => ((), n)) (by
      intro m n hmn
      exact congrArg Prod.snd hmn)
    rw [show
      ((fun p : Unit × ℕ => differentialJet p.2 yL) ∘
          fun n : ℕ => ((), n)) =
        (fun n : ℕ => differentialJet n yL) by
      funext n
      rfl] at h
    exact h
  have haleph : Cardinal.aleph0 ≤ Algebra.trdeg k L := by
    have h := hjets.lift_cardinalMk_le_trdeg
    simpa using h
  exact (not_lt_of_ge haleph) hLfinite

end


end GaloisForLFunctions
