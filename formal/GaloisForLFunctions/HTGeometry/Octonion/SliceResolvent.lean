import GaloisForLFunctions.HTGeometry.Octonion.ComplexSlice
import GaloisForLFunctions.HTGeometry.Octonion.Sylvester

namespace GaloisForLFunctions.HTGeometry.Octonion.RealOctonion

noncomputable section

/-- Two elements of the complex slice selected by an imaginary unit commute. -/
theorem complexSlice_mul_comm_formula (J : RealOctonion) (hJ : J * J = -1)
    (a b c d : ℝ) :
    (scalarEmbed a + scalarEmbed b * J) * (scalarEmbed c + scalarEmbed d * J) =
      (scalarEmbed c + scalarEmbed d * J) * (scalarEmbed a + scalarEmbed b * J) := by
  rw [complexSlice_mul_formula J hJ, complexSlice_mul_formula J hJ]
  have hre : a * c - b * d = c * a - d * b := by ring
  have him : a * d + b * c = c * b + d * a := by ring
  rw [hre, him]

/-- Every pair of elements of `C_J` commutes. -/
theorem complexSliceSubmodule_commutes (J : ImaginaryUnit) {x y : RealOctonion}
    (hx : x ∈ complexSliceSubmodule J) (hy : y ∈ complexSliceSubmodule J) : x * y = y * x := by
  rcases hx with ⟨a, b, rfl⟩
  rcases hy with ⟨c, d, rfl⟩
  exact complexSlice_mul_comm_formula J.val J.square a b c d

/-- The selected complex slice is a commutative associative monoid. -/
instance (J : ImaginaryUnit) : CommMonoid (ComplexSlice J) where
  mul_comm x y := by
    apply Subtype.ext
    exact complexSliceSubmodule_commutes J x.2 y.2

/-- A non-real element of `C_J` generates `J` over the reals. -/
theorem imaginaryUnit_mem_generatedSubmodule_of_coeff_ne_zero
    (s q : RealOctonion) (J : ImaginaryUnit) (a b : ℝ)
    (hs : s = scalarEmbed a + scalarEmbed b * J.val) (hb : b ≠ 0) :
    J.val ∈ generatedSubmodule s q := by
  have hmem : s - scalarEmbed a ∈ generatedSubmodule s q :=
    Submodule.sub_mem _ (s_mem_generatedSubmodule s q)
      (scalarEmbed_mem_generatedSubmodule s q a)
  have hscaled : scalarEmbed b⁻¹ * (s - scalarEmbed a) ∈ generatedSubmodule s q := by
    rw [scalarEmbed_mul]
    exact Submodule.smul_mem _ _ hmem
  have hrewrite : scalarEmbed b⁻¹ * (s - scalarEmbed a) = J.val := by
    rw [hs]
    calc
      scalarEmbed b⁻¹ *
          (scalarEmbed a + scalarEmbed b * J.val - scalarEmbed a) =
          scalarEmbed b⁻¹ * (scalarEmbed b * J.val) := by
            rw [add_sub_cancel_left]
      _ = (scalarEmbed b⁻¹ * scalarEmbed b) * J.val :=
        (scalarEmbed_associates b⁻¹ (scalarEmbed b) J.val).symm
      _ = J.val := by rw [← map_mul, inv_mul_cancel₀ hb, map_one, one_mul]
  rwa [hrewrite] at hscaled

/-- If `s` is non-real in `C_J`, the full slice lies in the algebra generated by `s,q`. -/
theorem complexSliceSubmodule_mem_generatedSubmodule_of_coeff_ne_zero
    (s q : RealOctonion) (J : ImaginaryUnit) (a b : ℝ)
    (hs : s = scalarEmbed a + scalarEmbed b * J.val) (hb : b ≠ 0)
    {x : RealOctonion} (hx : x ∈ complexSliceSubmodule J) :
    x ∈ generatedSubmodule s q := by
  rcases hx with ⟨c, d, rfl⟩
  exact Submodule.add_mem _ (scalarEmbed_mem_generatedSubmodule s q c) (by
    rw [scalarEmbed_mul]
    exact Submodule.smul_mem _ _
      (imaginaryUnit_mem_generatedSubmodule_of_coeff_ne_zero s q J a b hs hb))

/-- An element of `C_J` commutes with the conjugate of every other element of `C_J`. -/
theorem complexSliceSubmodule_commutes_star (J : ImaginaryUnit)
    {s x : RealOctonion} (hs : s ∈ complexSliceSubmodule J)
    (hx : x ∈ complexSliceSubmodule J) : x * star s = star s * x := by
  rw [star_eq_scalarEmbed_sub, mul_sub, sub_mul, mul_scalarEmbed, scalarEmbed_mul,
    complexSliceSubmodule_commutes J hx hs]

/-- On a non-real slice, the inverse candidate from Lemma 8.6 is the left-multiplication
expression displayed in equation (8.8). -/
theorem restrictedResolventInverse_eq_sliceFormula_of_coeff_ne_zero
    (s q : RealOctonion) (J : ImaginaryUnit) (a b : ℝ)
    (hs : s = scalarEmbed a + scalarEmbed b * J.val) (hb : b ≠ 0)
    {x : RealOctonion} (hx : x ∈ complexSliceSubmodule J) :
    restrictedResolventInverse s q x =
      (inverse (quadratic s q) * (star s - q)) * x := by
  have hqM : q ∈ generatedSubmodule s q := q_mem_generatedSubmodule s q
  have hxM : x ∈ generatedSubmodule s q :=
    complexSliceSubmodule_mem_generatedSubmodule_of_coeff_ne_zero s q J a b hs hb hx
  have hbarM : star s ∈ generatedSubmodule s q := star_s_mem_generatedSubmodule s q
  have hquadM : quadratic s q ∈ generatedSubmodule s q := quadratic_mem_generatedSubmodule s q
  have hinvM : inverse (quadratic s q) ∈ generatedSubmodule s q :=
    inverse_mem_generatedSubmodule s q _ hquadM
  have hcomm : x * star s = star s * x := by
    apply complexSliceSubmodule_commutes_star J
    · rw [hs]
      exact ⟨a, b, rfl⟩
    · exact hx
  have hfirst : inverse (quadratic s q) * (x * star s) =
      (inverse (quadratic s q) * star s) * x := by
    rw [hcomm]
    exact (sub_eq_zero.mp (associator_eq_zero_of_mem_generatedSubmodule s q
      (inverse (quadratic s q)) (star s) x hinvM hbarM hxM)).symm
  have hsecond : inverse (quadratic s q) * (q * x) =
      (inverse (quadratic s q) * q) * x :=
    (sub_eq_zero.mp (associator_eq_zero_of_mem_generatedSubmodule s q
      (inverse (quadratic s q)) q x hinvM hqM hxM)).symm
  unfold restrictedResolventInverse resolventDifference leftAction rightAction
  rw [mul_sub, hfirst, hsecond, ← sub_mul, ← mul_sub]

/-- The candidate in equation (8.8) is a right inverse on a non-real complex slice. -/
theorem resolventDifference_sliceFormula_apply_of_coeff_ne_zero
    (s q : RealOctonion) (J : ImaginaryUnit) (a b : ℝ)
    (hs : s = scalarEmbed a + scalarEmbed b * J.val) (hb : b ≠ 0)
    {x : RealOctonion} (hx : x ∈ complexSliceSubmodule J)
    (hquad : quadratic s q ≠ 0) :
    resolventDifference s q
      ((inverse (quadratic s q) * (star s - q)) * x) = x := by
  rw [← restrictedResolventInverse_eq_sliceFormula_of_coeff_ne_zero s q J a b hs hb hx]
  exact resolventDifference_restrictedResolventInverse_apply s q x hquad
    (complexSliceSubmodule_mem_generatedSubmodule_of_coeff_ne_zero s q J a b hs hb hx)

/-- Equation (8.8) when spectral parameter is real; it holds for every octonion argument. -/
theorem resolventDifference_sliceFormula_apply_of_scalar
    (a : ℝ) (q x : RealOctonion) (hquad : quadratic (scalarEmbed a) q ≠ 0) :
    resolventDifference (scalarEmbed a) q
      ((inverse (quadratic (scalarEmbed a) q) *
        (star (scalarEmbed a) - q)) * x) = x := by
  let M := generatedSubmodule q x
  have hqM : q ∈ M := by
    simpa only [M] using s_mem_generatedSubmodule q x
  have hxM : x ∈ M := by
    simpa only [M] using q_mem_generatedSubmodule q x
  have hscalarM (r : ℝ) : scalarEmbed r ∈ M := by
    simpa only [M] using scalarEmbed_mem_generatedSubmodule q x r
  have hquadM : quadratic (scalarEmbed a) q ∈ M := by
    unfold quadratic
    exact Submodule.add_mem _
      (Submodule.sub_mem _ (mul_mem_generatedSubmodule q x q q hqM hqM)
        (mul_mem_generatedSubmodule q x _ q (hscalarM _) hqM))
      (hscalarM _)
  have hinvM : inverse (quadratic (scalarEmbed a) q) ∈ M := by
    simpa only [M] using inverse_mem_generatedSubmodule q x
      (quadratic (scalarEmbed a) q) hquadM
  have hdiffM : scalarEmbed a - q ∈ M :=
    Submodule.sub_mem _ (hscalarM _) hqM
  have huM : inverse (quadratic (scalarEmbed a) q) *
      (scalarEmbed a - q) ∈ M :=
    mul_mem_generatedSubmodule q x _ _ hinvM hdiffM
  have hassoc {u v w : RealOctonion} (hu : u ∈ M) (hv : v ∈ M) (hw : w ∈ M) :
      (u * v) * w = u * (v * w) := by
    exact sub_eq_zero.mp (associator_eq_zero_of_mem_generatedSubmodule q x u v w hu hv hw)
  have hxs : x * scalarEmbed a = scalarEmbed a * x := by
    rw [mul_scalarEmbed, scalarEmbed_mul]
  have hleft :
      ((inverse (quadratic (scalarEmbed a) q) *
          (scalarEmbed a - q)) * x) * scalarEmbed a =
        ((inverse (quadratic (scalarEmbed a) q) *
          (scalarEmbed a - q)) * scalarEmbed a) * x := by
    calc
      ((inverse (quadratic (scalarEmbed a) q) *
          (scalarEmbed a - q)) * x) * scalarEmbed a =
          (inverse (quadratic (scalarEmbed a) q) *
            (scalarEmbed a - q)) * (x * scalarEmbed a) :=
        hassoc huM hxM (hscalarM _)
      _ = (inverse (quadratic (scalarEmbed a) q) *
            (scalarEmbed a - q)) * (scalarEmbed a * x) := by rw [hxs]
      _ = ((inverse (quadratic (scalarEmbed a) q) *
            (scalarEmbed a - q)) * scalarEmbed a) * x :=
        (hassoc huM (hscalarM _) hxM).symm
  have hright : q *
      ((inverse (quadratic (scalarEmbed a) q) *
        (scalarEmbed a - q)) * x) =
      (q * (inverse (quadratic (scalarEmbed a) q) *
        (scalarEmbed a - q))) * x :=
    (hassoc hqM huM hxM).symm
  have hqinv : q * inverse (quadratic (scalarEmbed a) q) =
      inverse (quadratic (scalarEmbed a) q) * q :=
    q_commutes_inverse_quadratic (scalarEmbed a) q
  have hqdiff : q * (inverse (quadratic (scalarEmbed a) q) *
      (scalarEmbed a - q)) =
      inverse (quadratic (scalarEmbed a) q) * (q * (scalarEmbed a - q)) := by
    calc
      q * (inverse (quadratic (scalarEmbed a) q) *
          (scalarEmbed a - q)) =
          (q * inverse (quadratic (scalarEmbed a) q)) *
            (scalarEmbed a - q) := (hassoc hqM hinvM hdiffM).symm
      _ = (inverse (quadratic (scalarEmbed a) q) * q) *
            (scalarEmbed a - q) := by rw [hqinv]
      _ = inverse (quadratic (scalarEmbed a) q) *
            (q * (scalarEmbed a - q)) := hassoc hinvM hqM hdiffM
  have hbracket :
      (scalarEmbed a - q) * scalarEmbed a - q * (scalarEmbed a - q) =
        quadratic (scalarEmbed a) q := by
    rw [show quadratic (scalarEmbed a) q =
        q * q - scalarEmbed (2 * a) * q + scalarEmbed (a ^ (2 : ℕ)) by
          unfold quadratic
          simp [normSq_scalarEmbed], sub_mul, mul_sub,
      mul_scalarEmbed (scalarEmbed a) a, mul_scalarEmbed q a,
      (scalarEmbed_mul a (scalarEmbed a)).symm, ← map_mul,
      scalarEmbed_mul (2 * a) q]
    have htwice : (2 * a) • q = a • q + a • q := by
      rw [← add_smul]
      congr 1
      ring
    have hsquare : scalarEmbed (a * a) = scalarEmbed (a ^ (2 : ℕ)) := by
      congr 1
      ring
    rw [htwice, hsquare]
    abel
  unfold resolventDifference leftAction rightAction
  rw [star_scalarEmbed, hleft, hright, hqdiff]
  rw [hassoc hinvM hdiffM (hscalarM _), ← sub_mul, ← mul_sub, hbracket,
    inverse_mul _ hquad]
  simp

/-- Paper equation (8.8): on `C_J`, the inverse of `R_s - L_q` acts by the displayed
left-multiplication formula whenever its quadratic denominator is nonzero. -/
theorem resolventDifference_sliceFormula_apply
    (s q : RealOctonion) (J : ImaginaryUnit) {x : RealOctonion}
    (hs : s ∈ complexSliceSubmodule J) (hx : x ∈ complexSliceSubmodule J)
    (hquad : quadratic s q ≠ 0) :
    resolventDifference s q
      ((inverse (quadratic s q) * (star s - q)) * x) = x := by
  rcases hs with ⟨a, b, hs⟩
  by_cases hb : b = 0
  · have hsreal : s = scalarEmbed a := by
      rw [hs, hb]
      simp
    have hquadreal : quadratic (scalarEmbed a) q ≠ 0 := by
      simpa only [hsreal] using hquad
    subst s
    simpa [hb] using
      resolventDifference_sliceFormula_apply_of_scalar a q x hquadreal
  · exact resolventDifference_sliceFormula_apply_of_coeff_ne_zero s q J a b hs hb hx hquad

/-- The formula in equation (8.8) is the unique global preimage of each slice element. -/
theorem resolventDifference_eq_sliceFormula_iff
    (s q : RealOctonion) (J : ImaginaryUnit) {x y : RealOctonion}
    (hs : s ∈ complexSliceSubmodule J) (hx : x ∈ complexSliceSubmodule J)
    (hquad : quadratic s q ≠ 0) :
    resolventDifference s q y = x ↔
      y = (inverse (quadratic s q) * (star s - q)) * x := by
  have hnot : s ∉ conjugacySphere q := by
    intro hmem
    exact hquad (mem_conjugacySphere_iff_quadratic_eq_zero s q |>.mp hmem)
  constructor
  · intro hy
    apply sylvesterDifferenceLinear_injective_of_not_mem_conjugacySphere s q hnot
    change resolventDifference s q y =
      resolventDifference s q ((inverse (quadratic s q) * (star s - q)) * x)
    rw [hy, resolventDifference_sliceFormula_apply s q J hs hx hquad]
  · intro hy
    rw [hy]
    exact resolventDifference_sliceFormula_apply s q J hs hx hquad

/-- On the real part, the restricted inverse is precisely the left-multiplication
candidate in paper equation (8.9). -/
theorem restrictedResolventInverse_apply_scalar
    (s q : RealOctonion) (r : ℝ) :
    restrictedResolventInverse s q (scalarEmbed r) =
      (inverse (quadratic s q) * (star s - q)) * scalarEmbed r := by
  let M := generatedSubmodule s q
  have hscalar : scalarEmbed r ∈ M := by
    simpa only [M] using scalarEmbed_mem_generatedSubmodule s q r
  have hquad : quadratic s q ∈ M := by
    simpa only [M] using quadratic_mem_generatedSubmodule s q
  have hinv : inverse (quadratic s q) ∈ M := by
    simpa only [M] using inverse_mem_generatedSubmodule s q _ hquad
  have hdiff : star s - q ∈ M := by
    simpa only [M] using Submodule.sub_mem (generatedSubmodule s q)
      (star_s_mem_generatedSubmodule s q) (q_mem_generatedSubmodule s q)
  have hcomm : scalarEmbed r * star s = star s * scalarEmbed r := by
    rw [scalarEmbed_mul, mul_scalarEmbed]
  unfold restrictedResolventInverse resolventDifference leftAction rightAction
  calc
    inverse (quadratic s q) *
        (scalarEmbed r * star s - q * scalarEmbed r) =
      inverse (quadratic s q) * ((star s - q) * scalarEmbed r) := by
        rw [hcomm, sub_mul]
    _ = (inverse (quadratic s q) * (star s - q)) * scalarEmbed r :=
      (sub_eq_zero.mp (associator_eq_zero_of_mem_generatedSubmodule s q
        (inverse (quadratic s q)) (star s - q) (scalarEmbed r) hinv hdiff hscalar)).symm

/-- The left-multiplication expression in paper equation (8.9) is an inverse of
`R_s - L_q` on the real part whenever its quadratic denominator is nonzero. -/
theorem resolventDifference_regularInverse_apply_scalar
    (s q : RealOctonion) (r : ℝ) (hquad : quadratic s q ≠ 0) :
    resolventDifference s q
      ((inverse (quadratic s q) * (star s - q)) * scalarEmbed r) = scalarEmbed r := by
  rw [← restrictedResolventInverse_apply_scalar]
  exact resolventDifference_restrictedResolventInverse_apply s q (scalarEmbed r) hquad
    (scalarEmbed_mem_generatedSubmodule s q r)

end
end GaloisForLFunctions.HTGeometry.Octonion.RealOctonion
