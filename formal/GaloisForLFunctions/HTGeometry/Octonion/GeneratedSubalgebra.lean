import GaloisForLFunctions.HTGeometry.Octonion.Artin
import GaloisForLFunctions.HTGeometry.Octonion.ResolventIdentity

namespace GaloisForLFunctions.HTGeometry.Octonion.RealOctonion

noncomputable section

/-- The real linear carrier generated by two octonions.  The theorems below establish both
multiplicative closure and associativity on this carrier, so it is the two-generated associative
subalgebra needed in Lemma 8.4. -/
def generatedSubmodule (s q : RealOctonion) : Submodule ℝ RealOctonion :=
  Submodule.span ℝ (Set.range (ArtinWord.eval s q) ∪ Set.range scalarEmbed)

theorem associator_eq_zero_of_mem_generatingSet (s q x y z : RealOctonion)
    (hx : x ∈ Set.range (ArtinWord.eval s q) ∪ Set.range scalarEmbed)
    (hy : y ∈ Set.range (ArtinWord.eval s q) ∪ Set.range scalarEmbed)
    (hz : z ∈ Set.range (ArtinWord.eval s q) ∪ Set.range scalarEmbed) :
    IsAlternative.associator x y z = 0 := by
  rcases hx with ⟨u, rfl⟩ | ⟨r, rfl⟩
  · rcases hy with ⟨v, rfl⟩ | ⟨t, rfl⟩
    · rcases hz with ⟨w, rfl⟩ | ⟨a, rfl⟩
      · exact ArtinWord.all_words_associate s q u v w
      · exact associator_scalarEmbed_right _ _ _
    · rcases hz with ⟨w, rfl⟩ | ⟨a, rfl⟩
      · exact associator_scalarEmbed_mid _ _ _
      · exact associator_scalarEmbed_mid _ _ _
  · rcases hy with ⟨v, rfl⟩ | ⟨t, rfl⟩
    · exact associator_scalarEmbed_left _ _ _
    · exact associator_scalarEmbed_left _ _ _

/-- Artin's theorem on the real subalgebra generated by two concrete octonions. -/
theorem associator_eq_zero_of_mem_generatedSubmodule (s q x y z : RealOctonion)
    (hx : x ∈ generatedSubmodule s q)
    (hy : y ∈ generatedSubmodule s q)
    (hz : z ∈ generatedSubmodule s q) :
    IsAlternative.associator x y z = 0 := by
  unfold generatedSubmodule at hx hy hz
  induction hx using Submodule.span_induction with
  | mem x hx =>
    induction hy using Submodule.span_induction with
    | mem y hy =>
      induction hz using Submodule.span_induction with
      | mem z hz => exact associator_eq_zero_of_mem_generatingSet s q x y z hx hy hz
      | zero => simp [IsAlternative.associator]
      | add z w _ _ hz hw =>
        rw [IsAlternative.associator_add_right, hz, hw]
        simp
      | smul r z _ hz =>
        rw [associator_smul_right, hz]
        simp
    | zero => simp [IsAlternative.associator]
    | add y z _ _ hy hz =>
      rw [IsAlternative.associator_add_mid, hy, hz]
      simp
    | smul r y _ hy =>
      rw [associator_smul_mid, hy]
      simp
  | zero => simp [IsAlternative.associator]
  | add x y _ _ hx hy =>
    rw [IsAlternative.associator_add_left, hx, hy]
    simp
  | smul r x _ hx =>
    rw [associator_smul_left, hx]
    simp

/-- The generated carrier is closed under octonion multiplication. -/
theorem mul_mem_generatedSubmodule (s q x y : RealOctonion)
    (hx : x ∈ generatedSubmodule s q)
    (hy : y ∈ generatedSubmodule s q) :
    x * y ∈ generatedSubmodule s q := by
  unfold generatedSubmodule at hx hy ⊢
  induction hx using Submodule.span_induction with
  | mem x hx =>
    induction hy using Submodule.span_induction with
    | mem y hy =>
      rcases hx with ⟨u, rfl⟩ | ⟨r, rfl⟩
      · rcases hy with ⟨v, rfl⟩ | ⟨t, rfl⟩
        · exact Submodule.subset_span (Or.inl ⟨ArtinWord.prod u v, rfl⟩)
        · rw [mul_scalarEmbed]
          exact Submodule.smul_mem _ _
            (Submodule.subset_span (Or.inl ⟨u, rfl⟩))
      · rcases hy with ⟨v, rfl⟩ | ⟨t, rfl⟩
        · rw [scalarEmbed_mul]
          exact Submodule.smul_mem _ _
            (Submodule.subset_span (Or.inl ⟨v, rfl⟩))
        · exact Submodule.subset_span (Or.inr ⟨r * t, by rw [map_mul]⟩)
    | zero => simp
    | add y z _ _ hy hz =>
      rw [mul_add]
      exact Submodule.add_mem _ hy hz
    | smul r y _ hy =>
      rw [mul_smul_comm]
      exact Submodule.smul_mem _ _ hy
  | zero => simp
  | add x y _ _ hx hy =>
    rw [add_mul]
    exact Submodule.add_mem _ hx hy
  | smul r x _ hx =>
    rw [smul_mul_assoc]
    exact Submodule.smul_mem _ _ hx

theorem scalarEmbed_mem_generatedSubmodule (s q : RealOctonion) (r : ℝ) :
    scalarEmbed r ∈ generatedSubmodule s q := by
  unfold generatedSubmodule
  exact Submodule.subset_span (Or.inr ⟨r, rfl⟩)

theorem s_mem_generatedSubmodule (s q : RealOctonion) : s ∈ generatedSubmodule s q := by
  unfold generatedSubmodule
  exact Submodule.subset_span (Or.inl ⟨ArtinWord.atom false, rfl⟩)

theorem q_mem_generatedSubmodule (s q : RealOctonion) : q ∈ generatedSubmodule s q := by
  unfold generatedSubmodule
  exact Submodule.subset_span (Or.inl ⟨ArtinWord.atom true, rfl⟩)

theorem star_s_mem_generatedSubmodule (s q : RealOctonion) :
    star s ∈ generatedSubmodule s q := by
  rw [star_eq_scalarEmbed_sub]
  exact Submodule.sub_mem _ (scalarEmbed_mem_generatedSubmodule s q _)
    (s_mem_generatedSubmodule s q)

/-- The associator correction in Lemma 8.4 vanishes on the two-generated subalgebra. -/
theorem leftRightCommutator_eq_zero_of_mem_generatedSubmodule (s q x : RealOctonion)
    (hx : x ∈ generatedSubmodule s q) : leftRightCommutator q (star s) x = 0 := by
  have hassoc := associator_eq_zero_of_mem_generatedSubmodule s q q x (star s)
    (q_mem_generatedSubmodule s q) hx (star_s_mem_generatedSubmodule s q)
  unfold leftRightCommutator leftAction rightAction
  unfold IsAlternative.associator at hassoc
  rw [show q * (x * star s) - q * x * star s =
      -(q * x * star s - q * (x * star s)) by abel, hassoc]
  simp

/-- Lemma 8.4 equation (8.6), pointwise on the associative subalgebra generated by `s,q`. -/
theorem uncorrected_resolvent_factorization_of_mem_generatedSubmodule
    (s q x : RealOctonion) (hx : x ∈ generatedSubmodule s q) :
    rightAction s (rightAction (star s) x - leftAction q x)
        - leftAction q (rightAction (star s) x - leftAction q x) =
      leftAction (quadratic s q) x := by
  have h := quadratic_leftAction_eq_resolvent_factorization s q x
  rw [leftRightCommutator_eq_zero_of_mem_generatedSubmodule s q x hx] at h
  simpa using h

/-- The subtype carrying the two-generated associative octonion subalgebra. -/
def GeneratedSubalgebra (s q : RealOctonion) := {x : RealOctonion // x ∈ generatedSubmodule s q}

/-- Operator form of equation (8.6) on the two-generated associative octonion subalgebra. -/
theorem uncorrected_resolvent_factorization_on_GeneratedSubalgebra (s q : RealOctonion) :
    (fun x : GeneratedSubalgebra s q =>
      rightAction s (rightAction (star s) x.1 - leftAction q x.1)
        - leftAction q (rightAction (star s) x.1 - leftAction q x.1)) =
      fun x => leftAction (quadratic s q) x.1 := by
  funext x
  exact uncorrected_resolvent_factorization_of_mem_generatedSubmodule s q x.1 x.2

end
end GaloisForLFunctions.HTGeometry.Octonion.RealOctonion
