import GaloisForLFunctions.HTGeometry.Octonion.Basic

namespace GaloisForLFunctions.HTGeometry.Octonion.RealOctonion

noncomputable section

/-- An octonionic imaginary unit, specified by its square. -/
structure ImaginaryUnit where
  val : RealOctonion
  square : val * val = -1

/-- Multiplication in the real plane generated by an octonionic imaginary unit. -/
theorem complexSlice_mul_formula (J : RealOctonion) (hJ : J * J = -1)
    (a b c d : ℝ) :
    (scalarEmbed a + scalarEmbed b * J) * (scalarEmbed c + scalarEmbed d * J) =
      scalarEmbed (a * c - b * d) + scalarEmbed (a * d + b * c) * J := by
  simp only [add_mul, mul_add]
  have had : scalarEmbed a * (scalarEmbed d * J) = scalarEmbed (a * d) * J := by
    calc
      scalarEmbed a * (scalarEmbed d * J) = a • (d • J) := by
        rw [scalarEmbed_mul, scalarEmbed_mul]
      _ = (a * d) • J := by rw [smul_smul]
      _ = scalarEmbed (a * d) * J := (scalarEmbed_mul _ _).symm
  have hbc : (scalarEmbed b * J) * scalarEmbed c = scalarEmbed (b * c) * J := by
    calc
      (scalarEmbed b * J) * scalarEmbed c = (b • J) * scalarEmbed c := by
        rw [scalarEmbed_mul]
      _ = c • (b • J) := by rw [mul_scalarEmbed]
      _ = (b * c) • J := by rw [smul_smul, mul_comm]
      _ = scalarEmbed (b * c) * J := (scalarEmbed_mul _ _).symm
  have hbd : (scalarEmbed b * J) * (scalarEmbed d * J) = scalarEmbed (-(b * d)) := by
    calc
      (scalarEmbed b * J) * (scalarEmbed d * J) = (b • J) * (d • J) := by
        rw [scalarEmbed_mul, scalarEmbed_mul]
      _ = b • (J * (d • J)) := by rw [smul_mul_assoc]
      _ = b • (d • (J * J)) := by rw [mul_smul_comm]
      _ = (b * d) • (J * J) := by rw [smul_smul]
      _ = (b * d) • (-1) := by rw [hJ]
      _ = scalarEmbed (-(b * d)) := by
        rw [← scalarEmbed_mul, show (-1 : RealOctonion) = -(1 : RealOctonion) by simp,
          mul_neg, mul_one, ← map_neg]
  rw [← map_mul, had, hbc, hbd]
  rw [map_neg]
  have hscalar : scalarEmbed (a * c) - scalarEmbed (b * d) =
      scalarEmbed (a * c - b * d) := by rw [← map_sub]
  have hJsum : scalarEmbed (a * d) * J + scalarEmbed (b * c) * J =
      scalarEmbed (a * d + b * c) * J := by
    rw [scalarEmbed_mul, scalarEmbed_mul, ← add_smul, ← scalarEmbed_mul]
  calc
    scalarEmbed (a * c) + scalarEmbed (b * c) * J +
        (scalarEmbed (a * d) * J - scalarEmbed (b * d)) =
      (scalarEmbed (a * c) - scalarEmbed (b * d)) +
        (scalarEmbed (a * d) * J + scalarEmbed (b * c) * J) := by abel
    _ = scalarEmbed (a * c - b * d) + scalarEmbed (a * d + b * c) * J := by
      rw [hscalar, hJsum]

end
end GaloisForLFunctions.HTGeometry.Octonion.RealOctonion
