import GaloisForLFunctions.HTGeometry.Octonion.Basic

namespace GaloisForLFunctions.HTGeometry.Octonion.RealOctonion

noncomputable section

/-- An octonionic imaginary unit, specified by its square. -/
structure ImaginaryUnit where
  val : RealOctonion
  square : val * val = -1

/-- Multiplication in the real plane generated by an octonionic imaginary unit. -/
theorem complexSlice_mul_formula (J : RealOctonion) (hJ : J * J = -1)
    (a b c d : ℝ) :
    (scalarEmbed a + scalarEmbed b * J) * (scalarEmbed c + scalarEmbed d * J) =
      scalarEmbed (a * c - b * d) + scalarEmbed (a * d + b * c) * J := by
  simp only [add_mul, mul_add]
  have had : scalarEmbed a * (scalarEmbed d * J) = scalarEmbed (a * d) * J := by
    calc
      scalarEmbed a * (scalarEmbed d * J) = a • (d • J) := by
        rw [scalarEmbed_mul, scalarEmbed_mul]
      _ = (a * d) • J := by rw [smul_smul]
      _ = scalarEmbed (a * d) * J := (scalarEmbed_mul _ _).symm
  have hbc : (scalarEmbed b * J) * scalarEmbed c = scalarEmbed (b * c) * J := by
    calc
      (scalarEmbed b * J) * scalarEmbed c = (b • J) * scalarEmbed c := by
        rw [scalarEmbed_mul]
      _ = c • (b • J) := by rw [mul_scalarEmbed]
      _ = (b * c) • J := by rw [smul_smul, mul_comm]
      _ = scalarEmbed (b * c) * J := (scalarEmbed_mul _ _).symm
  have hbd : (scalarEmbed b * J) * (scalarEmbed d * J) = scalarEmbed (-(b * d)) := by
    calc
      (scalarEmbed b * J) * (scalarEmbed d * J) = (b • J) * (d • J) := by
        rw [scalarEmbed_mul, scalarEmbed_mul]
      _ = b • (J * (d • J)) := by rw [smul_mul_assoc]
      _ = b • (d • (J * J)) := by rw [mul_smul_comm]
      _ = (b * d) • (J * J) := by rw [smul_smul]
      _ = (b * d) • (-1) := by rw [hJ]
      _ = scalarEmbed (-(b * d)) := by
        rw [← scalarEmbed_mul, show (-1 : RealOctonion) = -(1 : RealOctonion) by simp,
          mul_neg, mul_one, ← map_neg]
  rw [← map_mul, had, hbc, hbd]
  rw [map_neg]
  have hscalar : scalarEmbed (a * c) - scalarEmbed (b * d) =
      scalarEmbed (a * c - b * d) := by rw [← map_sub]
  have hJsum : scalarEmbed (a * d) * J + scalarEmbed (b * c) * J =
      scalarEmbed (a * d + b * c) * J := by
    rw [scalarEmbed_mul, scalarEmbed_mul, ← add_smul, ← scalarEmbed_mul]
  calc
    scalarEmbed (a * c) + scalarEmbed (b * c) * J +
        (scalarEmbed (a * d) * J - scalarEmbed (b * d)) =
      (scalarEmbed (a * c) - scalarEmbed (b * d)) +
        (scalarEmbed (a * d) * J + scalarEmbed (b * c) * J) := by abel
    _ = scalarEmbed (a * c - b * d) + scalarEmbed (a * d + b * c) * J := by
      rw [hscalar, hJsum]

/-- The real plane generated by one imaginary unit is associative. -/
theorem complexSlice_mul_assoc_formula (J : RealOctonion) (hJ : J * J = -1)
    (a b c d e f : ℝ) :
    ((scalarEmbed a + scalarEmbed b * J) * (scalarEmbed c + scalarEmbed d * J)) *
        (scalarEmbed e + scalarEmbed f * J) =
      (scalarEmbed a + scalarEmbed b * J) *
        ((scalarEmbed c + scalarEmbed d * J) * (scalarEmbed e + scalarEmbed f * J)) := by
  rw [complexSlice_mul_formula J hJ, complexSlice_mul_formula J hJ,
    complexSlice_mul_formula J hJ, complexSlice_mul_formula J hJ]
  have hre : (a * c - b * d) * e - (a * d + b * c) * f =
      a * (c * e - d * f) - b * (c * f + d * e) := by ring
  have him : (a * c - b * d) * f + (a * d + b * c) * e =
      a * (c * f + d * e) + b * (c * e - d * f) := by ring
  rw [hre, him]

/-- The real two-plane spanned by `1` and an imaginary unit. -/
def complexSliceSubmodule (J : ImaginaryUnit) : Submodule ℝ RealOctonion where
  carrier := {x | ∃ a b : ℝ, x = scalarEmbed a + scalarEmbed b * J.val}
  zero_mem' := ⟨0, 0, by simp⟩
  add_mem' {x y} hx hy := by
    rcases hx with ⟨a, b, rfl⟩
    rcases hy with ⟨c, d, rfl⟩
    refine ⟨a + c, b + d, ?_⟩
    rw [map_add, map_add, add_mul]
    abel
  smul_mem' r x hx := by
    rcases hx with ⟨a, b, rfl⟩
    refine ⟨r * a, r * b, ?_⟩
    calc
      r • (scalarEmbed a + scalarEmbed b * J.val) =
          scalarEmbed r * (scalarEmbed a + scalarEmbed b * J.val) :=
            (scalarEmbed_mul _ _).symm
      _ = scalarEmbed (r * a) + (scalarEmbed r * scalarEmbed b) * J.val := by
            rw [mul_add, ← map_mul, scalarEmbed_associates]
      _ = scalarEmbed (r * a) + scalarEmbed (r * b) * J.val := by
            rw [← map_mul]

/-- The associative copy of the complex plane selected by an imaginary unit. -/
def ComplexSlice (J : ImaginaryUnit) := complexSliceSubmodule J

theorem complexSliceSubmodule_mul_mem (J : ImaginaryUnit) {x y : RealOctonion}
    (hx : x ∈ complexSliceSubmodule J) (hy : y ∈ complexSliceSubmodule J) :
    x * y ∈ complexSliceSubmodule J := by
  rcases hx with ⟨a, b, rfl⟩
  rcases hy with ⟨c, d, rfl⟩
  rw [complexSlice_mul_formula J.val J.square]
  exact ⟨a * c - b * d, a * d + b * c, rfl⟩

instance (J : ImaginaryUnit) : Mul (ComplexSlice J) where
  mul x y := ⟨x.1 * y.1, complexSliceSubmodule_mul_mem J x.2 y.2⟩

theorem ComplexSlice_mul_val (J : ImaginaryUnit) (x y : ComplexSlice J) :
    (x * y).1 = x.1 * y.1 := rfl

theorem complexSlice_mul_assoc (J : ImaginaryUnit)
    (x y z : ComplexSlice J) : (x * y) * z = x * (y * z) := by
  apply Subtype.ext
  rcases x.2 with ⟨a, b, ha⟩
  rcases y.2 with ⟨c, d, hc⟩
  rcases z.2 with ⟨e, f, he⟩
  change ((x.1 * y.1) * z.1) = x.1 * (y.1 * z.1)
  rw [ha, hc, he]
  exact complexSlice_mul_assoc_formula J.val J.square a b c d e f

instance (J : ImaginaryUnit) : One (ComplexSlice J) where
  one := ⟨1, ⟨1, 0, by simp⟩⟩

theorem ComplexSlice_one_val (J : ImaginaryUnit) : (1 : ComplexSlice J).1 = 1 := rfl

instance (J : ImaginaryUnit) : Monoid (ComplexSlice J) where
  mul_assoc := complexSlice_mul_assoc J
  one_mul x := by
    apply Subtype.ext
    change 1 * x.1 = x.1
    rw [one_mul]
  mul_one x := by
    apply Subtype.ext
    change x.1 * 1 = x.1
    rw [mul_one]

end
end GaloisForLFunctions.HTGeometry.Octonion.RealOctonion
