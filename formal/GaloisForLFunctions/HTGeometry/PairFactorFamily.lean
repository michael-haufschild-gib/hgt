import GaloisForLFunctions.HTGeometry.RationalCoordinateFactor

/-!
# Product laws with abstract two-coordinate factors

The two-coordinate peel never uses that a factor is a *polynomial* in two consecutive coordinates.
What it uses is that the factor is a nonzero element of the subfield generated by the coordinates up
to `j+1` which no other coordinate sees, and — at the top level only — that it is affine in the
newest coordinate with coefficients one level down.

Abstracting to that interface admits the rational factors of a linear first-order equation with
**rational** coefficients,

`h' = (a(z)/α(z))·h + (b(z)/β(z))`,   factor  `(a β·X_(j+1) + b α)/(α β)`,

which is the class Malmquist's theorem reduces the general solved first-order equation to.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

/-- A family of factors of a two-coordinate product law: the `j`-th factor is nonzero, lives one
level up, and is invisible to every coordinate other than `j` and `j+1`. -/
structure PairFam where
  /-- The factor at level `j`, occupying the coordinates `j` and `j+1`. -/
  fac : ℕ → CascadeField
  fac_ne_zero : ∀ j, fac j ≠ 0
  fac_mem : ∀ j, fac j ∈ coordField (j + 1)
  fpderiv_fac_of_ne : ∀ {j k : ℕ}, k ≠ j → k ≠ j + 1 → fpderiv k (fac j) = 0

namespace PairFam

variable (F : PairFam)

/-! ## The jets -/

/-- The jet of the `k`-th coordinate: the product of the factors below it. -/
noncomputable def jet (k : ℕ) : CascadeField := ∏ j ∈ Finset.range k, F.fac j

@[simp] theorem jet_zero : F.jet 0 = 1 := by simp [jet]

theorem jet_succ (k : ℕ) : F.jet (k + 1) = F.jet k * F.fac k := by
  rw [jet, jet, Finset.prod_range_succ]

theorem jet_ne_zero (k : ℕ) : F.jet k ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun j _ => F.fac_ne_zero j

theorem jet_mem_coordField {k m : ℕ} (h : k ≤ m) : F.jet k ∈ coordField m := by
  refine prod_mem fun j hj => ?_
  have hjk : j < k := Finset.mem_range.mp hj
  exact coordField_mono (by omega) (F.fac_mem j)

theorem fpderiv_jet_of_gt {k l : ℕ} (h : l < k) : fpderiv k (F.jet l) = 0 := by
  have hmem := F.jet_mem_coordField (le_refl l)
  rw [mem_coordField_iff] at hmem
  exact hmem k h

/-! ## The law -/

/-- The product law on the polynomial ring. -/
noncomputable def derivationPoly : Derivation ℂ (MvPolynomial ℕ ℂ) CascadeField :=
  MvPolynomial.mkDerivation ℂ fun k => F.jet k

@[simp] theorem derivationPoly_X (k : ℕ) : F.derivationPoly (MvPolynomial.X k) = F.jet k :=
  MvPolynomial.mkDerivation_X ℂ _ k

/-- **The product law on the rational model.** -/
noncomputable def law : Derivation ℂ CascadeField CascadeField :=
  fractionRingDerivation F.derivationPoly

@[simp] theorem law_fx (k : ℕ) : F.law (fx k) = F.jet k := by
  rw [law, fx, fractionRingDerivation_algebraMap, derivationPoly_X]

/-! ## The responses -/

/-- The response of the jet at level `l` to the coordinate `k`. -/
noncomputable def response (k l : ℕ) : CascadeField := fpderiv k (F.jet l)

theorem response_of_lt {k l : ℕ} (h : l < k) : F.response k l = 0 := F.fpderiv_jet_of_gt h

theorem response_mem_coordField {k l m : ℕ} (h : l ≤ m) : F.response k l ∈ coordField m :=
  fpderiv_mem_coordField k (F.jet_mem_coordField h)

/-! ## The logarithmic border row -/

/-- The gradient of `log fac j` at the coordinate `l`. -/
noncomputable def logTerm (j l : ℕ) : CascadeField := fpderiv l (F.fac j) / F.fac j

theorem logTerm_eq_zero_of_ne {j l : ℕ} (h0 : l ≠ j) (h1 : l ≠ j + 1) : F.logTerm j l = 0 := by
  rw [logTerm, F.fpderiv_fac_of_ne h0 h1, zero_div]

theorem fpderiv_logTerm_symm (j k l : ℕ) :
    fpderiv k (F.logTerm j l) = fpderiv l (F.logTerm j k) :=
  fpderiv_logDeriv_symm k l (F.fac j)

theorem logTerm_mem_coordField {j m : ℕ} (h : j + 1 ≤ m) (l : ℕ) :
    F.logTerm j l ∈ coordField m := by
  have hmem : F.fac j ∈ coordField m := coordField_mono h (F.fac_mem j)
  exact div_mem (fpderiv_mem_coordField l hmem) hmem

/-- The border row at level `m`: the gradient of `∑_(j<m) log fac j`. -/
noncomputable def logBorder (m l : ℕ) : CascadeField := ∑ j ∈ Finset.range m, F.logTerm j l

@[simp] theorem logBorder_zero (l : ℕ) : F.logBorder 0 l = 0 := by simp [logBorder]

theorem logBorder_succ (m l : ℕ) :
    F.logBorder (m + 1) l = F.logBorder m l + F.logTerm m l := by
  rw [logBorder, logBorder, Finset.sum_range_succ]

theorem logBorder_eq_zero_of_gt {m l : ℕ} (h : m < l) : F.logBorder m l = 0 := by
  refine Finset.sum_eq_zero fun j hj => ?_
  have hjm : j < m := Finset.mem_range.mp hj
  exact F.logTerm_eq_zero_of_ne (by omega) (by omega)

theorem logBorder_of_le {m m' k : ℕ} (h : m ≤ m') (hk : k + 1 ≤ m) :
    F.logBorder m' k = F.logBorder m k := by
  have hsub : Finset.range m ⊆ Finset.range m' := fun x hx =>
    Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hx) h)
  refine (Finset.sum_subset hsub fun j hj hjn => ?_).symm
  have hjm : ¬ j < m := fun hc => hjn (Finset.mem_range.mpr hc)
  exact F.logTerm_eq_zero_of_ne (by omega) (by omega)

/-- **The border row is a closed form.** -/
theorem fpderiv_logBorder_symm (m k l : ℕ) :
    fpderiv k (F.logBorder m l) = fpderiv l (F.logBorder m k) := by
  rw [logBorder, logBorder, map_sum, map_sum]
  exact Finset.sum_congr rfl fun j _ => F.fpderiv_logTerm_symm j k l

theorem logBorder_mem_coordField (m l : ℕ) : F.logBorder m l ∈ coordField m := by
  refine sum_mem fun j hj => ?_
  have hjm : j < m := Finset.mem_range.mp hj
  exact F.logTerm_mem_coordField (by omega) l

/-- **Every response is the border row of its own level, times the jet.** -/
theorem response_eq_logBorder (k l : ℕ) : F.response k l = F.logBorder l k * F.jet l := by
  induction l with
  | zero => simp [response, jet_zero]
  | succ l ih =>
      have hF : F.fac l ≠ 0 := F.fac_ne_zero l
      rw [response, F.jet_succ, Derivation.leibniz]
      simp only [smul_eq_mul]
      rw [show fpderiv k (F.jet l) = F.response k l from rfl, ih, F.logBorder_succ, logTerm,
        div_eq_mul_inv]
      field_simp
      ring

end PairFam

end GaloisForLFunctions.HTGeometry
