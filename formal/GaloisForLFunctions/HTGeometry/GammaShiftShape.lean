import GaloisForLFunctions.HTGeometry.GammaShapeInteger
import GaloisForLFunctions.HTGeometry.UniformShapeBounds

/-!
# The boundary shape of a finite real Gamma-shift field

For a field generated by translates `Γ(s + λ_i)` with pairwise incongruent real shifts, the leading
behaviour of an element is `c·Γ(s+λ_1)^d·s^ω·(log s)^b` where the argument exponent `ω` is *real* —
it lies in the group generated by the shifts — while the `Γ`-degree and the logarithm degree stay
integral.

This file carries that shape and its ordering: a smaller `Γ`-degree dominates, then a larger real
argument exponent, then a larger logarithm exponent.  Only the real exponent is new; the three decay
mechanisms are the ones the one-Gamma law already uses, with `rpow` in place of `zpow`.
-/

open Filter Set Topology Function Real

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {σ lam : ℝ}

/-- The boundary shape of the shifted law: `Γ(s+λ)^d·s^ω·(log s)^b` on a vertical line, with a real
argument exponent. -/
noncomputable def gammaShiftShape (lam σ : ℝ) (d : ℤ) (ω : ℝ) (b : ℤ) (t : ℝ) : ℂ :=
  gammaLine (σ + lam) t ^ d
    * (((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ) * vertLog t ^ b)

/-- A real power of the vertical argument has the corresponding real power of its modulus. -/
theorem norm_cpow_real_vertical (σ ω t : ℝ) :
    ‖((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ)‖
      = ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω :=
  Complex.norm_cpow_real _ _

/-- The vertical argument has modulus at least `t`. -/
theorem norm_vertical_ge_height (σ t : ℝ) : t ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ := by
  have him : ((σ : ℂ) + (t : ℂ) * Complex.I).im = t := by simp
  calc t = ((σ : ℂ) + (t : ℂ) * Complex.I).im := him.symm
    _ ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ := Complex.im_le_norm _

/-- The vertical argument is nonzero beyond a positive height. -/
theorem vertical_ne_zero_of_pos {t : ℝ} (ht : 0 < t) :
    ((σ : ℂ) + (t : ℂ) * Complex.I) ≠ 0 := by
  intro h0
  have him : ((σ : ℂ) + (t : ℂ) * Complex.I).im = t := by simp
  rw [h0] at him
  simp only [Complex.zero_im] at him
  linarith

/-- A real power of the vertical argument is nonzero beyond a positive height. -/
theorem cpow_real_vertical_ne_zero {ω : ℝ} {t : ℝ} (ht : 0 < t) :
    ((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ) ≠ 0 := by
  have hpos : 0 < ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ :=
    norm_pos_iff.mpr (vertical_ne_zero_of_pos (σ := σ) ht)
  refine norm_pos_iff.mp ?_
  rw [norm_cpow_real_vertical]
  exact Real.rpow_pos_of_pos hpos ω

/-- The vertical logarithm is nonzero beyond a fixed height. -/
theorem vertLog_ne_zero_of_three_le {t : ℝ} (ht : 3 ≤ t) : vertLog t ≠ 0 := by
  intro h0
  have hre : (vertLog t).re = Real.log t := by
    rw [vertLog]
    simp
  rw [h0] at hre
  simp only [Complex.zero_re] at hre
  have hlog1 : (1 : ℝ) ≤ Real.log t := by
    have hexp : Real.exp 1 ≤ t := le_trans (le_of_lt Real.exp_one_lt_d9) (by linarith)
    have := Real.log_le_log (Real.exp_pos 1) hexp
    rwa [Real.log_exp] at this
  linarith

/-- The shape is nonzero beyond a fixed height. -/
theorem gammaShiftShape_ne_zero (hσ : 0 < σ + lam) {t : ℝ} (ht : 3 ≤ t) (d : ℤ) (ω : ℝ) (b : ℤ) :
    gammaShiftShape lam σ d ω b t ≠ 0 := by
  have htpos : (0 : ℝ) < t := by linarith
  rw [gammaShiftShape]
  exact mul_ne_zero (zpow_ne_zero _ (gammaLine_ne_zero hσ t))
    (mul_ne_zero (cpow_real_vertical_ne_zero (σ := σ) htpos)
      (zpow_ne_zero _ (vertLog_ne_zero_of_three_le ht)))

/-- The shape multiplies by adding all three exponents. -/
theorem gammaShiftShape_mul (hσ : 0 < σ + lam) {t : ℝ} (ht : 3 ≤ t) (d : ℤ) (ω : ℝ) (b : ℤ)
    (d' : ℤ) (ω' : ℝ) (b' : ℤ) :
    gammaShiftShape lam σ d ω b t * gammaShiftShape lam σ d' ω' b' t
      = gammaShiftShape lam σ (d + d') (ω + ω') (b + b') t := by
  have htpos : (0 : ℝ) < t := by linarith
  have hΓ : gammaLine (σ + lam) t ≠ 0 := gammaLine_ne_zero hσ t
  have hs : ((σ : ℂ) + (t : ℂ) * Complex.I) ≠ 0 := vertical_ne_zero_of_pos (σ := σ) htpos
  have hL : vertLog t ≠ 0 := vertLog_ne_zero_of_three_le ht
  have hcpow : ((σ : ℂ) + (t : ℂ) * Complex.I) ^ (((ω : ℝ) + (ω' : ℝ) : ℝ) : ℂ)
      = ((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ)
        * ((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω' : ℂ) := by
    rw [Complex.ofReal_add, Complex.cpow_add _ _ hs]
  rw [gammaShiftShape, gammaShiftShape, gammaShiftShape, zpow_add₀ hΓ, zpow_add₀ hL, hcpow]
  ring

/-- The quotient of two shapes subtracts all three exponents. -/
theorem gammaShiftShape_div (hσ : 0 < σ + lam) {t : ℝ} (ht : 3 ≤ t) (d : ℤ) (ω : ℝ) (b : ℤ)
    (d' : ℤ) (ω' : ℝ) (b' : ℤ) :
    gammaShiftShape lam σ d ω b t / gammaShiftShape lam σ d' ω' b' t
      = gammaShiftShape lam σ (d - d') (ω - ω') (b - b') t := by
  have hne : gammaShiftShape lam σ d' ω' b' t ≠ 0 := gammaShiftShape_ne_zero hσ ht _ _ _
  refine (div_eq_iff hne).mpr ?_
  rw [gammaShiftShape_mul hσ ht]
  ring_nf

/-- The argument and logarithm factors have polynomial growth on the line. -/
theorem hasPolyGrowthLine_cpow_mul_vertLog (σ ω : ℝ) (b : ℤ) :
    HasPolyGrowthLine (fun t : ℝ =>
      ((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ) * vertLog t ^ b) := by
  classical
  refine ⟨⌈max ω 0⌉₊ + b.toNat, (|σ| + 1) ^ ⌈max ω 0⌉₊ * 3 ^ b.toNat, by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (3 : ℝ)] with t ht
  have htpos : (0 : ℝ) < t := by linarith
  have ht1 : (1 : ℝ) ≤ t := by linarith
  have hs1 : (1 : ℝ) ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ :=
    le_trans ht1 (norm_vertical_ge_height σ t)
  -- the argument factor
  have hsle : ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ≤ (|σ| + 1) * t := by
    have h1 : ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ≤ ‖(σ : ℂ)‖ + ‖(t : ℂ) * Complex.I‖ :=
      norm_add_le _ _
    have h2 : ‖(σ : ℂ)‖ = |σ| := by simp
    have h3 : ‖(t : ℂ) * Complex.I‖ = |t| := by simp
    have h4 : |t| = t := abs_of_pos htpos
    have h5 : |σ| ≤ |σ| * t := le_mul_of_one_le_right (abs_nonneg σ) ht1
    rw [h2, h3, h4] at h1
    calc ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ≤ |σ| + t := h1
      _ ≤ |σ| * t + t := by linarith
      _ = (|σ| + 1) * t := by ring
  have harg : ‖((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ)‖
      ≤ ((|σ| + 1) * t) ^ ⌈max ω 0⌉₊ := by
    rw [norm_cpow_real_vertical]
    have hstep : ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω
        ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ((⌈max ω 0⌉₊ : ℕ) : ℝ) := by
      refine Real.rpow_le_rpow_of_exponent_le hs1 ?_
      have h1 : ω ≤ max ω 0 := le_max_left _ _
      exact le_trans h1 (Nat.le_ceil _)
    rw [Real.rpow_natCast] at hstep
    refine le_trans hstep ?_
    exact pow_le_pow_left₀ (le_trans zero_le_one hs1) hsle _
  -- the logarithm factor
  have hlogle : Real.log t ≤ t := Real.log_le_sub_one_of_pos htpos |>.trans (by linarith)
  have hlog : ‖vertLog t ^ b‖ ≤ (3 * t) ^ b.toNat := by
    refine le_trans (norm_vertLog_zpow_le ht b) ?_
    refine pow_le_pow_left₀ (add_nonneg (Real.log_nonneg ht1) (by positivity)) ?_ _
    have hpi : Real.pi / 2 ≤ 2 := by
      have := Real.pi_le_four
      linarith
    calc Real.log t + Real.pi / 2 ≤ t + 2 := by linarith
      _ ≤ t + 2 * t := by linarith
      _ = 3 * t := by ring
  calc ‖((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ) * vertLog t ^ b‖
      = ‖((σ : ℂ) + (t : ℂ) * Complex.I) ^ (ω : ℂ)‖ * ‖vertLog t ^ b‖ := norm_mul _ _
    _ ≤ ((|σ| + 1) * t) ^ ⌈max ω 0⌉₊ * (3 * t) ^ b.toNat :=
        mul_le_mul harg hlog (norm_nonneg _) (by positivity)
    _ = (|σ| + 1) ^ ⌈max ω 0⌉₊ * 3 ^ b.toNat * t ^ (⌈max ω 0⌉₊ + b.toNat) := by
        rw [mul_pow, mul_pow, pow_add]
        ring

/-- A positive `Γ`-degree sends the shape to zero. -/
theorem tendsto_gammaShiftShape_zero_of_gamma_pos (hσ : 0 < σ + lam) {d : ℤ} (hd : 0 < d)
    (ω : ℝ) (b : ℤ) :
    Tendsto (gammaShiftShape lam σ d ω b) atTop (nhds 0) := by
  obtain ⟨m, hm⟩ : ∃ m : ℕ, d = (m : ℤ) + 1 := ⟨(d - 1).toNat, by omega⟩
  have hgrow := hasPolyGrowthLine_cpow_mul_vertLog σ ω b
  have hlim := tendsto_gammaLine_pow_mul (σ := σ + lam) hσ hgrow m
  refine hlim.congr fun t => ?_
  rw [gammaShiftShape, hm,
    show ((m : ℤ) + 1) = ((m + 1 : ℕ) : ℤ) by push_cast; ring, zpow_natCast]

/-- At `Γ`-degree zero a negative real argument exponent sends the shape to zero. -/
theorem tendsto_gammaShiftShape_zero_of_arg_neg (σ lam : ℝ) {ω : ℝ} (hω : ω < 0) (b : ℤ) :
    Tendsto (gammaShiftShape lam σ 0 ω b) atTop (nhds 0) := by
  rw [tendsto_zero_iff_norm_tendsto_zero]
  by_cases hb : b ≤ 0
  · -- the logarithm factor is bounded, the argument factor vanishes
    have hbound : ∀ᶠ t : ℝ in atTop,
        ‖gammaShiftShape lam σ 0 ω b t‖ ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω := by
      filter_upwards [eventually_ge_atTop (3 : ℝ), tendsto_norm_vertLog.eventually_ge_atTop 1]
        with t ht hL
      have hLb : ‖vertLog t ^ b‖ ≤ 1 := by
        rw [norm_zpow]
        calc ‖vertLog t‖ ^ b ≤ ‖vertLog t‖ ^ (0 : ℤ) := zpow_le_zpow_right₀ hL hb
          _ = 1 := zpow_zero _
      rw [gammaShiftShape, zpow_zero, one_mul, norm_mul, norm_cpow_real_vertical]
      calc ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω * ‖vertLog t ^ b‖
          ≤ ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω * 1 :=
            mul_le_mul_of_nonneg_left hLb (Real.rpow_nonneg (norm_nonneg _) ω)
        _ = ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω := mul_one _
    have hlim : Tendsto
        (fun t : ℝ => ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω) atTop (nhds 0) := by
      have hneg : Tendsto (fun x : ℝ => x ^ ω) atTop (nhds 0) := by
        have := tendsto_rpow_neg_atTop (y := -ω) (by linarith)
        simpa using this
      exact hneg.comp (tendsto_norm_vertical σ)
    exact squeeze_zero' (by filter_upwards with t using norm_nonneg _) hbound hlim
  · -- a positive power of the logarithm still loses to a negative real power of the argument
    obtain ⟨q, hq⟩ : ∃ q : ℕ, b = (q : ℤ) := ⟨b.toNat, by omega⟩
    have hkey : Tendsto (fun t : ℝ => ((1 + Real.pi / 2) ^ q) * ((Real.log t) ^ q * t ^ ω))
        atTop (nhds 0) := by
      have h := (isLittleO_log_rpow_rpow_atTop (s := -ω) (q : ℝ)
        (by linarith)).tendsto_div_nhds_zero
      have h' : Tendsto (fun t : ℝ => (Real.log t) ^ q * t ^ ω) atTop (nhds 0) := by
        refine h.congr' ?_
        filter_upwards [eventually_ge_atTop (1 : ℝ)] with t ht
        have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
        rw [Real.rpow_natCast, div_eq_mul_inv, ← Real.rpow_neg (le_of_lt htpos), neg_neg]
      simpa using h'.const_mul ((1 + Real.pi / 2) ^ q)
    have hbound : ∀ᶠ t : ℝ in atTop,
        ‖gammaShiftShape lam σ 0 ω b t‖
          ≤ ((1 + Real.pi / 2) ^ q) * ((Real.log t) ^ q * t ^ ω) := by
      filter_upwards [eventually_ge_atTop (3 : ℝ)] with t ht
      have htpos : (0 : ℝ) < t := by linarith
      have ht1 : (1 : ℝ) ≤ t := by linarith
      have hlogpos : (0 : ℝ) ≤ Real.log t := Real.log_nonneg ht1
      have hLnorm : ‖vertLog t‖ ≤ (1 + Real.pi / 2) * Real.log t := by
        have h := norm_vertLog_le ht1
        have hlog1 : (1 : ℝ) ≤ Real.log t := by
          have hexp : Real.exp 1 ≤ t := le_trans (le_of_lt Real.exp_one_lt_d9) (by linarith)
          have := Real.log_le_log (Real.exp_pos 1) hexp
          rwa [Real.log_exp] at this
        have hpi : Real.pi / 2 ≤ Real.pi / 2 * Real.log t :=
          le_mul_of_one_le_right (by positivity) hlog1
        calc ‖vertLog t‖ ≤ Real.log t + Real.pi / 2 := h
          _ ≤ Real.log t + Real.pi / 2 * Real.log t := by linarith
          _ = (1 + Real.pi / 2) * Real.log t := by ring
      have harg : ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω ≤ t ^ ω :=
        Real.rpow_le_rpow_of_nonpos htpos (norm_vertical_ge_height σ t) (le_of_lt hω)
      rw [gammaShiftShape, zpow_zero, one_mul, norm_mul, norm_cpow_real_vertical, hq, norm_zpow,
        zpow_natCast]
      calc ‖(σ : ℂ) + (t : ℂ) * Complex.I‖ ^ ω * ‖vertLog t‖ ^ q
          ≤ t ^ ω * ((1 + Real.pi / 2) * Real.log t) ^ q := by
            refine mul_le_mul harg (pow_le_pow_left₀ (norm_nonneg _) hLnorm q)
              (by positivity) (Real.rpow_nonneg (le_of_lt htpos) ω)
        _ = ((1 + Real.pi / 2) ^ q) * ((Real.log t) ^ q * t ^ ω) := by
            rw [mul_pow]
            ring
    exact squeeze_zero' (by filter_upwards with t using norm_nonneg _) hbound hkey

/-- At `Γ`-degree and argument exponent zero a negative logarithm exponent sends the shape to
zero. -/
theorem tendsto_gammaShiftShape_zero_of_log_neg (σ lam : ℝ) {b : ℤ} (hb : b < 0) :
    Tendsto (gammaShiftShape lam σ 0 0 b) atTop (nhds 0) := by
  obtain ⟨q, hq⟩ : ∃ q : ℕ, b = -((q : ℤ) + 1) := ⟨(-b - 1).toNat, by omega⟩
  rw [tendsto_zero_iff_norm_tendsto_zero]
  have hlim : Tendsto (fun t : ℝ => (‖vertLog t‖ ^ (q + 1))⁻¹) atTop (nhds 0) :=
    (tendsto_pow_atTop (Nat.succ_ne_zero q) |>.comp tendsto_norm_vertLog).inv_tendsto_atTop
  refine hlim.congr fun t => ?_
  rw [gammaShiftShape, zpow_zero, one_mul, norm_mul]
  have hcpow : ‖((σ : ℂ) + (t : ℂ) * Complex.I) ^ ((0 : ℝ) : ℂ)‖ = 1 := by
    rw [Complex.ofReal_zero, Complex.cpow_zero, norm_one]
  rw [hcpow, one_mul, norm_zpow, hq, zpow_neg,
    show ((q : ℤ) + 1) = ((q + 1 : ℕ) : ℤ) by push_cast; ring, zpow_natCast]

/-- **The dominance order of the shifted law.**  A smaller `Γ`-degree dominates; at equal degree a
larger real argument exponent dominates; at both equal a larger logarithm exponent dominates. -/
def ShiftShapeDominates (d : ℤ) (ω : ℝ) (b : ℤ) (d' : ℤ) (ω' : ℝ) (b' : ℤ) : Prop :=
  d < d' ∨ (d' = d ∧ ω' < ω) ∨ (d' = d ∧ ω' = ω ∧ b' < b)

/-- A dominated shape is negligible against the dominating one. -/
theorem tendsto_gammaShiftShape_ratio_zero (hσ : 0 < σ + lam) {d : ℤ} {ω : ℝ} {b : ℤ}
    {d' : ℤ} {ω' : ℝ} {b' : ℤ} (h : ShiftShapeDominates d ω b d' ω' b') :
    Tendsto (fun t : ℝ => gammaShiftShape lam σ d' ω' b' t / gammaShiftShape lam σ d ω b t)
      atTop (nhds 0) := by
  have hzero : Tendsto (gammaShiftShape lam σ (d' - d) (ω' - ω) (b' - b)) atTop (nhds 0) := by
    rcases h with hd | ⟨hd, hω⟩ | ⟨hd, hω, hb⟩
    · exact tendsto_gammaShiftShape_zero_of_gamma_pos hσ (by omega) _ _
    · rw [show d' - d = 0 by omega]
      exact tendsto_gammaShiftShape_zero_of_arg_neg σ lam (by linarith) _
    · rw [show d' - d = 0 by omega, show ω' - ω = 0 by linarith]
      exact tendsto_gammaShiftShape_zero_of_log_neg σ lam (by omega)
  refine hzero.congr' ?_
  filter_upwards [eventually_ge_atTop (3 : ℝ)] with t ht
  exact (gammaShiftShape_div hσ ht d' ω' b' d ω b).symm

/-- **A finite family of shifted data has a dominant member.** -/
theorem exists_dominant_shiftShape_index {N : ℕ} (hN : 0 < N) (d : Fin N → ℤ) (ω : Fin N → ℝ)
    (b : Fin N → ℤ) :
    ∃ β : Fin N, ∀ α : Fin N,
      (d α = d β ∧ ω α = ω β ∧ b α = b β) ∨ ShiftShapeDominates (d β) (ω β) (b β)
        (d α) (ω α) (b α) := by
  classical
  haveI : NeZero N := ⟨by omega⟩
  haveI : Nonempty (Fin N) := ⟨⟨0, hN⟩⟩
  obtain ⟨β, -, hβ⟩ := Finset.exists_min_image (Finset.univ : Finset (Fin N))
    (fun α => (toLex (d α, toLex (-ω α, -b α)) : ℤ ×ₗ (ℝ ×ₗ ℤ)))
    ⟨Classical.arbitrary (Fin N), Finset.mem_univ _⟩
  refine ⟨β, fun α => ?_⟩
  have hle := hβ α (Finset.mem_univ α)
  rw [Prod.Lex.le_iff] at hle
  rcases hle with hlt | ⟨heq, hle2⟩
  · have h1 : d β < d α := hlt
    exact Or.inr (Or.inl h1)
  · have hd : d β = d α := heq
    rw [Prod.Lex.le_iff] at hle2
    rcases hle2 with hlt2 | ⟨heq2, hle3⟩
    · have h2 : -ω β < -ω α := hlt2
      exact Or.inr (Or.inr (Or.inl ⟨hd.symm, by linarith⟩))
    · have h3 : -ω β = -ω α := heq2
      have h4 : -b β ≤ -b α := hle3
      have hω : ω α = ω β := by linarith
      have hba : b α ≤ b β := by omega
      rcases lt_or_eq_of_le hba with h | h
      · exact Or.inr (Or.inr (Or.inr ⟨hd.symm, hω, h⟩))
      · exact Or.inl ⟨hd.symm, hω, h⟩

end

end GaloisForLFunctions.HTGeometry
