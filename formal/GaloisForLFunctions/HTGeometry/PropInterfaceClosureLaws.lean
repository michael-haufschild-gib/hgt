/-- Zero nested polynomial is bihomogeneous in every total degree. -/
theorem isBihomogeneous_zero (N D d : ℕ) :
    IsBihomogeneous d
      (0 : MvPolynomial (Fin D) (MvPolynomial (Fin N) ℝ)) := by
  intro α
  constructor
  · simpa using (MvPolynomial.isHomogeneous_zero (σ := Fin N) ℝ
      (d - ∑ i ∈ α.support, α i))
  · intro h
    rfl

/-- Every constant complex function satisfies a nonzero first-order algebraic differential law. -/
theorem firstOrderDA_const (a : ℂ) : FirstOrderDA (fun _ => a) := by
  let c : ℕ → ℕ → Polynomial ℂ := fun i k =>
    if i = 0 ∧ k = 0 then Polynomial.X - Polynomial.C a else 0
  refine ⟨0, 0, c, ?_, ?_⟩
  · refine ⟨0, le_rfl, 0, le_rfl, ?_⟩
    dsimp [c]
    intro h
    have hd := congrArg Polynomial.natDegree h
    simp at hd
  · intro w
    simp [rowFun, c]

