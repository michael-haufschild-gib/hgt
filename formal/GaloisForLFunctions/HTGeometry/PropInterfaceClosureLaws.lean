/-! ## Cofinite reconstruction and strict reporter promotion -/

/-- An empty coefficient family is tail independent on every source. -/
theorem tailCoefficientIndependent_empty_index
    {X : Type*} (u : Empty → X → ℂ) : TailCoefficientIndependent u := by
  intro c hfinite
  funext i
  exact i.elim

/-- The empty coefficient family has complete cofinite Hilbert reconstruction. -/
theorem cofiniteEvaluationHilbertReconstruction_empty_index
    {X : Type*} (u : Empty → X → ℂ) :
    CofiniteEvaluationHilbertReconstruction u :=
  (cofiniteEvaluationHilbertReconstruction_iff_tailCoefficientIndependent u).2
    (tailCoefficientIndependent_empty_index u)

/-- Equality is a strict reporter promotion for every pair of commuting source laws. -/
theorem reporterStrictExchangePromotion_eq_of_commute
    {α β : Type*} (f g : α → α) (r : α → β)
    (hcomm : ∀ x, f (g x) = g (f x)) :
    ReporterStrictExchangePromotion f g r Eq := by
  refine ⟨eq_equivalence, ?_, ?_, hcomm, ?_⟩
  · intro x y hxy
    simpa using congrArg f hxy
  · intro x y hxy
    simpa using congrArg g hxy
  · intro x y hxy
    exact congrArg r hxy

/-- Equality is a strict reporter promotion exactly when the two laws commute pointwise. -/
theorem reporterStrictExchangePromotion_eq_iff_commute
    {α β : Type*} (f g : α → α) (r : α → β) :
    ReporterStrictExchangePromotion f g r Eq ↔
      ∀ x, f (g x) = g (f x) := by
  constructor
  · intro h
    exact h.2.2.2.1
  · exact reporterStrictExchangePromotion_eq_of_commute f g r

/-! ## Universal value reflections and closed algebraic witness spaces -/

/-- Support retained by a finite Pauli label, forgetting its nonidentity axis. -/
def pauliSupportSet {σ : Type*} (P : σ → Option (Fin 3)) : Set σ :=
  {s | P s ≠ none}

/-- Every real-valued reflection of Pauli support is support invariant. -/
theorem supportInvariantWeight_of_supportReflection
    {σ : Type*} [Fintype σ] [DecidableEq σ] (φ : Set σ → ℝ) :
    SupportInvariantWeight (fun P => φ (pauliSupportSet P)) := by
  intro P Q hPQ
  apply congrArg φ
  apply Set.ext
  intro s
  change (P s ≠ none) ↔ (Q s ≠ none)
  exact not_congr (hPQ s)

/-- The full formal-vector-field space is closed under the vector-field bracket. -/
theorem isVfSubalgebra_top
    {K : Type*} [Field K] [CharZero K] :
    IsVfSubalgebra (⊤ : Submodule K (PowerSeries K)) := by
  intro f hf g hg
  simp

/-- Solutions of one discrete Liouville--Green equation form a real submodule. -/
def lgSolutionSubmodule (p : ℕ → ℝ) : Submodule ℝ (ℕ → ℝ) where
  carrier := {v | IsLGSolution p v}
  zero_mem' := by
    intro n
    simp [lgDiff]
  add_mem' := by
    intro a b ha hb n
    have ha' := ha n
    have hb' := hb n
    simp only [Pi.add_apply, lgDiff]
    simp only [lgDiff] at ha' hb'
    linear_combination ha' + hb'
  smul_mem' := by
    intro r a ha n
    have ha' := ha n
    simp only [Pi.smul_apply, smul_eq_mul, lgDiff]
    simp only [lgDiff] at ha'
    linear_combination r * ha'

/-- The zero sequence solves every discrete Liouville--Green equation. -/
theorem isLGSolution_zero (p : ℕ → ℝ) :
    IsLGSolution p (0 : ℕ → ℝ) :=
  (lgSolutionSubmodule p).zero_mem

namespace TriangularKernel

/-- Strictly-upper kernels form a complex submodule. -/
def strictlyUpperKernelSubmodule : Submodule ℂ (ℕ × ℕ → ℂ) where
  carrier := {K | StrictlyUpperKernel K}
  zero_mem' := by
    intro i j hji
    rfl
  add_mem' := by
    intro K L hK hL i j hji
    simp [hK i j hji, hL i j hji]
  smul_mem' := by
    intro c K hK i j hji
    simp [hK i j hji]

/-- The zero kernel is strictly upper. -/
theorem strictlyUpperKernel_zero :
    StrictlyUpperKernel (0 : ℕ × ℕ → ℂ) :=
  strictlyUpperKernelSubmodule.zero_mem

end TriangularKernel

namespace SplitLinearFormation

/-- A linear equivalence is a split formation with inverse recovery. -/
def ofLinearEquiv
    {R X Z : Type*} [CommRing R]
    [AddCommGroup X] [Module R X] [AddCommGroup Z] [Module R Z]
    (e : X ≃ₗ[R] Z) : SplitLinearFormation R X Z where
  form := e.toLinearMap
  recover := e.symm.toLinearMap
  recover_form := by
    ext x
    simp

end SplitLinearFormation

/-- A linear equivalence, viewed as a singleton split family, resolves its whole target. -/
theorem isResolvingFamily_ofLinearEquiv_singleton
    {R X Z : Type*} [CommRing R]
    [AddCommGroup X] [Module R X] [AddCommGroup Z] [Module R Z]
    (e : X ≃ₗ[R] Z) :
    IsResolvingFamily (fun _ : Unit => SplitLinearFormation.ofLinearEquiv e) := by
  classical
  ext z
  simp [SplitLinearFormation.projection, SplitLinearFormation.ofLinearEquiv]

/-- Identity split formation on any module. -/
def identitySplitLinearFormation
    {R X : Type*} [CommRing R] [AddCommGroup X] [Module R X] :
    SplitLinearFormation R X X :=
  SplitLinearFormation.ofLinearEquiv (LinearEquiv.refl R X)

/-- Identity formation is isometric and its recovery is its adjoint. -/
theorem isIsometricAdjointFormation_identity
    {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] :
    IsIsometricAdjointFormation (identitySplitLinearFormation (R := ℝ) (X := X)) := by
  constructor
  · intro x
    rfl
  · intro x z
    rfl

/-- Identity singleton has the sharp zero residual fusion-frame interval. -/
theorem isResidualFusionFrame_identity_singleton
    {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] :
    IsResidualFusionFrame
      (fun _ : Unit => identitySplitLinearFormation (R := ℝ) (X := X)) () 0 0 := by
  intro z hz
  change z = 0 at hz
  subst z
  simp

/-- Zero matrix map is completely positive at every finite amplification level. -/
theorem isCompletelyPositiveMap_zero
    {σ τ : Type*} [Fintype σ] [Fintype τ] :
    IsCompletelyPositiveMap
      (fun _ : Matrix σ σ ℂ => (0 : Matrix τ τ ℂ)) := by
  intro k A hA
  change (0 : Matrix (Fin k × τ) (Fin k × τ) ℂ).PosSemidef
  exact Matrix.PosSemidef.zero

/-- Identity matrix map is completely positive at every finite amplification level. -/
theorem isCompletelyPositiveMap_id
    {σ : Type*} [Fintype σ] :
    IsCompletelyPositiveMap (fun A : Matrix σ σ ℂ => A) := by
  intro k A hA
  change A.PosSemidef
  exact hA

/-- Constant maps are regular on every closed horizontal strip. -/
theorem diffContOnHorizontalCl_const
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (c : E) (l u : ℝ) :
    DiffContOnHorizontalCl (fun _ : ℂ => c) l u := by
  exact diffContOnCl_const

/-- Common center line of every Alazzawi--Lechner shrinking tube. -/
def shrinkingTubeCenter (n : ℕ) : Fin n → ℂ :=
  fun _ => ⟨0, -Real.pi / 2⟩

/-- The common center line is an unconditional member of the unit shrinking tube. -/
theorem inShrinkingTube_center (n : ℕ) :
    InShrinkingTube 1 (shrinkingTubeCenter n) := by
  intro i
  have hnNat : 0 < n := Nat.zero_lt_of_lt i.isLt
  have hn : (0 : ℝ) < 2 * n := by
    exact mul_pos (by norm_num) (Nat.cast_pos.mpr hnNat)
  change |-Real.pi / 2 + Real.pi / 2| < 1 / (2 * (n : ℝ))
  have hcenter : -Real.pi / 2 + Real.pi / 2 = 0 := by ring
  rw [hcenter, abs_zero]
  exact div_pos zero_lt_one hn

/-- Unit numerator is Hardy-coprime with every finite Blaschke denominator. -/
theorem hardyCoprimeWithFiniteBlaschke_one (B : FiniteBlaschke) :
    HardyCoprimeWithFiniteBlaschke DiskMultiplier.one B := by
  intro z
  refine ⟨z, 0, ?_⟩
  rw [hardyMul_one]
  simp

/-! ## Gaussian sequence spaces and finite canonical states -/

/-- Super-Gaussian coefficient families form a complex submodule. -/
def superGaussianSubmodule : Submodule ℂ (ℕ → ℂ) where
  carrier := {a | SuperGaussianCoeffs a}
  zero_mem' := by
    intro A hA
    refine ⟨1, zero_lt_one, fun n => ?_⟩
    simpa using (Real.exp_pos (-(A * (n : ℝ) ^ 2))).le
  add_mem' := by
    intro a b ha hb A hA
    obtain ⟨Ca, hCa, ha⟩ := ha A hA
    obtain ⟨Cb, hCb, hb⟩ := hb A hA
    refine ⟨Ca + Cb, add_pos hCa hCb, fun n => ?_⟩
    calc
      ‖(a + b) n‖ ≤ ‖a n‖ + ‖b n‖ := by simpa using norm_add_le (a n) (b n)
      _ ≤ Ca * Real.exp (-(A * (n : ℝ) ^ 2)) +
          Cb * Real.exp (-(A * (n : ℝ) ^ 2)) := add_le_add (ha n) (hb n)
      _ = (Ca + Cb) * Real.exp (-(A * (n : ℝ) ^ 2)) := by ring
  smul_mem' := by
    intro c a ha
    by_cases hc : c = 0
    · subst c
      simp
      intro A hA
      refine ⟨1, zero_lt_one, fun n => ?_⟩
      simpa using (Real.exp_pos (-(A * (n : ℝ) ^ 2))).le
    · intro A hA
      obtain ⟨C, hC, ha⟩ := ha A hA
      refine ⟨‖c‖ * C, mul_pos (norm_pos_iff.mpr hc) hC, fun n => ?_⟩
      rw [Pi.smul_apply, norm_smul]
      simpa [mul_assoc] using mul_le_mul_of_nonneg_left (ha n) (norm_nonneg c)

/-- Zero coefficient family has super-Gaussian decay. -/
theorem superGaussianCoeffs_zero : SuperGaussianCoeffs (0 : ℕ → ℂ) :=
  superGaussianSubmodule.zero_mem

/-- Zero coefficients satisfy the eventual Gaussian polynomial-growth event. -/
theorem goodGaussianCoefficients_zero :
    GoodGaussianCoefficients (0 : ℕ → ℂ) := by
  rw [GoodGaussianCoefficients, eventually_atTop]
  refine ⟨1, fun n hn => ?_⟩
  simp only [Pi.zero_apply, norm_zero]
  exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)

/-- Zero shifted coefficients satisfy every Gaussian tail event. -/
theorem goodGaussianTail_zero (N : ℕ) :
    GoodGaussianTail N (0 : ℕ → ℂ) := by
  rw [GoodGaussianTail, eventually_atTop]
  refine ⟨1, fun k hk => ?_⟩
  simp only [Pi.zero_apply, norm_zero]
  positivity

