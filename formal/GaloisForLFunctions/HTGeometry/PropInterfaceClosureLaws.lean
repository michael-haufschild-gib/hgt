/-! ## Sequential divisor local-finiteness boundary -/

/-- Zero sequence has zero `ncard` sublevel count: each sublevel is empty or infinite. -/
theorem divisorSeqCount_zero (r : ℝ) :
    GaloisForLFunctions.QuadraticSubtypeDivisor.divisorSeqCount (fun _ => 0) r = 0 := by
  by_cases hr : 0 ≤ r
  · rw [GaloisForLFunctions.QuadraticSubtypeDivisor.divisorSeqCount]
    simp only [norm_zero]
    have hset : {k : ℕ | 0 ≤ r} = Set.univ := by
      ext k
      simp [hr]
    rw [hset]
    exact Set.infinite_univ.ncard
  · rw [GaloisForLFunctions.QuadraticSubtypeDivisor.divisorSeqCount]
    simp only [norm_zero]
    have hset : {k : ℕ | 0 ≤ r} = ∅ := by
      ext k
      simp [not_le.mp hr]
    rw [hset]
    simp

