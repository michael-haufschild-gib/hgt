/-- Zero Abe seed has locally normal Poincaré family against every `Φ₂` multiplier. -/
theorem hasAbeConvergenceProperty_zero
    {d : ℕ} {Γ : AddSubgroup (Fin d → ℂ)} (ψ : AutomorphicFactor d Γ) :
    HasAbeConvergenceProperty ψ (0 : MultivariateEntire d) := by
  intro φ hφ
  have hterm :
      (fun γ => poincareTerm ψ ((0 : MultivariateEntire d) * φ) γ) =
        (fun _ _ => 0) := by
    funext γ x
    simp [poincareTerm]
  rw [hterm]
  refine ⟨0, ?_⟩
  intro u hu x hx
  refine ⟨Set.univ, Filter.univ_mem, ?_⟩
  filter_upwards with n
  intro y hy
  simpa using (refl_mem_uniformity hu : ((0 : ℂ), 0) ∈ u)

