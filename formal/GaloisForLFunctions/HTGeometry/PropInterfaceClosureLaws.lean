namespace GaloisForLFunctions.BorsukUlam

noncomputable section

/-! ## Universal empty combinatorial laws -/

theorem nz_empty {V : Type*} [DecidableEq V] (lab : V → ℤ) :
    Nz lab ∅ := by
  intro v hv
  simp at hv

theorem magInj_empty {V : Type*} [DecidableEq V] (lab : V → ℤ) :
    MagInj lab ∅ := by
  intro u hu
  simp at hu

theorem alt_empty {V : Type*} [DecidableEq V] (lab : V → ℤ) (s : Bool) :
    alt lab s ∅ := by
  refine ⟨nz_empty lab, magInj_empty lab, ?_⟩
  intro v hv
  simp at hv

theorem altSet_empty {V : Type*} [DecidableEq V] (lab : V → ℤ) :
    AltSet lab ∅ :=
  altSet_of_alt (alt_empty lab false)

/-- Labels one and two on the Boolean vertices form the minimal nonempty consecutive pair. -/
theorem consec_bool :
    Consec (fun b : Bool => if b then 2 else 1) {false, true} false true := by
  refine ⟨by simp, by simp, by simp, ?_⟩
  intro w hw
  cases w <;> simp

/-- Two equal positive labels form a minimal almost-alternating set: either singleton facet
alternates, while the pair fails magnitude injectivity. -/
theorem almostAlt_bool :
    almostAlt (fun _ : Bool => 1) true {false, true} := by
  simp [almostAlt, AltSet, Defect, Consec, alt, Nz, MagInj, pos, rk]

namespace FlagComplex

theorem sdChain_empty {n : ℕ} (K : FlagComplex n) :
    SdChain K ∅ := by
  intro x hx
  simp at hx

end FlagComplex

