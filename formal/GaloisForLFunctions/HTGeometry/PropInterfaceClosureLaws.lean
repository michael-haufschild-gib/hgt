/-- Constant ambient coordinate has local carrier transport by identity on universal neighborhood. -/
theorem hasLocalAmbientCarrierTransport_const
    {f : ℝ →ᵇ ℂ} {d : ℕ} (c : EuclideanSpace ℝ (Fin d)) :
    HasLocalAmbientCarrierTransport f (fun _ => c) := by
  intro t x
  refine ⟨Set.univ, id, isOpen_univ, Set.mem_univ _, continuous_id.continuousOn,
    Set.injOn_id Set.univ, ?_⟩
  intro y hy
