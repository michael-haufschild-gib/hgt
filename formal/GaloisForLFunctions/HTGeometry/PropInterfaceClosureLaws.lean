namespace TraceClassKernelFamily

/-- Constant zero kernel is a trace-class kernel family. -/
noncomputable def zero (iota : Type*) [DecidableEq iota] : TraceClassKernelFamily iota where
  K := 0
  isHS := fun _ => HilbertSchmidt.isHS_zero
  traceClass := by
    intro z
    have hop : HilbertSchmidt.toOperator
        (HilbertSchmidt.isHS_zero : HilbertSchmidt.IsHS (0 : iota × iota → ℂ)) = 0 :=
      (HilbertSchmidt.toOperator_eq_zero_iff _).2 rfl
    rw [hop]
    simp [RHTower.MemSchattenClass, RHTower.approxNumber_zero_op]

/-- Zero trace-class kernel family is holomorphic Fredholm on the whole plane. -/
theorem zero_isHolomorphicFredholmOn_univ
    (iota : Type*) [DecidableEq iota] :
    (zero iota).IsHolomorphicFredholmOn Set.univ := by
  refine ⟨isOpen_univ, ?_, ?_⟩
  · have hop : (zero iota).operator = fun _ => (zero iota).operator 0 := by
      funext z
      unfold operator
      change kernelFredholmOperator (0 : iota × iota → ℂ) _ =
        kernelFredholmOperator (0 : iota × iota → ℂ) _
      congr
    rw [hop]
    exact analyticOnNhd_const
  · have hdet : (zero iota).determinant = fun _ => (zero iota).determinant 0 := by
      funext z
      unfold determinant
      change kernelFredholmDeterminant (0 : iota × iota → ℂ) _ =
        kernelFredholmDeterminant (0 : iota × iota → ℂ) _
      congr
    rw [hdet]
    exact analyticOnNhd_const

end TraceClassKernelFamily

/-! ## Empty archimedean shape and neutral FZZ sector -/

/-- Empty archimedean shape evaluated from complex coordinates. -/
def emptyArchimedeanShapeFunction (s : ℂ) : ℂ :=
  archimedeanShape (fun i : Fin 0 => i.elim0) (fun i : Fin 0 => i.elim0)
