/-- Empty archimedean product carries uniform tube datum one. -/
theorem hasArchimedeanTubeDatum_emptyShape (M : ℝ) :
    HasArchimedeanTubeDatum (fun i : Fin 0 => i.elim0) (fun i : Fin 0 => i.elim0)
      0 M emptyArchimedeanShapeFunction 0 0 0 1 := by
  refine ⟨one_ne_zero, ?_⟩
  intro sigma hsigma hsigmaM
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_ge_atTop (3 : ℝ)] with t ht
  have hnum :
      emptyArchimedeanShapeFunction ((sigma : ℂ) + (t : ℂ) * Complex.I) =
        archimedeanShape (fun i : Fin 0 => i.elim0) (fun i : Fin 0 => i.elim0)
          0 sigma 0 0 0 t := by
    simp [emptyArchimedeanShapeFunction]
  rw [hnum, div_self]
  exact archimedeanShape_ne_zero _ _ hsigma (fun i => i.elim0) 0 0 0 0 ht

