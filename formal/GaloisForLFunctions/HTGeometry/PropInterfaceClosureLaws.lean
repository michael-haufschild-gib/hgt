/-- Empty-index divisor has identically zero counting function and sublog density. -/
theorem CountableDivisor.sublogDensityIdx_empty :
    CountableDivisor.SublogDensityIdx (fun i : Fin 0 => i.elim0) := by
  have hfun :
      (fun r : ℝ =>
        (CountableDivisor.divisorIdxCount (fun i : Fin 0 => (i.elim0 : ℂ)) r : ℝ) /
          Real.log r) = fun _ => 0 := by
    funext r
    have hr : {i : Fin 0 | ‖(i.elim0 : ℂ)‖ ≤ r} = ∅ := by
      ext i
      exact i.elim0
    simp [CountableDivisor.divisorIdxCount, hr]
  rw [CountableDivisor.SublogDensityIdx, hfun]
  exact tendsto_const_nhds

