  positive_energy a := a.elim
  on_mass_shell a := a.elim
  spin_statistics a := a.elim
  finite_multiplicity_at_mass _ := Set.toFinite _
  finite_multiplicity_below_mass _ := Set.toFinite _

/-- Fermionic projection of empty one-particle data is vacuously inhabited at every label. -/
theorem emptyHLSOneParticleData_fermionic (a : Empty) :
    emptyHLSOneParticleData.fermionic a :=
  a.elim

/-- Empty particle-label space carries dependency-closed odd-additive generator data. -/
def emptyHLSPhysicalOddAdditiveGeneratorData :
    HLSPhysicalOddAdditiveGeneratorData Empty ℂ where
  fermionic := Empty.elim
  gradedSign := Empty.elim
  bosonic_sign a := a.elim
  fermionic_sign a := a.elim
  oneParticleContribution := Empty.elim
  multiparticleContribution := fun _ => 0
  empty := rfl
  prepend_graded a := a.elim

/-- Fermionic projection of empty odd-additive data is vacuously inhabited at every label. -/
theorem emptyHLSPhysicalOddAdditiveGeneratorData_fermionic (a : Empty) :
    emptyHLSPhysicalOddAdditiveGeneratorData.fermionic a :=
  a.elim

/-- Empty particle-label space carries dependency-closed mass-preserving generator data. -/
def emptyHLSMassPreservingGeneratorData : HLSMassPreservingGeneratorData Empty where
  mass := Empty.elim
  transition := Empty.elim
  connects_equal_mass a := a.elim

/-- Transition projection of empty mass-preserving data is vacuously inhabited at every pair. -/
theorem emptyHLSMassPreservingGeneratorData_transition (a b : Empty) :
    emptyHLSMassPreservingGeneratorData.transition a b :=
  a.elim

/-- Zero-scale grid square is the singleton zero, contained in the universal domain and unit ball. -/
theorem selSquare_zero_univ : SelSquare 0 Set.univ 1 (0, 0) := by
  constructor
  · exact fun _ _ => Set.mem_univ _
  · intro z hz
    rw [mem_gridSquare] at hz
    norm_num at hz
    rw [Metric.mem_ball, dist_zero_right]
    have hz0 : z = 0 := by
      apply Complex.ext
      · exact le_antisymm hz.1.2 hz.1.1
      · exact le_antisymm hz.2.2 hz.2.1
    simp [hz0]

namespace HallSolvable

/-- Trivial group has every Hall subgroup requested by a factorization of its order. -/
theorem hasHallProperty_unit : HasHallProperty Unit := by
  intro m k hcard hcop
  have hcard' : 1 = m * k := by simpa using hcard
  have hm : m = 1 := Nat.eq_one_of_dvd_one ⟨k, hcard'⟩
  subst m
  exact ⟨⊤, by simp⟩

end HallSolvable

/-- Canonical architecture with no qubits and no gate locations. -/
def emptyTwoQubitArchitecture : TwoQubitArchitecture 0 0 where
  sites r := r.elim0
  distinct r := r.elim0

local instance propInterfaceClosureDecidableEqPauliLabel :
    DecidableEq boolNonidentityTwoQubitPauliLabel := Classical.decEq _
local instance propInterfaceClosureFintypePauliLabel :
    Fintype boolNonidentityTwoQubitPauliLabel := Fintype.ofFinite _

/-- Every chart through the empty architecture has zero differential rank, hence rank below one. -/
theorem emptyTwoQubitArchitecture_terminalHybridRankDeficient :
    emptyTwoQubitArchitecture.terminalHybridRankDeficient 1 (fun r => r.elim0) := by
  intro N U x hgate
  calc
    Module.finrank ℝ
        (fderiv ℝ
          (emptyTwoQubitArchitecture.terminalHybridEuclideanRightUnshiftedReindexedChart N U)
          x).range
      ≤ Module.finrank ℝ
          (EuclideanSpace ℝ (Fin (Fintype.card
            (Fin 0 × terminalHybridCoordinateIndex N)))) :=
        LinearMap.finrank_range_le _
    _ = 0 := by simp
    _ < 1 := by omega

end

