/-! ## Observer, formation, and grading ground laws -/

/-- Zero observation on every entire function. -/
def zeroFiniteObservation (N : ℕ) : (ℂ → ℂ) → (Fin N → ℂ) :=
  fun _ _ => 0

/-- Zero observation simultaneously satisfies all three finite-observer laws. -/
theorem zeroFiniteObservation_laws (N : ℕ) :
    ObsAdditive (zeroFiniteObservation N) ∧
      ObsHomogeneous (zeroFiniteObservation N) ∧
      ObsContinuous (zeroFiniteObservation N) := by
  constructor
  · intro f g hf hg
    ext i
    simp [zeroFiniteObservation]
  constructor
  · intro c f hf
    ext i
    simp [zeroFiniteObservation]
  · intro F h hF hh hconv
    change Filter.Tendsto (fun _ : ℕ => (0 : Fin N → ℂ)) Filter.atTop (nhds 0)
    exact tendsto_const_nhds

