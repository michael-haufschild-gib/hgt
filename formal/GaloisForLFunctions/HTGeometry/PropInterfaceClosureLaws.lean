/-- Entire functions whose ordered jets through `n` vanish at `p` form a complex submodule. -/
def allJetsVanishSubmodule {d : ℕ} (n : ℕ) (p : Fin d → ℂ) :
    Submodule ℂ (MultivariateEntire d) where
  carrier := {f | AllJetsVanish n p f}
  zero_mem' := by
    intro k hk word
    exact map_zero _
  add_mem' := by
    intro f g hf hg k hk word
    rw [map_add, hf k hk word, hg k hk word, add_zero]
  smul_mem' := by
    intro c f hf k hk word
    rw [map_smul, hf k hk word, smul_zero]

/-- Zero entire function has every ordered jet vanish through every finite order. -/
theorem allJetsVanish_zero {d : ℕ} (n : ℕ) (p : Fin d → ℂ) :
    AllJetsVanish n p (0 : MultivariateEntire d) :=
  (allJetsVanishSubmodule n p).zero_mem

/-- Coefficient families supported in a fixed frequency window form a complex submodule. -/
def trigSuppSubmodule (D : ℕ) : Submodule ℂ (ℤ → ℂ) where
  carrier := {f | TrigSupp D f}
  zero_mem' := by simp [TrigSupp]
  add_mem' := fun hf hg => trigSupp_add hf hg
  smul_mem' := fun c f hf => trigSupp_smul hf c

/-- Zero coefficient family is supported in every frequency window. -/
theorem trigSupp_zero (D : ℕ) : TrigSupp D (0 : ℤ → ℂ) :=
  (trigSuppSubmodule D).zero_mem

