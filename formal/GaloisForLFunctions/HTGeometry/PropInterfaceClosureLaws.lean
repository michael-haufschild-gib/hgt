/-- Zero reporter and constant source simultaneously satisfy all collision recurrence laws. -/
theorem zeroCollision_laws
    {H K : Type*} [AddCommGroup H] [NormedAddCommGroup K]
    (collision : H × H) (c : ℝ) :
    IsCausalCollisionActionLedger (0 : H →+ K) (fun _ => c) (fun _ => collision) ∧
      IsCofinalCollisionPotentialRecurrent (fun _ => c) (fun _ => collision) ∧
      IsCofinalCollisionChargeRecurrent (0 : H →+ K) (fun _ => collision) collision := by
