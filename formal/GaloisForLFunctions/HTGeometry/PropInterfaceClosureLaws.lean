/-- Zero `L²` element is almost everywhere Boolean-valued. -/
theorem isAEBoolean_zero {X : Type*} [MeasurableSpace X] (μ : MeasureTheory.Measure X) :
    IsAEBoolean μ (0 : MeasureTheory.Lp ℝ 2 μ) := by
  rw [IsAEBoolean]
  filter_upwards [MeasureTheory.Lp.coeFn_zero ℝ 2 μ] with x hx
