import GaloisForLFunctions.HTGeometry.AnalyticJetFieldBridge

/-!
# Polynomial expressions in analytic germs

A polynomial in finitely many analytic functions, evaluated pointwise, is realized in the meromorphic
function field by the same polynomial in their germs.  This is what lets a pointwise relation whose
coefficients are polynomials in some states be read, in the field, as a relation whose coefficients
lie in the field generated by those states.

Everything is stated with explicit ring homomorphisms rather than an `Algebra ℂ` instance, so no
scalar-tower diamond can arise.
-/

open Filter Set Topology

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

variable {U : Set ℂ}

/-- Constants as elements of the meromorphic function field. -/
noncomputable def constToMero (U : Set ℂ) : ℂ →+* meroField U :=
  (algebraMap (analyticSubring U) (meroField U)).comp (constToAnalytic U)

/-- The meromorphic realization depends only on the function. -/
theorem analyticMeroElement_congr {f g : ℂ → ℂ} (hf : AnalyticOnNhd ℂ f U)
    (hg : AnalyticOnNhd ℂ g U) (h : f = g) :
    analyticMeroElement f hf = analyticMeroElement g hg := by
  subst h
  rfl

/-- A constant function is realized by the constant embedding. -/
theorem analyticMeroElement_const (U : Set ℂ) (c : ℂ) :
    analyticMeroElement (fun _ : ℂ => c) analyticOnNhd_const = constToMero U c := by
  rw [analyticMeroElement, constToMero, RingHom.comp_apply]
  congr 1

/-- A polynomial in analytic functions is analytic. -/
theorem analyticOnNhd_eval_mvPolynomial {m : ℕ} (g : Fin m → ℂ → ℂ)
    (hg : ∀ i, AnalyticOnNhd ℂ (g i) U) (P : MvPolynomial (Fin m) ℂ) :
    AnalyticOnNhd ℂ (fun z => MvPolynomial.eval (fun i => g i z) P) U := by
  induction P using MvPolynomial.induction_on with
  | C a =>
      have hfun : (fun z : ℂ => MvPolynomial.eval (fun i => g i z) (MvPolynomial.C a))
          = fun _ : ℂ => a := by
        funext z
        simp
      rw [hfun]
      exact analyticOnNhd_const
  | add p q hp hq =>
      have hfun : (fun z : ℂ => MvPolynomial.eval (fun i => g i z) (p + q))
          = fun z : ℂ => MvPolynomial.eval (fun i => g i z) p
            + MvPolynomial.eval (fun i => g i z) q := by
        funext z
        rw [map_add]
      rw [hfun]
      exact hp.add hq
  | mul_X p i hp =>
      have hfun : (fun z : ℂ => MvPolynomial.eval (fun j => g j z) (p * MvPolynomial.X i))
          = fun z : ℂ => MvPolynomial.eval (fun j => g j z) p * g i z := by
        funext z
        rw [map_mul, MvPolynomial.eval_X]
      rw [hfun]
      exact hp.mul (hg i)

/-- **Polynomial expressions transfer to the field.**  Evaluating a polynomial at analytic functions
pointwise and then passing to germs is the same as passing to germs first. -/
theorem analyticMeroElement_eval_mvPolynomial {m : ℕ} (g : Fin m → ℂ → ℂ)
    (hg : ∀ i, AnalyticOnNhd ℂ (g i) U) (P : MvPolynomial (Fin m) ℂ) :
    analyticMeroElement (fun z => MvPolynomial.eval (fun i => g i z) P)
        (analyticOnNhd_eval_mvPolynomial g hg P)
      = MvPolynomial.eval₂ (constToMero U) (fun i => analyticMeroElement (g i) (hg i)) P := by
  induction P using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.eval₂_C]
      refine Eq.trans ?_ (analyticMeroElement_const U a)
      refine analyticMeroElement_congr _ _ ?_
      funext z
      simp
  | add p q hp hq =>
      have hfun : (fun z : ℂ => MvPolynomial.eval (fun i => g i z) (p + q))
          = fun z : ℂ => MvPolynomial.eval (fun i => g i z) p
            + MvPolynomial.eval (fun i => g i z) q := by
        funext z
        rw [map_add]
      rw [MvPolynomial.eval₂_add, ← hp, ← hq,
        ← analyticMeroElement_add (analyticOnNhd_eval_mvPolynomial g hg p)
          (analyticOnNhd_eval_mvPolynomial g hg q)]
      exact analyticMeroElement_congr _ _ hfun
  | mul_X p i hp =>
      have hfun : (fun z : ℂ => MvPolynomial.eval (fun j => g j z) (p * MvPolynomial.X i))
          = fun z : ℂ => MvPolynomial.eval (fun j => g j z) p * g i z := by
        funext z
        rw [map_mul, MvPolynomial.eval_X]
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, ← hp,
        ← analyticMeroElement_mul (analyticOnNhd_eval_mvPolynomial g hg p) (hg i)]
      exact analyticMeroElement_congr _ _ hfun

/-! ## Sums of analytic germs -/

/-- The zero function is the zero germ. -/
theorem analyticMeroElement_zero (U : Set ℂ) :
    analyticMeroElement (fun _ : ℂ => (0 : ℂ)) analyticOnNhd_const = (0 : meroField U) := by
  rw [analyticMeroElement]
  have : analyticFunctionElement (fun _ : ℂ => (0 : ℂ)) analyticOnNhd_const
      = (0 : analyticSubring U) := by
    apply Subtype.ext
    rfl
  rw [this, map_zero]

/-- A finite sum of analytic functions is realized by the sum of the germs. -/
theorem analyticMeroElement_finsetSum {ι : Type*} (s : Finset ι) (g : ι → ℂ → ℂ)
    (hg : ∀ i, AnalyticOnNhd ℂ (g i) U)
    (hs : AnalyticOnNhd ℂ (fun z => ∑ i ∈ s, g i z) U) :
    analyticMeroElement (fun z => ∑ i ∈ s, g i z) hs
      = ∑ i ∈ s, analyticMeroElement (g i) (hg i) := by
  classical
  induction s using Finset.induction with
  | empty =>
      rw [Finset.sum_empty]
      refine Eq.trans ?_ (analyticMeroElement_zero U)
      exact analyticMeroElement_congr _ _ (by funext z; rw [Finset.sum_empty])
  | insert j t hj ih =>
      have hrest : AnalyticOnNhd ℂ (fun z => ∑ i ∈ t, g i z) U := by
        have hpi : (fun z => ∑ i ∈ t, g i z) = ∑ i ∈ t, g i := by
          funext z
          rw [Finset.sum_apply]
        rw [hpi]
        exact Finset.sum_induction g (fun h => AnalyticOnNhd ℂ h U)
          (fun a b ha hb => ha.add hb) analyticOnNhd_const (fun i _ => hg i)
      have hfun : (fun z => ∑ i ∈ insert j t, g i z)
          = fun z => g j z + ∑ i ∈ t, g i z := by
        funext z
        rw [Finset.sum_insert hj]
      rw [Finset.sum_insert hj, ← ih hrest,
        ← analyticMeroElement_add (hg j) hrest]
      exact analyticMeroElement_congr _ _ hfun

/-! ## Faithfulness -/

/-- **The realization is faithful.**  A germ vanishes in the meromorphic field exactly when the
function vanishes on the set. -/
theorem analyticMeroElement_eq_zero_iff {g : ℂ → ℂ} (hg : AnalyticOnNhd ℂ g U)
    [IsDomain (analyticSubring U)] :
    analyticMeroElement g hg = 0 ↔ ∀ z ∈ U, g z = 0 := by
  constructor
  · intro h
    have hsub : analyticFunctionElement g hg = 0 :=
      IsFractionRing.injective (analyticSubring U) (meroField U) (by simpa [analyticMeroElement]
        using h)
    have hgerm : ((g : ℂ → ℂ) : Germ (Filter.principal U) ℂ) = 0 :=
      congrArg Subtype.val hsub
    rw [← Germ.coe_zero, Germ.coe_eq] at hgerm
    intro z hz
    exact Filter.eventually_principal.mp hgerm z hz
  · intro h
    have hgerm : ((g : ℂ → ℂ) : Germ (Filter.principal U) ℂ) = 0 := by
      rw [← Germ.coe_zero, Germ.coe_eq]
      exact Filter.eventually_principal.mpr h
    have hsub : analyticFunctionElement g hg = 0 := Subtype.ext hgerm
    rw [analyticMeroElement, hsub, map_zero]

/-! ## Constants come from the rational coordinate field -/

/-- The constant embedding factors through the rational coordinate field. -/
theorem ratfuncToMero_C_eq_constToMero (c : ℂ) :
    ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
        Set.infinite_univ (RatFunc.C c)
      = constToMero (Set.univ : Set ℂ) c := by
  have hpc : polyToAnalytic (Set.univ : Set ℂ) (Polynomial.C c)
      = constToAnalytic Set.univ c := by
    apply Subtype.ext
    have hfun : (fun z : ℂ => (Polynomial.C c).eval z) = fun _ : ℂ => c :=
      funext fun _ => Polynomial.eval_C
    show Germ.coeRingHom (Filter.principal (Set.univ : Set ℂ))
        (fun z : ℂ => (Polynomial.C c).eval z)
      = Germ.coeRingHom (Filter.principal (Set.univ : Set ℂ)) (fun _ : ℂ => c)
    rw [hfun]
  rw [← RatFunc.algebraMap_C, ratfuncToMero_algebraMap_polynomial, polyToMero,
    RingHom.comp_apply, hpc]
  rfl

/-- The domain of entire germs. -/
local instance entirePolyEvalDomain : IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

/-- The rational coordinate field inside the global meromorphic field. -/
local instance entirePolyEvalRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).toAlgebra

/-- Constants lie in every intermediate field over the rational coordinate field. -/
theorem constToMero_mem (E : IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)))
    (c : ℂ) : constToMero (Set.univ : Set ℂ) c ∈ E := by
  rw [← ratfuncToMero_C_eq_constToMero]
  exact IntermediateField.algebraMap_mem E (RatFunc.C c)

/-- **A polynomial in members of an intermediate field stays inside it.** -/
theorem eval₂_constToMero_mem {m : ℕ}
    (E : IntermediateField (RatFunc ℂ) (meroField (Set.univ : Set ℂ)))
    (x : Fin m → meroField (Set.univ : Set ℂ)) (hx : ∀ i, x i ∈ E)
    (P : MvPolynomial (Fin m) ℂ) :
    MvPolynomial.eval₂ (constToMero (Set.univ : Set ℂ)) x P ∈ E := by
  induction P using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.eval₂_C]
      exact constToMero_mem E a
  | add p q hp hq =>
      rw [MvPolynomial.eval₂_add]
      exact add_mem hp hq
  | mul_X p i hp =>
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
      exact mul_mem hp (hx i)

end

end GaloisForLFunctions.HTGeometry
