import GaloisForLFunctions.HTGeometry.ValuationInertiaIntermediateBase

/-!
# An intermediate field fixed by inertia is unramified

If every element of the inertia group of a valuation subring over the base fixes an intermediate
field pointwise, then the inertia group over that intermediate field is the whole inertia group over
the base, and the orbit formula `|I_F| = e · |I_M|` forces the ramification index of the intermediate
place to be one.

```text
toIntermediateAlgEquiv, smul_valuationSubring_intermediate
mem_inertiaSubgroup_intermediate       inertia membership is independent of the base field
natCard_inertiaSubgroup_le_intermediate
ramificationIdx_intermediateCentre_eq_one_of_inertia_fixes
    ** inertia fixes `M` pointwise  ⟹  `M` is unramified at the place **
ramificationIdx_fixedField_eq_one_of_inertia_le
    ** the field fixed by any subgroup containing inertia is unramified **
intermediateField_eq_bot_of_unramified_of_totallyRamified
    ** a totally ramified place has no unramified subextension **
fixedField_eq_bot_of_inertia_le_of_totallyRamified
ramificationIdx_intermediateCentre_eq_one_of_inertia_trivial
    ** an unramified place stays unramified in every intermediate field **
```

This is the ramification half of the step that turns a block system of a cover into an
everywhere-unramified intermediate cover: the inertia at a branch place is generated by a meridian,
a meridian acting as a transposition preserves every block, and the block field is therefore fixed
by inertia.

Nothing here assumes the intermediate extension is normal.
-/

namespace GaloisForLFunctions.HTGeometry
namespace ValuationInertia

noncomputable section

open IsLocalRing
open scoped Pointwise

set_option linter.unusedSectionVars false
set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 800000

variable {F L : Type*} [Field F] [Field L] [Algebra F L]
variable (M : IntermediateField F L) (W : ValuationSubring L)

/-- An `F`-automorphism that fixes an intermediate field pointwise is an `M`-automorphism. -/
def toIntermediateAlgEquiv (g : L ≃ₐ[F] L) (hg : ∀ x : M, g (x : L) = (x : L)) :
    L ≃ₐ[M] L :=
  { g with commutes' := fun x => hg x }

@[simp] theorem toIntermediateAlgEquiv_apply (g : L ≃ₐ[F] L)
    (hg : ∀ x : M, g (x : L) = (x : L)) (y : L) :
    toIntermediateAlgEquiv M g hg y = g y := rfl

/-- Stabilising the valuation subring does not depend on the base field. -/
theorem smul_valuationSubring_intermediate (g : L ≃ₐ[F] L)
    (hg : ∀ x : M, g (x : L) = (x : L)) (hgW : g • W = W) :
    (toIntermediateAlgEquiv M g hg) • W = W := hgW

/-- **Inertia membership does not depend on the base field**, for an element that fixes the
intermediate field pointwise. -/
theorem mem_inertiaSubgroup_intermediate {g : W.decompositionSubgroup F}
    (hg : g ∈ W.inertiaSubgroup F)
    (hfix : ∀ x : M, ((g : L ≃ₐ[F] L)) (x : L) = (x : L)) :
    (⟨toIntermediateAlgEquiv M ((g : L ≃ₐ[F] L)) hfix,
      smul_valuationSubring_intermediate M W _ hfix g.2⟩ : W.decompositionSubgroup M)
      ∈ W.inertiaSubgroup M := by
  refine MonoidHom.mem_ker.2 (RingEquiv.ext ?_)
  refine (IsLocalRing.residue_surjective (R := W)).forall.2 fun a => ?_
  change (⟨toIntermediateAlgEquiv M ((g : L ≃ₐ[F] L)) hfix,
      smul_valuationSubring_intermediate M W _ hfix g.2⟩ : W.decompositionSubgroup M)
      • IsLocalRing.residue W a = IsLocalRing.residue W a
  rw [← IsLocalRing.ResidueField.residue_smul, ← sub_eq_zero, ← map_sub]
  refine (IsLocalRing.residue_eq_zero_iff _).2 ?_
  have hsm : (⟨toIntermediateAlgEquiv M ((g : L ≃ₐ[F] L)) hfix,
      smul_valuationSubring_intermediate M W _ hfix g.2⟩ : W.decompositionSubgroup M) • a
      = g • a := rfl
  rw [hsm]
  exact smul_sub_mem_maximalIdeal_of_mem_inertiaSubgroup W hg a

/-- **The inertia group over an intermediate field fixed by inertia is no smaller.** -/
theorem natCard_inertiaSubgroup_le_intermediate [Finite (W.inertiaSubgroup M)]
    (hfix : ∀ g : W.inertiaSubgroup F, ∀ x : M,
      (((g : W.decompositionSubgroup F) : L ≃ₐ[F] L)) (x : L) = (x : L)) :
    Nat.card (W.inertiaSubgroup F) ≤ Nat.card (W.inertiaSubgroup M) := by
  refine Nat.card_le_card_of_injective
    (fun g => ⟨⟨toIntermediateAlgEquiv M (((g : W.decompositionSubgroup F) : L ≃ₐ[F] L)) (hfix g),
        smul_valuationSubring_intermediate M W _ (hfix g)
          ((g : W.decompositionSubgroup F)).2⟩,
      mem_inertiaSubgroup_intermediate M W g.2 (hfix g)⟩) ?_
  intro g h hgh
  have h1 := Subtype.ext_iff.mp hgh
  have h2 := Subtype.ext_iff.mp h1
  apply Subtype.ext
  apply Subtype.ext
  apply AlgEquiv.ext
  intro y
  exact congrArg (fun (e : L ≃ₐ[M] L) => e y) h2

section Unramified

variable {A : Type*} [CommRing A] [IsDedekindDomain A] [Algebra A F] [IsFractionRing A F]
variable [Algebra A L] [IsScalarTower A F L] [FiniteDimensional F L] [IsGalois F L]

/-- **`E3`: the intermediate field fixed by inertia is unramified at the place.**  The inertia group
over the intermediate field is then all of the inertia group over the base, and the orbit formula
`|I_F| = e · |I_M|` leaves `e = 1`. -/
theorem ramificationIdx_intermediateCentre_eq_one_of_inertia_fixes
    (hAW : ∀ a : A, algebraMap A L a ∈ W) (hW : W ≠ ⊤)
    (p : Ideal A) (hp0 : p ≠ ⊥) [p.IsMaximal] [PerfectField p.ResidueField]
    (hcentA : ∀ a : A, (¬ IsUnit (⟨algebraMap A L a, hAW a⟩ : W)) ↔ a ∈ p)
    [PerfectField (intermediateCentre M W hAW).ResidueField]
    (hfix : ∀ g : W.inertiaSubgroup F, ∀ x : M,
      (((g : W.decompositionSubgroup F) : L ≃ₐ[F] L)) (x : L) = (x : L)) :
    (intermediateCentre M W hAW).ramificationIdx A = 1 := by
  haveI : Finite (L ≃ₐ[F] L) := inferInstance
  haveI : Finite (W.decompositionSubgroup F) := inferInstance
  haveI : Finite (W.inertiaSubgroup F) := inferInstance
  haveI : Finite (L ≃ₐ[M] L) := inferInstance
  haveI : Finite (W.decompositionSubgroup M) := inferInstance
  haveI : Finite (W.inertiaSubgroup M) := inferInstance
  have hmul := natCard_inertiaSubgroup_eq_intermediate_mul M W hAW p hW hp0 hcentA
  have hle := natCard_inertiaSubgroup_le_intermediate M W hfix
  have hFpos : 0 < Nat.card (W.inertiaSubgroup F) := Nat.card_pos
  have hMpos : 0 < Nat.card (W.inertiaSubgroup M) := Nat.card_pos
  rw [hmul] at hle hFpos
  nlinarith [hle, hFpos, hMpos]

/-- **The field fixed by a subgroup containing inertia is unramified at the place.**  This is the
form a block system consumes: take `H` to be the stabiliser of a block, which contains the inertia
generated by a meridian transposition. -/
theorem ramificationIdx_fixedField_eq_one_of_inertia_le
    (H : Subgroup (L ≃ₐ[F] L))
    (hAW : ∀ a : A, algebraMap A L a ∈ W) (hW : W ≠ ⊤)
    (p : Ideal A) (hp0 : p ≠ ⊥) [p.IsMaximal] [PerfectField p.ResidueField]
    (hcentA : ∀ a : A, (¬ IsUnit (⟨algebraMap A L a, hAW a⟩ : W)) ↔ a ∈ p)
    [PerfectField (intermediateCentre (IntermediateField.fixedField H) W hAW).ResidueField]
    (hI : ∀ g : W.inertiaSubgroup F, ((g : W.decompositionSubgroup F) : L ≃ₐ[F] L) ∈ H) :
    (intermediateCentre (IntermediateField.fixedField H) W hAW).ramificationIdx A = 1 := by
  refine ramificationIdx_intermediateCentre_eq_one_of_inertia_fixes
    (IntermediateField.fixedField H) W hAW hW p hp0 hcentA ?_
  intro g x
  exact (IntermediateField.mem_fixedField_iff H (x : L)).mp x.2 _ (hI g)

/-- **A totally ramified place has no unramified subextension.**  The inertia group over `M` is the
whole inertia group over `F`, which at a totally ramified place is everything; but it embeds in
`Gal(L/M)`, so `[L:F] ≤ [L:M]` and `M` is trivial. -/
theorem intermediateField_eq_bot_of_unramified_of_totallyRamified
    (hAW : ∀ a : A, algebraMap A L a ∈ W) (hW : W ≠ ⊤)
    (p : Ideal A) (hp0 : p ≠ ⊥) [p.IsMaximal] [PerfectField p.ResidueField]
    (hcentA : ∀ a : A, (¬ IsUnit (⟨algebraMap A L a, hAW a⟩ : W)) ↔ a ∈ p)
    [PerfectField (intermediateCentre M W hAW).ResidueField]
    (htot : Module.finrank F L ≤ Nat.card (W.inertiaSubgroup F))
    (hunram : (intermediateCentre M W hAW).ramificationIdx A = 1) :
    M = ⊥ := by
  haveI : IsGalois M L := inferInstance
  haveI : Finite (L ≃ₐ[M] L) := inferInstance
  have hmul := natCard_inertiaSubgroup_eq_intermediate_mul M W hAW p hW hp0 hcentA
  rw [hunram, one_mul] at hmul
  have hle1 : Nat.card (W.inertiaSubgroup M) ≤ Nat.card (W.decompositionSubgroup M) :=
    Subgroup.card_le_card_group _
  have hle2 : Nat.card (W.decompositionSubgroup M) ≤ Nat.card (L ≃ₐ[M] L) :=
    Subgroup.card_le_card_group _
  have hcard : Nat.card (L ≃ₐ[M] L) = Module.finrank M L := IsGalois.card_aut_eq_finrank M L
  have hchain : Module.finrank F L ≤ Module.finrank M L := by
    calc Module.finrank F L ≤ Nat.card (W.inertiaSubgroup F) := htot
      _ = Nat.card (W.inertiaSubgroup M) := hmul
      _ ≤ Nat.card (L ≃ₐ[M] L) := le_trans hle1 hle2
      _ = Module.finrank M L := hcard
  have hprod : Module.finrank F M * Module.finrank M L = Module.finrank F L :=
    Module.finrank_mul_finrank F (M : Type _) L
  have hpos : 0 < Module.finrank M L := Module.finrank_pos
  refine IntermediateField.finrank_eq_one_iff.mp ?_
  have hab : Module.finrank F M * Module.finrank M L ≤ 1 * Module.finrank M L := by
    rw [hprod, one_mul]
    exact hchain
  have hle : Module.finrank F M ≤ 1 := Nat.le_of_mul_le_mul_right hab hpos
  have hposM : 0 < Module.finrank F (M : Type _) := Module.finrank_pos
  omega


/-- **At a totally ramified place, a subgroup containing inertia has trivial fixed field.**  The
block form of the previous two theorems: the stabiliser of a block contains the inertia generated by
a meridian transposition, so at a totally ramified place the block field is trivial. -/
theorem fixedField_eq_bot_of_inertia_le_of_totallyRamified
    (H : Subgroup (L ≃ₐ[F] L))
    (hAW : ∀ a : A, algebraMap A L a ∈ W) (hW : W ≠ ⊤)
    (p : Ideal A) (hp0 : p ≠ ⊥) [p.IsMaximal] [PerfectField p.ResidueField]
    (hcentA : ∀ a : A, (¬ IsUnit (⟨algebraMap A L a, hAW a⟩ : W)) ↔ a ∈ p)
    [PerfectField (intermediateCentre (IntermediateField.fixedField H) W hAW).ResidueField]
    (htot : Module.finrank F L ≤ Nat.card (W.inertiaSubgroup F))
    (hI : ∀ g : W.inertiaSubgroup F, ((g : W.decompositionSubgroup F) : L ≃ₐ[F] L) ∈ H) :
    IntermediateField.fixedField H = ⊥ :=
  intermediateField_eq_bot_of_unramified_of_totallyRamified _ W hAW hW p hp0 hcentA htot
    (ramificationIdx_fixedField_eq_one_of_inertia_le W H hAW hW p hp0 hcentA hI)

/-- **An unramified place stays unramified in every intermediate field.**  The orbit formula
`|I_F| = e · |I_M|` with `|I_F| = 1` leaves `e = 1`.  Together with
`ramificationIdx_fixedField_eq_one_of_inertia_le` this covers both halves of "the block field is
unramified at every place": at a branch place the inertia sits inside the block stabiliser, and
away from the branch locus the inertia is trivial. -/
theorem ramificationIdx_intermediateCentre_eq_one_of_inertia_trivial
    (hAW : ∀ a : A, algebraMap A L a ∈ W) (hW : W ≠ ⊤)
    (p : Ideal A) (hp0 : p ≠ ⊥) [p.IsMaximal] [PerfectField p.ResidueField]
    (hcentA : ∀ a : A, (¬ IsUnit (⟨algebraMap A L a, hAW a⟩ : W)) ↔ a ∈ p)
    [PerfectField (intermediateCentre M W hAW).ResidueField]
    (htriv : Nat.card (W.inertiaSubgroup F) = 1) :
    (intermediateCentre M W hAW).ramificationIdx A = 1 := by
  have hmul := natCard_inertiaSubgroup_eq_intermediate_mul M W hAW p hW hp0 hcentA
  rw [htriv] at hmul
  exact Nat.eq_one_of_mul_eq_one_right hmul.symm

end Unramified

end

end ValuationInertia
end GaloisForLFunctions.HTGeometry
