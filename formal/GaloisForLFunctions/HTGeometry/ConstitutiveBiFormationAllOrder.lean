import GaloisForLFunctions.HTGeometry.ConstitutiveBiFormationInterference
import Mathlib.LinearAlgebra.Multilinear.Basic

/-!
# All-order constitutive bi-formation interference

Higher cumulants are multilinear law tensors. Independent formation gives two tensor evaluations;
reciprocal Hadamard mixing puts a positive coefficient in every sum slot and two negative
coefficients in the difference slots of the second leg. Multilinearity generates the exact
all-order response, reconstruction, parity, flatness, conservation, and depth-properness laws.
-/

open scoped BigOperators

namespace GaloisForLFunctions.HTGeometry

/-- An order `k + 3` mixed response has `k + 1` sum slots and two difference slots. -/
abbrev HadamardCumulantIndex (k : ℕ) := Fin (k + 1) ⊕ Fin 2

/-- Coefficients of the first independent source leg. -/
def hadamardLeftCoefficients (k : ℕ) (a : ℝ) : HadamardCumulantIndex k → ℝ :=
  fun _ => a

/-- Coefficients of the second independent source leg: sum slots have sign `+`, while the two
difference slots have sign `-`. -/
def hadamardRightCoefficients (k : ℕ) (a : ℝ) : HadamardCumulantIndex k → ℝ :=
  Sum.elim (fun _ => a) (fun _ => -a)

/-- Order `k + 3` mixed response generated by independent formation followed by reciprocal
Hadamard mixing. -/
def hadamardTensorResponse (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ) (a : ℝ) : ℝ :=
  B (hadamardLeftCoefficients k a) + B (hadamardRightCoefficients k a)

private theorem prod_hadamardLeftCoefficients (k : ℕ) (a : ℝ) :
    ∏ i, hadamardLeftCoefficients k a i = a ^ (k + 3) := by
  simp [hadamardLeftCoefficients, pow_add]
  ring

private theorem prod_hadamardRightCoefficients (k : ℕ) (a : ℝ) :
    ∏ i, hadamardRightCoefficients k a i = a ^ (k + 3) := by
  simp [hadamardRightCoefficients, Fintype.prod_sum_type, pow_add]
  ring

section ModuleResponse

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- Module-valued response generated by the same two source legs. -/
def hadamardModuleResponse (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) V) (a : ℝ) : V :=
  B (hadamardLeftCoefficients k a) + B (hadamardRightCoefficients k a)

/-- Coordinate-free all-order fusion: the law holds for vector, matrix, operator, and quotient
responses, not only scalar cumulants. -/
theorem hadamardModuleResponse_eq (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) V) (a : ℝ) :
    hadamardModuleResponse k B a =
      (2 * a ^ (k + 3)) • B (fun _ => 1) := by
  have hleft := B.map_smul_univ (hadamardLeftCoefficients k a) (fun _ => (1 : ℝ))
  have hright := B.map_smul_univ (hadamardRightCoefficients k a) (fun _ => (1 : ℝ))
  simp only [smul_eq_mul, mul_one] at hleft hright
  rw [prod_hadamardLeftCoefficients] at hleft
  rw [prod_hadamardRightCoefficients] at hright
  unfold hadamardModuleResponse
  rw [hleft, hright, ← add_smul]
  congr 1
  ring

/-- Every fixed module response is realized by the canonical product tensor. -/
theorem hadamardModuleResponse_mkPiRing (k : ℕ) (v : V) (a : ℝ) :
    hadamardModuleResponse k (MultilinearMap.mkPiRing ℝ (HadamardCumulantIndex k) v) a =
      (2 * a ^ (k + 3)) • v := by
  rw [hadamardModuleResponse_eq]
  simp

/-- Linear observers commute with canonical module-valued packet formation. -/
theorem hadamardModuleResponse_map {W : Type*} [AddCommGroup W] [Module ℝ W]
    (k : ℕ) (f : V →ₗ[ℝ] W) (v : V) (a : ℝ) :
    f (hadamardModuleResponse k
        (MultilinearMap.mkPiRing ℝ (HadamardCumulantIndex k) v) a) =
      hadamardModuleResponse k
        (MultilinearMap.mkPiRing ℝ (HadamardCumulantIndex k) (f v)) a := by
  rw [hadamardModuleResponse_mkPiRing, hadamardModuleResponse_mkPiRing]
  exact f.map_smul _ _

/-- A split recovery kernel is information-neutral for every canonical module-valued packet. -/
theorem hadamardModuleResponse_split {W : Type*} [AddCommGroup W] [Module ℝ W]
    (k : ℕ) (encode : V →ₗ[ℝ] W) (decode : W →ₗ[ℝ] V)
    (hsplit : ∀ x, decode (encode x) = x) (v : V) (a : ℝ) :
    decode (hadamardModuleResponse k
        (MultilinearMap.mkPiRing ℝ (HadamardCumulantIndex k) (encode v)) a) =
      hadamardModuleResponse k
        (MultilinearMap.mkPiRing ℝ (HadamardCumulantIndex k) v) a := by
  rw [hadamardModuleResponse_mkPiRing, map_smul, hsplit,
    hadamardModuleResponse_mkPiRing]

end ModuleResponse

/-- All-order fusion law: two independent legs and two difference slots generate exactly twice the
order `k + 3` cumulant tensor. -/
theorem hadamardTensorResponse_eq (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ) (a : ℝ) :
    hadamardTensorResponse k B a =
      2 * a ^ (k + 3) * B (fun _ => 1) := by
  have hleft := B.map_smul_univ (hadamardLeftCoefficients k a) (fun _ => (1 : ℝ))
  have hright := B.map_smul_univ (hadamardRightCoefficients k a) (fun _ => (1 : ℝ))
  simp only [smul_eq_mul, mul_one] at hleft hright
  rw [prod_hadamardLeftCoefficients] at hleft
  rw [prod_hadamardRightCoefficients] at hright
  unfold hadamardTensorResponse
  rw [hleft, hright]
  ring

/-- Reflection acts on the order `k + 3` response by its exact parity character. -/
theorem hadamardTensorResponse_neg (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ) (a : ℝ) :
    hadamardTensorResponse k B (-a) =
      (-1 : ℝ) ^ (k + 3) * hadamardTensorResponse k B a := by
  rw [hadamardTensorResponse_eq, hadamardTensorResponse_eq]
  rw [show -a = (-1 : ℝ) * a by ring, mul_pow]
  ring

/-- At nonzero scale, one mixed response reconstructs the corresponding higher cumulant tensor on
the unit source direction. -/
theorem hadamardTensorResponse_div (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (ha : a ≠ 0) :
    hadamardTensorResponse k B a / (2 * a ^ (k + 3)) = B (fun _ => 1) := by
  rw [hadamardTensorResponse_eq]
  field_simp

/-- Exact all-order neutral locus for a nonzero cumulant tensor. -/
theorem hadamardTensorResponse_eq_zero_iff (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (hB : B (fun _ => 1) ≠ 0) (a : ℝ) :
    hadamardTensorResponse k B a = 0 ↔ a = 0 := by
  rw [hadamardTensorResponse_eq]
  simp [hB]

/-- Independent formation adds response tensors exactly. -/
theorem hadamardTensorResponse_add (k : ℕ)
    (B C : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ) (a : ℝ) :
    hadamardTensorResponse k (B + C) a =
      hadamardTensorResponse k B a + hadamardTensorResponse k C a := by
  simp [hadamardTensorResponse]
  ring

/-- Complete higher-cumulant response spectrum. -/
def hadamardResponseSpectrum
    (J : (k : ℕ) → MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (k : ℕ) : ℝ :=
  hadamardTensorResponse k (J k) a

/-- Nonzero-scale flatness is equivalent to vanishing of the entire higher-cumulant tower. -/
theorem hadamardResponseSpectrum_flat_iff
    (J : (k : ℕ) → MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (ha : a ≠ 0) :
    (∀ k, hadamardResponseSpectrum J a k = 0) ↔
      ∀ k, J k (fun _ => 1) = 0 := by
  constructor
  · intro h k
    have hk := h k
    rw [hadamardResponseSpectrum, hadamardTensorResponse_eq] at hk
    exact (mul_eq_zero.mp hk).resolve_left (mul_ne_zero (by norm_num) (pow_ne_zero _ ha))
  · intro h k
    rw [hadamardResponseSpectrum, hadamardTensorResponse_eq, h k, mul_zero]

/-- Independent depth amplifies each generated higher response linearly. -/
def hadamardTensorDepthCurrent (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (m : ℕ) : ℝ :=
  (m : ℝ) * hadamardTensorResponse k B a

/-- Independent formation depths add at every cumulant order. -/
theorem hadamardTensorDepthCurrent_add (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (m n : ℕ) :
    hadamardTensorDepthCurrent k B a (m + n) =
      hadamardTensorDepthCurrent k B a m + hadamardTensorDepthCurrent k B a n := by
  simp [hadamardTensorDepthCurrent, Nat.cast_add]
  ring

/-- Mean-normalized formation has an exact homogeneous conservation law. The factor multiplying
the depth current is forced by the response order. -/
theorem hadamardTensor_meanNormalized_conservation (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (m : ℕ) (hm : m ≠ 0) :
    (m : ℝ) ^ (k + 2) *
        hadamardTensorDepthCurrent k B (a / (m : ℝ)) m =
      hadamardTensorResponse k B a := by
  rw [hadamardTensorResponse_eq, hadamardTensorDepthCurrent,
    hadamardTensorResponse_eq]
  norm_num [div_pow]
  field_simp
  ring

/-- Variance-normalized square formation also has an exact conserved charge. Raw higher response
can decay off the neutral locus, so unrenormalized boundedness is not gauge invariant. -/
theorem hadamardTensor_varianceNormalized_conservation (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (a : ℝ) (m : ℕ) (hm : m ≠ 0) :
    (m : ℝ) ^ (k + 1) *
        hadamardTensorDepthCurrent k B (a / (m : ℝ)) (m ^ (2 : ℕ)) =
      hadamardTensorResponse k B a := by
  rw [hadamardTensorResponse_eq, hadamardTensorDepthCurrent,
    hadamardTensorResponse_eq]
  norm_num [div_pow]
  field_simp
  ring

/-- All-order global properness: a surviving higher cumulant makes bounded formation depth
equivalent to neutral scale. -/
theorem hadamardTensorDepthCurrent_bounded_iff (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (hB : B (fun _ => 1) ≠ 0) (a : ℝ) :
    (∃ C : ℝ, ∀ m : ℕ, |hadamardTensorDepthCurrent k B a m| ≤ C) ↔ a = 0 := by
  rw [show (∃ C : ℝ, ∀ m : ℕ, |hadamardTensorDepthCurrent k B a m| ≤ C) ↔
      hadamardTensorResponse k B a = 0 by
    simpa [hadamardTensorDepthCurrent] using natDepth_bounded_iff_zero
      (hadamardTensorResponse k B a)]
  exact hadamardTensorResponse_eq_zero_iff k B hB a

/-- Closed all-order capstone: exact response, reconstruction, parity, tower flatness, independent
formation conservation, and global depth properness. -/
theorem biFormationAllOrder_capstone (k : ℕ)
    (B : MultilinearMap ℝ (fun _ : HadamardCumulantIndex k => ℝ) ℝ)
    (hB : B (fun _ => 1) ≠ 0) (a : ℝ) (ha : a ≠ 0) :
    hadamardTensorResponse k B a = 2 * a ^ (k + 3) * B (fun _ => 1) ∧
      hadamardTensorResponse k B (-a) =
        (-1 : ℝ) ^ (k + 3) * hadamardTensorResponse k B a ∧
      hadamardTensorResponse k B a / (2 * a ^ (k + 3)) = B (fun _ => 1) ∧
      (hadamardTensorResponse k B a = 0 ↔ a = 0) ∧
      ((∃ C : ℝ, ∀ m : ℕ, |hadamardTensorDepthCurrent k B a m| ≤ C) ↔ a = 0) := by
  exact ⟨hadamardTensorResponse_eq k B a,
    hadamardTensorResponse_neg k B a,
    hadamardTensorResponse_div k B a ha,
    hadamardTensorResponse_eq_zero_iff k B hB a,
    hadamardTensorDepthCurrent_bounded_iff k B hB a⟩

end GaloisForLFunctions.HTGeometry
