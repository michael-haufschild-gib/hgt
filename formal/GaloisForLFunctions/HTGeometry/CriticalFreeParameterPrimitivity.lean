import GaloisForLFunctions.HTGeometry.FracXTranscendental
import GaloisForLFunctions.HTGeometry.Critical.Geometric.FieldPrimitivity

/-!
# The critical tower keeps its primitivity over a free parameter

Adjoining an independent transcendental to the observation field does not create an intermediate
field below the source: the base-change lattice theorem applies to the critical normal closure, whose
Galois group is full by monodromy.

This is the third input of the one-step rigidity assembly, the other two being that the postcritical
reciprocal coordinate lies in the source extended by the new raw coordinate, and that it escapes the
observation field extended by it.
-/

open IntermediateField

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 4000000

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Pulling an intermediate field back along an embedding and pushing it forward again returns it,
provided it sits inside the range. -/
theorem map_comap_eq_of_le_fieldRange {F L L' : Type*} [Field F] [Field L] [Field L']
    [Algebra F L] [Algebra F L'] (f : L →ₐ[F] L') (P : IntermediateField F L')
    (hP : P ≤ f.fieldRange) : (P.comap f).map f = P := by
  refine le_antisymm ?_ ?_
  · rintro y ⟨x, hx, rfl⟩
    exact hx
  · intro y hy
    obtain ⟨x, rfl⟩ := hP hy
    exact ⟨x, hy, rfl⟩

/-- **Primitivity transports along an embedding.**  If no field lies strictly between the base and
`R`, then none lies strictly between the base and the image of `R`. -/
theorem primitive_map_of_primitive {F L L' : Type*} [Field F] [Field L] [Field L']
    [Algebra F L] [Algebra F L'] (f : L →ₐ[F] L') (R : IntermediateField F L)
    (hR : ∀ P : IntermediateField F L, P ≤ R → P = ⊥ ∨ P = R)
    (P : IntermediateField F L') (hP : P ≤ R.map f) : P = ⊥ ∨ P = R.map f := by
  have hPrange : P ≤ f.fieldRange := by
    refine le_trans hP ?_
    rintro y ⟨x, -, rfl⟩
    exact ⟨x, rfl⟩
  have hmapcomap : (P.comap f).map f = P := map_comap_eq_of_le_fieldRange f P hPrange
  have hcomaple : P.comap f ≤ R := by
    intro x hx
    obtain ⟨z, hz, hzeq⟩ := hP hx
    have hxz : x = z := f.toRingHom.injective hzeq.symm
    rw [hxz]
    exact hz
  rcases hR (P.comap f) hcomaple with h | h
  · left
    rw [← hmapcomap, h, IntermediateField.map_bot]
  · right
    rw [← hmapcomap, h]

/-- **A primitive step is generated by any escaping element.** -/
theorem adjoin_eq_of_primitive_of_notMem_bot {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (R : IntermediateField F Ω)
    (hprim : ∀ P : IntermediateField F Ω, P ≤ R → P = ⊥ ∨ P = R)
    (y : Ω) (hy : y ∈ R) (hynot : y ∉ (⊥ : IntermediateField F Ω)) :
    IntermediateField.adjoin F {y} = R := by
  have hle : IntermediateField.adjoin F {y} ≤ R := by
    refine IntermediateField.adjoin_le_iff.2 ?_
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact hy
  rcases hprim _ hle with h | h
  · exfalso
    refine hynot ?_
    rw [← h]
    exact IntermediateField.mem_adjoin_simple_self F y
  · exact h

/-- Membership in the bottom of a tower over an intermediate field is membership in that field. -/
theorem mem_bot_iff_mem {F L : Type*} [Field F] [Field L] [Algebra F L]
    (S : IntermediateField F L) (x : L) :
    x ∈ (⊥ : IntermediateField ↥S L) ↔ x ∈ S := by
  constructor
  · rintro ⟨y, rfl⟩
    exact y.2
  · intro hx
    exact ⟨⟨x, hx⟩, rfl⟩

/-- **Base-changed one-step rigidity, abstractly.**  A primitive step stays primitive after
adjoining a transcendental, and any escaping element of the extended step generates it. -/
theorem adjoin_eq_map_of_primitive_of_notMem
    {F A B Ω : Type*} [Field F] [Field A] [Field B] [Field Ω]
    [Algebra F A] [Algebra F B] [Algebra A Ω] [Algebra F Ω] [IsScalarTower F A Ω]
    [FiniteDimensional F B] [IsGalois F B]
    (φ : A →ₐ[F] B)
    (hprim : ∀ P : IntermediateField F B, P ≤ φ.fieldRange → P = ⊥ ∨ P = φ.fieldRange)
    {t : Ω} (ht : Transcendental A t)
    (y : ↥(IntermediateField.adjoin A {t}))
    (hy : (y : Ω) ∉ IntermediateField.adjoin F {t}) :
    IntermediateField.adjoin ↥(IntermediateField.adjoin F {fracX B}) {adjoinToFrac φ ht y}
      = IntermediateField.adjoin ↥(IntermediateField.adjoin F {fracX B})
        (((φ.fieldRange : IntermediateField F B).map
          (IsScalarTower.toAlgHom F B (FractionRing (Polynomial B)))) :
          Set (FractionRing (Polynomial B))) := by
  have hJle : ((φ.fieldRange : IntermediateField F B).map
      (IsScalarTower.toAlgHom F B (FractionRing (Polynomial B))))
      ≤ fracCoeffField F B := by
    rintro z ⟨w, -, rfl⟩
    exact ⟨w, rfl⟩
  have hprim' : ∀ P : IntermediateField F (FractionRing (Polynomial B)),
      P ≤ (φ.fieldRange : IntermediateField F B).map
        (IsScalarTower.toAlgHom F B (FractionRing (Polynomial B))) →
      P = ⊥ ∨ P = (φ.fieldRange : IntermediateField F B).map
        (IsScalarTower.toAlgHom F B (FractionRing (Polynomial B))) :=
    primitive_map_of_primitive _ _ hprim
  refine adjoin_eq_of_primitive_of_notMem_bot _
    (eq_bot_or_eq_adjoin_fracX_of_primitive _ hJle hprim') _ ?_ ?_
  · exact fracMap_mem_adjoin φ ((fracRealizeEquiv ht).symm y)
  · intro hbot
    refine adjoinToFrac_notMem_of_notMem φ ht y hy ?_
    rw [fieldRange_fracMap_ofId]
    exact (mem_bot_iff_mem (IntermediateField.adjoin F {fracX B}) _).1 hbot

/-- The compositum with a simple adjunction, read over the bigger base. -/
theorem mem_adjoin_of_mem_sup {K L : Type*} [Field K] [Field L] [Algebra K L]
    (A : IntermediateField K L) (t : L) {x : L}
    (hx : x ∈ A ⊔ IntermediateField.adjoin K {t}) :
    x ∈ IntermediateField.adjoin ↥A {t} := by
  have hres : (IntermediateField.adjoin ↥A {t}).restrictScalars K
      = IntermediateField.adjoin K ((A : Set L) ∪ {t}) :=
    IntermediateField.restrictScalars_adjoin K A {t}
  have hsup : A ⊔ IntermediateField.adjoin K {t}
      ≤ IntermediateField.adjoin K ((A : Set L) ∪ {t}) := by
    refine sup_le (fun z hz => IntermediateField.subset_adjoin _ _ (Or.inl hz)) ?_
    refine IntermediateField.adjoin_le_iff.2 fun z hz => ?_
    exact IntermediateField.subset_adjoin _ _ (Or.inr hz)
  have : x ∈ (IntermediateField.adjoin ↥A {t}).restrictScalars K := by
    rw [hres]
    exact hsup hx
  exact this

/-- The converse reading. -/
theorem mem_sup_of_mem_adjoin {K L : Type*} [Field K] [Field L] [Algebra K L]
    (A : IntermediateField K L) (t : L) {x : L}
    (hx : x ∈ IntermediateField.adjoin ↥A {t}) :
    x ∈ A ⊔ IntermediateField.adjoin K {t} := by
  have hres : (IntermediateField.adjoin ↥A {t}).restrictScalars K
      = IntermediateField.adjoin K ((A : Set L) ∪ {t}) :=
    IntermediateField.restrictScalars_adjoin K A {t}
  have hx' : x ∈ IntermediateField.adjoin K ((A : Set L) ∪ {t}) := by
    rw [← hres]
    exact hx
  refine (IntermediateField.adjoin_le_iff.2 ?_) hx'
  rintro z (hz | hz)
  · exact le_sup_left (α := IntermediateField K L) hz
  · rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact le_sup_right (α := IntermediateField K L)
      (IntermediateField.mem_adjoin_simple_self K t)

variable (K : Type*) [Field K] [CharZero K] [IsAlgClosed K]

/-- The embedded critical source field, inside the rational functions over the normal closure. -/
def criticalSourceFracRange (m n : ℕ) :
    IntermediateField ↥(criticalObservationField K m n)
      (FractionRing (Polynomial ↥(criticalNormalClosure K m n))) :=
  ((criticalSourceNormalClosureEmbedding K m n).fieldRange).map
    (IsScalarTower.toAlgHom ↥(criticalObservationField K m n)
      ↥(criticalNormalClosure K m n)
      (FractionRing (Polynomial ↥(criticalNormalClosure K m n))))

/-- **Primitivity survives the free parameter.**  Given full geometric monodromy, no field lies
strictly between the observation field extended by a free parameter and the source field extended by
it. -/
theorem eq_bot_or_eq_adjoin_criticalSourceFracRange_of_full_monodromy
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (hfull : criticalGeometricMonodromy K m n = ⊤)
    (M : IntermediateField
      ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
        {fracX ↥(criticalNormalClosure K m n)})
      (FractionRing (Polynomial ↥(criticalNormalClosure K m n))))
    (hM : M ≤ IntermediateField.adjoin
      ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
        {fracX ↥(criticalNormalClosure K m n)})
      (criticalSourceFracRange K m n : Set (FractionRing
        (Polynomial ↥(criticalNormalClosure K m n))))) :
    M = ⊥ ∨ M = IntermediateField.adjoin
      ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
        {fracX ↥(criticalNormalClosure K m n)})
      (criticalSourceFracRange K m n : Set (FractionRing
        (Polynomial ↥(criticalNormalClosure K m n)))) := by
  classical
  letI : FiniteDimensional (criticalObservationField K m n)
      (criticalSourceField K m n) :=
    criticalSourceField_finiteDimensional_criticalObservationField K hm hn
  letI : FiniteDimensional (criticalObservationField K m n)
      (criticalNormalClosure K m n) :=
    criticalNormalClosure_finiteDimensional K hm hn
  letI : Algebra.IsSeparable (criticalObservationField K m n)
      (criticalSourceField K m n) := inferInstance
  letI : IsScalarTower (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n) :=
    AlgebraicClosure.instIsScalarTower (criticalSourceField K m n)
  letI : Algebra.IsAlgebraic (criticalObservationField K m n)
      (criticalSourceAlgebraicClosure K m n) :=
    Algebra.IsAlgebraic.trans (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n)
  letI : Normal (criticalObservationField K m n)
      (criticalSourceAlgebraicClosure K m n) :=
    { splits' _ := IsAlgClosed.splits _ }
  letI : Normal (criticalObservationField K m n)
      (criticalNormalClosure K m n) :=
    normalClosure.normal (criticalObservationField K m n)
      (criticalSourceField K m n) (criticalSourceAlgebraicClosure K m n)
  letI : IsGalois (criticalObservationField K m n)
      (criticalNormalClosure K m n) := inferInstance
  refine eq_bot_or_eq_adjoin_fracX_of_primitive
    (F := ↥(criticalObservationField K m n)) (E := ↥(criticalNormalClosure K m n))
    (criticalSourceFracRange K m n) ?_ ?_ M hM
  · rintro y ⟨x, -, rfl⟩
    exact ⟨x, rfl⟩
  · refine primitive_map_of_primitive _ _ ?_
    intro P hP
    exact eq_bot_or_eq_criticalSourceNormalClosureFieldRange_of_full_monodromy K hm hn hfull P hP

/-- **The base-changed one-step rigidity.**  Given full geometric monodromy, any element of the
source field extended by the free parameter which escapes the observation field extended by it
generates the whole extended source field. -/
theorem adjoin_eq_criticalSourceFracRange_of_notMem_bot
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (hfull : criticalGeometricMonodromy K m n = ⊤)
    (y : FractionRing (Polynomial ↥(criticalNormalClosure K m n)))
    (hy : y ∈ IntermediateField.adjoin
      ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
        {fracX ↥(criticalNormalClosure K m n)})
      (criticalSourceFracRange K m n : Set (FractionRing
        (Polynomial ↥(criticalNormalClosure K m n)))))
    (hynot : y ∉ (⊥ : IntermediateField
      ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
        {fracX ↥(criticalNormalClosure K m n)})
      (FractionRing (Polynomial ↥(criticalNormalClosure K m n))))) :
    IntermediateField.adjoin
        ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
          {fracX ↥(criticalNormalClosure K m n)}) {y}
      = IntermediateField.adjoin
        ↥(IntermediateField.adjoin ↥(criticalObservationField K m n)
          {fracX ↥(criticalNormalClosure K m n)})
        (criticalSourceFracRange K m n : Set (FractionRing
          (Polynomial ↥(criticalNormalClosure K m n)))) :=
  adjoin_eq_of_primitive_of_notMem_bot _
    (eq_bot_or_eq_adjoin_criticalSourceFracRange_of_full_monodromy K hm hn hfull) y hy hynot

end GaloisForLFunctions.HTGeometry

