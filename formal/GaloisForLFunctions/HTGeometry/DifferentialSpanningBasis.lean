import GaloisForLFunctions.HTGeometry.DifferentialTranscendenceDegree

/-!
# A spanning family of the right size is a differential transcendence basis

If every element of a differential field is differentially algebraic over a finite family, that family
spans the differential matroid.  A spanning set contains a basis, and a basis has as many elements as
the differential transcendence degree; so a spanning family with no more members than the degree has
exactly that many, all of them needed — it is differentially independent.

This is the step that converts a generation statement plus a dimension count into independence, which
is what a transcendence-degree computation for a generated subfield needs.
-/

namespace GaloisForLFunctions

open Set

noncomputable section

universe u

variable {F E : Type u} [Field F] [Field E] [Algebra F E]
variable [Differential F] [Differential E] [DifferentialAlgebra F E] [CharZero E]

omit [CharZero E] in
/-- **Enlarging the coefficient field of a differential-algebraicity statement.**  What is
differentially algebraic over the field generated by `S` stays so over the field generated by `S` and
anything else. -/
theorem differentialAlgebraicOver_differentialAdjoin_adjoin {S I : Set E}
    [DifferentialAlgebra (differentialAdjoin F I) E] {y : E}
    (hy : DifferentialAlgebraicOver (differentialAdjoin F S) y) :
    DifferentialAlgebraicOver (differentialAdjoin (differentialAdjoin F I) S) y :=
  HTGeometry.differentialAlgebraicOver_mono_differentialAdjoin_narrow
    ((differentialAdjoin (differentialAdjoin F I) S).restrictScalars F)
    (derivationClosed_differentialAdjoin (differentialAdjoin F I) S)
    (subset_differentialAdjoin (differentialAdjoin F I) S) hy

/-- **A finite spanning family of no more than the differential transcendence degree is
independent.** -/
theorem diffIndepOn_of_finite_spanning_of_cardinalMk_le {S : Set E}
    (hSfin : S.Finite) (hSne : S.Nonempty)
    (hspan : ∀ y : E, DifferentialAlgebraicOver (differentialAdjoin F S) y)
    (hcard : Cardinal.mk S ≤ differentialTranscendenceDegree F E) :
    DiffIndepOn F S := by
  classical
  haveI : Finite S := hSfin.to_subtype
  haveI : Nonempty S := hSne.to_subtype
  obtain ⟨I, hI⟩ := (differentialMatroid F E).exists_isBasis S
  letI : Differential ↥(differentialAdjoin F I) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin F I)
  letI : DifferentialAlgebra ↥(differentialAdjoin F I) E :=
    ⟨fun c => derivationClosedDifferential_apply _ (derivationClosed_differentialAdjoin F I) c⟩
  have hIind : DiffIndepOn F I := hI.indep
  -- every generator is differentially algebraic over the basis
  have hSB : ∀ z : S, DifferentialAlgebraicOver (differentialAdjoin F I) (z : E) := fun z =>
    (differentialMatroid_mem_closure_iff_of_indep hIind (z : E)).1 (hI.subset_closure z.2)
  -- hence so is everything, by transitivity across the finite family
  have hall : ∀ y : E, DifferentialAlgebraicOver (differentialAdjoin F I) y := by
    intro y
    refine differentialAlgebraicOver_trans_finite_nonempty
      (F := differentialAdjoin F I) (fun z : S => (z : E)) hSB y ?_
    have hrange : Set.range (fun z : S => (z : E)) = S := Subtype.range_val
    rw [hrange]
    exact differentialAlgebraicOver_differentialAdjoin_adjoin (hspan y)
  -- the basis of `S` is a basis of the whole matroid
  have hclosure : (differentialMatroid F E).closure I = (differentialMatroid F E).E := by
    rw [differentialMatroid_ground]
    refine Set.eq_univ_of_forall fun y => ?_
    exact (differentialMatroid_mem_closure_iff_of_indep hIind y).2 (hall y)
  have hbase : (differentialMatroid F E).IsBase I :=
    (differentialMatroid F E).isBase_iff_indep_closure_eq.mpr ⟨hIind, hclosure⟩
  -- counting: the basis is all of `S`
  have hIcard : Cardinal.mk I = differentialTranscendenceDegree F E := hbase.cardinalMk_eq_cRank
  have hle : Cardinal.mk S ≤ Cardinal.mk I := by
    rw [hIcard]
    exact hcard
  have hIsub : I ⊆ S := hI.subset
  have hIfin : I.Finite := hSfin.subset hIsub
  have hncard : S.ncard ≤ I.ncard := by
    have h1 : (Cardinal.mk S).toNat ≤ (Cardinal.mk I).toNat :=
      Cardinal.toNat_le_toNat hle (Set.Finite.lt_aleph0 hIfin)
    have hS : S.ncard = (Cardinal.mk S).toNat := by
      rw [← Nat.card_coe_set_eq]
      rfl
    have hI' : I.ncard = (Cardinal.mk I).toNat := by
      rw [← Nat.card_coe_set_eq]
      rfl
    rw [hS, hI']
    exact h1
  have : I = S := Set.eq_of_subset_of_ncard_le hIsub hncard hSfin
  rwa [this] at hIind

/-- **A spanning family of the right size is a differential transcendence basis.**  An injective
family of at most `dtrdeg`-many elements over which everything is differentially algebraic is
differentially independent. -/
theorem differentialIndependent_of_spanning_of_cardinalMk_le {ι : Type u} [Finite ι] [Nonempty ι]
    (x : ι → E) (hinj : Function.Injective x)
    (hspan : ∀ y : E, DifferentialAlgebraicOver (differentialAdjoin F (Set.range x)) y)
    (hcard : Cardinal.mk ι ≤ differentialTranscendenceDegree F E) :
    DifferentialIndependent F x := by
  have hrange : Cardinal.mk (Set.range x) = Cardinal.mk ι := Cardinal.mk_range_eq x hinj
  have hset : DiffIndepOn F (Set.range x) :=
    diffIndepOn_of_finite_spanning_of_cardinalMk_le (Set.finite_range x)
      (Set.range_nonempty x) hspan (by rw [hrange]; exact hcard)
  have hequiv : DifferentialIndependent F (Subtype.val : Set.range x → E) := hset
  have := hequiv.comp (Set.rangeFactorization x) fun a b hab => hinj (congrArg Subtype.val hab)
  simpa [Function.comp_def, Set.rangeFactorization] using this

end

end GaloisForLFunctions
