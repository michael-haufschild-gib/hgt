import GaloisForLFunctions.HTGeometry.GeneralExteriorPrincipalSymbolDecoder

/-!
# A linear-width three-step principal-symbol detector

For a law space with `n` coordinates, only `2n+1` state coordinates are needed to retain every
coordinate bivector once cubic nilpotence is allowed.  The state has a lower copy of the law
coordinates, one membrane state, and an upper copy.  Generator `i` moves its own lower coordinate
to the membrane and the membrane to its own upper coordinate.

Every linear combination of generators therefore has cube zero.  Nevertheless, the commutator
of generators `i < j` has a private matrix coefficient from lower `j` to upper `i`.  Evaluation of
those coefficients is an explicit decoder for the full exterior principal symbol.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u v

variable {K : Type u} [Field K] [CharZero K]
  {M : Type v} [AddCommGroup M] [Module K M]
  {n : ℕ}

/-- Two copies of the law coordinates separated by a single interaction membrane. -/
inductive LinearWidthDetectorIndex (n : ℕ)
  | lower (i : Fin n)
  | membrane
  | upper (i : Fin n)
  deriving DecidableEq, Fintype

/-- The detector boundary is two copies of the law coordinates and one membrane point. -/
def linearWidthDetectorIndexEquiv (n : ℕ) :
    LinearWidthDetectorIndex n ≃ (Fin n ⊕ (Unit ⊕ Fin n)) where
  toFun
    | .lower i => Sum.inl i
    | .membrane => Sum.inr (Sum.inl ())
    | .upper i => Sum.inr (Sum.inr i)
  invFun
    | Sum.inl i => .lower i
    | Sum.inr (Sum.inl _) => .membrane
    | Sum.inr (Sum.inr i) => .upper i
  left_inv x := by cases x <;> rfl
  right_inv x := by rcases x with i | (_ | i) <;> rfl

/-- The exact internal coordinate width of the membrane detector is `2n+1`. -/
theorem linearWidthDetectorIndex_card (n : ℕ) :
    Fintype.card (LinearWidthDetectorIndex n) = 2 * n + 1 := by
  rw [Fintype.card_congr (linearWidthDetectorIndexEquiv n)]
  simp
  omega

/-- Amplitudes on the linear-width detector boundary. -/
abbrev LinearWidthDetectorState (M : Type v) (n : ℕ) :=
  LinearWidthDetectorIndex n → M

/-- A lower-coordinate amplitude. -/
def linearWidthDetectorLowerState (i : Fin n) (m : M) :
    LinearWidthDetectorState M n :=
  Pi.single (.lower i) m

/-- The unique membrane amplitude. -/
def linearWidthDetectorMembraneState (m : M) :
    LinearWidthDetectorState M n :=
  Pi.single .membrane m

/-- An upper-coordinate amplitude. -/
def linearWidthDetectorUpperState (i : Fin n) (m : M) :
    LinearWidthDetectorState M n :=
  Pi.single (.upper i) m

/-- Generator `i` crosses lower `i` to the membrane and the membrane to upper `i`. -/
def linearWidthDetectorGenerator (i : Fin n) :
    Module.End K (LinearWidthDetectorState M n) where
  toFun f
    | .lower _ => 0
    | .membrane => f (.lower i)
    | .upper j => if j = i then f .membrane else 0
  map_add' f g := by
    funext x
    cases x with
    | lower j => simp
    | membrane => simp
    | upper j => by_cases hji : j = i <;> simp [hji]
  map_smul' c f := by
    funext x
    cases x with
    | lower j => simp
    | membrane => simp
    | upper j => by_cases hji : j = i <;> simp [hji]

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorGenerator_lower_apply
    (i j : Fin n) (f : LinearWidthDetectorState M n) :
    linearWidthDetectorGenerator (K := K) i f (.lower j) = 0 :=
  rfl

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorGenerator_membrane_apply
    (i : Fin n) (f : LinearWidthDetectorState M n) :
    linearWidthDetectorGenerator (K := K) i f .membrane = f (.lower i) :=
  rfl

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorGenerator_upper_apply
    (i j : Fin n) (f : LinearWidthDetectorState M n) :
    linearWidthDetectorGenerator (K := K) i f (.upper j) =
      if j = i then f .membrane else 0 :=
  rfl

/-- The linear pencil generated by the membrane-crossing operators. -/
def linearWidthDetectorSymbol :
    (Fin n → K) →ₗ[K] Module.End K (LinearWidthDetectorState M n) :=
  quantumGeneratorSymbol (fun i : Fin n ↦ linearWidthDetectorGenerator (K := K) (M := M) i)

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorSymbol_basisFun (i : Fin n) :
    linearWidthDetectorSymbol (K := K) (M := M) (Pi.basisFun K (Fin n) i) =
      linearWidthDetectorGenerator (K := K) (M := M) i := by
  exact quantumGeneratorSymbol_basisFun
    (fun j : Fin n ↦ linearWidthDetectorGenerator (K := K) (M := M) j) i

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorSymbol_lower_apply
    (c : Fin n → K) (f : LinearWidthDetectorState M n) (j : Fin n) :
    linearWidthDetectorSymbol (K := K) (M := M) c f (.lower j) = 0 := by
  classical
  simp [linearWidthDetectorSymbol, quantumGeneratorSymbol,
    Fintype.linearCombination_apply]

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorSymbol_membrane_apply
    (c : Fin n → K) (f : LinearWidthDetectorState M n) :
    linearWidthDetectorSymbol (K := K) (M := M) c f .membrane =
      ∑ i, c i • f (.lower i) := by
  classical
  simp [linearWidthDetectorSymbol, quantumGeneratorSymbol,
    Fintype.linearCombination_apply]

omit [CharZero K] in
@[simp]
theorem linearWidthDetectorSymbol_upper_apply
    (c : Fin n → K) (f : LinearWidthDetectorState M n) (j : Fin n) :
    linearWidthDetectorSymbol (K := K) (M := M) c f (.upper j) =
      c j • f .membrane := by
  classical
  simp [linearWidthDetectorSymbol, quantumGeneratorSymbol,
    Fintype.linearCombination_apply]

omit [CharZero K] in
/-- Every value of the membrane pencil is three-step nilpotent. -/
theorem linearWidthDetectorSymbol_cube_zero
    (c : Fin n → K) :
    (linearWidthDetectorSymbol (K := K) (M := M) c) ^ (3 : ℕ) = 0 := by
  classical
  apply LinearMap.ext
  intro f
  funext x
  cases x with
  | lower j =>
      simp [pow_succ, Module.End.mul_apply]
  | membrane =>
      simp [pow_succ, Module.End.mul_apply]
  | upper j =>
      simp [pow_succ, Module.End.mul_apply]

omit [CharZero K] in
/-- Cubic nilpotence supplies every higher-degree zero law. -/
theorem linearWidthDetectorSymbol_pow_zero
    {d : ℕ} (hd : 3 ≤ d) (c : Fin n → K) :
    (linearWidthDetectorSymbol (K := K) (M := M) c) ^ d = 0 := by
  rw [show d = 3 + (d - 3) by omega, pow_add,
    linearWidthDetectorSymbol_cube_zero]
  simp

omit [CharZero K] in
/-- Read one private lower-to-upper matrix coefficient for each increasing pair. -/
def linearWidthDetectorPairReadout (m : M) :
    Module.End K (LinearWidthDetectorState M n) →ₗ[K]
      (QuantumLawPair (Fin n) → M) where
  toFun A p :=
    A (linearWidthDetectorLowerState p.upper m) (.upper p.lower)
  map_add' A B := by
    funext p
    simp
  map_smul' c A := by
    funext p
    simp

omit [CharZero K] in
/-- A coordinate bracket is read as its own pair basis state. -/
theorem linearWidthDetectorPairReadout_principalBracketPair
    (m : M) (r : QuantumLawPair (Fin n)) :
    linearWidthDetectorPairReadout (K := K) (n := n) m
        (principalBracketPair (linearWidthDetectorSymbol (K := K) (M := M)) r) =
      Pi.single r m := by
  classical
  funext p
  rw [principalBracketPair,
    linearWidthDetectorSymbol_basisFun,
    linearWidthDetectorSymbol_basisFun]
  by_cases hpr : p = r
  · subst p
    simp [linearWidthDetectorPairReadout,
      linearWidthDetectorLowerState,
      Module.End.mul_apply, ne_of_lt r.isLt]
  · have hcoordinates : p.lower ≠ r.lower ∨ p.upper ≠ r.upper := by
      by_contra h
      push Not at h
      apply hpr
      cases p
      cases r
      simp_all
    have hreverse : ¬ (p.upper = r.lower ∧ p.lower = r.upper) := by
      rintro ⟨hu, hl⟩
      have hback : p.upper < p.lower := by simpa [hu, hl] using r.isLt
      exact (not_lt_of_ge (le_of_lt p.isLt)) hback
    simp [linearWidthDetectorPairReadout,
      linearWidthDetectorLowerState,
      Module.End.mul_apply, Pi.single_apply, hpr]
    by_cases h₁ : p.lower = r.lower <;>
      by_cases h₂ : r.upper = p.upper <;>
      by_cases h₃ : p.lower = r.upper <;>
      by_cases h₄ : r.lower = p.upper <;>
      simp_all

omit [CharZero K] in
/-- The coordinate brackets of the linear-width detector are linearly independent. -/
theorem linearWidthDetector_principalBracketPair_linearIndependent
    (m : M) (hm : m ≠ 0) :
    LinearIndependent K
      (principalBracketPair
        (linearWidthDetectorSymbol (K := K) (M := M) (n := n))) := by
  classical
  apply LinearIndependent.of_comp
    (linearWidthDetectorPairReadout (K := K) (n := n) m)
  have hsingle : LinearIndependent K
      (fun p : QuantumLawPair (Fin n) ↦
        (Pi.single p m : QuantumLawPair (Fin n) → M)) :=
    Pi.linearIndependent_single_of_ne_zero (R := K) (fun _p ↦ hm)
  simpa [Function.comp_def,
    linearWidthDetectorPairReadout_principalBracketPair] using hsingle

omit [CharZero K] in
/-- **Linear-width maximal principal-symbol theorem.**  A `2n+1`-coordinate, cube-zero packet
already detects the entire exterior square of an `n`-coordinate law space. -/
theorem linearWidthDetector_endomorphismCommutatorMap_injective
    (m : M) (hm : m ≠ 0) :
    Function.Injective
      (endomorphismCommutatorMap
        (linearWidthDetectorSymbol (K := K) (M := M) (n := n))) :=
  endomorphismCommutatorMap_injective_of_principalBracketPair_linearIndependent
    (linearWidthDetectorSymbol (K := K) (M := M) (n := n))
    (linearWidthDetector_principalBracketPair_linearIndependent (n := n) m hm)

end

end GaloisForLFunctions.HTGeometry
