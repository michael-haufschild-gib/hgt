import GaloisForLFunctions.HTGeometry.BohrAlmostPeriodic
import Mathlib.MeasureTheory.Integral.IntervalIntegral.Basic

/-!
# The Bohr mean value of an almost-periodic function

Every continuous Bohr almost-periodic function has a mean value

`M(f) = lim_{T → ∞} (1/T) ∫₀ᵀ f`.

Mathlib has no almost-periodic theory, so the theorem is proved here from the definition.  It is the
object on which the whole Bohr spectrum rests: the Bohr coefficient at a frequency `λ` is the mean of
`f(t)e^{-iλt}`, and the frequency module whose rational rank the finite-phase theorem bounds is
generated by the frequencies with nonzero coefficient.

The proof is Bohr's.  Relative density of `ε`-almost periods lets a window of *fixed* length `T` be
transported into every block `[jT, (j+1)T]` at the cost of `εT` (the almost-period error) plus
`2CL` (the two end pieces of length at most the inclusion length `L`).  Summing over the
`⌊T'/T⌋` blocks of `[0, T']` and dividing shows that the window averages over `[0, T']` cluster
around the single average over `[0, T]` up to `ε + 2CL/T + 2CT/T'`.  Choosing `T` large against
`L` and then `T'` large against `T` makes the family Cauchy, and completeness supplies the limit.
-/

open Filter Topology MeasureTheory

namespace GaloisForLFunctions

open HTGeometry

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The average of `f` over the window `[0, T]`. -/
noncomputable def windowAverage (f : ℝ → E) (T : ℝ) : E :=
  T⁻¹ • ∫ t in (0 : ℝ)..T, f t

omit [NormedSpace ℝ E] in
/-- A continuous Bohr almost-periodic function is bounded: every value is within `1` of a value
attained on the compact interval `[0, L]`, where `L` is the inclusion length at tolerance `1`. -/
theorem exists_bound_of_isBohrAlmostPeriodic {f : ℝ → E} (hcont : Continuous f)
    (hap : IsBohrAlmostPeriodic f) : ∃ C : ℝ, ∀ x : ℝ, ‖f x‖ ≤ C := by
  obtain ⟨L, hL, hdense⟩ := hap 1 one_pos
  obtain ⟨C₀, hC₀⟩ :=
    (isCompact_Icc (a := (0 : ℝ)) (b := L)).exists_bound_of_continuousOn hcont.continuousOn
  refine ⟨C₀ + 1, fun x => ?_⟩
  obtain ⟨τ, hτmem, hτ⟩ := hdense (-x)
  have hmem : x + τ ∈ Set.Icc (0 : ℝ) L := by
    constructor
    · linarith [hτmem.1]
    · linarith [hτmem.2]
  calc ‖f x‖ = ‖f (x + τ) - (f (x + τ) - f x)‖ := by congr 1; abel
    _ ≤ ‖f (x + τ)‖ + ‖f (x + τ) - f x‖ := norm_sub_le _ _
    _ ≤ C₀ + 1 := add_le_add (hC₀ _ hmem) (hτ x)

/-- Transporting a window by an `ε`-almost period costs at most `ε` per unit length. -/
theorem norm_integral_shift_sub_le {f : ℝ → E} (hcont : Continuous f)
    {τ ε : ℝ} (hτ : ∀ x : ℝ, ‖f (x + τ) - f x‖ ≤ ε) {T : ℝ} (hT : 0 ≤ T) :
    ‖(∫ t in τ..(τ + T), f t) - ∫ t in (0 : ℝ)..T, f t‖ ≤ ε * T := by
  have hshift : (∫ t in (0 : ℝ)..T, f (t + τ)) = ∫ t in τ..(τ + T), f t := by
    rw [intervalIntegral.integral_comp_add_right f τ]
    norm_num [add_comm]
  have hcont' : Continuous fun t : ℝ => f (t + τ) :=
    hcont.comp (continuous_id.add continuous_const)
  rw [← hshift, ← intervalIntegral.integral_sub (hcont'.intervalIntegrable _ _)
    (hcont.intervalIntegrable _ _)]
  have hbound := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := (0 : ℝ)) (b := T) (C := ε) (f := fun t => f (t + τ) - f t) (fun x _ => hτ x)
  simpa [abs_of_nonneg hT] using hbound

/-- One block of the Bohr decomposition: the integral over `[a, a + T]` differs from the integral
over the base window `[0, T]` by at most `ε T + 2 C L`, where the almost period used lies within `L`
of `a`. -/
theorem norm_integral_block_sub_le {f : ℝ → E} (hcont : Continuous f)
    {C : ℝ} (hC : ∀ x : ℝ, ‖f x‖ ≤ C) {ε L T : ℝ} (hT : 0 ≤ T)
    (hdense : ∀ a : ℝ, ∃ τ ∈ Set.Icc a (a + L), ∀ x : ℝ, ‖f (x + τ) - f x‖ ≤ ε) (a : ℝ) :
    ‖(∫ t in a..(a + T), f t) - ∫ t in (0 : ℝ)..T, f t‖ ≤ ε * T + 2 * C * L := by
  obtain ⟨τ, hτmem, hτ⟩ := hdense a
  have hint : ∀ u v : ℝ, IntervalIntegrable f volume u v := hcont.intervalIntegrable
  have hdecomp : (∫ t in a..(a + T), f t) - ∫ t in τ..(τ + T), f t
      = (∫ t in a..τ, f t) + ∫ t in (τ + T)..(a + T), f t := by
    have h1 : (∫ t in a..τ, f t) + ∫ t in τ..(a + T), f t = ∫ t in a..(a + T), f t :=
      intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
    have h2 : (∫ t in τ..(τ + T), f t) + ∫ t in (τ + T)..(a + T), f t = ∫ t in τ..(a + T), f t :=
      intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
    rw [← h1, ← h2]
    abel
  have hCnn : 0 ≤ C := le_trans (norm_nonneg _) (hC 0)
  have hgap : τ - a ≤ L := by linarith [hτmem.2]
  have hgap0 : 0 ≤ τ - a := by linarith [hτmem.1]
  have hend1 : ‖∫ t in a..τ, f t‖ ≤ C * L := by
    refine (intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => hC x)).trans ?_
    rw [abs_of_nonneg hgap0]
    exact mul_le_mul_of_nonneg_left hgap hCnn
  have hend2 : ‖∫ t in (τ + T)..(a + T), f t‖ ≤ C * L := by
    refine (intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => hC x)).trans ?_
    have : |a + T - (τ + T)| = τ - a := by
      rw [show a + T - (τ + T) = -(τ - a) by ring, abs_neg, abs_of_nonneg hgap0]
    rw [this]
    exact mul_le_mul_of_nonneg_left hgap hCnn
  have hmain := norm_integral_shift_sub_le hcont hτ hT
  calc ‖(∫ t in a..(a + T), f t) - ∫ t in (0 : ℝ)..T, f t‖
      = ‖((∫ t in a..(a + T), f t) - ∫ t in τ..(τ + T), f t)
          + ((∫ t in τ..(τ + T), f t) - ∫ t in (0 : ℝ)..T, f t)‖ := by congr 1; abel
    _ ≤ ‖(∫ t in a..(a + T), f t) - ∫ t in τ..(τ + T), f t‖
          + ‖(∫ t in τ..(τ + T), f t) - ∫ t in (0 : ℝ)..T, f t‖ := norm_add_le _ _
    _ ≤ (C * L + C * L) + ε * T := by
        refine add_le_add ?_ hmain
        rw [hdecomp]
        exact (norm_add_le _ _).trans (add_le_add hend1 hend2)
    _ = ε * T + 2 * C * L := by ring

/-- Summing the block estimate over the first `k` windows. -/
theorem norm_integral_nsmul_sub_le {f : ℝ → E} (hcont : Continuous f)
    {C : ℝ} (hC : ∀ x : ℝ, ‖f x‖ ≤ C) {ε L T : ℝ} (hT : 0 ≤ T)
    (hdense : ∀ a : ℝ, ∃ τ ∈ Set.Icc a (a + L), ∀ x : ℝ, ‖f (x + τ) - f x‖ ≤ ε) (k : ℕ) :
    ‖(∫ t in (0 : ℝ)..((k : ℝ) * T), f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t)‖
      ≤ (k : ℝ) * (ε * T + 2 * C * L) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hint : ∀ u v : ℝ, IntervalIntegrable f volume u v := hcont.intervalIntegrable
      have hstep : ((k : ℝ) + 1) * T = (k : ℝ) * T + T := by ring
      have hadd : (∫ t in (0 : ℝ)..((k : ℝ) * T), f t)
          + ∫ t in ((k : ℝ) * T)..((k : ℝ) * T + T), f t
          = ∫ t in (0 : ℝ)..((k : ℝ) * T + T), f t :=
        intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
      have hblock := norm_integral_block_sub_le hcont hC hT hdense ((k : ℝ) * T)
      have hsplit : (∫ t in (0 : ℝ)..(((k : ℕ) + 1 : ℝ) * T), f t)
            - ((k : ℕ) + 1 : ℝ) • (∫ t in (0 : ℝ)..T, f t)
          = ((∫ t in (0 : ℝ)..((k : ℝ) * T), f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t))
            + ((∫ t in ((k : ℝ) * T)..((k : ℝ) * T + T), f t) - ∫ t in (0 : ℝ)..T, f t) := by
        rw [hstep, ← hadd, add_smul, one_smul]
        abel
      have : ‖(∫ t in (0 : ℝ)..(((k : ℕ) + 1 : ℝ) * T), f t)
            - ((k : ℕ) + 1 : ℝ) • (∫ t in (0 : ℝ)..T, f t)‖
          ≤ (k : ℝ) * (ε * T + 2 * C * L) + (ε * T + 2 * C * L) := by
        rw [hsplit]
        exact (norm_add_le _ _).trans (add_le_add ih hblock)
      have hcast : (((k + 1 : ℕ) : ℝ)) = ((k : ℕ) + 1 : ℝ) := by push_cast; ring
      rw [hcast]
      refine this.trans (le_of_eq ?_)
      ring

/-- **Existence of the Bohr mean value.**  A continuous Bohr almost-periodic function on `ℝ` has a
window-average limit `M(f) = lim_{T→∞} (1/T)∫₀ᵀ f`. -/
theorem exists_tendsto_windowAverage [CompleteSpace E] {f : ℝ → E} (hcont : Continuous f)
    (hap : IsBohrAlmostPeriodic f) :
    ∃ M : E, Tendsto (windowAverage f) atTop (nhds M) := by
  obtain ⟨C, hC⟩ := exists_bound_of_isBohrAlmostPeriodic hcont hap
  have hCnn : 0 ≤ C := le_trans (norm_nonneg _) (hC 0)
  have hint : ∀ u v : ℝ, IntervalIntegrable f volume u v := hcont.intervalIntegrable
  -- the key clustering estimate
  have key : ∀ ε : ℝ, 0 < ε → ∃ T S : ℝ, 0 < T ∧ T ≤ S ∧
      ∀ T' : ℝ, S ≤ T' → ‖windowAverage f T' - windowAverage f T‖ ≤ ε := by
    intro ε hε
    obtain ⟨L, hL, hdense⟩ := hap (ε / 3) (by linarith)
    refine ⟨1 + 6 * C * L / ε, max (1 + 6 * C * L / ε) (1 + 6 * (1 + 6 * C * L / ε) * C / ε),
      ?_, le_max_left _ _, ?_⟩
    · have : 0 ≤ 6 * C * L / ε := by positivity
      linarith
    set T : ℝ := 1 + 6 * C * L / ε with hTdef
    have hTpos : 0 < T := by
      have : 0 ≤ 6 * C * L / ε := by positivity
      rw [hTdef]; linarith
    have hTL : 2 * C * L / T ≤ ε / 3 := by
      rw [div_le_iff₀ hTpos]
      have hge : 6 * C * L / ε ≤ T := by rw [hTdef]; linarith
      have h6 : 6 * C * L ≤ ε * T := by
        rw [div_le_iff₀ hε] at hge
        linarith
      linarith
    intro T' hT'
    have hT'1 : T ≤ T' := le_trans (le_max_left _ _) hT'
    have hT'pos : 0 < T' := lt_of_lt_of_le hTpos hT'1
    have hT'2 : 1 + 6 * T * C / ε ≤ T' := le_trans (le_max_right _ _) hT'
    have hTT' : 2 * C * T / T' ≤ ε / 3 := by
      rw [div_le_iff₀ hT'pos]
      have hge : 6 * T * C / ε ≤ T' := by linarith
      rw [div_le_iff₀ hε] at hge
      linarith
    -- the block count
    set k : ℕ := ⌊T' / T⌋₊ with hkdef
    have hkle : (k : ℝ) * T ≤ T' := by
      have h := Nat.floor_le (le_of_lt (div_pos hT'pos hTpos))
      rw [← hkdef] at h
      calc (k : ℝ) * T ≤ (T' / T) * T := mul_le_mul_of_nonneg_right h hTpos.le
        _ = T' := div_mul_cancel₀ _ hTpos.ne'
    have hklt : T' < ((k : ℝ) + 1) * T := by
      have h := Nat.lt_floor_add_one (T' / T)
      rw [← hkdef] at h
      calc T' = (T' / T) * T := (div_mul_cancel₀ _ hTpos.ne').symm
        _ < ((k : ℝ) + 1) * T := by
            exact mul_lt_mul_of_pos_right h hTpos
    -- the tail piece
    have htail : ‖(∫ t in (0 : ℝ)..T', f t) - ∫ t in (0 : ℝ)..((k : ℝ) * T), f t‖ ≤ C * T := by
      have hadd : (∫ t in (0 : ℝ)..((k : ℝ) * T), f t) + ∫ t in ((k : ℝ) * T)..T', f t
          = ∫ t in (0 : ℝ)..T', f t :=
        intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
      have heq : (∫ t in (0 : ℝ)..T', f t) - ∫ t in (0 : ℝ)..((k : ℝ) * T), f t
          = ∫ t in ((k : ℝ) * T)..T', f t := by rw [← hadd]; abel
      rw [heq]
      refine (intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => hC x)).trans ?_
      have hdist : |T' - (k : ℝ) * T| ≤ T := by
        rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ T' - (k : ℝ) * T)]
        nlinarith [hklt]
      exact mul_le_mul_of_nonneg_left hdist hCnn
    have hblocks := norm_integral_nsmul_sub_le hcont hC hTpos.le hdense k
    have hcombined : ‖(∫ t in (0 : ℝ)..T', f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t)‖
        ≤ C * T + (k : ℝ) * (ε / 3 * T + 2 * C * L) := by
      have hsplit : (∫ t in (0 : ℝ)..T', f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t)
          = ((∫ t in (0 : ℝ)..T', f t) - ∫ t in (0 : ℝ)..((k : ℝ) * T), f t)
            + ((∫ t in (0 : ℝ)..((k : ℝ) * T), f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t)) := by
        abel
      rw [hsplit]
      exact (norm_add_le _ _).trans (add_le_add htail hblocks)
    -- assemble the average
    have hbaseNorm : ‖∫ t in (0 : ℝ)..T, f t‖ ≤ C * T := by
      refine (intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => hC x)).trans ?_
      rw [sub_zero, abs_of_nonneg hTpos.le]
    have hsplitAvg : windowAverage f T' - windowAverage f T
        = (T')⁻¹ • ((∫ t in (0 : ℝ)..T', f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t))
          + ((k : ℝ) * (T')⁻¹ - T⁻¹) • (∫ t in (0 : ℝ)..T, f t) := by
      simp only [windowAverage]
      module
    have hcoef : |(k : ℝ) * (T')⁻¹ - T⁻¹| ≤ (T')⁻¹ := by
      have hupper : (k : ℝ) * (T')⁻¹ - T⁻¹ ≤ 0 := by
        have : (k : ℝ) / T' ≤ 1 / T := by
          rw [div_le_div_iff₀ hT'pos hTpos]
          linarith
        rw [← div_eq_mul_inv, ← one_div]
        linarith
      have hlower : -(T')⁻¹ ≤ (k : ℝ) * (T')⁻¹ - T⁻¹ := by
        have : 1 / T ≤ ((k : ℝ) + 1) / T' := by
          rw [div_le_div_iff₀ hTpos hT'pos]
          linarith
        rw [← div_eq_mul_inv, ← one_div, ← one_div]
        have hexp : ((k : ℝ) + 1) / T' = (k : ℝ) / T' + 1 / T' := by ring
        rw [hexp] at this
        linarith
      rw [abs_le]
      exact ⟨hlower, by linarith [hupper, inv_nonneg.mpr hT'pos.le]⟩
    have hkT' : (k : ℝ) * (T')⁻¹ ≤ T⁻¹ := by
      have : (k : ℝ) / T' ≤ 1 / T := by
        rw [div_le_div_iff₀ hT'pos hTpos]; linarith
      rw [← div_eq_mul_inv, ← one_div]
      exact this
    have hposFactor : 0 ≤ ε / 3 * T + 2 * C * L := by positivity
    calc ‖windowAverage f T' - windowAverage f T‖
        ≤ ‖(T')⁻¹ • ((∫ t in (0 : ℝ)..T', f t) - (k : ℝ) • (∫ t in (0 : ℝ)..T, f t))‖
            + ‖((k : ℝ) * (T')⁻¹ - T⁻¹) • (∫ t in (0 : ℝ)..T, f t)‖ := by
          rw [hsplitAvg]; exact norm_add_le _ _
      _ ≤ (T')⁻¹ * (C * T + (k : ℝ) * (ε / 3 * T + 2 * C * L)) + (T')⁻¹ * (C * T) := by
          gcongr
          · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr hT'pos.le)]
            exact mul_le_mul_of_nonneg_left hcombined (inv_nonneg.mpr hT'pos.le)
          · rw [norm_smul, Real.norm_eq_abs]
            exact mul_le_mul hcoef hbaseNorm (norm_nonneg _) (inv_nonneg.mpr hT'pos.le)
      _ ≤ ε := by
          have h1 : (T')⁻¹ * ((k : ℝ) * (ε / 3 * T + 2 * C * L))
              ≤ T⁻¹ * (ε / 3 * T + 2 * C * L) := by
            rw [← mul_assoc, mul_comm (T')⁻¹ (k : ℝ), mul_assoc]
            calc (k : ℝ) * ((T')⁻¹ * (ε / 3 * T + 2 * C * L))
                = ((k : ℝ) * (T')⁻¹) * (ε / 3 * T + 2 * C * L) := by ring
              _ ≤ T⁻¹ * (ε / 3 * T + 2 * C * L) :=
                  mul_le_mul_of_nonneg_right hkT' hposFactor
          have h2 : T⁻¹ * (ε / 3 * T + 2 * C * L) ≤ ε / 3 + ε / 3 := by
            have hexp : T⁻¹ * (ε / 3 * T + 2 * C * L) = ε / 3 + 2 * C * L / T := by
              field_simp
            rw [hexp]
            linarith
          have h3 : (T')⁻¹ * (C * T) + (T')⁻¹ * (C * T) ≤ ε / 3 := by
            have hexp : (T')⁻¹ * (C * T) + (T')⁻¹ * (C * T) = 2 * C * T / T' := by
              field_simp
              ring
            rw [hexp]
            exact hTT'
          nlinarith [h1, h2, h3]
  -- Cauchy along `atTop`, hence convergent
  have hcauchy : Cauchy (map (windowAverage f) atTop) := by
    rw [Metric.cauchy_iff]
    refine ⟨map_neBot, fun ε hε => ?_⟩
    obtain ⟨T, S, hTpos, hTS, hkey⟩ := key (ε / 3) (by linarith)
    refine ⟨windowAverage f '' Set.Ici S, image_mem_map (Ici_mem_atTop S), ?_⟩
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    have h1 := hkey a ha
    have h2 := hkey b hb
    calc dist (windowAverage f a) (windowAverage f b)
        ≤ dist (windowAverage f a) (windowAverage f T)
            + dist (windowAverage f T) (windowAverage f b) := dist_triangle _ _ _
      _ ≤ ε / 3 + ε / 3 := by
          rw [dist_eq_norm, dist_eq_norm, ← norm_neg (windowAverage f T - windowAverage f b)]
          simpa using add_le_add h1 h2
      _ < ε := by linarith
  exact cauchy_map_iff_exists_tendsto.mp hcauchy

open scoped Classical in
/-- The Bohr mean value of a continuous almost-periodic function. -/
noncomputable def bohrMean [CompleteSpace E] (f : ℝ → E) : E :=
  if h : ∃ M : E, Tendsto (windowAverage f) atTop (nhds M) then h.choose else 0

/-- The mean value is the limit of the window averages. -/
theorem tendsto_windowAverage_bohrMean [CompleteSpace E] {f : ℝ → E} (hcont : Continuous f)
    (hap : IsBohrAlmostPeriodic f) :
    Tendsto (windowAverage f) atTop (nhds (bohrMean f)) := by
  have hex := exists_tendsto_windowAverage hcont hap
  rw [bohrMean, dif_pos hex]
  exact hex.choose_spec

/-- The mean value is unique: any window-average limit is the Bohr mean. -/
theorem bohrMean_eq [CompleteSpace E] {f : ℝ → E} (hcont : Continuous f)
    (hap : IsBohrAlmostPeriodic f) {M : E} (hM : Tendsto (windowAverage f) atTop (nhds M)) :
    bohrMean f = M :=
  tendsto_nhds_unique (tendsto_windowAverage_bohrMean hcont hap) hM

end GaloisForLFunctions
