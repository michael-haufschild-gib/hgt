import GaloisForLFunctions.HTGeometry.ReesDepth
import GaloisForLFunctions.HTGeometry.StanleyReisnerDimension

/-!
# The Rees side condition, discharged

Every application of the Rees theorem carries the hypothesis `𝔪 • ⊤ < ⊤` on the module.  For a
quotient `R ⧸ I` it holds as soon as `I` is contained in a proper `𝔪`, and for a Stanley–Reisner
ring the irrelevant ideal always works.

```text
smul_top_lt_top_quotient      I ≤ 𝔪 and 𝔪 ≠ ⊤  ⟹  𝔪 • ⊤ < ⊤ in R ⧸ I
irrelevantIdeal K σ           the ideal generated by the variables
irrelevantIdeal_ne_top        it is proper (constant coefficient)
faceFamilyIdeal_le_irrelevant every Stanley–Reisner ideal of a nonempty family sits inside it
smul_top_lt_top_faceFamily    ** the side condition for a Stanley–Reisner ring **
```

This removes the four `smul_lt` hypotheses of `exists_isRegular_shedding` from the recursion: they
are all instances of the last lemma.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Pointwise

universe u v

/-- **The Rees side condition, discharged once and for all.**  If the ideal `I` is contained in a
proper ideal `𝔪`, then `𝔪` does not generate the whole of `R ⧸ I`. -/
theorem smul_top_lt_top_quotient {R : Type u} [CommRing R] {I 𝔪 : Ideal R}
    (hI : I ≤ 𝔪) (h𝔪 : 𝔪 ≠ ⊤) :
    𝔪 • (⊤ : Submodule R (ModuleCat.of R (R ⧸ I))) < ⊤ := by
  classical
  refine lt_of_le_of_ne le_top ?_
  intro hcon
  apply h𝔪
  rw [Ideal.eq_top_iff_one]
  have hmem : (1 : R ⧸ I) ∈ 𝔪 • (⊤ : Submodule R (R ⧸ I)) := by
    rw [show ((1 : R ⧸ I)) = (1 : ModuleCat.of R (R ⧸ I)) from rfl, hcon]
    trivial
  rw [Ideal.smul_top_eq_map] at hmem
  have hmap : (1 : R ⧸ I) ∈ Ideal.map (Ideal.Quotient.mk I) 𝔪 := hmem
  have htop : Ideal.map (Ideal.Quotient.mk I) 𝔪 = ⊤ := Ideal.eq_top_iff_one _ |>.mpr hmap
  have hcomap : 𝔪 ⊔ I = ⊤ := by
    have h2 := congrArg (Ideal.comap (Ideal.Quotient.mk I)) htop
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, Ideal.comap_top] at h2
    have hker : Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal (R ⧸ I)) = I := by
      rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    rwa [hker] at h2
  rw [sup_eq_left.mpr hI] at hcomap
  rw [hcomap]
  trivial

section Irrelevant

open MvPolynomial

variable {σ : Type v} [Fintype σ] [DecidableEq σ] {K : Type u} [Field K]

/-- The irrelevant ideal of the polynomial ring. -/
noncomputable def irrelevantIdeal (K : Type u) [Field K] (σ : Type v) :
    Ideal (MvPolynomial σ K) :=
  Ideal.span (Set.range (X : σ → MvPolynomial σ K))

theorem irrelevantIdeal_ne_top (K : Type u) [Field K] (σ : Type v) :
    irrelevantIdeal K σ ≠ ⊤ := by
  intro htop
  have hone : (1 : MvPolynomial σ K) ∈ irrelevantIdeal K σ := by rw [htop]; trivial
  have hle : irrelevantIdeal K σ ≤ RingHom.ker (MvPolynomial.constantCoeff) := by
    rw [irrelevantIdeal, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    simp [RingHom.mem_ker]
  have := hle hone
  rw [RingHom.mem_ker, map_one] at this
  exact one_ne_zero this

theorem faceFamilyIdeal_le_irrelevant (K : Type u) [Field K] {F : Finset (Finset σ)}
    (hne : F.Nonempty) : faceFamilyIdeal K F ≤ irrelevantIdeal K σ := by
  obtain ⟨S, hS⟩ := hne
  refine le_trans (Finset.inf_le hS) ?_
  refine Ideal.span_mono ?_
  rintro x ⟨i, -, rfl⟩
  exact ⟨i, rfl⟩

/-- **The Rees side condition for a Stanley–Reisner ring.** -/
theorem smul_top_lt_top_faceFamily (K : Type u) [Field K] {F : Finset (Finset σ)}
    (hne : F.Nonempty) :
    irrelevantIdeal K σ • (⊤ : Submodule (MvPolynomial σ K)
      (ModuleCat.of (MvPolynomial σ K) (MvPolynomial σ K ⧸ faceFamilyIdeal K F))) < ⊤ :=
  smul_top_lt_top_quotient (faceFamilyIdeal_le_irrelevant K hne) (irrelevantIdeal_ne_top K σ)

end Irrelevant


end GaloisForLFunctions.HTGeometry
