import GaloisForLFunctions.HTGeometry.ComplexTorusMaurerCartan

/-!
# The position–velocity splitting of a complex torus protocol

For an arbitrary set of deck translations of `ℂ ^ n`, with no hypothesis on the protocol, the
invariants on the generic reparametrisation are exactly the field generated by the invariants of
the position — the functions of the reversible quotient — together with the Maurer–Cartan
velocities.

When the deck translations are dense the position invariants collapse to the constants, and the
splitting degenerates to the purely expanding case in which only the velocity survives.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- The functions of the reversible quotient: the elements of the entire fraction field fixed by a
set of translations. -/
noncomputable def translationInvariantBase (D : Set V) : IntermediateField ℂ (EntireField V) where
  carrier := {a : EntireField V | ∀ t ∈ D, fieldTranslateEquiv t a = a}
  zero_mem' := by intro t _; simp
  one_mem' := by intro t _; simp
  add_mem' := by
    intro x y hx hy t ht
    rw [map_add, hx t ht, hy t ht]
  mul_mem' := by
    intro x y hx hy t ht
    rw [map_mul, hx t ht, hy t ht]
  inv_mem' := by
    intro x hx t ht
    rw [map_inv₀, hx t ht]
  algebraMap_mem' := by
    intro c t _
    show fieldTranslateEquiv t (constEntire V c) = constEntire V c
    rw [fieldTranslateEquiv_constEntire]

theorem mem_translationInvariantBase_iff (D : Set V) {a : EntireField V} :
    a ∈ translationInvariantBase D ↔ ∀ t ∈ D, fieldTranslateEquiv t a = a := Iff.rfl

/-- **A dense set of deck translations erases the position.** -/
theorem translationInvariantBase_eq_bot_of_dense {D : Set V} (hD : Dense D) :
    translationInvariantBase D = ⊥ := by
  refine le_antisymm (fun a ha => ?_) (fun a ha => ?_)
  · obtain ⟨c, hc⟩ := eq_constEntire_of_dense_translation_invariant hD ha
    rw [IntermediateField.mem_bot]
    exact ⟨c, hc.symm⟩
  · rw [IntermediateField.mem_bot] at ha
    obtain ⟨c, rfl⟩ := ha
    exact (translationInvariantBase D).algebraMap_mem c

variable {n : ℕ}

/-- The phase field: the position invariants of the base together with the reparametrisation
jets. -/
noncomputable def torusBaseAdjoinJets (S : IntermediateField ℂ (EntireField (Fin n → ℂ))) :
    IntermediateField ℂ (TorusField n) :=
  IntermediateField.adjoin ℂ
    ((algebraMap (EntireField (Fin n → ℂ)) (TorusField n)) '' (S : Set (EntireField (Fin n → ℂ)))
      ∪ Set.range (MultiReparamField.jet : Fin n × ℕ → TorusField n))

theorem jet_mem_torusBaseAdjoinJets (S : IntermediateField ℂ (EntireField (Fin n → ℂ)))
    (p : Fin n × ℕ) : (MultiReparamField.jet p : TorusField n) ∈ torusBaseAdjoinJets S :=
  IntermediateField.subset_adjoin ℂ _ (Or.inr ⟨p, rfl⟩)

theorem algebraMap_mem_torusBaseAdjoinJets {S : IntermediateField ℂ (EntireField (Fin n → ℂ))}
    {a : EntireField (Fin n → ℂ)} (ha : a ∈ S) :
    algebraMap (EntireField (Fin n → ℂ)) (TorusField n) a ∈ torusBaseAdjoinJets S :=
  IntermediateField.subset_adjoin ℂ _ (Or.inl ⟨a, ha, rfl⟩)

/-- A jet polynomial whose coefficients are position invariants lies in the phase field. -/
theorem algebraMap_mem_torusBaseAdjoinJets_of_coeff_mem
    {S : IntermediateField ℂ (EntireField (Fin n → ℂ))}
    {p : MultiReparamPoly (EntireField (Fin n → ℂ)) n}
    (hp : ∀ m, MvPolynomial.coeff m p ∈ S) :
    algebraMap (MultiReparamPoly (EntireField (Fin n → ℂ)) n) (TorusField n) p
      ∈ torusBaseAdjoinJets S := by
  classical
  have hsum : p = ∑ m ∈ p.support, MvPolynomial.monomial m (MvPolynomial.coeff m p) :=
    MvPolynomial.as_sum p
  rw [hsum, map_sum]
  refine sum_mem fun m _ => ?_
  rw [MvPolynomial.monomial_eq, map_mul]
  refine mul_mem ?_ ?_
  · rw [← MultiReparamField.algebraMap_base_eq (MvPolynomial.coeff m p)]
    exact algebraMap_mem_torusBaseAdjoinJets (hp m)
  · rw [Finsupp.prod, map_prod]
    refine prod_mem fun i _ => ?_
    rw [map_pow]
    exact pow_mem (jet_mem_torusBaseAdjoinJets S i) _

/-- The elements of the generic reparametrisation fixed by a set of deck translations. -/
noncomputable def torusDeckFixedField (D : Set (Fin n → ℂ)) :
    IntermediateField ℂ (TorusField n) where
  carrier := {x : TorusField n | ∀ t ∈ D,
    MultiReparamField.fieldEquiv (n := n) (fieldTranslateEquiv t) x = x}
  zero_mem' := by intro t _; simp
  one_mem' := by intro t _; simp
  add_mem' := by
    intro x y hx hy t ht
    rw [map_add, hx t ht, hy t ht]
  mul_mem' := by
    intro x y hx hy t ht
    rw [map_mul, hx t ht, hy t ht]
  inv_mem' := by
    intro x hx t ht
    rw [map_inv₀, hx t ht]
  algebraMap_mem' := by
    intro c t _
    rw [algebraMap_torusField, MultiReparamField.fieldEquiv_base, fieldTranslateEquiv_constEntire]

theorem mem_torusDeckFixedField_iff (D : Set (Fin n → ℂ)) {x : TorusField n} :
    x ∈ torusDeckFixedField D ↔ ∀ t ∈ D,
      MultiReparamField.fieldEquiv (n := n) (fieldTranslateEquiv t) x = x := Iff.rfl

/-- **The position–velocity splitting.**  For any set of deck translations of `ℂ ^ n`, the
invariants on the generic reparametrisation are exactly the field generated by the invariant
functions of the position and the Maurer–Cartan velocities.  No hypothesis is placed on the
protocol. -/
theorem torusDeckFixedField_eq_torusBaseAdjoinJets (D : Set (Fin n → ℂ)) :
    torusDeckFixedField D = torusBaseAdjoinJets (translationInvariantBase D) := by
  classical
  refine le_antisymm (fun x hx => ?_) ?_
  · set G : Set (EntireField (Fin n → ℂ) ≃+* EntireField (Fin n → ℂ)) :=
      {e | ∃ t ∈ D, e = fieldTranslateEquiv t} with hG
    have hxG : ∀ e ∈ G, MultiReparamField.fieldEquiv (n := n) e x = x := by
      rintro e ⟨t, ht, rfl⟩
      exact hx t ht
    have hS : ∀ a : EntireField (Fin n → ℂ), (∀ e ∈ G, e a = a) →
        a ∈ (translationInvariantBase D).toSubfield := by
      intro a ha t ht
      exact ha _ ⟨t, ht, rfl⟩
    obtain ⟨p, q, hq0, hpc, hqc, hrep⟩ :=
      MultiReparamField.exists_representation_coeff_mem G
        (translationInvariantBase D).toSubfield hS x hxG
    have hqne : algebraMap (MultiReparamPoly (EntireField (Fin n → ℂ)) n) (TorusField n) q ≠ 0 := by
      intro h
      exact hq0 (IsFractionRing.injective (MultiReparamPoly (EntireField (Fin n → ℂ)) n)
        (TorusField n) (by rw [h, map_zero]))
    have hxval : x = algebraMap (MultiReparamPoly (EntireField (Fin n → ℂ)) n) (TorusField n) p
        / algebraMap (MultiReparamPoly (EntireField (Fin n → ℂ)) n) (TorusField n) q := by
      rw [eq_div_iff hqne, mul_comm]
      exact hrep
    rw [hxval]
    exact div_mem (algebraMap_mem_torusBaseAdjoinJets_of_coeff_mem hpc)
      (algebraMap_mem_torusBaseAdjoinJets_of_coeff_mem hqc)
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro y (⟨a, ha, rfl⟩ | ⟨p, rfl⟩)
    · intro t ht
      rw [MultiReparamField.fieldEquiv_base, ha t ht]
    · intro t _
      exact MultiReparamField.fieldEquiv_jet (n := n) (fieldTranslateEquiv t) p

/-- The deck-invariant field of a protocol is the fixed field of its accumulated division points. -/
theorem torusDeckInvariantField_eq_torusDeckFixedField (L : PeriodLattice (Fin n → ℂ))
    (M : ℕ → ℂ) :
    torusDeckInvariantField L M
      = torusDeckFixedField {t : Fin n → ℂ | ∃ k : ℕ, M k • t ∈ L.lattice} := by
  refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
  · rintro t ⟨k, hk⟩
    exact hx k t hk
  · intro k t ht
    exact hx t ⟨k, ht⟩

/-- **The position–velocity splitting of a complex torus protocol.**  The phase tail is generated by
the functions of the reversible quotient and the Maurer–Cartan velocities. -/
theorem torusDeckInvariantField_eq_torusBaseAdjoinJets (L : PeriodLattice (Fin n → ℂ))
    (M : ℕ → ℂ) :
    torusDeckInvariantField L M
      = torusBaseAdjoinJets
        (translationInvariantBase {t : Fin n → ℂ | ∃ k : ℕ, M k • t ∈ L.lattice}) := by
  rw [torusDeckInvariantField_eq_torusDeckFixedField,
    torusDeckFixedField_eq_torusBaseAdjoinJets]

/-- **In the purely expanding branch the position is erased.**  When the accumulated degrees have
unbounded norm the invariant functions of the position are the constants alone. -/
theorem translationInvariantBase_divisionPoints_eq_bot (L : PeriodLattice (Fin n → ℂ))
    (M : ℕ → ℂ) (hM : ∀ k, M k ≠ 0) (hMinf : Tendsto (fun k => ‖M k‖) atTop atTop) :
    translationInvariantBase {t : Fin n → ℂ | ∃ k : ℕ, M k • t ∈ L.lattice} = ⊥ :=
  translationInvariantBase_eq_bot_of_dense (dense_divisionPoints L M hM hMinf)

end GaloisForLFunctions.HTGeometry
