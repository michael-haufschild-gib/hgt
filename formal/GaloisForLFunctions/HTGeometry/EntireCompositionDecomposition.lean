import GaloisForLFunctions.HTGeometry.MeroExponentialGauge
import GaloisForLFunctions.HTGeometry.CompositionJetClosure
import GaloisForLFunctions.HTGeometry.CompositionOrderTransfer
import GaloisForLFunctions.HTGeometry.RelativeTwoShiftGaugeCharacterization

/-!
# The composition-decomposition law for entire functions

If `φ` is nonconstant entire and both `φ` and `g ∘ φ` are differentially algebraic, then so is `g`,
with an order bounded by the size of a common algebraic-witness family for their jets.

The three ingredients are already separate theorems: the jets of the outer function lie in the
differential field generated by the inner one and the composite
(`CompositionJetClosure.compJet_mem_differentialAdjoin`); bounded transcendence degree forces a
relation among them (`CompositionJetClosure.exists_relation_compJet_of_witness'`); and a relation
holding along the range of a nonconstant entire map holds everywhere
(`CompositionOrderTransfer.differentiallyAlgebraicOfOrder_of_relation_on_range`).  This file
realises the abstract jets as the actual ones and assembles the three.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open Bottcher
open scoped UnivMeroFieldInstances Differential

/-- Analyticity of an outer jet composed with the inner function. -/
theorem analyticOnNhd_iteratedDeriv_comp {g φ : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hφ : Differentiable ℂ φ) (j : ℕ) :
    AnalyticOnNhd ℂ (fun z => iteratedDeriv j g (φ z)) (Set.univ : Set ℂ) :=
  Complex.analyticOnNhd_univ_iff_differentiable.mpr
    ((differentiable_iteratedDeriv_of_entire hg j).comp hφ)

/-- **The abstract outer jets are the actual outer jets.** -/
theorem compJet_analyticMeroElement {g φ : ℂ → ℂ} (hg : Differentiable ℂ g)
    (hφ : Differentiable ℂ φ)
    (hφ' : analyticMeroElement (deriv φ)
      (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ).deriv ≠ 0) (j : ℕ) :
    compJet (analyticMeroElement φ (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ))
        (analyticMeroElement (fun z => iteratedDeriv 0 g (φ z))
          (analyticOnNhd_iteratedDeriv_comp hg hφ 0)) j
      = analyticMeroElement (fun z => iteratedDeriv j g (φ z))
          (analyticOnNhd_iteratedDeriv_comp hg hφ j) := by
  induction j with
  | zero => rfl
  | succ j ih =>
      rw [compJet_succ, ih, deriv_analyticMeroElement, deriv_analyticMeroElement]
      have hfun : deriv (fun z => iteratedDeriv j g (φ z))
          = fun z => iteratedDeriv (j + 1) g (φ z) * deriv φ z := by
        funext z
        exact deriv_iteratedDeriv_comp_entire hg hφ j z
      rw [analyticMeroElement_congr _
        ((analyticOnNhd_iteratedDeriv_comp hg hφ (j + 1)).mul
          (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ).deriv) hfun,
        analyticMeroElement_mul, mul_div_cancel_right₀ _ hφ']
      exact (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ).deriv

/-- **The composition-decomposition law for entire functions.**  If `φ` is nonconstant entire with
nonvanishing realized derivative, and every jet of `φ` and of `g ∘ φ` has an algebraic witness over
a family of `M+1` elements, then `g` satisfies an algebraic differential equation of order `M`. -/
theorem differentiallyAlgebraicOfOrder_of_comp_witness {g φ : ℂ → ℂ}
    (hg : Differentiable ℂ g) (hφ : Differentiable ℂ φ)
    (hnc : ∀ c : ℂ, ∃ z, φ z ≠ c)
    (hφ' : analyticMeroElement (deriv φ)
      (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ).deriv ≠ 0)
    {I : Type} {M : ℕ} (s : I → meroField (Set.univ : Set ℂ))
    (hcard : Cardinal.mk I ≤ ((M + 1 : ℕ) : Cardinal))
    (hwit : ∀ x ∈ ({analyticMeroElement φ (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ),
        analyticMeroElement (fun z => iteratedDeriv 0 g (φ z))
          (analyticOnNhd_iteratedDeriv_comp hg hφ 0)} : Set (meroField (Set.univ : Set ℂ))),
      ∀ j : ℕ, AlgebraicWitness ℂ s (differentialJet j x)) :
    DifferentiallyAlgebraicOfOrder g M := by
  classical
  have hconst : ∀ c : ℂ, (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c)′ = 0 :=
    deriv_algebraMap_complex
  obtain ⟨P, hP0, hP⟩ := exists_relation_compJet_of_witness' (F := ℂ)
    (K := meroField (Set.univ : Set ℂ)) hconst
    (analyticMeroElement φ (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ))
    (analyticMeroElement (fun z => iteratedDeriv 0 g (φ z))
      (analyticOnNhd_iteratedDeriv_comp hg hφ 0)) s (M + 1) hcard hwit
  refine differentiallyAlgebraicOfOrder_of_relation_on_range hg hφ hnc P hP0 ?_
  have hjet : ∀ i : Fin (M + 1),
      compJet (analyticMeroElement φ (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ))
          (analyticMeroElement (fun z => iteratedDeriv 0 g (φ z))
            (analyticOnNhd_iteratedDeriv_comp hg hφ 0)) (i : ℕ)
        = analyticMeroElement (fun z => iteratedDeriv (i : ℕ) g (φ z))
            (analyticOnNhd_iteratedDeriv_comp hg hφ (i : ℕ)) :=
    fun i => compJet_analyticMeroElement hg hφ hφ' (i : ℕ)
  set G : Fin (M + 2) → ℂ → ℂ :=
    Fin.cons φ (fun i : Fin (M + 1) => fun z => iteratedDeriv (i : ℕ) g (φ z)) with hG
  have hGan : ∀ j, AnalyticOnNhd ℂ (G j) (Set.univ : Set ℂ) := by
    intro j
    refine Fin.cases ?_ ?_ j
    · simpa [hG] using Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ
    · intro i
      simpa [hG] using analyticOnNhd_iteratedDeriv_comp hg hφ (i : ℕ)
  have hconstMap : (algebraMap ℂ (meroField (Set.univ : Set ℂ)))
      = constToMero (Set.univ : Set ℂ) := rfl
  have hfam : (Fin.cons
        (analyticMeroElement φ (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ))
        fun i : Fin (M + 1) =>
          compJet (analyticMeroElement φ
              (Complex.analyticOnNhd_univ_iff_differentiable.mpr hφ))
            (analyticMeroElement (fun z => iteratedDeriv 0 g (φ z))
              (analyticOnNhd_iteratedDeriv_comp hg hφ 0)) (i : ℕ))
      = fun j : Fin (M + 2) => analyticMeroElement (G j) (hGan j) := by
    funext j
    refine Fin.cases ?_ ?_ j
    · simp [hG]
    · intro i
      rw [Fin.cons_succ, hjet i]
      simp [hG]
  rw [hfam, MvPolynomial.aeval_def, hconstMap,
    ← analyticMeroElement_eval_mvPolynomial G hGan P] at hP
  have hpt := (analyticMeroElement_eq_zero_iff
    (analyticOnNhd_eval_mvPolynomial G hGan P)).mp hP
  intro z
  have hev : (fun i : Fin (M + 2) => G i z)
      = Fin.cons (φ z) fun j : Fin (M + 1) => iteratedDeriv (j : ℕ) g (φ z) := by
    funext i
    refine Fin.cases ?_ ?_ i
    · simp [hG]
    · intro l
      simp [hG]
  rw [← hev]
  exact hpt z (Set.mem_univ z)


end GaloisForLFunctions.HTGeometry
