import GaloisForLFunctions.HTGeometry.GomesPolynomialConstantLineAlgebra

/-!
# Actual K-algebra generation with all even formal functions available

This makes the scalar-center interpretation explicit in the actual endomorphism
algebra: generate over K by D, one affine reflection, and every formal F(D²).
The result is exactly the constant-preserving second-derivative commutant.
-/

noncomputable section
open Polynomial
namespace GaloisForLFunctions.HTGeometry
variable (K : Type*) [Field K] [CharZero K]

/-- Actual algebra generated by D, one reflection, and the entire even formal functional calculus. -/
def gomesPolynomialDerivativeReflectionAdjoin (c : K) : Subalgebra K (Module.End K K[X]) :=
  Algebra.adjoin K
    ({(Polynomial.derivative : Module.End K K[X]), gomesPolynomialReflectionEnd K c} ∪
      Set.range (gomesEvenFormalPolynomialOperator K))

/-- Actual differentiation belongs to the exact transported constant-line algebra. -/
theorem gomesPolynomialConstantLineAlgebra_derivative_mem (c : K) :
    (Polynomial.derivative : Module.End K K[X]) ∈ gomesPolynomialConstantLineAlgebra K c := by
  apply Subalgebra.mem_map.mpr
  exact ⟨gomesEvenOddDerivativeMatrix K, gomesDerivativeReflectionGeneratedAlgebra_derivative_mem K c,
    gomesTwoChainPolynomialAlgHom_derivative K⟩

/-- The chosen actual reflection belongs to the exact transported constant-line algebra. -/
theorem gomesPolynomialConstantLineAlgebra_reflection_mem (c : K) :
    gomesPolynomialReflectionEnd K c ∈ gomesPolynomialConstantLineAlgebra K c := by
  apply Subalgebra.mem_map.mpr
  exact ⟨gomesPolynomialReflectionMatrix K c, gomesDerivativeReflectionGeneratedAlgebra_reflection_mem K c,
    gomesTwoChainPolynomialAlgHom_reflection K c⟩

/-- Every actual formal function F(D²) belongs to the exact transported constant-line algebra. -/
theorem gomesPolynomialConstantLineAlgebra_even_mem (c : K) (F : PowerSeries K) :
    gomesEvenFormalPolynomialOperator K F ∈ gomesPolynomialConstantLineAlgebra K c := by
  apply Subalgebra.mem_map.mpr
  exact ⟨algebraMap (PowerSeries K) (Matrix (Fin 2) (Fin 2) (PowerSeries K)) F,
    (gomesDerivativeReflectionGeneratedAlgebra K c).algebraMap_mem F,
    gomesTwoChainPolynomialAlgHom_algebraMap K F⟩

/-- The scalar-center generated algebra is precisely the stated actual K-algebra adjoin. -/
theorem gomesPolynomialDerivativeReflectionAdjoin_eq_constantLine (c : K) :
    gomesPolynomialDerivativeReflectionAdjoin K c = gomesPolynomialConstantLineAlgebra K c := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro E hE
    rcases hE with hE | ⟨F, rfl⟩
    · rcases hE with rfl | hE
      · exact gomesPolynomialConstantLineAlgebra_derivative_mem K c
      · rcases hE with rfl
        exact gomesPolynomialConstantLineAlgebra_reflection_mem K c
    · exact gomesPolynomialConstantLineAlgebra_even_mem K c F
  · let T := gomesPolynomialDerivativeReflectionAdjoin K c
    let U : Subalgebra (PowerSeries K) (Matrix (Fin 2) (Fin 2) (PowerSeries K)) :=
      { __ := (T.comap (gomesTwoChainPolynomialAlgHom K)).toSubsemiring
        algebraMap_mem' F := by
          change gomesTwoChainPolynomialAlgHom K
            (algebraMap (PowerSeries K) (Matrix (Fin 2) (Fin 2) (PowerSeries K)) F) ∈ T
          rw [gomesTwoChainPolynomialAlgHom_algebraMap]
          exact Algebra.subset_adjoin (Or.inr ⟨F, rfl⟩) }
    have hU : gomesDerivativeReflectionGeneratedAlgebra K c ≤ U := by
      apply Algebra.adjoin_le
      intro M hM
      rcases hM with rfl | hM
      · change gomesTwoChainPolynomialAlgHom K (gomesEvenOddDerivativeMatrix K) ∈ T
        rw [gomesTwoChainPolynomialAlgHom_derivative]
        exact Algebra.subset_adjoin (Or.inl (Set.mem_insert _ _))
      · rcases hM with rfl
        change gomesTwoChainPolynomialAlgHom K (gomesPolynomialReflectionMatrix K c) ∈ T
        rw [gomesTwoChainPolynomialAlgHom_reflection]
        exact Algebra.subset_adjoin (Or.inl (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    intro E hE
    obtain ⟨M, hM, rfl⟩ := Subalgebra.mem_map.mp hE
    exact hU hM

/-- Exact membership in the actual adjoin has no hidden commutation or preservation premise. -/
theorem gomesPolynomialDerivativeReflectionAdjoin_mem_iff (c : K) (E : Module.End K K[X]) :
    E ∈ gomesPolynomialDerivativeReflectionAdjoin K c ↔
      Commute E (Polynomial.derivative ^ 2 : Module.End K K[X]) ∧
        ∀ a : K, (E (C a)).derivative = 0 := by
  rw [gomesPolynomialDerivativeReflectionAdjoin_eq_constantLine, gomesPolynomialConstantLineAlgebra_mem_iff]

/-- The complete actual K-algebra generated with even formal functions is independent of center. -/
theorem gomesPolynomialDerivativeReflectionAdjoin_center_independent (c d : K) :
    gomesPolynomialDerivativeReflectionAdjoin K c = gomesPolynomialDerivativeReflectionAdjoin K d := by
  rw [gomesPolynomialDerivativeReflectionAdjoin_eq_constantLine,
    gomesPolynomialDerivativeReflectionAdjoin_eq_constantLine,
    gomesPolynomialConstantLineAlgebra_center_independent K c d]

end GaloisForLFunctions.HTGeometry
