import GaloisForLFunctions.HTGeometry.TorusScaleAction
import GaloisForLFunctions.HTGeometry.FiniteGeneratorDifferentialEscape

/-!
# The velocity field of a palette and the torus torsor

The velocity field of a freely generating palette is the differential field generated by the
logarithmic derivatives of its coordinates.  Constant rescalings of the palette fix it pointwise,
because a constant has vanishing logarithmic derivative, and the palette generates the ambient field
over it as an ordinary field: each coordinate satisfies the rank-one linear equation
`x' = (x'/x) x` over the velocity field.

This presents the ambient differential field as an ordinary function field of the palette over the
velocity field -- the multiplicative-torsor picture in rank `r`.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

/-- The velocity field of a palette: the differential field generated by the logarithmic
derivatives of its coordinates. -/
def torusVelocityField (C : Type u) [Field C] [Algebra C E] {r : ℕ} (x : Fin r → E) :
    IntermediateField C E :=
  differentialAdjoin C (Set.range fun i ↦ Differential.logDeriv (x i))

section

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

omit [CharZero E] in
include hx in
/-- **Rescaling fixes the velocity.**  A constant factor has vanishing logarithmic derivative. -/
theorem torusScaleEquiv_logDeriv (hconst : ∀ c : C, c′ = 0) (u : Fin r → Cˣ) (i : Fin r) :
    torusScaleEquiv hx hgen u (Differential.logDeriv (x i)) = Differential.logDeriv (x i) := by
  have hx0 : ∀ j, x j ≠ 0 := torus_palette_ne_zero hx
  have hc0 : algebraMap C E ((u i : C)) ≠ 0 := by
    simp only [ne_eq, map_eq_zero]
    exact (u i).ne_zero
  have hcderiv : Differential.logDeriv (algebraMap C E ((u i : C))) = 0 := by
    rw [Differential.logDeriv, deriv_algebraMap, hconst, map_zero, zero_div]
  have hmap : torusScaleEquiv hx hgen u (Differential.logDeriv (x i))
      = Differential.logDeriv (torusScaleEquiv hx hgen u (x i)) := by
    rw [Differential.logDeriv, Differential.logDeriv, map_div₀, torusScaleEquiv_deriv]
  rw [hmap, torusScaleEquiv_apply, Differential.logDeriv_mul _ _ hc0 (hx0 i), hcderiv, zero_add]

omit [CharZero E] in
include hx in
/-- **Rescaling fixes the whole velocity field.** -/
theorem torusScaleEquiv_fixes_velocityField (hconst : ∀ c : C, c′ = 0) (u : Fin r → Cˣ)
    {z : E} (hz : z ∈ torusVelocityField C x) :
    torusScaleEquiv hx hgen u z = z := by
  have hjet : ∀ (i : Fin r) (n : ℕ),
      torusScaleEquiv hx hgen u (differentialJet n (Differential.logDeriv (x i)))
        = differentialJet n (Differential.logDeriv (x i)) := by
    intro i n
    induction n with
    | zero =>
        simp only [differentialJet_zero]
        exact torusScaleEquiv_logDeriv hx hgen hconst u i
    | succ n ih =>
        rw [differentialJet_succ, torusScaleEquiv_deriv, ih]
  rw [torusVelocityField, differentialAdjoin] at hz
  apply IntermediateField.adjoin_induction C
    (s := differentialJetSet (Set.range fun i ↦ Differential.logDeriv (x i)))
    (p := fun w _ ↦ torusScaleEquiv hx hgen u w = w)
  · rintro w ⟨v, ⟨i, rfl⟩, n, rfl⟩
    exact hjet i n
  · intro c
    exact (torusScaleEquiv hx hgen u).commutes c
  · intro a b _ _ ha hb
    rw [map_add, ha, hb]
  · intro a _ ha
    rw [map_inv₀, ha]
  · intro a b _ _ ha hb
    rw [map_mul, ha, hb]
  · exact hz

omit [CharZero E] in
include hx in
/-- The adjunction of the palette to its velocity field is derivation closed. -/
theorem derivationClosed_adjoin_velocity :
    DerivationClosed (IntermediateField.adjoin (↥(torusVelocityField C x)) (Set.range x)) := by
  have hx0 : ∀ i, x i ≠ 0 := torus_palette_ne_zero hx
  letI : Differential ↥(torusVelocityField C x) :=
    derivationClosedDifferential _ (derivationClosed_differentialAdjoin C _)
  letI : DifferentialAlgebra (↥(torusVelocityField C x)) E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C
        (Set.range fun i ↦ Differential.logDeriv (x i))) c⟩
  refine derivationClosed_adjoin_range_of_deriv_mem x fun i ↦ ?_
  have hmem : Differential.logDeriv (x i) ∈ torusVelocityField C x :=
    subset_differentialAdjoin C _ (Set.mem_range_self i)
  have hsolve : Differential.deriv (x i) = Differential.logDeriv (x i) * x i := by
    rw [Differential.logDeriv, div_mul_cancel₀ _ (hx0 i)]
  rw [hsolve]
  exact mul_mem (IntermediateField.algebraMap_mem _
      (⟨Differential.logDeriv (x i), hmem⟩ : ↥(torusVelocityField C x)))
    (IntermediateField.subset_adjoin _ _ (Set.mem_range_self i))

omit [CharZero E] in
include hx hgen in
/-- **The palette generates the ambient field over its velocity field.** -/
theorem adjoin_velocity_palette_eq_top :
    IntermediateField.adjoin (↥(torusVelocityField C x)) (Set.range x) = ⊤ := by
  set L : IntermediateField C E := torusVelocityField C x with hL
  have hle : differentialAdjoin C (Set.range x)
      ≤ (IntermediateField.adjoin (↥L) (Set.range x)).restrictScalars C := by
    rw [differentialAdjoin, IntermediateField.adjoin_le_iff]
    rintro z ⟨w, ⟨i, rfl⟩, n, rfl⟩
    show differentialJet n (x i) ∈ IntermediateField.adjoin (↥L) (Set.range x)
    induction n with
    | zero =>
        simp only [differentialJet_zero]
        exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self i)
    | succ n ih =>
        rw [differentialJet_succ]
        exact derivationClosed_adjoin_velocity hx ih
  rw [hgen] at hle
  have hres : (IntermediateField.adjoin (↥L) (Set.range x)).restrictScalars C = ⊤ :=
    top_le_iff.mp hle
  have htop : (⊤ : IntermediateField (↥L) E).restrictScalars C = ⊤ :=
    IntermediateField.restrictScalars_top
  exact IntermediateField.restrictScalars_injective C (hres.trans htop.symm)

end


/-- The character of the constant torus attached to an exponent vector. -/
def torusMonomialCharacter (C E : Type u) [Field C] [Field E] [Algebra C E] {r : ℕ}
    (e : Fin r →₀ ℕ) : (Fin r → Cˣ) →* E where
  toFun u := ∏ i, (algebraMap C E ((u i : C))) ^ (e i)
  map_one' := by
    simp
  map_mul' u v := by
    simp [mul_pow, Finset.prod_mul_distrib]

omit [Differential C] [Differential E] [DifferentialAlgebra C E] [CharZero E] in
theorem torusMonomialCharacter_apply {r : ℕ} (e : Fin r →₀ ℕ) (u : Fin r → Cˣ) :
    torusMonomialCharacter C E e u = ∏ i, (algebraMap C E ((u i : C))) ^ (e i) := rfl

omit [Differential C] [Differential E] [DifferentialAlgebra C E] in
/-- **Distinct exponent vectors give distinct characters.** -/
theorem torusMonomialCharacter_injective [CharZero C] {r : ℕ} :
    Function.Injective (torusMonomialCharacter C E (r := r)) := by
  classical
  intro e f hef
  ext j
  have htwo : ((2 : C)) ≠ 0 := two_ne_zero
  let u : Fin r → Cˣ := fun i ↦ if i = j then Units.mk0 (2 : C) htwo else 1
  have hval := congrFun
    (congrArg (fun g : (Fin r → Cˣ) →* E ↦ (g : (Fin r → Cˣ) → E)) hef) u
  rw [torusMonomialCharacter_apply, torusMonomialCharacter_apply] at hval
  have hprod : ∀ g : Fin r →₀ ℕ,
      (∏ i, (algebraMap C E ((u i : C))) ^ (g i)) = ((2 : E)) ^ (g j) := by
    intro g
    rw [Finset.prod_eq_single j]
    · simp only [u, if_pos rfl, Units.val_mk0]
      rw [map_ofNat]
    · intro i _ hij
      simp only [u, if_neg hij]
      norm_num
    · intro hj
      exact absurd (Finset.mem_univ j) hj
  rw [hprod e, hprod f] at hval
  have hcast : ((2 ^ (e j) : ℕ) : E) = ((2 ^ (f j) : ℕ) : E) := by
    push_cast
    exact hval
  have hnat : (2 : ℕ) ^ (e j) = 2 ^ (f j) := Nat.cast_injective hcast
  exact Nat.pow_right_injective (le_refl 2) hnat

section Independence

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

include hx hgen in
/-- Rescaling as an automorphism over the velocity field. -/
def torusScaleEquivVelocity (hconst : ∀ c : C, c′ = 0) (u : Fin r → Cˣ) :
    E ≃ₐ[↥(torusVelocityField C x)] E where
  toRingEquiv := (torusScaleEquiv hx hgen u).toRingEquiv
  commutes' z := torusScaleEquiv_fixes_velocityField hx hgen hconst u z.2

omit [CharZero E] in
include hx hgen in
theorem torusScaleEquivVelocity_apply (hconst : ∀ c : C, c′ = 0) (u : Fin r → Cˣ)
    (i : Fin r) :
    torusScaleEquivVelocity hx hgen hconst u (x i) = algebraMap C E ((u i : C)) * x i :=
  torusScaleEquiv_apply hx hgen u i

include hx hgen in
/-- **The palette is algebraically independent over its velocity field.**  A polynomial relation is
preserved by every constant rescaling, and distinct monomials give distinct characters of the
constant torus, so Dedekind's independence of characters kills every coefficient. -/
theorem algebraicIndependent_palette_over_velocityField [CharZero C]
    (hconst : ∀ c : C, c′ = 0) :
    AlgebraicIndependent (↥(torusVelocityField C x)) x := by
  classical
  have hx0 : ∀ i, x i ≠ 0 := torus_palette_ne_zero hx
  rw [algebraicIndependent_iff]
  intro p hp
  by_contra hpne
  -- the rescaled relation, one for each constant vector
  have hzero : ∀ u : Fin r → Cˣ,
      ∑ e ∈ p.support,
        ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff e p)
          * ∏ i, (x i) ^ (e i)) * torusMonomialCharacter C E e u = 0 := by
    intro u
    have hσ0 : (torusScaleEquivVelocity hx hgen hconst u).toAlgHom
        (MvPolynomial.aeval x p) = 0 := by
      rw [hp, map_zero]
    rw [MvPolynomial.comp_aeval_apply x
      (torusScaleEquivVelocity hx hgen hconst u).toAlgHom p] at hσ0
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq] at hσ0
    rw [← hσ0]
    refine Finset.sum_congr rfl fun e _ ↦ ?_
    rw [torusMonomialCharacter_apply]
    have hfun : ∀ i : Fin r,
        ((torusScaleEquivVelocity hx hgen hconst u).toAlgHom (x i))
          = algebraMap C E ((u i : C)) * x i := fun i ↦
      torusScaleEquivVelocity_apply hx hgen hconst u i
    have hexp : (∏ i ∈ e.support,
        ((torusScaleEquivVelocity hx hgen hconst u).toAlgHom (x i)) ^ (e i))
        = (∏ i, (algebraMap C E ((u i : C))) ^ (e i)) * ∏ i, (x i) ^ (e i) := by
      rw [← Finset.prod_mul_distrib, Finset.prod_subset (Finset.subset_univ e.support)]
      · refine Finset.prod_congr rfl fun i _ ↦ ?_
        rw [hfun i, mul_pow]
      · intro i _ hi
        rw [Finsupp.notMem_support_iff.mp hi, pow_zero]
    rw [hexp]
    ring
  -- Dedekind independence of the characters occurring in `p`
  have hinj : Function.Injective
      (fun e : ↥(p.support : Finset (Fin r →₀ ℕ)) ↦
        torusMonomialCharacter C E (e : Fin r →₀ ℕ)) :=
    fun e f hef ↦ Subtype.ext (torusMonomialCharacter_injective (C := C) (E := E) hef)
  have hindep : LinearIndependent E
      (fun e : ↥(p.support : Finset (Fin r →₀ ℕ)) ↦
        ((torusMonomialCharacter C E (e : Fin r →₀ ℕ) : (Fin r → Cˣ) → E))) :=
    (linearIndependent_monoidHom (Fin r → Cˣ) E).comp _ hinj
  have hsum : ∑ e : ↥(p.support : Finset (Fin r →₀ ℕ)),
      ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff (e : Fin r →₀ ℕ) p)
          * ∏ i, (x i) ^ ((e : Fin r →₀ ℕ) i))
        • ((torusMonomialCharacter C E (e : Fin r →₀ ℕ) : (Fin r → Cˣ) → E)) = 0 := by
    funext u
    have hz := hzero u
    simp only [Pi.zero_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [← Finset.sum_coe_sort (p.support)
      (fun e ↦ ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff e p)
        * ∏ i, (x i) ^ (e i)) * torusMonomialCharacter C E e u)] at hz
    exact hz
  have hcoeffs := (Fintype.linearIndependent_iff.mp hindep) _ hsum
  apply hpne
  ext e
  by_cases he : e ∈ p.support
  · have hzeroa := hcoeffs ⟨e, he⟩
    have hxe : (∏ i, (x i) ^ (e i)) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun i _ ↦ pow_ne_zero _ (hx0 i)
    have hc : (algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff e p) = 0 := by
      rcases mul_eq_zero.mp hzeroa with h | h
      · exact h
      · exact absurd h hxe
    have hcz : MvPolynomial.coeff e p = 0 :=
      (algebraMap (↥(torusVelocityField C x)) E).injective (by rw [hc, map_zero])
    simp [hcz]
  · simp [MvPolynomial.notMem_support_iff.mp he]

end Independence


/-- The value of a torus character in the coefficient field. -/
def torusMonomialCharacterAt {r : ℕ} (u : Fin r → Cˣ) (e : Fin r →₀ ℕ) : C :=
  ∏ i, ((u i : C)) ^ (e i)

omit [Differential C] [Differential E] [DifferentialAlgebra C E] [CharZero E] in
theorem algebraMap_torusMonomialCharacterAt {r : ℕ} (u : Fin r → Cˣ) (e : Fin r →₀ ℕ) :
    algebraMap C E (torusMonomialCharacterAt u e) = torusMonomialCharacter C E e u := by
  rw [torusMonomialCharacterAt, torusMonomialCharacter_apply, map_prod]
  exact Finset.prod_congr rfl fun i _ ↦ map_pow _ _ _

section Eigen

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

omit [CharZero E] in
include hx hgen in
/-- **Rescaling a polynomial in the palette multiplies each monomial by its character.** -/
theorem aeval_torusScale (hconst : ∀ c : C, c′ = 0) (u : Fin r → Cˣ)
    (P : MvPolynomial (Fin r) ↥(torusVelocityField C x)) :
    torusScaleEquiv hx hgen u (MvPolynomial.aeval x P)
      = ∑ e ∈ P.support, torusMonomialCharacter C E e u *
          ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff e P)
            * ∏ i, (x i) ^ (e i)) := by
  have hσ : (torusScaleEquivVelocity hx hgen hconst u).toAlgHom (MvPolynomial.aeval x P)
      = MvPolynomial.aeval
        (fun i ↦ (torusScaleEquivVelocity hx hgen hconst u).toAlgHom (x i)) P :=
    MvPolynomial.comp_aeval_apply x (torusScaleEquivVelocity hx hgen hconst u).toAlgHom P
  have hlhs : torusScaleEquiv hx hgen u (MvPolynomial.aeval x P)
      = (torusScaleEquivVelocity hx hgen hconst u).toAlgHom (MvPolynomial.aeval x P) := rfl
  rw [hlhs, hσ, MvPolynomial.aeval_def, MvPolynomial.eval₂_eq]
  refine Finset.sum_congr rfl fun e _ ↦ ?_
  rw [torusMonomialCharacter_apply]
  have hfun : ∀ i : Fin r,
      ((torusScaleEquivVelocity hx hgen hconst u).toAlgHom (x i))
        = algebraMap C E ((u i : C)) * x i := fun i ↦
    torusScaleEquivVelocity_apply hx hgen hconst u i
  have hexp : (∏ i ∈ e.support,
      ((torusScaleEquivVelocity hx hgen hconst u).toAlgHom (x i)) ^ (e i))
      = (∏ i, (algebraMap C E ((u i : C))) ^ (e i)) * ∏ i, (x i) ^ (e i) := by
    rw [← Finset.prod_mul_distrib, Finset.prod_subset (Finset.subset_univ e.support)]
    · exact Finset.prod_congr rfl fun i _ ↦ by rw [hfun i, mul_pow]
    · intro i _ hi
      rw [Finsupp.notMem_support_iff.mp hi, pow_zero]
  rw [hexp]
  ring

include hx hgen in
/-- **The eigen-support law.**  If a polynomial in the palette is an eigenvector of every rescaling
in a set of constants, with eigenvalue the character of an exponent vector `d`, then every monomial
occurring in it has the same character on that set. -/
theorem torusMonomialCharacter_eq_of_scale_eigen [CharZero C] (hconst : ∀ c : C, c′ = 0)
    {S : Set (Fin r → Cˣ)} {P : MvPolynomial (Fin r) ↥(torusVelocityField C x)}
    {d : Fin r →₀ ℕ}
    (hfix : ∀ u ∈ S, torusScaleEquiv hx hgen u (MvPolynomial.aeval x P)
      = torusMonomialCharacter C E d u * MvPolynomial.aeval x P) :
    ∀ e ∈ P.support, ∀ u ∈ S, torusMonomialCharacter C E e u = torusMonomialCharacter C E d u := by
  classical
  have hindep : AlgebraicIndependent (↥(torusVelocityField C x)) x :=
    algebraicIndependent_palette_over_velocityField hx hgen hconst
  intro e he u hu
  by_contra hne
  -- the difference polynomial vanishes on the palette
  have hmemC : ∀ c : C, algebraMap C E c ∈ torusVelocityField C x := fun c ↦
    (torusVelocityField C x).algebraMap_mem c
  let chiL : (Fin r →₀ ℕ) → ↥(torusVelocityField C x) := fun f ↦
    ⟨algebraMap C E (torusMonomialCharacterAt u f), hmemC (torusMonomialCharacterAt u f)⟩
  have hchiL : ∀ f, (algebraMap (↥(torusVelocityField C x)) E) (chiL f)
      = torusMonomialCharacter C E f u := fun f ↦ algebraMap_torusMonomialCharacterAt u f
  let Q : MvPolynomial (Fin r) ↥(torusVelocityField C x) :=
    ∑ f ∈ P.support, MvPolynomial.monomial f ((chiL f - chiL d) * MvPolynomial.coeff f P)
  have hQ : Q = ∑ f ∈ P.support,
      MvPolynomial.monomial f ((chiL f - chiL d) * MvPolynomial.coeff f P) := rfl
  have hQeval : MvPolynomial.aeval x Q = 0 := by
    rw [hQ, map_sum]
    have hterm : ∀ f ∈ P.support,
        MvPolynomial.aeval x
            (MvPolynomial.monomial f ((chiL f - chiL d) * MvPolynomial.coeff f P))
          = (torusMonomialCharacter C E f u - torusMonomialCharacter C E d u) *
            ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff f P)
              * ∏ i, (x i) ^ (f i)) := by
      intro f _
      rw [MvPolynomial.aeval_monomial, map_mul, map_sub, hchiL f, hchiL d, Finsupp.prod]
      rw [show (∏ i ∈ f.support, (x i) ^ (f i)) = ∏ i, (x i) ^ (f i) from
        Finset.prod_subset (Finset.subset_univ f.support) (fun i _ hi ↦ by
          rw [Finsupp.notMem_support_iff.mp hi, pow_zero])]
      ring
    rw [Finset.sum_congr rfl hterm]
    have hscale := aeval_torusScale hx hgen hconst u P
    have hfixu := hfix u hu
    rw [hscale] at hfixu
    have hdsum : torusMonomialCharacter C E d u * MvPolynomial.aeval x P
        = ∑ f ∈ P.support, torusMonomialCharacter C E d u *
            ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff f P)
              * ∏ i, (x i) ^ (f i)) := by
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl fun f _ ↦ ?_
      rw [show (∏ i ∈ f.support, (x i) ^ (f i)) = ∏ i, (x i) ^ (f i) from
        Finset.prod_subset (Finset.subset_univ f.support) (fun i _ hi ↦ by
          rw [Finsupp.notMem_support_iff.mp hi, pow_zero])]
    rw [hdsum] at hfixu
    have hsplit : ∀ f ∈ P.support,
        (torusMonomialCharacter C E f u - torusMonomialCharacter C E d u) *
            ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff f P)
              * ∏ i, (x i) ^ (f i))
          = torusMonomialCharacter C E f u *
              ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff f P)
                * ∏ i, (x i) ^ (f i))
            - torusMonomialCharacter C E d u *
              ((algebraMap (↥(torusVelocityField C x)) E) (MvPolynomial.coeff f P)
                * ∏ i, (x i) ^ (f i)) := fun f _ ↦ sub_mul _ _ _
    rw [Finset.sum_congr rfl hsplit, Finset.sum_sub_distrib, hfixu, sub_self]
  have hQ0 : Q = 0 := hindep hQeval
  have hcoeff := congrArg (MvPolynomial.coeff e) hQ0
  rw [hQ, MvPolynomial.coeff_zero] at hcoeff
  rw [MvPolynomial.coeff_sum] at hcoeff
  rw [Finset.sum_eq_single e] at hcoeff
  · have hcP : MvPolynomial.coeff e P ≠ 0 := MvPolynomial.mem_support_iff.mp he
    rw [MvPolynomial.coeff_monomial, if_pos rfl] at hcoeff
    rcases mul_eq_zero.mp hcoeff with h | h
    · apply hne
      have hEq := congrArg (algebraMap (↥(torusVelocityField C x)) E) (sub_eq_zero.mp h)
      rw [hchiL e, hchiL d] at hEq
      exact hEq
    · exact hcP h
  · intro f _ hfe
    rw [MvPolynomial.coeff_monomial, if_neg hfe]
  · intro hnot
    exact absurd he hnot

end Eigen

end

end GaloisForLFunctions.HTGeometry
