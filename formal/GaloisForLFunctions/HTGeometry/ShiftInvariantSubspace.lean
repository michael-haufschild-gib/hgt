import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.LinearAlgebra.Span.Defs

/-!
# A shift-invariant subspace is stable under everything the shift generates

A subspace invariant under multiplication by one element is invariant under multiplication by every
polynomial in that element: the invariance propagates along the monomial induction.

So in an algebra generated by a single element — for instance `K[t]/(f)`, generated by `t` — the
subspaces invariant under multiplication by the generator are exactly the ideals.  That is what
identifies the invariant subspaces of the shift on `K[t]/(f)` with the divisors of `f`, and hence,
for a separable split `f`, with the subsets of its roots.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable {K R : Type*} [Field K] [CommRing R] [Algebra K R]

/-- **Invariance under one element propagates to every polynomial in it.** -/
theorem mul_mem_of_generator_mul_mem {x : R} (V : Submodule K R)
    (hV : ∀ v ∈ V, x * v ∈ V) :
    ∀ (p : K[X]) {v : R}, v ∈ V → (Polynomial.aeval x p) * v ∈ V := by
  intro p
  induction p using Polynomial.induction_on with
  | C a =>
      intro v hv
      rw [Polynomial.aeval_C, ← Algebra.smul_def]
      exact V.smul_mem a hv
  | add p q hp hq =>
      intro v hv
      rw [map_add, add_mul]
      exact V.add_mem (hp hv) (hq hv)
  | monomial k a hk =>
      intro v hv
      have hstep : (Polynomial.aeval x (Polynomial.C a * X ^ (k + 1))) * v
          = (Polynomial.aeval x (Polynomial.C a * X ^ k)) * (x * v) := by
        rw [map_mul, map_mul, map_pow, map_pow, Polynomial.aeval_X]
        ring
      rw [hstep]
      exact hk (hV v hv)

/-- **In a singly generated algebra, an invariant subspace is an ideal.** -/
theorem smul_mem_of_generator_mul_mem {x : R} (hgen : ∀ r : R, ∃ p : K[X], r = Polynomial.aeval x p)
    (V : Submodule K R) (hV : ∀ v ∈ V, x * v ∈ V) (r : R) {v : R} (hv : v ∈ V) : r * v ∈ V := by
  obtain ⟨p, rfl⟩ := hgen r
  exact mul_mem_of_generator_mul_mem V hV p hv

/-- The ideal cut out by an invariant subspace of a singly generated algebra. -/
def invariantIdeal {x : R} (hgen : ∀ r : R, ∃ p : K[X], r = Polynomial.aeval x p)
    (V : Submodule K R) (hV : ∀ v ∈ V, x * v ∈ V) : Ideal R where
  carrier := (V : Set R)
  add_mem' ha hb := V.add_mem ha hb
  zero_mem' := V.zero_mem
  smul_mem' c _ hx := smul_mem_of_generator_mul_mem hgen V hV c hx

@[simp] theorem mem_invariantIdeal {x : R}
    (hgen : ∀ r : R, ∃ p : K[X], r = Polynomial.aeval x p)
    (V : Submodule K R) (hV : ∀ v ∈ V, x * v ∈ V) {r : R} :
    r ∈ invariantIdeal hgen V hV ↔ r ∈ V := Iff.rfl

end GaloisForLFunctions.HTGeometry
