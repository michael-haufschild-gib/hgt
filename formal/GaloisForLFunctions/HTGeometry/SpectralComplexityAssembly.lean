import GaloisForLFunctions.HTGeometry.SpectralExponentialIndependence
import GaloisForLFunctions.HTGeometry.ExactCircuitComplexityBound

/-!
# From spectral rigidity to a circuit lower bound

The two halves built separately are joined here.  If the only rational relation among the algebraic
eigenvalues is the trace relation, the exponentials carry transcendence degree at least `D - 1`;
and a state prepared from a base-field input by gates each generated by `q` elements carries at
most `q` times the number of gates.  Reading the state in an eigenbasis does not change the
generated algebra, so the two bounds meet.

The eigenbasis hypothesis appears as an equality of generated algebras rather than as a matrix,
which is what `MatrixLinearFormsAdjoin.adjoin_matrixLinearForms_mul_diagonal_eq` supplies for an
invertible change of coordinates, over whichever base field the eigenbasis happens to live in.
-/

namespace GaloisForLFunctions.HTGeometry

namespace SpectralComplexity

open Matrix Cardinal

/-- **Spectral rigidity forces circuit size.**  With `q = 16` and `D = card ι` this is
`C₀ ≥ (D-1)/16`. -/
theorem card_sub_one_le_length_mul {ι : Type} [Fintype ι] [DecidableEq ι] {E : ι → ℂ} (i₀ : ι)
    (halg : ∀ i, IsAlgebraic ℚ (E i))
    (hrigid : LinearMap.ker (SpectralExp.relationForm E)
      = PermSubspace.constLine (K := ℚ) (ι := ι))
    {q : ℕ} (l : List (Matrix ι ι ℂ)) (v : ι → ℂ)
    (hl : ∀ M ∈ l, CircuitAdjoin.GeneratedBy (L := ℂ) ℚ q M)
    (hv : ∀ i, ∃ a : ℚ, v i = algebraMap ℚ ℂ a)
    (hadjoin : Algebra.adjoin ℚ (Set.range (l.prod *ᵥ v))
      = Algebra.adjoin ℚ (Set.range fun j => Complex.exp (E j))) :
    Fintype.card ι - 1 ≤ l.length * q := by
  classical
  set S : Subalgebra ℚ ℂ := Algebra.adjoin ℚ (Set.range fun j => Complex.exp (E j)) with hS
  -- the deleted family is algebraically independent and lies in `S`
  have hind := SpectralExp.algebraicIndependent_exp_of_ker_eq_constLine halg hrigid i₀
  have hmem : ∀ j : {j : ι // j ≠ i₀}, Complex.exp (E j.1) ∈ S := fun j =>
    Algebra.subset_adjoin ⟨j.1, rfl⟩
  set y : {j : ι // j ≠ i₀} → S := fun j => ⟨Complex.exp (E j.1), hmem j⟩ with hy
  have hcomp : (S.val : S →ₐ[ℚ] ℂ) ∘ y = fun j : {j : ι // j ≠ i₀} => Complex.exp (E j.1) := rfl
  have hyind : AlgebraicIndependent ℚ y :=
    AlgebraicIndependent.of_comp (S.val : S →ₐ[ℚ] ℂ) (by rw [hcomp]; exact hind)
  have hlow : (#{j : ι // j ≠ i₀} : Cardinal) ≤ Algebra.trdeg ℚ S := hyind.cardinalMk_le_trdeg
  -- the circuit bounds the same transcendence degree from above
  have hhigh : Algebra.trdeg ℚ S ≤ ((l.length * q : ℕ) : Cardinal) := by
    rw [← hadjoin]
    exact CircuitAdjoin.trdeg_adjoin_le_length_mul l v hl hv
  have hcard : (#{j : ι // j ≠ i₀} : Cardinal) = ((Fintype.card ι - 1 : ℕ) : Cardinal) := by
    rw [Cardinal.mk_fintype]
    congr 1
    simp [Fintype.card_subtype_compl]
  rw [hcard] at hlow
  exact_mod_cast hlow.trans hhigh

end SpectralComplexity

end GaloisForLFunctions.HTGeometry
