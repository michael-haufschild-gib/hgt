import GaloisForLFunctions.HTGeometry.DifferentialPrincipalIdeal

/-!
# Sigma--delta orbit ideals

The ideal generated by every forward difference iterate and every derivative of a family is the
smallest doubly stable ideal containing that family.  A differential evaluation need not commute
with the difference operator to prove this ideal proper: it is enough that it annihilate every
forward difference iterate of every generator.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R S : Type*} [CommRing R] [Differential R]

/-- Ideal generated by all derivatives of all forward difference iterates of a family. -/
def sigmaDeltaOrbitIdeal (σ : R ≃+* R) (generators : Set R) : Ideal R :=
  Ideal.span {x | ∃ p ∈ generators, ∃ m n : ℕ,
    x = (Differential.deriv^[n]) ((σ : R → R)^[m] p)}

/-- A difference automorphism commuting with the derivation commutes with every derivative
iterate. -/
theorem sigma_map_iterate_deriv {σ : R ≃+* R}
    (hσ : CommutesDeriv σ) (n : ℕ) (x : R) :
    σ ((Differential.deriv^[n]) x) = (Differential.deriv^[n]) (σ x) := by
  induction n with
  | zero => simp
  | succ n hn =>
      rw [Function.iterate_succ_apply', hσ, hn,
        Function.iterate_succ_apply']

/-- The sigma--delta orbit ideal is stable under the derivation. -/
theorem deriv_mem_sigmaDeltaOrbitIdeal {σ : R ≃+* R} {generators : Set R} {x : R}
    (hx : x ∈ sigmaDeltaOrbitIdeal σ generators) :
    Differential.deriv x ∈ sigmaDeltaOrbitIdeal σ generators := by
  change x ∈ Submodule.span R
    {x | ∃ p ∈ generators, ∃ m n : ℕ,
      x = (Differential.deriv^[n]) ((σ : R → R)^[m] p)} at hx
  refine Submodule.span_induction (hx := hx) ?_ ?_ ?_ ?_
  · rintro x ⟨p, hp, m, n, rfl⟩
    apply Ideal.subset_span
    exact ⟨p, hp, m, n + 1, by rw [Function.iterate_succ_apply']⟩
  · simp
  · intro a b _ _ ha hb
    simpa using (sigmaDeltaOrbitIdeal σ generators).add_mem ha hb
  · intro a x hx hdx
    rw [show a • x = a * x by simp, Derivation.leibniz]
    exact (sigmaDeltaOrbitIdeal σ generators).add_mem
      ((sigmaDeltaOrbitIdeal σ generators).mul_mem_left a hdx)
      ((sigmaDeltaOrbitIdeal σ generators).mul_mem_right
        (Differential.deriv a) hx)

/-- The sigma--delta orbit ideal is stable under the difference automorphism. -/
theorem sigma_mem_sigmaDeltaOrbitIdeal {σ : R ≃+* R} (hσ : CommutesDeriv σ)
    {generators : Set R} {x : R} (hx : x ∈ sigmaDeltaOrbitIdeal σ generators) :
    σ x ∈ sigmaDeltaOrbitIdeal σ generators := by
  change x ∈ Submodule.span R
    {x | ∃ p ∈ generators, ∃ m n : ℕ,
      x = (Differential.deriv^[n]) ((σ : R → R)^[m] p)} at hx
  refine Submodule.span_induction (hx := hx) ?_ ?_ ?_ ?_
  · rintro x ⟨p, hp, m, n, rfl⟩
    rw [sigma_map_iterate_deriv hσ]
    apply Ideal.subset_span
    exact ⟨p, hp, m + 1, n, by rw [Function.iterate_succ_apply']⟩
  · simp
  · intro a b _ _ ha hb
    simpa using (sigmaDeltaOrbitIdeal σ generators).add_mem ha hb
  · intro a x _ hσx
    simpa [smul_eq_mul] using
      (sigmaDeltaOrbitIdeal σ generators).mul_mem_left (σ a) hσx

/-- The orbit ideal is a sigma--delta ideal. -/
theorem isSigmaDeltaIdeal_sigmaDeltaOrbitIdeal {σ : R ≃+* R}
    (hσ : CommutesDeriv σ) (generators : Set R) :
    IsSigmaDeltaIdeal σ (sigmaDeltaOrbitIdeal σ generators) :=
  ⟨fun _ hx => sigma_mem_sigmaDeltaOrbitIdeal hσ hx,
    fun _ hx => deriv_mem_sigmaDeltaOrbitIdeal hx⟩

/-- Every chosen generator belongs to its sigma--delta orbit ideal. -/
theorem mem_sigmaDeltaOrbitIdeal {σ : R ≃+* R} {generators : Set R} {p : R}
    (hp : p ∈ generators) : p ∈ sigmaDeltaOrbitIdeal σ generators := by
  apply Ideal.subset_span
  exact ⟨p, hp, 0, 0, by simp⟩

/-- The orbit ideal is contained in every sigma--delta ideal containing its generators. -/
theorem sigmaDeltaOrbitIdeal_le_of_isSigmaDeltaIdeal {σ : R ≃+* R}
    {generators : Set R} {I : Ideal R} (hI : IsSigmaDeltaIdeal σ I)
    (hgen : generators ⊆ I) : sigmaDeltaOrbitIdeal σ generators ≤ I := by
  rw [sigmaDeltaOrbitIdeal, Ideal.span_le]
  rintro x ⟨p, hp, m, n, rfl⟩
  have hsigma : ((σ : R → R)^[m]) p ∈ I := by
    induction m with
    | zero => simpa using hgen hp
    | succ m hm =>
        rw [Function.iterate_succ_apply']
        exact hI.1 _ hm
  induction n with
  | zero => simpa using hsigma
  | succ n hn =>
      rw [Function.iterate_succ_apply']
      exact hI.2 _ hn

/-- An evaluation annihilating every shifted generator proves the orbit ideal proper.  Only
differential compatibility is required of the evaluation. -/
theorem sigmaDeltaOrbitIdeal_ne_top_of_ringHom {σ : R ≃+* R}
    {generators : Set R} [CommRing S] [Nontrivial S] [Differential S]
    (f : R →+* S)
    (hf : ∀ x : R, f (Differential.deriv x) = Differential.deriv (f x))
    (hzero : ∀ p ∈ generators, ∀ m : ℕ,
      f (((σ : R → R)^[m]) p) = 0) :
    sigmaDeltaOrbitIdeal σ generators ≠ ⊤ := by
  have hle : sigmaDeltaOrbitIdeal σ generators ≤ RingHom.ker f := by
    rw [sigmaDeltaOrbitIdeal, Ideal.span_le]
    rintro x ⟨p, hp, m, n, rfl⟩
    change f ((Differential.deriv^[n]) (((σ : R → R)^[m]) p)) = 0
    induction n with
    | zero => simpa using hzero p hp m
    | succ n hn =>
        rw [Function.iterate_succ_apply', hf, hn, map_zero]
  intro htop
  have h1 : (1 : R) ∈ RingHom.ker f := hle (by rw [htop]; trivial)
  change f 1 = 0 at h1
  rw [map_one] at h1
  exact one_ne_zero h1

end

end GaloisForLFunctions.HTGeometry
