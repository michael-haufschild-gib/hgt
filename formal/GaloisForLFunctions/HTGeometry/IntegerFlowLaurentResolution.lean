import GaloisForLFunctions.HTGeometry.RotationInducedArithmeticModule
import Mathlib.Data.Finset.Max

/-!
# Exact Laurent resolution of an integer linear flow

The differential is shift minus the flow generator. Its kernel is zero,
and its range is exactly the kernel of finite Laurent evaluation. The
proof uses finite telescoping and a smallest support index, retaining
arbitrary Jordan structure without any convergence premise.
-/

namespace GaloisForLFunctions.HTGeometry
noncomputable section
open scoped Classical
variable {M : Type*} [AddCommGroup M] [Module ℂ M]

/-- Evaluation of a finite Laurent family in an actual integer flow. -/
def integerFlowEvaluation (T : IntegerLinearFlow M) : (ℤ →₀ M) →ₗ[ℂ] M :=
  Finsupp.lsum ℂ fun b => T (Multiplicative.ofAdd b)

@[simp] theorem integerFlowEvaluation_single (T : IntegerLinearFlow M) (b : ℤ) (m : M) :
    integerFlowEvaluation T (Finsupp.single b m) = T (Multiplicative.ofAdd b) m := by
  simp [integerFlowEvaluation]

/-- The actual shift-minus-flow relation, before choosing coordinates in M. -/
def integerFlowRelation (T : IntegerLinearFlow M) : Module.End ℂ (ℤ →₀ M) :=
  (Finsupp.domLCongr (Equiv.addRight (1 : ℤ))).toLinearMap -
    Finsupp.mapRange.linearMap (T (Multiplicative.ofAdd 1))

@[simp] theorem integerFlowRelation_single (T : IntegerLinearFlow M) (b : ℤ) (m : M) :
    integerFlowRelation T (Finsupp.single b m) =
      Finsupp.single (b + 1) m - Finsupp.single b (T (Multiplicative.ofAdd 1) m) := by
  simp [integerFlowRelation]

@[simp] theorem integerFlowRelation_apply (T : IntegerLinearFlow M) (x : ℤ →₀ M) (b : ℤ) :
    integerFlowRelation T x b = x (b - 1) - T (Multiplicative.ofAdd 1) (x b) := by
  rfl

private theorem integerFlow_add_apply (T : IntegerLinearFlow M) (a b : ℤ) (m : M) :
    T (Multiplicative.ofAdd (a + b)) m =
      T (Multiplicative.ofAdd a) (T (Multiplicative.ofAdd b) m) := by
  exact congrArg (fun L : Module.End ℂ M => L m) (T.map_mul (Multiplicative.ofAdd a) (Multiplicative.ofAdd b))

@[simp] theorem integerFlowEvaluation_relation (T : IntegerLinearFlow M) (x : ℤ →₀ M) :
    integerFlowEvaluation T (integerFlowRelation T x) = 0 := by
  induction x using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy, add_zero]
  | single b m => simp

/-- Every single Laurent generator has an exact reduction to its clock-zero evaluation. -/
theorem integerFlow_single_reduction (T : IntegerLinearFlow M) (b : ℤ) (m : M) :
    Finsupp.single b m - Finsupp.single 0 (T (Multiplicative.ofAdd b) m) ∈
      LinearMap.range (integerFlowRelation T) := by
  induction b using Int.induction_on generalizing m with
  | zero => simp
  | succ n ih =>
    have hD : integerFlowRelation T (Finsupp.single (n : ℤ) m) ∈
        LinearMap.range (integerFlowRelation T) := LinearMap.mem_range_self _ _
    have h := (LinearMap.range (integerFlowRelation T)).add_mem hD
      (ih (T (Multiplicative.ofAdd 1) m))
    simpa only [integerFlowRelation_single, integerFlow_add_apply, sub_add_sub_cancel] using h
  | pred n ih =>
    let v := T (Multiplicative.ofAdd (-1)) m
    have hv : T (Multiplicative.ofAdd 1) v = m := by
      rw [← integerFlow_add_apply]
      simp
    have hD : integerFlowRelation T (Finsupp.single (-(n : ℤ) - 1) v) ∈
        LinearMap.range (integerFlowRelation T) := LinearMap.mem_range_self _ _
    have h := (LinearMap.range (integerFlowRelation T)).sub_mem (ih v) hD
    have hi : -(n : ℤ) - 1 + 1 = -(n : ℤ) := by omega
    have hT : T (Multiplicative.ofAdd (-(n : ℤ))) v =
        T (Multiplicative.ofAdd (-(n : ℤ) - 1)) m := by
      exact (integerFlow_add_apply T (-(n : ℤ)) (-1) m).symm
    rw [integerFlowRelation_single, hi, hv, hT] at h
    convert h using 1
    abel

/-- Exact finite reduction; no convergence, semisimplicity, or spectral synthesis is used. -/
theorem integerFlow_reduction (T : IntegerLinearFlow M) (x : ℤ →₀ M) :
    x - Finsupp.single 0 (integerFlowEvaluation T x) ∈ LinearMap.range (integerFlowRelation T) := by
  induction x using Finsupp.induction_linear with
  | zero => simp
  | add x y hx hy =>
    have h := (LinearMap.range (integerFlowRelation T)).add_mem hx hy
    simpa only [map_add, Finsupp.single_add, add_sub_add_comm] using h
  | single b m => simpa only [integerFlowEvaluation_single] using integerFlow_single_reduction T b m

/-- All relations are generated by the actual shift-minus-flow operator. -/
theorem integerFlowEvaluation_ker (T : IntegerLinearFlow M) :
    LinearMap.ker (integerFlowEvaluation T) = LinearMap.range (integerFlowRelation T) := by
  apply le_antisymm
  · intro x hx
    have h := integerFlow_reduction T x
    simpa only [LinearMap.mem_ker.mp hx, Finsupp.single_zero, sub_zero] using h
  · rintro _ ⟨x, rfl⟩
    exact integerFlowEvaluation_relation T x

/-- The Laurent relation has no hidden kernel. -/
theorem integerFlowRelation_injective (T : IntegerLinearFlow M) :
    Function.Injective (integerFlowRelation T) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro x hx
  by_contra hne
  have hs := Finsupp.support_nonempty_iff.mpr hne
  let k := x.support.min' hs
  have hk : k ∈ x.support := Finset.min'_mem _ _
  have hprev : x (k - 1) = 0 := by
    apply Finsupp.notMem_support_iff.mp
    intro h
    have := x.support.min'_le (k - 1) h
    omega
  have he := congrArg (fun y : ℤ →₀ M => y k) hx
  rw [integerFlowRelation_apply, hprev] at he
  have hzero : T (Multiplicative.ofAdd 1) (x k) = 0 := by
    simpa only [zero_sub, Finsupp.zero_apply, neg_eq_zero] using he
  have hinv := congrArg (fun m => T (Multiplicative.ofAdd (-1)) m) hzero
  rw [← integerFlow_add_apply] at hinv
  have hxk : x k = 0 := by simpa using hinv
  exact Finsupp.mem_support_iff.mp hk hxk

theorem integerFlowEvaluation_surjective (T : IntegerLinearFlow M) :
    Function.Surjective (integerFlowEvaluation T) := by
  intro m
  exact ⟨Finsupp.single 0 m, by simp⟩

/-- A proved length-one resolution of any integer flow in Laurent coordinates. -/
theorem integerFlow_resolution_exact (T : IntegerLinearFlow M) :
    Function.Injective (integerFlowRelation T) ∧
      LinearMap.range (integerFlowRelation T) = LinearMap.ker (integerFlowEvaluation T) ∧
      Function.Surjective (integerFlowEvaluation T) :=
  ⟨integerFlowRelation_injective T, (integerFlowEvaluation_ker T).symm,
    integerFlowEvaluation_surjective T⟩

end
end GaloisForLFunctions.HTGeometry
