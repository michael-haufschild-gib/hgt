import GaloisForLFunctions.HTGeometry.AbelianHiggsMechanism

/-!
# Finite Abelian spinor--curvature skeleton for Seiberg--Witten theory

This module isolates the algebraic, pointwise part of the Seiberg--Witten curvature equation:
the quadratic spinor map is the Hermitian outer square of a complex two-component spinor.  It
proves that this equation, its curvature invariant, and its gauge-orbit curves are preserved by
the existing common `U(1)` phase action.

This remains a deliberately finite pointwise skeleton.  The separate
`SeibergWitten.Geometry`, `Orientation`, `PrincipalSpinC`, `Connections`, `Hodge`, and `Equations`
modules now supply the corresponding smooth-manifold, algebraic principal-`Spinᶜ`, connection,
Hodge, and coupled-equation layers.  Consequently `seibergWittenEquation` below still records
only the algebraic spinor--curvature component `F = q(ψ)`, rather than identifying this matrix
carrier with the curvature of a continuum connection.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

/-- Two-component complex positive-spinor surrogate used by the finite Abelian skeleton. -/
abbrev SeibergWittenSpinor := Fin 2 → ℂ

/-- Hermitian curvature surrogate generated by a positive spinor. -/
abbrev SeibergWittenCurvature := Matrix (Fin 2) (Fin 2) ℂ

/-- The algebraic quadratic spinor map `q(ψ) = ψψ†`. -/
def seibergWittenQuadraticMap (ψ : SeibergWittenSpinor) : SeibergWittenCurvature :=
  higgsSpinorEventMatrix ψ

/-- Pointwise algebraic component `F = q(ψ)` of the Abelian Seiberg--Witten equations. -/
def seibergWittenEquation (F : SeibergWittenCurvature) (ψ : SeibergWittenSpinor) : Prop :=
  F = seibergWittenQuadraticMap ψ

/-- Gauge-invariant curvature record; this is the finite skeleton's Seiberg--Witten invariant. -/
def seibergWittenInvariant (ψ : SeibergWittenSpinor) : SeibergWittenCurvature :=
  seibergWittenQuadraticMap ψ

/-- Phase-gauge orbit curve through a spinor configuration. -/
def seibergWittenGaugeOrbitCurve (ψ : SeibergWittenSpinor) : Circle → SeibergWittenSpinor :=
  fun u => u • ψ

/-- A time-indexed `U(1)` gauge flow through a spinor configuration.

No continuity or dynamical equation is claimed: this is the exact gauge-orbit part of a possible
Seiberg--Witten flow, separated from the missing analytic PDE infrastructure. -/
def seibergWittenGaugeFlow (phase : ℝ → Circle) (ψ : SeibergWittenSpinor) :
    ℝ → SeibergWittenSpinor :=
  fun t => phase t • ψ

/-- Gauge-equivalence relation generated by the common `U(1)` phase action. -/
def seibergWittenGaugeEquivalent (ψ χ : SeibergWittenSpinor) : Prop :=
  ∃ u : Circle, u • ψ = χ

/-- The induced curvature solves the pointwise Abelian spinor--curvature equation. -/
theorem seibergWittenEquation_inducedCurvature (ψ : SeibergWittenSpinor) :
    seibergWittenEquation (seibergWittenQuadraticMap ψ) ψ := rfl

/-- The quadratic spinor map is invariant under every common `U(1)` phase. -/
theorem seibergWittenQuadraticMap_gaugeInvariant (u : Circle) (ψ : SeibergWittenSpinor) :
    seibergWittenQuadraticMap (u • ψ) = seibergWittenQuadraticMap ψ :=
  abelianHiggsSpinorEventMatrix_gaugeInvariant u ψ

/-- The finite Seiberg--Witten invariant is constant on each gauge orbit. -/
theorem seibergWittenInvariant_gaugeInvariant (u : Circle) (ψ : SeibergWittenSpinor) :
    seibergWittenInvariant (u • ψ) = seibergWittenInvariant ψ :=
  seibergWittenQuadraticMap_gaugeInvariant u ψ

/-- The induced curvature equation holds at every point of its phase-gauge orbit curve. -/
theorem seibergWittenGaugeOrbitCurve_solvesEquation (u : Circle) (ψ : SeibergWittenSpinor) :
    seibergWittenEquation (seibergWittenQuadraticMap ψ)
      (seibergWittenGaugeOrbitCurve ψ u) := by
  exact (seibergWittenQuadraticMap_gaugeInvariant u ψ).symm

/-- The finite Seiberg--Witten invariant is constant along its phase-gauge orbit curve. -/
theorem seibergWittenGaugeOrbitCurve_invariant (u : Circle) (ψ : SeibergWittenSpinor) :
    seibergWittenInvariant (seibergWittenGaugeOrbitCurve ψ u) =
      seibergWittenInvariant ψ :=
  seibergWittenInvariant_gaugeInvariant u ψ

/-- The induced curvature equation holds pointwise along every time-indexed gauge flow. -/
theorem seibergWittenGaugeFlow_solvesEquation
    (phase : ℝ → Circle) (t : ℝ) (ψ : SeibergWittenSpinor) :
    seibergWittenEquation (seibergWittenQuadraticMap ψ)
      (seibergWittenGaugeFlow phase ψ t) := by
  exact (seibergWittenQuadraticMap_gaugeInvariant (phase t) ψ).symm

/-- The finite Seiberg--Witten invariant is constant pointwise along every gauge flow. -/
theorem seibergWittenGaugeFlow_invariant
    (phase : ℝ → Circle) (t : ℝ) (ψ : SeibergWittenSpinor) :
    seibergWittenInvariant (seibergWittenGaugeFlow phase ψ t) =
      seibergWittenInvariant ψ :=
  seibergWittenInvariant_gaugeInvariant (phase t) ψ

/-- The finite curvature invariant of every spinor is Hermitian. -/
theorem seibergWittenInvariant_isHermitian (ψ : SeibergWittenSpinor) :
    (seibergWittenInvariant ψ).IsHermitian :=
  higgsSpinorEventMatrix_isHermitian ψ

/-- The finite curvature invariant of every spinor has zero determinant. -/
theorem seibergWittenInvariant_det_eq_zero (ψ : SeibergWittenSpinor) :
    (seibergWittenInvariant ψ).det = 0 :=
  higgsSpinorEventMatrix_det ψ

/-- The Lorentz-coordinate representative of every finite curvature invariant is null. -/
theorem seibergWittenInvariant_lorentzQuadratic_eq_zero (ψ : SeibergWittenSpinor) :
    higgsSpinorTime ψ ^ (2 : ℕ) - higgsSpinorX ψ ^ (2 : ℕ) - higgsSpinorY ψ ^ (2 : ℕ) -
        higgsSpinorZ ψ ^ (2 : ℕ) = 0 :=
  higgsSpinor_lorentzQuadratic_eq_zero ψ

/-- The selected spinor vacuum is an exact zero-energy configuration. -/
theorem seibergWittenVacuum_zeroPotential :
    abelianHiggsSpinorPotential abelianHiggsSpinorVacuum = 0 :=
  abelianHiggsSpinorPotential_vacuum

/-- A second zero-energy vacuum is not gauge-equivalent to the selected spinor vacuum. -/
theorem seibergWittenOrthogonalVacuum_not_gaugeEquivalent :
    ¬ seibergWittenGaugeEquivalent abelianHiggsSpinorVacuum
      abelianHiggsSpinorOrthogonalVacuum := by
  intro h
  apply abelianHiggsSpinorOrthogonalVacuum_not_mem_orbit
  rw [HiggsMechanism.vacuumOrbit, MulAction.mem_orbit_iff]
  exact h

/-- The finite invariant distinguishes the two closed, gauge-inequivalent zero-energy vacua. -/
theorem seibergWittenVacuumInvariants_ne :
    seibergWittenInvariant abelianHiggsSpinorVacuum ≠
      seibergWittenInvariant abelianHiggsSpinorOrthogonalVacuum :=
  abelianHiggsSpinorVacuum_records_ne

end GaloisForLFunctions.HTGeometry
