import GaloisForLFunctions.HTGeometry.DifferentialJetPivotCore

/-!
# The finitely supported affine pivot presentation

Each dependent jet is a finitely supported affine combination of pivot jets at the same order,
`J r n = C (h r n) + ∑_b (A r) b · X (b, n)`, with no finiteness assumption on the pivot set.
Elimination, the displayed relations, the kernel description, the PBW normal form and the complete
relation theorem are `DifferentialJetPivotCore` at that jet family.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The affine polynomial which replaces one dependent jet, with a finitely supported pivot row. -/
def differentialFinsuppPivotAffineJet
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial B F :=
  MvPolynomial.C (h r n) +
    (A r).sum fun b c ↦ MvPolynomial.C c * MvPolynomial.X (b, n)

/-- Eliminate every dependent jet by its finitely supported affine pivot expression. -/
def differentialFinsuppPivotElimination
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    DifferentialPolynomial (B ⊕ R) F →ₐ[F] DifferentialPolynomial B F :=
  differentialJetPivotElimination (differentialFinsuppPivotAffineJet A h)

/-- Include pivot differential polynomials into the left variables of the full jet ring. -/
def differentialFinsuppPivotInclusion
    {F B R : Type*} [Field F] :
    DifferentialPolynomial B F →ₐ[F] DifferentialPolynomial (B ⊕ R) F :=
  differentialJetPivotInclusion

@[simp]
theorem differentialFinsuppPivotElimination_X_inl
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (b : B) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (MvPolynomial.X (Sum.inl b, n)) = MvPolynomial.X (b, n) :=
  differentialJetPivotElimination_X_inl _ b n

@[simp]
theorem differentialFinsuppPivotElimination_X_inr
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (MvPolynomial.X (Sum.inr r, n)) = differentialFinsuppPivotAffineJet A h r n :=
  differentialJetPivotElimination_X_inr _ r n

@[simp]
theorem differentialFinsuppPivotInclusion_X
    {F B R : Type*} [Field F] (b : B) (n : ℕ) :
    differentialFinsuppPivotInclusion (R := R)
        (MvPolynomial.X (b, n)) =
      (MvPolynomial.X (Sum.inl b, n) : DifferentialPolynomial (B ⊕ R) F) :=
  differentialJetPivotInclusion_X b n

/-- Elimination is a left inverse to pivot inclusion. -/
@[simp]
theorem differentialFinsuppPivotElimination_inclusion
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F)
    (P : DifferentialPolynomial B F) :
    differentialFinsuppPivotElimination A h (differentialFinsuppPivotInclusion P) = P :=
  differentialJetPivotElimination_inclusion _ P

/-- The displayed affine relation for one dependent jet. -/
def differentialFinsuppPivotRelation
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial (B ⊕ R) F :=
  differentialJetPivotRelation (differentialFinsuppPivotAffineJet A h) r n

/-- The ideal generated by all displayed affine pivot jet relations. -/
def differentialFinsuppPivotRelationIdeal
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    Ideal (DifferentialPolynomial (B ⊕ R) F) :=
  differentialJetPivotRelationIdeal (differentialFinsuppPivotAffineJet A h)

@[simp]
theorem differentialFinsuppPivotElimination_relation
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (differentialFinsuppPivotRelation A h r n) = 0 :=
  differentialJetPivotElimination_relation _ r n

/-- Every polynomial differs from its eliminated pivot normal form by the displayed relations. -/
theorem sub_finsuppPivotInclusion_elimination_mem_relationIdeal
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F)
    (P : DifferentialPolynomial (B ⊕ R) F) :
    P - differentialFinsuppPivotInclusion (differentialFinsuppPivotElimination A h P) ∈
      differentialFinsuppPivotRelationIdeal A h :=
  sub_jetPivotInclusion_elimination_mem_relationIdeal _ P

/-- The affine pivot relation ideal is exactly the elimination kernel. -/
theorem differentialFinsuppPivotRelationIdeal_eq_ker
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    differentialFinsuppPivotRelationIdeal A h =
      RingHom.ker (differentialFinsuppPivotElimination A h).toRingHom :=
  differentialJetPivotRelationIdeal_eq_ker _

theorem differentialFinsuppPivotElimination_surjective
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    Function.Surjective (differentialFinsuppPivotElimination A h) :=
  differentialJetPivotElimination_surjective _

/-- **All-cardinality PBW normal form.**  Quotienting the full jet polynomial algebra by the
displayed finitely supported affine relations gives exactly the free polynomial algebra on the
pivot jets. -/
noncomputable def differentialFinsuppPivotQuotientEquiv
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    (DifferentialPolynomial (B ⊕ R) F ⧸
        differentialFinsuppPivotRelationIdeal A h) ≃ₐ[F]
      DifferentialPolynomial B F :=
  differentialJetPivotQuotientEquiv (differentialFinsuppPivotAffineJet A h)

/-- Evaluation of the full pivot/dependent family factors through finitely supported elimination. -/
theorem differentialPolynomialEval_sumElim_eq_finsuppPivotElimination
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (A : R → B →₀ F) (h : R → ℕ → F)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        (A r).sum fun b c ↦ algebraMap F K c * differentialJet n (x b))
    (P : DifferentialPolynomial (B ⊕ R) F) :
    differentialPolynomialEval (C := F) (Sum.elim x y) P =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))
        (differentialFinsuppPivotElimination A h P) :=
  differentialPolynomialEval_sumElim_eq_jetPivotElimination x y _
    (fun r n => by
      classical
      rw [hrel r n]
      simp only [differentialFinsuppPivotAffineJet, map_add, MvPolynomial.aeval_C]
      congr 1
      simp only [Finsupp.sum]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro b hb
      simp) P

/-- **All-cardinality complete differential relation theorem.**  If the pivot family is
differentially independent and every dependent jet has a finitely supported affine pivot
expression, then the displayed affine jet relations generate every relation of the combined
family. -/
theorem differentialRelationIdeal_sumElim_eq_finsuppPivot
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (A : R → B →₀ F) (h : R → ℕ → F)
    (hx : DifferentialIndependent F x)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        (A r).sum fun b c ↦ algebraMap F K c * differentialJet n (x b)) :
    differentialRelationIdeal (C := F) (Sum.elim x y) =
      differentialFinsuppPivotRelationIdeal A h :=
  differentialRelationIdeal_sumElim_eq_jetPivot x y _ hx
    (fun r n => by
      classical
      rw [hrel r n]
      simp only [differentialFinsuppPivotAffineJet, map_add, MvPolynomial.aeval_C]
      congr 1
      simp only [Finsupp.sum]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro b hb
      simp)

end

end GaloisForLFunctions.HTGeometry
