import GaloisForLFunctions.HTGeometry.DifferentialPolynomial

/-!
# Complete relation ideals for arbitrary-cardinality differential pivot families

The finite matrix in the pivot relation theorem is not essential: every polynomial and every
linear coordinate row has finite support.  This module replaces a finite pivot matrix by a
finitely supported row `A r : B →₀ F` and proves the same exact elimination theorem without any
cardinality assumption on the pivot or dependent index types.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions MvPolynomial

noncomputable section

/-- The affine polynomial which replaces one dependent jet, with a finitely supported pivot row. -/
def differentialFinsuppPivotAffineJet
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial B F :=
  MvPolynomial.C (h r n) +
    (A r).sum fun b c ↦ MvPolynomial.C c * MvPolynomial.X (b, n)

/-- Eliminate every dependent jet by its finitely supported affine pivot expression. -/
def differentialFinsuppPivotElimination
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    DifferentialPolynomial (B ⊕ R) F →ₐ[F] DifferentialPolynomial B F :=
  MvPolynomial.bind₁ fun q ↦
    match q.1 with
    | Sum.inl b => MvPolynomial.X (b, q.2)
    | Sum.inr r => differentialFinsuppPivotAffineJet A h r q.2

/-- Include pivot differential polynomials into the left variables of the full jet ring. -/
def differentialFinsuppPivotInclusion
    {F B R : Type*} [Field F] :
    DifferentialPolynomial B F →ₐ[F] DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.rename fun q ↦ (Sum.inl q.1, q.2)

@[simp]
theorem differentialFinsuppPivotElimination_X_inl
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (b : B) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (MvPolynomial.X (Sum.inl b, n)) = MvPolynomial.X (b, n) := by
  simp [differentialFinsuppPivotElimination]

@[simp]
theorem differentialFinsuppPivotElimination_X_inr
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (MvPolynomial.X (Sum.inr r, n)) = differentialFinsuppPivotAffineJet A h r n := by
  simp [differentialFinsuppPivotElimination]

@[simp]
theorem differentialFinsuppPivotInclusion_X
    {F B R : Type*} [Field F] (b : B) (n : ℕ) :
    differentialFinsuppPivotInclusion (R := R)
        (MvPolynomial.X (b, n)) =
      (MvPolynomial.X (Sum.inl b, n) : DifferentialPolynomial (B ⊕ R) F) := by
  simp [differentialFinsuppPivotInclusion]

/-- Elimination is a left inverse to pivot inclusion. -/
@[simp]
theorem differentialFinsuppPivotElimination_inclusion
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F)
    (P : DifferentialPolynomial B F) :
    differentialFinsuppPivotElimination A h (differentialFinsuppPivotInclusion P) = P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [differentialFinsuppPivotElimination, differentialFinsuppPivotInclusion]
  | add P Q hP hQ => simp [hP, hQ]
  | mul_X P q hP =>
      rcases q with ⟨b, n⟩
      simp only [map_mul, hP, differentialFinsuppPivotInclusion_X,
        differentialFinsuppPivotElimination_X_inl]

/-- The displayed affine relation for one dependent jet. -/
def differentialFinsuppPivotRelation
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    DifferentialPolynomial (B ⊕ R) F :=
  MvPolynomial.X (Sum.inr r, n) -
    differentialFinsuppPivotInclusion (differentialFinsuppPivotAffineJet A h r n)

/-- The ideal generated by all finitely supported affine jet relations. -/
def differentialFinsuppPivotRelationIdeal
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    Ideal (DifferentialPolynomial (B ⊕ R) F) :=
  Ideal.span (Set.range fun rn : R × ℕ ↦
    differentialFinsuppPivotRelation A h rn.1 rn.2)

@[simp]
theorem differentialFinsuppPivotElimination_relation
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) (r : R) (n : ℕ) :
    differentialFinsuppPivotElimination A h
        (differentialFinsuppPivotRelation A h r n) = 0 := by
  simp [differentialFinsuppPivotRelation]

/-- Every polynomial differs from its eliminated pivot normal form by the generated relations. -/
theorem sub_finsuppPivotInclusion_elimination_mem_relationIdeal
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F)
    (P : DifferentialPolynomial (B ⊕ R) F) :
    P - differentialFinsuppPivotInclusion (differentialFinsuppPivotElimination A h P) ∈
      differentialFinsuppPivotRelationIdeal A h := by
  classical
  let I := differentialFinsuppPivotRelationIdeal A h
  induction P using MvPolynomial.induction_on with
  | C c =>
      change MvPolynomial.C c -
        differentialFinsuppPivotInclusion
          (differentialFinsuppPivotElimination A h (MvPolynomial.C c)) ∈ I
      simp [differentialFinsuppPivotElimination, differentialFinsuppPivotInclusion]
  | add P Q hP hQ =>
      change P + Q - differentialFinsuppPivotInclusion
          (differentialFinsuppPivotElimination A h (P + Q)) ∈ I
      have hadd := I.add_mem hP hQ
      convert hadd using 1 <;> simp <;> ring
  | mul_X P q hP =>
      rcases q with ⟨i, n⟩
      cases i with
      | inl b =>
          have hmul := Ideal.mul_mem_right
            (MvPolynomial.X (Sum.inl b, n)) I hP
          convert hmul using 1 <;> simp <;> ring
      | inr r =>
          have hgen : differentialFinsuppPivotRelation A h r n ∈ I :=
            Ideal.subset_span (Set.mem_range_self (r, n))
          have hmul₁ := Ideal.mul_mem_right
            (MvPolynomial.X (Sum.inr r, n)) I hP
          have hmul₂ := Ideal.mul_mem_left I
            (differentialFinsuppPivotInclusion
              (differentialFinsuppPivotElimination A h P)) hgen
          have hsum := I.add_mem hmul₁ hmul₂
          convert hsum using 1 <;>
            simp [differentialFinsuppPivotRelation] <;> ring

/-- The kernel of all-cardinality pivot elimination is exactly the generated linear ideal. -/
theorem differentialFinsuppPivotRelationIdeal_eq_ker
    {F B R : Type*} [Field F]
    (A : R → B →₀ F) (h : R → ℕ → F) :
    differentialFinsuppPivotRelationIdeal A h =
      RingHom.ker (differentialFinsuppPivotElimination A h).toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨r, n⟩, rfl⟩
    change differentialFinsuppPivotElimination A h
      (differentialFinsuppPivotRelation A h r n) = 0
    exact differentialFinsuppPivotElimination_relation A h r n
  · intro P hP
    have helim : differentialFinsuppPivotElimination A h P = 0 := RingHom.mem_ker.mp hP
    have hnormal :=
      sub_finsuppPivotInclusion_elimination_mem_relationIdeal A h P
    simpa [helim] using hnormal

/-- Evaluation of the full pivot/dependent family factors through finitely supported elimination. -/
theorem differentialPolynomialEval_sumElim_eq_finsuppPivotElimination
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (A : R → B →₀ F) (h : R → ℕ → F)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        (A r).sum fun b c ↦ algebraMap F K c * differentialJet n (x b))
    (P : DifferentialPolynomial (B ⊕ R) F) :
    differentialPolynomialEval (C := F) (Sum.elim x y) P =
      MvPolynomial.aeval (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))
        (differentialFinsuppPivotElimination A h P) := by
  let left := differentialPolynomialEval (C := F) (Sum.elim x y)
  let right := (MvPolynomial.aeval
    (fun bn : B × ℕ ↦ differentialJet bn.2 (x bn.1))).comp
      (differentialFinsuppPivotElimination A h)
  have heq : left = right := by
    apply MvPolynomial.algHom_ext
    rintro ⟨i, n⟩
    cases i with
    | inl b => simp [left, right, differentialPolynomialEval]
    | inr r =>
        simp only [left, right, differentialPolynomialEval_X, Sum.elim_inr,
          AlgHom.coe_comp, Function.comp_apply,
          differentialFinsuppPivotElimination_X_inr]
        classical
        rw [hrel r n]
        simp only [differentialFinsuppPivotAffineJet, map_add,
          MvPolynomial.aeval_C]
        congr 1
        simp only [Finsupp.sum]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro b hb
        simp
  exact AlgHom.congr_fun heq P

/-- **All-cardinality complete differential relation theorem.**  If the pivot family is
differentially independent and every dependent jet has a finitely supported affine pivot
expression, then the displayed affine jet relations generate every relation of the combined
family. -/
theorem differentialRelationIdeal_sumElim_eq_finsuppPivot
    {F K B R : Type*} [Field F] [Field K] [Algebra F K] [Differential K]
    (x : B → K) (y : R → K) (A : R → B →₀ F) (h : R → ℕ → F)
    (hx : DifferentialIndependent F x)
    (hrel : ∀ r n, differentialJet n (y r) =
      algebraMap F K (h r n) +
        (A r).sum fun b c ↦ algebraMap F K c * differentialJet n (x b)) :
    differentialRelationIdeal (C := F) (Sum.elim x y) =
      differentialFinsuppPivotRelationIdeal A h := by
  rw [differentialFinsuppPivotRelationIdeal_eq_ker]
  ext P
  rw [mem_differentialRelationIdeal_iff, RingHom.mem_ker]
  rw [differentialPolynomialEval_sumElim_eq_finsuppPivotElimination x y A h hrel P]
  constructor
  · intro hzero
    unfold DifferentialIndependent at hx
    exact hx.eq_zero_of_aeval_eq_zero _ hzero
  · intro hzero
    change differentialFinsuppPivotElimination A h P = 0 at hzero
    rw [hzero]
    exact map_zero _

end

end GaloisForLFunctions.HTGeometry
