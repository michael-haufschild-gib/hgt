import GaloisForLFunctions.HTGeometry.PrimeLogHerglotz
import Mathlib.Order.Filter.AtTopBot.Basic
import Mathlib.Topology.Germ
import Mathlib.Analysis.Complex.Convex

/-!
# The complex upper end and its translation action

The upper-end filter is generated by all horizontal upper half-planes.  It forgets the choice of
height while retaining eventual analytic information.  Every complex translation preserves this
filter, even though no fixed upper half-plane is preserved by all translations.

This is the topological carrier underlying the proposed upper-end meromorphic differential field.
-/

namespace GaloisForLFunctions.HTGeometry

open Filter Set

/-- The horizontal upper half-plane above height `H`. -/
def upperTail (H : ℝ) : Set ℂ := {z | H < z.im}

/-- The filter of sets containing some sufficiently high upper half-plane. -/
def upperEndFilter : Filter ℂ := Filter.comap Complex.im Filter.atTop

/-- Upper half-planes form a basis of the upper-end filter. -/
theorem upperEndFilter_basis :
    upperEndFilter.HasBasis (fun _ : ℝ ↦ True) upperTail := by
  have htails : (fun H : ℝ => Complex.im ⁻¹' Ioi H) = upperTail := by
    funext H
    ext z
    rfl
  rw [← htails]
  exact Filter.atTop_basis_Ioi.comap Complex.im

theorem upperTail_isOpen (H : ℝ) : IsOpen (upperTail H) := by
  exact isOpen_lt continuous_const Complex.continuous_im

theorem upperTail_isPreconnected (H : ℝ) : IsPreconnected (upperTail H) := by
  exact (convex_halfSpace_im_gt H).isPreconnected

theorem upperTail_nonempty (H : ℝ) : (upperTail H).Nonempty := by
  refine ⟨(H + 1 : ℂ) * Complex.I, ?_⟩
  simp [upperTail]

/-- Exact height displacement under a complex translation. -/
theorem add_preimage_upperTail (h : ℂ) (H : ℝ) :
    (fun z : ℂ ↦ z + h) ⁻¹' upperTail H = upperTail (H - h.im) := by
  ext z
  simp only [upperTail, Set.mem_setOf_eq, Set.mem_preimage, Complex.add_im]
  constructor <;> intro hz <;> linarith

/-- Every complex translation preserves the upper end. -/
theorem tendsto_add_upperEndFilter (h : ℂ) :
    Tendsto (fun z : ℂ ↦ z + h) upperEndFilter upperEndFilter := by
  rw [upperEndFilter_basis.tendsto_iff upperEndFilter_basis]
  intro H hH
  refine ⟨H - h.im, trivial, ?_⟩
  intro z hz
  simp only [upperTail, Set.mem_setOf_eq, Complex.add_im] at hz ⊢
  linarith

theorem tendsto_sub_upperEndFilter (h : ℂ) :
    Tendsto (fun z : ℂ ↦ z - h) upperEndFilter upperEndFilter := by
  simpa [sub_eq_add_neg] using tendsto_add_upperEndFilter (-h)

instance upperEndFilter_neBot : NeBot upperEndFilter := by
  rw [upperEndFilter_basis.neBot_iff]
  intro H hH
  exact upperTail_nonempty H

/-- Precomposition gives a ring endomorphism of unrestricted upper-end germs. -/
noncomputable def upperEndTranslateGerm (h : ℂ) :
    Filter.Germ upperEndFilter ℂ →+* Filter.Germ upperEndFilter ℂ where
  toFun f := f.compTendsto (fun z ↦ z + h) (tendsto_add_upperEndFilter h)
  map_zero' := by rfl
  map_one' := by rfl
  map_add' f g := by
    induction f using Quotient.inductionOn with
    | _ f =>
      induction g using Quotient.inductionOn with
      | _ g => rfl
  map_mul' f g := by
    induction f using Quotient.inductionOn with
    | _ f =>
      induction g using Quotient.inductionOn with
      | _ g => rfl

@[simp]
theorem upperEndTranslateGerm_coe (h : ℂ) (f : ℂ → ℂ) :
    upperEndTranslateGerm h (f : Filter.Germ upperEndFilter ℂ) =
      ((fun z ↦ f (z + h)) : Filter.Germ upperEndFilter ℂ) := by
  rfl

/-- Every complex translation acts invertibly on upper-end germs. -/
noncomputable def upperEndTranslationRingEquiv (h : ℂ) :
    Filter.Germ upperEndFilter ℂ ≃+* Filter.Germ upperEndFilter ℂ where
  toFun := upperEndTranslateGerm h
  invFun := upperEndTranslateGerm (-h)
  left_inv f := by
    induction f using Quotient.inductionOn with
    | _ f =>
      apply Filter.Germ.coe_eq.mpr
      exact Filter.Eventually.of_forall fun z ↦ by simp
  right_inv f := by
    induction f using Quotient.inductionOn with
    | _ f =>
      apply Filter.Germ.coe_eq.mpr
      exact Filter.Eventually.of_forall fun z ↦ by simp
  map_mul' := (upperEndTranslateGerm h).map_mul
  map_add' := (upperEndTranslateGerm h).map_add

@[simp]
theorem upperEndTranslationRingEquiv_apply (h : ℂ)
    (f : Filter.Germ upperEndFilter ℂ) :
    upperEndTranslationRingEquiv h f = upperEndTranslateGerm h f :=
  rfl

/-- The translation action is additive. -/
theorem upperEndTranslateGerm_add (h k : ℂ)
    (f : Filter.Germ upperEndFilter ℂ) :
    upperEndTranslateGerm h (upperEndTranslateGerm k f) =
      upperEndTranslateGerm (h + k) f := by
  induction f using Quotient.inductionOn with
  | _ f =>
    apply Filter.Germ.coe_eq.mpr
    exact Filter.Eventually.of_forall fun z ↦ by simp [add_assoc]

@[simp]
theorem upperEndTranslateGerm_zero (f : Filter.Germ upperEndFilter ℂ) :
    upperEndTranslateGerm 0 f = f := by
  induction f using Quotient.inductionOn with
  | _ f =>
    apply Filter.Germ.coe_eq.mpr
    exact Filter.Eventually.of_forall fun z ↦ by simp

end GaloisForLFunctions.HTGeometry
