import GaloisForLFunctions.HTGeometry.OrbitBalance
import GaloisForLFunctions.HTGeometry.OrbitBalanceAugmentation

/-!
# The seam firewall: the finite-place block cannot reach the archimedean class

The two place-blocks are separated by a genuine difference-Galois invariant — the σ-coboundary (CC)
class of the place multiplier, measured by the orbit degree of its divisor.

* Every Euler-factor multiplier is a **shift coboundary**, so the whole finite-place block lies in the
  kernel of the orbit degree: the prime block is all-CC.
* The archimedean `Γ`-multiplier carries a single point mass on its orbit, so its orbit degree is `1`:
  it is the unique **non-CC** place.

Consequently the archimedean class is not in the subgroup generated by the finite-place classes, and
no `ℤ`-combination of finite-place data — however large — reaches it.  That is the generator-level
firewall, and it is unconditional: it uses only the coboundary/degree bookkeeping, never the open
class `ω`.

**Door-5 calibration.**  Over a function field there is no archimedean place: every place multiplier
is CC, so every place class has orbit degree zero and the block distinction collapses.  The firewall
is exactly what `ℚ` adds.

## Main results

* `orbitDegreeHom` — the orbit degree as an additive character of divisors;
* `primeBlock_le_ker` — the finite-place block is all-CC;
* `archimedeanDivisor_notMem_primeBlock` — the firewall: the archimedean class is unreachable;
* `firewall_vacuous_of_all_coboundary` — the function-field calibration.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open scoped BigOperators

/-- The orbit degree as an additive character on finite divisors. -/
def orbitDegreeHom {α : Type*} : (α →₀ ℤ) →+ ℤ where
  toFun := orbitDegree
  map_zero' := orbitDegree_zero
  map_add' := orbitDegree_add

@[simp]
theorem orbitDegreeHom_apply {α : Type*} (D : α →₀ ℤ) : orbitDegreeHom D = orbitDegree D := rfl

/-! ### The two blocks -/

/-- The finite-place block: the subgroup generated by the divisors of the Euler-factor multipliers,
each of which is a shift coboundary (the CC class is trivial). -/
def primeBlock : AddSubgroup (ℤ →₀ ℤ) :=
  AddSubgroup.closure (Set.range intShiftCoboundary)

/-- The archimedean class: the `Γ`-multiplier carries a single point mass on its orbit. -/
def archimedeanDivisor : ℤ →₀ ℤ := Finsupp.single 0 1

@[simp]
theorem orbitDegree_archimedeanDivisor : orbitDegree archimedeanDivisor = 1 := by
  rw [archimedeanDivisor, orbitDegree_single]

/-! ### The firewall -/

/-- **The prime block is all-CC.**  Every finite-place class has orbit degree zero. -/
theorem primeBlock_le_ker : primeBlock ≤ (orbitDegreeHom : (ℤ →₀ ℤ) →+ ℤ).ker := by
  refine AddSubgroup.closure_le _ |>.mpr ?_
  rintro D ⟨E, rfl⟩
  simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, orbitDegreeHom_apply]
  exact orbitDegree_intShiftCoboundary E

/-- Every element of the finite-place block has vanishing orbit degree. -/
theorem orbitDegree_eq_zero_of_mem_primeBlock {D : ℤ →₀ ℤ} (hD : D ∈ primeBlock) :
    orbitDegree D = 0 :=
  primeBlock_le_ker hD

/-- **The seam firewall.**  The archimedean class is not in the subgroup generated by the
finite-place classes: no `ℤ`-combination of finite-place generator data reaches it. -/
theorem archimedeanDivisor_notMem_primeBlock : archimedeanDivisor ∉ primeBlock := by
  intro hmem
  have h := orbitDegree_eq_zero_of_mem_primeBlock hmem
  rw [orbitDegree_archimedeanDivisor] at h
  exact one_ne_zero h

/-- **No finite-place class equals the archimedean class.**  The sharpened pointwise form. -/
theorem ne_archimedeanDivisor_of_mem_primeBlock {D : ℤ →₀ ℤ} (hD : D ∈ primeBlock) :
    D ≠ archimedeanDivisor := by
  intro h
  exact archimedeanDivisor_notMem_primeBlock (h ▸ hD)

/-- **The blocks are separated by an invariant, not by fiat.**  The orbit degree is an additive
character that is identically zero on the finite-place block and nonzero on the archimedean class. -/
theorem firewall_invariant :
    (∀ D ∈ primeBlock, orbitDegreeHom D = 0) ∧ orbitDegreeHom archimedeanDivisor ≠ 0 := by
  refine ⟨fun D hD => orbitDegree_eq_zero_of_mem_primeBlock hD, ?_⟩
  rw [orbitDegreeHom_apply, orbitDegree_archimedeanDivisor]
  exact one_ne_zero

/-! ### Door-5: the function-field calibration -/

/-- **The firewall is vacuous when every place is CC.**  If every place divisor of a family is a
shift coboundary — the function-field situation, where there is no archimedean place — then every
place class has orbit degree zero and no block distinction remains. -/
theorem firewall_vacuous_of_all_coboundary {ι : Type*} (d : ι → (ℤ →₀ ℤ))
    (hcc : ∀ i, ∃ E : ℤ →₀ ℤ, d i = intShiftCoboundary E) :
    ∀ i, orbitDegree (d i) = 0 := by
  intro i
  obtain ⟨E, hE⟩ := hcc i
  rw [hE]
  exact orbitDegree_intShiftCoboundary E

/-- In that situation every place class lies in the finite-place block: there is nothing left for the
block to be independent of. -/
theorem mem_primeBlock_of_coboundary {D : ℤ →₀ ℤ} (h : ∃ E : ℤ →₀ ℤ, D = intShiftCoboundary E) :
    D ∈ primeBlock := by
  obtain ⟨E, hE⟩ := h
  rw [hE, primeBlock]
  exact AddSubgroup.subset_closure ⟨E, rfl⟩

end GaloisForLFunctions.HTGeometry
