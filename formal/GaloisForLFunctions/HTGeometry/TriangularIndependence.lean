import GaloisForLFunctions.HTGeometry.TriangularTailCoefficients
import Mathlib.RingTheory.Algebraic.MvPolynomial
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# A linear element in a fresh variable is transcendental

If a variable does not occur in a set of variables, then any polynomial that is affine-linear in that
variable, with nonzero leading coefficient supported on the set, is transcendental over the
polynomials supported on the set.

This is the step that adjoins one coefficient to an algebraically independent family in a triangular
system.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u v

variable {K : Type u} [CommRing K] [IsDomain K] {σ : Type v}

/-- **A polynomial that is affine-linear in a fresh variable is transcendental over the polynomials
in the other variables.** -/
theorem transcendental_supported_linear {j : σ} {s : Set σ} (hj : j ∉ s)
    (A H : MvPolynomial.supported K s) (hA : A ≠ 0) :
    Transcendental (MvPolynomial.supported K s)
      ((A : MvPolynomial σ K) * MvPolynomial.X j + (H : MvPolynomial σ K)) := by
  have hlin : (Polynomial.C A * Polynomial.X + Polynomial.C H).natDegree = 1 :=
    Polynomial.natDegree_linear hA
  have hlead : (Polynomial.C A * Polynomial.X + Polynomial.C H).leadingCoeff
      ∈ nonZeroDivisors (↥(MvPolynomial.supported K s)) := by
    rw [Polynomial.leadingCoeff_linear hA]
    exact mem_nonZeroDivisors_of_ne_zero hA
  have ht := (MvPolynomial.transcendental_supported_X (R := K) (s := s) hj).aeval
    (Polynomial.C A * Polynomial.X + Polynomial.C H) (by rw [hlin]; exact one_ne_zero) hlead
  convert ht using 1
  rw [map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, Polynomial.aeval_C]
  rfl

omit [IsDomain K] in
/-- The subalgebra generated by the first `k` parameters is the one mathlib calls `supported`. -/
theorem tailAdjoin_eq_supported (k : ℕ) :
    tailAdjoin K k = MvPolynomial.supported K {i : ℕ | i < k} := rfl

/-- **Each coefficient of the parameter change is transcendental over the earlier ones.**  It is
affine-linear in its own parameter with leading coefficient `(n-j) p₁^{n-j-1}`, which is nonzero as
soon as `n - j` is invertible — in particular in characteristic zero. -/
theorem transcendental_paramCoeff {n j : ℕ} (hj : 0 < j) (hjn : j < n)
    (hchar : ((n - j : ℕ) : K) ≠ 0) :
    Transcendental (MvPolynomial.supported K {i : ℕ | i < j}) (paramCoeff K n j) := by
  obtain ⟨H, hH, hHeq⟩ := paramCoeff_decomp (K := K) hj hjn
  have hAmem : ((n - j : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (n - j - 1))
      ∈ MvPolynomial.supported K {i : ℕ | i < j} := by
    rw [← tailAdjoin_eq_supported]
    exact Subalgebra.nsmul_mem _ (Subalgebra.pow_mem _ (X_mem_tailAdjoin hj) _) _
  have hAne : (⟨_, hAmem⟩ : MvPolynomial.supported K {i : ℕ | i < j}) ≠ 0 := by
    intro hcon
    have : ((n - j : ℕ) • (MvPolynomial.X (0 : ℕ) : MvPolynomial ℕ K) ^ (n - j - 1)) = 0 :=
      congrArg Subtype.val hcon
    rw [nsmul_eq_mul] at this
    rcases mul_eq_zero.1 this with h | h
    · exact hchar (MvPolynomial.C_eq_zero.1 ((map_natCast MvPolynomial.C (n - j)).trans h))
    · exact pow_ne_zero _ (MvPolynomial.X_ne_zero (0 : ℕ)) h
  have ht := transcendental_supported_linear (K := K) (j := j) (s := {i : ℕ | i < j})
    (by simp) ⟨_, hAmem⟩ ⟨H, by rwa [← tailAdjoin_eq_supported]⟩ hAne
  convert ht using 1
  rw [hHeq, smul_mul_assoc]

/-- **The first coefficient is transcendental over the constants.** -/
theorem transcendental_paramCoeff_zero {n : ℕ} (hn : 0 < n) :
    Transcendental (MvPolynomial.supported K {i : ℕ | i < 0}) (paramCoeff K n 0) := by
  have hempty : ({i : ℕ | i < 0} : Set ℕ) = ∅ := by ext i; simp
  rw [hempty]
  have hpoly : Transcendental K ((Polynomial.X : Polynomial K) ^ n) :=
    Polynomial.transcendental _ (by rw [Polynomial.natDegree_X_pow (R := K)]; omega)
      (by rw [Polynomial.leadingCoeff_X_pow (R := K)]; exact one_mem _)
  have ht := MvPolynomial.transcendental_supported_polynomial_aeval_X (σ := ℕ) K
    (Set.notMem_empty (0 : ℕ)) hpoly
  rw [paramCoeff_zero hn]
  convert ht using 1
  rw [map_pow, Polynomial.aeval_X]

/-- **The coefficients of the parameter change are algebraically independent.**  Triangularity plus
the nonvanishing of the diagonal gives, at each step, an element transcendental over the subalgebra
generated by the earlier ones. -/
theorem algebraicIndependent_paramCoeff {F : Type u} [Field F] {n : ℕ} (hn : 0 < n)
    (hchar : ∀ j, 0 < j → j < n → ((n - j : ℕ) : F) ≠ 0) :
    ∀ m, m ≤ n → AlgebraicIndependent F (fun j : Fin m => paramCoeff F n (j : ℕ)) := by
  intro m
  induction m with
  | zero =>
      intro _
      apply algebraicIndependent_empty_type
  | succ m ih =>
      intro hmn
      have hprev := ih (by omega)
      have hle : Algebra.adjoin F (Set.range (fun j : Fin m => paramCoeff F n (j : ℕ)))
          ≤ MvPolynomial.supported F {i : ℕ | i < m} := by
        refine Algebra.adjoin_le ?_
        rintro _ ⟨j, rfl⟩
        rw [← tailAdjoin_eq_supported]
        exact tailAdjoin_mono (by omega) (coeff_triangularTailPoly_pow_mem n (n - (j : ℕ)) (j : ℕ))
      have htr : Transcendental
          (Algebra.adjoin F (Set.range (fun j : Fin m => paramCoeff F n (j : ℕ))))
          (paramCoeff F n m) := by
        refine Transcendental.of_tower_top_of_subalgebra_le hle ?_
        rcases Nat.eq_zero_or_pos m with rfl | hm
        · exact transcendental_paramCoeff_zero hn
        · exact transcendental_paramCoeff hm (by omega) (hchar m hm (by omega))
      have hopt := (hprev.option_iff_transcendental (paramCoeff F n m)).2 htr
      have hcomp := hopt.comp (finSuccEquivLast : Fin (m + 1) ≃ Option (Fin m))
        (Equiv.injective _)
      convert hcomp using 1
      funext j
      induction j using Fin.lastCases with
      | last => simp
      | cast i => simp

end GaloisForLFunctions.HTGeometry
