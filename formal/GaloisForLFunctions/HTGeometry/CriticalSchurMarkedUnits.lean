import GaloisForLFunctions.HTGeometry.CriticalSchurTailIntegrality
import GaloisForLFunctions.HTGeometry.CriticalReciprocalSourceCoordinates
import GaloisForLFunctions.HTGeometry.TruncatedReciprocalRecurrence
import Mathlib.Algebra.MvPolynomial.NoZeroDivisors
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Units of the marked critical tails at the Schur divisor

For two positive blocks of size at least two, the marked raw and reciprocal tail coefficients occur
strictly below the final reciprocal-square coordinate.  The triangular square-root and reciprocal
recurrences therefore put them in the rational subfield generated by every Schur coordinate except
the variable in which the Schur determinant is linear.  Rational functions in those transverse
coordinates are units at the generic Schur divisor.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open IsDiscreteValuationRing
open IsDedekindDomain.HeightOneSpectrum
open MvPolynomial
open Polynomial

set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 1000000

/-! ## Prefix-closed triangular inversion -/

/-- Below any fixed cutoff, membership of the coefficients of a unit-series square in an
intermediate field implies membership of the coefficients of the unit series itself. -/
theorem finiteUnitSquarePositive_mem_intermediateField_of_lt
    {F E : Type*} [Field F] [Field E] [Algebra F E] [CharZero E]
    (J : IntermediateField F E) {L b : ℕ} (z : Fin L → E)
    (hsq : ∀ i : Fin L, (i : ℕ) < b → finiteUnitSquarePositive z i ∈ J) :
    ∀ i : Fin L, (i : ℕ) < b → z i ∈ J := by
  intro i hi
  have hzmem : ∀ k (hkL : k < L), k < b → z ⟨k, hkL⟩ ∈ J := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        intro hkL hkb
        rcases k with _ | k
        · have hrel := finiteUnitSquarePositive_zero z hkL
          have htwo : (2 : E) ≠ 0 := by norm_num
          have hsolve : z ⟨0, hkL⟩ = (2 : E)⁻¹ *
              finiteUnitSquarePositive z ⟨0, hkL⟩ := by
            rw [hrel]
            field_simp
          rw [hsolve]
          exact J.mul_mem (J.inv_mem (J.natCast_mem 2))
            (hsq ⟨0, hkL⟩ hkb)
        · let S : E := ∑ p ∈
              (Finset.HasAntidiagonal.antidiagonal (A := ℕ) k : Finset (ℕ × ℕ)),
              (finiteUnitPolynomial z).coeff (p.1 + 1) *
                (finiteUnitPolynomial z).coeff (p.2 + 1)
          have hS : S ∈ J := by
            apply J.sum_mem
            intro p hp
            apply J.mul_mem
            · rw [show (finiteUnitPolynomial z).coeff (p.1 + 1) =
                  z ⟨p.1, by
                    have hp1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                    omega⟩ by
                simpa using finiteUnitPolynomial_coeff_succ z
                  ⟨p.1, by
                    have hp1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                    omega⟩]
              exact ih p.1 (by
                have hp1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega) (by
                have hp1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega) (by
                have hp1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega)
            · rw [show (finiteUnitPolynomial z).coeff (p.2 + 1) =
                  z ⟨p.2, by
                    have hp2 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                    omega⟩ by
                simpa using finiteUnitPolynomial_coeff_succ z
                  ⟨p.2, by
                    have hp2 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                    omega⟩]
              exact ih p.2 (by
                have hp2 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega) (by
                have hp2 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega) (by
                have hp2 := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
                omega)
          have hrel := finiteUnitSquarePositive_succ z hkL
          have htwo : (2 : E) ≠ 0 := by norm_num
          have hsolve : z ⟨k + 1, hkL⟩ = (2 : E)⁻¹ *
              (finiteUnitSquarePositive z ⟨k + 1, hkL⟩ - S) := by
            rw [hrel]
            dsimp only [S]
            field_simp
            ring
          rw [hsolve]
          exact J.mul_mem (J.inv_mem (J.natCast_mem 2))
            (J.sub_mem (hsq ⟨k + 1, hkL⟩ hkb) hS)
  exact hzmem i i.isLt hi

/-- Truncated reciprocal inversion is prefix-closed: if the reciprocal coefficients strictly below
a cutoff belong to an intermediate field, then the original coefficients below that cutoff do too. -/
theorem finiteReciprocalPositive_reflects_mem_intermediateField_of_lt
    {F E : Type*} [Field F] [Field E] [Algebra F E] [CharZero E]
    (J : IntermediateField F E) {L b : ℕ} (u : Fin L → E)
    (hv : ∀ i : Fin L, (i : ℕ) < b → finiteReciprocalPositive u i ∈ J) :
    ∀ i : Fin L, (i : ℕ) < b → u i ∈ J := by
  let U := finiteUnitPolynomial u
  let V := finiteUnitPolynomial (finiteReciprocalPositive u)
  let Y := truncatedReciprocalKernel (L + 1) U
  have hU0 : U.coeff 0 = 1 := finiteUnitPolynomial_coeff_zero u
  have hUY : Polynomial.X ^ (L + 1) ∣ U * Y - 1 :=
    truncatedReciprocalKernel_isInverseMod (L + 1) U hU0
  have hUV : Polynomial.X ^ (L + 1) ∣ U * V - 1 :=
    X_pow_dvd_mul_sub_of_coeff_eq (L + 1) U V Y hUY
      (finiteUnitPolynomial_reciprocal_coeff u)
  have hVU : Polynomial.X ^ (L + 1) ∣ V * U - 1 := by
    simpa [mul_comm] using hUV
  intro i hi
  have humem : ∀ k (hkL : k < L), k < b → u ⟨k, hkL⟩ ∈ J := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        intro hkL hkb
        have hrec := coeff_zero_mul_coeff_of_dvd hVU
          (k := k + 1) (by omega : k + 1 ≤ L) (by omega)
        have hV0 : V.coeff 0 = 1 :=
          finiteUnitPolynomial_coeff_zero (finiteReciprocalPositive u)
        have hsum : -∑ a ∈ Finset.range (k + 1),
            V.coeff (a + 1) * U.coeff (k + 1 - (a + 1)) ∈ J := by
          apply J.neg_mem
          apply J.sum_mem
          intro a ha
          have hak : a ≤ k := by
            have := Finset.mem_range.mp ha
            omega
          apply J.mul_mem
          · have haL : a < L := by omega
            rw [show V.coeff (a + 1) =
                finiteReciprocalPositive u ⟨a, haL⟩ by
              simpa [V] using finiteUnitPolynomial_coeff_succ
                (finiteReciprocalPositive u) ⟨a, haL⟩]
            exact hv ⟨a, haL⟩ (lt_of_le_of_lt hak hkb)
          · by_cases hak0 : k - a = 0
            · have hindex : k + 1 - (a + 1) = 0 := by omega
              rw [hindex, hU0]
              exact J.one_mem
            · obtain ⟨q, hq⟩ : ∃ q, k - a = q + 1 := by
                exact ⟨k - a - 1, by omega⟩
              have hqL : q < L := by omega
              have hqk : q < k := by omega
              have hindex : k + 1 - (a + 1) = q + 1 := by omega
              rw [hindex, show U.coeff (q + 1) = u ⟨q, hqL⟩ by
                simpa [U] using finiteUnitPolynomial_coeff_succ u ⟨q, hqL⟩]
              exact ih q hqk hqL (by omega)
        have hUk : U.coeff (k + 1) = u ⟨k, hkL⟩ := by
          simpa [U] using finiteUnitPolynomial_coeff_succ u ⟨k, hkL⟩
        rw [hV0, one_mul, hUk] at hrec
        rw [hrec]
        exact hsum
  exact humem i i.isLt hi

/-! ## The transverse Schur subfield -/

/-- Index of the reciprocal-square coordinate in which the positive rectangular Schur determinant
has degree one. -/
def criticalSchurRamificationCoordinateIndex
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) : Fin (m + n - 1 + 1) :=
  ⟨1, by omega⟩

/-- Schur-coordinate indices transverse to the degree-one ramification coordinate. -/
abbrev criticalSchurTransverseIndex {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :=
  {i : Fin (m + n - 1 + 1) // i ≠ criticalSchurRamificationCoordinateIndex hm hn}

/-- Rational subfield generated by all actual Schur coordinates except the coordinate in which the
ramification polynomial is linear. -/
noncomputable def criticalSchurTransverseField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    IntermediateField K (criticalSourceField K m n) :=
  IntermediateField.adjoin K (Set.range (fun i : criticalSchurTransverseIndex hm hn =>
    criticalSourceSchurCoordinates K hm hn i.1))

theorem criticalSourceSchurCoordinate_mem_transverseField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1 + 1))
    (hi : i ≠ criticalSchurRamificationCoordinateIndex hm hn) :
    criticalSourceSchurCoordinates K hm hn i ∈
      criticalSchurTransverseField K hm hn := by
  exact IntermediateField.subset_adjoin K _
    ⟨⟨i, hi⟩, rfl⟩

/-- Every reciprocal-square coordinate below the final one belongs to the transverse field. -/
theorem criticalSourceReciprocalSquarePositive_mem_transverseField_of_lt
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1)) (hi : (i : ℕ) < m + n - 2) :
    criticalSourceReciprocalSquarePositive K hm hn i ∈
      criticalSchurTransverseField K hm hn := by
  let j : Fin (m + n - 1 + 1) := i.rev.succ
  have hj : j ≠ criticalSchurRamificationCoordinateIndex hm hn := by
    intro h
    have hv := congrArg Fin.val h
    dsimp [j, criticalSchurRamificationCoordinateIndex] at hv
    omega
  have hmem := criticalSourceSchurCoordinate_mem_transverseField K hm hn j hj
  simpa [j, criticalSourceSchurCoordinates,
    criticalSourceReciprocalSquareReversed] using hmem

/-- Every normalized reciprocal coefficient below the final reciprocal-square coordinate belongs
to the transverse field. -/
theorem criticalSourceNormalizedReciprocalPositive_mem_transverseField_of_lt
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1)) (hi : (i : ℕ) < m + n - 2) :
    finiteReciprocalPositive (criticalSourceNormalizedPositive K hm hn) i ∈
      criticalSchurTransverseField K hm hn := by
  let J := criticalSchurTransverseField K hm hn
  let v := finiteReciprocalPositive (criticalSourceNormalizedPositive K hm hn)
  have hv := finiteUnitSquarePositive_mem_intermediateField_of_lt J v
    (b := m + n - 2) (fun j hj => by
      change criticalSourceReciprocalSquarePositive K hm hn j ∈ J
      exact criticalSourceReciprocalSquarePositive_mem_transverseField_of_lt
        K hm hn j hj)
  exact hv i hi

/-- Every normalized raw coefficient below the final reciprocal-square coordinate belongs to the
transverse field. -/
theorem criticalSourceNormalizedPositive_mem_transverseField_of_lt
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (i : Fin (m + n - 1)) (hi : (i : ℕ) < m + n - 2) :
    criticalSourceNormalizedPositive K hm hn i ∈
      criticalSchurTransverseField K hm hn := by
  apply finiteReciprocalPositive_reflects_mem_intermediateField_of_lt
    (criticalSchurTransverseField K hm hn)
    (criticalSourceNormalizedPositive K hm hn)
    (b := m + n - 2)
    (fun j hj => criticalSourceNormalizedReciprocalPositive_mem_transverseField_of_lt
      K hm hn j hj) i hi

/-! ## Transverse rational functions are Schur units -/

/-- Renaming a polynomial through a family avoiding one target variable produces a polynomial of
degree zero in that variable. -/
theorem degreeOf_rename_eq_zero_of_avoids
    {K ι τ : Type*} [Field K] (f : ι → τ) (j : τ)
    (hf : ∀ i, f i ≠ j) (p : MvPolynomial ι K) :
    MvPolynomial.degreeOf j (MvPolynomial.rename f p) = 0 := by
  by_contra hdegree
  have hmem : j ∈ (MvPolynomial.rename f p).vars :=
    MvPolynomial.mem_vars_iff_degreeOf_ne_zero.mpr hdegree
  obtain ⟨i, hi, hij⟩ := MvPolynomial.mem_vars_rename f p hmem
  exact hf i hij

/-- Divisibility cannot lower degree in any chosen variable over a field. -/
theorem degreeOf_le_of_dvd_at
    {K σ : Type*} [Field K] (j : σ)
    {p q : MvPolynomial σ K} (hpq : p ∣ q) (hq : q ≠ 0) :
    MvPolynomial.degreeOf j p ≤ MvPolynomial.degreeOf j q := by
  obtain ⟨r, rfl⟩ := hpq
  have hp : p ≠ 0 := by
    intro hp
    exact hq (by rw [hp, zero_mul])
  have hr : r ≠ 0 := by
    intro hr
    exact hq (by rw [hr, mul_zero])
  rw [degreeOf_mul_eq hp hr]
  exact Nat.le_add_right _ _

/-- In the two-sided range, the actual Schur ramification polynomial has degree one in its marked
ramification coordinate. -/
theorem degreeOf_ramificationCoordinate_criticalSourceSchurRamificationPolynomial
    (K : Type*) [Field K] {m n : ℕ}
    (hm : 1 < m) (hn : 1 < n) :
    MvPolynomial.degreeOf
        (criticalSchurRamificationCoordinateIndex (by omega : 0 < m) (by omega : 0 < n))
        (criticalSourceSchurRamificationPolynomial K m n) = 1 := by
  rcases m with _ | m
  · omega
  rcases n with _ | n
  · omega
  let hm0 : 0 < m + 1 := by omega
  let hn0 : 0 < n + 1 := by omega
  let i := criticalSchurRamificationCoordinateIndex hm0 hn0
  have hi : i = Fin.succ (⟨0, by omega⟩ : Fin ((m + 1) + (n + 1) - 1)) := by
    apply Fin.ext
    rfl
  rw [show criticalSchurRamificationCoordinateIndex
      (by omega : 0 < m + 1) (by omega : 0 < n + 1) = i by rfl,
    criticalSourceSchurRamificationPolynomial, hi,
    MvPolynomial.degreeOf_rename_of_injective (Fin.succ_injective _)]
  classical
  have hdegree := degreeOf_zero_det_rectangularSchur (K := K)
    (n' := n) (m' := m) (by omega) (by omega)
  have hL : n + m - 1 + 2 = (m + 1) + (n + 1) - 1 := by omega
  rw [← rename_finCongr_det_rectangularSchurToeplitz (K := K) hL (n + 1) (m + 1)]
  have hzero : (⟨0, by omega⟩ : Fin ((m + 1) + (n + 1) - 1)) =
      finCongr hL (⟨0, by omega⟩ : Fin (n + m - 1 + 2)) := by
    apply Fin.ext
    rfl
  rw [hzero, MvPolynomial.degreeOf_rename_of_injective (finCongr hL).injective]
  exact hdegree

/-- A nonzero coordinate polynomial free of the ramification coordinate does not belong to the
generic Schur prime. -/
theorem not_mem_criticalSchurRamificationIdeal_of_degreeOf_ramificationCoordinate_eq_zero
    (K : Type*) [Field K] {m n : ℕ}
    (hm : 1 < m) (hn : 1 < n)
    {q : criticalSchurSourceRing K m n} (hq : q ≠ 0)
    (hdegree : MvPolynomial.degreeOf
      (criticalSchurRamificationCoordinateIndex (by omega : 0 < m) (by omega : 0 < n)) q = 0) :
    q ∉ criticalSchurRamificationIdeal K m n := by
  rw [criticalSchurRamificationIdeal, Ideal.mem_span_singleton]
  intro hdvd
  have hle := degreeOf_le_of_dvd_at
    (criticalSchurRamificationCoordinateIndex (by omega : 0 < m) (by omega : 0 < n))
    hdvd hq
  rw [degreeOf_ramificationCoordinate_criticalSourceSchurRamificationPolynomial K hm hn,
    hdegree] at hle
  omega

/-- The inverse of a coordinate polynomial outside the Schur prime is integral at the Schur
valuation. -/
theorem criticalSchurCoordinateValuationSubring_algebraMap_inv_mem_of_not_mem
    (K : Type*) [Field K] {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (q : criticalSchurSourceRing K m n)
    (hq : q ∉ criticalSchurRamificationIdeal K m n) :
    (algebraMap (criticalSchurSourceRing K m n)
      (FractionRing (criticalSchurSourceRing K m n)) q)⁻¹ ∈
        criticalSchurCoordinateValuationSubring K hm hn := by
  let R := criticalSchurSourceRing K m n
  let P := criticalSchurPrimeDivisor K hm hn
  let A := Localization.AtPrime P.1
  let v := IsDiscreteValuationRing.maximalIdeal A
  let x : FractionRing R := algebraMap R (FractionRing R) q
  have hxval : v.valuation (FractionRing R) x = 1 := by
    have hmap : x = algebraMap A (FractionRing R) (algebraMap R A q) :=
      IsScalarTower.algebraMap_apply R A (FractionRing R) q
    rw [hmap, v.valuation_of_algebraMap]
    apply intValuation_eq_one_iff.mpr
    change algebraMap R A q ∉ IsLocalRing.maximalIdeal A
    rw [IsLocalRing.mem_maximalIdeal]
    intro hnonunit
    exact hnonunit ((IsLocalization.AtPrime.isUnit_to_map_iff A P.1 q).2 hq)
  change v.valuation (FractionRing R) x⁻¹ ≤ 1
  rw [map_inv₀, hxval, inv_one]

/-- Applying the inverse Schur-coordinate equivalence sends the transverse field into the field
generated by the corresponding transverse coordinate variables. -/
theorem criticalSourceSchurFieldEquiv_symm_mem_transverseCoordinateField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (x : criticalSourceField K m n)
    (hx : x ∈ criticalSchurTransverseField K hm hn) :
    (criticalSourceSchurFieldEquiv K hm hn).symm x ∈
      IntermediateField.adjoin K (Set.range
        (fun i : criticalSchurTransverseIndex hm hn =>
          algebraMap (criticalSchurSourceRing K m n)
            (FractionRing (criticalSchurSourceRing K m n)) (MvPolynomial.X i.1))) := by
  let J := IntermediateField.adjoin K (Set.range
    (fun i : criticalSchurTransverseIndex hm hn =>
      algebraMap (criticalSchurSourceRing K m n)
        (FractionRing (criticalSchurSourceRing K m n)) (MvPolynomial.X i.1)))
  change (criticalSourceSchurFieldEquiv K hm hn).symm x ∈ J
  refine IntermediateField.adjoin_induction K (p := fun y _ =>
    (criticalSourceSchurFieldEquiv K hm hn).symm y ∈ J) ?_ ?_ ?_ ?_ ?_ hx
  · intro y hy
    obtain ⟨i, rfl⟩ := hy
    rw [criticalSourceSchurFieldEquiv_symm_coordinate]
    exact IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
  · intro y
    have hy := (criticalSourceSchurFieldEquiv K hm hn).symm.commutes y
    rw [hy]
    exact J.algebraMap_mem y
  · intro y z hy hz hyJ hzJ
    rw [map_add]
    exact J.add_mem hyJ hzJ
  · intro y hy hyJ
    rw [map_inv₀]
    exact J.inv_mem hyJ
  · intro y z hy hz hyJ hzJ
    rw [map_mul]
    exact J.mul_mem hyJ hzJ

theorem aeval_transverseCoordinate_eq_algebraMap_rename
    (K : Type*) [Field K] {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    (q : MvPolynomial (criticalSchurTransverseIndex hm hn) K) :
    MvPolynomial.aeval
        (fun i : criticalSchurTransverseIndex hm hn =>
          algebraMap (criticalSchurSourceRing K m n)
            (FractionRing (criticalSchurSourceRing K m n)) (MvPolynomial.X i.1)) q =
      algebraMap (criticalSchurSourceRing K m n)
        (FractionRing (criticalSchurSourceRing K m n))
          (MvPolynomial.rename Subtype.val q) := by
  let φ : criticalSchurSourceRing K m n →ₐ[K]
      FractionRing (criticalSchurSourceRing K m n) :=
    IsScalarTower.toAlgHom K (criticalSchurSourceRing K m n)
      (FractionRing (criticalSchurSourceRing K m n))
  change MvPolynomial.aeval (fun i => φ (MvPolynomial.X i.1)) q =
    φ (MvPolynomial.rename Subtype.val q)
  have hφ : MvPolynomial.aeval (fun i => φ (MvPolynomial.X i)) = φ := by
    ext i
    simp
  calc
    MvPolynomial.aeval (fun i => φ (MvPolynomial.X i.1)) q =
        MvPolynomial.aeval (fun i => φ (MvPolynomial.X i))
          (MvPolynomial.rename Subtype.val q) := by
            have hfun : (fun i : criticalSchurTransverseIndex hm hn =>
                φ (MvPolynomial.X i.1)) =
                (fun i => φ (MvPolynomial.X i)) ∘ Subtype.val := rfl
            rw [hfun]
            exact (MvPolynomial.aeval_rename Subtype.val
              (fun i => φ (MvPolynomial.X i)) q).symm
    _ = φ (MvPolynomial.rename Subtype.val q) :=
      AlgHom.congr_fun hφ _

/-- Every nonzero element of the transverse Schur field that is viewed in the source valuation
ring is a unit there. -/
theorem isUnit_criticalSchurSourceValuationSubring_of_mem_transverseField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n)
    (x : criticalSourceField K m n)
    (hxtrans : x ∈ criticalSchurTransverseField K (by omega) (by omega))
    (hx0 : x ≠ 0)
    (hxmem : x ∈ criticalSchurSourceValuationSubring K (by omega) (by omega)) :
    IsUnit (⟨x, hxmem⟩ : criticalSchurSourceValuationSubring K (by omega) (by omega)) := by
  let hm0 : 0 < m := by omega
  let hn0 : 0 < n := by omega
  let R := criticalSchurSourceRing K m n
  let F := FractionRing R
  let O := criticalSchurCoordinateValuationSubring K hm0 hn0
  let e := criticalSourceSchurFieldEquiv K hm0 hn0
  let y : F := e.symm x
  let g : criticalSchurTransverseIndex hm0 hn0 → F := fun i =>
    algebraMap R F (MvPolynomial.X i.1)
  have hytrans : y ∈ IntermediateField.adjoin K (Set.range g) := by
    exact criticalSourceSchurFieldEquiv_symm_mem_transverseCoordinateField
      K hm0 hn0 x hxtrans
  obtain ⟨r, s, hrs⟩ :=
    (IntermediateField.mem_adjoin_range_iff K g y).mp hytrans
  let a : R := MvPolynomial.rename Subtype.val r
  let b : R := MvPolynomial.rename Subtype.val s
  have hrep : y = algebraMap R F a / algebraMap R F b := by
    rw [hrs]
    dsimp only [a, b, g]
    rw [
      aeval_transverseCoordinate_eq_algebraMap_rename K hm0 hn0,
      aeval_transverseCoordinate_eq_algebraMap_rename K hm0 hn0]
  have hy0 : y ≠ 0 := by
    intro hy
    apply hx0
    have h := congrArg e hy
    simpa [y, e] using h
  have ha0 : a ≠ 0 := by
    intro ha
    apply hy0
    rw [hrep, ha, map_zero, zero_div]
  have hb0 : b ≠ 0 := by
    intro hb
    apply hy0
    rw [hrep, hb, map_zero, div_zero]
  have hadegree : MvPolynomial.degreeOf
      (criticalSchurRamificationCoordinateIndex hm0 hn0) a = 0 := by
    apply degreeOf_rename_eq_zero_of_avoids
    intro i
    exact i.property
  have hbdegree : MvPolynomial.degreeOf
      (criticalSchurRamificationCoordinateIndex hm0 hn0) b = 0 := by
    apply degreeOf_rename_eq_zero_of_avoids
    intro i
    exact i.property
  have haoutside : a ∉ criticalSchurRamificationIdeal K m n :=
    not_mem_criticalSchurRamificationIdeal_of_degreeOf_ramificationCoordinate_eq_zero
      K hm hn ha0 hadegree
  have hboutside : b ∉ criticalSchurRamificationIdeal K m n :=
    not_mem_criticalSchurRamificationIdeal_of_degreeOf_ramificationCoordinate_eq_zero
      K hm hn hb0 hbdegree
  have hamem : algebraMap R F a ∈ O :=
    criticalSchurCoordinateValuationSubring_algebraMap_mem K hm0 hn0 a
  have hbmem : algebraMap R F b ∈ O :=
    criticalSchurCoordinateValuationSubring_algebraMap_mem K hm0 hn0 b
  have hainvmem : (algebraMap R F a)⁻¹ ∈ O :=
    criticalSchurCoordinateValuationSubring_algebraMap_inv_mem_of_not_mem
      K hm0 hn0 a haoutside
  have hbinvmem : (algebraMap R F b)⁻¹ ∈ O :=
    criticalSchurCoordinateValuationSubring_algebraMap_inv_mem_of_not_mem
      K hm0 hn0 b hboutside
  have hyinvmem : y⁻¹ ∈ O := by
    rw [hrep, inv_div]
    exact O.mul_mem _ _ hbmem hainvmem
  have hxinvMem : x⁻¹ ∈ criticalSchurSourceValuationSubring K hm0 hn0 := by
    rw [mem_criticalSchurSourceValuationSubring_iff, map_inv₀]
    exact hyinvmem
  rw [isUnit_iff_exists_inv]
  refine ⟨⟨x⁻¹, hxinvMem⟩, Subtype.ext ?_⟩
  exact mul_inv_cancel₀ hx0

/-! ## The two marked source coordinates -/

/-- For two-sided block sizes, the marked raw source coefficient belongs to the transverse Schur
field. -/
theorem criticalSourceRaw_marked_mem_transverseField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n) :
    criticalSourceRaw K m n ⟨m, by omega⟩ ∈
      criticalSchurTransverseField K (by omega) (by omega) := by
  let hm0 : 0 < m := by omega
  let hn0 : 0 < n := by omega
  let j : Fin (m + n - 1) := ⟨m - 1, by omega⟩
  let J := criticalSchurTransverseField K hm0 hn0
  have hj : (j : ℕ) < m + n - 2 := by
    dsimp [j]
    omega
  have hu : criticalSourceNormalizedPositive K hm0 hn0 j ∈ J :=
    criticalSourceNormalizedPositive_mem_transverseField_of_lt K hm0 hn0 j hj
  have hzeroIndex : (0 : Fin (m + n - 1 + 1)) ≠
      criticalSchurRamificationCoordinateIndex hm0 hn0 := by
    intro h
    have := congrArg Fin.val h
    dsimp [criticalSchurRamificationCoordinateIndex] at this
    omega
  have hs : criticalSourceScale K hm0 hn0 ∈ J := by
    rw [criticalSourceScale_eq_schurCoordinate_zero K hm0 hn0]
    exact criticalSourceSchurCoordinate_mem_transverseField K hm0 hn0 0 hzeroIndex
  have hrawIndex : criticalSourceRaw K m n ⟨m, by omega⟩ =
      criticalSourceRawReindexed K hm0 hn0 j.succ := by
    apply Subtype.ext
    change criticalAmbientRaw K m n m =
      criticalAmbientRaw K m n (Fin.cast (by omega) j.succ : ℕ)
    congr 1
    dsimp [j]
    omega
  have hscaleIndex : criticalSourceRawReindexed K hm0 hn0 0 =
      criticalSourceScale K hm0 hn0 := by
    apply Subtype.ext
    rfl
  have heq : criticalSourceRaw K m n ⟨m, by omega⟩ =
      criticalSourceNormalizedPositive K hm0 hn0 j *
        criticalSourceScale K hm0 hn0 := by
    rw [hrawIndex]
    change criticalSourceRawReindexed K hm0 hn0 j.succ =
      (criticalSourceRawReindexed K hm0 hn0 j.succ /
        criticalSourceRawReindexed K hm0 hn0 0) * criticalSourceScale K hm0 hn0
    rw [hscaleIndex]
    exact (div_mul_cancel₀ _ (criticalSourceScale_ne_zero K hm0 hn0)).symm
  rw [heq]
  exact J.mul_mem hu hs

/-- For two-sided block sizes, the marked reciprocal source coefficient belongs to the transverse
Schur field. -/
theorem criticalSourceRecip_marked_mem_transverseField
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n) :
    criticalSourceRecip K m n ⟨n, by omega⟩ ∈
      criticalSchurTransverseField K (by omega) (by omega) := by
  let hm0 : 0 < m := by omega
  let hn0 : 0 < n := by omega
  let j : Fin (m + n - 1) := ⟨n - 1, by omega⟩
  let J := criticalSchurTransverseField K hm0 hn0
  have hj : (j : ℕ) < m + n - 2 := by
    dsimp [j]
    omega
  have hv : finiteReciprocalPositive (criticalSourceNormalizedPositive K hm0 hn0) j ∈ J :=
    criticalSourceNormalizedReciprocalPositive_mem_transverseField_of_lt K hm0 hn0 j hj
  have hzeroIndex : (0 : Fin (m + n - 1 + 1)) ≠
      criticalSchurRamificationCoordinateIndex hm0 hn0 := by
    intro h
    have := congrArg Fin.val h
    dsimp [criticalSchurRamificationCoordinateIndex] at this
    omega
  have hs : criticalSourceScale K hm0 hn0 ∈ J := by
    rw [criticalSourceScale_eq_schurCoordinate_zero K hm0 hn0]
    exact criticalSourceSchurCoordinate_mem_transverseField K hm0 hn0 0 hzeroIndex
  have hcoeff := criticalSourceNormalizedReciprocalPolynomial_coeff K hm0 hn0
    (k := n) (by omega : n < m + n)
  rw [criticalSourceReciprocalPolynomial_coeff K m n n (by omega)] at hcoeff
  have hvcoeff :
      (criticalSourceNormalizedReciprocalPolynomial K hm0 hn0).coeff n =
        finiteReciprocalPositive (criticalSourceNormalizedPositive K hm0 hn0) j := by
    have h := finiteUnitPolynomial_coeff_succ
      (finiteReciprocalPositive (criticalSourceNormalizedPositive K hm0 hn0)) j
    have hjindex : (j : ℕ) + 1 = n := by
      dsimp [j]
      omega
    rw [hjindex] at h
    simpa [criticalSourceNormalizedReciprocalPolynomial] using h
  have heq : criticalSourceRecip K m n ⟨n, by omega⟩ =
      (criticalSourceScale K hm0 hn0)⁻¹ *
        finiteReciprocalPositive (criticalSourceNormalizedPositive K hm0 hn0) j := by
    rw [← hvcoeff, hcoeff]
    field_simp [criticalSourceScale_ne_zero K hm0 hn0]
  rw [heq]
  exact J.mul_mem (J.inv_mem hs) hv

theorem criticalSourceRaw_marked_ne_zero
    (K : Type*) [Field K] {m n : ℕ} (_hm : 1 < m) (hn : 1 < n) :
    criticalSourceRaw K m n ⟨m, by omega⟩ ≠ 0 := by
  intro hzero
  exact ((algebraicIndependent_criticalSourceRaw K m n).transcendental ⟨m, by omega⟩)
    (hzero ▸ isAlgebraic_zero)

theorem criticalSourceRecip_marked_ne_zero
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n) :
    criticalSourceRecip K m n ⟨n, by omega⟩ ≠ 0 := by
  let i : Fin (m + n - 1 + 1) := ⟨n, by omega⟩
  have hreindex : criticalSourceRecip K m n ⟨n, by omega⟩ =
      criticalSourceRecipReindexed K (by omega) (by omega) i := by
    apply Subtype.ext
    rfl
  rw [hreindex]
  intro hzero
  exact ((algebraicIndependent_criticalSourceRecip K (by omega) (by omega)).transcendental i)
    (hzero ▸ isAlgebraic_zero)

/-- The marked raw source coefficient is a unit of the source Schur valuation ring. -/
theorem isUnit_criticalSourceRaw_marked_sourceValuationSubring
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n) :
    IsUnit (⟨criticalSourceRaw K m n ⟨m, by omega⟩,
      criticalSourceRaw_mem_sourceValuationSubring K (by omega) (by omega) ⟨m, by omega⟩⟩ :
        criticalSchurSourceValuationSubring K (by omega) (by omega)) := by
  apply isUnit_criticalSchurSourceValuationSubring_of_mem_transverseField K hm hn
  · exact criticalSourceRaw_marked_mem_transverseField K hm hn
  · exact criticalSourceRaw_marked_ne_zero K hm hn

/-- The marked reciprocal source coefficient is a unit of the source Schur valuation ring. -/
theorem isUnit_criticalSourceRecip_marked_sourceValuationSubring
    (K : Type*) [Field K] [CharZero K]
    {m n : ℕ} (hm : 1 < m) (hn : 1 < n) :
    IsUnit (⟨criticalSourceRecip K m n ⟨n, by omega⟩,
      criticalSourceRecip_mem_sourceValuationSubring K (by omega) (by omega) ⟨n, by omega⟩⟩ :
        criticalSchurSourceValuationSubring K (by omega) (by omega)) := by
  apply isUnit_criticalSchurSourceValuationSubring_of_mem_transverseField K hm hn
  · exact criticalSourceRecip_marked_mem_transverseField K hm hn
  · exact criticalSourceRecip_marked_ne_zero K hm hn

end

