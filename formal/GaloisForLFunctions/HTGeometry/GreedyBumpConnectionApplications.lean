import GaloisForLFunctions.HTGeometry.NonabelianAsymptoticConnection
import GaloisForLFunctions.HTGeometry.ComplexHermitianRealification
import GaloisForLFunctions.HTGeometry.GreedyBumpLocalGeometry

/-!
# Greedy-bump laws for finite-rank asymptotic connections

A covariant invertible complex frame generates a positive Hermitian metric.  Doubled-real
transport makes it a template metric for arXiv:2609.03581.  Dilation may rescale its volume, but
the matched profiling bias only sees the `2r` real tangent directions.
-/

open Matrix
open scoped ComplexOrder

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Doubled-real form of a finite-rank connection metric. -/
def greedyBumpConnectionRealifiedMatrix {r : ℕ}
    (A : Matrix (Fin r) (Fin r) ℂ) : Matrix (Fin (r + r)) (Fin (r + r)) ℝ :=
  (complexMatrixRealification A).submatrix finSumFinEquiv.symm finSumFinEquiv.symm

/-- Metric generated by a covariant invertible frame, in real coordinates. -/
def CovariantPositiveMatrixFrame.greedyBumpMetric {r : ℕ}
    (F : CovariantPositiveMatrixFrame r) (s : ℝ) (n : ℕ) :
    PositiveTemplateMetric (r + r) where
  matrix := greedyBumpConnectionRealifiedMatrix (F.metric s n)
  posDef := (complexMatrixRealification_posDef (F.metric_posDef s n)).submatrix
    finSumFinEquiv.symm.injective

/-- Every scale and grade of the connection satisfies the full local-search package. -/
theorem CovariantPositiveMatrixFrame.greedyBump_laws {r : ℕ}
    (F : CovariantPositiveMatrixFrame r) (s : ℝ) (n : ℕ) (Q : PositiveSignal) :
    GreedyBumpMetricLaws Q (F.greedyBumpMetric s n) :=
  greedyBumpMetricLaws_closed Q _

/-- A rank-`r` complex connection has `r/Q` leading amplitude bias. -/
theorem CovariantPositiveMatrixFrame.greedyBump_bias {r : ℕ}
    (F : CovariantPositiveMatrixFrame r) (s : ℝ) (n : ℕ) (Q : PositiveSignal) :
    (1 / 2 : ℝ) * Matrix.trace
        ((greedyBumpHessian Q (F.greedyBumpMetric s n))⁻¹ *
          (F.greedyBumpMetric s n).matrix) =
      (r : ℝ) / (Q : ℝ) := by
  rw [greedyBump_matched_bias]
  push_cast
  field_simp [ne_of_gt Q.property]
  ring

/-- Dilation scale changes metric geometry but not the dimension-only matched bias. -/
theorem CovariantPositiveMatrixFrame.greedyBump_bias_scaleInvariant {r : ℕ}
    (F : CovariantPositiveMatrixFrame r) (s t : ℝ) (n : ℕ) (Q : PositiveSignal) :
    (1 / 2 : ℝ) * Matrix.trace
        ((greedyBumpHessian Q (F.greedyBumpMetric s n))⁻¹ *
          (F.greedyBumpMetric s n).matrix) =
      (1 / 2 : ℝ) * Matrix.trace
        ((greedyBumpHessian Q (F.greedyBumpMetric t n))⁻¹ *
          (F.greedyBumpMetric t n).matrix) := by
  rw [F.greedyBump_bias s n Q, F.greedyBump_bias t n Q]

/-- Metric-unit localization radius counts both real coordinates of every complex channel. -/
theorem CovariantPositiveMatrixFrame.greedyBump_localizationRadius {r : ℕ}
    (F : CovariantPositiveMatrixFrame r) (s : ℝ) (n : ℕ) (Q : PositiveSignal) :
    Matrix.trace
        (greedyBumpLocalizationCovariance Q (F.greedyBumpMetric s n) *
          (F.greedyBumpMetric s n).matrix) =
      ((r + r : ℕ) : ℝ) / (Q : ℝ) ^ 2 :=
  greedyBumpLocalizationCovariance_trace_mul Q _

end

end GaloisForLFunctions.HTGeometry
