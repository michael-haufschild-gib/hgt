import GaloisForLFunctions.HTGeometry.DifferenceSpecialization

/-!
# The torsor decomposition

If a subalgebra `E` of an `R`-algebra `A` generates `A` over `R`, and some `C`-basis of `E` stays
linearly independent over `R`, then `R ⊗_C E → A` is an isomorphism.  For a Picard--Vessiot ring
and its tensor square this is the torsor decomposition: `R ⊗_K R ≅ R ⊗_C E` with `E` the algebra of
constants generated by the comparison matrix.

Both hypotheses are already available for that case: generation is
`adjoin_tensor_comparison_eq_top`, and the independence is `basisIndependentOver_of_constants`,
which derives it from `σ`-simplicity.
-/

open scoped TensorProduct

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- A linear map carrying a basis to a linearly independent family is injective. -/
theorem injective_of_basis_map_linearIndependent
    {R M N ι : Type*} [Ring R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (b : Module.Basis ι R M) (f : M →ₗ[R] N)
    (h : LinearIndependent R (fun i => f (b i))) : Function.Injective f := by
  intro x y hxy
  have hz : f (x - y) = 0 := by rw [map_sub, hxy, sub_self]
  have hrepr : Finsupp.linearCombination R (fun i => b i) (b.repr (x - y)) = x - y :=
    b.linearCombination_repr _
  have hzero : Finsupp.linearCombination R (fun i => f (b i)) (b.repr (x - y)) = 0 := by
    have hcomp := Finsupp.apply_linearCombination R f (fun i => b i) (b.repr (x - y))
    rw [hrepr] at hcomp
    have hfn : (⇑f ∘ fun i => b i) = fun i => f (b i) := rfl
    rw [hfn] at hcomp
    rw [← hcomp]
    exact hz
  have hl := linearIndependent_iff.mp h _ hzero
  have hxy0 : x - y = 0 := by rw [← hrepr, hl, map_zero]
  exact sub_eq_zero.mp hxy0

variable {C R A : Type*} [Field C] [CommRing R] [CommRing A]
  [Algebra C R] [Algebra C A] [Algebra R A] [IsScalarTower C R A]

/-- The canonical map from the tensor product of the base with a subalgebra. -/
def tensorDecompositionHom (E : Subalgebra C A) : (R ⊗[C] E) →ₐ[R] A :=
  Algebra.TensorProduct.lift (Algebra.ofId R A) E.val (fun _ _ => Commute.all _ _)

@[simp] theorem tensorDecompositionHom_tmul (E : Subalgebra C A) (r : R) (e : E) :
    tensorDecompositionHom (R := R) E (r ⊗ₜ[C] e) = algebraMap R A r * (e : A) :=
  Algebra.TensorProduct.lift_tmul _ _ _ _ _

theorem tensorDecompositionHom_surjective (E : Subalgebra C A)
    (hgen : Algebra.adjoin C (Set.range (algebraMap R A) ∪ (E : Set A)) = ⊤) :
    Function.Surjective (tensorDecompositionHom (R := R) E) := by
  intro x
  have hle : Algebra.adjoin C (Set.range (algebraMap R A) ∪ (E : Set A))
      ≤ ((tensorDecompositionHom (R := R) E).range).restrictScalars C := by
    refine Algebra.adjoin_le ?_
    rintro y (⟨r, rfl⟩ | hy)
    · refine ⟨r ⊗ₜ[C] 1, ?_⟩
      show tensorDecompositionHom (R := R) E (r ⊗ₜ[C] (1 : E)) = algebraMap R A r
      rw [tensorDecompositionHom_tmul]
      simp
    · refine ⟨1 ⊗ₜ[C] (⟨y, hy⟩ : E), ?_⟩
      show tensorDecompositionHom (R := R) E ((1 : R) ⊗ₜ[C] (⟨y, hy⟩ : E)) = y
      rw [tensorDecompositionHom_tmul]
      simp
  rw [hgen] at hle
  have hx : x ∈ ((tensorDecompositionHom (R := R) E).range).restrictScalars C :=
    hle Algebra.mem_top
  exact hx

theorem tensorDecompositionHom_injective (E : Subalgebra C A) {ι : Type*}
    (b : Module.Basis ι C E)
    (hindep : LinearIndependent R (fun i => ((b i : E) : A))) :
    Function.Injective (tensorDecompositionHom (R := R) E) := by
  refine injective_of_basis_map_linearIndependent (Module.Basis.baseChange R b)
    (tensorDecompositionHom (R := R) E).toLinearMap ?_
  have hval : ∀ i : ι, (tensorDecompositionHom (R := R) E)
      ((Module.Basis.baseChange R b) i) = ((b i : E) : A) := by
    intro i
    rw [Module.Basis.baseChange_apply, tensorDecompositionHom_tmul]
    simp
  simpa only [AlgHom.toLinearMap_apply, hval] using hindep

/-- **The torsor decomposition.** -/
def tensorDecompositionEquiv (E : Subalgebra C A) {ι : Type*}
    (b : Module.Basis ι C E)
    (hgen : Algebra.adjoin C (Set.range (algebraMap R A) ∪ (E : Set A)) = ⊤)
    (hindep : LinearIndependent R (fun i => ((b i : E) : A))) :
    (R ⊗[C] E) ≃ₐ[R] A :=
  AlgEquiv.ofBijective (tensorDecompositionHom (R := R) E)
    ⟨tensorDecompositionHom_injective E b hindep,
      tensorDecompositionHom_surjective E hgen⟩

end

end GaloisForLFunctions.HTGeometry
