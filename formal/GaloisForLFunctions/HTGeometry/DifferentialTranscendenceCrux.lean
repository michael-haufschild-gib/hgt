import Mathlib
import GaloisForLFunctions.HTGeometry.DerivationPrescription
import GaloisForLFunctions.HTGeometry.JetLevelAlgebraicallyClosed

/-!
# A first-derivative horizon that loses transcendence carries a gauge

If a differential field is generated over a differential subfield by elements whose derivatives
already lie in that subfield, and it is not algebraic over it, then it carries a nonzero derivation
over the subfield which commutes with the derivation of the field.

The construction is elementary.  Choose a transcendence basis inside the generating family and
prescribe constant values on it.  The commutator of the resulting derivation with the derivation of
the field kills the subfield, because the subfield is stable under the derivation, and kills every
basis element, because the derivative of a generator lies in the subfield while the prescribed value
is a constant.  Since the field is algebraic over the subfield generated by the basis, the
commutator vanishes identically.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C F : Type*} [Field C] [CharZero C] [Field F] [CharZero F] [Algebra C F]
  [Differential F]

omit [CharZero F] [Differential F] in
/-- A field is algebraic over the subalgebra generated by a family generating it as a field. -/
theorem isAlgebraic_algebraAdjoin_of_adjoin_eq_top {K : Type*} [Field K] [Algebra K F]
    {κ : Type*} (y : κ → F)
    (htop : IntermediateField.adjoin K (Set.range y) = ⊤) :
    Algebra.IsAlgebraic (↥(Algebra.adjoin K (Set.range y))) F := by
  classical
  refine ⟨fun x => ?_⟩
  have hx : x ∈ IntermediateField.adjoin K (Set.range y) := by rw [htop]; trivial
  obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.1 hx
  by_cases hs0 : s = 0
  · rw [hs0, div_zero]
    exact isAlgebraic_zero
  · refine ⟨Polynomial.C (⟨s, hs⟩ : ↥(Algebra.adjoin K (Set.range y))) * Polynomial.X
      - Polynomial.C ⟨r, hr⟩, ?_, ?_⟩
    · intro hzero
      have := congrArg (fun p : Polynomial ↥(Algebra.adjoin K (Set.range y)) =>
        p.coeff 1) hzero
      simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
        mul_one, Polynomial.coeff_C, Polynomial.coeff_zero] at this
      simp only [if_neg (by norm_num : (1 : ℕ) ≠ 0), sub_zero] at this
      exact hs0 (congrArg Subtype.val this)
    · simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
      show (s : F) * (r / s) - (r : F) = 0
      field_simp
      ring

/-- **The crux.**  A differential field generated over a derivation-closed intermediate field by
elements whose derivatives lie in that field, and not algebraic over it, carries a nonzero
derivation over the constants which kills the intermediate field and commutes with the
derivation. -/
theorem exists_derivation_commuting_of_not_isAlgebraic
    (K : IntermediateField C F) (hKclosed : DerivationClosed K)
    {κ : Type*} {y : κ → F}
    (htop : IntermediateField.adjoin (↥K) (Set.range y) = ⊤)
    (hδ : ∀ i, (y i)′ ∈ K)
    {i₀ : κ} (hnotalg : ¬ IsAlgebraic (↥K) (y i₀)) :
    ∃ D : Derivation C F F, (∀ x : F, D (x′) = (D x)′) ∧ (∀ x ∈ K, D x = 0) ∧ D ≠ 0 := by
  classical
  haveI : Algebra.IsAlgebraic (↥(Algebra.adjoin (↥K) (Set.range y))) F :=
    isAlgebraic_algebraAdjoin_of_adjoin_eq_top y htop
  obtain ⟨t, hts, ht⟩ := exists_isTranscendenceBasis_subset (R := ↥K) (Set.range y)
  -- the basis is nonempty, since some generator is transcendental
  have hne : t.Nonempty := by
    by_contra hempty
    rw [Set.not_nonempty_iff_eq_empty] at hempty
    have hEmpty : IsEmpty ↥t := by rw [hempty]; infer_instance
    have halgF : Algebra.IsAlgebraic (↥K) F := ht.isEmpty_iff_isAlgebraic.1 hEmpty
    exact hnotalg (halgF.isAlgebraic (y i₀))
  obtain ⟨b₀, hb₀⟩ := hne
  set val : t → ↥K := fun b => if (b : F) = b₀ then 1 else 0 with hval
  obtain ⟨D, hD⟩ := exists_derivation_prescribed (C := ↥K) (L := F) ht.1 val
  refine ⟨D.restrictScalars C, ?_, ?_, ?_⟩
  · -- the commutator vanishes
    intro x
    set E : Derivation ℤ F F := ⁅(Differential.deriv : Derivation ℤ F F),
      D.restrictScalars ℤ⁆ with hE
    have hEapply : ∀ w : F, E w = (D w)′ - D (w′) := by
      intro w
      show (Differential.deriv : Derivation ℤ F F) (D w) - D ((Differential.deriv) w) = _
      rfl
    have hEK : ∀ w ∈ K, E w = 0 := by
      intro w hw
      rw [hEapply]
      have h1 : D w = 0 := by
        have : w = algebraMap (↥K) F ⟨w, hw⟩ := rfl
        rw [this, Derivation.map_algebraMap]
      have h2 : D (w′) = 0 := by
        have : w′ = algebraMap (↥K) F ⟨w′, hKclosed hw⟩ := rfl
        rw [this, Derivation.map_algebraMap]
      rw [h1, h2, map_zero, sub_zero]
    have hEbasis : ∀ b : t, E (b : F) = 0 := by
      intro b
      obtain ⟨j, hj⟩ := hts b.2
      have hderiv : ((algebraMap (↥K) F (val b)))′ = 0 := by
        by_cases hb : (b : F) = b₀
        · rw [hval]
          simp only [if_pos hb, map_one]
          exact Derivation.map_one_eq_zero _
        · rw [hval]
          simp only [if_neg hb, map_zero]
      have hDb : D (((b : F))′) = 0 := by
        rw [← hj]
        have heq : (y j)′ = algebraMap (↥K) F ⟨(y j)′, hδ j⟩ := rfl
        rw [heq, Derivation.map_algebraMap]
      rw [hEapply, hD b, hderiv, hDb, sub_zero]
    -- E kills the field generated by the basis over K, and F is algebraic over it
    have hEadjoin0 : ∀ w ∈ IntermediateField.adjoin (↥K) (Set.range ((↑) : t → F)),
        E w = 0 := by
      intro w hw
      refine IntermediateField.adjoin_induction (↥K) ?_ ?_ ?_ ?_ ?_ hw
      · rintro x ⟨b, rfl⟩
        exact hEbasis b
      · intro x
        exact hEK _ x.2
      · intro x z _ _ ihx ihz
        rw [map_add, ihx, ihz, add_zero]
      · intro x _ ihx
        rcases eq_or_ne x 0 with rfl | hx0
        · simp
        · have hprod : E (x * x⁻¹) = 0 := by
            rw [mul_inv_cancel₀ hx0]
            exact Derivation.map_one_eq_zero _
          rw [Derivation.leibniz] at hprod
          simp only [smul_eq_mul, ihx, mul_zero, add_zero] at hprod
          exact (mul_eq_zero.1 hprod).resolve_left hx0
      · intro x z _ _ ihx ihz
        rw [Derivation.leibniz]
        simp [ihx, ihz]
    have hEadjoin : ∀ w ∈ (IntermediateField.adjoin (↥K)
        (Set.range ((↑) : t → F))).restrictScalars C, E w = 0 := fun w hw => hEadjoin0 w hw
    have hEzero : E x = 0 := by
      refine derivation_eq_zero_of_isAlgebraic (C := C)
        ((IntermediateField.adjoin (↥K) (Set.range ((↑) : t → F))).restrictScalars C) E
        hEadjoin ?_
      have := ht.isAlgebraic_field
      exact this.isAlgebraic x
    have := hEapply x
    rw [hEzero] at this
    exact (sub_eq_zero.1 this.symm).symm
  · intro w hw
    show D w = 0
    have : w = algebraMap (↥K) F ⟨w, hw⟩ := rfl
    rw [this, Derivation.map_algebraMap]
  · intro hzero
    have hb : D (b₀ : F) = algebraMap (↥K) F (val ⟨b₀, hb₀⟩) := hD ⟨b₀, hb₀⟩
    rw [hval] at hb
    simp at hb
    have : (D.restrictScalars C) (b₀ : F) = 0 := by rw [hzero]; rfl
    exact one_ne_zero (hb ▸ this)

end

end GaloisForLFunctions.HTGeometry
