import Mathlib

/-!
# Two collapse tiers: a single rational line is strictly stronger than a single transcendental

A finite family of "logarithms" can collapse in two different ways.  In the **linear** tier all
members lie on one rational line, so the rational span has dimension one.  In the **algebraic**
tier all members lie in the algebra generated by a single element, so the transcendence degree is
one.  The first tier implies the second, and the implication is strict: `x` and `x ^ 2` span a
two-dimensional rational space whenever `x` is irrational, while they always generate an algebra of
transcendence degree at most one.

Consequently rational-linear independence of a family says nothing about the transcendence degree of
the algebra it generates: the two invariants are independent, and `![x, x ^ 2]` realises the corner
where the linear invariant is two and the algebraic invariant is one.

* `trdeg_adjoin_le_cardinalMk`, `trdeg_adjoin_le_rank_span` — the transcendence degree of a
  generated algebra is at most the number of generators, and at most the dimension of the rational
  span: the general "algebraic tier ≤ linear tier" bound.
* `trdeg_adjoin_le_one_of_subset_adjoin_singleton` — the algebraic tier from a single generator.
* `trdeg_adjoin_le_one_of_rationalMultiple` — the linear tier implies the algebraic tier.
* `trdeg_adjoin_singleton_eq_one` — the algebraic tier is exactly one at a transcendental generator.
* `linearIndependent_pair_sq_of_irrational`, `not_algebraicIndependent_pair_sq` — the separating
  witness.
* `linearIndependent_pair_pi_sq` — the witness at `π`, and `exists_linearIndependent_pair_trdeg_one`
  the unconditional separation.
-/

namespace GaloisForLFunctions.HTGeometry

open Algebra

variable {A : Type} [CommRing A] [Algebra ℚ A]

/-! ### The algebraic tier -/

/-- The algebra generated by a single element is a quotient of the polynomial ring, hence has
transcendence degree at most one. -/
theorem trdeg_adjoin_singleton_le_one (t : A) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ ({t} : Set A)) ≤ 1 := by
  have hrange : (Polynomial.aeval t : Polynomial ℚ →ₐ[ℚ] A).range
      = Algebra.adjoin ℚ ({t} : Set A) := (Algebra.adjoin_singleton_eq_range_aeval ℚ t).symm
  have hsurj : Function.Surjective
      ((Subalgebra.equivOfEq _ _ hrange).toAlgHom.comp
        (Polynomial.aeval t : Polynomial ℚ →ₐ[ℚ] A).rangeRestrict) := by
    intro y
    obtain ⟨p, hp⟩ := (Polynomial.aeval t : Polynomial ℚ →ₐ[ℚ] A).rangeRestrict_surjective
      ((Subalgebra.equivOfEq _ _ hrange).symm y)
    exact ⟨p, by simp [hp]⟩
  calc Algebra.trdeg ℚ (Algebra.adjoin ℚ ({t} : Set A))
      ≤ Algebra.trdeg ℚ (Polynomial ℚ) := trdeg_le_of_surjective _ hsurj
    _ = 1 := Polynomial.trdeg_of_isDomain

/-- **The algebraic tier.**  A family contained in the algebra generated by one element generates an
algebra of transcendence degree at most one. -/
theorem trdeg_adjoin_le_one_of_subset_adjoin_singleton {ι : Type*} {L : ι → A} {t : A}
    (h : Set.range L ⊆ (Algebra.adjoin ℚ ({t} : Set A) : Set A)) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range L)) ≤ 1 := by
  have hle : Algebra.adjoin ℚ (Set.range L) ≤ Algebra.adjoin ℚ ({t} : Set A) :=
    Algebra.adjoin_le h
  have hinj : Function.Injective (Subalgebra.inclusion hle) :=
    Subalgebra.inclusion_injective hle
  exact le_trans (trdeg_le_of_injective _ hinj) (trdeg_adjoin_singleton_le_one t)

/-- **The linear tier implies the algebraic tier.**  If every member of the family is a rational
multiple of one element, the generated algebra has transcendence degree at most one. -/
theorem trdeg_adjoin_le_one_of_rationalMultiple {ι : Type*} {L : ι → A} {t : A}
    (h : ∀ i, ∃ q : ℚ, L i = q • t) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range L)) ≤ 1 := by
  refine trdeg_adjoin_le_one_of_subset_adjoin_singleton (t := t) ?_
  rintro - ⟨i, rfl⟩
  obtain ⟨q, hq⟩ := h i
  rw [hq]
  exact Subalgebra.smul_mem _ (Algebra.self_mem_adjoin_singleton ℚ t) q

/-- At a transcendental generator the algebraic tier is exactly one. -/
theorem trdeg_adjoin_singleton_eq_one {t : A} (ht : Transcendental ℚ t) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ ({t} : Set A)) = 1 := by
  have hinj : Function.Injective (Polynomial.aeval t : Polynomial ℚ →ₐ[ℚ] A) :=
    transcendental_iff_injective.mp ht
  have hrange : (Polynomial.aeval t : Polynomial ℚ →ₐ[ℚ] A).range
      = Algebra.adjoin ℚ ({t} : Set A) := (Algebra.adjoin_singleton_eq_range_aeval ℚ t).symm
  have e : Polynomial ℚ ≃ₐ[ℚ] Algebra.adjoin ℚ ({t} : Set A) :=
    (AlgEquiv.ofInjective _ hinj).trans (Subalgebra.equivOfEq _ _ hrange)
  rw [← e.trdeg_eq]
  exact Polynomial.trdeg_of_isDomain

/-- The algebra generated by a set has transcendence degree at most the cardinality of the set. -/
theorem trdeg_adjoin_le_cardinalMk (s : Set A) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ s) ≤ Cardinal.mk s := by
  have hrange : (MvPolynomial.aeval ((↑) : s → A) : MvPolynomial s ℚ →ₐ[ℚ] A).range
      = Algebra.adjoin ℚ s := (Algebra.adjoin_eq_range ℚ s).symm
  have hsurj : Function.Surjective
      ((Subalgebra.equivOfEq _ _ hrange).toAlgHom.comp
        (MvPolynomial.aeval ((↑) : s → A) : MvPolynomial s ℚ →ₐ[ℚ] A).rangeRestrict) := by
    intro y
    obtain ⟨p, hp⟩ :=
      (MvPolynomial.aeval ((↑) : s → A) : MvPolynomial s ℚ →ₐ[ℚ] A).rangeRestrict_surjective
        ((Subalgebra.equivOfEq _ _ hrange).symm y)
    exact ⟨p, by simp [hp]⟩
  calc Algebra.trdeg ℚ (Algebra.adjoin ℚ s)
      ≤ Algebra.trdeg ℚ (MvPolynomial s ℚ) := trdeg_le_of_surjective _ hsurj
    _ = Cardinal.mk s := by
        rw [MvPolynomial.trdeg_of_isDomain]
        simp

/-- **The algebraic tier is bounded by the linear tier.**  The transcendence degree of the algebra
generated by a set is at most the dimension of its rational linear span.  This is the general form
of "trdeg ≤ corank": pick a rational basis of the span out of the set itself, and the algebra it
generates already contains the set. -/
theorem trdeg_adjoin_le_rank_span (s : Set A) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ s) ≤ Module.rank ℚ (Submodule.span ℚ s) := by
  obtain ⟨B, hBs, hspan, hind⟩ := exists_linearIndependent ℚ s
  have hBadj : B ⊆ (Algebra.adjoin ℚ B : Set A) := Algebra.subset_adjoin
  have hspanle : Submodule.span ℚ B ≤ (Algebra.adjoin ℚ B).toSubmodule :=
    Submodule.span_le.mpr hBadj
  have hSB : s ⊆ (Algebra.adjoin ℚ B : Set A) := by
    intro x hx
    have hx' : x ∈ Submodule.span ℚ s := Submodule.subset_span hx
    rw [← hspan] at hx'
    exact hspanle hx'
  have hle : Algebra.adjoin ℚ s ≤ Algebra.adjoin ℚ B := Algebra.adjoin_le hSB
  have hrank : Module.rank ℚ (Submodule.span ℚ s) = Cardinal.mk B := by
    rw [← hspan, rank_span_set hind]
  calc Algebra.trdeg ℚ (Algebra.adjoin ℚ s)
      ≤ Algebra.trdeg ℚ (Algebra.adjoin ℚ B) :=
        trdeg_le_of_injective _ (Subalgebra.inclusion_injective hle)
    _ ≤ Cardinal.mk B := trdeg_adjoin_le_cardinalMk B
    _ = Module.rank ℚ (Submodule.span ℚ s) := hrank.symm

/-! ### The separating witness -/

/-- **The linear tier is strictly stronger.**  An irrational element and its square are rationally
independent, so the linear invariant of the pair is two. -/
theorem linearIndependent_pair_sq_of_irrational {x : ℝ} (hx : Irrational x) :
    LinearIndependent ℚ ![x, x ^ 2] := by
  have hx0 : x ≠ 0 := by
    intro h
    exact hx ⟨0, by simp [h]⟩
  rw [LinearIndependent.pair_iff]
  intro s t hst
  have key : (s : ℝ) * x + (t : ℝ) * x ^ 2 = 0 := by
    simpa [Rat.smul_def] using hst
  have hfac : x * ((s : ℝ) + (t : ℝ) * x) = 0 := by linear_combination key
  have hsum : (s : ℝ) + (t : ℝ) * x = 0 := by
    rcases mul_eq_zero.mp hfac with h | h
    · exact absurd h hx0
    · exact h
  have ht0 : t = 0 := by
    by_contra htne
    have htne' : (t : ℝ) ≠ 0 := Rat.cast_ne_zero.mpr htne
    refine hx ⟨-s / t, ?_⟩
    push_cast
    field_simp
    linarith [hsum]
  refine ⟨?_, ht0⟩
  have hs : (s : ℝ) = 0 := by
    rw [ht0] at hsum
    simpa using hsum
  exact_mod_cast hs

/-- **The algebraic tier always holds for a square.**  An element and its square are algebraically
dependent, whatever the element. -/
theorem not_algebraicIndependent_pair_sq (x : A) :
    ¬ AlgebraicIndependent ℚ ![x, x ^ 2] := by
  intro h
  have hzero : (MvPolynomial.aeval ![x, x ^ 2])
      (MvPolynomial.X 1 - MvPolynomial.X 0 ^ 2 : MvPolynomial (Fin 2) ℚ) = 0 := by
    simp
  have hp := (algebraicIndependent_iff.mp h) _ hzero
  have hco := congrArg (MvPolynomial.coeff (Finsupp.single 1 1)) hp
  simp [MvPolynomial.coeff_X, MvPolynomial.coeff_X_pow, Finsupp.single_eq_single_iff] at hco

/-- The pair `![x, x ^ 2]` generates an algebra of transcendence degree at most one. -/
theorem trdeg_adjoin_pair_sq_le_one (x : A) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range ![x, x ^ 2])) ≤ 1 := by
  refine trdeg_adjoin_le_one_of_subset_adjoin_singleton (t := x) ?_
  rintro - ⟨i, rfl⟩
  fin_cases i
  · exact Algebra.self_mem_adjoin_singleton ℚ x
  · exact Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton ℚ x) 2

/-- At a transcendental element the pair realises the separation exactly: linear invariant two,
algebraic invariant one. -/
theorem trdeg_adjoin_pair_sq_eq_one {x : A} (hx : Transcendental ℚ x) :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range ![x, x ^ 2])) = 1 := by
  have hset : Set.range ![x, x ^ 2] ⊆ (Algebra.adjoin ℚ ({x} : Set A) : Set A) := by
    rintro - ⟨i, rfl⟩
    fin_cases i
    · exact Algebra.self_mem_adjoin_singleton ℚ x
    · exact Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton ℚ x) 2
  have hsub : Algebra.adjoin ℚ ({x} : Set A) ≤ Algebra.adjoin ℚ (Set.range ![x, x ^ 2]) := by
    refine Algebra.adjoin_le ?_
    rintro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact Algebra.subset_adjoin ⟨0, by simp⟩
  refine le_antisymm (trdeg_adjoin_pair_sq_le_one x) ?_
  rw [← trdeg_adjoin_singleton_eq_one hx]
  exact trdeg_le_of_injective _ (Subalgebra.inclusion_injective hsub)

/-! ### An explicit transcendental real -/

/-- Every rational is algebraic over the integers: clear the denominator. -/
instance isAlgebraic_int_rat : Algebra.IsAlgebraic ℤ ℚ := by
  refine ⟨fun q => ?_⟩
  refine ⟨Polynomial.C (q.den : ℤ) * Polynomial.X - Polynomial.C q.num, ?_, ?_⟩
  · have hco : (Polynomial.C (q.den : ℤ) * Polynomial.X - Polynomial.C q.num).coeff 1
        = (q.den : ℤ) := by
      simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
        Polynomial.coeff_C, mul_one]
      norm_num
    intro hzero
    rw [hzero] at hco
    simp only [Polynomial.coeff_zero] at hco
    exact q.den_nz (by exact_mod_cast hco.symm)
  · rw [map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, Polynomial.aeval_C,
      eq_intCast, eq_intCast]
    push_cast
    linear_combination q.mul_den_eq_num

/-- **An explicit transcendental real number.**  The Liouville number of base two is transcendental
over the integers, hence over the rationals. -/
theorem exists_transcendental_real : ∃ x : ℝ, Transcendental ℚ x := by
  refine ⟨liouvilleNumber (2 : ℕ), ?_⟩
  have h : Transcendental ℤ (liouvilleNumber ((2 : ℕ) : ℝ)) :=
    transcendental_liouvilleNumber (m := 2) le_rfl
  exact (IsAlgebraic.transcendental_iff (R := ℤ) (S := ℚ)).mp h

/-! ### The witness at `π` -/

/-- **`B_dep` has linear invariant two.**  `π` and `π ^ 2` are rationally independent. -/
theorem linearIndependent_pair_pi_sq :
    LinearIndependent ℚ ![Real.pi, Real.pi ^ 2] :=
  linearIndependent_pair_sq_of_irrational irrational_pi

/-- **`B_dep` has algebraic invariant at most one.**  `π ^ 2` lies in the algebra generated by
`π`. -/
theorem pi_sq_mem_adjoin_pi :
    Real.pi ^ 2 ∈ Algebra.adjoin ℚ ({Real.pi} : Set ℝ) :=
  Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton ℚ Real.pi) 2

theorem trdeg_adjoin_pi_pair_le_one :
    Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range ![Real.pi, Real.pi ^ 2])) ≤ 1 :=
  trdeg_adjoin_pair_sq_le_one Real.pi

/-- **The two tiers are decoupled.**  There is a rationally independent pair — linear invariant
two, so no single rational line — whose generated algebra has transcendence degree exactly one. -/
theorem exists_linearIndependent_pair_trdeg_one :
    ∃ L : Fin 2 → ℝ, LinearIndependent ℚ L ∧
      Algebra.trdeg ℚ (Algebra.adjoin ℚ (Set.range L)) = 1 := by
  obtain ⟨x, hx⟩ := exists_transcendental_real
  refine ⟨![x, x ^ 2], ?_, trdeg_adjoin_pair_sq_eq_one hx⟩
  exact linearIndependent_pair_sq_of_irrational hx.irrational

end GaloisForLFunctions.HTGeometry
