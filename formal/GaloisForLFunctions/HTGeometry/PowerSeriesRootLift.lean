import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.RingTheory.PowerSeries.Inverse

/-!
# Simple roots lift to power-series roots

A monic polynomial over `K⟦t⟧` whose reduction at `t = 0` has a simple root at `a₀` has a root in
`K⟦t⟧` with constant term `a₀`.

This is the unramified base case of the Newton–Puiseux construction, and it is Hensel's lemma:
`K⟦t⟧` is adically complete for the ideal generated by `t`, hence Henselian there, and a simple
root of the reduction is exactly the Henselian input.  The ramified case — where the branches have
fractional exponents — is not covered and needs the Newton polygon.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial PowerSeries

variable {K : Type} [Field K]

/-- Evaluation commutes with reduction at `t = 0`. -/
theorem constantCoeff_eval (f : (PowerSeries K)[X]) (r : PowerSeries K) :
    (PowerSeries.constantCoeff (R := K)) (f.eval r)
      = (f.map ((PowerSeries.constantCoeff (R := K)))).eval ((PowerSeries.constantCoeff (R := K)) r) := by
  simp [Polynomial.eval_map, Polynomial.eval₂_at_apply]

/-- Membership in the ideal generated by `t` is vanishing of the constant term. -/
theorem mem_span_X_iff {g : PowerSeries K} :
    g ∈ Ideal.span {(PowerSeries.X : PowerSeries K)} ↔ (PowerSeries.constantCoeff (R := K)) g = 0 := by
  rw [Ideal.mem_span_singleton]
  exact PowerSeries.X_dvd_iff

/-- **A simple root of the reduction lifts to a power-series root.** -/
theorem exists_isRoot_powerSeries (f : (PowerSeries K)[X]) (hf : f.Monic) (a₀ : K)
    (hroot : (f.map ((PowerSeries.constantCoeff (R := K)))).eval a₀ = 0)
    (hsimple : (f.map ((PowerSeries.constantCoeff (R := K)))).derivative.eval a₀ ≠ 0) :
    ∃ a : PowerSeries K, f.IsRoot a ∧ (PowerSeries.constantCoeff (R := K)) a = a₀ := by
  classical
  set I : Ideal (PowerSeries K) := Ideal.span {(PowerSeries.X : PowerSeries K)} with hI
  have hconst : (PowerSeries.constantCoeff (R := K)) ((PowerSeries.C (R := K) a₀)) = a₀ := by simp
  -- the value at the constant series reduces to the value at `a₀`
  have hval : f.eval ((PowerSeries.C (R := K) a₀)) ∈ I := by
    rw [hI, mem_span_X_iff, constantCoeff_eval, hconst]
    exact hroot
  -- the derivative is a unit, because its constant term is nonzero
  have hderiv : IsUnit (f.derivative.eval ((PowerSeries.C (R := K) a₀))) := by
    rw [PowerSeries.isUnit_iff_constantCoeff, constantCoeff_eval, hconst,
      ← Polynomial.derivative_map]
    exact (isUnit_iff_ne_zero).mpr hsimple
  obtain ⟨a, ha, hdiff⟩ :=
    HenselianRing.is_henselian (R := PowerSeries K) (I := I) f hf ((PowerSeries.C (R := K) a₀)) hval
      (hderiv.map (Ideal.Quotient.mk I))
  refine ⟨a, ha, ?_⟩
  have hsub := (mem_span_X_iff (K := K)).mp hdiff
  rw [map_sub, hconst] at hsub
  exact sub_eq_zero.mp hsub

end GaloisForLFunctions.HTGeometry
