import GaloisForLFunctions.HTGeometry.BarnesAnnihilatorTheorem
import GaloisForLFunctions.HTGeometry.NormalCrossingFaceMatrixFactorization
import GaloisForLFunctions.HTGeometry.PrincipalQuotientBaseChangeTor
import Mathlib.Algebra.MonoidAlgebra.Degree

/-!
# Barnes source-face Tor law

The exact Barnes differential-translation annihilator is the principal normal-crossing relation
`fullLadder N = ∏ j (T_j - 1)` in the domain
`MvPolynomial (Fin N) (Polynomial ℂ)`.  Its orbit module is therefore the principal quotient.

For every nonempty set `S` of source faces, quotienting by the corresponding factors kills the
full ladder relation.  The actual length-one free resolution consequently base-changes to

```text
0 → B_S --0→ B_S → 0,
```

so Tor is `B_S` in degrees zero and one and is zero in all higher degrees.  The selected-face
factorization is also instantiated with the genuine Barnes complementary ladder and source factor.
-/

open scoped Differential BigOperators

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic zeroNomeScalarTower

/-- The constant-coefficient differential-translation operator ring of an `N`-period Barnes
source.  `Polynomial ℂ` is the differential-operator coefficient ring and the multivariables are
the commuting translations. -/
abbrev barnesDiffTranslationRing (N : ℕ) :=
  MvPolynomial (Fin N) (Polynomial ℂ)

/-- The Barnes orbit module defined by its exact principal differential-translation annihilator. -/
abbrev barnesAnnihilatorModule (N : ℕ) :=
  barnesDiffTranslationRing N ⧸
    Ideal.span ({fullLadder N} : Set (barnesDiffTranslationRing N))

/-- The ideal generated by a finite set of source-face equations `T_j - 1`. -/
def barnesSourceFaceIdeal {N : ℕ} (S : Finset (Fin N)) :
    Ideal (barnesDiffTranslationRing N) :=
  Ideal.span ((fun j : Fin N =>
    (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)) '' (S : Set (Fin N)))

/-- The coordinate algebra of the Barnes source face `S`. -/
abbrev barnesSourceFaceAlgebra {N : ℕ} (S : Finset (Fin N)) :=
  barnesDiffTranslationRing N ⧸ barnesSourceFaceIdeal S

/-- The full Barnes ladder relation is nonzero in the differential-translation operator domain. -/
theorem fullLadder_ne_zero (N : ℕ) :
    (fullLadder N : barnesDiffTranslationRing N) ≠ 0 := by
  intro h
  have he := congrArg
    (MvPolynomial.eval (fun _ : Fin N => (0 : Polynomial ℂ))) h
  simp [fullLadder] at he

/-- The complementary Barnes ladder is nonzero. -/
theorem complementaryLadder_ne_zero {N : ℕ} (j : Fin N) :
    (complementaryLadder j : barnesDiffTranslationRing N) ≠ 0 := by
  intro h
  have he := congrArg
    (MvPolynomial.eval (fun _ : Fin N => (0 : Polynomial ℂ))) h
  simp [complementaryLadder] at he

/-- Every source factor `T_j - 1` is nonzero. -/
theorem barnesSourceFactor_ne_zero {N : ℕ} (j : Fin N) :
    (MvPolynomial.X j - 1 : barnesDiffTranslationRing N) ≠ 0 := by
  intro h
  have he := congrArg
    (MvPolynomial.eval (fun _ : Fin N => (0 : Polynomial ℂ))) h
  simp at he

/-- The principal quotient presentation of the Barnes orbit module has its genuine length-one
free resolution. -/
theorem barnesAnnihilatorModule_freeResolution_exact (N : ℕ) :
    Function.Injective
        (principalResolutionDifferential
          (A := barnesDiffTranslationRing N) (fullLadder N)) ∧
      LinearMap.range
          (principalResolutionDifferential
            (A := barnesDiffTranslationRing N) (fullLadder N)) =
        LinearMap.ker
          (principalResolutionAugmentation
            (A := barnesDiffTranslationRing N) (fullLadder N)) ∧
      Function.Surjective
        (principalResolutionAugmentation
          (A := barnesDiffTranslationRing N) (fullLadder N)) :=
  principalQuotient_freeResolution_exact (fullLadder N) (fullLadder_ne_zero N)

/-- A nonempty source face kills the full normal-crossing relation. -/
theorem fullLadder_mem_barnesSourceFaceIdeal {N : ℕ} {S : Finset (Fin N)}
    (hS : S.Nonempty) :
    fullLadder N ∈ barnesSourceFaceIdeal S := by
  obtain ⟨j, hj⟩ := hS
  rw [← X_sub_one_mul_complementaryLadder j]
  apply Ideal.mul_mem_right
  apply Ideal.subset_span
  exact ⟨j, hj, rfl⟩

/-- In the coordinate algebra of every nonempty source face, the Barnes relation is zero. -/
theorem algebraMap_fullLadder_barnesSourceFaceAlgebra_eq_zero
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
    algebraMap (barnesDiffTranslationRing N) (barnesSourceFaceAlgebra S) (fullLadder N) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (fullLadder_mem_barnesSourceFaceIdeal hS)

/-- Tor of the Barnes annihilator module against a source face, computed from its proved
length-one free resolution. -/
abbrev barnesSourceFaceTor {N : ℕ} (S : Finset (Fin N)) (i : ℕ) :=
  principalBaseChangeTor
    (A := barnesDiffTranslationRing N) (B := barnesSourceFaceAlgebra S) (fullLadder N) i

/-- **Barnes face Betti law, degree zero.** -/
noncomputable def barnesSourceFaceTor_zero_equiv
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
  barnesSourceFaceTor S 0 ≃ₗ[barnesSourceFaceAlgebra S]
      barnesSourceFaceAlgebra S :=
  principalBaseChangeTor_zero_equiv
    (A := barnesDiffTranslationRing N) (B := barnesSourceFaceAlgebra S) (fullLadder N)
    (algebraMap_fullLadder_barnesSourceFaceAlgebra_eq_zero hS)

/-- **Barnes face Betti law, degree one.** -/
noncomputable def barnesSourceFaceTor_one_equiv
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
  barnesSourceFaceTor S 1 ≃ₗ[barnesSourceFaceAlgebra S]
      barnesSourceFaceAlgebra S :=
  principalBaseChangeTor_one_equiv
    (A := barnesDiffTranslationRing N) (B := barnesSourceFaceAlgebra S) (fullLadder N)
    (algebraMap_fullLadder_barnesSourceFaceAlgebra_eq_zero hS)

/-- **Barnes face Betti law, all higher degrees.** -/
theorem barnesSourceFaceTor_subsingleton_of_two_le
    {N : ℕ} (S : Finset (Fin N)) (i : ℕ) (hi : 2 ≤ i) :
    Subsingleton (barnesSourceFaceTor S i) :=
  principalBaseChangeTor_subsingleton_of_two_le
    (A := barnesDiffTranslationRing N) (B := barnesSourceFaceAlgebra S) (fullLadder N) i hi

/-- The selected Barnes source factor and its complementary ladder cut out the same principal
quotient as the full ladder relation. -/
noncomputable def barnesSelectedFaceFactorModuleEquiv {N : ℕ} (j : Fin N) :
    normalCrossingFactorModule
        (complementaryLadder j)
        (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)
      ≃ₐ[barnesDiffTranslationRing N] barnesAnnihilatorModule N :=
  Ideal.quotientEquivAlgOfEq (barnesDiffTranslationRing N) <| by
    rw [mul_comm, X_sub_one_mul_complementaryLadder]

/-- **Exact two-periodic Barnes source-face factorization.** -/
theorem barnesSelectedFaceFactorization_twoPeriodicExact
    {N : ℕ} (j : Fin N) :
    LinearMap.range
        (normalCrossingLeftFactor
          (complementaryLadder j)
          (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)) =
      LinearMap.ker
        (normalCrossingRightFactor
          (complementaryLadder j)
          (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)) ∧
    LinearMap.range
        (normalCrossingRightFactor
          (complementaryLadder j)
          (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)) =
      LinearMap.ker
        (normalCrossingLeftFactor
          (complementaryLadder j)
          (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)) :=
  normalCrossingFactorization_twoPeriodicExact
    (complementaryLadder j)
    (MvPolynomial.X j - 1 : barnesDiffTranslationRing N)
    (complementaryLadder_ne_zero j) (barnesSourceFactor_ne_zero j)

/-! ## The exact Laurent operator ring appearing in the paper statement -/

/-- `ℂ[δ,T₁^{±1},…,T_N^{±1}]`, represented as the group algebra of the free exponent lattice
with coefficient ring `ℂ[δ]`. -/
abbrev barnesLaurentDiffTranslationRing (N : ℕ) :=
  AddMonoidAlgebra (Polynomial ℂ) (Fin N →₀ ℤ)

/-- The invertible Laurent translation monomial `T_j`. -/
def barnesLaurentTranslation {N : ℕ} (j : Fin N) :
    barnesLaurentDiffTranslationRing N :=
  AddMonoidAlgebra.single (Finsupp.single j 1) 1

/-- Inclusion of nonnegative exponent vectors into the Laurent exponent lattice. -/
def barnesNatExponentEmbedding (N : ℕ) :
    (Fin N →₀ ℕ) →+ (Fin N →₀ ℤ) :=
  Finsupp.mapRange.addMonoidHom Int.ofNatHom.toAddMonoidHom

/-- The faithful inclusion of polynomial translation operators into Laurent translation
operators. -/
def barnesPolynomialToLaurent (N : ℕ) :
    barnesDiffTranslationRing N →+* barnesLaurentDiffTranslationRing N :=
  AddMonoidAlgebra.mapDomainRingHom (Polynomial ℂ) (barnesNatExponentEmbedding N)

/-- Nonnegative exponent vectors embed faithfully in the Laurent exponent lattice. -/
theorem barnesNatExponentEmbedding_injective (N : ℕ) :
    Function.Injective (barnesNatExponentEmbedding N) := by
  intro a b hab
  ext j
  have hj := congrArg (fun e : Fin N →₀ ℤ => e j) hab
  simpa [barnesNatExponentEmbedding] using hj

/-- Polynomial differential-translation operators embed faithfully into the Laurent operator
ring. -/
theorem barnesPolynomialToLaurent_injective (N : ℕ) :
    Function.Injective (barnesPolynomialToLaurent N) := by
  intro P Q hPQ
  change AddMonoidAlgebra.mapDomain (barnesNatExponentEmbedding N) P =
    AddMonoidAlgebra.mapDomain (barnesNatExponentEmbedding N) Q at hPQ
  exact AddMonoidAlgebra.mapDomain_injective
    (R := Polynomial ℂ) (barnesNatExponentEmbedding_injective N) hPQ

/-- The polynomial translation variable maps to the corresponding Laurent unit monomial. -/
theorem barnesPolynomialToLaurent_X {N : ℕ} (j : Fin N) :
    barnesPolynomialToLaurent N (MvPolynomial.X j) =
      barnesLaurentTranslation j := by
  rw [barnesPolynomialToLaurent, MvPolynomial.X,
    AddMonoidAlgebra.mapDomainRingHom_apply,
    ← MvPolynomial.single_eq_monomial,
    AddMonoidAlgebra.mapDomain_single, barnesLaurentTranslation]
  congr 1
  ext k
  simp [barnesNatExponentEmbedding]

/-- The Laurent source-face equation `x_j = T_j - 1`. -/
def barnesLaurentSourceFactor {N : ℕ} (j : Fin N) :
    barnesLaurentDiffTranslationRing N :=
  barnesLaurentTranslation j - 1

/-- The Laurent normal-crossing relation `f_N = ∏_j (T_j - 1)`. -/
def barnesLaurentFullLadder (N : ℕ) : barnesLaurentDiffTranslationRing N :=
  ∏ j, barnesLaurentSourceFactor j

/-- The exact polynomial Barnes relation maps to the exact Laurent relation of the paper. -/
theorem barnesPolynomialToLaurent_fullLadder (N : ℕ) :
    barnesPolynomialToLaurent N (fullLadder N) =
      barnesLaurentFullLadder N := by
  rw [fullLadder, barnesLaurentFullLadder, map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [map_sub, map_one, barnesPolynomialToLaurent_X,
    barnesLaurentSourceFactor]

/-- Extending the exact polynomial Barnes annihilator to the Laurent operator ring gives exactly
the principal Laurent ideal `(f_N)`—no additional relation is inserted during localization. -/
theorem barnesPolynomialAnnihilator_map_eq_laurent (N : ℕ) :
    Ideal.map (barnesPolynomialToLaurent N)
        (Ideal.span ({fullLadder N} : Set (barnesDiffTranslationRing N))) =
      Ideal.span ({barnesLaurentFullLadder N} :
        Set (barnesLaurentDiffTranslationRing N)) := by
  rw [Ideal.map_span, Set.image_singleton,
    barnesPolynomialToLaurent_fullLadder]

/-- The complementary Laurent factor `p_j = ∏_{k ≠ j} (T_k - 1)`. -/
def barnesLaurentComplementaryLadder {N : ℕ} (j : Fin N) :
    barnesLaurentDiffTranslationRing N :=
  ∏ k ∈ Finset.univ.erase j, barnesLaurentSourceFactor k

/-- A Laurent translation monomial is not the identity monomial. -/
theorem barnesLaurentTranslation_ne_one {N : ℕ} (j : Fin N) :
    barnesLaurentTranslation j ≠
      (1 : barnesLaurentDiffTranslationRing N) := by
  intro h
  have hne : (Finsupp.single j 1 : Fin N →₀ ℤ) ≠ 0 := by simp
  have he := congrArg
    (fun P : barnesLaurentDiffTranslationRing N =>
      P.coeff (Finsupp.single j 1)) h
  rw [barnesLaurentTranslation, AddMonoidAlgebra.coeff_single,
    show (1 : barnesLaurentDiffTranslationRing N) =
      AddMonoidAlgebra.single 0 1 from rfl,
    AddMonoidAlgebra.coeff_single] at he
  simp [hne] at he

/-- Every Laurent source factor is nonzero. -/
theorem barnesLaurentSourceFactor_ne_zero {N : ℕ} (j : Fin N) :
    barnesLaurentSourceFactor j ≠ 0 := by
  rw [barnesLaurentSourceFactor, sub_ne_zero]
  exact barnesLaurentTranslation_ne_one j

/-- The Laurent normal-crossing relation is nonzero. -/
theorem barnesLaurentFullLadder_ne_zero (N : ℕ) :
    barnesLaurentFullLadder N ≠ 0 := by
  rw [barnesLaurentFullLadder, Finset.prod_ne_zero_iff]
  exact fun j _ => barnesLaurentSourceFactor_ne_zero j

/-- Every complementary Laurent ladder is nonzero. -/
theorem barnesLaurentComplementaryLadder_ne_zero {N : ℕ} (j : Fin N) :
    barnesLaurentComplementaryLadder j ≠ 0 := by
  rw [barnesLaurentComplementaryLadder, Finset.prod_ne_zero_iff]
  exact fun k _ => barnesLaurentSourceFactor_ne_zero k

/-- The selected Laurent source factor times its complement is the full relation. -/
theorem barnesLaurentSourceFactor_mul_complementaryLadder {N : ℕ} (j : Fin N) :
    barnesLaurentSourceFactor j * barnesLaurentComplementaryLadder j =
      barnesLaurentFullLadder N :=
  Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j)

/-- The orbit module over the exact Laurent differential-translation ring. -/
abbrev barnesLaurentAnnihilatorModule (N : ℕ) :=
  barnesLaurentDiffTranslationRing N ⧸
    Ideal.span ({barnesLaurentFullLadder N} :
      Set (barnesLaurentDiffTranslationRing N))

/-- The Laurent ideal generated by a finite set of source faces. -/
def barnesLaurentSourceFaceIdeal {N : ℕ} (S : Finset (Fin N)) :
    Ideal (barnesLaurentDiffTranslationRing N) :=
  Ideal.span (barnesLaurentSourceFactor '' (S : Set (Fin N)))

/-- Laurent coordinate algebra `B_S = D_N/(x_j : j ∈ S)`. -/
abbrev barnesLaurentSourceFaceAlgebra {N : ℕ} (S : Finset (Fin N)) :=
  barnesLaurentDiffTranslationRing N ⧸ barnesLaurentSourceFaceIdeal S

/-- The Laurent Barnes module has the genuine length-one principal free resolution. -/
theorem barnesLaurentAnnihilatorModule_freeResolution_exact (N : ℕ) :
    Function.Injective
        (principalResolutionDifferential
          (A := barnesLaurentDiffTranslationRing N) (barnesLaurentFullLadder N)) ∧
      LinearMap.range
          (principalResolutionDifferential
            (A := barnesLaurentDiffTranslationRing N) (barnesLaurentFullLadder N)) =
        LinearMap.ker
          (principalResolutionAugmentation
            (A := barnesLaurentDiffTranslationRing N) (barnesLaurentFullLadder N)) ∧
      Function.Surjective
        (principalResolutionAugmentation
          (A := barnesLaurentDiffTranslationRing N) (barnesLaurentFullLadder N)) :=
  principalQuotient_freeResolution_exact _ (barnesLaurentFullLadder_ne_zero N)

/-- Every nonempty Laurent source face kills the full relation. -/
theorem barnesLaurentFullLadder_mem_sourceFaceIdeal
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
    barnesLaurentFullLadder N ∈ barnesLaurentSourceFaceIdeal S := by
  obtain ⟨j, hj⟩ := hS
  rw [← barnesLaurentSourceFactor_mul_complementaryLadder j]
  apply Ideal.mul_mem_right
  apply Ideal.subset_span
  exact ⟨j, hj, rfl⟩

/-- The Laurent normal-crossing relation maps to zero on every nonempty source face. -/
theorem mk_barnesLaurentFullLadder_face_eq_zero
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
    Ideal.Quotient.mk (barnesLaurentSourceFaceIdeal S)
        (barnesLaurentFullLadder N) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr
    (barnesLaurentFullLadder_mem_sourceFaceIdeal hS)

/-- Tor of the exact Laurent Barnes module against a source face. -/
abbrev barnesLaurentSourceFaceTor {N : ℕ} (S : Finset (Fin N)) (i : ℕ) :=
  principalBaseChangeTor
    (A := barnesLaurentDiffTranslationRing N)
    (B := barnesLaurentSourceFaceAlgebra S) (barnesLaurentFullLadder N) i

/-- **Exact Laurent Barnes face law in degree zero.** -/
noncomputable def barnesLaurentSourceFaceTor_zero_equiv
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
    barnesLaurentSourceFaceTor S 0 ≃ₗ[barnesLaurentSourceFaceAlgebra S]
      barnesLaurentSourceFaceAlgebra S :=
  principalBaseChangeTor_zero_equiv
    (A := barnesLaurentDiffTranslationRing N)
    (B := barnesLaurentSourceFaceAlgebra S) (barnesLaurentFullLadder N)
    (by
      change Ideal.Quotient.mk (barnesLaurentSourceFaceIdeal S)
        (barnesLaurentFullLadder N) = 0
      exact mk_barnesLaurentFullLadder_face_eq_zero hS)

/-- **Exact Laurent Barnes face law in degree one.** -/
noncomputable def barnesLaurentSourceFaceTor_one_equiv
    {N : ℕ} {S : Finset (Fin N)} (hS : S.Nonempty) :
    barnesLaurentSourceFaceTor S 1 ≃ₗ[barnesLaurentSourceFaceAlgebra S]
      barnesLaurentSourceFaceAlgebra S :=
  principalBaseChangeTor_one_equiv
    (A := barnesLaurentDiffTranslationRing N)
    (B := barnesLaurentSourceFaceAlgebra S) (barnesLaurentFullLadder N)
    (by
      change Ideal.Quotient.mk (barnesLaurentSourceFaceIdeal S)
        (barnesLaurentFullLadder N) = 0
      exact mk_barnesLaurentFullLadder_face_eq_zero hS)

/-- **Exact Laurent Barnes face law in every higher degree.** -/
theorem barnesLaurentSourceFaceTor_subsingleton_of_two_le
    {N : ℕ} (S : Finset (Fin N)) (i : ℕ) (hi : 2 ≤ i) :
    Subsingleton (barnesLaurentSourceFaceTor S i) :=
  principalBaseChangeTor_subsingleton_of_two_le
    (A := barnesLaurentDiffTranslationRing N)
    (B := barnesLaurentSourceFaceAlgebra S) (barnesLaurentFullLadder N) i hi

/-- The selected Laurent matrix-factorization module is canonically the Laurent Barnes module. -/
noncomputable def barnesLaurentSelectedFaceFactorModuleEquiv {N : ℕ} (j : Fin N) :
    normalCrossingFactorModule
        (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)
      ≃ₐ[barnesLaurentDiffTranslationRing N] barnesLaurentAnnihilatorModule N :=
  Ideal.quotientEquivAlgOfEq (barnesLaurentDiffTranslationRing N) <| by
    rw [mul_comm, barnesLaurentSourceFactor_mul_complementaryLadder]

/-- **Exact two-periodic factorization in the Laurent operator ring of the card.** -/
theorem barnesLaurentSelectedFaceFactorization_twoPeriodicExact
    {N : ℕ} (j : Fin N) :
    LinearMap.range
        (normalCrossingLeftFactor
          (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)) =
      LinearMap.ker
        (normalCrossingRightFactor
          (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)) ∧
    LinearMap.range
        (normalCrossingRightFactor
          (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)) =
      LinearMap.ker
        (normalCrossingLeftFactor
          (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)) :=
  normalCrossingFactorization_twoPeriodicExact
    (barnesLaurentComplementaryLadder j) (barnesLaurentSourceFactor j)
    (barnesLaurentComplementaryLadder_ne_zero j)
    (barnesLaurentSourceFactor_ne_zero j)

/-- **The actual Barnes source has the principal annihilator used by the face-resolution
calculation.** -/
theorem barnesDiffAnnihilator_eq_principalIdeal [NeZero N] (ω : Fin N → ℂ)
    (hω : ∀ i, 0 < (ω i).im)
    (hindep : ∀ n : Fin N → ℤ, ∑ k, (n k : ℂ) * ω k = 0 → ∀ k, n k = 0) :
    {P : barnesDiffTranslationRing N |
        DifferentialAlgebraicOver (RatFunc ℂ)
          (diffTranslateApply ω P (barnesSourceLogDerivMero ω hω))} =
      (Ideal.span ({fullLadder N} : Set (barnesDiffTranslationRing N)) :
        Set (barnesDiffTranslationRing N)) := by
  ext P
  rw [Set.mem_setOf_eq, SetLike.mem_coe,
    differentialAlgebraicOver_diffTranslateApply_barnesSource_iff ω hω hindep,
    Ideal.mem_span_singleton]

end

end GaloisForLFunctions.HTGeometry
