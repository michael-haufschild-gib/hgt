import GaloisForLFunctions.HTGeometry.RamifiedMultiGradedNewtonModelBase
import GaloisForLFunctions.HTGeometry.AlgebraicDerivationMapUniqueness
import GaloisForLFunctions.HTGeometry.HyperexponentialPrimitive
import GaloisForLFunctions.HTGeometry.StateFieldTrdeg

/-!
# Ramified Puiseux branches over a differential coefficient field

Nonautonomous composition uses a coefficient field containing the independent clock, so the time
derivation does not kill coefficients.  This module constructs the intrinsic algebraic branch field
over such a coefficient field, restricts both coordinate and total time derivations to it, and
transfers the coefficient-generic Hahn observability theorem to every selected realization.
-/

noncomputable section

namespace GaloisForLFunctions.HTGeometry

open HahnSeries

/-- Rational field over `K` generated by all original ramified coordinates. -/
abbrev RamifiedCoordinateFieldBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) :=
  IntermediateField.adjoin K (Set.range (hahnFractionRamCoordinateBase K r))

/-- Relative algebraic closure of the generic coordinate field in its Hahn fraction field. -/
abbrev RamifiedPuiseuxBranchFieldBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) :=
  algebraicClosure (RamifiedCoordinateFieldBase K r) (HahnFraction (mgDeg N) K)

/-- Inclusion of the generic branch field into the ambient Hahn fraction field. -/
noncomputable def ramifiedPuiseuxBranchEmbeddingBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) :
    RamifiedPuiseuxBranchFieldBase K r →ₐ[K] HahnFraction (mgDeg N) K :=
  (RamifiedPuiseuxBranchFieldBase K r).restrictScalars K |>.val

/-- A ramified coordinate inside the generic branch field. -/
noncomputable def ramifiedCoordinateInBranchFieldBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) (k : Fin N) :
    RamifiedPuiseuxBranchFieldBase K r :=
  ⟨hahnFractionRamCoordinateBase K r k, by
    exact mem_algebraicClosure_restrictScalars_of_mem (RamifiedCoordinateFieldBase K r)
      (IntermediateField.subset_adjoin K _ (Set.mem_range_self k))⟩

@[simp] theorem ramifiedPuiseuxBranchEmbeddingBase_coordinate
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ) (k : Fin N) :
    ramifiedPuiseuxBranchEmbeddingBase K r (ramifiedCoordinateInBranchFieldBase K r k) =
      hahnFractionRamCoordinateBase K r k := rfl

/-- A selected velocity branch inside the generic algebraic branch field. -/
noncomputable def ramifiedVelocityInBranchFieldBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j)) (j : Fin N) :
    RamifiedPuiseuxBranchFieldBase K r :=
  ⟨A j, mem_algebraicClosure_iff.mpr (hAlg j)⟩

/-- Selected suffix velocity product inside the generic branch field. -/
noncomputable def ramifiedSuffixProductInBranchFieldBase
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j)) (k : ℕ) :
    RamifiedPuiseuxBranchFieldBase K r :=
  ∏ j ∈ Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ)),
    ramifiedVelocityInBranchFieldBase K r A hAlg j

@[simp] theorem ramifiedSuffixProductInBranchFieldBase_coe
    (K : Type*) [Field K] {N : ℕ} (r : Fin N → ℕ)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j)) (k : ℕ) :
    ((ramifiedSuffixProductInBranchFieldBase K r A hAlg k :
        RamifiedPuiseuxBranchFieldBase K r) : HahnFraction (mgDeg N) K) =
      hahnFractionRamSuffixProductBase A k := by
  simp [ramifiedSuffixProductInBranchFieldBase, ramifiedVelocityInBranchFieldBase,
    hahnFractionRamSuffixProductBase]

/-! ## Restricted coordinate derivations -/

/-- Every generic ramified coordinate derivation preserves the intrinsic branch field. -/
theorem hahnFractionRamPartialBase_mem_ramifiedPuiseuxBranchFieldBase
    (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i) (j : Fin N)
    {y : HahnFraction (mgDeg N) K} (hy : y ∈ RamifiedPuiseuxBranchFieldBase K r) :
    hahnFractionRamPartialBase K r j y ∈ RamifiedPuiseuxBranchFieldBase K r := by
  letI : CharZero (HahnFraction (mgDeg N) K) :=
    charZero_of_injective_algebraMap
      (algebraMap K (HahnFraction (mgDeg N) K)).injective
  apply derivationBase_mem_algebraicClosure_adjoin
    (hahnFractionRamPartialBase K r j)
    (S := Set.range (hahnFractionRamCoordinateBase K r))
  · intro x hx
    rcases hx with ⟨k, rfl⟩
    rw [hahnFractionRamPartialBase_coordinate K r hr]
    exact IntermediateField.algebraMap_mem (RamifiedCoordinateFieldBase K r) _
  · exact hy

/-- Generic coordinate derivation restricted to the branch field. -/
noncomputable def ramifiedPuiseuxBranchPartialBase
    (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i) (j : Fin N) :
    Derivation K (RamifiedPuiseuxBranchFieldBase K r)
      (RamifiedPuiseuxBranchFieldBase K r) :=
  restrictDerivation (hahnFractionRamPartialBase K r j)
    ((RamifiedPuiseuxBranchFieldBase K r).restrictScalars K)
    (fun _ hy => hahnFractionRamPartialBase_mem_ramifiedPuiseuxBranchFieldBase K r hr j hy)

@[simp] theorem ramifiedPuiseuxBranchPartialBase_coe
    (K : Type*) [Field K] [CharZero K] {N : ℕ}
    (r : Fin N → ℕ) (hr : ∀ i, 0 < r i) (j : Fin N)
    (y : RamifiedPuiseuxBranchFieldBase K r) :
    ((ramifiedPuiseuxBranchPartialBase K r hr j y :
        RamifiedPuiseuxBranchFieldBase K r) : HahnFraction (mgDeg N) K) =
      hahnFractionRamPartialBase K r j (y : HahnFraction (mgDeg N) K) := rfl

/-! ## Restricted nonautonomous cascade derivation -/

/-- Total time derivation preserves the intrinsic branch field. -/
theorem hahnFractionRamCascadeDifferentialDerivation_mem_branchFieldBase
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j))
    {y : HahnFraction (mgDeg N) K} (hy : y ∈ RamifiedPuiseuxBranchFieldBase K r) :
    hahnFractionRamCascadeDifferentialDerivation C K dK r A y ∈
      RamifiedPuiseuxBranchFieldBase K r := by
  classical
  let H := HahnFraction (mgDeg N) K
  let E := RamifiedCoordinateFieldBase K r
  let B := RamifiedPuiseuxBranchFieldBase K r
  let D := hahnFractionRamCascadeDifferentialDerivation C K dK r A
  letI : CharZero H := charZero_of_injective_algebraMap (algebraMap K H).injective
  have hA : ∀ j, A j ∈ B := fun j => mem_algebraicClosure_iff.mpr (hAlg j)
  have hQ : ∀ k, hahnFractionRamSuffixProductBase A k ∈ B := by
    intro k
    rw [hahnFractionRamSuffixProductBase]
    induction (Finset.univ.filter (fun j : Fin N => k ≤ (j : ℕ))) using
        Finset.induction_on with
    | empty => exact one_mem B
    | @insert j s hjs ih =>
        rw [Finset.prod_insert hjs]
        exact mul_mem (hA j) ih
  have hE : ∀ z : H, z ∈ E → D z ∈ B := by
    intro z hz
    exact (derivationInt_mem_of_mem_adjoin (toIntDerivation D)
      (M := B.restrictScalars K)
      (fun c => by
        rw [show toIntDerivation D (algebraMap K H c) = D (algebraMap K H c) from rfl,
          hahnFractionRamCascadeDifferentialDerivation_coeffAlgebraMap]
        exact mem_algebraicClosure_restrictScalars_of_mem E
          (IntermediateField.algebraMap_mem E (dK c)))
      (fun x hx => by
        rcases hx with ⟨k, rfl⟩
        constructor
        · exact mem_algebraicClosure_restrictScalars_of_mem E
            (IntermediateField.subset_adjoin K _ (Set.mem_range_self k))
        · rw [show toIntDerivation D (hahnFractionRamCoordinateBase K r k) =
              D (hahnFractionRamCoordinateBase K r k) from rfl,
            hahnFractionRamCascadeDifferentialDerivation_coordinate C K dK r hr A k]
          exact hQ (k : ℕ)) hz).2
  exact derivationInt_mem_algebraicClosure E (toIntDerivation D) (fun z hz => by
    rw [IntermediateField.mem_bot] at hz
    obtain ⟨w, rfl⟩ := hz
    exact hE (w : H) w.2) hy

/-- Total nonautonomous cascade derivation restricted to algebraic branch field. -/
noncomputable def ramifiedPuiseuxBranchDifferentialCascadeDerivation
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j)) :
    Derivation ℤ (RamifiedPuiseuxBranchFieldBase K r)
      (RamifiedPuiseuxBranchFieldBase K r) where
  toFun y :=
    ⟨hahnFractionRamCascadeDifferentialDerivation C K dK r A y,
      hahnFractionRamCascadeDifferentialDerivation_mem_branchFieldBase
        C K dK r hr A hAlg y.2⟩
  map_add' x y := Subtype.ext
    ((hahnFractionRamCascadeDifferentialDerivation C K dK r A).map_add x y)
  map_smul' z y := Subtype.ext (by
    change hahnFractionRamCascadeDifferentialDerivation C K dK r A
        (z • (y : HahnFraction (mgDeg N) K)) =
      z • hahnFractionRamCascadeDifferentialDerivation C K dK r A
        (y : HahnFraction (mgDeg N) K)
    exact map_zsmul (hahnFractionRamCascadeDifferentialDerivation C K dK r A)
      z (y : HahnFraction (mgDeg N) K))
  map_one_eq_zero' := Subtype.ext
    (hahnFractionRamCascadeDifferentialDerivation C K dK r A).map_one_eq_zero
  leibniz' x y := Subtype.ext
    ((hahnFractionRamCascadeDifferentialDerivation C K dK r A).leibniz x y)

@[simp] theorem ramifiedPuiseuxBranchDifferentialCascadeDerivation_coe
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j))
    (y : RamifiedPuiseuxBranchFieldBase K r) :
    ((ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg y :
        RamifiedPuiseuxBranchFieldBase K r) : HahnFraction (mgDeg N) K) =
      hahnFractionRamCascadeDifferentialDerivation C K dK r A
        (y : HahnFraction (mgDeg N) K) := rfl

/-- Restricted total cascade sends each branch coordinate to selected suffix product. -/
theorem ramifiedPuiseuxBranchDifferentialCascadeDerivation_coordinate
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j))
    (k : Fin N) :
    ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg
        (ramifiedCoordinateInBranchFieldBase K r k) =
      ramifiedSuffixProductInBranchFieldBase K r A hAlg (k : ℕ) := by
  apply Subtype.ext
  simpa only [ramifiedPuiseuxBranchDifferentialCascadeDerivation_coe,
    ramifiedSuffixProductInBranchFieldBase_coe,
    ramifiedCoordinateInBranchFieldBase] using
      hahnFractionRamCascadeDifferentialDerivation_coordinate C K dK r hr A k

/-! ## Intrinsic branch-field output jets -/

/-- Iterating the intrinsic branch derivation and then including into the Hahn field agrees with
iterating the ambient total derivation. -/
theorem ramifiedPuiseuxBranchDifferentialCascadeDerivation_iterate_coe
    (C K : Type*) [Field C] [Field K] [Algebra C K] [CharZero K] {N : ℕ}
    (dK : Derivation C K K) (r : Fin N → ℕ) (hr : ∀ i, 0 < r i)
    (A : Fin N → HahnFraction (mgDeg N) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j))
    (m : ℕ) (y : RamifiedPuiseuxBranchFieldBase K r) :
    ramifiedPuiseuxBranchEmbeddingBase K r
        (((ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg :
            RamifiedPuiseuxBranchFieldBase K r → RamifiedPuiseuxBranchFieldBase K r)^[m]) y) =
      ((hahnFractionRamCascadeDifferentialDerivation C K dK r A :
          HahnFraction (mgDeg N) K → HahnFraction (mgDeg N) K)^[m])
        (ramifiedPuiseuxBranchEmbeddingBase K r y) := by
  induction m generalizing y with
  | zero => rfl
  | succ m ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply,
        ih (ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg y)]
      congr 1

/-- **Intrinsic nonautonomous branch observability.** The first `n+1` output jets are
algebraically independent already inside the relative algebraic Puiseux branch field. -/
theorem algebraicIndependent_ramifiedPuiseuxBranchDifferentialCascadeOutputJets
    {C K : Type*} [Field C] [Field K] [Algebra C K] [CharZero K] {n : ℕ}
    (dK : Derivation C K K)
    (r : Fin (n + 1) → ℕ) (hr : ∀ j, 0 < r j)
    (A : Fin (n + 1) → HahnFraction (mgDeg (n + 1)) K)
    (hAlg : ∀ j, IsAlgebraic (RamifiedCoordinateFieldBase K r) (A j))
    (lambda : Fin (n + 1) → K) (hlambda : ∀ j, lambda j ≠ 0)
    (hA : ∀ j, FracHasLeadAt (A j) (mgRamUnit r j) (lambda j)) :
    AlgebraicIndependent K
      (fun j : Fin (n + 1) ↦
        ((ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg :
            RamifiedPuiseuxBranchFieldBase K r → RamifiedPuiseuxBranchFieldBase K r)^[(j : ℕ)])
          (ramifiedCoordinateInBranchFieldBase K r 0)) := by
  apply AlgebraicIndependent.of_comp (ramifiedPuiseuxBranchEmbeddingBase K r)
  have heq :
      (ramifiedPuiseuxBranchEmbeddingBase K r ∘
        fun j : Fin (n + 1) ↦
          ((ramifiedPuiseuxBranchDifferentialCascadeDerivation C K dK r hr A hAlg :
              RamifiedPuiseuxBranchFieldBase K r → RamifiedPuiseuxBranchFieldBase K r)^[(j : ℕ)])
            (ramifiedCoordinateInBranchFieldBase K r 0)) =
        (fun j : Fin (n + 1) ↦
          ((hahnFractionRamCascadeDifferentialDerivation C K dK r A :
              HahnFraction (mgDeg (n + 1)) K → HahnFraction (mgDeg (n + 1)) K)^[(j : ℕ)])
            (hahnFractionRamCoordinateBase K r 0)) := by
    funext j
    exact ramifiedPuiseuxBranchDifferentialCascadeDerivation_iterate_coe
      C K dK r hr A hAlg (j : ℕ) (ramifiedCoordinateInBranchFieldBase K r 0)
  rw [heq]
  exact algebraicIndependent_hahnFractionRamDifferentialCascadeOutputJetsBase
    dK r hr A lambda hlambda hA

end GaloisForLFunctions.HTGeometry
