import GaloisForLFunctions.HTGeometry.ConfocalAbelDefectFlow
import Mathlib.Analysis.Calculus.Deriv.Add
import Mathlib.Analysis.Calculus.Deriv.Inv
import Mathlib.Analysis.Calculus.Deriv.Pow
import Mathlib.Analysis.SpecialFunctions.Sqrt

/-!
# Tomography of an exposed confocal orbit

On an interval where one nonreal coordinate exposes the confocal envelope, the first two radius
derivatives recover its real part and the absolute value of its imaginary part.  This file proves
the derivative formulas and the exact algebraic inverse.
-/

open Filter Topology

namespace HTGeometry

noncomputable section

/-- Distance-sum branch generated by `x + i y`. -/
def confocalBranch (x y R : ℝ) : ℝ :=
  Real.sqrt (x ^ 2 + y ^ 2) + Real.sqrt ((R - x) ^ 2 + y ^ 2)

/-- Slope of the moving-focus part of a nonreal confocal branch. -/
def confocalBranchSlope (x y R : ℝ) : ℝ :=
  (R - x) / Real.sqrt ((R - x) ^ 2 + y ^ 2)

/-- Curvature of the moving-focus part of a nonreal confocal branch. -/
def confocalBranchCurvature (x y R : ℝ) : ℝ :=
  y ^ 2 / Real.sqrt ((R - x) ^ 2 + y ^ 2) ^ 3

private theorem confocalRadicand_pos {x y R : ℝ} (hy : y ≠ 0) :
    0 < (R - x) ^ 2 + y ^ 2 := by
  nlinarith [sq_pos_of_ne_zero hy]

private theorem confocalMovingDistance_pos {x y R : ℝ} (hy : y ≠ 0) :
    0 < Real.sqrt ((R - x) ^ 2 + y ^ 2) :=
  Real.sqrt_pos.2 (confocalRadicand_pos hy)

/-- First derivative of an exposed nonreal confocal branch. -/
theorem hasDerivAt_confocalBranch {x y R : ℝ} (hy : y ≠ 0) :
    HasDerivAt (confocalBranch x y) (confocalBranchSlope x y R) R := by
  have hsub : HasDerivAt (fun T : ℝ => T - x) 1 R := (hasDerivAt_id R).sub_const x
  have hinner : HasDerivAt (fun T : ℝ => (T - x) ^ 2 + y ^ 2) (2 * (R - x)) R := by
    have hc : HasDerivAt (fun _ : ℝ => y ^ 2) 0 R := hasDerivAt_const R _
    have hadd := (hsub.pow 2).add hc
    change HasDerivAt (fun T : ℝ => (T - x) ^ 2 + y ^ 2) ((R - x) * 2 + 0) R at hadd
    convert hadd using 1 <;> ring
  have hsqrt := hinner.sqrt (confocalRadicand_pos hy).ne'
  have hconst : HasDerivAt (fun _ : ℝ => Real.sqrt (x ^ 2 + y ^ 2)) 0 R :=
    hasDerivAt_const R _
  have hcoef : 2 * (R - x) / (2 * Real.sqrt ((R - x) ^ 2 + y ^ 2)) =
      confocalBranchSlope x y R := by
    rw [confocalBranchSlope]
    field_simp [confocalMovingDistance_pos hy |>.ne']
  rw [← hcoef]
  change HasDerivAt
    (fun T : ℝ => Real.sqrt (x ^ 2 + y ^ 2) +
      Real.sqrt ((T - x) ^ 2 + y ^ 2))
    (2 * (R - x) / (2 * Real.sqrt ((R - x) ^ 2 + y ^ 2))) R
  have hadd := hconst.add hsqrt
  change HasDerivAt
    (fun T : ℝ => Real.sqrt (x ^ 2 + y ^ 2) +
      Real.sqrt ((T - x) ^ 2 + y ^ 2))
    (0 + 2 * (R - x) / (2 * Real.sqrt ((R - x) ^ 2 + y ^ 2))) R at hadd
  simpa only [zero_add] using hadd

/-- Derivative of the slope is the positive confocal curvature. -/
theorem hasDerivAt_confocalBranchSlope {x y R : ℝ} (hy : y ≠ 0) :
    HasDerivAt (confocalBranchSlope x y) (confocalBranchCurvature x y R) R := by
  let s : ℝ := Real.sqrt ((R - x) ^ 2 + y ^ 2)
  have hs : 0 < s := by simpa only [s] using confocalMovingDistance_pos hy
  have hs2 : s ^ 2 = (R - x) ^ 2 + y ^ 2 := by
    exact Real.sq_sqrt (confocalRadicand_pos hy).le
  have hsub : HasDerivAt (fun T : ℝ => T - x) 1 R := (hasDerivAt_id R).sub_const x
  have hinner : HasDerivAt (fun T : ℝ => (T - x) ^ 2 + y ^ 2) (2 * (R - x)) R := by
    have hc : HasDerivAt (fun _ : ℝ => y ^ 2) 0 R := hasDerivAt_const R _
    have hadd := (hsub.pow 2).add hc
    change HasDerivAt (fun T : ℝ => (T - x) ^ 2 + y ^ 2) ((R - x) * 2 + 0) R at hadd
    convert hadd using 1 <;> ring
  have hsqrt := hinner.sqrt (confocalRadicand_pos hy).ne'
  have hnum : HasDerivAt (fun T : ℝ => T - x) 1 R := (hasDerivAt_id R).sub_const x
  have hquot := hnum.div hsqrt hs.ne'
  have hcoef : (1 * s - (R - x) * (2 * (R - x) / (2 * s))) / s ^ 2 =
      confocalBranchCurvature x y R := by
    rw [confocalBranchCurvature]
    change (1 * s - (R - x) * (2 * (R - x) / (2 * s))) / s ^ 2 =
      y ^ 2 / s ^ 3
    field_simp [hs.ne']
    nlinarith
  rw [← hcoef]
  change HasDerivAt
    (fun T : ℝ => (T - x) / Real.sqrt ((T - x) ^ 2 + y ^ 2))
    ((1 * s - (R - x) * (2 * (R - x) / (2 * s))) / s ^ 2) R
  exact hquot

theorem confocalBranchCurvature_pos {x y R : ℝ} (hy : y ≠ 0) :
    0 < confocalBranchCurvature x y R := by
  rw [confocalBranchCurvature]
  positivity

/-- The curvature-normalized slope defect is the moving-focus distance. -/
theorem one_sub_confocalBranchSlope_sq_div_curvature
    {x y R : ℝ} (hy : y ≠ 0) :
    (1 - confocalBranchSlope x y R ^ 2) /
        confocalBranchCurvature x y R =
      Real.sqrt ((R - x) ^ 2 + y ^ 2) := by
  let s : ℝ := Real.sqrt ((R - x) ^ 2 + y ^ 2)
  have hs : 0 < s := by simpa only [s] using confocalMovingDistance_pos hy
  have hs2 : s ^ 2 = (R - x) ^ 2 + y ^ 2 :=
    Real.sq_sqrt (confocalRadicand_pos hy).le
  rw [confocalBranchSlope, confocalBranchCurvature]
  change (1 - ((R - x) / s) ^ 2) / (y ^ 2 / s ^ 3) = s
  have hy2 : y ^ 2 ≠ 0 := pow_ne_zero 2 hy
  field_simp [hs.ne', hy2]
  nlinarith

/-- The exposed branch recovers the real coordinate. -/
theorem confocalBranch_reconstruct_re
    {x y R : ℝ} (hy : y ≠ 0) :
    R - ((1 - confocalBranchSlope x y R ^ 2) /
        confocalBranchCurvature x y R) * confocalBranchSlope x y R = x := by
  rw [one_sub_confocalBranchSlope_sq_div_curvature hy, confocalBranchSlope]
  have hs := confocalMovingDistance_pos (x := x) (R := R) hy
  field_simp [hs.ne']
  ring

/-- The exposed branch recovers the absolute imaginary coordinate. -/
theorem confocalBranch_reconstruct_abs_im
    {x y R : ℝ} (hy : y ≠ 0) :
    ((1 - confocalBranchSlope x y R ^ 2) /
        confocalBranchCurvature x y R) *
        Real.sqrt (1 - confocalBranchSlope x y R ^ 2) = |y| := by
  let s : ℝ := Real.sqrt ((R - x) ^ 2 + y ^ 2)
  have hs : 0 < s := by simpa only [s] using confocalMovingDistance_pos hy
  have hs2 : s ^ 2 = (R - x) ^ 2 + y ^ 2 :=
    Real.sq_sqrt (confocalRadicand_pos hy).le
  have hinside : 0 ≤ 1 - confocalBranchSlope x y R ^ 2 := by
    rw [confocalBranchSlope]
    change 0 ≤ 1 - ((R - x) / s) ^ 2
    have : (R - x) ^ 2 ≤ s ^ 2 := by nlinarith [sq_nonneg y]
    apply sub_nonneg.mpr
    rw [div_pow]
    exact (div_le_one (sq_pos_of_pos hs)).2 this
  rw [one_sub_confocalBranchSlope_sq_div_curvature hy]
  let t : ℝ := s * Real.sqrt (1 - confocalBranchSlope x y R ^ 2)
  have ht0 : 0 ≤ t := mul_nonneg hs.le (Real.sqrt_nonneg _)
  have ht2 : t ^ 2 = y ^ 2 := by
    dsimp only [t]
    rw [mul_pow, Real.sq_sqrt hinside]
    rw [confocalBranchSlope]
    change s ^ 2 * (1 - ((R - x) / s) ^ 2) = y ^ 2
    field_simp [hs.ne']
    nlinarith
  have habs0 : 0 ≤ |y| := abs_nonneg y
  have habs2 : |y| ^ 2 = y ^ 2 := sq_abs y
  change t = |y|
  nlinarith

/-- Bundled exposed-orbit inverse in the notation `p=f'`, `q=f''`. -/
theorem confocalBranch_exposed_orbit_tomography
    {x y R : ℝ} (hy : y ≠ 0) :
    let p := confocalBranchSlope x y R
    let q := confocalBranchCurvature x y R
    let s := (1 - p ^ 2) / q
    0 < q ∧ R - s * p = x ∧ s * Real.sqrt (1 - p ^ 2) = |y| := by
  dsimp only
  exact ⟨confocalBranchCurvature_pos hy,
    confocalBranch_reconstruct_re hy, confocalBranch_reconstruct_abs_im hy⟩

end

end HTGeometry
