import Mathlib.Topology.MetricSpace.CoveringNumbers
import GaloisForLFunctions.HTGeometry.SpectralSliceComplexityAmplificationLaw

/-!
# Metric-entropy amplification by autonomous recurrence

Finite circuit dictionaries can cover only as many metric balls as they have
endpoints.  If an ambient set needs more balls than that, it contains a robust
hard seed.  It is enough for a single compact autonomous spectral slice to
contain that seed: density on the slice turns the one ambient certificate into
ordered easy--hard--easy epochs with a uniform finite gap, forever.

The theorem separates the two resources exactly.  Ambient covering entropy
sets the attainable circuit depth; orbit compactness amplifies one witness in
time.  The dimension of the individual orbit closure does not cap the depth.
-/

open Set Topology
open scoped ENNReal NNReal

namespace GaloisForLFunctions.HTGeometry

/-- Closed metric neighborhood generated by a dictionary of centers. -/
def metricClosedBallTarget {X : Type*} [PseudoMetricSpace X]
    (ε : ℝ≥0) (C : Set X) : Set X :=
  ⋃ c ∈ C, Metric.closedBall c ε

theorem metricClosedBallTarget_isClosed
    {X : Type*} [PseudoMetricSpace X] {ε : ℝ≥0} {C : Set X}
    (hC : C.Finite) : IsClosed (metricClosedBallTarget ε C) := by
  exact hC.isClosed_biUnion fun c _ ↦ Metric.isClosed_closedBall

theorem mem_interior_metricClosedBallTarget
    {X : Type*} [PseudoMetricSpace X] {ε : ℝ≥0} {C : Set X}
    (hε : 0 < ε) {x : X} (hx : x ∈ C) :
    x ∈ interior (metricClosedBallTarget ε C) := by
  have hxball : x ∈ interior (Metric.closedBall x (ε : ℝ)) :=
    Metric.ball_subset_interior_closedBall (Metric.mem_ball_self (show (0 : ℝ) < ε by exact_mod_cast hε))
  apply interior_mono _ hxball
  intro y hy
  exact Set.mem_iUnion₂.mpr ⟨x, hx, hy⟩

/-- If the external covering number of `A` exceeds the number of available
centers, one point of `A` is farther than `ε` from every center. -/
theorem exists_metricHardSeed_of_encard_lt_externalCoveringNumber
    {X : Type*} [MetricSpace X] {ε : ℝ≥0} {A C : Set X}
    (hEntropy : C.encard < Metric.externalCoveringNumber ε A) :
    ∃ x ∈ A, ∀ c ∈ C, (ε : ℝ) < dist x c := by
  have hnotCover : ¬ Metric.IsCover ε A C := by
    intro hcover
    exact (not_lt_of_ge hcover.externalCoveringNumber_le_encard) hEntropy
  rw [Metric.isCover_iff_subset_iUnion_closedBall] at hnotCover
  obtain ⟨x, hxA, hxoutside⟩ := Set.not_subset.mp hnotCover
  refine ⟨x, hxA, fun c hc ↦ ?_⟩
  have hnotBall : x ∉ Metric.closedBall c (ε : ℝ) := by
    intro hxc
    exact hxoutside (Set.mem_iUnion₂.mpr ⟨c, hc, hxc⟩)
  have hnn : ε < nndist x c := by
    simpa [Metric.mem_closedBall, not_le] using hnotBall
  exact_mod_cast hnn

/-- **Ambient metric entropy becomes permanent autonomous complexity.**
Let a family of compact recurrent slices cover an ambient test set `A`.
Whenever `A` needs more radius-`ε` balls than a finite endpoint dictionary
contains, one slice alternates forever between an easy neighborhood of a
dictionary base point and states farther than `ε` from every dictionary
endpoint.  One finite `L` bounds every easy--hard and hard--easy leg.

No randomness, mixing, ergodicity, differentiability, finite-dimensional
orbit hypothesis, or probabilistic ensemble is used. -/
theorem coveringEntropy_easyHard_alternate_syndetically
    {T : Type*} [TopologicalSpace T] [AddGroup T]
    [IsTopologicalAddGroup T] [CompactSpace T]
    {P X : Type*} [MetricSpace X]
    (orbit : ℝ →+ T) (hdense : DenseRange orbit)
    (embed : P → T → X) (hembed : ∀ p, Continuous (embed p))
    {A C : Set X} (hcover : ∀ x ∈ A, ∃ p z, embed p z = x)
    (hCfinite : C.Finite) (base : T) (center : X)
    (hcenter : center ∈ C) (hbase : ∀ p, embed p base = center)
    (ε : ℝ≥0) (hε : 0 < ε)
    (hEntropy : C.encard < Metric.externalCoveringNumber ε A) :
    ∃ p : P, ∃ L : ℝ, 0 ≤ L ∧ ∀ a : ℝ,
      ∃ tEasy ∈ Set.Icc a (a + L),
      ∃ tHard ∈ Set.Ioc tEasy (tEasy + L),
      ∃ tEasy' ∈ Set.Ioc tHard (tHard + L),
        embed p (orbit tEasy) ∈ interior (metricClosedBallTarget ε C) ∧
        (∀ c ∈ C, (ε : ℝ) < dist (embed p (orbit tHard)) c) ∧
        embed p (orbit tEasy') ∈ interior (metricClosedBallTarget ε C) := by
  obtain ⟨x, hxA, hxhard⟩ :=
    exists_metricHardSeed_of_encard_lt_externalCoveringNumber hEntropy
  obtain ⟨p, seed, hpseed⟩ := hcover x hxA
  have hclosed : IsClosed (metricClosedBallTarget ε C) :=
    metricClosedBallTarget_isClosed hCfinite
  have hbaseInterior : embed p base ∈ interior (metricClosedBallTarget ε C) := by
    rw [hbase p]
    exact mem_interior_metricClosedBallTarget hε hcenter
  have hseedOutside : embed p seed ∉ metricClosedBallTarget ε C := by
    rw [hpseed]
    intro hxTarget
    obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hxTarget
    exact (not_lt_of_ge hxc) (hxhard c hc)
  obtain ⟨L, hL, hhits⟩ :=
    compactSlice_hardSeed_easyHard_alternate_syndetically
      orbit hdense (embed p) (hembed p) base seed hclosed
      hbaseInterior hseedOutside
  refine ⟨p, L, hL, fun a ↦ ?_⟩
  obtain ⟨tEasy, htEasy, tHard, htHard, tEasy', htEasy',
      hEasy, hHard, hEasy'⟩ := hhits a
  refine ⟨tEasy, htEasy, tHard, htHard, tEasy', htEasy',
    hEasy, ?_, hEasy'⟩
  intro c hc
  have hnotBall : embed p (orbit tHard) ∉ Metric.closedBall c (ε : ℝ) := by
    intro hmem
    exact hHard (Set.mem_iUnion₂.mpr ⟨c, hc, hmem⟩)
  have hnn : ε < nndist (embed p (orbit tHard)) c := by
    simpa [Metric.mem_closedBall, not_le] using hnotBall
  exact_mod_cast hnn

end GaloisForLFunctions.HTGeometry
