import GaloisForLFunctions.HTGeometry.SourceMarkedGibbsSplitting
import GaloisForLFunctions.HTGeometry.ExponentialSumDA

/-!
# Proper-action and phase clocks read from a probe-mass family

A clock value need not be generated by temporal evolution.  In black-hole and cosmological
applications, geometric time or length can instead be encoded in the dependence of an exterior
observable on the mass of a probe field.

This module records two reusable forms of that principle.

* A positive mixture `Z_m = sum_p b_p exp(-m tau_p)` reports the infimum of the labels `tau_p`
  through `-log Z_m / m`.  The conclusion is unchanged by any positive subexponential prefactor.
* A complex saddle signal `q_m exp(-m A)` reports the complex action through its successive ratio,
  provided `q_(m+1)/q_m -> 1`.

The positive mixture theorem is a direct specialization of the existing source-marked Gibbs
support-radius law.  The final finite-spectrum boundary states that finitely many exact complex
actions always produce a differentially algebraic mass response, so a hypertranscendental response
requires an infinite action spectrum or a hypertranscendental prefactor.
-/

open Filter Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Positive exterior observable obtained by probing a family of geometric labels with integer
mass. -/
def thermalMassClockValue {P : Type*}
    (base properAction : P → ℝ) (mass : ℕ) : ℝ :=
  ∑' p, base p * Real.exp (-(mass : ℝ) * properAction p)

/-- The thermal mass-clock value is the negative-energy specialization of the source-marked Gibbs
partition already present in HTGeometry. -/
theorem thermalMassClockValue_eq_sourceMarkedGibbsPartition
    {P : Type*} (base properAction : P → ℝ) (mass : ℕ) :
    thermalMassClockValue base properAction mass =
      sourceMarkedGibbsPartition base (fun p => -properAction p) mass := by
  unfold thermalMassClockValue sourceMarkedGibbsPartition sourceMarkedGibbsWeight
  apply tsum_congr
  intro p
  congr 2
  ring

/-- **Positive mass-clock readout.**  If `tau` is the infimum of the geometric labels visible with
positive summable weights, then the normalized negative logarithm of the exterior observable
converges to `tau`. -/
theorem tendsto_thermalMassClockValue_neg_log_div_mass
    {P : Type*} [Nonempty P]
    (base properAction : P → ℝ) (tau : ℝ)
    (hbase : ∀ p, 0 < base p) (hsum : Summable base)
    (hlower : ∀ p, tau ≤ properAction p)
    (happroach : ∀ b : ℝ, tau < b → ∃ p, properAction p < b) :
    Tendsto
      (fun mass : ℕ =>
        -Real.log (thermalMassClockValue base properAction mass) / (mass : ℝ))
      atTop (nhds tau) := by
  have h := tendsto_sourceMarkedGibbsPartition_log_div_cold
    base (fun p => -properAction p) (-tau) hbase hsum
    (fun p => by linarith [hlower p])
    (by
      intro a ha
      obtain ⟨p, hp⟩ := happroach (-a) (by linarith)
      exact ⟨p, by linarith⟩)
  have hneg := h.neg
  simpa only [thermalMassClockValue_eq_sourceMarkedGibbsPartition,
    neg_div, neg_neg] using hneg

/-- Multiplying the mass-clock observable by an arbitrary positive subexponential detector or WKB
prefactor does not change the reported geometric label. -/
theorem tendsto_thermalMassClockValue_subexponential_prefactor
    {P : Type*} [Nonempty P]
    (base properAction : P → ℝ) (tau : ℝ) (prefactor : ℕ → ℝ)
    (hbase : ∀ p, 0 < base p) (hsum : Summable base)
    (hlower : ∀ p, tau ≤ properAction p)
    (happroach : ∀ b : ℝ, tau < b → ∃ p, properAction p < b)
    (hprefactor : ∀ mass, 0 < prefactor mass)
    (hprefactorRate : Tendsto
      (fun mass : ℕ => Real.log (prefactor mass) / (mass : ℝ))
      atTop (nhds 0)) :
    Tendsto
      (fun mass : ℕ =>
        -Real.log (prefactor mass * thermalMassClockValue base properAction mass) /
          (mass : ℝ))
      atTop (nhds tau) := by
  have hclock := tendsto_thermalMassClockValue_neg_log_div_mass
    base properAction tau hbase hsum hlower happroach
  have hsumtend := hprefactorRate.neg.add hclock
  simpa only [neg_zero, zero_add] using hsumtend.congr'
    (Filter.Eventually.of_forall (fun mass => by
      have hZpos : 0 < thermalMassClockValue base properAction mass := by
        rw [thermalMassClockValue_eq_sourceMarkedGibbsPartition]
        exact sourceMarkedGibbsPartition_pos base (fun p => -properAction p) (-tau) mass
          hbase hsum (fun p => by linarith [hlower p])
      rw [Real.log_mul (hprefactor mass).ne' hZpos.ne']
      ring))

/-- A complex mass-clock signal with a slowly varying prefactor and one complex action.  The real
part of the action controls exponential damping and its imaginary part is the phase-clock value. -/
def complexMassClockSignal (prefactor : ℕ → ℂ) (action : ℂ) (mass : ℕ) : ℂ :=
  prefactor mass * Complex.exp (-(mass : ℂ) * action)

/-- Exact successive-ratio identity for a one-action complex mass clock. -/
theorem complexMassClockSignal_succ_div
    {prefactor : ℕ → ℂ} {action : ℂ} {mass : ℕ}
    (hprefactor : prefactor mass ≠ 0) :
    complexMassClockSignal prefactor action (mass + 1) /
        complexMassClockSignal prefactor action mass =
      (prefactor (mass + 1) / prefactor mass) * Complex.exp (-action) := by
  rw [complexMassClockSignal, complexMassClockSignal]
  have hexp : Complex.exp (-((mass + 1 : ℕ) : ℂ) * action) =
      Complex.exp (-(mass : ℂ) * action) * Complex.exp (-action) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [hexp]
  field_simp [hprefactor, Complex.exp_ne_zero]

/-- **Complex mass-clock readout.**  A prefactor with asymptotically unit successive ratio leaves
the full complex action observable as the limiting signal ratio. -/
theorem tendsto_complexMassClockSignal_succ_div
    {prefactor : ℕ → ℂ} {action : ℂ}
    (hprefactor : ∀ mass, prefactor mass ≠ 0)
    (hprefactorRatio : Tendsto
      (fun mass : ℕ => prefactor (mass + 1) / prefactor mass)
      atTop (nhds 1)) :
    Tendsto
      (fun mass : ℕ =>
        complexMassClockSignal prefactor action (mass + 1) /
          complexMassClockSignal prefactor action mass)
      atTop (nhds (Complex.exp (-action))) := by
  have h := hprefactorRatio.mul_const (Complex.exp (-action))
  simpa only [one_mul] using h.congr' (Filter.Eventually.of_forall (fun mass =>
    (complexMassClockSignal_succ_div (hprefactor mass)).symm))

/-- A finite complex saddle/action spectrum as a function of complex probe mass. -/
def finiteMassClockSignal {I : Type*}
    (s : Finset I) (amplitude action : I → ℂ) (mass : ℂ) : ℂ :=
  ∑ i ∈ s, amplitude i * Complex.exp (-action i * mass)

/-- Every finite exact mass-clock action spectrum is differentially algebraic. -/
theorem differentiallyAlgebraic_finiteMassClockSignal
    {I : Type*} [DecidableEq I]
    (s : Finset I) (amplitude action : I → ℂ) :
    DifferentiallyAlgebraic (finiteMassClockSignal s amplitude action) :=
  differentiallyAlgebraic_finset_expSum_general s amplitude (fun i => -action i)

/-- A hypertranscendental observable cannot be generated by finitely many exact complex mass-clock
actions.  The positive alternative is an infinite action spectrum or non-DA prefactor structure. -/
theorem hypertranscendental_ne_finiteMassClockSignal
    {I : Type*} [DecidableEq I] {f : ℂ → ℂ}
    (hf : Hypertranscendental f)
    (s : Finset I) (amplitude action : I → ℂ) :
    f ≠ finiteMassClockSignal s amplitude action := by
  intro h
  apply hf
  rw [h]
  exact differentiallyAlgebraic_finiteMassClockSignal s amplitude action

end

end GaloisForLFunctions.HTGeometry
