import GaloisForLFunctions.HTGeometry.RationalNormalCone

/-!
# The cone ring is generated by `U, U T, …, U T ^ d`

A cone monomial `U ^ a T ^ b` with `b ≤ d a` is a product of `a` generators `U T ^ {i_k}` with
`∑ i_k = b` and every `i_k ≤ d`; such a decomposition exists by a greedy argument
(`exists_greedy_parts`).  Hence

```text
monomial_mem_adjoin_coneGenSet     every cone monomial is a product of generators
rationalNormalCone_eq_adjoin       ** the cone ring is the algebra generated by U T ^ i, i ≤ d **
```

This is the identification that matches the coordinate ring of the affine cone over the rational
normal curve with the image of the `r = 1` moment parameterisation `a_i ↦ c x ^ i`, and so carries
`isCohenMacaulayRing_rationalNormalCone` and the normality theorem over to the presentation
`MvPolynomial (Fin N) K ⧸ finiteHankelSecantIdeal K N 1` that the Hankel card states.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

universe u
variable {K : Type u} [Field K]

theorem exists_greedy_parts (d : ℕ) : ∀ (a b : ℕ), b ≤ d * a →
    ∃ f : Fin a → ℕ, (∀ k, f k ≤ d) ∧ ∑ k, f k = b := by
  intro a
  induction a with
  | zero =>
    intro b hb
    simp only [Nat.mul_zero, Nat.le_zero] at hb
    exact ⟨Fin.elim0, fun k => k.elim0, by simp [hb]⟩
  | succ a ih =>
    intro b hb
    set i : ℕ := min d b with hi
    have hib : i ≤ b := min_le_right _ _
    have hid : i ≤ d := min_le_left _ _
    have hrest : b - i ≤ d * a := by
      rcases le_or_gt b d with h | h
      · have : i = b := by omega
        omega
      · have : i = d := by omega
        have hmul : d * (a + 1) = d * a + d := by ring
        omega
    obtain ⟨f', hf', hsum'⟩ := ih (b - i) hrest
    refine ⟨Fin.cons i f', ?_, ?_⟩
    · intro k
      refine Fin.cases ?_ ?_ k
      · simpa using hid
      · intro j; simpa using hf' j
    · rw [Fin.sum_cons, hsum']
      omega

private theorem prod_monomial_one {σ ι : Type*} (s : Finset ι) (g : ι → (σ →₀ ℕ)) :
    ∏ i ∈ s, MvPolynomial.monomial (g i) (1 : K) = MvPolynomial.monomial (∑ i ∈ s, g i) 1 := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.sum_insert hi, ih, MvPolynomial.monomial_mul, one_mul]

/-- The generators `U T ^ i`, `i ≤ d`, of the cone ring. -/
noncomputable def coneGenSet (K : Type u) [Field K] (d : ℕ) : Set (MvPolynomial (Fin 2) K) :=
  (fun i : ℕ => MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 1 i) (1 : K)) ''
    {i | i ≤ d}

/-- **Every cone monomial is a product of the generators.** -/
theorem monomial_mem_adjoin_coneGenSet {d : ℕ} {e : Fin 2 →₀ ℕ} (he : e ∈ coneExp d) :
    MvPolynomial.monomial e (1 : K) ∈ Algebra.adjoin K (coneGenSet K d) := by
  classical
  obtain ⟨f, hf, hsum⟩ := exists_greedy_parts d (e 0) (e 1) he
  have hexp : ∑ k : Fin (e 0), (Finsupp.single (0 : Fin 2) 1 + Finsupp.single 1 (f k)) = e := by
    rw [Finset.sum_add_distrib]
    conv_rhs => rw [finsupp_fin2_eq e]
    congr 1
    · rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, Finsupp.smul_single,
        smul_eq_mul, mul_one]
    · rw [← Finsupp.single_finsetSum, hsum]
  have hprod : ∏ k : Fin (e 0),
      MvPolynomial.monomial (Finsupp.single (0 : Fin 2) 1 + Finsupp.single 1 (f k)) (1 : K)
        = MvPolynomial.monomial e 1 := by
    rw [prod_monomial_one, hexp]
  rw [← hprod]
  refine Subalgebra.prod_mem _ fun k _ => ?_
  exact Algebra.subset_adjoin ⟨f k, hf k, rfl⟩

/-- **The cone ring is generated by `U, U T, …, U T ^ d`.** -/
theorem rationalNormalCone_eq_adjoin (K : Type u) [Field K] (d : ℕ) :
    rationalNormalCone K d = Algebra.adjoin K (coneGenSet K d) := by
  classical
  refine le_antisymm ?_ (Algebra.adjoin_le ?_)
  · intro p hp
    have hmem : p ∈ monomialSpan K (coneExp d) := hp
    have hle : monomialSpan K (coneExp d)
        ≤ (Algebra.adjoin K (coneGenSet K d)).toSubmodule := by
      rw [monomialSpan]
      refine Submodule.span_le.mpr ?_
      rintro q ⟨e, he, rfl⟩
      exact monomial_mem_adjoin_coneGenSet he
    exact hle hmem
  · rintro q ⟨i, hi, rfl⟩
    have hid : i ≤ d := hi
    have hexp : (Finsupp.single (0 : Fin 2) 1 + Finsupp.single 1 i) ∈ coneExp d := by
      simp only [coneExp, Set.mem_setOf_eq, Finsupp.add_apply]
      simp
      omega
    exact monomial_mem_monomialSpan hexp


end GaloisForLFunctions.HTGeometry
