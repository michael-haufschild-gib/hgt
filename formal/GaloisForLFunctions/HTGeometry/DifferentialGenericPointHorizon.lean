import Mathlib
import GaloisForLFunctions.HTGeometry.FreeDifferentialFieldPresentation
import GaloisForLFunctions.HTGeometry.JetHorizonFirstDepthRigidity

/-!
# A differentially generic point keeps its cylinder gauge at every depth

The differential relations of a differentially generic point are exactly the prolongations of the
algebraic relations of its locus.  Translating the degree-zero jets by a constant vector commutes
with the jet advance and carries the prolongation of an ideal to the prolongation of its translate,
so a translation symmetry of the locus preserves the whole differential relation ideal while fixing
every positive jet.

Consequently a coordinate of the point cannot be a differential rational function of the `n`-th
derivatives unless the corresponding component of the translation vector vanishes: a nontrivial
translation stabilizer really is lost by every positive derivative horizon.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {C κ : Type*} [Field C]

/-! ### Jet shifts, jet translations, and prolonged ideals -/

/-- Raising every jet order by `n`. -/
def jetShift (C : Type*) [Field C] (κ : Type*) (n : ℕ) : JetPoly C κ →ₐ[C] JetPoly C κ :=
  MvPolynomial.aeval fun p : κ × ℕ => (MvPolynomial.X (p.1, p.2 + n) : JetPoly C κ)

@[simp] theorem jetShift_X (n : ℕ) (p : κ × ℕ) :
    jetShift C κ n (MvPolynomial.X p) = MvPolynomial.X (p.1, p.2 + n) :=
  MvPolynomial.aeval_X _ _

/-- Translation of the degree-zero jets by a constant vector. -/
def jetTranslate (a : κ → C) : JetPoly C κ →ₐ[C] JetPoly C κ :=
  MvPolynomial.aeval fun p : κ × ℕ =>
    if p.2 = 0 then (MvPolynomial.X p + MvPolynomial.C (a p.1) : JetPoly C κ)
      else MvPolynomial.X p

@[simp] theorem jetTranslate_X (a : κ → C) (p : κ × ℕ) :
    jetTranslate a (MvPolynomial.X p)
      = if p.2 = 0 then MvPolynomial.X p + MvPolynomial.C (a p.1) else MvPolynomial.X p :=
  MvPolynomial.aeval_X _ _

/-- The embedding of the coordinate ring as the degree-zero jets. -/
def jetBase (C : Type*) [Field C] (κ : Type*) : MvPolynomial κ C →ₐ[C] JetPoly C κ :=
  MvPolynomial.aeval fun i : κ => (MvPolynomial.X (i, 0) : JetPoly C κ)

@[simp] theorem jetBase_X (i : κ) :
    jetBase C κ (MvPolynomial.X i) = MvPolynomial.X (i, 0) :=
  MvPolynomial.aeval_X _ _

/-- The differential ideal generated by an ideal of the coordinate ring: all jet derivatives of the
degree-zero images of its members. -/
def prolongedIdeal (I : Ideal (MvPolynomial κ C)) : Ideal (JetPoly C κ) :=
  Ideal.span {Q : JetPoly C κ |
    ∃ P ∈ I, ∃ j : ℕ, (⇑(jetDeriv C κ))^[j] (jetBase C κ P) = Q}

@[simp] theorem jetDeriv_C_eq_zero (r : C) :
    jetDeriv C κ (MvPolynomial.C r : JetPoly C κ) = 0 :=
  (jetDeriv C κ).map_algebraMap r

theorem jetDeriv_mul (Q R : JetPoly C κ) :
    jetDeriv C κ (Q * R) = jetDeriv C κ Q * R + Q * jetDeriv C κ R := by
  rw [Derivation.leibniz]
  simp only [smul_eq_mul]
  ring

/-- Jet translation commutes with the jet advance. -/
theorem jetTranslate_jetDeriv (a : κ → C) (Q : JetPoly C κ) :
    jetTranslate a (jetDeriv C κ Q) = jetDeriv C κ (jetTranslate a Q) := by
  classical
  induction Q using MvPolynomial.induction_on with
  | C r => simp
  | add P Q hP hQ => simp [hP, hQ]
  | mul_X P p hP =>
      have hkey : jetDeriv C κ (jetTranslate a (MvPolynomial.X p))
          = MvPolynomial.X (p.1, p.2 + 1) := by
        rw [jetTranslate_X]
        by_cases hp : p.2 = 0
        · rw [if_pos hp, map_add, jetDeriv_X, jetDeriv_C_eq_zero, add_zero]
        · rw [if_neg hp, jetDeriv_X]
      have hkey2 : jetTranslate a (jetDeriv C κ (MvPolynomial.X p))
          = MvPolynomial.X (p.1, p.2 + 1) := by
        rw [jetDeriv_X, jetTranslate_X, if_neg (by omega : p.2 + 1 ≠ 0)]
      rw [jetDeriv_mul, map_add, map_mul, map_mul, hP, hkey2, map_mul, jetDeriv_mul, hkey]

theorem jetTranslate_iterate_jetDeriv (a : κ → C) (j : ℕ) (Q : JetPoly C κ) :
    jetTranslate a ((⇑(jetDeriv C κ))^[j] Q) = (⇑(jetDeriv C κ))^[j] (jetTranslate a Q) := by
  induction j generalizing Q with
  | zero => rfl
  | succ j ih =>
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih, jetTranslate_jetDeriv]

/-- Jet translation of a degree-zero image is the degree-zero image of the translate. -/
theorem jetTranslate_jetBase (a : κ → C) (P : MvPolynomial κ C) :
    jetTranslate a (jetBase C κ P) = jetBase C κ (mvPolynomialBaseTranslation a P) := by
  have h : (jetTranslate a).comp (jetBase C κ)
      = (jetBase C κ).comp (mvPolynomialBaseTranslation a).toAlgHom := by
    refine MvPolynomial.algHom_ext fun i => ?_
    simp
  exact congrArg (fun f : MvPolynomial κ C →ₐ[C] JetPoly C κ => f P) h

/-- A translation symmetry of an ideal preserves its prolongation. -/
theorem jetTranslate_mem_prolongedIdeal {I : Ideal (MvPolynomial κ C)} {a : κ → C}
    (ha : ∀ P ∈ I, mvPolynomialBaseTranslation a P ∈ I)
    {Q : JetPoly C κ} (hQ : Q ∈ prolongedIdeal I) :
    jetTranslate a Q ∈ prolongedIdeal I := by
  have hmap : Ideal.map (jetTranslate a).toRingHom (prolongedIdeal I) ≤ prolongedIdeal I := by
    rw [prolongedIdeal, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨Q', ⟨P, hP, j, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨mvPolynomialBaseTranslation a P, ha P hP, j, ?_⟩
    rw [← jetTranslate_jetBase, ← jetTranslate_iterate_jetDeriv]
    rfl
  exact hmap (Ideal.mem_map_of_mem _ hQ)

/-- A positive jet shift lands in the part of the jet ring fixed by every jet translation. -/
theorem jetTranslate_jetShift_succ (a : κ → C) (n : ℕ) (Q : JetPoly C κ) :
    jetTranslate a (jetShift C κ (n + 1) Q) = jetShift C κ (n + 1) Q := by
  have h : (jetTranslate a).comp (jetShift C κ (n + 1)) = jetShift C κ (n + 1) := by
    refine MvPolynomial.algHom_ext fun p => ?_
    simp
  exact congrArg (fun f : JetPoly C κ →ₐ[C] JetPoly C κ => f Q) h

/-! ### Differentially generic points -/

variable {F : Type*} [Field F] [Differential F] [Algebra C F]

/-- Evaluation of a jet polynomial at the jets of a family. -/
def jetFamilyEval (z : κ → F) : JetPoly C κ →ₐ[C] F :=
  MvPolynomial.aeval fun p : κ × ℕ => differentialJet p.2 (z p.1)

@[simp] theorem jetFamilyEval_X (z : κ → F) (p : κ × ℕ) :
    jetFamilyEval (C := C) z (MvPolynomial.X p) = differentialJet p.2 (z p.1) :=
  MvPolynomial.aeval_X _ _

theorem jetFamilyEval_jetBase (z : κ → F) (P : MvPolynomial κ C) :
    jetFamilyEval (C := C) z (jetBase C κ P) = MvPolynomial.aeval z P := by
  have h : (jetFamilyEval (C := C) z).comp (jetBase C κ)
      = (MvPolynomial.aeval z : MvPolynomial κ C →ₐ[C] F) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    simp
  exact congrArg (fun f : MvPolynomial κ C →ₐ[C] F => f P) h

theorem jetFamilyEval_jetShift (z : κ → F) (n : ℕ) (Q : JetPoly C κ) :
    jetFamilyEval (C := C) z (jetShift C κ n Q)
      = MvPolynomial.aeval (fun p : κ × ℕ => differentialJet (p.2 + n) (z p.1)) Q := by
  have h : (jetFamilyEval (C := C) z).comp (jetShift C κ n)
      = (MvPolynomial.aeval fun p : κ × ℕ => differentialJet (p.2 + n) (z p.1)) := by
    refine MvPolynomial.algHom_ext fun p => ?_
    simp
  exact congrArg (fun f : JetPoly C κ →ₐ[C] F => f Q) h

/-- A point is **differentially generic** when its differential relations are exactly the
prolongations of the algebraic relations of its locus. -/
def IsDifferentiallyGeneric (z : κ → F) : Prop :=
  RingHom.ker (jetFamilyEval (C := C) z).toRingHom
    = prolongedIdeal (RingHom.ker (MvPolynomial.aeval z : MvPolynomial κ C →ₐ[C] F).toRingHom)

/-- The set of all jets of the `n`-th derivatives is the set of jets of order at least `n`. -/
theorem differentialJetSet_range_differentialJet (z : κ → F) (n : ℕ) :
    differentialJetSet (Set.range fun i => differentialJet n (z i))
      = Set.range fun p : κ × ℕ => differentialJet (p.2 + n) (z p.1) := by
  ext y
  constructor
  · rintro ⟨x, ⟨i, rfl⟩, k, rfl⟩
    exact ⟨(i, k), differentialJet_add k n (z i)⟩
  · rintro ⟨p, rfl⟩
    exact ⟨differentialJet n (z p.1), ⟨p.1, rfl⟩, p.2, (differentialJet_add p.2 n (z p.1)).symm⟩

/-- **A translation symmetry is invisible to every positive derivative horizon.**  If a coordinate
of a differentially generic point lies in the differential field generated by the `n`-th
derivatives, then the corresponding component of every translation symmetry vanishes. -/
theorem translationSymmetry_eq_zero_of_mem_differentialAdjoin
    {z : κ → F} (hgen : IsDifferentiallyGeneric (C := C) z)
    {a : κ → C} (ha : IsTranslationSymmetry z a) {n : ℕ} {i : κ}
    (hmem : z i ∈ differentialAdjoin C (Set.range fun j => differentialJet (n + 1) (z j))) :
    a i = 0 := by
  classical
  set I : Ideal (MvPolynomial κ C) :=
    RingHom.ker (MvPolynomial.aeval z : MvPolynomial κ C →ₐ[C] F).toRingHom with hIdef
  have hmemI : ∀ P : MvPolynomial κ C, P ∈ I ↔ MvPolynomial.aeval z P = 0 := by
    intro P; rw [hIdef]; exact RingHom.mem_ker
  have hstab : ∀ P ∈ I, mvPolynomialBaseTranslation a P ∈ I := by
    intro P hP
    rw [hmemI] at hP ⊢
    rw [aeval_mvPolynomialBaseTranslation]
    exact ha P hP
  rw [differentialAdjoin, differentialJetSet_range_differentialJet] at hmem
  rw [IntermediateField.mem_adjoin_range_iff] at hmem
  obtain ⟨r, s, hrs⟩ := hmem
  set A : F := jetFamilyEval (C := C) z (jetShift C κ (n + 1) r) with hA
  set B : F := jetFamilyEval (C := C) z (jetShift C κ (n + 1) s) with hB
  rw [← jetFamilyEval_jetShift (C := C) z (n + 1) r, ← jetFamilyEval_jetShift (C := C) z (n + 1) s]
    at hrs
  rw [← hA, ← hB] at hrs
  by_cases hB0 : B = 0
  · -- the point coordinate is zero, so the coordinate function is a relation of the locus
    have hz : z i = 0 := by rw [hrs, hB0, div_zero]
    have hXI : (MvPolynomial.X i : MvPolynomial κ C) ∈ I := by
      rw [hmemI]; simpa using hz
    have := hstab _ hXI
    rw [hmemI, aeval_mvPolynomialBaseTranslation] at this
    simpa [hz] using this
  · have hzB : z i * B = A := by rw [hrs]; field_simp
    set Q : JetPoly C κ :=
      MvPolynomial.X (i, 0) * jetShift C κ (n + 1) s - jetShift C κ (n + 1) r with hQ
    have hQker : Q ∈ RingHom.ker (jetFamilyEval (C := C) z).toRingHom := by
      rw [RingHom.mem_ker]
      show jetFamilyEval (C := C) z Q = 0
      rw [hQ, map_sub, map_mul, jetFamilyEval_X]
      simpa [← hA, ← hB] using sub_eq_zero.2 hzB
    have hQprol : Q ∈ prolongedIdeal I := by rw [← hgen]; exact hQker
    have htrans : jetTranslate a Q ∈ prolongedIdeal I :=
      jetTranslate_mem_prolongedIdeal hstab hQprol
    have htker : jetTranslate a Q ∈ RingHom.ker (jetFamilyEval (C := C) z).toRingHom := by
      rw [hgen]; exact htrans
    have hval : jetFamilyEval (C := C) z (jetTranslate a Q) = 0 := by
      have := RingHom.mem_ker.1 htker
      exact this
    rw [hQ, map_sub, map_mul, jetTranslate_X, jetTranslate_jetShift_succ,
      jetTranslate_jetShift_succ] at hval
    have hcast : (z i + (MvPolynomial.aeval z) (MvPolynomial.C (a i) : MvPolynomial κ C)) * B
        - A = 0 := by
      simpa using hval
    rw [MvPolynomial.aeval_C] at hcast
    have : algebraMap C F (a i) * B = 0 := by
      have hzz : z i * B - A = 0 := sub_eq_zero.2 hzB
      linear_combination hcast - hzz
    rcases mul_eq_zero.1 this with h | h
    · exact (map_eq_zero (algebraMap C F)).1 h
    · exact absurd h hB0

/-- **A nontrivial translation stabilizer is lost at every positive depth.**  If some translation
symmetry of the locus of a differentially generic point has a nonzero component, the differential
field generated by the `n`-th derivatives is a proper subfield. -/
theorem differentialAdjoin_differentialJet_ne_top_of_translationSymmetry
    {z : κ → F} (hgen : IsDifferentiallyGeneric (C := C) z)
    {a : κ → C} (ha : IsTranslationSymmetry z a) {n : ℕ} {i : κ} (hai : a i ≠ 0) :
    differentialAdjoin C (Set.range fun j => differentialJet (n + 1) (z j)) ≠ ⊤ := by
  intro htop
  exact hai (translationSymmetry_eq_zero_of_mem_differentialAdjoin hgen ha
    (by rw [htop]; trivial))

end

end GaloisForLFunctions.HTGeometry
