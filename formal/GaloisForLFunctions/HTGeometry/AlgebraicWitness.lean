import Mathlib

/-!
# Concrete witnesses of algebraicity over a generated subfield

An element is algebraic over the subfield generated by a family `b` as soon as it satisfies a
polynomial whose coefficients are *polynomials* in `b` and whose leading coefficient does not
vanish.  Recording the witness in that denominator-free shape makes it transportable: a
homomorphism of algebras over the base carries the whole witness, and the only thing to check on
the far side is that the leading coefficient stays nonzero.

That is what is needed to move an algebraic relation between jets from one realisation of a germ to
another — for instance from a germ to its substitutions along a family of inner maps, and from
there into an ultraproduct.
-/

namespace GaloisForLFunctions.HTGeometry

open MvPolynomial

variable {K L : Type*} [Field K] [CommRing L] [Algebra K L]

/-- A denominator-free witness that `y` is algebraic over the subfield generated by `b`. -/
def AlgebraicWitness {σ : Type*} (K : Type*) [Field K] [Algebra K L] (b : σ → L) (y : L) : Prop :=
  ∃ (m : ℕ) (P : ℕ → MvPolynomial σ K),
    MvPolynomial.aeval b (P m) ≠ 0 ∧
      ∑ i ∈ Finset.range (m + 1), MvPolynomial.aeval b (P i) * y ^ i = 0

/-- A witness over a reindexed family is a witness over the original one. -/
theorem AlgebraicWitness.rename {σ σ' : Type*} {b : σ → L} {y : L} (g : σ' → σ)
    (h : AlgebraicWitness K (b ∘ g) y) : AlgebraicWitness K b y := by
  obtain ⟨m, P, hlead, hrel⟩ := h
  refine ⟨m, fun i => MvPolynomial.rename g (P i), ?_, ?_⟩
  · rw [MvPolynomial.aeval_rename]
    exact hlead
  · refine Eq.trans ?_ hrel
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [MvPolynomial.aeval_rename]

/-- A witness transports along an algebra homomorphism over the base. -/
theorem AlgebraicWitness.map {L' : Type*} [CommRing L'] [Algebra K L'] {σ : Type*} {b : σ → L}
    {y : L} (φ : L →ₐ[K] L') (hinj : Function.Injective φ) (h : AlgebraicWitness K b y) :
    AlgebraicWitness K (fun w => φ (b w)) (φ y) := by
  obtain ⟨m, P, hlead, hrel⟩ := h
  refine ⟨m, P, ?_, ?_⟩
  · rw [← MvPolynomial.comp_aeval_apply b φ]
    intro h0
    exact hlead (hinj (by rw [h0, map_zero]))
  · have hφ := congrArg φ hrel
    rw [map_zero, map_sum] at hφ
    refine Eq.trans ?_ hφ
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, MvPolynomial.comp_aeval_apply b φ]

/-- A witness with explicit data transports along any algebra homomorphism that keeps the leading
coefficient nonzero.  This is weaker than injectivity, and is what an ultraproduct map satisfies. -/
theorem algebraicWitness_map_of_leading_ne_zero {L' : Type*} [CommRing L'] [Algebra K L']
    {σ : Type*} {b : σ → L} {y : L} (φ : L →ₐ[K] L') {m : ℕ} {P : ℕ → MvPolynomial σ K}
    (hlead : φ (MvPolynomial.aeval b (P m)) ≠ 0)
    (hrel : ∑ i ∈ Finset.range (m + 1), MvPolynomial.aeval b (P i) * y ^ i = 0) :
    AlgebraicWitness K (fun w => φ (b w)) (φ y) := by
  refine ⟨m, P, ?_, ?_⟩
  · rwa [← MvPolynomial.comp_aeval_apply b φ]
  · have hφ := congrArg φ hrel
    rw [map_zero, map_sum] at hφ
    refine Eq.trans ?_ hφ
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, MvPolynomial.comp_aeval_apply b φ]

/-- **A witness gives algebraicity over the generated subfield.** -/
theorem isAlgebraic_of_algebraicWitness {F : Type*} [Field F] [Algebra K F] {σ : Type*}
    {b : σ → F} {y : F} (h : AlgebraicWitness K b y) :
    IsAlgebraic ↥(IntermediateField.adjoin K (Set.range b)) y := by
  classical
  obtain ⟨m, P, hlead, hrel⟩ := h
  set A : IntermediateField K F := IntermediateField.adjoin K (Set.range b) with hA
  have hmem : ∀ Q : MvPolynomial σ K, MvPolynomial.aeval b Q ∈ A := by
    intro Q
    induction Q using MvPolynomial.induction_on with
    | C a =>
        rw [MvPolynomial.aeval_C]
        exact A.algebraMap_mem a
    | add p q hp hq =>
        rw [map_add]
        exact A.add_mem hp hq
    | mul_X p w hp =>
        rw [map_mul, MvPolynomial.aeval_X]
        exact A.mul_mem hp (IntermediateField.subset_adjoin K _ ⟨w, rfl⟩)
  set coef : ℕ → ↥A := fun i => ⟨MvPolynomial.aeval b (P i), hmem (P i)⟩ with hcoef
  refine ⟨∑ i ∈ Finset.range (m + 1), Polynomial.C (coef i) * Polynomial.X ^ i, ?_, ?_⟩
  · intro h0
    apply hlead
    have hc := congrArg (fun p => Polynomial.coeff p m) h0
    simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_zero, mul_ite, mul_one, mul_zero] at hc
    rw [Finset.sum_ite_eq (Finset.range (m + 1)) m coef, if_pos (Finset.self_mem_range_succ m)]
      at hc
    exact congrArg Subtype.val hc
  · rw [map_sum]
    refine Eq.trans ?_ hrel
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    rfl

/-- **Algebraicity over the generated subalgebra gives a witness.**  The coefficients of an
annihilating polynomial over `K[b]` are themselves polynomials in `b`, and the leading one is
nonzero. -/
theorem algebraicWitness_of_isAlgebraic_adjoin {F : Type*} [Field F] [Algebra K F] {σ : Type*}
    {b : σ → F} {y : F} (h : IsAlgebraic ↥(Algebra.adjoin K (Set.range b)) y) :
    AlgebraicWitness K b y := by
  classical
  obtain ⟨p, hp0, hp⟩ := h
  have hrange : ∀ i : ℕ, ∃ R : MvPolynomial σ K, MvPolynomial.aeval b R = ((p.coeff i : _) : F) := by
    intro i
    obtain ⟨x, hxeq, hx⟩ : ∃ x : F, x = ((p.coeff i : _) : F) ∧ x ∈ Algebra.adjoin K (Set.range b) :=
      ⟨_, rfl, (p.coeff i).2⟩
    rw [Algebra.adjoin_range_eq_range_aeval] at hx
    obtain ⟨R, hR⟩ := hx
    exact ⟨R, by rw [show MvPolynomial.aeval b R = (MvPolynomial.aeval b).toRingHom R from rfl,
      hR, hxeq]⟩
  choose R hR using hrange
  refine ⟨p.natDegree, R, ?_, ?_⟩
  · rw [hR]
    intro h0
    exact hp0 (Polynomial.leadingCoeff_eq_zero.mp (Subtype.ext h0))
  · have hsum : Polynomial.aeval y p
        = ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i • y ^ i :=
      Polynomial.aeval_eq_sum_range y
    rw [hp] at hsum
    refine Eq.trans ?_ hsum.symm
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hR i, Algebra.smul_def]
    rfl

/-- **Finite transcendence degree gives a finite witnessing family.**  If the transcendence degree
of `M` over `K` is finite, there is a finite family in `M` over which every element of `M` has a
denominator-free algebraic witness. -/
theorem exists_finite_algebraicWitness_family {M : Type*} [Field M] [Algebra K M]
    [FaithfulSMul K M] (h : Algebra.trdeg K M < Cardinal.aleph0) :
    ∃ (p : ℕ) (b : Fin p → M), ∀ y : M, AlgebraicWitness K b y := by
  classical
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis K M
  have hcard : Cardinal.mk s = Algebra.trdeg K M := hs.cardinalMk_eq_trdeg
  have hfin : s.Finite := Cardinal.lt_aleph0_iff_set_finite.mp (hcard ▸ h)
  obtain ⟨p, ⟨e⟩⟩ := hfin.exists_equiv_fin
  refine ⟨p, fun i => ((e.symm i : s) : M), fun y => ?_⟩
  have hrange : Set.range (fun i : Fin p => ((e.symm i : s) : M)) = s := by
    ext z
    constructor
    · rintro ⟨i, rfl⟩
      exact (e.symm i).2
    · intro hz
      exact ⟨e ⟨z, hz⟩, by simp⟩
  haveI : Algebra.IsAlgebraic ↥(Algebra.adjoin K (Set.range (Subtype.val : s → M))) M :=
    hs.isAlgebraic
  have halg : Algebra.IsAlgebraic
      ↥(Algebra.adjoin K (Set.range (fun i : Fin p => ((e.symm i : s) : M)))) M := by
    rw [hrange]
    rwa [Subtype.range_val] at this
  exact algebraicWitness_of_isAlgebraic_adjoin (halg.isAlgebraic y)

end GaloisForLFunctions.HTGeometry
