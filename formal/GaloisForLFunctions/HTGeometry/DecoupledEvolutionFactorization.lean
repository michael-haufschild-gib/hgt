import GaloisForLFunctions.HTGeometry.ParametricSpectralBranch
import GaloisForLFunctions.HTGeometry.ObserverProfileStability

/-!
# Decoupled Schrödinger evolution factorizes

Tensoring with the identity on one factor is a continuous ring homomorphism of matrix algebras, so
it commutes with the exponential.  The two summands of a Kronecker sum commute, hence the evolution
generated by a Kronecker sum is the Kronecker product of the two factor evolutions, and it carries
a product state to the product of the evolved factors.
-/

open Matrix

open scoped Kronecker Matrix Matrix.Norms.L2Operator

noncomputable section

namespace GaloisForLFunctions.HTGeometry

set_option linter.unusedSectionVars false

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- Tensoring on the right with the identity is a ring homomorphism. -/
def kroneckerRightHom (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] :
    Matrix ι ι ℂ →+* Matrix (ι × κ) (ι × κ) ℂ where
  toFun A := A ⊗ₖ (1 : Matrix κ κ ℂ)
  map_one' := Matrix.one_kronecker_one
  map_mul' A B := by rw [← Matrix.mul_kronecker_mul, Matrix.mul_one]
  map_zero' := Matrix.zero_kronecker _
  map_add' A B := Matrix.add_kronecker A B _

/-- Tensoring on the left with the identity is a ring homomorphism. -/
def kroneckerLeftHom (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] :
    Matrix κ κ ℂ →+* Matrix (ι × κ) (ι × κ) ℂ where
  toFun B := (1 : Matrix ι ι ℂ) ⊗ₖ B
  map_one' := Matrix.one_kronecker_one
  map_mul' A B := by rw [← Matrix.mul_kronecker_mul, Matrix.mul_one]
  map_zero' := Matrix.kronecker_zero _
  map_add' A B := Matrix.kronecker_add _ A B

/-- Right-tensoring with the identity as a linear map. -/
def kroneckerRightLinear (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] :
    Matrix ι ι ℂ →ₗ[ℂ] Matrix (ι × κ) (ι × κ) ℂ where
  toFun A := A ⊗ₖ (1 : Matrix κ κ ℂ)
  map_add' A B := Matrix.add_kronecker A B _
  map_smul' c A := Matrix.smul_kronecker c A _

/-- Left-tensoring with the identity as a linear map. -/
def kroneckerLeftLinear (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] :
    Matrix κ κ ℂ →ₗ[ℂ] Matrix (ι × κ) (ι × κ) ℂ where
  toFun B := (1 : Matrix ι ι ℂ) ⊗ₖ B
  map_add' A B := Matrix.kronecker_add _ A B
  map_smul' c A := Matrix.kronecker_smul c _ A

theorem continuous_kroneckerRightHom :
    Continuous (kroneckerRightHom ι κ) := by
  show Continuous fun A : Matrix ι ι ℂ => A ⊗ₖ (1 : Matrix κ κ ℂ)
  exact (kroneckerRightLinear ι κ).continuous_of_finiteDimensional

theorem continuous_kroneckerLeftHom :
    Continuous (kroneckerLeftHom ι κ) := by
  show Continuous fun B : Matrix κ κ ℂ => (1 : Matrix ι ι ℂ) ⊗ₖ B
  exact (kroneckerLeftLinear ι κ).continuous_of_finiteDimensional

theorem exp_kronecker_one (A : Matrix ι ι ℂ) :
    NormedSpace.exp (A ⊗ₖ (1 : Matrix κ κ ℂ)) =
      (NormedSpace.exp A) ⊗ₖ (1 : Matrix κ κ ℂ) := by
  letI : NormedAlgebra ℚ (Matrix ι ι ℂ) := NormedAlgebra.restrictScalars ℚ ℂ (Matrix ι ι ℂ)
  letI : NormedAlgebra ℚ (Matrix (ι × κ) (ι × κ) ℂ) :=
    NormedAlgebra.restrictScalars ℚ ℂ (Matrix (ι × κ) (ι × κ) ℂ)
  exact (NormedSpace.map_exp (kroneckerRightHom ι κ) continuous_kroneckerRightHom A).symm

theorem exp_one_kronecker (B : Matrix κ κ ℂ) :
    NormedSpace.exp ((1 : Matrix ι ι ℂ) ⊗ₖ B) =
      (1 : Matrix ι ι ℂ) ⊗ₖ (NormedSpace.exp B) := by
  letI : NormedAlgebra ℚ (Matrix κ κ ℂ) := NormedAlgebra.restrictScalars ℚ ℂ (Matrix κ κ ℂ)
  letI : NormedAlgebra ℚ (Matrix (ι × κ) (ι × κ) ℂ) :=
    NormedAlgebra.restrictScalars ℚ ℂ (Matrix (ι × κ) (ι × κ) ℂ)
  exact (NormedSpace.map_exp (kroneckerLeftHom ι κ) continuous_kroneckerLeftHom B).symm

theorem commute_kronecker_one_one_kronecker (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ) :
    Commute (A ⊗ₖ (1 : Matrix κ κ ℂ)) ((1 : Matrix ι ι ℂ) ⊗ₖ B) := by
  rw [Commute, SemiconjBy, ← Matrix.mul_kronecker_mul, ← Matrix.mul_kronecker_mul,
    Matrix.mul_one, Matrix.one_mul, Matrix.mul_one, Matrix.one_mul]

theorem exp_kroneckerSum (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ) :
    NormedSpace.exp (kroneckerSum A B) =
      (NormedSpace.exp A) ⊗ₖ (NormedSpace.exp B) := by
  letI : NormedAlgebra ℚ (Matrix (ι × κ) (ι × κ) ℂ) :=
    NormedAlgebra.restrictScalars ℚ ℂ (Matrix (ι × κ) (ι × κ) ℂ)
  rw [kroneckerSum, NormedSpace.exp_add_of_commute (commute_kronecker_one_one_kronecker A B),
    exp_kronecker_one, exp_one_kronecker, ← Matrix.mul_kronecker_mul, Matrix.mul_one,
    Matrix.one_mul]

/-- **The evolution generated by a Kronecker sum is the Kronecker product of the factor
evolutions.** -/
theorem unitaryEvolution_kroneckerSum (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ) (t : ℝ) :
    unitaryEvolution (kroneckerSum A B) t =
      (unitaryEvolution A t) ⊗ₖ (unitaryEvolution B t) := by
  have hgen : (t : ℝ) • ((-Complex.I) • kroneckerSum A B) =
      kroneckerSum (t • ((-Complex.I) • A)) (t • ((-Complex.I) • B)) := by
    rw [kroneckerSum, kroneckerSum, smul_add, smul_add, Matrix.smul_kronecker,
      Matrix.smul_kronecker, Matrix.kronecker_smul, Matrix.kronecker_smul]
  rw [unitaryEvolution, hgen, exp_kroneckerSum, unitaryEvolution, unitaryEvolution]

/-- **Decoupled evolution of a product state.**  A product state under a Kronecker-sum generator
evolves factorwise. -/
theorem unitaryEvolution_kroneckerSum_mulVec_tensorVec
    (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ) (t : ℝ) (u : ι → ℂ) (v : κ → ℂ) :
    unitaryEvolution (kroneckerSum A B) t *ᵥ binaryTensorVec u v =
      binaryTensorVec (unitaryEvolution A t *ᵥ u) (unitaryEvolution B t *ᵥ v) := by
  rw [unitaryEvolution_kroneckerSum, kronecker_mulVec_binaryTensorVec]

end GaloisForLFunctions.HTGeometry
