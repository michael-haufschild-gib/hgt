import GaloisForLFunctions.HTGeometry.GradedSullivanStage

/-!
# Sullivan towers on generators of mixed degree, indexed by an arbitrary order

A relative Sullivan tower assigns to every generator a level in an ordered index set and requires
the differential of a generator to lie in the subalgebra generated by the base together with the
generators of strictly smaller level.  Nothing forces the index set to be the natural numbers: it
may be any directed order, in particular any set of ordinals, and the stage at a limit level is
automatically the union of the earlier stages because a subalgebra generated by a set of generators
is determined by that set.

* `deningerGCASubalgebra` : the subalgebra generated by a set of generators, with the stability of
  such a subalgebra under the grading involution and under a lower-triangular odd derivation.
* `DeningerGCATower` : a tower, with its differential, `d² = 0`, and its stage subalgebras.
* `DeningerGCATower.stage_stable` : every stage is a differential subalgebra.
* `DeningerGCATower.cohomology_computed_at_stages` : the limit-stage comparison, over any directed
  index order.
-/

namespace HTGeometry

section GCAGenerators

variable {k G : Type*} [CommRing k] {deg : G → ℕ}

/-- The subalgebra generated by a set of generators. -/
def deningerGCASubalgebra (k : Type*) [CommRing k] {G : Type*} (deg : G → ℕ) (T : Set G) :
    Subalgebra k (DeningerFreeGCA k G deg) :=
  Algebra.adjoin k (deningerGCAι k deg '' T)

theorem deningerGCASubalgebra_ι {T : Set G} {x : G} (hx : x ∈ T) :
    deningerGCAι k deg x ∈ deningerGCASubalgebra k deg T :=
  Algebra.subset_adjoin ⟨x, hx, rfl⟩

theorem deningerGCASubalgebra_mono {T T' : Set G} (h : T ⊆ T') :
    deningerGCASubalgebra k deg T ≤ deningerGCASubalgebra k deg T' :=
  Algebra.adjoin_mono (Set.image_mono h)

/-- **All the generators generate.** -/
theorem deningerGCASubalgebra_univ (k : Type*) [CommRing k] {G : Type*} (deg : G → ℕ) :
    deningerGCASubalgebra k deg (Set.univ : Set G) = ⊤ := by
  have h : ∀ z : DeningerFreeGCA k G deg, z ∈ deningerGCASubalgebra k deg (Set.univ : Set G) := by
    intro z
    induction z using deningerGCA_induction with
    | algMap r => exact Subalgebra.algebraMap_mem _ r
    | gen x => exact deningerGCASubalgebra_ι (Set.mem_univ x)
    | mul a b ha hb => exact Subalgebra.mul_mem _ ha hb
    | add a b ha hb => exact Subalgebra.add_mem _ ha hb
  exact le_antisymm le_top fun z _ => h z

/-- **The grading involution preserves every generated subalgebra.** -/
theorem deningerGCAInvolute_mem_subalgebra {T : Set G} {z : DeningerFreeGCA k G deg}
    (hz : z ∈ deningerGCASubalgebra k deg T) :
    deningerGCAInvolute k deg z ∈ deningerGCASubalgebra k deg T := by
  induction hz using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨x, hx, rfl⟩ := hy
    rw [deningerGCAInvolute_ι]
    exact Subalgebra.smul_mem _ (deningerGCASubalgebra_ι hx) _
  | algebraMap r =>
    rw [AlgHom.commutes]
    exact Subalgebra.algebraMap_mem _ r
  | add a b _ _ ha hb =>
    rw [map_add]
    exact Subalgebra.add_mem _ ha hb
  | mul a b _ _ ha hb =>
    rw [map_mul]
    exact Subalgebra.mul_mem _ ha hb

/-- **Lower triangularity makes a generated subalgebra a differential subalgebra.**  If the values
of the derivation on the generators of a set already lie in the subalgebra that set generates, then
that subalgebra is stable under the derivation. -/
theorem deningerGCAOddDerivation_mem_subalgebra (phi : G → DeningerFreeGCA k G deg)
    (hphi : ∀ x y : G, deningerGCAι k deg x * phi y =
      ((-1 : k) ^ (deg x * (deg y + 1))) • (phi y * deningerGCAι k deg x))
    {T : Set G} (hstage : ∀ x ∈ T, phi x ∈ deningerGCASubalgebra k deg T)
    {z : DeningerFreeGCA k G deg} (hz : z ∈ deningerGCASubalgebra k deg T) :
    deningerGCAOddDerivation phi hphi z ∈ deningerGCASubalgebra k deg T := by
  induction hz using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨x, hx, rfl⟩ := hy
    rw [deningerGCAOddDerivation_ι]
    exact hstage x hx
  | algebraMap r =>
    rw [deningerGCAOddDerivation_algebraMap]
    exact Subalgebra.zero_mem _
  | add a b _ _ ha hb =>
    rw [map_add]
    exact Subalgebra.add_mem _ ha hb
  | mul a b ha' hb' ha hb =>
    rw [deningerGCAOddDerivation_leibniz]
    exact Subalgebra.add_mem _
      (Subalgebra.mul_mem _ (deningerGCAInvolute_mem_subalgebra ha') hb)
      (Subalgebra.mul_mem _ ha hb')

section Directed

variable {B : Type*} [Preorder B] [IsDirected B (· ≤ ·)] [Nonempty B]

/-- **Every element already lies at a stage.**  A free graded-commutative algebra on an exhausted
filtration of generators is the directed union of the subalgebras the stages generate; no separate
construction of the limit stage is required. -/
theorem deningerGCASubalgebra_exists_stage (T : B → Set G) (hmono : Monotone T)
    (hexh : ∀ x : G, ∃ b, x ∈ T b) (z : DeningerFreeGCA k G deg) :
    ∃ b, z ∈ deningerGCASubalgebra k deg (T b) := by
  induction z using deningerGCA_induction with
  | algMap r =>
    obtain ⟨b⟩ := (inferInstance : Nonempty B)
    exact ⟨b, Subalgebra.algebraMap_mem _ r⟩
  | gen x =>
    obtain ⟨b, hb⟩ := hexh x
    exact ⟨b, deningerGCASubalgebra_ι hb⟩
  | mul a b ha hb =>
    obtain ⟨b₁, hb₁⟩ := ha
    obtain ⟨b₂, hb₂⟩ := hb
    obtain ⟨c, hc₁, hc₂⟩ := directed_of (· ≤ ·) b₁ b₂
    exact ⟨c, Subalgebra.mul_mem _ (deningerGCASubalgebra_mono (hmono hc₁) hb₁)
      (deningerGCASubalgebra_mono (hmono hc₂) hb₂)⟩
  | add a b ha hb =>
    obtain ⟨b₁, hb₁⟩ := ha
    obtain ⟨b₂, hb₂⟩ := hb
    obtain ⟨c, hc₁, hc₂⟩ := directed_of (· ≤ ·) b₁ b₂
    exact ⟨c, Subalgebra.add_mem _ (deningerGCASubalgebra_mono (hmono hc₁) hb₁)
      (deningerGCASubalgebra_mono (hmono hc₂) hb₂)⟩

/-- The stage subalgebras of an exhausted filtration have the whole algebra as supremum. -/
theorem deningerGCASubalgebra_iSup (T : B → Set G) (hmono : Monotone T)
    (hexh : ∀ x : G, ∃ b, x ∈ T b) :
    ⨆ b, deningerGCASubalgebra k deg (T b) = ⊤ := by
  refine le_antisymm le_top fun z _ => ?_
  obtain ⟨b, hb⟩ := deningerGCASubalgebra_exists_stage T hmono hexh z
  exact Algebra.mem_iSup_of_mem b hb

end Directed

end GCAGenerators

section Tower

variable (k : Type*) [CommRing k] (B : Type*) [Preorder B]

/-- **A relative Sullivan tower on generators of mixed degree.**  Each generator carries a level in
an ordered index set, and the differential of a generator lies in the subalgebra generated by the
base together with the generators of strictly smaller level. -/
structure DeningerGCATower where
  /-- The generators of the tower. -/
  gen : Type*
  /-- The degree of each generator. -/
  deg : gen → ℕ
  /-- The level at which each generator is attached. -/
  lvl : gen → B
  /-- The generators present at every stage. -/
  base : Set gen
  /-- The values of the differential on the generators. -/
  phi : gen → DeningerFreeGCA k gen deg
  /-- The generator values graded-commute as elements of degree one more than their generator. -/
  hphi : ∀ x y : gen, deningerGCAι k deg x * phi y =
    ((-1 : k) ^ (deg x * (deg y + 1))) • (phi y * deningerGCAι k deg x)
  /-- The generator values transform under the involution as elements of that degree. -/
  hinv : ∀ x : gen, deningerGCAInvolute k deg (phi x) = ((-1 : k) ^ (deg x + 1)) • phi x
  /-- The differential kills its own generator values. -/
  hkill : ∀ x : gen, deningerGCAOddDerivation phi hphi (phi x) = 0
  /-- The base is closed under the differential, so it is a sub-differential-graded-algebra. -/
  base_lower : ∀ x ∈ base, phi x ∈ deningerGCASubalgebra k deg base
  /-- **Lower triangularity**: the differential of an attached generator involves only the base and
  the generators of strictly smaller level. -/
  lower : ∀ x : gen, x ∉ base →
    phi x ∈ deningerGCASubalgebra k deg (base ∪ {y : gen | lvl y < lvl x})

variable {k B}

namespace DeningerGCATower

variable (T : DeningerGCATower k B)

/-- The differential of a tower. -/
noncomputable def d : DeningerFreeGCA k T.gen T.deg →ₗ[k] DeningerFreeGCA k T.gen T.deg :=
  deningerGCAOddDerivation T.phi T.hphi

@[simp]
theorem d_ι (x : T.gen) : T.d (deningerGCAι k T.deg x) = T.phi x :=
  deningerGCAOddDerivation_ι _ _ x

@[simp]
theorem d_algebraMap (r : k) :
    T.d (algebraMap k (DeningerFreeGCA k T.gen T.deg) r) = 0 :=
  deningerGCAOddDerivation_algebraMap _ _ r

/-- **The graded Leibniz rule of a tower.** -/
theorem d_leibniz (z w : DeningerFreeGCA k T.gen T.deg) :
    T.d (z * w) = deningerGCAInvolute k T.deg z * T.d w + T.d z * w :=
  deningerGCAOddDerivation_leibniz _ _ z w

/-- **The differential of a tower squares to zero**, so a relative Sullivan tower on generators of
mixed degree is a differential graded algebra. -/
theorem d_comp_self (z : DeningerFreeGCA k T.gen T.deg) : T.d (T.d z) = 0 :=
  deningerGCAOddDerivation_comp_self _ _ T.hinv T.hkill z

/-- **A generator is closed exactly when the differential kills it**, so degree-one cohomology of a
tower is governed by the vanishing locus of its generator assignment. -/
theorem d_ι_eq_zero_iff (x : T.gen) : T.d (deningerGCAι k T.deg x) = 0 ↔ T.phi x = 0 := by
  rw [T.d_ι]

/-- The generators available at a stage: the base together with everything of level at most `b`. -/
def stageGen (b : B) : Set T.gen := T.base ∪ {y : T.gen | T.lvl y ≤ b}

theorem stageGen_mono : Monotone T.stageGen := fun _ _ h =>
  Set.union_subset_union_right _ fun _ hy => le_trans hy h

theorem mem_stageGen (x : T.gen) : x ∈ T.stageGen (T.lvl x) :=
  Or.inr le_rfl

/-- The stage subalgebra of a tower. -/
def stage (b : B) : Subalgebra k (DeningerFreeGCA k T.gen T.deg) :=
  deningerGCASubalgebra k T.deg (T.stageGen b)

theorem stage_mono : Monotone T.stage := fun _ _ h =>
  deningerGCASubalgebra_mono (T.stageGen_mono h)

theorem stage_ι {b : B} {x : T.gen} (hx : x ∈ T.stageGen b) :
    deningerGCAι k T.deg x ∈ T.stage b :=
  deningerGCASubalgebra_ι hx

/-- **The differential of a generator of a stage stays at that stage.** -/
theorem phi_mem_stage (b : B) {x : T.gen} (hx : x ∈ T.stageGen b) : T.phi x ∈ T.stage b := by
  by_cases hbase : x ∈ T.base
  · exact deningerGCASubalgebra_mono Set.subset_union_left (T.base_lower x hbase)
  · have hlvl : T.lvl x ≤ b := hx.resolve_left hbase
    refine deningerGCASubalgebra_mono ?_ (T.lower x hbase)
    exact Set.union_subset_union_right _ fun _ hy => le_of_lt (lt_of_lt_of_le hy hlvl)

/-- **Every stage of a tower is a differential subalgebra.** -/
theorem stage_stable (b : B) {z : DeningerFreeGCA k T.gen T.deg} (hz : z ∈ T.stage b) :
    T.d z ∈ T.stage b :=
  deningerGCAOddDerivation_mem_subalgebra T.phi T.hphi (fun _ hx => T.phi_mem_stage b hx) hz

/-- The grading involution preserves every stage. -/
theorem stage_involute (b : B) {z : DeningerFreeGCA k T.gen T.deg} (hz : z ∈ T.stage b) :
    deningerGCAInvolute k T.deg z ∈ T.stage b :=
  deningerGCAInvolute_mem_subalgebra hz

section Directed

variable [IsDirected B (· ≤ ·)] [Nonempty B]

/-- **Every element of the algebra already lies at a stage of the tower.**  In particular a stage at
a limit level of the index order is the union of the earlier stages, with no separate construction:
this is the limit-stage step of the transfinite factorization. -/
theorem exists_stage (z : DeningerFreeGCA k T.gen T.deg) : ∃ b, z ∈ T.stage b :=
  deningerGCASubalgebra_exists_stage T.stageGen T.stageGen_mono
    (fun x => ⟨T.lvl x, T.mem_stageGen x⟩) z

/-- **The stages of a tower exhaust the whole algebra.** -/
theorem iSup_stage : ⨆ b, T.stage b = ⊤ :=
  deningerGCASubalgebra_iSup T.stageGen T.stageGen_mono fun x => ⟨T.lvl x, T.mem_stageGen x⟩

/-- **A cocycle of the tower is a cocycle of some stage.** -/
theorem cocycle_exists_stage {z : DeningerFreeGCA k T.gen T.deg} (hz : T.d z = 0) :
    ∃ b, z ∈ T.stage b ∧ T.d z = 0 := by
  obtain ⟨b, hb⟩ := T.exists_stage z
  exact ⟨b, hb, hz⟩

/-- **A class present at a stage that dies in the tower already dies at a later stage.** -/
theorem coboundary_exists_stage_ge {z w : DeningerFreeGCA k T.gen T.deg} (b : B)
    (hzw : T.d w = z) : ∃ b', b ≤ b' ∧ w ∈ T.stage b' ∧ T.d w = z := by
  obtain ⟨c, hc⟩ := T.exists_stage w
  obtain ⟨b', hbb', hcb'⟩ := directed_of (· ≤ ·) b c
  exact ⟨b', hbb', T.stage_mono hcb' hc, hzw⟩

/-- **The cohomology of a tower is computed at its stages.**  Every cocycle is already a cocycle of
some stage, and a class present at a stage which becomes a coboundary in the whole tower already
becomes one at a later stage.  Because the index order is an arbitrary directed order, this covers
the passage through limit levels. -/
theorem cohomology_computed_at_stages :
    (∀ z : DeningerFreeGCA k T.gen T.deg, T.d z = 0 → ∃ b, z ∈ T.stage b ∧ T.d z = 0) ∧
      (∀ (b : B) (z w : DeningerFreeGCA k T.gen T.deg), T.d w = z →
        ∃ b', b ≤ b' ∧ w ∈ T.stage b' ∧ T.d w = z) :=
  ⟨fun _ hz => T.cocycle_exists_stage hz, fun b _ _ hzw => T.coboundary_exists_stage_ge b hzw⟩

/-- **Acyclicity from stagewise killing.**  If every cocycle present at a stage becomes a coboundary
at a later stage, the tower is acyclic.  This is the limit-stage argument that makes the successor
attachments of a transfinite factorization add up. -/
theorem cocycle_isCoboundary_of_stagewise
    (hstage : ∀ (b : B) (z : DeningerFreeGCA k T.gen T.deg), z ∈ T.stage b → T.d z = 0 →
      ∃ b', b ≤ b' ∧ ∃ w ∈ T.stage b', T.d w = z)
    {z : DeningerFreeGCA k T.gen T.deg} (hz : T.d z = 0) : ∃ w, T.d w = z := by
  obtain ⟨b, hb⟩ := T.exists_stage z
  obtain ⟨_, _, w, _, hw⟩ := hstage b z hb hz
  exact ⟨w, hw⟩

end Directed

end DeningerGCATower

end Tower

section IterateTower

variable {k : Type*} [CommRing k]

namespace DeningerGCAStage

/-- The level of a limit generator: the generators of the base stage sit at level `0`, and a
generator attached at stage `n` sits at level `n + 1`. -/
def iterateOmegaLvl (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S)
    (S : DeningerGCAStage k) : iterateOmegaGen choose S → ℕ :=
  Sum.elim (fun _ => 0) (fun p => p.1 + 1)

/-- **A generator of a stage has level at most that stage.** -/
theorem iterateGenToOmega_lvl_le (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S)
    (S : DeningerGCAStage k) : ∀ (n : ℕ) (x : (iterate choose S n).gen),
      iterateOmegaLvl choose S (iterateGenToOmega choose S n x) ≤ n
  | 0, _ => le_rfl
  | n + 1, x => by
    cases x with
    | inl y => exact le_trans (iterateGenToOmega_lvl_le choose S n y) (Nat.le_succ n)
    | inr m => exact le_rfl

/-- **The image of a stage lies in the subalgebra generated by that stage's generators.** -/
theorem iterateToOmega_mem_subalgebra
    (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S) (S : DeningerGCAStage k)
    (n : ℕ) (z : DeningerFreeGCA k (iterate choose S n).gen (iterate choose S n).deg) :
    iterateToOmega choose S n z ∈
      deningerGCASubalgebra k (iterateOmegaDeg choose S)
        (Set.range (iterateGenToOmega choose S n)) := by
  induction z using deningerGCA_induction with
  | algMap r =>
    rw [AlgHom.commutes]
    exact Subalgebra.algebraMap_mem _ r
  | gen x =>
    rw [iterateToOmega_ι]
    exact deningerGCASubalgebra_ι ⟨x, rfl⟩
  | mul a b ha hb =>
    rw [map_mul]
    exact Subalgebra.mul_mem _ ha hb
  | add a b ha hb =>
    rw [map_add]
    exact Subalgebra.add_mem _ ha hb

/-- **The iterated tower as a relative Sullivan tower indexed by the natural numbers.**  Its
generators are those of the limit stage, graded by the step at which they were attached, and its
lower triangularity is the statement that a generator attached at step `n` kills a class built from
the generators available before step `n`. -/
noncomputable def iterateTower (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S)
    (S : DeningerGCAStage k) : DeningerGCATower k ℕ where
  gen := iterateOmegaGen choose S
  deg := iterateOmegaDeg choose S
  lvl := iterateOmegaLvl choose S
  base := Set.range (Sum.inl : S.gen → iterateOmegaGen choose S)
  phi := iterateOmegaPhi choose S
  hphi := iterateOmegaPhi_hphi choose S
  hinv := iterateOmegaPhi_hinv choose S
  hkill := iterateOmegaPhi_hkill choose S
  base_lower := by
    rintro u ⟨x, rfl⟩
    exact iterateToOmega_mem_subalgebra choose S 0 (S.phi x)
  lower := by
    rintro u hu
    cases u with
    | inl x => exact absurd ⟨x, rfl⟩ hu
    | inr p =>
      refine deningerGCASubalgebra_mono ?_ (iterateToOmega_mem_subalgebra choose S p.1
        ((choose (iterate choose S p.1)).psi p.2))
      rintro _ ⟨x, rfl⟩
      exact Or.inr (Nat.lt_succ_of_le (iterateGenToOmega_lvl_le choose S p.1 x))

/-- **The tower's differential is the differential of the limit stage.**  The two constructions —
iterating successor attachments and then taking the union, and presenting the whole generator set at
once with its levels — carry the same differential graded algebra. -/
theorem iterateTower_d (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S)
    (S : DeningerGCAStage k)
    (z : DeningerFreeGCA k (iterateOmegaGen choose S) (iterateOmegaDeg choose S)) :
    (iterateTower choose S).d z = (iterateOmega choose S).d z := rfl

/-- **Each stage of the iterated tower lands in the corresponding stage of the level filtration.** -/
theorem iterateToOmega_mem_stage (choose : ∀ S : DeningerGCAStage k, DeningerGCAAttachment S)
    (S : DeningerGCAStage k) (n : ℕ)
    (z : DeningerFreeGCA k (iterate choose S n).gen (iterate choose S n).deg) :
    iterateToOmega choose S n z ∈ (iterateTower choose S).stage n := by
  refine deningerGCASubalgebra_mono ?_ (iterateToOmega_mem_subalgebra choose S n z)
  rintro _ ⟨x, rfl⟩
  exact Or.inr (iterateGenToOmega_lvl_le choose S n x)

end DeningerGCAStage

end IterateTower

end HTGeometry
