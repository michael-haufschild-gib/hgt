/-!
# Lower-state retention at the terminal Wiman place

The outer Laurent valuation is trivial on the complete rational field generated by the terminal
input state.  A relative Gauss extension across all earlier independent states therefore contains
the entire lower rational state field, including every inverse and cancellation, and embeds the
complete lower derivative branch faithfully in residue.
-/

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher HahnSeries Polynomial PowerSeries
open scoped LaurentSeries

noncomputable section

set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 2000000

attribute [local instance] cascadeUnitCostDomain cascadeUnitCostRatFuncAlgebra
  cascadeUnitCostComplexAlgebra cascadeUnitCostScalarTower cascadeUnitCostDifferential
  cascadeUnitCostCharZero

local instance (priority := high) terminalComplexAlgebra :
    Algebra ℂ FirstOrderTerminalLaurentField :=
  firstOrderTerminalComplexMap.toAlgebra

/-- Coefficient constants are integral for the standard Laurent-series valuation. -/
theorem algebraMap_mem_laurentSeriesValuationSubring
    {K : Type*} [Field K] (c : K) :
    algebraMap K (LaurentSeries K) c ∈ laurentSeriesValuationSubring K := by
  change (Valued.v : Valuation (LaurentSeries K) (WithZero (Multiplicative ℤ)))
      (algebraMap K (LaurentSeries K) c) ≤ 1
  rw [LaurentSeries.val_le_one_iff_eq_coe]
  refine ⟨PowerSeries.C c, ?_⟩
  rw [LaurentSeries.algebraMap_apply]
  exact PowerSeries.coe_C c

/-- Terminal input state, lifted from the adjacent pair field to the terminal component. -/
noncomputable def terminalLeadingStateInComponent
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : NonautonomousFiniteCascadeTerminalComponentField hfan N :=
  algebraMap
    (NonautonomousFiniteCascadeTerminalPairField hfan N)
    (NonautonomousFiniteCascadeTerminalComponentField hfan N)
    ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 0,
      IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 0)⟩

/-- Rational field generated by the terminal input state inside the terminal component. -/
abbrev TerminalLeadingStateField
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (N : ℕ) : Type :=
  IntermediateField.adjoin ℂ ({terminalLeadingStateInComponent hfan N} :
    Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))

/-- The terminal input state maps to the inner Laurent-series coefficient used by the two-stage
Wiman construction. -/
theorem firstOrderTerminalRationalStateEval_pair_zero
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (U : LaurentSeries ℂ) (V W : FirstOrderTerminalLaurentField)
    (hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W))) :
    firstOrderRationalStateEval (firstOrderTerminalJet U V W) hinj
        ((terminalEvalEquiv hfan hall N).symm
          ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 0,
            IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 0)⟩) =
      algebraMap FirstOrderTerminalCoefficientField
        FirstOrderTerminalLaurentField
        (algebraMap (LaurentSeries ℂ) FirstOrderTerminalCoefficientField U) := by
  let E := terminalEvalEquiv hfan hall N
  have hpre : E.symm
      ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 0,
        IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 0)⟩ =
      algebraMap FirstOrderStatePolynomialRing FirstOrderRationalStateField
        Polynomial.X := by
    apply E.injective
    rw [E.apply_symm_apply]
    change _ = nonautonomousFiniteCascadeTerminalRationalStateEval hfan hall N
      (algebraMap FirstOrderStatePolynomialRing FirstOrderRationalStateField Polynomial.X)
    exact (terminalEval_outer hfan hall N).symm
  rw [hpre, firstOrderRationalStateEval_algebraMap]
  rw [← firstOrderStatePolynomialEquiv_X_zero,
    firstOrderStatePolynomialEval_equiv]
  simp [firstOrderTerminalJet]

/-- The terminal output-state coordinate maps to the outer Laurent uniformizer. -/
theorem firstOrderTerminalRationalStateEval_pair_one
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (U : LaurentSeries ℂ) (V W : FirstOrderTerminalLaurentField)
    (hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W))) :
    firstOrderRationalStateEval (firstOrderTerminalJet U V W) hinj
        ((terminalEvalEquiv hfan hall N).symm
          ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 1,
            IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 1)⟩) = V := by
  let E := terminalEvalEquiv hfan hall N
  have hpre : E.symm
      ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 1,
        IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 1)⟩ =
      algebraMap FirstOrderStatePolynomialRing FirstOrderRationalStateField
        (Polynomial.C Polynomial.X) := by
    apply E.injective
    rw [E.apply_symm_apply]
    change _ = nonautonomousFiniteCascadeTerminalRationalStateEval hfan hall N
      (algebraMap FirstOrderStatePolynomialRing FirstOrderRationalStateField
        (Polynomial.C Polynomial.X))
    exact (terminalEval_inner hfan hall N).symm
  rw [hpre, firstOrderRationalStateEval_algebraMap]
  rw [← firstOrderStatePolynomialEquiv_X_one,
    firstOrderStatePolynomialEval_equiv]
  simp [firstOrderTerminalJet]

/-- A negative Laurent monomial is a genuine pole of the standard Laurent-series valuation. -/
theorem hahnSingle_negative_not_mem_laurentSeriesValuationSubring
    {K : Type*} [Field K] (R : ℕ) (hR : R ≠ 0) :
    HahnSeries.single (-((R : ℕ) : ℤ)) (1 : K) ∉
      laurentSeriesValuationSubring K := by
  rw [mem_laurentSeriesValuationSubring_iff,
    LaurentSeries.val_le_one_iff_eq_coe]
  rintro ⟨p, hp⟩
  have hcoeff := congrArg
    (fun x : LaurentSeries K => x.coeff (-((R : ℕ) : ℤ))) hp
  rw [HahnSeries.coeff_single] at hcoeff
  simp [HahnSeries.ofPowerSeries_apply, HahnSeries.embDomain, hR] at hcoeff

/-- The prescribed terminal Wiman power series has nonzero constant coefficient.  This is the
exact coefficient that remains after dividing terminal velocity by terminal state. -/
theorem terminalWimanPowerSeries_constantCoeff_ne_zero
    (M a Nram : ℕ) (z₀ : PowerSeries ℂ)
    (z : PowerSeries FirstOrderTerminalCoefficientField)
    (c : ℂ) (hc : c ≠ 0)
    (hz₀ : PowerSeries.constantCoeff z₀ = c)
    (hz : PowerSeries.constantCoeff z =
      algebraMap (LaurentSeries ℂ) FirstOrderTerminalCoefficientField
        (HahnSeries.single (-((Nram * M : ℕ) : ℤ)) (1 : ℂ) *
          algebraMap (PowerSeries ℂ) (LaurentSeries ℂ)
            ((PowerSeries.X : PowerSeries ℂ) ^ (Nram * a) * z₀))) :
    PowerSeries.constantCoeff z ≠ 0 := by
  rw [hz]
  apply (map_ne_zero
    (algebraMap (LaurentSeries ℂ) FirstOrderTerminalCoefficientField)).2
  apply mul_ne_zero
  · simp
  · change (((PowerSeries.X : PowerSeries ℂ) ^ (Nram * a) * z₀ :
      PowerSeries ℂ) : LaurentSeries ℂ) ≠ 0
    intro hzero
    have hzero' : (PowerSeries.X : PowerSeries ℂ) ^ (Nram * a) * z₀ = 0 :=
      (HahnSeries.ofPowerSeries_injective (Γ := ℤ)) (by simpa using hzero)
    exact (mul_ne_zero (pow_ne_zero _ PowerSeries.X_ne_zero) (by
      intro hz₀zero
      apply hc
      rw [← hz₀, hz₀zero, map_zero])) hzero'

/-- The normalized Wiman coefficient is integral at the outer Laurent place. -/
theorem coe_terminalWimanPowerSeries_mem
    (z : PowerSeries FirstOrderTerminalCoefficientField)
    (hz : PowerSeries.constantCoeff z ≠ 0) :
    algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
        FirstOrderTerminalLaurentField z ∈
      laurentSeriesValuationSubring FirstOrderTerminalCoefficientField := by
  change (z : FirstOrderTerminalLaurentField) ∈
    laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
  rw [mem_laurentSeriesValuationSubring_iff]
  rw [laurent_valuation_coe_powerSeries_eq_one_of_constantCoeff_ne_zero _ hz]

/-- The inverse normalized Wiman coefficient is integral as well, so its residue is nonzero. -/
theorem inv_coe_terminalWimanPowerSeries_mem
    (z : PowerSeries FirstOrderTerminalCoefficientField)
    (hz : PowerSeries.constantCoeff z ≠ 0) :
    (algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
        FirstOrderTerminalLaurentField z)⁻¹ ∈
      laurentSeriesValuationSubring FirstOrderTerminalCoefficientField := by
  change (z : FirstOrderTerminalLaurentField)⁻¹ ∈
    laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
  rw [mem_laurentSeriesValuationSubring_iff, map_inv₀]
  rw [laurent_valuation_coe_powerSeries_eq_one_of_constantCoeff_ne_zero _ hz]
  simp

/-- An integral nonzero element whose inverse is integral has nonzero residue. -/
theorem valuationSubring_residue_ne_zero_of_mem_inv_mem
    {K : Type*} [Field K] (A : ValuationSubring K)
    {x : K} (hx : x ∈ A) (hinv : x⁻¹ ∈ A) (hx0 : x ≠ 0) :
    IsLocalRing.residue A (⟨x, hx⟩ : A) ≠ 0 := by
  intro hzero
  have hmax : (⟨x, hx⟩ : A) ∈ IsLocalRing.maximalIdeal A :=
    (IsLocalRing.residue_eq_zero_iff (⟨x, hx⟩ : A)).mp hzero
  apply (IsLocalRing.notMem_maximalIdeal.mpr ?_) hmax
  exact isUnit_iff_exists_inv.mpr
    ⟨⟨x⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hx0)⟩

/-- Dividing the terminal Wiman velocity by its state pole leaves exactly its power-series unit. -/
theorem terminalWiman_W_div_V
    (R : ℕ) (z : PowerSeries FirstOrderTerminalCoefficientField) :
    let V := HahnSeries.single (-((R : ℕ) : ℤ))
      (1 : FirstOrderTerminalCoefficientField)
    let W := HahnSeries.single (-((R : ℕ) : ℤ))
        (1 : FirstOrderTerminalCoefficientField) *
      algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
        FirstOrderTerminalLaurentField z
    W / V = algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
      FirstOrderTerminalLaurentField z := by
  dsimp only
  field_simp

/-- Literal terminal constituent velocity never vanishes. -/
theorem nonautonomousFiniteCascadeTerminalVelocitySucc_ne_zero
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    nonautonomousFiniteCascadeTerminalVelocitySucc hfan N ≠ 0 := by
  intro hzero
  have hcoe := congrArg
    (fun x : NonautonomousFiniteCascadeBranchField hfan (N + 1) =>
      (x : meroField Set.univ)) hzero
  change cascadeMeroDeriv hfan (N + 1) / cascadeMeroDeriv hfan N = 0 at hcoe
  exact (div_ne_zero
    (cascadeMeroDeriv_ne_zero_of_transcendental hfan hall (N + 1))
    (cascadeMeroDeriv_ne_zero_of_transcendental hfan hall N)) hcoe

/-- Literal terminal state never vanishes. -/
theorem nonautonomousFiniteCascadeTerminalStateSucc_ne_zero
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    nonautonomousFiniteCascadeTerminalStateSucc hfan N ≠ 0 := by
  exact (algebraicIndependent_nonautonomousFiniteCascadeStateInBranchField
    hfan hall (N + 1)).ne_zero (Fin.last (N + 1))

/-- Literal normalized terminal constituent velocity never vanishes. -/
theorem nonautonomousFiniteCascadeTerminalNormalizedVelocitySucc_ne_zero
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ) :
    nonautonomousFiniteCascadeTerminalVelocitySucc hfan N /
      nonautonomousFiniteCascadeTerminalStateSucc hfan N ≠ 0 :=
  div_ne_zero (nonautonomousFiniteCascadeTerminalVelocitySucc_ne_zero hfan hall N)
    (nonautonomousFiniteCascadeTerminalStateSucc_ne_zero hfan hall N)

/-- Pulling the outer Laurent valuation to the actual terminal component is trivial on the
complete rational field generated by the terminal input state. -/
theorem terminalWimanComponentValuation_trivial_leadingState
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (U : LaurentSeries ℂ) (V W : FirstOrderTerminalLaurentField)
    (hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W)))
    (φ : NonautonomousFiniteCascadeTerminalComponentField hfan N →+*
      FirstOrderTerminalLaurentField)
    (hφbase : ∀ b : NonautonomousFiniteCascadeTerminalPairField hfan N,
      φ (algebraMap
        (NonautonomousFiniteCascadeTerminalPairField hfan N)
        (NonautonomousFiniteCascadeTerminalComponentField hfan N) b) =
      firstOrderRationalStateEval (firstOrderTerminalJet U V W) hinj
        ((terminalEvalEquiv hfan hall N).symm b)) :
    ((laurentSeriesValuationSubring FirstOrderTerminalCoefficientField).comap φ).comap
      (IntermediateField.adjoin ℂ
        ({terminalLeadingStateInComponent hfan N} :
          Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))).val.toRingHom = ⊤ := by
  apply SetLike.ext
  intro y
  constructor
  · intro _
    trivial
  · intro _
    change φ (y : NonautonomousFiniteCascadeTerminalComponentField hfan N) ∈
      laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
    have hyCoeff : ∃ c : FirstOrderTerminalCoefficientField,
        φ (y : NonautonomousFiniteCascadeTerminalComponentField hfan N) =
          algebraMap FirstOrderTerminalCoefficientField
            FirstOrderTerminalLaurentField c := by
      apply IntermediateField.adjoin_induction ℂ
        (p := fun z _ => ∃ c : FirstOrderTerminalCoefficientField,
          φ z = algebraMap FirstOrderTerminalCoefficientField
            FirstOrderTerminalLaurentField c) _ _ _ _ _ y.property
      · intro z hz
        rw [Set.mem_singleton_iff] at hz
        subst z
        let b0 : NonautonomousFiniteCascadeTerminalPairField hfan N :=
          ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 0,
            IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 0)⟩
        refine ⟨algebraMap (LaurentSeries ℂ) FirstOrderTerminalCoefficientField U, ?_⟩
        change φ (algebraMap
            (NonautonomousFiniteCascadeTerminalPairField hfan N)
            (NonautonomousFiniteCascadeTerminalComponentField hfan N) b0) = _
        rw [hφbase]
        exact firstOrderTerminalRationalStateEval_pair_zero hfan hall N U V W hinj
      · intro c
        refine ⟨algebraMap (LaurentSeries ℂ) FirstOrderTerminalCoefficientField
          (algebraMap ℂ (LaurentSeries ℂ) c), ?_⟩
        let b : NonautonomousFiniteCascadeTerminalPairField hfan N :=
          algebraMap ℂ (NonautonomousFiniteCascadeTerminalPairField hfan N) c
        have hb := hφbase b
        change φ (algebraMap ℂ
          (NonautonomousFiniteCascadeTerminalComponentField hfan N) c) = _
        rw [show algebraMap ℂ
            (NonautonomousFiniteCascadeTerminalComponentField hfan N) c =
          algebraMap
            (NonautonomousFiniteCascadeTerminalPairField hfan N)
            (NonautonomousFiniteCascadeTerminalComponentField hfan N) b by rfl,
          hb]
        rw [show (terminalEvalEquiv hfan hall N).symm b =
          algebraMap ℂ FirstOrderRationalStateField c by
            apply (terminalEvalEquiv hfan hall N).injective
            simp [b]]
        rw [(firstOrderRationalStateEval
          (firstOrderTerminalJet U V W) hinj).commutes c]
        rfl
      · intro a b _ _ ha hb
        obtain ⟨ca, hca⟩ := ha
        obtain ⟨cb, hcb⟩ := hb
        refine ⟨ca + cb, ?_⟩
        rw [map_add, hca, hcb, map_add]
      · intro a _ ha
        obtain ⟨ca, hca⟩ := ha
        refine ⟨ca⁻¹, ?_⟩
        rw [map_inv₀, hca, map_inv₀]
      · intro a b _ _ ha hb
        obtain ⟨ca, hca⟩ := ha
        obtain ⟨cb, hcb⟩ := hb
        refine ⟨ca * cb, ?_⟩
        rw [map_mul, hca, hcb, map_mul]
    obtain ⟨c, hc⟩ := hyCoeff
    rw [hc]
    exact algebraMap_mem_laurentSeriesValuationSubring c

/-- A valuation on the terminal component that is trivial on the terminal input field extends
to the full successor branch and contains the complete lower rational state field. -/
theorem exists_nonautonomousFiniteCascadeTerminalComponentValuation_extension_lowerState
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1)
    (A : ValuationSubring
      (NonautonomousFiniteCascadeTerminalComponentField hfan N))
    (hAtriv : A.comap
      (IntermediateField.adjoin ℂ
        ({terminalLeadingStateInComponent hfan N} :
          Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))).val.toRingHom = ⊤) :
    ∃ B : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)),
      B.comap (algebraMap
        (NonautonomousFiniteCascadeTerminalComponentField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1))) = A ∧
      ∀ x : NonautonomousRamifiedCascadeStateField hfan N,
        nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N x ∈ B := by
  let S : IntermediateField ℂ
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) :=
    IntermediateField.adjoin ℂ ({terminalLeadingStateInComponent hfan N} : Set _)
  let E := NonautonomousFiniteCascadeTerminalComponentField hfan N
  let K := NonautonomousFiniteCascadeBranchField hfan (N + 1)
  letI : IsScalarTower S E K := IsScalarTower.of_algebraMap_eq fun _ => rfl
  obtain ⟨B, hB, hBG⟩ :=
    exists_valuationSubring_extension_fin_algebraicIndependent_trivial_adjoin
      (S := S) A hAtriv
        (nonautonomousFiniteCascadeTerminalStateTail hfan N)
        (algebraicIndependent_nonautonomousFiniteCascadeTerminalStateTail_over_component
          hfan hall N h1)
  refine ⟨B, hB, ?_⟩
  intro x
  have hx : x ∈ IntermediateField.adjoin ℂ
      (Set.range (nonautonomousCascadeStateFamilyInStateField hfan N)) := by
    rw [adjoin_range_nonautonomousCascadeStateFamilyInStateField_eq_top]
    trivial
  let G : IntermediateField S K := IntermediateField.adjoin S
    (Set.range (nonautonomousFiniteCascadeTerminalStateTail hfan N))
  have hGmem : nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N x ∈ G := by
    apply IntermediateField.adjoin_induction ℂ
      (p := fun y _ =>
        nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N y ∈ G)
      _ _ _ _ _ hx
    · intro y hy
      rcases hy with ⟨i, rfl⟩
      change nonautonomousFiniteCascadeLowerStateAlgHomSucc hfan N
        (nonautonomousCascadeStateFamilyInStateField hfan N i) ∈ G
      rw [nonautonomousFiniteCascadeLowerStateAlgHomSucc_state]
      refine Fin.lastCases ?_ (fun j => ?_) i
      · let s0 : S :=
          ⟨terminalLeadingStateInComponent hfan N,
            IntermediateField.subset_adjoin ℂ _ (Set.mem_singleton _)⟩
        have hs0 : algebraMap S K s0 ∈ G := G.algebraMap_mem s0
        have hs0Eq : algebraMap S K s0 =
            nonautonomousFiniteCascadeTerminalStatePair hfan N 0 := by
          rfl
        change nonautonomousFiniteCascadeTerminalStatePair hfan N 0 ∈ G
        rw [← hs0Eq]
        exact hs0
      · exact IntermediateField.subset_adjoin S _ (Set.mem_range_self j)
    · intro c
      exact G.algebraMap_mem c
    · intro a b _ _ ha hb
      exact G.add_mem ha hb
    · intro a _ ha
      exact G.inv_mem ha
    · intro a b _ _ ha hb
      exact G.mul_mem ha hb
  change (⟨nonautonomousFiniteCascadeLowerStateInclusionSucc hfan N x, hGmem⟩ : G) ∈
    B.comap G.val.toRingHom
  change _ ∈ B.comap (IntermediateField.adjoin S
    (Set.range (nonautonomousFiniteCascadeTerminalStateTail hfan N))).val.toRingHom
  rw [hBG]
  trivial

/-- At the exact terminal Wiman place, the complete lower actual derivative branch embeds
faithfully in the residue field. -/
theorem exists_nonautonomousFiniteCascadeTerminalWimanLowerBranchResidueEmbedding
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    ∃ (B : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)))
      (e : NonautonomousFiniteCascadeBranchField hfan N →+*
        IsLocalRing.ResidueField B),
      Function.Injective e := by
  obtain ⟨M, a, q, Nram, hNram, z₀, R, hR, z, hq, φ, B₀,
      hslope, hz₀, hz, hdata⟩ :=
    exists_nonautonomousFiniteCascadeTerminalWimanValuation hfan hall N h1
  dsimp only at hdata
  rcases hdata with ⟨hφgen, hφbase, hBcomap, htail⟩
  let U := HahnSeries.single (-((Nram * q : ℕ) : ℤ)) (1 : ℂ)
  let V := HahnSeries.single (-((R : ℕ) : ℤ))
    (1 : FirstOrderTerminalCoefficientField)
  let W := HahnSeries.single (-((R : ℕ) : ℤ))
      (1 : FirstOrderTerminalCoefficientField) *
    algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
      FirstOrderTerminalLaurentField z
  let hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W)) :=
    firstOrderStatePolynomialEval_terminal_injective
      (-((Nram * q : ℕ) : ℤ)) (-((R : ℕ) : ℤ))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr (mul_ne_zero hNram hq)))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr hR)) W
  let A := (laurentSeriesValuationSubring FirstOrderTerminalCoefficientField).comap φ
  have hAtriv : A.comap
      (IntermediateField.adjoin ℂ
        ({terminalLeadingStateInComponent hfan N} :
          Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))).val.toRingHom = ⊤ :=
    terminalWimanComponentValuation_trivial_leadingState
      hfan hall N U V W hinj φ hφbase
  obtain ⟨B, hBcomap', hstate⟩ :=
    exists_nonautonomousFiniteCascadeTerminalComponentValuation_extension_lowerState
      hfan hall N h1 A hAtriv
  let e := nonautonomousFiniteCascadeLowerBranchResidueEmbedding
    hfan hall (fun k hk => h1 k (by omega)) B hstate
  exact ⟨B, e,
    nonautonomousFiniteCascadeLowerBranchResidueEmbedding_injective
      hfan hall (fun k hk => h1 k (by omega)) B hstate⟩

/-- Any prescribed valuation of the lower actual branch extends through a terminal Wiman place.
The extension contracts exactly and the new terminal state is a genuine pole.  Thus each
terminal-inward step adds one compatible flag coordinate without any global Puiseux-selection
premise. -/
theorem exists_nonautonomousFiniteCascadeTerminalWimanLowerBranchResidueEmbedding_pole
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1)
    (A₀ : ValuationSubring (NonautonomousFiniteCascadeBranchField hfan N)) :
    ∃ C : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)),
      C.comap (nonautonomousFiniteCascadeBranchInclusionSucc hfan N) = A₀ ∧
      (∀ x : NonautonomousFiniteCascadeBranchField hfan N,
        nonautonomousFiniteCascadeBranchInclusionSucc hfan N x ∈ C ↔ x ∈ A₀) ∧
      nonautonomousFiniteCascadeTerminalStateSucc hfan N ∉ C := by
  obtain ⟨M, a, q, Nram, hNram, z₀, R, hR, z, hq, φ, B₀,
      hslope, hz₀, hz, hdata⟩ :=
    exists_nonautonomousFiniteCascadeTerminalWimanValuation hfan hall N h1
  dsimp only at hdata
  rcases hdata with ⟨hφgen, hφbase, hBcomap, htail⟩
  let U := HahnSeries.single (-((Nram * q : ℕ) : ℤ)) (1 : ℂ)
  let V := HahnSeries.single (-((R : ℕ) : ℤ))
    (1 : FirstOrderTerminalCoefficientField)
  let W := HahnSeries.single (-((R : ℕ) : ℤ))
      (1 : FirstOrderTerminalCoefficientField) *
    algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
      FirstOrderTerminalLaurentField z
  let hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W)) :=
    firstOrderStatePolynomialEval_terminal_injective
      (-((Nram * q : ℕ) : ℤ)) (-((R : ℕ) : ℤ))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr (mul_ne_zero hNram hq)))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr hR)) W
  let A := (laurentSeriesValuationSubring FirstOrderTerminalCoefficientField).comap φ
  have hAtriv : A.comap
      (IntermediateField.adjoin ℂ
        ({terminalLeadingStateInComponent hfan N} :
          Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))).val.toRingHom = ⊤ :=
    terminalWimanComponentValuation_trivial_leadingState
      hfan hall N U V W hinj φ hφbase
  obtain ⟨B, hBcomap', hstate⟩ :=
    exists_nonautonomousFiniteCascadeTerminalComponentValuation_extension_lowerState
      hfan hall N h1 A hAtriv
  have hbranch : ∀ x : NonautonomousFiniteCascadeBranchField hfan N,
      nonautonomousFiniteCascadeBranchInclusionSucc hfan N x ∈ B :=
    nonautonomousFiniteCascadeBranchInclusionSucc_mem_of_lowerState_mem
      hfan hall (fun k hk => h1 k (by omega)) B hstate
  let b1 : NonautonomousFiniteCascadeTerminalPairField hfan N :=
    ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 1,
      IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 1)⟩
  let y : NonautonomousFiniteCascadeTerminalComponentField hfan N :=
    algebraMap (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) b1
  have hφy : φ y = V := by
    change φ (algebraMap
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) b1) = V
    rw [hφbase]
    exact firstOrderTerminalRationalStateEval_pair_one
      hfan hall N U V W hinj
  have hyA : y ∉ A := by
    change φ y ∉ laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
    rw [hφy]
    exact hahnSingle_negative_not_mem_laurentSeriesValuationSubring R hR
  have hpole : nonautonomousFiniteCascadeTerminalStateSucc hfan N ∉ B := by
    intro hyB
    apply hyA
    rw [← hBcomap']
    change algebraMap
        (NonautonomousFiniteCascadeTerminalComponentField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)) y ∈ B
    convert hyB using 1
    apply Subtype.ext
    rfl
  obtain ⟨C, hCB, hCcomap, hCmem⟩ :=
    exists_compositeValuationSubring_comap_eq A₀ B
      (nonautonomousFiniteCascadeBranchInclusionSucc hfan N) hbranch
  refine ⟨C, hCcomap, hCmem, ?_⟩
  intro hterminal
  exact hpole (hCB hterminal)

/-- The exact terminal Wiman valuation retains lower residue data, makes the new state a pole,
and makes normalized terminal velocity a valuation unit.  The last two memberships say precisely
that this normalized velocity has nonzero residue, without choosing a global Puiseux branch. -/
theorem exists_nonautonomousFiniteCascadeTerminalWimanLowerBranchResidueEmbedding_pole_normalizedUnit
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    ∃ (B : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)))
      (e : NonautonomousFiniteCascadeBranchField hfan N →+*
        IsLocalRing.ResidueField B),
      Function.Injective e ∧
      (∀ x : NonautonomousFiniteCascadeBranchField hfan N,
        nonautonomousFiniteCascadeBranchInclusionSucc hfan N x ∈ B) ∧
      nonautonomousFiniteCascadeTerminalStateSucc hfan N ∉ B ∧
      nonautonomousFiniteCascadeTerminalVelocitySucc hfan N /
          nonautonomousFiniteCascadeTerminalStateSucc hfan N ∈ B ∧
      (nonautonomousFiniteCascadeTerminalVelocitySucc hfan N /
          nonautonomousFiniteCascadeTerminalStateSucc hfan N)⁻¹ ∈ B := by
  obtain ⟨M, a, q, Nram, hNram, z₀, R, hR, z, hq, φ, B₀,
      hslope, hz₀, hz, hdata⟩ :=
    exists_nonautonomousFiniteCascadeTerminalWimanValuation hfan hall N h1
  dsimp only at hdata
  rcases hdata with ⟨hφgen, hφbase, hBcomap, htail⟩
  let U := HahnSeries.single (-((Nram * q : ℕ) : ℤ)) (1 : ℂ)
  let V := HahnSeries.single (-((R : ℕ) : ℤ))
    (1 : FirstOrderTerminalCoefficientField)
  let W := HahnSeries.single (-((R : ℕ) : ℤ))
      (1 : FirstOrderTerminalCoefficientField) *
    algebraMap (PowerSeries FirstOrderTerminalCoefficientField)
      FirstOrderTerminalLaurentField z
  let hinj : Function.Injective
      (firstOrderStatePolynomialEval (firstOrderTerminalJet U V W)) :=
    firstOrderStatePolynomialEval_terminal_injective
      (-((Nram * q : ℕ) : ℤ)) (-((R : ℕ) : ℤ))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr (mul_ne_zero hNram hq)))
      (neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr hR)) W
  let A := (laurentSeriesValuationSubring FirstOrderTerminalCoefficientField).comap φ
  have hAtriv : A.comap
      (IntermediateField.adjoin ℂ
        ({terminalLeadingStateInComponent hfan N} :
          Set (NonautonomousFiniteCascadeTerminalComponentField hfan N))).val.toRingHom = ⊤ :=
    terminalWimanComponentValuation_trivial_leadingState
      hfan hall N U V W hinj φ hφbase
  obtain ⟨B, hBcomap', hstate⟩ :=
    exists_nonautonomousFiniteCascadeTerminalComponentValuation_extension_lowerState
      hfan hall N h1 A hAtriv
  let e := nonautonomousFiniteCascadeLowerBranchResidueEmbedding
    hfan hall (fun k hk => h1 k (by omega)) B hstate
  let b1 : NonautonomousFiniteCascadeTerminalPairField hfan N :=
    ⟨nonautonomousFiniteCascadeTerminalStatePair hfan N 1,
      IntermediateField.subset_adjoin ℂ _ (Set.mem_range_self 1)⟩
  let y : NonautonomousFiniteCascadeTerminalComponentField hfan N :=
    algebraMap (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) b1
  let v : NonautonomousFiniteCascadeTerminalComponentField hfan N :=
    IntermediateField.AdjoinSimple.gen
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (nonautonomousFiniteCascadeTerminalVelocitySucc hfan N)
  have hφy : φ y = V := by
    change φ (algebraMap
      (NonautonomousFiniteCascadeTerminalPairField hfan N)
      (NonautonomousFiniteCascadeTerminalComponentField hfan N) b1) = V
    rw [hφbase]
    exact firstOrderTerminalRationalStateEval_pair_one
      hfan hall N U V W hinj
  have hyA : y ∉ A := by
    change φ y ∉ laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
    rw [hφy]
    exact hahnSingle_negative_not_mem_laurentSeriesValuationSubring R hR
  have hstatePole : nonautonomousFiniteCascadeTerminalStateSucc hfan N ∉ B := by
    intro hyB
    apply hyA
    have hyB' : algebraMap
        (NonautonomousFiniteCascadeTerminalComponentField hfan N)
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)) y ∈ B := by
      convert hyB using 1
      apply Subtype.ext
      rfl
    change y ∈ B.comap (algebraMap
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1))) at hyB'
    rw [hBcomap'] at hyB'
    exact hyB'
  have hz_ne : PowerSeries.constantCoeff z ≠ 0 :=
    terminalWimanPowerSeries_constantCoeff_ne_zero
      M a Nram z₀ z
      (nonautonomousFiniteCascadeWimanData hall h1 (Fin.last N)).root
      (nonautonomousFiniteCascadeWimanData_root_ne_zero hall h1 (Fin.last N))
      hz₀ hz
  have hratioA : v / y ∈ A := by
    change φ (v / y) ∈ laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
    rw [map_div₀ φ, show φ v = W from hφgen, hφy,
      terminalWiman_W_div_V R z]
    exact coe_terminalWimanPowerSeries_mem z hz_ne
  have hinvratioA : (v / y)⁻¹ ∈ A := by
    change φ ((v / y)⁻¹) ∈
      laurentSeriesValuationSubring FirstOrderTerminalCoefficientField
    rw [map_inv₀ φ, map_div₀ φ, show φ v = W from hφgen, hφy,
      terminalWiman_W_div_V R z]
    exact inv_coe_terminalWimanPowerSeries_mem z hz_ne
  have hratioB : algebraMap
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)) (v / y) ∈ B := by
    change v / y ∈ B.comap (algebraMap
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)))
    rw [hBcomap']
    exact hratioA
  have hinvratioB : algebraMap
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)) ((v / y)⁻¹) ∈ B := by
    change (v / y)⁻¹ ∈ B.comap (algebraMap
      (NonautonomousFiniteCascadeTerminalComponentField hfan N)
      (NonautonomousFiniteCascadeBranchField hfan (N + 1)))
    rw [hBcomap']
    exact hinvratioA
  have hbranchmem : ∀ x : NonautonomousFiniteCascadeBranchField hfan N,
      nonautonomousFiniteCascadeBranchInclusionSucc hfan N x ∈ B :=
    nonautonomousFiniteCascadeBranchInclusionSucc_mem_of_lowerState_mem
      hfan hall (fun k hk => h1 k (by omega)) B hstate
  refine ⟨B, e,
    nonautonomousFiniteCascadeLowerBranchResidueEmbedding_injective
      hfan hall (fun k hk => h1 k (by omega)) B hstate,
    hbranchmem, hstatePole, ?_, ?_⟩
  · convert hratioB using 1
    apply Subtype.ext
    rfl
  · convert hinvratioB using 1
    apply Subtype.ext
    rfl

/-- At one exact terminal Wiman place, the logarithmic derivative of the new output is integral
with nonzero residue, while the new output itself is a pole and the complete lower actual branch
remains integral.  This is the residue-level terminal-linear law used by inward Bell induction. -/
theorem exists_nonautonomousFiniteCascadeTerminalLogarithmicDerivative_nonzeroResidue
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    (hall : ∀ i : ℕ, TranscendentalEntire (f i)) (N : ℕ)
    (h1 : ∀ k, k < N + 1 → DifferentiallyAlgebraicOfOrder (f k) 1) :
    ∃ (B : ValuationSubring
        (NonautonomousFiniteCascadeBranchField hfan (N + 1)))
      (hlog : nonautonomousFiniteCascadeDerivativeInBranchField
          hfan (N + 1) (Fin.last (N + 1)) /
        nonautonomousFiniteCascadeTerminalStateSucc hfan N ∈ B),
      IsLocalRing.residue B
          (⟨nonautonomousFiniteCascadeDerivativeInBranchField
              hfan (N + 1) (Fin.last (N + 1)) /
            nonautonomousFiniteCascadeTerminalStateSucc hfan N, hlog⟩ : B) ≠ 0 ∧
      nonautonomousFiniteCascadeTerminalStateSucc hfan N ∉ B ∧
      ∀ x : NonautonomousFiniteCascadeBranchField hfan N,
        nonautonomousFiniteCascadeBranchInclusionSucc hfan N x ∈ B := by
  obtain ⟨B, e, he, hbranch, hpole, hu, huinv⟩ :=
    exists_nonautonomousFiniteCascadeTerminalWimanLowerBranchResidueEmbedding_pole_normalizedUnit
      hfan hall N h1
  let d : NonautonomousFiniteCascadeBranchField hfan N :=
    nonautonomousFiniteCascadeDerivativeInBranchField hfan N (Fin.last N)
  let d' : NonautonomousFiniteCascadeBranchField hfan (N + 1) :=
    nonautonomousFiniteCascadeBranchInclusionSucc hfan N d
  let u : NonautonomousFiniteCascadeBranchField hfan (N + 1) :=
    nonautonomousFiniteCascadeTerminalVelocitySucc hfan N /
      nonautonomousFiniteCascadeTerminalStateSucc hfan N
  have hd : d' ∈ B := hbranch d
  have hdinv : d'⁻¹ ∈ B := by
    have h := hbranch d⁻¹
    rw [map_inv₀ (nonautonomousFiniteCascadeBranchInclusionSucc hfan N)] at h
    exact h
  have hd0 : d' ≠ 0 := by
    apply (map_ne_zero
      (nonautonomousFiniteCascadeBranchInclusionSucc hfan N)).2
    intro hzero
    have hcoe := congrArg
      (fun x : NonautonomousFiniteCascadeBranchField hfan N =>
        (x : meroField Set.univ)) hzero
    exact (cascadeMeroDeriv_ne_zero_of_transcendental hfan hall N) hcoe
  have hu0 : u ≠ 0 :=
    nonautonomousFiniteCascadeTerminalNormalizedVelocitySucc_ne_zero hfan hall N
  have hprod : d' * u ∈ B := B.mul_mem d' u hd hu
  have hprodInv : (d' * u)⁻¹ ∈ B := by
    rw [mul_inv_rev]
    exact B.mul_mem u⁻¹ d'⁻¹ huinv hdinv
  have hlogEq :
      nonautonomousFiniteCascadeDerivativeInBranchField
          hfan (N + 1) (Fin.last (N + 1)) /
        nonautonomousFiniteCascadeTerminalStateSucc hfan N = d' * u := by
    rw [← nonautonomousFiniteCascadeTerminalDerivativeSucc hfan hall N]
    simp only [d', d, u]
    ring
  have hlog : nonautonomousFiniteCascadeDerivativeInBranchField
          hfan (N + 1) (Fin.last (N + 1)) /
        nonautonomousFiniteCascadeTerminalStateSucc hfan N ∈ B := by
    rw [hlogEq]
    exact hprod
  refine ⟨B, hlog, ?_, hpole, hbranch⟩
  rw [show (⟨nonautonomousFiniteCascadeDerivativeInBranchField
          hfan (N + 1) (Fin.last (N + 1)) /
        nonautonomousFiniteCascadeTerminalStateSucc hfan N, hlog⟩ : B) =
      ⟨d' * u, hprod⟩ by
        apply Subtype.ext
        exact hlogEq]
  exact valuationSubring_residue_ne_zero_of_mem_inv_mem
    B hprod hprodInv (mul_ne_zero hd0 hu0)

end

