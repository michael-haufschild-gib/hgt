import GaloisForLFunctions.HTGeometry.CriticalGeometricMonodromyJordan
import GaloisForLFunctions.HTGeometry.CriticalGeometricMonodromyTransitive
import GaloisForLFunctions.HTGeometry.TranspositionTransitive

/-!
# Full symmetric monodromy from generation by transpositions

An endgame for `(4)` that avoids primitivity entirely.  Transitivity of the actual geometric
monodromy is already unconditional
(`CriticalGeometricMonodromyTransitive.criticalGeometricMonodromy_isPretransitive`), and
`TranspositionTransitive.eq_top_of_isSwap_of_transitive` says a transitive group generated by
transpositions is the whole symmetric group.  Hence

```text
criticalGeometricMonodromy_eq_top_of_generated_by_swaps :
    (∀ f ∈ S, f.IsSwap) → criticalGeometricMonodromy K m n = Subgroup.closure S
      →  criticalGeometricMonodromy K m n = ⊤
```

So `(4)` reduces to the **single** statement that the monodromy group is generated by the meridian
transpositions — no Jordan, no block system, no primitivity.  Geometrically that statement is "the
cover is unramified outside the Schur divisor and the chart's étale fundamental group is generated
by the meridians", which is `E1` together with `E3`–`E5`; `E5` is
`AffineSpaceEtaleRankOne.rank_eq_one_of_isUnit_discr_mvPolynomial`.
-/

namespace GaloisForLFunctions.HTGeometry

set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1600000

noncomputable local instance sheetDecEqSwapGen (K : Type*) [Field K] (m n : ℕ) :
    DecidableEq (criticalGeometricSheet K m n) := Classical.decEq _

/-- **Full symmetric monodromy from generation by transpositions.**  Transitivity of the actual
geometric monodromy is unconditional, so if that group is generated by transpositions it is the
whole symmetric group on the sheets.  This is the alternative to the primitivity route: no
Jordan, no block system. -/
theorem criticalGeometricMonodromy_eq_top_of_generated_by_swaps
    (K : Type*) [Field K] [CharZero K] [IsAlgClosed K] {m n : ℕ} (hm : 0 < m) (hn : 0 < n)
    {S : Set (Equiv.Perm (criticalGeometricSheet K m n))}
    (hS : ∀ f ∈ S, f.IsSwap)
    (hgen : criticalGeometricMonodromy K m n = Subgroup.closure S) :
    criticalGeometricMonodromy K m n = ⊤ := by
  haveI := finite_criticalGeometricSheet K hm hn
  haveI htrans := criticalGeometricMonodromy_isPretransitive K hm hn
  rw [hgen]
  refine eq_top_of_isSwap_of_transitive hS (fun x y => ?_)
  have h2 : MulAction.IsPretransitive (Subgroup.closure S) (criticalGeometricSheet K m n) := by
    rw [← hgen]
    exact htrans
  obtain ⟨g, hg⟩ := h2.exists_smul_eq y x
  exact ⟨g, hg⟩

end GaloisForLFunctions.HTGeometry
