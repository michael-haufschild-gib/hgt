namespace GaloisForLFunctions.HTGeometry

open MeasureTheory OnePoint ProbabilityTheory Set MeasurableSpace
open scoped OnePoint ENNReal

noncomputable section

namespace NevanlinnaBoundaryFamily

variable {s : ℕ → ℝ} (F : NevanlinnaBoundaryFamily s)

/-- Pairing an observable with a label observable is a parameter integral of leaf averages. -/
theorem integral_comp_projectiveLabel_mul_eq_parameter (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] {G : OnePoint ℝ → ℝ} {f : ℝ → ℝ}
    (hG : Measurable G) (hf : Measurable f) {C D : ℝ}
    (hCf : ∀ x, |f x| ≤ C) (hDG : ∀ t, |G t| ≤ D) :
    ∫ x, G (F.matrix.projectiveLabel x) * f x ∂(F.measureBarycenter eta) =
      ∫ t, G t * F.leafAverage f t ∂eta := by
  have hmeas : Measurable fun x => G (F.matrix.projectiveLabel x) * f x :=
    (hG.comp F.measurable_projectiveLabel).mul hf
  have hbound : ∀ x, |G (F.matrix.projectiveLabel x) * f x| ≤ D * C := by
    intro x
    rw [abs_mul]
    exact mul_le_mul (hDG _) (hCf x) (abs_nonneg _)
      (le_trans (abs_nonneg _) (hDG (F.matrix.projectiveLabel x)))
  rw [F.integral_measureBarycenter eta hmeas (integrable_of_bounded hmeas hbound)]
  exact integral_congr_ae (Filter.Eventually.of_forall fun t =>
    F.integral_comp_projectiveLabel_mul t G f)

/-- **The vertical kernel.**  A bounded observable is orthogonal to every bounded label observable
exactly when almost every leaf average vanishes.  With the horizontal space spanned by the label
observables, this is the orthogonal splitting of the carrier space. -/
theorem forall_integral_comp_projectiveLabel_mul_eq_zero_iff (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] {f : ℝ → ℝ} (hf : Measurable f) {C : ℝ} (hCf : ∀ x, |f x| ≤ C) :
    (∀ (G : OnePoint ℝ → ℝ), Measurable G → (∀ t, |G t| ≤ 1) →
        ∫ x, G (F.matrix.projectiveLabel x) * f x ∂(F.measureBarycenter eta) = 0) ↔
      ∀ᵐ t ∂eta, F.leafAverage f t = 0 := by
  have hbdd : ∀ t, |F.leafAverage f t| ≤ C := by
    intro t
    haveI : IsProbabilityMeasure (F.leafMeasure t) := (F.leaf t).prop
    have := norm_integral_le_of_norm_le_const (C := C) (μ := F.leafMeasure t) (f := f)
      (Filter.Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hCf x)
    simpa [leafAverage, Real.norm_eq_abs] using this
  have hlmeas : Measurable (F.leafAverage f) := F.measurable_leafAverage hf
  constructor
  · intro hzero
    classical
    set G : OnePoint ℝ → ℝ := fun t => if 0 ≤ F.leafAverage f t then 1 else -1 with hG
    have hGmeas : Measurable G := by
      refine Measurable.ite (measurableSet_le measurable_const hlmeas) measurable_const
        measurable_const
    have hGbound : ∀ t, |G t| ≤ 1 := by
      intro t
      by_cases ht : 0 ≤ F.leafAverage f t <;> simp [hG, ht]
    have hkey := hzero G hGmeas hGbound
    rw [F.integral_comp_projectiveLabel_mul_eq_parameter eta hGmeas hf hCf hGbound] at hkey
    have habs : ∫ t, |F.leafAverage f t| ∂eta = 0 := by
      rw [← hkey]
      refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
      show |F.leafAverage f t| = G t * F.leafAverage f t
      by_cases ht : 0 ≤ F.leafAverage f t
      · rw [abs_of_nonneg ht, hG]
        simp [ht]
      · rw [abs_of_neg (lt_of_not_ge ht), hG]
        simp [ht]
    have hint : Integrable (fun t => |F.leafAverage f t|) eta :=
      (integrable_of_bounded (mu := eta) hlmeas hbdd).abs
    have := (integral_eq_zero_iff_of_nonneg (fun t => abs_nonneg _) hint).1 habs
    filter_upwards [this] with t ht
    simpa using abs_eq_zero.1 ht
  · intro hae G hGmeas hGbound
    rw [F.integral_comp_projectiveLabel_mul_eq_parameter eta hGmeas hf hCf hGbound]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [hae] with t ht
    show G t * F.leafAverage f t = 0
    rw [ht, mul_zero]

end NevanlinnaBoundaryFamily

end

end GaloisForLFunctions.HTGeometry
