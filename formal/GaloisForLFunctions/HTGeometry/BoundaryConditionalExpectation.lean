import GaloisForLFunctions.HTGeometry.BoundaryBarycenterSpectralTransport
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.Probability.Kernel.MeasurableIntegral

/-!
# The boundary projector is conditional expectation

Barycentring the `N`-extremal leaves against a projective parameter law disintegrates the carrier
over the projective support label.  Consequently the leaf-averaging operator is exactly the
conditional expectation of the carrier with respect to the σ-algebra generated by the label:
averaging an observable over the leaf through a point and then integrating against the carrier
reproduces the original integral on every label-measurable set.
-/

namespace GaloisForLFunctions.HTGeometry

open MeasureTheory OnePoint ProbabilityTheory Set
open scoped OnePoint ENNReal

noncomputable section

namespace NevanlinnaBoundaryFamily

variable {s : ℕ → ℝ} (F : NevanlinnaBoundaryFamily s)

/-- The `N`-extremal leaves as a genuine measure kernel over the projective line. -/
def leafKernel : Kernel (OnePoint ℝ) ℝ where
  toFun := F.leafMeasure
  measurable' := F.measurable_leaf

@[simp] theorem leafKernel_apply (t : OnePoint ℝ) : F.leafKernel t = F.leafMeasure t := rfl

instance leafKernel_isMarkov : IsMarkovKernel F.leafKernel where
  isProbabilityMeasure t := (F.leaf t).prop

/-- The leaf average of an observable, as a function of the projective parameter. -/
def leafAverage (f : ℝ → ℝ) (t : OnePoint ℝ) : ℝ := ∫ x, f x ∂(F.leafMeasure t)

theorem stronglyMeasurable_leafAverage {f : ℝ → ℝ} (hf : StronglyMeasurable f) :
    StronglyMeasurable (F.leafAverage f) :=
  MeasureTheory.StronglyMeasurable.integral_kernel (κ := F.leafKernel) hf

theorem measurable_leafAverage {f : ℝ → ℝ} (hf : Measurable f) :
    Measurable (F.leafAverage f) :=
  (F.stronglyMeasurable_leafAverage hf.stronglyMeasurable).measurable

/-- The constraint average: replace a point by the leaf carrying it and average there. -/
def markovAverage (f : ℝ → ℝ) (x : ℝ) : ℝ := F.leafAverage f (F.matrix.projectiveLabel x)

theorem markovAverage_eq_comp (f : ℝ → ℝ) :
    F.markovAverage f = F.leafAverage f ∘ F.matrix.projectiveLabel := rfl

theorem measurable_markovAverage {f : ℝ → ℝ} (hf : Measurable f) :
    Measurable (F.markovAverage f) :=
  (F.measurable_leafAverage hf).comp F.measurable_projectiveLabel

/-- Almost every point of a leaf carries that leaf's own projective label. -/
theorem ae_projectiveLabel_eq (t : OnePoint ℝ) :
    ∀ᵐ x ∂(F.leafMeasure t), F.matrix.projectiveLabel x = t :=
  (MeasureTheory.ae_iff).2 (F.carried_label t)

/-- On a single leaf, a label-measurable factor is constant. -/
theorem integral_comp_projectiveLabel_mul (t : OnePoint ℝ) (G : OnePoint ℝ → ℝ) (f : ℝ → ℝ) :
    ∫ x, G (F.matrix.projectiveLabel x) * f x ∂(F.leafMeasure t) = G t * F.leafAverage f t := by
  rw [leafAverage, ← MeasureTheory.integral_const_mul]
  refine integral_congr_ae ?_
  filter_upwards [F.ae_projectiveLabel_eq t] with x hx
  rw [hx]

/-- The carrier integral is the parameter integral of the leaf integrals. -/
theorem integral_measureBarycenter (eta : Measure (OnePoint ℝ)) {f : ℝ → ℝ}
    (hf : Measurable f) (hint : Integrable f (F.measureBarycenter eta)) :
    ∫ x, f x ∂(F.measureBarycenter eta) = ∫ t, F.leafAverage f t ∂eta :=
  integral_bind_real eta F.leafMeasure f F.measurable_leaf hf hint

/-- A bounded measurable observable is integrable against every finite measure. -/
theorem integrable_of_bounded {X : Type*} [MeasurableSpace X] {mu : Measure X}
    [IsFiniteMeasure mu] {f : X → ℝ}
    (hf : Measurable f) {C : ℝ} (hC : ∀ x, |f x| ≤ C) : Integrable f mu := by
  refine Integrable.mono' (g := fun _ => C) (integrable_const C) hf.aestronglyMeasurable ?_
  filter_upwards with x
  simpa [Real.norm_eq_abs] using hC x

/-- **The conditional-expectation identity.**  Testing an observable against a label-measurable
factor cannot distinguish the observable from its leaf average. -/
theorem integral_comp_projectiveLabel_mul_barycenter (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] {G : OnePoint ℝ → ℝ} {f : ℝ → ℝ}
    (hG : Measurable G) (hf : Measurable f) {C D : ℝ}
    (hCf : ∀ x, |f x| ≤ C) (hDG : ∀ t, |G t| ≤ D) :
    ∫ x, G (F.matrix.projectiveLabel x) * f x ∂(F.measureBarycenter eta) =
      ∫ x, G (F.matrix.projectiveLabel x) * F.markovAverage f x
        ∂(F.measureBarycenter eta) := by
  haveI : IsProbabilityMeasure (F.measureBarycenter eta) := by
    unfold measureBarycenter boundaryBarycenter
    exact boundaryBarycenter_isProbabilityMeasure eta F.leafMeasure F.measurable_leaf
      fun t => (F.leaf t).prop
  have hbdd : ∀ t, |F.leafAverage f t| ≤ C := by
    intro t
    haveI : IsProbabilityMeasure (F.leafMeasure t) := (F.leaf t).prop
    have := norm_integral_le_of_norm_le_const (C := C) (μ := F.leafMeasure t) (f := f)
      (Filter.Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hCf x)
    simpa [leafAverage, Real.norm_eq_abs, measure_univ] using this
  have hleft : Measurable fun x => G (F.matrix.projectiveLabel x) * f x :=
    (hG.comp F.measurable_projectiveLabel).mul hf
  have hright : Measurable fun x => G (F.matrix.projectiveLabel x) * F.markovAverage f x :=
    (hG.comp F.measurable_projectiveLabel).mul (F.measurable_markovAverage hf)
  have hleftBound : ∀ x, |G (F.matrix.projectiveLabel x) * f x| ≤ D * C := by
    intro x
    rw [abs_mul]
    exact mul_le_mul (hDG _) (hCf x) (abs_nonneg _)
      (le_trans (abs_nonneg _) (hDG (F.matrix.projectiveLabel x)))
  have hrightBound : ∀ x, |G (F.matrix.projectiveLabel x) * F.markovAverage f x| ≤ D * C := by
    intro x
    rw [abs_mul]
    exact mul_le_mul (hDG _) (hbdd _) (abs_nonneg _)
      (le_trans (abs_nonneg _) (hDG (F.matrix.projectiveLabel x)))
  rw [F.integral_measureBarycenter eta hleft (integrable_of_bounded hleft hleftBound),
    F.integral_measureBarycenter eta hright (integrable_of_bounded hright hrightBound)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
  show ∫ x, G (F.matrix.projectiveLabel x) * f x ∂(F.leafMeasure t) =
    ∫ x, G (F.matrix.projectiveLabel x) * F.markovAverage f x ∂(F.leafMeasure t)
  rw [F.integral_comp_projectiveLabel_mul t G f,
    F.integral_comp_projectiveLabel_mul t G (F.markovAverage f)]
  congr 1
  haveI hprob : IsProbabilityMeasure (F.leafMeasure t) := (F.leaf t).prop
  have hconst : ∫ x, F.markovAverage f x ∂(F.leafMeasure t) = F.leafAverage f t := by
    have hae : ∫ x, F.markovAverage f x ∂(F.leafMeasure t)
        = ∫ _x, F.leafAverage f t ∂(F.leafMeasure t) := by
      refine integral_congr_ae ?_
      filter_upwards [F.ae_projectiveLabel_eq t] with x hx
      unfold markovAverage
      rw [hx]
    rw [hae, integral_const]
    simp
  exact hconst.symm

end NevanlinnaBoundaryFamily

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open MeasureTheory OnePoint ProbabilityTheory Set MeasurableSpace
open scoped OnePoint ENNReal

noncomputable section

namespace NevanlinnaBoundaryFamily

variable {s : ℕ → ℝ} (F : NevanlinnaBoundaryFamily s)

/-- The σ-algebra generated by the projective support label. -/
@[reducible] def labelSigmaAlgebra : MeasurableSpace ℝ :=
  MeasurableSpace.comap F.matrix.projectiveLabel inferInstance

theorem labelSigmaAlgebra_le : F.labelSigmaAlgebra ≤ (inferInstance : MeasurableSpace ℝ) :=
  F.measurable_projectiveLabel.comap_le

theorem measurable_labelSigmaAlgebra_comp {G : OnePoint ℝ → ℝ} (hG : Measurable G) :
    Measurable[F.labelSigmaAlgebra] (G ∘ F.matrix.projectiveLabel) :=
  hG.comp (Measurable.of_comap_le le_rfl)

instance isProbabilityMeasure_measureBarycenter (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] : IsProbabilityMeasure (F.measureBarycenter eta) := by
  unfold measureBarycenter boundaryBarycenter
  exact boundaryBarycenter_isProbabilityMeasure eta F.leafMeasure F.measurable_leaf
    fun t => (F.leaf t).prop

/-- **The leaf average is the conditional expectation of the carrier over the label.**  This is the
paper's identity `P_s = E_ν[· | σ(π)]`. -/
theorem markovAverage_ae_eq_condExp (eta : Measure (OnePoint ℝ)) [IsProbabilityMeasure eta]
    {f : ℝ → ℝ} (hf : Measurable f) {C : ℝ} (hCf : ∀ x, |f x| ≤ C) :
    F.markovAverage f =ᵐ[F.measureBarycenter eta]
      (F.measureBarycenter eta)[f | F.labelSigmaAlgebra] := by
  classical
  set mu := F.measureBarycenter eta with hmu
  have hbdd : ∀ t, |F.leafAverage f t| ≤ C := by
    intro t
    haveI : IsProbabilityMeasure (F.leafMeasure t) := (F.leaf t).prop
    have := norm_integral_le_of_norm_le_const (C := C) (μ := F.leafMeasure t) (f := f)
      (Filter.Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hCf x)
    simpa [leafAverage, Real.norm_eq_abs] using this
  have hgm : Measurable (F.markovAverage f) := F.measurable_markovAverage hf
  refine ae_eq_condExp_of_forall_setIntegral_eq F.labelSigmaAlgebra_le
    (integrable_of_bounded hf hCf) (fun t _ _ => ?_) (fun t ht _ => ?_) ?_
  · exact (integrable_of_bounded hgm (fun x => hbdd (F.matrix.projectiveLabel x))).integrableOn
  · obtain ⟨A, hA, rfl⟩ := ht
    have hAmeas : MeasurableSet (F.matrix.projectiveLabel ⁻¹' A) :=
      hA.preimage F.measurable_projectiveLabel
    have hind : ∀ (g : ℝ → ℝ), Measurable g →
        ∫ x in F.matrix.projectiveLabel ⁻¹' A, g x ∂mu =
          ∫ x, (A.indicator (fun _ => (1 : ℝ))) (F.matrix.projectiveLabel x) * g x ∂mu := by
      intro g hg
      rw [← MeasureTheory.integral_indicator hAmeas]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      by_cases hx : F.matrix.projectiveLabel x ∈ A
      · have hxp : x ∈ F.matrix.projectiveLabel ⁻¹' A := hx
        simp [Set.indicator_of_mem hxp, Set.indicator_of_mem hx]
      · have hxp : x ∉ F.matrix.projectiveLabel ⁻¹' A := hx
        simp [Set.indicator_of_notMem hxp, Set.indicator_of_notMem hx]
    have hGbound : ∀ t : OnePoint ℝ, |(A.indicator (fun _ => (1 : ℝ))) t| ≤ 1 := by
      intro t
      by_cases htA : t ∈ A
      · rw [Set.indicator_of_mem htA]
        norm_num
      · rw [Set.indicator_of_notMem htA]
        norm_num
    rw [hind _ hgm, hind _ hf]
    exact (F.integral_comp_projectiveLabel_mul_barycenter eta
      (measurable_one.indicator hA) hf hCf hGbound).symm
  · exact ((F.measurable_labelSigmaAlgebra_comp
      (F.measurable_leafAverage hf)).stronglyMeasurable).aestronglyMeasurable

end NevanlinnaBoundaryFamily

end

end GaloisForLFunctions.HTGeometry

namespace GaloisForLFunctions.HTGeometry

open MeasureTheory OnePoint ProbabilityTheory Set MeasurableSpace
open scoped OnePoint ENNReal

noncomputable section

namespace NevanlinnaBoundaryFamily

variable {s : ℕ → ℝ} (F : NevanlinnaBoundaryFamily s)

theorem hasHamburgerMoments_measureBarycenter (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] : HasHamburgerMoments s (F.measureBarycenter eta) := by
  haveI : ∀ t : OnePoint ℝ, IsProbabilityMeasure (F.leafMeasure t) := fun t => (F.leaf t).prop
  exact boundaryBarycenter_hasHamburgerMoments eta F.leafMeasure F.measurable_leaf s
    F.leaf_moments

/-- **The polynomial shadow of the projector.**  Every polynomial is flattened by leaf averaging to
the constant value of the moment functional. -/
theorem leafAverage_eval (p : Polynomial ℝ) (t : OnePoint ℝ) :
    F.leafAverage (fun x => Polynomial.eval x p) t = HTGeometry.momentFunctional s p := by
  refine (HTGeometry.momentFunctional_eq_integral s (fun k => (F.leaf_moments t k).2.symm)
    (fun k => (F.leaf_moments t k).1) p).symm

/-- Centered polynomials lie in the vertical kernel of the projector. -/
theorem leafAverage_eval_sub_const (p : Polynomial ℝ) (t : OnePoint ℝ) :
    F.leafAverage (fun x => Polynomial.eval x p - HTGeometry.momentFunctional s p) t = 0 := by
  haveI : IsProbabilityMeasure (F.leafMeasure t) := (F.leaf t).prop
  have hint : Integrable (fun x : ℝ => Polynomial.eval x p) (F.leafMeasure t) :=
    HTGeometry.integrable_eval (fun k => (F.leaf_moments t k).1) p
  have hval : ∫ x, Polynomial.eval x p ∂(F.leafMeasure t) = HTGeometry.momentFunctional s p :=
    F.leafAverage_eval p t
  unfold leafAverage
  rw [integral_sub hint (integrable_const _), integral_const, hval]
  simp

/-- **Exact polynomial blindness.**  A mean-zero label observable annihilates every polynomial
against the carrier: moments cannot see the boundary coordinate. -/
theorem integral_eval_mul_comp_projectiveLabel (eta : Measure (OnePoint ℝ))
    [IsProbabilityMeasure eta] (p : Polynomial ℝ) {G : OnePoint ℝ → ℝ}
    (hG : Measurable G) {D : ℝ} (hD : ∀ t, |G t| ≤ D) (hmean : ∫ t, G t ∂eta = 0) :
    ∫ x, Polynomial.eval x p * G (F.matrix.projectiveLabel x) ∂(F.measureBarycenter eta) = 0 := by
  have hpmeas : Measurable fun x : ℝ => Polynomial.eval x p := (Polynomial.continuous p).measurable
  have hmeas : Measurable fun x : ℝ =>
      Polynomial.eval x p * G (F.matrix.projectiveLabel x) :=
    hpmeas.mul (hG.comp F.measurable_projectiveLabel)
  have hnu : Integrable (fun x : ℝ => Polynomial.eval x p) (F.measureBarycenter eta) :=
    HTGeometry.integrable_eval (fun k => (F.hasHamburgerMoments_measureBarycenter eta k).1) p
  have hint : Integrable (fun x : ℝ =>
      Polynomial.eval x p * G (F.matrix.projectiveLabel x)) (F.measureBarycenter eta) := by
    refine Integrable.mono' (g := fun x => D * |Polynomial.eval x p|)
      (hnu.abs.const_mul D) hmeas.aestronglyMeasurable ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (hD _) (abs_nonneg _)
  rw [F.integral_measureBarycenter eta hmeas hint]
  have hleaf : ∀ t : OnePoint ℝ,
      F.leafAverage (fun x => Polynomial.eval x p * G (F.matrix.projectiveLabel x)) t =
        HTGeometry.momentFunctional s p * G t := by
    intro t
    have hcomm : (fun x : ℝ => Polynomial.eval x p * G (F.matrix.projectiveLabel x)) =
        fun x : ℝ => G (F.matrix.projectiveLabel x) * Polynomial.eval x p := by
      funext x
      ring
    rw [hcomm, show F.leafAverage (fun x => G (F.matrix.projectiveLabel x) *
        Polynomial.eval x p) t = ∫ x, G (F.matrix.projectiveLabel x) *
        Polynomial.eval x p ∂(F.leafMeasure t) from rfl,
      F.integral_comp_projectiveLabel_mul t G (fun x => Polynomial.eval x p),
      F.leafAverage_eval p t]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hleaf), integral_const_mul, hmean,
    mul_zero]

end NevanlinnaBoundaryFamily

end

