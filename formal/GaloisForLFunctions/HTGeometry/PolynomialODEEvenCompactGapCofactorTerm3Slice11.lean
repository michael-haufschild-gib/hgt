  compactGapCofactorTopCertified% ((evenCompactGapReflectedTwoPolynomial u w * evenCompactGapReflectedSixPolynomial u w - (evenCompactGapReflectedFourPolynomial u w)^(2 : ℕ)).coeff 0)
