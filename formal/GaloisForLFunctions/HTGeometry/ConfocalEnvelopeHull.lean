import GaloisForLFunctions.HTGeometry.ConfocalExposedOrbitTomography
import Mathlib.Analysis.Convex.Basic
import Mathlib.Topology.Order.OrderClosed

/-!
# Canonical hull of a confocal upper field

The upper envelope of the distance-sum branches generated by complex points has an exact
half-space representation after the Lorentz lift `z ↦ (z.re, ‖z‖)`.  This file constructs the
largest lifted source compatible with a given upper field and proves the exact exposed-face
identifiability boundary.
-/

open Complex

namespace HTGeometry

noncomputable section

/-- The two-dimensional Lorentz half-plane containing all lifts `(z.re, ‖z‖)`. -/
def confocalLorentzCone : Set (ℝ × ℝ) :=
  {q | |q.1| ≤ q.2}

/-- Distance-sum branch in Lorentz coordinates `(x,a)=(re z, |z|)`. -/
def liftedConfocalBranch (q : ℝ × ℝ) (R : ℝ) : ℝ :=
  q.2 + Real.sqrt ((R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2))

theorem liftedConfocalRadicand_nonneg
    {q : ℝ × ℝ} (hq : q ∈ confocalLorentzCone) (R : ℝ) :
    0 ≤ (R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2) := by
  have ha : 0 ≤ q.2 := (abs_nonneg q.1).trans hq
  have hsq : q.1 ^ 2 ≤ q.2 ^ 2 := by
    rw [sq_le_sq]
    simpa only [abs_of_nonneg ha] using hq
  nlinarith [sq_nonneg (R - q.1)]

/-- A confocal branch sublevel is exactly a Lorentz half-space cut. -/
theorem liftedConfocalBranch_le_iff_halfspace
    {q : ℝ × ℝ} (hq : q ∈ confocalLorentzCone) (R L : ℝ) :
    liftedConfocalBranch q R ≤ L ↔
      q.2 ≤ L ∧ R * q.1 - L * q.2 ≥ (R ^ 2 - L ^ 2) / 2 := by
  have hrad := liftedConfocalRadicand_nonneg hq R
  have hsqrt0 := Real.sqrt_nonneg ((R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2))
  have hsqrt2 := Real.sq_sqrt hrad
  constructor
  · intro h
    have haL : q.2 ≤ L := by
      rw [liftedConfocalBranch] at h
      linarith
    constructor
    · exact haL
    · rw [liftedConfocalBranch] at h
      nlinarith
  · rintro ⟨haL, hhalf⟩
    rw [liftedConfocalBranch]
    have hLa : 0 ≤ L - q.2 := sub_nonneg.mpr haL
    have hsqrtLe :
        Real.sqrt ((R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2)) ≤ L - q.2 := by
      nlinarith
    linarith

/-- The largest Lorentz source whose branches stay below `G` on `D`. -/
def confocalHullOfField (D : Set ℝ) (G : ℝ → ℝ) : Set (ℝ × ℝ) :=
  {q | q ∈ confocalLorentzCone ∧ ∀ R ∈ D, liftedConfocalBranch q R ≤ G R}

@[simp] theorem mem_confocalHullOfField
    {D : Set ℝ} {G : ℝ → ℝ} {q : ℝ × ℝ} :
    q ∈ confocalHullOfField D G ↔
      q ∈ confocalLorentzCone ∧ ∀ R ∈ D, liftedConfocalBranch q R ≤ G R :=
  Iff.rfl

/-- `G` is the exact confocal upper field of `S` on the radius domain `D`. -/
def IsConfocalEnvelopeOn (D : Set ℝ) (S : Set (ℝ × ℝ)) (G : ℝ → ℝ) : Prop :=
  ∀ R ∈ D, IsLUB (liftedConfocalBranch (R := R) '' S) (G R)

/-- Every source realizing `G` lies in the canonical hull of `G`. -/
theorem subset_confocalHullOfField_of_isEnvelope
    {D : Set ℝ} {S : Set (ℝ × ℝ)} {G : ℝ → ℝ}
    (hcone : S ⊆ confocalLorentzCone)
    (hG : IsConfocalEnvelopeOn D S G) :
    S ⊆ confocalHullOfField D G := by
  intro q hq
  refine ⟨hcone hq, ?_⟩
  intro R hR
  exact (hG R hR).1 ⟨q, hq, rfl⟩

/-- The canonical hull has exactly the field from which it was constructed. -/
theorem isConfocalEnvelopeOn_confocalHullOfField
    {D : Set ℝ} {S : Set (ℝ × ℝ)} {G : ℝ → ℝ}
    (hcone : S ⊆ confocalLorentzCone)
    (hG : IsConfocalEnvelopeOn D S G) :
    IsConfocalEnvelopeOn D (confocalHullOfField D G) G := by
  intro R hR
  constructor
  · rintro _ ⟨q, hq, rfl⟩
    exact hq.2 R hR
  · intro b hb
    apply (hG R hR).2
    rintro _ ⟨q, hq, rfl⟩
    exact hb ⟨q, subset_confocalHullOfField_of_isEnvelope hcone hG hq, rfl⟩

/-- Maximality: every Lorentz source with upper field bounded by `G` lies in its hull. -/
theorem subset_confocalHullOfField_of_envelope_le
    {D : Set ℝ} {T : Set (ℝ × ℝ)} {G H : ℝ → ℝ}
    (hcone : T ⊆ confocalLorentzCone)
    (hH : IsConfocalEnvelopeOn D T H)
    (hHG : ∀ R ∈ D, H R ≤ G R) :
    T ⊆ confocalHullOfField D G := by
  intro q hq
  refine ⟨hcone hq, ?_⟩
  intro R hR
  exact ((hH R hR).1 ⟨q, hq, rfl⟩).trans (hHG R hR)

/-- Equality of upper fields on `D` gives equality of their canonical hulls. -/
theorem confocalHullOfField_eq_of_eqOn
    {D : Set ℝ} {G H : ℝ → ℝ} (hGH : Set.EqOn G H D) :
    confocalHullOfField D G = confocalHullOfField D H := by
  ext q
  constructor
  · rintro ⟨hq, hfield⟩
    refine ⟨hq, ?_⟩
    intro R hR
    simpa only [hGH hR] using hfield R hR
  · rintro ⟨hq, hfield⟩
    refine ⟨hq, ?_⟩
    intro R hR
    simpa only [hGH hR] using hfield R hR

/-- For realized fields, equality of canonical hulls recovers equality of fields on the domain. -/
theorem eqOn_of_confocalHullOfField_eq
    {D : Set ℝ} {G H : ℝ → ℝ}
    (hG : IsConfocalEnvelopeOn D (confocalHullOfField D G) G)
    (hH : IsConfocalEnvelopeOn D (confocalHullOfField D H) H)
    (hhull : confocalHullOfField D G = confocalHullOfField D H) :
    Set.EqOn G H D := by
  intro R hR
  have hG' := hG R hR
  rw [hhull] at hG'
  exact hG'.unique (hH R hR)

/-- Exact quotient law: two realized fields agree exactly when their canonical hulls agree. -/
theorem eqOn_iff_confocalHullOfField_eq
    {D : Set ℝ} {G H : ℝ → ℝ}
    (hG : IsConfocalEnvelopeOn D (confocalHullOfField D G) G)
    (hH : IsConfocalEnvelopeOn D (confocalHullOfField D H) H) :
    Set.EqOn G H D ↔ confocalHullOfField D G = confocalHullOfField D H := by
  exact ⟨confocalHullOfField_eq_of_eqOn,
    eqOn_of_confocalHullOfField_eq hG hH⟩

/-- The canonical hull is convex. -/
theorem convex_confocalHullOfField (D : Set ℝ) (G : ℝ → ℝ) :
    Convex ℝ (confocalHullOfField D G) := by
  intro p hp q hq α β hα hβ hsum
  have hpCone : p ∈ confocalLorentzCone := hp.1
  have hqCone : q ∈ confocalLorentzCone := hq.1
  have hp2 : 0 ≤ p.2 := (abs_nonneg p.1).trans hpCone
  have hq2 : 0 ≤ q.2 := (abs_nonneg q.1).trans hqCone
  have hcone : α • p + β • q ∈ confocalLorentzCone := by
    change |α * p.1 + β * q.1| ≤ α * p.2 + β * q.2
    calc
      |α * p.1 + β * q.1| ≤ |α * p.1| + |β * q.1| := abs_add_le _ _
      _ = α * |p.1| + β * |q.1| := by rw [abs_mul, abs_mul, abs_of_nonneg hα,
        abs_of_nonneg hβ]
      _ ≤ α * p.2 + β * q.2 :=
        add_le_add (mul_le_mul_of_nonneg_left hpCone hα)
          (mul_le_mul_of_nonneg_left hqCone hβ)
  refine ⟨hcone, ?_⟩
  intro R hR
  have hpHalf := (liftedConfocalBranch_le_iff_halfspace hpCone R (G R)).mp (hp.2 R hR)
  have hqHalf := (liftedConfocalBranch_le_iff_halfspace hqCone R (G R)).mp (hq.2 R hR)
  apply (liftedConfocalBranch_le_iff_halfspace hcone R (G R)).mpr
  change α * p.2 + β * q.2 ≤ G R ∧
    R * (α * p.1 + β * q.1) - G R * (α * p.2 + β * q.2) ≥
      (R ^ 2 - G R ^ 2) / 2
  constructor <;> nlinarith

/-- The canonical hull is closed. -/
theorem isClosed_confocalHullOfField (D : Set ℝ) (G : ℝ → ℝ) :
    IsClosed (confocalHullOfField D G) := by
  have hcone : IsClosed confocalLorentzCone := by
    exact isClosed_le continuous_fst.abs continuous_snd
  have hbranch : ∀ R : ℝ, IsClosed {q : ℝ × ℝ | liftedConfocalBranch q R ≤ G R} := by
    intro R
    apply isClosed_le
    · unfold liftedConfocalBranch
      fun_prop
    · fun_prop
  rw [show confocalHullOfField D G = confocalLorentzCone ∩ ⋂ R ∈ D,
      {q : ℝ × ℝ | liftedConfocalBranch q R ≤ G R} by
    ext q
    simp only [mem_confocalHullOfField, Set.mem_inter_iff, Set.mem_iInter,
      Set.mem_setOf_eq]]
  exact hcone.inter (isClosed_biInter fun R hR => hbranch R)

/-- The face of the canonical hull active at radius `R`. -/
def confocalExposedFace (D : Set ℝ) (G : ℝ → ℝ) (R : ℝ) : Set (ℝ × ℝ) :=
  {q | q ∈ confocalHullOfField D G ∧ liftedConfocalBranch q R = G R}

/-- On the radius domain, the active face is the self-consistent supporting line. -/
theorem mem_confocalExposedFace_iff_halfspace_eq
    {D : Set ℝ} {G : ℝ → ℝ} {R : ℝ} (hR : R ∈ D) {q : ℝ × ℝ} :
    q ∈ confocalExposedFace D G R ↔
      q ∈ confocalHullOfField D G ∧
        R * q.1 - G R * q.2 = (R ^ 2 - G R ^ 2) / 2 := by
  constructor
  · rintro ⟨hq, hactive⟩
    have hle := hq.2 R hR
    have hhalf := (liftedConfocalBranch_le_iff_halfspace hq.1 R (G R)).mp hle
    have hrad := liftedConfocalRadicand_nonneg hq.1 R
    have hsqrt2 := Real.sq_sqrt hrad
    have hsqrt0 := Real.sqrt_nonneg ((R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2))
    refine ⟨hq, ?_⟩
    rw [liftedConfocalBranch] at hactive
    nlinarith
  · rintro ⟨hq, hline⟩
    refine ⟨hq, ?_⟩
    have hhalf := (liftedConfocalBranch_le_iff_halfspace hq.1 R (G R)).mp (hq.2 R hR)
    have hrad := liftedConfocalRadicand_nonneg hq.1 R
    have hsqrt2 := Real.sq_sqrt hrad
    have hsqrt0 := Real.sqrt_nonneg ((R - q.1) ^ 2 + (q.2 ^ 2 - q.1 ^ 2))
    rw [liftedConfocalBranch]
    nlinarith

/-- Adding any hull point leaves the complete upper field unchanged. -/
theorem isConfocalEnvelopeOn_insert_of_mem_hull
    {D : Set ℝ} {S : Set (ℝ × ℝ)} {G : ℝ → ℝ}
    (hG : IsConfocalEnvelopeOn D S G)
    {q : ℝ × ℝ} (hq : q ∈ confocalHullOfField D G) :
    IsConfocalEnvelopeOn D (insert q S) G := by
  intro R hR
  constructor
  · rintro _ ⟨u, hu, rfl⟩
    rcases hu with rfl | hu
    · exact hq.2 R hR
    · exact (hG R hR).1 ⟨u, hu, rfl⟩
  · intro b hb
    apply (hG R hR).2
    rintro _ ⟨u, hu, rfl⟩
    exact hb ⟨u, Set.mem_insert_of_mem q hu, rfl⟩

/-- A singleton exposed face recovers every active point from any presentation of the field. -/
theorem active_point_eq_of_singleton_confocalExposedFace
    {D : Set ℝ} {T : Set (ℝ × ℝ)} {G H : ℝ → ℝ} {R : ℝ} (hR : R ∈ D)
    (hconeT : T ⊆ confocalLorentzCone)
    (hH : IsConfocalEnvelopeOn D T H)
    (hHG : Set.EqOn H G D)
    {q0 q : ℝ × ℝ}
    (hface : confocalExposedFace D G R = {q0})
    (hqT : q ∈ T) (hactive : liftedConfocalBranch q R = H R) :
    q = q0 := by
  have hsub : T ⊆ confocalHullOfField D G :=
    subset_confocalHullOfField_of_envelope_le hconeT hH
      (fun T hT => (hHG hT).le)
  have hqHull := hsub hqT
  have hqFace : q ∈ confocalExposedFace D G R := by
    refine ⟨hqHull, ?_⟩
    rw [hactive, hHG hR]
  rw [hface] at hqFace
  exact Set.mem_singleton_iff.mp hqFace

/-- Lorentz lift of a complex point. -/
def confocalLorentzLift (z : ℂ) : ℝ × ℝ :=
  (z.re, ‖z‖)

@[simp] theorem confocalLorentzLift_mem (z : ℂ) :
    confocalLorentzLift z ∈ confocalLorentzCone := by
  exact Complex.abs_re_le_norm z

/-- The lifted branch is exactly the original complex confocal distance sum. -/
theorem liftedConfocalBranch_confocalLorentzLift (z : ℂ) (R : ℝ) :
    liftedConfocalBranch (confocalLorentzLift z) R =
      confocalBranch z.re z.im R := by
  rw [liftedConfocalBranch, confocalLorentzLift, confocalBranch]
  simp only
  rw [Complex.sq_norm_sub_sq_re]
  rw [Complex.norm_eq_sqrt_sq_add_sq]

/-- A lifted point determines the complex conjugation orbit through `(re, |im|)`. -/
theorem abs_im_eq_sqrt_lorentzLift (z : ℂ) :
    Real.sqrt ((confocalLorentzLift z).2 ^ 2 - (confocalLorentzLift z).1 ^ 2) = |z.im| := by
  rw [confocalLorentzLift, Complex.sq_norm_sub_sq_re, Real.sqrt_sq_eq_abs]

/-- The unnormalized confocal upper field selected by a complex source. -/
def confocalUpperField (S : Set ℂ) (R : ℝ) : ℝ :=
  R * confocalAmplitudeEnvelope S R

/-- The lifted branch is the physical scale times its affine Bernstein amplitude. -/
theorem liftedConfocalBranch_eq_mul_affineAmplitude
    (z : ℂ) {R : ℝ} (hR : 0 < R) :
    liftedConfocalBranch (confocalLorentzLift z) R =
      R * (‖z / (R : ℂ)‖ + ‖1 - z / (R : ℂ)‖) := by
  rw [liftedConfocalBranch_confocalLorentzLift, confocalBranch,
    affineAmplitude_eq_one_add_confocalDefect_div hR, confocalDefect]
  have hnormSub :
      ‖(R : ℂ) - z‖ = Real.sqrt ((R - z.re) ^ 2 + z.im ^ 2) := by
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    simp only [sub_re, ofReal_re, sub_im, ofReal_im, zero_sub, neg_sq]
  rw [← Complex.norm_eq_sqrt_sq_add_sq z, ← hnormSub]
  field_simp [hR.ne']
  ring

/-- The intrinsic amplitude field is exactly the confocal upper envelope of the Lorentz-lifted
source on every positive radius domain. -/
theorem isConfocalEnvelopeOn_confocalLorentzLift_image
    {S : Set ℂ} (hne : S.Nonempty) {M : ℝ}
    (hbound : ∀ z ∈ S, ‖z‖ ≤ M)
    {D : Set ℝ} (hD : ∀ R ∈ D, 0 < R) :
    IsConfocalEnvelopeOn D (confocalLorentzLift '' S) (confocalUpperField S) := by
  intro R hRD
  have hR : 0 < R := hD R hRD
  let A : ℂ → ℝ := fun z => ‖z / (R : ℂ)‖ + ‖1 - z / (R : ℂ)‖
  have hAne : (A '' S).Nonempty := hne.image A
  have hAbdd : BddAbove (A '' S) := by
    refine ⟨1 + 2 * max M 0 / R, ?_⟩
    rintro y ⟨z, hz, rfl⟩
    dsimp only [A]
    rw [affineAmplitude_eq_one_add_confocalDefect_div hR]
    have hdef := (confocalDefect_le_two_mul_norm hR.le z).trans
      (mul_le_mul_of_nonneg_left
        ((hbound z hz).trans (le_max_left M 0)) (by norm_num))
    simpa only [add_comm] using
      add_le_add_left (div_le_div_of_nonneg_right hdef hR.le) 1
  have hAsup : IsLUB (A '' S) (confocalAmplitudeEnvelope S R) := by
    rw [← sSup_affineAmplitude_eq_confocalAmplitudeEnvelope hne hR hbound]
    exact isLUB_csSup hAne hAbdd
  constructor
  · rintro _ ⟨q, ⟨z, hz, rfl⟩, rfl⟩
    change liftedConfocalBranch (confocalLorentzLift z) R ≤ confocalUpperField S R
    rw [liftedConfocalBranch_eq_mul_affineAmplitude z hR, confocalUpperField]
    exact mul_le_mul_of_nonneg_left (hAsup.1 ⟨z, hz, rfl⟩) hR.le
  · intro b hb
    have hupperA : ∀ y ∈ A '' S, y ≤ b / R := by
      rintro y ⟨z, hz, rfl⟩
      apply (le_div_iff₀ hR).2
      apply hb
      exact ⟨confocalLorentzLift z, ⟨z, hz, rfl⟩,
        by simpa only [A, mul_comm] using
          liftedConfocalBranch_eq_mul_affineAmplitude z hR⟩
    have hleast := hAsup.2 hupperA
    rw [confocalUpperField]
    simpa only [mul_comm] using (le_div_iff₀ hR).mp hleast

end

end HTGeometry
