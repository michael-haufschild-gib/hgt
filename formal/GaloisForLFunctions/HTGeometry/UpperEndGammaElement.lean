import GaloisForLFunctions.HTGeometry.UpperEndJetTransport
import GaloisForLFunctions.HTGeometry.DifferentialJetAlgebra

/-!
# Gamma in the upper-end carrier

`Γ` is analytic and zero-free on every upper half-plane, so it is an element of the upper-end analytic
subring, and its logarithmic derivative there is the digamma element: `Γ′ = Γ·ψ`.

Iterating that identity shows every jet of `Γ` is `Γ` times an element of the digamma jet algebra —
the differential field generated by `Γ` sits over the digamma field as a `Γ`-tower, one factor of `Γ`
per jet, with all other content polynomial in the polygammas.
-/

open Filter Set Topology Function
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

local instance upperEndGammaDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance upperEndGammaIntAlgebra : Algebra ℤ upperEndMeroField := Ring.toIntAlgebra _

local instance upperEndGammaDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance upperEndGammaComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

/-- Gamma as an upper-end analytic germ. -/
def gammaUpperAnalytic : upperEndAnalyticSubring :=
  ⟨(Germ.coeRingHom upperEndFilter Complex.Gamma),
    ⟨Complex.Gamma, 0, analyticOnNhd_gamma_upperTail, rfl⟩⟩

/-- Gamma in the upper-end meromorphic field. -/
def gammaUpperMero : upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField gammaUpperAnalytic

/-- **The logarithmic derivative of Gamma is the digamma element.** -/
theorem upperEndAnalyticDeriv_gammaUpperAnalytic :
    upperEndAnalyticDeriv gammaUpperAnalytic = gammaUpperAnalytic * digammaAnalytic := by
  apply Subtype.ext
  show upperEndGermDeriv ((Complex.Gamma : ℂ → ℂ) : Germ upperEndFilter ℂ)
    = ((Complex.Gamma : ℂ → ℂ) : Germ upperEndFilter ℂ)
      * ((digammaFun : ℂ → ℂ) : Germ upperEndFilter ℂ)
  rw [upperEndGermDeriv_coe, ← Filter.Germ.coe_mul]
  refine Filter.Germ.coe_eq.mpr ?_
  show ∀ᶠ z : ℂ in upperEndFilter, deriv Complex.Gamma z = (Complex.Gamma * digammaFun) z
  rw [upperEndFilter_basis.eventually_iff]
  refine ⟨0, trivial, fun z hz => ?_⟩
  have hΓ : Complex.Gamma z ≠ 0 := Complex.Gamma_ne_zero (ne_negNat_of_mem_upperTail hz)
  show deriv Complex.Gamma z = Complex.Gamma z * digammaFun z
  rw [digammaFun]
  field_simp

/-- **The derivation on the Gamma element of the field.** -/
theorem deriv_gammaUpperMero : (gammaUpperMero)′ = gammaUpperMero * digammaMero := by
  rw [gammaUpperMero, upperEndMeroFieldDifferential_algebraMap,
    upperEndAnalyticDeriv_gammaUpperAnalytic, map_mul, digammaMero]

/-- The digamma element is a generator of its own jet algebra. -/
theorem digammaMero_mem_jetAlgebra :
    digammaMero ∈ differentialJetAlgebra ℂ ({digammaMero} : Set upperEndMeroField) :=
  Algebra.subset_adjoin ⟨digammaMero, Set.mem_singleton _, 0, rfl⟩

/-- Complex constants are constant for the derivation. -/
theorem deriv_algebraMap_complex (c : ℂ) :
    (algebraMap ℂ upperEndMeroField c)′ = 0 :=
  upperEndMero_deriv_complexConstant c

/-- **Every jet of Gamma is Gamma times an element of the digamma jet algebra.** -/
theorem exists_gammaJet_factor (n : ℕ) :
    ∃ y ∈ differentialJetAlgebra ℂ ({digammaMero} : Set upperEndMeroField),
      differentialJet n gammaUpperMero = gammaUpperMero * y := by
  induction n with
  | zero =>
    refine ⟨1, one_mem _, ?_⟩
    rw [differentialJet]
    simp
  | succ n ih =>
    obtain ⟨y, hy, hn⟩ := ih
    refine ⟨digammaMero * y + (y)′,
      add_mem (mul_mem digammaMero_mem_jetAlgebra hy)
        (deriv_mem_differentialJetAlgebra deriv_algebraMap_complex hy), ?_⟩
    have hleib := Differential.deriv.leibniz gammaUpperMero y
    rw [differentialJet_succ, hn, hleib, deriv_gammaUpperMero]
    simp only [smul_eq_mul]
    ring

local instance upperEndGammaRatAlgebra : Algebra (RatFunc ℂ) upperEndMeroField :=
  upperEndRatfuncToMero.toAlgebra

local instance upperEndGammaTower : IsScalarTower ℂ (RatFunc ℂ) upperEndMeroField :=
  IsScalarTower.of_algebraMap_eq fun c => (upperEnd_ratfunc_algebraMap_complex c).symm

/-- The digamma jet algebra over the constants sits inside the algebra generated over `ℂ(s)` by the
Gamma element and the digamma jets. -/
theorem digammaJetAlgebra_le_ratAdjoin {y : upperEndMeroField}
    (hy : y ∈ differentialJetAlgebra ℂ ({digammaMero} : Set upperEndMeroField)) :
    y ∈ Algebra.adjoin (RatFunc ℂ)
      ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField)) := by
  induction hy using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin (Or.inr hx)
  | algebraMap c =>
    rw [show algebraMap ℂ upperEndMeroField c = upperEndComplexToMero c from rfl,
      ← upperEnd_ratfunc_algebraMap_complex c]
    exact Subalgebra.algebraMap_mem _ _
  | add x y hx hy ihx ihy => exact add_mem ihx ihy
  | mul x y hx hy ihx ihy => exact mul_mem ihx ihy

/-- **The Gamma jet algebra is generated by Gamma and the digamma jets.**  Every jet of `Γ` is `Γ`
times a polynomial in the polygammas, so the differential algebra it generates over `ℂ(s)` is
contained in the ordinary algebra generated by `Γ` together with the digamma jets. -/
theorem gammaJetAlgebra_le_ratAdjoin :
    differentialJetAlgebra (RatFunc ℂ) ({gammaUpperMero} : Set upperEndMeroField)
      ≤ Algebra.adjoin (RatFunc ℂ)
        ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField)) := by
  refine Algebra.adjoin_le ?_
  rintro y ⟨z, hz, n, rfl⟩
  rw [Set.mem_singleton_iff] at hz
  subst hz
  obtain ⟨w, hw, hjet⟩ := exists_gammaJet_factor n
  rw [hjet]
  exact mul_mem (Algebra.subset_adjoin (Or.inl rfl)) (digammaJetAlgebra_le_ratAdjoin hw)

/-- **The Gamma expansion of an element.**  An element of the algebra generated over `ℂ(s)` by `Γ`
and the digamma jets is a polynomial in `Γ` — finitely many distinct powers — whose coefficients lie
in the digamma jet algebra. -/
theorem exists_gamma_expansion {y : upperEndMeroField}
    (hy : y ∈ Algebra.adjoin (RatFunc ℂ)
      ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField))) :
    ∃ (N : ℕ) (u : Fin N → ℕ) (A : Fin N → upperEndMeroField),
      Function.Injective u
        ∧ (∀ i, A i ∈ differentialJetAlgebra (RatFunc ℂ) ({digammaMero} : Set upperEndMeroField))
        ∧ y = ∑ i : Fin N, gammaUpperMero ^ u i * A i := by
  classical
  have hrange : Algebra.adjoin (RatFunc ℂ)
      ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField))
      = (MvPolynomial.aeval (Subtype.val :
          ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField) :
            Set upperEndMeroField) → upperEndMeroField)).range := by
    rw [← Algebra.adjoin_range_eq_range_aeval, Subtype.range_coe]
  rw [hrange] at hy
  obtain ⟨r, hr⟩ := hy
  obtain ⟨M, N, a, e, h, ha, hh, hhinj, heinj, hval⟩ :=
    exists_fin_monomial_sum_inj (Subtype.val :
      ({gammaUpperMero} ∪ differentialJetSet ({digammaMero} : Set upperEndMeroField) :
        Set upperEndMeroField) → upperEndMeroField) Subtype.val_injective r
  have hyval : y = ∑ α : Fin M, a α * ∏ i : Fin N, h i ^ e α i := by
    rw [← hr]
    exact hval
  set w : Fin M → ℕ :=
    fun α => ∑ i ∈ Finset.univ.filter (fun i => h i = gammaUpperMero), e α i with hw
  set P : Fin M → upperEndMeroField :=
    fun α => ∏ i ∈ Finset.univ.filter (fun i => ¬ h i = gammaUpperMero), h i ^ e α i with hP
  have hsplit : ∀ α : Fin M, (∏ i : Fin N, h i ^ e α i) = gammaUpperMero ^ w α * P α := by
    intro α
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun i => h i = gammaUpperMero)]
    congr 1
    rw [Finset.prod_congr rfl fun i hi => by rw [(Finset.mem_filter.mp hi).2]]
    exact Finset.prod_pow_eq_pow_sum _ _ _
  have hPmem : ∀ α : Fin M,
      P α ∈ differentialJetAlgebra (RatFunc ℂ) ({digammaMero} : Set upperEndMeroField) := by
    intro α
    refine Subalgebra.prod_mem _ fun i hi => ?_
    obtain ⟨z, hz⟩ := hh i
    have hmem : h i ∈ ({gammaUpperMero} ∪ differentialJetSet
        ({digammaMero} : Set upperEndMeroField) : Set upperEndMeroField) := hz ▸ z.2
    rcases hmem with h1 | h2
    · exact absurd h1 (Finset.mem_filter.mp hi).2
    · exact pow_mem (Algebra.subset_adjoin h2) _
  have hamem : ∀ α : Fin M,
      a α ∈ differentialJetAlgebra (RatFunc ℂ) ({digammaMero} : Set upperEndMeroField) := by
    intro α
    obtain ⟨c, hc⟩ := ha α
    rw [← hc]
    exact Subalgebra.algebraMap_mem _ _
  set Tw : Finset ℕ := Finset.image w Finset.univ with hTw
  refine ⟨Tw.card, fun j => ((Tw.equivFin.symm j : {x // x ∈ Tw}) : ℕ),
    fun j => ∑ α ∈ Finset.univ.filter
      (fun α => w α = ((Tw.equivFin.symm j : {x // x ∈ Tw}) : ℕ)), a α * P α, ?_, ?_, ?_⟩
  · intro j k hjk
    exact Tw.equivFin.symm.injective (Subtype.ext hjk)
  · intro j
    exact Subalgebra.sum_mem _ fun α _ => mul_mem (hamem α) (hPmem α)
  · rw [hyval, Finset.sum_congr rfl fun α _ => by rw [hsplit α]]
    have hmaps : ∀ α ∈ (Finset.univ : Finset (Fin M)),
        Tw.equivFin ⟨w α, Finset.mem_image_of_mem w (Finset.mem_univ α)⟩ ∈
          (Finset.univ : Finset (Fin Tw.card)) := fun α _ => Finset.mem_univ _
    rw [← Finset.sum_fiberwise_of_maps_to hmaps
      (fun α => a α * (gammaUpperMero ^ w α * P α))]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hfilter : (Finset.univ.filter fun α =>
          Tw.equivFin ⟨w α, Finset.mem_image_of_mem w (Finset.mem_univ α)⟩ = j)
        = Finset.univ.filter
          (fun α => w α = ((Tw.equivFin.symm j : {x // x ∈ Tw}) : ℕ)) := by
      refine Finset.filter_congr fun α _ => ?_
      constructor
      · intro hj
        have hsym : Tw.equivFin.symm j
            = ⟨w α, Finset.mem_image_of_mem w (Finset.mem_univ α)⟩ :=
          (Equiv.symm_apply_eq Tw.equivFin).mpr hj.symm
        exact (congrArg (fun x : {x // x ∈ Tw} => (x : ℕ)) hsym).symm
      · intro hj
        refine Tw.equivFin.symm.injective ?_
        rw [Equiv.symm_apply_apply]
        exact Subtype.ext (by simpa using hj)
    rw [hfilter, Finset.mul_sum]
    refine Finset.sum_congr rfl fun α hα => ?_
    rw [(Finset.mem_filter.mp hα).2]
    ring

end

end GaloisForLFunctions.HTGeometry
