import GaloisForLFunctions.HTGeometry.RittLogTowerDefect

/-!
# The jet prefix ring of an affine tower

The descent needs to distinguish rational functions of the jets from polynomials in them, because
the weight filtration that makes the coefficient system finite lives on polynomials.  The subalgebra
generated by the first `n` jets is stable under the shift — the shift of a jet is a base-linear
combination of the jets below it plus a base constant — and every element of the next one is a
polynomial in the top jet with coefficients in it.
-/

namespace GaloisForLFunctions.HTGeometry

namespace RittFrame

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The `K`-subalgebra generated by the first `n` jets of `u`. -/
def jetPrefixRing (Fr : RittFrame K L) (u : L) (n : ℕ) : Subalgebra K L :=
  Algebra.adjoin K {x | ∃ j < n, x = Fr.d^[j] u}

theorem jet_mem_jetPrefixRing (Fr : RittFrame K L) {u : L} {j n : ℕ} (h : j < n) :
    Fr.d^[j] u ∈ Fr.jetPrefixRing u n :=
  Algebra.subset_adjoin ⟨j, h, rfl⟩

theorem jetPrefixRing_mono (Fr : RittFrame K L) (u : L) {m n : ℕ} (h : m ≤ n) :
    Fr.jetPrefixRing u m ≤ Fr.jetPrefixRing u n :=
  Algebra.adjoin_mono (fun _ ⟨j, hj, hx⟩ => ⟨j, by omega, hx⟩)

theorem jetPrefixRing_le_jetPrefixField (Fr : RittFrame K L) (u : L) (n : ℕ) :
    ∀ x ∈ Fr.jetPrefixRing u n, x ∈ Fr.jetPrefixField u n := by
  intro x hx
  refine Algebra.adjoin_le (S := (Fr.jetPrefixField u n).toSubalgebra) ?_ hx
  rintro y ⟨j, hj, rfl⟩
  exact Fr.jet_mem_jetPrefixField hj

theorem towerDefect_mem_ring (Fr : RittFrame K L) (u : L) (b : K) (m : ℕ) :
    Fr.towerDefect u b m ∈ Fr.jetPrefixRing u m := by
  refine add_mem (sum_mem fun j hj => ?_) (Subalgebra.algebraMap_mem _ _)
  exact mul_mem (Subalgebra.algebraMap_mem _ _)
    (Fr.jet_mem_jetPrefixRing (by simpa only [Finset.mem_range] using hj))

theorem towerDefectLow_mem_ring (Fr : RittFrame K L) (u : L) (b : K) (m : ℕ) :
    Fr.towerDefectLow u b m ∈ Fr.jetPrefixRing u m := by
  refine add_mem (sum_mem fun j hj => ?_) (Subalgebra.algebraMap_mem _ _)
  exact mul_mem (Subalgebra.algebraMap_mem _ _)
    (Fr.jet_mem_jetPrefixRing (by simpa only [Finset.mem_range] using hj))

/-- **Shift stability of the jet prefix ring.** -/
theorem sigma_mem_jetPrefixRing (Fr : RittFrame K L) {u : L} {b : K}
    (hu : Fr.σ u = algebraMap K L Fr.ρ⁻¹ * u + algebraMap K L b) (n : ℕ) :
    ∀ x ∈ Fr.jetPrefixRing u n, Fr.σ x ∈ Fr.jetPrefixRing u n := by
  intro x hx
  set S : Subalgebra K L :=
    { carrier := setOf (fun y : L => Fr.σ y ∈ Fr.jetPrefixRing u n)
      mul_mem' := fun ha hb => by
        simp only [Set.mem_setOf_eq, map_mul] at *
        exact mul_mem ha hb
      one_mem' := by simp
      add_mem' := fun ha hb => by
        simp only [Set.mem_setOf_eq, map_add] at *
        exact add_mem ha hb
      zero_mem' := by simp
      algebraMap_mem' := fun a => by
        simp only [Set.mem_setOf_eq, Fr.comp]
        exact Subalgebra.algebraMap_mem _ _ } with hS
  refine Algebra.adjoin_le (S := S) ?_ hx
  rintro y ⟨k, hk, rfl⟩
  show Fr.σ (Fr.d^[k] u) ∈ Fr.jetPrefixRing u n
  rw [Fr.sigma_affineJet hu k]
  refine add_mem (sum_mem fun j hj => ?_) (Subalgebra.algebraMap_mem _ _)
  exact mul_mem (Subalgebra.algebraMap_mem _ _)
    (Fr.jet_mem_jetPrefixRing (by simp only [Finset.mem_range] at hj; omega))

/-- **Every element of the next prefix ring is a polynomial in the top jet** with coefficients in
the previous one. -/
theorem exists_polynomial_of_mem_jetPrefixRing_succ (Fr : RittFrame K L) (u : L) (n : ℕ)
    {x : L} (hx : x ∈ Fr.jetPrefixRing u (n + 1)) :
    ∃ P : Polynomial ↥(Fr.jetPrefixRing u n), x = Polynomial.aeval (Fr.d^[n] u) P := by
  set R : Subalgebra K L := Fr.jetPrefixRing u n with hR
  set T : Subalgebra K L :=
    { carrier := setOf (fun y : L => ∃ P : Polynomial ↥R, y = Polynomial.aeval (Fr.d^[n] u) P)
      mul_mem' := by
        rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
        exact ⟨P * Q, by rw [map_mul]⟩
      one_mem' := ⟨1, by rw [map_one]⟩
      add_mem' := by
        rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
        exact ⟨P + Q, by rw [map_add]⟩
      zero_mem' := ⟨0, by rw [map_zero]⟩
      algebraMap_mem' := fun a =>
        ⟨Polynomial.C ⟨algebraMap K L a, Subalgebra.algebraMap_mem _ a⟩, by
          rw [Polynomial.aeval_C]; rfl⟩ } with hT
  refine Algebra.adjoin_le (S := T) ?_ hx
  rintro y ⟨j, hj, rfl⟩
  rcases Nat.lt_or_ge j n with h | h
  · exact ⟨Polynomial.C ⟨Fr.d^[j] u, Fr.jet_mem_jetPrefixRing h⟩, by
      rw [Polynomial.aeval_C]; rfl⟩
  · have hjn : j = n := by omega
    subst hjn
    exact ⟨Polynomial.X, by rw [Polynomial.aeval_X]⟩

end RittFrame

end GaloisForLFunctions.HTGeometry
