import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicDeriv
import GaloisForLFunctions.HTGeometry.KummerDegreeBound

/-!
# Powers of a hypertranscendental element

An element algebraic over a differential field is differentially algebraic over it: all of its jets
lie in the algebraic closure of the base, so the jet family cannot be algebraically independent.
Combined with transitivity of differential algebraicity this shows that a positive power of a
hypertranscendental element is again hypertranscendental, since the element is a root of
`X ^ N - g ^ N` over the differential field generated by that power.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

/-- **A differentially independent element is transcendental.**  Its jet family contains the element
itself, and an algebraically independent family has transcendental members. -/
theorem transcendental_of_differentialIndependent
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A R] [Differential R] {x : R}
    (hind : DifferentialIndependent A (fun _ : Unit ↦ x)) :
    Transcendental A x := by
  have hind' : AlgebraicIndependent A (fun p : Unit × ℕ ↦ differentialJet p.2 x) := hind
  have hcomp := hind'.comp (fun _ : Fin 1 ↦ ((), 0)) (fun a b _ ↦ Subsingleton.elim a b)
  have hfun : ((fun p : Unit × ℕ ↦ differentialJet p.2 x) ∘ fun _ : Fin 1 ↦ ((), 0)) = ![x] := by
    funext i
    fin_cases i
    simp
  rw [hfun] at hcomp
  exact algebraicIndependent_iff_transcendental.mp hcomp

/-- **An algebraic element is differentially algebraic.** -/
theorem differentialAlgebraicOver_of_isAlgebraic
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A R] [Differential R] {x : R}
    (hx : IsAlgebraic A x) :
    DifferentialAlgebraicOver A x :=
  fun hind ↦ transcendental_of_differentialIndependent hind hx

variable {C E : Type*} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

/-- **A positive power of a hypertranscendental element is hypertranscendental.**  The element is a
root of `X ^ N - g ^ N` over the differential field generated by its power, hence differentially
algebraic over it; if the power were differentially algebraic over the base, transitivity would make
the element itself differentially algebraic. -/
theorem hypertranscendentalOver_pow {g : E} (hg : HypertranscendentalOver C g)
    {N : ℕ} (hN : 0 < N) :
    HypertranscendentalOver C (g ^ N) := by
  intro hDA
  apply hg
  refine differentialAlgebraicOver_trans hDA ?_
  letI : DifferentialAlgebra (↥(differentialAdjoin C ({g ^ N} : Set E))) E :=
    ⟨fun c ↦ derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin C ({g ^ N} : Set E)) c⟩
  have hmem : g ^ N ∈ differentialAdjoin C ({g ^ N} : Set E) :=
    subset_differentialAdjoin C _ rfl
  have halg : IsAlgebraic (↥(differentialAdjoin C ({g ^ N} : Set E))) g :=
    (isIntegral_of_pow_mem (α := g)
      (c := (⟨g ^ N, hmem⟩ : ↥(differentialAdjoin C ({g ^ N} : Set E)))) hN rfl).isAlgebraic
  exact differentialAlgebraicOver_of_isAlgebraic halg

/-- The differential-independence form: a positive power of a differentially independent generator
is differentially independent. -/
theorem differentialIndependent_pow {g : E}
    (hg : DifferentialIndependent C (fun _ : Unit ↦ g)) {N : ℕ} (hN : 0 < N) :
    DifferentialIndependent C (fun _ : Unit ↦ g ^ N) := by
  rw [← hypertranscendentalOver_iff_differentialIndependent_singleton]
  exact hypertranscendentalOver_pow
    ((hypertranscendentalOver_iff_differentialIndependent_singleton C g).mpr hg) hN

end

end GaloisForLFunctions.HTGeometry
