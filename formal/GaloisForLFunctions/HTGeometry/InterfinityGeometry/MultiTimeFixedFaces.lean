import GaloisForLFunctions.HTGeometry.InterfinityGeometry.MultiTimeHadamard
import GaloisForLFunctions.HTGeometry.InterfinityGeometry.SpectralFixedSubspace

/-!
# The Boolean lattice of fixed faces

A distribution on the multi-time chart space which is fixed by the multiplications
`h ↦ e^{-V x_j} h` for every `j` in a set `J` factors through restriction to the face
`{x_j = 0 : j ∈ J}`.

The mechanism is the same as in one time: the source defect factors as `x_j` times a smooth
nowhere-zero function, so a fixed distribution annihilates the ideal generated by `x_j`, and the
coordinate Hadamard lemma splits every chart accordingly.  Composing the face restrictions gives a
Boolean lattice of fixed subspaces whose deepest stratum, at `J = univ`, is the line spanned by
evaluation at the origin.
-/

namespace GaloisForLFunctions.HTGeometry.Interfinity

open Set

noncomputable section

variable {d : ℕ}

/-! ## The face projections -/

/-- The projection zeroing the coordinates in `J`. -/
def zeroAt (J : Finset (Fin d)) : (Fin d → ℝ) →L[ℝ] (Fin d → ℝ) where
  toFun x := fun i => if i ∈ J then 0 else x i
  map_add' x y := by
    funext i
    by_cases hi : i ∈ J <;> simp [hi]
  map_smul' c x := by
    funext i
    by_cases hi : i ∈ J <;> simp [hi]
  cont := by
    refine continuous_pi fun i => ?_
    by_cases hi : i ∈ J
    · simpa [hi] using continuous_const (y := (0 : ℝ))
    · simpa [hi] using continuous_apply i

@[simp] theorem zeroAt_apply (J : Finset (Fin d)) (x : Fin d → ℝ) (i : Fin d) :
    zeroAt J x i = if i ∈ J then 0 else x i := rfl

@[simp] theorem zeroAt_empty (x : Fin d → ℝ) : zeroAt (∅ : Finset (Fin d)) x = x := by
  funext i
  simp

theorem zeroAt_singleton (j : Fin d) (x : Fin d → ℝ) :
    zeroAt {j} x = Function.update x j 0 := by
  funext i
  by_cases hij : i = j
  · subst hij
    simp
  · simp [hij]

theorem zeroAt_comp (J K : Finset (Fin d)) (x : Fin d → ℝ) :
    zeroAt J (zeroAt K x) = zeroAt (J ∪ K) x := by
  funext i
  by_cases hJ : i ∈ J
  · simp [hJ]
  · by_cases hK : i ∈ K <;> simp [hJ, hK]

/-- The chart restricted to a face. -/
def faceChart (J : Finset (Fin d)) (h : (Fin d → ℝ) → ℝ) : (Fin d → ℝ) → ℝ := fun x => h (zeroAt J x)

@[simp] theorem faceChart_empty (h : (Fin d → ℝ) → ℝ) : faceChart ∅ h = h := by
  funext x
  simp [faceChart]

theorem faceChart_comp (J K : Finset (Fin d)) (h : (Fin d → ℝ) → ℝ) :
    faceChart K (faceChart J h) = faceChart (J ∪ K) h := by
  funext x
  simp only [faceChart]
  rw [zeroAt_comp]

theorem isSmoothMulti_faceChart (J : Finset (Fin d)) {h : (Fin d → ℝ) → ℝ}
    (hh : IsSmoothMulti h) : IsSmoothMulti (faceChart J h) := fun n =>
  (hh n).comp (zeroAt J).contDiff

/-! ## The multi-time test space -/

/-- The space of smooth multi-time charts. -/
def multiTestSpace (d : ℕ) : Submodule ℝ ((Fin d → ℝ) → ℝ) where
  carrier := {h | IsSmoothMulti h}
  add_mem' ha hb := fun n => (ha n).add (hb n)
  zero_mem' := fun _ => contDiff_const
  smul_mem' c _ ha := fun n => (ha n).const_smul c

/-- The unit chart. -/
def multiOne : multiTestSpace d := ⟨fun _ => 1, fun _ => contDiff_const⟩

/-- Multiplication by `e^{-V x_j}` in the `j`-th time. -/
def multiMul (j : Fin d) (V : ℝ) : multiTestSpace d →ₗ[ℝ] multiTestSpace d where
  toFun h := ⟨fun x => Real.exp (-(V * x j)) * h.1 x, fun n =>
    (Real.contDiff_exp.comp (by fun_prop)).mul (h.2 n)⟩
  map_add' h h' := by
    apply Subtype.ext
    funext x
    show Real.exp (-(V * x j)) * (h.1 x + h'.1 x) =
      Real.exp (-(V * x j)) * h.1 x + Real.exp (-(V * x j)) * h'.1 x
    ring
  map_smul' c h := by
    apply Subtype.ext
    funext x
    show Real.exp (-(V * x j)) * (c * h.1 x) = c * (Real.exp (-(V * x j)) * h.1 x)
    ring

@[simp] theorem multiMul_apply (j : Fin d) (V : ℝ) (h : multiTestSpace d) (x : Fin d → ℝ) :
    (multiMul j V h).1 x = Real.exp (-(V * x j)) * h.1 x := rfl

/-! ## Fixed distributions factor through the face -/

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

theorem isSmoothMulti_expDefect (j : Fin d) (V : ℝ) :
    IsSmoothMulti (fun x : Fin d → ℝ => expDefectFactor V (x j)) := fun n =>
  (isSmoothReal_expDefectFactor V n).comp ((contDiff_pi.1 (contDiff_id : ContDiff ℝ n _)) j)

/-- A distribution fixed by the `j`-th time annihilates the ideal generated by `x_j`. -/
theorem multi_eq_zero_of_fixed (u : multiTestSpace d →ₗ[ℝ] E) (j : Fin d)
    (hfix : ∀ V : ℝ, 0 < V → ∀ h : multiTestSpace d, u (multiMul j V h) = u h)
    (m : multiTestSpace d) :
    u ⟨fun x => x j * m.1 x, fun n => (((contDiff_pi.1
      (contDiff_id : ContDiff ℝ n _)) j)).mul (m.2 n)⟩ = 0 := by
  have hne : ∀ x : Fin d → ℝ, expDefectFactor 1 (x j) ≠ 0 := fun x =>
    expDefectFactor_ne_zero one_pos (x j)
  have hgS : IsSmoothMulti fun x : Fin d → ℝ => m.1 x / expDefectFactor 1 (x j) := fun n =>
    (m.2 n).div (isSmoothMulti_expDefect j 1 n) hne
  set g : multiTestSpace d := ⟨fun x => m.1 x / expDefectFactor 1 (x j), hgS⟩ with hgdef
  have hsub : multiMul j 1 g - g =
      ⟨fun x => x j * m.1 x, fun n => (((contDiff_pi.1
        (contDiff_id : ContDiff ℝ n _)) j)).mul (m.2 n)⟩ := by
    apply Subtype.ext
    funext x
    show Real.exp (-(1 * x j)) * (m.1 x / expDefectFactor 1 (x j)) -
      m.1 x / expDefectFactor 1 (x j) = x j * m.1 x
    have hfac : Real.exp (-(1 * x j)) - 1 = x j * expDefectFactor 1 (x j) :=
      laplace_defect_factor 1 (x j)
    have hE : expDefectFactor 1 (x j) ≠ 0 := hne x
    calc Real.exp (-(1 * x j)) * (m.1 x / expDefectFactor 1 (x j)) -
          m.1 x / expDefectFactor 1 (x j)
        = (Real.exp (-(1 * x j)) - 1) * (m.1 x / expDefectFactor 1 (x j)) := by ring
      _ = x j * expDefectFactor 1 (x j) * (m.1 x / expDefectFactor 1 (x j)) := by rw [hfac]
      _ = x j * m.1 x := by field_simp
  rw [← hsub, map_sub, hfix 1 one_pos g, sub_self]

/-- **One-coordinate face factorization.** -/
theorem multi_eq_face_singleton (u : multiTestSpace d →ₗ[ℝ] E) (j : Fin d)
    (hfix : ∀ V : ℝ, 0 < V → ∀ h : multiTestSpace d, u (multiMul j V h) = u h)
    (h : multiTestSpace d) :
    u h = u ⟨faceChart {j} h.1, isSmoothMulti_faceChart {j} h.2⟩ := by
  have hrS : IsSmoothMulti (coordRemainder j h.1) := isSmoothMulti_coordRemainder j h.2
  have hdecomp : h = ⟨faceChart {j} h.1, isSmoothMulti_faceChart {j} h.2⟩ +
      ⟨fun x => x j * coordRemainder j h.1 x, fun n => (((contDiff_pi.1
        (contDiff_id : ContDiff ℝ n _)) j)).mul (hrS n)⟩ := by
    apply Subtype.ext
    funext x
    show h.1 x = faceChart {j} h.1 x + x j * coordRemainder j h.1 x
    rw [faceChart, zeroAt_singleton]
    exact coord_hadamard j h.2 x
  calc u h = u (⟨faceChart {j} h.1, isSmoothMulti_faceChart {j} h.2⟩ +
        ⟨fun x => x j * coordRemainder j h.1 x, fun n => (((contDiff_pi.1
          (contDiff_id : ContDiff ℝ n _)) j)).mul (hrS n)⟩) := by rw [← hdecomp]
    _ = u ⟨faceChart {j} h.1, isSmoothMulti_faceChart {j} h.2⟩ := by
        rw [map_add, multi_eq_zero_of_fixed u j hfix ⟨coordRemainder j h.1, hrS⟩, add_zero]

/-- **The fixed subspace of a set of times is the face restriction.** -/
theorem multi_eq_face (u : multiTestSpace d →ₗ[ℝ] E) (J : Finset (Fin d))
    (hfix : ∀ j ∈ J, ∀ V : ℝ, 0 < V → ∀ h : multiTestSpace d, u (multiMul j V h) = u h)
    (h : multiTestSpace d) :
    u h = u ⟨faceChart J h.1, isSmoothMulti_faceChart J h.2⟩ := by
  classical
  induction J using Finset.induction generalizing h with
  | empty => simp [faceChart_empty]
  | insert j J hj ih =>
      have hfixj : ∀ V : ℝ, 0 < V → ∀ h : multiTestSpace d, u (multiMul j V h) = u h :=
        hfix j (Finset.mem_insert_self j J)
      have hfixJ : ∀ k ∈ J, ∀ V : ℝ, 0 < V → ∀ h : multiTestSpace d,
          u (multiMul k V h) = u h := fun k hk => hfix k (Finset.mem_insert_of_mem hk)
      have hstep := multi_eq_face_singleton u j hfixj h
      have hrec := ih hfixJ ⟨faceChart {j} h.1, isSmoothMulti_faceChart {j} h.2⟩
      rw [hstep, hrec]
      congr 1
      apply Subtype.ext
      show faceChart J (faceChart {j} h.1) = faceChart (insert j J) h.1
      rw [faceChart_comp, ← Finset.insert_eq]

/-- **The deepest fixed stratum is the line spanned by evaluation at the origin.** -/
theorem multi_eq_smul_delta (u : multiTestSpace d →ₗ[ℝ] E)
    (hfix : ∀ (j : Fin d) (V : ℝ), 0 < V → ∀ h : multiTestSpace d, u (multiMul j V h) = u h)
    (h : multiTestSpace d) : u h = h.1 0 • u multiOne := by
  classical
  have hmain := multi_eq_face u Finset.univ (fun j _ => hfix j) h
  have hconst : (⟨faceChart Finset.univ h.1, isSmoothMulti_faceChart Finset.univ h.2⟩ :
      multiTestSpace d) = h.1 0 • multiOne := by
    apply Subtype.ext
    funext x
    show h.1 (zeroAt Finset.univ x) = h.1 0 * 1
    have hz : zeroAt (Finset.univ : Finset (Fin d)) x = 0 := by
      funext i
      simp
    rw [hz, mul_one]
  rw [hmain, hconst, map_smul]

end

end GaloisForLFunctions.HTGeometry.Interfinity
