import GaloisForLFunctions.HTGeometry.InterfinityGeometry.StableDeathRegion
import GaloisForLFunctions.HTGeometry.ExactnessFlagProvenanceTopology

/-!
# Scott and Sierpinski realization of the stable-exactness topology

An observer is recorded by its stable-coboundary profile `K_o = d S_o`, a subspace of the
coboundary space.  This file identifies the topology generated by the death regions:

* it is the pullback of the Scott topology of the lattice of subspaces along `o ↦ K_o`, whether the
  lattice is taken inside the coboundary space or inside the ambient degree;
* equivalently it is the initial topology of the solvability map into a power of Sierpinski space,
  `e o c = (c ∈ K_o)`;
* jointly over all degrees, its specialization preorder is coordinatewise inclusion of profiles and
  its `T₀` reflection identifies two observers exactly when all their profiles agree.
-/

namespace GaloisForLFunctions.HTGeometry.Interfinity

open Set TopologicalSpace Topology

universe u v w

/-- The infimum of generated topologies is generated by the union of the generating families. -/
theorem generateFrom_iUnion_eq {α : Type*} {ι : Sort*} (s : ι → Set (Set α)) :
    generateFrom (⋃ i, s i) = ⨅ i, generateFrom (s i) := by
  refine le_antisymm (le_iInf fun i => le_generateFrom fun u hu =>
    isOpen_generateFrom_of_mem (mem_iUnion.2 ⟨i, hu⟩)) (le_generateFrom ?_)
  rintro u hu
  obtain ⟨i, hi⟩ := mem_iUnion.1 hu
  exact (iInf_le (fun i => generateFrom (s i)) i) u (isOpen_generateFrom_of_mem hi)

/-- Specialization for a generated topology only tests the generating family. -/
theorem forall_isOpen_generateFrom_of_subbasis {α : Type*} {g : Set (Set α)} {x y : α}
    (h : ∀ s ∈ g, y ∈ s → x ∈ s) : ∀ s, IsOpen[generateFrom g] s → y ∈ s → x ∈ s := by
  intro s hs
  induction hs with
  | basic u hu => exact h u hu
  | univ => intro _; trivial
  | inter u v _ _ ihu ihv => rintro ⟨hy1, hy2⟩; exact ⟨ihu hy1, ihv hy2⟩
  | sUnion S _ ih => rintro ⟨t, ht, hyt⟩; exact ⟨t, ht, ih t ht hyt⟩

/-- **The initial topology of a family of Sierpinski tests.**  Pulling back the product topology
on `T → Prop` along `e` gives the topology generated by the individual test loci. -/
theorem induced_pi_sierpinski_eq {O T : Type*} (e : O → T → Prop) :
    induced e Pi.topologicalSpace = generateFrom {s | ∃ t : T, s = {o | e o t}} := by
  have hpi : (Pi.topologicalSpace : TopologicalSpace (T → Prop)) =
      ⨅ t : T, induced (fun f : T → Prop => f t) sierpinskiSpace := rfl
  have hcoord : ∀ t : T,
      induced e (induced (fun f : T → Prop => f t) sierpinskiSpace) =
        generateFrom {{o | e o t}} := by
    intro t
    have hset : preimage (fun o => e o t) '' ({{True}} : Set (Set Prop)) =
        ({{o | e o t}} : Set (Set O)) := by
      ext s
      constructor
      · rintro ⟨u, hu, rfl⟩
        rw [mem_singleton_iff] at hu
        subst hu
        refine mem_singleton_iff.2 ?_
        ext o
        simp
      · intro hs
        rw [mem_singleton_iff] at hs
        subst hs
        refine ⟨{True}, rfl, ?_⟩
        ext o
        simp
    rw [induced_compose]
    show induced (fun o => e o t) (generateFrom {{True}}) = _
    rw [induced_generateFrom_eq, hset]
  have hunion : (⋃ t : T, ({{o | e o t}} : Set (Set O))) = {s : Set O | ∃ t : T, s = {o | e o t}} := by
    ext s
    constructor
    · intro hs
      obtain ⟨t, ht⟩ := mem_iUnion.1 hs
      exact ⟨t, mem_singleton_iff.1 ht⟩
    · rintro ⟨t, rfl⟩
      exact mem_iUnion.2 ⟨t, rfl⟩
  rw [hpi, induced_iInf]
  simp only [hcoord]
  rw [← generateFrom_iUnion_eq, hunion]

variable {R : Type u} [Ring R]
variable {A : Type v} [AddCommGroup A] [Module R A]
variable {B : Type w} [AddCommGroup B] [Module R B]

namespace CochainSlice

variable (X : CochainSlice R A B)

/-! ## Scott pullback -/

/-- Death regions are exactly the preimages of the principal membership tests of the subspace
lattice under the profile map. -/
theorem deathRegion_eq_preimage {O : Type*} (S : O → Submodule R A) (c : B) :
    X.deathRegion S c = X.profile S ⁻¹' {K : Submodule R B | c ∈ K} := rfl

/-- **The stable-exactness topology is the Scott pullback along the profile map.** -/
theorem exactnessTopology_eq_induced_scott {O : Type*} (S : O → Submodule R A) :
    X.exactnessTopology S = induced (X.profile S) (Topology.scott (Submodule R B) univ) := by
  have hset : preimage (X.profile S) '' {s : Set (Submodule R B) | ∃ v : B, s = {Z | v ∈ Z}} =
      {s : Set O | ∃ c : B, s = X.deathRegion S c} := by
    ext s
    constructor
    · rintro ⟨t, ⟨c, rfl⟩, rfl⟩
      exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩
      exact ⟨{K : Submodule R B | c ∈ K}, ⟨c, rfl⟩, rfl⟩
  rw [scott_submodule_eq_generateFrom, induced_generateFrom_eq, hset]

/-- The profile of an observer, viewed inside the lattice of subspaces of the coboundary space. -/
def rangeProfile {O : Type*} (S : O → Submodule R A) (o : O) :
    Submodule R (LinearMap.range X.d) :=
  Submodule.comap (LinearMap.range X.d).subtype (X.profile S o)

theorem mem_rangeProfile_iff {O : Type*} (S : O → Submodule R A) (o : O)
    (c : LinearMap.range X.d) : c ∈ X.rangeProfile S o ↔ (c : B) ∈ X.profile S o := Iff.rfl

/-- Death regions of chains inside the coboundary space already generate the stable-exactness
topology: a chain outside the coboundaries has empty death region. -/
theorem exactnessTopology_eq_generateFrom_range {O : Type*} (S : O → Submodule R A) :
    X.exactnessTopology S =
      generateFrom {s | ∃ c : LinearMap.range X.d, s = X.deathRegion S (c : B)} := by
  refine le_antisymm (le_generateFrom ?_) (le_generateFrom ?_)
  · rintro s ⟨c, rfl⟩
    exact X.isOpen_deathRegion S _
  · rintro s ⟨c, rfl⟩
    by_cases hc : c ∈ LinearMap.range X.d
    · exact isOpen_generateFrom_of_mem ⟨⟨c, hc⟩, rfl⟩
    · rw [X.deathRegion_eq_empty S hc]
      exact @isOpen_empty O (generateFrom _)

/-- **The stable-exactness topology is the Scott pullback along `κ : O → Sub(B^n)`.** -/
theorem exactnessTopology_eq_induced_scott_range {O : Type*} (S : O → Submodule R A) :
    X.exactnessTopology S =
      induced (X.rangeProfile S) (Topology.scott (Submodule R (LinearMap.range X.d)) univ) := by
  have hset : preimage (X.rangeProfile S) ''
        {s : Set (Submodule R (LinearMap.range X.d)) |
          ∃ v : LinearMap.range X.d, s = {Z | v ∈ Z}} =
      {s : Set O | ∃ c : LinearMap.range X.d, s = X.deathRegion S (c : B)} := by
    ext s
    constructor
    · rintro ⟨t, ⟨c, rfl⟩, rfl⟩
      exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩
      exact ⟨{Z : Submodule R (LinearMap.range X.d) | c ∈ Z}, ⟨c, rfl⟩, rfl⟩
  rw [X.exactnessTopology_eq_generateFrom_range S, scott_submodule_eq_generateFrom,
    induced_generateFrom_eq, hset]

/-! ## Sierpinski realization -/

/-- The solvability map into a power of Sierpinski space: `e o c` is the proposition that `c` has a
stable primitive at `o`. -/
def solvabilityMap {O : Type*} (S : O → Submodule R A) (o : O) : B → Prop :=
  fun c => c ∈ X.profile S o

/-- The solvability map restricted to the coboundary space. -/
def rangeSolvabilityMap {O : Type*} (S : O → Submodule R A) (o : O) :
    LinearMap.range X.d → Prop :=
  fun c => (c : B) ∈ X.profile S o

/-- **The stable-exactness topology is the initial topology of the Sierpinski solvability map.** -/
theorem exactnessTopology_eq_induced_sierpinski {O : Type*} (S : O → Submodule R A) :
    X.exactnessTopology S = induced (X.solvabilityMap S) Pi.topologicalSpace :=
  (induced_pi_sierpinski_eq (X.solvabilityMap S)).symm

/-- **The stable-exactness topology is the initial topology of `e_n : O → 𝕊^{B^n}`.** -/
theorem exactnessTopology_eq_induced_sierpinski_range {O : Type*} (S : O → Submodule R A) :
    X.exactnessTopology S = induced (X.rangeSolvabilityMap S) Pi.topologicalSpace := by
  rw [induced_pi_sierpinski_eq, X.exactnessTopology_eq_generateFrom_range S]
  rfl

end CochainSlice

/-! ## The joint all-degree topology -/

section Joint

variable {O : Type*} {ι : Type*}
variable {As : ι → Type v} [∀ i, AddCommGroup (As i)] [∀ i, Module R (As i)]
variable {Bs : ι → Type w} [∀ i, AddCommGroup (Bs i)] [∀ i, Module R (Bs i)]
variable (X : ∀ i, CochainSlice R (As i) (Bs i)) (S : ∀ i, O → Submodule R (As i))

/-- The all-degree stable-exactness topology: generated by the death regions in every degree. -/
@[reducible] def jointExactnessTopology : TopologicalSpace O :=
  generateFrom {s | ∃ (i : ι) (c : Bs i), s = (X i).deathRegion (S i) c}

theorem isOpen_deathRegion_joint (i : ι) (c : Bs i) :
    IsOpen[jointExactnessTopology X S] ((X i).deathRegion (S i) c) :=
  isOpen_generateFrom_of_mem ⟨i, c, rfl⟩

/-- The all-degree topology is still contained in the upper Alexandrov topology. -/
theorem upperSet_le_jointExactnessTopology [Preorder O] (hS : ∀ i, Monotone (S i)) :
    Topology.upperSet O ≤ jointExactnessTopology X S := by
  refine le_generateFrom ?_
  rintro s ⟨i, c, rfl⟩
  letI : TopologicalSpace O := Topology.upperSet O
  haveI : Topology.IsUpperSet O := ⟨rfl⟩
  exact Topology.IsUpperSet.isOpen_iff_isUpperSet.2 ((X i).isUpperSet_deathRegion (hS i) c)

/-- **The observable preorder is coordinatewise inclusion of stable-coboundary profiles.** -/
theorem specializes_joint_iff {o o' : O} :
    @Specializes O (jointExactnessTopology X S) o o' ↔
      ∀ i, (X i).profile (S i) o' ≤ (X i).profile (S i) o := by
  letI : TopologicalSpace O := jointExactnessTopology X S
  rw [specializes_iff_forall_open]
  constructor
  · intro h i c hc
    exact h _ (isOpen_deathRegion_joint X S i c) hc
  · intro h
    refine forall_isOpen_generateFrom_of_subbasis ?_
    rintro s ⟨i, c, rfl⟩ hc
    exact h i hc

/-- **The `T₀` reflection identifies two observers exactly when every profile agrees.** -/
theorem inseparable_joint_iff {o o' : O} :
    @Inseparable O (jointExactnessTopology X S) o o' ↔
      ∀ i, (X i).profile (S i) o = (X i).profile (S i) o' := by
  letI : TopologicalSpace O := jointExactnessTopology X S
  rw [inseparable_iff_specializes_and, specializes_joint_iff, specializes_joint_iff]
  constructor
  · rintro ⟨h₁, h₂⟩ i
    exact le_antisymm (h₂ i) (h₁ i)
  · intro h
    exact ⟨fun i => (h i).ge, fun i => (h i).le⟩

end Joint

end GaloisForLFunctions.HTGeometry.Interfinity
