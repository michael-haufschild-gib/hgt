import GaloisForLFunctions.HTGeometry.InterfinityGeometry.HadamardDivision

/-!
# The fixed subspace of the multiplication semigroup

A distribution on the transported smooth chart space which is fixed by every multiplication
`h ↦ e^{-Vs} h` is a multiple of evaluation at the origin.

The mechanism is division: `e^{-Vs} − 1 = s · E_V(s)` with `E_V` smooth and strictly negative for
`V > 0`, so the ideal generated by the source defect is the ideal generated by the coordinate.  A
fixed distribution therefore annihilates `s · C^∞`, and Hadamard's lemma splits every smooth chart
as its value at the origin plus an element of that ideal.
-/

namespace GaloisForLFunctions.HTGeometry.Interfinity

open MeasureTheory Set Filter Topology intervalIntegral

noncomputable section

/-- The derivative of the transported constant. -/
theorem deriv_expNeg (V : ℝ) :
    (deriv fun s : ℝ => Real.exp (-(V * s))) = fun s => -V * Real.exp (-(V * s)) := by
  funext s
  have h1 : HasDerivAt (fun u : ℝ => V * u) V s := by
    simpa using (hasDerivAt_id s).const_mul V
  have hinner : HasDerivAt (fun u : ℝ => -(V * u)) (-V) s := h1.neg
  have hd : HasDerivAt (fun u : ℝ => Real.exp (-(V * u))) (Real.exp (-(V * s)) * -V) s :=
    hinner.exp
  rw [hd.deriv]
  ring

theorem expDefectFactor_apply (V s : ℝ) :
    expDefectFactor V s = ∫ t in (0 : ℝ)..1, -V * Real.exp (-(V * (t * s))) := by
  rw [expDefectFactor, hadamardAvg, deriv_expNeg]
  refine intervalIntegral.integral_congr fun t _ => ?_
  simp

/-- The smooth cofactor of the source defect is strictly negative in the future. -/
theorem expDefectFactor_neg {V : ℝ} (hV : 0 < V) (s : ℝ) : expDefectFactor V s < 0 := by
  have hcont : Continuous fun t : ℝ => V * Real.exp (-(V * (t * s))) :=
    continuous_const.mul (Real.continuous_exp.comp (by fun_prop))
  have hpos : 0 < ∫ t in (0 : ℝ)..1, V * Real.exp (-(V * (t * s))) := by
    refine intervalIntegral.intervalIntegral_pos_of_pos_on
      (hcont.intervalIntegrable _ _) (fun t _ => ?_) zero_lt_one
    exact mul_pos hV (Real.exp_pos _)
  have hneg : expDefectFactor V s = -∫ t in (0 : ℝ)..1, V * Real.exp (-(V * (t * s))) := by
    rw [expDefectFactor_apply, ← intervalIntegral.integral_neg]
    refine intervalIntegral.integral_congr fun t _ => ?_
    ring
  rw [hneg]
  linarith

theorem expDefectFactor_ne_zero {V : ℝ} (hV : 0 < V) (s : ℝ) : expDefectFactor V s ≠ 0 :=
  ne_of_lt (expDefectFactor_neg hV s)

/-! ## The smooth test space -/

/-- The space of smooth chart functions. -/
def smoothTestSpace : Submodule ℝ (ℝ → ℝ) where
  carrier := {h | IsSmoothReal h}
  add_mem' ha hb := fun n => (ha n).add (hb n)
  zero_mem' := fun _ => contDiff_const
  smul_mem' c _ ha := fun n => (ha n).const_smul c

theorem mem_smoothTestSpace {h : ℝ → ℝ} : h ∈ smoothTestSpace ↔ IsSmoothReal h := Iff.rfl

/-- The unit chart. -/
def oneTest : smoothTestSpace := ⟨fun _ => 1, isSmoothReal_const 1⟩

/-- Multiplication by `e^{-Vs}` on the smooth test space. -/
def smoothMul (V : ℝ) : smoothTestSpace →ₗ[ℝ] smoothTestSpace where
  toFun h := ⟨fun s => Real.exp (-(V * s)) * h.1 s, (isSmoothReal_expNeg V).mul h.2⟩
  map_add' h h' := by
    apply Subtype.ext
    funext s
    show Real.exp (-(V * s)) * (h.1 s + h'.1 s) =
      Real.exp (-(V * s)) * h.1 s + Real.exp (-(V * s)) * h'.1 s
    ring
  map_smul' c h := by
    apply Subtype.ext
    funext s
    show Real.exp (-(V * s)) * (c * h.1 s) = c * (Real.exp (-(V * s)) * h.1 s)
    ring

@[simp] theorem smoothMul_apply (V : ℝ) (h : smoothTestSpace) (s : ℝ) :
    (smoothMul V h).1 s = Real.exp (-(V * s)) * h.1 s := rfl

/-! ## The classification -/

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- A fixed distribution annihilates the ideal generated by the coordinate. -/
theorem eq_zero_of_fixed (u : smoothTestSpace →ₗ[ℝ] E)
    (hfix : ∀ V : ℝ, 0 < V → ∀ h : smoothTestSpace, u (smoothMul V h) = u h)
    (m : smoothTestSpace) :
    u ⟨fun s => s * m.1 s, isSmoothReal_id.mul m.2⟩ = 0 := by
  have hne : ∀ s : ℝ, expDefectFactor 1 s ≠ 0 := expDefectFactor_ne_zero one_pos
  have hgS : IsSmoothReal fun s => m.1 s / expDefectFactor 1 s :=
    m.2.div (isSmoothReal_expDefectFactor 1) hne
  set g : smoothTestSpace := ⟨fun s => m.1 s / expDefectFactor 1 s, hgS⟩ with hgdef
  have hsub : smoothMul 1 g - g = ⟨fun s => s * m.1 s, isSmoothReal_id.mul m.2⟩ := by
    apply Subtype.ext
    funext s
    show Real.exp (-(1 * s)) * (m.1 s / expDefectFactor 1 s) - m.1 s / expDefectFactor 1 s =
      s * m.1 s
    have hfac : Real.exp (-(1 * s)) - 1 = s * expDefectFactor 1 s := laplace_defect_factor 1 s
    have hE : expDefectFactor 1 s ≠ 0 := hne s
    calc Real.exp (-(1 * s)) * (m.1 s / expDefectFactor 1 s) - m.1 s / expDefectFactor 1 s
        = (Real.exp (-(1 * s)) - 1) * (m.1 s / expDefectFactor 1 s) := by ring
      _ = s * expDefectFactor 1 s * (m.1 s / expDefectFactor 1 s) := by rw [hfac]
      _ = s * m.1 s := by field_simp
  rw [← hsub, map_sub, hfix 1 one_pos g, sub_self]

/-- **The common fixed subspace of the multiplication semigroup is the line spanned by evaluation
at the origin.** -/
theorem fixed_eq_smul_deltaZero (u : smoothTestSpace →ₗ[ℝ] E)
    (hfix : ∀ V : ℝ, 0 < V → ∀ h : smoothTestSpace, u (smoothMul V h) = u h)
    (h : smoothTestSpace) : u h = h.1 0 • u oneTest := by
  obtain ⟨r, hrS, hr⟩ := hadamard_factor h.2
  have hdecomp : h = h.1 0 • oneTest + ⟨fun s => s * r s, isSmoothReal_id.mul hrS⟩ := by
    apply Subtype.ext
    funext s
    show h.1 s = h.1 0 * 1 + s * r s
    rw [hr s]
    ring
  calc u h = u (h.1 0 • oneTest + ⟨fun s => s * r s, isSmoothReal_id.mul hrS⟩) := by rw [← hdecomp]
    _ = h.1 0 • u oneTest := by
        rw [map_add, map_smul, eq_zero_of_fixed u hfix ⟨r, hrS⟩, add_zero]

/-- Evaluation at the origin is itself fixed, so the fixed subspace is exactly one-dimensional. -/
def deltaZero : smoothTestSpace →ₗ[ℝ] ℝ where
  toFun h := h.1 0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem deltaZero_fixed (V : ℝ) (h : smoothTestSpace) :
    deltaZero (smoothMul V h) = deltaZero h := by
  show Real.exp (-(V * 0)) * h.1 0 = h.1 0
  simp

end

end GaloisForLFunctions.HTGeometry.Interfinity
