import GaloisForLFunctions.HTGeometry.InterfinityGeometry.StablePrimitiveExactness
import Mathlib.Topology.Order.UpperLowerSetTopology

/-!
# Death regions and the stable-exactness topology

An *observer poset* `O` assigns to each observer `o` a submodule `S o ≤ C^{n-1}` of admissible
primitives, monotonically in `o`.  The *stable-coboundary profile* of `o` is `K o = d (S o)`, and
the *death region* of a chain `c` is the set of observers at which `c` acquires a stable
primitive.

This file proves:

* the death region of an exact chain `d a` is `{o : a ∈ S o + Z^{n-1}}`, so it does not depend on
  which ordinary primitive is chosen;
* death regions are upper sets, hence the topology they generate is contained in the upper
  Alexandrov topology of `O`;
* a cochain isomorphism intertwining the stable subspaces along an order isomorphism carries death
  regions to death regions, and is therefore a homeomorphism for the stable-exactness topologies.
-/

namespace GaloisForLFunctions.HTGeometry.Interfinity

open Set TopologicalSpace Topology

universe u v w

variable {R : Type u} [Ring R]
variable {A : Type v} [AddCommGroup A] [Module R A]
variable {B : Type w} [AddCommGroup B] [Module R B]

namespace CochainSlice

variable (X : CochainSlice R A B)

/-- The stable-coboundary profile `K_o = d S_o` of an observer, as a subspace of the ambient
degree. -/
def profile {O : Type*} (S : O → Submodule R A) (o : O) : Submodule R B :=
  Submodule.map X.d (S o)

/-- The death region of a chain: the observers at which it acquires a stable primitive. -/
def deathRegion {O : Type*} (S : O → Submodule R A) (c : B) : Set O :=
  {o | c ∈ X.profile S o}

theorem mem_deathRegion_iff {O : Type*} {S : O → Submodule R A} {c : B} {o : O} :
    o ∈ X.deathRegion S c ↔ ∃ a ∈ S o, X.d a = c := Iff.rfl

/-- The membership test defining a death region, in terms of the primitive torsor: `d a` dies at
`o` exactly when `a` is a stable primitive modulo cocycles.  In particular the death region of an
exact chain is independent of the chosen primitive. -/
theorem deathRegion_d {O : Type*} (S : O → Submodule R A) (a : A) :
    X.deathRegion S (X.d a) = {o | a ∈ S o ⊔ LinearMap.ker X.d} := by
  ext o
  show X.d a ∈ Submodule.map X.d (S o) ↔ _
  rw [show (X.d a ∈ Submodule.map X.d (S o)) ↔ a ∈ Submodule.comap X.d (Submodule.map X.d (S o))
      from Iff.rfl, Submodule.comap_map_eq]
  exact Iff.rfl

/-- A chain outside the coboundaries never dies. -/
theorem deathRegion_eq_empty {O : Type*} (S : O → Submodule R A) {c : B}
    (hc : c ∉ LinearMap.range X.d) : X.deathRegion S c = (∅ : Set O) := by
  ext o
  simp only [mem_deathRegion_iff, mem_empty_iff_false, iff_false, not_exists]
  rintro a ⟨-, rfl⟩
  exact hc ⟨a, rfl⟩

/-- Profiles grow with the observer. -/
theorem profile_mono {O : Type*} [Preorder O] {S : O → Submodule R A} (hS : Monotone S) :
    Monotone (X.profile S) := fun _ _ h => Submodule.map_mono (hS h)

/-- **Death regions are upward closed.**  Strengthening an observer can only create stable
primitives. -/
theorem isUpperSet_deathRegion {O : Type*} [Preorder O] {S : O → Submodule R A} (hS : Monotone S)
    (c : B) : IsUpperSet (X.deathRegion S c) := fun _ _ h hc => X.profile_mono hS h hc

/-- The stable-exactness topology of one degree: generated by the death regions. -/
@[reducible] def exactnessTopology {O : Type*} (S : O → Submodule R A) : TopologicalSpace O :=
  generateFrom {s | ∃ c : B, s = X.deathRegion S c}

theorem isOpen_deathRegion {O : Type*} (S : O → Submodule R A) (c : B) :
    IsOpen[X.exactnessTopology S] (X.deathRegion S c) :=
  isOpen_generateFrom_of_mem ⟨c, rfl⟩

/-- **The stable-exactness topology is coarser than the upper Alexandrov topology.** -/
theorem upperSet_le_exactnessTopology {O : Type*} [Preorder O] {S : O → Submodule R A}
    (hS : Monotone S) : Topology.upperSet O ≤ X.exactnessTopology S := by
  refine le_generateFrom ?_
  rintro s ⟨c, rfl⟩
  letI : TopologicalSpace O := Topology.upperSet O
  haveI : Topology.IsUpperSet O := ⟨rfl⟩
  exact Topology.IsUpperSet.isOpen_iff_isUpperSet.2 (X.isUpperSet_deathRegion hS c)

/-- Every stable-exactness open set is an upper set. -/
theorem isUpperSet_of_isOpen_exactness {O : Type*} [Preorder O] {S : O → Submodule R A}
    (hS : Monotone S) {s : Set O} (hs : IsOpen[X.exactnessTopology S] s) : IsUpperSet s := by
  letI : TopologicalSpace O := Topology.upperSet O
  haveI : Topology.IsUpperSet O := ⟨rfl⟩
  exact Topology.IsUpperSet.isOpen_iff_isUpperSet.1 (X.upperSet_le_exactnessTopology hS _ hs)

end CochainSlice

/-! ## Covariance under cochain isomorphism -/

variable {A' : Type*} [AddCommGroup A'] [Module R A']
variable {B' : Type*} [AddCommGroup B'] [Module R B']

/-- An isomorphism of cochain slices: compatible linear isomorphisms in both degrees. -/
structure SliceEquiv (X : CochainSlice R A B) (X' : CochainSlice R A' B') where
  /-- The isomorphism of the source degree. -/
  eA : A ≃ₗ[R] A'
  /-- The isomorphism of the target degree. -/
  eB : B ≃ₗ[R] B'
  /-- The two differentials are intertwined. -/
  comm : ∀ a, eB (X.d a) = X'.d (eA a)

namespace SliceEquiv

variable {X : CochainSlice R A B} {X' : CochainSlice R A' B'} (U : SliceEquiv X X')

/-- A cochain isomorphism carries stable-coboundary profiles to stable-coboundary profiles. -/
theorem map_profile {O O' : Type*} {S : O → Submodule R A} {S' : O' → Submodule R A'}
    (θ : O → O') (hS : ∀ o, Submodule.map (U.eA : A →ₗ[R] A') (S o) = S' (θ o)) (o : O) :
    Submodule.map (U.eB : B →ₗ[R] B') (X.profile S o) = X'.profile S' (θ o) := by
  show Submodule.map (U.eB : B →ₗ[R] B') (Submodule.map X.d (S o))
      = Submodule.map X'.d (S' (θ o))
  rw [← hS o]
  ext b'
  constructor
  · rintro ⟨-, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨U.eA a, ⟨a, ha, rfl⟩, (U.comm a).symm⟩
  · rintro ⟨-, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨X.d a, ⟨a, ha, rfl⟩, U.comm a⟩

/-- **Covariance of death regions.** -/
theorem deathRegion_comp {O O' : Type*} {S : O → Submodule R A} {S' : O' → Submodule R A'}
    (θ : O → O') (hS : ∀ o, Submodule.map (U.eA : A →ₗ[R] A') (S o) = S' (θ o)) (c : B) :
    X.deathRegion S c = θ ⁻¹' X'.deathRegion S' (U.eB c) := by
  ext o
  show c ∈ X.profile S o ↔ U.eB c ∈ X'.profile S' (θ o)
  rw [← U.map_profile θ hS o]
  constructor
  · intro hc; exact ⟨c, hc, rfl⟩
  · rintro ⟨b, hb, hbc⟩
    rwa [U.eB.injective hbc] at hb

/-- The image of a death region under the observer isomorphism is the corresponding death
region. -/
theorem image_deathRegion {O O' : Type*} {S : O → Submodule R A} {S' : O' → Submodule R A'}
    (θ : O ≃ O') (hS : ∀ o, Submodule.map (U.eA : A →ₗ[R] A') (S o) = S' (θ o)) (c : B) :
    θ '' X.deathRegion S c = X'.deathRegion S' (U.eB c) := by
  rw [U.deathRegion_comp (θ : O → O') hS c, Equiv.image_preimage]

/-- **The observer isomorphism is continuous for the stable-exactness topologies.** -/
theorem continuous_of_sliceEquiv {O O' : Type*} {S : O → Submodule R A} {S' : O' → Submodule R A'}
    (θ : O → O') (hS : ∀ o, Submodule.map (U.eA : A →ₗ[R] A') (S o) = S' (θ o)) :
    Continuous[X.exactnessTopology S, X'.exactnessTopology S'] θ := by
  letI : TopologicalSpace O := X.exactnessTopology S
  refine continuous_generateFrom_iff.2 ?_
  rintro s ⟨c', rfl⟩
  have hc' : c' = U.eB (U.eB.symm c') := by simp
  rw [hc', ← U.deathRegion_comp (θ : O → O') hS]
  exact X.isOpen_deathRegion S _

/-- **The observer isomorphism is a homeomorphism for the stable-exactness topologies.** -/
noncomputable def homeomorph {O O' : Type*} {S : O → Submodule R A} {S' : O' → Submodule R A'}
    (θ : O ≃ O') (hS : ∀ o, Submodule.map (U.eA : A →ₗ[R] A') (S o) = S' (θ o)) :
    @Homeomorph O O' (X.exactnessTopology S) (X'.exactnessTopology S') :=
  letI : TopologicalSpace O := X.exactnessTopology S
  letI : TopologicalSpace O' := X'.exactnessTopology S'
  { toEquiv := θ
    continuous_toFun := U.continuous_of_sliceEquiv (θ : O → O') hS
    continuous_invFun := by
      refine continuous_generateFrom_iff.2 ?_
      rintro s ⟨c, rfl⟩
      have : θ.invFun ⁻¹' X.deathRegion S c = X'.deathRegion S' (U.eB c) := by
        rw [U.deathRegion_comp (θ : O → O') hS c]
        ext o'
        simp [Equiv.invFun_as_coe]
      rw [this]
      exact X'.isOpen_deathRegion S' _ }

end SliceEquiv

end GaloisForLFunctions.HTGeometry.Interfinity
