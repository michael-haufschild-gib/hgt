import GaloisForLFunctions.HTGeometry.RatioFieldMinimalRank

/-!
# The descended normalized characteristic is itself a characteristic

Over the field generated by its own coefficient ratios, the normalized characteristic is a relation
of the same rank as the original, and every relation there is a relation over the whole intermediate
field.  So it is a relation of minimal rank over the ratio field: the ratio field has an explicit
characteristic, not merely the same numerical rank.
-/

namespace GaloisForLFunctions

open MvPolynomial

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Algebra F E] [Differential E]

/-- Normalizing and descending preserves the variable set. -/
theorem vars_descend_normalized_eq (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    (P : DifferentialPolynomial Unit G) {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0) :
    (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n)).vars = P.vars := by
  have hinj : Function.Injective
      ((IntermediateField.inclusion (characteristicDifferentialRatioField_le G hGclosed P n) :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom) :=
    (IntermediateField.inclusion (characteristicDifferentialRatioField_le G hGclosed P n)).injective
  have hmap := MvPolynomial.vars_map_of_injective
    (f := (IntermediateField.inclusion (characteristicDifferentialRatioField_le G hGclosed P n) :
      characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom)
    (HTGeometry.descendCoefficients
      (characteristicDifferentialRatioField_le G hGclosed P n)
      (MvPolynomial.C (P.coeff n)⁻¹ * P)
      (coeff_normalized_mem_differentialRatioField G P n)) hinj
  rw [HTGeometry.map_descendCoefficients] at hmap
  rw [← hmap, MvPolynomial.vars_C_mul _ (inv_ne_zero hn)]

/-- Normalizing and descending preserves nonvanishing. -/
theorem descend_normalized_ne_zero (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    (P : DifferentialPolynomial Unit G) (hP0 : P ≠ 0) {n : (Unit × ℕ) →₀ ℕ}
    (hn : P.coeff n ≠ 0) :
    HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n) ≠ 0 := by
  intro h0
  have hmap := HTGeometry.map_descendCoefficients
    (characteristicDifferentialRatioField_le G hGclosed P n)
    (MvPolynomial.C (P.coeff n)⁻¹ * P)
    (coeff_normalized_mem_differentialRatioField G P n)
  rw [h0, map_zero] at hmap
  have : MvPolynomial.C (P.coeff n)⁻¹ * P = 0 := hmap.symm
  rcases mul_eq_zero.1 this with hC | hP
  · exact (inv_ne_zero hn) (by simpa using congrArg (fun R => MvPolynomial.coeff 0 R) hC)
  · exact hP0 hP

/-- **The descended normalized characteristic is a characteristic of the ratio field.**  It is a
relation there of the original rank, and every relation over the ratio field is a relation over the
whole intermediate field, so the original minimality transfers. -/
theorem isMinimal_descend_normalized (G : IntermediateField F E) (hGclosed : DerivationClosed G)
    {y : E} {P : DifferentialPolynomial Unit G}
    (hPmin : IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal G y : Set _) P)
    {n : (Unit × ℕ) →₀ ℕ} (hn : P.coeff n ≠ 0) :
    IsMinimalScalarDifferentialPolynomialRank
      (differentialIntermediateRelationIdeal (characteristicDifferentialRatioField G P n) y :
        Set _)
      (HTGeometry.descendCoefficients
        (characteristicDifferentialRatioField_le G hGclosed P n)
        (MvPolynomial.C (P.coeff n)⁻¹ * P)
        (coeff_normalized_mem_differentialRatioField G P n)) := by
  classical
  set hle := characteristicDifferentialRatioField_le G hGclosed P n with hleDef
  set P₁ := HTGeometry.descendCoefficients hle
    (MvPolynomial.C (P.coeff n)⁻¹ * P)
    (coeff_normalized_mem_differentialRatioField G P n) with hP₁
  have hinj : Function.Injective
      ((IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom) :=
    (IntermediateField.inclusion hle).injective
  have hne : P₁ ≠ 0 := descend_normalized_ne_zero G hGclosed P hPmin.2.1 hn
  have hvars : P₁.vars = P.vars := vars_descend_normalized_eq G hGclosed P hn
  refine ⟨descend_normalized_mem_relationIdeal G hGclosed P hPmin.1 n, hne,
    hvars ▸ hPmin.2.2.1, ?_⟩
  intro Q hQ hQne hQvars
  have hQmap := mem_differentialIntermediateRelationIdeal_map hle y hQ
  have hQmapne : MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q ≠ 0 := by
    intro h0
    exact hQne (MvPolynomial.map_injective _ hinj (by simpa using h0))
  have hQmapvars : (MvPolynomial.vars (MvPolynomial.map
      (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q)).Nonempty := by
    rw [MvPolynomial.vars_map_of_injective _ hinj]
    exact hQvars
  have hcmp := hPmin.2.2.2 hQmap hQmapne hQmapvars
  have hQorder : scalarDifferentialPolynomialOrder
      (MvPolynomial.map (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q)
      = scalarDifferentialPolynomialOrder Q :=
    scalarDifferentialPolynomialOrder_map hinj Q
  have hQleader : scalarDifferentialPolynomialLeaderDegree
      (MvPolynomial.map (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q)
      = scalarDifferentialPolynomialLeaderDegree Q :=
    scalarDifferentialPolynomialLeaderDegree_map hinj Q
  have hQtotal : (MvPolynomial.map (IntermediateField.inclusion hle :
        characteristicDifferentialRatioField G P n →ₐ[F] G).toRingHom Q).totalDegree
      = Q.totalDegree :=
    totalDegree_map_eq hinj Q
  have hP₁order : scalarDifferentialPolynomialOrder P₁ = scalarDifferentialPolynomialOrder P :=
    order_descend_normalized_eq G hGclosed P hn
  have hP₁leader : scalarDifferentialPolynomialLeaderDegree P₁ =
      scalarDifferentialPolynomialLeaderDegree P :=
    leaderDegree_descend_normalized_eq G hGclosed P hn
  have hP₁total : P₁.totalDegree = P.totalDegree := by
    have hmap := totalDegree_map_eq hinj P₁
    rw [hP₁, HTGeometry.map_descendCoefficients] at hmap
    rw [hP₁, ← hmap, totalDegree_C_mul_eq (inv_ne_zero hn)]
  refine ⟨?_, ?_, ?_⟩
  · rw [hP₁order, ← hQorder]
    exact hcmp.1
  · intro horder
    rw [hP₁leader, ← hQleader]
    refine hcmp.2.1 ?_
    rw [hQorder, ← hP₁order]
    exact horder
  · intro horder hleader
    rw [hP₁total, ← hQtotal]
    refine hcmp.2.2 ?_ ?_
    · rw [hQorder, ← hP₁order]
      exact horder
    · rw [hQleader, ← hP₁leader]
      exact hleader

end

end GaloisForLFunctions
