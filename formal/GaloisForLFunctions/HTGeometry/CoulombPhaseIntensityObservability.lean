import GaloisForLFunctions.HTGeometry.CoulombGammaPhaseClock
import GaloisForLFunctions.HTGeometry.WignerSmithLogClockObservability

/-!
# Reflected-frequency observability of the Coulomb phase

The Coulomb partial-wave clock is the self-shift opposite-orientation carrier

`S_ell(z) = Gamma(z+ell+1) / Gamma(-z+ell+1)`.

Its frequency reflection is the reciprocal carrier.  Hence the reflected-frequency intensity is
exactly one, while the orientation quotient is `S_ell(z)^2` and remains hypertranscendental.
This upgrades physical unit modulus to a global meromorphic observation theorem and proves that a
finite differential circuit generated by intensity and rational clocks cannot reconstruct phase.
-/

open Filter Set Topology Function Complex
open scoped Differential

namespace GaloisForLFunctions

open Bottcher Polynomial

noncomputable section

local instance coulombPhaseObservabilityDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance coulombPhaseObservabilityDifferential :
    Differential (meroField (Set.univ : Set ℂ)) :=
  meroFieldDifferential isOpen_univ isPreconnected_univ Set.univ_nonempty

local instance coulombPhaseObservabilityRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField Set.univ) :=
  (ratfuncToMero Set.univ isOpen_univ isPreconnected_univ
    Set.univ_nonempty Set.infinite_univ).toAlgebra

local instance coulombPhaseObservabilityRatFuncDifferential :
    Differential (RatFunc ℂ) := ratFuncCoordinateDifferential

local instance coulombPhaseObservabilityDifferentialAlgebra :
    DifferentialAlgebra (RatFunc ℂ) (meroField Set.univ) :=
  { deriv_algebraMap := fun r => meroField_deriv_ratfuncToMero r }

local instance coulombPhaseObservabilityCharZero :
    CharZero (meroField Set.univ) :=
  charZero_of_injective_algebraMap
    (algebraMap (RatFunc ℂ) (meroField Set.univ)).injective

/-- Frequency reflection of the Coulomb partial-wave Gamma phase. -/
def coulombPhaseReflectedFrequencyMero (ell : ℕ) : meroField Set.univ :=
  gammaOppositeShiftReflectedFrequencyMero
    (((ell + 1 : ℕ) : ℂ)) (((ell + 1 : ℕ) : ℂ))

/-- Reflected-frequency intensity of the Coulomb partial-wave phase. -/
def coulombPhaseIntensityObservationMero (ell : ℕ) : meroField Set.univ :=
  gammaOppositeShiftIntensityMero
    (((ell + 1 : ℕ) : ℂ)) (((ell + 1 : ℕ) : ℂ))

/-- Orientation-sensitive observation of the Coulomb partial-wave phase. -/
def coulombPhaseOrientationObservationMero (ell : ℕ) : meroField Set.univ :=
  gammaOppositeShiftPhaseMero
    (((ell + 1 : ℕ) : ℂ)) (((ell + 1 : ℕ) : ℂ))

/-- The existing Coulomb phase is the general self-shift opposite-orientation amplitude. -/
theorem coulombPhaseMero_eq_oppositeShiftQuotient (ell : ℕ) :
    coulombPhaseMero ell =
      gammaOppositeShiftQuotientMero
        (((ell + 1 : ℕ) : ℂ)) (((ell + 1 : ℕ) : ℂ)) := by
  rfl

/-- Wigner--Smith logarithmic delay of the Coulomb partial-wave phase. -/
def coulombWignerSmithLogClockMero (ell : ℕ) : meroField Set.univ :=
  HTGeometry.wignerSmithLogClock (coulombPhaseMero ell)

/-- The Coulomb delay is the self-shift specialization of the general opposite-orientation Gamma
Wigner--Smith clock. -/
theorem coulombWignerSmithLogClockMero_eq_gammaOppositeShift (ell : ℕ) :
    coulombWignerSmithLogClockMero ell =
      gammaOppositeShiftWignerSmithLogMero
        (((ell + 1 : ℕ) : ℂ)) (((ell + 1 : ℕ) : ℂ)) := by
  rfl

/-- **Coulomb Wigner--Smith value relation.**  The observable delay is the difference of the two
oppositely oriented Gamma logarithmic derivatives. -/
theorem coulombWignerSmithLogClockMero_eq_orientedLogDerivatives (ell : ℕ) :
    coulombWignerSmithLogClockMero ell =
      digammaShiftMero (((ell + 1 : ℕ) : ℂ)) -
        gammaNegativeLogDerivativeMero (((ell + 1 : ℕ) : ℂ)) := by
  rw [coulombWignerSmithLogClockMero_eq_gammaOppositeShift,
    gammaOppositeShiftWignerSmithLogMero_eq_orientedLogDerivatives]

/-- The Coulomb Wigner--Smith delay retains the HT source of the scattering phase. -/
theorem hypertranscendentalOver_coulombWignerSmithLogClockMero (ell : ℕ) :
    HypertranscendentalOver (RatFunc ℂ) (coulombWignerSmithLogClockMero ell) := by
  rw [coulombWignerSmithLogClockMero,
    HTGeometry.hypertranscendentalOver_wignerSmithLogClock_iff]
  exact hypertranscendentalOver_coulombPhaseMero ell

/-- **Global Coulomb intensity collapse.**  Frequency-reflected meromorphic intensity is exactly
one, strengthening unit modulus on the physical real slice. -/
theorem coulombPhaseIntensityObservationMero_eq_one (ell : ℕ) :
    coulombPhaseIntensityObservationMero ell = 1 := by
  rw [coulombPhaseIntensityObservationMero,
    gammaOppositeShiftIntensityMero_eq_reflectionProduct_div]
  apply div_self
  unfold gammaReflectionProductMero
  exact mul_ne_zero (gammaShiftMero_ne_zero _)
    (by
      rw [gammaNegativeShiftMero_reflection]
      exact mul_ne_zero (gammaReflectionGaugeMero_ne_zero _)
        (inv_ne_zero (gammaShiftMero_ne_zero _)))

/-- **Coulomb phase value relation.**  The orientation observation is the square of the original
partial-wave phase. -/
theorem coulombPhaseOrientationObservationMero_eq_square (ell : ℕ) :
    coulombPhaseOrientationObservationMero ell = (coulombPhaseMero ell) ^ 2 := by
  rw [coulombPhaseOrientationObservationMero,
    gammaOppositeShiftPhaseMero_eq_symmetricProduct,
    coulombPhaseMero_eq_oppositeShiftQuotient]
  ring

/-- Squaring the Coulomb phase does not remove its HT source. -/
theorem hypertranscendentalOver_coulombPhaseOrientationObservationMero (ell : ℕ) :
    HypertranscendentalOver (RatFunc ℂ)
      (coulombPhaseOrientationObservationMero ell) := by
  exact hypertranscendentalOver_gammaOppositeShiftPhaseMero _ _

/-- Coulomb intensity is DA because it is exactly one. -/
theorem differentialAlgebraicOver_coulombPhaseIntensityObservationMero (ell : ℕ) :
    DifferentialAlgebraicOver (RatFunc ℂ)
      (coulombPhaseIntensityObservationMero ell) := by
  rw [coulombPhaseIntensityObservationMero_eq_one]
  simpa only [map_one] using
    (HTGeometry.differentialAlgebraicOver_algebraMap (1 : RatFunc ℂ) :
      DifferentialAlgebraicOver (RatFunc ℂ)
        (algebraMap (RatFunc ℂ) (meroField Set.univ) 1))

/-- **Finite-observation non-recovery.**  Rational clocks and the unit Coulomb intensity cannot,
under finite field operations and differentiation, reconstruct the orientation-sensitive phase. -/
theorem no_scalarAwareFiniteDifferentialCircuit_coulombPhase_from_intensity (ell : ℕ) :
    ¬ HTGeometry.FiniteDifferentialCircuit
      (HTGeometry.BaseScalarOrAtom (RatFunc ℂ) (meroField Set.univ)
        (fun a => a = coulombPhaseIntensityObservationMero ell))
      (coulombPhaseOrientationObservationMero ell) := by
  intro hcircuit
  obtain ⟨a, ha, hHT⟩ :=
    HTGeometry.exists_hypertranscendental_atom_of_scalarAwareFiniteDifferentialCircuit
      (hypertranscendentalOver_coulombPhaseOrientationObservationMero ell) hcircuit
  rw [ha] at hHT
  exact hHT (differentialAlgebraicOver_coulombPhaseIntensityObservationMero ell)

/-- **Coulomb delay survives intensity collapse.**  Rational clocks and the globally unit
reflected-frequency intensity cannot finitely reconstruct the HT Wigner--Smith delay. -/
theorem no_scalarAwareFiniteDifferentialCircuit_coulombWignerSmith_from_intensity (ell : ℕ) :
    ¬ HTGeometry.FiniteDifferentialCircuit
      (HTGeometry.BaseScalarOrAtom (RatFunc ℂ) (meroField Set.univ)
        (fun a => a = coulombPhaseIntensityObservationMero ell))
      (coulombWignerSmithLogClockMero ell) := by
  exact HTGeometry.no_scalarAwareFiniteDifferentialCircuit_wignerSmith_from_daObservation
    (coulombPhaseMero ell)
    (coulombPhaseIntensityObservationMero ell)
    (hypertranscendentalOver_coulombPhaseMero ell)
    (differentialAlgebraicOver_coulombPhaseIntensityObservationMero ell)

end

end GaloisForLFunctions
