import GaloisForLFunctions.HTGeometry.MultipleSineFaceFieldTranslation
import GaloisForLFunctions.HTGeometry.FacePacketDifferenceSystem

/-!
# The rank-two difference system of a multiple-sine face packet

The descending face-lifting argument runs the several-automorphism Ostrowski criterion on the
translation block of one face over the differential field generated by the deeper faces.  For a ray
period family two structural directions suffice: two surviving parameters `ω_q, ω_u` with
rationally independent radii already generate a dense subgroup of the ray, so their joint fixed
field in the meromorphic field is the constants.  The elliptic-gamma argument needs a third,
unit-period direction only because its periods can generate a discrete group.

* **`sineFaceDifferenceSystem`** — the two restricted translations as a commuting
  difference-differential structure on the deeper face field;
* **`sineFacePacketBlock`**, **`sineFacePacketDisplacement`** — the translation block of a face and
  its displacements, which lie in that field.
-/

open Filter Set Topology Complex
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

noncomputable local instance msdsDecidableEq :
    DecidableEq (meroField (Set.univ : Set ℂ)) := Classical.decEq _

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra
  ellipticGammaRationalBaseCoordinateDifferential
  ellipticGammaRationalBaseCoordinateDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The two structural periods of the sine face-lifting argument. -/
def sineFacePacketPeriods (ω : ι → ℂ) (q u : ι) : Fin 2 → ℂ := ![ω q, ω u]

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem sineFacePacketPeriods_zero (ω : ι → ℂ) (q u : ι) :
    sineFacePacketPeriods ω q u 0 = ω q := rfl

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem sineFacePacketPeriods_one (ω : ι → ℂ) (q u : ι) :
    sineFacePacketPeriods ω q u 1 = ω u := rfl

set_option synthInstance.maxHeartbeats 1000000 in
theorem sineDeeperGenerators_period_translate_stable (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (hS2 : ∀ L ∈ S, 2 ≤ (Lᶜ : Finset ι).card) (q u : ι) (i : Fin 2)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S)) :
    addTranslationMeroEquiv (sineFacePacketPeriods ω q u i) x
      ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
  fin_cases i
  · exact differentialAdjoin_sineDeeperGenerators_translate_stable ω hω q
      (fun L hL hq => hS L hL q hq) hS2 hx
  · exact differentialAdjoin_sineDeeperGenerators_translate_stable ω hω u
      (fun L hL hu => hS L hL u hu) hS2 hx

set_option synthInstance.maxHeartbeats 1000000 in
theorem sineDeeperGenerators_period_neg_translate_stable (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (hS2 : ∀ L ∈ S, 2 ≤ (Lᶜ : Finset ι).card) (q u : ι) (i : Fin 2)
    (x : meroField (Set.univ : Set ℂ))
    (hx : x ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S)) :
    addTranslationMeroEquiv (-sineFacePacketPeriods ω q u i) x
      ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
  fin_cases i
  · exact differentialAdjoin_sineDeeperGenerators_neg_translate_stable ω hω q
      (fun L hL hq => hS L hL q hq) hS2 hx
  · exact differentialAdjoin_sineDeeperGenerators_neg_translate_stable ω hω u
      (fun L hL hu => hS L hL u hu) hS2 hx

set_option synthInstance.maxHeartbeats 1000000 in
/-- **The two structural translations as a difference-differential structure on the deeper face
field.** -/
def sineFaceDifferenceSystem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (hS2 : ∀ L ∈ S, 2 ≤ (Lᶜ : Finset ι).card) (q u : ι) :
    CommutingDifferenceDifferentialField (Fin 2) ℂ
      ↥(differentialAdjoin ℂ (sineDeeperGenerators ω hω S)) where
  aut i := meroTranslationRestrict (differentialAdjoin ℂ (sineDeeperGenerators ω hω S))
    (sineFacePacketPeriods ω q u i)
    (sineDeeperGenerators_period_translate_stable ω hω hS hS2 q u i)
    (sineDeeperGenerators_period_neg_translate_stable ω hω hS hS2 q u i)
  aut_comm i j x := by
    apply Subtype.ext
    show addTranslationMeroEquiv (sineFacePacketPeriods ω q u i)
      (addTranslationMeroEquiv (sineFacePacketPeriods ω q u j)
        (x : meroField (Set.univ : Set ℂ))) = _
    show _ = addTranslationMeroEquiv (sineFacePacketPeriods ω q u j)
      (addTranslationMeroEquiv (sineFacePacketPeriods ω q u i)
        (x : meroField (Set.univ : Set ℂ)))
    rw [addTranslationMeroEquiv_add, addTranslationMeroEquiv_add, add_comm]
  aut_deriv i x := by
    apply Subtype.ext
    exact addTranslationMeroEquiv_deriv (sineFacePacketPeriods ω q u i)
      (x : meroField (Set.univ : Set ℂ))
  aut_algebraMap i c := by
    apply Subtype.ext
    show addTranslationMeroEquiv (sineFacePacketPeriods ω q u i)
      (algebraMap ℂ (meroField (Set.univ : Set ℂ)) c) = _
    exact addTranslationMeroEquiv_algebraMap_complex _ c

@[simp]
theorem sineFaceDifferenceSystem_aut_coe (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (hS2 : ∀ L ∈ S, 2 ≤ (Lᶜ : Finset ι).card) (q u : ι) (i : Fin 2)
    (x : ↥(differentialAdjoin ℂ (sineDeeperGenerators ω hω S))) :
    (((sineFaceDifferenceSystem ω hω hS hS2 q u).aut i x :
        ↥(differentialAdjoin ℂ (sineDeeperGenerators ω hω S))) :
      meroField (Set.univ : Set ℂ))
      = addTranslationMeroEquiv (sineFacePacketPeriods ω q u i)
        (x : meroField (Set.univ : Set ℂ)) := rfl

/-! ## The translation block of a face and its displacements -/

/-- The translation block of the face `J`, indexed by its packet. -/
def sineFacePacketBlock (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im) (J : Finset ι) :
    ↥(facePacket ω hω J) → meroField (Set.univ : Set ℂ) :=
  fun y => (y : meroField (Set.univ : Set ℂ))

set_option synthInstance.maxHeartbeats 1000000 in
/-- The displacement of a block element in either structural direction lies in the deeper face
field. -/
theorem sineFacePacketBlock_period_displacement_mem (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (h2 : 2 ≤ (Jᶜ : Finset ι).card) (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (i : Fin 2)
    (y : ↥(facePacket ω hω J)) :
    addTranslationMeroEquiv (sineFacePacketPeriods ω q u i) (sineFacePacketBlock ω hω J y)
        - sineFacePacketBlock ω hω J y
      ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
  have hmem : ∀ (p : ι), p ∉ J → insert p J ∈ S →
      addTranslationMeroEquiv (ω p) (y : meroField (Set.univ : Set ℂ))
          - (y : meroField (Set.univ : Set ℂ))
        ∈ differentialAdjoin ℂ (sineDeeperGenerators ω hω S) := by
    intro p hpJ hpS
    obtain ⟨d, hd, r, hr, hstep⟩ := facePacket_offFace_translate_sub_mem ω hω hpJ h2 y.2
    rw [hstep]
    refine (differentialAdjoin ℂ (sineDeeperGenerators ω hω S)).sub_mem ?_ ?_
    · exact subset_differentialAdjoin ℂ _ (Or.inr hr)
    · exact subset_differentialAdjoin ℂ _
        (Or.inl (Set.mem_iUnion₂.mpr ⟨insert p J, hpS, hd⟩))
  fin_cases i
  · exact hmem q hqJ hqS
  · exact hmem u huJ huS

/-- The displacements of the translation block in the two structural directions. -/
def sineFacePacketDisplacement (ω : ι → ℂ) (hω : ∀ k, 0 < (ω k).im)
    {S : Set (Finset ι)} (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (h2 : 2 ≤ (Jᶜ : Finset ι).card) (hqS : insert q J ∈ S) (huS : insert u J ∈ S) :
    Fin 2 → ↥(facePacket ω hω J) → ↥(differentialAdjoin ℂ (sineDeeperGenerators ω hω S)) :=
  fun i y => ⟨addTranslationMeroEquiv (sineFacePacketPeriods ω q u i)
      (sineFacePacketBlock ω hω J y) - sineFacePacketBlock ω hω J y,
    sineFacePacketBlock_period_displacement_mem ω hω J hqJ huJ h2 hqS huS i y⟩

end

end GaloisForLFunctions.HTGeometry
