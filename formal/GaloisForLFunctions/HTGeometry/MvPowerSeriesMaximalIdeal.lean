import Mathlib.RingTheory.MvPowerSeries.Basic
import Mathlib.RingTheory.Ideal.Maps

/-!
# The augmentation ideal of a finite-variable power-series ring

For finitely many variables, the kernel of `constantCoeff` is the ideal generated by the variables.
The proof removes the variables one at a time.  At each step, the discarded part is divisible by the
corresponding variable; after every variable is removed, only the constant coefficient remains.
-/

namespace GaloisForLFunctions.HTGeometry

variable {σ R : Type*} [Fintype σ] [DecidableEq σ] [CommRing R]

/-- Retain only monomials whose exponents vanish on `s`. -/
noncomputable def MvPowerSeries.eraseVariables (s : Finset σ) (f : MvPowerSeries σ R) :
    MvPowerSeries σ R := fun d => if ∀ i ∈ s, d i = 0 then f.coeff d else 0

@[simp] theorem MvPowerSeries.coeff_eraseVariables (s : Finset σ)
    (f : MvPowerSeries σ R) (d : σ →₀ ℕ) :
    (MvPowerSeries.eraseVariables s f).coeff d =
      if ∀ i ∈ s, d i = 0 then f.coeff d else 0 := rfl

@[simp] theorem MvPowerSeries.eraseVariables_empty (f : MvPowerSeries σ R) :
    MvPowerSeries.eraseVariables ∅ f = f := by
  ext d
  simp

theorem MvPowerSeries.eraseVariables_insert_sub_dvd (s : Finset σ) (i : σ)
    (f : MvPowerSeries σ R) :
    MvPowerSeries.X i ∣
      MvPowerSeries.eraseVariables s f - MvPowerSeries.eraseVariables (insert i s) f := by
  classical
  rw [MvPowerSeries.X_dvd_iff]
  intro d hdi
  rw [map_sub]
  by_cases hs : ∀ j ∈ s, d j = 0
  · rw [MvPowerSeries.coeff_eraseVariables, if_pos hs,
      MvPowerSeries.coeff_eraseVariables, if_pos]
    · exact sub_self _
    · intro j hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact hdi
      · exact hs j hj
  · rw [MvPowerSeries.coeff_eraseVariables, if_neg hs,
      MvPowerSeries.coeff_eraseVariables, if_neg]
    · exact sub_self _
    · intro h
      exact hs fun j hj => h j (Finset.mem_insert_of_mem hj)

/-- Removing finitely many variables changes a series by an element of the variable ideal. -/
theorem MvPowerSeries.sub_eraseVariables_mem_span_range (s : Finset σ)
    (f : MvPowerSeries σ R) :
    f - MvPowerSeries.eraseVariables s f ∈
      Ideal.span (Set.range (MvPowerSeries.X : σ → MvPowerSeries σ R)) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp
  · intro i s hi ih
    have hfirst := ih
    have hdvd := MvPowerSeries.eraseVariables_insert_sub_dvd s i f
    obtain ⟨g, hg⟩ := hdvd
    have hX : MvPowerSeries.X i ∈
        Ideal.span (Set.range (MvPowerSeries.X : σ → MvPowerSeries σ R)) :=
      Ideal.subset_span ⟨i, rfl⟩
    have hsecond : MvPowerSeries.eraseVariables s f -
        MvPowerSeries.eraseVariables (insert i s) f ∈
          Ideal.span (Set.range (MvPowerSeries.X : σ → MvPowerSeries σ R)) := by
      rw [hg]
      exact Ideal.mul_mem_right g _ hX
    have hsum :=
      (Ideal.span (Set.range (MvPowerSeries.X : σ → MvPowerSeries σ R))).add_mem
        hfirst hsecond
    convert hsum using 1
    all_goals ring

/-- Erasing every variable leaves the constant series. -/
theorem MvPowerSeries.eraseVariables_univ (f : MvPowerSeries σ R) :
    MvPowerSeries.eraseVariables Finset.univ f = MvPowerSeries.C f.constantCoeff := by
  classical
  ext d
  by_cases hd : d = 0
  · subst d
    rw [MvPowerSeries.coeff_eraseVariables, if_pos (by simp),
      MvPowerSeries.coeff_zero_C, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
  · have hex : ∃ i, d i ≠ 0 := by
      by_contra h
      push Not at h
      exact hd (Finsupp.ext h)
    obtain ⟨i, hi⟩ := hex
    rw [MvPowerSeries.coeff_eraseVariables, if_neg, MvPowerSeries.coeff_C_of_ne_zero hd]
    intro h
    exact hi (h i (Finset.mem_univ i))

/-- **The finite-variable augmentation ideal is exactly the kernel of constant coefficient.** -/
theorem MvPowerSeries.span_range_X_eq_ker_constantCoeff :
    Ideal.span (Set.range (MvPowerSeries.X : σ → MvPowerSeries σ R)) =
      RingHom.ker (MvPowerSeries.constantCoeff (σ := σ) (R := R)) := by
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker]
  · intro f hf
    rw [RingHom.mem_ker] at hf
    have h := MvPowerSeries.sub_eraseVariables_mem_span_range Finset.univ f
    rw [MvPowerSeries.eraseVariables_univ, hf, map_zero, sub_zero] at h
    exact h

end GaloisForLFunctions.HTGeometry
