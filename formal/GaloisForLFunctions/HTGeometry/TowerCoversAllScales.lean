/-
The `A`-tower covers every block scale, and the correct measure of difficulty is the deficit.

The previous file computed the range on which *one* pair — the record pair on the line of symmetry —
beats the trivial bound, and found `(2κ, 1/2]`.  That is not the state of the art at small scales: at
each scale one uses the pair best suited to it, and the tower

    `B(0,1) = (1/2, 1/2)` → `(1/6, 2/3)` → `(1/14, 11/14)` → `(1/30, 13/15)` → `(1/62, 57/62)` → …

obtained by iterating the `A`-process has nontriviality thresholds

    **1/3 , 1/4 , 1/5 , 1/6 , …**

descending to `0`.  So **every block scale `c > 0` carries a nontrivial bound**, and the claim that a
positive fraction of scales has only the trivial bound is withdrawn.

The correct scale-by-scale measure is the **deficit** against the Lindelöf requirement `c/2`:

    D(c) = min over pairs of ( κ + (λ - κ - 1/2)·c ) ,

which is exactly the support function already studied.  It vanishes at `c = 0` and, by the
`B`-symmetry of the exponent-pair region, at `c = 1`; it is concave; and it attains its maximum at the
critical scale `c = 1/2`, where its value is the subconvexity record.  **The difficulty is concentrated
entirely at the critical scale, not spread over a range of uncovered scales.**
-/
import GaloisForLFunctions.HTGeometry.CoveredBlockFraction

namespace HTGeometry

/-! ### The tower -/

/-- Nontriviality threshold of a pair at the block scales: the least `c` beyond which
`κ + (λ-κ)c < c`. -/
def towerThreshold (κ lam : ℚ) : ℚ := κ / (1 - (lam - κ))

/-- **A pair beats the trivial bound exactly above its threshold.** -/
theorem beats_trivial_above_threshold {κ lam c : ℚ} (h : lam - κ < 1) :
    κ + (lam - κ) * c < c ↔ towerThreshold κ lam < c := by
  unfold towerThreshold
  rw [div_lt_iff₀ (by linarith : (0:ℚ) < 1 - (lam - κ))]
  constructor <;> intro hx <;> nlinarith

/-- The first tower pair after `B(0,1)`: Weyl. -/
theorem tower_weyl : towerThreshold weylKappa weylLambda = 1 / 3 := by
  unfold towerThreshold weylKappa weylLambda; norm_num

/-- The second: `A` of Weyl. -/
theorem tower_second : towerThreshold (1 / 14) (11 / 14) = 1 / 4 := by
  unfold towerThreshold; norm_num

/-- The third. -/
theorem tower_third : towerThreshold (1 / 30) (13 / 15) = 1 / 5 := by
  unfold towerThreshold; norm_num

/-- The fourth. -/
theorem tower_fourth : towerThreshold (1 / 62) (57 / 62) = 1 / 6 := by
  unfold towerThreshold; norm_num

/-- **The tower is generated by the `A`-process.** -/
theorem tower_is_procA :
    procA_fst weylKappa = 1 / 14 ∧ procA_snd weylKappa weylLambda = 11 / 14 ∧
      procA_fst (1 / 14) = 1 / 30 ∧ procA_snd (1 / 14) (11 / 14) = 13 / 15 ∧
      procA_fst (1 / 30) = 1 / 62 ∧ procA_snd (1 / 30) (13 / 15) = 57 / 62 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · unfold procA_fst weylKappa; norm_num
  · unfold procA_snd weylKappa weylLambda; norm_num
  · unfold procA_fst; norm_num
  · unfold procA_snd; norm_num
  · unfold procA_fst; norm_num
  · unfold procA_snd; norm_num

/-- **The thresholds descend.** -/
theorem tower_thresholds_descend :
    towerThreshold (1 / 62) (57 / 62) < towerThreshold (1 / 30) (13 / 15) ∧
      towerThreshold (1 / 30) (13 / 15) < towerThreshold (1 / 14) (11 / 14) ∧
      towerThreshold (1 / 14) (11 / 14) < towerThreshold weylKappa weylLambda := by
  rw [tower_weyl, tower_second, tower_third, tower_fourth]
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **Every scale above `1/6` is already covered by the fourth tower pair**, and the pattern
`1/3, 1/4, 1/5, 1/6` descends to zero. -/
theorem scales_above_one_sixth_covered {c : ℚ} (h : 1 / 6 < c) :
    (1 : ℚ) / 62 + (57 / 62 - 1 / 62) * c < c := by
  rw [beats_trivial_above_threshold (by norm_num), tower_fourth]
  exact h

/-- **The record pair's own threshold is `13/42`, far above the tower's**, which is why using it at
small scales understates the state of the art. -/
theorem record_threshold_vs_tower :
    towerThreshold bourgainKappa bourgainLambda = 13 / 42 ∧
      towerThreshold (1 / 62) (57 / 62) < towerThreshold bourgainKappa bourgainLambda := by
  constructor
  · unfold towerThreshold bourgainKappa bourgainLambda; norm_num
  · rw [tower_fourth]
    unfold towerThreshold bourgainKappa bourgainLambda; norm_num

/-! ### The correct measure: the deficit -/

/-- The deficit of a pair against the Lindelöf requirement at scale `c`. -/
def scaleDeficit (κ lam c : ℚ) : ℚ := κ + (lam - κ - 1 / 2) * c

/-- **It is the covering demand**, so the support function already studied is the scale-by-scale
deficit. -/
theorem scaleDeficit_eq_demand (κ lam c : ℚ) :
    scaleDeficit κ lam c = covDemandOfPair c κ lam := by
  unfold scaleDeficit covDemandOfPair covFunctional; ring

/-- **At scale zero the deficit is `κ`**, so the tower drives it to zero there. -/
@[simp] theorem scaleDeficit_at_zero (κ lam : ℚ) : scaleDeficit κ lam 0 = κ := by
  unfold scaleDeficit; ring

/-- The tower's deficits at scale zero descend to zero. -/
theorem tower_deficits_at_zero :
    scaleDeficit (1 / 62) (57 / 62) 0 < scaleDeficit (1 / 30) (13 / 15) 0 ∧
      scaleDeficit (1 / 30) (13 / 15) 0 < scaleDeficit (1 / 14) (11 / 14) 0 ∧
      scaleDeficit (1 / 14) (11 / 14) 0 < scaleDeficit weylKappa weylLambda 0 := by
  simp only [scaleDeficit_at_zero]
  unfold weylKappa
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **At the critical scale every pair's deficit is its own `μ`**, so the tower gains nothing
there. -/
theorem scaleDeficit_at_critical (κ lam : ℚ) :
    scaleDeficit κ lam (1 / 2) = epMu κ lam := by
  rw [scaleDeficit_eq_demand]
  exact displacement_free_at_critical_length κ lam

/-- **The tower's deficits at the critical scale are its `μ` values, and they increase** — the tower
is useful at small scales and useless at the critical one. -/
theorem tower_deficits_at_critical :
    scaleDeficit weylKappa weylLambda (1 / 2) = 1 / 6 ∧
      scaleDeficit (1 / 14) (11 / 14) (1 / 2) = 5 / 28 ∧
      scaleDeficit (1 / 30) (13 / 15) (1 / 2) = 1 / 5 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [scaleDeficit_at_critical]; unfold epMu weylKappa weylLambda; norm_num
  · rw [scaleDeficit_at_critical]; unfold epMu; norm_num
  · rw [scaleDeficit_at_critical]; unfold epMu; norm_num

/-- **The corrected picture.**  Every scale carries a nontrivial bound; the deficit vanishes at
`c = 0`, peaks at the critical scale with the record value, and the tower that clears the small
scales is exactly the one that is worthless at `c = 1/2`. -/
theorem corrected_scale_picture :
    scaleDeficit bourgainKappa bourgainLambda (1 / 2) = bourgainTheta ∧
      scaleDeficit weylKappa weylLambda 0 = 1 / 6 ∧
      scaleDeficit (1 / 62) (57 / 62) 0 = 1 / 62 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [scaleDeficit_at_critical, bourgain_pair_mu]
  · rw [scaleDeficit_at_zero]; unfold weylKappa; norm_num
  · rw [scaleDeficit_at_zero]

end HTGeometry
