import GaloisForLFunctions.HTGeometry.TailDenseObservableFieldClassification
import GaloisForLFunctions.HTGeometry.PrimeConstraintJoining

/-!
# Finite-quotient prime differential duality

A single universal countable prime source realizes every nonempty countable finite-coordinate
constraint by injective selectors.  On any such countable value space, every finite-index
equivalence relation has a canonical embedded differential field generated by its class-indicator
carriers.  These fields remember the complete quotient geometry:

* the class indicators are differentially independent;
* carrier membership is exactly constancy on equivalence classes;
* field inclusion is exactly reverse refinement of equivalence relations;
* field equality is exactly equality of equivalence relations.

Thus finite quotient geometry embeds contravariantly and faithfully into one ambient differential
field.  Orbit partitions of finite-orbit group actions are a special case.
-/

namespace GaloisForLFunctions.HTGeometry

open Set
open scoped Differential

noncomputable section

universe u

variable {W : Type u}

abbrev FiniteQuotientType (r : Setoid W) := Quotient r

noncomputable def classDeltaObservable (r : Setoid W)
    (q : FiniteQuotientType r) (w : W) : ℂ := by
  classical
  exact if Quotient.mk'' w = q then 1 else 0

abbrev FiniteQuotientRank (r : Setoid W) [Fintype (FiniteQuotientType r)] : ℕ :=
  Fintype.card (FiniteQuotientType r)

noncomputable def finiteQuotientIndexEquiv (r : Setoid W)
    [Fintype (FiniteQuotientType r)] :
    Fin (FiniteQuotientRank r) ≃ FiniteQuotientType r :=
  (Fintype.equivFin (FiniteQuotientType r)).symm

def finiteClassDeltaObservable (r : Setoid W)
    [Fintype (FiniteQuotientType r)]
    (j : Fin (FiniteQuotientRank r)) (w : W) : ℂ :=
  classDeltaObservable r (finiteQuotientIndexEquiv r j) w

theorem finiteClassDeltaObservable_linearIndependent (r : Setoid W)
    [Fintype (FiniteQuotientType r)] :
    LinearIndependent ℂ (finiteClassDeltaObservable r) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c h j
  have hj := congrFun h (Quotient.out (finiteQuotientIndexEquiv r j))
  simpa [finiteClassDeltaObservable, classDeltaObservable, Quotient.out_eq'] using hj

abbrev FullValueSubtype (W : Type u) := {w : W // w ∈ (Set.univ : Set W)}

def ClassInvariantRestricted (r : Setoid W) :
    Submodule ℂ (FullValueSubtype W → ℂ) where
  carrier := {f | ∀ x y, r x.1 y.1 → f x = f y}
  zero_mem' := by simp
  add_mem' := by
    intro f g hf hg x y hxy
    change f x + g x = f y + g y
    rw [hf x y hxy, hg x y hxy]
  smul_mem' := by
    intro c f hf x y hxy
    change c * f x = c * f y
    rw [hf x y hxy]

theorem finiteClassDeltaRestricted_mem_invariant (r : Setoid W)
    [Fintype (FiniteQuotientType r)] (j : Fin (FiniteQuotientRank r)) :
    (fun w : FullValueSubtype W ↦ finiteClassDeltaObservable r j w.1) ∈
      ClassInvariantRestricted r := by
  intro x y hxy
  classical
  simp only [finiteClassDeltaObservable, classDeltaObservable]
  apply if_congr
  · constructor
    · intro hx
      exact (Quotient.eq.mpr hxy).symm.trans hx
    · intro hy
      exact (Quotient.eq.mpr hxy).trans hy
  · rfl
  · rfl

theorem finiteClassDeltaRestricted_span_eq_invariant (r : Setoid W)
    [Fintype (FiniteQuotientType r)] :
    Submodule.span ℂ (Set.range (fun j : Fin (FiniteQuotientRank r) ↦
        fun w : FullValueSubtype W ↦ finiteClassDeltaObservable r j w.1)) =
      ClassInvariantRestricted r := by
  classical
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro f ⟨j, rfl⟩
    exact finiteClassDeltaRestricted_mem_invariant r j
  · intro f hf
    have hformula : f = ∑ j : Fin (FiniteQuotientRank r),
        f ⟨Quotient.out (finiteQuotientIndexEquiv r j), Set.mem_univ _⟩ •
          (fun w : FullValueSubtype W ↦ finiteClassDeltaObservable r j w.1) := by
      funext w
      let q : FiniteQuotientType r := Quotient.mk'' w.1
      let j : Fin (FiniteQuotientRank r) := (finiteQuotientIndexEquiv r).symm q
      have hj : finiteQuotientIndexEquiv r j = q :=
        (finiteQuotientIndexEquiv r).apply_symm_apply q
      have hw : f w = f ⟨Quotient.out q, Set.mem_univ _⟩ := by
        apply hf
        rw [← Quotient.eq]
        change q = Quotient.mk'' (Quotient.out q)
        exact (Quotient.out_eq' q).symm
      rw [hw]
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      rw [Finset.sum_eq_single j]
      · simp [finiteClassDeltaObservable, classDeltaObservable, q, hj]
      · intro i _ hij
        have hne : q ≠ finiteQuotientIndexEquiv r i := by
          intro hqi
          apply hij
          apply (finiteQuotientIndexEquiv r).injective
          rw [hj, hqi]
        simp [finiteClassDeltaObservable, classDeltaObservable, q, hne]
      · simp
    rw [hformula]
    apply Submodule.sum_mem
    intro j _
    exact Submodule.smul_mem _ _
      (Submodule.subset_span (Set.mem_range_self j))

theorem finiteClassDeltaRestricted_linearIndependent (r : Setoid W)
    [Fintype (FiniteQuotientType r)] :
    LinearIndependent ℂ (fun j : Fin (FiniteQuotientRank r) ↦
      fun w : FullValueSubtype W ↦ finiteClassDeltaObservable r j w.1) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c h j
  apply (Fintype.linearIndependent_iff.mp
    (finiteClassDeltaObservable_linearIndependent r)) c
  funext w
  have hw := congrFun h ⟨w, Set.mem_univ _⟩
  simpa only [Finset.sum_apply, Pi.smul_apply] using hw

theorem finiteClassDeltaRestricted_mem_span_iff_respects
    (r : Setoid W) [Fintype (FiniteQuotientType r)] (f : W → ℂ) :
    (fun w : FullValueSubtype W ↦ f w.1) ∈
        Submodule.span ℂ (Set.range (fun j : Fin (FiniteQuotientRank r) ↦
          fun w : FullValueSubtype W ↦ finiteClassDeltaObservable r j w.1)) ↔
      ∀ x y, r x y → f x = f y := by
  rw [finiteClassDeltaRestricted_span_eq_invariant r]
  constructor
  · intro h x y hxy
    exact h ⟨x, Set.mem_univ _⟩ ⟨y, Set.mem_univ _⟩ hxy
  · intro h x y hxy
    exact h x.1 y.1 hxy

def primeFiniteQuotientShiftField (y : Nat.Primes → W) (r : Setoid W) (a : ℂ) :
    IntermediateField finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  GaloisForLFunctions.differentialAdjoin finitePrimeRationalCoefficientField
    (Set.range fun q : FiniteQuotientType r ↦
      tailDenseObservableShiftCarrier y (classDeltaObservable r q) a)

theorem primeFiniteQuotientShiftField_eq_tailDenseObservableShiftField
    (y : Nat.Primes → W) (r : Setoid W)
    [Fintype (FiniteQuotientType r)] (a : ℂ) :
    primeFiniteQuotientShiftField y r a =
      tailDenseObservableShiftField y (finiteClassDeltaObservable r) a := by
  unfold primeFiniteQuotientShiftField tailDenseObservableShiftField
  congr 1
  ext z
  constructor
  · rintro ⟨q, rfl⟩
    refine ⟨(finiteQuotientIndexEquiv r).symm q, ?_⟩
    apply congrArg (fun f : W → ℂ ↦ tailDenseObservableShiftCarrier y f a)
    funext w
    simp [finiteClassDeltaObservable]
  · rintro ⟨j, rfl⟩
    exact ⟨finiteQuotientIndexEquiv r j, rfl⟩

theorem cofiniteTailDenseOn_primeFiniteQuotientCarrier_differentialIndependent
    [TopologicalSpace W] [DiscreteTopology W] [Nonempty W]
    (y : Nat.Primes → W) (hy : CofiniteTailDenseOn y Set.univ)
    (r : Setoid W) [Fintype (FiniteQuotientType r)] (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
      (fun j : Fin (FiniteQuotientRank r) ↦
        tailDenseObservableShiftCarrier y (finiteClassDeltaObservable r j) a) := by
  letI : Nonempty (FiniteQuotientType r) := (nonempty_quotient_iff _).mpr inferInstance
  have hpos : 0 < FiniteQuotientRank r := Fintype.card_pos_iff.mpr inferInstance
  letI : Nonempty (Fin (FiniteQuotientRank r)) := Fin.pos_iff_nonempty.mp hpos
  apply cofiniteTailDenseOn_observableShiftCarrier_differentialIndependent
    y Set.univ hy (finiteClassDeltaObservable r)
  · intro j
    exact continuous_of_discreteTopology
  exact finiteClassDeltaRestricted_linearIndependent r

theorem cofiniteTailDenseOn_primeFiniteQuotientCarrier_mem_field_iff_respects
    [TopologicalSpace W] [DiscreteTopology W] [Nonempty W]
    (y : Nat.Primes → W) (hy : CofiniteTailDenseOn y Set.univ)
    (r : Setoid W) [Fintype (FiniteQuotientType r)]
    (f : W → ℂ) (a : ℂ) :
    tailDenseObservableShiftCarrier y f a ∈
        primeFiniteQuotientShiftField y r a ↔
      ∀ x z, r x z → f x = f z := by
  letI : Nonempty (FiniteQuotientType r) := (nonempty_quotient_iff _).mpr inferInstance
  have hpos : 0 < FiniteQuotientRank r := Fintype.card_pos_iff.mpr inferInstance
  letI : Nonempty (Fin (FiniteQuotientRank r)) := Fin.pos_iff_nonempty.mp hpos
  rw [primeFiniteQuotientShiftField_eq_tailDenseObservableShiftField]
  rw [cofiniteTailDenseOn_observableShiftCarrier_mem_field_iff_mem_span
    y Set.univ hy (finiteClassDeltaObservable r)
    (fun _ ↦ continuous_of_discreteTopology)
    (finiteClassDeltaRestricted_linearIndependent r)
    f continuous_of_discreteTopology a]
  exact finiteClassDeltaRestricted_mem_span_iff_respects r f

theorem classInvariantRestricted_le_iff_reverseSetoid
    (r s : Setoid W) :
    ClassInvariantRestricted r ≤ ClassInvariantRestricted s ↔ s ≤ r := by
  classical
  constructor
  · intro h x y hs
    by_contra hr
    let f : FullValueSubtype W → ℂ := fun w ↦
      classDeltaObservable r (Quotient.mk'' x) w.1
    have hfr : f ∈ ClassInvariantRestricted r := by
      intro z t hzt
      simp only [f, classDeltaObservable]
      apply if_congr
      · constructor
        · intro hz
          exact (Quotient.eq.mpr hzt).symm.trans hz
        · intro ht
          exact (Quotient.eq.mpr hzt).trans ht
      · rfl
      · rfl
    have hfs := h hfr
    have heq := hfs ⟨x, Set.mem_univ _⟩ ⟨y, Set.mem_univ _⟩ hs
    have hrev : (Quotient.mk'' y : Quotient r) = Quotient.mk'' x := by
      simpa [f, classDeltaObservable, hr] using heq
    exact hr (Quotient.eq.mp hrev.symm)
  · intro h f hf x y hxy
    exact hf x y (h hxy)

/-- **Finite-quotient differential duality.**  For one tail-complete countable source,
field inclusion is exactly reverse refinement of finite-index equivalence relations. -/
theorem cofiniteTailDenseOn_primeFiniteQuotientField_le_iff_reverseSetoid
    [TopologicalSpace W] [DiscreteTopology W] [Nonempty W]
    (y : Nat.Primes → W) (hy : CofiniteTailDenseOn y Set.univ)
    (r s : Setoid W)
    [Fintype (FiniteQuotientType r)] [Fintype (FiniteQuotientType s)] (a : ℂ) :
    primeFiniteQuotientShiftField y r a ≤
        primeFiniteQuotientShiftField y s a ↔
      s ≤ r := by
  letI : Nonempty (FiniteQuotientType r) := (nonempty_quotient_iff _).mpr inferInstance
  have hrpos : 0 < FiniteQuotientRank r := Fintype.card_pos_iff.mpr inferInstance
  letI : Nonempty (Fin (FiniteQuotientRank r)) := Fin.pos_iff_nonempty.mp hrpos
  letI : Nonempty (FiniteQuotientType s) := (nonempty_quotient_iff _).mpr inferInstance
  have hspos : 0 < FiniteQuotientRank s := Fintype.card_pos_iff.mpr inferInstance
  letI : Nonempty (Fin (FiniteQuotientRank s)) := Fin.pos_iff_nonempty.mp hspos
  rw [primeFiniteQuotientShiftField_eq_tailDenseObservableShiftField,
    primeFiniteQuotientShiftField_eq_tailDenseObservableShiftField]
  rw [cofiniteTailDenseOn_observableShiftField_le_iff_span_le
    y Set.univ hy (finiteClassDeltaObservable r) (finiteClassDeltaObservable s)
    (fun _ ↦ continuous_of_discreteTopology)
    (fun _ ↦ continuous_of_discreteTopology)
    (finiteClassDeltaRestricted_linearIndependent s) a]
  rw [finiteClassDeltaRestricted_span_eq_invariant r,
    finiteClassDeltaRestricted_span_eq_invariant s]
  exact classInvariantRestricted_le_iff_reverseSetoid r s

theorem cofiniteTailDenseOn_primeFiniteQuotientField_eq_iff_setoid_eq
    [TopologicalSpace W] [DiscreteTopology W] [Nonempty W]
    (y : Nat.Primes → W) (hy : CofiniteTailDenseOn y Set.univ)
    (r s : Setoid W)
    [Fintype (FiniteQuotientType r)] [Fintype (FiniteQuotientType s)] (a : ℂ) :
    primeFiniteQuotientShiftField y r a =
        primeFiniteQuotientShiftField y s a ↔ r = s := by
  constructor
  · intro hfield
    apply le_antisymm
    · exact (cofiniteTailDenseOn_primeFiniteQuotientField_le_iff_reverseSetoid
        y hy s r a).mp hfield.ge
    · exact (cofiniteTailDenseOn_primeFiniteQuotientField_le_iff_reverseSetoid
        y hy r s a).mp hfield.le
  · rintro rfl
    rfl

section UniversalSource

noncomputable def universalCountablePrimeProfile (W : Type u)
    [Nonempty W] [Countable W] : Nat.Primes → W :=
  infinitelyRepeatedPrimeProfile chosenPrimeEnumerationEquiv
    (chosenNatSurjection W)

theorem recurringValueSet_universalCountablePrimeProfile
    (W : Type u) [Nonempty W] [Countable W] :
    recurringValueSet (universalCountablePrimeProfile W) = Set.univ := by
  rw [universalCountablePrimeProfile,
    recurringValueSet_infinitelyRepeatedPrimeProfile]
  exact Set.range_eq_univ.mpr (chosenNatSurjection_surjective W)

theorem cofiniteTailDenseOn_universalCountablePrimeProfile
    (W : Type u) [Nonempty W] [Countable W] [TopologicalSpace W] :
    CofiniteTailDenseOn (universalCountablePrimeProfile W) Set.univ :=
  cofiniteTailDenseOn_univ_of_recurringValueSet_eq_univ _
    (recurringValueSet_universalCountablePrimeProfile W)

/-- The same fixed prime source on `V` selects the canonical recurrent profile of every nonempty
countable finite-coordinate constraint. -/
theorem universalCountablePrimeProfile_selects_constraintProfile
    {I V : Type*} [Fintype I] [Nonempty V] [Countable V]
    (C : Set (I → V)) [Nonempty C] [Countable C] :
    ∃ a : Nat.Primes → DistinctConfiguration Nat.Primes I,
      ∀ p i,
        universalCountablePrimeProfile V ((a p).1 i) =
          (universalCountablePrimeProfile C p).1 i := by
  classical
  let x : Nat.Primes → V := universalCountablePrimeProfile V
  let z : Nat.Primes → C := universalCountablePrimeProfile C
  have hx : recurringValueSet x = Set.univ :=
    recurringValueSet_universalCountablePrimeProfile V
  have hA : ∀ p i, {q : Nat.Primes | x q = (z p).1 i}.Infinite := by
    intro p i
    change (z p).1 i ∈ recurringValueSet x
    rw [hx]
    exact Set.mem_univ _
  choose f hf hfx using fun p ↦
    exists_injective_mem_of_forall_infinite
      (fun i ↦ {q : Nat.Primes | x q = (z p).1 i}) (hA p)
  refine ⟨fun p ↦ ⟨f p, hf p⟩, ?_⟩
  intro p i
  exact hfx p i

def universalPrimeFiniteQuotientShiftField
    (W : Type u) [Nonempty W] [Countable W] (r : Setoid W) (a : ℂ) :
    IntermediateField finitePrimeRationalCoefficientField
      arithmeticFunctionRationalCoordinateField :=
  primeFiniteQuotientShiftField (universalCountablePrimeProfile W) r a

theorem universalPrimeFiniteQuotientCarrier_differentialIndependent
    [Nonempty W] [Countable W] [TopologicalSpace W] [DiscreteTopology W]
    (r : Setoid W) [Fintype (FiniteQuotientType r)] (a : ℂ) :
    GaloisForLFunctions.DifferentialIndependent finitePrimeRationalCoefficientField
      (fun j : Fin (FiniteQuotientRank r) ↦
        tailDenseObservableShiftCarrier (universalCountablePrimeProfile W)
          (finiteClassDeltaObservable r j) a) :=
  cofiniteTailDenseOn_primeFiniteQuotientCarrier_differentialIndependent
    _ (cofiniteTailDenseOn_universalCountablePrimeProfile W) r a

theorem universalPrimeFiniteQuotientCarrier_mem_field_iff_respects
    [Nonempty W] [Countable W] [TopologicalSpace W] [DiscreteTopology W]
    (r : Setoid W) [Fintype (FiniteQuotientType r)]
    (f : W → ℂ) (a : ℂ) :
    tailDenseObservableShiftCarrier (universalCountablePrimeProfile W) f a ∈
        universalPrimeFiniteQuotientShiftField W r a ↔
      ∀ x z, r x z → f x = f z :=
  cofiniteTailDenseOn_primeFiniteQuotientCarrier_mem_field_iff_respects
    _ (cofiniteTailDenseOn_universalCountablePrimeProfile W) r f a

/-- **Canonical finite-quotient duality.**  On the fixed universal countable prime source,
finite-index equivalence relations embed contravariantly and faithfully into embedded
differential fields. -/
theorem universalPrimeFiniteQuotientField_le_iff_reverseSetoid
    [Nonempty W] [Countable W] [TopologicalSpace W] [DiscreteTopology W]
    (r s : Setoid W)
    [Fintype (FiniteQuotientType r)] [Fintype (FiniteQuotientType s)] (a : ℂ) :
    universalPrimeFiniteQuotientShiftField W r a ≤
        universalPrimeFiniteQuotientShiftField W s a ↔
      s ≤ r :=
  cofiniteTailDenseOn_primeFiniteQuotientField_le_iff_reverseSetoid
    _ (cofiniteTailDenseOn_universalCountablePrimeProfile W) r s a

theorem universalPrimeFiniteQuotientField_eq_iff_setoid_eq
    [Nonempty W] [Countable W] [TopologicalSpace W] [DiscreteTopology W]
    (r s : Setoid W)
    [Fintype (FiniteQuotientType r)] [Fintype (FiniteQuotientType s)] (a : ℂ) :
    universalPrimeFiniteQuotientShiftField W r a =
        universalPrimeFiniteQuotientShiftField W s a ↔ r = s :=
  cofiniteTailDenseOn_primeFiniteQuotientField_eq_iff_setoid_eq
    _ (cofiniteTailDenseOn_universalCountablePrimeProfile W) r s a

end UniversalSource

end

