import GaloisForLFunctions.HTGeometry.DifferentialRelationSigmaDescent
import GaloisForLFunctions.HTGeometry.DifferentialConstantRelationDescent
import GaloisForLFunctions.HTGeometry.ShiftInvariantDescent

/-!
# Fixed-coefficient generation of a stable polynomial ideal

Let a field automorphism act coefficientwise on a multivariate polynomial ring.  Every ideal stable
under that action is generated, as an ideal, by its invariant polynomials.  The proof normalizes one
nonzero coefficient and inducts on support size: either the normalized polynomial is invariant, or
two coefficientwise difference combinations cancel distinct support terms and reduce the problem.

This algebraic descent lemma is the coefficient layer needed in the no-new-constants argument for
parameterized Picard--Vessiot rings.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open GaloisForLFunctions

variable {K ι : Type*} [Field K]

/-- Ideal generated by the invariant members of `I`. -/
def sigmaFixedPartSpan (σ : K ≃+* K) (I : Ideal (MvPolynomial ι K)) :
    Ideal (MvPolynomial ι K) :=
  Ideal.span {P | P ∈ I ∧ MvPolynomial.map σ P = P}

/-- A coefficientwise-`σ`-stable polynomial ideal is generated by its invariant members. -/
theorem sigmaStableIdeal_le_sigmaFixedPartSpan
    (σ : K ≃+* K) (I : Ideal (MvPolynomial ι K))
    (hI : ∀ P ∈ I, MvPolynomial.map σ P ∈ I) :
    I ≤ sigmaFixedPartSpan σ I := by
  classical
  intro P hPI
  suffices H : ∀ n : ℕ, ∀ Q : MvPolynomial ι K,
      Q.support.card = n → Q ∈ I → Q ∈ sigmaFixedPartSpan σ I by
    exact H P.support.card P rfl hPI
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
      intro Q hcard hQI
      by_cases hQ0 : Q = 0
      · subst Q
        exact Ideal.zero_mem _
      obtain ⟨β, hβ⟩ := Q.support.nonempty_iff_ne_empty.mpr (by
        intro hempty
        apply hQ0
        exact MvPolynomial.support_eq_empty.mp hempty)
      have hβne : MvPolynomial.coeff β Q ≠ 0 := MvPolynomial.mem_support_iff.mp hβ
      let Q' : MvPolynomial ι K :=
        MvPolynomial.C (MvPolynomial.coeff β Q)⁻¹ * Q
      have hQ'support : Q'.support = Q.support := by
        exact GaloisForLFunctions.support_C_mul_eq (inv_ne_zero hβne) Q
      have hQ'card : Q'.support.card = n := by rw [hQ'support, hcard]
      have hQ'I : Q' ∈ I := Ideal.mul_mem_left _ _ hQI
      have hQ'β : MvPolynomial.coeff β Q' = 1 := by
        simp [Q', hβne]
      by_cases hfixed : MvPolynomial.map σ Q' = Q'
      · have hgen : Q' ∈ {P : MvPolynomial ι K | P ∈ I ∧ MvPolynomial.map σ P = P} :=
          ⟨hQ'I, hfixed⟩
        have hQ'J : Q' ∈ sigmaFixedPartSpan σ I := Ideal.subset_span hgen
        have hscale : Q = MvPolynomial.C (MvPolynomial.coeff β Q) * Q' := by
          change Q = MvPolynomial.C (MvPolynomial.coeff β Q) *
            (MvPolynomial.C (MvPolynomial.coeff β Q)⁻¹ * Q)
          rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hβne, map_one, one_mul]
        rw [hscale]
        exact Ideal.mul_mem_left _ _ hQ'J
      · have hcoeff : ∃ α, σ (MvPolynomial.coeff α Q') ≠ MvPolynomial.coeff α Q' := by
          by_contra h
          push Not at h
          apply hfixed
          ext α
          rw [MvPolynomial.coeff_map]
          exact h α
        obtain ⟨α, hα⟩ := hcoeff
        let a : K := MvPolynomial.coeff α Q'
        change σ a ≠ a at hα
        have ha : a ≠ 0 := by
          intro ha0
          apply hα
          rw [ha0, map_zero]
        have haInv : σ a⁻¹ - a⁻¹ ≠ 0 := by
          rw [sub_ne_zero]
          intro heq
          apply hα
          exact inv_injective (by simpa using heq)
        let L : MvPolynomial ι K :=
          MvPolynomial.map σ (MvPolynomial.C a⁻¹ * Q') -
            MvPolynomial.C a⁻¹ * Q'
        let R : MvPolynomial ι K :=
          MvPolynomial.C (σ a⁻¹) * (MvPolynomial.map σ Q' - Q')
        have hLI : L ∈ I := by
          apply Ideal.sub_mem
          · exact hI _ (Ideal.mul_mem_left _ _ hQ'I)
          · exact Ideal.mul_mem_left _ _ hQ'I
        have hRI : R ∈ I := by
          exact Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (hI _ hQ'I) hQ'I)
        have hLsubset : L.support ⊆ Q'.support := by
          intro u hu
          by_contra huQ
          have hzero : MvPolynomial.coeff u Q' = 0 :=
            MvPolynomial.notMem_support_iff.mp huQ
          have : MvPolynomial.coeff u L = 0 := by
            simp only [L, MvPolynomial.coeff_sub, MvPolynomial.coeff_map,
              MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul, hzero, map_zero,
              mul_zero, mul_zero, sub_zero]
          exact MvPolynomial.mem_support_iff.mp hu this
        have hRsubset : R.support ⊆ Q'.support := by
          intro u hu
          by_contra huQ
          have hzero : MvPolynomial.coeff u Q' = 0 :=
            MvPolynomial.notMem_support_iff.mp huQ
          have : MvPolynomial.coeff u R = 0 := by
            simp only [R, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_sub,
              MvPolynomial.coeff_map, hzero, map_zero, sub_zero, mul_zero]
          exact MvPolynomial.mem_support_iff.mp hu this
        have hαQ' : α ∈ Q'.support := MvPolynomial.mem_support_iff.mpr ha
        have hαL : α ∉ L.support := by
          rw [MvPolynomial.notMem_support_iff]
          simp [L, a, ha, MvPolynomial.coeff_map]
        have hβQ' : β ∈ Q'.support := by simpa [hQ'support] using hβ
        have hβR : β ∉ R.support := by
          rw [MvPolynomial.notMem_support_iff]
          simp only [R, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_sub,
            MvPolynomial.coeff_map, hQ'β, map_one, sub_self, mul_zero]
        have hLcard : L.support.card < n := by
          rw [← hQ'card]
          exact Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr
            ⟨hLsubset, fun heq => hαL (heq.symm ▸ hαQ')⟩)
        have hRcard : R.support.card < n := by
          rw [← hQ'card]
          exact Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr
            ⟨hRsubset, fun heq => hβR (heq.symm ▸ hβQ')⟩)
        have hLJ : L ∈ sigmaFixedPartSpan σ I :=
          ih L.support.card hLcard L rfl hLI
        have hRJ : R ∈ sigmaFixedPartSpan σ I :=
          ih R.support.card hRcard R rfl hRI
        have hid : L = R + MvPolynomial.C (σ a⁻¹ - a⁻¹) * Q' := by
          simp [L, R]
          ring
        have hmulJ : MvPolynomial.C (σ a⁻¹ - a⁻¹) * Q' ∈
            sigmaFixedPartSpan σ I := by
          have hsub := Ideal.sub_mem (sigmaFixedPartSpan σ I) hLJ hRJ
          rw [hid] at hsub
          simpa [add_comm] using hsub
        have hrecover : Q' = MvPolynomial.C (σ a⁻¹ - a⁻¹)⁻¹ *
            (MvPolynomial.C (σ a⁻¹ - a⁻¹) * Q') := by
          rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ haInv, map_one, one_mul]
        have hQ'J : Q' ∈ sigmaFixedPartSpan σ I := by
          rw [hrecover]
          exact Ideal.mul_mem_left _ _ hmulJ
        have hscale : Q = MvPolynomial.C (MvPolynomial.coeff β Q) * Q' := by
          change Q = MvPolynomial.C (MvPolynomial.coeff β Q) *
            (MvPolynomial.C (MvPolynomial.coeff β Q)⁻¹ * Q)
          rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hβne, map_one, one_mul]
        rw [hscale]
        exact Ideal.mul_mem_left _ _ hQ'J

section DifferentialRelation

open scoped Differential

variable {R : Type*} [CommRing R] [Algebra K R] [Differential K] [Differential R]

omit [Differential K] in
/-- The full differential-relation ideal of a `σ`-fixed point is generated by its invariant
members.  Unlike single-relation descent, this retains every relation simultaneously. -/
theorem differentialRelationIdealOver_le_sigmaFixedPartSpan
    (σK : K ≃+* K) (σR : R ≃+* R)
    (hcompat : ∀ a : K, σR (algebraMap K R a) = algebraMap K R (σK a))
    (hσδ : ∀ z : R, σR (Differential.deriv z) = Differential.deriv (σR z))
    (x : ι → R) (hx : ∀ i, σR (x i) = x i) :
    differentialRelationIdealOver (K := K) x ≤
      sigmaFixedPartSpan σK (differentialRelationIdealOver (K := K) x) := by
  apply sigmaStableIdeal_le_sigmaFixedPartSpan
  intro P hP
  rw [mem_differentialRelationIdealOver_iff] at hP ⊢
  change differentialPolynomialEvalOver (K := K) x
    (differentialPolynomialSigma σK P) = 0
  rw [differentialPolynomialEvalOver_sigma σK σR hcompat hσδ x hx, hP, map_zero]

variable {C : Type*} [Field C] [Algebra C K] [Differential C]

omit [Differential C] [Differential K] in
/-- If every base-field `σ`-fixed element descends to `C`, then the complete relation ideal of a
`σ`-fixed point is exactly the scalar extension of its contraction to `C`. -/
theorem differentialRelationIdealOver_eq_map_fixedDescent
    (σK : K ≃+* K) (σR : R ≃+* R)
    (hcompat : ∀ a : K, σR (algebraMap K R a) = algebraMap K R (σK a))
    (hσδ : ∀ z : R, σR (Differential.deriv z) = Differential.deriv (σR z))
    (hfix : ∀ a : K, σK a = a → ∃ c : C, algebraMap C K c = a)
    (x : ι → R) (hx : ∀ i, σR (x i) = x i) :
    Ideal.map (differentialCoeffExtend (ι := ι) (F := C) (L := K))
        (Ideal.comap (differentialCoeffExtend (ι := ι) (F := C) (L := K))
          (differentialRelationIdealOver (K := K) x)) =
      differentialRelationIdealOver (K := K) x := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
  · calc
      differentialRelationIdealOver (K := K) x ≤
          sigmaFixedPartSpan σK (differentialRelationIdealOver (K := K) x) :=
        differentialRelationIdealOver_le_sigmaFixedPartSpan σK σR hcompat hσδ x hx
      _ ≤ Ideal.map (differentialCoeffExtend (ι := ι) (F := C) (L := K))
          (Ideal.comap (differentialCoeffExtend (ι := ι) (F := C) (L := K))
            (differentialRelationIdealOver (K := K) x)) := by
        rw [sigmaFixedPartSpan, Ideal.span_le]
        rintro P ⟨hPI, hPinv⟩
        obtain ⟨Q, hQ⟩ := exists_descend_of_coeff_mem_range
          (ι := ι) (F := C) (L := K) (P := P) (fun u => hfix _ (by
            have hc := congrArg (MvPolynomial.coeff u) hPinv
            simpa [MvPolynomial.coeff_map] using hc))
        rw [← hQ]
        apply Ideal.mem_map_of_mem
        change differentialCoeffExtend (ι := ι) (F := C) (L := K) Q ∈
          differentialRelationIdealOver (K := K) x
        exact hQ ▸ hPI

end DifferentialRelation

end

end GaloisForLFunctions.HTGeometry
