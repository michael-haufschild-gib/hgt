/-- The real formula is the actual complex modular source polynomial under embedding. -/
theorem evenCompactSourceScalar11_eq (u a w : ℝ) :
    MvPolynomial.eval (oddCompactState u a w)
      (modularThetaLyapunovNormalizedSourceJet 11) =
      (evenCompactSourceScalar11 u a w : ℂ) := by
  rw [evenCompactSourceJet11_eq]
  simp only [evenCompactSourceJet11, map_add, map_mul, map_pow,
    MvPolynomial.eval_C, MvPolynomial.eval_X, oddCompactState]
  unfold evenCompactSourceScalar11
  push_cast
  ring

