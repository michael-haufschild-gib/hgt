import GaloisForLFunctions.HTGeometry.HalfPlaneRungeClosure
import GaloisForLFunctions.HTGeometry.RungeOneAtomAbsorption

/-!
# Discharging the one-generator Runge interface

The abstract interface `OneGeneratorRungeDense` asserts that the algebra generated by a single
element is dense in the ambient one.  For the holomorphic functions on the right half-plane, with
the Cauchy coordinate as generator, that is now a theorem rather than a hypothesis: the ambient
algebra is `holoAlgebra` as a type, and density there is the Runge containment read through the
subtype topology.

The ambient must be the holomorphic algebra: in `C(↥H, ℂ)` the corresponding statement is false,
since the contour functional annihilates every power of the coordinate.

* `HTGeometry.oneGeneratorRungeDense_holoAlgebra`.
-/

namespace HTGeometry

open GaloisForLFunctions.HTGeometry in
/-- **The one-generator Runge interface holds for the Cauchy coordinate on the half-plane.** -/
theorem oneGeneratorRungeDense_holoAlgebra {a : ℝ} (ha : 0 < a) :
    OneGeneratorRungeDense ℂ (holoAlgebra)
      (⟨cauchyCoord a ha, cauchyCoord_mem_holoAlgebra ha⟩ : holoAlgebra) := by
  classical
  set r' : holoAlgebra := ⟨cauchyCoord a ha, cauchyCoord_mem_holoAlgebra ha⟩ with hr'
  rw [OneGeneratorRungeDense]
  refine top_unique fun x _ => ?_
  have hximage : (x : C((rightHalfPlane : Set ℂ), ℂ)) ∈
      (Algebra.adjoin ℂ ({cauchyCoord a ha} :
        Set C((rightHalfPlane : Set ℂ), ℂ))).topologicalClosure := by
    refine holo_mem_topologicalClosure_adjoin_cauchyCoord ha _ x.2
  rw [← SetLike.mem_coe, Subalgebra.topologicalClosure_coe] at hximage
  have himg : (Subtype.val '' (Algebra.adjoin ℂ ({r'} : Set holoAlgebra) : Set holoAlgebra))
      = (Algebra.adjoin ℂ ({cauchyCoord a ha} :
          Set C((rightHalfPlane : Set ℂ), ℂ)) : Set C((rightHalfPlane : Set ℂ), ℂ)) := by
    have hmap : (Algebra.adjoin ℂ ({r'} : Set holoAlgebra)).map holoAlgebra.val
        = Algebra.adjoin ℂ ({cauchyCoord a ha} : Set C((rightHalfPlane : Set ℂ), ℂ)) := by
      rw [AlgHom.map_adjoin]
      congr 1
      simp [hr']
    have hcm := Subalgebra.coe_map (holoAlgebra.val) (Algebra.adjoin ℂ ({r'} : Set holoAlgebra))
    rw [hmap] at hcm
    exact hcm.symm
  rw [← SetLike.mem_coe, Subalgebra.topologicalClosure_coe, closure_subtype, himg]
  exact hximage

end HTGeometry
