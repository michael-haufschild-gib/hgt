import GaloisForLFunctions.HTGeometry.PauliTwoTimeEndpointJacobianCoercivityLaw
import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Two-time circuit-normal Jacobian law

The correct coarea invariant is not raw observer rank and not circuit-parameter
count.  It is their exact incidence overlap.  Quotienting an observer by a
target tangent conserves rank: normal rank plus source--target incidence rank
equals the original observer rank.

For one ordinary two-local Pauli Hamiltonian drawn inside the standard
system-size box, the short-separated two-time endpoint observer is injective
at every base time.  Hence its circuit-normal rank plus exact tangent overlap
is the full number of local Hamiltonian coefficients.  A depth-`s` chart can
hide at most `16s` directions, giving an unconditional normal-rank floor.
-/

open Module LinearMap

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {K E P F : Type*} [Field K]
  [AddCommGroup E] [Module K E] [FiniteDimensional K E]
  [AddCommGroup P] [Module K P] [FiniteDimensional K P]
  [AddCommGroup F] [Module K F] [FiniteDimensional K F]

/-- Observer after quotienting output directions generated by a target
tangent. -/
def normalQuotientObserver (L : E →ₗ[K] F) (T : P →ₗ[K] F) :
    E →ₗ[K] (F ⧸ LinearMap.range T) :=
  (LinearMap.range T).mkQ.comp L

/-- **Observer--target incidence conservation.** Normal observer rank and
the exact overlap of observer and target tangent ranges partition the raw
observer rank. -/
theorem finrank_range_normalQuotientObserver_add_incidence_eq
    (L : E →ₗ[K] F) (T : P →ₗ[K] F) :
    Module.finrank K (LinearMap.range (normalQuotientObserver L T)) +
        Module.finrank K (LinearMap.range L ⊓ LinearMap.range T : Submodule K F) =
      Module.finrank K (LinearMap.range L) := by
  let M := LinearMap.range L
  let q := (LinearMap.range T).mkQ
  let f := q.domRestrict M
  have hrange : LinearMap.range f =
      LinearMap.range (normalQuotientObserver L T) := by
    simp [f, q, M, normalQuotientObserver, LinearMap.range_comp]
  have hkerMap : Submodule.map M.subtype (LinearMap.ker f) =
      (LinearMap.range L ⊓ LinearMap.range T : Submodule K F) := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      constructor
      · exact x.2
      · have hxzero : q x = 0 := LinearMap.mem_ker.mp hx
        have : (x : F) ∈ LinearMap.range T := by
          rw [← Submodule.ker_mkQ (LinearMap.range T)]
          exact hxzero
        exact this
    · rintro ⟨hyL, hyT⟩
      let x : M := ⟨y, hyL⟩
      refine ⟨x, ?_, rfl⟩
      apply LinearMap.mem_ker.mpr
      change q x = 0
      rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
      exact hyT
  have hker : Module.finrank K (LinearMap.ker f) =
      Module.finrank K
        (LinearMap.range L ⊓ LinearMap.range T : Submodule K F) := by
    rw [← hkerMap]
    exact (Submodule.equivMapOfInjective M.subtype Subtype.coe_injective
      (LinearMap.ker f)).finrank_eq
  have hrankNullity := LinearMap.finrank_range_add_finrank_ker f
  rw [hrange, hker] at hrankNullity
  exact hrankNullity

end

section Physical

open scoped Matrix.Norms.L2Operator

/-- **Same-draw two-time incidence conservation.** Any circuit tangent can
hide only its exact overlap with the short-separated two-time Hamiltonian
observer. Every other ordinary two-local coefficient direction survives in
the normal quotient, for every boxed draw and every base time. -/
theorem realTwoLocalPauli_twoTime_normalJacobian_incidence_conservation
    (n : ℕ)
    (z : {x : TwoLocalPauliCoefficientSpace (n + 1) //
      x ∈ twoLocalPauliCoefficientBox (n + 1)})
    (t : ℝ)
    {P : Type*} [AddCommGroup P] [Module ℝ P] [FiniteDimensional ℝ P]
    (circuitTangent : P →ₗ[ℝ]
      EuclideanSpace ℝ
        (Bool × MatrixRealCoordinateIndex
          (FiniteQubitConfiguration (Fin (n + 1))))) :
    Module.finrank ℝ (LinearMap.range
        (normalQuotientObserver
          (realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
            (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap
          circuitTangent)) +
        Module.finrank ℝ
          (LinearMap.range
              ((realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
                (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap) ⊓
            LinearMap.range circuitTangent : Submodule ℝ _) =
      Fintype.card (PauliTracelessLabel (n + 1) 2) := by
  let L := (realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
    (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap
  have hconservation :=
    finrank_range_normalQuotientObserver_add_incidence_eq L circuitTangent
  have hLinj : Function.Injective L := by
    intro x y hxy
    have hzero : L (x - y) = 0 := by
      rw [map_sub, hxy, sub_self]
    have hlower :=
      realTwoLocalPauliTwoTimeEndpointRealJacobian_lower_of_mem_box
        (n := n + 1) (Nat.succ_pos n) z.2 t (x - y)
    change (1 / (72 * (((n + 1 : ℕ) : ℝ)) ^ 3)) / 4 * ‖x - y‖ ≤
      ‖L (x - y)‖ at hlower
    rw [hzero, norm_zero] at hlower
    have hscale : 0 <
        (1 / (72 * (((n + 1 : ℕ) : ℝ)) ^ 3)) / 4 := by positivity
    have hnorm : ‖x - y‖ = 0 := by nlinarith [norm_nonneg (x - y)]
    exact sub_eq_zero.mp (norm_eq_zero.mp hnorm)
  rw [LinearMap.finrank_range_of_inj hLinj] at hconservation
  simpa [L, TwoLocalPauliCoefficientSpace] using hconservation

/-- A depth-`s` two-qubit circuit chart has at most `16s` real tangent
directions. The remaining ordinary two-local directions survive in the exact
normal observer at every boxed draw and base time. -/
theorem realTwoLocalPauli_twoTime_normalJacobian_rank_floor
    (n s : ℕ)
    (z : {x : TwoLocalPauliCoefficientSpace (n + 1) //
      x ∈ twoLocalPauliCoefficientBox (n + 1)})
    (t : ℝ)
    (circuitTangent : EuclideanSpace ℝ (Fin (s * 16)) →ₗ[ℝ]
      EuclideanSpace ℝ
        (Bool × MatrixRealCoordinateIndex
          (FiniteQubitConfiguration (Fin (n + 1))))) :
    Fintype.card (PauliTracelessLabel (n + 1) 2) - s * 16 ≤
      Module.finrank ℝ (LinearMap.range
        (normalQuotientObserver
          (realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
            (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap
          circuitTangent)) := by
  have hconservation :=
    realTwoLocalPauli_twoTime_normalJacobian_incidence_conservation
      n z t circuitTangent
  have hintersection : Module.finrank ℝ
      (LinearMap.range
          ((realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
            (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap) ⊓
        LinearMap.range circuitTangent : Submodule ℝ _) ≤ s * 16 := by
    calc
      Module.finrank ℝ
          (LinearMap.range
              ((realTwoLocalPauliTwoTimeEndpointRealJacobian z.1 t
                (1 / (72 * ((n + 1 : ℕ) : ℝ) ^ 3))).toLinearMap) ⊓
            LinearMap.range circuitTangent : Submodule ℝ _) ≤
          Module.finrank ℝ (LinearMap.range circuitTangent) :=
        Submodule.finrank_mono inf_le_right
      _ ≤ Module.finrank ℝ (EuclideanSpace ℝ (Fin (s * 16))) :=
        LinearMap.finrank_range_le circuitTangent
      _ = s * 16 := by simp
  omega

end Physical

end GaloisForLFunctions.HTGeometry
