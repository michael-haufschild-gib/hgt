import GaloisForLFunctions.HTGeometry.FiniteReporterGramFisher
import GaloisForLFunctions.HTGeometry.GramDeterminantDistance

/-!
# Conditional Fisher information of a derivative-clock reporter

For a physics, genomic, or learned reporter, the information supplied by the `N`-th derivative
after conditioning on the first `N` reported derivatives is the squared norm of its
Gram--Schmidt innovation.  It vanishes exactly when the new reported value is already in the
span of the earlier reported values.  When the preceding Gram block is nonsingular, this value
is exactly the multiplicative increment of the Gram/Fisher determinant.

Every finite-dimensional reporter must therefore suffer a first zero conditional-information
value.  For a constant-coefficient-differentially-transcendental clock, the underlying derivative
does not lie in the span of its predecessors: the collapse is created by observation, not by a
finite differential law of the source.  No temporal evolution model is used.
-/

open scoped InnerProductSpace
open InnerProductSpace

namespace HTGeometry

noncomputable section

open GaloisForLFunctions Module

/-- Span of the first `N` reported derivative-clock readings. -/
def finiteDerivativeReporterPreviousSpace
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) : Submodule ℂ Y :=
  Submodule.span ℂ
    (Set.range fun i : Fin N => report (iteratedDeriv (i : ℕ) f))

/-- Orthogonal innovation in the `N`-th reported derivative after removing all earlier readings. -/
def finiteDerivativeReporterInnovation
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) : Y :=
  gramSchmidt ℂ (fun k : ℕ => report (iteratedDeriv k f)) N

/-- Conditional Gram/Fisher information contributed by the `N`-th derivative reading. -/
def finiteDerivativeReporterConditionalInformation
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) : ℝ :=
  ‖finiteDerivativeReporterInnovation N f report‖ ^ (2 : ℕ)

/-- Conditional information is nonnegative. -/
theorem finiteDerivativeReporterConditionalInformation_nonneg
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    0 ≤ finiteDerivativeReporterConditionalInformation N f report := by
  exact sq_nonneg _

/-- The reporter innovation vanishes exactly when the new reported derivative is generated by
the preceding reported derivatives. -/
theorem finiteDerivativeReporterInnovation_eq_zero_iff
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterInnovation N f report = 0 ↔
      report (iteratedDeriv N f) ∈
        finiteDerivativeReporterPreviousSpace N f report := by
  let w : ℕ → Y := fun k => report (iteratedDeriv k f)
  have himage : w '' Set.Iio N =
      Set.range (fun i : Fin N => report (iteratedDeriv (i : ℕ) f)) := by
    ext y
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, i.2, rfl⟩
  change gramSchmidt ℂ w N = 0 ↔
    w N ∈ Submodule.span ℂ
      (Set.range fun i : Fin N => report (iteratedDeriv (i : ℕ) f))
  rw [GaloisForLFunctions.HTGeometry.gramSchmidt_eq_zero_iff_mem_span_Iio,
    himage]

/-- Zero conditional information is exactly observational dependence on earlier clock readings. -/
theorem finiteDerivativeReporterConditionalInformation_eq_zero_iff
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterConditionalInformation N f report = 0 ↔
      report (iteratedDeriv N f) ∈
        finiteDerivativeReporterPreviousSpace N f report := by
  constructor
  · intro hzero
    have hnorm : ‖finiteDerivativeReporterInnovation N f report‖ = 0 := by
      unfold finiteDerivativeReporterConditionalInformation at hzero
      nlinarith [norm_nonneg (finiteDerivativeReporterInnovation N f report)]
    exact (finiteDerivativeReporterInnovation_eq_zero_iff N f report).mp
      (norm_eq_zero.mp hnorm)
  · intro hmem
    have hzero := (finiteDerivativeReporterInnovation_eq_zero_iff N f report).mpr hmem
    simp [finiteDerivativeReporterConditionalInformation, hzero]

/-- **Normalized blind-packet classification of zero innovation.**  The newest derivative reading
is conditionally redundant exactly when the coefficient kernel at the next resolution contains a
packet whose newest coefficient is `-1`.  Thus zero conditional information records a relation
involving that specific new reading, rather than an arbitrary older kernel defect. -/
theorem finiteDerivativeReporterConditionalInformation_eq_zero_iff_exists_normalizedBlindPacket
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterConditionalInformation N f report = 0 ↔
      ∃ c : Fin (N + 1) → ℂ,
        c (Fin.last N) = -1 ∧
        c ∈ LinearMap.ker (finiteDerivativeReporterMap (N + 1) f report) := by
  rw [finiteDerivativeReporterConditionalInformation_eq_zero_iff]
  constructor
  · intro hmem
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hmem
    let c : Fin (N + 1) → ℂ := Fin.lastCases (-1) a
    refine ⟨c, by simp [c], ?_⟩
    rw [LinearMap.mem_ker]
    simp [finiteDerivativeReporterMap, finiteDerivativeJetSynthesis,
      finiteDerivativeReporterPacket, c, Fin.sum_univ_castSucc, ha]
  · rintro ⟨c, hclast, hc⟩
    apply (Submodule.mem_span_range_iff_exists_fun ℂ).mpr
    refine ⟨fun i => c i.castSucc, ?_⟩
    rw [LinearMap.mem_ker] at hc
    have hc' :
        (∑ i : Fin N, c i.castSucc • report (iteratedDeriv (i : ℕ) f)) -
            report (iteratedDeriv N f) = 0 := by
      simpa [finiteDerivativeReporterMap, finiteDerivativeJetSynthesis,
        finiteDerivativeReporterPacket, Fin.sum_univ_castSucc, hclast,
        sub_eq_add_neg] using hc
    exact sub_eq_zero.mp hc'

/-- Positive conditional information means that the new clock reading escapes the preceding
reported observable space. -/
theorem finiteDerivativeReporterConditionalInformation_pos_iff
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    0 < finiteDerivativeReporterConditionalInformation N f report ↔
      report (iteratedDeriv N f) ∉
        finiteDerivativeReporterPreviousSpace N f report := by
  have hnonneg := finiteDerivativeReporterConditionalInformation_nonneg N f report
  have hzero := finiteDerivativeReporterConditionalInformation_eq_zero_iff N f report
  constructor
  · intro hpos hmem
    exact (ne_of_gt hpos) (hzero.mpr hmem)
  · intro hnotmem
    have hne : finiteDerivativeReporterConditionalInformation N f report ≠ 0 := by
      intro hz
      exact hnotmem (hzero.mp hz)
    exact lt_of_le_of_ne hnonneg (Ne.symm hne)

/-! ## Sequential visible-rank law -/

/-- The span of the first `N` reported readings is exactly the visible coefficient range of the
`N`-jet reporter map.  This identifies the geometric space used by conditional information with
the algebraic space used by reporter rank--nullity. -/
theorem finiteDerivativeReporterPreviousSpace_eq_range
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterPreviousSpace N f report =
      LinearMap.range (finiteDerivativeReporterMap N f report) := by
  ext y
  constructor
  · intro hy
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hy
    refine ⟨c, ?_⟩
    simpa [finiteDerivativeReporterMap, finiteDerivativeJetSynthesis,
      finiteDerivativeReporterPacket] using hc
  · rintro ⟨c, rfl⟩
    apply (Submodule.mem_span_range_iff_exists_fun ℂ).mpr
    refine ⟨c, ?_⟩
    simp [finiteDerivativeReporterMap, finiteDerivativeJetSynthesis,
      finiteDerivativeReporterPacket]

/-- Visible reporter spaces are monotone as the derivative resolution grows. -/
theorem finiteDerivativeReporterPreviousSpace_mono_succ
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterPreviousSpace N f report ≤
      finiteDerivativeReporterPreviousSpace (N + 1) f report := by
  apply Submodule.span_mono
  rintro y ⟨i, rfl⟩
  exact ⟨Fin.castSucc i, rfl⟩

/-- Advancing one derivative step adjoins exactly the newest reported reading to the preceding
visible space. -/
theorem finiteDerivativeReporterPreviousSpace_succ_eq_sup
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterPreviousSpace (N + 1) f report =
      finiteDerivativeReporterPreviousSpace N f report ⊔
        ℂ ∙ report (iteratedDeriv N f) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro y ⟨i, rfl⟩
    exact Fin.lastCases
      ((show ℂ ∙ report (iteratedDeriv N f) ≤
          finiteDerivativeReporterPreviousSpace N f report ⊔
            ℂ ∙ report (iteratedDeriv N f) from le_sup_right)
        (Submodule.mem_span_singleton_self _))
      (fun j =>
        (show finiteDerivativeReporterPreviousSpace N f report ≤
            finiteDerivativeReporterPreviousSpace N f report ⊔
              ℂ ∙ report (iteratedDeriv N f) from le_sup_left)
          (Submodule.subset_span ⟨j, rfl⟩)) i
  · apply sup_le
    · exact finiteDerivativeReporterPreviousSpace_mono_succ N f report
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact Submodule.subset_span ⟨Fin.last N, rfl⟩

/-- One new derivative reading can enlarge the visible coefficient range by at most one
dimension, even when the reporter output space is infinite-dimensional. -/
theorem finiteDerivativeReporterMap_range_finrank_succ_le
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finrank ℂ (LinearMap.range (finiteDerivativeReporterMap (N + 1) f report)) ≤
      finrank ℂ (LinearMap.range (finiteDerivativeReporterMap N f report)) + 1 := by
  letI : FiniteDimensional ℂ
      (finiteDerivativeReporterPreviousSpace N f report) :=
    FiniteDimensional.span_of_finite ℂ (Set.finite_range _)
  letI : FiniteDimensional ℂ (ℂ ∙ report (iteratedDeriv N f)) :=
    FiniteDimensional.span_of_finite ℂ (Set.finite_singleton _)
  rw [← finiteDerivativeReporterPreviousSpace_eq_range,
    ← finiteDerivativeReporterPreviousSpace_eq_range,
    finiteDerivativeReporterPreviousSpace_succ_eq_sup]
  calc
    finrank ℂ (finiteDerivativeReporterPreviousSpace N f report ⊔
        ℂ ∙ report (iteratedDeriv N f) : Submodule ℂ Y) ≤
      finrank ℂ (finiteDerivativeReporterPreviousSpace N f report) +
        finrank ℂ (ℂ ∙ report (iteratedDeriv N f)) :=
      Submodule.finrank_add_le_finrank_add_finrank _ _
    _ ≤ finrank ℂ (finiteDerivativeReporterPreviousSpace N f report) + 1 := by
      gcongr
      simpa using
        (finrank_span_le_card ({report (iteratedDeriv N f)} : Set Y))

/-- Zero conditional information is exactly stagnation of the visible reporter space at the next
derivative resolution. -/
theorem finiteDerivativeReporterConditionalInformation_eq_zero_iff_previousSpace_succ_eq
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterConditionalInformation N f report = 0 ↔
      finiteDerivativeReporterPreviousSpace (N + 1) f report =
        finiteDerivativeReporterPreviousSpace N f report := by
  rw [finiteDerivativeReporterConditionalInformation_eq_zero_iff]
  constructor
  · intro hnew
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro y ⟨i, rfl⟩
      exact Fin.lastCases hnew
        (fun j => Submodule.subset_span ⟨j, rfl⟩) i
    · exact finiteDerivativeReporterPreviousSpace_mono_succ N f report
  · intro hspace
    rw [← hspace]
    exact Submodule.subset_span ⟨Fin.last N, rfl⟩

/-- **Sequential rank-stagnation law.** Conditional information vanishes exactly when admitting
the newest derivative coefficient leaves reporter capacity unchanged.  No source-independence or
finite-dimensional output hypothesis is required. -/
theorem finiteDerivativeReporterConditionalInformation_eq_zero_iff_finrank_range_eq
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    finiteDerivativeReporterConditionalInformation N f report = 0 ↔
      finrank ℂ (LinearMap.range (finiteDerivativeReporterMap (N + 1) f report)) =
        finrank ℂ (LinearMap.range (finiteDerivativeReporterMap N f report)) := by
  rw [finiteDerivativeReporterConditionalInformation_eq_zero_iff_previousSpace_succ_eq]
  rw [finiteDerivativeReporterPreviousSpace_eq_range,
    finiteDerivativeReporterPreviousSpace_eq_range]
  constructor
  · exact congrArg (fun W : Submodule ℂ Y => finrank ℂ W)
  · intro hrank
    apply (Submodule.eq_of_le_of_finrank_le ?_ ?_).symm
    · simpa only [← finiteDerivativeReporterPreviousSpace_eq_range] using
        finiteDerivativeReporterPreviousSpace_mono_succ N f report
    · exact le_of_eq hrank

/-- Positive conditional information is exactly strict growth of visible reporter rank. -/
theorem finiteDerivativeReporterConditionalInformation_pos_iff_finrank_range_lt
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    0 < finiteDerivativeReporterConditionalInformation N f report ↔
      finrank ℂ (LinearMap.range (finiteDerivativeReporterMap N f report)) <
        finrank ℂ (LinearMap.range (finiteDerivativeReporterMap (N + 1) f report)) := by
  have hmono :
      finrank ℂ (LinearMap.range (finiteDerivativeReporterMap N f report)) ≤
        finrank ℂ (LinearMap.range (finiteDerivativeReporterMap (N + 1) f report)) := by
    apply Submodule.finrank_mono
    simpa only [← finiteDerivativeReporterPreviousSpace_eq_range] using
      finiteDerivativeReporterPreviousSpace_mono_succ N f report
  have hzero :=
    finiteDerivativeReporterConditionalInformation_eq_zero_iff_finrank_range_eq N f report
  have hnonneg := finiteDerivativeReporterConditionalInformation_nonneg N f report
  constructor
  · intro hpos
    apply lt_of_le_of_ne hmono
    intro heq
    exact (ne_of_gt hpos) (hzero.mpr heq.symm)
  · intro hrank
    apply lt_of_le_of_ne hnonneg
    intro hzero'
    exact (ne_of_lt hrank) (hzero.mp hzero'.symm).symm

/-- **Exact one-step reporter-capacity law.** A derivative reading carries positive conditional
information exactly when it raises visible coefficient capacity by one.  Together with the zero
case above, every step has the sharp dichotomy `0` or `1`. -/
theorem finiteDerivativeReporterConditionalInformation_pos_iff_finrank_range_succ_eq_add_one
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    0 < finiteDerivativeReporterConditionalInformation N f report ↔
      finrank ℂ (LinearMap.range (finiteDerivativeReporterMap (N + 1) f report)) =
        finrank ℂ (LinearMap.range (finiteDerivativeReporterMap N f report)) + 1 := by
  rw [finiteDerivativeReporterConditionalInformation_pos_iff_finrank_range_lt]
  have hupper := finiteDerivativeReporterMap_range_finrank_succ_le N f report
  omega

/-- **Sequential D-optimal/Fisher value law.**  Once the first `N` reported derivatives are
identifiable, the next Gram determinant is the old determinant times the new conditional
information. -/
theorem finiteDerivativeReporterGram_succ_det_eq_mul_conditionalInformation
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y)
    (hprev : (finiteDerivativeReporterGram N f report).det ≠ 0) :
    (finiteDerivativeReporterGram (N + 1) f report).det =
      (finiteDerivativeReporterGram N f report).det *
        (finiteDerivativeReporterConditionalInformation N f report : ℂ) := by
  let w : ℕ → Y := fun k => report (iteratedDeriv k f)
  have hprev' : (Matrix.gram ℂ (fun i : Fin N => w (i : ℕ))).det ≠ 0 := by
    simpa only [finiteDerivativeReporterGram, w] using hprev
  rw [finiteDerivativeReporterGram, finiteDerivativeReporterGram,
    GaloisForLFunctions.HTGeometry.det_gram_fin_succ_of_det_ne_zero w N hprev']
  congr 1
  change inner ℂ (gramSchmidt ℂ w N) (gramSchmidt ℂ w N) =
    ((‖gramSchmidt ℂ w N‖ ^ (2 : ℕ) : ℝ) : ℂ)
  apply Complex.ext <;> simp

/-- **Sequential observability criterion.**  A finite derivative reporter block is faithful
exactly when every derivative admitted into that block contributes strictly positive conditional
information beyond all earlier readings.  This replaces one opaque determinant hypothesis by a
triangular family of source-ordered innovation tests. -/
theorem finiteDerivativeReporterGram_det_ne_zero_iff_forall_conditionalInformation_pos
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    (N : ℕ) (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    (finiteDerivativeReporterGram N f report).det ≠ 0 ↔
      ∀ k : ℕ, k < N →
        0 < finiteDerivativeReporterConditionalInformation k f report := by
  let w : ℕ → Y := fun k => report (iteratedDeriv k f)
  constructor
  · intro hdet k hk
    have hLI : LinearIndependent ℂ
        (fun i : Fin N => w (i : ℕ)) := by
      apply Matrix.det_gram_ne_zero_iff_linearIndependent.mp
      simpa only [finiteDerivativeReporterGram, w] using hdet
    have hsmall : LinearIndependent ℂ
        (fun i : Fin (k + 1) => w (i : ℕ)) := by
      let e : Fin (k + 1) → Fin N := fun i => ⟨i, by omega⟩
      apply hLI.comp e
      intro i j hij
      exact Fin.ext (congrArg (fun x : Fin N => x.val) hij)
    have hprev : LinearIndependent ℂ (fun i : Fin k => w (i : ℕ)) := by
      exact hsmall.comp Fin.castSucc (Fin.castSucc_injective k)
    have hinnovation : gramSchmidt ℂ w k ≠ 0 :=
      (GaloisForLFunctions.HTGeometry.linearIndependent_fin_succ_iff_gramSchmidt_ne_zero
        w k hprev).mp hsmall
    unfold finiteDerivativeReporterConditionalInformation
      finiteDerivativeReporterInnovation
    exact sq_pos_of_pos (norm_pos_iff.mpr hinnovation)
  · intro hall
    apply Matrix.det_gram_ne_zero_iff_linearIndependent.mpr
    change LinearIndependent ℂ (fun i : Fin N => w (i : ℕ))
    induction N with
    | zero => exact linearIndependent_empty_type
    | succ N ih =>
        have hprev : LinearIndependent ℂ (fun i : Fin N => w (i : ℕ)) :=
          ih (fun k hk => hall k (Nat.lt_succ_of_lt hk))
        apply (GaloisForLFunctions.HTGeometry.linearIndependent_fin_succ_iff_gramSchmidt_ne_zero
          w N hprev).mpr
        have hpos := hall N (Nat.lt_succ_self N)
        unfold finiteDerivativeReporterConditionalInformation
          finiteDerivativeReporterInnovation at hpos
        exact norm_ne_zero_iff.mp (sq_pos_iff.mp hpos)

/-- Every finite-dimensional reporter has a derivative order at which its conditional
information vanishes. -/
theorem exists_finiteDerivativeReporterConditionalInformation_eq_zero
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    [FiniteDimensional ℂ Y]
    (f : ℂ → ℂ) (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    ∃ k : ℕ, k ≤ finrank ℂ Y ∧
      finiteDerivativeReporterConditionalInformation k f report = 0 := by
  by_contra hnone
  push Not at hnone
  let w : ℕ → Y := fun k => report (iteratedDeriv k f)
  have hinnovation : ∀ i : Fin (finrank ℂ Y + 1),
      gramSchmidt ℂ w (i : ℕ) ≠ 0 := by
    intro i hzero
    have hinfo : finiteDerivativeReporterConditionalInformation (i : ℕ) f report = 0 := by
      simp [finiteDerivativeReporterConditionalInformation,
        finiteDerivativeReporterInnovation, w, hzero]
    exact (hnone (i : ℕ) (Nat.lt_succ_iff.mp i.2)) hinfo
  have hli : LinearIndependent ℂ
      (fun i : Fin (finrank ℂ Y + 1) => gramSchmidt ℂ w (i : ℕ)) :=
    linearIndependent_of_ne_zero_of_inner_eq_zero hinnovation fun i j hij =>
      gramSchmidt_orthogonal ℂ w (fun hval => hij (Fin.ext hval))
  have hbound := hli.fintype_card_le_finrank
  simp only [Fintype.card_fin] at hbound
  omega

/-- **Finite-reporter conditional-information collapse.**  A finite reporter necessarily makes
some derivative reading observationally dependent on earlier readings.  For a genuine infinite
derivative clock, that derivative remains independent before reporting, so the collapse belongs
to the observation structure rather than to the source. -/
theorem exists_finiteDerivativeReporterConditionalInformation_collapse
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    [FiniteDimensional ℂ Y]
    {f : ℂ → ℂ} (hf : ConstantCoefficientDifferentiallyTranscendental f)
    (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    ∃ k : ℕ, k ≤ finrank ℂ Y ∧
      finiteDerivativeReporterConditionalInformation k f report = 0 ∧
      report (iteratedDeriv k f) ∈ finiteDerivativeReporterPreviousSpace k f report ∧
      iteratedDeriv k f ∉ Submodule.span ℂ
        (Set.range fun i : Fin k => iteratedDeriv (i : ℕ) f) := by
  obtain ⟨k, hk, hinfo⟩ :=
    exists_finiteDerivativeReporterConditionalInformation_eq_zero f report
  have hreported :=
    (finiteDerivativeReporterConditionalInformation_eq_zero_iff k f report).mp hinfo
  have hjets : LinearIndependent ℂ (fun n : ℕ => iteratedDeriv n f) :=
    (constantCoefficientDifferentiallyTranscendental_iff_linearIndependent_iteratedDeriv f).mp hf
  have hsourceImage : (fun n : ℕ => iteratedDeriv n f) '' Set.Iio k =
      Set.range (fun i : Fin k => iteratedDeriv (i : ℕ) f) := by
    ext y
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, i.2, rfl⟩
  have hsource := hjets.notMem_span_image (show k ∉ Set.Iio k by simp)
  rw [hsourceImage] at hsource
  exact ⟨k, hk, hinfo, hreported, hsource⟩

/-- **Normalized finite-reporter collapse packet.**  A finite-dimensional reporter of a genuine
infinite derivative clock has a first-resolution relation that can be normalized on the newly
redundant derivative.  Its synthesized source packet is nonzero, while the reporter annihilates it
exactly. -/
theorem exists_finiteDerivativeReporterConditionalInformation_normalizedBlindPacket_collapse
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    [FiniteDimensional ℂ Y]
    {f : ℂ → ℂ} (hf : ConstantCoefficientDifferentiallyTranscendental f)
    (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    ∃ (k : ℕ) (c : Fin (k + 1) → ℂ),
      k ≤ finrank ℂ Y ∧
      finiteDerivativeReporterConditionalInformation k f report = 0 ∧
      c (Fin.last k) = -1 ∧
      c ∈ LinearMap.ker (finiteDerivativeReporterMap (k + 1) f report) ∧
      finiteDerivativeReporterPacket c f ≠ 0 ∧
      report (finiteDerivativeReporterPacket c f) = 0 ∧
      iteratedDeriv k f ∉ Submodule.span ℂ
        (Set.range fun i : Fin k => iteratedDeriv (i : ℕ) f) := by
  obtain ⟨k, hk, hzero, _, hsource⟩ :=
    exists_finiteDerivativeReporterConditionalInformation_collapse hf report
  obtain ⟨c, hclast, hc⟩ :=
    (finiteDerivativeReporterConditionalInformation_eq_zero_iff_exists_normalizedBlindPacket
      k f report).mp hzero
  have hcne : c ≠ 0 := by
    intro hczero
    have h := congrFun hczero (Fin.last k)
    rw [hclast] at h
    simp at h
  obtain ⟨hpacket, hreport⟩ :=
    finiteDerivativeReporterMap_nonzero_packet_of_mem_ker hf report hc hcne
  exact ⟨k, c, hk, hzero, hclast, hc, hpacket, hreport, hsource⟩

end

end HTGeometry
