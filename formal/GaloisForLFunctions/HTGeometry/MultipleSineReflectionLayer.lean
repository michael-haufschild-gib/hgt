import GaloisForLFunctions.HTGeometry.StanleyReisnerFacetIdeal

/-!
# Reflection removes exactly one face layer

The structural translation annihilator of the Barnes multiple-gamma logarithmic derivative on `N`
rationally independent periods is the principal squarefree ideal `(x_1 ⋯ x_N)`; the annihilator of
the reflected object — the multiple sine — is the squarefree degree-`N-1` ideal `I_{N-1}`.  Both
are squarefree Veronese ideals of the same variable set, at consecutive widths.

This file proves the algebra behind that comparison, unconditionally.

* The squarefree Veronese filtration is *antitone* in the width, and *strictly* decreasing on
  `0 ≤ r ≤ N`: a squarefree product of exactly `r` variables lies in `I_r` and not in `I_{r+1}`.
* At the top width the ideal is principal: `I_N = (x_1 ⋯ x_N)`, the Barnes ideal.
* At width one the ideal is the augmentation ideal, so the quotient is the coefficient ring — the
  rank-one collapse of the `N = 2` double sine.
* The face complex of `I_{k+1}` is the `k`-skeleton: `stanleyReisnerIdeal` of the family of all
  `k`-element facets is exactly `I_{k+1}`, and a set is a face exactly when it has at most `k`
  elements.  With `k = N-2` this is the face complex `Δ = {J : |J| ≤ N-2}` of the multiple sine,
  whose minimal nonfaces are the `(N-1)`-element sets.
* Therefore the reflection map is the canonical surjection `R/I_N ↠ R/I_{N-1}` of one filtration
  step, its kernel is `I_{N-1}/I_N`, generated by the classes of the squarefree degree-`N-1`
  monomials — the maximal proper faces — and that kernel is nonzero whenever `N ≥ 1`.

Reflection therefore does not merely impose a parity grading and does not collapse every order to
one class: at every `N` it removes precisely one complete face layer.
-/

namespace GaloisForLFunctions.HTGeometry

open Finset MvPolynomial GaloisForLFunctions.VeroneseIdeal

variable {R σ : Type*} [CommRing R] [DecidableEq σ]

/-! ### The squarefree Veronese filtration -/

/-- Monomial width is antitone in the required width. -/
theorem monoWide_mono {r s : ℕ} (hrs : r ≤ s) {P : MvPolynomial σ R}
    (hP : MonoWide s P) : MonoWide r P :=
  fun d hd => le_trans hrs (hP d hd)

/-- **The squarefree Veronese filtration is antitone.** -/
theorem veroneseIdeal_antitone {r s : ℕ} (hrs : r ≤ s) :
    veroneseIdeal R σ s ≤ veroneseIdeal R σ r := by
  intro P hP
  exact (mem_veroneseIdeal_iff P).2
    (monoWide_mono hrs ((mem_veroneseIdeal_iff P).1 hP))

/-- A squarefree product of fewer than `r` variables is outside `I_r`. -/
theorem prod_X_notMem_veroneseIdeal_of_card_lt [Nontrivial R] {r : ℕ} {J : Finset σ}
    (hJ : J.card < r) :
    (∏ j ∈ J, (X j : MvPolynomial σ R)) ∉ veroneseIdeal R σ r := by
  intro hmem
  have hwide := (mem_veroneseIdeal_iff (R := R) (r := r) _).1 hmem
  have hcoeff :
      coeff (∑ j ∈ J, Finsupp.single j 1)
        (∏ j ∈ J, (X j : MvPolynomial σ R)) ≠ 0 := by
    rw [prod_X_eq_monomial, coeff_monomial]
    simp
  have hwidth := hwide (∑ j ∈ J, Finsupp.single j 1) hcoeff
  rw [support_sum_single] at hwidth
  omega

/-- A squarefree product of exactly `r` variables is a generator of `I_r`. -/
theorem prod_X_mem_veroneseIdeal {r : ℕ} {J : Finset σ} (hJ : J.card = r) :
    (∏ j ∈ J, (X j : MvPolynomial σ R)) ∈ veroneseIdeal R σ r :=
  Ideal.subset_span ⟨J, hJ, rfl⟩

/-- **The filtration is strictly decreasing up to the number of variables.**  Each width removes a
complete layer: the squarefree products of `r` variables survive in `I_r` and die in `I_{r+1}`. -/
theorem veroneseIdeal_succ_lt [Nontrivial R] [Fintype σ] {r : ℕ}
    (hr : r ≤ Fintype.card σ) :
    veroneseIdeal R σ (r + 1) < veroneseIdeal R σ r := by
  refine lt_of_le_of_ne (veroneseIdeal_antitone (Nat.le_succ r)) ?_
  intro heq
  obtain ⟨J, -, hJ⟩ :=
    Finset.exists_subset_card_eq (s := (Finset.univ : Finset σ)) (by simpa using hr)
  exact prod_X_notMem_veroneseIdeal_of_card_lt (R := R) (by omega)
    (heq ▸ prod_X_mem_veroneseIdeal (R := R) hJ)

/-! ### The two ends of the filtration -/

/-- **Barnes ideal.**  At the top width the squarefree Veronese ideal is principal, generated by the
product of all the variables. -/
theorem veroneseIdeal_card_eq_span_prod [Fintype σ] :
    veroneseIdeal R σ (Fintype.card σ) =
      Ideal.span ({∏ j : σ, X j} : Set (MvPolynomial σ R)) := by
  unfold veroneseIdeal
  congr 1
  ext P
  constructor
  · rintro ⟨J, hJ, rfl⟩
    have : J = (Finset.univ : Finset σ) :=
      Finset.eq_univ_of_card J (by simpa using hJ)
    subst this
    exact Set.mem_singleton _
  · intro hP
    rw [Set.mem_singleton_iff] at hP
    exact ⟨Finset.univ, by simp, by rw [hP]⟩

/-- **Rank-one collapse.**  At width one the squarefree Veronese ideal is the augmentation ideal, so
its quotient is the coefficient ring: this is the `N = 2` double-sine collapse. -/
theorem veroneseIdeal_one_eq_ker_constantCoeff :
    veroneseIdeal R σ 1 = RingHom.ker (MvPolynomial.constantCoeff (σ := σ) (R := R)) := by
  ext P
  rw [mem_veroneseIdeal_iff, RingHom.mem_ker, constantCoeff_eq]
  constructor
  · intro hP
    by_contra hc
    have := hP 0 hc
    simp at this
  · intro hP d hd
    rcases Nat.eq_zero_or_pos d.support.card with hcard | hcard
    · exfalso
      have hd0 : d = 0 := by
        ext i
        have : d.support = ∅ := Finset.card_eq_zero.1 hcard
        by_contra hne
        exact absurd (this ▸ Finsupp.mem_support_iff.2 hne) (by simp)
      exact hd (hd0 ▸ hP)
    · exact hcard

/-! ### The face complex of `I_{k+1}` is the `k`-skeleton -/

variable (σ) in
/-- All `k`-element facets: the facet family of the `(k-1)`-skeleton of the full simplex. -/
noncomputable def skeletonFacets [Fintype σ] (k : ℕ) : Finset (Finset σ) :=
  (Finset.univ : Finset σ).powersetCard k

/-- **Faces of the skeleton.**  A vertex set is a face of the `k`-element facet family exactly when
it has at most `k` elements. -/
theorem isFaceOf_skeletonFacets_iff [Fintype σ] {k : ℕ} (hk : k ≤ Fintype.card σ)
    (J : Finset σ) :
    IsFaceOf (↑(skeletonFacets σ k) : Set (Finset σ)) J ↔ J.card ≤ k := by
  constructor
  · rintro ⟨F, hF, hJF⟩
    have hFcard : F.card = k := by
      simpa [skeletonFacets, Finset.mem_powersetCard] using hF
    exact hFcard ▸ Finset.card_le_card hJF
  · intro hJ
    obtain ⟨F, hJF, hFcard⟩ :=
      Finset.exists_subsuperset_card_eq (Finset.subset_univ J) hJ (by simpa using hk)
    exact ⟨F, by simpa [skeletonFacets, Finset.mem_powersetCard] using hFcard, hJF⟩

/-- **The multiple-sine face ideal.**  The Stanley--Reisner ideal of the `k`-element facet family is
exactly the squarefree Veronese ideal of width `k+1`; its minimal nonfaces are the `(k+1)`-element
sets.  With `k = N-2` this is the annihilator `I_{N-1}` of the multiple sine. -/
theorem stanleyReisnerIdeal_skeletonFacets [Fintype σ] {k : ℕ} (hk : k ≤ Fintype.card σ) :
    stanleyReisnerIdeal R (skeletonFacets σ k) = veroneseIdeal R σ (k + 1) := by
  ext P
  rw [mem_stanleyReisnerIdeal_iff, mem_veroneseIdeal_iff]
  constructor
  · intro hP d hd
    have := hP d (mem_support_iff.2 hd)
    rw [isFaceOf_skeletonFacets_iff hk] at this
    omega
  · intro hP d hd
    rw [isFaceOf_skeletonFacets_iff hk]
    have := hP d (mem_support_iff.1 hd)
    omega

/-! ### The reflection quotient -/

variable (R σ) in
/-- Structural annihilator of the Barnes multiple gamma on `N` periods: `(x_1 ⋯ x_N)`. -/
noncomputable def barnesIdeal [Fintype σ] : Ideal (MvPolynomial σ R) :=
  veroneseIdeal R σ (Fintype.card σ)

variable (R σ) in
/-- Structural annihilator of the multiple sine on `N` periods: `I_{N-1}`. -/
noncomputable def multipleSineIdeal [Fintype σ] : Ideal (MvPolynomial σ R) :=
  veroneseIdeal R σ (Fintype.card σ - 1)

theorem barnesIdeal_eq_span_prod [Fintype σ] :
    barnesIdeal R σ = Ideal.span ({∏ j : σ, X j} : Set (MvPolynomial σ R)) :=
  veroneseIdeal_card_eq_span_prod

theorem multipleSineIdeal_eq_stanleyReisner [Fintype σ] (hN : 1 ≤ Fintype.card σ) :
    multipleSineIdeal R σ =
      stanleyReisnerIdeal R (skeletonFacets σ (Fintype.card σ - 2)) := by
  rw [stanleyReisnerIdeal_skeletonFacets (by omega)]
  unfold multipleSineIdeal
  congr 1
  omega

theorem barnesIdeal_le_multipleSineIdeal [Fintype σ] :
    barnesIdeal R σ ≤ multipleSineIdeal R σ :=
  veroneseIdeal_antitone (Nat.sub_le _ _)

/-- **Reflection is a one-step quotient.**  The induced structural map is the canonical surjection
`R/(x_1 ⋯ x_N) ↠ R/I_{N-1}`. -/
noncomputable def reflectionQuotientMap [Fintype σ] :
    (MvPolynomial σ R ⧸ barnesIdeal R σ) →+* (MvPolynomial σ R ⧸ multipleSineIdeal R σ) :=
  Ideal.Quotient.factor barnesIdeal_le_multipleSineIdeal

theorem reflectionQuotientMap_surjective [Fintype σ] :
    Function.Surjective (reflectionQuotientMap (R := R) (σ := σ)) := by
  intro x
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact ⟨Ideal.Quotient.mk _ P, rfl⟩

/-- **The removed layer.**  The kernel of the reflection map is `I_{N-1}/(x_1 ⋯ x_N)`. -/
theorem ker_reflectionQuotientMap [Fintype σ] :
    RingHom.ker (reflectionQuotientMap (R := R) (σ := σ)) =
      (multipleSineIdeal R σ).map (Ideal.Quotient.mk (barnesIdeal R σ)) :=
  Ideal.Quotient.factor_ker barnesIdeal_le_multipleSineIdeal

/-- The removed layer is generated by the classes of the squarefree degree-`N-1` monomials: the
maximal proper faces. -/
theorem ker_reflectionQuotientMap_eq_span_maximalFaces [Fintype σ] :
    RingHom.ker (reflectionQuotientMap (R := R) (σ := σ)) =
      Ideal.span ((Ideal.Quotient.mk (barnesIdeal R σ)) ''
        veroneseGens R σ (Fintype.card σ - 1)) := by
  rw [ker_reflectionQuotientMap]
  exact Ideal.map_span _ _

/-- **Reflection removes exactly one face layer.**  The kernel is nonzero: the maximal proper faces
survive in the multiple-sine ideal and die in the Barnes ideal. -/
theorem reflection_removes_a_layer [Nontrivial R] [Fintype σ] (hN : 1 ≤ Fintype.card σ) :
    barnesIdeal R σ < multipleSineIdeal R σ := by
  have hcard : Fintype.card σ - 1 + 1 = Fintype.card σ := by omega
  have h := veroneseIdeal_succ_lt (R := R) (σ := σ)
    (r := Fintype.card σ - 1) (by omega)
  unfold barnesIdeal multipleSineIdeal
  rwa [hcard] at h

/-- **The reflection layer is exactly one step.**  The Barnes and multiple-sine ideals are the two
consecutive members of the strictly decreasing squarefree Veronese filtration at widths `N` and
`N-1`, so the surjection `R/I_N ↠ R/I_{N-1}` removes one complete face layer and no more. -/
theorem reflection_layer_law [Nontrivial R] [Fintype σ] (hN : 1 ≤ Fintype.card σ) :
    barnesIdeal R σ = veroneseIdeal R σ (Fintype.card σ) ∧
      multipleSineIdeal R σ = veroneseIdeal R σ (Fintype.card σ - 1) ∧
      barnesIdeal R σ < multipleSineIdeal R σ ∧
      Function.Surjective (reflectionQuotientMap (R := R) (σ := σ)) ∧
      RingHom.ker (reflectionQuotientMap (R := R) (σ := σ)) =
        Ideal.span ((Ideal.Quotient.mk (barnesIdeal R σ)) ''
          veroneseGens R σ (Fintype.card σ - 1)) ∧
      (∀ r : ℕ, r ≤ Fintype.card σ →
        veroneseIdeal R σ (r + 1) < veroneseIdeal R σ r) :=
  ⟨rfl, rfl, reflection_removes_a_layer hN, reflectionQuotientMap_surjective,
    ker_reflectionQuotientMap_eq_span_maximalFaces,
    fun _ hr => veroneseIdeal_succ_lt hr⟩

end GaloisForLFunctions.HTGeometry
