import GaloisForLFunctions.HTGeometry.AbelianVarietyMultiplicationGaloisLevel
import GaloisForLFunctions.HTGeometry.AbelianManinHorizonTheorem

/-!
# The multiplication tail of an Abelian variety is its Manin quotient

Specialisation of the Manin-horizon theorem to the actual function field of an Abelian variety and
its multiplication pullback.  Each level of the tower is the fixed field of the rational primary
torsion translations, the union of those deck groups has the Manin kernel as its Kolchin closure
because the primary torsion is already Zariski dense, and the Manin kernel invariants are the
differential rational functions of the Manin map.
-/

open CategoryTheory Limits
open MonoidalCategory CartesianMonoidalCategory MonObj
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions AlgebraicGeometry

noncomputable section

universe u

/-- **The Manin-horizon theorem for an Abelian variety.**  The stable tail of the tower of
multiplication pullbacks on the function field of an Abelian variety is the fixed field of the
Manin kernel, and is generated by the Manin coordinates.

The classical inputs are exactly those the paper proof names: the finite etale degree data of the
multiplication covers, a point-labelled differential translation action with Kolchin-closed
element stabilisers whose torsion and Manin labels realise the corresponding deck groups, the
three defining properties of the Manin kernel, Zariski density of the primary torsion, invariance
of the Manin coordinates, and the differential rational quotient theorem. -/
theorem abelianVarietyMultiplicationTail_eq_maninCoordinates
    {K : Type u} [Field K] [Differential K]
    (A : Over (Spec (.of K))) [GrpObj A] [IsAbelianVariety A]
    [Differential A.left.functionField]
    (hdalg : letI := abelianVarietyFunctionFieldAlgebra A
      DifferentialAlgebra K A.left.functionField)
    (m : ℤ) [IsDominant (abelianVarietyMultiplication A m).left]
    (hfinite : ∀ n, letI := abelianVarietyFunctionFieldAlgebra A
      Finite (abelianVarietyTorsionDeckGroup A (m ^ n)))
    (hfiniteDimensional : ∀ n, letI := abelianVarietyFunctionFieldAlgebra A
      FiniteDimensional
        (IntermediateField.map
          ((abelianVarietyMultiplicationFunctionFieldPullback A m) ^ n) ⊤)
        A.left.functionField)
    (hdegree : ∀ n, letI := abelianVarietyFunctionFieldAlgebra A
      Module.finrank
          (IntermediateField.map
            ((abelianVarietyMultiplicationFunctionFieldPullback A m) ^ n) ⊤)
          A.left.functionField =
        Nat.card (abelianVarietyTorsionDeckGroup A (m ^ n)))
    {α β : Type*}
    (translation : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      (α → K) → DifferentialAlgEquiv K A.left.functionField)
    (torsionPoints : ℕ → Set (α → K)) (maninPoints : Set (α → K))
    (maninDeck : letI := abelianVarietyFunctionFieldAlgebra A
      Subgroup (A.left.functionField ≃ₐ[K] A.left.functionField))
    (htorsionImage : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      (fun a => (translation a).toAlgEquiv) '' (⋃ n, torsionPoints n)
        = ((⨆ n, abelianVarietyTorsionDeckGroup A (m ^ n) :
            Subgroup (A.left.functionField ≃ₐ[K] A.left.functionField)) :
          Set (A.left.functionField ≃ₐ[K] A.left.functionField)))
    (hmaninImage : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      (fun a => (translation a).toAlgEquiv) '' maninPoints
        = (maninDeck : Set (A.left.functionField ≃ₐ[K] A.left.functionField)))
    (hstab : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      ∀ z : A.left.functionField,
        IsKolchinClosedOver K {a : α → K | (translation a).toAlgEquiv z = z})
    (hmaninClosed : IsKolchinClosedOver K maninPoints)
    (htorsionSubset : ∀ n, torsionPoints n ⊆ maninPoints)
    (hmaninMinimal : ∀ H : Set (α → K), IsKolchinClosedOver K H → ZariskiDenseOver K H →
      maninPoints ⊆ H)
    (hdense : ZariskiDenseOver K (⋃ n, torsionPoints n))
    (mu : β → A.left.functionField)
    (hinv : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      ∀ a ∈ maninPoints, ∀ j, (translation a).toAlgEquiv (mu j) = mu j)
    (hquot : letI := abelianVarietyFunctionFieldAlgebra A
      letI := hdalg
      ∀ z : A.left.functionField,
        (∀ a ∈ maninPoints, (translation a).toAlgEquiv z = z) →
          z ∈ differentialAdjoin K (Set.range mu)) :
    letI := abelianVarietyFunctionFieldAlgebra A
    letI := hdalg
    stableRangeCore (abelianVarietyMultiplicationFunctionFieldPullback A m) =
        IntermediateField.fixedField maninDeck ∧
      stableRangeCore (abelianVarietyMultiplicationFunctionFieldPullback A m) =
        differentialAdjoin K (Set.range mu) := by
  letI := abelianVarietyFunctionFieldAlgebra A
  letI := hdalg
  exact stableRangeCore_eq_maninDeckFixedField_eq_maninCoordinates
    (abelianVarietyMultiplicationFunctionFieldPullback A m)
    (fun n => abelianVarietyTorsionDeckGroup A (m ^ n))
    (map_abelianVarietyMultiplicationFunctionFieldPullback_pow_top_eq_fixedField A m
      hfinite hfiniteDimensional hdegree)
    translation torsionPoints maninPoints maninDeck htorsionImage hmaninImage hstab
    hmaninClosed htorsionSubset hmaninMinimal hdense mu hinv hquot

end

end GaloisForLFunctions.HTGeometry
