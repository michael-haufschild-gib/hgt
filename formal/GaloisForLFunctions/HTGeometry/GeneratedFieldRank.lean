import GaloisForLFunctions.HTGeometry.ScalarDifferentialOrderUpperBound

/-!
# The transcendence degree of a generated subfield

A subfield generated by a set `s` is the fraction field of the subalgebra generated by `s`, hence
algebraic over it, so its transcendence degree is at most the number of generators.  Adjoining
elements algebraic over such a subfield changes nothing, so more than `#s` elements algebraic over
`K(s)` are always algebraically dependent over `K`.

This is the rank input of every uniform-annihilation argument: a family of tuples whose entries all
lie in a field generated by few enough elements cannot be algebraically independent.
-/

namespace GaloisForLFunctions.HTGeometry

open Algebra Cardinal

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The generators of a subfield, read inside that subfield. -/
def adjoinGenerators (s : Set L) : Set ↥(IntermediateField.adjoin K s) :=
  {y | (y : L) ∈ s}

theorem image_adjoinGenerators (s : Set L) :
    ((IntermediateField.adjoin K s).val '' (adjoinGenerators (K := K) s)) = s := by
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    exact hz
  · intro hy
    exact ⟨⟨y, IntermediateField.subset_adjoin K s hy⟩, hy, rfl⟩

theorem mk_adjoinGenerators (s : Set L) :
    #(adjoinGenerators (K := K) s) = #s := by
  have h : Function.Injective (IntermediateField.adjoin K s).val := Subtype.val_injective
  have := Cardinal.mk_image_eq (f := (IntermediateField.adjoin K s).val)
    (s := adjoinGenerators (K := K) s) h
  rw [image_adjoinGenerators] at this
  exact this.symm

/-- **A generated subfield is algebraic over the generated subalgebra.** -/
instance isAlgebraic_adjoinGenerators (s : Set L) :
    Algebra.IsAlgebraic ↥(Algebra.adjoin K (adjoinGenerators (K := K) s))
      ↥(IntermediateField.adjoin K s) := by
  constructor
  intro y
  have hmap : Subalgebra.map (IntermediateField.adjoin K s).val
      (Algebra.adjoin K (adjoinGenerators (K := K) s)) = Algebra.adjoin K s := by
    rw [AlgHom.map_adjoin, image_adjoinGenerators]
  obtain ⟨r, hr, t, ht, hy⟩ := IntermediateField.mem_adjoin_iff_div.mp y.2
  obtain ⟨r', hr', hrr'⟩ : ∃ r' : ↥(IntermediateField.adjoin K s),
      r' ∈ Algebra.adjoin K (adjoinGenerators (K := K) s) ∧ (r' : L) = r := by
    have hmem : r ∈ Subalgebra.map (IntermediateField.adjoin K s).val
        (Algebra.adjoin K (adjoinGenerators (K := K) s)) := by rw [hmap]; exact hr
    obtain ⟨r', hr', hrr'⟩ := hmem
    exact ⟨r', hr', hrr'⟩
  obtain ⟨t', ht', htt'⟩ : ∃ t' : ↥(IntermediateField.adjoin K s),
      t' ∈ Algebra.adjoin K (adjoinGenerators (K := K) s) ∧ (t' : L) = t := by
    have hmem : t ∈ Subalgebra.map (IntermediateField.adjoin K s).val
        (Algebra.adjoin K (adjoinGenerators (K := K) s)) := by rw [hmap]; exact ht
    obtain ⟨t', ht', htt'⟩ := hmem
    exact ⟨t', ht', htt'⟩
  by_cases ht0 : (t : L) = 0
  · have hy0 : y = 0 := by
      apply Subtype.ext
      rw [hy, ht0, div_zero]
      rfl
    rw [hy0]
    exact isAlgebraic_zero
  · have hyt : y * t' = r' := by
      apply Subtype.ext
      have hcast : ((y * t' : ↥(IntermediateField.adjoin K s)) : L) = (y : L) * (t' : L) := rfl
      rw [hcast, htt', hrr', hy]
      field_simp
    refine ⟨Polynomial.C ⟨t', ht'⟩ * Polynomial.X - Polynomial.C ⟨r', hr'⟩, ?_, ?_⟩
    · intro h0
      have hc := congrArg (fun p => Polynomial.coeff p 1) h0
      simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
        Polynomial.coeff_C, mul_one] at hc
      have ht'0 : t' = 0 := by simpa using congrArg (Subtype.val) hc
      refine ht0 ?_
      rw [← htt', ht'0]
      rfl
    · simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
      show (t' : ↥(IntermediateField.adjoin K s)) * y - (r' : ↥(IntermediateField.adjoin K s)) = 0
      rw [mul_comm, hyt, sub_self]

/-- **The generator bound.**  A subfield generated by `s` has transcendence degree at most `#s`. -/
theorem trdeg_intermediateFieldAdjoin_le (s : Set L) :
    Algebra.trdeg K ↥(IntermediateField.adjoin K s) ≤ #s := by
  have h := Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := K) (adjoinGenerators (K := K) s)
  rwa [mk_adjoinGenerators] at h

/-! ## Elements algebraic over a small subfield -/

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 800000 in
/-- **Algebraic over a small subfield forces dependence.**  More than `trdeg K F` elements, each
algebraic over `F`, are algebraically dependent over `K`. -/
theorem not_algebraicIndependent_of_isAlgebraic_over_intermediateField {d : ℕ}
    (F : IntermediateField K L) (hF : Algebra.trdeg K ↥F ≤ (d : Cardinal))
    (x : Fin (d + 1) → L) (hx : ∀ i, IsAlgebraic ↥F (x i)) :
    ¬ AlgebraicIndependent K x := by
  classical
  set M : IntermediateField ↥F L := IntermediateField.adjoin ↥F (Set.range x) with hM
  haveI hfaith : FaithfulSMul ↥F ↥M :=
    (faithfulSMul_iff_algebraMap_injective ↥F ↥M).mpr (algebraMap ↥F ↥M).injective
  haveI halg : Algebra.IsAlgebraic ↥F ↥M := by
    refine IntermediateField.isAlgebraic_adjoin ?_
    rintro y ⟨i, rfl⟩
    exact (hx i).isIntegral
  have htower : Algebra.trdeg K ↥F + Algebra.trdeg ↥F ↥M = Algebra.trdeg K ↥M :=
    trdeg_add_eq K ↥F
  have hzero : Algebra.trdeg ↥F ↥M = 0 := trdeg_eq_zero
  have hMtr : Algebra.trdeg K ↥M ≤ (d : Cardinal) := by
    rw [← htower, hzero, add_zero]
    exact hF
  intro hind
  have hxmem : ∀ i, x i ∈ M := fun i => IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
  set x' : Fin (d + 1) → ↥M := fun i => ⟨x i, hxmem i⟩ with hx'
  have hcomp : (AlgHom.restrictScalars K M.val) ∘ x' = x := rfl
  have hind' : AlgebraicIndependent K x' :=
    AlgebraicIndependent.of_comp (AlgHom.restrictScalars K M.val) (by rw [hcomp]; exact hind)
  exact GaloisForLFunctions.not_algebraicIndependent_of_trdeg_le hMtr x' hind'

/-- **The generated form.**  More than `#s` elements algebraic over the subfield generated by `s`
are algebraically dependent over `K`. -/
theorem not_algebraicIndependent_of_isAlgebraic_over_adjoin {d : ℕ} (s : Set L)
    (hs : #s ≤ (d : Cardinal)) (x : Fin (d + 1) → L)
    (hx : ∀ i, IsAlgebraic ↥(IntermediateField.adjoin K s) (x i)) :
    ¬ AlgebraicIndependent K x :=
  not_algebraicIndependent_of_isAlgebraic_over_intermediateField _
    ((trdeg_intermediateFieldAdjoin_le s).trans hs) x hx

/-- **Polynomials preserve algebraicity.**  A polynomial expression, with coefficients in the base,
in elements algebraic over an intermediate field is again algebraic over that field. -/
theorem isAlgebraic_aeval {σ : Type*} (G : IntermediateField K L) (v : σ → L)
    (hv : ∀ w, IsAlgebraic ↥G (v w)) (P : MvPolynomial σ K) :
    IsAlgebraic ↥G (MvPolynomial.aeval v P) := by
  induction P using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.aeval_C]
      have hmap : (algebraMap K L) a = (algebraMap ↥G L) (algebraMap K ↥G a) :=
        (IsScalarTower.algebraMap_apply K ↥G L a)
      rw [hmap]
      exact isAlgebraic_algebraMap _
  | add p q hp hq =>
      rw [map_add]
      exact hp.add hq
  | mul_X p w hp =>
      rw [map_mul, MvPolynomial.aeval_X]
      exact hp.mul (hv w)

end GaloisForLFunctions.HTGeometry
