import GaloisForLFunctions.HTGeometry.TorusReturnExponentLaw
import GaloisForLFunctions.HTGeometry.WeightedPhaseCurveDimension
import GaloisForLFunctions.HTGeometry.UniversalProjectiveRecurrenceCapstoneLaw

/-!
# Universal recurrence occupation--constraint conservation

For every finite real spectrum, quotient away global phase and sample time
uniformly over growing centered windows.  The limiting projective phase law
is Haar measure on the completed orbit.  The logarithmic small-tolerance
exponent of return occupation is exactly the dimension of that orbit.

Projective rank--nullity then gives one premise-complete conservation law:

`return-occupation exponent + exact balanced-relation rank
  = number of levels - 1`.

No rational independence, simple spectrum, genericity, randomness, chaos,
or nondegeneracy premise is assumed.  A stationary projective orbit is
included: its return fraction is one and its exponent is zero.
-/

open Filter MeasureTheory Metric Set Topology

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- Return target obtained by reading an intrinsic phase torus through a
bi-Lipschitz physical phase map. -/
def biLipschitzReturnTarget
    {k Y : Type*} [Fintype k] [PseudoMetricSpace Y]
    (f : UnitAddTorus k → Y) (x : UnitAddTorus k) (ε : ℝ) :
    Set (UnitAddTorus k) :=
  {y | dist (f y) (f x) < ε}

/-- Haar return occupation through any bi-Lipschitz phase reading has
logarithmic exponent equal to intrinsic torus dimension. -/
theorem tendsto_log_haar_biLipschitzReturn_div_log
    {k Y : Type*} [Fintype k] [PseudoMetricSpace Y]
    (f : UnitAddTorus k → Y) (x : UnitAddTorus k)
    (hf : IsBiLipschitz f) :
    Tendsto (fun ε => Real.log
        ((finiteTorusHaarProbabilityMeasure k : Measure (UnitAddTorus k))
          (biLipschitzReturnTarget f x ε)).toReal /
      Real.log ε) (nhdsWithin 0 (Ioi 0))
        (nhds (Fintype.card k : ℝ)) := by
  obtain ⟨L, K, hL, hK, hlip, hanti⟩ := hf
  let a : ℝ := 1 / (L : ℝ)
  let b : ℝ := (K : ℝ) + 1 / (L : ℝ)
  have ha : 0 < a := by
    dsimp [a]
    positivity
  have hab : a ≤ b := by
    dsimp [a, b]
    linarith [NNReal.coe_nonneg K]
  apply tendsto_log_finiteTorusHaar_return_div_log x
    (biLipschitzReturnTarget f x) ha hab
  · intro ε hε y hy
    rw [Metric.mem_ball] at hy
    rw [biLipschitzReturnTarget, Set.mem_setOf_eq]
    have hdist := hlip.dist_le_mul y x
    have hLa : (L : ℝ) * a = 1 := by
      dsimp [a]
      field_simp
    calc
      dist (f y) (f x) ≤ (L : ℝ) * dist y x := hdist
      _ < (L : ℝ) * (a * ε) :=
        mul_lt_mul_of_pos_left hy hL
      _ = ε := by rw [← mul_assoc, hLa, one_mul]
  · intro ε hε y hy
    rw [biLipschitzReturnTarget, Set.mem_setOf_eq] at hy
    rw [Metric.mem_ball]
    have hdist := hanti.le_mul_dist y x
    have hbound : dist y x < (K : ℝ) * ε :=
      hdist.trans_lt (mul_lt_mul_of_pos_left hy hK)
    have hkb : (K : ℝ) < b := by
      dsimp [b]
      linarith [ha]
    calc
      dist y x < (K : ℝ) * ε := hbound
      _ < b * ε := mul_lt_mul_of_pos_right hkb hε

/-- Haar fraction of completed phases lying within phase tolerance `ε`
of exact return, in an integer-torus presentation. -/
def completedPhaseReturnFraction
    {d k : Type*} [Fintype d] [Fintype k]
    (M : d → k → ℤ) (ε : ℝ) : ℝ :=
  ((orbitClosureHaar M : Measure (UnitAddTorus d))
    (Metric.ball 0 ε)).toReal

/-- Presented return occupation is exactly the Haar mass of the return
target pulled back to the intrinsic completed-time torus. -/
theorem completedPhaseReturnFraction_eq
    {d k : Type*} [Fintype d] [Fintype k]
    (M : d → k → ℤ) (ε : ℝ) :
    completedPhaseReturnFraction M ε =
      ((finiteTorusHaarProbabilityMeasure k : Measure (UnitAddTorus k))
        (biLipschitzReturnTarget (torusIntegerHom M) 0 ε)).toReal := by
  rw [completedPhaseReturnFraction, orbitClosureHaar,
    ProbabilityMeasure.toMeasure_map,
    Measure.map_apply (continuous_torusIntegerHom M).measurable
      measurableSet_ball]
  congr 2
  ext x
  simp [biLipschitzReturnTarget]

/-- The canonical completed-time law equals Haar measure on every integer
torus presentation generated by a rational basis of the same frequencies. -/
theorem spectralRelationPhaseEnsemble_eq_orbitClosureHaar
    {d k : Type*} [Fintype d] [Fintype k]
    (omega : d → ℝ) (gamma : k → ℝ) (M : d → k → ℤ)
    (hgamma : RationallyIndependentFrequency gamma)
    (hM : ∀ i, omega i = ∑ j, (M i j : ℝ) * gamma j) :
    spectralRelationPhaseEnsemble omega = orbitClosureHaar M := by
  exact tendsto_nhds_unique
    (finiteTorusPhaseProbabilityMeasure_tendsto_relationPhaseEnsemble omega)
    (finiteTorusPhaseProbabilityMeasure_tendsto_orbitClosureHaar
      omega gamma M hgamma hM)

/-- Canonical completed-time fraction of projective phases lying within
phase tolerance `ε` of exact return. -/
def projectiveCompletedReturnFraction
    {d : ℕ} (energy : Fin (d + 1) → ℝ) (ε : ℝ) : ℝ :=
  ((spectralRelationPhaseEnsemble (projectiveGapPacket energy) :
      Measure (UnitAddTorus (Fin d)))
    (Metric.ball 0 ε)).toReal

/-- The canonical return fraction agrees with every rational-basis torus
presentation of the projective gap packet. -/
theorem projectiveCompletedReturnFraction_eq
    {d k : ℕ} (energy : Fin (d + 1) → ℝ)
    (gamma : Fin k → ℝ) (M : Fin d → Fin k → ℤ)
    (hgamma : RationallyIndependentFrequency gamma)
    (hM : ∀ i, projectiveGapPacket energy i =
      ∑ j, (M i j : ℝ) * gamma j)
    (ε : ℝ) :
    projectiveCompletedReturnFraction energy ε =
      completedPhaseReturnFraction M ε := by
  rw [projectiveCompletedReturnFraction, completedPhaseReturnFraction,
    spectralRelationPhaseEnsemble_eq_orbitClosureHaar
      (projectiveGapPacket energy) gamma M hgamma hM]

/-- Return occupation in an injectively presented completed-time torus has
logarithmic exponent equal to the torus dimension. -/
theorem tendsto_log_completedPhaseReturnFraction_div_log
    {d k : Type*} [Fintype d] [Fintype k] [DecidableEq d]
    (M : d → k → ℤ)
    (hinj : Function.Injective (torusIntegerHom M)) :
    Tendsto (fun ε => Real.log (completedPhaseReturnFraction M ε) /
      Real.log ε) (nhdsWithin 0 (Ioi 0))
        (nhds (Fintype.card k : ℝ)) := by
  have h := tendsto_log_haar_biLipschitzReturn_div_log
    (torusIntegerHom M) 0
    (isBiLipschitz_torusIntegerHom M hinj)
  simpa only [completedPhaseReturnFraction_eq] using h

/-- **Universal projective recurrence occupation--constraint law.**  For
every finite spectrum, the logarithmic completed-time frequency of returns
within projective phase tolerance `ε` equals, in the small-target limit,
the projective phase capacity left after subtracting all independent exact
balanced spectral relations. -/
theorem projectiveRecurrenceOccupation_constraint_conservation
    {d : ℕ} (energy : Fin (d + 1) → ℝ) :
    Tendsto (fun ε =>
        Real.log (projectiveCompletedReturnFraction energy ε) /
          Real.log ε)
      (nhdsWithin 0 (Ioi 0))
      (nhds ((d - Module.finrank ℚ
        (projectiveSpectralRelationRationalSpace energy) : ℕ) : ℝ)) := by
  obtain ⟨k, gamma, M, A, hindep, _hspan, _hgammaSpan, hM, hA, hrank⟩ :=
    exists_frequency_integer_basis (projectiveGapPacket energy)
  have hinj : Function.Injective (torusIntegerHom M) :=
    torusIntegerHom_injective M A hA
  have hlimit :=
    tendsto_log_completedPhaseReturnFraction_div_log M hinj
  have hcanon : (fun ε =>
      Real.log (projectiveCompletedReturnFraction energy ε) /
        Real.log ε) =
      (fun ε => Real.log (completedPhaseReturnFraction M ε) /
        Real.log ε) := by
    funext ε
    rw [projectiveCompletedReturnFraction_eq energy gamma M hindep hM]
  rw [hcanon]
  have hk : k = projectiveTemporalRank energy := by
    simpa [projectiveTemporalRank, rationalCoordinateRank] using hrank
  have hconserve := projectiveTemporalRank_add_relationRank energy
  have htarget : d - Module.finrank ℚ
      (projectiveSpectralRelationRationalSpace energy) = k := by
    omega
  simpa [htarget] using hlimit

end

end GaloisForLFunctions.HTGeometry
