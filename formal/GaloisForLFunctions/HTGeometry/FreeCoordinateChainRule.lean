import GaloisForLFunctions.HTGeometry.FreeCoordinateConstantKernel

/-!
# The chain rule on a free rational coordinate field

Two derivations agreeing on a set of elements agree on the subfield it generates, because the locus
where they agree is itself an intermediate field.  Applied to a derivation of a free rational
coordinate field and the corresponding combination of coordinate derivations, this is the chain
rule: on the subfield generated by finitely many coordinates a derivation is the sum of its values
on those coordinates against the corresponding partial derivatives.

Every element lies in such a subfield, since a numerator and a denominator involve only finitely
many coordinates.  This is what lets an annihilation hypothesis be read off coordinate by
coordinate.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

open MvPolynomial

/-! ## The equalizer of two derivations -/

variable {L E : Type*} [Field L] [Field E] [Algebra L E]

/-- The locus where two derivations agree is an intermediate field. -/
def derivationEqualizer (D₁ D₂ : Derivation L E E) : IntermediateField L E where
  carrier := {f | D₁ f = D₂ f}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_add, map_add, hx, hy]
  mul_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [Derivation.leibniz, Derivation.leibniz, hx, hy]
  algebraMap_mem' := by
    intro c
    simp only [Set.mem_setOf_eq]
    rw [Derivation.map_algebraMap, Derivation.map_algebraMap]
  inv_mem' := by
    intro x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [Derivation.leibniz_inv, Derivation.leibniz_inv, hx]

@[simp]
theorem mem_derivationEqualizer_iff {D₁ D₂ : Derivation L E E} {f : E} :
    f ∈ derivationEqualizer D₁ D₂ ↔ D₁ f = D₂ f := Iff.rfl

/-- Two derivations agreeing on a set agree on the intermediate field it generates. -/
theorem adjoin_le_derivationEqualizer {D₁ D₂ : Derivation L E E} {S : Set E}
    (h : ∀ x ∈ S, D₁ x = D₂ x) :
    IntermediateField.adjoin L S ≤ derivationEqualizer D₁ D₂ := by
  rw [IntermediateField.adjoin_le_iff]
  exact fun x hx => h x hx

/-! ## The chain rule -/

variable {C σ : Type*} [Field C]

theorem derivation_sum_smul_apply (S : Finset σ)
    (g : σ → FreeCoordinateRationalField C σ) (x : FreeCoordinateRationalField C σ) :
    (∑ p ∈ S, g p • freeCoordinateDerivation C σ p) x =
      ∑ p ∈ S, g p * freeCoordinateDerivation C σ p x := by
  classical
  induction S using Finset.induction with
  | empty => simp
  | insert p s hp ih =>
      rw [Finset.sum_insert hp, Finset.sum_insert hp, Derivation.add_apply,
        Derivation.smul_apply, smul_eq_mul, ih]

/-- **The chain rule.**  On the subfield generated by finitely many free coordinates, a derivation
is the sum of its values on those coordinates against the corresponding partial derivatives. -/
theorem freeCoordinate_chainRule (S : Finset σ)
    (D : Derivation C (FreeCoordinateRationalField C σ) (FreeCoordinateRationalField C σ))
    {f : FreeCoordinateRationalField C σ}
    (hf : f ∈ freeCoordinateField C σ (↑S : Set σ)) :
    D f = ∑ p ∈ S, D (freeCoordinate C σ p) * freeCoordinateDerivation C σ p f := by
  classical
  set D' : Derivation C (FreeCoordinateRationalField C σ) (FreeCoordinateRationalField C σ) :=
    ∑ p ∈ S, D (freeCoordinate C σ p) • freeCoordinateDerivation C σ p with hD'def
  have hgen : ∀ x ∈ freeCoordinate C σ '' (↑S : Set σ), D x = D' x := by
    rintro _ ⟨q, hq, rfl⟩
    rw [hD'def, derivation_sum_smul_apply, Finset.sum_eq_single q]
    · rw [freeCoordinateDerivation_freeCoordinate_self, mul_one]
    · intro p _ hpq
      rw [freeCoordinateDerivation_freeCoordinate_of_ne (Ne.symm hpq), mul_zero]
    · intro hcon
      exact absurd (Finset.mem_coe.1 hq) hcon
  have hle := adjoin_le_derivationEqualizer hgen
  have hmem : f ∈ derivationEqualizer D D' := hle hf
  rw [mem_derivationEqualizer_iff] at hmem
  rw [hmem, hD'def, derivation_sum_smul_apply]

/-! ## Finite support -/

/-- Every element of a free rational coordinate field lies in the subfield generated by finitely
many coordinates. -/
theorem exists_finset_mem_freeCoordinateField (f : FreeCoordinateRationalField C σ) :
    ∃ S : Finset σ, f ∈ freeCoordinateField C σ (↑S : Set σ) := by
  classical
  obtain ⟨A, B, hB, rfl⟩ := IsFractionRing.div_surjective (A := MvPolynomial σ C) f
  refine ⟨A.vars ∪ B.vars, div_mem ?_ ?_⟩
  · exact algebraMap_mem_freeCoordinateField_of_mem_supported
      (MvPolynomial.mem_supported.2 (by
        intro i hi
        exact Finset.mem_coe.2 (Finset.mem_union_left _ hi)))
  · exact algebraMap_mem_freeCoordinateField_of_mem_supported
      (MvPolynomial.mem_supported.2 (by
        intro i hi
        exact Finset.mem_coe.2 (Finset.mem_union_right _ hi)))

end

end GaloisForLFunctions.HTGeometry
