import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

namespace GaloisForLFunctions.HTGeometry

/-- Field generated by a base subfield and all translated copies of one positive power. -/
def powerTranslationField {K ι : Type*} [Field K]
    (k : Subfield K) (T : ι → K ≃+* K) (F : K) (N : ℕ) : Subfield K :=
  Subfield.closure ((k : Set K) ∪ Set.range fun i => T i (F ^ N))

theorem powerTranslationField_mono_base
    {K ι : Type*} [Field K]
    {k l : Subfield K} (hkl : k ≤ l)
    (T : ι → K ≃+* K) (F : K) (N : ℕ) :
    powerTranslationField k T F N ≤ powerTranslationField l T F N := by
  apply Subfield.closure_mono
  exact Set.union_subset_union hkl Set.Subset.rfl

/-- Multiplication by a nonzero gauge in a translation-stable base field leaves every power-orbit
field exactly unchanged. -/
theorem powerTranslationField_mul_eq
    {K ι : Type*} [Field K]
    (k : Subfield K) (T : ι → K ≃+* K)
    (hT : ∀ i x, x ∈ k → T i x ∈ k)
    (F R : K) (hR : R ∈ k) (hR0 : R ≠ 0) (N : ℕ) :
    powerTranslationField k T (R * F) N =
      powerTranslationField k T F N := by
  apply le_antisymm
  · rw [powerTranslationField, Subfield.closure_le]
    intro x hx
    rcases hx with hx | ⟨i, rfl⟩
    · exact Subfield.subset_closure (Or.inl hx)
    · have hfactor : (T i R) ^ N ∈ powerTranslationField k T F N :=
        Subfield.subset_closure (Or.inl (k.pow_mem (hT i R hR) N))
      have hgenerator : T i (F ^ N) ∈ powerTranslationField k T F N :=
        Subfield.subset_closure (Or.inr ⟨i, rfl⟩)
      have hgenerator' : (T i F) ^ N ∈ powerTranslationField k T F N := by
        simpa using hgenerator
      change T i ((R * F) ^ N) ∈ powerTranslationField k T F N
      rw [mul_pow, map_mul, map_pow, map_pow]
      exact (powerTranslationField k T F N).mul_mem hfactor hgenerator'
  · rw [powerTranslationField, Subfield.closure_le]
    intro x hx
    rcases hx with hx | ⟨i, rfl⟩
    · exact Subfield.subset_closure (Or.inl hx)
    · have hfactor : (T i R) ^ N ∈
          powerTranslationField k T (R * F) N :=
        Subfield.subset_closure (Or.inl (k.pow_mem (hT i R hR) N))
      have hfactorInv : ((T i R) ^ N)⁻¹ ∈
          powerTranslationField k T (R * F) N :=
        (powerTranslationField k T (R * F) N).inv_mem hfactor
      have hgenerator : T i ((R * F) ^ N) ∈
          powerTranslationField k T (R * F) N :=
        Subfield.subset_closure (Or.inr ⟨i, rfl⟩)
      have hmapR : T i R ≠ 0 :=
        (map_ne_zero_iff (T i) (T i).injective).mpr hR0
      have heq : T i (F ^ N) =
          ((T i R) ^ N)⁻¹ * T i ((R * F) ^ N) := by
        simp [map_mul, mul_pow, hmapR]
      change T i (F ^ N) ∈ powerTranslationField k T (R * F) N
      rw [heq]
      exact (powerTranslationField k T (R * F) N).mul_mem
        hfactorInv hgenerator

/-- Gauge invariance is termwise along an arbitrary inverse-system index. -/
theorem powerTranslationField_mul_eq_funext
    {K ι κ : Type*} [Field K]
    (k : Subfield K) (T : ι → K ≃+* K)
    (hT : ∀ i x, x ∈ k → T i x ∈ k)
    (F R : K) (hR : R ∈ k) (hR0 : R ≠ 0) (N : κ → ℕ) :
    (fun j => powerTranslationField k T (R * F) (N j)) =
      fun j => powerTranslationField k T F (N j) := by
  funext j
  exact powerTranslationField_mul_eq k T hT F R hR hR0 (N j)

end GaloisForLFunctions.HTGeometry

