import Mathlib

/-!
# Reflection, conjugation, and symmetric polynomials

The functional equation `z ↦ 1 - z` and Schwarz reality `z ↦ conj z` act on polynomials by
substitution and by coefficientwise conjugation.  Averaging over the group they generate produces
polynomials with both symmetries whose jets at a free orbit are still arbitrary: the four terms of
the average contribute the same value at a free orbit representative once the interpolation data is
extended equivariantly.

A symmetric passport multiplier vanishing to even order on an invariant finite set keeps prescribed
jets untouched, and multiplication by it is invertible on jets away from that set.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

noncomputable section

/-! ### Reflection about the symmetry point -/

/-- Reflection of a polynomial in the functional-equation involution `z ↦ 1 - z`. -/
def reflectPoly (P : Polynomial ℂ) : Polynomial ℂ := P.comp (1 - Polynomial.X)

@[simp] theorem eval_reflectPoly (P : Polynomial ℂ) (z : ℂ) :
    (reflectPoly P).eval z = P.eval (1 - z) := by
  rw [reflectPoly, Polynomial.eval_comp]
  simp

theorem reflectPoly_add (P Q : Polynomial ℂ) :
    reflectPoly (P + Q) = reflectPoly P + reflectPoly Q := by
  rw [reflectPoly, reflectPoly, reflectPoly, Polynomial.add_comp]

theorem reflectPoly_smul (a : ℂ) (P : Polynomial ℂ) :
    reflectPoly (a • P) = a • reflectPoly P := by
  rw [reflectPoly, reflectPoly, Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul,
    Polynomial.mul_comp, Polynomial.C_comp]

theorem reflectPoly_reflectPoly (P : Polynomial ℂ) : reflectPoly (reflectPoly P) = P := by
  rw [reflectPoly, reflectPoly, Polynomial.comp_assoc]
  have h : ((1 : Polynomial ℂ) - Polynomial.X).comp (1 - Polynomial.X) = Polynomial.X := by
    rw [Polynomial.sub_comp, Polynomial.one_comp, Polynomial.X_comp]
    ring
  rw [h, Polynomial.comp_X]

theorem derivative_reflectPoly (P : Polynomial ℂ) :
    Polynomial.derivative (reflectPoly P) = - reflectPoly (Polynomial.derivative P) := by
  rw [reflectPoly, reflectPoly, Polynomial.derivative_comp]
  have h : Polynomial.derivative ((1 : Polynomial ℂ) - Polynomial.X) = -1 := by
    simp
  rw [h]
  ring

theorem iterate_derivative_reflectPoly (n : ℕ) (P : Polynomial ℂ) :
    Polynomial.derivative^[n] (reflectPoly P)
      = (-1 : ℂ) ^ n • reflectPoly (Polynomial.derivative^[n] P) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_smul, derivative_reflectPoly,
        Function.iterate_succ_apply']
      rw [pow_succ]
      module

/-! ### Coefficientwise conjugation -/

/-- Schwarz reflection of a polynomial: conjugate every coefficient. -/
def conjPoly (P : Polynomial ℂ) : Polynomial ℂ := P.map (starRingEnd ℂ)

@[simp] theorem eval_conjPoly (P : Polynomial ℂ) (z : ℂ) :
    (conjPoly P).eval z = (starRingEnd ℂ) (P.eval ((starRingEnd ℂ) z)) := by
  induction P using Polynomial.induction_on' with
  | add P Q hP hQ =>
      rw [conjPoly, Polynomial.map_add, Polynomial.eval_add, Polynomial.eval_add, map_add]
      rw [conjPoly] at hP hQ
      rw [hP, hQ]
  | monomial n a =>
      rw [conjPoly, Polynomial.map_monomial, Polynomial.eval_monomial, Polynomial.eval_monomial,
        map_mul, map_pow, Complex.conj_conj]

theorem conjPoly_add (P Q : Polynomial ℂ) : conjPoly (P + Q) = conjPoly P + conjPoly Q := by
  rw [conjPoly, conjPoly, conjPoly, Polynomial.map_add]

theorem conjPoly_conjPoly (P : Polynomial ℂ) : conjPoly (conjPoly P) = P := by
  rw [conjPoly, conjPoly, Polynomial.map_map]
  have h : (starRingEnd ℂ).comp (starRingEnd ℂ) = RingHom.id ℂ := by
    ext z
    simp
  rw [h, Polynomial.map_id]

theorem conjPoly_real_smul (r : ℝ) (P : Polynomial ℂ) :
    conjPoly ((r : ℂ) • P) = (r : ℂ) • conjPoly P := by
  rw [conjPoly, conjPoly, Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul,
    Polynomial.map_mul, Polynomial.map_C]
  simp

theorem derivative_conjPoly (P : Polynomial ℂ) :
    Polynomial.derivative (conjPoly P) = conjPoly (Polynomial.derivative P) := by
  rw [conjPoly, conjPoly, Polynomial.derivative_map]

theorem iterate_derivative_conjPoly (n : ℕ) (P : Polynomial ℂ) :
    Polynomial.derivative^[n] (conjPoly P) = conjPoly (Polynomial.derivative^[n] P) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, derivative_conjPoly, Function.iterate_succ_apply']

theorem reflectPoly_conjPoly (P : Polynomial ℂ) :
    reflectPoly (conjPoly P) = conjPoly (reflectPoly P) := by
  rw [reflectPoly, reflectPoly, conjPoly, conjPoly, Polynomial.map_comp]
  congr 1
  rw [Polynomial.map_sub, Polynomial.map_one, Polynomial.map_X]

/-! ### The equivariant average -/

/-- The average of a polynomial over the group generated by the two involutions. -/
def avgPoly (P : Polynomial ℂ) : Polynomial ℂ :=
  ((4 : ℂ)⁻¹) • (P + reflectPoly P + conjPoly P + reflectPoly (conjPoly P))

theorem avgPoly_add (P Q : Polynomial ℂ) : avgPoly (P + Q) = avgPoly P + avgPoly Q := by
  unfold avgPoly
  rw [reflectPoly_add, conjPoly_add, reflectPoly_add, ← smul_add]
  congr 1
  abel

theorem conjPoly_smul (a : ℂ) (P : Polynomial ℂ) :
    conjPoly (a • P) = ((starRingEnd ℂ) a) • conjPoly P := by
  rw [conjPoly, conjPoly, Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul,
    Polynomial.map_mul, Polynomial.map_C]

theorem reflectPoly_avgPoly (P : Polynomial ℂ) : reflectPoly (avgPoly P) = avgPoly P := by
  unfold avgPoly
  rw [reflectPoly_smul, reflectPoly_add, reflectPoly_add, reflectPoly_add,
    reflectPoly_reflectPoly, reflectPoly_reflectPoly]
  congr 1
  abel

theorem conjPoly_avgPoly (P : Polynomial ℂ) : conjPoly (avgPoly P) = avgPoly P := by
  unfold avgPoly
  rw [conjPoly_smul, conjPoly_add, conjPoly_add, conjPoly_add, conjPoly_conjPoly,
    reflectPoly_conjPoly, conjPoly_conjPoly]
  have h4 : (starRingEnd ℂ) ((4 : ℂ)⁻¹) = (4 : ℂ)⁻¹ := by
    rw [map_inv₀]
    congr 1
    rw [show (4 : ℂ) = ((4 : ℝ) : ℂ) by norm_num, Complex.conj_ofReal]
  rw [h4]
  congr 1
  abel

theorem avgPoly_real_smul (r : ℝ) (P : Polynomial ℂ) :
    avgPoly ((r : ℂ) • P) = (r : ℂ) • avgPoly P := by
  unfold avgPoly
  rw [reflectPoly_smul, conjPoly_real_smul, reflectPoly_smul, ← smul_add, ← smul_add, ← smul_add,
    smul_comm]

theorem avgPoly_real_C_mul (r : ℝ) (P : Polynomial ℂ) :
    avgPoly (Polynomial.C (r : ℂ) * P) = Polynomial.C (r : ℂ) * avgPoly P := by
  rw [← Polynomial.smul_eq_C_mul, ← Polynomial.smul_eq_C_mul, avgPoly_real_smul]

theorem iterate_derivative_smul_complex (n : ℕ) (a : ℂ) (Q : Polynomial ℂ) :
    Polynomial.derivative^[n] (a • Q) = a • Polynomial.derivative^[n] Q := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_smul, Function.iterate_succ_apply']

theorem iterate_derivative_add_complex (n : ℕ) (Q R : Polynomial ℂ) :
    Polynomial.derivative^[n] (Q + R)
      = Polynomial.derivative^[n] Q + Polynomial.derivative^[n] R := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_add, Function.iterate_succ_apply',
        Function.iterate_succ_apply']

theorem iterate_derivative_avgPoly_eval (n : ℕ) (P : Polynomial ℂ) (z : ℂ) :
    (Polynomial.derivative^[n] (avgPoly P)).eval z
      = ((4 : ℂ)⁻¹) * ((Polynomial.derivative^[n] P).eval z
          + (-1 : ℂ) ^ n * (Polynomial.derivative^[n] P).eval (1 - z)
          + (starRingEnd ℂ) ((Polynomial.derivative^[n] P).eval ((starRingEnd ℂ) z))
          + (-1 : ℂ) ^ n *
            (starRingEnd ℂ) ((Polynomial.derivative^[n] P).eval (1 - (starRingEnd ℂ) z))) := by
  have hsmul := iterate_derivative_smul_complex n
  have hadd := iterate_derivative_add_complex n
  have h1 : (Polynomial.derivative^[n] (reflectPoly P)).eval z
      = (-1 : ℂ) ^ n * (Polynomial.derivative^[n] P).eval (1 - z) := by
    rw [iterate_derivative_reflectPoly, Polynomial.eval_smul, eval_reflectPoly, smul_eq_mul]
  have h2 : ∀ w : ℂ, (Polynomial.derivative^[n] (conjPoly P)).eval w
      = (starRingEnd ℂ) ((Polynomial.derivative^[n] P).eval ((starRingEnd ℂ) w)) := by
    intro w
    rw [iterate_derivative_conjPoly, eval_conjPoly]
  have h3 : (Polynomial.derivative^[n] (reflectPoly (conjPoly P))).eval z
      = (-1 : ℂ) ^ n *
        (starRingEnd ℂ) ((Polynomial.derivative^[n] P).eval (1 - (starRingEnd ℂ) z)) := by
    rw [iterate_derivative_reflectPoly, Polynomial.eval_smul, eval_reflectPoly, smul_eq_mul,
      h2 (1 - z)]
    congr 3
    rw [map_sub, map_one]
  unfold avgPoly
  rw [hsmul, Polynomial.eval_smul, smul_eq_mul, hadd, hadd, hadd, Polynomial.eval_add,
    Polynomial.eval_add, Polynomial.eval_add, h1, h2 z, h3]

end

end GaloisForLFunctions.HTGeometry
