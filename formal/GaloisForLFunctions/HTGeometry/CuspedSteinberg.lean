import GaloisForLFunctions.HTGeometry.CuspedHomologyConcentration
import GaloisForLFunctions.HTGeometry.SteinbergSpanning
import GaloisForLFunctions.HTGeometry.BuildingFreeSubmodule
import GaloisForLFunctions.HTGeometry.BuildingNonvanishing
import Mathlib.LinearAlgebra.Dual.Lemmas

/-!
# The all-depth cusped complex carries the Steinberg module of the dual space

The all-depth order complex deformation retracts onto the depth-one skeleton, which is the poset of
nonzero proper subspaces under *reverse* inclusion — that is, the building of the dual space, by the
annihilator correspondence.  So everything proved about the building transports: the homology of the
all-depth complex is free in every positive degree, its top homology is a nonzero Steinberg module,
and that module is generated by the apartment classes of the frames of the dual space.

The dual space is where the frames live, exactly as the statement of the card says: the retraction
lands on the Tits building of `V*`.
-/

namespace GaloisForLFunctions.HTGeometry

open CategoryTheory Limits Simplicial Opposite Module

universe v u c

section

variable {K V : Type u} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
variable {C : Type c} [Category.{v} C] [Abelian C] [Limits.HasCoproducts.{u} C]

/-- **The annihilator identifies the dual of the subspace lattice with the subspace lattice of the
dual space.** -/
def submoduleOrderDualIso :
    (Submodule K V)ᵒᵈ ≃o Submodule K (Module.Dual K V) :=
  OrderIso.dual (Subspace.orderIsoFiniteDimensional (K := K) (V := V))

/-- **The depth-one skeleton of the all-depth poset is the building of the dual space.**  Reverse
inclusion of subspaces of `V` is inclusion of their annihilators in `V*`. -/
def cuspDualBuildingOrderIso :
    ({S : Submodule K V // S ≠ ⊥ ∧ S ≠ ⊤})ᵒᵈ ≃o properPart (Submodule K (Module.Dual K V)) :=
  (OrderIso.dual (properPartNeOrderIso (L := Submodule K V))).symm.trans
    ((properPartDualOrderIso (L := Submodule K V)).symm.trans
      (properPartCongr submoduleOrderDualIso))

/-- The same, as an isomorphism of order complexes. -/
noncomputable def cuspDualBuildingNerveIso :
    nerveFunctor.obj (Cat.of ({S : Submodule K V // S ≠ ⊥ ∧ S ≠ ⊤})ᵒᵈ)
      ≅ nerveFunctor.obj (Cat.of (properPart (Submodule K (Module.Dual K V)))) :=
  orderIsoNerveIso cuspDualBuildingOrderIso

variable [DecidableEq (Submodule K V)]

/-- **The all-depth cusped horizon complex has the homology of the building of the dual space.** -/
noncomputable def cuspDualHomologyIso (R : C) (n : ℕ) :
    (nerveFunctor.obj (Cat.of (CuspedVertex K V))).homology R n
      ≅ (nerveFunctor.obj (Cat.of (properPart (Submodule K (Module.Dual K V))))).homology R n :=
  cuspBuildingHomologyIso K V R n
    ≪≫ (SSet.homologyFunctor R n).mapIso (cuspDualBuildingNerveIso (K := K) (V := V))

/-- **The homology of the all-depth cusped complex is free** in every degree: it is the homology of
the building of the dual space. -/
theorem isFreeOver_cuspHomology [Nontrivial V] (R : C) (i : ℕ) :
    IsFreeOver.{v, c, u} R ((nerveFunctor.obj (Cat.of (CuspedVertex K V))).homology R i) := by
  haveI : Nontrivial (Module.Dual K V) := by
    refine Module.nontrivial_of_finrank_pos (R := K) ?_
    rw [Subspace.dual_finrank_eq]
    exact Module.finrank_pos
  exact IsFreeOver.of_iso (isFreeOver_homology_properPart_submodule
    (K := K) (V := Module.Dual K V) R i) (cuspDualHomologyIso R i)

/-- **The top homology of the all-depth cusped complex is nonzero**: the cusps do not kill the
Steinberg class. -/
theorem not_isZero_cuspHomology_top (R : C) (hR : ¬ Limits.IsZero R) (h3 : 3 ≤ finrank K V) :
    ¬ Limits.IsZero ((nerveFunctor.obj (Cat.of (CuspedVertex K V))).homology R
      (finrank K V - 2)) := by
  haveI : Nontrivial V := Module.nontrivial_of_finrank_pos (R := K) (by omega)
  have hdim : finrank K (Module.Dual K V) = finrank K V := Subspace.dual_finrank_eq
  intro hzero
  refine not_isZero_steinbergModule (K := K) (V := Module.Dual K V) R hR (by rw [hdim]; exact h3) ?_
  refine Limits.IsZero.of_iso hzero ?_
  exact eqToIso (congrArg
      (fun m => (nerveFunctor.obj
        (Cat.of (properPart (Submodule K (Module.Dual K V))))).homology R m)
      (show finrank K (Module.Dual K V) - 2 = finrank K V - 2 by rw [hdim]))
    ≪≫ (cuspDualHomologyIso R (finrank K V - 2)).symm

/-- **The apartment class of a frame of the dual space, in the all-depth cusped complex.** -/
noncomputable def cuspApartmentClass {n : ℕ} {ι : Type u} (e₀ : Fin (n + 3) ≃ ι)
    (D : FrameDatum (fun _ : PUnit.{u + 1} => (⊤ : Submodule K (Module.Dual K V))) ι) (R : C) :
    R ⟶ (nerveFunctor.obj (Cat.of (CuspedVertex K V))).homology R (n + 1) :=
  buildingApartmentClass e₀ D R ≫ (cuspDualHomologyIso R (n + 1)).inv

/-- **Solomon's theorem for the all-depth cusped complex**: its top homology is generated by the
apartment classes of the frames of the dual space. -/
theorem epi_cuspApartmentClasses {n : ℕ} {ι : Type u} [Finite ι] (hN : Nat.card ι = n + 3)
    (e₀ : Fin (n + 3) ≃ ι) (hdim : finrank K V = n + 3) (R : C) :
    Epi (Limits.Sigma.desc (fun D : FrameDatum
      (fun _ : PUnit.{u + 1} => (⊤ : Submodule K (Module.Dual K V))) ι =>
      cuspApartmentClass e₀ D R)) := by
  have hdual : finrank K (Module.Dual K V) = n + 3 := by
    rw [Subspace.dual_finrank_eq]
    exact hdim
  exact epi_sigmaDesc_comp_iso _ _ (Iso.isIso_inv _)
    (epi_buildingApartmentClasses (K := K) (V := Module.Dual K V) hN e₀ hdual R)

end

end GaloisForLFunctions.HTGeometry
