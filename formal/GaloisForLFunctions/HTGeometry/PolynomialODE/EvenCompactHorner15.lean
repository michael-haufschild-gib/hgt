    evenCompactHorner15 r t v = evenCompactRelativeGapGrade15 r v+
      evenCompactUnitGap r t*evenCompactHorner16 r t v := by
  unfold evenCompactHorner15 evenCompactHorner16
  rw [evenCompactHorner15Coeff0_eq, evenCompactHorner15Coeff1_eq, evenCompactHorner15Coeff2_eq, evenCompactHorner15Coeff3_eq, evenCompactHorner15Coeff4_eq, evenCompactHorner15Coeff5_eq]
  unfold evenCompactRelativeGapGrade15 evenCompactUnitGap
  ring1

