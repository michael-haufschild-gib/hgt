/-- The exact Horner polynomial retains its drift grading. -/
def evenCompactHorner15 (r t v : ℝ) : ℝ :=
  ((evenCompactHorner15Coeff0 t v +
    ((r^(1 : ℕ)*evenCompactHorner15Coeff1 t v) +
    (r^(2 : ℕ)*evenCompactHorner15Coeff2 t v) : ℝ) : ℝ) +
    ((r^(3 : ℕ)*evenCompactHorner15Coeff3 t v) +
    ((r^(4 : ℕ)*evenCompactHorner15Coeff4 t v) +
    (r^(5 : ℕ)*evenCompactHorner15Coeff5 t v) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
