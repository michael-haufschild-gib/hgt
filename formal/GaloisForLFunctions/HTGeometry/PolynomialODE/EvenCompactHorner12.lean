    ((r^(7 : ℕ)*evenCompactHorner12Coeff7 t v) +
    (r^(8 : ℕ)*evenCompactHorner12Coeff8 t v) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner12_step (r t v : ℝ) :
    evenCompactHorner12 r t v = evenCompactRelativeGapGrade12 r v+
      evenCompactUnitGap r t*evenCompactHorner13 r t v := by
  unfold evenCompactHorner12 evenCompactHorner13
  rw [evenCompactHorner12Coeff0_eq, evenCompactHorner12Coeff1_eq, evenCompactHorner12Coeff2_eq, evenCompactHorner12Coeff3_eq, evenCompactHorner12Coeff4_eq, evenCompactHorner12Coeff5_eq, evenCompactHorner12Coeff6_eq, evenCompactHorner12Coeff7_eq, evenCompactHorner12Coeff8_eq]
  unfold evenCompactRelativeGapGrade12 evenCompactUnitGap
  ring1

end
