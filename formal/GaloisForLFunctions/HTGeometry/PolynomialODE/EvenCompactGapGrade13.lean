    (r^(1 : ℕ)*evenCompactRelativeGapGrade13Coeff1 v) : ℝ) +
    ((r^(2 : ℕ)*evenCompactRelativeGapGrade13Coeff2 v) +
    (r^(3 : ℕ)*evenCompactRelativeGapGrade13Coeff3 v) : ℝ) : ℝ) +
    (((r^(4 : ℕ)*evenCompactRelativeGapGrade13Coeff4 v) +
    (r^(5 : ℕ)*evenCompactRelativeGapGrade13Coeff5 v) : ℝ) +
    ((r^(6 : ℕ)*evenCompactRelativeGapGrade13Coeff6 v) +
    (r^(7 : ℕ)*evenCompactRelativeGapGrade13Coeff7 v) : ℝ) : ℝ) : ℝ)

