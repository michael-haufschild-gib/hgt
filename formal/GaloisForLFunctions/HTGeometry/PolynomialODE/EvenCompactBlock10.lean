/-- The decomposition is a symbolic integer polynomial identity on the entire unit cube. -/
theorem evenCompactUnitBlock10_eq {r t v : ℝ}
    (hr0 : 0 ≤ r) (hr1 : r ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) :
    evenCompactUnitBlock10 r t v = evenCompactUnitBlock10Lower r t v+evenCompactUnitBlock10Remainder r t v := by
  unfold evenCompactUnitBlock10 evenCompactUnitBlock10Lower evenCompactUnitBlock10Remainder
  rw [← add_div]
  congr 1
  simp only [oddCompactUnitSlack_eq hr0 hr1 ht0 ht1 hv0 hv1]
  ring

/-- Every omitted term has a proved nonnegative contribution. -/
theorem evenCompactUnitBlock10_remainder_nonneg {r t v : ℝ}
    (hr0 : 0 ≤ r) (ht0 : 0 ≤ t) (hv0 : 0 ≤ v) :
    0 ≤ evenCompactUnitBlock10Remainder r t v := by
  unfold evenCompactUnitBlock10Remainder oddCompactUnitSlack
  positivity

end
