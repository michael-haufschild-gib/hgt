    (r^(16 : ℕ)*evenCompactHorner4Coeff16 t v) : ℝ) : ℝ) : ℝ) : ℝ) : ℝ)

/-- Assemble the checked coefficient identities without expanding their polynomials. -/
theorem evenCompactHorner4_step (r t v : ℝ) :
    evenCompactHorner4 r t v = evenCompactRelativeGapGrade4 r v+
      evenCompactUnitGap r t*evenCompactHorner5 r t v := by
  unfold evenCompactHorner4 evenCompactHorner5
  rw [evenCompactHorner4Coeff0_eq, evenCompactHorner4Coeff1_eq, evenCompactHorner4Coeff2_eq, evenCompactHorner4Coeff3_eq, evenCompactHorner4Coeff4_eq, evenCompactHorner4Coeff5_eq, evenCompactHorner4Coeff6_eq, evenCompactHorner4Coeff7_eq, evenCompactHorner4Coeff8_eq, evenCompactHorner4Coeff9_eq, evenCompactHorner4Coeff10_eq, evenCompactHorner4Coeff11_eq, evenCompactHorner4Coeff12_eq, evenCompactHorner4Coeff13_eq, evenCompactHorner4Coeff14_eq, evenCompactHorner4Coeff15_eq, evenCompactHorner4Coeff16_eq]
  unfold evenCompactRelativeGapGrade4 evenCompactUnitGap
  ring1

