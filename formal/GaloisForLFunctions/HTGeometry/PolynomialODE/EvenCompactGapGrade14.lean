    (r^(2 : ℕ)*evenCompactRelativeGapGrade14Coeff2 v) : ℝ) : ℝ) +
    (((r^(3 : ℕ)*evenCompactRelativeGapGrade14Coeff3 v) +
    (r^(4 : ℕ)*evenCompactRelativeGapGrade14Coeff4 v) : ℝ) +
    ((r^(5 : ℕ)*evenCompactRelativeGapGrade14Coeff5 v) +
    (r^(6 : ℕ)*evenCompactRelativeGapGrade14Coeff6 v) : ℝ) : ℝ) : ℝ)

/-- Exact symbolic relative-shear identity at this entire gap degree. -/
