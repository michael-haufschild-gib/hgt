/-- The decomposition is a symbolic integer polynomial identity on the entire unit cube. -/
theorem evenCompactUnitBlock8_eq {r t v : ℝ}
    (hr0 : 0 ≤ r) (hr1 : r ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hv0 : 0 ≤ v) (hv1 : v ≤ 1) :
    evenCompactUnitBlock8 r t v = evenCompactUnitBlock8Lower r t v+evenCompactUnitBlock8Remainder r t v := by
  unfold evenCompactUnitBlock8 evenCompactUnitBlock8Lower evenCompactUnitBlock8Remainder
  rw [← add_div]
  congr 1
  simp only [oddCompactUnitSlack_eq hr0 hr1 ht0 ht1 hv0 hv1]
  ring

/-- Every omitted term has a proved nonnegative contribution. -/
theorem evenCompactUnitBlock8_remainder_nonneg {r t v : ℝ}
    (hr0 : 0 ≤ r) (ht0 : 0 ≤ t) (hv0 : 0 ≤ v) :
    0 ≤ evenCompactUnitBlock8Remainder r t v := by
  unfold evenCompactUnitBlock8Remainder oddCompactUnitSlack
  positivity

end
