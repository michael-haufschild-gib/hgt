/-- The cubic minorant split by drift degree. -/
theorem oddCompactCubicMinorant_grades (u t w : ℝ) :
    oddCompactCubicMinorant u t w =
      oddCompactCubicMinorantGrade0 u t w +
      oddCompactCubicMinorantGrade1 u t w +
      oddCompactCubicMinorantGrade2 u t w +
      oddCompactCubicMinorantGrade3 u t w := by
  unfold oddCompactCubicMinorant oddCompactCubicMinorantGrade0 oddCompactCubicMinorantGrade1 oddCompactCubicMinorantGrade2 oddCompactCubicMinorantGrade3
  ring

