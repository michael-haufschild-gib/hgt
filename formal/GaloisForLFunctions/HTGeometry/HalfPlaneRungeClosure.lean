import GaloisForLFunctions.HTGeometry.HolomorphicSubalgebra
import GaloisForLFunctions.HTGeometry.HalfPlaneRungeOneAtom
import GaloisForLFunctions.HTGeometry.CompactOpenClosureCriterion

/-!
# Every holomorphic function lies in the closed algebra generated by one Cauchy coordinate

Runge approximation on the half-plane, in the form its consumers need: the compact-open closure of
the polynomials in `z ↦ (z + a)⁻¹` contains every holomorphic function.

The statement is a containment, not an equality.  The closure is *not* all of `C(↥H, ℂ)` — the
contour functional annihilates every power of the coordinate and is nonzero — so what is true, and
what a dual-annihilator argument consumes, is that the holomorphic functions are inside it.

* `HTGeometry.holo_mem_topologicalClosure_adjoin_cauchyCoord`.
-/

open Metric

namespace HTGeometry

/-- **Runge on the half-plane, as a closure containment.** -/
theorem holo_mem_topologicalClosure_adjoin_cauchyCoord {a : ℝ} (ha : 0 < a)
    (f : C((rightHalfPlane : Set ℂ), ℂ)) (hf : f ∈ holoAlgebra) :
    f ∈ (Algebra.adjoin ℂ
      ({cauchyCoord a ha} : Set C((rightHalfPlane : Set ℂ), ℂ))).topologicalClosure := by
  classical
  obtain ⟨F, hF, hfF⟩ := hf
  refine mem_topologicalClosure_of_forall_isCompact_approx _ f ?_
  intro K hK ε hε
  -- the image of `K` in the plane
  have hKim : IsCompact (Subtype.val '' K) := hK.image continuous_subtype_val
  have hKsub : ∀ z ∈ Subtype.val '' K, 0 < z.re := by
    rintro z ⟨w, -, rfl⟩
    exact w.2
  obtain ⟨n, Rn, G, hn⟩ := exists_partialSum_cauchyCoordinate_approx ha hF hKim hKsub hε
  -- the approximant, as a polynomial in the coordinate
  set c : ℂ := ((1 / (2 * a) : ℝ) : ℂ) with hc
  set u : C((rightHalfPlane : Set ℂ), ℂ) :=
    cauchyCoord a ha - algebraMap ℂ C((rightHalfPlane : Set ℂ), ℂ) c with hu
  set g : C((rightHalfPlane : Set ℂ), ℂ) :=
    ∑ k ∈ Finset.range n, (cauchyPowerSeries G 0 (Rn : ℝ)).coeff k • u ^ k with hg
  have humem : u ∈ Algebra.adjoin ℂ ({cauchyCoord a ha} : Set C((rightHalfPlane : Set ℂ), ℂ)) := by
    refine Subalgebra.sub_mem _ ?_ ?_
    · exact Algebra.self_mem_adjoin_singleton ℂ _
    · exact Subalgebra.algebraMap_mem _ c
  have hgmem : g ∈ Algebra.adjoin ℂ ({cauchyCoord a ha} : Set C((rightHalfPlane : Set ℂ), ℂ)) := by
    rw [hg]
    refine Subalgebra.sum_mem _ fun k _ => ?_
    exact Subalgebra.smul_mem _ (Subalgebra.pow_mem _ humem k) _
  refine ⟨g, hgmem, fun z hz => ?_⟩
  -- the approximant evaluates to the partial sum
  have hgval : g z = (cauchyPowerSeries G 0 (Rn : ℝ)).partialSum n
      (((z : ℂ) + (a : ℂ))⁻¹ - c) := by
    rw [hg, FormalMultilinearSeries.partialSum]
    simp only [ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.coe_smul, Pi.smul_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [FormalMultilinearSeries.apply_eq_pow_smul_coeff]
    have huval : (u ^ k) z = (((z : ℂ) + (a : ℂ))⁻¹ - c) ^ k := by
      rw [hu]
      simp [cauchyCoord_apply]
    rw [huval, smul_eq_mul, smul_eq_mul]
    ring
  have hzim : (z : ℂ) ∈ Subtype.val '' K := ⟨z, hz, rfl⟩
  have hbound := hn (z : ℂ) hzim
  rw [hgval, hfF z]
  exact hbound

end HTGeometry
