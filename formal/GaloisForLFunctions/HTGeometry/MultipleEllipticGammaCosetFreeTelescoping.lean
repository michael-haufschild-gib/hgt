/-- **No simultaneous telescoper on a free labelled deeper face field.** -/
theorem cosetFacePacket_no_telescoping_of_free (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (hJS : J ∉ S)
    (hindep : DifferentialIndependent
      ↥(differentialAdjoin ℂ
        (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)))
      (cosetFacePalette τ hτ A (insert q J) q))
    (hinjD : Function.Injective (cosetFacePacketDisplacementSlice τ hτ A J hqJ))
    (c : (↥(cosetFacePacket τ hτ A J) × ℕ) →₀ ℂ) (hc : c ≠ 0)
    (k : ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
    (cosetFacePacketDifferenceSystem τ hτ A hS q u).defect 1 k ≠
      Finsupp.linearCombination ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
        (fun p ↦ differentialJet p.2
          (cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS 1 p.1))
        (Finsupp.mapRange
          (algebraMap ℂ ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))
          (map_zero (algebraMap ℂ
            ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))) c) := by
  classical
  intro hEq
  have hS₀ : ∀ L ∈ facePacketBaseFamily S J q, q ∉ L →
      insert q L ∈ facePacketBaseFamily S J q :=
    facePacketBaseFamily_closed hS hqJ hJS
  set K₀ : IntermediateField ℂ (meroField (Set.univ : Set ℂ)) :=
    differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)) with hK₀
  set P : (↥(cosetFacePacketSlice τ hτ A (insert q J) q) × ℤ) →
      meroField (Set.univ : Set ℂ) := cosetFacePalette τ hτ A (insert q J) q with hP
  let φ : ↥K₀ ≃+* ↥K₀ :=
    meroTranslationRestrict K₀ (τ q)
      (fun x hx => differentialAdjoin_cosetFacePacketUnion_translate_stable τ hτ A q hS₀ hx)
      (fun x hx => differentialAdjoin_cosetFacePacketUnion_neg_translate_stable τ hτ A q hS₀ hx)
  let e : ↥(cosetFacePacket τ hτ A J) × ℕ →
      ↥(cosetFacePacketSlice τ hτ A (insert q J) q) × ℕ :=
    fun p => (cosetFacePacketDisplacementSlice τ hτ A J hqJ p.1, p.2)
  have he : Function.Injective e := by
    rintro ⟨a, m⟩ ⟨b, n⟩ h
    have h1 : cosetFacePacketDisplacementSlice τ hτ A J hqJ a =
        cosetFacePacketDisplacementSlice τ hτ A J hqJ b := congrArg Prod.fst h
    have h2 : m = n := congrArg Prod.snd h
    rw [hinjD h1, h2]
  set c' : (↥(cosetFacePacketSlice τ hτ A (insert q J) q) × ℕ) →₀ ↥K₀ :=
    Finsupp.mapRange (algebraMap ℂ ↥K₀) (map_zero (algebraMap ℂ ↥K₀))
      (Finsupp.mapDomain e c) with hc'def
  have hc' : c' ≠ 0 := by
    rw [hc'def]
    intro hzero
    have h1 : Finsupp.mapDomain e c = 0 :=
      Finsupp.mapRange_injective (algebraMap ℂ ↥K₀) (map_zero _)
        (algebraMap ℂ ↥K₀).injective (by simpa using hzero)
    exact hc (Finsupp.mapDomain_injective he (by simpa using h1))
  have hkmem : (k : meroField (Set.univ : Set ℂ)) ∈
      differentialAdjoin ↥K₀ (Set.range P) :=
    cosetFacePacketUnion_le_free_adjoin τ hτ A S J q k.2
  refine oneSlice_ne_coboundary_of_twisted_ambient_shift P hindep
    (addTranslationMeroEquiv (τ q)) φ
    (fun y => addTranslationMeroEquiv_deriv (τ q) y)
    (fun b => rfl)
    (fun p => cosetFacePalette_shift τ hτ A (insert q J) q p)
    c' hc' ⟨(k : meroField (Set.univ : Set ℂ)), hkmem⟩ ?_
  have hRHS : ((c'.sum (fun j a =>
        algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P)) a *
          ⟨differentialJet j.2 (P (j.1, 0)),
            differentialJet_mem_differentialAdjoin ↥K₀
              (Set.mem_range_self (j.1, 0)) j.2⟩) :
        ↥(differentialAdjoin ↥K₀ (Set.range P))) : meroField (Set.univ : Set ℂ)) =
      c.sum (fun p a => algebraMap ℂ (meroField (Set.univ : Set ℂ)) a *
        differentialJet p.2
          (addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
            (p.1 : meroField (Set.univ : Set ℂ)))) := by
    rw [hc'def, Finsupp.sum_mapRange_index (by intro a; simp),
      Finsupp.sum_mapDomain_index_inj he]
    simp only [Finsupp.sum]
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have hPD : P (cosetFacePacketDisplacementSlice τ hτ A J hqJ p.1, 0) =
        addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
          (p.1 : meroField (Set.univ : Set ℂ)) := by
      rw [hP, cosetFacePalette_zero]
      rfl
    rw [MulMemClass.coe_mul]
    show ((algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P))
        (algebraMap ℂ ↥K₀ (c p)) : ↥(differentialAdjoin ↥K₀ (Set.range P))) :
        meroField (Set.univ : Set ℂ)) *
        differentialJet p.2 (P (cosetFacePacketDisplacementSlice τ hτ A J hqJ p.1, 0)) = _
    have hcoef : ((algebraMap ↥K₀ ↥(differentialAdjoin ↥K₀ (Set.range P))
          (algebraMap ℂ ↥K₀ (c p)) : ↥(differentialAdjoin ↥K₀ (Set.range P))) :
          meroField (Set.univ : Set ℂ)) =
        algebraMap ℂ (meroField (Set.univ : Set ℂ)) (c p) := by
      rw [IsScalarTower.algebraMap_apply ℂ ↥K₀ (meroField (Set.univ : Set ℂ))]
      rfl
    rw [hPD, hcoef]
  have hLHS : ((Finsupp.linearCombination
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
        (fun p ↦ differentialJet p.2
          (cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS 1 p.1))
        (Finsupp.mapRange
          (algebraMap ℂ ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))
          (map_zero (algebraMap ℂ
            ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)))) c) :
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
        meroField (Set.univ : Set ℂ)) =
      c.sum (fun p a => algebraMap ℂ (meroField (Set.univ : Set ℂ)) a *
        differentialJet p.2
          (addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
            (p.1 : meroField (Set.univ : Set ℂ)))) := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (by intro a; simp)]
    simp only [Finsupp.sum]
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have hcoefK : ((algebraMap ℂ
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) (c p) :
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
        meroField (Set.univ : Set ℂ)) =
        algebraMap ℂ (meroField (Set.univ : Set ℂ)) (c p) :=
      (IsScalarTower.algebraMap_apply ℂ
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
        (meroField (Set.univ : Set ℂ)) (c p)).symm
    have hD : ((cosetFacePacketDisplacement τ hτ A J hqJ huJ hqS huS 1 p.1 :
        ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))) :
        meroField (Set.univ : Set ℂ)) =
        addTranslationMeroEquiv (τ q) (p.1 : meroField (Set.univ : Set ℂ)) -
          (p.1 : meroField (Set.univ : Set ℂ)) := rfl
    rw [Algebra.smul_def, MulMemClass.coe_mul,
      coe_differentialJet_differentialAdjoin, Algebra.algebraMap_self_apply, hcoefK, hD]
  show addTranslationMeroEquiv (τ q) (k : meroField (Set.univ : Set ℂ)) -
      (k : meroField (Set.univ : Set ℂ)) = _
  rw [hRHS, ← hLHS]
  exact congrArg (fun w : ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) =>
    (w : meroField (Set.univ : Set ℂ))) hEq

set_option synthInstance.maxHeartbeats 800000 in
/-- **Labelled descending face-lifting on a free deeper field.** -/
theorem cosetFacePacket_differentialIndependent_of_free (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im)
    (A : Set ℂ) {S : Set (Finset ι)} (hS : ∀ L ∈ S, ∀ p : ι, p ∉ L → insert p L ∈ S)
    (J : Finset ι) {q u : ι} (hqJ : q ∉ J) (huJ : u ∉ J)
    (hqS : insert q J ∈ S) (huS : insert u J ∈ S) (hJS : J ∉ S)
    (hv : LinearIndependent ℚ (facePacketPeriods τ q u))
    (hindep : DifferentialIndependent
      ↥(differentialAdjoin ℂ
        (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)))
      (cosetFacePalette τ hτ A (insert q J) q))
    (hinjD : Function.Injective (cosetFacePacketDisplacementSlice τ hτ A J hqJ)) :
    DifferentialIndependent ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S))
      (cosetFacePacketBlock τ hτ A J) :=
  cosetFacePacket_differentialIndependent_of_no_telescoping τ hτ A hS J hqJ huJ hqS huS hv
    (fun c hc k => ⟨1, cosetFacePacket_no_telescoping_of_free τ hτ A hS J hqJ huJ hqS huS hJS
      hindep hinjD c hc k⟩)

end

