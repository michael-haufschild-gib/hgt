import GaloisForLFunctions.HTGeometry.MultipleEllipticGammaCosetDifferenceSystem
import GaloisForLFunctions.HTGeometry.FacePacketFreeTelescoping

/-!
# Labelled free telescoping and the labelled descending face-lifting lemma

The labelled analogue of `FacePacketFreeTelescoping`.  The label is inert: the displacement of a
labelled packet element in a surviving direction is the corresponding labelled coface element,
whose exponent in that direction vanishes, so the transported one-slice nonsummability obstruction
applies verbatim.

* `cosetFacePacketDisplacementSlice` — the displacement labelling;
* **`cosetFacePacket_no_telescoping_of_free`** — no simultaneous telescoper;
* **`cosetFacePacket_differentialIndependent_of_free`** — the labelled descending face-lifting
  lemma.
-/

open Filter Topology Set Function Complex
open scoped Differential BigOperators

namespace GaloisForLFunctions

open Bottcher MatroidGluing MatroidGluing.Rank MatroidGluing.Meromorphic

noncomputable section

attribute [local instance] facePacketMeroDecidableEq

attribute [local instance] ellipticGammaRationalBaseDomain
  ellipticGammaRationalBaseComplexAlgebraMero ellipticGammaRationalBaseComplexDifferential
  ellipticGammaRationalBaseMeroDifferential ellipticGammaRationalBaseMeroCharZero
  ellipticGammaRationalBaseComplexDifferentialAlgebra

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- The displacement of a labelled packet element in a surviving direction is the labelled coface
element, whose exponent in that direction vanishes. -/
theorem cosetFacePacket_displacement_mem_slice (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (J : Finset ι) {q : ι} (hq : q ∉ J) {y : meroField (Set.univ : Set ℂ)}
    (hy : y ∈ cosetFacePacket τ hτ A J) :
    addTranslationMeroEquiv (τ q) y - y ∈
      cosetFacePacketSlice τ hτ A (insert q J) q := by
  obtain ⟨g, hg, rfl⟩ := hy
  rw [facePacket_coface τ hτ J hq g]
  obtain ⟨α, hα, u, hu, rfl⟩ := hg
  obtain ⟨n, hn, rfl⟩ := hu
  refine ⟨_, ⟨α, hα, _, ⟨n, ?_, hn q hq, rfl⟩, rfl⟩, rfl⟩
  intro i hi
  exact hn i fun hiJ => hi (Finset.mem_insert_of_mem hiJ)

/-- The labelled displacement labelling of the translation block by the zero slice of the next
labelled packet. -/
def cosetFacePacketDisplacementSlice (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (J : Finset ι) {q : ι} (hq : q ∉ J) :
    ↥(cosetFacePacket τ hτ A J) →
      ↥(cosetFacePacketSlice τ hτ A (insert q J) q) :=
  fun y => ⟨addTranslationMeroEquiv (τ q) (y : meroField (Set.univ : Set ℂ)) -
      (y : meroField (Set.univ : Set ℂ)),
    cosetFacePacket_displacement_mem_slice τ hτ A J hq y.2⟩

theorem cosetFacePalette_zero (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (J : Finset ι) (q : ι) (a : ↥(cosetFacePacketSlice τ hτ A J q)) :
    cosetFacePalette τ hτ A J q (a, 0) = (a : meroField (Set.univ : Set ℂ)) := by
  show addTranslationMeroEquiv (((0 : ℤ) : ℂ) * τ q) (a : meroField (Set.univ : Set ℂ)) = _
  rw [Int.cast_zero, zero_mul, addTranslationMeroEquiv_zero_apply]

