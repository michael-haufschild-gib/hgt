/-- **The labelled deeper face field is generated by the target labelled packet over the
complementary base.** -/
theorem cosetFacePacketUnion_le_free_adjoin (τ : ι → ℂ) (hτ : ∀ i, 0 < (τ i).im) (A : Set ℂ)
    (S : Set (Finset ι)) (J : Finset ι) (q : ι)
    {z : meroField (Set.univ : Set ℂ)}
    (hz : z ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S)) :
    z ∈ differentialAdjoin
      ↥(differentialAdjoin ℂ
        (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)))
      (Set.range (cosetFacePalette τ hτ A (insert q J) q)) := by
  classical
  let E := differentialAdjoin
    ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)))
    (Set.range (cosetFacePalette τ hτ A (insert q J) q))
  haveI : DifferentialAlgebra
      ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q)))
      (meroField (Set.univ : Set ℂ)) :=
    ⟨fun x => derivationClosedDifferential_apply _
      (derivationClosed_differentialAdjoin ℂ
        (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q))) x⟩
  have hEclosed : DerivationClosed E := derivationClosed_differentialAdjoin _ _
  have hgens : ∀ y ∈ cosetFacePacketUnion τ hτ A S, y ∈ E := by
    intro y hy
    obtain ⟨L, hL, hyL⟩ := Set.mem_iUnion₂.mp hy
    by_cases hLt : L = insert q J
    · subst hLt
      refine subset_differentialAdjoin _ _ ?_
      rw [range_cosetFacePalette τ hτ A (insert q J) (Finset.mem_insert_self q J)]
      exact hyL
    · have hmem : y ∈ cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q) :=
        Set.mem_iUnion₂.mpr ⟨L, ⟨hL, hLt⟩, hyL⟩
      exact E.algebraMap_mem ⟨y, subset_differentialAdjoin ℂ _ hmem⟩
  let p : ∀ y : meroField (Set.univ : Set ℂ),
      y ∈ differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A S) → Prop := fun y _ => y ∈ E
  change p z hz
  refine IntermediateField.adjoin_induction ℂ (p := p) ?_ ?_ ?_ ?_ ?_ hz
  · rintro y ⟨y₀, hy₀, n, rfl⟩
    exact hEclosed.differentialJet_mem (hgens y₀ hy₀) n
  · intro c
    exact E.algebraMap_mem (algebraMap ℂ
      ↥(differentialAdjoin ℂ (cosetFacePacketUnion τ hτ A (facePacketBaseFamily S J q))) c)
  · intro y w _ _ hy hw
    exact E.add_mem hy hw
  · intro y _ hy
    exact E.inv_mem hy
  · intro y w _ _ hy hw
    exact E.mul_mem hy hw

