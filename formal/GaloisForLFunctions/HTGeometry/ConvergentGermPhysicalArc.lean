import GaloisForLFunctions.HTGeometry.PhysicalArcCriticalCompletion
import GaloisForLFunctions.HTGeometry.PhysicalCharacteristicIncidence

/-!
# The physical exponential clock in the ring of convergent germs

The local ring `ℂ{λ}` of germs at the origin of functions holomorphic near the origin is realized
as the subring of the germ ring `Germ (𝓝 0) ℂ` consisting of germs with an analytic
representative.  A germ with nonvanishing value at the origin is a unit there, because the pointwise
inverse of its representative is analytic and agrees with it on a neighbourhood.

The genuine exponential clock `exp(τ_j λ) - 1` is the coordinate times such a unit, with unit value
`τ_j` at the origin.  Hence for nonvanishing periods the coface ideal generated by the `r+1`
products of `r` clock factors is exactly the principal fat-point ideal `(λ^r)` of `ℂ{λ}`, the
convergent counterpart of the formal-power-series computation.
-/

open Filter
open scoped BigOperators Topology

namespace GaloisForLFunctions

open HTGeometry

noncomputable section

/-! ## The local ring of convergent germs -/

/-- Germs at the origin admitting a representative analytic at the origin. -/
def convergentGermSubring : Subring (Germ (𝓝 (0 : ℂ)) ℂ) where
  carrier := {g | ∃ f : ℂ → ℂ, AnalyticAt ℂ f 0 ∧ g = (f : Germ (𝓝 (0 : ℂ)) ℂ)}
  zero_mem' := ⟨0, analyticAt_const, Germ.coe_zero.symm⟩
  one_mem' := ⟨1, analyticAt_const, Germ.coe_one.symm⟩
  add_mem' := by
    rintro _ _ ⟨f, hf, rfl⟩ ⟨g, hg, rfl⟩
    exact ⟨f + g, hf.add hg, (Germ.coe_add f g).symm⟩
  mul_mem' := by
    rintro _ _ ⟨f, hf, rfl⟩ ⟨g, hg, rfl⟩
    exact ⟨f * g, hf.mul hg, (Germ.coe_mul f g).symm⟩
  neg_mem' := by
    rintro _ ⟨f, hf, rfl⟩
    exact ⟨-f, hf.neg, (Germ.coe_neg f).symm⟩

/-- The local ring `ℂ{λ}` of convergent germs at the origin. -/
abbrev ConvergentGerm : Type := convergentGermSubring

/-- The convergent germ of an analytic function. -/
def germOfAnalytic (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) : ConvergentGerm :=
  ⟨(f : Germ (𝓝 (0 : ℂ)) ℂ), f, hf, rfl⟩

@[simp] theorem germOfAnalytic_val (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) :
    (germOfAnalytic f hf : Germ (𝓝 (0 : ℂ)) ℂ) = (f : Germ (𝓝 (0 : ℂ)) ℂ) := rfl

/-- Germs are equal when the representatives agree near the origin. -/
theorem germOfAnalytic_congr {f g : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (hg : AnalyticAt ℂ g 0)
    (h : f =ᶠ[𝓝 (0 : ℂ)] g) : germOfAnalytic f hf = germOfAnalytic g hg :=
  Subtype.ext (Germ.coe_eq.mpr h)

theorem germOfAnalytic_mul {f g : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (hg : AnalyticAt ℂ g 0) :
    germOfAnalytic (f * g) (hf.mul hg) = germOfAnalytic f hf * germOfAnalytic g hg :=
  Subtype.ext (Germ.coe_mul f g)

/-- **Units of `ℂ{λ}`.**  A convergent germ with nonzero value at the origin is invertible. -/
theorem isUnit_germOfAnalytic {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (h0 : f 0 ≠ 0) :
    IsUnit (germOfAnalytic f hf) := by
  refine IsUnit.of_mul_eq_one (germOfAnalytic f⁻¹ (hf.inv h0)) (Subtype.ext ?_)
  have hne : ∀ᶠ z in 𝓝 (0 : ℂ), f z ≠ 0 := hf.continuousAt.eventually_ne h0
  have hev : f * f⁻¹ =ᶠ[𝓝 (0 : ℂ)] 1 := by
    filter_upwards [hne] with z hz
    exact mul_inv_cancel₀ hz
  calc (germOfAnalytic f hf * germOfAnalytic f⁻¹ (hf.inv h0) : ConvergentGerm).1
      = ((f * f⁻¹ : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) := (Germ.coe_mul f f⁻¹).symm
    _ = ((1 : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) := Germ.coe_eq.mpr hev
    _ = 1 := Germ.coe_one

/-! ## The physical exponential clock as a convergent germ -/

theorem analyticAt_expArcSubOne (t : ℂ) :
    AnalyticAt ℂ (fun z => Complex.exp (t * z) - 1) 0 :=
  (Differentiable.differentiableOn (s := Set.univ)
    (differentiable_expArcSubOne t)).analyticAt Filter.univ_mem

theorem analyticAt_expArcUnit (t : ℂ) : AnalyticAt ℂ (expArcUnit t) 0 :=
  (Differentiable.differentiableOn (s := Set.univ)
    (differentiable_expArcUnit t)).analyticAt Filter.univ_mem

/-- The coordinate `λ` of `ℂ{λ}`. -/
def convergentCoordinate : ConvergentGerm := germOfAnalytic id analyticAt_id

/-- The germ of the genuine exponential clock factor `exp(t λ) - 1`. -/
def expArcGerm (t : ℂ) : ConvergentGerm :=
  germOfAnalytic (fun z => Complex.exp (t * z) - 1) (analyticAt_expArcSubOne t)

/-- The germ of its holomorphic unit factor. -/
def expArcUnitGerm (t : ℂ) : ConvergentGerm :=
  germOfAnalytic (expArcUnit t) (analyticAt_expArcUnit t)

/-- **The convergent factorization `exp(t λ) - 1 = λ U_t`.** -/
theorem expArcGerm_eq_coordinate_mul (t : ℂ) :
    expArcGerm t = convergentCoordinate * expArcUnitGerm t := by
  refine Subtype.ext ?_
  show ((fun z => Complex.exp (t * z) - 1 : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) =
    ((id : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) * ((expArcUnit t : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ)
  rw [← Germ.coe_mul]
  refine Germ.coe_eq.mpr (Eventually.of_forall fun z => ?_)
  exact (mul_expArcUnit t z).symm

/-- **The unit factor is a unit of `ℂ{λ}`** exactly through its nonzero value `t` at the origin. -/
theorem isUnit_expArcUnitGerm {t : ℂ} (ht : t ≠ 0) : IsUnit (expArcUnitGerm t) :=
  isUnit_germOfAnalytic (analyticAt_expArcUnit t) (by rw [expArcUnit_zero]; exact ht)

/-- The unit of `ℂ{λ}` attached to a nonzero period. -/
def expArcUnitGermUnit (t : ℂ) (ht : t ≠ 0) : ConvergentGermˣ :=
  (isUnit_expArcUnitGerm ht).unit

theorem coe_expArcUnitGermUnit (t : ℂ) (ht : t ≠ 0) :
    (expArcUnitGermUnit t ht : ConvergentGerm) = expArcUnitGerm t :=
  (isUnit_expArcUnitGerm ht).unit_spec

/-! ## The convergent physical coface ideal -/

/-- The `i`-th physical coface generator in `ℂ{λ}`: the product of the genuine exponential clock
factors over all directions but one. -/
def convergentCofaceGenerator (r : ℕ) (τ : Fin (r + 1) → ℂ) (i : Fin (r + 1)) : ConvergentGerm :=
  ∏ j ∈ Finset.univ.erase i, expArcGerm (τ j)

/-- The physical characteristic pullback ideal in the convergent germ ring. -/
def convergentCofaceIdeal (r : ℕ) (τ : Fin (r + 1) → ℂ) : Ideal ConvergentGerm :=
  Ideal.span (Set.range (convergentCofaceGenerator r τ))

theorem convergentCofaceGenerator_eq_unitScaled (r : ℕ) (τ : Fin (r + 1) → ℂ)
    (hτ : ∀ j, τ j ≠ 0) :
    convergentCofaceGenerator r τ =
      unitScaledCofaceGenerator r convergentCoordinate
        (fun j => expArcUnitGermUnit (τ j) (hτ j)) := by
  funext i
  rw [convergentCofaceGenerator, unitScaledCofaceGenerator]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [expArcGerm_eq_coordinate_mul, coe_expArcUnitGermUnit]

/-- **The convergent physical fat point.**  With no vanishing period the physical pullback of the
squarefree coface ideal along the genuine exponential clock is exactly `(λ^r)` in `ℂ{λ}`. -/
theorem convergentCofaceIdeal_eq_span_pow (r : ℕ) (τ : Fin (r + 1) → ℂ) (hτ : ∀ j, τ j ≠ 0) :
    convergentCofaceIdeal r τ =
      Ideal.span ({convergentCoordinate ^ r} : Set ConvergentGerm) := by
  rw [convergentCofaceIdeal, convergentCofaceGenerator_eq_unitScaled r τ hτ]
  exact unitScaledCofaceIdeal_eq_span_pow r convergentCoordinate
    (fun j => expArcUnitGermUnit (τ j) (hτ j))

/-! ## `ℂ{λ}` is a discrete valuation ring -/

theorem exists_analytic_repr (x : ConvergentGerm) :
    ∃ (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0), x = germOfAnalytic f hf := by
  obtain ⟨g, f, hf, rfl⟩ := x
  exact ⟨f, hf, rfl⟩

theorem germOfAnalytic_eq_zero_iff {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) :
    germOfAnalytic f hf = 0 ↔ ∀ᶠ z in 𝓝 (0 : ℂ), f z = 0 := by
  rw [Subtype.ext_iff]
  show ((f : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) = 0 ↔ _
  rw [← Germ.coe_zero, Germ.coe_eq]
  rfl

theorem germOfAnalytic_pow {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) (n : ℕ) :
    germOfAnalytic f hf ^ n = germOfAnalytic (f ^ n) (hf.pow n) :=
  Subtype.ext (Germ.coe_pow f n).symm

theorem convergentCoordinate_pow (n : ℕ) :
    convergentCoordinate ^ n = germOfAnalytic (fun z : ℂ => z ^ n) (analyticAt_id.pow n) :=
  germOfAnalytic_pow analyticAt_id n

instance : Nontrivial ConvergentGerm := by
  refine ⟨0, 1, fun h => ?_⟩
  have hval : ((0 : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) = ((1 : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) := by
    rw [Germ.coe_zero, Germ.coe_one]
    exact congrArg Subtype.val h
  exact zero_ne_one (Germ.coe_eq.mp hval).self_of_nhds

instance : NoZeroDivisors ConvergentGerm := by
  refine ⟨fun {x y} hxy => ?_⟩
  obtain ⟨f, hf, rfl⟩ := exists_analytic_repr x
  obtain ⟨g, hg, rfl⟩ := exists_analytic_repr y
  by_cases hx : ∀ᶠ z in 𝓝 (0 : ℂ), f z = 0
  · exact Or.inl ((germOfAnalytic_eq_zero_iff hf).mpr hx)
  refine Or.inr ((germOfAnalytic_eq_zero_iff hg).mpr ?_)
  have hprod : ∀ᶠ z in 𝓝 (0 : ℂ), f z * g z = 0 := by
    have := (germOfAnalytic_eq_zero_iff (hf.mul hg)).mp
      (by rw [germOfAnalytic_mul]; exact hxy)
    exact this
  have hfne : ∀ᶠ z in 𝓝[≠] (0 : ℂ), f z ≠ 0 :=
    hf.eventually_eq_zero_or_eventually_ne_zero.resolve_left hx
  have hgz : ∀ᶠ z in 𝓝[≠] (0 : ℂ), g z = 0 := by
    filter_upwards [hfne, nhdsWithin_le_nhds hprod] with z hz hzp
    exact (mul_eq_zero.mp hzp).resolve_left hz
  have hg0 : g 0 = 0 := by
    refine tendsto_nhds_unique (f := g) (l := 𝓝[≠] (0 : ℂ))
      hg.continuousAt.continuousWithinAt.tendsto ?_
    exact Tendsto.congr' (hgz.mono fun z hz => hz.symm) tendsto_const_nhds
  filter_upwards [eventually_nhdsWithin_iff.mp hgz] with z hz
  by_cases hz0 : z = 0
  · rw [hz0]; exact hg0
  · exact hz hz0

instance : IsDomain ConvergentGerm := NoZeroDivisors.to_isDomain _

theorem not_isUnit_convergentCoordinate : ¬ IsUnit convergentCoordinate := by
  rintro hu
  obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp hu
  obtain ⟨g, hg, rfl⟩ := exists_analytic_repr b
  have hval : ((id * g : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) = ((1 : ℂ → ℂ) : Germ (𝓝 (0 : ℂ)) ℂ) := by
    rw [Germ.coe_mul, Germ.coe_one]
    exact congrArg Subtype.val hb
  have := (Germ.coe_eq.mp hval).self_of_nhds
  simp only [Pi.mul_apply, id_eq, Pi.one_apply, zero_mul] at this
  exact zero_ne_one this

/-- **Every nonzero convergent germ is a coordinate power times a unit.** -/
theorem exists_pow_mul_isUnit (x : ConvergentGerm) (hx : x ≠ 0) :
    ∃ (n : ℕ) (u : ConvergentGerm), IsUnit u ∧ x = convergentCoordinate ^ n * u := by
  obtain ⟨f, hf, rfl⟩ := exists_analytic_repr x
  have hne : ¬ ∀ᶠ z in 𝓝 (0 : ℂ), f z = 0 := fun h => hx ((germOfAnalytic_eq_zero_iff hf).mpr h)
  obtain ⟨n, g, hg, hg0, heq⟩ := hf.exists_eventuallyEq_pow_smul_nonzero_iff.mpr hne
  refine ⟨n, germOfAnalytic g hg, isUnit_germOfAnalytic hg hg0, ?_⟩
  rw [convergentCoordinate_pow, ← germOfAnalytic_mul]
  refine germOfAnalytic_congr hf _ ?_
  filter_upwards [heq] with z hz
  simpa [sub_zero, smul_eq_mul] using hz

theorem associated_convergentCoordinate_pow (x : ConvergentGerm) (hx : x ≠ 0) :
    ∃ n : ℕ, Associated (convergentCoordinate ^ n) x := by
  obtain ⟨n, u, hu, rfl⟩ := exists_pow_mul_isUnit x hx
  exact ⟨n, hu.unit, by rw [hu.unit_spec]⟩

theorem convergentCoordinate_ne_zero : convergentCoordinate ≠ 0 := by
  rw [convergentCoordinate, Ne, germOfAnalytic_eq_zero_iff]
  intro h
  have h1 : ∀ᶠ z in 𝓝 (0 : ℂ), z = 0 := h
  have hne : ∀ᶠ z in 𝓝[≠] (0 : ℂ), z ≠ 0 := eventually_mem_nhdsWithin
  exact (hne.and (nhdsWithin_le_nhds h1)).exists.elim fun z hz => hz.1 hz.2

/-- **The coordinate is irreducible in `ℂ{λ}`.** -/
theorem irreducible_convergentCoordinate : Irreducible convergentCoordinate := by
  refine ⟨not_isUnit_convergentCoordinate, ?_⟩
  intro a b hab
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact convergentCoordinate_ne_zero (by rw [hab, zero_mul])
  have hb0 : b ≠ 0 := by
    rintro rfl
    exact convergentCoordinate_ne_zero (by rw [hab, mul_zero])
  obtain ⟨m, u, hu, rfl⟩ := exists_pow_mul_isUnit a ha0
  obtain ⟨k, v, hv, rfl⟩ := exists_pow_mul_isUnit b hb0
  have hcw : convergentCoordinate = convergentCoordinate ^ (m + k) * (u * v) :=
    hab.trans (by ring)
  match hmk : m + k with
  | 0 =>
      refine absurd ?_ not_isUnit_convergentCoordinate
      have hcu : convergentCoordinate = u * v := by rw [hcw, hmk, pow_zero, one_mul]
      rw [hcu]
      exact hu.mul hv
  | (s + 1) =>
      have hstep : convergentCoordinate * 1 =
          convergentCoordinate * (convergentCoordinate ^ s * (u * v)) := by
        rw [mul_one]
        refine hcw.trans ?_
        rw [hmk, Nat.succ_eq_add_one, pow_succ]
        ring
      have h1 : (1 : ConvergentGerm) = convergentCoordinate ^ s * (u * v) :=
        mul_left_cancel₀ convergentCoordinate_ne_zero hstep
      match s, h1 with
      | 0, h1 =>
          have hmk1 : m + k = 1 := hmk
          rcases Nat.add_eq_one_iff.mp hmk1 with ⟨hm, _⟩ | ⟨_, hk⟩
          · exact Or.inl (by rw [hm, pow_zero, one_mul]; exact hu)
          · exact Or.inr (by rw [hk, pow_zero, one_mul]; exact hv)
      | (t + 1), h1 =>
          have hone : convergentCoordinate * (convergentCoordinate ^ t * (u * v)) = 1 :=
            (by ring : convergentCoordinate * (convergentCoordinate ^ t * (u * v))
              = convergentCoordinate ^ (t + 1) * (u * v)).trans h1.symm
          exact absurd (IsUnit.of_mul_eq_one _ hone) not_isUnit_convergentCoordinate

instance : IsDiscreteValuationRing ConvergentGerm :=
  IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    ⟨convergentCoordinate, irreducible_convergentCoordinate,
      fun {x} hx => associated_convergentCoordinate_pow x hx⟩

theorem maximalIdeal_eq_span_convergentCoordinate :
    IsLocalRing.maximalIdeal ConvergentGerm = Ideal.span {convergentCoordinate} :=
  (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp irreducible_convergentCoordinate

/-- **The convergent physical fat point has length `r`.** -/
theorem convergentCofaceIdeal_quotient_length (r : ℕ) (τ : Fin (r + 1) → ℂ)
    (hτ : ∀ j, τ j ≠ 0) :
    Module.length ConvergentGerm (ConvergentGerm ⧸ convergentCofaceIdeal r τ) = r := by
  rw [convergentCofaceIdeal_eq_span_pow r τ hτ, ← Ideal.span_singleton_pow,
    ← maximalIdeal_eq_span_convergentCoordinate]
  exact IsDiscreteValuationRing.length_quotient_pow_maximalIdeal ConvergentGerm r

/-- Linear independence of the source frame supplies the nonvanishing hypothesis. -/
theorem convergentCofaceIdeal_eq_span_pow_of_linearIndependent
    (r : ℕ) (τ : Fin (r + 1) → ℂ) (hτ : LinearIndependent ℚ τ) :
    convergentCofaceIdeal r τ =
      Ideal.span ({convergentCoordinate ^ r} : Set ConvergentGerm) :=
  convergentCofaceIdeal_eq_span_pow r τ fun j => hτ.ne_zero j

/-! ## The convergent derived pullback -/

/-- The unit family of the genuine exponential clock at a nonvanishing source frame. -/
def convergentExpArcUnits (r : ℕ) (τ : Fin (r + 1) → ℂ) (hτ : ∀ j, τ j ≠ 0) :
    Fin (r + 1) → ConvergentGermˣ :=
  fun j => expArcUnitGermUnit (τ j) (hτ j)

theorem convergentCofaceGenerator_eq_unitScaled' (r : ℕ) (τ : Fin (r + 1) → ℂ)
    (hτ : ∀ j, τ j ≠ 0) :
    convergentCofaceGenerator r τ =
      unitScaledCofaceGenerator r convergentCoordinate (convergentExpArcUnits r τ hτ) :=
  convergentCofaceGenerator_eq_unitScaled r τ hτ

/-- **The convergent coface row reduces to `(λ^r, 0, …, 0)`.** -/
theorem convergentCofaceKoszulRowEquiv_functional (r : ℕ) (τ : Fin (r + 1) → ℂ)
    (hτ : ∀ j, τ j ≠ 0) :
    (physicalCofaceFunctional (convergentCofaceGenerator r τ)).comp
        (unitScaledCofaceKoszulRowEquiv r (convergentExpArcUnits r τ hτ)).toLinearMap =
      physicalCofaceFunctional
        (fun i => if i = 0 then convergentCoordinate ^ r else 0) := by
  rw [convergentCofaceGenerator_eq_unitScaled' r τ hτ]
  exact unitScaledCofaceKoszulRowEquiv_functional r convergentCoordinate
    (convergentExpArcUnits r τ hτ)

/-- **The convergent Koszul complex is chain equivalent to the fat-point complex.** -/
theorem convergentCofaceKoszulChainEquiv_commutes (r k : ℕ) (τ : Fin (r + 1) → ℂ)
    (hτ : ∀ j, τ j ≠ 0) :
    (physicalKoszulDifferential k
        (physicalCofaceFunctional (convergentCofaceGenerator r τ))).comp
        (unitScaledCofaceKoszulChainEquiv r (k + 1)
          (convergentExpArcUnits r τ hτ)).toLinearMap =
      (unitScaledCofaceKoszulChainEquiv r k
        (convergentExpArcUnits r τ hτ)).toLinearMap.comp
        (physicalKoszulDifferential k
          (physicalCofaceFunctional
            (fun i => if i = 0 then convergentCoordinate ^ r else 0))) := by
  rw [convergentCofaceGenerator_eq_unitScaled' r τ hτ]
  exact unitScaledCofaceKoszulChainEquiv_commutes r k convergentCoordinate
    (convergentExpArcUnits r τ hτ)

/-! ## The convergent Koszul homology lengths -/

/-- In `ℂ{λ}` the row-reduced degree-`k` homology of the physical Koszul complex has length
`r * choose(r,k)`. -/
theorem convergentGerm_rowReducedPhysicalKoszulHomology_length (r k : ℕ) :
    Module.length ConvergentGerm
        (physicalKoszulSurvivingBasis r k →
          ConvergentGerm ⧸
            Ideal.span ({convergentCoordinate ^ r} : Set ConvergentGerm)) =
      (r * Nat.choose r k : ℕ) := by
  rw [Module.length_pi, ENat.card_eq_coe_natCard, card_physicalKoszulSurvivingBasis,
    ← Ideal.span_singleton_pow, ← maximalIdeal_eq_span_convergentCoordinate,
    IsDiscreteValuationRing.length_quotient_pow_maximalIdeal ConvergentGerm r, mul_comm]
  norm_cast

/-- **The total convergent homology length is `r 2^r`.** -/
theorem convergentGerm_rowReducedPhysicalKoszulHomology_totalLength (r : ℕ) :
    (∑ k ∈ Finset.range (r + 1),
      Module.length ConvergentGerm
        (physicalKoszulSurvivingBasis r k →
          ConvergentGerm ⧸
            Ideal.span ({convergentCoordinate ^ r} : Set ConvergentGerm))) =
      (r * 2 ^ r : ℕ) := by
  simp_rw [convergentGerm_rowReducedPhysicalKoszulHomology_length]
  norm_cast
  rw [← Finset.mul_sum, Nat.sum_range_choose]

end

end GaloisForLFunctions
