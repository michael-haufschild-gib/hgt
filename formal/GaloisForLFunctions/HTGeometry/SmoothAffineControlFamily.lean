import GaloisForLFunctions.HTGeometry.ClassicalStratifiedParametricAvoidance

/-!
# Smooth affine finite-probe families

Parametric transversality is applied only after the infinite-dimensional perturbation problem has
been compressed to a finite-dimensional probe.  The resulting family has the universal form

`F(v, h) = base(h) + direction(h) v`.

This file proves the exact differential statement consumed by the classical avoidance interface:
if `base` and `direction` are smooth, then `F` is smooth, and its derivative in the probe variable
is exactly `direction(h)`.  Thus the uniform finite-probe surjectivity theorem gives the required
submersion without any additional differential-topology assumption.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

/-- The affine family generated by a base map and a varying continuous-linear probe. -/
def smoothAffineControlFamily
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (base : H → Y) (direction : H → (P →L[ℝ] Y)) : P × H → Y :=
  fun p => base p.2 + direction p.2 p.1

/-- Smooth base and direction data produce a smooth affine probe family. -/
theorem contDiff_smoothAffineControlFamily
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    {n : WithTop ℕ∞}
    {base : H → Y} {direction : H → (P →L[ℝ] Y)}
    (hbase : ContDiff ℝ n base) (hdirection : ContDiff ℝ n direction) :
    ContDiff ℝ n (smoothAffineControlFamily base direction) := by
  exact (hbase.comp contDiff_snd).add
    ((hdirection.comp contDiff_snd).clm_apply contDiff_fst)

/-- Local form on an open configuration set.  No regularity away from the patch is required. -/
theorem contDiffOn_smoothAffineControlFamily
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    {n : WithTop ℕ∞}
    {base : H → Y} {direction : H → (P →L[ℝ] Y)} {U : Set H}
    (hbase : ContDiffOn ℝ n base U)
    (hdirection : ContDiffOn ℝ n direction U) :
    ContDiffOn ℝ n (smoothAffineControlFamily base direction) (Set.univ ×ˢ U) := by
  have hbase' : ContDiffOn ℝ n (fun p : P × H => base p.2) (Set.univ ×ˢ U) :=
    hbase.comp contDiff_snd.contDiffOn (fun p hp => hp.2)
  have hdirection' : ContDiffOn ℝ n
      (fun p : P × H => direction p.2) (Set.univ ×ˢ U) :=
    hdirection.comp contDiff_snd.contDiffOn (fun p hp => hp.2)
  exact hbase'.add (hdirection'.clm_apply contDiff_fst.contDiffOn)

/-- At fixed configuration `h`, the derivative in the probe variable is exactly the probe
operator. -/
theorem hasFDerivAt_smoothAffineControlFamily_probe
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (base : H → Y) (direction : H → (P →L[ℝ] Y))
    (p : P) (h : H) :
    HasFDerivAt (fun v => smoothAffineControlFamily base direction (v, h))
      (direction h) p := by
  simpa only [smoothAffineControlFamily] using
    (direction h).hasFDerivAt.const_add (base h)

/-- The Fréchet derivative in the finite-probe direction is the supplied control map. -/
theorem fderiv_smoothAffineControlFamily_probe
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (base : H → Y) (direction : H → (P →L[ℝ] Y))
    (p : P) (h : H) :
    fderiv ℝ (fun v => smoothAffineControlFamily base direction (v, h)) p =
      direction h :=
  (hasFDerivAt_smoothAffineControlFamily_probe base direction p h).fderiv

/-- Surjectivity of the finite probe is precisely the submersion hypothesis required by
parametric avoidance. -/
theorem surjective_fderiv_smoothAffineControlFamily_probe
    {P H Y : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (base : H → Y) (direction : H → (P →L[ℝ] Y))
    (hDirection : ∀ h, Function.Surjective (direction h))
    (p : P) (h : H) :
    Function.Surjective
      (fderiv ℝ (fun v => smoothAffineControlFamily base direction (v, h)) p) := by
  rw [fderiv_smoothAffineControlFamily_probe]
  exact hDirection h

/-- If every ambient center admits dense compact avoidance by perturbations from one submodule,
then compact avoidance is dense in the full ambient parameter space. -/
theorem dense_compactConfigurationAvoidance_of_dense_submodule_perturbations
    {X H Y : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (V : Submodule ℝ X)
    (base : H → Y) (direction : H → (X →L[ℝ] Y))
    (bad : Set Y) (K : Set H)
    (hdense : ∀ center : X,
      Dense (compactConfigurationAvoidance
        (smoothAffineControlFamily
          (fun h => base h + direction h center)
          (fun h => (direction h).domRestrict V)) bad K)) :
    Dense (compactConfigurationAvoidance
      (smoothAffineControlFamily base direction) bad K) := by
  rw [Metric.dense_iff]
  intro center r hr
  obtain ⟨v, hvball, hvgood⟩ :=
    (Metric.dense_iff.mp (hdense center) 0 r hr)
  refine ⟨center + (v : X), ?_, ?_⟩
  · simpa [Metric.mem_ball, dist_eq_norm] using hvball
  · intro h hh
    have hv := hvgood h hh
    simpa only [smoothAffineControlFamily, map_add,
      ContinuousLinearMap.domRestrict_apply, add_assoc] using hv

end

end GaloisForLFunctions.HTGeometry
