import GaloisForLFunctions.HTGeometry.UniversalFirstOrderEntireCascadeUnitCost
import GaloisForLFunctions.HTGeometry.BigradedCorank

/-!
# From joint clock independence to independence over the rational coordinate field

The differential-order lower bound is stated over `ℂ(z)`, while a geometric observability
calculation naturally proves independence over `ℂ` after retaining the clock as one extra
coordinate.  This module identifies those statements inside the actual global meromorphic field.
No disjointness premise is needed: the tower law for algebraic independence first changes the base
to the field generated by the clock, and the canonical copy of `RatFunc ℂ` lies in that field.
-/

open Filter Set Topology
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

local instance cascadeRationalBaseDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ
    Set.univ_nonempty

noncomputable local instance cascadeRationalBaseRatFuncAlgebra :
    Algebra (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  (ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).toAlgebra

noncomputable local instance cascadeRationalBaseComplexAlgebra :
    Algebra ℂ (meroField (Set.univ : Set ℂ)) :=
  ((ratfuncToMero (Set.univ : Set ℂ) isOpen_univ isPreconnected_univ Set.univ_nonempty
    Set.infinite_univ).comp (algebraMap ℂ (RatFunc ℂ))).toAlgebra

local instance cascadeRationalBaseScalarTower :
    IsScalarTower ℂ (RatFunc ℂ) (meroField (Set.univ : Set ℂ)) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

set_option synthInstance.maxHeartbeats 1000000 in
/-- **Clock adjunction is exactly the rational-coordinate base for independence.**

If the clock and a family `x` are jointly algebraically independent over `ℂ`, then `x` is
algebraically independent over the canonical `ℂ(z)` inside the global meromorphic field.  The
`Sum` order puts `x` on the left and the singleton clock on the right, matching the generated-field
tower theorem used in the proof. -/
theorem algebraicIndependent_over_ratFunc_of_clock_sum
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    {I : Type*} (x : I → meroField (Set.univ : Set ℂ))
    (hjoint : AlgebraicIndependent ℂ
      (Sum.elim x (fun _ : Unit => cascadeMero hfan 0))) :
    AlgebraicIndependent (RatFunc ℂ) x := by
  let M := meroField (Set.univ : Set ℂ)
  let z : M := cascadeMero hfan 0
  let E := IntermediateField.adjoin ℂ ({z} : Set M)
  have hE : AlgebraicIndependent E x := by
    have h := (GaloisForLFunctions.algebraicIndependent_sumElim_intermediateField_iff
      (fun _ : Unit => z) x).mp hjoint
    have hrange : Set.range (fun _ : Unit => z) = ({z} : Set M) := by
      ext y
      simp
    rw [hrange] at h
    exact h.2
  let phi : RatFunc ℂ →ₐ[ℂ] E :=
    { toFun := fun q => ⟨algebraMap (RatFunc ℂ) M q,
          algebraMap_ratFunc_mem_adjoin_cascadeMero_zero hfan q⟩
      map_one' := by
        apply Subtype.ext
        exact map_one (algebraMap (RatFunc ℂ) M)
      map_mul' := by
        intro a b
        apply Subtype.ext
        exact map_mul (algebraMap (RatFunc ℂ) M) a b
      map_zero' := by
        apply Subtype.ext
        exact map_zero (algebraMap (RatFunc ℂ) M)
      map_add' := by
        intro a b
        apply Subtype.ext
        exact map_add (algebraMap (RatFunc ℂ) M) a b
      commutes' := fun c => Subtype.ext (by
        change algebraMap (RatFunc ℂ) M (algebraMap ℂ (RatFunc ℂ) c) = algebraMap ℂ M c
        exact IsScalarTower.algebraMap_apply ℂ (RatFunc ℂ) M c) }
  letI : Algebra (RatFunc ℂ) E := phi.toAlgebra
  letI : IsScalarTower (RatFunc ℂ) E M :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact hE.restrictScalars (algebraMap (RatFunc ℂ) E).injective

/-- Option-indexed form of `algebraicIndependent_over_ratFunc_of_clock_sum`.  Here `none` is the
clock and `some i` is `x i`, matching `AlgebraicIndependent.option_iff_transcendental`. -/
theorem algebraicIndependent_over_ratFunc_of_clock_option
    {f : ℕ → ℂ → ℂ} (hfan : ∀ i : ℕ, AnalyticOnNhd ℂ (f i) Set.univ)
    {I : Type*} (x : I → meroField (Set.univ : Set ℂ))
    (hjoint : AlgebraicIndependent ℂ
      (fun o : Option I => o.elim (cascadeMero hfan 0) x)) :
    AlgebraicIndependent (RatFunc ℂ) x := by
  let e : I ⊕ Unit ≃ Option I :=
    { toFun := fun s => Sum.elim some (fun _ => none) s
      invFun := fun o => o.elim (Sum.inr ()) Sum.inl
      left_inv := by
        intro s
        rcases s with i | u
        · rfl
        · rcases u
          rfl
      right_inv := by
        intro o
        rcases o with _ | i <;> rfl }
  have hsum : AlgebraicIndependent ℂ
      (Sum.elim x (fun _ : Unit => cascadeMero hfan 0)) := by
    have h := hjoint.comp e e.injective
    convert h using 1
    funext s
    rcases s with i | u
    · rfl
    · rcases u
      rfl
  exact algebraicIndependent_over_ratFunc_of_clock_sum hfan x hsum

end

end GaloisForLFunctions.HTGeometry
