import GaloisForLFunctions.HTGeometry.FiniteClockOrthogonalObservability

/-!
# Finite-clock resolution variance

A clock generated by `U ^ d` resolves only the subgroup-invariant part of an observable.  Refining
that subclock to the full clock generated by `U` gives a nested pair of orthogonal conditional
expectations.  This file proves the corresponding exact law of total observability variance:

`full clock loss = subclock loss + resolution-gap loss`.

The result concerns a static hierarchy of observer algebras.  Neither the factor `d` nor the
finite period is interpreted as temporal evolution.
-/

namespace HTGeometry

noncomputable section

section Linear

variable {𝕜 E : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- A vector fixed by one clock step is fixed by every finite power of that step. -/
theorem pow_apply_eq_self_of_apply_eq_self
    (U : E →L[𝕜] E) {x : E} (hUx : U x = x) (d : ℕ) :
    (U ^ d) x = x := by
  induction d with
  | zero => simp
  | succ d ih =>
      rw [pow_succ, mul_apply_eq_comp, hUx, ih]

/-- The subclock average absorbs the full-clock average because every `U`-stationary vector is
also `U ^ d`-stationary.  No adjoint or commutativity hypothesis is needed. -/
theorem finiteCyclicGaugeAverage_pow_absorbs
    (U : E →L[𝕜] E) (N d M : ℕ) (hM : M ≠ 0)
    (hperiod : U ^ N = 1) :
    finiteCyclicGaugeAverage (U ^ d) M * finiteCyclicGaugeAverage U N =
      finiteCyclicGaugeAverage U N := by
  ext x
  let P : E →L[𝕜] E := finiteCyclicGaugeAverage U N
  have hphysical := finiteCyclicGaugeAverage_physical U N hperiod x
  have hUfix : U (P x) = P x := by
    rw [GaloisForLFunctions.PhysicalState] at hphysical
    change (U - 1) (P x) = 0 at hphysical
    simpa only [_root_.sub_apply, one_apply_eq_self,
      sub_eq_zero] using hphysical
  have hpowfix : (U ^ d) (P x) = P x :=
    pow_apply_eq_self_of_apply_eq_self U hUfix d
  change finiteCyclicGaugeAverage (U ^ d) M (P x) = P x
  exact finiteCyclicGaugeAverage_apply_of_fixed (U ^ d) M hM hpowfix

/-- Twirling at the full clock resolution already produces an observable invariant under every
power subclock.  This is one half of the conditional-expectation tower law. -/
theorem finiteCyclicObservableTwirl_pow_fixes_fullTwirl
    (U X : E →L[𝕜] E) (d M : ℕ) (hM : M ≠ 0)
    (hperiod : U ^ (d * M) = 1) :
    finiteCyclicObservableTwirl (U ^ d)
        (finiteCyclicObservableTwirl U X (d * M)) M =
      finiteCyclicObservableTwirl U X (d * M) := by
  have hsubperiod : (U ^ d) ^ M = 1 := by
    rw [← pow_mul]
    exact hperiod
  have hcommU : Commute U (finiteCyclicObservableTwirl U X (d * M)) :=
    finiteCyclicObservableTwirl_commutes U X (d * M) hperiod
  exact finiteCyclicObservableTwirl_eq_self_of_commutes
    (U ^ d) (finiteCyclicObservableTwirl U X (d * M)) M hM hsubperiod
      (hcommU.pow_left d).eq

end Linear

section Hilbert

variable {𝕜 E : Type*} [RCLike 𝕜]
  [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

/-- Every power of an isometry is again an isometry, stated in the adjoint form used by the
finite-clock API. -/
theorem adjoint_pow_mul_pow_eq_one_of_adjoint_mul_self
    (U : E →L[𝕜] E) (d : ℕ) (hU : U.adjoint * U = 1) :
    (U ^ d).adjoint * U ^ d = 1 := by
  induction d with
  | zero => simp
  | succ d ih =>
      have ih' : U.adjoint ^ d * U ^ d = 1 := by
        simpa only [← ContinuousLinearMap.star_eq_adjoint, star_pow] using ih
      rw [show (U ^ (d + 1)).adjoint = U.adjoint ^ (d + 1) by
        simp only [← ContinuousLinearMap.star_eq_adjoint, star_pow]]
      rw [pow_succ' U.adjoint d, pow_succ U d]
      calc
        (U.adjoint * U.adjoint ^ d) * (U ^ d * U) =
            U.adjoint * (U.adjoint ^ d * U ^ d) * U := by
              simp only [mul_assoc]
        _ = U.adjoint * U := by rw [ih']; simp
        _ = 1 := hU

/-- Orthogonal law of total variance for nested projections.  `Q * P = P` says that the range of
`P` is contained in the range of `Q`; the loss outside `P` splits into loss outside `Q` and the
orthogonal resolution layer between them. -/
theorem nestedOrthogonalProjection_complement_energy_partition
    (P Q : E →L[𝕜] E)
    (hQadj : Q.adjoint = Q) (hQ2 : Q * Q = Q) (hQP : Q * P = P)
    (x : E) :
    ‖(1 - P) x‖ ^ 2 = ‖(1 - Q) x‖ ^ 2 + ‖(Q - P) x‖ ^ 2 := by
  have hQgap : Q ((Q - P) x) = (Q - P) x := by
    rw [← mul_apply_eq_comp]
    congr 1
    noncomm_ring [hQ2, hQP]
  have hQouter : Q ((1 - Q) x) = 0 := by
    rw [← mul_apply_eq_comp]
    have : Q * (1 - Q) = 0 := by noncomm_ring [hQ2]
    rw [this]
    simp
  have horth : inner 𝕜 ((Q - P) x) ((1 - Q) x) = 0 := by
    calc
      inner 𝕜 ((Q - P) x) ((1 - Q) x) =
          inner 𝕜 (Q ((Q - P) x)) ((1 - Q) x) := by rw [hQgap]
      _ = inner 𝕜 ((Q - P) x) (Q.adjoint ((1 - Q) x)) :=
        (Q.adjoint_inner_right ((Q - P) x) ((1 - Q) x)).symm
      _ = inner 𝕜 ((Q - P) x) (Q ((1 - Q) x)) := by rw [hQadj]
      _ = 0 := by rw [hQouter, inner_zero_right]
  have hsum : (Q - P) x + (1 - Q) x = (1 - P) x := by
    simp only [_root_.sub_apply, one_apply_eq_self]
    module
  rw [← hsum]
  have hpyth := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero
    ((Q - P) x) ((1 - Q) x) horth
  simpa only [pow_two, add_comm] using hpyth

/-- **Finite-clock resolution energy partition.**  The component erased by the full `U` clock
is the orthogonal sum of the component erased by the `U ^ d` subclock and the refinement layer
between the two invariant sectors. -/
theorem finiteClockResolution_energy_partition
    (U : E →L[𝕜] E) (d M : ℕ) (hM : M ≠ 0)
    (hadjoint_mul : U.adjoint * U = 1) (hperiod : U ^ (d * M) = 1)
    (x : E) :
    ‖(1 - finiteCyclicGaugeAverage U (d * M)) x‖ ^ 2 =
      ‖(1 - finiteCyclicGaugeAverage (U ^ d) M) x‖ ^ 2 +
        ‖(finiteCyclicGaugeAverage (U ^ d) M -
          finiteCyclicGaugeAverage U (d * M)) x‖ ^ 2 := by
  let P : E →L[𝕜] E := finiteCyclicGaugeAverage U (d * M)
  let Q : E →L[𝕜] E := finiteCyclicGaugeAverage (U ^ d) M
  have hsubadjoint : (U ^ d).adjoint * U ^ d = 1 :=
    adjoint_pow_mul_pow_eq_one_of_adjoint_mul_self U d hadjoint_mul
  have hsubperiod : (U ^ d) ^ M = 1 := by
    rw [← pow_mul]
    exact hperiod
  have hQadj : Q.adjoint = Q := by
    simpa only [Q, ContinuousLinearMap.star_eq_adjoint] using
      (finiteCyclicGaugeAverage_isSelfAdjoint_of_periodic_isometry
        (U ^ d) M hM hsubadjoint hsubperiod).star_eq
  have hQ2 : Q * Q = Q :=
    finiteCyclicGaugeAverage_idempotent (U ^ d) M hM hsubperiod
  have hQP : Q * P = P :=
    finiteCyclicGaugeAverage_pow_absorbs U (d * M) d M hM hperiod
  exact nestedOrthogonalProjection_complement_energy_partition P Q hQadj hQ2 hQP x

/-- **Law of total finite-clock observability variance.**  On a stationary state, the full-clock
Kadison defect is the subclock defect plus the exact squared norm of the observable value revealed
only by refining the clock resolution. -/
theorem finiteClockResolution_observabilityVariance
    (U X : E →L[𝕜] E) (d M : ℕ) (hd : d ≠ 0) (hM : M ≠ 0)
    (hadjoint_mul : U.adjoint * U = 1) (hperiod : U ^ (d * M) = 1)
    (hX : IsSelfAdjoint X) {ψ : E} (hψ : U ψ = ψ) :
    RCLike.re
        (inner 𝕜 ψ
          (finiteCyclicObservableTwirlKadisonDefect U X (d * M) ψ)) =
      RCLike.re
          (inner 𝕜 ψ
            (finiteCyclicObservableTwirlKadisonDefect (U ^ d) X M ψ)) +
        ‖(finiteCyclicGaugeAverage (U ^ d) M -
          finiteCyclicGaugeAverage U (d * M)) (X ψ)‖ ^ 2 := by
  have hfullN : d * M ≠ 0 := Nat.mul_ne_zero hd hM
  have hsubadjoint : (U ^ d).adjoint * U ^ d = 1 :=
    adjoint_pow_mul_pow_eq_one_of_adjoint_mul_self U d hadjoint_mul
  have hsubperiod : (U ^ d) ^ M = 1 := by
    rw [← pow_mul]
    exact hperiod
  have hsubψ : (U ^ d) ψ = ψ :=
    pow_apply_eq_self_of_apply_eq_self U hψ d
  rw [re_inner_finiteCyclicObservableTwirlKadisonDefect_eq_erasedNormSq
      U X (d * M) hfullN hadjoint_mul hperiod hX hψ,
    re_inner_finiteCyclicObservableTwirlKadisonDefect_eq_erasedNormSq
      (U ^ d) X M hM hsubadjoint hsubperiod hX hsubψ]
  exact finiteClockResolution_energy_partition
    U d M hM hadjoint_mul hperiod (X ψ)

end Hilbert

end


end HTGeometry
