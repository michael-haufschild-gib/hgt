import GaloisForLFunctions.HTGeometry.FermatCubicQuantumMultinomial
import GaloisForLFunctions.HTGeometry.GeneralizedCliffordPrincipalSymbolLaw
import Mathlib.Tactic.FinCases

/-!
# Fermat cubic generalized-Clifford horizon

Three cubic root-of-unity endomorphisms define a linear pencil whose cube is the Fermat cubic
form.  The generalized-Clifford shift suspension turns that pencil into an exact rational
differential-field horizon.  This is the abstract representation theorem; construction of the
canonical three-dimensional Weyl representation is separated from the horizon mechanism.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

universe u v

variable {K : Type u} {M : Type v}
  [Field K] [AddCommGroup M] [Module K M]

/-- The ternary Fermat cubic form. -/
def fermatCubicPotential (c : Fin 3 → K) : K :=
  c 0 ^ (3 : ℕ) + c 1 ^ (3 : ℕ) + c 2 ^ (3 : ℕ)

/-- The linear pencil generated by three internal cubic Clifford operators. -/
def fermatCubicSymbol (X Y Z : Module.End K M) :
    (Fin 3 → K) →ₗ[K] Module.End K M :=
  Fintype.linearCombination K ![X, Y, Z]

@[simp]
theorem fermatCubicSymbol_apply
    (X Y Z : Module.End K M) (c : Fin 3 → K) :
    fermatCubicSymbol X Y Z c = c 0 • X + c 1 • Y + c 2 • Z := by
  simp [fermatCubicSymbol, Fintype.linearCombination_apply, Fin.sum_univ_three]

/-- The cubic Clifford relations give the pointwise Roby power identity for the Fermat form. -/
theorem fermatCubicSymbol_pow_three
    (ω : K) (X Y Z : Module.End K M)
    (hω : ω ^ (2 : ℕ) + ω + 1 = 0)
    (hX3 : X ^ (3 : ℕ) = 1) (hY3 : Y ^ (3 : ℕ) = 1) (hZ3 : Z ^ (3 : ℕ) = 1)
    (hXY : X * Y = ω • (Y * X))
    (hXZ : X * Z = ω • (Z * X))
    (hYZ : Y * Z = ω • (Z * Y))
    (c : Fin 3 → K) :
    (fermatCubicSymbol X Y Z c) ^ (3 : ℕ) =
      fermatCubicPotential c • LinearMap.id := by
  rw [fermatCubicSymbol_apply]
  exact quantumFermatCubic_endomorphism
    ω (c 0) (c 1) (c 2) X Y Z hω hX3 hY3 hZ3 hXY hXZ hYZ

/-- **Exact abstract Fermat-cubic field horizon.**  Any cubic Clifford triple produces a
rational differential field whose complete root jet is dependent exactly on the Fermat cubic. -/
theorem fermatCubicShiftField_dependenceHorizon_eq
    (ω : K) (X Y Z : Module.End K M)
    (hω : ω ^ (2 : ℕ) + ω + 1 = 0)
    (hX3 : X ^ (3 : ℕ) = 1) (hY3 : Y ^ (3 : ℕ) = 1) (hZ3 : Z ^ (3 : ℕ) = 1)
    (hXY : X * Y = ω • (Y * X))
    (hXZ : X * Z = ω • (Z * X))
    (hYZ : Y * Z = ω • (Z * Y))
    (m : M) (hm : m ≠ 0) :
    {c : Fin 3 → K | ¬ AlgebraicIndependent K
      (generalizedCliffordShiftFieldJet (fermatCubicSymbol X Y Z c) m)} =
      {c : Fin 3 → K | fermatCubicPotential c = 0} := by
  apply generalizedCliffordShiftField_dependenceHorizon_eq_zeroLocus
    (fermatCubicSymbol X Y Z) fermatCubicPotential 3
    (Nat.succ_ne_zero 2) m hm
  exact fermatCubicSymbol_pow_three ω X Y Z hω hX3 hY3 hZ3 hXY hXZ hYZ

/-- The same exact Fermat cubic is the dependence horizon of a genuine linear law space of
rational-field derivations. -/
theorem fermatCubicLinearDependenceHorizon_eq
    (ω : K) (X Y Z : Module.End K M)
    (hω : ω ^ (2 : ℕ) + ω + 1 = 0)
    (hX3 : X ^ (3 : ℕ) = 1) (hY3 : Y ^ (3 : ℕ) = 1) (hZ3 : Z ^ (3 : ℕ) = 1)
    (hXY : X * Y = ω • (Y * X))
    (hXZ : X * Z = ω • (Z * X))
    (hYZ : Y * Z = ω • (Z * Y))
    (m : M) (hm : m ≠ 0) :
    linearDerivationDependenceHorizon
        (generalizedCliffordShiftFieldDerivationLaw (fermatCubicSymbol X Y Z))
        (generalizedCliffordShiftFieldRoot m) =
      {c : Fin 3 → K | fermatCubicPotential c = 0} := by
  apply generalizedCliffordField_linearDependenceHorizon_eq_zeroLocus
    (fermatCubicSymbol X Y Z) fermatCubicPotential 3
    (Nat.succ_ne_zero 2) m hm
  exact fermatCubicSymbol_pow_three ω X Y Z hω hX3 hY3 hZ3 hXY hXZ hYZ

end

end GaloisForLFunctions.HTGeometry
