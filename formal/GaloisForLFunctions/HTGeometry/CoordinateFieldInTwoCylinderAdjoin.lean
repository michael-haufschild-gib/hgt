import GaloisForLFunctions.HTGeometry.TwoCylinderMeromorphicDifferential
import GaloisForLFunctions.HTGeometry.DoubleSineAugmentationAnnihilator
import GaloisForLFunctions.HTGeometry.DifferentialAlgebraicTransitivity
import GaloisForLFunctions.HTGeometry.MultipleSineLadderRationalDefect

/-!
# The coordinate field inside the differential adjoin of the coordinate

The base of the double-sine hypertranscendence argument is the two-cylinder field `ℂ(u₁)(u₂)`, but
the annihilator theorem is stated over the coordinate field `ℂ(z)`.  Neither contains the other, and
the bridge is the classical one: `z` satisfies `z'' = 0`, so it is differentially algebraic over the
two-cylinder field, and `ℂ(z)` lies inside the differential field the two-cylinder field generates
by adjoining `z`.

Transitivity of differential algebraicity then converts hypertranscendence over the two-cylinder
field into hypertranscendence over the coordinate field.  This module supplies the two inputs: the
membership of `ℂ(z)` and the differential algebraicity of `z`.
-/

open Filter Set Topology Complex
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

attribute [local instance] relativeGaugeDomain relativeGaugeDifferential
  relativeGaugeRatFuncAlgebra relativeGaugeRatFuncDifferential relativeGaugeDifferentialAlgebra
  relativeGaugeCharZeroBase relativeGaugeCharZero relativeGaugeComplexAlgebra
  relativeGaugeComplexAlgebraAnalytic

/-- The coordinate `z` as an element of the global meromorphic field. -/
def coordinateMero : meroField (Set.univ : Set ℂ) :=
  ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X)

theorem ratMero_ratFuncC (c : ℂ) :
    ratMero (RatFunc.C c) = algebraMap ℂ (meroField (Set.univ : Set ℂ)) c :=
  ratfuncToMero_ratFuncC c

theorem ratMero_algebraMap_complex (c : ℂ) :
    ratMero (algebraMap ℂ (RatFunc ℂ) c) = algebraMap ℂ (meroField (Set.univ : Set ℂ)) c := by
  rw [algebraMap_ratFunc_eq_polynomialC, RatFunc.algebraMap_C]
  exact ratMero_ratFuncC c

theorem ratMero_polynomial (p : Polynomial ℂ) :
    ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p)
      = Polynomial.aeval coordinateMero p := by
  have hext : (ratMero.comp (algebraMap (Polynomial ℂ) (RatFunc ℂ)))
      = ((Polynomial.aeval coordinateMero :
          Polynomial ℂ →ₐ[ℂ] meroField (Set.univ : Set ℂ)) : Polynomial ℂ →+* _) := by
    refine Polynomial.ringHom_ext (fun a => ?_) ?_
    · show ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) (Polynomial.C a))
        = Polynomial.aeval coordinateMero (Polynomial.C a)
      rw [Polynomial.aeval_C, RatFunc.algebraMap_C]
      exact ratMero_ratFuncC a
    · show ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X)
        = Polynomial.aeval coordinateMero Polynomial.X
      rw [Polynomial.aeval_X]
      rfl
  exact congrFun (congrArg (fun f : Polynomial ℂ →+* meroField (Set.univ : Set ℂ) =>
    (f : Polynomial ℂ → meroField (Set.univ : Set ℂ))) hext) p

variable {l : Fin 2 → ℂ}

theorem twoCylinderEmbed_algebraMap_complex (hl : LinearIndependent ℚ l) (c : ℂ) :
    twoCylinderEmbed hl (algebraMap ℂ (RatFunc (RatFunc ℂ)) c)
      = algebraMap ℂ (meroField (Set.univ : Set ℂ)) c := by
  rw [IsScalarTower.algebraMap_apply ℂ (RatFunc ℂ) (RatFunc (RatFunc ℂ)) c,
    twoCylinderEmbed_coeff]
  exact (cylinderEmbed hl 0).commutes c

/-- **The coordinate field lies in the differential field generated by the coordinate over the
two-cylinder field.** -/
theorem ratMero_mem_differentialAdjoin_coordinate (hl : LinearIndependent ℚ l) (r : RatFunc ℂ) :
    letI : Algebra (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ)) :=
      (twoCylinderEmbed hl).toAlgebra
    ratMero r ∈ differentialAdjoin (RatFunc (RatFunc ℂ))
      ({coordinateMero} : Set (meroField (Set.univ : Set ℂ))) := by
  letI : Algebra (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ)) :=
    (twoCylinderEmbed hl).toAlgebra
  set B : IntermediateField (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ)) :=
    differentialAdjoin (RatFunc (RatFunc ℂ))
      ({coordinateMero} : Set (meroField (Set.univ : Set ℂ))) with hB
  have hZ : coordinateMero ∈ B :=
    subset_differentialAdjoin (RatFunc (RatFunc ℂ)) _ rfl
  have hconst : ∀ c : ℂ, algebraMap ℂ (meroField (Set.univ : Set ℂ)) c ∈ B := by
    intro c
    have : algebraMap ℂ (meroField (Set.univ : Set ℂ)) c
        = algebraMap (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ))
            (algebraMap ℂ (RatFunc (RatFunc ℂ)) c) :=
      (twoCylinderEmbed_algebraMap_complex hl c).symm
    rw [this]
    exact B.algebraMap_mem _
  have hpoly : ∀ p : Polynomial ℂ,
      ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p) ∈ B := by
    intro p
    rw [ratMero_polynomial]
    induction p using Polynomial.induction_on with
    | C a => rw [Polynomial.aeval_C]; exact hconst a
    | add p q hp hq => rw [map_add]; exact B.add_mem hp hq
    | monomial n a ih =>
        rw [show Polynomial.C a * Polynomial.X ^ (n + 1)
            = (Polynomial.C a * Polynomial.X ^ n) * Polynomial.X by ring, map_mul,
          Polynomial.aeval_X]
        exact B.mul_mem ih hZ
  refine RatFunc.induction_on (P := fun r => ratMero r ∈ B) r ?_
  intro p q hq
  have hqne : algebraMap (Polynomial ℂ) (RatFunc ℂ) q ≠ 0 := RatFunc.algebraMap_ne_zero hq
  have hqmero : ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) q) ≠ 0 := fun hcon =>
    hqne (RingHom.injective ratMero (by rw [hcon, map_zero]))
  have hmul : ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p /
        algebraMap (Polynomial ℂ) (RatFunc ℂ) q) * ratMero (algebraMap _ _ q)
      = ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p) := by
    rw [← map_mul, div_mul_cancel₀ _ hqne]
  have hval : ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p /
        algebraMap (Polynomial ℂ) (RatFunc ℂ) q)
      = ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) p)
        * (ratMero (algebraMap (Polynomial ℂ) (RatFunc ℂ) q))⁻¹ := by
    field_simp
    linear_combination hmul
  rw [hval]
  exact B.mul_mem (hpoly p) (B.inv_mem (hpoly q))

theorem deriv_coordinateMero : coordinateMero′ = 1 := by
  show (algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
    (algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X))′ = 1
  rw [deriv_algebraMap]
  show algebraMap (RatFunc ℂ) (meroField (Set.univ : Set ℂ))
    (HTGeometry.ratFuncCoordinateDerivation ℂ
      (algebraMap (Polynomial ℂ) (RatFunc ℂ) Polynomial.X)) = 1
  rw [HTGeometry.ratFuncCoordinateDerivation_algebraMap]
  simp

theorem differentialJet_two_coordinateMero : differentialJet 2 coordinateMero = 0 := by
  rw [show (2 : ℕ) = 1 + 1 from rfl, differentialJet_succ, differentialJet_succ,
    differentialJet_zero, deriv_coordinateMero]
  letI : Algebra ℤ (meroField (Set.univ : Set ℂ)) := Ring.toIntAlgebra _
  exact Derivation.map_one_eq_zero _

/-- **The coordinate is differentially algebraic over the two-cylinder field**: it satisfies
`z'' = 0`. -/
theorem differentialAlgebraicOver_coordinateMero (hl : LinearIndependent ℚ l) :
    letI : Algebra (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ)) :=
      (twoCylinderEmbed hl).toAlgebra
    DifferentialAlgebraicOver (RatFunc (RatFunc ℂ)) coordinateMero := by
  letI : Algebra (RatFunc (RatFunc ℂ)) (meroField (Set.univ : Set ℂ)) :=
    (twoCylinderEmbed hl).toAlgebra
  intro hind
  have htr := hind.transcendental ((), 2)
  rw [differentialJet_two_coordinateMero] at htr
  exact htr isAlgebraic_zero

end

end GaloisForLFunctions.HTGeometry
