import GaloisForLFunctions.HTGeometry.TorusPrefixEndomorphism
import GaloisForLFunctions.HTGeometry.FreeDifferentialLinearAction

/-!
# The scaling action of the constant torus

A vector of constant units rescales each coordinate of a freely generating palette, giving a
differential automorphism of the generated field.  The assignment is a group homomorphism from the
constant torus `(C^×) ^ r` to the differential automorphisms, and it is faithful.

On a monomial family the action is by the corresponding monomial in the scalars.  Hence the kernel
of an integer matrix acting on the constant torus fixes the differential field generated by the
monomial family of that matrix: this is the deck group of a torus isogeny protocol.
-/

namespace GaloisForLFunctions.HTGeometry

open scoped Differential

noncomputable section

universe u

variable {C E : Type u} [Field C] [Field E] [Algebra C E] [Differential C] [Differential E]
  [DifferentialAlgebra C E] [CharZero E]

section

variable {ι : Type u} {x : ι → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

include hx hgen in
/-- **The coordinatewise scaling automorphism.**  Rescaling each palette coordinate by a constant
unit. -/
def torusScaleEquiv (u : ι → Cˣ) : E ≃ₐ[C] E :=
  GaloisForLFunctions.differentialIndependentTopAlgEquiv x
    (fun i ↦ algebraMap C E ((u i : C)) * x i) hx
    (hx.mulBase (fun i ↦ ((u i : C))) (fun i ↦ (u i).ne_zero)) hgen
    (by
      rw [differentialAdjoin_range_mulBase_eq x (fun i ↦ ((u i : C)))
        (fun i ↦ (u i).ne_zero)]
      exact hgen)

theorem torusScaleEquiv_apply (u : ι → Cˣ) (i : ι) :
    torusScaleEquiv hx hgen u (x i) = algebraMap C E ((u i : C)) * x i :=
  GaloisForLFunctions.differentialIndependentTopAlgEquiv_apply _ _ _ _ _ _ i

theorem torusScaleEquiv_deriv (u : ι → Cˣ) (z : E) :
    torusScaleEquiv hx hgen u z′ = Differential.deriv (torusScaleEquiv hx hgen u z) :=
  GaloisForLFunctions.differentialIndependentTopAlgEquiv_deriv _ _ _ _ _ _ z

omit [CharZero E] in
theorem torusScaleEquiv_one : torusScaleEquiv hx hgen (1 : ι → Cˣ) = 1 := by
  refine tailEquiv_ext x hgen (fun z ↦ torusScaleEquiv_deriv hx hgen 1 z) (fun z ↦ ?_) (fun i ↦ ?_)
  · rw [AlgEquiv.one_apply, AlgEquiv.one_apply]
  · rw [torusScaleEquiv_apply, AlgEquiv.one_apply]
    simp

omit [CharZero E] in
theorem torusScaleEquiv_mul (u v : ι → Cˣ) :
    torusScaleEquiv hx hgen (u * v)
      = torusScaleEquiv hx hgen u * torusScaleEquiv hx hgen v := by
  refine tailEquiv_ext x hgen (fun z ↦ torusScaleEquiv_deriv hx hgen (u * v) z)
    (fun z ↦ ?_) (fun i ↦ ?_)
  · rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, torusScaleEquiv_deriv, torusScaleEquiv_deriv]
  · rw [AlgEquiv.mul_apply, torusScaleEquiv_apply, torusScaleEquiv_apply, map_mul,
      AlgEquiv.commutes, torusScaleEquiv_apply]
    change algebraMap C E (((u * v) i : C)) * x i = _
    rw [show ((u * v) i : C) = (u i : C) * (v i : C) from rfl, map_mul]
    ring

include hx hgen in
/-- **The deck representation of a torus protocol.**  The constant torus acts by coordinatewise
scaling. -/
def torusScaleRep : (ι → Cˣ) →* (E ≃ₐ[C] E) where
  toFun u := torusScaleEquiv hx hgen u
  map_one' := torusScaleEquiv_one hx hgen
  map_mul' := torusScaleEquiv_mul hx hgen

omit [CharZero E] in
@[simp] theorem torusScaleRep_eq (u : ι → Cˣ) :
    torusScaleRep hx hgen u = torusScaleEquiv hx hgen u := rfl

end

section

variable {r : ℕ} {x : Fin r → E} (hx : DifferentialIndependent C x)
  (hgen : differentialAdjoin C (Set.range x) = ⊤)

include hx in
theorem torus_palette_ne_zero (i : Fin r) : x i ≠ 0 := by
  intro hi
  exact ((algebraicIndependent_of_differentialIndependent hx).transcendental i)
    (hi ▸ isAlgebraic_zero)

include hx in
/-- The deck representation of a torus protocol is faithful. -/
theorem torusScaleRep_injective : Function.Injective (torusScaleRep hx hgen) := by
  intro u v huv
  funext i
  have h := congrArg (fun σ : E ≃ₐ[C] E ↦ σ (x i)) huv
  simp only [torusScaleRep_eq, torusScaleEquiv_apply] at h
  have hcast : algebraMap C E ((u i : C)) = algebraMap C E ((v i : C)) :=
    mul_right_cancel₀ (torus_palette_ne_zero hx i) h
  exact Units.ext ((algebraMap C E).injective hcast)

/-- **The scaling action on a monomial family** is by the same monomial in the scalars. -/
theorem torusScaleEquiv_monomialFamily (u : Fin r → Cˣ) (M : Matrix (Fin r) (Fin r) ℤ)
    (i : Fin r) :
    torusScaleEquiv hx hgen u (monomialFamily M x i)
      = algebraMap C E (monomialFamily M (fun j ↦ ((u j : C))) i) * monomialFamily M x i := by
  have hx0 : ∀ j, x j ≠ 0 := torus_palette_ne_zero hx
  rw [monomialFamily_apply, map_prod, monomialFamily_apply, monomialFamily_apply, map_prod,
    ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun j _ ↦ ?_
  rw [map_zpow₀, torusScaleEquiv_apply, mul_zpow, map_zpow₀]

/-- **The deck group of a torus isogeny fixes its prefix image.**  A scalar vector killed by the
matrix acts trivially on the differential field of the monomial family. -/
theorem differentialAdjoin_monomialFamily_le_fixedField
    (M : Matrix (Fin r) (Fin r) ℤ) (S : Subgroup (Fin r → Cˣ))
    (hS : ∀ u ∈ S, ∀ i, monomialFamily M (fun j ↦ ((u j : C))) i = 1) :
    differentialAdjoin C (Set.range (monomialFamily M x))
      ≤ IntermediateField.fixedField (S.map (torusScaleRep hx hgen)) := by
  refine differentialAdjoin_le C ?_ ?_
  · rintro z ⟨i, rfl⟩
    simp only [SetLike.mem_coe]
    rw [IntermediateField.mem_fixedField_iff]
    rintro σ ⟨u, hu, rfl⟩
    rw [torusScaleRep_eq, torusScaleEquiv_monomialFamily, hS u hu i, map_one, one_mul]
  · intro z hz
    rw [IntermediateField.mem_fixedField_iff] at hz ⊢
    rintro σ ⟨u, hu, rfl⟩
    have hfix := hz (torusScaleRep hx hgen u) ⟨u, hu, rfl⟩
    rw [torusScaleRep_eq] at hfix ⊢
    rw [torusScaleEquiv_deriv, hfix]

end

end

end GaloisForLFunctions.HTGeometry
