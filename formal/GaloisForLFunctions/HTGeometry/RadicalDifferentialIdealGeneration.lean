import GaloisForLFunctions.HTGeometry.RadicalDifferentialIdeal

/-!
# The radical differential ideal generated by a set, and the product law

`radicalDifferentialIdeal S` is the smallest radical ideal containing `S` and stable under the
derivation.  The product law `{a} · {b} ⊆ I` whenever `a b ∈ I` is the engine of Ritt's basis
theorem: it makes a maximal non-finitely-generated radical differential ideal prime.

The proof is Ritt's lemma applied to the colon ideal `{y | a y ∈ I}`, which is radical because
`(a y)^n = a^{n-1} (a y^n)`, and differential by Ritt's lemma.
-/

namespace GaloisForLFunctions.HTGeometry

noncomputable section

variable {R : Type*} [CommRing R] [Differential R]

/-- The colon ideal `{y | a y ∈ I}`. -/
def mulColonIdeal (I : Ideal R) (a : R) : Ideal R where
  carrier := {y | a * y ∈ I}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [mul_add]
    exact I.add_mem hx hy
  zero_mem' := by simp
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [smul_eq_mul, ← mul_assoc, mul_comm a c, mul_assoc]
    exact I.mul_mem_left _ hx

omit [Differential R] in
@[simp] theorem mem_mulColonIdeal {I : Ideal R} {a y : R} :
    y ∈ mulColonIdeal I a ↔ a * y ∈ I := Iff.rfl

omit [Differential R] in
theorem isRadical_mulColonIdeal {I : Ideal R} (hrad : I.IsRadical) (a : R) :
    (mulColonIdeal I a).IsRadical := by
  intro y hy
  obtain ⟨n, hn⟩ := hy
  rw [mem_mulColonIdeal] at hn ⊢
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · simp only [pow_zero, mul_one] at hn
    exact I.mul_mem_right _ hn
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    refine hrad ⟨m + 1, ?_⟩
    have hrw : (a * y) ^ (m + 1) = a ^ m * (a * y ^ (m + 1)) := by ring
    rw [hrw]
    exact I.mul_mem_left _ hn

theorem deriv_mem_mulColonIdeal {I : Ideal R} (hrad : I.IsRadical)
    (hδ : ∀ x ∈ I, Differential.deriv x ∈ I) (a : R) :
    ∀ y ∈ mulColonIdeal I a, Differential.deriv y ∈ mulColonIdeal I a := by
  intro y hy
  rw [mem_mulColonIdeal] at hy ⊢
  exact mul_deriv_mem_of_mul_mem hrad hδ hy

/-- The smallest radical differential ideal containing a set. -/
def radicalDifferentialIdeal (S : Set R) : Ideal R :=
  sInf {I : Ideal R | S ⊆ (I : Set R) ∧ I.IsRadical ∧ ∀ x ∈ I, Differential.deriv x ∈ I}

theorem radicalDifferentialIdeal_eq (S : Set R) :
    radicalDifferentialIdeal S
      = sInf {I : Ideal R | S ⊆ (I : Set R) ∧ I.IsRadical ∧ ∀ x ∈ I, Differential.deriv x ∈ I} :=
  rfl

theorem subset_radicalDifferentialIdeal (S : Set R) :
    S ⊆ (radicalDifferentialIdeal S : Set R) := by
  intro x hx
  rw [radicalDifferentialIdeal_eq]
  simp only [SetLike.mem_coe, Submodule.mem_sInf, Set.mem_setOf_eq]
  intro I hI
  exact hI.1 hx

theorem radicalDifferentialIdeal_le {S : Set R} {I : Ideal R} (hS : S ⊆ (I : Set R))
    (hrad : I.IsRadical) (hδ : ∀ x ∈ I, Differential.deriv x ∈ I) :
    radicalDifferentialIdeal S ≤ I :=
  sInf_le ⟨hS, hrad, hδ⟩

theorem isRadical_radicalDifferentialIdeal (S : Set R) :
    (radicalDifferentialIdeal S).IsRadical := by
  intro y hy
  obtain ⟨n, hn⟩ := hy
  rw [radicalDifferentialIdeal_eq] at hn ⊢
  simp only [Submodule.mem_sInf, Set.mem_setOf_eq] at hn ⊢
  intro I hI
  exact hI.2.1 ⟨n, hn I hI⟩

theorem deriv_mem_radicalDifferentialIdeal (S : Set R) :
    ∀ x ∈ radicalDifferentialIdeal S, Differential.deriv x ∈ radicalDifferentialIdeal S := by
  intro x hx
  rw [radicalDifferentialIdeal_eq] at hx ⊢
  simp only [Submodule.mem_sInf, Set.mem_setOf_eq] at hx ⊢
  intro I hI
  exact hI.2.2 _ (hx I hI)

/-- **The product law.**  If `a b` lies in a radical differential ideal, so does every product of
an element of the radical differential ideal generated by `a` with one generated by `b`. -/
theorem mul_mem_of_mul_mem_radicalDifferential {I : Ideal R} (hrad : I.IsRadical)
    (hδ : ∀ x ∈ I, Differential.deriv x ∈ I) {a b : R} (hab : a * b ∈ I)
    {u v : R} (hu : u ∈ radicalDifferentialIdeal ({a} : Set R))
    (hv : v ∈ radicalDifferentialIdeal ({b} : Set R)) : u * v ∈ I := by
  have hb : radicalDifferentialIdeal ({b} : Set R) ≤ mulColonIdeal I a :=
    radicalDifferentialIdeal_le
      (by
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        simp only [SetLike.mem_coe, mem_mulColonIdeal]
        exact hab)
      (isRadical_mulColonIdeal hrad a) (deriv_mem_mulColonIdeal hrad hδ a)
  have hav : a * v ∈ I := hb hv
  have ha : radicalDifferentialIdeal ({a} : Set R) ≤ mulColonIdeal I v :=
    radicalDifferentialIdeal_le
      (by
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        simp only [SetLike.mem_coe, mem_mulColonIdeal]
        rw [mul_comm]
        exact hav)
      (isRadical_mulColonIdeal hrad v) (deriv_mem_mulColonIdeal hrad hδ v)
  have := ha hu
  rw [mem_mulColonIdeal] at this
  rwa [mul_comm]

end

end GaloisForLFunctions.HTGeometry
