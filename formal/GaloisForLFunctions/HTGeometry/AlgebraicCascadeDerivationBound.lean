import GaloisForLFunctions.HTGeometry.AdjoinRootDerivationIntegral
import GaloisForLFunctions.HTGeometry.AlgebraicCascadePlace
import GaloisForLFunctions.HTGeometry.TopDegreeSharpDrop

/-!
# How far the extended derivation can lower the order

The derivation at the uniformiser preserves the valuation ring of the coordinate field.  On a simple
algebraic extension it need not preserve the order generated by the root, but the failure is
measured by a single element: `p'(α)·δ` maps the order into itself.  When `p` is monic with
coefficients in the valuation ring the order consists of integral elements, so at every place of the
extension above the degree at infinity

`ord_Q(δ f) ≥ ord_Q(f) − ord_Q(p'(α))`   for `f` in the order,

which is the statement that the extended derivation lowers the order by at most the order of the
different generator of `S[α]`.
-/

namespace GaloisForLFunctions.HTGeometry

open Polynomial

variable (m : ℕ) (p : Polynomial CascadeField) [Fact (Irreducible p)]

/-- **The different generator clears the extended derivation, on the cascade model.** -/
theorem rootEval_derivative_mul_uDeriv_mem_adjoin
    (hp : ∀ i, p.coeff i ∈ topInt m) {f : AlgCascadeField p}
    (hf : f ∈ Algebra.adjoin (topInt m) ({AdjoinRoot.root p} : Set (AlgCascadeField p))) :
    rootEval ℂ p (derivative p) * algLaw p (uDeriv m) f
      ∈ Algebra.adjoin (topInt m) ({AdjoinRoot.root p} : Set (AlgCascadeField p)) :=
  rootEval_derivative_mul_adjoinRootDeriv_mem (uDeriv m) (topInt m)
    (fun _ ha => uDeriv_mem_topInt ha) hp hf

/-! ## The order is integral -/

theorem isIntegral_root_of_monic (hmonic : p.Monic) (hp : ∀ i, p.coeff i ∈ topInt m) :
    IsIntegral (topInt m) (AdjoinRoot.root p) := by
  have hcoeffs : (↑p.coeffs : Set CascadeField) ⊆ (topInt m : Set CascadeField) := by
    intro a ha
    obtain ⟨i, -, rfl⟩ := Polynomial.mem_coeffs_iff.mp (by exact_mod_cast ha)
    exact hp i
  refine ⟨p.toSubring (topInt m) hcoeffs, (Polynomial.monic_toSubring _ _ _).mpr hmonic, ?_⟩
  have hmap : (p.toSubring (topInt m) hcoeffs).map (Subring.subtype (topInt m)) = p :=
    Polynomial.map_toSubring _ _ _
  have hcomp : (algebraMap (topInt m) (AlgCascadeField p))
      = (algebraMap CascadeField (AlgCascadeField p)).comp
        (Subring.subtype (topInt m)) := by
    ext c
    exact algebraMap_subring_eq (topInt m) p c
  rw [hcomp, ← Polynomial.eval₂_map, hmap]
  exact rootEval_self (R := ℂ)

theorem adjoin_root_le_algCascadeInt (hmonic : p.Monic) (hp : ∀ i, p.coeff i ∈ topInt m) :
    Algebra.adjoin (topInt m) ({AdjoinRoot.root p} : Set (AlgCascadeField p))
      ≤ integralClosure (topInt m) (AlgCascadeField p) := by
  refine Algebra.adjoin_le ?_
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact isIntegral_root_of_monic m p hmonic hp

/-- **The extended derivation is integral after one multiplication by the different generator.** -/
theorem rootEval_derivative_mul_uDeriv_isIntegral (hmonic : p.Monic)
    (hp : ∀ i, p.coeff i ∈ topInt m) {f : AlgCascadeField p}
    (hf : f ∈ Algebra.adjoin (topInt m) ({AdjoinRoot.root p} : Set (AlgCascadeField p))) :
    IsIntegral (topInt m) (rootEval ℂ p (derivative p) * algLaw p (uDeriv m) f) :=
  adjoin_root_le_algCascadeInt m p hmonic hp
    (rootEval_derivative_mul_uDeriv_mem_adjoin m p hp hf)

/-- **The valuation bound at a place of the extension.**  At every place above the degree at
infinity, the extended derivation lowers the order by at most the order of the different generator
of the order `S[α]`. -/
theorem valuation_uDeriv_le_of_mem_adjoin (hmonic : p.Monic) (hp : ∀ i, p.coeff i ∈ topInt m)
    (Q : IsDedekindDomain.HeightOneSpectrum (algCascadeInt m p))
    {f : AlgCascadeField p}
    (hf : f ∈ Algebra.adjoin (topInt m) ({AdjoinRoot.root p} : Set (AlgCascadeField p))) :
    Q.valuation (AlgCascadeField p)
        (rootEval ℂ p (derivative p) * algLaw p (uDeriv m) f) ≤ 1 := by
  have hmem : rootEval ℂ p (derivative p) * algLaw p (uDeriv m) f
      ∈ integralClosure (topInt m) (AlgCascadeField p) :=
    adjoin_root_le_algCascadeInt m p hmonic hp
      (rootEval_derivative_mul_uDeriv_mem_adjoin m p hp hf)
  exact Q.valuation_le_one ⟨_, hmem⟩

end GaloisForLFunctions.HTGeometry
