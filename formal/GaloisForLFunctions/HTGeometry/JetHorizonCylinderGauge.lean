import GaloisForLFunctions.HTGeometry.DifferentialHorizonInterface
import GaloisForLFunctions.HTGeometry.FreeDifferentialTranslationAutomorphism

/-!
# A flat additive direction keeps its gauge at every depth

For a freely differentially generated field the translation of the generator by a nonzero base
constant is a differential automorphism which leaves every positive derivative of the generator
untouched.  So it fixes the whole differential field generated by the `n`-th derivative, while
moving the generator itself: the depth-`n` horizon of a pure additive cylinder is a proper
subfield, at every positive depth.

Together with the rigidity statements of `JetHorizonAllDepthGauge` this is the two-sided form of
the reconstruction criterion on the cylinder factor: a translation-rigid locus has no horizon
gauge, and a flat additive direction always has one.
-/

open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions

noncomputable section

variable {F E : Type*} [Field F] [Field E] [Differential F] [Differential E] [Algebra F E]
  [DifferentialAlgebra F E]

/-- The translation automorphism as a differential automorphism. -/
def translationDifferentialAlgEquiv (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    (c : F) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) : DifferentialAlgEquiv F E where
  toAlgEquiv := translationAutomorphism hF c hy hytop
  map_deriv' := translationAutomorphism_deriv hF c hy hytop

@[simp] theorem translationDifferentialAlgEquiv_generator
    (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    (c : F) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) :
    (translationDifferentialAlgEquiv hF c hy hytop).toAlgEquiv y = algebraMap F E c + y :=
  translationAutomorphism_generator hF c hy hytop

/-- The translation automorphism fixes every positive derivative of the generator. -/
theorem translationDifferentialAlgEquiv_fixes_differentialJet
    (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    (c : F) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) (n : ℕ) :
    (translationDifferentialAlgEquiv hF c hy hytop).toAlgEquiv (differentialJet (n + 1) y)
      = differentialJet (n + 1) y := by
  rw [(translationDifferentialAlgEquiv hF c hy hytop).map_differentialJet,
    translationDifferentialAlgEquiv_generator, differentialJet_const_add hF]

/-- **A flat additive direction always has horizon gauge.**  A nonzero base constant produces a
differential automorphism fixing the depth-`n` horizon of the free generator and moving the
generator. -/
theorem exists_differentialAlgEquiv_fixing_horizon_moving_generator
    (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    {c : F} (hc : c ≠ 0) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) (n : ℕ) :
    ∃ σ : DifferentialAlgEquiv F E,
      σ.toAlgEquiv (differentialJet (n + 1) y) = differentialJet (n + 1) y ∧
        σ.toAlgEquiv y ≠ y := by
  refine ⟨translationDifferentialAlgEquiv hF c hy hytop,
    translationDifferentialAlgEquiv_fixes_differentialJet hF c hy hytop n, ?_⟩
  rw [translationDifferentialAlgEquiv_generator]
  intro hcontra
  have hzero : algebraMap F E c = 0 := by
    have := congrArg (fun x => x - y) hcontra
    simpa using this
  exact hc ((map_eq_zero (algebraMap F E)).1 hzero)

/-- **The depth-`n` horizon of a pure additive cylinder is proper.**  The generator does not lie in
the differential field generated by its `n`-th derivative, for any positive `n`. -/
theorem notMem_differentialAdjoin_differentialJet_of_free
    (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    {c : F} (hc : c ≠ 0) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) (n : ℕ) :
    y ∉ differentialAdjoin F ({differentialJet (n + 1) y} : Set E) := by
  obtain ⟨σ, hfix, hmove⟩ :=
    exists_differentialAlgEquiv_fixing_horizon_moving_generator hF hc hy hytop n
  intro hmem
  refine hmove ?_
  refine σ.fixed_on_differentialAdjoin (fun _ : Unit => differentialJet (n + 1) y) ?_ ?_
  · intro _; exact hfix
  · simpa using hmem

/-- The depth-`n` horizon of a pure additive cylinder is a proper differential subfield. -/
theorem differentialAdjoin_differentialJet_ne_top_of_free
    (hF : ∀ a : F, (algebraMap F E a)′ = 0)
    {c : F} (hc : c ≠ 0) {y : E} (hy : DifferentialIndependent F (fun _ : Unit ↦ y))
    (hytop : differentialAdjoin F ({y} : Set E) = ⊤) (n : ℕ) :
    differentialAdjoin F ({differentialJet (n + 1) y} : Set E) ≠ ⊤ := by
  intro htop
  exact notMem_differentialAdjoin_differentialJet_of_free hF hc hy hytop n
    (by rw [htop]; trivial)

end

end GaloisForLFunctions.HTGeometry
