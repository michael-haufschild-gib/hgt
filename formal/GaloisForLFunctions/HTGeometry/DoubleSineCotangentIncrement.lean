import GaloisForLFunctions.HTGeometry.TwoCylinderMeromorphicDifferential
import GaloisForLFunctions.HTGeometry.PeriodCotangentCylinderForm

/-!
# The double-sine increment inside the two-cylinder field

The right-hand sides of the double-sine functional equations are the period cotangents
`(π/ω) cot(π z/ω)`.  This module identifies them, inside the global meromorphic field, with the
image of the rational cotangent model `(iπ/ω)(X+1)/(X-1)` under the two-cylinder embedding, where
`X` is the second cylinder coordinate `exp(2πi z/ω)`.

The one-cylinder identification is `periodCotMero_eq_cylinderEmbed`; what is added here is that the
subfield generated by the second coordinate over the constants is the image of the coefficient
extension `ℂ(X) → ℂ(u₁)(X)`, which puts the increment in the exact shape the differential Ostrowski
criterion consumes.
-/

open Filter Set Topology Polynomial
open scoped Differential

namespace GaloisForLFunctions.HTGeometry

open GaloisForLFunctions Bottcher

noncomputable section

local instance dsDomain :
    IsDomain (analyticSubring (Set.univ : Set ℂ)) :=
  Bottcher.isDomain_analyticSubring Set.univ isOpen_univ
    isPreconnected_univ Set.univ_nonempty

local instance dsComplexAlgebraAnalytic :
    Algebra ℂ (analyticSubring (Set.univ : Set ℂ)) := (constToAnalytic Set.univ).toAlgebra

local instance dsComplexAlgebra : Algebra ℂ (meroField (Set.univ : Set ℂ)) :=
  ((algebraMap (analyticSubring (Set.univ : Set ℂ)) (meroField Set.univ)).comp
    (constToAnalytic Set.univ)).toAlgebra

variable {l : Fin 2 → ℂ}

/-- **The second cylinder coordinate field sits inside the two-cylinder field.**  Constant-coefficient
rational functions of the outer variable embed as rational functions of the second cylinder
coordinate. -/
theorem twoCylinderEmbed_coeffExtend (hl : LinearIndependent ℚ l) (y : RatFunc ℂ) :
    twoCylinderEmbed hl (coeffExtend (C := ℂ) (K := RatFunc ℂ) y) = cylinderEmbed hl 1 y := by
  have hcomp : ((cylinderEmbed hl 0 : RatFunc ℂ →ₐ[ℂ]
        meroField (Set.univ : Set ℂ)).toRingHom).comp (algebraMap ℂ (RatFunc ℂ))
      = algebraMap ℂ (meroField (Set.univ : Set ℂ)) :=
    RingHom.ext fun c => (cylinderEmbed hl 0).commutes c
  have heval : ∀ q : Polynomial ℂ,
      Polynomial.eval₂ (cylinderEmbed hl 0 : RatFunc ℂ →ₐ[ℂ]
          meroField (Set.univ : Set ℂ)).toRingHom (physicalExponentialMero (l 1))
          (q.map (algebraMap ℂ (RatFunc ℂ)))
        = Polynomial.aeval (physicalExponentialMero (l 1)) q := by
    intro q
    rw [Polynomial.eval₂_map, hcomp, Polynomial.aeval_def]
  refine RatFunc.induction_on
    (P := fun y => twoCylinderEmbed hl (coeffExtend (C := ℂ) (K := RatFunc ℂ) y)
      = cylinderEmbed hl 1 y) y ?_
  intro p s _
  rw [coeffExtend_div, twoCylinderEmbed_div, heval, heval, cylinderEmbed,
    RatFunc.liftAlgHom_apply_div]

/-- **The double-sine increment is the embedded cotangent model.**  With the second cylinder
coordinate `u₂ = exp(2πi z/ω)`, the two-cylinder field contains the rational model
`(iπ/ω)(X+1)/(X-1)`, and it embeds to the period cotangent `(π/ω) cot(π z/ω)`. -/
theorem twoCylinderEmbed_cotModel_period (hl : LinearIndependent ℚ l) {ω : ℂ} (hω : ω ≠ 0)
    (hl1 : l 1 = 2 * (Real.pi : ℂ) * Complex.I / ω) :
    twoCylinderEmbed hl
        (cotModel (algebraMap ℂ (RatFunc ℂ) ((Real.pi : ℂ) / ω * Complex.I)))
      = periodCotMero ω := by
  rw [← coeffExtend_cotModel, twoCylinderEmbed_coeffExtend,
    ← periodCotMero_eq_cylinderEmbed hl 1 hω hl1]

end

end GaloisForLFunctions.HTGeometry
