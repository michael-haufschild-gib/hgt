import GaloisForLFunctions.CountingHolography.TheIntegerProbesAreNotIntegerValued
import GaloisForLFunctions.CountingHolography.TheTateLimitOfACount

/-!
# Opposite degrees of a section algebra

In a multiplicative family of spaces of rational sections with constant
degree zero, the degrees supporting both signs form a subgroup. On that
subgroup every space is a line generated by an invertible section.
Consequently its ordinary dimensions cannot realize the integer spline
Tate form simultaneously on all signed divisors.
-/

noncomputable section
namespace GaloisForLFunctions.CountingHolography.Sections

open Filter Topology ArithmeticScatteringHolography
open scoped Pointwise

universe u v w

/-- Spaces of rational functions representing sections of signed divisors.
Multiplication adds the divisors and the global functions are constants. -/
structure RationalSectionSpaces (k : Type u) (F : Type v) (G : Type w)
    [Field k] [Field F] [Algebra k F] [AddCommGroup G] where
  space : G → Submodule k F
  unit_mem : (1 : F) ∈ space 0
  product_mem : ∀ {a b : G} {x y : F}, x ∈ space a → y ∈ space b → x*y ∈ space (a+b)
  global_constant : ∀ {x : F}, x ∈ space 0 → ∃ c : k, algebraMap k F c = x

namespace RationalSectionSpaces

variable {k : Type u} {F : Type v} {G : Type w} [Field k] [Field F] [Algebra k F] [AddCommGroup G]
    (E : RationalSectionSpaces k F G)

def occupied (a : G) : Prop := ∃ x ∈ E.space a, x ≠ 0

private theorem occupied_add {a b : G} (ha : E.occupied a) (hb : E.occupied b) :
    E.occupied (a+b) := by
  obtain ⟨x,hx,hx0⟩ := ha
  obtain ⟨y,hy,hy0⟩ := hb
  exact ⟨x*y, E.product_mem hx hy, mul_ne_zero hx0 hy0⟩

/-- The subgroup of degrees admitting nonzero sections in both directions. -/
def reversible : AddSubgroup G where
  carrier := {a | E.occupied a ∧ E.occupied (-a)}
  zero_mem' := ⟨⟨1,E.unit_mem,one_ne_zero⟩, by simpa only [neg_zero] using
    (show E.occupied 0 from ⟨1,E.unit_mem,one_ne_zero⟩)⟩
  add_mem' := by
    rintro a b ⟨ha,ha'⟩ ⟨hb,hb'⟩
    exact ⟨E.occupied_add ha hb, by simpa only [neg_add] using E.occupied_add ha' hb'⟩
  neg_mem' := by
    rintro a ⟨ha,ha'⟩
    exact ⟨ha', by simpa only [neg_neg] using ha⟩

private theorem opposite_constant {a : G} {x y : F} (hx : x ∈ E.space a) (hy : y ∈ E.space (-a)) :
    ∃ c : k, algebraMap k F c = x*y :=
  E.global_constant (by simpa only [add_neg_cancel] using E.product_mem hx hy)

/-- Every nonzero section of a reversible degree has its inverse in the
opposite space and generates its entire space over the constants. -/
theorem inverse_mem_and_span {a : G} (ha : a ∈ E.reversible) {x : F}
    (hx : x ∈ E.space a) (hx0 : x ≠ 0) :
    x⁻¹ ∈ E.space (-a) ∧ E.space a = Submodule.span k {x} := by
  obtain ⟨y,hy,hy0⟩ := ha.2
  obtain ⟨c,hc⟩ := E.opposite_constant hx hy
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact mul_ne_zero hx0 hy0 (hc.symm.trans (map_zero _))
  have hinv : x⁻¹ ∈ E.space (-a) := by
    have h := (E.space (-a)).smul_mem c⁻¹ hy
    rw [Algebra.smul_def, map_inv₀, hc, mul_inv_rev, mul_right_comm, inv_mul_cancel₀ hy0, one_mul] at h
    exact h
  refine ⟨hinv, le_antisymm (fun z hz => ?_) ((Submodule.span_singleton_le_iff_mem _ _).mpr hx)⟩
  obtain ⟨d,hd⟩ := E.opposite_constant hz hinv
  apply Submodule.mem_span_singleton.mpr
  exact ⟨d, by rw [Algebra.smul_def, hd, mul_assoc, inv_mul_cancel₀ hx0, mul_one]⟩

/-- At least one of two opposite section dimensions is at most one. -/
theorem min_dimension_le_one (a : G) :
    min (Module.finrank k (E.space a)) (Module.finrank k (E.space (-a))) ≤ 1 := by
  by_cases ha : E.occupied a
  · by_cases hb : E.occupied (-a)
    · obtain ⟨x,hx,hx0⟩ := ha
      have h := (E.inverse_mem_and_span (a := a) ⟨⟨x,hx,hx0⟩,hb⟩ hx hx0).2
      exact (min_le_left _ _).trans (by rw [h, finrank_span_singleton hx0])
    · have he : E.space (-a) = ⊥ := by
        apply le_antisymm _ bot_le
        exact fun x hx => show x = 0 from Classical.byContradiction fun h => hb ⟨x,hx,h⟩
      simp [he]
  · have he : E.space a = ⊥ := by
      apply le_antisymm _ bot_le
      exact fun x hx => show x = 0 from Classical.byContradiction fun h => ha ⟨x,hx,h⟩
    simp [he]

end RationalSectionSpaces

/-- Multiplication into a fixed finite-dimensional space of rational
functions bounds the smaller source dimension. This also applies to
sections of opposite divisors with a common fixed twist. -/
theorem min_finrank_le_product_target {k F : Type*} [Field k] [Field F] [Algebra k F]
    (U V W : Submodule k F) [Module.Finite k W]
    (h : ∀ x ∈ U, ∀ y ∈ V, x*y ∈ W) :
    min (Module.finrank k U) (Module.finrank k V) ≤ Module.finrank k W := by
  by_cases hv : ∃ y ∈ V, y ≠ 0
  · obtain ⟨y,hy,hy0⟩ := hv
    let T : U →ₗ[k] W :=
      { toFun := fun x => ⟨x.val*y, h x.val x.property y hy⟩
        map_add' := fun x z => Subtype.ext (add_mul _ _ _)
        map_smul' := fun c x => Subtype.ext (smul_mul_assoc c x.val y) }
    have hi : Function.Injective T := by
      intro x z he
      exact Subtype.ext (mul_right_cancel₀ hy0 (congrArg Subtype.val he : x.val*y = z.val*y))
    exact (min_le_left _ _).trans (LinearMap.finrank_le_finrank_of_injective hi)
  · have he : V = ⊥ := le_antisymm
      (fun x hx => show x = 0 from Classical.byContradiction fun h => hv ⟨x,hx,h⟩) bot_le
    simp [he]

/-- A bounded minimum on opposite rays forces at least one limiting
quadratic coefficient to vanish. -/
theorem min_opposite_tate_eq_zero {G : Type*} [AddCommGroup G] (K : G → ℕ) (a : G) (C : ℕ)
    (hC : ∀ m : ℕ, min (K (m • a)) (K (-(m • a))) ≤ C) {q r : ℝ}
    (hq : Tendsto (fun m : ℕ => (K (m • a) : ℝ) / (m : ℝ)^2) atTop (𝓝 q))
    (hr : Tendsto (fun m : ℕ => (K (m • (-a)) : ℝ) / (m : ℝ)^2) atTop (𝓝 r)) :
    min q r = 0 := by
  have hlim := hq.min hr
  have hc : Tendsto (fun m : ℕ => (C : ℝ) / (m : ℝ)^2) atTop (𝓝 0) := by
    have hi := ((tendsto_pow_atTop (α := ℝ) two_ne_zero).comp tendsto_natCast_atTop_atTop).inv_tendsto_atTop
    simpa only [div_eq_mul_inv, mul_zero] using hi.const_mul (C : ℝ)
  apply le_antisymm
  · apply le_of_tendsto_of_tendsto' hlim hc
    intro m
    simp only [smul_neg, min_div_div_right (sq_nonneg (m : ℝ))]
    exact div_le_div_of_nonneg_right (by exact_mod_cast hC m) (sq_nonneg _)
  · exact le_min (ge_of_tendsto' hq fun _ => by positivity) (ge_of_tendsto' hr fun _ => by positivity)

/-- No family of counts with bounded opposite minimum at each horizon
has the full signed spline form as its quadratic coefficient. -/
theorem no_bounded_opposite_minimum_tate (K : ∀ N : ℕ, (Fin N → ℤ) → ℕ)
    (hC : ∀ N, ∃ C : ℕ, ∀ a, min (K N a) (K N (-a)) ≤ C) :
    ¬ ∀ N (a : Fin N → ℤ), Tendsto (fun m : ℕ => (K N (m • a) : ℝ) / (m : ℝ)^2)
      atTop (𝓝 (integerProbe N a)) := by
  intro h
  apply not_integerProbe_integerValued
  intro N a
  have hq0 : integerProbe N 0 = 0 := by simpa using integerProbe_smul N 0 (0 : Fin N → ℤ)
  have hneg : integerProbe N (-a) = integerProbe N a := by
    have he := integerProbe_parallelogram N 0 a
    simp only [zero_add, zero_sub, hq0, mul_zero, zero_add] at he
    linarith
  obtain ⟨C,hC'⟩ := hC N
  have hz := min_opposite_tate_eq_zero (K N) a C (fun m => hC' (m • a)) (h N a) (h N (-a))
  exact ⟨0, by simpa only [hneg, min_self, Int.cast_zero] using hz⟩

/-- No multiplicatively graded family of rational section dimensions with
constant global functions realizes the signed spline Tate form. -/
theorem no_graded_section_dimension_tate (k : Type u) (F : Type v) [Field k] [Field F] [Algebra k F] :
    ¬ ∃ E : ∀ N : ℕ, RationalSectionSpaces k F (Fin N → ℤ), ∀ N (a : Fin N → ℤ),
      Tendsto (fun m : ℕ => (Module.finrank k ((E N).space (m • a)) : ℝ) / (m : ℝ)^2)
        atTop (𝓝 (integerProbe N a)) := by
  rintro ⟨E,h⟩
  exact no_bounded_opposite_minimum_tate _ (fun N => ⟨1,(E N).min_dimension_le_one⟩) h

/-- Even after fixed twists, the spaces of products of sections of opposite
degrees must escape every fixed finite-dimensional target at some horizon. -/
theorem no_fixed_product_target_tate (k : Type u) (F : Type v) [Field k] [Field F] [Algebra k F]
    (E : ∀ N : ℕ, (Fin N → ℤ) → Submodule k F) (W : ℕ → Submodule k F)
    (hW : ∀ N, Module.Finite k (W N))
    (hprod : ∀ N a, ∀ x ∈ E N a, ∀ y ∈ E N (-a), x*y ∈ W N) :
    ¬ ∀ N (a : Fin N → ℤ), Tendsto (fun m : ℕ => (Module.finrank k (E N (m • a)) : ℝ) / (m : ℝ)^2)
      atTop (𝓝 (integerProbe N a)) := by
  apply no_bounded_opposite_minimum_tate (fun N a => Module.finrank k (E N a))
  intro N
  letI := hW N
  exact ⟨Module.finrank k (W N), fun a => min_finrank_le_product_target _ _ _ (hprod N a)⟩

#print axioms RationalSectionSpaces.inverse_mem_and_span
#print axioms no_graded_section_dimension_tate
#print axioms no_fixed_product_target_tate

end GaloisForLFunctions.CountingHolography.Sections
