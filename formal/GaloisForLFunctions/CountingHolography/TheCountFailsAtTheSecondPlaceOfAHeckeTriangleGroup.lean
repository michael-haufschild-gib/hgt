import GaloisForLFunctions.ArithmeticScatteringHolography.TheKreinFluxLaw
import Mathlib.NumberTheory.Real.GoldenRatio
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.NumberTheory.Niven
import Mathlib.RingTheory.Polynomial.Dickson
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Minpoly.Field
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# The count fails at the second place of a Hecke triangle group

A unimodular element `γ` is a black hole of size `q = 1` at each real place `σ` of its trace field: its
probes `y − xγ` have the Krein square `𝒬^σ(x, y) = y² − σ(tr γ) xy + x²`. The review asks a count to
fail for non-arithmetic groups. Takeuchi's criterion [C] says that a Fuchsian group of finite covolume
is arithmetic iff the traces of its squares are algebraic integers generating a number field `k` and
every nonidentity embedding of `k` keeps them in `[−2, 2]`: at every place but one the group is a
rotation group. In the language of counts, **every place but the first counts nonnegatively**.

* **A place counts nonnegatively iff it is damped** (`placeCount_nonneg_iff`): `𝒬_t ≥ 0` on all integer
  probes iff `t² ≤ 4`, and the two probes `1 ∓ π` detect every failure.
* **The Hecke group `G₅`** is generated by `S` and `T = (1 φ; 0 1)`, `φ` the golden ratio, `2cos(π/5)`.
  Its words `γₙ = TⁿS` are the universal words over `ℤ[X]` at the two roots of `X² − X − 1`
  (`heckeWord_map`, `places_root`): the first place `X ↦ φ` gives `G₅`, the second `X ↦ ψ = (1 − √5)/2`
  its Galois conjugate.
* **The second place of `γₙ` counts nonnegatively exactly for `n ≤ 3`** (`secondPlace_nonneg_iff`), for
  `γₙ` and for `γₙ²` (`secondPlace_sq_nonneg_iff`), and the invariant traces `tr γₙ² = n²φ² − 2` are
  irrational for `n ≠ 0` (`trace_sq_irrational`), so the second place is a place of the invariant trace
  field. `γ₄ = T⁴S` has the negative count `4 − 2√5` at the probe `1 + π` (`fourth_word_negative`).
* **The arithmetic Hecke groups have no second place for these words** (`trace_sq_int_of_sq_int`): for
  `λ² ∈ ℤ` (`G₃ = SL₂(ℤ)`, `G₄`, `G₆`, with `λ = 1, √2, √3`), `tr γₙ² = n²λ² − 2` is an integer.

So the count fails for the first non-arithmetic Hecke group through the count itself, at its second
place, while at the first place `G₅` has the same dynamics as the arithmetic groups: a cusp, a
horocycle flow, hyperbolic words (`firstPlace_hyperbolic`).

**Every non-arithmetic Hecke group.** For `G_q = ⟨S, T_λ⟩`, `λ_q = 2cos(π/q)`, the traces of the squares
`tr γₙ² = n²λ_q² − 2` (`trace_sq_hecke`) lie in `ℚ(λ_q²)`, `λ_q² = 2 + 2cos(2π/q)`.

* **Niven**: for `q ≥ 3`, `λ_q²` is irrational unless `q ∈ {3, 4, 6}` (`irrational_heckeInvariant`); for
  `q = 3, 4, 6` it is `1, 2, 3` (`heckeInvariant_arith`) and `ℚ(λ_q²)` has one place
  (`arithmetic_one_place`).
* **The conjugates are real**: `λ_q²` is a root of `P_q = D_q(X − 2) − 2`, `D_q` the Dickson polynomial
  with `D_q(w + w⁻¹) = w^q + w^{-q}` (`heckePoly_aeval`), and every complex root of `P_q` is `2 + 2 Re w`
  with `w^q = 1` (`real_of_heckePoly_root`): real, in `[0, 4]`.
* **The second place** (`exists_second_place`, `hecke_count_fails`): for `q ∉ {3, 4, 6}` the minimal
  polynomial of `λ_q²` has a second real root `r ∈ (0, 4]`, the place `σ : ℚ(λ_q²) → ℝ`, `λ_q² ↦ r`, and
  the count of `γₙ²` at `σ` is negative at the probe `1 − π` as soon as `n² r > 4`.
-/

open Matrix Polynomial
open scoped goldenRatio

noncomputable section

namespace GaloisForLFunctions.CountingHolography

open ArithmeticScatteringHolography

/-! ### Counting at one place -/

/-- **A place counts nonnegatively iff it is damped.** The Krein square `y² − t xy + x²` of a unimodular
element is nonnegative on all integer probes iff `t² ≤ 4`. -/
theorem placeCount_nonneg_iff (t : ℝ) :
    (∀ x y : ℤ, 0 ≤ kreinSquare (1 : ℝ) t x y) ↔ t ^ 2 ≤ 4 := by
  constructor
  · intro h
    by_contra ht
    push Not at ht
    rcases lt_or_gt_of_ne (show t ≠ 0 by rintro rfl; norm_num at ht) with htn | htp
    · -- `t < −2`: the probe `1 + π` is negative
      have h1 := h (-1) 1
      simp only [kreinSquare] at h1
      push_cast at h1
      nlinarith
    · -- `t > 2`: the probe `1 − π` is negative
      have h1 := h 1 1
      simp only [kreinSquare] at h1
      push_cast at h1
      nlinarith
  · intro ht x y
    simp only [kreinSquare]
    -- `y² − txy + x² = (y − tx/2)² + (4 − t²) x²/4`
    nlinarith [sq_nonneg ((y : ℝ) - t * x / 2), mul_nonneg (sub_nonneg.mpr ht) (sq_nonneg (x : ℝ))]

/-! ### The words of a Hecke triangle group -/

section Words

variable {R : Type*} [CommRing R]

/-- The translation `z ↦ z + λ`. -/
def heckeT (l : R) : Matrix (Fin 2) (Fin 2) R := !![1, l; 0, 1]

/-- The inversion `z ↦ −1/z`. -/
def heckeS : Matrix (Fin 2) (Fin 2) R := !![0, -1; 1, 0]

theorem heckeT_pow (l : R) (n : ℕ) : heckeT l ^ n = !![1, n * l; 0, 1] := by
  induction n with
  | zero =>
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  | succ n ih =>
    rw [pow_succ, ih, heckeT]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
    ring

/-- The word `γₙ = TⁿS`. -/
theorem heckeWord_eq (l : R) (n : ℕ) : heckeT l ^ n * heckeS = !![n * l, -1; 1, 0] := by
  rw [heckeT_pow, heckeS]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

theorem trace_heckeWord (l : R) (n : ℕ) : (heckeT l ^ n * heckeS).trace = n * l := by
  rw [heckeWord_eq, trace_fin_two]
  simp

theorem det_heckeWord (l : R) (n : ℕ) : (heckeT l ^ n * heckeS).det = 1 := by
  rw [heckeWord_eq, det_fin_two]
  simp

/-- The trace of the square: `tr γ² = (tr γ)² − 2`. -/
theorem trace_heckeWord_sq (l : R) (n : ℕ) : ((heckeT l ^ n * heckeS) ^ 2).trace = (n * l) ^ 2 - 2 := by
  rw [heckeWord_eq, sq, trace_fin_two]
  simp [Matrix.mul_apply, Fin.sum_univ_two]
  ring

end Words

/-! ### The two places of `ℤ[φ]` -/

/-- The real place `X ↦ t` of `ℤ[X]`. -/
def place (t : ℝ) : ℤ[X] →+* ℝ := eval₂RingHom (Int.castRingHom ℝ) t

/-- `φ` and `ψ` are the two roots of `X² − X − 1`, so the places `X ↦ φ` and `X ↦ ψ` are the two real
places of `ℤ[X]/(X² − X − 1) = ℤ[φ]`, exchanged by the Galois conjugation of `ℚ(√5)`. -/
theorem places_root : place φ (X ^ 2 - X - 1) = 0 ∧ place ψ (X ^ 2 - X - 1) = 0 ∧ φ ≠ ψ := by
  refine ⟨?_, ?_, ?_⟩
  · simp only [place, coe_eval₂RingHom, eval₂_sub, eval₂_X_pow, eval₂_X, eval₂_one]
    rw [Real.goldenRatio_sq]
    ring
  · simp only [place, coe_eval₂RingHom, eval₂_sub, eval₂_X_pow, eval₂_X, eval₂_one]
    rw [Real.goldenConj_sq]
    ring
  · intro h
    have := Real.goldenRatio_sub_goldenConj
    rw [h, sub_self] at this
    have h5 : (0 : ℝ) < √5 := Real.sqrt_pos.mpr (by norm_num)
    linarith

/-- **The words of `G₅` and of its conjugate are one universal word at two places.** -/
theorem heckeWord_map (t : ℝ) (n : ℕ) :
    (heckeT (X : ℤ[X]) ^ n * heckeS).map (place t) = heckeT t ^ n * heckeS := by
  rw [heckeWord_eq, heckeWord_eq]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [place]

/-! ### The second place of `G₅` -/

theorem sqrt_five_bounds : 2 < √5 ∧ √5 < 9 / 4 := by
  have h5 : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have h0 : 0 ≤ √5 := Real.sqrt_nonneg 5
  constructor <;> nlinarith

/-- **The second place of `γₙ` is damped exactly for `n ≤ 3`**: `(nψ)² ≤ 4 ↔ n ≤ 3`. -/
theorem secondPlace_damped_iff (n : ℕ) : ((n : ℝ) * ψ) ^ 2 ≤ 4 ↔ n ≤ 3 := by
  obtain ⟨hlo, hup⟩ := sqrt_five_bounds
  have h5 : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hψ : ψ = (1 - √5) / 2 := rfl
  constructor
  · intro h
    by_contra hn
    push Not at hn
    have hn4 : (4 : ℝ) ≤ n := by exact_mod_cast hn
    have hle : ((4 : ℝ) * ψ) ^ 2 ≤ ((n : ℝ) * ψ) ^ 2 := by
      rw [mul_pow, mul_pow]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by norm_num) hn4 2) (sq_nonneg _)
    have e4 : ((4 : ℝ) * ψ) ^ 2 = 24 - 8 * √5 := by
      rw [hψ]
      linear_combination 4 * h5
    linarith
  · intro hn
    interval_cases n <;> rw [hψ] <;> push_cast <;> nlinarith

/-- **The count of `γₙ` at the second place is nonnegative exactly for `n ≤ 3`.** -/
theorem secondPlace_nonneg_iff (n : ℕ) :
    (∀ x y : ℤ, 0 ≤ kreinSquare (1 : ℝ) (heckeT ψ ^ n * heckeS).trace x y) ↔ n ≤ 3 := by
  rw [trace_heckeWord, placeCount_nonneg_iff, secondPlace_damped_iff]

/-- **The same for the squares**, the elements of the invariant trace field: the count of `γₙ²` at the
second place is nonnegative exactly for `n ≤ 3`. -/
theorem secondPlace_sq_nonneg_iff (n : ℕ) :
    (∀ x y : ℤ, 0 ≤ kreinSquare (1 : ℝ) ((heckeT ψ ^ n * heckeS) ^ 2).trace x y) ↔ n ≤ 3 := by
  rw [trace_heckeWord_sq, placeCount_nonneg_iff, ← secondPlace_damped_iff]
  have h0 := sq_nonneg ((n : ℝ) * ψ)
  constructor
  · intro h
    nlinarith
  · intro h
    nlinarith

/-- **The invariant traces of `G₅` are irrational**: `tr γₙ² = n²φ² − 2` for `n ≠ 0`. -/
theorem trace_sq_irrational {n : ℕ} (hn : n ≠ 0) :
    Irrational ((heckeT φ ^ n * heckeS) ^ 2).trace := by
  rw [trace_heckeWord_sq]
  have e : ((n : ℝ) * φ) ^ 2 - 2 = ((n ^ 2 : ℕ) : ℝ) * φ + ((n ^ 2 : ℕ) - 2 : ℤ) := by
    push_cast
    rw [mul_pow, Real.goldenRatio_sq]
    ring
  rw [e]
  exact (Real.goldenRatio_irrational.natCast_mul (pow_ne_zero 2 hn)).add_intCast _

/-- **`γ₄ = T⁴S` fails at the second place**: its count at the probe `1 + π` is `4 − 2√5 < 0`. -/
theorem fourth_word_negative :
    kreinSquare (1 : ℝ) (heckeT ψ ^ 4 * heckeS).trace (-1) 1 = 4 - 2 * √5 ∧ 4 - 2 * √5 < 0 := by
  refine ⟨?_, by linarith [sqrt_five_bounds.1]⟩
  rw [trace_heckeWord, kreinSquare]
  push_cast
  ring

/-- **At the first place the words are hyperbolic**: `tr γₙ = nφ > 2` for `n ≥ 2`, as in `SL₂(ℤ)`. -/
theorem firstPlace_hyperbolic {n : ℕ} (hn : 2 ≤ n) : 2 < (heckeT φ ^ n * heckeS).trace := by
  rw [trace_heckeWord]
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  nlinarith [Real.one_lt_goldenRatio]

/-- **The arithmetic Hecke groups have no second place for these words.** If `λ² = m ∈ ℤ`
(`λ = 1, √2, √3` for `G₃ = SL₂(ℤ)`, `G₄`, `G₆`), then `tr γₙ² = n² m − 2` is an integer. -/
theorem trace_sq_int_of_sq_int {l : ℝ} {m : ℤ} (hl : l ^ 2 = m) (n : ℕ) :
    ((heckeT l ^ n * heckeS) ^ 2).trace = ((n ^ 2 * m - 2 : ℤ) : ℝ) := by
  rw [trace_heckeWord_sq, mul_pow, hl]
  push_cast
  ring

/-! ### Every non-arithmetic Hecke group -/

section General

open IntermediateField Real

/-- The translation length `λ_q = 2 cos(π/q)` of the Hecke group `G_q`. -/
def heckeLength (q : ℕ) : ℝ := 2 * Real.cos (π / q)

/-- `λ_q² = 2 + 2 cos(2π/q)`: the traces of the squares of the words `TⁿS` lie in `ℚ(λ_q²)`. -/
def heckeInvariant (q : ℕ) : ℝ := 2 + 2 * Real.cos (2 * π / q)

theorem heckeLength_sq (q : ℕ) : heckeLength q ^ 2 = heckeInvariant q := by
  unfold heckeLength heckeInvariant
  rw [mul_pow, Real.cos_sq, show 2 * (π / q) = 2 * π / q by ring]
  ring

/-- The invariant traces of the words of `G_q`: `tr γₙ² = n² λ_q² − 2`. -/
theorem trace_sq_hecke (q n : ℕ) :
    ((heckeT (heckeLength q) ^ n * heckeS) ^ 2).trace = (n : ℝ) ^ 2 * heckeInvariant q - 2 := by
  rw [trace_heckeWord_sq, mul_pow, heckeLength_sq]

theorem heckeInvariant_pos {q : ℕ} (hq : 3 ≤ q) : 0 < heckeInvariant q := by
  have hq' : (3 : ℝ) ≤ q := by exact_mod_cast hq
  have h1 : 0 ≤ 2 * π / q := by positivity
  have h2 : 2 * π / q < π := by
    rw [div_lt_iff₀ (by linarith)]
    nlinarith [Real.pi_pos]
  have h := Real.strictAntiOn_cos ⟨h1, h2.le⟩ ⟨Real.pi_pos.le, le_rfl⟩ h2
  rw [Real.cos_pi] at h
  unfold heckeInvariant
  linarith

/-- The arithmetic Hecke groups: `λ_q² = 1, 2, 3` for `q = 3, 4, 6`. -/
theorem heckeInvariant_arith :
    heckeInvariant 3 = 1 ∧ heckeInvariant 4 = 2 ∧ heckeInvariant 6 = 3 := by
  unfold heckeInvariant
  refine ⟨?_, ?_, ?_⟩
  · rw [show 2 * π / ((3 : ℕ) : ℝ) = π - π / 3 by push_cast; ring, Real.cos_pi_sub,
      Real.cos_pi_div_three]
    norm_num
  · rw [show 2 * π / ((4 : ℕ) : ℝ) = π / 2 by push_cast; ring, Real.cos_pi_div_two]
    norm_num
  · rw [show 2 * π / ((6 : ℕ) : ℝ) = π / 3 by push_cast; ring, Real.cos_pi_div_three]
    norm_num

/-- **Niven at the Hecke groups.** For `q ≥ 3`, `λ_q²` is irrational unless `q ∈ {3, 4, 6}`. -/
theorem irrational_heckeInvariant {q : ℕ} (hq : 3 ≤ q) (h3 : q ≠ 3) (h4 : q ≠ 4) (h6 : q ≠ 6) :
    Irrational (heckeInvariant q) := by
  -- `2π/q = r π` with a denominator `> 3`
  obtain ⟨r, hr, hden⟩ : ∃ r : ℚ, 2 * π / q = r * π ∧ 3 < r.den := by
    rcases Nat.even_or_odd q with ⟨m, hm⟩ | ⟨m, hm⟩
    · refine ⟨(m : ℚ)⁻¹, ?_, ?_⟩
      · have hm0 : (m : ℝ) ≠ 0 := by
          have : m ≠ 0 := by omega
          exact_mod_cast this
        subst hm
        push_cast
        field_simp
        ring
      · rw [Rat.inv_natCast_den_of_pos (by omega)]
        omega
    · refine ⟨((2 : ℤ) : ℚ) / (((2 * m + 1 : ℕ) : ℤ) : ℚ), ?_, ?_⟩
      · subst hm
        push_cast
        field_simp
      · have h := Rat.den_div_eq_of_coprime (a := 2) (b := ((2 * m + 1 : ℕ) : ℤ)) (by omega)
          (by
            show Nat.Coprime 2 (2 * m + 1)
            rw [show 2 * m + 1 = m * 2 + 1 by ring]
            exact (Nat.coprime_mul_right_add_right 2 1 m).mpr (Nat.coprime_one_right 2))
        omega
  have hcos : Irrational (Real.cos (r * π)) := irrational_cos_rat_mul_pi hden
  unfold heckeInvariant
  rw [hr]
  have := (hcos.natCast_mul (m := 2) two_ne_zero).natCast_add 2
  push_cast at this
  exact this

theorem isIntegral_heckeInvariant (q : ℕ) : IsIntegral ℚ (heckeInvariant q) := by
  have h : heckeInvariant q = (1 + 1) + 2 * Real.cos (((2 / q : ℚ) : ℝ) * π) := by
    unfold heckeInvariant
    push_cast
    ring_nf
  have hz : IsIntegral ℤ (heckeInvariant q) := by
    rw [h]
    exact (isIntegral_one.add isIntegral_one).add (Real.isIntegral_two_mul_cos_rat_mul_pi _)
  exact hz.tower_top

/-- `P_q = D_q(X − 2) − 2`, `D_q` the Dickson polynomial with `D_q(w + w⁻¹) = w^q + w^{-q}`. -/
def heckePoly (R : Type*) [CommRing R] (q : ℕ) : R[X] := (dickson 1 (1 : R) q).comp (X - C 2) - C 2

theorem heckePoly_map {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (q : ℕ) :
    (heckePoly R q).map f = heckePoly S q := by
  simp only [heckePoly, Polynomial.map_sub, Polynomial.map_comp, map_dickson, Polynomial.map_X,
    Polynomial.map_ofNat, map_one, map_ofNat]

theorem eval_heckePoly_add {w w' : ℂ} (h : w * w' = 1) (q : ℕ) :
    (heckePoly ℂ q).eval (w + w' + 2) = w ^ q + w' ^ q - 2 := by
  simp [heckePoly, eval_comp, dickson_one_one_eval_add_inv w w' h]

/-- **`λ_q²` is a root of `P_q`**: `λ_q² − 2 = w + w⁻¹` with `w = e^{2πi/q}`, `w^q = 1`. -/
theorem heckePoly_aeval {q : ℕ} (hq : 1 ≤ q) : aeval (heckeInvariant q) (heckePoly ℚ q) = 0 := by
  apply Complex.ofReal_injective
  rw [Complex.ofReal_zero, ← Complex.coe_algebraMap, ← aeval_algebraMap_apply, aeval_def,
    eval₂_eq_eval_map, heckePoly_map]
  set θ : ℂ := 2 * π / q
  have hq0 : (q : ℂ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hα : algebraMap ℝ ℂ (heckeInvariant q) =
      Complex.exp (θ * Complex.I) + Complex.exp (-θ * Complex.I) + 2 := by
    rw [Complex.coe_algebraMap]
    unfold heckeInvariant
    push_cast
    rw [Complex.cos.eq_1]
    simp only [θ]
    ring_nf
  have hww : Complex.exp (θ * Complex.I) * Complex.exp (-θ * Complex.I) = 1 := by
    rw [← Complex.exp_add]
    ring_nf
    exact Complex.exp_zero
  rw [hα, eval_heckePoly_add hww, ← Complex.exp_nat_mul, ← Complex.exp_nat_mul]
  have e1 : (q : ℂ) * (θ * Complex.I) = 2 * π * Complex.I := by
    simp only [θ]
    field_simp
  have e2 : (q : ℂ) * (-θ * Complex.I) = -(2 * π * Complex.I) := by
    simp only [θ]
    field_simp
  rw [e1, e2, Complex.exp_neg, Complex.exp_two_pi_mul_I]
  norm_num

/-- **Every root of `P_q` is real and lies in `[0, 4]`**: it is `2 + 2 Re w` with `w^q = 1`. -/
theorem real_of_heckePoly_root {q : ℕ} (hq : 1 ≤ q) {β : ℂ} (hβ : (heckePoly ℂ q).eval β = 0) :
    β.im = 0 ∧ 0 ≤ β.re ∧ β.re ≤ 4 := by
  obtain ⟨s, hs⟩ := IsAlgClosed.exists_eq_mul_self ((β - 2) ^ 2 - 4)
  set w := ((β - 2) + s) / 2
  set w' := ((β - 2) - s) / 2
  have hww : w * w' = 1 := by
    simp only [w, w']
    linear_combination (1 / 4 : ℂ) * hs
  have hsum : w + w' + 2 = β := by
    simp only [w, w']
    ring
  rw [← hsum, eval_heckePoly_add hww] at hβ
  -- `w^q + w'^q = 2` and `w^q w'^q = 1` force `w^q = 1`
  have hp : w ^ q * w' ^ q = 1 := by rw [← mul_pow, hww, one_pow]
  have hwq : w ^ q = 1 := by
    have : (w ^ q - 1) ^ 2 = 0 := by linear_combination (w ^ q) * hβ - hp
    exact sub_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp this)
  have hnorm : ‖w‖ = 1 := by
    have : ‖w‖ ^ q = 1 := by rw [← norm_pow, hwq, norm_one]
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg w) (by omega)).mp this
  -- `w' = w⁻¹ = conj w`
  have hw0 : w ≠ 0 := by
    intro h
    rw [h, norm_zero] at hnorm
    exact zero_ne_one hnorm
  have hw' : w' = (starRingEnd ℂ) w := by
    have hinv : w' = w⁻¹ := (eq_inv_of_mul_eq_one_right hww)
    rw [hinv, Complex.inv_def, Complex.normSq_eq_norm_sq, hnorm]
    simp
  have hβ' : β = (2 * w.re + 2 : ℝ) := by
    rw [← hsum, hw', Complex.add_conj]
    push_cast
    ring
  have hre := Complex.abs_re_le_norm w
  rw [hnorm, abs_le] at hre
  rw [hβ', Complex.ofReal_im, Complex.ofReal_re]
  refine ⟨rfl, ?_, ?_⟩ <;> linarith [hre.1, hre.2]

/-- **The second place of a non-arithmetic Hecke group.** For `q ≥ 3`, `q ∉ {3, 4, 6}`, the minimal
polynomial of `λ_q²` has a real root `r ≠ λ_q²` with `0 < r ≤ 4`. -/
theorem exists_second_place {q : ℕ} (hq : 3 ≤ q) (h3 : q ≠ 3) (h4 : q ≠ 4) (h6 : q ≠ 6) :
    ∃ r ∈ (minpoly ℚ (heckeInvariant q)).aroots ℝ, r ≠ heckeInvariant q ∧ 0 < r ∧ r ≤ 4 := by
  have hint := isIntegral_heckeInvariant q
  have hirr := irrational_heckeInvariant hq h3 h4 h6
  -- the minimal polynomial has degree at least two
  have hdeg : 2 ≤ (minpoly ℚ (heckeInvariant q)).natDegree := by
    have h0 := minpoly.natDegree_pos hint
    have h1 : (minpoly ℚ (heckeInvariant q)).natDegree ≠ 1 := by
      intro h
      obtain ⟨r, hr⟩ := (minpoly.natDegree_eq_one_iff).mp h
      exact hirr ⟨r, hr⟩
    omega
  set α := heckeInvariant q
  set p := minpoly ℚ α
  have hp0 : p ≠ 0 := minpoly.ne_zero hint
  have hdvd : p ∣ heckePoly ℚ q := minpoly.dvd ℚ α (heckePoly_aeval (by omega))
  -- two distinct complex roots
  have hsep : p.Separable := (minpoly.irreducible hint).separable
  have hcard : (p.aroots ℂ).card = p.natDegree := IsAlgClosed.card_aroots_eq_natDegree
  have hnodup : (p.aroots ℂ).Nodup := nodup_roots (hsep.map)
  obtain ⟨β, hβ, hβα⟩ : ∃ β ∈ p.aroots ℂ, β ≠ (α : ℂ) := by
    by_contra hcon
    push Not at hcon
    have hsub : (p.aroots ℂ).toFinset ⊆ {(α : ℂ)} := fun x hx =>
      Finset.mem_singleton.mpr (hcon x (Multiset.mem_toFinset.mp hx))
    have := Finset.card_le_card hsub
    rw [Multiset.toFinset_card_of_nodup hnodup, hcard, Finset.card_singleton] at this
    omega
  -- `β` is a root of `P_q`, hence real in `[0, 4]`
  have hβp : aeval β p = 0 := (mem_aroots.mp hβ).2
  have hβP : (heckePoly ℂ q).eval β = 0 := by
    rw [← heckePoly_map (algebraMap ℚ ℂ)]
    refine eval_eq_zero_of_dvd_of_eval_eq_zero (Polynomial.map_dvd _ hdvd) ?_
    rwa [aeval_def, eval₂_eq_eval_map] at hβp
  obtain ⟨him, hre0, hre4⟩ := real_of_heckePoly_root (by omega) hβP
  have hβr : β = (β.re : ℂ) := Complex.ext rfl (by simp [him])
  refine ⟨β.re, ?_, ?_, ?_, hre4⟩
  · rw [mem_aroots]
    refine ⟨hp0, ?_⟩
    apply Complex.ofReal_injective
    rw [Complex.ofReal_zero, ← Complex.coe_algebraMap, ← aeval_algebraMap_apply,
      Complex.coe_algebraMap, ← hβr, hβp]
  · intro h
    apply hβα
    rw [hβr, h]
  · rcases hre0.eq_or_lt with h | h
    · exfalso
      have hc := minpoly.coeff_zero_ne_zero hint (heckeInvariant_pos hq).ne'
      apply hc
      have h0 : β = 0 := by rw [hβr, ← h, Complex.ofReal_zero]
      rw [h0, ← coeff_zero_eq_aeval_zero'] at hβp
      exact (FaithfulSMul.algebraMap_injective ℚ ℂ) (by rw [hβp, map_zero])
    · exact h

/-- **Every non-arithmetic Hecke group fails through the count at a second place.** For `q ≥ 3`,
`q ∉ {3, 4, 6}`, there is a place `σ : ℚ(λ_q²) → ℝ` other than the inclusion and a word `γₙ = TⁿS` whose
square `γₙ²`, of trace `n² λ_q² − 2`, has a negative count at `σ` on the probe `1 − π`. -/
theorem hecke_count_fails {q : ℕ} (hq : 3 ≤ q) (h3 : q ≠ 3) (h4 : q ≠ 4) (h6 : q ≠ 6) :
    ∃ σ : ℚ⟮heckeInvariant q⟯ →ₐ[ℚ] ℝ, σ (AdjoinSimple.gen ℚ (heckeInvariant q)) ≠ heckeInvariant q ∧
      ∃ n : ℕ, kreinSquare (1 : ℝ)
        (σ ((n : ℚ⟮heckeInvariant q⟯) ^ 2 * AdjoinSimple.gen ℚ (heckeInvariant q) - 2)) 1 1 < 0 := by
  obtain ⟨r, hr, hrα, hr0, -⟩ := exists_second_place hq h3 h4 h6
  obtain ⟨σ, hσ⟩ : ∃ σ : ℚ⟮heckeInvariant q⟯ →ₐ[ℚ] ℝ, σ (AdjoinSimple.gen ℚ (heckeInvariant q)) = r :=
    ⟨_, algHomAdjoinIntegralEquiv_symm_apply_gen ℚ (isIntegral_heckeInvariant q) ⟨r, hr⟩⟩
  refine ⟨σ, fun h => hrα (hσ.symm.trans h), ?_⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (4 / r)
  refine ⟨n, ?_⟩
  simp only [map_sub, map_mul, map_pow, map_natCast, map_ofNat, hσ, kreinSquare]
  have h4r : 0 < 4 / r := by positivity
  have hn1 : (1 : ℝ) ≤ n := by
    have : 0 < (n : ℝ) := lt_trans h4r hn
    have : 0 < n := by exact_mod_cast this
    exact_mod_cast this
  have hnr : 4 < (n : ℝ) * r := by rwa [div_lt_iff₀ hr0] at hn
  nlinarith

/-- At the first place the argument of `hecke_count_fails` is the invariant trace of `γₙ²`. -/
theorem firstPlace_trace (q n : ℕ) :
    (((n : ℚ⟮heckeInvariant q⟯) ^ 2 * AdjoinSimple.gen ℚ (heckeInvariant q) - 2 : ℚ⟮heckeInvariant q⟯) : ℝ) =
      ((heckeT (heckeLength q) ^ n * heckeS) ^ 2).trace := by
  rw [trace_sq_hecke]
  push_cast [AdjoinSimple.coe_gen]
  rfl

/-- **The arithmetic Hecke groups have one place.** For `q = 3, 4, 6` every place of `ℚ(λ_q²)` fixes
`λ_q²`. -/
theorem arithmetic_one_place {q : ℕ} (hq : q = 3 ∨ q = 4 ∨ q = 6)
    (σ : ℚ⟮heckeInvariant q⟯ →ₐ[ℚ] ℝ) :
    σ (AdjoinSimple.gen ℚ (heckeInvariant q)) = heckeInvariant q := by
  obtain ⟨m, hm⟩ : ∃ m : ℕ, heckeInvariant q = m := by
    obtain ⟨e3, e4, e6⟩ := heckeInvariant_arith
    rcases hq with rfl | rfl | rfl
    · exact ⟨1, by rw [e3]; norm_num⟩
    · exact ⟨2, by rw [e4]; norm_num⟩
    · exact ⟨3, by rw [e6]; norm_num⟩
  have hgen : AdjoinSimple.gen ℚ (heckeInvariant q) = (m : ℚ⟮heckeInvariant q⟯) := by
    apply Subtype.ext
    simp [AdjoinSimple.coe_gen, hm]
  rw [hgen, map_natCast, hm]

