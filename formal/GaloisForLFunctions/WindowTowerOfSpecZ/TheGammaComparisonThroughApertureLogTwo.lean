  linarith

theorem gammaChebyshevCoshPoly_le_inv_cosh {z : ℝ} (h0 : 0 ≤ z) (h7 : z ≤ 7 / 10) :
    gammaChebyshevCoshPoly (z ^ 2) ≤ 1 / Real.cosh z := by
  have h1 : z ≤ 1 := by linarith
  have hs0 : 0 ≤ z ^ 2 := sq_nonneg z
  have hs1 : z ^ 2 ≤ 49 / 100 := by nlinarith
  have hCu := (abs_le.mp (hyperbolic_taylor25_bounds h0 h1).2).2
  have hz25 : z ^ 25 ≤ z ^ 24 := pow_le_pow_of_le_one h0 h1 (by norm_num)
  have hcup : Real.cosh z ≤ coshUpperPoly12 (z ^ 2) := by
    have heq : coshTaylor24 z + 4 * z ^ 24 / 15511210043330985984000000 = coshUpperPoly12 (z ^ 2) := by
      unfold coshTaylor24 coshUpperPoly12
      ring
    linarith
  have hQ0 := gammaChebyshevCoshPoly_nonneg hs0 hs1
  have hprod := gammaChebyshevCoshPoly_mul_upper_le_one hs0 hs1
  apply (le_div_iff₀ (Real.cosh_pos z)).mpr
  exact (mul_le_mul_of_nonneg_left hcup hQ0).trans hprod

