  have hden : (0 : ℝ) < (49 / 100 : ℝ) ^ 23 := by positivity
  have hdiff : 0 ≤ (1 - gammaChebyshevCoshPoly s * coshUpperPoly12 s) - coshProdFactorWitness s := by
