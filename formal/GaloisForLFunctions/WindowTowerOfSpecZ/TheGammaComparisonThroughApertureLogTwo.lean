      ( /  : ℝ) * s ^ 12 * ((49 / 100 : ℝ) - s) ^ 11 + ( /  : ℝ) * s ^ 13 * ((49 / 100 : ℝ) - s) ^ 10 +
      ( /  : ℝ) * s ^ 14 * ((49 / 100 : ℝ) - s) ^ 9 + ( /  : ℝ) * s ^ 15 * ((49 / 100 : ℝ) - s) ^ 8 +
      ( /  : ℝ) * s ^ 16 * ((49 / 100 : ℝ) - s) ^ 7 + ( /  : ℝ) * s ^ 17 * ((49 / 100 : ℝ) - s) ^ 6 +
      ( /  : ℝ) * s ^ 18 * ((49 / 100 : ℝ) - s) ^ 5 + ( /  : ℝ) * s ^ 19 * ((49 / 100 : ℝ) - s) ^ 4 +
      ( /  : ℝ) * s ^ 20 * ((49 / 100 : ℝ) - s) ^ 3 + ( /  : ℝ) * s ^ 21 * ((49 / 100 : ℝ) - s) ^ 2 +
      ( /  : ℝ) * s ^ 22 * ((49 / 100 : ℝ) - s) + ( /  : ℝ) * s ^ 23 := by
    unfold gammaChebyshevCoshPoly coshUpperPoly12 coshProdFactorWitness
    ring
