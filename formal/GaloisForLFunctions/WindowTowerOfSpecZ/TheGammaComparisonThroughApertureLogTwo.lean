/-! ### Degree-22 reciprocal `sinh` lower bound on `(0, 1]` -/

/-- Degree-22 reciprocal Taylor polynomial for `z / sinh z`. -/
def gammaSinhPolynomial22 (z : ℝ) : ℝ :=
  (1 : ℝ) + (-1 / 6 : ℝ) * z ^ 2 + (7 / 360 : ℝ) * z ^ 4 +
    (-31 / 15120 : ℝ) * z ^ 6 + (127 / 604800 : ℝ) * z ^ 8 + (-73 / 3421440 : ℝ) * z ^ 10 +
    (1414477 / 653837184000 : ℝ) * z ^ 12 + (-8191 / 37362124800 : ℝ) * z ^ 14 + (16931177 / 762187345920000 : ℝ) * z ^ 16 +
    (-5749691557 / 2554547108585472000 : ℝ) * z ^ 18 + (91546277357 / 401428831349145600000 : ℝ) * z ^ 20 + (-3324754717 / 143888775912161280000 : ℝ) * z ^ 22

private def sinhTaylor23 (z : ℝ) : ℝ :=
  (1 : ℝ) * z + (1 / 6 : ℝ) * z ^ 3 + (1 / 120 : ℝ) * z ^ 5 +
    (1 / 5040 : ℝ) * z ^ 7 + (1 / 362880 : ℝ) * z ^ 9 + (1 / 39916800 : ℝ) * z ^ 11 +
    (1 / 6227020800 : ℝ) * z ^ 13 + (1 / 1307674368000 : ℝ) * z ^ 15 + (1 / 355687428096000 : ℝ) * z ^ 17 +
    (1 / 121645100408832000 : ℝ) * z ^ 19 + (1 / 51090942171709440000 : ℝ) * z ^ 21 + (1 / 25852016738884976640000 : ℝ) * z ^ 23

private def coshTaylor24 (z : ℝ) : ℝ :=
  (1 : ℝ) + (1 / 2 : ℝ) * z ^ 2 + (1 / 24 : ℝ) * z ^ 4 +
    (1 / 720 : ℝ) * z ^ 6 + (1 / 40320 : ℝ) * z ^ 8 + (1 / 3628800 : ℝ) * z ^ 10 +
    (1 / 479001600 : ℝ) * z ^ 12 + (1 / 87178291200 : ℝ) * z ^ 14 + (1 / 20922789888000 : ℝ) * z ^ 16 +
    (1 / 6402373705728000 : ℝ) * z ^ 18 + (1 / 2432902008176640000 : ℝ) * z ^ 20 + (1 / 1124000727777607680000 : ℝ) * z ^ 22 +
    (1 / 620448401733239439360000 : ℝ) * z ^ 24

private theorem hyperbolic_taylor25_bounds {z : ℝ} (h0 : 0 ≤ z) (h1 : z ≤ 1) :
    |Real.sinh z - sinhTaylor23 z| ≤ 4 * z ^ 25 / 15511210043330985984000000 ∧
      |Real.cosh z - coshTaylor24 z| ≤ 4 * z ^ 25 / 15511210043330985984000000 := by
  have hz : |z| ≤ 1 := by rwa [abs_of_nonneg h0]
  have hnz : |-z| ≤ 1 := by simpa only [abs_neg] using hz
  have hp := Real.exp_bound hz (n := 25) (by norm_num)
  have hm := Real.exp_bound hnz (n := 25) (by norm_num)
  norm_num [Finset.sum_range_succ, Nat.factorial, abs_neg, abs_of_nonneg h0] at hp hm
  obtain ⟨hpl, hpu⟩ := abs_le.mp hp
  obtain ⟨hml, hmu⟩ := abs_le.mp hm
  have h25 := pow_nonneg h0 25
  constructor
  · rw [Real.sinh_eq, abs_le]
    dsimp only [sinhTaylor23]
    constructor <;> linarith
  · rw [Real.cosh_eq, abs_le]
    dsimp only [coshTaylor24]
    constructor <;> linarith

private theorem gammaSinhPolynomial22_bounds {z : ℝ} (h0 : 0 ≤ z) (h1 : z ≤ 1) :
    0 ≤ gammaSinhPolynomial22 z ∧ gammaSinhPolynomial22 z ≤ 2 := by
  have hb (n : ℕ) : 0 ≤ z ^ n ∧ z ^ n ≤ 1 :=
    ⟨pow_nonneg h0 n, by simpa only [one_pow] using pow_le_pow_left₀ h0 h1 n⟩
  dsimp only [gammaSinhPolynomial22]
  constructor
  · linarith [(hb 2).2, (hb 4).1, (hb 6).2, (hb 8).1, (hb 10).2, (hb 12).1,
      (hb 14).2, (hb 16).1, (hb 18).2, (hb 20).1, (hb 22).2]
  · linarith [(hb 2).1, (hb 4).2, (hb 6).1, (hb 8).2, (hb 10).1, (hb 12).2,
      (hb 14).1, (hb 16).2, (hb 18).1, (hb 20).2, (hb 22).1]

private theorem gammaSinhPolynomial22_product {z : ℝ} (h0 : 0 ≤ z) :
    gammaSinhPolynomial22 z * sinhTaylor23 z +
      8 * z ^ 25 / 15511210043330985984000000 ≤ z := by
  have hn (n : ℕ) : 0 ≤ z ^ n := pow_nonneg h0 n
  dsimp only [gammaSinhPolynomial22, sinhTaylor23]
  ring_nf
  linarith [hn 25, hn 27, hn 29, hn 31, hn 33, hn 35, hn 37, hn 39, hn 41, hn 43, hn 45]

theorem gammaSinhPolynomial22_le_div_sinh {z : ℝ} (h0 : 0 < z) (h1 : z ≤ 1) :
    gammaSinhPolynomial22 z ≤ z / Real.sinh z := by
  have hSu := (abs_le.mp (hyperbolic_taylor25_bounds h0.le h1).1).2
  obtain ⟨hP0, hP2⟩ := gammaSinhPolynomial22_bounds h0.le h1
  have hPS := gammaSinhPolynomial22_product h0.le
  have hrem : 0 ≤ 4 * z ^ 25 / 15511210043330985984000000 := by positivity
  apply (le_div_iff₀ (Real.sinh_pos_iff.mpr h0)).mpr
  have h := mul_le_mul_of_nonneg_left hSu hP0
  have hr := mul_le_mul_of_nonneg_right hP2 hrem
  nlinarith [h, hr, hPS]

