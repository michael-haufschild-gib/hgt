  have hw0 : 0 ≤ coshProdFactorWitness s := by
    unfold coshProdFactorWitness
    positivity
  have hid : (49 / 100 : ℝ) ^ 23 *
      ((1 - gammaChebyshevCoshPoly s * coshUpperPoly12 s) - coshProdFactorWitness s) =
      ( /  : ℝ) * ((49 / 100 : ℝ) - s) ^ 23 + ( /  : ℝ) * s * ((49 / 100 : ℝ) - s) ^ 22 +
