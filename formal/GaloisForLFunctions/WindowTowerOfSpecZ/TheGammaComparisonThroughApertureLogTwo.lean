      ( /  : ℝ) * t ^ 20 * ((7 / 5 : ℝ) - t) ^ 2 + ( /  : ℝ) * t ^ 21 * ((7 / 5 : ℝ) - t) +
      ( /  : ℝ) * t ^ 22 := by
    unfold gammaTailEvenLowerPoly gammaTailFactorWitness
    ring
  have hbern : 0 ≤ (7 / 5 : ℝ) ^ 22 *
      (((-73 / 3503554560 : ℝ) * t ^ 9 + (1414477 / 2678117105664000 : ℝ) * t ^ 11 + (-8191 / 612141052723200 : ℝ) * t ^ 13 + (16931177 / 49950709902213120000 : ℝ) * t ^ 15 + (-5749691557 / 669659197233029971968000 : ℝ) * t ^ 17 + (91546277357 / 420928638260761696665600000 : ℝ) * t ^ 19 + (-3324754717 / 603513268363481705349120000 : ℝ) * t ^ 21 -
        gammaTailEvenLowerPoly t) - gammaTailFactorWitness t) := by
    rw [hid]
    have ht_nn : 0 ≤ t := ht0.le
    positivity
  have hden : (0 : ℝ) < (7 / 5 : ℝ) ^ 22 := by positivity
  nlinarith

/-- Retained degree-22 polynomial lower bound for `retainedGammaRemainderWeight` on `(0, 7 / 5]`. -/
def retainedGammaPolyRem (t : ℝ) : ℝ :=
  7 * t ^ 3 / 5760 - 31 * t ^ 5 / 967680 + 127 * t ^ 7 / 154828800 +
    ∑ q ∈ Finset.range 12, gammaAlphaEven q * t ^ (2 * q)

theorem retainedGammaPolyRem_eq_expanded (t : ℝ) :
    retainedGammaPolyRem t =
      7 * t ^ 3 / 5760 - 31 * t ^ 5 / 967680 + 127 * t ^ 7 / 154828800 +
        ((-105091 / 5000000000000000000 : ℝ) + (550751 / 400000000000000000 : ℝ) * t ^ 2 + (65104166242035063 / 10000000000000000000 : ℝ) * t ^ 4 +
    (-3309458785969429 / 5000000000000000000 : ℝ) * t ^ 6 + (5366589076364431 / 80000000000000000000 : ℝ) * t ^ 8 + (-8726421052567571 / 1280000000000000000000 : ℝ) * t ^ 10 +
    (7163072980652803 / 10240000000000000000000 : ℝ) * t ^ 12 + (-6237272726078909 / 81920000000000000000000 : ℝ) * t ^ 14 + (3260029542583927 / 327680000000000000000000 : ℝ) * t ^ 16 +
    (-519878183231709 / 327680000000000000000000 : ℝ) * t ^ 18 + (4669432996809649 / 20971520000000000000000000 : ℝ) * t ^ 20 + (-1377431922843341 / 83886080000000000000000000 : ℝ) * t ^ 22) := by
  unfold retainedGammaPolyRem
  norm_num [Finset.sum_range_succ, gammaAlphaEven]
  ring

theorem retainedGammaPolyRem_le_retainedGammaRemainderWeight {t : ℝ}
    (ht : t ∈ Ioc (0 : ℝ) (7 / 5)) :
    retainedGammaPolyRem t ≤ retainedGammaRemainderWeight t := by
  have hz0 : 0 < t / 2 := by linarith [ht.1]
  have hz7 : t / 2 ≤ 7 / 10 := by linarith [ht.2]
  have hs := gammaSinhPolynomial22_le_div_sinh hz0 (by linarith)
  have hc := gammaChebyshevCoshPoly_le_inv_cosh hz0.le hz7
  have hs' := div_le_div_of_nonneg_right hs ht.1.le
  have hc' := div_le_div_of_nonneg_right hc (by norm_num : (0 : ℝ) ≤ 2)
  have hden : Real.sinh (t / 2) ≠ 0 := (Real.sinh_pos_iff.mpr hz0).ne'
  have hid_s : ((t / 2) / Real.sinh (t / 2)) / t = 1 / (2 * Real.sinh (t / 2)) := by
    field_simp [ht.1.ne', hden]
  rw [hid_s] at hs'
  have hw : archLevySinhWeight t =
      1 / (2 * Real.sinh (t / 2)) + 1 / (2 * Real.cosh (t / 2)) := by
    rw [archLevySinhWeight, exp_half_div_sinh_eq ht.1,
      archLevyDensity_eq_inv_sinh_add_inv_cosh ht.1]
    ring
  have htail := gamma_odd_tail_ge_even_poly ht.1 ht.2
  have hsplit_s : gammaSinhPolynomial22 (t / 2) / t - 1 / t + t / 24 =
      7 * t ^ 3 / 5760 - 31 * t ^ 5 / 967680 + 127 * t ^ 7 / 154828800 +
        ((-73 / 3503554560 : ℝ) * t ^ 9 + (1414477 / 2678117105664000 : ℝ) * t ^ 11 + (-8191 / 612141052723200 : ℝ) * t ^ 13 + (16931177 / 49950709902213120000 : ℝ) * t ^ 15 + (-5749691557 / 669659197233029971968000 : ℝ) * t ^ 17 + (91546277357 / 420928638260761696665600000 : ℝ) * t ^ 19 + (-3324754717 / 603513268363481705349120000 : ℝ) * t ^ 21) := by
    unfold gammaSinhPolynomial22
    field_simp [ht.1.ne']
    ring
  have hsplit_c : gammaChebyshevCoshPoly ((t / 2) ^ 2) / 2 - 1 / 2 + t ^ 2 / 16 +
      gammaTailEvenLowerPoly t =
      (-105091 / 5000000000000000000 : ℝ) + (550751 / 400000000000000000 : ℝ) * t ^ 2 + (65104166242035063 / 10000000000000000000 : ℝ) * t ^ 4 +
    (-3309458785969429 / 5000000000000000000 : ℝ) * t ^ 6 + (5366589076364431 / 80000000000000000000 : ℝ) * t ^ 8 + (-8726421052567571 / 1280000000000000000000 : ℝ) * t ^ 10 +
    (7163072980652803 / 10240000000000000000000 : ℝ) * t ^ 12 + (-6237272726078909 / 81920000000000000000000 : ℝ) * t ^ 14 + (3260029542583927 / 327680000000000000000000 : ℝ) * t ^ 16 +
    (-519878183231709 / 327680000000000000000000 : ℝ) * t ^ 18 + (4669432996809649 / 20971520000000000000000000 : ℝ) * t ^ 20 + (-1377431922843341 / 83886080000000000000000000 : ℝ) * t ^ 22 := by
    unfold gammaChebyshevCoshPoly gammaTailEvenLowerPoly
    ring
  rw [retainedGammaPolyRem_eq_expanded]
  unfold retainedGammaRemainderWeight
  rw [hw]
  have hc2 : 1 / Real.cosh (t / 2) / 2 = 1 / (2 * Real.cosh (t / 2)) := by ring
  rw [hc2] at hc'
  linarith [hs', hc', htail, hsplit_s, hsplit_c]

/-! ### Degree-26 reciprocal `cosh` upper kernel bound on `(0, 7 / 5]` -/

/-- Degree-26 reciprocal Taylor polynomial for `1 / cosh z`. -/
def gammaCoshPolynomial26 (z : ℝ) : ℝ :=
  (1 : ℝ) + (-1 / 2 : ℝ) * z ^ 2 + (5 / 24 : ℝ) * z ^ 4 +
    (-61 / 720 : ℝ) * z ^ 6 + (277 / 8064 : ℝ) * z ^ 8 + (-50521 / 3628800 : ℝ) * z ^ 10 +
    (540553 / 95800320 : ℝ) * z ^ 12 + (-199360981 / 87178291200 : ℝ) * z ^ 14 + (3878302429 / 4184557977600 : ℝ) * z ^ 16 +
    (-2404879675441 / 6402373705728000 : ℝ) * z ^ 18 + (14814847529501 / 97316080327065600 : ℝ) * z ^ 20 + (-69348874393137901 / 1124000727777607680000 : ℝ) * z ^ 22 +
    (238685140977801337 / 9545360026665222144000 : ℝ) * z ^ 24 + (-4087072509293123892361 / 403291461126605635584000000 : ℝ) * z ^ 26

private def coshTaylor26 (z : ℝ) : ℝ :=
  (1 : ℝ) + (1 / 2 : ℝ) * z ^ 2 + (1 / 24 : ℝ) * z ^ 4 +
    (1 / 720 : ℝ) * z ^ 6 + (1 / 40320 : ℝ) * z ^ 8 + (1 / 3628800 : ℝ) * z ^ 10 +
    (1 / 479001600 : ℝ) * z ^ 12 + (1 / 87178291200 : ℝ) * z ^ 14 + (1 / 20922789888000 : ℝ) * z ^ 16 +
    (1 / 6402373705728000 : ℝ) * z ^ 18 + (1 / 2432902008176640000 : ℝ) * z ^ 20 + (1 / 1124000727777607680000 : ℝ) * z ^ 22 +
    (1 / 620448401733239439360000 : ℝ) * z ^ 24 + (1 / 403291461126605635584000000 : ℝ) * z ^ 26

private theorem cosh_ge_coshTaylor26 {z : ℝ} (h0 : 0 ≤ z) (h1 : z ≤ 1) :
    coshTaylor26 z - 4 * z ^ 27 / 10888869450418352160768000000 ≤ Real.cosh z := by
  have hz : |z| ≤ 1 := by rwa [abs_of_nonneg h0]
  have hnz : |-z| ≤ 1 := by simpa only [abs_neg] using hz
  have hp := Real.exp_bound hz (n := 27) (by norm_num)
  have hm := Real.exp_bound hnz (n := 27) (by norm_num)
  norm_num [Finset.sum_range_succ, Nat.factorial, abs_neg, abs_of_nonneg h0] at hp hm
  obtain ⟨hpl, _⟩ := abs_le.mp hp
  obtain ⟨hml, _⟩ := abs_le.mp hm
  rw [Real.cosh_eq]
  dsimp only [coshTaylor26]
  linarith

private theorem gammaCoshPolynomial26_bounds {z : ℝ} (h0 : 0 ≤ z) (h1 : z ≤ 1) :
    0 ≤ gammaCoshPolynomial26 z ∧ gammaCoshPolynomial26 z ≤ 2 := by
  have hb (n : ℕ) : 0 ≤ z ^ n ∧ z ^ n ≤ 1 :=
    ⟨pow_nonneg h0 n, by simpa only [one_pow] using pow_le_pow_left₀ h0 h1 n⟩
  dsimp only [gammaCoshPolynomial26]
  constructor
  · linarith [(hb 2).2, (hb 4).1, (hb 6).2, (hb 8).1, (hb 10).2, (hb 12).1,
      (hb 14).2, (hb 16).1, (hb 18).2, (hb 20).1, (hb 22).2, (hb 24).1, (hb 26).2]
  · linarith [(hb 2).1, (hb 4).2, (hb 6).1, (hb 8).2, (hb 10).1, (hb 12).2,
      (hb 14).1, (hb 16).2, (hb 18).1, (hb 20).2, (hb 22).1, (hb 24).2, (hb 26).1]

private theorem gammaCoshPolynomial26_error {z : ℝ} (h0 : 0 ≤ z) (h7 : z ≤ 7 / 10) :
    1 / Real.cosh z - gammaCoshPolynomial26 z ≤ 22 / 10 ^ 10 := by
  have h1 : z ≤ 1 := by linarith
  have hCl := cosh_ge_coshTaylor26 h0 h1
  obtain ⟨hQ0, hQ2⟩ := gammaCoshPolynomial26_bounds h0 h1
  have hp (m n : ℕ) (h : m ≤ n) : z ^ n ≤ z ^ m := pow_le_pow_of_le_one h0 h1 h
  have hn27 : 0 ≤ z ^ 27 := pow_nonneg h0 27
  have hn28 : 0 ≤ z ^ 28 := pow_nonneg h0 28
  have hpoly : 1 - gammaCoshPolynomial26 z * coshTaylor26 z ≤ (91 / 20000000 : ℝ) * z ^ 28 := by
    dsimp only [gammaCoshPolynomial26, coshTaylor26]
    ring_nf
    linarith [hn28, hp 28 30 (by norm_num), hp 28 32 (by norm_num), hp 28 34 (by norm_num),
      hp 28 36 (by norm_num), hp 28 38 (by norm_num), hp 28 40 (by norm_num),
      hp 28 42 (by norm_num), hp 28 44 (by norm_num), hp 28 46 (by norm_num),
      hp 28 48 (by norm_num), hp 28 50 (by norm_num), hp 28 52 (by norm_num)]
  have hz28 : z ^ 28 ≤ (7 / 10 : ℝ) ^ 28 := pow_le_pow_left₀ h0 h7 28
  have hz27 : z ^ 27 ≤ (7 / 10 : ℝ) ^ 27 := pow_le_pow_left₀ h0 h7 27
  have hnum : (91 / 20000000 : ℝ) * (7 / 10 : ℝ) ^ 28 +
      8 * (7 / 10 : ℝ) ^ 27 / 10888869450418352160768000000 ≤ 22 / 10 ^ 10 := by norm_num
  have hprod := mul_le_mul_of_nonneg_left hCl hQ0
  have herr := mul_le_mul_of_nonneg_right hQ2 (show 0 ≤ 4 * z ^ 27 / 10888869450418352160768000000 by positivity)
  have hc_one : 1 ≤ Real.cosh z := Real.one_le_cosh z
  apply sub_le_iff_le_add.mpr
  apply (div_le_iff₀ (Real.cosh_pos z)).mpr
  nlinarith [hprod, herr, hpoly, hz28, hz27, hnum, hc_one]

/-- Pointwise upper bound for `archLevySinhWeight` on `(0, 7 / 5]` with error at most `4 / 10¹⁰`. -/
theorem archLevySinhWeight_le_poly14_cosh26 {t : ℝ} (ht : t ∈ Ioc (0 : ℝ) (7 / 5)) :
    archLevySinhWeight t ≤
      gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial26 (t / 2) / 2 + 4 / 10 ^ 10 := by
  have hz0 : 0 < t / 2 := by linarith [ht.1]
  have hz7 : t / 2 ≤ 7 / 10 := by linarith [ht.2]
  have hs := (gamma_reciprocal_polynomials14_errors hz0 (by linarith)).1
  have hs' := div_le_div_of_nonneg_right hs ht.1.le
  have hc := gammaCoshPolynomial26_error hz0.le hz7
  have hc' := div_le_div_of_nonneg_right hc (by norm_num : (0 : ℝ) ≤ 2)
  have hden : Real.sinh (t / 2) ≠ 0 := (Real.sinh_pos_iff.mpr hz0).ne'
  have hcden : Real.cosh (t / 2) ≠ 0 := (Real.cosh_pos _).ne'
  have he : archLevySinhWeight t -
      (gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial26 (t / 2) / 2) =
      ((t / 2) / Real.sinh (t / 2) - gammaSinhPolynomial14 (t / 2)) / t +
        (1 / Real.cosh (t / 2) - gammaCoshPolynomial26 (t / 2)) / 2 := by
    rw [archLevySinhWeight, exp_half_div_sinh_eq ht.1,
      archLevyDensity_eq_inv_sinh_add_inv_cosh ht.1]
    field_simp [ht.1.ne', hden, hcden]
    ring
  have hscale : ((t / 2) ^ 16 / 10000000) / t = (t / 2) ^ 15 / 20000000 := by
    field_simp [ht.1.ne']; ring
  rw [hscale] at hs'
  have hz15 : (t / 2) ^ 15 ≤ (7 / 10 : ℝ) ^ 15 := pow_le_pow_left₀ hz0.le hz7 15
  have hnum : (7 / 10 : ℝ) ^ 15 / 20000000 + (22 / 10 ^ 10) / 2 ≤ (4 / 10 ^ 10 : ℝ) := by norm_num
  linarith [he, hs', hc', hz15, hnum]

/-! ### Exact two-prime Weil decomposition and degree-14 Gamma comparison at `A = log 2` -/

/-- A continuous function supported in `[-A, A]` vanishes at and beyond the boundary `±A`. -/
theorem supported_vanish_at_aperture {A : ℝ} {F : ℝ → ℝ} (hF : Continuous F)
    (hs : tsupport F ⊆ Icc (-A) A) : ∀ x, A ≤ |x| → F x = 0 := by
  have hright : Ioi A ⊆ {x | F x = 0} := fun x hx =>
    image_eq_zero_of_notMem_tsupport (fun ht => not_le_of_gt hx (hs ht).2)
  have hleft : Iio (-A) ⊆ {x | F x = 0} := fun x hx =>
    image_eq_zero_of_notMem_tsupport (fun ht => not_le_of_gt hx (hs ht).1)
  have hr := closure_minimal hright (isClosed_eq hF continuous_const)
  have hl := closure_minimal hleft (isClosed_eq hF continuous_const)
  rw [closure_Ioi] at hr
  rw [closure_Iio] at hl
  intro x hx
  rcases le_total 0 x with hx0 | hx0
  · exact hr (by rwa [abs_of_nonneg hx0] at hx)
  · apply hl
    rw [abs_of_nonpos hx0] at hx
    change x ≤ -A
    linarith

/-- At aperture `A = log 2`, every prime-power shift `n ≥ 4` (including `n = 4` at boundary lag
`log 4 = 2 * log 2`) has zero autocorrelation, leaving only the `p = 2` and `p = 3` contacts. -/
theorem weilQuad_two_prime_decomposition {F : ℝ → ℝ} (hF : ContDiff ℝ 2 F)
    (hs : tsupport F ⊆ Icc (-Real.log 2) (Real.log 2)) :
    weilQuad F = Zeta23.EF.gammaBracket 0 * (∫ x, F x ^ 2) + biScaleLevyEnergy F -
      2 * (Real.log 2 / Real.sqrt 2) * autocorr F (Real.log 2) -
      2 * (Real.log 3 / Real.sqrt 3) * autocorr F (Real.log 3) +
      coshPairing F ^ 2 / 2 - sinhPairing F ^ 2 / 2 := by
  have hcs : HasCompactSupport F :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport F) hs
  have hvan := supported_vanish_at_aperture hF.continuous hs
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]
    norm_num
  have hN : ∀ n : ℕ, 3 < n → ∀ u, F u * F (u + Real.log n) = 0 := by
    intro n hn u
    have hn4 : (4 : ℝ) ≤ n := by exact_mod_cast (show 4 ≤ n by omega)
    have hlog : 2 * Real.log 2 ≤ Real.log n := by
      rw [← hlog4]
      exact Real.log_le_log (by norm_num) hn4
    by_cases hu : F u = 0
    · rw [hu, zero_mul]
    · have hu_abs : |u| < Real.log 2 := lt_of_not_ge fun hge => hu (hvan u hge)
      have hu_lo : -Real.log 2 < u := (abs_lt.mp hu_abs).1
      have hshift : Real.log 2 ≤ |u + Real.log n| :=
        (le_abs_self _).trans' (by linarith)
      rw [hvan (u + Real.log n) hshift, mul_zero]
  have hW := weil_eq_markovForm_add_pole hF hcs hN
  change weilQuad F = markovForm 3 F + coshPairing F ^ 2 / 2 - sinhPairing F ^ 2 / 2 at hW
  have hM1 : markovForm 1 F = Zeta23.EF.gammaBracket 0 * (∫ x, F x ^ 2) + levyJump F := by
    norm_num [markovForm, creationPotential, primeJump]
  have hM2 := markovForm_succ hF.continuous hcs (N := 1) le_rfl
  have hM3 := markovForm_succ hF.continuous hcs (N := 2) (by norm_num)
  norm_num only [Nat.reduceAdd, Nat.cast_ofNat] at hM2 hM3
  have hw2 : primeJumpWeight 2 = Real.log 2 / Real.sqrt 2 := by
    unfold primeJumpWeight
    rw [ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_two]
    norm_num
  have hw3 : primeJumpWeight 3 = Real.log 3 / Real.sqrt 3 := by
    unfold primeJumpWeight
    rw [ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_three]
    norm_num
  rw [levyJump_eq_biScale hF hcs] at hM1
  rw [hw2] at hM2
  rw [hw3] at hM3
  unfold autocorr
  linarith [hW, hM1, hM2, hM3]

/-- The Weil functional at aperture `log 2` with the local Gamma kernel replaced by the degree-14
lower bound `gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial14 (t / 2) / 2` on
`(0, 2 * log 2]`, while retaining the exact exterior Gamma tail, prime-2 and prime-3 contacts,
and exact pole charges. -/
def twoPrimeDegree14GammaForm (F : ℝ → ℝ) : ℝ :=
  (Zeta23.EF.gammaBracket 0 + 2 * archLevyAntideriv (2 * Real.log 2)) * (∫ x, F x ^ 2) +
    (∫ t in Ioc (0 : ℝ) (2 * Real.log 2),
      (autocorr F 0 - autocorr F t) *
        (gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial14 (t / 2) / 2)) -
    2 * (Real.log 2 / Real.sqrt 2) * autocorr F (Real.log 2) -
    2 * (Real.log 3 / Real.sqrt 3) * autocorr F (Real.log 3) +
    coshPairing F ^ 2 / 2 - sinhPairing F ^ 2 / 2

theorem two_mul_log_two_lt_seven_fifths : 2 * Real.log 2 < 7 / 5 := by
  obtain ⟨_, h2u⟩ := log_two_bounds_d26
  have hc : 2 * logTwoHi < (7 / 5 : ℝ) := by norm_num [logTwoHi]
  linarith

/-- The degree-14 Gamma comparison functional is a genuine lower bound on `weilQuad` for every
`C²` test supported in `[-log 2, log 2]`. -/
theorem twoPrimeDegree14GammaForm_le_weilQuad {F : ℝ → ℝ} (hF : ContDiff ℝ 2 F)
    (hs : tsupport F ⊆ Icc (-Real.log 2) (Real.log 2)) :
    twoPrimeDegree14GammaForm F ≤ weilQuad F := by
  have hcs : HasCompactSupport F :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport F) hs
  set r := 2 * Real.log 2
  have hr_pos : 0 < r := by positivity [Real.log_pos (by norm_num : (1 : ℝ) < 2)]
  have hr_lt : r < 7 / 5 := two_mul_log_two_lt_seven_fifths
  have hr2 : r ≤ 2 := by linarith
  have hs_r : tsupport F ⊆ Icc (-(r / 2)) (r / 2) := by
    simpa [r] using hs
  set D := fun t => autocorr F 0 - autocorr F t
  have hc : Continuous (autocorr F) := _root_.RHTower.ArchimedeanExactForm.continuous_autocorr hF hcs
  have hdc : Continuous D := continuous_const.sub hc
  have hd_nn : ∀ t, 0 ≤ D t := fun t =>
    sub_nonneg.mpr ((le_abs_self _).trans (abs_autocorr_le_zero hcs hF.continuous t))
  have hiW : IntegrableOn (fun t => D t * archLevySinhWeight t) (Ioi (0 : ℝ)) :=
    integrableOn_biScaleLevyIntegrand hF hcs
  have hsplit : (∫ t in Ioc (0 : ℝ) r, D t * archLevySinhWeight t) +
      (∫ t in Ioi r, D t * archLevySinhWeight t) = biScaleLevyEnergy F := by
    rw [← setIntegral_union
      (Set.disjoint_left.mpr fun t ht ht' => not_lt_of_ge ht.2 ht')
      measurableSet_Ioi
      (hiW.mono_set fun _ ht => ht.1)
      (hiW.mono_set fun _ ht => lt_trans hr_pos ht),
      Ioc_union_Ioi_eq_Ioi hr_pos.le]
    rfl
  have htail : (∫ t in Ioi r, D t * archLevySinhWeight t) =
      2 * archLevyAntideriv r * (∫ x, F x ^ 2) := by
    have he : ∀ t ∈ Ioi r, D t * archLevySinhWeight t =
        2 * archLevyDensity t * autocorr F 0 := by
      intro t ht
      dsimp [D]
      rw [autocorr_eq_zero_of_support (x := t) hs_r (by have ht' : r < t := ht; linarith),
        sub_zero, archLevySinhWeight, exp_half_div_sinh_eq (lt_trans hr_pos ht)]
      ring
    rw [setIntegral_congr_fun measurableSet_Ioi he, integral_mul_const, integral_const_mul,
      WeilLevyCoshCrossover.integral_archLevyDensity_Ioi hr_pos, autocorr_zero_eq]
  have hilog : IntegrableOn (fun t => D t / t) (Ioc (0 : ℝ) r) :=
    (local_gamma_terms_integrable_to_two hF hcs).1.mono_set fun _ ht => ⟨ht.1, ht.2.trans hr2⟩
  have hi14 : IntegrableOn
      (fun t => D t * (gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial14 (t / 2) / 2))
      (Ioc (0 : ℝ) r) := by
    have hcont : Continuous (fun t =>
        D t * ((gammaSinhPolynomial14 (t / 2) - 1) / t + gammaCoshPolynomial14 (t / 2) / 2)) := by
      have hpoly : (fun t : ℝ => (gammaSinhPolynomial14 (t / 2) - 1) / t) =
          fun t => -t / 24 + 7 * t ^ 3 / 5760 - 31 * t ^ 5 / 967680 +
            127 * t ^ 7 / 154828800 - 73 * t ^ 9 / 3503554560 +
            1414477 * t ^ 11 / 2678117105664000 - 8191 * t ^ 13 / 612141052723200 := by
        funext t
        by_cases ht0 : t = 0
        · subst ht0; norm_num [gammaSinhPolynomial14]
        · unfold gammaSinhPolynomial14; field_simp [ht0]; ring
      rw [hpoly]
      unfold gammaCoshPolynomial14
      fun_prop
    refine (hilog.add (hcont.integrableOn_Icc.mono_set Ioc_subset_Icc_self)).congr ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    field_simp [ht.1.ne']
    ring
  have hmono : (∫ t in Ioc (0 : ℝ) r,
      D t * (gammaSinhPolynomial14 (t / 2) / t + gammaCoshPolynomial14 (t / 2) / 2)) ≤
      ∫ t in Ioc (0 : ℝ) r, D t * archLevySinhWeight t := by
    refine setIntegral_mono_on hi14 (hiW.mono_set fun _ ht => ht.1) measurableSet_Ioc fun t ht => ?_
    exact mul_le_mul_of_nonneg_left
      (archLevySinhWeight_ge_polynomial14 ht.1 (ht.2.trans hr2)) (hd_nn t)
  rw [weilQuad_two_prime_decomposition hF hs]
  unfold twoPrimeDegree14GammaForm
  linarith [hsplit, htail, hmono]

