  have hy2 : 0 < 1 - y ^ 2 := by nlinarith
  have hle : 1 - y ^ 2 ≤ 1 - x ^ 2 := by nlinarith
  have hlog := Real.log_le_log hy2 hle
  linarith

private theorem shifted_taylor_branch_bounds (p q : ℤ) (t0 om base : ℝ) (vList : List ℝ)
    (hom_pos : 0 < om) (hom : om = (2 : ℝ) ^ p * (3 : ℝ) ^ q) (ht0 : t0 = 1 - om)
    (hbase : base ≤ Real.log 2 - ((p : ℝ) * Real.log 2 + (q : ℝ) * Real.log 3) / 2)
    (x0 x1 : ℝ)
    (hpoly : ∀ ξ : ℝ, polyEval vList ξ =
      base + ∑ m ∈ Finset.Icc 1 6, (((x0 + x1 * ξ) ^ 2 - t0) / om) ^ m / (2 * (m : ℝ)))
    {ξ x_true : ℝ} (hxmin : t0 ≤ (x0 + x1 * ξ) ^ 2)
    (hx0_nn : 0 ≤ x0 + x1 * ξ) (hle_true : x0 + x1 * ξ ≤ x_true) (htrue_lt1 : x_true < 1) :
    c0Rat + base ≤ c0Rat + polyEval vList ξ ∧
      c0Rat + polyEval vList ξ ≤ c0Rat + (Real.log 2 - Real.log (1 - x_true ^ 2) / 2) := by
  have hx_lt1 : (x0 + x1 * ξ) ^ 2 < 1 := by nlinarith
  have hz_nn : 0 ≤ ((x0 + x1 * ξ) ^ 2 - t0) / om := div_nonneg (by linarith) hom_pos.le
  have hsum_nn : 0 ≤ ∑ m ∈ Finset.Icc 1 6, (((x0 + x1 * ξ) ^ 2 - t0) / om) ^ m / (2 * (m : ℝ)) :=
    Finset.sum_nonneg fun m _ => div_nonneg (pow_nonneg hz_nn _) (by positivity)
  have htay := exterior_log_potential_ge_shifted_taylor p q t0 om base 6 hom ht0 hbase hxmin hx_lt1
  have hmon := exterior_log_potential_mono hx0_nn hle_true htrue_lt1
  rw [hpoly ξ]
  exact ⟨by linarith, by linarith⟩

