private theorem cross_spillover_young {Y W A_val M_r ε : ℝ}
    (hW : 0 ≤ W) (hA : 0 ≤ A_val) (hM : 0 ≤ M_r) (hε : 0 < ε)
    (hcs : Y ^ 2 ≤ W ^ 2 * (A_val * (2 * M_r))) :
    -((2 * W ^ 2 / ε) * A_val + ε * M_r) ≤ 2 * Y ∧
      -((2 * W ^ 2 / ε) * A_val + ε * M_r) ≤ -2 * Y := by
  set U := (2 * W ^ 2 / ε) * A_val
