  refine psd_of_ldlt_add_diag_dom certMat ldlL ldlE ldlD ?_ ?_ ?_ ?_ m
  · intro ⟨rv, hrv⟩; interval_cases rv <;> norm_num [ldlD]
  · intro ⟨iv, hiv⟩ ⟨jv, hjv⟩; interval_cases iv <;> interval_cases jv <;> rfl
  · refine forall_finK ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · have her := Finset.add_sum_erase Finset.univ (fun j : Fin 11 => |ldlE ⟨0, by omega⟩ j|) (Finset.mem_univ ⟨0, by omega⟩)
      have htot : (∑ j : Fin 11, |ldlE ⟨0, by omega⟩ j|) ≤ 2 * ldlE ⟨0, by omega⟩ ⟨0, by omega⟩ := by
        rw [sum_finK]; norm_num [ldlE]
      have hd_nn : 0 ≤ ldlE ⟨0, by omega⟩ ⟨0, by omega⟩ := by norm_num [ldlE]
