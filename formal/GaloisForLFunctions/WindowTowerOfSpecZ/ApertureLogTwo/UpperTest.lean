import GaloisForLFunctions.WindowTowerOfSpecZ.ApertureLogTwo.RationalPolynomials

/-!
# Smooth degree-18 upper-bound witness and degree-14 Gamma insufficiency at `A = log 2`

Constructs the smooth `C²` degree-18 even polynomial test `upperUnitTest` on `[-1, 1]`,
its scaled family `twoPrimeScaleTest s`, and the boundary witness `twoPrimeUpperTest`.
Proves:
1. `weilQuad (twoPrimeScaleTest s) < (1 / 10 ^ 9) * ∫ (twoPrimeScaleTest s) ^ 2`
   uniformly for `s ∈ [1 - 1 / 10 ^ 20, 1]`,
2. `weilQuad twoPrimeUpperTest < (1 / 10 ^ 9) * ∫ twoPrimeUpperTest ^ 2`,
3. `twoPrimeDegree14GammaForm twoPrimeUpperTest < 0` (`≈ -9.12 × 10⁻⁸ ∫ F²`).
-/

open scoped BigOperators
open Real MeasureTheory Set Finset intervalIntegral

namespace GaloisForLFunctions.WindowTowerOfSpecZ.ApertureLogTwo

open SelectivePositivityAndThresholdLaws

/-! ### 1. Reflective interval-Horner enclosure and monomial-against-polynomial integrals -/

def qceilD (D : ℕ) (x : ℚ) : ℚ := -qfloorD D (-x)

theorem le_qceilD {D : ℕ} (hD : 0 < D) (x : ℚ) : x ≤ qceilD D x := by
  unfold qceilD; linarith [qfloorD_le hD (-x)]

def qhornerIv (D : ℕ) (xLo xHi : ℚ) : List ℚ → ℚ × ℚ
  | [] => (0, 0)
  | c :: cs =>
    let p := qhornerIv D xLo xHi cs
    let pLo := if 0 ≤ p.1 then xLo * p.1 else xHi * p.1
    let pHi := if 0 ≤ p.2 then xHi * p.2 else xLo * p.2
    (qfloorD D (c + pLo), qceilD D (c + pHi))

theorem qeval_mem_qhornerIv {D : ℕ} (hD : 0 < D) {xLo xHi : ℚ} (hx0 : 0 ≤ xLo)
    {x : ℝ} (hx : (xLo : ℝ) ≤ x ∧ x ≤ (xHi : ℝ)) :
    ∀ p : List ℚ,
      ((qhornerIv D xLo xHi p).1 : ℝ) ≤ qeval p x ∧
        qeval p x ≤ ((qhornerIv D xLo xHi p).2 : ℝ)
  | [] => by simp [qhornerIv, qeval]
  | c :: cs => by
    obtain ⟨hlo, hhi⟩ := qeval_mem_qhornerIv hD hx0 hx cs
    set p := qhornerIv D xLo xHi cs
    set pLo : ℚ := if 0 ≤ p.1 then xLo * p.1 else xHi * p.1
    set pHi : ℚ := if 0 ≤ p.2 then xHi * p.2 else xLo * p.2
    have hx0' : (0 : ℝ) ≤ xLo := Rat.cast_nonneg.mpr hx0
    have hpLo : (pLo : ℝ) ≤ x * qeval cs x := by
      dsimp only [pLo]; split_ifs with h1
      · rw [Rat.cast_mul]; have hp1 : (0 : ℝ) ≤ p.1 := Rat.cast_nonneg.mpr h1
        nlinarith [hx.1, hlo, hx0', hp1]
      · rw [Rat.cast_mul]; have hp1 : (p.1 : ℝ) ≤ 0 := Rat.cast_nonpos.mpr (le_of_not_ge h1)
        nlinarith [hx.1, hx.2, hlo, hx0', hp1]
    have hpHi : x * qeval cs x ≤ (pHi : ℝ) := by
      dsimp only [pHi]; split_ifs with h2
      · rw [Rat.cast_mul]; have hp2 : (0 : ℝ) ≤ p.2 := Rat.cast_nonneg.mpr h2
        nlinarith [hx.1, hx.2, hhi, hx0', hp2]
      · rw [Rat.cast_mul]; have hp2 : (p.2 : ℝ) ≤ 0 := Rat.cast_nonpos.mpr (le_of_not_ge h2)
        nlinarith [hx.1, hhi, hx0', hp2]
    have hfl : (qfloorD D (c + pLo) : ℝ) ≤ (c : ℝ) + (pLo : ℝ) := by
      rw [← Rat.cast_add]; exact Rat.cast_le.mpr (qfloorD_le hD _)
    have hcl : (c : ℝ) + (pHi : ℝ) ≤ (qceilD D (c + pHi) : ℝ) := by
      rw [← Rat.cast_add]; exact Rat.cast_le.mpr (le_qceilD hD _)
    simp only [qhornerIv, qeval]
    exact ⟨by linarith only [hfl, hpLo], by linarith only [hcl, hpHi]⟩

theorem qeval_bounds_of_qhornerIv {D : ℕ} {xLo xHi lo hi : ℚ} (p : List ℚ)
    (h : (decide (0 < D) && decide (0 ≤ xLo) &&
      decide (lo ≤ (qhornerIv D xLo xHi p).1) &&
      decide ((qhornerIv D xLo xHi p).2 ≤ hi)) = true)
    {x : ℝ} (hx : (xLo : ℝ) ≤ x ∧ x ≤ (xHi : ℝ)) :
    (lo : ℝ) ≤ qeval p x ∧ qeval p x ≤ (hi : ℝ) := by
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨hD, hx0⟩, hlo⟩, hhi⟩ := h
  obtain ⟨h1, h2⟩ := qeval_mem_qhornerIv hD hx0 hx p
  exact ⟨(Rat.cast_le.mpr hlo).trans h1, h2.trans (Rat.cast_le.mpr hhi)⟩

theorem qeval_replicate_zero_append (p : List ℚ) (m : ℕ) (t : ℝ) :
    qeval (List.replicate m 0 ++ p) t = t ^ m * qeval p t := by
  induction m with
  | zero => simp [qeval]
  | succ m ih =>
    simp only [List.replicate_succ, List.cons_append, qeval, Rat.cast_zero, zero_add, ih, pow_succ']
    ring

theorem integral_pow_mul_qeval_zero_to_zero_to (p : List ℚ) (m : ℕ) (b : ℚ) :
    (∫ t in (0 : ℝ)..(b : ℝ), t ^ m * qeval p t) =
      (qevalQ (qprim (List.replicate m 0 ++ p)) b : ℝ) := by
  have hfn : (fun t : ℝ => t ^ m * qeval p t) = qeval (List.replicate m 0 ++ p) :=
    funext fun t => (qeval_replicate_zero_append p m t).symm
  have hz : qeval (qprim (List.replicate m 0 ++ p)) 0 = 0 := by simp [qprim, qeval]
  rw [hfn, integral_qeval, qeval_ratCast, hz, sub_zero]

/-! ### 2. Smooth `C²` degree-18 witness `upperUnitTest` and `twoPrimeScaleTest` -/

def upperUnitPolyQ : List ℚ := [1938762811 / 1024000000, 0, -10133087199 / 1024000000, 0, 5058036369 / 256000000, 0, -3326115637 / 256000000, 0, -9650701551 / 512000000, 0, 26993962803 / 512000000, 0, -15065579023 / 256000000, 0, 1924814463 / 51200000, 0, -13832727909 / 1024000000, 0, 2178873697 / 1024000000]
def upperUnitD1Q : List ℚ := [0, -10133087199 / 512000000, 0, 5058036369 / 64000000, 0, -9978346911 / 128000000, 0, -9650701551 / 64000000, 0, 26993962803 / 51200000, 0, -45196737069 / 64000000, 0, 13473701241 / 25600000, 0, -13832727909 / 64000000, 0, 19609863273 / 512000000]
def upperUnitD2Q : List ℚ := [-10133087199 / 512000000, 0, 15174109107 / 64000000, 0, -9978346911 / 25600000, 0, -67554910857 / 64000000, 0, 242945665227 / 51200000, 0, -497164107759 / 64000000, 0, 175158116133 / 25600000, 0, -41498183727 / 12800000, 0, 333367675641 / 512000000]

def upperUnitD2 (u : ℝ) : ℝ :=
  qeval upperUnitD2Q (max (-1) (min 1 u))

def upperUnitD1 (u : ℝ) : ℝ :=
  ∫ t in (-1 : ℝ)..u, upperUnitD2 t

/-- Smooth `C²` degree-18 even polynomial witness supported on `[-1, 1]`. -/
def upperUnitTest (u : ℝ) : ℝ :=
  ∫ t in (-1 : ℝ)..u, upperUnitD1 t

/-- Rescaled two-prime test family `F_s(x) = upperUnitTest(x / (s * log 2))`. -/
def twoPrimeScaleTest (s x : ℝ) : ℝ :=
  upperUnitTest (x / (s * Real.log 2))

/-- Smooth `C²` test on `[-log 2, log 2]` achieving Rayleigh quotient `< 1 / 10⁹` and
driving `twoPrimeDegree14GammaForm` strictly negative (`≈ -9.12 × 10⁻⁸`). -/
def twoPrimeUpperTest (x : ℝ) : ℝ :=
  twoPrimeScaleTest 1 x

private theorem continuous_upperUnitD2 : Continuous upperUnitD2 :=
  (continuous_qeval upperUnitD2Q).comp (continuous_const.max (continuous_const.min continuous_id))

private theorem upperUnitD2_eq_of_mem {u : ℝ} (hu : u ∈ Icc (-1 : ℝ) 1) :
    upperUnitD2 u = qeval upperUnitD2Q u := by
  unfold upperUnitD2; rw [min_eq_right hu.2, max_eq_right hu.1]

private theorem upperUnitD2_of_le_neg_one {u : ℝ} (hu : u ≤ -1) : upperUnitD2 u = 0 := by
  unfold upperUnitD2
  rw [min_eq_right (by linarith : u ≤ 1), max_eq_left hu,
    show (-1 : ℝ) = ((-1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
  exact_mod_cast (by decide +kernel : qevalQ upperUnitD2Q (-1) = 0)

private theorem upperUnitD2_of_one_le {u : ℝ} (hu : 1 ≤ u) : upperUnitD2 u = 0 := by
  unfold upperUnitD2
  rw [min_eq_left hu, max_eq_right (by norm_num : (-1 : ℝ) ≤ 1),
    show (1 : ℝ) = ((1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
  exact_mod_cast (by decide +kernel : qevalQ upperUnitD2Q 1 = 0)

private theorem hasDerivAt_upperUnitD1 (u : ℝ) : HasDerivAt upperUnitD1 (upperUnitD2 u) u :=
  intervalIntegral.integral_hasDerivAt_right
    (continuous_upperUnitD2.intervalIntegrable (-1) u)
    continuous_upperUnitD2.aestronglyMeasurable.stronglyMeasurableAtFilter
    continuous_upperUnitD2.continuousAt

private theorem contDiff_upperUnitD1 : ContDiff ℝ 1 upperUnitD1 :=
  contDiff_one_iff_deriv.mpr ⟨fun u => (hasDerivAt_upperUnitD1 u).differentiableAt, by
    rw [show deriv upperUnitD1 = upperUnitD2 from funext fun u => (hasDerivAt_upperUnitD1 u).deriv]
    exact continuous_upperUnitD2⟩

private theorem hasDerivAt_upperUnitTest (u : ℝ) : HasDerivAt upperUnitTest (upperUnitD1 u) u := by
  have hc : Continuous upperUnitD1 := contDiff_upperUnitD1.continuous
  exact intervalIntegral.integral_hasDerivAt_right
    (hc.intervalIntegrable (-1) u) hc.aestronglyMeasurable.stronglyMeasurableAtFilter hc.continuousAt

theorem contDiff_upperUnitTest : ContDiff ℝ 2 upperUnitTest :=
  show ContDiff ℝ (1 + 1) upperUnitTest from contDiff_succ_iff_deriv.mpr
    ⟨fun u => (hasDerivAt_upperUnitTest u).differentiableAt, by simp, by
      rw [show deriv upperUnitTest = upperUnitD1 from funext fun u => (hasDerivAt_upperUnitTest u).deriv]
      exact contDiff_upperUnitD1⟩

private theorem upperUnitD1_eq_of_mem {u : ℝ} (hu : u ∈ Icc (-1 : ℝ) 1) :
    upperUnitD1 u = qeval upperUnitD1Q u := by
  unfold upperUnitD1
  have hcongr : ∫ t in (-1 : ℝ)..u, upperUnitD2 t = ∫ t in (-1 : ℝ)..u, qeval upperUnitD2Q t :=
    intervalIntegral.integral_congr fun t ht => by
      rw [uIcc_of_le hu.1] at ht; exact upperUnitD2_eq_of_mem ⟨ht.1, ht.2.trans hu.2⟩
  have hprim : upperUnitD1Q = qadd [0] (qprim upperUnitD2Q) := by decide +kernel
  rw [hcongr, integral_qeval, hprim, qeval_qadd]
  have h0 : qeval (qprim upperUnitD2Q) (-1) = 0 := by
    rw [show (-1 : ℝ) = ((-1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
    exact_mod_cast (by decide +kernel : qevalQ (qprim upperUnitD2Q) (-1) = 0)
  simp only [qeval_cons, qeval_nil] at h0 ⊢; linarith

private theorem upperUnitD1_of_le_neg_one {u : ℝ} (hu : u ≤ -1) : upperUnitD1 u = 0 := by
  unfold upperUnitD1
  have hcongr : ∫ t in (-1 : ℝ)..u, upperUnitD2 t = ∫ _ in (-1 : ℝ)..u, (0 : ℝ) :=
    intervalIntegral.integral_congr fun t ht => by
      rw [uIcc_of_ge hu] at ht; exact upperUnitD2_of_le_neg_one ht.2
  simp [hcongr]

private theorem upperUnitD1_of_one_le {u : ℝ} (hu : 1 ≤ u) : upperUnitD1 u = 0 := by
  unfold upperUnitD1
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (continuous_upperUnitD2.intervalIntegrable (-1) 1)
    (continuous_upperUnitD2.intervalIntegrable 1 u)]
  have h1 : (∫ t in (-1 : ℝ)..1, upperUnitD2 t) = 0 := by
    change upperUnitD1 1 = 0
    rw [upperUnitD1_eq_of_mem ⟨by norm_num, le_rfl⟩,
      show (1 : ℝ) = ((1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
    exact_mod_cast (by decide +kernel : qevalQ upperUnitD1Q 1 = 0)
  have h2 : (∫ t in (1 : ℝ)..u, upperUnitD2 t) = ∫ _ in (1 : ℝ)..u, (0 : ℝ) :=
    intervalIntegral.integral_congr fun t ht => by
      rw [uIcc_of_le hu] at ht; exact upperUnitD2_of_one_le ht.1
  simp [h1, h2]

private theorem upperUnitTest_eq_of_mem {u : ℝ} (hu : u ∈ Icc (-1 : ℝ) 1) :
    upperUnitTest u = qeval upperUnitPolyQ u := by
  unfold upperUnitTest
  have hcongr : ∫ t in (-1 : ℝ)..u, upperUnitD1 t = ∫ t in (-1 : ℝ)..u, qeval upperUnitD1Q t :=
    intervalIntegral.integral_congr fun t ht => by
      rw [uIcc_of_le hu.1] at ht; exact upperUnitD1_eq_of_mem ⟨ht.1, ht.2.trans hu.2⟩
  have hprim : upperUnitPolyQ = qadd [1] (qprim upperUnitD1Q) := by decide +kernel
  rw [hcongr, integral_qeval, hprim, qeval_qadd]
  have h0 : qeval (qprim upperUnitD1Q) (-1) = -1 := by
    rw [show (-1 : ℝ) = ((-1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
    exact_mod_cast (by decide +kernel : qevalQ (qprim upperUnitD1Q) (-1) = -1)
  simp only [qeval_cons, qeval_nil] at h0 ⊢; push_cast; linarith

private theorem upperUnitTest_outside {u : ℝ} (hu : u ∉ Icc (-1 : ℝ) 1) : upperUnitTest u = 0 := by
  have hc : Continuous upperUnitD1 := contDiff_upperUnitD1.continuous
  rcases lt_or_ge u (-1) with hlt | hge
  · unfold upperUnitTest
    have hcongr : ∫ t in (-1 : ℝ)..u, upperUnitD1 t = ∫ _ in (-1 : ℝ)..u, (0 : ℝ) :=
      intervalIntegral.integral_congr fun t ht => by
        rw [uIcc_of_ge hlt.le] at ht; exact upperUnitD1_of_le_neg_one ht.2
    simp [hcongr]
  · have hgt : 1 < u := lt_of_not_ge fun hle => hu ⟨hge, hle⟩
    unfold upperUnitTest
    rw [← intervalIntegral.integral_add_adjacent_intervals
      (hc.intervalIntegrable (-1) 1) (hc.intervalIntegrable 1 u)]
    have h1 : (∫ t in (-1 : ℝ)..1, upperUnitD1 t) = 0 := by
      change upperUnitTest 1 = 0
      rw [upperUnitTest_eq_of_mem ⟨by norm_num, le_rfl⟩,
        show (1 : ℝ) = ((1 : ℚ) : ℝ) by norm_num, qeval_ratCast]
      exact_mod_cast (by decide +kernel : qevalQ upperUnitPolyQ 1 = 0)
    have h2 : (∫ t in (1 : ℝ)..u, upperUnitD1 t) = ∫ _ in (1 : ℝ)..u, (0 : ℝ) :=
      intervalIntegral.integral_congr fun t ht => by
        rw [uIcc_of_le hgt.le] at ht; exact upperUnitD1_of_one_le ht.1
    simp [h1, h2]

theorem tsupport_upperUnitTest : tsupport upperUnitTest ⊆ Icc (-1 : ℝ) 1 :=
  closure_minimal (fun u hu => by_contra fun hnot => hu (upperUnitTest_outside hnot)) isClosed_Icc

theorem upperUnitTest_even (u : ℝ) : upperUnitTest (-u) = upperUnitTest u := by
  by_cases hu : u ∈ Icc (-1 : ℝ) 1
  · have hnu : -u ∈ Icc (-1 : ℝ) 1 := ⟨by linarith [hu.2], by linarith [hu.1]⟩
    rw [upperUnitTest_eq_of_mem hnu, upperUnitTest_eq_of_mem hu]
    have hev : upperUnitPolyQ = qcomp upperUnitPolyQ [0, -1] := by decide +kernel
    conv_rhs => rw [hev, qeval_qcomp_affine]; ring_nf
  · have hnu : -u ∉ Icc (-1 : ℝ) 1 := fun h => hu ⟨by linarith [h.2], by linarith [h.1]⟩
    rw [upperUnitTest_outside hnu, upperUnitTest_outside hu]

theorem contDiff_twoPrimeScaleTest (s : ℝ) : ContDiff ℝ 2 (twoPrimeScaleTest s) :=
  contDiff_upperUnitTest.comp (contDiff_id.div_const _)

theorem contDiff_twoPrimeUpperTest : ContDiff ℝ 2 twoPrimeUpperTest :=
  contDiff_twoPrimeScaleTest 1

theorem twoPrimeScaleTest_even (s x : ℝ) : twoPrimeScaleTest s (-x) = twoPrimeScaleTest s x := by
  unfold twoPrimeScaleTest; rw [neg_div, upperUnitTest_even]

theorem tsupport_twoPrimeScaleTest {s : ℝ} (hs : 0 < s) :
    tsupport (twoPrimeScaleTest s) ⊆ Icc (-(s * Real.log 2)) (s * Real.log 2) := by
  have hA : 0 < s * Real.log 2 := mul_pos hs apertureLogTwo_pos
  refine closure_minimal (fun x hx => ?_) isClosed_Icc
  by_contra hnot; apply hx; unfold twoPrimeScaleTest; apply upperUnitTest_outside
  intro hmem; apply hnot
  exact ⟨(le_div_iff₀ hA).mp (by linarith [hmem.1]), (div_le_iff₀ hA).mp (by linarith [hmem.2])⟩

theorem tsupport_twoPrimeUpperTest : tsupport twoPrimeUpperTest ⊆ Icc (-Real.log 2) (Real.log 2) := by
  simpa [twoPrimeUpperTest] using tsupport_twoPrimeScaleTest one_pos

