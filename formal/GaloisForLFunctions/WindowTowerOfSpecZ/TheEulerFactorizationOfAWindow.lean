import GaloisForLFunctions.WindowTowerOfSpecZ.TheTowerOfSmallExtensions
import Mathlib.NumberTheory.SmoothNumbers

/-!
# The Euler factorization of a window

The window zeta operator `Z = ρ_A(ζ)` factors exactly into Euler factors, one per prime `p ≤ e^A`.

* **Factored numbers** (`factoredIndicator`): the indicator `e_s` of the integers all of whose prime
  factors lie in a finite set `s` is multiplicative; for a prime `p ∉ s`,
  `e_{{p}} * e_s = e_{insert p s}` (`factoredIndicator_mul_insert`), so over a finite set of primes
  `∏_{p∈P} e_{{p}} = e_P` (`prod_factoredIndicator`).
* **Euler factors** (`eulerFactor_mul_inverse`): `e_p = e_{{p}}`, the indicator of the powers of `p`,
  is inverted by `1 − δ_p`: `e_p = (1 − δ_p)^{−1}`, the geometric series of the Hecke operator at `p`.
* **The window Euler product** (`windowRep_zeta_eq_prod`): on a window of level `N`,
  `Z = ρ_A(∏_{p ≤ N} e_p)`, the product of the commuting window Euler factors `ρ_A(e_p)`, each inverted
  by `1 − p^{−1/2}T_{log p}` (`windowRep_eulerFactor_mul_inverse`). The truncated Euler product is
  exact in the window algebra, with finitely many factors, each unipotent.

In the tower, the Euler factor at `p` appears at the stage `p` as `1 + p^{−1/2}T_{log p}` and gains
the term of `p^k` at the stage `p^k`. The window algebra is generated by the primes (the cotangent
law), and its zeta element is the product of its local factors: the factorization of the window
symbol `ζ(½ − iξ)` into Euler factors survives the truncation to the window.
-/

noncomputable section

namespace GaloisForLFunctions.WindowTowerOfSpecZ

open CohomologyOfWindowsOfSpecZ ArithmeticFunction

/-! ### Factored numbers -/

/-- The indicator of the `s`-factored integers: `n ≠ 0` with all prime factors in `s`. -/
def factoredIndicator (s : Finset ℕ) : ArithmeticFunction ℝ :=
  ⟨fun n => if n ≠ 0 ∧ n.primeFactors ⊆ s then 1 else 0, by simp⟩

theorem factoredIndicator_apply (s : Finset ℕ) (n : ℕ) :
    factoredIndicator s n = if n ≠ 0 ∧ n.primeFactors ⊆ s then 1 else 0 := rfl

theorem isMultiplicative_factoredIndicator (s : Finset ℕ) :
    (factoredIndicator s).IsMultiplicative := by
  refine ⟨by simp [factoredIndicator_apply], fun {m n} _ => ?_⟩
  rcases eq_or_ne m 0 with rfl | hm
  · simp [factoredIndicator_apply]
  rcases eq_or_ne n 0 with rfl | hn
  · simp [factoredIndicator_apply]
  have hmn : m * n ≠ 0 := mul_ne_zero hm hn
  simp only [factoredIndicator_apply, Nat.primeFactors_mul hm hn, Finset.union_subset_iff, ne_eq,
    hm, hn, hmn, not_false_eq_true, true_and]
  by_cases h1 : m.primeFactors ⊆ s <;> by_cases h2 : n.primeFactors ⊆ s <;> simp [h1, h2]

theorem factoredIndicator_prime_pow (s : Finset ℕ) {q : ℕ} (hq : q.Prime) (i : ℕ) :
    factoredIndicator s (q ^ i) = if i = 0 ∨ q ∈ s then 1 else 0 := by
  rw [factoredIndicator_apply]
  rcases eq_or_ne i 0 with rfl | hi
  · simp
  · rw [Nat.primeFactors_prime_pow hi hq]
    simp [hi, hq.ne_zero]

/-- Dirichlet convolution at a prime power: `(f * g)(q^k) = Σ_{j ≤ k} f(q^j) g(q^{k−j})`. -/
theorem mul_apply_prime_pow {q : ℕ} (hq : q.Prime) (f g : ArithmeticFunction ℝ) (k : ℕ) :
    (f * g) (q ^ k) = ∑ j ∈ Finset.range (k + 1), f (q ^ j) * g (q ^ (k - j)) := by
  rw [ArithmeticFunction.mul_apply, Nat.sum_divisorsAntidiagonal (fun a b => f a * g b),
    Nat.sum_divisors_prime_pow hq]
  refine Finset.sum_congr rfl fun j hj => ?_
  rw [Nat.pow_div (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)) hq.pos]

/-- **Adding one prime**: `e_{{p}} * e_s = e_{insert p s}` for a prime `p ∉ s`. -/
theorem factoredIndicator_mul_insert {p : ℕ} (hp : p.Prime) {s : Finset ℕ} (hps : p ∉ s) :
    factoredIndicator {p} * factoredIndicator s = factoredIndicator (insert p s) := by
  refine ((isMultiplicative_factoredIndicator _).mul (isMultiplicative_factoredIndicator _)).eq_iff_eq_on_prime_powers
    _ _ (isMultiplicative_factoredIndicator _) |>.mpr fun q i hq => ?_
  rw [mul_apply_prime_pow hq]
  simp only [factoredIndicator_prime_pow _ hq, Finset.mem_singleton, Finset.mem_insert]
  rcases eq_or_ne i 0 with rfl | hi
  · rw [zero_add, Finset.sum_range_one]; simp
  by_cases hqp : q = p
  · subst hqp
    rw [Finset.sum_eq_single i]
    · simp [hi]
    · intro j hj hji
      have : i - j ≠ 0 := by have := Finset.mem_range.mp hj; omega
      simp [this, hps]
    · intro h; exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self i)) h
  · rw [Finset.sum_eq_single 0]
    · by_cases hqs : q ∈ s <;> simp [hqp, hqs, hi]
    · intro j _ hj0
      simp [hj0, hqp]
    · intro h; exact absurd (Finset.mem_range.mpr (Nat.succ_pos i)) h

theorem factoredIndicator_empty : factoredIndicator ∅ = 1 := by
  ext n
  rw [factoredIndicator_apply, ArithmeticFunction.one_apply]
  by_cases h1 : n = 1
  · simp [h1]
  · rw [if_neg h1, if_neg]
    rintro ⟨hn0, hsub⟩
    rw [Finset.subset_empty, Nat.primeFactors_eq_empty] at hsub
    omega

/-- **The Euler product over a finite set of primes**: `∏_{p∈P} e_{{p}} = e_P`. -/
theorem prod_factoredIndicator (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) :
    ∏ p ∈ P, factoredIndicator {p} = factoredIndicator P := by
  induction P using Finset.induction_on with
  | empty => rw [Finset.prod_empty, factoredIndicator_empty]
  | insert p P hpP ih =>
    rw [Finset.prod_insert hpP, ih fun q hq => hP q (Finset.mem_insert_of_mem hq),
      factoredIndicator_mul_insert (hP p (Finset.mem_insert_self p P)) hpP]

/-! ### Euler factors and their inverses -/

/-- The inverse Euler factor `1 − δ_p`. -/
def eulerInverse (p : ℕ) : ArithmeticFunction ℝ := 1 - single p 1

theorem eulerInverse_apply (p n : ℕ) :
    eulerInverse p n = (if n = 1 then 1 else 0) - (if n = p ∧ n ≠ 0 then 1 else 0) := by
  rw [eulerInverse, sub_apply', ArithmeticFunction.one_apply, single_apply]

theorem isMultiplicative_eulerInverse {p : ℕ} (hp : p.Prime) : (eulerInverse p).IsMultiplicative := by
  refine ⟨by simp [eulerInverse_apply, hp.one_lt.ne], fun {m n} hmn => ?_⟩
  rcases eq_or_ne m 1 with rfl | hm1
  · simp [eulerInverse_apply, hp.one_lt.ne]
  rcases eq_or_ne n 1 with rfl | hn1
  · simp [eulerInverse_apply, hp.one_lt.ne]
  have hmn1 : m * n ≠ 1 := fun h => hm1 (Nat.eq_one_of_mul_eq_one_right h)
  have hmnp : m * n ≠ p := fun h => by
    rcases Nat.prime_mul_iff.mp (h ▸ hp) with ⟨_, h1⟩ | ⟨_, h1⟩
    · exact hn1 h1
    · exact hm1 h1
  have hboth : ¬ (m = p ∧ n = p) := fun ⟨h1, h2⟩ => by
    rw [h1, h2, Nat.coprime_self] at hmn; exact hp.one_lt.ne' hmn
  rw [eulerInverse_apply, eulerInverse_apply, eulerInverse_apply, if_neg hmn1,
    if_neg fun h => hmnp h.1, if_neg hm1, if_neg hn1]
  by_cases h1 : m = p
  · have h2 : n ≠ p := fun h2 => hboth ⟨h1, h2⟩
    simp [h1, h2, hp.ne_zero]
  · simp [h1]

/-- **The Euler factor is the geometric series of the Hecke operator at `p`**:
`e_p * (1 − δ_p) = 1`. -/
theorem eulerFactor_mul_inverse {p : ℕ} (hp : p.Prime) :
    factoredIndicator {p} * eulerInverse p = 1 := by
  refine ((isMultiplicative_factoredIndicator _).mul (isMultiplicative_eulerInverse hp)).eq_iff_eq_on_prime_powers
    _ _ isMultiplicative_one |>.mpr fun q i hq => ?_
  rw [mul_apply_prime_pow hq]
  simp only [factoredIndicator_prime_pow _ hq, Finset.mem_singleton, eulerInverse_apply]
  rcases eq_or_ne i 0 with rfl | hi
  · rw [zero_add, Finset.sum_range_one]; simp [hp.one_lt.ne]
  have hqi1 : q ^ i ≠ 1 := (Nat.one_lt_pow hi hq.one_lt).ne'
  rw [ArithmeticFunction.one_apply, if_neg hqi1]
  by_cases hqp : q = p
  · subst hqp
    -- the terms `j = i` (value `1`) and `j = i − 1` (value `−1`) cancel
    have hterm : ∀ j ∈ Finset.range (i + 1), (if j = 0 ∨ q = q then (1 : ℝ) else 0) *
        ((if q ^ (i - j) = 1 then 1 else 0) - (if q ^ (i - j) = q ∧ q ^ (i - j) ≠ 0 then 1 else 0)) =
        (if j = i then 1 else 0) - (if j = i - 1 then 1 else 0) := fun j hj => by
      have hji := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      have e1 : q ^ (i - j) = 1 ↔ j = i := by
        rw [Nat.pow_eq_one]
        constructor
        · intro h
          rcases h with h | h
          · exact absurd h hq.one_lt.ne'
          · omega
        · intro h; right; omega
      have e2 : (q ^ (i - j) = q ∧ q ^ (i - j) ≠ 0) ↔ j = i - 1 := by
        constructor
        · rintro ⟨h, -⟩
          have := Nat.pow_right_injective hq.two_le (h.trans (pow_one q).symm)
          omega
        · intro h
          refine ⟨by rw [show i - j = 1 by omega, pow_one], pow_ne_zero _ hq.ne_zero⟩
      simp only [or_true, if_true, one_mul]
      by_cases ha : j = i
      · rw [if_pos (e1.mpr ha), if_neg (fun h => by have := e2.mp h; omega), if_pos ha,
          if_neg (by omega)]
      · rw [if_neg (fun h => ha (e1.mp h)), if_neg ha]
        by_cases hb : j = i - 1
        · rw [if_pos (e2.mpr hb), if_pos hb]
        · rw [if_neg (fun h => hb (e2.mp h)), if_neg hb]
    rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, Finset.sum_ite_eq',
      Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr (Nat.lt_succ_self i)),
      if_pos (Finset.mem_range.mpr (by omega)), sub_self]
  · rw [Finset.sum_eq_single 0]
    · have hqpi : q ^ i ≠ p := fun h => by
        have hdvd : q ∣ p := h ▸ dvd_pow_self q hi
        exact hqp ((Nat.prime_dvd_prime_iff_eq hq hp).mp hdvd)
      simp [hq.one_lt.ne', hi, hqpi]
    · intro j _ hj0
      simp [hj0, hqp]
    · intro h; exact absurd (Finset.mem_range.mpr (Nat.succ_pos i)) h

/-! ### The window Euler product -/

/-- The primes `≤ N`. -/
def primesUpTo (N : ℕ) : Finset ℕ := (Finset.range (N + 1)).filter Nat.Prime

/-- `ζ` agrees with the indicator of the `(≤ N)`-factored numbers on `[1, N]`. -/
theorem zeta_sub_factoredIndicator_mem (N : ℕ) :
    (ArithmeticFunction.zeta : ArithmeticFunction ℝ) - factoredIndicator (primesUpTo N) ∈
      truncIdeal N := by
  intro n h1 hn
  have hsub : n.primeFactors ⊆ primesUpTo N := fun q hq => by
    unfold primesUpTo
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le
      ((Nat.le_of_mem_primeFactors hq).trans hn)), Nat.prime_of_mem_primeFactors hq⟩
  rw [sub_apply', ArithmeticFunction.natCoe_apply, ArithmeticFunction.zeta_apply_ne (by omega),
    factoredIndicator_apply, if_pos ⟨by omega, hsub⟩]
  simp

/-- **The window Euler product**: on a window of level `N = ⌊e^A⌋`, the window zeta operator is the
image of the Euler product over the primes `p ≤ N`. -/
theorem windowRep_zeta_eq_prod (A : ℝ) :
    windowRep A (ArithmeticFunction.zeta : ArithmeticFunction ℝ) =
      windowRep A (∏ p ∈ primesUpTo (windowLevel A), factoredIndicator {p}) := by
  rw [prod_factoredIndicator (primesUpTo (windowLevel A)) fun p hp => (Finset.mem_filter.mp hp).2]
  have h := windowRep_eq_zero_of_mem (zeta_sub_factoredIndicator_mem (windowLevel A))
  rw [map_sub] at h
  exact sub_eq_zero.mp h

/-- **Each window Euler factor is inverted by `1 − p^{−1/2}T_{log p}`.** -/
theorem windowRep_eulerFactor_mul_inverse (A : ℝ) {p : ℕ} (hp : p.Prime) :
    windowRep A (factoredIndicator {p}) * windowRep A (eulerInverse p) = 1 := by
  rw [← map_mul, eulerFactor_mul_inverse hp, map_one]

end GaloisForLFunctions.WindowTowerOfSpecZ
