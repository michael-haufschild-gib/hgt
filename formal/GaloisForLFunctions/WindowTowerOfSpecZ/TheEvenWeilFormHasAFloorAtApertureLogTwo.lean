private def polyEval : List ℝ → ℝ → ℝ
  | [], _ => 0
  | c :: cs, x => c + x * polyEval cs x

private def coeffAt : List ℝ → ℕ → ℝ
  | [], _ => 0
  | c :: _, 0 => c
  | _ :: cs, p + 1 => coeffAt cs p

private theorem coeffAt_eq_zero_of_le : ∀ (cs : List ℝ) {p : ℕ}, cs.length ≤ p → coeffAt cs p = 0
  | [], _, _ => rfl
  | _ :: _, 0, h => by simp at h
  | _ :: cs, p + 1, h => coeffAt_eq_zero_of_le cs (by simp at h; omega)

private theorem continuous_polyEval : ∀ cs : List ℝ, Continuous (polyEval cs)
  | [] => continuous_const
  | _ :: cs => continuous_const.add (continuous_id.mul (continuous_polyEval cs))

private def polyAdd : List ℝ → List ℝ → List ℝ
  | [], bs => bs
  | as, [] => as
  | a :: as, b :: bs => (a + b) :: polyAdd as bs

private theorem polyEval_add : ∀ (as bs : List ℝ) (x : ℝ),
    polyEval (polyAdd as bs) x = polyEval as x + polyEval bs x
  | [], bs, _ => by simp [polyAdd, polyEval]
  | a :: as, [], _ => by simp [polyAdd, polyEval]
  | a :: as, b :: bs, x => by simp only [polyAdd, polyEval, polyEval_add as bs x]; ring

private def polyDeriv : List ℝ → List ℝ
  | [] => []
  | _ :: cs => polyAdd cs (0 :: polyDeriv cs)

private theorem hasDerivAt_polyEval : ∀ (cs : List ℝ) (x : ℝ),
    HasDerivAt (polyEval cs) (polyEval (polyDeriv cs) x) x
  | [], x => by simpa [polyEval, polyDeriv] using hasDerivAt_const x (0 : ℝ)
  | c :: cs, x => by
    have hd := ((hasDerivAt_id x).mul (hasDerivAt_polyEval cs x)).const_add c
    refine hd.congr_deriv ?_
    simp only [polyDeriv, polyEval_add, polyEval]
    ring

private theorem iterPrim_succ_of_polyEval {f : ℝ → ℝ} (s : ℕ) (ps qs : List ℝ)
    (hps : ∀ y, iterPrim s f y = polyEval ps y)
    (h0 : polyEval qs (-1) = 0)
    (hd : ∀ y, polyEval (polyDeriv qs) y = polyEval ps y) :
    ∀ y, iterPrim (s + 1) f y = polyEval qs y := by
  intro y
  simp only [iterPrim, hps]
  have hderiv : ∀ u ∈ uIcc (-1 : ℝ) y, HasDerivAt (polyEval qs) (polyEval ps u) u :=
    fun u _ => (hasDerivAt_polyEval qs u).congr_deriv (hd u)
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv
    ((continuous_polyEval ps).intervalIntegrable _ _), h0, sub_zero]

private theorem polyEval_eq_sum_of_le : ∀ (cs : List ℝ) {D : ℕ}, cs.length ≤ D →
    ∀ x : ℝ, polyEval cs x = ∑ p ∈ Finset.range D, coeffAt cs p * x ^ p
  | [], D, _, x => by simp [polyEval, coeffAt]
  | c :: cs, 0, h, _ => by simp at h
  | c :: cs, D + 1, h, x => by
    have ih := polyEval_eq_sum_of_le cs (D := D) (by simp at h; omega) x
    rw [polyEval, ih, Finset.sum_range_succ' _ D, coeffAt, pow_zero, mul_one, Finset.mul_sum]
    have hmul : (∑ k ∈ Finset.range D, x * (coeffAt cs k * x ^ k)) =
        ∑ k ∈ Finset.range D, coeffAt (c :: cs) (k + 1) * x ^ (k + 1) :=
      Finset.sum_congr rfl fun k _ => by dsimp [coeffAt]; ring
    rw [hmul, add_comm]

private theorem integral_polyEval_unit {cs : List ℝ} {D : ℕ} (hD : cs.length ≤ D) :
    (∫ ξ in (0 : ℝ)..1, polyEval cs ξ) = ∑ p ∈ Finset.range D, coeffAt cs p / ((p : ℝ) + 1) := by
  simp_rw [polyEval_eq_sum_of_le cs hD]
  rw [intervalIntegral.integral_finsetSum fun p _ =>
    (continuous_const.mul (continuous_pow p)).intervalIntegrable 0 1]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [intervalIntegral.integral_const_mul, integral_pow]
  simp only [one_pow, zero_pow (Nat.succ_ne_zero p), sub_zero, div_eq_mul_inv]
  ring

private theorem integral_polyEval_symm {cs : List ℝ} {D : ℕ} (hD : cs.length ≤ D) :
    (∫ y in (-1 : ℝ)..1, polyEval cs y) =
      ∑ p ∈ Finset.range D, coeffAt cs p * ((1 - (-1 : ℝ) ^ (p + 1)) / ((p : ℝ) + 1)) := by
  simp_rw [polyEval_eq_sum_of_le cs hD]
  rw [intervalIntegral.integral_finsetSum fun p _ =>
    (continuous_const.mul (continuous_pow p)).intervalIntegrable (-1) 1]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [intervalIntegral.integral_const_mul, integral_pow, one_pow]

private theorem affine_unit_integral (f : ℝ → ℝ) (sa sb ds : ℝ) (hds : sb - sa = ds) :
    (∫ x in sa..sb, f x) = ds * ∫ ξ in (0 : ℝ)..1, f (sa + ds * ξ) := by
  have h1 := intervalIntegral.mul_integral_comp_mul_left (f := fun y => f (sa + y)) (a := (0 : ℝ)) (b := 1) (c := ds)
  have h2 := intervalIntegral.integral_comp_add_left f sa (a := ds * (0 : ℝ)) (b := ds * (1 : ℝ))
  rw [mul_zero, add_zero, mul_one, ← hds, add_sub_cancel] at h1 h2
  exact h2.symm.trans h1.symm

private theorem intervalIntegral_mono_on_Ioo {f g : ℝ → ℝ} {a b : ℝ} (hab : a ≤ b)
    (hf : IntervalIntegrable f volume a b) (hg : IntervalIntegrable g volume a b)
    (hpt : ∀ x ∈ Ioo a b, f x ≤ g x) :
    (∫ x in a..b, f x) ≤ ∫ x in a..b, g x := by
  rw [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab,
    integral_Ioc_eq_integral_Ioo, integral_Ioc_eq_integral_Ioo]
  exact setIntegral_mono_on (hf.1.mono_set Ioo_subset_Ioc_self)
    (hg.1.mono_set Ioo_subset_Ioc_self) measurableSet_Ioo hpt

private theorem continuous_lin_polyEval {K : ℕ} (W : Fin K → List ℝ) (m : Fin K → ℝ) :
    Continuous (fun ξ => ∑ i : Fin K, m i * polyEval (W i) ξ) :=
  continuous_finset_sum _ fun _ _ => continuous_const.mul (continuous_polyEval _)

private theorem continuous_bern_atom (B : List ℝ) :
    Continuous (fun ξ : ℝ => ∑ q ∈ Finset.range 23,
      coeffAt B q * (((22 : ℕ).choose q : ℝ) * ξ ^ q * (1 - ξ) ^ (22 - q))) :=
  continuous_finset_sum _ fun q _ =>
    continuous_const.mul ((continuous_const.mul (continuous_pow q)).mul
      ((continuous_const.sub continuous_id).pow (22 - q)))

private theorem bilinear_polyEval_unit {K : ℕ} (D1 D2 : ℕ) (W H : Fin K → List ℝ)
    (hW : ∀ i, (W i).length ≤ D1) (hH : ∀ j, (H j).length ≤ D2) (m : Fin K → ℝ) :
    (∫ ξ in (0 : ℝ)..1,
      (∑ i : Fin K, m i * polyEval (W i) ξ) * (∑ j : Fin K, m j * polyEval (H j) ξ)) =
      ∑ i : Fin K, ∑ j : Fin K,
        (∑ p ∈ Finset.range D1, coeffAt (W i) p *
          (∑ q ∈ Finset.range D2, coeffAt (H j) q / ((p + q : ℕ) + 1 : ℝ))) * m i * m j := by
  have hfn : ∀ ξ : ℝ,
      (∑ i : Fin K, m i * polyEval (W i) ξ) * (∑ j : Fin K, m j * polyEval (H j) ξ) =
      ∑ i : Fin K, ∑ j : Fin K, (m i * m j) * (polyEval (W i) ξ * polyEval (H j) ξ) := fun ξ => by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  simp_rw [hfn]
  rw [intervalIntegral.integral_finsetSum fun i _ =>
    (continuous_finset_sum _ fun j _ =>
      continuous_const.mul ((continuous_polyEval _).mul (continuous_polyEval _))).intervalIntegrable 0 1]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [intervalIntegral.integral_finsetSum fun j _ =>
    (continuous_const.mul ((continuous_polyEval _).mul (continuous_polyEval _))).intervalIntegrable 0 1]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [intervalIntegral.integral_const_mul]
  have hprod : ∀ ξ : ℝ, polyEval (W i) ξ * polyEval (H j) ξ =
      ∑ p ∈ Finset.range D1, ∑ q ∈ Finset.range D2,
        (coeffAt (W i) p * coeffAt (H j) q) * ξ ^ (p + q) := fun ξ => by
    rw [polyEval_eq_sum_of_le (W i) (hW i) ξ, polyEval_eq_sum_of_le (H j) (hH j) ξ, Finset.sum_mul]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [pow_add]; ring
  simp_rw [hprod]
  rw [intervalIntegral.integral_finsetSum fun p _ =>
    (continuous_finset_sum _ fun q _ => continuous_const.mul (continuous_pow _)).intervalIntegrable 0 1]
  have inner_eq : (∑ p ∈ Finset.range D1, ∫ ξ in (0 : ℝ)..1,
      ∑ q ∈ Finset.range D2, (coeffAt (W i) p * coeffAt (H j) q) * ξ ^ (p + q)) =
      ∑ p ∈ Finset.range D1, coeffAt (W i) p *
        ∑ q ∈ Finset.range D2, coeffAt (H j) q / ((p + q : ℕ) + 1 : ℝ) := by
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [intervalIntegral.integral_finsetSum fun q _ =>
      (continuous_const.mul (continuous_pow _)).intervalIntegrable 0 1, Finset.mul_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [intervalIntegral.integral_const_mul, integral_pow]
    simp only [one_pow, zero_pow (Nat.succ_ne_zero _), sub_zero, div_eq_mul_inv]
    ring
  rw [inner_eq]; ring

private theorem bern_basis_expand (f : ℕ → ℝ) (ξ : ℝ) :
    (∑ q ∈ Finset.range 23,
      f q * (((22 : ℕ).choose q : ℝ) * ξ ^ q * (1 - ξ) ^ (22 - q))) =
      f 0 * ((1 : ℝ) * (1 - ξ) ^ 22) +
      f 1 * ((22 : ℝ) * ξ * (1 - ξ) ^ 21) +
      f 2 * ((231 : ℝ) * ξ ^ 2 * (1 - ξ) ^ 20) +
      f 3 * ((1540 : ℝ) * ξ ^ 3 * (1 - ξ) ^ 19) +
      f 4 * ((7315 : ℝ) * ξ ^ 4 * (1 - ξ) ^ 18) +
      f 5 * ((26334 : ℝ) * ξ ^ 5 * (1 - ξ) ^ 17) +
      f 6 * ((74613 : ℝ) * ξ ^ 6 * (1 - ξ) ^ 16) +
      f 7 * ((170544 : ℝ) * ξ ^ 7 * (1 - ξ) ^ 15) +
      f 8 * ((319770 : ℝ) * ξ ^ 8 * (1 - ξ) ^ 14) +
      f 9 * ((497420 : ℝ) * ξ ^ 9 * (1 - ξ) ^ 13) +
      f 10 * ((646646 : ℝ) * ξ ^ 10 * (1 - ξ) ^ 12) +
      f 11 * ((705432 : ℝ) * ξ ^ 11 * (1 - ξ) ^ 11) +
      f 12 * ((646646 : ℝ) * ξ ^ 12 * (1 - ξ) ^ 10) +
      f 13 * ((497420 : ℝ) * ξ ^ 13 * (1 - ξ) ^ 9) +
      f 14 * ((319770 : ℝ) * ξ ^ 14 * (1 - ξ) ^ 8) +
      f 15 * ((170544 : ℝ) * ξ ^ 15 * (1 - ξ) ^ 7) +
      f 16 * ((74613 : ℝ) * ξ ^ 16 * (1 - ξ) ^ 6) +
      f 17 * ((26334 : ℝ) * ξ ^ 17 * (1 - ξ) ^ 5) +
      f 18 * ((7315 : ℝ) * ξ ^ 18 * (1 - ξ) ^ 4) +
      f 19 * ((1540 : ℝ) * ξ ^ 19 * (1 - ξ) ^ 3) +
      f 20 * ((231 : ℝ) * ξ ^ 20 * (1 - ξ) ^ 2) +
      f 21 * ((22 : ℝ) * ξ ^ 21 * (1 - ξ)) +
      f 22 * ((1 : ℝ) * ξ ^ 22) := by
  rw [sum_range_23]
  norm_num [Nat.choose_eq_factorial_div_factorial, Nat.factorial]
  ring

private theorem linear_comb_bernstein_l2 {K : ℕ} (B : Fin K → List ℝ) {Err : Fin K → ℝ → ℝ}
    (hEc : ∀ k, Continuous (Err k))
    (hBern : ∀ k ξ, Err k ξ = ∑ q ∈ Finset.range 23,
      coeffAt (B k) q * (((22 : ℕ).choose q : ℝ) * ξ ^ q * (1 - ξ) ^ (22 - q)))
    (m : Fin K → ℝ) :
    (∫ ξ in (0 : ℝ)..1, (∑ k : Fin K, m k * Err k ξ) ^ 2) ≤
      (1 / (23 : ℝ)) * ∑ i : Fin K, ∑ j : Fin K,
        (∑ q ∈ Finset.range 23, coeffAt (B i) q * coeffAt (B j) q) * m i * m j := by
  have hPc : Continuous (fun ξ => ∑ k : Fin K, m k * Err k ξ) :=
    continuous_finset_sum _ fun k _ => continuous_const.mul (hEc k)
  have hP : ∀ ξ, (∑ k : Fin K, m k * Err k ξ) = ∑ q ∈ Finset.range 23,
      (∑ k : Fin K, m k * coeffAt (B k) q) *
        (((22 : ℕ).choose q : ℝ) * ξ ^ q * (1 - ξ) ^ (22 - q)) := fun ξ => by
    simp_rw [hBern, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun k _ => by ring
  have hb := bernstein_l2_unit_le 22 (fun q => ∑ k : Fin K, m k * coeffAt (B k) q) hPc hP
  refine hb.trans (le_of_eq ?_)
  have hN : (1 / (((22 : ℕ) : ℝ) + 1)) = (1 / (23 : ℝ)) := by norm_num
  rw [hN]
  congr 1
  have hsq : ∀ q, (∑ k : Fin K, m k * coeffAt (B k) q) ^ 2 =
      ∑ i : Fin K, ∑ j : Fin K, (coeffAt (B i) q * coeffAt (B j) q) * m i * m j := fun q => by
    rw [pow_two, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  simp_rw [hsq]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← Finset.sum_mul]

