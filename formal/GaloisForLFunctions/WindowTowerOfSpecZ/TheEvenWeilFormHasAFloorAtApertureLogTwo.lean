    (hi2_seg (207518749639421909273131 / 500000000000000000000000 : ℝ) (1 / 2) (by norm_num) (by norm_num) (by norm_num))
  have hsp2_1 := intervalIntegral.integral_add_adjacent_intervals
    (hi2_seg (207518749639421909273131 / 500000000000000000000000 : ℝ) (23 / 50 : ℝ) (by norm_num) (by norm_num) (by norm_num))
