    rw [← setIntegral_union (Set.disjoint_left.mpr fun t ht ht' => not_lt_of_ge ht.2 ht')
      measurableSet_Ioi (hiW.mono_set fun _ ht => ht.1) (hiW.mono_set fun t (ht : 2 * A < t) => lt_trans h2A_pos ht),
