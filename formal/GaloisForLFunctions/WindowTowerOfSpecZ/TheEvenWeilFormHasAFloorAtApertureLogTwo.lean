    simp_rw [sum_finK]; dsimp only [lipVec, supVec, pertDiag]; norm_num
    have hm_0 : 0 ≤ m ⟨0, by omega⟩ ^ 2 := sq_nonneg _
    have hm_1 : 0 ≤ m ⟨1, by omega⟩ ^ 2 := sq_nonneg _
    have hm_2 : 0 ≤ m ⟨2, by omega⟩ ^ 2 := sq_nonneg _
    have hm_3 : 0 ≤ m ⟨3, by omega⟩ ^ 2 := sq_nonneg _
    have hm_4 : 0 ≤ m ⟨4, by omega⟩ ^ 2 := sq_nonneg _
    have hm_5 : 0 ≤ m ⟨5, by omega⟩ ^ 2 := sq_nonneg _
    have hm_6 : 0 ≤ m ⟨6, by omega⟩ ^ 2 := sq_nonneg _
