private def phiFn (m : Fin 12 → ℝ) (x : ℝ) : ℝ :=
  ∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * legP (degAt r) x

private theorem dual_pairing_identity {G : ℝ → ℝ} (hGc : Continuous G) :
    let m := halfMoment G
    (∫ u in Ioo (0 : ℝ) 1, G u * phiFn m u) = ∑ i : Fin 12, ∑ j : Fin 12, lamMat i j * m i * m j := by
  intro m
  have h01 : (∫ u in Ioo (0 : ℝ) 1, G u * phiFn m u) = ∫ u in (0 : ℝ)..1, G u * phiFn m u := by
    rw [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1), integral_Ioc_eq_integral_Ioo]
  rw [h01]
  have hfn : ∀ u : ℝ, G u * phiFn m u =
      ∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * (G u * legP (degAt r) u) := fun u => by
    unfold phiFn; rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun r _ => by ring
  simp_rw [hfn]
  rw [intervalIntegral.integral_finsetSum fun r _ =>
    (continuous_const.mul (hGc.mul (continuous_legP _))).intervalIntegrable 0 1]
  simp_rw [intervalIntegral.integral_const_mul]
  change (∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * m r) = _
  simp_rw [sum_finK]; dsimp only [lamMat]; ring

