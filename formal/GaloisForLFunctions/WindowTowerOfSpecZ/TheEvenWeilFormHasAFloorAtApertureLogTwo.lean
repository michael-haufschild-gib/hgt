/-- Unconditional even-sector floor for `weilQuad` at the critical two-prime aperture `A = log 2`. -/
theorem weilQuad_ge_even_at_aperture_log_two {F : ℝ → ℝ} (hF : ContDiff ℝ 2 F)
    (hs : tsupport F ⊆ Icc (-Real.log 2) (Real.log 2)) (heven : ∀ x, F (-x) = F x) :
    (1 / 10 ^ 13 : ℝ) * (∫ x, F x ^ 2) ≤ weilQuad F := by
  have hsA : tsupport F ⊆ Icc (-apertureLogTwo) apertureLogTwo := hs
  have h2A_pos : 0 < 2 * apertureLogTwo := by positivity [apertureLogTwo_pos]
  suffices hdiv : 0 ≤ (weilQuad F - (1 / 10 ^ 13 : ℝ) * ∫ x, F x ^ 2) / (2 * apertureLogTwo) by
    have hm := mul_nonneg hdiv h2A_pos.le
    rw [div_mul_cancel₀ _ h2A_pos.ne'] at hm; linarith
  have hArch := arch_and_moments_ge hF hsA heven
  set G := dilateLogTwo F
  set m := halfMoment G
  set a := primeThreeOffset
  set L4 := (1 - a) / 2
  dsimp only at hArch
  change (∫ u in Ioo (0 : ℝ) 1, G u ^ 2 * (c0Rat + vTrue u)) +
    2 * e2Mid * (∫ u in (0 : ℝ)..(1 / 2), G u * G (1 - u)) +
    2 * e3Mid * (∫ s in (0 : ℝ)..L4, G (1 - s) * G (a + s)) -
    (∑ i : Fin 12, ∑ j : Fin 12, bCleanMat i j * m i * m j) ≤
    (weilQuad F - (1 / 10 ^ 13 : ℝ) * (∫ x, F x ^ 2)) / (2 * apertureLogTwo) at hArch
  have hGc : Continuous G := (contDiff_dilateLogTwo hF).continuous
  have hGsq : ∀ u, G (-u) ^ 2 = G u ^ 2 := fun u => by
    dsimp [G]; unfold dilateLogTwo; rw [mul_neg, heven]
  obtain ⟨hIntLog, _⟩ := logarithmic_lag_half_of_sq_even (contDiff_dilateLogTwo hF) (tsupport_dilateLogTwo hsA) hGsq
  have hiPot : IntegrableOn (fun u => G u ^ 2 * (c0Rat + vTrue u)) (Ioo (0 : ℝ) 1) := by
    have hfn : (fun u => G u ^ 2 * (c0Rat + vTrue u)) =
        fun u => c0Rat * G u ^ 2 + G u ^ 2 * (Real.log 2 - Real.log (1 - u ^ 2) / 2) := funext fun _ => by
      unfold vTrue; ring
    rw [hfn]; exact (((hGc.pow 2).integrableOn_Icc.mono_set Ioo_subset_Icc_self).const_mul _).add hIntLog
  have hpc : Continuous (phiFn m) := continuous_finset_sum _ fun _ _ => continuous_const.mul (continuous_legP _)
  have hiPhi : IntegrableOn (fun u => G u * phiFn m u) (Ioo (0 : ℝ) 1) :=
    (hGc.mul hpc).integrableOn_Icc.mono_set Ioo_subset_Icc_self
  let H_comb : ℝ → ℝ := fun u => G u ^ 2 * (c0Rat + vTrue u) - 2 * (G u * phiFn m u)
  have hiComb : IntegrableOn H_comb (Ioo (0 : ℝ) 1) := hiPot.sub (hiPhi.const_mul 2)
  have hComb_lhs : (∫ u in Ioo (0 : ℝ) 1, H_comb u) =
      (∫ u in Ioo (0 : ℝ) 1, G u ^ 2 * (c0Rat + vTrue u)) -
        2 * ∑ i : Fin 12, ∑ j : Fin 12, lamMat i j * m i * m j := by
    dsimp [H_comb]
    rw [integral_sub hiPot (hiPhi.const_mul 2), integral_const_mul, dual_pairing_identity hGc]
  have hFoldComb := six_interval_folding_diag hiComb
  dsimp only at hFoldComb
  change (∫ u in Ioo (0 : ℝ) 1, H_comb u) =
    (∫ s in (0 : ℝ)..L4, H_comb s + H_comb (1 - s) + H_comb (a + s) + H_comb (1 - a - s)) +
      ∫ u in (1 - a)..(1 / 2), H_comb u + H_comb (1 - u) at hFoldComb
  obtain ⟨ha_lo, ha_hi⟩ := primeThreeShift_bounds
  change primeThreeShiftLo ≤ a at ha_lo; change a ≤ primeThreeShiftHi at ha_hi
  have halo_val : primeThreeShiftLo = (5849625007211561814537389 / 10000000000000000000000000 : ℝ) := by norm_num [primeThreeShiftLo]
  have hahi_val : primeThreeShiftHi = (584962500721156181453739 / 1000000000000000000000000 : ℝ) := by norm_num [primeThreeShiftHi]
  have hL4_nn : 0 ≤ L4 := by dsimp [L4]; linarith
  have hc4_split : (∫ s in (0 : ℝ)..L4, H_comb s + H_comb (1 - s) + H_comb (a + s) + H_comb (1 - a - s)) =
      (∫ s in (0 : ℝ)..L4, f4Integrand G m s) -
        2 * e2Mid * (∫ s in (0 : ℝ)..L4, G s * G (1 - s) + G (a + s) * G (1 - a - s)) -
        2 * e3Mid * (∫ s in (0 : ℝ)..L4, G (1 - s) * G (a + s)) := by
    let p2_4 : ℝ → ℝ := fun s => G s * G (1 - s) + G (a + s) * G (1 - a - s)
    let p3_4 : ℝ → ℝ := fun s => G (1 - s) * G (a + s)
