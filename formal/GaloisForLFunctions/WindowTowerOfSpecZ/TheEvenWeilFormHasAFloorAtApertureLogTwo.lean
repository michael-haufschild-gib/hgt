  have hsp4_7 := intervalIntegral.integral_add_adjacent_intervals
    (hi4_seg (1 / 8 : ℝ) (5 / 32 : ℝ) (by norm_num) (by norm_num) (by linarith [hL4_lo]))
    (hi4_seg (5 / 32 : ℝ) L4 (by norm_num) (by linarith [hL4_lo]) le_rfl)
  have hsp4_8 := intervalIntegral.integral_add_adjacent_intervals
    (hi4_seg (5 / 32 : ℝ) (3 / 16 : ℝ) (by norm_num) (by norm_num) (by linarith [hL4_lo]))
    (hi4_seg (3 / 16 : ℝ) L4 (by norm_num) (by linarith [hL4_lo]) le_rfl)
  have hsp4_9 := intervalIntegral.integral_add_adjacent_intervals
    (hi4_seg (3 / 16 : ℝ) (20751874963942190927313 / 100000000000000000000000 : ℝ) (by norm_num) (by norm_num) (by linarith [hL4_lo]))
    (hi4_seg (20751874963942190927313 / 100000000000000000000000 : ℝ) L4 (by norm_num) (by linarith [hL4_lo]) le_rfl)
  have hu2_lo : 1 - a ≤ (207518749639421909273131 / 500000000000000000000000 : ℝ) := by linarith
  have hi2_seg : ∀ α β : ℝ, 0 ≤ α → α ≤ β → β ≤ 1 → IntervalIntegrable (f2Integrand G m) volume α β :=
    fun α β h0 hαβ h1 => intervalIntegrable_f2Integrand hGc hiPot m h0 hαβ h1
  have hsp2_0 := intervalIntegral.integral_add_adjacent_intervals
