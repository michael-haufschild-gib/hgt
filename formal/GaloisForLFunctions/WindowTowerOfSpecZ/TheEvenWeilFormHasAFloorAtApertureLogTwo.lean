    have hiF4 := intervalIntegrable_f4Integrand hGc hiPot m le_rfl hL4_nn le_rfl
    change IntervalIntegrable (f4Integrand G m) volume 0 L4 at hiF4
    rw [hfn, intervalIntegral.integral_sub (hiF4.sub ((hp2_c.const_mul _).intervalIntegrable 0 L4))
      ((hp3_c.const_mul _).intervalIntegrable 0 L4),
      intervalIntegral.integral_sub hiF4 ((hp2_c.const_mul _).intervalIntegrable 0 L4),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  have h1a_le : 1 - a ≤ 1 / 2 := by linarith
  have hc2_split : (∫ u in (1 - a)..(1 / 2), H_comb u + H_comb (1 - u)) =
      (∫ u in (1 - a)..(1 / 2), f2Integrand G m u) -
        2 * e2Mid * (∫ u in (1 - a)..(1 / 2), G u * G (1 - u)) := by
    let p2_2 : ℝ → ℝ := fun u => G u * G (1 - u)
    have hp2_c : Continuous p2_2 := by dsimp [p2_2]; fun_prop
    have hfn : (fun u => H_comb u + H_comb (1 - u)) =
        fun u => f2Integrand G m u - 2 * e2Mid * p2_2 u := by
      funext u; unfold f2Integrand tridiag2Form; dsimp [H_comb, p2_2]; ring
    have hiF2 := intervalIntegrable_f2Integrand hGc hiPot m (by linarith) h1a_le (by norm_num)
