    · have her := Finset.add_sum_erase Finset.univ (fun j : Fin 12 => |ldlE ⟨10, by omega⟩ j|) (Finset.mem_univ ⟨10, by omega⟩)
      have htot : (∑ j : Fin 12, |ldlE ⟨10, by omega⟩ j|) ≤ 2 * ldlE ⟨10, by omega⟩ ⟨10, by omega⟩ := by
        rw [sum_finK]; norm_num [ldlE]
