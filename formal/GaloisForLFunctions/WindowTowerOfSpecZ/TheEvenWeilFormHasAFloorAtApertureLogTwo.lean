    (hx0_nn : 0 ≤ x0 + x1 * ξ) (hle_true : x0 + x1 * ξ ≤ x_true) (htrue_lt1 : x_true < 1) :
    c0Rat + base ≤ c0Rat + polyEval vList ξ ∧
      c0Rat + polyEval vList ξ ≤ c0Rat + (Real.log 2 - Real.log (1 - x_true ^ 2) / 2) := by
  have hx_lt1 : (x0 + x1 * ξ) ^ 2 < 1 := by nlinarith
  have hz_nn : 0 ≤ ((x0 + x1 * ξ) ^ 2 - t0) / om := div_nonneg (by linarith) hom_pos.le
  have hsum_nn : 0 ≤ ∑ m ∈ Finset.Icc 1 8, (((x0 + x1 * ξ) ^ 2 - t0) / om) ^ m / (2 * (m : ℝ)) :=
    Finset.sum_nonneg fun m _ => div_nonneg (pow_nonneg hz_nn _) (by positivity)
  have htay := exterior_log_potential_ge_shifted_taylor p q t0 om base 8 hom ht0 hbase hxmin hx_lt1
  have hmon := exterior_log_potential_mono hx0_nn hle_true htrue_lt1
  rw [hpoly ξ]
  exact ⟨by linarith, by linarith⟩

