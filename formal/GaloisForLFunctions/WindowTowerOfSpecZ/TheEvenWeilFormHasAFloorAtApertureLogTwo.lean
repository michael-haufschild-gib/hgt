private theorem certMat_entry_eq (i j : Fin 12) :
    certMat i j = 2 * lamMat i j -
      (qSub4Mat_0 i j + qSub4Mat_1 i j + qSub4Mat_2 i j + qSub4Mat_3 i j + qSub4Mat_4 i j + qSub4Mat_5 i j + qSub4Mat_6 i j + qSub4Mat_7 i j + qSub4Mat_8 i j + qSub4Mat_9 i j + qSub2Mat_0 i j + qSub2Mat_1 i j) -
