  have hFoldP2 := six_interval_folding_primeTwo hGc
  dsimp only at hFoldP2
  change (∫ u in (0 : ℝ)..(1 / 2), G u * G (1 - u)) =
    (∫ s in (0 : ℝ)..L4, G s * G (1 - s) + G (a + s) * G (1 - a - s)) +
      ∫ u in (1 - a)..(1 / 2), G u * G (1 - u) at hFoldP2
  have hL4_lo : (20751874963942190927313 / 100000000000000000000000 : ℝ) ≤ L4 := by dsimp [L4]; linarith
  have hi4_seg : ∀ α β : ℝ, 0 ≤ α → α ≤ β → β ≤ L4 → IntervalIntegrable (f4Integrand G m) volume α β :=
    fun α β h0 hαβ hβ => intervalIntegrable_f4Integrand hGc hiPot m h0 hαβ hβ
  have hsp4_0 := intervalIntegral.integral_add_adjacent_intervals
    (hi4_seg (0 : ℝ) (1 / 512 : ℝ) (by norm_num) (by norm_num) (by linarith [hL4_lo]))
