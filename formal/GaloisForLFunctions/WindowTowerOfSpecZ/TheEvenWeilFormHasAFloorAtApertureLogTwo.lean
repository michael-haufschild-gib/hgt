private theorem phiFn_sq_le_sup (m : Fin 12 → ℝ) {x : ℝ} (hx : x ∈ Icc (-1 : ℝ) 1) :
    phiFn m x ^ 2 ≤ (12 : ℝ) * ∑ k : Fin 12, supVec k ^ 2 * m k ^ 2 := by
  have habs : |phiFn m x| ≤ ∑ k : Fin 12, supVec k * |m k| := by
    unfold phiFn
    have hrew : (∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * legP (degAt r) x) =
        ∑ k : Fin 12, m k * (∑ r : Fin 12, lamMat r k * legP (degAt r) x) := by
      simp_rw [Finset.sum_mul, Finset.mul_sum]; rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun r _ => by ring
    rw [hrew]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun k _ => ?_)
    rw [abs_mul, mul_comm]; refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have hleg : ∀ r : Fin 12, |lamMat r k * legP (degAt r) x| ≤ |lamMat r k| := fun r => by
      rw [abs_mul]; exact mul_le_of_le_one_right (abs_nonneg _) (abs_legP_le_one (abs_le.mpr hx) _)
    refine (Finset.sum_le_sum fun r _ => hleg r).trans (le_of_eq ?_)
    rcases k with ⟨kv, hkv⟩; interval_cases kv <;> (rw [sum_finK]; norm_num [lamMat, supVec])
  have h1 := pow_le_pow_left₀ (abs_nonneg _) habs 2
  rw [sq_abs] at h1
  have hcs := fin_sum_mul_sq_le 12 supVec (fun k => |m k|)
  simp only [sq_abs] at hcs; linarith

private theorem phiFn_sub_sq_le_lip (m : Fin 12 → ℝ) {x y δ : ℝ}
    (hx : x ∈ Icc (-1 : ℝ) 1) (hy : y ∈ Icc (-1 : ℝ) 1) (hxy : |x - y| ≤ δ) :
    (phiFn m x - phiFn m y) ^ 2 ≤ δ ^ 2 * ((12 : ℝ) * ∑ k : Fin 12, lipVec k ^ 2 * m k ^ 2) := by
  have hδ : 0 ≤ δ := (abs_nonneg _).trans hxy
  have habs : |phiFn m x - phiFn m y| ≤ δ * ∑ k : Fin 12, lipVec k * |m k| := by
    unfold phiFn
    have hrew : (∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * legP (degAt r) x) -
        (∑ r : Fin 12, (∑ k : Fin 12, lamMat r k * m k) * legP (degAt r) y) =
        ∑ k : Fin 12, m k * (∑ r : Fin 12, lamMat r k * (legP (degAt r) x - legP (degAt r) y)) := by
      rw [← Finset.sum_sub_distrib]; simp_rw [← mul_sub, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]; exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun r _ => by ring
    rw [hrew, Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun k _ => ?_)
    rw [abs_mul, show δ * (lipVec k * |m k|) = |m k| * (δ * lipVec k) by ring]
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have hleg : ∀ r : Fin 12, |lamMat r k * (legP (degAt r) x - legP (degAt r) y)| ≤
        (|lamMat r k| * ((degAt r : ℝ) * ((degAt r : ℝ) + 1) / 2)) * δ := fun r => by
      rw [abs_mul, mul_assoc]; refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
      exact (abs_legP_sub_le hx hy _).trans (mul_le_mul_of_nonneg_left hxy (by positivity))
    refine (Finset.sum_le_sum fun r _ => hleg r).trans (le_of_eq ?_)
    rw [← Finset.sum_mul, mul_comm _ δ]; congr 1
    rcases k with ⟨kv, hkv⟩; interval_cases kv <;> (rw [sum_finK]; norm_num [lamMat, lipVec, degAt])
  have h1 := pow_le_pow_left₀ (abs_nonneg _) habs 2
  rw [sq_abs, mul_pow] at h1
  have hcs := fin_sum_mul_sq_le 12 lipVec (fun k => |m k|)
  simp only [sq_abs] at hcs
  exact h1.trans (mul_le_mul_of_nonneg_left hcs (sq_nonneg δ))

private def vTrue (x : ℝ) : ℝ := Real.log 2 - Real.log (1 - x ^ 2) / 2

private def f4Integrand (G : ℝ → ℝ) (m : Fin 12 → ℝ) (s : ℝ) : ℝ :=
  tridiag4Form (c0Rat + vTrue s) (c0Rat + vTrue (1 - s))
    (c0Rat + vTrue (primeThreeOffset + s)) (c0Rat + vTrue (1 - primeThreeOffset - s))
    e2Mid e3Mid (G s) (G (1 - s)) (G (primeThreeOffset + s)) (G (1 - primeThreeOffset - s)) -
  2 * (G s * phiFn m s + G (1 - s) * phiFn m (1 - s) +
    G (primeThreeOffset + s) * phiFn m (primeThreeOffset + s) +
    G (1 - primeThreeOffset - s) * phiFn m (1 - primeThreeOffset - s))

private def f2Integrand (G : ℝ → ℝ) (m : Fin 12 → ℝ) (u : ℝ) : ℝ :=
  tridiag2Form (c0Rat + vTrue u) (c0Rat + vTrue (1 - u)) e2Mid (G u) (G (1 - u)) -
  2 * (G u * phiFn m u + G (1 - u) * phiFn m (1 - u))

private theorem intervalIntegrable_f4Integrand {G : ℝ → ℝ} (hGc : Continuous G)
    (hiPot : IntegrableOn (fun u => G u ^ 2 * (c0Rat + vTrue u)) (Ioo (0 : ℝ) 1))
    (m : Fin 12 → ℝ) {α β : ℝ} (h0 : 0 ≤ α) (hαβ : α ≤ β)
    (hβ : β ≤ (1 - primeThreeOffset) / 2) :
    IntervalIntegrable (f4Integrand G m) volume α β := by
  obtain ⟨ha_lo, ha_hi⟩ := primeThreeOffset_bounds
  let H_pot : ℝ → ℝ := fun u => (c0Rat + vTrue u) * G u ^ 2
  have hH_Ioo : IntegrableOn H_pot (Ioo (0 : ℝ) 1) :=
    hiPot.congr_fun (fun u _ => mul_comm _ _) measurableSet_Ioo
  have hH_Icc : IntegrableOn H_pot (Icc (0 : ℝ) 1) :=
    (integrableOn_Icc_iff_integrableOn_Ioo).mpr hH_Ioo
  have hii : ∀ p q : ℝ, 0 ≤ p → p ≤ q → q ≤ 1 → IntervalIntegrable H_pot volume p q :=
    fun p q hp hpq hq => (intervalIntegrable_iff_integrableOn_Icc_of_le hpq).mpr
      (hH_Icc.mono_set fun x hx => ⟨hp.trans hx.1, hx.2.trans hq⟩)
  have i0 : IntervalIntegrable H_pot volume α β := hii α β h0 hαβ (by linarith)
  have i1 : IntervalIntegrable (fun s => H_pot (1 - s)) volume α β := by
    have h := ((hii (1 - β) (1 - α) (by linarith) (by linarith) (by linarith)).comp_sub_left 1).symm
    have e1 : 1 - (1 - α) = α := by ring
    have e2 : 1 - (1 - β) = β := by ring
    rwa [e1, e2] at h
  have i2 : IntervalIntegrable (fun s => H_pot (primeThreeOffset + s)) volume α β := by
    have h := (hii (primeThreeOffset + α) (primeThreeOffset + β) (by linarith) (by linarith) (by linarith)).comp_add_left primeThreeOffset
    have e1 : primeThreeOffset + α - primeThreeOffset = α := by ring
    have e2 : primeThreeOffset + β - primeThreeOffset = β := by ring
    rwa [e1, e2] at h
  have i3 : IntervalIntegrable (fun s => H_pot (1 - primeThreeOffset - s)) volume α β := by
    have h := ((hii (1 - primeThreeOffset - β) (1 - primeThreeOffset - α) (by linarith) (by linarith) (by linarith)).comp_sub_left (1 - primeThreeOffset)).symm
