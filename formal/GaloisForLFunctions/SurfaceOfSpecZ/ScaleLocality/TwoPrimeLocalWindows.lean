import GaloisForLFunctions.SurfaceOfSpecZ.TwoFrobeniiSeeEveryConfiguration
import GaloisForLFunctions.SurfaceOfSpecZ.ScaleLocality.SquareRootWindowsDetectEveryDepth

/-!
# Two-prime difference lags in local windows

Difference lags of the monoid generated by two distinct primes are dense.
Continuity extends a local lower bound to an interior half-window, where
the square-root window criterion detects every positive zero depth.
-/

open Complex Filter Topology

noncomputable section
namespace GaloisForLFunctions.SurfaceOfSpecZ.ScaleLocality

open ArithmeticOrientationGeometry ArithmeticCastelnuovoSeveri SquareRootThreshold Zeta23

/-- Lower bounds on two-prime difference lags in arbitrarily late square-root
windows are equivalent to RH, with no attainment assumption. -/
theorem riemannHypothesis_iff_twoPrime_squareRoot_windows {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) {r : ℝ} (hr : 0 < r) :
    RiemannHypothesis ↔ ∃ K : ℝ, ∀ U : ℝ, ∃ T : ℝ, U ≤ T ∧
      ∀ a b a' b' : ℕ, |twoFrobeniiLag p q a b a' b' - T| ≤ r * Real.sqrt T →
        -K ≤ zetaScalingDatum.orbitCorr splineCycle (twoFrobeniiLag p q a b a' b') := by
  constructor
  · intro hRH
    obtain ⟨K, hK⟩ := (riemannHypothesis_iff_bddBelow_twoFrobeniiLags hp hq hpq).mp hRH
    exact ⟨K, fun U => ⟨U, le_rfl, fun a b a' b' _ => hK a b a' b'⟩⟩
  · rintro ⟨K, hwindow⟩
    have hcontinuous := continuous_zetaOrbitCorr' splineCycle
    have hfull : ∀ U : ℝ, ∃ T : ℝ, U ≤ T ∧ ∀ u : ℝ,
        |u - T| ≤ (r / 2) * Real.sqrt T →
          -((2 * K) * Real.exp (0 * u)) ≤
            2 * (lagStructure zetaZeroConfig (boxSpline 1 3) u).re := by
      intro U
      obtain ⟨T, hT, hbound⟩ := hwindow (max U 1)
      have hT1 : 1 ≤ T := (le_max_right _ _).trans hT
      have hR : 0 < r * Real.sqrt T := mul_pos hr (Real.sqrt_pos.mpr (by linarith only [hT1]))
      let P : Set ℝ := {u | r * Real.sqrt T ≤ |u - T| ∨
        -K ≤ zetaScalingDatum.orbitCorr splineCycle u}
      have hP : IsClosed P :=
        (isClosed_le continuous_const (continuous_id.sub continuous_const).abs).union
          (isClosed_le continuous_const hcontinuous)
      have hlags : ∀ a b a' b' : ℕ, twoFrobeniiLag p q a b a' b' ∈ P := by
        intro a b a' b'
        by_cases h : r * Real.sqrt T ≤ |twoFrobeniiLag p q a b a' b' - T|
        · exact Or.inl h
        · exact Or.inr (hbound a b a' b' (not_le.mp h).le)
      refine ⟨T, (le_max_left _ _).trans hT, fun u hu => ?_⟩
      have hinterior : |u - T| < r * Real.sqrt T := by
        nlinarith only [hu, hR]
      have hvalue := (forall_of_twoFrobeniiLags hp hq hpq hP hlags u).resolve_left
        (not_le.mpr hinterior)
      rw [orbitCorr_eq_re_lagStructure_spline] at hvalue
      simp only [zero_mul, Real.exp_zero, mul_one]
      linarith only [hvalue]
    have hwidth := zeta_re_le_of_squareRoot_windows (by norm_num : (0 : ℝ) ≤ 0)
      (div_pos hr (by norm_num : (0 : ℝ) < 2)) hfull
    apply riemannHypothesis_of_forall_re_le
    intro ρ hρ
    simpa only [add_zero] using hwidth ρ hρ

#print axioms riemannHypothesis_iff_twoPrime_squareRoot_windows

end GaloisForLFunctions.SurfaceOfSpecZ.ScaleLocality
