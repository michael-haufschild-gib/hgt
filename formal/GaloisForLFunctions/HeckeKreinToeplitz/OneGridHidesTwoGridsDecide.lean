import GaloisForLFunctions.HeckeKreinToeplitz.LogarithmicCharactersAndTheArithmeticIndexFormula
import GaloisForLFunctions.RHTower.GelfondSchneider
import Mathlib.Topology.Instances.AddCircle.DenseSubgroup

/-!
# One grid hides, two grids decide

The local-to-global law of the theory: how the negative index of a Krein–Langer kernel on `Γ`
restricts to sublattices.

**Pullback** (`comp_add_sum_pairKernel`). Restricting `p + Σ_j h_{χ_j,ω_j}` along a homomorphism
gives a positive-definite part plus the pairs of the restricted characters.

**One grid hides** (`negIndex_zpowers_le_card_image`, `negIndex_zpowers_eq_card_classes`). On the
cyclic subgroup `⟨u⟩` a character is its value `χ(u)`. Pairs with equal values merge into one pair
whose weight is the sum of their weights. The restricted index is at most the number of distinct
values, and equals the number of classes with nonzero total weight when the class values are off
the unit circle and no class value is the reflection `1/v̄` of another.

**Arithmetic one-prime law** (`negIndex_prime_eq_card_classes`). For points `ρ_j` right of the line
and a prime `p`, the values `p^{ρ_j−1/2}` have modulus `> 1`, so the separation holds automatically
and the index on `⟨p⟩` is the number of classes `{ρ : p^{ρ−1/2} = v}` with nonzero total weight.
Two right points alias at `p` iff their difference lies in `(2πi/log p)ℤ`.

**Two grids decide** (`negIndex_twoPrime_eq`). On the rank-two sublattice generated by two distinct
primes the scales `m log p + n log q` are dense (`log q/log p ∉ ℚ`), so the arithmetic index formula
applies there: the restriction has the full index `κ`. Positivity on `Γ` of a Krein–Langer kernel
with arithmetic pairs is decided by any two primes, never by fewer in general.
-/

open Complex Finset Filter
open scoped ComplexConjugate Real
open GaloisForLFunctions.HTGeometry

noncomputable section

namespace GaloisForLFunctions.HeckeKreinToeplitz

/-! ### Pullback of pair kernels -/

section Pullback

variable {G H : Type*} [Group G] [Group H]

theorem reflectChar_comp (χ : G →* ℂ) (f : H →* G) :
    reflectChar (χ.comp f) = (reflectChar χ).comp f := by
  ext u
  simp only [reflectChar_apply, MonoidHom.comp_apply, map_inv]

theorem pairKernel_comp (χ : G →* ℂ) (ω : ℂ) (f : H →* G) :
    pairKernel χ ω ∘ f = pairKernel (χ.comp f) ω := by
  funext u
  simp only [Function.comp_apply, pairKernel, reflectChar_comp, MonoidHom.comp_apply]

theorem comp_add_sum_pairKernel {J : Type*} [Fintype J] (p : G → ℂ) (χ : J → G →* ℂ)
    (ω : J → ℂ) (f : H →* G) :
    (fun g => p g + ∑ j, pairKernel (χ j) (ω j) g) ∘ f =
      fun h => (p ∘ f) h + ∑ j, pairKernel ((χ j).comp f) (ω j) h := by
  funext h
  simp only [Function.comp_apply, ← pairKernel_comp]

theorem pairKernel_sum_weight {J : Type*} (s : Finset J) (χ : G →* ℂ) (ω : J → ℂ) (g : G) :
    pairKernel χ (∑ j ∈ s, ω j) g = ∑ j ∈ s, pairKernel χ (ω j) g := by
  simp only [pairKernel, map_sum, sum_mul, sum_add_distrib]

theorem pairKernel_zero (χ : G →* ℂ) : pairKernel χ 0 = 0 := by
  funext g; simp [pairKernel]

end Pullback

/-! ### Characters of the cyclic group -/

/-- The character `n ↦ v^n` of `ℤ` (written multiplicatively); trivial for `v = 0`. -/
def valChar (v : ℂ) : Multiplicative ℤ →* ℂ where
  toFun n := if v = 0 then 1 else v ^ Multiplicative.toAdd n
  map_one' := by split_ifs <;> simp
  map_mul' m n := by
    split_ifs with hv
    · simp
    · rw [toAdd_mul, zpow_add₀ hv]

theorem valChar_ofAdd_one {v : ℂ} (hv : v ≠ 0) : valChar v (Multiplicative.ofAdd 1) = v := by
  simp [valChar, hv]

theorem reflectChar_valChar_ofAdd_one {v : ℂ} (hv : v ≠ 0) :
    reflectChar (valChar v) (Multiplicative.ofAdd 1) = (conj v)⁻¹ := by
  rw [reflectChar_apply, map_inv_eq_inv, valChar_ofAdd_one hv, map_inv₀]

variable {G : Type*} [Group G]

/-- A character restricted to the cyclic subgroup `⟨u⟩` is the power character of `χ(u)`. -/
theorem comp_zpowersHom (χ : G →* ℂ) (u : G) : χ.comp (zpowersHom G u) = valChar (χ u) := by
  refine MonoidHom.ext fun n => ?_
  simp only [MonoidHom.comp_apply, zpowersHom_apply, valChar, MonoidHom.coe_mk, OneHom.coe_mk,
    if_neg (map_ne_zero χ u)]
  exact map_zpow' χ (map_inv_eq_inv χ) u _

/-! ### One grid hides -/

/-- **One grid hides: the upper bound.** On a cyclic subgroup the index of a positive-definite kernel
plus hyperbolic pairs is at most the number of distinct values `χ_j(u)`. -/
theorem negIndex_zpowers_le_card_image {J : Type*} [Fintype J] {p : G → ℂ}
    (hp : IsPosDefKernel p) (χ : J → G →* ℂ) (ω : J → ℂ) (u : G) :
    negIndex ((fun g => p g + ∑ j, pairKernel (χ j) (ω j) g) ∘ zpowersHom G u) ≤
      (univ.image fun j => χ j u).card := by
  classical
  rw [comp_add_sum_pairKernel, negIndex_le_iff]
  intro n x
  set V := univ.image fun j => χ j u
  refine (Nat.cast_le.mpr (ArithmeticCastelnuovoSeveri.negIndex_le_card_of_nonneg_on_ker _
    (fun v : V => charEval (valChar v) x) fun c hc => ?_)).trans (by rw [Fintype.card_coe])
  rw [hermQuad_gram_add, hermQuad_gram_sum]
  have : ∀ j ∈ (univ : Finset J),
      hermQuad (gram (pairKernel ((χ j).comp (zpowersHom G u)) (ω j)) x) c = 0 := fun j _ => by
    rw [hermQuad_gram_pairKernel, comp_zpowersHom,
      hc ⟨χ j u, mem_image_of_mem _ (mem_univ j)⟩]
    simp
  rw [sum_congr rfl this, sum_const_zero, add_zero]
  exact (hp.comp _).hermQuad_nonneg x c

/-- The class weight `Σ_{j : χ_j(u) = v} ω_j` of a value. -/
def classWeight {J : Type*} [Fintype J] (χ : J → G →* ℂ) (ω : J → ℂ) (u : G) (v : ℂ) : ℂ :=
  ∑ j ∈ univ.filter (fun j => χ j u = v), ω j

/-- Regrouping on `⟨u⟩`: pairs with equal values merge, and their weights add. -/
theorem sum_pairKernel_zpowers {J : Type*} [Fintype J] (χ : J → G →* ℂ) (ω : J → ℂ) (u : G)
    (n : Multiplicative ℤ) :
    ∑ j, pairKernel ((χ j).comp (zpowersHom G u)) (ω j) n =
      ∑ v ∈ (univ.image fun j => χ j u).filter (fun v => classWeight χ ω u v ≠ 0),
        pairKernel (valChar v) (classWeight χ ω u v) n := by
  classical
  rw [sum_filter_of_ne fun v _ hv => by
    by_contra h; rw [h, pairKernel_zero] at hv; exact hv rfl]
  rw [← sum_fiberwise_of_maps_to (g := fun j => χ j u) (t := univ.image fun j => χ j u)
    fun j _ => mem_image_of_mem _ (mem_univ j)]
  refine sum_congr rfl fun v _ => ?_
  rw [classWeight, pairKernel_sum_weight]
  refine sum_congr rfl fun j hj => ?_
  rw [comp_zpowersHom, (mem_filter.mp hj).2]

/-- **One grid hides: the exact aliasing law.** If the distinct values `v` of the characters at `u`
are off the unit circle and no value is the reflection `1/v̄'` of another, the index on `⟨u⟩` is the
number of value classes with nonzero total weight. -/
theorem negIndex_zpowers_eq_card_classes {J : Type*} [Fintype J] {p : G → ℂ}
    (hp : IsPosDefKernel p) (χ : J → G →* ℂ) (ω : J → ℂ) (u : G)
    (hV1 : ∀ j, ‖χ j u‖ ≠ 1) (hV2 : ∀ j k, χ j u ≠ (conj (χ k u))⁻¹) :
    negIndex ((fun g => p g + ∑ j, pairKernel (χ j) (ω j) g) ∘ zpowersHom G u) =
      ((univ.image fun j => χ j u).filter fun v => classWeight χ ω u v ≠ 0).card := by
  classical
  set S := (univ.image fun j => χ j u).filter fun v => classWeight χ ω u v ≠ 0
  set e := S.equivFin
  have hmem : ∀ i, ∃ j, χ j u = (e.symm i : ℂ) := fun i => by
    obtain ⟨j, -, hj⟩ := mem_image.mp (mem_filter.mp (e.symm i).2).1
    exact ⟨j, hj⟩
  have hne0 : ∀ i, (e.symm i : ℂ) ≠ 0 := fun i => by
    obtain ⟨j, hj⟩ := hmem i; rw [← hj]; exact map_ne_zero _ _
  have hk : (fun g => p g + ∑ j, pairKernel (χ j) (ω j) g) ∘ zpowersHom G u =
      fun n => (p ∘ zpowersHom G u) n + ∑ i, pairKernel (valChar (e.symm i))
        (classWeight χ ω u (e.symm i)) n := by
    rw [comp_add_sum_pairKernel]
    funext n
    rw [sum_pairKernel_zpowers, ← S.sum_coe_sort, ← e.symm.sum_comp]
  have hout : ∀ i, ‖valChar (e.symm i) (Multiplicative.ofAdd 1)‖ ≠ 1 := fun i => by
    rw [valChar_ofAdd_one (hne0 i)]
    obtain ⟨j, hj⟩ := hmem i; rw [← hj]; exact hV1 j
  have hsep : Function.Injective (nodes (fun i => valChar (e.symm i)) (Multiplicative.ofAdd 1)) := by
    rintro (i | i) (i' | i') h <;>
      simp only [nodes, Sum.elim_inl, Sum.elim_inr, valChar_ofAdd_one (hne0 _),
        reflectChar_valChar_ofAdd_one (hne0 _)] at h
    · exact congrArg Sum.inl (e.symm.injective (Subtype.ext h))
    · obtain ⟨j, hj⟩ := hmem i; obtain ⟨k, hk⟩ := hmem i'
      rw [← hj, ← hk] at h; exact absurd h (hV2 j k)
    · obtain ⟨j, hj⟩ := hmem i; obtain ⟨k, hk⟩ := hmem i'
      rw [← hj, ← hk] at h; exact absurd h.symm (hV2 k j)
    · rw [inv_inj, (RingHom.injective _).eq_iff] at h
      exact congrArg Sum.inr (e.symm.injective (Subtype.ext h))
  rw [hk, negIndex_add_sum_pairKernel_eq (hp.comp _) _ _
    (fun i => (mem_filter.mp (e.symm i).2).2) (Multiplicative.ofAdd 1) hout hsep]

/-! ### Arithmetic pairs on one prime -/

/-- The prime `p` as an element of the Hecke lattice. -/
def primeElt {p : ℕ} (hp : p.Prime) : HeckeLattice := ⟨p, by exact_mod_cast hp.pos⟩

theorem scale_primeElt {p : ℕ} (hp : p.Prime) :
    scale heckeLogScale (primeElt hp) = Real.log p := by
  rw [scale_heckeLogScale]; rfl

theorem one_lt_norm_zeroChar_prime {ρ : ℂ} (hρ : 1 / 2 < ρ.re) {p : ℕ} (hp : p.Prime) :
    1 < ‖zeroChar ρ (primeElt hp)‖ := by
  rw [norm_logChar, scale_primeElt, Real.one_lt_exp_iff]
  refine mul_pos (by rw [Complex.sub_re]; norm_num; linarith) (Real.log_pos ?_)
  exact_mod_cast hp.one_lt

/-- **Aliasing criterion.** Two exponents alias at the prime `p` iff their difference times `log p`
lies in `2πiℤ`. -/
theorem zeroChar_prime_eq_iff {ρ ρ' : ℂ} {p : ℕ} (hp : p.Prime) :
    zeroChar ρ (primeElt hp) = zeroChar ρ' (primeElt hp) ↔
      ∃ n : ℤ, (ρ - ρ') * Real.log p = n * (2 * π * I) := by
  rw [logChar_apply, logChar_apply, scale_primeElt, Complex.exp_eq_exp_iff_exists_int]
  refine exists_congr fun n => ?_
  constructor <;> intro h <;> linear_combination h

/-- **The arithmetic one-prime law.** For points right of the critical line, the index of a
Krein–Langer kernel on the tower of a prime `p` is the number of aliasing classes
`{ρ : p^{ρ−1/2} = v}` with nonzero total weight. -/
theorem negIndex_prime_eq_card_classes {κ : ℕ} {p : HeckeLattice → ℂ} (hp : IsPosDefKernel p)
    (ρ : Fin κ → ℂ) (hre : ∀ j, 1 / 2 < (ρ j).re) (ω : Fin κ → ℂ) {q : ℕ} (hq : q.Prime) :
    negIndex ((fun g => p g + ∑ j, pairKernel (zeroChar (ρ j)) (ω j) g) ∘
        zpowersHom _ (primeElt hq)) =
      ((univ.image fun j => zeroChar (ρ j) (primeElt hq)).filter
        fun v => classWeight (fun j => zeroChar (ρ j)) ω (primeElt hq) v ≠ 0).card := by
  refine negIndex_zpowers_eq_card_classes hp _ ω _
    (fun j => (one_lt_norm_zeroChar_prime (hre j) hq).ne') fun j k h => ?_
  have h1 := one_lt_norm_zeroChar_prime (hre j) hq
  have h2 : ‖(conj (zeroChar (ρ k) (primeElt hq)))⁻¹‖ < 1 := by
    rw [norm_inv, Complex.norm_conj]
    exact inv_lt_one_of_one_lt₀ (one_lt_norm_zeroChar_prime (hre k) hq)
  rw [h] at h1
  exact absurd h1 (not_lt.mpr h2.le)

/-! ### Two primes decide -/

theorem scale_zpow {G : Type*} [Group G] (ℓ : G →* Multiplicative ℝ) (u : G) (n : ℤ) :
    scale ℓ (u ^ n) = n * scale ℓ u := by
  simp only [scale, map_zpow, toAdd_zpow, zsmul_eq_mul]

theorem logChar_comp {H : Type*} [Group H] (ℓ : G →* Multiplicative ℝ) (s : ℂ) (f : H →* G) :
    (logChar ℓ s).comp f = logChar (ℓ.comp f) s := rfl

/-- The rank-two sublattice generated by two primes. -/
def twoPrimeLattice {p q : ℕ} (hp : p.Prime) (hq : q.Prime) : Subgroup HeckeLattice :=
  Subgroup.closure {primeElt hp, primeElt hq}

/-- The scales `m log p + n log q` of two distinct primes come arbitrarily close to `0`. -/
theorem twoPrime_small {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (ε : ℝ)
    (hε : 0 < ε) : ∃ h : twoPrimeLattice hp hq,
      0 < scale (heckeLogScale.comp (twoPrimeLattice hp hq).subtype) h ∧
        scale (heckeLogScale.comp (twoPrimeLattice hp hq).subtype) h < ε := by
  have hdense : Dense (AddSubgroup.closure {Real.log p, Real.log q} : Set ℝ) :=
    dense_addSubgroupClosure_pair_iff.mpr (RHTower.irrational_log_ratio hq hp hpq.symm)
  obtain ⟨d, hd, hd0, hdε⟩ := hdense.exists_between hε
  obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp hd
  refine ⟨⟨primeElt hp ^ m * primeElt hq ^ n, Subgroup.mem_closure_pair.mpr ⟨m, n, rfl⟩⟩, ?_⟩
  have : scale (heckeLogScale.comp (twoPrimeLattice hp hq).subtype)
      ⟨primeElt hp ^ m * primeElt hq ^ n, Subgroup.mem_closure_pair.mpr ⟨m, n, rfl⟩⟩ = d := by
    change scale heckeLogScale (primeElt hp ^ m * primeElt hq ^ n) = d
    rw [scale_mul, scale_zpow, scale_zpow, scale_primeElt, scale_primeElt, ← hmn, zsmul_eq_mul,
      zsmul_eq_mul]
  rw [this]
  exact ⟨hd0, hdε⟩

/-- **Two primes decide.** On the sublattice generated by two distinct primes, a positive-definite
kernel plus the reflected pairs of `κ` distinct points right of the critical line, with nonzero
weights, has the full index `κ`: two prime towers never alias arithmetic pairs. -/
theorem negIndex_twoPrime_eq {κ : ℕ} {p : HeckeLattice → ℂ} (hp : IsPosDefKernel p)
    (ρ : Fin κ → ℂ) (hρ : Function.Injective ρ) (hre : ∀ j, 1 / 2 < (ρ j).re) (ω : Fin κ → ℂ)
    (hω : ∀ j, ω j ≠ 0) {q₁ q₂ : ℕ} (hq₁ : q₁.Prime) (hq₂ : q₂.Prime) (hne : q₁ ≠ q₂) :
    negIndex ((fun g => p g + ∑ j, pairKernel (zeroChar (ρ j)) (ω j) g) ∘
      (twoPrimeLattice hq₁ hq₂).subtype) = κ := by
  rw [comp_add_sum_pairKernel]
  simp only [logChar_comp]
  exact negIndex_logChar_pairs_eq _ (twoPrime_small hq₁ hq₂ hne) (hp.comp _)
    (fun j => ρ j - 1 / 2) (fun j k h => hρ (sub_left_injective h))
    (fun j => by rw [Complex.sub_re]; norm_num; linarith [hre j]) ω hω

end GaloisForLFunctions.HeckeKreinToeplitz
