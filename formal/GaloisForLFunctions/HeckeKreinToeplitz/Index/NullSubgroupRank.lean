import GaloisForLFunctions.HeckeKreinToeplitz.FiniteIndexIsPositiveMinusFiniteRank
import Mathlib.Analysis.Matrix.Order
import Mathlib.LinearAlgebra.Dimension.StrongRankCondition
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Finite rank from two zero subgroup readings

Let a Hermitian group kernel have at most `r` negative squares and vanish on subgroups `H,D`,
where `H` is normal and `G=HD`. Its full column space has dimension at most `r²`.

A positive completion transfers every relation among the `r` negative features of a zero
subgroup to the corresponding kernel columns. Each subgroup therefore needs at most `r`
column generators. Normality then gives at most `r²` generators for the whole group.
-/

open Complex Finset Matrix
open scoped ComplexConjugate ComplexOrder
open GaloisForLFunctions.HTGeometry

noncomputable section
namespace GaloisForLFunctions.HeckeKreinToeplitz

private theorem gramSquare_quad {ι J : Type*} [Fintype ι] [Fintype J]
    (A : Matrix J ι ℂ) (c : ι → ℂ) :
    hermQuad (Aᴴ * A) c = ∑ j, normSq ((A *ᵥ c) j) := by
  rw [hermQuad, ← Matrix.mulVec_mulVec, dotProduct_mulVec, vecMul_conjTranspose, star_star]
  simp only [dotProduct, Pi.star_apply, Complex.star_def, Complex.re_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [mul_comm, Complex.mul_conj, Complex.ofReal_re]

variable {G : Type*} [Group G] {k : G → ℂ} {r : ℕ}

private theorem completed_gram_posSemidef (hk : IsHermKernel k) (φ : Fin r → G → ℂ)
    (hφ : ∀ (n : ℕ) (x : Fin n → G) (c : Fin n → ℂ),
      0 ≤ hermQuad (gram k x) c + ∑ i, normSq (∑ a, c a * φ i (x a)))
    {n : ℕ} (x : Fin n → G) :
    (gram k x + (Matrix.of fun (i : Fin r) (a : Fin n) => φ i (x a))ᴴ *
      (Matrix.of fun (i : Fin r) (a : Fin n) => φ i (x a))).PosSemidef := by
  let A : Matrix (Fin r) (Fin n) ℂ := fun i a => φ i (x a)
  have hH : (gram k x + Aᴴ * A).IsHermitian := by
    change (gram k x + Aᴴ * A)ᴴ = _
    rw [conjTranspose_add, (gram_isHermitian hk x).eq,
      conjTranspose_mul, conjTranspose_conjTranspose]
  refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg hH fun c => ?_
  refine Complex.le_def.mpr ⟨?_, ?_⟩
  · change 0 ≤ hermQuad (gram k x + Aᴴ * A) c
    rw [hermQuad_add, gramSquare_quad]
    simpa only [A, Matrix.mulVec, dotProduct, mul_comm] using hφ n x c
  · exact (hH.im_star_dotProduct_mulVec_self c).symm

/-- A relation among the negative features of a zero Gram family is a relation among its columns. -/
private theorem column_relation_of_feature_relation (hk : IsHermKernel k)
    (φ : Fin r → G → ℂ)
    (hφ : ∀ (n : ℕ) (x : Fin n → G) (c : Fin n → ℂ),
      0 ≤ hermQuad (gram k x) c + ∑ i, normSq (∑ a, c a * φ i (x a)))
    {n : ℕ} (x : Fin n → G) (c : Fin n → ℂ)
    (hx : ∀ a b, k ((x a)⁻¹ * x b) = 0)
    (hc : ∀ i, ∑ a, c a * φ i (x a) = 0) (y : G) :
    ∑ a, k (y⁻¹ * x a) * c a = 0 := by
  let z : Fin (n + 1) → G := Fin.cons y x
  let v : Fin (n + 1) → ℂ := Fin.cons 0 c
  let A : Matrix (Fin r) (Fin (n + 1)) ℂ := fun i a => φ i (z a)
  let M := gram k z + Aᴴ * A
  have hM : M.PosSemidef := completed_gram_posSemidef hk φ hφ z
  have hAv : A *ᵥ v = 0 := by
    ext i
    simpa only [A, z, v, Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
      Fin.cons_zero, Fin.cons_succ, mul_zero, zero_add, Pi.zero_apply, mul_comm] using hc i
  have hQ : hermQuad M v = 0 := by
    rw [show M = gram k z + Aᴴ * A from rfl, hermQuad_add, gramSquare_quad, hAv]
    simp only [Pi.zero_apply, normSq_zero, sum_const_zero, add_zero]
    rw [hermQuad_gram]
    simp only [z, v, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      map_zero, zero_mul, zero_add, mul_zero, add_zero, hx, sum_const_zero, Complex.zero_re]
  have hdot : star v ⬝ᵥ M *ᵥ v = 0 := by
    apply Complex.ext
    · exact hQ
    · exact hM.isHermitian.im_star_dotProduct_mulVec_self v
  have hMv := (hM.dotProduct_mulVec_zero_iff v).mp hdot
  change (gram k z + Aᴴ * A) *ᵥ v = 0 at hMv
  rw [Matrix.add_mulVec, ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_zero, add_zero] at hMv
  have hzero := congrFun hMv 0
  simpa only [gram, z, v, Matrix.mulVec, dotProduct, Fin.sum_univ_succ,
    Fin.cons_zero, Fin.cons_succ, mul_zero, zero_add, Pi.zero_apply] using hzero

/-- The columns indexed by a zero subgroup are generated by at most `r` of those columns. -/
theorem exists_null_subgroup_column_generators (hk : IsHermKernel k) (hi : negIndex k ≤ r)
    (H : Subgroup G) (hH : ∀ h ∈ H, k h = 0) :
    ∃ (n : ℕ) (a : Fin n → H), n ≤ r ∧ ∀ h : H, ∃ c : Fin n → ℂ,
      ∀ y : G, k (y⁻¹ * h) = ∑ j, c j * k (y⁻¹ * a j) := by
  classical
  obtain ⟨φ, hφ⟩ := (negIndex_le_iff_exists_rank hk r).mp hi
  let F : H → Fin r → ℂ := fun h i => φ i h
  let V := Submodule.span ℂ (Set.range F)
  obtain ⟨f, hf, hspan, _⟩ := Submodule.exists_fun_fin_finrank_span_eq ℂ (Set.range F)
  choose a ha using hf
  have hspan' : Submodule.span ℂ (Set.range (fun j => F (a j))) = V := by
    simpa only [ha] using hspan
  refine ⟨Module.finrank ℂ V, a, ?_, ?_⟩
  · simpa using Submodule.finrank_le V
  · intro h
    have hmem : F h ∈ Submodule.span ℂ (Set.range (fun j => F (a j))) := by
      rw [hspan']
      exact Submodule.subset_span ⟨h, rfl⟩
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hmem
    refine ⟨c, fun y => ?_⟩
    let x : Fin (Module.finrank ℂ V + 1) → G :=
      Fin.cons (h : G) (fun j => (a j : G))
    let d : Fin (Module.finrank ℂ V + 1) → ℂ := Fin.cons 1 (fun j => -c j)
    have hxmem (j) : x j ∈ H := by
      refine Fin.cases h.property (fun j => (a j).property) j
    have hx (i j) : k ((x i)⁻¹ * x j) = 0 :=
      hH _ (H.mul_mem (H.inv_mem (hxmem i)) (hxmem j))
    have hd (i) : ∑ j, d j * φ i (x j) = 0 := by
      have he := congrFun hc i
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, F] at he
      simp only [x, d, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ, one_mul,
        neg_mul, sum_neg_distrib]
      change φ i (h : G) - (∑ j, c j * φ i (a j)) = 0
      exact sub_eq_zero.mpr he.symm
    -- The feature relation has zero completed energy, hence zero pairing with every point.
    have hz := column_relation_of_feature_relation hk φ hφ x d hx hd y
    simp only [x, d, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ, mul_one,
      mul_neg, sum_neg_distrib, ← sub_eq_add_neg] at hz
    simpa only [mul_comm] using sub_eq_zero.mp hz

/-- A column of a group kernel, as a function on the whole group. -/
def kernelColumn (k : G → ℂ) (g : G) : G → ℂ := fun y => k (y⁻¹ * g)

/-- The cyclic column space of a group kernel. -/
def kernelColumnSpan (k : G → ℂ) : Submodule ℂ (G → ℂ) :=
  Submodule.span ℂ (Set.range (kernelColumn k))

private theorem translate_column_relation {ι : Type*} [Fintype ι]
    (k : G → ℂ) (a g : G) (x : ι → G) (c : ι → ℂ)
    (h : kernelColumn k g = ∑ i, c i • kernelColumn k (x i)) :
    kernelColumn k (a * g) = ∑ i, c i • kernelColumn k (a * x i) := by
  funext y
  have he := congrFun h (a⁻¹ * y)
  simpa only [kernelColumn, Finset.sum_apply, Pi.smul_apply,
    _root_.mul_inv_rev, inv_inv, mul_assoc] using he

/-- Two zero subgroup readings, one normal, give a bounded finite column generating family. -/
theorem exists_column_generators_of_zero_subgroups (hk : IsHermKernel k)
    (hi : negIndex k ≤ r) (H D : Subgroup G) (hN : H.Normal)
    (hH : ∀ h ∈ H, k h = 0) (hD : ∀ d ∈ D, k d = 0)
    (hprod : ∀ g, ∃ h ∈ H, ∃ d ∈ D, g = h * d) :
    ∃ (m n : ℕ) (a : Fin m → H) (b : Fin n → D), m ≤ r ∧ n ≤ r ∧
      kernelColumnSpan k = Submodule.span ℂ
        (Set.range (fun p : Fin m × Fin n => kernelColumn k ((b p.2 : G) * a p.1))) := by
  classical
  obtain ⟨m, a, hm, hA⟩ := exists_null_subgroup_column_generators hk hi H hH
  obtain ⟨n, b, hn, hB⟩ := exists_null_subgroup_column_generators hk hi D hD
  refine ⟨m, n, a, b, hm, hn, le_antisymm ?_ ?_⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨g, rfl⟩
    obtain ⟨h, hh, d, hd, rfl⟩ := hprod g
    obtain ⟨c, hc⟩ := hB ⟨d, hd⟩
    have hcd : kernelColumn k d = ∑ j, c j • kernelColumn k (b j) := by
      funext y
      simpa only [kernelColumn, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hc y
    rw [translate_column_relation k h d (fun j => (b j : G)) c hcd]
    apply Submodule.sum_mem
    intro j _
    apply Submodule.smul_mem
    -- Conjugate into the normal subgroup before expanding its column.
    let q : H := ⟨(b j : G)⁻¹ * h * b j, hN.conj_mem' h hh (b j)⟩
    obtain ⟨e, he⟩ := hA q
    have heq : kernelColumn k (q : G) = ∑ i, e i • kernelColumn k (a i) := by
      funext y
      simpa only [kernelColumn, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using he y
    have hes := translate_column_relation k (b j) q (fun i => (a i : G)) e heq
    have hmul : (b j : G) * q = h * b j := by dsimp [q]; group
    rw [hmul] at hes
    rw [hes]
    apply Submodule.sum_mem
    intro i _
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i, j), rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨i, j⟩, rfl⟩
    exact Submodule.subset_span ⟨(b j : G) * a i, rfl⟩

/-- The full column space is finite and its dimension is bounded by the square of the index. -/
theorem finite_columnSpan_of_zero_subgroups (hk : IsHermKernel k)
    (hi : negIndex k ≤ r) (H D : Subgroup G) (hN : H.Normal)
    (hH : ∀ h ∈ H, k h = 0) (hD : ∀ d ∈ D, k d = 0)
    (hprod : ∀ g, ∃ h ∈ H, ∃ d ∈ D, g = h * d) :
    Module.Finite ℂ (kernelColumnSpan k) ∧ Module.finrank ℂ (kernelColumnSpan k) ≤ r * r := by
  obtain ⟨m, n, a, b, hm, hn, he⟩ :=
    exists_column_generators_of_zero_subgroups hk hi H D hN hH hD hprod
  rw [he]
  refine ⟨Module.Finite.of_fg (Submodule.fg_span (Set.finite_range _)), ?_⟩
  exact (finrank_range_le_card (R := ℂ) _).trans (by
    simpa only [Fintype.card_prod, Fintype.card_fin] using Nat.mul_le_mul hm hn)

/-- Every finite Gram matrix of a kernel with zero subgroup readings has rank at most `r²`. -/
theorem rank_gram_le_square_of_zero_subgroups (hk : IsHermKernel k)
    (hi : negIndex k ≤ r) (H D : Subgroup G) (hN : H.Normal)
    (hH : ∀ h ∈ H, k h = 0) (hD : ∀ d ∈ D, k d = 0)
    (hprod : ∀ g, ∃ h ∈ H, ∃ d ∈ D, g = h * d)
    {ι : Type*} [Fintype ι] (x : ι → G) : (gram k x).rank ≤ r * r := by
  classical
  obtain ⟨m, n, a, b, hm, hn, he⟩ :=
    exists_column_generators_of_zero_subgroups hk hi H D hN hH hD hprod
  let f : Fin m × Fin n → ι → ℂ :=
    fun p i => k ((x i)⁻¹ * ((b p.2 : G) * a p.1))
  have hle : Submodule.span ℂ (Set.range (gram k x).col) ≤
      Submodule.span ℂ (Set.range f) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    have hc : kernelColumn k (x j) ∈ Submodule.span ℂ
        (Set.range (fun p : Fin m × Fin n => kernelColumn k ((b p.2 : G) * a p.1))) := by
      rw [← he]
      exact Submodule.subset_span ⟨x j, rfl⟩
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hc
    refine (Submodule.mem_span_range_iff_exists_fun ℂ).mpr ⟨c, ?_⟩
    funext i
    have hci := congrFun hc (x i)
    simpa only [f, kernelColumn, Matrix.col, Matrix.transpose_apply, gram, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul] using hci
  rw [Matrix.rank_eq_finrank_span_cols]
  exact (Submodule.finrank_mono hle).trans ((finrank_range_le_card (R := ℂ) f).trans
    (by simpa only [Fintype.card_prod, Fintype.card_fin] using Nat.mul_le_mul hm hn))

#print axioms exists_null_subgroup_column_generators
#print axioms exists_column_generators_of_zero_subgroups
#print axioms finite_columnSpan_of_zero_subgroups
#print axioms rank_gram_le_square_of_zero_subgroups
end GaloisForLFunctions.HeckeKreinToeplitz
