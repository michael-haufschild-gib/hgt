import GaloisForLFunctions.WindowedLandauTheory.ReciprocityTheory.ClassFieldExistence.SUnitPowerIndex
import GaloisForLFunctions.WindowedLandauTheory.ReciprocityTheory.ClassFieldExistence.KummerRadicalPairing

/-! The radical extension generated by S-units has degree equal to their
power index. Saturation identifies the kernel of the power-class map. -/

noncomputable section

open NumberField IsDedekindDomain GaloisForLFunctions

namespace GlobalTheory.Kummer

variable (K : Type*) [Field K] [NumberField K] (G : Type*) [Group G] [MulSemiringAction G K]
attribute [local instance] primeMulAction
variable (S : SubMulAction G (HeightOneSpectrum (𝓞 K)))

local notation "U" => (sUnits K G S)
local notation "H" => (Multiplicative ↥U)

private def sUnitPowerClass (n : ℕ) : H →* PowerClasses K n :=
  (QuotientGroup.mk' (powMonoidHom n : Kˣ →* Kˣ).range).comp ((U).subtype.toMultiplicative)

private theorem ker_sUnitPowerClass {n : ℕ} (hn : n ≠ 0) :
    (sUnitPowerClass K G S n).ker = (powMonoidHom n : H →* H).range := by
  ext x
  rw [MonoidHom.mem_ker]
  let a : Kˣ := (U).subtype (Multiplicative.toAdd x)
  change ((a : PowerClasses K n) = 1) ↔ _
  rw [QuotientGroup.eq_one_iff]
  change Multiplicative.toAdd x ∈ (nsmulAddMonoidHom (α := Additive Kˣ) n).range.addSubgroupOf U ↔
    Multiplicative.toAdd x ∈ (nsmulAddMonoidHom (α := U) n).range
  rw [range_nsmul_subgroupOf_sUnits K G S hn]

/-- The classes represented by S-units in the group of power classes. -/
def sUnitRadicalClasses (n : ℕ) : Subgroup (PowerClasses K n) :=
  (sUnitPowerClass K G S n).range

variable [Fintype S] (n : ℕ) [NeZero n] [HasEnoughRootsOfUnity K n]

private def sUnitPowerQuotientEquiv :
    H ⧸ (powMonoidHom n : H →* H).range ≃* sUnitRadicalClasses K G S n :=
  (QuotientGroup.quotientMulEquivOfEq (ker_sUnitPowerClass K G S (NeZero.ne n)).symm).trans
    (QuotientGroup.quotientKerEquivRange (sUnitPowerClass K G S n))

instance : Finite (sUnitRadicalClasses K G S n) := by
  letI : (powMonoidHom n : H →* H).range.FiniteIndex := ⟨by
    rw [index_power_sUnits K G S]
    exact pow_ne_zero _ (NeZero.ne n)⟩
  exact Finite.of_equiv _ (sUnitPowerQuotientEquiv K G S n).toEquiv

theorem finrank_sUnitRadicalField (Ω : Type*) [Field Ω] [Algebra K Ω] [IsAlgClosed Ω] :
    Module.finrank K (radicalField (Ω := Ω) (sUnitRadicalClasses K G S n)) =
      n ^ (Fintype.card (InfinitePlace K) + Fintype.card S) := by
  rw [finrank_radicalField, ← Nat.card_congr (sUnitPowerQuotientEquiv K G S n).toEquiv]
  exact index_power_sUnits K G S n

end GlobalTheory.Kummer
