import Mathlib.FieldTheory.KummerExtension
import Mathlib.FieldTheory.Galois.Abelian
import Mathlib.RingTheory.RootsOfUnity.EnoughRootsOfUnity
import Mathlib.Tactic.Group

/-! Adjoining the radicals of a finite subgroup of power classes gives
a finite Galois extension. One root per class generates the extension. -/

noncomputable section

open IntermediateField Polynomial

namespace GlobalTheory.Kummer

/-- The power classes in the unit group of a field. -/
abbrev PowerClasses (K : Type*) [Field K] (n : ℕ) :=
  Kˣ ⧸ (powMonoidHom n : Kˣ →* Kˣ).range

variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] {n : ℕ}

/-- The field generated by the roots whose radicals represent the given classes. -/
def radicalField (Δ : Subgroup (PowerClasses K n)) : IntermediateField K Ω :=
  IntermediateField.adjoin K
    {x : Ω | ∃ a : Kˣ, (a : PowerClasses K n) ∈ Δ ∧ x ^ n = algebraMap K Ω (a : K)}

theorem mem_radicalField {Δ : Subgroup (PowerClasses K n)} {a : Kˣ}
    (ha : (a : PowerClasses K n) ∈ Δ) {x : Ω} (hx : x ^ n = algebraMap K Ω (a : K)) :
    x ∈ radicalField (Ω := Ω) Δ :=
  subset_adjoin _ _ ⟨a, ha, hx⟩

variable [NeZero n] [HasEnoughRootsOfUnity K n]

theorem exists_rootOfUnity_of_pow_eq_one {x : Ω} (hx : x ^ n = 1) :
    ∃ z : rootsOfUnity n K, algebraMap K Ω ((z : Kˣ) : K) = x := by
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K n
  obtain ⟨i, -, hi⟩ := (hζ.map_of_injective (algebraMap K Ω).injective).eq_pow_of_pow_eq_one hx
  refine ⟨⟨(hζ.isUnit (NeZero.ne n)).unit ^ i, ?_⟩, ?_⟩
  · rw [mem_rootsOfUnity', Units.val_pow_eq_pow_val, IsUnit.unit_spec, ← pow_mul, mul_comm,
      pow_mul, hζ.pow_eq_one, one_pow]
  · simpa using hi

omit [HasEnoughRootsOfUnity K n] in
theorem radical_root_ne_zero {a : Kˣ} {x : Ω} (hx : x ^ n = algebraMap K Ω (a : K)) :
    x ≠ 0 := by
  intro h
  rw [h, zero_pow (NeZero.ne n)] at hx
  exact ((_root_.map_ne_zero (algebraMap K Ω)).mpr a.ne_zero) hx.symm

-- The power-class relation turns a quotient of roots into a root of unity.
theorem exists_scalar_mul_of_same_class {a b : Kˣ}
    (hab : (a : PowerClasses K n) = (b : PowerClasses K n)) {x y : Ω}
    (hx : x ^ n = algebraMap K Ω (a : K)) (hy : y ^ n = algebraMap K Ω (b : K)) :
    ∃ c : K, x = algebraMap K Ω c * y := by
  obtain ⟨u, hu⟩ := QuotientGroup.eq.mp hab
  change u ^ n = a⁻¹ * b at hu
  have hb : b = a * u ^ n := by rw [hu, mul_inv_cancel_left]
  let γ := algebraMap K Ω (u : K)
  have hγ : γ ≠ 0 := (_root_.map_ne_zero (algebraMap K Ω)).mpr u.ne_zero
  have hy' : y ^ n = (x * γ) ^ n := by
    rw [hy, hb, Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, mul_pow, hx]
  have hroot : (x * γ / y) ^ n = 1 := by
    rw [div_pow, ← hy', div_self (pow_ne_zero _ (radical_root_ne_zero hy))]
  obtain ⟨z, hz⟩ := exists_rootOfUnity_of_pow_eq_one (K := K) hroot
  refine ⟨((z : Kˣ) : K) / (u : K), ?_⟩
  have he := (eq_div_iff (radical_root_ne_zero hy)).mp hz
  rw [map_div₀]
  change x = algebraMap K Ω ((z : Kˣ) : K) / γ * y
  rw [div_mul_eq_mul_div, he, mul_div_cancel_right₀ _ hγ]

variable (Ω) [IsAlgClosed Ω]

/-- A set of radical roots indexed by the power classes generates the field. -/
theorem exists_radical_generators (Δ : Subgroup (PowerClasses K n)) :
    ∃ (a : Δ → Kˣ) (β : Δ → Ω),
      (∀ x, (a x : PowerClasses K n) = x.val) ∧
      (∀ x, β x ^ n = algebraMap K Ω (a x : K)) ∧
      radicalField (Ω := Ω) Δ = IntermediateField.adjoin K (Set.range β) := by
  choose a ha using fun x : Δ =>
    QuotientGroup.mk'_surjective (powMonoidHom n : Kˣ →* Kˣ).range x.val
  choose β hβ using fun x : Δ =>
    IsAlgClosed.exists_pow_nat_eq (algebraMap K Ω (a x : K)) (NeZero.pos n)
  refine ⟨a, β, ha, hβ, le_antisymm ?_ ?_⟩
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨c, hc, hx⟩
    let i : Δ := ⟨(c : PowerClasses K n), hc⟩
    obtain ⟨u, rfl⟩ := exists_scalar_mul_of_same_class (ha i).symm hx (hβ i)
    exact mul_mem (IntermediateField.algebraMap_mem _ _) (subset_adjoin _ _ ⟨i, rfl⟩)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    apply mem_radicalField _ (hβ i)
    rw [show (a i : PowerClasses K n) = i.val from ha i]
    exact i.2

instance radicalField_finiteDimensional (Δ : Subgroup (PowerClasses K n)) [Finite Δ] :
    FiniteDimensional K (radicalField (Ω := Ω) Δ) := by
  obtain ⟨a, β, ha, hβ, h⟩ := exists_radical_generators Ω Δ
  rw [h]
  letI : Finite (Set.range β) := (Set.finite_range β).to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x hx => by
    obtain ⟨i, rfl⟩ := hx
    refine ⟨X ^ n - C (a i : K), monic_X_pow_sub_C _ (NeZero.ne n), ?_⟩
    simp [hβ i]

instance radicalField_isGalois [CharZero K] (Δ : Subgroup (PowerClasses K n)) :
    IsGalois K (radicalField (Ω := Ω) Δ) := by
  obtain ⟨a, β, ha, hβ, h⟩ := exists_radical_generators Ω Δ
  have he : IntermediateField.adjoin K (Set.range β) = ⨆ i, K⟮β i⟯ := by
    rw [← adjoin_iUnion]
    congr 1
    ext
    simp
  rw [h, he]
  have hsimple (i : Δ) : Normal K K⟮β i⟯ := by
    let y : K⟮β i⟯ := ⟨β i, mem_adjoin_simple_self K _⟩
    have hy : y ^ n = algebraMap K _ (a i : K) := Subtype.ext (hβ i)
    have hgen : K⟮y⟯ = ⊤ := lift_injective _ (by rw [lift_adjoin_simple, lift_top])
    have hint : IsIntegral K y := ⟨X ^ n - C (a i : K), monic_X_pow_sub_C _ (NeZero.ne n), by
      simp [hy]⟩
    letI : IsSplittingField K K⟮β i⟯ (X ^ n - C (a i : K)) := by
      constructor
      · rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
        obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K n
        exact X_pow_sub_C_splits_of_isPrimitiveRoot
          (hζ.map_of_injective (algebraMap K K⟮β i⟯).injective) hy
      · rw [eq_top_iff, ← IntermediateField.top_toSubalgebra, ← hgen,
          IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic]
        apply Algebra.adjoin_mono
        rw [Set.singleton_subset_iff, mem_rootSet_of_ne (X_pow_sub_C_ne_zero (NeZero.pos n) _)]
        simp [hy]
    exact Normal.of_isSplittingField (X ^ n - C (a i : K))
  let E : IntermediateField K Ω := ⨆ i, K⟮β i⟯
  have hnormal : Normal K E := IntermediateField.normal_iSup K Ω
    (fun i : Δ => K⟮β i⟯) (h := hsimple)
  letI : Algebra.IsAlgebraic K E := hnormal.toIsAlgebraic
  exact { to_isSeparable := Algebra.IsAlgebraic.isSeparable_of_perfectField
          to_normal := hnormal }

end GlobalTheory.Kummer
