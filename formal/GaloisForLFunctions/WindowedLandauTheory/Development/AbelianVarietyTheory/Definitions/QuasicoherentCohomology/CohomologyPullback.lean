import GaloisForLFunctions.WindowedLandauTheory.Development.AbelianVarietyTheory.Definitions.QuasicoherentCohomology.CohomologyOn
import GaloisForLFunctions.RHTower.Deninger.DeningerSheafPullbackExact
import Mathlib.Algebra.Homology.DerivedCategory.Ext.Map
import Mathlib.CategoryTheory.Adjunction.Whiskering

/-! Pullback on sheaf cohomology via the exact inverse image of abelian sheaves. -/

open AlgebraicGeometry CategoryTheory CategoryTheory.Abelian CategoryTheory.Limits
  Opposite TopologicalSpace

noncomputable section

namespace GlobalTheory.SchemeCohomology

local instance pullbackSheafHasExt (X : TopCat.{0}) :
    HasExt.{0} (TopCat.Sheaf AddCommGrpCat.{0} X) :=
  hasExt_of_enoughInjectives _

private abbrev AbSheaf (X : TopCat.{0}) := TopCat.Sheaf AddCommGrpCat.{0} X

/-- The free abelian sheaf generated by the open `U`. -/
abbrev openFree {X : TopCat.{0}} (U : Opens X) : AbSheaf X :=
  (presheafToSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{0}).obj
    (yoneda.obj U ⋙ AddCommGrpCat.free)

private def openFreeAdj (X : TopCat.{0}) :=
  (AddCommGrpCat.adj.whiskerRight (Opens X)ᵒᵖ).comp
    (sheafificationAdjunction (Opens.grothendieckTopology X) AddCommGrpCat.{0})

/-- Maps out of the free abelian sheaf on an open are sections on that open. -/
def openFreeHomEquiv {X : TopCat.{0}} (U : Opens X) (F : AbSheaf X) :
    (openFree U ⟶ F) ≃ ToType (F.obj.obj (op U)) :=
  ((openFreeAdj X).homEquiv (yoneda.obj U) F).trans yonedaEquiv

theorem openFreeHomEquiv_natural {X : TopCat.{0}} (U : Opens X)
    {F G : AbSheaf X} (a : openFree U ⟶ F) (b : F ⟶ G) :
    openFreeHomEquiv U G (a ≫ b) = b.hom.app (op U) (openFreeHomEquiv U F a) := by
  have h := (openFreeAdj X).homEquiv_naturality_right a b
  exact (congrArg (fun v => yonedaEquiv v) h).trans (yonedaEquiv_comp _ _)

section Topological

variable {X Y : TopCat.{0}} (f : Y ⟶ X)

private abbrev abPullback := TopCat.Sheaf.pullback AddCommGrpCat.{0} f
private abbrev abPushforward := TopCat.Sheaf.pushforward AddCommGrpCat.{0} f
private abbrev abAdj := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} f

local instance : PreservesFiniteLimits (abPullback f) :=
  RHTower.deningerSheafPullback_preservesFiniteLimits f

local instance : (abPullback f).Additive := by
  letI := preservesBinaryBiproducts_of_preservesBinaryProducts (abPullback f)
  exact Functor.additive_of_preservesBinaryBiproducts _

local instance : (abPushforward f).Additive where
  map_add := rfl

private def pulledOpenHomEquiv (U : Opens X) (G : AbSheaf Y) :
    ((abPullback f).obj (openFree U) ⟶ G) ≃ ToType (G.obj.obj (op ((Opens.map f).obj U))) :=
  ((abAdj f).homEquiv _ G).trans (openFreeHomEquiv U ((abPushforward f).obj G))

private theorem pulledOpenHomEquiv_natural (U : Opens X) {G G' : AbSheaf Y}
    (a : (abPullback f).obj (openFree U) ⟶ G) (b : G ⟶ G') :
    pulledOpenHomEquiv f U G' (a ≫ b) =
      b.hom.app (op ((Opens.map f).obj U)) (pulledOpenHomEquiv f U G a) := by
  have h := (abAdj f).homEquiv_naturality_right a b
  exact (congrArg (openFreeHomEquiv U ((abPushforward f).obj G')) h).trans
    (openFreeHomEquiv_natural U _ ((abPushforward f).map b))

/-- Free abelian sheaves on opens pull back to the free abelian sheaves on their preimages. -/
def pullbackOpenFree (U : Opens X) :
    openFree ((Opens.map f).obj U) ⟶ (abPullback f).obj (openFree U) :=
  (openFreeHomEquiv _ _).symm (pulledOpenHomEquiv f U _ (𝟙 _))

private theorem pullbackOpenFree_comp (U : Opens X) {G : AbSheaf Y}
    (a : (abPullback f).obj (openFree U) ⟶ G) :
    openFreeHomEquiv _ G (pullbackOpenFree f U ≫ a) = pulledOpenHomEquiv f U G a := by
  rw [openFreeHomEquiv_natural, pullbackOpenFree, Equiv.apply_symm_apply,
    ← pulledOpenHomEquiv_natural, Category.id_comp]

instance (U : Opens X) : IsIso (pullbackOpenFree f U) := by
  apply isIso_of_coyoneda_map_bijective
  intro G
  convert ((pulledOpenHomEquiv f U G).trans ((openFreeHomEquiv _ G).symm)).bijective using 1
  funext a
  exact (openFreeHomEquiv _ G).injective ((pullbackOpenFree_comp f U a).trans
    (Equiv.apply_symm_apply _ _).symm)

/-- A map to a direct image induces cohomology pullback to the preimage open. -/
def abelianCohomologyPullback {F : AbSheaf X} {G : AbSheaf Y}
    (φ : F ⟶ (abPushforward f).obj G) (U : Opens X) (n : ℕ) :
    Ext (openFree U) F n →+ Ext (openFree ((Opens.map f).obj U)) G n :=
  let a := Ext.mk₀ ((abAdj f).homEquiv _ _ |>.symm φ)
  let b := Ext.mk₀ (pullbackOpenFree f U)
  (a.postcomp _ (add_zero n)).comp
    ((b.precomp _ (zero_add n)).comp ((abPullback f).mapExtAddHom _ _ n))

private theorem abelianCohomologyPullback_precomp {F F' : AbSheaf X} {G : AbSheaf Y}
    (ψ : F' ⟶ F) (φ : F ⟶ (abPushforward f).obj G) (U : Opens X) (n : ℕ)
    (x : Ext (openFree U) F' n) :
    abelianCohomologyPullback f (ψ ≫ φ) U n x =
      abelianCohomologyPullback f φ U n (x.comp (Ext.mk₀ ψ) (add_zero n)) := by
  let b := Ext.mk₀ (pullbackOpenFree f U)
  change (b.comp (x.mapExactFunctor (abPullback f)) (zero_add n)).comp
      (Ext.mk₀ (((abAdj f).homEquiv _ _).symm (ψ ≫ φ))) (add_zero n) =
    (b.comp ((x.comp (Ext.mk₀ ψ) (add_zero n)).mapExactFunctor (abPullback f))
      (zero_add n)).comp (Ext.mk₀ (((abAdj f).homEquiv _ _).symm φ)) (add_zero n)
  simp only [Adjunction.homEquiv_naturality_left_symm, Ext.mapExactFunctor_comp,
    Ext.mapExactFunctor_mk₀, Ext.comp_assoc_of_third_deg_zero, Ext.mk₀_comp_mk₀]

private theorem abelianCohomologyPullback_postcomp {F : AbSheaf X} {G G' : AbSheaf Y}
    (φ : F ⟶ (abPushforward f).obj G) (g : G ⟶ G') (U : Opens X) (n : ℕ)
    (x : Ext (openFree U) F n) :
    abelianCohomologyPullback f (φ ≫ (abPushforward f).map g) U n x =
      (abelianCohomologyPullback f φ U n x).comp (Ext.mk₀ g) (add_zero n) := by
  change (_ : Ext _ _ n).comp (Ext.mk₀ (((abAdj f).homEquiv _ _).symm
     (φ ≫ (abPushforward f).map g))) (add_zero n) =
    ((_: Ext _ _ n).comp (Ext.mk₀ (((abAdj f).homEquiv _ _).symm φ)) (add_zero n)).comp
      (Ext.mk₀ g) (add_zero n)
  rw [Adjunction.homEquiv_naturality_right_symm, ← Ext.mk₀_comp_mk₀,
    Ext.comp_assoc_of_third_deg_zero]

/-- The comparison from cohomology of a direct image to cohomology on the preimage. -/
abbrev abelianPushforwardComparison (G : AbSheaf Y) (U : Opens X) (n : ℕ) :
    Ext (openFree U) ((abPushforward f).obj G) n →+
      Ext (openFree ((Opens.map f).obj U)) G n :=
  abelianCohomologyPullback f (𝟙 ((abPushforward f).obj G)) U n

theorem abelianPushforwardComparison_map {G G' : AbSheaf Y} (g : G ⟶ G') (U : Opens X)
    (n : ℕ) (x : Ext (openFree U) ((abPushforward f).obj G) n) :
    abelianPushforwardComparison f G' U n (x.comp (Ext.mk₀ ((abPushforward f).map g)) (add_zero n)) =
      (abelianPushforwardComparison f G U n x).comp (Ext.mk₀ g) (add_zero n) := by
  have h₁ := abelianCohomologyPullback_precomp f ((abPushforward f).map g) (𝟙 _) U n x
  have h₂ := abelianCohomologyPullback_postcomp f (𝟙 _) g U n x
  rw [Category.comp_id] at h₁
  rw [Category.id_comp] at h₂
  exact h₁.symm.trans h₂

private theorem adjoint_id (G : AbSheaf Y) :
    ((abAdj f).homEquiv ((abPushforward f).obj G) G).symm (𝟙 _) =
      (abAdj f).counit.app G := by
  rw [Adjunction.homEquiv_counit]
  exact (congrArg (fun a => a ≫ (abAdj f).counit.app G)
    ((abPullback f).map_id ((abPushforward f).obj G))).trans (Category.id_comp _)

theorem abelianPushforwardComparison_bijective_zero (G : AbSheaf Y) (U : Opens X) :
    Function.Bijective (abelianPushforwardComparison f G U 0) := by
  let V := (Opens.map f).obj U
  let e := (openFreeHomEquiv U ((abPushforward f).obj G)).trans (openFreeHomEquiv V G).symm
  let E := Ext.addEquiv₀.toEquiv.trans (e.trans Ext.addEquiv₀.symm.toEquiv)
  have he : (abelianPushforwardComparison f G U 0 : _ → _) = E := by
    funext x
    obtain ⟨a, rfl⟩ := (Ext.mk₀_bijective _ _).surjective x
    change ((Ext.mk₀ (pullbackOpenFree f U)).comp
        ((Ext.mk₀ a).mapExactFunctor (abPullback f)) rfl).comp
        (Ext.mk₀ (((abAdj f).homEquiv _ G).symm (𝟙 _))) rfl =
      Ext.addEquiv₀.symm (e (Ext.addEquiv₀ (Ext.mk₀ a)))
    have e₀ : Ext.addEquiv₀ (Ext.mk₀ a) = a := Ext.addEquiv₀.apply_symm_apply a
    rw [Ext.mapExactFunctor_mk₀, Ext.mk₀_comp_mk₀, Ext.mk₀_comp_mk₀,
      ← Ext.addEquiv₀_symm_apply, e₀]
    apply congrArg (fun m : openFree V ⟶ G => Ext.addEquiv₀.symm m)
    apply (openFreeHomEquiv V G).injective
    rw [Category.assoc, pullbackOpenFree_comp, ← Adjunction.homEquiv_naturality_left_symm,
      Category.comp_id]
    change openFreeHomEquiv U _ ((abAdj f).homEquiv _ G (((abAdj f).homEquiv _ G).symm a)) =
      openFreeHomEquiv V G ((openFreeHomEquiv V G).symm (openFreeHomEquiv U _ a))
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  exact he.symm ▸ E.bijective

theorem abelianPushforwardComparison_boundary {S : ShortComplex (AbSheaf Y)} (hS : S.ShortExact)
    (hT : (S.map (abPushforward f)).ShortExact) (U : Opens X) (n : ℕ)
    (x : Ext (openFree U) ((abPushforward f).obj S.X₃) n) :
    abelianPushforwardComparison f S.X₁ U (n + 1) (x.comp hT.extClass rfl) =
      (abelianPushforwardComparison f S.X₃ U n x).comp hS.extClass rfl := by
  let K := abPullback f
  let H := abPushforward f
  let ε := (abAdj f).counit
  let η : (S.map H).map K ⟶ S :=
    { τ₁ := ε.app S.X₁
      τ₂ := ε.app S.X₂
      τ₃ := ε.app S.X₃
      comm₁₂ := (ε.naturality S.f).symm
      comm₂₃ := (ε.naturality S.g).symm }
  have h := (hT.map_of_exact K).extClass_naturality hS η
  let b := Ext.mk₀ (pullbackOpenFree f U)
  change (b.comp ((x.comp hT.extClass rfl).mapExactFunctor K) (zero_add _)).comp
      (Ext.mk₀ (((abAdj f).homEquiv (H.obj S.X₁) S.X₁).symm (𝟙 _))) (add_zero _) =
    ((b.comp (x.mapExactFunctor K) (zero_add n)).comp
      (Ext.mk₀ (((abAdj f).homEquiv (H.obj S.X₃) S.X₃).symm (𝟙 _))) (add_zero n)).comp hS.extClass rfl
  rw [adjoint_id f S.X₁, adjoint_id f S.X₃]
  let z := x.mapExactFunctor K
  let d := (hT.map_of_exact K).extClass
  let a := Ext.mk₀ (ε.app S.X₁)
  let c := Ext.mk₀ (ε.app S.X₃)
  let w := b.comp z (zero_add n)
  have hmap : (x.comp hT.extClass rfl).mapExactFunctor K = z.comp d rfl :=
    (Ext.mapExactFunctor_comp K x hT.extClass rfl).trans
      (congrArg (fun δ => z.comp δ rfl) (Ext.mapExactFunctor_extClass K hT))
  have hassoc : (b.comp (z.comp d rfl) (zero_add (n + 1))) = w.comp d rfl :=
    (Ext.comp_assoc b z d (zero_add n) rfl (by simp : 0 + n + 1 = n + 1)).symm
  calc
    _ = (b.comp (z.comp d rfl) (zero_add (n + 1))).comp a (add_zero (n + 1)) :=
      congrArg (fun y => (b.comp y (zero_add (n + 1))).comp a (add_zero (n + 1))) hmap
    _ = (w.comp d rfl).comp a (add_zero (n + 1)) :=
      congrArg (fun y => y.comp a (add_zero (n + 1))) hassoc
    _ = w.comp (d.comp a (add_zero 1)) rfl :=
      Ext.comp_assoc_of_third_deg_zero w d a rfl
    _ = w.comp (c.comp hS.extClass (zero_add 1)) rfl :=
      congrArg (fun δ => w.comp δ rfl) h
    _ = _ := (Ext.comp_assoc_of_second_deg_zero w c hS.extClass rfl).symm

end Topological

section Schemes

variable {X Y : Scheme.{0}} (f : Y ⟶ X)

private theorem pushforward_globalSectionEnd (G : Y.Modules) (r : Γ(X, ⊤)) :
    (Scheme.Modules.pushforward f).map (globalSectionEnd G (f.appTop r)) =
      (globalSectionEnd ((Scheme.Modules.pushforward f).obj G) r :
        (Scheme.Modules.pushforward f).obj G ⟶ (Scheme.Modules.pushforward f).obj G) := by
  apply Scheme.Modules.hom_ext
  intro U
  apply AddCommGrpCat.ext
  intro x
  change (restrictGlobal Y (f ⁻¹ᵁ U) (f.appTop r) : Γ(Y, f ⁻¹ᵁ U)) •
    (show Γ(G, f ⁻¹ᵁ U) from x) = (f.app U (restrictGlobal X U r)) •
      (show Γ(G, f ⁻¹ᵁ U) from x)
  exact congrArg (fun a : Γ(Y, f ⁻¹ᵁ U) => a • (show Γ(G, f ⁻¹ᵁ U) from x))
    (ConcreteCategory.congr_hom (f.naturality (homOfLE le_top : U ⟶ ⊤).op) r).symm

private abbrev forgetModule (X : Scheme.{0}) := SheafOfModules.toSheaf X.ringCatSheaf

/-- The direct-image comparison on cohomology is semilinear over pullback of global functions. -/
def CohomologyOn.pushforwardComparison (G : Y.Modules) (U : X.Opens) (n : ℕ) :
    CohomologyOn ((Scheme.Modules.pushforward f).obj G) U n →ₛₗ[f.appTop.hom]
      CohomologyOn G (f ⁻¹ᵁ U) n where
  __ := abelianPushforwardComparison f.base ((forgetModule Y).obj G) U n
  map_smul' r x := by
    let g := (forgetModule Y).map (globalSectionEnd G (f.appTop r))
    let E := (abPushforward f.base).obj ((forgetModule Y).obj G)
    let ψ : E ⟶ E := (forgetModule X).map
      (globalSectionEnd ((Scheme.Modules.pushforward f).obj G) r)
    have h := congrArg (forgetModule X).map (pushforward_globalSectionEnd f G r)
    change (abPushforward f.base).map g = ψ at h
    have eq := abelianPushforwardComparison_map f.base g U n x
    rw [h] at eq
    exact eq

/-- Pullback of cohomology with coefficients along a morphism of sheaves over a scheme map. -/
def CohomologyOn.pullback {F : X.Modules} {G : Y.Modules}
    (φ : F ⟶ (Scheme.Modules.pushforward f).obj G) (U : X.Opens) (n : ℕ) :
    CohomologyOn F U n →ₛₗ[f.appTop.hom] CohomologyOn G (f ⁻¹ᵁ U) n :=
  (CohomologyOn.pushforwardComparison f G U n).comp (CohomologyOn.map φ U n)

end Schemes

end GlobalTheory.SchemeCohomology
