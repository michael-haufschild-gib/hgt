import GaloisForLFunctions.WindowedLandauTheory.Development.AbelianVarietyTheory.Proofs.AbelianSchemeLaws.ProjectiveSectionMorphisms
import GaloisForLFunctions.WindowedLandauTheory.Development.AbelianVarietyTheory.Definitions.QuasicoherentCohomology.RelativeFormsPullback

/-! A projective embedding supplies affine opens generated by its pulled-back ratios. -/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open GlobalTheory.LineBundleSections GlobalTheory.SchemeCohomology UpperTheory.Cb

namespace GlobalTheory.ProjectiveSections.Coordinates

variable {R : Type} [CommRing R] [Nontrivial R] {X : Scheme.{0}} {n : ℕ}
  (a : X ⟶ PSpace R n)

/-- Pull back the standard coordinate ratios along a projective morphism. -/
def ofMorphism : Coordinates X n where
  U i := a ⁻¹ᵁ PSpace.coordinateOpen R n i
  cover := a.iSup_preimage_eq_top (PSpace.iSup_coordinateOpen R n)
  ratio i j := pspacePullRatio a _ i le_rfl j
  ratio_self i := by
    unfold pspacePullRatio pspaceChartRatio
    rw [homogeneousRatio_self, map_one]
  basicOpen_ratio i j := basicOpen_pspacePullRatio a _ i le_rfl j
  ratio_mul i j k := by
    simp only [pspacePullRatio, resG_appLE]
    exact pspacePullRatio_mul a _ i j k inf_le_left inf_le_right

theorem ofMorphism_isAffineOpen [IsClosedImmersion a] (i : Fin (n + 1)) :
    IsAffineOpen ((ofMorphism a).U i) :=
  (pspaceChart_isAffine i).preimage a

/-- The chart functions of a closed subscheme are generated by the pulled-back ratios. -/
theorem ofMorphism_eval_surjective [IsClosedImmersion a]
    {f : X ⟶ Spec (CommRingCat.of R)} (h : a ≫ PSpace.str R n = f) (i : Fin (n + 1)) :
    letI := sectionAlgebra f ((ofMorphism a).U i)
    Function.Surjective (MvPolynomial.eval₂Hom (algebraMap R Γ(X, (ofMorphism a).U i))
      ((ofMorphism a).ratio i)) := by
  let U := PSpace.coordinateOpen R n i
  let V := (ofMorphism a).U i
  let e := pspaceChartAlgEquiv R i
  let ρ := sectionPullback h U
  letI := sectionAlgebra f V
  let F := MvPolynomial.eval₂Hom (algebraMap R Γ(X, V)) ((ofMorphism a).ratio i)
  have he : F.comp (MvPolynomial.rename (R := R) (Subtype.val : {j // j ≠ i} → Fin (n + 1))).toRingHom =
      ρ.toRingHom.comp e.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change F (MvPolynomial.rename Subtype.val (MvPolynomial.C c)) = ρ (e (MvPolynomial.C c))
      rw [MvPolynomial.rename_C, MvPolynomial.eval₂Hom_C]
      change algebraMap R (SectionRing f V) c = ρ (e (algebraMap R _ c))
      rw [e.commutes, ρ.commutes]
    · intro j
      simp only [RingHom.comp_apply, MvPolynomial.rename_X, F, MvPolynomial.eval₂Hom_X',
        AlgHom.toRingHom_eq_coe, e, pspaceChartAlgEquiv_X]
      exact ConcreteCategory.congr_hom (a.appLE_eq_app (U := U)) _
  intro x
  obtain ⟨y, hy⟩ := a.app_surjective U (pspaceChart_isAffine i) x
  refine ⟨MvPolynomial.rename Subtype.val (e.symm y), ?_⟩
  change (F.comp (MvPolynomial.rename Subtype.val).toRingHom) (e.symm y) = _
  rw [he]
  exact (congrArg ρ (e.apply_symm_apply y)).trans hy

end GlobalTheory.ProjectiveSections.Coordinates
