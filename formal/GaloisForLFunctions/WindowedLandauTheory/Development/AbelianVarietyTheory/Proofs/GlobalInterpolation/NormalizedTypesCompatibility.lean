import GaloisForLFunctions.WindowedLandauTheory.Development.AbelianVarietyTheory.Proofs.GlobalInterpolation.SeriesLabelRelabelling

/-! Normalized local types use compatible residue maps, inertia generators
and cuspidal labels, together with the ray field and regular parabolic data. -/

noncomputable section
open Polynomial NumberField IsDedekindDomain
open WindowedLandauTheory.BasicNotions WindowedLandauTheory.CyclotomicNorms
open WindowedLandauTheory.MainNotions.N
open GlobalTheory.GLq
open scoped Classical

namespace WindowedLandauTheory.NormalizedTypes

abbrev RatField := IntermediateField ℚ (AlgebraicClosure ℚ)

/-- A rational prime splits completely when its number of places equals the degree. -/
def SplitsIn (L : RatField) (p : ℕ) : Prop :=
  ({v : HeightOneSpectrum (𝓞 L) | (p : 𝓞 L) ∈ v.asIdeal}).ncard = Module.finrank ℚ L

/-- Primes generated by an integral element that is one modulo the ray modulus. -/
def IsRayPrime (K : RatField) (m p : ℕ) : Prop :=
  p.Prime ∧ ∃ π : AlgebraicClosure ℚ, π ∈ K ∧ IsIntegral ℤ π ∧
    IsIntegral ℤ ((π - 1) / (m : AlgebraicClosure ℚ)) ∧
    ∃ σ : AlgebraicClosure ℚ →ₐ[ℚ] AlgebraicClosure ℚ, π * σ π = (p : AlgebraicClosure ℚ)

def RayAdm (K : RatField) (m : ℕ) (L : RatField) : Prop :=
  K ≤ L ∧ FiniteDimensional ℚ L ∧ ∀ p, IsRayPrime K m p → SplitsIn L p

def rayField (K : RatField) (m : ℕ) : RatField := ⨆ (L : RatField) (_ : RayAdm K m L), L

def KQbar (D : D7) (jE : D.host.E →+* AlgebraicClosure ℚ) : RatField :=
  D.host.K.map jE.toRatAlgHom

def MrayC (D : D7) (jE : D.host.E →+* AlgebraicClosure ℚ) : RatField :=
  rayField (KQbar D jE) D.ntypes.cond

/-- A multiplicative lift whose reduction through the residue equivalence is the identity. -/
def IsTeich {Ω : Type} [Field Ω] (A : ValuationSubring Ω) {p : ℕ} [Fact p.Prime]
    (κ : IsLocalRing.ResidueField A ≃+* Fbar p) (t : Fbar p →* Ω) : Prop :=
  ∀ x, ∃ h : t x ∈ A, κ (IsLocalRing.residue A ⟨t x, h⟩) = x

def redThrough {Ω : Type} [Field Ω] (B : ValuationSubring Ω) {p : ℕ} [Fact p.Prime]
    (κ : IsLocalRing.ResidueField B ≃+* Fbar p) (z : Ω) : Fbar p :=
  if h : z ∈ B then κ (IsLocalRing.residue B ⟨z, h⟩) else 0

def TameCoupled {E Ω : Type} [Field E] [Field Ω] [Algebra E Ω]
    (A : ValuationSubring Ω) {p : ℕ} [Fact p.Prime]
    (κ : IsLocalRing.ResidueField A ≃+* Fbar p) (σ : Ω ≃ₐ[E] Ω) (ζ : ℕ → Fbar p) : Prop :=
  ∀ d, 0 < d → ∀ y : Ω, y ^ (p ^ d - 1) = (p : Ω) → redThrough A κ (σ y / y) = ζ d

/-- Regular isobaric types whose local polynomials have the full rank. -/
def ParC (D : D7) : Type :=
  {Sig : List (Part D.naut.CG) //
    (∀ p ∈ Sig, 1 ≤ p.a ∧ 1 ≤ p.d ∧ D.naut.csd p.π) ∧
    (Sig.map fun p => ((⟨p.a, p.π⟩ : Σ a, D.naut.CG a), p.d)).Nodup ∧
    rankIso D.nd D.naut Sig = D.R.r ∧
    ∀ (k : Fin 2) (v : D.nd.PlG k),
      (D.naut.items₂ k (D.naut.plGw k v) (isoLoc D.nd D.naut Sig (D.naut.plGw k v))).Monic ∧
      (D.naut.items₂ k (D.naut.plGw k v) (isoLoc D.nd D.naut Sig (D.naut.plGw k v))).natDegree = D.R.r}

def RedCompat (D : D7) (i : D.nd.Loc) (B : ValuationSubring ℂ) {p : ℕ}
    (hp : p.Prime) (hpl : p = D.nd.l i) (κ : IsLocalRing.ResidueField B ≃+* Fb p hp) : Prop :=
  ∀ y : D.nd.O i,
    let z := D.naut.iotaQC i (D.naut.iotaQ i (algebraMap (D.nd.O i) (FractionRing (D.nd.O i)) y))
    ∃ h : z ∈ B, fbCast hpl hp (D.nd.lPrime i).out (κ (IsLocalRing.residue B ⟨z, h⟩)) =
      D.naut.kFbar i (IsLocalRing.residue (D.nd.O i) y)

section Labels

variable {g : ℕ} [Fact g.Prime]

/-- The labels respect conjugation of character values and contragredients. -/
def LabelMapEquivariant (O : CuspidalLabelMap g) : Prop :=
  (∀ (d : ℕ) (α : ℂ ≃+* ℂ) (a : ℕ),
    (∀ ζ : ℂ, ζ ^ (∏ e ∈ Finset.Icc 1 d, (g ^ e - 1)) = 1 → α ζ = ζ ^ a) →
    ∀ χ χ' : CuspidalCharacter g d, (∀ γ, χ'.val γ = α (χ.val γ)) →
      rootsBar (O.lab d χ').val = (rootsBar (O.lab d χ).val).map (· ^ a)) ∧
  ∀ (d : ℕ) (χ χ' : CuspidalCharacter g d), (∀ γ, χ'.val γ = χ.val γ⁻¹) →
    rootsBar (O.lab d χ').val = (rootsBar (O.lab d χ).val).map (·⁻¹)

/-- A determinant twist multiplies the roots of a cuspidal label. -/
def LabTwLawO (L : LabelDatum g) (O : CuspidalLabelMap g) : Prop :=
  ∀ (d : ℕ) (χ χ' : CuspidalCharacter g d) (x : ZMod g), x ≠ 0 →
    (∀ (γ : Gn g d) (m : ℕ), L.gen 1 ^ m = algebraMap (ZMod g) (Fbar g) γ.val.det →
      χ'.val γ = L.teich (algebraMap (ZMod g) (Fbar g) x) ^ m * χ.val γ) →
    rootsBar (O.lab d χ').val =
      (rootsBar (O.lab d χ).val).map (· * algebraMap (ZMod g) (Fbar g) x)

end Labels

structure NormalizedTypesCompatibility (D : D7) (jE : D.host.E →+* AlgebraicClosure ℚ) where
  eM : D.ntypes.Mray ≃+* MrayC D jE
  eM_K : ∀ x : D.host.K, (eM (algebraMap D.host.K D.ntypes.Mray x) : AlgebraicClosure ℚ) = jE x

  tA : Fin 2 → ValuationSubring ℂ
  tκ : ∀ k, IsLocalRing.ResidueField (tA k) ≃+* Fb (D.host.g k) (D.host.g_prime k)
  teichC_def : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    IsTeich (tA k) (tκ k) (D.ntypes.teichC k)

  iota_loc : ∀ i : D.nd.Loc, haveI : Fact (D.what₂.places.resChar (D.nd.w i)).Prime :=
      ⟨D.what₂.places.resChar_prime (D.nd.w i)⟩
    ∃ (B : ValuationSubring ℂ)
      (κ : IsLocalRing.ResidueField B ≃+* Fbar (D.what₂.places.resChar (D.nd.w i))),
      RedCompat D i B (D.what₂.places.resChar_prime (D.nd.w i)) (D.nd.w_l i) κ ∧
      ∀ k v x, D.ntypes.iota k v (D.nd.w i) x = redThrough B κ (D.ntypes.teichC k x)

  labelDatum : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩; LabelDatum (D.host.g k)
  teich_eq : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    (labelDatum k).teich = D.ntypes.teichC k
  O : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩; CuspidalLabelMap (D.host.g k)
  O_one : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    ∀ (χ : CuspidalCharacter (D.host.g k) 1) (x : ZMod (D.host.g k)), x ≠ 0 →
      (∀ (γ : Gn (D.host.g k) 1) (m : ℕ),
        (labelDatum k).gen 1 ^ m = algebraMap (ZMod (D.host.g k)) (Fbar (D.host.g k)) γ.val.det →
        χ.val γ = (labelDatum k).teich (algebraMap (ZMod (D.host.g k)) (Fbar (D.host.g k)) x) ^ m) →
      ((O k).lab 1 χ).val = X - C x
  eSer_def : ∀ k f, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    D.ntypes.eSer k f = eSerO (O k) D.R.r f

  kv : ∀ k (v : D.nd.PlG k),
    IsLocalRing.ResidueField (D.nd.plOm.1 (D.naut.plGw k v)) ≃+* Fb (D.host.g k) (D.host.g_prime k)
  tg_tame : ∀ k (v : D.nd.PlG k), haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    TameCoupled (D.nd.plOm.1 (D.naut.plGw k v)) (kv k v) (D.ntypes.tg k v) (labelDatum k).gen
  O_equiv : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    LabelMapEquivariant (O k)
  O_tw : ∀ k, haveI : Fact (D.host.g k).Prime := ⟨D.host.g_prime k⟩
    LabTwLawO (labelDatum k) (O k)

  eP : D.ntypes.Par ≃ ParC D
  locPar_def : ∀ σ w, D.ntypes.locPar σ w = isoLoc D.nd D.naut (eP σ).val w

end WindowedLandauTheory.NormalizedTypes
