import GaloisForLFunctions.WindowedLandauTheory.Development.AbelianVarietyTheory.Proofs.GlobalInterpolation.IntegralCharacterOfDenseValues
import Mathlib.Algebra.Module.Lattice
import Mathlib.LinearAlgebra.Matrix.Basis
import Mathlib.Tactic.Group

/-! A compact p-adic matrix representation defined over a coefficient field
has a stable lattice over its valuation ring. -/

noncomputable section

open Matrix Module
open scoped Pointwise
open WindowedLandauTheory.BasicNotions WindowedLandauTheory.ConjugateSelfDual
open WindowedLandauTheory.MainNotions.N

namespace WindowedLandauTheory.NormalizedTypes

private theorem exists_conj_integral {O K Γ : Type} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O] [Field K]
    [Algebra O K] [IsFractionRing O K] [Group Γ] (n : ℕ) (r : Γ →* GL (Fin n) K) (U : Subgroup Γ)
    [U.FiniteIndex]
    (hU : ∀ h ∈ U, ∀ i j, (r h : Matrix (Fin n) (Fin n) K) i j ∈ (algebraMap O K).range) :
    ∃ P : GL (Fin n) K, ∀ g i j,
      ((P * r g * P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) i j ∈ (algebraMap O K).range := by
  classical
  let col : Γ → Fin n → (Fin n → K) := fun g j i => (r g : Matrix (Fin n) (Fin n) K) i j
  have hcol : ∀ g h j, col (g * h) j = (r g : Matrix (Fin n) (Fin n) K) *ᵥ col h j := by
    intro g h j
    funext i
    simp [col, Matrix.mul_apply, Matrix.mulVec, dotProduct]
  let Λ : Submodule O (Fin n → K) := Submodule.span O (Set.range fun p : Γ × Fin n => col p.1 p.2)
  have hst : ∀ g, ∀ v ∈ Λ, (r g : Matrix (Fin n) (Fin n) K) *ᵥ v ∈ Λ := by
    intro g v hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨p, rfl⟩ := hx
      exact Submodule.subset_span ⟨(g * p.1, p.2), hcol _ _ _⟩
    | zero => simp
    | add x y _ _ hx hy => rw [Matrix.mulVec_add]; exact Λ.add_mem hx hy
    | smul a x _ hx => rw [Matrix.mulVec_smul]; exact Λ.smul_mem a hx
  have hfg : Λ.FG := by
    have : Λ = Submodule.span O (Set.range fun p : (Γ ⧸ U) × Fin n => col p.1.out p.2) := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨⟨g, j⟩, rfl⟩
        obtain ⟨h, hh⟩ := QuotientGroup.mk_out_eq_mul U g
        have hg : g = (QuotientGroup.mk g : Γ ⧸ U).out * (h⁻¹ : U) := by rw [hh]; simp
        choose c hc using hU _ (h⁻¹).2
        have : col g j = ∑ k, c k j • col (QuotientGroup.mk g : Γ ⧸ U).out k := by
          conv_lhs => rw [hg, hcol]
          funext i
          simp only [col, Matrix.mulVec, dotProduct, Finset.sum_apply, Pi.smul_apply]
          exact Finset.sum_congr rfl fun k _ => by rw [Algebra.smul_def, hc, mul_comm]
        show col g j ∈ _
        rw [this]
        exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨(_, k), rfl⟩)
      · exact Submodule.span_mono (by rintro _ ⟨p, rfl⟩; exact ⟨(p.1.out, p.2), rfl⟩)
    rw [this]
    exact Submodule.fg_span (Set.finite_range _)
  have htop : Submodule.span K (Λ : Set (Fin n → K)) = ⊤ := by
    rw [eq_top_iff, ← (Pi.basisFun K (Fin n)).span_eq]
    refine Submodule.span_mono ?_
    rintro _ ⟨j, rfl⟩
    refine Submodule.subset_span ⟨(1, j), ?_⟩
    funext i
    simp [col, Matrix.one_apply, Pi.single_apply]
  haveI : Λ.IsLattice K := ⟨hfg, htop⟩
  haveI : Module.Free O Λ := Submodule.IsLattice.free K Λ
  haveI : Module.Finite O Λ := Module.Finite.iff_fg.2 hfg
  have hrk : Module.finrank O Λ = n := by
    rw [Submodule.IsLattice.finrank_of_pi K Λ, Fintype.card_fin]
  let b : Module.Basis (Fin n) O Λ := Module.finBasisOfFinrankEq O Λ hrk
  let B := b.extendOfIsLattice K
  let e := Pi.basisFun K (Fin n)
  let P : GL (Fin n) K := ⟨B.toMatrix e, e.toMatrix B, by simp, by simp⟩
  refine ⟨P, fun g i j => ?_⟩
  have hB : ∀ j, B j = b j := fun j => b.extendOfIsLattice_apply K j
  have h1 : ((P * r g * P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
      LinearMap.toMatrix B B (Matrix.toLin' (r g : Matrix (Fin n) (Fin n) K)) := by
    rw [← basis_toMatrix_mul_linearMap_toMatrix_mul_basis_toMatrix B e B e]
    simp [P, e]
  rw [h1, LinearMap.toMatrix_apply, Matrix.toLin'_apply, hB]
  set v : Λ := ⟨_, hst g _ (b j).2⟩ with hv
  refine ⟨b.repr v i, ?_⟩
  have h2 : (v : Fin n → K) = ∑ k, algebraMap O K (b.repr v k) • B k := by
    have h3 := congrArg Λ.subtype (b.sum_repr v)
    rw [map_sum] at h3
    refine h3.symm.trans (Finset.sum_congr rfl fun k _ => ?_)
    rw [hB, algebraMap_smul]
    rfl
  show _ = B.repr (v : Fin n → K) i
  rw [h2, B.repr_sum_self]

/-- An open subgroup preserves the coordinate lattice. The span of the
translates of that lattice is generated by finitely many cosets. -/
theorem exists_integral_model_of_coefficient_field (D : D7) (i : D.nd.Loc)
    {Γ : Type} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ]
    (a : ℕ) (ρ : Γ →* GL (Fin a) (Qbar (D.nd.l i)))
    (hc : Continuous fun g => (ρ g).val)
    (hK : ∀ g s t, ∃ x, D.naut.iotaQ i x = (ρ g).val s t) :
    ∃ (r : Γ →* GL (Fin a) (D.nd.O i)) (P : GL (Fin a) (Qbar (D.nd.l i))),
      ∀ g, mapRep (iotaOQ D.nd D.naut i) r g = P⁻¹ * ρ g * P := by
  classical
  let O := D.nd.O i
  let l := D.nd.l i
  letI : Fact l.Prime := D.nd.lPrime i
  let ι := D.naut.iotaQ i
  let K := FractionRing O
  choose f hf using hK
  have hιi : Function.Injective (ι.mapMatrix : Matrix (Fin a) (Fin a) K →+* Matrix (Fin a) (Fin a) (Qbar l)) := by
    intro A B h
    ext s t
    exact ι.injective (congrFun (congrFun h s) t)
  have hM : ∀ g, ι.mapMatrix (Matrix.of (f g)) = ((ρ g : GL _ _) : Matrix (Fin a) (Fin a) (Qbar l)) := by
    intro g; ext s t; exact hf g s t
  let ρ0 : Γ →* Matrix (Fin a) (Fin a) K :=
    { toFun := fun g => Matrix.of (f g)
      map_one' := hιi (by rw [hM, map_one, map_one, Units.val_one])
      map_mul' := fun g h => hιi (by rw [map_mul, hM, hM, hM, map_mul, Units.val_mul]) }
  let ρK : Γ →* GL (Fin a) K := ρ0.toHomUnits
  have hρK : ∀ g, ι.mapMatrix ((ρK g : GL _ _) : Matrix (Fin a) (Fin a) K) =
      ((ρ g : GL _ _) : Matrix (Fin a) (Fin a) (Qbar l)) := fun g => hM g

  let Int : Set (Matrix (Fin a) (Fin a) (Qbar l)) := {M | ∀ s t, ‖M s t‖ ≤ 1}
  have hInt1 : (1 : Matrix (Fin a) (Fin a) (Qbar l)) ∈ Int := by
    intro s t
    by_cases h : s = t
    · subst h; simp
    · simp [Matrix.one_apply_ne h]
  have hIntMul : ∀ A B, A ∈ Int → B ∈ Int → A * B ∈ Int := by
    intro A B hA hB s t
    rw [Matrix.mul_apply]
    refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one fun k _ => ?_
    rw [norm_mul]
    exact mul_le_one₀ (hA s k) (norm_nonneg _) (hB k t)
  have hIntOpen : IsOpen Int := by
    have hEq : Int = ⋂ s, ⋂ t, (fun M : Matrix (Fin a) (Fin a) (Qbar l) => M s t) ⁻¹' Metric.closedBall 0 1 := by
      ext M; simp [Int]
    refine hEq.symm ▸ isOpen_iInter_of_finite fun s => isOpen_iInter_of_finite fun t => ?_
    exact (IsUltrametricDist.isOpen_closedBall (0 : Qbar l) one_ne_zero).preimage
      (continuous_id.matrix_elem s t)
  let U : Subgroup Γ :=
    { carrier := {g | ((ρ g : GL _ _) : Matrix _ _ _) ∈ Int ∧ ((ρ g⁻¹ : GL _ _) : Matrix _ _ _) ∈ Int}
      one_mem' := by simp [hInt1]
      mul_mem' := by
        rintro g h ⟨hg1, hg2⟩ ⟨hh1, hh2⟩
        refine ⟨?_, ?_⟩
        · rw [map_mul, Units.val_mul]; exact hIntMul _ _ hg1 hh1
        · rw [_root_.mul_inv_rev, map_mul, Units.val_mul]; exact hIntMul _ _ hh2 hg2
      inv_mem' := by
        rintro g ⟨h1, h2⟩
        exact ⟨h2, by rwa [inv_inv]⟩ }
  have hUopen : IsOpen (U : Set Γ) :=
    (hIntOpen.preimage hc).inter (hIntOpen.preimage (hc.comp continuous_inv))
  haveI : Finite (Γ ⧸ U) := Subgroup.quotient_finite_of_isOpen U hUopen
  haveI : U.FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  have hUint : ∀ h ∈ U, ∀ i j, ((ρK h : GL _ _) : Matrix (Fin a) (Fin a) K) i j ∈ (algebraMap O K).range := by
    intro h hh i' j
    have heq := congrFun (congrFun (hρK h) i') j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply] at heq
    obtain ⟨y, hy⟩ := (iotaQ_mem_range_iotaOQ_iff D i _).mpr (by
      change ‖ι ((ρK h).val i' j)‖ ≤ 1
      rw [heq]
      exact hh.1 i' j)
    exact ⟨y, ι.injective hy⟩
  obtain ⟨P, hP⟩ := exists_conj_integral (O := O) a ρK U hUint
  choose e he using hP
  have hai : Function.Injective ((algebraMap O K).mapMatrix :
      Matrix (Fin a) (Fin a) O →+* Matrix (Fin a) (Fin a) K) := by
    intro A B h
    ext s t
    exact IsFractionRing.injective O K (congrFun (congrFun h s) t)
  let ρP : Γ →* GL (Fin a) K := (MulAut.conj P).toMonoidHom.comp ρK
  have hE : ∀ g, (algebraMap O K).mapMatrix (Matrix.of (e g)) = (ρP g).val := by
    intro g; ext s t; exact he g s t
  let r0 : Γ →* Matrix (Fin a) (Fin a) O :=
    { toFun := fun g => Matrix.of (e g)
      map_one' := hai (by rw [hE, map_one, map_one, Units.val_one])
      map_mul' := fun g h => hai (by rw [map_mul, hE, hE, hE, ← Units.val_mul, map_mul]) }
  refine ⟨r0.toHomUnits, (Units.map (ι.mapMatrix : Matrix (Fin a) (Fin a) K →+* _).toMonoidHom P)⁻¹, fun g => ?_⟩
  ext1
  rw [inv_inv]
  show (ι.comp (algebraMap O K)).mapMatrix (Matrix.of (e g)) = _
  have : (ι.comp (algebraMap O K)).mapMatrix (Matrix.of (e g)) =
      ι.mapMatrix ((algebraMap O K).mapMatrix (Matrix.of (e g))) := by
    ext s t; rfl
  rw [this, hE]
  change ι.mapMatrix (P * ρK g * P⁻¹).val = _
  rw [Units.val_mul, Units.val_mul, map_mul, map_mul, hρK]
  simp only [Units.val_mul, Units.coe_map, MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe]
  rw [Units.coe_map_inv]
  rfl


end WindowedLandauTheory.NormalizedTypes
