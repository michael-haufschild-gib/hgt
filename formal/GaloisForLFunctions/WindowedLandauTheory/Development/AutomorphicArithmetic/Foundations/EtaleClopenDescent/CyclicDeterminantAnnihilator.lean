import GaloisForLFunctions.HTGeometry.DerivedSelectionGeometry.FittingEnergy

/-! A square presentation of a cyclic module computes its annihilator
by the determinant. -/

noncomputable section

open GaloisForLFunctions.HTGeometry.DerivedSelection

namespace GlobalTheory.PD

variable {R M : Type} [CommRing R] [AddCommGroup M] [Module R M]

private theorem presDetIdeal_eq_span_det_of_exact {n : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (π : (Fin n → R) →ₗ[R] M) (h : LinearMap.range A.mulVecLin = LinearMap.ker π) :
    presDetIdeal π = Ideal.span {A.det} := by
  have hA : IsRelMatrix π A := by
    intro j
    apply LinearMap.mem_ker.mp
    rw [← h]
    exact LinearMap.mem_range.mpr ⟨Pi.single j 1, Matrix.mulVec_single_one A j⟩
  refine le_antisymm (presDetIdeal_le fun B hB => ?_) (Ideal.span_le.mpr ?_)
  · have hc (j : Fin n) : ∃ v : Fin n → R, A.mulVecLin v = fun i => B i j := by
      apply LinearMap.mem_range.mp
      rw [h]
      exact LinearMap.mem_ker.mpr (hB j)
    choose v hv using hc
    let C : Matrix (Fin n) (Fin n) R := Matrix.of fun i j => v j i
    have he : B = A * C := by
      ext i j
      exact (congrFun (hv j) i).symm
    rw [he, Matrix.det_mul, Ideal.mem_span_singleton]
    exact dvd_mul_right _ _
  · exact Set.singleton_subset_iff.mpr (det_mem_presDetIdeal hA)

/-- The annihilator of a cyclic module with a square presentation is
generated by the determinant of the relation matrix. -/
theorem annihilator_eq_span_det_of_cyclic {n : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π)
    (h : LinearMap.range A.mulVecLin = LinearMap.ker π)
    (g : R →ₗ[R] M) (hg : Function.Surjective g) :
    Module.annihilator R M = Ideal.span {A.det} := by
  have hk : Module.annihilator R M = (LinearMap.ker g : Ideal R) := by
    ext r
    constructor
    · intro hr
      apply LinearMap.mem_ker.mpr
      simpa only [← map_smul, smul_eq_mul, mul_one] using
        Module.mem_annihilator.mp hr (g 1)
    · intro hr
      apply Module.mem_annihilator.mpr
      intro m
      obtain ⟨a, rfl⟩ := hg m
      calc
        r • g a = g (r * a) := (map_smul g r a).symm
        _ = g (a • r) := congrArg g (mul_comm _ _)
        _ = 0 := by rw [map_smul, LinearMap.mem_ker.mp hr, smul_zero]
  let e := LinearMap.quotKerEquivOfSurjective g hg
  calc
    _ = fittingIdealZero R (R ⧸ (LinearMap.ker g : Ideal R)) :=
      hk.trans (fittingIdealZero_quotient _).symm
    _ = fittingIdealZero R M := fittingIdealZero_congr e
    _ = presDetIdeal π := fittingIdealZero_eq_presDetIdeal hπ
    _ = _ := presDetIdeal_eq_span_det_of_exact A π h

end GlobalTheory.PD
