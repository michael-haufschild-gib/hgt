import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.SelectedKoszulComponent
import Mathlib.RingTheory.Ideal.Operations

/-! On an invariant lattice, top Koszul boundary values are the
multiple of the lattice by the ideal of the selected weights. -/

noncomputable section

open scoped Pointwise

namespace GlobalTheory.WH

variable {k R E κ : Type} [Field k] [CommRing R] [Algebra k R] [LinearOrder κ]
  [AddCommGroup E] [Module k E] [Module R E] [IsScalarTower k R E]
  {d : ℕ}

/-- Multiplication by the ideal generated by the selected scalars is
the image of the top selected boundary module. -/
theorem selectedBoundaryValues_eq_ideal_smul (P : Submodule R E) (r : κ → R) (e : Fin d ↪o κ) :
    selectedBoundaryValues (P.restrictScalars k) (fun i => Algebra.lsmul k k E (r i)) e =
      ((Ideal.span (Set.range (fun j => r (e j))) • (⊤ : Submodule R P)).restrictScalars k).map
        (P.subtype.restrictScalars k) := by
  rw [selectedBoundaryValues_eq_iSup, Ideal.span_range_eq_iSup, Submodule.iSup_smul,
    Submodule.restrictScalars_iSup, Submodule.map_iSup]
  refine congrArg (fun A : Fin d → Submodule k E => ⨆ j, A j) ?_
  funext i
  rw [Submodule.ideal_span_singleton_smul]
  ext v
  constructor
  · rintro ⟨u, hu, rfl⟩
    let z : P := ⟨u, hu⟩
    refine ⟨r (e i) • z, ?_, rfl⟩
    exact Submodule.smul_mem_pointwise_smul z _ _ Submodule.mem_top
  · rintro ⟨u, hu, h⟩
    change u ∈ r (e i) • (⊤ : Submodule R P) at hu
    obtain ⟨z, _, he⟩ := (Submodule.mem_smul_pointwise_iff_exists u (r (e i)) ⊤).mp hu
    refine ⟨(z : E), z.property, ?_⟩
    exact (congrArg Subtype.val he).trans h

end GlobalTheory.WH
