import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ProjectiveChartMorphisms

/-! The section ring of a nonempty intersection of standard projective
charts is generated by the coordinate ratios with denominators in the intersection. -/

noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open UpperTheory.Cb

namespace GlobalTheory.SchemeCohomology

attribute [local instance] MvPolynomial.gradedAlgebra

variable (K : Type) [Field K] {d : ℕ}

private abbrev interOpen (I : Finset (Fin (d + 1))) : (PSpace K d).Opens :=
  I.inf (PSpace.coordinateOpen K d)

private theorem interOpen_le {I : Finset (Fin (d + 1))} (i : I) :
    interOpen K I ≤ PSpace.coordinateOpen K d i.1 := Finset.inf_le (f := PSpace.coordinateOpen K d) i.2

/-- Coordinate ratios on an intersection, with denominator one of its chart coordinates. -/
def coordinateInterRatio (I : Finset (Fin (d + 1))) (i : I) (j : Fin (d + 1)) :
    SectionRing (PSpace.str K d) (interOpen K I) :=
  pspacePullRatio (𝟙 (PSpace K d)) (interOpen K I) i.1 (interOpen_le K i) j

private theorem coordinateInterRatio_eq_res (I : Finset (Fin (d + 1))) (i : I) (j : Fin (d + 1)) :
    coordinateInterRatio K I i j =
      sectionRes (PSpace.str K d) (homOfLE (interOpen_le K i)) (pspaceChartRatio K i.1 j) := by
  let T : Scheme := PSpace K d
  let U : T.Opens := interOpen K I
  let V : T.Opens := PSpace.coordinateOpen K d i.1
  let q : Γ(T, V) ⟶ Γ(T, U) := T.presheaf.map (homOfLE (interOpen_le K i)).op
  have h : (𝟙 T : T ⟶ T).appLE V U (interOpen_le K i) = q := by
    change (𝟙 T : T ⟶ T).app V ≫ q = q
    rw [Scheme.Hom.id_app]
    exact Category.id_comp q
  exact ConcreteCategory.congr_hom h (pspaceChartRatio K i.1 j)

/-- Pullback of the coordinate ratio on a chart intersection is the
ratio on its inverse image. -/
theorem sectionPullback_coordinateInterRatio {X : Scheme.{0}}
    {s : X ⟶ Spec (CommRingCat.of K)} {f : X ⟶ PSpace K d}
    (hf : f ≫ PSpace.str K d = s) (I : Finset (Fin (d + 1))) (i : I) (j : Fin (d + 1)) :
    sectionPullback hf (interOpen K I) (coordinateInterRatio K I i j) =
      pspacePullRatio f (f ⁻¹ᵁ interOpen K I) i.1 (f.preimage_mono (interOpen_le K i)) j := by
  rw [coordinateInterRatio_eq_res]
  change (f.app (interOpen K I)).hom
    (((PSpace K d).presheaf.map (homOfLE (interOpen_le K i)).op).hom (pspaceChartRatio K i.1 j)) = _
  rw [f.app_eq_appLE (U := interOpen K I)]
  exact ConcreteCategory.congr_hom
    (f.map_appLE le_rfl (homOfLE (interOpen_le K i)).op) _

private theorem coordinateInterRatio_self (I : Finset (Fin (d + 1))) (i : I) :
    coordinateInterRatio K I i i.1 = 1 := by
  let V := PSpace.coordinateOpen K d i.1
  let q := sectionRes (PSpace.str K d) (homOfLE (interOpen_le K i))
  have h : (pspaceChartRatio K i.1 i.1 : SectionRing (PSpace.str K d) V) = 1 :=
    homogeneousRatio_self (MvPolynomial.isHomogeneous_X K i.1)
  exact (coordinateInterRatio_eq_res K I i i.1).trans
    ((congrArg q h).trans (map_one q))

private theorem coordinateInterRatio_mul (I : Finset (Fin (d + 1))) (i j : I) (k : Fin (d + 1)) :
    coordinateInterRatio K I i j.1 * coordinateInterRatio K I j k = coordinateInterRatio K I i k :=
  pspacePullRatio_mul (𝟙 (PSpace K d)) (interOpen K I) i.1 j.1 k
    (interOpen_le K i) (interOpen_le K j)

private theorem basicOpen_prod_chartRatio (i : Fin (d + 1)) (I : Finset (Fin (d + 1))) :
    (PSpace K d).basicOpen (∏ j ∈ I, pspaceChartRatio K i j) =
      PSpace.coordinateOpen K d i ⊓ interOpen K I := by
  classical
  induction I using Finset.induction_on with
  | empty => simp [interOpen]
  | insert j I hj ih =>
    have h : (PSpace K d).basicOpen (pspaceChartRatio K i j) =
        PSpace.coordinateOpen K d i ⊓ PSpace.coordinateOpen K d j :=
      basicOpen_homogeneousRatio (MvPolynomial.isHomogeneous_X K i) (MvPolynomial.isHomogeneous_X K j)
    rw [Finset.prod_insert hj, Scheme.basicOpen_mul, ih, h]
    change (_ ⊓ _) ⊓ (_ ⊓ _) = _ ⊓ (insert j I).inf _
    rw [Finset.inf_insert]
    calc
      _ = (PSpace.coordinateOpen K d i ⊓ PSpace.coordinateOpen K d i) ⊓
          (PSpace.coordinateOpen K d j ⊓ interOpen K I) := by ac_rfl
      _ = _ := by rw [inf_idem]

/-- On a nonempty coordinate intersection, the ratios generate the entire
section algebra. One chart provides the polynomial coordinates, and the
opposite ratios invert the coordinates required on the intersection. -/
theorem adjoin_coordinateInterRatio_eq_top (I : Finset (Fin (d + 1))) (hI : I.Nonempty) :
    Algebra.adjoin K (Set.range fun ij : I × Fin (d + 1) => coordinateInterRatio K I ij.1 ij.2) = ⊤ := by
  classical
  obtain ⟨i₀, hi₀⟩ := hI
  let i : I := ⟨i₀, hi₀⟩
  let V := PSpace.coordinateOpen K d i.1
  let U := interOpen K I
  let A := SectionRing (PSpace.str K d) V
  let B := SectionRing (PSpace.str K d) U
  let q := sectionRes (PSpace.str K d) (homOfLE (interOpen_le K i))
  letI : Algebra A B := q.toRingHom.toAlgebra
  let a : A := ∏ j ∈ I.attach, pspaceChartRatio K i.1 j.1
  have ha : U = (PSpace K d).basicOpen a := by
    change U = (PSpace K d).basicOpen (∏ j ∈ I.attach, pspaceChartRatio K i.1 j.1)
    rw [Finset.prod_attach, basicOpen_prod_chartRatio, inf_eq_right.mpr (interOpen_le K i)]
  letI : IsLocalization.Away a B :=
    (pspaceChart_isAffine i.1).isLocalization_of_eq_basicOpen _ (homOfLE (interOpen_le K i)) ha
  let R := Algebra.adjoin K (Set.range fun ij : I × Fin (d + 1) => coordinateInterRatio K I ij.1 ij.2)
  have hr (j : I) (k : Fin (d + 1)) : coordinateInterRatio K I j k ∈ R :=
    Algebra.subset_adjoin ⟨(j, k), rfl⟩
  have hA (b : A) : q b ∈ R := by
    let E := pspaceChartAlgEquiv K i.1
    let ψ := q.comp E.toAlgHom
    have hψ : ψ = MvPolynomial.aeval (fun j => coordinateInterRatio K I i j.1) := by
      apply MvPolynomial.algHom_ext
      intro j
      change q (E (MvPolynomial.X j)) = _
      rw [MvPolynomial.aeval_X, pspaceChartAlgEquiv_X, coordinateInterRatio_eq_res]
    have hp : ψ.range ≤ R := by
      rw [hψ, ← Algebra.adjoin_range_eq_range_aeval]
      exact Algebra.adjoin_le (Set.range_subset_iff.mpr fun j => hr i j.1)
    obtain ⟨p, rfl⟩ := E.surjective b
    exact hp ⟨p, rfl⟩
  let v : B := ∏ j ∈ I.attach, coordinateInterRatio K I j i.1
  have hv : v ∈ R := R.prod_mem fun j _ => hr j i.1
  have hi : q a * v = 1 := by
    change q (∏ j ∈ I.attach, (pspaceChartRatio K i.1 j.1 : A)) *
      (∏ j ∈ I.attach, coordinateInterRatio K I j i.1) = 1
    rw [map_prod, ← Finset.prod_mul_distrib]
    apply Finset.prod_eq_one
    intro j _
    exact (congrArg (· * coordinateInterRatio K I j i.1)
      (coordinateInterRatio_eq_res K I i j.1).symm).trans
      ((coordinateInterRatio_mul K I i j i.1).trans (coordinateInterRatio_self K I i))
  apply eq_top_iff.mpr
  intro b _
  obtain ⟨⟨z, w⟩, hz⟩ := IsLocalization.surj (Submonoid.powers a) b
  obtain ⟨n, hn⟩ := w.2
  change b * q w.1 = q z at hz
  have hz' : b * q a ^ n = q z := by simpa only [← hn, map_pow] using hz
  have he : b = q z * v ^ n := calc
    b = b * (q a * v) ^ n := by rw [hi, one_pow, mul_one]
    _ = _ := by rw [mul_pow, ← mul_assoc, hz']
  exact he.symm ▸ R.mul_mem (hA z) (R.pow_mem hv n)

end GlobalTheory.SchemeCohomology
