import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.EtaleNormalizedCharts
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.JoinedAffineCover

/-! Normalized chart rings of the joined cover for an étale correspondence. -/

noncomputable section

open AlgebraicGeometry CategoryTheory
open GlobalTheory.PD GlobalTheory.SchemeCohomology GaloisForLFunctions.HTGeometry

namespace GlobalTheory.WH

variable {k F E L : Type} [Field k] [Field F] [Field E] [Field L]
  [Algebra k F] [Algebra k E] [Algebra k L] [Algebra F E] [IsScalarTower k F E]
  {d : ℕ} (x : Fin (d + 1) → F) (j₂ : E →ₐ[k] L)

/-- The normalization of the right chart in the correspondence field. -/
abbrev R2 (I : Finset (Fin (d + 1))) : Subalgebra k L :=
  pullbackChartAlgebra j₂ (rB k E x I)

variable [Algebra F L] [IsScalarTower k F L]

/-- The ring generated by the left and right charts on the correspondence. -/
abbrev RY (I J : Finset (Fin (d + 1))) : Subalgebra k L :=
  rB k L x I ⊔ R2 x j₂ J

end GlobalTheory.WH

namespace GlobalTheory.SchemeCohomology

open GlobalTheory.WH

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
  {Y Z : Scheme.{0}} [IsIntegral Y] [IsIntegral Z] {c₁ c₂ : Y ⟶ Z}
  [IsFinite c₁] [IsFinite c₂] [IsDominant c₁] [IsDominant c₂]
  {s : Z ⟶ Spec (CommRingCat.of k)} {t : Y ⟶ Spec (CommRingCat.of k)}
  {d : ℕ} [SmoothOfRelativeDimension d t] [IsSeparated s]

/-- Both normalized chart families generate the regular sections on the
joined cover of an integral correspondence. -/
theorem isAffCover_joined_normalized (h₁ : c₁ ≫ s = t) (h₂ : c₂ ≫ s = t) :
    letI := sectionFunctionFieldAlgebra s
    letI := sectionFunctionFieldAlgebra t
    ∀ {F : Type} [Field F] [Algebra k F] [Algebra F Z.functionField] [Algebra F Y.functionField]
      [Algebra Z.functionField Y.functionField]
      [IsScalarTower k F Z.functionField] [IsScalarTower k F Y.functionField]
      [IsScalarTower k Z.functionField Y.functionField] [IsScalarTower F Z.functionField Y.functionField],
      algebraMap Z.functionField Y.functionField = c₁.functionFieldPullback.hom →
      ∀ (x : Fin (d + 1) → F) (U : Fin (d + 1) → Z.Opens),
        IsFinCover k Z.functionField x → IsAffCover s U (rB k Z.functionField x) →
        IsAffCover t (joinedCover (fun i => c₁ ⁻¹ᵁ U i) (fun i => c₂ ⁻¹ᵁ U i))
          (fun I => RY x (functionFieldPullbackAlg c₂ h₂) (lft I) (rgt I)) := by
  letI := sectionFunctionFieldAlgebra s
  letI := sectionFunctionFieldAlgebra t
  intro F _ _ _ _ _ _ _ _ _ hff x U hfin hcov
  letI : IsSeparated t := by
    rw [← h₁]
    infer_instance
  obtain ⟨-, hcov₁⟩ := isFinCover_pullback h₁ hff x U hfin hcov
  have hcov₂ := isAffCover_pullbackChartAlgebra d h₂ U (rB k Z.functionField x) hcov
  exact isAffCover_joinedCover t _ _ _ _ hcov₁ hcov₂
    (rB_empty x) (pullbackChartAlgebra_rB_empty x (functionFieldPullbackAlg c₂ h₂))

end GlobalTheory.SchemeCohomology
