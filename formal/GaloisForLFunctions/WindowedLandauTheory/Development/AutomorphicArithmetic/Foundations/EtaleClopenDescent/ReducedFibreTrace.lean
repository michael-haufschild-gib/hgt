import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.NormalizedFibreParameters
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ReducedEtaleFibre
import GaloisForLFunctions.HTGeometry.SplitFiniteAlgebraDiscriminant
import Mathlib.RingTheory.Etale.Field

/-! Trace on a reduced origin fibre is the sum of evaluations at its
rational points. -/

noncomputable section

open GaloisForLFunctions.HTGeometry GlobalTheory.SchemeCohomology

namespace GlobalTheory.SchemeCohomology

variable {k A : Type} [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
  [Module.Finite k A] [IsReduced A]

/-- A finite reduced algebra over an algebraically closed field is the
product of its rational evaluations. -/
theorem bijective_finiteReduced_evaluation :
    Finite (A →ₐ[k] k) ∧ Function.Bijective (fun (a : A) (e : A →ₐ[k] k) => e a) := by
  classical
  letI : IsArtinianRing A := IsArtinianRing.of_finite k A
  letI : Algebra.FormallyUnramified k A := formallyUnramified_of_finite_reduced k A
  letI : Algebra.FormallyEtale k A := .of_formallyUnramified_of_field k A
  let I := PrimeSpectrum A
  letI : Fintype I := Fintype.ofFinite I
  let Φ : A ≃ₐ[k] (I → k) := Algebra.FormallyEtale.equivPiOfIsSepClosed k A
  let ν (i : I) : A →ₐ[k] k := (Pi.evalAlgHom k (fun _ : I => k) i).comp Φ.toAlgHom
  have hn : Function.Surjective ν := by
    intro e
    obtain ⟨i, hi⟩ := exists_eval_of_algHom_pi (e.comp Φ.symm.toAlgHom)
    refine ⟨i, AlgHom.ext fun a => ?_⟩
    change Φ a i = e a
    simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
      AlgEquiv.symm_apply_apply] using (hi (Φ a)).symm
  refine ⟨Finite.of_surjective ν hn, ?_, ?_⟩
  · intro a b h
    exact Φ.injective (funext fun i => congrFun h (ν i))
  · intro v
    refine ⟨Φ.symm (v ∘ ν), funext fun e => ?_⟩
    obtain ⟨i, rfl⟩ := hn e
    change Φ (Φ.symm (v ∘ ν)) i = v (ν i)
    rw [AlgEquiv.apply_symm_apply]
    rfl

/-- Trace sums the values at the rational points of a finite reduced algebra. -/
theorem trace_eq_finsum_evaluations (a : A) :
    Algebra.trace k A a = ∑ᶠ e : A →ₐ[k] k, e a := by
  classical
  obtain ⟨hfin, hbij⟩ := bijective_finiteReduced_evaluation (k := k) (A := A)
  letI := hfin
  letI := Fintype.ofFinite (A →ₐ[k] k)
  let e : A ≃ₐ[k] ((A →ₐ[k] k) → k) := AlgEquiv.ofBijective (AlgHom.pi id) hbij
  rw [← Algebra.trace_eq_of_algEquiv e, trace_pi_apply, finsum_eq_sum_of_fintype]
  rfl

end GlobalTheory.SchemeCohomology

namespace GlobalTheory.PD

variable {k F E : Type} [Field k] [IsAlgClosed k] [Field F] [Field E] [Algebra k F]
  [Algebra k E] [Algebra F E] [IsScalarTower k F E]
  {d : ℕ} {x : Fin (d + 1) → F}

/-- The fibre points are precisely evaluations that kill the origin equations. -/
def OriginFibrePoint (k E : Type) [Field k] [Field E] [Algebra k F] [Algebra k E]
    [Algebra F E] [IsScalarTower k F E] (x : Fin (d + 1) → F) :=
  {e : rB k E x {0} →ₐ[k] k // ∀ j, e ⟨_, tco_mem k E x j⟩ = 0}

variable (k E x) in
/-- The ideal generated by the origin coordinates in the normalized chart. -/
abbrev originIdeal : Ideal (rB k E x {0}) :=
  Ideal.span (Set.range fun j : Fin d => (⟨_, tco_mem k E x j⟩ : rB k E x {0}))

/-- Passing to the quotient identifies the evaluations killing the equations. -/
def originFibrePointEquiv :
    OriginFibrePoint k E x ≃ ((rB k E x {0} ⧸ originIdeal k E x) →ₐ[k] k) where
  toFun e := Ideal.Quotient.liftₐ (originIdeal k E x) e.1
    (show originIdeal k E x ≤ RingHom.ker e.1.toRingHom from Ideal.span_le.mpr (by
      rintro a ⟨j, hj⟩
      change e.1 a = 0
      exact hj ▸ e.2 j))
  invFun f := ⟨f.comp (Ideal.Quotient.mkₐ _ _), fun j => by
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self j)), map_zero]⟩
  left_inv e := Subtype.ext (AlgHom.ext fun _ => rfl)
  right_inv f := Ideal.Quotient.algHom_ext k (AlgHom.ext fun _ => rfl)

/-- A normalized reduced origin fibre has finitely many points. All
functions on them lift to sections, and its algebra trace sums their values. -/
theorem trace_originFibre (h : IsFinCover k E x)
    [IsReduced ((rB k E x {0}) ⧸ originIdeal k E x)] :
    Finite (OriginFibrePoint k E x) ∧
    Function.Surjective (fun (a : rB k E x {0}) (e : OriginFibrePoint k E x) => e.1 a) ∧
    ∀ a : rB k E x {0}, Algebra.trace k ((rB k E x {0}) ⧸ originIdeal k E x) (Ideal.Quotient.mk _ a) =
      ∑ᶠ e : OriginFibrePoint k E x, e.1 a := by
  letI := finite_originFibre h
  let E₀ := originFibrePointEquiv (k := k) (E := E) (x := x)
  obtain ⟨hf, hh⟩ := bijective_finiteReduced_evaluation (k := k)
    (A := (rB k E x {0}) ⧸ originIdeal k E x)
  letI := hf
  refine ⟨Finite.of_injective E₀ E₀.injective, ?_, fun a => ?_⟩
  · intro v
    obtain ⟨q, hq⟩ := hh.surjective (v ∘ E₀.symm)
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
    refine ⟨a, funext fun e => ?_⟩
    exact (congrFun hq (E₀ e)).trans (congrArg v (E₀.symm_apply_apply e))
  · rw [trace_eq_finsum_evaluations, ← finsum_comp_equiv E₀]
    rfl

end GlobalTheory.PD
