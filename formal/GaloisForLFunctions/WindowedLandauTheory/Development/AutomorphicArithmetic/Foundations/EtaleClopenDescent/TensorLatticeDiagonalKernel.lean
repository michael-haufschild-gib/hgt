import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.TensorLatticeProjectivity
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ProjectiveDiagonalRing

/-! The kernel of contraction on a regular tensor is contained in
the diagonal ideal times the tensor lattice. -/

noncomputable section

open scoped TensorProduct Pointwise

namespace GlobalTheory.PD

/-- The submodule generated by multiplying module elements by an ideal. -/
def idealMultiple {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (I : Ideal R) : Submodule R M :=
  I • ⊤

variable {k F : Type} {V W : Type*} [Field k] [Field F] [Algebra k F]
  [AddCommGroup V] [Module k V] [Module F V] [IsScalarTower k F V]
  [AddCommGroup W] [Module k W] [Module F W] [IsScalarTower k F W]
  {A B : Subalgebra k F} {P : Submodule k V} {Q : Submodule k W}
  (hP : ∀ a ∈ A, ∀ v ∈ P, a • v ∈ P)
  (hQ : ∀ b ∈ B, ∀ w ∈ Q, b • w ∈ Q)
  {ι κ : Type*} [Fintype ι] [Fintype κ]
  (v : ι → V) (w : κ → W) (φ : ι → V →ₗ[F] F) (ψ : κ → W →ₗ[F] F)
  (hv : ∀ i, v i ∈ P) (hw : ∀ j, w j ∈ Q)
  (hφ : ∀ i a, a ∈ P → φ i a ∈ A) (hψ : ∀ j b, b ∈ Q → ψ j b ∈ B)
  (hV : ∀ a, a = ∑ i, φ i a • v i) (hW : ∀ b, b = ∑ j, ψ j b • w j)

local notation "R" => tensorChartRing A B
local notation "Γ" => tensorChartSubmodule hP hQ

include v w φ ψ hv hw hφ hψ hV hW in
/-- If contraction against every first-factor functional vanishes,
each integral coordinate vanishes after multiplication of the two scalars. -/
theorem mem_diagonal_ideal_smul_of_tensorContraction_eq_zero :
    letI := tensorChartModule (V := V) (W := W) A B
    let I : Ideal R := RingHom.ker (tensorChartRingDiagonal A B).toRingHom
    ∀ t : Γ, (∀ f : V →ₗ[F] F, tensorContraction f (t : V ⊗[k] W) = 0) →
      t ∈ idealMultiple (M := Γ) I := by
  letI := tensorChartModule (V := V) (W := W) A B
  intro I t ht
  refine mem_ideal_smul_tensorChartSubmodule hP hQ v w φ ψ hv hw hφ hψ hV hW I t ?_
  intro i j
  change Algebra.TensorProduct.lmul' k (tensorCoordinates (φ i) (ψ j) (t : V ⊗[k] W)) = 0
  rw [tensorCoordinates_lmul, ht, map_zero]

end GlobalTheory.PD
