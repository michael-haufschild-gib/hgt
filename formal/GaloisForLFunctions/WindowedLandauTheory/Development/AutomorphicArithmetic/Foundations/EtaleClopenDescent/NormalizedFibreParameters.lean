import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ProjectiveFiniteCover
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ReducedArtinianFibre
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ReducedFibreParameters
import Mathlib.RingTheory.FiniteType

/-! Parameters at rational points of the reduced origin fibre in a
normalized projective cover. -/

noncomputable section

namespace GlobalTheory.PD

open GlobalTheory.SchemeCohomology

variable {k F E : Type} [Field k] [Field F] [Field E] [Algebra k F]
  [Algebra k E] [Algebra F E] [IsScalarTower k F E]
  {d : ℕ} {x : Fin (d + 1) → F}

private theorem aeval_origin_range (hx : IsPd k x) :
    (MvPolynomial.aeval (fun j : Fin d => x j.succ / x 0)).range = rA k x {0} := by
  rw [← Algebra.adjoin_range_eq_range_aeval, rA]
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨j, rfl⟩
    exact Algebra.subset_adjoin ⟨0, Finset.mem_singleton_self 0, j.succ, rfl⟩
  · rintro _ ⟨i, hi, j, rfl⟩
    have h : i = 0 := Finset.mem_singleton.mp hi
    subst i
    induction j using Fin.cases with
    | zero => rw [div_self (hx.ne 0)]; exact one_mem _
    | succ j => exact Algebra.subset_adjoin ⟨j, rfl⟩

/-- The origin fibre of the normalized cover is a finite algebra over the base field. -/
theorem finite_originFibre (h : IsFinCover k E x) :
    Module.Finite k ((rB k E x {0}) ⧸ Ideal.span (Set.range fun j : Fin d =>
      (⟨_, tco_mem k E x j⟩ : rB k E x {0}))) := by
  let A := rA k x {0}
  let B := rB k E x {0}
  let ψ : MvPolynomial (Fin d) k →ₐ[k] F := MvPolynomial.aeval (fun j : Fin d => x j.succ / x 0)
  let e : ψ.range ≃ₐ[k] A := Subalgebra.equivOfEq _ _ (aeval_origin_range h.pd)
  let q : MvPolynomial (Fin d) k →ₐ[k] A := e.toAlgHom.comp ψ.rangeRestrict
  have hq : q.Finite := AlgHom.Finite.of_surjective _ (e.surjective.comp ψ.rangeRestrict_surjective)
  let g : A →ₐ[k] B := ((IsScalarTower.toAlgHom k F E).comp A.val).codRestrict B
    (fun a => isIntegral_algebraMap (x := a))
  letI : Algebra A B := g.toRingHom.toAlgebra
  letI : IsScalarTower k A B := IsScalarTower.of_algebraMap_eq fun c => (g.commutes c).symm
  let I : B →ₐ[A] E := { toRingHom := B.val.toRingHom, commutes' := fun _ => rfl }
  letI : Algebra.Smooth k B := h.smooth 0
  letI : Algebra.FiniteType A B := Algebra.FiniteType.of_restrictScalars_finiteType k A B
  letI : Algebra.IsIntegral A B := ⟨fun b => (isIntegral_algHom_iff I Subtype.val_injective).mp b.2⟩
  letI : Module.Finite A B := Algebra.IsIntegral.finite
  have hg : g.Finite := RingHom.finite_algebraMap.mpr inferInstance
  have hX (j : Fin d) : (g.comp q) (MvPolynomial.X j) = (⟨_, tco_mem k E x j⟩ : B) := by
    apply Subtype.ext
    change algebraMap F E (ψ (MvPolynomial.X j)) = _
    rw [show ψ (MvPolynomial.X j) = x j.succ / x 0 from MvPolynomial.aeval_X _ _]
  have he : (fun j => (g.comp q) (MvPolynomial.X j)) =
      (fun j : Fin d => (⟨_, tco_mem k E x j⟩ : B)) := funext hX
  exact he ▸ finite_quotient_of_polynomial_coordinates (g.comp q) (hg.comp hq)

/-- At a rational point over the origin, functions vanishing there are
locally generated by the origin coordinates. -/
theorem exists_regular_parameters_of_reduced_quotient (h : IsFinCover k E x)
    [IsReduced ((rB k E x {0}) ⧸ Ideal.span (Set.range fun j : Fin d =>
      (⟨_, tco_mem k E x j⟩ : rB k E x {0})))]
    (ev : rB k E x {0} →ₐ[k] k) (b : rB k E x {0}) (hb : ev b = 0) :
    ∃ (c : rB k E x {0}) (a : Fin d → rB k E x {0}),
      ev c = 1 ∧ c * b = ∑ j, a j * ⟨_, tco_mem k E x j⟩ := by
  letI := finite_originFibre h
  let B := rB k E x {0}
  let r (j : Fin d) : B := ⟨_, tco_mem k E x j⟩
  letI : IsArtinianRing (B ⧸ Ideal.span (Set.range r)) := IsArtinianRing.of_finite k _
  exact exists_clearingDenominator_of_artinian_reduced_quotient r ev.toRingHom b hb

end GlobalTheory.PD
