import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.PolynomialDiagonal
import Mathlib.RingTheory.TensorProduct.MvPolynomial

/-! In the tensor product of two polynomial chart rings, the
diagonal ideal is generated by the differences of the coordinates. -/

noncomputable section

open MvPolynomial RingTheory.Sequence
open scoped TensorProduct

namespace GlobalTheory.PD

variable (k ι : Type) [Field k]

local notation "P" => MvPolynomial ι k
local notation "T" => P ⊗[k] P

/-- Combine the variables of the two tensor factors into a single polynomial ring. -/
def polynomialTensorEquiv : T ≃ₐ[k] MvPolynomial (ι ⊕ ι) k :=
  (Algebra.TensorProduct.comm k P P).trans
    (((algebraTensorAlgEquiv k P).restrictScalars k).trans (sumAlgEquiv k ι ι).symm)

@[simp] theorem polynomialTensorEquiv_symm_X_inl (i : ι) :
    (polynomialTensorEquiv k ι).symm (X (Sum.inl i)) = X i ⊗ₜ[k] (1 : P) := by
  change (Algebra.TensorProduct.comm k P P).symm
    ((algebraTensorAlgEquiv k P).symm (sumAlgEquiv k ι ι (X (Sum.inl i)))) = _
  rw [sumAlgEquiv_X_inl, algebraTensorAlgEquiv_symm_X, Algebra.TensorProduct.comm_symm,
    Algebra.TensorProduct.comm_tmul]

@[simp] theorem polynomialTensorEquiv_symm_X_inr (i : ι) :
    (polynomialTensorEquiv k ι).symm (X (Sum.inr i)) = (1 : P) ⊗ₜ[k] X i := by
  have e : (algebraTensorAlgEquiv k P).symm (C (X i) : MvPolynomial ι P) =
      X i ⊗ₜ[k] (1 : P) := by
    apply (algebraTensorAlgEquiv k P).injective
    rw [AlgEquiv.apply_symm_apply, algebraTensorAlgEquiv_tmul, map_one, smul_eq_C_mul, mul_one]
  change (Algebra.TensorProduct.comm k P P).symm
    ((algebraTensorAlgEquiv k P).symm (sumAlgEquiv k ι ι (X (Sum.inr i)))) = _
  rw [sumAlgEquiv_X_inr, e, Algebra.TensorProduct.comm_symm, Algebra.TensorProduct.comm_tmul]

/-- Pullback of one coordinate along the two projections, subtracted. -/
def tensorDiagonalDifference (i : ι) : T :=
  X i ⊗ₜ[k] (1 : P) - (1 : P) ⊗ₜ[k] X i

private theorem symm_polynomialDiagonalDifference (i : ι) :
    (polynomialTensorEquiv k ι).symm (polynomialDiagonalDifference i) = tensorDiagonalDifference k ι i := by
  simp only [polynomialDiagonalDifference, tensorDiagonalDifference, map_sub,
    polynomialTensorEquiv_symm_X_inl, polynomialTensorEquiv_symm_X_inr]

/-- Multiplication on the two polynomial factors is restriction to the diagonal. -/
theorem ker_polynomialTensor_lmul :
    RingHom.ker (Algebra.TensorProduct.lmul' k (S := P)).toRingHom =
      Ideal.span (Set.range (tensorDiagonalDifference k ι)) := by
  let e := (polynomialTensorEquiv k ι).symm
  let m : T →ₐ[k] P := Algebra.TensorProduct.lmul' k
  have h : m.comp e.toAlgHom = rename (Sum.elim (id : ι → ι) id) := by
    apply MvPolynomial.algHom_ext
    rintro (i | i) <;> simp [m, e]
  calc
    RingHom.ker m.toRingHom =
        (RingHom.ker (m.comp e.toAlgHom).toRingHom).map e.toRingHom := by
      rw [show (m.comp e.toAlgHom).toRingHom = m.toRingHom.comp e.toRingHom from rfl,
        ← RingHom.comap_ker]
      exact (Ideal.map_comap_of_surjective e.toRingHom e.surjective _).symm
    _ = _ := by
      rw [h, ker_rename_foldVariables, Ideal.map_span, ← Set.range_comp']
      have he : (fun i : ι => e (polynomialDiagonalDifference (k := k) i)) =
          tensorDiagonalDifference k ι :=
        funext (symm_polynomialDiagonalDifference k ι)
      change Ideal.span (Set.range (fun i : ι => e (polynomialDiagonalDifference (k := k) i))) = _
      rw [he]

/-- The diagonal equations are weakly regular in the polynomial tensor product. -/
theorem weaklyRegular_tensorDiagonalDifference (l : List ι) (hl : l.Nodup) :
    IsWeaklyRegular T (l.map (tensorDiagonalDifference k ι)) := by
  let e := (polynomialTensorEquiv k ι).symm
  refine (e.toAddEquiv.isWeaklyRegular_congr ?_).mp (weaklyRegular_polynomialDiagonalDifference l hl)
  exact List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun i _ y => by
    change e (polynomialDiagonalDifference i * y) = tensorDiagonalDifference k ι i * e y
    rw [map_mul, symm_polynomialDiagonalDifference]))

end GlobalTheory.PD
