import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.AffineSmoothDimension
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.FiniteFunctionField
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ReducedProjectionFibre
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.SectionFunctionField

/-! A finite projection generates a finite subextension of the source
function field. The coordinate germs are algebraically independent when
the source is smooth of the same dimension as the target. -/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open GaloisForLFunctions.HTGeometry UpperTheory.Cb
open scoped nonZeroDivisors

namespace GlobalTheory.SchemeCohomology

variable {K : Type} [Field K] {X : Scheme.{0}} [IsIntegral X]
  {s : X ⟶ Spec (CommRingCat.of K)} {d : ℕ} {f : X ⟶ PSpace K d}

private abbrev ZeroChart := f ⁻¹ᵁ PSpace.coordinateOpen K d 0

/-- The germ of a pulled-back standard projective coordinate at the generic point. -/
def projectionCoordinate (hf : f ≫ PSpace.str K d = s)
    (h₀ : genericPoint X ∈ ZeroChart (f := f)) (j : {j : Fin (d + 1) // j ≠ 0}) :
    X.functionField := by
  letI : Nonempty (ZeroChart (f := f)) := ⟨⟨genericPoint X, h₀⟩⟩
  exact sectionToFunctionField s _ (chartPolynomialPullback hf 0 (MvPolynomial.X j))

/-- The subfield generated by the origin-chart coordinates of the projection. -/
def projectionField (hf : f ≫ PSpace.str K d = s)
    (h₀ : genericPoint X ∈ ZeroChart (f := f)) :
    letI := sectionFunctionFieldAlgebra s
    IntermediateField K X.functionField :=
  letI := sectionFunctionFieldAlgebra s
  IntermediateField.adjoin K (Set.range (projectionCoordinate hf h₀))

variable [IsFinite f]

/-- The source function field is finite over the field generated by the
pulled-back projective coordinates. -/
theorem finiteDimensional_projectionField (hf : f ≫ PSpace.str K d = s)
    (h₀ : genericPoint X ∈ ZeroChart (f := f)) :
    letI := sectionFunctionFieldAlgebra s
    FiniteDimensional (projectionField hf h₀) X.functionField := by
  letI := sectionFunctionFieldAlgebra s
  let U := ZeroChart (f := f)
  let B := SectionRing s U
  let F := projectionField hf h₀
  letI : Nonempty U := ⟨⟨genericPoint X, h₀⟩⟩
  letI : IsDomain B := IsIntegral.component_integral U
  letI : Algebra B X.functionField := (X.germToFunctionField U).hom.toAlgebra
  letI : IsFractionRing B X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U ((pspaceChart_isAffine 0).preimage f)
  let g := sectionToFunctionField s U
  let φ := chartPolynomialPullback hf 0
  have hτ : g.comp φ = MvPolynomial.aeval (projectionCoordinate hf h₀) := by
    apply MvPolynomial.algHom_ext
    intro j
    change projectionCoordinate hf h₀ j = _
    exact (MvPolynomial.aeval_X (projectionCoordinate hf h₀) j).symm
  apply finiteDimensional_of_finite_fraction_image φ.toRingHom (chartPolynomialPullback_finite hf 0)
    g.toRingHom
  · intro p
    have hle : Algebra.adjoin K (Set.range (projectionCoordinate hf h₀)) ≤ F.toSubalgebra :=
      Algebra.adjoin_le (IntermediateField.subset_adjoin K _)
    have hp : (g.comp φ) p ∈ F := hle (by
      rw [hτ, Algebra.adjoin_range_eq_range_aeval]
      exact ⟨p, rfl⟩)
    exact ⟨⟨_, hp⟩, rfl⟩
  · intro z
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective B z
    have hb' : g b ≠ 0 := by
      intro hzero
      exact (mem_nonZeroDivisors_iff_ne_zero.mp hb)
        (IsFractionRing.injective B X.functionField (hzero.trans (map_zero g).symm))
    exact ⟨a, b, hb', div_mul_cancel₀ _ hb'⟩

/-- A finite projection of a smooth d-dimensional scheme to projective
d-space pulls back algebraically independent affine coordinates. -/
theorem algebraicIndependent_projectionCoordinate [IsAlgClosed K] [SmoothOfRelativeDimension d s]
    (hf : f ≫ PSpace.str K d = s) (h₀ : genericPoint X ∈ ZeroChart (f := f)) :
    letI := sectionFunctionFieldAlgebra s
    AlgebraicIndependent K (projectionCoordinate hf h₀) := by
  letI := sectionFunctionFieldAlgebra s
  let U := ZeroChart (f := f)
  letI : Nonempty U := ⟨⟨genericPoint X, h₀⟩⟩
  let φ := chartPolynomialPullback hf 0
  let g := sectionToFunctionField s U
  have hφ₀ := chartPolynomialPullback_finite hf 0
  have hdim : ringKrullDim (SectionRing s U) =
      Fintype.card {j : Fin (d + 1) // j ≠ 0} := by
    change ringKrullDim Γ(X, U) = _
    rw [ringKrullDim_smooth_affineOpen s d ((pspaceChart_isAffine 0).preimage f) ⟨_, h₀⟩]
    simp
  have hφ := finite_polynomial_injective_of_krullDim φ.toRingHom hφ₀ hdim
  have hg : Function.Injective g := X.germToFunctionField_injective U
  have hτ : MvPolynomial.aeval (projectionCoordinate hf h₀) = g.comp φ :=
    MvPolynomial.algHom_ext fun j => MvPolynomial.aeval_X _ j
  change Function.Injective (MvPolynomial.aeval (projectionCoordinate hf h₀))
  rw [hτ]
  exact hg.comp hφ

end GlobalTheory.SchemeCohomology
