import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.AffineIntersectionSections
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.NormalizedChartConstants
import Mathlib.Data.Finset.Sum
import Mathlib.Data.Sum.Order

/-! Affine coordinate algebras for the joined cover of a correspondence. -/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace GlobalTheory.WH

variable {ι κ : Type}

/-- The left indices of a chart intersection in a joined cover. -/
def lft (s : Finset (ι ⊕ₗ κ)) : Finset ι :=
  (s.map (ofLex : ι ⊕ₗ κ ≃ ι ⊕ κ).toEmbedding).toLeft

/-- The right indices of a chart intersection in a joined cover. -/
def rgt (s : Finset (ι ⊕ₗ κ)) : Finset κ :=
  (s.map (ofLex : ι ⊕ₗ κ ≃ ι ⊕ κ).toEmbedding).toRight

/-- Combine the chart indices of the two covers. -/
def uni (I : Finset ι) (J : Finset κ) : Finset (ι ⊕ₗ κ) :=
  (I.disjSum J).map (toLex : ι ⊕ κ ≃ ι ⊕ₗ κ).toEmbedding

@[simp] theorem lft_uni (I : Finset ι) (J : Finset κ) : lft (uni I J) = I := by
  ext i
  simp [lft, uni]

@[simp] theorem rgt_uni (I : Finset ι) (J : Finset κ) : rgt (uni I J) = J := by
  ext j
  simp [rgt, uni]

theorem uni_lft_rgt (s : Finset (ι ⊕ₗ κ)) : uni (lft s) (rgt s) = s := by
  unfold uni lft rgt
  rw [Finset.toLeft_disjSum_toRight, Finset.map_map]
  ext j
  simp

end GlobalTheory.WH

namespace GlobalTheory.SchemeCohomology

open GlobalTheory.PD GlobalTheory.WH

variable {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
  (s : X ⟶ Spec (CommRingCat.of k)) {ι κ : Type}

/-- The cover consisting of the opens from both original covers. -/
def joinedCover (U : ι → X.Opens) (V : κ → X.Opens) : ι ⊕ₗ κ → X.Opens :=
  Sum.elim U V ∘ ofLex

omit [IsIntegral X] in
theorem inf_joinedCover (U : ι → X.Opens) (V : κ → X.Opens) (I : Finset (ι ⊕ₗ κ)) :
    I.inf (joinedCover U V) = (lft I).inf U ⊓ (rgt I).inf V := by
  classical
  have hs : (lft I).disjSum (rgt I) =
      (lft I).map Function.Embedding.inl ∪ (rgt I).map Function.Embedding.inr := by
    ext (i | j) <;> simp
  conv_lhs => rw [← uni_lft_rgt I]
  rw [uni, Finset.inf_map, hs, Finset.inf_union, Finset.inf_map, Finset.inf_map]
  rfl

private theorem nonempty_rgt_of_lft_empty {I : Finset (ι ⊕ₗ κ)} (hI : I.Nonempty) (hl : lft I = ∅) :
    (rgt I).Nonempty := by
  rw [Finset.nonempty_iff_ne_empty]
  intro hr
  have h := uni_lft_rgt I
  rw [hl, hr] at h
  exact hI.ne_empty (by simpa [uni] using h.symm)

private theorem nonempty_lft_of_rgt_empty {I : Finset (ι ⊕ₗ κ)} (hI : I.Nonempty) (hr : rgt I = ∅) :
    (lft I).Nonempty := by
  rw [Finset.nonempty_iff_ne_empty]
  intro hl
  exact (nonempty_rgt_of_lft_empty hI hl).ne_empty hr

/-- On the joined cover, the algebra of a nonempty chart intersection is
generated by the chart algebras from the two covers. -/
theorem isAffCover_joinedCover [IsSeparated s] (U : ι → X.Opens) (V : κ → X.Opens) :
    letI := sectionFunctionFieldAlgebra s
    ∀ (A : Finset ι → Subalgebra k X.functionField) (B : Finset κ → Subalgebra k X.functionField),
      IsAffCover s U A → IsAffCover s V B → A ∅ = ⊥ → B ∅ = ⊥ →
      IsAffCover s (joinedCover U V) (fun I => A (lft I) ⊔ B (rgt I)) := by
  letI := sectionFunctionFieldAlgebra s
  intro A B hU hV hA hB
  have hIη (I : Finset (ι ⊕ₗ κ)) : genericPoint X ∈ I.inf (joinedCover U V) :=
    (inf_joinedCover U V I).ge ⟨hU.ne (lft I), hV.ne (rgt I)⟩
  have hUA (I : Finset ι) (hI : I.Nonempty) : genericSectionAlgebra s (I.inf U) (hU.ne I) = A I :=
    SetLike.ext fun a => (hU.ring I hI a).symm
  have hVB (I : Finset κ) (hI : I.Nonempty) : genericSectionAlgebra s (I.inf V) (hV.ne I) = B I :=
    SetLike.ext fun b => (hV.ring I hI b).symm
  refine ⟨rfl, ?_, ?_, hIη, ?_⟩
  · intro I hI
    rw [inf_joinedCover]
    by_cases hl : lft I = ∅
    · rw [hl, Finset.inf_empty, top_inf_eq]
      exact hV.affine _ (nonempty_rgt_of_lft_empty hI hl)
    by_cases hr : rgt I = ∅
    · rw [hr, Finset.inf_empty, inf_top_eq]
      exact hU.affine _ (nonempty_lft_of_rgt_empty hI hr)
    exact isAffineHom_diagonal_iff.mp (inferInstance : IsAffineHom (pullback.diagonal s))
      ⊤ (isAffineOpen_top _) _ le_top _ le_top
      (hU.affine _ (Finset.nonempty_iff_ne_empty.mpr hl)) (hV.affine _ (Finset.nonempty_iff_ne_empty.mpr hr))
  · apply top_le_iff.mp
    intro a ha
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hU.cover.ge ha)
    exact Opens.mem_iSup.mpr ⟨toLex (Sum.inl i), hi⟩
  · intro I hI y
    change y ∈ A (lft I) ⊔ B (rgt I) ↔
      y ∈ genericSectionAlgebra s (I.inf (joinedCover U V)) (hIη I)
    let J := lft I
    let J' := rgt I
    let W := (J.inf U) ⊓ (J'.inf V)
    have he : I.inf (joinedCover U V) = W := inf_joinedCover U V I
    have heq (W' : X.Opens) (e : W' = W) (hη : genericPoint X ∈ W') :
        genericSectionAlgebra s W' hη = genericSectionAlgebra s W ⟨hU.ne J, hV.ne J'⟩ := by
      subst W'
      rfl
    rw [heq _ he (hIη I)]
    by_cases hl : J = ∅
    · have hW : W = J'.inf V := by simp [W, hl]
      rw [(heq _ hW.symm (hV.ne J')).symm, hVB _ (nonempty_rgt_of_lft_empty hI hl)]
      change y ∈ A J ⊔ B J' ↔ _
      rw [hl, hA, bot_sup_eq]
    by_cases hr : J' = ∅
    · have hW : W = J.inf U := by simp [W, hr]
      rw [(heq _ hW.symm (hU.ne J)).symm, hUA _ (nonempty_lft_of_rgt_empty hI hr)]
      change y ∈ A J ⊔ B J' ↔ _
      rw [hr, hB, sup_bot_eq]
    have hJ := Finset.nonempty_iff_ne_empty.mpr hl
    have hJ' := Finset.nonempty_iff_ne_empty.mpr hr
    rw [genericSectionAlgebra_inf s (hU.affine J hJ) (hV.affine J' hJ') (hU.ne J) (hV.ne J'),
      hUA J hJ, hVB J' hJ']

end GlobalTheory.SchemeCohomology
