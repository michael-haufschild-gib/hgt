import GaloisForLFunctions.HTGeometry.QuotientRegularSequence
import Mathlib.Algebra.MvPolynomial.Equiv

/-! Differences of the two sets of coordinates cut out the diagonal
of affine space and form a regular sequence. -/

noncomputable section

open MvPolynomial RingTheory.Sequence
open GaloisForLFunctions.HTGeometry

namespace GlobalTheory.PD

variable {k ι : Type*} [Field k]

/-- The equations of the diagonal in two sets of polynomial coordinates. -/
def polynomialDiagonalDifference (i : ι) : MvPolynomial (ι ⊕ ι) k :=
  X (Sum.inl i) - X (Sum.inr i)

private def foldVariables : ι ⊕ ι → ι := Sum.elim id id

/-- Identifying the two sets of variables has kernel generated by
their pairwise differences. -/
theorem ker_rename_foldVariables :
    RingHom.ker (rename (R := k) (Sum.elim (id : ι → ι) id)).toRingHom =
      Ideal.span (Set.range (polynomialDiagonalDifference (k := k) (ι := ι))) := by
  let P := MvPolynomial (ι ⊕ ι) k
  let e : P →ₐ[k] MvPolynomial ι k := rename foldVariables
  let s : MvPolynomial ι k →ₐ[k] P := rename Sum.inr
  let I := Ideal.span (Set.range (polynomialDiagonalDifference (k := k) (ι := ι)))
  have heX (i : ι ⊕ ι) : e (X i) = X (foldVariables i) := rename_X _ _
  have hsX (i : ι) : s (X i) = X (Sum.inr i) := rename_X _ _
  have heC (v : k) : e (C v) = C v := rename_C _ _
  have hsC (v : k) : s (C v) = C v := rename_C _ _
  have hX (i : ι ⊕ ι) : X i - s (e (X i)) ∈ I := by
    cases i with
    | inl i =>
      rw [heX, hsX]
      exact Ideal.subset_span ⟨i, rfl⟩
    | inr i =>
      rw [heX, hsX]
      change (X (Sum.inr i) : P) - X (Sum.inr i) ∈ I
      rw [sub_self]
      exact zero_mem _
  have hP (p : P) : p - s (e p) ∈ I := by
    induction p using MvPolynomial.induction_on with
    | C t =>
      rw [heC, hsC, sub_self]
      exact zero_mem _
    | add a b ha hb =>
      rw [map_add, map_add, add_sub_add_comm]
      exact add_mem ha hb
    | mul_X p i hp =>
      rw [map_mul, map_mul]
      have h : p * X i - s (e p) * s (e (X i)) =
          (p - s (e p)) * X i + s (e p) * (X i - s (e (X i))) := by ring
      rw [h]
      exact add_mem (I.mul_mem_right _ hp) (I.mul_mem_left _ (hX i))
  refine le_antisymm ?_ (Ideal.span_le.mpr ?_)
  · intro p hp
    have hz : e p = 0 := hp
    simpa only [hz, map_zero, sub_zero] using hP p
  · rintro _ ⟨i, rfl⟩
    change e (polynomialDiagonalDifference i) = 0
    rw [polynomialDiagonalDifference, map_sub, heX, heX]
    exact sub_self (X i)

private def addRightVariables (ι : Type*) (k : Type*) [Field k] :
    MvPolynomial (ι ⊕ ι) k →ₐ[k] MvPolynomial (ι ⊕ ι) k :=
  aeval (Sum.elim (fun i => X (Sum.inl i) + X (Sum.inr i)) (fun i => X (Sum.inr i)))

private def subRightVariables (ι : Type*) (k : Type*) [Field k] :
    MvPolynomial (ι ⊕ ι) k →ₐ[k] MvPolynomial (ι ⊕ ι) k :=
  aeval (Sum.elim (polynomialDiagonalDifference (k := k)) (fun i => X (Sum.inr i)))

private theorem add_subRightVariables :
    (addRightVariables ι k).comp (subRightVariables ι k) = AlgHom.id k _ := by
  apply MvPolynomial.algHom_ext
  rintro (i | i) <;> simp [addRightVariables, subRightVariables, polynomialDiagonalDifference]

private theorem sub_addRightVariables :
    (subRightVariables ι k).comp (addRightVariables ι k) = AlgHom.id k _ := by
  apply MvPolynomial.algHom_ext
  rintro (i | i) <;> simp [addRightVariables, subRightVariables, polynomialDiagonalDifference]

/-- A triangular change of coordinates turns the diagonal equations
into distinct variables. -/
theorem weaklyRegular_polynomialDiagonalDifference (l : List ι) (hl : l.Nodup) :
    IsWeaklyRegular (MvPolynomial (ι ⊕ ι) k) (l.map (polynomialDiagonalDifference (k := k))) := by
  classical
  let P := MvPolynomial (ι ⊕ ι) k
  let e : P ≃ₐ[k] P :=
    AlgEquiv.ofAlgHom (subRightVariables ι k) (addRightVariables ι k)
      sub_addRightVariables add_subRightVariables
  have hreg : IsWeaklyRegular P ((l.map Sum.inl).map (X : ι ⊕ ι → P)) := by
    let I : Ideal P := Ideal.span ((X : ι ⊕ ι → P) '' (∅ : Set (ι ⊕ ι)))
    have h : IsWeaklyRegular (P ⧸ I)
        ((l.map Sum.inl).map (X : ι ⊕ ι → P)) :=
      (isRegular_map_X (K := k) (∅ : Set (ι ⊕ ι)) (l.map Sum.inl)
        (hl.map Sum.inl_injective) (by simp)).1
    have hI : I = ⊥ := by
      change Ideal.span ((X : ι ⊕ ι → P) '' (∅ : Set (ι ⊕ ι))) = (⊥ : Ideal P)
      rw [Set.image_empty, Ideal.span_empty]
    let g : (P ⧸ I) ≃ₐ[P] P :=
      (Ideal.quotientEquivAlgOfEq P hI).trans (AlgEquiv.quotientBot P P)
    exact (g.toLinearEquiv.isWeaklyRegular_congr _).mp h
  have hr (i : ι) : e (X (Sum.inl i)) = polynomialDiagonalDifference (k := k) i := by
    change subRightVariables ι k (X (Sum.inl i)) = _
    simp [subRightVariables]
  rw [List.map_map] at hreg
  refine (e.toAddEquiv.isWeaklyRegular_congr ?_).mp hreg
  exact List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr fun i _ y => by
    change e (X (Sum.inl i) * y) = polynomialDiagonalDifference (k := k) i * e y
    rw [map_mul, hr]))

end GlobalTheory.PD
