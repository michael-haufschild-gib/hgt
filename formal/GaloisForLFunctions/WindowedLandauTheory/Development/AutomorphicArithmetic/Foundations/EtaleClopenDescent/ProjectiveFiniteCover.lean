import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.SectionFunctionField
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Separable
import Mathlib.RingTheory.AlgebraicIndependent.Defs
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.Smooth.Basic

/-! Projective coordinates and the normalization algebras on chart intersections. -/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open GlobalTheory.SchemeCohomology

namespace GlobalTheory.PD

variable (k : Type) [Field k] {F : Type} [Field F] [Algebra k F] {d : ℕ}

section Coordinates

variable (x : Fin (d + 1) → F)

/-- Projective coordinates on a purely transcendental field of dimension `d`. -/
structure IsPd : Prop where
  ne : ∀ i, x i ≠ 0
  indep : AlgebraicIndependent k fun j : Fin d => x j.succ / x 0
  gen : IntermediateField.adjoin k (Set.range fun j : Fin d => x j.succ / x 0) = ⊤

/-- The algebra generated by the coordinate ratios regular on the given intersection. -/
def rA (I : Finset (Fin (d + 1))) : Subalgebra k F :=
  Algebra.adjoin k {y | ∃ i ∈ I, ∃ j, y = x j / x i}

end Coordinates

variable (E : Type) [Field E] [Algebra k E] [Algebra F E] [IsScalarTower k F E]
  (x : Fin (d + 1) → F)

/-- The normalization of the coordinate algebra in the extension field. -/
def rB (I : Finset (Fin (d + 1))) : Subalgebra k E :=
  (integralClosure (rA k x I) E).restrictScalars k

/-- A finite separable extension whose normalized projective charts are smooth. -/
structure IsFinCover : Prop where
  pd : IsPd k x
  fin : FiniteDimensional F E
  smooth : ∀ i, Algebra.Smooth k (rB k E x {i})
  [sep : Algebra.IsSeparable F E]

/-- The affine coordinates through the origin belong to its normalized chart. -/
theorem tco_mem (j : Fin d) : algebraMap F E (x j.succ / x 0) ∈ rB k E x {0} := by
  have h : x j.succ / x 0 ∈ rA k x {0} :=
    Algebra.subset_adjoin ⟨0, Finset.mem_singleton_self 0, j.succ, rfl⟩
  exact isIntegral_algebraMap (x := (⟨_, h⟩ : rA k x {0}))

variable {k} {X : Scheme.{0}} [IsIntegral X] (p : X ⟶ Spec (CommRingCat.of k))
  [Algebra k X.functionField] {ι : Type}

/-- An affine cover whose intersection rings realize the specified subalgebras
of the function field by generic germs. -/
structure IsAffCover (U : ι → X.Opens) (B : Finset ι → Subalgebra k X.functionField) : Prop where
  alg : algebraMap k X.functionField =
    @algebraMap k X.functionField _ _ (sectionFunctionFieldAlgebra p)
  affine : ∀ I : Finset ι, I.Nonempty → IsAffineOpen (I.inf U)
  cover : iSup U = ⊤
  ne : ∀ I : Finset ι, genericPoint X ∈ I.inf U
  ring : ∀ I : Finset ι, I.Nonempty → ∀ y, y ∈ B I ↔
    ∃ a : Γ(X, I.inf U), (X.presheaf.germ _ (genericPoint X) (ne I)).hom a = y

variable {p} {U : ι → X.Opens} {B : Finset ι → Subalgebra k X.functionField}

/-- Generic germs identify the section algebra of a nonempty intersection
with its chart algebra. -/
def IsAffCover.sectionEquiv (h : IsAffCover p U B) (I : Finset ι) (hI : I.Nonempty) :
    SectionRing p (I.inf U) ≃ₐ[k] B I := by
  let V := I.inf U
  letI : Nonempty V := ⟨⟨genericPoint X, h.ne I⟩⟩
  have hg (c : k) :
      (X.germToFunctionField V).hom (algebraMap k (SectionRing p V) c) =
        @algebraMap k X.functionField _ _ (sectionFunctionFieldAlgebra p) c := by
    letI := sectionFunctionFieldAlgebra p
    exact (sectionToFunctionField p V).commutes c
  let f : SectionRing p V →ₐ[k] X.functionField :=
    { toRingHom := (X.germToFunctionField V).hom
      commutes' := fun c => (hg c).trans (RingHom.congr_fun h.alg c).symm }
  let q := f.codRestrict (B I) fun a => (h.ring I hI _).mpr ⟨a, rfl⟩
  refine AlgEquiv.ofBijective q ⟨fun a b e => ?_, ?_⟩
  · exact X.germToFunctionField_injective V (congrArg Subtype.val e)
  · intro b
    obtain ⟨a, ha⟩ := (h.ring I hI b).mp b.2
    exact ⟨a, Subtype.ext ha⟩

@[simp]
theorem IsAffCover.sectionEquiv_apply_coe (h : IsAffCover p U B)
    (I : Finset ι) (hI : I.Nonempty) (a : SectionRing p (I.inf U)) :
    (h.sectionEquiv I hI a : X.functionField) =
      (X.presheaf.germ _ (genericPoint X) (h.ne I)).hom a := rfl

end GlobalTheory.PD
