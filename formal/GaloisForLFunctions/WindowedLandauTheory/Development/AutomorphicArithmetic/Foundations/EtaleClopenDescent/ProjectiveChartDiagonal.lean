import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.LocalizedTensorDiagonal
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.PolynomialTensorDiagonal
import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.ProjectiveIntersectionLocalization

/-! The differences of affine projective coordinates give a weakly
regular sequence and cut out the diagonal on standard intersections. -/

noncomputable section

open scoped TensorProduct
open RingTheory.Sequence

namespace GlobalTheory.PD

private theorem polynomialChart_diagonal {k A : Type} [Field k] [CommRing A] [Algebra k A]
    {d : ℕ} (e : MvPolynomial (Fin d) k ≃ₐ[k] A)
    (u : Fin d → A) (hu : ∀ i, u i = e (MvPolynomial.X i)) :
    IsWeaklyRegular (A ⊗[k] A) (List.ofFn fun i => diagonalDifference (k := k) A A (u i)) ∧
    RingHom.ker (Algebra.TensorProduct.lmul' k (S := A)).toRingHom =
      Ideal.span (Set.range fun i => diagonalDifference (k := k) A A (u i)) := by
  let P := MvPolynomial (Fin d) k
  let f : P ⊗[k] P ≃ₐ[k] A ⊗[k] A := Algebra.TensorProduct.congr e e
  have hf (a b : P) : f (a ⊗ₜ[k] b) = e a ⊗ₜ[k] e b :=
    Algebra.TensorProduct.map_tmul e.toAlgHom e.toAlgHom a b
  have h (i : Fin d) : f (tensorDiagonalDifference k (Fin d) i) =
      diagonalDifference (k := k) A A (u i) := by
    simp [tensorDiagonalDifference, diagonalDifference, hu, hf]
  constructor
  · rw [List.ofFn_eq_map]
    refine (f.toAddEquiv.isWeaklyRegular_congr ?_).mp
      (weaklyRegular_tensorDiagonalDifference k (Fin d) (List.finRange d) (List.nodup_finRange d))
    refine List.forall₂_map_left_iff.mpr (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr ?_))
    intro i _ y
    change f (tensorDiagonalDifference k (Fin d) i * y) =
      diagonalDifference (k := k) A A (u i) * f y
    rw [map_mul, h]
  · let m₀ : P ⊗[k] P →ₐ[k] P := Algebra.TensorProduct.lmul' k
    let m₁ : A ⊗[k] A →ₐ[k] A := Algebra.TensorProduct.lmul' k
    have hcomp : m₁.comp f.toAlgHom = e.toAlgHom.comp m₀ := by
      apply Algebra.TensorProduct.ext'
      intro a b
      change Algebra.TensorProduct.lmul' k (f (a ⊗ₜ[k] b)) =
        e (Algebra.TensorProduct.lmul' k (a ⊗ₜ[k] b))
      rw [hf, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
    have hk : RingHom.ker m₁.toRingHom =
        Ideal.map f.toRingHom (RingHom.ker (m₁.comp f.toAlgHom).toRingHom) := by
      rw [show (m₁.comp f.toAlgHom).toRingHom = m₁.toRingHom.comp f.toRingHom from rfl,
        ← RingHom.comap_ker]
      exact (Ideal.map_comap_of_surjective f.toRingHom f.surjective _).symm
    change RingHom.ker m₁.toRingHom = _
    rw [hk, hcomp, show (e.toAlgHom.comp m₀).toRingHom = e.toRingHom.comp m₀.toRingHom from rfl,
      RingHom.ker_comp_of_injective _ e.injective,
      show RingHom.ker m₀.toRingHom = Ideal.span (Set.range (tensorDiagonalDifference k (Fin d)))
        from ker_polynomialTensor_lmul k (Fin d), Ideal.map_span, ← Set.range_comp']
    change Ideal.span (Set.range (fun i : Fin d => f (tensorDiagonalDifference k (Fin d) i))) = _
    simp only [h]

variable {k F : Type} [Field k] [Field F] [Algebra k F]
  {d : ℕ} {x : Fin (d + 1) → F}

/-- On any two intersections with a common chart, their multiplication
kernel is generated by a weakly regular list of coordinate differences. -/
theorem IsPd.localizedChartTensorDiagonal (h : IsPd k x)
    {I J : Finset (Fin (d + 1))} {i : Fin (d + 1)} (hI : i ∈ I) (hJ : i ∈ J) :
    let A := rA k x (Singleton.singleton i)
    let B := rA k x I
    let C := rA k x J
    letI : Algebra A B := chartIntersectionAlgebra (k := k) (x := x) hI
    letI : Algebra A C := chartIntersectionAlgebra (k := k) (x := x) hJ
    let u (j : Fin d) := h.chartPolynomialEquiv i (MvPolynomial.X j)
    IsWeaklyRegular (B ⊗[k] C) (List.ofFn fun j => diagonalDifference (k := k) B C (u j)) ∧
    RingHom.ker (tensorChartRestriction (k := k) (L := F) B C).toRingHom =
      Ideal.span (Set.range fun j => diagonalDifference (k := k) B C (u j)) := by
  let A := rA k x (Singleton.singleton i)
  let B := rA k x I
  let C := rA k x J
  letI : Algebra A B := chartIntersectionAlgebra (k := k) (x := x) hI
  letI : Algebra A C := chartIntersectionAlgebra (k := k) (x := x) hJ
  letI : IsScalarTower k A B := .of_algebraMap_eq fun _ => rfl
  letI : IsScalarTower k A C := .of_algebraMap_eq fun _ => rfl
  letI : IsScalarTower A B F := chartIntersection_tower (k := k) (x := x) hI
  letI : IsScalarTower A C F := chartIntersection_tower (k := k) (x := x) hJ
  letI : IsLocalization.Away (chartDenominator k x I i) B := chartIntersection_isLocalization h hI
  letI : IsLocalization.Away (chartDenominator k x J i) C := chartIntersection_isLocalization h hJ
  let u (j : Fin d) : A := h.chartPolynomialEquiv i (MvPolynomial.X j)
  obtain ⟨hr, hk⟩ := polynomialChart_diagonal (h.chartPolynomialEquiv i) u (fun _ => rfl)
  exact localized_tensor_diagonal (B := B) (C := C) (L := F) u hr hk Subtype.val_injective
    (Submonoid.powers (chartDenominator k x I i)) (Submonoid.powers (chartDenominator k x J i))

end GlobalTheory.PD
