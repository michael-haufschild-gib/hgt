import GaloisForLFunctions.WindowedLandauTheory.Development.AutomorphicArithmetic.Foundations.EtaleClopenDescent.SectionFunctionField
import Mathlib.AlgebraicGeometry.Morphisms.Affine
import Mathlib.AlgebraicGeometry.Morphisms.Separated

/-! On a separated integral scheme, the regular functions on an intersection
of two affine opens are generated by the regular functions on the two opens. -/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace GlobalTheory.SchemeCohomology

universe u

private def openTopSections {X : Scheme.{u}} (U : X.Opens) :
    Γ(U.toScheme, ⊤) ≅ Γ(X, U) :=
  X.presheaf.mapIso (eqToIso ((U.ι.image_top_eq_opensRange.trans U.opensRange_ι).symm)).op

@[reassoc]
private theorem openTopSections_natural {X : Scheme.{u}} {U V : X.Opens} (e : U ≤ V) :
    (X.homOfLE e).appTop ≫ (openTopSections U).hom =
      (openTopSections V).hom ≫ X.presheaf.map (homOfLE e).op := by
  let F : X.Opensᵒᵖ ⥤ CommRingCat := X.presheaf
  let a : U.ι ''ᵁ (⊤ : U.toScheme.Opens) ⟶ V.ι ''ᵁ (⊤ : V.toScheme.Opens) :=
    homOfLE (X.ι_image_homOfLE_le_ι_image e ⊤)
  let b : U ⟶ U.ι ''ᵁ (⊤ : U.toScheme.Opens) :=
    eqToHom ((U.ι.image_top_eq_opensRange.trans U.opensRange_ι).symm)
  let c : V ⟶ V.ι ''ᵁ (⊤ : V.toScheme.Opens) :=
    eqToHom ((V.ι.image_top_eq_opensRange.trans V.opensRange_ι).symm)
  let d : U ⟶ V := homOfLE e
  rw [X.homOfLE_appTop]
  change F.map a.op ≫ F.map b.op = F.map c.op ≫ F.map d.op
  exact (F.map_comp a.op b.op).symm.trans
    ((congrArg F.map (Subsingleton.elim (a.op ≫ b.op) (c.op ≫ d.op))).trans
      (F.map_comp c.op d.op))

variable {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
  (s : X ⟶ Spec (CommRingCat.of k))

/-- The generic image of the regular functions on an open containing
the generic point. -/
def genericSectionAlgebra (U : X.Opens) (hη : genericPoint X ∈ U) :
    letI := sectionFunctionFieldAlgebra s
    Subalgebra k X.functionField := by
  letI := sectionFunctionFieldAlgebra s
  letI : Nonempty U := ⟨⟨genericPoint X, hη⟩⟩
  exact (sectionToFunctionField s U).range

private theorem genericSectionAlgebra_le_of_le {U V : X.Opens}
    (hUV : U ≤ V) (hη : genericPoint X ∈ U) :
    letI := sectionFunctionFieldAlgebra s
    genericSectionAlgebra s V (hUV hη) ≤ genericSectionAlgebra s U hη := by
  intro y hy
  change ∃ a : Γ(X, V), (X.presheaf.germ V _ (hUV hη)).hom a = y at hy
  obtain ⟨a, rfl⟩ := hy
  exact ⟨(X.presheaf.map (homOfLE hUV).op).hom a,
    X.presheaf.germ_res_apply (homOfLE hUV) (genericPoint X) hη a⟩

/-- On a separated scheme the generic image of the sections on the
intersection of affine opens is the supremum of the two generic images. -/
theorem genericSectionAlgebra_inf [IsSeparated s] {U V : X.Opens}
    (hU : IsAffineOpen U) (hV : IsAffineOpen V)
    (hu : genericPoint X ∈ U) (hv : genericPoint X ∈ V) :
    letI := sectionFunctionFieldAlgebra s
    genericSectionAlgebra s (U ⊓ V) (show genericPoint X ∈ U ⊓ V from ⟨hu, hv⟩) =
      genericSectionAlgebra s U hu ⊔ genericSectionAlgebra s V hv := by
  letI := sectionFunctionFieldAlgebra s
  let W := U ⊓ V
  have hw : genericPoint X ∈ W := ⟨hu, hv⟩
  letI : IsAffine U.toScheme := hU
  letI : IsAffine V.toScheme := hV
  let f : U.toScheme ⟶ Spec (CommRingCat.of k) := U.ι ≫ s
  let g : V.toScheme ⟶ Spec (CommRingCat.of k) := V.ι ≫ s
  let P := pullback f g
  let pU : P ⟶ U.toScheme := pullback.fst f g
  let pV : P ⟶ V.toScheme := pullback.snd f g
  let ρ : W.toScheme ⟶ P :=
    (isPullback_opens_inf U V).isoPullback.hom ≫ pullback.mapDesc U.ι V.ι s
  letI : IsClosedImmersion (pullback.mapDesc U.ι V.ι s) :=
    MorphismProperty.of_isPullback (pullback_map_diagonal_isPullback U.ι V.ι s) inferInstance
  letI : IsClosedImmersion ρ := inferInstance
  have hρU : ρ ≫ pU = X.homOfLE (inf_le_left : W ≤ U) := by
    change ((isPullback_opens_inf U V).isoPullback.hom ≫ pullback.mapDesc U.ι V.ι s) ≫
      pullback.fst (U.ι ≫ s) (V.ι ≫ s) = _
    rw [Category.assoc]
    have h : pullback.mapDesc U.ι V.ι s ≫ pullback.fst (U.ι ≫ s) (V.ι ≫ s) =
        pullback.fst U.ι V.ι ≫ 𝟙 U.toScheme := pullback.lift_fst _ _ _
    rw [h, Category.comp_id]
    exact (isPullback_opens_inf U V).isoPullback_hom_fst
  have hρV : ρ ≫ pV = X.homOfLE (inf_le_right : W ≤ V) := by
    change ((isPullback_opens_inf U V).isoPullback.hom ≫ pullback.mapDesc U.ι V.ι s) ≫
      pullback.snd (U.ι ≫ s) (V.ι ≫ s) = _
    rw [Category.assoc]
    have h : pullback.mapDesc U.ι V.ι s ≫ pullback.snd (U.ι ≫ s) (V.ι ≫ s) =
        pullback.snd U.ι V.ι ≫ 𝟙 V.toScheme := pullback.lift_snd _ _ _
    rw [h, Category.comp_id]
    exact (isPullback_opens_inf U V).isoPullback_hom_snd
  have hp : IsPushout f.appTop g.appTop pU.appTop pV.appTop :=
    isPushout_appTop_of_isPullback (IsPullback.of_hasPullback f g)
  let A := genericSectionAlgebra s U hu ⊔ genericSectionAlgebra s V hv
  let inclusion : CommRingCat.of A ⟶ X.functionField := CommRingCat.ofHom A.val.toRingHom
  letI : Mono inclusion := ConcreteCategory.mono_of_injective _ Subtype.val_injective
  let u : Γ(U.toScheme, ⊤) ⟶ X.functionField :=
    (openTopSections U).hom ≫ X.presheaf.germ U _ hu
  let v : Γ(V.toScheme, ⊤) ⟶ X.functionField :=
    (openTopSections V).hom ≫ X.presheaf.germ V _ hv
  let q : Γ(P, ⊤) ⟶ X.functionField :=
    ρ.appTop ≫ (openTopSections W).hom ≫ X.presheaf.germ W _ hw
  have hqU : pU.appTop ≫ q = u := by
    rw [show q = ρ.appTop ≫ (openTopSections W).hom ≫ X.presheaf.germ W _ hw from rfl,
      ← Category.assoc, ← Scheme.Hom.comp_appTop, hρU, openTopSections_natural_assoc,
      X.presheaf.germ_res]
  have hqV : pV.appTop ≫ q = v := by
    rw [show q = ρ.appTop ≫ (openTopSections W).hom ≫ X.presheaf.germ W _ hw from rfl,
      ← Category.assoc, ← Scheme.Hom.comp_appTop, hρV, openTopSections_natural_assoc,
      X.presheaf.germ_res]
  have hUle : genericSectionAlgebra s U hu ≤ A := le_sup_left
  have hVle : genericSectionAlgebra s V hv ≤ A := le_sup_right
  let uA : Γ(U.toScheme, ⊤) ⟶ CommRingCat.of A :=
    CommRingCat.ofHom (u.hom.codRestrict A.toSubring (fun a =>
      hUle (show u.hom a ∈ genericSectionAlgebra s U hu by
        exact ⟨(openTopSections U).hom a, rfl⟩)))
  let vA : Γ(V.toScheme, ⊤) ⟶ CommRingCat.of A :=
    CommRingCat.ofHom (v.hom.codRestrict A.toSubring (fun a =>
      hVle (show v.hom a ∈ genericSectionAlgebra s V hv by
        exact ⟨(openTopSections V).hom a, rfl⟩)))
  have huA : uA ≫ inclusion = u := rfl
  have hvA : vA ≫ inclusion = v := rfl
  have hc : f.appTop ≫ uA = g.appTop ≫ vA := by
    apply (cancel_mono inclusion).mp
    simp only [Category.assoc, huA, hvA]
    have h := congrArg (fun a => a ≫ q) hp.w
    simpa only [Category.assoc, hqU, hqV] using h
  let qA := hp.desc uA vA hc
  have hf : qA ≫ inclusion = q := hp.hom_ext
    (by rw [hp.inl_desc_assoc, huA, hqU]) (by rw [hp.inr_desc_assoc, hvA, hqV])
  apply le_antisymm
  · intro y hy
    change ∃ a : Γ(X, W), (X.presheaf.germ W _ hw).hom a = y at hy
    obtain ⟨a, rfl⟩ := hy
    have hsurj : Function.Surjective (ρ.appTop ≫ (openTopSections W).hom) :=
      (ConcreteCategory.bijective_of_isIso (openTopSections W).hom).2.comp
        (IsClosedImmersion.isAffine_surjective_of_isAffine ρ).2
    obtain ⟨z, hz⟩ := hsurj a
    have he := ConcreteCategory.congr_hom hf z
    change (qA z : A).1 = (X.presheaf.germ W _ hw).hom
      ((ρ.appTop ≫ (openTopSections W).hom) z) at he
    rw [hz] at he
    exact he ▸ (qA z : A).2
  · exact sup_le (genericSectionAlgebra_le_of_le s inf_le_left hw)
      (genericSectionAlgebra_le_of_le s inf_le_right hw)

end GlobalTheory.SchemeCohomology
