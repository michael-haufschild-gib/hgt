import GaloisForLFunctions.RHTower.ThetaCuspHawkingSelfDualResponseClockTransgression
import GaloisForLFunctions.RHTower.ThetaCuspHawkingTeukolskyTiltedAngularLeakage

/-!
# Self-dual response defect as gauge-fixed Teukolsky mixing flux

For doubled theta weight, de-aliased Teukolsky angular eigenvalue is `rho * (1-rho)`.
Its imaginary part is the anti-self-adjoint angular defect.  The exact self-dual response
intensity defect satisfies

`Im(lambda) S(rho) = -64 Im(rho) D(rho)`.

For any symmetric gauge-fixed angular operator, real and imaginary residual quadratures are
orthogonal in canonical energy.  Consequently

`S(rho)^2 E_mix = 4096 Im(rho)^2 D(rho)^2 ||psi||^2`.

Conjugate parity responses identify the imaginary residual with the off-diagonal helicity
coefficient.  Any horizon-plus-boundary radiation map whose optical Gram preserves angular
symmetry transports the same Pythagorean identity, without an isometry assumption or a fixed
greybody normalization.

At exact self-dual second-harmonic frequency, the BM hypergeometric radial parameter is
`-(rho+2)/4`.  Its real part lies strictly between adjacent Gamma poles throughout the Xi strip,
so every nonzero self-dual principal source has nonzero chiral boundary response.  Full
second-order incidence still requires classification of non-self-dual same-grade source terms on
the gauge quotient.
-/

open Complex Real
open scoped InnerProductSpace

namespace RHTower

noncomputable section

/-- Exact conversion from the signed self-dual response defect to the anti-self-adjoint part of
the doubled Teukolsky angular Casimir. -/
theorem d4ThetaHawkingSelfDualResponseDefect_angularTransgression
    (q : XiZeroCopy) :
    (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
        (xiSpectralPoint q)).im *
        d4ThetaHawkingSelfDualResponseSusceptibility (q.1 : ℂ) =
      -64 * (q.1 : ℂ).im *
        d4ThetaHawkingSelfDualPartnerResponseIntensityDefect q := by
  rw [d4ThetaTeukolskyQuadraticChiralAngularEigenvalue_eq,
    d4ThetaHawkingSelfDualPartnerResponseIntensityDefect_eq]
  simp [xiSpectralPoint, pow_two, Complex.mul_im]
  ring

/-- Off-diagonal helicity coefficient obtained from the conjugate pair of real parity responses. -/
def d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient (q : XiZeroCopy) : ℂ :=
  let lambda := d4ThetaTeukolskyQuadraticChiralAngularEigenvalue (xiSpectralPoint q)
  (lambda - (starRingEnd ℂ) lambda) / 2

theorem d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient_eq
    (q : XiZeroCopy) :
    d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient q =
      Complex.I *
        (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
          (xiSpectralPoint q)).im := by
  apply Complex.ext
  · simp [d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient]
  · simp [d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient]

theorem normSq_d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient
    (q : XiZeroCopy) :
    Complex.normSq (d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient q) =
      (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
        (xiSpectralPoint q)).im ^ 2 := by
  rw [d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient_eq]
  simp [Complex.normSq_apply]
  ring

/-- Conjugate scalar/vector parity responses split into their real direct-helicity response and
the off-diagonal coefficient above. -/
theorem d4ThetaTeukolskyConjugateParityResponse_opticalSplit
    (q : XiZeroCopy) (scalarMode vectorMode : ℂ) :
    let lambda :=
      d4ThetaTeukolskyQuadraticChiralAngularEigenvalue (xiSpectralPoint q)
    lambda * scalarMode + Complex.I * (starRingEnd ℂ) lambda * vectorMode =
      (lambda.re : ℂ) * d4GravitationalHelicityPlus scalarMode vectorMode +
        d4ThetaTeukolskyOrthogonalHelicityMixingCoefficient q *
          d4GravitationalHelicityMinus scalarMode vectorMode := by
  dsimp only
  rw [d4ParityResponse_eq_helicityMix]
  congr 1
  · apply Complex.ext <;> simp

/-- Frequency of the quadratic self-dual harmonic generated by the fundamental BM mode. -/
def d4ThetaHawkingSelfDualSecondHarmonicFrequency (z : ℂ) : ℂ :=
  2 * thetaCuspHawkingTopologicalBlackHoleQNMPlus 0 z

/-- At the exact second harmonic, hypergeometric radial parameter equals the self-dual ingoing
Mellin exponent. -/
theorem d4ThetaHawkingSelfDualSecondHarmonic_radialA (z : ℂ) :
    thetaCuspHawkingHypergeometricRadialA
        (d4ThetaHawkingSelfDualSecondHarmonicFrequency z) z =
      d4FundamentalQNMIngoingExponent z := by
  unfold d4ThetaHawkingSelfDualSecondHarmonicFrequency
    thetaCuspHawkingHypergeometricRadialA
    thetaCuspHawkingTopologicalBlackHoleQNMPlus
    thetaCuspHawkingTopologicalBlackHoleConformalDecay
    d4FundamentalQNMIngoingExponent
  rw [d4ThetaTeukolskyAngularMomentum_eq_rho]
  ring_nf
  rw [Complex.I_sq]
  push_cast
  ring

/-- The self-dual second harmonic never hits a chiral hypergeometric Jost zero on an Xi sector. -/
theorem d4ThetaHawkingSelfDualSecondHarmonicJost_xi_ne_zero
    (q : XiZeroCopy) :
    thetaCuspHawkingHypergeometricJostPlus
        (d4ThetaHawkingSelfDualSecondHarmonicFrequency (xiSpectralPoint q))
        (xiSpectralPoint q) ≠ 0 := by
  rw [thetaCuspHawkingHypergeometricJostPlus,
    d4ThetaHawkingSelfDualSecondHarmonic_radialA]
  unfold GaloisForLFunctions.reciprocalGammaEntire
  apply inv_ne_zero
  apply Complex.Gamma_ne_zero
  intro m hm
  have hre := congrArg Complex.re hm
  rw [d4FundamentalQNMIngoingExponent,
    d4ThetaTeukolskyRho_xiSpectralPoint] at hre
  norm_num at hre
  have hstrip := xi_divisor_support_re_mem_open_unit q.1
  by_cases hm0 : m = 0
  · subst m
    norm_num at hre
    linarith
  · have hm1 : (1 : ℝ) ≤ (m : ℝ) := by
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr hm0)
    linarith

/-- Exact second-harmonic chiral boundary response of the self-dual source. -/
def d4ThetaHawkingSelfDualSecondHarmonicBoundaryResponse
    (amplitude : ℂ) (q : XiZeroCopy) : ℂ :=
  d4ThetaHawkingSelfDualQuadraticCarrierCoefficient amplitude
      (xiSpectralPoint q) *
    thetaCuspHawkingHypergeometricGreenPlus
      (d4ThetaHawkingSelfDualSecondHarmonicFrequency (xiSpectralPoint q))
      (xiSpectralPoint q)

/-- Every nonzero self-dual seed has nonzero exact BM second-harmonic boundary response. -/
theorem d4ThetaHawkingSelfDualSecondHarmonicBoundaryResponse_ne_zero
    {amplitude : ℂ} (ha : amplitude ≠ 0) (q : XiZeroCopy) :
    d4ThetaHawkingSelfDualSecondHarmonicBoundaryResponse amplitude q ≠ 0 := by
  unfold d4ThetaHawkingSelfDualSecondHarmonicBoundaryResponse
    thetaCuspHawkingHypergeometricGreenPlus
  exact mul_ne_zero
    (d4ThetaHawkingSelfDualQuadraticCarrierCoefficient_xi_ne_zero ha q)
    (inv_ne_zero
      (d4ThetaHawkingSelfDualSecondHarmonicJost_xi_ne_zero q))

variable {H : Type*} [NormedAddCommGroup H]

/-- Orthogonal quadrature energy forced by the imaginary part of the de-aliased angular Casimir. -/
def d4ThetaTeukolskyOrthogonalHelicityMixingEnergy
    (psi : H) (q : XiZeroCopy) : ℝ :=
  (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
      (xiSpectralPoint q)).im ^ 2 * ‖psi‖ ^ 2

theorem d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_nonneg
    (psi : H) (q : XiZeroCopy) :
    0 ≤ d4ThetaTeukolskyOrthogonalHelicityMixingEnergy psi q := by
  exact mul_nonneg (sq_nonneg _) (sq_nonneg _)

/-- Division-free optical transgression: susceptibility-scaled mixing energy is exactly the
height-weighted square of the local self-dual intensity defect. -/
theorem d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_scaled_eq_responseDefect
    (psi : H) (q : XiZeroCopy) :
    d4ThetaHawkingSelfDualResponseSusceptibility (q.1 : ℂ) ^ 2 *
        d4ThetaTeukolskyOrthogonalHelicityMixingEnergy psi q =
      4096 * (q.1 : ℂ).im ^ 2 *
        d4ThetaHawkingSelfDualPartnerResponseIntensityDefect q ^ 2 * ‖psi‖ ^ 2 := by
  rw [d4ThetaTeukolskyOrthogonalHelicityMixingEnergy]
  have h := d4ThetaHawkingSelfDualResponseDefect_angularTransgression q
  calc
    d4ThetaHawkingSelfDualResponseSusceptibility (q.1 : ℂ) ^ 2 *
        ((d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
          (xiSpectralPoint q)).im ^ 2 * ‖psi‖ ^ 2) =
      ((d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
          (xiSpectralPoint q)).im *
        d4ThetaHawkingSelfDualResponseSusceptibility (q.1 : ℂ)) ^ 2 *
          ‖psi‖ ^ 2 := by ring
    _ = (-64 * (q.1 : ℂ).im *
        d4ThetaHawkingSelfDualPartnerResponseIntensityDefect q) ^ 2 *
          ‖psi‖ ^ 2 := by rw [h]
    _ = 4096 * (q.1 : ℂ).im ^ 2 *
        d4ThetaHawkingSelfDualPartnerResponseIntensityDefect q ^ 2 *
          ‖psi‖ ^ 2 := by ring

/-- A nonzero Xi source has no orthogonal angular mixing exactly on the critical line. -/
theorem d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_eq_zero_iff
    (psi : H) (hpsi : psi ≠ 0) (q : XiZeroCopy) :
    d4ThetaTeukolskyOrthogonalHelicityMixingEnergy psi q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [d4ThetaTeukolskyOrthogonalHelicityMixingEnergy, mul_eq_zero]
  have hnorm : ‖psi‖ ^ 2 ≠ 0 := pow_ne_zero 2 (norm_ne_zero_iff.mpr hpsi)
  simp only [hnorm, or_false, sq_eq_zero_iff]
  have hlambda :
      (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
          (xiSpectralPoint q)).im =
        2 * (q.1 : ℂ).im * (1 / 2 - (q.1 : ℂ).re) := by
    rw [d4ThetaTeukolskyQuadraticChiralAngularEigenvalue_eq]
    simp [xiSpectralPoint, pow_two, Complex.mul_im]
    ring
  rw [hlambda]
  have him := xi_divisor_support_im_ne_zero q.1
  have htwoim : 2 * (q.1 : ℂ).im ≠ 0 := mul_ne_zero (by norm_num) him
  constructor
  · intro h
    have hz := (mul_eq_zero.mp h).resolve_left htwoim
    linarith
  · intro h
    rw [h]
    ring

variable [InnerProductSpace ℂ H]

/-- Gauge-fixed angular optical decomposition into real projected residual and orthogonal
helicity-quadrature mixing. -/
theorem d4ThetaTeukolskyGaugeFixedAngularOpticalDecomposition
    (A : H → H) (psi : H) (q : XiZeroCopy)
    (hsa : ⟪psi, A psi⟫_ℂ = ⟪A psi, psi⟫_ℂ) :
    ‖A psi -
          d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
              (xiSpectralPoint q) • psi‖ ^ 2 =
      ‖A psi -
          ((d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
              (xiSpectralPoint q)).re : ℂ) • psi‖ ^ 2 +
        d4ThetaTeukolskyOrthogonalHelicityMixingEnergy psi q := by
  rw [d4ThetaTeukolskyOrthogonalHelicityMixingEnergy]
  exact complexSymmetric_residual_norm_sq
    (A psi) psi
    (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue (xiSpectralPoint q)) hsa

variable {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℂ K]

/-- Horizon-plus-boundary flux carried by the off-diagonal helicity component. -/
def d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux
    (radiation : H →ₗ[ℂ] K) (psi : H) (q : XiZeroCopy) : ℝ :=
  (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
      (xiSpectralPoint q)).im ^ 2 * ‖radiation psi‖ ^ 2

theorem d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux_nonneg
    (radiation : H →ₗ[ℂ] K) (psi : H) (q : XiZeroCopy) :
    0 ≤ d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux radiation psi q := by
  exact mul_nonneg (sq_nonneg _) (sq_nonneg _)

/-- Greybody transfer preserves the exact defect law without an isometry assumption. -/
theorem d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux_scaled_eq_responseDefect
    (radiation : H →ₗ[ℂ] K) (psi : H) (q : XiZeroCopy) :
    d4ThetaHawkingSelfDualResponseSusceptibility (q.1 : ℂ) ^ 2 *
        d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux radiation psi q =
      4096 * (q.1 : ℂ).im ^ 2 *
        d4ThetaHawkingSelfDualPartnerResponseIntensityDefect q ^ 2 *
          ‖radiation psi‖ ^ 2 := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_scaled_eq_responseDefect
    (radiation psi) q

/-- A radiating Xi source has zero global helicity-mixing flux exactly on the critical line. -/
theorem d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux_eq_zero_iff
    (radiation : H →ₗ[ℂ] K) (psi : H) (q : XiZeroCopy)
    (hradiates : radiation psi ≠ 0) :
    d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux radiation psi q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_eq_zero_iff
    (radiation psi) hradiates q

/-- Global optical decomposition for a gauge-quotient radiation map whose optical Gram preserves
angular symmetry.  The map may contain arbitrary frequency-dependent greybody transfer. -/
theorem d4ThetaTeukolskyGaugeFixedGlobalOpticalDecomposition
    (radiation : H →ₗ[ℂ] K) (A : H → H) (psi : H) (q : XiZeroCopy)
    (hoptical :
      ⟪radiation psi, radiation (A psi)⟫_ℂ =
        ⟪radiation (A psi), radiation psi⟫_ℂ) :
    ‖radiation
        (A psi -
          d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
              (xiSpectralPoint q) • psi)‖ ^ 2 =
      ‖radiation
        (A psi -
          ((d4ThetaTeukolskyQuadraticChiralAngularEigenvalue
              (xiSpectralPoint q)).re : ℂ) • psi)‖ ^ 2 +
        d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux radiation psi q := by
  rw [d4ThetaTeukolskyGlobalOrthogonalHelicityMixingFlux]
  simpa only [map_sub, map_smul] using
    complexSymmetric_residual_norm_sq
      (radiation (A psi)) (radiation psi)
      (d4ThetaTeukolskyQuadraticChiralAngularEigenvalue (xiSpectralPoint q))
      hoptical

end

end RHTower
