import GaloisForLFunctions.RHTower.DeningerDynSysSpecStalkDictionary
import GaloisForLFunctions.RHTower.DeningerDynSysValuedCharEquiv
import GaloisForLFunctions.RHTower.DeningerDynSysWittValuedPoint

/-!
# Corollary 13.5: the `𝒪`-valued points of an affine scheme

Deninger, *Dynamical systems for arithmetic schemes* (arXiv:1807.06400v4), Corollary 13.5 (`t45`).

For `X = Spec R` the `𝒪`-valued points of `W_rat (X)` are the pointed multiplicative maps
`Q : R → 𝒪` satisfying a') and b').  The point `x` is the prime `Q⁻¹ (0)`, the point `y` is the
prime `Q⁻¹ (𝔪)`, and the germ map at `y` is the extension `Q_𝔮 : R_𝔮 → 𝒪`, which exists because
`Q` takes unit values outside `𝔮`.  Conversely a point is sent back to the restriction of its germ
map to `R`; the two constructions are inverse because `R_𝔮` is generated by `R` together with the
inverses of the unit values.
-/

namespace RHTower

open AlgebraicGeometry CategoryTheory HTGeometry IsLocalRing

noncomputable section

universe u

variable {R : CommRingCat.{u}} {O : Type u} [CommRing O] [IsDomain O] [IsLocalRing O]

/-- **Deninger, Corollary 13.5 (`t45`).**  A pointed multiplicative map on the coordinate ring
satisfying a') and b'). -/
def DeningerAffineValuedPoint (R : CommRingCat.{u}) (O : Type u) [CommRing O] [IsLocalRing O] :
    Type u :=
  {Q : R →*₀ O // DeningerAdditiveOnZeros Q ∧ DeningerAdditiveModMax Q}

namespace DeningerAffineValuedPoint

variable (Q : DeningerAffineValuedPoint R O)

/-- The generic point attached to `Q`. -/
@[reducible] def gen : PrimeSpectrum R :=
  ⟨deningerZeroIdeal Q.1 Q.2.1, deningerZeroIdeal_isPrime Q.1 Q.2.1⟩

/-- The specialisation attached to `Q`. -/
@[reducible] def spec : PrimeSpectrum R :=
  ⟨deningerMaxIdeal Q.1 Q.2.2, deningerMaxIdeal_isPrime Q.1 Q.2.2⟩

theorem mem_gen (r : R) : r ∈ (gen Q).asIdeal ↔ Q.1 r = 0 := Iff.rfl

omit [IsDomain O] in
theorem mem_spec (r : R) : r ∈ (spec Q).asIdeal ↔ Q.1 r ∈ maximalIdeal O := Iff.rfl

theorem specializes : (gen Q) ⤳ (spec Q) :=
  (PrimeSpectrum.le_iff_specializes _ _).1 (deningerZeroIdeal_le_maxIdeal Q.1 Q.2.1 Q.2.2)

/-- The germ map at the specialisation, transported from `R_𝔮` to the stalk. -/
def germMap : (Spec R).presheaf.stalk (spec Q) →*₀ O :=
  (deningerLocalQ Q.1 Q.2.2).comp
    ((specStalkRingEquiv R (spec Q)).symm : _ →+* _).toMonoidWithZeroHom

omit [IsDomain O] in
theorem germMap_apply (f : (Spec R).presheaf.stalk (spec Q)) :
    germMap Q f = deningerLocalQ Q.1 Q.2.2 ((specStalkRingEquiv R (spec Q)).symm f) := rfl

omit [IsDomain O] in
theorem germMap_algebraMap (r : R) :
    germMap Q (algebraMap R ((Spec R).presheaf.stalk (spec Q)) r) = Q.1 r := by
  rw [germMap_apply]
  have hcomm : (specStalkRingEquiv R (spec Q)).symm
      (algebraMap R ((Spec R).presheaf.stalk (spec Q)) r)
      = algebraMap R (Localization.AtPrime (spec Q).asIdeal) r := by
    refine (specStalkRingEquiv R (spec Q)).injective ?_
    rw [(specStalkRingEquiv R (spec Q)).apply_symm_apply]
    exact ((StructureSheaf.stalkIso (R : Type u) (spec Q)).commutes r).symm
  rw [hcomm]
  exact deningerLocalQ_algebraMap Q.1 Q.2.2 r

omit [IsDomain O] in
theorem specStalk_mk_mul (r : R) (s : (spec Q).asIdeal.primeCompl) :
    specStalkRingEquiv R (spec Q) (Localization.mk r s)
        * algebraMap R ((Spec R).presheaf.stalk (spec Q)) (s : R)
      = algebraMap R ((Spec R).presheaf.stalk (spec Q)) r := by
  have hcomm : ∀ a : R, specStalkRingEquiv R (spec Q)
      (algebraMap R (Localization.AtPrime (spec Q).asIdeal) a)
      = algebraMap R ((Spec R).presheaf.stalk (spec Q)) a := fun a =>
    (StructureSheaf.stalkIso (R : Type u) (spec Q)).commutes a
  rw [← hcomm (s : R), ← map_mul, ← hcomm r]
  congr 1
  rw [Localization.mk_eq_mk']
  exact IsLocalization.mk'_spec _ r s

theorem stalkValue_algebraMap_eq_zero_iff (a : R) :
    stalkValue (specializes Q) (algebraMap R ((Spec R).presheaf.stalk (spec Q)) a) = 0
      ↔ Q.1 a = 0 := by
  rw [deningerSpecStalkValue_algebraMap, deningerSpecResidue_algebraMap_eq_zero_iff]
  exact mem_gen Q a

omit [IsDomain O] in
theorem residue_algebraMap_eq_zero_iff (a : R) :
    ((Spec R).residue (spec Q)).hom (algebraMap R ((Spec R).presheaf.stalk (spec Q)) a) = 0
      ↔ Q.1 a ∈ maximalIdeal O := by
  rw [deningerSpecResidue_algebraMap_eq_zero_iff]
  exact mem_spec Q a

theorem germMap_eq_zero_iff (f : (Spec R).presheaf.stalk (spec Q)) :
    germMap Q f = 0 ↔ stalkValue (specializes Q) f = 0 := by
  obtain ⟨z, rfl⟩ := (specStalkRingEquiv R (spec Q)).surjective f
  refine Localization.induction_on z ?_
  rintro ⟨r, s⟩
  have hs : Q.1 (s : R) ∉ maximalIdeal O := s.2
  have hsne : stalkValue (specializes Q)
      (algebraMap R ((Spec R).presheaf.stalk (spec Q)) (s : R)) ≠ 0 := by
    intro hc
    rw [stalkValue_algebraMap_eq_zero_iff] at hc
    exact hs (by rw [hc]; exact Ideal.zero_mem _)
  have hmul : stalkValue (specializes Q)
        (specStalkRingEquiv R (spec Q) (Localization.mk r s))
      * stalkValue (specializes Q)
        (algebraMap R ((Spec R).presheaf.stalk (spec Q)) (s : R))
      = stalkValue (specializes Q)
        (algebraMap R ((Spec R).presheaf.stalk (spec Q)) r) := by
    have h := congrArg (stalkValueHom (specializes Q)) (specStalk_mk_mul Q r s)
    rw [map_mul] at h
    exact h
  have hleft : germMap Q (specStalkRingEquiv R (spec Q) (Localization.mk r s))
      = deningerLocalQ Q.1 Q.2.2 (Localization.mk r s) := by
    rw [germMap_apply, (specStalkRingEquiv R (spec Q)).symm_apply_apply]
  rw [hleft, deningerLocalQ_eq_zero_iff]
  constructor
  · intro hr
    have h0 : stalkValue (specializes Q)
        (algebraMap R ((Spec R).presheaf.stalk (spec Q)) r) = 0 :=
      (stalkValue_algebraMap_eq_zero_iff Q r).2 hr
    rw [h0] at hmul
    exact (mul_eq_zero.1 hmul).resolve_right hsne
  · intro h0
    refine (stalkValue_algebraMap_eq_zero_iff Q r).1 ?_
    rw [← hmul, h0, zero_mul]

omit [IsDomain O] in
theorem germMap_mem_maximalIdeal_iff (f : (Spec R).presheaf.stalk (spec Q)) :
    germMap Q f ∈ maximalIdeal O ↔ ((Spec R).residue (spec Q)).hom f = 0 := by
  obtain ⟨z, rfl⟩ := (specStalkRingEquiv R (spec Q)).surjective f
  refine Localization.induction_on z ?_
  rintro ⟨r, s⟩
  have hs : Q.1 (s : R) ∉ maximalIdeal O := s.2
  have hsne : ((Spec R).residue (spec Q)).hom
      (algebraMap R ((Spec R).presheaf.stalk (spec Q)) (s : R)) ≠ 0 := by
    intro hc
    rw [residue_algebraMap_eq_zero_iff] at hc
    exact hs hc
  have hmul := congrArg (fun w => ((Spec R).residue (spec Q)).hom w)
    (specStalk_mk_mul Q r s)
  simp only [map_mul] at hmul
  have hleft : germMap Q (specStalkRingEquiv R (spec Q) (Localization.mk r s))
      = deningerLocalQ Q.1 Q.2.2 (Localization.mk r s) := by
    rw [germMap_apply, (specStalkRingEquiv R (spec Q)).symm_apply_apply]
  rw [hleft, deningerLocalQ_mem_maximalIdeal_iff]
  constructor
  · intro hr
    have h0 : ((Spec R).residue (spec Q)).hom
        (algebraMap R ((Spec R).presheaf.stalk (spec Q)) r) = 0 :=
      (residue_algebraMap_eq_zero_iff Q r).2 hr
    rw [h0] at hmul
    exact (mul_eq_zero.1 hmul).resolve_right hsne
  · intro h0
    refine (residue_algebraMap_eq_zero_iff Q r).1 ?_
    rw [← hmul, h0, zero_mul]

omit [IsDomain O] in
theorem germMap_additiveOnZeros : DeningerAdditiveOnZeros (germMap Q) := by
  intro f f' hf'
  have h := deningerLocalQ_additiveOnZeros Q.1 Q.2.1 Q.2.2
    ((specStalkRingEquiv R (spec Q)).symm f) ((specStalkRingEquiv R (spec Q)).symm f')
    (by rw [← germMap_apply]; exact hf')
  rw [germMap_apply, germMap_apply, map_add]
  exact h

omit [IsDomain O] in
theorem germMap_additiveModMax : DeningerAdditiveModMax (germMap Q) := by
  intro f f' hf'
  have h := deningerLocalQ_additiveModMax Q.1 Q.2.2
    ((specStalkRingEquiv R (spec Q)).symm f) ((specStalkRingEquiv R (spec Q)).symm f')
    (by rw [← germMap_apply]; exact hf')
  rw [germMap_apply, germMap_apply, map_add]
  exact h

/-- **Deninger, Corollary 13.5 (`t45`).**  The `𝒪`-valued point attached to `Q`. -/
def toLocalTriple : DeningerValuedLocalTriple (Spec R) O :=
  deningerValuedLocalTripleOfConditions (specializes Q) (germMap Q)
    (germMap_additiveOnZeros Q) (germMap_additiveModMax Q)
    (germMap_eq_zero_iff Q) (germMap_mem_maximalIdeal_iff Q)

@[simp] theorem toLocalTriple_gen : (toLocalTriple Q).gen = gen Q := rfl

@[simp] theorem toLocalTriple_spec : (toLocalTriple Q).spec = spec Q := rfl

@[simp] theorem toLocalTriple_map : (toLocalTriple Q).map = germMap Q := rfl

end DeningerAffineValuedPoint


namespace DeningerValuedLocalTriple

variable (T : DeningerValuedLocalTriple (Spec R) O)

/-- **Deninger, Corollary 13.5 (`t45`).**  The restriction of the germ map to the coordinate
ring. -/
def restrictToBase : R →*₀ O :=
  T.map.comp ((algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) :
    R →+* _).toMonoidWithZeroHom)

omit [IsDomain O] in
@[simp] theorem restrictToBase_apply (r : R) :
    restrictToBase T r = T.map (algebraMap R ((Spec R).presheaf.stalk
      (T.spec : PrimeSpectrum R)) r) := rfl

omit [IsDomain O] in
theorem restrictToBase_additiveOnZeros : DeningerAdditiveOnZeros (restrictToBase T) := by
  intro f f' hf'
  have h := T.additiveOnZeros
    (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) f)
    (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) f') hf'
  rw [restrictToBase_apply, map_add]
  exact h

omit [IsDomain O] in
theorem restrictToBase_additiveModMax : DeningerAdditiveModMax (restrictToBase T) := by
  intro f f' hf'
  have h := T.additiveModMax
    (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) f)
    (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) f') hf'
  rw [restrictToBase_apply, map_add]
  exact h

/-- **Deninger, Corollary 13.5 (`t45`).**  The pointed multiplicative map on `R` attached to an
`𝒪`-valued point. -/
def toAffineValuedPoint : DeningerAffineValuedPoint R O :=
  ⟨restrictToBase T, restrictToBase_additiveOnZeros T, restrictToBase_additiveModMax T⟩

omit [IsDomain O] in
theorem map_algebraMap_eq_zero_iff (r : R) :
    T.map (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) r) = 0
      ↔ r ∈ (T.gen : PrimeSpectrum R).asIdeal := by
  rw [T.map_eq_zero_iff, deningerSpecStalkValue_algebraMap,
    deningerSpecResidue_algebraMap_eq_zero_iff]

omit [IsDomain O] in
theorem map_algebraMap_mem_maximalIdeal_iff (r : R) :
    T.map (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) r)
        ∈ maximalIdeal O
      ↔ r ∈ (T.spec : PrimeSpectrum R).asIdeal := by
  rw [T.map_mem_maximalIdeal_iff, deningerSpecResidue_algebraMap_eq_zero_iff]

omit [IsDomain O] in
/-- An `𝒪`-valued point of an affine scheme is determined by its two points and the restriction of
its germ map to the coordinate ring, because the stalk is generated by that ring together with the
inverses of the unit values. -/
theorem eq_of_restrict_eq (T U : DeningerValuedLocalTriple (Spec R) O)
    (hgen : T.gen = U.gen) (hspec : T.spec = U.spec)
    (h : ∀ r : R, T.map (algebraMap R ((Spec R).presheaf.stalk (T.spec : PrimeSpectrum R)) r)
      = U.map (algebraMap R ((Spec R).presheaf.stalk (U.spec : PrimeSpectrum R)) r)) :
    T = U := by
  obtain ⟨g, s, hsp, m, p1, p2, p3⟩ := T
  obtain ⟨g', s', hsp', m', p1', p2', p3'⟩ := U
  cases hgen
  cases hspec
  dsimp only at h
  have hmap : m = m' := by
    refine MonoidWithZeroHom.ext fun f => ?_
    obtain ⟨⟨r, t⟩, hf⟩ := IsLocalization.surj
      (M := (s : PrimeSpectrum R).asIdeal.primeCompl) f
    have hunit : IsUnit (m (algebraMap R ((Spec R).presheaf.stalk
        (s : PrimeSpectrum R)) (t : R))) := by
      refine notMem_maximalIdeal.1 ?_
      intro hc
      exact t.2 ((map_algebraMap_mem_maximalIdeal_iff ⟨g, s, hsp, m, p1, p2, p3⟩ (t : R)).1 hc)
    have h1 : m f * m (algebraMap R _ (t : R)) = m (algebraMap R _ r) := by
      rw [← map_mul, hf]
    have h2 : m' f * m' (algebraMap R _ (t : R)) = m' (algebraMap R _ r) := by
      rw [← map_mul, hf]
    have h3 : m f * m (algebraMap R _ (t : R)) = m' f * m (algebraMap R _ (t : R)) := by
      calc m f * m (algebraMap R _ (t : R)) = m (algebraMap R _ r) := h1
        _ = m' (algebraMap R _ r) := h r
        _ = m' f * m' (algebraMap R _ (t : R)) := h2.symm
        _ = m' f * m (algebraMap R _ (t : R)) := by rw [h (t : R)]
    exact hunit.mul_right_cancel h3
  cases hmap
  rfl

end DeningerValuedLocalTriple

/-- **Deninger, Corollary 13.5 (`t45`).**  For an affine scheme the `𝒪`-valued points of
`W_rat (X)` are the pointed multiplicative maps `Q : R → 𝒪` satisfying a') and b'). -/
def deningerAffineValuedPointEquiv :
    DeningerAffineValuedPoint R O ≃ DeningerValuedLocalTriple (Spec R) O where
  toFun := DeningerAffineValuedPoint.toLocalTriple
  invFun := DeningerValuedLocalTriple.toAffineValuedPoint
  left_inv Q := by
    refine Subtype.ext (MonoidWithZeroHom.ext fun r => ?_)
    exact DeningerAffineValuedPoint.germMap_algebraMap Q r
  right_inv T := by
    refine DeningerValuedLocalTriple.eq_of_restrict_eq _ _ ?_ ?_ ?_
    · refine PrimeSpectrum.ext ?_
      ext r
      show T.toAffineValuedPoint.1 r = 0 ↔ _
      exact T.map_algebraMap_eq_zero_iff r
    · refine PrimeSpectrum.ext ?_
      ext r
      show T.toAffineValuedPoint.1 r ∈ maximalIdeal O ↔ _
      exact T.map_algebraMap_mem_maximalIdeal_iff r
    · intro r
      exact DeningerAffineValuedPoint.germMap_algebraMap T.toAffineValuedPoint r

/-- **Deninger, Corollary 13.5 (`t45`), combined with Proposition 13.4.**  For an affine scheme the
`𝒪`-valued points of `W_rat (X)` are on the one hand the pointed multiplicative maps `Q : R → 𝒪`
satisfying a') and b'), and on the other the character triples of Definition 13.2. -/
def deningerAffineValuedCharTripleEquiv :
    DeningerAffineValuedPoint R O ≃ DeningerValuedCharTriple (Spec R) O :=
  (deningerAffineValuedPointEquiv.trans deningerValuedLocalTripleEquiv).trans
    deningerValuedCharTripleEquiv.symm

/-- **Deninger, Corollary 13.5 (`t45`), Proposition 13.4 and Proposition 13.1 combined.**  For an
affine scheme with algebraically closed residue fields whose local rings are integrally closed
domains with algebraically closed fraction field, the `𝒪`-valued points of `W_rat (X)` in the
Witt-homomorphism description are the pointed multiplicative maps `Q : R → 𝒪` satisfying a') and
b'). -/
def deningerAffineWittValuedPointEquiv
    [∀ x : (Spec R : Scheme.{u}), IsAlgClosed ((Spec R).residueField x)]
    [∀ x : (Spec R : Scheme.{u}), IsDomain ((Spec R).presheaf.stalk x)]
    [∀ x : (Spec R : Scheme.{u}), IsIntegrallyClosed ((Spec R).presheaf.stalk x)]
    [∀ x : (Spec R : Scheme.{u}), IsAlgClosed (FractionRing ((Spec R).presheaf.stalk x))] :
    DeningerAffineValuedPoint R O ≃ DeningerWittValuedPoint (Spec R) O :=
  deningerAffineValuedCharTripleEquiv.trans deningerWittValuedPointEquiv.symm

end

end RHTower
