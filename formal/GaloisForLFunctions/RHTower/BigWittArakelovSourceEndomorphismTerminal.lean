import GaloisForLFunctions.RHTower.ArakelovPowerOrbitRH
import GaloisForLFunctions.RHTower.CCMConnesConsaniZetaCycleCompletedXiNaturality
import GaloisForLFunctions.RHTower.DeningerBigWittFrobeniusRingEndomorphism
import GaloisForLFunctions.RHTower.DeningerEntireScalingCoverQuotientFunctoriality
import GaloisForLFunctions.RHTower.LocalDivisorJetAdamsDilation

/-!
# Big-Witt / Arakelov source-endomorphism terminal

This module attacks the open source operation behind `ArakelovPowerOrbitRH`.
The canonical Big-Witt Frobenius does supply the desired reporter law:

`F₂(T(w(rho))) = T(w(rho)^(2 : ℕ)) = T(w(P₂(rho)))`.

The law does not extend to the requested global completed-Xi source geometry.
The square lift is the rational map `rho^(2 : ℕ) / (2*rho - 1)` and is not
continuous at `rho = 1/2`.  Consequently no endomorphism of the algebra of
entire functions can act by precomposition with it: applying such an
endomorphism to the coordinate would make the square lift entire.

The other source-correct operations do not repair this obstruction:

* a Scaling-Site cover fixes every zeta-circle critical point and hence cannot
  induce `P₂`, whose only fixed points are `0` and `1`;
* Euler Adams acts on analytic jets by dilation `X ↦ nX`, not ramification
  `X ↦ X^n`;
* half-scaling gives a valid cross-fibre map only after replacing the receiver
  by the ideal generated by `z ↦ XiC (z / 2)`;
* restricting the power lift to the right half-plane avoids the pole, but
  fixed-receiver divisor stability and bare preperiodicity are each exactly
  equivalent to RH.

Thus the source-first Big-Witt reporter is the positive survivor, while every
literature-compatible route from it to the fixed completed-Xi receiver is
closed or reaches the already RH-equivalent descent wall.
-/

open Complex Filter Topology
open GaloisForLFunctions

namespace RHTower

noncomputable section

/-- Teichmüller reporter of the Arakelov spectral coordinate. -/
def arakelovBigWittReporter (rho : ℂ) : DeningerBigWittRing ℂ :=
  deningerBigWittRingTeichmuller (arakelovW rho)

/-- Positive survivor: canonical Big-Witt Frobenius realizes the Arakelov
square law exactly, before any Xi zero or spectral fibre is selected. -/
@[simp] theorem deningerBigWittFrobeniusTwoRingHom_arakelovBigWittReporter
    (rho : ℂ) :
    deningerBigWittFrobeniusTwoRingHom (arakelovBigWittReporter rho) =
      arakelovBigWittReporter (arakelovPowerLift 2 rho) := by
  simp [arakelovBigWittReporter]

/-- The only fixed points of the square lift are its two degenerate Arakelov
anchors. -/
theorem arakelovPowerLift_two_eq_self_iff (rho : ℂ) :
    arakelovPowerLift 2 rho = rho ↔ rho = 0 ∨ rho = 1 := by
  constructor
  · intro hfixed
    have hw : arakelovW rho ^ (2 : ℕ) = arakelovW rho := by
      rw [← arakelovW_arakelovPowerLift 2 rho, hfixed]
    have hfactor : arakelovW rho * (arakelovW rho - 1) = 0 := by
      calc
        arakelovW rho * (arakelovW rho - 1) =
            arakelovW rho ^ (2 : ℕ) - arakelovW rho := by ring
        _ = 0 := sub_eq_zero.mpr hw
    rcases mul_eq_zero.mp hfactor with hw0 | hw1
    · exact Or.inr (GaloisForLFunctions.arakelovW_injective
        (hw0.trans (by simp [arakelovW])))
    · apply Or.inl
      apply GaloisForLFunctions.arakelovW_injective
      simpa [arakelovW] using sub_eq_zero.mp hw1
  · rintro (rfl | rfl) <;> simp [arakelovPowerLift, arakelovW]

/-- Every zeta-circle critical point is nonzero. -/
theorem ccmZetaCircleCriticalPoint_ne_zero
    (L : CCMZetaCircleLength) (m : ℤ) :
    ccmZetaCircleCriticalPoint L m ≠ 0 := by
  intro hzero
  have hre := congrArg Complex.re hzero
  rw [ccmZetaCircleCriticalPoint_re] at hre
  norm_num at hre

/-- No zeta-circle critical point is fixed by the Arakelov square lift. -/
theorem ccmZetaCircleCriticalPoint_not_fixed_by_arakelovPowerLift_two
    (L : CCMZetaCircleLength) (m : ℤ) :
    arakelovPowerLift 2 (ccmZetaCircleCriticalPoint L m) ≠
      ccmZetaCircleCriticalPoint L m := by
  intro hfixed
  rcases (arakelovPowerLift_two_eq_self_iff _).mp hfixed with hzero | hone
  · exact ccmZetaCircleCriticalPoint_ne_zero L m hzero
  · exact ccmZetaCircleCriticalPoint_ne_one L m hone

/-- Dyadic Scaling-Site cover degree. -/
def ccmZetaCircleTwoCoverDegree : ℕ+ := ⟨2, by norm_num⟩

/-- Actual Scaling-Site dyadic covers preserve the critical point rather than
apply the Arakelov square lift. -/
theorem ccmZetaCircleCover_not_arakelovPowerLift_two
    (L : CCMZetaCircleLength) (m : ℤ) :
    ccmZetaCircleCriticalPoint
        (ccmZetaCircleCoverLength L ccmZetaCircleTwoCoverDegree)
        ((ccmZetaCircleTwoCoverDegree : ℤ) * m) ≠
      arakelovPowerLift 2 (ccmZetaCircleCriticalPoint L m) := by
  rw [ccmZetaCircleCriticalPoint_cover]
  exact (ccmZetaCircleCriticalPoint_not_fixed_by_arakelovPowerLift_two L m).symm

/-- Rational expression for the square lift, with Lean's total inverse
convention at the pole. -/
theorem arakelovPowerLift_two_eq_rational (rho : ℂ) :
    arakelovPowerLift 2 rho = rho ^ (2 : ℕ) * (2 * rho - 1)⁻¹ := by
  rcases eq_or_ne rho 0 with rfl | hrho
  · simp [arakelovPowerLift, arakelovW]
  · rw [arakelovPowerLift, arakelovW]
    field_simp
    ring

/-- The inverse linear denominator has a genuine pole at the critical-line
point `1/2`. -/
theorem not_continuousAt_inverse_arakelov_square_denominator :
    ¬ ContinuousAt (fun rho : ℂ => (2 * rho - 1)⁻¹) (1 / 2) := by
  intro hcontinuous
  have hchange : ContinuousAt (fun z : ℂ => (z + 1) / 2) 0 := by fun_prop
  have hcomp := hcontinuous.comp_of_eq hchange (by norm_num)
  have hinv : ContinuousAt (fun z : ℂ => z⁻¹) 0 := by
    have heq :
        ((fun rho : ℂ => (2 * rho - 1)⁻¹) ∘ (fun z : ℂ => (z + 1) / 2)) =
          fun z : ℂ => z⁻¹ := by
      funext z
      change (2 * ((z + 1) / 2) - 1)⁻¹ = z⁻¹
      rw [show 2 * ((z + 1) / 2) - 1 = z by ring]
    rw [heq] at hcomp
    exact hcomp
  exact (NormedField.continuousAt_inv.mp hinv) (by norm_num)

/-- The Arakelov square lift is not continuous at its critical-line pole. -/
theorem not_continuousAt_arakelovPowerLift_two :
    ¬ ContinuousAt (arakelovPowerLift 2) (1 / 2) := by
  intro hcontinuous
  have hquotient : ContinuousAt
      (fun rho : ℂ => arakelovPowerLift 2 rho / rho ^ (2 : ℕ)) (1 / 2) := by
    apply hcontinuous.div
    · fun_prop
    · norm_num
  apply not_continuousAt_inverse_arakelov_square_denominator
  apply hquotient.congr_of_eventuallyEq
  filter_upwards [eventually_ne_nhds (show (1 / 2 : ℂ) ≠ 0 by norm_num)] with rho hrho
  rw [arakelovPowerLift_two_eq_rational]
  field_simp

/-- In particular, the Arakelov square lift is not an entire map. -/
theorem not_differentiable_arakelovPowerLift_two :
    ¬ Differentiable ℂ (arakelovPowerLift 2) := by
  intro hdifferentiable
  exact not_continuousAt_arakelovPowerLift_two
    hdifferentiable.continuous.continuousAt

/-- Existence of the requested global source operation, stated before any Xi
zero or quotient fibre is selected. -/
def DeningerEntireArakelovSquarePullbackExists : Prop :=
  ∃ Phi : DeningerEntire →ₐ[ℂ] DeningerEntire,
    ∀ (F : DeningerEntire) (rho : ℂ),
      Phi F rho = F (arakelovPowerLift 2 rho)

/-- **Global source-endomorphism no-go.** The reporter power law cannot extend
to the global entire source algebra. Applying a putative pullback to the
coordinate would make the pole-bearing Arakelov square lift entire. -/
theorem not_deningerEntireArakelovSquarePullbackExists :
    ¬ DeningerEntireArakelovSquarePullbackExists := by
  rintro ⟨Phi, hPhi⟩
  have hdiff : Differentiable ℂ
      ((Phi deningerEntireCoordinate : DeningerEntire) : ℂ → ℂ) :=
    (Phi deningerEntireCoordinate).property
  have heq :
      ((Phi deningerEntireCoordinate : DeningerEntire) : ℂ → ℂ) =
        arakelovPowerLift 2 := by
    funext rho
    simpa using hPhi deningerEntireCoordinate rho
  rw [heq] at hdiff
  exact not_differentiable_arakelovPowerLift_two hdiff

/-- Closed terminal certificate for the full route. It records the positive
Big-Witt reporter law, the global entire-source no-go, incompatibility with
actual zeta covers, source-correct Euler dilation, scaled-receiver identity,
and the two remaining RH-equivalent fixed-receiver conditions. -/
theorem bigWittArakelovCompletedXi_source_endomorphism_terminal :
    (∀ rho : ℂ,
      deningerBigWittFrobeniusTwoRingHom (arakelovBigWittReporter rho) =
        arakelovBigWittReporter (arakelovPowerLift 2 rho)) ∧
    (¬ DeningerEntireArakelovSquarePullbackExists) ∧
    (∀ L : CCMZetaCircleLength, ∀ m : ℤ,
      ccmZetaCircleCriticalPoint
          (ccmZetaCircleCoverLength L ccmZetaCircleTwoCoverDegree)
          ((ccmZetaCircleTwoCoverDegree : ℤ) * m) ≠
        arakelovPowerLift 2 (ccmZetaCircleCriticalPoint L m)) ∧
    (∀ p n j : ℕ,
      normalizedPrimeDerivativeJetCoeff (p ^ n) j =
        (n : ℂ) ^ j * normalizedPrimeDerivativeJetCoeff p j) ∧
    (deningerEntireScaledTwoXiIdeal =
      Ideal.span {deningerEntireHalfPullback deningerEntireXi}) ∧
    (XiRightArakelovPowerStable 2 ↔ RiemannHypothesis) ∧
    (XiArakelovPowerPreperiodic 2 ↔ RiemannHypothesis) := by
  exact ⟨deningerBigWittFrobeniusTwoRingHom_arakelovBigWittReporter,
    not_deningerEntireArakelovSquarePullbackExists,
    ccmZetaCircleCover_not_arakelovPowerLift_two,
    normalizedPrimeDerivativeJetCoeff_primePower,
    deningerEntireScaledTwoXiIdeal_eq_span_halfPullbackXi,
    xiRightArakelovPowerStable_iff_riemannHypothesis (by norm_num),
    xiArakelovPowerPreperiodic_iff_riemannHypothesis (by norm_num)⟩

end

end RHTower
