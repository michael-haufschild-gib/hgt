import GaloisForLFunctions.RHTower.WeightedEulerCoefficientSpaces

/-!
# Ray-norm equivalence for the weighted Euler coefficient tangent

The scalar `b_p` produces the whole prime-power ray `d_b(p^m) = m (log p) b_p`,
and its full `A_{>σ}` ray mass

`∑_{m ≥ 1} m (log p) |b_p| p^{-mσ} = (log p) |b_p| · p^{-σ}/(1-p^{-σ})²`

is two-sidedly comparable to the single-ray weight `(log p) |b_p| p^{-σ}`,
with constants uniform in `p` for each fixed `σ > 0` (`1` from below,
`(1-2^{-σ})^{-2}` from above).  Consequently the prime-power ray topology and
the plain prime-weight topology have the same summable coefficient fields at
every level `σ > 0`; at the critical boundary `σ = 1` this is exactly the
critical summable layer `T_1` of `WeightedEulerCoefficientSpaces`.

Everything is unconditional; the analytic input is the geometric-derivative
series `∑ m r^m = r/(1-r)²`.
-/

noncomputable section

namespace RHTower

open Set

/-- The full `A_{>σ}` mass of the prime-power ray generated by one prime
coefficient: `∑_{m ≥ 1} m (log p) |b_p| p^{-mσ}` (the `m = 0` term vanishes). -/
def primePowerRayMass (p : ℕ) (bp σ : ℝ) : ℝ :=
  ∑' m : ℕ, (m : ℝ) * (Real.log p * |bp|) * ((p : ℝ) ^ (-σ)) ^ m

theorem primePowerRayMass_nonneg (p : ℕ) (bp σ : ℝ) :
    0 ≤ primePowerRayMass p bp σ := by
  refine tsum_nonneg fun m => ?_
  have h1 : 0 ≤ Real.log p * |bp| :=
    mul_nonneg (Real.log_natCast_nonneg p) (abs_nonneg _)
  have h2 : (0:ℝ) ≤ ((p : ℝ) ^ (-σ)) ^ m :=
    pow_nonneg (Real.rpow_nonneg (Nat.cast_nonneg p) _) m
  positivity

section Ratio

variable {p : ℕ} {σ : ℝ}

theorem prime_rpow_neg_pos (hp : 2 ≤ p) (σ : ℝ) : 0 < (p : ℝ) ^ (-σ) :=
  Real.rpow_pos_of_pos (by exact_mod_cast lt_of_lt_of_le two_pos hp) _

theorem prime_rpow_neg_lt_one (hp : 2 ≤ p) (hσ : 0 < σ) :
    (p : ℝ) ^ (-σ) < 1 :=
  Real.rpow_lt_one_of_one_lt_of_neg
    (by exact_mod_cast lt_of_lt_of_le one_lt_two hp) (neg_neg_of_pos hσ)

/-- Ray base monotonicity: `p^{-σ} ≤ 2^{-σ}` for every prime cutoff. -/
theorem prime_rpow_neg_le_two_rpow_neg (hp : 2 ≤ p) (hσ : 0 < σ) :
    (p : ℝ) ^ (-σ) ≤ (2 : ℝ) ^ (-σ) := by
  have hp0 : (0:ℝ) < p := by exact_mod_cast lt_of_lt_of_le two_pos hp
  rw [Real.rpow_neg hp0.le, Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2)]
  rw [inv_le_inv₀ (Real.rpow_pos_of_pos hp0 σ) (Real.rpow_pos_of_pos two_pos σ)]
  exact Real.rpow_le_rpow (by norm_num) (by exact_mod_cast hp) hσ.le

/-- **Closed form of the ray mass**. -/
theorem primePowerRayMass_eq (hp : 2 ≤ p) (hσ : 0 < σ) (bp : ℝ) :
    primePowerRayMass p bp σ
      = Real.log p * |bp| *
          ((p : ℝ) ^ (-σ) / (1 - (p : ℝ) ^ (-σ)) ^ 2) := by
  have hr0 : 0 < (p : ℝ) ^ (-σ) := prime_rpow_neg_pos hp σ
  have hr1 : (p : ℝ) ^ (-σ) < 1 := prime_rpow_neg_lt_one hp hσ
  have hnorm : ‖(p : ℝ) ^ (-σ)‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_pos hr0]; exact hr1
  unfold primePowerRayMass
  calc ∑' m : ℕ, (m : ℝ) * (Real.log p * |bp|) * ((p : ℝ) ^ (-σ)) ^ m
      = ∑' m : ℕ, (Real.log p * |bp|) * ((m : ℝ) * ((p : ℝ) ^ (-σ)) ^ m) :=
        tsum_congr fun m => by ring
    _ = (Real.log p * |bp|) * ∑' m : ℕ, (m : ℝ) * ((p : ℝ) ^ (-σ)) ^ m :=
        tsum_mul_left
    _ = _ := by rw [tsum_coe_mul_geometric_of_norm_lt_one hnorm]

/-- The ray series is summable at every level `σ > 0`. -/
theorem summable_primePowerRay (hp : 2 ≤ p) (hσ : 0 < σ) (bp : ℝ) :
    Summable fun m : ℕ =>
      (m : ℝ) * (Real.log p * |bp|) * ((p : ℝ) ^ (-σ)) ^ m := by
  have hnorm : ‖(p : ℝ) ^ (-σ)‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_pos (prime_rpow_neg_pos hp σ)]
    exact prime_rpow_neg_lt_one hp hσ
  have h := (summable_pow_mul_geometric_of_norm_lt_one 1 hnorm).mul_left
    (Real.log p * |bp|)
  exact h.congr fun m => by simp [pow_one]; ring

/-- **Lower ray comparison** (constant `1`): the single-ray weight bounds the
full ray mass from below. -/
theorem le_primePowerRayMass (hp : 2 ≤ p) (hσ : 0 < σ) (bp : ℝ) :
    Real.log p * |bp| * (p : ℝ) ^ (-σ) ≤ primePowerRayMass p bp σ := by
  rw [primePowerRayMass_eq hp hσ]
  have hr0 : 0 < (p : ℝ) ^ (-σ) := prime_rpow_neg_pos hp σ
  have hr1 : (p : ℝ) ^ (-σ) < 1 := prime_rpow_neg_lt_one hp hσ
  have hd : 0 < (1 - (p : ℝ) ^ (-σ)) ^ 2 := pow_pos (by linarith) 2
  have hkey : (p : ℝ) ^ (-σ) ≤ (p : ℝ) ^ (-σ) / (1 - (p : ℝ) ^ (-σ)) ^ 2 := by
    rw [le_div_iff₀ hd]
    nlinarith [mul_nonneg (mul_nonneg hr0.le hr0.le)
      (show (0:ℝ) ≤ 2 - (p : ℝ) ^ (-σ) by linarith)]
  exact mul_le_mul_of_nonneg_left hkey
    (mul_nonneg (Real.log_natCast_nonneg p) (abs_nonneg _))

/-- **Upper ray comparison** with the `p`-uniform constant `(1-2^{-σ})^{-2}`
(bounded above and below uniformly in `p`). -/
theorem primePowerRayMass_le (hp : 2 ≤ p) (hσ : 0 < σ) (bp : ℝ) :
    primePowerRayMass p bp σ
      ≤ ((1 - (2 : ℝ) ^ (-σ))⁻¹) ^ 2
          * (Real.log p * |bp| * (p : ℝ) ^ (-σ)) := by
  rw [primePowerRayMass_eq hp hσ]
  have hr0 : 0 < (p : ℝ) ^ (-σ) := prime_rpow_neg_pos hp σ
  have hs1 : (2 : ℝ) ^ (-σ) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg one_lt_two (neg_neg_of_pos hσ)
  have hrs : (p : ℝ) ^ (-σ) ≤ (2 : ℝ) ^ (-σ) :=
    prime_rpow_neg_le_two_rpow_neg hp hσ
  have hds : 0 < (1 - (2 : ℝ) ^ (-σ)) ^ 2 := pow_pos (by linarith) 2
  have hmono : (1 - (2 : ℝ) ^ (-σ)) ^ 2 ≤ (1 - (p : ℝ) ^ (-σ)) ^ 2 :=
    pow_le_pow_left₀ (by linarith) (by linarith) 2
  have hdiv : (p : ℝ) ^ (-σ) / (1 - (p : ℝ) ^ (-σ)) ^ 2
      ≤ (p : ℝ) ^ (-σ) / (1 - (2 : ℝ) ^ (-σ)) ^ 2 :=
    div_le_div_of_nonneg_left hr0.le hds hmono
  calc Real.log p * |bp| * ((p : ℝ) ^ (-σ) / (1 - (p : ℝ) ^ (-σ)) ^ 2)
      ≤ Real.log p * |bp| * ((p : ℝ) ^ (-σ) / (1 - (2 : ℝ) ^ (-σ)) ^ 2) :=
        mul_le_mul_of_nonneg_left hdiv
          (mul_nonneg (Real.log_natCast_nonneg p) (abs_nonneg _))
    _ = ((1 - (2 : ℝ) ^ (-σ))⁻¹) ^ 2
          * (Real.log p * |bp| * (p : ℝ) ^ (-σ)) := by
        rw [div_eq_mul_inv, ← inv_pow]; ring

end Ratio

/-! ## Topological equivalence of the ray and single-weight topologies -/

/-- **Ray-norm equivalence**: at every level `σ > 0`, a
coefficient field has summable prime-power ray masses iff it has summable
single prime weights.  The constants are uniform in the prime. -/
theorem summable_indicator_primePowerRayMass_iff {σ : ℝ} (hσ : 0 < σ)
    (b : ℕ → ℝ) :
    Summable ({p : ℕ | p.Prime}.indicator fun p => primePowerRayMass p (b p) σ)
      ↔ Summable ({p : ℕ | p.Prime}.indicator
          fun p => Real.log p * |b p| * (p : ℝ) ^ (-σ)) := by
  constructor
  · intro h
    refine Summable.of_nonneg_of_le
      (fun p => Set.indicator_nonneg (fun q _ => ?_) p) (fun p => ?_) h
    · exact mul_nonneg
        (mul_nonneg (Real.log_natCast_nonneg q) (abs_nonneg _))
        (Real.rpow_nonneg (Nat.cast_nonneg q) _)
    · by_cases hp : p.Prime
      · rw [Set.indicator_of_mem (show p ∈ {q : ℕ | q.Prime} from hp),
          Set.indicator_of_mem (show p ∈ {q : ℕ | q.Prime} from hp)]
        exact le_primePowerRayMass hp.two_le hσ (b p)
      · rw [Set.indicator_of_notMem (show p ∉ {q : ℕ | q.Prime} from hp),
          Set.indicator_of_notMem (show p ∉ {q : ℕ | q.Prime} from hp)]
  · intro h
    refine Summable.of_nonneg_of_le
      (fun p => Set.indicator_nonneg
        (fun q _ => primePowerRayMass_nonneg q (b q) σ) p)
      (fun p => ?_) (h.mul_left (((1 - (2 : ℝ) ^ (-σ))⁻¹) ^ 2))
    by_cases hp : p.Prime
    · rw [Set.indicator_of_mem (show p ∈ {q : ℕ | q.Prime} from hp),
        Set.indicator_of_mem (show p ∈ {q : ℕ | q.Prime} from hp)]
      exact primePowerRayMass_le hp.two_le hσ (b p)
    · rw [Set.indicator_of_notMem (show p ∉ {q : ℕ | q.Prime} from hp),
        Set.indicator_of_notMem (show p ∉ {q : ℕ | q.Prime} from hp)]
      simp

/-- **Critical boundary connector**: at `σ = 1` the ray topology recognises
exactly the critical summable layer `T_1` of the coefficient-space module. -/
theorem summable_indicator_primePowerRayMass_one_iff_memCriticalSummableLayer
    (b : ℕ → ℝ) :
    Summable ({p : ℕ | p.Prime}.indicator fun p => primePowerRayMass p (b p) 1)
      ↔ MemCriticalSummableLayer b := by
  rw [summable_indicator_primePowerRayMass_iff one_pos b]
  unfold MemCriticalSummableLayer
  have heq : ({p : ℕ | p.Prime}.indicator
      fun p => Real.log p * |b p| * (p : ℝ) ^ (-(1:ℝ)))
      = {p : ℕ | p.Prime}.indicator fun n => Real.log n / n * |b n| := by
    apply Set.indicator_congr
    intro n _
    simp only [Real.rpow_neg_one]
    ring
  rw [heq]

end RHTower
