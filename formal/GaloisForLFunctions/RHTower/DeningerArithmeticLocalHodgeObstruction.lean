import GaloisForLFunctions.RHTower.DeningerArithmeticTopologicalJetDual

/-!
# Local Hodge forms and the exact Frobenius obstruction

Every zeroth Xi jet on compact-open source cohomology produces a canonical positive semidefinite
rank-one Hodge form

`star_rho(x)(y) = conj(jet_rho(x)) * jet_rho(y)`.

This construction is source-local and unconditional.  Its Frobenius commutator is exactly

`(1 - lambda_rho - conj(lambda_rho)) star_rho(x)`,

where `lambda_rho = 1/2 + I * rho` is the source Frobenius eigenvalue.  Consequently the local
positive form commutes with Frobenius exactly when the centered Xi point is real.  Thus positivity
itself is easy locally; arithmetic purity is precisely the vanishing of this explicit commutator.

The result isolates the missing global Hodge theorem without postulating RH or defining middle
cohomology from a Hilbert space of zeros.
-/

open Complex

namespace RHTower

noncomputable section

/--
Canonical rank-one conjugate-linear Hodge form generated by the zeroth continuous jet at `rho`.
-/
def deningerCompactOpenLocalJetHodge
    (rho : XiDivisorSupport) :
    DeningerArithmeticCompactOpenH1 →L⋆[ℂ]
      DeningerArithmeticTopologicalH1Compact where
  toFun x :=
    (starRingEnd ℂ
      (deningerCompactOpenH1Jet rho
        (deningerArithmeticJetIndexZero rho) x)) •
      deningerCompactOpenH1Jet rho
        (deningerArithmeticJetIndexZero rho)
  map_add' x y := by
    ext z
    simp [map_add, add_mul]
  map_smul' c x := by
    ext z
    simp [map_smul, mul_assoc]
  cont := by
    fun_prop

@[simp]
theorem deningerCompactOpenLocalJetHodge_apply
    (rho : XiDivisorSupport)
    (x y : DeningerArithmeticCompactOpenH1) :
    deningerCompactOpenLocalJetHodge rho x y =
      starRingEnd ℂ
        (deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) x) *
        deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) y := by
  simp [deningerCompactOpenLocalJetHodge]

/-- Zeroth local jets diagonalize source Frobenius with the expected Xi weight. -/
theorem deningerCompactOpenH1Jet_zero_theta
    (rho : XiDivisorSupport)
    (x : DeningerArithmeticCompactOpenH1) :
    deningerCompactOpenH1Jet rho
        (deningerArithmeticJetIndexZero rho)
        (deningerCompactOpenTheta x) =
      (1 / 2 + Complex.I * xiSpectralPointSupport rho) *
        deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) x := by
  obtain ⟨F, rfl⟩ := Quotient.exists_rep x
  change
    deningerCompactOpenH1Jet rho
        (deningerArithmeticJetIndexZero rho)
        (deningerCompactOpenTheta
          (deningerArithmeticCompactOpenH1Class F)) =
      (1 / 2 + Complex.I * xiSpectralPointSupport rho) *
        deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho)
          (deningerArithmeticCompactOpenH1Class F)
  rw [deningerCompactOpenTheta_class,
    deningerCompactOpenH1Jet_class,
    deningerCompactOpenH1Jet_class]
  simp only [deningerArithmeticJetIndexZero,
    deningerCompactOpenJet_apply, iteratedDeriv_zero,
    deningerCompactOpenThetaMul_apply]

/-- The local Hodge diagonal is exactly the squared norm of the zeroth jet. -/
theorem deningerCompactOpenLocalJetHodge_self_re
    (rho : XiDivisorSupport)
    (x : DeningerArithmeticCompactOpenH1) :
    (deningerCompactOpenLocalJetHodge rho x x).re =
      Complex.normSq
        (deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) x) := by
  rw [deningerCompactOpenLocalJetHodge_apply,
    ← Complex.normSq_eq_conj_mul_self]
  rfl

/-- Every local rank-one Hodge form is positive semidefinite unconditionally. -/
theorem deningerCompactOpenLocalJetHodge_self_nonnegative
    (rho : XiDivisorSupport)
    (x : DeningerArithmeticCompactOpenH1) :
    0 ≤ (deningerCompactOpenLocalJetHodge rho x x).re := by
  rw [deningerCompactOpenLocalJetHodge_self_re]
  exact Complex.normSq_nonneg _

/-- Strict local positivity is exactly detection by the corresponding zeroth jet. -/
theorem deningerCompactOpenLocalJetHodge_self_positive_iff
    (rho : XiDivisorSupport)
    (x : DeningerArithmeticCompactOpenH1) :
    0 < (deningerCompactOpenLocalJetHodge rho x x).re ↔
      deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) x ≠ 0 := by
  rw [deningerCompactOpenLocalJetHodge_self_re, Complex.normSq_pos]

/-- Finite source interpolation ensures every local rank-one Hodge form is nonzero. -/
theorem deningerCompactOpenLocalJetHodge_ne_zero
    (rho : XiDivisorSupport) :
    deningerCompactOpenLocalJetHodge rho ≠ 0 := by
  have hj :
      deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) ≠ 0 :=
    deningerCompactOpenH1Jet_ne_zero rho
      (deningerArithmeticJetIndexZero rho)
  obtain ⟨x, hx⟩ :
      ∃ x,
        deningerCompactOpenH1Jet rho
          (deningerArithmeticJetIndexZero rho) x ≠ 0 := by
    by_contra hall
    apply hj
    ext y
    have hy :=
      not_ne_iff.mp
        (not_exists.mp hall y)
    simpa using hy
  intro hzero
  have heval :=
    congrArg
      (fun star :
          DeningerArithmeticCompactOpenH1 →L⋆[ℂ]
            DeningerArithmeticTopologicalH1Compact =>
        star x x)
      hzero
  have hpos :=
    (deningerCompactOpenLocalJetHodge_self_positive_iff rho x).2 hx
  change deningerCompactOpenLocalJetHodge rho x x = 0 at heval
  rw [heval] at hpos
  simp at hpos

/--
Exact local Hodge obstruction: the commutator is the weight-one purity defect times the local
positive form.
-/
theorem deningerCompactOpenLocalJetHodge_theta_defect
    (rho : XiDivisorSupport)
    (x : DeningerArithmeticCompactOpenH1) :
    deningerCompactOpenThetaCompact
          (deningerCompactOpenLocalJetHodge rho x) -
        deningerCompactOpenLocalJetHodge rho
          (deningerCompactOpenTheta x) =
      (1 -
        (1 / 2 + Complex.I * xiSpectralPointSupport rho) -
        starRingEnd ℂ
          (1 / 2 + Complex.I * xiSpectralPointSupport rho)) •
        deningerCompactOpenLocalJetHodge rho x := by
  apply ContinuousLinearMap.ext
  intro y
  rw [ContinuousLinearMap.sub_apply,
    deningerCompactOpenThetaCompact_apply,
    deningerCompactOpenLocalJetHodge_apply,
    deningerCompactOpenLocalJetHodge_apply,
    deningerCompactOpenLocalJetHodge_apply,
    ContinuousLinearMap.smul_apply,
    deningerCompactOpenH1Jet_zero_theta rho x,
    deningerCompactOpenH1Jet_zero_theta rho y]
  simp only [map_mul, deningerCompactOpenLocalJetHodge_apply]
  ring

/--
The canonical local positive form commutes with Frobenius exactly at a real centered Xi point.
-/
theorem deningerCompactOpenLocalJetHodge_theta_commutes_iff
    (rho : XiDivisorSupport) :
    (∀ x : DeningerArithmeticCompactOpenH1,
      deningerCompactOpenThetaCompact
          (deningerCompactOpenLocalJetHodge rho x) =
        deningerCompactOpenLocalJetHodge rho
          (deningerCompactOpenTheta x)) ↔
      (xiSpectralPointSupport rho).im = 0 := by
  constructor
  · intro hcomm
    have hdefect :=
      deningerCompactOpenLocalJetHodge_theta_defect rho
    obtain ⟨x, hx⟩ :
        ∃ x : DeningerArithmeticCompactOpenH1,
          deningerCompactOpenLocalJetHodge rho x ≠ 0 := by
      by_contra hall
      apply deningerCompactOpenLocalJetHodge_ne_zero rho
      apply ContinuousLinearMap.ext
      intro y
      exact not_ne_iff.mp (not_exists.mp hall y)
    have hscalar :
        (1 -
          (1 / 2 + Complex.I * xiSpectralPointSupport rho) -
          starRingEnd ℂ
            (1 / 2 + Complex.I * xiSpectralPointSupport rho)) •
            deningerCompactOpenLocalJetHodge rho x = 0 := by
      rw [← hdefect x, hcomm x, sub_self]
    have hc :
        1 -
          (1 / 2 + Complex.I * xiSpectralPointSupport rho) -
          starRingEnd ℂ
            (1 / 2 + Complex.I * xiSpectralPointSupport rho) = 0 := by
      exact (smul_eq_zero.mp hscalar).resolve_right hx
    have hre := congrArg Complex.re hc
    norm_num [Complex.mul_re] at hre
    linarith
  · intro him x
    have hdefect :=
      deningerCompactOpenLocalJetHodge_theta_defect rho x
    have hc :
        1 -
          (1 / 2 + Complex.I * xiSpectralPointSupport rho) -
          starRingEnd ℂ
            (1 / 2 + Complex.I * xiSpectralPointSupport rho) = 0 := by
      apply Complex.ext
      · norm_num [Complex.mul_re, him]
      · norm_num [Complex.mul_im, him]
    rw [hc] at hdefect
    have hz :
        (0 : ℂ) • deningerCompactOpenLocalJetHodge rho x = 0 := by
      apply ContinuousLinearMap.ext
      intro y
      simp
    rw [hz] at hdefect
    exact sub_eq_zero.mp hdefect

/--
Global Frobenius invariance of all canonical local positive Hodge forms implies RH.

This is an unconditional implication: invariance is not assumed or installed as an instance.
-/
theorem riemannHypothesis_of_deningerCompactOpenLocalJetHodge_theta_commutes
    (hcomm :
      ∀ (rho : XiDivisorSupport)
        (x : DeningerArithmeticCompactOpenH1),
        deningerCompactOpenThetaCompact
            (deningerCompactOpenLocalJetHodge rho x) =
          deningerCompactOpenLocalJetHodge rho
            (deningerCompactOpenTheta x)) :
    RiemannHypothesis := by
  apply riemannHypothesis_of_xiSpectralPoint_real
  intro q
  have him :
      (xiSpectralPointSupport q.1).im = 0 :=
    (deningerCompactOpenLocalJetHodge_theta_commutes_iff q.1).1
      (hcomm q.1)
  refine ⟨(xiSpectralPoint q).re, ?_⟩
  apply Complex.ext
  · simp
  · rw [xiSpectralPoint_eq_support]
    simpa using him

end

end RHTower
