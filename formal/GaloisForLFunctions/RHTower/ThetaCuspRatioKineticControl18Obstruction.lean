  have hp := control18NegativeWindow_pos (40*(h-1/10)) (by linarith) (by linarith)
  unfold control18NegativeWindow at hp
  have he : (1/10:ℝ)+(40*(h-1/10))/40=h := by ring
  rw [he] at hp
  rw [control18_defect_factor]
  exact mul_neg_of_pos_of_neg (pow_pos (by linarith) 4) (neg_pos.mp hp)

theorem control18_obstruction_positive_drift (h : ℝ)
    (hh0 : 1/10 ≤ h) (hh1 : h ≤ 1/8) :
    0 < 9-(361/25)*h^2 := by
