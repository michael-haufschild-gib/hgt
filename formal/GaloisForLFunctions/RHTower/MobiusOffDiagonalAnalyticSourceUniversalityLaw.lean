import GaloisForLFunctions.RHTower.MobiusAdditiveTriangleChowlaFrontier
import GaloisForLFunctions.RHTower.MobiusAdditiveTrianglePolylogUniversalityLaw
import GaloisForLFunctions.RHTower.MobiusAdditiveTriangleSourceUniversalityLaw
import GaloisForLFunctions.RHTower.MobiusAdditiveTriangleSubpowerMultiplicityUniversalityLaw

/-!
# Off-diagonal Möbius analytic-source universality

The binary-Chowla frontier reduces a strict off-diagonal correlation bound to the additive
Möbius triangle.  Separate terminal modules then extract a retained half-polylog source and a
full open-half-plane Mellin continuation phase.  This file closes those outputs under the same
off-diagonal hypothesis and retains the degree-zero simplicity strengthening.
-/

namespace RHTower

noncomputable section

/-- Joint retained-source and open-half-plane analytic certificate generated by one degree-`q`
strict off-diagonal Möbius bound. -/
def MobiusOffDiagonalPolylogAnalyticSourceUniversalCertificate
    (q : ℕ) (C delta : ℝ) : Prop :=
  MobiusAdditiveTrianglePolylogSourceUniversalCertificate q C delta ∧
  MobiusAdditiveTriangleSubpowerMultiplicityUniversalCertificate q

/-- **Off-diagonal Möbius analytic-source universality law.**  A one-sided degree-`2q`
polylogarithmic bound on only the strict off-diagonal additive Möbius pairs simultaneously gives
one retained degree-`q` Laplace source, RH, the full reciprocal-square source phase, the sharp
critical-line multiplicity and maximal-order coefficient caps, every strict half-power decay,
analytic Mellin continuation throughout the right half-plane, and the exact continuation wall. -/
theorem mobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound_implies_analyticSourceCertificate
    {q : ℕ} (hoff : MobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound q) :
    ∃ C delta : ℝ,
      MobiusOffDiagonalPolylogAnalyticSourceUniversalCertificate q C delta := by
  have htriangle : MobiusAdditiveTriangleLinearPolylogUpperBound q :=
    mobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound_implies_triangleLinearPolylogUpperBound
      hoff
  obtain ⟨C, delta, hsource⟩ :=
    mobiusAdditiveTriangleLinearPolylogUpperBound_implies_sourceUniversalCertificate
      q htriangle
  exact ⟨C, delta, hsource,
    mobiusAdditiveTriangleLinearPolylogUpperBound_implies_subpowerMultiplicityCertificate
      htriangle⟩

/-- At degree zero the same strict off-diagonal input also forces the complete Hedenmalm
RH--simplicity phase and the sharp simple-zero local coefficient law. -/
theorem mobiusAdditiveStrictOffDiagonalLinearUpperBound_implies_simplicityAnalyticSource
    (hoff : MobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound 0) :
    (∃ C delta : ℝ, MobiusAdditiveTriangleSourceUniversalCertificate C delta) ∧
      (∃ C delta : ℝ,
        MobiusOffDiagonalPolylogAnalyticSourceUniversalCertificate 0 C delta) := by
  have htrianglePolylog : MobiusAdditiveTriangleLinearPolylogUpperBound 0 :=
    mobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound_implies_triangleLinearPolylogUpperBound
      hoff
  have htriangle : MobiusAdditiveTriangleLinearUpperBound := by
    obtain ⟨C, hC, hbound⟩ := htrianglePolylog
    refine ⟨C, hC, ?_⟩
    intro N
    simpa using hbound N
  exact ⟨
    mobiusAdditiveTriangleLinearUpperBound_implies_sourceUniversalCertificate htriangle,
    mobiusAdditiveStrictOffDiagonalLinearPolylogUpperBound_implies_analyticSourceCertificate
      hoff⟩

end

end RHTower
