import GaloisForLFunctions.RHTower.DeningerArithmeticSourceGreen
import GaloisForLFunctions.RHTower.DeningerCalderonWittSingularGammaTransgression
import Mathlib.Analysis.InnerProductSpace.Completion

/-!
# Completed Xi Green vectors in Calderón--Witt incidence completion

The finite Calderón--Witt comparison has an algebraic Milnor-incidence
domain, whereas the completed Deninger comparison model has the Hilbert
carrier `XiDivisorL2`.  This module constructs the missing typed bridge.

Fix distinct source primes `p,q`.  A finite Xi-jet family `a` is realized
as the divisor-labelled incidence profile

`r ↦ a(r) • w_{p,q}`,

where `w_{p,q}` is the actual nonzero cross-prime Calderón--Witt incidence
witness.  Pulling the Xi `ℓ²` norm and inner product back along this
coefficient-faithful realization gives a pre-Hilbert source.  Its abstract
Hilbert completion is canonically isometrically equivalent to the completed
Xi carrier.  Consequently every completed Xi vector, and in particular
every completed source Green vector, has a unique coefficient-faithful
image in an honest completion generated by actual incidence relations.

On finite compact-support jets the completed map is exactly the oriented
Calderón--Witt Green reflection.  The existing unconditional
ordinary/compact Frobenius intertwining therefore survives the comparison.

This construction does not assert Gamma/Hardy defect-kernel landing.  It
creates the completed incidence carrier and Green comparison on which that
separate RH-bearing statement can now be formulated without postulating a
map.
-/

namespace RHTower

noncomputable section

/-! ## Algebraic divisor-labelled incidence line -/

/--
Finite divisor-labelled coefficients on the normalized cross-prime
Calderón--Witt incidence line.  The parameters record which actual source
incidence witness the coefficients multiply.
-/
def DeningerCalderonWittCrossPrimeXiIncidenceTest
    (p q : Nat.Primes) (_hpq : p ≠ q) :=
  DeningerArithmeticJetTest
  deriving AddCommGroup, Module ℂ

/-- Coefficient identification with the finite Xi-jet source. -/
def deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq ≃ₗ[ℂ]
      DeningerArithmeticJetTest :=
  LinearEquiv.refl ℂ DeningerArithmeticJetTest

/--
The actual Milnor-incidence relation carried by one divisor coordinate of
an algebraic incidence test.
-/
def deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    (r : XiZeroCopy) :
    deningerCalderonWittGlobalMilnorIncidence :=
  (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv p q hpq a) r •
    deningerCalderonWittCrossPrimeGammaWitness hpq

/-- The canonical cross-prime source incidence witness is nonzero. -/
theorem deningerCalderonWittCrossPrimeGammaWitness_ne_zero
    (p q : Nat.Primes) (hpq : p ≠ q) :
    deningerCalderonWittCrossPrimeGammaWitness hpq ≠ 0 := by
  intro hzero
  have hne :=
    deningerCalderonWittGammaModularScalarTransport_crossPrimeWitness_ne_zero
      hpq 0 0
  apply hne
  rw [hzero, map_zero]
  rfl

/--
Source-native normalized coefficient of an actual Milnor incidence.
Evaluation uses the already constructed Gamma transport at zero modular
displacement and one fixed source depth; division by its nonzero canonical
witness value normalizes `w_{p,q}` to one.
-/
def deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate
    (p q : Nat.Primes) (_hpq : p ≠ q) :
    deningerCalderonWittGlobalMilnorIncidence →ₗ[ℂ] ℂ where
  toFun s :=
    ((xiGammaEulerPrimitiveModularExterior
      0 (p, 0) (q, 0) : ℝ) : ℂ)⁻¹ *
      deningerCalderonWittGammaModularScalarTransport
        0 s p q 0 0
  map_add' s t := by
    simp
    ring
  map_smul' c s := by
    simp
    ring

@[simp]
theorem
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate_witness
    (p q : Nat.Primes) (hpq : p ≠ q) :
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate
        p q hpq
        (deningerCalderonWittCrossPrimeGammaWitness hpq) = 1 := by
  change
    ((xiGammaEulerPrimitiveModularExterior
      0 (p, 0) (q, 0) : ℝ) : ℂ)⁻¹ *
      deningerCalderonWittGammaModularScalarTransport
        0 (deningerCalderonWittCrossPrimeGammaWitness hpq)
          p q 0 0 = 1
  rw [deningerCalderonWittGammaModularScalarTransport_crossPrimeWitness]
  have hne :
      ((xiGammaEulerPrimitiveModularExterior
        0 (p, 0) (q, 0) : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr
      (xiGammaEulerPrimitiveModularExterior_ne_zero_sameDepth
        hpq 0 0)
  exact inv_mul_cancel₀ hne

/--
The coefficient stored in an algebraic incidence test is exactly recovered
from its actual Gamma-oriented Calderón--Witt source value.
-/
@[simp]
theorem
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate_sourceValue
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate p q hpq
        (deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue
          p q hpq a r) =
      (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
        p q hpq a) r := by
  rw [deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue,
    map_smul,
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate_witness]
  simp

/--
Actual incidence values retain every algebraic Xi coefficient.  No
divisor coordinate can disappear in the source witness line.
-/
theorem deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue_eq_zero_iff
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue
        p q hpq a r = 0 ↔
      (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
        p q hpq a) r = 0 := by
  simp [deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue,
    deningerCalderonWittCrossPrimeGammaWitness_ne_zero p q hpq]

/-! ## Induced pre-Hilbert structure and completion -/

/-- Coefficient-faithful algebraic realization in the canonical jet Hilbert carrier. -/
def deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq →ₗ[ℂ]
      DeningerArithmeticJetHilbert :=
  deningerArithmeticJetTestToHilbert.comp
    (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
      p q hpq).toLinearMap

/--
Every Hilbert coordinate is the normalized Gamma orientation of the
corresponding actual Calderón--Witt incidence value.  Thus the completed
norm is source-readable, not a coordinate name-change.
-/
theorem deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_apply
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
        p q hpq a r =
      deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate
        p q hpq
        (deningerCalderonWittCrossPrimeXiIncidenceTestSourceValue
          p q hpq a r) := by
  change
    deningerArithmeticJetTestToHilbert
        (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
          p q hpq a) r = _
  rw [deningerArithmeticJetTestToHilbert_apply,
    deningerCalderonWittCrossPrimeNormalizedIncidenceCoordinate_sourceValue]

theorem deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_injective
    (p q : Nat.Primes) (hpq : p ≠ q) :
    Function.Injective
      (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
        p q hpq) := by
  intro a b hab
  apply
    (deningerCalderonWittCrossPrimeXiIncidenceTestEquiv
      p q hpq).injective
  ext r
  have h := congrFun (congrArg Subtype.val hab) r
  simpa [deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert] using h

/-- `ℓ²` norm pulled back from the completed Xi/jet carrier. -/
noncomputable instance
    deningerCalderonWittCrossPrimeXiIncidenceTestNormedAddCommGroup
    (p q : Nat.Primes) (hpq : p ≠ q) :
    NormedAddCommGroup
      (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq) :=
  NormedAddCommGroup.induced
    (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    DeningerArithmeticJetHilbert
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
      p q hpq)
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_injective
      p q hpq)

noncomputable instance
    deningerCalderonWittCrossPrimeXiIncidenceTestNormedSpace
    (p q : Nat.Primes) (hpq : p ≠ q) :
    NormedSpace ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq) :=
  NormedSpace.induced
    ℂ
    (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)
    DeningerArithmeticJetHilbert
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
      p q hpq)

noncomputable instance
    deningerCalderonWittCrossPrimeXiIncidenceTestInnerProductSpace
    (p q : Nat.Primes) (hpq : p ≠ q) :
    InnerProductSpace ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq) :=
  InnerProductSpace.induced
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
      p q hpq)

/-- Algebraic incidence realization as a linear isometry. -/
def deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq →ₗᵢ[ℂ]
      DeningerArithmeticJetHilbert where
  __ :=
    deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
      p q hpq
  norm_map' _ := rfl

/--
Hilbert completion generated by finite divisor-labelled copies of one
actual nonzero cross-prime Calderón--Witt incidence relation.
-/
abbrev DeningerCalderonWittCrossPrimeXiIncidenceCompletion
    (p q : Nat.Primes) (hpq : p ≠ q) :=
  UniformSpace.Completion
    (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq)

theorem deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_dense
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DenseRange
      (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
        p q hpq) := by
  change DenseRange deningerArithmeticJetTestToHilbert
  exact deningerArithmeticJetTestToHilbert_dense

private theorem deningerCalderonWittCrossPrimeXiIncidenceCompletionDenseNorm
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq) :
    ‖deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
        p q hpq a‖ =
      ‖(UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E :=
          DeningerCalderonWittCrossPrimeXiIncidenceTest
            p q hpq)).toLinearMap a‖ := by
  calc
    ‖deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
          p q hpq a‖ =
        ‖a‖ :=
      (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
        p q hpq).norm_map a
    _ =
        ‖(UniformSpace.Completion.toComplₗᵢ
          (𝕜 := ℂ)
          (E :=
            DeningerCalderonWittCrossPrimeXiIncidenceTest
              p q hpq)).toLinearMap a‖ :=
      ((UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E :=
          DeningerCalderonWittCrossPrimeXiIncidenceTest
            p q hpq)).norm_map a).symm

/--
Canonical isometric equivalence from completed incidence profiles to the
completed Xi/jet Hilbert carrier.
-/
def deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq ≃ₗᵢ[ℂ]
      DeningerArithmeticJetHilbert :=
  LinearEquiv.extendOfIsometry
    (LinearEquiv.refl ℂ
      (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq))
    (UniformSpace.Completion.toComplₗᵢ
      (𝕜 := ℂ)
      (E :=
        DeningerCalderonWittCrossPrimeXiIncidenceTest
          p q hpq)).toLinearMap
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
      p q hpq).toLinearMap
    UniformSpace.Completion.denseRange_coe
    (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_dense
      p q hpq)
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionDenseNorm
      p q hpq)

@[simp]
theorem
    deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert_coe
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq) :
    deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
        p q hpq
        (a :
          DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) =
      deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
        p q hpq a := by
  exact
    LinearEquiv.extendOfIsometry_eq
      (LinearEquiv.refl ℂ
        (DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq))
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E :=
          DeningerCalderonWittCrossPrimeXiIncidenceTest
            p q hpq)).toLinearMap
      (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbertIsometry
        p q hpq).toLinearMap
      UniformSpace.Completion.denseRange_coe
      (deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert_dense
        p q hpq)
      (deningerCalderonWittCrossPrimeXiIncidenceCompletionDenseNorm
        p q hpq)
      a

/-! ## Completed Xi and Green comparison -/

/--
Coefficient-faithful isometric identification of every completed Xi vector
with its Calderón--Witt cross-prime incidence completion.
-/
def deningerCompletedXiToCrossPrimeIncidenceCompletion
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerArithmeticCompletedH1 ≃ₗᵢ[ℂ]
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq :=
  (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
    p q hpq).symm

/-- Algebraic Xi jets as finite incidence-completion tests. -/
def deningerCalderonWittCrossPrimeXiIncidenceTestOfJet
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerArithmeticJetTest ≃ₗ[ℂ]
      DeningerCalderonWittCrossPrimeXiIncidenceTest p q hpq :=
  LinearEquiv.refl ℂ DeningerArithmeticJetTest

@[simp]
theorem deningerCompletedXiToCrossPrimeIncidenceCompletion_test
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerArithmeticJetTest) :
    deningerCompletedXiToCrossPrimeIncidenceCompletion p q hpq
        (deningerArithmeticJetTestToHilbert a) =
      (deningerCalderonWittCrossPrimeXiIncidenceTestOfJet
          p q hpq a :
        DeningerCalderonWittCrossPrimeXiIncidenceCompletion
          p q hpq) := by
  apply
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
      p q hpq).injective
  rw [
    deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert_coe]
  calc
    deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
          p q hpq
          (deningerCompletedXiToCrossPrimeIncidenceCompletion
            p q hpq
            (deningerArithmeticJetTestToHilbert a)) =
        deningerArithmeticJetTestToHilbert a :=
      (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
        p q hpq).apply_symm_apply _
    _ =
        deningerCalderonWittCrossPrimeXiIncidenceTestToJetHilbert
          p q hpq
          (deningerCalderonWittCrossPrimeXiIncidenceTestOfJet
            p q hpq a) := by
      rfl

/--
Continuous completed Green comparison.  This is the requested map from
the completed Xi Green vector into Calderón--Witt incidence completion.
-/
def deningerArithmeticCompletedGreenToCrossPrimeIncidence
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DeningerArithmeticTopologicalH1Compact →L[ℂ]
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq :=
  (deningerCompletedXiToCrossPrimeIncidenceCompletion
      p q hpq).toLinearIsometry.toContinuousLinearMap.comp
    deningerArithmeticSourceGreen

@[simp]
theorem deningerArithmeticCompletedGreenToCrossPrimeIncidence_apply
    (p q : Nat.Primes) (hpq : p ≠ q)
    (ell : DeningerArithmeticTopologicalH1Compact) :
    deningerArithmeticCompletedGreenToCrossPrimeIncidence p q hpq ell =
      deningerCompletedXiToCrossPrimeIncidenceCompletion p q hpq
        (deningerArithmeticSourceGreen ell) := by
  simp [deningerArithmeticCompletedGreenToCrossPrimeIncidence]

/--
The completed comparison preserves the entire Xi Green norm.  Hence it is
not a quotient, scalar trace, or coordinate-forgetting landing map.
-/
theorem norm_deningerArithmeticCompletedGreenToCrossPrimeIncidence
    (p q : Nat.Primes) (hpq : p ≠ q)
    (ell : DeningerArithmeticTopologicalH1Compact) :
    ‖deningerArithmeticCompletedGreenToCrossPrimeIncidence p q hpq ell‖ =
      ‖deningerArithmeticSourceGreen ell‖ := by
  rw [deningerArithmeticCompletedGreenToCrossPrimeIncidence_apply]
  exact
    (deningerCompletedXiToCrossPrimeIncidenceCompletion
      p q hpq).norm_map _

/--
On finite source jets the completed bridge is exactly the already
constructed oriented Green reflection, not an unrelated Hilbert copy.
-/
@[simp]
theorem deningerArithmeticCompletedGreenToCrossPrimeIncidence_test
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerArithmeticJetTest) :
    deningerArithmeticCompletedGreenToCrossPrimeIncidence p q hpq
        (deningerArithmeticJetTestToCompact a) =
      (deningerCalderonWittCrossPrimeXiIncidenceTestOfJet p q hpq
          (deningerArithmeticOrientedGreenJetTest a) :
        DeningerCalderonWittCrossPrimeXiIncidenceCompletion
          p q hpq) := by
  rw [deningerArithmeticCompletedGreenToCrossPrimeIncidence_apply,
    deningerArithmeticSourceGreen_test,
    deningerCompletedXiToCrossPrimeIncidenceCompletion_test]

theorem deningerArithmeticCompletedGreenToCrossPrimeIncidence_dense
    (p q : Nat.Primes) (hpq : p ≠ q) :
    DenseRange
      (deningerArithmeticCompletedGreenToCrossPrimeIncidence
        p q hpq) := by
  have hcomp :
      DenseRange
        (deningerCompletedXiToCrossPrimeIncidenceCompletion p q hpq ∘
          deningerArithmeticSourceGreen) :=
    DenseRange.comp
      (deningerCompletedXiToCrossPrimeIncidenceCompletion
        p q hpq).surjective.denseRange
      deningerArithmeticSourceGreen_dense
      (deningerCompletedXiToCrossPrimeIncidenceCompletion
        p q hpq).toLinearIsometry.continuous
  have hfun :
      (deningerArithmeticCompletedGreenToCrossPrimeIncidence
        p q hpq :
        DeningerArithmeticTopologicalH1Compact →
          DeningerCalderonWittCrossPrimeXiIncidenceCompletion
            p q hpq) =
        deningerCompletedXiToCrossPrimeIncidenceCompletion p q hpq ∘
          deningerArithmeticSourceGreen := by
    funext ell
    exact
      deningerArithmeticCompletedGreenToCrossPrimeIncidence_apply
        p q hpq ell
  rw [hfun]
  exact hcomp

/-! ## Actual completed incidence coordinates -/

/-- Continuous coefficient evaluation on the completed incidence source. -/
def deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) :
    DeningerCalderonWittCrossPrimeXiIncidenceCompletion
        p q hpq →L[ℂ] ℂ :=
  (lp.evalCLM ℂ
      (fun _ : DeningerArithmeticJetCoordinate => ℂ) 2 r).comp
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
      p q hpq).toLinearIsometry.toContinuousLinearMap

/--
Every completed coefficient decodes to an actual algebraic
Calderón--Witt Milnor-incidence relation.
-/
def deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue
    (p q : Nat.Primes) (hpq : p ≠ q)
    (r : XiZeroCopy) :
    DeningerCalderonWittCrossPrimeXiIncidenceCompletion
        p q hpq →ₗ[ℂ]
      deningerCalderonWittGlobalMilnorIncidence :=
  (LinearMap.toSpanSingleton ℂ
      deningerCalderonWittGlobalMilnorIncidence
      (deningerCalderonWittCrossPrimeGammaWitness hpq)).comp
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
      p q hpq r).toLinearMap

@[simp]
theorem
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue_xi
    (p q : Nat.Primes) (hpq : p ≠ q)
    (x : DeningerArithmeticCompletedH1) (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue
        p q hpq r
        (deningerCompletedXiToCrossPrimeIncidenceCompletion
          p q hpq x) =
      x r • deningerCalderonWittCrossPrimeGammaWitness hpq := by
  change
    (lp.evalCLM ℂ
      (fun _ : DeningerArithmeticJetCoordinate => ℂ) 2 r)
        (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
          p q hpq
          ((deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
            p q hpq).symm x)) •
        deningerCalderonWittCrossPrimeGammaWitness hpq =
      x r • deningerCalderonWittCrossPrimeGammaWitness hpq
  rw [
    (deningerCalderonWittCrossPrimeXiIncidenceCompletionEquivJetHilbert
      p q hpq).apply_symm_apply]
  rfl

/--
Coordinate formula for the requested completed Green comparison: each Xi
Green coefficient multiplies the fixed actual source incidence witness.
-/
@[simp]
theorem
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue_green
    (p q : Nat.Primes) (hpq : p ≠ q)
    (ell : DeningerArithmeticTopologicalH1Compact)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue
        p q hpq r
        (deningerArithmeticCompletedGreenToCrossPrimeIncidence
          p q hpq ell) =
      deningerArithmeticSourceGreen ell r •
        deningerCalderonWittCrossPrimeGammaWitness hpq := by
  rw [deningerArithmeticCompletedGreenToCrossPrimeIncidence_apply,
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue_xi]

theorem
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue_eq_zero_iff
    (p q : Nat.Primes) (hpq : p ≠ q)
    (z : DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq)
    (r : XiZeroCopy) :
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue
        p q hpq r z = 0 ↔
      deningerCalderonWittCrossPrimeXiIncidenceCompletionCoefficient
        p q hpq r z = 0 := by
  simp [
    deningerCalderonWittCrossPrimeXiIncidenceCompletionSourceValue,
    deningerCalderonWittCrossPrimeGammaWitness_ne_zero p q hpq]

/-! ## Finite Frobenius compatibility -/

/--
The completed incidence comparison carries the unconditional finite-test
ordinary/compact Frobenius intertwining of the source Green reflection.
-/
theorem
    deningerCrossPrimeIncidenceCompletion_gradedTheta_greenJetTest
    (p q : Nat.Primes) (hpq : p ≠ q)
    (a : DeningerArithmeticJetTest) :
    (deningerCalderonWittCrossPrimeXiIncidenceTestOfJet p q hpq
        (deningerArithmeticGradedTheta
          (deningerArithmeticOrientedGreenJetTest a)) :
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) =
    (deningerCalderonWittCrossPrimeXiIncidenceTestOfJet p q hpq
        (deningerArithmeticOrientedGreenJetTest
          (deningerArithmeticGradedThetaCompact a)) :
      DeningerCalderonWittCrossPrimeXiIncidenceCompletion p q hpq) := by
  rw [deningerArithmeticGradedTheta_greenJetTest]

end

end RHTower
