import GaloisForLFunctions.RHTower.DeningerCentralizerZpow

/-!
# Groups with cyclic centralizers

A group has *cyclic centralizers* when the centralizer of every nontrivial element is generated by a
single element of infinite order.  Together with unique roots this is exactly the invariant carried
along a tower of root adjunctions: the generator of the centralizer of an element is its own
centralizer, generates an isolated subgroup, and has the element among its powers.

* `DeningerCyclicCentralizers` : the condition.
* `deningerCyclicCentralizers_mem` : the element is a nonzero power of the generator.
* `deningerCyclicCentralizers_central` : the generator is its own centralizer.
* `deningerCyclicCentralizers_isolated` : the generator generates an isolated subgroup.
* `deningerUniqueRoots_torsionFree` : unique roots force torsion freeness.
-/

namespace RHTower

universe u

variable {A : Type u} [Group A]

/-- A group has **cyclic centralizers** when the centralizer of every nontrivial element is the
cyclic subgroup generated by one element of infinite order. -/
def DeningerCyclicCentralizers (A : Type u) [Group A] : Prop :=
  ∀ x : A, x ≠ 1 → ∃ y : A, (∀ n : ℤ, y ^ n = 1 → n = 0) ∧
    ∀ z : A, z * x * z⁻¹ = x ↔ z ∈ Subgroup.zpowers y

/-- **Unique roots force torsion freeness.** -/
theorem deningerUniqueRoots_torsionFree
    (hA : ∀ (x y : A) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (x : A) (n : ℕ) (hn : 0 < n) (h : x ^ n = 1) : x = 1 :=
  hA x 1 n hn (by rw [one_pow]; exact h)

/-- **The element is a nonzero power of the generator of its centralizer.** -/
theorem deningerCyclicCentralizers_mem (x y : A)
    (hC : ∀ z : A, z * x * z⁻¹ = x ↔ z ∈ Subgroup.zpowers y) (hx : x ≠ 1) :
    ∃ c : ℤ, c ≠ 0 ∧ y ^ c = x := by
  obtain ⟨c, hc'⟩ := (hC x).1 (by group)
  have hc : y ^ c = x := hc'
  refine ⟨c, ?_, hc⟩
  rintro rfl
  exact hx (by rw [← hc, zpow_zero])

/-- **The generator of a centralizer is its own centralizer.** -/
theorem deningerCyclicCentralizers_central (x y : A)
    (hC : ∀ z : A, z * x * z⁻¹ = x ↔ z ∈ Subgroup.zpowers y) (hx : x ≠ 1)
    (z : A) (hz : z * y * z⁻¹ = y) : z ∈ Subgroup.zpowers y := by
  obtain ⟨c, -, hc⟩ := deningerCyclicCentralizers_mem x y hC hx
  refine (hC z).1 ?_
  rw [← hc, ← deningerConj_zpow_eq, hz]

/-- **The generator of a centralizer generates an isolated subgroup.** -/
theorem deningerCyclicCentralizers_isolated
    (hA : ∀ (x y : A) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y) (x y : A)
    (hC : ∀ z : A, z * x * z⁻¹ = x ↔ z ∈ Subgroup.zpowers y) (hx : x ≠ 1)
    (z : A) (n : ℕ) (hn : 0 < n) (hz : z ^ n ∈ Subgroup.zpowers y) :
    z ∈ Subgroup.zpowers y := by
  obtain ⟨k, hk'⟩ := hz
  have hk : y ^ k = z ^ n := hk'
  by_cases hk0 : k = 0
  · subst hk0
    rw [zpow_zero] at hk
    have hz1 : z = 1 := deningerUniqueRoots_torsionFree hA z n hn hk.symm
    rw [hz1]
    exact Subgroup.one_mem _
  · refine deningerCyclicCentralizers_central x y hC hx z ?_
    refine deningerCentralizer_zpow_eq hA y z k hk0 ?_
    rw [hk]
    group

end RHTower
