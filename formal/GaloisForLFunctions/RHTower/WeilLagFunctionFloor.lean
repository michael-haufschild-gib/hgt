import GaloisForLFunctions.RHTower.WeilLagFunctionOmega
import GaloisForLFunctions.HTGeometry.KroneckerWeylDensity
import GaloisForLFunctions.HTGeometry.RealSubgroupIntBasis

/-!
# The floor of the integer lags and odd relations among the ordinates

Under RH every integer lag satisfies `a_n ≥ −a_1`, and the ceiling `a_1` is always the exact
supremum.  The floor `−a_1` is the exact infimum if and only if the ordinates of the zeros satisfy
**no odd relation**: every integer relation `Σ c_γ γ = 0` among finitely many distinct ordinates has
even coefficient sum.

Reaching the floor means all phases `γ log n` are simultaneously near `π` modulo `2π`.  An odd
relation makes this impossible: multiplying the phases with the relation's coefficients gives
`e^{i·0} = 1` on one side and `(−1)^{Σ c_γ} = −1` on the other.  Conversely, if every relation is
even, the assignment `γ ↦ π` extends to a homomorphism from the group generated by finitely many
ordinates to `ℝ/2πℤ`; expressed on a rationally independent integral basis of that group it becomes
a target on a torus, Kronecker's theorem reaches it, and almost periodicity moves the resulting lag
to a large integer lag.
-/

open Real Filter Topology
open GaloisForLFunctions GaloisForLFunctions.HTGeometry HTGeometry

namespace RHTower

noncomputable section

/-- **No odd relation**: every integer relation among finitely many distinct ordinates of zeros
has even coefficient sum. -/
def NoOddRelation : Prop :=
  ∀ (Γ : Finset ℝ), (∀ γ ∈ Γ, ∃ q : XiZeroCopy, zeroOrdinate q = γ) →
    ∀ c : ℝ → ℤ, ∑ γ ∈ Γ, (c γ : ℝ) * γ = 0 → Even (∑ γ ∈ Γ, c γ)

/-! ## Unimodular products -/

theorem norm_pow_sub_one_le_of_norm_eq_one {u : ℂ} (hu : ‖u‖ = 1) (n : ℕ) :
    ‖u ^ n - 1‖ ≤ (n : ℝ) * ‖u - 1‖ := by
  induction n with
  | zero => simp
  | succ n ih =>
      have h : u ^ (n + 1) - 1 = u ^ n * (u - 1) + (u ^ n - 1) := by ring
      rw [h]
      calc ‖u ^ n * (u - 1) + (u ^ n - 1)‖ ≤ ‖u ^ n * (u - 1)‖ + ‖u ^ n - 1‖ := norm_add_le _ _
        _ = ‖u - 1‖ + ‖u ^ n - 1‖ := by rw [norm_mul, norm_pow, hu, one_pow, one_mul]
        _ ≤ ‖u - 1‖ + n * ‖u - 1‖ := by linarith
        _ = ((n + 1 : ℕ) : ℝ) * ‖u - 1‖ := by push_cast; ring

theorem norm_zpow_sub_one_le_of_norm_eq_one {u : ℂ} (hu : ‖u‖ = 1) (c : ℤ) :
    ‖u ^ c - 1‖ ≤ (c.natAbs : ℝ) * ‖u - 1‖ := by
  have hu0 : u ≠ 0 := by rintro rfl; simp at hu
  obtain ⟨n, hn⟩ : ∃ n : ℕ, c = n ∨ c = -n := ⟨c.natAbs, Int.natAbs_eq c⟩
  have hna : c.natAbs = n := by rcases hn with rfl | rfl <;> simp
  rw [hna]
  rcases hn with rfl | rfl
  · rw [zpow_natCast]
    exact norm_pow_sub_one_le_of_norm_eq_one hu _
  · rw [zpow_neg, zpow_natCast]
    have hpow : ‖u ^ n‖ = 1 := by rw [norm_pow, hu, one_pow]
    have hne : u ^ n ≠ 0 := pow_ne_zero _ hu0
    have : (u ^ n)⁻¹ - 1 = -((u ^ n)⁻¹ * (u ^ n - 1)) := by
      rw [mul_sub, mul_one, inv_mul_cancel₀ hne]; ring
    rw [this, norm_neg, norm_mul, norm_inv, hpow, inv_one, one_mul]
    exact norm_pow_sub_one_le_of_norm_eq_one hu _

theorem norm_prod_zpow_sub_one_le {ι : Type*} (S : Finset ι) (u : ι → ℂ)
    (hu : ∀ i ∈ S, ‖u i‖ = 1) (c : ι → ℤ) :
    ‖∏ i ∈ S, u i ^ c i - 1‖ ≤ ∑ i ∈ S, ((c i).natAbs : ℝ) * ‖u i - 1‖ := by
  classical
  induction S using Finset.induction with
  | empty => simp
  | insert a S ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha]
      have hua : ‖u a‖ = 1 := hu a (Finset.mem_insert_self a S)
      have ih' := ih fun i hi => hu i (Finset.mem_insert_of_mem hi)
      have hna : ‖u a ^ c a‖ = 1 := by rw [norm_zpow, hua, one_zpow]
      have h : u a ^ c a * ∏ i ∈ S, u i ^ c i - 1
          = u a ^ c a * (∏ i ∈ S, u i ^ c i - 1) + (u a ^ c a - 1) := by ring
      rw [h]
      calc ‖u a ^ c a * (∏ i ∈ S, u i ^ c i - 1) + (u a ^ c a - 1)‖
          ≤ ‖u a ^ c a * (∏ i ∈ S, u i ^ c i - 1)‖ + ‖u a ^ c a - 1‖ := norm_add_le _ _
        _ = ‖∏ i ∈ S, u i ^ c i - 1‖ + ‖u a ^ c a - 1‖ := by rw [norm_mul, hna, one_mul]
        _ ≤ (∑ i ∈ S, ((c i).natAbs : ℝ) * ‖u i - 1‖) + ((c a).natAbs : ℝ) * ‖u a - 1‖ :=
            add_le_add ih' (norm_zpow_sub_one_le_of_norm_eq_one hua _)
        _ = _ := by ring

/-- Two unimodular families with integer exponents. -/
theorem norm_prod_zpow_sub_prod_zpow_le {ι : Type*} (S : Finset ι) (v w : ι → ℂ)
    (hv : ∀ i ∈ S, ‖v i‖ = 1) (hw : ∀ i ∈ S, ‖w i‖ = 1) (c : ι → ℤ) :
    ‖∏ i ∈ S, v i ^ c i - ∏ i ∈ S, w i ^ c i‖ ≤ ∑ i ∈ S, ((c i).natAbs : ℝ) * ‖v i - w i‖ := by
  classical
  have hw0 : ∀ i ∈ S, w i ≠ 0 := fun i hi h0 => by
    have := hw i hi; rw [h0, norm_zero] at this; exact zero_ne_one this
  have hprodw : ‖∏ i ∈ S, w i ^ c i‖ = 1 := by
    rw [norm_prod]
    exact Finset.prod_eq_one fun i hi => by rw [norm_zpow, hw i hi, one_zpow]
  have hu : ∀ i ∈ S, ‖v i / w i‖ = 1 := fun i hi => by
    rw [norm_div, hv i hi, hw i hi, div_one]
  have hfac : ∏ i ∈ S, v i ^ c i - ∏ i ∈ S, w i ^ c i
      = (∏ i ∈ S, w i ^ c i) * (∏ i ∈ S, (v i / w i) ^ c i - 1) := by
    rw [mul_sub, mul_one, ← Finset.prod_mul_distrib]
    congr 1
    refine Finset.prod_congr rfl fun i hi => ?_
    rw [div_zpow, mul_div_cancel₀ _ (zpow_ne_zero _ (hw0 i hi))]
  rw [hfac, norm_mul, hprodw, one_mul]
  refine (norm_prod_zpow_sub_one_le S _ hu c).trans (le_of_eq ?_)
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [show v i / w i - 1 = (v i - w i) / w i by field_simp [hw0 i hi], norm_div, hw i hi, div_one]

theorem expChar_int_mul' (β u : ℝ) (c : ℤ) :
    expChar ((c : ℝ) * β) u = (expChar β u) ^ c := by
  simp only [expChar]
  rw [← Complex.exp_int_mul]
  congr 1
  push_cast
  ring

/-! ## Phases near `π` -/

theorem norm_expChar_add_one_sq (x : ℝ) :
    ‖Complex.exp ((x : ℝ) * Complex.I) + 1‖ ^ 2 = 2 + 2 * Real.cos x := by
  have h := norm_expChar_sub_sq x π
  rw [Complex.exp_pi_mul_I, sub_neg_eq_add, Real.cos_sub_pi] at h
  linarith

theorem one_add_cos_le_norm_expChar_add_one (x : ℝ) :
    1 + Real.cos x ≤ ‖Complex.exp ((x : ℝ) * Complex.I) + 1‖ := by
  have h := norm_expChar_add_one_sq x
  have hn : ‖Complex.exp ((x : ℝ) * Complex.I) + 1‖ ≤ 2 := by
    calc ‖Complex.exp ((x : ℝ) * Complex.I) + 1‖
        ≤ ‖Complex.exp ((x : ℝ) * Complex.I)‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
      _ = 2 := by rw [Complex.norm_exp_ofReal_mul_I, norm_one]; norm_num
  nlinarith [norm_nonneg (Complex.exp ((x : ℝ) * Complex.I) + 1)]

/-- Under RH the excess `Φ(L) + a_1 = Σ w_q (1 + cos(γ_q L))` dominates each term. -/
theorem cosWeight_mul_one_add_cos_le (h : RiemannHypothesis) (q : XiZeroCopy) (L : ℝ) :
    cosWeight q * (1 + Real.cos (zeroOrdinate q * L)) ≤ weilLagFunctionReal L + poleSharpConstant := by
  rw [weilLagFunctionReal_eq_cos_series h, ← tsum_cosWeight h]
  have hs1 : Summable fun q : XiZeroCopy => cosWeight q * Real.cos (zeroOrdinate q * L) := by
    refine (summable_cosWeight h).of_norm_bounded fun q => ?_
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (cosWeight_pos q)]
    exact mul_le_of_le_one_right (cosWeight_pos q).le (abs_cos_le_one _)
  rw [← hs1.tsum_add (summable_cosWeight h)]
  have hnn : ∀ q' : XiZeroCopy, 0 ≤ cosWeight q' * Real.cos (zeroOrdinate q' * L) + cosWeight q' := by
    intro q'
    have := neg_one_le_cos (zeroOrdinate q' * L)
    nlinarith [cosWeight_pos q']
  have := (hs1.add (summable_cosWeight h)).le_tsum q (fun q' _ => hnn q')
  have e : cosWeight q * (1 + Real.cos (zeroOrdinate q * L))
      = cosWeight q * Real.cos (zeroOrdinate q * L) + cosWeight q := by ring
  rw [e]
  exact this

/-! ## Odd relations obstruct the floor -/

/-- If some lag comes within every `ε` of the floor `−a_1`, the ordinates have no odd relation. -/
theorem noOddRelation_of_forall_exists_lt (h : RiemannHypothesis)
    (hinf : ∀ ε : ℝ, 0 < ε → ∃ L : ℝ, weilLagFunctionReal L < -poleSharpConstant + ε) :
    NoOddRelation := by
  classical
  intro Γ hΓ c hrel
  by_contra hodd
  rw [Int.not_even_iff_odd] at hodd
  -- the size of the relation
  set K : ℝ := ∑ γ ∈ Γ, ((c γ).natAbs : ℝ) * Real.sqrt (2 * (1 / 4 + γ ^ 2)) with hK
  have hK0 : 0 ≤ K := Finset.sum_nonneg fun γ _ => by positivity
  set ε : ℝ := 1 / (K + 1) ^ 2 with hε
  have hε0 : 0 < ε := by positivity
  obtain ⟨L, hL⟩ := hinf ε hε0
  -- each phase is within `δ_γ` of `π`
  have hclose : ∀ γ ∈ Γ, ‖-Complex.exp ((γ * L : ℝ) * Complex.I) - 1‖
      ≤ Real.sqrt ε * Real.sqrt (2 * (1 / 4 + γ ^ 2)) := by
    intro γ hγ
    obtain ⟨q, hq⟩ := hΓ γ hγ
    have h1 := cosWeight_mul_one_add_cos_le h q L
    rw [hq] at h1
    have hw : cosWeight q = 1 / (1 / 4 + γ ^ 2) := by rw [cosWeight, hq]
    have hpos : 0 < 1 / 4 + γ ^ 2 := by positivity
    have h2 : 1 + Real.cos (γ * L) < ε * (1 / 4 + γ ^ 2) := by
      rw [hw] at h1
      have : 1 / (1 / 4 + γ ^ 2) * (1 + Real.cos (γ * L)) < ε := by linarith
      rwa [one_div_mul_eq_div, div_lt_iff₀ hpos] at this
    have h3 : ‖-Complex.exp ((γ * L : ℝ) * Complex.I) - 1‖ = ‖Complex.exp ((γ * L : ℝ) * Complex.I) + 1‖ := by
      rw [show -Complex.exp ((γ * L : ℝ) * Complex.I) - 1 = -(Complex.exp ((γ * L : ℝ) * Complex.I) + 1) by ring,
        norm_neg]
    rw [h3]
    have h4 := norm_expChar_add_one_sq (γ * L)
    have h5 : ‖Complex.exp ((γ * L : ℝ) * Complex.I) + 1‖ ^ 2 < 2 * (ε * (1 / 4 + γ ^ 2)) := by linarith
    have h6 : (Real.sqrt ε * Real.sqrt (2 * (1 / 4 + γ ^ 2))) ^ 2 = 2 * (ε * (1 / 4 + γ ^ 2)) := by
      rw [mul_pow, Real.sq_sqrt hε0.le, Real.sq_sqrt (by positivity)]; ring
    exact le_of_lt (lt_of_pow_lt_pow_left₀ 2 (by positivity) (by rw [h6]; exact h5))
  -- the product of the phases along the relation is `1`
  have hprod : ∏ γ ∈ Γ, (Complex.exp ((γ * L : ℝ) * Complex.I)) ^ (c γ) = 1 := by
    have : ∀ γ ∈ Γ, (Complex.exp ((γ * L : ℝ) * Complex.I)) ^ (c γ)
        = Complex.exp ((c γ : ℂ) * ((γ * L : ℝ) * Complex.I)) := fun γ _ =>
      (Complex.exp_int_mul _ _).symm
    rw [Finset.prod_congr rfl this, ← Complex.exp_sum]
    have hsum : ∑ γ ∈ Γ, (c γ : ℂ) * ((γ * L : ℝ) * Complex.I)
        = ((∑ γ ∈ Γ, (c γ : ℝ) * γ : ℝ) : ℂ) * (L : ℂ) * Complex.I := by
      push_cast; rw [Finset.sum_mul, Finset.sum_mul]
      exact Finset.sum_congr rfl fun γ _ => by ring
    rw [hsum, hrel]; simp
  -- rewrite each phase as `(-1) · u_γ`
  set u : ℝ → ℂ := fun γ => -Complex.exp ((γ * L : ℝ) * Complex.I) with hu
  have hunorm : ∀ γ ∈ Γ, ‖u γ‖ = 1 := fun γ _ => by
    simp only [hu, norm_neg, Complex.norm_exp_ofReal_mul_I]
  have hsplit : ∏ γ ∈ Γ, (Complex.exp ((γ * L : ℝ) * Complex.I)) ^ (c γ)
      = (∏ γ ∈ Γ, ((-1 : ℂ)) ^ (c γ)) * ∏ γ ∈ Γ, u γ ^ (c γ) := by
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun γ _ => ?_
    rw [← mul_zpow]; congr 1; simp [hu]
  have hsign : ∏ γ ∈ Γ, ((-1 : ℂ)) ^ (c γ) = -1 := by
    have : ∀ γ ∈ Γ, ((-1 : ℂ)) ^ (c γ) = Complex.exp ((c γ : ℂ) * (π * Complex.I)) := fun γ _ => by
      rw [Complex.exp_int_mul, Complex.exp_pi_mul_I]
    rw [Finset.prod_congr rfl this, ← Complex.exp_sum, ← Finset.sum_mul,
      show (∑ γ ∈ Γ, (c γ : ℂ)) = ((∑ γ ∈ Γ, c γ : ℤ) : ℂ) by push_cast; rfl,
      Complex.exp_int_mul, Complex.exp_pi_mul_I, Odd.neg_one_zpow hodd]
  rw [hsplit, hsign] at hprod
  have hprodu : ∏ γ ∈ Γ, u γ ^ (c γ) = -1 := by linear_combination -hprod
  have hbound := norm_prod_zpow_sub_one_le Γ u hunorm c
  rw [hprodu] at hbound
  have h2 : ‖(-1 : ℂ) - 1‖ = 2 := by norm_num
  have hK' : ∑ γ ∈ Γ, ((c γ).natAbs : ℝ) * ‖u γ - 1‖ ≤ Real.sqrt ε * K := by
    rw [hK, Finset.mul_sum]
    refine Finset.sum_le_sum fun γ hγ => ?_
    have := hclose γ hγ
    calc ((c γ).natAbs : ℝ) * ‖u γ - 1‖
        ≤ ((c γ).natAbs : ℝ) * (Real.sqrt ε * Real.sqrt (2 * (1 / 4 + γ ^ 2))) :=
          mul_le_mul_of_nonneg_left this (by positivity)
      _ = Real.sqrt ε * (((c γ).natAbs : ℝ) * Real.sqrt (2 * (1 / 4 + γ ^ 2))) := by ring
  have hsq : Real.sqrt ε = 1 / (K + 1) := by
    rw [hε, one_div, Real.sqrt_inv, Real.sqrt_sq (by linarith), one_div]
  rw [hsq] at hK'
  have : 1 / (K + 1) * K < 1 := by
    rw [div_mul_eq_mul_div, div_lt_one (by linarith)]; linarith
  linarith

/-! ## Even relations realise the floor -/

theorem coeff_of_mem_closure {Γ : Finset ℝ} {x : ℝ} (hx : x ∈ AddSubgroup.closure (Γ : Set ℝ)) :
    ∃ m : ℝ → ℤ, ∑ γ ∈ Γ, (m γ : ℝ) * γ = x := by
  have h1 : x ∈ (Submodule.span ℤ (Γ : Set ℝ)).toAddSubgroup := by
    rw [Submodule.span_int_eq_addSubgroupClosure]; exact hx
  rw [Submodule.mem_toAddSubgroup, Submodule.mem_span_finset] at h1
  obtain ⟨f, -, hf⟩ := h1
  refine ⟨f, ?_⟩
  rw [← hf]
  exact Finset.sum_congr rfl fun γ _ => by rw [zsmul_eq_mul]

/-- If the ordinates have no odd relation then, under RH, the lag function comes within every `ε`
of the floor at some lag. -/
theorem exists_weilLagFunctionReal_lt_of_noOddRelation (h : RiemannHypothesis) (hE : NoOddRelation)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ t : ℝ, weilLagFunctionReal t ≤ -poleSharpConstant + 3 * ε / 8 := by
  classical
  have hw := summable_cosWeight h
  have hw0 : ∀ q, 0 ≤ cosWeight q := fun q => (cosWeight_pos q).le
  have htot := tsum_cosWeight h
  have hc0 := poleSharpConstant_pos
  -- a finite set of zeros carrying all but `ε/8` of the weight
  have htail := tendsto_tsum_compl_atTop_zero cosWeight
  obtain ⟨F, hF⟩ :=
    Filter.eventually_atTop.mp (htail.eventually_lt_const (by linarith : (0:ℝ) < ε / 8))
  have hFtail : ∑' q : {x // x ∉ F}, cosWeight q < ε / 8 := hF F le_rfl
  -- the ordinates of `F` and an integral basis of the group they generate
  set Γ : Finset ℝ := F.image zeroOrdinate with hΓ
  obtain ⟨k, b, hind, hb, hrep⟩ := exists_rat_independent_intSpanning Γ
  choose m hm using fun i => coeff_of_mem_closure (hb i)
  choose! nn hnn using hrep
  -- the target phases
  set θ : Fin k → ℝ := fun i => π * ∑ γ ∈ Γ, (m i γ : ℝ) with hθ
  -- the size of the coefficient vectors
  obtain ⟨K₀, hK₀⟩ := Finset.exists_le (Γ.image fun γ => ∑ i : Fin k, ((nn γ i).natAbs : ℝ))
  set K : ℝ := max K₀ 0 with hKdef
  have hK : ∀ x ∈ Γ.image fun γ => ∑ i : Fin k, ((nn γ i).natAbs : ℝ), x ≤ K :=
    fun x hx => (hK₀ x hx).trans (le_max_left _ _)
  have hK0 : 0 ≤ K := le_max_right _ _
  set δ : ℝ := ε / (8 * poleSharpConstant * (K + 1)) with hδ
  have hδ0 : 0 < δ := by positivity
  obtain ⟨t, ht⟩ := kronecker_approx hind θ hδ0
  refine ⟨t, ?_⟩
  -- every phase of `Γ` is within `K δ` of `−1`
  have hphase : ∀ γ ∈ Γ, ‖Complex.exp ((γ * t : ℝ) * Complex.I) + 1‖ ≤ K * δ := by
    intro γ hγ
    have hγrep := hnn γ hγ
    -- the phase as a product over the basis
    have hv : Complex.exp ((γ * t : ℝ) * Complex.I) = ∏ i : Fin k, (expChar (b i) t) ^ (nn γ i) := by
      have e1 : Complex.exp ((γ * t : ℝ) * Complex.I) = expChar (∑ i, (nn γ i : ℝ) * b i) t := by
        rw [← hγrep]; rfl
      rw [e1, ← prod_expChar]
      exact Finset.prod_congr rfl fun i _ => expChar_int_mul' _ _ _
    -- the target as a product over the basis
    set N : ℤ := ∑ i : Fin k, nn γ i * ∑ γ' ∈ Γ, m i γ' with hN
    have hwprod : ∏ i : Fin k, (Complex.exp ((θ i : ℝ) * Complex.I)) ^ (nn γ i) = -1 := by
      have : ∀ i ∈ (Finset.univ : Finset (Fin k)), (Complex.exp ((θ i : ℝ) * Complex.I)) ^ (nn γ i)
          = Complex.exp ((nn γ i : ℂ) * ((θ i : ℝ) * Complex.I)) := fun i _ =>
        (Complex.exp_int_mul _ _).symm
      rw [Finset.prod_congr rfl this, ← Complex.exp_sum]
      have hsum : ∑ i : Fin k, (nn γ i : ℂ) * ((θ i : ℝ) * Complex.I) = (N : ℂ) * (π * Complex.I) := by
        rw [hN, hθ]; push_cast
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => by ring
      rw [hsum, Complex.exp_int_mul, Complex.exp_pi_mul_I]
      -- `N` is odd by the relation `γ − Σ_γ' (Σ_i nn γ i · m i γ') γ' = 0`
      have hrel : ∑ γ' ∈ Γ, (((if γ' = γ then 1 else 0) - ∑ i : Fin k, nn γ i * m i γ' : ℤ) : ℝ) * γ' = 0 := by
        push_cast
        simp only [sub_mul, Finset.sum_sub_distrib, Finset.sum_mul, ite_mul, one_mul, zero_mul]
        rw [Finset.sum_ite_eq' Γ γ, if_pos hγ]
        rw [Finset.sum_comm]
        have : ∑ i : Fin k, ∑ γ' ∈ Γ, ((nn γ i : ℝ) * (m i γ' : ℝ)) * γ'
            = ∑ i : Fin k, (nn γ i : ℝ) * b i := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← hm i, Finset.mul_sum]
          exact Finset.sum_congr rfl fun γ' _ => by ring
        rw [this, ← hγrep]; ring
      have heven := hE Γ (fun γ' hγ' => by
        obtain ⟨q, hq, hqγ⟩ := Finset.mem_image.mp hγ'
        exact ⟨q, hqγ⟩) _ hrel
      have hsumc : ∑ γ' ∈ Γ, ((if γ' = γ then 1 else 0) - ∑ i : Fin k, nn γ i * m i γ' : ℤ) = 1 - N := by
        rw [Finset.sum_sub_distrib, Finset.sum_ite_eq' Γ γ, if_pos hγ, hN, Finset.sum_comm]
        congr 1
        exact Finset.sum_congr rfl fun i _ => by rw [Finset.mul_sum]
      rw [hsumc] at heven
      have hodd : Odd N :=
        Int.not_even_iff_odd.mp fun hev => Int.not_even_one ((Int.even_sub.mp heven).mpr hev)
      exact Odd.neg_one_zpow hodd
    have hbound := norm_prod_zpow_sub_prod_zpow_le (Finset.univ : Finset (Fin k))
      (fun i => expChar (b i) t) (fun i => Complex.exp ((θ i : ℝ) * Complex.I))
      (fun i _ => Complex.norm_exp_ofReal_mul_I (b i * t))
      (fun i _ => Complex.norm_exp_ofReal_mul_I _) (nn γ)
    rw [← hv, hwprod] at hbound
    rw [sub_neg_eq_add] at hbound
    refine hbound.trans ?_
    calc ∑ i : Fin k, ((nn γ i).natAbs : ℝ) * ‖expChar (b i) t - Complex.exp ((θ i : ℝ) * Complex.I)‖
        ≤ ∑ i : Fin k, ((nn γ i).natAbs : ℝ) * δ :=
          Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (ht i).le (by positivity)
      _ = (∑ i : Fin k, ((nn γ i).natAbs : ℝ)) * δ := by rw [Finset.sum_mul]
      _ ≤ K * δ := mul_le_mul_of_nonneg_right (hK _ (Finset.mem_image_of_mem _ hγ)) hδ0.le
  -- the cosines on `F`
  have hcos : ∀ q ∈ F, Real.cos (zeroOrdinate q * t) ≤ -1 + K * δ := by
    intro q hq
    have h1 := one_add_cos_le_norm_expChar_add_one (zeroOrdinate q * t)
    have h2 := hphase (zeroOrdinate q) (Finset.mem_image_of_mem _ hq)
    linarith
  -- assemble
  rw [weilLagFunctionReal_eq_cos_series h]
  set f : XiZeroCopy → ℝ := fun q => cosWeight q * Real.cos (zeroOrdinate q * t) with hf
  have hfle : ∀ q, ‖f q‖ ≤ cosWeight q := by
    intro q
    rw [hf]
    simp only [Real.norm_eq_abs, abs_mul, abs_of_pos (cosWeight_pos q)]
    exact mul_le_of_le_one_right (hw0 q) (abs_cos_le_one _)
  have hfs : Summable f := hw.of_norm_bounded hfle
  have hsplit := hfs.sum_add_tsum_compl (s := F)
  have htailf : |∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, f q| ≤ ∑' q : {x // x ∉ F}, cosWeight q := by
    have h1 : ‖∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, f q‖ ≤ ∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, ‖f q‖ :=
      norm_tsum_le_tsum_norm ((hfs.norm).subtype _)
    have h2 : ∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, ‖f q‖ ≤ ∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, cosWeight q :=
      Summable.tsum_le_tsum (fun q => hfle q) ((hfs.norm).subtype _) (hw.subtype _)
    rw [Real.norm_eq_abs] at h1
    exact h1.trans h2
  have hFsum : ∑ q ∈ F, cosWeight q = poleSharpConstant - ∑' q : {x // x ∉ F}, cosWeight q := by
    have := hw.sum_add_tsum_compl (s := F)
    rw [htot] at this
    have e' : ∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, cosWeight q = ∑' q : {x // x ∉ F}, cosWeight q := rfl
    linarith
  have hFle : ∑ q ∈ F, cosWeight q ≤ poleSharpConstant := by
    rw [← htot]; exact hw.sum_le_tsum F (fun q _ => hw0 q)
  have hfin : ∑ q ∈ F, f q ≤ -(∑ q ∈ F, cosWeight q) + ε / 8 := by
    have h1 : ∑ q ∈ F, f q ≤ ∑ q ∈ F, cosWeight q * (-1 + K * δ) := by
      refine Finset.sum_le_sum fun q hq => ?_
      rw [hf]
      exact mul_le_mul_of_nonneg_left (hcos q hq) (hw0 q)
    rw [← Finset.sum_mul] at h1
    have h3 : (∑ q ∈ F, cosWeight q) * (K * δ) ≤ poleSharpConstant * (K * δ) :=
      mul_le_mul_of_nonneg_right hFle (by positivity)
    have h4 : poleSharpConstant * (K * δ) ≤ ε / 8 := by
      rw [hδ]
      have : poleSharpConstant * (K * (ε / (8 * poleSharpConstant * (K + 1))))
          = ε / 8 * (K / (K + 1)) := by field_simp
      rw [this]
      have : K / (K + 1) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
      nlinarith
    have h5 : (∑ q ∈ F, cosWeight q) * (-1 + K * δ)
        = -(∑ q ∈ F, cosWeight q) + (∑ q ∈ F, cosWeight q) * (K * δ) := by ring
    linarith
  rw [← hsplit]
  have := le_abs_self (∑' q : ↑(↑F : Set XiZeroCopy)ᶜ, f q)
  linarith

/-- Under RH and no odd relation, the integer lags come within every `ε` of the floor `−a_1`. -/
theorem exists_integerLag_lt_of_noOddRelation (h : RiemannHypothesis) (hE : NoOddRelation)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ n : ℕ, 2 ≤ n ∧ integerLag n < -poleSharpConstant + ε := by
  obtain ⟨t, ht⟩ := exists_weilLagFunctionReal_lt_of_noOddRelation h hE hε
  -- a large almost period
  obtain ⟨Lp, hLp, hdense⟩ := isBohrAlmostPeriodic_weilLagFunctionReal h (ε / 8) (by linarith)
  obtain ⟨N₁, hN₁⟩ := Filter.eventually_atTop.mp
    (tendsto_lagGap.eventually_lt_const (by linarith : (0:ℝ) < ε / 8))
  have hK0 : (0 : ℝ) < ((N₁ + 2 : ℕ) : ℝ) := by positivity
  obtain ⟨τ, hτmem, hτ⟩ := hdense (|t| + Real.log ((N₁ + 2 : ℕ) : ℝ))
  set t' := t + τ with ht'
  have ht'ge : Real.log ((N₁ + 2 : ℕ) : ℝ) ≤ t' := by
    have := hτmem.1; have := neg_abs_le t; rw [ht']; linarith
  have hlog2 : Real.log 2 ≤ Real.log ((N₁ + 2 : ℕ) : ℝ) :=
    Real.log_le_log (by norm_num) (by exact_mod_cast (by omega : 2 ≤ N₁ + 2))
  have hL2 : Real.log 2 ≤ t' := hlog2.trans ht'ge
  have hnK : N₁ + 2 ≤ ⌊Real.exp t'⌋₊ := by
    apply Nat.le_floor
    rw [← Real.exp_log hK0]
    exact Real.exp_le_exp.mpr ht'ge
  have hgap := abs_weilLagFunctionReal_sub_integerLag_le hL2
  have hsmall := hN₁ _ (by omega : N₁ ≤ ⌊Real.exp t'⌋₊)
  have hshift := hτ t
  rw [Real.norm_eq_abs] at hshift
  refine ⟨⌊Real.exp t'⌋₊, by omega, ?_⟩
  have h1 := (abs_le.mp hgap).1
  have h2 := (abs_le.mp hshift).2
  rw [← ht'] at h2
  linarith

/-- **The floor law.**  Under RH, `−a_1 = −(2 + γ − log 4π)` is the exact infimum of the integer
lags `a_n`, `n ≥ 2`, if and only if the ordinates of the zeros have no odd relation. -/
theorem integerLag_floor_law (h : RiemannHypothesis) :
    IsGLB (Set.range fun n : {n : ℕ // 2 ≤ n} => integerLag n) (-poleSharpConstant) ↔
      NoOddRelation := by
  constructor
  · intro hglb
    refine noOddRelation_of_forall_exists_lt h fun ε hε => ?_
    by_contra hcon
    push Not at hcon
    have hlb : -poleSharpConstant + ε ∈ lowerBounds (Set.range fun n : {n : ℕ // 2 ≤ n} => integerLag n) := by
      rintro x ⟨n, rfl⟩
      have := hcon (Real.log n)
      exact this
    have := hglb.2 hlb
    linarith
  · intro hE
    constructor
    · rintro x ⟨n, rfl⟩
      have := abs_integerLag_le_of_riemannHypothesis h n
      linarith [neg_abs_le (integerLag n)]
    · intro M hM
      by_contra hlt
      push Not at hlt
      obtain ⟨n, hn2, hn⟩ := exists_integerLag_lt_of_noOddRelation h hE (by linarith : 0 < M + poleSharpConstant)
      have := hM ⟨⟨n, hn2⟩, rfl⟩
      simp only at this
      linarith

end

