import GaloisForLFunctions.RHTower.XiReciprocalFixedCauchyKrylovCyclicity

/-!
# Fixed-Cauchy reciprocal-Krylov source universality

The predetermined continued-Cauchy vector generates the fixed adjoint response through polynomial
iterates of the reciprocal Xi operator. This module closes the complementary chamber left by the
one-orbit saturation theorem: strict positivity of the limiting holomorphic source contrast is
exactly failure of RH. Saturation and positive failure form an exhaustive disjoint pair.
-/

open Complex Filter Topology

namespace RHTower

noncomputable section

/-- Normalized holomorphic source-polarization contrast generated by one reciprocal polynomial
applied to the fixed Cauchy source. -/
def xiReciprocalSquareFixedCauchyKrylovSourceContrast (p : Polynomial ℂ) : ℝ :=
  ((xiWeilPolarization
        (xiReciprocalCauchyKrylovSourcePlusTest
          xiReciprocalSquareFixedCauchyPole p)
        (xiReciprocalCauchyKrylovSourcePlusTest
          xiReciprocalSquareFixedCauchyPole p)).re -
    (xiWeilPolarization
        (xiReciprocalCauchyKrylovSourceMinusTest
          xiReciprocalSquareFixedCauchyPole p)
        (xiReciprocalCauchyKrylovSourceMinusTest
          xiReciprocalSquareFixedCauchyPole p)).re) / 4

/-- Any polynomial recovery sequence for the fixed adjoint response has the same limiting source
contrast: the predetermined reciprocal-square orientation defect. -/
theorem xiReciprocalSquareFixedCauchyKrylovSourceContrast_tendsto_orientationDefect
    (p : ℕ → Polynomial ℂ)
    (hp : Tendsto
      (fun n => xiReciprocalCauchyKrylovPolynomialVector
        xiReciprocalSquareFixedCauchyPole (p n)) atTop
      (nhds (xiWeilEvaluationLp
        (xiReciprocalSquareCauchyAdjointResponseTest
          (xiReciprocalSquareFixedCauchyPole : ℂ))
        (xiReciprocalSquareCauchyAdjointResponseTest_squareSummable
          xiReciprocalSquareFixedCauchyPole)))) :
    Tendsto (fun n =>
        xiReciprocalSquareFixedCauchyKrylovSourceContrast (p n)) atTop
      (nhds (xiReciprocalSquareContinuedCauchyOrientationDefect
        xiReciprocalSquareFixedCauchyPole)) := by
  simpa only [xiReciprocalSquareFixedCauchyKrylovSourceContrast] using
    xiReciprocalCauchyKrylovSourceContrast_tendsto_orientationDefect_of_response_tendsto
      xiReciprocalSquareFixedCauchyPole p hp

/-- Positive failure chamber for one fixed reciprocal-Krylov orbit. The response approximation is
retained in the certificate, while its limiting source contrast is required to be positive. -/
def XiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure : Prop :=
  ∃ p : ℕ → Polynomial ℂ,
    Tendsto
      (fun n => xiReciprocalCauchyKrylovPolynomialVector
        xiReciprocalSquareFixedCauchyPole (p n)) atTop
      (nhds (xiWeilEvaluationLp
        (xiReciprocalSquareCauchyAdjointResponseTest
          (xiReciprocalSquareFixedCauchyPole : ℂ))
        (xiReciprocalSquareCauchyAdjointResponseTest_squareSummable
          xiReciprocalSquareFixedCauchyPole))) ∧
    ∃ delta : ℝ,
      Tendsto (fun n =>
          xiReciprocalSquareFixedCauchyKrylovSourceContrast (p n)) atTop
        (nhds delta) ∧
      0 < delta

/-- **Fixed-Cauchy reciprocal-Krylov failure universality law.** Strictly positive limiting source
contrast along one polynomial orbit exists exactly when RH fails. -/
theorem xiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure_iff_not_riemannHypothesis :
    XiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure ↔
      ¬RiemannHypothesis := by
  constructor
  · rintro ⟨p, hp, delta, hdelta, hdeltaPos⟩
    have hdefect :=
      xiReciprocalSquareFixedCauchyKrylovSourceContrast_tendsto_orientationDefect p hp
    have hdeltaEq :
        delta = xiReciprocalSquareContinuedCauchyOrientationDefect
          xiReciprocalSquareFixedCauchyPole :=
      tendsto_nhds_unique hdelta hdefect
    exact
      xiReciprocalSquareFixedCauchyOrientationDefect_pos_iff_not_riemannHypothesis.mp
        (hdeltaEq ▸ hdeltaPos)
  · intro hnotRH
    obtain ⟨p, hp, hdefect⟩ :=
      exists_fixedReciprocalCauchyKrylovSourceContrast_tendsto_orientationDefect
    exact ⟨p, hp,
      xiReciprocalSquareContinuedCauchyOrientationDefect
        xiReciprocalSquareFixedCauchyPole,
      by simpa only [xiReciprocalSquareFixedCauchyKrylovSourceContrast] using hdefect,
      xiReciprocalSquareFixedCauchyOrientationDefect_pos_iff_not_riemannHypothesis.mpr
        hnotRH⟩

/-- Saturated zero contrast and positive contrast failure are the two exhaustive, disjoint chambers
of the fixed reciprocal-Krylov source law. -/
theorem xiReciprocalSquareFixedCauchyKrylovSourceContrast_twoChamber :
    (XiReciprocalSquareFixedCauchyKrylovSourceContrastSaturation ∧
        ¬XiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure) ∨
      (¬XiReciprocalSquareFixedCauchyKrylovSourceContrastSaturation ∧
        XiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure) := by
  classical
  by_cases hRH : RiemannHypothesis
  · exact Or.inl ⟨
      xiReciprocalSquareFixedCauchyKrylovSourceContrastSaturation_iff_riemannHypothesis.2 hRH,
      fun hfailure =>
        (xiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure_iff_not_riemannHypothesis.1
          hfailure) hRH⟩
  · exact Or.inr ⟨
      fun hsaturation => hRH
        (xiReciprocalSquareFixedCauchyKrylovSourceContrastSaturation_iff_riemannHypothesis.1
          hsaturation),
      xiReciprocalSquareFixedCauchyKrylovSourceContrastPositiveFailure_iff_not_riemannHypothesis.2
        hRH⟩

end

end RHTower
