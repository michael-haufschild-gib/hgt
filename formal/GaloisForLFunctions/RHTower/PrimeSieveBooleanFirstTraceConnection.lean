import Mathlib.RingTheory.Ideal.Operations

/-!
# Prime-sieve Boolean first-trace connection

Finite Boolean diagonals have a fixed cofinal jump.  The singular Wold/BV first-trace
counterterm removes that jump on each prime edge, but the corrected edges need not be
path-independent.  This file formalizes the algebraic core:

* the corrected edge is exactly the reciprocal-prime residual;
* the two-face path curvature factors through the two face defects;
* consequently the curvature belongs to their ideal and vanishes under every algebra
  realization in which both faces become the unit.

The result is unconditional and independent of dimension.  It constructs no Xi boundary map and
does not prove RH.
-/

namespace RHTower

section

variable {R A B : Type*}
  [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B]

/-- A weighted diagonal edge after adding the face counterterm `x * (1 - e)`.

In the prime-sieve specialization, `x = a_P D_P`, `e = D_p`, and `r = p⁻¹`. -/
def firstTraceCorrectedEdge (x e : A) (r : R) : A :=
  (1 - r) • (x * e) - x + x * (1 - e)

/-- The face counterterm cancels the full Boolean jump and leaves exactly the
reciprocal-scale residual. -/
theorem firstTraceCorrectedEdge_eq (x e : A) (r : R) :
    firstTraceCorrectedEdge x e r = -(r • (x * e)) := by
  simp [firstTraceCorrectedEdge, Algebra.smul_def]
  ring

/-- Difference between the two orders of adjoining faces `e` and `f` to the corrected
first-trace connection. -/
def firstTraceCorrectedSquareCurvature
    (x e f : A) (r t : R) : A :=
  firstTraceCorrectedEdge x e r +
      firstTraceCorrectedEdge ((1 - r) • (x * e)) f t -
    firstTraceCorrectedEdge x f t -
      firstTraceCorrectedEdge ((1 - t) • (x * f)) e r

/-- Exact factorization of corrected two-face curvature through the two face defects. -/
theorem firstTraceCorrectedSquareCurvature_eq
    (x e f : A) (r t : R) :
    firstTraceCorrectedSquareCurvature x e f r t =
      t • (x * f * (1 - e)) - r • (x * e * (1 - f)) := by
  simp [firstTraceCorrectedSquareCurvature, firstTraceCorrectedEdge_eq,
    Algebra.smul_def]
  ring

/-- Ideal generated by the two Boolean face defects. -/
def firstTraceFaceDefectIdeal (e f : A) : Ideal A :=
  Ideal.span ({1 - e, 1 - f} : Set A)

/-- Corrected two-face curvature lands in the ideal generated by the two face defects. -/
theorem firstTraceCorrectedSquareCurvature_mem_faceDefectIdeal
    (x e f : A) (r t : R) :
    firstTraceCorrectedSquareCurvature x e f r t ∈
      firstTraceFaceDefectIdeal e f := by
  rw [firstTraceCorrectedSquareCurvature_eq]
  let I := firstTraceFaceDefectIdeal e f
  have he : 1 - e ∈ I := by
    exact Ideal.subset_span (Set.mem_insert _ _)
  have hf : 1 - f ∈ I := by
    exact Ideal.subset_span
      (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  change t • (x * f * (1 - e)) - r • (x * e * (1 - f)) ∈ I
  rw [Algebra.smul_def, Algebra.smul_def]
  apply I.sub_mem
  · exact I.mul_mem_left _ (I.mul_mem_left _ he)
  · exact I.mul_mem_left _ (I.mul_mem_left _ hf)

/-- Every algebra realization sending both face diagonals to the unit kills the corrected
two-face curvature.  This is the algebraic finite-face model of constraint-ideal landing. -/
theorem map_firstTraceCorrectedSquareCurvature_eq_zero
    (φ : A →ₐ[R] B) (x e f : A) (r t : R)
    (he : φ e = 1) (hf : φ f = 1) :
    φ (firstTraceCorrectedSquareCurvature x e f r t) = 0 := by
  rw [firstTraceCorrectedSquareCurvature_eq]
  simp [he, hf]

end

end RHTower
