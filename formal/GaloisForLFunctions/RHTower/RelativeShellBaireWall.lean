import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
import Mathlib.Topology.Algebra.Module.Basic
import Mathlib.Topology.Baire.Lemmas
import Mathlib.LinearAlgebra.LinearIndependent.Defs
import Mathlib.Analysis.Normed.Field.Basic
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.LinearAlgebra.FiniteDimensional.Defs

/-!
# The relative-shell Baire finite-stage factorization wall

A continuous linear map out of a Baire topological vector space whose range is covered by countably
many closed subspaces already lands in one of them: the preimages are closed subspaces covering the
source, so one has interior, and a subspace with interior is everything.

If moreover the kernel of the map is exactly a subfield over which a family is algebraically
independent, the images of that family are linearly independent: a vanishing linear combination of
the images puts the corresponding combination in the kernel, hence in the subfield, and that is a
polynomial relation over the subfield.  So the single stage that catches the range contains a
linearly independent family indexed by the whole family, and cannot be finite dimensional if the
family is infinite.

* `shellPrivate_algebraicIndependent_over_common` : **algebraic independence over the field
  generated by the complementary part of the family.**
* `shellImage_linearIndependent` : **the images of an algebraically independent family under a map
  with kernel exactly the base field are linearly independent.**
* `shellBaire_exists_stage` : **Baire factorization through one closed stage.**
* `shellBaire_no_finiteDimensional_stages` : **no such map exists when every stage is finite
  dimensional and the family is infinite.**
-/

open Set MvPolynomial

namespace RHTower

/-! ## Algebraic independence over the common field -/

/-- **Change of base for an algebraically independent disjoint union.**  If the common jets `Z` and
the private jets `H` are together algebraically independent over the coordinate ring, then the
private jets are algebraically independent over the ring generated by the common jets — which is the
common differential field of the shell. -/
theorem shellPrivate_algebraicIndependent_over_common {K L : Type*} [CommRing K] [CommRing L]
    [Algebra K L] {ι κ : Type*} (Z : ι → L) (H : κ → L)
    (h : AlgebraicIndependent K (Sum.elim H Z)) :
    AlgebraicIndependent (Algebra.adjoin K (Set.range Z)) H :=
  (AlgebraicIndependent.sumElim_iff.mp h).2

/-! ## Linear independence of the images -/

section Images

variable {𝕜 L V : Type*} [Field 𝕜] [CommRing L] [Nontrivial L] [Algebra 𝕜 L]
variable [AddCommGroup V] [Module 𝕜 V]

/-- **The images of an algebraically independent family are linearly independent** under a linear
map whose kernel is exactly the subfield the family is independent over.  A vanishing linear
combination of the images lies in the kernel, hence in the subfield, and is therefore a polynomial
relation on the family over that subfield. -/
theorem shellImage_linearIndependent {κ : Type*} (K : Subalgebra 𝕜 L) (H : κ → L)
    (hH : AlgebraicIndependent K H) (T : L →ₗ[𝕜] V)
    (hker : LinearMap.ker T = Subalgebra.toSubmodule K) :
    LinearIndependent 𝕜 (fun i => T (H i)) := by
  classical
  refine linearIndependent_iff'.mpr fun s c hc i hi => ?_
  -- the corresponding combination lies in the kernel, hence in the subfield
  have hTsum : T (∑ k ∈ s, c k • H k) = 0 := by
    rw [map_sum]
    simpa only [map_smul] using hc
  have hmem : (∑ k ∈ s, c k • H k) ∈ K := by
    have : (∑ k ∈ s, c k • H k) ∈ LinearMap.ker T := LinearMap.mem_ker.mpr hTsum
    rw [hker] at this
    exact this
  -- the polynomial relation over the subfield
  set y : K := ⟨∑ k ∈ s, c k • H k, hmem⟩ with hy
  set p : MvPolynomial κ K :=
    (∑ k ∈ s, C (algebraMap 𝕜 K (c k)) * X k) - C y with hp
  have haeval : aeval H p = 0 := by
    rw [hp, map_sub, map_sum, aeval_C]
    have hterm : ∀ k ∈ s, aeval H (C (algebraMap 𝕜 K (c k)) * X k) = c k • H k := by
      intro k _
      rw [map_mul, aeval_C, aeval_X]
      show (algebraMap K L) ((algebraMap 𝕜 K) (c k)) * H k = c k • H k
      rw [← IsScalarTower.algebraMap_apply, Algebra.smul_def]
    rw [Finset.sum_congr rfl hterm]
    have hyval : (algebraMap K L) y = ∑ k ∈ s, c k • H k := rfl
    rw [hyval, sub_self]
  have hpzero : p = 0 := hH haeval
  -- read off the coefficient of the `i`-th variable
  have hcoeff : MvPolynomial.coeff (Finsupp.single i 1) p = algebraMap 𝕜 K (c i) := by
    rw [hp, MvPolynomial.coeff_sub, MvPolynomial.coeff_C]
    have hne : ¬ (Finsupp.single i 1 = (0 : κ →₀ ℕ)) := by
      intro hEq
      have := congrArg (fun f : κ →₀ ℕ => f i) hEq
      simp at this
    rw [if_neg (Ne.symm hne), sub_zero, MvPolynomial.coeff_sum]
    refine (Finset.sum_eq_single_of_mem i hi ?_).trans ?_
    · intro k _ hk
      rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X,
        if_neg (fun hEq => hk (Finsupp.single_left_injective one_ne_zero hEq)), mul_zero]
    · rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, if_pos rfl, mul_one]
  rw [hpzero, MvPolynomial.coeff_zero] at hcoeff
  have hinj : Function.Injective (algebraMap 𝕜 K) := (algebraMap 𝕜 K).injective
  exact hinj (by rw [map_zero, ← hcoeff])

end Images

/-! ## The Baire factorization -/

section Baire

variable {𝕜 F V : Type*} [NontriviallyNormedField 𝕜]
variable [AddCommGroup F] [Module 𝕜 F] [TopologicalSpace F] [IsTopologicalAddGroup F]
variable [ContinuousSMul 𝕜 F] [BaireSpace F]
variable [AddCommGroup V] [Module 𝕜 V] [TopologicalSpace V]

/-- **Baire stage factorization.**  A continuous linear map out of a Baire topological vector space
whose range is covered by countably many closed subspaces already lands in one of them. -/
theorem shellBaire_exists_stage (T : F →ₗ[𝕜] V) (hT : Continuous T) (Vs : ℕ → Submodule 𝕜 V)
    (hclosed : ∀ n, IsClosed (Vs n : Set V)) (hcover : ∀ x : F, ∃ n, T x ∈ Vs n) :
    ∃ N, ∀ x : F, T x ∈ Vs N := by
  have hEclosed : ∀ n, IsClosed (((Vs n).comap T : Submodule 𝕜 F) : Set F) := fun n =>
    (hclosed n).preimage hT
  have hEcover : (⋃ n, (((Vs n).comap T : Submodule 𝕜 F) : Set F)) = Set.univ := by
    refine Set.eq_univ_of_forall fun x => ?_
    obtain ⟨n, hn⟩ := hcover x
    exact Set.mem_iUnion.mpr ⟨n, hn⟩
  obtain ⟨N, hN⟩ := nonempty_interior_of_iUnion_of_closed hEclosed hEcover
  have htop : (Vs N).comap T = ⊤ := Submodule.eq_top_of_nonempty_interior' _ hN
  refine ⟨N, fun x => ?_⟩
  have : x ∈ (Vs N).comap T := htop ▸ Submodule.mem_top
  exact this

/-- **The finite-stage wall.**  If every stage is finite dimensional, no continuous linear map out
of a Baire space with stage-covered range can have kernel exactly a subfield over which an infinite
family is algebraically independent. -/
theorem shellBaire_no_finiteDimensional_stages {L : Type*} [CommRing L] [Nontrivial L]
    [Algebra 𝕜 L] [TopologicalSpace L] [IsTopologicalAddGroup L]
    [ContinuousSMul 𝕜 L] [BaireSpace L] {κ : Type*} [Infinite κ]
    (K : Subalgebra 𝕜 L) (H : κ → L) (hH : AlgebraicIndependent K H)
    (T : L →ₗ[𝕜] V) (hT : Continuous T) (hker : LinearMap.ker T = Subalgebra.toSubmodule K)
    (Vs : ℕ → Submodule 𝕜 V) (hclosed : ∀ n, IsClosed (Vs n : Set V))
    (hcover : ∀ x : L, ∃ n, T x ∈ Vs n)
    (hfin : ∀ n, FiniteDimensional 𝕜 (Vs n)) : False := by
  obtain ⟨N, hN⟩ := shellBaire_exists_stage T hT Vs hclosed hcover
  have hli : LinearIndependent 𝕜 (fun i => T (H i)) :=
    shellImage_linearIndependent K H hH T hker
  have hmem : ∀ i, T (H i) ∈ Vs N := fun i => hN (H i)
  have hli' : LinearIndependent 𝕜 (fun i : κ => (⟨T (H i), hmem i⟩ : Vs N)) := by
    refine LinearIndependent.of_comp (Vs N).subtype ?_
    exact hli
  haveI := hfin N
  exact (Module.Finite.not_linearIndependent_of_infinite _) hli'

end Baire

end RHTower
