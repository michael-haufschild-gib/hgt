import GaloisForLFunctions.RHTower.WeldAffineTrivialization

/-!
# The weld as the connecting class of the differential-order filtration

The scalar weld dies after adjoining the derivation `D`, and genuine functional-equation covariance
does not prevent that collapse.  What the killing primitive cannot avoid is its principal symbol:
every primitive has derivation coefficient one at the derivation generator.

This file isolates the surviving fixed constraint.  The coefficient sequence

`0 → ℝ I → ℝ D ⊕ ℝ I → ℝ σ(D) → 0`

is exact and equivariant.  The derivation-count cocycle in the symbol quotient lifts to the explicit
affine primitive, whose boundary is the weld cocycle.  Thus the weld is the connecting class of the
differential-order filtration.  It vanishes under arbitrary affine gauge, but remains nonzero when
gauge transformations are required to have order zero.  No carrier or evolution parameter occurs.
-/

open GaloisForLFunctions

noncomputable section
namespace GaloisForLFunctions.RHTower

/-- Principal symbol on the affine span: retain the coefficient of the derivation. -/
def weldPrincipalSymbol (θ : ℝ) : WeldAffineCoeff θ →+ ℝ where
  toFun v := v.1
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The principal symbol is equivariant; the weld action only changes order-zero terms. -/
theorem weldPrincipalSymbol_smul (θ : ℝ) (g : WeldGroup) (v : WeldAffineCoeff θ) :
    weldPrincipalSymbol θ (g • v) = g • weldPrincipalSymbol θ v := by
  change v.1 = v.1
  rfl

/-- The scalar identity terms are exactly the kernel of the principal symbol. -/
theorem weldAffine_orderFiltration_exact (θ : ℝ) :
    Function.Exact (weldAffineScalarHom θ) (weldPrincipalSymbol θ) := by
  intro v
  constructor
  · intro hv
    refine ⟨v.2, ?_⟩
    apply Prod.ext
    · exact hv.symm
    · rfl
  · rintro ⟨r, rfl⟩
    rfl

/-- The derivation count of a weld-group label. -/
def weldDerivSymbol (g : WeldGroup) : ℝ :=
  ((Multiplicative.toAdd g).1 : ℝ)

/-- Derivation count is an additive one-cocycle for the trivial symbol action. -/
theorem weldDerivSymbol_mul (g h : WeldGroup) :
    weldDerivSymbol (g * h) = weldDerivSymbol g + weldDerivSymbol h := by
  simp [weldDerivSymbol, toAdd_mul]

/-- Functional-equation reflection makes the derivation symbol odd. -/
theorem weldDerivSymbol_reflection (g : WeldGroup) :
    weldDerivSymbol (weldFEGroupReflection g) = -weldDerivSymbol g := by
  simp [weldDerivSymbol, weldFEGroupReflection, toAdd_inv]

/-- Coefficient reflection likewise makes the principal symbol odd. -/
theorem weldPrincipalSymbol_reflection (θ : ℝ) (v : WeldAffineCoeff θ) :
    weldPrincipalSymbol θ (weldAffineReflection θ v) = -weldPrincipalSymbol θ v := by
  rfl

/-- The affine primitive is a lift of the derivation-count symbol cocycle. -/
theorem weldAffinePrimitive_principalSymbol (θ : ℝ) (g : WeldGroup) :
    weldPrincipalSymbol θ (weldAffinePrimitive θ g) = weldDerivSymbol g := by
  rfl

/-- **Connecting-boundary formula.**  The derivation-count symbol lifts to the affine primitive,
and the boundary of that lift is exactly the included scalar weld cocycle. -/
theorem weldCocycle_is_orderFiltration_boundary (θ : ℝ) :
    (∀ g, weldPrincipalSymbol θ (weldAffinePrimitive θ g) = weldDerivSymbol g) ∧
      twoCoboundary (weldAffinePrimitive θ) = weldAffineCocycle θ :=
  ⟨weldAffinePrimitive_principalSymbol θ, twoCoboundary_weldAffinePrimitive θ⟩

/-- An admissible order-zero gauge cochain has vanishing principal symbol pointwise. -/
def IsOrderZeroAffineCochain (θ : ℝ) (b : WeldGroup → WeldAffineCoeff θ) : Prop :=
  ∀ g, weldPrincipalSymbol θ (b g) = 0

/-- Order-zero affine gauge cochains form an additive subgroup. -/
def orderZeroAffineCochains (θ : ℝ) :
    AddSubgroup (WeldGroup → WeldAffineCoeff θ) where
  carrier := IsOrderZeroAffineCochain θ
  zero_mem' := by intro g; rfl
  add_mem' := by
    intro b c hb hc
    change IsOrderZeroAffineCochain θ b at hb
    change IsOrderZeroAffineCochain θ c at hc
    change IsOrderZeroAffineCochain θ (b + c)
    intro g
    change (b g).1 + (c g).1 = 0
    have hbg : (b g).1 = 0 := hb g
    have hcg : (c g).1 = 0 := hc g
    rw [hbg, hcg, zero_add]
  neg_mem' := by
    intro b hb
    change IsOrderZeroAffineCochain θ b at hb
    change IsOrderZeroAffineCochain θ (-b)
    intro g
    change -(b g).1 = 0
    have hbg : (b g).1 = 0 := hb g
    rw [hbg, neg_zero]

/-- No order-zero gauge can trivialize a nonzero weld cocycle. -/
theorem no_orderZeroAffinePrimitive {θ : ℝ} (hθ : θ ≠ 0) :
    ¬ ∃ b : WeldGroup → WeldAffineCoeff θ,
      IsOrderZeroAffineCochain θ b ∧ twoCoboundary b = weldAffineCocycle θ := by
  rintro ⟨b, hzero, hb⟩
  have hone : (b weldGenD).1 = 1 := weldAffinePrimitive_derivCoeff_eq_one hθ hb
  have hz := hzero weldGenD
  change (b weldGenD).1 = 0 at hz
  linarith

/-- Coboundaries generated by order-zero affine gauge cochains. -/
def orderZeroTwoCoboundaries (θ : ℝ) :
    AddSubgroup (twoCocycles (G := WeldGroup) (A := WeldAffineCoeff θ)) where
  carrier := fun omega => ∃ b : WeldGroup → WeldAffineCoeff θ,
    IsOrderZeroAffineCochain θ b ∧ omega = twoCoboundaryCocycle b
  zero_mem' := by
    refine ⟨0, (orderZeroAffineCochains θ).zero_mem, ?_⟩
    exact (twoCoboundaryCocycle_zero (G := WeldGroup) (A := WeldAffineCoeff θ)).symm
  add_mem' := by
    rintro omega eta ⟨b, hb, rfl⟩ ⟨c, hc, rfl⟩
    refine ⟨b + c, (orderZeroAffineCochains θ).add_mem hb hc, ?_⟩
    exact (twoCoboundaryCocycle_add b c).symm
  neg_mem' := by
    rintro omega ⟨b, hb, rfl⟩
    refine ⟨-b, (orderZeroAffineCochains θ).neg_mem hb, ?_⟩
    exact (twoCoboundaryCocycle_neg b).symm

/-- Closed affine two-cochains modulo only order-zero gauge coboundaries. -/
abbrev OrderZeroGaugeCohomology (θ : ℝ) :=
  twoCocycles (G := WeldGroup) (A := WeldAffineCoeff θ) ⧸ orderZeroTwoCoboundaries θ

/-- The weld class in order-zero gauge cohomology. -/
def weldAffineOrderZeroClass (θ : ℝ) : OrderZeroGaugeCohomology θ :=
  QuotientAddGroup.mk ⟨weldAffineCocycle θ, weldAffineCocycle_isTwoCocycle θ⟩

/-- Zero in the filtered quotient is equivalent to the existence of an order-zero primitive. -/
theorem weldAffineOrderZeroClass_eq_zero_iff (θ : ℝ) :
    weldAffineOrderZeroClass θ = 0 ↔
      ∃ b : WeldGroup → WeldAffineCoeff θ,
        IsOrderZeroAffineCochain θ b ∧ twoCoboundary b = weldAffineCocycle θ := by
  rw [weldAffineOrderZeroClass, QuotientAddGroup.eq_zero_iff]
  constructor
  · rintro ⟨b, hb, hclass⟩
    refine ⟨b, hb, ?_⟩
    have hval := congrArg Subtype.val hclass
    simpa only [cocycleOf, twoCoboundaryCocycle] using hval.symm
  · rintro ⟨b, hb, hraw⟩
    refine ⟨b, hb, ?_⟩
    apply Subtype.ext
    simpa only [cocycleOf, twoCoboundaryCocycle] using hraw.symm

/-- The order-zero gauge class is nonzero at every nonzero conversion rate. -/
theorem weldAffineOrderZeroClass_ne_zero {θ : ℝ} (hθ : θ ≠ 0) :
    weldAffineOrderZeroClass θ ≠ 0 := by
  rw [Ne, weldAffineOrderZeroClass_eq_zero_iff]
  exact no_orderZeroAffinePrimitive hθ

/-- Every prime supplies a nonzero order-zero gauge weld class. -/
theorem prime_weldAffineOrderZeroClass_ne_zero {p : ℕ} (hp : p.Prime) :
    weldAffineOrderZeroClass (Real.log p) ≠ 0 :=
  weldAffineOrderZeroClass_ne_zero (ne_of_gt (Real.log_pos (by exact_mod_cast hp.one_lt)))

/-- **Filtration trichotomy.**  A nonzero scalar weld is exact after arbitrary affine gauge and
remains exact under genuine FE-covariant affine gauge, but is nonzero under order-zero gauge. -/
theorem weld_scalar_affine_orderZero_trichotomy {θ : ℝ} (hθ : θ ≠ 0) :
    obstructionClassOf (weldCocycle θ) (weldCocycle_isTwoCocycle θ) ≠ 0 ∧
      obstructionClassOf (weldAffineCocycle θ) (weldAffineCocycle_isTwoCocycle θ) = 0 ∧
      weldAffineOrderZeroClass θ ≠ 0 ∧
      ∃ b : WeldGroup → WeldAffineCoeff θ,
        IsFECovariantAffineCochain θ b ∧ twoCoboundary b = weldAffineCocycle θ :=
  ⟨(weld_obstruction_ne_zero_iff θ).2 hθ, weldAffine_obstruction_eq_zero θ,
    weldAffineOrderZeroClass_ne_zero hθ, exists_FECovariantAffinePrimitive θ⟩

/-- Prime specialization of the complete filtration trichotomy. -/
theorem prime_weld_scalar_affine_orderZero_trichotomy {p : ℕ} (hp : p.Prime) :
    obstructionClassOf (weldCocycle (Real.log p))
        (weldCocycle_isTwoCocycle (Real.log p)) ≠ 0 ∧
      obstructionClassOf (weldAffineCocycle (Real.log p))
        (weldAffineCocycle_isTwoCocycle (Real.log p)) = 0 ∧
      weldAffineOrderZeroClass (Real.log p) ≠ 0 ∧
      ∃ b : WeldGroup → WeldAffineCoeff (Real.log p),
        IsFECovariantAffineCochain (Real.log p) b ∧
          twoCoboundary b = weldAffineCocycle (Real.log p) :=
  weld_scalar_affine_orderZero_trichotomy
    (ne_of_gt (Real.log_pos (by exact_mod_cast hp.one_lt)))

end GaloisForLFunctions.RHTower
