import GaloisForLFunctions.RHTower.DeningerPacketFrobeniusQuotient
import Mathlib.RingTheory.ZMod.UnitsCyclic
import Mathlib.Topology.Instances.ZMod
import Mathlib.Topology.LocallyConstant.Basic

/-!
# Nontriviality of the prime-packet Frobenius quotient

The quotient of `∏_{ℓ ≠ p} ℤ_ℓˣ` by the closed cyclic subgroup generated by the
diagonal prime `p` is never a point.  This is not automatic: a procyclic product can have a dense
cyclic subgroup.  We rule it out through explicit finite noncyclic quotients.

For odd `p`, reduction of the `2`-adic coordinate modulo `8` surjects onto the noncyclic group
`(ZMod 8)ˣ`.  At `p = 2`, the product of reductions at `3` and `5` surjects onto
`(ZMod 3)ˣ × (ZMod 5)ˣ`, which is noncyclic because its factor orders `2` and `4` are not
coprime.  A dense cyclic subgroup would have cyclic image in every continuous finite quotient,
giving the contradiction.

Besides closing a possible vacuity in the packet construction, the proof supplies reusable
infrastructure for continuous finite reductions of `p`-adic unit groups.
-/

namespace RHTower

open Set

noncomputable section

/-- Reduction modulo `ℓ^n` is locally constant, hence continuous, on `ℓ`-adic integers. -/
theorem deningerToZModPow_continuous (l n : ℕ) [Fact l.Prime] :
    Continuous (PadicInt.toZModPow (p := l) n) := by
  apply IsLocallyConstant.continuous
  rw [IsLocallyConstant.iff_eventually_eq]
  intro x
  filter_upwards [Metric.ball_mem_nhds x
    (show 0 < (l : ℝ) ^ (-(n : ℤ)) by
      exact zpow_pos (by exact_mod_cast (Fact.out : l.Prime).pos) _)] with y hy
  rw [Metric.mem_ball, dist_eq_norm] at hy
  apply sub_eq_zero.mp
  rw [← map_sub, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
    ← PadicInt.norm_le_pow_iff_mem_span_pow]
  exact hy.le

/-- Reduction of `ℓ`-adic units modulo `ℓ^n`. -/
def deningerPadicUnitReduction (l n : ℕ) [Fact l.Prime] :
    ℤ_[l]ˣ →* (ZMod (l ^ n))ˣ :=
  Units.map (PadicInt.toZModPow n).toMonoidHom

/-- Unit reduction is continuous. -/
theorem deningerPadicUnitReduction_continuous (l n : ℕ) [Fact l.Prime] :
    Continuous (deningerPadicUnitReduction l n) := by
  apply Units.continuous_iff.mpr
  constructor
  · exact (deningerToZModPow_continuous l n).comp Units.continuous_val
  · exact (deningerToZModPow_continuous l n).comp Units.continuous_coe_inv

/-- For positive exponent, every unit modulo `ℓ^n` lifts to an `ℓ`-adic unit. -/
theorem deningerPadicUnitReduction_surjective (l n : ℕ) [Fact l.Prime]
    (hn : n ≠ 0) : Function.Surjective (deningerPadicUnitReduction l n) := by
  intro u
  have hcoprimePow : u.val.val.Coprime (l ^ n) := ZMod.val_coe_unit_coprime u
  have hcoprime : l.Coprime u.val.val := by
    exact ((Nat.coprime_pow_right_iff (Nat.pos_of_ne_zero hn) u.val.val l).mp
      hcoprimePow).symm
  have hunit : IsUnit ((u.val.val : ℕ) : ℤ_[l]) := by
    rw [PadicInt.isUnit_iff, PadicInt.norm_natCast_eq_one_iff]
    exact hcoprime
  refine ⟨hunit.unit, ?_⟩
  apply Units.ext
  simp only [deningerPadicUnitReduction, Units.coe_map]
  rw [IsUnit.unit_spec]
  calc
    PadicInt.toZModPow n ((u.val.val : ℕ) : ℤ_[l]) =
        (u.val.val : ZMod (l ^ n)) := by exact map_natCast _ _
    _ = u.val := ZMod.natCast_zmod_val u.val

/-- Reduce one away-prime coordinate of the full packet modulo a prime power. -/
def deningerPacketCoordinateReduction (p : Nat.Primes)
    (l : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)}) (n : ℕ) :
    DeningerPacketUnits p →* (ZMod ((l.1 : ℕ) ^ n))ˣ :=
  (deningerPadicUnitReduction (l.1 : ℕ) n).comp
    { toFun := fun u => u l
      map_one' := rfl
      map_mul' := fun _ _ => rfl }

/-- Coordinate reduction of the packet is continuous. -/
theorem deningerPacketCoordinateReduction_continuous (p : Nat.Primes)
    (l : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)}) (n : ℕ) :
    Continuous (deningerPacketCoordinateReduction p l n) := by
  exact (deningerPadicUnitReduction_continuous (l.1 : ℕ) n).comp
    (continuous_apply l)

/-- A packet coordinate can be prescribed arbitrarily at every positive finite level. -/
theorem deningerPacketCoordinateReduction_surjective (p : Nat.Primes)
    (l : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)}) (n : ℕ) (hn : n ≠ 0) :
    Function.Surjective (deningerPacketCoordinateReduction p l n) := by
  intro v
  obtain ⟨w, hw⟩ := deningerPadicUnitReduction_surjective (l.1 : ℕ) n hn v
  classical
  let u : DeningerPacketUnits p := fun j => if h : j = l then h ▸ w else 1
  refine ⟨u, ?_⟩
  change deningerPadicUnitReduction (l.1 : ℕ) n (u l) = v
  simpa [u] using hw

/-- A topologically cyclic group cannot surject continuously onto a finite noncyclic group. -/
theorem deningerTopologicalCyclicClosure_ne_top_of_finiteNoncyclicQuotient
    {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group H] [TopologicalSpace H] [T1Space H] [Finite H]
    (f : G →* H) (hf : Continuous f) (hsurj : Function.Surjective f)
    (a : G) (hncyc : ¬ IsCyclic H) :
    (Subgroup.zpowers a).topologicalClosure ≠ ⊤ := by
  intro htop
  have hle0 : Subgroup.zpowers a ≤ (Subgroup.zpowers (f a)).comap f := by
    rw [Subgroup.zpowers_le]
    exact Subgroup.mem_comap.mpr (Subgroup.mem_zpowers _)
  have hclosed : IsClosed (((Subgroup.zpowers (f a)).comap f : Subgroup G) : Set G) := by
    change IsClosed (f ⁻¹' (Subgroup.zpowers (f a) : Set H))
    exact (Set.toFinite _).isClosed.preimage hf
  have hle := Subgroup.topologicalClosure_minimal _ hle0 hclosed
  rw [htop] at hle
  have htarget : Subgroup.zpowers (f a) = ⊤ := by
    apply (Subgroup.eq_top_iff' _).2
    intro y
    obtain ⟨x, rfl⟩ := hsurj y
    exact hle (Set.mem_univ x)
  exact hncyc (isCyclic_iff_exists_zpowers_eq_top.mpr ⟨f a, htarget⟩)

/-- At an odd prime, reduction of the `2`-adic packet coordinate modulo `8` obstructs density. -/
theorem deningerOddPrime_packetFrobeniusClosure_ne_top
    (p : Nat.Primes) (hp : (p : ℕ) ≠ 2) :
    deningerPacketFrobeniusClosure p ≠ ⊤ := by
  let l2 : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)} :=
    ⟨⟨2, Nat.prime_two⟩, Ne.symm hp⟩
  have hncyc : ¬ IsCyclic (ZMod ((l2.1 : ℕ) ^ 3))ˣ := by
    change ¬ IsCyclic (ZMod 8)ˣ
    exact ZMod.not_isCyclic_units_eight
  have h := deningerTopologicalCyclicClosure_ne_top_of_finiteNoncyclicQuotient
    (deningerPacketCoordinateReduction p l2 3)
    (deningerPacketCoordinateReduction_continuous p l2 3)
    (deningerPacketCoordinateReduction_surjective p l2 3 (by omega))
    (deningerPacketFrobeniusUnit p) hncyc
  simpa [deningerPacketFrobeniusClosure, deningerPacketFrobeniusCyclic] using h

/-- At `p = 2`, the paired reductions at `3` and `5` give a noncyclic finite quotient. -/
theorem deningerPrimeTwo_packetFrobeniusClosure_ne_top :
    deningerPacketFrobeniusClosure ⟨2, Nat.prime_two⟩ ≠ ⊤ := by
  let p : Nat.Primes := ⟨2, Nat.prime_two⟩
  let l3 : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)} :=
    ⟨⟨3, Nat.prime_three⟩, by norm_num [p]⟩
  let l5 : {l : Nat.Primes // (l : ℕ) ≠ (p : ℕ)} :=
    ⟨⟨5, Nat.prime_five⟩, by norm_num [p]⟩
  let f3 := deningerPacketCoordinateReduction p l3 1
  let f5 := deningerPacketCoordinateReduction p l5 1
  let f := f3.prod f5
  letI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hf : Continuous f := by
    exact (deningerPacketCoordinateReduction_continuous p l3 1).prodMk
      (deningerPacketCoordinateReduction_continuous p l5 1)
  have hsurj : Function.Surjective f := by
    rintro ⟨v3, v5⟩
    obtain ⟨w3, hw3⟩ :=
      deningerPadicUnitReduction_surjective 3 1 (by omega) v3
    obtain ⟨w5, hw5⟩ :=
      deningerPadicUnitReduction_surjective 5 1 (by omega) v5
    have h35 : l3 ≠ l5 := by
      intro h
      have := congrArg (fun l => (l.1 : ℕ)) h
      norm_num [l3, l5] at this
    let u : DeningerPacketUnits p :=
      Function.update (Function.update (fun _ => 1) l3 w3) l5 w5
    refine ⟨u, ?_⟩
    apply Prod.ext
    · change deningerPadicUnitReduction 3 1 (u l3) = v3
      simpa [u, h35] using hw3
    · change deningerPadicUnitReduction 5 1 (u l5) = v5
      simpa [u] using hw5
  have hncyc : ¬ IsCyclic
      ((ZMod ((l3.1 : ℕ) ^ 1))ˣ × (ZMod ((l5.1 : ℕ) ^ 1))ˣ) := by
    change ¬ IsCyclic ((ZMod 3)ˣ × (ZMod 5)ˣ)
    intro hcyc
    letI := hcyc
    have hc := coprime_card_of_isCyclic_prod (ZMod 3)ˣ (ZMod 5)ˣ
    have h3 : Nat.card (ZMod 3)ˣ = 2 := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime Nat.prime_three]
    have h5 : Nat.card (ZMod 5)ˣ = 4 := by
      rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime Nat.prime_five]
    rw [h3, h5] at hc
    norm_num at hc
  have h := deningerTopologicalCyclicClosure_ne_top_of_finiteNoncyclicQuotient
    f hf hsurj (deningerPacketFrobeniusUnit p) hncyc
  simpa [p, deningerPacketFrobeniusClosure, deningerPacketFrobeniusCyclic] using h

/-- The diagonal Frobenius closure is a proper subgroup at every prime. -/
theorem deningerPacketFrobeniusClosure_ne_top (p : Nat.Primes) :
    deningerPacketFrobeniusClosure p ≠ ⊤ := by
  by_cases hp : (p : ℕ) = 2
  · have hp' : p = ⟨2, Nat.prime_two⟩ := Subtype.ext hp
    subst p
    exact deningerPrimeTwo_packetFrobeniusClosure_ne_top
  · exact deningerOddPrime_packetFrobeniusClosure_ne_top p hp

/-- **The concrete Frobenius quotient packet is nontrivial at every prime.** -/
noncomputable instance deningerPacketFrobeniusQuotientNontrivial (p : Nat.Primes) :
    Nontrivial (DeningerPacketFrobeniusQuotient p) := by
  rw [← not_subsingleton_iff_nontrivial, QuotientGroup.subsingleton_iff]
  exact deningerPacketFrobeniusClosure_ne_top p

end

end RHTower
