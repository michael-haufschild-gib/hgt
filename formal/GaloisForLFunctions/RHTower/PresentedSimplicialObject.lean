import Mathlib.AlgebraicTopology.SimplexCategory.GeneratorsRelations.Basic

/-!
# Simplicial objects through the generator-and-relation presentation

`SimplexCategoryGenRel` is the category generated by the cofaces and codegeneracies modulo the
five simplicial identities.  A contravariant functor out of this category is therefore the
literal generators-and-relations definition of a simplicial object.  This interface is useful
when constructing a new simplicial object from explicit face and degeneracy operators: it does
not depend on the still-unfinished mathlib proof that the presentation functor to
`SimplexCategory` is an equivalence.
-/

noncomputable section

open CategoryTheory

universe u v

namespace GaloisForLFunctions
namespace RHTower

/-- A simplicial object defined on the category presented by faces, degeneracies, and the five
simplicial identities. -/
abbrev PresentedSimplicialObject (C : Type u) [Category.{v} C] :=
  SimplexCategoryGenRelᵒᵖ ⥤ C

namespace PresentedSimplicialObject

variable {C : Type u} [Category.{v} C]

/-- Degree-`n` object of a presented simplicial object. -/
abbrev degree (X : PresentedSimplicialObject C) (n : ℕ) : C :=
  X.obj (Opposite.op (SimplexCategoryGenRel.mk n))

/-- The `i`-th face map. -/
def δ (X : PresentedSimplicialObject C) {n : ℕ} (i : Fin (n + 2)) :
    X.degree (n + 1) ⟶ X.degree n :=
  X.map (SimplexCategoryGenRel.δ i).op

/-- The `i`-th degeneracy map. -/
def σ (X : PresentedSimplicialObject C) {n : ℕ} (i : Fin (n + 1)) :
    X.degree n ⟶ X.degree (n + 1) :=
  X.map (SimplexCategoryGenRel.σ i).op

@[simp]
theorem δ_def (X : PresentedSimplicialObject C) {n : ℕ} (i : Fin (n + 2)) :
    X.δ i = X.map (SimplexCategoryGenRel.δ i).op :=
  rfl

@[simp]
theorem σ_def (X : PresentedSimplicialObject C) {n : ℕ} (i : Fin (n + 1)) :
    X.σ i = X.map (SimplexCategoryGenRel.σ i).op :=
  rfl

end PresentedSimplicialObject

end RHTower
end GaloisForLFunctions
