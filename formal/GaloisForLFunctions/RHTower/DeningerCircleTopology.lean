import GaloisForLFunctions.RHTower.DeningerSplitBounded
import GaloisForLFunctions.RHTower.DeningerMeyerTopology

/-!
# The `C^∞` topology of the prime circle

The `C^r` sup-seminorms make the smooth periodic functions a locally convex space, carried by a type
synonym so that the pointwise subspace topology is not shadowed.  Both arrows of the periodization
sequence are bounded for these families, hence continuous.

* `deningerPeriodicSeminorm` : the `C^r` seminorm as a `Seminorm`.
* `DeningerCircle` : `C^∞(ℝ/Lℤ)` with its own topology.
* `deningerPeriodizationCLM` : **`Per_L` is continuous.**
* `deningerSplitCLM` : **the section `s_χ` is continuous.**
-/

namespace RHTower

open SchwartzMap

noncomputable section

variable {L : ℝ}

theorem deningerPeriodicSup_add_le (hL : 0 < L) (r : ℕ) (F G : DeningerSmoothPeriodic L) :
    deningerPeriodicSup r (F + G) ≤ deningerPeriodicSup r F + deningerPeriodicSup r G := by
  obtain ⟨M, _, hM⟩ := deningerSmoothPeriodic_iteratedFDeriv_bounded hL (F + G) r
  refine ciSup_le fun t => ?_
  have hsplit : iteratedFDeriv ℝ r (((F + G : DeningerSmoothPeriodic L) : ℝ → ℂ)) t
      = iteratedFDeriv ℝ r ((F : DeningerSmoothPeriodic L) : ℝ → ℂ) t
        + iteratedFDeriv ℝ r ((G : DeningerSmoothPeriodic L) : ℝ → ℂ) t :=
    iteratedFDeriv_add_apply
      (((deningerSmoothPeriodic_contDiff F).of_le (by exact_mod_cast le_top)).contDiffAt)
      (((deningerSmoothPeriodic_contDiff G).of_le (by exact_mod_cast le_top)).contDiffAt)
  rw [hsplit]
  exact le_trans (norm_add_le _ _)
    (add_le_add (deningerPeriodicSup_le hL r F t) (deningerPeriodicSup_le hL r G t))

theorem deningerPeriodicSup_smul (hL : 0 < L) (r : ℕ) (c : ℂ) (F : DeningerSmoothPeriodic L) :
    deningerPeriodicSup r (c • F) = ‖c‖ * deningerPeriodicSup r F := by
  have hpt : ∀ t : ℝ, ‖iteratedFDeriv ℝ r (((c • F : DeningerSmoothPeriodic L) : ℝ → ℂ)) t‖
      = ‖c‖ * ‖iteratedFDeriv ℝ r ((F : DeningerSmoothPeriodic L) : ℝ → ℂ) t‖ := by
    intro t
    have hcoe : (((c • F : DeningerSmoothPeriodic L) : ℝ → ℂ))
        = c • ((F : DeningerSmoothPeriodic L) : ℝ → ℂ) := rfl
    rw [hcoe, iteratedFDeriv_const_smul_apply
        (((deningerSmoothPeriodic_contDiff F).of_le (by exact_mod_cast le_top)).contDiffAt),
      norm_smul]
  rw [deningerPeriodicSup, deningerPeriodicSup]
  rw [show (⨆ t : ℝ, ‖iteratedFDeriv ℝ r (((c • F : DeningerSmoothPeriodic L) : ℝ → ℂ)) t‖)
      = ⨆ t : ℝ, ‖c‖ * ‖iteratedFDeriv ℝ r ((F : DeningerSmoothPeriodic L) : ℝ → ℂ) t‖ from
    iSup_congr hpt]
  exact (Real.mul_iSup_of_nonneg (norm_nonneg c) _).symm

theorem deningerPeriodicSupLe_add_le (hL : 0 < L) (r : ℕ) (F G : DeningerSmoothPeriodic L) :
    deningerPeriodicSupLe r (F + G)
      ≤ deningerPeriodicSupLe r F + deningerPeriodicSupLe r G := by
  rw [deningerPeriodicSupLe, deningerPeriodicSupLe, deningerPeriodicSupLe, ← Finset.sum_add_distrib]
  exact Finset.sum_le_sum fun m _ => deningerPeriodicSup_add_le hL m F G

theorem deningerPeriodicSupLe_smul (hL : 0 < L) (r : ℕ) (c : ℂ) (F : DeningerSmoothPeriodic L) :
    deningerPeriodicSupLe r (c • F) = ‖c‖ * deningerPeriodicSupLe r F := by
  rw [deningerPeriodicSupLe, deningerPeriodicSupLe, Finset.mul_sum]
  exact Finset.sum_congr rfl fun m _ => deningerPeriodicSup_smul hL m c F

/-- The `C^r` seminorm of the prime circle. -/
def deningerPeriodicSeminorm (hL : 0 < L) (r : ℕ) : Seminorm ℂ (DeningerSmoothPeriodic L) :=
  Seminorm.of (deningerPeriodicSupLe r) (deningerPeriodicSupLe_add_le hL r)
    (deningerPeriodicSupLe_smul hL r)

@[simp]
theorem deningerPeriodicSeminorm_apply (hL : 0 < L) (r : ℕ) (F : DeningerSmoothPeriodic L) :
    deningerPeriodicSeminorm hL r F = deningerPeriodicSupLe r F := rfl

/-- **`C^∞(ℝ/Lℤ)`** carrying its own locally convex topology.  The period is bundled with its
positivity so that the topology is an instance. -/
def DeningerCircle (P : {x : ℝ // 0 < x}) : Type := ↥(DeningerSmoothPeriodic P.1)

namespace DeningerCircle

variable {P : {x : ℝ // 0 < x}}

noncomputable instance : AddCommGroup (DeningerCircle P) :=
  inferInstanceAs (AddCommGroup ↥(DeningerSmoothPeriodic P.1))

noncomputable instance : Module ℂ (DeningerCircle P) :=
  inferInstanceAs (Module ℂ ↥(DeningerSmoothPeriodic P.1))

/-- The identification with the underlying submodule. -/
noncomputable def toPeriodic : DeningerCircle P ≃ₗ[ℂ] ↥(DeningerSmoothPeriodic P.1) :=
  LinearEquiv.refl ℂ _

/-- The `C^r` seminorm family. -/
noncomputable def seminorms (P : {x : ℝ // 0 < x}) : SeminormFamily ℂ (DeningerCircle P) ℕ :=
  fun r => (deningerPeriodicSeminorm P.2 r).comp toPeriodic.toLinearMap

noncomputable instance : TopologicalSpace (DeningerCircle P) :=
  (seminorms P).moduleFilterBasis.topology'

/-- **The circle topology is generated by the `C^r` seminorms.** -/
theorem withSeminorms (P : {x : ℝ // 0 < x}) : WithSeminorms (seminorms P) := ⟨rfl⟩

@[simp]
theorem seminorms_apply (r : ℕ) (F : DeningerCircle P) :
    seminorms P r F = deningerPeriodicSupLe r (toPeriodic F) := rfl

instance : IsTopologicalAddGroup (DeningerCircle P) :=
  (seminorms P).addGroupFilterBasis.isTopologicalAddGroup

instance : ContinuousSMul ℂ (DeningerCircle P) := by
  rw [(withSeminorms P).withSeminorms_eq]
  exact (seminorms P).moduleFilterBasis.continuousSMul

end DeningerCircle

/-! ## Both arrows are continuous -/

/-- The periodization between the topologised spaces. -/
def deningerPeriodizationLM (P : {x : ℝ // 0 < x}) :
    DeningerMeyerSource →ₗ[ℂ] DeningerCircle P :=
  (DeningerCircle.toPeriodic (P := P)).symm.toLinearMap.comp
    ((deningerPeriodizationMap P.2).comp DeningerMeyerSource.toSource.toLinearMap)

/-- The splitting between the topologised spaces. -/
def deningerSplitLM (P : {x : ℝ // 0 < x}) : DeningerCircle P →ₗ[ℂ] DeningerMeyerSource :=
  DeningerMeyerSource.toSource.symm.toLinearMap.comp
    ((deningerPeriodizationSplit P.2).comp (DeningerCircle.toPeriodic (P := P)).toLinearMap)

/-- **The periodization is continuous.** -/
theorem deningerPeriodizationLM_continuous (P : {x : ℝ // 0 < x}) :
    Continuous (deningerPeriodizationLM P) := by
  refine WithSeminorms.continuous_of_isBounded DeningerMeyerSource.withSeminorms
    (DeningerCircle.withSeminorms P) _ fun r => ?_
  have hb : ∀ m : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ h : DeningerExpSchwartz, ∀ t : ℝ,
      ‖iteratedFDeriv ℝ m
          (deningerPeriodizationSum ((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) P.1) t‖
        ≤ K * deningerMeyerSeminormFun 1 m h :=
    fun m => deningerPeriodizationSum_iteratedFDeriv_bound P.2 m
  choose K hKnn hKle using hb
  set KS : ℝ := ∑ m ∈ Finset.range (r + 1), K m with hKS
  have hKSnn : 0 ≤ KS := Finset.sum_nonneg fun m _ => hKnn m
  set T : Finset (ℕ × ℕ) := Finset.image (fun m : ℕ => ((1 : ℕ), m)) (Finset.range (r + 1)) with hT
  refine ⟨T, ⟨KS * (r + 1), by positivity⟩, fun h => ?_⟩
  have hstep : ∀ m ∈ Finset.range (r + 1),
      deningerPeriodicSup m (deningerPeriodizationMap P.2 (DeningerMeyerSource.toSource h))
        ≤ KS * T.sup DeningerMeyerSource.seminorms h := by
    intro m hm
    have hmk : m ≤ r := Nat.lt_succ_iff.1 (Finset.mem_range.1 hm)
    refine ciSup_le fun t => ?_
    refine le_trans (hKle m (DeningerMeyerSource.toSource h) t) ?_
    have h1 : K m ≤ KS :=
      Finset.single_le_sum (f := K) (fun j _ => hKnn j) (Finset.mem_range.2 (Nat.lt_succ_of_le hmk))
    have hmem : ((1 : ℕ), m) ∈ T := Finset.mem_image.2 ⟨m, hm, rfl⟩
    have h2 : deningerMeyerSeminormFun 1 m (DeningerMeyerSource.toSource h)
        ≤ T.sup DeningerMeyerSource.seminorms h := by
      have hsup := Finset.le_sup (f := DeningerMeyerSource.seminorms) hmem
      simpa using hsup h
    have hnn : 0 ≤ deningerMeyerSeminormFun 1 m (DeningerMeyerSource.toSource h) :=
      deningerMeyerSeminormFun_nonneg 1 m _
    exact mul_le_mul h1 h2 hnn hKSnn
  have hbound : deningerPeriodicSupLe r
      (deningerPeriodizationMap P.2 (DeningerMeyerSource.toSource h))
      ≤ (KS * (r + 1)) * T.sup DeningerMeyerSource.seminorms h := by
    calc deningerPeriodicSupLe r
            (deningerPeriodizationMap P.2 (DeningerMeyerSource.toSource h))
        = ∑ m ∈ Finset.range (r + 1),
            deningerPeriodicSup m
              (deningerPeriodizationMap P.2 (DeningerMeyerSource.toSource h)) := rfl
      _ ≤ ∑ _m ∈ Finset.range (r + 1), KS * T.sup DeningerMeyerSource.seminorms h :=
          Finset.sum_le_sum hstep
      _ = (KS * (r + 1)) * T.sup DeningerMeyerSource.seminorms h := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          push_cast
          ring
  have hgoal : deningerPeriodicSupLe r
      (DeningerCircle.toPeriodic ((deningerPeriodizationLM P) h))
      = deningerPeriodicSupLe r
        (deningerPeriodizationMap P.2 (DeningerMeyerSource.toSource h)) := rfl
  exact hbound

/-- **The splitting is continuous.** -/
theorem deningerSplitLM_continuous (P : {x : ℝ // 0 < x}) :
    Continuous (deningerSplitLM P) := by
  refine WithSeminorms.continuous_of_isBounded (DeningerCircle.withSeminorms P)
    DeningerMeyerSource.withSeminorms _ fun m => ?_
  obtain ⟨K, hKnn, hK⟩ := deningerSplit_meyerSeminorm_bound P.2 (m.1 : ℝ) m.2
  refine ⟨{m.2}, ⟨K, hKnn⟩, fun F => ?_⟩
  have hb := hK (DeningerCircle.toPeriodic F)
  simp only [Finset.sup_singleton]
  exact hb

/-- **The periodization sequence is split strict.**  Both arrows are continuous, the section is a
continuous right inverse, and the kernel of the periodization is the image of the injective
periodization defect. -/
theorem deningerPeriodizationSequence_splitStrict (P : {x : ℝ // 0 < x}) :
    Continuous (deningerPeriodizationLM P)
      ∧ Continuous (deningerSplitLM P)
      ∧ (∀ F : DeningerCircle P, deningerPeriodizationLM P (deningerSplitLM P F) = F)
      ∧ Function.Injective (deningerPeriodizationDefect P.1)
      ∧ LinearMap.ker (deningerPeriodizationMap P.2)
          = LinearMap.range (deningerPeriodizationDefect P.1) :=
  ⟨deningerPeriodizationLM_continuous P, deningerSplitLM_continuous P,
    fun F => deningerPeriodizationMap_comp_split P.2 (DeningerCircle.toPeriodic F),
    deningerPeriodizationDefect_injective P.2, deningerPeriodizationMap_ker P.2⟩

end

end RHTower
