import GaloisForLFunctions.RHTower.SixExponentials.Setup
import GaloisForLFunctions.RHTower.BakerGeneralProof.AlgebraicFamilyField

/-!
# Six exponentials: the number field of the six exponentials and the scaled sample matrix

Assuming the six numbers `exp(x_i y_j)` are algebraic, they generate a number field `K` with a
distinguished embedding `σ : K → ℂ` and one nonzero rational integer `c` clearing all their
denominators.  The scaled sample entry

`entry(m, ab) = ∏_{i,j} (c · exp(x_i y_j))^{e_i(ab) n_j(m)} · c^{6LM − Σ e_i n_j}`

is an algebraic integer with `σ(entry) = c^{6LM} exp(λ_{ab} s_m)` and house at most `H^{6LM}`
for the fixed constant `H = 1 + |c| + Σ house(c · exp(x_i y_j))`.
-/

open Complex Finset NumberField

namespace GaloisForLFunctions.RHTower.SixExponentials

/-- The data together with algebraicity of the six exponentials. -/
structure AlgData extends Data where
  halg : ∀ i j, IsAlgebraic ℚ (toData.E i j)

namespace AlgData

variable (A : AlgData)

/-- The six exponentials as a family indexed by pairs. -/
noncomputable def fam : Fin 2 × Fin 3 → ℂ := fun p => A.toData.E p.1 p.2

theorem fam_algebraic (p : Fin 2 × Fin 3) : IsAlgebraic ℚ (A.fam p) := A.halg p.1 p.2

theorem fam_ne_zero (p : Fin 2 × Fin 3) : A.fam p ≠ 0 := A.toData.E_ne_zero p.1 p.2

/-- The number field generated by the six exponentials. -/
abbrev K : Type := BakerGeneralProof.AlgebraicFamilyField A.fam

noncomputable instance instNumberField : NumberField A.K :=
  BakerGeneralProof.algebraicFamilyNumberField A.fam A.fam_algebraic

/-- The distinguished embedding. -/
noncomputable def σ : A.K →+* ℂ := BakerGeneralProof.algebraicFamilyEmbedding A.fam

/-- The six exponentials as elements of `K`. -/
noncomputable def lift (p : Fin 2 × Fin 3) : A.K := BakerGeneralProof.algebraicFamilyLift A.fam p

theorem σ_lift (p : Fin 2 × Fin 3) : A.σ (A.lift p) = A.fam p :=
  BakerGeneralProof.algebraicFamilyEmbedding_lift A.fam p

theorem σ_injective : Function.Injective A.σ := A.σ.injective

theorem lift_ne_zero (p : Fin 2 × Fin 3) : A.lift p ≠ 0 :=
  BakerGeneralProof.algebraicFamilyLift_ne_zero A.fam p (A.fam_ne_zero p)

/-- A common nonzero integer denominator for the six exponentials. -/
noncomputable def scale : ℤ :=
  Classical.choose
    (BakerGeneralProof.exists_algebraicFamily_common_integer_scale A.fam A.fam_algebraic)

theorem scale_spec : A.scale ≠ 0 ∧ ∀ p, IsIntegral ℤ (A.scale • A.lift p) :=
  Classical.choose_spec
    (BakerGeneralProof.exists_algebraicFamily_common_integer_scale A.fam A.fam_algebraic)

theorem scale_ne_zero : A.scale ≠ 0 := A.scale_spec.1

/-- The scaled exponentials as algebraic integers. -/
noncomputable def β (p : Fin 2 × Fin 3) : 𝓞 A.K := ⟨A.scale • A.lift p, A.scale_spec.2 p⟩

/-- The scale as an algebraic integer. -/
noncomputable def cz : 𝓞 A.K := (A.scale : 𝓞 A.K)

theorem algebraMap_β (p : Fin 2 × Fin 3) :
    algebraMap (𝓞 A.K) A.K (A.β p) = A.scale • A.lift p := rfl

theorem algebraMap_cz : algebraMap (𝓞 A.K) A.K A.cz = (A.scale : A.K) := by
  unfold cz
  exact map_intCast _ _

theorem σ_β (p : Fin 2 × Fin 3) :
    A.σ (algebraMap (𝓞 A.K) A.K (A.β p)) = (A.scale : ℂ) * A.fam p := by
  rw [algebraMap_β, zsmul_eq_mul, map_mul, map_intCast, σ_lift]

theorem σ_cz : A.σ (algebraMap (𝓞 A.K) A.K A.cz) = (A.scale : ℂ) := by
  rw [algebraMap_cz, map_intCast]

theorem β_ne_zero (p : Fin 2 × Fin 3) : A.β p ≠ 0 := by
  intro h
  have h1 : algebraMap (𝓞 A.K) A.K (A.β p) = 0 := by rw [h, map_zero]
  rw [algebraMap_β, zsmul_eq_mul] at h1
  rcases mul_eq_zero.mp h1 with h2 | h2
  · exact A.scale_ne_zero (by exact_mod_cast h2)
  · exact A.lift_ne_zero p h2

theorem cz_ne_zero : A.cz ≠ 0 := by
  intro h
  have h1 : algebraMap (𝓞 A.K) A.K A.cz = 0 := by rw [h, map_zero]
  rw [algebraMap_cz] at h1
  exact A.scale_ne_zero (by exact_mod_cast h1)

/-- The scaled sample entry. -/
noncomputable def entry (L M : ℕ) (m : Fin 3 → Fin M) (ab : Fin L × Fin L) : 𝓞 A.K :=
  (∏ i, ∏ j, A.β (i, j) ^ Data.ex ab m i j) * A.cz ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j)

theorem entry_ne_zero (L M : ℕ) (m : Fin 3 → Fin M) (ab : Fin L × Fin L) :
    A.entry L M m ab ≠ 0 := by
  unfold entry
  refine mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun i _ =>
    Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero _ (A.β_ne_zero (i, j)))
    (pow_ne_zero _ A.cz_ne_zero)

/-- **The embedded entry is the scaled exponential monomial.** -/
theorem σ_entry (L M : ℕ) (m : Fin 3 → Fin M) (ab : Fin L × Fin L) :
    A.σ (algebraMap (𝓞 A.K) A.K (A.entry L M m ab))
      = (A.scale : ℂ) ^ (6 * L * M) * Complex.exp (A.toData.freq ab * A.toData.pt m) := by
  unfold entry
  rw [map_mul, map_mul, map_prod, map_prod, map_pow, map_pow, σ_cz]
  simp only [map_prod, map_pow, σ_β]
  rw [A.toData.exp_freq_mul_pt]
  have hsum := Data.sum_ex_le ab m
  have hsplit : ∏ i, ∏ j, ((A.scale : ℂ) * A.fam (i, j)) ^ Data.ex ab m i j
      = (A.scale : ℂ) ^ (∑ i, ∑ j, Data.ex ab m i j) * ∏ i, ∏ j, A.fam (i, j) ^ Data.ex ab m i j := by
    simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  rw [hsplit]
  have hpow : (A.scale : ℂ) ^ (∑ i, ∑ j, Data.ex ab m i j)
      * (A.scale : ℂ) ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j) = (A.scale : ℂ) ^ (6 * L * M) := by
    rw [← pow_add, Nat.add_sub_cancel' hsum]
  calc (A.scale : ℂ) ^ (∑ i, ∑ j, Data.ex ab m i j) * (∏ i, ∏ j, A.fam (i, j) ^ Data.ex ab m i j)
        * (A.scale : ℂ) ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j)
      = ((A.scale : ℂ) ^ (∑ i, ∑ j, Data.ex ab m i j)
        * (A.scale : ℂ) ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j))
        * ∏ i, ∏ j, A.fam (i, j) ^ Data.ex ab m i j := by ring
    _ = (A.scale : ℂ) ^ (6 * L * M) * ∏ i, ∏ j, A.toData.E i j ^ Data.ex ab m i j := by
        rw [hpow]
        rfl

/-! ### House bounds -/

/-- Indexed product bound for the house. -/
theorem house_prod_le_of_le {ι : Type*} (s : Finset ι) (f : ι → A.K) (g : ι → ℝ)
    (hg : ∀ i ∈ s, house (f i) ≤ g i) (hg0 : ∀ i ∈ s, 0 ≤ g i) :
    house (∏ i ∈ s, f i) ≤ ∏ i ∈ s, g i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.prod_empty]
    have : house ((1 : ℤ) : A.K) = ((|(1 : ℤ)| : ℤ) : ℝ) := house_intCast 1
    simp only [Int.cast_one, abs_one] at this
    rw [this]
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    have h1 := hg a (Finset.mem_insert_self a s)
    have h2 := ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))
      (fun i hi => hg0 i (Finset.mem_insert_of_mem hi))
    calc house (f a * ∏ i ∈ s, f i) ≤ house (f a) * house (∏ i ∈ s, f i) := house_mul_le _ _
      _ ≤ g a * ∏ i ∈ s, g i :=
          mul_le_mul h1 h2 (house_nonneg _) (hg0 a (Finset.mem_insert_self a s))

/-- The fixed house constant `H = 1 + |c| + Σ house(c · exp(x_i y_j))`. -/
noncomputable def Hb : ℝ :=
  1 + |(A.scale : ℝ)| + ∑ p, house (algebraMap (𝓞 A.K) A.K (A.β p))

theorem one_le_Hb : 1 ≤ A.Hb := by
  unfold Hb
  have h1 : 0 ≤ |(A.scale : ℝ)| := abs_nonneg _
  have h2 : 0 ≤ ∑ p, house (algebraMap (𝓞 A.K) A.K (A.β p)) :=
    Finset.sum_nonneg fun _ _ => house_nonneg _
  linarith

theorem abs_scale_le_Hb : |(A.scale : ℝ)| ≤ A.Hb := by
  unfold Hb
  have h2 : 0 ≤ ∑ p, house (algebraMap (𝓞 A.K) A.K (A.β p)) :=
    Finset.sum_nonneg fun _ _ => house_nonneg _
  linarith

theorem house_β_le_Hb (p : Fin 2 × Fin 3) : house (algebraMap (𝓞 A.K) A.K (A.β p)) ≤ A.Hb := by
  unfold Hb
  have h1 : 0 ≤ |(A.scale : ℝ)| := abs_nonneg _
  have h3 : house (algebraMap (𝓞 A.K) A.K (A.β p))
      ≤ ∑ q, house (algebraMap (𝓞 A.K) A.K (A.β q)) :=
    Finset.single_le_sum (f := fun q => house (algebraMap (𝓞 A.K) A.K (A.β q)))
      (fun _ _ => house_nonneg _) (Finset.mem_univ p)
  linarith

theorem house_cz_pow_le (k : ℕ) :
    house (algebraMap (𝓞 A.K) A.K (A.cz ^ k)) ≤ A.Hb ^ k := by
  rw [map_pow, algebraMap_cz]
  calc house ((A.scale : A.K) ^ k) ≤ house (A.scale : A.K) ^ k := house_pow_le _ _
    _ = |(A.scale : ℝ)| ^ k := by rw [house_intCast]; push_cast; rfl
    _ ≤ A.Hb ^ k := pow_le_pow_left₀ (abs_nonneg _) A.abs_scale_le_Hb k

/-- **House bound for the scaled entry.** -/
theorem house_entry_le (L M : ℕ) (m : Fin 3 → Fin M) (ab : Fin L × Fin L) :
    house (algebraMap (𝓞 A.K) A.K (A.entry L M m ab)) ≤ A.Hb ^ (6 * L * M) := by
  unfold entry
  rw [map_mul]
  have hH0 : 0 ≤ A.Hb := le_trans zero_le_one A.one_le_Hb
  have hprod : house (algebraMap (𝓞 A.K) A.K (∏ i, ∏ j, A.β (i, j) ^ Data.ex ab m i j))
      ≤ A.Hb ^ (∑ i, ∑ j, Data.ex ab m i j) := by
    rw [map_prod]
    calc house (∏ i, algebraMap (𝓞 A.K) A.K (∏ j, A.β (i, j) ^ Data.ex ab m i j))
        ≤ ∏ i, A.Hb ^ (∑ j, Data.ex ab m i j) := by
          apply A.house_prod_le_of_le
          · intro i _
            rw [map_prod]
            calc house (∏ j, algebraMap (𝓞 A.K) A.K (A.β (i, j) ^ Data.ex ab m i j))
                ≤ ∏ j, A.Hb ^ Data.ex ab m i j := by
                  apply A.house_prod_le_of_le
                  · intro j _
                    rw [map_pow]
                    calc house (algebraMap (𝓞 A.K) A.K (A.β (i, j)) ^ Data.ex ab m i j)
                        ≤ house (algebraMap (𝓞 A.K) A.K (A.β (i, j))) ^ Data.ex ab m i j :=
                          house_pow_le _ _
                      _ ≤ A.Hb ^ Data.ex ab m i j :=
                          pow_le_pow_left₀ (house_nonneg _) (A.house_β_le_Hb (i, j)) _
                  · intro j _
                    exact pow_nonneg hH0 _
              _ = A.Hb ^ (∑ j, Data.ex ab m i j) := by rw [Finset.prod_pow_eq_pow_sum]
          · intro i _
            exact pow_nonneg hH0 _
      _ = A.Hb ^ (∑ i, ∑ j, Data.ex ab m i j) := by rw [Finset.prod_pow_eq_pow_sum]
  calc house (algebraMap (𝓞 A.K) A.K (∏ i, ∏ j, A.β (i, j) ^ Data.ex ab m i j)
        * algebraMap (𝓞 A.K) A.K (A.cz ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j)))
      ≤ house (algebraMap (𝓞 A.K) A.K (∏ i, ∏ j, A.β (i, j) ^ Data.ex ab m i j))
        * house (algebraMap (𝓞 A.K) A.K (A.cz ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j))) :=
        house_mul_le _ _
    _ ≤ A.Hb ^ (∑ i, ∑ j, Data.ex ab m i j) * A.Hb ^ (6 * L * M - ∑ i, ∑ j, Data.ex ab m i j) :=
        mul_le_mul hprod (A.house_cz_pow_le _) (house_nonneg _) (pow_nonneg hH0 _)
    _ = A.Hb ^ (6 * L * M) := by
        rw [← pow_add, Nat.add_sub_cancel' (Data.sum_ex_le ab m)]

end AlgData

end GaloisForLFunctions.RHTower.SixExponentials
