import GaloisForLFunctions.RHTower.PrimeBurnolFourierJetCellInvertibility

/-!
# Complete varying-prime cubic relation at balancing parameters

Retain every finite packet with its prime-dependent theta matrix, actual two-output
Gram inverse, and complete cubic. At a prime balancing parameter the linear relation
generated by these packet graphs has closure G × G. At zero its closure is G × {0}.
This concerns finite sums of packet graphs; refinement compatibility is not assumed.
The saturation theorem rules out a single-valued closed extension retaining every
packet action. It makes no Gamma–Xi, Hardy-index, or Riemann-hypothesis claim.
-/

open Complex Set Filter Topology Matrix
open GaloisForLFunctions GaloisForLFunctions.HTGeometry
noncomputable section
namespace RHTower

/-- Actual theta parameters follow the prime at each packet coordinate. -/
def primeBurnolFourierJetThetaMatrix {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (a : ℝ) :
    Matrix (Fin N ⊕ Fin N) (Fin N ⊕ Fin N) ℂ :=
  Matrix.fromBlocks (Matrix.diagonal fun i => (primeBurnolThetaVisibility a (pe i).1 : ℂ)^2)
    (Matrix.diagonal fun i => (primeBurnolThetaVisibility a (pe i).1 : ℂ)*
      (primeBurnolThetaContrast a (pe i).1 : ℂ))
    (Matrix.diagonal fun i => (primeBurnolThetaVisibility a (pe i).1 : ℂ)*
      (primeBurnolThetaContrast a (pe i).1 : ℂ))
    (Matrix.diagonal fun i => (primeBurnolThetaContrast a (pe i).1 : ℂ)^2)

def primeBurnolFourierJetCubic {N : ℕ} (pe : Fin N ↪ Nat.Primes × ℕ) (a : ℝ) :
    Matrix (Fin N ⊕ Fin N) (Fin N ⊕ Fin N) ℂ :=
  cubicProjectionAssociatorAlgebra
    (sourceModularAutomorphism (primeBurnolFourierJetGramUnit pe) (primeBurnolFourierJetThetaMatrix pe a))
    (primeBurnolFourierJetThetaMatrix pe a) (burnolJetNeutralMatrix N)

def primeBurnolJetPacketSynthesis {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) :
    (Fin N ⊕ Fin N → ℂ) →ₗ[ℂ] BurnolJetAmbient :=
  Fintype.linearCombination ℂ (primeBurnolJetGraphColumn pe)

/-- The linear relation generated by every actual finite-packet complete cubic. -/
def primeBurnolFourierJetCubicRelation (a : ℝ) :
    Submodule ℂ (BurnolJetAmbient × BurnolJetAmbient) :=
  Submodule.span ℂ {z | ∃ (N : ℕ) (pe : Fin N ↪ Nat.Primes × ℕ) (x : Fin N ⊕ Fin N → ℂ),
    z=(primeBurnolJetPacketSynthesis pe x,
      primeBurnolJetPacketSynthesis pe ((primeBurnolFourierJetCubic pe a).mulVec x))}

theorem primeBurnolFourierJetCubic_singleton (pe : Nat.Primes × ℕ) (a : ℝ) :
    primeBurnolFourierJetCubic (primeBurnolSingletonPacket pe) a=
      primeBurnolFourierJetConstantThetaCubic (primeBurnolSingletonPacket pe) pe.1 a := by
  have h : primeBurnolFourierJetThetaMatrix (primeBurnolSingletonPacket pe) a=
      burnolJetThetaMatrix 1 pe.1 a := by
    ext i j
    cases i <;> cases j <;>
      simp [primeBurnolFourierJetThetaMatrix,primeBurnolSingletonPacket,burnolJetThetaMatrix,
        Matrix.diagonal,Matrix.one_apply,mul_ite]
  simp only [primeBurnolFourierJetCubic,h,primeBurnolFourierJetConstantThetaCubic]

theorem primeBurnolJetGraphColumn_mem_even {N : ℕ} (pe : Fin N → Nat.Primes × ℕ)
    (i : Fin N ⊕ Fin N) : primeBurnolJetGraphColumn pe i ∈ primeBurnolFourierJetEvenGraph := by
  cases i with
  | inl i =>
    exact (mem_primeBurnolFourierJetEvenGraph _).mpr
      ⟨_,0,primeBurnolEvenFeatureLp_mem_evenSubspace _,evenSubspace.zero_mem,rfl⟩
  | inr i =>
    exact (mem_primeBurnolFourierJetEvenGraph _).mpr
      ⟨0,_,evenSubspace.zero_mem,primeBurnolEvenFeatureLp_mem_evenSubspace _,rfl⟩

theorem primeBurnolJetPacketSynthesis_mem_even {N : ℕ} (pe : Fin N → Nat.Primes × ℕ)
    (x : Fin N ⊕ Fin N → ℂ) : primeBurnolJetPacketSynthesis pe x ∈ primeBurnolFourierJetEvenGraph := by
  change ∑ i, x i • primeBurnolJetGraphColumn pe i ∈ primeBurnolFourierJetEvenGraph
  exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (primeBurnolJetGraphColumn_mem_even pe i))

theorem primeBurnolFourierJetCubicRelation_le (a : ℝ) :
    primeBurnolFourierJetCubicRelation a ≤
      primeBurnolFourierJetEvenGraph.prod primeBurnolFourierJetEvenGraph := by
  apply Submodule.span_le.mpr
  rintro z ⟨N,pe,x,rfl⟩
  exact ⟨primeBurnolJetPacketSynthesis_mem_even pe x,primeBurnolJetPacketSynthesis_mem_even pe _⟩

theorem primeBurnolFourierJetCubicRelation_packet {N : ℕ} (pe : Fin N ↪ Nat.Primes × ℕ)
    (a : ℝ) (x : Fin N ⊕ Fin N → ℂ) :
    (primeBurnolJetPacketSynthesis pe x,
      primeBurnolJetPacketSynthesis pe ((primeBurnolFourierJetCubic pe a).mulVec x)) ∈
        primeBurnolFourierJetCubicRelation a :=
  Submodule.subset_span ⟨N,pe,x,rfl⟩

/-- The tail statement retains both original input coordinates and both jet outputs. -/
theorem primeBurnolJetTail_columns_dense (p : Nat.Primes) (N : ℕ)
    (L : Submodule ℂ BurnolJetAmbient) (hL : IsClosed (L : Set BurnolJetAmbient))
    (hcol : ∀ n i, primeBurnolJetGraphColumn (primeBurnolSingletonPacket (p,n+N)) i ∈ L) :
    primeBurnolFourierJetEvenGraph.topologicalClosure ≤ L := by
  have hl : primeBurnolSquareGraphTailCore p N ≤
      L.comap (burnolJetGraphAssembly.toLinearMap ∘ₗ
        LinearMap.inl ℂ (SoninL2 × SoninL2) (SoninL2 × SoninL2)) := by
    apply Submodule.span_le.mpr
    rintro z ⟨n,rfl⟩
    change burnolJetGraphAssembly
      ((primeBurnolEvenFeatureLp (p,n+N),burnolSquarePosition (primeBurnolSquareColumn (p,n+N))),0) ∈ L
    simpa [primeBurnolJetGraphColumn,primeBurnolSingletonPacket,burnolJetGraphVector,
      primeBurnolFourierJetSynthesis,burnolJetGraphAssembly] using! hcol n (Sum.inl 0)
  have hr : primeBurnolSquareGraphTailCore p N ≤
      L.comap (burnolJetGraphAssembly.toLinearMap ∘ₗ
        LinearMap.inr ℂ (SoninL2 × SoninL2) (SoninL2 × SoninL2)) := by
    apply Submodule.span_le.mpr
    rintro z ⟨n,rfl⟩
    change burnolJetGraphAssembly
      (0,(primeBurnolEvenFeatureLp (p,n+N),burnolSquarePosition (primeBurnolSquareColumn (p,n+N)))) ∈ L
    simpa [primeBurnolJetGraphColumn,primeBurnolSingletonPacket,burnolJetGraphVector,
      primeBurnolFourierJetSynthesis,burnolJetGraphAssembly] using! hcol n (Sum.inr 0)
  rw [← primeBurnolFourierJetTailGraph_closure p N]
  apply Submodule.topologicalClosure_minimal _ _ hL
  rintro z ⟨v,hv,rfl⟩
  have h := L.add_mem (hl hv.1) (hr hv.2)
  change burnolJetGraphAssembly (v.1,0)+burnolJetGraphAssembly (0,v.2) ∈ L at h
  simpa only [← map_add,Prod.mk_add_mk,add_zero,zero_add] using! h

private theorem horizontal_of_singleton_zero (p : Nat.Primes) (a : ℝ)
    (hz : ∀ n, primeBurnolFourierJetCubic (primeBurnolSingletonPacket (p,n)) a=0) :
    ∀ w ∈ primeBurnolFourierJetEvenGraph.topologicalClosure,
      (w,0) ∈ (primeBurnolFourierJetCubicRelation a).topologicalClosure := by
  let L := (primeBurnolFourierJetCubicRelation a).topologicalClosure
  let H : Submodule ℂ BurnolJetAmbient := L.comap (LinearMap.inl ℂ _ _)
  have hH : IsClosed (H : Set BurnolJetAmbient) := by
    change IsClosed ((fun w : BurnolJetAmbient => (w,(0 : BurnolJetAmbient))) ⁻¹' (L : Set _))
    exact (primeBurnolFourierJetCubicRelation a).isClosed_topologicalClosure.preimage (by fun_prop)
  apply primeBurnolJetTail_columns_dense p 0 H hH
  intro n i
  have h := (primeBurnolFourierJetCubicRelation a).le_topologicalClosure
    (primeBurnolFourierJetCubicRelation_packet (primeBurnolSingletonPacket (p,n)) a (Pi.single i 1))
  rw [hz] at h
  change (primeBurnolJetGraphColumn (primeBurnolSingletonPacket (p,n+0)) i,0) ∈ L
  simpa only [Matrix.zero_mulVec,map_zero,primeBurnolJetPacketSynthesis,
    Fintype.linearCombination_apply_single,one_smul,Nat.add_zero] using h

theorem primeBurnolFourierJetCubicRelation_closure_balanced {p q : Nat.Primes} (hpq : p≠q)
    (a : ℝ) (hb : primeBurnolThetaVisibility a p^2=primeBurnolThetaContrast a p^2) :
    (primeBurnolFourierJetCubicRelation a).topologicalClosure=
      primeBurnolFourierJetEvenGraph.topologicalClosure.prod
        primeBurnolFourierJetEvenGraph.topologicalClosure := by
  let L := (primeBurnolFourierJetCubicRelation a).topologicalClosure
  have ha : a≠0 := by
    intro h
    subst a
    norm_num [primeBurnolThetaVisibility_zero,primeBurnolThetaContrast_zero] at hb
  have hq : primeBurnolThetaVisibility a q^2≠primeBurnolThetaContrast a q^2 :=
    fun h => hpq (primeBurnolTheta_balanced_prime_unique a hb h)
  obtain ⟨N,hN⟩ := eventually_atTop.mp (primeBurnolFourierJetSingletonCubic_eventually_isUnit q ha hq)
  have hhor := horizontal_of_singleton_zero p a (fun n => by
    rw [primeBurnolFourierJetCubic_singleton]
    exact primeBurnolFourierJetConstantThetaCubic_balanced _ p a hb)
  have hvert : ∀ w ∈ primeBurnolFourierJetEvenGraph.topologicalClosure, (0,w) ∈ L := by
    let V : Submodule ℂ BurnolJetAmbient := L.comap (LinearMap.inr ℂ _ _)
    have hV : IsClosed (V : Set BurnolJetAmbient) := by
      change IsClosed ((fun w : BurnolJetAmbient => ((0 : BurnolJetAmbient),w)) ⁻¹' (L : Set _))
      exact (primeBurnolFourierJetCubicRelation a).isClosed_topologicalClosure.preimage (by fun_prop)
    apply primeBurnolJetTail_columns_dense q N V hV
    intro n i
    have hunit : IsUnit (primeBurnolFourierJetCubic (primeBurnolSingletonPacket (q,n+N)) a) := by
      rw [primeBurnolFourierJetCubic_singleton]
      exact hN (n+N) (Nat.le_add_left N n)
    obtain ⟨x,hx⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hunit (Pi.single i 1)
    have hpacket := (primeBurnolFourierJetCubicRelation a).le_topologicalClosure
      (primeBurnolFourierJetCubicRelation_packet (primeBurnolSingletonPacket (q,n+N)) a x)
    rw [hx] at hpacket
    have h := L.sub_mem hpacket (hhor _ (primeBurnolFourierJetEvenGraph.le_topologicalClosure
      (primeBurnolJetPacketSynthesis_mem_even (primeBurnolSingletonPacket (q,n+N)) x)))
    change (0,primeBurnolJetGraphColumn (primeBurnolSingletonPacket (q,n+N)) i) ∈ L
    simpa only [primeBurnolJetPacketSynthesis,Fintype.linearCombination_apply_single,
      one_smul,Prod.mk_sub_mk,sub_self,sub_zero] using h
  apply le_antisymm
  · apply Submodule.topologicalClosure_minimal
    · intro z hz
      have h := primeBurnolFourierJetCubicRelation_le a hz
      exact ⟨primeBurnolFourierJetEvenGraph.le_topologicalClosure h.1,
        primeBurnolFourierJetEvenGraph.le_topologicalClosure h.2⟩
    · exact primeBurnolFourierJetEvenGraph.isClosed_topologicalClosure.prod
        primeBurnolFourierJetEvenGraph.isClosed_topologicalClosure
  · intro z hz
    have h := L.add_mem (hhor z.1 hz.1) (hvert z.2 hz.2)
    simpa only [Prod.mk_add_mk,add_zero,zero_add] using h

theorem primeBurnolFourierJetCubic_zero {N : ℕ} (pe : Fin N ↪ Nat.Primes × ℕ) :
    primeBurnolFourierJetCubic pe 0=0 := by
  have h : primeBurnolFourierJetThetaMatrix pe 0=burnolJetNeutralMatrix N := by
    ext i j
    cases i <;> cases j <;>
      simp [primeBurnolFourierJetThetaMatrix,burnolJetNeutralMatrix,primeBurnolThetaVisibility_zero,
        primeBurnolThetaContrast_zero,Matrix.diagonal,Matrix.one_apply]
  simp [primeBurnolFourierJetCubic,h,cubicProjectionAssociatorAlgebra]

theorem primeBurnolFourierJetCubicRelation_closure_zero (p : Nat.Primes) :
    (primeBurnolFourierJetCubicRelation 0).topologicalClosure=
      primeBurnolFourierJetEvenGraph.topologicalClosure.prod ⊥ := by
  apply le_antisymm
  · apply Submodule.topologicalClosure_minimal
    · apply Submodule.span_le.mpr
      rintro z ⟨N,pe,x,rfl⟩
      rw [primeBurnolFourierJetCubic_zero,Matrix.zero_mulVec,map_zero]
      exact ⟨primeBurnolFourierJetEvenGraph.le_topologicalClosure
        (primeBurnolJetPacketSynthesis_mem_even pe x),Submodule.zero_mem _⟩
    · exact primeBurnolFourierJetEvenGraph.isClosed_topologicalClosure.prod isClosed_singleton
  · intro z hz
    have h := horizontal_of_singleton_zero p 0 (fun _ => primeBurnolFourierJetCubic_zero _) z.1 hz.1
    have hz0 : z.2=0 := hz.2
    simpa only [← hz0] using h

theorem primeBurnolFourierJetCubicRelation_exists_saturated (p : Nat.Primes) :
    ∃ a : ℝ, 0<a ∧ (primeBurnolFourierJetCubicRelation a).topologicalClosure=
      primeBurnolFourierJetEvenGraph.topologicalClosure.prod
        primeBurnolFourierJetEvenGraph.topologicalClosure := by
  obtain ⟨q,hq,hprime⟩ := Nat.exists_infinite_primes (p.val+1)
  have hpq : p≠(⟨q,hprime⟩ : Nat.Primes) := by
    intro he
    have he' := congrArg Subtype.val he
    change p.val=q at he'
    omega
  obtain ⟨a,ha,hb⟩ := primeBurnolTheta_balanced_exists p
  exact ⟨a,ha,primeBurnolFourierJetCubicRelation_closure_balanced hpq a hb⟩

theorem primeBurnolFourierJetCubicRelation_no_closed_extension {p q : Nat.Primes} (hpq : p≠q)
    (a : ℝ) (hb : primeBurnolThetaVisibility a p^2=primeBurnolThetaContrast a p^2) :
    ¬ ∃ L : Submodule ℂ (BurnolJetAmbient × BurnolJetAmbient),
      IsClosed (L : Set (BurnolJetAmbient × BurnolJetAmbient)) ∧
      primeBurnolFourierJetCubicRelation a ≤ L ∧ ∀ z, (0,z) ∈ L → z=0 := by
  rintro ⟨L,hclosed,hcontains,hsingle⟩
  have hall := (primeBurnolFourierJetCubicRelation a).topologicalClosure_minimal hcontains hclosed
  rw [primeBurnolFourierJetCubicRelation_closure_balanced hpq a hb] at hall
  let z := primeBurnolJetGraphColumn (primeBurnolSingletonPacket (p,0)) (Sum.inl 0)
  have hz : z ∈ primeBurnolFourierJetEvenGraph.topologicalClosure :=
    primeBurnolFourierJetEvenGraph.le_topologicalClosure (primeBurnolJetGraphColumn_mem_even _ _)
  have hzero := hsingle z (hall ⟨Submodule.zero_mem _,hz⟩)
  have hf : primeBurnolEvenFeatureLp (p,0)=0 := congrArg (fun w : BurnolJetAmbient => w.1.1) hzero
  exact (primeBurnolFourierPair_linearIndependent (primeBurnolSingletonPacket (p,0))).ne_zero
    (Sum.inl 0) hf

end RHTower
