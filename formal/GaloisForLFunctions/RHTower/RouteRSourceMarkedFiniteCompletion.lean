import GaloisForLFunctions.HTGeometry.SourceMarkedLawsonCompletion
import GaloisForLFunctions.RHTower.RouteRCompletionMigrationDefect

/-!
# Finite exact source stages and the marked Route R completion wall

The literal reflected-minus-forward Fisher boundary is exact before a modular grade is fixed, but
its physical fixed-grade tail may acquire a Roos class.  This file builds the finite stages needed
to distinguish ordinary coordinate convergence from provenance-continuous completion.

Every finite-support truncation lands in the Roos boundary unconditionally.  The truncations also
converge coordinate by coordinate to the physical landing.  Nevertheless, convergence in the
source-marked exactness topology occurs exactly when the physical Fisher escape class vanishes.
On Xi divisor support this is exactly the critical-line condition.

Thus pointwise convergence cannot prove RH: the missing mathematical law is precisely that the
canonical finite exact source stages converge while retaining the fixed source-boundary marker.
-/

open Set Filter Topology
open GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.HTGeometry.BoundaryMigration

namespace RHTower

noncomputable section

/-- Cut a trace sequence after its first `N` coordinates. -/
def routeRTraceTruncateLinear (N : ℕ) :
    RouteRTraceSequence →ₗ[ℂ] RouteRTraceSequence where
  toFun a n := if n < N then a n else 0
  map_add' a b := by
    funext n
    by_cases h : n < N <;> simp [h]
  map_smul' c a := by
    funext n
    by_cases h : n < N <;> simp [h]

@[simp] theorem routeRTraceTruncateLinear_apply_of_lt
    (N : ℕ) (a : RouteRTraceSequence) {n : ℕ} (h : n < N) :
    routeRTraceTruncateLinear N a n = a n := by
  simp [routeRTraceTruncateLinear, h]

@[simp] theorem routeRTraceTruncateLinear_apply_of_le
    (N : ℕ) (a : RouteRTraceSequence) {n : ℕ} (h : N ≤ n) :
    routeRTraceTruncateLinear N a n = 0 := by
  simp [routeRTraceTruncateLinear, Nat.not_lt.mpr h]

/-- Finite truncation is summable for every source sequence. -/
theorem summable_routeRTraceTruncateLinear
    (N : ℕ) (a : RouteRTraceSequence) :
    Summable (routeRTraceTruncateLinear N a) := by
  apply summable_of_hasFiniteSupport
  refine (Finset.finite_toSet (Finset.range N)).subset ?_
  intro n hn
  simp only [Finset.mem_coe, Finset.mem_range]
  by_contra hnot
  have hle : N ≤ n := Nat.le_of_not_gt hnot
  exact hn (routeRTraceTruncateLinear_apply_of_le N a hle)

/-- Rank-one source space generated by the literal pre-divisor Fisher boundary. -/
def routeRPrimeGammaFisherBoundaryLine :
    Submodule ℂ RouteRPrimeGammaVariableGradeSource :=
  ℂ ∙ routeRPrimeGammaFisherSourceBoundary

/-- Fixed Fisher generator, retained as a source marker rather than only as a target vector. -/
def routeRPrimeGammaMarkedFisherBoundary :
    routeRPrimeGammaFisherBoundaryLine :=
  ⟨routeRPrimeGammaFisherSourceBoundary,
    Submodule.mem_span_singleton_self routeRPrimeGammaFisherSourceBoundary⟩

/-- Finite source landing: fix grade, truncate, then form the tail mismatch. -/
def routeRPrimeGammaFiniteMarkedLanding (N : ℕ) (t : ℝ) :
    routeRPrimeGammaFisherBoundaryLine →ₗ[ℂ] RouteRTailRoosAmbient :=
  routeRDiagonalMismatchLinear.comp
    ((routeRTraceTruncateLinear N).comp
      ((routeRPrimeGammaVariableGradeEvaluation t).comp
        routeRPrimeGammaFisherBoundaryLine.subtype))

/-- Physical source landing on the same fixed Fisher line. -/
def routeRPrimeGammaPhysicalMarkedLanding (t : ℝ) :
    routeRPrimeGammaFisherBoundaryLine →ₗ[ℂ] RouteRTailRoosAmbient :=
  (routeRPrimeGammaFixedGradeTailLanding t).comp
    routeRPrimeGammaFisherBoundaryLine.subtype

/-- Every finite marked landing is a target Roos boundary. -/
theorem routeRPrimeGammaFiniteMarkedLanding_mem_boundary
    (N : ℕ) (t : ℝ) (x : routeRPrimeGammaFisherBoundaryLine) :
    routeRPrimeGammaFiniteMarkedLanding N t x ∈ routeRTailRoosBoundary := by
  have hzero : routeRDiagonalTailRoosClass
      (routeRTraceTruncateLinear N
        (routeRPrimeGammaVariableGradeEvaluation t (x :
          RouteRPrimeGammaVariableGradeSource))) = 0 :=
    (routeRDiagonalTailRoosClass_eq_zero_iff_summable _).2
      (summable_routeRTraceTruncateLinear N _)
  rw [routeRDiagonalTailRoosClass, Submodule.Quotient.mk_eq_zero] at hzero
  exact hzero

/-- Finite exactness state retaining the literal Fisher source line. -/
def routeRPrimeGammaFiniteMarkedState (N : ℕ) (t : ℝ) :
    SourceMarkedExFlag ℂ routeRPrimeGammaFisherBoundaryLine RouteRTailRoosAmbient where
  target := routeRTailRoosExactnessFlag
  landing := routeRPrimeGammaFiniteMarkedLanding N t
  landing_mem_cycle x := by
    exact Submodule.mem_top

/-- Physical completion state with the same retained source line. -/
def routeRPrimeGammaPhysicalMarkedState (t : ℝ) :
    SourceMarkedExFlag ℂ routeRPrimeGammaFisherBoundaryLine RouteRTailRoosAmbient where
  target := routeRTailRoosExactnessFlag
  landing := routeRPrimeGammaPhysicalMarkedLanding t
  landing_mem_cycle x := by
    exact Submodule.mem_top

/-- Every finite stage is escape-free on the entire marked source line. -/
theorem routeRPrimeGammaFiniteMarkedState_escapeFree
    (N : ℕ) (t : ℝ) :
    EscapeFree (routeRPrimeGammaFiniteMarkedState N t).landing
      (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine)
      (routeRPrimeGammaFiniteMarkedState N t).target.boundary := by
  intro y hy
  obtain ⟨x, _hx, rfl⟩ := Submodule.mem_map.mp hy
  exact routeRPrimeGammaFiniteMarkedLanding_mem_boundary N t x

/-- At each fixed tail coordinate, finite and physical marked landings eventually agree exactly. -/
theorem routeRPrimeGammaFiniteMarkedLanding_eventually_eq_coordinate
    (t : ℝ) (x : routeRPrimeGammaFisherBoundaryLine) (n : ℕ) :
    ∀ᶠ N in atTop,
      routeRPrimeGammaFiniteMarkedLanding N t x n =
        routeRPrimeGammaPhysicalMarkedLanding t x n := by
  filter_upwards [eventually_gt_atTop n] with N hN
  apply Subtype.ext
  funext k
  change routeRDiagonalMismatch
      (routeRTraceTruncateLinear N
        (routeRPrimeGammaVariableGradeEvaluation t (x :
          RouteRPrimeGammaVariableGradeSource))) n k =
    routeRDiagonalMismatch
      (routeRPrimeGammaVariableGradeEvaluation t (x :
        RouteRPrimeGammaVariableGradeSource)) n k
  cases k with
  | zero =>
      simp [hN]
  | succ k =>
      simp

/-- Physical escape-freedom on the marked Fisher line is exactly vanishing of its completion
escape class. -/
theorem routeRPrimeGammaPhysicalMarkedState_escapeFree_iff_class_zero
    (t : ℝ) :
    EscapeFree (routeRPrimeGammaPhysicalMarkedState t).landing
      (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine)
      (routeRPrimeGammaPhysicalMarkedState t).target.boundary ↔
      routeRPrimeGammaFisherCompletionEscapeClass t = 0 := by
  have hclass : routeRPrimeGammaFisherCompletionEscapeClass t = 0 ↔
      routeRPrimeGammaFixedGradeTailLanding t
        routeRPrimeGammaFisherSourceBoundary ∈ routeRTailRoosBoundary := by
    rw [routeRPrimeGammaFisherCompletionEscapeClass,
      boundaryEscapeClass_eq_zero_iff]
  rw [hclass]
  constructor
  · intro h
    exact h (Submodule.mem_map_of_mem
      (show routeRPrimeGammaMarkedFisherBoundary ∈
          (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) from
        Submodule.mem_top))
  · intro h y hy
    obtain ⟨x, _hx, rfl⟩ := Submodule.mem_map.mp hy
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp x.property
    have hx : x = c • routeRPrimeGammaMarkedFisherBoundary := by
      apply Subtype.ext
      exact hc.symm
    rw [hx]
    change routeRPrimeGammaPhysicalMarkedLanding t
        (c • routeRPrimeGammaMarkedFisherBoundary) ∈ routeRTailRoosBoundary
    simpa [routeRPrimeGammaPhysicalMarkedLanding,
      routeRPrimeGammaMarkedFisherBoundary] using
      routeRTailRoosBoundary.smul_mem c h

/-- Sharp completion wall: source-marked convergence of exact finite stages is equivalent to
neutral modular grade. -/
theorem routeRPrimeGammaFiniteMarkedState_tendsto_iff
    {t : ℝ} (ht : |t| < 1) :
    Tendsto (fun N => routeRPrimeGammaFiniteMarkedState N t) atTop
        (nhds (routeRPrimeGammaPhysicalMarkedState t)) ↔
      t = 0 := by
  constructor
  · intro hconv
    have hexact : EscapeFree (routeRPrimeGammaPhysicalMarkedState t).landing
        (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine)
        (routeRPrimeGammaPhysicalMarkedState t).target.boundary :=
      SourceMarkedExFlag.escapeFree_of_tendsto
        (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) hconv
        (Filter.Eventually.of_forall fun N =>
          routeRPrimeGammaFiniteMarkedState_escapeFree N t)
    exact (routeRPrimeGammaFisherCompletionEscapeClass_eq_zero_iff ht).1
      ((routeRPrimeGammaPhysicalMarkedState_escapeFree_iff_class_zero t).1 hexact)
  · intro ht0
    subst t
    rw [SourceMarkedExFlag.tendsto_iff_eventually_survival_tests]
    intro x hx
    have hclass : routeRPrimeGammaFisherCompletionEscapeClass 0 = 0 :=
      (routeRPrimeGammaFisherCompletionEscapeClass_eq_zero_iff (by norm_num)).2 rfl
    have hexact :=
      (routeRPrimeGammaPhysicalMarkedState_escapeFree_iff_class_zero 0).2 hclass
    exfalso
    exact hx (hexact (Submodule.mem_map_of_mem
      (show x ∈ (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) from
        Submodule.mem_top)))

/-- Two-sided Lawson completion has the same sharp wall: every fixed source relation must stabilize
as exact or surviving, and the canonical finite stages converge precisely at neutral grade. -/
theorem routeRPrimeGammaFiniteMarkedState_tendsto_lawson_iff
    {t : ℝ} (ht : |t| < 1) :
    Tendsto (fun N => routeRPrimeGammaFiniteMarkedState N t) atTop
        (@nhds
          (SourceMarkedExFlag ℂ routeRPrimeGammaFisherBoundaryLine RouteRTailRoosAmbient)
          SourceMarkedExFlag.lawsonTopology
          (routeRPrimeGammaPhysicalMarkedState t)) ↔
      t = 0 := by
  constructor
  · intro hconv
    have hexact : EscapeFree (routeRPrimeGammaPhysicalMarkedState t).landing
        (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine)
        (routeRPrimeGammaPhysicalMarkedState t).target.boundary :=
      SourceMarkedExFlag.escapeFree_of_tendsto_lawson
        (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) hconv
        (Filter.Eventually.of_forall fun N =>
          routeRPrimeGammaFiniteMarkedState_escapeFree N t)
    exact (routeRPrimeGammaFisherCompletionEscapeClass_eq_zero_iff ht).1
      ((routeRPrimeGammaPhysicalMarkedState_escapeFree_iff_class_zero t).1 hexact)
  · intro ht0
    subst t
    rw [SourceMarkedExFlag.tendsto_lawson_iff_eventually_same_survival]
    intro x
    have hclass : routeRPrimeGammaFisherCompletionEscapeClass 0 = 0 :=
      (routeRPrimeGammaFisherCompletionEscapeClass_eq_zero_iff (by norm_num)).2 rfl
    have hphysical :=
      (routeRPrimeGammaPhysicalMarkedState_escapeFree_iff_class_zero 0).2 hclass
    exact Filter.Eventually.of_forall fun N => iff_of_false (by
      intro hsurv
      exact hsurv (routeRPrimeGammaFiniteMarkedState_escapeFree N 0
        (Submodule.mem_map_of_mem
          (show x ∈ (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) from
            Submodule.mem_top)))) (by
      intro hsurv
      exact hsurv (hphysical (Submodule.mem_map_of_mem
        (show x ∈ (⊤ : Submodule ℂ routeRPrimeGammaFisherBoundaryLine) from
          Submodule.mem_top))))

/-- On a Xi support point, marked completion continuity is exactly critical-line placement. -/
theorem routeRPrimeGammaXiFiniteMarkedState_tendsto_iff_re_eq_half
    (rho : XiDivisorSupport) :
    Tendsto
        (fun N => routeRPrimeGammaFiniteMarkedState N
          (2 * (rho : ℂ).re - 1)) atTop
        (nhds (routeRPrimeGammaPhysicalMarkedState
          (2 * (rho : ℂ).re - 1))) ↔
      (rho : ℂ).re = 1 / 2 := by
  rw [routeRPrimeGammaFiniteMarkedState_tendsto_iff
    (xiCenteredPrimeIdealRate_abs_lt_one rho)]
  constructor <;> intro h <;> linarith

/-- Lawson phase stabilization at one Xi support point is exactly critical-line placement. -/
theorem routeRPrimeGammaXiFiniteMarkedState_tendsto_lawson_iff_re_eq_half
    (rho : XiDivisorSupport) :
    Tendsto
        (fun N => routeRPrimeGammaFiniteMarkedState N
          (2 * (rho : ℂ).re - 1)) atTop
        (@nhds
          (SourceMarkedExFlag ℂ routeRPrimeGammaFisherBoundaryLine RouteRTailRoosAmbient)
          SourceMarkedExFlag.lawsonTopology
          (routeRPrimeGammaPhysicalMarkedState
            (2 * (rho : ℂ).re - 1))) ↔
      (rho : ℂ).re = 1 / 2 := by
  rw [routeRPrimeGammaFiniteMarkedState_tendsto_lawson_iff
    (xiCenteredPrimeIdealRate_abs_lt_one rho)]
  constructor <;> intro h <;> linarith

/-- Universal source-marked continuity of the canonical exact finite stages is equivalent to RH. -/
theorem routeRPrimeGammaXiGlobalMarkedCompletionContinuous_iff_riemannHypothesis :
    (∀ rho : XiDivisorSupport,
      Tendsto
        (fun N => routeRPrimeGammaFiniteMarkedState N
          (2 * (rho : ℂ).re - 1)) atTop
        (nhds (routeRPrimeGammaPhysicalMarkedState
          (2 * (rho : ℂ).re - 1)))) ↔
      RiemannHypothesis := by
  rw [← routeRPrimeGammaXiGlobalCompletionEscapeFree_iff_riemannHypothesis]
  constructor
  · intro h rho
    exact (routeRPrimeGammaXiCompletionEscapeClass_eq_zero_iff_re_eq_half rho).2
      ((routeRPrimeGammaXiFiniteMarkedState_tendsto_iff_re_eq_half rho).1 (h rho))
  · intro h rho
    exact (routeRPrimeGammaXiFiniteMarkedState_tendsto_iff_re_eq_half rho).2
      ((routeRPrimeGammaXiCompletionEscapeClass_eq_zero_iff_re_eq_half rho).1 (h rho))

/-- Global Lawson stabilization of exactness phases is equivalent to RH. -/
theorem routeRPrimeGammaXiGlobalLawsonCompletionContinuous_iff_riemannHypothesis :
    (∀ rho : XiDivisorSupport,
      Tendsto
        (fun N => routeRPrimeGammaFiniteMarkedState N
          (2 * (rho : ℂ).re - 1)) atTop
        (@nhds
          (SourceMarkedExFlag ℂ routeRPrimeGammaFisherBoundaryLine RouteRTailRoosAmbient)
          SourceMarkedExFlag.lawsonTopology
          (routeRPrimeGammaPhysicalMarkedState
            (2 * (rho : ℂ).re - 1)))) ↔
      RiemannHypothesis := by
  rw [← routeRPrimeGammaXiGlobalCompletionEscapeFree_iff_riemannHypothesis]
  constructor
  · intro h rho
    exact (routeRPrimeGammaXiCompletionEscapeClass_eq_zero_iff_re_eq_half rho).2
      ((routeRPrimeGammaXiFiniteMarkedState_tendsto_lawson_iff_re_eq_half rho).1 (h rho))
  · intro h rho
    exact (routeRPrimeGammaXiFiniteMarkedState_tendsto_lawson_iff_re_eq_half rho).2
      ((routeRPrimeGammaXiCompletionEscapeClass_eq_zero_iff_re_eq_half rho).1 (h rho))

end

end RHTower
