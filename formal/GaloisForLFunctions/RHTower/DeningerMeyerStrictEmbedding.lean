import GaloisForLFunctions.RHTower.DeningerExpWeightDeriv
import GaloisForLFunctions.RHTower.DeningerMeyerTopology
import GaloisForLFunctions.RHTower.DeningerPoissonStrict
import GaloisForLFunctions.RHTower.DeningerPoissonSource

/-!
# The Poisson operator is a strict embedding for the Meyer topology

The corpus already carries the strictness of `Z : H_∩ → H_-` against the *radial* presentation of
the image — the family of all integer exponential weights of the Poisson sum, topologized as a
subspace of a countable product of Schwartz spaces.  What the Möbius range classification needs is
the same statement against the *nuclear Meyer topology* of `H_-`, generated by the seminorms
`q_{A,n}(h) = sup_t e^{A|t|}‖h^{(n)}(t)‖`.

The bridge is one estimate: multiplication by `e^{ct}` maps `H_-` into the Schwartz space
continuously for the Meyer topology, because `‖t‖^k e^{ct} ≤ k!·e^{(1+|c|)|t|}` and Leibniz turns a
derivative of the product into a finite combination of derivatives of the factor.  Since the `s`-th
radial datum of `Z f` is exactly `e^{st}·Z f`, this converts every radial seminorm bound into a
Meyer seminorm bound.

* `deningerPow_mul_exp_le` : `‖t‖^k e^{ct} ≤ k!·e^{⌈1+|c|⌉|t|}`.
* `deningerExpMul_seminorm_le` : **`p_{k,n}(e^{ct}h)` is bounded by Meyer seminorms of `h`.**
-/

open scoped Real SchwartzMap NNReal
open Complex GaloisForLFunctions

noncomputable section

namespace RHTower

/-! ## Monotonicity of the Meyer seminorms in the exponent -/

theorem deningerMeyerSeminormFun_mono {A B : ℝ} (hAB : A ≤ B) (n : ℕ) (h : DeningerExpSchwartz) :
    deningerMeyerSeminormFun A n h ≤ deningerMeyerSeminormFun B n h := by
  refine deningerMeyerSeminormFun_le fun t => ?_
  refine le_trans ?_ (deningerMeyerWeight_le B n h t)
  rw [deningerMeyerWeight, deningerMeyerWeight]
  exact mul_le_mul_of_nonneg_right
    (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hAB (abs_nonneg t))) (norm_nonneg _)

/-! ## The exponential weight against the Meyer seminorms -/

theorem deningerExpMul_coeFun (c : ℝ) (h : DeningerExpSchwartz) :
    (((deningerExpMul c h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ)
      = fun t => deningerExpWeightC c t * (((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ) t :=
  funext fun t => deningerExpMul_apply c h t

/-- The exponent that absorbs one power weight and the exponential factor. -/
def deningerExpMulExponent (c : ℝ) : ℕ := ⌈1 + |c|⌉₊

/-- **A power weight and an exponential factor cost one unit of Meyer exponent.** -/
theorem deningerPow_mul_exp_le (c : ℝ) (k : ℕ) (t : ℝ) :
    ‖t‖ ^ k * Real.exp (c * t)
      ≤ (Nat.factorial k : ℝ) * Real.exp ((deningerExpMulExponent c : ℝ) * |t|) := by
  have hpow : ‖t‖ ^ k ≤ (Nat.factorial k : ℝ) * Real.exp |t| :=
    deningerPow_le_factorial_mul_exp k t
  have hct : c * t ≤ |c| * |t| := by
    have h1 : c * t ≤ |c * t| := le_abs_self _
    rw [abs_mul] at h1
    exact h1
  have hexp : Real.exp (c * t) ≤ Real.exp (|c| * |t|) := Real.exp_le_exp.mpr hct
  have hposk : (0 : ℝ) ≤ (Nat.factorial k : ℝ) := by positivity
  have hstep : ‖t‖ ^ k * Real.exp (c * t)
      ≤ ((Nat.factorial k : ℝ) * Real.exp |t|) * Real.exp (|c| * |t|) :=
    mul_le_mul hpow hexp (Real.exp_pos _).le (by positivity)
  refine le_trans hstep ?_
  have harg : |t| + |c| * |t| = (1 + |c|) * |t| := by ring
  rw [mul_assoc, ← Real.exp_add, harg]
  exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr
    (mul_le_mul_of_nonneg_right (Nat.le_ceil (1 + |c|)) (abs_nonneg t))) hposk

/-- **The Schwartz seminorms of `e^{ct}h` are bounded by the Meyer seminorms of `h`.**  Leibniz
expands the `n`-th derivative of the product, the `j`-th term carrying the factor `|c|^j e^{ct}`,
and the power weight `‖t‖^k` is absorbed into the exponential at the cost of `k!`. -/
theorem deningerExpMul_seminorm_le (c : ℝ) (k n : ℕ) (h : DeningerExpSchwartz) :
    SchwartzMap.seminorm ℂ k n ((deningerExpMul c h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ))
      ≤ ∑ j ∈ Finset.range (n + 1), (n.choose j : ℝ) * |c| ^ j * (Nat.factorial k : ℝ)
          * deningerMeyerSeminormFun ((deningerExpMulExponent c : ℕ) : ℝ) (n - j) h := by
  have hnn : (0 : ℝ) ≤ ∑ j ∈ Finset.range (n + 1), (n.choose j : ℝ) * |c| ^ j
      * (Nat.factorial k : ℝ)
      * deningerMeyerSeminormFun ((deningerExpMulExponent c : ℕ) : ℝ) (n - j) h := by
    refine Finset.sum_nonneg fun j _ => ?_
    have := deningerMeyerSeminormFun_nonneg ((deningerExpMulExponent c : ℕ) : ℝ) (n - j) h
    positivity
  refine SchwartzMap.seminorm_le_bound ℂ k n _ hnn fun t => ?_
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) ((((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ)) :=
    ((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)).smooth'
  have hleib := deningerWeighted_iteratedFDeriv_bound hsmooth c n t
  rw [deningerExpMul_coeFun c h]
  have hmul : ‖t‖ ^ k * ‖iteratedFDeriv ℝ n
      (fun u => deningerExpWeightC c u * (((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ) u) t‖
      ≤ ‖t‖ ^ k * ∑ j ∈ Finset.range (n + 1), (n.choose j : ℝ) * (|c| ^ j * Real.exp (c * t))
          * ‖iteratedFDeriv ℝ (n - j) (((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ) t‖ :=
    mul_le_mul_of_nonneg_left hleib (by positivity)
  refine le_trans hmul ?_
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  set D : ℝ := ‖iteratedFDeriv ℝ (n - j) (((h : DeningerExpSchwartz) : 𝓢(ℝ, ℂ)) : ℝ → ℂ) t‖
    with hD
  set Q : ℝ := deningerMeyerSeminormFun ((deningerExpMulExponent c : ℕ) : ℝ) (n - j) h with hQ
  have hDnn : (0 : ℝ) ≤ D := norm_nonneg _
  have hinner : (‖t‖ ^ k * Real.exp (c * t)) * D ≤ (Nat.factorial k : ℝ) * Q := by
    calc (‖t‖ ^ k * Real.exp (c * t)) * D
        ≤ ((Nat.factorial k : ℝ) * Real.exp ((deningerExpMulExponent c : ℝ) * |t|)) * D :=
          mul_le_mul_of_nonneg_right (deningerPow_mul_exp_le c k t) hDnn
      _ = (Nat.factorial k : ℝ)
          * deningerMeyerWeight ((deningerExpMulExponent c : ℕ) : ℝ) (n - j) h t := by
          rw [deningerMeyerWeight, hD]
          ring
      _ ≤ (Nat.factorial k : ℝ) * Q :=
          mul_le_mul_of_nonneg_left (deningerMeyerWeight_le _ _ _ t) (by positivity)
  have hcoef : (0 : ℝ) ≤ (n.choose j : ℝ) * |c| ^ j := by positivity
  calc ‖t‖ ^ k * ((n.choose j : ℝ) * (|c| ^ j * Real.exp (c * t)) * D)
      = (n.choose j : ℝ) * |c| ^ j * ((‖t‖ ^ k * Real.exp (c * t)) * D) := by ring
    _ ≤ (n.choose j : ℝ) * |c| ^ j * ((Nat.factorial k : ℝ) * Q) :=
        mul_le_mul_of_nonneg_left hinner hcoef
    _ = (n.choose j : ℝ) * |c| ^ j * (Nat.factorial k : ℝ) * Q := by ring

end RHTower

end
