import Mathlib.LinearAlgebra.ExteriorPower.Basic
import Mathlib.Algebra.TrivSqZeroExt.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic.NoncommRing
import GaloisForLFunctions.HTGeometry.SullivanTower

/-!
# The Milnor quotient of an exterior algebra and the first relative Sullivan layer

The free graded-commutative algebra on a space of degree-one generators is the exterior algebra,
and the two-term algebra `k ⊕ V` with vanishing products is the split square-zero extension.  The
canonical map from the free algebra to the two-term algebra is the identity on scalars and on
generators, is surjective, and its kernel is exactly the ideal generated by the degree-two part.

That last identification is the algebraic content of the relative Sullivan factorization in the
two-term case: the first layer of new degree-one generators has differential the inclusion of the
degree-two part, and the ideal spanned by that differential is precisely the kernel to be killed.

The relative extension itself is the exterior algebra on a direct sum: adjoining a space `W` of new
degree-one generators to the exterior algebra on `V` gives `Λ(V ⊕ W)`, which is the graded tensor
product of `Λ(V)` with `Λ(W)`.  The old algebra includes into it as a retract, and the kernel of
the retraction is exactly the ideal generated by the new generators — the well-ordered filtration
and the lower-triangularity of the differential are then recorded by `DeningerRelativeSullivan`,
whose first layer is constructed unconditionally.

* `deningerExteriorPowerTwo_central` : degree-two elements are central.
* `deningerMilnorEpsilon`, `_surjective` : the canonical map to the two-term algebra.
* `deningerMilnorEpsilon_ker` : its kernel is the ideal generated by the degree-two part.
* `deningerMilnorQuotientEquiv` : the two-term algebra is the Milnor quotient.
* `deningerSullivanInclusion_injective`, `deningerSullivanAugmentation_ker` : the relative
  extension is a split extension whose augmentation ideal is generated by the new generators.
* `deningerSullivanFirstLayer` : the first relative Sullivan layer, with its filtration and
  lower-triangular differential.
-/

namespace RHTower

open ExteriorAlgebra

section Centrality

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- A product of two generators commutes with every generator: two transpositions of
anticommuting generators restore the original order. -/
theorem deningerExteriorTwo_comm_ι (a b x : V) :
    (ι k a * ι k b) * ι k x = ι k x * (ι k a * ι k b) := by
  have ha : ι k a * ι k x = -(ι k x * ι k a) :=
    add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap a x)
  have hb : ι k b * ι k x = -(ι k x * ι k b) :=
    add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap b x)
  calc (ι k a * ι k b) * ι k x = ι k a * (ι k b * ι k x) := by rw [mul_assoc]
    _ = ι k a * -(ι k x * ι k b) := by rw [hb]
    _ = -(ι k a * ι k x * ι k b) := by rw [mul_neg, mul_assoc]
    _ = -(-(ι k x * ι k a) * ι k b) := by rw [ha]
    _ = ι k x * ι k a * ι k b := by rw [neg_mul, neg_neg]
    _ = ι k x * (ι k a * ι k b) := by rw [mul_assoc]

/-- **A product of two generators is central.**  The centralizer is a subalgebra containing the
generators, and the generators generate the exterior algebra. -/
theorem deningerExteriorTwo_central (a b : V) (z : ExteriorAlgebra k V) :
    (ι k a * ι k b) * z = z * (ι k a * ι k b) := by
  have hgen : Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V)) = ⊤ :=
    CliffordAlgebra.adjoin_range_ι
  have hsub : Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V))
      ≤ Subalgebra.centralizer k {ι k a * ι k b} := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    exact deningerExteriorTwo_comm_ι a b x
  have : z ∈ Subalgebra.centralizer k {ι k a * ι k b} := by
    rw [hgen] at hsub
    exact hsub trivial
  exact (Subalgebra.mem_centralizer_iff k).mp this _ rfl

/-- **Every degree-two element is central.** -/
theorem deningerExteriorPowerTwo_central {x : ExteriorAlgebra k V} (hx : x ∈ ⋀[k]^2 V)
    (z : ExteriorAlgebra k V) : x * z = z * x := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    exact deningerExteriorTwo_central a b z
  · intro p q hp hq
    rw [add_mul, mul_add, hp, hq]

/-- A product of two generators lies in the degree-two part. -/
theorem deningerExteriorTwo_mem (a b : V) : ι k a * ι k b ∈ ⋀[k]^2 V := by
  have h : ι k a * ι k b ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) :=
    Submodule.mul_mem_mul ⟨a, rfl⟩ ⟨b, rfl⟩
  rwa [← pow_two] at h

end Centrality

section MilnorQuotient

variable (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V]

/-- **The Milnor ideal**: the ideal generated by the degree-two part of the exterior algebra. -/
def deningerMilnorIdeal : Ideal (ExteriorAlgebra k V) :=
  Ideal.span (↑(⋀[k]^2 V) : Set (ExteriorAlgebra k V))

variable {k V}

theorem deningerExteriorTwo_mem_milnorIdeal (a b : V) :
    ι k a * ι k b ∈ deningerMilnorIdeal k V :=
  Ideal.subset_span (deningerExteriorTwo_mem a b)

/-- **The Milnor ideal is two-sided**, because its generators are central. -/
theorem deningerMilnorIdeal_mul_right {i : ExteriorAlgebra k V}
    (hi : i ∈ deningerMilnorIdeal k V) (z : ExteriorAlgebra k V) :
    i * z ∈ deningerMilnorIdeal k V := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hi
  · intro x hx
    rw [deningerExteriorPowerTwo_central hx z]
    exact Ideal.mul_mem_left _ z (Ideal.subset_span hx)
  · rw [zero_mul]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [add_mul]
    exact Submodule.add_mem _ hp hq
  · intro a p _ hp
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ a hp

instance deningerMilnorIdeal_isTwoSided : (deningerMilnorIdeal k V).IsTwoSided :=
  ⟨fun b hi => deningerMilnorIdeal_mul_right hi b⟩

/-- **Scalars, generators and the Milnor ideal exhaust the exterior algebra.**  The set of such
sums contains the generators and the scalars and is closed under products, because the product of
two generators is already in the Milnor ideal and the ideal is two-sided. -/
theorem deningerExterior_decomposition (x : ExteriorAlgebra k V) :
    ∃ c : k, ∃ v : V, ∃ i ∈ deningerMilnorIdeal k V,
      x = algebraMap k (ExteriorAlgebra k V) c + ι k v + i := by
  have hx : x ∈ Algebra.adjoin k (Set.range (ι k : V →ₗ[k] ExteriorAlgebra k V)) := by
    rw [CliffordAlgebra.adjoin_range_ι]
    trivial
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨v, rfl⟩ := hy
      exact ⟨0, v, 0, Submodule.zero_mem _, by rw [map_zero, zero_add, add_zero]⟩
  | algebraMap r => exact ⟨r, 0, 0, Submodule.zero_mem _, by rw [map_zero, add_zero, add_zero]⟩
  | add a b _ _ ha hb =>
      obtain ⟨c₁, v₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨c₂, v₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨c₁ + c₂, v₁ + v₂, i₁ + i₂, Submodule.add_mem _ hi₁ hi₂, ?_⟩
      rw [map_add, map_add]
      abel
  | mul a b _ _ ha hb =>
      obtain ⟨c₁, v₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨c₂, v₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨c₁ * c₂, c₁ • v₂ + c₂ • v₁,
        algebraMap k (ExteriorAlgebra k V) c₁ * i₂ + ι k v₁ * ι k v₂ + ι k v₁ * i₂
          + i₁ * algebraMap k (ExteriorAlgebra k V) c₂ + i₁ * ι k v₂ + i₁ * i₂, ?_, ?_⟩
      · refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _
          (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_) ?_) ?_
        · exact Ideal.mul_mem_left _ _ hi₂
        · exact deningerExteriorTwo_mem_milnorIdeal v₁ v₂
        · exact Ideal.mul_mem_left _ _ hi₂
        · exact deningerMilnorIdeal_mul_right hi₁ _
        · exact deningerMilnorIdeal_mul_right hi₁ _
        · exact deningerMilnorIdeal_mul_right hi₁ _
      · have h1 : algebraMap k (ExteriorAlgebra k V) (c₁ * c₂)
            = algebraMap k (ExteriorAlgebra k V) c₁ * algebraMap k (ExteriorAlgebra k V) c₂ :=
          map_mul _ _ _
        have h2 : ι k (c₁ • v₂) = algebraMap k (ExteriorAlgebra k V) c₁ * ι k v₂ := by
          rw [map_smul, Algebra.smul_def]
        have h3 : ι k (c₂ • v₁) = ι k v₁ * algebraMap k (ExteriorAlgebra k V) c₂ := by
          rw [map_smul, Algebra.smul_def, Algebra.commutes]
        rw [h1, map_add, h2, h3]
        noncomm_ring

/-- **A generated square-zero target is a quotient of the exterior algebra.**  This is the general
form of the surjection to be factored: any algebra generated by a space of square-zero elements
receives a surjection from the free graded-commutative algebra on that space. -/
theorem deningerExteriorLift_surjective {A : Type*} [Ring A] [Algebra k A] (j : V →ₗ[k] A)
    (hj : ∀ v, j v * j v = 0) (hgen : Algebra.adjoin k (Set.range j) = ⊤) :
    Function.Surjective (ExteriorAlgebra.lift k ⟨j, hj⟩) := by
  rw [← AlgHom.range_eq_top]
  refine top_le_iff.mp ?_
  rw [← hgen, Algebra.adjoin_le_iff]
  rintro _ ⟨v, rfl⟩
  exact ⟨ι k v, ExteriorAlgebra.lift_ι_apply k j hj v⟩

variable (k V) [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- **The canonical map to the two-term algebra**: the exterior algebra maps to the split
square-zero extension by sending each generator to its square-zero copy. -/
noncomputable def deningerMilnorEpsilon :
    ExteriorAlgebra k V →ₐ[k] TrivSqZeroExt k V :=
  ExteriorAlgebra.lift k ⟨TrivSqZeroExt.inrHom k V, fun v => TrivSqZeroExt.inr_mul_inr k v v⟩

variable {k V}

@[simp]
theorem deningerMilnorEpsilon_ι (v : V) :
    deningerMilnorEpsilon k V (ι k v) = TrivSqZeroExt.inr v := by
  rw [deningerMilnorEpsilon, ExteriorAlgebra.lift_ι_apply]
  rfl

theorem deningerMilnorEpsilon_algebraMap (c : k) :
    deningerMilnorEpsilon k V (algebraMap k (ExteriorAlgebra k V) c) = TrivSqZeroExt.inl c := by
  rw [AlgHom.commutes]
  exact congrFun (TrivSqZeroExt.algebraMap_eq_inl k V) c

/-- **The canonical map is surjective**: it is the identity on scalars and on generators, and
those exhaust the two-term algebra. -/
theorem deningerMilnorEpsilon_surjective :
    Function.Surjective (deningerMilnorEpsilon k V) := by
  intro x
  refine ⟨algebraMap k (ExteriorAlgebra k V) x.fst + ι k x.snd, ?_⟩
  rw [map_add, deningerMilnorEpsilon_algebraMap, deningerMilnorEpsilon_ι,
    TrivSqZeroExt.inl_fst_add_inr_snd_eq]

theorem deningerMilnorIdeal_le_ker :
    deningerMilnorIdeal k V ≤ RingHom.ker (deningerMilnorEpsilon k V) := by
  rw [deningerMilnorIdeal, Ideal.span_le]
  intro x hx
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  rw [SetLike.mem_coe, RingHom.mem_ker]
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerMilnorEpsilon_ι, deningerMilnorEpsilon_ι]
    exact TrivSqZeroExt.inr_mul_inr k a b
  · intro p q hp hq
    rw [map_add, hp, hq, add_zero]

/-- **The kernel of the canonical map is the Milnor ideal.**  A scalar plus a generator maps to
zero only if both vanish, so the whole kernel is the degree-two ideal. -/
theorem deningerMilnorEpsilon_ker :
    RingHom.ker (deningerMilnorEpsilon k V) = deningerMilnorIdeal k V := by
  refine le_antisymm ?_ deningerMilnorIdeal_le_ker
  intro x hx
  obtain ⟨c, v, i, hi, rfl⟩ := deningerExterior_decomposition x
  rw [RingHom.mem_ker, map_add, map_add, deningerMilnorEpsilon_algebraMap,
    deningerMilnorEpsilon_ι] at hx
  rw [RingHom.mem_ker.mp (deningerMilnorIdeal_le_ker hi), add_zero] at hx
  have hc : c = 0 := by
    have := congrArg TrivSqZeroExt.fst hx
    simpa using this
  have hv : v = 0 := by
    have := congrArg TrivSqZeroExt.snd hx
    simpa using this
  subst hc
  subst hv
  simpa using hi

/-- **The two-term algebra is the Milnor quotient of the exterior algebra.** -/
noncomputable def deningerMilnorQuotientEquiv :
    (ExteriorAlgebra k V ⧸ deningerMilnorIdeal k V) ≃ₐ[k] TrivSqZeroExt k V :=
  (Ideal.quotientEquivAlgOfEq k deningerMilnorEpsilon_ker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective deningerMilnorEpsilon_surjective)

end MilnorQuotient

section RelativeExtension

variable (k V W : Type*) [CommRing k] [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

/-- **The relative extension** obtained by adjoining a space `W` of new degree-one generators:
the exterior algebra on the direct sum, which is the graded tensor product of the two exterior
algebras. -/
def deningerSullivanInclusion : ExteriorAlgebra k V →ₐ[k] ExteriorAlgebra k (V × W) :=
  ExteriorAlgebra.map (LinearMap.inl k V W)

/-- The augmentation of the relative extension, killing the new generators. -/
def deningerSullivanAugmentation : ExteriorAlgebra k (V × W) →ₐ[k] ExteriorAlgebra k V :=
  ExteriorAlgebra.map (LinearMap.fst k V W)

variable {k V W}

@[simp]
theorem deningerSullivanInclusion_ι (v : V) :
    deningerSullivanInclusion k V W (ι k v) = ι k ((v, 0) : V × W) :=
  ExteriorAlgebra.map_apply_ι _ v

@[simp]
theorem deningerSullivanAugmentation_ι (p : V × W) :
    deningerSullivanAugmentation k V W (ι k p) = ι k p.1 :=
  ExteriorAlgebra.map_apply_ι _ p

theorem deningerSullivanAugmentation_comp_inclusion :
    (deningerSullivanAugmentation k V W).comp (deningerSullivanInclusion k V W)
      = AlgHom.id k (ExteriorAlgebra k V) := by
  rw [deningerSullivanAugmentation, deningerSullivanInclusion, ExteriorAlgebra.map_comp_map,
    LinearMap.fst_comp_inl, ExteriorAlgebra.map_id]

/-- **The old algebra is a retract of the relative extension**, hence includes into it. -/
theorem deningerSullivanInclusion_injective :
    Function.Injective (deningerSullivanInclusion k V W) := by
  intro x y h
  have hx := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := W)) x
  have hy := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := W)) y
  simp only [AlgHom.comp_apply, AlgHom.id_apply] at hx hy
  rw [← hx, ← hy, h]

variable (k V W)

/-- The ideal generated by the new degree-one generators. -/
def deningerSullivanNewIdeal : Ideal (ExteriorAlgebra k (V × W)) :=
  Ideal.span (Set.range fun w : W => ι k ((0, w) : V × W))

variable {k V W}

/-- A new generator moves past any element up to replacing that element: generators
anticommute, so odd generators are normal. -/
theorem deningerSullivanNew_normal (w : W) (z : ExteriorAlgebra k (V × W)) :
    ∃ z' : ExteriorAlgebra k (V × W),
      ι k ((0, w) : V × W) * z = z' * ι k ((0, w) : V × W) := by
  induction z using ExteriorAlgebra.induction with
  | algebraMap r =>
      exact ⟨algebraMap k (ExteriorAlgebra k (V × W)) r, (Algebra.commutes r _).symm⟩
  | ι m =>
      refine ⟨-(ι k m), ?_⟩
      rw [neg_mul]
      exact add_eq_zero_iff_eq_neg.mp (ExteriorAlgebra.ι_add_mul_swap _ m)
  | mul a b ha hb =>
      obtain ⟨a', ha'⟩ := ha
      obtain ⟨b', hb'⟩ := hb
      refine ⟨a' * b', ?_⟩
      rw [← mul_assoc, ha', mul_assoc, hb', ← mul_assoc]
  | add a b ha hb =>
      obtain ⟨a', ha'⟩ := ha
      obtain ⟨b', hb'⟩ := hb
      refine ⟨a' + b', ?_⟩
      rw [mul_add, ha', hb', add_mul]

/-- **The new-generator ideal is two-sided.** -/
theorem deningerSullivanNewIdeal_mul_right {i : ExteriorAlgebra k (V × W)}
    (hi : i ∈ deningerSullivanNewIdeal k V W) (z : ExteriorAlgebra k (V × W)) :
    i * z ∈ deningerSullivanNewIdeal k V W := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hi
  · rintro _ ⟨w, rfl⟩
    obtain ⟨z', hz'⟩ := deningerSullivanNew_normal (V := V) w z
    rw [hz']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨w, rfl⟩)
  · rw [zero_mul]
    exact Submodule.zero_mem _
  · intro p q _ _ hp hq
    rw [add_mul]
    exact Submodule.add_mem _ hp hq
  · intro a p _ hp
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ a hp

instance deningerSullivanNewIdeal_isTwoSided : (deningerSullivanNewIdeal k V W).IsTwoSided :=
  ⟨fun b hi => deningerSullivanNewIdeal_mul_right hi b⟩

theorem deningerSullivanNewIdeal_le_ker :
    deningerSullivanNewIdeal k V W ≤ RingHom.ker (deningerSullivanAugmentation k V W) := by
  rw [deningerSullivanNewIdeal, Ideal.span_le]
  rintro _ ⟨w, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker, deningerSullivanAugmentation_ι]
  exact map_zero _

/-- **The relative extension is the old algebra plus the new-generator ideal.** -/
theorem deningerSullivan_decomposition (x : ExteriorAlgebra k (V × W)) :
    ∃ y : ExteriorAlgebra k V, ∃ i ∈ deningerSullivanNewIdeal k V W,
      x = deningerSullivanInclusion k V W y + i := by
  have hx : x ∈ Algebra.adjoin k
      (Set.range (ι k : (V × W) →ₗ[k] ExteriorAlgebra k (V × W))) := by
    rw [CliffordAlgebra.adjoin_range_ι]
    trivial
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨p, rfl⟩ := hy
      refine ⟨ι k p.1, ι k ((0, p.2) : V × W), Ideal.subset_span ⟨p.2, rfl⟩, ?_⟩
      rw [deningerSullivanInclusion_ι, ← map_add]
      congr 1
      exact (Prod.ext (add_zero p.1) (zero_add p.2)).symm
  | algebraMap r =>
      refine ⟨algebraMap k (ExteriorAlgebra k V) r, 0, Submodule.zero_mem _, ?_⟩
      rw [AlgHom.commutes, add_zero]
  | add a b _ _ ha hb =>
      obtain ⟨y₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨y₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨y₁ + y₂, i₁ + i₂, Submodule.add_mem _ hi₁ hi₂, ?_⟩
      rw [map_add]
      abel
  | mul a b _ _ ha hb =>
      obtain ⟨y₁, i₁, hi₁, rfl⟩ := ha
      obtain ⟨y₂, i₂, hi₂, rfl⟩ := hb
      refine ⟨y₁ * y₂, deningerSullivanInclusion k V W y₁ * i₂
        + i₁ * deningerSullivanInclusion k V W y₂ + i₁ * i₂, ?_, ?_⟩
      · exact Submodule.add_mem _ (Submodule.add_mem _ (Ideal.mul_mem_left _ _ hi₂)
          (deningerSullivanNewIdeal_mul_right hi₁ _)) (deningerSullivanNewIdeal_mul_right hi₁ _)
      · rw [map_mul]
        noncomm_ring

/-- **The augmentation ideal of the relative extension is generated by the new generators.**
This is the freeness of the relative extension: the new generators cut out exactly the old
algebra. -/
theorem deningerSullivanAugmentation_ker :
    RingHom.ker (deningerSullivanAugmentation k V W) = deningerSullivanNewIdeal k V W := by
  refine le_antisymm ?_ deningerSullivanNewIdeal_le_ker
  intro x hx
  obtain ⟨y, i, hi, rfl⟩ := deningerSullivan_decomposition x
  rw [RingHom.mem_ker, map_add,
    RingHom.mem_ker.mp (deningerSullivanNewIdeal_le_ker hi), add_zero] at hx
  have hy : y = 0 := by
    have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
      (V := V) (W := W)) y
    simp only [AlgHom.comp_apply, AlgHom.id_apply] at h
    rw [h] at hx
    exact hx
  subst hy
  simpa using hi

/-- **The relative extension modulo its new generators is the old algebra.** -/
noncomputable def deningerSullivanRelativeEquiv :
    (ExteriorAlgebra k (V × W) ⧸ deningerSullivanNewIdeal k V W) ≃ₐ[k] ExteriorAlgebra k V :=
  (Ideal.quotientEquivAlgOfEq k deningerSullivanAugmentation_ker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := deningerSullivanAugmentation k V W)
      (fun y => ⟨deningerSullivanInclusion k V W y, by
        have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
          (V := V) (W := W)) y
        simpa using h⟩))

/-- **The range of the inclusion is the subalgebra generated by the old generators.** -/
theorem deningerSullivanInclusion_range :
    (deningerSullivanInclusion k V W).range
      = Algebra.adjoin k (Set.range fun v : V => ι k ((v, 0) : V × W)) := by
  refine le_antisymm ?_ ?_
  · rintro x ⟨y, rfl⟩
    show deningerSullivanInclusion k V W y
      ∈ Algebra.adjoin k (Set.range fun v : V => ι k ((v, 0) : V × W))
    induction y using ExteriorAlgebra.induction with
    | algebraMap r =>
        rw [AlgHom.commutes]
        exact Subalgebra.algebraMap_mem _ r
    | ι v =>
        rw [deningerSullivanInclusion_ι]
        exact Algebra.subset_adjoin ⟨v, rfl⟩
    | mul a b ha hb =>
        rw [map_mul]
        exact Subalgebra.mul_mem _ ha hb
    | add a b ha hb =>
        rw [map_add]
        exact Subalgebra.add_mem _ ha hb
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨v, rfl⟩
    exact ⟨ι k v, deningerSullivanInclusion_ι v⟩

end RelativeExtension

section Filtration

variable (k V W B : Type*) [CommRing k] [AddCommGroup V] [Module k V] [AddCommGroup W]
  [Module k W] [Preorder B]

/-- **A relative Sullivan extension.**  The new generators carry a filtration indexed by a
well-ordered type which exhausts them, and the differential of a generator appearing at a stage
lies in the subalgebra generated by the old generators together with the generators of strictly
earlier stages. -/
structure DeningerRelativeSullivan where
  /-- The filtration of the space of new generators. -/
  filt : B → Submodule k W
  /-- The filtration is increasing. -/
  mono : Monotone filt
  /-- The filtration exhausts the new generators. -/
  exhaust : ⨆ b, filt b = ⊤
  /-- The differential of the new generators. -/
  d : W →ₗ[k] ExteriorAlgebra k (V × W)
  /-- Lower triangularity: the differential of a stage lies in the algebra of earlier stages. -/
  lower : ∀ b : B, ∀ w ∈ filt b, d w ∈ Algebra.adjoin k
    ((Set.range fun v : V => ι k ((v, 0) : V × W)) ∪
      ⋃ b' ∈ {b' : B | b' < b}, (fun w : W => ι k ((0, w) : V × W)) '' (filt b' : Set W))

variable {k V W B}

end Filtration

section FirstLayer

variable (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V]

/-- **The differential of the first relative Sullivan layer.**  The new degree-one generators are
indexed by the degree-two part, and the differential of a generator is the degree-two element it
kills. -/
def deningerSullivanFirstDifferential :
    (⋀[k]^2 V) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^2 V)) :=
  (deningerSullivanInclusion k V (⋀[k]^2 V)).toLinearMap ∘ₗ (⋀[k]^2 V).subtype

@[simp]
theorem deningerSullivanFirstDifferential_apply (w : ⋀[k]^2 V) :
    deningerSullivanFirstDifferential k V w
      = deningerSullivanInclusion k V (⋀[k]^2 V) (w : ExteriorAlgebra k V) := rfl

/-- **The first layer kills the degree-two products**: every product of two generators is the
differential of a new generator. -/
theorem deningerSullivanFirstDifferential_covers (a b : V) :
    deningerSullivanFirstDifferential k V ⟨ι k a * ι k b, deningerExteriorTwo_mem a b⟩
      = deningerSullivanInclusion k V (⋀[k]^2 V) (ι k a * ι k b) := rfl

/-- The differential of the first layer is injective, so the layer creates no new degree-one
cohomology. -/
theorem deningerSullivanFirstDifferential_injective :
    Function.Injective (deningerSullivanFirstDifferential k V) := by
  intro x y h
  exact Subtype.ext (deningerSullivanInclusion_injective h)

variable {k V}

/-- **The ideal spanned by the first-layer differential is exactly the ideal to be killed.**
Pulling back along the inclusion, the span of the differential of the first layer is the Milnor
ideal, which by `deningerMilnorEpsilon_ker` is the kernel of the map to the two-term algebra. -/
theorem deningerSullivanFirstDifferential_span :
    Ideal.span (Set.range ((⋀[k]^2 V).subtype)) = deningerMilnorIdeal k V := by
  rw [deningerMilnorIdeal]
  congr 1
  exact Subtype.range_coe

section SquareZeroTarget

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

theorem deningerSullivanFirstDifferential_span_eq_ker :
    Ideal.span (Set.range ((⋀[k]^2 V).subtype))
      = RingHom.ker (deningerMilnorEpsilon k V) := by
  rw [deningerSullivanFirstDifferential_span, deningerMilnorEpsilon_ker]

end SquareZeroTarget

variable (k V)

/-- **The first relative Sullivan layer**, with its one-stage filtration and its lower-triangular
differential: the differential of every new generator lies in the subalgebra generated by the old
generators. -/
noncomputable def deningerSullivanFirstLayer :
    DeningerRelativeSullivan k V (⋀[k]^2 V) Unit where
  filt _ := ⊤
  mono := fun _ _ _ => le_refl _
  exhaust := by
    simp
  d := deningerSullivanFirstDifferential k V
  lower := by
    intro b w _
    have hempty : (⋃ b' ∈ {b' : Unit | b' < b},
        (fun w : (⋀[k]^2 V) => ι k ((0, w) : V × (⋀[k]^2 V))) ''
          ((⊤ : Submodule k (⋀[k]^2 V)) : Set (⋀[k]^2 V)))
        = (∅ : Set (ExteriorAlgebra k (V × (⋀[k]^2 V)))) := by
      simp
    rw [hempty, Set.union_empty, ← deningerSullivanInclusion_range]
    exact ⟨(w : ExteriorAlgebra k V), rfl⟩

section Projection

variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

/-- **The projection of the first layer onto the two-term algebra is surjective**, which is the
algebra-level half of the quasi-isomorphism: the relative extension still maps onto the Milnor
algebra. -/
theorem deningerSullivanFirstLayerProjection_surjective :
    Function.Surjective
      ((deningerMilnorEpsilon k V).comp (deningerSullivanAugmentation k V (⋀[k]^2 V))) := by
  intro x
  obtain ⟨z, hz⟩ := deningerMilnorEpsilon_surjective (k := k) (V := V) x
  refine ⟨deningerSullivanInclusion k V (⋀[k]^2 V) z, ?_⟩
  have h := AlgHom.congr_fun (deningerSullivanAugmentation_comp_inclusion (k := k)
    (V := V) (W := (⋀[k]^2 V))) z
  rw [AlgHom.comp_apply, AlgHom.id_apply] at h
  rw [AlgHom.comp_apply, h, hz]

end Projection

end FirstLayer

section FirstLayerDifferential

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]

/-- The grading involution is the identity on the degree-two part. -/
theorem deningerExteriorInvolute_exteriorTwo {U : Type*} [AddCommGroup U] [Module k U]
    {x : ExteriorAlgebra k U} (hx : x ∈ ⋀[k]^2 U) :
    deningerExteriorInvolute k U x = x := by
  have hx' : x ∈ LinearMap.range (ι k : U →ₗ[k] ExteriorAlgebra k U) *
      LinearMap.range (ι k : U →ₗ[k] ExteriorAlgebra k U) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerExteriorInvolute_ι, deningerExteriorInvolute_ι, neg_mul_neg]
  · intro p q hp hq
    rw [map_add, hp, hq]

/-- The relative inclusion carries the degree-two part into the degree-two part. -/
theorem deningerSullivanInclusion_exteriorTwo (W : Type*) [AddCommGroup W] [Module k W]
    {x : ExteriorAlgebra k V} (hx : x ∈ ⋀[k]^2 V) :
    deningerSullivanInclusion k V W x ∈ ⋀[k]^2 (V × W) := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι]
    exact deningerExteriorTwo_mem _ _
  · intro p q hp hq
    rw [map_add]
    exact Submodule.add_mem _ hp hq

variable (k V)

/-- The generator assignment of the first Sullivan layer on the whole generator space: the old
generators are closed and every new generator maps to the degree-two element it kills. -/
noncomputable def deningerSullivanFirstPhi :
    (V × (⋀[k]^2 V)) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^2 V)) :=
  (deningerSullivanFirstDifferential k V).comp (LinearMap.snd k V (⋀[k]^2 V))

@[simp]
theorem deningerSullivanFirstPhi_apply (u : V × (⋀[k]^2 V)) :
    deningerSullivanFirstPhi k V u =
      deningerSullivanInclusion k V (⋀[k]^2 V) ((u.2 : ExteriorAlgebra k V)) :=
  rfl

variable {k V}

/-- Every generator value of the first layer lies in the degree-two part. -/
theorem deningerSullivanFirstPhi_mem (u : V × (⋀[k]^2 V)) :
    deningerSullivanFirstPhi k V u ∈ ⋀[k]^2 (V × (⋀[k]^2 V)) :=
  deningerSullivanInclusion_exteriorTwo _ u.2.2

/-- The generator values of the first layer are central, so they determine an odd derivation. -/
theorem deningerSullivanFirstPhi_commute (u : V × (⋀[k]^2 V))
    (x : ExteriorAlgebra k (V × (⋀[k]^2 V))) :
    Commute (deningerSullivanFirstPhi k V u) x :=
  deningerExteriorPowerTwo_central (deningerSullivanFirstPhi_mem u) x

/-- The generator values of the first layer are invariant under the grading involution. -/
theorem deningerSullivanFirstPhi_involute (u : V × (⋀[k]^2 V)) :
    deningerExteriorInvolute k (V × (⋀[k]^2 V)) (deningerSullivanFirstPhi k V u) =
      deningerSullivanFirstPhi k V u :=
  deningerExteriorInvolute_exteriorTwo (deningerSullivanFirstPhi_mem u)

variable (k V)

/-- **The differential of the first relative Sullivan layer**, as an odd derivation of the whole
extension algebra. -/
noncomputable def deningerSullivanFirstLayerDifferential :
    ExteriorAlgebra k (V × (⋀[k]^2 V)) →ₗ[k] ExteriorAlgebra k (V × (⋀[k]^2 V)) :=
  deningerOddDerivation (deningerSullivanFirstPhi k V) deningerSullivanFirstPhi_commute

variable {k V}

/-- The old generators are closed. -/
@[simp]
theorem deningerSullivanFirstLayerDifferential_old (v : V) :
    deningerSullivanFirstLayerDifferential k V (ι k ((v, 0) : V × (⋀[k]^2 V))) = 0 := by
  rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
    deningerSullivanFirstPhi_apply]
  simp

/-- Every new generator has the degree-two element it kills as differential. -/
@[simp]
theorem deningerSullivanFirstLayerDifferential_new (w : ⋀[k]^2 V) :
    deningerSullivanFirstLayerDifferential k V (ι k ((0, w) : V × (⋀[k]^2 V))) =
      deningerSullivanInclusion k V (⋀[k]^2 V) (w : ExteriorAlgebra k V) := by
  rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
    deningerSullivanFirstPhi_apply]

/-- **The graded Leibniz rule for the first-layer differential.** -/
theorem deningerSullivanFirstLayerDifferential_leibniz
    (x y : ExteriorAlgebra k (V × (⋀[k]^2 V))) :
    deningerSullivanFirstLayerDifferential k V (x * y) =
      deningerExteriorInvolute k (V × (⋀[k]^2 V)) x *
          deningerSullivanFirstLayerDifferential k V y +
        deningerSullivanFirstLayerDifferential k V x * y :=
  deningerOddDerivation_leibniz _ _ x y

/-- The first-layer differential kills the image of the degree-two part. -/
theorem deningerSullivanFirstLayerDifferential_kill {x : ExteriorAlgebra k V}
    (hx : x ∈ ⋀[k]^2 V) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanInclusion k V (⋀[k]^2 V) x) = 0 := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι,
      deningerSullivanFirstLayerDifferential_leibniz,
      deningerSullivanFirstLayerDifferential_old,
      deningerSullivanFirstLayerDifferential_old]
    simp
  · intro p q hp hq
    rw [map_add, map_add, hp, hq, add_zero]

/-- **The first-layer differential squares to zero**, so the first relative Sullivan layer is an
honest differential graded algebra. -/
theorem deningerSullivanFirstLayerDifferential_comp_self
    (x : ExteriorAlgebra k (V × (⋀[k]^2 V))) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanFirstLayerDifferential k V x) = 0 :=
  deningerOddDerivation_comp_self _ _ deningerSullivanFirstPhi_involute
    (fun u => deningerSullivanFirstLayerDifferential_kill u.2.2) x

/-- The base of closed generators of the first layer: the old generators. -/
def deningerSullivanFirstBase (k V : Type*) [CommRing k] [AddCommGroup V] [Module k V] :
    Submodule k (V × (⋀[k]^2 V)) :=
  Submodule.prod (⊤ : Submodule k V) (⊥ : Submodule k (⋀[k]^2 V))

theorem deningerSullivanFirstBase_mem (v : V) :
    ((v, 0) : V × (⋀[k]^2 V)) ∈ deningerSullivanFirstBase k V :=
  ⟨Submodule.mem_top, Submodule.zero_mem _⟩

/-- The image of the degree-two part lies in the subalgebra of the old generators. -/
theorem deningerSullivanInclusion_mem_baseSubalgebra {x : ExteriorAlgebra k V}
    (hx : x ∈ ⋀[k]^2 V) :
    deningerSullivanInclusion k V (⋀[k]^2 V) x ∈
      deningerGeneratorSubalgebra (deningerSullivanFirstBase k V) := by
  have hx' : x ∈ LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) *
      LinearMap.range (ι k : V →ₗ[k] ExteriorAlgebra k V) := by
    rw [← pow_two]
    exact hx
  refine Submodule.mul_induction_on hx' ?_ ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [map_mul, deningerSullivanInclusion_ι, deningerSullivanInclusion_ι]
    exact Subalgebra.mul_mem _
      (deningerGeneratorSubalgebra_ι (deningerSullivanFirstBase_mem a))
      (deningerGeneratorSubalgebra_ι (deningerSullivanFirstBase_mem b))
  · intro p q hp hq
    rw [map_add]
    exact Subalgebra.add_mem _ hp hq

variable (k V)

/-- **The first relative Sullivan layer as a Sullivan tower.**  Its one stage sits above the base of
closed old generators, its differential is the odd derivation of the layer, and lower triangularity
holds because every new generator differentiates into the subalgebra of the old ones.  In
particular the tower structure is not vacuous. -/
noncomputable def deningerSullivanFirstTower :
    DeningerSullivanTower k (V × (⋀[k]^2 V)) Unit where
  base := deningerSullivanFirstBase k V
  filt _ := ⊤
  base_le _ := le_top
  mono := fun _ _ _ => le_refl _
  exhaust := by simp
  phi := deningerSullivanFirstPhi k V
  central := deningerSullivanFirstPhi_commute
  involute := deningerSullivanFirstPhi_involute
  lower := by
    intro b u _
    have hempty : (⨆ b' ∈ {b' : Unit | b' < b}, (⊤ : Submodule k (V × (⋀[k]^2 V)))) = ⊥ := by
      simp
    rw [hempty, sup_bot_eq]
    exact deningerSullivanInclusion_mem_baseSubalgebra u.2.2
  kill := fun u => deningerSullivanFirstLayerDifferential_kill u.2.2

variable {k V}

@[simp]
theorem deningerSullivanFirstTower_d :
    (deningerSullivanFirstTower k V).d = deningerSullivanFirstLayerDifferential k V :=
  rfl

/-- **The degree-one cocycles of the first layer are exactly the old generators.**  A new generator
is never closed, so the first layer creates no degree-one cohomology and its degree-one cocycle
space is the base `V`. -/
theorem deningerSullivanFirstPhi_ker :
    LinearMap.ker (deningerSullivanFirstPhi k V) = deningerSullivanFirstBase k V := by
  refine le_antisymm (fun u hu => ?_) (fun u hu => ?_)
  · refine ⟨Submodule.mem_top, ?_⟩
    have h : deningerSullivanInclusion k V (⋀[k]^2 V) ((u.2 : ExteriorAlgebra k V)) = 0 := hu
    have h0 : ((u.2 : ExteriorAlgebra k V)) = 0 := by
      have := deningerSullivanInclusion_injective (k := k) (V := V) (W := (⋀[k]^2 V))
      exact this (by rw [h, map_zero])
    exact Submodule.mem_bot k |>.mpr (Subtype.ext h0)
  · have h0 : u.2 = 0 := (Submodule.mem_bot k).mp hu.2
    show deningerSullivanInclusion k V (⋀[k]^2 V) ((u.2 : ExteriorAlgebra k V)) = 0
    rw [h0]
    simp

/-- The first-layer tower is closed exactly on the old generators. -/
theorem deningerSullivanFirstTower_d_ι_eq_zero_iff (u : V × (⋀[k]^2 V)) :
    (deningerSullivanFirstTower k V).d (ι k u) = 0 ↔ u ∈ deningerSullivanFirstBase k V := by
  rw [(deningerSullivanFirstTower k V).d_ι_eq_zero_iff]
  show u ∈ LinearMap.ker (deningerSullivanFirstPhi k V) ↔ _
  rw [deningerSullivanFirstPhi_ker]

/-- **The old algebra consists of cocycles.**  The first-layer differential vanishes on the whole
image of `Λ(V)`, because it vanishes on the old generators and obeys the Leibniz rule. -/
theorem deningerSullivanFirstLayerDifferential_inl (z : ExteriorAlgebra k V) :
    deningerSullivanFirstLayerDifferential k V
      (deningerSullivanInclusion k V (⋀[k]^2 V) z) = 0 := by
  induction z using ExteriorAlgebra.induction with
  | algebraMap r =>
    rw [AlgHom.commutes, deningerSullivanFirstLayerDifferential,
      deningerOddDerivation_algebraMap]
  | ι v =>
    rw [deningerSullivanInclusion_ι, deningerSullivanFirstLayerDifferential_old]
  | add a b ha hb => rw [map_add, map_add, ha, hb, add_zero]
  | mul a b ha hb =>
    rw [map_mul, deningerSullivanFirstLayerDifferential_leibniz, ha, hb]
    simp

end FirstLayerDifferential

section FirstLayerChainMap

open HTGeometry

variable {k V : Type*} [CommRing k] [AddCommGroup V] [Module k V]
variable [Module kᵐᵒᵖ V] [IsCentralScalar k V]

variable (k V)

/-- The map of the first layer onto the two-term algebra: the augmentation followed by the Milnor
projection. -/
noncomputable def deningerSullivanFirstProjection :
    ExteriorAlgebra k (V × (⋀[k]^2 V)) →ₐ[k] TrivSqZeroExt k V :=
  (deningerMilnorEpsilon k V).comp (deningerSullivanAugmentation k V (⋀[k]^2 V))

variable {k V}

@[simp]
theorem deningerSullivanFirstProjection_inl (z : ExteriorAlgebra k V) :
    deningerSullivanFirstProjection k V (deningerSullivanInclusion k V (⋀[k]^2 V) z) =
      deningerMilnorEpsilon k V z := by
  rw [deningerSullivanFirstProjection, AlgHom.comp_apply]
  have h := AlgHom.congr_fun
    (deningerSullivanAugmentation_comp_inclusion (k := k) (V := V) (W := (⋀[k]^2 V))) z
  rw [AlgHom.comp_apply, AlgHom.id_apply] at h
  rw [h]

/-- **The projection is a chain map.**  The target carries the zero differential, and the
projection kills every coboundary of the first layer, so it is a map of differential graded
algebras. -/
theorem deningerSullivanFirstProjection_comp_d (x : ExteriorAlgebra k (V × (⋀[k]^2 V))) :
    deningerSullivanFirstProjection k V
      (deningerSullivanFirstLayerDifferential k V x) = 0 := by
  induction x using ExteriorAlgebra.induction with
  | algebraMap r =>
    rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_algebraMap, map_zero]
  | ι u =>
    rw [deningerSullivanFirstLayerDifferential, deningerOddDerivation_ι,
      deningerSullivanFirstPhi_apply, deningerSullivanFirstProjection_inl]
    exact deningerMilnorIdeal_le_ker (Ideal.subset_span u.2.2)
  | add a b ha hb => rw [map_add, map_add, ha, hb, add_zero]
  | mul a b ha hb =>
    rw [deningerSullivanFirstLayerDifferential_leibniz, map_add, map_mul, map_mul, ha, hb]
    simp

/-- **Every class of the two-term algebra is represented by a cocycle.**  The old algebra consists
of cocycles and already surjects onto the target, so the projection is surjective on cohomology. -/
theorem deningerSullivanFirstProjection_cocycle_surjective (x : TrivSqZeroExt k V) :
    ∃ z : ExteriorAlgebra k (V × (⋀[k]^2 V)),
      deningerSullivanFirstLayerDifferential k V z = 0 ∧
        deningerSullivanFirstProjection k V z = x := by
  obtain ⟨y, hy⟩ := deningerMilnorEpsilon_surjective (k := k) (V := V) x
  refine ⟨deningerSullivanInclusion k V (⋀[k]^2 V) y, ?_, ?_⟩
  · exact deningerSullivanFirstLayerDifferential_inl y
  · rw [deningerSullivanFirstProjection_inl, hy]

end FirstLayerChainMap

end RHTower

