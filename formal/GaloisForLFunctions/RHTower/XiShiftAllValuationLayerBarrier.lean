import GaloisForLFunctions.HTGeometry.PrimeDependentValuationLayerBarrier
import GaloisForLFunctions.RHTower.XiShiftPrimeHypertranscendence

/-!
# The xi shift source across the complete prime-zeta valuation layer

The filtered von Mangoldt source exposed by the completed `+2` shift of `xi'/xi` is nonzero on
every positive prime power, hence nowhere vanishing on every valuation layer at once.  The
triangular valuation-layer clock law therefore applies at every avoided layer, and the actual
upper-end carrier stays hypertranscendental over the differential field generated by the genuine
coordinate together with every prime-zeta dilation `P(rs)`.

This strictly strengthens the coordinate-field statement, whose base is only `ℂ(s)`.
-/

namespace RHTower

open ArithmeticFunction Filter Set
open scoped Differential LSeries.notation

noncomputable section

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

local instance xiShiftLayerUpperEndDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance xiShiftLayerUpperEndComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance xiShiftLayerUpperEndDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

/-- On every positive prime power the filtered von Mangoldt coefficient is nonzero.  The von
Mangoldt factor is the prime logarithm and the filtering factor `1 - n ^ (-2)` cannot vanish
because the argument exceeds one. -/
theorem filteredVonMangoldtCoeff_primePow_ne_zero (p : Nat.Primes) (e : ℕ) :
    filteredVonMangoldtCoeff ((p : ℕ) ^ (e + 1)) ≠ 0 := by
  have hp1 : (1 : ℝ) < (p : ℕ) := by exact_mod_cast p.2.one_lt
  have hN1 : (1 : ℝ) < (((p : ℕ) ^ (e + 1) : ℕ) : ℝ) := by
    have : ((p : ℕ) : ℝ) ^ (e + 1) ≤ (((p : ℕ) ^ (e + 1) : ℕ) : ℝ) := by
      push_cast
      exact le_refl _
    refine lt_of_lt_of_le ?_ this
    exact one_lt_pow₀ hp1 (Nat.succ_ne_zero e)
  rw [filteredVonMangoldtCoeff]
  apply mul_ne_zero
  · rw [ArithmeticFunction.vonMangoldt_apply_pow (Nat.succ_ne_zero e),
      ArithmeticFunction.vonMangoldt_apply_prime p.2]
    exact_mod_cast (Real.log_pos hp1).ne'
  · have hpow : (((p : ℕ) ^ (e + 1) : ℕ) : ℝ) ^ (-(2 : ℝ)) < 1 :=
      Real.rpow_lt_one_of_one_lt_of_neg hN1 (by norm_num)
    have hcpow : ((((p : ℕ) ^ (e + 1) : ℕ) : ℂ)) ^ (-(2 : ℂ)) =
        ((((p : ℕ) ^ (e + 1) : ℕ) : ℝ) ^ (-(2 : ℝ)) : ℝ) := by
      simpa using
        (Complex.ofReal_cpow
          (Nat.cast_nonneg ((p : ℕ) ^ (e + 1))) (-(2 : ℝ))).symm
    rw [hcpow]
    exact_mod_cast (sub_pos.mpr hpow).ne'

/-- Every valuation layer of the filtered von Mangoldt source is nowhere vanishing, so the set of
usable layers is all of `ℕ` and in particular infinite. -/
theorem filteredVonMangoldt_nonvanishing_layers_infinite :
    ¬ {e : ℕ | ∀ p : Nat.Primes,
        filteredVonMangoldtFiniteAbscissaSource.1 ((p : ℕ) ^ (e + 1)) ≠ 0}.Finite := by
  have hset : {e : ℕ | ∀ p : Nat.Primes,
      filteredVonMangoldtFiniteAbscissaSource.1 ((p : ℕ) ^ (e + 1)) ≠ 0} =
      (Set.univ : Set ℕ) := by
    ext e
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true,
      filteredVonMangoldtFiniteAbscissaSource_val,
      filteredVonMangoldtArithmetic_apply]
    intro p
    exact filteredVonMangoldtCoeff_primePow_ne_zero p e
  rw [hset]
  exact Set.infinite_univ

/-- **All-valuation Euler barrier for the xi shift source.**  The actual upper-end carrier of the
filtered von Mangoldt source is differentially independent over the single differential field
generated by the genuine coordinate and every prime-zeta dilation simultaneously. -/
theorem filteredVonMangoldtUpperEndCarrier_differentialIndependent_over_all_valuationLayers :
    GaloisForLFunctions.DifferentialIndependent
      analyticScalarValuationLayerDifferentialField
      (fun _ : Unit ↦ filteredVonMangoldtUpperEndCarrier) := by
  apply analyticPrimeProfileCarrier_differentialIndependent_over_all_valuationLayers
    filteredVonMangoldtFiniteAbscissaSource
  · exact filteredVonMangoldtArithmetic_supportedOnPositivePrimePowers
  · exact filteredVonMangoldt_nonvanishing_layers_infinite

/-- **Relative hypertranscendence of the xi shift source.**  The corrected completed `+2` shift
defect of `xi'/xi` is hypertranscendental over the complete prime-zeta valuation-layer field. -/
theorem filteredVonMangoldtUpperEndCarrier_hypertranscendentalOver_all_valuationLayers :
    HypertranscendentalOver
      analyticScalarValuationLayerDifferentialField
      filteredVonMangoldtUpperEndCarrier := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  exact filteredVonMangoldtUpperEndCarrier_differentialIndependent_over_all_valuationLayers

/-! ## The uncorrected shift carrier

The rational calibration separating the uncorrected shift from the arithmetic source is a sum of
three simple poles in the genuine coordinate.  Each is an upper-end analytic germ, and each is a
rational gauge, so rational-gauge invariance transports hypertranscendence to the uncorrected
completed shift itself. -/

/-- One linear factor `-I z + c` of the rational shift calibration. -/
def xiShiftLinearFactor (c : ℝ) : ℂ → ℂ := fun z ↦ -Complex.I * z + (c : ℂ)

/-- Above height one the linear factor has positive real part, hence never vanishes. -/
theorem xiShiftLinearFactor_ne_zero {c : ℝ} (hc : -1 ≤ c) {z : ℂ} (hz : 1 < z.im) :
    xiShiftLinearFactor c z ≠ 0 := by
  intro h
  have hre : (xiShiftLinearFactor c z).re = z.im + c := by
    simp [xiShiftLinearFactor, Complex.add_re, Complex.mul_re]
  rw [h, Complex.zero_re] at hre
  linarith

theorem analyticOnNhd_xiShiftLinearFactor (c : ℝ) :
    AnalyticOnNhd ℂ (xiShiftLinearFactor c) (upperTail 1) :=
  (analyticOnNhd_const.mul analyticOnNhd_id).add analyticOnNhd_const

theorem analyticOnNhd_xiShiftLinearFactorInv {c : ℝ} (hc : -1 ≤ c) :
    AnalyticOnNhd ℂ (fun z ↦ (xiShiftLinearFactor c z)⁻¹) (upperTail 1) :=
  (analyticOnNhd_xiShiftLinearFactor c).inv
    (fun _z hz ↦ xiShiftLinearFactor_ne_zero hc hz)

/-- The linear factor as an upper-end analytic germ. -/
def xiShiftLinearFactorAnalytic (c : ℝ) : upperEndAnalyticSubring :=
  ⟨((xiShiftLinearFactor c : ℂ → ℂ) : Germ upperEndFilter ℂ),
    xiShiftLinearFactor c, 1, analyticOnNhd_xiShiftLinearFactor c, rfl⟩

/-- The reciprocal of the linear factor as an upper-end analytic germ. -/
def xiShiftLinearFactorInvAnalytic (c : ℝ) (hc : -1 ≤ c) : upperEndAnalyticSubring :=
  ⟨((fun z ↦ (xiShiftLinearFactor c z)⁻¹ : ℂ → ℂ) : Germ upperEndFilter ℂ),
    (fun z ↦ (xiShiftLinearFactor c z)⁻¹), 1,
    analyticOnNhd_xiShiftLinearFactorInv hc, rfl⟩

theorem xiShiftLinearFactorAnalytic_mul_inv (c : ℝ) (hc : -1 ≤ c) :
    xiShiftLinearFactorAnalytic c * xiShiftLinearFactorInvAnalytic c hc = 1 := by
  apply Subtype.ext
  have hupper : ∀ᶠ z in upperEndFilter, 1 < z.im := by
    rw [upperEndFilter_basis.eventually_iff]
    exact ⟨1, trivial, fun _ hz ↦ hz⟩
  change ((xiShiftLinearFactor c : ℂ → ℂ) : Germ upperEndFilter ℂ) *
      ((fun z ↦ (xiShiftLinearFactor c z)⁻¹ : ℂ → ℂ) : Germ upperEndFilter ℂ) = 1
  rw [← Germ.coe_mul, ← Germ.coe_one]
  apply Germ.coe_eq.mpr
  filter_upwards [hupper] with z hz
  exact mul_inv_cancel₀ (xiShiftLinearFactor_ne_zero hc hz)

/-- The linear factor germ is the evaluation germ of a genuine coordinate polynomial. -/
theorem xiShiftLinearFactorAnalytic_eq_poly (c : ℝ) :
    xiShiftLinearFactorAnalytic c =
      upperEndPolyToAnalytic
        (Polynomial.C (-Complex.I) * Polynomial.X + Polynomial.C ((c : ℂ))) := by
  apply Subtype.ext
  apply Germ.coe_eq.mpr
  exact Filter.Eventually.of_forall fun z ↦ by simp [xiShiftLinearFactor]

theorem xiShiftLinearFactorMero_mem_rationalCoordinate (c : ℝ) :
    algebraMap upperEndAnalyticSubring upperEndMeroField
        (xiShiftLinearFactorAnalytic c) ∈ upperEndRationalCoordinateField := by
  rw [xiShiftLinearFactorAnalytic_eq_poly]
  have hpoly : algebraMap upperEndAnalyticSubring upperEndMeroField
      (upperEndPolyToAnalytic
        (Polynomial.C (-Complex.I) * Polynomial.X + Polynomial.C ((c : ℂ)))) =
      upperEndPolyToMero
        (Polynomial.C (-Complex.I) * Polynomial.X + Polynomial.C ((c : ℂ))) := rfl
  rw [hpoly, ← upperEndRatfuncToMero_algebraMap_polynomial]
  exact upperEndRatfuncToMero_mem_rationalCoordinateField _

theorem xiShiftLinearFactorInvMero_mem_rationalCoordinate (c : ℝ) (hc : -1 ≤ c) :
    algebraMap upperEndAnalyticSubring upperEndMeroField
        (xiShiftLinearFactorInvAnalytic c hc) ∈ upperEndRationalCoordinateField := by
  rw [← algebraMap_upperEndAnalytic_inv_eq _ _
    (xiShiftLinearFactorAnalytic_mul_inv c hc)]
  exact upperEndRationalCoordinateField.inv_mem
    (xiShiftLinearFactorMero_mem_rationalCoordinate c)

/-- The rational calibration `1/(s+2) + 1/(s+1) - 1/(s-1)` separating the uncorrected completed
`+2` shift from its arithmetic source, as an upper-end analytic germ. -/
def xiShiftTwoRationalCorrectionAnalytic : upperEndAnalyticSubring :=
  xiShiftLinearFactorInvAnalytic 2 (by norm_num) +
    xiShiftLinearFactorInvAnalytic 1 (by norm_num) -
      xiShiftLinearFactorInvAnalytic (-1) (by norm_num)

/-- The rational calibration as an element of the meromorphic field. -/
def xiShiftTwoRationalCorrectionMero : upperEndMeroField :=
  algebraMap upperEndAnalyticSubring upperEndMeroField
    xiShiftTwoRationalCorrectionAnalytic

theorem xiShiftTwoRationalCorrectionMero_mem_rationalCoordinate :
    xiShiftTwoRationalCorrectionMero ∈ upperEndRationalCoordinateField := by
  rw [xiShiftTwoRationalCorrectionMero, xiShiftTwoRationalCorrectionAnalytic,
    map_sub, map_add]
  exact upperEndRationalCoordinateField.sub_mem
    (upperEndRationalCoordinateField.add_mem
      (xiShiftLinearFactorInvMero_mem_rationalCoordinate 2 (by norm_num))
      (xiShiftLinearFactorInvMero_mem_rationalCoordinate 1 (by norm_num)))
    (xiShiftLinearFactorInvMero_mem_rationalCoordinate (-1) (by norm_num))

/-- The actual uncorrected completed `+2` shift carrier of `xi'/xi`. -/
def xiLogDerivShiftTwoUncorrectedCarrier : upperEndMeroField :=
  filteredVonMangoldtUpperEndCarrier + xiShiftTwoRationalCorrectionMero

/-- **Rational-translation capstone.**  The uncorrected completed `+2` shift of `xi'/xi` is itself
hypertranscendental over the differential field generated by the genuine coordinate and every
prime-zeta dilation.  The rational calibration is a gauge inside the base, so it cannot repair the
crossing of the Euler completion boundary. -/
theorem xiLogDerivShiftTwoUncorrectedCarrier_hypertranscendentalOver_all_valuationLayers :
    HypertranscendentalOver
      analyticScalarValuationLayerDifferentialField
      xiLogDerivShiftTwoUncorrectedCarrier := by
  rw [hypertranscendentalOver_iff_differentialIndependent_singleton]
  exact differentialIndependent_over_all_valuationLayers_add_rationalCoordinate
    filteredVonMangoldtUpperEndCarrier_differentialIndependent_over_all_valuationLayers
    (fun _ : Unit ↦ xiShiftTwoRationalCorrectionMero)
    (fun _ ↦ xiShiftTwoRationalCorrectionMero_mem_rationalCoordinate)

/-- Upper-end germ of the uncorrected completed `+2` shift of the logarithmic derivative. -/
def xiLogDerivShiftTwoUncorrectedUpperEndGerm : Germ upperEndFilter ℂ :=
  ((fun z : ℂ ↦ logDeriv xi (-Complex.I * z + 2) - logDeriv xi (-Complex.I * z)) :
    Germ upperEndFilter ℂ)

/-- The meromorphic carrier is the image of a single analytic germ. -/
theorem xiLogDerivShiftTwoUncorrectedCarrier_eq_algebraMap :
    xiLogDerivShiftTwoUncorrectedCarrier =
      algebraMap upperEndAnalyticSubring upperEndMeroField
        (finiteAbscissaLSeriesToUpperEndAnalytic
            filteredVonMangoldtFiniteAbscissaSource +
          xiShiftTwoRationalCorrectionAnalytic) := by
  rw [xiLogDerivShiftTwoUncorrectedCarrier, map_add]
  rfl

/-- **Value reflection for the uncorrected shift.**  The analytic germ carried by the
hypertranscendental element above is exactly the uncorrected `+2` shift of the actual completed
logarithmic derivative. -/
theorem xiLogDerivShiftTwoUncorrectedCarrier_germ_eq :
    ((finiteAbscissaLSeriesToUpperEndAnalytic
          filteredVonMangoldtFiniteAbscissaSource +
        xiShiftTwoRationalCorrectionAnalytic : upperEndAnalyticSubring) :
      Germ upperEndFilter ℂ) =
      xiLogDerivShiftTwoUncorrectedUpperEndGerm := by
  have hdefect := filteredVonMangoldtUpperEndGerm_eq_xiLogDerivShiftTwoPrimeDefect
  rw [filteredVonMangoldtUpperEndGerm, xiLogDerivShiftTwoPrimeDefectUpperEndGerm]
    at hdefect
  change ((finiteAbscissaLSeriesToUpperEndAnalytic
      filteredVonMangoldtFiniteAbscissaSource : upperEndAnalyticSubring) :
      Germ upperEndFilter ℂ) +
    ((xiShiftTwoRationalCorrectionAnalytic : upperEndAnalyticSubring) :
      Germ upperEndFilter ℂ) = _
  rw [finiteAbscissaLSeriesToUpperEndAnalytic_coe, hdefect]
  change (((fun z : ℂ ↦
      logDeriv xi (-Complex.I * z + 2) - logDeriv xi (-Complex.I * z) -
        (1 / (-Complex.I * z + 2) + 1 / (-Complex.I * z + 1) -
          1 / (-Complex.I * z - 1))) : ℂ → ℂ) : Germ upperEndFilter ℂ) +
    (((fun z : ℂ ↦
        (xiShiftLinearFactor 2 z)⁻¹ + (xiShiftLinearFactor 1 z)⁻¹ -
          (xiShiftLinearFactor (-1) z)⁻¹) : ℂ → ℂ) : Germ upperEndFilter ℂ) = _
  rw [← Germ.coe_add]
  apply Germ.coe_eq.mpr
  apply Filter.Eventually.of_forall
  intro z
  simp only [Pi.add_apply, xiShiftLinearFactor, one_div]
  push_cast
  ring

end

end RHTower
