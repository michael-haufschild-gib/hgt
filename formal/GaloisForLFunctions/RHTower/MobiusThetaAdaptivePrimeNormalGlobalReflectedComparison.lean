import GaloisForLFunctions.RHTower.MobiusThetaAdaptivePrimeNormalReflectedGreenSource

/-!
# Global reflected adaptive common-test comparison

The local reflected adaptive source sector is closed and codiagonal-conservative
at every actual Xi divisor copy.  This file assembles all local scalar source
lines into one square-summable source field.

For a fixed prime label, the resolved source vector generated by its basis
element has norm exactly one: the retained head has norm one and the averaged
tail has norm at most `1/4`.  Coordinatewise scalar multiplication therefore
defines an isometric embedding from the complete Xi divisor Hilbert carrier
into the `ell^2` field of resolved arithmetic `ell^1` sources.  Its range is a
closed global common-test sector.

Fiberwise codiagonalization is a bounded map on that embedded sector, with
lower modulus `3/4` and upper modulus `5/4`.  Consequently its kernel on the
global sector is zero.  Applying the construction to the reflected adaptive
Green provenance gives one literal global source record whose codiagonal
vanishes exactly under RH.  Thus global assembly, closedness, and quantitative
faithfulness are unconditional; arithmetic annihilation of this explicit
codiagonal is the sole remaining selection theorem.
-/

open Complex Function Set Topology
open GaloisForLFunctions.HTGeometry

namespace RHTower

noncomputable section

abbrev AdaptivePrimeNormalReflectedResolvedFiber :=
  AdaptiveArithmeticL1 × AdaptiveArithmeticL1

abbrev AdaptivePrimeNormalGlobalReflectedResolvedL2 :=
  lp (fun _ : XiZeroCopy => AdaptivePrimeNormalReflectedResolvedFiber) 2

abbrev AdaptivePrimeNormalGlobalReflectedCodiagonalL2 :=
  lp (fun _ : XiZeroCopy => AdaptiveArithmeticL1) 2

/-- Unit local resolved source vector for one retained prime label. -/
def adaptivePrimeNormalReflectedResolvedUnit
    (p : Nat.Primes) (q : XiZeroCopy) :
    AdaptivePrimeNormalReflectedResolvedFiber :=
  adaptivePrimeNormalReflectedResolvedSource q
    (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)

theorem norm_adaptivePrimeNormalReflectedResolvedUnit
    (p : Nat.Primes) (q : XiZeroCopy) :
    ‖adaptivePrimeNormalReflectedResolvedUnit p q‖ = 1 := by
  rw [adaptivePrimeNormalReflectedResolvedUnit,
    adaptivePrimeNormalReflectedResolvedSource_apply, Prod.norm_def]
  have hhead :
      ‖adaptivePrimeNormalDiagonalEmbedding
        (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)‖ = 1 := by
    rw [adaptivePrimeNormalDiagonalEmbedding.norm_map]
    simp [lp.norm_single]
  have htail := norm_adaptivePrimeNormalReflectedTailOperator_le_quarter q
    (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)
  have hsingle :
      ‖(lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1 :
        AdaptivePrimeL1)‖ = 1 := by
    simp [lp.norm_single]
  rw [hsingle, mul_one] at htail
  rw [hhead, max_eq_left]
  linarith

private def adaptivePrimeNormalGlobalReflectedComparisonToFun
    (p : Nat.Primes) (a : XiDivisorL2) :
    AdaptivePrimeNormalGlobalReflectedResolvedL2 :=
  ⟨fun q => a q • adaptivePrimeNormalReflectedResolvedUnit p q,
    Memℓp.mono (lp.memℓp a).norm (fun q => by
      rw [norm_smul, norm_adaptivePrimeNormalReflectedResolvedUnit]
      simp)⟩

/-- Isometric global source-pointed comparison for one exact prime label. -/
def adaptivePrimeNormalGlobalReflectedComparison (p : Nat.Primes) :
    XiDivisorL2 →ₗᵢ[ℂ] AdaptivePrimeNormalGlobalReflectedResolvedL2 where
  toFun := adaptivePrimeNormalGlobalReflectedComparisonToFun p
  map_add' a b := by
    apply lp.ext
    funext q
    change (a q + b q) • adaptivePrimeNormalReflectedResolvedUnit p q =
      a q • adaptivePrimeNormalReflectedResolvedUnit p q +
        b q • adaptivePrimeNormalReflectedResolvedUnit p q
    exact add_smul _ _ _
  map_smul' c a := by
    apply lp.ext
    funext q
    change (c * a q) • adaptivePrimeNormalReflectedResolvedUnit p q =
      c • (a q • adaptivePrimeNormalReflectedResolvedUnit p q)
    exact mul_smul _ _ _
  norm_map' a := by
    apply le_antisymm
    · exact lp.norm_mono (by norm_num) (fun q => by
        change ‖a q • adaptivePrimeNormalReflectedResolvedUnit p q‖ ≤ ‖a q‖
        rw [norm_smul, norm_adaptivePrimeNormalReflectedResolvedUnit]
        simp)
    · exact lp.norm_mono (by norm_num) (fun q => by
        change ‖a q‖ ≤
          ‖(adaptivePrimeNormalGlobalReflectedComparisonToFun p a) q‖
        change ‖a q‖ ≤
          ‖a q • adaptivePrimeNormalReflectedResolvedUnit p q‖
        rw [norm_smul, norm_adaptivePrimeNormalReflectedResolvedUnit]
        simp)

@[simp]
theorem adaptivePrimeNormalGlobalReflectedComparison_apply
    (p : Nat.Primes) (a : XiDivisorL2) (q : XiZeroCopy) :
    adaptivePrimeNormalGlobalReflectedComparison p a q =
      a q • adaptivePrimeNormalReflectedResolvedUnit p q := by
  rfl

/-- Closed global common-test sector. -/
def adaptivePrimeNormalGlobalReflectedSector (p : Nat.Primes) :
    Submodule ℂ AdaptivePrimeNormalGlobalReflectedResolvedL2 :=
  LinearMap.range (adaptivePrimeNormalGlobalReflectedComparison p).toLinearMap

theorem adaptivePrimeNormalGlobalReflectedComparison_isClosed_range
    (p : Nat.Primes) :
    IsClosed (Set.range (adaptivePrimeNormalGlobalReflectedComparison p)) := by
  exact (adaptivePrimeNormalGlobalReflectedComparison p).isometry.isClosedEmbedding.isClosed_range

theorem adaptivePrimeNormalGlobalReflectedSector_isClosed
    (p : Nat.Primes) :
    IsClosed (adaptivePrimeNormalGlobalReflectedSector p :
      Set AdaptivePrimeNormalGlobalReflectedResolvedL2) := by
  change IsClosed (Set.range (adaptivePrimeNormalGlobalReflectedComparison p))
  exact adaptivePrimeNormalGlobalReflectedComparison_isClosed_range p

theorem norm_adaptivePrimeNormalReflectedCodiagonal_single_le
    (p : Nat.Primes) (q : XiZeroCopy) :
    ‖adaptivePrimeNormalReflectedCodiagonal q
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)‖ ≤
      (5 / 4 : ℝ) := by
  have htri := norm_add_le
    (adaptivePrimeNormalDiagonalEmbedding
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1))
    (adaptivePrimeNormalReflectedTailOperator q
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1))
  have htail := norm_adaptivePrimeNormalReflectedTailOperator_le_quarter q
    (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)
  have hsingle :
      ‖(lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1 :
        AdaptivePrimeL1)‖ = 1 := by
    simp [lp.norm_single]
  change ‖adaptivePrimeNormalDiagonalEmbedding
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) +
    adaptivePrimeNormalReflectedTailOperator q
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)‖ ≤ _
  rw [adaptivePrimeNormalDiagonalEmbedding.norm_map, hsingle] at htri
  rw [hsingle, mul_one] at htail
  linarith

private def adaptivePrimeNormalGlobalReflectedCodiagonalToFun
    (p : Nat.Primes) (a : XiDivisorL2) :
    AdaptivePrimeNormalGlobalReflectedCodiagonalL2 :=
  ⟨fun q => a q • adaptivePrimeNormalReflectedCodiagonal q
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1),
    Memℓp.mono ((lp.memℓp a).norm.const_smul (5 / 4 : ℝ)) (fun q => by
      rw [norm_smul, Pi.smul_apply, smul_eq_mul]
      simpa [mul_comm] using mul_le_mul_of_nonneg_left
        (norm_adaptivePrimeNormalReflectedCodiagonal_single_le p q)
        (norm_nonneg (a q)))⟩

/-- Global codiagonal of the fixed-prime reflected source comparison. -/
def adaptivePrimeNormalGlobalReflectedCodiagonal (p : Nat.Primes) :
    XiDivisorL2 →L[ℂ] AdaptivePrimeNormalGlobalReflectedCodiagonalL2 :=
  LinearMap.mkContinuous
    { toFun := adaptivePrimeNormalGlobalReflectedCodiagonalToFun p
      map_add' := fun a b => by
        apply lp.ext
        funext q
        change (a q + b q) •
            adaptivePrimeNormalReflectedCodiagonal q
              (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) =
          a q • adaptivePrimeNormalReflectedCodiagonal q
              (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) +
            b q • adaptivePrimeNormalReflectedCodiagonal q
              (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)
        exact add_smul _ _ _
      map_smul' := fun c a => by
        apply lp.ext
        funext q
        change (c * a q) • adaptivePrimeNormalReflectedCodiagonal q
            (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) =
          c • (a q • adaptivePrimeNormalReflectedCodiagonal q
            (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1))
        exact mul_smul _ _ _ }
    (5 / 4 : ℝ) (fun a => by
      have hmono :
          ‖adaptivePrimeNormalGlobalReflectedCodiagonalToFun p a‖ ≤
            ‖(5 / 4 : ℂ) • a‖ :=
        lp.norm_mono (by norm_num) (fun q => by
          change ‖a q • adaptivePrimeNormalReflectedCodiagonal q
              (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)‖ ≤
            ‖((5 / 4 : ℂ) • a) q‖
          rw [lp.coeFn_smul, Pi.smul_apply, norm_smul, norm_smul]
          norm_num
          simpa [mul_comm] using mul_le_mul_of_nonneg_left
            (norm_adaptivePrimeNormalReflectedCodiagonal_single_le p q)
            (norm_nonneg (a q)))
      rw [norm_smul] at hmono
      norm_num at hmono
      exact hmono)

@[simp]
theorem adaptivePrimeNormalGlobalReflectedCodiagonal_apply
    (p : Nat.Primes) (a : XiDivisorL2) (q : XiZeroCopy) :
    adaptivePrimeNormalGlobalReflectedCodiagonal p a q =
      a q • adaptivePrimeNormalReflectedCodiagonal q
        (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) := by
  rfl

/-- Uniform global lower modulus inherited from every local reflected
codiagonal. -/
theorem adaptivePrimeNormalGlobalReflectedCodiagonal_lower
    (p : Nat.Primes) (a : XiDivisorL2) :
    (3 / 4 : ℝ) * ‖a‖ ≤
      ‖adaptivePrimeNormalGlobalReflectedCodiagonal p a‖ := by
  have hmono : ‖(3 / 4 : ℂ) • a‖ ≤
      ‖adaptivePrimeNormalGlobalReflectedCodiagonal p a‖ :=
    lp.norm_mono (by norm_num) (fun q => by
      rw [lp.coeFn_smul, Pi.smul_apply,
        adaptivePrimeNormalGlobalReflectedCodiagonal_apply,
        norm_smul, norm_smul]
      norm_num
      have hsingle :
          ‖(lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1 :
            AdaptivePrimeL1)‖ = 1 := by
        simp [lp.norm_single]
      have hlower := adaptivePrimeNormalReflectedCodiagonal_lower q
        (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1)
      rw [hsingle, mul_one] at hlower
      simpa [mul_comm] using mul_le_mul_of_nonneg_left
        hlower
        (norm_nonneg (a q)))
  rw [norm_smul] at hmono
  norm_num at hmono
  exact hmono

theorem adaptivePrimeNormalGlobalReflectedCodiagonal_injective
    (p : Nat.Primes) :
    Function.Injective (adaptivePrimeNormalGlobalReflectedCodiagonal p) := by
  intro a b hab
  have hzero : adaptivePrimeNormalGlobalReflectedCodiagonal p (a - b) = 0 := by
    rw [map_sub, hab, sub_self]
  have hlower := adaptivePrimeNormalGlobalReflectedCodiagonal_lower p (a - b)
  rw [hzero, norm_zero] at hlower
  have hnorm : ‖a - b‖ = 0 := by nlinarith [norm_nonneg (a - b)]
  exact sub_eq_zero.mp (norm_eq_zero.mp hnorm)

/-- Fiberwise codiagonal of the global resolved record is exactly the global
observed source field. -/
theorem adaptivePrimeNormalGlobalReflectedComparison_codiagonal_apply
    (p : Nat.Primes) (a : XiDivisorL2) (q : XiZeroCopy) :
    resolvedDefectCodiagonal (R := ℂ)
        (adaptivePrimeNormalGlobalReflectedComparison p a q) =
      adaptivePrimeNormalGlobalReflectedCodiagonal p a q := by
  rw [adaptivePrimeNormalGlobalReflectedComparison_apply,
    map_smul,
    adaptivePrimeNormalGlobalReflectedCodiagonal_apply,
    adaptivePrimeNormalReflectedResolvedUnit,
    resolvedDefectCodiagonal_adaptivePrimeNormalReflectedResolvedSource]

namespace DeningerMeyerGaussianGreen

/-- One global source record containing every local reflected Green line. -/
def adaptivePrimeNormalGlobalReflectedGreenRecord
    (p : Nat.Primes) : AdaptivePrimeNormalGlobalReflectedResolvedL2 :=
  adaptivePrimeNormalGlobalReflectedComparison p
    (adaptivePrimeNormalReflectedHorizonGreenProvenance p)

theorem adaptivePrimeNormalGlobalReflectedGreenRecord_mem_sector
    (p : Nat.Primes) :
    adaptivePrimeNormalGlobalReflectedGreenRecord p ∈
      adaptivePrimeNormalGlobalReflectedSector p := by
  exact ⟨adaptivePrimeNormalReflectedHorizonGreenProvenance p, rfl⟩

/-- Global form of the remaining gate: codiagonal of the actual assembled
source record vanishes exactly under RH. -/
theorem adaptivePrimeNormalGlobalReflectedGreenRecord_codiagonal_eq_zero_iff_riemannHypothesis
    (p : Nat.Primes) :
    adaptivePrimeNormalGlobalReflectedCodiagonal p
        (adaptivePrimeNormalReflectedHorizonGreenProvenance p) = 0 ↔
      RiemannHypothesis := by
  rw [← adaptivePrimeNormalReflectedHorizonGreenProvenance_eq_zero_iff_riemannHypothesis]
  constructor
  · intro h
    apply adaptivePrimeNormalGlobalReflectedCodiagonal_injective p
    simpa using h
  · intro hzero
    rw [hzero]
    exact map_zero _

end DeningerMeyerGaussianGreen

end

end RHTower
