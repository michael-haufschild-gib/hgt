import GaloisForLFunctions.RHTower.XiHedenmalmThetaBorelHilbert
import GaloisForLFunctions.RHTower.XiHedenmalmThetaBorelConditionNumber

/-!
# The theta tail vector is cyclic for the bounded multiplier algebra

The Borel source vector `g x = sqrt (b x)` is strictly positive on the whole Borel ray.  Hence the
bounded measurable multiples of `g x` are dense in `L²((0,∞))`: for any target vector `v` the
truncations of `v / g x` are bounded, and multiplying them back by `g x` recovers `v` in the limit.

Consequently no unbounded radial multiplier can be hidden by passing to the source-cyclic carrier
generated by one theta-tail vector.
-/

open Complex Real MeasureTheory Set Filter Topology

noncomputable section

namespace RHTower

theorem measurable_hedenmalmBorelVectorFun (x : ℝ) :
    Measurable (hedenmalmBorelVectorFun x) := by
  unfold hedenmalmBorelVectorFun
  exact Complex.measurable_ofReal.comp
    (Real.continuous_sqrt.measurable.comp (measurable_hedenmalmBorelDensity x))

theorem hedenmalmBorelVectorFun_ne_zero {x t : ℝ} (ht : -1 < t) :
    hedenmalmBorelVectorFun x t ≠ 0 := by
  rw [hedenmalmBorelVectorFun, Ne, Complex.ofReal_eq_zero]
  exact ne_of_gt (Real.sqrt_pos.mpr (hedenmalmBorelDensity_pos x ht))

/-- The bounded measurable multiples of the Borel source vector. -/
def hedenmalmBorelCyclicSet (x : ℝ) :
    Set (Lp ℂ 2 (volume.restrict (Ioi (0 : ℝ)))) :=
  {v | ∃ h : ℝ → ℂ, ∃ C : ℝ, Measurable h ∧ (∀ t, ‖h t‖ ≤ C) ∧
    (v : ℝ → ℂ) =ᵐ[volume.restrict (Ioi (0 : ℝ))]
      fun t => h t * hedenmalmBorelVectorFun x t}

/-- **Cyclicity of the theta tail vector.**  The bounded multiplier orbit of the Borel source vector
is dense in the Borel boundary Hilbert space. -/
theorem dense_hedenmalmBorelCyclicSet (x : ℝ) :
    Dense (hedenmalmBorelCyclicSet x) := by
  set μ : Measure ℝ := volume.restrict (Ioi (0 : ℝ)) with hμ
  set g : ℝ → ℂ := hedenmalmBorelVectorFun x with hg
  have hgmeas : Measurable g := measurable_hedenmalmBorelVectorFun x
  rw [Metric.dense_iff]
  intro v ε hε
  -- a strongly measurable representative of the target vector
  have hv : MemLp (v : ℝ → ℂ) 2 μ := Lp.memLp v
  set f : ℝ → ℂ := hv.aestronglyMeasurable.mk _ with hf
  have hfmeas : Measurable f :=
    hv.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hfae : (v : ℝ → ℂ) =ᵐ[μ] f := hv.aestronglyMeasurable.ae_eq_mk
  have hfLp : MemLp f 2 μ := hv.ae_eq hfae
  have hfsq : Integrable (fun t => ‖f t‖ ^ (2 : ℕ)) μ :=
    (memLp_two_iff_integrable_sq_norm hfLp.aestronglyMeasurable).mp hfLp
  -- the truncation sets
  set A : ℕ → Set ℝ := fun n => {t : ℝ | (n : ℝ) < ‖f t / g t‖} with hA
  have hAmeas : ∀ n, MeasurableSet (A n) := by
    intro n
    exact measurableSet_lt measurable_const (hfmeas.div hgmeas).norm
  have hwLp : ∀ n, MemLp ((A n)ᶜ.indicator f) 2 μ := fun n =>
    hfLp.indicator (hAmeas n).compl
  -- the approximating vectors lie in the cyclic set
  have hmem : ∀ n, (hwLp n).toLp ((A n)ᶜ.indicator f) ∈ hedenmalmBorelCyclicSet x := by
    intro n
    refine ⟨(A n)ᶜ.indicator fun t => f t / g t, (n : ℝ),
      ((hfmeas.div hgmeas).indicator (hAmeas n).compl), ?_, ?_⟩
    · intro t
      by_cases hmemA : t ∈ (A n)ᶜ
      · rw [Set.indicator_of_mem hmemA]
        simpa [hA] using not_lt.mp (by simpa [hA] using hmemA)
      · rw [Set.indicator_of_notMem hmemA, norm_zero]
        positivity
    · filter_upwards [(hwLp n).coeFn_toLp, ae_restrict_mem measurableSet_Ioi] with t ht htmem
      rw [ht]
      by_cases hmemA : t ∈ (A n)ᶜ
      · rw [Set.indicator_of_mem hmemA, Set.indicator_of_mem hmemA,
          div_mul_cancel₀]
        exact hedenmalmBorelVectorFun_ne_zero (by have := mem_Ioi.mp htmem; linarith)
      · rw [Set.indicator_of_notMem hmemA, Set.indicator_of_notMem hmemA, zero_mul]
  -- the approximation error is the tail mass of the truncation
  have herr : ∀ n, ‖v - (hwLp n).toLp ((A n)ᶜ.indicator f)‖ ^ (2 : ℕ) =
      ∫ t, (A n).indicator (fun s => ‖f s‖ ^ (2 : ℕ)) t ∂μ := by
    intro n
    set u : Lp ℂ 2 μ := v - (hwLp n).toLp ((A n)ᶜ.indicator f) with hu
    have hcoe : ((u : Lp ℂ 2 μ) : ℝ → ℂ) =ᵐ[μ] (A n).indicator f := by
      rw [hu]
      filter_upwards [Lp.coeFn_sub v ((hwLp n).toLp ((A n)ᶜ.indicator f)), hfae,
        (hwLp n).coeFn_toLp] with t h1 h2 h3
      rw [h1, Pi.sub_apply, h2, h3]
      by_cases hmemA : t ∈ A n
      · rw [Set.indicator_of_mem hmemA, Set.indicator_of_notMem (by simpa using hmemA),
          sub_zero]
      · rw [Set.indicator_of_notMem hmemA,
          Set.indicator_of_mem (by simpa using hmemA), sub_self]
    have key := inner_self_eq_norm_sq (𝕜 := ℂ) u
    rw [MeasureTheory.L2.inner_def] at key
    have hint : (∫ t, inner ℂ ((u : ℝ → ℂ) t) ((u : ℝ → ℂ) t) ∂μ) =
        ((∫ t, (A n).indicator (fun s => ‖f s‖ ^ (2 : ℕ)) t ∂μ : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      refine integral_congr_ae ?_
      filter_upwards [hcoe] with t ht
      rw [ht, RCLike.inner_apply]
      by_cases hmemA : t ∈ A n
      · rw [Set.indicator_of_mem hmemA, Set.indicator_of_mem hmemA, Complex.mul_conj,
          Complex.normSq_eq_norm_sq]
      · rw [Set.indicator_of_notMem hmemA, Set.indicator_of_notMem hmemA]
        simp
    rw [hint] at key
    simpa using key.symm
  -- the truncation tail vanishes
  have hlim : Tendsto (fun n : ℕ => ∫ t, (A n).indicator (fun s => ‖f s‖ ^ (2 : ℕ)) t ∂μ)
      atTop (𝓝 0) := by
    have hzero : ∫ _t : ℝ, (0 : ℝ) ∂μ = 0 := integral_zero _ _
    rw [← hzero]
    refine tendsto_integral_of_dominated_convergence (fun t => ‖f t‖ ^ (2 : ℕ)) ?_ hfsq ?_ ?_
    · intro n
      exact (((hfmeas.norm.pow_const 2).indicator (hAmeas n)).aestronglyMeasurable)
    · intro n
      filter_upwards with t
      by_cases hmemA : t ∈ A n
      · rw [Set.indicator_of_mem hmemA, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      · rw [Set.indicator_of_notMem hmemA, norm_zero]
        positivity
    · filter_upwards with t
      obtain ⟨N, hN⟩ := exists_nat_gt ‖f t / g t‖
      refine tendsto_atTop_of_eventually_const (i₀ := N) ?_
      intro n hn
      have hnot : t ∉ A n := by
        simp only [hA, Set.mem_setOf_eq, not_lt]
        exact le_trans hN.le (by exact_mod_cast hn)
      rw [Set.indicator_of_notMem hnot]
  -- extract one sufficiently good truncation
  have hsq : Tendsto (fun n : ℕ => ‖v - (hwLp n).toLp ((A n)ᶜ.indicator f)‖ ^ (2 : ℕ)) atTop (𝓝 0) := by
    exact hlim.congr fun n => (herr n).symm
  have hnorm : Tendsto (fun n : ℕ => ‖v - (hwLp n).toLp ((A n)ᶜ.indicator f)‖) atTop (𝓝 0) := by
    have := (Filter.Tendsto.sqrt hsq)
    simpa [Real.sqrt_sq (norm_nonneg _)] using this
  obtain ⟨n, hn⟩ := (hnorm.eventually (eventually_lt_nhds hε)).exists
  refine ⟨(hwLp n).toLp ((A n)ᶜ.indicator f), ?_, hmem n⟩
  rw [Metric.mem_ball, dist_eq_norm, ← norm_neg, neg_sub]
  exact lt_of_le_of_lt (le_abs_self _) (by rwa [abs_of_nonneg (norm_nonneg _)])

end RHTower
