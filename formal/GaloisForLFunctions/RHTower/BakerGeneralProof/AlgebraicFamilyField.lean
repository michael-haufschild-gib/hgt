import GaloisForLFunctions.RHTower.BakerProof.CoefficientField

/-!
# Number field generated by a finite algebraic family

This module packages the canonical field generated inside `ℂ` by a finite algebraic family,
its distinguished embedding and lifts, and one simultaneous integral denominator. It is independent
of any prime or logarithm specialization.
-/

open scoped Classical

namespace GaloisForLFunctions.RHTower.BakerGeneralProof

/-- The canonical subfield of `ℂ` generated by a finite algebraic family. -/
abbrev AlgebraicFamilyField {I : Type*} (x : I → ℂ) : Type :=
  IntermediateField.adjoin ℚ (Set.range x)

/-- A finite algebraic family generates a number field. -/
theorem algebraicFamilyNumberField {I : Type*} [Fintype I]
    (x : I → ℂ) (hx : ∀ i, IsAlgebraic ℚ (x i)) :
    NumberField (AlgebraicFamilyField x) where
  to_charZero := charZero_of_injective_algebraMap (algebraMap ℚ _).injective
  to_finiteDimensional := IntermediateField.finiteDimensional_adjoin fun z hz => by
    obtain ⟨i, rfl⟩ := hz
    exact isAlgebraic_iff_isIntegral.mp (hx i)

/-- Canonical inclusion of the generated family field into `ℂ`. -/
noncomputable def algebraicFamilyEmbedding {I : Type*} (x : I → ℂ) :
    AlgebraicFamilyField x →+* ℂ :=
  (IntermediateField.val (IntermediateField.adjoin ℚ (Set.range x))).toRingHom

/-- A member of the family, regarded as an element of its generated field. -/
noncomputable def algebraicFamilyLift {I : Type*} (x : I → ℂ) (i : I) :
    AlgebraicFamilyField x :=
  ⟨x i, (IntermediateField.subset_adjoin ℚ (Set.range x)) (Set.mem_range_self i)⟩

@[simp] theorem algebraicFamilyEmbedding_lift {I : Type*} (x : I → ℂ) (i : I) :
    algebraicFamilyEmbedding x (algebraicFamilyLift x i) = x i := rfl

theorem algebraicFamilyLift_ne_zero {I : Type*} (x : I → ℂ) (i : I)
    (hi : x i ≠ 0) : algebraicFamilyLift x i ≠ 0 := by
  intro hzero
  apply hi
  exact congrArg Subtype.val hzero

/-- One nonzero rational integer simultaneously clears every denominator in a finite algebraic
family. -/
theorem exists_algebraicFamily_common_integer_scale
    {I : Type*} [Fintype I] (x : I → ℂ) (hx : ∀ i, IsAlgebraic ℚ (x i)) :
    ∃ c : ℤ, c ≠ 0 ∧
      ∀ i, IsIntegral ℤ (c • algebraicFamilyLift x i) := by
  letI : NumberField (AlgebraicFamilyField x) :=
    algebraicFamilyNumberField x hx
  let s : Finset (AlgebraicFamilyField x) :=
    Finset.univ.image (algebraicFamilyLift x)
  obtain ⟨c, hc, hint⟩ :=
    exists_integral_multiples ℤ ℚ (L := AlgebraicFamilyField x) s
  refine ⟨c, hc, fun i => hint (algebraicFamilyLift x i) ?_⟩
  exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩

end GaloisForLFunctions.RHTower.BakerGeneralProof
