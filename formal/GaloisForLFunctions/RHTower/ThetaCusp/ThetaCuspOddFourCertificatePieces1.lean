theorem piece_4 {q : ℝ} (h0 : ((33:ℝ)/10) ≤ q) (h1 : q ≤ ((67:ℝ)/20)) (y : Fin 4 → ℝ) :
    0 ≤ ∑ i : Fin 4, ∑ j : Fin 4, y i * y j * pieceW q pieceX_4 i j :=
  pieceForm_nonneg (pieceW_symm (sym4_symm _ _ _ _ _ _ _ _ _ _) q) (by norm_num : (0:ℝ) < ((1:ℝ)/40))
    (abs_le.mpr ⟨by linarith, by linarith⟩)
    (piece4_e00 h0 h1) (piece4_e01 h0 h1) (piece4_e02 h0 h1) (piece4_e03 h0 h1) (piece4_e11 h0 h1) (piece4_e12 h0 h1) (piece4_e13 h0 h1) (piece4_e22 h0 h1) (piece4_e23 h0 h1) (piece4_e33 h0 h1)
    piece4_plus piece4_minus y

end
end RHTower.ThetaCuspOddFourPieces
