import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingBMCompactModularPeriodization
import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingBMGlobalAngularWeakResponse

/-!
Every compact chart test admits its actual periodization to the complete modular energy domain.
-/

open MeasureTheory Set Filter Topology UpperHalfPlane ModularGroup
open GaloisForLFunctions.HTGeometry
open scoped MatrixGroups ContDiff ComplexConjugate
namespace RHTower.D4BMModularCore
open D4BMGlobalAngularResponse
noncomputable section

/-- An arbitrary smooth compact test on the upper half-plane. Its support may
cross modular seams and contain elliptic fixed points. -/
structure CompactChartTest where
  field : UpperHalfPlane → ℂ
  smooth : ChartSmooth field
  compact : HasCompactSupport field

/-- Full modular periodization admits every compact chart test to the original
smooth modular core, with finite energy proved from actual quotient compactness. -/
def CompactChartTest.coreField (g : CompactChartTest) : CoreField where
  field := periodize g.field
  smooth := periodize_smooth g.field g.compact g.smooth
  invariant := periodize_invariant g.field
  compact := periodize_cellCompact g.field g.compact

/-- The actual energy-domain test generated by a general compact chart test. -/
def CompactChartTest.energyTest (g : CompactChartTest) : energyDomain :=
  ⟨frameGraph g.coreField,frameGraph_mem _⟩

/-- The admitted test's scalar is the actual full modular periodization. -/
theorem CompactChartTest.energyTest_scalar (g : CompactChartTest) :
    (embedding g.energyTest : UpperHalfPlane → ℂ) =ᵐ[measure] periodize g.field :=
  (core_field_memLp _ g.coreField.smooth g.coreField.compact).coeFn_toLp

/-- The admitted test retains each original weighted derivative of its full
periodization, including every seam-crossing translate. -/
theorem CompactChartTest.energyTest_gradient (g : CompactChartTest) (i : Fin 2) :
    ((g.energyTest : EnergySpace) i.succ : UpperHalfPlane → ℂ) =ᵐ[measure]
      weightedDeriv (direction i) (periodize g.field) := by
  have hi : (g.energyTest : EnergySpace) i.succ = derivativeVector g.coreField (direction i) := by
    fin_cases i <;> rfl
  rw [hi]
  exact (weightedDeriv_memLp _ _ g.coreField.smooth g.coreField.compact).coeFn_toLp

/-- The scalar test pairing has its original native integral, with no local-support restriction. -/
theorem CompactChartTest.scalar_pairing (g : CompactChartTest) (u : Space) :
    inner ℂ (embedding g.energyTest) u =
      ∫ z : UpperHalfPlane, conj (periodize g.field z) * u z ∂measure := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [g.energyTest_scalar] with z hz
  rw [hz]
  simp [RCLike.inner_apply,mul_comm]

/-- Both derivative pairings retain the original frame derivatives of the full
periodized chart test against the actual completed response components. -/
theorem CompactChartTest.gradient_pairing (g : CompactChartTest) (h : energyDomain) (i : Fin 2) :
    inner ℂ ((g.energyTest : EnergySpace) i.succ) ((h : EnergySpace) i.succ) =
      ∫ z : UpperHalfPlane, conj (weightedDeriv (direction i) (periodize g.field) z) *
        (h : EnergySpace) i.succ z ∂measure := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [g.energyTest_gradient i] with z hz
  rw [hz]
  simp [RCLike.inner_apply,mul_comm]

/-- The actual unique full-forcing response satisfies the original variational
equation against every compact chart test, including tests across either modular
seam and at elliptic points. Test admission and every integral are constructed. -/
theorem full_response_seam_test_equation (q : XiZeroCopy) (minusBranch : Bool) (g : CompactChartTest) :
    (∑ i : Fin 2, ∫ z : UpperHalfPlane,
      conj (weightedDeriv (direction i) (periodize g.field) z) *
        (weakResponse q minusBranch : EnergySpace) i.succ z ∂measure) +
      parameter q minusBranch * (∫ z : UpperHalfPlane,
        conj (periodize g.field z) * embedding (weakResponse q minusBranch) z ∂measure) =
      -(∫ z : UpperHalfPlane, conj (periodize g.field z) *
        forcing q minusBranch (coordinates z) ∂measure) := by
  have he := (weakSolution_iff_gradient q minusBranch _).mp (weakResponse_spec q minusBranch)
    g.energyTest
  simp only [g.gradient_pairing,g.scalar_pairing] at he
  rw [he]
  congr 1
  apply integral_congr_ae
  filter_upwards [forcingVector_coe q minusBranch] with z hz
  rw [hz]

end
end RHTower.D4BMModularCore
