import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingBMTotalPeriodQNMPoleDoublet
import GaloisForLFunctions.HTGeometry.AffineSimpleZeroMotion

open Complex Set Filter Topology

namespace RHTower

noncomputable section

/-- Holomorphic total-period source entering the gauge-fixed returned Jost determinant. -/
def d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus
    (n k : ℕ) (conservativeFinitePart : ℝ)
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) (omega : ℂ) : ℂ :=
  let chi := d4BMXiMixedHorizonAngularMomentum q
  (Complex.I /
      (omega - d4BMCausalPlusPlusMinusFrequency n k chi)) *
    d4BMXiGaugeFixedTotalRenormalizedAngularPeriod
      conservativeFinitePart amplitude orthogonalMixing q

/-- Affine nonlinear completion of the physical BM boundary determinant by the complete
gauge-fixed causal angular period. -/
def d4BMXiGaugeFixedTotalPeriodReturnedJostMinus
    (n k : ℕ) (conservativeFinitePart : ℝ)
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy)
    (coupling omega : ℂ) : ℂ :=
  d4GravitationalHypergeometricBoundaryJost omega (xiSpectralPoint q) +
    coupling * d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus
      n k conservativeFinitePart amplitude orthogonalMixing q omega

/-- All-order analytic horizon/boundary completion with the exact total period as its first
nonlinear coefficient. `higher` contains every quadratic-and-higher coupling correction. -/
def d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostMinus
    (higher : ℂ × ℂ → ℂ)
    (n k : ℕ) (conservativeFinitePart : ℝ)
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy)
    (coupling omega : ℂ) : ℂ :=
  d4BMXiGaugeFixedTotalPeriodReturnedJostMinus
      n k conservativeFinitePart amplitude orthogonalMixing q coupling omega +
    coupling ^ (2 : ℕ) * higher (coupling, omega)

/-- Exact nonlinear BM pole branch generated by the total causal Einstein--Teukolsky period. -/
theorem exists_d4BMXiGaugeFixedTotalPeriodReturnedJostPoleBranchMinus
    (n k N : ℕ) (conservativeFinitePart : ℝ)
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) :
    ∃ pole : ℂ → ℂ,
      AnalyticAt ℂ pole 0 ∧
      pole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N (xiSpectralPoint q) ∧
      (∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodReturnedJostMinus
          n k conservativeFinitePart amplitude orthogonalMixing q
          coupling (pole coupling) = 0) ∧
      HasDerivAt pole
        (d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus
          n k N conservativeFinitePart amplitude orthogonalMixing q) 0 := by
  let target := thetaCuspHawkingTopologicalBlackHoleQNMMinus N (xiSpectralPoint q)
  let source := d4BMCausalPlusPlusMinusFrequency n k
    (d4BMXiMixedHorizonAngularMomentum q)
  let D : ℂ → ℂ := fun omega =>
    d4GravitationalHypergeometricBoundaryJost omega (xiSpectralPoint q)
  let K : ℂ → ℂ := fun omega =>
    d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus
      n k conservativeFinitePart amplitude orthogonalMixing q omega
  have htarget : target =
      d4BMCausalQNMMinus N (d4BMXiMixedHorizonAngularMomentum q) := by
    exact (d4BMXiCausalQNMMinus_eq_topologicalBlackHoleQNMMinus N q).symm
  have hfreq : target - source ≠ 0 := by
    rw [htarget]
    exact sub_ne_zero.mpr
      (d4BMCausalPlusPlusMinusFrequency_ne_qnmMinus_of_re_ne_zero n k N _
        (d4BMXiMixedHorizonAngularMomentum_re_ne_zero q)).symm
  have hDder : HasDerivAt D
      (d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus
        N (xiSpectralPoint q)) target := by
    simpa [D, target] using
      d4FundamentalQNMCrossBranchBoundaryJost_hasDerivAt_qnmMinus_xi N q
  have hD : AnalyticAt ℂ D target := by
    dsimp [D]
    unfold d4GravitationalHypergeometricBoundaryJost
      thetaCuspHawkingHypergeometricPhysicalBoundaryJost
      thetaCuspHawkingHypergeometricJost
    exact (((thetaCuspHawkingHypergeometricAnalyticAt_gammaRadialC_of_ne_neg_nat
      target (thetaCuspHawkingHypergeometricRadialC_qnmMinus_ne_neg_nat N · q)).mul
        analyticAt_const).mul
      ((thetaCuspHawkingHypergeometricAnalyticAt_jostPlus
        target (xiSpectralPoint q)).mul
        (thetaCuspHawkingHypergeometricAnalyticAt_jostMinus
          target (xiSpectralPoint q))))
  have hK : AnalyticAt ℂ K target := by
    dsimp [K, d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus]
    exact ((analyticAt_const.div
      (analyticAt_id.sub analyticAt_const) hfreq).mul analyticAt_const)
  have hD0 : D target = 0 := by
    simp [D, target, d4GravitationalHypergeometricBoundaryJost,
      thetaCuspHawkingHypergeometricPhysicalBoundaryJost,
      thetaCuspHawkingHypergeometricJost,
      thetaCuspHawkingHypergeometricJostMinus_qnm_zero]
  have hsimple : deriv D target ≠ 0 := by
    rw [hDder.deriv]
    exact d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus_xi_ne_zero N q
  obtain ⟨pole, hpole, hpole0, hroot, hvelocity⟩ :=
    HTGeometry.exists_affineSimpleZero_branch hD hK hD0 hsimple
  refine ⟨pole, hpole, hpole0, ?_, ?_⟩
  · filter_upwards [hroot] with coupling hcoupling
    simpa [D, K, d4BMXiGaugeFixedTotalPeriodReturnedJostMinus] using hcoupling
  · have hDderiv : deriv D target =
        d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus
          N (xiSpectralPoint q) := hDder.deriv
    rw [hDderiv] at hvelocity
    convert hvelocity using 1
    simp only [K, target, d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus,
      d4BMXiGaugeFixedTotalPeriodQNMCokernelResidueMinus,
      d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus]
    ring

/-- Analytic gauge-fixed horizon/boundary backreaction cannot remove an off-line partner doublet
near zero coupling. Both simple BM roots move with nonzero velocity and remain distinct. -/
theorem exists_d4BMXiGaugeFixedTotalPeriodPartnerPoleDoubletStable
    (n k N : ℕ) (conservativeFinitePart : ℝ)
    {amplitude : ℂ} (ha : amplitude ≠ 0)
    (conjugateMixing reflectedMixing : ℂ) (q : XiZeroCopy)
    (hoff : (q.1 : ℂ).re ≠ 1 / 2) :
    ∃ reflectedPole conjugatePole : ℂ → ℂ,
      AnalyticAt ℂ reflectedPole 0 ∧
      AnalyticAt ℂ conjugatePole 0 ∧
      reflectedPole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyReflectEquiv q)) ∧
      conjugatePole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyConjEquiv q)) ∧
      (∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodReturnedJostMinus
          n k conservativeFinitePart amplitude reflectedMixing
          (xiZeroCopyReflectEquiv q) coupling (reflectedPole coupling) = 0) ∧
      (∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodReturnedJostMinus
          n k conservativeFinitePart amplitude conjugateMixing
          (xiZeroCopyConjEquiv q) coupling (conjugatePole coupling) = 0) ∧
      HasDerivAt reflectedPole
        (d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus
          n k N conservativeFinitePart amplitude reflectedMixing
          (xiZeroCopyReflectEquiv q)) 0 ∧
      HasDerivAt conjugatePole
        (d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus
          n k N conservativeFinitePart amplitude conjugateMixing
          (xiZeroCopyConjEquiv q)) 0 ∧
      d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus
          n k N conservativeFinitePart amplitude reflectedMixing
          (xiZeroCopyReflectEquiv q) ≠ 0 ∧
      d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus
          n k N conservativeFinitePart amplitude conjugateMixing
          (xiZeroCopyConjEquiv q) ≠ 0 ∧
      ∀ᶠ coupling : ℂ in 𝓝 0, reflectedPole coupling ≠ conjugatePole coupling := by
  obtain ⟨reflectedPole, hreflectedAna, hreflected0, hreflectedRoot,
      hreflectedVelocity⟩ :=
    exists_d4BMXiGaugeFixedTotalPeriodReturnedJostPoleBranchMinus
      n k N conservativeFinitePart amplitude reflectedMixing (xiZeroCopyReflectEquiv q)
  obtain ⟨conjugatePole, hconjugateAna, hconjugate0, hconjugateRoot,
      hconjugateVelocity⟩ :=
    exists_d4BMXiGaugeFixedTotalPeriodReturnedJostPoleBranchMinus
      n k N conservativeFinitePart amplitude conjugateMixing (xiZeroCopyConjEquiv q)
  have htargetNe :
      thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyReflectEquiv q)) ≠
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyConjEquiv q)) := by
    intro heq
    exact hoff ((d4BMXiReflectedQNMMinus_eq_conjugateQNMMinus_iff N q).mp heq)
  have hdiff : ContinuousAt (fun coupling : ℂ =>
      reflectedPole coupling - conjugatePole coupling) 0 :=
    hreflectedAna.continuousAt.sub hconjugateAna.continuousAt
  have hdiff0 : reflectedPole 0 - conjugatePole 0 ≠ 0 := by
    rw [hreflected0, hconjugate0]
    exact sub_ne_zero.mpr htargetNe
  have hdistinct : ∀ᶠ coupling : ℂ in 𝓝 0,
      reflectedPole coupling ≠ conjugatePole coupling := by
    have hne : ∀ᶠ coupling : ℂ in 𝓝 0,
        reflectedPole coupling - conjugatePole coupling ≠ 0 :=
      hdiff.eventually (eventually_ne_nhds hdiff0)
    filter_upwards [hne] with coupling hcoupling
    exact sub_ne_zero.mp hcoupling
  exact ⟨reflectedPole, conjugatePole,
    hreflectedAna, hconjugateAna, hreflected0, hconjugate0,
    hreflectedRoot, hconjugateRoot, hreflectedVelocity, hconjugateVelocity,
    d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus_ne_zero
      n k N conservativeFinitePart ha reflectedMixing (xiZeroCopyReflectEquiv q),
    d4BMXiGaugeFixedTotalPeriodPoleVelocityMinus_ne_zero
      n k N conservativeFinitePart ha conjugateMixing (xiZeroCopyConjEquiv q),
    hdistinct⟩

/-- Every analytic all-order completion with the computed total-period first coefficient retains
the BM simple pole near zero coupling. No choice of regular higher backreaction can remove it. -/
theorem exists_d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostPoleBranchMinus
    (higher : ℂ × ℂ → ℂ)
    (n k N : ℕ) (conservativeFinitePart : ℝ)
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy)
    (hhigher : AnalyticAt ℂ higher
      (0, thetaCuspHawkingTopologicalBlackHoleQNMMinus N (xiSpectralPoint q))) :
    ∃ pole : ℂ → ℂ,
      AnalyticAt ℂ pole 0 ∧
      pole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N (xiSpectralPoint q) ∧
      ∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostMinus higher
          n k conservativeFinitePart amplitude orthogonalMixing q
          coupling (pole coupling) = 0 := by
  let target := thetaCuspHawkingTopologicalBlackHoleQNMMinus N (xiSpectralPoint q)
  let source := d4BMCausalPlusPlusMinusFrequency n k
    (d4BMXiMixedHorizonAngularMomentum q)
  let D : ℂ → ℂ := fun omega =>
    d4GravitationalHypergeometricBoundaryJost omega (xiSpectralPoint q)
  let K : ℂ → ℂ := fun omega =>
    d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus
      n k conservativeFinitePart amplitude orthogonalMixing q omega
  let F : ℂ × ℂ → ℂ := fun p =>
    D p.2 + p.1 * K p.2 + p.1 ^ (2 : ℕ) * higher p
  have htarget : target =
      d4BMCausalQNMMinus N (d4BMXiMixedHorizonAngularMomentum q) := by
    exact (d4BMXiCausalQNMMinus_eq_topologicalBlackHoleQNMMinus N q).symm
  have hfreq : target - source ≠ 0 := by
    rw [htarget]
    exact sub_ne_zero.mpr
      (d4BMCausalPlusPlusMinusFrequency_ne_qnmMinus_of_re_ne_zero n k N _
        (d4BMXiMixedHorizonAngularMomentum_re_ne_zero q)).symm
  have hDder : HasDerivAt D
      (d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus
        N (xiSpectralPoint q)) target := by
    simpa [D, target] using
      d4FundamentalQNMCrossBranchBoundaryJost_hasDerivAt_qnmMinus_xi N q
  have hD : AnalyticAt ℂ D target := by
    dsimp [D]
    unfold d4GravitationalHypergeometricBoundaryJost
      thetaCuspHawkingHypergeometricPhysicalBoundaryJost
      thetaCuspHawkingHypergeometricJost
    exact (((thetaCuspHawkingHypergeometricAnalyticAt_gammaRadialC_of_ne_neg_nat
      target (thetaCuspHawkingHypergeometricRadialC_qnmMinus_ne_neg_nat N · q)).mul
        analyticAt_const).mul
      ((thetaCuspHawkingHypergeometricAnalyticAt_jostPlus
        target (xiSpectralPoint q)).mul
        (thetaCuspHawkingHypergeometricAnalyticAt_jostMinus
          target (xiSpectralPoint q))))
  have hK : AnalyticAt ℂ K target := by
    dsimp [K, d4BMXiGaugeFixedTotalPeriodTargetNumeratorMinus]
    exact ((analyticAt_const.div
      (analyticAt_id.sub analyticAt_const) hfreq).mul analyticAt_const)
  have hF : AnalyticAt ℂ F (0, target) := by
    have hfst : AnalyticAt ℂ (fun p : ℂ × ℂ => p.1) (0, target) := analyticAt_fst
    have hsnd : AnalyticAt ℂ (fun p : ℂ × ℂ => p.2) (0, target) := analyticAt_snd
    exact (hD.comp (x := (0, target)) hsnd).add
      (hfst.mul (hK.comp (x := (0, target)) hsnd)) |>.add
      ((hfst.pow 2).mul (by simpa [target] using hhigher))
  have hD0 : D target = 0 := by
    simp [D, target, d4GravitationalHypergeometricBoundaryJost,
      thetaCuspHawkingHypergeometricPhysicalBoundaryJost,
      thetaCuspHawkingHypergeometricJost,
      thetaCuspHawkingHypergeometricJostMinus_qnm_zero]
  have hF0 : F (0, target) = 0 := by
    simp [F, hD0]
  have hpartial : HasDerivAt (fun omega => F (0, omega))
      (d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus
        N (xiSpectralPoint q)) target := by
    simpa [F] using hDder
  have hsimple :
      d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus
        N (xiSpectralPoint q) ≠ 0 :=
    d4FundamentalQNMCrossBranchBoundaryJostDerivativeMinus_xi_ne_zero N q
  obtain ⟨pole, hpole, hpole0, hroot⟩ :=
    Bottcher.exists_analyticAt_branch_of_hasDerivAt
      hF.contDiffAt hF0 hpartial hsimple
  refine ⟨pole, hpole, hpole0, ?_⟩
  filter_upwards [hroot] with coupling hcoupling
  simpa [F, D, K, d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostMinus,
    d4BMXiGaugeFixedTotalPeriodReturnedJostMinus] using hcoupling

/-- Off-line FE--Schwarz BM partners remain a resolved doublet under arbitrary analytic all-order
horizon/boundary corrections sharing the computed total-period first nonlinear coefficient. -/
theorem exists_d4BMXiGaugeFixedTotalPeriodAllOrderPartnerPoleDoubletStable
    (reflectedHigher conjugateHigher : ℂ × ℂ → ℂ)
    (n k N : ℕ) (conservativeFinitePart : ℝ)
    (amplitude conjugateMixing reflectedMixing : ℂ) (q : XiZeroCopy)
    (hreflectedHigher : AnalyticAt ℂ reflectedHigher
      (0, thetaCuspHawkingTopologicalBlackHoleQNMMinus N
        (xiSpectralPoint (xiZeroCopyReflectEquiv q))))
    (hconjugateHigher : AnalyticAt ℂ conjugateHigher
      (0, thetaCuspHawkingTopologicalBlackHoleQNMMinus N
        (xiSpectralPoint (xiZeroCopyConjEquiv q))))
    (hoff : (q.1 : ℂ).re ≠ 1 / 2) :
    ∃ reflectedPole conjugatePole : ℂ → ℂ,
      AnalyticAt ℂ reflectedPole 0 ∧
      AnalyticAt ℂ conjugatePole 0 ∧
      reflectedPole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyReflectEquiv q)) ∧
      conjugatePole 0 =
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyConjEquiv q)) ∧
      (∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostMinus reflectedHigher
          n k conservativeFinitePart amplitude reflectedMixing
          (xiZeroCopyReflectEquiv q) coupling (reflectedPole coupling) = 0) ∧
      (∀ᶠ coupling : ℂ in 𝓝 0,
        d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostMinus conjugateHigher
          n k conservativeFinitePart amplitude conjugateMixing
          (xiZeroCopyConjEquiv q) coupling (conjugatePole coupling) = 0) ∧
      ∀ᶠ coupling : ℂ in 𝓝 0, reflectedPole coupling ≠ conjugatePole coupling := by
  obtain ⟨reflectedPole, hreflectedAna, hreflected0, hreflectedRoot⟩ :=
    exists_d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostPoleBranchMinus
      reflectedHigher n k N conservativeFinitePart amplitude reflectedMixing
      (xiZeroCopyReflectEquiv q) hreflectedHigher
  obtain ⟨conjugatePole, hconjugateAna, hconjugate0, hconjugateRoot⟩ :=
    exists_d4BMXiGaugeFixedTotalPeriodAllOrderReturnedJostPoleBranchMinus
      conjugateHigher n k N conservativeFinitePart amplitude conjugateMixing
      (xiZeroCopyConjEquiv q) hconjugateHigher
  have htargetNe :
      thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyReflectEquiv q)) ≠
        thetaCuspHawkingTopologicalBlackHoleQNMMinus N
          (xiSpectralPoint (xiZeroCopyConjEquiv q)) := by
    intro heq
    exact hoff ((d4BMXiReflectedQNMMinus_eq_conjugateQNMMinus_iff N q).mp heq)
  have hdiff : ContinuousAt (fun coupling : ℂ =>
      reflectedPole coupling - conjugatePole coupling) 0 :=
    hreflectedAna.continuousAt.sub hconjugateAna.continuousAt
  have hdiff0 : reflectedPole 0 - conjugatePole 0 ≠ 0 := by
    rw [hreflected0, hconjugate0]
    exact sub_ne_zero.mpr htargetNe
  have hdistinct : ∀ᶠ coupling : ℂ in 𝓝 0,
      reflectedPole coupling ≠ conjugatePole coupling := by
    have hne : ∀ᶠ coupling : ℂ in 𝓝 0,
        reflectedPole coupling - conjugatePole coupling ≠ 0 :=
      hdiff.eventually (eventually_ne_nhds hdiff0)
    filter_upwards [hne] with coupling hcoupling
    exact sub_ne_zero.mp hcoupling
  exact ⟨reflectedPole, conjugatePole,
    hreflectedAna, hconjugateAna, hreflected0, hconjugate0,
    hreflectedRoot, hconjugateRoot, hdistinct⟩

end

end RHTower
