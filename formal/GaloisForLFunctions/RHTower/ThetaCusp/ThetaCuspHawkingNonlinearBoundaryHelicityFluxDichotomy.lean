import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingFullEinsteinGaugeFixedRadiationGram

/-!
# Nonlinear boundary helicity-flux dichotomy

At the first nonlinear Einstein order, a nonzero theta seed produces the exact Birmingham--
Mokhtari radiation vector `(Gd,TGd,Gm,TGm)`.  The direct coefficient `d`, ingoing Green
coefficient `G`, and normalizable AdS transfer `T` are nonzero at every Xi divisor.  Hence neither
the horizon condition nor the asymptotically AdS boundary condition annihilates the response.

The orthogonal-helicity energy is the squared imaginary part of the de-aliased Teukolsky angular
Casimir times response norm.  Its global, horizon, and normalizable-boundary forms therefore vanish
exactly when the divisor lies on the critical line.  In particular, every off-line divisor has
strictly positive helicity energy in all three forms, independently of the non-self-dual orthogonal
source coefficient.

`[PAPER-PROVED] [LEAN-PROVED] [NOVELTY UNVERIFIED]`
-/

open Complex Real
open scoped InnerProductSpace

namespace RHTower

noncomputable section

/-- Full gauge-fixed second-harmonic radiation generated by a nonlinear theta seed. -/
def d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) :
    EuclideanSpace ℂ (Fin 4) :=
  d4BMGaugeFixedSecondHarmonicRadiationMap q
    (d4ThetaHawkingSelfDualQuadraticCarrierCoefficient amplitude
      (xiSpectralPoint q), orthogonalMixing)

/-- Orthogonal-helicity energy in the full horizon-plus-boundary radiation vector. -/
def d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) : ℝ :=
  d4ThetaTeukolskyOrthogonalHelicityMixingEnergy
    (d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation
      amplitude orthogonalMixing q) q

/-- Horizon part of the gauge-fixed orthogonal-helicity energy. -/
def d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) : ℝ :=
  d4ThetaTeukolskyOrthogonalHelicityMixingEnergy
    ((d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation
      amplitude orthogonalMixing q) 0) q

/-- Normalizable AdS response part of the gauge-fixed orthogonal-helicity energy. -/
def d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) : ℝ :=
  d4ThetaTeukolskyOrthogonalHelicityMixingEnergy
    ((d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation
      amplitude orthogonalMixing q) 1) q

theorem d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux_nonneg
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) :
    0 ≤ d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux
      amplitude orthogonalMixing q := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_nonneg _ q

theorem d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux_nonneg
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) :
    0 ≤ d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux
      amplitude orthogonalMixing q := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_nonneg _ q

theorem d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_nonneg
    (amplitude orthogonalMixing : ℂ) (q : XiZeroCopy) :
    0 ≤ d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
      amplitude orthogonalMixing q := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_nonneg _ q

/-- A nonzero nonlinear seed has nonzero ingoing horizon response. -/
theorem d4ThetaFullEinsteinGaugeFixedSecondHarmonicHorizonRadiation_ne_zero
    {amplitude : ℂ} (ha : amplitude ≠ 0) (orthogonalMixing : ℂ)
    (q : XiZeroCopy) :
    (d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation
      amplitude orthogonalMixing q) 0 ≠ 0 := by
  change d4BMGaugeFixedSecondHarmonicGreen q *
      d4ThetaHawkingSelfDualQuadraticCarrierCoefficient amplitude
        (xiSpectralPoint q) ≠ 0
  exact mul_ne_zero (d4BMGaugeFixedSecondHarmonicGreen_ne_zero q)
    (d4ThetaHawkingSelfDualQuadraticCarrierCoefficient_xi_ne_zero ha q)

/-- Full optical helicity flux vanishes exactly on the critical line. -/
theorem d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux_eq_zero_iff
    {amplitude : ℂ} (ha : amplitude ≠ 0) (orthogonalMixing : ℂ)
    (q : XiZeroCopy) :
    d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux
        amplitude orthogonalMixing q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_eq_zero_iff _
    (d4ThetaFullEinsteinGaugeFixedSecondHarmonicRadiation_ne_zero
      ha q orthogonalMixing) q

/-- Horizon helicity flux vanishes exactly on the critical line. -/
theorem d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux_eq_zero_iff
    {amplitude : ℂ} (ha : amplitude ≠ 0) (orthogonalMixing : ℂ)
    (q : XiZeroCopy) :
    d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux
        amplitude orthogonalMixing q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_eq_zero_iff _
    (d4ThetaFullEinsteinGaugeFixedSecondHarmonicHorizonRadiation_ne_zero
      ha orthogonalMixing q) q

/-- Normalizable boundary helicity response energy vanishes exactly on the critical line. -/
theorem d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_eq_zero_iff
    {amplitude : ℂ} (ha : amplitude ≠ 0) (orthogonalMixing : ℂ)
    (q : XiZeroCopy) :
    d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
        amplitude orthogonalMixing q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  exact d4ThetaTeukolskyOrthogonalHelicityMixingEnergy_eq_zero_iff _
    (d4ThetaFullEinsteinGaugeFixedSecondHarmonicBoundaryRadiation_ne_zero
      ha q orthogonalMixing) q

/-- Every off-line Xi carrier has strictly positive global, horizon, and boundary helicity energy. -/
theorem d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux_offCritical_strictlyPositive
    {amplitude : ℂ} (ha : amplitude ≠ 0) (orthogonalMixing : ℂ)
    (q : XiZeroCopy) (hoff : (q.1 : ℂ).re ≠ 1 / 2) :
    0 < d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux
          amplitude orthogonalMixing q ∧
      0 < d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux
          amplitude orthogonalMixing q ∧
      0 < d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
          amplitude orthogonalMixing q := by
  have hglobal :
      d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux
          amplitude orthogonalMixing q ≠ 0 := by
    intro hzero
    exact hoff ((d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux_eq_zero_iff
      ha orthogonalMixing q).mp hzero)
  have hhorizon :
      d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux
          amplitude orthogonalMixing q ≠ 0 := by
    intro hzero
    exact hoff
      ((d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux_eq_zero_iff
        ha orthogonalMixing q).mp hzero)
  have hboundary :
      d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
          amplitude orthogonalMixing q ≠ 0 := by
    intro hzero
    exact hoff
      ((d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_eq_zero_iff
        ha orthogonalMixing q).mp hzero)
  exact ⟨lt_of_le_of_ne
      (d4ThetaFullEinsteinGaugeFixedOrthogonalHelicityFlux_nonneg
        amplitude orthogonalMixing q) hglobal.symm,
    lt_of_le_of_ne
      (d4ThetaFullEinsteinGaugeFixedHorizonOrthogonalHelicityFlux_nonneg
        amplitude orthogonalMixing q) hhorizon.symm,
    lt_of_le_of_ne
      (d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_nonneg
        amplitude orthogonalMixing q) hboundary.symm⟩

/-- Universal annihilation of the nonlinear normalizable boundary response in one Xi sector. -/
def d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation
    (q : XiZeroCopy) : Prop :=
  ∀ (amplitude : ℂ), amplitude ≠ 0 → ∀ orthogonalMixing : ℂ,
    d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy
      amplitude orthogonalMixing q = 0

/-- Boundary-response annihilation is not an AdS boundary law: copywise it is the critical line. -/
theorem d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation_iff
    (q : XiZeroCopy) :
    d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation q ↔
      (q.1 : ℂ).re = 1 / 2 := by
  constructor
  · intro h
    exact (d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_eq_zero_iff
      (by norm_num : (1 : ℂ) ≠ 0) 0 q).mp (h 1 (by norm_num) 0)
  · intro hcritical amplitude ha orthogonalMixing
    exact (d4ThetaFullEinsteinGaugeFixedBoundaryOrthogonalHelicityResponseEnergy_eq_zero_iff
      ha orthogonalMixing q).mpr hcritical

/-- Off the critical line, nonlinear AdS boundary response cannot annihilate helicity energy. -/
theorem not_d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation_of_offCritical
    (q : XiZeroCopy) (hoff : (q.1 : ℂ).re ≠ 1 / 2) :
    ¬ d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation q := by
  exact fun h => hoff
    ((d4ThetaFullEinsteinBoundaryHelicityResponseAnnihilation_iff q).mp h)

end

end RHTower
