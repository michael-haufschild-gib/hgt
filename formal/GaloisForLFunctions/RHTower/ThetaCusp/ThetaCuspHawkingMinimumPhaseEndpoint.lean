import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingBackreactionPassivityEndpoint
import GaloisForLFunctions.RHTower.CCM.CCMPoissonJensenOuterDefect
import GaloisForLFunctions.HTGeometry.HalfPlanePolePhase

/-!
# Theta-cusp Hawking minimum-phase endpoint

The balanced moving-mirror Born coefficient has normalized form factor `XiC(z)`.  In the causal
Laplace coordinate `p = -i z`, a backreaction resonance `alpha` with `0 < Im(alpha)` is therefore
a right-half-plane zero `b = -i alpha` of the literal theta-cusp Hawking response.

That zero has an elementary causal all-pass section

`B_alpha(p) = (p-b)/(p+conj(b))`.

On physical frequency `p=-i x`, its modulus is one, so multiplication by `B_alpha` changes no
Hawking particle-number intensity.  Its logarithmic phase slope is nevertheless the strictly
positive Lorentzian

`2 Im(alpha) / (Im(alpha)^(2 : ℕ) + (x-Re(alpha))^(2 : ℕ))`.

At zero frequency the bare normalized theta-Born form factor has zero phase slope, by evenness of
`XiC`, while the all-pass-dressed form factor has slope
`2 Im(alpha) / normSq(alpha) > 0`.  Thus one source-normalized Wigner--Smith clock measurement
detects exactly the datum erased by the Hawking spectrum.  RH is equivalent to absence of this
positive all-pass clock sector.  The remaining producer is a source-derived minimum-phase/clock
calibration theorem for the backreacted mirror; intensity, KMS thermality, and passivity alone do
not provide it.
-/

open Complex Real

noncomputable section

namespace RHTower

open GaloisForLFunctions.RHTower

/-- Normalized theta-cusp Hawking Born form factor in the causal coordinate `p=-i z`. -/
def thetaCuspHawkingBornCausalFormFactor (p : ℂ) : ℂ :=
  thetaCuspFourierLaplace (Complex.I * p)

/-- Right-half-plane causal zero attached to a theta backreaction resonance. -/
def thetaCuspHawkingCausalZero
    (r : ThetaCuspHawkingBackreactionResonantMode) : ℂ :=
  -Complex.I * r.1

theorem thetaCuspHawkingCausalZero_re
    (r : ThetaCuspHawkingBackreactionResonantMode) :
    (thetaCuspHawkingCausalZero r).re = r.1.im := by
  simp [thetaCuspHawkingCausalZero, Complex.mul_re]

theorem thetaCuspHawkingCausalZero_im
    (r : ThetaCuspHawkingBackreactionResonantMode) :
    (thetaCuspHawkingCausalZero r).im = -r.1.re := by
  simp [thetaCuspHawkingCausalZero, Complex.mul_im]

/-- Every theta anomaly resonance is a literal zero of the causal Hawking Born form factor. -/
theorem thetaCuspHawkingBornCausalFormFactor_resonance_zero
    (r : ThetaCuspHawkingBackreactionResonantMode) :
    thetaCuspHawkingBornCausalFormFactor (thetaCuspHawkingCausalZero r) = 0 := by
  change thetaCuspFourierLaplace
    (Complex.I * (-Complex.I * (r.1 : ℂ))) = 0
  rw [show Complex.I * (-Complex.I * (r.1 : ℂ)) = r.1 by
    calc
      Complex.I * (-Complex.I * (r.1 : ℂ)) =
          -(Complex.I * Complex.I) * r.1 := by ring
      _ = r.1 := by rw [Complex.I_mul_I]; simp]
  rw [HedenmalmThetaSource.thetaCuspFourierLaplace_eq_XiC_all,
    thetaCuspHawkingBackreactionResonantMode_XiC_eq_zero]

/-- Causal all-pass section generated by one theta-Hawking resonance. -/
def thetaCuspHawkingCausalAllPass
    (r : ThetaCuspHawkingBackreactionResonantMode) (p : ℂ) : ℂ :=
  GaloisForLFunctions.RHTower.halfPlaneBlaschke
    (thetaCuspHawkingCausalZero r) p

/-- Physical-frequency boundary value, using `p=-i x`. -/
def thetaCuspHawkingCausalAllPassBoundary
    (r : ThetaCuspHawkingBackreactionResonantMode) (x : ℝ) : ℂ :=
  thetaCuspHawkingCausalAllPass r (-Complex.I * (x : ℂ))

/-- Rotation from the causal boundary to the standard upper-half-plane all-pass factor. -/
theorem thetaCuspHawkingCausalAllPassBoundary_eq_poleFactor
    (r : ThetaCuspHawkingBackreactionResonantMode) (x : ℝ) :
    thetaCuspHawkingCausalAllPassBoundary r x =
      ((x : ℂ) - ((r.1.re : ℂ) + (r.1.im : ℂ) * Complex.I)) /
        ((x : ℂ) - ((r.1.re : ℂ) - (r.1.im : ℂ) * Complex.I)) := by
  change
    (-Complex.I * (x : ℂ) - (-Complex.I * (r.1 : ℂ))) /
        (-Complex.I * (x : ℂ) + star (-Complex.I * (r.1 : ℂ))) = _
  have hnum :
      (x : ℂ) - ((r.1.re : ℂ) + (r.1.im : ℂ) * Complex.I) =
        Complex.I *
          (-Complex.I * (x : ℂ) - (-Complex.I * (r.1 : ℂ))) := by
    apply Complex.ext
    · simp [Complex.mul_re, Complex.mul_im]
      ring
    · simp [Complex.mul_re, Complex.mul_im]
  have hden :
      (x : ℂ) - ((r.1.re : ℂ) - (r.1.im : ℂ) * Complex.I) =
        Complex.I *
          (-Complex.I * (x : ℂ) + star (-Complex.I * (r.1 : ℂ))) := by
    apply Complex.ext
    · simp [Complex.mul_re, Complex.mul_im]
      ring
    · simp [Complex.mul_re, Complex.mul_im]
  rw [hnum, hden, mul_div_mul_left _ _ Complex.I_ne_zero]

/-- The causal theta-Hawking all-pass section has a global continuous physical phase. -/
theorem thetaCuspHawkingCausalAllPassBoundary_eq_exp
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) (x : ℝ) :
    thetaCuspHawkingCausalAllPassBoundary r x =
      Complex.exp
        ((GaloisForLFunctions.HTGeometry.polePhase r.1.re r.1.im x : ℂ) *
          Complex.I) := by
  rw [thetaCuspHawkingCausalAllPassBoundary_eq_poleFactor]
  exact GaloisForLFunctions.HTGeometry.polePhase_eq_exp hr

/-- A right-half-plane theta resonance is invisible to physical Hawking intensity. -/
theorem norm_thetaCuspHawkingCausalAllPassBoundary
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) (x : ℝ) :
    ‖thetaCuspHawkingCausalAllPassBoundary r x‖ = 1 := by
  rw [thetaCuspHawkingCausalAllPassBoundary_eq_exp r hr x,
    Complex.norm_exp]
  simp [Complex.mul_re]

/-- Wigner--Smith phase slope of the causal all-pass sector. -/
def thetaCuspHawkingCausalAllPassClock
    (r : ThetaCuspHawkingBackreactionResonantMode) (x : ℝ) : ℝ :=
  deriv (GaloisForLFunctions.HTGeometry.polePhase r.1.re r.1.im) x

/-- Exact Lorentzian all-pass clock produced by a right-half-plane theta resonance. -/
theorem thetaCuspHawkingCausalAllPassClock_eq
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) (x : ℝ) :
    thetaCuspHawkingCausalAllPassClock r x =
      2 * r.1.im / (r.1.im ^ (2 : ℕ) + (x - r.1.re) ^ (2 : ℕ)) := by
  rw [thetaCuspHawkingCausalAllPassClock,
    (GaloisForLFunctions.HTGeometry.hasDerivAt_polePhase r.1.re hr x).deriv]
  ring

theorem thetaCuspHawkingCausalAllPassClock_pos
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) (x : ℝ) :
    0 < thetaCuspHawkingCausalAllPassClock r x := by
  rw [thetaCuspHawkingCausalAllPassClock_eq r hr]
  positivity

/-- Intensity-equivalent all-pass dressing of the literal normalized theta-Hawking Born form
factor on physical frequency. -/
def thetaCuspHawkingAllPassDressedBornFormFactor
    (r : ThetaCuspHawkingBackreactionResonantMode) (x : ℝ) : ℂ :=
  thetaCuspHawkingCausalAllPassBoundary r x *
    thetaCuspFourierLaplace (x : ℂ)

/-- The exact theta-Hawking particle-number profile is blind to the causal all-pass sector. -/
theorem norm_thetaCuspHawkingAllPassDressedBornFormFactor
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) (x : ℝ) :
    ‖thetaCuspHawkingAllPassDressedBornFormFactor r x‖ =
      ‖thetaCuspFourierLaplace (x : ℂ)‖ := by
  rw [thetaCuspHawkingAllPassDressedBornFormFactor, norm_mul,
    norm_thetaCuspHawkingCausalAllPassBoundary r hr x, one_mul]

/-- The normalized theta-Born form factor has zero central derivative, so its bare central phase
clock is zero. -/
theorem deriv_thetaCuspHawkingBornFormFactor_zero :
    deriv thetaCuspFourierLaplace 0 = 0 := by
  rw [show thetaCuspFourierLaplace = XiC from
    funext HedenmalmThetaSource.thetaCuspFourierLaplace_eq_XiC_all]
  have h := deriv_XiC_neg 0
  have hneg : deriv XiC 0 = -deriv XiC 0 := by
    simpa only [neg_zero] using h
  have htwo : (2 : ℂ) * deriv XiC 0 = 0 := by
    linear_combination hneg
  exact (mul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- Additional zero-frequency Wigner--Smith clock of the normalized all-pass-dressed theta-Born
response.  The bare theta form factor contributes zero by
`deriv_thetaCuspHawkingBornFormFactor_zero`. -/
def thetaCuspHawkingAllPassDressedBornClockZero
    (r : ThetaCuspHawkingBackreactionResonantMode) : ℝ :=
  thetaCuspHawkingCausalAllPassClock r 0

/-- **Intensity/clock separation.**  A right-half-plane theta resonance leaves every physical
Born intensity unchanged but contributes the strictly positive zero-frequency clock
`2 Im(alpha)/normSq(alpha)`. -/
theorem thetaCuspHawkingAllPassDressedBornClockZero_eq
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) :
    thetaCuspHawkingAllPassDressedBornClockZero r =
      2 * r.1.im / Complex.normSq r.1 := by
  rw [thetaCuspHawkingAllPassDressedBornClockZero]
  rw [thetaCuspHawkingCausalAllPassClock_eq r hr]
  simp [Complex.normSq_apply]
  ring

theorem thetaCuspHawkingAllPassDressedBornClockZero_pos
    (r : ThetaCuspHawkingBackreactionResonantMode)
    (hr : 0 < r.1.im) :
    0 < thetaCuspHawkingAllPassDressedBornClockZero r := by
  rw [thetaCuspHawkingAllPassDressedBornClockZero_eq r hr]
  exact div_pos (mul_pos (by norm_num) hr)
    (Complex.normSq_pos.mpr
      (thetaCuspHawkingBackreactionResonantMode_ne_zero r))

/-- Source-normalized minimum-phase rigidity: no upper causal theta resonance contributes a
positive intensity-invisible zero-frequency clock. -/
def ThetaCuspHawkingMinimumPhaseClockRigid : Prop :=
  ∀ r : ThetaCuspHawkingBackreactionResonantMode,
    0 < r.1.im → thetaCuspHawkingAllPassDressedBornClockZero r = 0

/-- **Theta-Hawking minimum-phase endpoint.**  RH is equivalent to exact zero-frequency clock
rigidity of the source-normalized moving-mirror Born response.  Unlike particle number, this
phase-sensitive endpoint detects every causal all-pass factor generated by an off-line zero. -/
theorem riemannHypothesis_iff_thetaCuspHawkingMinimumPhaseClockRigid :
    RiemannHypothesis ↔ ThetaCuspHawkingMinimumPhaseClockRigid := by
  rw [riemannHypothesis_iff_XiC_zeros_real]
  constructor
  · intro hRH r hr
    have hzero :=
      hRH r.1 (thetaCuspHawkingBackreactionResonantMode_XiC_eq_zero r)
    exfalso
    linarith
  · intro hrigid alpha hXi
    let r : ThetaCuspHawkingBackreactionResonantMode :=
      ⟨alpha, (xiC_eq_zero_iff_thetaCuspHawkingBackreactionResonance alpha).mp hXi⟩
    by_contra him
    have horient : 0 < r.1.im ∨
        0 < (thetaCuspHawkingBackreactionReflectedResonantMode r).1.im := by
      rw [thetaCuspHawkingBackreactionReflectedResonantMode_im]
      rcases lt_or_gt_of_ne him with hneg | hpos
      · exact Or.inr (neg_pos.mpr hneg)
      · exact Or.inl hpos
    rcases horient with hr | hr
    · exact (ne_of_gt
        (thetaCuspHawkingAllPassDressedBornClockZero_pos r hr))
          (hrigid r hr)
    · exact (ne_of_gt
        (thetaCuspHawkingAllPassDressedBornClockZero_pos
          (thetaCuspHawkingBackreactionReflectedResonantMode r) hr))
            (hrigid (thetaCuspHawkingBackreactionReflectedResonantMode r) hr)

end RHTower
