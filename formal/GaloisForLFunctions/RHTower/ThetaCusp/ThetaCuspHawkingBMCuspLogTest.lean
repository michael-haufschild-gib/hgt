import GaloisForLFunctions.RHTower.ThetaCusp.ThetaCuspHawkingBMCuspLogCoordinate
import Mathlib.Analysis.SpecialFunctions.Log.Deriv

/-!
Every smooth compact logarithmic cusp profile has a constructed inverse transform in the original modular operator domain.
-/

open MeasureTheory Set Filter Topology UpperHalfPlane ModularGroup
open GaloisForLFunctions.HTGeometry
open scoped ContDiff ComplexConjugate
namespace RHTower.D4BMModularCore
noncomputable section

/-- A smooth compact wave profile in the flat logarithmic coordinate of the actual cusp. -/
structure CuspLogTest where
  field : ℝ → ℂ
  smooth : ContDiff ℝ ∞ field
  compact : HasCompactSupport field
  support : tsupport field ⊆ Ioi (Real.log 2)

/-- The inverse density and coordinate transform, defined on every real height. -/
def CuspLogTest.heightField (f : CuspLogTest) (y : ℝ) : ℂ :=
  if 0 < y then (Real.exp (Real.log y/2):ℂ)*f.field (Real.log y) else 0

theorem CuspLogTest.heightField_zero_low (f : CuspLogTest) {y : ℝ} (hy : y ≤ 2) :
    f.heightField y = 0 := by
  by_cases hp : 0 < y
  · have hf : f.field (Real.log y) = 0 := image_eq_zero_of_notMem_tsupport
      (fun hs => (not_lt_of_ge (Real.log_le_log hp hy)) (f.support hs))
    simp only [CuspLogTest.heightField,if_pos hp,hf,mul_zero]
  · simp only [CuspLogTest.heightField,if_neg hp]

private theorem CuspLogTest.heightField_support (f : CuspLogTest) :
    tsupport f.heightField ⊆ Real.exp '' tsupport f.field := by
  apply closure_minimal _ (f.compact.image Real.continuous_exp).isClosed
  intro y hy
  have hp : 0 < y := by
    by_contra hn
    exact hy (by simp [CuspLogTest.heightField,hn])
  refine ⟨Real.log y,subset_tsupport _ ?_,Real.exp_log hp⟩
  intro hz
  exact hy (by simp [CuspLogTest.heightField,hp,hz])

theorem CuspLogTest.heightField_smooth (f : CuspLogTest) : ContDiff ℝ ∞ f.heightField := by
  apply contDiff_iff_contDiffAt.mpr
  intro y
  by_cases hp : 0 < y
  · have hg : f.heightField =ᶠ[𝓝 y] (fun x => (Real.exp (Real.log x/2):ℂ)*f.field (Real.log x)) := by
      filter_upwards [isOpen_Ioi.mem_nhds hp] with x hx
      change 0 < x at hx
      simp only [CuspLogTest.heightField,if_pos hx]
    have hl : ContDiffAt ℝ ∞ Real.log y := Real.contDiffAt_log.mpr hp.ne'
    exact ((Complex.ofRealCLM.contDiff.contDiffAt.comp y ((hl.div_const 2).exp)).mul
      (f.smooth.contDiffAt.comp y hl)).congr_of_eventuallyEq hg
  · have hg : f.heightField =ᶠ[𝓝 y] (fun _ => 0) := by
      have hy : y < 2 := lt_of_le_of_lt (le_of_not_gt hp) (by norm_num)
      filter_upwards [isOpen_Iio.mem_nhds hy] with x hx
      exact f.heightField_zero_low hx.le
    exact contDiffAt_const.congr_of_eventuallyEq hg

/-- Every smooth compact logarithmic wave packet is constructed in the original
modular cusp domain, including smoothness through height zero. -/
def CuspLogTest.heightTest (f : CuspLogTest) : CuspHeightTest where
  field := f.heightField
  smooth := f.heightField_smooth
  compact := (f.compact.image Real.continuous_exp).of_isClosed_subset isClosed_closure
    f.heightField_support
  support := by
    intro y hy
    obtain ⟨t,ht,rfl⟩ := f.heightField_support hy
    have hh := Real.exp_lt_exp.mpr (f.support ht)
    change 2 < Real.exp t
    simpa only [Real.exp_log (by norm_num : (0:ℝ)<2)] using hh

/-- Reconstruction followed by the native logarithmic transform recovers
the exact original wave profile, with no approximation or normalization loss. -/
theorem CuspLogTest.logProfile_heightTest (f : CuspLogTest) : f.heightTest.logProfile = f.field := by
  funext t
  simp only [CuspHeightTest.logProfile,CuspLogTest.heightTest,CuspLogTest.heightField,
    if_pos (Real.exp_pos t),Real.log_exp,cuspLogWeight]
  rw [← mul_assoc,← Complex.ofReal_mul,← Real.exp_add]
  rw [show -t/2+t/2=0 by ring,Real.exp_zero,Complex.ofReal_one,one_mul]

/-- The exact original modular vector generated by an arbitrary admitted log-height test. -/
def CuspLogTest.operatorVector (f : CuspLogTest) : energyOperator.domain :=
  f.heightTest.operatorVector

/-- The actual modular norm and pairing of reconstructed log-height tests
are precisely their flat one-dimensional pairings. -/
theorem CuspLogTest.operatorVector_inner (f g : CuspLogTest) :
    inner ℂ (f.operatorVector : Space) (g.operatorVector : Space) =
      ∫ t in Ioi (Real.log 2), conj (f.field t)*g.field t := by
  rw [show f.operatorVector = f.heightTest.operatorVector from rfl,
    show g.operatorVector = g.heightTest.operatorVector from rfl,
    CuspHeightTest.logProfile_inner,f.logProfile_heightTest,g.logProfile_heightTest]

end
end RHTower.D4BMModularCore
