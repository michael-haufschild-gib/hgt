import GaloisForLFunctions.RHTower.RelativeShellExactCommonCore

/-!
# Canonical finite provenance support for complete shell observables

The complete relative Boolean algebra of high-exponent shell differential
fields gives every observable more than some finite source presentation.  The
intersection of all source sets which generate an observable is itself an
admissible source set, by the exact arbitrary-meet theorem.  The finite-support
theorem then makes this least source set finite.

This file constructs that canonical support and proves its universal property:
an observable belongs to the field generated by `S` exactly when its canonical
support is contained in `S`.  The support is the unique least finite source,
is subadditive under field operations and differentiation, assigns empty
private support to the common zeta mode, and assigns exactly `{m}` to the
private multiplier of shell `m`.

The result upgrades existential finite support to a source-provenance
invariant.  It provides a falsifiable anti-theatre condition for Route L:
source comparisons can now be required to preserve a unique minimal finite
shell label set, not merely some presentation chosen after seeing the target.

All theorems are unconditional.  No RH, zero simplicity, computation, or
choice of a target comparison is used.
-/

open Set
open scoped Classical
open scoped Differential UpperEndDifferentialInstances
  UpperEndComplexTowerInstances

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Labels of the complete high-exponent shell frame. -/
abbrev RelativeShellLabel := {m : ℕ // 12 ≤ m}

/-- Full differential field generated by all private shell labels and the common mode. -/
abbrev RelativeShellFullObservable :=
  relativeShellSubsetDifferentialField
    (Set.univ : Set RelativeShellLabel)

/-- A private shell multiplier as an observable in the full shell field. -/
def relativeShellMultiplierObservable
    (m : RelativeShellLabel) : RelativeShellFullObservable :=
  ⟨relativeShellMultiplierUpperEndCarrier m.1, by
    apply subset_differentialAdjoin
    exact
      ⟨Sum.inr ⟨m, Set.mem_univ m⟩, rfl⟩⟩

/-- The common zeta mode as an observable in the full shell field. -/
def relativeShellCommonObservable : RelativeShellFullObservable :=
  ⟨zetaUpperEndMero, by
    apply subset_differentialAdjoin
    exact ⟨Sum.inl (), rfl⟩⟩

/-- Source sets whose shell differential field contains `x`. -/
def RelativeShellAdmissibleSource
    (x : RelativeShellFullObservable) :=
  {S : Set RelativeShellLabel //
    (x : upperEndMeroField) ∈
      relativeShellSubsetDifferentialField S}

instance (x : RelativeShellFullObservable) :
    Nonempty (RelativeShellAdmissibleSource x) :=
  ⟨⟨Set.univ, x.property⟩⟩

/-- Intersection of every source set which generates `x`. -/
def relativeShellObservableSupport
    (x : RelativeShellFullObservable) : Set RelativeShellLabel :=
  ⋂ S : RelativeShellAdmissibleSource x, S.1

/-- Canonical support is contained in every source presentation. -/
theorem relativeShellObservableSupport_subset
    (x : RelativeShellFullObservable)
    (S : Set RelativeShellLabel)
    (hxS :
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField S) :
    relativeShellObservableSupport x ⊆ S := by
  intro m hm
  exact Set.mem_iInter.mp hm ⟨S, hxS⟩

/--
Exact arbitrary meets make the intersection of all source presentations an
admissible presentation itself.
-/
theorem relativeShellObservableSupport_mem
    (x : RelativeShellFullObservable) :
    (x : upperEndMeroField) ∈
      relativeShellSubsetDifferentialField
        (relativeShellObservableSupport x) := by
  let A := RelativeShellAdmissibleSource x
  have hxInf :
      (x : upperEndMeroField) ∈
        ⨅ S : A,
          relativeShellSubsetDifferentialField S.1 := by
    show
      (x : upperEndMeroField) ∈
        (↑(⨅ S : RelativeShellAdmissibleSource x,
          relativeShellSubsetDifferentialField S.1) :
            Set upperEndMeroField)
    rw [IntermediateField.coe_iInf]
    exact Set.mem_iInter.mpr fun S => S.property
  have hfield :=
    relativeShellSubsetDifferentialField_iInf
      (fun S : A => S.1)
  rw [hfield] at hxInf
  exact hxInf

/--
Universal provenance law: membership in a shell field is exactly containment
of canonical support.
-/
theorem mem_relativeShellSubsetDifferentialField_iff_support_subset
    (x : RelativeShellFullObservable)
    (S : Set RelativeShellLabel) :
    (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField S ↔
      relativeShellObservableSupport x ⊆ S := by
  constructor
  · exact relativeShellObservableSupport_subset x S
  · intro hsub
    exact
      (relativeShellSubsetDifferentialField_le_iff
        (relativeShellObservableSupport x) S).mpr hsub
        (relativeShellObservableSupport_mem x)

/-- Every canonical provenance support is finite. -/
theorem relativeShellObservableSupport_finite
    (x : RelativeShellFullObservable) :
    (relativeShellObservableSupport x).Finite := by
  obtain ⟨C, -, hxC⟩ :=
    relativeShellSubsetDifferentialField_exists_finset_support
      (Set.univ : Set RelativeShellLabel) x.property
  exact
    C.finite_toSet.subset
      (relativeShellObservableSupport_subset x
        (C : Set RelativeShellLabel) hxC)

/-- Empty private support is exactly membership in the common bottom field. -/
theorem relativeShellObservableSupport_eq_empty_iff
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport x = ∅ ↔
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField ∅ := by
  rw [mem_relativeShellSubsetDifferentialField_iff_support_subset]
  exact Set.subset_empty_iff.symm

/-- Addition cannot introduce a shell outside the union of input supports. -/
theorem relativeShellObservableSupport_add_subset
    (x y : RelativeShellFullObservable) :
    relativeShellObservableSupport (x + y) ⊆
      relativeShellObservableSupport x ∪
        relativeShellObservableSupport y := by
  rw [←
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  apply IntermediateField.add_mem
  · exact
      (relativeShellSubsetDifferentialField_le_iff
        (relativeShellObservableSupport x)
        (relativeShellObservableSupport x ∪
          relativeShellObservableSupport y)).mpr
        Set.subset_union_left
        (relativeShellObservableSupport_mem x)
  · exact
      (relativeShellSubsetDifferentialField_le_iff
        (relativeShellObservableSupport y)
        (relativeShellObservableSupport x ∪
          relativeShellObservableSupport y)).mpr
        Set.subset_union_right
        (relativeShellObservableSupport_mem y)

/-- Multiplication cannot introduce a shell outside the union of input supports. -/
theorem relativeShellObservableSupport_mul_subset
    (x y : RelativeShellFullObservable) :
    relativeShellObservableSupport (x * y) ⊆
      relativeShellObservableSupport x ∪
        relativeShellObservableSupport y := by
  rw [←
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  apply IntermediateField.mul_mem
  · exact
      (relativeShellSubsetDifferentialField_le_iff
        (relativeShellObservableSupport x)
        (relativeShellObservableSupport x ∪
          relativeShellObservableSupport y)).mpr
        Set.subset_union_left
        (relativeShellObservableSupport_mem x)
  · exact
      (relativeShellSubsetDifferentialField_le_iff
        (relativeShellObservableSupport y)
        (relativeShellObservableSupport x ∪
          relativeShellObservableSupport y)).mpr
        Set.subset_union_right
        (relativeShellObservableSupport_mem y)

theorem relativeShellObservableSupport_neg_subset
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport (-x) ⊆
      relativeShellObservableSupport x := by
  rw [←
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  exact
    IntermediateField.neg_mem _
      (relativeShellObservableSupport_mem x)

theorem relativeShellObservableSupport_inv_subset
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport x⁻¹ ⊆
      relativeShellObservableSupport x := by
  rw [←
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  exact
    IntermediateField.inv_mem _
      (relativeShellObservableSupport_mem x)

/-- Negation preserves canonical provenance exactly. -/
theorem relativeShellObservableSupport_neg
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport (-x) =
      relativeShellObservableSupport x := by
  apply Set.Subset.antisymm
  · exact relativeShellObservableSupport_neg_subset x
  · simpa using relativeShellObservableSupport_neg_subset (-x)

/-- Inversion preserves canonical provenance exactly, including at zero. -/
theorem relativeShellObservableSupport_inv
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport x⁻¹ =
      relativeShellObservableSupport x := by
  apply Set.Subset.antisymm
  · exact relativeShellObservableSupport_inv_subset x
  · simpa using relativeShellObservableSupport_inv_subset x⁻¹

/-- Canonical support as an actual finite set of shell labels. -/
def relativeShellObservableSupportFinset
    (x : RelativeShellFullObservable) : Finset RelativeShellLabel :=
  relativeShellObservableSupport_finite x |>.toFinset

@[simp] theorem coe_relativeShellObservableSupportFinset
    (x : RelativeShellFullObservable) :
    (relativeShellObservableSupportFinset x :
      Set RelativeShellLabel) =
      relativeShellObservableSupport x := by
  exact Set.Finite.coe_toFinset _

theorem relativeShellObservableSupportFinset_mem
    (x : RelativeShellFullObservable) :
    (x : upperEndMeroField) ∈
      relativeShellSubsetDifferentialField
        (relativeShellObservableSupportFinset x :
          Set RelativeShellLabel) := by
  rw [coe_relativeShellObservableSupportFinset]
  exact relativeShellObservableSupport_mem x

theorem relativeShellObservableSupportFinset_least
    (x : RelativeShellFullObservable)
    (S : Set RelativeShellLabel)
    (hxS :
      (x : upperEndMeroField) ∈
        relativeShellSubsetDifferentialField S) :
    (relativeShellObservableSupportFinset x :
      Set RelativeShellLabel) ⊆ S := by
  rw [coe_relativeShellObservableSupportFinset]
  exact relativeShellObservableSupport_subset x S hxS

/-- Every full shell observable has a unique least finite source presentation. -/
theorem exists_unique_relativeShellObservableSupportFinset
    (x : RelativeShellFullObservable) :
    ∃! C : Finset RelativeShellLabel,
      (x : upperEndMeroField) ∈
          relativeShellSubsetDifferentialField
            (C : Set RelativeShellLabel) ∧
        ∀ S : Set RelativeShellLabel,
          (x : upperEndMeroField) ∈
              relativeShellSubsetDifferentialField S →
            (C : Set RelativeShellLabel) ⊆ S := by
  refine ⟨relativeShellObservableSupportFinset x, ?_, ?_⟩
  · exact
      ⟨relativeShellObservableSupportFinset_mem x,
        relativeShellObservableSupportFinset_least x⟩
  · intro C hC
    apply Finset.ext
    intro m
    constructor
    · intro hm
      have hmSet :
          m ∈ (C : Set RelativeShellLabel) := hm
      have :=
        hC.2
          (relativeShellObservableSupportFinset x :
            Set RelativeShellLabel)
          (relativeShellObservableSupportFinset_mem x)
          hmSet
      exact this
    · intro hm
      have hmSet :
          m ∈
            (relativeShellObservableSupportFinset x :
              Set RelativeShellLabel) := hm
      have :=
        relativeShellObservableSupportFinset_least
          x (C : Set RelativeShellLabel) hC.1 hmSet
      exact this

/-- Ambient differential applied within the full shell field. -/
def relativeShellObservableDeriv
    (x : RelativeShellFullObservable) :
    RelativeShellFullObservable :=
  ⟨(x : upperEndMeroField)′,
    derivationClosed_differentialAdjoin
      upperEndRationalCoordinateField _
      x.property⟩

/-- Differentiation cannot create a new private shell label. -/
theorem relativeShellObservableDeriv_support_subset
    (x : RelativeShellFullObservable) :
    relativeShellObservableSupport
        (relativeShellObservableDeriv x) ⊆
      relativeShellObservableSupport x := by
  rw [←
    mem_relativeShellSubsetDifferentialField_iff_support_subset]
  exact
    derivationClosed_differentialAdjoin
      upperEndRationalCoordinateField _
      (relativeShellObservableSupport_mem x)

/-- The common zeta mode has no private shell support. -/
theorem relativeShellCommonObservable_support :
    relativeShellObservableSupport
        relativeShellCommonObservable = ∅ := by
  rw [relativeShellObservableSupport_eq_empty_iff]
  apply subset_differentialAdjoin
  exact ⟨Sum.inl (), rfl⟩

/-- A private shell generator cannot belong to the common bottom field. -/
theorem relativeShellMultiplierUpperEndCarrier_not_mem_common
    (m : RelativeShellLabel) :
    relativeShellMultiplierUpperEndCarrier m.1 ∉
      relativeShellSubsetDifferentialField
        (∅ : Set RelativeShellLabel) := by
  intro hm
  have hle :
      relativeShellSubsetDifferentialField
          ({m} : Set RelativeShellLabel) ≤
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel) := by
    apply differentialAdjoin_le upperEndRationalCoordinateField
    · rintro z ⟨u | n, rfl⟩
      · exact
          subset_differentialAdjoin
            upperEndRationalCoordinateField
            (Set.range
              (Sum.elim
                (fun _ : Unit => zetaUpperEndMero)
                (fun n : (∅ : Set RelativeShellLabel) =>
                  relativeShellMultiplierUpperEndCarrier n.1.1)))
            ⟨Sum.inl u, rfl⟩
      · have hn : n.1 = m :=
          Set.mem_singleton_iff.mp n.2
        change
          relativeShellMultiplierUpperEndCarrier n.1.1 ∈
            relativeShellSubsetDifferentialField
              (∅ : Set RelativeShellLabel)
        rw [hn]
        exact hm
    · exact
        derivationClosed_differentialAdjoin
          upperEndRationalCoordinateField _
  have hsubset :
      ({m} : Set RelativeShellLabel) ⊆ ∅ :=
    (relativeShellSubsetDifferentialField_le_iff
      ({m} : Set RelativeShellLabel)
      (∅ : Set RelativeShellLabel)).mp hle
  have : m ∈ (∅ : Set RelativeShellLabel) :=
    hsubset (Set.mem_singleton m)
  exact this

/-- Canonical provenance of a private shell generator is exactly its singleton label. -/
theorem relativeShellMultiplierObservable_support
    (m : RelativeShellLabel) :
    relativeShellObservableSupport
        (relativeShellMultiplierObservable m) = {m} := by
  have hmem :
      (relativeShellMultiplierObservable m :
        upperEndMeroField) ∈
      relativeShellSubsetDifferentialField
        ({m} : Set RelativeShellLabel) := by
    apply subset_differentialAdjoin
    exact ⟨Sum.inr ⟨m, Set.mem_singleton m⟩, rfl⟩
  have hsub :
      relativeShellObservableSupport
          (relativeShellMultiplierObservable m) ⊆ {m} :=
    relativeShellObservableSupport_subset _ _ hmem
  apply Set.Subset.antisymm hsub
  intro n hn
  have hnm : n = m := by simpa using hn
  subst n
  by_contra hmSupport
  have hempty :
      relativeShellObservableSupport
          (relativeShellMultiplierObservable m) = ∅ := by
    apply Set.Subset.antisymm
    · intro n hnSupport
      have : n = m := by simpa using hsub hnSupport
      subst n
      exact (hmSupport hnSupport).elim
    · exact Set.empty_subset _
  have hmCommon :
      (relativeShellMultiplierObservable m :
        upperEndMeroField) ∈
        relativeShellSubsetDifferentialField
          (∅ : Set RelativeShellLabel) := by
    rw [←
      relativeShellObservableSupport_eq_empty_iff
        (relativeShellMultiplierObservable m)]
    exact hempty
  exact
    relativeShellMultiplierUpperEndCarrier_not_mem_common m
      hmCommon

end

end RHTower
