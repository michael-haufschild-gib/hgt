import GaloisForLFunctions.RHTower.DeningerPlaceCountable
import GaloisForLFunctions.RHTower.DeningerFinestSubspaceNuclear
import GaloisForLFunctions.RHTower.DeningerFinestClosed
import Mathlib.NumberTheory.NumberField.ProductFormula

/-!
# The space of places of a number field, and the logarithmic Kummer functions

The places of a number field form a countable discrete space: locally compact, Hausdorff, second
countable and totally disconnected, so the locally constant test space theory applies to it.

The logarithmic Kummer function of a nonzero element sends a place to the logarithm of the
absolute value there, weighted by the multiplicity at the infinite places.  It is a test function:
every function on a discrete space is locally constant, and the absolute value is one at all but
finitely many finite places.

* `DeningerPlace` : the places of a number field, discrete and countable.
* `deningerKummerFun`, `_mem` : **the logarithmic Kummer functions are test functions.**
* `DeningerKummerSpan` : their span, a closed nuclear subspace.
-/

namespace RHTower

open NumberField

section PlaceSpace

variable (K : Type*) [Field K] [NumberField K]

/-- **The places of a number field.** -/
def DeningerPlace (K : Type*) [Field K] [NumberField K] : Type _ :=
  InfinitePlace K ⊕ FinitePlace K

instance : TopologicalSpace (DeningerPlace K) := ⊥

instance : DiscreteTopology (DeningerPlace K) := ⟨rfl⟩

instance : Countable (DeningerPlace K) := by
  haveI := deningerFinitePlace_countable K
  exact inferInstanceAs (Countable (InfinitePlace K ⊕ FinitePlace K))

/-- The logarithmic Kummer function of an element: the logarithm of its absolute value at each
place, weighted by the multiplicity at the infinite places. -/
noncomputable def deningerKummerFun (α : K) : DeningerPlace K → ℝ :=
  Sum.elim (fun w : InfinitePlace K => (w.mult : ℝ) * Real.log (w α))
    (fun w : FinitePlace K => Real.log (w α))

theorem deningerKummerFun_inl (α : K) (w : InfinitePlace K) :
    deningerKummerFun K α (Sum.inl w : DeningerPlace K) = (w.mult : ℝ) * Real.log (w α) := rfl

theorem deningerKummerFun_inr (α : K) (w : FinitePlace K) :
    deningerKummerFun K α (Sum.inr w : DeningerPlace K) = Real.log (w α) := rfl

/-- **A logarithmic Kummer function has finite support**: the infinite places are finitely many,
and the absolute value is one at all but finitely many finite places. -/
theorem deningerKummerFun_support_finite {α : K} (hα : α ≠ 0) :
    (Function.support (deningerKummerFun K α)).Finite := by
  classical
  have hfin := (FinitePlace.hasFiniteMulSupport (K := K) hα)
  have hsub : Function.support (deningerKummerFun K α)
      ⊆ (Sum.inl '' (Set.univ : Set (InfinitePlace K)))
        ∪ (Sum.inr '' Function.mulSupport fun w : FinitePlace K => w α) := by
    rintro (w | w) hw
    · exact Or.inl ⟨w, Set.mem_univ _, rfl⟩
    · refine Or.inr ⟨w, ?_, rfl⟩
      intro hone
      apply hw
      show Real.log (w α) = 0
      rw [show w α = 1 from hone, Real.log_one]
  refine Set.Finite.subset (Set.Finite.union ?_ ?_) hsub
  · exact (Set.finite_univ (α := InfinitePlace K)).image _
  · exact hfin.image _

/-- **The logarithmic Kummer functions are test functions.** -/
theorem deningerKummerFun_mem {α : K} (hα : α ≠ 0) :
    deningerKummerFun K α ∈ DeningerTestSpace (DeningerPlace K) := by
  refine ⟨IsLocallyConstant.of_discrete _, ?_⟩
  exact (deningerKummerFun_support_finite K hα).isCompact

/-- The logarithmic Kummer functions as elements of the test space. -/
noncomputable def deningerKummerTest {α : K} (hα : α ≠ 0) :
    DeningerTestSpace (DeningerPlace K) :=
  ⟨deningerKummerFun K α, deningerKummerFun_mem K hα⟩

/-- **The Kummer span**: the subspace of the test space generated by the logarithmic Kummer
functions. -/
noncomputable def DeningerKummerSpan : Submodule ℝ (DeningerTestSpace (DeningerPlace K)) :=
  Submodule.span ℝ {g | ∃ (α : K) (hα : α ≠ 0), g = deningerKummerTest K hα}

/-- **The Kummer span is nuclear.** -/
theorem deningerKummerSpan_isNuclearSpace :
    DeningerIsNuclearSpace (fun p : Seminorm ℝ (DeningerTestSpace (DeningerPlace K)) =>
      deningerRestrictSeminorm (DeningerKummerSpan K) p) :=
  deningerTestSubspace_isNuclearSpace _

/-- **The Kummer span is closed.** -/
theorem deningerKummerSpan_closed {g : DeningerTestSpace (DeningerPlace K)}
    (hg : g ∉ DeningerKummerSpan K) :
    ∃ (p : Seminorm ℝ (DeningerTestSpace (DeningerPlace K))) (c : ℝ), 0 < c ∧
      ∀ v ∈ DeningerKummerSpan K, c ≤ p (g - v) :=
  deningerTestSubspace_closed _ hg

end PlaceSpace

end RHTower
