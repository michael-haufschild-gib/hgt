import GaloisForLFunctions.RHTower.MobiusPrimeRenewalDefectBoundary
import Mathlib.Combinatorics.Hall.Basic

/-!
# Opposite-sign transport consumer for the Möbius boundary

A local pairing of positive and negative boundary atoms converts into a Laplace bound through a
sharp damped displacement cost.  This module formalizes the unconditional analytic implication
used by the `FOUR-PRIME-BOUNDARY-TRANSPORT` conjecture; it does not assume that the arithmetic
matching exists.
-/

open scoped BigOperators

namespace RHTower

noncomputable section

theorem mobiusComplexCoefficient_mul_of_coprime
    {m n : ℕ} (h : m.Coprime n) :
    mobiusComplexCoefficient (m * n) =
      mobiusComplexCoefficient m * mobiusComplexCoefficient n := by
  rw [mobiusComplexCoefficient, mobiusComplexCoefficient, mobiusComplexCoefficient,
    ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime h]
  norm_cast

theorem mobiusComplexCoefficient_prime
    {p : ℕ} (hp : p.Prime) :
    mobiusComplexCoefficient p = -1 := by
  rw [mobiusComplexCoefficient, ArithmeticFunction.moebius_apply_prime hp]
  norm_num

/-- The same-sector local move `q ↔ r*s` reverses Möbius sign whenever all replacement primes
avoid the spectator and each other. -/
theorem mobiusComplexCoefficient_onePrime_eq_neg_twoPrimeReplacement
    {a q r s : ℕ} (hq : q.Prime) (hr : r.Prime) (hs : s.Prime)
    (hqa : q.Coprime a) (hra : r.Coprime a) (hsa : s.Coprime a)
    (hrs : r.Coprime s) :
    mobiusComplexCoefficient (q * a) =
      -mobiusComplexCoefficient ((r * s) * a) := by
  rw [mobiusComplexCoefficient_mul_of_coprime hqa, mobiusComplexCoefficient_prime hq]
  rw [show (r * s) * a = r * (s * a) by ring]
  rw [mobiusComplexCoefficient_mul_of_coprime (hrs.mul_right hra),
    mobiusComplexCoefficient_mul_of_coprime hsa,
    mobiusComplexCoefficient_prime hr, mobiusComplexCoefficient_prime hs]
  ring

/-- A prime token and any coprime even-Möbius replacement token give opposite boundary signs.
The four-distinct-prime cross-sector move is the main application. -/
theorem mobiusComplexCoefficient_prime_eq_neg_evenReplacement
    {a p Q : ℕ} (hp : p.Prime) (hpa : p.Coprime a) (hQa : Q.Coprime a)
    (hQ : mobiusComplexCoefficient Q = 1) :
    mobiusComplexCoefficient (p * a) =
      -mobiusComplexCoefficient (Q * a) := by
  rw [mobiusComplexCoefficient_mul_of_coprime hpa,
    mobiusComplexCoefficient_mul_of_coprime hQa,
    mobiusComplexCoefficient_prime hp, hQ]
  ring

/-- The cross-sector local move `p ↔ q₁*q₂*q₃*q₄` reverses Möbius sign when all five token
primes avoid the spectator and the four replacement primes are pairwise coprime. -/
theorem mobiusComplexCoefficient_onePrime_eq_neg_fourPrimeReplacement
    {a p q₁ q₂ q₃ q₄ : ℕ}
    (hp : p.Prime) (hq₁ : q₁.Prime) (hq₂ : q₂.Prime)
    (hq₃ : q₃.Prime) (hq₄ : q₄.Prime)
    (hpa : p.Coprime a)
    (h1a : q₁.Coprime a) (h2a : q₂.Coprime a)
    (h3a : q₃.Coprime a) (h4a : q₄.Coprime a)
    (h12 : q₁.Coprime q₂) (h13 : q₁.Coprime q₃) (h14 : q₁.Coprime q₄)
    (h23 : q₂.Coprime q₃) (h24 : q₂.Coprime q₄)
    (h34 : q₃.Coprime q₄) :
    mobiusComplexCoefficient (p * a) =
      -mobiusComplexCoefficient ((((q₁ * q₂) * q₃) * q₄) * a) := by
  rw [mobiusComplexCoefficient_mul_of_coprime hpa, mobiusComplexCoefficient_prime hp]
  rw [show (((q₁ * q₂) * q₃) * q₄) * a = q₁ * (q₂ * (q₃ * (q₄ * a))) by ring]
  rw [mobiusComplexCoefficient_mul_of_coprime
      (h12.mul_right (h13.mul_right (h14.mul_right h1a))),
    mobiusComplexCoefficient_mul_of_coprime
      (h23.mul_right (h24.mul_right h2a)),
    mobiusComplexCoefficient_mul_of_coprime (h34.mul_right h3a),
    mobiusComplexCoefficient_mul_of_coprime h4a,
    mobiusComplexCoefficient_prime hq₁, mobiusComplexCoefficient_prime hq₂,
    mobiusComplexCoefficient_prime hq₃, mobiusComplexCoefficient_prime hq₄]
  ring

/-- Directed same-sector factor replacement `q ↦ r*s` below aperture `z`. -/
def MobiusOneTwoPrimeReplacement (z m n : ℕ) : Prop :=
  ∃ a q r s : ℕ,
    q.Prime ∧ r.Prime ∧ s.Prime ∧
    q ≤ z ∧ r ≤ z ∧ s ≤ z ∧
    q.Coprime a ∧ r.Coprime a ∧ s.Coprime a ∧ r.Coprime s ∧
    m = q * a ∧ n = (r * s) * a

/-- Directed cross-sector replacement of one prime beyond `z` by four pairwise-coprime primes at
most `z`, all avoiding the common spectator. -/
def MobiusOneFourPrimeReplacement (z m n : ℕ) : Prop :=
  ∃ a p q₁ q₂ q₃ q₄ : ℕ,
    p.Prime ∧ q₁.Prime ∧ q₂.Prime ∧ q₃.Prime ∧ q₄.Prime ∧
    z < p ∧ q₁ ≤ z ∧ q₂ ≤ z ∧ q₃ ≤ z ∧ q₄ ≤ z ∧
    p.Coprime a ∧
    q₁.Coprime a ∧ q₂.Coprime a ∧ q₃.Coprime a ∧ q₄.Coprime a ∧
    q₁.Coprime q₂ ∧ q₁.Coprime q₃ ∧ q₁.Coprime q₄ ∧
    q₂.Coprime q₃ ∧ q₂.Coprime q₄ ∧ q₃.Coprime q₄ ∧
    m = p * a ∧ n = (((q₁ * q₂) * q₃) * q₄) * a

/-- Undirected arithmetic replacement graph generated by the two local Route E moves. -/
def MobiusBoundaryFactorReplacementAdjacent (z m n : ℕ) : Prop :=
  MobiusOneTwoPrimeReplacement z m n ∨ MobiusOneTwoPrimeReplacement z n m ∨
    MobiusOneFourPrimeReplacement z m n ∨ MobiusOneFourPrimeReplacement z n m

theorem mobiusBoundaryFactorReplacementAdjacent_symm
    {z m n : ℕ} (h : MobiusBoundaryFactorReplacementAdjacent z m n) :
    MobiusBoundaryFactorReplacementAdjacent z n m := by
  rcases h with h | h | h | h
  · exact Or.inr (Or.inl h)
  · exact Or.inl h
  · exact Or.inr (Or.inr (Or.inr h))
  · exact Or.inr (Or.inr (Or.inl h))

theorem mobiusComplexCoefficient_eq_neg_of_boundaryFactorReplacementAdjacent
    {z m n : ℕ} (h : MobiusBoundaryFactorReplacementAdjacent z m n) :
    mobiusComplexCoefficient m = -mobiusComplexCoefficient n := by
  rcases h with h | h | h | h
  · obtain ⟨a, q, r, s, hq, hr, hs, _hqz, _hrz, _hsz,
      hqa, hra, hsa, hrs, rfl, rfl⟩ := h
    exact mobiusComplexCoefficient_onePrime_eq_neg_twoPrimeReplacement
      hq hr hs hqa hra hsa hrs
  · obtain ⟨a, q, r, s, hq, hr, hs, _hqz, _hrz, _hsz,
      hqa, hra, hsa, hrs, rfl, rfl⟩ := h
    rw [mobiusComplexCoefficient_onePrime_eq_neg_twoPrimeReplacement
      hq hr hs hqa hra hsa hrs]
    ring
  · obtain ⟨a, p, q₁, q₂, q₃, q₄, hp, hq₁, hq₂, hq₃, hq₄,
      _hpz, _h1z, _h2z, _h3z, _h4z, hpa, h1a, h2a, h3a, h4a,
      h12, h13, h14, h23, h24, h34, rfl, rfl⟩ := h
    exact mobiusComplexCoefficient_onePrime_eq_neg_fourPrimeReplacement
      hp hq₁ hq₂ hq₃ hq₄ hpa h1a h2a h3a h4a h12 h13 h14 h23 h24 h34
  · obtain ⟨a, p, q₁, q₂, q₃, q₄, hp, hq₁, hq₂, hq₃, hq₄,
      _hpz, _h1z, _h2z, _h3z, _h4z, hpa, h1a, h2a, h3a, h4a,
      h12, h13, h14, h23, h24, h34, rfl, rfl⟩ := h
    rw [mobiusComplexCoefficient_onePrime_eq_neg_fourPrimeReplacement
      hp hq₁ hq₂ hq₃ hq₄ hpa h1a h2a h3a h4a h12 h13 h14 h23 h24 h34]
    ring

/-- Nonzero Möbius vertices through the exact square boundary. -/
def mobiusBoundaryFactorReplacementVertices (z : ℕ) : Finset ℕ :=
  (Finset.range (z ^ 2 + 1)).filter fun n => ArithmeticFunction.moebius n ≠ 0

abbrev MobiusBoundaryFactorReplacementVertex (z : ℕ) :=
  {n : ℕ // n ∈ mobiusBoundaryFactorReplacementVertices z}

def mobiusBoundaryFactorReplacementAdjacentOn (z : ℕ)
    (m n : MobiusBoundaryFactorReplacementVertex z) : Prop :=
  MobiusBoundaryFactorReplacementAdjacent z m n

/-- Value-local replacement relation.  The two inequalities express `|m-n| ≤ H` without an
integer-to-real coercion; unlike the raw factor graph, its degrees measure supply at the physical
Laplace resolution. -/
def MobiusBoundaryFactorReplacementWindowAdjacent (z H m n : ℕ) : Prop :=
  MobiusBoundaryFactorReplacementAdjacent z m n ∧ m ≤ n + H ∧ n ≤ m + H

def mobiusBoundaryFactorReplacementWindowAdjacentOn (z H : ℕ)
    (m n : MobiusBoundaryFactorReplacementVertex z) : Prop :=
  MobiusBoundaryFactorReplacementWindowAdjacent z H m n

noncomputable instance instDecidableRelMobiusBoundaryFactorReplacementAdjacentOn (z : ℕ) :
    DecidableRel (mobiusBoundaryFactorReplacementAdjacentOn z) :=
  Classical.decRel _

noncomputable instance instDecidableRelMobiusBoundaryFactorReplacementWindowAdjacentOn
    (z H : ℕ) :
    DecidableRel (mobiusBoundaryFactorReplacementWindowAdjacentOn z H) :=
  Classical.decRel _

theorem mobiusBoundaryFactorReplacementWindowAdjacent_symm
    {z H m n : ℕ} (h : MobiusBoundaryFactorReplacementWindowAdjacent z H m n) :
    MobiusBoundaryFactorReplacementWindowAdjacent z H n m := by
  exact ⟨mobiusBoundaryFactorReplacementAdjacent_symm h.1, h.2.2, h.2.1⟩

theorem mobiusComplexCoefficient_eq_neg_of_boundaryFactorReplacementWindowAdjacent
    {z H m n : ℕ} (h : MobiusBoundaryFactorReplacementWindowAdjacent z H m n) :
    mobiusComplexCoefficient m = -mobiusComplexCoefficient n :=
  mobiusComplexCoefficient_eq_neg_of_boundaryFactorReplacementAdjacent h.1

def mobiusBoundaryRealSign (n : ℕ) : ℝ :=
  (ArithmeticFunction.moebius n : ℝ)

def mobiusBoundaryFiniteGibbsWeight (x : ℝ) (n : ℕ) : ℝ :=
  Real.exp (-((n : ℝ) * x))

theorem abs_mobiusBoundaryRealSign_eq_one_of_mem_vertices
    {z n : ℕ} (hn : n ∈ mobiusBoundaryFactorReplacementVertices z) :
    |mobiusBoundaryRealSign n| = 1 := by
  rw [mobiusBoundaryFactorReplacementVertices, Finset.mem_filter] at hn
  have hsquarefree : Squarefree n :=
    ArithmeticFunction.moebius_ne_zero_iff_squarefree.mp hn.2
  rw [mobiusBoundaryRealSign]
  exact_mod_cast ArithmeticFunction.abs_moebius_eq_one_of_squarefree hsquarefree

theorem mobiusBoundaryRealSign_add_eq_zero_of_factorReplacementAdjacent
    {z m n : ℕ} (h : MobiusBoundaryFactorReplacementAdjacent z m n) :
    mobiusBoundaryRealSign m + mobiusBoundaryRealSign n = 0 := by
  have hc := mobiusComplexCoefficient_eq_neg_of_boundaryFactorReplacementAdjacent h
  rw [mobiusComplexCoefficient, mobiusComplexCoefficient] at hc
  have hi : ArithmeticFunction.moebius m = -ArithmeticFunction.moebius n := by
    exact_mod_cast hc
  rw [mobiusBoundaryRealSign, mobiusBoundaryRealSign]
  exact_mod_cast (show ArithmeticFunction.moebius m + ArithmeticFunction.moebius n = 0 by
    rw [hi]
    ring)

private theorem abs_exp_neg_mul_sub_exp_neg_mul_le_of_le
    {u v x : ℝ} (huv : u ≤ v) (hx : 0 ≤ x) :
    |Real.exp (-(u * x)) - Real.exp (-(v * x))| ≤
      x * |u - v| * Real.exp (-(min u v * x)) := by
  have horder : Real.exp (-(v * x)) ≤ Real.exp (-(u * x)) := by
    rw [Real.exp_le_exp]
    exact neg_le_neg (mul_le_mul_of_nonneg_right huv hx)
  rw [abs_of_nonneg (sub_nonneg.mpr horder), min_eq_left huv,
    abs_of_nonpos (sub_nonpos.mpr huv)]
  have hfactor :
      Real.exp (-(u * x)) - Real.exp (-(v * x)) =
        Real.exp (-(u * x)) * (1 - Real.exp (-((v - u) * x))) := by
    rw [mul_sub, mul_one, ← Real.exp_add]
    congr 1
    ring_nf
  rw [hfactor]
  have hdefect : 1 - Real.exp (-((v - u) * x)) ≤ (v - u) * x := by
    have h := Real.add_one_le_exp (-((v - u) * x))
    linarith
  calc
    Real.exp (-(u * x)) * (1 - Real.exp (-((v - u) * x))) ≤
        Real.exp (-(u * x)) * ((v - u) * x) :=
      mul_le_mul_of_nonneg_left hdefect (Real.exp_pos _).le
    _ = x * -(u - v) * Real.exp (-(u * x)) := by ring_nf

/-- Sharp one-edge transport estimate for the positive exponential kernel. -/
theorem abs_exp_neg_mul_sub_exp_neg_mul_le_transportCost
    {u v x : ℝ} (hx : 0 ≤ x) :
    |Real.exp (-(u * x)) - Real.exp (-(v * x))| ≤
      x * |u - v| * Real.exp (-(min u v * x)) := by
  by_cases huv : u ≤ v
  · exact abs_exp_neg_mul_sub_exp_neg_mul_le_of_le huv hx
  · have hvu : v ≤ u := le_of_not_ge huv
    simpa [abs_sub_comm, min_comm] using
      (abs_exp_neg_mul_sub_exp_neg_mul_le_of_le hvu hx)

/-- Aggregate damped displacement cost of a finite family of opposite-sign pairs. -/
def finiteDampedLaplaceTransportCost
    {ι : Type*} (s : Finset ι) (u v : ι → ℝ) (x : ℝ) : ℝ :=
  ∑ i ∈ s,
    x * |u i - v i| * Real.exp (-(min (u i) (v i) * x))

/-- Exact transport consumer: paired opposite-sign atoms cost only damped displacement; all
unpaired or truncated atoms may be placed in the explicit remainder `r`. -/
theorem abs_sum_exp_neg_mul_sub_exp_neg_mul_add_le_transportCost
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (u v : ι → ℝ)
    {x : ℝ} (hx : 0 ≤ x) (r : ℝ) :
    |(∑ i ∈ s, (Real.exp (-(u i * x)) - Real.exp (-(v i * x)))) + r| ≤
      finiteDampedLaplaceTransportCost s u v x + |r| := by
  calc
    |(∑ i ∈ s, (Real.exp (-(u i * x)) - Real.exp (-(v i * x)))) + r| ≤
        |∑ i ∈ s, (Real.exp (-(u i * x)) - Real.exp (-(v i * x)))| + |r| :=
      abs_add_le _ _
    _ ≤ (∑ i ∈ s,
          |Real.exp (-(u i * x)) - Real.exp (-(v i * x))|) + |r| :=
      add_le_add (Finset.abs_sum_le_sum_abs _ _) (le_refl _)
    _ ≤ finiteDampedLaplaceTransportCost s u v x + |r| := by
      exact add_le_add
        (Finset.sum_le_sum fun i _hi =>
          abs_exp_neg_mul_sub_exp_neg_mul_le_transportCost hx)
        (le_refl _)

/-- Hall selection plus a pointwise edge envelope gives a globally injective transport whose
cost obeys the same envelope on every finite subfamily.  This keeps the arithmetic burden exact:
one must prove the Hall inequalities for the proposed boundary graph and the stated cost bound on
every admissible edge. -/
theorem exists_injective_dampedLaplaceTransport_of_hall
    {ι α : Type*} [DecidableEq α] (t : ι → Finset α)
    (u : ι → ℝ) (v : α → ℝ) (bound : ι → ℝ) (x : ℝ)
    (hHall : ∀ s : Finset ι, s.card ≤ (s.biUnion t).card)
    (hEdge : ∀ i a, a ∈ t i →
      x * |u i - v a| * Real.exp (-(min (u i) (v a) * x)) ≤ bound i) :
    ∃ f : ι → α,
      Function.Injective f ∧
      (∀ i, f i ∈ t i) ∧
      ∀ s : Finset ι,
        finiteDampedLaplaceTransportCost s u (v ∘ f) x ≤ ∑ i ∈ s, bound i := by
  obtain ⟨f, hf_injective, hf_mem⟩ :=
    (Finset.all_card_le_biUnion_card_iff_exists_injective t).mp hHall
  refine ⟨f, hf_injective, hf_mem, ?_⟩
  intro s
  exact Finset.sum_le_sum fun i _hi => hEdge i (f i) (hf_mem i)

/-- A symmetric conductance supported on sign-reversing edges has zero signed row mass.  This is
the algebraic core of fractional opposite-sign transport. -/
theorem parityFlippingConductance_rowSum_eq_zero
    {ι : Type*} [Fintype ι] (sign : ι → ℝ) (c : ι → ι → ℝ)
    (hsymm : ∀ i j, c i j = c j i)
    (hflip : ∀ i j, c i j ≠ 0 → sign i + sign j = 0) :
    ∑ i, sign i * ∑ j, c i j = 0 := by
  classical
  let S : ℝ := ∑ i, sign i * ∑ j, c i j
  have hswap : (∑ i, ∑ j, sign j * c i j) = S := by
    calc
      (∑ i, ∑ j, sign j * c i j) = ∑ j, ∑ i, sign j * c i j :=
        Finset.sum_comm
      _ = ∑ j, ∑ i, sign j * c j i := by
        apply Finset.sum_congr rfl
        intro j _hj
        apply Finset.sum_congr rfl
        intro i _hi
        rw [hsymm i j]
      _ = S := by simp [S, Finset.mul_sum]
  have hpair : ∀ i j, (sign i + sign j) * c i j = 0 := by
    intro i j
    by_cases hc : c i j = 0
    · simp [hc]
    · rw [hflip i j hc, zero_mul]
  have hdouble : S + S = 0 := by
    calc
      S + S =
          (∑ i, ∑ j, sign i * c i j) +
            (∑ i, ∑ j, sign j * c i j) := by
        rw [hswap]
        simp [S, Finset.mul_sum]
      _ = ∑ i, ∑ j, (sign i + sign j) * c i j := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i _hi
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j _hj
        ring
      _ = 0 := by simp [hpair]
  linarith

/-- Exact fractional-transport consumer.  If a symmetric parity-flipping conductance uses at most
the available weight at each vertex, then total unused capacity bounds the signed mass. -/
theorem abs_sum_sign_weight_le_unusedConductance
    {ι : Type*} [Fintype ι] (sign weight : ι → ℝ) (c : ι → ι → ℝ)
    (hsign : ∀ i, |sign i| = 1)
    (hsymm : ∀ i j, c i j = c j i)
    (hflip : ∀ i j, c i j ≠ 0 → sign i + sign j = 0)
    (hcapacity : ∀ i, ∑ j, c i j ≤ weight i) :
    |∑ i, sign i * weight i| ≤ ∑ i, (weight i - ∑ j, c i j) := by
  classical
  have hcancel := parityFlippingConductance_rowSum_eq_zero sign c hsymm hflip
  have hrewrite :
      (∑ i, sign i * weight i) =
        ∑ i, sign i * (weight i - ∑ j, c i j) := by
    calc
      (∑ i, sign i * weight i) =
          (∑ i, sign i * weight i) - ∑ i, sign i * ∑ j, c i j := by
        rw [hcancel, sub_zero]
      _ = ∑ i, (sign i * weight i - sign i * ∑ j, c i j) := by
        rw [Finset.sum_sub_distrib]
      _ = ∑ i, sign i * (weight i - ∑ j, c i j) := by
        apply Finset.sum_congr rfl
        intro i _hi
        ring
  rw [hrewrite]
  calc
    |∑ i, sign i * (weight i - ∑ j, c i j)| ≤
        ∑ i, |sign i * (weight i - ∑ j, c i j)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ = ∑ i, (weight i - ∑ j, c i j) := by
      apply Finset.sum_congr rfl
      intro i _hi
      rw [abs_mul, hsign i, one_mul, abs_of_nonneg]
      exact sub_nonneg.mpr (hcapacity i)

/-! ## Sharpness of unrestricted fractional transport

The preceding consumer is optimal even if every opposite-sign pair is declared adjacent.  The
construction below sends the lighter side proportionally across the heavier side.  Consequently
the least possible unused capacity is exactly the original signed imbalance; locality is the only
place where an arithmetic theorem can enter.
-/

/-- Proportional conductance on the complete bipartite graph, normalized by the total right-hand
mass. -/
def completeBipartiteProportionalConductance
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ) :
    Sum α β → Sum α β → ℝ
  | Sum.inl i, Sum.inr j => u i * v j / ∑ k, v k
  | Sum.inr j, Sum.inl i => u i * v j / ∑ k, v k
  | Sum.inl _, Sum.inl _ => 0
  | Sum.inr _, Sum.inr _ => 0

def completeBipartiteSign {α β : Type*} : Sum α β → ℝ
  | Sum.inl _ => 1
  | Sum.inr _ => -1

def completeBipartiteWeight {α β : Type*} (u : α → ℝ) (v : β → ℝ) :
    Sum α β → ℝ
  | Sum.inl i => u i
  | Sum.inr j => v j

theorem completeBipartiteProportionalConductance_symm
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (i j : Sum α β) :
    completeBipartiteProportionalConductance u v i j =
      completeBipartiteProportionalConductance u v j i := by
  cases i <;> cases j <;> rfl

theorem completeBipartiteProportionalConductance_flip
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (i j : Sum α β)
    (hij : completeBipartiteProportionalConductance u v i j ≠ 0) :
    completeBipartiteSign i + completeBipartiteSign j = 0 := by
  cases i <;> cases j <;>
    simp_all [completeBipartiteProportionalConductance, completeBipartiteSign]

theorem sum_completeBipartiteProportionalConductance_inl
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (hV : (∑ j, v j) ≠ 0) (i : α) :
    ∑ j, completeBipartiteProportionalConductance u v (Sum.inl i) j = u i := by
  rw [Fintype.sum_sum_type]
  simp only [completeBipartiteProportionalConductance, Finset.sum_const_zero, zero_add]
  rw [← Finset.sum_div, ← Finset.mul_sum]
  field_simp

theorem sum_completeBipartiteProportionalConductance_inr
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (j : β) :
    ∑ i, completeBipartiteProportionalConductance u v (Sum.inr j) i =
      v j * (∑ i, u i) / ∑ k, v k := by
  rw [Fintype.sum_sum_type]
  simp only [completeBipartiteProportionalConductance, Finset.sum_const_zero, add_zero]
  rw [← Finset.sum_div]
  congr 1
  rw [← Finset.sum_mul]
  ring

/-- When left mass is no larger than right mass, proportional complete-bipartite transport uses
all left capacity, respects every right capacity, and leaves exactly their mass difference. -/
theorem completeBipartiteProportionalConductance_exact_unused
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (_hu : ∀ i, 0 ≤ u i) (hv : ∀ j, 0 ≤ v j)
    (hUV : (∑ i, u i) ≤ ∑ j, v j) (hV : (∑ j, v j) ≠ 0) :
    (∀ i, ∑ j, completeBipartiteProportionalConductance u v i j ≤
      completeBipartiteWeight u v i) ∧
    (∑ i, (completeBipartiteWeight u v i -
      ∑ j, completeBipartiteProportionalConductance u v i j)) =
        (∑ j, v j) - ∑ i, u i := by
  have hVpos : 0 < ∑ j, v j := lt_of_le_of_ne
    (Finset.sum_nonneg fun j _hj => hv j) (Ne.symm hV)
  constructor
  · intro i
    cases i with
    | inl i =>
        rw [sum_completeBipartiteProportionalConductance_inl u v hV]
        exact le_rfl
    | inr j =>
        rw [sum_completeBipartiteProportionalConductance_inr u v]
        dsimp [completeBipartiteWeight]
        rw [div_le_iff₀ hVpos]
        nlinarith [hv j]
  · rw [Fintype.sum_sum_type]
    simp_rw [sum_completeBipartiteProportionalConductance_inl u v hV,
      sum_completeBipartiteProportionalConductance_inr u v]
    simp only [completeBipartiteWeight, sub_self, Finset.sum_const_zero, zero_add]
    rw [Finset.sum_sub_distrib, ← Finset.sum_div]
    congr 1
    rw [← Finset.sum_mul]
    field_simp

/-- Exact optimality certificate: on a complete opposite-sign graph, minimum unused capacity is
the absolute signed mass itself.  Thus unrestricted fractional transport is a lossless
reparameterization, not an independent cancellation source. -/
theorem completeBipartiteProportionalConductance_attains_signedImbalance
    {α β : Type*} [Fintype α] [Fintype β] (u : α → ℝ) (v : β → ℝ)
    (hu : ∀ i, 0 ≤ u i) (hv : ∀ j, 0 ≤ v j)
    (hUV : (∑ i, u i) ≤ ∑ j, v j) (hV : (∑ j, v j) ≠ 0) :
    |∑ i, completeBipartiteSign i * completeBipartiteWeight u v i| =
      ∑ i, (completeBipartiteWeight u v i -
        ∑ j, completeBipartiteProportionalConductance u v i j) := by
  rw [(completeBipartiteProportionalConductance_exact_unused u v hu hv hUV hV).2]
  rw [Fintype.sum_sum_type]
  simp only [completeBipartiteSign, completeBipartiteWeight, one_mul, neg_mul,
    Finset.sum_neg_distrib]
  rw [abs_of_nonpos]
  · ring
  · linarith

/-- Uniformly splitting one unit of vertex capacity among all `k`-element incidence labels loses
no mass.  For a squarefree integer, these labels are the choices of `k` prime factors used by a
factor-replacement edge. -/
theorem sum_uniform_fixedCardinalityIncidenceCapacity_eq_one
    {α : Type*} [DecidableEq α] (s : Finset α) (k : ℕ) (hk : k ≤ s.card) :
    ∑ _t ∈ s.powersetCard k, (1 : ℝ) / Nat.choose s.card k = 1 := by
  have hchoose : ((Nat.choose s.card k : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hk).ne'
  rw [Finset.sum_const, nsmul_eq_mul, Finset.card_powersetCard]
  field_simp

/-- Neighbor set of a finite arithmetic replacement relation. -/
def finiteReplacementNeighbors
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj] (i : ι) : Finset ι :=
  Finset.univ.filter (adj i)

/-- Union of all replacement neighborhoods met by a finite source set. -/
def finiteReplacementNeighborUnion
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (adj : ι → ι → Prop) [DecidableRel adj]
    (s : Finset ι) : Finset ι :=
  s.biUnion (finiteReplacementNeighbors adj)

/-- Flow leaving a finite source set is bounded by total capacity in its arithmetic neighbor
union.  This is the weighted Hall-cut obstruction behind every local fractional transport. -/
theorem sum_conductance_le_neighborUnionCapacity
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (adj : ι → ι → Prop) [DecidableRel adj]
    (weight : ι → ℝ) (c : ι → ι → ℝ) (s : Finset ι)
    (hc_nonneg : ∀ i j, 0 ≤ c i j)
    (hc_symm : ∀ i j, c i j = c j i)
    (hc_support : ∀ i j, c i j ≠ 0 → adj i j)
    (hc_capacity : ∀ i, ∑ j, c i j ≤ weight i) :
    ∑ i ∈ s, ∑ j, c i j ≤
      ∑ j ∈ finiteReplacementNeighborUnion adj s, weight j := by
  classical
  let t := finiteReplacementNeighborUnion adj s
  calc
    (∑ i ∈ s, ∑ j, c i j) = ∑ j, ∑ i ∈ s, c i j := by
      rw [Finset.sum_comm]
    _ = ∑ j ∈ t, ∑ i ∈ s, c i j := by
      exact (Fintype.sum_subset (s := t) (fun j hj => by
        by_contra hjt
        have hz : ∀ i ∈ s, c i j = 0 := by
          intro i hi
          by_contra hcij
          apply hjt
          change j ∈ finiteReplacementNeighborUnion adj s
          rw [finiteReplacementNeighborUnion, Finset.mem_biUnion]
          exact ⟨i, hi, by
            rw [finiteReplacementNeighbors, Finset.mem_filter]
            exact ⟨Finset.mem_univ _, hc_support i j hcij⟩⟩
        exact hj (Finset.sum_eq_zero hz))).symm
    _ = ∑ j ∈ t, ∑ i ∈ s, c j i := by
      apply Finset.sum_congr rfl
      intro j _hj
      apply Finset.sum_congr rfl
      intro i _hi
      exact hc_symm i j
    _ ≤ ∑ j ∈ t, ∑ i, c j i := by
      apply Finset.sum_le_sum
      intro j _hj
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ s)
        (fun i _hi _his => hc_nonneg j i)
    _ ≤ ∑ j ∈ t, weight j := by
      exact Finset.sum_le_sum fun j _hj => hc_capacity j

/-- Every local fractional flow pays every weighted Hall-cut deficiency.  In particular, proving a
small global unused-capacity bound requires a uniform bound for all source subsets, not merely
non-isolation or singleton row supply. -/
theorem replacementNeighborCutDeficiency_le_unusedConductance
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (adj : ι → ι → Prop) [DecidableRel adj]
    (weight : ι → ℝ) (c : ι → ι → ℝ) (s : Finset ι)
    (hc_nonneg : ∀ i j, 0 ≤ c i j)
    (hc_symm : ∀ i j, c i j = c j i)
    (hc_support : ∀ i j, c i j ≠ 0 → adj i j)
    (hc_capacity : ∀ i, ∑ j, c i j ≤ weight i) :
    (∑ i ∈ s, weight i) -
        (∑ j ∈ finiteReplacementNeighborUnion adj s, weight j) ≤
      ∑ i, (weight i - ∑ j, c i j) := by
  have hflow := sum_conductance_le_neighborUnionCapacity
    adj weight c s hc_nonneg hc_symm hc_support hc_capacity
  calc
    (∑ i ∈ s, weight i) -
        (∑ j ∈ finiteReplacementNeighborUnion adj s, weight j) ≤
        (∑ i ∈ s, weight i) - ∑ i ∈ s, ∑ j, c i j :=
      sub_le_sub_left hflow _
    _ = ∑ i ∈ s, (weight i - ∑ j, c i j) := by
      rw [Finset.sum_sub_distrib]
    _ ≤ ∑ i, (weight i - ∑ j, c i j) := by
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ s)
        (fun i _hi _his => sub_nonneg.mpr (hc_capacity i))

/-- Simple degree in the finite replacement graph. -/
def finiteReplacementDegree
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj] (i : ι) : ℕ :=
  (finiteReplacementNeighbors adj i).card

/-- Vertex weight divided by simple degree, and zero at isolated vertices. -/
def finiteDegreeNormalizedWeight
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (weight : ι → ℝ) (i : ι) : ℝ :=
  if finiteReplacementDegree adj i = 0 then 0 else weight i / finiteReplacementDegree adj i

/-- Full vertex weight retained precisely at isolated vertices. -/
def finiteIsolatedResidual
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (weight : ι → ℝ) (i : ι) : ℝ :=
  if finiteReplacementDegree adj i = 0 then weight i else 0

theorem weight_eq_isolatedResidual_add_sum_degreeNormalizedWeight
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (weight : ι → ℝ) (i : ι) :
    weight i = finiteIsolatedResidual adj weight i +
      ∑ _j ∈ finiteReplacementNeighbors adj i, finiteDegreeNormalizedWeight adj weight i := by
  classical
  by_cases hdegree : finiteReplacementDegree adj i = 0
  · have hneighbors : finiteReplacementNeighbors adj i = ∅ :=
      Finset.card_eq_zero.mp hdegree
    simp [finiteIsolatedResidual, finiteDegreeNormalizedWeight, hdegree, hneighbors]
  · have hcast : ((finiteReplacementDegree adj i : ℕ) : ℝ) ≠ 0 := by
      exact_mod_cast hdegree
    rw [finiteIsolatedResidual, if_neg hdegree,
      finiteDegreeNormalizedWeight, if_neg hdegree, zero_add]
    simp only [Finset.sum_const, nsmul_eq_mul]
    rw [show (finiteReplacementNeighbors adj i).card = finiteReplacementDegree adj i by rfl]
    field_simp

/-- Canonical symmetric conductance obtained by taking the smaller normalized endpoint weight on
each replacement edge. -/
def symmetricMinConductance
    {ι : Type*} (adj : ι → ι → Prop) [DecidableRel adj] (a : ι → ℝ) (i j : ι) : ℝ :=
  if adj i j then min (a i) (a j) else 0

theorem symmetricMinConductance_nonneg
    {ι : Type*} (adj : ι → ι → Prop) [DecidableRel adj] (a : ι → ℝ)
    (ha : ∀ i, 0 ≤ a i) (i j : ι) :
    0 ≤ symmetricMinConductance adj a i j := by
  rw [symmetricMinConductance]
  split_ifs
  · exact le_min (ha i) (ha j)
  · exact le_rfl

theorem symmetricMinConductance_symm
    {ι : Type*} (adj : ι → ι → Prop) [DecidableRel adj] (a : ι → ℝ)
    (hadj_symm : ∀ {i j}, adj i j → adj j i) (i j : ι) :
    symmetricMinConductance adj a i j = symmetricMinConductance adj a j i := by
  by_cases hij : adj i j
  · rw [symmetricMinConductance, if_pos hij,
      symmetricMinConductance, if_pos (hadj_symm hij), min_comm]
  · have hji : ¬adj j i := fun h => hij (hadj_symm h)
    rw [symmetricMinConductance, if_neg hij,
      symmetricMinConductance, if_neg hji]

theorem sum_symmetricMinConductance_eq_sum_neighbors
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (a : ι → ℝ) (i : ι) :
    ∑ j, symmetricMinConductance adj a i j =
      ∑ j ∈ finiteReplacementNeighbors adj i, min (a i) (a j) := by
  rw [finiteReplacementNeighbors, Finset.sum_filter]
  rfl

/-- Exact unused-capacity identity for the canonical minimum-endpoint conductance, expressed as
residual capacity plus directed normalized-weight variation. -/
theorem sum_unused_symmetricMinConductance_eq_residual_add_directedDefect
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (weight residual a : ι → ℝ)
    (hnormalize : ∀ i,
      weight i = residual i + ∑ _j ∈ finiteReplacementNeighbors adj i, a i) :
    (∑ i, (weight i - ∑ j, symmetricMinConductance adj a i j)) =
      (∑ i, residual i) +
        ∑ i, ∑ j ∈ finiteReplacementNeighbors adj i,
          (a i - min (a i) (a j)) := by
  classical
  calc
    (∑ i, (weight i - ∑ j, symmetricMinConductance adj a i j)) =
        ∑ i, (residual i +
          ∑ j ∈ finiteReplacementNeighbors adj i, (a i - min (a i) (a j))) := by
      apply Finset.sum_congr rfl
      intro i _hi
      rw [hnormalize i, sum_symmetricMinConductance_eq_sum_neighbors adj a i]
      rw [Finset.sum_sub_distrib]
      ring
    _ = (∑ i, residual i) +
          ∑ i, ∑ j ∈ finiteReplacementNeighbors adj i,
            (a i - min (a i) (a j)) := by
      rw [Finset.sum_add_distrib]

/-- Canonical fractional-flow reduction.  `residual` accounts for isolated or deliberately
discarded capacity; normalized endpoint weights `a` account for all remaining capacity.  The
signed mass is bounded by residual capacity plus directed normalized-weight variation on explicit
parity-flipping replacement edges. -/
theorem abs_sum_sign_weight_le_symmetricMinConductanceDefect
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (sign weight residual a : ι → ℝ)
    (hsign : ∀ i, |sign i| = 1)
    (hadj_symm : ∀ {i j}, adj i j → adj j i)
    (hadj_flip : ∀ {i j}, adj i j → sign i + sign j = 0)
    (hresidual : ∀ i, 0 ≤ residual i)
    (hnormalize : ∀ i,
      weight i = residual i + ∑ _j ∈ finiteReplacementNeighbors adj i, a i) :
    |∑ i, sign i * weight i| ≤
      (∑ i, residual i) +
        ∑ i, ∑ j ∈ finiteReplacementNeighbors adj i,
          (a i - min (a i) (a j)) := by
  classical
  let c : ι → ι → ℝ := symmetricMinConductance adj a
  have hc_symm : ∀ i j, c i j = c j i := by
    intro i j
    exact symmetricMinConductance_symm adj a hadj_symm i j
  have hc_flip : ∀ i j, c i j ≠ 0 → sign i + sign j = 0 := by
    intro i j hc
    apply hadj_flip
    by_contra hij
    exact hc (by simp [c, symmetricMinConductance, hij])
  have hc_capacity : ∀ i, ∑ j, c i j ≤ weight i := by
    intro i
    rw [show (∑ j, c i j) =
      ∑ j ∈ finiteReplacementNeighbors adj i, min (a i) (a j) by
        exact sum_symmetricMinConductance_eq_sum_neighbors adj a i]
    calc
      (∑ j ∈ finiteReplacementNeighbors adj i, min (a i) (a j)) ≤
          ∑ j ∈ finiteReplacementNeighbors adj i, a i :=
        Finset.sum_le_sum fun _j _hj => min_le_left _ _
      _ ≤ weight i := by rw [hnormalize i]; linarith [hresidual i]
  have hconsumer :=
    abs_sum_sign_weight_le_unusedConductance sign weight c hsign hc_symm hc_flip hc_capacity
  calc
    |∑ i, sign i * weight i| ≤ ∑ i, (weight i - ∑ j, c i j) := hconsumer
    _ = ∑ i, (residual i +
          ∑ j ∈ finiteReplacementNeighbors adj i, (a i - min (a i) (a j))) := by
      apply Finset.sum_congr rfl
      intro i _hi
      rw [hnormalize i,
        show (∑ j, c i j) =
          ∑ j ∈ finiteReplacementNeighbors adj i, min (a i) (a j) by
            exact sum_symmetricMinConductance_eq_sum_neighbors adj a i]
      rw [Finset.sum_sub_distrib]
      ring
    _ = (∑ i, residual i) +
          ∑ i, ∑ j ∈ finiteReplacementNeighbors adj i,
            (a i - min (a i) (a j)) := by
      rw [Finset.sum_add_distrib]

/-- Fully canonical degree-normalized specialization: isolated weight plus directed variation of
`weight / degree` bounds every finite signed source carried by an explicit symmetric
parity-flipping replacement graph. -/
theorem abs_sum_sign_weight_le_degreeNormalizedReplacementDefect
    {ι : Type*} [Fintype ι] (adj : ι → ι → Prop) [DecidableRel adj]
    (sign weight : ι → ℝ)
    (hsign : ∀ i, |sign i| = 1)
    (hweight : ∀ i, 0 ≤ weight i)
    (hadj_symm : ∀ {i j}, adj i j → adj j i)
    (hadj_flip : ∀ {i j}, adj i j → sign i + sign j = 0) :
    |∑ i, sign i * weight i| ≤
      (∑ i, finiteIsolatedResidual adj weight i) +
        ∑ i, ∑ j ∈ finiteReplacementNeighbors adj i,
          (finiteDegreeNormalizedWeight adj weight i -
            min (finiteDegreeNormalizedWeight adj weight i)
              (finiteDegreeNormalizedWeight adj weight j)) := by
  apply abs_sum_sign_weight_le_symmetricMinConductanceDefect
    adj sign weight (finiteIsolatedResidual adj weight)
      (finiteDegreeNormalizedWeight adj weight) hsign hadj_symm hadj_flip
  · intro i
    rw [finiteIsolatedResidual]
    split_ifs
    · exact hweight i
    · exact le_rfl
  · exact weight_eq_isolatedResidual_add_sum_degreeNormalizedWeight adj weight

/-- Concrete Route E consumer on the literal Möbius vertices through `z^2`.  Its right side is the
canonical positive defect of the two explicit bounded-prime factor-replacement edge families; no
arithmetic expansion estimate is assumed in the theorem. -/
theorem abs_truncatedMobiusLaplace_le_degreeNormalizedFactorReplacementDefect
    (z : ℕ) (x : ℝ) :
    |∑ n : MobiusBoundaryFactorReplacementVertex z,
        mobiusBoundaryRealSign n * mobiusBoundaryFiniteGibbsWeight x n| ≤
      (∑ n : MobiusBoundaryFactorReplacementVertex z,
        finiteIsolatedResidual (mobiusBoundaryFactorReplacementAdjacentOn z)
          (fun m => mobiusBoundaryFiniteGibbsWeight x m) n) +
        ∑ n : MobiusBoundaryFactorReplacementVertex z,
          ∑ m ∈ finiteReplacementNeighbors
              (mobiusBoundaryFactorReplacementAdjacentOn z) n,
            (finiteDegreeNormalizedWeight (mobiusBoundaryFactorReplacementAdjacentOn z)
                (fun k => mobiusBoundaryFiniteGibbsWeight x k) n -
              min
                (finiteDegreeNormalizedWeight (mobiusBoundaryFactorReplacementAdjacentOn z)
                  (fun k => mobiusBoundaryFiniteGibbsWeight x k) n)
                (finiteDegreeNormalizedWeight (mobiusBoundaryFactorReplacementAdjacentOn z)
                  (fun k => mobiusBoundaryFiniteGibbsWeight x k) m)) := by
  classical
  apply abs_sum_sign_weight_le_degreeNormalizedReplacementDefect
    (mobiusBoundaryFactorReplacementAdjacentOn z)
    (fun n : MobiusBoundaryFactorReplacementVertex z => mobiusBoundaryRealSign n)
    (fun n : MobiusBoundaryFactorReplacementVertex z => mobiusBoundaryFiniteGibbsWeight x n)
  · intro n
    exact abs_mobiusBoundaryRealSign_eq_one_of_mem_vertices n.property
  · intro n
    exact (Real.exp_pos _).le
  · intro m n h
    exact mobiusBoundaryFactorReplacementAdjacent_symm h
  · intro m n h
    exact mobiusBoundaryRealSign_add_eq_zero_of_factorReplacementAdjacent h

/-- Value-local concrete Route E consumer.  This is the canonical defect on replacement edges of
integer displacement at most `H`; it is the direct finite target for short-interval incidence
estimates. -/
theorem abs_truncatedMobiusLaplace_le_degreeNormalizedWindowedFactorReplacementDefect
    (z H : ℕ) (x : ℝ) :
    |∑ n : MobiusBoundaryFactorReplacementVertex z,
        mobiusBoundaryRealSign n * mobiusBoundaryFiniteGibbsWeight x n| ≤
      (∑ n : MobiusBoundaryFactorReplacementVertex z,
        finiteIsolatedResidual (mobiusBoundaryFactorReplacementWindowAdjacentOn z H)
          (fun m => mobiusBoundaryFiniteGibbsWeight x m) n) +
        ∑ n : MobiusBoundaryFactorReplacementVertex z,
          ∑ m ∈ finiteReplacementNeighbors
              (mobiusBoundaryFactorReplacementWindowAdjacentOn z H) n,
            (finiteDegreeNormalizedWeight
                (mobiusBoundaryFactorReplacementWindowAdjacentOn z H)
                (fun k => mobiusBoundaryFiniteGibbsWeight x k) n -
              min
                (finiteDegreeNormalizedWeight
                  (mobiusBoundaryFactorReplacementWindowAdjacentOn z H)
                  (fun k => mobiusBoundaryFiniteGibbsWeight x k) n)
                (finiteDegreeNormalizedWeight
                  (mobiusBoundaryFactorReplacementWindowAdjacentOn z H)
                  (fun k => mobiusBoundaryFiniteGibbsWeight x k) m)) := by
  classical
  apply abs_sum_sign_weight_le_degreeNormalizedReplacementDefect
    (mobiusBoundaryFactorReplacementWindowAdjacentOn z H)
    (fun n : MobiusBoundaryFactorReplacementVertex z => mobiusBoundaryRealSign n)
    (fun n : MobiusBoundaryFactorReplacementVertex z => mobiusBoundaryFiniteGibbsWeight x n)
  · intro n
    exact abs_mobiusBoundaryRealSign_eq_one_of_mem_vertices n.property
  · intro n
    exact (Real.exp_pos _).le
  · intro m n h
    exact mobiusBoundaryFactorReplacementWindowAdjacent_symm h
  · intro m n h
    exact mobiusBoundaryRealSign_add_eq_zero_of_factorReplacementAdjacent h.1

end

