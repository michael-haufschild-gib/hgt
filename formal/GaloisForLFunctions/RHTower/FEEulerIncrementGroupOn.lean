import GaloisForLFunctions.RHTower.EulerIncrementGroupOn
import GaloisForLFunctions.RHTower.QuadrantConvexSchwarzCompleteness

/-!
# The functional-equation-paired Euler-unit gauge group is dense on a quadrant domain

Pairing a degree-one Euler unit with its functional-equation reflection and keeping the parameter
real gives the increment `Δ^{FE}_{p,b}(s) = Δ_{p,b}(s) - Δ_{p,b}(1-s)`, whose repetition limit is
`r · u_p`.  Real-span completeness of the symmetrised tangents therefore makes the additive group
generated by these paired increments dense in the holomorphic functions of the domain.

* `RHTower.feEulerIncrementOn`;
* `RHTower.topologicalClosure_feEulerIncrementGroup_eq_top`.
-/

noncomputable section

open Complex Set Filter Topology

namespace RHTower

open GaloisForLFunctions.HTGeometry
open _root_.HTGeometry

section FEIncrement

variable {D : Set ℂ} {α : ℝ}

/-- The functional-equation-paired increment of a degree-one Euler unit. -/
def feEulerIncrementFun (p : ℕ) (b s : ℂ) : ℂ :=
  eulerIncrementFun p b s - eulerIncrementFun p b (1 - s)

theorem differentiableOn_feEulerIncrementFun {p : ℕ} (hp : p.Prime) {b : ℂ}
    (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α)
    (hb : (1 + ‖b‖) * (p : ℝ) ^ (-α) < 1) :
    DifferentiableOn ℂ (feEulerIncrementFun p b) D := by
  have hbase : DifferentiableOn ℂ (eulerIncrementFun p b) {s : ℂ | α ≤ s.re} :=
    differentiableOn_eulerIncrementFun hp (fun s hs => hs) hb
  have hsub : D ⊆ {s : ℂ | α ≤ s.re} := fun s hs => (hD s hs).1
  have hmaps : Set.MapsTo (fun s : ℂ => 1 - s) D {s : ℂ | α ≤ s.re} := by
    intro s hs
    have h := (hD s hs).2
    simp only [Set.mem_setOf_eq, Complex.sub_re, Complex.one_re]
    linarith
  exact (hbase.mono hsub).sub
    (hbase.comp ((differentiableOn_const (1 : ℂ)).sub differentiableOn_id) hmaps)

/-- The paired increment as an element of the holomorphic space of the domain. -/
def feEulerIncrementOn (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) {p : Nat.Primes} {b : ℂ}
    (hb : IncrementAdmissible (p : ℕ) α b) : holoOn D :=
  ⟨⟨fun z => feEulerIncrementFun (p : ℕ) b (z : ℂ),
      ((differentiableOn_feEulerIncrementFun p.2 hD hb).continuousOn).restrict⟩,
    ⟨feEulerIncrementFun (p : ℕ) b, differentiableOn_feEulerIncrementFun p.2 hD hb, fun _ => rfl⟩⟩

/-- The set of all functional-equation-paired real-parameter increments. -/
def feEulerIncrementSet (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) : Set (holoOn D) :=
  {g | ∃ (p : Nat.Primes) (b : ℝ) (hb : IncrementAdmissible (p : ℕ) α ((b : ℂ))),
    g = feEulerIncrementOn hD hb}

/-- The additive group generated by the paired real-parameter increments. -/
def feEulerIncrementGroup (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) : AddSubgroup (holoOn D) :=
  AddSubgroup.closure (feEulerIncrementSet hD)

theorem norm_nsmul_feEulerIncrement_sub_le {p : ℕ} (hp : p.Prime) (hα : 0 < α)
    (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) {c : ℂ} {Nr : ℝ} (hNr : 0 < Nr)
    (hhalf : ‖c‖ / Nr * (p : ℝ) ^ (-α) ≤ (1 - (p : ℝ) ^ (-α)) / 2)
    {z : ℂ} (hz : z ∈ D) :
    ‖(Nr : ℂ) * feEulerIncrementFun p (c / (Nr : ℂ)) z - c * feEulerTangent p z‖
      ≤ 2 * ((2 * Real.log p * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2
        / (1 - (p : ℝ) ^ (-α)) ^ 3) / Nr) := by
  have hbase : ∀ s : ℂ, α ≤ s.re →
      ‖(Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) s - c * eulerTangent p s‖
        ≤ (2 * Real.log p * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2
            / (1 - (p : ℝ) ^ (-α)) ^ 3) / Nr := by
    intro s hs
    exact norm_nsmul_eulerIncrement_sub_le (D := {s : ℂ | α ≤ s.re}) hp hα
      (fun w hw => hw) hNr hhalf hs
  have h1 := hbase z (hD z hz).1
  have h2 : α ≤ (1 - z).re := by
    have h := (hD z hz).2
    simp only [Complex.sub_re, Complex.one_re]
    linarith
  have h3 := hbase (1 - z) h2
  have hsplit : (Nr : ℂ) * feEulerIncrementFun p (c / (Nr : ℂ)) z - c * feEulerTangent p z
      = ((Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) z - c * eulerTangent p z)
        - ((Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) (1 - z) - c * eulerTangent p (1 - z)) := by
    rw [feEulerIncrementFun, feEulerTangent]
    ring
  rw [hsplit]
  calc ‖((Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) z - c * eulerTangent p z)
        - ((Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) (1 - z) - c * eulerTangent p (1 - z))‖
      ≤ ‖(Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) z - c * eulerTangent p z‖
        + ‖(Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) (1 - z) - c * eulerTangent p (1 - z)‖ :=
        norm_sub_le _ _
    _ ≤ 2 * ((2 * Real.log p * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2
        / (1 - (p : ℝ) ^ (-α)) ^ 3) / Nr) := by linarith

/-- **The paired repetition limit.**  Every real multiple of a symmetrised Euler tangent lies in the
closure of the additive group generated by the paired real-parameter increments. -/
theorem rmulFeEulerTangentOn_mem_closure
    (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) (hα : 0 < α)
    (hDQ : D ⊆ criticalQuadrant) (p : Nat.Primes) (r : ℝ) :
    r • feEulerTangentOn D (hDQ.trans criticalQuadrant_subset_rightCriticalStrip) p
      ∈ (feEulerIncrementGroup hD).topologicalClosure := by
  classical
  have hrho0 : 0 < ((p : ℕ) : ℝ) ^ (-α) := rho_pos p.2 α
  have hrho1 : ((p : ℕ) : ℝ) ^ (-α) < 1 := rho_lt_one p.2 hα
  obtain ⟨N₁, hN₁⟩ := exists_nat_ge (2 * |r| * ((p : ℕ) : ℝ) ^ (-α) / (1 - ((p : ℕ) : ℝ) ^ (-α)))
  set N₀ : ℕ := N₁ + 1 with hN₀def
  have hNr : ∀ n : ℕ, (1 : ℝ) ≤ ((n + N₀ : ℕ) : ℝ) := by
    intro n
    have h : (1 : ℕ) ≤ n + N₀ := by omega
    exact_mod_cast h
  have hNrpos : ∀ n : ℕ, (0 : ℝ) < ((n + N₀ : ℕ) : ℝ) := fun n => lt_of_lt_of_le one_pos (hNr n)
  have hcnorm : ‖((r : ℂ))‖ = |r| := by
    rw [Complex.norm_real, Real.norm_eq_abs]
  have hNrbig : ∀ n : ℕ,
      2 * |r| * ((p : ℕ) : ℝ) ^ (-α) / (1 - ((p : ℕ) : ℝ) ^ (-α)) ≤ ((n + N₀ : ℕ) : ℝ) := by
    intro n
    have h : ((N₁ : ℕ) : ℝ) ≤ ((n + N₀ : ℕ) : ℝ) := by
      rw [hN₀def]
      push_cast
      linarith [Nat.cast_nonneg (α := ℝ) n]
    linarith
  have hhalf : ∀ n : ℕ, ‖((r : ℂ))‖ / ((n + N₀ : ℕ) : ℝ) * ((p : ℕ) : ℝ) ^ (-α)
      ≤ (1 - ((p : ℕ) : ℝ) ^ (-α)) / 2 := by
    intro n
    rw [hcnorm]
    have hNp := hNrpos n
    have h := hNrbig n
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 1 - ((p : ℕ) : ℝ) ^ (-α))] at h
    rw [div_mul_eq_mul_div, div_le_iff₀ hNp]
    nlinarith
  have hcast : ∀ n : ℕ, (((r / ((n + N₀ : ℕ) : ℝ) : ℝ)) : ℂ)
      = (r : ℂ) / ((((n + N₀ : ℕ) : ℝ)) : ℂ) := by
    intro n
    push_cast
    ring
  have hadm : ∀ n : ℕ,
      IncrementAdmissible (p : ℕ) α (((r / ((n + N₀ : ℕ) : ℝ) : ℝ)) : ℂ) := by
    intro n
    rw [IncrementAdmissible, hcast n]
    have hnorm : ‖(r : ℂ) / ((((n + N₀ : ℕ) : ℝ)) : ℂ)‖ = ‖((r : ℂ))‖ / ((n + N₀ : ℕ) : ℝ) := by
      rw [norm_div]
      congr 1
      rw [Complex.norm_real, Real.norm_of_nonneg (hNrpos n).le]
    rw [hnorm]
    nlinarith [hhalf n]
  set g : ℕ → holoOn D := fun n => (n + N₀) • feEulerIncrementOn hD (hadm n) with hg
  have hgmem : ∀ n : ℕ, g n ∈ feEulerIncrementGroup hD := by
    intro n
    refine AddSubgroup.nsmul_mem _ (AddSubgroup.subset_closure ?_) _
    exact ⟨p, r / ((n + N₀ : ℕ) : ℝ), hadm n, rfl⟩
  set B : ℝ := 2 * (2 * Real.log ((p : ℕ) : ℝ) * ‖((r : ℂ))‖ ^ 2 * (((p : ℕ) : ℝ) ^ (-α)) ^ 2
    / (1 - ((p : ℕ) : ℝ) ^ (-α)) ^ 3) with hB
  have htend' : Filter.Tendsto (fun n : ℕ => ((g n : holoOn D) : C((D : Set ℂ), ℂ)))
      Filter.atTop (nhds (((r • feEulerTangentOn D
        (hDQ.trans criticalQuadrant_subset_rightCriticalStrip) p : holoOn D) :
        C((D : Set ℂ), ℂ)))) := by
    rw [← tendsto_sub_nhds_zero_iff]
    rw [(hasBasis_nhds_zero_continuousMap (X := (D : Set ℂ))).tendsto_right_iff]
    rintro ⟨Kc, ε⟩ ⟨-, hε⟩
    have hBlim : Filter.Tendsto (fun n : ℕ => B / ((n + N₀ : ℕ) : ℝ)) Filter.atTop (nhds 0) := by
      have hcast2 : Filter.Tendsto (fun n : ℕ => ((n + N₀ : ℕ) : ℝ)) Filter.atTop Filter.atTop := by
        refine Filter.tendsto_atTop_mono (fun n => ?_) tendsto_natCast_atTop_atTop
        push_cast
        linarith [Nat.cast_nonneg (α := ℝ) N₀]
      exact Filter.Tendsto.const_div_atTop hcast2 B
    have hev := hBlim.eventually (eventually_lt_nhds hε)
    filter_upwards [hev] with n hn
    intro x _
    have hval : ((g n : C((D : Set ℂ), ℂ))
          - ((r • feEulerTangentOn D
              (hDQ.trans criticalQuadrant_subset_rightCriticalStrip) p : holoOn D) :
            C((D : Set ℂ), ℂ))) x
        = ((((n + N₀ : ℕ) : ℝ)) : ℂ) * feEulerIncrementFun (p : ℕ)
            ((r : ℂ) / ((((n + N₀ : ℕ) : ℝ)) : ℂ)) (x : ℂ)
          - (r : ℂ) * feEulerTangent (p : ℕ) (x : ℂ) := by
      simp only [ContinuousMap.sub_apply, hg]
      rw [← hcast n]
      norm_num [feEulerIncrementOn, feEulerTangentOn, feEulerTangentMapOn, Complex.real_smul]
    rw [hval]
    refine lt_of_le_of_lt ?_ hn
    have hbnd := norm_nsmul_feEulerIncrement_sub_le p.2 hα hD (hNrpos n) (hhalf n) x.2
    rw [hB]
    calc ‖((((n + N₀ : ℕ) : ℝ)) : ℂ) * feEulerIncrementFun (p : ℕ)
            ((r : ℂ) / ((((n + N₀ : ℕ) : ℝ)) : ℂ)) (x : ℂ)
          - (r : ℂ) * feEulerTangent (p : ℕ) (x : ℂ)‖
        ≤ 2 * ((2 * Real.log ((p : ℕ) : ℝ) * ‖((r : ℂ))‖ ^ 2 * (((p : ℕ) : ℝ) ^ (-α)) ^ 2
            / (1 - ((p : ℕ) : ℝ) ^ (-α)) ^ 3) / ((n + N₀ : ℕ) : ℝ)) := hbnd
      _ = 2 * (2 * Real.log ((p : ℕ) : ℝ) * ‖((r : ℂ))‖ ^ 2 * (((p : ℕ) : ℝ) ^ (-α)) ^ 2
            / (1 - ((p : ℕ) : ℝ) ^ (-α)) ^ 3) / ((n + N₀ : ℕ) : ℝ) := by ring
  have htend : Filter.Tendsto g Filter.atTop
      (nhds (r • feEulerTangentOn D
        (hDQ.trans criticalQuadrant_subset_rightCriticalStrip) p)) :=
    tendsto_subtype_rng.mpr htend'
  exact (feEulerIncrementGroup hD).isClosed_topologicalClosure.mem_of_tendsto htend
    (Filter.Eventually.of_forall fun n =>
      (feEulerIncrementGroup hD).le_topologicalClosure (hgmem n))

/-- **The functional-equation-paired real-parameter Euler-unit gauge group is dense.** -/
theorem topologicalClosure_feEulerIncrementGroup_eq_top
    (hDopen : IsOpen D) (hDconv : Convex ℝ D) (hα : 0 < α)
    (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) (hDQ : D ⊆ criticalQuadrant) :
    (feEulerIncrementGroup hD).topologicalClosure = ⊤ := by
  classical
  set hstrip := hDQ.trans criticalQuadrant_subset_rightCriticalStrip with hstripdef
  have hspan : ((Submodule.span ℝ (Set.range fun q : {p : Nat.Primes // p ∉ (∅ : Finset Nat.Primes)}
      => feEulerTangentOn D hstrip (q : Nat.Primes)) : Submodule ℝ (holoOn D)) : Set (holoOn D))
      ⊆ (((feEulerIncrementGroup hD).topologicalClosure : AddSubgroup (holoOn D)) :
        Set (holoOn D)) := by
    intro x hx
    obtain ⟨n, f, gg, hsum⟩ := Submodule.mem_span_set'.mp hx
    rw [← hsum]
    refine AddSubgroup.sum_mem _ fun i _ => ?_
    obtain ⟨q, hq⟩ := (gg i).2
    rw [show ((gg i : holoOn D)) = feEulerTangentOn D hstrip (q : Nat.Primes) from hq.symm]
    exact rmulFeEulerTangentOn_mem_closure hD hα hDQ (q : Nat.Primes) (f i)
  have htop := topologicalClosure_realSpan_feEulerTangentOn_eq_top hDopen hDconv hDQ ∅
  have hcl : closure ((Submodule.span ℝ (Set.range
      fun q : {p : Nat.Primes // p ∉ (∅ : Finset Nat.Primes)} =>
        feEulerTangentOn D hstrip (q : Nat.Primes)) :
      Submodule ℝ (holoOn D)) : Set (holoOn D)) = Set.univ := by
    have hcoe := Submodule.topologicalClosure_coe (Submodule.span ℝ (Set.range
      fun q : {p : Nat.Primes // p ∉ (∅ : Finset Nat.Primes)} =>
        feEulerTangentOn D hstrip (q : Nat.Primes)))
    rw [← hcoe, htop]
    rfl
  have hsub : closure ((Submodule.span ℝ (Set.range
      fun q : {p : Nat.Primes // p ∉ (∅ : Finset Nat.Primes)} =>
        feEulerTangentOn D hstrip (q : Nat.Primes)) :
      Submodule ℝ (holoOn D)) : Set (holoOn D))
      ⊆ (((feEulerIncrementGroup hD).topologicalClosure : AddSubgroup (holoOn D)) :
        Set (holoOn D)) :=
    ((feEulerIncrementGroup hD).isClosed_topologicalClosure).closure_subset_iff.mpr hspan
  refine SetLike.ext' (Set.eq_univ_of_univ_subset ?_)
  rw [← hcl]
  exact hsub

/-- **Every continuous invariant of the paired gauge action is constant.** -/
theorem feEulerIncrementGroup_invariant_eq_const {X : Type*} [TopologicalSpace X] [T2Space X]
    (hDopen : IsOpen D) (hDconv : Convex ℝ D) (hα : 0 < α)
    (hD : ∀ s ∈ D, α ≤ s.re ∧ s.re ≤ 1 - α) (hDQ : D ⊆ criticalQuadrant)
    (F : holoOn D → X) (hF : Continuous F)
    (hinv : ∀ g ∈ feEulerIncrementGroup hD, ∀ x : holoOn D, F (g + x) = F x)
    (x y : holoOn D) : F x = F y :=
  eq_of_addSubgroup_translation_invariant_of_dense
    (topologicalClosure_feEulerIncrementGroup_eq_top hDopen hDconv hα hD hDQ) F hF hinv x y

end FEIncrement

end RHTower
