import GaloisForLFunctions.RHTower.SuzukiLatticeAdjacencyOperator
import Mathlib.Analysis.CStarAlgebra.Exponential

/-!
# Self-adjointness of the lattice adjacency, and unitarity of its evolution

The adjoint of a lattice translation is the opposite translation, so a finite real combination over
a symmetric step set is self-adjoint.  Multiplying by `i` lands in the skew-adjoint part, and the
`C*`-exponential of a skew-adjoint element is unitary — which is the only property of the evolution
the polynomial-group estimate uses.
-/

open Finset Complex

noncomputable section

namespace RHTower

variable {P : Type*} [Fintype P] [DecidableEq P]

local notation "H" => lp (fun _ : (P → ℤ) => ℂ) 2

omit [Fintype P] [DecidableEq P] in
/-- The inverse of a lattice translation is the opposite translation. -/
theorem latticeShift_symm (q : P → ℤ) :
    (GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q).symm
      = GaloisForLFunctions.HTGeometry.latticeShift (-q) := by
  ext ψ ν
  have h1 : ((GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q).symm ψ
      : (P → ℤ) → ℂ) ν
      = ((GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q)
          ((GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q).symm ψ)
          : (P → ℤ) → ℂ) (ν - q) := by
    rw [GaloisForLFunctions.HTGeometry.latticeShift_apply, sub_add_cancel]
  rw [h1, LinearIsometryEquiv.apply_symm_apply,
    GaloisForLFunctions.HTGeometry.latticeShift_apply, sub_eq_add_neg]

omit [Fintype P] [DecidableEq P] in
/-- The adjoint of a lattice translation is the opposite translation. -/
theorem adjoint_latticeShiftCLM (q : P → ℤ) :
    ContinuousLinearMap.adjoint (latticeShiftCLM (P := P) q) = latticeShiftCLM (-q) := by
  have h := LinearIsometryEquiv.adjoint_eq_symm
    (GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q)
  rw [latticeShiftCLM, latticeShiftCLM]
  rw [show ((GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q).toLinearIsometry.toContinuousLinearMap)
      = ((GaloisForLFunctions.HTGeometry.latticeShift (G := P → ℤ) q) :
          lp (fun _ : (P → ℤ) => ℂ) 2 →L[ℂ] lp (fun _ : (P → ℤ) => ℂ) 2) from rfl, h,
    latticeShift_symm]
  rfl

omit [Fintype P] [DecidableEq P] in
/-- A symmetric finite step set with real symmetric couplings gives a self-adjoint adjacency. -/
theorem isSelfAdjoint_latticeAdjacency {Q : Finset (P → ℤ)} {c : (P → ℤ) → ℂ}
    (hQ : ∀ q ∈ Q, -q ∈ Q)
    (hc : ∀ q ∈ Q, (starRingEnd ℂ) (c q) = c (-q)) :
    IsSelfAdjoint (latticeAdjacency Q c) := by
  rw [IsSelfAdjoint, ContinuousLinearMap.star_eq_adjoint, latticeAdjacency, map_sum]
  have hterm : ∀ q ∈ Q,
      ContinuousLinearMap.adjoint (c q • latticeShiftCLM (P := P) q)
        = c (-q) • latticeShiftCLM (P := P) (-q) := by
    intro q hq
    rw [map_smulₛₗ ContinuousLinearMap.adjoint, adjoint_latticeShiftCLM, hc q hq]
  rw [Finset.sum_congr rfl hterm]
  refine Finset.sum_nbij' (fun q => -q) (fun q => -q) ?_ ?_ ?_ ?_ ?_
  · intro q hq
    exact hQ q hq
  · intro q hq
    exact hQ q hq
  · intro q _
    simp
  · intro q _
    simp
  · intro q _
    simp

omit [Fintype P] [DecidableEq P] in
/-- **The evolution generated by the adjacency is unitary.** -/
theorem exp_latticeAdjacency_mem_unitary {Q : Finset (P → ℤ)} {c : (P → ℤ) → ℂ}
    (hsa : IsSelfAdjoint (latticeAdjacency Q c)) (x : ℝ) :
    NormedSpace.exp ((-(x : ℂ) * Complex.I) • latticeAdjacency Q c)
      ∈ unitary (H →L[ℂ] H) := by
  letI : NormedAlgebra ℚ (lp (fun _ : (P → ℤ) => ℂ) 2 →L[ℂ] lp (fun _ : (P → ℤ) => ℂ) 2) :=
    NormedAlgebra.restrictScalars ℚ ℂ _
  refine NormedSpace.exp_mem_unitary_of_mem_skewAdjoint ?_
  rw [skewAdjoint.mem_iff, star_smul, hsa.star_eq]
  have hstar : (starRingEnd ℂ) (-(x : ℂ) * Complex.I) = -(-(x : ℂ) * Complex.I) := by
    simp [Complex.conj_I]
  rw [show star (-(x : ℂ) * Complex.I) = (starRingEnd ℂ) (-(x : ℂ) * Complex.I) from rfl, hstar,
    neg_smul]

omit [Fintype P] [DecidableEq P] in
/-- **The evolution is an isometry.**  This is the only property of `e^{-ixA}` that the
polynomial-group estimate uses. -/
theorem norm_exp_latticeAdjacency_apply {Q : Finset (P → ℤ)} {c : (P → ℤ) → ℂ}
    (hsa : IsSelfAdjoint (latticeAdjacency Q c)) (x : ℝ) (ψ : H) :
    ‖NormedSpace.exp ((-(x : ℂ) * Complex.I) • latticeAdjacency Q c) ψ‖ = ‖ψ‖ :=
  ContinuousLinearMap.norm_map_of_mem_unitary (exp_latticeAdjacency_mem_unitary hsa x) ψ

end RHTower
