import GaloisForLFunctions.RHTower.SourceHorizontalWoldEulerGreenAnomaly
import GaloisForLFunctions.HTGeometry.ShiftedEulerLogChord

/-!
# Wold-profile response polarization

The all-order source-horizontal Wold profile is generated by one positive even response.  Its
primitive is the signed Wold current, while its reflected work is exactly the existing polar work.
-/

open Filter MeasureTheory Set Topology
open scoped BigOperators Interval

namespace RHTower

noncomputable section

/-- Canonical continuous extension of `sinh u / u` through the origin. -/
def woldRemovableSinhc (u : ℝ) : ℝ := if u = 0 then 1 else Real.sinh u / u

@[simp] theorem woldRemovableSinhc_zero : woldRemovableSinhc 0 = 1 := by
  simp [woldRemovableSinhc]

theorem woldRemovableSinhc_eq {u : ℝ} (hu : u ≠ 0) :
    woldRemovableSinhc u = Real.sinh u / u := by
  simp [woldRemovableSinhc, hu]

theorem woldRemovableSinhc_mul (u : ℝ) :
    woldRemovableSinhc u * u = Real.sinh u := by
  by_cases hu : u = 0
  · simp [hu]
  · rw [woldRemovableSinhc_eq hu, div_mul_cancel₀ _ hu]

theorem continuous_woldRemovableSinhc : Continuous woldRemovableSinhc := by
  rw [continuous_iff_continuousAt]
  intro u
  by_cases hu : u = 0
  · subst u
    have htend : Tendsto woldRemovableSinhc (𝓝[≠] (0 : ℝ)) (𝓝 1) := by
      apply GaloisForLFunctions.HTGeometry.tendsto_real_sinh_div_self_nhdsNE_zero.congr'
      filter_upwards [self_mem_nhdsWithin] with x hx
      exact (woldRemovableSinhc_eq (by simpa using hx)).symm
    have hdecomp : (𝓝 (0 : ℝ)) = 𝓝[≠] (0 : ℝ) ⊔ pure (0 : ℝ) := by
      rw [← nhdsWithin_singleton (0 : ℝ), ← nhdsWithin_union,
        Set.compl_union_self, nhdsWithin_univ]
    rw [ContinuousAt, woldRemovableSinhc_zero, hdecomp, tendsto_sup]
    exact ⟨htend, by simpa using tendsto_pure_nhds woldRemovableSinhc 0⟩
  · have hbase : ContinuousAt (fun y : ℝ => Real.sinh y / y) u :=
      Real.continuous_sinh.continuousAt.div continuousAt_id hu
    apply hbase.congr_of_eventuallyEq
    filter_upwards [eventually_ne_nhds hu] with y hy
    exact woldRemovableSinhc_eq hy

/-- Positive even response density generating the complete Wold source profile. -/
def sourceHorizontalWoldPrimeClockResponse (u : ℝ) : ℝ :=
  ∑' k : ℕ, ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
    (u ^ (2 * k) / (2 * k).factorial)

private theorem sourceHorizontalWoldPrimeClockResponse_term_nonneg (u : ℝ) (k : ℕ) :
    0 ≤ ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
      (u ^ (2 * k) / (2 * k).factorial) := by
  exact mul_nonneg
    (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
    (div_nonneg (Even.pow_nonneg ⟨k, by omega⟩ u) (Nat.cast_nonneg _))

theorem summable_sourceHorizontalWoldPrimeClockResponse (u : ℝ) :
    Summable fun k : ℕ => ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
      (u ^ (2 * k) / (2 * k).factorial) := by
  refine Summable.of_norm_bounded (Real.hasSum_cosh |u|).summable ?_
  intro k
  have hcoeff : ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) ≤ 1 := by
    rw [div_le_one (by positivity : (0 : ℝ) < (2 * k + 1 : ℕ))]
    norm_num
  rw [Real.norm_eq_abs, abs_of_nonneg
    (sourceHorizontalWoldPrimeClockResponse_term_nonneg u k)]
  have hbase : u ^ (2 * k) / (2 * k).factorial =
      |u| ^ (2 * k) / (2 * k).factorial := by
    calc
      u ^ (2 * k) / (2 * k).factorial =
          |u ^ (2 * k)| / (2 * k).factorial := by
            rw [abs_of_nonneg (Even.pow_nonneg ⟨k, by omega⟩ u)]
      _ = |u| ^ (2 * k) / (2 * k).factorial := by rw [abs_pow]
  rw [hbase]
  exact mul_le_of_le_one_left (by positivity) hcoeff

theorem sourceHorizontalWoldPrimeClockResponse_even (u : ℝ) :
    sourceHorizontalWoldPrimeClockResponse (-u) =
      sourceHorizontalWoldPrimeClockResponse u := by
  rw [sourceHorizontalWoldPrimeClockResponse, sourceHorizontalWoldPrimeClockResponse]
  apply tsum_congr
  intro k
  have heven : Even (2 * k) := ⟨k, by omega⟩
  rw [heven.neg_pow]

theorem sourceHorizontalWoldPrimeClockResponse_quadratic_lower (u : ℝ) :
    u ^ 2 / 3 ≤ sourceHorizontalWoldPrimeClockResponse u := by
  have hle := (summable_sourceHorizontalWoldPrimeClockResponse u).le_tsum 1
    (fun k _ => sourceHorizontalWoldPrimeClockResponse_term_nonneg u k)
  simpa [sourceHorizontalWoldPrimeClockResponse] using hle

@[simp] theorem sourceHorizontalWoldPrimeClockResponse_zero :
    sourceHorizontalWoldPrimeClockResponse 0 = 0 := by
  apply le_antisymm
  · rw [sourceHorizontalWoldPrimeClockResponse]
    apply tsum_nonpos
    intro k
    have hk : 0 ≤ ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
        ((0 : ℝ) ^ (2 * k) / (2 * k).factorial) :=
      sourceHorizontalWoldPrimeClockResponse_term_nonneg 0 k
    by_cases h : k = 0
    · subst k
      norm_num
    · have hkpos : 0 < 2 * k := by omega
      simp [Nat.ne_of_gt hkpos]
  · simpa using (sourceHorizontalWoldPrimeClockResponse_quadratic_lower 0)

theorem sourceHorizontalWoldPrimeClockResponse_eq_zero_iff (u : ℝ) :
    sourceHorizontalWoldPrimeClockResponse u = 0 ↔ u = 0 := by
  constructor
  · intro hzero
    have hlower := sourceHorizontalWoldPrimeClockResponse_quadratic_lower u
    rw [hzero] at hlower
    nlinarith [sq_nonneg u]
  · rintro rfl
    exact sourceHorizontalWoldPrimeClockResponse_zero

private theorem summable_sourceHorizontalWoldEulerGreenDerivativeSeries (u : ℝ) :
    Summable fun k : ℕ => u ^ (2 * k) / (2 * k + 1).factorial := by
  refine Summable.of_norm_bounded (Real.hasSum_cosh |u|).summable ?_
  intro k
  rw [Real.norm_eq_abs, abs_div, abs_pow]
  simp only [Nat.cast_nonneg, abs_of_nonneg]
  have hfac : (2 * k).factorial ≤ (2 * k + 1).factorial := by
    rw [show 2 * k + 1 = (2 * k).succ by omega, Nat.factorial_succ]
    exact Nat.le_mul_of_pos_left _ (by omega)
  exact div_le_div_of_nonneg_left (by positivity) (by positivity) (by exact_mod_cast hfac)

private theorem sourceHorizontalWoldEulerGreenDerivativeSeries_eq_sinhc (u : ℝ) :
    (∑' k : ℕ, u ^ (2 * k) / (2 * k + 1).factorial) = woldRemovableSinhc u := by
  have hderiv := hasDerivAt_sourceHorizontalWoldEulerGreenProfile u
  by_cases hu : u = 0
  · subst u
    rw [woldRemovableSinhc_zero]
    rw [tsum_eq_single 0]
    · norm_num
    · intro k hk
      have hkpos : 0 < 2 * k := by omega
      simp [Nat.ne_of_gt hkpos]
  · have heuler := sourceHorizontalWoldEulerGreenProfile_mul_deriv u
    rw [hderiv.deriv] at heuler
    have hsinhc := woldRemovableSinhc_mul u
    apply mul_right_cancel₀ hu
    calc
      (∑' k : ℕ, u ^ (2 * k) / (2 * k + 1).factorial) * u =
          u * (∑' k : ℕ, u ^ (2 * k) / (2 * k + 1).factorial) := mul_comm _ _
      _ = Real.sinh u := heuler
      _ = woldRemovableSinhc u * u := hsinhc.symm

/-- Closed removable formula `(WPR.5)`. -/
theorem sourceHorizontalWoldPrimeClockResponse_eq_cosh_sub_sinhc (u : ℝ) :
    sourceHorizontalWoldPrimeClockResponse u = Real.cosh u - woldRemovableSinhc u := by
  rw [sourceHorizontalWoldPrimeClockResponse]
  rw [← (Real.hasSum_cosh u).tsum_eq,
    ← sourceHorizontalWoldEulerGreenDerivativeSeries_eq_sinhc u]
  rw [← (Real.hasSum_cosh u).summable.tsum_sub
    (summable_sourceHorizontalWoldEulerGreenDerivativeSeries u)]
  apply tsum_congr
  intro k
  rw [show 2 * k + 1 = (2 * k).succ by omega, Nat.factorial_succ]
  push_cast
  have hfac : ((2 * k).factorial : ℝ) ≠ 0 := by positivity
  have hden : (2 * (k : ℝ) + 1) ≠ 0 := by positivity
  field_simp
  ring

theorem sourceHorizontalWoldPrimeClockResponse_eq_cosh_sub_sinh_div
    {u : ℝ} (hu : u ≠ 0) :
    sourceHorizontalWoldPrimeClockResponse u = Real.cosh u - Real.sinh u / u := by
  rw [sourceHorizontalWoldPrimeClockResponse_eq_cosh_sub_sinhc,
    woldRemovableSinhc_eq hu]

theorem continuous_sourceHorizontalWoldPrimeClockResponse :
    Continuous sourceHorizontalWoldPrimeClockResponse := by
  have hfun : sourceHorizontalWoldPrimeClockResponse =
      fun u => Real.cosh u - woldRemovableSinhc u := by
    funext u
    exact sourceHorizontalWoldPrimeClockResponse_eq_cosh_sub_sinhc u
  rw [hfun]
  exact Real.continuous_cosh.sub continuous_woldRemovableSinhc

/-- Wold current generated by the response. -/
def sourceHorizontalWoldPrimeClockCurrent (u : ℝ) : ℝ :=
  -sourceHorizontalWoldPrimeClockUniversalProfile u

@[simp] theorem sourceHorizontalWoldPrimeClockCurrent_zero :
    sourceHorizontalWoldPrimeClockCurrent 0 = 0 := by
  simp [sourceHorizontalWoldPrimeClockCurrent,
    sourceHorizontalWoldPrimeClockUniversalProfile]

@[simp] theorem sourceHorizontalWoldPrimeClockCurrent_neg (u : ℝ) :
    sourceHorizontalWoldPrimeClockCurrent (-u) =
      -sourceHorizontalWoldPrimeClockCurrent u := by
  simp [sourceHorizontalWoldPrimeClockCurrent]

/-- The response is exactly the negative derivative of the complete source profile. -/
theorem hasDerivAt_sourceHorizontalWoldPrimeClockUniversalProfile (u : ℝ) :
    HasDerivAt sourceHorizontalWoldPrimeClockUniversalProfile
      (-sourceHorizontalWoldPrimeClockResponse u) u := by
  rw [show sourceHorizontalWoldPrimeClockUniversalProfile =
      fun x => sourceHorizontalWoldEulerGreenProfile x - Real.sinh x by
    funext x
    exact sourceHorizontalWoldPrimeClockUniversalProfile_eq_eulerGreen_sub_sinh x]
  have h := (hasDerivAt_sourceHorizontalWoldEulerGreenProfile u).sub
    (Real.hasDerivAt_sinh u)
  apply h.congr_deriv
  rw [sourceHorizontalWoldPrimeClockResponse_eq_cosh_sub_sinhc,
    ← sourceHorizontalWoldEulerGreenDerivativeSeries_eq_sinhc]
  ring

theorem hasDerivAt_sourceHorizontalWoldPrimeClockCurrent (u : ℝ) :
    HasDerivAt sourceHorizontalWoldPrimeClockCurrent
      (sourceHorizontalWoldPrimeClockResponse u) u := by
  change HasDerivAt (-sourceHorizontalWoldPrimeClockUniversalProfile)
    (sourceHorizontalWoldPrimeClockResponse u) u
  simpa only [neg_neg] using
    (hasDerivAt_sourceHorizontalWoldPrimeClockUniversalProfile u).neg

/-- Exact response accumulation `(WPR.7)`. -/
theorem sourceHorizontalWoldPrimeClockCurrent_eq_integral (u : ℝ) :
    sourceHorizontalWoldPrimeClockCurrent u =
      ∫ v : ℝ in (0 : ℝ)..u, sourceHorizontalWoldPrimeClockResponse v := by
  have hint := continuous_sourceHorizontalWoldPrimeClockResponse.intervalIntegrable
    (μ := volume) 0 u
  have hfund := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (a := (0 : ℝ)) (b := u)
    (fun x _ => hasDerivAt_sourceHorizontalWoldPrimeClockCurrent x) hint
  rw [sourceHorizontalWoldPrimeClockCurrent_zero, sub_zero] at hfund
  exact hfund.symm

/-- Exact symmetric response accumulation. -/
theorem intervalIntegral_sourceHorizontalWoldPrimeClockResponse_neg_abs_abs (u : ℝ) :
    (∫ v : ℝ in -|u|..|u|, sourceHorizontalWoldPrimeClockResponse v) =
      2 * sourceHorizontalWoldPrimeClockCurrent |u| := by
  have hint := continuous_sourceHorizontalWoldPrimeClockResponse.intervalIntegrable
    (μ := volume) (-|u|) |u|
  have hfund := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (a := -|u|) (b := |u|)
    (fun x _ => hasDerivAt_sourceHorizontalWoldPrimeClockCurrent x) hint
  calc
    (∫ v : ℝ in -|u|..|u|, sourceHorizontalWoldPrimeClockResponse v) =
        sourceHorizontalWoldPrimeClockCurrent |u| -
          sourceHorizontalWoldPrimeClockCurrent (-|u|) := hfund
    _ = 2 * sourceHorizontalWoldPrimeClockCurrent |u| := by
      rw [sourceHorizontalWoldPrimeClockCurrent_neg]
      ring

/-- Complete reflected PRCM work generated by the Wold response. -/
def sourceHorizontalWoldPrimeClockCompleteReflectedWork (u : ℝ) : ℝ :=
  2 * |u| *
    ∫ v : ℝ in -|u|..|u|, sourceHorizontalWoldPrimeClockResponse v

/-- Polar work is aperture times Wold current. -/
theorem sourceHorizontalWoldPrimeClockPolarRateWork_eq_mul_current (u : ℝ) :
    sourceHorizontalWoldPrimeClockPolarRateWork u =
      Real.log 2 / 2 * u * sourceHorizontalWoldPrimeClockCurrent u := by
  rw [sourceHorizontalWoldPrimeClockPolarRateWork,
    sourceHorizontalWoldPrimeClockCurrent]
  ring

theorem sourceHorizontalWoldPrimeClock_mul_current_eq_abs (u : ℝ) :
    u * sourceHorizontalWoldPrimeClockCurrent u =
      |u| * sourceHorizontalWoldPrimeClockCurrent |u| := by
  by_cases hu : 0 ≤ u
  · rw [abs_of_nonneg hu]
  · have hu' : u < 0 := lt_of_not_ge hu
    rw [abs_of_neg hu', sourceHorizontalWoldPrimeClockCurrent_neg]
    ring

/-- Exact response/current/work fusion `(WPR.8)`. -/
theorem sourceHorizontalWoldPrimeClockPolarRateWork_eq_reflectedWork (u : ℝ) :
    sourceHorizontalWoldPrimeClockPolarRateWork u =
      Real.log 2 / 8 * sourceHorizontalWoldPrimeClockCompleteReflectedWork u := by
  rw [sourceHorizontalWoldPrimeClockPolarRateWork_eq_mul_current,
    sourceHorizontalWoldPrimeClockCompleteReflectedWork,
    intervalIntegral_sourceHorizontalWoldPrimeClockResponse_neg_abs_abs]
  calc
    Real.log 2 / 2 * u * sourceHorizontalWoldPrimeClockCurrent u =
        Real.log 2 / 2 *
          (u * sourceHorizontalWoldPrimeClockCurrent u) := by ring
    _ = Real.log 2 / 2 *
        (|u| * sourceHorizontalWoldPrimeClockCurrent |u|) := by
      rw [sourceHorizontalWoldPrimeClock_mul_current_eq_abs]
    _ = Real.log 2 / 8 *
        (2 * |u| * (2 * sourceHorizontalWoldPrimeClockCurrent |u|)) := by ring

/-- Polar work vanishes exactly at neutral horizontal grade `(WPR.11)`. -/
theorem sourceHorizontalWoldPrimeClockPolarRateWork_eq_zero_iff (u : ℝ) :
    sourceHorizontalWoldPrimeClockPolarRateWork u = 0 ↔ u = 0 := by
  have hlog : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num))
  simp [sourceHorizontalWoldPrimeClockPolarRateWork, hlog,
    sourceHorizontalWoldPrimeClockUniversalProfile_eq_zero_iff]

/-- Boundedness on the entire real dilation ray, not merely one geometric orbit. -/
def SourceHorizontalWoldPrimeClockBoundedPolarRayWork (u : ℝ) : Prop :=
  ∃ B : ℝ, ∀ scale : ℝ, 1 ≤ scale →
    sourceHorizontalWoldPrimeClockPolarRateWork (scale * u) ≤ B

/-- Global reflected properness `(WPR.12)`. -/
theorem sourceHorizontalWoldPrimeClockBoundedPolarRayWork_iff (u : ℝ) :
    SourceHorizontalWoldPrimeClockBoundedPolarRayWork u ↔ u = 0 := by
  constructor
  · rintro ⟨B, hB⟩
    by_contra hu
    have htop := sourceHorizontalWoldPrimeClockPolarRateWork_scale_tendsto
      (d := (2 : ℝ)) (u := u) (by norm_num) hu
    have hevent := htop.eventually_gt_atTop B
    rcases hevent.exists with ⟨n, hn⟩
    have hscale : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    linarith [hB (2 ^ n) hscale]
  · rintro rfl
    refine ⟨0, fun scale _ => ?_⟩
    simp [sourceHorizontalWoldPrimeClockPolarRateWork,
      sourceHorizontalWoldPrimeClockUniversalProfile]

/-- Polar work reconstructs the complete odd source profile `(WPR.13)`. -/
theorem sourceHorizontalWoldPrimeClockUniversalProfile_eq_polarRateWork_div
    {u : ℝ} (hu : u ≠ 0) :
    sourceHorizontalWoldPrimeClockUniversalProfile u =
      -(2 * sourceHorizontalWoldPrimeClockPolarRateWork u /
        (Real.log 2 * u)) := by
  have hlog : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num))
  rw [sourceHorizontalWoldPrimeClockPolarRateWork]
  field_simp [hu, hlog]

/-- Polar work reconstructs the Wold current `(WPR.13)`. -/
theorem sourceHorizontalWoldPrimeClockCurrent_eq_polarRateWork_div
    {u : ℝ} (hu : u ≠ 0) :
    sourceHorizontalWoldPrimeClockCurrent u =
      2 * sourceHorizontalWoldPrimeClockPolarRateWork u /
        (Real.log 2 * u) := by
  rw [sourceHorizontalWoldPrimeClockCurrent,
    sourceHorizontalWoldPrimeClockUniversalProfile_eq_polarRateWork_div hu]
  ring

/-- Differential polar-work law. -/
theorem hasDerivAt_sourceHorizontalWoldPrimeClockPolarRateWork (u : ℝ) :
    HasDerivAt sourceHorizontalWoldPrimeClockPolarRateWork
      (Real.log 2 / 2 *
        (sourceHorizontalWoldPrimeClockCurrent u +
          u * sourceHorizontalWoldPrimeClockResponse u)) u := by
  rw [show sourceHorizontalWoldPrimeClockPolarRateWork =
      fun x : ℝ => Real.log 2 / 2 *
        (x * sourceHorizontalWoldPrimeClockCurrent x) by
    funext x
    rw [sourceHorizontalWoldPrimeClockPolarRateWork_eq_mul_current]
    ring]
  simpa only [Pi.mul_apply, id_eq, one_mul] using
    (((hasDerivAt_id u).mul
      (hasDerivAt_sourceHorizontalWoldPrimeClockCurrent u)).const_mul
        (Real.log 2 / 2))

/-- Differentiable polar work reconstructs the response `(WPR.14)`. -/
theorem sourceHorizontalWoldPrimeClockResponse_eq_polarRateWork_deriv
    {u : ℝ} (hu : u ≠ 0) :
    sourceHorizontalWoldPrimeClockResponse u =
      2 / Real.log 2 *
        (deriv sourceHorizontalWoldPrimeClockPolarRateWork u / u -
          sourceHorizontalWoldPrimeClockPolarRateWork u / u ^ 2) := by
  have hlog : Real.log 2 ≠ 0 := ne_of_gt (Real.log_pos (by norm_num))
  rw [(hasDerivAt_sourceHorizontalWoldPrimeClockPolarRateWork u).deriv,
    sourceHorizontalWoldPrimeClockCurrent_eq_polarRateWork_div hu]
  field_simp [hu, hlog]
  ring

/-- Exact all-order current series; its first nonzero term is `u^3 / 9`. -/
theorem sourceHorizontalWoldPrimeClockCurrent_eq_tsum (u : ℝ) :
    sourceHorizontalWoldPrimeClockCurrent u =
      ∑' k : ℕ, ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
        (u ^ (2 * k + 1) / (2 * k + 1).factorial) := by
  rw [sourceHorizontalWoldPrimeClockCurrent,
    sourceHorizontalWoldPrimeClockUniversalProfile, ← tsum_neg]
  apply tsum_congr
  intro k
  push_cast
  have hden : (2 * (k : ℝ) + 1) ≠ 0 := by positivity
  field_simp
  ring

/-- Exact quadratic/cubic/quartic jet transmutation series `(WPR.15)`. -/
theorem sourceHorizontalWoldPrimeClock_jet_transmutation_series (u : ℝ) :
    sourceHorizontalWoldPrimeClockResponse u =
        ∑' k : ℕ, ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
          (u ^ (2 * k) / (2 * k).factorial) ∧
      sourceHorizontalWoldPrimeClockCurrent u =
        ∑' k : ℕ, ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
          (u ^ (2 * k + 1) / (2 * k + 1).factorial) ∧
      sourceHorizontalWoldPrimeClockPolarRateWork u =
        Real.log 2 / 2 * u *
          ∑' k : ℕ, ((2 * k : ℕ) : ℝ) / (2 * k + 1 : ℕ) *
            (u ^ (2 * k + 1) / (2 * k + 1).factorial) := by
  refine ⟨rfl, sourceHorizontalWoldPrimeClockCurrent_eq_tsum u, ?_⟩
  rw [sourceHorizontalWoldPrimeClockPolarRateWork_eq_mul_current,
    sourceHorizontalWoldPrimeClockCurrent_eq_tsum]

end

end RHTower
