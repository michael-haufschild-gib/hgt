import GaloisForLFunctions.RHTower.TorsionSeamClassification

/-!
# Canonical cutoff-crossing torsion seam

The non-split sheared presentation and the standard cutoff admit a fixed lower-left crossing action.
Naming that one presentation turns the boundary-witness interfaces into concrete theorems: at every
positive jet depth its boundary class is `[-1]` modulo `X^m`, hence nonzero, determinant-transverse,
and nonfake on both sides.
-/

namespace RHTower

open Matrix Polynomial

noncomputable section

/-- The fixed action carrying one unit from the cutoff's first component to its second. -/
def standardCutoffCrossingAction : Matrix (Fin 2) (Fin 2) (Polynomial ℚ) :=
  !![0, 0; 1, 0]

/-- The canonical one-label non-split torsion seam generated by the standard cutoff crossing. -/
def canonicalCutoffTorsionSeam (m : ℕ) :
    TorsionSeamPresentation Unit (Fin 2) ℚ m :=
  shearedTorsionSeam m
    (crossBoundary (standardCutoff (R := ℚ)) standardCutoffCrossingAction)

/-- Its Fitting boundary is the constant jet `[-1]`. -/
theorem canonicalCutoffTorsionSeam_boundaryClass (m : ℕ) :
    (canonicalCutoffTorsionSeam m).boundaryClass () = jetClass ℚ m (-1) := by
  rw [canonicalCutoffTorsionSeam,
    shearedTorsionSeam_boundaryClass, standardCutoff_crossBoundary_lowerLeft]
  simp [standardCutoffCrossingAction]

/-- At every positive jet depth, the canonical boundary class survives. -/
theorem canonicalCutoffTorsionSeam_boundaryClass_ne_zero {m : ℕ} (hm : 0 < m) :
    (canonicalCutoffTorsionSeam m).boundaryClass () ≠ 0 := by
  rw [canonicalCutoffTorsionSeam_boundaryClass]
  exact (jetClass_ne_zero_iff_exists_coeff_lt_ne_zero ℚ m).mpr
    ⟨0, hm, by simp⟩

/-- The canonical seam supplies its low-coefficient witness without an interface hypothesis. -/
theorem canonicalCutoffTorsionSeam_boundaryCoeffWitness {m : ℕ} (hm : 0 < m) :
    (canonicalCutoffTorsionSeam m).BoundaryCoeffWitness () :=
  (canonicalCutoffTorsionSeam m).boundaryClass_ne_zero_iff_coeffWitness.mp
    (canonicalCutoffTorsionSeam_boundaryClass_ne_zero hm)

/-- The canonical seam has a nontrivial Fitting boundary at every positive depth. -/
theorem canonicalCutoffTorsionSeam_hasNontrivialFittingBoundary
    {m : ℕ} (hm : 0 < m) :
    HasNontrivialFittingBoundary m (canonicalCutoffTorsionSeam m).A
      (canonicalCutoffTorsionSeam m).Delta := by
  exact ⟨(), canonicalCutoffTorsionSeam_boundaryClass_ne_zero hm⟩

/-- The determinant-transverse-defect interface is concrete for the canonical seam. -/
theorem canonicalCutoffTorsionSeam_hasDeterminantTransverseDefect
    {m : ℕ} (hm : 0 < m) :
    (canonicalCutoffTorsionSeam m).HasDeterminantTransverseDefect :=
  (canonicalCutoffTorsionSeam m).hasNontrivialFittingBoundary_iff_hasDeterminantTransverseDefect.mp
    (canonicalCutoffTorsionSeam_hasNontrivialFittingBoundary hm)

/-- Its unique defect is not a right-factor presentation artifact. -/
theorem canonicalCutoffTorsionSeam_defectNonmember {m : ℕ} (hm : 0 < m) :
    (canonicalCutoffTorsionSeam m).DefectNonmember () :=
  (canonicalCutoffTorsionSeam m).defectNonmember_of_coeffWitness
    (canonicalCutoffTorsionSeam_boundaryCoeffWitness hm)

/-- Its unique defect is not a left-factor presentation artifact. -/
theorem canonicalCutoffTorsionSeam_defectLeftNonmember {m : ℕ} (hm : 0 < m) :
    (canonicalCutoffTorsionSeam m).DefectLeftNonmember () :=
  (canonicalCutoffTorsionSeam m).defectLeftNonmember_of_coeffWitness
    (canonicalCutoffTorsionSeam_boundaryCoeffWitness hm)

end

end RHTower
