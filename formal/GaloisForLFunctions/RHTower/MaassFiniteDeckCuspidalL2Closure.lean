import GaloisForLFunctions.RHTower.MaassFiniteDeckCuspidalRellich

/-!
# The completed cuspidal finite-deck `L²` carrier

The cuspidal form inclusion is dense in its own closed `L²` range rather than
in all finite-deck `L²`.  Corestricting to this carrier supplies the dense,
compact embedding required by the Friedrichs construction.
-/

open UpperHalfPlane Set Filter Topology Complex MeasureTheory

namespace GaloisForLFunctions.RHTower.MaassFiniteDeckDirichlet

open MaassCongruenceL2 SelbergMaassCongruenceTrace GaloisForLFunctions.HTGeometry
noncomputable section

/-- Closed `L²` carrier generated by completed cuspidal finite-deck forms. -/
def cuspidalL2Closure (N : ℕ) : Submodule ℂ (DeckL2 N) :=
  (LinearMap.range (cuspidalFormInclusion N).toLinearMap).topologicalClosure

/-- The Hilbert space of cuspidal finite-deck `L²` vectors. -/
abbrev CuspidalL2 (N : ℕ) := ↥(cuspidalL2Closure N)

noncomputable instance cuspidalL2_completeSpace (N : ℕ) : CompleteSpace (CuspidalL2 N) :=
  (Submodule.isClosed_topologicalClosure _).completeSpace_coe

/-- The completed form inclusion with its minimal closed cuspidal `L²` codomain. -/
def cuspidalFormInclusionClosure (N : ℕ) :
    CuspidalFormDomain N →L[ℂ] CuspidalL2 N :=
  (cuspidalFormInclusion N).codRestrict (cuspidalL2Closure N) (by
    intro v
    change cuspidalFormInclusion N v ∈ closure
      ((LinearMap.range (cuspidalFormInclusion N).toLinearMap : Submodule ℂ (DeckL2 N)) : Set (DeckL2 N))
    exact subset_closure ⟨v, rfl⟩)

theorem cuspidalFormInclusionClosure_injective (N : ℕ) :
    Function.Injective (cuspidalFormInclusionClosure N) := by
  intro u v huv
  apply cuspidalFormInclusion_injective N
  exact congrArg Subtype.val huv

theorem cuspidalFormInclusionClosure_dense_range (N : ℕ) :
    Dense ((LinearMap.range (cuspidalFormInclusionClosure N).toLinearMap :
      Submodule ℂ (CuspidalL2 N)) : Set (CuspidalL2 N)) := by
  have hrange :
      ((fun x : CuspidalL2 N => (x : DeckL2 N)) ''
        ((LinearMap.range (cuspidalFormInclusionClosure N).toLinearMap :
          Submodule ℂ (CuspidalL2 N)) : Set (CuspidalL2 N))) =
        ((LinearMap.range (cuspidalFormInclusion N).toLinearMap :
          Submodule ℂ (DeckL2 N)) : Set (DeckL2 N)) := by
    ext x
    constructor
    · rintro ⟨y, ⟨v, rfl⟩, rfl⟩
      exact ⟨v, rfl⟩
    · rintro ⟨v, rfl⟩
      exact ⟨cuspidalFormInclusionClosure N v, ⟨v, rfl⟩, rfl⟩
  rw [Subtype.dense_iff]
  intro x hx
  change x ∈ closure
    ((fun y : CuspidalL2 N => (y : DeckL2 N)) ''
      ((LinearMap.range (cuspidalFormInclusionClosure N).toLinearMap :
        Submodule ℂ (CuspidalL2 N)) : Set (CuspidalL2 N)))
  rw [hrange]
  exact hx

theorem isCompactOperator_cuspidalFormInclusionClosure (N : ℕ) :
    IsCompactOperator (cuspidalFormInclusionClosure N) := by
  rcases isCompactOperator_cuspidalFormInclusion N with ⟨K, hK, hKpre⟩
  let K' : Set (CuspidalL2 N) := Subtype.val ⁻¹' K
  refine ⟨K', ?_, ?_⟩
  · rw [Subtype.isCompact_iff]
    have hclosed : IsClosed (cuspidalL2Closure N : Set (DeckL2 N)) :=
      by
        unfold cuspidalL2Closure
        exact Submodule.isClosed_topologicalClosure _
    have hcompact : IsCompact (K ∩ (cuspidalL2Closure N : Set (DeckL2 N))) :=
      hK.inter_right hclosed
    convert hcompact using 1
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change (y : DeckL2 N) ∈ K at hy
      exact ⟨hy, y.property⟩
    · rintro ⟨hxK, hxCusp⟩
      exact ⟨⟨x, hxCusp⟩, hxK, rfl⟩
  · have heq : (cuspidalFormInclusionClosure N) ⁻¹' K' =
        (cuspidalFormInclusion N) ⁻¹' K := by
      ext v
      rfl
    rw [heq]
    exact hKpre

end

end GaloisForLFunctions.RHTower.MaassFiniteDeckDirichlet
