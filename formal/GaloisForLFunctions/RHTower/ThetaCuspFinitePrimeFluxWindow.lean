noncomputable section

namespace RHTower

/-- Completely multiplicative real power used to sum finite-prime smooth monoids. -/
def smoothRpowHom (alpha : ℝ) : ℕ →* ℝ where
  toFun n := (n : ℝ) ^ (-alpha)
  map_one' := by simp
  map_mul' m n := by
    push_cast
    rw [Real.mul_rpow (Nat.cast_nonneg m) (Nat.cast_nonneg n)]

@[simp] theorem smoothRpowHom_apply (alpha : ℝ) (n : ℕ) :
    smoothRpowHom alpha n = (n : ℝ) ^ (-alpha) := rfl

/-- Every positive real power is summable on a monoid generated by finitely many primes. -/
theorem summable_smoothNumbers_rpow_neg (N : ℕ) {alpha : ℝ} (halpha : 0 < alpha) :
    Summable (fun n : (N + 1).smoothNumbers => ((n : ℕ) : ℝ) ^ (-alpha)) := by
  have hp : ∀ {p : ℕ}, p.Prime → ‖smoothRpowHom alpha p‖ < 1 := by
    intro p hp
    rw [smoothRpowHom_apply, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg p) _)]
    have hpR : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    exact Real.rpow_lt_one_of_one_lt_of_neg hpR (by linarith)
  exact (EulerProduct.summable_and_hasSum_smoothNumbers_prod_primesBelow_geometric
    (f := smoothRpowHom alpha) hp (N + 1)).2.summable

/-- One logarithmic moment remains summable on every finite-prime smooth monoid. -/
theorem summable_smoothNumbers_log_mul_rpow_neg
    (N : ℕ) {alpha : ℝ} (halpha : 0 < alpha) :
    Summable (fun n : (N + 1).smoothNumbers =>
      Real.log (n : ℕ) * ((n : ℕ) : ℝ) ^ (-alpha)) := by
  have hhalf : 0 < alpha / 2 := by linarith
  have hsum := (summable_smoothNumbers_rpow_neg N hhalf).mul_left (2 / alpha)
  refine Summable.of_norm_bounded hsum ?_
  intro n
  have hn : 0 < (n : ℕ) :=
    Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property)
  have hnR : (0 : ℝ) < (n : ℕ) := by exact_mod_cast hn
  have hlog0 : 0 ≤ Real.log (n : ℕ) := Real.log_nonneg (by exact_mod_cast hn)
  have hlog := Real.log_le_rpow_div hnR.le hhalf
  rw [Real.norm_eq_abs, abs_of_nonneg
    (mul_nonneg hlog0 (Real.rpow_nonneg hnR.le _))]
  calc
    Real.log (n : ℕ) * ((n : ℕ) : ℝ) ^ (-alpha) ≤
        (((n : ℕ) : ℝ) ^ (alpha / 2) / (alpha / 2)) *
          ((n : ℕ) : ℝ) ^ (-alpha) :=
      mul_le_mul_of_nonneg_right hlog (Real.rpow_nonneg hnR.le _)
    _ = (2 / alpha) * ((n : ℕ) : ℝ) ^ (-(alpha / 2)) := by
      calc
        (((n : ℕ) : ℝ) ^ (alpha / 2) / (alpha / 2)) *
              ((n : ℕ) : ℝ) ^ (-alpha) =
            (alpha / 2)⁻¹ *
              (((n : ℕ) : ℝ) ^ (alpha / 2) *
                ((n : ℕ) : ℝ) ^ (-alpha)) := by ring
        _ = (alpha / 2)⁻¹ *
              ((n : ℕ) : ℝ) ^ (alpha / 2 + -alpha) := by
              rw [Real.rpow_add hnR]
        _ = (2 / alpha) * ((n : ℕ) : ℝ) ^ (-(alpha / 2)) := by
              congr 1
              · field_simp
              · congr 1
                ring

/-- Absolute real Laplace density of the logarithmic cusp seed. -/
def thetaCuspLogSeedAbsWeight (a x : ℝ) : ℝ :=
  Real.exp (a * x) * |thetaCuspLogSeed x|

theorem continuous_thetaCuspLogSeed : Continuous thetaCuspLogSeed := by
  unfold thetaCuspLogSeed thetaCuspSeed
  fun_prop

/-- The logarithmic cusp seed has every exponential moment above its explicit lower-tail
abscissa `-5/2`.  Positivity of the full theta source controls the positive tail. -/
theorem integrable_thetaCuspLogSeedAbsWeight {a : ℝ} (ha : -(5 / 2 : ℝ) < a) :
    Integrable (thetaCuspLogSeedAbsWeight a) := by
  have hpos : IntegrableOn (thetaCuspLogSeedAbsWeight a) (Ioi 0) := by
    have hfull := HedenmalmThetaSource.integrableOn_exp_mul_thetaCuspFullSource a
    apply Integrable.mono hfull
    · exact ((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
        continuous_thetaCuspLogSeed.abs).aestronglyMeasurable.restrict
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      have hterm0 : 0 ≤ thetaCuspLogSeed x := by
        simpa [thetaCuspLogSeed, thetaCuspSourceTerm] using
          thetaCuspSourceTerm_nonneg_of_pos hx 1
      have hterm : thetaCuspLogSeed x ≤ thetaCuspFullSource x := by
        rw [show thetaCuspLogSeed x = thetaCuspSourceTerm x 1 by
          simp [thetaCuspLogSeed, thetaCuspSourceTerm]]
        rw [thetaCuspFullSource]
        exact (summable_thetaCuspSourceTerm x).le_tsum 1
          (fun n _ => thetaCuspSourceTerm_nonneg_of_pos hx n)
      have hfull0 : 0 ≤ thetaCuspFullSource x :=
        (thetaCuspFullSource_pos_of_pos hx).le
      rw [thetaCuspLogSeedAbsWeight, abs_of_nonneg hterm0,
        Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le hterm0),
        Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le hfull0)]
      exact mul_le_mul_of_nonneg_left hterm (Real.exp_pos _).le
  have hneg : IntegrableOn (thetaCuspLogSeedAbsWeight a) (Iic 0) := by
    let C4 : ℝ := 4 * Real.pi ^ 2
    let C2 : ℝ := 6 * Real.pi
    let major : ℝ → ℝ := fun x =>
      C4 * Real.exp ((a + 9 / 2) * x) +
        C2 * Real.exp ((a + 5 / 2) * x)
    have hmajor : IntegrableOn major (Iic 0) :=
      ((integrableOn_exp_mul_Iic (by linarith : 0 < a + 9 / 2) 0).const_mul C4).add
        ((integrableOn_exp_mul_Iic (by linarith : 0 < a + 5 / 2) 0).const_mul C2)
    apply Integrable.mono hmajor
    · exact ((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
        continuous_thetaCuspLogSeed.abs).aestronglyMeasurable.restrict
    · filter_upwards [ae_restrict_mem measurableSet_Iic] with x hx
      have hgauss : Real.exp (-Real.pi * Real.exp x ^ 2) ≤ 1 := by
        exact Real.exp_le_one_iff.mpr
          (mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr Real.pi_pos.le) (sq_nonneg _))
      have hseed := abs_thetaCuspSeed_le (Real.exp x)
      have hnonneg : 0 ≤ thetaCuspLogSeedAbsWeight a x := by
        exact mul_nonneg (Real.exp_pos _).le (abs_nonneg _)
      have hmajor0 : 0 ≤ major x := by
        dsimp [major, C4, C2]
        positivity
      rw [Real.norm_eq_abs, abs_of_nonneg hnonneg,
        Real.norm_eq_abs, abs_of_nonneg hmajor0]
      calc
        thetaCuspLogSeedAbsWeight a x =
            Real.exp (a * x) * (Real.exp (x / 2) *
              |thetaCuspSeed (Real.exp x)|) := by
                rw [thetaCuspLogSeedAbsWeight, thetaCuspLogSeed,
                  abs_mul, abs_of_pos (Real.exp_pos _)]
        _ ≤ Real.exp (a * x) * (Real.exp (x / 2) *
              (2 * Real.pi *
                (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2) *
                  Real.exp (-Real.pi * Real.exp x ^ 2))) := by
                gcongr
        _ ≤ Real.exp (a * x) * (Real.exp (x / 2) *
              (2 * Real.pi *
                (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2))) := by
                have hcoef : 0 ≤ Real.exp (a * x) * Real.exp (x / 2) *
                    (2 * Real.pi *
                      (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2)) := by
                  positivity
                calc
                  Real.exp (a * x) * (Real.exp (x / 2) *
                        (2 * Real.pi *
                          (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2) *
                            Real.exp (-Real.pi * Real.exp x ^ 2))) =
                      (Real.exp (a * x) * Real.exp (x / 2) *
                        (2 * Real.pi *
                          (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2))) *
                            Real.exp (-Real.pi * Real.exp x ^ 2) := by ring
                  _ ≤ (Real.exp (a * x) * Real.exp (x / 2) *
                        (2 * Real.pi *
                          (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2))) * 1 :=
                    mul_le_mul_of_nonneg_left hgauss hcoef
                  _ = Real.exp (a * x) * (Real.exp (x / 2) *
                        (2 * Real.pi *
                          (2 * Real.pi * Real.exp x ^ 4 + 3 * Real.exp x ^ 2))) := by ring
        _ = major x := by
              have h4 : Real.exp x ^ 4 = Real.exp (4 * x) := by
                rw [← Real.exp_nat_mul]
                norm_num
              have h2 : Real.exp x ^ 2 = Real.exp (2 * x) := by
                rw [← Real.exp_nat_mul]
                norm_num
              have h9 : Real.exp (a * x) * Real.exp (x / 2) * Real.exp (4 * x) =
                  Real.exp ((a + 9 / 2) * x) := by
                rw [← Real.exp_add, ← Real.exp_add]
                congr 1
                ring
              have h5 : Real.exp (a * x) * Real.exp (x / 2) * Real.exp (2 * x) =
                  Real.exp ((a + 5 / 2) * x) := by
                rw [← Real.exp_add, ← Real.exp_add]
                congr 1
                ring
              rw [h4, h2]
              calc
                Real.exp (a * x) *
                      (Real.exp (x / 2) *
                        (2 * Real.pi *
                          (2 * Real.pi * Real.exp (4 * x) +
                            3 * Real.exp (2 * x)))) =
                    4 * Real.pi ^ 2 *
                        (Real.exp (a * x) * Real.exp (x / 2) * Real.exp (4 * x)) +
                      6 * Real.pi *
                        (Real.exp (a * x) * Real.exp (x / 2) * Real.exp (2 * x)) := by ring
                _ = major x := by
                  rw [h9, h5]
  simpa [Iic_union_Ioi] using hneg.union hpos

/-- Absolute first-moment Laplace density of the logarithmic cusp seed. -/
def thetaCuspLogSeedFirstAbsWeight (a x : ℝ) : ℝ :=
  Real.exp (a * x) * |x| * |thetaCuspLogSeed x|

/-- One coordinate factor preserves every positive seed Laplace moment. -/
theorem integrable_thetaCuspLogSeedFirstAbsWeight {a : ℝ} (ha : 0 < a) :
    Integrable (thetaCuspLogSeedFirstAbsWeight a) := by
  have hposMajor : IntegrableOn (thetaCuspLogSeedAbsWeight (a + 1)) (Ioi 0) :=
    (integrable_thetaCuspLogSeedAbsWeight (a := a + 1) (by linarith)).integrableOn
  have hpos : IntegrableOn (thetaCuspLogSeedFirstAbsWeight a) (Ioi 0) := by
    apply Integrable.mono hposMajor
    · exact (((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
          continuous_abs).mul continuous_thetaCuspLogSeed.abs).aestronglyMeasurable.restrict
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      have hxexp : |x| ≤ Real.exp x := by
        rw [abs_of_nonneg hx.le]
        linarith [Real.add_one_le_exp x]
      have hseed0 : 0 ≤ |thetaCuspLogSeed x| := abs_nonneg _
      have hleft0 : 0 ≤ thetaCuspLogSeedFirstAbsWeight a x := by
        dsimp [thetaCuspLogSeedFirstAbsWeight]
        positivity
      have hright0 : 0 ≤ thetaCuspLogSeedAbsWeight (a + 1) x := by
        dsimp [thetaCuspLogSeedAbsWeight]
        positivity
      rw [Real.norm_eq_abs, abs_of_nonneg hleft0,
        Real.norm_eq_abs, abs_of_nonneg hright0]
      calc
        thetaCuspLogSeedFirstAbsWeight a x ≤
            Real.exp (a * x) * Real.exp x * |thetaCuspLogSeed x| := by
              dsimp [thetaCuspLogSeedFirstAbsWeight]
              gcongr
        _ = thetaCuspLogSeedAbsWeight (a + 1) x := by
              dsimp [thetaCuspLogSeedAbsWeight]
              rw [← Real.exp_add]
              congr 1
              ring
  have hnegMajor : IntegrableOn (thetaCuspLogSeedAbsWeight (a - 1)) (Iic 0) :=
    (integrable_thetaCuspLogSeedAbsWeight (a := a - 1) (by linarith)).integrableOn
  have hneg : IntegrableOn (thetaCuspLogSeedFirstAbsWeight a) (Iic 0) := by
    apply Integrable.mono hnegMajor
    · exact (((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
          continuous_abs).mul continuous_thetaCuspLogSeed.abs).aestronglyMeasurable.restrict
    · filter_upwards [ae_restrict_mem measurableSet_Iic] with x hx
      have hxexp : |x| ≤ Real.exp (-x) := by
        rw [abs_of_nonpos hx]
        linarith [Real.add_one_le_exp (-x)]
      have hleft0 : 0 ≤ thetaCuspLogSeedFirstAbsWeight a x := by
        dsimp [thetaCuspLogSeedFirstAbsWeight]
        positivity
      have hright0 : 0 ≤ thetaCuspLogSeedAbsWeight (a - 1) x := by
        dsimp [thetaCuspLogSeedAbsWeight]
        positivity
      rw [Real.norm_eq_abs, abs_of_nonneg hleft0,
        Real.norm_eq_abs, abs_of_nonneg hright0]
      calc
        thetaCuspLogSeedFirstAbsWeight a x ≤
            Real.exp (a * x) * Real.exp (-x) * |thetaCuspLogSeed x| := by
              dsimp [thetaCuspLogSeedFirstAbsWeight]
              gcongr
        _ = thetaCuspLogSeedAbsWeight (a - 1) x := by
              dsimp [thetaCuspLogSeedAbsWeight]
              rw [← Real.exp_add]
              congr 1
              ring
  simpa [Iic_union_Ioi] using hneg.union hpos

/-! ## Bilateral Laplace summability of the finite-prime source -/

/-- Single smooth-number summand in the bilateral Laplace transform. -/
def finitePrimeThetaCuspLaplaceTerm
    (w : ℂ) (n : ℕ) (x : ℝ) : ℂ :=
  (thetaCuspSourceTerm x n : ℂ) * Complex.exp (w * (x : ℂ))

theorem norm_finitePrimeThetaCuspLaplaceTerm
    (w : ℂ) {n : ℕ} (hn : 0 < n) (x : ℝ) :
    ‖finitePrimeThetaCuspLaplaceTerm w n x‖ =
      ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
        thetaCuspLogSeedAbsWeight w.re (x + Real.log n) := by
  have hsource := invSqrt_mul_logTranslate_thetaCuspLogSeed hn x
  have htilt := exp_mul_resolventTerm_eq_resolventTerm_tilt
    w.re (1 / 2) x hn thetaCuspLogSeed
  have hnHalf : 0 ≤ (n : ℝ) ^ (-(1 / 2 : ℝ)) :=
    Real.rpow_nonneg (Nat.cast_nonneg n) _
  have hnTilt : 0 ≤ (n : ℝ) ^ (-(1 / 2 + w.re : ℝ)) :=
    Real.rpow_nonneg (Nat.cast_nonneg n) _
  have htiltAbs := congrArg abs htilt
  simp only [abs_mul, abs_of_pos (Real.exp_pos _), abs_of_nonneg hnHalf,
    abs_of_nonneg hnTilt, logTranslate] at htiltAbs
  rw [finitePrimeThetaCuspLaplaceTerm, norm_mul, Complex.norm_real,
    Complex.norm_exp, mul_re, ofReal_re, ofReal_im, Real.norm_eq_abs]
  simp only [mul_zero, sub_zero]
  rw [show thetaCuspSourceTerm x n =
      (n : ℝ) ^ (-(1 / 2 : ℝ)) *
        logTranslate (Real.log n) thetaCuspLogSeed x by exact hsource.symm]
  rw [abs_mul, abs_of_nonneg hnHalf, thetaCuspLogSeedAbsWeight]
  calc
    (n : ℝ) ^ (-(1 / 2 : ℝ)) *
          |thetaCuspLogSeed (x + Real.log n)| * Real.exp (w.re * x) =
        Real.exp (w.re * x) * ((n : ℝ) ^ (-(1 / 2 : ℝ)) *
          |thetaCuspLogSeed (x + Real.log n)|) := by ring
    _ = _ := htiltAbs

theorem integrable_finitePrimeThetaCuspLaplaceTerm
    (w : ℂ) (hw : 0 < w.re) {n : ℕ} (hn : 0 < n) :
    Integrable (finitePrimeThetaCuspLaplaceTerm w n) := by
  have hbase := (integrable_thetaCuspLogSeedAbsWeight
    (a := w.re) (by linarith : -(5 / 2 : ℝ) < w.re)).comp_add_right (Real.log n)
  have hnorm : Integrable (fun x : ℝ =>
      ‖finitePrimeThetaCuspLaplaceTerm w n x‖) := by
    simpa only [norm_finitePrimeThetaCuspLaplaceTerm w hn] using
      hbase.const_mul ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ)))
  exact (integrable_norm_iff (by
    unfold finitePrimeThetaCuspLaplaceTerm thetaCuspSourceTerm thetaCuspSeed
    fun_prop)).mp hnorm

theorem integral_norm_finitePrimeThetaCuspLaplaceTerm
    (w : ℂ) {n : ℕ} (hn : 0 < n) :
    (∫ x : ℝ, ‖finitePrimeThetaCuspLaplaceTerm w n x‖) =
      ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
        ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y := by
  rw [MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall
    (norm_finitePrimeThetaCuspLaplaceTerm w hn)),
    MeasureTheory.integral_const_mul]
  exact congrArg (((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) * ·)
    (integral_add_right_eq_self (thetaCuspLogSeedAbsWeight w.re) (Real.log n))

/-- Bilateral Laplace integrand of the actual finite-prime theta-cusp source. -/
def finitePrimeThetaCuspLaplaceIntegrand (N : ℕ) (w : ℂ) (x : ℝ) : ℂ :=
  (finitePrimeThetaCuspSource N x : ℂ) * Complex.exp (w * (x : ℂ))

/-- The actual finite-prime source has an absolutely convergent bilateral Laplace transform
throughout the packet half-plane. -/
theorem integrable_finitePrimeThetaCuspLaplaceIntegrand
    (N : ℕ) (w : ℂ) (hw : 0 < w.re) :
    Integrable (finitePrimeThetaCuspLaplaceIntegrand N w) := by
  have hterm : ∀ n : (N + 1).smoothNumbers,
      Integrable (finitePrimeThetaCuspLaplaceTerm w n) := by
    intro n
    exact integrable_finitePrimeThetaCuspLaplaceTerm w hw
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))
  let C : ℝ := ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y
  have hsum : Summable (fun n : (N + 1).smoothNumbers =>
      ∫ x : ℝ, ‖finitePrimeThetaCuspLaplaceTerm w n x‖) := by
    have hp := (summable_smoothNumbers_rpow_neg N
      (show 0 < 1 / 2 + w.re by linarith)).mul_right C
    refine hp.congr fun n => ?_
    rw [integral_norm_finitePrimeThetaCuspLaplaceTerm w
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))]
  have hTsum := GaloisForLFunctions.HTGeometry.integrable_tsum_of_summable_integral_norm
    hterm hsum
  apply hTsum.congr
  filter_upwards with x
  unfold finitePrimeThetaCuspLaplaceIntegrand finitePrimeThetaCuspSource
  rw [Complex.ofReal_tsum, ← tsum_mul_right]
  rfl

/-- Single smooth-number summand in the first-moment bilateral Laplace transform. -/
def finitePrimeThetaCuspMomentLaplaceTerm
    (w : ℂ) (n : ℕ) (x : ℝ) : ℂ :=
  (x : ℂ) * finitePrimeThetaCuspLaplaceTerm w n x

/-- Integrable majorant retaining the logarithmic translation cost exactly. -/
def finitePrimeThetaCuspMomentLaplaceMajor
    (w : ℂ) (n : ℕ) (x : ℝ) : ℝ :=
  ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
    (thetaCuspLogSeedFirstAbsWeight w.re (x + Real.log n) +
      Real.log n * thetaCuspLogSeedAbsWeight w.re (x + Real.log n))

theorem norm_finitePrimeThetaCuspMomentLaplaceTerm_le
    (w : ℂ) {n : ℕ} (hn : 0 < n) (x : ℝ) :
    ‖finitePrimeThetaCuspMomentLaplaceTerm w n x‖ ≤
      finitePrimeThetaCuspMomentLaplaceMajor w n x := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hlog : 0 ≤ Real.log n := Real.log_nonneg (by exact_mod_cast hn)
  have hx : |x| ≤ |x + Real.log n| + Real.log n := by
    calc
      |x| = |(x + Real.log n) - Real.log n| := by congr 1; ring
      _ ≤ |x + Real.log n| + |Real.log n| := abs_sub _ _
      _ = |x + Real.log n| + Real.log n := by rw [abs_of_nonneg hlog]
  have hpow : 0 ≤ (n : ℝ) ^ (-(1 / 2 + w.re : ℝ)) :=
    Real.rpow_nonneg hnR.le _
  have hweight : 0 ≤ thetaCuspLogSeedAbsWeight w.re (x + Real.log n) := by
    unfold thetaCuspLogSeedAbsWeight
    positivity
  rw [finitePrimeThetaCuspMomentLaplaceTerm, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, norm_finitePrimeThetaCuspLaplaceTerm w hn]
  unfold finitePrimeThetaCuspMomentLaplaceMajor
  calc
    |x| * ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ)) *
          thetaCuspLogSeedAbsWeight w.re (x + Real.log n)) =
        ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
          (|x| * thetaCuspLogSeedAbsWeight w.re (x + Real.log n)) := by ring
    _ ≤ ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
          ((|x + Real.log n| + Real.log n) *
            thetaCuspLogSeedAbsWeight w.re (x + Real.log n)) := by
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right hx hweight) hpow
    _ = ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
          (thetaCuspLogSeedFirstAbsWeight w.re (x + Real.log n) +
            Real.log n * thetaCuspLogSeedAbsWeight w.re (x + Real.log n)) := by
          unfold thetaCuspLogSeedFirstAbsWeight thetaCuspLogSeedAbsWeight
          ring

theorem integrable_finitePrimeThetaCuspMomentLaplaceMajor
    (w : ℂ) (hw : 0 < w.re) (n : ℕ) :
    Integrable (finitePrimeThetaCuspMomentLaplaceMajor w n) := by
  have hfirst := (integrable_thetaCuspLogSeedFirstAbsWeight hw).comp_add_right
    (Real.log n)
  have hzero := (integrable_thetaCuspLogSeedAbsWeight
    (a := w.re) (by linarith : -(5 / 2 : ℝ) < w.re)).comp_add_right (Real.log n)
  exact (hfirst.add (hzero.const_mul (Real.log n))).const_mul
    ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ)))

theorem integrable_finitePrimeThetaCuspMomentLaplaceTerm
    (w : ℂ) (hw : 0 < w.re) {n : ℕ} (hn : 0 < n) :
    Integrable (finitePrimeThetaCuspMomentLaplaceTerm w n) := by
  apply Integrable.mono (integrable_finitePrimeThetaCuspMomentLaplaceMajor w hw n)
  · unfold finitePrimeThetaCuspMomentLaplaceTerm finitePrimeThetaCuspLaplaceTerm
      thetaCuspSourceTerm thetaCuspSeed
    fun_prop
  · apply Filter.Eventually.of_forall
    intro x
    have hlog : 0 ≤ Real.log n := Real.log_nonneg (by exact_mod_cast hn)
    have hmajor0 : 0 ≤ finitePrimeThetaCuspMomentLaplaceMajor w n x := by
      unfold finitePrimeThetaCuspMomentLaplaceMajor thetaCuspLogSeedFirstAbsWeight
        thetaCuspLogSeedAbsWeight
      positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hmajor0]
    exact norm_finitePrimeThetaCuspMomentLaplaceTerm_le w hn x

theorem integral_norm_finitePrimeThetaCuspMomentLaplaceTerm_le
    (w : ℂ) (hw : 0 < w.re) {n : ℕ} (hn : 0 < n) :
    (∫ x : ℝ, ‖finitePrimeThetaCuspMomentLaplaceTerm w n x‖) ≤
      ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
        ((∫ y : ℝ, thetaCuspLogSeedFirstAbsWeight w.re y) +
          Real.log n * ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y) := by
  have hfirst := (integrable_thetaCuspLogSeedFirstAbsWeight hw).comp_add_right
    (Real.log n)
  have hzero := (integrable_thetaCuspLogSeedAbsWeight
    (a := w.re) (by linarith : -(5 / 2 : ℝ) < w.re)).comp_add_right (Real.log n)
  have hmajor := integrable_finitePrimeThetaCuspMomentLaplaceMajor w hw n
  have hle : (∫ x : ℝ, ‖finitePrimeThetaCuspMomentLaplaceTerm w n x‖) ≤
      ∫ x : ℝ, finitePrimeThetaCuspMomentLaplaceMajor w n x := by
    exact integral_mono
      (integrable_finitePrimeThetaCuspMomentLaplaceTerm w hw hn).norm hmajor
      (norm_finitePrimeThetaCuspMomentLaplaceTerm_le w hn)
  calc
    (∫ x : ℝ, ‖finitePrimeThetaCuspMomentLaplaceTerm w n x‖) ≤
        ∫ x : ℝ, finitePrimeThetaCuspMomentLaplaceMajor w n x := hle
    _ = ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
        ((∫ y : ℝ, thetaCuspLogSeedFirstAbsWeight w.re y) +
          Real.log n * ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y) := by
      unfold finitePrimeThetaCuspMomentLaplaceMajor
      rw [MeasureTheory.integral_const_mul,
        MeasureTheory.integral_add hfirst (hzero.const_mul (Real.log n)),
        MeasureTheory.integral_const_mul,
        integral_add_right_eq_self (thetaCuspLogSeedFirstAbsWeight w.re) (Real.log n),
        integral_add_right_eq_self (thetaCuspLogSeedAbsWeight w.re) (Real.log n)]

/-- Bilateral Laplace integrand of the actual finite-prime first-moment source. -/
def finitePrimeThetaCuspMomentLaplaceIntegrand
    (N : ℕ) (w : ℂ) (x : ℝ) : ℂ :=
  (finitePrimeThetaCuspMomentSource N x : ℂ) * Complex.exp (w * (x : ℂ))

/-- The actual finite-prime first-moment source has an absolutely convergent bilateral Laplace
transform throughout the packet half-plane. -/
theorem integrable_finitePrimeThetaCuspMomentLaplaceIntegrand
    (N : ℕ) (w : ℂ) (hw : 0 < w.re) :
    Integrable (finitePrimeThetaCuspMomentLaplaceIntegrand N w) := by
  have hterm : ∀ n : (N + 1).smoothNumbers,
      Integrable (finitePrimeThetaCuspMomentLaplaceTerm w n) := by
    intro n
    exact integrable_finitePrimeThetaCuspMomentLaplaceTerm w hw
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))
  let C1 : ℝ := ∫ y : ℝ, thetaCuspLogSeedFirstAbsWeight w.re y
  let C0 : ℝ := ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y
  have hC1 : 0 ≤ C1 := integral_nonneg fun y => by
    dsimp [C1, thetaCuspLogSeedFirstAbsWeight]
    positivity
  have hC0 : 0 ≤ C0 := integral_nonneg fun y => by
    dsimp [C0, thetaCuspLogSeedAbsWeight]
    positivity
  have hmajorSum : Summable (fun n : (N + 1).smoothNumbers =>
      ((n : ℕ) : ℝ) ^ (-(1 / 2 + w.re : ℝ)) *
        (C1 + Real.log (n : ℕ) * C0)) := by
    have hp := (summable_smoothNumbers_rpow_neg N
      (show 0 < 1 / 2 + w.re by linarith)).mul_right C1
    have hlogp := (summable_smoothNumbers_log_mul_rpow_neg N
      (show 0 < 1 / 2 + w.re by linarith)).mul_right C0
    refine (hp.add hlogp).congr fun n => ?_
    ring
  have hsum : Summable (fun n : (N + 1).smoothNumbers =>
      ∫ x : ℝ, ‖finitePrimeThetaCuspMomentLaplaceTerm w n x‖) := by
    refine Summable.of_norm_bounded hmajorSum ?_
    intro n
    rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg fun x => norm_nonneg _)]
    exact integral_norm_finitePrimeThetaCuspMomentLaplaceTerm_le w hw
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))
  have hTsum := GaloisForLFunctions.HTGeometry.integrable_tsum_of_summable_integral_norm
    hterm hsum
  apply hTsum.congr
  filter_upwards with x
  unfold finitePrimeThetaCuspMomentLaplaceIntegrand finitePrimeThetaCuspMomentSource
    finitePrimeThetaCuspSource
  rw [Complex.ofReal_mul, Complex.ofReal_tsum, ← tsum_mul_left, ← tsum_mul_right]
  apply tsum_congr
  intro n
  unfold finitePrimeThetaCuspMomentLaplaceTerm finitePrimeThetaCuspLaplaceTerm
  ring

/-- Single smooth-number summand in the generator-source bilateral Laplace transform. -/
def finitePrimeThetaCuspGeneratorLaplaceTerm
    (w : ℂ) (n : ℕ) (x : ℝ) : ℂ :=
  (Real.log n : ℂ) * finitePrimeThetaCuspLaplaceTerm w n x

theorem integrable_finitePrimeThetaCuspGeneratorLaplaceTerm
    (w : ℂ) (hw : 0 < w.re) {n : ℕ} (hn : 0 < n) :
    Integrable (finitePrimeThetaCuspGeneratorLaplaceTerm w n) := by
  exact (integrable_finitePrimeThetaCuspLaplaceTerm w hw hn).const_mul
    (Real.log n : ℂ)

theorem integral_norm_finitePrimeThetaCuspGeneratorLaplaceTerm
    (w : ℂ) {n : ℕ} (hn : 0 < n) :
    (∫ x : ℝ, ‖finitePrimeThetaCuspGeneratorLaplaceTerm w n x‖) =
      Real.log n * ((n : ℝ) ^ (-(1 / 2 + w.re : ℝ))) *
        ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y := by
  have hlog : 0 ≤ Real.log n := Real.log_nonneg (by exact_mod_cast hn)
  unfold finitePrimeThetaCuspGeneratorLaplaceTerm
  simp_rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hlog]
  rw [MeasureTheory.integral_const_mul,
    integral_norm_finitePrimeThetaCuspLaplaceTerm w hn]
  ring

/-- Bilateral Laplace integrand of the complete finite von Mangoldt generator source. -/
def finitePrimeThetaCuspGeneratorLaplaceIntegrand
    (N : ℕ) (w : ℂ) (x : ℝ) : ℂ :=
  (finitePrimeThetaCuspGeneratorSource N x : ℂ) * Complex.exp (w * (x : ℂ))

theorem integrable_finitePrimeThetaCuspGeneratorLaplaceIntegrand
    (N : ℕ) (w : ℂ) (hw : 0 < w.re) :
    Integrable (finitePrimeThetaCuspGeneratorLaplaceIntegrand N w) := by
  have hterm : ∀ n : (N + 1).smoothNumbers,
      Integrable (finitePrimeThetaCuspGeneratorLaplaceTerm w n) := by
    intro n
    exact integrable_finitePrimeThetaCuspGeneratorLaplaceTerm w hw
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))
  let C0 : ℝ := ∫ y : ℝ, thetaCuspLogSeedAbsWeight w.re y
  have hsum : Summable (fun n : (N + 1).smoothNumbers =>
      ∫ x : ℝ, ‖finitePrimeThetaCuspGeneratorLaplaceTerm w n x‖) := by
    have hp := (summable_smoothNumbers_log_mul_rpow_neg N
      (show 0 < 1 / 2 + w.re by linarith)).mul_right C0
    refine hp.congr fun n => ?_
    rw [integral_norm_finitePrimeThetaCuspGeneratorLaplaceTerm w
      (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_smoothNumbers n.property))]
  have hTsum := GaloisForLFunctions.HTGeometry.integrable_tsum_of_summable_integral_norm
    hterm hsum
  apply hTsum.congr
  filter_upwards with x
  unfold finitePrimeThetaCuspGeneratorLaplaceIntegrand
  rw [finitePrimeThetaCuspGeneratorSource_eq_response,
    finitePrimeVonMangoldtResolventResponse_eq_logMoment]
  unfold finitePrimeThetaCuspLogMoment
  rw [Complex.ofReal_tsum, ← tsum_mul_right]
  apply tsum_congr
  intro n
  unfold finitePrimeThetaCuspGeneratorLaplaceTerm finitePrimeThetaCuspLaplaceTerm
  push_cast
  ring

/-- Bilateral Laplace integrand of the finite-degree archimedean response source. -/
def finitePrimeThetaCuspArchLaplaceIntegrand
    (N : ℕ) (w : ℂ) (x : ℝ) : ℂ :=
  (finitePrimeThetaCuspArchMoment N x : ℂ) * Complex.exp (w * (x : ℂ))

theorem finitePrimeThetaCuspArchLaplaceIntegrand_eq_moment_add_generator
    (N : ℕ) (w : ℂ) :
    finitePrimeThetaCuspArchLaplaceIntegrand N w =
      finitePrimeThetaCuspMomentLaplaceIntegrand N w +
        finitePrimeThetaCuspGeneratorLaplaceIntegrand N w := by
  funext x
  have hsplit := congrFun (finitePrimeThetaCuspMomentSource_eq_arch_sub_prime N) x
  dsimp only [Pi.sub_apply] at hsplit
  have harch : finitePrimeThetaCuspArchMoment N x =
      finitePrimeThetaCuspMomentSource N x +
        finitePrimeVonMangoldtResolventResponse N thetaCuspLogSeed x := by
    linarith
  unfold finitePrimeThetaCuspArchLaplaceIntegrand
    finitePrimeThetaCuspMomentLaplaceIntegrand
    finitePrimeThetaCuspGeneratorLaplaceIntegrand
  rw [finitePrimeThetaCuspGeneratorSource_eq_response, harch]
  push_cast
  simp only [Pi.add_apply]
  ring

theorem integrable_finitePrimeThetaCuspArchLaplaceIntegrand
    (N : ℕ) (w : ℂ) (hw : 0 < w.re) :
    Integrable (finitePrimeThetaCuspArchLaplaceIntegrand N w) := by
  rw [finitePrimeThetaCuspArchLaplaceIntegrand_eq_moment_add_generator]
  exact (integrable_finitePrimeThetaCuspMomentLaplaceIntegrand N w hw).add
    (integrable_finitePrimeThetaCuspGeneratorLaplaceIntegrand N w hw)

/-- Bilateral Laplace transform of the finite-prime source. -/
def finitePrimeThetaCuspLaplace (N : ℕ) (w : ℂ) : ℂ :=
  ∫ x : ℝ, finitePrimeThetaCuspLaplaceIntegrand N w x

/-- Bilateral Laplace transform of the finite-prime first-moment source. -/
def finitePrimeThetaCuspMomentLaplace (N : ℕ) (w : ℂ) : ℂ :=
  ∫ x : ℝ, finitePrimeThetaCuspMomentLaplaceIntegrand N w x

/-- Bilateral Laplace transform of the finite-degree archimedean source. -/
def finitePrimeThetaCuspArchLaplace (N : ℕ) (w : ℂ) : ℂ :=
  ∫ x : ℝ, finitePrimeThetaCuspArchLaplaceIntegrand N w x

/-- Bilateral Laplace transform of the complete prime-power generator source. -/
def finitePrimeThetaCuspGeneratorLaplace (N : ℕ) (w : ℂ) : ℂ :=
  ∫ x : ℝ, finitePrimeThetaCuspGeneratorLaplaceIntegrand N w x

theorem finitePrimeThetaCuspMomentLaplace_eq_arch_sub_generator
    (N : ℕ) (w : ℂ) (hw : 0 < w.re) :
    finitePrimeThetaCuspMomentLaplace N w =
      finitePrimeThetaCuspArchLaplace N w -
        finitePrimeThetaCuspGeneratorLaplace N w := by
  rw [finitePrimeThetaCuspMomentLaplace, finitePrimeThetaCuspArchLaplace,
    finitePrimeThetaCuspGeneratorLaplace,
    ← MeasureTheory.integral_sub
      (integrable_finitePrimeThetaCuspArchLaplaceIntegrand N w hw)
      (integrable_finitePrimeThetaCuspGeneratorLaplaceIntegrand N w hw)]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with x
  have h := congrFun (finitePrimeThetaCuspArchLaplaceIntegrand_eq_moment_add_generator N w) x
  dsimp only [Pi.add_apply] at h
  rw [h]
  ring

/-! ## Equation (25): the actual source window -/

/-- Public finite exponential sum on the positive half-line. -/
def halfLineExpSum {d : ℕ} (a w : Fin d → ℂ) (s : ℝ) : ℂ :=
  ∑ j, a j * Complex.exp (-(w j) * (s : ℂ))

theorem integrableOn_halfLineExpSum_mul_conj {d : ℕ}
    (a b w : Fin d → ℂ) (hw : ∀ j, 0 < (w j).re) :
    IntegrableOn (fun s : ℝ => halfLineExpSum a w s *
      conj (halfLineExpSum b w s)) (Ioi (0 : ℝ)) := by
  exact integrableOn_expSum_mul_conj a b w hw

theorem integral_halfLineExpSum_mul_conj {d : ℕ}
    (a b w : Fin d → ℂ) (hw : ∀ j, 0 < (w j).re) :
    (∫ s in Ioi (0 : ℝ), halfLineExpSum a w s * conj (halfLineExpSum b w s)) =
      ∑ j, ∑ l, a j * conj (b l) / (w j + conj (w l)) := by
  exact integral_expSum_mul_conj a b w hw

theorem integral_norm_sq_halfLineExpSum {d : ℕ}
    (a w : Fin d → ℂ) (hw : ∀ j, 0 < (w j).re) :
    ((∫ s in Ioi (0 : ℝ), ‖halfLineExpSum a w s‖ ^ 2 : ℝ) : ℂ) =
      ∑ j, ∑ l, a j * conj (a l) / (w j + conj (w l)) := by
  exact integral_norm_sq_eq_expSum a w hw

theorem integrable_sourcePacketMode
    (f : ℝ → ℝ) (w c : ℂ) (s : ℝ)
    (hf : Integrable fun x : ℝ => (f x : ℂ) * Complex.exp (w * (x : ℂ))) :
    Integrable fun x : ℝ => (f (x + s) : ℂ) *
      (c * Complex.exp (w * (x : ℂ))) := by
  have hshift := (hf.mul_const
    (c * Complex.exp (-(w * (s : ℂ))))).comp_add_right s
  apply hshift.congr
  filter_upwards with x
  have hexp : Complex.exp (w * ((x + s : ℝ) : ℂ)) *
      Complex.exp (-(w * (s : ℂ))) = Complex.exp (w * (x : ℂ)) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    (f (x + s) : ℂ) * Complex.exp (w * ((x + s : ℝ) : ℂ)) *
          (c * Complex.exp (-(w * (s : ℂ)))) =
        (f (x + s) : ℂ) * c *
          (Complex.exp (w * ((x + s : ℝ) : ℂ)) *
            Complex.exp (-(w * (s : ℂ)))) := by ring
    _ = (f (x + s) : ℂ) * (c * Complex.exp (w * (x : ℂ))) := by
      rw [hexp]
      ring

theorem sourcePacketIntegralWindow_expPacket_eq_halfLineExpSum
    (f : ℝ → ℝ) {d : ℕ} (c w : Fin d → ℂ) (s : ℝ)
    (hf : ∀ j, Integrable fun x : ℝ =>
      (f x : ℂ) * Complex.exp (w j * (x : ℂ))) :
    sourcePacketIntegralWindow f (expPacketFn c w) s =
      halfLineExpSum
        (fun j => c j * ∫ x : ℝ, (f x : ℂ) * Complex.exp (w j * (x : ℂ))) w s := by
  unfold sourcePacketIntegralWindow expPacketFn halfLineExpSum
  simp_rw [Finset.mul_sum]
  rw [MeasureTheory.integral_finsetSum _ (fun j _ =>
    integrable_sourcePacketMode f (w j) (c j) s (hf j))]
  apply Finset.sum_congr rfl
  intro j hj
  have htranslate := integral_add_right_eq_self (μ := (volume : Measure ℝ))
    (fun y : ℝ => (f y : ℂ) * (c j * Complex.exp (w j * ((y : ℂ) - (s : ℂ))))) s
  calc
    (∫ x : ℝ, (f (x + s) : ℂ) *
          (c j * Complex.exp (w j * (x : ℂ)))) =
        ∫ x : ℝ, (f (x + s) : ℂ) *
          (c j * Complex.exp (w j * (((x + s : ℝ) : ℂ) - (s : ℂ)))) := by
            apply MeasureTheory.integral_congr_ae
            filter_upwards with x
            congr 3
            push_cast
            ring
    _ = ∫ y : ℝ, (f y : ℂ) *
          (c j * Complex.exp (w j * ((y : ℂ) - (s : ℂ)))) := htranslate
    _ = ∫ y : ℝ, ((f y : ℂ) * Complex.exp (w j * (y : ℂ))) *
          (c j * Complex.exp (-(w j) * (s : ℂ))) := by
            apply MeasureTheory.integral_congr_ae
            filter_upwards with y
            have hexp : Complex.exp (w j * ((y : ℂ) - (s : ℂ))) =
                Complex.exp (w j * (y : ℂ)) *
                  Complex.exp (-(w j) * (s : ℂ)) := by
              rw [← Complex.exp_add]
              congr 1
              ring
            rw [hexp]
            ring
    _ = (∫ y : ℝ, (f y : ℂ) * Complex.exp (w j * (y : ℂ))) *
          (c j * Complex.exp (-(w j) * (s : ℂ))) := by
            rw [MeasureTheory.integral_mul_const]
    _ = (c j * ∫ y : ℝ, (f y : ℂ) * Complex.exp (w j * (y : ℂ))) *
          Complex.exp (-(w j) * (s : ℂ)) := by ring

/-- Frequencies in the exact packet half-plane from equation (2). -/
abbrev PositiveLaplaceFrequency := {w : ℂ // 0 < w.re}

/-- Equation (25) for the finite-prime theta-cusp source. -/
def finitePrimeThetaCuspPacketWindow {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) : ℂ :=
  sourcePacketIntegralWindow (finitePrimeThetaCuspSource N)
    (expPacketFn c (fun j => w j)) s

/-- Equation (25) for the first-moment source. -/
def finitePrimeThetaCuspMomentPacketWindow {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) : ℂ :=
  sourcePacketIntegralWindow (finitePrimeThetaCuspMomentSource N)
    (expPacketFn c (fun j => w j)) s

/-- Equation (25) for the finite-degree archimedean response source. -/
def finitePrimeThetaCuspArchPacketWindow {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) : ℂ :=
  sourcePacketIntegralWindow (finitePrimeThetaCuspArchMoment N)
    (expPacketFn c (fun j => w j)) s

/-- Equation (25) for the complete prime-power generator source. -/
def finitePrimeThetaCuspGeneratorPacketWindow {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) : ℂ :=
  sourcePacketIntegralWindow (finitePrimeThetaCuspGeneratorSource N)
    (expPacketFn c (fun j => w j)) s

theorem finitePrimeThetaCuspPacketWindow_eq_halfLineExpSum {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) :
    finitePrimeThetaCuspPacketWindow N c w s =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspLaplace N (w j))
        (fun j => w j) s := by
  unfold finitePrimeThetaCuspPacketWindow
  simpa only [finitePrimeThetaCuspLaplace, finitePrimeThetaCuspLaplaceIntegrand] using
    sourcePacketIntegralWindow_expPacket_eq_halfLineExpSum
      (finitePrimeThetaCuspSource N) c (fun j => (w j : ℂ)) s
      (fun j => integrable_finitePrimeThetaCuspLaplaceIntegrand N (w j) (w j).property)

theorem finitePrimeThetaCuspMomentPacketWindow_eq_halfLineExpSum {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) :
    finitePrimeThetaCuspMomentPacketWindow N c w s =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspMomentLaplace N (w j))
        (fun j => w j) s := by
  unfold finitePrimeThetaCuspMomentPacketWindow
  simpa only [finitePrimeThetaCuspMomentLaplace,
    finitePrimeThetaCuspMomentLaplaceIntegrand] using
    sourcePacketIntegralWindow_expPacket_eq_halfLineExpSum
      (finitePrimeThetaCuspMomentSource N) c (fun j => (w j : ℂ)) s
      (fun j => integrable_finitePrimeThetaCuspMomentLaplaceIntegrand N (w j) (w j).property)

theorem finitePrimeThetaCuspArchPacketWindow_eq_halfLineExpSum {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) :
    finitePrimeThetaCuspArchPacketWindow N c w s =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspArchLaplace N (w j))
        (fun j => w j) s := by
  unfold finitePrimeThetaCuspArchPacketWindow
  simpa only [finitePrimeThetaCuspArchLaplace, finitePrimeThetaCuspArchLaplaceIntegrand] using
    sourcePacketIntegralWindow_expPacket_eq_halfLineExpSum
      (finitePrimeThetaCuspArchMoment N) c (fun j => (w j : ℂ)) s
      (fun j => integrable_finitePrimeThetaCuspArchLaplaceIntegrand N (w j) (w j).property)

theorem finitePrimeThetaCuspGeneratorPacketWindow_eq_halfLineExpSum {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) :
    finitePrimeThetaCuspGeneratorPacketWindow N c w s =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspGeneratorLaplace N (w j))
        (fun j => w j) s := by
  unfold finitePrimeThetaCuspGeneratorPacketWindow
  simpa only [finitePrimeThetaCuspGeneratorLaplace,
    finitePrimeThetaCuspGeneratorLaplaceIntegrand] using
    sourcePacketIntegralWindow_expPacket_eq_halfLineExpSum
      (finitePrimeThetaCuspGeneratorSource N) c (fun j => (w j : ℂ)) s
      (fun j => integrable_finitePrimeThetaCuspGeneratorLaplaceIntegrand N (w j) (w j).property)

/-- Equation (24) after applying the concrete integral window (25). -/
theorem finitePrimeThetaCuspMomentPacketWindow_eq_arch_sub_generator {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) (s : ℝ) :
    finitePrimeThetaCuspMomentPacketWindow N c w s =
      finitePrimeThetaCuspArchPacketWindow N c w s -
        finitePrimeThetaCuspGeneratorPacketWindow N c w s := by
  rw [finitePrimeThetaCuspMomentPacketWindow_eq_halfLineExpSum,
    finitePrimeThetaCuspArchPacketWindow_eq_halfLineExpSum,
    finitePrimeThetaCuspGeneratorPacketWindow_eq_halfLineExpSum]
  unfold halfLineExpSum
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j hj
  simp only
  rw [finitePrimeThetaCuspMomentLaplace_eq_arch_sub_generator N (w j) (w j).property]
  ring

/-! ## Genuine half-line L² windows and equation (26) -/

theorem continuous_halfLineExpSum {d : ℕ} (a w : Fin d → ℂ) :
    Continuous (halfLineExpSum a w) := by
  unfold halfLineExpSum
  fun_prop

theorem integrableOn_norm_sq_halfLineExpSum {d : ℕ}
    (a w : Fin d → ℂ) (hw : ∀ j, 0 < (w j).re) :
    IntegrableOn (fun s : ℝ => ‖halfLineExpSum a w s‖ ^ 2) (Ioi (0 : ℝ)) := by
  have hp := integrableOn_halfLineExpSum_mul_conj a a w hw
  have hc : IntegrableOn (fun s : ℝ => ((‖halfLineExpSum a w s‖ ^ 2 : ℝ) : ℂ))
      (Ioi (0 : ℝ)) := by
    apply hp.congr
    filter_upwards with s
    rw [Complex.mul_conj']
    push_cast
    ring
  exact hc.re.congr (Filter.Eventually.of_forall fun s => by
    norm_num [pow_two])

theorem memLp_two_halfLineExpSum {d : ℕ}
    (a w : Fin d → ℂ) (hw : ∀ j, 0 < (w j).re) :
    MemLp (halfLineExpSum a w) 2 (volume.restrict (Ioi (0 : ℝ))) := by
  apply (memLp_two_iff_integrable_sq_norm
    (continuous_halfLineExpSum a w).aestronglyMeasurable).2
  exact integrableOn_norm_sq_halfLineExpSum a w hw

theorem finitePrimeThetaCuspPacketWindow_memLp_two {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    MemLp (finitePrimeThetaCuspPacketWindow N c w) 2
      (volume.restrict (Ioi (0 : ℝ))) := by
  rw [show finitePrimeThetaCuspPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspPacketWindow_eq_halfLineExpSum N c w s]
  exact memLp_two_halfLineExpSum _ _ (fun j => (w j).property)

theorem finitePrimeThetaCuspMomentPacketWindow_memLp_two {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    MemLp (finitePrimeThetaCuspMomentPacketWindow N c w) 2
      (volume.restrict (Ioi (0 : ℝ))) := by
  rw [show finitePrimeThetaCuspMomentPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspMomentLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspMomentPacketWindow_eq_halfLineExpSum N c w s]
  exact memLp_two_halfLineExpSum _ _ (fun j => (w j).property)

theorem finitePrimeThetaCuspArchPacketWindow_memLp_two {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    MemLp (finitePrimeThetaCuspArchPacketWindow N c w) 2
      (volume.restrict (Ioi (0 : ℝ))) := by
  rw [show finitePrimeThetaCuspArchPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspArchLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspArchPacketWindow_eq_halfLineExpSum N c w s]
  exact memLp_two_halfLineExpSum _ _ (fun j => (w j).property)

theorem finitePrimeThetaCuspGeneratorPacketWindow_memLp_two {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
