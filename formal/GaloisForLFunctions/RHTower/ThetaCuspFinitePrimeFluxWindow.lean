/-- Left side of equation (26): concrete critical first-variation flux in the half-line L²
pairing supplied by equation (25). -/
def finitePrimeThetaCuspPacketCriticalFlux {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) : ℝ :=
  2 * (∫ s in Ioi (0 : ℝ), finitePrimeThetaCuspMomentPacketWindow N c w s *
    conj (finitePrimeThetaCuspPacketWindow N c w s)).re

/-- Finite-degree archimedean term in the concrete equation (26) pairing. -/
def finitePrimeThetaCuspPacketArchFlux {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) : ℝ :=
  2 * (∫ s in Ioi (0 : ℝ), finitePrimeThetaCuspArchPacketWindow N c w s *
    conj (finitePrimeThetaCuspPacketWindow N c w s)).re

/-- Complete von Mangoldt prime-power term in the concrete equation (26) pairing. -/
def finitePrimeThetaCuspPacketGeneratorFlux {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) : ℝ :=
  2 * (∫ s in Ioi (0 : ℝ), finitePrimeThetaCuspGeneratorPacketWindow N c w s *
    conj (finitePrimeThetaCuspPacketWindow N c w s)).re

/-- **Equation (26), unconditional concrete form.**  For every finite packet with frequencies
carried by the positive Laplace half-plane, the genuine half-line L² critical flux is exactly the
finite-degree archimedean response minus the complete prime-power generator response. -/
theorem finitePrimeThetaCuspPacketCriticalFlux_eq_arch_sub_generator {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    finitePrimeThetaCuspPacketCriticalFlux N c w =
      finitePrimeThetaCuspPacketArchFlux N c w -
        finitePrimeThetaCuspPacketGeneratorFlux N c w := by
  rw [finitePrimeThetaCuspPacketCriticalFlux, finitePrimeThetaCuspPacketArchFlux,
    finitePrimeThetaCuspPacketGeneratorFlux]
  have harch := integrableOn_finitePrimeThetaCuspArchWindow_mul_conj_source N c w
  have hgen := integrableOn_finitePrimeThetaCuspGeneratorWindow_mul_conj_source N c w
  rw [MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun s => by
    rw [finitePrimeThetaCuspMomentPacketWindow_eq_arch_sub_generator])]
  simp_rw [sub_mul]
  rw [MeasureTheory.integral_sub harch hgen]
  simp only [Complex.sub_re]
  ring

end RHTower
