theorem integrableOn_finitePrimeThetaCuspGeneratorWindow_mul_conj_source {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    IntegrableOn (fun s : ℝ => finitePrimeThetaCuspGeneratorPacketWindow N c w s *
