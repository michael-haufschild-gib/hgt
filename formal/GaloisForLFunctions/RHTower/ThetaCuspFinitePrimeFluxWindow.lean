  exact memLp_two_halfLineExpSum _ _ (fun j => (w j).property)

/-- Exact half-line L² Cauchy Gram for the concrete equation (25) source window. -/
theorem integral_norm_sq_finitePrimeThetaCuspPacketWindow {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    ((∫ s in Ioi (0 : ℝ), ‖finitePrimeThetaCuspPacketWindow N c w s‖ ^ 2 : ℝ) : ℂ) =
      ∑ j, ∑ l,
        (c j * finitePrimeThetaCuspLaplace N (w j)) *
          conj (c l * finitePrimeThetaCuspLaplace N (w l)) /
            ((w j : ℂ) + conj (w l : ℂ)) := by
  rw [show finitePrimeThetaCuspPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspPacketWindow_eq_halfLineExpSum N c w s]
  exact integral_norm_sq_halfLineExpSum _ _ (fun j => (w j).property)

theorem integrableOn_finitePrimeThetaCuspMomentWindow_mul_conj_source {d : ℕ}
    (N : ℕ) (c : Fin d → ℂ) (w : Fin d → PositiveLaplaceFrequency) :
    IntegrableOn (fun s : ℝ => finitePrimeThetaCuspMomentPacketWindow N c w s *
      conj (finitePrimeThetaCuspPacketWindow N c w s)) (Ioi (0 : ℝ)) := by
  rw [show finitePrimeThetaCuspMomentPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspMomentLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspMomentPacketWindow_eq_halfLineExpSum N c w s,
    show finitePrimeThetaCuspPacketWindow N c w =
      halfLineExpSum (fun j => c j * finitePrimeThetaCuspLaplace N (w j))
        (fun j => w j) by
    funext s
    exact finitePrimeThetaCuspPacketWindow_eq_halfLineExpSum N c w s]
  exact integrableOn_halfLineExpSum_mul_conj _ _ _ (fun j => (w j).property)

