import GaloisForLFunctions.RHTower.GaussWeightedTsumCauchy

/-!
# Coefficientwise form of the Gauss double defect

The norm estimate in `GaussDoubleDefect` is global.  Cubic propagation needs its unsquared
coefficient chain before one more multiplier is applied.  This module exposes that exact two-defect
majorant.
-/

namespace RHTower

open MeasureTheory GaloisForLFunctions

noncomputable section

/-- Harmonic coefficient kernel generated by `B⁻²` after the first smooth defect. -/
def gaussDoubleDefectCoeffKernel (p : Nat.Primes) (j l : ℤ) : ℝ :=
  8 * (p : ℝ) /
    ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ)))

theorem gaussDoubleDefectCoeffKernel_nonneg (p : Nat.Primes) (j l : ℤ) :
    0 ≤ gaussDoubleDefectCoeffKernel p j l := by
  rw [gaussDoubleDefectCoeffKernel]
  positivity

theorem summable_gaussDoubleDefectCoeffMajorant
    {m : ℕ} (hm : 1 ≤ m) (k : Fin m) (p : Nat.Primes) (i j : ℤ) :
    Summable (fun l : ℤ => gaussDoubleDefectCoeffKernel p j l *
      ‖gaussSampleRatioDefect k p j i‖ * ‖gaussSampleRatioDefect k p l i‖) := by
  set Rmax : ℝ :=
    1 + gaussSampleValueBound hm k p / ‖gaussSampleValue k p i‖ with hRmax
  have hRmax0 : 0 ≤ Rmax := by
    have h1 := gaussSampleValueBound_nonneg hm k p
    have h2 : 0 ≤ gaussSampleValueBound hm k p / ‖gaussSampleValue k p i‖ := by positivity
    rw [hRmax]
    linarith
  have hρ : ∀ l : ℤ, ‖gaussSampleRatioDefect k p l i‖ ≤ Rmax :=
    fun l => norm_gaussSampleRatioDefect_le_uniform hm k p i l
  have hmaj : Summable (fun l : ℤ =>
      (8 * (p : ℝ) * ‖gaussSampleRatioDefect k p j i‖ * Rmax) *
        (1 / ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))))) :=
    (summable_harmonicPairKernel j).mul_left _
  refine Summable.of_nonneg_of_le (fun l =>
    mul_nonneg (mul_nonneg (gaussDoubleDefectCoeffKernel_nonneg p j l) (norm_nonneg _))
      (norm_nonneg _)) (fun l => ?_) hmaj
  rw [gaussDoubleDefectCoeffKernel]
  calc
    8 * (p : ℝ) /
          ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))) *
          ‖gaussSampleRatioDefect k p j i‖ * ‖gaussSampleRatioDefect k p l i‖
        ≤ 8 * (p : ℝ) /
            ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))) *
            ‖gaussSampleRatioDefect k p j i‖ * Rmax := by
          exact mul_le_mul_of_nonneg_left (hρ l) (by positivity)
    _ = (8 * (p : ℝ) * ‖gaussSampleRatioDefect k p j i‖ * Rmax) *
        (1 / ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ)))) := by ring

/-- The literal double-defect coefficient is bounded by one true convolution index and two
sampled-ratio defects. -/
theorem norm_fourierCoeff_gaussDoubleDefectVector_le
    {m : ℕ} (hm : 1 ≤ m) (k : Fin m) (p : Nat.Primes)
    (hp : (1 : ℝ) < (p : ℝ)) (i j : ℤ) :
    ‖fourierCoeff ((gaussDoubleDefectVector hm k p hp i :
        AddCircle (1 : ℝ) → ℂ)) j‖ ≤
      ∑' l : ℤ, gaussDoubleDefectCoeffKernel p j l *
        ‖gaussSampleRatioDefect k p j i‖ * ‖gaussSampleRatioDefect k p l i‖ := by
  set δ : AddCircle (1 : ℝ) :=
    ((gaussSamplePhase m p i : ℝ) : AddCircle (1 : ℝ)) with hδ
  set b : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ))) :=
    gaussPrimeScaleBlock hp (fourierLp 2 0) with hb
  set w : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ))) :=
    gaussShiftedBlockOf hm k p i b - gaussRotationBlock δ b with hw
  set v : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ))) :=
    gaussPrimeScaleInvSqBlock hp w with hv
  set DD : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ))) :=
    gaussDoubleDefectVector hm k p hp i with hDD
  have hDDcoeff :
      ‖fourierCoeff ((DD : AddCircle (1 : ℝ) → ℂ)) j‖ =
        ‖fourierCoeff ((v : AddCircle (1 : ℝ) → ℂ)) j‖ *
          ‖gaussSampleRatioDefect k p j i‖ := by
    have hsub : fourierCoeff ((DD : AddCircle (1 : ℝ) → ℂ)) j =
        fourierCoeff ((gaussShiftedBlockDiag hm k p i v : AddCircle (1 : ℝ) → ℂ)) j -
          fourierCoeff ((gaussRotationBlockInv δ v : AddCircle (1 : ℝ) → ℂ)) j := by
      rw [← fourierBasis_repr, ← fourierBasis_repr, ← fourierBasis_repr, hDD,
        gaussDoubleDefectVector, ← hδ, ← hb, ← hw, ← hv, map_sub]
      rfl
    rw [hsub, hδ, norm_fourierCoeff_shiftedBlockDiag_sub_rotationInv hm k p]
  have hwcoeff : ∀ l : ℤ,
      ‖fourierCoeff ((w : AddCircle (1 : ℝ) → ℂ)) l‖ ≤
        4 * (p : ℝ) / (1 + (l.natAbs : ℝ)) *
          ‖gaussSampleRatioDefect k p l i‖ := by
    intro l
    have hsub : fourierCoeff ((w : AddCircle (1 : ℝ) → ℂ)) l =
        fourierCoeff ((gaussShiftedBlockOf hm k p i b : AddCircle (1 : ℝ) → ℂ)) l -
          fourierCoeff ((gaussRotationBlock δ b : AddCircle (1 : ℝ) → ℂ)) l := by
      rw [← fourierBasis_repr, ← fourierBasis_repr, ← fourierBasis_repr, hw, map_sub]
      rfl
    have hval : ‖fourierCoeff ((w : AddCircle (1 : ℝ) → ℂ)) l‖ =
        ‖fourierCoeff ((b : AddCircle (1 : ℝ) → ℂ)) l‖ *
          ‖gaussSampleRatioDefect k p l i‖ := by
      rw [hsub, hδ, norm_fourierCoeff_shiftedBlockOf_sub_rotation hm k p]
    rw [hval]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    have hpow : (gaussMovingAmplitudeBlock hp ((0 : ℝ) : AddCircle (1 : ℝ)) ^ 0)
        (fourierLp 2 0) =
          (fourierLp 2 0 : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ)))) := by
      rw [pow_zero]
      rfl
    have hbound := norm_fourierCoeff_gaussPrimeScaleBlock_amplitudePow hp
      (le_refl (0 : ℝ)) (by norm_num : (0 : ℝ) < 1) 0 l
    rw [hpow, zero_add, pow_one] at hbound
    exact hbound
  set Rmax : ℝ :=
    1 + gaussSampleValueBound hm k p / ‖gaussSampleValue k p i‖ with hRmax
  have hRmax0 : 0 ≤ Rmax := by
    have h1 := gaussSampleValueBound_nonneg hm k p
    have h2 : 0 ≤ gaussSampleValueBound hm k p / ‖gaussSampleValue k p i‖ := by positivity
    rw [hRmax]
    linarith
  have hρ : ∀ l : ℤ, ‖gaussSampleRatioDefect k p l i‖ ≤ Rmax :=
    fun l => norm_gaussSampleRatioDefect_le_uniform hm k p i l
  have htermnn : ∀ l : ℤ, 0 ≤ gaussDoubleDefectCoeffKernel p j l *
      ‖gaussSampleRatioDefect k p l i‖ := by
    intro l
    exact mul_nonneg (gaussDoubleDefectCoeffKernel_nonneg p j l) (norm_nonneg _)
  have hsummable : Summable (fun l : ℤ => gaussDoubleDefectCoeffKernel p j l *
      ‖gaussSampleRatioDefect k p l i‖) := by
    have hmaj : Summable (fun l : ℤ =>
        (8 * (p : ℝ) * Rmax) *
          (1 / ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))))) :=
      (summable_harmonicPairKernel j).mul_left _
    refine Summable.of_nonneg_of_le htermnn (fun l => ?_) hmaj
    rw [gaussDoubleDefectCoeffKernel]
    calc
      8 * (p : ℝ) /
            ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))) *
          ‖gaussSampleRatioDefect k p l i‖
          ≤ 8 * (p : ℝ) /
              ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ))) * Rmax := by
            exact mul_le_mul_of_nonneg_left (hρ l) (by positivity)
      _ = (8 * (p : ℝ) * Rmax) *
          (1 / ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ)))) := by ring
  have hvcoeff : ‖fourierCoeff ((v : AddCircle (1 : ℝ) → ℂ)) j‖ ≤
      ∑' l : ℤ, gaussDoubleDefectCoeffKernel p j l *
        ‖gaussSampleRatioDefect k p l i‖ := by
    have hconv := norm_fourierCoeff_gaussPrimeScaleInvSqBlock_le hp w j
    rw [← hv] at hconv
    refine hconv.trans ?_
    have hleft : Summable (fun l : ℤ =>
        2 / (1 + ((l - j).natAbs : ℝ)) *
          ‖fourierCoeff ((w : AddCircle (1 : ℝ) → ℂ)) l‖) :=
      summable_harmonicKernel_mul_fourierCoeff
        (κ := fun x => 2 / (1 + (x.natAbs : ℝ))) (A := 2)
        (fun x => by positivity) (fun x => le_rfl) w j
    refine hleft.tsum_le_tsum (fun l => ?_) hsummable
    calc
      2 / (1 + ((l - j).natAbs : ℝ)) *
          ‖fourierCoeff ((w : AddCircle (1 : ℝ) → ℂ)) l‖
          ≤ 2 / (1 + ((l - j).natAbs : ℝ)) *
              (4 * (p : ℝ) / (1 + (l.natAbs : ℝ)) *
                ‖gaussSampleRatioDefect k p l i‖) := by
            exact mul_le_mul_of_nonneg_left (hwcoeff l) (by positivity)
      _ = gaussDoubleDefectCoeffKernel p j l *
          ‖gaussSampleRatioDefect k p l i‖ := by
        rw [gaussDoubleDefectCoeffKernel]
        field_simp
        ring
  rw [hDDcoeff]
  refine (mul_le_mul_of_nonneg_right hvcoeff (norm_nonneg _)).trans ?_
  rw [← hsummable.tsum_mul_right]
  exact le_of_eq (tsum_congr fun l => by ring)

end

end RHTower
