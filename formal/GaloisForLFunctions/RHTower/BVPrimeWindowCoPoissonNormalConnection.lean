import GaloisForLFunctions.RHTower.BVPrimeWindowDilationOrientation
import Mathlib.RingTheory.Derivation.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# BV prime-window sources as co-Poisson normal classes

This file records the algebraic connection behind the pole-cancelled BV source.

For a principal multiplier ideal `I = (Λ)`, differentiation does not generally
descend to `A / I`: its failure to preserve `I` is precisely the transverse
class

`Λ g ↦ [D Λ · g] ∈ A / I`.

The induced map on `I` kills `I²`, so it is a conormal map.  For the completed
zeta multiplier, the pole-cancelled BV source is the sum of a multiple of `Λ`
and this normal class.  On a zero fibre, only the normal class survives.

These statements are algebraic/analytic connection laws.  They do not assert
the Hilbert-space sign or contraction needed by the terminal RH criterion.
-/

open Complex Filter MeasureTheory Set Topology

noncomputable section

namespace RHTower

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Principal source ideal generated by the completed multiplier. -/
def principalSourceIdeal (Λ : A) : Ideal A := Ideal.span {Λ}

/--
Normal derivative of a principal source ideal.

The Leibniz defect that would obstruct `D` from descending to the quotient
vanishes because its coefficient lies in the principal ideal.
-/
def principalSourceNormalDerivative
    (D : Derivation R A A) (Λ : A) :
    principalSourceIdeal Λ →ₗ[A] A ⧸ principalSourceIdeal Λ where
  toFun x := Ideal.Quotient.mk (principalSourceIdeal Λ) (D x.1)
  map_add' x y := by
    simp only [Submodule.coe_add, map_add]
  map_smul' a x := by
    change Ideal.Quotient.mk (principalSourceIdeal Λ) (D (a * x.1)) =
      a • Ideal.Quotient.mk (principalSourceIdeal Λ) (D x.1)
    rw [D.leibniz]
    change Ideal.Quotient.mk (principalSourceIdeal Λ) (a * D x.1 + x.1 * D a) =
      Ideal.Quotient.mk (principalSourceIdeal Λ) (a * D x.1)
    simp only [map_add, map_mul]
    have hx : Ideal.Quotient.mk (principalSourceIdeal Λ) x.1 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr x.2
    rw [hx, zero_mul, add_zero]

/-- On a generator multiple, the normal derivative is `[D Λ · g]`. -/
theorem principalSourceNormalDerivative_generator_mul
    (D : Derivation R A A) (Λ g : A) :
    principalSourceNormalDerivative D Λ
        ⟨Λ * g, (principalSourceIdeal Λ).mul_mem_right g
          (Ideal.subset_span (Set.mem_singleton Λ))⟩ =
      Ideal.Quotient.mk (principalSourceIdeal Λ) (D Λ * g) := by
  change Ideal.Quotient.mk (principalSourceIdeal Λ) (D (Λ * g)) =
    Ideal.Quotient.mk (principalSourceIdeal Λ) (D Λ * g)
  rw [D.leibniz]
  change Ideal.Quotient.mk (principalSourceIdeal Λ) (Λ * D g + g * D Λ) =
    Ideal.Quotient.mk (principalSourceIdeal Λ) (D Λ * g)
  simp only [map_add, map_mul]
  have hΛ : Ideal.Quotient.mk (principalSourceIdeal Λ) Λ = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_singleton Λ))
  rw [hΛ, zero_mul, zero_add]
  exact mul_comm _ _

/-- The normal derivative kills products of two source-ideal elements. -/
theorem principalSourceNormalDerivative_mul_eq_zero
    (D : Derivation R A A) (Λ : A)
    (x y : principalSourceIdeal Λ) :
    principalSourceNormalDerivative D Λ
        ⟨x.1 * y.1, (principalSourceIdeal Λ).mul_mem_left x.1 y.2⟩ = 0 := by
  change Ideal.Quotient.mk (principalSourceIdeal Λ) (D (x.1 * y.1)) = 0
  rw [D.leibniz]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact (principalSourceIdeal Λ).add_mem
    ((principalSourceIdeal Λ).mul_mem_right (D y.1) x.2)
    ((principalSourceIdeal Λ).mul_mem_right (D x.1) y.2)

namespace CompactBVPrimeWindow

/-- Completed zeta multiplier in the BV source variable. -/
def coPoissonMultiplier (s : ℂ) : ℂ :=
  regularizedRiemannZeta (s - 1 / 2)

/-- Transverse derivative class carried by a compact BV prime window. -/
def coPoissonNormalClass (W : CompactBVPrimeWindow) (s : ℂ) : ℂ :=
  2 * W.mellinTransform s *
    deriv regularizedRiemannZeta (s - 1 / 2)

/-- Pole-cancelled source written before division by the completed multiplier. -/
def coPoissonCancelledSource (W : CompactBVPrimeWindow) (s : ℂ) : ℂ :=
  coPoissonMultiplier s * dslope W.poleNumerator (3 / 2) s +
    W.coPoissonNormalClass s -
    2 * coPoissonMultiplier s * W.errorSeries s

/-- Exact tangential-plus-normal decomposition of the cancelled source. -/
theorem coPoissonCancelledSource_eq_multiplier_mul_add_normal
    (W : CompactBVPrimeWindow) (s : ℂ) :
    W.coPoissonCancelledSource s =
      coPoissonMultiplier s *
          (dslope W.poleNumerator (3 / 2) s - 2 * W.errorSeries s) +
        W.coPoissonNormalClass s := by
  simp only [coPoissonCancelledSource, coPoissonNormalClass, coPoissonMultiplier]
  ring

/-- On a completed-zeta zero fibre, the cancelled source is purely normal. -/
theorem coPoissonCancelledSource_eq_normal_of_multiplier_eq_zero
    (W : CompactBVPrimeWindow) {s : ℂ}
    (hzero : coPoissonMultiplier s = 0) :
    W.coPoissonCancelledSource s = W.coPoissonNormalClass s := by
  rw [W.coPoissonCancelledSource_eq_multiplier_mul_add_normal, hzero, zero_mul, zero_add]

/-- Away from the divisor, cancellation recovers the existing continued source. -/
theorem coPoissonCancelledSource_eq_mul_continuedSource
    (W : CompactBVPrimeWindow) {s : ℂ}
    (hΛ : coPoissonMultiplier s ≠ 0) :
    W.coPoissonCancelledSource s =
      coPoissonMultiplier s * W.continuedSource s := by
  rw [coPoissonCancelledSource, coPoissonMultiplier, coPoissonNormalClass,
    continuedSource, poleFilledMain, logDeriv_apply]
  have hc : regularizedRiemannZeta (s - 1 / 2) *
      (regularizedRiemannZeta (s - 1 / 2))⁻¹ = 1 :=
    mul_inv_cancel₀ hΛ
  rw [mul_sub, mul_add]
  rw [show regularizedRiemannZeta (s - 1 / 2) *
      (2 * W.mellinTransform s *
        (deriv regularizedRiemannZeta (s - 1 / 2) /
          regularizedRiemannZeta (s - 1 / 2))) =
      2 * W.mellinTransform s *
        deriv regularizedRiemannZeta (s - 1 / 2) by
    rw [div_eq_mul_inv]
    calc
      regularizedRiemannZeta (s - 1 / 2) *
          (2 * W.mellinTransform s *
            (deriv regularizedRiemannZeta (s - 1 / 2) *
              (regularizedRiemannZeta (s - 1 / 2))⁻¹)) =
        (regularizedRiemannZeta (s - 1 / 2) *
          (regularizedRiemannZeta (s - 1 / 2))⁻¹) *
          (2 * W.mellinTransform s *
            deriv regularizedRiemannZeta (s - 1 / 2)) := by ring
      _ = _ := by rw [hc, one_mul]; norm_num]
  ring

/-- The cancelled source is analytic throughout the right half-plane. -/
theorem differentiableOn_coPoissonCancelledSource_rightHalf
    (W : CompactBVPrimeWindow) :
    DifferentiableOn ℂ W.coPoissonCancelledSource
      {s : ℂ | 1 / 2 < s.re} := by
  intro s hs
  let U : Set ℂ := {z : ℂ | 1 / 2 < z.re}
  have hUopen : IsOpen U := isOpen_lt continuous_const Complex.continuous_re
  have hshift : AnalyticAt ℂ (fun z : ℂ => z - 1 / 2) s := by fun_prop
  have hΛbase : AnalyticAt ℂ regularizedRiemannZeta (s - 1 / 2) :=
    (differentiable_regularizedRiemannZeta.differentiableOn.analyticOnNhd
      isOpen_univ) _ (Set.mem_univ _)
  have hΛ : AnalyticAt ℂ
      (fun z : ℂ => regularizedRiemannZeta (z - 1 / 2)) s :=
    AnalyticAt.comp (f := fun z : ℂ => z - 1 / 2) (x := s) hΛbase hshift
  have hDΛ : AnalyticAt ℂ
      (fun z : ℂ => deriv regularizedRiemannZeta (z - 1 / 2)) s :=
    AnalyticAt.comp (f := fun z : ℂ => z - 1 / 2) (x := s) hΛbase.deriv hshift
  have hD : AnalyticAt ℂ
      (dslope W.poleNumerator (3 / 2)) s :=
    (W.differentiable_poleDividedDifference.differentiableOn.analyticOnNhd
      isOpen_univ) s (Set.mem_univ s)
  have hM : AnalyticAt ℂ W.mellinTransform s :=
    (W.differentiable_mellinTransform.differentiableOn.analyticOnNhd
      isOpen_univ) s (Set.mem_univ s)
  have hE : AnalyticAt ℂ W.errorSeries s :=
    (W.differentiableOn_errorSeries_rightHalf.analyticOnNhd hUopen) s hs
  have hTwo : AnalyticAt ℂ (fun _ : ℂ => (2 : ℂ)) s := analyticAt_const
  have hSource : AnalyticAt ℂ W.coPoissonCancelledSource s := by
    simpa only [coPoissonCancelledSource, coPoissonMultiplier,
      coPoissonNormalClass] using
      ((hΛ.mul hD).add ((hTwo.mul hM).mul hDΛ)).sub
        ((hTwo.mul hΛ).mul hE)
  exact hSource.differentiableWithinAt

/-- Normal class has exact BV argument-dilation covariance. -/
theorem coPoissonNormalClass_argumentDilation
    (W : CompactBVPrimeWindow) (r : ℝ) (hr : 0 < r) (s : ℂ) :
    (W.argumentDilation r hr).coPoissonNormalClass s =
      (r : ℂ) ^ (s - 1) * W.coPoissonNormalClass s := by
  rw [coPoissonNormalClass, coPoissonNormalClass,
    mellinTransform_argumentDilation]
  ring

/-- Normal class has exact BV argument-expansion covariance. -/
theorem coPoissonNormalClass_argumentExpansion
    (W : CompactBVPrimeWindow) (r : ℝ) (hr : 0 < r) (s : ℂ) :
    (W.argumentExpansion r hr).coPoissonNormalClass s =
      (r : ℂ) ^ (1 - s) * W.coPoissonNormalClass s := by
  rw [coPoissonNormalClass, coPoissonNormalClass,
    mellinTransform_argumentExpansion]
  ring

end CompactBVPrimeWindow

end RHTower
