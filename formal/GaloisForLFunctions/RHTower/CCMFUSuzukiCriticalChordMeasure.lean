import GaloisForLFunctions.RHTower.CCMFUSuzukiCompletedRieszGraphEnergy
import GaloisForLFunctions.RHTower.CCMFUSuzukiSecondGradeAsymptotic
import GaloisForLFunctions.RHTower.SeamRealAxisGrowth
import GaloisForLFunctions.RHTower.ShiftedEulerMobiusSynthesis
import GaloisForLFunctions.RHTower.SuzukiTailSummatoryErrorTransform
import GaloisForLFunctions.RHTower.VonMangoldtConvHarmonicSummatory
import GaloisForLFunctions.RHTower.ZetaResidueFactorDerivative
import GaloisForLFunctions.HTGeometry.ShiftedEulerThirdTangent
import GaloisForLFunctions.HTGeometry.VonMangoldtSelfConvolution
import Mathlib.Analysis.Calculus.LHopital

/-!
# Positive critical chords of the Suzuki source

For every positive displacement `ω`, the secant from the critical Suzuki coefficient `c₀` to
`c_ω` is a positive atomic measure away from the unit atom.  The matching polar secant is positive
as well.  This module keeps those two positive carriers coupled and proves their exact finite
square-root Riesz transport before scalarization.

The resulting identity is not a positivity claim for the completed error: it is a
positive-atomic-minus-positive-polar decomposition, with the Gamma boundary retained exactly.
Consequently any future estimate may exploit cancellation between the two carriers instead of
destroying it by separate absolute values.
-/

open Filter Topology
open scoped BigOperators

namespace RHTower

noncomputable section

open ArithmeticFunction Finset

/-- Positive critical secant density of Suzuki's shifted Euler coefficient. -/
def suzukiCriticalChordCoefficient (ω : ℝ) (n : ℕ) : ℝ :=
  (suzukiShiftedCoefficient ω n - suzukiShiftedCoefficient 0 n) / (2 * ω)

/-- Suzuki's Euler-product coefficient is the existing signed Möbius synthesis coefficient. -/
theorem suzukiShiftedCoefficient_eq_shiftedEulerCoefficient
    (ω : ℝ) {n : ℕ} (hn : 1 ≤ n) :
    suzukiShiftedCoefficient ω n = shiftedEulerCoefficient ω n := by
  rw [shiftedEulerCoefficient_eq_prod ω (by omega : n ≠ 0)]
  rw [suzukiShiftedCoefficient]
  apply congrArg ((n : ℝ) ^ ω * ·)
  apply Finset.prod_congr rfl
  intro p _hp
  congr 2
  ring

/-- At the critical parameter every non-unit shifted Euler coefficient vanishes. -/
theorem suzukiShiftedCoefficient_zero_of_two_le {n : ℕ} (hn : 2 ≤ n) :
    suzukiShiftedCoefficient 0 n = 0 := by
  have hne : n.primeFactors.Nonempty := Nat.nonempty_primeFactors.mpr hn
  obtain ⟨p, hp⟩ := hne
  rw [suzukiShiftedCoefficient]
  rw [Finset.prod_eq_zero hp
    (by simp : (1 : ℝ) - (p : ℝ) ^ (-2 * (0 : ℝ)) = 0)]
  simp

/-- Suzuki's shifted Euler coefficient is exactly multiplicative across coprime arithmetic
labels.  This coefficient-level law is needed before taking critical secants. -/
theorem suzukiShiftedCoefficient_mul_of_coprime
    (ω : ℝ) {m n : ℕ} (hmn : m.Coprime n) :
    suzukiShiftedCoefficient ω (m * n) =
      suzukiShiftedCoefficient ω m * suzukiShiftedCoefficient ω n := by
  rw [suzukiShiftedCoefficient, suzukiShiftedCoefficient,
    suzukiShiftedCoefficient, hmn.primeFactors_mul, Nat.cast_mul,
    Real.mul_rpow (Nat.cast_nonneg m) (Nat.cast_nonneg n),
    Finset.prod_union hmn.disjoint_primeFactors]
  ring

/-- Critical chords acquire one explicit `2ω` factor across each nontrivial coprime product. -/
theorem suzukiCriticalChordCoefficient_mul_of_coprime
    {ω : ℝ} (hω : 0 < ω) {m n : ℕ} (hm : 2 ≤ m) (hn : 2 ≤ n)
    (hmn : m.Coprime n) :
    suzukiCriticalChordCoefficient ω (m * n) =
      2 * ω * suzukiCriticalChordCoefficient ω m *
        suzukiCriticalChordCoefficient ω n := by
  have hmn2 : 2 ≤ m * n := by nlinarith
  have hω0 : 2 * ω ≠ 0 := by positivity
  rw [suzukiCriticalChordCoefficient, suzukiCriticalChordCoefficient,
    suzukiCriticalChordCoefficient,
    suzukiShiftedCoefficient_zero_of_two_le hmn2,
    suzukiShiftedCoefficient_zero_of_two_le hm,
    suzukiShiftedCoefficient_zero_of_two_le hn,
    suzukiShiftedCoefficient_mul_of_coprime ω hmn]
  field_simp [hω0]
  simp

/-- The right critical chord is a positive atomic coefficient at every arithmetic site. -/
theorem suzukiCriticalChordCoefficient_nonneg
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 1 ≤ n) :
    0 ≤ suzukiCriticalChordCoefficient ω n := by
  rcases hn.eq_or_lt with rfl | hnlt
  · simp [suzukiCriticalChordCoefficient, suzukiShiftedCoefficient]
  · rw [suzukiCriticalChordCoefficient,
      suzukiShiftedCoefficient_zero_of_two_le (by omega : 2 ≤ n), sub_zero]
    exact div_nonneg (suzukiShiftedCoefficient_nonneg hω n) (by positivity)

/-- The positive critical chord is generated by a signed Möbius divisor sum.  Positivity appears
only after all divisor signs at the same arithmetic label have cancelled. -/
theorem suzukiCriticalChordCoefficient_eq_mobiusDivisor
    {ω : ℝ} (_hω : 0 < ω) {n : ℕ} (hn : 2 ≤ n) :
    suzukiCriticalChordCoefficient ω n =
      (n : ℝ) ^ ω / (2 * ω) *
        ∑ d ∈ n.divisors,
          (ArithmeticFunction.moebius d : ℝ) * (d : ℝ) ^ (-(2 * ω)) := by
  rw [suzukiCriticalChordCoefficient,
    suzukiShiftedCoefficient_zero_of_two_le hn, sub_zero,
    suzukiShiftedCoefficient_eq_shiftedEulerCoefficient ω (by omega : 1 ≤ n),
    shiftedEulerCoefficient_eq]
  ring

/-- Bounded logarithmic secant replacing the apparent `1 / ω` singularity inside each Möbius
divisor fibre. -/
def suzukiCriticalDampedLogKernel (ω : ℝ) (d : ℕ) : ℝ :=
  (1 - (d : ℝ) ^ (-(2 * ω))) / (2 * ω)

/-- The damped-log kernel is positive and never exceeds its zero-clock limit `log d`. -/
theorem suzukiCriticalDampedLogKernel_nonneg_le_log
    {ω : ℝ} (hω : 0 < ω) {d : ℕ} (hd : 1 ≤ d) :
    0 ≤ suzukiCriticalDampedLogKernel ω d ∧
      suzukiCriticalDampedLogKernel ω d ≤ Real.log d := by
  have hdpos : (0 : ℝ) < d := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hd)
  have hdone : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hlog : 0 ≤ Real.log (d : ℝ) := Real.log_nonneg hdone
  let x : ℝ := 2 * ω * Real.log d
  have hx : 0 ≤ x := by dsimp only [x]; positivity
  have hrpow : (d : ℝ) ^ (-(2 * ω)) = Real.exp (-x) := by
    rw [Real.rpow_def_of_pos hdpos]
    congr 1
    dsimp only [x]
    ring
  have hexple : Real.exp (-x) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
  have hone : 1 - Real.exp (-x) ≤ x := by
    linarith [Real.add_one_le_exp (-x)]
  rw [suzukiCriticalDampedLogKernel, hrpow]
  constructor
  · exact div_nonneg (sub_nonneg.mpr hexple) (by positivity)
  · rw [div_le_iff₀ (by positivity : (0 : ℝ) < 2 * ω)]
    dsimp only [x] at hone
    linarith

/-- **Fibrewise pole cancellation.**  For every non-unit label, the divisor identity
`∑_{d|n} μ(d)=0` absorbs the entire critical `1 / ω` debt before scalarization.  The remaining
kernel is uniformly trapped between `0` and `log d`. -/
theorem suzukiCriticalChordCoefficient_eq_renormalizedMobiusLog
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 2 ≤ n) :
    suzukiCriticalChordCoefficient ω n =
      (n : ℝ) ^ ω *
        ∑ d ∈ n.divisors,
          (-(ArithmeticFunction.moebius d : ℝ)) *
            suzukiCriticalDampedLogKernel ω d := by
  have hn1 : n ≠ 1 := by omega
  have hmuZ := sum_divisors_moebius n
  rw [if_neg hn1] at hmuZ
  have hmuR := congrArg (fun z : ℤ => (z : ℝ)) hmuZ
  push_cast at hmuR
  have hsum :
      (∑ d ∈ n.divisors,
        (ArithmeticFunction.moebius d : ℝ) *
          ((d : ℝ) ^ (-(2 * ω)) - 1)) =
        ∑ d ∈ n.divisors,
          (ArithmeticFunction.moebius d : ℝ) * (d : ℝ) ^ (-(2 * ω)) := by
    calc
      (∑ d ∈ n.divisors,
          (ArithmeticFunction.moebius d : ℝ) *
            ((d : ℝ) ^ (-(2 * ω)) - 1)) =
          (∑ d ∈ n.divisors,
            ((ArithmeticFunction.moebius d : ℝ) * (d : ℝ) ^ (-(2 * ω)) -
              (ArithmeticFunction.moebius d : ℝ))) := by
            apply Finset.sum_congr rfl
            intro d _hd
            ring
      _ = (∑ d ∈ n.divisors,
            (ArithmeticFunction.moebius d : ℝ) * (d : ℝ) ^ (-(2 * ω))) -
          ∑ d ∈ n.divisors, (ArithmeticFunction.moebius d : ℝ) := by
            rw [Finset.sum_sub_distrib]
      _ = _ := by rw [hmuR, sub_zero]
  rw [suzukiCriticalChordCoefficient_eq_mobiusDivisor hω hn, ← hsum]
  simp_rw [suzukiCriticalDampedLogKernel]
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro d _hd
  field_simp [(ne_of_gt hω)]
  ring

/-- Fibrewise renormalization also holds at the unit label, where both sides vanish. -/
theorem suzukiCriticalChordCoefficient_eq_renormalizedMobiusLog_all
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 1 ≤ n) :
    suzukiCriticalChordCoefficient ω n =
      (n : ℝ) ^ ω *
        ∑ d ∈ n.divisors,
          (-(ArithmeticFunction.moebius d : ℝ)) *
            suzukiCriticalDampedLogKernel ω d := by
  rcases hn.eq_or_lt with rfl | hnlt
  · simp [suzukiCriticalChordCoefficient, suzukiShiftedCoefficient,
      suzukiCriticalDampedLogKernel]
  · exact suzukiCriticalChordCoefficient_eq_renormalizedMobiusLog hω (by omega)

/-- The pole-free signed divisor fibre is itself nonnegative.  Thus all Möbius sign cancellation
needed to create the shifted-Euler positive atom occurs locally at one product label. -/
theorem sum_neg_moebius_mul_suzukiCriticalDampedLogKernel_nonneg
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 1 ≤ n) :
    0 ≤ ∑ d ∈ n.divisors,
      (-(ArithmeticFunction.moebius d : ℝ)) *
        suzukiCriticalDampedLogKernel ω d := by
  have hc := suzukiCriticalChordCoefficient_nonneg hω hn
  rw [suzukiCriticalChordCoefficient_eq_renormalizedMobiusLog_all hω hn] at hc
  have hnR : (0 : ℝ) < n := by
    exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
  exact nonneg_of_mul_nonneg_right hc (Real.rpow_pos_of_pos hnR ω)

/-- **Distinct-prime grade factorization.**  After local Möbius cancellation, every distinct
prime beyond the first contributes one explicit factor `2ω`.  Prime powers are therefore the
only nonzero grade at the critical clock, while all higher squarefree grades remain positive and
must be cancelled jointly by the polar continuum in a moving aperture. -/
theorem suzukiCriticalChordCoefficient_eq_distinctPrimeGrade
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 2 ≤ n) :
    suzukiCriticalChordCoefficient ω n =
      (n : ℝ) ^ ω * (2 * ω) ^ (n.primeFactors.card - 1) *
        ∏ p ∈ n.primeFactors, suzukiCriticalDampedLogKernel ω p := by
  have hω0 : 2 * ω ≠ 0 := by positivity
  have hcard : 1 ≤ n.primeFactors.card := by
    exact Finset.card_pos.mpr (Nat.nonempty_primeFactors.mpr hn)
  have hfactor : ∀ p ∈ n.primeFactors,
      1 - (p : ℝ) ^ (-2 * ω) =
        (2 * ω) * suzukiCriticalDampedLogKernel ω p := by
    intro p _hp
    rw [suzukiCriticalDampedLogKernel]
    field_simp [hω0]
  rw [suzukiCriticalChordCoefficient,
    suzukiShiftedCoefficient_zero_of_two_le hn, sub_zero,
    suzukiShiftedCoefficient]
  rw [Finset.prod_congr rfl hfactor, Finset.prod_mul_distrib]
  simp only [Finset.prod_const]
  have hpred : n.primeFactors.card - 1 + 1 = n.primeFactors.card :=
    Nat.sub_add_cancel hcard
  rw [← hpred, pow_succ]
  field_simp [hω0]
  rw [show n.primeFactors.card - 1 + 1 - 1 =
    n.primeFactors.card - 1 by omega]
  ring

/-- Every positive critical chord dominates its zero-clock von Mangoldt atom.  The surplus is
exactly higher-grade Suzuki mass; it is nonnegative pointwise and must be removed by the polar
continuum only after aggregation. -/
theorem vonMangoldt_le_suzukiCriticalChordCoefficient
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 1 ≤ n) :
    ArithmeticFunction.vonMangoldt n ≤ suzukiCriticalChordCoefficient ω n := by
  by_cases hpp : IsPrimePow n
  · obtain ⟨p, k, hp, hk, hpow⟩ := (isPrimePow_nat_iff n).mp hpp
    have hn2 : 2 ≤ n := hpp.one_lt
    have hpR : (0 : ℝ) < p := by exact_mod_cast hp.pos
    have hp1R : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    have hlogp : 0 < Real.log (p : ℝ) := Real.log_pos hp1R
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
    have hpdvd : p ∣ n := by
      rw [← hpow, pow_succ]
      exact dvd_mul_left p (p ^ j)
    have hpn : p ≤ n := Nat.le_of_dvd (by omega : 0 < n) hpdvd
    have hbase : (p : ℝ) ^ ω ≤ (n : ℝ) ^ ω :=
      Real.rpow_le_rpow (Nat.cast_nonneg p) (by exact_mod_cast hpn) hω.le
    have hK := (suzukiCriticalDampedLogKernel_nonneg_le_log hω hp.one_lt.le).1
    have hfacEq : 1 - (p : ℝ) ^ (-(2 * ω)) =
        (2 * ω) * suzukiCriticalDampedLogKernel ω p := by
      rw [suzukiCriticalDampedLogKernel]
      field_simp [(ne_of_gt hω)]
    have hfac0 : 0 ≤ 1 - (p : ℝ) ^ (-(2 * ω)) := by
      rw [hfacEq]
      positivity
    let x : ℝ := ω * Real.log p
    have hx : 0 ≤ x := by dsimp only [x]; positivity
    have hsinh : x ≤ Real.sinh x := Real.self_le_sinh_iff.mpr hx
    have hexpmul : Real.exp x * Real.exp (-2 * x) = Real.exp (-x) := by
      rw [← Real.exp_add]
      congr 1
      ring
    have hhyper :
        (p : ℝ) ^ ω * (1 - (p : ℝ) ^ (-(2 * ω))) / (2 * ω) =
          Real.sinh x / ω := by
      rw [Real.rpow_def_of_pos hpR, Real.rpow_def_of_pos hpR]
      have hx1 : Real.log (p : ℝ) * ω = x := by dsimp only [x]; ring
      have hx2 : Real.log (p : ℝ) * (-(2 * ω)) = -2 * x := by
        dsimp only [x]
        ring
      rw [hx1, hx2, mul_sub, mul_one, hexpmul, Real.sinh_eq]
      ring
    have hprimeLower : Real.log (p : ℝ) ≤
        (p : ℝ) ^ ω * (1 - (p : ℝ) ^ (-(2 * ω))) / (2 * ω) := by
      rw [hhyper, le_div_iff₀ hω]
      simpa only [x, mul_comm] using hsinh
    have hcompare :
        (p : ℝ) ^ ω * (1 - (p : ℝ) ^ (-(2 * ω))) / (2 * ω) ≤
          (n : ℝ) ^ ω * (1 - (p : ℝ) ^ (-(2 * ω))) / (2 * ω) := by
      exact (div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < 2 * ω)).2
        (mul_le_mul_of_nonneg_right hbase hfac0)
    have hvm : ArithmeticFunction.vonMangoldt n = Real.log p := by
      rw [← hpow, ArithmeticFunction.vonMangoldt_apply_pow (by omega : j + 1 ≠ 0),
        ArithmeticFunction.vonMangoldt_apply_prime hp]
    have hpfactors : n.primeFactors = {p} := by
      rw [← hpow, Nat.primeFactors_prime_pow (by omega : j + 1 ≠ 0) hp]
    rw [hvm, suzukiCriticalChordCoefficient,
      suzukiShiftedCoefficient_zero_of_two_le hn2, sub_zero,
      suzukiShiftedCoefficient, hpfactors,
      Finset.prod_singleton]
    apply hprimeLower.trans
    simpa only [neg_mul] using hcompare
  · rw [ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hpp]
    exact suzukiCriticalChordCoefficient_nonneg hω hn

/-- **Prime-power second-grade lower law.**  On `p^(k+1)`, the positive Suzuki chord contains the
von Mangoldt atom plus at least the next Euler grade `ω k (log p)^2`.  Hence higher prime powers
create a quantitatively positive surplus before any polar cancellation. -/
theorem suzukiCriticalChordCoefficient_primePower_secondGrade_lower
    {ω : ℝ} (hω : 0 < ω) {p k : ℕ} (hp : p.Prime) :
    Real.log (p : ℝ) + ω * k * (Real.log (p : ℝ)) ^ 2 ≤
      suzukiCriticalChordCoefficient ω (p ^ (k + 1)) := by
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hp1R : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hlogp : 0 < Real.log (p : ℝ) := Real.log_pos hp1R
  have hpow2 : 2 ≤ p ^ (k + 1) := by
    exact hp.two_le.trans (Nat.le_pow (by omega : 0 < k + 1))
  let x : ℝ := ω * Real.log p
  have hx : 0 ≤ x := by dsimp only [x]; positivity
  have hsinh : x ≤ Real.sinh x := Real.self_le_sinh_iff.mpr hx
  have hexp : (k : ℝ) * x + 1 ≤ Real.exp ((k : ℝ) * x) :=
    Real.add_one_le_exp ((k : ℝ) * x)
  have hleft0 : 0 ≤ (k : ℝ) * x + 1 := by positivity
  have hsinh0 : 0 ≤ Real.sinh x := hx.trans hsinh
  have hmul : ((k : ℝ) * x + 1) * x ≤
      Real.exp ((k : ℝ) * x) * Real.sinh x :=
    (mul_le_mul hexp hsinh hx (Real.exp_nonneg _))
  have hformula :
      suzukiCriticalChordCoefficient ω (p ^ (k + 1)) =
        Real.exp ((k : ℝ) * x) * Real.sinh x / ω := by
    rw [suzukiCriticalChordCoefficient,
      suzukiShiftedCoefficient_zero_of_two_le hpow2, sub_zero,
      suzukiShiftedCoefficient,
      Nat.primeFactors_prime_pow (by omega : k + 1 ≠ 0) hp,
      Finset.prod_singleton, Nat.cast_pow,
      Real.rpow_def_of_pos hpR]
    rw [Real.rpow_def_of_pos (pow_pos hpR _), Real.log_pow]
    have hxpow : (k + 1 : ℕ) * Real.log (p : ℝ) * ω = ((k : ℝ) + 1) * x := by
      dsimp only [x]
      push_cast
      ring
    have hxneg : Real.log (p : ℝ) * (-2 * ω) = -2 * x := by
      dsimp only [x]
      ring
    rw [hxpow, hxneg, Real.sinh_eq]
    have hexpmul :
        Real.exp (((k : ℝ) + 1) * x) * Real.exp (-2 * x) =
          Real.exp (((k : ℝ) - 1) * x) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rw [mul_sub, mul_one, hexpmul]
    have hsplit1 : Real.exp (((k : ℝ) + 1) * x) =
        Real.exp ((k : ℝ) * x) * Real.exp x := by
      rw [← Real.exp_add]
      congr 1
      ring
    have hsplit2 : Real.exp (((k : ℝ) - 1) * x) =
        Real.exp ((k : ℝ) * x) * Real.exp (-x) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rw [hsplit1, hsplit2]
    field_simp [ne_of_gt hω]
  rw [hformula, le_div_iff₀ hω]
  calc
    (Real.log (p : ℝ) + ω * k * (Real.log (p : ℝ)) ^ 2) * ω =
        ((k : ℝ) * x + 1) * x := by
      dsimp only [x]
      ring
    _ ≤ _ := hmul

/-- **Coprime second-grade lower law.**  Every coprime pair of nontrivial von Mangoldt atoms
injects its ordered two-prime Euler mass into the single product-label Suzuki chord. -/
theorem suzukiCriticalChordCoefficient_coprime_secondGrade_lower
    {ω : ℝ} (hω : 0 < ω) {m n : ℕ} (hm : 2 ≤ m) (hn : 2 ≤ n)
    (hmn : m.Coprime n) :
    2 * ω * ArithmeticFunction.vonMangoldt m * ArithmeticFunction.vonMangoldt n ≤
      suzukiCriticalChordCoefficient ω (m * n) := by
  rw [suzukiCriticalChordCoefficient_mul_of_coprime hω hm hn hmn]
  have hmle := vonMangoldt_le_suzukiCriticalChordCoefficient hω (by omega : 1 ≤ m)
  have hnle := vonMangoldt_le_suzukiCriticalChordCoefficient hω (by omega : 1 ≤ n)
  have hprod :
      ArithmeticFunction.vonMangoldt m * ArithmeticFunction.vonMangoldt n ≤
        suzukiCriticalChordCoefficient ω m *
          suzukiCriticalChordCoefficient ω n :=
    mul_le_mul hmle hnle ArithmeticFunction.vonMangoldt_nonneg
      (suzukiCriticalChordCoefficient_nonneg hω (by omega : 1 ≤ m))
  have hscale := mul_le_mul_of_nonneg_left hprod (by positivity : 0 ≤ 2 * ω)
  simpa only [mul_assoc] using hscale

/-- **Global two-grade Suzuki lower law.**  At every positive arithmetic label, the critical
Suzuki chord contains both the von Mangoldt grade and `ω` times its full Dirichlet
self-convolution.  The proof uses the complete one-prime/two-prime/support classification of
`Λ * Λ`; no Euler grade or sign is discarded. -/
theorem vonMangoldt_add_secondGrade_le_suzukiCriticalChordCoefficient
    {ω : ℝ} (hω : 0 < ω) {n : ℕ} (hn : 1 ≤ n) :
    ArithmeticFunction.vonMangoldt n +
        ω * ((ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n) ≤
      suzukiCriticalChordCoefficient ω n := by
  rcases hn.eq_or_lt with rfl | hnlt
  · simp [suzukiCriticalChordCoefficient, suzukiShiftedCoefficient]
  · have hn2 : 2 ≤ n := by omega
    have hn0 : n ≠ 0 := by omega
    have hcardpos : 1 ≤ n.primeFactors.card :=
      Finset.card_pos.mpr (Nat.nonempty_primeFactors.mpr hn2)
    rcases lt_trichotomy n.primeFactors.card 2 with hcardlt | hcardeq | hcardgt
    · have hcard : n.primeFactors.card = 1 := by omega
      obtain ⟨p, hfac⟩ := Finset.card_eq_one.mp hcard
      have hp : p.Prime := Nat.prime_of_mem_primeFactors (by rw [hfac]; simp)
      let a : ℕ := n.factorization p
      have hpMem : p ∈ n.primeFactors := by rw [hfac]; simp
      have ha0 : a ≠ 0 := by
        dsimp only [a]
        rw [← Nat.support_factorization] at hpMem
        exact fun h => (Finsupp.notMem_support_iff.mpr h) hpMem
      have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hpow : n = p ^ a :=
        GaloisForLFunctions.HTGeometry.eq_pow_factorization_of_primeFactors_singleton
          hn0 hfac
      have hbase := suzukiCriticalChordCoefficient_primePower_secondGrade_lower
        (ω := ω) (p := p) (k := a - 1) hω hp
      rw [Nat.sub_add_cancel ha1] at hbase
      rw [hpow,
        ArithmeticFunction.vonMangoldt_apply_pow ha0,
        ArithmeticFunction.vonMangoldt_apply_prime hp,
        GaloisForLFunctions.HTGeometry.vonMangoldt_mul_self_prime_pow hp ha1]
      simpa only [Nat.cast_sub ha1, Nat.cast_one, mul_assoc] using hbase
    · obtain ⟨p, q, hpq, hfac⟩ := Finset.card_eq_two.mp hcardeq
      have hp : p.Prime := Nat.prime_of_mem_primeFactors (by rw [hfac]; simp)
      have hq : q.Prime := Nat.prime_of_mem_primeFactors (by rw [hfac]; simp)
      have hpMem : p ∈ n.primeFactors := by rw [hfac]; simp
      have hqMem : q ∈ n.primeFactors := by rw [hfac]; simp
      let a : ℕ := n.factorization p
      let b : ℕ := n.factorization q
      have ha0 : a ≠ 0 := by
        dsimp only [a]
        rw [← Nat.support_factorization] at hpMem
        exact fun h => (Finsupp.notMem_support_iff.mpr h) hpMem
      have hb0 : b ≠ 0 := by
        dsimp only [b]
        rw [← Nat.support_factorization] at hqMem
        exact fun h => (Finsupp.notMem_support_iff.mpr h) hqMem
      have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hb1 : 1 ≤ b := Nat.one_le_iff_ne_zero.mpr hb0
      have hprod : p ^ a * q ^ b = n := by
        have h :=
          GaloisForLFunctions.HTGeometry.prod_primeFactors_pow_factorization hn0
        rwa [hfac, Finset.prod_pair hpq] at h
      have hpa2 : 2 ≤ p ^ a := hp.two_le.trans (Nat.le_pow ha1)
      have hqb2 : 2 ≤ q ^ b := hq.two_le.trans (Nat.le_pow hb1)
      have hcop : (p ^ a).Coprime (q ^ b) :=
        ((Nat.coprime_primes hp hq).2 hpq).pow a b
      have hpair := suzukiCriticalChordCoefficient_coprime_secondGrade_lower
        (ω := ω) hω hpa2 hqb2 hcop
      rw [hprod,
        ArithmeticFunction.vonMangoldt_apply_pow ha0,
        ArithmeticFunction.vonMangoldt_apply_pow hb0,
        ArithmeticFunction.vonMangoldt_apply_prime hp,
        ArithmeticFunction.vonMangoldt_apply_prime hq] at hpair
      have hnpp : ¬IsPrimePow n := by
        intro hpp
        rw [isPrimePow_iff_card_primeFactors_eq_one, hcardeq] at hpp
        omega
      rw [ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hnpp,
        GaloisForLFunctions.HTGeometry.vonMangoldt_mul_self_of_card_eq_two hcardeq,
        hfac, Finset.prod_pair hpq]
      nlinarith
    · have hthree : 3 ≤ n.primeFactors.card := by omega
      have hnpp : ¬IsPrimePow n := by
        intro hpp
        rw [isPrimePow_iff_card_primeFactors_eq_one] at hpp
        omega
      rw [ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hnpp,
        GaloisForLFunctions.HTGeometry.vonMangoldt_mul_self_eq_zero_of_three_le
          hthree]
      simpa using suzukiCriticalChordCoefficient_nonneg hω hn

/-- Critical chord coefficients converge individually to the von Mangoldt atoms. -/
theorem tendsto_suzukiCriticalChordCoefficient
    {n : ℕ} (hn : 1 ≤ n) :
    Tendsto (fun ω : ℝ => suzukiCriticalChordCoefficient ω n)
      (𝓝[>] 0) (𝓝 (ArithmeticFunction.vonMangoldt n)) := by
  have hslope := hasDerivAt_iff_tendsto_slope.mp
    (hasDerivAt_suzukiShiftedCoefficient hn)
  have hmono : 𝓝[>] (0 : ℝ) ≤ 𝓝[≠] 0 :=
    nhdsWithin_mono 0 (by
      intro ω hω
      simp only [Set.mem_Ioi] at hω
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      exact ne_of_gt hω)
  have hright := hslope.mono_left hmono
  have hhalf := hright.const_mul (1 / 2 : ℝ)
  convert hhalf using 1
  · funext ω
    simp only [suzukiCriticalChordCoefficient, slope, vsub_eq_sub, sub_zero, smul_eq_mul]
    ring
  · ring

/-- The literal real Suzuki coefficient is the real-axis restriction of the already formalized
entire shifted-Euler coefficient.  This is the bridge which transfers its complex tangent
filtration without re-deriving the prime-factor classification. -/
theorem suzukiShiftedCoefficient_ofReal_eq_shiftedEulerCoeff
    {n : ℕ} (hn : 1 ≤ n) (ω : ℝ) :
    ((suzukiShiftedCoefficient ω n : ℝ) : ℂ) =
      GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n (ω : ℂ) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  rw [suzukiShiftedCoefficient,
    GaloisForLFunctions.HTGeometry.shiftedEulerCoeff,
    Real.rpow_def_of_pos hnR]
  push_cast
  congr 1
  · ring
  · apply Finset.prod_congr rfl
    intro p hp
    have hpR : (0 : ℝ) < p := by
      exact_mod_cast (Nat.prime_of_mem_primeFactors hp).pos
    rw [Real.rpow_def_of_pos hpR, Complex.ofReal_exp]
    congr 2
    push_cast
    ring

/-- Real first jet of the entire shifted-Euler coefficient along Suzuki's clock. -/
def suzukiShiftedCoefficientComplexFirstJet (n : ℕ) (ω : ℝ) : ℝ :=
  (deriv (GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n) (ω : ℂ)).re

/-- The real Suzuki coefficient differentiates to the restricted complex first jet at every
clock. -/
theorem hasDerivAt_suzukiShiftedCoefficient_eq_complexFirstJet
    {n : ℕ} (hn : 1 ≤ n) (ω : ℝ) :
    HasDerivAt (fun u : ℝ => suzukiShiftedCoefficient u n)
      (suzukiShiftedCoefficientComplexFirstJet n ω) ω := by
  have hdiff : Differentiable ℂ
      (GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n) := by
    unfold GaloisForLFunctions.HTGeometry.shiftedEulerCoeff
    fun_prop
  have hc : HasDerivAt
      (fun u : ℝ =>
        GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n (u : ℂ))
      (deriv (GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n) (ω : ℂ)) ω :=
    hdiff.differentiableAt.hasDerivAt.comp_ofReal
  have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt ω hc
  have heq : (fun u : ℝ => suzukiShiftedCoefficient u n) =
      fun u : ℝ =>
        (GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n (u : ℂ)).re := by
    funext u
    have h := congrArg Complex.re
      (suzukiShiftedCoefficient_ofReal_eq_shiftedEulerCoeff hn u)
    simpa using h
  rw [heq]
  exact hre

/-- The restricted first jet at the critical clock is `2Λ`. -/
theorem suzukiShiftedCoefficientComplexFirstJet_zero (n : ℕ) :
    suzukiShiftedCoefficientComplexFirstJet n 0 =
      2 * ArithmeticFunction.vonMangoldt n := by
  have h := GaloisForLFunctions.HTGeometry.iteratedDeriv_one_shiftedEulerCoeff n
  simp only [iteratedDeriv_succ, iteratedDeriv_zero] at h
  rw [suzukiShiftedCoefficientComplexFirstJet]
  norm_num only [Complex.ofReal_zero]
  rw [h]
  norm_num

/-- The derivative of the restricted first jet is the exact full second Euler grade
`4(Λ * Λ)`. -/
theorem hasDerivAt_suzukiShiftedCoefficientComplexFirstJet_zero (n : ℕ) :
    HasDerivAt (suzukiShiftedCoefficientComplexFirstJet n)
      (4 * ((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n)) 0 := by
  let f := GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n
  have hdiff : Differentiable ℂ f := by
    dsimp only [f]
    unfold GaloisForLFunctions.HTGeometry.shiftedEulerCoeff
    fun_prop
  have han : AnalyticAt ℂ f 0 :=
    GaloisForLFunctions.HTGeometry.analyticAt_of_differentiable_univariate hdiff 0
  have hdcomplex : HasDerivAt (deriv f) (iteratedDeriv 2 f 0) 0 := by
    have hraw := han.deriv.differentiableAt.hasDerivAt
    have hiter : iteratedDeriv 2 f 0 = deriv (deriv f) 0 := by
      norm_num [iteratedDeriv_succ]
    rw [hiter]
    exact hraw
  have hdreal := hdcomplex.comp_ofReal
  have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt 0 hdreal
  have htwo := GaloisForLFunctions.HTGeometry.iteratedDeriv_two_shiftedEulerCoeff n
  change HasDerivAt (fun ω : ℝ => (deriv f (ω : ℂ)).re) _ 0
  have hre' : HasDerivAt (fun ω : ℝ => (deriv f (ω : ℂ)).re)
      (iteratedDeriv 2 f 0).re 0 := by
    simpa [Function.comp_def] using hre
  have htwof : iteratedDeriv 2 f 0 =
      4 * (((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n : ℝ) : ℂ) := by
    simpa only [f] using htwo
  rw [htwof] at hre'
  norm_num at hre'
  exact hre'

/-- **Atomic second-grade law.**  The next critical grade of every literal Suzuki chord is
exactly the Dirichlet self-convolution `Λ * Λ`.  This upgrades the earlier one-sided lower bound
to coefficient-faithful convergence, preserving every sign until the polar comparison. -/
theorem tendsto_suzukiCriticalChordCoefficient_secondGrade
    {n : ℕ} (hn : 1 ≤ n) :
    Tendsto (fun ω : ℝ =>
      (suzukiCriticalChordCoefficient ω n -
        ArithmeticFunction.vonMangoldt n) / ω)
      (𝓝[>] 0)
      (𝓝 ((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n)) := by
  let A : ℝ → ℝ := fun ω =>
    suzukiShiftedCoefficient ω n - suzukiShiftedCoefficient 0 n -
      ω * (2 * ArithmeticFunction.vonMangoldt n)
  let B : ℝ → ℝ := fun ω => 2 * ω ^ 2
  let A' : ℝ → ℝ := fun ω =>
    suzukiShiftedCoefficientComplexFirstJet n ω -
      2 * ArithmeticFunction.vonMangoldt n
  let B' : ℝ → ℝ := fun ω => 4 * ω
  have hAA' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt A (A' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      have hraw :=
        ((hasDerivAt_suzukiShiftedCoefficient_eq_complexFirstJet hn ω).sub_const
          (suzukiShiftedCoefficient 0 n)).sub
        ((hasDerivAt_id ω).mul_const (2 * ArithmeticFunction.vonMangoldt n))
      exact hraw.congr_deriv (by simp only [A']; ring)
  have hBB' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt B (B' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      have hraw := ((hasDerivAt_id ω).pow 2).const_mul (2 : ℝ)
      exact hraw.congr_deriv (by simp only [B', Function.id_def]; ring)
  have hB'ne : ∀ᶠ ω : ℝ in 𝓝[≠] 0, B' ω ≠ 0 := by
    filter_upwards [self_mem_nhdsWithin] with ω hω
    exact mul_ne_zero (by norm_num) hω
  have hA0 : Tendsto A (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt A 0 := by
      dsimp only [A]
      exact
        (((hasDerivAt_suzukiShiftedCoefficient_eq_complexFirstJet hn 0).continuousAt.sub
          continuousAt_const).sub (continuousAt_id.mul continuousAt_const))
    simpa only [A, sub_self, zero_mul, sub_zero] using
      hc.tendsto.mono_left nhdsWithin_le_nhds
  have hB0 : Tendsto B (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt B 0 := by
      dsimp only [B]
      fun_prop
    simpa only [B, zero_pow (by norm_num : (2 : ℕ) ≠ 0), mul_zero] using
      hc.tendsto.mono_left nhdsWithin_le_nhds
  have hderivRatio : Tendsto (fun ω : ℝ => A' ω / B' ω)
      (𝓝[≠] 0)
      (𝓝 ((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n)) := by
    have hslope :=
      (hasDerivAt_suzukiShiftedCoefficientComplexFirstJet_zero n).tendsto_slope.div_const
        (4 : ℝ)
    convert hslope using 1
    · funext ω
      rw [slope_def_field, suzukiShiftedCoefficientComplexFirstJet_zero]
      simp only [A', B']
      ring
    · ring
  have hratio : Tendsto (fun ω : ℝ => A ω / B ω)
      (𝓝[≠] 0)
      (𝓝 ((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n)) :=
    HasDerivAt.lhopital_zero_nhdsNE hAA' hBB' hB'ne hA0 hB0 hderivRatio
  have hmono : 𝓝[>] (0 : ℝ) ≤ 𝓝[≠] 0 :=
    nhdsWithin_mono 0 (by
      intro ω hω
      simp only [Set.mem_Ioi] at hω
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      exact ne_of_gt hω)
  refine (hratio.mono_left hmono).congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ω hω
  simp only [A, B, suzukiCriticalChordCoefficient]
  have hωpos : 0 < ω := hω
  have hω0 : ω ≠ 0 := ne_of_gt hωpos
  field_simp [hω0]

/-- Positive mass of the matching polar secant. -/
def suzukiCriticalChordPolarMass (ω : ℝ) (X : ℕ) : ℝ :=
  suzukiMainTerm ω X / (2 * ω)

/-- Canonical residue-factor extension of the polar critical chord through `ω = 0`.  Replacing
the zeta pole by its entire residue factor retains the literal polar mass away from zero and makes
its next Euler grade differentiable at the critical clock. -/
def suzukiCriticalChordPolarMassExtension (ω : ℝ) (X : ℕ) : ℝ :=
  (X : ℝ) ^ (1 + ω) /
    ((1 + ω) * (zetaResidueFactor (((1 + 2 * ω : ℝ) : ℂ))).re)

/-- Off the critical clock, the residue-factor extension is exactly the literal Suzuki polar
chord, not an asymptotic surrogate. -/
theorem suzukiCriticalChordPolarMassExtension_eq
    (ω : ℝ) (X : ℕ) (hω : ω ≠ 0) :
    suzukiCriticalChordPolarMassExtension ω X =
      suzukiCriticalChordPolarMass ω X := by
  have hs : (((1 + 2 * ω : ℝ) : ℂ)) ≠ 1 := by
    intro h
    have hre := congrArg Complex.re h
    simp only [Complex.ofReal_re, Complex.one_re] at hre
    apply hω
    linarith
  have hfactor :
      (zetaResidueFactor (((1 + 2 * ω : ℝ) : ℂ))).re =
        2 * ω * (riemannZeta (((1 + 2 * ω : ℝ) : ℂ))).re := by
    rw [zetaResidueFactor_of_ne hs]
    simp only [Complex.mul_re, Complex.sub_re, Complex.ofReal_re,
      Complex.one_re, Complex.sub_im, Complex.ofReal_im, Complex.one_im,
      zero_mul, sub_zero]
    ring
  rw [suzukiCriticalChordPolarMassExtension, suzukiCriticalChordPolarMass,
    suzukiMainTerm, hfactor]
  field_simp [hω]

@[simp] theorem suzukiCriticalChordPolarMassExtension_zero (X : ℕ) :
    suzukiCriticalChordPolarMassExtension 0 X = X := by
  norm_num [suzukiCriticalChordPolarMassExtension, Real.rpow_one,
    zetaResidueFactor_one]

/-- The real residue factor along Suzuki's doubled critical displacement has derivative `2γ`. -/
theorem hasDerivAt_suzukiCriticalChordPolarResidueFactor :
    HasDerivAt
      (fun ω : ℝ => (zetaResidueFactor (((1 + 2 * ω : ℝ) : ℂ))).re)
      (2 * Real.eulerMascheroniConstant) 0 := by
  have haff : HasDerivAt
      (fun ω : ℝ => (((1 + 2 * ω : ℝ) : ℂ))) (2 : ℂ) 0 := by
    have h : HasDerivAt (fun ω : ℝ => ((ω : ℝ) : ℂ)) 1 0 :=
      Complex.ofRealCLM.hasDerivAt
    simpa using (h.const_mul (2 : ℂ)).const_add (1 : ℂ)
  have hout : HasDerivAt zetaResidueFactor
      (Real.eulerMascheroniConstant : ℂ)
      (((1 + 2 * (0 : ℝ) : ℝ) : ℂ)) := by
    norm_num
    exact hasDerivAt_zetaResidueFactor
  have hcomp := hout.scomp
    (h := fun ω : ℝ => (((1 + 2 * ω : ℝ) : ℂ))) 0 haff
  have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt 0 hcomp
  simpa [Function.comp_def, smul_eq_mul, Complex.mul_re] using hre

/-- **Polar second-grade law.**  The derivative of the canonically filled polar chord is exactly
`X (log X - 1 - 2γ)`.  This is the continuous counterterm which must cancel the arithmetic
`Λ * Λ` grade before any scalar absolute value is taken. -/
theorem hasDerivAt_suzukiCriticalChordPolarMassExtension
    {X : ℕ} (hX : 1 ≤ X) :
    HasDerivAt (fun ω : ℝ => suzukiCriticalChordPolarMassExtension ω X)
      (X * (Real.log X - 1 - 2 * Real.eulerMascheroniConstant)) 0 := by
  have hXR : (0 : ℝ) < X := by exact_mod_cast (show 0 < X by omega)
  have hpow : HasDerivAt (fun ω : ℝ => (X : ℝ) ^ (1 + ω))
      ((X : ℝ) * Real.log X) 0 := by
    have haff : HasDerivAt (fun ω : ℝ => 1 + ω) 1 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).const_add (1 : ℝ)
    have hraw := haff.const_rpow hXR
    convert hraw using 1 <;> norm_num [Real.rpow_one] <;> ring
  have hone : HasDerivAt (fun ω : ℝ => 1 + ω) 1 0 := by
    simpa using (hasDerivAt_id (0 : ℝ)).const_add (1 : ℝ)
  have hden := hone.mul hasDerivAt_suzukiCriticalChordPolarResidueFactor
  have hdiv := hpow.div hden (by simp [zetaResidueFactor_one])
  change HasDerivAt
    ((fun ω : ℝ => (X : ℝ) ^ (1 + ω)) /
      ((fun ω : ℝ => 1 + ω) *
        fun ω : ℝ => (zetaResidueFactor (((1 + 2 * ω : ℝ) : ℂ))).re)) _ 0
  apply hdiv.congr_deriv
  norm_num [Pi.div_apply, Pi.mul_apply, zetaResidueFactor_one,
    Complex.one_re, Real.rpow_one, one_mul, one_pow, div_one]
  ring

/-- Literal right-critical form of the polar second-grade law. -/
theorem tendsto_suzukiCriticalChordPolarMass_secondGrade
    {X : ℕ} (hX : 1 ≤ X) :
    Tendsto (fun ω : ℝ =>
      (suzukiCriticalChordPolarMass ω X - X) / ω)
      (𝓝[>] 0)
      (𝓝 (X * (Real.log X - 1 - 2 * Real.eulerMascheroniConstant))) := by
  have hslope :=
    (hasDerivAt_suzukiCriticalChordPolarMassExtension hX).tendsto_slope_zero_right
  refine hslope.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ω hω
  norm_num only [zero_add]
  rw [suzukiCriticalChordPolarMassExtension_eq ω X hω.ne',
    suzukiCriticalChordPolarMassExtension_zero]
  simp only [smul_eq_mul, div_eq_mul_inv]
  ring

/-- The polar secant is positive on every nonempty arithmetic prefix. -/
theorem suzukiCriticalChordPolarMass_nonneg
    {ω : ℝ} (hω : 0 < ω) {X : ℕ} (hX : 1 ≤ X) :
    0 ≤ suzukiCriticalChordPolarMass ω X := by
  have hz : (0 : ℝ) < (riemannZeta (((1 + 2 * ω : ℝ) : ℂ))).re := by
    have hz1 := one_le_re_riemannZeta_ofReal (1 + 2 * ω) (by linarith)
    linarith
  rw [suzukiCriticalChordPolarMass, suzukiMainTerm]
  positivity

/-- Polar chord masses converge individually to Lebesgue prefix mass. -/
theorem tendsto_suzukiCriticalChordPolarMass
    {X : ℕ} (hX : 1 ≤ X) :
    Tendsto (fun ω : ℝ => suzukiCriticalChordPolarMass ω X)
      (𝓝[>] 0) (𝓝 (X : ℝ)) := by
  have h := (suzukiMainTerm_tendsto_ratio X hX).const_mul (1 / 2 : ℝ)
  convert h using 1
  · funext ω
    rw [suzukiCriticalChordPolarMass]
    ring
  · ring

/-- The coupled-error critical chord is exactly atomic prefix mass minus polar mass. -/
theorem suzukiCoupledError_criticalChord_eq_atomic_sub_polar
    {ω : ℝ} (hω : 0 < ω) {X : ℕ} (hX : 1 ≤ X) :
    (suzukiCoupledError ω X - 1) / (2 * ω) =
      (∑ n ∈ Finset.Icc 1 X, suzukiCriticalChordCoefficient ω n) -
        suzukiCriticalChordPolarMass ω X := by
  have hω0 : 2 * ω ≠ 0 := by positivity
  have hsum :
      (∑ n ∈ Finset.Icc 1 X, suzukiCriticalChordCoefficient ω n) =
        (suzukiShiftedSummatory ω X - suzukiShiftedSummatory 0 X) / (2 * ω) := by
    simp only [suzukiCriticalChordCoefficient, suzukiShiftedSummatory]
    rw [← Finset.sum_div, Finset.sum_sub_distrib]
  rw [hsum, suzukiShiftedSummatory_zero X hX,
    suzukiCriticalChordPolarMass, suzukiCoupledError]
  field_simp [hω0]
  ring

/-- Finite discrete Fubini for prefix masses transported by the square-root mesh. -/
theorem sum_prefix_mul_sqrtMesh_eq_sum_sqrtGap
    (a : ℕ → ℝ) {M : ℕ} (hM : 1 ≤ M) :
    (∑ k ∈ Finset.range (M - 1),
      (∑ n ∈ Finset.Icc 1 (k + 1), a n) *
        (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) =
      ∑ n ∈ Finset.Icc 1 (M - 1),
        a n * (Real.sqrt M - Real.sqrt n) := by
  induction M, hM using Nat.le_induction with
  | base => norm_num
  | succ M hM ih =>
      have hpred : M - 1 + 1 = M := Nat.sub_add_cancel hM
      have hpred2 : M - 1 + 2 = M + 1 := by omega
      have htop : M + 1 - 1 = M := by omega
      have hzeroExtend :
          (∑ n ∈ Finset.Icc 1 (M - 1),
            a n * (Real.sqrt M - Real.sqrt n)) =
          ∑ n ∈ Finset.Icc 1 M,
            a n * (Real.sqrt M - Real.sqrt n) := by
        rw [← hpred, Finset.sum_Icc_succ_top (by omega : 1 ≤ M - 1 + 1)]
        simp
      rw [htop, ← hpred, Finset.sum_range_succ, hpred, hpred2, ih, hzeroExtend]
      rw [show
          (∑ n ∈ Finset.Icc 1 M, a n) *
              (Real.sqrt (M + 1 : ℕ) - Real.sqrt M) =
            ∑ n ∈ Finset.Icc 1 M,
              a n * (Real.sqrt (M + 1 : ℕ) - Real.sqrt M) by
        rw [Finset.sum_mul]]
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro n _hn
      ring

/-- Total square-root mesh length on a finite aperture. -/
theorem sum_range_sqrtMesh_eq_sqrt_sub_one
    {M : ℕ} (hM : 1 ≤ M) :
    (∑ k ∈ Finset.range (M - 1),
      (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) =
      Real.sqrt M - 1 := by
  induction M, hM using Nat.le_induction with
  | base => norm_num
  | succ M hM ih =>
      have hpred : M - 1 + 1 = M := Nat.sub_add_cancel hM
      have hpred2 : M - 1 + 2 = M + 1 := by omega
      have htop : M + 1 - 1 = M := by omega
      rw [htop, ← hpred, Finset.sum_range_succ, hpred, hpred2, ih]
      ring

/-- Atomic positive carrier after finite square-root Riesz transport. -/
def suzukiCriticalChordAtomicRieszMass (ω : ℝ) (M : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 (M - 1),
    suzukiCriticalChordCoefficient ω n * (Real.sqrt M - Real.sqrt n)

/-- Polar positive carrier on the same finite square-root mesh. -/
def suzukiCriticalChordPolarRieszMass (ω : ℝ) (M : ℕ) : ℝ :=
  ∑ k ∈ Finset.range (M - 1),
    suzukiCriticalChordPolarMass ω (k + 1) *
      (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))

/-- Signed Möbius-log producer after fibrewise critical-pole cancellation and before arithmetic
scalarization.  No coefficient contains an exterior `1 / ω`. -/
def suzukiCriticalRenormalizedMobiusRieszProducer (ω : ℝ) (M : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 (M - 1),
    ((n : ℝ) ^ ω *
      ∑ d ∈ n.divisors,
        (-(ArithmeticFunction.moebius d : ℝ)) *
          suzukiCriticalDampedLogKernel ω d) *
      (Real.sqrt M - Real.sqrt n)

/-- Exact landing of the pole-free signed Möbius producer on the positive atomic chord mass. -/
theorem suzukiCriticalRenormalizedMobiusRieszProducer_eq_atomic
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} :
    suzukiCriticalRenormalizedMobiusRieszProducer ω M =
      suzukiCriticalChordAtomicRieszMass ω M := by
  rw [suzukiCriticalRenormalizedMobiusRieszProducer,
    suzukiCriticalChordAtomicRieszMass]
  apply Finset.sum_congr rfl
  intro n hn
  rw [suzukiCriticalChordCoefficient_eq_renormalizedMobiusLog_all hω
    (Finset.mem_Icc.mp hn).1]

/-- Limiting positive prime carrier at one finite aperture. -/
def criticalVonMangoldtRieszMass (M : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 (M - 1),
    ArithmeticFunction.vonMangoldt n * (Real.sqrt M - Real.sqrt n)

/-- Limiting positive polar carrier on the same finite mesh. -/
def criticalPolarRieszMass (M : ℕ) : ℝ :=
  ∑ k ∈ Finset.range (M - 1),
    (k + 1 : ℕ) *
      (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))

/-- Full second Euler grade transported through the same finite square-root Riesz aperture. -/
def criticalVonMangoldtSecondGradeRieszMass (M : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 (M - 1),
    ((ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n) *
      (Real.sqrt M - Real.sqrt n)

/-- Continuous polar counterterm at the second Euler grade, transported through the same
square-root Riesz mesh. -/
def criticalPolarSecondGradeRieszMass (M : ℕ) : ℝ :=
  ∑ k ∈ Finset.range (M - 1),
    ((k + 1 : ℕ) *
      (Real.log (k + 1 : ℕ) - 1 - 2 * Real.eulerMascheroniConstant)) *
      (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))

/-- The von Mangoldt self-convolution is nonnegative at every label. -/
theorem vonMangoldt_mul_self_nonneg (n : ℕ) :
    0 ≤ (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n := by
  rw [ArithmeticFunction.mul_apply]
  exact Finset.sum_nonneg fun x _hx =>
    mul_nonneg ArithmeticFunction.vonMangoldt_nonneg
      ArithmeticFunction.vonMangoldt_nonneg

/-- The transported full second Euler grade is positive. -/
theorem criticalVonMangoldtSecondGradeRieszMass_nonneg
    {M : ℕ} (_hM : 1 ≤ M) :
    0 ≤ criticalVonMangoldtSecondGradeRieszMass M := by
  rw [criticalVonMangoldtSecondGradeRieszMass]
  exact Finset.sum_nonneg fun n hn => by
    have hnM : n ≤ M := (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le M 1)
    exact mul_nonneg (vonMangoldt_mul_self_nonneg n)
      (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM)))

/-- A `16K` square-root aperture retains at least `sqrt K` times the complete harmonic
self-convolution prefix.  This is the bridge from Selberg's second grade to the Suzuki clock. -/
theorem sqrt_mul_sum_vonMangoldtConv_div_le_secondGradeRieszMass
    {K : ℕ} (hK : 1 ≤ K) :
    Real.sqrt K *
        (∑ n ∈ Finset.Icc 1 K,
          (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n / n) ≤
      criticalVonMangoldtSecondGradeRieszMass (16 * K) := by
  have hsubset : Finset.Icc 1 K ⊆ Finset.Icc 1 (16 * K - 1) := by
    intro n hn
    rw [Finset.mem_Icc] at hn ⊢
    exact ⟨hn.1, by omega⟩
  have hsqrt16 : Real.sqrt ((16 * K : ℕ) : ℝ) = 4 * Real.sqrt K := by
    rw [Nat.cast_mul]
    norm_num only [Nat.cast_ofNat]
    rw [Real.sqrt_mul (x := (16 : ℝ)) (by norm_num) (K : ℝ)]
    norm_num
  have hprefix :
      (∑ n ∈ Finset.Icc 1 K,
        ((ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n) *
          (Real.sqrt (16 * K : ℕ) - Real.sqrt n)) ≤
        criticalVonMangoldtSecondGradeRieszMass (16 * K) := by
    rw [criticalVonMangoldtSecondGradeRieszMass]
    exact Finset.sum_le_sum_of_subset_of_nonneg hsubset (fun n hn _hnot => by
      have hnM : n ≤ 16 * K :=
        (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le (16 * K) 1)
      exact mul_nonneg (vonMangoldt_mul_self_nonneg n)
        (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM))))
  rw [Finset.mul_sum]
  apply (Finset.sum_le_sum fun n hn => ?_).trans hprefix
  have hn1 := (Finset.mem_Icc.mp hn).1
  have hnK := (Finset.mem_Icc.mp hn).2
  have hconv := vonMangoldt_mul_self_nonneg n
  have hdiv :
      (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n / (n : ℝ) ≤
        (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n :=
    div_le_self hconv (by exact_mod_cast hn1)
  have hsqrtn : Real.sqrt n ≤ Real.sqrt K :=
    Real.sqrt_le_sqrt (by exact_mod_cast hnK)
  have hgap : Real.sqrt K ≤
      Real.sqrt (16 * K : ℕ) - Real.sqrt n := by
    rw [hsqrt16]
    linarith [Real.sqrt_nonneg K]
  calc
    Real.sqrt K *
        ((ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n / n) ≤
      (Real.sqrt (16 * K : ℕ) - Real.sqrt n) *
        ((ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n / n) :=
      mul_le_mul_of_nonneg_right hgap (div_nonneg hconv (Nat.cast_nonneg n))
    _ ≤ (Real.sqrt (16 * K : ℕ) - Real.sqrt n) *
        (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n :=
      mul_le_mul_of_nonneg_left hdiv
        (sub_nonneg.mpr (Real.sqrt_le_sqrt (by
          exact_mod_cast hnK.trans (show K ≤ 16 * K by omega))))
    _ = _ := by ring

/-- Selberg's unconditional harmonic second-grade estimate survives the `16K` square-root
aperture with an explicit lower main term.  No pointwise sign of the completed source is used:
positivity enters only before the prime--polar scalarization, at the `Λ * Λ` grade. -/
theorem sqrt_mul_selbergLower_le_secondGradeRieszMass
    {K : ℕ} (hK : 1 ≤ K) :
    Real.sqrt K *
        (Real.log K ^ 2 / 2 - (30 * Real.log K + 120)) ≤
      criticalVonMangoldtSecondGradeRieszMass (16 * K) := by
  have hsum := abs_sum_vonMangoldt_conv_div_sub_le K hK
  have hlower :
      Real.log K ^ 2 / 2 - (30 * Real.log K + 120) ≤
        ∑ n ∈ Finset.Icc 1 K,
          (ArithmeticFunction.vonMangoldt * ArithmeticFunction.vonMangoldt) n / n := by
    have habs := (abs_le.mp hsum).1
    linarith
  exact (mul_le_mul_of_nonneg_left hlower (Real.sqrt_nonneg K)).trans
    (sqrt_mul_sum_vonMangoldtConv_div_le_secondGradeRieszMass hK)

/-- The critical polar mesh is exactly the finite Lebesgue Riesz carrier. -/
theorem criticalPolarRieszMass_eq_sum_sqrtGap
    {M : ℕ} (hM : 1 ≤ M) :
    criticalPolarRieszMass M =
      ∑ n ∈ Finset.Icc 1 (M - 1), (Real.sqrt M - Real.sqrt n) := by
  rw [criticalPolarRieszMass]
  calc
    (∑ k ∈ Finset.range (M - 1),
      (k + 1 : ℕ) *
        (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) =
        ∑ k ∈ Finset.range (M - 1),
          (∑ n ∈ Finset.Icc 1 (k + 1), (1 : ℝ)) *
            (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ)) := by
          apply Finset.sum_congr rfl
          intro k _hk
          simp only [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, mul_one]
          norm_num
    _ = ∑ n ∈ Finset.Icc 1 (M - 1),
          (1 : ℝ) * (Real.sqrt M - Real.sqrt n) :=
      sum_prefix_mul_sqrtMesh_eq_sum_sqrtGap (fun _ => (1 : ℝ)) hM
    _ = _ := by simp

/-- The zero-clock critical carrier is exactly the already formalized completed
prime--polar--Gamma Möbius moment.  Thus the critical-chord deformation lands on the literal RH
source, not on a surrogate limiting scalar. -/
theorem criticalCarrier_add_gamma_eq_mobiusDivisorSquareRootAbelMoment
    {M : ℕ} (hM : 1 ≤ M) :
    criticalVonMangoldtRieszMass M - criticalPolarRieszMass M +
        2 * Real.eulerMascheroniConstant * (Real.sqrt M - 1) =
      mobiusDivisorSquareRootAbelMoment M := by
  rw [← sum_completedPrimePolarGammaAtom_mul_sqrtGap_eq_mobiusMoment,
    criticalVonMangoldtRieszMass, criticalPolarRieszMass_eq_sum_sqrtGap hM,
    ← Finset.sum_sub_distrib]
  rw [show
      (∑ n ∈ Finset.Icc 1 (M - 1),
        (ArithmeticFunction.vonMangoldt n * (Real.sqrt M - Real.sqrt n) -
          (Real.sqrt M - Real.sqrt n))) =
        ∑ n ∈ Finset.Icc 1 (M - 1),
          (ArithmeticFunction.vonMangoldt n - 1) *
            (Real.sqrt M - Real.sqrt n) by
      apply Finset.sum_congr rfl
      intro n _hn
      ring]
  rcases hM.eq_or_lt with hM1 | hM2
  · subst M
    norm_num [completedPrimePolarGammaAtom]
  · have htwo : 2 ≤ M := by omega
    have hgamma :
        (∑ n ∈ Finset.Icc 1 (M - 1),
          (if n = 1 then 2 * Real.eulerMascheroniConstant else 0) *
            (Real.sqrt M - Real.sqrt n)) =
          2 * Real.eulerMascheroniConstant * (Real.sqrt M - 1) := by
      rw [Finset.sum_eq_single 1]
      · simp
      · intro n _hn hn1
        rw [if_neg hn1]
        simp
      · intro hnot
        exact (hnot (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).elim
    rw [← hgamma, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro n _hn
    rw [completedPrimePolarGammaAtom]
    ring

/-- Higher-grade atomic mass which remains after subtracting the critical von Mangoldt carrier. -/
def suzukiCriticalChordAtomicRieszExcess (ω : ℝ) (M : ℕ) : ℝ :=
  suzukiCriticalChordAtomicRieszMass ω M - criticalVonMangoldtRieszMass M

/-- Polar secant mass which remains after subtracting its critical Lebesgue carrier. -/
def suzukiCriticalChordPolarRieszExcess (ω : ℝ) (M : ℕ) : ℝ :=
  suzukiCriticalChordPolarRieszMass ω M - criticalPolarRieszMass M

/-- Exact positive-atom expansion of the higher-grade arithmetic excess. -/
theorem suzukiCriticalChordAtomicRieszExcess_eq_sum
    (ω : ℝ) (M : ℕ) :
    suzukiCriticalChordAtomicRieszExcess ω M =
      ∑ n ∈ Finset.Icc 1 (M - 1),
        (suzukiCriticalChordCoefficient ω n - ArithmeticFunction.vonMangoldt n) *
          (Real.sqrt M - Real.sqrt n) := by
  rw [suzukiCriticalChordAtomicRieszExcess,
    suzukiCriticalChordAtomicRieszMass, criticalVonMangoldtRieszMass,
    ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro n _hn
  ring

/-- Exact polar-atom expansion of the polar secant excess. -/
theorem suzukiCriticalChordPolarRieszExcess_eq_sum
    (ω : ℝ) (M : ℕ) :
    suzukiCriticalChordPolarRieszExcess ω M =
      ∑ k ∈ Finset.range (M - 1),
        (suzukiCriticalChordPolarMass ω (k + 1) - (k + 1 : ℕ)) *
          (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ)) := by
  rw [suzukiCriticalChordPolarRieszExcess,
    suzukiCriticalChordPolarRieszMass, criticalPolarRieszMass,
    ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro k _hk
  ring

/-- **Atomic aggregate second-grade landing.**  At every fixed aperture, the entire literal
atomic Suzuki excess divided by the critical clock converges to the transported `Λ * Λ` mass. -/
theorem tendsto_suzukiCriticalChordAtomicRieszExcess_secondGrade (M : ℕ) :
    Tendsto (fun ω : ℝ =>
      suzukiCriticalChordAtomicRieszExcess ω M / ω)
      (𝓝[>] 0) (𝓝 (criticalVonMangoldtSecondGradeRieszMass M)) := by
  have hsum : Tendsto (fun ω : ℝ =>
      ∑ n ∈ Finset.Icc 1 (M - 1),
        ((suzukiCriticalChordCoefficient ω n -
          ArithmeticFunction.vonMangoldt n) / ω) *
          (Real.sqrt M - Real.sqrt n))
      (𝓝[>] 0) (𝓝 (criticalVonMangoldtSecondGradeRieszMass M)) := by
    rw [criticalVonMangoldtSecondGradeRieszMass]
    apply tendsto_finsetSum
    intro n hn
    exact (tendsto_suzukiCriticalChordCoefficient_secondGrade
      (Finset.mem_Icc.mp hn).1).mul_const (Real.sqrt M - Real.sqrt n)
  convert hsum using 1
  funext ω
  rw [suzukiCriticalChordAtomicRieszExcess_eq_sum, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro n _hn
  ring

/-- **Polar aggregate second-grade landing.**  At every fixed aperture, the literal polar secant
excess divided by the critical clock converges to its explicit `X(log X - 1 - 2γ)` counterterm. -/
theorem tendsto_suzukiCriticalChordPolarRieszExcess_secondGrade (M : ℕ) :
    Tendsto (fun ω : ℝ =>
      suzukiCriticalChordPolarRieszExcess ω M / ω)
      (𝓝[>] 0) (𝓝 (criticalPolarSecondGradeRieszMass M)) := by
  have hsum : Tendsto (fun ω : ℝ =>
      ∑ k ∈ Finset.range (M - 1),
        ((suzukiCriticalChordPolarMass ω (k + 1) - (k + 1 : ℕ)) / ω) *
          (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ)))
      (𝓝[>] 0) (𝓝 (criticalPolarSecondGradeRieszMass M)) := by
    rw [criticalPolarSecondGradeRieszMass]
    apply tendsto_finsetSum
    intro k _hk
    exact (tendsto_suzukiCriticalChordPolarMass_secondGrade
      (by omega : 1 ≤ k + 1)).mul_const
        (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))
  convert hsum using 1
  funext ω
  rw [suzukiCriticalChordPolarRieszExcess_eq_sum, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro k _hk
  ring

/-- **Coefficient-faithful signed boundary renormalization.**  The first nontrivial critical
variation of the complete Suzuki deformation is exactly the Riesz transport of the Selberg
second-grade arithmetic mass minus its continuous polar counterterm.  This is the leading
prime--polar cancellation law required before any cofinal estimate. -/
theorem tendsto_suzukiCriticalChordSignedRieszExcess_secondGrade (M : ℕ) :
    Tendsto (fun ω : ℝ =>
      (suzukiCriticalChordAtomicRieszExcess ω M -
        suzukiCriticalChordPolarRieszExcess ω M) / ω)
      (𝓝[>] 0)
      (𝓝 (criticalVonMangoldtSecondGradeRieszMass M -
        criticalPolarSecondGradeRieszMass M)) := by
  convert (tendsto_suzukiCriticalChordAtomicRieszExcess_secondGrade M).sub
    (tendsto_suzukiCriticalChordPolarRieszExcess_secondGrade M) using 1
  funext ω
  ring

/-- **Selberg discrepancy identification.**  The signed second-grade boundary functional is
exactly the square-root Riesz transform of the cumulative arithmetic-minus-polar discrepancy.
Thus all leading `M^(3/2) log M` mass has been paired coefficient-faithfully; the surviving
cofinal problem is cancellation inside this explicit signed prefix error. -/
theorem criticalSecondGradeSignedRieszMass_eq_selbergPrefixDiscrepancy
    {M : ℕ} (hM : 1 ≤ M) :
    criticalVonMangoldtSecondGradeRieszMass M -
        criticalPolarSecondGradeRieszMass M =
      ∑ k ∈ Finset.range (M - 1),
        ((∑ n ∈ Finset.Icc 1 (k + 1),
            (ArithmeticFunction.vonMangoldt *
              ArithmeticFunction.vonMangoldt) n) -
          (k + 1 : ℕ) *
            (Real.log (k + 1 : ℕ) - 1 -
              2 * Real.eulerMascheroniConstant)) *
          (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ)) := by
  rw [criticalVonMangoldtSecondGradeRieszMass,
    ← sum_prefix_mul_sqrtMesh_eq_sum_sqrtGap
    (fun n => (ArithmeticFunction.vonMangoldt *
      ArithmeticFunction.vonMangoldt) n) hM,
    criticalPolarSecondGradeRieszMass, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro k _hk
  ring

/-- **Global signed second-grade renormalization.**  After division by the exact positive
square-root mesh scale, the coupled arithmetic-minus-polar critical variation tends to zero.
The subtraction is performed before normalization, so no triangle inequality separates the two
carriers or loses their leading cancellation. -/
theorem tendsto_normalized_criticalSecondGradeSignedRieszMass :
    Tendsto (fun N : ℕ =>
      (selbergSecondGradeSqrtMeshScale N)⁻¹ *
        (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
          criticalPolarSecondGradeRieszMass (N + 1)))
      atTop (𝓝 0) := by
  convert tendsto_normalized_selbergSecondGradeSqrtMeshDiscrepancy using 1
  funext N
  rw [criticalSecondGradeSignedRieszMass_eq_selbergPrefixDiscrepancy
    (by omega : 1 ≤ N + 1)]
  simp only [Nat.add_sub_cancel, selbergSecondGradePrefixDiscrepancy]

/-- The higher-grade atomic Riesz excess is pointwise nonnegative.  Thus any completed
critical-chord cancellation must remove this explicit positive surplus through the coupled polar
carrier; it cannot come from cancellation among the arithmetic atoms themselves. -/
theorem suzukiCriticalChordAtomicRieszExcess_nonneg
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (_hM : 1 ≤ M) :
    0 ≤ suzukiCriticalChordAtomicRieszExcess ω M := by
  rw [suzukiCriticalChordAtomicRieszExcess_eq_sum]
  exact Finset.sum_nonneg fun n hn => by
    have hni := (Finset.mem_Icc.mp hn).1
    have hnM : n ≤ M := (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le M 1)
    exact mul_nonneg
      (sub_nonneg.mpr (vonMangoldt_le_suzukiCriticalChordCoefficient hω hni))
      (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM)))

/-- **Aggregate two-grade lower law.**  The complete transported `Λ * Λ` mass sits inside the
atomic Suzuki excess with its exact critical factor `ω`. -/
theorem omega_mul_secondGradeRieszMass_le_atomicExcess
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (_hM : 1 ≤ M) :
    ω * criticalVonMangoldtSecondGradeRieszMass M ≤
      suzukiCriticalChordAtomicRieszExcess ω M := by
  rw [criticalVonMangoldtSecondGradeRieszMass,
    suzukiCriticalChordAtomicRieszExcess_eq_sum, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  rw [← mul_assoc]
  have hni := (Finset.mem_Icc.mp hn).1
  have hnM : n ≤ M := (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le M 1)
  exact mul_le_mul_of_nonneg_right
    (by
      linarith [vonMangoldt_add_secondGrade_le_suzukiCriticalChordCoefficient
        hω hni])
    (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM)))

/-- Explicit Selberg lower law for the literal higher-grade Suzuki atomic excess.  It exposes a
coherent `ω sqrt K log² K` arithmetic charge before the polar carrier is subtracted. -/
theorem omega_mul_sqrt_mul_selbergLower_le_atomicExcess
    {ω : ℝ} (hω : 0 < ω) {K : ℕ} (hK : 1 ≤ K) :
    ω * Real.sqrt K *
        (Real.log K ^ 2 / 2 - (30 * Real.log K + 120)) ≤
      suzukiCriticalChordAtomicRieszExcess ω (16 * K) := by
  have hselberg := sqrt_mul_selbergLower_le_secondGradeRieszMass hK
  have hscaled := mul_le_mul_of_nonneg_left hselberg hω.le
  calc
    ω * Real.sqrt K *
        (Real.log K ^ 2 / 2 - (30 * Real.log K + 120)) =
      ω * (Real.sqrt K *
        (Real.log K ^ 2 / 2 - (30 * Real.log K + 120))) := by ring
    _ ≤ ω * criticalVonMangoldtSecondGradeRieszMass (16 * K) := hscaled
    _ ≤ suzukiCriticalChordAtomicRieszExcess ω (16 * K) :=
      omega_mul_secondGradeRieszMass_le_atomicExcess hω (by omega)

/-- **Selberg clock rigidity.**  Vanishing of the positive atomic excess on `16K` apertures
forces the sharper rate `ω_K sqrt K log² K -> 0`.  Unlike the fixed-label square-root law, this
uses the whole second Euler grade and needs no separate hypothesis that `ω_K -> 0`. -/
theorem tendsto_suzukiParameter_mul_sqrt_mul_log_sq_of_atomicExcess
    (ω : ℕ → ℝ) (hωpos : ∀ K, 0 < ω K)
    (hexcess : Tendsto (fun K : ℕ =>
      suzukiCriticalChordAtomicRieszExcess (ω K) (16 * K)) atTop (𝓝 0)) :
    Tendsto (fun K : ℕ =>
      ω K * Real.sqrt K * Real.log K ^ 2) atTop (𝓝 0) := by
  have hlog : Tendsto (fun K : ℕ => Real.log K) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hKevent : ∀ᶠ K : ℕ in atTop, 1 ≤ K :=
    Filter.eventually_atTop.2 ⟨1, fun K hK => hK⟩
  have hlogevent : ∀ᶠ K : ℕ in atTop, 125 ≤ Real.log K :=
    (tendsto_atTop.1 hlog) 125
  have hlower : ∀ K : ℕ,
      0 ≤ ω K * Real.sqrt K * Real.log K ^ 2 / 4 := by
    intro K
    exact div_nonneg
      (mul_nonneg
        (mul_nonneg (hωpos K).le (Real.sqrt_nonneg K))
        (sq_nonneg (Real.log K)))
      (by norm_num)
  have hupper : ∀ᶠ K : ℕ in atTop,
      ω K * Real.sqrt K * Real.log K ^ 2 / 4 ≤
        suzukiCriticalChordAtomicRieszExcess (ω K) (16 * K) := by
    filter_upwards [hKevent, hlogevent] with K hK hlogK
    have hpoly :
        Real.log K ^ 2 / 4 ≤
          Real.log K ^ 2 / 2 - (30 * Real.log K + 120) := by
      nlinarith [sq_nonneg (Real.log K - 125)]
    have hmul := mul_le_mul_of_nonneg_left hpoly
      (mul_nonneg (hωpos K).le (Real.sqrt_nonneg K))
    calc
      ω K * Real.sqrt K * Real.log K ^ 2 / 4 =
          (ω K * Real.sqrt K) * (Real.log K ^ 2 / 4) := by ring
      _ ≤ (ω K * Real.sqrt K) *
          (Real.log K ^ 2 / 2 - (30 * Real.log K + 120)) := hmul
      _ = ω K * Real.sqrt K *
          (Real.log K ^ 2 / 2 - (30 * Real.log K + 120)) := by ring
      _ ≤ suzukiCriticalChordAtomicRieszExcess (ω K) (16 * K) :=
        omega_mul_sqrt_mul_selbergLower_le_atomicExcess (hωpos K) hK
  have hquarter : Tendsto (fun K : ℕ =>
      ω K * Real.sqrt K * Real.log K ^ 2 / 4) atTop (𝓝 0) :=
    squeeze_zero' (Filter.Eventually.of_forall hlower) hupper hexcess
  have hfour := hquarter.const_mul (4 : ℝ)
  convert hfour using 1
  · funext K
    ring
  · ring

/-- Any retained prime-power label forces an explicit positive contribution to the transported
atomic excess. -/
theorem primePower_secondGrade_le_suzukiCriticalChordAtomicRieszExcess
    {ω : ℝ} (hω : 0 < ω) {M p k : ℕ} (hp : p.Prime)
    (hlabel : p ^ (k + 1) ≤ M - 1) :
    ω * k * (Real.log (p : ℝ)) ^ 2 *
        (Real.sqrt M - Real.sqrt ((p ^ (k + 1) : ℕ) : ℝ)) ≤
      suzukiCriticalChordAtomicRieszExcess ω M := by
  have hpow1 : 1 ≤ p ^ (k + 1) := Nat.one_le_pow _ _ hp.pos
  have hmem : p ^ (k + 1) ∈ Finset.Icc 1 (M - 1) :=
    Finset.mem_Icc.mpr ⟨hpow1, hlabel⟩
  have hpowM : p ^ (k + 1) ≤ M := hlabel.trans (Nat.sub_le M 1)
  have hgap : 0 ≤ Real.sqrt M - Real.sqrt ((p ^ (k + 1) : ℕ) : ℝ) :=
    sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hpowM))
  have hcoeff :
      ω * k * (Real.log (p : ℝ)) ^ 2 ≤
        suzukiCriticalChordCoefficient ω (p ^ (k + 1)) -
          ArithmeticFunction.vonMangoldt (p ^ (k + 1)) := by
    rw [ArithmeticFunction.vonMangoldt_apply_pow (by omega : k + 1 ≠ 0),
      ArithmeticFunction.vonMangoldt_apply_prime hp]
    linarith [suzukiCriticalChordCoefficient_primePower_secondGrade_lower
      (k := k) hω hp]
  rw [suzukiCriticalChordAtomicRieszExcess_eq_sum]
  apply (mul_le_mul_of_nonneg_right hcoeff hgap).trans
  exact Finset.single_le_sum
    (f := fun n : ℕ =>
      (suzukiCriticalChordCoefficient ω n - ArithmeticFunction.vonMangoldt n) *
        (Real.sqrt M - Real.sqrt n)) (fun n hn => by
    have hni := (Finset.mem_Icc.mp hn).1
    have hnM : n ≤ M := (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le M 1)
    exact mul_nonneg
      (sub_nonneg.mpr (vonMangoldt_le_suzukiCriticalChordCoefficient hω hni))
      (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM)))) hmem

/-- The fixed label `4 = 2^2` already forces a square-root aperture cost in every atomic
higher-grade excess. -/
theorem four_secondGrade_le_suzukiCriticalChordAtomicRieszExcess
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 5 ≤ M) :
    ω * (Real.log 2) ^ 2 * (Real.sqrt M - 2) ≤
      suzukiCriticalChordAtomicRieszExcess ω M := by
  convert primePower_secondGrade_le_suzukiCriticalChordAtomicRieszExcess
    (p := 2) (k := 1) hω Nat.prime_two (by omega : 2 ^ (1 + 1) ≤ M - 1) using 1
  all_goals norm_num

/-- **Cofinal critical-rate rigidity.**  If positive Suzuki parameters tend to zero and their
positive atomic excess vanishes on growing apertures, then necessarily `ω_N sqrt(N) -> 0` (with
the harmless fixed shift used to retain label `4`).  Thus separate-carrier convergence forces a
strictly sub-square-root critical clock; this rate cannot be recovered later from scalar
prime--polar cancellation. -/
theorem tendsto_suzukiParameter_mul_sqrt_of_atomicExcess
    (ω : ℕ → ℝ) (hωpos : ∀ N, 0 < ω N)
    (hωzero : Tendsto ω atTop (𝓝 0))
    (hexcess : Tendsto (fun N : ℕ =>
      suzukiCriticalChordAtomicRieszExcess (ω N) (N + 5)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ => ω N * Real.sqrt (N + 5 : ℕ)) atTop (𝓝 0) := by
  let c : ℝ := (Real.log 2) ^ 2
  have hlog2 : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have hc : 0 < c := by dsimp only [c]; positivity
  have hsqrt : ∀ N : ℕ, 2 ≤ Real.sqrt (N + 5 : ℕ) := by
    intro N
    have h : Real.sqrt (4 : ℝ) ≤ Real.sqrt ((N + 5 : ℕ) : ℝ) :=
      Real.sqrt_le_sqrt (by exact_mod_cast (show 4 ≤ N + 5 by omega))
    norm_num at h
    simpa only [Nat.cast_add, Nat.cast_ofNat] using h
  have hlower : ∀ N : ℕ,
      0 ≤ ω N * c * (Real.sqrt (N + 5 : ℕ) - 2) := by
    intro N
    exact mul_nonneg (mul_nonneg (hωpos N).le hc.le)
      (sub_nonneg.mpr (hsqrt N))
  have hupper : ∀ N : ℕ,
      ω N * c * (Real.sqrt (N + 5 : ℕ) - 2) ≤
        suzukiCriticalChordAtomicRieszExcess (ω N) (N + 5) := by
    intro N
    exact four_secondGrade_le_suzukiCriticalChordAtomicRieszExcess
      (hωpos N) (by omega : 5 ≤ N + 5)
  have hscaled : Tendsto (fun N : ℕ =>
      ω N * c * (Real.sqrt (N + 5 : ℕ) - 2)) atTop (𝓝 0) :=
    squeeze_zero'
      (Filter.Eventually.of_forall hlower)
      (Filter.Eventually.of_forall hupper)
      hexcess
  have hshifted : Tendsto (fun N : ℕ =>
      ω N * (Real.sqrt (N + 5 : ℕ) - 2)) atTop (𝓝 0) := by
    have h := hscaled.const_mul c⁻¹
    convert h using 1
    · funext N
      field_simp [ne_of_gt hc]
    · simp
  have htwo := hωzero.const_mul (2 : ℝ)
  convert hshifted.add htwo using 1
  · funext N
    ring
  · ring

/-- Shift-free form of cofinal critical-rate rigidity on the canonical aperture `N+1`. -/
theorem tendsto_suzukiParameter_mul_sqrt_succ_of_atomicExcess
    (ω : ℕ → ℝ) (hωpos : ∀ N, 0 < ω N)
    (hωzero : Tendsto ω atTop (𝓝 0))
    (hexcess : Tendsto (fun N : ℕ =>
      suzukiCriticalChordAtomicRieszExcess (ω N) (N + 1)) atTop (𝓝 0)) :
    Tendsto (fun N : ℕ => ω N * Real.sqrt (N + 1 : ℕ)) atTop (𝓝 0) := by
  have hωshift : Tendsto (fun N : ℕ => ω (N + 4)) atTop (𝓝 0) :=
    (Filter.tendsto_add_atTop_iff_nat 4).2 hωzero
  have hexcessShift : Tendsto (fun N : ℕ =>
      suzukiCriticalChordAtomicRieszExcess (ω (N + 4)) (N + 5))
      atTop (𝓝 0) := by
    have h := (Filter.tendsto_add_atTop_iff_nat 4).2 hexcess
    simpa [Nat.add_assoc] using h
  have hshift := tendsto_suzukiParameter_mul_sqrt_of_atomicExcess
    (fun N : ℕ => ω (N + 4)) (fun N => hωpos (N + 4)) hωshift hexcessShift
  apply (Filter.tendsto_add_atTop_iff_nat 4).1
  simpa [Nat.add_assoc] using hshift

/-- The transported atomic chord remains positive. -/
theorem suzukiCriticalChordAtomicRieszMass_nonneg
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (_hM : 1 ≤ M) :
    0 ≤ suzukiCriticalChordAtomicRieszMass ω M := by
  rw [suzukiCriticalChordAtomicRieszMass]
  exact Finset.sum_nonneg fun n hn => by
    have hni := (Finset.mem_Icc.mp hn).1
    have hnM : n ≤ M := (Finset.mem_Icc.mp hn).2.trans (Nat.sub_le M 1)
    exact mul_nonneg (suzukiCriticalChordCoefficient_nonneg hω hni)
      (sub_nonneg.mpr (Real.sqrt_le_sqrt (by exact_mod_cast hnM)))

/-- The fully signed pole-free Möbius producer is nonnegative after exact divisor-fibre
cancellation. -/
theorem suzukiCriticalRenormalizedMobiusRieszProducer_nonneg
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 1 ≤ M) :
    0 ≤ suzukiCriticalRenormalizedMobiusRieszProducer ω M := by
  rw [suzukiCriticalRenormalizedMobiusRieszProducer_eq_atomic hω]
  exact suzukiCriticalChordAtomicRieszMass_nonneg hω hM

/-- The transported polar chord remains positive. -/
theorem suzukiCriticalChordPolarRieszMass_nonneg
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (_hM : 1 ≤ M) :
    0 ≤ suzukiCriticalChordPolarRieszMass ω M := by
  rw [suzukiCriticalChordPolarRieszMass]
  exact Finset.sum_nonneg fun k _hk =>
    mul_nonneg
      (suzukiCriticalChordPolarMass_nonneg hω (by omega : 1 ≤ k + 1))
      (sub_nonneg.mpr (Real.sqrt_le_sqrt (by
        exact_mod_cast (show k + 1 ≤ k + 2 by omega))))

/-- Finite atomic Riesz transport commutes with the right critical limit. -/
theorem tendsto_suzukiCriticalChordAtomicRieszMass
    {M : ℕ} (_hM : 1 ≤ M) :
    Tendsto (fun ω : ℝ => suzukiCriticalChordAtomicRieszMass ω M)
      (𝓝[>] 0) (𝓝 (criticalVonMangoldtRieszMass M)) := by
  simp only [suzukiCriticalChordAtomicRieszMass, criticalVonMangoldtRieszMass]
  apply tendsto_finsetSum
  intro n hn
  exact (tendsto_suzukiCriticalChordCoefficient (Finset.mem_Icc.mp hn).1).mul_const
    (Real.sqrt M - Real.sqrt n)

/-- Finite polar Riesz transport commutes with the right critical limit. -/
theorem tendsto_suzukiCriticalChordPolarRieszMass
    {M : ℕ} (_hM : 1 ≤ M) :
    Tendsto (fun ω : ℝ => suzukiCriticalChordPolarRieszMass ω M)
      (𝓝[>] 0) (𝓝 (criticalPolarRieszMass M)) := by
  simp only [suzukiCriticalChordPolarRieszMass, criticalPolarRieszMass]
  apply tendsto_finsetSum
  intro k _hk
  exact (tendsto_suzukiCriticalChordPolarMass (by omega : 1 ≤ k + 1)).mul_const
    (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))

/-- **Positive-carrier cofinal convergence.**  One positive critical schedule can be chosen so
that the atomic and polar Riesz carriers converge separately at every growing aperture, with a
common explicit vanishing error budget.  Hence no cancellation is lost during diagonal passage.
This is a convergence theorem only; it does not bound either growing carrier or their imbalance. -/
theorem exists_suzukiCriticalChordPositiveRieszCofinalSchedule :
    ∃ ω : ℕ → ℝ,
      Tendsto ω atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        suzukiCriticalChordAtomicRieszMass (ω N) (N + 1) -
          criticalVonMangoldtRieszMass (N + 1)) atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        suzukiCriticalChordPolarRieszMass (ω N) (N + 1) -
          criticalPolarRieszMass (N + 1)) atTop (𝓝 0) ∧
      ∀ N : ℕ,
        0 < ω N ∧
        ω N < 1 / ((N : ℝ) + 1) ∧
        |suzukiCriticalChordAtomicRieszMass (ω N) (N + 1) -
          criticalVonMangoldtRieszMass (N + 1)| < 1 / ((N : ℝ) + 1) ∧
        |suzukiCriticalChordPolarRieszMass (ω N) (N + 1) -
          criticalPolarRieszMass (N + 1)| < 1 / ((N : ℝ) + 1) := by
  have hselect : ∀ N : ℕ, ∃ u : ℝ,
      0 < u ∧ u < 1 / ((N : ℝ) + 1) ∧
        |suzukiCriticalChordAtomicRieszMass u (N + 1) -
          criticalVonMangoldtRieszMass (N + 1)| < 1 / ((N : ℝ) + 1) ∧
        |suzukiCriticalChordPolarRieszMass u (N + 1) -
          criticalPolarRieszMass (N + 1)| < 1 / ((N : ℝ) + 1) := by
    intro N
    let ε : ℝ := 1 / ((N : ℝ) + 1)
    have hε : 0 < ε := by dsimp only [ε]; positivity
    have ha := tendsto_suzukiCriticalChordAtomicRieszMass
      (M := N + 1) (by omega : 1 ≤ N + 1)
    have hp := tendsto_suzukiCriticalChordPolarRieszMass
      (M := N + 1) (by omega : 1 ≤ N + 1)
    have haerr : ∀ᶠ u : ℝ in 𝓝[>] 0,
        suzukiCriticalChordAtomicRieszMass u (N + 1) ∈
          Metric.ball (criticalVonMangoldtRieszMass (N + 1)) ε :=
      ha.eventually (Metric.ball_mem_nhds _ hε)
    have hperr : ∀ᶠ u : ℝ in 𝓝[>] 0,
        suzukiCriticalChordPolarRieszMass u (N + 1) ∈
          Metric.ball (criticalPolarRieszMass (N + 1)) ε :=
      hp.eventually (Metric.ball_mem_nhds _ hε)
    have hcap : ∀ᶠ u : ℝ in 𝓝[>] 0, u ∈ Set.Ioo 0 ε :=
      Ioo_mem_nhdsGT hε
    obtain ⟨u, hua, hup, hucap⟩ := (haerr.and (hperr.and hcap)).exists
    refine ⟨u, hucap.1, hucap.2, ?_, ?_⟩
    · simpa only [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hua
    · simpa only [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hup
  choose ω hωpos hωcap haerr hperr using hselect
  refine ⟨ω, ?_, ?_, ?_, fun N => ⟨hωpos N, hωcap N, haerr N, hperr N⟩⟩
  · apply squeeze_zero'
      (Filter.Eventually.of_forall fun N => (hωpos N).le)
      (Filter.Eventually.of_forall fun N => (hωcap N).le)
    exact tendsto_one_div_add_atTop_nhds_zero_nat
  · rw [tendsto_zero_iff_norm_tendsto_zero]
    apply squeeze_zero'
      (Filter.Eventually.of_forall fun N => norm_nonneg _)
      (Filter.Eventually.of_forall fun N => ?_)
      tendsto_one_div_add_atTop_nhds_zero_nat
    simpa only [Real.norm_eq_abs] using (haerr N).le
  · rw [tendsto_zero_iff_norm_tendsto_zero]
    apply squeeze_zero'
      (Filter.Eventually.of_forall fun N => norm_nonneg _)
      (Filter.Eventually.of_forall fun N => ?_)
      tendsto_one_div_add_atTop_nhds_zero_nat
    simpa only [Real.norm_eq_abs] using (hperr N).le

/-- The canonical common positive-carrier schedule can be chosen with separately vanishing atomic
and polar excesses, and its critical parameter necessarily obeys the new square-root rate law. -/
theorem exists_suzukiCriticalChordPositiveRieszCofinalSchedule_with_sqrtRate :
    ∃ ω : ℕ → ℝ,
      Tendsto ω atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        suzukiCriticalChordAtomicRieszExcess (ω N) (N + 1)) atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        suzukiCriticalChordPolarRieszExcess (ω N) (N + 1)) atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ => ω N * Real.sqrt (N + 1 : ℕ)) atTop (𝓝 0) ∧
      ∀ N : ℕ, 0 < ω N := by
  obtain ⟨ω, hωzero, hatomic, hpolar, hall⟩ :=
    exists_suzukiCriticalChordPositiveRieszCofinalSchedule
  have hatomicExcess : Tendsto (fun N : ℕ =>
      suzukiCriticalChordAtomicRieszExcess (ω N) (N + 1)) atTop (𝓝 0) := by
    simpa only [suzukiCriticalChordAtomicRieszExcess] using hatomic
  have hpolarExcess : Tendsto (fun N : ℕ =>
      suzukiCriticalChordPolarRieszExcess (ω N) (N + 1)) atTop (𝓝 0) := by
    simpa only [suzukiCriticalChordPolarRieszExcess] using hpolar
  have hrate := tendsto_suzukiParameter_mul_sqrt_succ_of_atomicExcess
    ω (fun N => (hall N).1) hωzero hatomicExcess
  exact ⟨ω, hωzero, hatomicExcess, hpolarExcess, hrate, fun N => (hall N).1⟩

/-- **Source-faithful finite critical-chord law.**  Before scalarization, Suzuki's completed
critical jet is exactly positive atomic Riesz mass minus positive polar Riesz mass, plus the
Gamma boundary.  No absolute value or independent estimate separates the two arithmetic
carriers. -/
theorem suzukiCompletedRieszCriticalJetApprox_eq_atomic_sub_polar_add_gamma
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 1 ≤ M) :
    suzukiCompletedRieszCriticalJetApprox ω M =
      suzukiCriticalChordAtomicRieszMass ω M -
        suzukiCriticalChordPolarRieszMass ω M +
          2 * Real.eulerMascheroniConstant * (Real.sqrt M - 1) := by
  have hω0 : ω ≠ 0 := ne_of_gt hω
  rw [suzukiCompletedRieszCriticalJetApprox]
  have hpoint : ∀ k ∈ Finset.range (M - 1),
      (1 / 2 : ℝ) * ((suzukiCoupledError ω (k + 1) - 1) / ω) =
        (∑ n ∈ Finset.Icc 1 (k + 1), suzukiCriticalChordCoefficient ω n) -
          suzukiCriticalChordPolarMass ω (k + 1) := by
    intro k _hk
    have h := suzukiCoupledError_criticalChord_eq_atomic_sub_polar
      hω (by omega : 1 ≤ k + 1)
    convert h using 1
    field_simp [hω0]
  rw [Finset.sum_congr rfl (fun k hk => by rw [hpoint k hk])]
  rw [show
      (∑ k ∈ Finset.range (M - 1),
        (((∑ n ∈ Finset.Icc 1 (k + 1), suzukiCriticalChordCoefficient ω n) -
              suzukiCriticalChordPolarMass ω (k + 1) +
            2 * Real.eulerMascheroniConstant) *
          (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ)))) =
        (∑ k ∈ Finset.range (M - 1),
          (∑ n ∈ Finset.Icc 1 (k + 1), suzukiCriticalChordCoefficient ω n) *
            (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) -
        (∑ k ∈ Finset.range (M - 1),
          suzukiCriticalChordPolarMass ω (k + 1) *
            (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) +
        2 * Real.eulerMascheroniConstant *
          (∑ k ∈ Finset.range (M - 1),
            (Real.sqrt (k + 2 : ℕ) - Real.sqrt (k + 1 : ℕ))) by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro k _hk
      ring]
  rw [sum_prefix_mul_sqrtMesh_eq_sum_sqrtGap
      (suzukiCriticalChordCoefficient ω) hM,
    sum_range_sqrtMesh_eq_sqrt_sub_one hM,
    suzukiCriticalChordAtomicRieszMass, suzukiCriticalChordPolarRieszMass]

/-- **Exact higher-grade defect law.**  Relative to the critical prime--Lebesgue carrier, the
entire finite Suzuki deformation is exactly atomic higher-grade surplus minus polar secant
surplus.  The Gamma boundary cancels identically in this comparison. -/
theorem suzukiCompletedRieszCriticalJetApprox_sub_criticalCarrier_eq_excessDifference
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 1 ≤ M) :
    suzukiCompletedRieszCriticalJetApprox ω M -
        (criticalVonMangoldtRieszMass M - criticalPolarRieszMass M +
          2 * Real.eulerMascheroniConstant * (Real.sqrt M - 1)) =
      suzukiCriticalChordAtomicRieszExcess ω M -
        suzukiCriticalChordPolarRieszExcess ω M := by
  rw [suzukiCompletedRieszCriticalJetApprox_eq_atomic_sub_polar_add_gamma hω hM,
    suzukiCriticalChordAtomicRieszExcess, suzukiCriticalChordPolarRieszExcess]
  ring

/-- **Literal-source excess law.**  Suzuki's finite critical jet differs from the actual completed
Möbius-divisor RH source by exactly higher-grade atomic surplus minus polar secant surplus. -/
theorem suzukiCompletedRieszCriticalJetApprox_sub_mobiusMoment_eq_excessDifference
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 1 ≤ M) :
    suzukiCompletedRieszCriticalJetApprox ω M -
        mobiusDivisorSquareRootAbelMoment M =
      suzukiCriticalChordAtomicRieszExcess ω M -
        suzukiCriticalChordPolarRieszExcess ω M := by
  rw [← criticalCarrier_add_gamma_eq_mobiusDivisorSquareRootAbelMoment hM]
  exact
    suzukiCompletedRieszCriticalJetApprox_sub_criticalCarrier_eq_excessDifference hω hM

/-- Completed Suzuki critical jet in the pole-free signed Möbius coordinates. -/
theorem suzukiCompletedRieszCriticalJetApprox_eq_renormalizedMobius_sub_polar_add_gamma
    {ω : ℝ} (hω : 0 < ω) {M : ℕ} (hM : 1 ≤ M) :
    suzukiCompletedRieszCriticalJetApprox ω M =
      suzukiCriticalRenormalizedMobiusRieszProducer ω M -
        suzukiCriticalChordPolarRieszMass ω M +
          2 * Real.eulerMascheroniConstant * (Real.sqrt M - 1) := by
  rw [suzukiCompletedRieszCriticalJetApprox_eq_atomic_sub_polar_add_gamma hω hM,
    suzukiCriticalRenormalizedMobiusRieszProducer_eq_atomic hω]

/-- **Literal-source cofinal second-grade landing.**  There is a positive critical schedule along
which the normalized completed Suzuki jet relative to the actual Möbius-divisor source converges
to the exact signed arithmetic-minus-polar second-grade Riesz functional at the same growing
aperture.  The error is pointwise smaller than `1 / (N + 1)`.

This is the coefficient-faithful diagonal convergence missing between the finite critical
variation and the moving arithmetic boundary.  It preserves atomic--polar cancellation before
normalization.  It is deliberately not a boundedness theorem for the moving target on the
right-hand side. -/
theorem exists_suzukiCompletedRieszCriticalSecondGradeCofinalSchedule :
    ∃ ω : ℕ → ℝ,
      Tendsto ω atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        (suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
            mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N -
          (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
            criticalPolarSecondGradeRieszMass (N + 1))) atTop (𝓝 0) ∧
      ∀ N : ℕ,
        0 < ω N ∧
        ω N < 1 / ((N : ℝ) + 1) ∧
        |(suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
              mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N -
            (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
              criticalPolarSecondGradeRieszMass (N + 1))| <
          1 / ((N : ℝ) + 1) := by
  have hselect : ∀ N : ℕ, ∃ u : ℝ,
      0 < u ∧
      u < 1 / ((N : ℝ) + 1) ∧
      |(suzukiCriticalChordAtomicRieszExcess u (N + 1) -
            suzukiCriticalChordPolarRieszExcess u (N + 1)) / u -
          (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
            criticalPolarSecondGradeRieszMass (N + 1))| <
        1 / ((N : ℝ) + 1) := by
    intro N
    let ε : ℝ := 1 / ((N : ℝ) + 1)
    have hε : 0 < ε := by
      dsimp only [ε]
      positivity
    have hlimit :=
      tendsto_suzukiCriticalChordSignedRieszExcess_secondGrade (N + 1)
    have herror : ∀ᶠ u : ℝ in 𝓝[>] 0,
        (suzukiCriticalChordAtomicRieszExcess u (N + 1) -
            suzukiCriticalChordPolarRieszExcess u (N + 1)) / u ∈
          Metric.ball
            (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
              criticalPolarSecondGradeRieszMass (N + 1)) ε :=
      hlimit.eventually (Metric.ball_mem_nhds _ hε)
    have hcap : ∀ᶠ u : ℝ in 𝓝[>] 0, u ∈ Set.Ioo 0 ε :=
      Ioo_mem_nhdsGT hε
    obtain ⟨u, huerror, hucap⟩ := (herror.and hcap).exists
    refine ⟨u, hucap.1, hucap.2, ?_⟩
    simpa only [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using huerror
  choose ω hωpos hωcap herror using hselect
  have hsourceError : ∀ N : ℕ,
      |(suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
            mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N -
          (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
            criticalPolarSecondGradeRieszMass (N + 1))| <
        1 / ((N : ℝ) + 1) := by
    intro N
    rw [suzukiCompletedRieszCriticalJetApprox_sub_mobiusMoment_eq_excessDifference
      (hωpos N) (by omega : 1 ≤ N + 1)]
    exact herror N
  refine ⟨ω, ?_, ?_, fun N => ⟨hωpos N, hωcap N, hsourceError N⟩⟩
  · apply squeeze_zero'
      (Filter.Eventually.of_forall fun N => (hωpos N).le)
      (Filter.Eventually.of_forall fun N => (hωcap N).le)
    exact tendsto_one_div_add_atTop_nhds_zero_nat
  · rw [tendsto_zero_iff_norm_tendsto_zero]
    apply squeeze_zero'
      (Filter.Eventually.of_forall fun N => norm_nonneg _)
      (Filter.Eventually.of_forall fun N => ?_)
      tendsto_one_div_add_atTop_nhds_zero_nat
    simpa only [Real.norm_eq_abs] using (hsourceError N).le

/-- **Literal completed-source cofinal cancellation.**  A positive critical schedule carries the
actual completed Suzuki jet relative to the Möbius-divisor source into the global signed
second-grade cancellation law.  The literal source quotient is multiplied by the inverse mesh
scale before any atomic--polar separation.  The selected schedule retains the pointwise
coefficient-faithful landing error from
`exists_suzukiCompletedRieszCriticalSecondGradeCofinalSchedule`. -/
theorem exists_suzukiCompletedRieszCriticalSecondGradeNormalizedCofinalCancellation :
    ∃ ω : ℕ → ℝ,
      Tendsto ω atTop (𝓝 0) ∧
      Tendsto (fun N : ℕ =>
        (selbergSecondGradeSqrtMeshScale N)⁻¹ *
          ((suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
              mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N))
        atTop (𝓝 0) ∧
      ∀ N : ℕ,
        0 < ω N ∧
        ω N < 1 / ((N : ℝ) + 1) ∧
        |(suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
              mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N -
            (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
              criticalPolarSecondGradeRieszMass (N + 1))| <
          1 / ((N : ℝ) + 1) := by
  obtain ⟨ω, hω, herror, hpoint⟩ :=
    exists_suzukiCompletedRieszCriticalSecondGradeCofinalSchedule
  refine ⟨ω, hω, ?_, hpoint⟩
  have hinv : Tendsto (fun N : ℕ =>
      (selbergSecondGradeSqrtMeshScale N)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp tendsto_selbergSecondGradeSqrtMeshScale_atTop
  have hscaledError := hinv.mul herror
  have htarget := tendsto_normalized_criticalSecondGradeSignedRieszMass
  have hsum : Tendsto (fun N : ℕ =>
      (selbergSecondGradeSqrtMeshScale N)⁻¹ *
          ((suzukiCompletedRieszCriticalJetApprox (ω N) (N + 1) -
              mobiusDivisorSquareRootAbelMoment (N + 1)) / ω N -
            (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
              criticalPolarSecondGradeRieszMass (N + 1))) +
        (selbergSecondGradeSqrtMeshScale N)⁻¹ *
          (criticalVonMangoldtSecondGradeRieszMass (N + 1) -
            criticalPolarSecondGradeRieszMass (N + 1))) atTop (𝓝 0) := by
    simpa using hscaledError.add htarget
  convert hsum using 1
  funext N
  ring

def suzukiShiftedCoefficientComplexSecondJet (n : ℕ) (ω : ℝ) : ℝ :=
  (deriv (deriv (GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n))
    (ω : ℂ)).re

theorem suzukiShiftedCoefficientComplexSecondJet_zero (n : ℕ) :
    suzukiShiftedCoefficientComplexSecondJet n 0 =
      4 * ((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) n) := by
  have h := GaloisForLFunctions.HTGeometry.iteratedDeriv_two_shiftedEulerCoeff n
  simp only [iteratedDeriv_succ, iteratedDeriv_zero] at h
  rw [suzukiShiftedCoefficientComplexSecondJet]
  norm_num only [Complex.ofReal_zero]
  rw [h]
  norm_num

theorem hasDerivAt_suzukiShiftedCoefficientComplexSecondJet_zero (n : ℕ) :
    HasDerivAt (suzukiShiftedCoefficientComplexSecondJet n)
      ((8 * (((((ArithmeticFunction.vonMangoldt *
          ArithmeticFunction.vonMangoldt) *
            ArithmeticFunction.vonMangoldt) n : ℝ) : ℂ)) +
        2 * (((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ) *
          (Real.log n : ℂ) ^ 2)).re) 0 := by
  let f := GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n
  have hdiff : Differentiable ℂ f := by
    dsimp only [f]
    unfold GaloisForLFunctions.HTGeometry.shiftedEulerCoeff
    fun_prop
  have han : AnalyticAt ℂ f 0 :=
    GaloisForLFunctions.HTGeometry.analyticAt_of_differentiable_univariate hdiff 0
  have hdcomplex : HasDerivAt (deriv (deriv f)) (iteratedDeriv 3 f 0) 0 := by
    have hraw := han.deriv.deriv.differentiableAt.hasDerivAt
    have hiter : iteratedDeriv 3 f 0 = deriv (deriv (deriv f)) 0 := by
      norm_num [iteratedDeriv_succ]
    rw [hiter]
    exact hraw
  have hdreal := hdcomplex.comp_ofReal
  have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt 0 hdreal
  have hthree :=
    GaloisForLFunctions.HTGeometry.iteratedDeriv_three_shiftedEulerCoeff n
  change HasDerivAt (fun ω : ℝ => (deriv (deriv f) (ω : ℂ)).re) _ 0
  have hre' : HasDerivAt (fun ω : ℝ => (deriv (deriv f) (ω : ℂ)).re)
      (iteratedDeriv 3 f 0).re 0 := by
    simpa [Function.comp_def] using hre
  have hthreef : iteratedDeriv 3 f 0 =
      8 * (((((ArithmeticFunction.vonMangoldt *
          ArithmeticFunction.vonMangoldt) *
            ArithmeticFunction.vonMangoldt) n : ℝ) : ℂ)) +
        2 * (((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ) *
          (Real.log n : ℂ) ^ 2) := by
    simpa only [f] using hthree
  rw [hthreef] at hre'
  exact hre'

/-- Third-grade source forced by the exact Suzuki transverse jet. -/
def suzukiCriticalThirdGradeCoefficient (n : ℕ) : ℝ :=
  (2 / 3 : ℝ) *
      (((ArithmeticFunction.vonMangoldt *
        ArithmeticFunction.vonMangoldt) *
          ArithmeticFunction.vonMangoldt) n) +
    (1 / 6 : ℝ) * ArithmeticFunction.vonMangoldt n * (Real.log n) ^ 2

private theorem tendsto_suzukiCriticalChordCoefficient_thirdGrade_of_one_le
    {n : ℕ} (hn : 1 ≤ n) :
    Tendsto (fun ω : ℝ =>
      (suzukiCriticalChordCoefficient ω n -
          ArithmeticFunction.vonMangoldt n -
        ω * ((ArithmeticFunction.vonMangoldt *
          ArithmeticFunction.vonMangoldt) n)) / ω ^ 2)
      (𝓝[>] 0) (𝓝 (suzukiCriticalThirdGradeCoefficient n)) := by
  let L1 : ℝ := ArithmeticFunction.vonMangoldt n
  let L2 : ℝ := (ArithmeticFunction.vonMangoldt *
    ArithmeticFunction.vonMangoldt) n
  let J3 : ℝ :=
    ((8 * (((((ArithmeticFunction.vonMangoldt *
          ArithmeticFunction.vonMangoldt) *
            ArithmeticFunction.vonMangoldt) n : ℝ) : ℂ)) +
        2 * (((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ) *
          (Real.log n : ℂ) ^ 2)).re)
  let A : ℝ → ℝ := fun ω =>
    suzukiShiftedCoefficient ω n - suzukiShiftedCoefficient 0 n -
      ω * (2 * L1) - ω ^ 2 * (2 * L2)
  let B : ℝ → ℝ := fun ω => 2 * ω ^ 3
  let A' : ℝ → ℝ := fun ω =>
    suzukiShiftedCoefficientComplexFirstJet n ω - 2 * L1 - ω * (4 * L2)
  let B' : ℝ → ℝ := fun ω => 6 * ω ^ 2
  let A'' : ℝ → ℝ := fun ω =>
    suzukiShiftedCoefficientComplexSecondJet n ω - 4 * L2
  let B'' : ℝ → ℝ := fun ω => 12 * ω
  have hA'A'' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt A' (A'' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      let f := GaloisForLFunctions.HTGeometry.shiftedEulerCoeff n
      have hdiff : Differentiable ℂ f := by
        dsimp only [f]
        unfold GaloisForLFunctions.HTGeometry.shiftedEulerCoeff
        fun_prop
      have han : AnalyticAt ℂ f (ω : ℂ) :=
        GaloisForLFunctions.HTGeometry.analyticAt_of_differentiable_univariate hdiff (ω : ℂ)
      have hdcomplex : HasDerivAt (deriv f) (deriv (deriv f) (ω : ℂ)) (ω : ℂ) :=
        han.deriv.differentiableAt.hasDerivAt
      have hdreal := hdcomplex.comp_ofReal
      have hre := Complex.reCLM.hasFDerivAt.comp_hasDerivAt ω hdreal
      have hjet : HasDerivAt (suzukiShiftedCoefficientComplexFirstJet n)
          (suzukiShiftedCoefficientComplexSecondJet n ω) ω := by
        change HasDerivAt (fun u : ℝ => (deriv f (u : ℂ)).re)
          (deriv (deriv f) (ω : ℂ)).re ω
        simpa [Function.comp_def] using hre
      have hraw := (hjet.sub_const (2 * L1)).sub
        ((hasDerivAt_id ω).mul_const (4 * L2))
      exact hraw.congr_deriv (by simp only [A'', L2]; ring)
  have hB'B'' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt B' (B'' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      have hraw := ((hasDerivAt_id ω).pow 2).const_mul (6 : ℝ)
      exact hraw.congr_deriv (by simp only [B'', Function.id_def]; ring)
  have hB''ne : ∀ᶠ ω : ℝ in 𝓝[≠] 0, B'' ω ≠ 0 := by
    filter_upwards [self_mem_nhdsWithin] with ω hω
    exact mul_ne_zero (by norm_num) hω
  have hA'0 : Tendsto A' (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt A' 0 := by
      dsimp only [A']
      exact (((hasDerivAt_suzukiShiftedCoefficientComplexFirstJet_zero n).continuousAt.sub
        continuousAt_const).sub (continuousAt_id.mul continuousAt_const))
    simpa only [A', suzukiShiftedCoefficientComplexFirstJet_zero, L1,
      zero_mul, sub_zero, sub_self] using hc.tendsto.mono_left nhdsWithin_le_nhds
  have hB'0 : Tendsto B' (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt B' 0 := by
      dsimp only [B']
      fun_prop
    simpa only [B', zero_pow (by norm_num : (2 : ℕ) ≠ 0), mul_zero] using
      hc.tendsto.mono_left nhdsWithin_le_nhds
  have hsecondRatio : Tendsto (fun ω : ℝ => A'' ω / B'' ω)
      (𝓝[≠] 0) (𝓝 (J3 / 12)) := by
    have hslope :=
      (hasDerivAt_suzukiShiftedCoefficientComplexSecondJet_zero n).tendsto_slope.div_const
        (12 : ℝ)
    convert hslope using 1
    · funext ω
      rw [slope_def_field, suzukiShiftedCoefficientComplexSecondJet_zero]
      simp only [A'', B'', L2]
      simp only [div_eq_mul_inv, mul_inv]
      ring
  have hfirstRatio : Tendsto (fun ω : ℝ => A' ω / B' ω)
      (𝓝[≠] 0) (𝓝 (J3 / 12)) :=
    HasDerivAt.lhopital_zero_nhdsNE hA'A'' hB'B'' hB''ne hA'0 hB'0 hsecondRatio
  have hAA' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt A (A' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      have hraw := ((((hasDerivAt_suzukiShiftedCoefficient_eq_complexFirstJet hn ω).sub_const
        (suzukiShiftedCoefficient 0 n)).sub
          ((hasDerivAt_id ω).mul_const (2 * L1))).sub
            (((hasDerivAt_id ω).pow 2).mul_const (2 * L2)))
      exact hraw.congr_deriv (by simp only [A', Function.id_def]; ring)
  have hBB' : ∀ᶠ ω : ℝ in 𝓝[≠] 0, HasDerivAt B (B' ω) ω :=
    Filter.Eventually.of_forall fun ω => by
      have hraw := ((hasDerivAt_id ω).pow 3).const_mul (2 : ℝ)
      exact hraw.congr_deriv (by simp only [B', Function.id_def]; ring)
  have hB'ne : ∀ᶠ ω : ℝ in 𝓝[≠] 0, B' ω ≠ 0 := by
    filter_upwards [self_mem_nhdsWithin] with ω hω
    exact mul_ne_zero (by norm_num) (pow_ne_zero 2 hω)
  have hA0 : Tendsto A (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt A 0 := by
      dsimp only [A]
      exact ((((hasDerivAt_suzukiShiftedCoefficient_eq_complexFirstJet hn 0).continuousAt.sub
        continuousAt_const).sub (continuousAt_id.mul continuousAt_const)).sub
          (continuousAt_id.pow 2 |>.mul continuousAt_const))
    simpa only [A, zero_mul, zero_pow (by norm_num : (2 : ℕ) ≠ 0), sub_zero,
      sub_self] using hc.tendsto.mono_left nhdsWithin_le_nhds
  have hB0 : Tendsto B (𝓝[≠] 0) (𝓝 0) := by
    have hc : ContinuousAt B 0 := by
      dsimp only [B]
      fun_prop
    simpa only [B, zero_pow (by norm_num : (3 : ℕ) ≠ 0), mul_zero] using
      hc.tendsto.mono_left nhdsWithin_le_nhds
  have hratio : Tendsto (fun ω : ℝ => A ω / B ω)
      (𝓝[≠] 0) (𝓝 (J3 / 12)) :=
    HasDerivAt.lhopital_zero_nhdsNE hAA' hBB' hB'ne hA0 hB0 hfirstRatio
  have hmono : 𝓝[>] (0 : ℝ) ≤ 𝓝[≠] 0 :=
    nhdsWithin_mono 0 (by
      intro ω hω
      simp only [Set.mem_Ioi] at hω
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      exact ne_of_gt hω)
  have hright := hratio.mono_left hmono
  have hJ3 : J3 / 12 = suzukiCriticalThirdGradeCoefficient n := by
    simp only [J3, suzukiCriticalThirdGradeCoefficient]
    simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero, pow_two]
    norm_num
    ring
  rw [hJ3] at hright
  refine hright.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ω hω
  have hω0 : ω ≠ 0 := ne_of_gt hω
  symm
  simp only [A, B, suzukiCriticalChordCoefficient, L1, L2]
  field_simp [hω0]

/-- **Unconditional atomic third-grade law.**  On every canonical positive arithmetic label,
the literal Suzuki chord has third grade
`(2/3) Λ*Λ*Λ + (1/6) Λ log²`.  The second summand is the prime-power curvature forced by the
Euler coefficient and is absent from a pure triple-convolution surrogate. -/
theorem tendsto_suzukiCriticalChordCoefficient_thirdGrade (n : ℕ) :
    Tendsto (fun ω : ℝ =>
      (suzukiCriticalChordCoefficient ω (n + 1) -
          ArithmeticFunction.vonMangoldt (n + 1) -
        ω * ((ArithmeticFunction.vonMangoldt *
          ArithmeticFunction.vonMangoldt) (n + 1))) / ω ^ 2)
      (𝓝[>] 0) (𝓝 (suzukiCriticalThirdGradeCoefficient (n + 1))) :=
  tendsto_suzukiCriticalChordCoefficient_thirdGrade_of_one_le (by omega)

end

