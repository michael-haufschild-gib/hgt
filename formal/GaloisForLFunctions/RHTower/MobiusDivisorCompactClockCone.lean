import GaloisForLFunctions.RHTower.MobiusDivisorCompactClockSeparation
import Mathlib.Analysis.Convex.Cone.Dual
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Positive synthesis on an entire compact clock interval

The positive cone generated by arbitrarily late translates of the literal
complete Abel log source is uniformly dense in every compact clock space.
A single finite positive mixture therefore gives strict negativity throughout
the whole interval. The final theorem transfers that sign to the unnormalized
complete Abel source with all positive dilation weights explicit.
-/

noncomputable section
open Set Filter Topology
open scoped NNReal
namespace RHTower

/-- Every continuous target on a compact clock interval belongs to the closed positive cone
of literal complete-source profiles with source depth beyond any prescribed threshold. -/
theorem criticalClockProfile_positiveCone_dense (a : ℝ≥0) (T : ℝ)
    (f : C(CriticalClockWindow a, ℝ)) :
    f ∈ closure (PointedCone.hull ℝ
      (Set.range fun t : {t : ℝ // T < t} => criticalClockProfile a t) :
        Set C(CriticalClockWindow a, ℝ)) := by
  let K : PointedCone ℝ C(CriticalClockWindow a, ℝ) :=
    PointedCone.hull ℝ (Set.range fun t : {t : ℝ // T < t} => criticalClockProfile a t)
  let D : ProperCone ℝ C(CriticalClockWindow a, ℝ) := ⟨K.closure, isClosed_closure⟩
  change f ∈ D
  by_contra hf
  obtain ⟨L, hL, hLf⟩ := D.hyperplane_separation_point hf
  have hLne : L ≠ 0 := by intro he; simp [he] at hLf
  obtain ⟨t, ht, hneg⟩ := exists_negative_criticalClockProfile_pairing a L hLne T
  have hmem : criticalClockProfile a t ∈ D :=
    subset_closure (PointedCone.subset_hull ⟨⟨t, ht⟩, rfl⟩)
  exact (not_lt_of_ge (hL _ hmem)) hneg

/-- Uniform synthesis of an arbitrary continuous clock profile by a finite positive mixture
of the actual complete source, with every source depth beyond the requested threshold. -/
theorem exists_positive_criticalClockProfile_approximation (a : ℝ≥0) (T : ℝ)
    (f : C(CriticalClockWindow a, ℝ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ c : {t : ℝ // T < t} →₀ ℝ≥0,
      ‖f - c.sum (fun t b => b • criticalClockProfile a t)‖ < ε := by
  obtain ⟨g, hg, hdist⟩ := Metric.mem_closure_iff.mp
    (criticalClockProfile_positiveCone_dense a T f) ε hε
  obtain ⟨c, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hg
  refine ⟨c, ?_⟩
  rw [dist_eq_norm] at hdist
  convert hdist using 1
  congr 2

/-- One finite positive mixture has strict negative sign simultaneously throughout the
entire compact clock interval, even after deleting an arbitrary initial source-depth segment. -/
theorem exists_positive_criticalClockProfile_uniformly_negative (a : ℝ≥0) (T : ℝ) :
    ∃ c : {t : ℝ // T < t} →₀ ℝ≥0, ∀ u : CriticalClockWindow a,
      c.sum (fun t b => (b : ℝ) * criticalAbelLogProfile ((t : ℝ) - u)) < 0 := by
  obtain ⟨c, hc⟩ := exists_positive_criticalClockProfile_approximation a T
    (ContinuousMap.const (CriticalClockWindow a) (-1)) (show (0 : ℝ) < 1 / 2 by norm_num)
  refine ⟨c, fun u => ?_⟩
  have hu := (ContinuousMap.norm_coe_le_norm
    (ContinuousMap.const (CriticalClockWindow a) (-1) -
      c.sum (fun t b => b • criticalClockProfile a t)) u).trans_lt hc
  have he : (c.sum (fun t b => b • criticalClockProfile a t)) u =
      c.sum (fun t b => (b : ℝ) * criticalAbelLogProfile ((t : ℝ) - u)) := by
    simp only [Finsupp.sum, ContinuousMap.sum_apply, ContinuousMap.smul_apply,
      NNReal.smul_def, smul_eq_mul, criticalClockProfile, ContinuousMap.coe_mk]
  rw [ContinuousMap.sub_apply, ContinuousMap.const_apply, he, Real.norm_eq_abs] at hu
  have hh := (abs_lt.mp hu).1
  linarith

/-- A finite positive mixture of the unnormalized, literal complete Abel source is
strictly negative on every cutoff of the prescribed multiplicative clock interval. -/
theorem exists_positive_criticalContinuousAbel_uniformly_negative (a : ℝ≥0) (T : ℝ) :
    ∃ c : {t : ℝ // T < t} →₀ ℝ≥0, ∀ u : CriticalClockWindow a,
      c.sum (fun t b => (b : ℝ) * Real.exp (-(3 / 2 : ℝ) * (t : ℝ)) *
        criticalContinuousAbel (Real.exp ((t : ℝ) - u))) < 0 := by
  obtain ⟨c, hc⟩ := exists_positive_criticalClockProfile_uniformly_negative a T
  refine ⟨c, fun u => ?_⟩
  have he : c.sum (fun t b => (b : ℝ) * criticalAbelLogProfile ((t : ℝ) - u)) =
      Real.exp ((3 / 2 : ℝ) * (u : ℝ)) * c.sum (fun t b =>
        (b : ℝ) * Real.exp (-(3 / 2 : ℝ) * (t : ℝ)) *
          criticalContinuousAbel (Real.exp ((t : ℝ) - u))) := by
    simp only [Finsupp.sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro t ht
    rw [criticalAbelLogProfile,
      show -(3 / 2 : ℝ) * ((t : ℝ) - u) =
        (3 / 2 : ℝ) * (u : ℝ) + -(3 / 2 : ℝ) * (t : ℝ) by ring, Real.exp_add]
    ring
  have h := hc u
  rw [he] at h
  nlinarith [Real.exp_pos ((3 / 2 : ℝ) * (u : ℝ))]

end RHTower
