import GaloisForLFunctions.RHTower.WeldClassTable

/-!
# The abstract rate-lattice weld interface

The results of `WeldClassTable` are stated for the *prime* rate family `{log p}`, with independence
supplied by unique factorization.  This module extracts the prime-independent core: every one of them
depends only on the family being `ℤ`-linearly independent as reals, never on the arithmetic.  So they
generalize verbatim to an **arbitrary `ℤ`-linearly-independent family of real rates** `r : ι → ℝ`.

The generalization separates the two ingredients that were entangled in the prime statements:
* a *linear-algebra core* — an independent rate family gives independent weld classes, and the weld of
  a constant lands in exactly the lattice generated by that constant — proved through the injective
  weld-class homomorphism `weldClassHom : ℝ ↪ H²`;
* an *input* — for the primes, `ℤ`-linear independence of `{log p}` (unique factorization).

A non-arithmetic object — one fixed by a constraint that is *not* a functional equation — supplies its
own rate family and its own independence proof and inherits the whole weld/independence/lattice
structure by instantiating these theorems.  The prime family is recovered as a single instance,
confirming the generalization is faithful.
-/

noncomputable section

namespace GaloisForLFunctions
namespace RHTower

/-- **Abstract independence transport.**  For any `ℤ`-linearly-independent family of real rates
`r : ι → ℝ`, the weld classes `{weldClass (r i)}` are `ℤ`-linearly independent in `H²`: a
finitely-supported integer combination that vanishes has all coefficients zero.  The whole content is
transported through the injective weld-class homomorphism; the arithmetic of the primes plays no role.
`primes_weld_class_indep` is the instance `r = log ∘ (·)` over `Nat.Primes`. -/
theorem weldClass_indep_of_linIndep {ι : Type*} {r : ι → ℝ}
    (hr : LinearIndependent ℤ r) (c : ι →₀ ℤ)
    (h : c.sum (fun i z => z • weldClassHom (r i)) = 0) : c = 0 := by
  rw [linearIndependent_iff] at hr
  apply hr
  have hmap : weldClassHom (Finsupp.linearCombination ℤ r c) = 0 := by
    rw [Finsupp.linearCombination_apply, map_finsuppSum]
    simp_rw [map_zsmul]; exact h
  exact (weldClassHom_eq_zero_iff _).mp hmap

/-- **Abstract lattice membership.**  For any additive subgroup `Λ ⊆ ℝ`, the weld cocycle with
conversion constant `θ` is `Λ`-valued exactly when `θ ∈ Λ`.  This is `weld_isLatticeValued_primeLog_iff`
with the prime-log lattice replaced by an arbitrary ambient lattice; the weld's value lattice is always
the rank-one group `⟨θ⟩`, so membership in any `Λ` is decided by `θ` alone. -/
theorem weld_isLatticeValued_iff (Λ : AddSubgroup ℝ) (θ : ℝ) :
    IsLatticeValued Λ (weldCocycle θ) ↔ θ ∈ Λ := by
  constructor
  · intro h
    have hval := h weldGenD weldGenS
    rwa [weldCocycle_genD_genS] at hval
  · intro hθ x y
    simp only [weldCocycle]
    have hrw : θ * ((Multiplicative.toAdd x).1 : ℝ) * ((Multiplicative.toAdd y).2 : ℝ)
        = ((Multiplicative.toAdd x).1 * (Multiplicative.toAdd y).2) • θ := by
      rw [zsmul_eq_mul]; push_cast; ring
    rw [hrw]; exact Λ.zsmul_mem hθ _

/-- **Bridge to the standard predicate.**  The prime-log family is `ℤ`-linearly independent in
mathlib's sense; the tree's unique-factorization independence is exactly `LinearIndependent ℤ`.  This
makes the prime family a valid input to the abstract interface (and exposes the prime-log independence
to all of mathlib's linear-algebra machinery). -/
theorem primeLog_linearIndependent :
    LinearIndependent ℤ (fun p : Nat.Primes => Real.log (p : ℕ)) := by
  rw [linearIndependent_iff]
  intro l hl
  apply primeIndexedLogExpansion_coeff_eq_zero_of_sum_eq_zero
  rwa [Finsupp.linearCombination_apply] at hl

/-- Faithfulness: the prime rate family instantiates the abstract independence, recovering
`primes_weld_class_indep`. -/
example (c : Nat.Primes →₀ ℤ)
    (h : c.sum (fun p z => z • weldClassHom (Real.log (p : ℕ))) = 0) : c = 0 :=
  weldClass_indep_of_linIndep primeLog_linearIndependent c h

/-- Faithfulness: the prime-log lattice instantiates the abstract lattice-membership criterion,
recovering `weld_isLatticeValued_primeLog_iff`. -/
example (θ : ℝ) : IsLatticeValued primeLogLattice (weldCocycle θ) ↔ θ ∈ primeLogLattice :=
  weld_isLatticeValued_iff primeLogLattice θ

/-!
## The dual: the clock covector

The rate lattice `⟨r i⟩ ⊆ ℝ` carries accumulated rates; its dual carries *clock covectors* — the
`ℤ`-linear functionals `τ` that read a time value off each accumulated rate.  Independence of the
rates is the primal statement (`weldClass_indep_of_linIndep`); its dual is that the clock covector is
**free**: for an independent family, a covector realizing *any* prescribed rate-to-time assignment
exists, and is determined on the whole lattice exactly by its values on the rates.  So the covector is
not a datum chosen from outside — it is fixed by its action on the generators, and unconstrained
precisely because the rates carry no relation.  A covector is a functional on the lattice, never a
solution propagated by a flow.

An external constraint (for the primes: the functional equation `s ↦ 1 - s`, whose fixed locus is the
critical line, `sigmaConj_fixed_iff_critical`) is what *selects* one covector from this free family.
Where no such constraint is present, the family stays free — that selection is object-specific, not
supplied by the lattice. -/

/-- **Clock-covector uniqueness on the lattice.**  Two clock covectors that agree on every rate `r i`
agree on the whole rate lattice.  This needs no independence: an additive functional is determined on
the generated subgroup by its values on the generators. -/
theorem clock_covector_unique {ι : Type*} {r : ι → ℝ} (hr : LinearIndependent ℤ r)
    (τ₁ τ₂ : Submodule.span ℤ (Set.range r) →ₗ[ℤ] ℝ)
    (h : ∀ i, τ₁ ⟨r i, Submodule.subset_span ⟨i, rfl⟩⟩
            = τ₂ ⟨r i, Submodule.subset_span ⟨i, rfl⟩⟩) : τ₁ = τ₂ := by
  apply (Module.Basis.span hr).ext
  intro i
  have hb : (Module.Basis.span hr) i = ⟨r i, Submodule.subset_span ⟨i, rfl⟩⟩ :=
    Subtype.ext (Module.Basis.coe_span_apply hr i)
  rw [hb]; exact h i

/-- **The clock covector is free and unique.**  Dual to `weldClass_indep_of_linIndep`: for a
`ℤ`-linearly-independent rate family and any prescribed assignment `t : ι → ℝ` of a time value to each
rate, there is exactly one clock covector on the rate lattice realizing it.  Existence is the freeness
of the lattice on the independent family; uniqueness is `clock_covector_unique`. -/
theorem clock_covector_existsUnique {ι : Type*} {r : ι → ℝ} (hr : LinearIndependent ℤ r)
    (t : ι → ℝ) :
    ∃! τ : Submodule.span ℤ (Set.range r) →ₗ[ℤ] ℝ,
      ∀ i, τ ⟨r i, Submodule.subset_span ⟨i, rfl⟩⟩ = t i := by
  have hb : ∀ i, (Module.Basis.span hr) i = ⟨r i, Submodule.subset_span ⟨i, rfl⟩⟩ :=
    fun i => Subtype.ext (Module.Basis.coe_span_apply hr i)
  refine ⟨(Module.Basis.span hr).constr ℤ t, fun i => ?_, fun σ hσ => ?_⟩
  · rw [← hb, Module.Basis.constr_basis]
  · apply (Module.Basis.span hr).ext
    intro i
    rw [Module.Basis.constr_basis, hb]; exact hσ i

/-- The founding prime–archimedean weld carries a free, unique clock covector: on the prime-rate
lattice `⟨log p⟩` every assignment of a time value to each prime is realized by exactly one covector.
The prime instance of `clock_covector_existsUnique`. -/
theorem foundingWeld_clock_covector_existsUnique (t : Nat.Primes → ℝ) :
    ∃! τ : Submodule.span ℤ (Set.range (fun p : Nat.Primes => Real.log (p : ℕ))) →ₗ[ℤ] ℝ,
      ∀ p : Nat.Primes, τ ⟨Real.log (p : ℕ), Submodule.subset_span ⟨p, rfl⟩⟩ = t p :=
  clock_covector_existsUnique primeLog_linearIndependent t

end RHTower
end GaloisForLFunctions
