import GaloisForLFunctions.RHTower.FokasLenellsCausalSmoothGraph
import GaloisForLFunctions.HTGeometry.BarrelledSeminormBound
import Mathlib.Topology.Baire.CompleteMetrizable

/-! The inherited topology of genuine infinite derivative chains is a complete countable
seminorm topology. Its Baire and barrelled properties come from the actual closed carrier. -/
open Complex MeasureTheory Set Filter Topology
open scoped NNReal
open GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.HTGeometry.FokasLenells
namespace RHTower.FokasLenells
noncomputable section
local instance fokasLenellsCausalSmoothGraphTopologyInst1 : CompleteSpace (hardyL2ᗮ) := hardyL2.isClosed_orthogonal.completeSpace_coe
local instance : CompleteSpace causalSmoothGraph := causalSmoothGraph_complete

/-- Coordinate norm seminorms on the actual smooth graph, with the natural product-family index. -/
def causalSmoothGraphSeminorm : SeminormFamily ℝ causalSmoothGraph (Σ _j : ℕ, Fin 1) :=
  fun i => (normSeminorm ℝ (hardyL2ᗮ)).comp
    ((causalSmoothGraphCoordinate i.1).restrictScalars ℝ).toLinearMap

/-- Each defining seminorm is literally the Hilbert norm of its actual derivative coordinate. -/
theorem causalSmoothGraphSeminorm_apply (i : Σ _j : ℕ, Fin 1) (u : causalSmoothGraph) :
    causalSmoothGraphSeminorm i u = ‖causalSmoothGraphCoordinate i.1 u‖ := rfl

/-- The actual inherited product topology is generated by these concrete coordinate norms. -/
theorem withSeminorms_causalSmoothGraph : WithSeminorms causalSmoothGraphSeminorm := by
  have hp := withSeminorms_pi (fun _j : ℕ => norm_withSeminorms ℝ (hardyL2ᗮ))
  exact (causalSmoothGraph.subtype.restrictScalars ℝ).withSeminorms_induced hp

/-- Addition on the actual smooth graph is compatible with its inherited product uniformity. -/
theorem causalSmoothGraph_uniformAddGroup : IsUniformAddGroup causalSmoothGraph :=
  causalSmoothGraph.toAddSubgroup.isUniformAddGroup

local instance fokasLenellsCausalSmoothGraphTopologyInst2 : IsUniformAddGroup causalSmoothGraph := causalSmoothGraph_uniformAddGroup
local instance : FirstCountableTopology causalSmoothGraph :=
  withSeminorms_causalSmoothGraph.firstCountableTopology
local instance : (uniformity causalSmoothGraph).IsCountablyGenerated :=
  IsUniformAddGroup.uniformity_countably_generated

/-- The complete countable actual chain space is a Baire space. -/
theorem causalSmoothGraph_baire : BaireSpace causalSmoothGraph := inferInstance

local instance : BaireSpace causalSmoothGraph := causalSmoothGraph_baire
local instance : IsTopologicalAddGroup causalSmoothGraph :=
  withSeminorms_causalSmoothGraph.topologicalAddGroup
local instance fokasLenellsCausalSmoothGraphTopologyInst3 : ContinuousSMul ℝ causalSmoothGraph := withSeminorms_causalSmoothGraph.continuousSMul

/-- The actual smooth graph is barrelled, enabling the corpus finite-seminorm bound. -/
theorem causalSmoothGraph_barrelled : BarrelledSpace ℝ causalSmoothGraph := inferInstance

end
end RHTower.FokasLenells
