import GaloisForLFunctions.RHTower.TruncatedMoebiusResidual
import GaloisForLFunctions.RHTower.Sieve.ShiftReindex
import GaloisForLFunctions.RHTower.Sieve.IntervalMultiples
import GaloisForLFunctions.RHTower.EulerDeletionResidueMartingale
import GaloisForLFunctions.RHTower.EulerDeletionCanonicalClockResolvent

/-!
# Exact finite correlations of the Euler-deletion truncated divisor field

The boundary field retained by EDQ is
`T_N(k) = ∑_{d ≤ N, d ∣ k} μ(d)`.  This file expands one literal pair of
finite physical windows into its simultaneous divisor-incidence counts.  It
does not estimate a count, discard a Möbius sign, average a period, or replace
the physical window.
-/

noncomputable section
set_option autoImplicit false

open Finset ArithmeticFunction
open scoped BigOperators

namespace RHTower

/-- Exact simultaneous-divisor expansion of a finite shifted correlation of the literal
truncated Möbius divisor field. -/
theorem truncMoebiusDivisorSum_pair_correlation_eq (t L N h : ℕ) :
    ∑ k ∈ Ioc t (t + L),
        truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
      ∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
        ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
          ((#{k ∈ Ioc t (t + L) | d ∣ k ∧ e ∣ (k + h)} : ℕ) : ℝ) := by
  classical
  have hterm : ∀ k ∈ Ioc t (t + L),
      truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
        ∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
          if d ∣ k ∧ e ∣ (k + h) then
            ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) else 0 := by
    intro k _
    rw [truncMoebiusDivisorSum, truncMoebiusDivisorSum,
      Finset.sum_filter, Finset.sum_filter, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun e _ => ?_
    by_cases hd : d ∣ k
    · by_cases he : e ∣ (k + h)
      · rw [if_pos hd, if_pos he, if_pos ⟨hd, he⟩]
      · rw [if_pos hd, if_neg he, mul_zero, if_neg (fun hde => he hde.2)]
    · rw [if_neg hd, zero_mul, if_neg (fun hde => hd hde.1)]
  rw [Finset.sum_congr rfl hterm, Finset.sum_comm]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun e _ => ?_
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]

/-- Exact weighted simultaneous-divisor expansion.  The weight is left completely literal so it
can be the physical beta weight generated by an EDQ window; no uniformization is introduced. -/
theorem weighted_truncMoebiusDivisorSum_pair_correlation_eq
    (w : ℕ → ℝ) (t L N h : ℕ) :
    ∑ k ∈ Ioc t (t + L),
        w k * truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
      ∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
        ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
          ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)), w k := by
  classical
  have hterm : ∀ k ∈ Ioc t (t + L),
      w k * truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
        ∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
          if d ∣ k ∧ e ∣ (k + h) then
            w k * ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) else 0 := by
    intro k _
    rw [truncMoebiusDivisorSum, truncMoebiusDivisorSum,
      Finset.sum_filter, Finset.sum_filter]
    calc
      (w k * ∑ d ∈ Icc 1 N, if d ∣ k then ((moebius d : ℤ) : ℝ) else 0) *
          (∑ e ∈ Icc 1 N, if e ∣ (k + h) then ((moebius e : ℤ) : ℝ) else 0) =
        ((∑ d ∈ Icc 1 N, if d ∣ k then ((moebius d : ℤ) : ℝ) else 0) *
          (∑ e ∈ Icc 1 N, if e ∣ (k + h) then ((moebius e : ℤ) : ℝ) else 0)) * w k := by
            ring
      _ = (∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
          (if d ∣ k then ((moebius d : ℤ) : ℝ) else 0) *
            (if e ∣ (k + h) then ((moebius e : ℤ) : ℝ) else 0)) * w k := by
            rw [Finset.sum_mul_sum]
      _ = ∑ d ∈ Icc 1 N, ∑ e ∈ Icc 1 N,
          ((if d ∣ k then ((moebius d : ℤ) : ℝ) else 0) *
            (if e ∣ (k + h) then ((moebius e : ℤ) : ℝ) else 0)) * w k := by
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            intro d _
            rw [Finset.sum_mul]
      _ = _ := by
        refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun e _ => ?_
        by_cases hd : d ∣ k
        · by_cases he : e ∣ (k + h)
          · rw [if_pos hd, if_pos he, if_pos ⟨hd, he⟩]
            ring
          · simp [hd, he]
        · simp [hd]
  rw [Finset.sum_congr rfl hterm, Finset.sum_comm]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun e _ => ?_
  rw [← Finset.sum_filter]
  calc
    ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)),
        w k * ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) =
      ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)),
        (((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ)) * w k := by
          apply Finset.sum_congr rfl
          intro k _
          ring
    _ = _ := by rw [Finset.mul_sum]

/-- A simultaneous divisor incidence forces the shift to contain the common divisor. -/
theorem gcd_dvd_shift_of_joint_divisibility {d e k h : ℕ}
    (hd : d ∣ k) (he : e ∣ (k + h)) : Nat.gcd d e ∣ h := by
  have hgk : Nat.gcd d e ∣ k := dvd_trans (Nat.gcd_dvd_left d e) hd
  have hgkh : Nat.gcd d e ∣ k + h := dvd_trans (Nat.gcd_dvd_right d e) he
  exact (Nat.dvd_add_iff_right hgk).mpr hgkh

/-- Compatible shifted divisibility is one exact residue class modulo the lcm. -/
theorem exists_lcm_residueClass_of_gcd_dvd_shift
    {d e h : ℕ} (hd : 0 < d) (he : 0 < e)
    (hcompat : Nat.gcd d e ∣ h) :
    ∃ r < Nat.lcm d e,
      ∀ k : ℕ, (d ∣ k ∧ e ∣ k + h) ↔ k ≡ r [MOD Nat.lcm d e] := by
  let b := e - h % e
  have hg_b : Nat.gcd d e ∣ b := by
    have hmod : Nat.gcd d e ∣ h % e :=
      (Nat.dvd_mod_iff (Nat.gcd_dvd_right d e)).mpr hcompat
    exact Nat.dvd_sub (Nat.gcd_dvd_right d e) hmod
  have hcrt : (0 : ℕ) ≡ b [MOD Nat.gcd d e] :=
    (Nat.modEq_zero_iff_dvd.mpr hg_b).symm
  let r := (Nat.chineseRemainder' hcrt : ℕ)
  have hr_lt : r < Nat.lcm d e :=
    Nat.chineseRemainder'_lt_lcm hcrt hd.ne' he.ne'
  have hr_d : r ≡ 0 [MOD d] := (Nat.chineseRemainder' hcrt).prop.1
  have hr_e : r ≡ b [MOD e] := (Nat.chineseRemainder' hcrt).prop.2
  have hb_plus : e ∣ b + h := by
    refine ⟨h / e + 1, ?_⟩
    calc
      b + h = (e - h % e) + (h % e + e * (h / e)) := by
        rw [Nat.mod_add_div]
      _ = e * (h / e + 1) := by
        have hle : h % e ≤ e := Nat.le_of_lt (Nat.mod_lt h he)
        rw [← Nat.add_assoc, Nat.sub_add_cancel hle]
        ring
  have hr_e_plus : r + h ≡ 0 [MOD e] :=
    (hr_e.add_right h).trans (Nat.modEq_zero_iff_dvd.mpr hb_plus)
  refine ⟨r, hr_lt, ?_⟩
  intro k
  constructor
  · rintro ⟨hk_d, hk_e⟩
    have hkdr : k ≡ r [MOD d] :=
      (Nat.modEq_zero_iff_dvd.mpr hk_d).trans hr_d.symm
    have hker : k + h ≡ r + h [MOD e] :=
      (Nat.modEq_zero_iff_dvd.mpr hk_e).trans hr_e_plus.symm
    have hker' : k ≡ r [MOD e] :=
      Nat.ModEq.add_right_cancel (Nat.ModEq.refl h) hker
    exact Nat.mod_lcm hkdr hker'
  · intro hkr
    constructor
    · exact Nat.modEq_zero_iff_dvd.mp
        ((hkr.of_dvd (Nat.dvd_lcm_left d e)).trans hr_d)
    · exact Nat.modEq_zero_iff_dvd.mp
        (((hkr.of_dvd (Nat.dvd_lcm_right d e)).add_right h).trans hr_e_plus)

/-- On a fixed physical interval, a compatible simultaneous-divisor filter is precisely its
single lcm residue class. -/
theorem joint_divisibility_filter_eq_lcm_residueClass
    (t L d e h : ℕ) (hd : 0 < d) (he : 0 < e)
    (hcompat : Nat.gcd d e ∣ h) :
    ∃ r < Nat.lcm d e,
      Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)) =
        Finset.filter (fun k => k ≡ r [MOD Nat.lcm d e]) (Ioc t (t + L)) := by
  obtain ⟨r, hr, hclass⟩ := exists_lcm_residueClass_of_gcd_dvd_shift hd he hcompat
  refine ⟨r, hr, ?_⟩
  ext k
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hk, hjoint⟩
    exact ⟨hk, (hclass k).mp hjoint⟩
  · rintro ⟨hk, hres⟩
    exact ⟨hk, (hclass k).mpr hres⟩

/-- The compatible joint incidence count is an exact lcm-floor boundary term. -/
theorem joint_divisibility_card_eq_lcm_floor
    (t L d e h : ℕ) (hd : 0 < d) (he : 0 < e)
    (hcompat : Nat.gcd d e ∣ h) :
    ∃ r < Nat.lcm d e,
      ((Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L))).card : ℤ) =
        max (⌊((↑(t + L) : ℚ) - ↑r) / ↑(Nat.lcm d e)⌋ -
          ⌊((↑t : ℚ) - ↑r) / ↑(Nat.lcm d e)⌋) 0 := by
  obtain ⟨r, hr, hfilter⟩ :=
    joint_divisibility_filter_eq_lcm_residueClass t L d e h hd he hcompat
  refine ⟨r, hr, ?_⟩
  rw [hfilter]
  exact Nat.Ioc_filter_modEq_card t (t + L) (Nat.lcm_pos hd he) r

/-- The signed coefficient of an exact lcm fibre in the complete finite divisor lattice. -/
def lcmMoebiusPairCoefficient (n : ℕ) : ℤ :=
  ∑ de ∈ (n.divisors ×ˢ n.divisors).filter (fun de => Nat.lcm de.1 de.2 = n),
    moebius de.1 * moebius de.2

private theorem sum_moebius_divisors_int (n : ℕ) :
    ∑ d ∈ n.divisors, moebius d = if n = 1 then 1 else 0 := by
  have h := congrArg (fun f : ArithmeticFunction ℤ => f n)
    ArithmeticFunction.moebius_mul_coe_zeta
  rw [ArithmeticFunction.coe_mul_zeta_apply] at h
  simpa only [ArithmeticFunction.one_apply] using h

private theorem divisor_sum_lcmMoebiusPairCoefficient (n : ℕ) :
    ∑ q ∈ n.divisors, lcmMoebiusPairCoefficient q = if n = 1 then 1 else 0 := by
  classical
  unfold lcmMoebiusPairCoefficient
  have hmem : ∀ (q : ℕ) (de : ℕ × ℕ),
      q ∈ n.divisors ∧
          de ∈ (q.divisors ×ˢ q.divisors).filter (fun de => Nat.lcm de.1 de.2 = q) ↔
        q ∈ n.divisors.filter (fun q => Nat.lcm de.1 de.2 = q) ∧
          de ∈ n.divisors ×ˢ n.divisors := by
    intro q de
    constructor
    · rintro ⟨hq, hde⟩
      obtain ⟨hdeq, hlcm⟩ := Finset.mem_filter.mp hde
      obtain ⟨hd, he⟩ := Finset.mem_product.mp hdeq
      refine ⟨Finset.mem_filter.mpr ⟨hq, hlcm⟩, Finset.mem_product.mpr ⟨?_, ?_⟩⟩
      · exact Nat.mem_divisors.mpr
          ⟨(Nat.dvd_of_mem_divisors hd).trans (Nat.dvd_of_mem_divisors hq),
            (Nat.mem_divisors.mp hq).2⟩
      · exact Nat.mem_divisors.mpr
          ⟨(Nat.dvd_of_mem_divisors he).trans (Nat.dvd_of_mem_divisors hq),
            (Nat.mem_divisors.mp hq).2⟩
    · rintro ⟨hq, hde⟩
      obtain ⟨hqdiv, hlcm⟩ := Finset.mem_filter.mp hq
      obtain ⟨hd, he⟩ := Finset.mem_product.mp hde
      have hq0 : q ≠ 0 := (Nat.pos_of_mem_divisors hqdiv).ne'
      refine ⟨hqdiv, Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, hlcm⟩⟩
      · exact Nat.mem_divisors.mpr ⟨by simpa [hlcm] using Nat.dvd_lcm_left de.1 de.2, hq0⟩
      · exact Nat.mem_divisors.mpr ⟨by simpa [hlcm] using Nat.dvd_lcm_right de.1 de.2, hq0⟩
  rw [Finset.sum_comm' hmem]
  have hinner : ∀ de ∈ n.divisors ×ˢ n.divisors,
      (∑ q ∈ n.divisors.filter (fun q => Nat.lcm de.1 de.2 = q),
        moebius de.1 * moebius de.2) = moebius de.1 * moebius de.2 := by
    intro de hde
    obtain ⟨hd, he⟩ := Finset.mem_product.mp hde
    have hqdiv : Nat.lcm de.1 de.2 ∈ n.divisors :=
      Nat.mem_divisors.mpr ⟨Nat.lcm_dvd (Nat.dvd_of_mem_divisors hd)
        (Nat.dvd_of_mem_divisors he), (Nat.mem_divisors.mp hd).2⟩
    have hfilter : n.divisors.filter (fun q => Nat.lcm de.1 de.2 = q) =
        {Nat.lcm de.1 de.2} := by
      ext q
      simp only [Finset.mem_filter, Finset.mem_singleton]
      constructor
      · rintro ⟨_, hq⟩
        exact hq.symm
      · intro hq
        subst q
        exact ⟨hqdiv, rfl⟩
    rw [hfilter, Finset.sum_singleton]
  rw [Finset.sum_congr rfl hinner, Finset.sum_product]
  change (∑ d ∈ n.divisors, ∑ e ∈ n.divisors, moebius d * moebius e) = _
  rw [← Finset.sum_mul_sum, sum_moebius_divisors_int]
  split_ifs <;> ring

/-- Full lcm fibres retain one signed Möbius coefficient; all extra pair terms cancel exactly. -/
theorem lcmMoebiusPairCoefficient_eq_moebius (n : ℕ) :
    lcmMoebiusPairCoefficient n = moebius n := by
  let delta : ℕ → ℤ := fun n => if n = 1 then 1 else 0
  have hpair : ∀ n > 0, ∑ q ∈ n.divisors, lcmMoebiusPairCoefficient q = delta n := by
    intro n hn
    exact divisor_sum_lcmMoebiusPairCoefficient n
  have hmu : ∀ n > 0, ∑ q ∈ n.divisors, moebius q = delta n := by
    intro n hn
    exact sum_moebius_divisors_int n
  have hpairInv :=
    (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq (f := lcmMoebiusPairCoefficient)
      (g := delta)).mp hpair
  have hmuInv :=
    (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq (f := moebius) (g := delta)).mp hmu
  rcases n.eq_zero_or_pos with rfl | hn
  · simp [lcmMoebiusPairCoefficient]
  · exact (hpairInv n hn).symm.trans (hmuInv n hn)

/-- At a physical lag divisible by its lcm, a complete signed Möbius lcm fibre
collapses to one divisor incidence. -/
theorem lcmMoebiusPairCorrelation_of_lcm_dvd_shift
    (t L n h : ℕ) (_hn : 0 < n) (hnh : n ∣ h) :
    ∑ de ∈ (n.divisors ×ˢ n.divisors).filter (fun de => Nat.lcm de.1 de.2 = n),
      ((moebius de.1 : ℤ) : ℝ) * ((moebius de.2 : ℤ) : ℝ) *
        ((#{k ∈ Ioc t (t + L) | de.1 ∣ k ∧ de.2 ∣ (k + h)} : ℕ) : ℝ) =
      ((moebius n : ℤ) : ℝ) * ((#{k ∈ Ioc t (t + L) | n ∣ k} : ℕ) : ℝ) := by
  classical
  have hfilter : ∀ de ∈ (n.divisors ×ˢ n.divisors).filter
      (fun de => Nat.lcm de.1 de.2 = n),
      Finset.filter (fun k => de.1 ∣ k ∧ de.2 ∣ (k + h)) (Ioc t (t + L)) =
        Finset.filter (fun k => n ∣ k) (Ioc t (t + L)) := by
    intro de hde
    obtain ⟨hdeq, hlcm⟩ := Finset.mem_filter.mp hde
    obtain ⟨hd, he⟩ := Finset.mem_product.mp hdeq
    have hd_n : de.1 ∣ n := by simpa [hlcm] using
      (Nat.dvd_lcm_left de.1 de.2)
    have he_n : de.2 ∣ n := by simpa [hlcm] using
      (Nat.dvd_lcm_right de.1 de.2)
    have he_h : de.2 ∣ h := he_n.trans hnh
    ext k
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨hk, hdk, hek⟩
      refine ⟨hk, ?_⟩
      have hek' : de.2 ∣ k := (Nat.dvd_add_iff_left he_h).mpr hek
      rw [← hlcm]
      exact Nat.lcm_dvd hdk hek'
    · rintro ⟨hk, hnk⟩
      refine ⟨hk, hd_n.trans hnk, ?_⟩
      exact Nat.dvd_add (he_n.trans hnk) he_h
  have hcount : ∀ de ∈ (n.divisors ×ˢ n.divisors).filter
      (fun de => Nat.lcm de.1 de.2 = n),
      ((#{k ∈ Ioc t (t + L) | de.1 ∣ k ∧ de.2 ∣ (k + h)} : ℕ) : ℝ) =
        ((#{k ∈ Ioc t (t + L) | n ∣ k} : ℕ) : ℝ) := by
    intro de hde
    rw [hfilter de hde]
  rw [Finset.sum_congr rfl fun de hde => by rw [hcount de hde]]
  rw [← Finset.sum_mul]
  have hcoeff :
      ∑ de ∈ (n.divisors ×ˢ n.divisors).filter (fun de => Nat.lcm de.1 de.2 = n),
        ((moebius de.1 : ℤ) : ℝ) * ((moebius de.2 : ℤ) : ℝ) =
          ((moebius n : ℤ) : ℝ) := by
    exact_mod_cast lcmMoebiusPairCoefficient_eq_moebius n
  rw [hcoeff]

/-- An incompatible common divisor removes a literal joint window exactly. -/
theorem joint_divisibility_filter_eq_empty_of_gcd_not_dvd
    (t L d e h : ℕ) (hcompat : ¬ Nat.gcd d e ∣ h) :
    Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)) = ∅ := by
  rw [Finset.filter_eq_empty_iff]
  intro k _ hjoint
  exact hcompat (gcd_dvd_shift_of_joint_divisibility hjoint.1 hjoint.2)

/-- The finite correlation contains only divisor pairs whose common divisor divides the literal
shift.  This is exact compatibility pruning, before any estimate of the surviving counts. -/
theorem truncMoebiusDivisorSum_pair_correlation_eq_gcd_compatible (t L N h : ℕ) :
    ∑ k ∈ Ioc t (t + L),
        truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
      ∑ d ∈ Icc 1 N,
        ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
            ((#{k ∈ Ioc t (t + L) | d ∣ k ∧ e ∣ (k + h)} : ℕ) : ℝ) := by
  rw [truncMoebiusDivisorSum_pair_correlation_eq]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro e he
  by_cases hcompat : Nat.gcd d e ∣ h
  · rw [if_pos hcompat]
  · rw [if_neg hcompat]
    have hempty := joint_divisibility_filter_eq_empty_of_gcd_not_dvd t L d e h hcompat
    simp [hempty]

/-- The beta-ready weighted correlation retains only GCD-compatible divisor pairs.  The physical
weight remains inside each literal finite joint incidence sum. -/
theorem weighted_truncMoebiusDivisorSum_pair_correlation_eq_gcd_compatible
    (w : ℕ → ℝ) (t L N h : ℕ) :
    ∑ k ∈ Ioc t (t + L),
        w k * truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) =
      ∑ d ∈ Icc 1 N,
        ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
            ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L)), w k := by
  rw [weighted_truncMoebiusDivisorSum_pair_correlation_eq]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro e he
  by_cases hcompat : Nat.gcd d e ∣ h
  · rw [if_pos hcompat]
  · rw [if_neg hcompat]
    have hempty := joint_divisibility_filter_eq_empty_of_gcd_not_dvd t L d e h hcompat
    simp [hempty]

/-- The exact square of one chronological EDQ truncated-divisor window is its diagonal plus
its literal signed lag correlations.  The interval is neither extended nor averaged. -/
theorem truncMoebiusDivisorSum_window_sq_eq_lag_correlation (t L N : ℕ) :
    (∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k) ^ 2 =
      ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N k +
        2 * ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
          truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) := by
  classical
  let f : ℕ → ℝ := fun n => truncMoebiusDivisorSum N (t + n + 1)
  let e : ℕ ↪ ℕ := ⟨fun n => t + n + 1, by
    intro a b hab
    dsimp at hab
    omega⟩
  have hset : (range L).map e = Ioc t (t + L) := by
    ext k
    simp only [mem_map, mem_range, mem_Ioc]
    constructor
    · rintro ⟨n, hn, rfl⟩
      dsimp [e]
      omega
    · intro hk
      refine ⟨k - t - 1, ?_, ?_⟩
      · omega
      · dsimp [e]
        omega
  have hwindow : (∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k) =
      ∑ n ∈ range L, f n := by
    rw [← hset, sum_map]
    rfl
  have hsymm : ∀ n m : ℕ, f n * f m = f m * f n := by
    intro n m
    ring
  have hsplit := Sieve.sum_pair_eq_diag_add_two_upper L (fun n m => f n * f m) hsymm
  have hupper := Sieve.sum_upper_triangle_eq_sum_shift L (fun n m => f n * f m)
  rw [hwindow]
  calc
    (∑ n ∈ range L, f n) ^ 2 =
        ∑ i ∈ range L, ∑ n ∈ range L, f i * f n := by
      rw [pow_two, sum_mul]
      apply sum_congr rfl
      intro i hi
      rw [mul_sum]
    _ = ∑ n ∈ range L, f n * f n +
        2 * ∑ h ∈ Ico 1 L, ∑ n ∈ range (L - h), f n * f (n + h) := by
      rw [hsplit, hupper]
    _ = ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N k +
        2 * ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
          truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) := by
      have hdiag : (∑ n ∈ range L, f n * f n) =
          ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N k := by
        rw [← hset, sum_map]
        apply sum_congr rfl
        intro n hn
        rfl
      have hlag : (∑ h ∈ Ico 1 L, ∑ n ∈ range (L - h), f n * f (n + h)) =
          ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
            truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h) := by
        apply sum_congr rfl
        intro h hh
        let eh : ℕ ↪ ℕ := ⟨fun n => t + n + 1, by
          intro a b hab
          dsimp at hab
          omega⟩
        have hseth : (range (L - h)).map eh = Ioc t (t + L - h) := by
          ext k
          simp only [mem_map, mem_range, mem_Ioc]
          constructor
          · rintro ⟨n, hn, rfl⟩
            dsimp [eh]
            omega
          · intro hk
            refine ⟨k - t - 1, ?_, ?_⟩
            · omega
            · dsimp [eh]
              omega
        rw [← hseth, sum_map]
        apply sum_congr rfl
        intro n hn
        have hidx : t + (n + h) + 1 = t + n + 1 + h := by omega
        change truncMoebiusDivisorSum N (t + n + 1) *
            truncMoebiusDivisorSum N (t + (n + h) + 1) =
          truncMoebiusDivisorSum N (t + n + 1) *
            truncMoebiusDivisorSum N (t + n + 1 + h)
        rw [hidx]
      rw [hdiag, hlag]

/-- Every off-diagonal part of a literal chronological EDQ window square is the exact signed
sum over GCD-compatible simultaneous-divisor incidences.  This exposes the cancellation problem
without absolute values, completion, or period averaging. -/
theorem truncMoebiusDivisorSum_window_sq_eq_gcd_compatible_lags (t L N : ℕ) :
    (∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k) ^ 2 =
      ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N k +
        2 * ∑ h ∈ Ico 1 L,
          ∑ d ∈ Icc 1 N,
            ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
              ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
                ((#{k ∈ Ioc t (t + L - h) | d ∣ k ∧ e ∣ (k + h)} : ℕ) : ℝ) := by
  rw [truncMoebiusDivisorSum_window_sq_eq_lag_correlation]
  have hlag : (∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
      truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N (k + h)) =
      ∑ h ∈ Ico 1 L,
        ∑ d ∈ Icc 1 N,
          ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
            ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
              ((#{k ∈ Ioc t (t + L - h) | d ∣ k ∧ e ∣ (k + h)} : ℕ) : ℝ) := by
    apply Finset.sum_congr rfl
    intro h hh
    have hhL : h ≤ L := Nat.le_of_lt (Finset.mem_Ico.mp hh).2
    have hend : t + (L - h) = t + L - h := by omega
    simpa only [hend] using
      truncMoebiusDivisorSum_pair_correlation_eq_gcd_compatible t (L - h) N h
  rw [hlag]

/-- Exact interval-square reindexing used for the physical beta weights of EDQ windows.  It only
reparametrizes the ordered pairs of a fixed finite interval by their literal shift. -/
private theorem sum_Ioc_sq_eq_lag_correlations (f : ℕ → ℝ) (t L : ℕ) :
    (∑ k ∈ Ioc t (t + L), f k) ^ 2 =
      ∑ k ∈ Ioc t (t + L), f k * f k +
        2 * ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h), f k * f (k + h) := by
  classical
  let g : ℕ → ℝ := fun n => f (t + n + 1)
  let e : ℕ ↪ ℕ := ⟨fun n => t + n + 1, by
    intro a b hab
    dsimp at hab
    omega⟩
  have hset : (range L).map e = Ioc t (t + L) := by
    ext k
    simp only [mem_map, mem_range, mem_Ioc]
    constructor
    · rintro ⟨n, hn, rfl⟩
      dsimp [e]
      omega
    · intro hk
      refine ⟨k - t - 1, ?_, ?_⟩
      · omega
      · dsimp [e]
        omega
  have hwindow : (∑ k ∈ Ioc t (t + L), f k) = ∑ n ∈ range L, g n := by
    rw [← hset, sum_map]
    rfl
  have hsymm : ∀ n m : ℕ, g n * g m = g m * g n := by
    intro n m
    ring
  have hsplit := Sieve.sum_pair_eq_diag_add_two_upper L (fun n m => g n * g m) hsymm
  have hupper := Sieve.sum_upper_triangle_eq_sum_shift L (fun n m => g n * g m)
  rw [hwindow]
  calc
    (∑ n ∈ range L, g n) ^ 2 =
        ∑ i ∈ range L, ∑ n ∈ range L, g i * g n := by
      rw [pow_two, sum_mul]
      apply sum_congr rfl
      intro i hi
      rw [mul_sum]
    _ = ∑ n ∈ range L, g n * g n +
        2 * ∑ h ∈ Ico 1 L, ∑ n ∈ range (L - h), g n * g (n + h) := by
      rw [hsplit, hupper]
    _ = ∑ k ∈ Ioc t (t + L), f k * f k +
        2 * ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h), f k * f (k + h) := by
      have hdiag : (∑ n ∈ range L, g n * g n) =
          ∑ k ∈ Ioc t (t + L), f k * f k := by
        rw [← hset, sum_map]
        apply sum_congr rfl
        intro n hn
        rfl
      have hlag : (∑ h ∈ Ico 1 L, ∑ n ∈ range (L - h), g n * g (n + h)) =
          ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h), f k * f (k + h) := by
        apply sum_congr rfl
        intro h hh
        let eh : ℕ ↪ ℕ := ⟨fun n => t + n + 1, by
          intro a b hab
          dsimp at hab
          omega⟩
        have hseth : (range (L - h)).map eh = Ioc t (t + L - h) := by
          ext k
          simp only [mem_map, mem_range, mem_Ioc]
          constructor
          · rintro ⟨n, hn, rfl⟩
            dsimp [eh]
            omega
          · intro hk
            refine ⟨k - t - 1, ?_, ?_⟩
            · omega
            · dsimp [eh]
              omega
        rw [← hseth, sum_map]
        apply sum_congr rfl
        intro n hn
        have hidx : t + (n + h) + 1 = t + n + 1 + h := by omega
        change f (t + n + 1) * f (t + (n + h) + 1) =
          f (t + n + 1) * f (t + n + 1 + h)
        rw [hidx]
      rw [hdiag, hlag]

/-- Exact beta-weighted EDQ window square.  The product of the two literal weights remains inside
each GCD-compatible simultaneous-divisor incidence sum, so all cross-window cancellation is
preserved. -/
theorem weighted_truncMoebiusDivisorSum_window_sq_eq_gcd_compatible_lags
    (w : ℕ → ℝ) (t L N : ℕ) :
    (∑ k ∈ Ioc t (t + L), w k * truncMoebiusDivisorSum N k) ^ 2 =
      ∑ k ∈ Ioc t (t + L),
        (w k * truncMoebiusDivisorSum N k) * (w k * truncMoebiusDivisorSum N k) +
        2 * ∑ h ∈ Ico 1 L,
          ∑ d ∈ Icc 1 N,
            ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
              ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
                ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L - h)),
                  w k * w (k + h) := by
  rw [sum_Ioc_sq_eq_lag_correlations (fun k => w k * truncMoebiusDivisorSum N k) t L]
  have hlag : (∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
      (w k * truncMoebiusDivisorSum N k) *
        (w (k + h) * truncMoebiusDivisorSum N (k + h))) =
      ∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
        (w k * w (k + h)) * truncMoebiusDivisorSum N k *
          truncMoebiusDivisorSum N (k + h) := by
    apply Finset.sum_congr rfl
    intro h hh
    apply Finset.sum_congr rfl
    intro k hk
    ring
  rw [hlag]
  have hcorr : (∑ h ∈ Ico 1 L, ∑ k ∈ Ioc t (t + L - h),
      (w k * w (k + h)) * truncMoebiusDivisorSum N k *
        truncMoebiusDivisorSum N (k + h)) =
      ∑ h ∈ Ico 1 L,
        ∑ d ∈ Icc 1 N,
          ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
            ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
              ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h)) (Ioc t (t + L - h)),
                w k * w (k + h) := by
    apply Finset.sum_congr rfl
    intro h hh
    have hhL : h ≤ L := Nat.le_of_lt (Finset.mem_Ico.mp hh).2
    have hend : t + (L - h) = t + L - h := by omega
    simpa only [hend] using
      weighted_truncMoebiusDivisorSum_pair_correlation_eq_gcd_compatible
        (fun k => w k * w (k + h)) t (L - h) N h
  rw [hcorr]

/-- Consecutive physical windows concatenate exactly.  The quotient–remainder beta exponent on
the resulting interval is the original block index times the block length. -/
theorem beta_weighted_consecutive_windows_eq_weighted_Ioc
    (f : ℕ → ℝ) (x : ℝ) (t Q C : ℕ) (hC : 0 < C) :
    (∑ s ∈ range Q, x ^ (s * C) * ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), f k) =
      ∑ k ∈ Ioc t (t + Q * C), x ^ ((k - t - 1) / C * C) * f k := by
  classical
  have hblock (s : ℕ) :
      (∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), f k) =
        ∑ n ∈ range C, f (t + s * C + n + 1) := by
    let e : ℕ ↪ ℕ := ⟨fun n => t + s * C + n + 1, by
      intro a b hab
      dsimp at hab
      omega⟩
    have hset : (range C).map e = Ioc (t + s * C) (t + (s + 1) * C) := by
      ext k
      simp only [mem_map, mem_range, mem_Ioc]
      constructor
      · rintro ⟨n, hn, rfl⟩
        dsimp [e]
        have hend : t + s * C + C = t + (s + 1) * C := by
          simp only [Nat.succ_mul]
          omega
        omega
      · intro hk
        refine ⟨k - (t + s * C) - 1, ?_, ?_⟩
        · have hend : t + s * C + C = t + (s + 1) * C := by
            simp only [Nat.succ_mul]
            omega
          omega
        · dsimp [e]
          omega
    rw [← hset, sum_map]
    rfl
  rw [Finset.sum_congr rfl (fun s hs => by rw [hblock s])]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_sigma']
  let S := Finset.sigma (range Q) (fun _ => range C)
  let F : (Sigma fun _ : ℕ => ℕ) → ℝ := fun sn =>
    x ^ (sn.1 * C) * f (t + sn.1 * C + sn.2 + 1)
  let G : ℕ → ℝ := fun k => x ^ ((k - t - 1) / C * C) * f k
  change (∑ sn ∈ S, F sn) = ∑ k ∈ Ioc t (t + Q * C), G k
  refine Finset.sum_nbij'
    (fun sn : (Sigma fun _ : ℕ => ℕ) => t + sn.1 * C + sn.2 + 1)
    (fun k : ℕ => Sigma.mk ((k - t - 1) / C) ((k - t - 1) % C)) ?_ ?_ ?_ ?_ ?_
  · rintro ⟨s, n⟩ hs
    dsimp
    have hs' : s < Q ∧ n < C := by simpa [S] using hs
    have hsnext : (s + 1) * C ≤ Q * C :=
      Nat.mul_le_mul_right C (Nat.succ_le_iff.mpr hs'.1)
    have hwithin : s * C + n + 1 ≤ (s + 1) * C := by
      simp only [Nat.succ_mul]
      omega
    have hupper : t + s * C + n + 1 ≤ t + Q * C := by
      simpa only [Nat.add_assoc] using Nat.add_le_add_left (hwithin.trans hsnext) t
    exact Finset.mem_Ioc.mpr ⟨by omega, hupper⟩
  · intro k hk
    have hk' : t < k ∧ k ≤ t + Q * C := Finset.mem_Ioc.mp hk
    have ha : k - t - 1 < Q * C := by omega
    have hq : (k - t - 1) / C < Q :=
      (Nat.div_lt_iff_lt_mul hC).mpr (by simpa [Nat.mul_comm] using ha)
    simpa [S] using And.intro hq (Nat.mod_lt _ hC)
  · rintro ⟨s, n⟩ hs
    dsimp
    have hs' : s < Q ∧ n < C := by simpa [S] using hs
    have hsub : t + s * C + n + 1 - t - 1 = s * C + n := by omega
    have hdiv : (s * C + n) / C = s := by
      rw [Nat.mul_comm s C, Nat.add_comm (C * s) n, Nat.add_mul_div_left n s hC,
        Nat.div_eq_of_lt hs'.2]
      simp
    have hmod : (s * C + n) % C = n := by
      rw [Nat.mul_comm s C, Nat.add_comm (C * s) n, Nat.add_mul_mod_self_left,
        Nat.mod_eq_of_lt hs'.2]
    change Sigma.mk ((t + s * C + n + 1 - t - 1) / C)
        ((t + s * C + n + 1 - t - 1) % C) =
          (⟨s, n⟩ : Sigma fun _ : ℕ => ℕ)
    rw [hsub, hdiv, hmod]
  · intro k hk
    dsimp
    have hk' : t < k ∧ k ≤ t + Q * C := Finset.mem_Ioc.mp hk
    have ha : k - t - 1 < Q * C := by omega
    have hsplit : (k - t - 1) % C + C * ((k - t - 1) / C) = k - t - 1 :=
      Nat.mod_add_div _ C
    have hsplit' : (k - t - 1) / C * C + (k - t - 1) % C = k - t - 1 := by
      simpa [Nat.add_comm, Nat.mul_comm] using hsplit
    change t + ((k - t - 1) / C) * C + (k - t - 1) % C + 1 = k
    omega
  · rintro ⟨s, n⟩ hs
    dsimp
    have hs' : s < Q ∧ n < C := by simpa [S] using hs
    change F ⟨s, n⟩ = G (t + s * C + n + 1)
    dsimp [F, G]
    congr 2
    have hsub : t + s * C + n + 1 - t - 1 = s * C + n := by omega
    rw [hsub, Nat.mul_comm s C, Nat.add_comm (C * s) n, Nat.add_mul_div_left n s hC,
      Nat.div_eq_of_lt hs'.2]
    simp
    rw [Nat.mul_comm]

namespace DeletionResidueMartingale

/-- The literal truncated divisor field repeats after the terminal EDQ clock. -/
theorem truncMoebiusDivisorSum_add_clock (N k : ℕ) :
    truncMoebiusDivisorSum N (k + clock N) = truncMoebiusDivisorSum N k := by
  classical
  unfold truncMoebiusDivisorSum
  have hfilter : Finset.filter (fun d => d ∣ k + clock N) (Icc 1 N) =
      Finset.filter (fun d => d ∣ k) (Icc 1 N) := by
    ext d
    simp only [mem_filter, mem_Icc]
    constructor
    · rintro ⟨hd, hdk⟩
      exact ⟨hd, (Nat.dvd_add_iff_left (dvd_clock hd.1 hd.2)).mpr hdk⟩
    · rintro ⟨hd, hdk⟩
      exact ⟨hd, dvd_add hdk (dvd_clock hd.1 hd.2)⟩
  rw [hfilter]

/-- A literal interval of one terminal clock contains exactly `clock N / d` multiples of each
processed divisor. -/
theorem card_dvd_selected_terminalClock_interval (N d t : ℕ) (hd : d ∈ Icc 1 N) :
    #{k ∈ Ioc t (t + clock N) | d ∣ k} = clock N / d := by
  rw [Sieve.card_filter_dvd_Ioc d t (t + clock N) (by omega)]
  rw [Nat.add_div_of_dvd_left (dvd_clock (mem_Icc.mp hd).1 (mem_Icc.mp hd).2)]
  exact Nat.add_sub_cancel_left _ _

/-- Exact signed total of the raw truncated divisor field over its literal terminal clock. -/
theorem truncatedDivisorSum_terminalClock_eq_harmonic (N t : ℕ) :
    ∑ k ∈ Ioc t (t + clock N), truncMoebiusDivisorSum N k =
      (clock N : ℝ) * ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ) := by
  classical
  unfold truncMoebiusDivisorSum
  calc
    ∑ k ∈ Ioc t (t + clock N),
        ∑ d ∈ Finset.filter (fun d => d ∣ k) (Icc 1 N), ((moebius d : ℤ) : ℝ) =
      ∑ d ∈ Icc 1 N,
        ∑ k ∈ Finset.filter (fun k => d ∣ k) (Ioc t (t + clock N)),
          ((moebius d : ℤ) : ℝ) := by
        refine Finset.sum_comm' ?_
        intro k d
        simp only [mem_Ioc, mem_filter, mem_Icc]
        tauto
    _ = ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) * ((clock N / d : ℕ) : ℝ) := by
      refine Finset.sum_congr rfl fun d hd => ?_
      rw [Finset.sum_const, nsmul_eq_mul, card_dvd_selected_terminalClock_interval N d t hd]
      ring
    _ = (clock N : ℝ) * ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      rw [Nat.cast_div (dvd_clock (mem_Icc.mp hd).1 (mem_Icc.mp hd).2)]
      · ring
      · exact_mod_cast (Nat.ne_of_gt (mem_Icc.mp hd).1)

/-- The complete selected EDQ child family has zero signed raw deviation at the literal terminal
clock.  This is an exact chronological cancellation: its `Q` adjacent child windows concatenate
to one `clock N` interval, and every retained divisor divides that terminal clock. -/
theorem selectedRefinementBlock_truncatedDivisorDeviation_sum_eq_zero
    (N l u b : ℕ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range Q,
      ((C : ℝ) * ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k) = 0 := by
  dsimp
  have hsuccN : l + 1 ≤ N := Nat.succ_le_iff.mpr hlN
  have hspan : canonicalClockRatio N (l + 1) * clock (l + 1) = clock N := by
    rw [canonicalClockRatio_eq_div_of_le N (l + 1) hsuccN]
    exact Nat.div_mul_cancel (clock_dvd hsuccN)
  have hspanR :
      (canonicalClockRatio N (l + 1) : ℝ) * (clock (l + 1) : ℝ) = (clock N : ℝ) := by
    exact_mod_cast hspan
  have hconcat :
      (∑ s ∈ range (canonicalClockRatio N (l + 1)),
        ∑ k ∈ Ioc (u + b * clock l + 1 + s * clock (l + 1))
          (u + b * clock l + 1 + (s + 1) * clock (l + 1)),
          truncMoebiusDivisorSum N k) =
      ∑ k ∈ Ioc (u + b * clock l + 1)
        (u + b * clock l + 1 + canonicalClockRatio N (l + 1) * clock (l + 1)),
          truncMoebiusDivisorSum N k := by
    simpa using beta_weighted_consecutive_windows_eq_weighted_Ioc
      (fun k => truncMoebiusDivisorSum N k) (1 : ℝ)
      (u + b * clock l + 1) (canonicalClockRatio N (l + 1)) (clock (l + 1))
      (clock_pos (l + 1))
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
    hconcat, hspan, truncatedDivisorSum_terminalClock_eq_harmonic]
  linear_combination (∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ)) * hspanR

/-- Exact finite Abel decomposition in the orientation used by a beta-weighted EDQ block. -/
private theorem sum_range_mul_eq_prefix_last_add_sum_prefix_mul_sub
    (d w : ℕ → ℝ) (N : ℕ) :
    ∑ j ∈ range (N + 1), d j * w j =
      (∑ i ∈ range (N + 1), d i) * w N +
        ∑ j ∈ range N,
          (∑ i ∈ range (j + 1), d i) * (w j - w (j + 1)) := by
  induction N with
  | zero => simp
  | succ N ih =>
      rw [Finset.sum_range_succ, ih]
      simp only [Finset.sum_range_succ]
      ring

/-- A zero-total finite sequence has an exact beta discrete-difference factorization through
its chronological prefix sums. -/
theorem sum_range_beta_eq_one_sub_mul_prefix
    (d : ℕ → ℝ) (N : ℕ) (y : ℝ) (hzero : ∑ j ∈ range (N + 1), d j = 0) :
    ∑ j ∈ range (N + 1), d j * y ^ j =
      (1 - y) * ∑ j ∈ range N, (∑ i ∈ range (j + 1), d i) * y ^ j := by
  rw [sum_range_mul_eq_prefix_last_add_sum_prefix_mul_sub, hzero, zero_mul, zero_add,
    Finset.mul_sum]
  refine Finset.sum_congr rfl fun j hj => ?_
  rw [pow_succ]
  ring

/-- Denominator-safe form of the finite beta factorization.  No cancellation is performed:
the zero-total beta numerator times its complete geometric companion equals its prefix cofactor
times `1 - y^(N + 1)`. -/
theorem sum_range_beta_mul_geometric_eq_prefix_mul_one_sub_pow
    (d : ℕ → ℝ) (N : ℕ) (y : ℝ) (hzero : ∑ j ∈ range (N + 1), d j = 0) :
    (∑ j ∈ range (N + 1), d j * y ^ j) * (∑ j ∈ range (N + 1), y ^ j) =
      (∑ j ∈ range N, (∑ i ∈ range (j + 1), d i) * y ^ j) * (1 - y ^ (N + 1)) := by
  rw [sum_range_beta_eq_one_sub_mul_prefix d N y hzero]
  have hgeom : (1 - y) * (∑ j ∈ range (N + 1), y ^ j) = 1 - y ^ (N + 1) := by
    linear_combination -mul_geom_sum y (N + 1)
  calc
    ((1 - y) * ∑ j ∈ range N, (∑ i ∈ range (j + 1), d i) * y ^ j) *
        (∑ j ∈ range (N + 1), y ^ j) =
      (∑ j ∈ range N, (∑ i ∈ range (j + 1), d i) * y ^ j) *
        ((1 - y) * ∑ j ∈ range (N + 1), y ^ j) := by ring
    _ = (∑ j ∈ range N, (∑ i ∈ range (j + 1), d i) * y ^ j) *
        (1 - y ^ (N + 1)) := by rw [hgeom]

/-- Exact discrete-difference factorization of the complete selected EDQ block.  Its factor
`1 - y` is forced by the terminal-clock zero law and its cofactor retains every chronological
prefix of the signed selected windows. -/
theorem selectedRefinementBlock_weightedDeviation_eq_discreteDifference
    (N l u b : ℕ) (y : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    let d : ℕ → ℝ := fun s =>
      (C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k
    ∑ s ∈ range Q, d s * y ^ s =
      (1 - y) * ∑ s ∈ range (Q - 1), (∑ i ∈ range (s + 1), d i) * y ^ s := by
  dsimp
  let d : ℕ → ℝ := fun s =>
    (clock (l + 1) : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
      ∑ k ∈ Ioc (u + b * clock l + 1 + s * clock (l + 1))
        (u + b * clock l + 1 + (s + 1) * clock (l + 1)), truncMoebiusDivisorSum N k
  have hzero : ∑ s ∈ range (canonicalClockRatio N (l + 1)), d s = 0 := by
    simpa [d] using selectedRefinementBlock_truncatedDivisorDeviation_sum_eq_zero N l u b hlN
  have hQpos : 0 < canonicalClockRatio N (l + 1) :=
    lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hQeq : canonicalClockRatio N (l + 1) - 1 + 1 = canonicalClockRatio N (l + 1) :=
    Nat.sub_add_cancel (Nat.succ_le_iff.mpr hQpos)
  have hbase := sum_range_beta_eq_one_sub_mul_prefix d
    (canonicalClockRatio N (l + 1) - 1) y (by simpa [hQeq] using hzero)
  simpa [d, hQeq] using hbase

/-- Denominator-safe selected-block identity.  The selected beta numerator and its complete
geometric companion are related by a polynomial identity, including at `y = 1`; no division by
a vanishing factor is used. -/
theorem selectedRefinementBlock_weightedDeviation_mul_geometric_eq_prefix
    (N l u b : ℕ) (y : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    let d : ℕ → ℝ := fun s =>
      (C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k
    (∑ s ∈ range Q, d s * y ^ s) * (∑ s ∈ range Q, y ^ s) =
      (∑ s ∈ range (Q - 1), (∑ i ∈ range (s + 1), d i) * y ^ s) * (1 - y ^ Q) := by
  dsimp
  rw [selectedRefinementBlock_weightedDeviation_eq_discreteDifference N l u b y hlN]
  have hgeom :
      (1 - y) * ∑ s ∈ range (canonicalClockRatio N (l + 1)), y ^ s =
        1 - y ^ canonicalClockRatio N (l + 1) := by
    linear_combination -mul_geom_sum y (canonicalClockRatio N (l + 1))
  linear_combination
    (∑ s ∈ range (canonicalClockRatio N (l + 1) - 1),
      (∑ i ∈ range (s + 1),
        ((clock (l + 1) : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
          ∑ k ∈ Ioc (u + b * clock l + 1 + i * clock (l + 1))
            (u + b * clock l + 1 + (i + 1) * clock (l + 1)),
            truncMoebiusDivisorSum N k)) * y ^ s) * hgeom

/-- The denominator-safe factorization in the literal EDQ beta variable `x`: every exponent is
the actual child-clock exponent `s * clock (l + 1)`, and the terminal exponent is `Q * C`. -/
theorem selectedRefinementBlock_betaDeviation_mul_geometric_eq_prefix
    (N l u b : ℕ) (x : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    let d : ℕ → ℝ := fun s =>
      (C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k
    (∑ s ∈ range Q, d s * x ^ (s * C)) * (∑ s ∈ range Q, x ^ (s * C)) =
      (∑ s ∈ range (Q - 1), (∑ i ∈ range (s + 1), d i) * x ^ (s * C)) *
        (1 - x ^ (Q * C)) := by
  dsimp
  have hpow : ∀ s : ℕ,
      x ^ (s * clock (l + 1)) = (x ^ clock (l + 1)) ^ s := by
    intro s
    simpa [Nat.mul_comm] using (pow_mul x (clock (l + 1)) s)
  simp_rw [hpow]
  exact selectedRefinementBlock_weightedDeviation_mul_geometric_eq_prefix N l u b
    (x ^ clock (l + 1)) hlN

/-- Every chronological prefix in the selected-block cofactor is one literal initial physical
interval.  This retains the harmonic term and the truncated divisor field together, before any
correlation expansion. -/
theorem selectedRefinementBlock_truncatedDivisorDeviation_prefix_eq
    (N l u b s : ℕ) :
    let t := u + b * clock l + 1
    let C := clock (l + 1)
    ∑ i ∈ range (s + 1),
      ((C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + i * C) (t + (i + 1) * C), truncMoebiusDivisorSum N k) =
      ((s + 1 : ℕ) : ℝ) * (C : ℝ) *
        ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
      ∑ k ∈ Ioc t (t + (s + 1) * C), truncMoebiusDivisorSum N k := by
  dsimp
  have hconcat :
      (∑ i ∈ range (s + 1),
        ∑ k ∈ Ioc (u + b * clock l + 1 + i * clock (l + 1))
          (u + b * clock l + 1 + (i + 1) * clock (l + 1)),
          truncMoebiusDivisorSum N k) =
      ∑ k ∈ Ioc (u + b * clock l + 1)
        (u + b * clock l + 1 + (s + 1) * clock (l + 1)),
          truncMoebiusDivisorSum N k := by
    simpa using beta_weighted_consecutive_windows_eq_weighted_Ioc
      (fun k => truncMoebiusDivisorSum N k) (1 : ℝ)
      (u + b * clock l + 1) (s + 1) (clock (l + 1)) (clock_pos (l + 1))
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul, hconcat]
  ring

/-- Exact signed divisor-incidence expansion of one literal physical window of the truncated
Möbius field. -/
theorem truncatedDivisorWindow_eq_divisorCounts (N t L : ℕ) :
    ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k =
      ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) *
        ((#{k ∈ Ioc t (t + L) | d ∣ k} : ℕ) : ℝ) := by
  classical
  unfold truncMoebiusDivisorSum
  calc
    ∑ k ∈ Ioc t (t + L),
        ∑ d ∈ Finset.filter (fun d => d ∣ k) (Icc 1 N), ((moebius d : ℤ) : ℝ) =
      ∑ d ∈ Icc 1 N,
        ∑ k ∈ Finset.filter (fun k => d ∣ k) (Ioc t (t + L)),
          ((moebius d : ℤ) : ℝ) := by
        refine Finset.sum_comm' ?_
        intro k d
        simp only [mem_Ioc, mem_filter, mem_Icc]
        tauto
    _ = ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) *
        ((#{k ∈ Ioc t (t + L) | d ∣ k} : ℕ) : ℝ) := by
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [Finset.sum_const, nsmul_eq_mul]
      ring

/-- A window whose length is divisible by `d` contains exactly its quotient number of `d`-multiples,
with its literal starting point retained. -/
theorem card_dvd_Ioc_length_eq_div (d t C : ℕ) (hdC : d ∣ C) :
    #{k ∈ Ioc t (t + C) | d ∣ k} = C / d := by
  rw [Sieve.card_filter_dvd_Ioc d t (t + C) (by omega)]
  rw [Nat.add_div_of_dvd_left hdC]
  exact Nat.add_sub_cancel_left _ _

/-- The literal signed discrepancy of one divisor in one physical window. -/
def divisorWindowDiscrepancy (d t C : ℕ) : ℝ :=
  (C : ℝ) / (d : ℝ) - ((#{k ∈ Ioc t (t + C) | d ∣ k} : ℕ) : ℝ)

/-- Exact Euler-deletion law for one raw window: every divisor that divides its child clock
cancels identically; only non-clock divisors retain a signed discrepancy. -/
theorem truncatedDivisorWindowDeviation_eq_nonclockDiscrepancy (N t C : ℕ) :
    (C : ℝ) * ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ) -
      ∑ k ∈ Ioc t (t + C), truncMoebiusDivisorSum N k =
      ∑ d ∈ Finset.filter (fun d => ¬ d ∣ C) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) * divisorWindowDiscrepancy d t C := by
  classical
  simp only [divisorWindowDiscrepancy]
  have hbase :
      (C : ℝ) * ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) / (d : ℝ) -
        ∑ k ∈ Ioc t (t + C), truncMoebiusDivisorSum N k =
      ∑ d ∈ Icc 1 N, ((moebius d : ℤ) : ℝ) *
        ((C : ℝ) / (d : ℝ) - ((#{k ∈ Ioc t (t + C) | d ∣ k} : ℕ) : ℝ)) := by
    rw [truncatedDivisorWindow_eq_divisorCounts, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun d hd => ?_
    ring
  rw [hbase, Finset.sum_filter]
  refine Finset.sum_congr rfl fun d hd => ?_
  by_cases hdC : d ∣ C
  · have hd1 : 1 ≤ d := (mem_Icc.mp hd).1
    rw [if_neg (by exact fun hnot => hnot hdC), card_dvd_Ioc_length_eq_div d t C hdC,
      Nat.cast_div hdC (by exact_mod_cast Nat.ne_of_gt hd1)]
    ring
  · simp [hdC]

/-- Exact selected-beta decomposition into the literal non-clock divisor discrepancies.  All
surviving future divisors and all beta times remain in the same signed finite sum. -/
theorem selectedRefinementBlock_betaDeviation_eq_nonclockDivisorBeta
    (N l u b : ℕ) (x : ℝ) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range Q, x ^ (s * C) *
      ((C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k) =
      ∑ d ∈ Finset.filter (fun d => ¬ d ∣ C) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) *
          ∑ s ∈ range Q, x ^ (s * C) * divisorWindowDiscrepancy d (t + s * C) C := by
  dsimp
  calc
    ∑ s ∈ range (canonicalClockRatio N (l + 1)), x ^ (s * clock (l + 1)) *
        ((clock (l + 1) : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
          ∑ k ∈ Ioc (u + b * clock l + 1 + s * clock (l + 1))
            (u + b * clock l + 1 + (s + 1) * clock (l + 1)),
            truncMoebiusDivisorSum N k) =
      ∑ s ∈ range (canonicalClockRatio N (l + 1)), x ^ (s * clock (l + 1)) *
        ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) * divisorWindowDiscrepancy d
            (u + b * clock l + 1 + s * clock (l + 1)) (clock (l + 1)) := by
        refine Finset.sum_congr rfl fun s hs => ?_
        apply congrArg (fun z : ℝ => x ^ (s * clock (l + 1)) * z)
        simpa [Nat.succ_mul, Nat.add_assoc] using
          truncatedDivisorWindowDeviation_eq_nonclockDiscrepancy N
            (u + b * clock l + 1 + s * clock (l + 1)) (clock (l + 1))
    _ = ∑ s ∈ range (canonicalClockRatio N (l + 1)),
        ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
          x ^ (s * clock (l + 1)) *
            (((moebius d : ℤ) : ℝ) * divisorWindowDiscrepancy d
              (u + b * clock l + 1 + s * clock (l + 1)) (clock (l + 1))) := by
      refine Finset.sum_congr rfl fun s hs => ?_
      rw [Finset.mul_sum]
    _ = ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
        ∑ s ∈ range (canonicalClockRatio N (l + 1)),
          x ^ (s * clock (l + 1)) *
            (((moebius d : ℤ) : ℝ) * divisorWindowDiscrepancy d
              (u + b * clock l + 1 + s * clock (l + 1)) (clock (l + 1))) := by
      rw [Finset.sum_comm]
    _ = ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) *
          ∑ s ∈ range (canonicalClockRatio N (l + 1)), x ^ (s * clock (l + 1)) *
            divisorWindowDiscrepancy d (u + b * clock l + 1 + s * clock (l + 1))
              (clock (l + 1)) := by
      refine Finset.sum_congr rfl fun d hd => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun s hs => ?_
      ring

/-- Exact signed bilinear form of the selected beta numerator.  This is the remaining
multi-divisor EDQ object: both divisor indices are non-clock and retain their joint beta-time
discrepancies. -/
theorem selectedRefinementBlock_betaDeviation_sq_eq_nonclockDivisorBilinear
    (N l u b : ℕ) (x : ℝ) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    (∑ s ∈ range Q, x ^ (s * C) *
      ((C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k)) ^ 2 =
      ∑ d ∈ Finset.filter (fun d => ¬ d ∣ C) (Icc 1 N),
        ∑ e ∈ Finset.filter (fun e => ¬ e ∣ C) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
            (∑ s ∈ range Q, x ^ (s * C) * divisorWindowDiscrepancy d (t + s * C) C) *
            (∑ r ∈ range Q, x ^ (r * C) * divisorWindowDiscrepancy e (t + r * C) C) := by
  dsimp
  rw [pow_two, selectedRefinementBlock_betaDeviation_eq_nonclockDivisorBeta,
    Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  refine Finset.sum_congr rfl fun e he => ?_
  ring

/-- A surviving non-clock divisor in a selected child discrepancy is strictly beyond the history
cutoff.  Earlier divisors divide the child clock and have already cancelled exactly. -/
theorem nonclockDivisor_gt_historyCutoff
    (l N d : ℕ) (hd : d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N)) :
    l + 1 < d := by
  rcases Finset.mem_filter.mp hd with ⟨hdIcc, hnot⟩
  by_contra hle
  exact hnot (dvd_clock (m := d) (n := l + 1) (Finset.mem_Icc.mp hdIcc).1 (by omega))

/-- Exact concatenation of the divisor counts in consecutive physical windows. -/
theorem consecutive_dvd_counts_eq (d t Q C : ℕ) (hC : 0 < C) :
    ∑ s ∈ range Q,
      ((#{k ∈ Ioc (t + s * C) (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ) =
      ((#{k ∈ Ioc t (t + Q * C) | d ∣ k} : ℕ) : ℝ) := by
  let f : ℕ → ℝ := fun k => if d ∣ k then 1 else 0
  have hcount (a b : ℕ) :
      ((#{k ∈ Ioc a b | d ∣ k} : ℕ) : ℝ) = ∑ k ∈ Ioc a b, f k := by
    dsimp [f]
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    ring
  calc
    ∑ s ∈ range Q,
        ((#{k ∈ Ioc (t + s * C) (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ) =
      ∑ s ∈ range Q, ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), f k := by
        refine Finset.sum_congr rfl fun s hs => ?_
        rw [← hcount]
    _ = ∑ k ∈ Ioc t (t + Q * C), f k := by
      simpa only [one_pow, one_mul] using
        beta_weighted_consecutive_windows_eq_weighted_Ioc f (1 : ℝ) t Q C hC
    _ = ((#{k ∈ Ioc t (t + Q * C) | d ∣ k} : ℕ) : ℝ) := by
      rw [hcount]

/-- Every single processed divisor has zero total discrepancy across the complete selected
child clock.  This is stronger than cancellation only after summing Möbius signs. -/
theorem selectedRefinementBlock_divisorDiscrepancy_sum_eq_zero
    (N l u b d : ℕ) (hd : d ∈ Icc 1 N) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range Q,
      ((C : ℝ) / (d : ℝ) -
        ((#{k ∈ Ioc (t + s * C) (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ)) = 0 := by
  dsimp
  have hsuccN : l + 1 ≤ N := Nat.succ_le_iff.mpr hlN
  have hspan : canonicalClockRatio N (l + 1) * clock (l + 1) = clock N := by
    rw [canonicalClockRatio_eq_div_of_le N (l + 1) hsuccN]
    exact Nat.div_mul_cancel (clock_dvd hsuccN)
  have hspanR :
      (canonicalClockRatio N (l + 1) : ℝ) * (clock (l + 1) : ℝ) = (clock N : ℝ) := by
    exact_mod_cast hspan
  have hPdiv : d ∣ clock N := dvd_clock (Finset.mem_Icc.mp hd).1 (Finset.mem_Icc.mp hd).2
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
    consecutive_dvd_counts_eq d (u + b * clock l + 1)
      (canonicalClockRatio N (l + 1)) (clock (l + 1)) (clock_pos (l + 1)),
    hspan, card_dvd_Ioc_length_eq_div d (u + b * clock l + 1) (clock N) hPdiv,
    Nat.cast_div hPdiv (by exact_mod_cast Nat.ne_of_gt (Finset.mem_Icc.mp hd).1)]
  linear_combination (d : ℝ)⁻¹ * hspanR

/-- Each processed divisor has its own exact beta discrete-difference factorization across the
complete selected clock.  The terminal cancellation is therefore componentwise, before the
Möbius-weighted future-divisor sum is formed. -/
theorem selectedRefinementBlock_divisorDiscrepancy_beta_eq_discreteDifference
    (N l u b d : ℕ) (x : ℝ) (hd : d ∈ Icc 1 N) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range Q, divisorWindowDiscrepancy d (t + s * C) C * x ^ (s * C) =
      (1 - x ^ C) * ∑ s ∈ range (Q - 1),
        (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d (t + i * C) C) * x ^ (s * C) := by
  dsimp
  let a : ℕ → ℝ := fun s =>
    divisorWindowDiscrepancy d (u + b * clock l + 1 + s * clock (l + 1)) (clock (l + 1))
  have hzero : ∑ s ∈ range (canonicalClockRatio N (l + 1)), a s = 0 := by
    simpa [a, divisorWindowDiscrepancy, Nat.succ_mul, Nat.add_assoc] using
      selectedRefinementBlock_divisorDiscrepancy_sum_eq_zero N l u b d hd hlN
  have hQpos : 0 < canonicalClockRatio N (l + 1) :=
    lt_of_lt_of_le Nat.zero_lt_one (le_max_left _ _)
  have hQeq : canonicalClockRatio N (l + 1) - 1 + 1 = canonicalClockRatio N (l + 1) :=
    Nat.sub_add_cancel (Nat.succ_le_iff.mpr hQpos)
  have hbase := sum_range_beta_eq_one_sub_mul_prefix a
    (canonicalClockRatio N (l + 1) - 1) (x ^ clock (l + 1))
      (by simpa [hQeq] using hzero)
  have hpow : ∀ s : ℕ,
      x ^ (s * clock (l + 1)) = (x ^ clock (l + 1)) ^ s := by
    intro s
    simpa [Nat.mul_comm] using (pow_mul x (clock (l + 1)) s)
  simp_rw [hpow]
  simpa [a, hQeq] using hbase

/-- The chronological prefix of one divisor discrepancy is one literal interval discrepancy.
This is the componentwise physical cofactor retained in the future-divisor bilinear form. -/
theorem divisorWindowDiscrepancy_prefix_eq_intervalDiscrepancy
    (d t C s : ℕ) (hC : 0 < C) :
    ∑ i ∈ range (s + 1), divisorWindowDiscrepancy d (t + i * C) C =
      (((s + 1 : ℕ) : ℝ) * (C : ℝ) / (d : ℝ) -
        ((#{k ∈ Ioc t (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ)) := by
  unfold divisorWindowDiscrepancy
  have hcounts :
      ∑ i ∈ range (s + 1),
        ((#{k ∈ Ioc (t + i * C) (t + i * C + C) | d ∣ k} : ℕ) : ℝ) =
        ((#{k ∈ Ioc t (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ) := by
    simpa [Nat.succ_mul, Nat.add_assoc] using consecutive_dvd_counts_eq d t (s + 1) C hC
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul, hcounts]
  ring

/-- The exact beta cofactor of a single future divisor is a beta-weighted sequence of its literal
interval discrepancies.  No inner chronological sum remains. -/
theorem selectedRefinementBlock_divisorBetaPrefix_eq_intervalDiscrepancy
    (N l u b d : ℕ) (x : ℝ) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range (Q - 1),
      (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d (t + i * C) C) * x ^ (s * C) =
      ∑ s ∈ range (Q - 1),
        (((s + 1 : ℕ) : ℝ) * (C : ℝ) / (d : ℝ) -
          ((#{k ∈ Ioc t (t + (s + 1) * C) | d ∣ k} : ℕ) : ℝ)) * x ^ (s * C) := by
  dsimp
  refine Finset.sum_congr rfl fun s hs => ?_
  rw [divisorWindowDiscrepancy_prefix_eq_intervalDiscrepancy d
    (u + b * clock l + 1) (clock (l + 1)) s (clock_pos (l + 1))]

/-- The complete selected beta deviation has the child-clock factor already at the level of the
signed future-divisor sum.  Its cofactor retains every divisor, every prefix, and every beta
time; no termwise estimate or cancellation of a denominator is used. -/
theorem selectedRefinementBlock_betaDeviation_eq_childClockFactor_futurePrefix
    (N l u b : ℕ) (x : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    ∑ s ∈ range Q, x ^ (s * C) *
      ((C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k) =
      (1 - x ^ C) *
        ∑ d ∈ Finset.filter (fun d => ¬ d ∣ C) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) *
            ∑ s ∈ range (Q - 1),
              (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d (t + i * C) C) * x ^ (s * C) := by
  dsimp
  calc
    ∑ s ∈ range (canonicalClockRatio N (l + 1)), x ^ (s * clock (l + 1)) *
        ((clock (l + 1) : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
          ∑ k ∈ Ioc (u + b * clock l + 1 + s * clock (l + 1))
            (u + b * clock l + 1 + (s + 1) * clock (l + 1)),
            truncMoebiusDivisorSum N k) =
      ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) *
          ∑ s ∈ range (canonicalClockRatio N (l + 1)), x ^ (s * clock (l + 1)) *
            divisorWindowDiscrepancy d (u + b * clock l + 1 + s * clock (l + 1))
              (clock (l + 1)) :=
      selectedRefinementBlock_betaDeviation_eq_nonclockDivisorBeta N l u b x
    _ = ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) *
          ∑ s ∈ range (canonicalClockRatio N (l + 1)),
            divisorWindowDiscrepancy d (u + b * clock l + 1 + s * clock (l + 1))
              (clock (l + 1)) * x ^ (s * clock (l + 1)) := by
      refine Finset.sum_congr rfl fun d hd => ?_
      apply congrArg (fun z : ℝ => ((moebius d : ℤ) : ℝ) * z)
      refine Finset.sum_congr rfl fun s hs => ?_
      ring
    _ = ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
        ((moebius d : ℤ) : ℝ) *
          ((1 - x ^ clock (l + 1)) *
            ∑ s ∈ range (canonicalClockRatio N (l + 1) - 1),
              (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d
                (u + b * clock l + 1 + i * clock (l + 1)) (clock (l + 1))) *
                x ^ (s * clock (l + 1))) := by
      refine Finset.sum_congr rfl fun d hd => ?_
      rw [selectedRefinementBlock_divisorDiscrepancy_beta_eq_discreteDifference N l u b d x
        (Finset.mem_filter.mp hd).1 hlN]
    _ = (1 - x ^ clock (l + 1)) *
        ∑ d ∈ Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N),
          ((moebius d : ℤ) : ℝ) *
            ∑ s ∈ range (canonicalClockRatio N (l + 1) - 1),
              (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d
                (u + b * clock l + 1 + i * clock (l + 1)) (clock (l + 1))) *
                x ^ (s * clock (l + 1)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      ring

/-- Exact signed energy factorization of the selected EDQ beta deviation.  The square retains a
joint finite bilinear future-divisor cofactor, multiplied by the forced child-clock factor
`(1 - x^C)^2`. -/
theorem selectedRefinementBlock_betaDeviation_sq_eq_childClockFactor_futureBilinear
    (N l u b : ℕ) (x : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    let S := Finset.filter (fun d => ¬ d ∣ C) (Icc 1 N)
    let P : ℕ → ℝ := fun d =>
      ∑ s ∈ range (Q - 1),
        (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d (t + i * C) C) * x ^ (s * C)
    (∑ s ∈ range Q, x ^ (s * C) *
      ((C : ℝ) * ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ) -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k)) ^ 2 =
      (1 - x ^ C) ^ 2 *
        ∑ d ∈ S, ∑ e ∈ S,
          ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) * P d * P e := by
  dsimp
  rw [pow_two, selectedRefinementBlock_betaDeviation_eq_childClockFactor_futurePrefix N l u b x hlN]
  let a : ℝ := 1 - x ^ clock (l + 1)
  let S := Finset.filter (fun d => ¬ d ∣ clock (l + 1)) (Icc 1 N)
  let P : ℕ → ℝ := fun d =>
    ∑ s ∈ range (canonicalClockRatio N (l + 1) - 1),
      (∑ i ∈ range (s + 1), divisorWindowDiscrepancy d
        (u + b * clock l + 1 + i * clock (l + 1)) (clock (l + 1))) *
        x ^ (s * clock (l + 1))
  change
    (a * ∑ d ∈ S, ((moebius d : ℤ) : ℝ) * P d) *
        (a * ∑ d ∈ S, ((moebius d : ℤ) : ℝ) * P d) =
      a ^ 2 * ∑ d ∈ S, ∑ e ∈ S,
        ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) * P d * P e
  calc
    (a * ∑ d ∈ S, ((moebius d : ℤ) : ℝ) * P d) *
        (a * ∑ d ∈ S, ((moebius d : ℤ) : ℝ) * P d) =
      a ^ 2 *
        ((∑ d ∈ S, ((moebius d : ℤ) : ℝ) * P d) *
          ∑ e ∈ S, ((moebius e : ℤ) : ℝ) * P e) := by ring
    _ = a ^ 2 * ∑ d ∈ S, ∑ e ∈ S,
        (((moebius d : ℤ) : ℝ) * P d) * (((moebius e : ℤ) : ℝ) * P e) := by
      rw [Finset.sum_mul_sum]
    _ = a ^ 2 * ∑ d ∈ S, ∑ e ∈ S,
        ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) * P d * P e := by
      apply congrArg (fun z : ℝ => a ^ 2 * z)
      refine Finset.sum_congr rfl fun d hd => ?_
      refine Finset.sum_congr rfl fun e he => ?_
      ring

/-- Fully physical selected-block factorization.  The cofactor is a beta-weighted sum of literal
initial intervals of the signed truncated divisor field, and its terminal factor remains
`1 - x^(Q * C)`. -/
theorem selectedRefinementBlock_betaDeviation_mul_geometric_eq_physicalPrefix
    (N l u b : ℕ) (x : ℝ) (hlN : l < N) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    let H := ∑ q ∈ Icc 1 N, ((moebius q : ℤ) : ℝ) / (q : ℝ)
    let d : ℕ → ℝ := fun s =>
      (C : ℝ) * H -
        ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k
    (∑ s ∈ range Q, d s * x ^ (s * C)) * (∑ s ∈ range Q, x ^ (s * C)) =
      (∑ s ∈ range (Q - 1),
        (((s + 1 : ℕ) : ℝ) * (C : ℝ) * H -
          ∑ k ∈ Ioc t (t + (s + 1) * C), truncMoebiusDivisorSum N k) * x ^ (s * C)) *
        (1 - x ^ (Q * C)) := by
  dsimp
  rw [selectedRefinementBlock_betaDeviation_mul_geometric_eq_prefix N l u b x hlN]
  apply congrArg (fun z : ℝ => z * (1 - x ^
    (canonicalClockRatio N (l + 1) * clock (l + 1))))
  apply Finset.sum_congr rfl
  intro s hs
  apply congrArg (fun z : ℝ => z * x ^ (s * clock (l + 1)))
  exact selectedRefinementBlock_truncatedDivisorDeviation_prefix_eq N l u b s

/-- The chronological endpoint of one selected child window is exactly the endpoint occurring in
the EDQ refinement kernel. -/
theorem selectedRefinementBlock_truncatedDivisorWindow_end (l u b s : ℕ) :
    u + b * clock l + s * clock (l + 1) + 1 + clock (l + 1) =
      u + b * clock l + (s + 1) * clock (l + 1) + 1 := by
  simp only [Nat.succ_mul]
  omega

/-- Exact signed GCD-compatible lag expansion for one actual selected child window in the
prime-power EDQ refinement block.  Its start and length are the literal ones in
`truncatedDivisorBlockKernel`. -/
theorem selectedRefinementBlock_truncatedDivisorWindow_sq_eq_gcd_compatible_lags
    (N l u b s : ℕ) :
    let t := u + b * clock l + s * clock (l + 1) + 1
    let L := clock (l + 1)
    (∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k) ^ 2 =
      ∑ k ∈ Ioc t (t + L), truncMoebiusDivisorSum N k * truncMoebiusDivisorSum N k +
        2 * ∑ h ∈ Ico 1 L,
          ∑ d ∈ Icc 1 N,
            ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
              ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
                ((#{k ∈ Ioc t (t + L - h) | d ∣ k ∧ e ∣ (k + h)} : ℕ) : ℝ) := by
  exact truncMoebiusDivisorSum_window_sq_eq_gcd_compatible_lags
    (u + b * clock l + s * clock (l + 1) + 1) (clock (l + 1)) N

/-- All beta-weighted raw windows in one selected EDQ child block form one literal physical
interval, whose square is the exact signed GCD-compatible incidence expression.  Thus this one
identity contains every cross-product among child windows without a termwise estimate. -/
theorem selectedRefinementBlock_betaWeightedWindow_sq_eq_gcd_compatible_lags
    (N l u b : ℕ) (x : ℝ) :
    let t := u + b * clock l + 1
    let Q := canonicalClockRatio N (l + 1)
    let C := clock (l + 1)
    (∑ s ∈ range Q, x ^ (s * C) *
      ∑ k ∈ Ioc (t + s * C) (t + (s + 1) * C), truncMoebiusDivisorSum N k) ^ 2 =
      ∑ k ∈ Ioc t (t + Q * C),
        (x ^ ((k - t - 1) / C * C) * truncMoebiusDivisorSum N k) *
          (x ^ ((k - t - 1) / C * C) * truncMoebiusDivisorSum N k) +
        2 * ∑ h ∈ Ico 1 (Q * C),
          ∑ d ∈ Icc 1 N,
            ∑ e ∈ Finset.filter (fun e => Nat.gcd d e ∣ h) (Icc 1 N),
              ((moebius d : ℤ) : ℝ) * ((moebius e : ℤ) : ℝ) *
                ∑ k ∈ Finset.filter (fun k => d ∣ k ∧ e ∣ (k + h))
                  (Ioc t (t + Q * C - h)),
                  x ^ ((k - t - 1) / C * C) *
                    x ^ (((k + h - t - 1) / C) * C) := by
  dsimp
  rw [beta_weighted_consecutive_windows_eq_weighted_Ioc
    (fun k => truncMoebiusDivisorSum N k) x
    (u + b * clock l + 1) (canonicalClockRatio N (l + 1)) (clock (l + 1))
    (clock_pos (l + 1))]
  exact weighted_truncMoebiusDivisorSum_window_sq_eq_gcd_compatible_lags
    (fun k => x ^ ((k - (u + b * clock l + 1) - 1) / clock (l + 1) * clock (l + 1)))
    (u + b * clock l + 1) (canonicalClockRatio N (l + 1) * clock (l + 1)) N

