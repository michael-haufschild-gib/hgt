import GaloisForLFunctions.RHTower.BoseMellinCoordinate
import GaloisForLFunctions.RHTower.RiemannXiZerosInfinite

/-!
# Parikh--Wilczek horizon-backreaction jets mix every theta/Xi mode

This endpoint uses finite-mass Schwarzschild backreaction, not an eternal KMS relabelling.
For a hole of mass `M`, the Parikh--Wilczek tunnelling law is

`Gamma_M(E) = exp (S(M-E) - S(M)) = exp (-8 pi M E + 4 pi E^2)`.

With dimensionless energy `x = 8 pi M E` and
`epsilon = 1 / (16 pi M^2)`, its exponent is `-x + epsilon*x^2`.  Summing repeated
bosonic windings gives

`1 / (exp (x - epsilon*x^2) - 1)`

on the physical interval `0 < x - epsilon*x^2`.  We verify that geometric winding expansion
exactly and differentiate every winding term at zero backreaction.  The `k`-th termwise
backreaction derivative carries `n^k*x^(2k)`, so its Mellin jet is

`Gamma(s + 2k) * zeta(s + k)`.

This has a sharp consequence.  A nontrivial zeta zero is dark at `k = 0`, but every positive
backreaction jet is nonzero: `Re(s+k) > 1` makes the shifted zeta factor zero-free and the Gamma
factor never vanishes.  In particular, actual theta/Xi divisor copies all mix at every positive
Parikh--Wilczek order, whether or not they lie on the critical line.

Thus finite-mass horizon shrinkage cannot supply an RH selector by generic "eventual mixing".
Any surviving RH mechanism must use the nonperturbative finite-support endpoint, the evaporation
singularity, or an observable that canonically removes this universal shifted-zeta cascade.

Physics source: Parikh--Wilczek, *Hawking Radiation as Tunneling*, hep-th/9907001.
The file proves the exact winding law, the first winding derivative, the evaluated first Mellin
normal form, and the all-order divisor nonvanishing statement.  It does not interchange an
infinite sum, Mellin integral, and all derivatives in one theorem.
-/

open Set

namespace RHTower

noncomputable section

/-- Bose occupation generated by the finite-mass Parikh--Wilczek tunnelling exponent.
The physical energy range is expressed separately by `0 < x - epsilon*x^2`. -/
def schwarzschildParikhWilczekOccupation (epsilon x : ℝ) : ℝ :=
  (Real.exp (x - epsilon * x ^ 2) - 1)⁻¹

/-- Infinite-mass limit: horizon backreaction disappears and the ordinary Hawking--Planck
occupation remains. -/
theorem schwarzschildParikhWilczekOccupation_zero (x : ℝ) :
    schwarzschildParikhWilczekOccupation 0 x = (Real.exp x - 1)⁻¹ := by
  simp [schwarzschildParikhWilczekOccupation]

/-- The `(n+1)`-st Bose winding of the energy-conserving tunnelling probability.  The affine
form in `epsilon` exposes its backreaction derivatives without changing the physical exponent. -/
def schwarzschildParikhWilczekWindingTerm (n : ℕ) (epsilon x : ℝ) : ℝ :=
  Real.exp (-((n : ℝ) + 1) * x + epsilon * (((n : ℝ) + 1) * x ^ 2))

/-- Exact finite-mass winding expansion on the physical side of the shrinking-horizon pole. -/
theorem hasSum_schwarzschildParikhWilczekWindingTerm
    {epsilon x : ℝ} (hphysical : 0 < x - epsilon * x ^ 2) :
    HasSum (fun n : ℕ => schwarzschildParikhWilczekWindingTerm n epsilon x)
      (schwarzschildParikhWilczekOccupation epsilon x) := by
  convert hasSum_boseKernel hphysical using 1
  funext n
  simp only [schwarzschildParikhWilczekWindingTerm]
  congr 1
  ring_nf
  rfl

/-- First horizon-shrinkage derivative of each exact Bose winding.  Its new factor `n+1` is what
shifts `zeta(s)` to `zeta(s+1)` after Mellin transformation. -/
theorem hasDerivAt_schwarzschildParikhWilczekWindingTerm_zero (n : ℕ) (x : ℝ) :
    HasDerivAt (fun epsilon => schwarzschildParikhWilczekWindingTerm n epsilon x)
      (((n : ℝ) + 1) * x ^ 2 * Real.exp (-((n : ℝ) + 1) * x)) 0 := by
  unfold schwarzschildParikhWilczekWindingTerm
  have hinner : HasDerivAt
      (fun epsilon : ℝ => -((n : ℝ) + 1) * x + epsilon * (((n : ℝ) + 1) * x ^ 2))
      (((n : ℝ) + 1) * x ^ 2) 0 := by
    change HasDerivAt
      ((fun _ : ℝ => -((n : ℝ) + 1) * x) +
        fun epsilon : ℝ => epsilon * (((n : ℝ) + 1) * x ^ 2))
      (((n : ℝ) + 1) * x ^ 2) 0
    simpa only [id_eq, zero_add, one_mul] using
      (hasDerivAt_const (x := 0) (-((n : ℝ) + 1) * x)).add
      ((hasDerivAt_id (x := 0)).mul_const (((n : ℝ) + 1) * x ^ 2))
  simpa [mul_assoc, mul_comm] using hinner.exp

/-- Canonical analytic Mellin jet of order `k` produced by finite-mass horizon shrinkage.
Termwise, `n^k*x^(2k)` changes `Gamma(s) zeta(s)` into
`Gamma(s+2k) zeta(s+k)`. -/
def schwarzschildParikhWilczekMellinJet (k : ℕ) (s : ℂ) : ℂ :=
  Complex.Gamma (s + 2 * (k : ℂ)) * riemannZeta (s + (k : ℂ))

/-- Real first-jet Mellin normal form after boundary-free integration by parts. -/
def schwarzschildParikhWilczekFirstBackreactionMellin (a : ℝ) : ℝ :=
  (a + 2) * boseMellin (a + 1)

/-- Exact evaluation of the first finite-mass backreaction Mellin normal form. -/
theorem ofReal_schwarzschildParikhWilczekFirstBackreactionMellin
    {a : ℝ} (ha : -1 < a) :
    ((schwarzschildParikhWilczekFirstBackreactionMellin a : ℝ) : ℂ) =
      Complex.Gamma (((a + 3 : ℝ) : ℂ)) *
        riemannZeta (((a + 2 : ℝ) : ℂ)) := by
  rw [schwarzschildParikhWilczekFirstBackreactionMellin, Complex.ofReal_mul,
    ofReal_boseMellin (a := a + 1) (by linarith)]
  rw [show (((a + 3 : ℝ) : ℂ)) = (((a + 2 : ℝ) : ℂ)) + 1 by norm_num; ring_nf,
    Complex.Gamma_add_one _ (by
      simpa only [ne_eq, Complex.ofReal_eq_zero] using (show a + 2 ≠ 0 by linarith))]
  push_cast
  ring_nf

/-- The evaluated real first moment is exactly the order-one analytic jet. -/
theorem ofReal_schwarzschildParikhWilczekFirstBackreactionMellin_eq_jetOne
    {a : ℝ} (ha : -1 < a) :
    ((schwarzschildParikhWilczekFirstBackreactionMellin a : ℝ) : ℂ) =
      schwarzschildParikhWilczekMellinJet 1 (((a + 1 : ℝ) : ℂ)) := by
  rw [ofReal_schwarzschildParikhWilczekFirstBackreactionMellin ha]
  unfold schwarzschildParikhWilczekMellinJet
  norm_num
  congr 2 <;> ring_nf

/-- At zero backreaction, every nontrivial zeta zero is a dark Mellin mode. -/
theorem schwarzschildParikhWilczekMellinJet_zero_of_zeta_zero
    {s : ℂ} (hs : riemannZeta s = 0) :
    schwarzschildParikhWilczekMellinJet 0 s = 0 := by
  simp [schwarzschildParikhWilczekMellinJet, hs]

/-- Every positive backreaction order is bright throughout the positive half-plane.  This is
stronger than a statement restricted to zeta zeros and uses no RH hypothesis. -/
theorem schwarzschildParikhWilczekMellinJet_ne_zero
    {k : ℕ} (hk : 1 ≤ k) {s : ℂ} (hs : 0 < s.re) :
    schwarzschildParikhWilczekMellinJet k s ≠ 0 := by
  apply mul_ne_zero
  · apply Complex.Gamma_ne_zero
    intro n hn
    have hre := congrArg Complex.re hn
    norm_num at hre
    have hk0 : 0 < (k : ℝ) := by exact_mod_cast hk
    linarith
  · apply riemannZeta_ne_zero_of_one_lt_re
    simp only [Complex.add_re, Complex.natCast_re]
    have hk0 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    linarith

/-- A nontrivial zeta mode is dark only at the eternal/infinite-mass endpoint.  Every positive
Parikh--Wilczek horizon-backreaction jet activates it. -/
theorem schwarzschildParikhWilczekMellinJet_all_positive_orders_ne_zero_at_nontrivial_zero
    {s : ℂ} (hs0 : 0 < s.re) (hz : riemannZeta s = 0) :
    schwarzschildParikhWilczekMellinJet 0 s = 0 ∧
      ∀ k : ℕ, 1 ≤ k → schwarzschildParikhWilczekMellinJet k s ≠ 0 := by
  exact ⟨schwarzschildParikhWilczekMellinJet_zero_of_zeta_zero hz,
    fun k hk => schwarzschildParikhWilczekMellinJet_ne_zero hk hs0⟩

/-- Theta-specific specialization: every actual completed theta/Xi zero in the open strip is
brightened at every positive horizon-backreaction order, including critical-line zeros. -/
theorem thetaXi_schwarzschildParikhWilczekMellinJet_all_positive_orders_ne_zero
    {s : ℂ} (hs0 : 0 < s.re) (hs1 : s.re < 1) (hxi : xi s = 0) :
    schwarzschildParikhWilczekMellinJet 0 s = 0 ∧
      ∀ k : ℕ, 1 ≤ k → schwarzschildParikhWilczekMellinJet k s ≠ 0 := by
  have hne1 : s ≠ 1 := by
    intro hs
    have hre := congrArg Complex.re hs
    norm_num at hre
    linarith
  have hz : riemannZeta s = 0 := (xi_eq_zero_iff hs0 hne1).mp hxi
  exact schwarzschildParikhWilczekMellinJet_all_positive_orders_ne_zero_at_nontrivial_zero
    hs0 hz

/-- Unconditional global endpoint: finite-mass Schwarzschild tunnelling backreaction mixes every
theta/Xi divisor mode at every positive perturbative order. -/
def SchwarzschildParikhWilczekBackreactionMixesEveryThetaXiMode : Prop :=
  ∀ s : ℂ, 0 < s.re → s.re < 1 → xi s = 0 →
    ∀ k : ℕ, 1 ≤ k → schwarzschildParikhWilczekMellinJet k s ≠ 0

theorem schwarzschildParikhWilczekBackreaction_mixesEveryThetaXiMode :
    SchwarzschildParikhWilczekBackreactionMixesEveryThetaXiMode := by
  intro s hs0 hs1 hxi k hk
  exact (thetaXi_schwarzschildParikhWilczekMellinJet_all_positive_orders_ne_zero
    hs0 hs1 hxi).2 k hk

/-- Non-vacuity: some nontrivial dark zeta mode exists and is bright at every positive
backreaction order. -/
theorem exists_schwarzschildParikhWilczek_dark_zero_bright_at_every_backreaction_order :
    ∃ s : ℂ, 0 < s.re ∧ s.re < 1 ∧
      schwarzschildParikhWilczekMellinJet 0 s = 0 ∧
      ∀ k : ℕ, 1 ≤ k → schwarzschildParikhWilczekMellinJet k s ≠ 0 := by
  obtain ⟨s, hs0, hs1, hz⟩ := exists_riemannZeta_zero_mem_openStrip
  exact ⟨s, hs0, hs1, schwarzschildParikhWilczekMellinJet_zero_of_zeta_zero hz,
    fun k hk => schwarzschildParikhWilczekMellinJet_ne_zero hk hs0⟩

end

end RHTower
