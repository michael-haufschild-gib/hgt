import GaloisForLFunctions.Bottcher.ModularLambda
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups

/-!
# The theta function as a weight-½ form on `Γ₀(4)`

`θ(z) = Σ_{n∈ℤ} e(n²z)` is the kernel of Shimura's integral for the symmetric square
`L(s, sym² u ⊗ χ)`, the GL₂ input behind every known improvement of Selberg's `3/16`.

* `norm_sq_theta_U`: `|θ(z/(4z+1))|² = |4z+1|·|θ(z)|²`, from the `S`-transformation of the Jacobi
  theta function and its period `2`.
* `Gamma0_four_le`: `Γ₀(4)` is generated by `T = [[1,1],[0,1]]`, `U = [[1,0],[4,1]]` and `-1`
  (descent on `|c|`: reduce `d` modulo `c`, then `c` modulo `4d`; equality of sizes would force
  `d` even and `c ≡ 0 (4)`, contradicting `det = 1`).
* `thetaInv_smul`: `y^{1/2}|θ(z)|²` is `Γ₀(4)`-invariant.
* The automorphy factor `J(γ,z) = θ(γz)/θ(z)` is well defined because `θ` has no zeros on `ℍ`
  (`Bottcher.thetaThree_ne_zero_of_im_pos`); it satisfies the cocycle relation `J_mul`,
  `J(Tγ, z) = J(γ, z)`, `J(-γ, z) = J(γ, z)`, and `norm_sq_J`: `|J(γ,z)|² = |cz+d|` on `Γ₀(4)`.

The explicit value `J(γ,z) = ε_d⁻¹ (c/d) (cz+d)^{1/2}` is not needed for the modularity statements;
only the cocycle and the modulus are used downstream.
-/

open Complex Matrix
open scoped MatrixGroups

namespace GaloisForLFunctions.RHTower.HalfWeight

/-! ### The theta function `θ(z) = Σ e(n²z)` -/

/-- `θ(z) = Σ_{n ∈ ℤ} e(n² z)`. -/
noncomputable def theta (z : ℂ) : ℂ := jacobiTheta (2 * z)

theorem theta_ne_zero {z : ℂ} (hz : 0 < z.im) : theta z ≠ 0 := by
  have h : 0 < (2 * z).im := by simp; linarith
  have := Bottcher.thetaThree_ne_zero_of_im_pos h
  simpa [theta, jacobiTheta_eq_jacobiTheta₂, Bottcher.thetaThree] using this

theorem theta_add_one (z : ℂ) : theta (z + 1) = theta z := by
  simp only [theta, mul_add, mul_one]
  rw [add_comm]
  exact jacobiTheta_two_add _

theorem jacobiTheta_neg_inv {τ : ℂ} (hτ : 0 < τ.im) :
    jacobiTheta (-τ⁻¹) = (-I * τ) ^ (1 / 2 : ℂ) * jacobiTheta τ := by
  have h := jacobiTheta_S_smul ⟨τ, hτ⟩
  rw [UpperHalfPlane.modular_S_smul] at h
  rw [neg_inv]
  exact h

theorem norm_cpow_half (a : ℂ) : ‖a ^ (1 / 2 : ℂ)‖ = ‖a‖ ^ (1 / 2 : ℝ) := by
  have : (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) := by push_cast; ring
  rw [this, Complex.norm_cpow_real]

/-- The `U`-transformation in norm: `|θ(z/(4z+1))|² = |4z+1| · |θ(z)|²`. -/
theorem norm_sq_theta_U {z : ℂ} (hz : 0 < z.im) :
    ‖theta (z / (4 * z + 1))‖ ^ 2 = ‖4 * z + 1‖ * ‖theta z‖ ^ 2 := by
  have hz0 : z ≠ 0 := fun h => by simp [h] at hz
  have hd : 4 * z + 1 ≠ 0 := by
    intro h
    have := congrArg Complex.im h
    simp at this; linarith
  set w := z / (4 * z + 1) with hw
  have hwim : 0 < w.im := by
    have : w.im = z.im / Complex.normSq (4 * z + 1) := by
      rw [hw, Complex.div_im]
      simp [Complex.normSq_apply]
      field_simp
      ring
    rw [this]
    exact div_pos hz (Complex.normSq_pos.2 hd)
  have h2w : 0 < (2 * w).im := by simp; linarith
  have h2z : 0 < (2 * z).im := by simp; linarith
  -- `-(2w)⁻¹ = -2 + (-(2z)⁻¹)`
  have hkey : -(2 * w)⁻¹ = -2 + -(2 * z)⁻¹ := by
    rw [hw]; field_simp; ring
  have e1 := jacobiTheta_neg_inv h2w
  have e2 := jacobiTheta_neg_inv h2z
  rw [hkey, show (-2 : ℂ) + -(2 * z)⁻¹ = -(2 * z)⁻¹ - 2 by ring] at e1
  have hper : jacobiTheta (-(2 * z)⁻¹ - 2) = jacobiTheta (-(2 * z)⁻¹) := by
    have := jacobiTheta_two_add (-(2 * z)⁻¹ - 2)
    rw [show (2 : ℂ) + (-(2 * z)⁻¹ - 2) = -(2 * z)⁻¹ by ring] at this
    exact this.symm
  rw [hper, e2] at e1
  -- take norms
  have n1 := congrArg (‖·‖) e1
  rw [norm_mul, norm_mul, norm_cpow_half, norm_cpow_half] at n1
  have hpos : 0 < ‖-I * (2 * w)‖ := by
    rw [norm_pos_iff]
    exact mul_ne_zero (neg_ne_zero.2 I_ne_zero) (mul_ne_zero two_ne_zero (fun h => by simp [h] at hwim))
  have hmul : (4 * z + 1) * w = z := by rw [hw]; exact mul_div_cancel₀ z hd
  have hratio : ‖-I * (2 * z)‖ = ‖4 * z + 1‖ * ‖-I * (2 * w)‖ := by
    rw [← norm_mul]
    congr 1
    linear_combination (-2 * I) * hmul.symm
  change ‖jacobiTheta (2 * w)‖ ^ 2 = ‖4 * z + 1‖ * ‖jacobiTheta (2 * z)‖ ^ 2
  have hsq : (‖-I * (2 * w)‖ ^ (1 / 2 : ℝ)) ^ 2 = ‖-I * (2 * w)‖ := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num
  have hsq' : (‖-I * (2 * z)‖ ^ (1 / 2 : ℝ)) ^ 2 = ‖-I * (2 * z)‖ := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]; norm_num
  have n2 : ‖-I * (2 * z)‖ * ‖jacobiTheta (2 * z)‖ ^ 2 =
      ‖-I * (2 * w)‖ * ‖jacobiTheta (2 * w)‖ ^ 2 := by
    have := congrArg (· ^ 2) n1
    simp only [mul_pow, hsq, hsq'] at this
    exact this
  rw [hratio] at n2
  refine mul_left_cancel₀ hpos.ne' ?_
  rw [← n2]; ring

/-! ### Generators of `Γ₀(4)` -/

/-- `U = [[1,0],[4,1]]`. -/
def U : SL(2, ℤ) := ⟨!![1, 0; 4, 1], by simp [Matrix.det_fin_two]⟩

theorem coe_U : ((U : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 0; 4, 1] := rfl

theorem coe_U_zpow (m : ℤ) :
    ((U ^ m : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 0; 4 * m, 1] := by
  induction m using Int.induction_on with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> simp
  | succ m ih =>
    rw [_root_.zpow_add_one, Matrix.SpecialLinearGroup.coe_mul, ih, coe_U]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]; ring
  | pred m ih =>
    rw [_root_.zpow_sub_one, Matrix.SpecialLinearGroup.coe_mul, ih, Matrix.SpecialLinearGroup.coe_inv,
      coe_U, Matrix.adjugate_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]; ring

/-- The subgroup generated by `T`, `U` and `-1`. -/
abbrev gensT4 : Subgroup SL(2, ℤ) :=
  Subgroup.closure ({ModularGroup.T, U, -1} : Set SL(2, ℤ))

theorem T_zpow_mem (k : ℤ) : ModularGroup.T ^ k ∈ gensT4 :=
  zpow_mem (Subgroup.subset_closure (by simp)) k

theorem U_zpow_mem (m : ℤ) : U ^ m ∈ gensT4 :=
  zpow_mem (Subgroup.subset_closure (by simp)) m

theorem neg_one_mem : (-1 : SL(2, ℤ)) ∈ gensT4 :=
  Subgroup.subset_closure (by simp)

theorem exists_small_rem (d c : ℤ) (hc : c ≠ 0) : ∃ k : ℤ, 2 * |d + k * c| ≤ |c| := by
  have h0 := Int.emod_nonneg d hc
  have h1 := Int.emod_lt d hc
  have habs : ((c.natAbs : ℕ) : ℤ) = |c| := Int.natCast_natAbs c
  rw [habs] at h1
  have hr : d + -(d / c) * c = d % c := by rw [Int.emod_def]; ring
  by_cases h2 : 2 * (d % c) ≤ |c|
  · exact ⟨-(d / c), by rw [hr, abs_of_nonneg h0]; exact h2⟩
  · have h2' := not_le.mp h2
    rcases le_or_gt 0 c with hc0 | hc0
    · refine ⟨-(d / c) - 1, ?_⟩
      have e : d + (-(d / c) - 1) * c = d % c - c := by rw [← hr]; ring
      rw [abs_of_nonneg hc0] at h1 h2'
      rw [e, abs_of_nonneg hc0, abs_of_nonpos (by linarith)]
      linarith
    · refine ⟨-(d / c) + 1, ?_⟩
      have e : d + (-(d / c) + 1) * c = d % c + c := by rw [← hr]; ring
      rw [abs_of_neg hc0] at h1 h2'
      rw [e, abs_of_neg hc0, abs_of_nonpos (by linarith)]
      linarith

/-- The integer entries of an element of `SL(2,ℤ)`. -/
def ent (γ : SL(2, ℤ)) (i j : Fin 2) : ℤ := (γ : Matrix (Fin 2) (Fin 2) ℤ) i j

theorem det_entries (γ : SL(2, ℤ)) : ent γ 0 0 * ent γ 1 1 - ent γ 0 1 * ent γ 1 0 = 1 := by
  have := γ.det_coe
  rw [Matrix.det_fin_two] at this
  exact this

theorem mul_T_zpow_10 (γ : SL(2, ℤ)) (k : ℤ) : ent (γ * ModularGroup.T ^ k) 1 0 = ent γ 1 0 := by
  simp [ent, ModularGroup.coe_T_zpow, Matrix.mul_apply, Fin.sum_univ_two]

theorem mul_T_zpow_11 (γ : SL(2, ℤ)) (k : ℤ) :
    ent (γ * ModularGroup.T ^ k) 1 1 = ent γ 1 1 + k * ent γ 1 0 := by
  simp [ent, ModularGroup.coe_T_zpow, Matrix.mul_apply, Fin.sum_univ_two]
  ring

theorem mul_U_zpow_10 (γ : SL(2, ℤ)) (m : ℤ) :
    ent (γ * U ^ m) 1 0 = ent γ 1 0 + m * (4 * ent γ 1 1) := by
  simp [ent, coe_U_zpow, Matrix.mul_apply, Fin.sum_univ_two]
  ring

theorem mul_U_zpow_11 (γ : SL(2, ℤ)) (m : ℤ) : ent (γ * U ^ m) 1 1 = ent γ 1 1 := by
  simp [ent, coe_U_zpow, Matrix.mul_apply, Fin.sum_univ_two]

theorem two_dvd_one_false {a b c d : ℤ} (h : a * d - b * c = 1) (hc : 2 ∣ c) (hd : 2 ∣ d) :
    False := by
  obtain ⟨c', rfl⟩ := hc
  obtain ⟨d', rfl⟩ := hd
  have h1 : 2 * (a * d' - b * c') = 1 := by rw [← h]; ring
  have h2 : (2 * (a * d' - b * c')) % 2 = 1 % 2 := by rw [h1]
  rw [Int.mul_emod_right] at h2
  norm_num at h2

/-- Descent: an element of `SL(2,ℤ)` with `4 ∣ c` lies in the group generated by `T`, `U`, `-1`. -/
theorem mem_gensT4_aux (n : ℕ) : ∀ γ : SL(2, ℤ), (ent γ 1 0).natAbs = n →
    (4 : ℤ) ∣ ent γ 1 0 → γ ∈ gensT4 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro γ hn h4
  have hdet := det_entries γ
  by_cases hc : ent γ 1 0 = 0
  · rw [hc, mul_zero, sub_zero] at hdet
    rcases Int.eq_one_or_neg_one_of_mul_eq_one' hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
    · have : γ = ModularGroup.T ^ (ent γ 0 1) := by
        ext i j
        rw [ModularGroup.coe_T_zpow]
        simp only [ent] at ha hd hc
        fin_cases i <;> fin_cases j <;> simp [ha, hd, hc, ent]
      rw [this]; exact T_zpow_mem _
    · have : γ = -1 * ModularGroup.T ^ (-ent γ 0 1) := by
        ext i j
        rw [Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_T_zpow]
        simp only [ent] at ha hd hc
        fin_cases i <;> fin_cases j <;> simp [ha, hd, hc, ent, Matrix.mul_apply, Fin.sum_univ_two]
      rw [this]; exact mul_mem neg_one_mem (T_zpow_mem _)
  · obtain ⟨k, hk⟩ := exists_small_rem (ent γ 1 1) (ent γ 1 0) hc
    set γ₁ := γ * ModularGroup.T ^ k with hγ₁
    have e10 : ent γ₁ 1 0 = ent γ 1 0 := mul_T_zpow_10 γ k
    have e11 : ent γ₁ 1 1 = ent γ 1 1 + k * ent γ 1 0 := mul_T_zpow_11 γ k
    have hdet1 := det_entries γ₁
    rw [e10] at hdet1
    -- the new bottom-right entry is nonzero
    have hd0 : ent γ₁ 1 1 ≠ 0 := by
      intro h0
      rw [h0, mul_zero, zero_sub] at hdet1
      obtain ⟨t, ht⟩ := h4
      have : ent γ₁ 0 1 * t * 4 = -1 := by rw [ht] at hdet1; linarith
      omega
    obtain ⟨m, hm⟩ := exists_small_rem (ent γ 1 0) (4 * ent γ₁ 1 1) (by positivity)
    set γ₂ := γ₁ * U ^ m with hγ₂
    have f10 : ent γ₂ 1 0 = ent γ 1 0 + m * (4 * ent γ₁ 1 1) := by
      rw [hγ₂, mul_U_zpow_10, e10]
    have f11 : ent γ₂ 1 1 = ent γ₁ 1 1 := mul_U_zpow_11 γ₁ m
    have h4' : (4 : ℤ) ∣ ent γ₂ 1 0 := by
      rw [f10]; exact dvd_add h4 (dvd_mul_of_dvd_right (dvd_mul_right 4 _) m)
    -- strict descent of `|c|`
    have hlt : (ent γ₂ 1 0).natAbs < n := by
      rw [← hn]
      have hk' : 2 * |ent γ₁ 1 1| ≤ |ent γ 1 0| := by rw [e11, add_comm (ent γ 1 1) _] at *; linarith [hk]
      have hm' : 2 * |ent γ₂ 1 0| ≤ 4 * |ent γ₁ 1 1| := by
        rw [f10]; rw [abs_mul] at hm; simpa [abs_of_pos (by norm_num : (0:ℤ) < 4)] using hm
      have hne : |ent γ₂ 1 0| ≠ |ent γ 1 0| := by
        intro heq
        have hd2 : |ent γ 1 0| = 2 * |ent γ₁ 1 1| := by linarith
        -- then `4 ∣ 2 d'`, so `d'` is even, contradicting `det γ₁ = 1` with `c` even
        have h2d : (2 : ℤ) ∣ ent γ₁ 1 1 := by
          obtain ⟨t, ht⟩ := h4
          rcases abs_cases (ent γ 1 0) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
            rcases abs_cases (ent γ₁ 1 1) with ⟨h2, _⟩ | ⟨h2, _⟩ <;> omega
        exact two_dvd_one_false hdet1 (dvd_trans (by norm_num) h4) h2d
      have : |ent γ₂ 1 0| < |ent γ 1 0| := lt_of_le_of_ne (by linarith) hne
      rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at this
      exact_mod_cast this
    have hmem := ih _ hlt γ₂ rfl h4'
    have : γ = γ₂ * U ^ (-m) * ModularGroup.T ^ (-k) := by
      rw [hγ₂, hγ₁]; group
    rw [this]
    exact mul_mem (mul_mem hmem (U_zpow_mem _)) (T_zpow_mem _)

/-- **`Γ₀(4)` is generated by `T = [[1,1],[0,1]]`, `U = [[1,0],[4,1]]` and `-1`.** -/
theorem Gamma0_four_le : CongruenceSubgroup.Gamma0 4 ≤ gensT4 := by
  intro γ hγ
  rw [CongruenceSubgroup.Gamma0_mem] at hγ
  have h4 : (4 : ℤ) ∣ ent γ 1 0 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 4).1 hγ
  exact mem_gensT4_aux _ γ rfl h4

/-! ### The invariant `y^{1/2}|θ|²` and the theta automorphy factor -/

/-- `Φ(z) = y^{1/2} |θ(z)|²`, the `Γ₀(4)`-invariant attached to `θ`. -/
noncomputable def thetaInv (z : UpperHalfPlane) : ℝ := Real.sqrt z.im * ‖theta z‖ ^ 2

theorem thetaInv_T (z : UpperHalfPlane) : thetaInv (ModularGroup.T • z) = thetaInv z := by
  have hc : ((ModularGroup.T • z : UpperHalfPlane) : ℂ) = z + 1 := by
    rw [UpperHalfPlane.modular_T_smul, UpperHalfPlane.coe_vadd]; push_cast; ring
  have hi : (ModularGroup.T • z).im = z.im := by
    rw [UpperHalfPlane.modular_T_smul]; simp
  rw [thetaInv, thetaInv, hi, hc, theta_add_one]

theorem thetaInv_U (z : UpperHalfPlane) : thetaInv (U • z) = thetaInv z := by
  have hd : UpperHalfPlane.denom U z = 4 * (z : ℂ) + 1 := by
    rw [ModularGroup.denom_apply]; simp [coe_U]
  have hc : ((U • z : UpperHalfPlane) : ℂ) = z / (4 * z + 1) := by
    rw [UpperHalfPlane.coe_specialLinearGroup_apply]; simp [coe_U]
  have hi : (U • z).im = z.im / Complex.normSq (4 * (z : ℂ) + 1) := by
    rw [ModularGroup.im_smul_eq_div_normSq, hd]
  have hne : ‖4 * (z : ℂ) + 1‖ ≠ 0 := by
    rw [norm_ne_zero_iff, ← hd]; exact UpperHalfPlane.denom_ne_zero _ _
  rw [thetaInv, thetaInv, hi, hc, norm_sq_theta_U z.im_pos, Complex.normSq_eq_norm_sq,
    Real.sqrt_div' _ (by positivity), Real.sqrt_sq (norm_nonneg _)]
  field_simp

theorem thetaInv_neg_one (z : UpperHalfPlane) : thetaInv ((-1 : SL(2, ℤ)) • z) = thetaInv z := by
  rw [ModularGroup.SL_neg_smul, one_smul]

/-- **`y^{1/2}|θ(z)|²` is `Γ₀(4)`-invariant.** -/
theorem thetaInv_smul {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 4)
    (z : UpperHalfPlane) : thetaInv (γ • z) = thetaInv z := by
  have hmem := Gamma0_four_le hγ
  clear hγ
  induction hmem using Subgroup.closure_induction generalizing z with
  | mem x hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact thetaInv_T z
    · exact thetaInv_U z
    · exact thetaInv_neg_one z
  | one => rw [one_smul]
  | mul x y _ _ hx hy => rw [mul_smul, hx, hy]
  | inv x _ hx =>
    have h := hx (x⁻¹ • z)
    rw [smul_inv_smul] at h
    exact h.symm

/-- The theta automorphy factor `J(γ, z) = θ(γz)/θ(z)`. -/
noncomputable def J (γ : SL(2, ℤ)) (z : UpperHalfPlane) : ℂ :=
  theta ((γ • z : UpperHalfPlane) : ℂ) / theta z

theorem theta_ne_zero' (z : UpperHalfPlane) : theta z ≠ 0 := theta_ne_zero z.im_pos

theorem J_ne_zero (γ : SL(2, ℤ)) (z : UpperHalfPlane) : J γ z ≠ 0 :=
  div_ne_zero (theta_ne_zero' _) (theta_ne_zero' _)

theorem theta_smul (γ : SL(2, ℤ)) (z : UpperHalfPlane) :
    theta ((γ • z : UpperHalfPlane) : ℂ) = J γ z * theta z := by
  rw [J, div_mul_cancel₀ _ (theta_ne_zero' z)]

/-- The cocycle relation `J(γγ', z) = J(γ, γ'z) J(γ', z)`. -/
theorem J_mul (γ γ' : SL(2, ℤ)) (z : UpperHalfPlane) : J (γ * γ') z = J γ (γ' • z) * J γ' z := by
  rw [J, J, J, mul_smul]
  have h1 := theta_ne_zero' z
  have h2 := theta_ne_zero' (γ' • z)
  field_simp

theorem J_T_mul (γ : SL(2, ℤ)) (z : UpperHalfPlane) : J (ModularGroup.T * γ) z = J γ z := by
  have hc : ((ModularGroup.T • (γ • z) : UpperHalfPlane) : ℂ) = (γ • z : UpperHalfPlane) + 1 := by
    rw [UpperHalfPlane.modular_T_smul, UpperHalfPlane.coe_vadd]; push_cast; ring
  rw [J, J, mul_smul, hc, theta_add_one]

theorem J_neg (γ : SL(2, ℤ)) (z : UpperHalfPlane) : J (-γ) z = J γ z := by
  rw [J, J, ModularGroup.SL_neg_smul]

/-- **`|J(γ, z)|² = |cz + d|` on `Γ₀(4)`**: `θ` has weight `1/2`. -/
theorem norm_sq_J {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 4) (z : UpperHalfPlane) :
    ‖J γ z‖ ^ 2 = ‖UpperHalfPlane.denom γ z‖ := by
  have h := thetaInv_smul hγ z
  rw [thetaInv, thetaInv, ModularGroup.im_smul_eq_div_normSq, Complex.normSq_eq_norm_sq,
    Real.sqrt_div' _ (by positivity), Real.sqrt_sq (norm_nonneg _)] at h
  have hd : ‖UpperHalfPlane.denom γ z‖ ≠ 0 := by
    rw [norm_ne_zero_iff]; exact UpperHalfPlane.denom_ne_zero _ _
  have hs : Real.sqrt z.im ≠ 0 := (Real.sqrt_pos.2 z.im_pos).ne'
  have ht : ‖theta z‖ ≠ 0 := norm_ne_zero_iff.2 (theta_ne_zero' z)
  rw [J, norm_div, div_pow]
  field_simp at h ⊢
  linarith [h]

end GaloisForLFunctions.RHTower.HalfWeight
