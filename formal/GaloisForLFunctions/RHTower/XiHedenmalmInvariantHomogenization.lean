import GaloisForLFunctions.RHTower.XiHedenmalmMultiplicityChain
import GaloisForLFunctions.RHTower.XiWeilPolarization

/-!
# Minimal invariant homogenization of the Hedenmalm source system

The least differentiation-invariant subspace containing the theta source has, on the Fourier side,
the polynomial module `XiC(z) C[z]`.  Quotienting by it removes the affine source term from the
folded Dirac system.  This module proves that the quotient is faithful on the divisor: the
Hedenmalm removable quotient at a Xi divisor point is never a polynomial multiple of `XiC`, because
it vanishes to order exactly one less than the multiplicity while every polynomial multiple
vanishes to order at least the multiplicity.
-/

open Complex

noncomputable section

namespace RHTower
/-! ## The Hedenmalm divided quotient is not a polynomial multiple of Xi -/

/-- **Minimal invariant homogenization is faithful.**  The Hedenmalm removable quotient at a Xi
divisor point is never a polynomial multiple of `XiC`, so the algebraic quotient by the
`D`-invariant module generated by the theta source retains every divisor mode.  At a zero of
multiplicity `m` the quotient vanishes to order exactly `m - 1`, whereas every polynomial multiple
of `XiC` vanishes to order at least `m`. -/
theorem xiThetaEigenFourier_notMem_xiPolynomialModule (rho : XiDivisorSupport) :
    ¬ ∃ P : Polynomial ℂ, ∀ z : ℂ,
        xiThetaEigenFourier (xiSpectralPointSupport rho) z = P.eval z * XiC z := by
  rintro ⟨P, hP⟩
  set α := xiSpectralPointSupport rho with hα
  set m := xiSupportMultiplicity rho with hm
  have hm1 : 1 ≤ m := xiSupportMultiplicity_pos rho
  have hQdef : ∀ z : ℂ, xiThetaEigenFourier α z = Complex.I * xiThetaDividedChain α 1 z := by
    intro z
    rfl
  have hQ : ∀ z : ℂ, XiC z = (z - α) * xiThetaDividedChain α 1 z := by
    intro z
    simpa using xiThetaDividedChain_partial_factorization rho hm1 z
  have hCfac : ∀ z : ℂ, XiC z = (z - α) ^ m * xiThetaDividedChain α m z :=
    xiThetaDividedChain_factorization rho
  have hCα : xiThetaDividedChain α m α ≠ 0 := xiThetaDividedChain_nonzero_at_multiplicity rho
  have hCcont : ContinuousAt (xiThetaDividedChain α m) α :=
    (xiThetaDividedChain_analyticAt α m α).continuousAt
  have hev : ∀ᶠ z in nhdsWithin α {α}ᶜ, xiThetaDividedChain α m z ≠ 0 :=
    nhdsWithin_le_nhds (hCcont.eventually_ne hCα)
  have hid : ∀ᶠ z in nhdsWithin α {α}ᶜ, P.eval z * (z - α) = Complex.I := by
    filter_upwards [hev, self_mem_nhdsWithin] with z hCz hzne
    have hzα : z - α ≠ 0 := sub_ne_zero.mpr hzne
    have hXine : XiC z ≠ 0 := by
      rw [hCfac z]
      exact mul_ne_zero (pow_ne_zero _ hzα) hCz
    have hQz : xiThetaDividedChain α 1 z ≠ 0 := by
      intro hzero
      rw [hQ z, hzero, mul_zero] at hXine
      exact hXine rfl
    have hkey := hP z
    rw [hQdef z, hQ z] at hkey
    field_simp at hkey
    exact hkey.symm
  have hlim0 : Filter.Tendsto (fun z : ℂ => P.eval z * (z - α)) (nhdsWithin α {α}ᶜ) (nhds 0) := by
    have hcont : ContinuousAt (fun z : ℂ => P.eval z * (z - α)) α := by
      exact (P.continuousAt_aeval).mul (continuousAt_id.sub continuousAt_const)
    have := hcont.continuousWithinAt (s := ({α}ᶜ : Set ℂ))
    simpa using this.tendsto
  have hlimI : Filter.Tendsto (fun z : ℂ => P.eval z * (z - α)) (nhdsWithin α {α}ᶜ)
      (nhds Complex.I) :=
    Filter.Tendsto.congr' (hid.mono fun z h => h.symm) tendsto_const_nhds
  have hI : Complex.I = 0 := tendsto_nhds_unique hlimI hlim0
  exact Complex.I_ne_zero hI


/-- **Minimality of the theta polynomial module.**  Any subspace of functions that contains `XiC`
and is stable under multiplication by the spectral coordinate already contains every polynomial
multiple of `XiC`.  On the Fourier side this is the statement that the least differentiation
invariant subspace containing the theta source is exactly `XiC(z) C[z]`: no smaller quotient can
both annihilate the source and carry a descended generator. -/
theorem eval_mul_XiC_mem_of_coordinateMultiplication_stable
    (S : Submodule ℂ (ℂ → ℂ)) (hXi : XiC ∈ S)
    (hstab : ∀ F ∈ S, xiCoordinateMultiplication F ∈ S) (P : Polynomial ℂ) :
    (fun z : ℂ => P.eval z * XiC z) ∈ S := by
  induction P using Polynomial.induction_on with
  | C a =>
      have hsmul : (a : ℂ) • XiC ∈ S := S.smul_mem a hXi
      refine (?_ : (fun z : ℂ => Polynomial.eval z (Polynomial.C a) * XiC z) = a • XiC) ▸ hsmul
      funext z
      simp [Pi.smul_apply, smul_eq_mul]
  | add p q hp hq =>
      have hsum : (fun z : ℂ => Polynomial.eval z p * XiC z) +
          (fun z : ℂ => Polynomial.eval z q * XiC z) ∈ S := S.add_mem hp hq
      refine (?_ : (fun z : ℂ => Polynomial.eval z (p + q) * XiC z) =
        (fun z : ℂ => Polynomial.eval z p * XiC z) +
          (fun z : ℂ => Polynomial.eval z q * XiC z)) ▸ hsum
      funext z
      simp [Polynomial.eval_add, add_mul]
  | monomial n a hn =>
      have hmul := hstab _ hn
      refine (?_ : (fun z : ℂ => Polynomial.eval z (Polynomial.C a * Polynomial.X ^ (n + 1)) *
        XiC z) =
        xiCoordinateMultiplication (fun z : ℂ =>
          Polynomial.eval z (Polynomial.C a * Polynomial.X ^ n) * XiC z)) ▸ hmul
      funext z
      simp only [xiCoordinateMultiplication, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X]
      ring


/-- Function-level form: the Hedenmalm removable quotient is not equal to any polynomial multiple
of `XiC`. -/
theorem xiThetaEigenFourier_ne_eval_mul_XiC (rho : XiDivisorSupport) (P : Polynomial ℂ) :
    xiThetaEigenFourier (xiSpectralPointSupport rho) ≠ fun z : ℂ => P.eval z * XiC z := by
  intro h
  exact xiThetaEigenFourier_notMem_xiPolynomialModule rho ⟨P, fun z => congrFun h z⟩

end RHTower
