import GaloisForLFunctions.RHTower.RoutePPrimitiveDepthSquareModularDefect

/-!
# Route P primitive Hankel depth-square intertwiner

P-G179 identifies P-G178's arithmetic contraction inside P-G177's canonical cubic Euler Hankel
synthesis.  Coefficient-faithful primitive depth squaring is intertwined pointwise with the
physical half-line dilation `f(r) -> f(2r)/2`.  The identity persists for every finite synthesis,
and the physical dilation has exact squared-energy factor `1/8`.

Thus the modular cancellation proved arithmetically in P-G178 is the pullback of an ordinary
geometric dilation on the pre-divisor Hankel carrier.  No Xi divisor or target capacity occurs.
-/

open Complex Filter Matrix MeasureTheory
open scoped BigOperators ComplexOrder

namespace RHTower

noncomputable section

/-- P-G177's primitive cubic Euler feature column before Hilbert completion. -/
def routePPrimitiveCubicHankelFeature
    (pe : Nat.Primes × ℕ) (r : ℝ) : ℂ :=
  finiteVonMangoldtDepthOneAmplitude (xiGammaEulerValuationNat pe) * (r : ℂ) *
    (Complex.exp (-((xiGammaEulerPrimitiveLogFrequency pe : ℂ) * (r : ℂ))) -
      Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
        (r : ℂ))))

/-- Coefficient-faithful arithmetic depth squaring is intertwined by P-G177's Hankel synthesis
with half-amplitude physical dilation `r ↦ 2r`. -/
theorem routePPrimitiveCubicHankelFeature_depthSquare
    (pe : Nat.Primes × ℕ) (r : ℝ) :
    (routePPrimitiveDepthSquareModularGain pe : ℂ) *
        routePPrimitiveCubicHankelFeature
          (routePPrimitiveDepthSquare pe) r =
      (1 / 2 : ℂ) * routePPrimitiveCubicHankelFeature pe (2 * r) := by
  have hq := routePPrimitiveDepthSquareModularGain_mul_amplitude pe
  simp only [routePPrimitiveCubicHankelFeature,
    xiGammaEulerPrimitiveLogFrequency_routePPrimitiveDepthSquare]
  calc
    (routePPrimitiveDepthSquareModularGain pe : ℂ) *
          (finiteVonMangoldtDepthOneAmplitude
              (xiGammaEulerValuationNat (routePPrimitiveDepthSquare pe)) * (r : ℂ) *
            (Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
                (r : ℂ))) -
              Complex.exp (-(((2 * (2 * xiGammaEulerPrimitiveLogFrequency pe) : ℝ) : ℂ) *
                (r : ℂ))))) =
        ((routePPrimitiveDepthSquareModularGain pe : ℂ) *
          finiteVonMangoldtDepthOneAmplitude
            (xiGammaEulerValuationNat (routePPrimitiveDepthSquare pe))) * (r : ℂ) *
            (Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
                (r : ℂ))) -
              Complex.exp (-(((2 * (2 * xiGammaEulerPrimitiveLogFrequency pe) : ℝ) : ℂ) *
                (r : ℂ)))) := by ring
    _ = finiteVonMangoldtDepthOneAmplitude (xiGammaEulerValuationNat pe) * (r : ℂ) *
            (Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
                (r : ℂ))) -
              Complex.exp (-(((2 * (2 * xiGammaEulerPrimitiveLogFrequency pe) : ℝ) : ℂ) *
                (r : ℂ)))) := by rw [hq]
    _ = (1 / 2 : ℂ) *
          (finiteVonMangoldtDepthOneAmplitude (xiGammaEulerValuationNat pe) *
            ((2 * r : ℝ) : ℂ) *
            (Complex.exp (-((xiGammaEulerPrimitiveLogFrequency pe : ℂ) *
                ((2 * r : ℝ) : ℂ))) -
              Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
                ((2 * r : ℝ) : ℂ))))) := by
      have h1 :
          Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
              (r : ℂ))) =
            Complex.exp (-((xiGammaEulerPrimitiveLogFrequency pe : ℂ) *
              ((2 * r : ℝ) : ℂ))) := by
        congr 1
        push_cast
        ring
      have h2 :
          Complex.exp (-(((2 * (2 * xiGammaEulerPrimitiveLogFrequency pe) : ℝ) : ℂ) *
              (r : ℂ))) =
            Complex.exp (-(((2 * xiGammaEulerPrimitiveLogFrequency pe : ℝ) : ℂ) *
              ((2 * r : ℝ) : ℂ))) := by
        congr 1
        push_cast
        ring
      rw [h1, h2]
      push_cast
      ring

/-- Finite primitive Euler synthesis generated by the cubic Hankel feature columns. -/
def routePPrimitiveCubicHankelFiniteSynthesis
    (s : Finset (Nat.Primes × ℕ)) (c : Nat.Primes × ℕ → ℂ) (r : ℝ) : ℂ :=
  ∑ pe ∈ s, c pe * routePPrimitiveCubicHankelFeature pe r

/-- Exact finite-packet intertwining between the arithmetic depth-square incidence and physical
dilation on the P-G177 Hankel carrier. -/
theorem routePPrimitiveCubicHankelFiniteSynthesis_depthSquare
    (s : Finset (Nat.Primes × ℕ)) (c : Nat.Primes × ℕ → ℂ) (r : ℝ) :
    (∑ pe ∈ s,
        c pe * (routePPrimitiveDepthSquareModularGain pe : ℂ) *
          routePPrimitiveCubicHankelFeature (routePPrimitiveDepthSquare pe) r) =
      (1 / 2 : ℂ) * routePPrimitiveCubicHankelFiniteSynthesis s c (2 * r) := by
  rw [routePPrimitiveCubicHankelFiniteSynthesis, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro pe hpe
  calc
    c pe * (routePPrimitiveDepthSquareModularGain pe : ℂ) *
          routePPrimitiveCubicHankelFeature (routePPrimitiveDepthSquare pe) r =
        c pe * ((routePPrimitiveDepthSquareModularGain pe : ℂ) *
          routePPrimitiveCubicHankelFeature (routePPrimitiveDepthSquare pe) r) := by ring
    _ = c pe * ((1 / 2 : ℂ) *
          routePPrimitiveCubicHankelFeature pe (2 * r)) := by
      rw [routePPrimitiveCubicHankelFeature_depthSquare]
    _ = (1 / 2 : ℂ) *
          (c pe * routePPrimitiveCubicHankelFeature pe (2 * r)) := by ring

/-- Half-amplitude dyadic dilation has exact squared-energy factor `1/8` on the physical
half-line. -/
theorem integral_normSq_half_dyadic_dilation (f : ℝ → ℂ) :
    (∫ r : ℝ in Set.Ioi 0, Complex.normSq ((1 / 2 : ℂ) * f (2 * r))) =
      (1 / 8 : ℝ) * ∫ r : ℝ in Set.Ioi 0, Complex.normSq (f r) := by
  have hscale := MeasureTheory.integral_comp_mul_left_Ioi
    (fun r : ℝ => Complex.normSq (f r)) 0 (by norm_num : (0 : ℝ) < 2)
  calc
    (∫ r : ℝ in Set.Ioi 0, Complex.normSq ((1 / 2 : ℂ) * f (2 * r))) =
        ∫ r : ℝ in Set.Ioi 0, (1 / 4 : ℝ) * Complex.normSq (f (2 * r)) := by
          apply integral_congr_ae
          filter_upwards with r
          rw [Complex.normSq_mul]
          norm_num [Complex.normSq]
    _ = (1 / 4 : ℝ) *
        ∫ r : ℝ in Set.Ioi 0, Complex.normSq (f (2 * r)) := by
          rw [integral_const_mul]
    _ = (1 / 8 : ℝ) * ∫ r : ℝ in Set.Ioi 0, Complex.normSq (f r) := by
          rw [hscale]
          norm_num [smul_eq_mul]
          ring

end

end RHTower
