import GaloisForLFunctions.RHTower.MobiusDivisorInheritedPrimeInsertionProducer

/-!
# Simultaneous finite prime-cluster synthesis

Separated windows of actual primes realize a common rapidly oscillating
exponential with any prescribed finite collection of integer dilation phases.
The helper primes tend to infinity, while their total inverse-square-root
mass stays bounded. The approximation retains the literal Euler multiplier.
-/

noncomputable section
open Finset Set Filter Topology MeasureTheory
namespace RHTower
open PrimePreparation

private def windowWidth (R : Finset ℕ) (n : ℕ) : ℝ :=
  ((R.sup id + n + 2 : ℕ) : ℝ)⁻¹

private lemma windowWidth_pos (R : Finset ℕ) (n : ℕ) :
    0 < windowWidth R n := by
  unfold windowWidth
  positivity

private lemma windowWidth_tendsto (R : Finset ℕ) :
    Tendsto (windowWidth R) atTop (𝓝 0) := by
  apply tendsto_inv_atTop_zero.comp
  apply tendsto_natCast_atTop_atTop.comp
  exact tendsto_atTop_mono (fun n => by omega : ∀ n : ℕ, n ≤ R.sup id + n + 2) tendsto_id

private lemma windows_separated (R : Finset ℕ) (n : ℕ)
    {r q : ℕ} (hr : r ∈ R) (hrq : r < q) :
    (1 + windowWidth R n) * r < (q : ℝ) := by
  have hmax : r ≤ R.sup id := Finset.le_sup (f := id) hr
  have hden : (0 : ℝ) < (R.sup id + n + 2 : ℕ) := by positivity
  have hlt : (r : ℝ) < (R.sup id + n + 2 : ℕ) := by exact_mod_cast (by omega : r < R.sup id + n + 2)
  have hw : windowWidth R n * r < 1 := by
    unfold windowWidth
    simpa only [div_eq_mul_inv, mul_comm] using (div_lt_one hden).mpr hlt
  have hnext : (r : ℝ) + 1 ≤ q := by exact_mod_cast hrq
  nlinarith only [hw, hnext]

private lemma exists_windows (R : Finset ℕ) (hR : ∀ r ∈ R, 0 < r)
    {s d : ℝ} (hs : 0 < s) (hd : 0 < d) :
    ∃ N : ℕ → ℕ, ∃ A : ℕ → ℕ → Finset ℕ, ∀ n : ℕ,
      n + 1 ≤ N n ∧
      (∀ r ∈ R, (A n r).card = ⌈s * Real.sqrt ((r : ℝ) * clusterScale d (N n))⌉₊ ∧
        ∀ p ∈ A n r, p.Prime ∧ (r : ℝ) * clusterScale d (N n) < p ∧
          (p : ℝ) ≤ (1 + windowWidth R n) * ((r : ℝ) * clusterScale d (N n))) ∧
      Set.PairwiseDisjoint (↑R) (A n) := by
  have hex (n : ℕ) : ∃ k : ℕ, ∃ A : ℕ → Finset ℕ,
      n + 1 ≤ k ∧
      (∀ r ∈ R, (A r).card = ⌈s * Real.sqrt ((r : ℝ) * clusterScale d k)⌉₊ ∧
        ∀ p ∈ A r, p.Prime ∧ (r : ℝ) * clusterScale d k < p ∧
          (p : ℝ) ≤ (1 + windowWidth R n) * ((r : ℝ) * clusterScale d k)) ∧
      Set.PairwiseDisjoint (↑R) A := by
    have hc : ∀ᶠ k : ℕ in atTop, ∀ r ∈ R,
        ⌈s * Real.sqrt ((r : ℝ) * clusterScale d k)⌉₊ ≤
          (clusterWindow (windowWidth R n) ((r : ℝ) * clusterScale d k)).card := by
      apply (Filter.eventually_all_finset R).mpr
      intro r hr
      have hr0 : (0 : ℝ) < r := by exact_mod_cast hR r hr
      exact ((clusterScale_tendsto hd).const_mul_atTop hr0).eventually
        (cluster_capacity (windowWidth_pos R n) hs.le)
    obtain ⟨k, hk, hcap⟩ := ((eventually_ge_atTop (n + 1)).and hc).exists
    have ha (r : ℕ) : ∃ A : Finset ℕ, r ∈ R →
        A.card = ⌈s * Real.sqrt ((r : ℝ) * clusterScale d k)⌉₊ ∧
        ∀ p ∈ A, p.Prime ∧ (r : ℝ) * clusterScale d k < p ∧
          (p : ℝ) ≤ (1 + windowWidth R n) * ((r : ℝ) * clusterScale d k) := by
      by_cases hr : r ∈ R
      · obtain ⟨A, hsub, hcard⟩ := Finset.exists_subset_card_eq (hcap r hr)
        refine ⟨A, fun _ => ⟨hcard, fun p hp => ?_⟩⟩
        exact cluster_members (windowWidth_pos R n).le (by unfold clusterScale; positivity) (hsub hp)
      · exact ⟨∅, fun h => (hr h).elim⟩
    choose A hA using ha
    refine ⟨k, A, hk, hA, ?_⟩
    intro r hr q hq hrq
    apply Finset.disjoint_left.mpr
    intro p hp hp'
    have hpr := (hA r hr).2 p hp
    have hpq := (hA q hq).2 p hp'
    have hx : 0 < clusterScale d k := Real.exp_pos _
    rcases lt_or_gt_of_ne hrq with hrq | hqr
    · have hsep := mul_lt_mul_of_pos_right (windows_separated R n hr hrq) hx
      nlinarith only [hsep, hpr.2.2, hpq.2.1]
    · have hsep := mul_lt_mul_of_pos_right (windows_separated R n hq hqr) hx
      nlinarith only [hsep, hpq.2.2, hpr.2.1]
  choose N A h using hex
  exact ⟨N, A, h⟩

/-- Exponential generated by equal-mass prime clusters at the indicated
integer dilation phases. -/
def primeClusterExponent (R : Finset ℕ) (s frequency t : ℝ) : ℂ :=
  ∑ r ∈ R, -(s : ℂ) * Complex.exp ((-((frequency + Real.log r) * t) : ℝ) * Complex.I)

/-- Squared modulus of the simultaneous cluster exponential. -/
def primeClusterModel (R : Finset ℕ) (s frequency t : ℝ) : ℝ :=
  Real.exp (-2 * s * ∑ r ∈ R, Real.cos ((frequency + Real.log r) * t))

theorem norm_exp_primeClusterExponent_sq (R : Finset ℕ) (s frequency t : ℝ) :
    ‖Complex.exp (primeClusterExponent R s frequency t)‖ ^ 2 =
      primeClusterModel R s frequency t := by
  have hphase (θ : ℝ) : (Complex.exp ((θ : ℂ) * Complex.I)).re = Real.cos θ := by
    simp only [Complex.exp_re, Complex.mul_re, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero, mul_one,
      sub_zero, add_zero, Real.exp_zero, one_mul]
  have hreal : (primeClusterExponent R s frequency t).re =
      -s * ∑ r ∈ R, Real.cos ((frequency + Real.log r) * t) := by
    unfold primeClusterExponent
    rw [Complex.re_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro r _
    rw [Complex.mul_re]
    simp only [Complex.neg_re, Complex.neg_im, Complex.ofReal_re, Complex.ofReal_im,
      neg_zero, zero_mul, sub_zero, hphase, Real.cos_neg]
  rw [Complex.norm_exp, pow_two, ← Real.exp_add, hreal]
  unfold primeClusterModel
  congr 1
  ring

theorem norm_primeClusterExponent_le (R : Finset ℕ) {s : ℝ} (hs : 0 ≤ s)
    (frequency t : ℝ) :
    ‖primeClusterExponent R s frequency t‖ ≤ (R.card : ℝ) * s := by
  unfold primeClusterExponent
  apply (norm_sum_le _ _).trans_eq
  have hterm (r : ℕ) :
      ‖-(s : ℂ) * Complex.exp ((-((frequency + Real.log r) * t) : ℝ) * Complex.I)‖ = s := by
    rw [norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hs,
      Complex.norm_exp]
    simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, mul_zero, sub_zero, Real.exp_zero, mul_one]
  simp only [hterm, sum_const, nsmul_eq_mul]

/-- A finite collection of integer dilation phases is realized by disjoint
clusters of arbitrarily distant actual primes, with one bounded helper mass
and one global Euler bound for the whole sequence. -/
theorem exists_primeCluster_synthesis (R : Finset ℕ) (hne : R.Nonempty)
    (hR : ∀ r ∈ R, 0 < r) {s d : ℝ} (hs : 0 < s) (hd : 0 < d) :
    ∃ N : ℕ → ℕ, ∃ S : ℕ → Finset ℕ, ∃ C W : ℝ, 0 < C ∧ 0 < W ∧
      (∀ n, n + 1 ≤ N n) ∧
      (∀ n, (∑ p ∈ S n, (Real.sqrt p)⁻¹) ≤ W) ∧
      (∀ n, ∀ p ∈ S n, p.Prime ∧ clusterScale d (N n) < (p : ℝ)) ∧
      (∀ n (t : ℝ), ‖divisorCoreMellinEuler (S n) (1 + (t : ℂ) * Complex.I)‖ ≤ C) ∧
      (∀ n (t : ℝ), ‖Complex.exp (primeClusterExponent R s (2 * Real.pi * N n / d) t)‖ ≤ C) ∧
      ∀ t : ℝ, Tendsto (fun n =>
        ‖divisorCoreMellinEuler (S n) (1 + (t : ℂ) * Complex.I)‖ ^ 2 -
          primeClusterModel R s (2 * Real.pi * N n / d) t) atTop (𝓝 0) := by
  obtain ⟨N, A, hdata⟩ := exists_windows R hR hs hd
  let X : ℕ → ℝ := fun n => clusterScale d (N n)
  let S : ℕ → Finset ℕ := fun n => R.biUnion (A n)
  let W : ℝ := (R.card : ℝ) * (s + 1)
  have hcard : (0 : ℝ) < R.card := by exact_mod_cast Finset.card_pos.mpr hne
  have hW : 0 < W := by dsimp [W]; positivity
  have hN : Tendsto N atTop atTop := tendsto_atTop_mono
    (fun n => (Nat.le_succ n).trans (hdata n).1) tendsto_id
  have hX : Tendsto X atTop atTop := (clusterScale_tendsto hd).comp hN
  have hX1 (n : ℕ) : 1 ≤ X n := Real.one_le_exp (by positivity)
  have hXr (r : ℕ) (hr : r ∈ R) : Tendsto (fun n => (r : ℝ) * X n) atTop atTop :=
    hX.const_mul_atTop (by exact_mod_cast hR r hr)
  have hXr1 (r : ℕ) (hr : r ∈ R) (n : ℕ) : 1 ≤ (r : ℝ) * X n := by
    have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hR r hr
    nlinarith only [hr1, hX1 n]
  have ha (r : ℕ) (hr : r ∈ R) (n : ℕ) :
      (A n r).card = ⌈s * Real.sqrt ((r : ℝ) * X n)⌉₊ := (hdata n).2.1 r hr |>.1
  have hb (r : ℕ) (hr : r ∈ R) (n p : ℕ) (hp : p ∈ A n r) :
      (r : ℝ) * X n < p ∧
        (p : ℝ) ≤ (1 + windowWidth R n) * ((r : ℝ) * X n) :=
    ((hdata n).2.1 r hr).2 p hp |>.2
  have hsum (n : ℕ) (f : ℕ → ℝ) :
      (∑ p ∈ S n, f p) = ∑ r ∈ R, ∑ p ∈ A n r, f p :=
    Finset.sum_biUnion (hdata n).2.2
  have hmass (r : ℕ) (hr : r ∈ R) := cluster_mass_tendsto hs
    (windowWidth R) (fun n => (r : ℝ) * X n) (fun n => A n r)
    (fun n => (windowWidth_pos R n).le) (windowWidth_tendsto R)
    (hXr1 r hr) (hXr r hr) (ha r hr) (hb r hr)
  have hsquares (r : ℕ) (hr : r ∈ R) := cluster_squares_tendsto hs
    (windowWidth R) (fun n => (r : ℝ) * X n) (fun n => A n r)
    (fun n => (windowWidth_pos R n).le) (windowWidth_tendsto R)
    (hXr1 r hr) (hXr r hr) (ha r hr) (hb r hr)
  have hm : Tendsto (fun n => ∑ p ∈ S n, (Real.sqrt p)⁻¹) atTop
      (𝓝 ((R.card : ℝ) * s)) := by
    simpa only [hsum, sum_const, nsmul_eq_mul] using tendsto_finsetSum R hmass
  have hq : Tendsto (fun n => ∑ p ∈ S n, ((Real.sqrt p)⁻¹)^2) atTop (𝓝 0) := by
    simpa only [hsum, sum_const_zero] using tendsto_finsetSum R hsquares
  have hbound (n : ℕ) : (∑ p ∈ S n, (Real.sqrt p)⁻¹) ≤ W := by
    rw [hsum]
    calc
      _ ≤ ∑ _r ∈ R, (s + 1) := by
        apply Finset.sum_le_sum
        intro r hr
        have hi : 1 / Real.sqrt ((r : ℝ) * X n) ≤ 1 := by
          apply (div_le_one (Real.sqrt_pos.mpr (zero_lt_one.trans_le (hXr1 r hr n)))).mpr
          exact Real.one_le_sqrt.mpr (hXr1 r hr n)
        exact (cluster_weight_bounds (windowWidth_pos R n).le hs (hXr1 r hr n)
          (A n r) (ha r hr n) (hb r hr n)).2.trans (by linarith)
      _ = W := by simp only [sum_const, nsmul_eq_mul, W]
  have hpS (n p : ℕ) (hp : p ∈ S n) : p.Prime ∧ X n < (p : ℝ) := by
    obtain ⟨r, hr, hp⟩ := Finset.mem_biUnion.mp hp
    have h := ((hdata n).2.1 r hr).2 p hp
    have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hR r hr
    refine ⟨h.1, lt_of_le_of_lt ?_ h.2.1⟩
    nlinarith only [hr1, hX1 n]
  have hprod (n : ℕ) (t : ℝ) :
      ‖divisorCoreMellinEuler (S n) (1 + (t : ℂ) * Complex.I)‖ ≤ Real.exp W := by
    rw [cluster_euler_product (S n) (fun p hp => (hpS n p hp).1) t]
    have h := product_norm_bound (S n) (fun p => -primeWave p t)
    simp only [norm_neg, primeWave_norm, ← sub_eq_add_neg] at h
    exact h.trans (Real.exp_le_exp.mpr (hbound n))
  have hexp (n : ℕ) (t : ℝ) :
      ‖Complex.exp (primeClusterExponent R s (2 * Real.pi * N n / d) t)‖ ≤ Real.exp W := by
    apply (Complex.norm_exp_le_exp_norm _).trans
    apply Real.exp_le_exp.mpr
    exact (norm_primeClusterExponent_le R hs.le _ _).trans (by dsimp [W]; nlinarith only [hcard])
  refine ⟨N, S, Real.exp W, W, Real.exp_pos _, hW, fun n => (hdata n).1,
    hbound, hpS, hprod, hexp, ?_⟩
  intro t
  have hw (r : ℕ) (hr : r ∈ R) := cluster_wave_sum_tendsto hs
    (windowWidth R) (fun n => (r : ℝ) * X n) (fun n => A n r)
    (fun n => (windowWidth_pos R n).le) (windowWidth_tendsto R)
    (hXr1 r hr) (hXr r hr) (ha r hr) (hb r hr) t
  have hwave : Tendsto (fun n => (∑ p ∈ S n, -primeWave p t) -
      primeClusterExponent R s (2 * Real.pi * N n / d) t) atTop (𝓝 0) := by
    have h := (tendsto_finsetSum R hw).neg
    simp only [sum_const_zero, neg_zero] at h
    apply h.congr'
    filter_upwards with n
    rw [Finset.sum_biUnion (hdata n).2.2]
    unfold primeClusterExponent
    rw [← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro r hr
    have hr0 : (0 : ℝ) < r := by exact_mod_cast hR r hr
    have hx : Real.log (X n) = 2 * Real.pi * N n / d := Real.log_exp _
    rw [Real.log_mul hr0.ne' (by dsimp [X, clusterScale]; positivity : X n ≠ 0), hx, sum_neg_distrib]
    have he : -(t * (Real.log r + 2 * Real.pi * N n / d)) =
        -((2 * Real.pi * N n / d + Real.log r) * t) := by ring
    rw [he]
    ring
  have hsmall := cluster_product_exp_tendsto (S := S) (z := fun n p => -primeWave p t)
    (by simpa only [norm_neg, primeWave_norm] using hm)
    (by simpa only [norm_neg, primeWave_norm] using hq)
    (by
      intro n p hp
      rw [norm_neg, primeWave_norm]
      have hroot : 1 ≤ Real.sqrt p := Real.one_le_sqrt.mpr ((hX1 n).trans (hpS n p hp).2.le)
      exact inv_le_one_of_one_le₀ hroot)
  have hexpdiff := cluster_exp_difference_tendsto _ _ hwave
    (fun n => norm_primeClusterExponent_le R hs.le _ _)
  have htotal : Tendsto (fun n => divisorCoreMellinEuler (S n) (1 + (t : ℂ) * Complex.I) -
      Complex.exp (primeClusterExponent R s (2 * Real.pi * N n / d) t)) atTop (𝓝 0) := by
    have h := hsmall.add hexpdiff
    simp only [add_zero] at h
    apply h.congr'
    filter_upwards with n
    rw [cluster_euler_product (S n) (fun p hp => (hpS n p hp).1) t]
    simp only [sub_eq_add_neg]
    ring
  simpa only [norm_exp_primeClusterExponent_sq] using cluster_norm_sq_tendsto _ _ htotal
    (Eventually.of_forall (fun n => hprod n t)) (Eventually.of_forall (fun n => hexp n t))

end RHTower
