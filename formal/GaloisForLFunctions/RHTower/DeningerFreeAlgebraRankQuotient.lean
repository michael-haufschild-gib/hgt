import GaloisForLFunctions.RHTower.DeningerRankQuotient
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.MvPolynomial.Eval

/-!
# The free-algebra presentation of the rank quotient

The rank quotient is presented as a pushout against the free commutative algebra on the low-rank
fibre: the augmentation ideal of `Free(J)` pushes forward along the evaluation `aeval j` to exactly
the ideal generated by the image of `j`.

So the pushout description and the ideal description of the quotient agree in degree zero, which is
what makes the universal property of `DeningerRankQuotient.lean` the degree-zero shadow of the
free-`E_∞`-algebra pushout.

* `deningerAugmentationIdeal` : the augmentation ideal of the free commutative algebra.
* `deningerAugmentation_map_eq_rankIdeal` : **the pushout ideal is the rank ideal.**
-/

namespace RHTower

open MvPolynomial

section FreeAlgebraPresentation

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]

/-- The augmentation ideal of the free commutative algebra on the low-rank fibre. -/
noncomputable def deningerAugmentationIdeal (R : Type*) [CommRing R] (M : Type*) :
    Ideal (MvPolynomial M R) :=
  Ideal.span (Set.range (X : M → MvPolynomial M R))

/-- **The pushout ideal is the rank ideal.**  Evaluating the free algebra at the low-rank fibre
carries the augmentation ideal onto the ideal generated by the image. -/
theorem deningerAugmentation_map_eq_rankIdeal (j : M →ₗ[R] A) :
    Ideal.map (aeval (j : M → A) : MvPolynomial M R →ₐ[R] A).toRingHom
        (deningerAugmentationIdeal R M)
      = deningerRankIdeal j := by
  rw [deningerAugmentationIdeal, Ideal.map_span, deningerRankIdeal]
  congr 1
  ext a
  constructor
  · rintro ⟨_, ⟨m, rfl⟩, rfl⟩
    exact ⟨m, by simp⟩
  · rintro ⟨m, rfl⟩
    exact ⟨X m, ⟨m, rfl⟩, by simp⟩

end FreeAlgebraPresentation

end RHTower
