import GaloisForLFunctions.RHTower.InfiniteMobiusCriticalBoundaryLayer
import Mathlib.MeasureTheory.Measure.LevyConvergence
import Mathlib.Probability.ProbabilityMassFunction.Constructions
import Mathlib.Probability.ProbabilityMassFunction.Integrals
import Mathlib.Probability.Distributions.Exponential
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals

open Complex MeasureTheory Set Filter
open scoped BigOperators Topology ENNReal NNReal

noncomputable section

namespace RHTower

private def squarefreeMobiusCriticalPMFOf
    (sigma : ℝ) (hsigma : 1 < sigma) : PMF ℕ := by
  refine ⟨fun n => ENNReal.ofReal (squarefreeMobiusProbability sigma n), ?_⟩
  apply ENNReal.hasSum_coe.mpr
  rw [← ENNReal.toNNReal_one]
  have hsum : HasSum (squarefreeMobiusProbability sigma) 1 := by
    rw [← tsum_squarefreeMobiusProbability hsigma]
    exact (summable_squarefreeMobiusProbability hsigma).hasSum
  simpa using hsum.toNNReal (squarefreeMobiusProbability_nonneg hsigma)

/-- The squarefree probability mass function, extended harmlessly away from its natural
half-plane so it can be used as a filter-indexed family. -/
def squarefreeMobiusCriticalPMF (sigma : ℝ) : PMF ℕ :=
  if hsigma : 1 < sigma then squarefreeMobiusCriticalPMFOf sigma hsigma else PMF.pure 1

theorem squarefreeMobiusCriticalPMF_toReal
    {sigma : ℝ} (hsigma : 1 < sigma) (n : ℕ) :
    (squarefreeMobiusCriticalPMF sigma n).toReal =
      squarefreeMobiusProbability sigma n := by
  rw [squarefreeMobiusCriticalPMF, dif_pos hsigma]
  change (ENNReal.ofReal (squarefreeMobiusProbability sigma n)).toReal = _
  rw [ENNReal.toReal_ofReal (squarefreeMobiusProbability_nonneg hsigma n)]

/-- The rescaled logarithmic squarefree clock. -/
def squarefreeMobiusCriticalClock (sigma : ℝ) (n : ℕ) : ℝ :=
  (sigma - 1) * Real.log n

/-- The squarefree critical clock as a genuine Borel probability measure. -/
def squarefreeMobiusCriticalClockProbabilityMeasure (sigma : ℝ) : ProbabilityMeasure ℝ :=
  ProbabilityMeasure.map
    (⟨(squarefreeMobiusCriticalPMF sigma).toMeasure, inferInstance⟩ : ProbabilityMeasure ℕ)
    (Measurable.of_discrete.aemeasurable :
      AEMeasurable (squarefreeMobiusCriticalClock sigma)
        (squarefreeMobiusCriticalPMF sigma).toMeasure)

/-- The unit-rate exponential law selected by the squarefree critical clock. -/
def mobiusCriticalExponentialProbabilityMeasure : ProbabilityMeasure ℝ :=
  ⟨ProbabilityTheory.expMeasure 1,
    ProbabilityTheory.isProbabilityMeasure_expMeasure (by norm_num)⟩

theorem integrable_squarefreeMobiusCriticalClock_char
    (sigma t : ℝ) :
    Integrable
      (fun n : ℕ =>
        Complex.exp (((t * squarefreeMobiusCriticalClock sigma n : ℝ) : ℂ) *
          Complex.I))
      (squarefreeMobiusCriticalPMF sigma).toMeasure := by
  refine (integrable_const (1 : ℝ)).mono' Measurable.of_discrete.aestronglyMeasurable ?_
  filter_upwards with n
  rw [Complex.norm_exp]
  simp [Complex.mul_re]

/-- The characteristic function of the squarefree clock is its normalized Dirichlet phase
series. -/
theorem charFun_squarefreeMobiusCriticalClockProbabilityMeasure_eq_tsum
    {sigma : ℝ} (hsigma : 1 < sigma) (t : ℝ) :
    charFun (squarefreeMobiusCriticalClockProbabilityMeasure sigma : Measure ℝ) t =
      ∑' n : ℕ,
        (squarefreeMobiusProbability sigma n : ℂ) *
          Complex.exp (((t * squarefreeMobiusCriticalClock sigma n : ℝ) : ℂ) *
            Complex.I) := by
  rw [charFun_apply_real]
  unfold squarefreeMobiusCriticalClockProbabilityMeasure ProbabilityMeasure.map
  simp only [ProbabilityMeasure.coe_mk]
  rw [integral_map Measurable.of_discrete.aemeasurable (by fun_prop)]
  have hint : Integrable
      (fun n : ℕ =>
        Complex.exp ((t : ℂ) * (squarefreeMobiusCriticalClock sigma n : ℂ) *
          Complex.I))
      (squarefreeMobiusCriticalPMF sigma).toMeasure := by
    convert integrable_squarefreeMobiusCriticalClock_char sigma t using 1
    funext n
    push_cast
    rfl
  rw [PMF.integral_eq_tsum _ _ hint]
  apply tsum_congr
  intro n
  rw [squarefreeMobiusCriticalPMF_toReal hsigma]
  change (squarefreeMobiusProbability sigma n : ℂ) * _ = _
  congr 2
  push_cast
  rfl

/-- Complex Dirichlet parameter generated by the critical characteristic phase. -/
def squarefreeMobiusCriticalClockParameter (sigma t : ℝ) : ℂ :=
  (sigma : ℂ) - ((t * (sigma - 1) : ℝ) : ℂ) * Complex.I

theorem squarefreeMobiusCriticalClockParameter_re (sigma t : ℝ) :
    (squarefreeMobiusCriticalClockParameter sigma t).re = sigma := by
  simp [squarefreeMobiusCriticalClockParameter]

/-- Exact zeta-ratio form of the squarefree clock characteristic function. -/
theorem charFun_squarefreeMobiusCriticalClockProbabilityMeasure_eq_zetaRatio
    {sigma : ℝ} (hsigma : 1 < sigma) (t : ℝ) :
    charFun (squarefreeMobiusCriticalClockProbabilityMeasure sigma : Measure ℝ) t =
      (riemannZeta (squarefreeMobiusCriticalClockParameter sigma t) /
          riemannZeta (2 * squarefreeMobiusCriticalClockParameter sigma t)) /
        (squarefreeMobiusTotal sigma : ℂ) := by
  rw [charFun_squarefreeMobiusCriticalClockProbabilityMeasure_eq_tsum hsigma]
  have hterm : ∀ n : ℕ,
      (squarefreeMobiusProbability sigma n : ℂ) *
          Complex.exp (((t * squarefreeMobiusCriticalClock sigma n : ℝ) : ℂ) *
            Complex.I) =
        (if Squarefree n then
            1 / (n : ℂ) ^ squarefreeMobiusCriticalClockParameter sigma t else 0) /
          (squarefreeMobiusTotal sigma : ℂ) := by
    intro n
    rw [squarefreeMobiusProbability, Complex.ofReal_div,
      ofReal_squarefreeMobiusMass_eq]
    split_ifs with hsq
    · have hn : n ≠ 0 := by
        intro hn
        subst n
        exact not_squarefree_zero hsq
      have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn
      have hlog : Complex.log (n : ℂ) = ((Real.log n : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast n, ← Complex.ofReal_log (by positivity)]
      have hcpow : ∀ w : ℂ,
          (n : ℂ) ^ w = Complex.exp (((Real.log n : ℝ) : ℂ) * w) := by
        intro w
        rw [Complex.cpow_def_of_ne_zero hnC, hlog]
      rw [div_mul_eq_mul_div]
      congr 1
      rw [hcpow, hcpow, div_eq_mul_inv, div_eq_mul_inv,
        ← Complex.exp_neg, ← Complex.exp_neg]
      simp only [one_mul]
      rw [← Complex.exp_add]
      congr 1
      unfold squarefreeMobiusCriticalClockParameter squarefreeMobiusCriticalClock
      push_cast
      ring
    · simp
  rw [show (∑' n : ℕ,
      (squarefreeMobiusProbability sigma n : ℂ) *
        Complex.exp (((t * squarefreeMobiusCriticalClock sigma n : ℝ) : ℂ) *
          Complex.I)) =
      ∑' n : ℕ,
        (if Squarefree n then
            1 / (n : ℂ) ^ squarefreeMobiusCriticalClockParameter sigma t else 0) /
          (squarefreeMobiusTotal sigma : ℂ) by
    exact tsum_congr hterm]
  rw [tsum_div_const,
    tsum_squarefree_cpow (by simpa [squarefreeMobiusCriticalClockParameter_re] using hsigma)]

/-- Pointwise critical limit of the squarefree clock characteristic function. -/
theorem tendsto_charFun_squarefreeMobiusCriticalClockProbabilityMeasure
    (t : ℝ) :
    Tendsto
      (fun sigma : ℝ =>
        charFun (squarefreeMobiusCriticalClockProbabilityMeasure sigma : Measure ℝ) t)
      (nhdsWithin 1 (Ioi 1))
      (nhds ((1 - (t : ℂ) * Complex.I)⁻¹)) := by
  let q : ℂ := 1 - (t : ℂ) * Complex.I
  have hq : q ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    simp [q, Complex.mul_re] at this
  have hsigma : Tendsto (fun sigma : ℝ => (sigma : ℂ))
      (nhdsWithin 1 (Ioi 1)) (nhds (1 : ℂ)) :=
    Complex.continuous_ofReal.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
  have hparamReal : Tendsto
      (fun sigma : ℝ => squarefreeMobiusCriticalClockParameter sigma t)
      (nhdsWithin 1 (Ioi 1)) (nhds (1 : ℂ)) := by
    have hcont : ContinuousAt
        (fun sigma : ℝ => squarefreeMobiusCriticalClockParameter sigma t) 1 := by
      unfold squarefreeMobiusCriticalClockParameter
      fun_prop
    simpa [squarefreeMobiusCriticalClockParameter] using
      hcont.tendsto.mono_left nhdsWithin_le_nhds
  have htwoSigma : Tendsto (fun sigma : ℝ => 2 * (sigma : ℂ))
      (nhdsWithin 1 (Ioi 1)) (nhds (2 : ℂ)) := by
    simpa using (tendsto_const_nhds.mul hsigma :
      Tendsto (fun sigma : ℝ => (2 : ℂ) * (sigma : ℂ))
        (nhdsWithin 1 (Ioi 1)) (nhds ((2 : ℂ) * 1)))
  have htwoParam : Tendsto
      (fun sigma : ℝ => 2 * squarefreeMobiusCriticalClockParameter sigma t)
      (nhdsWithin 1 (Ioi 1)) (nhds (2 : ℂ)) := by
    simpa using (tendsto_const_nhds.mul hparamReal :
      Tendsto
        (fun sigma : ℝ => (2 : ℂ) *
          squarefreeMobiusCriticalClockParameter sigma t)
        (nhdsWithin 1 (Ioi 1)) (nhds ((2 : ℂ) * 1)))
  have hzetaTwoSigma : Tendsto
      (fun sigma : ℝ => riemannZeta (2 * (sigma : ℂ)))
      (nhdsWithin 1 (Ioi 1)) (nhds (riemannZeta (2 : ℂ))) :=
    (differentiableAt_riemannZeta (by norm_num : (2 : ℂ) ≠ 1)).continuousAt.tendsto.comp
      htwoSigma
  have hzetaTwoParam : Tendsto
      (fun sigma : ℝ =>
        riemannZeta (2 * squarefreeMobiusCriticalClockParameter sigma t))
      (nhdsWithin 1 (Ioi 1)) (nhds (riemannZeta (2 : ℂ))) :=
    (differentiableAt_riemannZeta (by norm_num : (2 : ℂ) ≠ 1)).continuousAt.tendsto.comp
      htwoParam
  have hunitSigma : Tendsto
      (fun sigma : ℝ => zetaResidueUnit (sigma : ℂ))
      (nhdsWithin 1 (Ioi 1)) (nhds (1 : ℂ)) := by
    simpa using zetaResidueUnit_analyticAt.continuousAt.tendsto.comp hsigma
  have hunitParam : Tendsto
      (fun sigma : ℝ =>
        zetaResidueUnit (squarefreeMobiusCriticalClockParameter sigma t))
      (nhdsWithin 1 (Ioi 1)) (nhds (1 : ℂ)) := by
    simpa using zetaResidueUnit_analyticAt.continuousAt.tendsto.comp hparamReal
  have hzetaTwo : riemannZeta (2 : ℂ) ≠ 0 :=
    riemannZeta_ne_zero_of_one_lt_re (by norm_num)
  have hregularized : Tendsto
      (fun sigma : ℝ =>
        zetaResidueUnit (squarefreeMobiusCriticalClockParameter sigma t) *
            riemannZeta (2 * (sigma : ℂ)) /
          ((zetaResidueUnit (sigma : ℂ) *
              riemannZeta (2 * squarefreeMobiusCriticalClockParameter sigma t)) * q))
      (nhdsWithin 1 (Ioi 1)) (nhds q⁻¹) := by
    have h := (hunitParam.mul hzetaTwoSigma).div
      ((hunitSigma.mul hzetaTwoParam).mul_const q)
      (mul_ne_zero (mul_ne_zero one_ne_zero hzetaTwo) hq)
    simpa [q, hq] using h
  apply hregularized.congr'
  filter_upwards [self_mem_nhdsWithin] with sigma hsigmaGt
  change 1 < sigma at hsigmaGt
  have hsigOne : sigma ≠ 1 := ne_of_gt hsigmaGt
  have hparamGt :
      1 < (squarefreeMobiusCriticalClockParameter sigma t).re := by
    simpa [squarefreeMobiusCriticalClockParameter_re] using hsigmaGt
  have hparamOne : squarefreeMobiusCriticalClockParameter sigma t ≠ 1 := by
    intro h
    have := congrArg Complex.re h
    simp [squarefreeMobiusCriticalClockParameter_re] at this
    linarith
  have htwoSigGt : 1 < (2 * (sigma : ℂ)).re := by
    norm_num
    linarith
  have htwoParamGt :
      1 < (2 * squarefreeMobiusCriticalClockParameter sigma t).re := by
    rw [two_mul_re, squarefreeMobiusCriticalClockParameter_re]
    linarith
  rw [charFun_squarefreeMobiusCriticalClockProbabilityMeasure_eq_zetaRatio hsigmaGt,
    ofReal_squarefreeMobiusTotal_eq_zetaRatio hsigmaGt]
  have hunitSig : zetaResidueUnit (sigma : ℂ) =
      ((sigma : ℂ) - 1) * riemannZeta (sigma : ℂ) := by
    rw [zetaResidueUnit, Function.update_of_ne (by exact_mod_cast hsigOne)]
  have hunitPar :
      zetaResidueUnit (squarefreeMobiusCriticalClockParameter sigma t) =
        (squarefreeMobiusCriticalClockParameter sigma t - 1) *
          riemannZeta (squarefreeMobiusCriticalClockParameter sigma t) := by
    rw [zetaResidueUnit, Function.update_of_ne hparamOne]
  rw [hunitSig, hunitPar]
  have hsigOneC : (sigma : ℂ) - 1 ≠ 0 :=
    sub_ne_zero.mpr (by exact_mod_cast hsigOne)
  have hparamOneC :
      squarefreeMobiusCriticalClockParameter sigma t - 1 ≠ 0 :=
    sub_ne_zero.mpr hparamOne
  field_simp [hq, hsigOneC, hparamOneC,
    riemannZeta_ne_zero_of_one_lt_re (by simpa using hsigmaGt),
    riemannZeta_ne_zero_of_one_lt_re hparamGt,
    riemannZeta_ne_zero_of_one_lt_re htwoSigGt,
    riemannZeta_ne_zero_of_one_lt_re htwoParamGt]
  unfold squarefreeMobiusCriticalClockParameter q
  push_cast
  ring

end RHTower
