import GaloisForLFunctions.HTGeometry.ProjectiveHorizonComplementarity
import GaloisForLFunctions.HTGeometry.ReflectedChannelProjectiveFlow
import GaloisForLFunctions.HTGeometry.UpperEndDifferentialInstances
import GaloisForLFunctions.HTGeometry.ScalarFiniteDifferentialTorsor
import GaloisForLFunctions.RHTower.XiCTaylorThetaTailCompletedDensityTransversePick
import GaloisForLFunctions.RHTower.XiHypertranscendenceUnconditional

/-!
# Ramified differential orientation for completed Xi

This file records two exact and deliberately separate specializations of the scalar-orientation
law.

First, the actual rotated completed-Xi carrier remains hypertranscendental after squaring, and
its square has exactly the same logarithmic-current differential field. Thus the sign quotient
loses no differential-current or hypertranscendence information.

Second, the source-selected completed-theta pair has a local odd Cayley coordinate. The sharp
involution reverses that coordinate. At every noncentral Xi zero in the open upper theta strip,
the coordinate is regular and vanishes: the Xi divisor is the ramification locus of this local
reflection quotient.

No assertion that the theta Cayley coordinate is hypertranscendental is made.
-/

open Complex
open scoped Differential

namespace RHTower

open GaloisForLFunctions GaloisForLFunctions.HTGeometry
open scoped UpperEndDifferentialInstances

noncomputable section

/-! ## Completed-Xi square and logarithmic-current conservation -/

/-- The actual rotated completed-Xi carrier is nonzero in the upper-end meromorphic field. -/
theorem xiRotatedUpperEndCarrier_ne_zero :
    xiRotatedUpperEndCarrier ≠ 0 := by
  simpa only [differentialJet_zero] using
    (hypertranscendentalOver_differentialJet_ne_zero
      xiRotatedUpperEndCarrier_hypertranscendentalOver 0)

/-- Squaring the actual completed-Xi carrier preserves hypertranscendence over the rational
coordinate field. -/
theorem xiRotatedUpperEndCarrier_sq_hypertranscendentalOver :
    HypertranscendentalOver upperEndRationalCoordinateField
      (xiRotatedUpperEndCarrier ^ 2) :=
  HTGeometry.hypertranscendentalOver_pow_of_pos
    xiRotatedUpperEndCarrier_hypertranscendentalOver (by norm_num)

/-- The logarithmic-current differential field of completed Xi is unchanged by squaring. -/
theorem differentialAdjoin_logDeriv_xiRotatedUpperEndCarrier_sq_eq :
    differentialAdjoin upperEndRationalCoordinateField
        ({Differential.logDeriv (xiRotatedUpperEndCarrier ^ 2)} :
          Set upperEndMeroField) =
      differentialAdjoin upperEndRationalCoordinateField
        ({Differential.logDeriv xiRotatedUpperEndCarrier} :
          Set upperEndMeroField) :=
  HTGeometry.differentialAdjoin_logDeriv_pow_eq
    xiRotatedUpperEndCarrier_ne_zero (by norm_num)

/-- Exact square-coordinate reconstruction: the differential field generated by squared
completed Xi is the ordinary field obtained from the Xi logarithmic-current field by adjoining
the one squared amplitude coordinate. -/
theorem differentialAdjoin_xiRotatedUpperEndCarrier_sq_eq_current_adjoin_sq :
    differentialAdjoin upperEndRationalCoordinateField
        ({xiRotatedUpperEndCarrier ^ 2} : Set upperEndMeroField) =
      IntermediateField.adjoin upperEndRationalCoordinateField
        (((differentialAdjoin upperEndRationalCoordinateField
          ({Differential.logDeriv xiRotatedUpperEndCarrier} :
            Set upperEndMeroField) :
              IntermediateField upperEndRationalCoordinateField upperEndMeroField) :
            Set upperEndMeroField) ∪
          {xiRotatedUpperEndCarrier ^ 2}) :=
  HTGeometry.differentialAdjoin_pow_eq_logCurrentOrdinaryExtension
    xiRotatedUpperEndCarrier_ne_zero (by norm_num)

/-! ## Source-selected local reflection coordinate -/

/-- Odd Cayley coordinate of the source-selected completed-theta pair. -/
def thetaCuspTailSecondDensityReflectionOddCoordinate (z : ℂ) : ℂ :=
  HTGeometry.reflectedChannelOddCoordinate
    thetaCuspTailSecondDensityDeBrangesE
    thetaCuspTailSecondDensityDeBrangesESharp z

/-- The sharp transform exchanges the two completed-theta channels in the reverse direction. -/
theorem thetaCuspTailSecondDensityDeBrangesESharp_sharp
    {z : ℂ} (hz : |z.im| < 1) :
    (starRingEnd ℂ)
        (thetaCuspTailSecondDensityDeBrangesESharp ((starRingEnd ℂ) z)) =
      thetaCuspTailSecondDensityDeBrangesE z := by
  have hzconj : |((starRingEnd ℂ) z).im| < 1 := by
    simpa only [conj_im, abs_neg] using hz
  have h := thetaCuspTailSecondDensityDeBrangesE_sharp (z := (starRingEnd ℂ) z) hzconj
  have hc := congrArg (starRingEnd ℂ) h
  simpa only [Complex.conj_conj] using hc.symm

/-- The actual completed-theta sharp involution reverses the local Cayley orientation. -/
theorem thetaCuspTailSecondDensityReflectionOddCoordinate_sharp
    {z : ℂ} (hz : |z.im| < 1) :
    (starRingEnd ℂ)
        (thetaCuspTailSecondDensityReflectionOddCoordinate
          ((starRingEnd ℂ) z)) =
      -thetaCuspTailSecondDensityReflectionOddCoordinate z := by
  unfold thetaCuspTailSecondDensityReflectionOddCoordinate
    HTGeometry.reflectedChannelOddCoordinate
  rw [map_div₀, map_add, map_sub,
    thetaCuspTailSecondDensityDeBrangesE_sharp hz,
    thetaCuspTailSecondDensityDeBrangesESharp_sharp hz]
  rw [show thetaCuspTailSecondDensityDeBrangesESharp z -
      thetaCuspTailSecondDensityDeBrangesE z =
        -(thetaCuspTailSecondDensityDeBrangesE z -
          thetaCuspTailSecondDensityDeBrangesESharp z) by ring,
    div_neg]
  ring

/-- At an upper-strip Xi zero, the odd-coordinate denominator is nonzero. The source-selected
zero-free channel removes the possible chart singularity. -/
theorem thetaCuspTailSecondDensityReflectionOddCoordinate_den_ne_zero_at_XiC_zero
    {z : ℂ} (hz : 0 < z.im) (hz1 : z.im < 1) (hXi : XiC z = 0) :
    thetaCuspTailSecondDensityDeBrangesE z -
        thetaCuspTailSecondDensityDeBrangesESharp z ≠ 0 := by
  have hzstrip : |z.im| < 1 := by
    rw [abs_of_pos hz]
    exact hz1
  have hsum := thetaCuspTailSecondDensityDeBrangesE_add_sharp hzstrip
  rw [hXi, mul_zero] at hsum
  have hsharp :
      thetaCuspTailSecondDensityDeBrangesESharp z =
        -thetaCuspTailSecondDensityDeBrangesE z := by
    linear_combination hsum
  rw [hsharp, sub_neg_eq_add, ← two_mul]
  exact mul_ne_zero two_ne_zero
    (thetaCuspTailSecondDensityDeBrangesE_ne_zero hz)

/-- On every regular noncentral theta chart, the odd coordinate vanishes exactly on the Xi
divisor. -/
theorem thetaCuspTailSecondDensityReflectionOddCoordinate_eq_zero_iff
    {z : ℂ} (hzstrip : |z.im| < 1) (hz0 : z ≠ 0)
    (hden : thetaCuspTailSecondDensityDeBrangesE z -
      thetaCuspTailSecondDensityDeBrangesESharp z ≠ 0) :
    thetaCuspTailSecondDensityReflectionOddCoordinate z = 0 ↔ XiC z = 0 := by
  rw [thetaCuspTailSecondDensityReflectionOddCoordinate,
    HTGeometry.reflectedChannelOddCoordinate_eq_zero_iff hden,
    thetaCuspTailSecondDensityDeBrangesE_add_sharp hzstrip]
  constructor
  · intro h
    exact (mul_eq_zero.mp h).resolve_left
      (mul_ne_zero (by norm_num) (pow_ne_zero 2 hz0))
  · intro h
    rw [h, mul_zero]

/-- Every upper-strip Xi zero is a regular zero of the source-selected odd reflection
coordinate. -/
theorem thetaCuspTailSecondDensityReflectionOddCoordinate_eq_zero_at_XiC_zero
    {z : ℂ} (hz : 0 < z.im) (hz1 : z.im < 1) (hXi : XiC z = 0) :
    thetaCuspTailSecondDensityReflectionOddCoordinate z = 0 := by
  have hzstrip : |z.im| < 1 := by
    rw [abs_of_pos hz]
    exact hz1
  have hz0 : z ≠ 0 := by
    intro h
    subst z
    simp at hz
  exact
    (thetaCuspTailSecondDensityReflectionOddCoordinate_eq_zero_iff
      hzstrip hz0
        (thetaCuspTailSecondDensityReflectionOddCoordinate_den_ne_zero_at_XiC_zero
          hz hz1 hXi)).2 hXi

end

end RHTower
