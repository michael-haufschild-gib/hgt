import GaloisForLFunctions.RHTower.PrimeGammaSignedEulerianCurvaturePluckerLift
import GaloisForLFunctions.RHTower.RoutePPrimitiveBaseCauchyCapacityReduction

/-!
# Cauchy-cubic four-label curvature retained by the prime--Gamma source

The zero-ordinate Route-P base kernel is the real Cauchy-cubic kernel
`2 / (x + y)^(3 : ℕ)`.  Unlike the commutative physical word coefficient, this pair-incidence kernel
has strictly positive four-label signed-Eulerian curvature on every strictly ordered positive
four-packet.  Positive diagonal source transports preserve that curvature exactly.

This proves the positive survivor exposed by the scalar-word blindness no-go: the P-G186
off-diagonal source has enough descent-bottom incidence for the finite Pluecker pencil.  It does
not construct the still-missing map from this incidence to completed signed-word columns or a
type-B insertion action.
-/

namespace GaloisForLFunctions.HTGeometry

open _root_.RHTower

noncomputable section

/-- Real zero-ordinate Cauchy-cubic edge underlying the Route-P primitive base kernel. -/
def primeGammaCauchyCubicEdge (x y : ℝ) : ℝ := 2 / (x + y) ^ (3 : ℕ)

/-- Strict four-label curvature of the Cauchy-cubic edge on an ordered positive packet. -/
theorem primeGammaCauchyCubic_fourLabelCurvature_pos
    {a b c d : ℝ} (ha : 0 < a) (hab : a < b) (hbc : b < c) (hcd : c < d) :
    0 < primeGammaCauchyCubicEdge c a * primeGammaCauchyCubicEdge d b -
      primeGammaCauchyCubicEdge c b * primeGammaCauchyCubicEdge d a := by
  let X : ℝ := (c + a) * (d + b)
  let Y : ℝ := (c + b) * (d + a)
  have hc : 0 < c := ha.trans (hab.trans hbc)
  have hd : 0 < d := hc.trans hcd
  have hb : 0 < b := ha.trans hab
  have hX : 0 < X := by
    exact mul_pos (add_pos hc ha) (add_pos hd hb)
  have hY : 0 < Y := by
    exact mul_pos (add_pos hc hb) (add_pos hd ha)
  have hfac : 0 < (d - c) * (b - a) := mul_pos (by linarith) (by linarith)
  have hXY : X < Y := by
    dsimp [X, Y]
    nlinarith
  have hpows : 0 < Y ^ (3 : ℕ) - X ^ (3 : ℕ) := by
    rw [show Y ^ (3 : ℕ) - X ^ (3 : ℕ) = (Y - X) * (Y ^ (2 : ℕ) + Y * X + X ^ (2 : ℕ)) by ring]
    apply mul_pos (by linarith)
    positivity
  have hleft : primeGammaCauchyCubicEdge c a * primeGammaCauchyCubicEdge d b =
      4 / X ^ (3 : ℕ) := by
    unfold primeGammaCauchyCubicEdge
    dsimp [X]
    field_simp
    ring
  have hright : primeGammaCauchyCubicEdge c b * primeGammaCauchyCubicEdge d a =
      4 / Y ^ (3 : ℕ) := by
    unfold primeGammaCauchyCubicEdge
    dsimp [Y]
    field_simp
    ring
  rw [hleft, hright]
  have hrewrite : 4 / X ^ (3 : ℕ) - 4 / Y ^ (3 : ℕ) =
      4 * (Y ^ (3 : ℕ) - X ^ (3 : ℕ)) / (X ^ (3 : ℕ) * Y ^ (3 : ℕ)) := by
    field_simp [hX.ne', hY.ne']
  rw [hrewrite]
  exact div_pos (mul_pos (by norm_num) hpows)
    (mul_pos (pow_pos hX 3) (pow_pos hY 3))

/-- Cauchy-cubic descent kernel generated by a source coordinate. -/
def primeGammaCauchyCubicDescentKernel (x : ℕ → ℝ) : ℕ → ℕ → ℝ :=
  fun c a => primeGammaCauchyCubicEdge (x c) (x a)

/-- The P-G186 Cauchy-cubic incidence has nonzero signed-Eulerian curvature on every ordered
positive four-label source coordinate. -/
theorem signedEulerianFourLabelCurvature_primeGammaCauchyCubic_pos
    (x : ℕ → ℝ) (hx0 : 0 < x 1) (hx12 : x 1 < x 2)
    (hx23 : x 2 < x 3) (hx34 : x 3 < x 4) :
    0 < signedEulerianFourLabelCurvature (primeGammaCauchyCubicDescentKernel x) := by
  simpa [signedEulerianFourLabelCurvature, primeGammaCauchyCubicDescentKernel] using
    primeGammaCauchyCubic_fourLabelCurvature_pos hx0 hx12 hx23 hx34

/-- Positive diagonal source transports of the Cauchy-cubic kernel. -/
def primeGammaDiagonalCauchyCubicDescentKernel
    (w x : ℕ → ℝ) : ℕ → ℕ → ℝ :=
  fun c a => w c * primeGammaCauchyCubicEdge (x c) (x a) * w a

/-- Exact diagonal transport law for the first signed-Eulerian curvature minor. -/
theorem signedEulerianFourLabelCurvature_primeGammaDiagonalCauchyCubic_factor
    (w x : ℕ → ℝ) :
    signedEulerianFourLabelCurvature (primeGammaDiagonalCauchyCubicDescentKernel w x) =
      (w 3 * w 4 * w 1 * w 2) *
        signedEulerianFourLabelCurvature (primeGammaCauchyCubicDescentKernel x) := by
  simp only [signedEulerianFourLabelCurvature, primeGammaDiagonalCauchyCubicDescentKernel,
    primeGammaCauchyCubicDescentKernel]
  ring

/-- Every positive diagonal prime--Gamma source transport retains strictly positive four-label
curvature. -/
theorem signedEulerianFourLabelCurvature_primeGammaDiagonalCauchyCubic_pos
    (w x : ℕ → ℝ) (hw : ∀ n, 0 < w n)
    (hx0 : 0 < x 1) (hx12 : x 1 < x 2)
    (hx23 : x 2 < x 3) (hx34 : x 3 < x 4) :
    0 < signedEulerianFourLabelCurvature
      (primeGammaDiagonalCauchyCubicDescentKernel w x) := by
  rw [signedEulerianFourLabelCurvature_primeGammaDiagonalCauchyCubic_factor]
  exact mul_pos
    (mul_pos (mul_pos (mul_pos (hw 3) (hw 4)) (hw 1)) (hw 2))
    (signedEulerianFourLabelCurvature_primeGammaCauchyCubic_pos x hx0 hx12 hx23 hx34)

/-- The Route-P zero-ordinate base kernel is exactly the complexification of the real
Cauchy-cubic source edge. -/
theorem routePBaseCauchyCubicKernel_one_zero_eq_primeGammaCauchyCubicEdge
    (x y : ℝ) :
    routePBaseCauchyCubicKernel 1 x y 0 =
      (primeGammaCauchyCubicEdge x y : ℂ) := by
  unfold routePBaseCauchyCubicKernel routePCollisionPairFrequency primeGammaCauchyCubicEdge
  push_cast
  norm_num

/-- The curvature-preserving Pluecker pencil of every positive diagonal Cauchy-cubic source
packet is nonzero throughout the open upper half-plane. -/
theorem det_signedEulerian_primeGammaDiagonalCauchyCubic_ne_zero_of_im_pos
    (w x : ℕ → ℝ) (hw : ∀ n, 0 < w n)
    (hx0 : 0 < x 1) (hx12 : x 1 < x 2)
    (hx23 : x 2 < x 3) (hx34 : x 3 < x 4)
    {z u : ℂ} (hz : 0 < z.im) (hu : 0 < u.im) :
    (curvaturePluckerPencil
      (primeGammaDiagonalCauchyCubicDescentKernel w x 3 1)
      (primeGammaDiagonalCauchyCubicDescentKernel w x 3 2)
      (primeGammaDiagonalCauchyCubicDescentKernel w x 4 1)
      (primeGammaDiagonalCauchyCubicDescentKernel w x 4 2) z u).det ≠ 0 := by
  apply det_curvaturePluckerPencil_ne_zero_of_im_pos
  · rw [← signedEulerianFourLabelCurvature_eq_curvatureMinor]
    exact (signedEulerianFourLabelCurvature_primeGammaDiagonalCauchyCubic_pos
      w x hw hx0 hx12 hx23 hx34).ne'
  · exact hz
  · exact hu

end

end GaloisForLFunctions.HTGeometry
