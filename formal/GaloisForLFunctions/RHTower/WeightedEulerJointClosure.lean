import GaloisForLFunctions.RHTower.WeightedEulerCarrierVanishing
import GaloisForLFunctions.HTGeometry.CarrierAnnihilatesHolomorphic
import GaloisForLFunctions.HTGeometry.JointDenseOfVanishingDual

/-!
# The weighted Euler joint graph is dense in the product

A continuous functional pair annihilating the finite-support joint graph of weighted prime
coordinate masses and symmetrised Euler tangents is zero: the analytic component is carried by a
rectangle inside the critical quadrant, its Cauchy transform vanishes off that rectangle, and the
rectangle Cauchy formula then kills it on every holomorphic function.  The joint graph is therefore
dense in the product of the weighted coefficient space and the quadrant's holomorphic space.

* `RHTower.weightedEuler_helim`;
* `RHTower.topologicalClosure_primeQuadrantGraph_eq_top'`.
-/

noncomputable section

open Complex Set

namespace RHTower

open GaloisForLFunctions.HTGeometry
open _root_.HTGeometry

/-- **The analytic component of an annihilating pair vanishes.** -/
theorem weightedEuler_helim (f₁ : PrimeTangent →L[ℝ] ℝ) (f₂ : holoQuadrant →L[ℝ] ℝ)
    (hgr : ∀ p : Nat.Primes, f₁ (primeTangentGen p) + f₂ (eulerTangentElement p) = 0) :
    ∀ y : holoQuadrant, f₂ y = 0 := by
  obtain ⟨D⟩ := exists_quadrantCarrierData f₂
  intro y
  obtain ⟨G, hG, hGy⟩ := y.2
  set a' : ℝ := (1 / 2 + D.a) / 2 with ha'
  set b' : ℝ := (D.b + 1) / 2 with hb'
  set c' : ℝ := D.c / 2 with hc'
  set d' : ℝ := D.d + 1 with hd'
  have ha'a : a' < D.a := by rw [ha']; linarith [D.ha]
  have hhalf : 1 / 2 < a' := by rw [ha']; linarith [D.ha]
  have hbb' : D.b < b' := by rw [hb']; linarith [D.hb]
  have hb'1 : b' < 1 := by rw [hb']; linarith [D.hb]
  have hc'c : c' < D.c := by rw [hc']; linarith [D.hc]
  have hc'0 : 0 < c' := by rw [hc']; linarith [D.hc]
  have hdd' : D.d < d' := by rw [hd']; linarith
  set z₁ : ℂ := (a' : ℂ) + (c' : ℂ) * I with hz₁
  set z₂ : ℂ := (b' : ℂ) + (d' : ℂ) * I with hz₂
  have hz₁re : z₁.re = a' := by rw [hz₁]; simp
  have hz₁im : z₁.im = c' := by rw [hz₁]; simp
  have hz₂re : z₂.re = b' := by rw [hz₂]; simp
  have hz₂im : z₂.im = d' := by rw [hz₂]; simp
  have hab' : a' ≤ b' := by linarith [D.hab, D.ha]
  have hcd' : c' ≤ d' := by linarith [D.hcd, D.hc]
  have hrect : Complex.Rectangle z₁ z₂ ⊆ criticalQuadrant := by
    intro s hs
    obtain ⟨hs1, hs2⟩ := hs
    rw [hz₁re, hz₂re, Set.uIcc_of_le hab'] at hs1
    rw [hz₁im, hz₂im, Set.uIcc_of_le hcd'] at hs2
    rw [mem_criticalQuadrant]
    exact ⟨by linarith [hs1.1], by linarith [hs1.2], by linarith [hs2.1]⟩
  have hKin : ∀ z ∈ D.Kc, z₁.re < z.re ∧ z.re < z₂.re ∧ z₁.im < z.im ∧ z.im < z₂.im := by
    intro z hz
    rw [QuadrantCarrierData.Kc, mem_rect] at hz
    rw [hz₁re, hz₂re, hz₁im, hz₂im]
    exact ⟨by linarith [hz.1.1], by linarith [hz.1.2], by linarith [hz.2.1],
      by linarith [hz.2.2]⟩
  have hgK : ∀ z : D.Kc, (quadrantRestrict D.hquad y) z = G (z : ℂ) := by
    intro z
    rw [quadrantRestrict_apply]
    exact hGy _
  have hzero := apply_eq_zero_of_cauchyTransform_eq_zero (K := D.Kc)
    isOpen_criticalQuadrant hG hrect hKin D.Lc
    (D.cauchyTransform_Lc_eq_zero f₁ hgr) (quadrantRestrict D.hquad y) hgK
  rw [← D.hL y]
  rw [show D.L (quadrantRestrict D.hquad y) = D.Lc (quadrantRestrict D.hquad y) from rfl, hzero]
  simp

/-- **The finite-support joint graph is dense in the product.** -/
theorem topologicalClosure_primeQuadrantGraph_eq_top' :
    primeQuadrantGraph.topologicalClosure = ⊤ :=
  _root_.HTGeometry.topologicalClosure_primeQuadrantGraph_eq_top
    (fun f₁ f₂ hgr => weightedEuler_helim f₁ f₂ hgr)

/-- **The joint graph is dense in the product.**  Statement `(18)`: the closure of the group
generated by the finite Euler units is the whole product. -/
theorem closure_primeQuadrantGraph_eq_univ :
    closure ((primeQuadrantGraph : Set (PrimeTangent × holoQuadrant))) = Set.univ := by
  have h := topologicalClosure_primeQuadrantGraph_eq_top'
  have hcoe : ((primeQuadrantGraph.topologicalClosure :
      Submodule ℝ (PrimeTangent × holoQuadrant)) : Set (PrimeTangent × holoQuadrant))
      = closure ((primeQuadrantGraph : Set (PrimeTangent × holoQuadrant))) := rfl
  rw [h] at hcoe
  simpa using hcoe.symm

/-- **The affine closure.**  Statement `(19)`: every translate of the joint graph is dense. -/
theorem closure_affine_primeQuadrantGraph_eq_univ (v : PrimeTangent × holoQuadrant) :
    closure ((fun x => v + x) '' (primeQuadrantGraph : Set (PrimeTangent × holoQuadrant)))
      = Set.univ := by
  have hhom : ((fun x => v + x) '' (primeQuadrantGraph : Set (PrimeTangent × holoQuadrant)))
      = (Homeomorph.addLeft v) '' (primeQuadrantGraph : Set (PrimeTangent × holoQuadrant)) := rfl
  rw [hhom, ← Homeomorph.image_closure, closure_primeQuadrantGraph_eq_univ, Set.image_univ]
  exact (Homeomorph.addLeft v).surjective.range_eq

end RHTower
