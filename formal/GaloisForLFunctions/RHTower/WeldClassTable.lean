import GaloisForLFunctions.RHTower.OmegaObstruction

/-!
# The weld-class table

The `OmegaObstruction` module builds an abstract second cohomology `secondConstraintCohomology`
carrying an `obstructionClass`, together with a commuting-pair antisymmetry detector.  This module
instantiates that machinery on **concrete generator pairs** and computes the obstruction class for
each — the weld-class table.

A generator pair is a derivation `∂` welded to a base-`b` difference/Mahler operator `σ_b`.  In the
logarithmic coordinate the difference operator is a dilation, and the derivation is a translation;
the two generators commute up to a central *conversion constant* — the logarithmic scale that
converts the additive `∂`-clock to the multiplicative `σ_b`-step.  The single universal
`weldCocycle θ` is the bilinear (Heisenberg-type) 2-cocycle on `ℤ²` with that conversion constant
`θ` as its antisymmetry; the whole table is read off `θ`:

* `θ = 0` (**shift**, `σ = exp ∂`, no independent generator) — obstruction **zero**;
* `θ = log k` (**Mahler** `σ_k : f(z) ↦ f(zᵏ)`, `k ≥ 2`) — obstruction **nonzero**, uniformly in `k`;
* `θ = log p` (**prime** `σ_p`) — obstruction **nonzero**.

For two difference bases the obstruction lattice is `⟨log j, log k⟩`, and its rank is governed by an
*elementary* arithmetic dichotomy (no transcendence): `log j, log k` are `ℤ`-linearly dependent iff
the bases are multiplicatively dependent (`jᵃ kᵇ = 1` for some `(a,b) ≠ 0`).

Everything here is a cohomology class and its lattice value — a constraint invariant of the pair.  No
joint carrier is constructed.
-/

noncomputable section

namespace GaloisForLFunctions
namespace RHTower

/-- The generator group of a welded pair: the free abelian group on the two generators
`∂` and `σ`, written multiplicatively. -/
abbrev WeldGroup := Multiplicative (ℤ × ℤ)

/-- The coefficient action is trivial: the weld value lattice sits in `ℝ` with the generators acting
by scale, i.e. trivially on the additive value group. -/
instance : DistribMulAction WeldGroup ℝ where
  smul _ a := a
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

theorem weldGroup_smul_trivial : ∀ (g : WeldGroup) (a : ℝ), g • a = a := fun _ _ => rfl

/-! ### §1 The universal weld cocycle -/

/-- The universal weld 2-cocycle with conversion constant `θ`: the bilinear (Heisenberg) cocycle on
`ℤ²` whose commuting-pair antisymmetry is `θ`.  `∂ = (1,0)` and `σ = (0,1)`; the cocycle pairs the
`∂`-component of the first argument with the `σ`-component of the second. -/
def weldCocycle (θ : ℝ) : WeldGroup → WeldGroup → ℝ :=
  fun x y => θ * ((Multiplicative.toAdd x).1 : ℝ) * ((Multiplicative.toAdd y).2 : ℝ)

/-- Any bilinear form is a group 2-cocycle for the trivial action. -/
theorem weldCocycle_isTwoCocycle (θ : ℝ) : IsTwoCocycle (weldCocycle θ) := by
  intro g h k
  simp only [weldCocycle, weldGroup_smul_trivial, toAdd_mul, Prod.fst_add, Prod.snd_add]
  push_cast
  ring

theorem weldCocycle_zero : weldCocycle 0 = 0 := by
  funext x y; simp [weldCocycle]

/-- The derivation generator `∂`. -/
def weldGenD : WeldGroup := Multiplicative.ofAdd (1, 0)

/-- The difference/Mahler generator `σ`. -/
def weldGenS : WeldGroup := Multiplicative.ofAdd (0, 1)

/-- The two generators commute (they generate an abelian group), so the commuting-pair detector
applies. -/
theorem weldGen_comm : weldGenD * weldGenS = weldGenS * weldGenD := by
  simp only [weldGenD, weldGenS, ← ofAdd_add]; ring_nf

/-- **The conversion constant is the antisymmetry.**  `ω(∂,σ) − ω(σ,∂) = θ`. -/
theorem weldCocycle_antisymm (θ : ℝ) :
    weldCocycle θ weldGenD weldGenS - weldCocycle θ weldGenS weldGenD = θ := by
  simp [weldCocycle, weldGenD, weldGenS]

/-- **The weld-triviality criterion.**  The obstruction class of the pair vanishes exactly when the
conversion constant is zero: `obstructionClass ≠ 0 ↔ θ ≠ 0`.  A nonzero conversion constant is a
genuine (unremovable) weld; a zero constant means the two generators are dependent. -/
theorem weld_obstruction_ne_zero_iff (θ : ℝ) :
    obstructionClassOf (weldCocycle θ) (weldCocycle_isTwoCocycle θ) ≠ 0 ↔ θ ≠ 0 := by
  constructor
  · intro hne hθ
    apply hne
    rw [obstructionClassOf_eq_zero_iff_exists_cochain]
    exact ⟨0, by rw [hθ, weldCocycle_zero, twoCoboundary_zero]⟩
  · intro hθ
    apply obstructionClassOf_ne_zero_of_commutingPair_asymm weldGroup_smul_trivial weldGen_comm
    rw [weldCocycle_antisymm]; exact hθ

/-- The weld cocycle is valued in the rank-one lattice generated by its conversion constant `θ`:
every value is an integer multiple of `θ`. -/
theorem weld_latticeValued (θ : ℝ) :
    IsLatticeValued (AddSubgroup.closure ({θ} : Set ℝ)) (weldCocycle θ) := by
  intro x y
  simp only [weldCocycle]
  have hrw : θ * ((Multiplicative.toAdd x).1 : ℝ) * ((Multiplicative.toAdd y).2 : ℝ)
      = ((Multiplicative.toAdd x).1 * (Multiplicative.toAdd y).2) • θ := by
    rw [zsmul_eq_mul]; push_cast; ring
  rw [hrw]
  exact zsmul_mem (AddSubgroup.subset_closure (Set.mem_singleton θ)) _

/-! ### §2 The generator-pair table (single pairs) -/

/-- **Shift entry.**  For the shift `σ : f(z) ↦ f(z+1) = (exp ∂)f`, the conversion constant is `0`:
the shift is the time-one flow of the derivation, so it is not an independent generator and the weld
obstruction **vanishes**. -/
theorem shift_weld_obstruction_eq_zero :
    obstructionClassOf (weldCocycle 0) (weldCocycle_isTwoCocycle 0) = 0 := by
  rw [obstructionClassOf_eq_zero_iff_exists_cochain]
  exact ⟨0, by rw [weldCocycle_zero, twoCoboundary_zero]⟩

/-- **Mahler entry.**  For the Mahler operator `σ_k : f(z) ↦ f(zᵏ)` (`k ≥ 2`), the conversion constant
is `log k ≠ 0`, so the weld obstruction is **nonzero** — a genuine weld, for every base `k ≥ 2`. -/
theorem mahler_weld_obstruction_ne_zero {k : ℕ} (hk : 2 ≤ k) :
    obstructionClassOf (weldCocycle (Real.log k)) (weldCocycle_isTwoCocycle (Real.log k)) ≠ 0 := by
  rw [weld_obstruction_ne_zero_iff]
  have : (1 : ℝ) < k := by exact_mod_cast hk.trans_lt' (by norm_num)
  exact ne_of_gt (Real.log_pos this)

/-- **Prime entry.**  For the prime shift `σ_p`, the conversion constant is `log p ≠ 0`, so the weld
obstruction is **nonzero** — recovering the archimedean/prime weld of the founding pair. -/
theorem prime_weld_obstruction_ne_zero {p : ℕ} (hp : p.Prime) :
    obstructionClassOf (weldCocycle (Real.log p)) (weldCocycle_isTwoCocycle (Real.log p)) ≠ 0 := by
  rw [weld_obstruction_ne_zero_iff]
  have : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  exact ne_of_gt (Real.log_pos this)

/-! ### §3 The uniform Mahler column -/

/-- **Uniform Mahler theorem.**  The weld obstruction is nonzero for *every* Mahler base `k ≥ 2`
simultaneously — the single statement of which the case-by-case Mahler-independence results are
instances.  Its value is exactly `log k`. -/
theorem mahler_weld_uniform :
    ∀ k : ℕ, 2 ≤ k →
      obstructionClassOf (weldCocycle (Real.log k)) (weldCocycle_isTwoCocycle (Real.log k)) ≠ 0 :=
  fun _ hk => mahler_weld_obstruction_ne_zero hk

/-! ### §4 Two difference bases — rank and multiplicative dependence -/

/-- **The log–power bridge.**  For positive reals `j, k`, an integer linear relation among the
conversion constants is equivalent to a multiplicative relation among the bases:
`a·log j + b·log k = 0 ↔ jᵃ kᵇ = 1`.  This is transcendence-free. -/
theorem weld_logRelation_iff {j k : ℝ} (hj : 0 < j) (hk : 0 < k) (a b : ℤ) :
    (a : ℝ) * Real.log j + (b : ℝ) * Real.log k = 0 ↔ j ^ a * k ^ b = 1 := by
  rw [← Real.log_zpow, ← Real.log_zpow, ← Real.log_mul (by positivity) (by positivity)]
  constructor
  · intro h
    have hpos : (0 : ℝ) < j ^ a * k ^ b := by positivity
    have := Real.exp_log hpos
    rw [h, Real.exp_zero] at this; exact this.symm
  · intro h; rw [h, Real.log_one]

/-- **Rank dichotomy for two bases.**  The two conversion constants `log j, log k` are
`ℤ`-linearly independent (the joint weld obstruction has rank two) exactly when the bases are
multiplicatively independent (`jᵃ kᵇ = 1 ⟹ a = b = 0`).  The obstruction rank is thus an elementary
arithmetic invariant of the base pair. -/
theorem weld_two_base_indep_iff {j k : ℝ} (hj : 0 < j) (hk : 0 < k) :
    (∀ a b : ℤ, (a : ℝ) * Real.log j + (b : ℝ) * Real.log k = 0 → a = 0 ∧ b = 0) ↔
      (∀ a b : ℤ, j ^ a * k ^ b = 1 → a = 0 ∧ b = 0) := by
  constructor
  · intro h a b hab
    exact h a b ((weld_logRelation_iff hj hk a b).mpr hab)
  · intro h a b hab
    exact h a b ((weld_logRelation_iff hj hk a b).mp hab)

/-! ### §5 The whole table is one homomorphism `ℝ ↪ H²`

The weld cocycle is linear in the conversion constant, so `θ ↦ [weldCocycle θ]` is an **injective group
homomorphism** from the additive line of conversion constants into the second constraint cohomology.
Every table entry is the image of its log-scale; multiplicative composition of bases (`σ_j ∘ σ_k = σ_{jk}`)
is addition of classes; multiplicative independence of bases is `ℤ`-linear independence of images. -/

theorem weldCocycle_add (θ θ' : ℝ) :
    weldCocycle (θ + θ') = weldCocycle θ + weldCocycle θ' := by
  funext x y; simp only [weldCocycle, Pi.add_apply]; ring

/-- The obstruction class is additive on cocycles (the quotient map is a group homomorphism). -/
theorem obstructionClass_add (ω η : twoCocycles (G := WeldGroup) (A := ℝ)) :
    obstructionClass (ω + η) = obstructionClass ω + obstructionClass η := rfl

theorem cocycleOf_weldCocycle_add (θ θ' : ℝ) :
    cocycleOf (weldCocycle (θ + θ')) (weldCocycle_isTwoCocycle (θ + θ'))
    = cocycleOf (weldCocycle θ) (weldCocycle_isTwoCocycle θ)
      + cocycleOf (weldCocycle θ') (weldCocycle_isTwoCocycle θ') := by
  apply Subtype.ext
  change weldCocycle (θ + θ') = weldCocycle θ + weldCocycle θ'
  exact weldCocycle_add θ θ'

/-- **The weld-class homomorphism.**  `θ ↦ [weldCocycle θ]` as a bundled group homomorphism
`ℝ →+ H²`.  The whole weld-class table is the image of this single map. -/
def weldClassHom : ℝ →+ secondConstraintCohomology (G := WeldGroup) (A := ℝ) where
  toFun θ := obstructionClassOf (weldCocycle θ) (weldCocycle_isTwoCocycle θ)
  map_zero' := shift_weld_obstruction_eq_zero
  map_add' θ θ' := by
    show obstructionClass (cocycleOf (weldCocycle (θ + θ')) _) = _
    rw [cocycleOf_weldCocycle_add, obstructionClass_add]; rfl

theorem weldClassHom_apply (θ : ℝ) :
    weldClassHom θ = obstructionClassOf (weldCocycle θ) (weldCocycle_isTwoCocycle θ) := rfl

/-- The kernel of the weld-class homomorphism is exactly the zero conversion constant. -/
theorem weldClassHom_eq_zero_iff (θ : ℝ) : weldClassHom θ = 0 ↔ θ = 0 := by
  rw [weldClassHom_apply, ← not_iff_not]
  exact weld_obstruction_ne_zero_iff θ

/-- **The weld-class homomorphism is injective**: distinct conversion constants give distinct weld
classes.  `ℝ` embeds in `H²` as the line of weld classes. -/
theorem weldClassHom_injective : Function.Injective weldClassHom := by
  rw [injective_iff_map_eq_zero]
  intro θ h; exact (weldClassHom_eq_zero_iff θ).mp h

/-- **Composition of bases adds weld classes.**  `σ_j ∘ σ_k = σ_{jk}` and the weld class of the
composite is the sum: `weldClass (log (j·k)) = weldClass (log j) + weldClass (log k)`. -/
theorem weldClassHom_mul_base {j k : ℝ} (hj : 0 < j) (hk : 0 < k) :
    weldClassHom (Real.log (j * k)) = weldClassHom (Real.log j) + weldClassHom (Real.log k) := by
  rw [Real.log_mul (ne_of_gt hj) (ne_of_gt hk), map_add]

/-! ### §6 Two-base independence at the level of classes -/

/-- **Rank dichotomy, at the level of weld classes.**  The two weld classes `weldClass (log j)` and
`weldClass (log k)` are `ℤ`-linearly independent in `H²` exactly when the bases `j, k` are
multiplicatively independent.  The injective homomorphism transports the elementary arithmetic
dichotomy of §4 to the cohomology. -/
theorem weldClass_two_base_indep_iff {j k : ℝ} (hj : 0 < j) (hk : 0 < k) :
    (∀ a b : ℤ, a • weldClassHom (Real.log j) + b • weldClassHom (Real.log k) = 0 → a = 0 ∧ b = 0) ↔
      (∀ a b : ℤ, j ^ a * k ^ b = 1 → a = 0 ∧ b = 0) := by
  have key : ∀ a b : ℤ,
      (a • weldClassHom (Real.log j) + b • weldClassHom (Real.log k) = 0)
        ↔ ((a : ℝ) * Real.log j + (b : ℝ) * Real.log k = 0) := by
    intro a b
    rw [← map_zsmul, ← map_zsmul, ← map_add, weldClassHom_eq_zero_iff, zsmul_eq_mul, zsmul_eq_mul]
  rw [← weld_two_base_indep_iff hj hk]
  constructor
  · intro h a b hab; exact h a b ((key a b).mpr hab)
  · intro h a b hab; exact h a b ((key a b).mp hab)

/-! ### §7 Integration with the founding prime–archimedean weld

The founding pair `(∂_s, {σ_p})` has its obstruction valued in the prime-log lattice
`primeLogLattice = ⟨log p : p prime⟩`.  Each single generator pair sits inside this founding weld: the
weld cocycle is prime-log-integral exactly when its conversion constant lies in the lattice, so the
prime and (integer-)Mahler columns are rank-one sublattices of the founding weld.  Two distinct primes
give a genuinely rank-two independent piece — the concrete witness that the founding weld is not
rank-one, obtained from the unique-factorization independence of `{log p}` already in the tree. -/

/-- The weld cocycle's value on the generator pair is the conversion constant itself. -/
theorem weldCocycle_genD_genS (θ : ℝ) : weldCocycle θ weldGenD weldGenS = θ := by
  simp [weldCocycle, weldGenD, weldGenS]

/-- **Prime-log integrality criterion.**  The weld cocycle is valued in the prime-log lattice exactly
when its conversion constant lies there.  So a pair's weld is a sublattice of the founding
prime–archimedean weld iff its conversion constant is a `ℤ`-combination of `log p`'s. -/
theorem weld_isLatticeValued_primeLog_iff (θ : ℝ) :
    IsLatticeValued primeLogLattice (weldCocycle θ) ↔ θ ∈ primeLogLattice := by
  constructor
  · intro h
    have hval := h weldGenD weldGenS
    rwa [weldCocycle_genD_genS] at hval
  · intro hθ x y
    simp only [weldCocycle]
    have hrw : θ * ((Multiplicative.toAdd x).1 : ℝ) * ((Multiplicative.toAdd y).2 : ℝ)
        = ((Multiplicative.toAdd x).1 * (Multiplicative.toAdd y).2) • θ := by
      rw [zsmul_eq_mul]; push_cast; ring
    rw [hrw]; exact primeLogLattice.zsmul_mem hθ _

/-- The prime weld `σ_p` is a rank-one sublattice of the founding prime–archimedean weld. -/
theorem prime_weld_isLatticeValued_primeLog {p : ℕ} (hp : p.Prime) :
    IsLatticeValued primeLogLattice (weldCocycle (Real.log p)) :=
  (weld_isLatticeValued_primeLog_iff _).mpr (primeLog_mem_primeLogLattice hp)

/-- The logarithm of any positive integer lies in the prime-log lattice: `log k = Σ vₚ(k)·log p`. -/
theorem log_nat_mem_primeLogLattice : ∀ k : ℕ, k ≠ 0 → Real.log (k : ℕ) ∈ primeLogLattice := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hk
    rcases eq_or_ne k 1 with h1 | h1
    · rw [h1, Nat.cast_one, Real.log_one]; exact AddSubgroup.zero_mem primeLogLattice
    · have hp : (k.minFac).Prime := Nat.minFac_prime h1
      obtain ⟨m, hm⟩ := Nat.minFac_dvd k
      have hm0 : m ≠ 0 := by rintro rfl; simp only [Nat.mul_zero] at hm; exact hk hm
      have hmlt : m < k := by rw [hm]; nlinarith [hp.one_lt, Nat.pos_of_ne_zero hm0]
      rw [hm, Nat.cast_mul, Real.log_mul (by exact_mod_cast hp.pos.ne') (by exact_mod_cast hm0)]
      exact primeLogLattice.add_mem (primeLog_mem_primeLogLattice hp) (ih m hmlt hm0)

/-- **The whole (integer) Mahler column sits inside the founding weld.**  For every base `k ≥ 1` the
Mahler weld is prime-log-integral — a sublattice of the founding `(∂_s, {σ_p})` weld, since
`log k = Σ vₚ(k)·log p`. -/
theorem mahler_weld_isLatticeValued_primeLog {k : ℕ} (hk : k ≠ 0) :
    IsLatticeValued primeLogLattice (weldCocycle (Real.log k)) :=
  (weld_isLatticeValued_primeLog_iff _).mpr (log_nat_mem_primeLogLattice k hk)

/-- **Two distinct primes are independent conversion constants.**  From the unique-factorization
independence of `{log p}` (already formalized), distinct primes `p ≠ q` give `ℤ`-linearly independent
`log p, log q`. -/
theorem two_prime_log_indep {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (a b : ℤ)
    (h : (a : ℝ) * Real.log p + (b : ℝ) * Real.log q = 0) : a = 0 ∧ b = 0 := by
  classical
  set P : Nat.Primes := ⟨p, hp⟩ with hP
  set Q : Nat.Primes := ⟨q, hq⟩ with hQ
  have hPQ : P ≠ Q := Subtype.coe_ne_coe.mp hpq
  let g : Nat.Primes → ℤ → ℝ := fun r n => n • Real.log (r : ℕ)
  have hg0 : ∀ r, g r 0 = 0 := fun r => zero_zsmul _
  have hgadd : ∀ r m n, g r (m + n) = g r m + g r n := fun r m n => add_zsmul _ m n
  set coeff : Nat.Primes →₀ ℤ := Finsupp.single P a + Finsupp.single Q b with hc
  have hsum : coeff.sum g = 0 := by
    rw [hc, Finsupp.sum_add_index' hg0 hgadd,
        Finsupp.sum_single_index (hg0 P), Finsupp.sum_single_index (hg0 Q)]
    show a • Real.log (p : ℕ) + b • Real.log (q : ℕ) = 0
    rw [zsmul_eq_mul, zsmul_eq_mul]; exact_mod_cast h
  have hz := primeIndexedLogExpansion_coeff_eq_zero_of_sum_eq_zero hsum
  have haP : coeff P = 0 := by rw [hz]; rfl
  have hbQ : coeff Q = 0 := by rw [hz]; rfl
  refine ⟨?_, ?_⟩
  · simpa [hc, Finsupp.add_apply, Finsupp.single_apply, hPQ, Ne.symm hPQ] using haP
  · simpa [hc, Finsupp.add_apply, Finsupp.single_apply, hPQ, Ne.symm hPQ] using hbQ

/-- **A genuinely rank-two weld.**  The weld classes of two distinct prime shifts are `ℤ`-linearly
independent in `H²`: the founding prime–archimedean weld contains a rank-two piece, so it is not a
rank-one obstruction. -/
theorem two_prime_weld_class_indep {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (a b : ℤ) (hab : a • weldClassHom (Real.log p) + b • weldClassHom (Real.log q) = 0) :
    a = 0 ∧ b = 0 := by
  apply two_prime_log_indep hp hq hpq a b
  rw [← map_zsmul, ← map_zsmul, ← map_add, weldClassHom_eq_zero_iff, zsmul_eq_mul,
    zsmul_eq_mul] at hab
  exact hab

end RHTower
end GaloisForLFunctions
