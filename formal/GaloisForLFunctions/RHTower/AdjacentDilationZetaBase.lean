/-
# The adjacent direct-dilation family over the zeta base

Joint differential independence of zeta together with the adjacent direct-dilation coefficient
streams descends, by base adjunction, to independence of the streams alone over `K = C(s)<zeta>`,
and survives any nonzero base gauge.  In particular multiplying each stream by its own
pole-cancelling polynomial changes nothing.

The Dirichlet transform of the coefficient stream is identified with the difference of two dilated
zeta values, and the pole-cancelled product is exhibited in a manifestly entire form: the factor
`ms - 1` kills the pole of `zeta (ms)` because `zeta (w) = (w-1)⁻¹ + zeta₀ (w)` with `zeta₀`
entire, and symmetrically for the other summand.
-/
import GaloisForLFunctions.RHTower.AdjacentDilationDifferentialFreeness
import GaloisForLFunctions.HTGeometry.PrimeValuationProfileFieldClassification
import GaloisForLFunctions.HTGeometry.BaseGaugeDifferentialIndependence

open scoped BigOperators ArithmeticFunction.Omega Differential
  UpperEndDifferentialInstances UpperEndComplexTowerInstances

namespace RHTower.AdjacentDilation

open ArithmeticFunction
open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry
open RHTower RHTower.AdjacentDilation

noncomputable section

/-- The differential field generated by zeta over the rational coordinate: the card's `K_zeta`. -/
abbrev zetaAdjoinField :=
  differentialAdjoin upperEndRationalCoordinateField
    (Set.range (fun _ : Unit => zetaUpperEndMero))

/-- **Corollary 2.**  The adjacent direct-dilation differences are jointly differentially
independent over `K_zeta = C(s)<zeta>`. -/
theorem adjacentDilationUpperEndCarrier_differentialIndependent_over_zeta :
    DifferentialIndependent zetaAdjoinField
      (fun m : {m : ℕ // 2 ≤ m} => adjacentDilationUpperEndCarrier m.1) :=
  differentialIndependent_sum_right_over_left_differentialAdjoin
    (fun _ : Unit => zetaUpperEndMero)
    (fun m : {m : ℕ // 2 ≤ m} => adjacentDilationUpperEndCarrier m.1)
    zetaAdjacentDilationUpperEnd_differentialIndependent

end

end RHTower.AdjacentDilation

namespace RHTower.AdjacentDilation

open ArithmeticFunction
open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry
open RHTower RHTower.AdjacentDilation

noncomputable section

local instance zetaAdjoinFieldDifferentialAlgebra :
    DifferentialAlgebra zetaAdjoinField upperEndMeroField :=
  ⟨fun c => derivationClosedDifferential_apply _
    (derivationClosed_differentialAdjoin upperEndRationalCoordinateField
      (Set.range (fun _ : Unit => zetaUpperEndMero))) c⟩

/-- **Theorem 3, gauge form.**  Any nonzero base gauge applied coordinatewise leaves the adjacent
direct-dilation family differentially independent over `K_zeta`. -/
theorem adjacentDilationGauge_differentialIndependent_over_zeta
    (a : {m : ℕ // 2 ≤ m} → zetaAdjoinField) (ha : ∀ m, a m ≠ 0) :
    DifferentialIndependent zetaAdjoinField
      (fun m : {m : ℕ // 2 ≤ m} =>
        algebraMap zetaAdjoinField upperEndMeroField (a m) *
          adjacentDilationUpperEndCarrier m.1) :=
  (differentialIndependent_mulBase_iff _ a ha).mpr
    adjacentDilationUpperEndCarrier_differentialIndependent_over_zeta

/-! ## The pole-cancelled entire representative -/

/-- The pole-cancelled adjacent direct-dilation difference, written in a manifestly entire form. -/
def adjacentDilationEntire (m : ℕ) : ℂ → ℂ := fun s =>
  (((m : ℂ) + 1) * s - 1) * (1 + ((m : ℂ) * s - 1) * riemannZeta₀ ((m : ℂ) * s))
    - ((m : ℂ) * s - 1) * (1 + (((m : ℂ) + 1) * s - 1) * riemannZeta₀ (((m : ℂ) + 1) * s))

/-- **Entireness.**  The pole-cancelled adjacent direct-dilation difference is entire. -/
theorem differentiable_adjacentDilationEntire (m : ℕ) :
    Differentiable ℂ (adjacentDilationEntire m) := by
  have h1 : Differentiable ℂ fun s : ℂ => riemannZeta₀ ((m : ℂ) * s) :=
    differentiable_riemannZeta₀.comp (by fun_prop)
  have h2 : Differentiable ℂ fun s : ℂ => riemannZeta₀ (((m : ℂ) + 1) * s) :=
    differentiable_riemannZeta₀.comp (by fun_prop)
  unfold adjacentDilationEntire
  fun_prop

/-- Away from the two cancelled poles the entire representative is the displayed product. -/
theorem adjacentDilationEntire_eq_product {m : ℕ} {s : ℂ}
    (h1 : (m : ℂ) * s ≠ 1) (h2 : ((m : ℂ) + 1) * s ≠ 1) :
    adjacentDilationEntire m s
      = ((m : ℂ) * s - 1) * (((m : ℂ) + 1) * s - 1)
        * (riemannZeta ((m : ℂ) * s) - riemannZeta (((m : ℂ) + 1) * s)) := by
  have hs1 : ((m : ℂ) * s - 1) ≠ 0 := sub_ne_zero.mpr h1
  have hs2 : (((m : ℂ) + 1) * s - 1) ≠ 0 := sub_ne_zero.mpr h2
  rw [riemannZeta_eq_inv_sub_add h1, riemannZeta_eq_inv_sub_add h2, adjacentDilationEntire]
  field_simp

end

end RHTower.AdjacentDilation

namespace RHTower.AdjacentDilation

open ArithmeticFunction
open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry
open RHTower RHTower.AdjacentDilation

noncomputable section

open Classical in
/-- The indicator of perfect `k`-th powers. -/
def perfectPowerArith (k : ℕ) : ArithmeticFunction ℂ where
  toFun n := if n = 0 then 0 else if ∃ a : ℕ, n = a ^ k then 1 else 0
  map_zero' := by simp

open Classical in
theorem perfectPowerArith_apply {k n : ℕ} (hn : n ≠ 0) :
    perfectPowerArith k n = if ∃ a : ℕ, n = a ^ k then 1 else 0 := by
  simp only [perfectPowerArith, ArithmeticFunction.coe_mk, if_neg hn]

theorem adjacentDilationCoeff_eq_sub (m : ℕ) :
    adjacentDilationCoeff m = perfectPowerArith m - perfectPowerArith (m + 1) := by
  classical
  ext n
  by_cases hn : n = 0
  · simp [adjacentDilationCoeff, perfectPowerArith, hn]
  · show _ = perfectPowerArith m n - perfectPowerArith (m + 1) n
    rw [adjacentDilationCoeff_apply hn, perfectPowerArith_apply hn, perfectPowerArith_apply hn]

theorem perfectPowerArith_support_subset {k : ℕ} (hk : 1 ≤ k) (s : ℂ) :
    Function.support (LSeries.term (fun n => perfectPowerArith k n) s)
      ⊆ Set.range (fun a : ℕ => a ^ k) := by
  classical
  intro n hn
  have hne : LSeries.term (fun n => perfectPowerArith k n) s n ≠ 0 := hn
  by_cases h0 : n = 0
  · exact ⟨0, by simp [h0, zero_pow (by omega : k ≠ 0)]⟩
  · rw [LSeries.term_of_ne_zero h0] at hne
    have hcoef : perfectPowerArith k n ≠ 0 := by
      intro h
      exact hne (by rw [h, zero_div])
    rw [perfectPowerArith_apply h0] at hcoef
    by_cases hex : ∃ a : ℕ, n = a ^ k
    · obtain ⟨a, ha⟩ := hex
      exact ⟨a, ha.symm⟩
    · exact absurd (by rw [if_neg hex]) hcoef

theorem term_perfectPowerArith_pow {k : ℕ} (hk : 1 ≤ k) (s : ℂ) (a : ℕ) :
    LSeries.term (fun n => perfectPowerArith k n) s (a ^ k)
      = LSeries.term 1 ((k : ℂ) * s) a := by
  classical
  by_cases ha : a = 0
  · subst a
    simp [LSeries.term, zero_pow (by omega : k ≠ 0)]
  · have hak : a ^ k ≠ 0 := pow_ne_zero _ ha
    rw [LSeries.term_of_ne_zero hak, LSeries.term_of_ne_zero ha,
      perfectPowerArith_apply hak, if_pos ⟨a, rfl⟩]
    congr 1
    rw [Nat.cast_pow, Complex.natCast_cpow_natCast_mul]

theorem lseriesSummable_perfectPowerArith {k : ℕ} (hk : 1 ≤ k) {s : ℂ}
    (hs : 1 < ((k : ℂ) * s).re) :
    LSeriesSummable (fun n => perfectPowerArith k n) s := by
  classical
  have hzero : ∀ x ∉ Set.range (fun a : ℕ => a ^ k),
      LSeries.term (fun n => perfectPowerArith k n) s x = 0 := by
    intro x hx
    by_contra h
    exact hx (perfectPowerArith_support_subset hk s h)
  rw [LSeriesSummable, ← (Nat.pow_left_injective (by omega : k ≠ 0)).summable_iff hzero]
  refine (LSeriesSummable_one_iff.mpr hs).congr (fun a => ?_)
  exact (term_perfectPowerArith_pow hk s a).symm

/-- **The Dirichlet transform of the perfect-power indicator is the dilated zeta.** -/
theorem lseries_perfectPowerArith {k : ℕ} (hk : 1 ≤ k) {s : ℂ}
    (hs : 1 < ((k : ℂ) * s).re) :
    LSeries (fun n => perfectPowerArith k n) s = riemannZeta ((k : ℂ) * s) := by
  classical
  rw [← LSeries_one_eq_riemannZeta hs, LSeries, LSeries,
    ← (Nat.pow_left_injective (by omega : k ≠ 0)).tsum_eq
      (perfectPowerArith_support_subset hk s)]
  exact tsum_congr (fun a => term_perfectPowerArith_pow hk s a)

/-- **The adjacent direct-dilation Dirichlet transform.** -/
theorem lseries_adjacentDilationCoeff {m : ℕ} (hm : 1 ≤ m) {s : ℂ}
    (hs1 : 1 < ((m : ℂ) * s).re) (hs2 : 1 < (((m : ℂ) + 1) * s).re) :
    LSeries (fun n => adjacentDilationCoeff m n) s
      = riemannZeta ((m : ℂ) * s) - riemannZeta (((m : ℂ) + 1) * s) := by
  have hcast : (((m + 1 : ℕ) : ℂ)) = (m : ℂ) + 1 := by push_cast; ring
  have hsum1 := lseriesSummable_perfectPowerArith hm hs1
  have hsum2 : LSeriesSummable (fun n => perfectPowerArith (m + 1) n) s := by
    refine lseriesSummable_perfectPowerArith (by omega) ?_
    rw [hcast]
    exact hs2
  have hfun : (fun n => adjacentDilationCoeff m n)
      = (fun n => perfectPowerArith m n) - (fun n => perfectPowerArith (m + 1) n) := by
    funext n
    rw [adjacentDilationCoeff_eq_sub]
    rfl
  rw [hfun, LSeries_sub hsum1 hsum2, lseries_perfectPowerArith hm hs1,
    lseries_perfectPowerArith (by omega : 1 ≤ m + 1) (by rw [hcast]; exact hs2), hcast]

end

end RHTower.AdjacentDilation
