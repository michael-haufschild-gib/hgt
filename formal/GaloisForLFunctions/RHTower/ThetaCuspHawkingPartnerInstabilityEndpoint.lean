import GaloisForLFunctions.RHTower.ThetaCuspHawkingBogoliubovBornEndpoint

/-!
# Reflected Hawking-partner instability endpoint

The theta compact Green operator turns every nonkinematic dark Born frequency `z` into a nonzero
source mode with eigenvalue `mu = -z⁻¹`.  On that exact eigenline the scalar orbit generated by
`mu` has norm

`‖g_z(t)‖ = exp (t * Im(mu)) ‖g_z‖`.

Evenness of completed Xi supplies the reflected dark frequency `-z`; its Green eigenvalue is
`-mu`.  Therefore every hypothetical off-line zero creates one growing and one decaying member of
a reflected Krein pair.  Global forward non-amplification of these source partner modes is exactly
RH.

This is a source-side dynamical endpoint, not yet a moving-mirror backreaction theorem.  A physical
closure must prove that the backreacted Hawking generator restricts to this already-constructed
Green eigenline.  Merely naming the scalar orbit as Hawking time evolution would assume that
missing identification.
-/

open Complex Real

noncomputable section

namespace RHTower

open HedenmalmQuantile HedenmalmThetaSource HedenmalmHilbertSchmidt

/-- Source Green eigenfrequency attached to a nonkinematic dark Born frequency. -/
def thetaCuspHawkingPartnerGreenFrequency
    (d : ThetaCuspHawkingDarkFrequency) : ℂ :=
  -d.1⁻¹

/-- Exponential growth rate of the exact source Green eigenline. -/
def thetaCuspHawkingPartnerGrowthRate
    (d : ThetaCuspHawkingDarkFrequency) : ℝ :=
  (thetaCuspHawkingPartnerGreenFrequency d).im

/-- Xi evenness reflects every dark frequency through the origin. -/
def thetaCuspHawkingReflectedDarkFrequency
    (d : ThetaCuspHawkingDarkFrequency) : ThetaCuspHawkingDarkFrequency := by
  refine ⟨-d.1, ?_, neg_ne_zero.mpr d.2.2⟩
  rw [thetaCuspBalancedHawkingBornAmplitude_eq_XiC, XiC_even,
    thetaCuspHawkingDarkFrequency_XiC_eq_zero, mul_zero]

theorem thetaCuspHawkingPartnerGrowthRate_eq
    (d : ThetaCuspHawkingDarkFrequency) :
    thetaCuspHawkingPartnerGrowthRate d =
      d.1.im / Complex.normSq d.1 := by
  simp [thetaCuspHawkingPartnerGrowthRate,
    thetaCuspHawkingPartnerGreenFrequency, Complex.inv_im]
  ring

/-- The reflected dark partner carries the opposite Green growth rate. -/
theorem thetaCuspHawkingPartnerGrowthRate_reflected
    (d : ThetaCuspHawkingDarkFrequency) :
    thetaCuspHawkingPartnerGrowthRate
        (thetaCuspHawkingReflectedDarkFrequency d) =
      -thetaCuspHawkingPartnerGrowthRate d := by
  simp [thetaCuspHawkingPartnerGrowthRate,
    thetaCuspHawkingPartnerGreenFrequency,
    thetaCuspHawkingReflectedDarkFrequency, inv_neg]

/-- Scalar orbit on the exact compact Green eigenline. -/
def thetaCuspHawkingPartnerGreenOrbit
    (d : ThetaCuspHawkingDarkFrequency) (t : ℝ) :=
  Complex.exp
      (-Complex.I * (t : ℂ) * thetaCuspHawkingPartnerGreenFrequency d) •
    thetaCuspHawkingKreinMode d

/-- Every point of the scalar orbit stays on the same exact Green eigenspace. -/
theorem thetaKernelOperator_thetaCuspHawkingPartnerGreenOrbit
    (d : ThetaCuspHawkingDarkFrequency) (t : ℝ) :
    thetaKernelOperator (thetaCuspHawkingPartnerGreenOrbit d t) =
      thetaCuspHawkingPartnerGreenFrequency d •
        thetaCuspHawkingPartnerGreenOrbit d t := by
  rw [thetaCuspHawkingPartnerGreenOrbit, map_smul,
    thetaKernelOperator_thetaCuspHawkingKreinMode]
  simp only [thetaCuspHawkingPartnerGreenFrequency, smul_smul]
  ring

/-- Exact norm law on the dark Green eigenline. -/
theorem norm_thetaCuspHawkingPartnerGreenOrbit
    (d : ThetaCuspHawkingDarkFrequency) (t : ℝ) :
    ‖thetaCuspHawkingPartnerGreenOrbit d t‖ =
      Real.exp (t * thetaCuspHawkingPartnerGrowthRate d) *
        ‖thetaCuspHawkingKreinMode d‖ := by
  rw [thetaCuspHawkingPartnerGreenOrbit, norm_smul, Complex.norm_exp]
  congr 2
  norm_num [thetaCuspHawkingPartnerGrowthRate,
    Complex.mul_re, Complex.mul_im]

/-- Green boundary flux is the growth rate times a strictly positive source factor. -/
theorem thetaCuspHawkingKreinFlux_eq_growthRate
    (d : ThetaCuspHawkingDarkFrequency) :
    thetaCuspHawkingKreinFlux d =
      2 * thetaSource.mass * Complex.normSq d.1 *
        thetaCuspHawkingKreinEnergy d *
          thetaCuspHawkingPartnerGrowthRate d := by
  rw [thetaCuspHawkingKreinFlux_eq,
    thetaCuspHawkingPartnerGrowthRate_eq]
  have hnormSq : Complex.normSq d.1 ≠ 0 :=
    ne_of_gt ((Complex.normSq_pos).2 d.2.2)
  field_simp [hnormSq]

/-- Every hypothetical off-line dark frequency has a strictly growing member in its reflected
pair.  This is the exact compact-source analogue of a black-hole-laser instability pair. -/
theorem thetaCuspHawking_offLine_has_growing_reflected_partner
    (d : ThetaCuspHawkingDarkFrequency) (him : d.1.im ≠ 0) :
    0 < thetaCuspHawkingPartnerGrowthRate d ∨
      0 < thetaCuspHawkingPartnerGrowthRate
        (thetaCuspHawkingReflectedDarkFrequency d) := by
  have hnormSq : Complex.normSq d.1 ≠ 0 :=
    ne_of_gt ((Complex.normSq_pos).2 d.2.2)
  have hrate : thetaCuspHawkingPartnerGrowthRate d ≠ 0 := by
    rw [thetaCuspHawkingPartnerGrowthRate_eq]
    exact div_ne_zero him hnormSq
  by_cases hpos : 0 < thetaCuspHawkingPartnerGrowthRate d
  · exact Or.inl hpos
  · right
    rw [thetaCuspHawkingPartnerGrowthRate_reflected]
    have hle : thetaCuspHawkingPartnerGrowthRate d ≤ 0 := le_of_not_gt hpos
    exact neg_pos.mpr (lt_of_le_of_ne hle hrate)

/-- No exact source partner mode amplifies under forward Green evolution. -/
def ThetaCuspHawkingSourcePartnerNoAmplification : Prop :=
  ∀ (d : ThetaCuspHawkingDarkFrequency) (t : ℝ),
    0 ≤ t →
      ‖thetaCuspHawkingPartnerGreenOrbit d t‖ ≤
        ‖thetaCuspHawkingKreinMode d‖

theorem thetaCuspHawkingSourcePartnerNoAmplification_of_growthRate_nonpos
    (h : ∀ d : ThetaCuspHawkingDarkFrequency,
      thetaCuspHawkingPartnerGrowthRate d ≤ 0) :
    ThetaCuspHawkingSourcePartnerNoAmplification := by
  intro d t ht
  rw [norm_thetaCuspHawkingPartnerGreenOrbit]
  calc
    Real.exp (t * thetaCuspHawkingPartnerGrowthRate d) *
          ‖thetaCuspHawkingKreinMode d‖ ≤
        1 * ‖thetaCuspHawkingKreinMode d‖ := by
      apply mul_le_mul_of_nonneg_right
      · exact Real.exp_le_one_iff.mpr
          (mul_nonpos_of_nonneg_of_nonpos ht (h d))
      · exact norm_nonneg _
    _ = ‖thetaCuspHawkingKreinMode d‖ := one_mul _

theorem thetaCuspHawkingPartnerGrowthRate_nonpos_of_noAmplification
    (h : ThetaCuspHawkingSourcePartnerNoAmplification)
    (d : ThetaCuspHawkingDarkFrequency) :
    thetaCuspHawkingPartnerGrowthRate d ≤ 0 := by
  have horbit := h d 1 (by norm_num)
  rw [norm_thetaCuspHawkingPartnerGreenOrbit, one_mul] at horbit
  have hnorm : 0 < ‖thetaCuspHawkingKreinMode d‖ :=
    norm_pos_iff.mpr (thetaCuspHawkingKreinMode_ne_zero d)
  apply Real.exp_le_one_iff.mp
  apply le_of_mul_le_mul_right (a := ‖thetaCuspHawkingKreinMode d‖) ?_ hnorm
  simpa using horbit

/-- **Reflected partner-instability endpoint.** RH is equivalent to forward non-amplification of
every exact theta-source Green mode indexed by a nonkinematic Hawking Born-dark frequency. -/
theorem riemannHypothesis_iff_thetaCuspHawkingSourcePartnerNoAmplification :
    RiemannHypothesis ↔ ThetaCuspHawkingSourcePartnerNoAmplification := by
  rw [riemannHypothesis_iff_thetaCuspHawkingBornDarkFrequenciesPhysical]
  constructor
  · intro hphysical
    apply thetaCuspHawkingSourcePartnerNoAmplification_of_growthRate_nonpos
    intro d
    rw [thetaCuspHawkingPartnerGrowthRate_eq, hphysical d.1 d.2.1,
      zero_div]
  · intro hstable z hdark
    by_cases hz : z = 0
    · simp [hz]
    · let d : ThetaCuspHawkingDarkFrequency := ⟨z, hdark, hz⟩
      have hrate :=
        thetaCuspHawkingPartnerGrowthRate_nonpos_of_noAmplification hstable d
      have hreflected :=
        thetaCuspHawkingPartnerGrowthRate_nonpos_of_noAmplification hstable
          (thetaCuspHawkingReflectedDarkFrequency d)
      rw [thetaCuspHawkingPartnerGrowthRate_reflected] at hreflected
      have hrateZero : thetaCuspHawkingPartnerGrowthRate d = 0 := by
        linarith
      rw [thetaCuspHawkingPartnerGrowthRate_eq] at hrateZero
      have hnormSq : Complex.normSq d.1 ≠ 0 :=
        ne_of_gt ((Complex.normSq_pos).2 d.2.2)
      rw [div_eq_zero_iff] at hrateZero
      simpa [d] using hrateZero.resolve_right hnormSq

end RHTower
