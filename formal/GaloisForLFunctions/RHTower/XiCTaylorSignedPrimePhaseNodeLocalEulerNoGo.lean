import GaloisForLFunctions.HTGeometry.PrimeClockAnalyticExactCorrespondence
import GaloisForLFunctions.RHTower.XiCTaylorSignedPrimePhaseNodeSourceNoGo

/-!
# Route-J phase-node sources are local Euler data

Arithmetic phase-node rigidity says that a nonzero carrier can activate at most one prime ray.
The exact prime-clock source quotient kills every profile supported on finitely many prime rays.
This file welds the two facts: every prime-power phase-node profile is quotient-zero, and every
finite-abscissa analytic realization of such a profile already belongs to the pulled local-Euler
coordinate field.

This closes the scalar one-prime phase-node tower left open by the rank-one theorem.  It does not
close non-prime-power singular support or relation-valued carriers outside the scalar prime-clock
quotient.
-/

namespace RHTower

open GaloisForLFunctions.HTGeometry
open ArithmeticFunction Set

noncomputable section

/-- Complex prime-power profiles supported on the phase-node locus of one carrier. -/
def RouteJPrimePowerComplexPhaseNodeMultiplier
    (u : ℝ) (a : PrimePowerClockIndex → ℂ) : Prop :=
  ∀ pe, a pe ≠ 0 → routeJPrimePowerPhaseNodeAt u pe

/-- Every complex phase-node coordinate profile has finite prime-ray activity.  Its activity is
in fact subsingleton. -/
theorem routeJ_primePowerComplexPhaseNode_primePowerClockLocal
    {u : ℝ} (hu : u ≠ 0)
    {a : PrimePowerClockIndex → ℂ}
    (ha : RouteJPrimePowerComplexPhaseNodeMultiplier u a) :
    PrimePowerClockLocal a := by
  let S : Set (Nat.Primes × ℕ) := {pe | a pe ≠ 0}
  have hnode : ∀ pe ∈ S, routeJPrimePowerPhaseNodeAt u pe := by
    intro pe hpe
    exact ha pe hpe
  have hsub : (Prod.fst '' S).Subsingleton :=
    routeJ_primePowerPhaseNode_primeSupport_subsingleton hu hnode
  unfold PrimePowerClockLocal RayLocal
  apply hsub.finite.subset
  rintro p ⟨pe, hpe, hne⟩
  refine ⟨pe, ?_, ?_⟩
  · exact hne
  · simpa [S, primePowerClockRay] using hpe

/-- Clock-quotient class of a real Route-J prime-power multiplier. -/
def routeJPrimePowerMultiplierClockClass
    (a : Nat.Primes × ℕ → ℝ) : PrimeProfileClockQuotient :=
  (rayLocalSubmodule primePowerClockRay).mkQ (fun pe => (a pe : ℂ))

/-- Every real prime-power phase-node multiplier, including an infinite one-prime tower, is zero
in the source quotient modulo finite-prime Euler rays. -/
theorem routeJ_primePowerPhaseNodeMultiplier_clockClass_eq_zero
    {u : ℝ} (hu : u ≠ 0)
    {a : Nat.Primes × ℕ → ℝ}
    (ha : RouteJPrimePowerPhaseNodeMultiplier u a) :
    routeJPrimePowerMultiplierClockClass a = 0 := by
  change (rayLocalSubmodule primePowerClockRay).mkQ
    (fun pe => ((a pe : ℝ) : ℂ)) = 0
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  apply routeJ_primePowerComplexPhaseNode_primePowerClockLocal hu
  intro pe hpe
  apply ha pe
  exact fun hzero => hpe (by simp [hzero])

/-- Every active prime-power coordinate of an arithmetic profile lies on the carrier's phase-node
locus. -/
def RouteJPrimeProfilePhaseNodeMultiplier
    (u : ℝ) (f : ArithmeticFunction ℂ) : Prop :=
  RouteJPrimePowerComplexPhaseNodeMultiplier u (primePowerCoordinateProfile f)

/-- A prime-power phase-node arithmetic profile has finite prime-ray activity.  In fact its
activity is subsingleton, but finite locality is the exact interface to the prime-clock quotient. -/
theorem routeJ_primeProfilePhaseNode_primePowerClockLocal
    {u : ℝ} (hu : u ≠ 0)
    {f : ArithmeticFunction ℂ}
    (hf : RouteJPrimeProfilePhaseNodeMultiplier u f) :
    PrimePowerClockLocal (primePowerCoordinateProfile f) := by
  exact routeJ_primePowerComplexPhaseNode_primePowerClockLocal hu hf

/-- **Prime-clock quotient no-go.**  Every prime-power phase-node profile is zero in the global
source quotient modulo finite-prime Euler rays.  This includes the formerly surviving one-prime
tower and makes no boundedness, finite-depth, or finite-Rees assumption. -/
theorem routeJ_primeProfilePhaseNode_clockClass_eq_zero
    {u : ℝ} (hu : u ≠ 0)
    {f : ArithmeticFunction ℂ}
    (hf : RouteJPrimeProfilePhaseNodeMultiplier u f) :
    primeProfileClockClass f = 0 := by
  change (rayLocalSubmodule primePowerClockRay).mkQ
    (primePowerCoordinateProfile f) = 0
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact routeJ_primeProfilePhaseNode_primePowerClockLocal hu hf

/-- **Analytic local-Euler classification.**  A finite-abscissa positive-prime-power carrier whose
active coordinates are phase nodes at a nonzero frequency already lies in the analytic coordinate
field generated by finite-prime Euler germs.  It therefore supplies no new global relative
prime-clock direction. -/
theorem routeJ_finiteAbscissaPrimeProfilePhaseNode_mem_pulledLocalEuler
    {u : ℝ} (hu : u ≠ 0)
    (f : finiteAbscissaArithmeticSubalgebra)
    (hsupport : PrimeProfileSupportedOnPositivePrimePowers f.1)
    (hphase : RouteJPrimeProfilePhaseNodeMultiplier u f.1) :
    finiteAbscissaLSeriesToUpperEndMero f ∈
      analyticPulledFinitePrimeCoordinateField := by
  apply finiteAbscissaLSeries_mem_pulledFinitePrimeCoordinate f
  apply algebraMap_primeProfile_mem_finitePrimeCoefficientField_of_local
    f.1 hsupport
  exact routeJ_primeProfilePhaseNode_primePowerClockLocal hu hphase

end

end RHTower
