import GaloisForLFunctions.RHTower.MobiusFixedCurrentVonMangoldt
import GaloisForLFunctions.RHTower.SuzukiCoupledErrorCriticalDerivative
import GaloisForLFunctions.HTGeometry.FiniteAbscissaDirichletUpperEnd

/-!
# The packet Dirichlet series is generated by the shifted Jordan--Euler coefficients

The complementary packet connection is `C(α,s) = ζ(s-α)/ζ(s+α)`.  Its Dirichlet coefficients are
the shifted Jordan--Euler coefficients

```text
c_α(n) = n^α ∏_{p ∣ n} (1 - p^{-2α}) ,
```

whose `α`-derivative at the origin is twice the von Mangoldt function.  This file proves that the
ordinary Dirichlet series of `c_α` is exactly the packet connection, so the normal current of the
packet and the prime-power coefficient identity are two readings of one object.

The mechanism is arithmetic: `c_α` is the Dirichlet convolution of `n ↦ n^α` with
`n ↦ μ(n) n^{-α}`.  Pulling the common shift out, the remaining factor is `ζ ⍟ (μ · n^{-2α})`,
which is multiplicative and takes the value `1 - p^{-2α}` at every prime power, hence equals the
prime-factor product.
-/

open ArithmeticFunction GaloisForLFunctions.HTGeometry
open scoped ArithmeticFunction

namespace RHTower

noncomputable section

/-- Multiplicativity is preserved by a Dirichlet shift, because the shift weight is completely
multiplicative. -/
theorem isMultiplicative_dirichletShift {a : ℂ} {f : ArithmeticFunction ℂ}
    (hf : f.IsMultiplicative) : (dirichletShift a f).IsMultiplicative := by
  constructor
  · rw [dirichletShift_apply, hf.map_one, cpowWeight]
    simp
  · intro m n hmn
    rw [dirichletShift_apply, dirichletShift_apply, dirichletShift_apply, cpowWeight_mul,
      hf.map_mul_of_coprime hmn]
    ring

/-- The Möbius stream damped by `n^{-2α}`. -/
def doubleShiftedMoebius (α : ℝ) : ArithmeticFunction ℂ :=
  dirichletShift (Complex.ofReal (2 * α))
    ((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ)

/-- The divisor sum of the damped Möbius stream: the prime-factor part of `c_α`. -/
def suzukiRadicalFactor (α : ℝ) : ArithmeticFunction ℂ :=
  ((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ) * doubleShiftedMoebius α

theorem doubleShiftedMoebius_prime_pow {α : ℝ} {p : ℕ} (hp : p.Prime) (j : ℕ) :
    doubleShiftedMoebius α (p ^ j)
      = if j = 0 then 1 else if j = 1 then -((p : ℂ) ^ (-(Complex.ofReal (2 * α)))) else 0 := by
  have hp0 : (p : ℂ) ≠ 0 := by
    exact_mod_cast hp.ne_zero
  rcases Nat.eq_zero_or_pos j with rfl | hj
  · simp [doubleShiftedMoebius, cpowWeight]
  · rw [if_neg hj.ne']
    rw [doubleShiftedMoebius, dirichletShift_apply, intCoe_apply,
      ArithmeticFunction.moebius_apply_prime_pow hp hj.ne']
    by_cases hj1 : j = 1
    · subst hj1
      rw [if_pos rfl, if_pos rfl, cpowWeight, pow_one]
      push_cast
      ring
    · rw [if_neg hj1, if_neg hj1]
      simp

/-- **The prime-factor part is the Euler product of the damping.**  For every nonzero `n`, the
divisor sum of the damped Möbius stream is `∏_{p ∣ n} (1 - p^{-2α})`. -/
theorem suzukiRadicalFactor_apply (α : ℝ) {n : ℕ} (hn : n ≠ 0) :
    suzukiRadicalFactor α n = ∏ p ∈ n.primeFactors, (1 - (p : ℂ) ^ (-(Complex.ofReal (2 * α)))) := by
  have hmul : (suzukiRadicalFactor α).IsMultiplicative := by
    rw [suzukiRadicalFactor, doubleShiftedMoebius]
    exact (isMultiplicative_zeta.natCast).mul
      (isMultiplicative_dirichletShift (isMultiplicative_moebius.intCast))
  have hprod : (ArithmeticFunction.prodPrimeFactors
      fun p : ℕ => 1 - (p : ℂ) ^ (-(Complex.ofReal (2 * α)))).IsMultiplicative :=
    ArithmeticFunction.IsMultiplicative.prodPrimeFactors _
  have heq : suzukiRadicalFactor α
      = ArithmeticFunction.prodPrimeFactors fun p : ℕ => 1 - (p : ℂ) ^ (-(Complex.ofReal (2 * α))) := by
    refine (ArithmeticFunction.IsMultiplicative.eq_iff_eq_on_prime_powers _ hmul _ hprod).mpr ?_
    intro p i hp
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · simpa using hmul.map_one.trans hprod.map_one.symm
    have hpi : p ^ i ≠ 0 := pow_ne_zero _ hp.ne_zero
    have hi0 : i ≠ 0 := hi.ne'
    rw [ArithmeticFunction.prodPrimeFactors_apply hpi, Nat.primeFactors_prime_pow hi0 hp,
      Finset.prod_singleton, suzukiRadicalFactor, coe_zeta_mul_apply,
      Nat.sum_divisors_prime_pow hp]
    have hsub : Finset.range 2 ⊆ Finset.range (i + 1) :=
      Finset.range_mono (Nat.succ_le_succ hi)
    have hzero : ∀ x ∈ Finset.range (i + 1), x ∉ Finset.range 2 →
        doubleShiftedMoebius α (p ^ x) = 0 := by
      intro x _ hx
      have hx2 : 2 ≤ x := by
        by_contra hcon
        exact hx (Finset.mem_range.mpr (by omega))
      rw [doubleShiftedMoebius_prime_pow hp, if_neg (by omega), if_neg (by omega)]
    rw [← Finset.sum_subset hsub hzero]
    rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero,
      doubleShiftedMoebius_prime_pow hp, doubleShiftedMoebius_prime_pow hp]
    norm_num
    ring
  rw [heq, ArithmeticFunction.prodPrimeFactors_apply hn]

/-- Composing two Dirichlet shifts adds the shift parameters. -/
theorem dirichletShift_dirichletShift (a b : ℂ) (f : ArithmeticFunction ℂ) :
    dirichletShift a (dirichletShift b f) = dirichletShift (a + b) f := by
  ext n
  by_cases hn : n = 0
  · subst hn
    simp
  · have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast hn
    simp only [dirichletShift_apply, cpowWeight, neg_add]
    rw [Complex.cpow_add _ _ hn']
    ring

/-- The shifted Jordan--Euler coefficient stream `(5)` as an arithmetic function. -/
def suzukiCoeffAF (α : ℝ) : ArithmeticFunction ℂ :=
  dirichletShift (-(α : ℝ) : ℂ) (suzukiRadicalFactor α)

/-- The arithmetic function reproduces the card's coefficient `(5)`. -/
theorem suzukiCoeffAF_apply (α : ℝ) {n : ℕ} (hn : n ≠ 0) :
    suzukiCoeffAF α n = ((suzukiShiftedCoefficient α n : ℝ) : ℂ) := by
  have hexp : Complex.ofReal (-2 * α) = -(Complex.ofReal (2 * α)) := by
    push_cast
    ring
  have hpow : Complex.ofReal ((n : ℝ) ^ α) = (n : ℂ) ^ (Complex.ofReal α) := by
    rw [Complex.ofReal_cpow (Nat.cast_nonneg n) α]
    norm_num
  have hfac : ∀ p : ℕ, Complex.ofReal (1 - (p : ℝ) ^ (-2 * α))
      = 1 - (p : ℂ) ^ (-(Complex.ofReal (2 * α))) := by
    intro p
    rw [Complex.ofReal_sub, Complex.ofReal_one, Complex.ofReal_cpow (Nat.cast_nonneg p), hexp]
    norm_num
  have hprodcast : Complex.ofReal (∏ p ∈ n.primeFactors, (1 - (p : ℝ) ^ (-2 * α)))
      = ∏ p ∈ n.primeFactors, (1 - (p : ℂ) ^ (-(Complex.ofReal (2 * α)))) := by
    rw [Complex.ofReal_prod]
    exact Finset.prod_congr rfl fun p _ => hfac p
  rw [suzukiCoeffAF, dirichletShift_apply, cpowWeight, neg_neg,
    suzukiRadicalFactor_apply α hn, suzukiShiftedCoefficient,
    show Complex.ofReal ((n : ℝ) ^ α * ∏ p ∈ n.primeFactors, (1 - (p : ℝ) ^ (-2 * α)))
        = Complex.ofReal ((n : ℝ) ^ α)
          * Complex.ofReal (∏ p ∈ n.primeFactors, (1 - (p : ℝ) ^ (-2 * α))) from
      Complex.ofReal_mul _ _, hpow, hprodcast]

/-- **`c_α` is a Dirichlet convolution.**  The shifted Jordan--Euler stream is `n ↦ n^α` convolved
with `n ↦ μ(n) n^{-α}`. -/
theorem suzukiCoeffAF_eq_convolution (α : ℝ) :
    suzukiCoeffAF α
      = dirichletShift (-(α : ℝ) : ℂ) ((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ)
        * dirichletShift ((α : ℝ) : ℂ)
            ((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ) := by
  rw [suzukiCoeffAF, suzukiRadicalFactor, dirichletShift_mul, doubleShiftedMoebius,
    dirichletShift_dirichletShift]
  congr 2
  push_cast
  ring

/-- **The packet Dirichlet series is generated by the coefficients `(5)`.**  On the half-plane where
both shifted variables lie right of one, the ordinary Dirichlet series of the shifted Jordan--Euler
coefficients is the packet connection `ζ(s-α)/ζ(s+α)`. -/
theorem LSeries_suzukiShiftedCoefficient (α : ℝ) {s : ℂ}
    (h1 : 1 < (s - (α : ℂ)).re) (h2 : 1 < (s + (α : ℂ)).re) :
    LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s
      = riemannZeta (s - (α : ℂ)) / riemannZeta (s + (α : ℂ)) := by
  have hminus : s + (-(α : ℝ) : ℂ) = s - (α : ℂ) := by ring
  have hplus : s + ((α : ℝ) : ℂ) = s + (α : ℂ) := rfl
  have hcoeZ : (fun n => (((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ) n))
      = fun n => ((zeta n : ℕ) : ℂ) := by
    funext n
    simp
  have hcoeM : (fun n => (((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ) n))
      = fun n => ((moebius n : ℤ) : ℂ) := by
    funext n
    simp
  have hsF : LSeriesSummable
      (fun n => dirichletShift (-(α : ℝ) : ℂ)
        ((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ) n) s := by
    rw [dirichletShift_LSeriesSummable_iff, hminus, hcoeZ]
    exact LSeriesSummable_zeta_iff.mpr h1
  have hsG : LSeriesSummable
      (fun n => dirichletShift ((α : ℝ) : ℂ)
        ((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ) n) s := by
    rw [dirichletShift_LSeriesSummable_iff, hplus, hcoeM]
    exact LSeriesSummable_moebius_iff.mpr h2
  have hF : LSeries (fun n => dirichletShift (-(α : ℝ) : ℂ)
      ((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ) n) s
      = riemannZeta (s - (α : ℂ)) := by
    rw [LSeries_dirichletShift, hminus, hcoeZ]
    exact LSeries_zeta_eq_riemannZeta h1
  have hG : LSeries (fun n => dirichletShift ((α : ℝ) : ℂ)
      ((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ) n) s
      = (riemannZeta (s + (α : ℂ)))⁻¹ := by
    rw [LSeries_dirichletShift, hplus, hcoeM]
    have h := LSeries_zeta_mul_Lseries_moebius h2
    rw [LSeries_zeta_eq_riemannZeta h2] at h
    exact eq_inv_of_mul_eq_one_left (by rw [mul_comm]; exact h)
  have hconv : (fun n => ((suzukiCoeffAF α) n))
      = LSeries.convolution
          (fun n => dirichletShift (-(α : ℝ) : ℂ)
            ((zeta : ArithmeticFunction ℕ) : ArithmeticFunction ℂ) n)
          (fun n => dirichletShift ((α : ℝ) : ℂ)
            ((moebius : ArithmeticFunction ℤ) : ArithmeticFunction ℂ) n) := by
    funext n
    rw [suzukiCoeffAF_eq_convolution α, ArithmeticFunction.mul_apply, LSeries.convolution_def]
  calc LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s
      = LSeries (fun n => ((suzukiCoeffAF α) n)) s :=
        (LSeries_congr (fun {n} hn => (suzukiCoeffAF_apply α hn).symm) s)
    _ = riemannZeta (s - (α : ℂ)) * (riemannZeta (s + (α : ℂ)))⁻¹ := by
        rw [hconv, LSeries_convolution' hsF hsG, hF, hG]
    _ = riemannZeta (s - (α : ℂ)) / riemannZeta (s + (α : ℂ)) := (div_eq_mul_inv _ _).symm

/-- **`(7)`, first equality.**  The packet connection is the Dirichlet series of the coefficients
`(5)`, so `(6)` is the coefficient reading of the same object as `(7)`. -/
theorem LSeries_suzukiShiftedCoefficient_eq_suzukiPacketDirichlet (α : ℝ) {s : ℂ}
    (h1 : 1 < (s - (α : ℂ)).re) (h2 : 1 < (s + (α : ℂ)).re) :
    LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s = suzukiPacketDirichlet α s := by
  rw [suzukiPacketDirichlet, LSeries_suzukiShiftedCoefficient α h1 h2]

/-- The same identity on the card's half-plane `re s > 1 + |α|`. -/
theorem LSeries_suzukiShiftedCoefficient_eq_of_abs_lt (α : ℝ) {s : ℂ} (hs : 1 + |α| < s.re) :
    LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s = suzukiPacketDirichlet α s := by
  have hle := le_abs_self α
  have hle' := neg_abs_le α
  refine LSeries_suzukiShiftedCoefficient_eq_suzukiPacketDirichlet α ?_ ?_
  · simp only [Complex.sub_re, Complex.ofReal_re]
    linarith
  · simp only [Complex.add_re, Complex.ofReal_re]
    linarith

/-! ### Termwise differentiation of the packet series -/

/-- The Dirichlet series of the von Mangoldt weights is the von Mangoldt current. -/
theorem LSeries_vonMangoldt_eq_current {s : ℂ} (hs : 1 < s.re) :
    LSeries (fun n => ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s = vonMangoldtCurrent s := by
  rw [LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs, vonMangoldtCurrent]

/-- Twice the von Mangoldt weights: the coefficientwise `α`-derivative of `(5)` at the origin. -/
theorem LSeries_two_mul_vonMangoldt {s : ℂ} (hs : 1 < s.re) :
    LSeries (fun n => ((2 * ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s
      = 2 * vonMangoldtCurrent s := by
  have hfun : (fun n : ℕ => ((2 * ArithmeticFunction.vonMangoldt n : ℝ) : ℂ))
      = (2 : ℂ) • fun n : ℕ => ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ) := by
    funext n
    simp [Pi.smul_apply, smul_eq_mul]
  rw [hfun, LSeries_smul, LSeries_vonMangoldt_eq_current hs]

/-- **Termwise differentiation of the packet series `(6) ⇒ (7)`.**  On `re s > 1` the `α`-derivative
at the origin of the Dirichlet series of the coefficients `(5)` is the Dirichlet series of their
coefficientwise derivatives `2Λ(n)`.  The interchange is not assumed: the series is the packet
connection on a whole neighbourhood of `α = 0`, whose normal derivative is already known. -/
theorem hasDerivAt_LSeries_suzukiShiftedCoefficient {s : ℂ} (hs : 1 < s.re) :
    HasDerivAt (fun α : ℝ => LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s)
      (LSeries (fun n => ((2 * ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s) 0 := by
  have hball : ∀ᶠ α : ℝ in nhds 0, |α| < s.re - 1 := by
    have hmem := Metric.ball_mem_nhds (0 : ℝ) (by linarith : (0 : ℝ) < s.re - 1)
    filter_upwards [hmem] with α hα
    simpa [Real.dist_eq] using hα
  have heq : (fun α : ℝ => LSeries (fun n => ((suzukiShiftedCoefficient α n : ℝ) : ℂ)) s)
      =ᶠ[nhds 0] fun α : ℝ => suzukiPacketDirichlet α s := by
    filter_upwards [hball] with α hα
    exact LSeries_suzukiShiftedCoefficient_eq_of_abs_lt α (by linarith)
  rw [LSeries_two_mul_vonMangoldt hs]
  exact (hasDerivAt_suzukiPacketDirichlet hs).congr_of_eventuallyEq heq

end

end RHTower
