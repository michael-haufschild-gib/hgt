import GaloisForLFunctions.RHTower.ThetaRenewalAnalyticContinuation
import GaloisForLFunctions.RHTower.PrimeArchThetaModularDifferentialClosure
import GaloisForLFunctions.HTGeometry.VolterraConvolutionCalculus

/-!
# The seam germ of the theta renewal kernel

The increment `ν` and the logarithmic kernel `Q` are real-analytic, hence smooth.  Differentiating
the Volterra law `c w = τν + ν ⋆ w` (`w = τQ`) at the origin with the iterated Leibniz rule gives
the jet recursion `c w^{(n+1)}(0) = (n+1) ν^{(n)}(0) + Σ_{j≤n} ν^{(j)}(0) w^{(n-j)}(0)`.

* The even jets are universal: the reflection profile `e^{-at} + tQ(t)` is even, so
  `Q^{(2j)}(0) = a^{2j+1}/(2j+1)`.
* Along renewal time `t = 2x` the theta profile obeys `P' = -P Ŝ/12`, where `(Ẑ, R̂, Ŝ)` is the
  reduced modular Riccati system with rational coefficients and seam values `(0, π c⁴, 0)`.  Hence
  `ν = P (1/4 + Ŝ/12)`, `ν'(0) = c (1/8 - π²c⁸/32)`, `P''(0)/c = -1/8 + π²c⁸/32` and
  `Q'(0) = a²/2 - P''(0)/c = (5 - π²c⁸)/32 < 0`.
* The `ℚ`-algebra generated by the modular coordinates is closed under differentiation, so every
  seam jet of `P/c`, of `ν/c` and, through the jet recursion, of `Q` lies in `ℚ[π c⁴]`.
-/

open Complex Filter Topology Set MeasureTheory HurwitzZeta
open GaloisForLFunctions.HTGeometry
open scoped ContDiff

noncomputable section

namespace RHTower

local notation "Θ" => evenKernel (0 : UnitAddCircle)

/-! ## Smoothness of the increment and of the logarithmic kernel -/

theorem analyticAt_thetaRenewalIncrement (t : ℝ) : AnalyticAt ℝ thetaRenewalIncrement t := by
  have hopen : thetaStrip ∈ 𝓝 (t : ℂ) :=
    isOpen_thetaStrip.mem_nhds (by simp [thetaStrip, Real.pi_pos])
  have hC : AnalyticAt ℂ thetaRenewalIncrementC (t : ℂ) :=
    differentiableOn_thetaRenewalIncrementC.analyticAt hopen
  have hR : AnalyticAt ℝ thetaRenewalIncrementC (t : ℂ) := hC.restrictScalars
  have hcomp : AnalyticAt ℝ (fun x : ℝ => (thetaRenewalIncrementC (x : ℂ)).re) t :=
    (Complex.reCLM.analyticAt _).comp (hR.comp (Complex.ofRealCLM.analyticAt t))
  refine hcomp.congr (Eventually.of_forall fun x => ?_)
  simp only [thetaRenewalIncrementC_ofReal, Complex.ofReal_re]

theorem contDiff_thetaRenewalIncrement : ContDiff ℝ ∞ thetaRenewalIncrement :=
  AnalyticOnNhd.contDiff fun t _ => analyticAt_thetaRenewalIncrement t

theorem contDiff_thetaRenewalLogKernel : ContDiff ℝ ∞ thetaRenewalLogKernel :=
  AnalyticOnNhd.contDiff fun t _ => analyticAt_thetaRenewalLogKernel t

theorem contDiff_thetaRenewalMomentKernel : ContDiff ℝ ∞ thetaRenewalMomentKernel :=
  contDiff_id.mul contDiff_thetaRenewalLogKernel

/-! ## The jet recursion of the Volterra law -/

/-- `w^{(n+1)}(0) = (n+1) Q^{(n)}(0)` for the moment kernel `w = τ Q`. -/
theorem iteratedDeriv_thetaRenewalMomentKernel_zero (n : ℕ) :
    iteratedDeriv (n + 1) thetaRenewalMomentKernel 0 =
      (n + 1) * iteratedDeriv n thetaRenewalLogKernel 0 := by
  have h := congrFun (iteratedDeriv_id_mul_real contDiff_thetaRenewalLogKernel n) 0
  simp only [zero_mul, zero_add] at h
  exact h

/-- **Jet recursion.** Differentiating the Volterra law `c w = τν + ν ⋆ w` at the origin:
`c w^{(n+1)}(0) = (n+1) ν^{(n)}(0) + Σ_{j≤n} ν^{(j)}(0) w^{(n-j)}(0)`. -/
theorem thetaRenewalMomentKernel_jet_recursion (n : ℕ) :
    Θ 1 * iteratedDeriv (n + 1) thetaRenewalMomentKernel 0 =
      (n + 1) * iteratedDeriv n thetaRenewalIncrement 0 +
        ∑ j ∈ Finset.range (n + 1), iteratedDeriv j thetaRenewalIncrement 0 *
          iteratedDeriv (n - j) thetaRenewalMomentKernel 0 := by
  have hν := contDiff_thetaRenewalIncrement
  have hw := contDiff_thetaRenewalMomentKernel
  have hlaw : (fun t => Θ 1 * thetaRenewalMomentKernel t) =
      (fun t => t * thetaRenewalIncrement t) +
        volterraConv thetaRenewalIncrement thetaRenewalMomentKernel := by
    funext t
    simp only [Pi.add_apply]
    exact thetaRenewal_volterra_law t
  have h := congrArg (fun F => iteratedDeriv (n + 1) F 0) hlaw
  have hτ : ContDiff ℝ ∞ fun t => t * thetaRenewalIncrement t := contDiff_id.mul hν
  have hconv : ContDiff ℝ ∞ (volterraConv thetaRenewalIncrement thetaRenewalMomentKernel) := by
    have : (volterraConv thetaRenewalIncrement thetaRenewalMomentKernel) =
        (fun t => Θ 1 * thetaRenewalMomentKernel t) - fun t => t * thetaRenewalIncrement t := by
      rw [hlaw]; funext t; simp
    rw [this]
    exact (contDiff_const.mul hw).sub hτ
  rw [iteratedDeriv_const_mul _ (hw.contDiffAt.of_le (natCast_lt_infty _).le),
    iteratedDeriv_add (hτ.contDiffAt.of_le (natCast_lt_infty _).le)
      (hconv.contDiffAt.of_le (natCast_lt_infty _).le),
    iteratedDeriv_id_mul_real hν, iteratedDeriv_volterraConv_zero hν hw] at h
  simp only [zero_mul, zero_add] at h
  rw [h]
  push_cast
  congr 1

/-! ## The even germ is universal -/

/-- **Even seam coefficients.** `Q^{(2j)}(0) = a^{2j+1}/(2j+1)`: the reflection profile
`e^{-at} + t Q(t)` is even, so its odd jets vanish. -/
theorem iteratedDeriv_even_thetaRenewalLogKernel_zero (j : ℕ) :
    iteratedDeriv (2 * j) thetaRenewalLogKernel 0 = (1 / 4) ^ (2 * j + 1) / (2 * j + 1) := by
  have hy : ContDiff ℝ ∞ thetaRenewalReflectionProfile :=
    (Real.contDiff_exp.comp (contDiff_id.div_const 4).neg).add contDiff_thetaRenewalMomentKernel
  have hodd : iteratedDeriv (2 * j + 1) thetaRenewalReflectionProfile 0 = 0 := by
    have h := iteratedDeriv_comp_neg (2 * j + 1) thetaRenewalReflectionProfile 0
    rw [show (fun x => thetaRenewalReflectionProfile (-x)) = thetaRenewalReflectionProfile from
      funext thetaRenewalReflectionProfile_neg, neg_zero, pow_succ, pow_mul] at h
    simp only [neg_one_sq, one_pow, one_mul, neg_smul, one_smul] at h
    linarith
  have hexp : ContDiff ℝ ∞ fun t : ℝ => Real.exp (-(1 / 4) * t) :=
    Real.contDiff_exp.comp (contDiff_const.mul contDiff_id)
  have hsplit : thetaRenewalReflectionProfile =
      (fun t => Real.exp (-(1 / 4) * t)) + thetaRenewalMomentKernel := by
    funext t; simp only [Pi.add_apply, thetaRenewalReflectionProfile]; ring_nf
  rw [hsplit, iteratedDeriv_add (hexp.contDiffAt.of_le (natCast_lt_infty _).le)
    (contDiff_thetaRenewalMomentKernel.contDiffAt.of_le (natCast_lt_infty _).le),
    iteratedDeriv_exp_const_mul, iteratedDeriv_thetaRenewalMomentKernel_zero] at hodd
  simp only [mul_zero, Real.exp_zero, mul_one] at hodd
  have h2 : (2 * (j : ℝ) + 1) ≠ 0 := by positivity
  rw [eq_div_iff h2]
  push_cast at hodd
  rw [Odd.neg_pow ⟨j, rfl⟩] at hodd
  linarith

/-! ## The modular coordinates along renewal time -/

/-- The modular-lambda coordinate at renewal time `t = 2x`. -/
def thetaRenewalLambdaCoord (t : ℝ) : ℝ :=
  (thetaCuspModularODEState HTGeometry.ModularThetaODEState.Z (t / 2)).re

/-- The modular scale coordinate `π H⁴` at renewal time `t = 2x`. -/
def thetaRenewalScaleCoord (t : ℝ) : ℝ :=
  (thetaCuspModularODEState HTGeometry.ModularThetaODEState.R (t / 2)).re

/-- The Riccati drift `S` at renewal time `t = 2x`. -/
def thetaRenewalDriftCoord (t : ℝ) : ℝ := (thetaCuspModularDrift (t / 2)).re

theorem hasDerivAt_thetaRenewalLambdaCoord (t : ℝ) :
    HasDerivAt thetaRenewalLambdaCoord
      (-(1 / 2) * (thetaRenewalScaleCoord t * (1 - thetaRenewalLambdaCoord t ^ 2))) t := by
  have h := (hasDerivAt_thetaCuspModularODEState_Z_re (t / 2)).comp t
    ((hasDerivAt_id t).div_const 2)
  exact h.congr_deriv (by simp only [thetaRenewalScaleCoord, thetaRenewalLambdaCoord]; ring)

theorem hasDerivAt_thetaRenewalScaleCoord (t : ℝ) :
    HasDerivAt thetaRenewalScaleCoord
      (-(1 / 3) * (thetaRenewalScaleCoord t * thetaRenewalDriftCoord t)) t := by
  have h := (hasDerivAt_thetaCuspModularODEState_R_re (t / 2)).comp t
    ((hasDerivAt_id t).div_const 2)
  exact h.congr_deriv (by simp only [thetaRenewalScaleCoord, thetaRenewalDriftCoord]; ring)

theorem hasDerivAt_thetaRenewalDriftCoord (t : ℝ) :
    HasDerivAt thetaRenewalDriftCoord
      (3 / 2 - thetaRenewalDriftCoord t ^ 2 / 6 -
        3 / 8 * (thetaRenewalScaleCoord t ^ 2 * (1 - thetaRenewalLambdaCoord t ^ 2))) t := by
  have h := (hasDerivAt_thetaCuspModularDrift_re (t / 2)).comp t ((hasDerivAt_id t).div_const 2)
  exact h.congr_deriv (by simp only [thetaRenewalScaleCoord, thetaRenewalDriftCoord, thetaRenewalLambdaCoord]; ring)

/-- The real theta mass obeys `H' = -H S/6`. -/
theorem hasDerivAt_completedThetaProfile_eq_drift (x : ℝ) :
    HasDerivAt Bottcher.completedThetaProfile
      (-(1 / 6) * Bottcher.completedThetaProfile x * (thetaCuspModularDrift x).re) x := by
  have hcomplex : HasDerivAt (thetaCuspModularODEState HTGeometry.ModularThetaODEState.H)
      (-(1 / 6 : ℂ) * thetaCuspModularODEState HTGeometry.ModularThetaODEState.H x *
        thetaCuspModularDrift x) x := by
    simpa [HTGeometry.modularThetaODEVectorField, thetaCuspModularDrift] using
      hasDerivAt_thetaCuspModularODEState x HTGeometry.ModularThetaODEState.H
  have hre : HasDerivAt
      (fun y => (thetaCuspModularODEState HTGeometry.ModularThetaODEState.H y).re)
      ((-(1 / 6 : ℂ) * thetaCuspModularODEState HTGeometry.ModularThetaODEState.H x *
        thetaCuspModularDrift x).re) x :=
    Complex.reCLM.hasFDerivAt.comp_hasDerivAt x hcomplex
  have hfun : (fun y => (thetaCuspModularODEState HTGeometry.ModularThetaODEState.H y).re) =
      Bottcher.completedThetaProfile := by
    funext y
    rw [thetaCuspModularODEState_H_eq_completedThetaProfile, Complex.ofReal_re]
  have hS := thetaCuspModularDrift_im_eq_zero x
  rw [hfun, thetaCuspModularODEState_H_eq_completedThetaProfile] at hre
  convert hre using 1
  norm_num [Complex.mul_re, hS]

theorem thetaLogProfile_eq_completedThetaProfile (t : ℝ) :
    thetaLogProfile t = Bottcher.completedThetaProfile (t / 2) := by
  rw [thetaLogProfile, Bottcher.completedThetaProfile, show t / 2 / 2 = t / 4 by ring,
    show 2 * (t / 2) = t by ring]

/-- `P' = -P Ŝ/12` along renewal time. -/
theorem hasDerivAt_thetaLogProfile_drift (t : ℝ) :
    HasDerivAt thetaLogProfile (-(1 / 12) * thetaLogProfile t * thetaRenewalDriftCoord t) t := by
  have h := (hasDerivAt_completedThetaProfile_eq_drift (t / 2)).comp t
    ((hasDerivAt_id t).div_const 2)
  have e : thetaLogProfile = Bottcher.completedThetaProfile ∘ fun x => id x / 2 :=
    funext fun x => thetaLogProfile_eq_completedThetaProfile x
  rw [e]
  exact h.congr_deriv (by simp only [thetaRenewalDriftCoord, Function.comp, id]; ring)

/-- `ν = P (1/4 + Ŝ/12)`. -/
theorem thetaRenewalIncrement_eq_drift (t : ℝ) :
    thetaRenewalIncrement t = thetaLogProfile t * (1 / 4 + thetaRenewalDriftCoord t / 12) := by
  have h := (hasDerivAt_thetaLogProfile t).unique (hasDerivAt_thetaLogProfile_drift t)
  linear_combination (-1 : ℝ) * h

theorem thetaRenewalLambdaCoord_zero : thetaRenewalLambdaCoord 0 = 0 := by
  simp [thetaRenewalLambdaCoord]

theorem thetaRenewalDriftCoord_zero : thetaRenewalDriftCoord 0 = 0 := by
  simpa [thetaRenewalDriftCoord] using thetaCuspModularDrift_re_zero

theorem completedThetaProfile_zero : Bottcher.completedThetaProfile 0 = Θ 1 := by
  simp [Bottcher.completedThetaProfile]

/-- At the seam the scale coordinate is the self-dual parameter `π c⁴`. -/
theorem thetaRenewalScaleCoord_zero : thetaRenewalScaleCoord 0 = Real.pi * Θ 1 ^ 4 := by
  simp only [thetaRenewalScaleCoord, zero_div]
  rw [thetaCuspModularODEState_R_eq_completedThetaProfile, Complex.ofReal_re,
    completedThetaProfile_zero]

/-! ## The first odd seam coefficient -/

theorem thetaLogProfile_zero' : thetaLogProfile 0 = Θ 1 := by simp [thetaLogProfile]

/-- `ν'(0) = c (1/8 - π²c⁸/32)`. -/
theorem hasDerivAt_thetaRenewalIncrement_zero :
    HasDerivAt thetaRenewalIncrement (Θ 1 * (1 / 8 - Real.pi ^ 2 * Θ 1 ^ 8 / 32)) 0 := by
  have h := (hasDerivAt_thetaLogProfile_drift 0).mul
    ((hasDerivAt_thetaRenewalDriftCoord 0).div_const 12 |>.const_add (1 / 4))
  rw [show (thetaLogProfile * fun x => 1 / 4 + thetaRenewalDriftCoord x / 12) =
    thetaRenewalIncrement from (funext thetaRenewalIncrement_eq_drift).symm] at h
  refine h.congr_deriv ?_
  rw [thetaRenewalDriftCoord_zero, thetaRenewalLambdaCoord_zero, thetaRenewalScaleCoord_zero,
    thetaLogProfile_zero']
  ring

/-- `P''(0)/c = -1/8 + π²c⁸/32`. -/
theorem iteratedDeriv_two_thetaLogProfile_zero :
    iteratedDeriv 2 thetaLogProfile 0 / Θ 1 = -(1 / 8) + Real.pi ^ 2 * Θ 1 ^ 8 / 32 := by
  have hc := thetaSeam_pos
  have hd : deriv thetaLogProfile = fun t => thetaLogProfile t / 4 - thetaRenewalIncrement t :=
    funext fun t => (hasDerivAt_thetaLogProfile t).deriv
  have h2 := ((hasDerivAt_thetaLogProfile 0).div_const 4).sub hasDerivAt_thetaRenewalIncrement_zero
  rw [show (2 : ℕ) = 1 + 1 from rfl, iteratedDeriv_succ, iteratedDeriv_one, hd,
    show (fun t => thetaLogProfile t / 4 - thetaRenewalIncrement t) =
      (fun t => thetaLogProfile t / 4) - thetaRenewalIncrement from rfl, h2.deriv,
    thetaLogProfile_zero', thetaRenewalIncrement_zero]
  field_simp
  ring

/-- **The first odd seam coefficient (17).** `Q'(0) = a²/2 + ν'(0)/c = (5 - π²c⁸)/32`. -/
theorem deriv_thetaRenewalLogKernel_zero :
    deriv thetaRenewalLogKernel 0 = (5 - Real.pi ^ 2 * Θ 1 ^ 8) / 32 := by
  have hc := thetaSeam_pos
  have hrec := thetaRenewalMomentKernel_jet_recursion 1
  rw [iteratedDeriv_thetaRenewalMomentKernel_zero 1, Finset.sum_range_succ,
    Finset.sum_range_one] at hrec
  simp only [Nat.sub_zero, Nat.sub_self, iteratedDeriv_zero] at hrec
  rw [show iteratedDeriv 1 thetaRenewalMomentKernel 0 = 1 * iteratedDeriv 0 thetaRenewalLogKernel 0
    by simpa using iteratedDeriv_thetaRenewalMomentKernel_zero 0] at hrec
  rw [iteratedDeriv_one, iteratedDeriv_one, hasDerivAt_thetaRenewalIncrement_zero.deriv,
    iteratedDeriv_zero, thetaRenewalLogKernel_zero, thetaRenewalIncrement_zero] at hrec
  simp only [thetaRenewalMomentKernel, zero_mul] at hrec
  push_cast at hrec
  have hc0 : Θ 1 ≠ 0 := hc.ne'
  apply mul_left_cancel₀ hc0
  linear_combination hrec / 2

/-- The seam form of (17): `Q'(0) = a²/2 - P''(0)/c`. -/
theorem deriv_thetaRenewalLogKernel_zero_eq_seam :
    deriv thetaRenewalLogKernel 0 = (1 / 4) ^ 2 / 2 - iteratedDeriv 2 thetaLogProfile 0 / Θ 1 := by
  rw [deriv_thetaRenewalLogKernel_zero, iteratedDeriv_two_thetaLogProfile_zero]
  ring

/-- `Q'(0) < 0`, since `π²c⁸ > 5`. -/
theorem deriv_thetaRenewalLogKernel_zero_neg : deriv thetaRenewalLogKernel 0 < 0 := by
  rw [deriv_thetaRenewalLogKernel_zero]
  have hc : 1 < Θ 1 := one_lt_evenKernel_zero one_pos
  have h8 : 1 < Θ 1 ^ 8 := one_lt_pow₀ hc (by norm_num)
  have hpi : 9 < Real.pi ^ 2 := by nlinarith [Real.pi_gt_three]
  have : 5 < Real.pi ^ 2 * Θ 1 ^ 8 := by nlinarith
  linarith

/-! ## Every seam jet lies in `ℚ[π c⁴]` -/

/-- The `ℚ`-algebra of real functions generated by the three modular coordinates. -/
def thetaRenewalModularAlgebra : Subalgebra ℚ (ℝ → ℝ) :=
  Algebra.adjoin ℚ {thetaRenewalLambdaCoord, thetaRenewalScaleCoord, thetaRenewalDriftCoord}

/-- The `ℚ`-algebra generated by the self-dual modular parameter `π c⁴`. -/
def thetaSelfDualSeamAlgebra : Subalgebra ℚ ℝ := Algebra.adjoin ℚ {Real.pi * Θ 1 ^ 4}

theorem thetaRenewalLambdaCoord_mem : thetaRenewalLambdaCoord ∈ thetaRenewalModularAlgebra :=
  Algebra.subset_adjoin (by simp)

theorem thetaRenewalScaleCoord_mem : thetaRenewalScaleCoord ∈ thetaRenewalModularAlgebra :=
  Algebra.subset_adjoin (by simp)

theorem thetaRenewalDriftCoord_mem : thetaRenewalDriftCoord ∈ thetaRenewalModularAlgebra :=
  Algebra.subset_adjoin (by simp)

/-- The modular algebra consists of differentiable functions and is closed under `d/dt`: the
reduced modular system has rational coefficients. -/
theorem thetaRenewalModularAlgebra_deriv {φ : ℝ → ℝ} (hφ : φ ∈ thetaRenewalModularAlgebra) :
    Differentiable ℝ φ ∧ deriv φ ∈ thetaRenewalModularAlgebra := by
  have hZ := thetaRenewalLambdaCoord_mem
  have hR := thetaRenewalScaleCoord_mem
  have hS := thetaRenewalDriftCoord_mem
  set 𝓡 := thetaRenewalModularAlgebra
  have hone : (1 : ℝ → ℝ) ∈ 𝓡 := Subalgebra.one_mem _
  refine Algebra.adjoin_induction (p := fun φ _ => Differentiable ℝ φ ∧ deriv φ ∈ 𝓡)
    ?_ ?_ ?_ ?_ hφ
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · refine ⟨fun t => (hasDerivAt_thetaRenewalLambdaCoord t).differentiableAt, ?_⟩
      have e : deriv thetaRenewalLambdaCoord =
          (-(1 / 2) : ℚ) • (thetaRenewalScaleCoord * (1 - thetaRenewalLambdaCoord ^ 2)) := by
        funext t
        rw [(hasDerivAt_thetaRenewalLambdaCoord t).deriv]
        simp [Rat.smul_def]
      rw [e]
      exact Subalgebra.smul_mem _ (Subalgebra.mul_mem _ hR
        (Subalgebra.sub_mem _ hone (Subalgebra.pow_mem _ hZ 2))) _
    · refine ⟨fun t => (hasDerivAt_thetaRenewalScaleCoord t).differentiableAt, ?_⟩
      have e : deriv thetaRenewalScaleCoord =
          (-(1 / 3) : ℚ) • (thetaRenewalScaleCoord * thetaRenewalDriftCoord) := by
        funext t
        rw [(hasDerivAt_thetaRenewalScaleCoord t).deriv]
        simp [Rat.smul_def]
      rw [e]
      exact Subalgebra.smul_mem _ (Subalgebra.mul_mem _ hR hS) _
    · refine ⟨fun t => (hasDerivAt_thetaRenewalDriftCoord t).differentiableAt, ?_⟩
      have e : deriv thetaRenewalDriftCoord =
          (3 / 2 : ℚ) • 1 - (1 / 6 : ℚ) • thetaRenewalDriftCoord ^ 2 -
            (3 / 8 : ℚ) • (thetaRenewalScaleCoord ^ 2 * (1 - thetaRenewalLambdaCoord ^ 2)) := by
        funext t
        rw [(hasDerivAt_thetaRenewalDriftCoord t).deriv]
        simp [Rat.smul_def]
        ring
      rw [e]
      exact Subalgebra.sub_mem _ (Subalgebra.sub_mem _ (Subalgebra.smul_mem _ hone _)
        (Subalgebra.smul_mem _ (Subalgebra.pow_mem _ hS 2) _))
        (Subalgebra.smul_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hR 2)
          (Subalgebra.sub_mem _ hone (Subalgebra.pow_mem _ hZ 2))) _)
  · intro r
    refine ⟨differentiable_const _, ?_⟩
    rw [show deriv (algebraMap ℚ (ℝ → ℝ) r) = 0 from funext fun t => deriv_const t _]
    exact Subalgebra.zero_mem _
  · intro x y _ _ hx hy
    refine ⟨hx.1.add hy.1, ?_⟩
    rw [show deriv (x + y) = deriv x + deriv y from
      funext fun t => ((hx.1 t).hasDerivAt.add (hy.1 t).hasDerivAt).deriv]
    exact Subalgebra.add_mem _ hx.2 hy.2
  · intro x y hx' hy' hx hy
    refine ⟨hx.1.mul hy.1, ?_⟩
    rw [show deriv (x * y) = deriv x * y + x * deriv y from
      funext fun t => ((hx.1 t).hasDerivAt.mul (hy.1 t).hasDerivAt).deriv]
    exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hx.2 hy') (Subalgebra.mul_mem _ hx' hy.2)

/-- Evaluation at the seam sends the modular algebra into `ℚ[π c⁴]`. -/
theorem thetaRenewalModularAlgebra_apply_zero {φ : ℝ → ℝ} (hφ : φ ∈ thetaRenewalModularAlgebra) :
    φ 0 ∈ thetaSelfDualSeamAlgebra := by
  refine Algebra.adjoin_induction (p := fun φ _ => φ 0 ∈ thetaSelfDualSeamAlgebra)
    ?_ ?_ ?_ ?_ hφ
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · rw [thetaRenewalLambdaCoord_zero]; exact Subalgebra.zero_mem _
    · rw [thetaRenewalScaleCoord_zero]; exact Algebra.subset_adjoin rfl
    · rw [thetaRenewalDriftCoord_zero]; exact Subalgebra.zero_mem _
  · intro r
    rw [Pi.algebraMap_apply]
    exact Subalgebra.algebraMap_mem _ r
  · intro x y _ _ hx hy
    exact Subalgebra.add_mem _ hx hy
  · intro x y _ _ hx hy
    exact Subalgebra.mul_mem _ hx hy

/-- The derivatives of `P φ`, `φ` modular, are again of the form `P ψ` with `ψ` modular. -/
theorem exists_iteratedDeriv_thetaLogProfile_mul (n : ℕ) {φ : ℝ → ℝ}
    (hφ : φ ∈ thetaRenewalModularAlgebra) :
    ∃ ψ ∈ thetaRenewalModularAlgebra,
      iteratedDeriv n (thetaLogProfile * φ) = thetaLogProfile * ψ := by
  induction n generalizing φ with
  | zero => exact ⟨φ, hφ, by simp⟩
  | succ n ih =>
    obtain ⟨hd, hd'⟩ := thetaRenewalModularAlgebra_deriv hφ
    have hderiv : deriv (thetaLogProfile * φ) =
        thetaLogProfile * (deriv φ - (1 / 12 : ℚ) • (thetaRenewalDriftCoord * φ)) := by
      funext t
      rw [((hasDerivAt_thetaLogProfile_drift t).mul (hd t).hasDerivAt).deriv]
      simp [Rat.smul_def]
      ring
    obtain ⟨ψ, hψ, h⟩ := ih (φ := deriv φ - (1 / 12 : ℚ) • (thetaRenewalDriftCoord * φ))
      (Subalgebra.sub_mem _ hd'
        (Subalgebra.smul_mem _ (Subalgebra.mul_mem _ thetaRenewalDriftCoord_mem hφ) _))
    exact ⟨ψ, hψ, by rw [iteratedDeriv_succ', hderiv, h]⟩

/-- Every seam jet of the theta profile, normalized by `c`, lies in `ℚ[π c⁴]`. -/
theorem iteratedDeriv_thetaLogProfile_zero_mem (n : ℕ) :
    iteratedDeriv n thetaLogProfile 0 / Θ 1 ∈ thetaSelfDualSeamAlgebra := by
  obtain ⟨ψ, hψ, h⟩ := exists_iteratedDeriv_thetaLogProfile_mul n
    (Subalgebra.one_mem thetaRenewalModularAlgebra)
  rw [mul_one] at h
  rw [h, Pi.mul_apply, thetaLogProfile_zero', mul_div_cancel_left₀ _ thetaSeam_pos.ne']
  exact thetaRenewalModularAlgebra_apply_zero hψ

/-- Every seam jet of the renewal increment, normalized by `c`, lies in `ℚ[π c⁴]`. -/
theorem iteratedDeriv_thetaRenewalIncrement_zero_mem (n : ℕ) :
    iteratedDeriv n thetaRenewalIncrement 0 / Θ 1 ∈ thetaSelfDualSeamAlgebra := by
  have hmem : ((1 / 4 : ℚ) • (1 : ℝ → ℝ) + (1 / 12 : ℚ) • thetaRenewalDriftCoord) ∈
      thetaRenewalModularAlgebra :=
    Subalgebra.add_mem _ (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
      (Subalgebra.smul_mem _ thetaRenewalDriftCoord_mem _)
  have hν : thetaRenewalIncrement =
      thetaLogProfile * ((1 / 4 : ℚ) • (1 : ℝ → ℝ) + (1 / 12 : ℚ) • thetaRenewalDriftCoord) := by
    funext t
    rw [thetaRenewalIncrement_eq_drift]
    simp only [Pi.mul_apply, Pi.add_apply, Pi.smul_apply, Pi.one_apply, Rat.smul_def]
    push_cast
    ring
  obtain ⟨ψ, hψ, h⟩ := exists_iteratedDeriv_thetaLogProfile_mul n hmem
  rw [hν, h, Pi.mul_apply, thetaLogProfile_zero', mul_div_cancel_left₀ _ thetaSeam_pos.ne']
  exact thetaRenewalModularAlgebra_apply_zero hψ

theorem iteratedDeriv_thetaRenewalMomentKernel_zero_mem (n : ℕ) :
    iteratedDeriv n thetaRenewalMomentKernel 0 ∈ thetaSelfDualSeamAlgebra := by
  have hc := thetaSeam_pos
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases n with _ | n
    · rw [iteratedDeriv_zero, show thetaRenewalMomentKernel 0 = 0 by
        simp [thetaRenewalMomentKernel]]
      exact Subalgebra.zero_mem _
    · have hrec := thetaRenewalMomentKernel_jet_recursion n
      have heq : iteratedDeriv (n + 1) thetaRenewalMomentKernel 0 =
          ((n : ℝ) + 1) * (iteratedDeriv n thetaRenewalIncrement 0 / Θ 1) +
            ∑ j ∈ Finset.range (n + 1), (iteratedDeriv j thetaRenewalIncrement 0 / Θ 1) *
              iteratedDeriv (n - j) thetaRenewalMomentKernel 0 := by
        apply mul_left_cancel₀ hc.ne'
        rw [hrec, mul_add, Finset.mul_sum]
        congr 1
        · field_simp
        · refine Finset.sum_congr rfl fun j _ => ?_
          field_simp
      rw [heq]
      refine Subalgebra.add_mem _ (Subalgebra.mul_mem _ ?_
        (iteratedDeriv_thetaRenewalIncrement_zero_mem n)) (Subalgebra.sum_mem _ fun j hj => ?_)
      · exact_mod_cast Subalgebra.natCast_mem _ (n + 1)
      · exact Subalgebra.mul_mem _ (iteratedDeriv_thetaRenewalIncrement_zero_mem j)
          (ih _ (by rw [Finset.mem_range] at hj; omega))

/-- **The whole seam germ is modular.** Every derivative of the renewal kernel at the seam lies in
`ℚ[π c⁴]`: the modular ODE generates the jets of `P`, and the jet recursion of the Volterra law
transports them to `Q`. -/
theorem iteratedDeriv_thetaRenewalLogKernel_zero_mem (n : ℕ) :
    iteratedDeriv n thetaRenewalLogKernel 0 ∈ thetaSelfDualSeamAlgebra := by
  have h := iteratedDeriv_thetaRenewalMomentKernel_zero n
  have hn : ((n : ℝ) + 1) ≠ 0 := by positivity
  have heq : iteratedDeriv n thetaRenewalLogKernel 0 =
      (1 / ((n : ℚ) + 1)) • iteratedDeriv (n + 1) thetaRenewalMomentKernel 0 := by
    rw [h, Rat.smul_def]
    push_cast
    field_simp
  rw [heq]
  exact Subalgebra.smul_mem _ (iteratedDeriv_thetaRenewalMomentKernel_zero_mem (n + 1)) _

end RHTower
