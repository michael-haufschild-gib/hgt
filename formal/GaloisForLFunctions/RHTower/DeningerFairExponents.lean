import GaloisForLFunctions.RHTower.DeningerColimitDivisible
import GaloisForLFunctions.RHTower.DeningerColimitHomology

/-!
# A fair sequence of exponents

Taking the `n`-th exponent to be `n + 2` makes every nonzero integer divide some prefix product:
the product over a range of consecutive integers contains a multiple of the integer as soon as the
range reaches one, and multiples of it occur arbitrarily late.  So the divisibility hypothesis of
the colimit is not vacuous.

* `deningerFairExponent` : the sequence.
* `deningerFairExponent_dvd` : every nonzero integer divides some prefix product.
* `deningerRationalization` : the colimit over the fair sequence.
* `deningerRationalization_isZero_two`, `deningerRationalization_isZero` : its homology.
-/

namespace RHTower

open CategoryTheory CategoryTheory.Limits

universe u

namespace RootAdjunction

/-- **The fair sequence of exponents.** -/
def deningerFairExponent (n : ℕ) : ℤ := (n : ℤ) + 2

theorem deningerFairExponent_two_le (n : ℕ) : 2 ≤ (deningerFairExponent n).natAbs := by
  have : (deningerFairExponent n) = (n : ℤ) + 2 := rfl
  omega

/-- **Every nonzero integer divides some prefix product of the fair sequence.** -/
theorem deningerFairExponent_dvd (n : ℕ) (N : ℤ) (hN : N ≠ 0) :
    ∃ k, n ≤ k ∧ N ∣ ∏ i ∈ Finset.Ico n k, deningerFairExponent i := by
  classical
  set d : ℕ := N.natAbs with hd
  have hd1 : 1 ≤ d := by omega
  set i : ℕ := d * (n + 2) - 2 with hi
  have hdn : d * (n + 2) ≥ n + 2 := Nat.le_mul_of_pos_left _ (by omega)
  have hin : n ≤ i := by omega
  refine ⟨i + 1, by omega, ?_⟩
  have hmem : i ∈ Finset.Ico n (i + 1) := by
    simp only [Finset.mem_Ico]
    omega
  have hdvd : deningerFairExponent i ∣ ∏ j ∈ Finset.Ico n (i + 1), deningerFairExponent j :=
    Finset.dvd_prod_of_mem _ hmem
  refine dvd_trans ?_ hdvd
  have hval : deningerFairExponent i = (d : ℤ) * ((n : ℤ) + 2) := by
    have h1 : (i : ℤ) + 2 = (d : ℤ) * ((n : ℤ) + 2) := by
      have : (i : ℤ) = ((d * (n + 2) : ℕ) : ℤ) - 2 := by
        rw [hi]
        omega
      rw [this]
      push_cast
      ring
    exact h1
  rw [hval]
  exact Dvd.dvd.mul_right (Int.natAbs_dvd.1 dvd_rfl) _

/-- **The rationalization of an infinite cyclic group**, as the colimit of the tower over the fair
sequence of exponents. -/
noncomputable def deningerRationalization : GrpCat.{u} :=
  deningerTowerColimit deningerIntStage.{u} deningerFairExponent

/-- The infinite cyclic starting stage is generated by its distinguished element. -/
theorem deningerIntStage_cyclic (x : deningerIntStage.{u}.carrier) :
    x ∈ Subgroup.zpowers deningerIntStage.{u}.elt := by
  refine ⟨Multiplicative.toAdd (MulEquiv.ulift x), ?_⟩
  show deningerRootGen.{u} ^ (Multiplicative.toAdd (MulEquiv.ulift x)) = x
  apply MulEquiv.ulift.injective
  apply Multiplicative.toAdd.injective
  simp [deningerRootGen]

/-- **The rationalization has unique roots.** -/
theorem deningerRationalization_uniqueRoots (x y : deningerRationalization.{u}) (k : ℕ)
    (hk : 0 < k) (h : x ^ k = y ^ k) : x = y :=
  deningerTowerColimit_uniqueRoots deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int x y k hk h

/-- **The rationalization is divisible.** -/
theorem deningerRationalization_divisible (x : deningerRationalization.{u}) (N : ℤ) (hN : N ≠ 0) :
    ∃ y : deningerRationalization.{u}, y ^ N = x :=
  deningerTowerColimit_divisible deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int deningerIntStage_cyclic
    (fun n N hN => deningerFairExponent_dvd n N hN) x N hN

/-- **The rationalization is torsion free.** -/
theorem deningerRationalization_torsionFree (x : deningerRationalization.{u}) (n : ℕ) (hn : 0 < n)
    (h : x ^ n = 1) : x = 1 :=
  deningerTowerColimit_torsionFree deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int x n hn h

/-- **The rationalization has no second homology.** -/
theorem deningerRationalization_isZero_two (k : Type u) [Field k] [CharZero k] :
    IsZero (groupHomology (Rep.trivial k deningerRationalization.{u} k) 2) := by
  classical
  exact deningerTowerColimit_isZero_two k deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int
    (deningerZ_isZero k MulEquiv.ulift 0)

/-- **The rationalization has no homology in degrees at least three.** -/
theorem deningerRationalization_isZero (k : Type u) [CommRing k] (j : ℕ) :
    IsZero (groupHomology (Rep.trivial k deningerRationalization.{u} k) (j + 3)) := by
  classical
  refine deningerTowerColimit_isZero k deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int (j + 2) (fun n => ?_)
  exact deningerRootTower_isZero k deningerIntStage.{u} deningerFairExponent
    deningerFairExponent_two_le deningerGoodStage_int j
    (deningerZ_isZero k MulEquiv.ulift (j + 1)) n

end RootAdjunction

end RHTower
