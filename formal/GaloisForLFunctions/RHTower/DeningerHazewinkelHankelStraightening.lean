import GaloisForLFunctions.HTGeometry.AlternantVandermondeDivisibility
import GaloisForLFunctions.RHTower.DeningerHazewinkelSylvesterContainment

/-!
# Integral straightening of universal Hankel minors

This module formalizes the integral Gruson--Peskine/Hazewinkel straightening theorem.  Every
square minor of a Hankel matrix over an arbitrary commutative ring is an integer linear
combination of minors with the same size and consecutive rows.

The proof is division-free.  An arbitrary alternant is divided by the Vandermonde determinant in
the integer multivariate polynomial ring.  A `ℤ`-linear, deliberately nonmultiplicative column
polarization sends the resulting polynomial identity to the desired determinant identity.  Thus
the result survives evaluation in rings with nilpotents and zero divisors.

For Hazewinkel's universal matrix this proves that the ideal of all `(n+1)`-minors equals the ideal
generated by the fixed rows `0,...,n`.  Combined with the previously formalized adjugate exchange,
it gives the full Appendix A.1 containment `Dₙ Jₙ ≤ Kₙ`.
-/

namespace RHTower

noncomputable section
open scoped BigOperators

/-! ## Integral alternants -/

/-- The `ℤ`-linear column polarization sends `x^p` to `∏ j, B (p j) j`.

It is not a ring map: addition of exponents is translated into independent row shifts in the
columns.  This is the exact polarization needed to turn an alternant identity into a determinant
identity for an arbitrary matrix. -/
def deningerAlternantColumnPolarization {R : Type*} [CommRing R] {n : ℕ}
    (B : ℕ → Fin n → R) : MvPolynomial (Fin n) ℤ →ₗ[ℤ] R :=
  (Finsupp.linearCombination ℤ
      (fun p : Fin n →₀ ℕ => ∏ j : Fin n, B (p j) j)).comp
    (AddMonoidAlgebra.coeffLinearEquiv ℤ).toLinearMap

@[simp] theorem deningerAlternantColumnPolarization_monomial
    {R : Type*} [CommRing R] {n : ℕ} (B : ℕ → Fin n → R)
    (p : Fin n →₀ ℕ) (c : ℤ) :
    deningerAlternantColumnPolarization B (MvPolynomial.monomial p c) =
      (c : R) * ∏ j : Fin n, B (p j) j := by
  change (Finsupp.linearCombination ℤ
      (fun p : Fin n →₀ ℕ => ∏ j : Fin n, B (p j) j))
      (Finsupp.single p c) = _
  rw [Finsupp.linearCombination_single, zsmul_eq_mul]

/-- Alternant whose rows carry the exponent family `e`. -/
def deningerPowerAlternant {n : ℕ} (e : Fin n → ℕ) : MvPolynomial (Fin n) ℤ :=
  Matrix.det fun i j => MvPolynomial.X j ^ e i

/-- Basic alternant with exponents `0,...,n-1`, i.e. the Vandermonde determinant. -/
def deningerBaseAlternant (n : ℕ) : MvPolynomial (Fin n) ℤ :=
  deningerPowerAlternant fun i => i.val

/-- The basic alternant divides every integral alternant. -/
theorem deningerBaseAlternant_dvd_power {n : ℕ} (e : Fin n → ℕ) :
    deningerBaseAlternant n ∣ deningerPowerAlternant e := by
  have h := GaloisForLFunctions.HTGeometry.vandermondeProd_dvd_det_pow
    (R := MvPolynomial (Fin n) ℤ) (fun j : Fin n => MvPolynomial.X j) e
  rw [← Matrix.det_transpose] at h
  change _ ∣ deningerPowerAlternant e at h
  have hbase : deningerBaseAlternant n =
      GaloisForLFunctions.HTGeometry.vandermondeProd
        (fun j : Fin n => MvPolynomial.X j) := by
    rw [deningerBaseAlternant, deningerPowerAlternant, ← Matrix.det_transpose]
    change (Matrix.vandermonde (fun j : Fin n => MvPolynomial.X j)).det = _
    exact Matrix.det_vandermonde _
  rwa [hbase]

/-- Exponent vector occurring in the Leibniz term indexed by `σ`. -/
def deningerAlternantExponent {n : ℕ} (e : Fin n → ℕ)
    (σ : Equiv.Perm (Fin n)) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun j => e (σ j))

@[simp] theorem deningerAlternantExponent_apply {n : ℕ} (e : Fin n → ℕ)
    (σ : Equiv.Perm (Fin n)) (j : Fin n) :
    deningerAlternantExponent e σ j = e (σ j) := by
  simp [deningerAlternantExponent]

/-- Each Leibniz term of an alternant is the corresponding multivariate monomial. -/
theorem deningerAlternant_detTerm_eq_monomial {n : ℕ} (e : Fin n → ℕ)
    (σ : Equiv.Perm (Fin n)) :
    ((Equiv.Perm.sign σ : ℤ) : MvPolynomial (Fin n) ℤ) *
        ∏ j : Fin n, MvPolynomial.X j ^ e (σ j) =
      MvPolynomial.monomial (deningerAlternantExponent e σ)
        (Equiv.Perm.sign σ : ℤ) := by
  rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype]
  simp
  intro i
  simp

/-! ## Column polarization of alternants -/

/-- Polarizing a power alternant selects the prescribed rows of an arbitrary column array. -/
theorem deningerAlternantColumnPolarization_powerAlternant
    {R : Type*} [CommRing R] {n : ℕ} (B : ℕ → Fin n → R) (e : Fin n → ℕ) :
    deningerAlternantColumnPolarization B (deningerPowerAlternant e) =
      Matrix.det (fun i j : Fin n => B (e i) j) := by
  rw [deningerPowerAlternant, Matrix.det_apply', Matrix.det_apply', map_sum]
  apply Finset.sum_congr rfl
  intro σ hσ
  rw [deningerAlternant_detTerm_eq_monomial,
    deningerAlternantColumnPolarization_monomial]
  congr 1

/-- A monomial times the basic alternant polarizes to a consecutive-row determinant whose
`j`-th column starts at `p j`. -/
theorem deningerAlternantColumnPolarization_monomial_mul_base
    {R : Type*} [CommRing R] {n : ℕ} (B : ℕ → Fin n → R)
    (p : Fin n →₀ ℕ) (c : ℤ) :
    deningerAlternantColumnPolarization B
        (MvPolynomial.monomial p c * deningerBaseAlternant n) =
      (c : R) * Matrix.det (fun i j : Fin n => B (p j + i.val) j) := by
  rw [deningerBaseAlternant, deningerPowerAlternant, Matrix.det_apply', Finset.mul_sum,
    map_sum, Matrix.det_apply', Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro σ hσ
  rw [deningerAlternant_detTerm_eq_monomial, MvPolynomial.monomial_mul,
    deningerAlternantColumnPolarization_monomial]
  simp only [Int.cast_mul, Finsupp.add_apply, deningerAlternantExponent_apply]
  ring

/-- Polarizing an arbitrary polynomial times the basic alternant gives the finite sum of shifted
consecutive-row determinants indexed by its monomial support. -/
theorem deningerAlternantColumnPolarization_mul_base
    {R : Type*} [CommRing R] {n : ℕ} (B : ℕ → Fin n → R)
    (q : MvPolynomial (Fin n) ℤ) :
    deningerAlternantColumnPolarization B (q * deningerBaseAlternant n) =
      ∑ p ∈ q.support, ((MvPolynomial.coeff p q : ℤ) : R) *
        Matrix.det (fun i j : Fin n => B (p j + i.val) j) := by
  conv_lhs => rw [q.as_sum, Finset.sum_mul]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro p hp
  exact deningerAlternantColumnPolarization_monomial_mul_base B p
    (MvPolynomial.coeff p q)

/-- Integral quotient of an arbitrary alternant by the basic Vandermonde alternant. -/
noncomputable def deningerAlternantStraighteningQuotient {n : ℕ} (e : Fin n → ℕ) :
    MvPolynomial (Fin n) ℤ :=
  (deningerBaseAlternant_dvd_power e).choose

theorem deningerAlternantStraighteningQuotient_spec {n : ℕ} (e : Fin n → ℕ) :
    deningerBaseAlternant n * deningerAlternantStraighteningQuotient e =
      deningerPowerAlternant e := by
  exact (deningerBaseAlternant_dvd_power e).choose_spec.symm

/-! ## Integral Hankel straightening -/

/-- **Integral Hankel straightening.** Every square Hankel minor over an arbitrary commutative
ring is an integer linear combination of minors with the same size and rows `0,...,n-1`.

No domain, reducedness, characteristic, or distinct-selector premise is used. -/
theorem deningerHankelMinor_eq_sum_fixed
    {R : Type*} [CommRing R] {n : ℕ} (a : ℕ → R) (rows cols : Fin n → ℕ) :
    Matrix.det (fun i j : Fin n => a (rows i + cols j)) =
      ∑ p ∈ (deningerAlternantStraighteningQuotient rows).support,
        ((MvPolynomial.coeff p
          (deningerAlternantStraighteningQuotient rows) : ℤ) : R) *
          Matrix.det (fun i j : Fin n => a (i.val + (cols j + p j))) := by
  let B : ℕ → Fin n → R := fun t j => a (t + cols j)
  calc
    Matrix.det (fun i j : Fin n => a (rows i + cols j)) =
        deningerAlternantColumnPolarization B (deningerPowerAlternant rows) := by
          rw [deningerAlternantColumnPolarization_powerAlternant]
    _ = deningerAlternantColumnPolarization B
        (deningerAlternantStraighteningQuotient rows * deningerBaseAlternant n) := by
          rw [← deningerAlternantStraighteningQuotient_spec, mul_comm]
    _ = ∑ p ∈ (deningerAlternantStraighteningQuotient rows).support,
        ((MvPolynomial.coeff p
          (deningerAlternantStraighteningQuotient rows) : ℤ) : R) *
          Matrix.det (fun i j : Fin n => B (p j + i.val) j) :=
          deningerAlternantColumnPolarization_mul_base B _
    _ = _ := by
      apply Finset.sum_congr rfl
      intro p hp
      congr 1
      apply congrArg Matrix.det
      ext i j
      dsimp [B]
      congr 1
      omega

/-! ## Universal Hazewinkel ideal equality -/

/-- Every universal Hankel minor belongs to the ideal generated by consecutive-row minors. -/
theorem deningerHazewinkelIdeal_le_fixedRowMinorIdeal (n : ℕ) :
    deningerHazewinkelIdeal n ≤ deningerHazewinkelFixedRowMinorIdeal n := by
  rw [deningerHazewinkelIdeal, deningerMatrixMinorIdeal, Ideal.span_le]
  rintro z ⟨rows, cols, rfl⟩
  change Matrix.det
      (fun i j : Fin (n + 1) =>
        deningerHazewinkelUniversalCoeff (rows i + cols j)) ∈
    deningerHazewinkelFixedRowMinorIdeal n
  rw [deningerHankelMinor_eq_sum_fixed]
  apply Ideal.sum_mem
  intro p hp
  apply Ideal.mul_mem_left
  apply Ideal.subset_span
  refine ⟨fun j : Fin (n + 1) => cols j + p j, ?_⟩
  congr 1

/-- **Gruson--Peskine/Hazewinkel fixed-row generation over `ℤ`.** The ideal of all universal
Hankel `(n+1)`-minors equals the ideal generated by the rows `0,...,n`. -/
theorem deningerHazewinkelFixedRowMinorIdeal_eq_ideal (n : ℕ) :
    deningerHazewinkelFixedRowMinorIdeal n = deningerHazewinkelIdeal n := by
  apply le_antisymm
  · exact deningerHazewinkelFixedRowMinorIdeal_le_ideal n
  · exact deningerHazewinkelIdeal_le_fixedRowMinorIdeal n

/-- Full Hazewinkel Appendix A.1 containment after integral fixed-row straightening. -/
theorem deningerHazewinkel_leadingIdeal_mul_ideal_le_special (n : ℕ) :
    Ideal.span {deningerHazewinkelLeadingDeterminant n} *
        deningerHazewinkelIdeal n ≤
      deningerHazewinkelSpecialMinorIdeal n := by
  rw [← deningerHazewinkelFixedRowMinorIdeal_eq_ideal]
  exact deningerHazewinkel_leadingIdeal_mul_fixedRow_le_special n

end

end RHTower
