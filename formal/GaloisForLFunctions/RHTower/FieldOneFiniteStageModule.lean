import GaloisForLFunctions.RHTower.FieldOneFiniteStageClassTopology
import Mathlib.NumberTheory.NumberField.Completion.FinitePlace
import Mathlib.NumberTheory.Padics.HeightOneSpectrum

/-!
# The module on finite-stage idele classes

For a finite set `S` of rational finite places, this file constructs the
finite-stage idele module

`|(u∞, (uᵥ))|ₛ = |u∞| ∏ᵥ |uᵥ|`

and proves directly that it is trivial on the diagonal rational `S`-units.
Consequently it descends to the finite-stage idele class group.

This is the product-formula input to the semilocal quotient construction.  It
does not assert existence of a quotient measure, identify a Haar scaling
character, or prove any positivity statement.
-/

namespace GaloisForLFunctions.RHTower

noncomputable section

open IsDedekindDomain
open scoped NNReal

/-- Product of the real and selected nonarchimedean norms on finite-stage
ideles. -/
def fieldOneFiniteStageModule
    (S : Finset (HeightOneSpectrum ℤ)) :
    FieldOneFiniteStageIdele S →* ℝ≥0 where
  toFun u :=
    ‖(u.1 : ℝ)‖₊ *
      ∏ v : ↥S, ‖(u.2 v : v.1.adicCompletion ℚ)‖₊
  map_one' := by simp
  map_mul' u w := by
    simp only [Prod.fst_mul, Prod.snd_mul, Units.val_mul,
      Pi.mul_apply, nnnorm_mul]
    rw [Finset.prod_mul_distrib]
    ac_rfl

/-- The diagonal sign unit has finite-stage module one. -/
theorem fieldOneFiniteStageModule_negOne
    (S : Finset (HeightOneSpectrum ℤ)) :
    fieldOneFiniteStageModule S
      (fieldOneFiniteStageDiagonalUnit S (-1)) = 1 := by
  simp [fieldOneFiniteStageModule,
    fieldOneFiniteStageDiagonalUnit,
    fieldOneRationalRealUnit,
    fieldOneRationalFiniteStageUnit,
    fieldOneRationalLocalUnit]

/-- A rational finite place is the ideal generated by its associated positive
prime. -/
theorem fieldOneHeightOneSpectrum_asIdeal
    (v : HeightOneSpectrum ℤ) :
    v.asIdeal =
      Ideal.span
        {((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℤ)} := by
  have heq :
      Rat.IsIntegralClosure.intEquiv ℤ =
        RingEquiv.refl ℤ := by
    ext n
    simp
  change
    v.asIdeal =
      Ideal.span
        {((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ)}
  have hmap :
      Ideal.map (RingEquiv.refl ℤ) v.asIdeal = v.asIdeal := by
    change Ideal.map (RingHom.id ℤ) v.asIdeal = v.asIdeal
    exact v.asIdeal.map_id
  exact
    ((Rat.HeightOneSpectrum.span_natGenerator v).trans
      (by simpa only [heq] using hmap)).symm

/-- At its own completion, the norm of a rational prime is the inverse of that
prime. -/
theorem fieldOneRationalPrimeUnit_localNorm_self
    (v : HeightOneSpectrum ℤ) :
    ‖algebraMap ℚ (v.adicCompletion ℚ)
        (Rat.HeightOneSpectrum.primesEquiv v : ℚ)‖ =
      ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℝ)⁻¹ := by
  change
    ‖(NumberField.FinitePlace.embedding v)
        (Rat.HeightOneSpectrum.primesEquiv v : ℚ)‖ = _
  rw [NumberField.FinitePlace.norm_embedding]
  have hspan := fieldOneHeightOneSpectrum_asIdeal v
  have habs :
      Ideal.absNorm v.asIdeal =
        (Rat.HeightOneSpectrum.primesEquiv v : ℕ) := by
    rw [hspan, Ideal.absNorm_span_singleton]
    simp
  have hp :
      ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℤ) ≠ 0 := by
    exact_mod_cast
      (Rat.HeightOneSpectrum.primesEquiv v).property.ne_zero
  have hval :
      v.valuation ℚ
          (Rat.HeightOneSpectrum.primesEquiv v : ℚ) =
        v.intValuation
          ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℤ) := by
    simpa using
      (IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap
        (v := v) (K := ℚ)
        ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℤ))
  have hexp_ne : WithZero.exp (-1 : ℤ) ≠ 0 := by
    simp
  have hunzero :
      Multiplicative.toAdd
          (WithZero.unzero hexp_ne) = (-1 : ℤ) := by
    rfl
  rw [NumberField.HeightOneSpectrum.adicAbv_def, hval,
    v.intValuation_singleton hp hspan]
  rw [WithZeroMulInt.toNNReal_neg_apply _ hexp_ne]
  rw [hunzero]
  simp [habs]

/-- At a different completion, the norm of a rational prime is one. -/
theorem fieldOneRationalPrimeUnit_localNorm_of_ne
    (v w : HeightOneSpectrum ℤ)
    (hvw : w ≠ v) :
    ‖algebraMap ℚ (w.adicCompletion ℚ)
        (Rat.HeightOneSpectrum.primesEquiv v : ℚ)‖ = 1 := by
  change
    ‖(NumberField.FinitePlace.embedding w)
        (algebraMap ℤ ℚ
          ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℤ))‖ = 1
  rw [NumberField.FinitePlace.norm_eq_one_iff_notMem]
  intro hmem
  have hvw_le : v.asIdeal ≤ w.asIdeal := by
    rw [fieldOneHeightOneSpectrum_asIdeal v]
    exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
  apply hvw
  exact
    HeightOneSpectrum.ext_iff.mpr
      ((IsDedekindDomain.HeightOneSpectrum.isMaximal v).eq_of_le
        (IsDedekindDomain.HeightOneSpectrum.isPrime w).ne_top
        hvw_le).symm

/-- The diagonal unit associated with each prime selected by `S` has
finite-stage module one. -/
theorem fieldOneFiniteStageModule_prime
    (S : Finset (HeightOneSpectrum ℤ))
    (v : ↥S) :
    fieldOneFiniteStageModule S
      (fieldOneFiniteStageDiagonalUnit S
        (fieldOneRationalPrimeUnit v.1)) = 1 := by
  classical
  change
    ‖(((Rat.HeightOneSpectrum.primesEquiv v.1 : ℕ) : ℚ) : ℝ)‖₊ *
        ∏ w : ↥S,
          ‖algebraMap ℚ (w.1.adicCompletion ℚ)
            (Rat.HeightOneSpectrum.primesEquiv v.1 : ℚ)‖₊ =
      1
  rw [Finset.prod_eq_single v]
  · rw [show
      ‖algebraMap ℚ (v.1.adicCompletion ℚ)
          (Rat.HeightOneSpectrum.primesEquiv v.1 : ℚ)‖₊ =
        (((Rat.HeightOneSpectrum.primesEquiv v.1 : ℕ) : ℝ≥0)⁻¹) by
      apply NNReal.eq
      simpa using fieldOneRationalPrimeUnit_localNorm_self v.1]
    have hpnn :
        (((Rat.HeightOneSpectrum.primesEquiv v.1 : ℕ) : ℝ≥0)) ≠ 0 := by
      exact_mod_cast
        (Rat.HeightOneSpectrum.primesEquiv v.1).property.ne_zero
    simpa using mul_inv_cancel₀ hpnn
  · intro w _ hwv
    apply NNReal.eq
    simpa using
      fieldOneRationalPrimeUnit_localNorm_of_ne v.1 w.1
        (fun h => hwv (Subtype.ext h))
  · simp

/-- Every rational `S`-unit lies in the kernel of the diagonal finite-stage
module. -/
theorem fieldOneSUnitSubgroup_le_moduleKernel
    (S : Finset (HeightOneSpectrum ℤ)) :
    fieldOneSUnitSubgroup S ≤
      ((fieldOneFiniteStageModule S).comp
        (fieldOneFiniteStageDiagonalUnit S)).ker := by
  rw [fieldOneSUnitSubgroup]
  rw [Subgroup.closure_le]
  intro u hu
  rcases Set.eq_or_mem_of_mem_insert hu with rfl | hu
  · change
      fieldOneFiniteStageModule S
          (fieldOneFiniteStageDiagonalUnit S (-1)) = 1
    exact fieldOneFiniteStageModule_negOne S
  · obtain ⟨v, rfl⟩ := hu
    change
      fieldOneFiniteStageModule S
          (fieldOneFiniteStageDiagonalUnit S
            (fieldOneRationalPrimeUnit v.1)) = 1
    exact fieldOneFiniteStageModule_prime S v

/-- The diagonal image of rational `S`-units lies in the finite-stage module
kernel. -/
theorem fieldOneFiniteStageSUnitImage_le_moduleKernel
    (S : Finset (HeightOneSpectrum ℤ)) :
    fieldOneFiniteStageSUnitImage S ≤
      (fieldOneFiniteStageModule S).ker := by
  intro u hu
  obtain ⟨q, hq, rfl⟩ := hu
  exact fieldOneSUnitSubgroup_le_moduleKernel S hq

/-- Module character on finite-stage idele classes, descended through the
diagonal rational `S`-unit quotient. -/
def fieldOneFiniteStageIdeleClassModule
    (S : Finset (HeightOneSpectrum ℤ)) :
    FieldOneFiniteStageIdeleClassGroup S →* ℝ≥0 :=
  QuotientGroup.lift
    (fieldOneFiniteStageSUnitImage S)
    (fieldOneFiniteStageModule S)
    (fieldOneFiniteStageSUnitImage_le_moduleKernel S)

/-- The descended module is computed on representatives by the original
finite product of local norms. -/
theorem fieldOneFiniteStageIdeleClassModule_mk
    (S : Finset (HeightOneSpectrum ℤ))
    (u : FieldOneFiniteStageIdele S) :
    fieldOneFiniteStageIdeleClassModule S
      (QuotientGroup.mk'
        (fieldOneFiniteStageSUnitImage S) u) =
      fieldOneFiniteStageModule S u := by
  rfl

end

end GaloisForLFunctions.RHTower
