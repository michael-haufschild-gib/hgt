import GaloisForLFunctions.RHTower.CompactCarrierFrequencyCompleteness
import GaloisForLFunctions.RHTower.CriticalDiscEulerOrbitDensity
import GaloisForLFunctions.RHTower.OneDimensionalPowerSeriesPolynomial

/-!
# Universal reflected-Lambert completeness at the critical centre

This file lifts abstract sector-Blaschke completeness from compact-carrier
polynomials to analytic germs on a critical-centre disc.  It then descends
from complex to real span and upgrades tangent density to density of the
additive group generated by genuine, arbitrarily small, degree-one
multiplicative increments.

Prime logarithms are only one instance of the frequency hypothesis.
-/

noncomputable section

namespace RHTower

open Complex Metric Set Filter Topology ComplexConjugate
set_option maxHeartbeats 1000000

/-! ## Analytic reflected completeness -/

/-- Every analytic FE-odd critical-disc germ belongs to the closed span of
the reflected derivative-Lambert family for any strongly sector-Blaschke
complete frequency spectrum. -/
theorem criticalDisc_analytic_odd_mem_closedSpan_frequencyLambert
    {ι : Type*} (lambda : ι → ℝ) {R₀ : ℝ}
    (hR₀ : 0 < R₀)
    (hcomplete : StrongSectorBlaschkeComplete lambda R₀)
    (f : ℂ → ℂ) {r₀ r₁ : ℝ}
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z) :
    criticalDiscRestriction f r₀
        (hf.continuousOn_ball.mono
          (Metric.closedBall_subset_closedBall hr01.le)) ∈
      (Submodule.span ℂ
        (Set.range fun i : ι ↦
          compactFrequencyLambertFETangent
            (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
            (lambda i))).topologicalClosure := by
  have hr₁pos : 0 < r₁ := lt_of_le_of_lt hr₀ hr01
  let R : NNReal := ⟨r₁, hr₁pos.le⟩
  let rmid : NNReal := ⟨(r₀ + r₁) / 2, by linarith⟩
  let p : FormalMultilinearSeries ℂ ℂ ℂ :=
    cauchyPowerSeries f (1 / 2 : ℂ) R
  have hp : HasFPowerSeriesOnBall f p (1 / 2 : ℂ) R := by
    dsimp [p]
    exact hf.hasFPowerSeriesOnBall (by exact_mod_cast hr₁pos)
  have hrmid : (rmid : ENNReal) < (R : ENNReal) := by
    apply ENNReal.coe_lt_coe.mpr
    apply NNReal.coe_lt_coe.mp
    change (r₀ + r₁) / 2 < r₁
    linarith
  have hu := hp.tendstoUniformlyOn hrmid
  let P : ℕ → Polynomial ℂ := fun N ↦
    shiftedFmlsPolynomial p N (1 / 2 : ℂ)
  let q : ℕ → C(CriticalClosedDisc r₀, ℂ) := fun N ↦
    (1 / 2 : ℂ) •
      (compactPolynomialEval (criticalDiscCoordinate r₀) (P N) -
        compactPolynomialEval (1 - criticalDiscCoordinate r₀) (P N))
  let F : C(CriticalClosedDisc r₀, ℂ) :=
    criticalDiscRestriction f r₀
      (hf.continuousOn_ball.mono
        (Metric.closedBall_subset_closedBall hr01.le))
  have hqmem : ∀ N, q N ∈
      (Submodule.span ℂ
        (Set.range fun i : ι ↦
          compactFrequencyLambertFETangent
            (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
            (lambda i))).topologicalClosure := by
    intro N
    apply Submodule.smul_mem
    exact fe_odd_polynomial_mem_closedSpan_frequencyLambert
      lambda (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
      (criticalDiscCoordinate_reflection r₀)
      (1 / 2 - r₀) r₀ R₀
      (by linarith) hR₀ criticalDiscCoordinate_re_lower
      criticalDiscCoordinate_abs_im_le hcomplete (P N)
  have hqF : Tendsto q atTop (nhds F) := by
    apply Metric.tendsto_atTop.mpr
    intro ε hε
    have hevent : ∀ᶠ N : ℕ in atTop, ∀ y ∈ ball (0 : ℂ) rmid,
        dist (f ((1 / 2 : ℂ) + y)) (p.partialSum N y) < ε :=
      (Metric.tendstoUniformlyOn_iff.mp hu) ε hε
    obtain ⟨N₀, hN₀⟩ := eventually_atTop.1 hevent
    refine ⟨N₀, fun N hN ↦ ?_⟩
    rw [dist_eq_norm]
    apply (ContinuousMap.norm_lt_iff (q N - F) hε).2
    intro k
    change ‖q N k - F k‖ < ε
    let z : ℂ := (k : ℂ)
    let z' : ℂ := 1 - z
    let y : ℂ := z - 1 / 2
    let y' : ℂ := z' - 1 / 2
    have hk : ‖y‖ ≤ r₀ := by
      have hkdisc := k.prop
      rw [mem_closedBall, dist_eq] at hkdisc
      simpa [y, z] using hkdisc
    have hk' : ‖y'‖ ≤ r₀ := by
      have heq : y' = -y := by
        dsimp [y', y, z']
        ring
      rw [heq, norm_neg]
      exact hk
    have hrmidR : r₀ < (rmid : ℝ) := by
      change r₀ < (r₀ + r₁) / 2
      linarith
    have hy : y ∈ ball (0 : ℂ) rmid := by
      simpa [mem_ball, dist_zero_right] using hk.trans_lt hrmidR
    have hy' : y' ∈ ball (0 : ℂ) rmid := by
      simpa [mem_ball, dist_zero_right] using hk'.trans_lt hrmidR
    have happrox := hN₀ N hN y hy
    have happrox' := hN₀ N hN y' hy'
    have hP : (P N).eval z = p.partialSum N y := by
      simpa [P, y, z] using
        shiftedFmlsPolynomial_eval p N (1 / 2 : ℂ) z
    have hP' : (P N).eval z' = p.partialSum N y' := by
      simpa [P, y', z'] using
        shiftedFmlsPolynomial_eval p N (1 / 2 : ℂ) z'
    have hzmem : z ∈ closedBall (1 / 2 : ℂ) r₀ := k.prop
    have hoddz := hodd z hzmem
    have happroxNorm : ‖(P N).eval z - f z‖ < ε := by
      rw [hP]
      have hcenter : (1 / 2 : ℂ) + y = z := by
        dsimp [y]
        ring
      rw [hcenter] at happrox
      simpa [dist_eq_norm, norm_sub_rev] using happrox
    have happroxNorm' : ‖(P N).eval z' - f z'‖ < ε := by
      rw [hP']
      have hcenter : (1 / 2 : ℂ) + y' = z' := by
        dsimp [y']
        ring
      rw [hcenter] at happrox'
      simpa [dist_eq_norm, norm_sub_rev] using happrox'
    have hqeq : q N k - F k =
        (1 / 2 : ℂ) *
          (((P N).eval z - f z) - ((P N).eval z' - f z')) := by
      simp only [q, F, ContinuousMap.smul_apply, ContinuousMap.sub_apply,
        compactPolynomialEval_apply, criticalDiscRestriction,
        criticalDiscCoordinate]
      dsimp [z, z'] at hoddz ⊢
      rw [hoddz]
      ring
    rw [hqeq, norm_mul]
    have hhalf : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
    rw [hhalf]
    have htri :=
      norm_sub_le ((P N).eval z - f z) ((P N).eval z' - f z')
    nlinarith
  exact (Submodule.isClosed_topologicalClosure _).mem_of_tendsto hqF
    (Filter.Eventually.of_forall hqmem)

/-! ## Schwarz-real descent -/

/-- A real-frequency exponential is fixed by critical-disc Schwarz
conjugation. -/
theorem criticalSchwarzTransform_compactExponentialTest_realFrequency
    (r lambda : ℝ) :
    criticalSchwarzTransform r
        (compactExponentialTest (criticalDiscCoordinate r) lambda) =
      compactExponentialTest (criticalDiscCoordinate r) lambda := by
  have hreal : conj (lambda : ℂ) = (lambda : ℂ) :=
    RCLike.conj_ofReal lambda
  ext z
  rw [criticalSchwarzTransform_apply, compactExponentialTest_apply,
    compactExponentialTest_apply, ← Complex.exp_conj]
  congr 1
  rw [map_mul, map_neg, hreal,
    criticalDiscCoordinate_conjugation]
  simp

/-- Reflected derivative-Lambert tangents at real frequencies are Schwarz
fixed. -/
theorem criticalSchwarzTransform_frequencyLambertFETangent
    (r lambda : ℝ) :
    criticalSchwarzTransform r
        (compactFrequencyLambertFETangent
          (criticalDiscCoordinate r) (criticalDiscReflection r) lambda) =
      compactFrequencyLambertFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r) lambda := by
  let q : C(CriticalClosedDisc r, ℂ) :=
    compactExponentialTest (criticalDiscCoordinate r) lambda
  have hq : criticalSchwarzTransform r q = q := by
    simpa [q] using
      criticalSchwarzTransform_compactExponentialTest_realFrequency r lambda
  have hreal : conj (lambda : ℂ) = (lambda : ℂ) :=
    RCLike.conj_ofReal lambda
  have hpow (x : C(CriticalClosedDisc r, ℂ)) :
      criticalSchwarzTransform r (x ^ 2) =
        (criticalSchwarzTransform r x) ^ 2 := by
    change criticalSchwarzRingEquiv r (x ^ 2) =
      (criticalSchwarzRingEquiv r x) ^ 2
    exact map_pow (criticalSchwarzRingEquiv r) x 2
  have hkernel :
      criticalSchwarzTransform r
          (compactLambertKernel (criticalDiscCoordinate r) lambda) =
        compactLambertKernel (criticalDiscCoordinate r) lambda := by
    unfold compactLambertKernel
    dsimp only
    rw [criticalSchwarzTransform_mul, hq, hpow,
      criticalSchwarzTransform_ringInverse,
      criticalSchwarzTransform_sub, criticalSchwarzTransform_one, hq]
  have htangent :
      criticalSchwarzTransform r
          (compactFrequencyLambertTangent
            (criticalDiscCoordinate r) lambda) =
        compactFrequencyLambertTangent
          (criticalDiscCoordinate r) lambda := by
    unfold compactFrequencyLambertTangent
    rw [criticalSchwarzTransform_smul, hreal, hkernel]
  have href :
      criticalSchwarzTransform r
          ((compactFrequencyLambertTangent
            (criticalDiscCoordinate r) lambda).comp
              (criticalDiscReflection r)) =
        (compactFrequencyLambertTangent
          (criticalDiscCoordinate r) lambda).comp
            (criticalDiscReflection r) := by
    rw [criticalSchwarzTransform_comp_criticalDiscReflection, htangent]
  unfold compactFrequencyLambertFETangent
  rw [criticalSchwarzTransform_sub, htangent, href]

/-- Real form of abstract reflected-Lambert analytic completeness. -/
theorem criticalDisc_analytic_odd_schwarz_mem_realClosedSpan_frequencyLambert
    {ι : Type*} (lambda : ι → ℝ) {R₀ : ℝ}
    (hR₀ : 0 < R₀)
    (hcomplete : StrongSectorBlaschkeComplete lambda R₀)
    (f : ℂ → ℂ) {r₀ r₁ : ℝ}
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z)
    (hschwarz : ∀ z : ℂ, f (conj z) = conj (f z)) :
    criticalDiscRestriction f r₀
        (hf.continuousOn_ball.mono
          (Metric.closedBall_subset_closedBall hr01.le)) ∈
      (Submodule.span ℝ
        (Set.range fun i : ι ↦
          compactFrequencyLambertFETangent
            (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
            (lambda i))).topologicalClosure := by
  let s : Set C(CriticalClosedDisc r₀, ℂ) :=
    Set.range fun i : ι ↦
      compactFrequencyLambertFETangent
        (criticalDiscCoordinate r₀) (criticalDiscReflection r₀) (lambda i)
  apply criticalSchwarzAverage_mem_real_topologicalClosure (s := s)
  · rintro g ⟨i, rfl⟩
    exact criticalSchwarzTransform_frequencyLambertFETangent r₀ (lambda i)
  · ext z
    rw [criticalSchwarzTransform_apply]
    change conj (f (conj (z : ℂ))) = f (z : ℂ)
    rw [hschwarz]
    simp
  · exact criticalDisc_analytic_odd_mem_closedSpan_frequencyLambert
      lambda hR₀ hcomplete f hr₀ hr01 hr1 hf hodd

/-! ## Genuine local multiplicative increments -/

variable {K : Type*} [TopologicalSpace K] [CompactSpace K]

/-- Degree-one logarithmic flux at an arbitrary real frequency. -/
def compactFrequencyLocalFlux
    (q : C(K, ℂ)) (lambda : ℝ) (a : ℂ) : C(K, ℂ) :=
  (lambda : ℂ) • compactMobiusFlux q a

/-- Tangent of the arbitrary-frequency logarithmic flux at `a = 1`. -/
def compactFrequencyTangentFromQ
    (q : C(K, ℂ)) (lambda : ℝ) : C(K, ℂ) :=
  (lambda : ℂ) •
    (Ring.inverse (1 - q) * q * Ring.inverse (1 - q))

theorem hasDerivAt_compactFrequencyLocalFlux_one
    (q : C(K, ℂ)) (lambda : ℝ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactFrequencyLocalFlux q lambda)
      (compactFrequencyTangentFromQ q lambda) 1 := by
  exact (hasDerivAt_compactMobiusFlux_one q hq).const_smul (lambda : ℂ)

/-- Genuine local increment from the distinguished multiplicative parameter
`a = 1`. -/
def compactFrequencyUnitIncrement
    (q : C(K, ℂ)) (lambda : ℝ) (b : ℂ) : C(K, ℂ) :=
  compactFrequencyLocalFlux q lambda (1 + b) -
    compactFrequencyLocalFlux q lambda 1

omit [CompactSpace K] in
@[simp]
theorem compactFrequencyUnitIncrement_zero
    (q : C(K, ℂ)) (lambda : ℝ) :
    compactFrequencyUnitIncrement q lambda 0 = 0 := by
  simp [compactFrequencyUnitIncrement]

theorem hasDerivAt_compactFrequencyUnitIncrement_zero
    (q : C(K, ℂ)) (lambda : ℝ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactFrequencyUnitIncrement q lambda)
      (compactFrequencyTangentFromQ q lambda) 0 := by
  have hshift : HasDerivAt (fun b : ℂ ↦ 1 + b) 1 0 := by
    simpa using
      (hasDerivAt_const (x := (0 : ℂ)) (c := (1 : ℂ))).add
        (hasDerivAt_id (0 : ℂ))
  have houter : HasFDerivAt (compactFrequencyLocalFlux q lambda)
      (ContinuousLinearMap.toSpanSingleton ℂ
        (compactFrequencyTangentFromQ q lambda))
      (1 + 0) := by
    simpa using
      (hasDerivAt_compactFrequencyLocalFlux_one q lambda hq).hasFDerivAt
  have hcomp := houter.comp 0 hshift.hasFDerivAt
  have hsub := hcomp.sub_const (compactFrequencyLocalFlux q lambda 1)
  show HasFDerivAt (compactFrequencyUnitIncrement q lambda)
    (ContinuousLinearMap.toSpanSingleton ℂ
      (compactFrequencyTangentFromQ q lambda)) 0
  convert hsub using 1
  ext c
  simp

/-- FE-paired genuine increment at an arbitrary frequency. -/
def compactFrequencyUnitFEIncrement
    (q : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ) (b : ℂ) : C(K, ℂ) :=
  compactFrequencyUnitIncrement q lambda b -
    compactFrequencyUnitIncrement (q.comp tau) lambda b

/-- FE-paired tangent expressed in the compact Banach algebra. -/
def compactFrequencyFETangentFromQ
    (q : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ) : C(K, ℂ) :=
  compactFrequencyTangentFromQ q lambda -
    compactFrequencyTangentFromQ (q.comp tau) lambda

omit [CompactSpace K] in
@[simp]
theorem compactFrequencyUnitFEIncrement_zero
    (q : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ) :
    compactFrequencyUnitFEIncrement q tau lambda 0 = 0 := by
  simp only [compactFrequencyUnitFEIncrement, compactFrequencyUnitIncrement_zero, sub_self]

theorem hasDerivAt_compactFrequencyUnitFEIncrement_zero
    (q : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ) (hq : ‖q‖ < 1) :
    HasDerivAt (compactFrequencyUnitFEIncrement q tau lambda)
      (compactFrequencyFETangentFromQ q tau lambda) 0 := by
  exact (hasDerivAt_compactFrequencyUnitIncrement_zero q lambda hq).sub
    (hasDerivAt_compactFrequencyUnitIncrement_zero
      (q.comp tau) lambda (norm_comp_lt_one q tau hq))

theorem compactFrequencyTangentFromQ_comp
    (q : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ) (hq : ‖q‖ < 1) :
    compactFrequencyTangentFromQ (q.comp tau) lambda =
      (compactFrequencyTangentFromQ q lambda).comp tau := by
  ext k
  simp only [compactFrequencyTangentFromQ, ContinuousMap.smul_apply,
    ContinuousMap.mul_apply, ContinuousMap.comp_apply]
  rw [ringInverse_one_sub_apply (q.comp tau) (norm_comp_lt_one q tau hq),
    ringInverse_one_sub_apply q hq]
  rfl

theorem compactFrequencyTangentFromQ_exponential
    (s : C(K, ℂ)) (lambda : ℝ) :
    compactFrequencyTangentFromQ
        (compactExponentialTest s lambda) lambda =
      compactFrequencyLambertTangent s lambda := by
  unfold compactFrequencyTangentFromQ compactFrequencyLambertTangent
    compactLambertKernel
  ring

theorem compactFrequencyFETangentFromQ_exponential
    (s : C(K, ℂ)) (tau : C(K, K)) (lambda : ℝ)
    (hq : ‖compactExponentialTest s lambda‖ < 1) :
    compactFrequencyFETangentFromQ
        (compactExponentialTest s lambda) tau lambda =
      compactFrequencyLambertFETangent s tau lambda := by
  unfold compactFrequencyFETangentFromQ compactFrequencyLambertFETangent
  rw [compactFrequencyTangentFromQ_comp _ _ _ hq,
    compactFrequencyTangentFromQ_exponential]

/-- Positive real frequencies give a uniform Neumann contraction on every
critical disc of radius less than `1/2`. -/
theorem criticalDisc_compactExponentialTest_realFrequency_norm_lt_one
    {r lambda : ℝ} (hr : r < 1 / 2) (hlambda : 0 < lambda) :
    ‖compactExponentialTest (criticalDiscCoordinate r) lambda‖ < 1 := by
  have hdelta : 0 < 1 / 2 - r := by linarith
  apply norm_compactExponentialTest_lt_one_of_re_pos
    (criticalDiscCoordinate r) _
    (lambda * (1 / 2 - r)) (mul_pos hlambda hdelta)
  intro k
  have hk := criticalDiscCoordinate_re_lower k
  simp only [mul_re, ofReal_re, ofReal_im, zero_mul, sub_zero]
  exact mul_le_mul_of_nonneg_left hk hlambda.le

/-- The derivative of a genuine reflected local increment is exactly the
abstract reflected derivative-Lambert tangent. -/
theorem hasDerivAt_criticalDiscFrequencyUnitFEIncrement_zero
    {r lambda : ℝ} (hr : r < 1 / 2) (hlambda : 0 < lambda) :
    HasDerivAt
      (compactFrequencyUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) lambda)
        (criticalDiscReflection r) lambda)
      (compactFrequencyLambertFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r) lambda) 0 := by
  have hq :=
    criticalDisc_compactExponentialTest_realFrequency_norm_lt_one
      hr hlambda
  have hder := hasDerivAt_compactFrequencyUnitFEIncrement_zero
    (compactExponentialTest (criticalDiscCoordinate r) lambda)
    (criticalDiscReflection r) lambda hq
  convert hder using 1
  exact (compactFrequencyFETangentFromQ_exponential
    (criticalDiscCoordinate r) (criticalDiscReflection r) lambda hq).symm

/-- Real-parameter arbitrary-frequency increments preserve the critical-disc
Schwarz real structure. -/
theorem criticalSchwarzTransform_realFrequencyUnitFEIncrement
    (r lambda b : ℝ) :
    criticalSchwarzTransform r
      (compactFrequencyUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) lambda)
        (criticalDiscReflection r) lambda b) =
      compactFrequencyUnitFEIncrement
        (compactExponentialTest (criticalDiscCoordinate r) lambda)
        (criticalDiscReflection r) lambda b := by
  let q := compactExponentialTest (criticalDiscCoordinate r) lambda
  have hq : criticalSchwarzTransform r q = q :=
    criticalSchwarzTransform_compactExponentialTest_realFrequency r lambda
  have hqref :
      criticalSchwarzTransform r (q.comp (criticalDiscReflection r)) =
        q.comp (criticalDiscReflection r) := by
    rw [criticalSchwarzTransform_comp_criticalDiscReflection, hq]
  have hreal (a : ℝ) : conj (a : ℂ) = (a : ℂ) :=
    RCLike.conj_ofReal a
  have hflux (q' : C(CriticalClosedDisc r, ℂ))
      (hq' : criticalSchwarzTransform r q' = q') (a : ℝ) :
      criticalSchwarzTransform r
          (compactFrequencyLocalFlux q' lambda a) =
        compactFrequencyLocalFlux q' lambda a := by
    unfold compactFrequencyLocalFlux
    rw [criticalSchwarzTransform_smul, hreal,
      criticalSchwarzTransform_compactMobiusFlux hq' (hreal a)]
  unfold compactFrequencyUnitFEIncrement compactFrequencyUnitIncrement
  have hqb : criticalSchwarzTransform r
      (compactFrequencyLocalFlux q lambda (1 + (b : ℂ))) =
      compactFrequencyLocalFlux q lambda (1 + (b : ℂ)) := by
    simpa using hflux q hq (1 + b)
  have hqone : criticalSchwarzTransform r
      (compactFrequencyLocalFlux q lambda 1) =
      compactFrequencyLocalFlux q lambda 1 := by
    simpa using hflux q hq 1
  have hrefb : criticalSchwarzTransform r
      (compactFrequencyLocalFlux (q.comp (criticalDiscReflection r))
        lambda (1 + (b : ℂ))) =
      compactFrequencyLocalFlux (q.comp (criticalDiscReflection r))
        lambda (1 + (b : ℂ)) := by
    simpa using
      hflux (q.comp (criticalDiscReflection r)) hqref (1 + b)
  have hrefone : criticalSchwarzTransform r
      (compactFrequencyLocalFlux (q.comp (criticalDiscReflection r))
        lambda 1) =
      compactFrequencyLocalFlux (q.comp (criticalDiscReflection r))
        lambda 1 := by
    simpa using hflux (q.comp (criticalDiscReflection r)) hqref 1
  rw [criticalSchwarzTransform_sub, criticalSchwarzTransform_sub,
    criticalSchwarzTransform_sub, hqb, hqone, hrefb, hrefone]

/-! ## Universal nonlinear orbit law -/

/-- Real local reflected-increment generators for an abstract spectrum. -/
def criticalDiscRealFrequencyIncrementGenerators
    {ι : Type*} (r : ℝ) (lambda : ι → ℝ) (epsilon : ℝ) :
    Set C(CriticalClosedDisc r, ℂ) :=
  {g | ∃ i : ι, ∃ b ∈ ball (0 : ℝ) epsilon,
    g = compactFrequencyUnitFEIncrement
      (compactExponentialTest (criticalDiscCoordinate r) (lambda i))
      (criticalDiscReflection r) (lambda i) b}

/-- Additive group generated by genuine arbitrarily small reflected
multiplicative increments. -/
def criticalDiscRealFrequencyIncrementGroup
    {ι : Type*} (r : ℝ) (lambda : ι → ℝ) (epsilon : ℝ) :
    AddSubgroup C(CriticalClosedDisc r, ℂ) :=
  AddSubgroup.closure
    (criticalDiscRealFrequencyIncrementGenerators r lambda epsilon)

/-- Pole-free real local reflected-increment generators.  The Neumann
condition says that the perturbed local denominator is invertible on the
whole critical disc. -/
def criticalDiscSafeRealFrequencyIncrementGenerators
    {ι : Type*} (r : ℝ) (lambda : ι → ℝ) (epsilon : ℝ) :
    Set C(CriticalClosedDisc r, ℂ) :=
  {g | ∃ i : ι, ∃ b ∈ ball (0 : ℝ) epsilon,
    ‖(1 + (b : ℂ)) •
        compactExponentialTest (criticalDiscCoordinate r) (lambda i)‖ < 1 ∧
    g = compactFrequencyUnitFEIncrement
      (compactExponentialTest (criticalDiscCoordinate r) (lambda i))
      (criticalDiscReflection r) (lambda i) b}

/-- Additive group generated only by genuine pole-free local multiplicative
increments. -/
def criticalDiscSafeRealFrequencyIncrementGroup
    {ι : Type*} (r : ℝ) (lambda : ι → ℝ) (epsilon : ℝ) :
    AddSubgroup C(CriticalClosedDisc r, ℂ) :=
  AddSubgroup.closure
    (criticalDiscSafeRealFrequencyIncrementGenerators r lambda epsilon)

/-- Every strict Neumann contraction stays a contraction throughout some
real parameter neighborhood of the distinguished value. -/
theorem exists_real_parameter_ball_norm_one_add_smul_lt_one
    {K : Type*} [TopologicalSpace K] [CompactSpace K]
    (q : C(K, ℂ)) (hq : ‖q‖ < 1) :
    ∃ delta : ℝ, 0 < delta ∧
      ∀ b ∈ ball (0 : ℝ) delta,
        ‖(1 + (b : ℂ)) • q‖ < 1 := by
  let eta : ℝ := (1 - ‖q‖) / (‖q‖ + 1)
  have hq0 : 0 ≤ ‖q‖ := norm_nonneg q
  have hden : 0 < ‖q‖ + 1 := by positivity
  have heta : 0 < eta := div_pos (sub_pos.mpr hq) hden
  refine ⟨eta, heta, ?_⟩
  intro b hb
  have hbabs : |b| < eta := by
    simpa [mem_ball, Real.dist_eq] using hb
  have hscalar : ‖(1 + (b : ℂ))‖ ≤ 1 + |b| := by
    calc
      ‖(1 + (b : ℂ))‖ ≤ ‖(1 : ℂ)‖ + ‖(b : ℂ)‖ :=
        norm_add_le _ _
      _ = 1 + |b| := by simp [Real.norm_eq_abs]
  by_cases hz : ‖q‖ = 0
  · have hqz : q = 0 := norm_eq_zero.mp hz
    subst q
    simp
  have hqpos : 0 < ‖q‖ := lt_of_le_of_ne hq0 (Ne.symm hz)
  rw [norm_smul]
  calc
    ‖(1 + (b : ℂ))‖ * ‖q‖ ≤ (1 + |b|) * ‖q‖ :=
      mul_le_mul_of_nonneg_right hscalar hq0
    _ < (1 + eta) * ‖q‖ := by
      apply mul_lt_mul_of_pos_right _ hqpos
      simpa [add_comm] using add_lt_add_left hbabs 1
    _ < 1 := by
      dsimp [eta]
      field_simp
      nlinarith

/-- Every real multiple of an abstract tangent is in the closure of the
genuine local increment group. -/
theorem real_smul_frequencyTangent_mem_incrementGroup_closure
    {ι : Type*} {r epsilon : ℝ} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    (hr : r < 1 / 2) (hepsilon : 0 < epsilon)
    (i : ι) (c : ℝ) :
    c • compactFrequencyLambertFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r) (lambda i) ∈
      (criticalDiscRealFrequencyIncrementGroup
        r lambda epsilon).topologicalClosure := by
  let DeltaC : ℂ → C(CriticalClosedDisc r, ℂ) :=
    compactFrequencyUnitFEIncrement
      (compactExponentialTest (criticalDiscCoordinate r) (lambda i))
      (criticalDiscReflection r) (lambda i)
  let DeltaR : ℝ → C(CriticalClosedDisc r, ℂ) := fun b ↦ DeltaC b
  let w : C(CriticalClosedDisc r, ℂ) :=
    compactFrequencyLambertFETangent
      (criticalDiscCoordinate r) (criticalDiscReflection r) (lambda i)
  have hcomplex : HasDerivAt DeltaC w 0 := by
    simpa [DeltaC, w] using
      hasDerivAt_criticalDiscFrequencyUnitFEIncrement_zero
        hr (hpositive i)
  have hrealderiv : HasDerivAt DeltaR w 0 := by
    simpa [DeltaR] using
      (HasDerivAt.restrict_real (f := DeltaC) (w := w) hcomplex)
  have hzero : DeltaR 0 = 0 := by simp [DeltaR, DeltaC]
  have hind := smul_deriv_mem_localIncrementGroup_topologicalClosure
    DeltaR w hrealderiv hzero c hepsilon
  apply AddSubgroup.topologicalClosure_mono ?_ hind
  apply AddSubgroup.closure_mono
  rintro g ⟨b, hb, rfl⟩
  exact ⟨i, b, hb, rfl⟩

/-- Every real tangent direction already lies in the closure of the group
generated only by pole-free local increments. -/
theorem real_smul_frequencyTangent_mem_safeIncrementGroup_closure
    {ι : Type*} {r epsilon : ℝ} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    (hr : r < 1 / 2) (hepsilon : 0 < epsilon)
    (i : ι) (c : ℝ) :
    c • compactFrequencyLambertFETangent
        (criticalDiscCoordinate r) (criticalDiscReflection r) (lambda i) ∈
      (criticalDiscSafeRealFrequencyIncrementGroup
        r lambda epsilon).topologicalClosure := by
  let q : C(CriticalClosedDisc r, ℂ) :=
    compactExponentialTest (criticalDiscCoordinate r) (lambda i)
  let DeltaC : ℂ → C(CriticalClosedDisc r, ℂ) :=
    compactFrequencyUnitFEIncrement q
      (criticalDiscReflection r) (lambda i)
  let DeltaR : ℝ → C(CriticalClosedDisc r, ℂ) := fun b ↦ DeltaC b
  let w : C(CriticalClosedDisc r, ℂ) :=
    compactFrequencyLambertFETangent
      (criticalDiscCoordinate r) (criticalDiscReflection r) (lambda i)
  have hq : ‖q‖ < 1 := by
    simpa [q] using
      criticalDisc_compactExponentialTest_realFrequency_norm_lt_one
        hr (hpositive i)
  obtain ⟨delta, hdelta, hsafe⟩ :=
    exists_real_parameter_ball_norm_one_add_smul_lt_one q hq
  let eta : ℝ := min epsilon delta
  have heta : 0 < eta := lt_min hepsilon hdelta
  have hcomplex : HasDerivAt DeltaC w 0 := by
    simpa [DeltaC, q, w] using
      hasDerivAt_criticalDiscFrequencyUnitFEIncrement_zero
        hr (hpositive i)
  have hrealderiv : HasDerivAt DeltaR w 0 := by
    simpa [DeltaR] using
      (HasDerivAt.restrict_real (f := DeltaC) (w := w) hcomplex)
  have hzero : DeltaR 0 = 0 := by simp [DeltaR, DeltaC]
  have hind := smul_deriv_mem_localIncrementGroup_topologicalClosure
    DeltaR w hrealderiv hzero c heta
  apply AddSubgroup.topologicalClosure_mono ?_ hind
  apply AddSubgroup.closure_mono
  rintro g ⟨b, hb, rfl⟩
  have hbepsilon : b ∈ ball (0 : ℝ) epsilon := by
    rw [mem_ball, Real.dist_eq] at hb ⊢
    exact hb.trans_le (min_le_left _ _)
  have hbdelta : b ∈ ball (0 : ℝ) delta := by
    rw [mem_ball, Real.dist_eq] at hb ⊢
    exact hb.trans_le (min_le_right _ _)
  exact ⟨i, b, hbepsilon, hsafe b hbdelta, rfl⟩

/-- Real tangent span is contained in closure of the genuine local increment
group. -/
theorem realSpan_frequencyTangents_le_incrementGroup_closure
    {ι : Type*} {r epsilon : ℝ} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    (hr : r < 1 / 2) (hepsilon : 0 < epsilon) :
    (Submodule.span ℝ
        (Set.range fun i : ι ↦
          compactFrequencyLambertFETangent
            (criticalDiscCoordinate r) (criticalDiscReflection r)
            (lambda i)) : Set C(CriticalClosedDisc r, ℂ)) ⊆
      ((criticalDiscRealFrequencyIncrementGroup
          r lambda epsilon).topologicalClosure :
        Set C(CriticalClosedDisc r, ℂ)) := by
  intro x hx
  have hstrong : ∀ c : ℝ,
      c • x ∈
        (criticalDiscRealFrequencyIncrementGroup
          r lambda epsilon).topologicalClosure := by
    refine Submodule.span_induction
      (p := fun y _ ↦ ∀ c : ℝ,
        c • y ∈
          (criticalDiscRealFrequencyIncrementGroup
            r lambda epsilon).topologicalClosure)
      ?_ ?_ ?_ ?_ hx
    · rintro y ⟨i, rfl⟩ c
      exact real_smul_frequencyTangent_mem_incrementGroup_closure
        lambda hpositive hr hepsilon i c
    · intro c
      simp
    · intro y z hy hz iy iz c
      rw [smul_add]
      exact AddSubgroup.add_mem _ (iy c) (iz c)
    · intro a y hy iy c
      rw [smul_smul]
      exact iy (c * a)
  simpa using hstrong 1

/-- Real tangent span is contained in closure of the genuine pole-free local
increment group. -/
theorem realSpan_frequencyTangents_le_safeIncrementGroup_closure
    {ι : Type*} {r epsilon : ℝ} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    (hr : r < 1 / 2) (hepsilon : 0 < epsilon) :
