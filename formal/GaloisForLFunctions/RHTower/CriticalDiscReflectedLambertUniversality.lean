/-- Universal nonlinear orbit law.  Every analytic FE-odd Schwarz-real target
is in the closure of the group generated by arbitrarily small genuine
reflected multiplicative increments. -/
theorem criticalDisc_analytic_odd_schwarz_mem_frequencyIncrementGroup_closure
    {ι : Type*} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    {R₀ : ℝ} (hR₀ : 0 < R₀)
    (hcomplete : StrongSectorBlaschkeComplete lambda R₀)
    (f : ℂ → ℂ) {r₀ r₁ epsilon : ℝ}
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hepsilon : 0 < epsilon)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z)
    (hschwarz : ∀ z : ℂ, f (conj z) = conj (f z)) :
    criticalDiscRestriction f r₀
        (hf.continuousOn_ball.mono
          (Metric.closedBall_subset_closedBall hr01.le)) ∈
      (criticalDiscRealFrequencyIncrementGroup
        r₀ lambda epsilon).topologicalClosure := by
  have hspan :=
    criticalDisc_analytic_odd_schwarz_mem_realClosedSpan_frequencyLambert
      lambda hR₀ hcomplete f hr₀ hr01 hr1 hf hodd hschwarz
  have hspan' : criticalDiscRestriction f r₀
      (hf.continuousOn_ball.mono
        (Metric.closedBall_subset_closedBall hr01.le)) ∈
      closure (↑(Submodule.span ℝ
        (Set.range fun i : ι ↦
          compactFrequencyLambertFETangent
            (criticalDiscCoordinate r₀) (criticalDiscReflection r₀)
            (lambda i))) : Set C(CriticalClosedDisc r₀, ℂ)) := hspan
  exact (closure_minimal
    (realSpan_frequencyTangents_le_incrementGroup_closure
      lambda hpositive (hr01.trans hr1) hepsilon)
    (criticalDiscRealFrequencyIncrementGroup
      r₀ lambda epsilon).isClosed_topologicalClosure) hspan'

/-- Maximal continuous Hausdorff quotient classification for the analytic
FE-odd Schwarz-real fibre: every invariant reader is constant. -/
theorem criticalDisc_continuous_frequencyIncrementInvariant_eq_base
    {ι : Type*} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    {R₀ : ℝ} (hR₀ : 0 < R₀)
    (hcomplete : StrongSectorBlaschkeComplete lambda R₀)
    {r₀ r₁ epsilon : ℝ}
    {Y : Type*} [TopologicalSpace Y] [T2Space Y]
    (A : C(CriticalClosedDisc r₀, ℂ) → Y) (hA : Continuous A)
    (hinvariant : ∀ x g,
      g ∈ criticalDiscRealFrequencyIncrementGroup r₀ lambda epsilon →
      A (x + g) = A x)
    (f : ℂ → ℂ)
    (hr₀ : 0 ≤ r₀) (hr01 : r₀ < r₁) (hr1 : r₁ < 1 / 2)
    (hepsilon : 0 < epsilon)
    (hf : DiffContOnCl ℂ f (ball (1 / 2 : ℂ) r₁))
    (hodd : ∀ z ∈ closedBall (1 / 2 : ℂ) r₀, f (1 - z) = -f z)
    (hschwarz : ∀ z : ℂ, f (conj z) = conj (f z)) :
    A (criticalDiscRestriction f r₀
      (hf.continuousOn_ball.mono
        (Metric.closedBall_subset_closedBall hr01.le))) = A 0 := by
  let G := criticalDiscRealFrequencyIncrementGroup r₀ lambda epsilon
  let target := criticalDiscRestriction f r₀
    (hf.continuousOn_ball.mono
      (Metric.closedBall_subset_closedBall hr01.le))
  have htarget : target ∈ G.topologicalClosure := by
    simpa [G, target] using
      criticalDisc_analytic_odd_schwarz_mem_frequencyIncrementGroup_closure
        lambda hpositive hR₀ hcomplete f
        hr₀ hr01 hr1 hepsilon hf hodd hschwarz
  have hG :
      (↑G : Set C(CriticalClosedDisc r₀, ℂ)) ⊆ {x | A x = A 0} := by
    intro g hg
    simpa using hinvariant 0 g hg
  have hclosed :
      IsClosed {x : C(CriticalClosedDisc r₀, ℂ) | A x = A 0} :=
    isClosed_eq hA continuous_const
  exact (closure_minimal hG hclosed) htarget

/-- Pole-free universal nonlinear orbit law.  Every analytic FE-odd
Schwarz-real target is in the closure of the group generated by arbitrarily
small local increments whose denominators stay invertible on the whole
critical disc. -/
theorem criticalDisc_analytic_odd_schwarz_mem_safeFrequencyIncrementGroup_closure
    {ι : Type*} (lambda : ι → ℝ)
    (hpositive : ∀ i, 0 < lambda i)
    {R₀ : ℝ} (hR₀ : 0 < R₀)
    (hcomplete : StrongSectorBlaschkeComplete lambda R₀)
