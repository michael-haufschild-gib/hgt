import GaloisForLFunctions.RHTower.ArakelovModularLambdaFE
import GaloisForLFunctions.RHTower.XiArakelovHurwitzRelativeAlgebraicityCollision

/-!
# Arakelov modular lift with relative Hurwitz transcendence

The modular-lambda lift accepts every nonexceptional functional-equation pair, including an
off-critical Xi zero.  The relative Arakelov--Hurwitz collision supplies information invisible to
that uniformization: when the Xi-zero Arakelov coordinate is integral, its Hurwitz character stays
transcendental over the complete field generated by the same modular-lambda coordinate.
-/

open Complex Set
open GaloisForLFunctions GaloisForLFunctions.HTGeometry
open HurwitzOrbit

namespace RHTower

noncomputable section

/-- **Arakelov modular relative-transcendence law.**  Under integral Xi-zero Arakelov
coordinates, every hypothetical right-half Xi zero has an off-unit modular-lambda lift carrying
the functional-equation braid, and its Hurwitz character is transcendental over the field
generated by the lift coordinate itself. -/
theorem xiRightZero_exists_modularLambdaLift_with_relativeHurwitzTranscendence
    (hint : XiArakelovCoordinatesIntegral)
    (rho : XiDivisorSupport) (hrho : 1 / 2 < (rho : ℂ).re) :
    ∃ tau : UpperHalfPlane,
      (Bottcher.lambdaPunct tau : ℂ) = arakelovW (rho : ℂ) ∧
      (Bottcher.lambdaPunct
          ((ModularGroup.S * ModularGroup.T * ModularGroup.S) • tau) : ℂ) =
        arakelovW (sigma (rho : ℂ)) ∧
      ‖(Bottcher.lambdaPunct tau : ℂ)‖ ≠ 1 ∧
      Transcendental
        (arakelovCoordinateField (Bottcher.lambdaPunct tau : ℂ))
        (xiHurwitzMonodromyCharacter rho) := by
  have hzero : xi (rho : ℂ) = 0 := xi_eq_zero_of_mem_divisor_support rho
  have h0 : (rho : ℂ) ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    norm_num at hre
    linarith
  have h1 : (rho : ℂ) ≠ 1 := by
    intro h
    apply (xi_ne_zero_of_one_le_re ?_) hzero
    rw [h]
    norm_num
  obtain ⟨tau, htau, hreflect, hunit⟩ :=
    exists_modularLambda_lift_FE_braid_off_unit (rho : ℂ) h0 h1 (ne_of_gt hrho)
  have hwIntegral : IsIntegral ℤ (arakelovW (rho : ℂ)) := hint rho hzero
  have hw : IsAlgebraic ℚ (arakelovW (rho : ℂ)) := by
    have hwRat : IsIntegral ℚ (arakelovW (rho : ℂ)) := hwIntegral.tower_top
    exact hwRat.isAlgebraic
  have htrans : Transcendental
      (arakelovCoordinateField (arakelovW (rho : ℂ)))
      (xiHurwitzMonodromyCharacter rho) := by
    simpa only [xiHurwitzMonodromyCharacter] using
      monoScalar_transcendental_over_arakelovCoordinateField hw
        (xi_divisor_support_im_ne_zero rho)
  refine ⟨tau, htau, hreflect, hunit, ?_⟩
  rw [htau]
  exact htrans

end

end RHTower
