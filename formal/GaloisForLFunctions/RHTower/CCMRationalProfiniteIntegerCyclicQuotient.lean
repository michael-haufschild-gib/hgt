import GaloisForLFunctions.RHTower.CCMRationalIntegralAdeleIndex
import Mathlib.Data.ZMod.Basic
import Mathlib.SetTheory.Cardinal.Finite

/-!
# Cyclic congruence quotients of rational profinite integers

For `Ž = ∏_p ℤ_p`, the additive quotient `Ž / NŽ` is canonically
generated by the diagonal integer `1` and is additively equivalent to
`ZMod N`.  The proof is not inferred from cardinality alone: injectivity of
the diagonal map is proved prime by prime using exact `p`-power reduction,
then exact quotient cardinality supplies surjectivity.

This is the arithmetic core of density of diagonal integers in integral
finite adeles and of the finite Haar quadrature formula.
-/

noncomputable section

open PadicInt
open scoped Classical

namespace GaloisForLFunctions
namespace RHTower

local instance (p : Nat.Primes) : Fact p.1.Prime := ⟨p.2⟩

/-- Rational profinite integers in their product-of-`p`-adics presentation. -/
abbrev CCMRationalProfiniteIntegers :=
  (p : Nat.Primes) → ℤ_[p]

/-- Diagonal embedding of integers into rational profinite integers. -/
def ccmRationalProfiniteIntegerDiagonal :
    ℤ →+ CCMRationalProfiniteIntegers where
  toFun m p := (m : ℤ_[p])
  map_zero' := by ext; simp
  map_add' m n := by ext; simp

/-- Diagonal integers modulo the multiplication-by-`N` subgroup. -/
def ccmRationalProfiniteIntegerQuotientDiagonal (N : ℕ) :
    ℤ →+ CCMRationalProfiniteIntegers ⧸
      (nsmulAddMonoidHom N).range :=
  (QuotientAddGroup.mk' _).comp ccmRationalProfiniteIntegerDiagonal

theorem ccmRationalProfiniteIntegerQuotientDiagonal_natCast_eq_zero
    (N : ℕ) :
    ccmRationalProfiniteIntegerQuotientDiagonal N (N : ℤ) = 0 := by
  apply (QuotientAddGroup.eq_zero_iff _).2
  refine ⟨1, ?_⟩
  ext p
  simp [ccmRationalProfiniteIntegerDiagonal,
    nsmulAddMonoidHom, nsmul_eq_mul]

/-- Diagonal congruence map from `ZMod N` to profinite integers modulo
`NŽ`. -/
def ccmRationalZModToProfiniteIntegerQuotient (N : ℕ) :
    ZMod N →+ CCMRationalProfiniteIntegers ⧸
      (nsmulAddMonoidHom N).range :=
  ZMod.lift N
    ⟨ccmRationalProfiniteIntegerQuotientDiagonal N,
      ccmRationalProfiniteIntegerQuotientDiagonal_natCast_eq_zero N⟩

/-- The diagonal `ZMod N` map is injective.  Thus no proper divisor of `N`
can be the period of diagonal `1` modulo `NŽ`. -/
theorem ccmRationalZModToProfiniteIntegerQuotient_injective
    (N : ℕ) (hN : N ≠ 0) :
    Function.Injective
      (ccmRationalZModToProfiniteIntegerQuotient N) := by
  rw [ccmRationalZModToProfiniteIntegerQuotient,
    ZMod.lift_injective]
  intro m hm
  have hmem : ccmRationalProfiniteIntegerDiagonal m ∈
      (nsmulAddMonoidHom
        (α := CCMRationalProfiniteIntegers) N).range :=
    (QuotientAddGroup.eq_zero_iff _).mp hm
  obtain ⟨x, hx⟩ := hmem
  by_cases hm0 : m = 0
  · subst m
    simp
  apply (CharP.intCast_eq_zero_iff (ZMod N) N m).2
  apply Int.dvd_natAbs.1
  apply Int.natCast_dvd_natCast.2
  apply (Nat.factorization_le_iff_dvd hN
    (Int.natAbs_ne_zero.mpr hm0)).1
  intro p
  by_cases hp : p.Prime
  · apply (hp.pow_dvd_iff_le_factorization
      (Int.natAbs_ne_zero.mpr hm0)).1
    let pp : Nat.Primes := ⟨p, hp⟩
    letI : Fact pp.1.Prime := ⟨pp.2⟩
    let e : ℕ := N.factorization p
    have hpdiv : p ^ e ∣ N :=
      (hp.pow_dvd_iff_le_factorization hN).2 (le_refl _)
    have hcoord := congrFun hx pp
    have hmap := congrArg (fun y : ℤ_[pp] =>
      PadicInt.toZModPow e y) hcoord
    have hNzero : (N : ZMod (p ^ e)) = 0 :=
      (ZMod.natCast_eq_zero_iff N (p ^ e)).2 hpdiv
    have hmzero : (m : ZMod (p ^ e)) = 0 := by
      simpa [ccmRationalProfiniteIntegerDiagonal,
        nsmulAddMonoidHom, nsmul_eq_mul, hNzero] using hmap.symm
    have hdInt : ((p ^ e : ℕ) : ℤ) ∣ m :=
      (CharP.intCast_eq_zero_iff
        (ZMod (p ^ e)) (p ^ e) m).1 hmzero
    exact Int.natCast_dvd_natCast.1 (Int.dvd_natAbs.2 hdInt)
  · simp [Nat.factorization_eq_zero_of_not_prime N hp]

/-- **Exact cyclic congruence law.** `Ž / NŽ` is additively `ZMod N`,
with the equivalence induced by diagonal integers. -/
noncomputable def ccmRationalZModEquivProfiniteIntegerQuotient
    (N : ℕ) (hN : N ≠ 0) :
    ZMod N ≃+ CCMRationalProfiniteIntegers ⧸
      (nsmulAddMonoidHom N).range := by
  letI : Finite (CCMRationalProfiniteIntegers ⧸
      (nsmulAddMonoidHom N).range) := by
    apply Nat.finite_of_card_ne_zero
    rw [ccmPadicIntPiQuotientNSMul_card hN]
    exact hN
  apply AddEquiv.ofBijective
    (ccmRationalZModToProfiniteIntegerQuotient N)
  apply (Nat.bijective_iff_injective_and_card _).2
  refine ⟨ccmRationalZModToProfiniteIntegerQuotient_injective N hN, ?_⟩
  rw [Nat.card_zmod, ccmPadicIntPiQuotientNSMul_card hN]

end RHTower
end GaloisForLFunctions
