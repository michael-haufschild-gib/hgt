import GaloisForLFunctions.RHTower.DeningerEntireQuotientCohomology

/-!
# Scaling-cover functoriality for completed-Xi entire quotients

The Scaling Site organizes positive-integer scaling across a family of fibres.  This file supplies
the corresponding algebraic prerequisite for the completed-Xi entire quotient: pullback along
`z ↦ z / 2` is an automorphism of the entire-function algebra and therefore induces an algebra
equivalence from the original Xi quotient to the quotient by the pulled-back Xi ideal.

No stability of the Xi divisor under dilation is assumed.  The target ideal changes with the
scaling cover.
-/

open Complex

namespace RHTower

noncomputable section

/-- Pullback of entire functions by the degree-two scaling cover `z ↦ z / 2`. -/
def deningerEntireHalfPullback : DeningerEntire ≃ₐ[ℂ] DeningerEntire where
  toFun F :=
    ⟨fun z => F (z / 2),
      F.2.comp (differentiable_id.div_const 2)⟩
  invFun F :=
    ⟨fun z => F (2 * z),
      F.2.comp ((differentiable_const 2).mul differentiable_id)⟩
  left_inv F := by
    apply DeningerEntire.ext
    intro z
    change F (2 * z / 2) = F z
    apply congrArg F
    norm_num
  right_inv F := by
    apply DeningerEntire.ext
    intro z
    change F (2 * (z / 2)) = F z
    apply congrArg F
    rw [mul_comm]
    norm_num
  map_add' F G := rfl
  map_mul' F G := rfl
  commutes' c := rfl

@[simp] theorem deningerEntireHalfPullback_apply
    (F : DeningerEntire) (z : ℂ) :
    deningerEntireHalfPullback F z = F (z / 2) :=
  rfl

@[simp] theorem deningerEntireHalfPullback_symm_apply
    (F : DeningerEntire) (z : ℂ) :
    deningerEntireHalfPullback.symm F z = F (2 * z) :=
  rfl

/-- Image of the completed-Xi ideal under the scaling-cover pullback. -/
def deningerEntireScaledTwoXiIdeal : Ideal DeningerEntire :=
  deningerEntireXiIdeal.map
    (deningerEntireHalfPullback : DeningerEntire →+* DeningerEntire)

/-- Completed-Xi quotient over the degree-two scaling target. -/
abbrev DeningerEntireScaledTwoH1 :=
  DeningerEntire ⧸ deningerEntireScaledTwoXiIdeal

/-- Quotient functoriality for the degree-two scaling cover. -/
def deningerEntireHalfPullbackQuotientEquiv :
    DeningerEntireH1 ≃ₐ[ℂ] DeningerEntireScaledTwoH1 :=
  Ideal.quotientEquivAlg deningerEntireXiIdeal
    deningerEntireScaledTwoXiIdeal deningerEntireHalfPullback rfl

/-- Canonical class map into the scaled completed-Xi quotient. -/
def deningerEntireScaledTwoH1Class :
    DeningerEntire →ₐ[ℂ] DeningerEntireScaledTwoH1 :=
  Ideal.Quotient.mkₐ ℂ deningerEntireScaledTwoXiIdeal

@[simp] theorem deningerEntireHalfPullbackQuotientEquiv_class
    (F : DeningerEntire) :
    deningerEntireHalfPullbackQuotientEquiv
        (deningerEntireH1Class F) =
      deningerEntireScaledTwoH1Class
        (deningerEntireHalfPullback F) :=
  rfl

/-- The scaled target ideal is principal, generated by `z ↦ XiC (z / 2)`. -/
theorem deningerEntireScaledTwoXiIdeal_eq_span_halfPullbackXi :
    deningerEntireScaledTwoXiIdeal =
      Ideal.span {deningerEntireHalfPullback deningerEntireXi} := by
  rw [deningerEntireScaledTwoXiIdeal, deningerEntireXiIdeal, Ideal.map_span]
  congr 2
  ext F
  simp

/-- The scaled target generator evaluates to the half-scaled completed Xi source. -/
@[simp] theorem deningerEntireHalfPullback_Xi_apply (z : ℂ) :
    deningerEntireHalfPullback deningerEntireXi z = XiC (z / 2) :=
  rfl

/-- Closed literature-backed prerequisite: half-scaling is an entire algebra automorphism and
quotient functoriality identifies the completed-Xi quotient with its scaled target. -/
theorem deningerEntire_scalingCover_quotientFunctoriality :
    Function.Bijective deningerEntireHalfPullback ∧
      Function.Bijective deningerEntireHalfPullbackQuotientEquiv ∧
      deningerEntireScaledTwoXiIdeal =
        Ideal.span {deningerEntireHalfPullback deningerEntireXi} := by
  exact ⟨deningerEntireHalfPullback.bijective,
    deningerEntireHalfPullbackQuotientEquiv.bijective,
    deningerEntireScaledTwoXiIdeal_eq_span_halfPullbackXi⟩

end

end RHTower
