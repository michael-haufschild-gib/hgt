import GaloisForLFunctions.RHTower.ThetaTailSeparatedPacketPositivity

/-!
# Full Poisson scale-history frame

A positive Laplace clock `t` generates the half-density history

`a ↦ 2 t sqrt(a) exp(-t a)`.

Integrating over every positive aperture normalizes each clock to unit mass.  Two clocks `t,u`
have the exact cross-history Gram coefficient

`4tu/(t+u)^(2 : ℕ) = 1/cosh((log t-log u)/2)^(2 : ℕ)`.

This is a source-only cross-aperture law.  No zero, divisor, RH premise, or numerical computation
enters.  It does not construct the signed theta relative completion needed for RH.
-/

open MeasureTheory Set

namespace RHTower

noncomputable section

/-- Half-density history generated by a positive Laplace clock. -/
def poissonScaleHistory (t a : ℝ) : ℝ :=
  2 * t * Real.sqrt a * Real.exp (-(t * a))

/-- Cross-scale pairing of two full Poisson histories. -/
def poissonScaleHistoryGram (t u : ℝ) : ℝ :=
  ∫ a in Ioi (0 : ℝ), poissonScaleHistory t a * poissonScaleHistory u a

private theorem poissonScaleHistory_mul {t u a : ℝ} (ha : 0 < a) :
    poissonScaleHistory t a * poissonScaleHistory u a =
      4 * t * u * (a * Real.exp (-((t + u) * a))) := by
  rw [poissonScaleHistory, poissonScaleHistory]
  have hsqrt : Real.sqrt a * Real.sqrt a = a := Real.mul_self_sqrt ha.le
  have hexp : Real.exp (-(t * a)) * Real.exp (-(u * a)) =
      Real.exp (-((t + u) * a)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  calc
    2 * t * √a * Real.exp (-(t * a)) * (2 * u * √a * Real.exp (-(u * a))) =
        4 * t * u * (√a * √a) *
          (Real.exp (-(t * a)) * Real.exp (-(u * a))) := by ring
    _ = 4 * t * u * (a * Real.exp (-((t + u) * a))) := by
      rw [hsqrt, hexp]
      ring

/-- Full Poisson scale histories have the exact Cauchy-square Gram kernel. -/
theorem poissonScaleHistoryGram_eq {t u : ℝ} (ht : 0 < t) (hu : 0 < u) :
    poissonScaleHistoryGram t u = 4 * t * u / (t + u) ^ (2 : ℕ) := by
  have htu : 0 < t + u := add_pos ht hu
  rw [poissonScaleHistoryGram]
  have hcongr :
      (fun a : ℝ => poissonScaleHistory t a * poissonScaleHistory u a) =ᵐ[
        volume.restrict (Ioi 0)]
        (fun a : ℝ => 4 * t * u * (a * Real.exp (-((t + u) * a)))) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with a ha
    exact poissonScaleHistory_mul ha
  rw [integral_congr_ae hcongr, integral_const_mul,
    integral_Ioi_id_mul_exp_neg_mul htu]
  ring

/-- Every positive clock has unit full-history mass. -/
theorem poissonScaleHistoryGram_self {t : ℝ} (ht : 0 < t) :
    poissonScaleHistoryGram t t = 1 := by
  rw [poissonScaleHistoryGram_eq ht ht]
  field_simp
  ring

/-- Cross-clock visibility never exceeds one. -/
theorem poissonScaleHistoryGram_le_one {t u : ℝ} (ht : 0 < t) (hu : 0 < u) :
    poissonScaleHistoryGram t u ≤ 1 := by
  rw [poissonScaleHistoryGram_eq ht hu]
  have hsq : 0 < (t + u) ^ (2 : ℕ) := sq_pos_of_pos (add_pos ht hu)
  rw [div_le_one hsq]
  nlinarith [sq_nonneg (t - u)]

/-- Cross-clock visibility is strictly positive. -/
theorem poissonScaleHistoryGram_pos {t u : ℝ} (ht : 0 < t) (hu : 0 < u) :
    0 < poissonScaleHistoryGram t u := by
  rw [poissonScaleHistoryGram_eq ht hu]
  have := add_pos ht hu
  positivity

/-- Unit visibility is rigid: it occurs exactly on the same clock. -/
theorem poissonScaleHistoryGram_eq_one_iff {t u : ℝ} (ht : 0 < t) (hu : 0 < u) :
    poissonScaleHistoryGram t u = 1 ↔ t = u := by
  rw [poissonScaleHistoryGram_eq ht hu]
  have hsum : t + u ≠ 0 := ne_of_gt (add_pos ht hu)
  constructor
  · intro h
    have hcross : 4 * t * u = (t + u) ^ (2 : ℕ) := by
      apply (div_eq_one_iff_eq (pow_ne_zero 2 hsum)).mp
      exact h
    nlinarith [sq_nonneg (t - u)]
  · intro h
    subst u
    field_simp
    ring

/-- Log-clock coordinates identify the Gram coefficient with squared hyperbolic visibility. -/
theorem poissonScaleHistoryGram_eq_inv_cosh_sq {t u : ℝ} (ht : 0 < t) (hu : 0 < u) :
    poissonScaleHistoryGram t u =
      1 / Real.cosh ((Real.log t - Real.log u) / 2) ^ (2 : ℕ) := by
  rw [poissonScaleHistoryGram_eq ht hu]
  have hcosh : Real.cosh (Real.log t - Real.log u) = (t / u + u / t) / 2 := by
    rw [Real.cosh_eq, Real.exp_sub,
      show -(Real.log t - Real.log u) = Real.log u - Real.log t by ring,
      Real.exp_sub, Real.exp_log ht, Real.exp_log hu]
  have htwo := Real.cosh_two_mul ((Real.log t - Real.log u) / 2)
  rw [show 2 * ((Real.log t - Real.log u) / 2) = Real.log t - Real.log u by ring,
    hcosh] at htwo
  have hhalf : Real.cosh ((Real.log t - Real.log u) / 2) ^ (2 : ℕ) =
      (((t / u + u / t) / 2) + 1) / 2 := by
    nlinarith [Real.cosh_sq_sub_sinh_sq ((Real.log t - Real.log u) / 2)]
  have ht0 : t ≠ 0 := ne_of_gt ht
  have hu0 : u ≠ 0 := ne_of_gt hu
  rw [hhalf]
  field_simp
  ring

/-- Universal profile after the logarithmic aperture change of variables. -/
def poissonLogScaleMother (x : ℝ) : ℝ :=
  2 * Real.exp x * Real.exp (-Real.exp x)

/-- Half-density transport from positive aperture to logarithmic aperture. -/
def poissonLogScaleHistory (t x : ℝ) : ℝ :=
  Real.exp (x / 2) * poissonScaleHistory t (Real.exp x)

/-- Every positive-clock Poisson history is a translate of one universal log-scale profile. -/
theorem poissonLogScaleHistory_eq_translate {t : ℝ} (ht : 0 < t) (x : ℝ) :
    poissonLogScaleHistory t x = poissonLogScaleMother (x + Real.log t) := by
  rw [poissonLogScaleHistory, poissonScaleHistory, poissonLogScaleMother,
    ← Real.exp_half, Real.exp_add, Real.exp_log ht]
  rw [show -(t * Real.exp x) = -(Real.exp x * t) by ring]
  have hexpSq : Real.exp (x / 2) ^ (2 : ℕ) = Real.exp x := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  calc
    Real.exp (x / 2) *
        (2 * t * Real.exp (x / 2) * Real.exp (-(Real.exp x * t))) =
      2 * t * Real.exp (x / 2) ^ (2 : ℕ) * Real.exp (-(Real.exp x * t)) := by ring
    _ = 2 * (Real.exp x * t) * Real.exp (-(Real.exp x * t)) := by
      rw [hexpSq]
      ring

end

end RHTower
