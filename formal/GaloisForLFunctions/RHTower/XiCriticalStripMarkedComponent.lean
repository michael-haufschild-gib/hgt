import GaloisForLFunctions.RHTower.XiCriticalStripField
import GaloisForLFunctions.RHTower.XiLegendreHalvingCriterion
import GaloisForLFunctions.HTGeometry.QuadraticAdjoinSquareKernel

/-!
# The actual marked tower on the analytic critical strip

The entire global marked field embeds over its original base into the single
quadratic extension of StripField generated by a square root of Xi. Adjoining
the image over StripField gives exactly that quadratic field. Every original
and translated source section has a half there, despite its proved global
nondivisibility. This identifies a change of base, not an RH zero-location law.
-/

noncomputable section
open GaloisForLFunctions.HTGeometry
open scoped IntermediateField
namespace RHTower.XiGlobalKummer
local instance : CharZero K := charZero_of_injective_algebraMap constPlane_injective
local instance : CharZero StripField :=
  charZero_of_injective_algebraMap (algebraMap K StripField).injective

abbrev StripClosure := AlgebraicClosure StripField

def stripXiRoot : StripClosure := Classical.choose (IsAlgClosed.exists_pow_nat_eq
  (algebraMap StripField StripClosure (algebraMap K StripField xiElement)) (by decide : 0 < 2))

theorem stripXiRoot_sq : stripXiRoot * stripXiRoot =
    algebraMap StripField StripClosure (algebraMap K StripField xiElement) := by
  simpa only [stripXiRoot, pow_two] using
    (Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
      (algebraMap StripField StripClosure (algebraMap K StripField xiElement))
        (by decide : 0 < 2)))

def stripQuadraticField : IntermediateField StripField StripClosure := StripField⟮stripXiRoot⟯

local instance (priority := high) : DecidableEq stripQuadraticField := Classical.decEq _

theorem stripQuadraticField_finrank : Module.finrank StripField stripQuadraticField = 2 :=
  finrank_adjoin_eq_two stripXiRoot_sq
    (root_not_mem_bot_of_not_isSquare stripXiRoot_sq strip_xi_not_isSquare)

theorem stripQuadratic_xi_isSquare :
    IsSquare (algebraMap StripField stripQuadraticField (algebraMap K StripField xiElement)) :=
  (root_mem_iff_isSquare stripXiRoot_sq stripQuadraticField).mp
    (IntermediateField.subset_adjoin _ _ (Set.mem_singleton _))

/-- A field embedding of the original global algebraic closure into the analytic closure. -/
def stripClosureEmbedding : Ω →ₐ[K] StripClosure := IsAlgClosed.lift

theorem stripClosureEmbedding_root_mem (n : ℕ) :
    stripClosureEmbedding (root n) ∈ stripQuadraticField := by
  have hr : stripClosureEmbedding (root n) * stripClosureEmbedding (root n) =
      algebraMap StripField StripClosure (algebraMap K StripField (radicand n)) := by
    rw [← map_mul, root_sq, AlgHom.commutes,
      IsScalarTower.algebraMap_apply K StripField StripClosure]
  apply (root_mem_iff_isSquare hr stripQuadraticField).mpr
  simp only [radicand, map_mul]
  exact stripQuadratic_xi_isSquare.mul
    ((strip_factor_isSquare (n := n + 2) (Nat.succ_le_succ (Nat.zero_le (n + 1)))).map
      (algebraMap StripField stripQuadraticField))

private theorem markedField_le_strip_preimage :
    markedField ≤ stripQuadraticField.toSubfield.comap stripClosureEmbedding.toRingHom := by
  apply iSup_le
  intro k
  change Subfield.closure ((base : Set Ω) ∪ root '' Set.Iio k) ≤ _
  rw [Subfield.closure_le]
  rintro x (hx | ⟨n, _, rfl⟩)
  · change ∃ a : K, algebraMap K Ω a = x at hx
    obtain ⟨a, rfl⟩ := hx
    change stripClosureEmbedding (algebraMap K Ω a) ∈ stripQuadraticField
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply K StripField StripClosure]
    exact stripQuadraticField.algebraMap_mem _
  · exact stripClosureEmbedding_root_mem n

/-- The whole actual marked field embeds into the common analytic quadratic component. -/
def stripMarkedEmbedding : Marked →ₐ[K] stripQuadraticField where
  toFun a := ⟨stripClosureEmbedding (a : Ω), markedField_le_strip_preimage a.property⟩
  map_one' := Subtype.ext stripClosureEmbedding.map_one
  map_zero' := Subtype.ext stripClosureEmbedding.map_zero
  map_add' a b := Subtype.ext (stripClosureEmbedding.map_add (a : Ω) (b : Ω))
  map_mul' a b := Subtype.ext (stripClosureEmbedding.map_mul (a : Ω) (b : Ω))
  commutes' a := by
    apply Subtype.ext
    exact stripClosureEmbedding.commutes a

theorem stripMarkedEmbedding_injective : Function.Injective stripMarkedEmbedding :=
  stripMarkedEmbedding.injective

instance : Algebra Marked stripQuadraticField := stripMarkedEmbedding.toRingHom.toAlgebra

instance : IsScalarTower K Marked stripQuadraticField :=
  IsScalarTower.of_algebraMap_eq fun a => (stripMarkedEmbedding.commutes a).symm

theorem stripMarked_xi_isSquare :
    IsSquare (algebraMap Marked stripQuadraticField xiMarked) := by
  rw [xiMarked, ← IsScalarTower.algebraMap_apply K Marked stripQuadraticField]
  rw [IsScalarTower.algebraMap_apply K StripField stripQuadraticField]
  exact stripQuadratic_xi_isSquare

theorem stripMarked_lambda_isSquare (n : ℕ) :
    IsSquare (algebraMap Marked stripQuadraticField (1 + sourceParameter n)) := by
  rw [← augmentationElement_map_eq_sourceLambda,
    ← IsScalarTower.algebraMap_apply K Marked stripQuadraticField,
    IsScalarTower.algebraMap_apply K StripField stripQuadraticField]
  exact (strip_augmentation_isSquare (n := n + 2) (Nat.succ_le_succ (Nat.zero_le (n + 1)))).map
    (algebraMap StripField stripQuadraticField)

/-- Original source sections have halves on the actual analytic marked component. -/
theorem sourceSection_has_half_stripQuadraticField (n : ℕ) :
    ∃ R : (sourceCurveOver stripQuadraticField n).Point,
      R + R = sourceSectionOver stripQuadraticField n :=
  (sourceSectionOver_has_half_iff stripQuadraticField n).mpr stripMarked_xi_isSquare

/-- All labelled translated sections have halves on that same quadratic component. -/
theorem translatedSection_has_half_stripQuadraticField (n : ℕ) :
    ∃ R : (sourceCurveOver stripQuadraticField n).Point,
      R + R = translatedSectionOver stripQuadraticField n :=
  (translatedSectionOver_has_half_iff stripQuadraticField n).mpr
    ⟨stripMarked_xi_isSquare, stripMarked_lambda_isSquare n⟩

end RHTower.XiGlobalKummer

namespace RHTower.XiGlobalKummer
open GaloisForLFunctions.HTGeometry
open scoped IntermediateField

/-- The actual analytic compositum, generated by the image of the infinite marked field. -/
noncomputable def stripMarkedCompositum : IntermediateField StripField StripClosure :=
  IntermediateField.adjoin StripField
    (Set.range fun a : Marked => stripClosureEmbedding (a : Ω))

/-- The whole infinite marked tower becomes exactly one quadratic compositum on the strip. -/
theorem stripMarkedCompositum_eq : stripMarkedCompositum = stripQuadraticField := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨a, rfl⟩
    exact markedField_le_strip_preimage a.property
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    apply (root_mem_iff_isSquare stripXiRoot_sq stripMarkedCompositum).mpr
    let u : stripMarkedCompositum := ⟨stripClosureEmbedding (root 0),
      IntermediateField.subset_adjoin _ _ ⟨markedRoot 0, rfl⟩⟩
    have hu : IsSquare (algebraMap StripField stripMarkedCompositum
        (algebraMap K StripField (radicand 0))) := by
      refine ⟨u, ?_⟩
      apply Subtype.ext
      change algebraMap StripField StripClosure (algebraMap K StripField (radicand 0)) =
        stripClosureEmbedding (root 0) * stripClosureEmbedding (root 0)
      rw [← map_mul, root_sq, AlgHom.commutes,
        IsScalarTower.algebraMap_apply K StripField StripClosure]
    have hf := (strip_factor_isSquare (n := 2) (by omega)).map
      (algebraMap StripField stripMarkedCompositum)
    have hd := hu.div hf
    have hne : algebraMap StripField stripMarkedCompositum
        (algebraMap K StripField (factorElement 2)) ≠ 0 :=
      (map_ne_zero _).mpr ((map_ne_zero _).mpr (factorElement_ne_zero (by omega)))
    have he : algebraMap StripField stripMarkedCompositum
          (algebraMap K StripField (radicand 0)) /
        algebraMap StripField stripMarkedCompositum (algebraMap K StripField (factorElement 2)) =
          algebraMap StripField stripMarkedCompositum (algebraMap K StripField xiElement) := by
      simp only [radicand, zero_add, map_mul]
      exact mul_div_cancel_right₀ _ hne
    rw [he] at hd
    exact hd

theorem stripMarkedCompositum_finrank : Module.finrank StripField stripMarkedCompositum = 2 := by
  rw [stripMarkedCompositum_eq]
  exact stripQuadraticField_finrank

end RHTower.XiGlobalKummer
