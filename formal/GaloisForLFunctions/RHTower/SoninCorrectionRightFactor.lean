import GaloisForLFunctions.RHTower.SoninTimeBandIdeal

/-!
# Actual time-band left factors of the Sonin correction

The resolvent formula puts the correction in the right ideal generated by the
two literal time-band blocks. This retains their output regularity when an
unsquared coherent dilation source acts from the left; membership in the
two-sided trace ideal alone does not retain that information.
-/

noncomputable section

namespace RHTower

/-- The bounded right factor determined by the original Sonin resolvent. -/
def soninCorrectionSourceRightFactor (a : ℝ) (ha : 0 < a) : SoninL2 →L[ℂ] SoninL2 :=
  1 - (centralFourierForbidden a).starProjection *
    soninProjectionResolvent (centralPhysicalForbidden a) (centralFourierForbidden a)
      (norm_centralSoninAlternatingBlock_lt_one a ha) *
    (centralFourierForbidden a).starProjection *
    (1 - (centralPhysicalForbidden a).starProjection)

/-- The correction has the actual time-band blocks as left factors, without an arbitrary
bounded operator on their left. -/
theorem centralSoninProjectionCorrection_eq_timeBand_rightFactors (a : ℝ) (ha : 0 < a) :
    centralSoninProjectionCorrection a =
      (centralPhysicalForbidden a).starProjection * (centralFourierForbidden a).starProjection *
        (1 - (centralPhysicalForbidden a).starProjection * soninCorrectionSourceRightFactor a ha) +
      (centralFourierForbidden a).starProjection * (centralPhysicalForbidden a).starProjection *
        soninCorrectionSourceRightFactor a ha := by
  let A := centralPhysicalForbidden a
  let B := centralFourierForbidden a
  let T : SoninL2 →L[ℂ] SoninL2 := soninAlternatingBlock A B
  let V : SoninL2 →L[ℂ] SoninL2 :=
    soninProjectionResolvent A B (norm_centralSoninAlternatingBlock_lt_one a ha)
  let E : SoninL2 →L[ℂ] SoninL2 := A.orthogonal.starProjection
  have hE : E = 1 - A.starProjection := A.starProjection_orthogonal'
  have hVsub : V - 1 = T * V := by
    let e : (SoninL2 →L[ℂ] SoninL2)ˣ :=
      Units.oneSub T (norm_centralSoninAlternatingBlock_lt_one a ha)
    have hmul : (1 - T) * V = 1 := by
      change (↑e : SoninL2 →L[ℂ] SoninL2) * (↑(e⁻¹) : SoninL2 →L[ℂ] SoninL2) = 1
      rw [← Units.val_mul]
      simp
    calc
      V - 1 = V - (1 - T) * V := by rw [hmul]
      _ = T * V := by noncomm_ring
  have hQ : centralSoninProjection a = E - E * V * B.starProjection * E := by
    rw [centralSoninProjection_eq_soninIntersectionProjection]
    exact soninIntersectionProjection_eq_resolventFormula A B
      (norm_centralSoninAlternatingBlock_lt_one a ha)
  have hformal : centralSoninFormalComplement a = E - B.starProjection := by
    rw [hE]
    simp only [centralSoninFormalComplement, A, B, centralPhysicalForbidden, centralInterval,
      centralFourierForbidden, indicatorCutoff_eq_physicalForbidden_starProjection,
      fourierCutoff_eq_fourierForbidden_starProjection]
  have hJ : centralSoninProjectionCorrection a =
      A.starProjection * B.starProjection + B.starProjection * A.starProjection -
        A.starProjection * B.starProjection * A.starProjection -
          E * (V - 1) * B.starProjection * E := by
    change centralSoninProjection a - centralSoninFormalComplement a = _
    rw [hQ, hformal, hE]
    noncomm_ring
  rw [hJ, hVsub, hE]
  change A.starProjection * B.starProjection + B.starProjection * A.starProjection -
      A.starProjection * B.starProjection * A.starProjection -
        (1 - A.starProjection) * (B.starProjection * A.starProjection * B.starProjection * V) *
          B.starProjection * (1 - A.starProjection) =
    A.starProjection * B.starProjection *
      (1 - A.starProjection * (1 - B.starProjection * V * B.starProjection *
        (1 - A.starProjection))) +
      B.starProjection * A.starProjection *
        (1 - B.starProjection * V * B.starProjection * (1 - A.starProjection))
  noncomm_ring

end RHTower
