import GaloisForLFunctions.RHTower.XiCriticalStripMarkedComponent
import GaloisForLFunctions.HTGeometry.EtaleCommonQuadratic
import GaloisForLFunctions.HTGeometry.MultiquadraticAdjoinDegree
import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Finite marked tensor algebras on the critical strip

The literal scalar extension of each nonempty finite global marked field is
a product of exactly `2^(card T - 1)` copies of the actual common quadratic
strip field. Global independent radicands give the dimension; analytic factor
roots put every etale field component in the single surviving Xi class.
-/

noncomputable section
open GaloisForLFunctions.HTGeometry
open scoped IntermediateField TensorProduct
namespace RHTower.XiGlobalKummer
local instance : CharZero K := charZero_of_injective_algebraMap constPlane_injective

/-- The actual global field generated by the marked roots at a finite label set. -/
def finiteMarkedExtension (T : Finset ℕ) : IntermediateField K Ω :=
  IntermediateField.adjoin K (root '' (T : Set ℕ))

theorem finiteMarkedExtension_finrank (T : Finset ℕ) :
    Module.finrank K (finiteMarkedExtension T) = 2 ^ T.card :=
  (multiquadratic_degree_and_twists radicand root (by norm_num) root_sq
    prod_radicand_not_isSquare T).1

instance (T : Finset ℕ) : FiniteDimensional K (finiteMarkedExtension T) :=
  FiniteDimensional.of_finrank_pos (by rw [finiteMarkedExtension_finrank]; positivity)

instance (T : Finset ℕ) : Algebra.Etale K (finiteMarkedExtension T) where
  formallyEtale := Algebra.FormallyEtale.of_isSeparable K (finiteMarkedExtension T)
  finitePresentation := Algebra.FinitePresentation.of_finiteType.mp inferInstance

def finiteMarkedRoot (T : Finset ℕ) (n : T) : finiteMarkedExtension T :=
  ⟨root n, IntermediateField.subset_adjoin _ _ ⟨n, n.property, rfl⟩⟩

theorem finiteMarkedRoot_sq (T : Finset ℕ) (n : T) :
    finiteMarkedRoot T n * finiteMarkedRoot T n =
      algebraMap K (finiteMarkedExtension T) (radicand n) := by
  apply Subtype.ext
  exact root_sq n

theorem finiteMarkedRoot_generates (T : Finset ℕ) :
    Algebra.adjoin K (Set.range (finiteMarkedRoot T)) = ⊤ := by
  have hi : IntermediateField.adjoin K (Set.range (finiteMarkedRoot T)) = ⊤ := by
    apply IntermediateField.lift_injective (finiteMarkedExtension T)
    rw [IntermediateField.lift_adjoin, IntermediateField.lift_top]
    change IntermediateField.adjoin K _ = IntermediateField.adjoin K _
    congr 1
    ext x
    constructor
    · rintro ⟨_, ⟨n, rfl⟩, rfl⟩
      exact ⟨n, n.property, rfl⟩
    · rintro ⟨n, hn, rfl⟩
      exact ⟨finiteMarkedRoot T ⟨n, hn⟩, ⟨⟨n, hn⟩, rfl⟩, rfl⟩
  rw [← IntermediateField.adjoin_toSubalgebra, hi]
  rfl

/-- A chosen square root in the actual strip field; used only for the algebraic splitting. -/
def stripFactorSquareRoot (n : ℕ) : StripField :=
  Classical.choose (strip_factor_isSquare (n := n + 2) (Nat.succ_le_succ (Nat.zero_le (n + 1))))

theorem stripFactorSquareRoot_sq (n : ℕ) :
    stripFactorSquareRoot n ^ 2 = algebraMap K StripField (factorElement (n + 2)) := by
  simpa only [stripFactorSquareRoot, pow_two] using
    (Classical.choose_spec (strip_factor_isSquare (n := n + 2)
      (Nat.succ_le_succ (Nat.zero_le (n + 1))))).symm

theorem stripFactorSquareRoot_ne_zero (n : ℕ) : stripFactorSquareRoot n ≠ 0 := by
  intro h
  have hz := stripFactorSquareRoot_sq n
  rw [h, zero_pow (by decide : (2 : ℕ) ≠ 0)] at hz
  exact (map_ne_zero (algebraMap K StripField)).mpr
    (factorElement_ne_zero (by omega)) hz.symm

abbrev finiteMarkedStripTensor (T : Finset ℕ) : Type :=
  StripField ⊗[K] (finiteMarkedExtension T)

def finiteStripTensorRoot (T : Finset ℕ) (n : T) : finiteMarkedStripTensor T :=
  1 ⊗ₜ[K] finiteMarkedRoot T n

theorem finiteStripTensorRoot_sq (T : Finset ℕ) (n : T) :
    (finiteStripTensorRoot T n * finiteStripTensorRoot T n : finiteMarkedStripTensor T) =
      (algebraMap K StripField xiElement * stripFactorSquareRoot n ^ 2) ⊗ₜ[K]
        (1 : finiteMarkedExtension T) := by
  rw [stripFactorSquareRoot_sq, ← map_mul]
  change (1 ⊗ₜ[K] finiteMarkedRoot T n) * (1 ⊗ₜ[K] finiteMarkedRoot T n) =
    (algebraMap K StripField (radicand n)) ⊗ₜ[K] (1 : finiteMarkedExtension T)
  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, finiteMarkedRoot_sq,
    ← Algebra.TensorProduct.algebraMap_apply', Algebra.TensorProduct.algebraMap_apply]

theorem finiteStripTensorRoot_generates (T : Finset ℕ) :
    Algebra.adjoin StripField (Set.range (finiteStripTensorRoot T)) = ⊤ := by
  have he : Set.range (finiteStripTensorRoot T) =
      (fun x : finiteMarkedExtension T => (1 : StripField) ⊗ₜ[K] x) ''
        Set.range (finiteMarkedRoot T) := Set.range_comp _ _
  rw [he]
  exact Algebra.TensorProduct.adjoin_one_tmul_image_eq_top _ (finiteMarkedRoot_generates T)

/-- Literal scalar extension of a nonempty finite marked field splits into the
specified number of copies of the actual common analytic quadratic field. -/
theorem finiteMarkedStripTensor_decomposition (T : Finset ℕ) (hT : T.Nonempty) :
    ∃ (I : Type) (_ : Fintype I)
      (_e : finiteMarkedStripTensor T ≃ₐ[StripField] (I → stripQuadraticField)),
      Fintype.card I = 2 ^ (T.card - 1) := by
  obtain ⟨n, hn⟩ := hT
  obtain ⟨I, hI, e, he⟩ := etale_common_quadratic_decomposition
    (finiteStripTensorRoot T) (fun n : T => stripFactorSquareRoot n) ⟨n, hn⟩
    strip_xi_not_isSquare (fun n => stripFactorSquareRoot_ne_zero n)
    (fun n => by simpa only [Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply] using finiteStripTensorRoot_sq T n)
    (finiteStripTensorRoot_generates T) stripXiRoot_sq
  refine ⟨I, hI, e, ?_⟩
  rw [Module.finrank_baseChange, finiteMarkedExtension_finrank] at he
  have hcard : 0 < T.card := Finset.card_pos.mpr ⟨n, hn⟩
  have hp : 2 ^ T.card = 2 ^ (T.card - 1) * 2 := by
    conv_lhs => rw [show T.card = (T.card - 1) + 1 by omega]
    rw [pow_succ]
  rw [hp] at he
  exact Nat.eq_of_mul_eq_mul_right (by decide : 0 < 2) he

end RHTower.XiGlobalKummer
