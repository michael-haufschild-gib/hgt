import GaloisForLFunctions.RHTower.ReflectionConeCertificate
import GaloisForLFunctions.RHTower.CothInfra

/-!
# Λ-positivity is not semidefinite representable

An element of the reflection cone is a real exponential sum `h(u) = Σ_j t_j cosh(w_j u)` with the
frequency multiset closed under conjugation, and `Λ`-positivity of the associated correction is
`h ≥ 0` on `ℝ`.  When all `w_j` are real the cone is exactly the cone of sums of Hermitian squares
of exponential polynomials (substitute `z = e^{δu}` and apply Pólya–Szegő, noting `z = (e^{δu/2})²`);
when all `w_j` are purely imaginary the same holds by Fejér–Riesz.  This file shows the **mixed**
case fails.

Let `Γ` be the additive group generated by all frequencies occurring in a putative representation
`h = Σ_k |q_k|²`.  The map `μ ↦ (Re μ, Im μ)` embeds `Γ` in `ℝ²`, so for every pair `(s, φ)` of
reals

```text
χ_{s,φ}(μ) := exp(Re(μ)·s + i·Im(μ)·φ)
```

is a character of `Γ` with `χ_{s,φ}(μ̄) = conj χ_{s,φ}(μ)`.  Substituting `χ_{s,φ}` for `e^{μu}`
turns each `q_k` into a function of `(s,φ)` and each `|q_k|²` into its squared modulus, so the
**cylinder lift** of `h` — the two-variable function obtained by replacing `e^{au}` by `e^{as}` and
`e^{iγu}` by `e^{iγφ}` — would have to be nonnegative on all of `ℝ²`.  The diagonal `φ = s`
recovers `h`, but the lift is defined off the diagonal, and that is where a certificate can fail.

The witness is

```text
h(u) = ½cosh(2u) - 5cosh(u) - cos(u) + 15/2 = (1 - cos u) + (cosh u - 2)(cosh u - 3).
```

If `cosh u ≤ 2` or `cosh u ≥ 3` both summands are nonnegative.  If `2 < cosh u < 3` then
`1 < |u| < 2`, so `sin(|u|/2) ≥ sin(1/2) > 7/15` and `1 - cos u = 2 sin²(u/2) > 2·(7/15)²`, while
`|(cosh u - 2)(cosh u - 3)| ≤ 1/4`; and `2·(7/15)² > 1/4`.  So `h ≥ 0` on `ℝ`.

Its cylinder lift at phase `0` is `(cosh s - 2)(cosh s - 3)`, which at
`s = log((5 + √21)/2)`, where `cosh s = 5/2`, equals `-1/4`.  That point is off the diagonal:
phase `0` on the diagonal forces `s ∈ 2πℤ`, where `cosh s` is `1` or at least `cosh 2π`, never in
`(2,3)`.

Hence `h` lies in the cone but admits no sum-of-Hermitian-squares certificate, so `Λ`-positivity is
strictly stronger than semidefinite representability and no fixed-degree semidefinite relaxation can
decide it.
-/

open Real

noncomputable section

namespace RHTower

/-! ## The witness and its cylinder lift -/

/-- The witness: nonnegative on `ℝ`, but with a negative cylinder lift. -/
def coneObstruction (u : ℝ) : ℝ :=
  (1 / 2) * Real.cosh (2 * u) - 5 * Real.cosh u - Real.cos u + 15 / 2

/-- The cylinder lift, obtained by giving the hyperbolic and the oscillatory frequencies
independent parameters.  Any sum-of-Hermitian-squares certificate for `coneObstruction` forces this
to be nonnegative on all of `ℝ²`. -/
def cylinderLift (s φ : ℝ) : ℝ :=
  (1 / 2) * Real.cosh (2 * s) - 5 * Real.cosh s - Real.cos φ + 15 / 2

theorem cylinderLift_diag (u : ℝ) : cylinderLift u u = coneObstruction u := rfl

/-- The witness splits into an oscillatory part and a hyperbolic quadratic. -/
theorem coneObstruction_eq (u : ℝ) :
    coneObstruction u = (1 - Real.cos u) + (Real.cosh u - 2) * (Real.cosh u - 3) := by
  have h := Real.cosh_two_mul u
  have hs := Real.cosh_sq_sub_sinh_sq u
  unfold coneObstruction
  nlinarith [h, hs]

/-- At phase zero the lift is the hyperbolic quadratic alone. -/
theorem cylinderLift_zero_phase (s : ℝ) :
    cylinderLift s 0 = (Real.cosh s - 2) * (Real.cosh s - 3) := by
  have h := Real.cosh_two_mul s
  have hs := Real.cosh_sq_sub_sinh_sq s
  unfold cylinderLift
  simp only [Real.cos_zero]
  nlinarith [h, hs]

/-! ## Nonnegativity of the witness -/

theorem three_lt_cosh_two : 3 < Real.cosh 2 := by
  have h1 : (2.7182818283 : ℝ) < Real.exp 1 := Real.exp_one_gt_d9
  have h2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by
    rw [← Real.exp_add]; norm_num
  have h3 : (0 : ℝ) < Real.exp (-2) := Real.exp_pos _
  rw [Real.cosh_eq]
  nlinarith [h1, h2, h3]

/-- On the region where the hyperbolic quadratic is negative, `|u|` lies strictly between `1`
and `2`. -/
theorem abs_mem_of_cosh_mem {u : ℝ} (h2 : 2 < Real.cosh u) (h3 : Real.cosh u < 3) :
    1 < |u| ∧ |u| < 2 := by
  constructor
  · rcases lt_or_ge 1 |u| with h | h
    · exact h
    · exact absurd h (by
        have : Real.cosh u ≤ Real.cosh 1 :=
          Real.cosh_le_cosh.mpr (by rw [abs_one]; exact h)
        exact absurd this (by linarith [cosh_one_lt_two]))
  · rcases lt_or_ge |u| 2 with h | h
    · exact h
    · exact absurd h (by
        have : Real.cosh 2 ≤ Real.cosh u :=
          Real.cosh_le_cosh.mpr (by rw [abs_two]; exact h)
        exact absurd this (by linarith [three_lt_cosh_two]))

/-- `1 - cos u = 2 sin²(u/2)`. -/
theorem one_sub_cos_eq (u : ℝ) : 1 - Real.cos u = 2 * Real.sin (u / 2) ^ (2 : ℕ) := by
  have h := two_sin_sq_half 1 u
  rw [one_mul] at h
  linarith

theorem sin_half_lower {u : ℝ} (h1 : 1 < |u|) (h2 : |u| < 2) :
    (7 : ℝ) / 15 < Real.sin (|u| / 2) := by
  have hx0 : (0 : ℝ) < (1 : ℝ) / 2 := by norm_num
  have hcube : (1 : ℝ) / 2 - (1 / 2) ^ (3 : ℕ) / 6 < Real.sin (1 / 2) :=
    Real.sin_gt_sub_cube hx0
  have hmono : Real.sin (1 / 2) ≤ Real.sin (|u| / 2) := by
    refine Real.sin_le_sin_of_le_of_le_pi_div_two (by nlinarith [Real.pi_pos]) ?_ (by linarith)
    have hpi : (2 : ℝ) / 2 ≤ Real.pi / 2 := by
      have := Real.pi_gt_three; linarith
    linarith
  have : (7 : ℝ) / 15 < 1 / 2 - (1 / 2) ^ (3 : ℕ) / 6 := by norm_num
  linarith

/-- **The witness is nonnegative on `ℝ`.** -/
theorem coneObstruction_nonneg (u : ℝ) : 0 ≤ coneObstruction u := by
  rw [coneObstruction_eq]
  have hcos : 0 ≤ 1 - Real.cos u := by
    have := Real.cos_le_one u; linarith
  rcases le_or_gt (Real.cosh u) 2 with h2 | h2
  · have : 0 ≤ (Real.cosh u - 2) * (Real.cosh u - 3) := by nlinarith
    linarith
  rcases le_or_gt 3 (Real.cosh u) with h3 | h3
  · have : 0 ≤ (Real.cosh u - 2) * (Real.cosh u - 3) := by nlinarith
    linarith
  · obtain ⟨hu1, hu2⟩ := abs_mem_of_cosh_mem h2 h3
    have hsin := sin_half_lower hu1 hu2
    have hsq : Real.sin (u / 2) ^ (2 : ℕ) = Real.sin (|u| / 2) ^ (2 : ℕ) := by
      rcases abs_cases u with ⟨he, _⟩ | ⟨he, _⟩
      · rw [he]
      · rw [he, neg_div, Real.sin_neg, neg_pow]
        simp
    have hlow : 2 * (7 / 15 : ℝ) ^ (2 : ℕ) < 1 - Real.cos u := by
      rw [one_sub_cos_eq, hsq]
      have h0 : (0 : ℝ) ≤ 7 / 15 := by norm_num
      nlinarith [hsin, h0]
    have hbound : (Real.cosh u - 2) * (Real.cosh u - 3) ≥ -(1 / 4 : ℝ) := by
      nlinarith [sq_nonneg (Real.cosh u - 5 / 2)]
    have : (2 : ℝ) * (7 / 15) ^ (2 : ℕ) > 1 / 4 := by norm_num
    linarith

/-! ## The lift is negative off the diagonal -/

/-- The abscissa at which `cosh s = 5/2`. -/
def obstructionPoint : ℝ := Real.log ((5 + Real.sqrt 21) / 2)

theorem sqrt21_sq : Real.sqrt 21 ^ (2 : ℕ) = 21 := Real.sq_sqrt (by norm_num)

theorem sqrt21_lt_five : Real.sqrt 21 < 5 := by
  nlinarith [sqrt21_sq, Real.sqrt_nonneg 21]

theorem cosh_obstructionPoint : Real.cosh obstructionPoint = 5 / 2 := by
  have hpos : (0 : ℝ) < (5 + Real.sqrt 21) / 2 := by
    have := Real.sqrt_nonneg 21; linarith
  have hexp : Real.exp obstructionPoint = (5 + Real.sqrt 21) / 2 := Real.exp_log hpos
  have hinv : Real.exp (-obstructionPoint) = (5 - Real.sqrt 21) / 2 := by
    rw [Real.exp_neg, hexp]
    have hne : (5 + Real.sqrt 21) / 2 ≠ 0 := ne_of_gt hpos
    field_simp
    nlinarith [sqrt21_sq]
  rw [Real.cosh_eq, hexp, hinv]
  ring

/-- **The lift is negative at an off-diagonal point.** -/
theorem cylinderLift_obstructionPoint : cylinderLift obstructionPoint 0 = -(1 / 4) := by
  rw [cylinderLift_zero_phase, cosh_obstructionPoint]
  norm_num

/-- **Failure of the sum-of-squares certificate.**  The cylinder lift of the witness admits no
representation as a finite sum of squared moduli, since it is negative at
`(obstructionPoint, 0)`.  By the character argument in the module docstring, a sum-of-Hermitian-
squares certificate for `coneObstruction` would produce exactly such a representation. -/
theorem cylinderLift_not_sum_of_squares {n : ℕ} (q : Fin n → ℝ → ℝ → ℂ)
    (h : ∀ s φ, cylinderLift s φ = ∑ k, ‖q k s φ‖ ^ (2 : ℕ)) : False := by
  have hneg := cylinderLift_obstructionPoint
  have hnn : (0 : ℝ) ≤ ∑ k, ‖q k obstructionPoint 0‖ ^ (2 : ℕ) :=
    Finset.sum_nonneg fun k _ => by positivity
  rw [h obstructionPoint 0] at hneg
  linarith

/-! ## No multiplier certificate either

The lift is negative not merely at a point but on an open set, so multiplying by a nonnegative
element cannot repair the certificate: an Artin-style denominator representation `h·σ = Σ|q_k|²`
would force `σ` to vanish on that open set. -/

/-- The lift moves by exactly `1 - cos φ` as the phase varies. -/
theorem cylinderLift_phase_shift (s φ : ℝ) :
    cylinderLift s φ = cylinderLift s 0 + (1 - Real.cos φ) := by
  unfold cylinderLift
  simp only [Real.cos_zero]
  ring

/-- The lift is negative on a whole open set of phases above the obstruction abscissa. -/
theorem cylinderLift_neg_of_cos_gt {φ : ℝ} (hφ : 3 / 4 < Real.cos φ) :
    cylinderLift obstructionPoint φ < 0 := by
  rw [cylinderLift_phase_shift, cylinderLift_obstructionPoint]
  linarith

/-- **No multiplier certificate.**  If `h·σ` is a sum of squared moduli with `σ` nonnegative, then
`σ` vanishes identically on the open set where the lift is negative.  Since that set is nonempty and
open and everything in sight is real analytic, no nonzero multiplier can exist. -/
theorem no_multiplier_certificate {n : ℕ} (σ : ℝ → ℝ → ℝ) (q : Fin n → ℝ → ℝ → ℂ)
    (hσ : ∀ s φ, 0 ≤ σ s φ)
    (h : ∀ s φ, cylinderLift s φ * σ s φ = ∑ k, ‖q k s φ‖ ^ (2 : ℕ))
    {φ : ℝ} (hφ : 3 / 4 < Real.cos φ) :
    σ obstructionPoint φ = 0 := by
  have hneg := cylinderLift_neg_of_cos_gt hφ
  have hnn : (0 : ℝ) ≤ ∑ k, ‖q k obstructionPoint φ‖ ^ (2 : ℕ) :=
    Finset.sum_nonneg fun k _ => by positivity
  have hprod : 0 ≤ cylinderLift obstructionPoint φ * σ obstructionPoint φ := by
    rw [h obstructionPoint φ]; exact hnn
  have hs := hσ obstructionPoint φ
  nlinarith [hneg, hs, hprod]

end RHTower
