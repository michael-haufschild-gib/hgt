import GaloisForLFunctions.RHTower.L2MellinUnitary

/-!
# Connes' one-dimensional flow trace

Formalization of §IV (19)-(21) of

  A. Connes, *Trace formula in noncommutative geometry and the zeros of the Riemann zeta
  function*, arXiv:math/9811068.

For the model flow `F_t(x) = e^t x` on `M = ℝ` — the flow generated by the scaling vector field
`v(x) = x ∂/∂x`, whose only fixed point is the zero `x = 0` of `v` — the tangent map is the scalar
`(F_t)_* = e^t`, so the Guillemin-Sternberg distributional trace formula IV (16) collapses to

  `"Trace" (∫ h(t) U_t dt) = ∫ h(t) / |1 - e^t| dt`,        (IV (20))

which in multiplicative notation, i.e. after the substitution `u = e^t` carrying Lebesgue measure to
the multiplicative Haar measure `d^*u` of `ℝ^*_+`, becomes

  `"Trace" (U(h)) = ∫ h(u) / |1 - u| d^*u`.                  (IV (21))

This is the local model of every term of the Weil explicit formula, and the entire paper is the
statement that the adele class space realizes it globally.

* `connesScalingFlow_deriv` - `(F_t)_* = e^t`.
* `connes_flowTrace_multiplicative` - IV (20) = IV (21): the exponential substitution.

The multiplicative Haar measure used is the corpus-owned `RHTower.MellinL2.multiplicativeHaar`,
defined as the pushforward of Lebesgue measure by `exp`.
-/

namespace GaloisForLFunctions.RHTower

noncomputable section
open MeasureTheory RHTower.MellinL2

/-- The scaling flow `F_t(x) = e^t x` of §IV (19). -/
def connesScalingFlow (t x : ℝ) : ℝ := Real.exp t * x

/-- **§IV (19).**  The tangent map of the scaling flow is the scalar `e^t`. -/
theorem connesScalingFlow_deriv (t x : ℝ) :
    deriv (connesScalingFlow t) x = Real.exp t := by
  have h : HasDerivAt (connesScalingFlow t) (Real.exp t * 1) x :=
    (hasDerivAt_id x).const_mul (Real.exp t)
  rw [mul_one] at h
  exact h.deriv

/-- The scaling vector field `v(x) = x` has a single zero, at the origin. -/
theorem connesScalingFlow_fixedPoint_iff (t x : ℝ) (ht : t ≠ 0) :
    connesScalingFlow t x = x ↔ x = 0 := by
  constructor
  · intro h
    by_contra hx
    have hx' : Real.exp t = 1 := by
      have h' : (Real.exp t - 1) * x = 0 := by
        simp only [connesScalingFlow] at h
        linear_combination h
      rcases mul_eq_zero.mp h' with h'' | h''
      · linarith [h'']
      · exact absurd h'' hx
    exact ht ((Real.exp_eq_one_iff t).mp hx')
  · rintro rfl
    simp [connesScalingFlow]

/-- **§IV (20) = §IV (21).**  The distributional trace of the scaling flow, written in the additive
coordinate `t` and in the multiplicative coordinate `u = e^t`, are the same number.  Here `∫^*` is
the corpus-owned multiplicative Haar measure `exp_* dt` on `ℝ^*_+`. -/
theorem connes_flowTrace_multiplicative (h : PosReal → ℂ) :
    ∫ t : ℝ, h (expMeasurableEquiv t) * ((|1 - Real.exp t| : ℝ) : ℂ)⁻¹
      = ∫ u : PosReal, h u * ((|1 - (u : ℝ)| : ℝ) : ℂ)⁻¹ ∂multiplicativeHaar := by
  have hmp := exp_measurePreserving
  have hme : MeasurableEmbedding (expMeasurableEquiv : ℝ → PosReal) :=
    expMeasurableEquiv.measurableEmbedding
  have hkey := hmp.integral_comp hme (fun u : PosReal => h u * ((|1 - (u : ℝ)| : ℝ) : ℂ)⁻¹)
  exact hkey

end

end GaloisForLFunctions.RHTower
