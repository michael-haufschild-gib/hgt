import GaloisForLFunctions.RHTower.ReciprocalSeamZerothMoment

/-!
# The admissible domain of the raw unshifted reciprocal-seam form is `y·R[y]`

The reciprocal seam atoms `y_ρ = -(ρ - 1/2)^{-2}` accumulate at `0` and the divisor is infinite, so
the raw unshifted square form `U[p] = ∑_ρ p(y_ρ)²` can only converge when `p(0) = 0`: otherwise its
terms tend to `p(0)² ≠ 0`.  The polynomials vanishing at `0` are exactly the ideal `y·R[y]`, and
writing `p = y·q` turns `U[p]` into the shifted route form

`Q₁[q] = ∑_ρ y_ρ² q(y_ρ)²`,

whose moment expansion uses only moments of index at least two — all of them in the convergent part
of the seam tower.  The unshifted form on the full polynomial ring would need a finite value for the
divergent zeroth moment, which is extra regularization data.

## Main results

* `tendsto_reciprocalSeamAtom_cofinite` — the atoms accumulate at `0`;
* `eval_zero_eq_zero_of_summable_square` — convergence forces `p(0) = 0`;
* `admissibleDomain_eq_X_dvd` — the admissible domain is exactly the ideal `y·R[y]`;
* `unshiftedForm_eq_shiftedForm` — on that domain the raw form is the shifted route form;
* `shiftedForm_eq_moment_sum` — its moment expansion uses only moments of index at least two;
* `not_summable_reciprocalSeamZerothMoment` (corpus) — the unshifted extension needs a finite part.
-/

noncomputable section

namespace RHTower

open scoped BigOperators

/-- The reciprocal-seam moment tower `T k = ∑' ρ, y_ρ ^ k`. -/
def reciprocalSeamMoment (k : ℕ) : ℂ := ∑' q : XiZeroCopy, reciprocalSeamAtom q ^ k

/-- **The seam atoms accumulate at the origin.** -/
theorem tendsto_reciprocalSeamAtom_cofinite :
    Filter.Tendsto reciprocalSeamAtom Filter.cofinite (nhds 0) := by
  rw [tendsto_zero_iff_norm_tendsto_zero]
  exact summable_norm_reciprocalSeamAtom.tendsto_cofinite_zero

/-- **Convergence of the raw unshifted form forces a zero at the accumulation point.** -/
theorem eval_zero_eq_zero_of_summable_square {p : Polynomial ℂ}
    (h : Summable (fun q : XiZeroCopy => (p.eval (reciprocalSeamAtom q)) ^ 2)) :
    p.eval 0 = 0 := by
  have hterm : Filter.Tendsto (fun q : XiZeroCopy => (p.eval (reciprocalSeamAtom q)) ^ 2)
      Filter.cofinite (nhds ((p.eval 0) ^ 2)) := by
    have hcont : Continuous fun z : ℂ => (p.eval z) ^ 2 := by
      exact (p.continuous_aeval.congr (fun z => by simp)).pow 2
    exact (hcont.tendsto 0).comp tendsto_reciprocalSeamAtom_cofinite
  have hzero := h.tendsto_cofinite_zero
  have := tendsto_nhds_unique hterm hzero
  exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp this

/-- **The admissible domain is exactly the ideal generated by the seam coordinate.** -/
theorem admissibleDomain_eq_X_dvd {p : Polynomial ℂ}
    (h : Summable (fun q : XiZeroCopy => (p.eval (reciprocalSeamAtom q)) ^ 2)) :
    Polynomial.X ∣ p := by
  rw [Polynomial.X_dvd_iff, Polynomial.coeff_zero_eq_eval_zero]
  exact eval_zero_eq_zero_of_summable_square h

/-- Every polynomial in the ideal is admissible: after factoring the mandatory zero the form is the
shifted one, whose moments all have index at least two. -/
theorem summable_shiftedForm (Q : Polynomial ℂ) :
    Summable (fun q : XiZeroCopy =>
      reciprocalSeamAtom q ^ 2 * (Q.eval (reciprocalSeamAtom q)) ^ 2) := by
  classical
  have hexpand : ∀ q : XiZeroCopy,
      reciprocalSeamAtom q ^ 2 * (Q.eval (reciprocalSeamAtom q)) ^ 2
        = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
            (Q.coeff i * Q.coeff j) * reciprocalSeamAtom q ^ (i + j + 2) := by
    intro q
    rw [Polynomial.eval_eq_sum_range]
    have hsq : (∑ i ∈ Finset.range (Q.natDegree + 1), Q.coeff i * reciprocalSeamAtom q ^ i) ^ 2
        = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
            (Q.coeff i * reciprocalSeamAtom q ^ i) * (Q.coeff j * reciprocalSeamAtom q ^ j) := by
      rw [pow_two, Finset.sum_mul_sum]
    rw [hsq, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  refine Summable.congr ?_ (fun q => (hexpand q).symm)
  refine summable_sum (fun i _ => ?_)
  refine summable_sum (fun j _ => ?_)
  exact (summable_reciprocalSeamAtom_pow (by omega)).mul_left _

/-- **The raw form on its admissible domain is the shifted route form.** -/
theorem unshiftedForm_eq_shiftedForm (Q : Polynomial ℂ) (q : XiZeroCopy) :
    ((Polynomial.X * Q).eval (reciprocalSeamAtom q)) ^ 2
      = reciprocalSeamAtom q ^ 2 * (Q.eval (reciprocalSeamAtom q)) ^ 2 := by
  rw [Polynomial.eval_mul, Polynomial.eval_X, mul_pow]

/-- **The moment expansion of the shifted form uses only moments of index at least two.** -/
theorem shiftedForm_eq_moment_sum (Q : Polynomial ℂ) :
    (∑' q : XiZeroCopy, reciprocalSeamAtom q ^ 2 * (Q.eval (reciprocalSeamAtom q)) ^ 2)
      = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
          (Q.coeff i * Q.coeff j) * reciprocalSeamMoment (i + j + 2) := by
  classical
  have hexpand : ∀ q : XiZeroCopy,
      reciprocalSeamAtom q ^ 2 * (Q.eval (reciprocalSeamAtom q)) ^ 2
        = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
            (Q.coeff i * Q.coeff j) * reciprocalSeamAtom q ^ (i + j + 2) := by
    intro q
    rw [Polynomial.eval_eq_sum_range]
    have hsq : (∑ i ∈ Finset.range (Q.natDegree + 1), Q.coeff i * reciprocalSeamAtom q ^ i) ^ 2
        = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
            (Q.coeff i * reciprocalSeamAtom q ^ i) * (Q.coeff j * reciprocalSeamAtom q ^ j) := by
      rw [pow_two, Finset.sum_mul_sum]
    rw [hsq, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  rw [tsum_congr hexpand]
  rw [Summable.tsum_finsetSum (fun i _ => summable_sum (fun j _ =>
    (summable_reciprocalSeamAtom_pow (by omega)).mul_left _))]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Summable.tsum_finsetSum (fun j _ => (summable_reciprocalSeamAtom_pow (by omega)).mul_left _)]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [reciprocalSeamMoment, tsum_mul_left]

/-- **The admissible-domain theorem.**  The raw unshifted reciprocal-seam square form converges
exactly on the ideal `y·R[y]`, and there it is the shifted route form `Q₁`. -/
theorem reciprocalSeam_admissibleDomain_eq_Q1 :
    (∀ p : Polynomial ℂ,
        Summable (fun q : XiZeroCopy => (p.eval (reciprocalSeamAtom q)) ^ 2) →
        Polynomial.X ∣ p)
      ∧ (∀ Q : Polynomial ℂ,
          Summable (fun q : XiZeroCopy => ((Polynomial.X * Q).eval (reciprocalSeamAtom q)) ^ 2)
          ∧ (∑' q : XiZeroCopy, ((Polynomial.X * Q).eval (reciprocalSeamAtom q)) ^ 2)
              = ∑ i ∈ Finset.range (Q.natDegree + 1), ∑ j ∈ Finset.range (Q.natDegree + 1),
                  (Q.coeff i * Q.coeff j) * reciprocalSeamMoment (i + j + 2)) := by
  refine ⟨fun p hp => admissibleDomain_eq_X_dvd hp, fun Q => ⟨?_, ?_⟩⟩
  · exact (summable_shiftedForm Q).congr (fun q => (unshiftedForm_eq_shiftedForm Q q).symm)
  · rw [tsum_congr (unshiftedForm_eq_shiftedForm Q)]
    exact shiftedForm_eq_moment_sum Q

end RHTower
