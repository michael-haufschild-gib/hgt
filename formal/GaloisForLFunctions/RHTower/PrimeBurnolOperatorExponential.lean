import GaloisForLFunctions.RHTower.PrimeBurnolPositiveMeasureClassification
import GaloisForLFunctions.HTGeometry.DistributionalLinearODE
import Mathlib.Analysis.SpecialFunctions.Exponential

/-! Physical-cone positivity and exact eigenvalues of bounded Burnol operator evolution. -/

noncomputable section
open MeasureTheory Set Filter Topology
open scoped ComplexOrder NNReal
namespace RHTower
open GaloisForLFunctions.HTGeometry _root_.HTGeometry

/-- Norm-continuous evolution generated by a bounded physical operator. -/
def burnolEvolution (A : BurnolHalfLineL2 →L[ℂ] BurnolHalfLineL2) (t : ℝ) :=
  NormedSpace.exp ((t : ℂ) • A)

lemma operator_exp_eigen {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    [CompleteSpace X] (A : X →L[ℂ] X) {v : X} {a : ℂ} (hv : A v = a • v) (z : ℂ) :
    NormedSpace.exp (z • A) v = Complex.exp (z * a) • v := by
  have hp : ∀ k : ℕ, (A^k) v = a^k • v := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        rw [pow_succ, mul_apply_eq_comp, hv, map_smul, ih, smul_smul,
          pow_succ, mul_comm a]
  rw [exp_smul_apply_eq_tsum]
  simp only [hp, smul_smul]
  have he : ∑' k : ℕ, ((k.factorial : ℂ)⁻¹ * z^k) * a^k = Complex.exp (z*a) := by
    rw [Complex.exp_eq_exp_ℂ, NormedSpace.exp_eq_tsum ℂ]
    apply tsum_congr
    intro k
    simp only [smul_eq_mul, mul_pow]
    ring
  have hs : Summable (fun k : ℕ => ((k.factorial : ℂ)⁻¹ * z^k) * a^k) := by
    simpa only [smul_eq_mul, mul_pow, mul_assoc] using
      (NormedSpace.expSeries_summable' (𝕂 := ℂ) (z*a))
  rw [hs.tsum_smul_const v, he]

lemma burnolEvolution_positive {Q : BurnolHalfLineL2 →L[ℂ] BurnolHalfLineL2}
    (hQ : BurnolPreservesNonnegativity Q) {t : ℝ} (ht : 0 ≤ t) :
    BurnolPreservesNonnegativity (burnolEvolution Q t) := by
  intro f hf
  have hT : BurnolPreservesNonnegativity ((t : ℂ) • Q) := by
    intro g hg
    change 0 ≤ (t : ℂ) • Q g
    change 0 ≤ (t : ℝ) • Q g
    exact smul_nonneg ht (hQ g hg)
  have hp : ∀ n : ℕ, 0 ≤ (((t : ℂ) • Q)^n) f := by
    intro n
    induction n with
    | zero => simpa using hf
    | succ n ih =>
        rw [pow_succ', mul_apply_eq_comp]
        exact hT _ ih
  have hs := (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) ((t : ℂ) • Q)).mapL
    (ContinuousLinearMap.apply ℂ BurnolHalfLineL2 f)
  apply hs.nonneg
  intro n
  change 0 ≤ ((n.factorial : ℝ)⁻¹) • ((((t : ℂ) • Q)^n) f)
  exact smul_nonneg (by positivity) (hp n)

lemma burnolEvolution_prime
    (A : BurnolHalfLineL2 →L[ℂ] BurnolHalfLineL2) (a : Nat.Primes → ℂ)
    (ha : ∀ p, A (primeLogCriticalLaplaceFeatureL2 p) = a p • primeLogCriticalLaplaceFeatureL2 p)
    (t : ℝ) (p : Nat.Primes) :
    burnolEvolution A t (primeLogCriticalLaplaceFeatureL2 p) =
      Complex.exp ((t : ℂ) * a p) • primeLogCriticalLaplaceFeatureL2 p :=
  operator_exp_eigen A (ha p) (t : ℂ)

lemma burnolEvolution_symbol
    (A : BurnolHalfLineL2 →L[ℂ] BurnolHalfLineL2) (a : Nat.Primes → ℂ)
    (ha : ∀ p, A (primeLogCriticalLaplaceFeatureL2 p) = a p • primeLogCriticalLaplaceFeatureL2 p)
    (t : ℝ) {z : ℂ} (hz : 0 < z.re) :
    burnolOperatorSymbol (burnolEvolution A t) z =
      Complex.exp ((t : ℂ) * burnolOperatorSymbol A z) := by
  apply smul_left_injective ℂ (burnolComplexFeature_ne_zero hz)
  change burnolOperatorSymbol (burnolEvolution A t) z • burnolComplexFeature z hz =
    Complex.exp ((t : ℂ) * burnolOperatorSymbol A z) • burnolComplexFeature z hz
  rw [← burnolOperatorSymbol_eigen (burnolEvolution A t)
    (fun p => Complex.exp ((t : ℂ) * a p)) (burnolEvolution_prime A a ha t) hz]
  exact operator_exp_eigen A (burnolOperatorSymbol_eigen A a ha hz) (t : ℂ)

end RHTower
