import GaloisForLFunctions.RHTower.XiArakelovHurwitzAlgebraicityCollision
import GaloisForLFunctions.RHTower.XiArakelovKroneckerChamber

/-!
# Relative Arakelov--Hurwitz algebraicity collision

The absolute algebraicity collision is stable after adjoining the Arakelov coordinate.  If
`w(rho) = 1 - rho⁻¹` is algebraic, then the one-coordinate field `Q(w(rho))` is algebraic over
`Q`.  Consequently a Hurwitz character algebraic over `Q(w(rho))` would already be algebraic over
`Q`.  At a nonreal point this contradicts the Gelfond--Schneider law for
`q(rho) = exp(-2*pi*i*rho)`.

Thus an algebraic Arakelov coordinate forces the Hurwitz character to remain transcendental even
over the full field generated by that coordinate.  Globally, integral Arakelov coordinates plus
relative algebraicity of the Hurwitz character at hypothetical right-half Xi zeros imply RH.
Neither input alone is an orientation condition: integrality does not locate the distinguished
complex embedding, while relative algebraicity only couples the two source coordinates.
-/

open Complex Set
open GaloisForLFunctions GaloisForLFunctions.HTGeometry
open HurwitzOrbit

namespace RHTower

noncomputable section

/-- The subfield of `C` generated over `Q` by one Arakelov coordinate. -/
def arakelovCoordinateField (w : ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {w}

/-- Algebraicity descends through the algebraic field generated by one algebraic coordinate. -/
theorem isAlgebraic_of_isAlgebraic_arakelovCoordinateField
    {w q : ℂ} (hw : IsAlgebraic ℚ w)
    (hq : IsAlgebraic (arakelovCoordinateField w) q) :
    IsAlgebraic ℚ q := by
  let K : IntermediateField ℚ ℂ := arakelovCoordinateField w
  letI : Algebra.IsAlgebraic ℚ K := by
    apply IntermediateField.isAlgebraic_adjoin
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact hw.isIntegral
  exact hq.restrictScalars ℚ

/-- Positive relative value law: at a nonreal point, an algebraic Arakelov coordinate makes the
Hurwitz character transcendental even over the complete one-coordinate field `Q(w(rho))`. -/
theorem monoScalar_transcendental_over_arakelovCoordinateField
    {rho : ℂ} (hw : IsAlgebraic ℚ (arakelovW rho)) (him : rho.im ≠ 0) :
    Transcendental (arakelovCoordinateField (arakelovW rho)) (monoScalar rho) := by
  intro hrelative
  have habsolute : IsAlgebraic ℚ (monoScalar rho) :=
    isAlgebraic_of_isAlgebraic_arakelovCoordinateField hw hrelative
  exact monoScalar_transcendental_of_arakelovW_algebraic_of_im_ne_zero hw him habsolute

/-- Source-side mixed constraint: at every hypothetical right-half Xi zero, the Hurwitz character
is algebraic over the field generated by its Arakelov coordinate. -/
def XiRightHurwitzCharacterAlgebraicOverArakelov : Prop :=
  ∀ rho : XiDivisorSupport, 1 / 2 < (rho : ℂ).re →
    IsAlgebraic (arakelovCoordinateField (arakelovW (rho : ℂ)))
      (xiHurwitzMonodromyCharacter rho)

/-- RH discharges relative Hurwitz-character algebraicity by emptying the hypothetical right-half
Xi fibre. -/
theorem xiRightHurwitzCharacterAlgebraicOverArakelov_of_riemannHypothesis
    (hRH : RiemannHypothesis) :
    XiRightHurwitzCharacterAlgebraicOverArakelov := by
  intro rho hrho
  exact False.elim
    ((rh_iff_xi_ne_zero_right.1 hRH (rho : ℂ)
      (mem_rightHalf.2 hrho)) (xi_eq_zero_of_mem_divisor_support rho))

/-- Integral Arakelov coordinates and the mixed relative-algebraicity constraint imply the
absolute Arakelov--Hurwitz algebraicity collision on every hypothetical right-half Xi zero. -/
theorem xiRightArakelovHurwitzAlgebraic_of_integral_of_relativeAlgebraic
    (hint : XiArakelovCoordinatesIntegral)
    (hrelative : XiRightHurwitzCharacterAlgebraicOverArakelov) :
    XiRightArakelovHurwitzAlgebraic := by
  intro rho hrho
  have hzero : xi (rho : ℂ) = 0 := xi_eq_zero_of_mem_divisor_support rho
  have hwIntegral : IsIntegral ℤ (arakelovW (rho : ℂ)) := hint rho hzero
  have hw : IsAlgebraic ℚ (arakelovW (rho : ℂ)) := by
    have hwRat : IsIntegral ℚ (arakelovW (rho : ℂ)) := hwIntegral.tower_top
    exact hwRat.isAlgebraic
  exact ⟨hw, isAlgebraic_of_isAlgebraic_arakelovCoordinateField hw
    (hrelative rho hrho)⟩

/-- **Mixed algebraic-curve criterion for RH.**  If every Xi-zero Arakelov coordinate is integral
and every hypothetical right-half Hurwitz character is algebraic over its corresponding
one-coordinate field, then RH follows. -/
theorem riemannHypothesis_of_xiArakelovCoordinatesIntegral_of_hurwitzCharacterAlgebraicOverArakelov
    (hint : XiArakelovCoordinatesIntegral)
    (hrelative : XiRightHurwitzCharacterAlgebraicOverArakelov) :
    RiemannHypothesis :=
  riemannHypothesis_of_xiRightArakelovHurwitzAlgebraic
    (xiRightArakelovHurwitzAlgebraic_of_integral_of_relativeAlgebraic hint hrelative)

/-- Once integral Arakelov coordinates are supplied, relative Hurwitz algebraicity on hypothetical
right-half Xi zeros is exactly RH: the reverse direction is vacuous because RH empties that
fibre. -/
theorem xiRightHurwitzCharacterAlgebraicOverArakelov_iff_riemannHypothesis_of_integral
    (hint : XiArakelovCoordinatesIntegral) :
    XiRightHurwitzCharacterAlgebraicOverArakelov ↔ RiemannHypothesis := by
  constructor
  · exact
      riemannHypothesis_of_xiArakelovCoordinatesIntegral_of_hurwitzCharacterAlgebraicOverArakelov
        hint
  · exact xiRightHurwitzCharacterAlgebraicOverArakelov_of_riemannHypothesis

end

end RHTower
