import GaloisForLFunctions.RHTower.FieldOneSemilocalBruhatL2Embedding
import Mathlib.Analysis.InnerProductSpace.Completion
import Mathlib.Analysis.Normed.Operator.Extend

/-!
# Hilbert completion of the semilocal Schwartz--Bruhat tensor

The faithful algebraic realization

`𝒮(ℝ) ⊗ C_c^lc(𝔸_f) → L²(ℝ × 𝔸_f)`

pulls the ambient norm and inner product back to the algebraic tensor.  Its
abstract Hilbert completion is then canonically isometrically equivalent to
the closure of the algebraic image in product-Haar `L²`.

The algebraic Weyl automorphisms preserve this induced norm, extend to
unitaries of the completion, and intertwine exactly with the ambient `L²`
Weyl action.  Thus the completed comparison and Weyl compatibility are
unconditional even before proving that the algebraic image is dense in the
whole product `L²`.

No full-`L²` density, finite-adele sigma-finiteness, trace, Hodge positivity,
spectral assertion, or Riemann-hypothesis premise is used.
-/

namespace GaloisForLFunctions.RHTower

noncomputable section

open MeasureTheory

/-- Norm on the algebraic semilocal Schwartz--Bruhat tensor induced by its
faithful product-Haar `L²` realization. -/
noncomputable instance fieldOneSemilocalBruhatNormedAddCommGroup :
    NormedAddCommGroup FieldOneSemilocalBruhatSchwartz :=
  NormedAddCommGroup.induced
    FieldOneSemilocalBruhatSchwartz
    (Lp ℂ 2 fieldOneSemilocalAddHaar)
    fieldOneSemilocalBruhatToL2
    fieldOneSemilocalBruhatToL2_injective

/-- Complex normed-space structure induced from product-Haar `L²`. -/
noncomputable instance fieldOneSemilocalBruhatNormedSpace :
    NormedSpace ℂ FieldOneSemilocalBruhatSchwartz :=
  NormedSpace.induced
    ℂ FieldOneSemilocalBruhatSchwartz
    (Lp ℂ 2 fieldOneSemilocalAddHaar)
    fieldOneSemilocalBruhatToL2

/-- Pre-Hilbert structure induced from product-Haar `L²`. -/
noncomputable instance fieldOneSemilocalBruhatInnerProductSpace :
    InnerProductSpace ℂ FieldOneSemilocalBruhatSchwartz :=
  InnerProductSpace.induced fieldOneSemilocalBruhatToL2

@[simp]
theorem norm_fieldOneSemilocalBruhat_eq_l2
    (t : FieldOneSemilocalBruhatSchwartz) :
    ‖t‖ = ‖fieldOneSemilocalBruhatToL2 t‖ :=
  rfl

@[simp]
theorem inner_fieldOneSemilocalBruhat_eq_l2
    (s t : FieldOneSemilocalBruhatSchwartz) :
    inner ℂ s t =
      inner ℂ
        (fieldOneSemilocalBruhatToL2 s)
        (fieldOneSemilocalBruhatToL2 t) :=
  rfl

/-- The algebraic Bruhat-to-`L²` realization as a linear isometry. -/
def fieldOneSemilocalBruhatToL2LinearIsometry :
    FieldOneSemilocalBruhatSchwartz →ₗᵢ[ℂ]
      Lp ℂ 2 fieldOneSemilocalAddHaar where
  __ := fieldOneSemilocalBruhatToL2
  norm_map' _ := rfl

/-- Hilbert completion of the algebraic semilocal Schwartz--Bruhat tensor
for its canonical product-Haar `L²` norm. -/
abbrev FieldOneSemilocalBruhatHilbertCompletion :=
  UniformSpace.Completion FieldOneSemilocalBruhatSchwartz

/-- Algebraic image of the semilocal Schwartz--Bruhat tensor in product
`L²`. -/
def fieldOneSemilocalBruhatL2Range :
    Submodule ℂ (Lp ℂ 2 fieldOneSemilocalAddHaar) :=
  LinearMap.range fieldOneSemilocalBruhatToL2

/-- Closed product-`L²` subspace generated by the algebraic semilocal
Schwartz--Bruhat image. -/
def fieldOneSemilocalBruhatL2ClosedImage :
    Submodule ℂ (Lp ℂ 2 fieldOneSemilocalAddHaar) :=
  fieldOneSemilocalBruhatL2Range.topologicalClosure

noncomputable instance fieldOneSemilocalBruhatL2ClosedImageCompleteSpace :
    CompleteSpace fieldOneSemilocalBruhatL2ClosedImage :=
  Submodule.topologicalClosure.completeSpace
    fieldOneSemilocalBruhatL2Range

/-- Inclusion of the algebraic image into its closed `L²` span. -/
def fieldOneSemilocalBruhatL2RangeToClosedImage :
    fieldOneSemilocalBruhatL2Range →ₗ[ℂ]
      fieldOneSemilocalBruhatL2ClosedImage :=
  Submodule.inclusion
    fieldOneSemilocalBruhatL2Range.le_topologicalClosure

/-- The algebraic image is dense in its closed `L²` span. -/
theorem fieldOneSemilocalBruhatL2RangeToClosedImage_dense :
    DenseRange fieldOneSemilocalBruhatL2RangeToClosedImage := by
  let hle :
      (fieldOneSemilocalBruhatL2Range :
          Set (Lp ℂ 2 fieldOneSemilocalAddHaar)) ⊆
        (fieldOneSemilocalBruhatL2ClosedImage :
          Set (Lp ℂ 2 fieldOneSemilocalAddHaar)) :=
    fieldOneSemilocalBruhatL2Range.le_topologicalClosure
  have h : DenseRange (Set.inclusion hle) := by
    apply (denseRange_inclusion_iff hle).2
    simpa only [fieldOneSemilocalBruhatL2ClosedImage,
      Submodule.topologicalClosure_coe] using
      (subset_rfl :
        closure
            (fieldOneSemilocalBruhatL2Range :
              Set (Lp ℂ 2 fieldOneSemilocalAddHaar)) ⊆
          closure
            (fieldOneSemilocalBruhatL2Range :
              Set (Lp ℂ 2 fieldOneSemilocalAddHaar)))
  simpa only [fieldOneSemilocalBruhatL2RangeToClosedImage,
    Submodule.inclusion_apply] using h

theorem fieldOneSemilocalBruhatCompletionDenseNorm
    (t : FieldOneSemilocalBruhatSchwartz) :
    ‖fieldOneSemilocalBruhatL2RangeToClosedImage
        (fieldOneSemilocalBruhatToL2LinearIsometry.equivRange.toLinearEquiv
          t)‖ =
      ‖(UniformSpace.Completion.toComplₗᵢ
          (𝕜 := ℂ)
          (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap t‖ := by
  calc
    _ =
        ‖fieldOneSemilocalBruhatToL2LinearIsometry.equivRange
          t‖ := rfl
    _ = ‖t‖ :=
      fieldOneSemilocalBruhatToL2LinearIsometry.equivRange.norm_map t
    _ = _ :=
      ((UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).norm_map t).symm

/-- Canonical isometric equivalence from the abstract Hilbert completion to
the closure of the algebraic image in product-Haar `L²`. -/
def fieldOneSemilocalBruhatCompletionEquivClosedImage :
    FieldOneSemilocalBruhatHilbertCompletion ≃ₗᵢ[ℂ]
      fieldOneSemilocalBruhatL2ClosedImage :=
  fieldOneSemilocalBruhatToL2LinearIsometry.equivRange.toLinearEquiv.extendOfIsometry
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
      fieldOneSemilocalBruhatL2RangeToClosedImage
      UniformSpace.Completion.denseRange_coe
      fieldOneSemilocalBruhatL2RangeToClosedImage_dense
      fieldOneSemilocalBruhatCompletionDenseNorm

@[simp]
theorem fieldOneSemilocalBruhatCompletionEquivClosedImage_coe
    (t : FieldOneSemilocalBruhatSchwartz) :
    ((fieldOneSemilocalBruhatCompletionEquivClosedImage
        (t : FieldOneSemilocalBruhatHilbertCompletion)) :
      Lp ℂ 2 fieldOneSemilocalAddHaar) =
      fieldOneSemilocalBruhatToL2 t := by
  have h :=
    LinearEquiv.extendOfIsometry_eq
      fieldOneSemilocalBruhatToL2LinearIsometry.equivRange.toLinearEquiv
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
      fieldOneSemilocalBruhatL2RangeToClosedImage
      UniformSpace.Completion.denseRange_coe
      fieldOneSemilocalBruhatL2RangeToClosedImage_dense
      fieldOneSemilocalBruhatCompletionDenseNorm
      t
  have h' := congrArg
    (fun z : fieldOneSemilocalBruhatL2ClosedImage =>
      (z : Lp ℂ 2 fieldOneSemilocalAddHaar)) h
  simpa only [fieldOneSemilocalBruhatCompletionEquivClosedImage,
    fieldOneSemilocalBruhatL2RangeToClosedImage,
    Submodule.coe_inclusion,
    fieldOneSemilocalBruhatToL2LinearIsometry,
    fieldOneSemilocalBruhatL2Range] using h'

/-- Canonical faithful realization of the Hilbert completion in product-Haar
`L²`. -/
def fieldOneSemilocalBruhatCompletionToL2 :
    FieldOneSemilocalBruhatHilbertCompletion →ₗᵢ[ℂ]
      Lp ℂ 2 fieldOneSemilocalAddHaar :=
  fieldOneSemilocalBruhatL2ClosedImage.subtypeₗᵢ.comp
    fieldOneSemilocalBruhatCompletionEquivClosedImage.toLinearIsometry

@[simp]
theorem fieldOneSemilocalBruhatCompletionToL2_coe
    (t : FieldOneSemilocalBruhatSchwartz) :
    fieldOneSemilocalBruhatCompletionToL2
        (t : FieldOneSemilocalBruhatHilbertCompletion) =
      fieldOneSemilocalBruhatToL2 t := by
  simp [fieldOneSemilocalBruhatCompletionToL2]

/-- Exact range of the completed realization: the closed algebraic image,
with no assertion that this closed subspace is all of product `L²`. -/
theorem fieldOneSemilocalBruhatCompletionToL2_range :
    LinearMap.range
        fieldOneSemilocalBruhatCompletionToL2.toLinearMap =
      fieldOneSemilocalBruhatL2ClosedImage := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact (fieldOneSemilocalBruhatCompletionEquivClosedImage x).property
  · intro y hy
    let z : fieldOneSemilocalBruhatL2ClosedImage := ⟨y, hy⟩
    refine
      ⟨fieldOneSemilocalBruhatCompletionEquivClosedImage.symm z, ?_⟩
    change
      ((fieldOneSemilocalBruhatCompletionEquivClosedImage
        (fieldOneSemilocalBruhatCompletionEquivClosedImage.symm z)) :
          Lp ℂ 2 fieldOneSemilocalAddHaar) = y
    simp [z]

/-- Algebraic Weyl automorphism as a unitary for the induced pre-Hilbert
norm. -/
def fieldOneSemilocalBruhatWeylUnitary
    (a : ℝ × FieldOneFiniteAdele) :
    FieldOneSemilocalBruhatSchwartz ≃ₗᵢ[ℂ]
      FieldOneSemilocalBruhatSchwartz where
  __ := fieldOneSemilocalBruhatWeylLinearEquiv a
  norm_map' t := by
    change
      ‖fieldOneSemilocalBruhatToL2
          (fieldOneSemilocalBruhatWeylMultiplier a t)‖ =
        ‖fieldOneSemilocalBruhatToL2 t‖
    rw [← fieldOneSemilocalL2WeylUnitary_bruhat]
    exact (fieldOneSemilocalL2WeylUnitary a).norm_map
      (fieldOneSemilocalBruhatToL2 t)

theorem fieldOneSemilocalBruhatCompletionWeylDenseNorm
    (a : ℝ × FieldOneFiniteAdele)
    (t : FieldOneSemilocalBruhatSchwartz) :
    ‖(UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
        ((fieldOneSemilocalBruhatWeylUnitary a).toLinearEquiv t)‖ =
      ‖(UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap t‖ := by
  calc
    _ = ‖fieldOneSemilocalBruhatWeylUnitary a t‖ :=
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).norm_map _
    _ = ‖t‖ := (fieldOneSemilocalBruhatWeylUnitary a).norm_map t
    _ = _ :=
      ((UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).norm_map t).symm

/-- Weyl unitary extended to the Hilbert completion. -/
def fieldOneSemilocalBruhatCompletionWeylUnitary
    (a : ℝ × FieldOneFiniteAdele) :
    FieldOneSemilocalBruhatHilbertCompletion ≃ₗᵢ[ℂ]
      FieldOneSemilocalBruhatHilbertCompletion :=
  (fieldOneSemilocalBruhatWeylUnitary a).toLinearEquiv.extendOfIsometry
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
      (UniformSpace.Completion.toComplₗᵢ
        (𝕜 := ℂ)
        (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
      UniformSpace.Completion.denseRange_coe
      UniformSpace.Completion.denseRange_coe
      (fieldOneSemilocalBruhatCompletionWeylDenseNorm a)

@[simp]
theorem fieldOneSemilocalBruhatCompletionWeylUnitary_coe
    (a : ℝ × FieldOneFiniteAdele)
    (t : FieldOneSemilocalBruhatSchwartz) :
    fieldOneSemilocalBruhatCompletionWeylUnitary a
        (t : FieldOneSemilocalBruhatHilbertCompletion) =
      (fieldOneSemilocalBruhatWeylMultiplier a t :
        FieldOneSemilocalBruhatHilbertCompletion) := by
  exact LinearEquiv.extendOfIsometry_eq
    (fieldOneSemilocalBruhatWeylUnitary a).toLinearEquiv
    (UniformSpace.Completion.toComplₗᵢ
      (𝕜 := ℂ)
      (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
    (UniformSpace.Completion.toComplₗᵢ
      (𝕜 := ℂ)
      (E := FieldOneSemilocalBruhatSchwartz)).toLinearMap
    UniformSpace.Completion.denseRange_coe
    UniformSpace.Completion.denseRange_coe
    (fieldOneSemilocalBruhatCompletionWeylDenseNorm a)
    t

/-- Exact completed intertwining with the ambient product-Haar `L²` Weyl
unitary. -/
theorem fieldOneSemilocalBruhatCompletionToL2_weyl
    (a : ℝ × FieldOneFiniteAdele)
    (x : FieldOneSemilocalBruhatHilbertCompletion) :
    fieldOneSemilocalL2WeylUnitary a
        (fieldOneSemilocalBruhatCompletionToL2 x) =
      fieldOneSemilocalBruhatCompletionToL2
        (fieldOneSemilocalBruhatCompletionWeylUnitary a x) := by
  induction x using UniformSpace.Completion.induction_on with
  | hp =>
      exact isClosed_eq
        ((fieldOneSemilocalL2WeylUnitary a).continuous.comp
          fieldOneSemilocalBruhatCompletionToL2.continuous)
        (fieldOneSemilocalBruhatCompletionToL2.continuous.comp
          (fieldOneSemilocalBruhatCompletionWeylUnitary a).continuous)
  | ih t =>
      simp only [fieldOneSemilocalBruhatCompletionToL2_coe,
        fieldOneSemilocalBruhatCompletionWeylUnitary_coe]
      exact fieldOneSemilocalL2WeylUnitary_bruhat a t

/-- Addition in the semilocal parameter group remains composition after
Hilbert completion. -/
theorem fieldOneSemilocalBruhatCompletionWeylUnitary_add_apply
    (a b : ℝ × FieldOneFiniteAdele)
    (x : FieldOneSemilocalBruhatHilbertCompletion) :
    fieldOneSemilocalBruhatCompletionWeylUnitary a
        (fieldOneSemilocalBruhatCompletionWeylUnitary b x) =
      fieldOneSemilocalBruhatCompletionWeylUnitary (a + b) x := by
  apply fieldOneSemilocalBruhatCompletionToL2.injective
  rw [← fieldOneSemilocalBruhatCompletionToL2_weyl,
    ← fieldOneSemilocalBruhatCompletionToL2_weyl,
    ← fieldOneSemilocalBruhatCompletionToL2_weyl,
    fieldOneSemilocalL2WeylUnitary_add_apply]

end

end GaloisForLFunctions.RHTower
