import GaloisForLFunctions.RHTower.DeningerMeyerSeminorm

/-!
# The nuclear Meyer topology of the exponentially decreasing source

As a set the source is a subspace of the Schwartz space, but its own topology is *not* the subspace
topology: it is the projective limit of the exponentially weighted Schwartz topologies, generated by
the seminorms `q_{A,n}`.  A type synonym carries that topology, so both structures stay available
and neither instance shadows the other.

* `DeningerMeyerSource` : the source with its Meyer topology.
* `DeningerMeyerSource.withSeminorms` : **the topology is the one generated by `q_{A,n}`.**
-/

namespace RHTower

open SchwartzMap

/-- **Meyer's cochain space `H_-`**, carrying its own nuclear Fréchet topology rather than the
subspace topology of the Schwartz space. -/
def DeningerMeyerSource : Type := ↥DeningerExpSchwartz

namespace DeningerMeyerSource

noncomputable instance : AddCommGroup DeningerMeyerSource :=
  inferInstanceAs (AddCommGroup ↥DeningerExpSchwartz)

noncomputable instance : Module ℂ DeningerMeyerSource :=
  inferInstanceAs (Module ℂ ↥DeningerExpSchwartz)

/-- The identification of the Meyer source with the underlying submodule. -/
noncomputable def toSource : DeningerMeyerSource ≃ₗ[ℂ] ↥DeningerExpSchwartz :=
  LinearEquiv.refl ℂ _

/-- The Meyer seminorm family, indexed by the exponent and the derivative order. -/
noncomputable def seminorms : SeminormFamily ℂ DeningerMeyerSource (ℕ × ℕ) :=
  fun m => (deningerMeyerSeminorm (m.1 : ℝ) m.2).comp toSource.toLinearMap

noncomputable instance : TopologicalSpace DeningerMeyerSource :=
  seminorms.moduleFilterBasis.topology'

/-- **The Meyer topology is generated by the seminorms `q_{A,n}`.** -/
theorem withSeminorms : WithSeminorms (seminorms) := ⟨rfl⟩

@[simp]
theorem seminorms_apply (m : ℕ × ℕ) (h : DeningerMeyerSource) :
    seminorms m h = deningerMeyerSeminormFun (m.1 : ℝ) m.2 (toSource h) := rfl

instance : IsTopologicalAddGroup DeningerMeyerSource :=
  seminorms.addGroupFilterBasis.isTopologicalAddGroup

instance : ContinuousSMul ℂ DeningerMeyerSource := by
  rw [withSeminorms.withSeminorms_eq]
  exact seminorms.moduleFilterBasis.continuousSMul

end DeningerMeyerSource

end RHTower
