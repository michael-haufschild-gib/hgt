import GaloisForLFunctions.RHTower.AnharmonicChebyshevOrientationCasimir
import GaloisForLFunctions.RHTower.RiemannXiRealAxisNonvanishing
import GaloisForLFunctions.RHTower.XiLogDerivSymmetry

/-!
# Anharmonic moving fibers and invariant-coordinate Xi orientation

Rouyea--Bourgeois (2026), Proposition 6.9 and Remark 6.10, show that Möbius recentering improves
the high-zero Green scale from `|η|/γ²` to `|η|/γ`, while leaving the class generated by finitely
many original fixed-point moments.  This module sharpens the information statement algebraically:
recentring loses *fixed* three-point locality, but a scan center still corresponds to a finite moving
anharmonic fiber.

The quotient fiber is classified exactly as two reflected cyclic triples.  On the real sheet beyond
`2`, the cyclic triple lies respectively in `(2,∞)`, `(1/2,1)`, and `(-1,0)`, and an explicit scan
center in `(0,1)` maps to its squared quotient value under the Koebe map.

The new orientation channel uses `q`-coordinate logarithmic derivatives
`(xi'/xi)(s) / q'(s)`.  Their sum is the descended trivial sector; their Hermitian variance is a
nonnegative full-`S₃` invariant which vanishes exactly when all three moving-fiber components
coincide.  This identifies the coordinate-correct doubled standard sector discarded by scalar
`q²` descent.  No arithmetic bound for this energy, and no implication toward RH, is asserted.
-/

open Complex Real

namespace RHTower

noncomputable section

def chebyshevAnharmonicWTwo (s : ℂ) : ℂ := 1 / (1 - s)

theorem hasDerivAt_chebyshevAnharmonicW {s : ℂ} (hs0 : s ≠ 0) :
    HasDerivAt chebyshevAnharmonicW (1 / s ^ 2) s := by
  have hnum : HasDerivAt (fun z : ℂ => z - 1) 1 s := (hasDerivAt_id s).sub_const 1
  have hden : HasDerivAt (fun z : ℂ => z) 1 s := hasDerivAt_id s
  have h : HasDerivAt (fun z : ℂ => (z - 1) / z)
      ((1 * s - (s - 1) * 1) / s ^ 2) s := hnum.div hden hs0
  have heq : (1 * s - (s - 1) * 1) / s ^ 2 = 1 / s ^ 2 := by ring
  rw [heq] at h
  change HasDerivAt (fun z : ℂ => (z - 1) / z) (1 / s ^ 2) s
  exact h

theorem hasDerivAt_chebyshevAnharmonicWTwo {s : ℂ} (hs1 : s ≠ 1) :
    HasDerivAt chebyshevAnharmonicWTwo (1 / (1 - s) ^ 2) s := by
  have hden : (1 : ℂ) - s ≠ 0 := sub_ne_zero.mpr (Ne.symm hs1)
  have hnum : HasDerivAt (fun _ : ℂ => (1 : ℂ)) 0 s :=
    hasDerivAt_const (x := s) (c := (1 : ℂ))
  have hden' : HasDerivAt (fun z : ℂ => 1 - z) (-1) s :=
    HasDerivAt.const_sub (1 : ℂ) (hasDerivAt_id s)
  have h : HasDerivAt (fun z : ℂ => 1 / (1 - z))
      ((0 * (1 - s) - 1 * (-1)) / (1 - s) ^ 2) s := hnum.div hden' hden
  have heq : (0 * (1 - s) - 1 * (-1)) / (1 - s) ^ 2 =
      1 / (1 - s) ^ 2 := by ring
  rw [heq] at h
  change HasDerivAt (fun z : ℂ => 1 / (1 - z)) (1 / (1 - s) ^ 2) s
  exact h

/-- Product of completed Xi over one oriented cyclic anharmonic fiber. -/
def chebyshevXiCyclicOrbitProduct (s : ℂ) : ℂ :=
  xi s * xi (chebyshevAnharmonicW s) * xi (chebyshevAnharmonicWTwo s)

/-- Jacobian of the invariant quotient coordinate. -/
def chebyshevAnharmonicQPrime (s : ℂ) : ℂ :=
  1 + 1 / s ^ 2 + 1 / (s - 1) ^ 2

theorem chebyshevAnharmonicQPrime_w
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevAnharmonicQPrime (chebyshevAnharmonicW s) * (1 / s ^ 2) =
      chebyshevAnharmonicQPrime s := by
  simp only [chebyshevAnharmonicQPrime, chebyshevAnharmonicW]
  field_simp [hs0, hs1]
  ring

theorem chebyshevAnharmonicQPrime_wTwo
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevAnharmonicQPrime (chebyshevAnharmonicWTwo s) * (1 / (1 - s) ^ 2) =
      chebyshevAnharmonicQPrime s := by
  simp only [chebyshevAnharmonicQPrime, chebyshevAnharmonicWTwo]
  field_simp [hs0, hs1]
  ring

theorem chebyshevAnharmonicQPrime_sigma (s : ℂ) :
    chebyshevAnharmonicQPrime (chebyshevAnharmonicSigma s) =
      chebyshevAnharmonicQPrime s := by
  have hleft : (1 - s) ^ 2 = (s - 1) ^ 2 := by ring
  have hright : (1 - s - 1) ^ 2 = s ^ 2 := by ring
  simp only [chebyshevAnharmonicQPrime, chebyshevAnharmonicSigma, hleft, hright]
  ring

/-- Xi logarithmic derivative measured in the invariant `q`-coordinate. -/
def chebyshevXiQLogDeriv (s : ℂ) : ℂ :=
  logDeriv xi s / chebyshevAnharmonicQPrime s

/-- Hermitian energy of the standard sector over one cyclic `q`-fiber. -/
def chebyshevXiQOrientationEnergy (s : ℂ) : ℝ :=
  anharmonicOrbitHermitianEnergy
    (chebyshevXiQLogDeriv s)
    (chebyshevXiQLogDeriv (chebyshevAnharmonicW s))
    (chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s))

theorem chebyshevAnharmonicW_w
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevAnharmonicW (chebyshevAnharmonicW s) = chebyshevAnharmonicWTwo s := by
  simp only [chebyshevAnharmonicW, chebyshevAnharmonicWTwo]
  field_simp [hs0, hs1]
  ring

theorem chebyshevAnharmonicWTwo_w
    {s : ℂ} (hs0 : s ≠ 0) :
    chebyshevAnharmonicWTwo (chebyshevAnharmonicW s) = s := by
  simp only [chebyshevAnharmonicW, chebyshevAnharmonicWTwo]
  field_simp [hs0]
  ring

theorem chebyshevXiQOrientationEnergy_cyclic
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevXiQOrientationEnergy (chebyshevAnharmonicW s) =
      chebyshevXiQOrientationEnergy s := by
  simp only [chebyshevXiQOrientationEnergy,
    chebyshevAnharmonicW_w hs0 hs1, chebyshevAnharmonicWTwo_w hs0]
  exact anharmonicOrbitHermitianEnergy_cyclic _ _ _

theorem chebyshevXiQLogDeriv_sigma (s : ℂ) :
    chebyshevXiQLogDeriv (chebyshevAnharmonicSigma s) = -chebyshevXiQLogDeriv s := by
  simp only [chebyshevXiQLogDeriv]
  rw [show logDeriv xi (chebyshevAnharmonicSigma s) = -logDeriv xi s by
    exact logDeriv_xi_one_sub s]
  rw [chebyshevAnharmonicQPrime_sigma]
  ring

theorem chebyshevAnharmonicW_sigma {s : ℂ} (hs1 : s ≠ 1) :
    chebyshevAnharmonicW (chebyshevAnharmonicSigma s) =
      chebyshevAnharmonicSigma (chebyshevAnharmonicWTwo s) := by
  simp only [chebyshevAnharmonicW, chebyshevAnharmonicWTwo,
    chebyshevAnharmonicSigma]
  field_simp [hs1]

theorem chebyshevAnharmonicWTwo_sigma {s : ℂ} (hs0 : s ≠ 0) :
    chebyshevAnharmonicWTwo (chebyshevAnharmonicSigma s) =
      chebyshevAnharmonicSigma (chebyshevAnharmonicW s) := by
  simp only [chebyshevAnharmonicW, chebyshevAnharmonicWTwo,
    chebyshevAnharmonicSigma]
  field_simp [hs0]
  ring

theorem chebyshevXiQOrientationEnergy_reflection
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevXiQOrientationEnergy (chebyshevAnharmonicSigma s) =
      chebyshevXiQOrientationEnergy s := by
  simp only [chebyshevXiQOrientationEnergy, chebyshevAnharmonicW_sigma hs1,
    chebyshevAnharmonicWTwo_sigma hs0, chebyshevXiQLogDeriv_sigma]
  rw [anharmonicOrbitHermitianEnergy_reflection]
  simp only [anharmonicOrbitHermitianEnergy, neg_sub_neg]
  have h₁ : ‖chebyshevXiQLogDeriv (chebyshevAnharmonicW s) -
      chebyshevXiQLogDeriv s‖ = ‖chebyshevXiQLogDeriv s -
      chebyshevXiQLogDeriv (chebyshevAnharmonicW s)‖ := norm_sub_rev _ _
  have h₂ : ‖chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s) -
      chebyshevXiQLogDeriv (chebyshevAnharmonicW s)‖ =
      ‖chebyshevXiQLogDeriv (chebyshevAnharmonicW s) -
        chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s)‖ := norm_sub_rev _ _
  have h₃ : ‖chebyshevXiQLogDeriv s -
      chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s)‖ =
      ‖chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s) -
        chebyshevXiQLogDeriv s‖ := norm_sub_rev _ _
  rw [h₁, h₂, h₃]

theorem chebyshevXiQOrientationEnergy_nonneg (s : ℂ) :
    0 ≤ chebyshevXiQOrientationEnergy s :=
  anharmonicOrbitHermitianEnergy_nonneg _ _ _

theorem chebyshevXiQOrientationEnergy_eq_zero_iff (s : ℂ) :
    chebyshevXiQOrientationEnergy s = 0 ↔
      chebyshevXiQLogDeriv s =
          chebyshevXiQLogDeriv (chebyshevAnharmonicW s) ∧
        chebyshevXiQLogDeriv (chebyshevAnharmonicW s) =
          chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo s) :=
  anharmonicOrbitHermitianEnergy_eq_zero_iff _ _ _

/-- Exact moving-three-point logarithmic current.  For a real anchor beyond `2`, every factor is
nonzero and the current uses Xi data only at the three real cyclic-orbit points. -/
theorem logDeriv_chebyshevXiCyclicOrbitProduct_of_two_lt {s : ℝ} (hs : 2 < s) :
    logDeriv chebyshevXiCyclicOrbitProduct (s : ℂ) =
      logDeriv xi (s : ℂ) +
        logDeriv xi (chebyshevAnharmonicW (s : ℂ)) / (s : ℂ) ^ 2 +
        logDeriv xi (chebyshevAnharmonicWTwo (s : ℂ)) / (1 - (s : ℂ)) ^ 2 := by
  have hs0R : s ≠ 0 := by linarith
  have hs1R : s ≠ 1 := by linarith
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast hs0R
  have hs1 : (s : ℂ) ≠ 1 := by exact_mod_cast hs1R
  have hxi0 : xi (s : ℂ) ≠ 0 := xi_ne_zero_of_ofReal s
  have hxi1 : xi (chebyshevAnharmonicW (s : ℂ)) ≠ 0 := by
    simpa only [chebyshevAnharmonicW, ofReal_div, ofReal_sub, ofReal_one] using
      xi_ne_zero_of_ofReal ((s - 1) / s)
  have hxi2 : xi (chebyshevAnharmonicWTwo (s : ℂ)) ≠ 0 := by
    simpa only [chebyshevAnharmonicWTwo, div_eq_mul_inv, one_mul, ofReal_inv,
      ofReal_sub, ofReal_one] using xi_ne_zero_of_ofReal (1 / (1 - s))
  have hw := hasDerivAt_chebyshevAnharmonicW hs0
  have hw2 := hasDerivAt_chebyshevAnharmonicWTwo hs1
  have hxic : DifferentiableAt ℂ xi (s : ℂ) := xi_differentiable.differentiableAt
  have hxicw : DifferentiableAt ℂ (fun z => xi (chebyshevAnharmonicW z)) (s : ℂ) :=
    xi_differentiable.differentiableAt.comp (s : ℂ) hw.differentiableAt
  have hxicw2 : DifferentiableAt ℂ (fun z => xi (chebyshevAnharmonicWTwo z)) (s : ℂ) :=
    xi_differentiable.differentiableAt.comp (s : ℂ) hw2.differentiableAt
  rw [show chebyshevXiCyclicOrbitProduct = fun z =>
      (xi z * xi (chebyshevAnharmonicW z)) * xi (chebyshevAnharmonicWTwo z) from rfl]
  have houter := logDeriv_mul (x := (s : ℂ))
    (f := fun z => xi z * xi (chebyshevAnharmonicW z))
    (g := fun z => xi (chebyshevAnharmonicWTwo z))
    (mul_ne_zero hxi0 hxi1) hxi2 (hxic.mul hxicw) hxicw2
  rw [houter]
  have hinner := logDeriv_mul (x := (s : ℂ))
    (f := xi) (g := fun z => xi (chebyshevAnharmonicW z))
    hxi0 hxi1 hxic hxicw
  rw [hinner]
  have hcomp1 := logDeriv_comp xi_differentiable.differentiableAt hw.differentiableAt
  have hcomp2 := logDeriv_comp xi_differentiable.differentiableAt hw2.differentiableAt
  change logDeriv (fun z => xi (chebyshevAnharmonicW z)) (s : ℂ) =
      logDeriv xi (chebyshevAnharmonicW (s : ℂ)) *
        deriv chebyshevAnharmonicW (s : ℂ) at hcomp1
  change logDeriv (fun z => xi (chebyshevAnharmonicWTwo z)) (s : ℂ) =
      logDeriv xi (chebyshevAnharmonicWTwo (s : ℂ)) *
        deriv chebyshevAnharmonicWTwo (s : ℂ) at hcomp2
  rw [hw.deriv] at hcomp1
  rw [hw2.deriv] at hcomp2
  rw [hcomp1, hcomp2]
  simp only [div_eq_mul_inv, one_mul]

def chebyshevAnharmonicQPrimeReal (s : ℝ) : ℝ :=
  1 + 1 / s ^ 2 + 1 / (s - 1) ^ 2

theorem chebyshevAnharmonicQPrime_ofReal (s : ℝ) :
    chebyshevAnharmonicQPrime (s : ℂ) = (chebyshevAnharmonicQPrimeReal s : ℂ) := by
  simp only [chebyshevAnharmonicQPrime, chebyshevAnharmonicQPrimeReal]
  norm_cast

theorem chebyshevAnharmonicQPrimeReal_pos (s : ℝ) :
    0 < chebyshevAnharmonicQPrimeReal s := by
  simp only [chebyshevAnharmonicQPrimeReal]
  have h₁ : 0 ≤ 1 / s ^ 2 := by positivity
  have h₂ : 0 ≤ 1 / (s - 1) ^ 2 := by positivity
  linarith

theorem chebyshevAnharmonicQPrime_ofReal_ne_zero (s : ℝ) :
    chebyshevAnharmonicQPrime (s : ℂ) ≠ 0 := by
  rw [chebyshevAnharmonicQPrime_ofReal]
  exact_mod_cast ne_of_gt (chebyshevAnharmonicQPrimeReal_pos s)

/-- The descended trivial sector is exactly the sum of the three invariant-coordinate Xi
logarithmic derivatives.  This is the moving-fiber locality identity hidden by fixed-point moments. -/
theorem logDeriv_chebyshevXiCyclicOrbitProduct_div_qPrime_of_two_lt
    {s : ℝ} (hs : 2 < s) :
    logDeriv chebyshevXiCyclicOrbitProduct (s : ℂ) /
        chebyshevAnharmonicQPrime (s : ℂ) =
      chebyshevXiQLogDeriv (s : ℂ) +
        chebyshevXiQLogDeriv (chebyshevAnharmonicW (s : ℂ)) +
        chebyshevXiQLogDeriv (chebyshevAnharmonicWTwo (s : ℂ)) := by
  have hs0R : s ≠ 0 := by linarith
  have hs1R : s ≠ 1 := by linarith
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast hs0R
  have hs1 : (s : ℂ) ≠ 1 := by exact_mod_cast hs1R
  have hq0 := chebyshevAnharmonicQPrime_ofReal_ne_zero s
  rw [logDeriv_chebyshevXiCyclicOrbitProduct_of_two_lt hs]
  simp only [chebyshevXiQLogDeriv]
  have hw := chebyshevAnharmonicQPrime_w hs0 hs1
  have hw2 := chebyshevAnharmonicQPrime_wTwo hs0 hs1
  field_simp [hs0, sub_ne_zero.mpr (Ne.symm hs1)] at hw hw2
  rw [hw, hw2]
  field_simp [hq0, hs0, sub_ne_zero.mpr (Ne.symm hs1)]

def chebyshevAnharmonicFiberPolynomial (Q z : ℂ) : ℂ :=
  2 * z ^ 3 - (3 + 2 * Q) * z ^ 2 + (-3 + 2 * Q) * z + 2

theorem chebyshevAnharmonicFiberPolynomial_eq_zero_iff
    {Q s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevAnharmonicFiberPolynomial Q s = 0 ↔ chebyshevAnharmonicQ s = Q := by
  simp only [chebyshevAnharmonicFiberPolynomial, chebyshevAnharmonicQ]
  field_simp [hs0, hs1]
  constructor <;> intro h
  · linear_combination h
  · linear_combination h

theorem chebyshevAnharmonicFiberPolynomial_factorization
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) (z : ℂ) :
    chebyshevAnharmonicFiberPolynomial (chebyshevAnharmonicQ s) z =
      2 * (z - s) * (z - chebyshevAnharmonicW s) *
        (z - chebyshevAnharmonicWTwo s) := by
  simp only [chebyshevAnharmonicFiberPolynomial, chebyshevAnharmonicQ,
    chebyshevAnharmonicW, chebyshevAnharmonicWTwo]
  field_simp [hs0, hs1]
  ring

theorem chebyshevAnharmonicQ_wTwo
    {s : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) :
    chebyshevAnharmonicQ (chebyshevAnharmonicWTwo s) = chebyshevAnharmonicQ s := by
  simp only [chebyshevAnharmonicQ, chebyshevAnharmonicWTwo]
  field_simp [hs0, hs1]
  ring

theorem chebyshevAnharmonicQ_fiber_iff
    {s z : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) (hz0 : z ≠ 0) (hz1 : z ≠ 1) :
    chebyshevAnharmonicQ z = chebyshevAnharmonicQ s ↔
      z = s ∨ z = chebyshevAnharmonicW s ∨ z = chebyshevAnharmonicWTwo s := by
  constructor
  · intro hq
    have hp : chebyshevAnharmonicFiberPolynomial (chebyshevAnharmonicQ s) z = 0 :=
      (chebyshevAnharmonicFiberPolynomial_eq_zero_iff hz0 hz1).2 hq
    rw [chebyshevAnharmonicFiberPolynomial_factorization hs0 hs1] at hp
    rcases mul_eq_zero.mp hp with hp | hp
    · rcases mul_eq_zero.mp hp with hp | hp
      · rcases mul_eq_zero.mp hp with hp | hp
        · norm_num at hp
        · exact Or.inl (sub_eq_zero.mp hp)
      · exact Or.inr (Or.inl (sub_eq_zero.mp hp))
    · exact Or.inr (Or.inr (sub_eq_zero.mp hp))
  · rintro (rfl | rfl | rfl)
    · rfl
    · exact chebyshevAnharmonicQ_w hs0 hs1
    · exact chebyshevAnharmonicQ_wTwo hs0 hs1

/-- Squaring the quotient glues the cyclic fiber to its reflected cyclic fiber. -/
theorem chebyshevAnharmonicQ_sq_fiber_iff
    {s z : ℂ} (hs0 : s ≠ 0) (hs1 : s ≠ 1) (hz0 : z ≠ 0) (hz1 : z ≠ 1) :
    chebyshevAnharmonicQ z ^ 2 = chebyshevAnharmonicQ s ^ 2 ↔
      z = s ∨ z = chebyshevAnharmonicW s ∨ z = chebyshevAnharmonicWTwo s ∨
      z = chebyshevAnharmonicSigma s ∨
      z = chebyshevAnharmonicW (chebyshevAnharmonicSigma s) ∨
      z = chebyshevAnharmonicWTwo (chebyshevAnharmonicSigma s) := by
  have hsigma0 : chebyshevAnharmonicSigma s ≠ 0 := by
    simp only [chebyshevAnharmonicSigma]
    intro h
    apply hs1
    linear_combination -h
  have hsigma1 : chebyshevAnharmonicSigma s ≠ 1 := by
    simp only [chebyshevAnharmonicSigma]
    intro h
    apply hs0
    linear_combination -h
  have hsigQ := chebyshevAnharmonicQ_sigma hs0 hs1
  constructor
  · intro hsq
    have hprod :
        (chebyshevAnharmonicQ z - chebyshevAnharmonicQ s) *
          (chebyshevAnharmonicQ z + chebyshevAnharmonicQ s) = 0 := by
      calc
        _ = chebyshevAnharmonicQ z ^ 2 - chebyshevAnharmonicQ s ^ 2 := by ring
        _ = 0 := sub_eq_zero.mpr hsq
    rcases mul_eq_zero.mp hprod with heq | heq
    · rcases (chebyshevAnharmonicQ_fiber_iff hs0 hs1 hz0 hz1).mp
          (sub_eq_zero.mp heq) with h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
    · have hzsig : chebyshevAnharmonicQ z =
          chebyshevAnharmonicQ (chebyshevAnharmonicSigma s) := by
        rw [hsigQ]
        linear_combination heq
      rcases (chebyshevAnharmonicQ_fiber_iff hsigma0 hsigma1 hz0 hz1).mp hzsig with
        h | h | h
      · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))
  · rintro (rfl | rfl | rfl | rfl | rfl | rfl)
    · rfl
    · rw [chebyshevAnharmonicQ_w hs0 hs1]
    · rw [chebyshevAnharmonicQ_wTwo hs0 hs1]
    · rw [hsigQ]
      ring
    · rw [chebyshevAnharmonicQ_w hsigma0 hsigma1, hsigQ]
      ring
    · rw [chebyshevAnharmonicQ_wTwo hsigma0 hsigma1, hsigQ]
      ring

def chebyshevAnharmonicQReal (s : ℝ) : ℝ :=
  ((s - 2) * (s + 1) * (2 * s - 1)) / (2 * s * (s - 1))

theorem chebyshevAnharmonicQ_ofReal (s : ℝ) :
    chebyshevAnharmonicQ (s : ℂ) = (chebyshevAnharmonicQReal s : ℂ) := by
  simp only [chebyshevAnharmonicQ, chebyshevAnharmonicQReal]
  norm_cast

theorem chebyshevAnharmonicQReal_pos {s : ℝ} (hs : 2 < s) :
    0 < chebyshevAnharmonicQReal s := by
  simp only [chebyshevAnharmonicQReal]
  have hs0 : 0 < s := by linarith
  have hs1 : 0 < s - 1 := by linarith
  have hs2 : 0 < s - 2 := by linarith
  have hs3 : 0 < s + 1 := by linarith
  have hs4 : 0 < 2 * s - 1 := by linarith
  exact div_pos (mul_pos (mul_pos hs2 hs3) hs4) (mul_pos (mul_pos (by norm_num) hs0) hs1)

theorem chebyshevAnharmonic_realOrbit_ranges {s : ℝ} (hs : 2 < s) :
    (1 / 2 : ℝ) < (s - 1) / s ∧ (s - 1) / s < 1 ∧
      -1 < 1 / (1 - s) ∧ 1 / (1 - s) < 0 := by
  have hs0 : 0 < s := by linarith
  have hs10 : 0 < s - 1 := by linarith
  constructor
  · apply (lt_div_iff₀ hs0).2
    nlinarith
  constructor
  · rw [div_lt_iff₀ hs0]
    linarith
  · rw [show 1 / (1 - s) = -1 / (s - 1) by
      have hleft : 1 - s ≠ 0 := by linarith
      have hright : s - 1 ≠ 0 := ne_of_gt hs10
      field_simp [hleft, hright]
      ring]
    constructor
    · rw [neg_div, neg_lt_neg_iff, div_lt_one hs10]
      linarith
    · exact div_neg_of_neg_of_pos (by norm_num) hs10

def chebyshevTraceRealScanCenter (Q : ℝ) : ℝ :=
  (Real.sqrt (4 * Q ^ 2 + 27) - Real.sqrt 27) /
    (Real.sqrt (4 * Q ^ 2 + 27) + Real.sqrt 27)

theorem chebyshevTraceRealScanCenter_mem_unitInterval {Q : ℝ} (hQ : 0 < Q) :
    0 < chebyshevTraceRealScanCenter Q ∧ chebyshevTraceRealScanCenter Q < 1 := by
  let r := Real.sqrt (4 * Q ^ 2 + 27)
  let d := Real.sqrt 27
  have hd : 0 < d := by dsimp [d]; positivity
  have hr0 : 0 ≤ r := Real.sqrt_nonneg _
  have hdsq : d ^ 2 = 27 := by
    dsimp [d]
    rw [sq_sqrt]
    norm_num
  have hrsq : r ^ 2 = 4 * Q ^ 2 + 27 := by
    dsimp [r]
    rw [sq_sqrt]
    positivity
  have hdr : d < r := by
    nlinarith [sq_pos_of_pos hQ]
  have hden : 0 < r + d := by positivity
  change 0 < (r - d) / (r + d) ∧ (r - d) / (r + d) < 1
  constructor
  · exact div_pos (sub_pos.mpr hdr) hden
  · rw [div_lt_one hden]
    linarith

theorem chebyshevTraceRealScanCenter_koebe {Q : ℝ} (hQ : 0 < Q) :
    27 * chebyshevTraceRealScanCenter Q /
        (1 - chebyshevTraceRealScanCenter Q) ^ 2 = Q ^ 2 := by
  let r := Real.sqrt (4 * Q ^ 2 + 27)
  let d := Real.sqrt 27
  have hd : 0 < d := by dsimp [d]; positivity
  have hdsq : d ^ 2 = 27 := by
    dsimp [d]
    rw [sq_sqrt]
    norm_num
  have hrsq : r ^ 2 = 4 * Q ^ 2 + 27 := by
    dsimp [r]
    rw [sq_sqrt]
    positivity
  have hdenpos : 0 < r + d := by positivity
  have hden : r + d ≠ 0 := ne_of_gt hdenpos
  have honeq : 1 - (r - d) / (r + d) = 2 * d / (r + d) := by
    field_simp [hden]
    ring
  change 27 * ((r - d) / (r + d)) /
      (1 - (r - d) / (r + d)) ^ 2 = Q ^ 2
  rw [honeq]
  field_simp [hden, ne_of_gt hd]
  nlinarith

def chebyshevAnharmonicMovingScanCenter (s : ℝ) : ℝ :=
  chebyshevTraceRealScanCenter (chebyshevAnharmonicQReal s)

theorem chebyshevAnharmonic_movingScanCenter_geometry {s : ℝ} (hs : 2 < s) :
    0 < chebyshevAnharmonicMovingScanCenter s ∧
      chebyshevAnharmonicMovingScanCenter s < 1 ∧
      chebyshevTraceKoebeMap (chebyshevAnharmonicMovingScanCenter s : ℂ) =
        chebyshevAnharmonicQ (s : ℂ) ^ 2 := by
  have hQ := chebyshevAnharmonicQReal_pos hs
  obtain ⟨ha0, ha1⟩ := chebyshevTraceRealScanCenter_mem_unitInterval hQ
  refine ⟨ha0, ha1, ?_⟩
  rw [chebyshevAnharmonicQ_ofReal]
  simp only [chebyshevTraceKoebeMap]
  norm_cast
  exact chebyshevTraceRealScanCenter_koebe hQ

end

