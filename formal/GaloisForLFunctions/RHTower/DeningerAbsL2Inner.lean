import GaloisForLFunctions.RHTower.DeningerL2InnerBaseChange
import GaloisForLFunctions.RHTower.DeningerAbsoluteHeightSeminorm

/-!
# The absolute `L²` inner product on the algebraic numbers

The `L²` inner product divided by the degree of the field in which it is computed is preserved by
every field embedding, so it defines an absolute inner product on any algebraic extension of `ℚ`:
compute it in the field generated by the two elements.

* `deningerNormalizedL2Inner` : the inner product divided by the degree.
* `deningerNormalizedL2Inner_ringHom` : it is preserved by every field embedding.
* `deningerAbsL2Inner` : the absolute inner product.
* `deningerAbsL2Inner_intermediateField` : any finite intermediate field computes it.
* `deningerAbsL2Inner_comm` : symmetry.
-/

namespace RHTower

open NumberField Module

open scoped IntermediateField

section NormalizedInner

/-- The `L²` inner product normalized by the degree of the field. -/
noncomputable def deningerNormalizedL2Inner (K : Type*) [Field K] [NumberField K] (x y : K) : ℝ :=
  deningerL2Inner x y / (finrank ℚ K : ℝ)

variable {K K' : Type*} [Field K] [NumberField K] [Field K'] [NumberField K']

/-- **The normalized inner product is preserved by every field embedding.** -/
theorem deningerNormalizedL2Inner_ringHom (φ : K →+* K') {x y : K} (hx : x ≠ 0) (hy : y ≠ 0) :
    deningerNormalizedL2Inner K' (φ x) (φ y) = deningerNormalizedL2Inner K x y := by
  letI : Algebra K K' := φ.toAlgebra
  haveI : IsScalarTower ℚ K K' := by
    refine IsScalarTower.of_algebraMap_eq fun q => ?_
    have h : ((algebraMap K K').comp (algebraMap ℚ K) : ℚ →+* K') = algebraMap ℚ K' :=
      RingHom.ext_rat _ _
    exact (congrArg (fun f : ℚ →+* K' => f q) h).symm
  exact deningerNormalizedL2Inner_baseChange (L := K') hx hy

theorem deningerNormalizedL2Inner_comm (x y : K) :
    deningerNormalizedL2Inner K x y = deningerNormalizedL2Inner K y x := by
  rw [deningerNormalizedL2Inner, deningerNormalizedL2Inner, deningerL2Inner_comm]

end NormalizedInner

section AbsoluteInner

variable {F : Type*} [Field F] [Algebra ℚ F] [Algebra.IsAlgebraic ℚ F]

/-- **The absolute `L²` inner product** of two algebraic numbers: the normalized inner product in
the field they generate. -/
noncomputable def deningerAbsL2Inner (α β : F) : ℝ :=
  deningerNormalizedL2Inner ℚ⟮α, β⟯
    ⟨α, IntermediateField.subset_adjoin ℚ {α, β} (by simp)⟩
    ⟨β, IntermediateField.subset_adjoin ℚ {α, β} (by simp)⟩

omit [Algebra.IsAlgebraic ℚ F] in
/-- A subfield element is zero exactly when its value is. -/
theorem deningerIntermediate_ne_zero {E : IntermediateField ℚ F} {α : F} (hα : α ∈ E)
    (h : α ≠ 0) : (⟨α, hα⟩ : E) ≠ 0 := by
  intro hzero
  exact h (congrArg (fun z : E => (z : F)) hzero)

/-- **Any finite intermediate field computes the absolute inner product.** -/
theorem deningerAbsL2Inner_intermediateField (E : IntermediateField ℚ F) [NumberField E]
    {α β : F} (hα : α ∈ E) (hβ : β ∈ E) (hα0 : α ≠ 0) (hβ0 : β ≠ 0) :
    deningerAbsL2Inner α β = deningerNormalizedL2Inner E ⟨α, hα⟩ ⟨β, hβ⟩ := by
  have hle : ℚ⟮α, β⟯ ≤ E := by
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro z hz
    rcases hz with rfl | hz
    · exact hα
    · rcases hz with rfl
      exact hβ
  let ι : (ℚ⟮α, β⟯ : IntermediateField ℚ F) →+* (E : IntermediateField ℚ F) :=
    { toFun := fun z => ⟨(z : F), hle z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hxne : (⟨α, IntermediateField.subset_adjoin ℚ {α, β} (by simp)⟩ :
      (ℚ⟮α, β⟯ : IntermediateField ℚ F)) ≠ 0 :=
    deningerIntermediate_ne_zero _ hα0
  have hyne : (⟨β, IntermediateField.subset_adjoin ℚ {α, β} (by simp)⟩ :
      (ℚ⟮α, β⟯ : IntermediateField ℚ F)) ≠ 0 :=
    deningerIntermediate_ne_zero _ hβ0
  have hmap := deningerNormalizedL2Inner_ringHom ι hxne hyne
  rw [deningerAbsL2Inner, ← hmap]
  rfl

theorem deningerAbsL2Inner_comm {α β : F} (hα : α ≠ 0) (hβ : β ≠ 0) :
    deningerAbsL2Inner α β = deningerAbsL2Inner β α := by
  have hαm : α ∈ (ℚ⟮α, β⟯ : IntermediateField ℚ F) :=
    IntermediateField.subset_adjoin ℚ {α, β} (by simp)
  have hβm : β ∈ (ℚ⟮α, β⟯ : IntermediateField ℚ F) :=
    IntermediateField.subset_adjoin ℚ {α, β} (by simp)
  rw [deningerAbsL2Inner_intermediateField (ℚ⟮α, β⟯ : IntermediateField ℚ F) hαm hβm hα hβ,
    deningerAbsL2Inner_intermediateField (ℚ⟮α, β⟯ : IntermediateField ℚ F) hβm hαm hβ hα,
    deningerNormalizedL2Inner_comm]

end AbsoluteInner

end RHTower
