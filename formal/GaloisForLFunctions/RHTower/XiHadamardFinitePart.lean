/-
# `P₁` is a Hadamard finite part, not an ordinary zero sum

The ordinary power-sum atlas generated by `-ξ'/ξ` at `s = 0`,

`-ξ'/ξ(s) = ∑_{k ≥ 1} P_k s^{k-1}`,

is often written with `P_k = ∑_ρ ρ^{-k}` for every `k ≥ 1`.  That reading is false at `k = 1`.

Feeding the unconditional Hadamard product `XiC_eq_constant_mul_canonicalProduct` through the
uncentering coordinate change `s ↦ (s - 1/2)/i` gives the genus-one logarithmic derivative
`ξ'/ξ(s) = ∑_ρ [(ρ - 1/2)⁻¹ - (ρ - s)⁻¹]`, whose subtraction at the origin produces
`ξ'/ξ(s) - b = ∑_ρ [ρ⁻¹ + (s - ρ)⁻¹]` with `b = ξ'/ξ(0)`.  Each summand expands as
`-∑_{m ≥ 1} s^m ρ^{-(m+1)}`, and the resulting double family is absolutely summable on `‖s‖ ≤ 1`
because every `ρ` satisfies `‖ρ‖ > 3` and `∑_ρ ‖ρ‖^{-2} < ∞`.  Refibering it the other way gives
the atlas expansion with

* `P_1 = -b`, the Hadamard genus-one finite part — and `∑_ρ ‖ρ‖^{-1}` is *not* summable, so the
  ordinary `k = 1` zero sum does not exist;
* `P_k = ∑_ρ ρ^{-k}` for `k ≥ 2`, absolutely convergent.

The finite part is evaluated exactly: `ξ(s) = s(s-1)/2 · Λ₀(s) + 1/2` gives `ξ(0) = 1/2` and
`ξ'(0) = -Λ₀(0)/2`, hence `P_1 = Λ₀(0) = (γ - log(4π))/2 + 1 = 1 + γ/2 - log(2√π)`.
-/
import GaloisForLFunctions.RHTower.XiRelativeResolventTrace
import GaloisForLFunctions.RHTower.XiZeroSumDivergence
import GaloisForLFunctions.RHTower.CCMFirstClockVolterra
import Mathlib.NumberTheory.Harmonic.ZetaAsymp

noncomputable section

open Complex Filter Topology

namespace RHTower.XiAtlasFinitePart

open RHTower

/-! ## The uncentered zero coordinate -/

/-- The uncentered zero coordinate of a Xi divisor copy: the actual `ρ` in the critical strip. -/
def xiZero (q : XiZeroCopy) : ℂ := (q.1 : ℂ)

theorem xi_xiZero (q : XiZeroCopy) : xi (xiZero q) = 0 :=
  xi_eq_zero_of_mem_divisor_support q.1

theorem xiZero_sub_half_ne_zero (q : XiZeroCopy) : xiZero q - 1 / 2 ≠ 0 :=
  sub_ne_zero.mpr (xi_divisor_support_ne_half q.1)

theorem xiSpectralPoint_eq (q : XiZeroCopy) :
    xiSpectralPoint q = (xiZero q - 1 / 2) * (-I) := by
  simp only [xiSpectralPoint, xiZero]

theorem xiZero_ne_zero (q : XiZeroCopy) : xiZero q ≠ 0 := by
  intro h
  have hre := (xi_divisor_support_re_mem_open_unit q.1).1
  have hz : ((q.1 : ℂ)).re = 0 := by
    have hq : (q.1 : ℂ) = 0 := h
    rw [hq]
    simp
  linarith

/-! ## Norm comparisons between the centered and uncentered coordinates -/

theorem norm_half : ‖((1 : ℂ) / 2)‖ = 1 / 2 := by
  rw [norm_div, norm_one, Complex.norm_ofNat]

theorem norm_xiSpectralPoint_le (q : XiZeroCopy) :
    ‖xiSpectralPoint q‖ ≤ ‖xiZero q‖ + 1 / 2 := by
  rw [norm_xiSpectralPoint]
  have h := norm_sub_le (xiZero q) ((1 : ℂ) / 2)
  rw [norm_half] at h
  exact h

theorem norm_xiZero_le (q : XiZeroCopy) :
    ‖xiZero q‖ ≤ ‖xiSpectralPoint q‖ + 1 / 2 := by
  rw [norm_xiSpectralPoint]
  have h : ‖xiZero q‖ = ‖(xiZero q - 1 / 2) + (1 : ℂ) / 2‖ := by ring_nf
  rw [h]
  refine le_trans (norm_add_le _ _) ?_
  rw [norm_half]
  exact le_rfl

theorem three_lt_norm_xiZero (q : XiZeroCopy) : 3 < ‖xiZero q‖ := by
  have h4 := four_lt_norm_xiSpectralPoint q
  have h := norm_xiSpectralPoint_le q
  linarith

theorem norm_xiSpectralPoint_le_two_mul (q : XiZeroCopy) :
    ‖xiSpectralPoint q‖ ≤ 2 * ‖xiZero q‖ := by
  have h := norm_xiSpectralPoint_le q
  have h3 := three_lt_norm_xiZero q
  linarith

theorem norm_xiZero_le_two_mul (q : XiZeroCopy) :
    ‖xiZero q‖ ≤ 2 * ‖xiSpectralPoint q‖ := by
  have h := norm_xiZero_le q
  have h4 := four_lt_norm_xiSpectralPoint q
  linarith

/-! ## Summability of the zero power sums -/

theorem summable_inv_norm_xiZero_sq :
    Summable (fun q : XiZeroCopy => 1 / ‖xiZero q‖ ^ 2) := by
  refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_)
    (xiSpectralPoint_inv_sq_summable.mul_left 4)
  have h3 := three_lt_norm_xiZero q
  have hs4 := four_lt_norm_xiSpectralPoint q
  have h := norm_xiSpectralPoint_le_two_mul q
  have hA : (0 : ℝ) < ‖xiZero q‖ ^ 2 := by positivity
  have hB : (0 : ℝ) < ‖xiSpectralPoint q‖ ^ 2 := by positivity
  rw [mul_one_div, le_div_iff₀ hB, div_mul_eq_mul_div, div_le_iff₀ hA]
  nlinarith

theorem summable_norm_inv_xiZero_pow {k : ℕ} (hk : 2 ≤ k) :
    Summable (fun q : XiZeroCopy => ‖(xiZero q)⁻¹ ^ k‖) := by
  refine Summable.of_nonneg_of_le (fun q => norm_nonneg _) (fun q => ?_)
    summable_inv_norm_xiZero_sq
  have h3 := three_lt_norm_xiZero q
  rw [norm_pow, norm_inv]
  have hle1 : ‖xiZero q‖⁻¹ ≤ 1 := by
    rw [inv_le_one_iff₀]
    right; linarith
  have hnn : (0 : ℝ) ≤ ‖xiZero q‖⁻¹ := by positivity
  calc ‖xiZero q‖⁻¹ ^ k ≤ ‖xiZero q‖⁻¹ ^ 2 := pow_le_pow_of_le_one hnn hle1 hk
    _ = 1 / ‖xiZero q‖ ^ 2 := by rw [inv_pow, one_div]

theorem summable_inv_xiZero_pow {k : ℕ} (hk : 2 ≤ k) :
    Summable (fun q : XiZeroCopy => (xiZero q)⁻¹ ^ k) :=
  Summable.of_norm (summable_norm_inv_xiZero_pow hk)

/-- **The `k = 1` slot is genuinely divergent.**  The reciprocal zero norms are not summable, so
`∑_ρ ρ⁻¹` is not an absolutely convergent zero sum. -/
theorem not_summable_norm_inv_xiZero :
    ¬ Summable (fun q : XiZeroCopy => ‖(xiZero q)⁻¹‖) := by
  intro h
  refine not_summable_inv_norm_xiSpectralPoint ?_
  refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_) (h.mul_left 2)
  have h3 := three_lt_norm_xiZero q
  have h4 := four_lt_norm_xiSpectralPoint q
  have hle := norm_xiZero_le_two_mul q
  have hσ : (0 : ℝ) < ‖xiSpectralPoint q‖ := by linarith
  have hρ : (0 : ℝ) < ‖xiZero q‖ := by linarith
  rw [norm_inv, one_div, ← one_div, ← one_div, mul_one_div, le_div_iff₀ hρ,
    div_mul_eq_mul_div, div_le_iff₀ hσ]
  nlinarith

/-! ## The genus-one logarithmic derivative in the uncentered coordinate -/

/-- The uncentering coordinate change `s ↦ (s - 1/2)/i`. -/
def unc (s : ℂ) : ℂ := -I * s + I / 2

theorem unc_eq (s : ℂ) : unc s = (s - 1 / 2) * (-I) := by
  rw [unc]; ring

theorem XiC_unc (s : ℂ) : XiC (unc s) = xi s := by
  simp only [XiC, unc_eq]
  congr 1
  have hI : (-I) * I = (1 : ℂ) := by rw [neg_mul, I_mul_I]; ring
  calc (1 : ℂ) / 2 + ((s - 1 / 2) * (-I)) * I
      = 1 / 2 + (s - 1 / 2) * ((-I) * I) := by ring
    _ = s := by rw [hI]; ring

theorem differentiable_unc : Differentiable ℂ unc := by
  unfold unc
  fun_prop

theorem deriv_unc (s : ℂ) : deriv unc s = -I := by
  unfold unc
  rw [deriv_add_const, deriv_const_mul _ differentiableAt_id, deriv_id'', mul_one]

theorem xiZero_sub_ne_zero {s : ℂ} (hs : xi s ≠ 0) (q : XiZeroCopy) :
    xiZero q - s ≠ 0 := by
  intro h
  have hsq : s = xiZero q := (sub_eq_zero.mp h).symm
  rw [hsq] at hs
  exact hs (xi_xiZero q)

theorem term_mul_negI {s : ℂ} (q : XiZeroCopy) :
    xiRelativeResolventTerm (unc s) q * (-I) = (xiZero q - 1 / 2)⁻¹ - (xiZero q - s)⁻¹ := by
  have hI : (-I : ℂ) ≠ 0 := neg_ne_zero.mpr I_ne_zero
  have hstep : xiSpectralPoint q - unc s = (xiZero q - s) * (-I) := by
    rw [xiSpectralPoint_eq, unc_eq]; ring
  rw [xiRelativeResolventTerm, hstep, xiSpectralPoint_eq, mul_inv, mul_inv, sub_mul,
    mul_assoc, mul_assoc, inv_mul_cancel₀ hI, mul_one, mul_one]

theorem summable_logDerivTerm {s : ℂ} (hs : xi s ≠ 0) :
    Summable (fun q : XiZeroCopy => (xiZero q - 1 / 2)⁻¹ - (xiZero q - s)⁻¹) := by
  have hXiCne : XiC (unc s) ≠ 0 := by rw [XiC_unc]; exact hs
  exact ((summable_xiRelativeResolventTerm hXiCne).mul_right (-I)).congr
    (fun q => term_mul_negI q)

/-- **The genus-one Hadamard logarithmic derivative for `ξ`, in the uncentered variable.** -/
theorem logDeriv_xi_eq {s : ℂ} (hs : xi s ≠ 0) :
    logDeriv xi s = ∑' q : XiZeroCopy, ((xiZero q - 1 / 2)⁻¹ - (xiZero q - s)⁻¹) := by
  have hXiCne : XiC (unc s) ≠ 0 := by rw [XiC_unc]; exact hs
  have hfun : xi = XiC ∘ unc := funext (fun t => (XiC_unc t).symm)
  have h1 : logDeriv xi s = logDeriv XiC (unc s) * (-I) := by
    rw [hfun, logDeriv_comp (XiC_differentiable _) (differentiable_unc s), deriv_unc]
  rw [h1, logDeriv_XiC_eq_relativeResolventTrace hXiCne, xiRelativeResolventTrace,
    ← tsum_mul_right]
  exact tsum_congr (fun q => term_mul_negI q)

theorem xi_zero_eq : xi 0 = 1 / 2 := by
  rw [xi]; ring_nf

theorem xi_zero_ne : xi 0 ≠ 0 := by
  rw [xi_zero_eq]; norm_num

/-- The Hadamard-normalized relative resolvent sum, centered at the origin. -/
theorem logDeriv_xi_sub_eq {s : ℂ} (hs : xi s ≠ 0) :
    logDeriv xi s - logDeriv xi 0
      = ∑' q : XiZeroCopy, ((xiZero q)⁻¹ - (xiZero q - s)⁻¹) := by
  rw [logDeriv_xi_eq hs, logDeriv_xi_eq xi_zero_ne,
    ← Summable.tsum_sub (summable_logDerivTerm hs) (summable_logDerivTerm xi_zero_ne)]
  refine tsum_congr (fun q => ?_)
  rw [sub_zero]
  ring

/-! ## The zero power sums and the Hadamard finite part -/

/-- The absolutely convergent zero power sum `∑_ρ ρ^{-k}` (meaningful for `k ≥ 2`). -/
def zeroPowerSum (k : ℕ) : ℂ := ∑' q : XiZeroCopy, (xiZero q)⁻¹ ^ k

/-- The atlas coefficients of `-ξ'/ξ` at the origin.  The `k = 1` slot is the Hadamard genus-one
finite part, not an ordinary zero sum. -/
def P (k : ℕ) : ℂ := if k = 1 then -logDeriv xi 0 else zeroPowerSum k

theorem P_eq_zeroPowerSum {k : ℕ} (hk : 2 ≤ k) : P k = zeroPowerSum k := by
  rw [P, if_neg (by omega)]

/-- The double family whose two fiberings give the two sides of the atlas expansion. -/
def gTerm (s : ℂ) (p : XiZeroCopy × ℕ) : ℂ :=
  -(s ^ (p.2 + 1) * (xiZero p.1)⁻¹ ^ (p.2 + 2))

set_option maxHeartbeats 1000000 in
theorem summable_gTerm {s : ℂ} (hs1 : ‖s‖ ≤ 1) : Summable (gTerm s) := by
  have hmaj : Summable (fun p : XiZeroCopy × ℕ =>
      (1 / ‖xiZero p.1‖ ^ 2) * (1 / 3 : ℝ) ^ p.2) :=
    Summable.mul_of_nonneg summable_inv_norm_xiZero_sq
      (summable_geometric_of_lt_one (by norm_num) (by norm_num))
      (fun q => by positivity) (fun m => by positivity)
  refine Summable.of_norm_bounded hmaj (fun p => ?_)
  obtain ⟨q, m⟩ := p
  have h3 := three_lt_norm_xiZero q
  have hpos : (0 : ℝ) < ‖xiZero q‖ := by linarith
  simp only [gTerm, norm_neg, norm_mul, norm_pow, norm_inv]
  have hs : ‖s‖ ^ (m + 1) ≤ 1 := pow_le_one₀ (norm_nonneg _) hs1
  have hinv : ‖xiZero q‖⁻¹ ≤ 1 / 3 := by
    rw [inv_le_iff_one_le_mul₀ hpos]
    linarith
  have hinvnn : (0 : ℝ) ≤ ‖xiZero q‖⁻¹ := by positivity
  calc ‖s‖ ^ (m + 1) * ‖xiZero q‖⁻¹ ^ (m + 2)
      ≤ 1 * ‖xiZero q‖⁻¹ ^ (m + 2) :=
        mul_le_mul_of_nonneg_right hs (by positivity)
    _ = ‖xiZero q‖⁻¹ ^ 2 * ‖xiZero q‖⁻¹ ^ m := by
        rw [one_mul, ← pow_add]
        congr 1
        omega
    _ ≤ (1 / ‖xiZero q‖ ^ 2) * (1 / 3) ^ m := by
        refine mul_le_mul (le_of_eq (by rw [inv_pow, one_div])) ?_ (by positivity)
          (by positivity)
        exact pow_le_pow_left₀ hinvnn hinv m

set_option maxHeartbeats 1000000 in
theorem hasSum_gTerm_fiber {s : ℂ} (hs1 : ‖s‖ ≤ 1) (hs : xi s ≠ 0) (q : XiZeroCopy) :
    HasSum (fun m : ℕ => gTerm s (q, m)) ((xiZero q)⁻¹ - (xiZero q - s)⁻¹) := by
  have h3 := three_lt_norm_xiZero q
  have hpos : (0 : ℝ) < ‖xiZero q‖ := by linarith
  have hne : xiZero q ≠ 0 := xiZero_ne_zero q
  have hns : xiZero q - s ≠ 0 := xiZero_sub_ne_zero hs q
  have hratio : ‖s * (xiZero q)⁻¹‖ < 1 := by
    rw [norm_mul, norm_inv]
    have h2 : ‖xiZero q‖⁻¹ < 1 := by
      rw [inv_lt_one_iff₀]; right; linarith
    calc ‖s‖ * ‖xiZero q‖⁻¹ ≤ 1 * ‖xiZero q‖⁻¹ :=
          mul_le_mul_of_nonneg_right hs1 (by positivity)
      _ = ‖xiZero q‖⁻¹ := one_mul _
      _ < 1 := h2
  have hgeo := (hasSum_geometric_of_norm_lt_one hratio).mul_left
    (-(s * (xiZero q)⁻¹ ^ 2))
  have hfun : (fun m : ℕ => -(s * (xiZero q)⁻¹ ^ 2) * (s * (xiZero q)⁻¹) ^ m)
      = fun m : ℕ => gTerm s (q, m) := by
    funext m
    simp only [gTerm, mul_pow]
    ring
  rw [hfun] at hgeo
  have hsplit : (1 : ℂ) - s * (xiZero q)⁻¹ = (xiZero q - s) * (xiZero q)⁻¹ := by
    field_simp
  have hden : (1 : ℂ) - s * (xiZero q)⁻¹ ≠ 0 := by
    rw [hsplit]
    exact mul_ne_zero hns (inv_ne_zero hne)
  have hval : -(s * (xiZero q)⁻¹ ^ 2) * (1 - s * (xiZero q)⁻¹)⁻¹
      = (xiZero q)⁻¹ - (xiZero q - s)⁻¹ := by
    rw [hsplit, mul_inv, inv_inv]
    field_simp
    ring
  rw [hval] at hgeo
  exact hgeo

theorem hasSum_gTerm_colFiber (s : ℂ) (m : ℕ) :
    HasSum (fun q : XiZeroCopy => gTerm s (q, m))
      (-(s ^ (m + 1) * zeroPowerSum (m + 2))) := by
  have hsum := summable_inv_xiZero_pow (k := m + 2) (by omega)
  have h1 : HasSum (fun q : XiZeroCopy => s ^ (m + 1) * (xiZero q)⁻¹ ^ (m + 2))
      (s ^ (m + 1) * zeroPowerSum (m + 2)) := by
    rw [zeroPowerSum]
    exact hsum.hasSum.mul_left _
  exact h1.neg

set_option maxHeartbeats 1000000 in
/-- **The atlas expansion of `-ξ'/ξ` at the origin.** -/
theorem hasSum_neg_logDeriv_xi {s : ℂ} (hs1 : ‖s‖ ≤ 1) (hs : xi s ≠ 0) :
    HasSum (fun k : ℕ => P (k + 1) * s ^ k) (-logDeriv xi s) := by
  have hg := summable_gTerm hs1
  have hrow : HasSum (fun q : XiZeroCopy => (xiZero q)⁻¹ - (xiZero q - s)⁻¹)
      (∑' p, gTerm s p) :=
    hg.hasSum.prod_fiberwise (fun q => hasSum_gTerm_fiber hs1 hs q)
  have hS : (∑' p, gTerm s p) = logDeriv xi s - logDeriv xi 0 := by
    rw [logDeriv_xi_sub_eq hs]
    exact hrow.tsum_eq.symm
  have hcol : HasSum (fun m : ℕ => -(s ^ (m + 1) * zeroPowerSum (m + 2)))
      (∑' p, gTerm s p) := by
    have hswap : HasSum (fun p : ℕ × XiZeroCopy => gTerm s (p.2, p.1)) (∑' p, gTerm s p) :=
      (Equiv.hasSum_iff (Equiv.prodComm ℕ XiZeroCopy)).mpr hg.hasSum
    exact hswap.prod_fiberwise (fun m => hasSum_gTerm_colFiber s m)
  rw [hS] at hcol
  have hneg : HasSum (fun m : ℕ => s ^ (m + 1) * zeroPowerSum (m + 2))
      (logDeriv xi 0 - logDeriv xi s) := by
    have hc := hcol.neg
    simpa only [neg_neg, neg_sub] using hc
  have hshift : (fun m : ℕ => (fun k : ℕ => P (k + 1) * s ^ k) (m + 1))
      = fun m : ℕ => s ^ (m + 1) * zeroPowerSum (m + 2) := by
    funext m
    have hP : P (m + 1 + 1) = zeroPowerSum (m + 2) := by
      rw [P_eq_zeroPowerSum (by omega)]
    simp only [hP]
    ring
  have hmain := (hasSum_nat_add_iff (f := fun k : ℕ => P (k + 1) * s ^ k) 1).mp
    (by rw [hshift]; exact hneg)
  have hzeroth : ∑ i ∈ Finset.range 1, (fun k : ℕ => P (k + 1) * s ^ k) i
      = -logDeriv xi 0 := by
    simp [P]
  rw [hzeroth] at hmain
  have hsimp : logDeriv xi 0 - logDeriv xi s + -logDeriv xi 0 = -logDeriv xi s := by ring
  rw [hsimp] at hmain
  exact hmain

/-! ## Evaluation of the finite part -/

theorem logDeriv_xi_zero : logDeriv xi 0 = -completedRiemannZeta₀ 0 := by
  have hL : HasDerivAt completedRiemannZeta₀ (deriv completedRiemannZeta₀ 0) 0 :=
    (differentiable_completedZeta₀ 0).hasDerivAt
  have hu : HasDerivAt (fun s : ℂ => s * (s - 1) / 2) (-(1 / 2)) 0 := by
    have h : HasDerivAt (fun s : ℂ => s * (s - 1) / 2)
        ((1 * (0 - 1) + 0 * 1) / 2) 0 :=
      ((hasDerivAt_id (0 : ℂ)).mul ((hasDerivAt_id (0 : ℂ)).sub_const 1)).div_const 2
    convert h using 1
    norm_num
  have hmul : HasDerivAt (fun s : ℂ => s * (s - 1) / 2 * completedRiemannZeta₀ s)
      (-(1 / 2) * completedRiemannZeta₀ 0
        + 0 * (0 - 1) / 2 * deriv completedRiemannZeta₀ 0) 0 := hu.mul hL
  have hxi : HasDerivAt xi
      (-(1 / 2) * completedRiemannZeta₀ 0
        + 0 * (0 - 1) / 2 * deriv completedRiemannZeta₀ 0) 0 :=
    hmul.add_const ((1 : ℂ) / 2)
  have hderiv : deriv xi 0 = -(1 / 2) * completedRiemannZeta₀ 0 := by
    rw [hxi.deriv]
    ring
  rw [logDeriv_apply, hderiv, xi_zero_eq]
  field_simp

/-- **The `k = 1` atlas coefficient is the Hadamard genus-one finite part.** -/
theorem P_one : P 1 = completedRiemannZeta₀ 0 := by
  rw [P, if_pos rfl, logDeriv_xi_zero, neg_neg]

/-- **The explicit value of the finite part.** -/
theorem P_one_explicit :
    P 1 = ((Real.eulerMascheroniConstant : ℂ) - Complex.log (4 * Real.pi)) / 2 + 1 := by
  rw [P_one, completedRiemannZeta₀_zero]

/-- **HD1's normalization correction, assembled.** -/
theorem hadamardFinitePart_atlas :
    (∀ s : ℂ, ‖s‖ ≤ 1 → xi s ≠ 0 →
        HasSum (fun k : ℕ => P (k + 1) * s ^ k) (-logDeriv xi s)) ∧
      (∀ k : ℕ, 2 ≤ k → P k = ∑' q : XiZeroCopy, (xiZero q)⁻¹ ^ k ∧
        Summable (fun q : XiZeroCopy => ‖(xiZero q)⁻¹ ^ k‖)) ∧
      P 1 = ((Real.eulerMascheroniConstant : ℂ) - Complex.log (4 * Real.pi)) / 2 + 1 ∧
      ¬ Summable (fun q : XiZeroCopy => ‖(xiZero q)⁻¹‖) :=
  ⟨fun _ hs1 hs => hasSum_neg_logDeriv_xi hs1 hs,
    fun _ hk => ⟨P_eq_zeroPowerSum hk, summable_norm_inv_xiZero_pow hk⟩,
    P_one_explicit, not_summable_norm_inv_xiZero⟩

end RHTower.XiAtlasFinitePart
