import Mathlib.Tactic.NoncommRing

/-!
# Deninger diagonal power relations

This module formalizes the unconditional algebraic core of
`DAC_DIAGONAL_POWER_RELATION_LEIBNIZ`.  For two multiplicative operator
families `T` and `F`, the diagonal difference `T n - F n` at a product is
generated by the differences at its two factors.

No arithmetic-cohomology existence, spectral, trace, positivity, zeta-zero,
or Riemann-hypothesis premise occurs.
-/

namespace GaloisForLFunctions.RHTower

/-- Difference between the suspension and Frobenius operators at one power. -/
def deningerDiagonalPowerRelation
    {M A : Type*} [Ring A]
    (T F : M → A) (n : M) : A :=
  T n - F n

/--
The diagonal relation at a product is generated by the relations at its
factors.  No commutation between the two operator families is required.
-/
theorem deningerDiagonalPowerRelation_mul
    {M A : Type*} [Mul M] [Ring A]
    (T F : M → A) (m n : M)
    (hT : T (m * n) = T m * T n)
    (hF : F (m * n) = F m * F n) :
    deningerDiagonalPowerRelation T F (m * n) =
      T m * deningerDiagonalPowerRelation T F n +
        deningerDiagonalPowerRelation T F m * F n := by
  unfold deningerDiagonalPowerRelation
  rw [hT, hF]
  noncomm_ring

/--
For commuting indices, the two factorizations of the same diagonal relation
give the canonical factor-order syzygy.
-/
theorem deningerDiagonalPowerRelation_factorOrder_syzygy
    {M A : Type*} [Mul M] [Ring A]
    (T F : M → A) (m n : M)
    (hmn : m * n = n * m)
    (hTmn : T (m * n) = T m * T n)
    (hFmn : F (m * n) = F m * F n)
    (hTnm : T (n * m) = T n * T m)
    (hFnm : F (n * m) = F n * F m) :
    T m * deningerDiagonalPowerRelation T F n +
        deningerDiagonalPowerRelation T F m * F n =
      T n * deningerDiagonalPowerRelation T F m +
        deningerDiagonalPowerRelation T F n * F m := by
  calc
    T m * deningerDiagonalPowerRelation T F n +
          deningerDiagonalPowerRelation T F m * F n =
        deningerDiagonalPowerRelation T F (m * n) :=
      (deningerDiagonalPowerRelation_mul T F m n hTmn hFmn).symm
    _ = deningerDiagonalPowerRelation T F (n * m) := by rw [hmn]
    _ =
        T n * deningerDiagonalPowerRelation T F m +
          deningerDiagonalPowerRelation T F n * F m :=
      deningerDiagonalPowerRelation_mul T F n m hTnm hFnm

end GaloisForLFunctions.RHTower
