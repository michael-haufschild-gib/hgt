import Mathlib

/-!
# Deninger diagonal power relations

This module formalizes the unconditional algebraic core of
`DAC_DIAGONAL_POWER_RELATION_LEIBNIZ`.  For two multiplicative operator
families `T` and `F`, the diagonal difference `T n - F n` at a product is
generated by the differences at its two factors.  Iterating the Leibniz law
along a prime factorization shows that the relation at any positive integer
already lies in the two-sided span of the relations at its prime divisors:
composite powers contribute no new generators.

No arithmetic-cohomology existence, spectral, trace, positivity, zeta-zero,
or Riemann-hypothesis premise occurs.
-/

namespace GaloisForLFunctions.RHTower

/-- Difference between the suspension and Frobenius operators at one power. -/
def deningerDiagonalPowerRelation
    {M A : Type*} [Ring A]
    (T F : M → A) (n : M) : A :=
  T n - F n

/--
The diagonal relation at a product is generated by the relations at its
factors.  No commutation between the two operator families is required.
-/
theorem deningerDiagonalPowerRelation_mul
    {M A : Type*} [Mul M] [Ring A]
    (T F : M → A) (m n : M)
    (hT : T (m * n) = T m * T n)
    (hF : F (m * n) = F m * F n) :
    deningerDiagonalPowerRelation T F (m * n) =
      T m * deningerDiagonalPowerRelation T F n +
        deningerDiagonalPowerRelation T F m * F n := by
  unfold deningerDiagonalPowerRelation
  rw [hT, hF]
  noncomm_ring

/--
For commuting indices, the two factorizations of the same diagonal relation
give the canonical factor-order syzygy.
-/
theorem deningerDiagonalPowerRelation_factorOrder_syzygy
    {M A : Type*} [Mul M] [Ring A]
    (T F : M → A) (m n : M)
    (hmn : m * n = n * m)
    (hTmn : T (m * n) = T m * T n)
    (hFmn : F (m * n) = F m * F n)
    (hTnm : T (n * m) = T n * T m)
    (hFnm : F (n * m) = F n * F m) :
    T m * deningerDiagonalPowerRelation T F n +
        deningerDiagonalPowerRelation T F m * F n =
      T n * deningerDiagonalPowerRelation T F m +
        deningerDiagonalPowerRelation T F n * F m := by
  calc
    T m * deningerDiagonalPowerRelation T F n +
          deningerDiagonalPowerRelation T F m * F n =
        deningerDiagonalPowerRelation T F (m * n) :=
      (deningerDiagonalPowerRelation_mul T F m n hTmn hFmn).symm
    _ = deningerDiagonalPowerRelation T F (n * m) := by rw [hmn]
    _ =
        T n * deningerDiagonalPowerRelation T F m +
          deningerDiagonalPowerRelation T F n * F m :=
      deningerDiagonalPowerRelation_mul T F n m hTnm hFnm

/-! ## Prime generation of the relation module -/

/-- The additive subgroup of two-sided `A`-combinations of the diagonal relations at the prime
divisors of `n`. -/
def deningerPrimeRelationSubgroup
    {A : Type*} [Ring A] (T F : ℕ → A) (n : ℕ) : AddSubgroup A :=
  AddSubgroup.closure
    {x : A | ∃ p : ℕ, p.Prime ∧ p ∣ n ∧
      ∃ a b : A, x = a * deningerDiagonalPowerRelation T F p * b}

theorem deningerPrimeRelationSubgroup_generator_mem
    {A : Type*} [Ring A] (T F : ℕ → A) {p n : ℕ} (hp : p.Prime) (hpn : p ∣ n) (a b : A) :
    a * deningerDiagonalPowerRelation T F p * b ∈ deningerPrimeRelationSubgroup T F n :=
  AddSubgroup.subset_closure ⟨p, hp, hpn, a, b, rfl⟩

/-- Divisibility enlarges the generating prime set, hence the relation subgroup. -/
theorem deningerPrimeRelationSubgroup_mono
    {A : Type*} [Ring A] (T F : ℕ → A) {m n : ℕ} (hmn : m ∣ n) :
    deningerPrimeRelationSubgroup T F m ≤ deningerPrimeRelationSubgroup T F n := by
  refine AddSubgroup.closure_mono ?_
  rintro x ⟨p, hp, hpm, a, b, rfl⟩
  exact ⟨p, hp, hpm.trans hmn, a, b, rfl⟩

/-- The relation subgroup is a left ideal: two-sided generators absorb left multiplication. -/
theorem deningerPrimeRelationSubgroup_mul_left_mem
    {A : Type*} [Ring A] (T F : ℕ → A) {n : ℕ} (c : A) {x : A}
    (hx : x ∈ deningerPrimeRelationSubgroup T F n) :
    c * x ∈ deningerPrimeRelationSubgroup T F n := by
  have hsub :
      {x : A | ∃ p : ℕ, p.Prime ∧ p ∣ n ∧
        ∃ a b : A, x = a * deningerDiagonalPowerRelation T F p * b} ⊆
      ((deningerPrimeRelationSubgroup T F n).comap (AddMonoidHom.mulLeft c) : Set A) := by
    rintro x ⟨p, hp, hpn, a, b, rfl⟩
    show c * (a * deningerDiagonalPowerRelation T F p * b) ∈
      deningerPrimeRelationSubgroup T F n
    have hrw : c * (a * deningerDiagonalPowerRelation T F p * b)
        = c * a * deningerDiagonalPowerRelation T F p * b := by
      noncomm_ring
    rw [hrw]
    exact deningerPrimeRelationSubgroup_generator_mem T F hp hpn (c * a) b
  exact (AddSubgroup.closure_le _).mpr hsub hx

/-- **Prime generation of diagonal relations.**  For multiplicative families normalized at `1`,
the diagonal relation at every positive integer already lies in the two-sided span of the
relations at its prime divisors.  Composite powers add no new generators. -/
theorem deningerDiagonalPowerRelation_mem_primeRelationSubgroup
    {A : Type*} [Ring A] (T F : ℕ →* A) :
    ∀ n : ℕ, n ≠ 0 →
      deningerDiagonalPowerRelation (T : ℕ → A) (F : ℕ → A) n ∈
        deningerPrimeRelationSubgroup (T : ℕ → A) (F : ℕ → A) n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn
    rcases eq_or_ne n 1 with rfl | hn1
    · have h1 : deningerDiagonalPowerRelation (T : ℕ → A) (F : ℕ → A) 1 = 0 := by
        simp [deningerDiagonalPowerRelation]
      rw [h1]
      exact (deningerPrimeRelationSubgroup (T : ℕ → A) (F : ℕ → A) 1).zero_mem
    · obtain ⟨p, hp, k, rfl⟩ : ∃ p : ℕ, p.Prime ∧ ∃ k : ℕ, n = p * k := by
        obtain ⟨p, hp, k, hk⟩ := Nat.exists_prime_and_dvd hn1
        exact ⟨p, hp, k, hk⟩
      have hk0 : k ≠ 0 := by
        rintro rfl
        simp at hn
      have hklt : k < p * k := by
        have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
        have hp2 : 2 ≤ p := hp.two_le
        nlinarith
      have hrel := deningerDiagonalPowerRelation_mul (T : ℕ → A) (F : ℕ → A) p k
        (map_mul T p k) (map_mul F p k)
      rw [hrel]
      refine AddSubgroup.add_mem _ ?_ ?_
      · refine deningerPrimeRelationSubgroup_mul_left_mem _ _ _ ?_
        exact deningerPrimeRelationSubgroup_mono _ _ (dvd_mul_left k p) (ih k hklt hk0)
      · have hrw : deningerDiagonalPowerRelation (T : ℕ → A) (F : ℕ → A) p * F k
            = 1 * deningerDiagonalPowerRelation (T : ℕ → A) (F : ℕ → A) p * F k := by
          rw [one_mul]
        rw [hrw]
        exact deningerPrimeRelationSubgroup_generator_mem _ _ hp (dvd_mul_right p k) 1 (F k)

end GaloisForLFunctions.RHTower
