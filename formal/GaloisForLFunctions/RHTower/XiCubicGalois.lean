import GaloisForLFunctions.RHTower.XiCubicDiscriminant
import GaloisForLFunctions.HTGeometry.CubicGaloisGroup
import Mathlib.Algebra.CharP.Algebra

/-!
# Actual S3 extensions generated by the tilted Xi cubic

Every nonnegative real tilt gives an irreducible cubic over the actual
meromorphic plane with nonsquare discriminant. Its root algebra is a field
of degree three, and its splitting field has Galois group S3 and degree six.
The integer-marked wrappers require no source hypotheses.
-/

open GaloisForLFunctions.HTGeometry
namespace RHTower

local instance : CharZero MeromorphicPlane :=
  charZero_of_injective_ringHom constPlane_injective

/-- The cubic root algebra of every nonnegatively tilted actual Xi source is a field. -/
theorem xiCubicRoot_isField (a : ℝ) (ha : 0 ≤ a) :
    IsField (AdjoinRoot (xiCubicPolynomial a)) := by
  letI : Fact (Irreducible (xiCubicPolynomial a)) := ⟨xiCubicPolynomial_irreducible a ha⟩
  exact Field.toIsField _

/-- The distinguished root satisfies the actual Xi cubic equation in its root algebra. -/
theorem xiCubicRoot_equation (a : ℝ) :
    (AdjoinRoot.root (xiCubicPolynomial a)) ^ 3 -
        3 * AdjoinRoot.root (xiCubicPolynomial a) - 2 =
      4 * algebraMap MeromorphicPlane (AdjoinRoot (xiCubicPolynomial a))
        (xiCubicParameterElement a) := by
  have h : Polynomial.aeval (AdjoinRoot.root (xiCubicPolynomial a))
      (xiCubicPolynomial a) = 0 := by rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  change Polynomial.aeval (AdjoinRoot.root (xiCubicPolynomial a))
    (Polynomial.C 1 * Polynomial.X ^ 3 + Polynomial.C 0 * Polynomial.X ^ 2 +
      Polynomial.C (-3) * Polynomial.X +
      Polynomial.C (-(2 + 4 * xiCubicParameterElement a))) = 0 at h
  simp only [map_add, map_mul, map_pow,
    Polynomial.aeval_C, Polynomial.aeval_X, map_neg, map_ofNat, map_one, map_zero,
    one_mul, zero_mul, add_zero] at h
  linear_combination h

/-- The actual tilted Xi cubic has full S3 Galois group over the meromorphic plane. -/
noncomputable def xiCubicGaloisEquiv (a : ℝ) (ha : 0 ≤ a) :
    (xiCubicPolynomial a).Gal ≃* Equiv.Perm (Fin 3) :=
  cubicGaloisEquivPermThree
    (⟨1, 0, -3, -(2 + 4 * xiCubicParameterElement a)⟩ : Cubic MeromorphicPlane)
    one_ne_zero (xiCubicPolynomial_irreducible a ha) (xiCubicDiscriminant_not_isSquare a)

/-- The actual source's cubic splitting field has degree six. -/
theorem xiCubic_splittingField_finrank (a : ℝ) (ha : 0 ≤ a) :
    Module.finrank MeromorphicPlane (xiCubicPolynomial a).SplittingField = 6 :=
  cubic_splittingField_finrank_eq_six
    (⟨1, 0, -3, -(2 + 4 * xiCubicParameterElement a)⟩ : Cubic MeromorphicPlane)
    one_ne_zero (xiCubicPolynomial_irreducible a ha) (xiCubicDiscriminant_not_isSquare a)

/-- Every integer-marked channel, indexed by n+2, has actual S3 Galois group. -/
noncomputable def integerMarkedXiCubicGaloisEquiv (n : ℕ) :
    (xiCubicPolynomial (Real.log (n + 2))).Gal ≃* Equiv.Perm (Fin 3) :=
  xiCubicGaloisEquiv _ (Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ n + 2)))

/-- Every integer-marked channel has cubic splitting degree six. -/
theorem integerMarkedXiCubic_splittingField_finrank (n : ℕ) :
    Module.finrank MeromorphicPlane (xiCubicPolynomial (Real.log (n + 2))).SplittingField = 6 :=
  xiCubic_splittingField_finrank _ (Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ n + 2)))

end RHTower
