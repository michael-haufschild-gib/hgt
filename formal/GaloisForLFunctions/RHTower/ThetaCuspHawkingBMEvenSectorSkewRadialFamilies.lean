import GaloisForLFunctions.RHTower.ThetaCuspHawkingBMEvenSectorRadialCurrent

/-!
# The two-rate radial current between the `++` and `−−` Laurent responses: family pieces

The radial component of the Einstein action symplectic current between the scalar–scalar `++`
Laurent response at rate `2s` and the `−−` Laurent response at rate `2(−3−s)` (the same
reconstruction at the reflected half-rate with the harmonic sources at the reflected rate) is
bilinear in the two reconstructed streams. This module records the pure-Laurent family pairs
(`skewRadFF_*`), the current of a family of one stream against a single source jet of the other
(`evenSector_skewRadRadFQ_*`, `evenSector_skewRadRadQF_*`, with closed forms `skewRadFQ_*`, `skewRadQF_*`), and the
elementary atoms `skewRadAtom1_*`, `skewRadAtom2_*` (the current's coefficient of one reconstruction jet
against a single source jet of the other stream) from which the source/source pairs are assembled.
Additivity of the current in the second stream slot (`streamCurrent_1_add'`, `streamCurrent_1_smul'`)
complements the first-slot additivity of the radial module.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace RHTower.D4BMScalarStream
open GaloisForLFunctions.HTGeometry CoordinateMetricTwoJet D4BMScalarLinearEquation
open RHTower.D4BMMixedActionCurrent RHTower.D4BMActionSymplecticForm
noncomputable section

/-- The radial current is additive in the second stream jet (second derivative slots unsplit). -/
theorem streamCurrent_1_add' (s v r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy G0 G01 G02 G1 G11 G12 G2 G21 G22 L L1 L2 G0' G01' G1' G11' G2' G21' L' L1' Q Qx Qy Qxx Qxy Qyy : ℂ)
    (hr : r ≠ 0) (hy : y ≠ 0) (hf : r ^ 2 - 1 ≠ 0) :
    actionSymplectic (D4BMBackground.jet r y) (metricJet s r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy)
      (metricJet v r y (G0 + G0') (G01 + G01') G02 (G1 + G1') (G11 + G11') G12 (G2 + G2') (G21 + G21') G22 (L + L') (L1 + L1') L2 Q Qx Qy Qxx Qxy Qyy) 1 =
    actionSymplectic (D4BMBackground.jet r y) (metricJet s r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy)
      (metricJet v r y G0 G01 G02 G1 G11 G12 G2 G21 G22 L L1 L2 Q Qx Qy Qxx Qxy Qyy) 1 +
    actionSymplectic (D4BMBackground.jet r y) (metricJet s r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy)
      (metricJet v r y G0' G01' G02 G1' G11' G12 G2' G21' G22 L' L1' L2 Q Qx Qy Qxx Qxy Qyy) 1 := by
  simp only [streamCurrent_1 hr hy hf]
  ring

/-- The radial current is homogeneous in the second stream jet (second derivative slots unsplit). -/
theorem streamCurrent_1_smul' (c s v r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy G0 G01 G02 G1 G11 G12 G2 G21 G22 L L1 L2 Q Qx Qy Qxx Qxy Qyy : ℂ)
    (hr : r ≠ 0) (hy : y ≠ 0) (hf : r ^ 2 - 1 ≠ 0) :
    actionSymplectic (D4BMBackground.jet r y) (metricJet s r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy)
      (metricJet v r y (c * G0) (c * G01) G02 (c * G1) (c * G11) G12 (c * G2) (c * G21) G22 (c * L) (c * L1) L2 Q Qx Qy Qxx Qxy Qyy) 1 =
    c * actionSymplectic (D4BMBackground.jet r y) (metricJet s r y F0 F01 F02 F1 F11 F12 F2 F21 F22 H H1 H2 P Px Py Pxx Pxy Pyy)
      (metricJet v r y G0 G01 G02 G1 G11 G12 G2 G21 G22 L L1 L2 Q Qx Qy Qxx Qxy Qyy) 1 := by
  simp only [streamCurrent_1 hr hy hf]
  ring

