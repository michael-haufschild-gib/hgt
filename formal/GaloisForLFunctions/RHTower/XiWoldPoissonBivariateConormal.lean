import GaloisForLFunctions.RHTower.XiSourceCayleyOrderSpaceConservationLaw
import GaloisForLFunctions.RHTower.HighExponentShellZeroFree

/-!
# Bivariate Wold--Poisson realization of the Xi principal conormal

The positive largest-exponent shell multiplier and the Poisson-normalized
source evolution define two independent source coordinates before divisor
specialization.  This module constructs their literal product and proves:

* its residue is the shell coordinate times the transported Xi residue;
* the zero-free shell factor does not annihilate any strict-right conormal;
* on the Euler half-plane it is generated by the explicit prime--Gamma source;
* every shell coordinate has the exact source-horizon Poisson packet, with
  the shell multiplier carried as its initial conormal amplitude.

No Xi zero is enumerated, no critical-line hypothesis is used, and no
relation between shell depth and Poisson time is imposed.
-/

open Complex Filter Topology
open GaloisForLFunctions

namespace RHTower

noncomputable section

/-- The off-divisor bivariate source response: positive shell coordinate
times the Poisson-evolved completed logarithmic response. -/
def xiWoldPoissonBivariateConormalResponse
    (n : ℕ) (x s : ℂ) : ℂ :=
  shellMultiplier n s * xiCayleyEvolvedLogDeriv x s

/-- The corresponding shell-labelled transported principal-conormal mode. -/
def xiWoldPoissonBivariateConormalResidueMode
    (n : ℕ) (rho x : ℂ) : ℂ :=
  shellMultiplier n rho * xiCayleySourceResidueMode rho x

/-- The bivariate response has the expected shell-labelled residue at every
point in the strict right half-plane.  Shell and time remain independent. -/
theorem xiWoldPoissonBivariateConormalResponse_residue_transport
    {n : ℕ} (hn : 12 ≤ n) {rho : ℂ}
    (hhalf : 1 / 2 < rho.re) (hrho : rho ≠ 1) (x : ℂ) :
    Tendsto
      (fun s : ℂ =>
        (s - rho) * xiWoldPoissonBivariateConormalResponse n x s)
      (nhdsWithin rho ({rho}ᶜ))
      (nhds (xiWoldPoissonBivariateConormalResidueMode n rho x)) := by
  have hshell : Tendsto (shellMultiplier n)
      (nhdsWithin rho ({rho}ᶜ))
      (nhds (shellMultiplier n rho)) :=
    ((analyticAt_shellMultiplier hn hhalf).continuousAt).tendsto.mono_left
      nhdsWithin_le_nhds
  have hresidue := xiCayleyEvolvedLogDeriv_residue_transport hrho x
  have hmul := hshell.mul hresidue
  simpa only [xiWoldPoissonBivariateConormalResponse,
    xiWoldPoissonBivariateConormalResidueMode, mul_assoc, mul_left_comm]
    using hmul

/-- The bivariate residue is exactly the universal source-horizon mode with
initial amplitude equal to the shell coordinate times Xi multiplicity. -/
theorem xiWoldPoissonBivariateConormalResidueMode_eq
    (n : ℕ) (rho x : ℂ) :
    xiWoldPoissonBivariateConormalResidueMode n rho x =
      HTGeometry.cayleyPoleResidueMode
        (shellMultiplier n rho *
          ((analyticOrderAt xi rho).toNat : ℂ))
        1 rho x := by
  rw [xiWoldPoissonBivariateConormalResidueMode,
    xiCayleySourceResidueMode, HTGeometry.cayleyPoleResidueMode]
  ring

/-- Zero-free shell continuation is faithful on the transported principal
conormal throughout the strict right half-plane. -/
theorem xiWoldPoissonBivariateConormalResidueMode_eq_zero_iff
    {n : ℕ} (hn : 12 ≤ n) {rho x : ℂ}
    (hhalf : 1 / 2 < rho.re) :
    xiWoldPoissonBivariateConormalResidueMode n rho x = 0 ↔
      xiCayleySourceResidueMode rho x = 0 := by
  rw [xiWoldPoissonBivariateConormalResidueMode, mul_eq_zero]
  simp only [shellMultiplier_ne_zero hn hhalf, false_or]

/-- Before continuation, the bivariate response is generated by the literal
prime--Gamma arithmetic source in every shell. -/
theorem xiWoldPoissonBivariateConormalResponse_eq_arithmetic
    (n : ℕ) (x : ℂ) {s : ℂ} (hs : 1 < s.re) :
    xiWoldPoissonBivariateConormalResponse n x s =
      shellMultiplier n s *
        ((s⁻¹ + (s - 1)⁻¹ + logDeriv Complex.Gammaℝ s -
          LSeries (fun k => (ArithmeticFunction.vonMangoldt k : ℂ)) s) *
            xiCayleyEvolutionKernel x s) := by
  rw [xiWoldPoissonBivariateConormalResponse,
    xiCayleyEvolvedLogDeriv_eq_arithmetic x hs]

/-- Exact two-coordinate source packet.  At every fixed shell, the Poisson
clock has transverse rate `2 Re rho - 1`; the shell multiplier remains the
independent initial conormal coordinate. -/
theorem xiWoldPoissonBivariateConormalResidueMode_poisson_conservation
    (n : ℕ) {rho : ℂ} (tau : ℝ) (r : ℕ) (hrho : rho ≠ 1) :
    let x := HTGeometry.sourceCayleyObservationTime 1 rho tau
    x ^ r / r.factorial *
        ‖iteratedDeriv r
          (xiWoldPoissonBivariateConormalResidueMode n rho)
          (x : ℂ)‖ ^ (2 : ℕ) =
      ‖shellMultiplier n rho *
          ((analyticOrderAt xi rho).toNat : ℂ)‖ ^ (2 : ℕ) *
        Real.exp
          (HTGeometry.sourceCayleyTransverseRate 1 rho * tau) *
          HTGeometry.poissonOrderWeight tau r := by
  dsimp only
  have hmode :
      xiWoldPoissonBivariateConormalResidueMode n rho =
        HTGeometry.cayleyPoleResidueMode
          (shellMultiplier n rho *
            ((analyticOrderAt xi rho).toNat : ℂ))
          1 rho :=
    funext (xiWoldPoissonBivariateConormalResidueMode_eq n rho)
  rw [hmode]
  exact HTGeometry.sourceCayleyResidueMode_horizon_conservation
    (shellMultiplier n rho * ((analyticOrderAt xi rho).toNat : ℂ))
    1 rho tau r hrho

end

end RHTower
