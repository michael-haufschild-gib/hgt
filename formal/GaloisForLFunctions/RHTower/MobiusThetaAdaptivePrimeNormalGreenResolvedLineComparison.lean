import GaloisForLFunctions.RHTower.MobiusThetaAdaptivePrimeNormalHorizonIntertwiner
import GaloisForLFunctions.RHTower.MobiusThetaAdaptivePrimeNormalResolvedSector

/-!
# Green resolved-line comparison for the adaptive prime-normal source

The adaptive source now has two independent completed realizations: a
closed conservative two-channel `ell^(1 : ℕ)` sector and an exact Gaussian-graded
divisor field whose Green class detects RH.  This file constructs the
pointwise comparison demanded by the latest Hellinger--Hodge--Green descent
frontier.

For one prime label and one actual divisor copy, the scalar Green line is
sent canonically to the resolved adaptive source vector generated by that
prime basis element.  The comparison lands in the closed source sector and
is injective on the whole scalar line.  Its codiagonal is computed exactly:
it is the Green scalar times the nonzero adaptive codiagonal column.
Therefore its codiagonal vanishes exactly when the local Green fracture
vanishes, equivalently when that divisor copy lies on the critical line.

Thus two clauses of the source-pointed factorization—sector membership and
zero reflection/faithfulness—are unconditional constructions.  The sole
remaining clause is derivation of codiagonal vanishing from the arithmetic
source differential.  Globally, that clause for every divisor copy is
equivalent to RH; no range-identification or Hilbert-stability hypothesis
remains hidden in it.
-/

open Complex Function Set Topology
open GaloisForLFunctions.HTGeometry

namespace RHTower

noncomputable section

/-- Canonical comparison from one scalar Green line to the resolved adaptive
source sector at an actual divisor copy. -/
def adaptivePrimeNormalResolvedLineComparison
    (q : XiZeroCopy) (p : Nat.Primes) :
    ℂ →L[ℂ] (AdaptiveArithmeticL1 × AdaptiveArithmeticL1) :=
  (ContinuousLinearMap.id ℂ ℂ).smulRight
    (adaptivePrimeNormalResolvedSource
      (xiAdaptivePrimeNormalScale q)
      (xiSpectralPointSupport q.1)
      (xiAdaptivePrimeNormalScale_spec q)
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1))

@[simp]
theorem adaptivePrimeNormalResolvedLineComparison_apply
    (q : XiZeroCopy) (p : Nat.Primes) (c : ℂ) :
    adaptivePrimeNormalResolvedLineComparison q p c =
      c • adaptivePrimeNormalResolvedSource
        (xiAdaptivePrimeNormalScale q)
        (xiSpectralPointSupport q.1)
        (xiAdaptivePrimeNormalScale_spec q)
        (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) := by
  rw [adaptivePrimeNormalResolvedLineComparison,
    ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.id_apply]

/-- The canonical line comparison lands in the actual closed resolved source
sector, with no range assumption. -/
theorem adaptivePrimeNormalResolvedLineComparison_mem_sector
    (q : XiZeroCopy) (p : Nat.Primes) (c : ℂ) :
    adaptivePrimeNormalResolvedLineComparison q p c ∈
      adaptivePrimeNormalResolvedSector
        (xiAdaptivePrimeNormalScale q)
        (xiSpectralPointSupport q.1)
        (xiAdaptivePrimeNormalScale_spec q) := by
  refine ⟨c • lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1, ?_⟩
  rw [map_smul, adaptivePrimeNormalResolvedLineComparison_apply]
  rfl

/-- Its source codiagonal is exactly the scalar times the adaptive source
column. -/
theorem adaptivePrimeNormalResolvedLineComparison_codiagonal
    (q : XiZeroCopy) (p : Nat.Primes) (c : ℂ) :
    resolvedDefectCodiagonal (R := ℂ)
        (adaptivePrimeNormalResolvedLineComparison q p c) =
      c • adaptivePrimeNormalCodiagonal
        (xiAdaptivePrimeNormalScale q)
        (xiSpectralPointSupport q.1)
        (xiAdaptivePrimeNormalScale_spec q)
        (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) := by
  rw [adaptivePrimeNormalResolvedLineComparison_apply, map_smul,
    resolvedDefectCodiagonal_adaptivePrimeNormalResolvedSource]

theorem adaptivePrimeNormalCodiagonal_single_ne_zero
    (q : XiZeroCopy) (p : Nat.Primes) :
    adaptivePrimeNormalCodiagonal
      (xiAdaptivePrimeNormalScale q)
      (xiSpectralPointSupport q.1)
      (xiAdaptivePrimeNormalScale_spec q)
      (lp.single (E := fun _ : Nat.Primes => ℂ) 1 p 1) ≠ 0 := by
  intro hzero
  apply adaptivePrimeNormalDivisorReader_single_ne_zero q p
  rw [adaptivePrimeNormalDivisorReader,
    ContinuousLinearMap.comp_apply, hzero, map_zero]

/-- Exact zero fibre: source codiagonal of the comparison vanishes only on
the zero scalar. -/
theorem adaptivePrimeNormalResolvedLineComparison_codiagonal_eq_zero_iff
    (q : XiZeroCopy) (p : Nat.Primes) (c : ℂ) :
    resolvedDefectCodiagonal (R := ℂ)
        (adaptivePrimeNormalResolvedLineComparison q p c) = 0 ↔
      c = 0 := by
  rw [adaptivePrimeNormalResolvedLineComparison_codiagonal]
  constructor
  · intro hzero
    exact (smul_eq_zero.mp hzero).resolve_right
      (adaptivePrimeNormalCodiagonal_single_ne_zero q p)
  · rintro rfl
    exact zero_smul _ _

/-- The canonical comparison is faithful on the complete scalar Green line. -/
theorem adaptivePrimeNormalResolvedLineComparison_injective
    (q : XiZeroCopy) (p : Nat.Primes) :
    Function.Injective (adaptivePrimeNormalResolvedLineComparison q p) := by
  intro c d hcd
  have hzero : adaptivePrimeNormalResolvedLineComparison q p (c - d) = 0 := by
    rw [map_sub, hcd, sub_self]
  have hc : c - d = 0 := by
    apply (adaptivePrimeNormalResolvedLineComparison_codiagonal_eq_zero_iff
      q p (c - d)).mp
    rw [hzero, map_zero]
  exact sub_eq_zero.mp hc

namespace DeningerMeyerGaussianGreen

/-- Local Green coefficient carried by one exact adaptive horizon column. -/
def adaptivePrimeNormalHorizonGreenCoefficient
    (p : Nat.Primes) (q : XiZeroCopy) : ℂ :=
  adaptivePrimeNormalHorizonGreenProvenance p q

/-- The local adaptive Green coefficient vanishes exactly on the critical
line at that divisor copy. -/
theorem adaptivePrimeNormalHorizonGreenCoefficient_eq_zero_iff
    (p : Nat.Primes) (q : XiZeroCopy) :
    adaptivePrimeNormalHorizonGreenCoefficient p q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  have hright :
      deningerArithmeticOrientedHodgeLp
        (deningerArithmeticCompletedRieszConjugation
          (adaptivePrimeNormalHorizonColumn p)) q ≠ 0 := by
    rw [deningerArithmeticOrientedHodgeLp_apply,
      deningerArithmeticCompletedRieszConjugation_apply]
    apply mul_ne_zero
    · exact neg_ne_zero.mpr (deningerArithmeticFEOrientation_ne_zero q)
    · rw [starRingEnd_self_apply]
      exact adaptivePrimeNormalHorizonColumn_apply_ne_zero p
        (xiZeroCopyReflectEquiv q)
  rw [adaptivePrimeNormalHorizonGreenCoefficient,
    adaptivePrimeNormalHorizonGreenProvenance,
    deningerArithmeticCompletedGreenProvenance_apply]
  constructor
  · intro hzero
    exact (xiNearbyPoleDualityAdjunctionFracture_eq_zero_iff (q.1 : ℂ)).mp
      ((mul_eq_zero.mp hzero).resolve_right hright)
  · intro hline
    rw [(xiNearbyPoleDualityAdjunctionFracture_eq_zero_iff
      (q.1 : ℂ)).2 hline, zero_mul]

/-- Actual canonical factorization candidate for the local adaptive Green
coefficient. -/
def adaptivePrimeNormalActualGreenResolvedLineComparison
    (p : Nat.Primes) (q : XiZeroCopy) :
    AdaptiveArithmeticL1 × AdaptiveArithmeticL1 :=
  adaptivePrimeNormalResolvedLineComparison q p
    (adaptivePrimeNormalHorizonGreenCoefficient p q)

theorem adaptivePrimeNormalActualGreenResolvedLineComparison_mem_sector
    (p : Nat.Primes) (q : XiZeroCopy) :
    adaptivePrimeNormalActualGreenResolvedLineComparison p q ∈
      adaptivePrimeNormalResolvedSector
        (xiAdaptivePrimeNormalScale q)
        (xiSpectralPointSupport q.1)
        (xiAdaptivePrimeNormalScale_spec q) :=
  adaptivePrimeNormalResolvedLineComparison_mem_sector q p _

/-- The one remaining codiagonal clause is exactly the local critical-line
statement; landing and faithfulness have already been constructed. -/
theorem adaptivePrimeNormalActualGreenResolvedLineComparison_codiagonal_eq_zero_iff
    (p : Nat.Primes) (q : XiZeroCopy) :
    resolvedDefectCodiagonal (R := ℂ)
        (adaptivePrimeNormalActualGreenResolvedLineComparison p q) = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [adaptivePrimeNormalActualGreenResolvedLineComparison,
    adaptivePrimeNormalResolvedLineComparison_codiagonal_eq_zero_iff,
    adaptivePrimeNormalHorizonGreenCoefficient_eq_zero_iff]

theorem adaptivePrimeNormalActualGreenResolvedLineComparison_eq_zero_iff
    (p : Nat.Primes) (q : XiZeroCopy) :
    adaptivePrimeNormalActualGreenResolvedLineComparison p q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  constructor
  · intro hzero
    apply (adaptivePrimeNormalHorizonGreenCoefficient_eq_zero_iff p q).mp
    apply (adaptivePrimeNormalResolvedLineComparison_codiagonal_eq_zero_iff
      q p _).mp
    rw [adaptivePrimeNormalActualGreenResolvedLineComparison] at hzero
    rw [hzero, map_zero]
  · intro hline
    rw [adaptivePrimeNormalActualGreenResolvedLineComparison,
      (adaptivePrimeNormalHorizonGreenCoefficient_eq_zero_iff p q).2 hline,
      map_zero]

/-- Global form: the canonical resolved line comparisons have zero
codiagonal at every actual divisor copy exactly under RH. -/
theorem adaptivePrimeNormalActualGreenResolvedLineComparison_vanishes_iff_riemannHypothesis
    (p : Nat.Primes) :
    (∀ q : XiZeroCopy,
      resolvedDefectCodiagonal (R := ℂ)
        (adaptivePrimeNormalActualGreenResolvedLineComparison p q) = 0) ↔
      RiemannHypothesis := by
  constructor
  · intro hzero
    apply (adaptivePrimeNormalHorizonGreenProvenance_eq_zero_iff_riemannHypothesis p).mp
    ext q
    exact (adaptivePrimeNormalHorizonGreenCoefficient_eq_zero_iff p q).2
      ((adaptivePrimeNormalActualGreenResolvedLineComparison_codiagonal_eq_zero_iff
        p q).mp (hzero q))
  · intro hRH q
    exact (adaptivePrimeNormalActualGreenResolvedLineComparison_codiagonal_eq_zero_iff
      p q).2 (xi_divisor_support_re_eq_half_of_rh hRH q.1)

end DeningerMeyerGaussianGreen

end

end RHTower
