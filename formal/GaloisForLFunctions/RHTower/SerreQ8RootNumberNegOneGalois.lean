import GaloisForLFunctions.RHTower.SerreQ8RootNumberNegOneAutomorphisms
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.GroupTheory.SpecificGroups.Quaternion

/-!
# Galois normality of Serre's documented quaternionic field

This leaf proves normality of the degree-eight field generated by Serre's
published radical.  The input is not an assumed Galois action: it
constructs eight distinct `ℚ`-algebra automorphisms, indexed by the eight
elements of `QuaternionGroup 2`, from the concrete `I` and `J` radical lifts.
The finite automorphism bound and the already-proved degree then force
`IsGalois ℚ K`.

The next leaf packages the candidate enumeration as a group isomorphism
`Gal(K/ℚ) ≃* QuaternionGroup 2`.  Neither leaf calculates the Artin root
number: that separate global epsilon-factor calculation remains required to
formalize Serre's documented value `W(χ₅) = -1`.
-/

namespace RHTower

noncomputable section

local notation "K1" => deningerQ8RootNumberNegOneFirstQuadraticField
local notation "K2" => deningerQ8RootNumberNegOneSecondQuadraticField
local notation "K3" => SerreQ8TopField

noncomputable local instance serreQ8FiniteDimensionalK1K2 : FiniteDimensional K1 K2 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_secondQuadratic_irreducible.ne_zero).basis

noncomputable local instance serreQ8FiniteDimensionalK2K3 : FiniteDimensional K2 K3 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      serreQ8_thirdQuadratic_irreducible.ne_zero).basis

noncomputable local instance serreQ8FiniteDimensionalRatK2 : FiniteDimensional ℚ K2 :=
  FiniteDimensional.trans ℚ K1 K2

noncomputable local instance serreQ8FiniteDimensionalRatK3 : FiniteDimensional ℚ K3 :=
  FiniteDimensional.trans ℚ K2 K3

theorem serreQ8C_bijective : Function.Bijective serreQ8C := by
  constructor
  · intro a b hab
    have h := congrArg (fun f : K3 →+* K3 => f a = f b) serreQ8C_sq_eq_id
    simpa [RingHom.comp_apply, hab] using h
  · intro w
    refine ⟨serreQ8C w, ?_⟩
    have h := congrArg (fun f : K3 →+* K3 => f w) serreQ8C_sq_eq_id
    simpa [RingHom.comp_apply] using h

noncomputable def serreQ8CEquiv : K3 ≃+* K3 := RingEquiv.ofBijective serreQ8C serreQ8C_bijective

theorem serreQ8I_fourth_apply (w : K3) :
    serreQ8I (serreQ8I (serreQ8I (serreQ8I w))) = w := by
  have hI (v : K3) : serreQ8I (serreQ8I v) = serreQ8C v := by
    exact congrArg (fun h : K3 →+* K3 => h v) serreQ8I_sq_eq_C
  have hC (v : K3) : serreQ8C (serreQ8C v) = v := by
    have hc := congrArg (fun h : K3 →+* K3 => h v) serreQ8C_sq_eq_id
    simpa [RingHom.comp_apply] using hc
  calc
    serreQ8I (serreQ8I (serreQ8I (serreQ8I w))) = serreQ8C (serreQ8I (serreQ8I w)) :=
      hI _
    _ = serreQ8C (serreQ8C w) := by rw [hI w]
    _ = w := hC w

theorem serreQ8J_fourth_apply (w : K3) :
    serreQ8J (serreQ8J (serreQ8J (serreQ8J w))) = w := by
  have hJ (v : K3) : serreQ8J (serreQ8J v) = serreQ8C v := by
    exact congrArg (fun h : K3 →+* K3 => h v) serreQ8J_sq_eq_C
  have hC (v : K3) : serreQ8C (serreQ8C v) = v := by
    have hc := congrArg (fun h : K3 →+* K3 => h v) serreQ8C_sq_eq_id
    simpa [RingHom.comp_apply] using hc
  calc
    serreQ8J (serreQ8J (serreQ8J (serreQ8J w))) = serreQ8C (serreQ8J (serreQ8J w)) :=
      hJ _
    _ = serreQ8C (serreQ8C w) := by rw [hJ w]
    _ = w := hC w

theorem serreQ8I_bijective : Function.Bijective serreQ8I := by
  constructor
  · intro a b hab
    calc
      a = serreQ8I (serreQ8I (serreQ8I (serreQ8I a))) := (serreQ8I_fourth_apply a).symm
      _ = serreQ8I (serreQ8I (serreQ8I (serreQ8I b))) := by rw [hab]
      _ = b := serreQ8I_fourth_apply b
  · intro w
    refine ⟨serreQ8I (serreQ8I (serreQ8I w)), ?_⟩
    exact serreQ8I_fourth_apply w

theorem serreQ8J_bijective : Function.Bijective serreQ8J := by
  constructor
  · intro a b hab
    calc
      a = serreQ8J (serreQ8J (serreQ8J (serreQ8J a))) := (serreQ8J_fourth_apply a).symm
      _ = serreQ8J (serreQ8J (serreQ8J (serreQ8J b))) := by rw [hab]
      _ = b := serreQ8J_fourth_apply b
  · intro w
    refine ⟨serreQ8J (serreQ8J (serreQ8J w)), ?_⟩
    exact serreQ8J_fourth_apply w

noncomputable def serreQ8IEquiv : K3 ≃+* K3 :=
  RingEquiv.ofBijective serreQ8I serreQ8I_bijective

noncomputable def serreQ8JEquiv : K3 ≃+* K3 :=
  RingEquiv.ofBijective serreQ8J serreQ8J_bijective

noncomputable def serreQ8IAlgEquiv : K3 ≃ₐ[ℚ] K3 where
  __ := serreQ8IEquiv
  commutes' q := serreQ8I_rat q

noncomputable def serreQ8JAlgEquiv : K3 ≃ₐ[ℚ] K3 where
  __ := serreQ8JEquiv
  commutes' q := serreQ8J_rat q

noncomputable def serreQ8CAlgEquiv : K3 ≃ₐ[ℚ] K3 where
  __ := serreQ8CEquiv
  commutes' q := serreQ8C_rat q

theorem serreQ8IAlgEquiv_apply (w : K3) : serreQ8IAlgEquiv w = serreQ8I w := rfl
theorem serreQ8JAlgEquiv_apply (w : K3) : serreQ8JAlgEquiv w = serreQ8J w := rfl
theorem serreQ8CAlgEquiv_apply (w : K3) : serreQ8CAlgEquiv w = serreQ8C w := rfl

theorem serreQ8IAlgEquiv_sq_eq_serreQ8CAlgEquiv : serreQ8IAlgEquiv ^ 2 = serreQ8CAlgEquiv := by
  ext w
  change serreQ8I (serreQ8I w) = serreQ8C w
  exact congrArg (fun f : K3 →+* K3 => f w) serreQ8I_sq_eq_C

theorem serreQ8CAlgEquiv_sq_eq_one : serreQ8CAlgEquiv ^ 2 = 1 := by
  ext w
  change serreQ8C (serreQ8C w) = w
  have h := congrArg (fun f : K3 →+* K3 => f w) serreQ8C_sq_eq_id
  simpa [RingHom.comp_apply] using h

theorem serreQ8IAlgEquiv_fourth_eq_one : serreQ8IAlgEquiv ^ 4 = 1 := by
  calc
    serreQ8IAlgEquiv ^ 4 = serreQ8IAlgEquiv ^ 2 * serreQ8IAlgEquiv ^ 2 := by
      rw [show 4 = 2 + 2 by norm_num, pow_add]
    _ = serreQ8CAlgEquiv * serreQ8CAlgEquiv := by
      rw [serreQ8IAlgEquiv_sq_eq_serreQ8CAlgEquiv]
    _ = serreQ8CAlgEquiv ^ 2 := by rw [pow_two]
    _ = 1 := serreQ8CAlgEquiv_sq_eq_one

theorem serreQ8IAlgEquiv_sq_ne_one : serreQ8IAlgEquiv ^ 2 ≠ 1 := by
  intro h
  letI : CharZero K3 :=
    charZero_of_injective_algebraMap (algebraMap ℚ K3).injective
  have hroot := congrArg
    (fun f : K3 ≃ₐ[ℚ] K3 => f serreQ8TopRoot) h
  change serreQ8I (serreQ8I serreQ8TopRoot) =
    serreQ8TopRoot at hroot
  rw [serreQ8I_root, serreQ8I_candidate] at hroot
  apply serreQ8TopRoot_ne_zero
  have hsum : serreQ8TopRoot +
      serreQ8TopRoot = 0 :=
    neg_eq_iff_add_eq_zero.mp hroot
  have htwice : (2 : K3) * serreQ8TopRoot = 0 := by
    rw [two_mul]
    exact hsum
  exact (mul_eq_zero.mp htwice).resolve_left (by norm_num)

theorem serreQ8_orderOf_I : orderOf serreQ8IAlgEquiv = 4 := by
  change orderOf serreQ8IAlgEquiv = 2 ^ 2
  apply orderOf_eq_prime_pow
  · simpa using serreQ8IAlgEquiv_sq_ne_one
  · simpa using serreQ8IAlgEquiv_fourth_eq_one

noncomputable def serreQ8IAlgPow (i : ZMod 4) : K3 ≃ₐ[ℚ] K3 := serreQ8IAlgEquiv ^ i.val

theorem serreQ8IAlgPow_injective : Function.Injective serreQ8IAlgPow := by
  intro i j hij
  have hpow : serreQ8IAlgEquiv ^ i.val = serreQ8IAlgEquiv ^ j.val := hij
  have hmod : i.val % 4 = j.val % 4 := by
    have h := (pow_eq_pow_iff_modEq.mp hpow)
    simpa [Nat.ModEq, serreQ8_orderOf_I] using h
  apply ZMod.val_injective 4
  rw [← Nat.mod_eq_of_lt (ZMod.val_lt i), ← Nat.mod_eq_of_lt (ZMod.val_lt j)]
  exact hmod

theorem serreQ8IAlgEquiv_topY :
    serreQ8IAlgEquiv serreQ8TopY =
      serreQ8TopY := by
  exact serreQ8I_topY

theorem serreQ8IAlgPow_topY (i : ZMod 4) :
    serreQ8IAlgPow i serreQ8TopY =
      serreQ8TopY := by
  unfold serreQ8IAlgPow
  induction i.val with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, AlgEquiv.mul_apply, serreQ8IAlgEquiv_topY, ih]

/-- The eight explicit `Q₈`-labelled automorphisms of Serre's field. -/
noncomputable def serreQ8AutCandidate : QuaternionGroup 2 → Gal(K3/ℚ)
  | .a i => serreQ8IAlgPow i
  | .xa i => (serreQ8IAlgPow i).trans serreQ8JAlgEquiv

theorem serreQ8AutCandidate_injective : Function.Injective serreQ8AutCandidate := by
  intro g h hgh
  rcases g with i | i <;> rcases h with j | j
  · change serreQ8IAlgPow i = serreQ8IAlgPow j at hgh
    exact congrArg QuaternionGroup.a (serreQ8IAlgPow_injective hgh)
  · exfalso
    have htop := congrArg
      (fun f : Gal(K3/ℚ) => f serreQ8TopY) hgh
    change serreQ8IAlgPow i serreQ8TopY =
      serreQ8JAlgEquiv (serreQ8IAlgPow j serreQ8TopY) at htop
    rw [serreQ8IAlgPow_topY, serreQ8IAlgPow_topY, serreQ8JAlgEquiv_apply, serreQ8J_topY] at htop
    apply serreQ8TopY_ne_zero
    have hsum : serreQ8TopY +
        serreQ8TopY = 0 :=
      eq_neg_iff_add_eq_zero.mp htop
    have htwice : (2 : K3) * serreQ8TopY = 0 := by
      rw [two_mul]
      exact hsum
    exact (mul_eq_zero.mp htwice).resolve_left (by
      letI : CharZero K3 :=
        charZero_of_injective_algebraMap (algebraMap ℚ K3).injective
      norm_num)
  · exfalso
    have htop := congrArg
      (fun f : Gal(K3/ℚ) => f serreQ8TopY) hgh
    change serreQ8JAlgEquiv (serreQ8IAlgPow i serreQ8TopY) =
      serreQ8IAlgPow j serreQ8TopY at htop
    rw [serreQ8IAlgPow_topY, serreQ8IAlgPow_topY, serreQ8JAlgEquiv_apply, serreQ8J_topY] at htop
    apply serreQ8TopY_ne_zero
    have hsum : serreQ8TopY +
        serreQ8TopY = 0 :=
      neg_eq_iff_add_eq_zero.mp htop
    have htwice : (2 : K3) * serreQ8TopY = 0 := by
      rw [two_mul]
      exact hsum
    exact (mul_eq_zero.mp htwice).resolve_left (by
      letI : CharZero K3 :=
        charZero_of_injective_algebraMap (algebraMap ℚ K3).injective
      norm_num)
  · apply congrArg QuaternionGroup.xa
    apply serreQ8IAlgPow_injective
    apply AlgEquiv.ext
    intro w
    apply serreQ8JAlgEquiv.injective
    have hw := congrArg (fun f : Gal(K3/ℚ) => f w) hgh
    change serreQ8JAlgEquiv (serreQ8IAlgPow i w) = serreQ8JAlgEquiv (serreQ8IAlgPow j w) at hw
    exact hw

theorem serreQ8Aut_card_eq_eight : Fintype.card Gal(K3/ℚ) = 8 := by
  apply Nat.le_antisymm
  · calc
      Fintype.card Gal(K3/ℚ) ≤ Module.finrank ℚ K3 := AlgEquiv.card_le
      _ = 8 := serreQ8TopField_finrank_over_rat
  · have hle := Fintype.card_le_of_injective _ serreQ8AutCandidate_injective
    rw [QuaternionGroup.card] at hle
    norm_num at hle ⊢
    exact hle

theorem serreQ8Aut_natCard_eq_eight : Nat.card Gal(K3/ℚ) = 8 := by
  rw [Nat.card_eq_fintype_card]
  exact serreQ8Aut_card_eq_eight

/-- Serre's degree-eight radical field is Galois over `ℚ`. -/
theorem serreQ8_isGalois : IsGalois ℚ K3 := by
  apply IsGalois.of_card_aut_eq_finrank
  rw [serreQ8Aut_natCard_eq_eight, serreQ8TopField_finrank_over_rat]

end

end RHTower
