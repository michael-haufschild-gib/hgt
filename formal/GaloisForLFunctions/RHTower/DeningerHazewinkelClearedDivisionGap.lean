import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# The cleared-coefficient division gap in Hazewinkel Appendix A.2

Hazewinkel's printed exponent descent uses the implicit assertion that division by the pivot
preserves a coefficient algebra generated by a scaled tail coordinate. This module gives the
unconditional symbolic counterexample: in `ℤ[D,Z]`, the subring `ℤ[D,DZ]` contains `DZ`, and `D`
divides `DZ` in the ambient polynomial ring, but the quotient `Z` is not in that subring.

No statement about the truth of the Hankel primeness theorem is negated. The theorem below isolates
the exact invalid closure step, requiring a Gröbner/straightening replacement proof.
-/

namespace RHTower
noncomputable section

open MvPolynomial

/-- Symbolic two-coordinate ambient ring; coordinate `0` is the pivot and coordinate `1` the tail. -/
abbrev HazewinkelClearedGapRing := MvPolynomial (Fin 2) ℤ

/-- Parametrization of the cleared coefficient algebra `ℤ[D,DZ] ⊂ ℤ[D,Z]`. -/
def hazewinkelClearedScaledTail :
    HazewinkelClearedGapRing →+* HazewinkelClearedGapRing :=
  MvPolynomial.eval₂Hom MvPolynomial.C fun i =>
    if i = 0 then MvPolynomial.X 0 else MvPolynomial.X 0 * MvPolynomial.X 1

/-- Specialization to the pivot divisor `D=0`. -/
def hazewinkelClearedKillPivot :
    HazewinkelClearedGapRing →+* HazewinkelClearedGapRing :=
  MvPolynomial.eval₂Hom MvPolynomial.C fun i =>
    if i = 0 then 0 else MvPolynomial.X 1

@[simp] theorem hazewinkelClearedScaledTail_X_zero :
    hazewinkelClearedScaledTail (MvPolynomial.X 0) = MvPolynomial.X 0 := by
  simp [hazewinkelClearedScaledTail]

@[simp] theorem hazewinkelClearedScaledTail_X_one :
    hazewinkelClearedScaledTail (MvPolynomial.X 1) =
      MvPolynomial.X 0 * MvPolynomial.X 1 := by
  simp [hazewinkelClearedScaledTail, show (1 : Fin 2) ≠ 0 by omega]

theorem hazewinkelClearedKillPivot_comp_scaledTail :
    hazewinkelClearedKillPivot.comp hazewinkelClearedScaledTail =
      MvPolynomial.eval₂Hom MvPolynomial.C
        (0 : Fin 2 → HazewinkelClearedGapRing) := by
  apply MvPolynomial.ringHom_ext
  · intro z
    simp [hazewinkelClearedKillPivot, hazewinkelClearedScaledTail]
  · intro i
    fin_cases i <;> simp [hazewinkelClearedKillPivot, hazewinkelClearedScaledTail]

/-- The unscaled tail coordinate does not belong to `ℤ[D,DZ]`. -/
theorem hazewinkelCleared_X_one_not_mem_range :
    MvPolynomial.X 1 ∉ RingHom.range hazewinkelClearedScaledTail := by
  rintro ⟨p, hp⟩
  have h := congrArg hazewinkelClearedKillPivot hp
  rw [← RingHom.comp_apply, hazewinkelClearedKillPivot_comp_scaledTail,
    MvPolynomial.eval₂Hom_zero_apply] at h
  simp [hazewinkelClearedKillPivot, show (1 : Fin 2) ≠ 0 by omega] at h
  have h' : MvPolynomial.C (MvPolynomial.constantCoeff p) =
      (MvPolynomial.X 1 : HazewinkelClearedGapRing) := h
  have hc := congrArg
    (MvPolynomial.coeff (Finsupp.single (1 : Fin 2) 1)) h'
  have hne : (0 : Fin 2 →₀ ℕ) ≠ Finsupp.single (1 : Fin 2) 1 := by
    intro heq
    have := congrArg (fun q : Fin 2 →₀ ℕ => q (1 : Fin 2)) heq
    simp at this
  rw [MvPolynomial.coeff_C, MvPolynomial.coeff_X] at hc
  simp [hne] at hc

/-- **Exact closure counterexample.** `DZ` lies in the cleared coefficient algebra and is divisible
by `D` ambiently, while its quotient `Z` exits that algebra. -/
theorem hazewinkelCleared_division_exits_range :
    (MvPolynomial.X 0 * MvPolynomial.X 1 : HazewinkelClearedGapRing) ∈
        RingHom.range hazewinkelClearedScaledTail ∧
      (MvPolynomial.X 0 : HazewinkelClearedGapRing) ∣
        MvPolynomial.X 0 * MvPolynomial.X 1 ∧
      (MvPolynomial.X 1 : HazewinkelClearedGapRing) ∉
        RingHom.range hazewinkelClearedScaledTail := by
  refine ⟨⟨(MvPolynomial.X 1 : HazewinkelClearedGapRing),
      hazewinkelClearedScaledTail_X_one⟩,
    ⟨(MvPolynomial.X 1 : HazewinkelClearedGapRing), rfl⟩,
    hazewinkelCleared_X_one_not_mem_range⟩

end
end RHTower
