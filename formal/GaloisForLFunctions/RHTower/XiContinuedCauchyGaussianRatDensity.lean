import GaloisForLFunctions.RHTower.XiContinuedCauchyPacketDensity
import GaloisForLFunctions.RHTower.PrimeArchAntiHerglotzGate

/-!
# Gaussian-rational density in the continued Xi Cauchy source core

The analytically continued prime--Gamma Cauchy source core is generated by an uncountable family
of regular poles in the centered strip.  Gaussian-rational poles already generate the same Hilbert
closure.  The proof chooses a rational pole in every shrinking open ball, retains regularity and
the two-sided source domain by openness, and uses the existing norm continuity of the Xi-divisor
Cauchy evaluation map.

This theorem is independent of RH and of any sign condition.  It is a general countabilization
bridge for every source-core criterion built on the continued Cauchy family.
-/

open Complex Metric Filter Topology Set
open scoped Topology

namespace RHTower

noncomputable section

/-- Exact geometric description of the two-sided continued prime--Gamma Cauchy domain: it is the
regular locus of `XiC` inside the centered open strip. -/
theorem ccmContinuedCauchyDomain_iff_regular_mem_centeredStrip
    {z : ℂ} :
    CCMContinuedCauchyDomain z ↔
      -(1 / 2 : ℝ) < z.im ∧ z.im < 1 / 2 ∧ XiC z ≠ 0 := by
  constructor
  · intro hz
    have hzlo : -(1 / 2 : ℝ) < z.im := by
      have h := hz.2.2.2.1
      simp [mul_re] at h
      linarith
    have hzhi : z.im < 1 / 2 := by
      have h := hz.1
      simp [mul_re] at h
      linarith
    exact ⟨hzlo, hzhi,
      XiC_ne_zero_of_continuedPrimeArch_domain hz.1 hz.2.1 hz.2.2.1⟩
  · rintro ⟨hzlo, hzhi, hz⟩
    exact ccmContinuedCauchyDomain_of_regular_mem_centeredStrip hzlo hzhi hz

/-- A Gaussian-rational pole that is regular for `XiC` and lies in the centered open strip. -/
abbrev XiGaussianRatContinuedCauchyPoint :=
  {q : ℚ × ℚ //
    -(1 / 2 : ℝ) < (gaussianRatPoint q).im ∧
      (gaussianRatPoint q).im < 1 / 2 ∧
      XiC (gaussianRatPoint q) ≠ 0}

/-- A Gaussian-rational centered-strip pole as a genuine point of the analytically continued
prime--Gamma Cauchy domain. -/
def xiGaussianRatContinuedCauchyPoint
    (q : XiGaussianRatContinuedCauchyPoint) : XiContinuedCauchyPoint :=
  ⟨⟨gaussianRatPoint q, q.property.2.2⟩,
    ccmContinuedCauchyDomain_of_regular_mem_centeredStrip
      q.property.1 q.property.2.1 q.property.2.2⟩

/-- The Xi-divisor Cauchy vector at a regular Gaussian-rational pole. -/
def xiWeilGaussianRatContinuedCauchyLp
    (q : XiGaussianRatContinuedCauchyPoint) :
    lp (fun _ : XiZeroCopy => ℂ) 2 :=
  xiWeilContinuedCauchyLp (xiGaussianRatContinuedCauchyPoint q)

/-- Algebraic span of the countable Gaussian-rational continued-Cauchy source family. -/
def xiWeilGaussianRatContinuedCauchyAlgebraicSubspace :
    Submodule ℂ (lp (fun _ : XiZeroCopy => ℂ) 2) :=
  Submodule.span ℂ (Set.range xiWeilGaussianRatContinuedCauchyLp)

/-- The Gaussian-rational algebraic source span is contained in the full continued-Cauchy span. -/
theorem xiWeilGaussianRatContinuedCauchyAlgebraicSubspace_le :
    xiWeilGaussianRatContinuedCauchyAlgebraicSubspace ≤
      xiWeilContinuedCauchyAlgebraicSubspace := by
  apply Submodule.span_le.mpr
  rintro _ ⟨q, rfl⟩
  exact Submodule.subset_span ⟨xiGaussianRatContinuedCauchyPoint q, rfl⟩

/-- The regular centered strip is open. -/
theorem isOpen_xiRegularCenteredStrip :
    IsOpen {z : ℂ |
      -(1 / 2 : ℝ) < z.im ∧ z.im < 1 / 2 ∧ XiC z ≠ 0} := by
  have hlo : IsOpen {z : ℂ | -(1 / 2 : ℝ) < z.im} :=
    isOpen_lt continuous_const Complex.continuous_im
  have hhi : IsOpen {z : ℂ | z.im < 1 / 2} :=
    isOpen_lt Complex.continuous_im continuous_const
  have hregular : IsOpen {z : ℂ | XiC z ≠ 0} := by
    exact isOpen_ne.preimage XiC_analytic.continuous
  change IsOpen
    ({z : ℂ | -(1 / 2 : ℝ) < z.im} ∩
      ({z : ℂ | z.im < 1 / 2} ∩ {z : ℂ | XiC z ≠ 0}))
  exact hlo.inter (hhi.inter hregular)

/-- Every continued-source Cauchy vector is the norm limit of a sequence drawn only from the
countable Gaussian-rational continued-source family. -/
theorem exists_gaussianRatContinuedCauchyLp_tendsto
    (z : XiContinuedCauchyPoint) :
    ∃ q : ℕ → XiGaussianRatContinuedCauchyPoint,
      Tendsto (fun n ↦ gaussianRatPoint (q n : ℚ × ℚ)) atTop (nhds (z : ℂ)) ∧
      Tendsto (fun n ↦ xiWeilGaussianRatContinuedCauchyLp (q n)) atTop
        (nhds (xiWeilContinuedCauchyLp z)) := by
  let U : Set ℂ := {w : ℂ |
    -(1 / 2 : ℝ) < w.im ∧ w.im < 1 / 2 ∧ XiC w ≠ 0}
  have hzlo : -(1 / 2 : ℝ) < (z : ℂ).im := by
    have h := z.property.2.2.2.1
    simp [mul_re] at h
    linarith
  have hzhi : (z : ℂ).im < 1 / 2 := by
    have h := z.property.1
    simp [mul_re] at h
    linarith
  have hzU : (z : ℂ) ∈ U := ⟨hzlo, hzhi, z.1.property⟩
  have hUopen : IsOpen U := isOpen_xiRegularCenteredStrip
  have hexists : ∀ n : ℕ, ∃ q : ℚ × ℚ,
      gaussianRatPoint q ∈ U ∩
        Metric.ball (z : ℂ) (continuedCauchyPacketEpsilon n) := by
    intro n
    apply denseRange_gaussianRatPoint.exists_mem_open
      (hUopen.inter Metric.isOpen_ball)
    exact ⟨(z : ℂ), hzU, Metric.mem_ball_self
      (continuedCauchyPacketEpsilon_pos n)⟩
  choose q hq using hexists
  let qr : ℕ → XiGaussianRatContinuedCauchyPoint := fun n ↦
    ⟨q n, (hq n).1⟩
  have hpoint : Tendsto
      (fun n ↦ gaussianRatPoint (qr n : ℚ × ℚ)) atTop
      (nhds (z : ℂ)) := by
    apply Metric.tendsto_atTop.mpr
    intro ε hε
    have heventually : ∀ᶠ n in atTop, continuedCauchyPacketEpsilon n < ε :=
      (tendsto_order.mp tendsto_continuedCauchyPacketEpsilon).2 ε hε
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 heventually
    refine ⟨N, fun n hn ↦ ?_⟩
    exact (Metric.mem_ball.mp (hq n).2).trans (hN n hn)
  refine ⟨qr, hpoint, ?_⟩
  change Tendsto
    (fun n ↦ xiWeilCauchyLp
      ((xiGaussianRatContinuedCauchyPoint (qr n)).1)) atTop
    (nhds (xiWeilCauchyLp z.1))
  exact tendsto_xiWeilCauchyLp hpoint

/-- Every full continued-Cauchy generator lies in the Hilbert closure of the countable
Gaussian-rational algebraic source span. -/
theorem xiWeilContinuedCauchyLp_mem_gaussianRatClosure
    (z : XiContinuedCauchyPoint) :
    xiWeilContinuedCauchyLp z ∈
      xiWeilGaussianRatContinuedCauchyAlgebraicSubspace.topologicalClosure := by
  obtain ⟨q, _hpoint, hlim⟩ :=
    exists_gaussianRatContinuedCauchyLp_tendsto z
  apply (Submodule.isClosed_topologicalClosure
    xiWeilGaussianRatContinuedCauchyAlgebraicSubspace).mem_of_tendsto hlim
  exact Eventually.of_forall fun n ↦
    xiWeilGaussianRatContinuedCauchyAlgebraicSubspace.le_topologicalClosure
      (Submodule.subset_span ⟨q n, rfl⟩)

/-- **Countable source-core theorem.**  Gaussian-rational regular poles generate exactly the same
Hilbert closure as the full analytically continued Cauchy source family. -/
theorem gaussianRatContinuedCauchy_topologicalClosure_eq :
    xiWeilGaussianRatContinuedCauchyAlgebraicSubspace.topologicalClosure =
      xiWeilContinuedCauchyHilbertSubspace := by
  apply le_antisymm
  · exact Submodule.topologicalClosure_mono
      xiWeilGaussianRatContinuedCauchyAlgebraicSubspace_le
  · apply Submodule.topologicalClosure_minimal
    · apply Submodule.span_le.mpr
      rintro _ ⟨z, rfl⟩
      exact xiWeilContinuedCauchyLp_mem_gaussianRatClosure z
    · exact Submodule.isClosed_topologicalClosure _

end

end RHTower
