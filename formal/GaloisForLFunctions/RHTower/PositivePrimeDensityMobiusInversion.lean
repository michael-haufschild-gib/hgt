/-!
# Exact positive prime-density inversion

The prime-power density of a continuous generalized prime measure is the weighted
Lambert transform

`T p (u) = Σ_(n ≥ 1) n⁻² p(u / n)`.

This file proves that the logarithmic Möbius series is its exact inverse whenever
the source density is nonnegative and nondecreasing.  Absolute summability is
proved before the antidiagonal regrouping.  Combined with monotone Möbius
positivity, this turns a positive monotone prime-power density into an actual
nonnegative generalized-prime density, not merely a positive von Mangoldt
density.
-/

open Filter MeasureTheory

noncomputable section

namespace RHTower

open ArithmeticFunction Nat
open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry
open scoped BigOperators

/-- The prime-power density generated by a logarithmic prime density. -/
def primePowerDensityTransform (p : ℝ → ℝ) (u : ℝ) : ℝ :=
  ∑' n : ℕ+, 1 / (n : ℝ) ^ 2 * p (u / n)

/-- The positive-index version of logarithmic Möbius inversion. -/
def positiveMobiusPrimeDensity (g : ℝ → ℝ) (u : ℝ) : ℝ :=
  ∑' k : ℕ+, (moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)

/-- The absolutely summable pair used to justify Lambert--Möbius regrouping. -/
def primeDensityMobiusPair (g : ℝ → ℝ) (u : ℝ)
    (c : ℕ+ × ℕ+) : ℝ :=
  1 / (c.1 : ℝ) ^ 2 *
    ((moebius c.2 : ℝ) / (c.2 : ℝ) ^ 2 *
      g (u / ((c.1 : ℝ) * (c.2 : ℝ))))

private theorem pnat_zeta_two_summable :
    Summable (fun n : ℕ+ => 1 / (n : ℝ) ^ 2) := by
  exact hasSum_zeta_two.summable.comp_injective Subtype.val_injective

private theorem primeDensityMobiusPair_norm_le
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) (c : ℕ+ × ℕ+) :
    ‖primeDensityMobiusPair g u c‖ ≤
      g u * (1 / (c.1 : ℝ) ^ 2) * (1 / (c.2 : ℝ) ^ 2) := by
  have hn : (0 : ℝ) < (c.1 : ℝ) := by positivity
  have hk : (0 : ℝ) < (c.2 : ℝ) := by positivity
  have hnk : (1 : ℝ) ≤ (c.1 : ℝ) * (c.2 : ℝ) := by
    have hn1 : (1 : ℝ) ≤ (c.1 : ℝ) := by exact_mod_cast c.1.property
    have hk1 : (1 : ℝ) ≤ (c.2 : ℝ) := by exact_mod_cast c.2.property
    nlinarith
  have harg : u / ((c.1 : ℝ) * (c.2 : ℝ)) ≤ u := by
    rw [div_le_iff₀ (mul_pos hn hk)]
    nlinarith
  have hgarg : g (u / ((c.1 : ℝ) * (c.2 : ℝ))) ≤ g u :=
    hmono harg
  have hmu : |(moebius c.2 : ℝ)| ≤ 1 := by
    have h := abs_moebius_le_one (n := c.2)
    calc
      |(moebius c.2 : ℝ)| = ((|moebius c.2| : ℤ) : ℝ) := by
        push_cast
        simp
      _ ≤ ((1 : ℤ) : ℝ) := by exact_mod_cast h
      _ = 1 := by norm_num
  rw [primeDensityMobiusPair, Real.norm_eq_abs, abs_mul, abs_mul,
    abs_div, abs_div, abs_of_nonneg (hg0 _),
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ (c.1 : ℝ) ^ 2),
    abs_of_nonneg (by positivity : (0 : ℝ) ≤ (c.2 : ℝ) ^ 2)]
  simp only [abs_one]
  calc
    1 / (c.1 : ℝ) ^ 2 *
          (|(moebius c.2 : ℝ)| / (c.2 : ℝ) ^ 2 *
            g (u / ((c.1 : ℝ) * (c.2 : ℝ)))) ≤
        1 / (c.1 : ℝ) ^ 2 *
          (1 / (c.2 : ℝ) ^ 2 * g u) := by
            gcongr
            exact hg0 _
    _ = g u * (1 / (c.1 : ℝ) ^ 2) *
          (1 / (c.2 : ℝ) ^ 2) := by ring

theorem primeDensityMobiusPair_summable
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    Summable (primeDensityMobiusPair g u) := by
  have hz := pnat_zeta_two_summable
  have hprod :
      Summable (fun c : ℕ+ × ℕ+ =>
        (1 / (c.1 : ℝ) ^ 2) * (1 / (c.2 : ℝ) ^ 2)) :=
    hz.mul_of_nonneg hz (fun _ => by positivity) (fun _ => by positivity)
  have hmajor :
      Summable (fun c : ℕ+ × ℕ+ =>
        g u * (1 / (c.1 : ℝ) ^ 2) * (1 / (c.2 : ℝ) ^ 2)) := by
    simpa [mul_assoc] using hprod.mul_left (g u)
  exact Summable.of_norm_bounded hmajor
    (primeDensityMobiusPair_norm_le hg0 hmono hu)

private theorem sum_moebius_second_divisorsAntidiagonal (b : ℕ+) :
    (∑ x : (b : ℕ).divisorsAntidiagonal,
      moebius x.1.2) = if b = 1 then 1 else 0 := by
  rw [show
      (∑ x : (b : ℕ).divisorsAntidiagonal, moebius x.1.2) =
        ∑ x ∈ (b : ℕ).divisorsAntidiagonal, moebius x.2 from by
          simpa only [Finset.univ_eq_attach] using
            ((b : ℕ).divisorsAntidiagonal.sum_attach
              (fun x => moebius x.2))]
  rw [Nat.sum_divisorsAntidiagonal (f := fun _ j => moebius j)]
  simpa using sum_moebius_divisors (b : ℕ)

private theorem primeDensityMobius_antidiagonal
    (g : ℝ → ℝ) (u : ℝ) (b : ℕ+) :
    (∑ x : (b : ℕ).divisorsAntidiagonal,
      primeDensityMobiusPair g u (divisorsAntidiagonalFactors b x)) =
      if b = 1 then g u else 0 := by
  classical
  have hterm (x : (b : ℕ).divisorsAntidiagonal) :
      primeDensityMobiusPair g u (divisorsAntidiagonalFactors b x) =
        (moebius x.1.2 : ℝ) / (b : ℝ) ^ 2 * g (u / b) := by
    let d := divisorsAntidiagonalFactors b x
    have hval : d.1.1 * d.2.1 = (b : ℕ) :=
      divisorsAntidiagonalFactors_eq x
    have hprod : d.1 * d.2 = b := Subtype.ext hval
    have hcast : (d.1 : ℝ) * (d.2 : ℝ) = (b : ℝ) := by
      change ((d.1.1 : ℕ) : ℝ) * ((d.2.1 : ℕ) : ℝ) =
        ((b.1 : ℕ) : ℝ)
      exact_mod_cast hval
    change
      1 / (d.1 : ℝ) ^ 2 *
          ((moebius d.2 : ℝ) / (d.2 : ℝ) ^ 2 *
            g (u / ((d.1 : ℝ) * (d.2 : ℝ)))) =
        (moebius d.2 : ℝ) / (b : ℝ) ^ 2 * g (u / b)
    have hd1 : (d.1 : ℝ) ≠ 0 := by positivity
    have hd2 : (d.2 : ℝ) ≠ 0 := by positivity
    have hb : (b : ℝ) ≠ 0 := by positivity
    calc
      1 / (d.1 : ℝ) ^ 2 *
            ((moebius d.2 : ℝ) / (d.2 : ℝ) ^ 2 *
              g (u / ((d.1 : ℝ) * (d.2 : ℝ)))) =
          (moebius d.2 : ℝ) /
              ((d.1 : ℝ) * (d.2 : ℝ)) ^ 2 *
            g (u / ((d.1 : ℝ) * (d.2 : ℝ))) := by
              field_simp
      _ = (moebius d.2 : ℝ) / (b : ℝ) ^ 2 * g (u / b) := by
        rw [hcast]
  simp_rw [hterm]
  rw [← Finset.sum_mul, ← Finset.sum_div]
  have hmuR :
      (∑ x : (b : ℕ).divisorsAntidiagonal, (moebius x.1.2 : ℝ)) =
        if b = 1 then 1 else 0 := by
    rw [← Int.cast_sum, sum_moebius_second_divisorsAntidiagonal b]
    split_ifs <;> simp
  rw [hmuR]
  split_ifs with hb
  · subst b
    norm_num
  · simp

/-- Exact Lambert--Möbius inversion for nonnegative monotone densities. -/
theorem primePowerDensityTransform_positiveMobiusPrimeDensity
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    primePowerDensityTransform (positiveMobiusPrimeDensity g) u = g u := by
  have hsum := primeDensityMobiusPair_summable hg0 hmono hu
  have hrow (n : ℕ+) :
      (∑' k : ℕ+, primeDensityMobiusPair g u (n, k)) =
        1 / (n : ℝ) ^ 2 * positiveMobiusPrimeDensity g (u / n) := by
    rw [positiveMobiusPrimeDensity, ← tsum_mul_left]
    apply tsum_congr
    intro k
    simp only [primeDensityMobiusPair]
    congr 2
    rw [div_div]
  rw [primePowerDensityTransform]
  rw [← tsum_congr hrow]
  rw [← hsum.tsum_prod]
  rw [← sigmaAntidiagonalEquivProd.tsum_eq]
  rw [Summable.tsum_sigma]
  · calc
      _ = ∑' b : ℕ+, if b = 1 then g u else 0 := by
        apply tsum_congr
        intro b
        rw [tsum_fintype]
        exact primeDensityMobius_antidiagonal g u b
      _ = g u := by simp
  · exact (sigmaAntidiagonalEquivProd.summable_iff).2 hsum

theorem positiveMobiusPrimeDensity_eq_mobiusLogInversion
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    positiveMobiusPrimeDensity g u = mobiusLogInversion g u := by
  have hsum := summable_mobiusLogInversion hg0 hmono hu
  rw [positiveMobiusPrimeDensity, mobiusLogInversion]
  have htail := hsum.sum_add_tsum_nat_add 1
  rw [show
      (∑' k : ℕ+, (moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)) =
        ∑' k : ℕ,
          (moebius (k + 1) : ℝ) / ((k + 1 : ℕ) : ℝ) ^ 2 *
            g (u / (k + 1 : ℕ)) by
      simpa using
        (tsum_pnat_eq_tsum_succ
          (f := fun k : ℕ =>
            (moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)))]
  have hzero :
      (moebius 0 : ℝ) / (0 : ℝ) ^ 2 * g (u / 0) = 0 := by simp
  simpa [hzero] using htail

/-- A positive monotone prime-power density has a nonnegative exact prime-density preimage. -/
theorem positiveMobiusPrimeDensity_nonneg
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    0 ≤ positiveMobiusPrimeDensity g u := by
  rw [positiveMobiusPrimeDensity_eq_mobiusLogInversion hg0 hmono hu]
  have hbound := mobiusLogInversion_ge hg0 hmono hu
  have hpi : Real.pi ^ 2 / 6 < 2 := by
    nlinarith [Real.pi_pos, Real.pi_lt_d4]
  exact le_trans
    (mul_nonneg (sub_nonneg.mpr hpi.le) (hg0 u))
    hbound

/-- The inverted prime density is locally bounded by the source density times the convergent
positive-natural zeta-two mass. -/
theorem norm_positiveMobiusPrimeDensity_le_zetaTwoMass
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    ‖positiveMobiusPrimeDensity g u‖ ≤
      (∑' n : ℕ+, 1 / (n : ℝ) ^ 2) * g u := by
  have hterm (k : ℕ+) :
      ‖(moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)‖ ≤
        g u * (1 / (k : ℝ) ^ 2) := by
    have hkpos : (0 : ℝ) < (k : ℝ) := by positivity
    have hk1 : (1 : ℝ) ≤ (k : ℝ) := by
      exact_mod_cast k.property
    have harg : u / (k : ℝ) ≤ u := by
      rw [div_le_iff₀ hkpos]
      nlinarith
    have hgle : g (u / k) ≤ g u := hmono harg
    have hmu : |(moebius k : ℝ)| ≤ 1 := by
      have h := abs_moebius_le_one (n := k)
      calc
        |(moebius k : ℝ)| = ((|moebius k| : ℤ) : ℝ) := by
          push_cast
          simp
        _ ≤ ((1 : ℤ) : ℝ) := by exact_mod_cast h
        _ = 1 := by norm_num
    rw [Real.norm_eq_abs, abs_mul, abs_div,
      abs_of_nonneg (hg0 _),
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ (k : ℝ) ^ 2)]
    calc
      |(moebius k : ℝ)| / (k : ℝ) ^ 2 * g (u / k) ≤
          1 / (k : ℝ) ^ 2 * g u := by
            gcongr
            exact hg0 _
      _ = g u * (1 / (k : ℝ) ^ 2) := by ring
  have hz : Summable (fun k : ℕ+ => 1 / (k : ℝ) ^ 2) :=
    hasSum_zeta_two.summable.comp_injective Subtype.val_injective
  have hmajor :
      Summable (fun k : ℕ+ => g u * (1 / (k : ℝ) ^ 2)) :=
    hz.mul_left (g u)
  have hnorm :
      Summable (fun k : ℕ+ =>
        ‖(moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)‖) :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hterm hmajor
  rw [positiveMobiusPrimeDensity]
  calc
    ‖∑' k : ℕ+, (moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)‖ ≤
        ∑' k : ℕ+,
          ‖(moebius k : ℝ) / (k : ℝ) ^ 2 * g (u / k)‖ :=
      norm_tsum_le_tsum_norm hnorm
    _ ≤ ∑' k : ℕ+, g u * (1 / (k : ℝ) ^ 2) :=
      hnorm.tsum_le_tsum hterm hmajor
    _ = (∑' n : ℕ+, 1 / (n : ℝ) ^ 2) * g u := by
      rw [tsum_mul_left]
      ring

/-- The complete positive inversion law: exact recovery and nonnegative prime density. -/
theorem positive_primeDensity_inversion_law
    {g : ℝ → ℝ} (hg0 : ∀ x, 0 ≤ g x) (hmono : Monotone g)
    {u : ℝ} (hu : 0 ≤ u) :
    0 ≤ positiveMobiusPrimeDensity g u ∧
      primePowerDensityTransform (positiveMobiusPrimeDensity g) u = g u :=
  ⟨positiveMobiusPrimeDensity_nonneg hg0 hmono hu,
    primePowerDensityTransform_positiveMobiusPrimeDensity hg0 hmono hu⟩

/-! ## The positive complex-quartet prime density -/

/-- The centered hyperbolic--oscillatory core of the off-line quartet density. -/
def eulerQuartetCore (a gam u : ℝ) : ℝ :=
  Real.cosh (u / 2) - Real.cosh (a * u) * Real.cos (gam * u)

/-- First derivative of the centered quartet core. -/
def eulerQuartetCoreFirst (a gam u : ℝ) : ℝ :=
  Real.sinh (u / 2) / 2 -
    (a * Real.sinh (a * u) * Real.cos (gam * u) -
      gam * Real.cosh (a * u) * Real.sin (gam * u))

/-- Second derivative of the centered quartet core. -/
def eulerQuartetCoreSecond (a gam u : ℝ) : ℝ :=
  Real.cosh (u / 2) / 4 -
    ((a ^ 2 - gam ^ 2) * Real.cosh (a * u) * Real.cos (gam * u) -
      2 * a * gam * Real.sinh (a * u) * Real.sin (gam * u))

/-- Complex hyperbolic cosine is dominated by the real hyperbolic cosine at the norm. -/
theorem norm_cosh_le_cosh_norm (z : ℂ) :
    ‖Complex.cosh z‖ ≤ Real.cosh ‖z‖ := by
  have hs :
      Summable (fun n : ℕ => ‖z ^ (2 * n) / ((2 * n).factorial : ℂ)‖) := by
    have hr := (Real.hasSum_cosh ‖z‖).summable
    apply hr.congr
    intro n
    rw [norm_div, Complex.norm_pow, Complex.norm_natCast]
  rw [Complex.cosh_eq_tsum]
  calc
    ‖∑' n : ℕ, z ^ (2 * n) / ((2 * n).factorial : ℂ)‖ ≤
        ∑' n : ℕ, ‖z ^ (2 * n) / ((2 * n).factorial : ℂ)‖ :=
      norm_tsum_le_tsum_norm hs
    _ = Real.cosh ‖z‖ := by
      rw [← (Real.hasSum_cosh ‖z‖).tsum_eq]
      apply tsum_congr
      intro n
      rw [norm_div, Complex.norm_pow, Complex.norm_natCast]

/-- The oscillatory part of the quartet second derivative is the real part of one complex
hyperbolic mode. -/
theorem complex_eulerQuartetSecond_eq (a gam u : ℝ) :
    ((((a : ℂ) + (gam : ℂ) * Complex.I) ^ 2 *
        Complex.cosh
          (((a : ℂ) + (gam : ℂ) * Complex.I) * (u : ℂ))).re) =
      (a ^ 2 - gam ^ 2) * Real.cosh (a * u) * Real.cos (gam * u) -
        2 * a * gam * Real.sinh (a * u) * Real.sin (gam * u) := by
  have harg :
      ((a : ℂ) + (gam : ℂ) * Complex.I) * (u : ℂ) =
        ((a * u : ℝ) : ℂ) + ((gam * u : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  have hcosh :
      Complex.cosh ((a * u : ℝ) : ℂ) = (Real.cosh (a * u) : ℂ) :=
    (Complex.ofReal_cosh (a * u)).symm
  have hsinh :
      Complex.sinh ((a * u : ℝ) : ℂ) = (Real.sinh (a * u) : ℂ) :=
    (Complex.ofReal_sinh (a * u)).symm
  have hcos :
      Complex.cos ((gam * u : ℝ) : ℂ) = (Real.cos (gam * u) : ℂ) :=
    (Complex.ofReal_cos (gam * u)).symm
  have hsin :
      Complex.sin ((gam * u : ℝ) : ℂ) = (Real.sin (gam * u) : ℂ) :=
    (Complex.ofReal_sin (gam * u)).symm
  rw [harg, Complex.cosh_add, Complex.cosh_mul_I, Complex.sinh_mul_I]
  rw [hcosh, hsinh, hcos, hsin]
  simp only [pow_two, Complex.mul_re, Complex.mul_im, Complex.add_re,
    Complex.add_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, mul_zero, zero_mul, mul_one, add_zero, zero_add, sub_zero]
  ring

theorem hasDerivAt_eulerQuartetCore (a gam u : ℝ) :
    HasDerivAt (eulerQuartetCore a gam) (eulerQuartetCoreFirst a gam u) u := by
  have hhalf :=
    (Real.hasDerivAt_cosh (u / 2)).comp u
      ((hasDerivAt_id u).div_const 2)
  have ha :=
    (Real.hasDerivAt_cosh (a * u)).comp u
      ((hasDerivAt_id u).const_mul a)
  have hg :=
    (Real.hasDerivAt_cos (gam * u)).comp u
      ((hasDerivAt_id u).const_mul gam)
  simpa only [eulerQuartetCore, Function.comp_apply, id_eq] using!
    (hhalf.sub (ha.mul hg)).congr_deriv (by
      dsimp only [eulerQuartetCoreFirst]
      simp only [Function.comp_apply]
      ring)

theorem hasDerivAt_eulerQuartetCoreFirst (a gam u : ℝ) :
    HasDerivAt (eulerQuartetCoreFirst a gam) (eulerQuartetCoreSecond a gam u) u := by
  have hhalf :=
    (Real.hasDerivAt_sinh (u / 2)).comp u
      ((hasDerivAt_id u).div_const 2)
  have hsa :=
    (Real.hasDerivAt_sinh (a * u)).comp u
      ((hasDerivAt_id u).const_mul a)
  have hca :=
    (Real.hasDerivAt_cosh (a * u)).comp u
      ((hasDerivAt_id u).const_mul a)
  have hcg :=
    (Real.hasDerivAt_cos (gam * u)).comp u
      ((hasDerivAt_id u).const_mul gam)
  have hsg :=
    (Real.hasDerivAt_sin (gam * u)).comp u
      ((hasDerivAt_id u).const_mul gam)
  simpa only [eulerQuartetCoreFirst, Function.comp_apply, id_eq] using!
    ((hhalf.div_const 2).sub
      (((hsa.const_mul a).mul hcg).sub
        ((hca.const_mul gam).mul hsg))).congr_deriv (by
          dsimp only [eulerQuartetCoreSecond]
          simp only [Function.comp_apply]
          ring)

/-- Inside the radius-one-half disc, the complex quartet core has nonnegative curvature on the
positive logarithmic axis. -/
theorem eulerQuartetCoreSecond_nonneg {a gam u : ℝ}
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) (hu : 0 ≤ u) :
    0 ≤ eulerQuartetCoreSecond a gam u := by
  let w : ℂ := (a : ℂ) + (gam : ℂ) * Complex.I
  have hwnormsq : ‖w‖ ^ 2 = a ^ 2 + gam ^ 2 := by
    rw [Complex.sq_norm]
    simp only [w, Complex.normSq_apply, Complex.add_re, Complex.mul_re,
      Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im]
    ring
  have hwnorm : ‖w‖ ≤ 1 / 2 := by
    have hw0 : 0 ≤ ‖w‖ := norm_nonneg _
    nlinarith [sq_nonneg (‖w‖ - 1 / 2)]
  have hcosh :
      ‖Complex.cosh (w * (u : ℂ))‖ ≤ Real.cosh (u / 2) := by
    apply (norm_cosh_le_cosh_norm _).trans
    apply Real.cosh_le_cosh.mpr
    rw [abs_of_nonneg (norm_nonneg _),
      abs_of_nonneg (by linarith : 0 ≤ u / 2)]
    calc
      ‖w * (u : ℂ)‖ = ‖w‖ * u := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hu]
      _ ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hwnorm hu
      _ = u / 2 := by ring
  have hterm :
      ((((a : ℂ) + (gam : ℂ) * Complex.I) ^ 2 *
          Complex.cosh
            (((a : ℂ) + (gam : ℂ) * Complex.I) * (u : ℂ))).re) ≤
        (1 / 4) * Real.cosh (u / 2) := by
    change (w ^ 2 * Complex.cosh (w * (u : ℂ))).re ≤
      (1 / 4) * Real.cosh (u / 2)
    calc
      _ ≤ ‖w ^ 2 * Complex.cosh (w * (u : ℂ))‖ :=
        le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
      _ = ‖w‖ ^ 2 * ‖Complex.cosh (w * (u : ℂ))‖ := by
        rw [norm_mul, norm_pow]
      _ ≤ (1 / 4) * ‖Complex.cosh (w * (u : ℂ))‖ := by
        exact mul_le_mul_of_nonneg_right (by nlinarith) (norm_nonneg _)
      _ ≤ (1 / 4) * Real.cosh (u / 2) := by
        exact mul_le_mul_of_nonneg_left hcosh (by norm_num)
  rw [complex_eulerQuartetSecond_eq] at hterm
  unfold eulerQuartetCoreSecond
  linarith

theorem convexOn_eulerQuartetCore {a gam : ℝ}
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) :
    ConvexOn ℝ (Set.Ici 0) (eulerQuartetCore a gam) := by
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Ici 0)
  · unfold eulerQuartetCore
    fun_prop
  · intro x _
    exact (hasDerivAt_eulerQuartetCore a gam x).hasDerivWithinAt
  · intro x _
    exact (hasDerivAt_eulerQuartetCoreFirst a gam x).hasDerivWithinAt
  · intro x hx
    apply eulerQuartetCoreSecond_nonneg hradius
    have : x ∈ Set.Ioi (0 : ℝ) := by
      simpa only [interior_Ici] using hx
    exact this.le

theorem eulerQuartetCore_zero (a gam : ℝ) :
    eulerQuartetCore a gam 0 = 0 := by
  simp [eulerQuartetCore]

/-- Convexity makes the quartet core divided by logarithmic distance nondecreasing. -/
theorem eulerQuartetCore_ratio_mono {a gam x y : ℝ}
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4)
    (hx : 0 < x) (hxy : x ≤ y) :
    eulerQuartetCore a gam x / x ≤ eulerQuartetCore a gam y / y := by
  have hy : 0 < y := hx.trans_le hxy
  have hsec := (convexOn_eulerQuartetCore hradius).secant_mono
    (show (0 : ℝ) ∈ Set.Ici 0 by simp)
    (show x ∈ Set.Ici 0 by exact hx.le)
    (show y ∈ Set.Ici 0 by exact hy.le)
    hx.ne' hy.ne' hxy
  simpa [eulerQuartetCore_zero] using hsec

theorem entireFEDensity_eq_eulerQuartetCore (a gam u : ℝ) :
    entireFEDensity a gam u =
      4 * Real.exp (u / 2) * eulerQuartetCore a gam u := by
  rw [entireFEDensity_eq]
  rw [← two_exp_half_mul_cosh_half, ← two_exp_half_mul_cosh]
  unfold eulerQuartetCore
  ring

/-- The logarithmic prime-power density of the complex quartet correction. -/
def quartetPrimePowerLogDensity (a gam u : ℝ) : ℝ :=
  if 0 < u then entireFEDensity a gam u / u else 0

theorem quartetPrimePowerLogDensity_nonneg
    {a gam : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) (u : ℝ) :
    0 ≤ quartetPrimePowerLogDensity a gam u := by
  have ha1 : a < 1 / 2 := by
    have hgpos : 0 < gam ^ 2 := sq_pos_of_ne_zero hgam
    nlinarith [sq_nonneg (a - 1 / 2)]
  rw [quartetPrimePowerLogDensity]
  split_ifs with hu
  · exact div_nonneg (entireFEDensity_nonneg ha ha1 hu.le) hu.le
  · exact le_rfl

/-- The radius-one-half condition makes the full quartet prime-power logarithmic density
nondecreasing, including across the origin. -/
theorem monotone_quartetPrimePowerLogDensity
    {a gam : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) :
    Monotone (quartetPrimePowerLogDensity a gam) := by
  have ha1 : a < 1 / 2 := by
    have hgpos : 0 < gam ^ 2 := sq_pos_of_ne_zero hgam
    nlinarith [sq_nonneg (a - 1 / 2)]
  intro x y hxy
  by_cases hx : 0 < x
  · have hy : 0 < y := hx.trans_le hxy
    simp only [quartetPrimePowerLogDensity, if_pos hx, if_pos hy]
    rw [entireFEDensity_eq_eulerQuartetCore,
      entireFEDensity_eq_eulerQuartetCore]
    have hexp : Real.exp (x / 2) ≤ Real.exp (y / 2) :=
      Real.exp_le_exp.mpr (by linarith)
    have hratio := eulerQuartetCore_ratio_mono hradius hx hxy
    have hcorex : 0 ≤ eulerQuartetCore a gam x := by
      have hd := entireFEDensity_nonneg (gam := gam) ha ha1 hx.le
      rw [entireFEDensity_eq_eulerQuartetCore] at hd
      have he : 0 < 4 * Real.exp (x / 2) := by positivity
      nlinarith
    have hcoreratio : 0 ≤ eulerQuartetCore a gam x / x :=
      div_nonneg hcorex hx.le
    have hmul :
        Real.exp (x / 2) * (eulerQuartetCore a gam x / x) ≤
          Real.exp (y / 2) * (eulerQuartetCore a gam y / y) :=
      mul_le_mul hexp hratio hcoreratio (by positivity)
    calc
      4 * Real.exp (x / 2) * eulerQuartetCore a gam x / x =
          4 * (Real.exp (x / 2) * (eulerQuartetCore a gam x / x)) := by
            field_simp
      _ ≤ 4 * (Real.exp (y / 2) * (eulerQuartetCore a gam y / y)) :=
        mul_le_mul_of_nonneg_left hmul (by norm_num)
      _ = 4 * Real.exp (y / 2) * eulerQuartetCore a gam y / y := by
        field_simp
  · rw [quartetPrimePowerLogDensity, if_neg hx]
    exact quartetPrimePowerLogDensity_nonneg ha hgam hradius y

/-- The genuine logarithmic generalized-prime density that generates the quartet correction. -/
def quartetPrimeLogDensity (a gam : ℝ) : ℝ → ℝ :=
  positiveMobiusPrimeDensity (quartetPrimePowerLogDensity a gam)

theorem quartetPrimeLogDensity_measurable
    {a gam : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) :
    Measurable (quartetPrimeLogDensity a gam) := by
  have hgmeas :
      Measurable (quartetPrimePowerLogDensity a gam) :=
    (monotone_quartetPrimePowerLogDensity ha hgam hradius).measurable
  apply Measurable.tsum
  intro k
  exact (measurable_const.mul
    (hgmeas.comp (measurable_id.div_const (k : ℝ))))

theorem quartetPrimeLogDensity_nonneg
    {a gam u : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) (hu : 0 ≤ u) :
    0 ≤ quartetPrimeLogDensity a gam u := by
  exact positiveMobiusPrimeDensity_nonneg
    (fun x => quartetPrimePowerLogDensity_nonneg ha hgam hradius x)
    (monotone_quartetPrimePowerLogDensity ha hgam hradius) hu

/-- The positive quartet prime density is integrable on every compact logarithmic interval.
Consequently it defines a locally finite positive measure on the positive logarithmic axis. -/
theorem integrableOn_quartetPrimeLogDensity_Icc
    {a gam R : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) :
    IntegrableOn (quartetPrimeLogDensity a gam) (Set.Icc 0 R) volume := by
  refine Measure.integrableOn_of_bounded
    (M := (∑' n : ℕ+, 1 / (n : ℝ) ^ 2) *
      quartetPrimePowerLogDensity a gam R)
    measure_Icc_lt_top.ne
    (quartetPrimeLogDensity_measurable ha hgam hradius).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
  have hpbound :
      ‖quartetPrimeLogDensity a gam u‖ ≤
        (∑' n : ℕ+, 1 / (n : ℝ) ^ 2) *
          quartetPrimePowerLogDensity a gam u := by
    exact norm_positiveMobiusPrimeDensity_le_zetaTwoMass
      (fun x => quartetPrimePowerLogDensity_nonneg ha hgam hradius x)
      (monotone_quartetPrimePowerLogDensity ha hgam hradius) hu.1
  exact hpbound.trans
    (mul_le_mul_of_nonneg_left
      ((monotone_quartetPrimePowerLogDensity ha hgam hradius) hu.2)
      (tsum_nonneg fun _ => by positivity))

theorem primePowerDensityTransform_quartetPrimeLogDensity
    {a gam u : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) (hu : 0 ≤ u) :
    primePowerDensityTransform (quartetPrimeLogDensity a gam) u =
      quartetPrimePowerLogDensity a gam u := by
  exact primePowerDensityTransform_positiveMobiusPrimeDensity
    (fun x => quartetPrimePowerLogDensity_nonneg ha hgam hradius x)
    (monotone_quartetPrimePowerLogDensity ha hgam hradius) hu

theorem quartetPrimePowerLogDensity_eq_density_div
    {a gam u : ℝ} (hu : 0 < u) :
    quartetPrimePowerLogDensity a gam u = entireFEDensity a gam u / u := by
  simp [quartetPrimePowerLogDensity, hu]

/-- The rational Euler gauge's logarithmic derivative is exactly the negative Laplace-transform
correction, away from its poles and inserted zeros. -/
theorem logDeriv_entireFEGauge_eq_neg_transform
    (a gam : ℝ) (s : ℂ)
    (hs : s ≠ 0) (hs1 : s ≠ 1)
    (h1 : s - (((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0)
    (h2 : s - (((1 / 2 + a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0)
    (h3 : s - (((1 / 2 - a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0)
    (h4 : s - (((1 / 2 - a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0) :
    logDeriv (entireFEGauge a gam) s = -entireFETransform a gam s := by
  let r1 : ℂ := ((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I
  let r2 : ℂ := ((1 / 2 + a : ℝ) : ℂ) - (gam : ℂ) * Complex.I
  let r3 : ℂ := ((1 / 2 - a : ℝ) : ℂ) + (gam : ℂ) * Complex.I
  let r4 : ℂ := ((1 / 2 - a : ℝ) : ℂ) - (gam : ℂ) * Complex.I
  have hr1 : s - r1 ≠ 0 := h1
  have hr2 : s - r2 ≠ 0 := h2
  have hr3 : s - r3 ≠ 0 := h3
  have hr4 : s - r4 ≠ 0 := h4
  have hr12 : (s - r1) * (s - r2) ≠ 0 := mul_ne_zero hr1 hr2
  have hr123 : ((s - r1) * (s - r2)) * (s - r3) ≠ 0 :=
    mul_ne_zero hr12 hr3
  have hlinear (r : ℂ) :
      logDeriv (fun z : ℂ => z - r) s = (s - r)⁻¹ := by
    rw [logDeriv_apply, deriv_sub_const, deriv_id'']
    ring
  have hnum :
      logDeriv (offLineQuartet a gam) s =
        (s - r1)⁻¹ + (s - r2)⁻¹ + (s - r3)⁻¹ + (s - r4)⁻¹ := by
    change
      logDeriv
        (fun z : ℂ =>
          (((z - r1) * (z - r2)) * (z - r3)) * (z - r4)) s = _
    rw [logDeriv_mul
      (f := fun z : ℂ => ((z - r1) * (z - r2)) * (z - r3))
      (g := fun z : ℂ => z - r4)
      s hr123 hr4 (by fun_prop) (by fun_prop)]
    rw [logDeriv_mul
      (f := fun z : ℂ => (z - r1) * (z - r2))
      (g := fun z : ℂ => z - r3)
      s hr12 hr3 (by fun_prop) (by fun_prop)]
    rw [logDeriv_mul
      (f := fun z : ℂ => z - r1)
      (g := fun z : ℂ => z - r2)
      s hr1 hr2 (by fun_prop) (by fun_prop)]
    rw [hlinear, hlinear, hlinear, hlinear]
  have hbase : s * (s - 1) ≠ 0 :=
    mul_ne_zero hs (sub_ne_zero.mpr hs1)
  have hden :
      logDeriv (fun z : ℂ => (z * (z - 1)) ^ 2) s =
        2 * (s⁻¹ + (s - 1)⁻¹) := by
    rw [logDeriv_fun_pow (by fun_prop) 2]
    rw [logDeriv_mul
      (f := fun z : ℂ => z)
      (g := fun z : ℂ => z - 1)
      s hs (sub_ne_zero.mpr hs1) (by fun_prop) (by fun_prop)]
    rw [show logDeriv (fun z : ℂ => z) s = s⁻¹ by
      simpa only [sub_zero] using hlinear 0]
    rw [hlinear]
    norm_num
  change
    logDeriv
      (fun z : ℂ =>
        offLineQuartet a gam z / (z * (z - 1)) ^ 2) s = _
  rw [logDeriv_div
    (f := fun z : ℂ => offLineQuartet a gam z)
    (g := fun z : ℂ => (z * (z - 1)) ^ 2)
    s
    (by
      change (((s - r1) * (s - r2)) * (s - r3)) * (s - r4) ≠ 0
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero hr1 hr2) hr3) hr4)
    (pow_ne_zero 2 hbase)
    (by unfold offLineQuartet; fun_prop) (by fun_prop)]
  rw [hnum, hden]
  unfold entireFETransform
  simp only [r1, r2, r3, r4]
  ring

/-- The quartet numerator obtained from the positive Euler source is exactly the centered
polynomial multiplying the completed Riemann xi function. -/
theorem offLineQuartet_eq_centeredQuartetGauge (a gam : ℝ) (s : ℂ) :
    offLineQuartet a gam s = centeredQuartetGauge a gam s := by
  unfold offLineQuartet centeredQuartetGauge
  push_cast
  ring_nf
  simp
  ring

/-- **Positive Euler-quartet realization.**  Every genuinely complex quartet inside the centered
radius-one-half disc has a measurable nonnegative generalized-prime density whose exact
prime-power density is the explicit reflection-antisymmetric correction.  The same correction
has the Riemann reflection law, clears to an entire symmetric quartet polynomial, and inserts a
strict-right off-critical zero. -/
theorem positiveEulerQuartet_realization
    {a gam : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4) :
    Measurable (quartetPrimeLogDensity a gam) ∧
    (∀ u : ℝ, 0 ≤ u → 0 ≤ quartetPrimeLogDensity a gam u) ∧
    (∀ R : ℝ,
      IntegrableOn (quartetPrimeLogDensity a gam) (Set.Icc 0 R) volume) ∧
    (∀ u : ℝ, 0 ≤ u →
      primePowerDensityTransform (quartetPrimeLogDensity a gam) u =
        quartetPrimePowerLogDensity a gam u) ∧
    (∀ u : ℝ, 0 < u →
      quartetPrimePowerLogDensity a gam u = entireFEDensity a gam u / u) ∧
    (∀ s : ℂ,
      s ≠ 0 →
      s ≠ 1 →
      s - (((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0 →
      s - (((1 / 2 + a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0 →
      s - (((1 / 2 - a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0 →
      s - (((1 / 2 - a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0 →
      logDeriv (entireFEGauge a gam) s = -entireFETransform a gam s) ∧
    (∀ s : ℂ, entireFETransform a gam s + entireFETransform a gam (1 - s) = 0) ∧
    (∀ s : ℂ, offLineQuartet a gam s = centeredQuartetGauge a gam s) ∧
    (∀ s : ℂ, offLineQuartet a gam (1 - s) = offLineQuartet a gam s) ∧
    offLineQuartet a gam
      (((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) = 0 ∧
    1 / 2 <
      ((((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I)).re := by
  refine ⟨quartetPrimeLogDensity_measurable ha hgam hradius,
    fun _ hu => quartetPrimeLogDensity_nonneg ha hgam hradius hu,
    fun _ => integrableOn_quartetPrimeLogDensity_Icc ha hgam hradius,
    fun _ hu =>
      primePowerDensityTransform_quartetPrimeLogDensity ha hgam hradius hu,
    fun _ hu => quartetPrimePowerLogDensity_eq_density_div hu,
    fun s hs hs1 h1 h2 h3 h4 =>
      logDeriv_entireFEGauge_eq_neg_transform a gam s hs hs1 h1 h2 h3 h4,
    entireFETransform_antisymm a gam,
    offLineQuartet_eq_centeredQuartetGauge a gam,
    offLineQuartet_reflect a gam,
    offLineQuartet_eq_zero a gam, ?_⟩
  simp
  exact ha

/-! ## The oriented Cauchy response survives Euler positivity -/

/-- Spectral coordinate of the upper-right zero
`1 / 2 + a + i gam`.  Critical-line zeros are exactly the real points in this coordinate. -/
def eulerQuartetSpectralPoint (a gam : ℝ) : ℂ :=
  (gam : ℂ) - (a : ℂ) * Complex.I

@[simp] theorem eulerQuartetSpectralPoint_re (a gam : ℝ) :
    (eulerQuartetSpectralPoint a gam).re = gam := by
  simp [eulerQuartetSpectralPoint, Complex.mul_re]

@[simp] theorem eulerQuartetSpectralPoint_im (a gam : ℝ) :
    (eulerQuartetSpectralPoint a gam).im = -a := by
  simp [eulerQuartetSpectralPoint, Complex.mul_im]

/-- A genuinely off-line Euler quartet has strictly positive Cauchy variance at every regular
probe.  Thus polarization retains the transverse orientation that a square would erase. -/
theorem cauchyQuartetVariance_eulerQuartetSpectralPoint_pos
    {a gam : ℝ} (ha : 0 < a) (hgam : gam ≠ 0)
    (z : ℂ)
    (haz : eulerQuartetSpectralPoint a gam - z ≠ 0)
    (hcaz : (starRingEnd ℂ) (eulerQuartetSpectralPoint a gam) - z ≠ 0)
    (hapz : eulerQuartetSpectralPoint a gam + z ≠ 0)
    (hcapz : (starRingEnd ℂ) (eulerQuartetSpectralPoint a gam) + z ≠ 0) :
    0 < cauchyQuartetVariance z (eulerQuartetSpectralPoint a gam) := by
  let A := eulerQuartetSpectralPoint a gam
  have hA : A ≠ 0 := by
    intro hzero
    have hre := congrArg Complex.re hzero
    simp only [A, eulerQuartetSpectralPoint_re, Complex.zero_re] at hre
    exact hgam hre
  have hnonneg : 0 ≤ cauchyQuartetVariance z A :=
    cauchyQuartetVariance_nonneg z A
  have hne : cauchyQuartetVariance z A ≠ 0 := by
    intro hzero
    rcases (cauchyQuartetVariance_eq_zero_iff
      hA haz hcaz hapz hcapz).mp hzero with hre | him
    · exact hgam (by simpa only [A, eulerQuartetSpectralPoint_re] using hre)
    · have : a = 0 := by
        simpa only [A, eulerQuartetSpectralPoint_im, neg_eq_zero] using him
      exact ha.ne' this
  exact lt_of_le_of_ne hnonneg (Ne.symm hne)

/-- **Positive-Euler oriented-quartet law.**  Every source-positive complex quartet in the
centered radius-one-half disc has, at every regular first-quadrant Cauchy probe, a strictly
positive unsquared orientation response.  Hence nonnegative generalized-prime density, exact
Riemann reflection, entire completion, hypertranscendence, and a positive Julia/Cauchy
orientation coexist with an off-critical divisor; none supplies the opposite one-sided
inequality needed to force the critical line. -/
theorem positiveEulerQuartet_orientedCauchyResponse
    {a gam : ℝ} (ha : 0 < a) (hgam : 0 < gam)
    (hradius : a ^ 2 + gam ^ 2 ≤ 1 / 4)
    (z : ℂ) (hzre : 0 < z.re) (hzim : 0 < z.im)
    (haz : eulerQuartetSpectralPoint a gam - z ≠ 0)
    (hcaz : (starRingEnd ℂ) (eulerQuartetSpectralPoint a gam) - z ≠ 0)
    (hapz : eulerQuartetSpectralPoint a gam + z ≠ 0)
    (hcapz : (starRingEnd ℂ) (eulerQuartetSpectralPoint a gam) + z ≠ 0) :
    (Measurable (quartetPrimeLogDensity a gam) ∧
      (∀ u : ℝ, 0 ≤ u → 0 ≤ quartetPrimeLogDensity a gam u) ∧
      (∀ R : ℝ,
        IntegrableOn (quartetPrimeLogDensity a gam) (Set.Icc 0 R) volume) ∧
      (∀ u : ℝ, 0 ≤ u →
        primePowerDensityTransform (quartetPrimeLogDensity a gam) u =
          quartetPrimePowerLogDensity a gam u) ∧
      (∀ u : ℝ, 0 < u →
        quartetPrimePowerLogDensity a gam u = entireFEDensity a gam u / u) ∧
      (∀ s : ℂ,
        s ≠ 0 →
        s ≠ 1 →
        s - (((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0 →
        s - (((1 / 2 + a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0 →
        s - (((1 / 2 - a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) ≠ 0 →
        s - (((1 / 2 - a : ℝ) : ℂ) - (gam : ℂ) * Complex.I) ≠ 0 →
        logDeriv (entireFEGauge a gam) s = -entireFETransform a gam s) ∧
      (∀ s : ℂ, entireFETransform a gam s + entireFETransform a gam (1 - s) = 0) ∧
      (∀ s : ℂ, offLineQuartet a gam s = centeredQuartetGauge a gam s) ∧
      (∀ s : ℂ, offLineQuartet a gam (1 - s) = offLineQuartet a gam s) ∧
      offLineQuartet a gam
        (((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I) = 0 ∧
      1 / 2 <
        ((((1 / 2 + a : ℝ) : ℂ) + (gam : ℂ) * Complex.I)).re) ∧
    Hypertranscendental (quartetGaugedXi a gam) ∧
    (∀ s, AnalyticAt ℂ (quartetGaugedXi a gam) s) ∧
    (∀ s, quartetGaugedXi a gam (1 - s) = quartetGaugedXi a gam s) ∧
    (∀ s, quartetGaugedXi a gam ((starRingEnd ℂ) s) =
      (starRingEnd ℂ) (quartetGaugedXi a gam s)) ∧
    (quartetPoint a gam).re ≠ 1 / 2 ∧
    quartetGaugedXi a gam (quartetPoint a gam) = 0 ∧
    (∫⁻ t : ℝ, ENNReal.ofReal (quartetWardInfinitesimalDensity a gam t) =
      ENNReal.ofReal (8 * Real.pi)) ∧
    0 <
      cauchyQuartetOrientationTerm z (eulerQuartetSpectralPoint a gam) +
        cauchyQuartetOrientationTerm z
          ((starRingEnd ℂ) (eulerQuartetSpectralPoint a gam)) +
        cauchyQuartetOrientationTerm z
          (-(eulerQuartetSpectralPoint a gam)) +
        cauchyQuartetOrientationTerm z
          (-(starRingEnd ℂ) (eulerQuartetSpectralPoint a gam)) := by
  refine ⟨positiveEulerQuartet_realization ha hgam.ne' hradius,
    quartetGaugedXi_hypertranscendental hgam,
    quartetGaugedXi_analyticAt a gam,
    quartetGaugedXi_one_sub a gam,
    quartetGaugedXi_conj a gam,
    quartetPoint_off_critical ha.ne',
    quartetGaugedXi_quartetPoint a gam,
    lintegral_quartetWardInfinitesimalDensity (by linarith),
    ?_⟩
  rw [cauchyQuartetOrientationTerm_sum_orbit
    z (eulerQuartetSpectralPoint a gam) ?_ haz hcaz hapz hcapz]
  · have hvariance :=
      cauchyQuartetVariance_eulerQuartetSpectralPoint_pos
        ha hgam.ne' z haz hcaz hapz hcapz
    positivity
  · intro hzero
    have hre := congrArg Complex.re hzero
    simp only [eulerQuartetSpectralPoint_re, Complex.zero_re] at hre
    exact hgam.ne' hre

end RHTower
