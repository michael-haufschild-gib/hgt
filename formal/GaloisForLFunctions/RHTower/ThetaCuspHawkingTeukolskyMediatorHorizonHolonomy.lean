import GaloisForLFunctions.RHTower.ThetaCuspHawkingTeukolskySingleSectorFrequencyNoGo
import GaloisForLFunctions.RHTower.ThetaCuspHawkingEKGCompletedEisensteinOpticalIncidence
import GaloisForLFunctions.HTGeometry.HorizonBogoliubovModeGaugeHolonomy

/-!
# Hawking holonomy of the two Teukolsky mediator channels

The functional-reflection and reflected-real-pair Birmingham--Mokhtari mediator clocks differ by
`I * (Re rho - 1/2)`.  In the analytically continued exponential-peeling horizon kernel, their
two-input rectangle holonomy is therefore a real exponential of the Xi tilt.  A nondegenerate
two-frequency probe has zero determinant exactly on the critical line.  This is a local horizon
interface statement, not an identification with the full nonlinear gravitational S-matrix.
-/

open Complex Real Set Filter Topology

namespace RHTower

open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Unwrapped Hawking rectangle defect between the two virtual mediator clocks. -/
def d4BMXiMediatorHorizonPhaseDefect
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) : ℂ :=
  rectanglePhaseDefect
    (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ))
    (d4BMXiReflectedRealPairFrequency n q)
    (d4BMFunctionalReflectionMediatorFrequency n n)
    (logIncoming₁ : ℂ) (logIncoming₂ : ℂ)

/-- Analytic horizon continuation turns imaginary QNM-clock tilt into real gain. -/
theorem d4BMXiMediatorHorizonPhaseDefect_eq
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonPhaseDefect
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q =
      ((inverseSurfaceGravity * ((q.1 : ℂ).re - 1 / 2) *
        (logIncoming₁ - logIncoming₂) : ℝ) : ℂ) := by
  rw [d4BMXiMediatorHorizonPhaseDefect,
    rectanglePhaseDefect_thermalHorizonPhaseExponent,
    d4BMXiReflectedRealPairFrequency_sub_functionalMediator]
  push_cast
  ring_nf
  rw [Complex.I_sq]
  ring

/-- Nondegenerate unwrapped horizon defect vanishes exactly at zero Xi tilt. -/
theorem d4BMXiMediatorHorizonPhaseDefect_eq_zero_iff
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonPhaseDefect
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [d4BMXiMediatorHorizonPhaseDefect_eq]
  norm_cast
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h | h
    · rcases mul_eq_zero.mp h with h | h
      · exact False.elim (hinverse h)
      · linarith
    · exact False.elim (hlog (sub_eq_zero.mp h))
  · intro h
    simp [h]

/-- Multiplicative Hawking rectangle holonomy of the two mediator clocks. -/
def d4BMXiMediatorHorizonHolonomy
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) : ℂ :=
  rectangleKernelHolonomy
    (exponentialKernel
      (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ)))
    (d4BMXiReflectedRealPairFrequency n q)
    (d4BMFunctionalReflectionMediatorFrequency n n)
    (logIncoming₁ : ℂ) (logIncoming₂ : ℂ)

/-- Exact positive-real holonomy generated by the Xi tilt. -/
theorem d4BMXiMediatorHorizonHolonomy_eq
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonHolonomy
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q =
      Complex.exp (((inverseSurfaceGravity * ((q.1 : ℂ).re - 1 / 2) *
        (logIncoming₁ - logIncoming₂) : ℝ) : ℂ)) := by
  rw [d4BMXiMediatorHorizonHolonomy,
    rectangleKernelHolonomy_thermalHorizon,
    d4BMXiReflectedRealPairFrequency_sub_functionalMediator]
  push_cast
  congr 1
  ring_nf
  rw [Complex.I_sq]
  ring

/-- Nondegenerate multiplicative holonomy is trivial exactly on the critical line. -/
theorem d4BMXiMediatorHorizonHolonomy_eq_one_iff
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonHolonomy
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 1 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [d4BMXiMediatorHorizonHolonomy_eq, ← Complex.ofReal_exp]
  norm_cast
  rw [Real.exp_eq_one_iff]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h | h
    · rcases mul_eq_zero.mp h with h | h
      · exact False.elim (hinverse h)
      · linarith
    · exact False.elim (hlog (sub_eq_zero.mp h))
  · intro h
    simp [h]

/-- Two-by-two exponential-peeling transfer determinant. -/
def d4BMXiMediatorHorizonDeterminant
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) : ℂ :=
  let K := exponentialKernel
    (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ))
  K (d4BMXiReflectedRealPairFrequency n q) (logIncoming₁ : ℂ) *
      K (d4BMFunctionalReflectionMediatorFrequency n n) (logIncoming₂ : ℂ) -
    K (d4BMXiReflectedRealPairFrequency n q) (logIncoming₂ : ℂ) *
      K (d4BMFunctionalReflectionMediatorFrequency n n) (logIncoming₁ : ℂ)

lemma d4BMXiMediatorHorizonDeterminant_eq_zero_iff_holonomy_eq_one
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonDeterminant
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 0 ↔
      d4BMXiMediatorHorizonHolonomy
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 1 := by
  unfold d4BMXiMediatorHorizonDeterminant d4BMXiMediatorHorizonHolonomy
    rectangleKernelHolonomy
  let K := exponentialKernel
    (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ))
  change K _ _ * K _ _ - K _ _ * K _ _ = 0 ↔
    K _ _ * K _ _ / (K _ _ * K _ _) = 1
  rw [sub_eq_zero, div_eq_one_iff_eq]
  exact mul_ne_zero (Complex.exp_ne_zero _) (Complex.exp_ne_zero _)

/-- Horizon transfer has rank-one determinant exactly on the critical line. -/
theorem d4BMXiMediatorHorizonDeterminant_eq_zero_iff
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) (q : XiZeroCopy) :
    d4BMXiMediatorHorizonDeterminant
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [d4BMXiMediatorHorizonDeterminant_eq_zero_iff_holonomy_eq_one]
  exact d4BMXiMediatorHorizonHolonomy_eq_one_iff hinverse hlog n q

/-- Every tilted Xi divisor produces a nonzero two-channel horizon determinant. -/
theorem d4BMXiMediatorHorizonDeterminant_ne_zero_of_tilt
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) (q : XiZeroCopy)
    (htilt : (q.1 : ℂ).re ≠ 1 / 2) :
    d4BMXiMediatorHorizonDeterminant
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n q ≠ 0 := by
  exact fun hzero => htilt
    ((d4BMXiMediatorHorizonDeterminant_eq_zero_iff
      hinverse hlog n q).1 hzero)

/-- Separable nonzero mode normalizations cannot erase the horizon determinant. -/
theorem d4BMXiMediatorHorizonDeterminant_separableScale_eq
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) (q : XiZeroCopy)
    (realPairScale functionalScale inputScale₁ inputScale₂ : ℂ) :
    let K := exponentialKernel
      (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ))
    (realPairScale * K (d4BMXiReflectedRealPairFrequency n q)
          (logIncoming₁ : ℂ) * inputScale₁) *
        (functionalScale * K (d4BMFunctionalReflectionMediatorFrequency n n)
          (logIncoming₂ : ℂ) * inputScale₂) -
      (realPairScale * K (d4BMXiReflectedRealPairFrequency n q)
          (logIncoming₂ : ℂ) * inputScale₂) *
        (functionalScale * K (d4BMFunctionalReflectionMediatorFrequency n n)
          (logIncoming₁ : ℂ) * inputScale₁) =
      realPairScale * functionalScale * inputScale₁ * inputScale₂ *
        d4BMXiMediatorHorizonDeterminant
          inverseSurfaceGravity logIncoming₁ logIncoming₂ n q := by
  dsimp only
  unfold d4BMXiMediatorHorizonDeterminant
  ring

/-- Vanishing of the calibrated determinant is unchanged by nonzero separated factors. -/
theorem d4BMXiMediatorHorizonDeterminant_separableScale_eq_zero_iff
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) (q : XiZeroCopy)
    {realPairScale functionalScale inputScale₁ inputScale₂ : ℂ}
    (hrealPair : realPairScale ≠ 0)
    (hfunctional : functionalScale ≠ 0)
    (hinput₁ : inputScale₁ ≠ 0)
    (hinput₂ : inputScale₂ ≠ 0) :
    let K := exponentialKernel
      (thermalHorizonPhaseExponent (inverseSurfaceGravity : ℂ))
    (realPairScale * K (d4BMXiReflectedRealPairFrequency n q)
          (logIncoming₁ : ℂ) * inputScale₁) *
        (functionalScale * K (d4BMFunctionalReflectionMediatorFrequency n n)
          (logIncoming₂ : ℂ) * inputScale₂) -
      (realPairScale * K (d4BMXiReflectedRealPairFrequency n q)
          (logIncoming₂ : ℂ) * inputScale₂) *
        (functionalScale * K (d4BMFunctionalReflectionMediatorFrequency n n)
          (logIncoming₁ : ℂ) * inputScale₁) = 0 ↔
      (q.1 : ℂ).re = 1 / 2 := by
  dsimp only
  rw [d4BMXiMediatorHorizonDeterminant_separableScale_eq]
  have hscale : realPairScale * functionalScale * inputScale₁ * inputScale₂ ≠ 0 :=
    mul_ne_zero (mul_ne_zero (mul_ne_zero hrealPair hfunctional) hinput₁) hinput₂
  constructor
  · intro h
    exact (d4BMXiMediatorHorizonDeterminant_eq_zero_iff hinverse hlog n q).1
      ((mul_eq_zero.mp h).resolve_left hscale)
  · intro h
    exact mul_eq_zero.mpr (Or.inr
      ((d4BMXiMediatorHorizonDeterminant_eq_zero_iff hinverse hlog n q).2 h))

/-- Both mediator angular channels admit one common bright Eisenstein-continuum input. -/
theorem exists_d4BMXiMediatorCommonBrightEisensteinInput
    (q : XiZeroCopy) (t : ℝ) :
    ∃ r : ℝ,
      thetaCuspHawkingCompletedEisensteinPhysicalVertex
          (d4BMXiReflectedRealPairMediatorSpectralPoint q) r t ≠ 0 ∧
        thetaCuspHawkingCompletedEisensteinPhysicalVertex
          d4BMFunctionalReflectionMediatorSpectralPoint r t ≠ 0 := by
  let Z₁ : Set ℝ :=
    {r | thetaCuspHawkingCompletedEisensteinPhysicalVertex
      (d4BMXiReflectedRealPairMediatorSpectralPoint q) r t = 0}
  let Z₂ : Set ℝ :=
    {r | thetaCuspHawkingCompletedEisensteinPhysicalVertex
      d4BMFunctionalReflectionMediatorSpectralPoint r t = 0}
  have hcount : (Z₁ ∪ Z₂).Countable :=
    (countable_thetaCuspHawkingCompletedEisensteinPhysicalVertex_zeroSet
      (d4BMXiReflectedRealPairMediatorSpectralPoint q) t).union
    (countable_thetaCuspHawkingCompletedEisensteinPhysicalVertex_zeroSet
      d4BMFunctionalReflectionMediatorSpectralPoint t)
  by_contra h
  have huniv : Z₁ ∪ Z₂ = Set.univ := by
    apply Set.eq_univ_of_forall
    intro r
    by_cases h₁ : thetaCuspHawkingCompletedEisensteinPhysicalVertex
        (d4BMXiReflectedRealPairMediatorSpectralPoint q) r t = 0
    · exact Set.mem_union_left Z₂ h₁
    · have h₂ : thetaCuspHawkingCompletedEisensteinPhysicalVertex
          d4BMFunctionalReflectionMediatorSpectralPoint r t = 0 := by
        by_contra h₂
        exact h ⟨r, h₁, h₂⟩
      exact Set.mem_union_right Z₁ h₂
  exact Cardinal.not_countable_real (huniv ▸ hcount)

/-- Global rank-one closure of one nondegenerate two-frequency Hawking probe. -/
def D4BMXiMediatorHorizonRankOne
    (inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ)
    (n : ℕ) : Prop :=
  ∀ q : XiZeroCopy,
    d4BMXiMediatorHorizonDeterminant
      inverseSurfaceGravity logIncoming₁ logIncoming₂ n q = 0

/-- One nondegenerate global Hawking rank-one law is exactly RH. -/
theorem riemannHypothesis_iff_d4BMXiMediatorHorizonRankOne
    {inverseSurfaceGravity logIncoming₁ logIncoming₂ : ℝ}
    (hinverse : inverseSurfaceGravity ≠ 0)
    (hlog : logIncoming₁ ≠ logIncoming₂)
    (n : ℕ) :
    RiemannHypothesis ↔
      D4BMXiMediatorHorizonRankOne
        inverseSurfaceGravity logIncoming₁ logIncoming₂ n := by
  constructor
  · intro hRH q
    exact (d4BMXiMediatorHorizonDeterminant_eq_zero_iff
      hinverse hlog n q).2 (xi_divisor_support_re_eq_half_of_rh hRH q.1)
  · intro hrank
    exact (riemannHypothesis_iff_d4BMXiTwoChannelBackreactionIsConfluent).2
      (fun q => (d4BMXiTwoChannelHelicityTransfer_eq_zero_iff q).2
        ((d4BMXiMediatorHorizonDeterminant_eq_zero_iff
          hinverse hlog n q).1 (hrank q)))

end

end RHTower
