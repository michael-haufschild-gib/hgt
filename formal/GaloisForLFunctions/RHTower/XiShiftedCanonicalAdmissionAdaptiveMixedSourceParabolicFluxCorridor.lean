import GaloisForLFunctions.RHTower.XiShiftedCanonicalAdmissionAdaptiveMixedSourceIntegralLaw
import GaloisForLFunctions.RHTower.XiShiftedCanonicalAdmissionAdaptiveMixedSourceParabolicFloor

/-!
# Parabolic flux corridor generated by the adaptive mixed arithmetic source

The degree-uniform parabolic floor for literal adaptive mixed/completed source action can be
transported through its exact full-tail budget.  In physical mass `y`, the source floor becomes

`1 / (4 * y^2) < sourceAction(sqrt y,n)`.

Integrating over a complete positive right ray gives the new degree-uniform capital law

`1 / (4 * a) ≤ cumulativeJacobiFlux(a,n)`.

Strictly beyond the terminal frontier of the required block, this is unconditional and says that
dimensionless cumulative flux cannot collapse below `1/4`, even when mass and degree escape
together.  This is a diagonal mass--degree statement; fixed-degree recession alone cannot supply
it because its positivity threshold need not be uniform in degree.
-/

open Matrix Polynomial MeasureTheory Set Filter Topology
open scoped BigOperators Interval

namespace RHTower
namespace XiShiftedCanonicalAdmission

noncomputable section

/-- The degree-uniform source floor in physical mass coordinates. -/
theorem exists_uniform_literalMassSourceAction_parabolicFloor :
    ∃ W : ℝ, 2 ≤ W ∧ ∀ y ≥ W ^ 2, ∀ n : ℕ, 2 ≤ n →
      (HTGeometry.momentHankelMatrix
        (fun k => (xiShiftedReciprocalMoment y k).re) (n + 4)).PosDef →
      1 / (4 * y ^ 2) <
        xiShiftedCanonicalAdmissionAdaptiveMixedCompletedSourceAction
          (Real.sqrt y) n := by
  obtain ⟨W, hW, hfloor⟩ :=
    exists_uniform_adaptiveMixedCompletedSourceAction_parabolicFloor
  refine ⟨W, hW, ?_⟩
  intro y hy n hn hH
  have hW0 : 0 < W := lt_of_lt_of_le (by norm_num) hW
  have hy0 : 0 < y := lt_of_lt_of_le (sq_pos_of_pos hW0) hy
  have hsquare : (Real.sqrt y) ^ 2 = y := Real.sq_sqrt hy0.le
  have hWy : W ≤ Real.sqrt y := by
    rw [Real.le_sqrt hW0.le hy0.le]
    exact hy
  have hblock : (HTGeometry.momentHankelMatrix
      (xiShiftedRealMomentSequence (Real.sqrt y)) (n + 4)).PosDef := by
    change (HTGeometry.momentHankelMatrix
      (fun k => (xiShiftedReciprocalMoment ((Real.sqrt y) ^ 2) k).re)
        (n + 4)).PosDef
    simpa only [hsquare] using hH
  have hsource := hfloor (Real.sqrt y) hWy n hn hblock
  have hfourth : (Real.sqrt y) ^ 4 = y ^ 2 := by
    calc
      (Real.sqrt y) ^ 4 = ((Real.sqrt y) ^ 2) ^ 2 := by ring
      _ = y ^ 2 := by rw [hsquare]
  rw [hfourth] at hsource
  rw [show 1 / (4 * y ^ 2) = (1 / 4 : ℝ) / y ^ 2 by ring]
  apply (div_lt_iff₀ (sq_pos_of_pos hy0)).2
  nlinarith

/-- **Tail-integrated parabolic floor.**  One mass threshold works simultaneously in every
degree.  If the required actual block stays positive on the complete future ray from `a`, then
the literal source tail leaves at least `1/(4*a)` cumulative Jacobi-flux capital at `a`. -/
theorem exists_uniform_cumulativeJacobiFlux_parabolic_lower_bound :
    ∃ W : ℝ, 2 ≤ W ∧ ∀ a ≥ W ^ 2, ∀ n : ℕ, 2 ≤ n →
      (∀ y ∈ Ici a,
        (HTGeometry.momentHankelMatrix
          (fun k => (xiShiftedReciprocalMoment y k).re) (n + 4)).PosDef) →
      1 / (4 * a) ≤ xiShiftedCanonicalAdmissionCumulativeJacobiFlux a n := by
  obtain ⟨W, hW, hfloor⟩ := exists_uniform_literalMassSourceAction_parabolicFloor
  refine ⟨W, hW, ?_⟩
  intro a ha n hn hH
  have hW0 : 0 < W := lt_of_lt_of_le (by norm_num) hW
  have ha0 : 0 < a := lt_of_lt_of_le (sq_pos_of_pos hW0) ha
  have haquarter : 1 / 4 < a := by
    nlinarith [sq_nonneg (W - 2)]
  have htail := integral_Ioi_literalMassSourceAction_eq_currentFlux
    haquarter (by omega : 0 < n) (fun y hy =>
      momentHankel_posDef_of_le (by omega) (hH y hy))
  have hlowerInt : IntegrableOn
      (fun y : ℝ => (1 / 4 : ℝ) * y ^ (-2 : ℝ)) (Ioi a) :=
    (integrableOn_Ioi_rpow_of_lt (by norm_num) ha0).const_mul (1 / 4 : ℝ)
  have hmono :
      (∫ y in Ioi a, (1 / 4 : ℝ) * y ^ (-2 : ℝ)) ≤
        ∫ y in Ioi a,
          xiShiftedCanonicalAdmissionAdaptiveMixedCompletedSourceAction
            (Real.sqrt y) n := by
    apply MeasureTheory.integral_mono_ae hlowerInt htail.1
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with y hy
    change a < y at hy
    have hsource := hfloor y (le_trans ha hy.le) n hn (hH y hy.le)
    calc
      (1 / 4 : ℝ) * y ^ (-2 : ℝ) = 1 / (4 * y ^ 2) := by
        rw [Real.rpow_neg (lt_trans ha0 hy).le, Real.rpow_two]
        ring
      _ ≤ xiShiftedCanonicalAdmissionAdaptiveMixedCompletedSourceAction
          (Real.sqrt y) n := hsource.le
  have hlowerEq :
      (∫ y in Ioi a, (1 / 4 : ℝ) * y ^ (-2 : ℝ)) = 1 / (4 * a) := by
    rw [integral_const_mul, integral_Ioi_rpow_of_lt (by norm_num) ha0]
    norm_num [Real.rpow_neg ha0.le]
    field_simp
  rw [hlowerEq, htail.2] at hmono
  exact hmono

/-- Beyond the terminal frontier of the `(n+4)` block, the future-ray positivity premise in the
tail-integrated floor is automatic. -/
theorem exists_uniform_cumulativeJacobiFlux_parabolic_lower_bound_above_terminalFrontier :
    ∃ W : ℝ, 2 ≤ W ∧ ∀ a ≥ W ^ 2, ∀ n : ℕ, 2 ≤ n →
      xiShiftedHigherBlockTerminalFrontier (n + 2) < a →
      1 / (4 * a) ≤ xiShiftedCanonicalAdmissionCumulativeJacobiFlux a n := by
  obtain ⟨W, hW, hfloor⟩ :=
    exists_uniform_cumulativeJacobiFlux_parabolic_lower_bound
  refine ⟨W, hW, ?_⟩
  intro a ha n hn hfront
  apply hfloor a ha n hn
  intro y hy
  have hW0 : 0 < W := lt_of_lt_of_le (by norm_num) hW
  have ha0 : 0 < a := lt_of_lt_of_le (sq_pos_of_pos hW0) ha
  have hpos := xiShiftedHigherBlock_posDef_of_terminalFrontier_lt
    (n := n + 2) (le_trans ha0.le hy) (lt_of_lt_of_le hfront hy)
  simpa only [Nat.add_assoc] using hpos

/-- **Uniform diagonal flux corridor.**  Above one universal source threshold and strictly beyond
the relevant terminal frontier, dimensionless cumulative Jacobi flux is at least `1/4`, with no
restriction on how mass and degree escape together. -/
theorem exists_uniform_dimensionlessCumulativeJacobiFlux_quarter_floor_above_terminalFrontier :
    ∃ W : ℝ, 2 ≤ W ∧ ∀ w ≥ W, ∀ n : ℕ, 2 ≤ n →
      xiShiftedHigherBlockTerminalFrontier (n + 2) < w ^ 2 →
      1 / 4 ≤ dimensionlessCumulativeJacobiFlux w n := by
  obtain ⟨W, hW, hfloor⟩ :=
    exists_uniform_cumulativeJacobiFlux_parabolic_lower_bound_above_terminalFrontier
  refine ⟨W, hW, ?_⟩
  intro w hw n hn hfront
  have hW0 : 0 < W := lt_of_lt_of_le (by norm_num) hW
  have hw0 : 0 < w := lt_of_lt_of_le hW0 hw
  have hWsq : W ^ 2 ≤ w ^ 2 := by nlinarith
  have hflux := hfloor (w ^ 2) hWsq n hn hfront
  have hactual : (HTGeometry.momentHankelMatrix
      (xiShiftedRealMomentSequence w) (n + 4)).PosDef := by
    change (HTGeometry.momentHankelMatrix
      (fun k => (xiShiftedReciprocalMoment (w ^ 2) k).re) (n + 4)).PosDef
    simpa only [Nat.add_assoc] using
      (xiShiftedHigherBlock_posDef_of_terminalFrontier_lt
        (n := n + 2) (sq_nonneg w) hfront)
  have hw1 : 1 < w := lt_of_lt_of_le (by norm_num) (le_trans hW hw)
  have hnormalized : (HTGeometry.momentHankelMatrix
      (xiShiftedFarRightNormalizedMoment w) (n + 4)).PosDef := by
    have h := xiShiftedFarRightNormalizedHankelMatrix_posDef_of_actual
      hw1 (n + 4) hactual
    simpa only [xiShiftedFarRightNormalizedHankelMatrix] using h
  have hscale := dimensionlessCumulativeJacobiFlux_eq_square_mul_actual
    hw1 (by omega : 0 < n) hnormalized hactual
  rw [hscale]
  have hdiv : (1 / 4 : ℝ) / w ^ 2 ≤
      xiShiftedCanonicalAdmissionCumulativeJacobiFlux (w ^ 2) n := by
    rw [show (1 / 4 : ℝ) / w ^ 2 = 1 / (4 * (w ^ 2)) by ring]
    exact hflux
  have hmul := (div_le_iff₀ (sq_pos_of_pos hw0)).1 hdiv
  nlinarith

end
end XiShiftedCanonicalAdmission
end RHTower
