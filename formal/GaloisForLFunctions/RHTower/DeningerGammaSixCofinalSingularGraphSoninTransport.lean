import GaloisForLFunctions.HTGeometry.GraphSaturationCore
import GaloisForLFunctions.RHTower.DeningerGammaSixCofinalFullGradeSoninTransport
import GaloisForLFunctions.RHTower.DeningerGammaSixTraceIdealSoninStrictLiftObstruction

/-!
# Cofinal Gamma-six singular graph transport

The fixed-total-grade actual Gamma packets constructed at every valuation
depth become one fixed Sonin commutator after division by their strictly
positive source calibration.  This normalization is necessarily unbounded
on the ambient cofinal `ell^(2 : ℕ)` carrier.

This module constructs its exact source-selected graph completion.  Finite
cofinal packets are sent to their ambient `ell^(2 : ℕ)` realization together with
their algebraic unit trace.  The graph is dense in `ell^(2 : ℕ) direct-sum C`, so
completion adds a one-dimensional vertical sector.  Actual normalized Gamma
transport extends uniquely and continuously on this graph completion; its
vertical generator maps to the fixed noncompact Sonin commutator.

The resulting descent classification is sharp: graph transport factors
through ambient `ell^(2 : ℕ)` exactly at neutral total grade.  This is a classifier,
not an assertion that the required Meyer/Rost--Schmid source annihilation
holds.
-/

open Complex Filter Topology
open scoped ENNReal

namespace RHTower

noncomputable section

/-- Finite cofinal depth packets before singular completion. -/
abbrev DeningerGammaSixCofinalFinitePacket := ℕ →₀ ℂ

/-- Coefficient-faithful finite-packet admission into ambient cofinal `ell^(2 : ℕ)`. -/
def deningerGammaSixCofinalFinitePacketAdmission :
    DeningerGammaSixCofinalFinitePacket →ₗ[ℂ] EllTwo :=
  Finsupp.lsum ℂ (fun n => lp.lsingle (E := fun _ : ℕ => ℂ) 2 n)

@[simp] theorem deningerGammaSixCofinalFinitePacketAdmission_single
    (n : ℕ) (c : ℂ) :
    deningerGammaSixCofinalFinitePacketAdmission (Finsupp.single n c) =
      lp.single 2 n c := by
  simp [deningerGammaSixCofinalFinitePacketAdmission]

theorem deningerGammaSixCofinalFinitePacketAdmission_apply
    (c : DeningerGammaSixCofinalFinitePacket) (j : ℕ) :
    deningerGammaSixCofinalFinitePacketAdmission c j = c j := by
  induction c using Finsupp.induction with
  | zero => simp
  | single_add i z c hi hz ih =>
      simp only [map_add, lp.coeFn_add, Pi.add_apply, Finsupp.add_apply, ih]
      rw [deningerGammaSixCofinalFinitePacketAdmission_single,
        lp.single_apply, Finsupp.single_apply, Pi.single_apply]
      simp [eq_comm]

/-- Algebraic unit trace on finite cofinal depth packets. -/
def deningerGammaSixCofinalFinitePacketTrace :
    DeningerGammaSixCofinalFinitePacket →ₗ[ℂ] ℂ :=
  Finsupp.lsum ℂ (fun _ => LinearMap.id)

@[simp] theorem deningerGammaSixCofinalFinitePacketTrace_single
    (n : ℕ) (c : ℂ) :
    deningerGammaSixCofinalFinitePacketTrace (Finsupp.single n c) = c := by
  simp [deningerGammaSixCofinalFinitePacketTrace]

/-! ## Exact singular graph completion -/

/-- Hilbert model of the source-selected singular graph completion. -/
abbrev DeningerGammaSixCofinalSingularGraph :=
  WithLp 2 (EllTwo × ℂ)

/-- The finite graph generated by ambient admission and unit trace. -/
def deningerGammaSixCofinalFiniteGraph :
    Submodule ℂ DeningerGammaSixCofinalSingularGraph :=
  GaloisForLFunctions.HTGeometry.linearGraphSubmodule
    deningerGammaSixCofinalFinitePacketAdmission
    deningerGammaSixCofinalFinitePacketTrace

/-- The joint annihilator of ambient admission and unit trace is zero. -/
theorem deningerGammaSixCofinalFiniteGraph_jointAnnihilator
    (x : EllTwo) (y : ℂ)
    (h : ∀ c : DeningerGammaSixCofinalFinitePacket,
      inner ℂ (deningerGammaSixCofinalFinitePacketAdmission c) x +
        inner ℂ (deningerGammaSixCofinalFinitePacketTrace c) y = 0) :
    x = 0 ∧ y = 0 := by
  have hcoord : ∀ n : ℕ, x n = -y := by
    intro n
    have hn := h (Finsupp.single n 1)
    have hn' : x n + y = 0 := by
      simpa [lp.inner_single_left] using hn
    exact eq_neg_of_add_eq_zero_left hn'
  have hy : y = 0 := by
    by_contra hy
    have hs := (lp.memℓp x).summable (by norm_num)
    change Summable (fun n : ℕ => ‖x n‖ ^ (2 : ℝ)) at hs
    have hsconst : Summable (fun _n : ℕ => ‖y‖ ^ (2 : ℝ)) := by
      exact hs.congr (fun n => by rw [hcoord n, norm_neg])
    have hpos : 0 < ‖y‖ ^ (2 : ℝ) := by positivity
    exact Set.infinite_univ (Set.Finite.of_summable_const hpos hsconst)
  refine ⟨?_, hy⟩
  apply lp.ext
  funext n
  simp [hcoord n, hy]

/-- **Exact graph saturation.**  Completion of finite cofinal packets for
ambient norm plus unit-trace norm is all of `ell^(2 : ℕ) direct-sum C`. -/
theorem deningerGammaSixCofinalFiniteGraph_closure_eq_top :
    deningerGammaSixCofinalFiniteGraph.topologicalClosure = ⊤ := by
  apply GaloisForLFunctions.HTGeometry.linearGraphSubmodule_closure_eq_top_of_annihilator
  exact deningerGammaSixCofinalFiniteGraph_jointAnnihilator

/-- Literal finite graph admission. -/
def deningerGammaSixCofinalFiniteGraphAdmission :
    DeningerGammaSixCofinalFinitePacket →ₗ[ℂ]
      DeningerGammaSixCofinalSingularGraph :=
  (WithLp.linearEquiv 2 ℂ (EllTwo × ℂ)).symm.toLinearMap.comp
    (deningerGammaSixCofinalFinitePacketAdmission.prod
      deningerGammaSixCofinalFinitePacketTrace)

@[simp] theorem deningerGammaSixCofinalFiniteGraphAdmission_ofLp
    (c : DeningerGammaSixCofinalFinitePacket) :
    (deningerGammaSixCofinalFiniteGraphAdmission c).ofLp =
      (deningerGammaSixCofinalFinitePacketAdmission c,
        deningerGammaSixCofinalFinitePacketTrace c) := rfl

/-- Finite actual packets are dense in the explicit graph-completion model. -/
theorem deningerGammaSixCofinalFiniteGraphAdmission_dense :
    DenseRange deningerGammaSixCofinalFiniteGraphAdmission := by
  change Dense
    (deningerGammaSixCofinalFiniteGraph :
      Set DeningerGammaSixCofinalSingularGraph)
  exact Submodule.dense_iff_topologicalClosure_eq_top.mpr
    deningerGammaSixCofinalFiniteGraph_closure_eq_top

/-- Forgetful projection from graph completion to ambient cofinal `ell^(2 : ℕ)`. -/
def deningerGammaSixCofinalGraphAmbientProjection :
    DeningerGammaSixCofinalSingularGraph →L[ℂ] EllTwo :=
  WithLp.fstL 2 ℂ EllTwo ℂ

/-- Continuous singular trace retained by graph completion. -/
def deningerGammaSixCofinalGraphTrace :
    DeningerGammaSixCofinalSingularGraph →L[ℂ] ℂ :=
  WithLp.sndL 2 ℂ EllTwo ℂ

/-- Vertical generator added by source graph completion. -/
def deningerGammaSixCofinalGraphSingularVector :
    DeningerGammaSixCofinalSingularGraph :=
  WithLp.toLp 2 ((0 : EllTwo), (1 : ℂ))

@[simp] theorem deningerGammaSixCofinalGraphAmbientProjection_singularVector :
    deningerGammaSixCofinalGraphAmbientProjection
      deningerGammaSixCofinalGraphSingularVector = 0 := by
  rfl

@[simp] theorem deningerGammaSixCofinalGraphTrace_singularVector :
    deningerGammaSixCofinalGraphTrace
      deningerGammaSixCofinalGraphSingularVector = 1 := by
  rfl

theorem deningerGammaSixCofinalGraphSingularVector_ne_zero :
    deningerGammaSixCofinalGraphSingularVector ≠ 0 := by
  intro h
  have ht := congrArg deningerGammaSixCofinalGraphTrace h
  rw [deningerGammaSixCofinalGraphTrace_singularVector, map_zero] at ht
  exact one_ne_zero ht

/-! ## Explicit cofinal approach to the vertical sector -/

def deningerGammaSixCofinalPacketPrefix (n : ℕ) : Finset ℕ :=
  Finset.range (n + 1)

/-- Uniform finite average of the first `n+1` cofinal depth packets. -/
def deningerGammaSixCofinalAveragingPacket
    (n : ℕ) : DeningerGammaSixCofinalFinitePacket :=
  (deningerGammaSixCofinalPacketPrefix n).sum fun i =>
    Finsupp.single i (((n + 1 : ℝ) : ℂ)⁻¹)

@[simp] theorem deningerGammaSixCofinalFinitePacketTrace_averagingPacket
    (n : ℕ) :
    deningerGammaSixCofinalFinitePacketTrace
        (deningerGammaSixCofinalAveragingPacket n) = 1 := by
  rw [deningerGammaSixCofinalAveragingPacket, map_sum]
  simp only [deningerGammaSixCofinalFinitePacketTrace_single,
    Finset.sum_const, nsmul_eq_mul, deningerGammaSixCofinalPacketPrefix,
    Finset.card_range]
  have hne : ((((n : ℝ) + 1 : ℝ) : ℂ)) ≠ 0 := by
    exact_mod_cast (by positivity : (n + 1 : ℝ) ≠ 0)
  rw [show ((n + 1 : ℕ) : ℂ) = ((((n : ℝ) + 1 : ℝ) : ℂ)) by norm_cast]
  exact mul_inv_cancel₀ hne

@[simp] theorem deningerGammaSixCofinalAveragingPacket_apply
    (n j : ℕ) :
    deningerGammaSixCofinalAveragingPacket n j =
      if j ∈ deningerGammaSixCofinalPacketPrefix n then
        (((n + 1 : ℝ) : ℂ)⁻¹) else 0 := by
  classical
  simp [deningerGammaSixCofinalAveragingPacket, Finsupp.single_apply]

theorem norm_sq_deningerGammaSixCofinalFinitePacketAdmission_averagingPacket
    (n : ℕ) :
    ‖deningerGammaSixCofinalFinitePacketAdmission
        (deningerGammaSixCofinalAveragingPacket n)‖ ^ 2 =
      (n + 1 : ℝ)⁻¹ := by
  rw [HilbertSchmidt.lp_norm_sq_eq]
  rw [show (fun j : ℕ =>
      ‖(deningerGammaSixCofinalFinitePacketAdmission
        (deningerGammaSixCofinalAveragingPacket n) : ℕ → ℂ) j‖ ^ 2) =
      fun j => if j ∈ deningerGammaSixCofinalPacketPrefix n then
        ((n + 1 : ℝ)⁻¹) ^ 2 else 0 by
    funext j
    rw [deningerGammaSixCofinalFinitePacketAdmission_apply,
      deningerGammaSixCofinalAveragingPacket_apply]
    by_cases hj : j ∈ deningerGammaSixCofinalPacketPrefix n
    · simp only [if_pos hj]
      rw [norm_inv, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (by positivity : (0 : ℝ) < n + 1)]
    · simp [hj]]
  rw [tsum_eq_sum (s := deningerGammaSixCofinalPacketPrefix n)
    (fun j hj => by simp [hj])]
  rw [Finset.sum_ite_mem, Finset.inter_self, Finset.sum_const,
    deningerGammaSixCofinalPacketPrefix, Finset.card_range, nsmul_eq_mul]
  have hne : (n + 1 : ℝ) ≠ 0 := by positivity
  push_cast
  field_simp

theorem tendsto_deningerGammaSixCofinalFinitePacketAdmission_averagingPacket :
    Tendsto (fun n => deningerGammaSixCofinalFinitePacketAdmission
      (deningerGammaSixCofinalAveragingPacket n)) atTop (nhds 0) := by
  rw [NormedAddGroup.tendsto_nhds_zero]
  intro epsilon hepsilon
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / epsilon ^ 2)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hsq :
      ‖deningerGammaSixCofinalFinitePacketAdmission
          (deningerGammaSixCofinalAveragingPacket n)‖ ^ 2 < epsilon ^ 2 := by
    rw [norm_sq_deningerGammaSixCofinalFinitePacketAdmission_averagingPacket]
    have hn1 : 1 / epsilon ^ 2 < (n + 1 : ℝ) := by
      calc
        1 / epsilon ^ 2 < (N : ℝ) := by exact_mod_cast hN
        _ ≤ n := by exact_mod_cast hn
        _ < n + 1 := by norm_num
    have hnpos : (0 : ℝ) < n + 1 := by positivity
    rw [inv_lt_iff_one_lt_mul₀ hnpos]
    have heps : 0 < epsilon ^ 2 := sq_pos_of_pos hepsilon
    have hprod : 1 < (n + 1 : ℝ) * epsilon ^ 2 :=
      (div_lt_iff₀ heps).mp hn1
    nlinarith
  nlinarith [norm_nonneg
    (deningerGammaSixCofinalFinitePacketAdmission
      (deningerGammaSixCofinalAveragingPacket n))]

/-- Uniform actual cofinal packets converge to the nonzero vertical graph
generator while disappearing in ambient `ell^(2 : ℕ)`. -/
theorem tendsto_deningerGammaSixCofinalFiniteGraphAdmission_averagingPacket :
    Tendsto (fun n => deningerGammaSixCofinalFiniteGraphAdmission
        (deningerGammaSixCofinalAveragingPacket n))
      atTop (nhds deningerGammaSixCofinalGraphSingularVector) := by
  have htrace : Tendsto
      (fun n => deningerGammaSixCofinalFinitePacketTrace
        (deningerGammaSixCofinalAveragingPacket n))
      atTop (nhds (1 : ℂ)) := by
    simpa only [deningerGammaSixCofinalFinitePacketTrace_averagingPacket] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => (1 : ℂ)) atTop (nhds 1))
  have hpair : Tendsto
      (fun n =>
        (deningerGammaSixCofinalFinitePacketAdmission
            (deningerGammaSixCofinalAveragingPacket n),
          deningerGammaSixCofinalFinitePacketTrace
            (deningerGammaSixCofinalAveragingPacket n)))
      atTop (nhds ((0 : EllTwo), (1 : ℂ))) := by
    simpa only [nhds_prod_eq] using
      tendsto_deningerGammaSixCofinalFinitePacketAdmission_averagingPacket.prodMk
        htrace
  exact ((WithLp.prodContinuousLinearEquiv 2 ℂ EllTwo ℂ).symm.continuous.tendsto _).comp hpair

/-! ## Actual Gamma packets and fixed Sonin transport -/

/-- Source-normalized actual Gamma/co-Poisson orientation Gram at cofinal
depth `n+3`.  Normalization uses only the positive source calibration. -/
def deningerGammaSixCofinalNormalizedActualGammaPacket
    (g : ℝ) (n : ℕ) : DeningerGammaSixSoninPhysicalOperator :=
  let m := deningerGammaSixHonestDepth n
  (((2 * deningerGammaSixCofinalGammaSoninCalibration m : ℝ) : ℂ)⁻¹) •
    ((routeRCrossPrimeStokesGauge 2 3 g : ℝ) : ℂ) •
      finiteArchimedeanEulerOrientationGram 1
        (fun i ↦ (primeTwoThreePacket i : ℝ))
        (deningerGammaSixCofinalFullGradeGammaPacket g m)

/-- Every source-normalized actual Gamma packet is literally the same fixed
Sonin commutator. -/
theorem deningerGammaSixCofinalNormalizedActualGammaPacket_eq
    (g : ℝ) (n : ℕ) :
    deningerGammaSixCofinalNormalizedActualGammaPacket g n =
      deningerGammaSixFixedSoninPhysicalReceiver g := by
  let m := deningerGammaSixHonestDepth n
  have h :=
    deningerGammaSixCofinalFullGradeGamma_orientationGram_eq_soninCommutator
      1 g m
  have hK :
      (((2 * deningerGammaSixCofinalGammaSoninCalibration m : ℝ) : ℂ)) ≠ 0 := by
    exact_mod_cast mul_ne_zero (by norm_num : (2 : ℝ) ≠ 0)
      (ne_of_gt (deningerGammaSixCofinalGammaSoninCalibration_pos m))
  rw [deningerGammaSixCofinalNormalizedActualGammaPacket]
  change (((2 * deningerGammaSixCofinalGammaSoninCalibration m : ℝ) : ℂ)⁻¹) •
      (((routeRCrossPrimeStokesGauge 2 3 g : ℝ) : ℂ) •
        finiteArchimedeanEulerOrientationGram 1
          (fun i ↦ (primeTwoThreePacket i : ℝ))
          (deningerGammaSixCofinalFullGradeGammaPacket g m)) = _
  rw [h, smul_smul, inv_mul_cancel₀ hK, one_smul]
  rfl

/-- Finite linear transport assembled from genuine normalized Gamma packets. -/
def deningerGammaSixCofinalFiniteActualGammaTransport
    (g : ℝ) : DeningerGammaSixCofinalFinitePacket →ₗ[ℂ]
      DeningerGammaSixSoninPhysicalOperator :=
  Finsupp.lsum ℂ (fun n => LinearMap.toSpanSingleton ℂ _
    (deningerGammaSixCofinalNormalizedActualGammaPacket g n))

/-- Finite actual Gamma transport depends exactly on the singular unit trace. -/
theorem deningerGammaSixCofinalFiniteActualGammaTransport_eq
    (g : ℝ) (c : DeningerGammaSixCofinalFinitePacket) :
    deningerGammaSixCofinalFiniteActualGammaTransport g c =
      deningerGammaSixCofinalFinitePacketTrace c •
        deningerGammaSixFixedSoninPhysicalReceiver g := by
  have hmaps : deningerGammaSixCofinalFiniteActualGammaTransport g =
      deningerGammaSixCofinalFinitePacketTrace.smulRight
        (deningerGammaSixFixedSoninPhysicalReceiver g) := by
    apply Finsupp.lhom_ext
    intro n z
    simp [deningerGammaSixCofinalFiniteActualGammaTransport,
      deningerGammaSixCofinalNormalizedActualGammaPacket_eq,
      deningerGammaSixCofinalFinitePacketTrace]
  exact LinearMap.congr_fun hmaps c

/-- Unique continuous singular transport on the graph completion. -/
def deningerGammaSixCofinalGraphPhysicalTransport
    (g : ℝ) : DeningerGammaSixCofinalSingularGraph →L[ℂ]
      DeningerGammaSixSoninPhysicalOperator :=
  (WithLp.sndL 2 ℂ EllTwo ℂ).smulRight
    (deningerGammaSixFixedSoninPhysicalReceiver g)

@[simp] theorem deningerGammaSixCofinalGraphPhysicalTransport_apply
    (g : ℝ) (z : DeningerGammaSixCofinalSingularGraph) :
    deningerGammaSixCofinalGraphPhysicalTransport g z =
      z.ofLp.2 • deningerGammaSixFixedSoninPhysicalReceiver g := by
  rfl

/-- Graph transport agrees with literal finite actual-Gamma assembly. -/
theorem deningerGammaSixCofinalGraphPhysicalTransport_finiteGraph
    (g : ℝ) (c : DeningerGammaSixCofinalFinitePacket) :
    deningerGammaSixCofinalGraphPhysicalTransport g
        (deningerGammaSixCofinalFiniteGraphAdmission c) =
      deningerGammaSixCofinalFiniteActualGammaTransport g c := by
  rw [deningerGammaSixCofinalGraphPhysicalTransport_apply,
    deningerGammaSixCofinalFiniteGraphAdmission_ofLp,
    deningerGammaSixCofinalFiniteActualGammaTransport_eq]

/-- Density makes the singular physical extension forced, not chosen. -/
theorem deningerGammaSixCofinalGraphPhysicalTransport_unique
    (g : ℝ)
    (F : DeningerGammaSixCofinalSingularGraph →L[ℂ]
      DeningerGammaSixSoninPhysicalOperator)
    (hF : ∀ c : DeningerGammaSixCofinalFinitePacket,
      F (deningerGammaSixCofinalFiniteGraphAdmission c) =
        deningerGammaSixCofinalFiniteActualGammaTransport g c) :
    F = deningerGammaSixCofinalGraphPhysicalTransport g := by
  apply DFunLike.coe_injective
  refine deningerGammaSixCofinalFiniteGraphAdmission_dense.equalizer
    F.continuous (deningerGammaSixCofinalGraphPhysicalTransport g).continuous ?_
  funext c
  change F (deningerGammaSixCofinalFiniteGraphAdmission c) =
    deningerGammaSixCofinalGraphPhysicalTransport g
      (deningerGammaSixCofinalFiniteGraphAdmission c)
  rw [hF, deningerGammaSixCofinalGraphPhysicalTransport_finiteGraph]

@[simp] theorem deningerGammaSixCofinalGraphPhysicalTransport_singularVector
    (g : ℝ) :
    deningerGammaSixCofinalGraphPhysicalTransport g
        deningerGammaSixCofinalGraphSingularVector =
      deningerGammaSixFixedSoninPhysicalReceiver g := by
  rw [deningerGammaSixCofinalGraphPhysicalTransport_apply]
  change (1 : ℂ) • deningerGammaSixFixedSoninPhysicalReceiver g = _
  rw [one_smul]

/-- Every uniform finite average has the same actual fixed-Sonin value even
though its ambient `ell^(2 : ℕ)` realization tends to zero. -/
theorem deningerGammaSixCofinalFiniteActualGammaTransport_averagingPacket
    (g : ℝ) (n : ℕ) :
    deningerGammaSixCofinalFiniteActualGammaTransport g
        (deningerGammaSixCofinalAveragingPacket n) =
      deningerGammaSixFixedSoninPhysicalReceiver g := by
  rw [deningerGammaSixCofinalFiniteActualGammaTransport_eq,
    deningerGammaSixCofinalFinitePacketTrace_averagingPacket, one_smul]

/-! ## Sharp ambient-descent classification -/

theorem deningerGammaSixFixedSoninPhysicalReceiver_eq_zero_iff (g : ℝ) :
    deningerGammaSixFixedSoninPhysicalReceiver g = 0 ↔ g = 0 := by
  constructor
  · intro h
    have hc : IsCompactOperator
        (deningerGammaSixFixedSoninPhysicalReceiver g) := by
      rw [h]
      exact isCompactOperator_zero
    exact (routeRTwoThreeStokesSoninCommutator_isCompactOperator_iff
      (A := 1) (by norm_num) g).1 hc
  · rintro rfl
    exact deningerGammaSixFixedSoninPhysicalReceiver_zero

/-- Bounded ambient descent means graph transport forgets the singular
coordinate and factors through ambient cofinal `ell^(2 : ℕ)`. -/
def DeningerGammaSixCofinalGraphAmbientDescent (g : ℝ) : Prop :=
  ∃ F : EllTwo →L[ℂ] DeningerGammaSixSoninPhysicalOperator,
    deningerGammaSixCofinalGraphPhysicalTransport g =
      F.comp deningerGammaSixCofinalGraphAmbientProjection

/-- **Singular graph descent law.**  Actual normalized Gamma transport
factors through ambient `ell^(2 : ℕ)` exactly at neutral total grade. -/
theorem deningerGammaSixCofinalGraphAmbientDescent_iff (g : ℝ) :
    DeningerGammaSixCofinalGraphAmbientDescent g ↔ g = 0 := by
  constructor
  · rintro ⟨F, hF⟩
    apply (deningerGammaSixFixedSoninPhysicalReceiver_eq_zero_iff g).1
    have hs := congrArg
      (fun T => T deningerGammaSixCofinalGraphSingularVector) hF
    rw [deningerGammaSixCofinalGraphPhysicalTransport_singularVector,
      ContinuousLinearMap.comp_apply,
      deningerGammaSixCofinalGraphAmbientProjection_singularVector,
      map_zero] at hs
    exact hs
  · rintro rfl
    refine ⟨0, ?_⟩
    apply ContinuousLinearMap.ext
    intro z
    simp [deningerGammaSixCofinalGraphPhysicalTransport_apply,
      deningerGammaSixFixedSoninPhysicalReceiver_zero]

end

