import GaloisForLFunctions.RHTower.CriticalCenteredPrimeTailEulerPrimitive
import Mathlib.Analysis.Complex.HasPrimitives

/-!
# Entire carrier of the centered prime-tail current

The centered current is not merely regular at the old zeta pole.  Its regular summand

`dslope G 1 - 1`, where `G(s) = (s-1)ζ(s)`, is entire and therefore has a global entire primitive
on the complex plane.  Exponentiating that primitive gives a zero-free gauge.  Multiplication by
`G` produces an entire carrier whose logarithmic derivative is the centered current and whose zero
divisor is exactly the non-polar zeta divisor.

Thus exact `Λ-1` centering is a divisor-preserving pole-removal gauge, not a positivity-preserving
operation and not a mechanism that can move zeros by itself.
-/

open Complex Filter Topology Set

namespace RHTower

noncomputable section

/-- Entire regular summand left after cancellation of the zeta pole. -/
def centeredPrimeTailGaugeDerivative (s : ℂ) : ℂ :=
  dslope zetaResidueUnit 1 s - 1

/-- The gauge derivative is entire. -/
theorem analyticAt_centeredPrimeTailGaugeDerivative (s : ℂ) :
    AnalyticAt ℂ centeredPrimeTailGaugeDerivative s := by
  have hslope : AnalyticAt ℂ (dslope zetaResidueUnit 1) s :=
    analyticAt_dslope_of_analyticAt zetaResidueUnit_analyticAt
      (analyticAt_zetaResidueUnit s)
  exact hslope.sub analyticAt_const

theorem differentiable_centeredPrimeTailGaugeDerivative :
    Differentiable ℂ centeredPrimeTailGaugeDerivative :=
  fun s => (analyticAt_centeredPrimeTailGaugeDerivative s).differentiableAt

/-- The entire gauge derivative has a global primitive, normalized to vanish at `1`. -/
theorem exists_centeredPrimeTailGaugePrimitive :
    ∃ B : ℂ → ℂ, B 1 = 0 ∧
      ∀ s : ℂ, HasDerivAt B (centeredPrimeTailGaugeDerivative s) s := by
  obtain ⟨F, hF⟩ := differentiable_centeredPrimeTailGaugeDerivative.isExactOn_univ
  refine ⟨fun s => F s - F 1, by simp, fun s => ?_⟩
  exact (hF s (mem_univ s)).sub_const (F 1)

/-- Canonical choice of normalized entire primitive of the centered gauge derivative. -/
def centeredPrimeTailGaugePrimitive : ℂ → ℂ :=
  exists_centeredPrimeTailGaugePrimitive.choose

@[simp] theorem centeredPrimeTailGaugePrimitive_one :
    centeredPrimeTailGaugePrimitive 1 = 0 :=
  exists_centeredPrimeTailGaugePrimitive.choose_spec.1

theorem hasDerivAt_centeredPrimeTailGaugePrimitive (s : ℂ) :
    HasDerivAt centeredPrimeTailGaugePrimitive (centeredPrimeTailGaugeDerivative s) s :=
  exists_centeredPrimeTailGaugePrimitive.choose_spec.2 s

theorem differentiable_centeredPrimeTailGaugePrimitive :
    Differentiable ℂ centeredPrimeTailGaugePrimitive :=
  fun s => (hasDerivAt_centeredPrimeTailGaugePrimitive s).differentiableAt

theorem analyticAt_centeredPrimeTailGaugePrimitive (s : ℂ) :
    AnalyticAt ℂ centeredPrimeTailGaugePrimitive s := by
  exact (analyticOnNhd_univ_iff_differentiable.mpr
    differentiable_centeredPrimeTailGaugePrimitive) s (mem_univ s)

/-- Zero-free exponential gauge generated by the centered zeta-tail density. -/
def centeredPrimeTailEntireGauge (s : ℂ) : ℂ :=
  Complex.exp (centeredPrimeTailGaugePrimitive s)

theorem analyticAt_centeredPrimeTailEntireGauge (s : ℂ) :
    AnalyticAt ℂ centeredPrimeTailEntireGauge s :=
  (analyticAt_centeredPrimeTailGaugePrimitive s).cexp

theorem centeredPrimeTailEntireGauge_ne_zero (s : ℂ) :
    centeredPrimeTailEntireGauge s ≠ 0 :=
  Complex.exp_ne_zero _

@[simp] theorem centeredPrimeTailEntireGauge_one :
    centeredPrimeTailEntireGauge 1 = 1 := by
  rw [centeredPrimeTailEntireGauge, centeredPrimeTailGaugePrimitive_one, Complex.exp_zero]

/-- Entire carrier obtained by applying the centered zero-free gauge to the pole-filled zeta unit. -/
def centeredPrimeTailEntireCarrier (s : ℂ) : ℂ :=
  zetaResidueUnit s * centeredPrimeTailEntireGauge s

theorem analyticAt_centeredPrimeTailEntireCarrier (s : ℂ) :
    AnalyticAt ℂ centeredPrimeTailEntireCarrier s :=
  (analyticAt_zetaResidueUnit s).mul (analyticAt_centeredPrimeTailEntireGauge s)

theorem differentiable_centeredPrimeTailEntireCarrier :
    Differentiable ℂ centeredPrimeTailEntireCarrier :=
  fun s => (analyticAt_centeredPrimeTailEntireCarrier s).differentiableAt

@[simp] theorem centeredPrimeTailEntireCarrier_one :
    centeredPrimeTailEntireCarrier 1 = 1 := by
  rw [centeredPrimeTailEntireCarrier, zetaResidueUnit_one,
    centeredPrimeTailEntireGauge_one, mul_one]

/-- Centering preserves the complete non-polar zeta divisor. -/
theorem centeredPrimeTailEntireCarrier_eq_zero_iff (s : ℂ) :
    centeredPrimeTailEntireCarrier s = 0 ↔ zetaResidueUnit s = 0 := by
  rw [centeredPrimeTailEntireCarrier, mul_eq_zero]
  exact or_iff_left (centeredPrimeTailEntireGauge_ne_zero s)

/-- Away from the removed pole, carrier zeros are exactly zeta zeros. -/
theorem centeredPrimeTailEntireCarrier_eq_zero_iff_riemannZeta
    {s : ℂ} (hs : s ≠ 1) :
    centeredPrimeTailEntireCarrier s = 0 ↔ riemannZeta s = 0 := by
  rw [centeredPrimeTailEntireCarrier_eq_zero_iff, zetaResidueUnit,
    Function.update_of_ne hs, mul_eq_zero]
  exact or_iff_right (sub_ne_zero.mpr hs)

/-- The logarithmic derivative of the zero-free gauge is its prescribed centered derivative. -/
theorem logDeriv_centeredPrimeTailEntireGauge (s : ℂ) :
    logDeriv centeredPrimeTailEntireGauge s = centeredPrimeTailGaugeDerivative s := by
  change logDeriv (fun z => Complex.exp (centeredPrimeTailGaugePrimitive z)) s = _
  rw [logDeriv_apply,
    (hasDerivAt_centeredPrimeTailGaugePrimitive s).cexp.deriv]
  field_simp [Complex.exp_ne_zero]

/-- Wherever the carrier is nonzero, its logarithmic derivative is the pole-cancelled centered
prime-tail current. -/
theorem logDeriv_centeredPrimeTailEntireCarrier {s : ℂ}
    (hG : zetaResidueUnit s ≠ 0) :
    logDeriv centeredPrimeTailEntireCarrier s = centeredPrimeTailCurrentContinuation s := by
  change logDeriv (fun z => zetaResidueUnit z * centeredPrimeTailEntireGauge z) s = _
  rw [logDeriv_mul s hG (centeredPrimeTailEntireGauge_ne_zero s)
    (analyticAt_zetaResidueUnit s).differentiableAt
    (analyticAt_centeredPrimeTailEntireGauge s).differentiableAt]
  rw [logDeriv_centeredPrimeTailEntireGauge]
  simp only [centeredPrimeTailCurrentContinuation, centeredPrimeTailGaugeDerivative]
  ring

/-- At the removed pole, the entire carrier has logarithmic derivative `2γ-1`. -/
theorem logDeriv_centeredPrimeTailEntireCarrier_one :
    logDeriv centeredPrimeTailEntireCarrier 1 =
      2 * (Real.eulerMascheroniConstant : ℂ) - 1 := by
  rw [logDeriv_centeredPrimeTailEntireCarrier (by rw [zetaResidueUnit_one]; norm_num),
    centeredPrimeTailCurrentContinuation_one]

/-- RH is equivalently zero-freeness of the centered entire carrier to the right of the critical
line.  Trivial zeta zeros remain present on the left, as divisor preservation requires. -/
theorem riemannHypothesis_iff_centeredPrimeTailEntireCarrier_ne_zero_of_half_lt_re :
    RiemannHypothesis ↔
      ∀ s : ℂ, 1 / 2 < s.re → centeredPrimeTailEntireCarrier s ≠ 0 := by
  rw [riemannHypothesis_iff_riemannZeta_ne_zero_of_half_lt_re]
  constructor
  · intro h s hre hs
    have hs1 : s ≠ 1 := by
      intro heq
      rw [heq, centeredPrimeTailEntireCarrier_one] at hs
      norm_num at hs
    exact h s hre ((centeredPrimeTailEntireCarrier_eq_zero_iff_riemannZeta hs1).mp hs)
  · intro h s hre hz
    have hs1 : s ≠ 1 := by
      intro heq
      rw [heq] at hz
      exact riemannZeta_one_ne_zero hz
    exact h s hre ((centeredPrimeTailEntireCarrier_eq_zero_iff_riemannZeta hs1).mpr hz)

end

end RHTower
