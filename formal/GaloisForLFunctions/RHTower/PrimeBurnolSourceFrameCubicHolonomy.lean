import GaloisForLFunctions.RHTower.PrimeBurnolFiniteModularSupport
import GaloisForLFunctions.HTGeometry.SourceFrameModularHolonomy

/-!
# Prime Burnol source-frame cubic holonomy

Every injectively labelled finite literal Burnol packet has an invertible complete Gram. This file
uses that canonical unit as source density, crosses it with an arbitrary finite completion frame,
and specializes source-frame modular holonomy and cubic transgression without discarding any
off-diagonal prime/depth coefficient.
-/

open Complex Matrix

namespace RHTower

noncomputable section

open GaloisForLFunctions.HTGeometry

/-- Canonical unit represented by the complete literal finite Burnol Gram. -/
def primeBurnolWindowGramUnit
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) : (Matrix (Fin N) (Fin N) ℂ)ˣ :=
  (primeBurnolWindowGramMatrix_isUnit pe hpe kappa).unit

@[simp] theorem coe_primeBurnolWindowGramUnit
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) :
    (↑(primeBurnolWindowGramUnit pe hpe kappa) : Matrix (Fin N) (Fin N) ℂ) =
      primeBurnolWindowGramMatrix pe kappa := by
  exact IsUnit.unit_spec _

/-- Literal finite Burnol source density crossed with an arbitrary finite completion frame. -/
def primeBurnolSourceFrameHolonomy
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    (Matrix (Fin N) (Fin N) ℂ)ˣ :=
  sourceFrameModularHolonomy (primeBurnolWindowGramUnit pe hpe kappa) u

/-- Source-frame holonomy composes by the exact nonabelian cocycle law. -/
theorem primeBurnolSourceFrameHolonomy_mul
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u v : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    primeBurnolSourceFrameHolonomy pe hpe kappa (u * v) =
      primeBurnolSourceFrameHolonomy pe hpe kappa u * u *
        primeBurnolSourceFrameHolonomy pe hpe kappa v * u⁻¹ := by
  exact sourceFrameModularHolonomy_mul _ u v

/-- Frame reversal inverts the literal Burnol holonomy up to frame gauge. -/
theorem primeBurnolSourceFrameHolonomy_inv
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    primeBurnolSourceFrameHolonomy pe hpe kappa u⁻¹ =
      u⁻¹ * (primeBurnolSourceFrameHolonomy pe hpe kappa u)⁻¹ * u := by
  exact sourceFrameModularHolonomy_inv _ u

/-- The literal Burnol holonomy is trivial exactly for frames commuting with the complete Gram. -/
theorem primeBurnolSourceFrameHolonomy_eq_one_iff
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    primeBurnolSourceFrameHolonomy pe hpe kappa u = 1 ↔
      primeBurnolWindowGramUnit pe hpe kappa * u =
        u * primeBurnolWindowGramUnit pe hpe kappa := by
  exact sourceFrameModularHolonomy_eq_one_iff _ u

/-- Every finite literal Burnol source-frame holonomy is determinant-blind. -/
theorem det_primeBurnolSourceFrameHolonomy
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ) :
    Matrix.det
      (↑(primeBurnolSourceFrameHolonomy pe hpe kappa u) :
        Matrix (Fin N) (Fin N) ℂ) = 1 := by
  exact det_sourceFrameModularHolonomy _ u

/-- Cubic extension defect generated by literal Burnol source and a completion frame. -/
def primeBurnolSourceFrameCubicDefect
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ)
    (p : Matrix (Fin N) (Fin N) ℂ) : Matrix (Fin N) (Fin N) ℂ :=
  sourceFrameCubicDefect (primeBurnolWindowGramUnit pe hpe kappa) u p

/-- Exact modular anomaly of the literal Burnol source-frame cubic defect. -/
def primeBurnolSourceFrameCubicAnomaly
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ)
    (p : Matrix (Fin N) (Fin N) ℂ) : Matrix (Fin N) (Fin N) ℂ :=
  sourceFrameCubicAnomaly (primeBurnolWindowGramUnit pe hpe kappa) u p

/-- Any sigma-trace for the literal Burnol modular action reads the cubic extension as its exact
source modular anomaly. -/
theorem IsSigmaTrace.map_primeBurnolSourceFrameCubicDefect
    {N : ℕ} (pe : Fin N → Nat.Primes × ℕ) (hpe : Function.Injective pe)
    (kappa : Fin N → ℝ) (u : (Matrix (Fin N) (Fin N) ℂ)ˣ)
    (p : Matrix (Fin N) (Fin N) ℂ) (hp : p * p = p)
    (tau : Matrix (Fin N) (Fin N) ℂ →+ ℂ)
    (htau : IsSigmaTrace
      (sourceModularAutomorphism (primeBurnolWindowGramUnit pe hpe kappa)) tau) :
    tau (primeBurnolSourceFrameCubicDefect pe hpe kappa u p) =
      tau (primeBurnolSourceFrameCubicAnomaly pe hpe kappa u p) := by
  exact htau.map_sourceFrameCubicDefect _ u p hp tau

end

end RHTower
