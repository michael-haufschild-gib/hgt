import GaloisForLFunctions.HTGeometry.EulerContractionResidueSigns
import GaloisForLFunctions.RHTower.XiEntireReal

/-!
# The balanced source-depth connection has opposite residues at paired real Xi zeros

In the centered coordinate the reflection-balanced connection generated by exponent-depth
succession is the Euler contraction `-z (log Ξ_c)'(z)` of the logarithmic connection form.  The
centered completed zeta function is even, so a real zero at `a > 0` is paired with one at `-a`,
and the contraction carries residues `-n a` and `+n a` there.  The two signs are opposite, so no
fixed orientation survives: the contracted scalar is neither a Herglotz nor an anti-Herglotz
carrier, whatever the location of the zeros.  The uncontracted connection form is unaffected —
all of its residues equal the multiplicity.
-/

open Filter Topology Complex
open GaloisForLFunctions.HTGeometry

namespace RHTower

theorem meromorphicAt_XiC (a : ℂ) : MeromorphicAt XiC a :=
  ((XiC_differentiable.differentiableOn.analyticOnNhd isOpen_univ) a
    (Set.mem_univ a)).meromorphicAt

/-- Residue of the centered Xi Euler contraction at a divisor point of order `n`. -/
theorem tendsto_xiEulerContraction_residue {a : ℂ} {n : ℤ}
    (horder : meromorphicOrderAt XiC a = n) :
    Tendsto (fun z => (z - a) * eulerContraction XiC z) (𝓝[≠] a) (𝓝 (-(n : ℂ) * a)) :=
  tendsto_eulerContraction_residue (meromorphicAt_XiC a) horder

/-- The reflected divisor point carries the opposite residue. -/
theorem tendsto_xiEulerContraction_residue_reflected {a : ℂ} {n : ℤ}
    (horder : meromorphicOrderAt XiC a = n) :
    Tendsto (fun z => (z + a) * eulerContraction XiC z) (𝓝[≠] (-a)) (𝓝 ((n : ℂ) * a)) :=
  tendsto_eulerContraction_residue_reflected (meromorphicAt_XiC a) horder XiC_even

/-- **The balanced scalar is neither Herglotz nor anti-Herglotz.**  A real zero `a > 0` of the
centered completed zeta function of multiplicity `n ≥ 1` forces the Euler-contracted connection
to carry the residues `-n a` and `+n a` at `a` and `-a`, and no fixed sign convention admits
both. -/
theorem xiEulerContraction_residues_opposite {a : ℝ} (ha : 0 < a) {n : ℤ} (hn : 1 ≤ n)
    (horder : meromorphicOrderAt XiC (a : ℂ) = n) :
    Tendsto (fun z => (z - (a : ℂ)) * eulerContraction XiC z) (𝓝[≠] (a : ℂ))
        (𝓝 (-(n : ℂ) * (a : ℂ))) ∧
      Tendsto (fun z => (z + (a : ℂ)) * eulerContraction XiC z) (𝓝[≠] (-(a : ℂ)))
        (𝓝 ((n : ℂ) * (a : ℂ))) ∧
      ¬ ∃ ε : ℝ, (ε = 1 ∨ ε = -1) ∧ 0 < ε * (-(n : ℝ) * a) ∧ 0 < ε * ((n : ℝ) * a) :=
  ⟨tendsto_xiEulerContraction_residue horder,
    tendsto_xiEulerContraction_residue_reflected horder,
    not_exists_uniform_eulerContraction_residue_sign ha hn⟩

end RHTower
