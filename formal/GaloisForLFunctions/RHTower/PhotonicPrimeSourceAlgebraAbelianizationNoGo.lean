import GaloisForLFunctions.RHTower.PhotonicPrimeSourceFrameNoncommutativityNoGo
import Mathlib.Algebra.Algebra.IsSimpleRing
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.LinearCombination

/-!
# The literal prime Maxwell source algebra has no commutative quotient

For distinct primes, the commutator of the nilpotent parts of their physical
two-cycle transfers squares to a nonzero scalar identity. Thus the ideal
generated by commutators already contains the unit. This rules out every
unital commutative complex-algebra quotient of any source algebra containing
those two cells, not only a chosen common frame or a particular scalar port.

An ordered/nonlinear/nonlocal port and the separate rotating-cylinder source
are outside this no-go. It does not prove or falsify RH.
-/

open Matrix
open scoped Matrix

namespace RHTower

private theorem trace_zero_anticommutator
    (A B : Matrix (Fin 2) (Fin 2) ℂ)
    (hA : Matrix.trace A = 0) (hB : Matrix.trace B = 0) :
    A * B + B * A = (Matrix.trace (A * B)) •
      (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
  have hA11 : A 1 1 = -A 0 0 := by
    simp only [Matrix.trace_fin_two] at hA
    linear_combination hA
  have hB11 : B 1 1 = -B 0 0 := by
    simp only [Matrix.trace_fin_two] at hB
    linear_combination hB
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two,
      Matrix.trace_fin_two, Matrix.smul_apply, hA11, hB11] <;> ring

private theorem traceless_square_zero_commutator_sq
    (A B : Matrix (Fin 2) (Fin 2) ℂ)
    (hA : A * A = 0) (hB : B * B = 0)
    (htrA : Matrix.trace A = 0) (htrB : Matrix.trace B = 0) :
    (A * B - B * A) ^ (2 : ℕ) =
      (Matrix.trace (A * B)) ^ (2 : ℕ) •
        (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
  have hanti := trace_zero_anticommutator A B htrA htrB
  have hzero1 : (A * B) * (B * A) = 0 := by
    calc
      _ = A * (B * B) * A := by simp [mul_assoc]
      _ = 0 := by rw [hB]; simp
  have hzero2 : (B * A) * (A * B) = 0 := by
    calc
      _ = B * (A * A) * B := by simp [mul_assoc]
      _ = 0 := by rw [hA]; simp
  calc
    (A * B - B * A) ^ (2 : ℕ) =
        (A * B) * (A * B) + (B * A) * (B * A) := by
          simp [pow_two, sub_mul, mul_sub, hzero1, hzero2]
    _ = (A * B + B * A) ^ (2 : ℕ) := by
          simp [pow_two, add_mul, mul_add, hzero1, hzero2]
    _ = (Matrix.trace (A * B)) ^ (2 : ℕ) •
          (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
          rw [hanti]
          ext i j
          fin_cases i <;> fin_cases j <;>
            simp [pow_two, Matrix.mul_apply, Fin.sum_univ_two]

/-- Source-specific positive law: the ordered two-prime commutator has a
scalar square. Its scalar is nonzero precisely for distinct primes. -/
theorem ptr_prime_source_commutator_sq (p q : Nat.Primes) :
    (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q -
      photonicPrimeDrivenNilpotent q * photonicPrimeDrivenNilpotent p) ^ (2 : ℕ) =
    (Matrix.trace
      (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q)) ^ (2 : ℕ) •
      (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
  apply traceless_square_zero_commutator_sq
  · exact photonicPrimeDrivenNilpotent_sq p
  · exact photonicPrimeDrivenNilpotent_sq q
  · simp [Matrix.trace_fin_two, photonicPrimeDrivenNilpotent]
  · simp [Matrix.trace_fin_two, photonicPrimeDrivenNilpotent]

private theorem ptr_prime_cross_trace_ne_zero (p q : Nat.Primes) (hpq : p ≠ q) :
    Matrix.trace (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q) ≠ 0 := by
  intro h
  have hn := ptr_prime_nilpotent_cross_trace_re_neg p q hpq
  rw [h] at hn
  norm_num at hn

/-- The source-derived ordered two-prime chirality. It is defined before any
Xi zero or spectral target is selected. -/
noncomputable def ptrPrimePairChirality (p q : Nat.Primes) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  (Matrix.trace
    (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q))⁻¹ •
      (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q -
        photonicPrimeDrivenNilpotent q * photonicPrimeDrivenNilpotent p)

/-- Positive survivor: every distinct-prime ordered chirality is a genuine
involution in the fixed physical Maxwell state. -/
theorem ptr_prime_pair_chirality_sq (p q : Nat.Primes) (hpq : p ≠ q) :
    ptrPrimePairChirality p q ^ (2 : ℕ) = 1 := by
  unfold ptrPrimePairChirality
  rw [smul_pow, ptr_prime_source_commutator_sq, smul_smul]
  simp [ptr_prime_cross_trace_ne_zero p q hpq]

private theorem no_commutative_quotient_of_commutator_unit
    {A C : Type*} [Ring A] [Algebra ℂ A]
    [CommRing C] [Algebra ℂ C] [Nontrivial C]
    (a b : A) (t : ℂ) (ht : t ≠ 0)
    (hsq : (a * b - b * a) ^ (2 : ℕ) = t ^ (2 : ℕ) • (1 : A)) :
    ¬ Nonempty (A →ₐ[ℂ] C) := by
  rintro ⟨F⟩
  have hcomm : F (a * b - b * a) = 0 := by
    simp [map_sub, map_mul, mul_comm]
  have h := congrArg F hsq
  have hz : algebraMap ℂ C (t ^ (2 : ℕ)) = 0 := by
    simpa [hcomm, Algebra.smul_def] using h.symm
  have ht2 : t ^ (2 : ℕ) = 0 := by
    apply RingHom.injective (algebraMap ℂ C)
    simpa using hz
  exact ht (sq_eq_zero_iff.mp ht2)

/-- Any complex source subalgebra containing two distinct literal prime cells
has no nonzero unital commutative complex-algebra landing. -/
theorem ptr_no_commutative_source_algebra_quotient
    (p q : Nat.Primes) (hpq : p ≠ q)
    (S : Subalgebra ℂ (Matrix (Fin 2) (Fin 2) ℂ))
    (hp : photonicPrimeDrivenNilpotent p ∈ S)
    (hq : photonicPrimeDrivenNilpotent q ∈ S)
    {C : Type*} [CommRing C] [Algebra ℂ C] [Nontrivial C] :
    ¬ Nonempty (S →ₐ[ℂ] C) := by
  let A : S := ⟨photonicPrimeDrivenNilpotent p, hp⟩
  let B : S := ⟨photonicPrimeDrivenNilpotent q, hq⟩
  let t : ℂ := Matrix.trace
    (photonicPrimeDrivenNilpotent p * photonicPrimeDrivenNilpotent q)
  have ht : t ≠ 0 := ptr_prime_cross_trace_ne_zero p q hpq
  have hsq : (A * B - B * A) ^ (2 : ℕ) = t ^ (2 : ℕ) • (1 : S) := by
    apply Subtype.ext
    exact ptr_prime_source_commutator_sq p q
  exact no_commutative_quotient_of_commutator_unit A B t ht hsq

/-- In particular, the algebra generated by any two distinct literal prime
cells has no unital commutative complex-algebra quotient. -/
theorem ptr_no_two_prime_generated_commutative_quotient
    (p q : Nat.Primes) (hpq : p ≠ q)
    {C : Type*} [CommRing C] [Algebra ℂ C] [Nontrivial C] :
    ¬ Nonempty
      ((Algebra.adjoin ℂ
        ({photonicPrimeDrivenNilpotent p, photonicPrimeDrivenNilpotent q} :
          Set (Matrix (Fin 2) (Fin 2) ℂ))) →ₐ[ℂ] C) := by
  apply ptr_no_commutative_source_algebra_quotient p q hpq
  · exact Algebra.subset_adjoin (by simp)
  · exact Algebra.subset_adjoin (by simp)

private theorem ptr_literal_two_cycle_eq_one_add_nilpotent (p : Nat.Primes) :
    photonicPrimeTemporalMaxwellCyclicTransfer p ^ (2 : ℕ) =
      1 + photonicPrimeDrivenNilpotent p := by
  rw [photonicPrimeTemporalMaxwellCyclicTransfer_eq_primeCyclicTimeCrystalCell,
    photonicPrimeCyclicTimeCrystalCell_eq_slabCell, pow_two,
    photonicPrimeCyclicSlabCell_sq_eq_one_add_nilpotent]

/-- The no-go concerns the actual physical two-cycle transfers: any source
algebra containing two distinct ones also contains their nilpotent parts. -/
theorem ptr_no_literal_transfer_commutative_quotient
    (p q : Nat.Primes) (hpq : p ≠ q)
    (S : Subalgebra ℂ (Matrix (Fin 2) (Fin 2) ℂ))
    (hp : photonicPrimeTemporalMaxwellCyclicTransfer p ^ (2 : ℕ) ∈ S)
    (hq : photonicPrimeTemporalMaxwellCyclicTransfer q ^ (2 : ℕ) ∈ S)
    {C : Type*} [CommRing C] [Algebra ℂ C] [Nontrivial C] :
    ¬ Nonempty (S →ₐ[ℂ] C) := by
  apply ptr_no_commutative_source_algebra_quotient p q hpq S
  · have h := S.sub_mem hp S.one_mem
    simpa [ptr_literal_two_cycle_eq_one_add_nilpotent] using h
  · have h := S.sub_mem hq S.one_mem
    simpa [ptr_literal_two_cycle_eq_one_add_nilpotent] using h

/-- Unconditional generated-algebra form for the literal source-free temporal
Maxwell cells. No coherent unital commutative Euler landing exists. -/
theorem ptr_literal_transfer_algebra_has_no_commutative_quotient
    (p q : Nat.Primes) (hpq : p ≠ q)
    {C : Type*} [CommRing C] [Algebra ℂ C] [Nontrivial C] :
    ¬ Nonempty
      ((Algebra.adjoin ℂ
        ({photonicPrimeTemporalMaxwellCyclicTransfer p ^ (2 : ℕ),
          photonicPrimeTemporalMaxwellCyclicTransfer q ^ (2 : ℕ)} :
          Set (Matrix (Fin 2) (Fin 2) ℂ))) →ₐ[ℂ] C) := by
  apply ptr_no_literal_transfer_commutative_quotient p q hpq
  · exact Algebra.subset_adjoin (by simp)
  · exact Algebra.subset_adjoin (by simp)

end RHTower
