import GaloisForLFunctions.RHTower.MaassRationalHeckeOrbit
import GaloisForLFunctions.RHTower.SelbergMaassRationalHeckeAutomorphic

/-!
# Joint automorphic rational Hecke orbit

This module lifts the source-attached rational Hecke orbit of one Maass
Eigenspace vector to the automorphic `GL(2, ℝ)` carrier and closes its linear
span under both the right regular `SL(2, ℝ)` action and every positive rational
trace correspondence.

It constructs a concrete joint carrier.  It does not turn rational
correspondences into a local Hecke algebra or construct finite-place factors,
Satake data, or symmetric-power packets.
-/

namespace GaloisForLFunctions.RHTower

open Complex Matrix SpecialLinearGroup GeneralLinearGroup
open scoped MatrixGroups BigOperators

noncomputable section

/-- The linear automorphic lift of a fixed principal-congruence Maass eigenspace. -/
def principalMaassEigenspaceAutomorphicLift (N : ℕ) (lam : ℝ) :
    glMaassCuspEigenspace (principalCongruenceGL N) lam →ₗ[ℂ]
      glAutomorphicFunctionSpace (principalCongruenceGL N) where
  toFun u := glLiftInvariantFunction (principalCongruenceGL N) (maassEigenspaceToInvariant u)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The automorphic span generated by right translates of every positive rational
Hecke-coset image of one source Maass vector. -/
def principalAutomorphicHeckeOrbitSpan (N : ℕ) (lam : ℝ)
    (u : glMaassCuspEigenspace (principalCongruenceGL N) lam) :
    Submodule ℂ (glAutomorphicFunctionSpace (principalCongruenceGL N)) :=
  Submodule.span ℂ (Set.range (fun kd : SL2R × HeckeCoset positiveRationalGLRealImage
    (principalCongruenceGL N) (principalCongruenceGL N) =>
      glAutomorphicRightTranslation (principalCongruenceGL N) kd.1
        (principalMaassEigenspaceAutomorphicLift N lam
          (rationalPrincipalHeckeCosetLinear N lam kd.2 u))))

/-- The automorphic lift intertwines the exact source rational trace and the
carrier-level rational trace. -/
theorem rationalPrincipalGLAutomorphicTrace_apply_principalMaassEigenspaceLift
    (N : ℕ) (g : GL (Fin 2) ℚ)
    (hg : 0 < (g.map (algebraMap ℚ ℝ)).val.det) (lam : ℝ)
    (u : glMaassCuspEigenspace (principalCongruenceGL N) lam) :
    rationalPrincipalGLAutomorphicTrace N g
      (principalMaassEigenspaceAutomorphicLift N lam u) =
        principalMaassEigenspaceAutomorphicLift N lam
          (rationalPrincipalTraceLinear N g hg lam u) := by
  apply Subtype.ext
  funext x
  change (rationalPrincipalGLAutomorphicTrace N g
      (glLiftInvariantFunction (principalCongruenceGL N) (maassEigenspaceToInvariant u))).1 x =
    (glLiftInvariantFunction (principalCongruenceGL N)
      (maassEigenspaceToInvariant (rationalPrincipalTraceLinear N g hg lam u))).1 x
  rw [rationalPrincipalGLAutomorphicTrace_apply_lift]
  rfl

/-- A right translate of the automorphic lift of any source orbit vector belongs
 to the joint automorphic orbit. -/
theorem principalAutomorphicHeckeOrbitSpan_contains_right_lift (N : ℕ) (lam : ℝ)
    (u w : glMaassCuspEigenspace (principalCongruenceGL N) lam)
    (hw : w ∈ principalHeckeOrbitSpan N lam u) (k : SL2R) :
    glAutomorphicRightTranslation (principalCongruenceGL N) k
      (principalMaassEigenspaceAutomorphicLift N lam w) ∈
        principalAutomorphicHeckeOrbitSpan N lam u := by
  let A := principalAutomorphicHeckeOrbitSpan N lam u
  let R := glAutomorphicRightTranslation (principalCongruenceGL N) k
  let L := principalMaassEigenspaceAutomorphicLift N lam
  have hmap : principalHeckeOrbitSpan N lam u ≤ A.comap (R.comp L) := by
    apply Submodule.span_le.2
    rintro x ⟨D, rfl⟩
    exact Submodule.subset_span ⟨(k, D), rfl⟩
  exact hmap hw

/-- Right translations compose according to multiplication in `SL(2, ℝ)`. -/
theorem glAutomorphicRightTranslation_comp_apply (N : ℕ) (k k' : SL2R)
    (F : glAutomorphicFunctionSpace (principalCongruenceGL N)) :
    glAutomorphicRightTranslation (principalCongruenceGL N) k
      (glAutomorphicRightTranslation (principalCongruenceGL N) k' F) =
        glAutomorphicRightTranslation (principalCongruenceGL N) (k * k') F := by
  apply Subtype.ext
  funext x
  change F.1 ((x * Matrix.SpecialLinearGroup.toGL k) *
    Matrix.SpecialLinearGroup.toGL k') =
      F.1 (x * Matrix.SpecialLinearGroup.toGL (k * k'))
  rw [mul_assoc, Matrix.SpecialLinearGroup.toGL.map_mul]

/-- Every positive rational trace preserves the joint automorphic orbit. -/
theorem rationalPrincipalGLAutomorphicTrace_maps_principalAutomorphicHeckeOrbitSpan
    (N : ℕ) (h : GL (Fin 2) ℚ)
    (hh : 0 < (h.map (algebraMap ℚ ℝ)).val.det) (lam : ℝ)
    (u : glMaassCuspEigenspace (principalCongruenceGL N) lam)
    (F : glAutomorphicFunctionSpace (principalCongruenceGL N))
    (hF : F ∈ principalAutomorphicHeckeOrbitSpan N lam u) :
    rationalPrincipalGLAutomorphicTrace N h F ∈
      principalAutomorphicHeckeOrbitSpan N lam u := by
  let A := principalAutomorphicHeckeOrbitSpan N lam u
  let T := rationalPrincipalGLAutomorphicTrace N h
  let L := principalMaassEigenspaceAutomorphicLift N lam
  have hlift (w : glMaassCuspEigenspace (principalCongruenceGL N) lam) :
      T (L w) = L (rationalPrincipalTraceLinear N h hh lam w) := by
    exact rationalPrincipalGLAutomorphicTrace_apply_principalMaassEigenspaceLift N h hh lam w
  have hsource (w : glMaassCuspEigenspace (principalCongruenceGL N) lam)
      (hw : w ∈ principalHeckeOrbitSpan N lam u) (k : SL2R) :
      glAutomorphicRightTranslation (principalCongruenceGL N) k (L w) ∈ A := by
    have hmap : principalHeckeOrbitSpan N lam u ≤
        A.comap ((glAutomorphicRightTranslation (principalCongruenceGL N) k).comp L) := by
      apply Submodule.span_le.2
      rintro x ⟨D, rfl⟩
      exact Submodule.subset_span ⟨(k, D), rfl⟩
    exact hmap hw
  have hgen : ∀ kd : SL2R × HeckeCoset positiveRationalGLRealImage
      (principalCongruenceGL N) (principalCongruenceGL N), T
        (glAutomorphicRightTranslation (principalCongruenceGL N) kd.1
          (L (rationalPrincipalHeckeCosetLinear N lam kd.2 u))) ∈ A := by
    rintro ⟨k, D⟩
    rw [← rationalPrincipalGLAutomorphicTrace_commutes_right]
    rw [hlift]
    apply hsource
    exact rationalPrincipalTraceLinear_orbit_generator_mem N h hh lam u D
  have hmap : A.map T ≤ A := by
    rw [Submodule.map_le_iff_le_comap]
    apply Submodule.span_le.2
    rintro x ⟨kd, rfl⟩
    exact hgen kd
  apply hmap
  exact ⟨F, hF, rfl⟩

/-- The complete right regular `SL(2, ℝ)` action preserves the joint automorphic
rational Hecke orbit. -/
theorem glAutomorphicRightTranslation_maps_principalAutomorphicHeckeOrbitSpan
    (N : ℕ) (lam : ℝ)
    (u : glMaassCuspEigenspace (principalCongruenceGL N) lam) (k : SL2R)
    (F : glAutomorphicFunctionSpace (principalCongruenceGL N))
    (hF : F ∈ principalAutomorphicHeckeOrbitSpan N lam u) :
    glAutomorphicRightTranslation (principalCongruenceGL N) k F ∈
      principalAutomorphicHeckeOrbitSpan N lam u := by
  let A := principalAutomorphicHeckeOrbitSpan N lam u
  let R := glAutomorphicRightTranslation (principalCongruenceGL N) k
  have hgen : ∀ kd : SL2R × HeckeCoset positiveRationalGLRealImage
      (principalCongruenceGL N) (principalCongruenceGL N), R
        (glAutomorphicRightTranslation (principalCongruenceGL N) kd.1
          (principalMaassEigenspaceAutomorphicLift N lam
            (rationalPrincipalHeckeCosetLinear N lam kd.2 u))) ∈ A := by
    rintro ⟨k', D⟩
    rw [glAutomorphicRightTranslation_comp_apply]
    exact Submodule.subset_span ⟨(k * k', D), rfl⟩
  have hmap : A.map R ≤ A := by
    rw [Submodule.map_le_iff_le_comap]
    apply Submodule.span_le.2
    rintro x ⟨kd, rfl⟩
    exact hgen kd
  apply hmap
  exact ⟨F, hF, rfl⟩

end

end GaloisForLFunctions.RHTower
