import GaloisForLFunctions.RHTower.DeningerPlaceRestriction

/-!
# Field automorphisms permute the finite places

A ring automorphism of a Dedekind domain pulls a height-one prime back to a height-one prime, and
the adic valuation is transported: the valuation of `σ r` at `P` is the valuation of `r` at the
pullback of `P`.  The mechanism is the characterization of the adic valuation by divisibility of
the ideal generated by the element, which an automorphism preserves.

Consequently a field automorphism of a number field permutes the finite places: the composite of a
finite place with the automorphism is again a finite place, the one attached to the pulled back
prime.  This is the arithmetic form of the Galois action on the place space.

* `deningerSpectrumComap` : the prime pulled back along an automorphism.
* `deningerIntValuation_comap`, `deningerValuation_comap` : **the adic valuation is transported.**
* `deningerFinitePlaceComap` : **the finite place pulled back along a field automorphism.**
* `deningerFinitePlaceComap_apply` : it computes the composite `w ∘ τ`.
-/

namespace RHTower

open NumberField IsDedekindDomain HeightOneSpectrum WithZero

section IdealTransport

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

omit [IsDedekindDomain R] in
theorem deningerIdeal_map_symm (σ : R ≃+* R) (I : Ideal R) :
    Ideal.map (σ.symm : R →+* R) (Ideal.map (σ : R →+* R) I) = I := by
  rw [Ideal.map_map]
  have h : (σ.symm : R →+* R).comp (σ : R →+* R) = RingHom.id R := by
    ext x
    simp
  rw [h, Ideal.map_id]

omit [IsDedekindDomain R] in
theorem deningerIdeal_map_dvd (σ : R ≃+* R) {I J : Ideal R} (h : I ∣ J) :
    Ideal.map (σ : R →+* R) I ∣ Ideal.map (σ : R →+* R) J := by
  obtain ⟨C, rfl⟩ := h
  exact ⟨Ideal.map (σ : R →+* R) C, Ideal.map_mul _ _ _⟩

omit [IsDedekindDomain R] in
/-- **An automorphism preserves divisibility of ideals.** -/
theorem deningerIdeal_map_dvd_iff (σ : R ≃+* R) (I J : Ideal R) :
    Ideal.map (σ : R →+* R) I ∣ Ideal.map (σ : R →+* R) J ↔ I ∣ J := by
  refine ⟨fun h => ?_, deningerIdeal_map_dvd σ⟩
  have h2 := deningerIdeal_map_dvd σ.symm h
  rwa [deningerIdeal_map_symm, deningerIdeal_map_symm] at h2

/-- **The height-one prime pulled back along a ring automorphism.** -/
def deningerSpectrumComap (σ : R ≃+* R) (P : HeightOneSpectrum R) : HeightOneSpectrum R where
  asIdeal := Ideal.comap (σ : R →+* R) P.asIdeal
  isPrime := Ideal.comap_isPrime _ _
  ne_bot := by
    intro hbot
    have hmap : Ideal.map (σ : R →+* R) (Ideal.comap (σ : R →+* R) P.asIdeal) = P.asIdeal :=
      Ideal.map_comap_of_surjective _ σ.surjective _
    rw [hbot, Ideal.map_bot] at hmap
    exact P.ne_bot hmap.symm

omit [IsDedekindDomain R] in
@[simp] theorem deningerSpectrumComap_asIdeal (σ : R ≃+* R) (P : HeightOneSpectrum R) :
    (deningerSpectrumComap σ P).asIdeal = Ideal.comap (σ : R →+* R) P.asIdeal := rfl

omit [IsDedekindDomain R] in
@[simp] theorem deningerSpectrumComap_map (σ : R ≃+* R) (P : HeightOneSpectrum R) :
    Ideal.map (σ : R →+* R) (deningerSpectrumComap σ P).asIdeal = P.asIdeal :=
  Ideal.map_comap_of_surjective _ σ.surjective _

/-- **The adic valuation on the ring is transported by an automorphism.** -/
theorem deningerIntValuation_comap (σ : R ≃+* R) (P : HeightOneSpectrum R) (r : R) :
    (deningerSpectrumComap σ P).intValuation r = P.intValuation (σ r) := by
  classical
  by_cases hr : r = 0
  · rw [hr, map_zero, map_zero, map_zero]
  · have hσr : σ r ≠ 0 := fun h => hr (by simpa using congrArg σ.symm h)
    have hkey : ∀ n : ℕ,
        ((deningerSpectrumComap σ P).intValuation r ≤ (exp (-(n : ℤ)) : ℤᵐ⁰))
          ↔ (P.intValuation (σ r) ≤ (exp (-(n : ℤ)) : ℤᵐ⁰)) := by
      intro n
      rw [intValuation_le_pow_iff_dvd, intValuation_le_pow_iff_dvd]
      constructor
      · intro h
        have hmap := deningerIdeal_map_dvd σ h
        rwa [Ideal.map_pow, deningerSpectrumComap_map, Ideal.map_span, Set.image_singleton] at hmap
      · intro h
        have hdvd : Ideal.map (σ : R →+* R) ((deningerSpectrumComap σ P).asIdeal ^ n)
            ∣ Ideal.map (σ : R →+* R) (Ideal.span {r}) := by
          rwa [Ideal.map_pow, deningerSpectrumComap_map, Ideal.map_span, Set.image_singleton]
        exact (deningerIdeal_map_dvd_iff σ _ _).mp hdvd
    obtain ⟨m, hm⟩ : ∃ m : ℕ,
        (deningerSpectrumComap σ P).intValuation r = (exp (-(m : ℤ)) : ℤᵐ⁰) :=
      ⟨_, (deningerSpectrumComap σ P).intValuation_if_neg hr⟩
    obtain ⟨k, hk⟩ : ∃ k : ℕ,
        P.intValuation (σ r) = (exp (-(k : ℤ)) : ℤᵐ⁰) :=
      ⟨_, P.intValuation_if_neg hσr⟩
    have h1 := (hkey m).mp (le_of_eq hm)
    have h2 := (hkey k).mpr (le_of_eq hk)
    rw [hk] at h1
    rw [hm] at h2
    rw [hm, hk]
    exact le_antisymm h2 h1

end IdealTransport

section FractionTransport

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

/-- **The adic valuation on the fraction field is transported by an automorphism.** -/
theorem deningerValuation_comap (σ : R ≃+* R) (τ : K ≃+* K)
    (hcomm : ∀ r : R, τ (algebraMap R K r) = algebraMap R K (σ r))
    (P : HeightOneSpectrum R) (x : K) :
    (deningerSpectrumComap σ P).valuation K x = P.valuation K (τ x) := by
  obtain ⟨r, s, hs, rfl⟩ := IsFractionRing.div_surjective (A := R) x
  have hsne : algebraMap R K s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
  rw [map_div₀, map_div₀, map_div₀, hcomm, hcomm, valuation_of_algebraMap,
    valuation_of_algebraMap, valuation_of_algebraMap, valuation_of_algebraMap,
    deningerIntValuation_comap, deningerIntValuation_comap]

end FractionTransport

section AbsNorm

variable {R : Type*} [CommRing R] [IsDedekindDomain R] [Module.Free ℤ R] [Module.Finite ℤ R]

omit [Module.Finite ℤ R] in
/-- **The absolute norm is invariant under an automorphism.** -/
theorem deningerAbsNorm_comap (σ : R ≃+* R) (I : Ideal R) :
    Ideal.absNorm (Ideal.comap (σ : R →+* R) I) = Ideal.absNorm I := by
  have hIJ : I = Ideal.map (σ : R →+* R) (Ideal.comap (σ : R →+* R) I) :=
    (Ideal.map_comap_of_surjective _ σ.surjective _).symm
  have hequiv : (R ⧸ Ideal.comap (σ : R →+* R) I) ≃+* (R ⧸ I) :=
    Ideal.quotientEquiv _ _ σ hIJ
  rw [Ideal.absNorm_apply, Ideal.absNorm_apply, Submodule.cardQuot_apply,
    Submodule.cardQuot_apply]
  exact Nat.card_congr hequiv.toEquiv

end AbsNorm

section NumberFieldPlaces

variable {K : Type*} [Field K] [NumberField K]

/-- The automorphism of the ring of integers induced by a field automorphism. -/
noncomputable def deningerIntegerAut (τ : K ≃+* K) : 𝓞 K ≃+* 𝓞 K :=
  RingOfIntegers.mapRingEquiv τ

omit [NumberField K] in
theorem deningerIntegerAut_algebraMap (τ : K ≃+* K) (r : 𝓞 K) :
    τ (algebraMap (𝓞 K) K r) = algebraMap (𝓞 K) K (deningerIntegerAut τ r) := rfl

/-- **The finite place pulled back along a field automorphism.** -/
noncomputable def deningerFinitePlaceComap (τ : K ≃+* K) (w : FinitePlace K) : FinitePlace K :=
  FinitePlace.mk (deningerSpectrumComap (deningerIntegerAut τ) w.maximalIdeal)

theorem deningerFinitePlaceComap_maximalIdeal (τ : K ≃+* K) (w : FinitePlace K) :
    (deningerFinitePlaceComap τ w).maximalIdeal
      = deningerSpectrumComap (deningerIntegerAut τ) w.maximalIdeal :=
  FinitePlace.maximalIdeal_mk _

/-- **A field automorphism permutes the finite places**: the pulled back place is the composite of
the place with the automorphism. -/
theorem deningerFinitePlaceComap_apply (τ : K ≃+* K) (w : FinitePlace K) (x : K) :
    deningerFinitePlaceComap τ w x = w (τ x) := by
  rw [deningerFinitePlace_eq_adicAbv, deningerFinitePlace_eq_adicAbv,
    deningerFinitePlaceComap_maximalIdeal]
  have hval := deningerValuation_comap (deningerIntegerAut τ) τ
    (deningerIntegerAut_algebraMap τ) w.maximalIdeal x
  have hnorm : ((Ideal.absNorm
        (deningerSpectrumComap (deningerIntegerAut τ) w.maximalIdeal).asIdeal : NNReal))
      = ((Ideal.absNorm w.maximalIdeal.asIdeal : NNReal)) := by
    rw [deningerSpectrumComap_asIdeal, deningerAbsNorm_comap]
  rw [HeightOneSpectrum.adicAbv_def, HeightOneSpectrum.adicAbv_def, hval,
    deningerToNNReal_congr (HeightOneSpectrum.absNorm_ne_zero _)
      (HeightOneSpectrum.absNorm_ne_zero _) hnorm]

end NumberFieldPlaces

end RHTower
