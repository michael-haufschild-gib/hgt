import GaloisForLFunctions.RHTower.ThetaCuspHawkingTeukolskyFiniteMassReflectionRigidity
import GaloisForLFunctions.RHTower.ThetaCuspHawkingTopologicalDarbouxAlgebraicallySpecialCrossing

/-!
# Absorbed-horizon Darboux Cayley reflection rigidity

For normalized absorbed horizon mass `|A_H|²` and real frequency `omega`, the exact
Birmingham--Mokhtari vector-to-scalar horizon multiplier is

`S_H = (Q(Q+2) + 12 i |A_H|² omega) / (Q(Q+2) - 12 i |A_H|² omega)`.

This is the canonical Cayley completion of the gravitational horizon generator.  On a Xi
reflected-real-pair mediator its algebraic weight lies in the negative chamber, so the phase is
regular and unitary.  At nonzero absorption and frequency, equality of reflected phases is
equivalent to equality of algebraic weights, hence exactly to critical-line incidence.

The theorem concerns the exact horizon Darboux channel.  A total nonlinear return determinant may
also carry orthogonal-helicity and continuum channels; equality of its coherent horizon phases is
therefore a dynamical selection law, not a consequence of generic KMS or passivity.
-/

open Complex Real Set Filter Topology

namespace RHTower

noncomputable section

def d4BMXiHorizonDarbouxAlgebraicWeight (q : XiZeroCopy) : ℝ :=
  d4BMXiReflectedRealPairMediatorAngularQ q *
    (d4BMXiReflectedRealPairMediatorAngularQ q + 2)

theorem d4BMXiHorizonDarbouxAlgebraicWeight_neg (q : XiZeroCopy) :
    d4BMXiHorizonDarbouxAlgebraicWeight q < 0 := by
  have hQ := d4BMXiReflectedRealPairMediatorAngularQ_mem_Ioo q
  unfold d4BMXiHorizonDarbouxAlgebraicWeight
  exact mul_neg_of_neg_of_pos hQ.2 (by linarith [hQ.1])

theorem d4BMXiHorizonDarbouxAlgebraicWeight_sub_reflect_eq
    (q : XiZeroCopy) :
    d4BMXiHorizonDarbouxAlgebraicWeight q -
        d4BMXiHorizonDarbouxAlgebraicWeight (xiZeroCopyReflectEquiv q) =
      -4 * (q.1 : ℂ).re * (1 - (q.1 : ℂ).re) *
        (1 - 2 * (q.1 : ℂ).re) := by
  unfold d4BMXiHorizonDarbouxAlgebraicWeight
    d4BMXiReflectedRealPairMediatorAngularQ
  rw [xiZeroCopyReflectEquiv_rho]
  simp only [Complex.sub_re, Complex.one_re]
  ring

theorem d4BMXiHorizonDarbouxAlgebraicWeight_eq_reflect_iff
    (q : XiZeroCopy) :
    d4BMXiHorizonDarbouxAlgebraicWeight q =
        d4BMXiHorizonDarbouxAlgebraicWeight (xiZeroCopyReflectEquiv q) ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [← sub_eq_zero, d4BMXiHorizonDarbouxAlgebraicWeight_sub_reflect_eq]
  have hstrip := xi_divisor_support_re_mem_open_unit q.1
  have ha : (q.1 : ℂ).re ≠ 0 := ne_of_gt hstrip.1
  have h1a : 1 - (q.1 : ℂ).re ≠ 0 := ne_of_gt (by linarith [hstrip.2])
  constructor
  · intro h
    rcases mul_eq_zero.mp h with hleft | htilt
    · rcases mul_eq_zero.mp hleft with hleft | h1az
      · rcases mul_eq_zero.mp hleft with h4 | haz
        · norm_num at h4
        · exact False.elim (ha haz)
      · exact False.elim (h1a h1az)
    · linarith
  · intro h
    rw [h]
    norm_num

/-- Cayley phase generated by real algebraic weight `c` and real horizon drive `y`. -/
def d4DarbouxCayleyPhase (c y : ℝ) : ℂ :=
  ((c : ℂ) + Complex.I * (y : ℂ)) /
    ((c : ℂ) - Complex.I * (y : ℂ))

/-- Nonzero real drive makes Cayley phase injective in every nonzero real weight. -/
theorem d4DarbouxCayleyPhase_eq_iff
    {c d y : ℝ} (hc : c ≠ 0) (hd : d ≠ 0) (hy : y ≠ 0) :
    d4DarbouxCayleyPhase c y = d4DarbouxCayleyPhase d y ↔ c = d := by
  have hcden : (c : ℂ) - Complex.I * (y : ℂ) ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    norm_num at hre
    exact hc hre
  have hdden : (d : ℂ) - Complex.I * (y : ℂ) ≠ 0 := by
    intro h
    have hre := congrArg Complex.re h
    norm_num at hre
    exact hd hre
  unfold d4DarbouxCayleyPhase
  constructor
  · intro h
    have hcross := (div_eq_div_iff hcden hdden).mp h
    have him := congrArg Complex.im hcross
    norm_num at him
    ring_nf at him
    rcases mul_eq_zero.mp (show y * (d - c) = 0 by linarith) with hy0 | hdc
    · exact False.elim (hy hy0)
    · linarith
  · rintro rfl
    rfl

theorem normSq_d4DarbouxCayleyPhase
    (c y : ℝ) (hc : c ≠ 0) :
    Complex.normSq (d4DarbouxCayleyPhase c y) = 1 := by
  have hcy : c * c + y * y ≠ 0 := by
    have hc2 : 0 < c * c := mul_self_pos.mpr hc
    nlinarith [sq_nonneg y]
  unfold d4DarbouxCayleyPhase
  rw [Complex.normSq_div]
  simp only [Complex.normSq_apply, Complex.add_re, Complex.ofReal_re,
    Complex.mul_re, Complex.I_re, Complex.I_im, Complex.ofReal_im,
    zero_mul, one_mul, sub_zero, Complex.add_im, zero_add, Complex.sub_re,
    Complex.sub_im, zero_sub]
  norm_num
  ring_nf
  intro hzero
  apply hcy
  nlinarith

theorem norm_d4DarbouxCayleyPhase
    (c y : ℝ) (hc : c ≠ 0) :
    ‖d4DarbouxCayleyPhase c y‖ = 1 := by
  rw [Complex.norm_def, normSq_d4DarbouxCayleyPhase c y hc]
  norm_num

/-- Reversing real frequency gives exact inverse scattering phase. -/
theorem d4DarbouxCayleyPhase_neg_eq_inv
    (c y : ℝ) :
    d4DarbouxCayleyPhase c (-y) = (d4DarbouxCayleyPhase c y)⁻¹ := by
  unfold d4DarbouxCayleyPhase
  rw [inv_div]
  push_cast
  congr 1 <;> ring

/-- Exact Darboux horizon S-matrix after normalized absorbed-mass backreaction. -/
def d4BMXiAbsorbedHorizonDarbouxSMatrix
    (q : XiZeroCopy) (horizonAmplitude omega : ℝ) : ℂ :=
  d4TopologicalDarbouxHorizonForwardSMatrix
    (horizonAmplitude ^ 2 : ℂ)
    (d4BMXiReflectedRealPairMediatorAngularQ q : ℂ)
    (omega : ℂ)

theorem d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase
    (q : XiZeroCopy) (horizonAmplitude omega : ℝ) :
    d4BMXiAbsorbedHorizonDarbouxSMatrix q horizonAmplitude omega =
      d4DarbouxCayleyPhase (d4BMXiHorizonDarbouxAlgebraicWeight q)
        (12 * horizonAmplitude ^ 2 * omega) := by
  unfold d4BMXiAbsorbedHorizonDarbouxSMatrix
    d4TopologicalDarbouxHorizonForwardSMatrix
    d4TopologicalTeukolskyStarobinskyConstant
    d4TopologicalDarbouxReverseStarobinskyConstant
    d4DarbouxCayleyPhase d4BMXiHorizonDarbouxAlgebraicWeight
  push_cast
  ring

theorem d4BMXiAbsorbedHorizonDarbouxSMatrix_norm_eq_one
    (q : XiZeroCopy) (horizonAmplitude omega : ℝ) :
    ‖d4BMXiAbsorbedHorizonDarbouxSMatrix q horizonAmplitude omega‖ = 1 := by
  rw [d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase]
  exact norm_d4DarbouxCayleyPhase _ _
    (ne_of_lt (d4BMXiHorizonDarbouxAlgebraicWeight_neg q))

theorem d4BMXiAbsorbedHorizonDarbouxSMatrix_neg_frequency
    (q : XiZeroCopy) (horizonAmplitude omega : ℝ) :
    d4BMXiAbsorbedHorizonDarbouxSMatrix q horizonAmplitude (-omega) =
      (d4BMXiAbsorbedHorizonDarbouxSMatrix q horizonAmplitude omega)⁻¹ := by
  rw [d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase,
    d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase]
  rw [show 12 * horizonAmplitude ^ 2 * -omega =
      -(12 * horizonAmplitude ^ 2 * omega) by ring]
  exact d4DarbouxCayleyPhase_neg_eq_inv _ _

/-- Exact horizon Cayley phases of reflected sectors coincide exactly on critical line. -/
theorem d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_reflect_iff
    (q : XiZeroCopy) {horizonAmplitude omega : ℝ}
    (hamp : horizonAmplitude ≠ 0) (homega : omega ≠ 0) :
    d4BMXiAbsorbedHorizonDarbouxSMatrix q horizonAmplitude omega =
        d4BMXiAbsorbedHorizonDarbouxSMatrix (xiZeroCopyReflectEquiv q)
          horizonAmplitude omega ↔
      (q.1 : ℂ).re = 1 / 2 := by
  rw [d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase,
    d4BMXiAbsorbedHorizonDarbouxSMatrix_eq_phase]
  have hc := ne_of_lt (d4BMXiHorizonDarbouxAlgebraicWeight_neg q)
  have hd := ne_of_lt
    (d4BMXiHorizonDarbouxAlgebraicWeight_neg (xiZeroCopyReflectEquiv q))
  have hy : 12 * horizonAmplitude ^ 2 * omega ≠ 0 := by
    exact mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 hamp)) homega
  rw [d4DarbouxCayleyPhase_eq_iff hc hd hy,
    d4BMXiHorizonDarbouxAlgebraicWeight_eq_reflect_iff]

end

end RHTower
