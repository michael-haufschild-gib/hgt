      B * D * ((1 : ℂ) * s * t * r ^ 2 + (-1 : ℂ) * s * t * r ^ 4 + (-5 / 8 : ℂ) * s * t ^ 2 + (2 : ℂ) * s * t ^ 2 * r ^ 2 + (-19 / 8 : ℂ) * s * t ^ 2 * r ^ 4 + (1 : ℂ) * s * t ^ 2 * r ^ 6 + (-1 / 8 : ℂ) * s * t ^ 3 + (1 / 2 : ℂ) * s * t ^ 3 * r ^ 2 + (-3 / 8 : ℂ) * s * t ^ 3 * r ^ 4 + (-5 / 8 : ℂ) * s ^ 2 * t + (2 : ℂ) * s ^ 2 * t * r ^ 2 + (-19 / 8 : ℂ) * s ^ 2 * t * r ^ 4 + (1 : ℂ) * s ^ 2 * t * r ^ 6 + (-7 / 4 : ℂ) * s ^ 2 * t ^ 2 + (3 : ℂ) * s ^ 2 * t ^ 2 * r ^ 2 + (-5 / 4 : ℂ) * s ^ 2 * t ^ 2 * r ^ 4 + (-3 / 8 : ℂ) * s ^ 2 * t ^ 3 + (1 / 2 : ℂ) * s ^ 2 * t ^ 3 * r ^ 2 + (-1 / 8 : ℂ) * s ^ 2 * t ^ 3 * r ^ 4 + (-1 / 8 : ℂ) * s ^ 3 * t + (1 / 2 : ℂ) * s ^ 3 * t * r ^ 2 + (-3 / 8 : ℂ) * s ^ 3 * t * r ^ 4 + (-3 / 8 : ℂ) * s ^ 3 * t ^ 2 + (1 / 2 : ℂ) * s ^ 3 * t ^ 2 * r ^ 2 + (-1 / 8 : ℂ) * s ^ 3 * t ^ 2 * r ^ 4) / (r ^ 4 * (r ^ 2 - 1) ^ 2) * S ^ 2 := by
  have hd := D4BMBackground.jet_isDiagonalJet r y hr hy hf
  rw [hd.mixedQuadratic_connection_eq]
  simp only [hd.mixedQuadratic_inverse_apply, hd.linearization_inverse_apply]
