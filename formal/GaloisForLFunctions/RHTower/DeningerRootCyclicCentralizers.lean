import GaloisForLFunctions.RHTower.DeningerRootShortCentralizer
import GaloisForLFunctions.RHTower.DeningerCycRecursion

/-!
# A root adjunction preserves cyclic centralizers

Every element of an amalgam is conjugate to the product of a cyclically reduced word.  If that word
has at least two letters the descent computes the centralizer; if it has one letter the element is
conjugate into a factor, where the centralizer is the cyclic group generated by the adjoined root —
for the adjoined factor, for the base group, and for an element of the rooted factor conjugate into
the base — or the image of the factor's own centralizer otherwise.  Conjugation transports the
condition, so a root adjunction at an isolated self centralizing element of infinite order in a
group with cyclic centralizers again has cyclic centralizers.

* `deningerRootAdjunction_cyclicCentralizers` : the step.
-/

namespace RHTower

open Monoid Monoid.PushoutI

universe u

namespace RootAdjunction

/-- **A root adjunction preserves cyclic centralizers.** -/
theorem deningerRootAdjunction_cyclicCentralizers (A : Type u) [Group A] (a : A) (m : ℤ)
    (hm : m ≠ 0) (hm2 : 2 ≤ m.natAbs) (ha : ∀ n : ℤ, a ^ n = 1 → n = 0)
    (hA : ∀ (x y : A) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (hiso : ∀ (y : A) (n : ℕ), 0 < n → y ^ n ∈ Subgroup.zpowers a → y ∈ Subgroup.zpowers a)
    (hcentA : ∀ (x : A) (c : ℤ), c ≠ 0 → x * a ^ c * x⁻¹ = a ^ c → x ∈ Subgroup.zpowers a)
    (htorA : ∀ (x : A) (n : ℕ), 0 < n → x ^ n = 1 → x = 1)
    (hCC : DeningerCyclicCentralizers A) :
    DeningerCyclicCentralizers (PushoutI (deningerRootMap A a m)) := by
  classical
  have hφ := deningerRootMap_injective A a m hm ha
  obtain ⟨d⟩ := PushoutI.NormalWord.transversal_nonempty (deningerRootMap A a m) hφ
  have hCCtrue : DeningerCyclicCentralizers (deningerRootFactor A (ULift.up true)) := hCC
  -- the centralizer of a nontrivial element of the adjoined factor, up to conjugation
  have hfalse : ∀ (v : deningerRootFactor A (ULift.up false)) (g : PushoutI (deningerRootMap A a m)),
      PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v ≠ 1 →
      ∃ y : PushoutI (deningerRootMap A a m), (∀ n : ℤ, y ^ n = 1 → n = 0) ∧
        ∀ z : PushoutI (deningerRootMap A a m),
          z * (g * PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v * g⁻¹) * z⁻¹ =
            g * PushoutI.of (φ := deningerRootMap A a m) (ULift.up false) v * g⁻¹ ↔
            z ∈ Subgroup.zpowers y := by
    intro v g hv
    exact deningerCyclicCentralizer_conj _ g (deningerRootElt A a m)
      (deningerRootElt_order A a m hm ha)
      (deningerOfFalse_centralizer A a m hm hm2 ha hA hiso hcentA htorA v hv)
  intro w hw
  rcases deningerExists_letterProd (d := d) w with ⟨h₀, hw₀, -⟩ | ⟨L, hLne, hLred, hLalt, -, hw₀⟩
  · -- the element lies in the base group
    have hbase : w = PushoutI.of (φ := deningerRootMap A a m) (ULift.up false)
        (deningerRootMap A a m (ULift.up false) h₀) := by
      rw [PushoutI.of_apply_eq_base]
      exact hw₀
    obtain ⟨y, hy, hC⟩ := hfalse (deningerRootMap A a m (ULift.up false) h₀) 1 (by
      rw [← hbase]
      exact hw)
    refine ⟨y, hy, fun z => ?_⟩
    rw [← hbase] at hC
    simpa using hC z
  · -- the element is conjugate to the product of a cyclically reduced word
    obtain ⟨C, R, V, hsplit, -, hVne, hVred, hValt, -, hprodR, hVcases⟩ :=
      deningerExists_cycData (φ := deningerRootMap A a m) L hLne hLred hLalt
    have hwconj : w = deningerLetterProd (φ := deningerRootMap A a m) C *
        deningerLetterProd (φ := deningerRootMap A a m) V *
        (deningerLetterProd (φ := deningerRootMap A a m) C)⁻¹ := by
      rw [hw₀, hsplit, deningerLetterProd_append, hprodR, ← mul_assoc]
    by_cases hV2 : 2 ≤ V.length
    · have hVcyc : ∀ p ∈ V.getLast?, ∀ q ∈ V.head?, p.1 ≠ q.1 := by
        rcases hVcases with hc | hc
        · omega
        · exact hc
      obtain ⟨y, hy, hC⟩ := deningerRootAdjunction_cycRed_centralizer A a m hm ha hA hiso hcentA
        htorA V hV2 hVred hValt hVcyc (deningerLetterProd (φ := deningerRootMap A a m) C)
      exact ⟨y, hy, by rw [hwconj]; exact hC⟩
    · -- the cyclic reduction is a single letter
      have hVpos : 0 < V.length := List.length_pos_iff.2 hVne
      obtain ⟨q, hq⟩ : ∃ q, V = [q] := List.length_eq_one_iff.mp (by omega)
      have hqred : q.2 ∉ (deningerRootMap A a m q.1).range :=
        hVred q (by rw [hq]; exact List.mem_cons_self)
      have hVq : deningerLetterProd (φ := deningerRootMap A a m) V =
          PushoutI.of (φ := deningerRootMap A a m) q.1 q.2 := by
        rw [hq, deningerLetterProd_cons, deningerLetterProd_nil, mul_one]
      have hqne : PushoutI.of (φ := deningerRootMap A a m) q.1 q.2 ≠ 1 := by
        intro hc
        refine hqred ⟨1, ?_⟩
        rw [map_one]
        refine PushoutI.of_injective hφ q.1 ?_
        rw [map_one]
        exact hc.symm
      obtain ⟨⟨b⟩, x⟩ := q
      cases b
      · -- a letter of the adjoined factor
        obtain ⟨y, hy, hC⟩ := hfalse x (deningerLetterProd (φ := deningerRootMap A a m) C) hqne
        exact ⟨y, hy, by rw [hwconj, hVq]; exact hC⟩
      · -- a letter of the rooted factor
        by_cases hesc : ∃ (x' : deningerRootFactor A (ULift.up true))
            (k : ULift.{u} (Multiplicative ℤ)),
            x'⁻¹ * x * x' = deningerRootMap A a m (ULift.up true) k
        · obtain ⟨x', k, hk⟩ := hesc
          have hxconj : PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x =
              PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x' *
                PushoutI.of (φ := deningerRootMap A a m) (ULift.up false)
                  (deningerRootMap A a m (ULift.up false) k) *
                (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x')⁻¹ := by
            have h1 : PushoutI.of (φ := deningerRootMap A a m) (ULift.up true)
                (x'⁻¹ * x * x') = PushoutI.base (deningerRootMap A a m) k := by
              rw [hk, PushoutI.of_apply_eq_base]
            rw [PushoutI.of_apply_eq_base]
            rw [map_mul, map_mul, map_inv] at h1
            rw [← h1]
            group
          have hkne : PushoutI.of (φ := deningerRootMap A a m) (ULift.up false)
              (deningerRootMap A a m (ULift.up false) k) ≠ 1 := by
            intro hc
            refine hqne ?_
            rw [hxconj, hc, mul_one, mul_inv_cancel]
          obtain ⟨y, hy, hC⟩ := hfalse (deningerRootMap A a m (ULift.up false) k)
            (deningerLetterProd (φ := deningerRootMap A a m) C *
              PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x') hkne
          refine ⟨y, hy, fun z => ?_⟩
          have hwe : w = deningerLetterProd (φ := deningerRootMap A a m) C *
              PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x' *
              PushoutI.of (φ := deningerRootMap A a m) (ULift.up false)
                (deningerRootMap A a m (ULift.up false) k) *
              (deningerLetterProd (φ := deningerRootMap A a m) C *
                PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x')⁻¹ := by
            rw [hwconj, hVq, hxconj]
            group
          rw [hwe]
          exact hC z
        · obtain ⟨y₀, hy₀, hC₀⟩ := hCCtrue x (by
            intro hc
            refine hqred ⟨1, ?_⟩
            rw [map_one]
            exact hc.symm)
          obtain ⟨hyord, hCfac⟩ := deningerOfTrue_centralizer A a m hm ha x hqred hesc y₀ hy₀ hC₀
          obtain ⟨y, hy, hC⟩ := deningerCyclicCentralizer_conj
            (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) x)
            (deningerLetterProd (φ := deningerRootMap A a m) C)
            (PushoutI.of (φ := deningerRootMap A a m) (ULift.up true) y₀) hyord hCfac
          exact ⟨y, hy, by rw [hwconj, hVq]; exact hC⟩

end RootAdjunction

end RHTower
