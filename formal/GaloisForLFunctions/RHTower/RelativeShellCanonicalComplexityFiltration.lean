import GaloisForLFunctions.RHTower.RelativeShellCanonicalProvenanceSupport

/-!
# Canonical complexity filtration of complete shell observables

Canonical finite provenance support gives a source-native complexity grade:
the largest indispensable shell exponent.  This file proves that grade is the
least initial-shell stage containing the observable.  Initial stages are
finite, monotone, and their supremum is the full shell differential field.

The grade obeys non-Archimedean max bounds under addition and multiplication,
is unchanged by negation and inversion, and cannot grow under differentiation.
Common zeta has grade zero; private multiplier `H_m` has grade exactly `m`.

This is an algebraic filtration rather than an asserted analytic topology.  It
supplies Route L with a canonical source-domain scale derived from arithmetic
provenance, not post hoc target weights.
-/

open Set
open scoped Classical
open scoped Differential UpperEndDifferentialInstances
  UpperEndComplexTowerInstances

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- Initial shell labels through exponent `N`. -/
def relativeShellInitialSet (N : ℕ) : Set RelativeShellLabel :=
  {m | m.1 ≤ N}

/-- Every initial shell-label set is finite. -/
theorem relativeShellInitialSet_finite (N : ℕ) :
    (relativeShellInitialSet N).Finite := by
  change
    ((Subtype.val : RelativeShellLabel → ℕ) ⁻¹'
      Set.Iic N).Finite
  exact
    Set.Finite.preimage
      (Set.injOn_of_injective Subtype.val_injective)
      (Set.finite_Iic N)

/-- Differential field generated by the initial shell segment through `N`. -/
abbrev relativeShellInitialDifferentialField (N : ℕ) :=
  relativeShellSubsetDifferentialField (relativeShellInitialSet N)

/-- Largest label in canonical finite support, with empty supremum equal to zero. -/
def relativeShellObservableGrade
    (x : RelativeShellFullObservable) : ℕ :=
  (relativeShellObservableSupportFinset x).sup
    (fun m => m.1)

theorem relativeShellObservableGrade_le_iff_support_subset
    (x : RelativeShellFullObservable) (N : ℕ) :
    relativeShellObservableGrade x ≤ N ↔
      relativeShellObservableSupport x ⊆
        relativeShellInitialSet N := by
  rw [relativeShellObservableGrade, Finset.sup_le_iff]
  constructor
  · intro h m hm
    have hmFin :
        m ∈ relativeShellObservableSupportFinset x := by
      change
        m ∈
          (relativeShellObservableSupportFinset x :
            Set RelativeShellLabel)
      rw [coe_relativeShellObservableSupportFinset]
      exact hm
    exact h m hmFin
  · intro h m hm
    apply h
    have hmSet :
        m ∈
          (relativeShellObservableSupportFinset x :
            Set RelativeShellLabel) := hm
    rw [coe_relativeShellObservableSupportFinset] at hmSet
    exact hmSet

/--
The grade is the exact least initial-shell stage containing the observable.
-/
theorem relativeShellObservableGrade_le_iff_mem
    (x : RelativeShellFullObservable) (N : ℕ) :
    relativeShellObservableGrade x ≤ N ↔
      (x : upperEndMeroField) ∈
        relativeShellInitialDifferentialField N := by
  rw [relativeShellObservableGrade_le_iff_support_subset,
    mem_relativeShellSubsetDifferentialField_iff_support_subset]

theorem relativeShellObservable_mem_grade
    (x : RelativeShellFullObservable) :
    (x : upperEndMeroField) ∈
      relativeShellInitialDifferentialField
        (relativeShellObservableGrade x) := by
  rw [← relativeShellObservableGrade_le_iff_mem]

/-- Support containment implies grade monotonicity. -/
theorem relativeShellObservableGrade_le_of_support_subset
    {x y : RelativeShellFullObservable}
    (h :
      relativeShellObservableSupport x ⊆
        relativeShellObservableSupport y) :
    relativeShellObservableGrade x ≤
      relativeShellObservableGrade y := by
  rw [relativeShellObservableGrade_le_iff_support_subset]
  intro m hm
  have hmFin :
      m ∈ relativeShellObservableSupportFinset y := by
    change
      m ∈
        (relativeShellObservableSupportFinset y :
          Set RelativeShellLabel)
    rw [coe_relativeShellObservableSupportFinset]
    exact h hm
  change
    m.1 ≤
      (relativeShellObservableSupportFinset y).sup
        (fun q => q.1)
  exact Finset.le_sup hmFin

/-- Source complexity obeys a non-Archimedean addition bound. -/
theorem relativeShellObservableGrade_add_le
    (x y : RelativeShellFullObservable) :
    relativeShellObservableGrade (x + y) ≤
      max (relativeShellObservableGrade x)
        (relativeShellObservableGrade y) := by
  rw [relativeShellObservableGrade_le_iff_support_subset]
  intro m hm
  have hmUnion :=
    relativeShellObservableSupport_add_subset x y hm
  rcases hmUnion with hmx | hmy
  · exact
      (Finset.le_sup (by
        change
          m ∈
            (relativeShellObservableSupportFinset x :
              Set RelativeShellLabel)
        rw [coe_relativeShellObservableSupportFinset]
        exact hmx)).trans
        (Nat.le_max_left _ _)
  · exact
      (Finset.le_sup (by
        change
          m ∈
            (relativeShellObservableSupportFinset y :
              Set RelativeShellLabel)
        rw [coe_relativeShellObservableSupportFinset]
        exact hmy)).trans
        (Nat.le_max_right _ _)

/-- Source complexity obeys a non-Archimedean multiplication bound. -/
theorem relativeShellObservableGrade_mul_le
    (x y : RelativeShellFullObservable) :
    relativeShellObservableGrade (x * y) ≤
      max (relativeShellObservableGrade x)
        (relativeShellObservableGrade y) := by
  rw [relativeShellObservableGrade_le_iff_support_subset]
  intro m hm
  have hmUnion :=
    relativeShellObservableSupport_mul_subset x y hm
  rcases hmUnion with hmx | hmy
  · exact
      (Finset.le_sup (by
        change
          m ∈
            (relativeShellObservableSupportFinset x :
              Set RelativeShellLabel)
        rw [coe_relativeShellObservableSupportFinset]
        exact hmx)).trans
        (Nat.le_max_left _ _)
  · exact
      (Finset.le_sup (by
        change
          m ∈
            (relativeShellObservableSupportFinset y :
              Set RelativeShellLabel)
        rw [coe_relativeShellObservableSupportFinset]
        exact hmy)).trans
        (Nat.le_max_right _ _)

theorem relativeShellObservableGrade_neg
    (x : RelativeShellFullObservable) :
    relativeShellObservableGrade (-x) =
      relativeShellObservableGrade x := by
  apply le_antisymm
  · apply relativeShellObservableGrade_le_of_support_subset
    rw [relativeShellObservableSupport_neg]
  · apply relativeShellObservableGrade_le_of_support_subset
    rw [relativeShellObservableSupport_neg]

theorem relativeShellObservableGrade_inv
    (x : RelativeShellFullObservable) :
    relativeShellObservableGrade x⁻¹ =
      relativeShellObservableGrade x := by
  apply le_antisymm
  · apply relativeShellObservableGrade_le_of_support_subset
    rw [relativeShellObservableSupport_inv]
  · apply relativeShellObservableGrade_le_of_support_subset
    rw [relativeShellObservableSupport_inv]

/-- Differentiation cannot increase canonical source complexity. -/
theorem relativeShellObservableDeriv_grade_le
    (x : RelativeShellFullObservable) :
    relativeShellObservableGrade
        (relativeShellObservableDeriv x) ≤
      relativeShellObservableGrade x :=
  relativeShellObservableGrade_le_of_support_subset
    (relativeShellObservableDeriv_support_subset x)

/-- The common zeta mode has zero private-shell complexity. -/
theorem relativeShellCommonObservable_grade :
    relativeShellObservableGrade
        relativeShellCommonObservable = 0 := by
  rw [relativeShellObservableGrade]
  have hfin :
      relativeShellObservableSupportFinset
          relativeShellCommonObservable = ∅ := by
    apply Finset.coe_injective
    rw [coe_relativeShellObservableSupportFinset,
      relativeShellCommonObservable_support]
    simp
  rw [hfin]
  rfl

/-- Private shell `m` has exact source complexity `m`. -/
theorem relativeShellMultiplierObservable_grade
    (m : RelativeShellLabel) :
    relativeShellObservableGrade
        (relativeShellMultiplierObservable m) = m.1 := by
  rw [relativeShellObservableGrade]
  have hfin :
      relativeShellObservableSupportFinset
          (relativeShellMultiplierObservable m) = {m} := by
    apply Finset.coe_injective
    rw [coe_relativeShellObservableSupportFinset,
      relativeShellMultiplierObservable_support]
    simp
  rw [hfin]
  simp

theorem relativeShellInitialDifferentialField_mono
    {N M : ℕ} (hNM : N ≤ M) :
    relativeShellInitialDifferentialField N ≤
      relativeShellInitialDifferentialField M := by
  rw [relativeShellSubsetDifferentialField_le_iff]
  intro m hm
  exact hm.trans hNM

/--
The finite initial-shell filtration exhausts the full complete-shell field.
-/
theorem iSup_relativeShellInitialDifferentialField :
    (⨆ N : ℕ, relativeShellInitialDifferentialField N) =
      RelativeShellFullObservable := by
  have hunion :
      (⋃ N : ℕ, relativeShellInitialSet N) =
        (Set.univ : Set RelativeShellLabel) := by
    apply Set.eq_univ_of_forall
    intro m
    rw [Set.mem_iUnion]
    refine ⟨m.1, ?_⟩
    change m.1 ≤ m.1
    exact le_rfl
  rw [relativeShellSubsetDifferentialField_iSup,
    hunion]

end

end RHTower
