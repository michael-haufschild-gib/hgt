import GaloisForLFunctions.RHTower.DeningerCommonCyclicAmalgam
import GaloisForLFunctions.RHTower.DeningerMaximalRootExists
import GaloisForLFunctions.RHTower.DeningerCentralizerZpow

/-!
# A maximal root is its own centralizer

The descent expresses an element commuting with a cyclically reduced word of at least two letters
and the word itself as powers of one element; if the word is a maximal root that exponent is one, so
the commuting element is a power of the word.  In a group with unique roots the centralizer of an
element is the centralizer of its maximal root, and the maximal root of a cyclically reduced word of
at least two letters is again one, because a word of one letter has only short powers.

* `deningerMaximalRoot_centralizer` : a maximal cyclically reduced word is its own centralizer.
* `deningerCycRed_centralizer_cyclic` : the centralizer of a cyclically reduced word of at least two
  letters is the cyclic subgroup generated by its maximal root.
-/

namespace RHTower

open Monoid Monoid.PushoutI Monoid.CoprodI

variable {ι : Type*} {G : ι → Type*} {H : Type*} [∀ i, Group (G i)] [Group H]
  {φ : ∀ i, H →* G i} {d : NormalWord.Transversal φ}
  [DecidableEq ι] [∀ i, DecidableEq (G i)]

include d in
/-- **A maximal cyclically reduced word is its own centralizer.** -/
theorem deningerMaximalRoot_centralizer
    (hcent : ∀ (i : ι) (x : G i) (u v : H), x * φ i u * x⁻¹ = φ i v → v = u)
    (i₀ : ι)
    (hself : ∀ (i : ι) (x : G i) (v : H), i ≠ i₀ → v ≠ 1 → x * φ i v * x⁻¹ = φ i v →
      x ∈ (φ i).range)
    (Y : List (Σ i, G i)) (hY2 : 2 ≤ Y.length)
    (hYred : ∀ p ∈ Y, p.2 ∉ (φ p.1).range)
    (hYalt : List.IsChain (fun p q : Σ i, G i => p.1 ≠ q.1) Y)
    (hYcyc : ∀ p ∈ Y.getLast?, ∀ q ∈ Y.head?, p.1 ≠ q.1)
    (hmax : ∀ (u : PushoutI φ) (k : ℕ), 1 < k → u ^ k ≠ deningerLetterProd (φ := φ) Y)
    (z : PushoutI φ)
    (hz : z * deningerLetterProd (φ := φ) Y * z⁻¹ = deningerLetterProd (φ := φ) Y) :
    z ∈ Subgroup.zpowers (deningerLetterProd (φ := φ) Y) := by
  have hz' : z⁻¹ * deningerLetterProd (φ := φ) Y * z = deningerLetterProd (φ := φ) Y := by
    calc z⁻¹ * deningerLetterProd (φ := φ) Y * z
        = z⁻¹ * (z * deningerLetterProd (φ := φ) Y * z⁻¹) * z := by rw [hz]
      _ = deningerLetterProd (φ := φ) Y := by group
  obtain ⟨v, n, hn, hvn, hmem⟩ :=
    deningerCommon_cyclic_amalgam (d := d) hcent i₀ hself Y hY2 hYred hYalt hYcyc z hz'
  rcases Nat.lt_or_ge 1 n with hn2 | hn1
  · exact absurd hvn (hmax v n hn2)
  · have : n = 1 := by omega
    rw [this, pow_one] at hvn
    rwa [← hvn]

include d in
/-- **The centralizer of a cyclically reduced word of at least two letters** is the cyclic subgroup
generated by its maximal root. -/
theorem deningerCycRed_centralizer_cyclic
    (hcent : ∀ (i : ι) (x : G i) (u v : H), x * φ i u * x⁻¹ = φ i v → v = u)
    (i₀ : ι)
    (hself : ∀ (i : ι) (x : G i) (v : H), i ≠ i₀ → v ≠ 1 → x * φ i v * x⁻¹ = φ i v →
      x ∈ (φ i).range)
    (huniq : ∀ (x y : PushoutI φ) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (X : List (Σ i, G i)) (hX2 : 2 ≤ X.length)
    (hXred : ∀ p ∈ X, p.2 ∉ (φ p.1).range)
    (hXalt : List.IsChain (fun p q : Σ i, G i => p.1 ≠ q.1) X)
    (hXcyc : ∀ p ∈ X.getLast?, ∀ q ∈ X.head?, p.1 ≠ q.1) :
    ∃ (y : PushoutI φ) (N : ℕ), 0 < N ∧ y ^ N = deningerLetterProd (φ := φ) X ∧
      ∀ z : PushoutI φ, z * deningerLetterProd (φ := φ) X * z⁻¹ =
        deningerLetterProd (φ := φ) X → z ∈ Subgroup.zpowers y := by
  classical
  have hXne : X ≠ [] := by
    intro hc
    rw [hc] at hX2
    simp at hX2
  obtain ⟨y, N, hN, hyN, hmax⟩ :=
    deningerExists_maximalRoot (d := d) X hXne hXred hXalt hXcyc
  obtain ⟨n, rfl⟩ : ∃ n, N = n + 1 := ⟨N - 1, by omega⟩
  obtain ⟨U, hUne, hUred, hUalt, hUcyc, hUlen, hyU⟩ :=
    deningerCycRedWord_of_pow (d := d) y X n hXne hXred hXalt hXcyc hyN
  have hU2 : 2 ≤ U.length := by
    by_contra hc
    have hU1 : U.length = 1 := by
      have := List.length_pos_iff.2 hUne
      omega
    obtain ⟨q, hq⟩ : ∃ q, U = [q] := List.length_eq_one_iff.mp hU1
    have hyq : y = PushoutI.of (φ := φ) q.1 q.2 := by
      rw [hyU, hq, deningerLetterProd_cons, deningerLetterProd_nil, mul_one]
    have hshort : deningerLen d (deningerLetterProd (φ := φ) X) ≤ 1 := by
      rw [← hyN, hyq, ← map_pow]
      have := deningerLen_of_mul_le (d := d) q.1 (q.2 ^ (n + 1)) 1
      rw [mul_one, deningerLen_one] at this
      omega
    rw [deningerLen_letterProd (d := d) X hXred hXalt] at hshort
    omega
  refine ⟨y, n + 1, hN, hyN, ?_⟩
  intro z hzc
  have hzy : z * y * z⁻¹ = y := by
    refine deningerCentralizer_zpow_eq huniq y z ((n : ℤ) + 1) (by omega) ?_
    rw [show ((n : ℤ) + 1) = ((n + 1 : ℕ) : ℤ) by push_cast; ring, zpow_natCast, hyN]
    exact hzc
  rw [hyU] at hzy ⊢
  exact deningerMaximalRoot_centralizer (d := d) hcent i₀ hself U hU2 hUred hUalt hUcyc
    (by
      intro u k hk hc
      exact hmax u k hk (by rw [hc, hyU]))
    z hzy

end RHTower
