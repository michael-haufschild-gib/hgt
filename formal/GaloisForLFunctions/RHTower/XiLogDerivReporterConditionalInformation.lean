import GaloisForLFunctions.HTGeometry.FiniteReporterConditionalInformation
import GaloisForLFunctions.RHTower.XiLogDerivReporterGramFisher

/-!
# Conditional Fisher collapse for finite Xi logarithmic-derivative reporters

Every finite-dimensional physics, genomic, or learned reporter eventually assigns zero
conditional information to a new Xi logarithmic-derivative reading.  The corresponding Xi
derivative is not generated by its predecessors before reporting: a simple pole of `logDeriv xi`
makes the full derivative family constant-coefficient linearly independent.

This is an unconditional observability boundary, not an RH criterion and not a temporal model.
-/

namespace RHTower

noncomputable section

open GaloisForLFunctions Module

/-- **Unconditional Xi finite-reporter collapse.**  Some derivative order no larger than the
output dimension is redundant after reporting but genuinely new in the Xi source. -/
theorem exists_xiLogDeriv_finiteReporterConditionalInformation_collapse
    {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℂ Y]
    [FiniteDimensional ℂ Y]
    (report : (ℂ → ℂ) →ₗ[ℂ] Y) :
    ∃ k : ℕ, k ≤ finrank ℂ Y ∧
      HTGeometry.finiteDerivativeReporterConditionalInformation k (logDeriv xi) report = 0 ∧
      report (iteratedDeriv k (logDeriv xi)) ∈
        HTGeometry.finiteDerivativeReporterPreviousSpace k (logDeriv xi) report ∧
      iteratedDeriv k (logDeriv xi) ∉ Submodule.span ℂ
        (Set.range fun i : Fin k => iteratedDeriv (i : ℕ) (logDeriv xi)) := by
  apply HTGeometry.exists_finiteDerivativeReporterConditionalInformation_collapse
  exact xiLogDeriv_constantCoefficientDifferentiallyTranscendental

end

end RHTower
