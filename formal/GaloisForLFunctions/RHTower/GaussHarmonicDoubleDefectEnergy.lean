import GaloisForLFunctions.RHTower.GaussCubicSmoothCoefficient

/-!
# Generic harmonic double-defect energy

Any literal outer moving defect whose input coefficients are a one-index harmonic convolution with
one sampled-ratio defect is controlled by the already closed Gauss double-defect lattice law.
-/

namespace RHTower

open MeasureTheory GaloisForLFunctions Filter Topology
open scoped ENNReal

noncomputable section

/-- Exact generic lattice energy generated by a harmonic coefficient constant `C`. -/
def gaussHarmonicDoubleDefectBound
    (C : ℝ) {m : ℕ} (k : Fin m) (p : Nat.Primes) (i : ℤ) : ℝ≥0∞ :=
  ∑' jl : ℤ × ℤ, ENNReal.ofReal
    (2 * C ^ 2 * 2 ^ ((3 : ℝ) / 4) *
        (∑' x : ℤ, intPowWeight (5 / 4) x).toReal *
      (1 / (1 + (jl.1.natAbs : ℝ)) ^ ((3 : ℝ) / 4)) *
      (1 / ((1 + ((jl.2 - jl.1).natAbs : ℝ)) * (1 + (jl.2.natAbs : ℝ)))) *
      (‖gaussSampleRatioDefect k p jl.1 i‖ ^ 2 *
        ‖gaussSampleRatioDefect k p jl.2 i‖ ^ 2))

theorem gaussHarmonicDoubleDefectBound_eq_scaled
    (C : ℝ) {m : ℕ} (k : Fin m) (p : Nat.Primes)
    (hp : (1 : ℝ) < (p : ℝ)) (i : ℤ) :
    gaussHarmonicDoubleDefectBound C k p i =
      ENNReal.ofReal ((C / (8 * (p : ℝ))) ^ 2) * gaussDoubleDefectBound k p i := by
  rw [gaussHarmonicDoubleDefectBound, gaussDoubleDefectBound,
    ← ENNReal.tsum_mul_left]
  refine tsum_congr fun jl => ?_
  rw [← ENNReal.ofReal_mul (sq_nonneg _)]
  congr 1
  have hp0 : (0 : ℝ) < (p : ℝ) := by linarith
  field_simp
  ring

theorem tendsto_gaussHarmonicDoubleDefectBound_comp
    (C : ℝ) {m : ℕ} (hm2 : 2 ≤ m) (k : Fin m) (p : Nat.Primes)
    (hp : (1 : ℝ) < (p : ℝ)) {ι : ℕ → ℤ}
    (hι : Tendsto (fun n : ℕ => (ι n).natAbs) atTop atTop) :
    Tendsto (fun n : ℕ => gaussHarmonicDoubleDefectBound C k p (ι n))
      atTop (nhds 0) := by
  have h := ENNReal.Tendsto.const_mul
    (tendsto_gaussDoubleDefectBound_comp hm2 k p hι)
    (Or.inr (ENNReal.ofReal_ne_top :
      ENNReal.ofReal ((C / (8 * (p : ℝ))) ^ 2) ≠ ⊤))
  simp only [mul_zero] at h
  refine h.congr fun n => ?_
  exact (gaussHarmonicDoubleDefectBound_eq_scaled C k p hp (ι n)).symm

/-- Weighted Cauchy plus the sharp `3/4` harmonic convolution transfers a coefficientwise
one-index double defect into the generic lattice energy. -/
theorem ofReal_norm_gaussMovingDefectVector_sq_le_harmonicDouble
    {C : ℝ} (hC : 0 ≤ C) {m : ℕ} (hm : 1 ≤ m) (k : Fin m) (p : Nat.Primes)
    (i : ℤ) (u : Lp ℂ 2 (AddCircle.haarAddCircle (T := (1 : ℝ))))
    (hcoeff : ∀ j : ℤ,
      ‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ≤
        ∑' l : ℤ, gaussCubicSmoothCoeffKernel C j l *
          ‖gaussSampleRatioDefect k p l i‖) :
    ENNReal.ofReal (‖gaussMovingDefectVector hm k p i u‖ ^ (2 : ℝ)) ≤
      gaussHarmonicDoubleDefectBound C k p i := by
  set Wr : ℝ := (∑' x : ℤ, intPowWeight (5 / 4) x).toReal with hWr
  have hWrnn : 0 ≤ Wr := ENNReal.toReal_nonneg
  have hWtop : (∑' x : ℤ, intPowWeight (5 / 4) x) ≠ ⊤ :=
    tsum_intPowWeight_ne_top (by norm_num)
  have hWof : ENNReal.ofReal Wr = ∑' x : ℤ, intPowWeight (5 / 4) x :=
    ENNReal.ofReal_toReal hWtop
  rw [ofReal_norm_gaussMovingDefectVector_sq_eq_energy,
    gaussMovingDefectEnergy, gaussHarmonicDoubleDefectBound, ENNReal.tsum_prod']
  refine ENNReal.tsum_le_tsum fun j => ?_
  let a : ℤ → ℝ := fun l => gaussCubicSmoothCoeffKernel C j l
  let x : ℤ → ℝ := fun l => ‖gaussSampleRatioDefect k p l i‖
  set S : ℝ≥0∞ := ∑' l : ℤ, ENNReal.ofReal (a l * x l) with hS
  set A : ℝ≥0∞ := ∑' l : ℤ, ENNReal.ofReal (a l) with hA
  set B : ℝ≥0∞ := ∑' l : ℤ, ENNReal.ofReal (a l * x l ^ 2) with hB
  have hac : ∀ l, 0 ≤ a l :=
    fun l => gaussCubicSmoothCoeffKernel_nonneg hC j l
  have hxc : ∀ l, 0 ≤ x l := fun l => norm_nonneg _
  have hsummable := summable_gaussCubicSmoothCoeffKernel_ratio hm k p i j hC
  have hSreal : ENNReal.ofReal
      (∑' l : ℤ, gaussCubicSmoothCoeffKernel C j l *
        ‖gaussSampleRatioDefect k p l i‖) = S := by
    rw [hS, ENNReal.ofReal_tsum_of_nonneg
      (fun l => mul_nonneg (gaussCubicSmoothCoeffKernel_nonneg hC j l) (norm_nonneg _))
      hsummable]
  have hcoeffE : ENNReal.ofReal
      ‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ≤ S := by
    rw [← hSreal]
    exact ENNReal.ofReal_le_ofReal (hcoeff j)
  have hsq : ENNReal.ofReal
      (‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ^ 2) ≤ S * S := by
    rw [show ‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ^ 2 =
      ‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ *
        ‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ by ring,
      ENNReal.ofReal_mul (norm_nonneg _)]
    exact mul_le_mul' hcoeffE hcoeffE
  have hcs : S * S ≤ A * B := by
    rw [hS, hA, hB]
    exact ennreal_tsum_ofReal_mul_sq_le a x hac hxc
  have hmass : A ≤ ENNReal.ofReal
      (C * (2 ^ ((3 : ℝ) / 4) /
          (1 + (j.natAbs : ℝ)) ^ ((3 : ℝ) / 4)) * (2 * Wr)) := by
    have hconv := tsum_harmonicPowConv_le (j := j) (β := 1) (γ := (3 : ℝ) / 4)
      (le_refl 1) (by norm_num) (by norm_num)
    have hcongr : ∀ l : ℤ,
        ENNReal.ofReal (a l) = ENNReal.ofReal C * ENNReal.ofReal
          (1 / ((1 + |(l : ℝ)|) ^ (1 : ℝ) * (1 + |((j - l : ℤ) : ℝ)|))) := by
      intro l
      rw [← ENNReal.ofReal_mul hC]
      congr 1
      simp only [a, gaussCubicSmoothCoeffKernel, Real.rpow_one]
      rw [natAbs_sub_symm l j, natAbs_cast_eq_abs (j - l), natAbs_cast_eq_abs l]
      ring
    rw [hA, tsum_congr hcongr, ENNReal.tsum_mul_left]
    refine (mul_le_mul' le_rfl hconv).trans_eq ?_
    have hexp : (1 : ℝ) + 1 - (3 : ℝ) / 4 = 5 / 4 := by norm_num
    rw [hexp]
    have h2W : (2 : ℝ≥0∞) * (∑' z : ℤ, intPowWeight (5 / 4) z) =
        ENNReal.ofReal (2 * Wr) := by
      rw [← hWof, ← ENNReal.ofReal_ofNat 2,
        ← ENNReal.ofReal_mul (by norm_num)]
    rw [h2W, ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul hC, natAbs_cast_eq_abs]
    congr 1
    ring
  calc
    ENNReal.ofReal
        (‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ^ 2 *
          ‖gaussSampleRatioDefect k p j i‖ ^ 2)
      = ENNReal.ofReal (‖gaussSampleRatioDefect k p j i‖ ^ 2) *
          ENNReal.ofReal (‖fourierCoeff ((u : AddCircle (1 : ℝ) → ℂ)) j‖ ^ 2) := by
        rw [mul_comm, ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (‖gaussSampleRatioDefect k p j i‖ ^ 2) * (A * B) := by
      exact mul_le_mul' le_rfl (hsq.trans hcs)
    _ ≤ ENNReal.ofReal (‖gaussSampleRatioDefect k p j i‖ ^ 2) *
        ENNReal.ofReal
          (C * (2 ^ ((3 : ℝ) / 4) /
            (1 + (j.natAbs : ℝ)) ^ ((3 : ℝ) / 4)) * (2 * Wr)) * B := by
      simpa only [mul_assoc] using
        mul_le_mul' (mul_le_mul' le_rfl hmass) le_rfl
    _ = ∑' l : ℤ, ENNReal.ofReal
        (2 * C ^ 2 * 2 ^ ((3 : ℝ) / 4) * Wr *
          (1 / (1 + (j.natAbs : ℝ)) ^ ((3 : ℝ) / 4)) *
          (1 / ((1 + ((l - j).natAbs : ℝ)) * (1 + (l.natAbs : ℝ)))) *
          (‖gaussSampleRatioDefect k p j i‖ ^ 2 *
            ‖gaussSampleRatioDefect k p l i‖ ^ 2)) := by
      rw [hB, ← ENNReal.tsum_mul_left]
      exact tsum_congr fun l => by
        rw [← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        simp only [a, x, gaussCubicSmoothCoeffKernel]
        field_simp

end

end RHTower
