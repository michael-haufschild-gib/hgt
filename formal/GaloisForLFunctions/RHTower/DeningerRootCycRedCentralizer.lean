import GaloisForLFunctions.RHTower.DeningerCentralizerConj
import GaloisForLFunctions.RHTower.DeningerRootUniqueRoots

/-!
# Cyclic centralizers in a root adjunction, for long elements

A root adjunction at an isolated self centralizing element of infinite order satisfies the two
hypotheses the descent consumes: the base group meets each factor in a subgroup on which conjugation
is trivial on exponents, and it is self centralizing in the rooted factor, the adjoined infinite
cyclic factor being the exempted one.  So every element of a root adjunction whose cyclic reduction
has at least two letters has an infinite cyclic centralizer.

* `deningerRootAdjunction_cycRed_centralizer` : the centralizer condition for long elements.
-/

namespace RHTower

open Monoid Monoid.PushoutI

universe u

namespace RootAdjunction

/-- **The centralizer condition for long elements of a root adjunction.**  If the cyclic reduction of
an element has at least two letters, its centralizer is the cyclic subgroup generated by an element
of infinite order. -/
theorem deningerRootAdjunction_cycRed_centralizer (A : Type u) [Group A] (a : A) (m : ℤ)
    (hm : m ≠ 0) (ha : ∀ n : ℤ, a ^ n = 1 → n = 0)
    (hA : ∀ (x y : A) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y)
    (hiso : ∀ (y : A) (n : ℕ), 0 < n → y ^ n ∈ Subgroup.zpowers a → y ∈ Subgroup.zpowers a)
    (hcentA : ∀ (x : A) (c : ℤ), c ≠ 0 → x * a ^ c * x⁻¹ = a ^ c → x ∈ Subgroup.zpowers a)
    (htorA : ∀ (x : A) (n : ℕ), 0 < n → x ^ n = 1 → x = 1)
    (X : List (Σ i, deningerRootFactor A i)) (hX2 : 2 ≤ X.length)
    (hXred : ∀ p ∈ X, p.2 ∉ (deningerRootMap A a m p.1).range)
    (hXalt : List.IsChain (fun p q : Σ i, deningerRootFactor A i => p.1 ≠ q.1) X)
    (hXcyc : ∀ p ∈ X.getLast?, ∀ q ∈ X.head?, p.1 ≠ q.1)
    (g : PushoutI (deningerRootMap A a m)) :
    ∃ y : PushoutI (deningerRootMap A a m), (∀ n : ℤ, y ^ n = 1 → n = 0) ∧
      ∀ z : PushoutI (deningerRootMap A a m),
        z * (g * deningerLetterProd (φ := deningerRootMap A a m) X * g⁻¹) * z⁻¹ =
          g * deningerLetterProd (φ := deningerRootMap A a m) X * g⁻¹ ↔
          z ∈ Subgroup.zpowers y := by
  classical
  obtain ⟨d⟩ := PushoutI.NormalWord.transversal_nonempty (deningerRootMap A a m)
    (deningerRootMap_injective A a m hm ha)
  have hself : ∀ (i : ULift Bool) (x : deningerRootFactor A i) (v : ULift.{u} (Multiplicative ℤ)),
      i ≠ ULift.up false → v ≠ 1 →
      x * deningerRootMap A a m i v * x⁻¹ = deningerRootMap A a m i v →
      x ∈ (deningerRootMap A a m i).range := by
    rintro ⟨b⟩ z v hi hv hz
    cases b
    · exact absurd rfl hi
    · have hne : Multiplicative.toAdd (MulEquiv.ulift v) ≠ 0 := by
        intro hzero
        refine hv ?_
        apply MulEquiv.ulift.injective
        apply Multiplicative.toAdd.injective
        simpa using hzero
      exact (deningerRootMap_true_mem_iff A a m z).2
        (hcentA z (Multiplicative.toAdd (MulEquiv.ulift v)) hne hz)
  have huniq : ∀ (x y : PushoutI (deningerRootMap A a m)) (n : ℕ), 0 < n → x ^ n = y ^ n → x = y := by
    intro x y n hn h
    refine deningerRootAdjunction_uniqueRoots A a m hm ha hA hiso hcentA htorA x y (n - 1) ?_
    rw [show n - 1 + 1 = n by omega]
    exact h
  obtain ⟨y, hy, hC⟩ :=
    deningerCycRedConj_centralizer (d := d) (deningerRootHcent A a m hm ha hA hiso)
      (ULift.up false) hself huniq X hX2 hXred hXalt hXcyc g
  refine ⟨g * y * g⁻¹, ?_, hC⟩
  intro n hn
  refine hy n ?_
  have h1 : (g * y * g⁻¹) ^ n = g * y ^ n * g⁻¹ := conj_zpow
  rw [hn] at h1
  have h2 : g * y ^ n * g⁻¹ = 1 := h1.symm
  calc y ^ n = g⁻¹ * (g * y ^ n * g⁻¹) * g := by group
    _ = 1 := by rw [h2]; group

end RootAdjunction

end RHTower
