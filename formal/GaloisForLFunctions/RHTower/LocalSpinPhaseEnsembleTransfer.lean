import GaloisForLFunctions.RHTower.FermionicSpinChainRealization
import GaloisForLFunctions.RHTower.ProjectiveWeightedTargetVolumeLower
import Mathlib.Analysis.SpecialFunctions.Complex.Arg

/-!
# Exact local-spin transfer of the projective phase ensemble

Independent real onsite fields define a diagonal one-particle Hamiltonian.
The existing fermionic spin-chain construction lifts it to a Hermitian,
particle-number-preserving local XX Hamiltonian whose single-excitation block
is exactly diagonal with those energies.

Every torus phase has a real argument, so at one tick every projective phase
packet is realized by such an onsite-field Hamiltonian. Consequently the Haar
target-volume law transfers exactly to the ensemble of independently uniform
onsite-field phases. This is an explicit local ensemble, not a claim that
generic interacting local Hamiltonians have independent Haar eigenphases.
-/

open MeasureTheory
open scoped BigOperators InnerProductSpace
open Complex

noncomputable section

namespace RHTower

open ParityForecast

/-- Diagonal one-particle Hamiltonian generated by independent onsite
energies. -/
def independentOnsiteFieldOneParticleMatrix {d : ℕ}
    (energy : Fin d → ℝ) : Matrix (Fin d) (Fin d) ℂ :=
  fun i j => if i = j then energy i else 0

theorem independentOnsiteFieldOneParticleMatrix_nearestNeighbor {d : ℕ}
    (energy : Fin d → ℝ) :
    ParityForecast.MatrixNearestNeighbor
      (independentOnsiteFieldOneParticleMatrix energy) := by
  intro i j hij _hnot
  simp [independentOnsiteFieldOneParticleMatrix, hij]

theorem independentOnsiteFieldOneParticleMatrix_isHermitian {d : ℕ}
    (energy : Fin d → ℝ) :
    (independentOnsiteFieldOneParticleMatrix energy).IsHermitian := by
  apply Matrix.IsHermitian.ext
  intro i j
  by_cases hij : i = j
  · subst j
    simp [independentOnsiteFieldOneParticleMatrix]
  · simp [independentOnsiteFieldOneParticleMatrix, hij, Ne.symm hij]

/-- The local XX spin Hamiltonian has the prescribed onsite-field matrix as
its exact single-excitation block. -/
theorem independentOnsiteField_localSpin_singleExcitation_block {d : ℕ}
    (energy : Fin d → ℝ) (i j : Fin d) :
    ParityForecast.xxOccupationMatrix
        (independentOnsiteFieldOneParticleMatrix energy) {i} {j} =
      independentOnsiteFieldOneParticleMatrix energy i j := by
  exact ParityForecast.xxOccupationMatrix_singleton
    (independentOnsiteFieldOneParticleMatrix_nearestNeighbor energy)
    (independentOnsiteFieldOneParticleMatrix_isHermitian energy) i j

/-- Principal real onsite energy realizing a prescribed one-tick torus
phase. -/
def torusIndependentOnsiteFieldEnergy {d : ℕ}
    (x : Fin d → UnitAddCircle) (j : Fin d) : ℝ :=
  (fourier 1 (x j)).arg

theorem exp_I_torusIndependentOnsiteFieldEnergy {d : ℕ}
    (x : Fin d → UnitAddCircle) (j : Fin d) :
    Complex.exp
        (Complex.I * ((torusIndependentOnsiteFieldEnergy x j : ℝ) : ℂ)) =
      fourier 1 (x j) := by
  have hnorm : ‖fourier 1 (x j)‖ = 1 := by
    rw [fourier_apply, Circle.norm_coe]
  have h := Complex.norm_mul_exp_arg_mul_I (fourier 1 (x j))
  simpa [torusIndependentOnsiteFieldEnergy, hnorm, mul_comm] using h

/-- Pure-state return amplitude in the exact local onsite-field
realization. -/
def independentOnsiteFieldReturnAmplitude {d : ℕ}
    (w : Fin d → ℝ) (x : Fin d → UnitAddCircle) : ℂ :=
  ∑ j, (w j : ℂ) *
    Complex.exp
      (Complex.I * ((torusIndependentOnsiteFieldEnergy x j : ℝ) : ℂ))

theorem independentOnsiteFieldReturnAmplitude_eq_projective {d : ℕ}
    (w : Fin d → ℝ) (x : Fin d → UnitAddCircle) :
    independentOnsiteFieldReturnAmplitude w x =
      projectiveWeightedPhaseAmplitude w (fun j => fourier 1 (x j)) := by
  unfold independentOnsiteFieldReturnAmplitude
  simp_rw [exp_I_torusIndependentOnsiteFieldEnergy]
  rfl

/-- One-tick return target for independently tunable local onsite-field
phases. -/
def torusIndependentOnsiteFieldReturnTarget {d : ℕ}
    (w : Fin d → ℝ) (η : ℝ) : Set (Fin d → UnitAddCircle) :=
  {x | 1 - η ≤ ‖independentOnsiteFieldReturnAmplitude w x‖}

/-- Exact ensemble transfer: the local onsite-field target is the projective
phase target, not an approximation to it. -/
theorem torusIndependentOnsiteFieldReturnTarget_eq_projective {d : ℕ}
    (w : Fin d → ℝ) (η : ℝ) :
    torusIndependentOnsiteFieldReturnTarget w η =
      torusProjectiveWeightedCoherenceTarget w η := by
  ext x
  simp only [torusIndependentOnsiteFieldReturnTarget,
    torusProjectiveWeightedCoherenceTarget, Set.mem_setOf_eq,
    independentOnsiteFieldReturnAmplitude_eq_projective]

theorem measureReal_torusIndependentOnsiteFieldReturnTarget_eq_projective
    {d : ℕ} (w : Fin d → ℝ) (η : ℝ) :
    volume.real (torusIndependentOnsiteFieldReturnTarget w η) =
      volume.real (torusProjectiveWeightedCoherenceTarget w η) := by
  rw [torusIndependentOnsiteFieldReturnTarget_eq_projective]

/-- Lower half of the water law for the exact local onsite-field ensemble. -/
theorem canonicalEntropyFactor_le_volumeReal_independentOnsiteFieldReturnTarget
    {d : ℕ} (hd : 0 < d) (w : Fin d → ℝ)
    (hw : ∀ j, 0 ≤ w j) (hmass : ∑ j, w j = 1)
    {eta : ℝ} (heta : 0 < eta) :
    (Real.sqrt 2 / Real.pi) ^ (d - 1) *
        Real.exp
          (-projectiveCanonicalWaterEntropyMinimum hd w eta) ≤
      volume.real (torusIndependentOnsiteFieldReturnTarget w eta) := by
  rw [torusIndependentOnsiteFieldReturnTarget_eq_projective]
  exact canonicalEntropyFactor_le_volumeReal_coherenceTarget
    hd w hw hmass heta

/-- Upper half of the water law for the exact local onsite-field ensemble. -/
theorem volumeReal_independentOnsiteFieldReturnTarget_le_canonicalEntropyFactor
    {d : ℕ} (hd : 2 ≤ d) (w : Fin d → ℝ)
    (hw : ∀ j, 0 ≤ w j) (hmass : ∑ j, w j = 1)
    {eta : ℝ} (heta : eta ≤ 1) :
    volume.real (torusIndependentOnsiteFieldReturnTarget w eta) ≤
      (d : ℝ) * Real.exp (
        (Real.pi / 4) * (d - 1 : ℕ) -
          projectiveCanonicalWaterEntropyMinimum (by omega) w eta) := by
  rw [torusIndependentOnsiteFieldReturnTarget_eq_projective]
  exact volumeReal_coherenceTarget_le_canonicalEntropyFactor
    hd w hw hmass heta

end RHTower
