import GaloisForLFunctions.RHTower.Schanuel.SchanuelIntegralIsogenyValueField
import GaloisForLFunctions.HTGeometry.SchanuelIsogenyCore

namespace GaloisForLFunctions.RHTower

noncomputable section

/-- A nonsingular integral two-by-two matrix in explicit coordinates. -/
structure IntegralIsogenyMatrix2 where
  a : ℤ
  b : ℤ
  c : ℤ
  d : ℤ
  det_ne : a * d - b * c ≠ 0

namespace IntegralIsogenyMatrix2

def det (M : IntegralIsogenyMatrix2) : ℤ := M.a * M.d - M.b * M.c

theorem det_ne_zero (M : IntegralIsogenyMatrix2) : M.det ≠ 0 := M.det_ne

end IntegralIsogenyMatrix2

/-- Additive coordinates after one explicit integral isogeny. -/
def integralIsogenyAdditiveCoordinates
    {K : Type*} [Field K] (x : Fin 2 → K) (M : IntegralIsogenyMatrix2) : Fin 2 → K :=
  fun i ↦ if i = 0 then (M.a : K) * x 0 + (M.b : K) * x 1
    else (M.c : K) * x 0 + (M.d : K) * x 1

/-- Multiplicative coordinates after one explicit integral isogeny. -/
def integralIsogenyMultiplicativeCoordinates
    {K : Type*} [Field K] (y : Fin 2 → K) (M : IntegralIsogenyMatrix2) : Fin 2 → K :=
  fun i ↦ if i = 0 then y 0 ^ M.a * y 1 ^ M.b
    else y 0 ^ M.c * y 1 ^ M.d

/-- Concrete field generated by one full-rank integral isogeny transform. -/
def integralMatrixIsogenyValueField
    (A K : Type*) [Field A] [Field K] [Algebra A K]
    (x y : Fin 2 → K) (M : IntegralIsogenyMatrix2) : IntermediateField A K :=
  IntermediateField.adjoin A
    (Set.range (integralIsogenyAdditiveCoordinates x M) ∪
      Set.range (integralIsogenyMultiplicativeCoordinates y M))

/-- Concrete field generated by unchanged additive coordinates and one common positive power of
the multiplicative coordinates. -/
def scalarPowerIsogenyValueField
    (A K : Type*) [Field A] [Field K] [Algebra A K]
    (x y : Fin 2 → K) (m : GaloisForLFunctions.HTGeometry.PositiveNat) :
    IntermediateField A K :=
  IntermediateField.adjoin A
    (Set.range x ∪ Set.range (fun i ↦ y i ^ (m : ℕ)))

/-- The scalar matrix with common positive diagonal entry `m`. -/
def scalarIntegralIsogenyMatrix2
    (m : GaloisForLFunctions.HTGeometry.PositiveNat) : IntegralIsogenyMatrix2 where
  a := (m : ℕ)
  b := 0
  c := 0
  d := (m : ℕ)
  det_ne := by
    simp only [mul_zero, sub_zero]
    exact mul_ne_zero (Int.ofNat_ne_zero.mpr (Nat.ne_of_gt m.property))
      (Int.ofNat_ne_zero.mpr (Nat.ne_of_gt m.property))

/-- Adjugate containment: the scalar-power field at the absolute determinant lies inside the
value field of the original nonsingular integral matrix. -/
theorem scalarPowerIsogenyValueField_le_integralMatrixIsogenyValueField
    {A K : Type*} [Field A] [Field K] [Algebra A K] [CharZero K]
    (x y : Fin 2 → K) (hy0 : ∀ i, y i ≠ 0) (M : IntegralIsogenyMatrix2) :
    let m : GaloisForLFunctions.HTGeometry.PositiveNat :=
      ⟨M.det.natAbs, Int.natAbs_pos.mpr M.det_ne_zero⟩
    scalarPowerIsogenyValueField A K x y m ≤
      integralMatrixIsogenyValueField A K x y M := by
  classical
  dsimp only
  let z := integralIsogenyAdditiveCoordinates x M
  let w := integralIsogenyMultiplicativeCoordinates y M
  let B := integralMatrixIsogenyValueField A K x y M
  have hzB : ∀ i, z i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _
      (Set.mem_union_left _ (Set.mem_range_self i))
  have hwB : ∀ i, w i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _
      (Set.mem_union_right _ (Set.mem_range_self i))
  have hdetK : (M.det : K) ≠ 0 := by exact_mod_cast M.det_ne_zero
  have hx0B : x 0 ∈ B := by
    rw [show x 0 = ((M.d : K) * z 0 - (M.b : K) * z 1) / (M.det : K) by
      apply (eq_div_iff hdetK).2
      simp [z, integralIsogenyAdditiveCoordinates, IntegralIsogenyMatrix2.det]
      ring]
    exact B.div_mem
      (B.sub_mem (B.mul_mem (B.intCast_mem M.d) (hzB 0))
        (B.mul_mem (B.intCast_mem M.b) (hzB 1)))
      (B.intCast_mem M.det)
  have hx1B : x 1 ∈ B := by
    rw [show x 1 = (-(M.c : K) * z 0 + (M.a : K) * z 1) / (M.det : K) by
      apply (eq_div_iff hdetK).2
      simp [z, integralIsogenyAdditiveCoordinates, IntegralIsogenyMatrix2.det]
      ring]
    exact B.div_mem
      (B.add_mem (B.mul_mem (B.neg_mem (B.intCast_mem M.c)) (hzB 0))
        (B.mul_mem (B.intCast_mem M.a) (hzB 1)))
      (B.intCast_mem M.det)
  have hw0eq : w 0 = y 0 ^ M.a * y 1 ^ M.b := by
    simp [w, integralIsogenyMultiplicativeCoordinates]
  have hw1eq : w 1 = y 0 ^ M.c * y 1 ^ M.d := by
    simp [w, integralIsogenyMultiplicativeCoordinates]
  have hy0detZ : y 0 ^ M.det ∈ B := by
    rw [show y 0 ^ M.det = w 0 ^ M.d * w 1 ^ (-M.b) by
      symm
      rw [hw0eq, hw1eq]
      rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_mul]
      calc
        y 0 ^ (M.a * M.d) * y 1 ^ (M.b * M.d) *
            (y 0 ^ (M.c * -M.b) * y 1 ^ (M.d * -M.b)) =
            (y 0 ^ (M.a * M.d) * y 0 ^ (M.c * -M.b)) *
              (y 1 ^ (M.b * M.d) * y 1 ^ (M.d * -M.b)) := by ring
        _ = y 0 ^ (M.a * M.d + M.c * -M.b) *
            y 1 ^ (M.b * M.d + M.d * -M.b) := by
              rw [zpow_add₀ (hy0 0), zpow_add₀ (hy0 1)]
        _ = y 0 ^ M.det := by
          rw [show M.b * M.d + M.d * -M.b = 0 by ring, zpow_zero, mul_one]
          congr 1
          simp [IntegralIsogenyMatrix2.det]
          ring]
    exact B.mul_mem (B.pow_mem (hwB 0) M.d) (B.pow_mem (hwB 1) (-M.b))
  have hy1detZ : y 1 ^ M.det ∈ B := by
    rw [show y 1 ^ M.det = w 0 ^ (-M.c) * w 1 ^ M.a by
      symm
      rw [hw0eq, hw1eq]
      rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_mul]
      calc
        y 0 ^ (M.a * -M.c) * y 1 ^ (M.b * -M.c) *
            (y 0 ^ (M.c * M.a) * y 1 ^ (M.d * M.a)) =
            (y 0 ^ (M.a * -M.c) * y 0 ^ (M.c * M.a)) *
              (y 1 ^ (M.b * -M.c) * y 1 ^ (M.d * M.a)) := by ring
        _ = y 0 ^ (M.a * -M.c + M.c * M.a) *
            y 1 ^ (M.b * -M.c + M.d * M.a) := by
              rw [zpow_add₀ (hy0 0), zpow_add₀ (hy0 1)]
        _ = y 1 ^ M.det := by
          rw [show M.a * -M.c + M.c * M.a = 0 by ring, zpow_zero, one_mul]
          congr 1
          simp [IntegralIsogenyMatrix2.det]
          ring]
    exact B.mul_mem (B.pow_mem (hwB 0) (-M.c)) (B.pow_mem (hwB 1) M.a)
  have hypow : ∀ i, y i ^ M.det.natAbs ∈ B := by
    intro i
    have hdetZ : y i ^ M.det ∈ B := by
      fin_cases i
      · exact hy0detZ
      · exact hy1detZ
    have hzz : y i ^ (((M.det.natAbs : ℕ) : ℤ)) ∈ B := by
      rcases le_or_gt 0 M.det with hpos | hneg
      · rw [show (((M.det.natAbs : ℕ) : ℤ)) = M.det by omega]
        exact hdetZ
      · rw [show (((M.det.natAbs : ℕ) : ℤ)) = -M.det by omega, zpow_neg]
        exact B.inv_mem hdetZ
    rwa [zpow_natCast] at hzz
  unfold scalarPowerIsogenyValueField
  rw [IntermediateField.adjoin_le_iff]
  rintro t (ht | ht)
  · obtain ⟨i, rfl⟩ := ht
    fin_cases i
    · exact hx0B
    · exact hx1B
  · obtain ⟨i, rfl⟩ := ht
    exact hypow i

/-- The value field of a scalar matrix lies in the corresponding common-power value field. -/
theorem integralMatrixIsogenyValueField_scalar_le
    {A K : Type*} [Field A] [Field K] [Algebra A K] [CharZero K]
    (x y : Fin 2 → K) (m : GaloisForLFunctions.HTGeometry.PositiveNat) :
    integralMatrixIsogenyValueField A K x y (scalarIntegralIsogenyMatrix2 m) ≤
      scalarPowerIsogenyValueField A K x y m := by
  classical
  have hyPow : ∀ i, y i ^ (m : ℕ) ∈ scalarPowerIsogenyValueField A K x y m := by
    intro i
    unfold scalarPowerIsogenyValueField
    exact IntermediateField.subset_adjoin A _
      (Set.mem_union_right _ (Set.mem_range_self i))
  unfold integralMatrixIsogenyValueField
  rw [IntermediateField.adjoin_le_iff]
  rintro t (ht | ht)
  · obtain ⟨i, rfl⟩ := ht
    fin_cases i
    · simpa [integralIsogenyAdditiveCoordinates, scalarIntegralIsogenyMatrix2] using
        (scalarPowerIsogenyValueField A K x y m).mul_mem
          ((scalarPowerIsogenyValueField A K x y m).natCast_mem (m : ℕ))
          (IntermediateField.subset_adjoin A _
            (Set.mem_union_left _ (Set.mem_range_self 0)))
    · simpa [integralIsogenyAdditiveCoordinates, scalarIntegralIsogenyMatrix2] using
        (scalarPowerIsogenyValueField A K x y m).mul_mem
          ((scalarPowerIsogenyValueField A K x y m).natCast_mem (m : ℕ))
          (IntermediateField.subset_adjoin A _
            (Set.mem_union_left _ (Set.mem_range_self 1)))
  · obtain ⟨i, rfl⟩ := ht
    fin_cases i
    · simpa [integralIsogenyMultiplicativeCoordinates, scalarIntegralIsogenyMatrix2,
        zpow_natCast] using hyPow 0
    · simpa [integralIsogenyMultiplicativeCoordinates, scalarIntegralIsogenyMatrix2,
        zpow_natCast] using hyPow 1

/-- Intersection over all nonsingular integral matrices. -/
def fullIntegralIsogenyCore
    (A K : Type*) [Field A] [Field K] [Algebra A K]
    (x y : Fin 2 → K) : IntermediateField A K :=
  ⨅ M : IntegralIsogenyMatrix2, integralMatrixIsogenyValueField A K x y M

/-- Intersection over all positive scalar-power isogenies. -/
def scalarPowerIsogenyCore
    (A K : Type*) [Field A] [Field K] [Algebra A K]
    (x y : Fin 2 → K) : IntermediateField A K :=
  ⨅ m : GaloisForLFunctions.HTGeometry.PositiveNat,
    scalarPowerIsogenyValueField A K x y m

/-- Full integral-isogeny core equals scalar-power core. -/
theorem fullIntegralIsogenyCore_eq_scalarPowerIsogenyCore
    {A K : Type*} [Field A] [Field K] [Algebra A K] [CharZero K]
    (x y : Fin 2 → K) (hy0 : ∀ i, y i ≠ 0) :
    fullIntegralIsogenyCore A K x y = scalarPowerIsogenyCore A K x y := by
  apply le_antisymm
  · refine le_iInf fun m ↦ ?_
    calc
      fullIntegralIsogenyCore A K x y ≤
          integralMatrixIsogenyValueField A K x y (scalarIntegralIsogenyMatrix2 m) :=
        iInf_le _ _
      _ ≤ scalarPowerIsogenyValueField A K x y m :=
        integralMatrixIsogenyValueField_scalar_le x y m
  · refine le_iInf fun M ↦ ?_
    let m : GaloisForLFunctions.HTGeometry.PositiveNat :=
      ⟨M.det.natAbs, Int.natAbs_pos.mpr M.det_ne_zero⟩
    calc
      scalarPowerIsogenyCore A K x y ≤ scalarPowerIsogenyValueField A K x y m :=
        iInf_le _ _
      _ ≤ integralMatrixIsogenyValueField A K x y M :=
        scalarPowerIsogenyValueField_le_integralMatrixIsogenyValueField x y hy0 M

end


end GaloisForLFunctions.RHTower

