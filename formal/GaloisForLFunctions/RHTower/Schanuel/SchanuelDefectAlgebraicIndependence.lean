import GaloisForLFunctions.HTGeometry.AffineExponentialStableHopfLocus
import GaloisForLFunctions.HTGeometry.AlgebraicClosureAlgClosed
import GaloisForLFunctions.RHTower.Schanuel.SchanuelInvariantKaehlerForm
import GaloisForLFunctions.RHTower.Schanuel.SchanuelLatticeBakerAssembly
import GaloisForLFunctions.RHTower.Schanuel.SchanuelAlgebraicCosetBaker

/-!
# Algebraic-coefficient independence of Schanuel defects

A rationally independent complex exponential tuple has linearly independent numerical
logarithmic Kähler defects over the algebraic closure of `ℚ` in `ℂ`.  The proof converts a
putative invariant-form relation into the stable Hopf ideal generated by the exact point locus,
extracts its torus lattice and additive relation, and closes the contradiction with Baker's
theorem for algebraic linear forms in independent logarithms.
-/

namespace GaloisForLFunctions.RHTower

open GaloisForLFunctions.HTGeometry
open AffineExponentialGroup AffineExponentialSubgroups
open AffineExponentialPointEvaluation AffineExponentialPointClosure
open AffineExponentialProjectionClassification
open MixedAdditiveProjectionClassification
open AffineExponentialCoLieClassification
open AffineExponentialInvariantKaehler
open TorusCharacterCoLie LatticeSpanFinite

noncomputable section

/-- Scalar extension sends the span of an integral character lattice over the algebraic numbers
into its complex span. -/
theorem latticeSpan_algebraicClosure_to_complex
    {n : ℕ} (L : AddSubgroup (Fin n →₀ ℤ))
    (c : Fin n → algebraicClosure ℚ ℂ)
    (hc : c ∈ latticeSpan (algebraicClosure ℚ ℂ) L) :
    (fun i ↦ (c i : ℂ)) ∈ latticeSpan ℂ L := by
  obtain ⟨r, m, a, hm, hrep⟩ :=
    (mem_latticeSpan_iff_exists_fin (algebraicClosure ℚ ℂ) L c).mp hc
  apply (mem_latticeSpan_iff_exists_fin ℂ L (fun i ↦ (c i : ℂ))).mpr
  refine ⟨r, m, fun j ↦ (a j : ℂ), hm, ?_⟩
  funext i
  have hi := congrFun hrep i
  simpa [Pi.smul_apply, integralCast, Algebra.smul_def] using
    congrArg (fun z : algebraicClosure ℚ ℂ ↦ (z : ℂ)) hi

/-- A stable Hopf locus carrying the Schanuel invariant-form relation forces every algebraic
coefficient to vanish. -/
theorem algebraic_coefficients_eq_zero_of_stableHopfLocus
    {n : ℕ} (x : Fin n → ℂ) (hx : LinearIndependent ℚ x)
    (c : Fin n → algebraicClosure ℚ ℂ)
    (H : AffineExponentialStableHopfLocus
      (algebraicClosure ℚ ℂ) ℂ n (schanuelExponentialPoint x)
      c (fun i ↦ -c i)) :
    c = 0 := by
  classical
  let A := algebraicClosure ℚ ℂ
  letI : H.ideal.IsHopfIdeal A := H.isHopfIdeal
  have hrelations :=
    (coLieMap_subgroupQuotient_eq_zero_iff A H.ideal c
      (fun i ↦ -c i)).mp H.coLie_zero
  apply algebraic_coefficients_eq_zero_of_latticeSpan x hx
    (torusRelationLattice A H.ideal) c
    (latticeSpan_algebraicClosure_to_complex
      (torusRelationLattice A H.ideal) c hrelations.1)
  · intro m hm
    have hmem : torusRelation A m ∈ H.ideal :=
      (mem_torusRelationLattice_iff A H.ideal m).mp hm
    have hz := H.coset_zero (torusRelation A m) hmem
    change eval (k := A) (schanuelExponentialPoint x)
      (rightTranslate H.algebraicPoint⁻¹ (torusRelation A m)) = 0 at hz
    rw [torusRelation, map_sub, rightTranslate_torusCharacter,
      map_one] at hz
    rw [map_sub, map_mul, map_one] at hz
    rw [sub_eq_zero] at hz
    let u : A :=
      (AlgebraicTorusCharacter.character
        (torusPart H.algebraicPoint⁻¹) m : A)
    have hconst :
        eval (k := A) (schanuelExponentialPoint x)
            (algebraMap A (CoordinateAlgebra A n) u) =
          algebraMap A ℂ u :=
      (eval (k := A) (schanuelExponentialPoint x)).commutes u
    rw [hconst, eval_torusCharacter] at hz
    change (u : ℂ) *
        (AlgebraicTorusCharacter.character
          (torusPart (schanuelExponentialPoint x)) m : ℂ) = 1 at hz
    have hu : u ≠ 0 := Units.ne_zero _
    have huC : (u : ℂ) ≠ 0 := by
      intro h
      exact hu (Subtype.ext h)
    have hchar :
        (AlgebraicTorusCharacter.character
          (torusPart (schanuelExponentialPoint x)) m : ℂ) =
          (u : ℂ)⁻¹ := by
      apply mul_left_cancel₀ huC
      rw [mul_inv_cancel₀ huC]
      exact hz
    have hpchar :
        (AlgebraicTorusCharacter.character
          (torusPart (schanuelExponentialPoint x)) m : ℂ) =
          ∏ i, Complex.exp (x i) ^ (m i) := by
      rw [AlgebraicTorusCharacter.character_apply_of_subset
        (Finset.subset_univ m.support)
        (torusPart (schanuelExponentialPoint x))]
      rw [Units.coe_prod]
      apply Finset.prod_congr rfl
      intro i _
      rw [coe_units_zpow_complex]
      exact congrArg (fun z : ℂ ↦ z ^ (m i))
        (torusPart_schanuelExponentialPoint x i)
    rw [← hpchar, hchar]
    exact (mem_algebraicClosure_iff.mp u.2).inv
  · let S := additiveRelationSubspace A H.ideal
    have hcAdd : c ∈ S := by
      have hneg : -(fun i ↦ -c i) ∈ S := S.neg_mem hrelations.2
      rw [show c = -(fun i ↦ -c i) by
        funext i
        simp]
      exact hneg
    have hmem : additiveLinear A c ∈ H.ideal :=
      (mem_additiveRelationSubspace_iff A H.ideal c).mp hcAdd
    have hz := H.coset_zero (additiveLinear A c) hmem
    change eval (k := A) (schanuelExponentialPoint x)
      (rightTranslate H.algebraicPoint⁻¹ (additiveLinear A c)) = 0 at hz
    rw [rightTranslate_additiveLinear] at hz
    let ep : CoordinateAlgebra A n →ₐ[A] ℂ :=
      eval (k := A) (schanuelExponentialPoint x)
    change ep (additiveLinear A c +
      algebraMap A (CoordinateAlgebra A n)
        (eval (k := A) H.algebraicPoint⁻¹ (additiveLinear A c))) = 0 at hz
    have hzscalar : ep (additiveLinear A c) +
        algebraMap A ℂ
          (eval (k := A) H.algebraicPoint⁻¹ (additiveLinear A c)) = 0 := by
      calc
        _ = ep (additiveLinear A c) +
            ep (algebraMap A (CoordinateAlgebra A n)
              (eval (k := A) H.algebraicPoint⁻¹
                (additiveLinear A c))) :=
          congrArg (ep (additiveLinear A c) + ·)
            (ep.commutes (eval (k := A) H.algebraicPoint⁻¹
              (additiveLinear A c))).symm
        _ = ep (additiveLinear A c +
            algebraMap A (CoordinateAlgebra A n)
              (eval (k := A) H.algebraicPoint⁻¹
                (additiveLinear A c))) :=
          (ep.map_add _ _).symm
        _ = 0 := hz
    have hevalP :
        eval (k := A) (schanuelExponentialPoint x) (additiveLinear A c) =
          AffineExponentialPointEvaluation.additiveLinearEval
            (k := A) (additivePart (schanuelExponentialPoint x)) c := by
      simp [additiveLinear]
    have hevalQ :
        eval (k := A) H.algebraicPoint⁻¹ (additiveLinear A c) =
          AffineExponentialPointEvaluation.additiveLinearEval
            (k := A) (additivePart H.algebraicPoint⁻¹) c := by
      simp [additiveLinear]
    rw [hevalP, hevalQ] at hzscalar
    have hz' : (∑ i, (c i : ℂ) * x i) +
        algebraMap A ℂ
          (AffineExponentialPointEvaluation.additiveLinearEval
            (k := A) (additivePart H.algebraicPoint⁻¹) c) = 0 := by
      simpa [AffineExponentialPointEvaluation.additiveLinearEval,
        additivePart_schanuelExponentialPoint] using hzscalar
    have heq : (∑ i, (c i : ℂ) * x i) =
        -algebraMap A ℂ
          (AffineExponentialPointEvaluation.additiveLinearEval
            (k := A) (additivePart H.algebraicPoint⁻¹) c) :=
      eq_neg_of_add_eq_zero_left hz'
    rw [heq]
    exact (mem_algebraicClosure_iff.mp
      (AffineExponentialPointEvaluation.additiveLinearEval
        (k := A) (additivePart H.algebraicPoint⁻¹) c).2).neg

/-- Every algebraic-coefficient relation among defects of a rationally independent complex tuple
is trivial. -/
theorem schanuelDefect_algebraic_relation
    {n : ℕ} (x : Fin n → ℂ) (hx : LinearIndependent ℚ x)
    (c : Fin n → algebraicClosure ℚ ℂ)
    (hdefect : ∑ i, c i • schanuelDefect (x i) = 0) :
    c = 0 := by
  letI : IsAlgClosed (algebraicClosure ℚ ℂ) :=
    algebraicClosure_isAlgClosed ℚ ℂ
  let p := schanuelExponentialPoint x
  have hw := pointKaehlerMap_schanuelInvariantVector_eq_zero_of_relation
    x c hdefect
  let H := Classical.choice
    (exists_affineExponentialStableHopfLocus
      (algebraicClosure ℚ ℂ) ℂ p c (fun i ↦ -c i) hw)
  exact algebraic_coefficients_eq_zero_of_stableHopfLocus x hx c H

/-- **Algebraic-coefficient exponential-defect independence.** Defects of a rationally independent
complex tuple are linearly independent over the algebraic closure of `ℚ` in `ℂ`. -/
theorem schanuelDefect_linearIndependent_algebraic
    {n : ℕ} (x : Fin n → ℂ) (hx : LinearIndependent ℚ x) :
    LinearIndependent (algebraicClosure ℚ ℂ)
      (fun i ↦ schanuelDefect (x i)) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  exact congrFun (schanuelDefect_algebraic_relation x hx c hc) i

end

end GaloisForLFunctions.RHTower
