import GaloisForLFunctions.RHTower.Schanuel.SchanuelDefectAlgebraicSlope
import GaloisForLFunctions.RHTower.Schanuel.SchanuelValueFieldInstance
import GaloisForLFunctions.RHTower.Schanuel.SchanuelKaehlerDimension
import GaloisForLFunctions.RHTower.Schanuel.SchanuelDefectValueField
import GaloisForLFunctions.HTGeometry.DefectSlopeNormalForm
import GaloisForLFunctions.HTGeometry.CubeSwapGaloisAssembly

/-!
# Algebraic core of the stage-two Schanuel defect-slope normal form

This module instantiates the concrete field generated by two exponents and their exponentials,
constructs its intrinsic Kähler defects, and proves clauses 1–3 of the stage-two normal form.  The
field has transcendence degree one, the second defect has a unique slope against the first, that
slope is transcendental over the algebraic numbers, and the value field is finite over the simple
field generated by the slope.
-/

namespace GaloisForLFunctions.RHTower

open GaloisForLFunctions.HTGeometry
open IntermediateField

noncomputable section

/-- Four generators of the concrete stage-two value field. -/
def stageTwoGenerator (x : Fin 2 → ℂ) : Fin 4 → ℂ :=
  ![x 0, x 1, Complex.exp (x 0), Complex.exp (x 1)]

theorem range_stageTwoGenerator (x : Fin 2 → ℂ) :
    Set.range (stageTwoGenerator x) =
      {x 0, x 1, Complex.exp (x 0), Complex.exp (x 1)} := by
  ext z
  simp [stageTwoGenerator]
  tauto

theorem stageTwoValueField_eq_adjoin_range (x : Fin 2 → ℂ) :
    stageTwoValueField (x 0) (x 1) =
      IntermediateField.adjoin AlgNum (Set.range (stageTwoGenerator x)) := by
  rw [stageTwoValueField, range_stageTwoGenerator]

/-- The four complex generators corestricted to their generated field. -/
def stageTwoGeneratorIn (x : Fin 2 → ℂ) (j : Fin 4) :
    stageTwoValueField (x 0) (x 1) :=
  ⟨stageTwoGenerator x j, by
    rw [stageTwoValueField_eq_adjoin_range]
    exact IntermediateField.subset_adjoin _ _ (Set.mem_range_self j)⟩

theorem adjoin_range_stageTwoGeneratorIn_eq_top (x : Fin 2 → ℂ) :
    IntermediateField.adjoin AlgNum (Set.range (stageTwoGeneratorIn x)) = ⊤ := by
  let K := stageTwoValueField (x 0) (x 1)
  apply IntermediateField.map_injective K.val
  have hleft :
      (IntermediateField.adjoin AlgNum
        (Set.range (stageTwoGeneratorIn x))).map K.val = K := by
    rw [IntermediateField.adjoin_map]
    have himage : K.val '' Set.range (stageTwoGeneratorIn x) =
        Set.range (stageTwoGenerator x) := by
      ext z
      constructor
      · rintro ⟨-, ⟨j, rfl⟩, rfl⟩
        exact ⟨j, rfl⟩
      · rintro ⟨j, rfl⟩
        exact ⟨stageTwoGeneratorIn x j, ⟨j, rfl⟩, rfl⟩
    rw [himage, ← stageTwoValueField_eq_adjoin_range]
  have hright : (⊤ : IntermediateField AlgNum K).map K.val = K := by
    refine SetLike.coe_injective ?_
    ext z
    constructor
    · rintro ⟨w, -, rfl⟩
      exact w.2
    · intro hz
      exact ⟨⟨z, hz⟩, trivial, rfl⟩
  rw [hleft, hright]

/-- The exponent coordinates inside the stage-two value field. -/
def stageTwoExponentIn (x : Fin 2 → ℂ) (i : Fin 2) :
    stageTwoValueField (x 0) (x 1) :=
  ⟨x i, by
    apply IntermediateField.subset_adjoin AlgNum _
    fin_cases i <;> simp⟩

/-- The exponential coordinates inside the stage-two value field. -/
def stageTwoExponentialIn (x : Fin 2 → ℂ) (i : Fin 2) :
    stageTwoValueField (x 0) (x 1) :=
  ⟨Complex.exp (x i), by
    apply IntermediateField.subset_adjoin AlgNum _
    fin_cases i <;> simp⟩

/-- Intrinsic logarithmic Kähler defect in the concrete stage-two value field. -/
def stageTwoDefect (x : Fin 2 → ℂ) (i : Fin 2) :
    KaehlerDifferential AlgNum (stageTwoValueField (x 0) (x 1)) :=
  (stageTwoExponentialIn x i)⁻¹ •
      KaehlerDifferential.D AlgNum (stageTwoValueField (x 0) (x 1))
        (stageTwoExponentialIn x i) -
    KaehlerDifferential.D AlgNum (stageTwoValueField (x 0) (x 1))
      (stageTwoExponentIn x i)

/-- Scalar extension of the intrinsic defect is the ambient numerical Schanuel defect. -/
theorem map_stageTwoDefect (x : Fin 2 → ℂ) (i : Fin 2) :
    KaehlerDifferential.map AlgNum AlgNum
      (stageTwoValueField (x 0) (x 1)) ℂ (stageTwoDefect x i) =
      schanuelDefect (x i) := by
  simp only [stageTwoDefect, schanuelDefect, map_sub, map_smul,
    KaehlerDifferential.map_D, IntermediateField.algebraMap_apply]
  change ((stageTwoExponentialIn x i :
      stageTwoValueField (x 0) (x 1)) : ℂ)⁻¹ •
      KaehlerDifferential.D AlgNum ℂ
        (stageTwoExponentialIn x i : ℂ) -
    KaehlerDifferential.D AlgNum ℂ (stageTwoExponentIn x i : ℂ) = _
  rfl

/-- Rational independence makes each intrinsic stage-two defect nonzero. -/
theorem stageTwoDefect_ne_zero
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x) (i : Fin 2) :
    stageTwoDefect x i ≠ 0 := by
  intro hzero
  have hmap := congrArg
    (KaehlerDifferential.map AlgNum AlgNum
      (stageTwoValueField (x 0) (x 1)) ℂ) hzero
  rw [map_zero, map_stageTwoDefect] at hmap
  have hLI := schanuelDefect_linearIndependent_algebraic x hx
  have hc := Fintype.linearIndependent_iff.mp hLI
    (Pi.single i 1) (by simp [hmap]) i
  simp only [Pi.single_eq_same] at hc
  exact one_ne_zero hc

/-- In the degree-one value field, the intrinsic second defect has a unique slope against the
first. -/
theorem existsUnique_stageTwoDefectSlope
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hlt : Algebra.trdeg AlgNum (stageTwoValueField (x 0) (x 1)) < 2) :
    ∃! rho : stageTwoValueField (x 0) (x 1),
      stageTwoDefect x 1 = rho • stageTwoDefect x 0 := by
  have htrdeg := trdeg_stageTwoValueField_eq_one_of_linearIndependent hx hlt
  have hrank := finrank_kaehlerDifferential_eq_one_of_trdeg_eq_one htrdeg
  exact existsUnique_defectSlope hrank (stageTwoDefect_ne_zero x hx 0)
    (stageTwoDefect x 1)

/-- Every intrinsic stage-two defect slope is transcendental over the algebraic numbers. -/
theorem stageTwoDefectSlope_transcendental
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (rho : stageTwoValueField (x 0) (x 1))
    (hslope : stageTwoDefect x 1 = rho • stageTwoDefect x 0) :
    Transcendental AlgNum rho := by
  let Phi := KaehlerDifferential.map AlgNum AlgNum
    (stageTwoValueField (x 0) (x 1)) ℂ
  have hmap := congrArg Phi hslope
  have hslopeRaw : schanuelDefect (x 1) =
      rho • schanuelDefect (x 0) := by
    simpa only [Phi, map_smul, map_stageTwoDefect] using hmap
  have hscalar : rho • schanuelDefect (x 0) =
      (rho : ℂ) • schanuelDefect (x 0) := by
    exact (IsScalarTower.algebraMap_smul
      (A := ℂ) (M := KaehlerDifferential AlgNum ℂ) rho
      (schanuelDefect (x 0))).symm
  have hslopeC : schanuelDefect (x 1) =
      (rho : ℂ) • schanuelDefect (x 0) := by
    rw [hslopeRaw, hscalar]
  have hC := schanuelDefect_slope_transcendental_algebraicClosure
    x hx (rho : ℂ) hslopeC
  have hinj : Function.Injective
      (algebraMap (stageTwoValueField (x 0) (x 1)) ℂ) :=
    (algebraMap (stageTwoValueField (x 0) (x 1)) ℂ).injective
  exact (transcendental_algebraMap_iff
    (R := AlgNum) (S := stageTwoValueField (x 0) (x 1))
    (A := ℂ) hinj).mp hC

/-- A degree-one stage-two value field is finite over the simple field generated by any
transcendental slope. -/
theorem finiteDimensional_stageTwoValueField_adjoin_slope
    (x : Fin 2 → ℂ)
    (htrdeg : Algebra.trdeg AlgNum (stageTwoValueField (x 0) (x 1)) = 1)
    (rho : stageTwoValueField (x 0) (x 1))
    (hrho : Transcendental AlgNum rho) :
    let E : IntermediateField AlgNum (stageTwoValueField (x 0) (x 1)) :=
      IntermediateField.adjoin AlgNum ({rho} : Set (stageTwoValueField (x 0) (x 1)))
    FiniteDimensional E (stageTwoValueField (x 0) (x 1)) := by
  classical
  let K := stageTwoValueField (x 0) (x 1)
  let E : IntermediateField AlgNum K :=
    IntermediateField.adjoin AlgNum ({rho} : Set K)
  letI : Algebra E K := E.val.toAlgebra
  letI : IsScalarTower AlgNum E K :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let basisVec : PUnit → K := fun _ ↦ rho
  have hvAI : AlgebraicIndependent AlgNum basisVec := by
    rw [algebraicIndependent_unique_type_iff]
    exact hrho
  have hvTB : IsTranscendenceBasis AlgNum basisVec :=
    AlgebraicIndependent.isTranscendenceBasis_of_trdeg_le_of_finite
      (R := AlgNum) (A := K) (ι := PUnit) hvAI (by
        rw [htrdeg, Cardinal.mk_punit])
  have hrange : Set.range basisVec = {rho} := by
    ext z
    simp [basisVec]
  have hAlgRing :
      Algebra.IsAlgebraic (Algebra.adjoin AlgNum ({rho} : Set K)) K := by
    have h := hvTB.isAlgebraic
    rw [hrange] at h
    exact h
  letI : Algebra.IsAlgebraic E K := by
    refine ⟨fun z ↦ ?_⟩
    exact GaloisForLFunctions.isAlgebraic_intermediateField_of_isAlgebraic_algebraAdjoin
      ({rho} : Set K) (hAlgRing.isAlgebraic z)
  let F : IntermediateField E K :=
    IntermediateField.adjoin E (Set.range (stageTwoGeneratorIn x))
  have hrestrict : F.restrictScalars AlgNum = ⊤ := by
    apply top_unique
    rw [← adjoin_range_stageTwoGeneratorIn_eq_top x]
    apply (IntermediateField.adjoin_le_iff).mpr
    intro z hz
    exact IntermediateField.subset_adjoin E _ hz
  have hF : F = ⊤ :=
    IntermediateField.restrictScalars_eq_top_iff.mp hrestrict
  have hfin : FiniteDimensional E F := by
    exact IntermediateField.finiteDimensional_adjoin
      (fun z _ ↦ (Algebra.IsAlgebraic.isAlgebraic z).isIntegral)
  letI : FiniteDimensional E F := hfin
  let e : F ≃ₐ[E] K :=
    (IntermediateField.equivOfEq hF).trans
      (IntermediateField.topEquiv (F := E) (E := K))
  exact e.toLinearEquiv.finiteDimensional

/-- Dependency-closed algebraic core of the stage-two defect-slope normal form. -/
structure StageTwoDefectSlopeCore (x : Fin 2 → ℂ) where
  trdeg_eq_one :
    Algebra.trdeg AlgNum (stageTwoValueField (x 0) (x 1)) = 1
  rho : stageTwoValueField (x 0) (x 1)
  slope : stageTwoDefect x 1 = rho • stageTwoDefect x 0
  slope_unique : ∀ sigma : stageTwoValueField (x 0) (x 1),
    stageTwoDefect x 1 = sigma • stageTwoDefect x 0 → sigma = rho
  rho_transcendental : Transcendental AlgNum rho
  finite_over_slope :
    let E : IntermediateField AlgNum (stageTwoValueField (x 0) (x 1)) :=
      IntermediateField.adjoin AlgNum
        ({rho} : Set (stageTwoValueField (x 0) (x 1)))
    FiniteDimensional E (stageTwoValueField (x 0) (x 1))

/-- Clauses 1–3 of the stage-two normal form: the concrete value field is a curve, its two
defects have a unique slope in that field, the slope is transcendental over the algebraic numbers,
and the value field is finite over the field generated by the slope. -/
theorem exists_stageTwoDefectSlopeCore
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hlt : Algebra.trdeg AlgNum (stageTwoValueField (x 0) (x 1)) < 2) :
    Nonempty (StageTwoDefectSlopeCore x) := by
  have htrdeg := trdeg_stageTwoValueField_eq_one_of_linearIndependent hx hlt
  let U := existsUnique_stageTwoDefectSlope x hx hlt
  let rho := U.choose
  have hslope := U.choose_spec.1
  have hunique := U.choose_spec.2
  have hrho := stageTwoDefectSlope_transcendental x hx rho hslope
  have hfinite := finiteDimensional_stageTwoValueField_adjoin_slope
    x htrdeg rho hrho
  exact ⟨{
    trdeg_eq_one := htrdeg
    rho := rho
    slope := hslope
    slope_unique := hunique
    rho_transcendental := hrho
    finite_over_slope := hfinite
  }⟩

/-- A literal stage-two extraction failure supplies the low-transcendence hypothesis and therefore
the complete algebraic defect-slope core. -/
theorem exists_stageTwoDefectSlopeCore_of_extraction_failure
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hfail : ¬ SchanuelExtractionFor x) :
    Nonempty (StageTwoDefectSlopeCore x) :=
  exists_stageTwoDefectSlopeCore x hx
    ((not_schanuelExtractionFor_two_iff_stageTwoValueField_trdeg_lt x).mp hfail)

end

end GaloisForLFunctions.RHTower
