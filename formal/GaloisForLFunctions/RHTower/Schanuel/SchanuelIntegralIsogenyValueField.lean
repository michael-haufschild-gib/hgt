noncomputable section

/-- A nonsingular integral change of two additive coordinates preserves rational linear
independence. -/
theorem linearIndependent_integral_isogeny_fin_two
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (a b c d : ℤ) (hdet : a * d - b * c ≠ 0) :
    LinearIndependent ℚ (fun i : Fin 2 ↦
      if i = 0 then (a : ℂ) * x 0 + (b : ℂ) * x 1
      else (c : ℂ) * x 0 + (d : ℂ) * x 1) := by
  let z : Fin 2 → ℂ := fun i ↦
    if i = 0 then (a : ℂ) * x 0 + (b : ℂ) * x 1
    else (c : ℂ) * x 0 + (d : ℂ) * x 1
  change LinearIndependent ℚ z
  rw [Fintype.linearIndependent_iff]
  intro q hq i
  let p : Fin 2 → ℚ := ![
    q 0 * (a : ℚ) + q 1 * (c : ℚ),
    q 0 * (b : ℚ) + q 1 * (d : ℚ)]
  have hp : ∑ j, p j • x j = 0 := by
    rw [Fin.sum_univ_two] at hq ⊢
    simp only [z, p, Matrix.cons_val_zero, Matrix.cons_val_one, if_pos,
      Rat.smul_def] at hq ⊢
    push_cast at hq ⊢
    linear_combination hq
  have hp0 := Fintype.linearIndependent_iff.mp hx p hp 0
  have hp1 := Fintype.linearIndependent_iff.mp hx p hp 1
  simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one] at hp0 hp1
  have hdetQ : ((a * d - b * c : ℤ) : ℚ) ≠ 0 := by
    exact_mod_cast hdet
  fin_cases i
  · have hq0 : ((a * d - b * c : ℤ) : ℚ) * q 0 = 0 := by
      push_cast
      linear_combination (d : ℚ) * hp0 - (c : ℚ) * hp1
    exact (mul_eq_zero.mp hq0).resolve_left hdetQ
  · have hq1 : ((a * d - b * c : ℤ) : ℚ) * q 1 = 0 := by
      push_cast
      linear_combination -(b : ℚ) * hp0 + (a : ℚ) * hp1
    exact (mul_eq_zero.mp hq1).resolve_left hdetQ

/-- The field generated by a nonsingular integral transform of a two-coordinate exponential tuple
has finite degree in the field generated by the original tuple. -/
theorem finiteDimensional_integral_isogeny_valueField
    (K : IntermediateField (algebraicClosure ℚ ℂ) ℂ)
    (x y : Fin 2 → K)
    (hy0 : ∀ i, y i ≠ 0)
    (hgen : IntermediateField.adjoin (algebraicClosure ℚ ℂ)
      (Set.range x ∪ Set.range y) = ⊤)
    (a b c d : ℤ) (hdet : a * d - b * c ≠ 0) :
    let z : Fin 2 → K := fun i ↦
      if i = 0 then (a : K) * x 0 + (b : K) * x 1
      else (c : K) * x 0 + (d : K) * x 1
    let w : Fin 2 → K := fun i ↦
      if i = 0 then y 0 ^ a * y 1 ^ b
      else y 0 ^ c * y 1 ^ d
    let B : IntermediateField (algebraicClosure ℚ ℂ) K :=
      IntermediateField.adjoin (algebraicClosure ℚ ℂ)
        (Set.range z ∪ Set.range w)
    FiniteDimensional B K := by
  classical
  let A := algebraicClosure ℚ ℂ
  let z : Fin 2 → K := fun i ↦
    if i = 0 then (a : K) * x 0 + (b : K) * x 1
    else (c : K) * x 0 + (d : K) * x 1
  let w : Fin 2 → K := fun i ↦
    if i = 0 then y 0 ^ a * y 1 ^ b
    else y 0 ^ c * y 1 ^ d
  let B : IntermediateField A K :=
    IntermediateField.adjoin A (Set.range z ∪ Set.range w)
  change FiniteDimensional B K
  have hzB : ∀ i, z i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _ (Set.mem_union_left _ (Set.mem_range_self i))
  have hwB : ∀ i, w i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _ (Set.mem_union_right _ (Set.mem_range_self i))
  have hdetK : ((a * d - b * c : ℤ) : K) ≠ 0 := by
    exact_mod_cast hdet
  have hx0B : x 0 ∈ B := by
    rw [show x 0 =
        ((d : K) * z 0 - (b : K) * z 1) / ((a * d - b * c : ℤ) : K) by
      apply (eq_div_iff hdetK).2
      simp [z]
      ring]
    exact B.div_mem
      (B.sub_mem (B.mul_mem (B.intCast_mem d) (hzB 0))
        (B.mul_mem (B.intCast_mem b) (hzB 1)))
      (B.intCast_mem (a * d - b * c))
  have hx1B : x 1 ∈ B := by
    rw [show x 1 =
        (-(c : K) * z 0 + (a : K) * z 1) / ((a * d - b * c : ℤ) : K) by
      apply (eq_div_iff hdetK).2
      simp [z]
      ring]
    exact B.div_mem
      (B.add_mem (B.mul_mem (B.neg_mem (B.intCast_mem c)) (hzB 0))
        (B.mul_mem (B.intCast_mem a) (hzB 1)))
      (B.intCast_mem (a * d - b * c))
  have hw0eq : w 0 = y 0 ^ a * y 1 ^ b := by simp [w]
  have hw1eq : w 1 = y 0 ^ c * y 1 ^ d := by simp [w]
  have hy0detZ : y 0 ^ (a * d - b * c) ∈ B := by
    rw [show y 0 ^ (a * d - b * c) = w 0 ^ d * w 1 ^ (-b) by
      symm
      rw [hw0eq, hw1eq]
      rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_mul]
      calc
        y 0 ^ (a * d) * y 1 ^ (b * d) *
            (y 0 ^ (c * -b) * y 1 ^ (d * -b)) =
            (y 0 ^ (a * d) * y 0 ^ (c * -b)) *
              (y 1 ^ (b * d) * y 1 ^ (d * -b)) := by
                ring
        _ = y 0 ^ (a * d + c * -b) * y 1 ^ (b * d + d * -b) := by
                rw [zpow_add₀ (hy0 0), zpow_add₀ (hy0 1)]
        _ = y 0 ^ (a * d - b * c) := by
          rw [show b * d + d * -b = 0 by ring, zpow_zero, mul_one]
          congr 1
          ring]
    exact B.mul_mem (B.pow_mem (hwB 0) d) (B.pow_mem (hwB 1) (-b))
  have hy1detZ : y 1 ^ (a * d - b * c) ∈ B := by
    rw [show y 1 ^ (a * d - b * c) = w 0 ^ (-c) * w 1 ^ a by
      symm
      rw [hw0eq, hw1eq]
      rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul, ← zpow_mul]
      calc
        y 0 ^ (a * -c) * y 1 ^ (b * -c) *
            (y 0 ^ (c * a) * y 1 ^ (d * a)) =
            (y 0 ^ (a * -c) * y 0 ^ (c * a)) *
              (y 1 ^ (b * -c) * y 1 ^ (d * a)) := by
                ring
        _ = y 0 ^ (a * -c + c * a) * y 1 ^ (b * -c + d * a) := by
                rw [zpow_add₀ (hy0 0), zpow_add₀ (hy0 1)]
        _ = y 1 ^ (a * d - b * c) := by
          rw [show a * -c + c * a = 0 by ring, zpow_zero, one_mul]
          congr 1
          ring]
    exact B.mul_mem (B.pow_mem (hwB 0) (-c)) (B.pow_mem (hwB 1) a)
  have hynat : ∀ i, y i ^ (a * d - b * c).natAbs ∈ B := by
    intro i
    have hdetZ : y i ^ (a * d - b * c) ∈ B := by
      fin_cases i
      · exact hy0detZ
      · exact hy1detZ
    have hzz : y i ^ (((a * d - b * c).natAbs : ℕ) : ℤ) ∈ B := by
      rcases le_or_gt 0 (a * d - b * c) with hpos | hneg
      · rw [show (((a * d - b * c).natAbs : ℕ) : ℤ) = a * d - b * c by omega]
        exact hdetZ
      · rw [show (((a * d - b * c).natAbs : ℕ) : ℤ) = -(a * d - b * c) by omega,
          zpow_neg]
        exact B.inv_mem hdetZ
    rwa [zpow_natCast] at hzz
  have hyInt : ∀ t ∈ Set.range y, IsIntegral B t := by
    rintro _ ⟨i, rfl⟩
    exact GaloisForLFunctions.HTGeometry.isIntegral_of_pow_mem (F := B)
      (L := K) (n := (a * d - b * c).natAbs)
      (Int.natAbs_pos.mpr hdet)
      (c := ⟨y i ^ (a * d - b * c).natAbs, hynat i⟩) rfl
  have hgenB : IntermediateField.adjoin B (Set.range y) = ⊤ := by
    have hle : IntermediateField.adjoin A (Set.range x ∪ Set.range y) ≤
        (IntermediateField.adjoin B (Set.range y)).restrictScalars A := by
      rw [IntermediateField.adjoin_le_iff]
      rintro t (ht | ht)
      · obtain ⟨i, rfl⟩ := ht
        show x i ∈ IntermediateField.adjoin B (Set.range y)
        fin_cases i
        · exact IntermediateField.algebraMap_mem _ (⟨x 0, hx0B⟩ : B)
        · exact IntermediateField.algebraMap_mem _ (⟨x 1, hx1B⟩ : B)
      · obtain ⟨i, rfl⟩ := ht
        exact IntermediateField.subset_adjoin B _ (Set.mem_range_self i)
    rw [hgen] at hle
    have hres : (IntermediateField.adjoin B (Set.range y)).restrictScalars A = ⊤ :=
      top_le_iff.mp hle
    have htop : (⊤ : IntermediateField B K).restrictScalars A = ⊤ :=
      IntermediateField.restrictScalars_top
    exact IntermediateField.restrictScalars_injective A (hres.trans htop.symm)
  haveI : Finite (Set.range y) := Set.finite_range y
  haveI hfd0 : FiniteDimensional B (IntermediateField.adjoin B (Set.range y)) :=
    IntermediateField.finiteDimensional_adjoin hyInt
  rw [hgenB] at hfd0
  exact (IntermediateField.topEquiv.toLinearEquiv).finiteDimensional

/-- Rank-one Schanuel-defect slope descent works through any field embedded compatibly in the
complex numbers, not only a bundled intermediate field. -/
theorem schanuelDefect_slope_mem_field_of_finrank_one
    {L : Type*} [Field L]
    [Algebra (algebraicClosure ℚ ℂ) L] [Algebra L ℂ]
    [IsScalarTower (algebraicClosure ℚ ℂ) L ℂ]
    (x y : Fin 2 → L)
    (hy : ∀ i, algebraMap L ℂ (y i) = Complex.exp (algebraMap L ℂ (x i)))
    (hx : LinearIndependent ℚ (fun i ↦ algebraMap L ℂ (x i)))
    (hfinrank : Module.finrank L
      (KaehlerDifferential (algebraicClosure ℚ ℂ) L) = 1)
    (rho : ℂ)
    (hslope : schanuelDefect (algebraMap L ℂ (x 1)) =
      rho • schanuelDefect (algebraMap L ℂ (x 0))) :
    ∃ sigma : L, algebraMap L ℂ sigma = rho := by
  let A := algebraicClosure ℚ ℂ
  let Phi := KaehlerDifferential.map A A L ℂ
  let eta : Fin 2 → KaehlerDifferential A L := fun i ↦
    (y i)⁻¹ • KaehlerDifferential.D A L (y i) -
      KaehlerDifferential.D A L (x i)
  have hPhi : ∀ i, Phi (eta i) = schanuelDefect (algebraMap L ℂ (x i)) := by
    intro i
    simp only [Phi, eta, A, schanuelDefect, map_sub, map_smul,
      KaehlerDifferential.map_D, hy]
    have hscalar :
        (y i)⁻¹ •
            KaehlerDifferential.D A ℂ (Complex.exp (algebraMap L ℂ (x i))) =
          algebraMap L ℂ ((y i)⁻¹) •
            KaehlerDifferential.D A ℂ (Complex.exp (algebraMap L ℂ (x i))) := by
      exact (IsScalarTower.algebraMap_smul
        (A := ℂ) (M := KaehlerDifferential A ℂ) ((y i)⁻¹)
        (KaehlerDifferential.D A ℂ (Complex.exp (algebraMap L ℂ (x i))))).symm
    rw [hscalar, map_inv₀, hy]
  have hepsilon0 : schanuelDefect (algebraMap L ℂ (x 0)) ≠ 0 := by
    intro hzero
    let m : Fin 2 → ℤ := fun i ↦ if i = 0 then 1 else 0
    have hm := schanuelDefect_integer_relation
      (fun i ↦ algebraMap L ℂ (x i)) hx m (by simp [m, hzero])
    have hm0 := congrFun hm 0
    norm_num [m] at hm0
  have heta0 : eta 0 ≠ 0 := by
    intro hzero
    apply hepsilon0
    rw [← hPhi 0, hzero, map_zero]
  obtain ⟨sigma, hsigma⟩ :=
    exists_smul_eq_of_finrank_eq_one hfinrank heta0 (eta 1)
  refine ⟨sigma, ?_⟩
  apply smul_left_injective ℂ hepsilon0
  have hsigmaC := congrArg Phi hsigma
  have hsigmaC' : algebraMap L ℂ sigma • schanuelDefect (algebraMap L ℂ (x 0)) =
      schanuelDefect (algebraMap L ℂ (x 1)) := by
    have hscalar :
        sigma • schanuelDefect (algebraMap L ℂ (x 0)) =
          algebraMap L ℂ sigma • schanuelDefect (algebraMap L ℂ (x 0)) := by
      exact (IsScalarTower.algebraMap_smul
        (A := ℂ) (M := KaehlerDifferential A ℂ) sigma
        (schanuelDefect (algebraMap L ℂ (x 0)))).symm
    rw [← hscalar]
    simpa only [map_smul, hPhi] using hsigmaC
  exact hsigmaC'.trans hslope

/-- A nondegenerate integral fractional-linear transform cannot make a slope descend through an
embedded field without the original slope descending through that field. -/
theorem mobius_slope_mem_field
    {L : Type*} [Field L] [Algebra L ℂ]
    (rho : ℂ) (sigma : L) (a b c d : ℤ)
    (hdet : a * d - b * c ≠ 0)
    (hmobius :
      algebraMap L ℂ sigma * ((a : ℂ) + (b : ℂ) * rho) =
        (c : ℂ) + (d : ℂ) * rho) :
    ∃ tau : L, algebraMap L ℂ tau = rho := by
  have hsolve :
      ((b : ℂ) * algebraMap L ℂ sigma - (d : ℂ)) * rho =
        (c : ℂ) - (a : ℂ) * algebraMap L ℂ sigma := by
    calc
      ((b : ℂ) * algebraMap L ℂ sigma - (d : ℂ)) * rho =
          algebraMap L ℂ sigma * ((a : ℂ) + (b : ℂ) * rho) -
            (a : ℂ) * algebraMap L ℂ sigma - (d : ℂ) * rho := by ring
      _ = ((c : ℂ) + (d : ℂ) * rho) -
            (a : ℂ) * algebraMap L ℂ sigma - (d : ℂ) * rho := by rw [hmobius]
      _ = (c : ℂ) - (a : ℂ) * algebraMap L ℂ sigma := by ring
  have hdenomC : (b : ℂ) * algebraMap L ℂ sigma - (d : ℂ) ≠ 0 := by
    intro hdenom
    have hnum : (c : ℂ) - (a : ℂ) * algebraMap L ℂ sigma = 0 := by
      rw [← hsolve, hdenom, zero_mul]
    have hd : (b : ℂ) * algebraMap L ℂ sigma = (d : ℂ) := sub_eq_zero.mp hdenom
    have hc : (c : ℂ) = (a : ℂ) * algebraMap L ℂ sigma := sub_eq_zero.mp hnum
    have hdetC : ((a * d - b * c : ℤ) : ℂ) = 0 := by
      push_cast
      rw [← hd, hc]
      ring
    apply hdet
    exact_mod_cast hdetC
  let tau : L :=
    ((c : L) - (a : L) * sigma) / ((b : L) * sigma - (d : L))
  refine ⟨tau, ?_⟩
  simp only [tau, map_div₀, map_sub, map_mul, map_intCast]
  rw [div_eq_iff hdenomC]
  simpa only [mul_comm] using hsolve.symm

/-- The original defect slope descends through every rank-one embedded field carrying a
nonsingular integral transform of the exponential pair. -/
theorem schanuelDefect_slope_mem_of_integral_isogeny_field
    {L : Type*} [Field L]
    [Algebra (algebraicClosure ℚ ℂ) L] [Algebra L ℂ]
    [IsScalarTower (algebraicClosure ℚ ℂ) L ℂ]
    (x : Fin 2 → ℂ) (z w : Fin 2 → L)
    (hw : ∀ i, algebraMap L ℂ (w i) = Complex.exp (algebraMap L ℂ (z i)))
    (hzLI : LinearIndependent ℚ (fun i ↦ algebraMap L ℂ (z i)))
    (hfinrank : Module.finrank L
      (KaehlerDifferential (algebraicClosure ℚ ℂ) L) = 1)
    (rho : ℂ)
    (hslope : schanuelDefect (x 1) = rho • schanuelDefect (x 0))
    (a b c d : ℤ) (hdet : a * d - b * c ≠ 0)
    (hz0 : algebraMap L ℂ (z 0) = (a : ℂ) * x 0 + (b : ℂ) * x 1)
    (hz1 : algebraMap L ℂ (z 1) = (c : ℂ) * x 0 + (d : ℂ) * x 1) :
    ∃ tau : L, algebraMap L ℂ tau = rho := by
  have hrow0 : schanuelDefect (algebraMap L ℂ (z 0)) =
      ((a : ℂ) + (b : ℂ) * rho) • schanuelDefect (x 0) := by
    rw [hz0, schanuelDefect_add, schanuelDefect_int_mul,
      schanuelDefect_int_mul, hslope, smul_smul]
    module
  have hrow1 : schanuelDefect (algebraMap L ℂ (z 1)) =
      ((c : ℂ) + (d : ℂ) * rho) • schanuelDefect (x 0) := by
    rw [hz1, schanuelDefect_add, schanuelDefect_int_mul,
      schanuelDefect_int_mul, hslope, smul_smul]
    module
  have hzeta0 : schanuelDefect (algebraMap L ℂ (z 0)) ≠ 0 := by
    intro hzero
    let m : Fin 2 → ℤ := fun i ↦ if i = 0 then 1 else 0
    have hm := schanuelDefect_integer_relation
      (fun i ↦ algebraMap L ℂ (z i)) hzLI m (by simp [m, hzero])
    have hm0 := congrFun hm 0
    norm_num [m] at hm0
  have hdenom : (a : ℂ) + (b : ℂ) * rho ≠ 0 := by
    intro hzero
    apply hzeta0
    rw [hrow0, hzero, zero_smul]
  let rho' : ℂ :=
    ((c : ℂ) + (d : ℂ) * rho) / ((a : ℂ) + (b : ℂ) * rho)
  have hslope' : schanuelDefect (algebraMap L ℂ (z 1)) =
      rho' • schanuelDefect (algebraMap L ℂ (z 0)) := by
    rw [hrow1, hrow0, smul_smul]
    congr 1
    exact (div_mul_cancel₀ _ hdenom).symm
  obtain ⟨sigma, hsigma⟩ :=
    schanuelDefect_slope_mem_field_of_finrank_one z w hw hzLI hfinrank rho' hslope'
  apply mobius_slope_mem_field rho sigma a b c d hdet
  rw [hsigma]
  exact div_mul_cancel₀ _ hdenom

set_option maxHeartbeats 800000 in
/-- For a generated stage-two exponential field of transcendence degree one, the canonical defect
slope belongs to the concrete value field generated by every nonsingular integral isogeny. -/
theorem schanuelDefect_slope_mem_integral_isogeny_valueField
    (K : IntermediateField (algebraicClosure ℚ ℂ) ℂ)
    (x y : Fin 2 → K)
    (hy : ∀ i, (y i : ℂ) = Complex.exp (x i : ℂ))
    (hx : LinearIndependent ℚ (fun i ↦ (x i : ℂ)))
    (hgen : IntermediateField.adjoin (algebraicClosure ℚ ℂ)
      (Set.range x ∪ Set.range y) = ⊤)
    (htrdeg : Algebra.trdeg (algebraicClosure ℚ ℂ) K = 1)
    (rho : ℂ)
    (hslope : schanuelDefect (x 1 : ℂ) = rho • schanuelDefect (x 0 : ℂ))
    (a b c d : ℤ) (hdet : a * d - b * c ≠ 0) :
    let z : Fin 2 → K := fun i ↦
      if i = 0 then (a : K) * x 0 + (b : K) * x 1
      else (c : K) * x 0 + (d : K) * x 1
    let w : Fin 2 → K := fun i ↦
      if i = 0 then y 0 ^ a * y 1 ^ b
      else y 0 ^ c * y 1 ^ d
    let B : IntermediateField (algebraicClosure ℚ ℂ) K :=
      IntermediateField.adjoin (algebraicClosure ℚ ℂ)
        (Set.range z ∪ Set.range w)
    ∃ tau : B, algebraMap B ℂ tau = rho := by
  classical
  let A := algebraicClosure ℚ ℂ
  let z : Fin 2 → K := fun i ↦
    if i = 0 then (a : K) * x 0 + (b : K) * x 1
    else (c : K) * x 0 + (d : K) * x 1
  let w : Fin 2 → K := fun i ↦
    if i = 0 then y 0 ^ a * y 1 ^ b
    else y 0 ^ c * y 1 ^ d
  let B : IntermediateField A K :=
    IntermediateField.adjoin A (Set.range z ∪ Set.range w)
  change ∃ tau : B, algebraMap B ℂ tau = rho
  have hy0 : ∀ i, y i ≠ 0 := by
    intro i hzero
    have hzeroC : (y i : ℂ) = 0 := congrArg (fun t : K ↦ (t : ℂ)) hzero
    rw [hy i] at hzeroC
    exact Complex.exp_ne_zero _ hzeroC
  letI hfd : FiniteDimensional B K := by
    simpa [z, w, B] using
      finiteDimensional_integral_isogeny_valueField K x y hy0 hgen a b c d hdet
  haveI : IsScalarTower A B K := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  letI : Algebra.IsIntegral B K := Algebra.IsIntegral.of_finite B K
  letI : Algebra.IsSeparable B K := Algebra.IsSeparable.of_integral B K
  letI omegaModule : Module B (KaehlerDifferential A B) :=
    KaehlerDifferential.module' (R := A) (S := B) (R' := B)
  have hKfin : Module.finrank K (KaehlerDifferential A K) = 1 :=
    finrank_kaehlerDifferential_eq_one_of_trdeg_eq_one htrdeg
  have hBfin : Module.finrank B (KaehlerDifferential A B) = 1 := by
    calc
      Module.finrank B (KaehlerDifferential A B) =
          Module.finrank K (KaehlerDifferential A K) :=
        (finrank_kaehlerDifferential_eq_of_isSeparable
          (A := A) (E := B) (K := K)).symm
      _ = 1 := hKfin
  have hzB : ∀ i, z i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _ (Set.mem_union_left _ (Set.mem_range_self i))
  have hwB : ∀ i, w i ∈ B := by
    intro i
    exact IntermediateField.subset_adjoin A _ (Set.mem_union_right _ (Set.mem_range_self i))
  let zB : Fin 2 → B := fun i ↦ ⟨z i, hzB i⟩
  let wB : Fin 2 → B := fun i ↦ ⟨w i, hwB i⟩
  let algAB : Algebra (algebraicClosure ℚ ℂ) B := inferInstance
  letI algBC : Algebra B ℂ := (K.val.toRingHom.comp (algebraMap B K)).toAlgebra
  haveI towerBKC : IsScalarTower B K ℂ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI towerABC : IsScalarTower (algebraicClosure ℚ ℂ) B ℂ :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hmapz : ∀ i, algebraMap B ℂ (zB i) = (z i : ℂ) := by
    intro i
    rfl
  have hmapw : ∀ i, algebraMap B ℂ (wB i) = (w i : ℂ) := by
    intro i
    rfl
  have hwexp : ∀ i, algebraMap B ℂ (wB i) =
      Complex.exp (algebraMap B ℂ (zB i)) := by
    intro i
    rw [hmapw i, hmapz i]
    fin_cases i
    · change (y 0 : ℂ) ^ a * (y 1 : ℂ) ^ b =
        Complex.exp ((a : ℂ) * (x 0 : ℂ) + (b : ℂ) * (x 1 : ℂ))
      rw [Complex.exp_add, Complex.exp_int_mul, Complex.exp_int_mul, ← hy 0, ← hy 1]
    · change (y 0 : ℂ) ^ c * (y 1 : ℂ) ^ d =
        Complex.exp ((c : ℂ) * (x 0 : ℂ) + (d : ℂ) * (x 1 : ℂ))
      rw [Complex.exp_add, Complex.exp_int_mul, Complex.exp_int_mul, ← hy 0, ← hy 1]
  have hzLI : LinearIndependent ℚ (fun i ↦ algebraMap B ℂ (zB i)) := by
    rw [show (fun i ↦ algebraMap B ℂ (zB i)) = fun i ↦
        if i = 0 then (a : ℂ) * (x 0 : ℂ) + (b : ℂ) * (x 1 : ℂ)
        else (c : ℂ) * (x 0 : ℂ) + (d : ℂ) * (x 1 : ℂ) by
      funext i
      rw [hmapz i]
      fin_cases i <;> simp [z]]
    exact linearIndependent_integral_isogeny_fin_two
      (fun i ↦ (x i : ℂ)) hx a b c d hdet
  refine @schanuelDefect_slope_mem_of_integral_isogeny_field B
    (inferInstance : Field B) algAB algBC towerABC
    (fun i ↦ (x i : ℂ)) zB wB hwexp hzLI hBfin rho hslope a b c d hdet ?_ ?_
  · rw [hmapz 0]
    simp [z]
  · rw [hmapz 1]
    simp [z]


end


