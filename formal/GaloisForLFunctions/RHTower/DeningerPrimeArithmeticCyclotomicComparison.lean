import GaloisForLFunctions.RHTower.DeningerPrimePacketFiniteCyclotomicStage
import Mathlib.FieldTheory.Galois.Profinite
import Mathlib.NumberTheory.Cyclotomic.CyclotomicCharacter
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-!
# Arithmetic cyclotomic comparison for a Deninger prime packet

This module connects the concrete packet unit group to an actual arithmetic object.  Fix a prime
`p` and an algebraic closure of `ZMod p`.  Taking the `ℓ`-adic cyclotomic character for every
`ℓ ≠ p` gives a continuous homomorphism from its absolute Galois group to
`DeningerPacketUnits p`.

The comparison acts on every `ℓ^k`-th root of unity through the reduction of its `ℓ`-adic
coordinate.  Arithmetic Frobenius maps exactly to the diagonal packet unit `p`.  Since the
absolute Galois group is compact and the packet unit group is Hausdorff, the image of the closed
cyclic Frobenius subgroup is exactly the closed cyclic subgroup used in the packet quotient.  The
character therefore descends canonically to a homomorphism between the two Frobenius quotients.

This is the denominator/closure comparison.  It does not assert the still-missing numerator
equivalence between all multiplicative-group automorphisms of the algebraic closure and the full
product of away-prime `ℓ`-adic units.
-/

namespace RHTower

open Set

noncomputable section

/-- Chosen algebraic closure of the prime field at `p`. -/
abbrev DeningerPrimeArithmeticClosure (p : Nat.Primes) :=
  AlgebraicClosure (ZMod (p : ℕ))

/-- Absolute Galois group of the chosen algebraic closure of `𝔽_p`. -/
abbrev DeningerPrimeArithmeticGalois (p : Nat.Primes) :=
  DeningerPrimeArithmeticClosure p ≃ₐ[ZMod (p : ℕ)] DeningerPrimeArithmeticClosure p

/-- Arithmetic Frobenius on the algebraic closure of `𝔽_p`. -/
noncomputable def deningerPrimeArithmeticFrobenius (p : Nat.Primes) :
    DeningerPrimeArithmeticGalois p :=
  FiniteField.frobeniusAlgEquivOfAlgebraic
    (ZMod (p : ℕ)) (DeningerPrimeArithmeticClosure p)

/-- Algebraic cyclic subgroup generated by arithmetic Frobenius. -/
noncomputable def deningerPrimeArithmeticFrobeniusCyclic (p : Nat.Primes) :
    Subgroup (DeningerPrimeArithmeticGalois p) :=
  Subgroup.zpowers (deningerPrimeArithmeticFrobenius p)

/-- Topological closure of the arithmetic Frobenius powers. -/
noncomputable def deningerPrimeArithmeticFrobeniusClosure (p : Nat.Primes) :
    Subgroup (DeningerPrimeArithmeticGalois p) :=
  (deningerPrimeArithmeticFrobeniusCyclic p).topologicalClosure

/-- Arithmetic Frobenius commutes with every field automorphism: automorphisms preserve
`p`-th powers. -/
theorem deningerPrimeArithmeticFrobenius_commute
    (p : Nat.Primes) (g : DeningerPrimeArithmeticGalois p) :
    deningerPrimeArithmeticFrobenius p * g =
      g * deningerPrimeArithmeticFrobenius p := by
  ext x
  change (g x) ^ Fintype.card (ZMod (p : ℕ)) =
    g (x ^ Fintype.card (ZMod (p : ℕ)))
  rw [map_pow]

/-- The cyclic arithmetic Frobenius subgroup is central, hence normal. -/
noncomputable instance deningerPrimeArithmeticFrobeniusCyclicNormal (p : Nat.Primes) :
    (deningerPrimeArithmeticFrobeniusCyclic p).Normal where
  conj_mem n hn g := by
    have hle : deningerPrimeArithmeticFrobeniusCyclic p ≤
        Subgroup.center (DeningerPrimeArithmeticGalois p) := by
      rw [deningerPrimeArithmeticFrobeniusCyclic, Subgroup.zpowers_le]
      exact Subgroup.mem_center_iff.mpr fun h =>
        (deningerPrimeArithmeticFrobenius_commute p h).symm
    have hncenter := Subgroup.mem_center_iff.mp (hle hn) g
    rw [hncenter]
    simp [hn]

/-- The topological Frobenius closure remains normal. -/
noncomputable instance deningerPrimeArithmeticFrobeniusClosureNormal (p : Nat.Primes) :
    (deningerPrimeArithmeticFrobeniusClosure p).Normal := by
  unfold deningerPrimeArithmeticFrobeniusClosure
  exact Subgroup.is_normal_topologicalClosure _

/-- Product of all away-prime cyclotomic characters. -/
noncomputable def deningerPrimeArithmeticCyclotomicCharacter (p : Nat.Primes) :
    DeningerPrimeArithmeticGalois p →* DeningerPacketUnits p where
  toFun g ℓ :=
    cyclotomicCharacter (DeningerPrimeArithmeticClosure p) (ℓ.1 : ℕ) g.toRingEquiv
  map_one' := by
    apply funext
    intro ℓ
    change (cyclotomicCharacter (DeningerPrimeArithmeticClosure p) (ℓ.1 : ℕ))
      (RingEquiv.refl _) = 1
    exact map_one _
  map_mul' g h := by
    apply funext
    intro ℓ
    change (cyclotomicCharacter (DeningerPrimeArithmeticClosure p) (ℓ.1 : ℕ))
      (g.toRingEquiv * h.toRingEquiv) = _
    exact map_mul _ _ _

/-- The product cyclotomic character is continuous for the Krull and product topologies. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_continuous (p : Nat.Primes) :
    Continuous (deningerPrimeArithmeticCyclotomicCharacter p) := by
  change Continuous (fun (g : DeningerPrimeArithmeticGalois p)
      (ℓ : {ℓ : Nat.Primes // (ℓ : ℕ) ≠ (p : ℕ)}) =>
    cyclotomicCharacter (DeningerPrimeArithmeticClosure p) (ℓ.1 : ℕ) g.toRingEquiv)
  exact continuous_pi fun ℓ =>
    cyclotomicCharacter.continuous (ℓ.1 : ℕ)
      (ZMod (p : ℕ)) (DeningerPrimeArithmeticClosure p)

/-- An away prime remains nonzero in the prime field of characteristic `p`. -/
theorem deningerAwayPrime_neZero_in_primeField
    (p : Nat.Primes)
    (ℓ : {ℓ : Nat.Primes // (ℓ : ℕ) ≠ (p : ℕ)}) :
    NeZero ((ℓ.1 : ℕ) : ZMod (p : ℕ)) := by
  constructor
  intro hz
  rw [ZMod.natCast_eq_zero_iff] at hz
  apply ℓ.2
  exact ((Nat.prime_dvd_prime_iff_eq p.2 ℓ.1.2).mp hz).symm

/-- Every finite cyclotomic stage sees the corresponding reduction of the product character. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_spec
    (p : Nat.Primes) (g : DeningerPrimeArithmeticGalois p)
    (ℓ : {ℓ : Nat.Primes // (ℓ : ℕ) ≠ (p : ℕ)}) (k : ℕ)
    (t : rootsOfUnity ((ℓ.1 : ℕ) ^ k) (DeningerPrimeArithmeticClosure p)) :
    g ((t : (DeningerPrimeArithmeticClosure p)ˣ) : DeningerPrimeArithmeticClosure p) =
      ((t : (DeningerPrimeArithmeticClosure p)ˣ) : DeningerPrimeArithmeticClosure p) ^
        (PadicInt.toZModPow k
          (deningerPrimeArithmeticCyclotomicCharacter p g ℓ : ℤ_[ℓ.1])).val := by
  letI : NeZero ((ℓ.1 : ℕ) : ZMod (p : ℕ)) :=
    deningerAwayPrime_neZero_in_primeField p ℓ
  exact cyclotomicCharacter.spec (ℓ.1 : ℕ) g.toRingEquiv
    (((t : (DeningerPrimeArithmeticClosure p)ˣ) : DeningerPrimeArithmeticClosure p))
    (congrArg Units.val t.2)

/-- **Arithmetic Frobenius is the diagonal packet unit.**  Equality holds in the full product,
not merely at one finite cyclotomic stage. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_frobenius
    (p : Nat.Primes) :
    deningerPrimeArithmeticCyclotomicCharacter p
        (deningerPrimeArithmeticFrobenius p) =
      deningerPacketFrobeniusUnit p := by
  apply funext
  intro ℓ
  apply Units.ext
  apply PadicInt.ext_of_toZModPow.mp
  intro k
  letI : NeZero ((ℓ.1 : ℕ) : ZMod (p : ℕ)) :=
    deningerAwayPrime_neZero_in_primeField p ℓ
  have hcard : Nat.card
      (rootsOfUnity ((ℓ.1 : ℕ) ^ k) (DeningerPrimeArithmeticClosure p)) =
        (ℓ.1 : ℕ) ^ k :=
    HasEnoughRootsOfUnity.natCard_rootsOfUnity
      (DeningerPrimeArithmeticClosure p) ((ℓ.1 : ℕ) ^ k)
  have hmod : (p : ZMod ((ℓ.1 : ℕ) ^ k)) =
      modularCyclotomicCharacter (DeningerPrimeArithmeticClosure p) hcard
        (deningerPrimeArithmeticFrobenius p).toRingEquiv := by
    apply modularCyclotomicCharacter.unique
    intro t ht
    change (deningerPrimeArithmeticFrobenius p).toRingEquiv
        (t : DeningerPrimeArithmeticClosure p) =
      (t : DeningerPrimeArithmeticClosure p) ^
        (p : ZMod ((ℓ.1 : ℕ) ^ k)).val
    have hfrob : (deningerPrimeArithmeticFrobenius p).toRingEquiv
        (t : DeningerPrimeArithmeticClosure p) =
        (t : DeningerPrimeArithmeticClosure p) ^ (p : ℕ) := by
      change (t : DeningerPrimeArithmeticClosure p) ^ Fintype.card (ZMod (p : ℕ)) = _
      rw [ZMod.card]
    rw [hfrob, ZMod.val_natCast]
    have hpow := pow_mod_natCard
      (⟨t, ht⟩ : rootsOfUnity ((ℓ.1 : ℕ) ^ k)
        (DeningerPrimeArithmeticClosure p)) (p : ℕ)
    rw [hcard] at hpow
    exact congrArg
      (fun z : rootsOfUnity ((ℓ.1 : ℕ) ^ k)
        (DeningerPrimeArithmeticClosure p) =>
          ((z : (DeningerPrimeArithmeticClosure p)ˣ) :
            DeningerPrimeArithmeticClosure p)) hpow.symm
  have hchar :
      ((cyclotomicCharacter (DeningerPrimeArithmeticClosure p) (ℓ.1 : ℕ)
        (deningerPrimeArithmeticFrobenius p).toRingEquiv).val.toZModPow k) =
        (p : ZMod ((ℓ.1 : ℕ) ^ k)) := by
    rw [cyclotomicCharacter.toZModPow]
    exact hmod.symm
  have hpacket := congrArg Units.val
    (deningerPacketFrobeniusUnit_toZModPow p ℓ k)
  exact hchar.trans (by simpa using hpacket.symm)

/-- The algebraic cyclic Frobenius subgroup maps exactly to the packet cyclic subgroup. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_map_frobeniusCyclic
    (p : Nat.Primes) :
    Subgroup.map (deningerPrimeArithmeticCyclotomicCharacter p)
        (deningerPrimeArithmeticFrobeniusCyclic p) =
      deningerPacketFrobeniusCyclic p := by
  rw [deningerPrimeArithmeticFrobeniusCyclic,
    MonoidHom.map_zpowers,
    deningerPrimeArithmeticCyclotomicCharacter_frobenius]
  rfl

/-- **Closed Frobenius denominator comparison.**  Compactness of the arithmetic Galois group
upgrades cyclic-stage equality to equality of the two topological closures. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_map_frobeniusClosure
    (p : Nat.Primes) :
    Subgroup.map (deningerPrimeArithmeticCyclotomicCharacter p)
        (deningerPrimeArithmeticFrobeniusClosure p) =
      deningerPacketFrobeniusClosure p := by
  apply SetLike.ext'
  change deningerPrimeArithmeticCyclotomicCharacter p '' closure
      (deningerPrimeArithmeticFrobeniusCyclic p :
        Set (DeningerPrimeArithmeticGalois p)) =
    closure (deningerPacketFrobeniusCyclic p : Set (DeningerPacketUnits p))
  rw [image_closure_of_isCompact isClosed_closure.isCompact
    (deningerPrimeArithmeticCyclotomicCharacter_continuous p).continuousOn]
  rw [← Subgroup.coe_map,
    deningerPrimeArithmeticCyclotomicCharacter_map_frobeniusCyclic]

/-- Arithmetic Frobenius powers are dense in the absolute Galois group of the algebraic closure of
the finite field.  Every Krull neighborhood is controlled by a finite Galois intermediate field,
whose Galois group is generated by its finite-field Frobenius. -/
theorem deningerPrimeArithmeticFrobenius_dense (p : Nat.Primes) :
    closure
        (deningerPrimeArithmeticFrobeniusCyclic p :
          Set (DeningerPrimeArithmeticGalois p)) = Set.univ := by
  apply Set.eq_univ_of_forall
  intro g
  rw [mem_closure_iff_nhds_one]
  intro U hU
  obtain ⟨L, hLU⟩ :=
    (InfiniteGalois.krullTopology_mem_nhds_one_iff_of_isGalois
      (k := ZMod (p : ℕ)) (K := DeningerPrimeArithmeticClosure p) U).mp hU
  letI : Finite L := Module.finite_of_finite (ZMod (p : ℕ))
  let r := AlgEquiv.restrictNormalHom
    (F := ZMod (p : ℕ)) (K₁ := DeningerPrimeArithmeticClosure p) L.1
  obtain ⟨n, hn⟩ :=
    (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
      (ZMod (p : ℕ)) L).surjective (r g)
  have hrf : r (deningerPrimeArithmeticFrobenius p) =
      FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod (p : ℕ)) L := by
    ext x
    calc
      ((r (deningerPrimeArithmeticFrobenius p) x : L)) =
          deningerPrimeArithmeticFrobenius p (x : _) :=
        AlgEquiv.restrictNormal_commutes _ L.1 x
      _ = (x : DeningerPrimeArithmeticClosure p) ^
          Fintype.card (ZMod (p : ℕ)) := rfl
      _ = ((FiniteField.frobeniusAlgEquivOfAlgebraic
          (ZMod (p : ℕ)) L) x : L) := rfl
  refine ⟨(deningerPrimeArithmeticFrobenius p) ^ (n : ℕ),
    Subgroup.npow_mem_zpowers _ _, hLU ?_⟩
  apply (FiniteGaloisIntermediateField.mem_fixingSubgroup_iff _ L).2
  change r ((deningerPrimeArithmeticFrobenius p) ^ (n : ℕ) / g) = 1
  rw [map_div, map_pow, hrf]
  change (FiniteField.frobeniusAlgEquivOfAlgebraic
    (ZMod (p : ℕ)) L) ^ (n : ℕ) / r g = 1
  change (FiniteField.frobeniusAlgEquivOfAlgebraic
    (ZMod (p : ℕ)) L) ^ (n : ℕ) = r g at hn
  rw [hn]
  exact div_self' (r g)

/-- The closed arithmetic Frobenius subgroup is the entire absolute Galois group. -/
theorem deningerPrimeArithmeticFrobeniusClosure_eq_top (p : Nat.Primes) :
    deningerPrimeArithmeticFrobeniusClosure p = ⊤ := by
  apply SetLike.ext'
  simpa [deningerPrimeArithmeticFrobeniusClosure] using
    deningerPrimeArithmeticFrobenius_dense p

/-- The product cyclotomic character has image exactly the closed diagonal-Frobenius subgroup of
the packet units. -/
theorem deningerPrimeArithmeticCyclotomicCharacter_range
    (p : Nat.Primes) :
    (deningerPrimeArithmeticCyclotomicCharacter p).range =
      deningerPacketFrobeniusClosure p := by
  rw [MonoidHom.range_eq_map,
    ← deningerPrimeArithmeticFrobeniusClosure_eq_top p,
    deningerPrimeArithmeticCyclotomicCharacter_map_frobeniusClosure]

/-- Arithmetic absolute-Galois quotient by the closed Frobenius subgroup. -/
abbrev DeningerPrimeArithmeticFrobeniusQuotient (p : Nat.Primes) :=
  DeningerPrimeArithmeticGalois p ⧸ deningerPrimeArithmeticFrobeniusClosure p

/-- Quotienting field automorphisms by closed Frobenius leaves a singleton.  A nontrivial
Deninger packet must therefore use all multiplicative-group automorphisms, not only field
automorphisms. -/
noncomputable instance deningerPrimeArithmeticFrobeniusQuotientSubsingleton
    (p : Nat.Primes) : Subsingleton (DeningerPrimeArithmeticFrobeniusQuotient p) := by
  rw [QuotientGroup.subsingleton_iff,
    deningerPrimeArithmeticFrobeniusClosure_eq_top]

/-- Canonical comparison from the arithmetic Frobenius quotient to the concrete packet quotient. -/
noncomputable def deningerPrimeArithmeticFrobeniusQuotientComparison
    (p : Nat.Primes) :
    DeningerPrimeArithmeticFrobeniusQuotient p →*
      DeningerPacketFrobeniusQuotient p :=
  QuotientGroup.map
    (deningerPrimeArithmeticFrobeniusClosure p)
    (deningerPacketFrobeniusClosure p)
    (deningerPrimeArithmeticCyclotomicCharacter p) (by
      intro g hg
      have hgmap : deningerPrimeArithmeticCyclotomicCharacter p g ∈
          Subgroup.map (deningerPrimeArithmeticCyclotomicCharacter p)
            (deningerPrimeArithmeticFrobeniusClosure p) := ⟨g, hg, rfl⟩
      rw [deningerPrimeArithmeticCyclotomicCharacter_map_frobeniusClosure] at hgmap
      exact hgmap)

@[simp] theorem deningerPrimeArithmeticFrobeniusQuotientComparison_mk
    (p : Nat.Primes) (g : DeningerPrimeArithmeticGalois p) :
    deningerPrimeArithmeticFrobeniusQuotientComparison p (QuotientGroup.mk g) =
      (QuotientGroup.mk (deningerPrimeArithmeticCyclotomicCharacter p g) :
        DeningerPacketFrobeniusQuotient p) := rfl

/-- Arithmetic Frobenius is trivial in its own closure quotient. -/
theorem deningerPrimeArithmeticFrobenius_eq_one (p : Nat.Primes) :
    (QuotientGroup.mk (deningerPrimeArithmeticFrobenius p) :
      DeningerPrimeArithmeticFrobeniusQuotient p) = 1 := by
  rw [QuotientGroup.eq_one_iff]
  exact Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers _)

end

end RHTower
