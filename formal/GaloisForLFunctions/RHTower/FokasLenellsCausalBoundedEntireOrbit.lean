import GaloisForLFunctions.RHTower.FokasLenellsCausalBoundedChain
import Mathlib.Analysis.SpecialFunctions.Exponential

/-! The entire exponential curve generated by the actual bounded derivative shift.
Every coordinate remains in the genuine maximal-generator graph at every complex time. -/
open Complex MeasureTheory Set Filter Topology
open scoped NNReal ENNReal
open GaloisForLFunctions.HTGeometry
open GaloisForLFunctions.HTGeometry.FokasLenells
namespace RHTower.FokasLenells
noncomputable section
set_option backward.isDefEq.respectTransparency false
local instance : CompleteSpace (hardyL2ᗮ) := hardyL2.isClosed_orthogonal.completeSpace_coe
local instance : CompleteSpace causalBoundedChain := causalBoundedChain_complete
local instance : NormedAddCommGroup causalBoundedChain := causalBoundedChain.normedAddCommGroup
local instance : NormedSpace ℂ causalBoundedChain := causalBoundedChain.normedSpace
local instance : NormedRing (causalBoundedChain →L[ℂ] causalBoundedChain) :=
  ContinuousLinearMap.toNormedRing
local instance : TopologicalSpace (causalBoundedChain →L[ℂ] causalBoundedChain) :=
  (inferInstance : NormedAddCommGroup
    (causalBoundedChain →L[ℂ] causalBoundedChain)).toUniformSpace.toTopologicalSpace
local instance : IsTopologicalRing (causalBoundedChain →L[ℂ] causalBoundedChain) :=
  NonUnitalSeminormedRing.toIsTopologicalRing

/-- The actual operator exponential of the bounded genuine derivative shift. -/
def causalBoundedChainExponential (z : ℂ) : causalBoundedChain →L[ℂ] causalBoundedChain :=
  NormedSpace.exp (z • causalBoundedChainShift)

/-- The bounded-chain exponential solves its genuine bounded generator equation in operator norm. -/
theorem causalBoundedChainExponential_hasDerivAt (z : ℂ) :
    HasDerivAt causalBoundedChainExponential
      (causalBoundedChainShift * causalBoundedChainExponential z) z :=
  hasDerivAt_exp_smul_const' causalBoundedChainShift z

/-- The operator exponential starts at the identity of the genuine bounded-chain space. -/
theorem causalBoundedChainExponential_zero : causalBoundedChainExponential 0 = 1 := by
  simp only [causalBoundedChainExponential, zero_smul, NormedSpace.exp_zero]

/-- Read one genuine derivative coordinate of the actual entire exponential curve. -/
def causalBoundedEntireOrbit (j : ℕ) (u : causalBoundedChain) (z : ℂ) : hardyL2ᗮ :=
  causalBoundedChainCoordinate j (causalBoundedChainExponential z u)

/-- Each complex derivative is exactly the next genuine generator coordinate. -/
theorem causalBoundedEntireOrbit_hasDerivAt (j : ℕ) (u : causalBoundedChain) (z : ℂ) :
    HasDerivAt (causalBoundedEntireOrbit j u) (causalBoundedEntireOrbit (j+1) u z) z := by
  have h := (causalBoundedChainExponential_hasDerivAt z).clm_apply (hasDerivAt_const z u)
  have he : HasDerivAt (fun w : ℂ => causalBoundedChainExponential w u)
      (causalBoundedChainShift (causalBoundedChainExponential z u)) z := by
    convert! h using 1
    simp only [map_zero, add_zero]
    rfl
  exact (causalBoundedChainCoordinate j).hasFDerivAt.comp_hasDerivAt z he

/-- Every coordinate curve is entire as a function with values in the original Hilbert space. -/
theorem causalBoundedEntireOrbit_analyticAt (j : ℕ) (u : causalBoundedChain) (z : ℂ) :
    AnalyticAt ℂ (causalBoundedEntireOrbit j u) z :=
  (show Differentiable ℂ (causalBoundedEntireOrbit j u) from fun w =>
    (causalBoundedEntireOrbit_hasDerivAt j u w).differentiableAt).analyticAt z

/-- The entire curve starts at the literal genuine derivative coordinate. -/
theorem causalBoundedEntireOrbit_zero (j : ℕ) (u : causalBoundedChain) :
    causalBoundedEntireOrbit j u 0 = causalBoundedChainCoordinate j u := by
  exact congrArg (fun A : causalBoundedChain →L[ℂ] causalBoundedChain =>
    causalBoundedChainCoordinate j (A u)) causalBoundedChainExponential_zero

/-- The next entire coordinate is also the actual causal right derivative, at every complex time. -/
theorem causalBoundedEntireOrbit_hasRightDeriv (j : ℕ) (u : causalBoundedChain) (z : ℂ) :
    HasDerivWithinAt (causalForwardOrbit (causalBoundedEntireOrbit j u z))
      (causalBoundedEntireOrbit (j+1) u z) (Ioi 0) 0 :=
  causalBoundedChainCoordinate_hasRightDeriv j (causalBoundedChainExponential z u)

/-- The entire derivative hierarchy restricts to the same actual real derivative. -/
theorem causalBoundedEntireOrbit_hasRealDerivAt (j : ℕ) (u : causalBoundedChain) (r : ℝ) :
    HasDerivAt (fun t : ℝ => causalBoundedEntireOrbit j u (t : ℂ))
      (causalBoundedEntireOrbit (j+1) u (r : ℂ)) r := by
  have hd := causalBoundedEntireOrbit_hasDerivAt j u (r : ℂ)
  simpa using! ((hd.hasFDerivAt.restrictScalars ℝ).comp r Complex.ofRealCLM.hasFDerivAt).hasDerivAt

/-- The entire curve, including every derivative order, belongs to the genuine maximal domain. -/
def causalBoundedEntireDomain (j : ℕ) (u : causalBoundedChain) (z : ℂ) : causalGeneratorDomain :=
  causalSmoothGraphDomainCoordinate j
    (causalBoundedChainToSmooth (causalBoundedChainExponential z u))

/-- The actual maximal generator on the entire curve gives its literal complex derivative. -/
theorem causalGenerator_boundedEntireDomain (j : ℕ) (u : causalBoundedChain) (z : ℂ) :
    causalGenerator (causalBoundedEntireDomain j u z) = causalBoundedEntireOrbit (j+1) u z :=
  causalGenerator_smoothGraphCoordinate j
    (causalBoundedChainToSmooth (causalBoundedChainExponential z u))

end
end RHTower.FokasLenells
