import GaloisForLFunctions.RHTower.DeningerQ8ActualMonomialSourceLaw
import GaloisForLFunctions.HTGeometry.DeckDegreeCriterion
import GaloisForLFunctions.HTGeometry.QuadraticSubextension

/-!
# The literal quadratic Hecke base of the Q8 source witness

The documented Q8 field is induced from an order-four Hecke character of a
quadratic subfield.  The preceding monomial theorem identifies its abstract
inducing subgroup, but an epsilon-factor calculation also needs the actual
arithmetic field on which that character lives.

This file pins that field without assuming an Artin root number.  The literal
element `√41` is moved to its negative by the reflected Q8 automorphism, so
it is not rational.  Its square is rational, hence it generates a quadratic
field.  Exactly the cyclic Q8 subgroup fixes it; Artin's degree formula then
identifies the generated field with that subgroup's fixed field.  Thus the
future Artin-to-Hecke comparison has a source-selected, coefficient-free
base field rather than an arbitrary index-two subgroup.
-/

namespace RHTower

noncomputable section

open GaloisForLFunctions
open scoped IntermediateField

local notation "K1" => deningerQ8RootNumberNegOneFirstQuadraticField
local notation "K2" => deningerQ8RootNumberNegOneSecondQuadraticField
local notation "K3" => deningerQ8RootNumberNegOneTopField

/-! The radical tower exposes more than one `ℚ`-algebra construction.  Pin the
one used by the literal Q8 Galois group so generated and fixed subfields have
the same scalar structure. -/
local instance deningerQ8ActualQuadraticSourceAlgebra : Algebra ℚ K3 := by
  infer_instance

noncomputable local instance deningerQ8ActualQuadraticSourceFiniteDimensionalK1K2 :
    FiniteDimensional K1 K2 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_secondQuadratic_irreducible.ne_zero).basis

noncomputable local instance deningerQ8ActualQuadraticSourceFiniteDimensionalK2K3 :
    FiniteDimensional K2 K3 :=
  Module.Basis.finiteDimensional_of_finite
    (AdjoinRoot.powerBasis
      deningerQ8RootNumberNegOne_thirdQuadratic_irreducible.ne_zero).basis

noncomputable local instance deningerQ8ActualQuadraticSourceFiniteDimensionalRatK2 :
    FiniteDimensional ℚ K2 :=
  FiniteDimensional.trans ℚ K1 K2

noncomputable local instance deningerQ8ActualQuadraticSourceFiniteDimensionalRatK3 :
    FiniteDimensional ℚ K3 :=
  FiniteDimensional.trans ℚ K2 K3

local instance deningerQ8ActualQuadraticSourceCharZero : CharZero K3 :=
  charZero_of_injective_algebraMap (algebraMap ℚ K3).injective

noncomputable local instance deningerQ8ActualQuadraticSourceIsGalois : IsGalois ℚ K3 :=
  deningerQ8RootNumberNegOne_isGalois

/-- The source-selected quadratic Hecke base, generated by the literal `√41`. -/
abbrev deningerQ8ActualQuadraticSourceField : IntermediateField ℚ K3 :=
  IntermediateField.adjoin ℚ {deningerQ8RootNumberNegOneTopY}

/-- The reflected Q8 orientation proves that the selected square root is not rational. -/
theorem deningerQ8ActualTopY_not_mem_bot :
    deningerQ8RootNumberNegOneTopY ∉ (⊥ : IntermediateField ℚ K3) := by
  intro hy
  obtain ⟨q, hq⟩ := IntermediateField.mem_bot.mp hy
  let j : Gal(K3/ℚ) :=
    deningerQ8RootNumberNegOne_galoisEquivQ8.symm (QuaternionGroup.xa 0)
  have hj : j deningerQ8RootNumberNegOneTopY = deningerQ8RootNumberNegOneTopY := by
    rw [← hq]
    exact j.commutes q
  change q8JAlgEquiv (q8IAlgPow (0 : ZMod 4) deningerQ8RootNumberNegOneTopY) =
    deningerQ8RootNumberNegOneTopY at hj
  rw [q8IAlgPow_topY, q8JAlgEquiv_apply, q8J_topY] at hj
  apply q8TopY_ne_zero
  have hsum : deningerQ8RootNumberNegOneTopY + deningerQ8RootNumberNegOneTopY = 0 := by
    calc
      deningerQ8RootNumberNegOneTopY + deningerQ8RootNumberNegOneTopY =
          -deningerQ8RootNumberNegOneTopY + deningerQ8RootNumberNegOneTopY := by rw [hj]
      _ = 0 := neg_add_cancel _
  have htwice : (2 : K3) * deningerQ8RootNumberNegOneTopY = 0 := by
    rw [two_mul]
    exact hsum
  exact (mul_eq_zero.mp htwice).resolve_left (by norm_num)

/-- The literal source-selected Hecke base is quadratic over `ℚ`. -/
theorem deningerQ8ActualQuadraticSourceField_finrank :
    Module.finrank ℚ deningerQ8ActualQuadraticSourceField = 2 := by
  apply GaloisForLFunctions.HTGeometry.finrank_adjoin_eq_two
  · rw [← pow_two, deningerQ8RootNumberNegOne_topY_sq]
    exact (map_natCast (algebraMap ℚ K3) 41).symm
  · exact deningerQ8ActualTopY_not_mem_bot

/-- The literal `C₄` source subgroup has four elements. -/
theorem deningerQ8ActualCyclicSubgroup_natCard :
    Nat.card deningerQ8ActualCyclicSubgroup = 4 := by
  calc
    Nat.card deningerQ8ActualCyclicSubgroup = Nat.card q8CyclicSubgroup :=
      Nat.card_congr deningerQ8ActualCyclicSubgroupEquiv.toEquiv
    _ = 4 := q8CyclicSubgroup_card

/-- The source-selected quadratic field is exactly the fixed field of the
literal cyclic inducing subgroup.  This identifies the only possible Hecke
base for the documented monomial Artin representation. -/
theorem deningerQ8ActualQuadraticSourceField_eq_fixedField_cyclicSubgroup :
    deningerQ8ActualQuadraticSourceField =
      IntermediateField.fixedField deningerQ8ActualCyclicSubgroup := by
  have hfix : deningerQ8ActualQuadraticSourceField ≤
      IntermediateField.fixedField deningerQ8ActualCyclicSubgroup := by
    rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rw [Set.mem_singleton_iff.mp hx]
    change ∀ g : deningerQ8ActualCyclicSubgroup,
      g.1 deningerQ8RootNumberNegOneTopY = deningerQ8RootNumberNegOneTopY
    intro g
    have hg : g.1 ∈ MulAction.stabilizer (Gal(K3/ℚ)) deningerQ8RootNumberNegOneTopY := by
      rw [← deningerQ8ActualCyclicSubgroup_eq_stabilizer_topY]
      exact g.2
    exact MulAction.mem_stabilizer_iff.mp hg
  have htower :
      Module.finrank ℚ deningerQ8ActualQuadraticSourceField *
          Module.finrank deningerQ8ActualQuadraticSourceField K3 = Module.finrank ℚ K3 :=
    Module.finrank_mul_finrank ℚ deningerQ8ActualQuadraticSourceField K3
  have hdeg : Module.finrank deningerQ8ActualQuadraticSourceField K3 =
      Nat.card deningerQ8ActualCyclicSubgroup := by
    rw [deningerQ8ActualQuadraticSourceField_finrank,
      deningerQ8RootNumberNegOneTopField_finrank_over_rat] at htower
    calc
      Module.finrank deningerQ8ActualQuadraticSourceField K3 = 4 := by omega
      _ = Nat.card deningerQ8ActualCyclicSubgroup := deningerQ8ActualCyclicSubgroup_natCard.symm
  exact GaloisForLFunctions.HTGeometry.eq_fixedField_of_le_of_finrank_eq _ hfix hdeg

end

end RHTower
