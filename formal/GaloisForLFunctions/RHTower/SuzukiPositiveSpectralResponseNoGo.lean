import GaloisForLFunctions.RHTower.SuzukiRelativeTiltReciprocalConcavity

/-!
# Positive spectral response does not force Suzuki's relative-tilt wall

The preceding positive-resolvent countermodel left open a materially stronger possibility:
perhaps positivity would force Suzuki's wall after one also imposed the literal exponential
source, a self-adjoint position observable, pointwise positivity, and commutation of the
resolvent with position.

This file gives a class-complete counterexample to that possibility.  On the symmetric
three-point position spectrum `{-1,0,1}`, use the positive diagonal resolvent with weights
`(1,L,1)` and the literal exponential source `(exp(-1),1,exp(1))`.  The response is pointwise
positive, reflection covariant, and generated by a positive invertible source operator commuting
with position.  Nevertheless an explicit positive central weight makes

`O * (E + alpha) - E * beta < 0`,

equivalently `1 < beta / O - alpha / E`.

Thus compact spectral support, exponential sourcing, pointwise positivity, positive
self-adjoint invertibility, parity, and even resolvent--position commutation still do not imply
Suzuki's first nonlinear Schur wall.  Any proof for the restricted-Weil response must use a
genuinely arithmetic correlation tying the central and flank spectral weights together.

No Riemann-hypothesis assumption or numerical computation occurs.
-/

namespace RHTower

noncomputable section

/-! ## Symmetric three-point spectral model -/

/-- Real vectors on the ordered position spectrum `{-1,0,1}`. -/
@[ext]
structure SuzukiThreePointVector where
  neg : ℝ
  zero : ℝ
  pos : ℝ

/-- Euclidean pairing on the three-point model. -/
def suzukiThreePointDot
    (u v : SuzukiThreePointVector) : ℝ :=
  u.neg * v.neg + u.zero * v.zero + u.pos * v.pos

/-- Multiplication by the position coordinate `x ∈ {-1,0,1}`. -/
def suzukiThreePointPosition
    (v : SuzukiThreePointVector) : SuzukiThreePointVector :=
  ⟨-v.neg, 0, v.pos⟩

/-- Reflection of the three-point position spectrum. -/
def suzukiThreePointReflection
    (v : SuzukiThreePointVector) : SuzukiThreePointVector :=
  ⟨v.pos, v.zero, v.neg⟩

/-- Positive diagonal resolvent with a free central spectral weight. -/
def suzukiThreePointResolvent
    (centralWeight : ℝ)
    (v : SuzukiThreePointVector) : SuzukiThreePointVector :=
  ⟨v.neg, centralWeight * v.zero, v.pos⟩

/-- Explicit inverse source operator of the diagonal resolvent. -/
def suzukiThreePointSourceOperator
    (centralWeight : ℝ)
    (v : SuzukiThreePointVector) : SuzukiThreePointVector :=
  ⟨v.neg, v.zero / centralWeight, v.pos⟩

/-- Literal exponential source `x ↦ exp(x)` on `{-1,0,1}`. -/
def suzukiThreePointExponentialSource : SuzukiThreePointVector :=
  ⟨Real.cosh 1 - Real.sinh 1, 1, Real.cosh 1 + Real.sinh 1⟩

/-- Reflected literal exponential source `x ↦ exp(-x)`. -/
def suzukiThreePointReflectedExponentialSource : SuzukiThreePointVector :=
  suzukiThreePointReflection suzukiThreePointExponentialSource

@[simp] theorem suzukiThreePointExponentialSource_neg :
    suzukiThreePointExponentialSource.neg = Real.exp (-1) := by
  exact Real.cosh_sub_sinh 1

@[simp] theorem suzukiThreePointExponentialSource_zero :
    suzukiThreePointExponentialSource.zero = 1 := rfl

@[simp] theorem suzukiThreePointExponentialSource_pos :
    suzukiThreePointExponentialSource.pos = Real.exp 1 := by
  exact Real.cosh_add_sinh 1

theorem suzukiThreePointPosition_selfAdjoint
    (u v : SuzukiThreePointVector) :
    suzukiThreePointDot u (suzukiThreePointPosition v) =
      suzukiThreePointDot (suzukiThreePointPosition u) v := by
  simp only [suzukiThreePointDot, suzukiThreePointPosition]
  ring

theorem suzukiThreePointResolvent_selfAdjoint
    (centralWeight : ℝ) (u v : SuzukiThreePointVector) :
    suzukiThreePointDot u (suzukiThreePointResolvent centralWeight v) =
      suzukiThreePointDot (suzukiThreePointResolvent centralWeight u) v := by
  simp only [suzukiThreePointDot, suzukiThreePointResolvent]
  ring

theorem suzukiThreePointSourceOperator_selfAdjoint
    (centralWeight : ℝ) (u v : SuzukiThreePointVector) :
    suzukiThreePointDot u (suzukiThreePointSourceOperator centralWeight v) =
      suzukiThreePointDot (suzukiThreePointSourceOperator centralWeight u) v := by
  simp only [suzukiThreePointDot, suzukiThreePointSourceOperator]
  ring

theorem suzukiThreePointResolvent_quadratic
    (centralWeight : ℝ) (v : SuzukiThreePointVector) :
    suzukiThreePointDot v (suzukiThreePointResolvent centralWeight v) =
      v.neg ^ (2 : ℕ) + centralWeight * v.zero ^ (2 : ℕ) + v.pos ^ (2 : ℕ) := by
  simp only [suzukiThreePointDot, suzukiThreePointResolvent]
  ring

theorem suzukiThreePointSourceOperator_quadratic
    (centralWeight : ℝ) (v : SuzukiThreePointVector) :
    suzukiThreePointDot v (suzukiThreePointSourceOperator centralWeight v) =
      v.neg ^ (2 : ℕ) + v.zero ^ (2 : ℕ) / centralWeight + v.pos ^ (2 : ℕ) := by
  simp only [suzukiThreePointDot, suzukiThreePointSourceOperator]
  ring

theorem suzukiThreePointResolvent_pos
    {centralWeight : ℝ} (hcentral : 0 < centralWeight)
    {v : SuzukiThreePointVector}
    (hv : v ≠ ⟨0, 0, 0⟩) :
    0 < suzukiThreePointDot v
      (suzukiThreePointResolvent centralWeight v) := by
  rw [suzukiThreePointResolvent_quadratic]
  rcases v with ⟨vneg, vzero, vpos⟩
  simp only at hv ⊢
  by_cases hneg : vneg = 0
  · by_cases hzero : vzero = 0
    · have hpos : vpos ≠ 0 := by
        intro hpos
        apply hv
        simp [hneg, hzero, hpos]
      simpa [hneg, hzero] using sq_pos_of_ne_zero hpos
    · nlinarith [sq_pos_of_ne_zero hzero]
  · nlinarith [sq_pos_of_ne_zero hneg]

theorem suzukiThreePointSourceOperator_pos
    {centralWeight : ℝ} (hcentral : 0 < centralWeight)
    {v : SuzukiThreePointVector}
    (hv : v ≠ ⟨0, 0, 0⟩) :
    0 < suzukiThreePointDot v
      (suzukiThreePointSourceOperator centralWeight v) := by
  rw [suzukiThreePointSourceOperator_quadratic]
  rcases v with ⟨vneg, vzero, vpos⟩
  simp only at hv ⊢
  by_cases hneg : vneg = 0
  · by_cases hzero : vzero = 0
    · have hpos : vpos ≠ 0 := by
        intro hpos
        apply hv
        simp [hneg, hzero, hpos]
      simpa [hneg, hzero] using sq_pos_of_ne_zero hpos
    · have hz : 0 < vzero ^ (2 : ℕ) / centralWeight :=
        div_pos (sq_pos_of_ne_zero hzero) hcentral
      nlinarith [sq_nonneg vneg, sq_nonneg vpos]
  · nlinarith [sq_pos_of_ne_zero hneg, sq_nonneg vpos,
      div_nonneg (sq_nonneg vzero) hcentral.le]

theorem suzukiThreePointResolvent_sourceOperator
    {centralWeight : ℝ} (hcentral : centralWeight ≠ 0)
    (v : SuzukiThreePointVector) :
    suzukiThreePointResolvent centralWeight
        (suzukiThreePointSourceOperator centralWeight v) = v := by
  ext <;> simp only [suzukiThreePointResolvent,
    suzukiThreePointSourceOperator]
  field_simp

theorem suzukiThreePointSourceOperator_resolvent
    {centralWeight : ℝ} (hcentral : centralWeight ≠ 0)
    (v : SuzukiThreePointVector) :
    suzukiThreePointSourceOperator centralWeight
        (suzukiThreePointResolvent centralWeight v) = v := by
  ext <;> simp [suzukiThreePointResolvent, suzukiThreePointSourceOperator,
    hcentral]

/-- The resolvent is an even spectral multiplier: it commutes with reflection. -/
theorem suzukiThreePointResolvent_commutes_reflection
    (centralWeight : ℝ) (v : SuzukiThreePointVector) :
    suzukiThreePointResolvent centralWeight
        (suzukiThreePointReflection v) =
      suzukiThreePointReflection
        (suzukiThreePointResolvent centralWeight v) := by
  rfl

/-- The resolvent is a literal position spectral multiplier: it commutes with `X`. -/
theorem suzukiThreePointResolvent_commutes_position
    (centralWeight : ℝ) (v : SuzukiThreePointVector) :
    suzukiThreePointResolvent centralWeight
        (suzukiThreePointPosition v) =
      suzukiThreePointPosition
        (suzukiThreePointResolvent centralWeight v) := by
  ext <;> simp [suzukiThreePointResolvent, suzukiThreePointPosition]

/-! ## Explicit wall-crossing central weight -/

/-- Positive denominator in the exact central-weight threshold. -/
def suzukiThreePointFlankDenominator : ℝ :=
  Real.cosh 1 - Real.sinh 1

/-- Positive flank surplus in the exact central-weight threshold. -/
def suzukiThreePointFlankSurplus : ℝ :=
  Real.sinh 1 * Real.cosh 1 - 1

theorem suzukiThreePointFlankDenominator_pos :
    0 < suzukiThreePointFlankDenominator := by
  rw [suzukiThreePointFlankDenominator, Real.cosh_sub_sinh]
  positivity

theorem suzukiThreePointFlankSurplus_pos :
    0 < suzukiThreePointFlankSurplus := by
  have htwo : (2 : ℝ) < Real.sinh 2 :=
    Real.self_lt_sinh_iff.mpr (by norm_num)
  rw [show (2 : ℝ) = 2 * 1 by norm_num, Real.sinh_two_mul] at htwo
  rw [suzukiThreePointFlankSurplus]
  nlinarith

/-- Central spectral mass chosen one unit beyond the exact wall-crossing threshold. -/
def suzukiThreePointCentralWeight : ℝ :=
  2 * Real.cosh 1 * suzukiThreePointFlankSurplus /
      suzukiThreePointFlankDenominator + 1

theorem suzukiThreePointCentralWeight_pos :
    0 < suzukiThreePointCentralWeight := by
  rw [suzukiThreePointCentralWeight]
  have hcosh : 0 < Real.cosh 1 := Real.cosh_pos 1
  have hsurplus := suzukiThreePointFlankSurplus_pos
  have hden := suzukiThreePointFlankDenominator_pos
  positivity

/-- The literal pointwise-positive exponential response of the positive spectral resolvent. -/
def suzukiThreePointResponse : SuzukiThreePointVector :=
  suzukiThreePointResolvent suzukiThreePointCentralWeight
    suzukiThreePointExponentialSource

theorem suzukiThreePointResponse_pointwise_pos :
    0 < suzukiThreePointResponse.neg ∧
      0 < suzukiThreePointResponse.zero ∧
      0 < suzukiThreePointResponse.pos := by
  simp only [suzukiThreePointResponse, suzukiThreePointResolvent,
    suzukiThreePointExponentialSource]
  refine ⟨?_, ?_, ?_⟩
  · rw [Real.cosh_sub_sinh]
    positivity
  · simpa using suzukiThreePointCentralWeight_pos
  · rw [Real.cosh_add_sinh]
    positivity

/-- The positive source operator sends the response back to the literal exponential source. -/
theorem suzukiThreePointResponse_sourceEquation :
    suzukiThreePointSourceOperator suzukiThreePointCentralWeight
        suzukiThreePointResponse =
      suzukiThreePointExponentialSource := by
  exact suzukiThreePointSourceOperator_resolvent
    suzukiThreePointCentralWeight_pos.ne'
    suzukiThreePointExponentialSource

/-! ## Parity moments and strict failure of the Schur wall -/

def suzukiThreePointEvenWeight : SuzukiThreePointVector :=
  ⟨Real.cosh 1, 1, Real.cosh 1⟩

def suzukiThreePointOddWeight : SuzukiThreePointVector :=
  ⟨-Real.sinh 1, 0, Real.sinh 1⟩

def suzukiThreePointEvenTiltWeight : SuzukiThreePointVector :=
  ⟨Real.sinh 1, 0, Real.sinh 1⟩

def suzukiThreePointOddTiltWeight : SuzukiThreePointVector :=
  ⟨-Real.cosh 1, 0, Real.cosh 1⟩

def suzukiThreePointEvenEnergy : ℝ :=
  suzukiThreePointDot suzukiThreePointResponse suzukiThreePointEvenWeight

def suzukiThreePointOddEnergy : ℝ :=
  suzukiThreePointDot suzukiThreePointResponse suzukiThreePointOddWeight

def suzukiThreePointEvenTilt : ℝ :=
  suzukiThreePointDot suzukiThreePointResponse suzukiThreePointEvenTiltWeight

def suzukiThreePointOddTilt : ℝ :=
  suzukiThreePointDot suzukiThreePointResponse suzukiThreePointOddTiltWeight

theorem suzukiThreePointEvenEnergy_eq :
    suzukiThreePointEvenEnergy =
      suzukiThreePointCentralWeight + 2 * Real.cosh 1 ^ (2 : ℕ) := by
  simp only [suzukiThreePointEvenEnergy, suzukiThreePointDot,
    suzukiThreePointResponse, suzukiThreePointResolvent,
    suzukiThreePointExponentialSource, suzukiThreePointEvenWeight]
  ring

theorem suzukiThreePointOddEnergy_eq :
    suzukiThreePointOddEnergy = 2 * Real.sinh 1 ^ (2 : ℕ) := by
  simp only [suzukiThreePointOddEnergy, suzukiThreePointDot,
    suzukiThreePointResponse, suzukiThreePointResolvent,
    suzukiThreePointExponentialSource, suzukiThreePointOddWeight]
  ring

theorem suzukiThreePointEvenTilt_eq :
    suzukiThreePointEvenTilt =
      2 * Real.sinh 1 * Real.cosh 1 := by
  simp only [suzukiThreePointEvenTilt, suzukiThreePointDot,
    suzukiThreePointResponse, suzukiThreePointResolvent,
    suzukiThreePointExponentialSource, suzukiThreePointEvenTiltWeight]
  ring

theorem suzukiThreePointOddTilt_eq :
    suzukiThreePointOddTilt =
      2 * Real.sinh 1 * Real.cosh 1 := by
  simp only [suzukiThreePointOddTilt, suzukiThreePointDot,
    suzukiThreePointResponse, suzukiThreePointResolvent,
    suzukiThreePointExponentialSource, suzukiThreePointOddTiltWeight]
  ring

theorem suzukiThreePointEvenEnergy_pos :
    0 < suzukiThreePointEvenEnergy := by
  rw [suzukiThreePointEvenEnergy_eq]
  nlinarith [suzukiThreePointCentralWeight_pos, sq_nonneg (Real.cosh 1)]

theorem suzukiThreePointOddEnergy_pos :
    0 < suzukiThreePointOddEnergy := by
  rw [suzukiThreePointOddEnergy_eq]
  have hsinh : 0 < Real.sinh 1 := Real.sinh_pos_iff.mpr (by norm_num)
  positivity

/-- Exact negative slack: the chosen central mass crosses the Suzuki wall by
`2 sinh(1) exp(-1)`. -/
theorem suzukiThreePoint_twoJetSlack_eq :
    suzukiThreePointOddEnergy *
          (suzukiThreePointEvenEnergy + suzukiThreePointEvenTilt) -
        suzukiThreePointEvenEnergy * suzukiThreePointOddTilt =
      -2 * Real.sinh 1 * suzukiThreePointFlankDenominator := by
  rw [suzukiThreePointEvenEnergy_eq, suzukiThreePointOddEnergy_eq,
    suzukiThreePointEvenTilt_eq, suzukiThreePointOddTilt_eq,
    suzukiThreePointCentralWeight]
  have hden := suzukiThreePointFlankDenominator_pos.ne'
  have hhyper := Real.cosh_sq_sub_sinh_sq 1
  field_simp [hden]
  rw [suzukiThreePointFlankDenominator,
    suzukiThreePointFlankSurplus]
  nlinarith

theorem suzukiThreePoint_twoJetSlack_neg :
    suzukiThreePointOddEnergy *
          (suzukiThreePointEvenEnergy + suzukiThreePointEvenTilt) -
        suzukiThreePointEvenEnergy * suzukiThreePointOddTilt < 0 := by
  rw [suzukiThreePoint_twoJetSlack_eq]
  have hprod :
      0 < 2 * Real.sinh 1 * suzukiThreePointFlankDenominator :=
    mul_pos
      (mul_pos (by norm_num) (Real.sinh_pos_iff.mpr (by norm_num)))
      suzukiThreePointFlankDenominator_pos
  nlinarith

/-- **Positive spectral-response no-go.**  Even a pointwise-positive response of a positive
invertible parity-preserving resolvent which commutes with position can lie strictly beyond
Suzuki's sharp relative-tilt wall. -/
theorem suzukiThreePoint_relativeTiltGap_gt_one :
    1 < suzukiRelativeTiltGap
      suzukiThreePointEvenEnergy suzukiThreePointOddEnergy
      suzukiThreePointEvenTilt suzukiThreePointOddTilt := by
  have hiff :=
    suzukiParity_twoJetSlack_nonneg_iff_relativeTiltGap_le_one
      (evenTilt := suzukiThreePointEvenTilt)
      (oddTilt := suzukiThreePointOddTilt)
      suzukiThreePointEvenEnergy_pos suzukiThreePointOddEnergy_pos
  by_contra hnot
  have hle :
      suzukiRelativeTiltGap
        suzukiThreePointEvenEnergy suzukiThreePointOddEnergy
        suzukiThreePointEvenTilt suzukiThreePointOddTilt ≤ 1 :=
    le_of_not_gt hnot
  have hnonneg := hiff.mpr hle
  linarith [suzukiThreePoint_twoJetSlack_neg]

end

end RHTower
