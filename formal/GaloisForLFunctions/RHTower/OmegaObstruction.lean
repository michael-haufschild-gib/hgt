import Mathlib.Tactic

/-!
# The T2 weld obstruction as a carrier-free 2-cocycle

This module records the first formal gate for the D4 weld route: `ω` is treated as an
obstruction class, not as a constructed carrier.  The surface is deliberately minimal:

* a candidate obstruction is a 2-cocycle for a left `G`-module `A`;
* changing local choices is a 1-cochain gauge change;
* gauge changes add 2-coboundaries;
* the resulting obstruction class lives in the quotient of 2-cocycles by 2-coboundaries.
* log-integrality is represented by requiring the cocycle to land in an action-stable
  additive subgroup of `A`.
* prime-log integrality specializes that subgroup to the lattice generated by `Real.log p`
  for prime `p`.

Later T2 gates can specialize `G` to the Galois/prime-archimedean constraint group and `A`
to a log-integral lattice.  This file does not build those carriers.
-/

noncomputable section

namespace GaloisForLFunctions
namespace RHTower

variable {G A : Type*} [Group G] [AddCommGroup A] [DistribMulAction G A]

/-- Additive group-cohomology 2-cocycle equation for a left `G`-module `A`. -/
def IsTwoCocycle (omega : G -> G -> A) : Prop :=
  forall g h k, g • omega h k + omega g (h * k) = omega (g * h) k + omega g h

/-- The additive 2-coboundary of a 1-cochain. -/
def twoCoboundary (b : G -> A) : G -> G -> A :=
  fun g h => g • b h - b (g * h) + b g

@[simp]
theorem isTwoCocycle_zero : IsTwoCocycle (0 : G -> G -> A) := by
  intro g h k
  simp

/-- 2-cocycles are closed under pointwise addition. -/
theorem IsTwoCocycle.add {omega eta : G -> G -> A}
    (homega : IsTwoCocycle omega) (heta : IsTwoCocycle eta) :
    IsTwoCocycle (omega + eta) := by
  intro g h k
  calc
    g • (omega h k + eta h k) + (omega g (h * k) + eta g (h * k))
        = (g • omega h k + omega g (h * k)) +
            (g • eta h k + eta g (h * k)) := by
          simp [smul_add]
          abel
    _ = (omega (g * h) k + omega g h) +
          (eta (g * h) k + eta g h) := by
          rw [homega g h k, heta g h k]
    _ = (omega (g * h) k + eta (g * h) k) +
          (omega g h + eta g h) := by
          abel

/-- 2-cocycles are closed under pointwise negation. -/
theorem IsTwoCocycle.neg {omega : G -> G -> A} (homega : IsTwoCocycle omega) :
    IsTwoCocycle (-omega) := by
  intro g h k
  calc
    g • (-omega h k) + -omega g (h * k)
        = -(g • omega h k + omega g (h * k)) := by
          simp
          abel
    _ = -(omega (g * h) k + omega g h) := by rw [homega g h k]
    _ = -omega (g * h) k + -omega g h := by abel

/-- Additive 2-cocycles as a subgroup of 2-cochains. -/
def twoCocycles : AddSubgroup (G -> G -> A) where
  carrier := IsTwoCocycle
  zero_mem' := isTwoCocycle_zero
  add_mem' := fun {_ _} => IsTwoCocycle.add
  neg_mem' := fun {_} => IsTwoCocycle.neg

@[simp]
theorem twoCoboundary_zero : twoCoboundary (G := G) (A := A) (0 : G -> A) = 0 := by
  ext g h
  simp [twoCoboundary]

/-- The 2-coboundary operator is additive. -/
theorem twoCoboundary_add (b c : G -> A) :
    twoCoboundary (G := G) (A := A) (b + c) = twoCoboundary b + twoCoboundary c := by
  ext g h
  simp [twoCoboundary, smul_add]
  abel

/-- The 2-coboundary operator commutes with negation. -/
theorem twoCoboundary_neg (b : G -> A) :
    twoCoboundary (G := G) (A := A) (-b) = -twoCoboundary b := by
  ext g h
  simp [twoCoboundary]
  abel

/-- Every 2-coboundary is a 2-cocycle: `d₂(d₁ b) = 0`. -/
theorem twoCoboundary_isTwoCocycle (b : G -> A) :
    IsTwoCocycle (twoCoboundary (G := G) (A := A) b) := by
  intro g h k
  dsimp [twoCoboundary]
  simp [mul_smul, smul_add, smul_sub, mul_assoc]
  abel

/-- A 2-coboundary regarded as a 2-cocycle. -/
def twoCoboundaryCocycle (b : G -> A) : twoCocycles (G := G) (A := A) :=
  ⟨twoCoboundary b, twoCoboundary_isTwoCocycle b⟩

@[simp]
theorem twoCoboundaryCocycle_zero :
    twoCoboundaryCocycle (G := G) (A := A) (0 : G -> A) = 0 := by
  ext g h
  simp [twoCoboundaryCocycle]

/-- Coboundary cocycles add according to their 1-cochains. -/
theorem twoCoboundaryCocycle_add (b c : G -> A) :
    twoCoboundaryCocycle (G := G) (A := A) (b + c) =
      twoCoboundaryCocycle b + twoCoboundaryCocycle c := by
  ext g h
  simp [twoCoboundaryCocycle, twoCoboundary, smul_add]
  abel

/-- Coboundary cocycles negate according to their 1-cochains. -/
theorem twoCoboundaryCocycle_neg (b : G -> A) :
    twoCoboundaryCocycle (G := G) (A := A) (-b) = -twoCoboundaryCocycle b := by
  ext g h
  simp [twoCoboundaryCocycle, twoCoboundary]
  abel

/-- 2-coboundaries form a subgroup of 2-cocycles: gauge changes of local sections. -/
def twoCoboundaries : AddSubgroup (twoCocycles (G := G) (A := A)) where
  carrier := fun omega => exists b : G -> A, omega = twoCoboundaryCocycle b
  zero_mem' := ⟨0, (twoCoboundaryCocycle_zero (G := G) (A := A)).symm⟩
  add_mem' := by
    rintro _ _ ⟨b, rfl⟩ ⟨c, rfl⟩
    exact ⟨b + c, (twoCoboundaryCocycle_add b c).symm⟩
  neg_mem' := by
    rintro _ ⟨b, rfl⟩
    exact ⟨-b, (twoCoboundaryCocycle_neg b).symm⟩

/-- Carrier-free second constraint cohomology skeleton: 2-cocycles modulo gauge. -/
abbrev secondConstraintCohomology : Type _ :=
  twoCocycles (G := G) (A := A) ⧸ twoCoboundaries (G := G) (A := A)

/-- The obstruction class of a closed 2-cochain. -/
def obstructionClass (omega : twoCocycles (G := G) (A := A)) :
    secondConstraintCohomology (G := G) (A := A) :=
  QuotientAddGroup.mk omega

@[simp]
theorem obstructionClass_mk (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega =
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) := rfl

/-- A cocycle class vanishes exactly when the cocycle is a 2-coboundary. -/
theorem obstructionClass_eq_zero_iff (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega = 0 <-> omega ∈ twoCoboundaries (G := G) (A := A) := by
  exact QuotientAddGroup.eq_zero_iff omega

/--
Expanded zero-class criterion: the obstruction class vanishes exactly when the cocycle has
a 1-cochain primitive.
-/
theorem obstructionClass_eq_zero_iff_exists_cochain
    (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega = 0 <-> exists b : G -> A, omega = twoCoboundaryCocycle b := by
  exact obstructionClass_eq_zero_iff omega

/-- Nontriviality criterion for the obstruction class. -/
theorem obstructionClass_ne_zero_iff_not_exists_cochain
    (omega : twoCocycles (G := G) (A := A)) :
    obstructionClass omega ≠ 0 <-> ¬ exists b : G -> A, omega = twoCoboundaryCocycle b := by
  constructor
  · intro hne hprimitive
    exact hne ((obstructionClass_eq_zero_iff_exists_cochain omega).mpr hprimitive)
  · intro hnot hzero
    exact hnot ((obstructionClass_eq_zero_iff_exists_cochain omega).mp hzero)

/-- Package a raw closed 2-cochain as a cocycle. -/
def cocycleOf (omega : G -> G -> A) (homega : IsTwoCocycle omega) :
    twoCocycles (G := G) (A := A) :=
  ⟨omega, homega⟩

/-- The obstruction class attached to a raw closed 2-cochain. -/
def obstructionClassOf (omega : G -> G -> A) (homega : IsTwoCocycle omega) :
    secondConstraintCohomology (G := G) (A := A) :=
  obstructionClass (cocycleOf omega homega)

/--
Raw closed-cochain zero criterion: the obstruction dies exactly when the formula is a
2-coboundary.
-/
theorem obstructionClassOf_eq_zero_iff_exists_cochain {omega : G -> G -> A}
    (homega : IsTwoCocycle omega) :
    obstructionClassOf omega homega = 0 <-> exists b : G -> A, omega = twoCoboundary b := by
  constructor
  · intro hzero
    rcases (obstructionClass_eq_zero_iff_exists_cochain (cocycleOf omega homega)).mp hzero with
      ⟨b, hb⟩
    exact ⟨b, congrArg Subtype.val hb⟩
  · rintro ⟨b, hb⟩
    exact (obstructionClass_eq_zero_iff_exists_cochain (cocycleOf omega homega)).mpr
      ⟨b, Subtype.ext hb⟩

/-- Raw closed-cochain nontriviality criterion. -/
theorem obstructionClassOf_ne_zero_iff_not_exists_cochain {omega : G -> G -> A}
    (homega : IsTwoCocycle omega) :
    obstructionClassOf omega homega ≠ 0 <-> ¬ exists b : G -> A, omega = twoCoboundary b := by
  constructor
  · intro hne hprimitive
    exact hne ((obstructionClassOf_eq_zero_iff_exists_cochain homega).mpr hprimitive)
  · intro hnot hzero
    exact hnot ((obstructionClassOf_eq_zero_iff_exists_cochain homega).mp hzero)

/-- Gauge update of a 2-cochain by a 1-cochain. -/
def gaugeUpdate (omega : G -> G -> A) (b : G -> A) : G -> G -> A :=
  omega + twoCoboundary b

/-- Gauge-updating a 2-cocycle by any 1-cochain leaves it a 2-cocycle. -/
theorem gaugeUpdate_isTwoCocycle {omega : G -> G -> A} (homega : IsTwoCocycle omega)
    (b : G -> A) : IsTwoCocycle (gaugeUpdate omega b) := by
  exact homega.add (twoCoboundary_isTwoCocycle b)

/-- Gauge update internal to the subgroup of 2-cocycles. -/
def gaugeUpdateCocycle (omega : twoCocycles (G := G) (A := A)) (b : G -> A) :
    twoCocycles (G := G) (A := A) :=
  omega + twoCoboundaryCocycle b

/--
The obstruction class is gauge-invariant: changing local section data by a 1-cochain
does not change the class in 2-cocycles modulo 2-coboundaries.
-/
theorem gaugeUpdateCocycle_same_class (omega : twoCocycles (G := G) (A := A))
    (b : G -> A) :
    QuotientAddGroup.mk (gaugeUpdateCocycle omega b) =
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) := by
  rw [QuotientAddGroup.eq]
  change -(gaugeUpdateCocycle omega b) + omega ∈ twoCoboundaries (G := G) (A := A)
  refine ⟨-b, ?_⟩
  ext g h
  simp [gaugeUpdateCocycle, twoCoboundaryCocycle, twoCoboundary]
  abel

/-- An additive subgroup is stable under the left `G`-action. -/
def IsActionStable (G : Type*) [Group G] [DistribMulAction G A]
    (Lambda : AddSubgroup A) : Prop :=
  forall (g : G) {x : A}, x ∈ Lambda -> g • x ∈ Lambda

/-- A 2-cochain is valued in the coefficient lattice/subgroup `Lambda`. -/
def IsLatticeValued (Lambda : AddSubgroup A) (omega : G -> G -> A) : Prop :=
  forall g h, omega g h ∈ Lambda

omit [Group G] [DistribMulAction G A] in
@[simp]
theorem isLatticeValued_zero (Lambda : AddSubgroup A) :
    IsLatticeValued (G := G) Lambda (0 : G -> G -> A) := by
  intro g h
  simp

omit [Group G] [DistribMulAction G A] in
/-- Lattice-valued cochains are closed under pointwise addition. -/
theorem IsLatticeValued.add {Lambda : AddSubgroup A} {omega eta : G -> G -> A}
    (homega : IsLatticeValued Lambda omega) (heta : IsLatticeValued Lambda eta) :
    IsLatticeValued Lambda (omega + eta) := by
  intro g h
  exact Lambda.add_mem (homega g h) (heta g h)

omit [Group G] [DistribMulAction G A] in
/-- Lattice-valued cochains are closed under pointwise negation. -/
theorem IsLatticeValued.neg {Lambda : AddSubgroup A} {omega : G -> G -> A}
    (homega : IsLatticeValued Lambda omega) : IsLatticeValued Lambda (-omega) := by
  intro g h
  exact Lambda.neg_mem (homega g h)

/-- 2-cocycles whose values land in the coefficient lattice/subgroup. -/
def latticeTwoCocycles (Lambda : AddSubgroup A) :
    AddSubgroup (twoCocycles (G := G) (A := A)) where
  carrier := fun omega => IsLatticeValued Lambda (omega : G -> G -> A)
  zero_mem' := isLatticeValued_zero Lambda
  add_mem' := fun {_ _} => IsLatticeValued.add
  neg_mem' := fun {_} => IsLatticeValued.neg

/-- Cohomology classes that admit a lattice-valued cocycle representative. -/
def IsLatticeClass (Lambda : AddSubgroup A)
    (cls : secondConstraintCohomology (G := G) (A := A)) : Prop :=
  exists omega : twoCocycles (G := G) (A := A),
    IsLatticeValued Lambda (omega : G -> G -> A) ∧ QuotientAddGroup.mk omega = cls

/-- A lattice-valued cocycle represents a lattice-valued obstruction class. -/
theorem isLatticeClass_mk {Lambda : AddSubgroup A}
    {omega : twoCocycles (G := G) (A := A)}
    (homega : IsLatticeValued Lambda (omega : G -> G -> A)) :
    IsLatticeClass Lambda
      (QuotientAddGroup.mk omega : secondConstraintCohomology (G := G) (A := A)) :=
  ⟨omega, homega, rfl⟩

/-- The 2-coboundary of a lattice-valued 1-cochain is lattice-valued. -/
theorem twoCoboundary_isLatticeValued {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) {b : G -> A}
    (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (twoCoboundary (G := G) (A := A) b) := by
  intro g h
  exact Lambda.add_mem (Lambda.sub_mem (hstable g (hb h)) (hb (g * h))) (hb g)

/-- Gauge-updating by a lattice-valued 1-cochain preserves lattice-valuedness. -/
theorem gaugeUpdate_isLatticeValued {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) {omega : G -> G -> A} {b : G -> A}
    (homega : IsLatticeValued Lambda omega) (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdate omega b) := by
  exact homega.add (twoCoboundary_isLatticeValued hstable hb)

/--
Log-integrality is a gauge-invariant gate under lattice-valued section changes:
after adding a lattice 2-coboundary, being valued in `Lambda` is equivalent to the
original cocycle being valued in `Lambda`.
-/
theorem gaugeUpdate_isLatticeValued_iff {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) (omega : G -> G -> A) {b : G -> A}
    (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdate omega b) <-> IsLatticeValued Lambda omega := by
  constructor
  · intro h g k
    have hboundary : twoCoboundary (G := G) (A := A) b g k ∈ Lambda :=
      twoCoboundary_isLatticeValued hstable hb g k
    have hsub : gaugeUpdate omega b g k - twoCoboundary b g k ∈ Lambda :=
      Lambda.sub_mem (h g k) hboundary
    simpa [gaugeUpdate] using hsub
  · intro homega
    exact gaugeUpdate_isLatticeValued hstable homega hb

/-- Subgroup-level form of lattice-gauge invariance for obstruction cocycles. -/
theorem gaugeUpdateCocycle_isLatticeValued_iff {Lambda : AddSubgroup A}
    (hstable : IsActionStable G Lambda) (omega : twoCocycles (G := G) (A := A))
    {b : G -> A} (hb : forall g, b g ∈ Lambda) :
    IsLatticeValued Lambda (gaugeUpdateCocycle omega b : G -> G -> A) <->
      IsLatticeValued Lambda (omega : G -> G -> A) := by
  simpa [gaugeUpdateCocycle, gaugeUpdate, twoCoboundaryCocycle] using
    (gaugeUpdate_isLatticeValued_iff (G := G) (A := A) hstable (omega : G -> G -> A) hb)

/-- The generating set `{log p | p prime}` for the prime-log lattice. -/
def primeLogSet : Set ℝ := {x | exists p : ℕ, p.Prime ∧ x = Real.log p}

/-- The additive subgroup generated by prime logarithms. -/
def primeLogLattice : AddSubgroup ℝ := AddSubgroup.closure primeLogSet

/-- Each prime logarithm lies in the prime-log lattice. -/
theorem primeLog_mem_primeLogLattice {p : ℕ} (hp : p.Prime) :
    Real.log p ∈ primeLogLattice := by
  exact AddSubgroup.subset_closure ⟨p, hp, rfl⟩

/-- A real number has a finite integer expansion in prime logarithms. -/
def PrimeLogExpansion (x : ℝ) : Prop :=
  exists coeff : ℕ →₀ ℤ,
    (forall p : ℕ, coeff p ≠ 0 -> p.Prime) ∧
      x = coeff.sum (fun p n => n • Real.log p)

/-- A finite integer prime-log expansion lands in the prime-log lattice. -/
theorem PrimeLogExpansion.mem_primeLogLattice {x : ℝ} (hx : PrimeLogExpansion x) :
    x ∈ primeLogLattice := by
  rcases hx with ⟨coeff, hprime, rfl⟩
  rw [Finsupp.sum]
  exact AddSubgroup.sum_mem primeLogLattice fun p hp =>
    primeLogLattice.zsmul_mem
      (primeLog_mem_primeLogLattice (hprime p (Finsupp.mem_support_iff.mp hp))) (coeff p)

variable {Greal : Type*}

/-- The T2 log-integrality predicate specialized to the prime-log lattice. -/
def IsPrimeLogIntegral (omega : Greal -> Greal -> ℝ) : Prop :=
  IsLatticeValued primeLogLattice omega

/-- A concrete finite prime-log formula for every value of a 2-cochain. -/
structure PrimeLogCochainFormula (omega : Greal -> Greal -> ℝ) where
  coeff : Greal -> Greal -> ℕ →₀ ℤ
  prime_support : forall g h p, coeff g h p ≠ 0 -> p.Prime
  eval_eq : forall g h, omega g h = (coeff g h).sum (fun p n => n • Real.log p)

/-- A cochain with a prime-log formula is prime-log integral. -/
theorem PrimeLogCochainFormula.isPrimeLogIntegral {omega : Greal -> Greal -> ℝ}
    (formula : PrimeLogCochainFormula omega) : IsPrimeLogIntegral omega := by
  intro g h
  exact PrimeLogExpansion.mem_primeLogLattice
    ⟨formula.coeff g h, formula.prime_support g h, formula.eval_eq g h⟩

variable [Group Greal] [DistribMulAction Greal ℝ]

/-- Gauge invariance of the prime-log integrality gate. -/
theorem gaugeUpdate_isPrimeLogIntegral_iff
    (hstable : IsActionStable Greal primeLogLattice) (omega : Greal -> Greal -> ℝ)
    {b : Greal -> ℝ} (hb : forall g, b g ∈ primeLogLattice) :
    IsPrimeLogIntegral (gaugeUpdate omega b) <-> IsPrimeLogIntegral omega := by
  exact gaugeUpdate_isLatticeValued_iff hstable omega hb

end RHTower
end GaloisForLFunctions
