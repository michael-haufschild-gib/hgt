import GaloisForLFunctions.RHTower.RouteRPreDivisorRationalCartierSourceFunctor

/-!
# Cyclic-coinvariant rational Cartier source functor

The pre-divisor rational Cartier potential is not merely invariant on representatives.  It
descends through the genuine degree-one cyclic coinvariant quotient of the rational-adelic source.
The retained ordinary-prime atom stays nonzero in that quotient, and the descended potential is
the unique source coefficient seen by the quotient projection.

After Xi specialization, failure of this descended unit-character potential to intertwine the
fixed physical prime character is still exactly the cofinal central Bockstein readout.  Thus cyclic
descent is unconditional and coefficient-faithful, but does not silently assume the RH-equivalent
physical comparison.
-/

open Polynomial Complex

namespace RHTower

noncomputable section

/-- Genuine cyclic boundary operator `tau - 1` on the degree-one rational-adelic source. -/
def ccmRationalAdelicDegreeOneCyclicDifference :
    CCMRationalAdelicDegreeOneCyclicSource →ₗ[ℂ]
      CCMRationalAdelicDegreeOneCyclicSource :=
  ccmRationalAdelicDegreeOneCyclicRotation - LinearMap.id

/-- Submodule generated by genuine cyclic differences. -/
def ccmRationalAdelicDegreeOneCyclicBoundary :
    Submodule ℂ CCMRationalAdelicDegreeOneCyclicSource :=
  LinearMap.range ccmRationalAdelicDegreeOneCyclicDifference

/-- Degree-one cyclic coinvariants of the literal rational-adelic source. -/
abbrev CCMRationalAdelicDegreeOneCyclicCoinvariants :=
  CCMRationalAdelicDegreeOneCyclicSource ⧸
    ccmRationalAdelicDegreeOneCyclicBoundary

/-- Canonical projection to genuine cyclic coinvariants. -/
def ccmRationalAdelicDegreeOneCyclicCoinvariantClass :
    CCMRationalAdelicDegreeOneCyclicSource →ₗ[ℂ]
      CCMRationalAdelicDegreeOneCyclicCoinvariants :=
  ccmRationalAdelicDegreeOneCyclicBoundary.mkQ

/-- Cyclic rotation acts trivially after passage to coinvariants. -/
@[simp]
theorem ccmRationalAdelicDegreeOneCyclicCoinvariantClass_rotate
    (x : CCMRationalAdelicDegreeOneCyclicSource) :
    ccmRationalAdelicDegreeOneCyclicCoinvariantClass
        (ccmRationalAdelicDegreeOneCyclicRotation x) =
      ccmRationalAdelicDegreeOneCyclicCoinvariantClass x := by
  apply (Submodule.Quotient.eq _).2
  change
    ccmRationalAdelicDegreeOneCyclicRotation x - x ∈
      ccmRationalAdelicDegreeOneCyclicBoundary
  exact ⟨x, by
    simp [ccmRationalAdelicDegreeOneCyclicDifference]⟩

/-- Every pre-divisor Cartier coefficient kills genuine cyclic boundaries. -/
theorem ccmRationalAdelicDegreeOneCyclicBoundary_le_ker_cartierCoefficient
    (k : ℕ) (w : ℂ) :
    ccmRationalAdelicDegreeOneCyclicBoundary ≤
      LinearMap.ker (ccmRationalAdelicPreDivisorCartierCoefficient k w) := by
  rintro _ ⟨x, rfl⟩
  apply LinearMap.mem_ker.mpr
  rw [ccmRationalAdelicDegreeOneCyclicDifference, LinearMap.sub_apply,
    LinearMap.id_apply, map_sub,
    ccmRationalAdelicPreDivisorCartierCoefficient_rotate, sub_self]

/-- Pre-divisor Cartier coefficient descended functorially through genuine cyclic coinvariants. -/
def ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient
    (k : ℕ) (w : ℂ) :
    CCMRationalAdelicDegreeOneCyclicCoinvariants →ₗ[ℂ] ℂ :=
  ccmRationalAdelicDegreeOneCyclicBoundary.liftQ
    (ccmRationalAdelicPreDivisorCartierCoefficient k w)
    (ccmRationalAdelicDegreeOneCyclicBoundary_le_ker_cartierCoefficient k w)

/-- The descended coefficient recovers the source coefficient on every representative. -/
@[simp]
theorem ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_mk
    (k : ℕ) (w : ℂ) (x : CCMRationalAdelicDegreeOneCyclicSource) :
    ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient k w
        (ccmRationalAdelicDegreeOneCyclicCoinvariantClass x) =
      ccmRationalAdelicPreDivisorCartierCoefficient k w x := by
  exact Submodule.liftQ_apply _ _ _

/-- Exact factorization of the source coefficient through cyclic coinvariants. -/
theorem ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_comp_class
    (k : ℕ) (w : ℂ) :
    (ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient k w).comp
        ccmRationalAdelicDegreeOneCyclicCoinvariantClass =
      ccmRationalAdelicPreDivisorCartierCoefficient k w := by
  rfl

/-- Canonical constant rational Cartier presentation on a cyclic coinvariant class. -/
def ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation
    (q : ℂ) (k : ℕ) (w : ℂ)
    (x : CCMRationalAdelicDegreeOneCyclicCoinvariants) :
    RationalCartierDilationPresentation q 1
      (ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient k w x) where
  numerator := C (ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient k w x)
  denominator := 1
  denominator_ne_zero := one_ne_zero
  regularAtOne := by simp
  coefficientFaithful := by simp
  primeDilation := by simp

/-- The coinvariant presentation agrees exactly with the representative-level source functor. -/
theorem ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation_mk
    (q : ℂ) (k : ℕ) (w : ℂ)
    (x : CCMRationalAdelicDegreeOneCyclicSource) :
    (ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation q k w
      (ccmRationalAdelicDegreeOneCyclicCoinvariantClass x)).toRatFunc =
        (ccmRationalAdelicPreDivisorRationalCartierPresentation q k w x).toRatFunc := by
  rw [ccmRationalAdelicPreDivisorRationalCartierPresentation_toRatFunc]
  simp [ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation,
    RationalCartierDilationPresentation.toRatFunc,
    ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_mk]

/-- Retained ordinary-prime class in genuine cyclic coinvariants. -/
def ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass
    (p : Nat.Primes) : CCMRationalAdelicDegreeOneCyclicCoinvariants :=
  ccmRationalAdelicDegreeOneCyclicCoinvariantClass
    (ccmRationalAdelicOrdinaryPrimeCycleAtom p)

/-- The retained prime coinvariant evaluates to the independently chosen Xi jet. -/
@[simp]
theorem ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_primeAtom
    (p : Nat.Primes) (k : ℕ) (w : ℂ) :
    ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient k w
        (ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass p) =
      iteratedDeriv k XiC w := by
  rw [ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass,
    ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_mk,
    ccmRationalAdelicPreDivisorCartierCoefficient_primeAtom]

/-- Cyclic quotienting does not erase any retained ordinary-prime atom. -/
theorem ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass_ne_zero
    (p : Nat.Primes) :
    ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass p ≠ 0 := by
  intro hzero
  have hread := congrArg
    (ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient 0 0) hzero
  rw [ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_primeAtom,
    map_zero] at hread
  exact XiC_zero_ne (by simpa [iteratedDeriv_zero] using hread)

/-- At an actual Xi divisor, the descended rational presentation retains the nonzero first jet. -/
theorem
    ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation_primeAtom_ne_zero
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    (ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation (p : ℂ)
      (xiSupportMultiplicity rho) (xiSpectralPointSupport rho)
      (ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass p)).toRatFunc ≠ 0 := by
  rw [ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass]
  rw [ccmRationalAdelicPreDivisorCoinvariantRationalCartierPresentation_mk]
  exact
    ccmRationalAdelicPreDivisorRationalCartierPresentation_primeAtom_ne_zero p rho

/-- Physical prime-dilation defect read directly from the descended cyclic source functor. -/
def ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect
    (p : Nat.Primes) (rho : XiDivisorSupport) : ℂ :=
  let c := ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient
    (xiSupportMultiplicity rho) (xiSpectralPointSupport rho)
    (ccmRationalAdelicOrdinaryPrimeCyclicCoinvariantClass p)
  c - (deningerHalfDensityMateGain p (rho : ℂ) : ℂ) * c

/-- Cyclic descent changes no coefficient: its physical defect is the previously identified
cofinal Cartier/Bockstein defect. -/
theorem ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect_eq
    (p : Nat.Primes) (rho : XiDivisorSupport) :
    ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect p rho =
      ccmRationalAdelicPrimeXiSourceCartierPhysicalDilationDefect p rho := by
  rw [ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect,
    ccmRationalAdelicPreDivisorCoinvariantCartierCoefficient_primeAtom,
    ccmRationalAdelicPrimeXiSourceCartierPhysicalDilationDefect,
    ccmRationalAdelicPreDivisorCartierCoefficient_primeAtom_xi]
  rfl

/-- Functorial cyclic descent leaves exactly the negative cofinal central-Bockstein coordinate as
the physical naturality defect. -/
theorem
    ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect_eq_neg_cofinalReadout
    (p : Nat.Primes) (rho : XiDivisorSupport) (m : ℕ) :
    ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect p rho =
      -tateClockCofinalRelativeH1Equiv m
        (ccmMobiusThetaCofinalSourceHomologyLanding (p : ℕ)
          (xiSupportMultiplicity rho) m (rho : ℂ)
          (xiSpectralPointSupport rho)
          (ccmRationalAdelicOrdinaryPrimeCycleAtom p)) := by
  rw [ccmRationalAdelicPrimeXiCoinvariantCartierPhysicalDilationDefect_eq]
  exact
    ccmRationalAdelicPrimeXiSourceCartierPhysicalDilationDefect_eq_neg_cofinalReadout
      p rho m

end

end RHTower
