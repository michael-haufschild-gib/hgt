import GaloisForLFunctions.RHTower.RelativeShellPrivateCoefficientQuotient

/-!
# Infinite differential coefficient rank of every private shell

Full shell differential independence remains exact after adjoining the common
zeta mode and every private shell except one.  For each label `m`, the entire
jet tower

`H_m, H_m', H_m'', ...`

is algebraically independent over the deletion field.  Passing to the
canonical deletion quotient makes the jet images complex-linearly
independent.

Thus exact label detection requires not merely infinite order-zero power
rank, but infinite differential rank for every private label.  The result is
unconditional and algebraic; no analytic coefficient complex is asserted.
-/

open Set
open scoped Classical
open scoped Differential UpperEndDifferentialInstances
  UpperEndComplexTowerInstances

namespace RHTower

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

noncomputable section

/-- The full jet tower of `H_m` is algebraically independent over the field
generated by zeta and all private shells except `m`. -/
theorem relativeShellMultiplierJets_algebraicIndependent_over_complement
    (m : RelativeShellLabel) :
    AlgebraicIndependent
      (relativeShellSubsetDifferentialField
        (relativeShellLabelComplement m))
      (fun k : ℕ =>
        differentialJet k
          (relativeShellMultiplierUpperEndCarrier m.1)) := by
  let f : Unit ⊕ RelativeShellLabel → upperEndMeroField :=
    Sum.elim
      (fun _ : Unit => zetaUpperEndMero)
      (fun n : RelativeShellLabel =>
        relativeShellMultiplierUpperEndCarrier n.1)
  let j :
      (Unit ⊕ RelativeShellLabel) × ℕ →
        upperEndMeroField :=
    fun p => differentialJet p.2 (f p.1)
  let SIdx :=
    {p : (Unit ⊕ RelativeShellLabel) × ℕ //
      p.1 ≠ Sum.inr m}
  let a : SIdx → upperEndMeroField :=
    fun p => j p.1
  let b : ℕ → upperEndMeroField :=
    fun k =>
      differentialJet k
        (relativeShellMultiplierUpperEndCarrier m.1)
  let e :
      ℕ ⊕ SIdx →
        (Unit ⊕ RelativeShellLabel) × ℕ
    | Sum.inl k => (Sum.inr m, k)
    | Sum.inr p => p.1
  have he : Function.Injective e := by
    intro u v huv
    rcases u with k | p <;>
      rcases v with l | q
    · exact congrArg Sum.inl (congrArg Prod.snd huv)
    · exfalso
      exact q.2 (congrArg Prod.fst huv).symm
    · exfalso
      exact p.2 (congrArg Prod.fst huv)
    · exact congrArg Sum.inr (Subtype.ext huv)
  have hj :
      AlgebraicIndependent
        upperEndRationalCoordinateField j :=
    zetaRelativeShellMultiplierUpperEnd_differentialIndependent
  have hsum :
      AlgebraicIndependent upperEndRationalCoordinateField
        (Sum.elim b a) := by
    have hcomp := hj.comp e he
    have hfun :
        j ∘ e = Sum.elim b a := by
      funext q
      rcases q with k | p
      · rfl
      · rfl
    rwa [hfun] at hcomp
  have hoverAlg :
      AlgebraicIndependent
        (Algebra.adjoin upperEndRationalCoordinateField
          (Set.range a))
        b :=
    (AlgebraicIndependent.sumElim_iff.mp hsum).2
  let g :
      Unit ⊕ (relativeShellLabelComplement m) →
        upperEndMeroField :=
    Sum.elim
      (fun _ : Unit => zetaUpperEndMero)
      (fun n : relativeShellLabelComplement m =>
        relativeShellMultiplierUpperEndCarrier n.1.1)
  have hset :
      differentialJetSet (Set.range g) =
        Set.range a := by
    ext z
    constructor
    · rintro ⟨w, ⟨u | n, rfl⟩, k, rfl⟩
      · exact
          ⟨⟨(Sum.inl u, k), by simp⟩, rfl⟩
      · refine
          ⟨⟨(Sum.inr n.1, k), ?_⟩, rfl⟩
        intro h
        exact n.2 (Sum.inr.inj h)
    · rintro ⟨⟨⟨u | n, k⟩, hneq⟩, rfl⟩
      · refine ⟨zetaUpperEndMero, ?_, k, rfl⟩
        exact ⟨Sum.inl u, rfl⟩
      · have hnm : n ≠ m := by
          intro h
          exact hneq (congrArg Sum.inr h)
        refine
          ⟨relativeShellMultiplierUpperEndCarrier n.1,
            ?_, k, rfl⟩
        exact
          ⟨Sum.inr
            (⟨n, hnm⟩ :
              relativeShellLabelComplement m),
            rfl⟩
  change
    AlgebraicIndependent
      (differentialAdjoin upperEndRationalCoordinateField
        (Set.range g))
      b
  rw [differentialAdjoin, hset]
  exact
    IntermediateField.algebraicIndependent_adjoin_iff.mpr
      hoverAlg

/-- The `k`-th private-shell jet as an element of the full observable
differential field. -/
def relativeShellMultiplierJetObservable
    (m : RelativeShellLabel)
    (k : ℕ) :
    RelativeShellFullObservable :=
  ⟨differentialJet k
      (relativeShellMultiplierUpperEndCarrier m.1), by
    apply differentialJet_mem_differentialAdjoin
      upperEndRationalCoordinateField
    exact
      ⟨Sum.inr ⟨m, Set.mem_univ m⟩, rfl⟩⟩

@[simp]
theorem relativeShellMultiplierJetObservable_coe
    (m : RelativeShellLabel)
    (k : ℕ) :
    ((relativeShellMultiplierJetObservable m k :
        RelativeShellFullObservable) :
      upperEndMeroField) =
      differentialJet k
        (relativeShellMultiplierUpperEndCarrier m.1) :=
  rfl

/-- The full private jet tower has linearly independent image in the
canonical exact-deletion coefficient quotient. -/
theorem relativeShellLabelCoefficient_jetImages_linearIndependent
    (m : RelativeShellLabel) :
    LinearIndependent ℂ
      (fun k : ℕ =>
        relativeShellLabelCoefficientMap m
          (relativeShellMultiplierJetObservable m k)) := by
  let B :=
    relativeShellSubsetDifferentialField
      (relativeShellLabelComplement m)
  let u : ℕ → upperEndMeroField :=
    fun k =>
      differentialJet k
        (relativeShellMultiplierUpperEndCarrier m.1)
  have hAI : AlgebraicIndependent B u := by
    simpa [u] using
      relativeShellMultiplierJets_algebraicIndependent_over_complement m
  rw [linearIndependent_iff]
  intro l hl
  let z : RelativeShellFullObservable :=
    l.sum (fun k a =>
      a • relativeShellMultiplierJetObservable m k)
  have hmap :
      relativeShellLabelCoefficientMap m z =
        l.sum (fun k a =>
          a • relativeShellLabelCoefficientMap m
            (relativeShellMultiplierJetObservable m k)) := by
    simp [z, Finsupp.sum]
  have hzMap :
      relativeShellLabelCoefficientMap m z = 0 := by
    rw [hmap]
    simpa [Finsupp.linearCombination_apply] using hl
  have hzCoordinate :
      relativeShellLabelCoordinateSize m z = 0 :=
    (relativeShellLabelCoefficientMap_eq_zero_iff
      m z).1 hzMap
  have hzMem :
      (z : upperEndMeroField) ∈ B :=
    (relativeShellLabelCoordinateSize_kernel m z).1
      hzCoordinate
  let zB : B := ⟨(z : upperEndMeroField), hzMem⟩
  let P : MvPolynomial ℕ B :=
    l.sum (fun k a =>
      MvPolynomial.monomial
        (Finsupp.single k 1)
        (algebraMap ℂ B a)) -
      MvPolynomial.C zB
  have heval :
      MvPolynomial.aeval u P = 0 := by
    have hB (a : ℂ) :
        algebraMap B upperEndMeroField
            (algebraMap ℂ B a) =
          algebraMap ℂ upperEndMeroField a := by
      change
        algebraMap upperEndRationalCoordinateField
            upperEndMeroField
            (algebraMap ℂ
              upperEndRationalCoordinateField a) =
          algebraMap ℂ upperEndMeroField a
      exact
        (IsScalarTower.algebraMap_apply ℂ
          upperEndRationalCoordinateField
          upperEndMeroField a).symm
    have hFull (a : ℂ) :
        ((algebraMap ℂ RelativeShellFullObservable a :
            RelativeShellFullObservable) :
          upperEndMeroField) =
          algebraMap ℂ upperEndMeroField a := by
      change
        algebraMap upperEndRationalCoordinateField
            upperEndMeroField
            (algebraMap ℂ
              upperEndRationalCoordinateField a) =
          algebraMap ℂ upperEndMeroField a
      exact
        (IsScalarTower.algebraMap_apply ℂ
          upperEndRationalCoordinateField
          upperEndMeroField a).symm
    simp [P, zB, z, MvPolynomial.aeval_def,
      Algebra.smul_def, Finsupp.sum, u,
      relativeShellMultiplierJetObservable, hB, hFull]
  have hPzero : P = 0 := by
    apply hAI
    simpa using heval
  apply Finsupp.ext
  intro n
  have hcoeff :=
    congrArg
      (MvPolynomial.coeff
        (Finsupp.single n 1))
      hPzero
  by_cases hn : n ∈ l.support
  · have hsingle (k : ℕ) :
        Finsupp.single k 1 =
            Finsupp.single n 1 ↔
          k = n :=
      (Finsupp.single_left_injective
        (one_ne_zero : (1 : ℕ) ≠ 0)).eq_iff
    have hzero :
        (0 : ℕ →₀ ℕ) ≠
          Finsupp.single n 1 :=
      Ne.symm
        (Finsupp.single_ne_zero.mpr
          (one_ne_zero : (1 : ℕ) ≠ 0))
    simp [P, Finsupp.sum, hn, hsingle, hzero,
      MvPolynomial.coeff_sum,
      MvPolynomial.coeff_monomial,
      MvPolynomial.coeff_C] at hcoeff
    exact hcoeff
  · simpa [Finsupp.mem_support_iff] using hn

end

end RHTower
