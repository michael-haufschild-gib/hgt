import GaloisForLFunctions.RHTower.EulerPrimitiveJointDepthOffDiagonalCountertransport

/-!
# Finite clock-jet gauge closure of the joint-depth Euler source

The reflected joint-depth incidence is diagonally similar to its zero-displacement value.  This
module closes the natural finite-jet escape from that obstruction.  It defines the full finite
noncommutative expression algebra generated by the prime-depth log clock and the actual reflected
incidence, under addition, multiplication, and complex scalar multiplication.

Every such expression remains in the same diagonal gauge orbit.  Consequently its characteristic
polynomial, determinant, and every cyclic trace moment are independent of horizontal divisor
displacement.  In particular, taking one or arbitrarily many clock commutators can raise source
rank and retain off-diagonal labels, but cannot create transverse selecting content on any finite
packet.

This is a class-complete finite-source no-go, not an RH implication.  A surviving Route-R
differential must leave this clock-jet algebra: it must couple divisor provenance before the
vertex gauge, use an independent Euler--Gamma incidence, or be genuinely singular at infinite
source level.
-/

open Complex

namespace RHTower

noncomputable section

/-- Finite noncommutative source expressions generated by the log clock and reflected incidence. -/
inductive EulerPrimitiveFiniteClockJetExpr where
  | clock
  | incidence
  | add (x y : EulerPrimitiveFiniteClockJetExpr)
  | mul (x y : EulerPrimitiveFiniteClockJetExpr)
  | smul (c : ℂ) (x : EulerPrimitiveFiniteClockJetExpr)

/-- Evaluate a finite clock-jet expression on a clock/incidence matrix pair. -/
def EulerPrimitiveFiniteClockJetExpr.eval {N : ℕ}
    (D P : Matrix (Fin N) (Fin N) ℂ) :
    EulerPrimitiveFiniteClockJetExpr → Matrix (Fin N) (Fin N) ℂ
  | .clock => D
  | .incidence => P
  | .add x y => x.eval D P + y.eval D P
  | .mul x y => x.eval D P * y.eval D P
  | .smul c x => c • x.eval D P

/-- The prime-depth clock itself is fixed by every displacement vertex gauge. -/
theorem xiGammaEulerPrimitivePrimeDepthFiniteLogClock_similarity
    {N : ℕ} (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) :
    xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet =
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
        xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet *
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp only [xiGammaEulerPrimitivePrimeDepthFiniteLogClock,
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv,
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge,
      Matrix.mul_diagonal, Matrix.diagonal_apply_eq]
    have hcancel :
        Complex.exp
            (-(a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ))) *
          Complex.exp
            (a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ)) = 1 := by
      rw [← Complex.exp_add]
      have harg :
          -(a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ)) +
            a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ) = 0 := by
        ring
      rw [harg, Complex.exp_zero]
    calc
      (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ) =
          (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ) * 1 := by rw [mul_one]
      _ =
          (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ) *
            (Complex.exp
                (-(a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ))) *
              Complex.exp
                (a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ))) := by
        rw [hcancel, mul_one]
      _ = _ := by
        rw [show
          -a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ) =
            -(a * (xiGammaEulerPrimitivePrimeDepthLogClock (packet i) : ℂ)) by ring]
        ac_rfl
  · simp [xiGammaEulerPrimitivePrimeDepthFiniteLogClock,
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv,
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge, hij]

/-- **Finite clock-jet gauge closure.** Every noncommutative clock/incidence expression is
diagonally similar to its zero-displacement value. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_similarity
    {N : ℕ} (expr : EulerPrimitiveFiniteClockJetExpr)
    (eps : ℝ) (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) :
    expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps a packet) =
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
        expr.eval
          (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet := by
  induction expr with
  | clock =>
      exact xiGammaEulerPrimitivePrimeDepthFiniteLogClock_similarity a packet
  | incidence =>
      exact xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence_similarity eps a packet
  | add x y hx hy =>
      simp only [eval]
      rw [hx, hy]
      noncomm_ring
  | mul x y hx hy =>
      simp only [eval]
      rw [hx, hy]
      rw [show
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
              x.eval (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
                (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
            xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet) *
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
              y.eval (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
                (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
            xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet) =
          xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
            x.eval (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
              (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet *
              xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet) *
            y.eval (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
              (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
          xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet by noncomm_ring]
      rw [xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_mul_inv,
        Matrix.mul_one]
      noncomm_ring
  | smul c x hx =>
      simp only [eval]
      rw [hx]
      simp only [smul_mul_assoc, mul_smul_comm]

/-- One commutator with the prime-depth log clock, represented inside the expression algebra. -/
def EulerPrimitiveFiniteClockJetExpr.clockCommutator
    (x : EulerPrimitiveFiniteClockJetExpr) :
    EulerPrimitiveFiniteClockJetExpr :=
  .add (.mul .clock x) (.smul (-1) (.mul x .clock))

/-- The complete finite tower of iterated clock commutators of actual incidence. -/
def eulerPrimitiveFiniteIteratedClockCommutator :
    ℕ → EulerPrimitiveFiniteClockJetExpr
  | 0 => .incidence
  | n + 1 => (eulerPrimitiveFiniteIteratedClockCommutator n).clockCommutator

/-- Expression evaluation turns the source syntax into the literal matrix commutator. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_clockCommutator
    {N : ℕ} (x : EulerPrimitiveFiniteClockJetExpr)
    (D P : Matrix (Fin N) (Fin N) ℂ) :
    x.clockCommutator.eval D P = D * x.eval D P - x.eval D P * D := by
  rw [clockCommutator]
  simp only [eval, sub_eq_add_neg]
  rw [neg_one_smul]

/-- Characteristic polynomials of all finite clock-jet expressions are displacement-blind. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_charpoly
    {N : ℕ} (expr : EulerPrimitiveFiniteClockJetExpr)
    (eps : ℝ) (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) :
    (expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps a packet)).charpoly =
      (expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)).charpoly := by
  rw [expr.eval_similarity eps a packet]
  rw [Matrix.charpoly_mul_comm]
  rw [← Matrix.mul_assoc,
    xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_mul_inv,
    Matrix.one_mul]

/-- Determinants of all finite clock-jet expressions are displacement-blind. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_det
    {N : ℕ} (expr : EulerPrimitiveFiniteClockJetExpr)
    (eps : ℝ) (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) :
    (expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps a packet)).det =
      (expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)).det := by
  rw [expr.eval_similarity eps a packet, Matrix.det_mul, Matrix.det_mul]
  have hdet :
      (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet).det *
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet).det = 1 := by
    rw [← Matrix.det_mul,
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_inv_mul,
      Matrix.det_one]
  calc
    (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet).det *
          (expr.eval
            (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)).det *
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet).det =
      (expr.eval
          (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)).det *
        ((xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet).det *
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet).det) := by ring
    _ = _ := by rw [hdet, mul_one]

/-- Diagonal similarity persists through every power of every finite clock-jet expression. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_pow_similarity
    {N : ℕ} (expr : EulerPrimitiveFiniteClockJetExpr)
    (eps : ℝ) (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) (m : ℕ) :
    (expr.eval
        (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps a packet)) ^ m =
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
        (expr.eval
          (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m *
      xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet := by
  induction m with
  | zero =>
      simp [xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_inv_mul]
  | succ m ih =>
      rw [pow_succ, ih, expr.eval_similarity eps a packet]
      rw [show
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
              (expr.eval
                (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
                (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m *
            xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet) *
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
              expr.eval
                (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
                (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
            xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet) =
          xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
              (expr.eval
                (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
                (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m *
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet *
              xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet) *
            expr.eval
              (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
              (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet) *
          xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet by noncomm_ring]
      rw [xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_mul_inv,
        Matrix.mul_one, pow_succ]
      noncomm_ring

/-- All cyclic trace moments of all finite clock-jet expressions are displacement-blind. -/
theorem EulerPrimitiveFiniteClockJetExpr.eval_trace_pow
    {N : ℕ} (expr : EulerPrimitiveFiniteClockJetExpr)
    (eps : ℝ) (a : ℂ) (packet : Fin N → Nat.Primes × ℕ) (m : ℕ) :
    Matrix.trace
        ((expr.eval
          (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps a packet)) ^ m) =
      Matrix.trace
        ((expr.eval
          (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m) := by
  rw [expr.eval_pow_similarity eps a packet]
  calc
    Matrix.trace
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
          (expr.eval
            (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
            (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m *
          xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet) =
      Matrix.trace
        (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge a packet *
          (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGaugeInv a packet *
            (expr.eval
              (xiGammaEulerPrimitivePrimeDepthFiniteLogClock packet)
              (xiGammaEulerPrimitiveReflectedFiniteOffDiagonalIncidence eps 0 packet)) ^ m)) :=
      Matrix.trace_mul_comm _ _
    _ = _ := by
      rw [← Matrix.mul_assoc,
        xiGammaEulerPrimitiveReflectedFiniteOffDiagonalGauge_mul_inv,
        Matrix.one_mul]

end

end RHTower
