import GaloisForLFunctions.RHTower.FieldOneHaarCharacterProducts
import Mathlib.NumberTheory.Padics.RingHoms
import Mathlib.MeasureTheory.Group.Measure
import Mathlib.MeasureTheory.Measure.Restrict

/-!
# Exact same-place p-adic Haar scaling

This file proves the missing local formula from
`FieldOneHaarCharacterProducts`:

* multiplication by `p` on `ℚ_p` has distributive Haar character `p⁻¹`;
* the proof is the exact index formula for the residue kernel
  `ker (ℤ_p → ZMod p)`, whose additive index is `p`; and
* the formula transports through the continuous rational algebra
  equivalence from a rational adic completion to `ℚ_p`.

No cardinality computation or approximate argument is used.  The finite
quotient enters only through the abstract index of the surjective residue
homomorphism.
-/

open MeasureTheory
open MeasureTheory.Measure
open scoped ENNReal NNReal Pointwise Topology

namespace GaloisForLFunctions.RHTower

noncomputable section

open IsDedekindDomain

variable (p : ℕ) [Fact p.Prime]

/-! ## Borel structures on the explicit p-adic models -/

/-- Canonical Borel measurable structure on `ℚ_p`. -/
noncomputable instance fieldOnePadicMeasurableSpace :
    MeasurableSpace ℚ_[p] :=
  borel ℚ_[p]

/-- The chosen measurable structure on `ℚ_p` is Borel. -/
noncomputable instance fieldOnePadicBorelSpace :
    BorelSpace ℚ_[p] :=
  ⟨rfl⟩

/-- Addition on `ℚ_p` is measurable for its canonical Borel structure. -/
noncomputable instance fieldOnePadicMeasurableAdd :
    MeasurableAdd ℚ_[p] :=
  ContinuousAdd.measurableAdd

/-- `ℤ_p` inherits the measurable structure of the closed unit-ball
subtype.  Keeping this definition as a subtype comap is essential for the
measure-comap API. -/
noncomputable instance fieldOnePadicIntMeasurableSpace :
    MeasurableSpace ℤ_[p] :=
  (fieldOnePadicMeasurableSpace p).comap
    ((↑) : ℤ_[p] → ℚ_[p])

/-- The inherited measurable structure on `ℤ_p` is Borel. -/
noncomputable instance fieldOnePadicIntBorelSpace :
    BorelSpace ℤ_[p] :=
  Subtype.borelSpace (fun x : ℚ_[p] => ‖x‖ ≤ 1)

/-! ## Residue kernel and exact index -/

/-- Additive kernel of reduction `ℤ_p → ZMod p`. -/
def fieldOnePadicResidueKernel : AddSubgroup ℤ_[p] :=
  (PadicInt.toZMod (p := p)).toAddMonoidHom.ker

/-- The residue kernel is the principal ideal generated by `p`. -/
theorem fieldOnePadicResidueKernel_mem_iff
    (x : ℤ_[p]) :
    x ∈ fieldOnePadicResidueKernel p ↔
      x ∈ Ideal.span {(p : ℤ_[p])} := by
  change PadicInt.toZMod x = 0 ↔ _
  rw [← RingHom.mem_ker]
  rw [PadicInt.ker_toZMod]
  rw [PadicInt.maximalIdeal_eq_span_p]

/-- The residue kernel has finite additive index. -/
noncomputable instance fieldOnePadicResidueKernel_finiteIndex :
    (fieldOnePadicResidueKernel p).FiniteIndex := by
  dsimp [fieldOnePadicResidueKernel]
  infer_instance

/-- Exact additive index of the residue kernel. -/
theorem fieldOnePadicResidueKernel_index :
    (fieldOnePadicResidueKernel p).index = p := by
  rw [fieldOnePadicResidueKernel, AddSubgroup.index_ker]
  have hsurj :
      Function.Surjective
        (PadicInt.toZMod (p := p)).toAddMonoidHom :=
    ZMod.ringHom_surjective (PadicInt.toZMod (p := p))
  rw [AddMonoidHom.range_eq_top.mpr hsurj]
  simp

/-- The residue kernel is measurable. -/
theorem fieldOnePadicResidueKernel_measurableSet :
    MeasurableSet
      (fieldOnePadicResidueKernel p : Set ℤ_[p]) := by
  have hset :
      (fieldOnePadicResidueKernel p : Set ℤ_[p]) =
        {x | ‖x‖ < 1} := by
    ext x
    change PadicInt.toZMod x = 0 ↔ ‖x‖ < 1
    rw [← RingHom.mem_ker]
    rw [PadicInt.ker_toZMod]
    rw [IsLocalRing.mem_maximalIdeal]
    exact PadicInt.not_isUnit_iff
  rw [hset]
  exact
    measurableSet_lt continuous_norm.measurable
      measurable_const

/-! ## Exact Haar character on `ℚ_p` -/

/-- The unit of `ℚ_p` represented by its rational prime `p`. -/
def fieldOnePadicPrimeUnit : ℚ_[p]ˣ :=
  Units.mk0 (p : ℚ_[p]) (by
    exact_mod_cast (Fact.out : Nat.Prime p).ne_zero)

/-- Under the inclusion `ℤ_p ↪ ℚ_p`, the residue kernel is exactly the
scalar translate `p • ℤ_p`. -/
theorem fieldOnePadicResidueKernel_image_coe :
    ((↑) : ℤ_[p] → ℚ_[p]) ''
        (fieldOnePadicResidueKernel p : Set ℤ_[p]) =
      fieldOnePadicPrimeUnit p •
        Set.range ((↑) : ℤ_[p] → ℚ_[p]) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hy' :
        y ∈ Ideal.span {(p : ℤ_[p])} :=
      (fieldOnePadicResidueKernel_mem_iff p y).mp hy
    let y' : ℤ_[p] := y
    have hy'' :
        y' ∈ Ideal.span {(p : ℤ_[p])} :=
      hy'
    obtain ⟨z, hz⟩ :=
      Ideal.mem_span_singleton'.mp hy''
    rw [Set.mem_smul_set]
    refine ⟨(z : ℚ_[p]), ⟨z, rfl⟩, ?_⟩
    change (p : ℚ_[p]) * (z : ℚ_[p]) = (y : ℚ_[p])
    have hz' : (p : ℤ_[p]) * z = y' := by
      simpa only [mul_comm] using hz
    simpa only [y', PadicInt.coe_mul, PadicInt.coe_natCast] using
      congrArg (fun a : ℤ_[p] => (a : ℚ_[p])) hz'
  · rw [Set.mem_smul_set]
    rintro ⟨_, ⟨y, rfl⟩, rfl⟩
    refine
      ⟨(p : ℤ_[p]) * (show ℤ_[p] from y), ?_, ?_⟩
    · apply
        (fieldOnePadicResidueKernel_mem_iff p _).mpr
      rw [Ideal.mem_span_singleton']
      exact
        ⟨(show ℤ_[p] from y), mul_comm _ _⟩
    · change
        (((p : ℤ_[p]) * (show ℤ_[p] from y) : ℤ_[p]) :
            ℚ_[p]) =
          (p : ℚ_[p]) * (y : ℚ_[p])
      norm_cast

/-- Multiplication by `p` on `ℚ_p` has exact additive Haar character
`p⁻¹`. -/
theorem fieldOnePadicPrimeUnit_distribHaarChar :
    distribHaarChar ℚ_[p] (fieldOnePadicPrimeUnit p) =
      ((p : ℝ≥0)⁻¹) := by
  let μ : Measure ℚ_[p] := addHaar
  let s : Set ℚ_[p] :=
    Set.range ((↑) : ℤ_[p] → ℚ_[p])
  have hs_measurable : MeasurableSet s :=
    PadicInt.isOpenEmbedding_coe.isOpen_range.measurableSet
  have hunitBall_measurable :
      MeasurableSet {x : ℚ_[p] | ‖x‖ ≤ 1} :=
    measurableSet_le continuous_norm.measurable measurable_const
  have hs_ne_zero : μ s ≠ 0 :=
    IsOpenPosMeasure.open_pos s
      PadicInt.isOpenEmbedding_coe.isOpen_range
      ⟨0, ⟨(0 : ℤ_[p]), rfl⟩⟩
  have hs_compact : IsCompact s := by
    have hs :
        s = Metric.closedBall (0 : ℚ_[p]) 1 := by
      ext x
      simp [s, Metric.mem_closedBall, dist_eq_norm_sub]
    rw [hs]
    exact isCompact_closedBall (0 : ℚ_[p]) 1
  have hs_ne_top : μ s ≠ ∞ :=
    ne_of_lt hs_compact.measure_lt_top
  apply
    distribHaarChar_eq_of_measure_smul_eq_mul
      (μ := μ) (s := s) hs_ne_zero hs_ne_top
  let f : ℤ_[p] →+ ℚ_[p] :=
    { toFun := ((↑) : ℤ_[p] → ℚ_[p])
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let ν : Measure ℤ_[p] := μ.comap f
  letI : IsAddLeftInvariant ν :=
    IsAddLeftInvariant.comap μ
      PadicInt.isOpenEmbedding_coe.measurableEmbedding
  have hindex :=
    AddSubgroup.index_mul_measure
      (fieldOnePadicResidueKernel p)
      (fieldOnePadicResidueKernel_measurableSet p)
      ν
  rw [fieldOnePadicResidueKernel_index p] at hindex
  have hkernel :
      ν (fieldOnePadicResidueKernel p) =
        μ (((↑) : ℤ_[p] → ℚ_[p]) ''
          (fieldOnePadicResidueKernel p : Set ℤ_[p])) := by
    dsimp [ν, f]
    exact
      comap_subtype_coe_apply hunitBall_measurable μ _
  have huniv : ν Set.univ = μ s := by
    calc
      ν Set.univ =
          μ (((↑) : ℤ_[p] → ℚ_[p]) ''
            (Set.univ : Set ℤ_[p])) := by
        dsimp [ν, f]
        exact
          comap_subtype_coe_apply hunitBall_measurable μ _
      _ = μ s := by
        congr 1
        ext x
        rw [show x ∈ s ↔ ‖x‖ ≤ 1 by
          simp [s]]
        constructor
        · rintro ⟨y, _, rfl⟩
          exact y.property
        · intro hx
          exact ⟨⟨x, hx⟩, Set.mem_univ _, rfl⟩
  rw [hkernel, huniv] at hindex
  rw [fieldOnePadicResidueKernel_image_coe p] at hindex
  change
    (p : ℝ≥0∞) *
        μ (fieldOnePadicPrimeUnit p • s) =
      μ s at hindex
  rw [← hindex]
  have hp_nnreal0 : (p : ℝ≥0) ≠ 0 := by
    intro hp
    have hp_real :
        (p : ℝ) = 0 := by
      simpa only [NNReal.coe_natCast, NNReal.coe_zero] using
        congrArg (fun x : ℝ≥0 => (x : ℝ)) hp
    apply (Fact.out : Nat.Prime p).ne_zero
    exact_mod_cast hp_real
  rw [ENNReal.coe_inv hp_nnreal0]
  rw [ENNReal.coe_natCast]
  have hp0 : (p : ℝ≥0∞) ≠ 0 :=
    ENNReal.coe_ne_zero.mpr hp_nnreal0
  have hp_top : (p : ℝ≥0∞) ≠ ∞ := by
    simp
  rw [ENNReal.inv_mul_cancel_left hp0 hp_top]

/-! ## Transport to rational adic completions -/

/-- At its own rational finite place, the diagonal rational prime has local
distributive Haar character equal to the inverse prime. -/
theorem fieldOneRationalPrimeUnit_localDistribHaarChar_self
    (v : HeightOneSpectrum ℤ) :
    distribHaarChar (v.adicCompletion ℚ)
      (fieldOneRationalLocalUnit v
        (fieldOneRationalPrimeUnit v)) =
      ((Rat.HeightOneSpectrum.primesEquiv v : ℕ) : ℝ≥0)⁻¹ := by
  let p : ℕ := Rat.HeightOneSpectrum.primesEquiv v
  letI : Fact p.Prime :=
    ⟨(Rat.HeightOneSpectrum.primesEquiv v).property⟩
  let e :=
    Rat.HeightOneSpectrum.adicCompletion.padicEquiv v
  let μ : Measure ℚ_[p] := addHaar
  let s : Set ℚ_[p] :=
    Set.range ((↑) : ℤ_[p] → ℚ_[p])
  let t : Set (v.adicCompletion ℚ) :=
    e.symm '' s
  let u : (v.adicCompletion ℚ)ˣ :=
    fieldOneRationalLocalUnit v
      (fieldOneRationalPrimeUnit v)
  let q : ℚ_[p]ˣ :=
    fieldOnePadicPrimeUnit p
  have he_smul (x : v.adicCompletion ℚ) :
      e (u • x) = q • e x := by
    change
      e (algebraMap ℚ (v.adicCompletion ℚ)
          (Rat.HeightOneSpectrum.primesEquiv v : ℚ) * x) =
        (Rat.HeightOneSpectrum.primesEquiv v : ℚ_[p]) * e x
    rw [map_mul]
    congr 1
    simp
  have himage_t : e '' t = s := by
    simp [t]
  have himage_smul :
      e '' (u • t) = q • s := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [Set.mem_smul_set] at hx
      obtain ⟨z, hz, rfl⟩ := hx
      rw [he_smul]
      rw [Set.mem_smul_set]
      refine ⟨e z, ?_, rfl⟩
      rw [← himage_t]
      exact ⟨z, hz, rfl⟩
    · intro hy
      rw [Set.mem_smul_set] at hy
      obtain ⟨a, ha, rfl⟩ := hy
      refine ⟨u • e.symm a, ?_, ?_⟩
      · rw [Set.mem_smul_set]
        exact ⟨e.symm a, ⟨a, ha, rfl⟩, rfl⟩
      · simpa using he_smul (e.symm a)
  let f : v.adicCompletion ℚ →+ ℚ_[p] :=
    { toFun := e
      map_zero' := map_zero e
      map_add' := map_add e }
  let ν : Measure (v.adicCompletion ℚ) :=
    μ.comap f
  letI : IsAddHaarMeasure ν :=
    IsAddHaarMeasure.comap
      (mH := fieldOnePadicMeasurableAdd p) μ
      e.toHomeomorph.isOpenEmbedding
  have he_measurableEmbedding :
      MeasurableEmbedding
        (e : v.adicCompletion ℚ → ℚ_[p]) :=
    e.toHomeomorph.isOpenEmbedding.measurableEmbedding
  have hνt : ν t = μ s := by
    change
      μ.comap (e : v.adicCompletion ℚ → ℚ_[p]) t =
        μ s
    calc
      _ = μ (e '' t) :=
        he_measurableEmbedding.comap_apply μ t
      _ = μ s := congrArg μ himage_t
  have hνsmul : ν (u • t) = μ (q • s) := by
    change
      μ.comap (e : v.adicCompletion ℚ → ℚ_[p])
          (u • t) =
        μ (q • s)
    calc
      _ = μ (e '' (u • t)) :=
        he_measurableEmbedding.comap_apply μ (u • t)
      _ = μ (q • s) := congrArg μ himage_smul
  have hs_ne_zero : μ s ≠ 0 :=
    IsOpenPosMeasure.open_pos s
      PadicInt.isOpenEmbedding_coe.isOpen_range
      ⟨0, ⟨(0 : ℤ_[p]), rfl⟩⟩
  have hs_compact : IsCompact s := by
    have hs :
        s = Metric.closedBall (0 : ℚ_[p]) 1 := by
      ext x
      simp [s, Metric.mem_closedBall, dist_eq_norm_sub]
    rw [hs]
    exact isCompact_closedBall (0 : ℚ_[p]) 1
  have hs_ne_top : μ s ≠ ∞ :=
    ne_of_lt hs_compact.measure_lt_top
  apply
    distribHaarChar_eq_of_measure_smul_eq_mul
      (μ := ν) (s := t)
  · rwa [hνt]
  · rwa [hνt]
  · rw [hνsmul, hνt]
    change
      μ (fieldOnePadicPrimeUnit p • s) =
        (((p : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞) * μ s
    rw [← distribHaarChar_mul μ
      (fieldOnePadicPrimeUnit p) s]
    rw [fieldOnePadicPrimeUnit_distribHaarChar p]

end

end GaloisForLFunctions.RHTower
