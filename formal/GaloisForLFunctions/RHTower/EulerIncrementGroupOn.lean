import GaloisForLFunctions.RHTower.ConvexDomainEulerCompleteness
import GaloisForLFunctions.RHTower.EulerTangentInvariantRigidity

/-!
# The finite Euler-unit gauge group is dense on a convex right-half-plane domain

Replacing a single degree-one Euler factor by a nearby one changes the logarithmic flux by

`Δ_{p,b}(s) = (log p) · b · p^{-s} / ((1 - (1+b) p^{-s})(1 - p^{-s}))`,

an element of the holomorphic functions of the domain as soon as `(1 + |b|) p^{-α} < 1`, where `α`
bounds the real parts of the domain from below.  Repeating the same unit `N` times and shrinking the
parameter to `c/N` converges, uniformly on the whole domain, to `c · w_p`; the additive group
generated by the increments therefore contains every scalar multiple of every tangent in its
closure, and the completeness theorem makes that closure everything.

* `RHTower.eulerIncrementOn`;
* `RHTower.tendsto_nsmul_eulerIncrementOn`;
* `RHTower.topologicalClosure_eulerIncrementGroup_eq_top`.
-/

noncomputable section

open Complex Set Filter Topology

namespace RHTower

open GaloisForLFunctions.HTGeometry
open _root_.HTGeometry

section Basic

theorem norm_prime_cpow_neg_le {p : ℕ} (hp : p.Prime) {α : ℝ} {s : ℂ} (hs : α ≤ s.re) :
    ‖(p : ℂ) ^ (-s)‖ ≤ (p : ℝ) ^ (-α) := by
  have hp1 : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp.one_lt.le
  rw [norm_prime_cpow_neg hp s]
  exact Real.rpow_le_rpow_of_exponent_le hp1 (by linarith)

theorem one_sub_mul_prime_cpow_ne_zero {p : ℕ} (hp : p.Prime) {α : ℝ} {a s : ℂ}
    (hs : α ≤ s.re) (ha : ‖a‖ * (p : ℝ) ^ (-α) < 1) :
    1 - a * (p : ℂ) ^ (-s) ≠ 0 := by
  have hq : ‖a * (p : ℂ) ^ (-s)‖ < 1 := by
    rw [norm_mul]
    calc ‖a‖ * ‖(p : ℂ) ^ (-s)‖ ≤ ‖a‖ * (p : ℝ) ^ (-α) :=
          mul_le_mul_of_nonneg_left (norm_prime_cpow_neg_le hp hs) (norm_nonneg a)
      _ < 1 := ha
  intro hcon
  have : a * (p : ℂ) ^ (-s) = 1 := by
    have := sub_eq_zero.mp hcon
    exact this.symm
  rw [this, norm_one] at hq
  exact lt_irrefl 1 hq

/-- The logarithmic-flux increment of a degree-one Euler unit at parameter `1 + b`. -/
def eulerIncrementFun (p : ℕ) (b s : ℂ) : ℂ :=
  degreeOneEulerLocalFlux p (1 + b) s - degreeOneEulerLocalFlux p 1 s

theorem eulerIncrementFun_eq (p : ℕ) {b s : ℂ}
    (h1 : 1 - (1 + b) * (p : ℂ) ^ (-s) ≠ 0) (h2 : 1 - (p : ℂ) ^ (-s) ≠ 0) :
    eulerIncrementFun p b s
      = (Real.log p : ℂ) * b * (p : ℂ) ^ (-s)
          / ((1 - (1 + b) * (p : ℂ) ^ (-s)) * (1 - (p : ℂ) ^ (-s))) := by
  have h2' : 1 - (1 : ℂ) * (p : ℂ) ^ (-s) ≠ 0 := by rwa [one_mul]
  rw [eulerIncrementFun, degreeOneEulerLocalFlux, degreeOneEulerLocalFlux]
  field_simp
  ring

theorem eulerIncrementFun_zero (p : ℕ) (s : ℂ) : eulerIncrementFun p 0 s = 0 := by
  rw [eulerIncrementFun, add_zero, sub_self]

theorem differentiableOn_eulerIncrementFun {p : ℕ} (hp : p.Prime) {α : ℝ} {b : ℂ} {D : Set ℂ}
    (hD : ∀ s ∈ D, α ≤ s.re) (hb : (1 + ‖b‖) * (p : ℝ) ^ (-α) < 1) :
    DifferentiableOn ℂ (eulerIncrementFun p b) D := by
  have hp0 : (p : ℂ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hρ : (0 : ℝ) ≤ (p : ℝ) ^ (-α) := Real.rpow_nonneg (by positivity) _
  have h1b : ‖1 + b‖ * (p : ℝ) ^ (-α) < 1 := by
    refine lt_of_le_of_lt (mul_le_mul_of_nonneg_right ?_ hρ) hb
    calc ‖1 + b‖ ≤ ‖(1 : ℂ)‖ + ‖b‖ := norm_add_le _ _
      _ = 1 + ‖b‖ := by simp
  have h1 : ‖(1 : ℂ)‖ * (p : ℝ) ^ (-α) < 1 := by
    refine lt_of_le_of_lt (mul_le_mul_of_nonneg_right ?_ hρ) hb
    simp only [norm_one]
    linarith [norm_nonneg b]
  have hpow : DifferentiableOn ℂ (fun s : ℂ => (p : ℂ) ^ (-s)) D :=
    (differentiable_neg.differentiableOn).const_cpow (Or.inl hp0)
  have hflux : ∀ a : ℂ, ‖a‖ * (p : ℝ) ^ (-α) < 1 →
      DifferentiableOn ℂ (fun s : ℂ => degreeOneEulerLocalFlux p a s) D := by
    intro a ha
    have hnum : DifferentiableOn ℂ
        (fun s : ℂ => (Real.log p : ℂ) * (a * (p : ℂ) ^ (-s))) D :=
      (differentiableOn_const _).mul ((differentiableOn_const a).mul hpow)
    have hden : DifferentiableOn ℂ (fun s : ℂ => 1 - a * (p : ℂ) ^ (-s)) D :=
      (differentiableOn_const (1 : ℂ)).sub ((differentiableOn_const a).mul hpow)
    intro s hs
    exact (hnum s hs).div (hden s hs)
      (one_sub_mul_prime_cpow_ne_zero hp (hD s hs) ha)
  exact (hflux (1 + b) h1b).sub (hflux 1 h1)

end Basic

section Group

variable {D : Set ℂ} {α : ℝ}

/-- Parameters for which the degree-one increment is holomorphic on a domain of real part at
least `α`. -/
def IncrementAdmissible (p : ℕ) (α : ℝ) (b : ℂ) : Prop := (1 + ‖b‖) * (p : ℝ) ^ (-α) < 1

/-- The logarithmic-flux increment of a degree-one Euler unit, as an element of the holomorphic
space of the domain. -/
def eulerIncrementOn (hD : ∀ s ∈ D, α ≤ s.re) {p : Nat.Primes} {b : ℂ}
    (hb : IncrementAdmissible (p : ℕ) α b) : holoOn D :=
  ⟨⟨fun z => eulerIncrementFun (p : ℕ) b (z : ℂ),
      ((differentiableOn_eulerIncrementFun p.2 hD hb).continuousOn).restrict⟩,
    ⟨eulerIncrementFun (p : ℕ) b, differentiableOn_eulerIncrementFun p.2 hD hb, fun _ => rfl⟩⟩

/-- A complex multiple of the prime Euler tangent, as an element of the holomorphic space. -/
def cmulEulerTangentOn (D : Set ℂ) (hDre : D ⊆ {s : ℂ | 0 < s.re}) (c : ℂ) (p : Nat.Primes) :
    holoOn D :=
  ⟨⟨fun z => c * eulerTangent (p : ℕ) (z : ℂ),
      (((differentiableOn_const c).mul
        ((differentiableOn_eulerTangent p.2).mono hDre)).continuousOn).restrict⟩,
    ⟨fun s => c * eulerTangent (p : ℕ) s,
      (differentiableOn_const c).mul ((differentiableOn_eulerTangent p.2).mono hDre), fun _ => rfl⟩⟩

/-- The set of all degree-one Euler-unit increments on the domain. -/
def eulerIncrementSet (hD : ∀ s ∈ D, α ≤ s.re) : Set (holoOn D) :=
  {g | ∃ (p : Nat.Primes) (b : ℂ) (hb : IncrementAdmissible (p : ℕ) α b),
    g = eulerIncrementOn hD hb}

/-- The additive group generated by the degree-one Euler-unit increments. -/
def eulerIncrementGroup (hD : ∀ s ∈ D, α ≤ s.re) : AddSubgroup (holoOn D) :=
  AddSubgroup.closure (eulerIncrementSet hD)

theorem rho_lt_one {p : ℕ} (hp : p.Prime) {α : ℝ} (hα : 0 < α) : (p : ℝ) ^ (-α) < 1 := by
  have hp1 : (1 : ℝ) < (p : ℝ) := by exact_mod_cast hp.one_lt
  have := Real.rpow_lt_rpow_of_exponent_lt hp1 (show -α < 0 by linarith)
  simpa using this

theorem rho_pos {p : ℕ} (hp : p.Prime) (α : ℝ) : 0 < (p : ℝ) ^ (-α) :=
  Real.rpow_pos_of_pos (by exact_mod_cast hp.pos) _

/-- **The pointwise repetition identity.**  Repeating the same degree-one unit `N` times with
parameter `d` differs from `d·N` times the tangent by an explicit second-order term. -/
theorem nsmul_eulerIncrementFun_sub (p : ℕ) (d N : ℂ) {s : ℂ}
    (h1 : 1 - (1 + d) * (p : ℂ) ^ (-s) ≠ 0) (h2 : 1 - (p : ℂ) ^ (-s) ≠ 0) :
    N * eulerIncrementFun p d s - (d * N) * eulerTangent p s
      = (Real.log p : ℂ) * d ^ 2 * N * ((p : ℂ) ^ (-s)) ^ 2
          / ((1 - (1 + d) * (p : ℂ) ^ (-s)) * (1 - (p : ℂ) ^ (-s)) ^ 2) := by
  have key : ∀ L q A B : ℂ, A ≠ 0 → B ≠ 0 → B - A = d * q →
      N * (L * d * q / (A * B)) - (d * N) * (L * q / B ^ 2)
        = L * d ^ 2 * N * q ^ 2 / (A * B ^ 2) := by
    intro L q A B hA hB hAB
    field_simp
    linear_combination (N * L * d * q) * hAB
  rw [eulerIncrementFun_eq p h1 h2, eulerTangent]
  exact key (Real.log p : ℂ) ((p : ℂ) ^ (-s)) (1 - (1 + d) * (p : ℂ) ^ (-s))
    (1 - (p : ℂ) ^ (-s)) h1 h2 (by ring)

/-- **The uniform second-order estimate.**  Repeating a degree-one unit `Nr` times with parameter
`c/Nr` approximates `c` times the tangent to order `1/Nr`, uniformly on the domain. -/
theorem norm_nsmul_eulerIncrement_sub_le {p : ℕ} (hp : p.Prime) {α : ℝ} (hα : 0 < α) {D : Set ℂ}
    (hD : ∀ s ∈ D, α ≤ s.re) {c : ℂ} {Nr : ℝ} (hNr : 0 < Nr)
    (hhalf : ‖c‖ / Nr * (p : ℝ) ^ (-α) ≤ (1 - (p : ℝ) ^ (-α)) / 2)
    {z : ℂ} (hz : z ∈ D) :
    ‖(Nr : ℂ) * eulerIncrementFun p (c / (Nr : ℂ)) z - c * eulerTangent p z‖
      ≤ (2 * Real.log p * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2 / (1 - (p : ℝ) ^ (-α)) ^ 3) / Nr := by
  have hrho0 : 0 < (p : ℝ) ^ (-α) := rho_pos hp α
  have hLpos : 0 ≤ Real.log (p : ℝ) := Real.log_nonneg (by exact_mod_cast hp.one_lt.le)
  have hNrc : ((Nr : ℝ) : ℂ) ≠ 0 := by
    simp only [ne_eq, Complex.ofReal_eq_zero]
    exact hNr.ne'
  have hcnn : (0 : ℝ) ≤ ‖c‖ / Nr := by positivity
  have hrho1 : (p : ℝ) ^ (-α) < 1 := rho_lt_one hp hα
  have hdnorm : ‖c / ((Nr : ℝ) : ℂ)‖ = ‖c‖ / Nr := by
    rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hNr.le]
  have hqnorm : ‖(p : ℂ) ^ (-z)‖ ≤ (p : ℝ) ^ (-α) := norm_prime_cpow_neg_le hp (hD z hz)
  have hone : ‖1 + c / ((Nr : ℝ) : ℂ)‖ ≤ 1 + ‖c‖ / Nr := by
    calc ‖1 + c / ((Nr : ℝ) : ℂ)‖ ≤ ‖(1 : ℂ)‖ + ‖c / ((Nr : ℝ) : ℂ)‖ := norm_add_le _ _
      _ = 1 + ‖c‖ / Nr := by rw [hdnorm]; simp
  have hA : 1 - (1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z) ≠ 0 := by
    refine one_sub_mul_prime_cpow_ne_zero hp (hD z hz) ?_
    calc ‖1 + c / ((Nr : ℝ) : ℂ)‖ * (p : ℝ) ^ (-α)
        ≤ (1 + ‖c‖ / Nr) * (p : ℝ) ^ (-α) := mul_le_mul_of_nonneg_right hone hrho0.le
      _ < 1 := by nlinarith
  have hBne : 1 - (p : ℂ) ^ (-z) ≠ 0 := by
    have h := one_sub_mul_prime_cpow_ne_zero (a := 1) hp (hD z hz) (by simpa using hrho1)
    simpa using h
  have hdN : (c / ((Nr : ℝ) : ℂ)) * ((Nr : ℝ) : ℂ) = c := div_mul_cancel₀ c hNrc
  have hident := nsmul_eulerIncrementFun_sub p (c / ((Nr : ℝ) : ℂ)) ((Nr : ℝ) : ℂ) hA hBne
  rw [hdN] at hident
  rw [hident]
  have hAlow : (1 - (p : ℝ) ^ (-α)) / 2
      ≤ ‖1 - (1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z)‖ := by
    have h1 : ‖(1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z)‖ ≤ (1 + ‖c‖ / Nr) * (p : ℝ) ^ (-α) := by
      rw [norm_mul]
      exact mul_le_mul hone hqnorm (norm_nonneg _) (by positivity)
    have h2 := norm_sub_norm_le (1 : ℂ) ((1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z))
    simp only [norm_one] at h2
    nlinarith
  have hBlow : 1 - (p : ℝ) ^ (-α) ≤ ‖1 - (p : ℂ) ^ (-z)‖ := by
    have h2 := norm_sub_norm_le (1 : ℂ) ((p : ℂ) ^ (-z))
    simp only [norm_one] at h2
    linarith
  have hApos : 0 < ‖1 - (1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z)‖ := by
    have hh : (0 : ℝ) < (1 - (p : ℝ) ^ (-α)) / 2 := by linarith
    linarith
  have hBpos : 0 < ‖1 - (p : ℂ) ^ (-z)‖ := by linarith
  simp only [norm_div, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hNr.le, abs_of_nonneg hLpos]
  rw [div_le_div_iff₀ (by positivity) hNr]
  have hq2 : ‖(p : ℂ) ^ (-z)‖ ^ 2 ≤ ((p : ℝ) ^ (-α)) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hqnorm 2
  have hnum : Real.log (p : ℝ) * (‖c‖ / Nr) ^ 2 * Nr * ‖(p : ℂ) ^ (-z)‖ ^ 2 * Nr
      ≤ Real.log (p : ℝ) * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2 := by
    have hexp : Real.log (p : ℝ) * (‖c‖ / Nr) ^ 2 * Nr * ‖(p : ℂ) ^ (-z)‖ ^ 2 * Nr
        = Real.log (p : ℝ) * ‖c‖ ^ 2 * ‖(p : ℂ) ^ (-z)‖ ^ 2 := by
      field_simp
    rw [hexp]
    have hnn : (0 : ℝ) ≤ Real.log (p : ℝ) * ‖c‖ ^ 2 := by positivity
    nlinarith
  have hfac : ((1 - (p : ℝ) ^ (-α)) / 2) * (1 - (p : ℝ) ^ (-α)) ^ 2
      ≤ ‖1 - (1 + c / ((Nr : ℝ) : ℂ)) * (p : ℂ) ^ (-z)‖ * ‖1 - (p : ℂ) ^ (-z)‖ ^ 2 := by
    have h2 : (0 : ℝ) ≤ 1 - (p : ℝ) ^ (-α) := by linarith
    have h3 : (1 - (p : ℝ) ^ (-α)) ^ 2 ≤ ‖1 - (p : ℂ) ^ (-z)‖ ^ 2 := pow_le_pow_left₀ h2 hBlow 2
    nlinarith [sq_nonneg (1 - (p : ℝ) ^ (-α))]
  have hBnn : (0 : ℝ) ≤ 2 * Real.log (p : ℝ) * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2
      / (1 - (p : ℝ) ^ (-α)) ^ 3 := by
    have hpos3 : (0 : ℝ) < (1 - (p : ℝ) ^ (-α)) ^ 3 := by
      have : (0 : ℝ) < 1 - (p : ℝ) ^ (-α) := by linarith
      positivity
    positivity
  have hBval : (2 * Real.log (p : ℝ) * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2
        / (1 - (p : ℝ) ^ (-α)) ^ 3) * (((1 - (p : ℝ) ^ (-α)) / 2) * (1 - (p : ℝ) ^ (-α)) ^ 2)
      = Real.log (p : ℝ) * ‖c‖ ^ 2 * ((p : ℝ) ^ (-α)) ^ 2 := by
    have hne : (1 - (p : ℝ) ^ (-α)) ≠ 0 := by linarith
    field_simp
  nlinarith [mul_le_mul_of_nonneg_left hfac hBnn]

/-- **The repetition limit.**  Every complex multiple of a prime Euler tangent lies in the closure of
the additive group generated by the degree-one Euler-unit increments. -/
theorem cmulEulerTangentOn_mem_closure (hD : ∀ s ∈ D, α ≤ s.re) (hα : 0 < α)
    (hDre : D ⊆ {s : ℂ | 0 < s.re}) (p : Nat.Primes) (c : ℂ) :
    cmulEulerTangentOn D hDre c p ∈ (eulerIncrementGroup hD).topologicalClosure := by
  classical
  have hrho0 : 0 < ((p : ℕ) : ℝ) ^ (-α) := rho_pos p.2 α
  have hrho1 : ((p : ℕ) : ℝ) ^ (-α) < 1 := rho_lt_one p.2 hα
  obtain ⟨N₁, hN₁⟩ := exists_nat_ge (2 * ‖c‖ * ((p : ℕ) : ℝ) ^ (-α) / (1 - ((p : ℕ) : ℝ) ^ (-α)))
  set N₀ : ℕ := N₁ + 1 with hN₀def
  have hNr : ∀ n : ℕ, (1 : ℝ) ≤ ((n + N₀ : ℕ) : ℝ) := by
    intro n
    have h : (1 : ℕ) ≤ n + N₀ := by omega
    exact_mod_cast h
  have hNrpos : ∀ n : ℕ, (0 : ℝ) < ((n + N₀ : ℕ) : ℝ) := fun n => lt_of_lt_of_le one_pos (hNr n)
  have hNrbig : ∀ n : ℕ,
      2 * ‖c‖ * ((p : ℕ) : ℝ) ^ (-α) / (1 - ((p : ℕ) : ℝ) ^ (-α)) ≤ ((n + N₀ : ℕ) : ℝ) := by
    intro n
    have h : ((N₁ : ℕ) : ℝ) ≤ ((n + N₀ : ℕ) : ℝ) := by
      rw [hN₀def]
      push_cast
      linarith [Nat.cast_nonneg (α := ℝ) n]
    linarith
  have hhalf : ∀ n : ℕ, ‖c‖ / ((n + N₀ : ℕ) : ℝ) * ((p : ℕ) : ℝ) ^ (-α)
      ≤ (1 - ((p : ℕ) : ℝ) ^ (-α)) / 2 := by
    intro n
    have hNp := hNrpos n
    have h := hNrbig n
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 1 - ((p : ℕ) : ℝ) ^ (-α))] at h
    rw [div_mul_eq_mul_div, div_le_iff₀ hNp]
    nlinarith
  have hadm : ∀ n : ℕ,
      IncrementAdmissible (p : ℕ) α (c / ((((n + N₀ : ℕ) : ℝ)) : ℂ)) := by
    intro n
    have hnorm : ‖c / ((((n + N₀ : ℕ) : ℝ)) : ℂ)‖ = ‖c‖ / ((n + N₀ : ℕ) : ℝ) := by
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg (hNrpos n).le]
    rw [IncrementAdmissible, hnorm]
    nlinarith [hhalf n]
  set g : ℕ → holoOn D := fun n => (n + N₀) • eulerIncrementOn hD (hadm n) with hg
  have hgmem : ∀ n : ℕ, g n ∈ eulerIncrementGroup hD := by
    intro n
    refine AddSubgroup.nsmul_mem _ (AddSubgroup.subset_closure ?_) _
    exact ⟨p, c / ((((n + N₀ : ℕ) : ℝ)) : ℂ), hadm n, rfl⟩
  set B : ℝ := 2 * Real.log ((p : ℕ) : ℝ) * ‖c‖ ^ 2 * (((p : ℕ) : ℝ) ^ (-α)) ^ 2
    / (1 - ((p : ℕ) : ℝ) ^ (-α)) ^ 3 with hB
  have htend' : Filter.Tendsto (fun n : ℕ => ((g n : holoOn D) : C((D : Set ℂ), ℂ)))
      Filter.atTop (nhds ((cmulEulerTangentOn D hDre c p : holoOn D) : C((D : Set ℂ), ℂ))) := by
    rw [← tendsto_sub_nhds_zero_iff]
    rw [(hasBasis_nhds_zero_continuousMap (X := (D : Set ℂ))).tendsto_right_iff]
    rintro ⟨Kc, ε⟩ ⟨-, hε⟩
    have hBlim : Filter.Tendsto (fun n : ℕ => B / ((n + N₀ : ℕ) : ℝ)) Filter.atTop (nhds 0) := by
      have hcast : Filter.Tendsto (fun n : ℕ => ((n + N₀ : ℕ) : ℝ)) Filter.atTop Filter.atTop := by
        refine Filter.tendsto_atTop_mono (fun n => ?_) tendsto_natCast_atTop_atTop
        push_cast
        linarith [Nat.cast_nonneg (α := ℝ) N₀]
      exact Filter.Tendsto.const_div_atTop hcast B
    have hev := hBlim.eventually (eventually_lt_nhds hε)
    filter_upwards [hev] with n hn
    intro x _
    have hval : ((g n : C((D : Set ℂ), ℂ))
          - (cmulEulerTangentOn D hDre c p : C((D : Set ℂ), ℂ))) x
        = ((((n + N₀ : ℕ) : ℝ)) : ℂ) * eulerIncrementFun (p : ℕ)
            (c / ((((n + N₀ : ℕ) : ℝ)) : ℂ)) (x : ℂ) - c * eulerTangent (p : ℕ) (x : ℂ) := by
      simp only [ContinuousMap.sub_apply, hg]
      norm_num [eulerIncrementOn, cmulEulerTangentOn, Complex.real_smul]
    rw [hval]
    refine lt_of_le_of_lt ?_ hn
    exact norm_nsmul_eulerIncrement_sub_le p.2 hα hD (hNrpos n) (hhalf n) x.2
  have htend : Filter.Tendsto g Filter.atTop (nhds (cmulEulerTangentOn D hDre c p)) :=
    tendsto_subtype_rng.mpr htend'
  exact (eulerIncrementGroup hD).isClosed_topologicalClosure.mem_of_tendsto htend
    (Filter.Eventually.of_forall fun n =>
      (eulerIncrementGroup hD).le_topologicalClosure (hgmem n))

theorem smul_eulerTangentOn_eq (hDre : D ⊆ {s : ℂ | 0 < s.re}) (r : ℝ) (p : Nat.Primes) :
    r • eulerTangentOn D hDre p = cmulEulerTangentOn D hDre ((r : ℂ)) p := by
  apply Subtype.ext
  ext z
  show (r : ℝ) • eulerTangent (p : ℕ) (z : ℂ) = (r : ℂ) * eulerTangent (p : ℕ) (z : ℂ)
  rw [Complex.real_smul]

theorem smul_imul_eulerTangentOn_eq (hDre : D ⊆ {s : ℂ | 0 < s.re}) (r : ℝ) (p : Nat.Primes) :
    r • holoOnImul D (eulerTangentOn D hDre p)
      = cmulEulerTangentOn D hDre ((r : ℂ) * Complex.I) p := by
  apply Subtype.ext
  ext z
  show (r : ℝ) • (Complex.I * eulerTangent (p : ℕ) (z : ℂ))
    = ((r : ℂ) * Complex.I) * eulerTangent (p : ℕ) (z : ℂ)
  rw [Complex.real_smul]
  ring

/-- **The finite Euler-unit gauge group is dense.**  On an open convex domain whose real parts are
bounded below by a positive number the additive group generated by the degree-one Euler-unit
increments has full closure. -/
theorem topologicalClosure_eulerIncrementGroup_eq_top
    (hDopen : IsOpen D) (hDconv : Convex ℝ D) (hα : 0 < α) (hD : ∀ s ∈ D, α ≤ s.re) :
    (eulerIncrementGroup hD).topologicalClosure = ⊤ := by
  classical
  have hDre : D ⊆ {s : ℂ | 0 < s.re} := fun s hs => lt_of_lt_of_le hα (hD s hs)
  have hgen : ∀ (r : ℝ) (q : {p : Nat.Primes // p ∉ (∅ : Finset Nat.Primes)} × Bool),
      r • eulerTangentOnFamily D hDre ∅ q ∈ (eulerIncrementGroup hD).topologicalClosure := by
    rintro r ⟨p, bl⟩
    cases bl with
    | false =>
        rw [show eulerTangentOnFamily D hDre ∅ (p, false)
            = eulerTangentOn D hDre (p : Nat.Primes) from rfl,
          smul_eulerTangentOn_eq hDre r]
        exact cmulEulerTangentOn_mem_closure hD hα hDre _ _
    | true =>
        rw [show eulerTangentOnFamily D hDre ∅ (p, true)
            = holoOnImul D (eulerTangentOn D hDre (p : Nat.Primes)) from rfl,
          smul_imul_eulerTangentOn_eq hDre r]
        exact cmulEulerTangentOn_mem_closure hD hα hDre _ _
  have hspan : ((Submodule.span ℝ (Set.range (eulerTangentOnFamily D hDre ∅)) :
      Submodule ℝ (holoOn D)) : Set (holoOn D))
      ⊆ (((eulerIncrementGroup hD).topologicalClosure : AddSubgroup (holoOn D)) :
        Set (holoOn D)) := by
    intro x hx
    obtain ⟨n, f, gg, hsum⟩ := Submodule.mem_span_set'.mp hx
    rw [← hsum]
    refine AddSubgroup.sum_mem _ fun i _ => ?_
    obtain ⟨q, hq⟩ := (gg i).2
    rw [show ((gg i : holoOn D)) = eulerTangentOnFamily D hDre ∅ q from hq.symm]
    exact hgen (f i) q
  have htop := topologicalClosure_span_eulerTangentOn_eq_top hDopen hDconv hDre ∅
  have hcl : closure ((Submodule.span ℝ (Set.range (eulerTangentOnFamily D hDre ∅)) :
      Submodule ℝ (holoOn D)) : Set (holoOn D)) = Set.univ := by
    have hcoe := Submodule.topologicalClosure_coe
      (Submodule.span ℝ (Set.range (eulerTangentOnFamily D hDre ∅)))
    rw [← hcoe, htop]
    rfl
  have hsub : closure ((Submodule.span ℝ (Set.range (eulerTangentOnFamily D hDre ∅)) :
      Submodule ℝ (holoOn D)) : Set (holoOn D))
      ⊆ (((eulerIncrementGroup hD).topologicalClosure : AddSubgroup (holoOn D)) :
        Set (holoOn D)) :=
    ((eulerIncrementGroup hD).isClosed_topologicalClosure).closure_subset_iff.mpr hspan
  refine SetLike.ext' (Set.eq_univ_of_univ_subset ?_)
  rw [← hcl]
  exact hsub

/-- **A continuous map invariant under a dense subgroup of translations is constant.** -/
theorem eq_of_addSubgroup_translation_invariant_of_dense
    {E : Type*} [TopologicalSpace E] [AddCommGroup E] [IsTopologicalAddGroup E]
    {X : Type*} [TopologicalSpace X] [T2Space X]
    {G : AddSubgroup E} (hG : G.topologicalClosure = ⊤) (F : E → X) (hF : Continuous F)
    (hinv : ∀ g ∈ G, ∀ x : E, F (g + x) = F x) (x y : E) : F x = F y := by
  have hclosed : IsClosed {z : E | F z = F x} := isClosed_eq hF continuous_const
  have hsub : ((fun g => x + g) '' (G : Set E)) ⊆ {z : E | F z = F x} := by
    rintro _ ⟨g, hg, rfl⟩
    show F (x + g) = F x
    rw [add_comm x g]
    exact hinv g hg x
  have hGdense : closure (G : Set E) = Set.univ := by
    have hcoe : ((G.topologicalClosure : AddSubgroup E) : Set E) = closure (G : Set E) := rfl
    rw [← hcoe, hG]
    rfl
  have hdense : closure ((fun g => x + g) '' (G : Set E)) = Set.univ := by
    have hhom : ((fun g => x + g) '' (G : Set E)) = (Homeomorph.addLeft x) '' (G : Set E) := rfl
    rw [hhom, ← Homeomorph.image_closure, hGdense, Set.image_univ]
    exact (Homeomorph.addLeft x).surjective.range_eq
  have hall : {z : E | F z = F x} = Set.univ := by
    refine Set.eq_univ_of_univ_subset ?_
    rw [← hdense]
    exact hclosed.closure_subset_iff.mpr hsub
  have hy : y ∈ {z : E | F z = F x} := by rw [hall]; trivial
  exact hy.symm

/-- **Every continuous invariant of the finite Euler-unit gauge action is constant.** -/
theorem eulerIncrementGroup_invariant_eq_const {X : Type*} [TopologicalSpace X] [T2Space X]
    (hDopen : IsOpen D) (hDconv : Convex ℝ D) (hα : 0 < α) (hD : ∀ s ∈ D, α ≤ s.re)
    (F : holoOn D → X) (hF : Continuous F)
    (hinv : ∀ g ∈ eulerIncrementGroup hD, ∀ x : holoOn D, F (g + x) = F x)
    (x y : holoOn D) : F x = F y :=
  eq_of_addSubgroup_translation_invariant_of_dense
    (topologicalClosure_eulerIncrementGroup_eq_top hDopen hDconv hα hD) F hF hinv x y

end Group

