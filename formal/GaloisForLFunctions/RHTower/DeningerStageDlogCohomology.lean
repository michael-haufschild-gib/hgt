import GaloisForLFunctions.RHTower.DeningerDlogWedgeBasis
import GaloisForLFunctions.RHTower.DeningerWedgeNotExact

/-!
# The cohomology of a character stage is generated by the logarithmic differentials

Every closed holomorphic form on a character stage is a combination of the exterior products of the
logarithmic differentials of the coordinates, plus an exact form: its class is constant in the
logarithmic coordinates, and the constant forms are spanned by the determinant forms, whose stage
forms are those exterior products.  No nonzero such combination is exact, so the combination is
unique.

* `deningerSubsetWedge` : the exterior product of the logarithmic differentials of a set of
  coordinates.
* `deningerStage_closed_form_dlog_decomposition` : the decomposition of a closed holomorphic form.
* `deningerDlogWedge_not_exact` : no generator is exact.
-/

namespace RHTower

open Complex Finset ContinuousAlternatingMap

section ConstantStageFormLinear

variable {r n : ℕ}

theorem deningerConstantStageForm_zero (z : Fin r → ℂ) :
    deningerConstantStageForm (0 : (Fin r → ℂ) [⋀^Fin n]→L[ℂ] ℂ) z = 0 := by
  ext v
  rfl

theorem deningerConstantStageForm_add (A B : (Fin r → ℂ) [⋀^Fin n]→L[ℂ] ℂ) (z : Fin r → ℂ) :
    deningerConstantStageForm (A + B) z =
      deningerConstantStageForm A z + deningerConstantStageForm B z := by
  ext v
  rfl

theorem deningerConstantStageForm_smul (c : ℂ) (A : (Fin r → ℂ) [⋀^Fin n]→L[ℂ] ℂ)
    (z : Fin r → ℂ) :
    deningerConstantStageForm (c • A) z = c • deningerConstantStageForm A z := by
  ext v
  rfl

theorem deningerConstantStageForm_sum {ι : Type*} (s : Finset ι)
    (f : ι → (Fin r → ℂ) [⋀^Fin n]→L[ℂ] ℂ) (z : Fin r → ℂ) :
    deningerConstantStageForm (∑ i ∈ s, f i) z =
      ∑ i ∈ s, deningerConstantStageForm (f i) z := by
  classical
  induction s using Finset.induction with
  | empty =>
      rw [Finset.sum_empty, Finset.sum_empty, deningerConstantStageForm_zero]
  | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, deningerConstantStageForm_add, ih]

end ConstantStageFormLinear

end RHTower

namespace RHTower

open Complex Finset ContinuousAlternatingMap

section DlogDecomposition

variable {r k n : ℕ}

/-- **The exterior product of the logarithmic differentials of a set of coordinates**, taken in the
increasing order of the coordinates. -/
noncomputable def deningerSubsetWedge (k : ℕ) (s : Finset (Fin r)) : DeningerStageForm r k :=
  if h : s.card = k then deningerDlogWedge (fun a => s.orderEmbOfFin h a) else 0

/-- The coefficient of a constant form along a set of coordinates. -/
noncomputable def deningerSubsetCoeff (α : (Fin r → ℂ) [⋀^Fin k]→L[ℂ] ℂ)
    (s : Finset (Fin r)) : ℂ :=
  if h : s.card = k then
    α fun a => (Pi.single (s.orderEmbOfFin h a) (1 : ℂ) : Fin r → ℂ) else 0

/-- The component of a constant form along a set of coordinates defines the corresponding multiple
of the exterior product of logarithmic differentials. -/
theorem deningerConstantStageForm_subsetForm (α : (Fin r → ℂ) [⋀^Fin k]→L[ℂ] ℂ)
    (s : Finset (Fin r)) (z : Fin r → ℂ) :
    deningerConstantStageForm (deningerSubsetForm α s) z =
      deningerSubsetCoeff α s • deningerSubsetWedge k s z := by
  by_cases h : s.card = k
  · rw [deningerSubsetForm, dif_pos h, deningerSubsetCoeff, dif_pos h, deningerSubsetWedge,
      dif_pos h, deningerConstantStageForm_smul, deningerConstantStageForm_detForm]
  · rw [deningerSubsetForm, dif_neg h, deningerSubsetCoeff, dif_neg h,
      deningerConstantStageForm_zero]
    ext v
    show (0 : ℂ) = (0 : ℂ) • (deningerSubsetWedge k s z v)
    rw [smul_eq_mul, zero_mul]

/-- **A constant stage form is a combination of the exterior products of the logarithmic
differentials.** -/
theorem deningerConstantStageForm_eq_dlog_sum (α : (Fin r → ℂ) [⋀^Fin k]→L[ℂ] ℂ)
    (z : Fin r → ℂ) :
    deningerConstantStageForm α z =
      ∑ s : Finset (Fin r), deningerSubsetCoeff α s • deningerSubsetWedge k s z := by
  conv_lhs => rw [deningerDetForm_span α]
  rw [deningerConstantStageForm_sum]
  exact Finset.sum_congr rfl fun s _ => deningerConstantStageForm_subsetForm α s z

/-- **Every closed holomorphic form on a character stage is a combination of the exterior products
of the logarithmic differentials of the coordinates, plus an exact form.**  This is the cohomology
of the stage in every degree, with the generators of the statement. -/
theorem deningerStage_closed_form_dlog_decomposition {ω : DeningerStageForm r (n + 1)}
    (hω : DeningerIsHolomorphicForm ω)
    (hclosed : ∀ z ∈ deningerStageTorus r, extDeriv ω z = 0) :
    ∃ (c : Finset (Fin r) → ℂ) (θ : DeningerStageForm r n),
      ∀ z ∈ deningerStageTorus r,
        ω z = (∑ s : Finset (Fin r), c s • deningerSubsetWedge (n + 1) s z) + extDeriv θ z := by
  obtain ⟨α, θ, hdecomp⟩ := deningerStage_closed_form_decomposition hω hclosed
  refine ⟨deningerSubsetCoeff α, θ, fun z hz => ?_⟩
  rw [hdecomp z hz, deningerConstantStageForm_eq_dlog_sum]

end DlogDecomposition

end RHTower
