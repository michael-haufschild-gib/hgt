import Mathlib.Data.List.Perm.Basic
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Sym.Card
import Mathlib.Logic.Relation
import Mathlib.SetTheory.Cardinal.Finite
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.BigOperators.Ring.Finset

/-!
# Local-circuit trace capacity

Words in a local circuit alphabet are identified when adjacent independent gates are exchanged.
This file supplies the exact projection invariant needed to count those trace classes: a trace is
determined by its multiplicity multiset together with its two-letter projections along every
dependent pair.  The result is purely finite and unconditional; later files apply its capacity
bound to circuit dictionaries.
-/

namespace GaloisForLFunctions.RHTower

open Relation

section TraceProjection

variable {α : Type*} [DecidableEq α]

/-- One exchange of adjacent independent letters, in an arbitrary word context. -/
inductive IndependentSwap (independent : α → α → Prop) : List α → List α → Prop
  | swap (u v : List α) (a b : α) (hab : independent a b) :
      IndependentSwap independent (u ++ a :: b :: v) (u ++ b :: a :: v)

/-- Equivalence generated by exchanges of adjacent independent letters. -/
def TraceEq (independent : α → α → Prop) : List α → List α → Prop :=
  Relation.EqvGen (IndependentSwap independent)

/-- Projection of a word onto the two-letter alphabet `{a,b}`. -/
def pairProjection (a b : α) (w : List α) : List α :=
  w.filter fun x => decide (x = a) || decide (x = b)

@[simp]
theorem pairProjection_nil (a b : α) : pairProjection a b [] = [] := rfl

@[simp]
theorem pairProjection_cons (a b x : α) (w : List α) :
    pairProjection a b (x :: w) =
      if x = a ∨ x = b then x :: pairProjection a b w else pairProjection a b w := by
  by_cases hx : x = a ∨ x = b <;> simp [pairProjection, hx]

@[simp]
theorem pairProjection_append (a b : α) (u v : List α) :
    pairProjection a b (u ++ v) = pairProjection a b u ++ pairProjection a b v := by
  simp [pairProjection]

omit [DecidableEq α] in
theorem independentSwap_perm {independent : α → α → Prop} {u v : List α}
    (h : IndependentSwap independent u v) : u.Perm v := by
  cases h with
  | swap l r a b hab =>
      exact List.Perm.append_left l (List.Perm.swap b a r)

omit [DecidableEq α] in
theorem traceEq_perm {independent : α → α → Prop} {u v : List α}
    (h : TraceEq independent u v) : u.Perm v := by
  induction h with
  | rel _ _ h => exact independentSwap_perm h
  | refl => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ huv hvw => exact huv.trans hvw

omit [DecidableEq α] in
theorem traceEq_cons {independent : α → α → Prop} (c : α) {u v : List α}
    (h : TraceEq independent u v) : TraceEq independent (c :: u) (c :: v) := by
  induction h with
  | rel x y hxy =>
      cases hxy with
      | swap l r a b hab =>
          exact Relation.EqvGen.rel _ _
            (IndependentSwap.swap (c :: l) r a b hab)
  | refl => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ hxy hyz => exact Relation.EqvGen.trans _ _ _ hxy hyz

/-- A swap of independent letters is invisible to every dependent two-letter projection. -/
theorem pairProjection_eq_of_independentSwap {independent : α → α → Prop}
    (hsymm : ∀ x y, independent x y → independent y x) {c d : α}
    (hdep : ¬ independent c d) {u v : List α} (h : IndependentSwap independent u v) :
    pairProjection c d u = pairProjection c d v := by
  cases h with
  | swap l r a b hab =>
      have hsafe : a = b ∨ ¬((a = c ∨ a = d) ∧ (b = c ∨ b = d)) := by
        by_cases habEq : a = b
        · exact Or.inl habEq
        · refine Or.inr ?_
          rintro ⟨ha, hb⟩
          rcases ha with hac | had <;> rcases hb with hbc | hbd
          · exact habEq (hac.trans hbc.symm)
          · exact hdep (hac ▸ hbd ▸ hab)
          · exact hdep (hbc ▸ had ▸ hsymm _ _ hab)
          · exact habEq (had.trans hbd.symm)
      rcases hsafe with rfl | hsafe
      · rfl
      · by_cases ha : a = c ∨ a = d <;> by_cases hb : b = c ∨ b = d
        · exact (hsafe ⟨ha, hb⟩).elim
        · simp [pairProjection, ha, hb]
        · simp [pairProjection, ha, hb]
        · simp [pairProjection, ha, hb]

/-- Trace equivalence preserves every dependent two-letter projection. -/
theorem pairProjection_eq_of_traceEq {independent : α → α → Prop}
    (hsymm : ∀ x y, independent x y → independent y x) {c d : α}
    (hdep : ¬ independent c d) {u v : List α} (h : TraceEq independent u v) :
    pairProjection c d u = pairProjection c d v := by
  induction h with
  | rel _ _ h => exact pairProjection_eq_of_independentSwap hsymm hdep h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ huv hvw => exact huv.trans hvw

theorem exists_first_cons_of_mem {a : α} {w : List α} (ha : a ∈ w) :
    ∃ u v, w = u ++ a :: v ∧ a ∉ u := by
  induction w with
  | nil => simp at ha
  | cons b w ih =>
      by_cases hba : b = a
      · subst b
        exact ⟨[], w, rfl, by simp⟩
      · have haw : a ∈ w := by simpa [Ne.symm hba] using ha
        obtain ⟨u, v, huv, hau⟩ := ih haw
        exact ⟨b :: u, v, by simp [huv], by simp [Ne.symm hba, hau]⟩

theorem prefix_independent_of_pairProjections {independent : α → α → Prop}
    {a : α} {w u v : List α} (hau : a ∉ u)
    (hproj : ∀ c d, c ≠ d → ¬independent c d →
      pairProjection c d (a :: w) = pairProjection c d (u ++ a :: v)) :
    ∀ b ∈ u, independent a b := by
  intro b hbu
  by_contra hab
  have hba : b ≠ a := fun h => hau (h ▸ hbu)
  have hp := hproj a b (Ne.symm hba) hab
  have hbproj : b ∈ pairProjection a b u := by
    simp [pairProjection, hbu]
  have haproj : a ∉ pairProjection a b u := by
    intro ha
    exact hau (List.mem_of_mem_filter ha)
  have hne : pairProjection a b u ≠ [] := by
    intro he
    have hempty : b ∈ ([] : List α) := he ▸ hbproj
    simp only [List.not_mem_nil] at hempty
  obtain ⟨c, cs, hcs⟩ := List.exists_cons_of_ne_nil hne
  rw [pairProjection_append, hcs] at hp
  simp [pairProjection] at hp
  have hca : c = a := hp.1.symm
  have hcmem : c ∈ pairProjection a b u := by rw [hcs]; simp
  exact haproj (hca ▸ hcmem)

omit [DecidableEq α] in
/-- A letter can be moved to the front across a prefix consisting entirely of letters independent
from it. -/
theorem traceEq_move_front {independent : α → α → Prop} {a : α} {u v : List α}
    (hu : ∀ b ∈ u, independent a b) (hsymm : ∀ x y, independent x y → independent y x) :
    TraceEq independent (u ++ a :: v) (a :: (u ++ v)) := by
  change Relation.EqvGen (IndependentSwap independent) (u ++ a :: v) (a :: (u ++ v))
  induction u with
  | nil => exact Relation.EqvGen.refl _
  | cons b u ih =>
      have hab : independent a b := hu b (by simp)
      have hub : ∀ c ∈ u, independent a c := by
        intro c hc
        exact hu c (by simp [hc])
      have htail := traceEq_cons b (ih hub)
      have hswap : TraceEq independent (b :: a :: (u ++ v)) (a :: b :: (u ++ v)) :=
        Relation.EqvGen.rel _ _
          (IndependentSwap.swap [] (u ++ v) b a (hsymm a b hab))
      simpa only [List.cons_append] using Relation.EqvGen.trans _ _ _ htail hswap

/-- **Dependent-projection completeness.**  Two words represent the same partially commutative
trace exactly when they have the same multiplicities and the same ordered projection on every
dependent pair.  The forward implication is supplied separately by `traceEq_perm` and
`pairProjection_eq_of_traceEq`; this theorem is the difficult reverse implication. -/
theorem traceEq_of_perm_of_pairProjections {independent : α → α → Prop}
    (hsymm : ∀ x y, independent x y → independent y x) {w v : List α}
    (hperm : w.Perm v)
    (hproj : ∀ a b, a ≠ b → ¬independent a b →
      pairProjection a b w = pairProjection a b v) :
    TraceEq independent w v := by
  induction w generalizing v with
  | nil =>
      have hv : v = [] := (List.Perm.nil_eq hperm).symm
      subst v
      exact Relation.EqvGen.refl _
  | cons a w ih =>
      have hav : a ∈ v := hperm.mem_iff.mp (by simp)
      obtain ⟨u, t, hvt, hau⟩ := exists_first_cons_of_mem hav
      subst v
      have hui : ∀ b ∈ u, independent a b :=
        prefix_independent_of_pairProjections hau hproj
      have hmove : TraceEq independent (u ++ a :: t) (a :: (u ++ t)) :=
        traceEq_move_front hui hsymm
      have htailPerm : w.Perm (u ++ t) := by
        exact (hperm.trans (traceEq_perm hmove)).cons_inv
      have htailProj : ∀ c d, c ≠ d → ¬independent c d →
          pairProjection c d w = pairProjection c d (u ++ t) := by
        intro c d hcd hdep
        have horig := hproj c d hcd hdep
        have hmoveProj := pairProjection_eq_of_traceEq hsymm hdep hmove
        have hfull : pairProjection c d (a :: w) =
            pairProjection c d (a :: (u ++ t)) := horig.trans hmoveProj
        by_cases ha : a = c ∨ a = d
        · simpa [pairProjection, ha] using hfull
        · simpa [pairProjection, ha] using hfull
      have htail : TraceEq independent w (u ++ t) := ih htailPerm htailProj
      exact Relation.EqvGen.trans _ _ _ (traceEq_cons a htail)
        (Relation.EqvGen.symm _ _ hmove)

theorem pairProjection_length {a b : α} (hab : a ≠ b) (w : List α) :
    (pairProjection a b w).length = w.count a + w.count b := by
  induction w with
  | nil => simp
  | cons x w ih =>
      simp only [pairProjection] at ih ⊢
      by_cases hxa : x = a
      · subst x
        simp [hab, ih, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
      · by_cases hxb : x = b
        · subst x
          simp [hxa, ih, Nat.add_assoc]
        · simp [hxa, hxb, ih]

/-- Binary encoding of a dependent pair projection. -/
def pairProjectionBits (a b : α) (w : List α) : List Bool :=
  (pairProjection a b w).map fun x => decide (x = b)

theorem pairProjectionBits_length {a b : α} (hab : a ≠ b) (w : List α) :
    (pairProjectionBits a b w).length = w.count a + w.count b := by
  simp [pairProjectionBits, pairProjection_length hab]

theorem decode_pairProjectionBits {a b : α} (hab : a ≠ b) (w : List α) :
    (pairProjectionBits a b w).map (fun z => if z then b else a) =
      pairProjection a b w := by
  rw [pairProjectionBits, List.map_map]
  conv_rhs => rw [← List.map_id (pairProjection a b w)]
  apply List.map_congr_left
  intro x hx
  have hx' : x = a ∨ x = b := by
    have := List.of_mem_filter hx
    simpa [pairProjection] using this
  rcases hx' with rfl | rfl
  · simp [hab]
  · simp

theorem pairProjection_eq_of_bits_eq {a b : α} (hab : a ≠ b) {u v : List α}
    (h : pairProjectionBits a b u = pairProjectionBits a b v) :
    pairProjection a b u = pairProjection a b v := by
  have hdecode := congrArg (List.map fun z : Bool => if z then b else a) h
  simpa only [decode_pairProjectionBits hab] using hdecode

end TraceProjection

section TraceCode

variable {α : Type*} [Fintype α] [LinearOrder α]

/-- Unordered dependent pairs, represented once using the ambient linear order. -/
def DependenceEdge (independent : α → α → Prop) :=
  {e : α × α // e.1 < e.2 ∧ ¬independent e.1 e.2}

noncomputable instance dependenceEdgeFintype (independent : α → α → Prop) :
    Fintype (DependenceEdge independent) :=
  @Fintype.ofFinite _ (Finite.of_injective Subtype.val Subtype.val_injective)

noncomputable instance dependenceEdgeDecidableEq (independent : α → α → Prop) :
    DecidableEq (DependenceEdge independent) := Classical.decEq _

/-- The exact projection code at a fixed multiplicity profile. -/
def TraceProjectionCode (independent : α → α → Prop) (m : Sym α ℓ) :=
  ∀ e : DependenceEdge independent,
    List.Vector Bool
      ((m : Multiset α).count e.1.1 + (m : Multiset α).count e.1.2)

noncomputable instance traceProjectionCodeFintype (independent : α → α → Prop)
    (m : Sym α ℓ) : Fintype (TraceProjectionCode independent m) := by
  unfold TraceProjectionCode
  infer_instance

/-- Multiplicity profile together with every dependent two-letter projection. -/
def TraceCode (independent : α → α → Prop) (ℓ : ℕ) :=
  Σ m : Sym α ℓ, TraceProjectionCode independent m

noncomputable instance traceCodeFintype (independent : α → α → Prop) (ℓ : ℕ) :
    Fintype (TraceCode independent ℓ) := by
  unfold TraceCode
  infer_instance

def wordMultiplicity (w : List.Vector α ℓ) : Sym α ℓ := Sym.ofVector w

def wordEdgeCode (independent : α → α → Prop) (w : List.Vector α ℓ)
    (e : DependenceEdge independent) :
    List.Vector Bool
      (((wordMultiplicity w : Sym α ℓ) : Multiset α).count e.1.1 +
        ((wordMultiplicity w : Sym α ℓ) : Multiset α).count e.1.2) :=
  ⟨pairProjectionBits e.1.1 e.1.2 w.1, by
    simpa only [wordMultiplicity, Sym.ofVector, Sym.toMultiset, Multiset.coe_count] using
      pairProjectionBits_length (ne_of_lt e.2.1) w.1⟩

def wordTraceCode (independent : α → α → Prop) (w : List.Vector α ℓ) :
    TraceCode independent ℓ :=
  ⟨wordMultiplicity w, wordEdgeCode independent w⟩

omit [Fintype α] [LinearOrder α] in
theorem perm_of_wordMultiplicity_eq {w v : List.Vector α ℓ}
    (h : wordMultiplicity w = wordMultiplicity v) : w.1.Perm v.1 := by
  apply Multiset.coe_eq_coe.mp
  exact congrArg Sym.toMultiset h

omit [Fintype α] in
/-- Equality of projection codes implies equality in the trace monoid. -/
theorem traceEq_of_wordTraceCode_eq {independent : α → α → Prop}
    (hsymm : ∀ x y, independent x y → independent y x) {w v : List.Vector α ℓ}
    (hcode : wordTraceCode independent w = wordTraceCode independent v) :
    TraceEq independent w.1 v.1 := by
  have hm : wordMultiplicity w = wordMultiplicity v := congrArg Sigma.fst hcode
  have hperm : w.1.Perm v.1 := perm_of_wordMultiplicity_eq hm
  apply traceEq_of_perm_of_pairProjections hsymm hperm
  intro a b hab hdep
  rcases lt_or_gt_of_ne hab with hablt | hbalt
  · let e : DependenceEdge independent := ⟨(a, b), hablt, hdep⟩
    have hbits := congrArg (fun code : TraceCode independent ℓ => (code.2 e).1) hcode
    apply pairProjection_eq_of_bits_eq hab
    simpa [wordTraceCode, wordEdgeCode, e] using hbits
  · have hdep' : ¬independent b a := by
      intro hba
      exact hdep (hsymm b a hba)
    let e : DependenceEdge independent := ⟨(b, a), hbalt, hdep'⟩
    have hbits := congrArg (fun code : TraceCode independent ℓ => (code.2 e).1) hcode
    have hpair : pairProjection b a w.1 = pairProjection b a v.1 := by
      apply pairProjection_eq_of_bits_eq (ne_of_lt hbalt)
      simpa [wordTraceCode, wordEdgeCode, e] using hbits
    simpa [pairProjection, Bool.or_comm] using hpair

/-- Setoid of fixed-length circuit words modulo adjacent independent exchanges. -/
def fixedTraceSetoid (independent : α → α → Prop) (ℓ : ℕ) : Setoid (List.Vector α ℓ) where
  r w v := TraceEq independent w.1 v.1
  iseqv := by
    change Equivalence (Function.onFun (Relation.EqvGen (IndependentSwap independent)) Subtype.val)
    exact (Relation.EqvGen.is_equivalence _).comap Subtype.val

/-- Trace classes of length `ℓ`. -/
abbrev FixedTraceClass (independent : α → α → Prop) (ℓ : ℕ) :=
  Quotient (fixedTraceSetoid independent ℓ)

/-- Choosing one representative per trace class and encoding it gives an injection into the exact
projection-code space.  No normal-form choice is assumed. -/
noncomputable def fixedTraceCodeEmbedding (independent : α → α → Prop)
    (hsymm : ∀ x y, independent x y → independent y x) (ℓ : ℕ) :
    FixedTraceClass independent ℓ ↪ TraceCode independent ℓ where
  toFun q := wordTraceCode independent q.out
  inj' := by
    intro q r hqr
    apply Quotient.out_equiv_out.mp
    change TraceEq independent q.out.1 r.out.1
    exact traceEq_of_wordTraceCode_eq hsymm hqr

theorem natCard_fixedTraceClass_le_traceCode (independent : α → α → Prop)
    (hsymm : ∀ x y, independent x y → independent y x) (ℓ : ℕ) :
    Nat.card (FixedTraceClass independent ℓ) ≤ Nat.card (TraceCode independent ℓ) :=
  Nat.card_le_card_of_injective _ (fixedTraceCodeEmbedding independent hsymm ℓ).injective

/-- Total binary projection length carried by a multiplicity profile. -/
noncomputable def edgeProjectionMass (independent : α → α → Prop) (m : Sym α ℓ) : ℕ :=
  ∑ e : DependenceEdge independent,
    ((m : Multiset α).count e.1.1 + (m : Multiset α).count e.1.2)

/-- Number of dependence edges incident to one alphabet letter. -/
noncomputable def incidentEdgeCount (independent : α → α → Prop) (a : α) : ℕ :=
  ((Finset.univ : Finset (DependenceEdge independent)).filter fun e =>
    a = e.1.1 ∨ a = e.1.2).card

theorem edgeProjectionMass_eq_sum_incident (independent : α → α → Prop)
    (m : Sym α ℓ) :
    edgeProjectionMass independent m =
      ∑ a : α, (m : Multiset α).count a * incidentEdgeCount independent a := by
  classical
  have hincident (a : α) :
      (m : Multiset α).count a * incidentEdgeCount independent a =
        ∑ e : DependenceEdge independent,
          (if (a = e.1.1 ∨ a = e.1.2) then (m : Multiset α).count a else 0) := by
    unfold incidentEdgeCount
    rw [Finset.card_eq_sum_ones, Finset.mul_sum]
    simp only [Nat.mul_one, Finset.sum_filter]
  rw [edgeProjectionMass]
  simp_rw [hincident]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e _
  have hne : e.1.1 ≠ e.1.2 := ne_of_lt e.2.1
  symm
  calc
    ∑ a : α, (if (a = e.1.1 ∨ a = e.1.2) then (m : Multiset α).count a else 0)
        = ∑ a : α,
            ((if a = e.1.1 then (m : Multiset α).count a else 0) +
              if a = e.1.2 then (m : Multiset α).count a else 0) := by
          apply Finset.sum_congr rfl
          intro a _
          by_cases hal : a = e.1.1 <;> by_cases har : a = e.1.2 <;>
            simp [hal, har, hne, Ne.symm hne]
    _ = (m : Multiset α).count e.1.1 + (m : Multiset α).count e.1.2 := by
      rw [Finset.sum_add_distrib]
      simp

theorem edgeProjectionMass_le_of_maxDegree (independent : α → α → Prop)
    (m : Sym α ℓ) (Δ : ℕ) (hdegree : ∀ a, incidentEdgeCount independent a ≤ Δ) :
    edgeProjectionMass independent m ≤ Δ * ℓ := by
  rw [edgeProjectionMass_eq_sum_incident]
  have hcount : ∑ a : α, (m : Multiset α).count a = ℓ := by
    have h := Multiset.sum_count_eq_card
      (s := (Finset.univ : Finset α)) (m := (m : Multiset α)) (by simp)
    exact h.trans Sym.card_coe
  calc
    ∑ a : α, (m : Multiset α).count a * incidentEdgeCount independent a
        ≤ ∑ a : α, (m : Multiset α).count a * Δ := by
          exact Finset.sum_le_sum fun a _ => Nat.mul_le_mul_left _ (hdegree a)
    _ = (∑ a : α, (m : Multiset α).count a) * Δ := by rw [Finset.sum_mul]
    _ = Δ * ℓ := by rw [hcount, Nat.mul_comm]

theorem natCard_traceProjectionCode (independent : α → α → Prop) (m : Sym α ℓ) :
    Nat.card (TraceProjectionCode independent m) =
      2 ^ edgeProjectionMass independent m := by
  unfold TraceProjectionCode
  rw [Nat.card_pi]
  simp [edgeProjectionMass, Nat.card_eq_fintype_card,
    card_vector, ← Finset.prod_pow_eq_pow_sum]

theorem natCard_traceCode_eq_sum (independent : α → α → Prop) (ℓ : ℕ) :
    Nat.card (TraceCode independent ℓ) =
      ∑ m : Sym α ℓ, 2 ^ edgeProjectionMass independent m := by
  unfold TraceCode
  rw [Nat.card_sigma]
  exact Finset.sum_congr rfl fun m _ => natCard_traceProjectionCode independent m

/-- Exact trace-capacity bound once the dependence graph supplies a uniform edge-mass bound. -/
theorem natCard_fixedTraceClass_le_of_edgeMass (independent : α → α → Prop)
    (hsymm : ∀ x y, independent x y → independent y x) (ℓ Δ : ℕ)
    (hmass : ∀ m : Sym α ℓ, edgeProjectionMass independent m ≤ Δ * ℓ) :
    Nat.card (FixedTraceClass independent ℓ) ≤
      (Fintype.card α + ℓ - 1).choose ℓ * 2 ^ (Δ * ℓ) := by
  calc
    Nat.card (FixedTraceClass independent ℓ)
        ≤ Nat.card (TraceCode independent ℓ) :=
      natCard_fixedTraceClass_le_traceCode independent hsymm ℓ
    _ = ∑ m : Sym α ℓ, 2 ^ edgeProjectionMass independent m := by
      rw [natCard_traceCode_eq_sum]
    _ ≤ ∑ _m : Sym α ℓ, 2 ^ (Δ * ℓ) := by
      exact Finset.sum_le_sum fun m _ => Nat.pow_le_pow_right (by decide) (hmass m)
    _ = Fintype.card (Sym α ℓ) * 2 ^ (Δ * ℓ) := by simp
    _ = (Fintype.card α + ℓ - 1).choose ℓ * 2 ^ (Δ * ℓ) := by
      rw [Sym.card_sym_eq_choose]

/-- **Local-circuit heap capacity law.**  For a finite gate alphabet with maximum dependence
degree `Δ`, the number of length-`ℓ` partially commutative circuit traces is at most

`choose (M + ℓ - 1) ℓ * 2^(Δℓ)`.

This is the exact dimension-linear entropy bound: commuting-gate orderings do not contribute raw
word entropy. -/
theorem natCard_fixedTraceClass_le_maxDegree (independent : α → α → Prop)
    (hsymm : ∀ x y, independent x y → independent y x) (ℓ Δ : ℕ)
    (hdegree : ∀ a, incidentEdgeCount independent a ≤ Δ) :
    Nat.card (FixedTraceClass independent ℓ) ≤
      (Fintype.card α + ℓ - 1).choose ℓ * 2 ^ (Δ * ℓ) := by
  apply natCard_fixedTraceClass_le_of_edgeMass independent hsymm ℓ Δ
  intro m
  exact edgeProjectionMass_le_of_maxDegree independent m Δ hdegree

noncomputable def symPaddingEmbedding [Nonempty α] {ℓ s : ℕ} (hℓs : ℓ ≤ s) :
    Sym α ℓ ↪ Sym α s where
  toFun m := ⟨(m : Multiset α) + Multiset.replicate (s - ℓ) (Classical.choice inferInstance), by
    rw [Multiset.card_add, Multiset.card_replicate, Sym.card_coe, Nat.add_sub_of_le hℓs]⟩
  inj' := by
    intro m n h
    apply Sym.ext
    exact add_right_cancel (congrArg Sym.toMultiset h)

theorem choose_profile_mono [Nonempty α] {ℓ s : ℕ} (hℓs : ℓ ≤ s) :
    (Fintype.card α + ℓ - 1).choose ℓ ≤ (Fintype.card α + s - 1).choose s := by
  rw [← Sym.card_sym_eq_choose (α := α) ℓ, ← Sym.card_sym_eq_choose (α := α) s]
  exact Fintype.card_le_of_injective _ (symPaddingEmbedding hℓs).injective

/-- Number of trace classes of all lengths at most `s`. -/
noncomputable def cumulativeTraceCount (independent : α → α → Prop) (s : ℕ) : ℕ :=
  ∑ ℓ ∈ Finset.range (s + 1), Nat.card (FixedTraceClass independent ℓ)

/-- Cumulative local-circuit heap capacity through depth `s`. -/
theorem cumulativeTraceCount_le_maxDegree [Nonempty α] (independent : α → α → Prop)
    (hsymm : ∀ x y, independent x y → independent y x) (s Δ : ℕ)
    (hdegree : ∀ a, incidentEdgeCount independent a ≤ Δ) :
    cumulativeTraceCount independent s ≤
      (s + 1) * (Fintype.card α + s - 1).choose s * 2 ^ (Δ * s) := by
  unfold cumulativeTraceCount
  calc
    ∑ ℓ ∈ Finset.range (s + 1), Nat.card (FixedTraceClass independent ℓ)
        ≤ ∑ _ℓ ∈ Finset.range (s + 1),
            (Fintype.card α + s - 1).choose s * 2 ^ (Δ * s) := by
          apply Finset.sum_le_sum
          intro ℓ hℓ
          have hℓs : ℓ ≤ s := Nat.le_of_lt_succ (Finset.mem_range.mp hℓ)
          calc
            Nat.card (FixedTraceClass independent ℓ)
                ≤ (Fintype.card α + ℓ - 1).choose ℓ * 2 ^ (Δ * ℓ) :=
              natCard_fixedTraceClass_le_maxDegree independent hsymm ℓ Δ hdegree
            _ ≤ (Fintype.card α + s - 1).choose s * 2 ^ (Δ * s) :=
              Nat.mul_le_mul (choose_profile_mono hℓs)
                (Nat.pow_le_pow_right (by decide) (Nat.mul_le_mul_left Δ hℓs))
    _ = (s + 1) * (Fintype.card α + s - 1).choose s * 2 ^ (Δ * s) := by
      simp [Nat.mul_assoc]

end TraceCode

