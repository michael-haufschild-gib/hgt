import GaloisForLFunctions.RHTower.UniversalPersistentRecurrenceSelectionLaw

/-!
# Quantum recurrence corona

The recurrence corona is the quotient of complete complex histories by
late-time-vanishing differences.  It makes persistence exact: every finite
contraction has the same corona class as its peripheral carrier, and its
class vanishes exactly when peripheral mass vanishes.

At the unrestricted history-space level, every finite observation cylinder
surjects onto the corona.  This last statement is a theorem about histories;
it does not assert that every splice is generated by a physical evolution.
-/

open Filter
open scoped Topology

noncomputable section

namespace RHTower

/-- Histories are recurrence-equivalent when their difference vanishes at late times. -/
def RecurrenceAsymptoticEquivalent (u v : ℕ → ℂ) : Prop :=
  Tendsto (fun n => u n - v n) atTop (𝓝 0)

theorem recurrenceAsymptoticEquivalent_refl (u : ℕ → ℂ) :
    RecurrenceAsymptoticEquivalent u u := by
  simp [RecurrenceAsymptoticEquivalent]

theorem recurrenceAsymptoticEquivalent_symm {u v : ℕ → ℂ}
    (h : RecurrenceAsymptoticEquivalent u v) :
    RecurrenceAsymptoticEquivalent v u := by
  rw [RecurrenceAsymptoticEquivalent] at h ⊢
  convert h.neg using 1
  · funext n
    ring
  · simp

theorem recurrenceAsymptoticEquivalent_trans {u v w : ℕ → ℂ}
    (huv : RecurrenceAsymptoticEquivalent u v)
    (hvw : RecurrenceAsymptoticEquivalent v w) :
    RecurrenceAsymptoticEquivalent u w := by
  rw [RecurrenceAsymptoticEquivalent] at huv hvw ⊢
  have hadd := huv.add hvw
  convert hadd using 1
  · funext n
    ring
  · simp

def recurrenceAsymptoticSetoid : Setoid (ℕ → ℂ) where
  r := RecurrenceAsymptoticEquivalent
  iseqv := ⟨recurrenceAsymptoticEquivalent_refl,
    recurrenceAsymptoticEquivalent_symm,
    recurrenceAsymptoticEquivalent_trans⟩

/-- Complete histories modulo all late-time-vanishing histories. -/
def RecurrenceCorona := Quotient recurrenceAsymptoticSetoid

def recurrenceCoronaClass (u : ℕ → ℂ) : RecurrenceCorona :=
  Quotient.mk recurrenceAsymptoticSetoid u

theorem recurrenceCoronaClass_eq_iff (u v : ℕ → ℂ) :
    recurrenceCoronaClass u = recurrenceCoronaClass v ↔
      RecurrenceAsymptoticEquivalent u v := by
  exact Quotient.eq_iff_equiv

theorem recurrenceCoronaClass_eq_of_eventuallyEq {u v : ℕ → ℂ}
    (h : u =ᶠ[atTop] v) :
    recurrenceCoronaClass u = recurrenceCoronaClass v := by
  rw [recurrenceCoronaClass_eq_iff, RecurrenceAsymptoticEquivalent]
  have hzero : (fun n => u n - v n) =ᶠ[atTop] fun _ => 0 := by
    filter_upwards [h] with n hn
    simp [hn]
  exact tendsto_const_nhds.congr' hzero.symm

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [FiniteDimensional ℂ H]

/-- Every finite contraction has exactly its peripheral carrier in the recurrence corona. -/
theorem finiteContraction_recurrenceCorona_eq_persistentCarrier
    (T : H →L[ℂ] H) (hT : ‖T‖ ≤ 1) (x : H) :
    recurrenceCoronaClass (fun n : ℕ => inner ℂ x ((T ^ n) x)) =
      recurrenceCoronaClass (finiteContractionPersistentReturnCarrier T x) := by
  rw [recurrenceCoronaClass_eq_iff, RecurrenceAsymptoticEquivalent]
  exact finiteContraction_returnAmplitude_sub_persistentCarrier_tendsto_zero T hT x

/-- Zero recurrence-corona class is exactly extinction of peripheral mass. -/
theorem finiteContraction_recurrenceCorona_eq_zero_iff_persistentMass_zero
    (T : H →L[ℂ] H) (hT : ‖T‖ ≤ 1) (x : H) :
    recurrenceCoronaClass (fun n : ℕ => inner ℂ x ((T ^ n) x)) =
        recurrenceCoronaClass (fun _ => 0) ↔
      finiteContractionPersistentMass T x = 0 := by
  rw [recurrenceCoronaClass_eq_iff, RecurrenceAsymptoticEquivalent]
  have hrewrite :
      (fun n : ℕ => inner ℂ x ((T ^ n) x) - 0) =
        (fun n : ℕ => inner ℂ x ((T ^ n) x)) := by
    funext n
    simp
  rw [hrewrite]
  exact finiteContraction_returnAmplitude_tendsto_zero_iff_persistentMass_zero T hT x

/-- A history invisible through horizon `N` but nonzero in the recurrence corona. -/
def postHorizonPersistentHistory (N n : ℕ) : ℂ :=
  if n ≤ N then 0 else 1

theorem postHorizonPersistentHistory_eq_zero_of_le
    (N : ℕ) {n : ℕ} (hn : n ≤ N) :
    postHorizonPersistentHistory N n = 0 := by
  simp [postHorizonPersistentHistory, hn]

theorem tendsto_postHorizonPersistentHistory_one (N : ℕ) :
    Tendsto (postHorizonPersistentHistory N) atTop (𝓝 1) := by
  apply tendsto_const_nhds.congr'
  filter_upwards [Filter.eventually_ge_atTop (N + 1)] with n hn
  simp [postHorizonPersistentHistory]
  omega

theorem recurrenceCoronaClass_postHorizonPersistentHistory_ne_zero (N : ℕ) :
    recurrenceCoronaClass (postHorizonPersistentHistory N) ≠
      recurrenceCoronaClass (fun _ => 0) := by
  intro heq
  have hzero : Tendsto (postHorizonPersistentHistory N) atTop (𝓝 0) := by
    rw [recurrenceCoronaClass_eq_iff,
      RecurrenceAsymptoticEquivalent] at heq
    simpa using heq
  have hone := tendsto_postHorizonPersistentHistory_one N
  have : (0 : ℂ) = 1 := tendsto_nhds_unique hzero hone
  norm_num at this

/-- For every finite horizon, equal observed histories can represent different corona classes. -/
theorem finiteHistory_never_determines_recurrenceCorona (N : ℕ) :
    ∃ u v : ℕ → ℂ,
      (∀ n ≤ N, u n = v n) ∧
        recurrenceCoronaClass u ≠ recurrenceCoronaClass v := by
  refine ⟨postHorizonPersistentHistory N, fun _ => 0, ?_, ?_⟩
  · intro n hn
    exact postHorizonPersistentHistory_eq_zero_of_le N hn
  · exact recurrenceCoronaClass_postHorizonPersistentHistory_ne_zero N

/-- Splice an arbitrary observed prefix to an arbitrary asymptotic tail. -/
def spliceRecurrenceHistory
    (N : ℕ) (observed tail : ℕ → ℂ) (n : ℕ) : ℂ :=
  if n ≤ N then observed n else tail n

theorem spliceRecurrenceHistory_eq_prefix
    (N : ℕ) (observed tail : ℕ → ℂ) {n : ℕ} (hn : n ≤ N) :
    spliceRecurrenceHistory N observed tail n = observed n := by
  simp [spliceRecurrenceHistory, hn]

theorem spliceRecurrenceHistory_eventuallyEq_tail
    (N : ℕ) (observed tail : ℕ → ℂ) :
    spliceRecurrenceHistory N observed tail =ᶠ[atTop] tail := by
  filter_upwards [Filter.eventually_ge_atTop (N + 1)] with n hn
  simp [spliceRecurrenceHistory]
  omega

theorem recurrenceCoronaClass_spliceRecurrenceHistory
    (N : ℕ) (observed tail : ℕ → ℂ) :
    recurrenceCoronaClass (spliceRecurrenceHistory N observed tail) =
      recurrenceCoronaClass tail :=
  recurrenceCoronaClass_eq_of_eventuallyEq
    (spliceRecurrenceHistory_eventuallyEq_tail N observed tail)

/-- After every finite observed prefix, every corona class remains possible in history space. -/
theorem finiteCylinder_surjective_recurrenceCorona
    (N : ℕ) (observed : ℕ → ℂ) (q : RecurrenceCorona) :
    ∃ history : ℕ → ℂ,
      (∀ n ≤ N, history n = observed n) ∧
        recurrenceCoronaClass history = q := by
  obtain ⟨tail, rfl⟩ := Quotient.exists_rep q
  refine ⟨spliceRecurrenceHistory N observed tail, ?_, ?_⟩
  · intro n hn
    exact spliceRecurrenceHistory_eq_prefix N observed tail hn
  · exact recurrenceCoronaClass_spliceRecurrenceHistory N observed tail

end RHTower
