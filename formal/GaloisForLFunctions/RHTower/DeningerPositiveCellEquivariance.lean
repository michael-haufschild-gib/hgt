import GaloisForLFunctions.RHTower.DeningerRankQuotient

/-!
# Equivariance of a relation attachment

An action of a monoid on an algebra which is compatible with the map attaching the relations
descends to the quotient by the ideal those relations generate, and descends uniquely: the
descended operation is the only algebra map on the quotient agreeing with the operation on
representatives.  Uniqueness makes the descent functorial, so every relation among the operations of
the monoid still holds after the attachment.

This is the one-categorical content of the equivariant universal property of a positive-cell
attachment: each element of the monoid is a morphism of the attachment span, so it induces an
endomorphism of the attachment, and the induced endomorphisms compose and preserve the unit because
each is determined by its effect on representatives.

* `deningerCellAction` : **the descended operation.**
* `deningerCellAction_unique` : **it is the only descent.**
* `deningerCellAction_one`, `deningerCellAction_mul` : **the descent is functorial**, so relations
  among the operations persist after the attachment.
-/

namespace RHTower

section Equivariance

variable {R A M G : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module R M]
variable [Monoid G]
variable (j : M →ₗ[R] A) (σ : G → (A →ₐ[R] A)) (τ : G → (M →ₗ[R] M))
variable (hcompat : ∀ (g : G) (m : M), σ g (j m) = j (τ g m))

include hcompat

/-- **The descended operation.**  An operation of the monoid compatible with the relation map sends
the ideal generated by the relations into itself, hence descends to the quotient. -/
def deningerCellAction (g : G) :
    (A ⧸ deningerRankIdeal j) →ₐ[R] (A ⧸ deningerRankIdeal j) :=
  deningerRankQuotient_lift j ((deningerRankQuotientMap j).comp (σ g)) (by
    intro m
    show deningerRankQuotientMap j (σ g (j m)) = 0
    rw [hcompat g m]
    exact deningerRankQuotient_j_eq_zero j (τ g m))

omit [Monoid G] in
@[simp]
theorem deningerCellAction_mk (g : G) (a : A) :
    deningerCellAction j σ τ hcompat g (Ideal.Quotient.mk (deningerRankIdeal j) a)
      = Ideal.Quotient.mk (deningerRankIdeal j) (σ g a) := rfl

omit [Monoid G] in
theorem deningerCellAction_comp (g : G) :
    (deningerCellAction j σ τ hcompat g).comp (deningerRankQuotientMap j)
      = (deningerRankQuotientMap j).comp (σ g) :=
  deningerRankQuotient_lift_comp j _ _

omit [Monoid G] in
/-- **The descent is unique.**  Any algebra map on the quotient agreeing with the operation on
representatives is the descended operation. -/
theorem deningerCellAction_unique (g : G)
    {F : (A ⧸ deningerRankIdeal j) →ₐ[R] (A ⧸ deningerRankIdeal j)}
    (hF : F.comp (deningerRankQuotientMap j) = (deningerRankQuotientMap j).comp (σ g)) :
    F = deningerCellAction j σ τ hcompat g := by
  refine deningerRankQuotient_unique j ?_
  rw [hF, deningerCellAction_comp]

/-- The descent preserves the unit. -/
theorem deningerCellAction_one (hone : σ 1 = AlgHom.id R A) :
    deningerCellAction j σ τ hcompat 1 = AlgHom.id R (A ⧸ deningerRankIdeal j) := by
  refine (deningerCellAction_unique j σ τ hcompat 1 ?_).symm
  rw [hone, AlgHom.comp_id, AlgHom.id_comp]

/-- **The descent is functorial**: composing operations before or after the attachment gives the
same result, so every relation among the operations of the monoid persists after attaching the
relations. -/
theorem deningerCellAction_mul (hmul : ∀ g h : G, σ (g * h) = (σ g).comp (σ h)) (g h : G) :
    deningerCellAction j σ τ hcompat (g * h)
      = (deningerCellAction j σ τ hcompat g).comp (deningerCellAction j σ τ hcompat h) := by
  refine (deningerCellAction_unique j σ τ hcompat (g * h) ?_).symm
  rw [AlgHom.comp_assoc, deningerCellAction_comp, ← AlgHom.comp_assoc,
    deningerCellAction_comp, AlgHom.comp_assoc, hmul]

end Equivariance

end RHTower
