import GaloisForLFunctions.HTGeometry.DifferentialPointedCollisionIncidenceMatroid
import GaloisForLFunctions.HTGeometry.DifferentialPairwiseCommonMode
import GaloisForLFunctions.RHTower.XiTransverseShiftPairwiseValue

/-!
# Collision-quotient incidence rank of arbitrary integral Xi shift families

Repeated shift labels and zero-shift vertices are retained rather than excluded. Pairwise
corrected completed-Xi values represent the incidence matroid of the finite occupied-shift
quotient, with the zero-shift column deleted.
-/

namespace RHTower

open Complex Filter Set
open scoped Differential

noncomputable section

open GaloisForLFunctions
open GaloisForLFunctions.HTGeometry

local instance xiCollisionIncidenceUpperEndDomain : IsDomain upperEndAnalyticSubring :=
  isDomain_upperEndAnalyticSubring

local instance xiCollisionIncidenceUpperEndComplexAlgebra : Algebra ℂ upperEndMeroField :=
  upperEndComplexToMero.toAlgebra

local instance xiCollisionIncidenceUpperEndCharZero : CharZero upperEndMeroField :=
  charZero_of_injective_ringHom upperEndComplexToMero.injective

local instance xiCollisionIncidenceUpperEndDifferential : Differential upperEndMeroField :=
  upperEndMeroFieldDifferential

local instance xiCollisionIncidenceCoordinateDifferential :
    Differential upperEndRationalCoordinateField :=
  derivationClosedDifferential _ upperEndRationalCoordinateField_derivationClosed

local instance xiCollisionIncidenceCoordinateDifferentialAlgebra :
    DifferentialAlgebra upperEndRationalCoordinateField upperEndMeroField where
  deriv_algebraMap c := by
    change (c.1)′ = ((c′ : upperEndRationalCoordinateField) : upperEndMeroField)
    rfl

/-- The corrected Xi values at every occupied nonzero shift label of an arbitrary family are
jointly differentially independent over the rational coordinate field. -/
theorem xiTransverseShiftUpperEndCarrier_pointedOccupiedLabelSupport_differentialIndependent
    {V : Type} (shift : V → ℕ) :
    DifferentialIndependent upperEndRationalCoordinateField
      (fun q : pointedOccupiedLabelSupport shift 0 ↦
        xiTransverseShiftUpperEndCarrier q) := by
  apply xiTransverseShiftUpperEndCarrier_differentialIndependent_of_injective_ne_zero
    (fun q : pointedOccupiedLabelSupport shift 0 ↦ (q : ℕ))
  · exact Subtype.val_injective
  · intro q
    exact q.property.2

/-- The corrected Xi values at the occupied nonzero shift labels are jointly differentially
independent over the rational coordinate field. Repeated original vertices have already been
collapsed by the pointed collision support. -/
theorem xiTransverseShiftUpperEndCarrier_pointedCollisionSupport_differentialIndependent
    {V : Type} [Fintype V] (shift : V → ℕ) :
    DifferentialIndependent upperEndRationalCoordinateField
      (fun q : pointedCollisionIncidenceSupport shift 0 ↦
        xiTransverseShiftUpperEndCarrier q) := by
  apply xiTransverseShiftUpperEndCarrier_differentialIndependent_of_injective_ne_zero
    (fun q : pointedCollisionIncidenceSupport shift 0 ↦ (q : ℕ))
  · exact Subtype.val_injective
  · intro q
    exact (Finset.mem_erase.mp q.property).1

/-- **Exact Xi common-mode classifier.** For every finite inhabited integral shift family,
including repetitions, the complete ordered pairwise corrected-Xi reporter recovers the vertex
differential field over the rational coordinate base exactly when the zero shift occurs. When zero
is absent, the unrecovered common mode is hypertranscendental over the pairwise field. -/
theorem xiTransverseShiftPairDifferenceUpperEndCarrier_complete_differentialAdjoin_eq_vertices_iff_zero_mem_range
    {V : Type} (anchor : V) (shift : V → ℕ) :
    differentialAdjoin upperEndRationalCoordinateField
        (Set.range
          (xiTransverseShiftPairDifferenceUpperEndCarrier shift Prod.snd Prod.fst)) =
      differentialAdjoin upperEndRationalCoordinateField
        (Set.range fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) ↔
      0 ∈ Set.range shift := by
  have hx0 : xiTransverseShiftUpperEndCarrier 0 = 0 :=
    xiTransverseShiftUpperEndCarrier_zero
  have hx :=
    xiTransverseShiftUpperEndCarrier_pointedOccupiedLabelSupport_differentialIndependent shift
  change
    differentialAdjoin upperEndRationalCoordinateField
        (Set.range fun p : V × V ↦
          xiTransverseShiftUpperEndCarrier (shift p.1) -
            xiTransverseShiftUpperEndCarrier (shift p.2)) =
      differentialAdjoin upperEndRationalCoordinateField
        (Set.range fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) ↔
      0 ∈ Set.range shift
  exact differentialAdjoin_range_gradedPairwiseDifferences_eq_iff_loop_mem_range_arbitrary
    (F := upperEndRationalCoordinateField) (K := upperEndMeroField)
    (V := V) (L := ℕ) anchor shift 0
    xiTransverseShiftUpperEndCarrier hx0 hx

/-- **Arbitrary-observation corrected-Xi DA law.** A corrected completed-Xi value is
differentially algebraic over the field generated by any selected subfamily exactly when its
shift is zero or that shift label is already represented in the selected observations. -/
theorem xiTransverseShiftUpperEndCarrier_differentialAlgebraicOver_differentialAdjoin_image_iff_zero_or_observed
    {V : Type*} (shift : V → ℕ) (I : Set V) (anchor : V) :
    DifferentialAlgebraicOver
        (differentialAdjoin upperEndRationalCoordinateField
          ((fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) '' I))
        (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
      shift anchor = 0 ∨ shift anchor ∈ shift '' I := by
  exact
    differentialAlgebraicOver_differentialAdjoin_image_iff_loop_or_observedLabel_of_pointedCollisionMatroid
      (F := upperEndRationalCoordinateField)
      (fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) shift 0 I anchor
      (xiTransverseShiftUpperEndCarrier_differentialMatroid_eq_pointedCollision shift)

/-- **Arbitrary-observation corrected-Xi HT law.** Dually, the marked corrected-Xi value is
hypertranscendental over the selected observation field exactly when its positive shift label is
absent from the selected packet. -/
theorem xiTransverseShiftUpperEndCarrier_hypertranscendentalOver_differentialAdjoin_image_iff_pos_unobserved
    {V : Type*} (shift : V → ℕ) (I : Set V) (anchor : V) :
    HypertranscendentalOver
        (differentialAdjoin upperEndRationalCoordinateField
          ((fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) '' I))
        (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
      shift anchor ≠ 0 ∧ shift anchor ∉ shift '' I := by
  exact
    hypertranscendentalOver_differentialAdjoin_image_iff_nonloop_unobservedLabel_of_pointedCollisionMatroid
      (F := upperEndRationalCoordinateField)
      (fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) shift 0 I anchor
      (xiTransverseShiftUpperEndCarrier_differentialMatroid_eq_pointedCollision shift)

/-- **Complete corrected-Xi circuit classification.** Minimal differential dependencies among an
arbitrary corrected-Xi shift packet are exactly zero-shift singletons and pairs of distinct
indices carrying the same positive shift. No higher minimal relation occurs. -/
theorem xiTransverseShiftUpperEndCarrier_differentialFamilyMatroid_isCircuit_iff
    {V : Type*} (shift : V → ℕ) (C : Set V) :
    (differentialFamilyMatroid
      (F := upperEndRationalCoordinateField)
      (fun v ↦ xiTransverseShiftUpperEndCarrier (shift v))).IsCircuit C ↔
      (∃ i, C = {i} ∧ shift i = 0) ∨
        ∃ i j, i ≠ j ∧ C = {i, j} ∧
          shift i = shift j ∧ shift i ≠ 0 := by
  rw [xiTransverseShiftUpperEndCarrier_differentialMatroid_eq_pointedCollision,
    affinePointedCollisionMatroid_isCircuit_iff]

/-- **Exact relative corrected-Xi HT spectrum.** A corrected completed-Xi shift value is
hypertranscendental over the differential field generated by all other values exactly when its
positive shift label occurs uniquely. Repetitions and zero shifts require no exclusion hypothesis. -/
theorem xiTransverseShiftUpperEndCarrier_hypertranscendentalOver_differentialAdjoin_compl_iff_unique_pos
    {V : Type*} (anchor : V) (shift : V → ℕ) :
    HypertranscendentalOver
        (differentialAdjoin upperEndRationalCoordinateField
          ((fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) ''
            (Set.univ \ {anchor})))
        (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
      shift anchor ≠ 0 ∧ ∀ j, shift j = shift anchor → j = anchor := by
  exact
    hypertranscendentalOver_differentialAdjoin_compl_iff_unique_nonloop_of_pointedCollisionMatroid
      (F := upperEndRationalCoordinateField)
      (fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) shift 0 anchor
      (xiTransverseShiftUpperEndCarrier_differentialMatroid_eq_pointedCollision shift)

/-- A corrected Xi value is DA over all the other family values exactly when its shift is zero or
the same shift occurs at another index. -/
theorem xiTransverseShiftUpperEndCarrier_differentialAlgebraicOver_differentialAdjoin_compl_iff_zero_or_repeated
    {V : Type*} (anchor : V) (shift : V → ℕ) :
    DifferentialAlgebraicOver
        (differentialAdjoin upperEndRationalCoordinateField
          ((fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) ''
            (Set.univ \ {anchor})))
        (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
      shift anchor = 0 ∨ ∃ j, j ≠ anchor ∧ shift j = shift anchor := by
  exact
    differentialAlgebraicOver_differentialAdjoin_compl_iff_loop_or_collision_of_pointedCollisionMatroid
      (F := upperEndRationalCoordinateField)
      (fun v ↦ xiTransverseShiftUpperEndCarrier (shift v)) shift 0 anchor
      (xiTransverseShiftUpperEndCarrier_differentialMatroid_eq_pointedCollision shift)

/-- **Exact corrected-Xi common-mode spectrum.** A corrected completed-Xi value is
hypertranscendental over the differential field generated by all ordered pairwise corrected-Xi
differences exactly when the labelled shift family omits shift zero. Thus the pairwise source-
recovery threshold and the lost differential-transcendental mode are the same unconditional
classification. -/
theorem xiTransverseShiftUpperEndCarrier_hypertranscendentalOver_completePairDifferences_iff_zero_not_mem_range
    {V : Type} (anchor : V) (shift : V → ℕ) :
    HypertranscendentalOver
      (differentialAdjoin upperEndRationalCoordinateField
        (Set.range
          (xiTransverseShiftPairDifferenceUpperEndCarrier shift Prod.snd Prod.fst)))
      (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
      0 ∉ Set.range shift := by
  have hx :=
    xiTransverseShiftUpperEndCarrier_pointedOccupiedLabelSupport_differentialIndependent shift
  change HypertranscendentalOver
    (differentialAdjoin upperEndRationalCoordinateField
      (Set.range fun p : V × V ↦
        xiTransverseShiftUpperEndCarrier (shift p.1) -
          xiTransverseShiftUpperEndCarrier (shift p.2)))
    (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔ 0 ∉ Set.range shift
  exact hypertranscendentalOver_gradedPairwiseDifferences_iff_loop_not_mem_range
    (F := upperEndRationalCoordinateField) (K := upperEndMeroField)
    anchor shift 0 xiTransverseShiftUpperEndCarrier
    xiTransverseShiftUpperEndCarrier_zero hx

/-- **Contracted corrected-Xi common-mode spectrum.** Contracting the complete pairwise corrected
reporter leaves the absolute Xi anchor as a nonloop exactly when shift zero is absent. -/
theorem xiTransverseShiftUpperEndCarrier_contract_completePairDifferences_isNonloop_iff_zero_not_mem_range
    {V : Type} (anchor : V) (shift : V → ℕ) :
    (Matroid.contract
        (differentialMatroid upperEndRationalCoordinateField upperEndMeroField)
        (Set.range
          (xiTransverseShiftPairDifferenceUpperEndCarrier shift Prod.snd Prod.fst))).IsNonloop
      (xiTransverseShiftUpperEndCarrier (shift anchor)) ↔
        0 ∉ Set.range shift := by
  rw [differentialMatroid_contract_isNonloop_iff_hypertranscendentalOver]
  exact
    xiTransverseShiftUpperEndCarrier_hypertranscendentalOver_completePairDifferences_iff_zero_not_mem_range
      anchor shift

/-- **Arbitrary-label Xi incidence law.** For every finite integral shift family, including
repeated and zero shifts, the pairwise corrected completed-Xi reporters represent exactly the
incidence matroid after equal shift labels are collapsed and the zero label is deleted. -/
theorem xiTransverseShiftPairDifferenceUpperEndCarrier_differentialMatroid_eq_pointedCollisionIncidenceMatroid
    {V E : Type} [Fintype V] [Fintype E] [DecidableEq E]
    (shift : V → ℕ) (tail head : E → V) :
    differentialFamilyMatroid
        (F := upperEndRationalCoordinateField)
        (xiTransverseShiftPairDifferenceUpperEndCarrier shift tail head) =
      pointedCollisionIncidenceMatroid
        (C := upperEndRationalCoordinateField) shift 0 tail head := by
  have hx0 : xiTransverseShiftUpperEndCarrier 0 = 0 :=
    xiTransverseShiftUpperEndCarrier_zero
  have hx :=
    xiTransverseShiftUpperEndCarrier_pointedCollisionSupport_differentialIndependent shift
  simpa [xiTransverseShiftPairDifferenceUpperEndCarrier] using
    (differentialFamilyMatroid_gradedPairwiseDifferences_eq_pointedCollisionIncidenceMatroid
      (C := upperEndRationalCoordinateField) shift 0 tail head
      xiTransverseShiftUpperEndCarrier hx0 hx)

/-- Prop interface for every selected packet of an arbitrary-label Xi edge family. -/
theorem xiTransverseShiftPairDifferenceUpperEndCarrier_differentialIndependent_iff_pointedCollisionIncidence
    {V E : Type} [Fintype V] [Fintype E] [DecidableEq E]
    (shift : V → ℕ) (tail head : E → V) (I : Set E) :
    DifferentialIndependent upperEndRationalCoordinateField
        (fun e : I ↦ xiTransverseShiftPairDifferenceUpperEndCarrier shift tail head e) ↔
      (pointedCollisionIncidenceMatroid
        (C := upperEndRationalCoordinateField) shift 0 tail head).Indep I := by
  let y := xiTransverseShiftPairDifferenceUpperEndCarrier shift tail head
  rw [← differentialFamilyMatroid_indep_iff y I,
    xiTransverseShiftPairDifferenceUpperEndCarrier_differentialMatroid_eq_pointedCollisionIncidenceMatroid]

/-- **Arbitrary-label Xi Kirchhoff interface.** A finite pairwise packet is differentially
independent exactly when every coefficient flow conserved at each occupied-shift quotient vertex
is zero. The `none` vertex is the collapsed zero-shift class. -/
theorem xiTransverseShiftPairDifferenceUpperEndCarrier_differentialIndependent_finset_iff_pointedCollisionVertexConservation
    {V E : Type} [Fintype V] [Fintype E] [DecidableEq E]
    (shift : V → ℕ) (tail head : E → V) (I : Finset E) :
    DifferentialIndependent upperEndRationalCoordinateField
        (fun e : ↑(↑I : Set E) ↦
          xiTransverseShiftPairDifferenceUpperEndCarrier shift tail head e) ↔
      ∀ weight : ↑(↑I : Set E) → upperEndRationalCoordinateField,
        (∀ q : pointedCollisionIncidenceVertex shift 0,
          (∑ e : ↑(↑I : Set E),
              if pointedCollisionIncidenceVertexOf shift 0
                (head (e : E)) = q then weight e else 0) =
            ∑ e : ↑(↑I : Set E),
              if pointedCollisionIncidenceVertexOf shift 0
                (tail (e : E)) = q then weight e else 0) →
          ∀ e, weight e = 0 := by
  rw [xiTransverseShiftPairDifferenceUpperEndCarrier_differentialIndependent_iff_pointedCollisionIncidence
      shift tail head (↑I : Set E),
    pointedCollisionIncidenceMatroid_indep_iff_vertex_conservation]

/-- Exact differential rank of every packet after collapsing repeated shift labels. -/
theorem xiTransverseShiftPairDifferenceUpperEndCarrier_pointedCollisionIncidence_eRk
    {V E : Type} [Fintype V] [Fintype E] [DecidableEq E]
    (shift : V → ℕ) (tail head : E → V) (I : Set E) :
    (differentialFamilyMatroid
        (F := upperEndRationalCoordinateField)
        (xiTransverseShiftPairDifferenceUpperEndCarrier shift tail head)).eRk I =
      (pointedCollisionIncidenceMatroid
        (C := upperEndRationalCoordinateField) shift 0 tail head).eRk I := by
  rw [xiTransverseShiftPairDifferenceUpperEndCarrier_differentialMatroid_eq_pointedCollisionIncidenceMatroid]

end

end RHTower
