import GaloisForLFunctions.RHTower.SoninApertureCurvatureTrace
import GaloisForLFunctions.RHTower.SoninProlateCommutatorEnergy

/-!
# Exact Ward transgression of Sonin aperture curvature

For three nested apertures, the two successive lost layers are orthogonal.  The dilation coupling
between them is Hilbert--Schmidt, and symmetrizing that coupling produces a canonical self-adjoint
Ward channel.  Its cutoff commutator energy is exactly twice the lost-layer energy.  Combined with
the negative curvature trace law, this gives an exact transgression identity:

`2 Re Tr(curvature) + WardEnergy = 0`.

Thus aperture curvature has one canonical positive counterterm.  Identifying Suzuki's concrete
Burnol conductor with this channel is a separate source theorem; it is not assumed here.
-/

noncomputable section

set_option maxHeartbeats 1000000

namespace RHTower

open ContinuousLinearMap

/-- Consecutive lost aperture layers are orthogonal. -/
theorem evenSoninApertureLayers_successive_orthogonal
    {a b c : ℝ} (hab : a ≤ b) (hbc : b ≤ c) :
    evenSoninApertureLayer a b * evenSoninApertureLayer b c = 0 ∧
      evenSoninApertureLayer b c * evenSoninApertureLayer a b = 0 := by
  rcases evenCentralSoninProjection_mul_of_le hab with ⟨hba, hab'⟩
  rcases evenCentralSoninProjection_mul_of_le hbc with ⟨hcb, hbc'⟩
  rcases evenCentralSoninProjection_mul_of_le (hab.trans hbc) with ⟨hca, hac'⟩
  have hbb := (evenCentralSoninProjection_mul_of_le (a := b) (b := b) le_rfl).1
  unfold evenSoninApertureLayer
  constructor
  · rw [sub_mul, mul_sub, mul_sub, hab', hac', hbb, hbc', sub_self]
  · rw [sub_mul, mul_sub, mul_sub, hba, hbb, hca, hcb, sub_self, sub_self]
    simp

/-- Canonical self-adjoint channel generated by the transition between two successive lost
aperture layers. -/
def evenSoninApertureSymmetricSuccessiveLayerChannel
    (a b c r : ℝ) (hr : 1 < r) : evenSubspace →L[ℂ] evenSubspace :=
  evenSoninApertureSuccessiveLayerTransition a b c r hr +
    ContinuousLinearMap.adjoint
      (evenSoninApertureSuccessiveLayerTransition a b c r hr)

theorem adjoint_evenSoninApertureSymmetricSuccessiveLayerChannel
    (a b c r : ℝ) (hr : 1 < r) :
    ContinuousLinearMap.adjoint
        (evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr) =
      evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr := by
  unfold evenSoninApertureSymmetricSuccessiveLayerChannel
  rw [ContinuousLinearMap.adjoint.map_add,
    ContinuousLinearMap.adjoint_adjoint]
  abel

/-- The lower cutoff boundary of the symmetric channel is exactly the adjoint successive-layer
transition. -/
theorem crossBoundary_apertureLayer_symmetricSuccessive_eq_adjoint
    {a b c r : ℝ} (hab : a ≤ b) (hbc : b ≤ c) (hr : 1 < r) :
    crossBoundary (evenSoninApertureLayer a b)
        (evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr) =
      ContinuousLinearMap.adjoint
        (evenSoninApertureSuccessiveLayerTransition a b c r hr) := by
  let E := evenSoninApertureLayer a b
  let R := evenSoninApertureLayer b c
  let D := evenDilationSum r hr
  let Z := evenSoninApertureSuccessiveLayerTransition a b c r hr
  have hE2 : E * E = E := by
    simpa only [E] using evenSoninApertureLayer_mul_self hab
  have horth := evenSoninApertureLayers_successive_orthogonal hab hbc
  have hER : E * R = 0 := by simpa only [E, R] using horth.1
  have hRE : R * E = 0 := by simpa only [E, R] using horth.2
  have hEadj : ContinuousLinearMap.adjoint E = E := by
    simpa only [E] using adjoint_evenSoninApertureLayer a b
  have hRadj : ContinuousLinearMap.adjoint R = R := by
    simpa only [R] using adjoint_evenSoninApertureLayer b c
  have hDadj : ContinuousLinearMap.adjoint D = D := by
    simpa only [D] using adjoint_evenDilationSum r hr
  have hZ : Z = E * D * R := by rfl
  have hZadj : ContinuousLinearMap.adjoint Z = R * D * E := by
    rw [hZ]
    change ContinuousLinearMap.adjoint ((E ∘L D) ∘L R) = R * D * E
    rw [ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_comp,
      hEadj, hRadj, hDadj]
    rfl
  have hcompE : (1 - E) * E = 0 := by
    rw [sub_mul, one_mul, hE2, sub_self]
  have hcompR : (1 - E) * R = R := by
    rw [sub_mul, one_mul, hER, sub_zero]
  change crossBoundary E (Z + ContinuousLinearMap.adjoint Z) =
    ContinuousLinearMap.adjoint Z
  rw [hZadj, hZ]
  unfold crossBoundary
  noncomm_ring [hcompE, hcompR, hE2, hER, hRE]
  rw [← mul_assoc E R (D * E), hER, zero_mul]
  module

/-- **Aperture Ward transgression law.**  Twice the real aperture curvature plus the canonical
Ward commutator energy vanishes identically. -/
theorem two_mul_re_opTrace_apertureCurvature_add_WardEnergy_eq_zero
    {a b c r : ℝ} (ha : 0 < a) (hab : a < b) (hbc : b < c)
    (hr : 1 < r) (hcr : c < r * a) :
    2 * (opTrace (evenSoninApertureRestrictionCurvature a b c r hr)).re +
        hsNormSq
          (ccmCommutator
            (evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr)
            (evenSoninApertureLayer a b)) = 0 := by
  let E := evenSoninApertureLayer a b
  let Z := evenSoninApertureSuccessiveLayerTransition a b c r hr
  let X := evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr
  have hE : IsIdempotentElem E := by
    simpa only [E] using! evenSoninApertureLayer_mul_self hab.le
  have hEadj : ContinuousLinearMap.adjoint E = E := by
    simpa only [E] using adjoint_evenSoninApertureLayer a b
  have hXadj : ContinuousLinearMap.adjoint X = X := by
    simpa only [X] using
      adjoint_evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr
  have hZhs : Z.IsHilbertSchmidt := by
    simpa only [Z] using
      evenSoninApertureSuccessiveLayerTransition_isHilbertSchmidt
        ha hab hbc hr hcr
  have hcross : crossBoundary E X = ContinuousLinearMap.adjoint Z := by
    simpa only [E, X, Z] using
      crossBoundary_apertureLayer_symmetricSuccessive_eq_adjoint
        hab.le hbc.le hr
  have hL : (crossBoundary E X).IsHilbertSchmidt := by
    rw [hcross]
    exact hZhs.adjoint
  have hward := hsNormSq_commutator_eq_two_mul_crossBoundary_of_selfAdjoint
    E X hE hEadj hXadj hL
  rw [hcross, hZhs.hsNormSq_adjoint] at hward
  have hcurv :=
    re_opTrace_evenSoninApertureRestrictionCurvature_eq_neg_hsNormSq
      ha hab hbc hr hcr
  change 2 * (opTrace (evenSoninApertureRestrictionCurvature a b c r hr)).re +
      hsNormSq (ccmCommutator X E) = 0
  rw [hward, hcurv]
  ring

/-- The canonical Ward commutator energy is exactly twice the successive-layer transition
energy.  This is the positive form of the aperture transgression law. -/
theorem hsNormSq_apertureWardCommutator_eq_two_mul_successiveLayerTransition
    {a b c r : ℝ} (ha : 0 < a) (hab : a < b) (hbc : b < c)
    (hr : 1 < r) (hcr : c < r * a) :
    hsNormSq
        (ccmCommutator
          (evenSoninApertureSymmetricSuccessiveLayerChannel a b c r hr)
          (evenSoninApertureLayer a b)) =
      2 * hsNormSq
        (evenSoninApertureSuccessiveLayerTransition a b c r hr) := by
  have htrans :=
    two_mul_re_opTrace_apertureCurvature_add_WardEnergy_eq_zero
      ha hab hbc hr hcr
  have hcurv :=
    re_opTrace_evenSoninApertureRestrictionCurvature_eq_neg_hsNormSq
      ha hab hbc hr hcr
  linarith

end RHTower
