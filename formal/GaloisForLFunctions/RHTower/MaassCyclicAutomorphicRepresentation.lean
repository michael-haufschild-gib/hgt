import GaloisForLFunctions.RHTower.MaassCuspAutomorphicCorrespondence
import Mathlib.RepresentationTheory.Subrepresentation

/-!
# Cyclic automorphic representation generated by a Maass cusp eigenform

The analytic correspondence supplies a nonzero spherical vector in the right-regular
representation on `Γ \ SL(2,ℝ)`.  This file takes its group-algebra span and obtains the smallest
algebraic subrepresentation containing it.  The generator and subrepresentation are proved
nonzero, so a bundled Maass cusp eigenform now produces an actual nontrivial cyclic automorphic
representation rather than only an invariant function.

Irreducible decomposition, Hilbert completion, adelization, and local factorization are separate.
-/

namespace GaloisForLFunctions.RHTower

open scoped MonoidAlgebra

noncomputable section

/-- Smallest algebraic subrepresentation containing a vector, via its group-algebra span. -/
def cyclicSubrepresentation {A G V : Type*} [CommSemiring A] [Monoid G]
    [AddCommMonoid V] [Module A V] (ρ : Representation A G V) (v : V) :
    Subrepresentation ρ :=
  Subrepresentation.ofSubmodule' (ρ := ρ)
    (Submodule.span A[G] ({v} : Set ρ.asModule))

/-- The generating vector belongs to its cyclic subrepresentation. -/
theorem mem_cyclicSubrepresentation {A G V : Type*} [CommSemiring A] [Monoid G]
    [AddCommMonoid V] [Module A V] (ρ : Representation A G V) (v : V) :
    v ∈ cyclicSubrepresentation ρ v := by
  change v ∈ Submodule.span A[G] ({v} : Set ρ.asModule)
  exact Submodule.subset_span (Set.mem_singleton v)

/-- Nonzero vectors generate nonzero subrepresentations. -/
theorem cyclicSubrepresentation_ne_bot {A G V : Type*} [CommSemiring A] [Monoid G]
    [AddCommMonoid V] [Module A V] (ρ : Representation A G V) {v : V} (hv : v ≠ 0) :
    cyclicSubrepresentation ρ v ≠ ⊥ := by
  intro hbot
  have hvbot : v ∈ (⊥ : Subrepresentation ρ) := by
    rw [← hbot]
    exact mem_cyclicSubrepresentation ρ v
  change v ∈ (⊥ : Submodule A V) at hvbot
  exact hv (by simpa using hvbot)

/-- Cyclic right-regular automorphic subrepresentation generated by a Maass cusp eigenform. -/
def maassCyclicAutomorphicSubrepresentation (Γ : Subgroup SL2R) (eigenvalue : ℝ)
    (f : MaassCuspEigenform Γ eigenvalue) :
    Subrepresentation (automorphicRightRegularRepresentation Γ) :=
  cyclicSubrepresentation (automorphicRightRegularRepresentation Γ)
    (maassToSphericalAutomorphicCorrespondence Γ f.1).1

/-- The Maass vector, regarded as a vector in its cyclic automorphic subrepresentation. -/
def maassCyclicAutomorphicGenerator (Γ : Subgroup SL2R) (eigenvalue : ℝ)
    (f : MaassCuspEigenform Γ eigenvalue) :
    (maassCyclicAutomorphicSubrepresentation Γ eigenvalue f).toSubmodule :=
  ⟨(maassToSphericalAutomorphicCorrespondence Γ f.1).1,
    mem_cyclicSubrepresentation _ _⟩

/-- The cyclic automorphic generator is nonzero. -/
theorem maassCyclicAutomorphicGenerator_ne_zero (Γ : Subgroup SL2R) (eigenvalue : ℝ)
    (f : MaassCuspEigenform Γ eigenvalue) :
    maassCyclicAutomorphicGenerator Γ eigenvalue f ≠ 0 := by
  intro hzero
  have hval := congr_arg
    (fun F : (maassCyclicAutomorphicSubrepresentation Γ eigenvalue f).toSubmodule ↦
      (F.1 : automorphicFunctionSpace Γ)) hzero
  simp only [maassCyclicAutomorphicGenerator, Submodule.coe_zero] at hval
  have hspherical : maassToSphericalAutomorphicCorrespondence Γ f.1 = 0 := by
    apply Subtype.ext
    exact hval
  have hfzero : f.1 = 0 :=
    (maassToSphericalAutomorphicCorrespondence Γ).map_eq_zero_iff.mp hspherical
  exact f.2.1 hfzero

/-- A Maass cusp eigenform generates a nonzero cyclic automorphic subrepresentation. -/
theorem maassCyclicAutomorphicSubrepresentation_ne_bot
    (Γ : Subgroup SL2R) (eigenvalue : ℝ) (f : MaassCuspEigenform Γ eigenvalue) :
    maassCyclicAutomorphicSubrepresentation Γ eigenvalue f ≠ ⊥ := by
  apply cyclicSubrepresentation_ne_bot
  intro hzero
  have hspherical : maassToSphericalAutomorphicCorrespondence Γ f.1 = 0 := by
    apply Subtype.ext
    exact hzero
  exact f.2.1 ((maassToSphericalAutomorphicCorrespondence Γ).map_eq_zero_iff.mp hspherical)

/-- The actual right-regular representation restricted to the cyclic automorphic subspace. -/
def maassCyclicAutomorphicRepresentation (Γ : Subgroup SL2R) (eigenvalue : ℝ)
    (f : MaassCuspEigenform Γ eigenvalue) :
    Representation ℂ SL2R
      (maassCyclicAutomorphicSubrepresentation Γ eigenvalue f).toSubmodule :=
  (maassCyclicAutomorphicSubrepresentation Γ eigenvalue f).toRepresentation

end
end GaloisForLFunctions.RHTower
