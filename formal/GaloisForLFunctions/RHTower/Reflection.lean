/-
B3 — Real-structure equivariance for the RH tower (rh-monodromy-weight-mismatch lane).

Main results:
* `xi_conj`            : ξ(conj s) = conj (ξ s)  (Schwarz reflection: Dirichlet series on
                         Re s > 1 + identity theorem).
* `analyticOrderAt_conj_conj` : vanishing orders of entire ℂ → ℂ functions are equivariant
                         under w ↦ conj (f (conj w))  (generic, reusable).
* `xi_orderAt_conj`    : ord_{conj ρ}(ξ) = ord_ρ(ξ)   (reality pairing ρ ↔ ρ̄).
* `xi_orderAt_one_sub` : ord_{1−ρ}(ξ) = ord_ρ(ξ)      (FE pairing ρ ↔ 1−ρ).

Lane consequence (07-index-formula.md §3, symmetry slack): the level-k obstruction data is
supported on orbits of the dihedral symmetry generated by s ↦ conj s and s ↦ 1 − s; in Ω
the level-1 obstruction lives on classes separating ρ from its mirror ρ̄.
-/
import GaloisForLFunctions.RHTower.RiemannTower

namespace RHTower

open Complex Filter Set

/-- If `f` is entire then so is its Schwarz reflection `w ↦ conj (f (conj w))`. -/
theorem differentiable_conj_reflect {f : ℂ → ℂ} (hf : Differentiable ℂ f) :
    Differentiable ℂ fun s => (starRingEnd ℂ) (f ((starRingEnd ℂ) s)) := by
  intro z
  have h := (hf ((starRingEnd ℂ) z)).conj_conj
  rw [Complex.conj_conj] at h
  exact h

lemma natCast_cpow_conj (a : ℕ) (s : ℂ) :
    (a : ℂ) ^ ((starRingEnd ℂ) s) = (starRingEnd ℂ) ((a : ℂ) ^ s) := by
  have harg : (a : ℂ).arg ≠ Real.pi := by
    rw [← Complex.ofReal_natCast, Complex.arg_ofReal_of_nonneg (Nat.cast_nonneg a)]
    exact Ne.symm Real.pi_ne_zero
  have h := Complex.cpow_conj (a : ℂ) s harg
  rwa [map_natCast] at h

/-- Conjugation equivariance of ζ on the abscissa of absolute convergence. -/
theorem riemannZeta_conj_of_one_lt {s : ℂ} (hs : 1 < s.re) :
    riemannZeta ((starRingEnd ℂ) s) = (starRingEnd ℂ) (riemannZeta s) := by
  have hs' : 1 < ((starRingEnd ℂ) s).re := by rwa [Complex.conj_re]
  rw [zeta_eq_tsum_one_div_nat_cpow hs', zeta_eq_tsum_one_div_nat_cpow hs]
  have hterm : ∀ n : ℕ, 1 / (n : ℂ) ^ ((starRingEnd ℂ) s)
      = (starRingEnd ℂ) (1 / (n : ℂ) ^ s) := by
    intro n
    rw [map_div₀, map_one, ← natCast_cpow_conj]
  calc (∑' (n : ℕ), 1 / (n : ℂ) ^ ((starRingEnd ℂ) s))
      = ∑' (n : ℕ), (starRingEnd ℂ) (1 / (n : ℂ) ^ s) := by
        exact tsum_congr hterm
    _ = (starRingEnd ℂ) (∑' (n : ℕ), 1 / (n : ℂ) ^ s) := by
        simp only [← RCLike.star_def]
        exact tsum_star.symm

/-- Conjugation equivariance of the archimedean factor Γ_ℝ. -/
theorem Gammaℝ_conj (s : ℂ) :
    Complex.Gammaℝ ((starRingEnd ℂ) s) = (starRingEnd ℂ) (Complex.Gammaℝ s) := by
  rw [Complex.Gammaℝ_def, Complex.Gammaℝ_def, map_mul]
  have hπ : ((Real.pi : ℝ) : ℂ).arg ≠ Real.pi := by
    rw [Complex.arg_ofReal_of_nonneg Real.pi_pos.le]
    exact Ne.symm Real.pi_ne_zero
  congr 1
  · have hx : (Real.pi : ℂ) ^ ((starRingEnd ℂ) (-s / 2))
        = (starRingEnd ℂ) ((Real.pi : ℂ) ^ (-s / 2)) := by
      have h := Complex.cpow_conj (Real.pi : ℂ) (-s / 2) hπ
      rwa [Complex.conj_ofReal] at h
    rw [← hx]
    congr 1
    rw [map_div₀, map_neg, map_ofNat]
  · rw [← Complex.Gamma_conj]
    congr 1
    rw [map_div₀, map_ofNat]

private lemma conj_ne_zero_of_one_lt {s : ℂ} (hs : 1 < s.re) : (starRingEnd ℂ) s ≠ 0 := by
  intro h
  have h2 := congrArg (starRingEnd ℂ) h
  rw [Complex.conj_conj, map_zero] at h2
  rw [h2] at hs
  simp only [Complex.zero_re] at hs
  exact absurd hs (by norm_num)

/-- Conjugation equivariance of Λ on Re s > 1. -/
theorem completedRiemannZeta_conj_of_one_lt {s : ℂ} (hs : 1 < s.re) :
    completedRiemannZeta ((starRingEnd ℂ) s) = (starRingEnd ℂ) (completedRiemannZeta s) := by
  have hs0 : s ≠ 0 := by
    intro h
    rw [h] at hs
    simp only [Complex.zero_re] at hs
    exact absurd hs (by norm_num)
  have hs0' : (starRingEnd ℂ) s ≠ 0 := conj_ne_zero_of_one_lt hs
  have hg : Complex.Gammaℝ s ≠ 0 :=
    Complex.Gammaℝ_ne_zero_of_re_pos (by linarith)
  have hg' : Complex.Gammaℝ ((starRingEnd ℂ) s) ≠ 0 :=
    Complex.Gammaℝ_ne_zero_of_re_pos (by rw [Complex.conj_re]; linarith)
  have hΛ : completedRiemannZeta s = riemannZeta s * Complex.Gammaℝ s := by
    rw [riemannZeta_def_of_ne_zero hs0, div_mul_cancel₀ _ hg]
  have hΛ' : completedRiemannZeta ((starRingEnd ℂ) s)
      = riemannZeta ((starRingEnd ℂ) s) * Complex.Gammaℝ ((starRingEnd ℂ) s) := by
    rw [riemannZeta_def_of_ne_zero hs0', div_mul_cancel₀ _ hg']
  rw [hΛ', hΛ, riemannZeta_conj_of_one_lt hs, Gammaℝ_conj, map_mul]

/-- Conjugation equivariance of Λ₀ on Re s > 1. -/
theorem completedRiemannZeta₀_conj_of_one_lt {s : ℂ} (hs : 1 < s.re) :
    completedRiemannZeta₀ ((starRingEnd ℂ) s) = (starRingEnd ℂ) (completedRiemannZeta₀ s) := by
  have e : completedRiemannZeta₀ s = completedRiemannZeta s + 1 / s + 1 / (1 - s) := by
    rw [completedRiemannZeta_eq s]; ring
  have e' : completedRiemannZeta₀ ((starRingEnd ℂ) s)
      = completedRiemannZeta ((starRingEnd ℂ) s) + 1 / (starRingEnd ℂ) s
        + 1 / (1 - (starRingEnd ℂ) s) := by
    rw [completedRiemannZeta_eq ((starRingEnd ℂ) s)]; ring
  rw [e', e, completedRiemannZeta_conj_of_one_lt hs]
  simp only [map_add, map_div₀, map_one, map_sub]

/-- **Reality of ξ**: ξ commutes with complex conjugation. Proof: on Re s > 1 by the
Dirichlet series and factor-wise equivariance; globally by the identity theorem, since
both sides are entire. -/
theorem xi_conj (s : ℂ) : xi ((starRingEnd ℂ) s) = (starRingEnd ℂ) (xi s) := by
  set g : ℂ → ℂ := fun z => (starRingEnd ℂ) (xi ((starRingEnd ℂ) z)) with hgdef
  have hgd : Differentiable ℂ g := differentiable_conj_reflect xi_differentiable
  have hopen : IsOpen {z : ℂ | 1 < z.re} := isOpen_lt continuous_const Complex.continuous_re
  have h2 : (2 : ℂ) ∈ {z : ℂ | 1 < z.re} := by
    simp only [Set.mem_setOf_eq, Complex.re_ofNat]
    norm_num
  have heq : ∀ z ∈ {z : ℂ | 1 < z.re}, xi z = g z := by
    intro z hz
    have hz' : 1 < z.re := hz
    have hstep : xi ((starRingEnd ℂ) z) = (starRingEnd ℂ) (xi z) := by
      simp only [xi]
      rw [completedRiemannZeta₀_conj_of_one_lt hz']
      simp only [map_add, map_mul, map_div₀, map_sub, map_one, map_ofNat]
    calc xi z = (starRingEnd ℂ) ((starRingEnd ℂ) (xi z)) := (Complex.conj_conj _).symm
      _ = (starRingEnd ℂ) (xi ((starRingEnd ℂ) z)) := by rw [hstep]
      _ = g z := rfl
  have hxa : AnalyticOnNhd ℂ xi Set.univ := xi_analyticOnNhd_univ
  have hga : AnalyticOnNhd ℂ g Set.univ := hgd.differentiableOn.analyticOnNhd isOpen_univ
  have hev : xi =ᶠ[nhds (2 : ℂ)] g :=
    Filter.eventuallyEq_of_mem (hopen.mem_nhds h2) heq
  have hEq : Set.EqOn xi g Set.univ :=
    hxa.eqOn_of_preconnected_of_eventuallyEq hga isPreconnected_univ (Set.mem_univ 2) hev
  have h3 := hEq (Set.mem_univ ((starRingEnd ℂ) s))
  have h4 : g ((starRingEnd ℂ) s) = (starRingEnd ℂ) (xi s) := by
    simp only [hgdef, Complex.conj_conj]
  rw [h3, h4]

/-- Vanishing orders are equivariant under Schwarz reflection, LOCALIZED: only
analyticity at the two mirror points is needed. -/
theorem analyticOrderAt_conj_conj_of_analyticAt {f : ℂ → ℂ} {z : ℂ}
    (hfa : AnalyticAt ℂ f z)
    (hFa : AnalyticAt ℂ (fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w)))
      ((starRingEnd ℂ) z)) :
    analyticOrderAt (fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w))) ((starRingEnd ℂ) z)
      = analyticOrderAt f z := by
  set F : ℂ → ℂ := fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w)) with hFdef
  have hten : Filter.Tendsto (⇑(starRingEnd ℂ)) (nhds ((starRingEnd ℂ) z)) (nhds z) := by
    have h := Complex.continuous_conj.tendsto ((starRingEnd ℂ) z)
    rwa [Complex.conj_conj] at h
  rcases eq_or_ne (analyticOrderAt f z) ⊤ with htop | hne
  · rw [htop, analyticOrderAt_eq_top]
    rw [analyticOrderAt_eq_top] at htop
    filter_upwards [hten.eventually htop] with w hw
    simp only [hFdef, hw, map_zero]
  · set n := (analyticOrderAt f z).toNat with hndef
    have hcoe : (n : ℕ∞) = analyticOrderAt f z := ENat.coe_toNat hne
    obtain ⟨p, hp, hpz, hev⟩ := (hfa.analyticOrderAt_eq_natCast).mp hcoe.symm
    set P : ℂ → ℂ := fun w => (starRingEnd ℂ) (p ((starRingEnd ℂ) w)) with hPdef
    have hPa : AnalyticAt ℂ P ((starRingEnd ℂ) z) := by
      have hpd : ∀ᶠ w in nhds z, DifferentiableAt ℂ p w :=
        hp.eventually_analyticAt.mono fun w hw => hw.differentiableAt
      have hPd : ∀ᶠ w in nhds ((starRingEnd ℂ) z), DifferentiableAt ℂ P w := by
        filter_upwards [hten.eventually hpd] with w hw
        have h := hw.conj_conj
        rw [Complex.conj_conj] at h
        exact h
      exact Complex.analyticAt_of_differentiable_on_punctured_nhds_of_continuousAt
        (hPd.filter_mono nhdsWithin_le_nhds) hPd.self_of_nhds.continuousAt
    have hPz : P ((starRingEnd ℂ) z) ≠ 0 := by
      simp only [hPdef, Complex.conj_conj]
      exact fun h => hpz (by rwa [map_eq_zero] at h)
    have hevF : ∀ᶠ w in nhds ((starRingEnd ℂ) z),
        F w = (w - (starRingEnd ℂ) z) ^ n • P w := by
      filter_upwards [hten.eventually hev] with w hw
      simp only [hFdef, hPdef, smul_eq_mul]
      rw [hw]
      simp only [smul_eq_mul, map_mul, map_pow, map_sub, Complex.conj_conj]
    exact ((hFa.analyticOrderAt_eq_natCast).mpr ⟨P, hPa, hPz, hevF⟩).trans hcoe

/-- Vanishing orders are equivariant under Schwarz reflection (generic, entire case). -/
theorem analyticOrderAt_conj_conj {f : ℂ → ℂ} (hf : Differentiable ℂ f) (z : ℂ) :
    analyticOrderAt (fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w))) ((starRingEnd ℂ) z)
      = analyticOrderAt f z := by
  set F : ℂ → ℂ := fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w)) with hFdef
  exact analyticOrderAt_conj_conj_of_analyticAt
    ((hf.differentiableOn.analyticOnNhd isOpen_univ) z (Set.mem_univ z))
    ((differentiable_conj_reflect hf).differentiableOn.analyticOnNhd isOpen_univ _
      (Set.mem_univ _))

/-- Order equivariance under conjugation for conj-equivariant carriers, from
analyticity at the two mirror points only. -/
theorem analyticOrderAt_conj_of_conjEquivariant {f : ℂ → ℂ} {z : ℂ}
    (hconj : ∀ s, f ((starRingEnd ℂ) s) = (starRingEnd ℂ) (f s))
    (hfa : AnalyticAt ℂ f z) (hfa' : AnalyticAt ℂ f ((starRingEnd ℂ) z)) :
    analyticOrderAt f ((starRingEnd ℂ) z) = analyticOrderAt f z := by
  have hfun : (fun w => (starRingEnd ℂ) (f ((starRingEnd ℂ) w))) = f := by
    funext w
    rw [hconj, Complex.conj_conj]
  have h := analyticOrderAt_conj_conj_of_analyticAt hfa (by rw [hfun]; exact hfa')
  rwa [hfun] at h

/-- **Reality pairing of orders**: ord_{conj ρ}(ξ) = ord_ρ(ξ). -/
theorem xi_orderAt_conj (z : ℂ) :
    analyticOrderAt xi ((starRingEnd ℂ) z) = analyticOrderAt xi z := by
  have hfun : (fun w => (starRingEnd ℂ) (xi ((starRingEnd ℂ) w))) = xi := by
    funext w
    rw [xi_conj, Complex.conj_conj]
  have h := analyticOrderAt_conj_conj xi_differentiable z
  rwa [hfun] at h

/-- Vanishing orders are equivariant under the affine involution w ↦ 1 − w (generic). -/
theorem analyticOrderAt_comp_one_sub {f : ℂ → ℂ} (hf : Differentiable ℂ f) (z : ℂ) :
    analyticOrderAt (fun w => f (1 - w)) (1 - z) = analyticOrderAt f z := by
  set F : ℂ → ℂ := fun w => f (1 - w) with hFdef
  have haff : Differentiable ℂ fun w : ℂ => 1 - w :=
    (differentiable_const (1 : ℂ)).sub differentiable_id
  have hFd : Differentiable ℂ F := by
    have h := hf.comp haff
    simpa [hFdef, Function.comp] using h
  have hfa : AnalyticAt ℂ f z :=
    (hf.differentiableOn.analyticOnNhd isOpen_univ) z (Set.mem_univ z)
  have hFa : AnalyticAt ℂ F (1 - z) :=
    (hFd.differentiableOn.analyticOnNhd isOpen_univ) _ (Set.mem_univ _)
  have hten : Filter.Tendsto (fun w : ℂ => 1 - w) (nhds (1 - z)) (nhds z) := by
    have h := haff.continuous.tendsto (1 - z)
    simpa using h
  rcases eq_or_ne (analyticOrderAt f z) ⊤ with htop | hne
  · rw [htop, analyticOrderAt_eq_top]
    rw [analyticOrderAt_eq_top] at htop
    filter_upwards [hten.eventually htop] with w hw
    simpa [hFdef] using hw
  · set n := (analyticOrderAt f z).toNat with hndef
    have hcoe : (n : ℕ∞) = analyticOrderAt f z := ENat.coe_toNat hne
    obtain ⟨p, hp, hpz, hev⟩ := (hfa.analyticOrderAt_eq_natCast).mp hcoe.symm
    set P : ℂ → ℂ := fun w => (-1 : ℂ) ^ n * p (1 - w) with hPdef
    have hPa : AnalyticAt ℂ P (1 - z) := by
      have haffA : AnalyticAt ℂ (fun w : ℂ => 1 - w) (1 - z) :=
        analyticAt_const.sub analyticAt_id
    -- p is analytic at (1 - (1 - z)) = z; compose, then multiply by the constant
      have hcomp : AnalyticAt ℂ (p ∘ fun w : ℂ => 1 - w) (1 - z) := by
        apply AnalyticAt.comp _ haffA
        simpa using hp
      have hconst : AnalyticAt ℂ (fun _ : ℂ => ((-1 : ℂ)) ^ n) (1 - z) := analyticAt_const
      have h := hconst.mul hcomp
      simpa [hPdef, Function.comp] using h
    have hPz : P (1 - z) ≠ 0 := by
      simp only [hPdef]
      have h1 : (1 : ℂ) - (1 - z) = z := by ring
      rw [h1]
      exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hpz
    have hevF : ∀ᶠ w in nhds (1 - z), F w = (w - (1 - z)) ^ n • P w := by
      filter_upwards [hten.eventually hev] with w hw
      simp only [hFdef, hPdef, smul_eq_mul]
      rw [hw]
      have h2 : (1 - w - z) ^ n = (-1 : ℂ) ^ n * (w - (1 - z)) ^ n := by
        rw [← mul_pow]; ring_nf
      rw [smul_eq_mul, h2]; ring
    exact ((hFa.analyticOrderAt_eq_natCast).mpr ⟨P, hPa, hPz, hevF⟩).trans hcoe

/-- **FE pairing of orders**: ord_{1−ρ}(ξ) = ord_ρ(ξ). -/
theorem xi_orderAt_one_sub (z : ℂ) :
    analyticOrderAt xi (1 - z) = analyticOrderAt xi z := by
  have hfun : (fun w => xi (1 - w)) = xi := by
    funext w
    exact xi_one_sub w
  have h := analyticOrderAt_comp_one_sub xi_differentiable z
  rwa [hfun] at h

end RHTower
