import GaloisForLFunctions.RHTower.PairIdealCensusAlgebra
import GaloisForLFunctions.HTGeometry.SeamSpectrumTranscendence

/-!
# Prime-log transcendental pair-ideal census universality

Distinct prime logarithms form an injective configuration of transcendental seam spectral points.
Specializing the pair-ideal census to that arithmetic configuration identifies the overlap ideal of
two multiplicity profiles, its exact quotient dimension, and the squarefree support dimension.
-/

open Polynomial

namespace GaloisForLFunctions.RHTower

noncomputable section

/-- Complex prime-log spectral points attached to a labelled prime packet. -/
def primeLogSpectralPacket {n : ℕ} (p : Fin n → ℕ) : Fin n → ℂ :=
  fun i => (Real.log (p i) : ℂ)

/-- Distinct primes give distinct prime-log spectral points. -/
theorem primeLogSpectralPacket_injective {n : ℕ}
    (p : Fin n → ℕ) (hp : ∀ i, (p i).Prime) (hpinj : Function.Injective p) :
    Function.Injective (primeLogSpectralPacket p) := by
  intro i j hij
  apply hpinj
  have hlog : Real.log (p i) = Real.log (p j) := by
    exact_mod_cast congrArg Complex.re hij
  have hreal : (p i : ℝ) = (p j : ℝ) := by
    calc
      (p i : ℝ) = Real.exp (Real.log (p i)) :=
        (Real.exp_log (by exact_mod_cast (hp i).pos)).symm
      _ = Real.exp (Real.log (p j)) := by rw [hlog]
      _ = (p j : ℝ) := Real.exp_log (by exact_mod_cast (hp j).pos)
  exact_mod_cast hreal

/-- **Prime-log transcendental pair-ideal census universality law.**  On every finite packet of
distinct primes, all support points are transcendental; the ideal shared by two multiplicity
profiles is generated by the pointwise-minimum divisor; its quotient dimension is the total common
multiplicity; and the radical support quotient counts exactly the labelled primes. -/
theorem primeLog_transcendental_pairIdealCensus_universality
    {n : ℕ} (p : Fin n → ℕ) (hp : ∀ i, (p i).Prime)
    (hpinj : Function.Injective p) (a c : Fin n → ℕ) :
    (∀ i, Transcendental ℚ (Real.log (p i))) ∧
      Ideal.span
          {∏ i, (X - C (primeLogSpectralPacket p i)) ^ a i,
            ∏ i, (X - C (primeLogSpectralPacket p i)) ^ c i} =
        Ideal.span
          {∏ i, (X - C (primeLogSpectralPacket p i)) ^ min (a i) (c i)} ∧
      Module.finrank ℂ
          (Polynomial ℂ ⧸ Ideal.span
            {∏ i, (X - C (primeLogSpectralPacket p i)) ^ a i,
              ∏ i, (X - C (primeLogSpectralPacket p i)) ^ c i}) =
        ∑ i, min (a i) (c i) ∧
      Module.finrank ℂ
          (Polynomial ℂ ⧸ Ideal.span
            {∏ i, (X - C (primeLogSpectralPacket p i))}) = n := by
  have hz := primeLogSpectralPacket_injective p hp hpinj
  refine ⟨fun i => primeLog_transcendental (hp i),
    PairIdealCensusAlgebra.span_pair_prod_linear_pow_eq_span_min
      (primeLogSpectralPacket p) hz a c,
    PairIdealCensusAlgebra.finrank_quotient_span_pair_prod_linear_pow
      (primeLogSpectralPacket p) hz a c, ?_⟩
  simpa using PairIdealCensusAlgebra.finrank_quotient_span_prod_linear
    (primeLogSpectralPacket p)

end

end GaloisForLFunctions.RHTower
