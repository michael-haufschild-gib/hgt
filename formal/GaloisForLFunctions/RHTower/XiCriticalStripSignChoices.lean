import GaloisForLFunctions.RHTower.XiCriticalStripMarkedComponent
import GaloisForLFunctions.RHTower.XiFiniteMarkedFields
import Mathlib.FieldTheory.Extension

/-!
# All compatible sign choices on the analytic marked component

Let `E` be a field over the global meromorphic field `K` in which `ξ` and every factor `F_n` are
squares, for example the quadratic analytic component `B = A(√ξ)` over the critical-strip field
`A`.  The `K`-embeddings of the infinite marked field into `E` are the compatible sign choices:
any two agree up to sign on every marked root, and every `K`-embedding of a finite marked field
`L_T` (a finite component) extends to the whole marked field.  For every such embedding, every
original and every translated source section acquires a half over `E` when `ξ` and all `λ_n` are
squares there.  On `B` this holds for every sign choice.
-/

noncomputable section
namespace RHTower.XiGlobalKummer
open GaloisForLFunctions.HTGeometry
open scoped IntermediateField

local instance : CharZero K := charZero_of_injective_algebraMap constPlane_injective
local instance (priority := high) (F : Type*) [Field F] : DecidableEq F := Classical.decEq F

/-- The infinite marked field is generated by all marked roots. -/
theorem markedExtension_eq_adjoin_roots :
    markedExtension = IntermediateField.adjoin K (Set.range root) := by
  apply le_antisymm
  · rw [← iSup_finiteMarkedExtension]
    refine iSup_le fun T => IntermediateField.adjoin_le_iff.mpr ?_
    rintro _ ⟨n, -, rfl⟩
    exact IntermediateField.subset_adjoin _ _ ⟨n, rfl⟩
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨n, rfl⟩
    exact root_mem_markedField n

/-- Two `K`-embeddings of the marked field differ by a sign on every marked root. -/
theorem markedRoot_embedding_sign {E : Type*} [Field E] [Algebra K E] (φ ψ : Marked →ₐ[K] E)
    (n : ℕ) : φ (markedRoot n) = ψ (markedRoot n) ∨ φ (markedRoot n) = -ψ (markedRoot n) := by
  have hφ := congrArg φ (markedRoot_sq n)
  have hψ := congrArg ψ (markedRoot_sq n)
  rw [map_mul, AlgHom.commutes] at hφ hψ
  have h : (φ (markedRoot n) - ψ (markedRoot n)) * (φ (markedRoot n) + ψ (markedRoot n)) = 0 := by
    linear_combination hφ - hψ
  rcases mul_eq_zero.mp h with h | h
  · exact Or.inl (sub_eq_zero.mp h)
  · exact Or.inr (eq_neg_of_add_eq_zero_left h)

/-- **Finite components extend.**  If every marked radicand is a square in `E`, every
`K`-embedding of a finite marked field into `E` extends to the infinite marked field. -/
theorem exists_marked_extension {E : Type*} [Field E] [Algebra K E]
    (hsq : ∀ n, IsSquare (algebraMap K E (radicand n))) (T : Finset ℕ)
    (χ : finiteMarkedExtension T →ₐ[K] E) :
    ∃ φ : Marked →ₐ[K] E, ∀ x : finiteMarkedExtension T,
      φ (IntermediateField.inclusion (finiteMarkedExtension_le_markedExtension T) x) = χ x := by
  have hK : ∀ s ∈ Set.range root, IsIntegral K s ∧
      ((minpoly K s).map (algebraMap K E)).Splits := by
    rintro _ ⟨n, rfl⟩
    have hint : IsIntegral K (root n) := isIntegral_of_sq_mem_bot (root_sq n)
    refine ⟨hint, ?_⟩
    obtain ⟨r, hr⟩ := hsq n
    have hdvd : minpoly K (root n) ∣ Polynomial.X ^ 2 - Polynomial.C (radicand n) := by
      apply minpoly.dvd
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, pow_two, root_sq, sub_self]
    have hfac : (Polynomial.X ^ 2 - Polynomial.C (radicand n)).map (algebraMap K E) =
        (Polynomial.X - Polynomial.C r) * (Polynomial.X - Polynomial.C (-r)) := by
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, hr,
        map_neg, Polynomial.C_mul]
      ring
    have hspl : ((Polynomial.X ^ 2 - Polynomial.C (radicand n)).map (algebraMap K E)).Splits := by
      rw [hfac]
      exact (Polynomial.Splits.X_sub_C r).mul (Polynomial.Splits.X_sub_C (-r))
    have hne : (Polynomial.X ^ 2 - Polynomial.C (radicand n)).map (algebraMap K E) ≠ 0 := by
      rw [hfac]
      exact mul_ne_zero (Polynomial.X_sub_C_ne_zero r) (Polynomial.X_sub_C_ne_zero (-r))
    exact hspl.of_dvd hne (Polynomial.map_dvd _ hdvd)
  have hL : finiteMarkedExtension T ≤ IntermediateField.adjoin K (Set.range root) := by
    rw [← markedExtension_eq_adjoin_roots]
    exact finiteMarkedExtension_le_markedExtension T
  obtain ⟨φ', hφ'⟩ := IntermediateField.exists_algHom_adjoin_of_splits hK χ hL
  refine ⟨φ'.comp (IntermediateField.inclusion markedExtension_eq_adjoin_roots.le), fun x => ?_⟩
  rw [AlgHom.comp_apply, IntermediateField.inclusion_inclusion, ← AlgHom.comp_apply, hφ']

/-- **Every compatible sign choice halves both sections.**  If `ξ` and every `λ_n` are squares in
`E`, then for every `K`-embedding of the marked field into `E` the original and translated source
sections have halves over `E`. -/
theorem sections_have_halves_of_embedding {E : Type*} [Field E] [Algebra K E]
    (hxi : IsSquare (algebraMap K E xiElement))
    (hlam : ∀ n, IsSquare (algebraMap K E (augmentationElement (n + 2))))
    (φ : Marked →ₐ[K] E) (n : ℕ) :
    letI : Algebra Marked E := φ.toRingHom.toAlgebra
    (∃ R : (sourceCurveOver E n).Point, R + R = sourceSectionOver E n) ∧
      ∃ R : (sourceCurveOver E n).Point, R + R = translatedSectionOver E n := by
  letI : Algebra Marked E := φ.toRingHom.toAlgebra
  have hx : IsSquare (algebraMap Marked E xiMarked) := by
    change IsSquare (φ (algebraMap K Marked xiElement))
    rwa [AlgHom.commutes]
  have hl : IsSquare (algebraMap Marked E (1 + sourceParameter n)) := by
    rw [← augmentationElement_map_eq_sourceLambda]
    change IsSquare (φ (algebraMap K Marked (augmentationElement (n + 2))))
    rw [AlgHom.commutes]
    exact hlam n
  exact ⟨(sourceSectionOver_has_half_iff E n).mpr hx,
    (translatedSectionOver_has_half_iff E n).mpr ⟨hx, hl⟩⟩

/-! ## The analytic quadratic component -/

theorem stripQuadratic_xi_isSquare' : IsSquare (algebraMap K stripQuadraticField xiElement) := by
  rw [IsScalarTower.algebraMap_apply K StripField stripQuadraticField]
  exact stripQuadratic_xi_isSquare

theorem stripQuadratic_augmentation_isSquare (n : ℕ) :
    IsSquare (algebraMap K stripQuadraticField (augmentationElement (n + 2))) := by
  rw [IsScalarTower.algebraMap_apply K StripField stripQuadraticField]
  exact (strip_augmentation_isSquare (by omega)).map _

theorem stripQuadratic_radicand_isSquare (n : ℕ) :
    IsSquare (algebraMap K stripQuadraticField (radicand n)) := by
  rw [radicand, map_mul]
  refine stripQuadratic_xi_isSquare'.mul ?_
  rw [IsScalarTower.algebraMap_apply K StripField stripQuadraticField]
  exact (strip_factor_isSquare (by omega)).map _

/-- On the analytic component every sign choice of the infinite marked field halves every original
and translated section. -/
theorem strip_sections_have_halves (φ : Marked →ₐ[K] stripQuadraticField) (n : ℕ) :
    letI : Algebra Marked stripQuadraticField := φ.toRingHom.toAlgebra
    (∃ R : (sourceCurveOver stripQuadraticField n).Point,
        R + R = sourceSectionOver stripQuadraticField n) ∧
      ∃ R : (sourceCurveOver stripQuadraticField n).Point,
        R + R = translatedSectionOver stripQuadraticField n :=
  sections_have_halves_of_embedding stripQuadratic_xi_isSquare'
    stripQuadratic_augmentation_isSquare φ n

/-- Every finite component sign choice extends to the infinite marked field, where it halves every
section. -/
theorem strip_finite_component_halves (T : Finset ℕ)
    (χ : finiteMarkedExtension T →ₐ[K] stripQuadraticField) :
    ∃ φ : Marked →ₐ[K] stripQuadraticField,
      (∀ x : finiteMarkedExtension T,
        φ (IntermediateField.inclusion (finiteMarkedExtension_le_markedExtension T) x) = χ x) ∧
      ∀ n,
        letI : Algebra Marked stripQuadraticField := φ.toRingHom.toAlgebra
        (∃ R : (sourceCurveOver stripQuadraticField n).Point,
            R + R = sourceSectionOver stripQuadraticField n) ∧
          ∃ R : (sourceCurveOver stripQuadraticField n).Point,
            R + R = translatedSectionOver stripQuadraticField n := by
  obtain ⟨φ, hφ⟩ := exists_marked_extension stripQuadratic_radicand_isSquare T χ
  exact ⟨φ, hφ, strip_sections_have_halves φ⟩

end RHTower.XiGlobalKummer
