import GaloisForLFunctions.RHTower.BakerProof.MinimalRelation

/-!
# The canonical coefficient number field for a reduced Baker relation

All algebraic coefficients of a reduced relation are placed in the single canonical field obtained
by adjoining their finite range to `ℚ`.  A common nonzero integer scale then makes every lifted
coefficient integral over `ℤ`.
-/

open scoped Classical

namespace GaloisForLFunctions.RHTower.BakerProof

/-- The finite extension of `ℚ` inside `ℂ` generated by all coefficients of a reduced relation. -/
abbrev Relation.CoefficientField (R : Relation) : Type :=
  IntermediateField.adjoin ℚ (Set.range R.coeff)

noncomputable instance (R : Relation) : NumberField R.CoefficientField where
  to_charZero := charZero_of_injective_algebraMap (algebraMap ℚ _).injective
  to_finiteDimensional := IntermediateField.finiteDimensional_adjoin fun x hx => by
    obtain ⟨i, rfl⟩ := hx
    exact isAlgebraic_iff_isIntegral.mp
      ((IsFractionRing.isAlgebraic_iff ℤ ℚ ℂ).mp (R.coeff_algebraic i))

/-- The canonical inclusion of the coefficient field into `ℂ`. -/
noncomputable def Relation.coeffEmbedding (R : Relation) : R.CoefficientField →+* ℂ :=
  (IntermediateField.val (IntermediateField.adjoin ℚ (Set.range R.coeff))).toRingHom

/-- A coefficient regarded as an element of the canonical coefficient field. -/
noncomputable def Relation.coeffLift (R : Relation) (i : Fin R.n) : R.CoefficientField :=
  ⟨R.coeff i,
    (IntermediateField.subset_adjoin ℚ (Set.range R.coeff)) (Set.mem_range_self i)⟩

@[simp] theorem Relation.coeffEmbedding_coeffLift (R : Relation) (i : Fin R.n) :
    R.coeffEmbedding (R.coeffLift i) = R.coeff i := rfl

theorem Relation.coeffLift_ne_zero (R : Relation) (i : Fin R.n) : R.coeffLift i ≠ 0 := by
  intro h
  apply R.coeff_ne_zero i
  exact congrArg Subtype.val h

/-- The original logarithmic relation after mapping the lifted coefficients back to `ℂ`. -/
theorem Relation.mapped_vanishes (R : Relation) :
    ∑ i, R.coeffEmbedding (R.coeffLift i) * ((Real.log (R.p i) : ℝ) : ℂ) = 0 := by
  simpa using R.vanishes

/-- One integer denominator clears every coefficient simultaneously, producing algebraic integers
inside the canonical coefficient field. -/
theorem Relation.exists_common_integer_scale (R : Relation) :
    ∃ c : ℤ, c ≠ 0 ∧ ∀ i, IsIntegral ℤ (c • R.coeffLift i) := by
  let s : Finset R.CoefficientField := Finset.univ.image R.coeffLift
  obtain ⟨c, hc, hint⟩ := exists_integral_multiples ℤ ℚ (L := R.CoefficientField) s
  refine ⟨c, hc, fun i => hint (R.coeffLift i) ?_⟩
  exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩

end GaloisForLFunctions.RHTower.BakerProof
