import GaloisForLFunctions.RHTower.Suzuki.SuzukiCausalDepthGammaAdditiveSingularResidueNoGo
import GaloisForLFunctions.RHTower.ConnesConsaniTraceClassReduction

namespace RHTower

open _root_.ContinuousLinearMap Filter
open scoped Topology

noncomputable section

private abbrev GammaH := SuzukiCausalDepthGammaTraceL2
private abbrev GammaOp := GammaH →L[ℂ] GammaH

/-- Finite bounded rational operator circuits generated by constants and arbitrary bounded
two-sided insertions of the actual causal-depth Gamma feature.  The inverse constructor requires
honest bounded inverses on both the source-free and source-present sides. -/
inductive SuzukiCausalDepthGammaRegularRationalAssembly : GammaOp → GammaOp → Prop
  | constant (A : GammaOp) : SuzukiCausalDepthGammaRegularRationalAssembly A A
  | sourceMix (L R : GammaOp) :
      SuzukiCausalDepthGammaRegularRationalAssembly 0
        ((L ∘L suzukiCanonicalCausalDepthGammaFeatureOperator) ∘L R)
  | add {A₀ A₁ B₀ B₁ : GammaOp}
      (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
      (hB : SuzukiCausalDepthGammaRegularRationalAssembly B₀ B₁) :
      SuzukiCausalDepthGammaRegularRationalAssembly (A₀ + B₀) (A₁ + B₁)
  | sub {A₀ A₁ B₀ B₁ : GammaOp}
      (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
      (hB : SuzukiCausalDepthGammaRegularRationalAssembly B₀ B₁) :
      SuzukiCausalDepthGammaRegularRationalAssembly (A₀ - B₀) (A₁ - B₁)
  | comp {A₀ A₁ B₀ B₁ : GammaOp}
      (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
      (hB : SuzukiCausalDepthGammaRegularRationalAssembly B₀ B₁) :
      SuzukiCausalDepthGammaRegularRationalAssembly (A₀ ∘L B₀) (A₁ ∘L B₁)
  | adjoint {A₀ A₁ : GammaOp}
      (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁) :
      SuzukiCausalDepthGammaRegularRationalAssembly
        (ContinuousLinearMap.adjoint A₀) (ContinuousLinearMap.adjoint A₁)
  | inverse {A₀ A₁ A₀inv A₁inv : GammaOp}
      (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
      (hA₀left : A₀inv ∘L A₀ = 1) (hA₀right : A₀ ∘L A₀inv = 1)
      (hA₁left : A₁inv ∘L A₁ = 1) (hA₁right : A₁ ∘L A₁inv = 1) :
      SuzukiCausalDepthGammaRegularRationalAssembly A₀inv A₁inv

/-- Positive classification theorem: every finite bounded rational assembly of the actual nuclear
Gamma feature is congruent to its source-free value modulo trace class. -/
theorem suzukiCausalDepthGammaRegularRationalAssembly_sub_memSchattenClass_one
    {A₀ A₁ : GammaOp}
    (h : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁) :
    MemSchattenClass 1 (A₁ - A₀) := by
  have hcomp : ∀ {A₀ A₁ B₀ B₁ : GammaOp},
      MemSchattenClass 1 (A₁ - A₀) → MemSchattenClass 1 (B₁ - B₀) →
        MemSchattenClass 1 (A₁ ∘L B₁ - A₀ ∘L B₀) := by
    intro A₀ A₁ B₀ B₁ hA hB
    have hid : A₁ ∘L B₁ - A₀ ∘L B₀ =
        (A₁ - A₀) ∘L B₁ + A₀ ∘L (B₁ - B₀) := by
      simp only [← ContinuousLinearMap.mul_def]
      noncomm_ring
    rw [hid]
    exact (memSchattenClass_one_comp_right hA B₁).one_add
      (memSchattenClass_one_comp_left hB A₀)
  have hadjoint : ∀ {A₀ A₁ : GammaOp},
      MemSchattenClass 1 (A₁ - A₀) →
        MemSchattenClass 1
          (ContinuousLinearMap.adjoint A₁ - ContinuousLinearMap.adjoint A₀) := by
    intro A₀ A₁ hA
    have htrace : IsTraceClass (A₁ - A₀) := hA.one_isTraceClass
    have htraceAdj := IsTraceClass.adjoint htrace
    have hmem := IsTraceClass.memSchattenClass_one htraceAdj
    rw [map_sub] at hmem
    exact hmem
  have hinverse : ∀ {A₀ A₁ A₀inv A₁inv : GammaOp},
      MemSchattenClass 1 (A₁ - A₀) →
      A₀ ∘L A₀inv = 1 → A₁inv ∘L A₁ = 1 →
        MemSchattenClass 1 (A₁inv - A₀inv) := by
    intro A₀ A₁ A₀inv A₁inv hA hA₀right hA₁left
    have hneg : MemSchattenClass 1 (A₀ - A₁) := by
      simpa using hA.one_neg
    have hcomp' : MemSchattenClass 1
        ((A₁inv ∘L (A₀ - A₁)) ∘L A₀inv) :=
      memSchattenClass_one_comp_right
        (memSchattenClass_one_comp_left hneg A₁inv) A₀inv
    have hid : A₁inv - A₀inv = (A₁inv ∘L (A₀ - A₁)) ∘L A₀inv := by
      simp only [← ContinuousLinearMap.mul_def] at hA₀right hA₁left ⊢
      noncomm_ring [hA₀right, hA₁left]
    rw [hid]
    exact hcomp'
  induction h with
  | constant A =>
      simpa using memSchattenClass_one_smul
        suzukiCanonicalCausalDepthGammaFeatureOperator_memSchattenClass_one 0
  | sourceMix L R =>
      simpa using memSchattenClass_one_comp_right
        (memSchattenClass_one_comp_left
          suzukiCanonicalCausalDepthGammaFeatureOperator_memSchattenClass_one L) R
  | add hA hB ihA ihB =>
      convert ihA.one_add ihB using 1
      abel
  | sub hA hB ihA ihB =>
      convert ihA.one_sub ihB using 1
      abel
  | comp hA hB ihA ihB =>
      exact hcomp ihA ihB
  | adjoint hA ihA =>
      exact hadjoint ihA
  | inverse hA hA₀left hA₀right hA₁left hA₁right ihA =>
      exact hinverse ihA hA₀right hA₁left

/-- Regular Schur complementation is one instance of the rational assembly grammar. -/
theorem SuzukiCausalDepthGammaRegularRationalAssembly.schur
    {A₀ A₁ B₀ B₁ C₀ C₁ D₀ D₁ D₀inv D₁inv : GammaOp}
    (hA : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
    (hB : SuzukiCausalDepthGammaRegularRationalAssembly B₀ B₁)
    (hC : SuzukiCausalDepthGammaRegularRationalAssembly C₀ C₁)
    (hD : SuzukiCausalDepthGammaRegularRationalAssembly D₀ D₁)
    (hD₀left : D₀inv ∘L D₀ = 1) (hD₀right : D₀ ∘L D₀inv = 1)
    (hD₁left : D₁inv ∘L D₁ = 1) (hD₁right : D₁ ∘L D₁inv = 1) :
    SuzukiCausalDepthGammaRegularRationalAssembly
      (A₀ - (B₀ ∘L D₀inv) ∘L C₀)
      (A₁ - (B₁ ∘L D₁inv) ∘L C₁) :=
  hA.sub ((hB.comp (hD.inverse hD₀left hD₀right hD₁left hD₁right)).comp hC)

/-- Every ordinary logarithmic singular residue is invariant under a regular rational assembly of
the actual causal-depth Gamma feature. -/
theorem hasSchattenLogResidue_one_suzukiCausalDepthGammaRegularRationalAssembly_iff
    {A₀ A₁ : GammaOp}
    (h : SuzukiCausalDepthGammaRegularRationalAssembly A₀ A₁)
    (hA₀cpt : IsCompactOperator A₀) (R : ℝ) :
    HasSchattenLogResidue 1 A₁ R ↔ HasSchattenLogResidue 1 A₀ R := by
  have hdiff :=
    suzukiCausalDepthGammaRegularRationalAssembly_sub_memSchattenClass_one h
  have hdiffcpt : IsCompactOperator (A₁ - A₀) := hdiff.isCompactOperator one_pos
  have hA₁cpt : IsCompactOperator A₁ := by
    have hid : A₁ = A₀ + (A₁ - A₀) := by abel
    rw [hid]
    exact hA₀cpt.add hdiffcpt
  exact hasSchattenLogResidue_one_iff_of_traceClass_sub
    hA₁cpt hA₀cpt hdiff R

/-- A coefficient-faithful regular rational reporter would have to assign different measurable
logarithmic residues to source-free and source-present circuit outputs. -/
structure SuzukiCausalDepthGammaRegularRationalResidueCoefficientFaithful where
  background : GammaOp
  source : GammaOp
  assembly : SuzukiCausalDepthGammaRegularRationalAssembly background source
  background_compact : IsCompactOperator background
  backgroundResidue : ℝ
  sourceResidue : ℝ
  background_residue : HasSchattenLogResidue 1 background backgroundResidue
  source_residue : HasSchattenLogResidue 1 source sourceResidue
  detects_actual_source : sourceResidue ≠ backgroundResidue

/-- **Regular-rational singular-residue CCM--FU no-go.** No finite bounded rational circuit,
including arbitrary products, adjoints, bounded resolvents, and Schur complements, can turn the
actual nuclear Gamma feature into a changed ordinary logarithmic singular residue. -/
theorem no_suzukiCausalDepthGammaRegularRationalResidueCoefficientFaithful :
    ¬ Nonempty SuzukiCausalDepthGammaRegularRationalResidueCoefficientFaithful := by
  rintro ⟨P⟩
  have hsourceOnBackground : HasSchattenLogResidue 1 P.background P.sourceResidue :=
    (hasSchattenLogResidue_one_suzukiCausalDepthGammaRegularRationalAssembly_iff
      P.assembly P.background_compact P.sourceResidue).1 P.source_residue
  have heq : P.sourceResidue = P.backgroundResidue :=
    tendsto_nhds_unique hsourceOnBackground P.background_residue
  exact P.detects_actual_source heq

end

end RHTower
