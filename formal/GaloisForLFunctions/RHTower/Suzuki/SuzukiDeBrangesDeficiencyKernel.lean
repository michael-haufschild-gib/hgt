import GaloisForLFunctions.RHTower.XiHedenmalmDeBrangesSeam

/-!
# The de Branges deficiency kernel of `E = ΞC + i ΞC'`

The de Branges space generated by `E(z) = ξ(1/2 - iz) + ξ'(1/2 - iz)` — in the centered
coordinate `E = ΞC + i ΞC'` — carries the reproducing kernel

`K(w,z) = (E(z)·conj(E(w)) - E♯(z)·conj(E♯(w))) / (2πi(conj w - z))`.

The multiplication operator on that space is symmetric with deficiency indices `(1,1)`, and its
deficiency vectors are `K(∓i,·)`.  This file computes, unconditionally:

* the four values `E(∓i)`, `E♯(∓i)` in terms of `ξ(3/2)` and `ξ'(3/2)`;
* the deficiency-vector norms `K(∓i,∓i) = ξ(3/2)ξ'(3/2)/π`;
* the boundary form of the spectral kernel against the extension vector
  `K(-i,·) + e^{iθ}K(i,·)`, namely

  `(z+i)K(z̄,-i) + e^{-iθ}(z-i)K(z̄,i)
     = -(e^{-iθ/2}/(πi))·(C_θ·E(z) - conj(C_θ)·E♯(z))`,
  `C_θ = ξ(3/2)cos(θ/2) + i ξ'(3/2) sin(θ/2)`;

* the specialization at `θ = π`, where the right-hand side collapses to
  `(2i/π)·ξ'(3/2)·ξ(1/2 - iz)`.

Every statement is an identity between entire functions built from `ξ`; none of them uses the
Riemann Hypothesis, and none of them needs a nonvanishing hypothesis: the two potentially singular
points `z = ∓i` are exactly the points where the corresponding numerator vanishes, so the
identities remain literally true there.
-/

open Complex

noncomputable section

namespace RHTower

/-- `ξ(3/2)`. -/
def suzukiXiThreeHalves : ℂ := xi (3 / 2)

/-- `ξ'(3/2)`. -/
def suzukiXiDerivThreeHalves : ℂ := deriv xi (3 / 2)

/-! ## The centered derivative and the four deficiency values -/

theorem deriv_XiC_eq (z : ℂ) : deriv XiC z = deriv xi (1 / 2 + z * I) * I := by
  have haff : HasDerivAt (fun w : ℂ => 1 / 2 + w * I) I z := by
    simpa using ((hasDerivAt_id z).mul_const I).const_add (1 / 2 : ℂ)
  have hxi : HasDerivAt xi (deriv xi (1 / 2 + z * I)) (1 / 2 + z * I) :=
    (xi_differentiable _).hasDerivAt
  have hcomp : HasDerivAt XiC (deriv xi (1 / 2 + z * I) * I) z := hxi.comp z haff
  exact hcomp.deriv

@[simp]
theorem XiC_neg_I : XiC (-I) = suzukiXiThreeHalves := by
  rw [XiC, suzukiXiThreeHalves]
  norm_num

@[simp]
theorem XiC_I : XiC I = suzukiXiThreeHalves := by
  have h := XiC_even (-I)
  rw [neg_neg] at h
  rw [h, XiC_neg_I]

@[simp]
theorem deriv_XiC_neg_I : deriv XiC (-I) = suzukiXiDerivThreeHalves * I := by
  rw [deriv_XiC_eq, suzukiXiDerivThreeHalves]
  norm_num

@[simp]
theorem deriv_XiC_I : deriv XiC I = -(suzukiXiDerivThreeHalves * I) := by
  have h := deriv_XiC_neg (-I)
  rw [neg_neg] at h
  rw [h, deriv_XiC_neg_I]

theorem suzukiXiThreeHalves_conj :
    (starRingEnd ℂ) suzukiXiThreeHalves = suzukiXiThreeHalves := by
  have h := xi_conj (3 / 2 : ℂ)
  have h32 : (starRingEnd ℂ) (3 / 2 : ℂ) = (3 / 2 : ℂ) :=
    Complex.conj_eq_iff_im.mpr (by norm_num)
  rw [h32] at h
  exact h.symm

theorem suzukiXiDerivThreeHalves_conj :
    (starRingEnd ℂ) suzukiXiDerivThreeHalves = suzukiXiDerivThreeHalves := by
  have h := deriv_XiC_conj (-I)
  rw [show (starRingEnd ℂ) (-I) = I by simp, deriv_XiC_I, deriv_XiC_neg_I, map_mul,
    Complex.conj_I] at h
  have hz : ((starRingEnd ℂ) suzukiXiDerivThreeHalves - suzukiXiDerivThreeHalves) * I = 0 := by
    linear_combination h
  rcases mul_eq_zero.mp hz with h1 | h1
  · linear_combination h1
  · exact absurd h1 Complex.I_ne_zero

/-! ## The four deficiency values of `E` and `E♯` -/

@[simp]
theorem xiHedenmalmDeBrangesE_neg_I :
    xiHedenmalmDeBrangesE (-I) = suzukiXiThreeHalves - suzukiXiDerivThreeHalves := by
  rw [xiHedenmalmDeBrangesE, XiC_neg_I, deriv_XiC_neg_I]
  have : I * (suzukiXiDerivThreeHalves * I) = -suzukiXiDerivThreeHalves := by
    rw [show I * (suzukiXiDerivThreeHalves * I) = suzukiXiDerivThreeHalves * (I * I) by ring,
      Complex.I_mul_I]
    ring
  rw [this]
  ring

@[simp]
theorem xiHedenmalmDeBrangesE_I :
    xiHedenmalmDeBrangesE I = suzukiXiThreeHalves + suzukiXiDerivThreeHalves := by
  rw [xiHedenmalmDeBrangesE, XiC_I, deriv_XiC_I]
  have : I * -(suzukiXiDerivThreeHalves * I) = suzukiXiDerivThreeHalves := by
    rw [show I * -(suzukiXiDerivThreeHalves * I) = -(suzukiXiDerivThreeHalves * (I * I)) by ring,
      Complex.I_mul_I]
    ring
  rw [this]

@[simp]
theorem xiHedenmalmDeBrangesESharp_neg_I :
    xiHedenmalmDeBrangesESharp (-I) = suzukiXiThreeHalves + suzukiXiDerivThreeHalves := by
  rw [xiHedenmalmDeBrangesESharp, XiC_neg_I, deriv_XiC_neg_I]
  have : I * (suzukiXiDerivThreeHalves * I) = -suzukiXiDerivThreeHalves := by
    rw [show I * (suzukiXiDerivThreeHalves * I) = suzukiXiDerivThreeHalves * (I * I) by ring,
      Complex.I_mul_I]
    ring
  rw [this]
  ring

@[simp]
theorem xiHedenmalmDeBrangesESharp_I :
    xiHedenmalmDeBrangesESharp I = suzukiXiThreeHalves - suzukiXiDerivThreeHalves := by
  rw [xiHedenmalmDeBrangesESharp, XiC_I, deriv_XiC_I]
  have : I * -(suzukiXiDerivThreeHalves * I) = suzukiXiDerivThreeHalves := by
    rw [show I * -(suzukiXiDerivThreeHalves * I) = -(suzukiXiDerivThreeHalves * (I * I)) by ring,
      Complex.I_mul_I]
    ring
  rw [this]

/-! ## The reproducing kernel -/

/-- The de Branges reproducing kernel generated by `E = ΞC + i ΞC'`. -/
def suzukiDeBrangesKernel (w z : ℂ) : ℂ :=
  (xiHedenmalmDeBrangesE z * (starRingEnd ℂ) (xiHedenmalmDeBrangesE w)
      - xiHedenmalmDeBrangesESharp z * (starRingEnd ℂ) (xiHedenmalmDeBrangesESharp w))
    / (2 * (Real.pi : ℂ) * I * ((starRingEnd ℂ) w - z))

theorem conj_xiHedenmalmDeBrangesE_conj (z : ℂ) :
    (starRingEnd ℂ) (xiHedenmalmDeBrangesE ((starRingEnd ℂ) z))
      = xiHedenmalmDeBrangesESharp z := by
  rw [xiHedenmalmDeBrangesE, xiHedenmalmDeBrangesESharp, XiC_conj, deriv_XiC_conj]
  simp only [map_add, map_mul, Complex.conj_I, Complex.conj_conj]
  ring

theorem conj_xiHedenmalmDeBrangesESharp_conj (z : ℂ) :
    (starRingEnd ℂ) (xiHedenmalmDeBrangesESharp ((starRingEnd ℂ) z))
      = xiHedenmalmDeBrangesE z := by
  rw [xiHedenmalmDeBrangesE, xiHedenmalmDeBrangesESharp, XiC_conj, deriv_XiC_conj]
  simp only [map_sub, map_mul, Complex.conj_I, Complex.conj_conj]
  ring

/-- The spectral vector `K(z̄,·)` in closed form. -/
theorem suzukiDeBrangesKernel_conj_left (z a : ℂ) :
    suzukiDeBrangesKernel ((starRingEnd ℂ) z) a
      = (xiHedenmalmDeBrangesE a * xiHedenmalmDeBrangesESharp z
          - xiHedenmalmDeBrangesESharp a * xiHedenmalmDeBrangesE z)
        / (2 * (Real.pi : ℂ) * I * (z - a)) := by
  rw [suzukiDeBrangesKernel, conj_xiHedenmalmDeBrangesE_conj,
    conj_xiHedenmalmDeBrangesESharp_conj, Complex.conj_conj]

/-- Cancelling the boundary factor.  At the singular point the numerator vanishes, so no
nonvanishing hypothesis is required. -/
theorem sub_mul_suzukiDeBrangesKernel_conj_left (z a : ℂ) :
    (z - a) * suzukiDeBrangesKernel ((starRingEnd ℂ) z) a
      = (xiHedenmalmDeBrangesE a * xiHedenmalmDeBrangesESharp z
          - xiHedenmalmDeBrangesESharp a * xiHedenmalmDeBrangesE z)
        / (2 * (Real.pi : ℂ) * I) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  rw [suzukiDeBrangesKernel_conj_left]
  rcases eq_or_ne z a with h | h
  · subst h
    rw [sub_self, zero_mul,
      show xiHedenmalmDeBrangesE z * xiHedenmalmDeBrangesESharp z
        - xiHedenmalmDeBrangesESharp z * xiHedenmalmDeBrangesE z = 0 from by ring, zero_div]
  · have hza : z - a ≠ 0 := sub_ne_zero.mpr h
    field_simp

/-! ## Norms of the deficiency vectors -/

theorem suzukiDeBrangesKernel_neg_I_self :
    suzukiDeBrangesKernel (-I) (-I)
      = suzukiXiThreeHalves * suzukiXiDerivThreeHalves / (Real.pi : ℂ) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  rw [suzukiDeBrangesKernel, xiHedenmalmDeBrangesE_neg_I, xiHedenmalmDeBrangesESharp_neg_I,
    show (starRingEnd ℂ) (-I) = I by simp, map_sub, map_add,
    suzukiXiThreeHalves_conj, suzukiXiDerivThreeHalves_conj]
  have hden : 2 * (Real.pi : ℂ) * I * (I - -I) = -(4 * (Real.pi : ℂ)) := by
    have : (I : ℂ) - -I = 2 * I := by ring
    rw [this]
    have : 2 * (Real.pi : ℂ) * I * (2 * I) = 4 * (Real.pi : ℂ) * (I * I) := by ring
    rw [this, Complex.I_mul_I]
    ring
  rw [hden]
  field_simp
  ring

theorem suzukiDeBrangesKernel_I_self :
    suzukiDeBrangesKernel I I
      = suzukiXiThreeHalves * suzukiXiDerivThreeHalves / (Real.pi : ℂ) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  rw [suzukiDeBrangesKernel, xiHedenmalmDeBrangesE_I, xiHedenmalmDeBrangesESharp_I,
    show (starRingEnd ℂ) (I : ℂ) = -I by simp, map_add, map_sub,
    suzukiXiThreeHalves_conj, suzukiXiDerivThreeHalves_conj]
  have hden : 2 * (Real.pi : ℂ) * I * (-I - I) = 4 * (Real.pi : ℂ) := by
    have : (-I : ℂ) - I = -(2 * I) := by ring
    rw [this]
    have : 2 * (Real.pi : ℂ) * I * -(2 * I) = -(4 * (Real.pi : ℂ) * (I * I)) := by ring
    rw [this, Complex.I_mul_I]
    ring
  rw [hden]
  field_simp
  ring


/-! ## The boundary form of the spectral vector against the extension vector -/

/-- The half-angle phase `e^{-iθ/2}`. -/
def suzukiHalfPhase (θ : ℝ) : ℂ := Complex.exp (-(((θ / 2 : ℝ) : ℂ) * I))

theorem suzukiHalfPhase_sq (θ : ℝ) :
    suzukiHalfPhase θ ^ (2 : ℕ) = Complex.exp (-((θ : ℂ) * I)) := by
  rw [suzukiHalfPhase, sq, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem suzukiHalfPhase_cos (θ : ℝ) :
    suzukiHalfPhase θ * (2 * ((Real.cos (θ / 2) : ℝ) : ℂ)) = 1 + suzukiHalfPhase θ ^ (2 : ℕ) := by
  have hc : ((Real.cos (θ / 2) : ℝ) : ℂ) = Complex.cos (((θ / 2 : ℝ) : ℂ)) :=
    Complex.ofReal_cos _
  set c : ℂ := ((θ / 2 : ℝ) : ℂ) with hcdef
  have h2 : Complex.exp (-(c * I)) + Complex.exp (c * I) = 2 * Complex.cos c := by
    rw [show -(c * I) = (-c) * I by ring, Complex.exp_mul_I, Complex.exp_mul_I,
      Complex.cos_neg, Complex.sin_neg]
    ring
  rw [suzukiHalfPhase, ← hcdef, hc, ← h2, mul_add, ← Complex.exp_add, ← Complex.exp_add, sq,
    ← Complex.exp_add]
  rw [show -(c * I) + c * I = 0 by ring, Complex.exp_zero]
  ring

theorem suzukiHalfPhase_sin (θ : ℝ) :
    suzukiHalfPhase θ * (-2 * I * ((Real.sin (θ / 2) : ℝ) : ℂ))
      = suzukiHalfPhase θ ^ (2 : ℕ) - 1 := by
  have hs : ((Real.sin (θ / 2) : ℝ) : ℂ) = Complex.sin (((θ / 2 : ℝ) : ℂ)) :=
    Complex.ofReal_sin _
  set c : ℂ := ((θ / 2 : ℝ) : ℂ) with hcdef
  have h2 : Complex.exp (-(c * I)) - Complex.exp (c * I) = -2 * I * Complex.sin c := by
    rw [show -(c * I) = (-c) * I by ring, Complex.exp_mul_I, Complex.exp_mul_I,
      Complex.cos_neg, Complex.sin_neg]
    ring
  rw [suzukiHalfPhase, ← hcdef, hs, ← h2, mul_sub, ← Complex.exp_add, ← Complex.exp_add, sq,
    ← Complex.exp_add]
  rw [show -(c * I) + c * I = 0 by ring, Complex.exp_zero]

/-- Suzuki's coefficient `C_θ = ξ(3/2)cos(θ/2) + i ξ'(3/2) sin(θ/2)`. -/
def suzukiDeBrangesCTheta (θ : ℝ) : ℂ :=
  suzukiXiThreeHalves * ((Real.cos (θ / 2) : ℝ) : ℂ)
    + I * suzukiXiDerivThreeHalves * ((Real.sin (θ / 2) : ℝ) : ℂ)

theorem suzukiDeBrangesCTheta_conj (θ : ℝ) :
    (starRingEnd ℂ) (suzukiDeBrangesCTheta θ)
      = suzukiXiThreeHalves * ((Real.cos (θ / 2) : ℝ) : ℂ)
        - I * suzukiXiDerivThreeHalves * ((Real.sin (θ / 2) : ℝ) : ℂ) := by
  rw [suzukiDeBrangesCTheta, map_add, map_mul, map_mul, map_mul, Complex.conj_I,
    Complex.conj_ofReal, Complex.conj_ofReal, suzukiXiThreeHalves_conj,
    suzukiXiDerivThreeHalves_conj]
  ring

theorem suzukiDeBranges_plus_combination (θ : ℝ) :
    (suzukiXiThreeHalves - suzukiXiDerivThreeHalves)
        + suzukiHalfPhase θ ^ (2 : ℕ) * (suzukiXiThreeHalves + suzukiXiDerivThreeHalves)
      = 2 * suzukiHalfPhase θ * (starRingEnd ℂ) (suzukiDeBrangesCTheta θ) := by
  rw [suzukiDeBrangesCTheta_conj]
  linear_combination (-suzukiXiThreeHalves) * suzukiHalfPhase_cos θ
    + (-suzukiXiDerivThreeHalves) * suzukiHalfPhase_sin θ

theorem suzukiDeBranges_minus_combination (θ : ℝ) :
    (suzukiXiThreeHalves + suzukiXiDerivThreeHalves)
        + suzukiHalfPhase θ ^ (2 : ℕ) * (suzukiXiThreeHalves - suzukiXiDerivThreeHalves)
      = 2 * suzukiHalfPhase θ * suzukiDeBrangesCTheta θ := by
  rw [suzukiDeBrangesCTheta]
  linear_combination (-suzukiXiThreeHalves) * suzukiHalfPhase_cos θ
    + suzukiXiDerivThreeHalves * suzukiHalfPhase_sin θ

/-- **The de Branges boundary form.**  For every real `θ` and every `z ∈ ℂ`,

`(z+i)K(z̄,-i) + e^{-iθ}(z-i)K(z̄,i) = -(e^{-iθ/2}/(πi))·(C_θ E(z) - conj(C_θ) E♯(z))`.

No nonvanishing hypothesis is needed: at `z = ∓i` the corresponding kernel numerator vanishes. -/
theorem suzukiDeBrangesBoundaryForm (θ : ℝ) (z : ℂ) :
    (z + I) * suzukiDeBrangesKernel ((starRingEnd ℂ) z) (-I)
        + Complex.exp (-((θ : ℂ) * I)) *
            ((z - I) * suzukiDeBrangesKernel ((starRingEnd ℂ) z) I)
      = -(suzukiHalfPhase θ / ((Real.pi : ℂ) * I))
          * (suzukiDeBrangesCTheta θ * xiHedenmalmDeBrangesE z
              - (starRingEnd ℂ) (suzukiDeBrangesCTheta θ) * xiHedenmalmDeBrangesESharp z) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hzI : z + I = z - (-I) := by ring
  rw [hzI, sub_mul_suzukiDeBrangesKernel_conj_left, sub_mul_suzukiDeBrangesKernel_conj_left,
    xiHedenmalmDeBrangesE_neg_I, xiHedenmalmDeBrangesESharp_neg_I, xiHedenmalmDeBrangesE_I,
    xiHedenmalmDeBrangesESharp_I, ← suzukiHalfPhase_sq]
  set Ee : ℂ := xiHedenmalmDeBrangesE z with hEe
  set Es : ℂ := xiHedenmalmDeBrangesESharp z with hEs
  set w : ℂ := suzukiHalfPhase θ with hw
  set p : ℂ := suzukiXiThreeHalves with hp
  set q : ℂ := suzukiXiDerivThreeHalves with hq
  have hplus := suzukiDeBranges_plus_combination θ
  have hminus := suzukiDeBranges_minus_combination θ
  rw [← hw, ← hp, ← hq] at hplus hminus
  have hcombine :
      ((p - q) * Es - (p + q) * Ee) / (2 * (Real.pi : ℂ) * I)
          + w ^ (2 : ℕ) * (((p + q) * Es - (p - q) * Ee) / (2 * (Real.pi : ℂ) * I))
        = (((p - q) + w ^ (2 : ℕ) * (p + q)) * Es - ((p + q) + w ^ (2 : ℕ) * (p - q)) * Ee)
            / (2 * (Real.pi : ℂ) * I) := by
    field_simp
    ring
  rw [hcombine, hplus, hminus]
  field_simp
  ring

/-- **The `θ = π` specialization.**  The boundary form collapses to a multiple of
`ξ(1/2 - iz) = ΞC(z)`. -/
theorem suzukiDeBrangesBoundaryForm_pi (z : ℂ) :
    (z + I) * suzukiDeBrangesKernel ((starRingEnd ℂ) z) (-I)
        + Complex.exp (-((Real.pi : ℂ) * I)) *
            ((z - I) * suzukiDeBrangesKernel ((starRingEnd ℂ) z) I)
      = 2 * I / (Real.pi : ℂ) * suzukiXiDerivThreeHalves * XiC z := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have h := suzukiDeBrangesBoundaryForm Real.pi z
  have hc : ((Real.cos (Real.pi / 2) : ℝ) : ℂ) = 0 := by
    rw [Real.cos_pi_div_two]; simp
  have hs : ((Real.sin (Real.pi / 2) : ℝ) : ℂ) = 1 := by
    rw [Real.sin_pi_div_two]; simp
  have hC : suzukiDeBrangesCTheta Real.pi = I * suzukiXiDerivThreeHalves := by
    rw [suzukiDeBrangesCTheta, hc, hs]
    ring
  have hCconj : (starRingEnd ℂ) (suzukiDeBrangesCTheta Real.pi)
      = -(I * suzukiXiDerivThreeHalves) := by
    rw [suzukiDeBrangesCTheta_conj, hc, hs]
    ring
  have hw : suzukiHalfPhase Real.pi = -I := by
    rw [suzukiHalfPhase]
    rw [show -(((Real.pi / 2 : ℝ) : ℂ) * I) = (-((Real.pi / 2 : ℝ) : ℂ)) * I by ring,
      Complex.exp_mul_I]
    have h1 : Complex.cos (-((Real.pi / 2 : ℝ) : ℂ)) = 0 := by
      rw [Complex.cos_neg, ← Complex.ofReal_cos, Real.cos_pi_div_two]
      simp
    have h2 : Complex.sin (-((Real.pi / 2 : ℝ) : ℂ)) = -1 := by
      rw [Complex.sin_neg, ← Complex.ofReal_sin, Real.sin_pi_div_two]
      simp
    rw [h1, h2]
    ring
  rw [h, hCconj, hC, hw, xiHedenmalmDeBrangesE, xiHedenmalmDeBrangesESharp]
  field_simp
  ring


/-! ## The spectral functions `f̂_z = K(z̄,·)/E` -/

/-- The positive half-angle phase `e^{iθ/2}`. -/
def suzukiHalfPhasePos (θ : ℝ) : ℂ := Complex.exp (((θ / 2 : ℝ) : ℂ) * I)

theorem suzukiHalfPhasePos_sq (θ : ℝ) :
    suzukiHalfPhasePos θ ^ (2 : ℕ) = Complex.exp ((θ : ℂ) * I) := by
  rw [suzukiHalfPhasePos, sq, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem suzukiHalfPhasePos_cos (θ : ℝ) :
    suzukiHalfPhasePos θ * (2 * ((Real.cos (θ / 2) : ℝ) : ℂ))
      = 1 + suzukiHalfPhasePos θ ^ (2 : ℕ) := by
  have hc : ((Real.cos (θ / 2) : ℝ) : ℂ) = Complex.cos (((θ / 2 : ℝ) : ℂ)) :=
    Complex.ofReal_cos _
  set c : ℂ := ((θ / 2 : ℝ) : ℂ) with hcdef
  have h2 : Complex.exp (c * I) + Complex.exp (-(c * I)) = 2 * Complex.cos c := by
    rw [show -(c * I) = (-c) * I by ring, Complex.exp_mul_I, Complex.exp_mul_I,
      Complex.cos_neg, Complex.sin_neg]
    ring
  rw [suzukiHalfPhasePos, ← hcdef, hc, ← h2, mul_add, ← Complex.exp_add, ← Complex.exp_add, sq,
    ← Complex.exp_add]
  rw [show c * I + -(c * I) = 0 by ring, Complex.exp_zero]
  ring

theorem suzukiHalfPhasePos_sin (θ : ℝ) :
    suzukiHalfPhasePos θ * (2 * I * ((Real.sin (θ / 2) : ℝ) : ℂ))
      = suzukiHalfPhasePos θ ^ (2 : ℕ) - 1 := by
  have hs : ((Real.sin (θ / 2) : ℝ) : ℂ) = Complex.sin (((θ / 2 : ℝ) : ℂ)) :=
    Complex.ofReal_sin _
  set c : ℂ := ((θ / 2 : ℝ) : ℂ) with hcdef
  have h2 : Complex.exp (c * I) - Complex.exp (-(c * I)) = 2 * I * Complex.sin c := by
    rw [show -(c * I) = (-c) * I by ring, Complex.exp_mul_I, Complex.exp_mul_I,
      Complex.cos_neg, Complex.sin_neg]
    ring
  rw [suzukiHalfPhasePos, ← hcdef, hs, ← h2, mul_sub, ← Complex.exp_add, ← Complex.exp_add, sq,
    ← Complex.exp_add]
  rw [show c * I + -(c * I) = 0 by ring, Complex.exp_zero]

theorem suzukiDeBrangesPos_plus_combination (θ : ℝ) :
    (suzukiXiThreeHalves - suzukiXiDerivThreeHalves)
        + suzukiHalfPhasePos θ ^ (2 : ℕ) * (suzukiXiThreeHalves + suzukiXiDerivThreeHalves)
      = 2 * suzukiHalfPhasePos θ * suzukiDeBrangesCTheta θ := by
  rw [suzukiDeBrangesCTheta]
  linear_combination (-suzukiXiThreeHalves) * suzukiHalfPhasePos_cos θ
    + (-suzukiXiDerivThreeHalves) * suzukiHalfPhasePos_sin θ

theorem suzukiDeBrangesPos_minus_combination (θ : ℝ) :
    (suzukiXiThreeHalves + suzukiXiDerivThreeHalves)
        + suzukiHalfPhasePos θ ^ (2 : ℕ) * (suzukiXiThreeHalves - suzukiXiDerivThreeHalves)
      = 2 * suzukiHalfPhasePos θ * (starRingEnd ℂ) (suzukiDeBrangesCTheta θ) := by
  rw [suzukiDeBrangesCTheta_conj]
  linear_combination (-suzukiXiThreeHalves) * suzukiHalfPhasePos_cos θ
    + suzukiXiDerivThreeHalves * suzukiHalfPhasePos_sin θ

theorem suzukiDeBrangesKernel_neg_I_apply (z : ℂ) :
    suzukiDeBrangesKernel (-I) z
      = (xiHedenmalmDeBrangesE z * (suzukiXiThreeHalves - suzukiXiDerivThreeHalves)
          - xiHedenmalmDeBrangesESharp z * (suzukiXiThreeHalves + suzukiXiDerivThreeHalves))
        / (2 * (Real.pi : ℂ) * I * (I - z)) := by
  rw [suzukiDeBrangesKernel, xiHedenmalmDeBrangesE_neg_I, xiHedenmalmDeBrangesESharp_neg_I,
    map_sub, map_add, suzukiXiThreeHalves_conj, suzukiXiDerivThreeHalves_conj,
    show (starRingEnd ℂ) (-I) = I by simp]

theorem suzukiDeBrangesKernel_I_apply (z : ℂ) :
    suzukiDeBrangesKernel I z
      = (xiHedenmalmDeBrangesE z * (suzukiXiThreeHalves + suzukiXiDerivThreeHalves)
          - xiHedenmalmDeBrangesESharp z * (suzukiXiThreeHalves - suzukiXiDerivThreeHalves))
        / (2 * (Real.pi : ℂ) * I * (-I - z)) := by
  rw [suzukiDeBrangesKernel, xiHedenmalmDeBrangesE_I, xiHedenmalmDeBrangesESharp_I,
    map_add, map_sub, suzukiXiThreeHalves_conj, suzukiXiDerivThreeHalves_conj,
    show (starRingEnd ℂ) (I : ℂ) = -I by simp]

/-- The de Branges spectral function `f̂_w = K(w̄,·)/E`. -/
def suzukiDeBrangesSpectralFn (w t : ℂ) : ℂ :=
  suzukiDeBrangesKernel ((starRingEnd ℂ) w) t / xiHedenmalmDeBrangesE t

/-- **The spectral relation behind Suzuki's limit formula.**  Off the two deficiency points and
away from the zeros of `E`,

`(z-i) f̂_{+i}(z) + e^{iθ}(z+i) f̂_{-i}(z) = (i e^{iθ/2}/π)(C_θ - conj(C_θ) E♯(z)/E(z))`. -/
theorem suzukiDeBrangesSpectralRelation (θ : ℝ) {z : ℂ}
    (hzp : z ≠ I) (hzm : z ≠ -I) (hE : xiHedenmalmDeBrangesE z ≠ 0) :
    (z - I) * suzukiDeBrangesSpectralFn I z
        + Complex.exp ((θ : ℂ) * I) * ((z + I) * suzukiDeBrangesSpectralFn (-I) z)
      = I * suzukiHalfPhasePos θ / (Real.pi : ℂ)
          * (suzukiDeBrangesCTheta θ
              - (starRingEnd ℂ) (suzukiDeBrangesCTheta θ)
                  * xiHedenmalmDeBrangesESharp z / xiHedenmalmDeBrangesE z) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have hIz : I - z ≠ 0 := sub_ne_zero.mpr (Ne.symm hzp)
  have hIz' : -I - z ≠ 0 := sub_ne_zero.mpr (Ne.symm hzm)
  rw [suzukiDeBrangesSpectralFn, suzukiDeBrangesSpectralFn,
    show (starRingEnd ℂ) (I : ℂ) = -I by simp, show (starRingEnd ℂ) (-I) = I by simp,
    suzukiDeBrangesKernel_neg_I_apply, suzukiDeBrangesKernel_I_apply,
    ← suzukiHalfPhasePos_sq]
  set Ee : ℂ := xiHedenmalmDeBrangesE z with hEe
  set Es : ℂ := xiHedenmalmDeBrangesESharp z with hEs
  set v : ℂ := suzukiHalfPhasePos θ with hv
  set p : ℂ := suzukiXiThreeHalves with hp
  set q : ℂ := suzukiXiDerivThreeHalves with hq
  have hplus := suzukiDeBrangesPos_plus_combination θ
  have hminus := suzukiDeBrangesPos_minus_combination θ
  rw [← hv, ← hp, ← hq] at hplus hminus
  have hcomb :
      (z - I) * ((Ee * (p - q) - Es * (p + q)) / (2 * (Real.pi : ℂ) * I * (I - z)) / Ee)
          + v ^ (2 : ℕ) * ((z + I) *
              ((Ee * (p + q) - Es * (p - q)) / (2 * (Real.pi : ℂ) * I * (-I - z)) / Ee))
        = (Es * ((p + q) + v ^ (2 : ℕ) * (p - q)) - Ee * ((p - q) + v ^ (2 : ℕ) * (p + q)))
            / (2 * (Real.pi : ℂ) * I * Ee) := by
    field_simp
    ring
  rw [hcomb, hplus, hminus]
  field_simp
  simp only [Complex.I_sq]
  ring

/-- **The `θ = π` spectral relation.**  `C_π = i ξ'(3/2)`, so the right-hand side becomes a
multiple of `ΞC(z)/E(z)`. -/
theorem suzukiDeBrangesSpectralRelation_pi {z : ℂ}
    (hzp : z ≠ I) (hzm : z ≠ -I) (hE : xiHedenmalmDeBrangesE z ≠ 0) :
    (z - I) * suzukiDeBrangesSpectralFn I z
        - (z + I) * suzukiDeBrangesSpectralFn (-I) z
      = -(2 * I * suzukiXiDerivThreeHalves / (Real.pi : ℂ))
          * (XiC z / xiHedenmalmDeBrangesE z) := by
  have hpi : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have h := suzukiDeBrangesSpectralRelation Real.pi hzp hzm hE
  have hc : ((Real.cos (Real.pi / 2) : ℝ) : ℂ) = 0 := by
    rw [Real.cos_pi_div_two]; simp
  have hs : ((Real.sin (Real.pi / 2) : ℝ) : ℂ) = 1 := by
    rw [Real.sin_pi_div_two]; simp
  have hC : suzukiDeBrangesCTheta Real.pi = I * suzukiXiDerivThreeHalves := by
    rw [suzukiDeBrangesCTheta, hc, hs]; ring
  have hCconj : (starRingEnd ℂ) (suzukiDeBrangesCTheta Real.pi)
      = -(I * suzukiXiDerivThreeHalves) := by
    rw [suzukiDeBrangesCTheta_conj, hc, hs]; ring
  have hv : suzukiHalfPhasePos Real.pi = I := by
    rw [suzukiHalfPhasePos, Complex.exp_mul_I]
    have h1 : Complex.cos (((Real.pi / 2 : ℝ) : ℂ)) = 0 := by
      rw [← Complex.ofReal_cos, Real.cos_pi_div_two]; simp
    have h2 : Complex.sin (((Real.pi / 2 : ℝ) : ℂ)) = 1 := by
      rw [← Complex.ofReal_sin, Real.sin_pi_div_two]; simp
    rw [h1, h2]; ring
  have hexp : Complex.exp ((Real.pi : ℂ) * I) = -1 := by
    rw [← suzukiHalfPhasePos_sq, hv, sq, Complex.I_mul_I]
  rw [hexp] at h
  rw [hCconj, hC, hv] at h
  have hEsharp : xiHedenmalmDeBrangesESharp z
      = 2 * XiC z - xiHedenmalmDeBrangesE z := by
    rw [xiHedenmalmDeBrangesE, xiHedenmalmDeBrangesESharp]; ring
  rw [show (z - I) * suzukiDeBrangesSpectralFn I z
      - (z + I) * suzukiDeBrangesSpectralFn (-I) z
      = (z - I) * suzukiDeBrangesSpectralFn I z
        + (-1 : ℂ) * ((z + I) * suzukiDeBrangesSpectralFn (-I) z) from by ring, h, hEsharp,
    Complex.I_mul_I]
  field_simp
  ring

end RHTower
