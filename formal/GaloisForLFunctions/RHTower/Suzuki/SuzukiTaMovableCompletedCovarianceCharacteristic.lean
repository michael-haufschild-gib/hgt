import GaloisForLFunctions.RHTower.Suzuki.SuzukiTaV2ActualDefectJet

/-!
# Movable completed-covariance characteristic

Suzuki's raw deficiency at every real height `c` produces a literal completed covariance source
`Cₐ exp(c x)`.  After scaling spectral coordinate by same `c`, endpoint Fourier readouts are
exact even-minus-odd and even-plus-odd covariance energies.  Consequently disk derivative of
associated Livšic characteristic is exact coalescing defect angle at every height, not only fixed
`c = 1` endpoint.

This gives source-faithful characteristic producer whose first defect and squared Schur slack have
exact coalescing boundary rates.  Prime, polar, and Gamma contributions remain coupled inside
completed covariance operator before Fourier scalarization.
-/

open Complex MeasureTheory Set Filter Topology
open scoped ENNReal InnerProduct

noncomputable section
namespace RHTower

open GaloisForLFunctions.RHTower

attribute [local instance] Measure.Subtype.measureSpace

/-- Imaginary spectral exponential at arbitrary real height is literal real exponential source. -/
theorem suzukiTaSpectralExponential_mul_I_eq
    (a : SuzukiPositiveAperture) (c : ℝ) :
    suzukiTaSpectralExponentialL2 a ((c : ℂ) * I) =
      suzukiTaExponentialL2 a c := by
  apply Lp.ext
  filter_upwards [ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) volume
      (suzukiTaSpectralExponentialContinuous a ((c : ℂ) * I)),
    ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) volume
      (suzukiTaExponentialContinuous a c)] with x hx hy
  change
    (((ContinuousMap.toLp 2 volume ℂ)
      (suzukiTaSpectralExponentialContinuous a ((c : ℂ) * I)) :
        SuzukiApertureInterval a.1 → ℂ) x) =
    (((ContinuousMap.toLp 2 volume ℂ)
      (suzukiTaExponentialContinuous a c) :
        SuzukiApertureInterval a.1 → ℂ) x)
  rw [hx, hy]
  simp only [suzukiTaSpectralExponentialContinuous, suzukiTaExponentialContinuous]
  change Complex.exp (-I * ((c : ℂ) * I) * (((x : ℝ) : ℂ))) =
    ((Real.exp (c * (x : ℝ)) : ℝ) : ℂ)
  rw [Complex.ofReal_exp]
  congr 1
  push_cast
  calc
    -I * ((c : ℂ) * I) * (((x : ℝ) : ℂ)) =
        (c : ℂ) * (-I * I) * (((x : ℝ) : ℂ)) := by ring
    _ = (c : ℂ) * (((x : ℝ) : ℂ)) := by norm_num

/-- Fourier evaluation at arbitrary positive or negative imaginary height is corresponding
Riesz moment, with exact sign reversal. -/
theorem suzukiTaPhysicalFourier_mul_I_eq_moment_neg
    (a : SuzukiPositiveAperture) (c : ℝ) (x : SuzukiTaHilbert a) :
    suzukiTaPhysicalFourier a x ((c : ℂ) * I) = suzukiTaMoment a (-c) x := by
  rw [← suzukiTaSpectralMoment_star_eq_physicalFourier]
  have hstar : star ((c : ℂ) * I) = ((-c : ℝ) : ℂ) * I := by
    change (starRingEnd ℂ) ((c : ℂ) * I) = ((-c : ℝ) : ℂ) * I
    rw [map_mul, Complex.conj_ofReal, conj_I]
    push_cast
    ring
  rw [hstar, suzukiTaSpectralMoment, suzukiTaMoment,
    suzukiTaSpectralExponential_mul_I_eq]

/-- Literal whole-line completed covariance source generated by movable raw deficiency `c`. -/
def suzukiTaMovableCompletedCovarianceSource
    (a : SuzukiPositiveAperture) (c : ℝ) : SoninL2 :=
  suzukiApertureZeroExtendL2
    (suzukiWeilIntervalCovariance a (suzukiTaExponentialL2 a c))

/-- Scaled Fourier readout of movable completed covariance source. -/
def suzukiTaMovableCompletedCovarianceFourier
    (a : SuzukiPositiveAperture) (c : ℝ) (z : ℂ) : ℂ :=
  suzukiCompactL2Fourier a.1
    (suzukiTaMovableCompletedCovarianceSource a c) ((c : ℂ) * z)

/-- Movable source is physical representative of actual raw deficiency at height `c`. -/
theorem suzukiTaMovableCompletedCovarianceSource_eq_rawDeficiency
    (a : SuzukiPositiveAperture) (c : ℝ) :
    suzukiTaMovableCompletedCovarianceSource a c =
      suzukiApertureZeroExtendL2
        (suzukiTaPhysicalEmbedding a (suzukiTaRawDeficiency a c)) := by
  rw [suzukiTaMovableCompletedCovarianceSource,
    suzukiTaPhysicalEmbedding_rawDeficiency_eq_covariance]

/-- Movable completed-source Fourier readout is actual raw-deficiency physical Fourier readout. -/
theorem suzukiTaMovableCompletedCovarianceFourier_eq_physical
    (a : SuzukiPositiveAperture) (c : ℝ) (z : ℂ) :
    suzukiTaMovableCompletedCovarianceFourier a c z =
      suzukiTaPhysicalFourier a (suzukiTaRawDeficiency a c) ((c : ℂ) * z) := by
  rw [suzukiTaMovableCompletedCovarianceFourier,
    suzukiTaMovableCompletedCovarianceSource,
    suzukiTaPhysicalFourier,
    suzukiTaPhysicalEmbedding_rawDeficiency_eq_covariance]

/-- Positive imaginary endpoint is exact signed even-minus-odd covariance energy. -/
theorem suzukiTaMovableCompletedCovarianceFourier_I
    (a : SuzukiPositiveAperture) (c : ℝ) :
    suzukiTaMovableCompletedCovarianceFourier a c I =
      ((suzukiTaCoalescingEvenEnergy a c -
        suzukiTaCoalescingOddEnergy a c : ℝ) : ℂ) := by
  rw [suzukiTaMovableCompletedCovarianceFourier_eq_physical,
    suzukiTaPhysicalFourier_mul_I_eq_moment_neg,
    ← suzukiTaRawDeficiency_inner,
    inner_rawDeficiency_neg_eq_energy_sub]

/-- Negative imaginary endpoint is exact positive even-plus-odd covariance energy. -/
theorem suzukiTaMovableCompletedCovarianceFourier_neg_I
    (a : SuzukiPositiveAperture) (c : ℝ) :
    suzukiTaMovableCompletedCovarianceFourier a c (-I) =
      ((suzukiTaCoalescingEvenEnergy a c +
        suzukiTaCoalescingOddEnergy a c : ℝ) : ℂ) := by
  rw [suzukiTaMovableCompletedCovarianceFourier_eq_physical]
  have hfourier := suzukiTaPhysicalFourier_mul_I_eq_moment_neg
    a (-c) (suzukiTaRawDeficiency a c)
  have harg : ((c : ℂ) * -I) = (((-c : ℝ) : ℂ) * I) := by
    push_cast
    ring
  rw [harg, hfourier]
  simp only [neg_neg]
  rw [← suzukiTaRawDeficiency_inner, inner_self_eq_norm_sq_to_K]
  convert congrArg (fun r : ℝ => (r : ℂ))
    (suzukiTaCoalescingEnergy_add_eq_norm_sq a c).symm using 1;
      norm_num [Complex.ofReal_pow]

/-- Disk Livšic characteristic formed before scalarization from movable completed covariance. -/
def suzukiTaMovableCompletedCovarianceLivsicDisk
    (a : SuzukiPositiveAperture) (c : ℝ) (w : ℂ) : ℂ :=
  let F := suzukiTaMovableCompletedCovarianceFourier a c
  suzukiLivsicQuotient (suzukiFourierNumerator F)
    (suzukiFourierDenominator F) (suzukiUpperCayleyInv w)

/-- Exact all-height characteristic law: first disk jet is normalized signed covariance energy.
No limiting, Xi-identification, or positivity premise occurs. -/
theorem deriv_suzukiTaMovableCompletedCovarianceLivsicDisk_zero
    (a : SuzukiPositiveAperture) (c : ℝ) :
    deriv (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0 =
      (suzukiDefectAngle (suzukiTaCoalescingEvenEnergy a c)
        (suzukiTaCoalescingOddEnergy a c) : ℂ) := by
  let F := suzukiTaMovableCompletedCovarianceFourier a c
  have hF : Differentiable ℂ F := by
    intro z
    rw [show F = fun w => suzukiTaPhysicalFourier a
        (suzukiTaRawDeficiency a c) ((c : ℂ) * w) by
      funext w
      exact suzukiTaMovableCompletedCovarianceFourier_eq_physical a c w]
    exact ((differentiable_suzukiTaPhysicalFourier a _) _).comp z
      ((hasDerivAt_id z).const_mul (c : ℂ)).differentiableAt
  have hsum : suzukiTaCoalescingEvenEnergy a c +
      suzukiTaCoalescingOddEnergy a c ≠ 0 := by
    rw [suzukiTaCoalescingEnergy_add_eq_norm_sq]
    exact pow_ne_zero 2 (norm_ne_zero_iff.mpr (suzukiTaRawDeficiency_ne_zero a c))
  change deriv (fun w => suzukiLivsicQuotient
    (suzukiFourierNumerator F) (suzukiFourierDenominator F)
    (suzukiUpperCayleyInv w)) 0 = _
  exact deriv_suzukiFourierLivsic_disk_zero_eq_defectAngle
    hF.differentiableAt hF.differentiableAt hsum
    (suzukiTaMovableCompletedCovarianceFourier_I a c)
    (suzukiTaMovableCompletedCovarianceFourier_neg_I a c)

/-- At original Suzuki normalization `c = 1`, movable producer and literal v2 characteristic have
same first disk jet. -/
theorem deriv_suzukiTaMovableCompletedCovarianceLivsicDisk_one_eq_actual
    (a : SuzukiPositiveAperture) :
    deriv (suzukiTaMovableCompletedCovarianceLivsicDisk a 1) 0 =
      deriv (fun w => suzukiTaV2Livsic a (suzukiUpperCayleyInv w)) 0 := by
  rw [deriv_suzukiTaMovableCompletedCovarianceLivsicDisk_zero,
    deriv_suzukiTaV2Livsic_disk_zero_eq_coalescingDefectAngle]

/-- Coefficient-faithful boundary renormalization: normalized first defect converges to actual
position-resolvent tangent of completed covariance. -/
theorem tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_rate
    (a : SuzukiPositiveAperture) :
    Tendsto (fun c : ℝ =>
        (1 - (deriv
          (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re) /
            (2 * c ^ 2))
      (𝓝[>] (0 : ℝ)) (𝓝 (suzukiTaPositionResolventTangent a)) := by
  simpa only [deriv_suzukiTaMovableCompletedCovarianceLivsicDisk_zero,
    Complex.ofReal_re] using tendsto_one_sub_suzukiTaCoalescingDefect_rate a

/-- Movable completed-covariance first jet converges to pure endpoint coefficient `1`. -/
theorem tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_re_one
    (a : SuzukiPositiveAperture) :
    Tendsto (fun c : ℝ =>
        (deriv (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re)
      (𝓝[>] (0 : ℝ)) (𝓝 1) := by
  have hsq : Tendsto (fun c : ℝ => 2 * c ^ 2)
      (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    have hcont : ContinuousAt (fun c : ℝ => 2 * c ^ 2) 0 := by fun_prop
    simpa using hcont.tendsto.mono_left nhdsWithin_le_nhds
  have hscaled :=
    (tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_rate a).mul hsq
  have hscaled' : Tendsto (fun c : ℝ =>
      (1 - (deriv
        (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re) /
          (2 * c ^ 2) * (2 * c ^ 2))
      (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    simpa only [mul_zero] using hscaled
  have hgap : Tendsto (fun c : ℝ =>
      1 - (deriv
        (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re)
      (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    apply hscaled'.congr'
    filter_upwards [self_mem_nhdsWithin] with c hc
    have hc0 : c ≠ 0 := hc.ne'
    field_simp [hc0]
  have hone : Tendsto (fun _ : ℝ => (1 : ℝ))
      (𝓝[>] (0 : ℝ)) (𝓝 1) := tendsto_const_nhds
  have h := hone.sub hgap
  simpa only [sub_zero, sub_sub_cancel] using h

/-- Squared Schur slack has exact doubled source rate.  This is scale required by a covariant
second-jet wall and retains actual completed-covariance coefficient. -/
theorem tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_re_sq_rate
    (a : SuzukiPositiveAperture) :
    Tendsto (fun c : ℝ =>
        (1 - (deriv
          (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re ^ 2) /
            (2 * c ^ 2))
      (𝓝[>] (0 : ℝ)) (𝓝 (2 * suzukiTaPositionResolventTangent a)) := by
  have honePlus : Tendsto (fun c : ℝ =>
      1 + (deriv
        (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re)
      (𝓝[>] (0 : ℝ)) (𝓝 (1 + 1)) :=
    tendsto_const_nhds.add
      (tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_re_one a)
  have hprod :=
    (tendsto_suzukiTaMovableCompletedCovarianceLivsicDisk_deriv_rate a).mul honePlus
  have hprod' : Tendsto (fun c : ℝ =>
      (1 - (deriv
        (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re) /
          (2 * c ^ 2) *
        (1 + (deriv
          (suzukiTaMovableCompletedCovarianceLivsicDisk a c) 0).re))
      (𝓝[>] (0 : ℝ)) (𝓝 (2 * suzukiTaPositionResolventTangent a)) := by
    convert hprod using 1;
    ring_nf
  apply hprod'.congr'
  filter_upwards [self_mem_nhdsWithin] with c hc
  have hc0 : c ≠ 0 := hc.ne'
  field_simp [hc0]
  ring_nf

end RHTower
