theorem suzukiFiniteSignDefectCoefficient_pos_of_explicit_bound
    {a : ℝ} (ha : 0 < a)
    (haBound : a <
      1 / (16 * (suzukiOriginCurvatureUnitBound + 1))) :
    0 < suzukiFiniteSignDefectCoefficient a := by
  have hC : 0 ≤ suzukiOriginCurvatureUnitBound :=
    suzukiOriginCurvatureUnitBound_spec.1
  have hden : 0 < suzukiOriginCurvatureUnitBound + 1 := by linarith
  have hden16 : 0 < 16 * (suzukiOriginCurvatureUnitBound + 1) := by positivity
  have hmul := mul_lt_mul_of_pos_right haBound hden
  have hinvMul :
      (1 / (16 * (suzukiOriginCurvatureUnitBound + 1))) *
          (suzukiOriginCurvatureUnitBound + 1) = 1 / 16 := by
    field_simp
  have haC : a * suzukiOriginCurvatureUnitBound ≤
      a * (suzukiOriginCurvatureUnitBound + 1) := by
    nlinarith
  unfold suzukiFiniteSignDefectCoefficient
  rw [hinvMul] at hmul
  nlinarith

/-- Full unconditional formalization of Suzuki 2026, Theorem 1.4: throughout one punctured
neighborhood of zero, the exact lowest eigenvalue is positive and has the paper's sharp main term
with explicit `O(a)` error, while its eigenspace is a single complex line generated by a nonzero
even eigenfunction. -/
theorem exists_suzukiSmallAperture_full_theorem_one_four :
    ∃ delta : ℝ, 0 < delta ∧
      ∀ a : SuzukiPositiveAperture, a.1 < delta →
        0 < suzukiWeilIntervalGroundEnergy a ∧
        |suzukiWeilIntervalGroundEnergy a -
            (Real.log (1 / a.1) + suzukiLimitingLogGroundEnergy -
              Real.log (2 * Real.pi) + (Complex.digamma (2 : ℂ)).re - 1)| ≤
          2 * suzukiOriginCurvatureUnitBound * a.1 ∧
        ∃ e : (ccmRestrictedWeilOperator a).domain,
          (e : suzukiApertureHilbert a) ≠ 0 ∧
          ccmRestrictedWeilOperator a e =
            (ccmRestrictedWeilGroundEnergy a : ℂ) •
              (e : suzukiApertureHilbert a) ∧
          l2Reflection (((e : suzukiApertureHilbert a) : SoninL2)) =
            ((e : suzukiApertureHilbert a) : SoninL2) ∧
          ∀ x : (ccmRestrictedWeilOperator a).domain,
            ccmRestrictedWeilOperator a x =
                (ccmRestrictedWeilGroundEnergy a : ℂ) •
                  (x : suzukiApertureHilbert a) →
              ∃ c : ℂ, (x : suzukiApertureHilbert a) =
                c • (e : suzukiApertureHilbert a) := by
  obtain ⟨deltaPos, hdeltaPos, hgroundPos⟩ :=
    exists_suzukiSmallAperture_intervalGroundEnergy_pos
  let deltaDefect : ℝ :=
    1 / (16 * (suzukiOriginCurvatureUnitBound + 1))
  have hdeltaDefect : 0 < deltaDefect := by
    dsimp only [deltaDefect]
    exact one_div_pos.mpr (mul_pos (by norm_num)
      (by linarith [suzukiOriginCurvatureUnitBound_spec.1]))
  let delta : ℝ := min deltaPos
    (min (1 / 2 : ℝ) (min (Real.log 2 / 2) deltaDefect))
  have hdelta : 0 < delta := by
    dsimp only [delta]
    exact lt_min hdeltaPos
      (lt_min (by norm_num)
        (lt_min (div_pos (Real.log_pos (by norm_num)) (by norm_num))
          hdeltaDefect))
  refine ⟨delta, hdelta, fun a ha => ?_⟩
  have haPosThreshold : a.1 < deltaPos :=
    ha.trans_le (min_le_left _ _)
  have haRest : a.1 <
      min (1 / 2 : ℝ) (min (Real.log 2 / 2) deltaDefect) :=
    ha.trans_le (min_le_right _ _)
  have haHalf : a.1 < 1 / 2 :=
    haRest.trans_le (min_le_left _ _)
  have haRest' : a.1 < min (Real.log 2 / 2) deltaDefect :=
    haRest.trans_le (min_le_right _ _)
  have haLog : a.1 < Real.log 2 / 2 :=
    haRest'.trans_le (min_le_left _ _)
  have haDefect : a.1 < deltaDefect :=
    haRest'.trans_le (min_le_right _ _)
  let small : SuzukiPrimeFreeSmallAperture :=
    ⟨a.1, a.2, by nlinarith, by nlinarith⟩
  have hdefect : 0 < suzukiFiniteSignDefectCoefficient small.val := by
    apply suzukiFiniteSignDefectCoefficient_pos_of_explicit_bound a.2
    simpa only [small, deltaDefect] using haDefect
  refine ⟨hgroundPos a haPosThreshold, ?_, ?_⟩
  · simpa only [small] using
      abs_suzukiSmallAperture_intervalGroundEnergy_sub_paperMain_le small
  · simpa only [small, suzukiSmallScaledGroundEnergy] using
      ccmRestrictedWeilOperator_exists_even_simple_groundEigenstate_of_finiteSignDefect
        small hdefect

end RHTower
