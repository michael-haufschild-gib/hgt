import GaloisForLFunctions.RHTower.XiMassLevinsonPrimeSecantLanding
import GaloisForLFunctions.RHTower.RouteBTwoField

/-!
# Fixed-aperture Levinson rough-tail horizon

The true-prime filter in the two-aperture Xi-mass landing is not generated by any fixed finite
linear combination of reciprocal Levinson detectors. On integers whose prime factors all exceed
the largest aperture, every such combination has the rank-two affine form

`(A - B log n) / sqrt n`.

Agreement at two exterior primes forces `A = 0` and `B = -1`, hence forces the same nonzero
logarithmic coefficient at every exterior prime square. This kills fixed finite linear-aperture
prime extraction.

The obstruction has a sharp positive survivor. An `M`-rough nonunit at most `M²` is prime, so the
same detector is coefficient-faithful throughout that quadratic horizon. A detector-native T1
landing must therefore co-move with source resolution so the source cutoff stays at most the square
of the aperture, or introduce an independent prime-power subtraction.
-/

open Complex Finset

namespace RHTower.Sieve

noncomputable section

/-- Every prime factor lies beyond the aperture. -/
def IsApertureRough (M n : ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → p ∣ n → M < p

theorem apertureRough_divisor_eq_one
    {M n d : ℕ} (hn : 0 < n) (hrough : IsApertureRough M n)
    (hdn : d ∣ n) (hdM : d ≤ M) :
    d = 1 := by
  have hd : 0 < d := Nat.pos_of_dvd_of_pos hdn hn
  by_contra hd1
  have hp : d.minFac.Prime := Nat.minFac_prime hd1
  have hpd : d.minFac ∣ d := Nat.minFac_dvd d
  have hpn : d.minFac ∣ n := dvd_trans hpd hdn
  have hpM : M < d.minFac := hrough d.minFac hp hpn
  have hpdle : d.minFac ≤ d := Nat.minFac_le (by omega)
  omega

theorem barbanVehovCoeff_eq_log_of_rough
    {M L n : ℕ} (hL : 1 < L) (hLM : L ≤ M) (hn : 0 < n)
    (hrough : IsApertureRough M n) :
    barbanVehovCoeff L n = Real.log L := by
  rw [barbanVehovCoeff_eq_sum_filter]
  have hfilter : n.divisors.filter (fun d => d ≤ L) = {1} := by
    rw [Finset.eq_singleton_iff_unique_mem]
    constructor
    · rw [Finset.mem_filter]
      exact ⟨Nat.one_mem_divisors.mpr hn.ne', by omega⟩
    · intro d hd
      rw [Finset.mem_filter] at hd
      exact apertureRough_divisor_eq_one hn hrough
        (Nat.dvd_of_mem_divisors hd.1) (le_trans hd.2 hLM)
  rw [hfilter]
  simp

theorem barbanVehovLogMomentCoeff_eq_zero_of_rough
    {M L n : ℕ} (hLM : L ≤ M) (hn : 0 < n)
    (hrough : IsApertureRough M n) :
    barbanVehovLogMomentCoeff L n = 0 := by
  rw [barbanVehovLogMomentCoeff]
  apply Finset.sum_eq_zero
  intro d hd
  by_cases hdL : d ≤ L
  · have hd1 := apertureRough_divisor_eq_one hn hrough
      (Nat.dvd_of_mem_divisors hd) (le_trans hdL hLM)
    subst d
    simp
  · simp [barbanVehovWeight, hdL]

theorem levinsonReciprocalMollifiedCriticalDetectorCoeff_eq_of_rough
    {M L n : ℕ} (hL : 1 < L) (hLM : L ≤ M) (hn : 0 < n)
    (hrough : IsApertureRough M n) :
    levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log L) L n =
      ((((1 - Real.log n / Real.log L) / Real.sqrt n : ℝ)) : ℂ) := by
  rw [levinsonLinearMollifiedCriticalDetectorCoeff_eq hn,
    barbanVehovCoeff_eq_log_of_rough hL hLM hn hrough,
    barbanVehovLogMomentCoeff_eq_zero_of_rough hLM hn hrough]
  have hlog : Real.log (L : ℝ) ≠ 0 :=
    ne_of_gt (Real.log_pos (by exact_mod_cast hL))
  norm_cast
  field_simp [hlog]
  ring

/-- Arbitrary finite complex linear combination of reciprocal aperture coefficients. -/
def levinsonReciprocalDetectorCombinationCoeff
    (S : Finset ℕ) (alpha : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ L ∈ S, alpha L *
    levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log L) L n

def levinsonReciprocalDetectorCombinationIntercept
    (S : Finset ℕ) (alpha : ℕ → ℂ) : ℂ :=
  ∑ L ∈ S, alpha L

def levinsonReciprocalDetectorCombinationLogSlope
    (S : Finset ℕ) (alpha : ℕ → ℂ) : ℂ :=
  ∑ L ∈ S, alpha L / (Real.log L : ℂ)

/-- **Rank-two rough-tail classification.** Every fixed finite linear aperture combination lies in
the affine span of `1 / sqrt n` and `log n / sqrt n` on the entire rough tail. -/
theorem levinsonReciprocalDetectorCombinationCoeff_eq_affine_of_rough
    {S : Finset ℕ} {alpha : ℕ → ℂ} {M n : ℕ}
    (hlegal : ∀ L ∈ S, 1 < L) (hbound : ∀ L ∈ S, L ≤ M)
    (hn : 0 < n) (hrough : IsApertureRough M n) :
    levinsonReciprocalDetectorCombinationCoeff S alpha n =
      (levinsonReciprocalDetectorCombinationIntercept S alpha -
          (Real.log n : ℂ) *
            levinsonReciprocalDetectorCombinationLogSlope S alpha) *
        (((1 / Real.sqrt n : ℝ)) : ℂ) := by
  rw [levinsonReciprocalDetectorCombinationCoeff]
  calc
    ∑ L ∈ S, alpha L *
        levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log L) L n =
        ∑ L ∈ S, alpha L *
          ((((1 - Real.log n / Real.log L) / Real.sqrt n : ℝ)) : ℂ) := by
      apply Finset.sum_congr rfl
      intro L hL
      rw [levinsonReciprocalMollifiedCriticalDetectorCoeff_eq_of_rough
        (hlegal L hL) (hbound L hL) hn hrough]
    _ = ∑ L ∈ S,
        (alpha L - (Real.log n : ℂ) *
          (alpha L / (Real.log L : ℂ))) *
            (((1 / Real.sqrt n : ℝ)) : ℂ) := by
      apply Finset.sum_congr rfl
      intro L hL
      push_cast
      ring
    _ = (levinsonReciprocalDetectorCombinationIntercept S alpha -
          (Real.log n : ℂ) *
            levinsonReciprocalDetectorCombinationLogSlope S alpha) *
        (((1 / Real.sqrt n : ℝ)) : ℂ) := by
      simp only [levinsonReciprocalDetectorCombinationIntercept,
        levinsonReciprocalDetectorCombinationLogSlope]
      rw [← Finset.sum_mul, Finset.sum_sub_distrib, Finset.mul_sum]

/-- The true-prime logarithmic half-density, extended by zero away from primes. -/
def truePrimeLogHalfDensityCoeff (n : ℕ) : ℂ :=
  if n.Prime then
    (Real.log n : ℂ) * (((1 / Real.sqrt n : ℝ)) : ℂ)
  else 0

/-- A fixed aperture combination has the correct coefficient on every exterior prime. -/
def PrimeCorrectOnRoughTail
    (S : Finset ℕ) (alpha : ℕ → ℂ) (M : ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → M < p →
    levinsonReciprocalDetectorCombinationCoeff S alpha p =
      (Real.log p : ℂ) * (((1 / Real.sqrt p : ℝ)) : ℂ)

theorem prime_isApertureRough {M p : ℕ} (hp : p.Prime) (hMp : M < p) :
    IsApertureRough M p := by
  intro q hq hqp
  have hqp' : q = p := (Nat.prime_dvd_prime_iff_eq hq hp).mp hqp
  omega

theorem prime_sq_isApertureRough {M p : ℕ} (hp : p.Prime) (hMp : M < p) :
    IsApertureRough M (p ^ (2 : ℕ)) := by
  intro q hq hqp
  have hqdp : q ∣ p := hq.dvd_of_dvd_pow hqp
  have hqp' : q = p := (Nat.prime_dvd_prime_iff_eq hq hp).mp hqdp
  omega

theorem one_div_sqrt_nat_cast_ne_zero {n : ℕ} (hn : 0 < n) :
    (((1 / Real.sqrt n : ℝ)) : ℂ) ≠ 0 := by
  have hsqrt : Real.sqrt (n : ℝ) ≠ 0 :=
    ne_of_gt (Real.sqrt_pos.2 (by exact_mod_cast hn))
  exact_mod_cast one_div_ne_zero hsqrt

/-- Two exterior prime values force the unique logarithmic rough-tail profile. -/
theorem intercept_eq_zero_and_logSlope_eq_neg_one_of_primeCorrectOnRoughTail
    {S : Finset ℕ} {alpha : ℕ → ℂ} {M : ℕ}
    (hlegal : ∀ L ∈ S, 1 < L) (hbound : ∀ L ∈ S, L ≤ M)
    (hcorrect : PrimeCorrectOnRoughTail S alpha M) :
    levinsonReciprocalDetectorCombinationIntercept S alpha = 0 ∧
      levinsonReciprocalDetectorCombinationLogSlope S alpha = -1 := by
  obtain ⟨p, hpM, hp⟩ := Nat.exists_infinite_primes (M + 1)
  obtain ⟨q, hqp, hq⟩ := Nat.exists_infinite_primes (p + 1)
  have hMp : M < p := by omega
  have hpq : p < q := by omega
  have hMq : M < q := lt_trans hMp hpq
  let A := levinsonReciprocalDetectorCombinationIntercept S alpha
  let B := levinsonReciprocalDetectorCombinationLogSlope S alpha
  have hpEq :
      (A - (Real.log p : ℂ) * B) * (((1 / Real.sqrt p : ℝ)) : ℂ) =
        (Real.log p : ℂ) * (((1 / Real.sqrt p : ℝ)) : ℂ) := by
    calc
      (A - (Real.log p : ℂ) * B) * (((1 / Real.sqrt p : ℝ)) : ℂ) =
          levinsonReciprocalDetectorCombinationCoeff S alpha p := by
        simpa only [A, B] using
          (levinsonReciprocalDetectorCombinationCoeff_eq_affine_of_rough
            (alpha := alpha) hlegal hbound hp.pos
              (prime_isApertureRough hp hMp)).symm
      _ = (Real.log p : ℂ) * (((1 / Real.sqrt p : ℝ)) : ℂ) :=
        hcorrect p hp hMp
  have hqEq :
      (A - (Real.log q : ℂ) * B) * (((1 / Real.sqrt q : ℝ)) : ℂ) =
        (Real.log q : ℂ) * (((1 / Real.sqrt q : ℝ)) : ℂ) := by
    calc
      (A - (Real.log q : ℂ) * B) * (((1 / Real.sqrt q : ℝ)) : ℂ) =
          levinsonReciprocalDetectorCombinationCoeff S alpha q := by
        simpa only [A, B] using
          (levinsonReciprocalDetectorCombinationCoeff_eq_affine_of_rough
            (alpha := alpha) hlegal hbound hq.pos
              (prime_isApertureRough hq hMq)).symm
      _ = (Real.log q : ℂ) * (((1 / Real.sqrt q : ℝ)) : ℂ) :=
        hcorrect q hq hMq
  have hpLin : A - (Real.log p : ℂ) * B = (Real.log p : ℂ) :=
    mul_right_cancel₀ (one_div_sqrt_nat_cast_ne_zero hp.pos) hpEq
  have hqLin : A - (Real.log q : ℂ) * B = (Real.log q : ℂ) :=
    mul_right_cancel₀ (one_div_sqrt_nat_cast_ne_zero hq.pos) hqEq
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq.pos
  have hloglt : Real.log (p : ℝ) < Real.log (q : ℝ) :=
    Real.strictMonoOn_log hpR hqR (by exact_mod_cast hpq)
  have hlogne : (Real.log p : ℂ) - (Real.log q : ℂ) ≠ 0 := by
    apply sub_ne_zero.mpr
    exact_mod_cast (ne_of_lt hloglt)
  have hprod :
      ((Real.log p : ℂ) - (Real.log q : ℂ)) * (B + 1) = 0 := by
    linear_combination -hpLin + hqLin
  have hBadd : B + 1 = 0 := (mul_eq_zero.mp hprod).resolve_left hlogne
  have hB : B = -1 := eq_neg_of_add_eq_zero_left hBadd
  have hA : A = 0 := by
    rw [hB] at hpLin
    linear_combination hpLin
  exact ⟨hA, hB⟩

/-- Prime-correctness on a fixed finite aperture forces `log n / sqrt n` on the entire rough tail,
including every rough composite. -/
theorem levinsonReciprocalDetectorCombinationCoeff_eq_log_of_primeCorrectOnRoughTail
    {S : Finset ℕ} {alpha : ℕ → ℂ} {M n : ℕ}
    (hlegal : ∀ L ∈ S, 1 < L) (hbound : ∀ L ∈ S, L ≤ M)
    (hcorrect : PrimeCorrectOnRoughTail S alpha M)
    (hn : 0 < n) (hrough : IsApertureRough M n) :
    levinsonReciprocalDetectorCombinationCoeff S alpha n =
      (Real.log n : ℂ) * (((1 / Real.sqrt n : ℝ)) : ℂ) := by
  obtain ⟨hA, hB⟩ :=
    intercept_eq_zero_and_logSlope_eq_neg_one_of_primeCorrectOnRoughTail
      hlegal hbound hcorrect
  rw [levinsonReciprocalDetectorCombinationCoeff_eq_affine_of_rough
    hlegal hbound hn hrough, hA, hB]
  ring

/-- **Fixed finite-aperture no-go.** No finite linear combination of reciprocal Levinson
detectors can equal the true-prime half-density on every rough index. -/
theorem not_forall_levinsonReciprocalDetectorCombinationCoeff_eq_truePrime_of_rough
    {S : Finset ℕ} {alpha : ℕ → ℂ} {M : ℕ}
    (hlegal : ∀ L ∈ S, 1 < L) (hbound : ∀ L ∈ S, L ≤ M) :
    ¬ ∀ n : ℕ, 0 < n → IsApertureRough M n →
      levinsonReciprocalDetectorCombinationCoeff S alpha n =
        truePrimeLogHalfDensityCoeff n := by
  intro hall
  have hcorrect : PrimeCorrectOnRoughTail S alpha M := by
    intro p hp hMp
    simpa only [truePrimeLogHalfDensityCoeff, if_pos hp] using
      hall p hp.pos (prime_isApertureRough hp hMp)
  obtain ⟨p, hpM, hp⟩ := Nat.exists_infinite_primes (M + 1)
  have hMp : M < p := by omega
  have hp2pos : 0 < p ^ (2 : ℕ) := pow_pos hp.pos 2
  have hp2rough : IsApertureRough M (p ^ (2 : ℕ)) :=
    prime_sq_isApertureRough hp hMp
  have hp2not : ¬(p ^ (2 : ℕ)).Prime := Nat.Prime.not_prime_pow (by norm_num)
  have hclass :=
    levinsonReciprocalDetectorCombinationCoeff_eq_log_of_primeCorrectOnRoughTail
      hlegal hbound hcorrect hp2pos hp2rough
  have hzero : levinsonReciprocalDetectorCombinationCoeff S alpha (p ^ (2 : ℕ)) = 0 := by
    simpa only [truePrimeLogHalfDensityCoeff, if_neg hp2not] using
      hall (p ^ (2 : ℕ)) hp2pos hp2rough
  have hlogpos : 0 < Real.log (((p ^ (2 : ℕ) : ℕ) : ℝ)) := by
    exact Real.log_pos (by exact_mod_cast (show 1 < p ^ (2 : ℕ) by nlinarith [hp.two_le]))
  have hnonzero :
      (Real.log (((p ^ (2 : ℕ) : ℕ) : ℝ)) : ℂ) *
          (((1 / Real.sqrt (((p ^ (2 : ℕ) : ℕ) : ℝ)) : ℝ)) : ℂ) ≠ 0 :=
    mul_ne_zero (by exact_mod_cast (ne_of_gt hlogpos))
      (one_div_sqrt_nat_cast_ne_zero hp2pos)
  apply hnonzero
  rw [← hclass, hzero]

/-- **Sharp positive survivor.** A prime-correct finite aperture is coefficient-faithful on its
rough nonunit sector through the exact quadratic horizon `M²`. -/
theorem levinsonReciprocalDetectorCombinationCoeff_eq_truePrime_of_rough_le_sq
    {S : Finset ℕ} {alpha : ℕ → ℂ} {M n : ℕ}
    (hcorrect : PrimeCorrectOnRoughTail S alpha M)
    (hn : 1 < n) (hnM : n ≤ M * M) (hrough : IsApertureRough M n) :
    levinsonReciprocalDetectorCombinationCoeff S alpha n =
      truePrimeLogHalfDensityCoeff n := by
  rcases RHTower.rough_eq_one_or_prime (lt_trans Nat.zero_lt_one hn)
      hnM le_rfl hrough with h1 | hp
  · omega
  · have hMn : M < n := hrough n hp dvd_rfl
    simpa only [truePrimeLogHalfDensityCoeff, if_pos hp] using hcorrect n hp hMn

/-- The literal two-aperture secant recovers the logarithmic half-density of every rough index,
not only primes. -/
theorem levinsonReciprocalMollifiedCriticalDetectorCoeff_secant_eq_log_of_rough
    {M₁ M₂ n : ℕ} (hM₁ : 1 < M₁) (hM₁M₂ : M₁ < M₂)
    (hn : 0 < n) (hrough : IsApertureRough M₂ n) :
    levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₂) M₂ n -
        levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₁) M₁ n =
      (((levinsonReciprocalApertureSlope M₁ M₂ * Real.log n /
          Real.sqrt n : ℝ) : ℂ)) := by
  rw [levinsonReciprocalMollifiedCriticalDetectorCoeff_eq_of_rough
      (M := M₂) (L := M₂) (n := n) (lt_trans hM₁ hM₁M₂) le_rfl hn hrough,
    levinsonReciprocalMollifiedCriticalDetectorCoeff_eq_of_rough
      (M := M₂) (L := M₁) (n := n) hM₁ hM₁M₂.le hn hrough,
    levinsonReciprocalApertureSlope]
  norm_cast
  ring

/-- Below the quadratic horizon, the literal secant is exactly coefficient-faithful on the rough
nonunit sector. -/
theorem levinsonReciprocalMollifiedCriticalDetectorCoeff_secant_eq_truePrime_of_rough_le_sq
    {M₁ M₂ n : ℕ} (hM₁ : 1 < M₁) (hM₁M₂ : M₁ < M₂)
    (hn : 1 < n) (hnM : n ≤ M₂ * M₂) (hrough : IsApertureRough M₂ n) :
    levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₂) M₂ n -
        levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₁) M₁ n =
      (levinsonReciprocalApertureSlope M₁ M₂ : ℂ) *
        truePrimeLogHalfDensityCoeff n := by
  have hp : n.Prime :=
    (RHTower.rough_eq_one_or_prime (lt_trans Nat.zero_lt_one hn)
      hnM le_rfl hrough).resolve_left (by omega)
  rw [levinsonReciprocalMollifiedCriticalDetectorCoeff_secant_eq_log_of_rough
    hM₁ hM₁M₂ (lt_trans Nat.zero_lt_one hn) hrough]
  simp only [truePrimeLogHalfDensityCoeff, if_pos hp]
  push_cast
  ring

/-- **Sharp exterior-square obstruction.** Beyond every fixed aperture, a prime square is rough,
composite, and receives a nonzero two-aperture secant coefficient although the true-prime source
vanishes there. -/
theorem exists_primeSquare_rough_levinsonReciprocalSecant_ne_truePrime
    {M₁ M₂ : ℕ} (hM₁ : 1 < M₁) (hM₁M₂ : M₁ < M₂) :
    ∃ n : ℕ, M₂ * M₂ < n ∧ IsApertureRough M₂ n ∧ ¬n.Prime ∧
      levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₂) M₂ n -
          levinsonLinearMollifiedCriticalDetectorCoeff (1 / Real.log M₁) M₁ n ≠
        (levinsonReciprocalApertureSlope M₁ M₂ : ℂ) *
          truePrimeLogHalfDensityCoeff n := by
  obtain ⟨p, hpM, hp⟩ := Nat.exists_infinite_primes (M₂ + 1)
  have hM₂p : M₂ < p := by omega
  have hp2pos : 0 < p ^ (2 : ℕ) := pow_pos hp.pos 2
  have hp2not : ¬(p ^ (2 : ℕ)).Prime := Nat.Prime.not_prime_pow (by norm_num)
  have hp2rough : IsApertureRough M₂ (p ^ (2 : ℕ)) :=
    prime_sq_isApertureRough hp hM₂p
  have hsquare : M₂ * M₂ < p ^ (2 : ℕ) := by
    calc
      M₂ * M₂ < p * M₂ := (Nat.mul_lt_mul_right (by omega)).2 hM₂p
      _ < p * p := (Nat.mul_lt_mul_left hp.pos).2 hM₂p
      _ = p ^ (2 : ℕ) := by ring
  refine ⟨p ^ (2 : ℕ), hsquare, hp2rough, hp2not, ?_⟩
  rw [levinsonReciprocalMollifiedCriticalDetectorCoeff_secant_eq_log_of_rough
    hM₁ hM₁M₂ hp2pos hp2rough,
    truePrimeLogHalfDensityCoeff, if_neg hp2not, mul_zero]
  have hslope : levinsonReciprocalApertureSlope M₁ M₂ ≠ 0 :=
    levinsonReciprocalApertureSlope_ne_zero hM₁ hM₁M₂
  have hlogpos : 0 < Real.log (((p ^ (2 : ℕ) : ℕ) : ℝ)) :=
    Real.log_pos (by exact_mod_cast (show 1 < p ^ (2 : ℕ) by nlinarith [hp.two_le]))
  exact_mod_cast div_ne_zero (mul_ne_zero hslope (ne_of_gt hlogpos))
    (ne_of_gt (Real.sqrt_pos.2 (by exact_mod_cast hp2pos)))

end

end RHTower.Sieve
