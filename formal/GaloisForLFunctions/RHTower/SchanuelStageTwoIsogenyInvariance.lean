import GaloisForLFunctions.RHTower.SchanuelAffineRelativeExponentialClosure
import GaloisForLFunctions.RHTower.SchanuelIntegralIsogenyCoreIntersection

/-!
# Integral-isogeny invariance of stage-two Schanuel failure

For a rationally independent complex pair, failure to extract two algebraically independent
members from its additive/exponential generators survives every integral coordinate transform.
The proof chooses an unconditional transcendental anchor (`x₀` or `exp x₀` by
Hermite--Lindemann), places every original generator in the algebraic closure of the resulting
one-generator field, and observes that integral additive combinations and torus monomials stay
inside that algebraic closure.

This is stronger than the unimodular invariance needed for affine rank-one normalization: no
determinant assumption is needed for preservation of extraction failure.  Nonsingularity is used
separately to preserve rational linear independence.
-/

open scoped IntermediateField

namespace GaloisForLFunctions.RHTower

noncomputable section

/-- Intermediate field generated by one element. -/
def oneGeneratorField
    (K L : Type) [Field K] [Field L] [Algebra K L] (g : L) : IntermediateField K L :=
  IntermediateField.adjoin K (Set.range (fun _ : Unit => g))

/-- Two elements algebraic over a one-generator field are dependent over the base. -/
theorem not_algebraicIndependent_fin_two_of_isAlgebraic_oneGeneratorField
    {K L : Type} [Field K] [Field L] [Algebra K L]
    (g : L) (t : Fin 2 → L)
    (ht : ∀ i, IsAlgebraic (oneGeneratorField K L g) (t i)) :
    ¬ AlgebraicIndependent K t := by
  intro hind
  let D : IntermediateField K L :=
    (algebraicClosure (oneGeneratorField K L g) L).restrictScalars K
  have htD : ∀ i, t i ∈ D := by
    intro i
    change t i ∈
      (algebraicClosure (oneGeneratorField K L g) L).restrictScalars K
    rw [IntermediateField.mem_restrictScalars, mem_algebraicClosure_iff]
    exact ht i
  let v : Fin 2 → D := fun i => ⟨t i, htD i⟩
  have hv : AlgebraicIndependent K v := by
    apply AlgebraicIndependent.of_comp D.val
    simpa [v, Function.comp_def] using hind
  have hlower : Cardinal.mk (Fin 2) ≤ Algebra.trdeg K D :=
    hv.cardinalMk_le_trdeg
  have hupper : Algebra.trdeg K D ≤ Cardinal.mk Unit := by
    change Algebra.trdeg K
      ((algebraicClosure
        (IntermediateField.adjoin K (Set.range (fun _ : Unit => g))) L).restrictScalars K) ≤
          Cardinal.mk Unit
    exact GaloisForLFunctions.HTGeometry.trdeg_algebraicClosure_adjoin_range_le
      (K := K) (L := L) (fun _ : Unit => g)
  have himpossible : Cardinal.mk (Fin 2) ≤ Cardinal.mk Unit := hlower.trans hupper
  norm_num [Cardinal.mk_fin, Cardinal.mk_unit] at himpossible

/-- Transcendence over a one-generator field gives an algebraically independent pair. -/
theorem algebraicIndependent_fin_two_of_transcendental_oneGeneratorField
    {K L : Type} [Field K] [Field L] [Algebra K L]
    (g w : L) (hg : Transcendental K g)
    (hw : Transcendental (oneGeneratorField K L g) w) :
    AlgebraicIndependent K ![g, w] := by
  let base : Unit → L := fun _ => g
  have hbase : AlgebraicIndependent K base := by
    rw [algebraicIndependent_unique_type_iff]
    exact hg
  have hwAdjoin : Transcendental (Algebra.adjoin K (Set.range (fun _ : Unit => g))) w := by
    rw [← IntermediateField.transcendental_adjoin_iff]
    exact hw
  have hopt : AlgebraicIndependent K (fun o : Option Unit => o.elim w base) :=
    (hbase.option_iff_transcendental w).mpr (by simpa [base] using hwAdjoin)
  let f : Fin 2 → Option Unit := ![some (), none]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f]
  have hcomp := hopt.comp f hf
  have heq : ((fun o : Option Unit => o.elim w base) ∘ f) = ![g, w] := by
    funext i
    fin_cases i <;> rfl
  rw [heq] at hcomp
  exact hcomp

/-- Failure of two-element extraction makes every generator algebraic over any transcendental
anchor chosen from the generating set. -/
theorem isAlgebraic_oneGeneratorField_of_mem_of_no_fin_two_extraction
    {R K L : Type} [Field R] [Field K] [Field L]
    [Algebra R K] [Algebra R L] [Algebra K L] [IsScalarTower R K L]
    (S : Set L) (g : L) (hgS : g ∈ S) (hg : Transcendental K g)
    (hfail : ¬ ∃ t : Fin 2 → L, Function.Injective t ∧
      (∀ i, t i ∈ S) ∧ AlgebraicIndependent R t)
    {w : L} (hwS : w ∈ S) :
    IsAlgebraic (oneGeneratorField K L g) w := by
  by_contra hwalg
  have hwtrans : Transcendental (oneGeneratorField K L g) w := hwalg
  have hindK := algebraicIndependent_fin_two_of_transcendental_oneGeneratorField g w hg hwtrans
  have hindR : AlgebraicIndependent R ![g, w] :=
    hindK.restrictScalars (algebraMap R K).injective
  apply hfail
  refine ⟨![g, w], hindR.injective, ?_, hindR⟩
  intro i
  fin_cases i
  · exact hgS
  · exact hwS

/-- Algebraicity is stable under integral powers in a field. -/
theorem isAlgebraic_zpow
    {K L : Type} [Field K] [Field L] [Algebra K L]
    {x : L} (hx : IsAlgebraic K x) (n : ℤ) : IsAlgebraic K (x ^ n) := by
  cases n with
  | ofNat n => simpa using hx.pow n
  | negSucc n => simpa [zpow_negSucc] using (hx.pow (n + 1)).inv

/-- Integral additive coordinates exponentiate to the corresponding torus monomials. -/
theorem exp_integralIsogenyAdditiveCoordinates
    (x : Fin 2 → ℂ) (M : IntegralIsogenyMatrix2) (i : Fin 2) :
    Complex.exp (integralIsogenyAdditiveCoordinates x M i) =
      integralIsogenyMultiplicativeCoordinates (fun j => Complex.exp (x j)) M i := by
  fin_cases i <;>
    simp [integralIsogenyAdditiveCoordinates, integralIsogenyMultiplicativeCoordinates,
      Complex.exp_add, Complex.exp_int_mul]

/-- Four additive/exponential generators of a two-coordinate tuple. -/
def exponentialPairGeneratorSet (x : Fin 2 → ℂ) : Set ℂ :=
  Set.range x ∪ Set.range (fun i => Complex.exp (x i))

/-- **Integral-isogeny invariance.** Failure of two-element extraction is preserved by every
integral isogeny transform. -/
theorem no_fin_two_extraction_integralIsogeny
    (x : Fin 2 → ℂ) (hx : LinearIndependent ℚ x)
    (hfail : ¬ ∃ t : Fin 2 → ℂ, Function.Injective t ∧
      (∀ i, t i ∈ exponentialPairGeneratorSet x) ∧ AlgebraicIndependent ℚ t)
    (M : IntegralIsogenyMatrix2) :
    ¬ ∃ t : Fin 2 → ℂ, Function.Injective t ∧
      (∀ i, t i ∈ exponentialPairGeneratorSet (integralIsogenyAdditiveCoordinates x M)) ∧
      AlgebraicIndependent ℚ t := by
  let A := algebraicClosure ℚ ℂ
  let S := exponentialPairGeneratorSet x
  let x' := integralIsogenyAdditiveCoordinates x M
  let y := fun i => Complex.exp (x i)
  let y' := integralIsogenyMultiplicativeCoordinates y M
  letI : Algebra.IsAlgebraic ℚ A := algebraicClosure.isAlgebraic ℚ ℂ
  have hpreserve : ∀ g : ℂ, g ∈ S → Transcendental A g →
      ¬ ∃ t : Fin 2 → ℂ, Function.Injective t ∧
        (∀ i, t i ∈ exponentialPairGeneratorSet x') ∧ AlgebraicIndependent ℚ t := by
    intro g hgS hgA
    have hall : ∀ {w : ℂ}, w ∈ S → IsAlgebraic (oneGeneratorField A ℂ g) w := by
      intro w hw
      exact isAlgebraic_oneGeneratorField_of_mem_of_no_fin_two_extraction
        S g hgS hgA (by simpa [S] using hfail) hw
    have hxalg : ∀ i, IsAlgebraic (oneGeneratorField A ℂ g) (x i) := by
      intro i
      exact hall (by exact Or.inl ⟨i, rfl⟩)
    have hyalg : ∀ i, IsAlgebraic (oneGeneratorField A ℂ g) (y i) := by
      intro i
      exact hall (by exact Or.inr ⟨i, rfl⟩)
    have hx'alg : ∀ i, IsAlgebraic (oneGeneratorField A ℂ g) (x' i) := by
      intro i
      fin_cases i
      · simpa [x', integralIsogenyAdditiveCoordinates] using
          ((isAlgebraic_int M.a : IsAlgebraic (oneGeneratorField A ℂ g) (M.a : ℂ)).mul
            (hxalg 0)).add
            ((isAlgebraic_int M.b : IsAlgebraic (oneGeneratorField A ℂ g) (M.b : ℂ)).mul
              (hxalg 1))
      · simpa [x', integralIsogenyAdditiveCoordinates] using
          ((isAlgebraic_int M.c : IsAlgebraic (oneGeneratorField A ℂ g) (M.c : ℂ)).mul
            (hxalg 0)).add
            ((isAlgebraic_int M.d : IsAlgebraic (oneGeneratorField A ℂ g) (M.d : ℂ)).mul
              (hxalg 1))
    have hy'alg : ∀ i, IsAlgebraic (oneGeneratorField A ℂ g) (y' i) := by
      intro i
      fin_cases i
      · simpa [y', integralIsogenyMultiplicativeCoordinates] using
          (isAlgebraic_zpow (hyalg 0) M.a).mul (isAlgebraic_zpow (hyalg 1) M.b)
      · simpa [y', integralIsogenyMultiplicativeCoordinates] using
          (isAlgebraic_zpow (hyalg 0) M.c).mul (isAlgebraic_zpow (hyalg 1) M.d)
    rintro ⟨t, _, htmem, htind⟩
    apply not_algebraicIndependent_fin_two_of_isAlgebraic_oneGeneratorField
      (K := A) (L := ℂ) g t
    · intro i
      rcases htmem i with ht | ht
      · obtain ⟨j, hj⟩ := ht
        rw [← hj]
        exact hx'alg j
      · obtain ⟨j, hj⟩ := ht
        rw [← hj]
        change IsAlgebraic (oneGeneratorField A ℂ g)
          (Complex.exp (integralIsogenyAdditiveCoordinates x M j))
        rw [exp_integralIsogenyAdditiveCoordinates]
        simpa [y'] using hy'alg j
    · exact htind.extendScalars A
  by_cases hx0alg : IsAlgebraic ℚ (x 0)
  · have hx0Z : IsAlgebraic ℤ (x 0) :=
      (IsFractionRing.isAlgebraic_iff ℤ ℚ ℂ).mpr hx0alg
    have hanchorQ : Transcendental ℚ (Complex.exp (x 0)) :=
      exp_algebraic_transcendental hx0Z (hx.ne_zero 0)
    have hanchorA : Transcendental A (Complex.exp (x 0)) :=
      hanchorQ.extendScalars A
    apply hpreserve (Complex.exp (x 0))
    · exact Or.inr ⟨0, rfl⟩
    · exact hanchorA
  · have hanchorQ : Transcendental ℚ (x 0) := hx0alg
    have hanchorA : Transcendental A (x 0) := hanchorQ.extendScalars A
    apply hpreserve (x 0)
    · exact Or.inl ⟨0, rfl⟩
    · exact hanchorA

end

end GaloisForLFunctions.RHTower
